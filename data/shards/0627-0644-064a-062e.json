{"poems":[[63,"نظرت وللأدم النوافخ في البرى","https://www.aldiwan.net/poem45783.html","الطويل"],[63,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[3,"نأتك رقاش إلا عن لمام","https://www.aldiwan.net/poem110.html",""],[86,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[35,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[88,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[29,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[45,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[45,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[28,"لعمري لقد أوفى وزاد وفاؤه","https://www.aldiwan.net/poem1239.html",""],[28,"إليك بنفسي حين بعد حشاشةٍ","https://www.aldiwan.net/poem1287.html",""],[28,"ألم يك جهلاً بعد ستين حجةً","https://www.aldiwan.net/poem1288.html",""],[28,"إن أستطع منك الدنو فإنني","https://www.aldiwan.net/poem4999.html","الطويل"],[28,"فتحت لهم حتى فككت قيودهم","https://www.aldiwan.net/poem5226.html","الطويل"],[28,"أتيناك زوارا ووفدا وشامة","https://www.aldiwan.net/poem5275.html","الطويل"],[28,"وحرف كجفن السيف أدرك نقيها","https://www.aldiwan.net/poem5326.html","الطويل"],[28,"أقول لحرف قد تخون نيها","https://www.aldiwan.net/poem5396.html","الطويل"],[28,"يسقين بالموماة زغبا نواهضا","https://www.aldiwan.net/poem5464.html","الطويل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[44,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[44,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9875","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[28,"أهاج لك الشوق القديم خباله","https://www.poetsgate.com/ViewPoem.aspx?id=2515",""],[209,"تحدثت بالهتاف أنك حاضر لإيناس","https://www.aldiwan.net/poem46315.html","الطويل"],[233,"فدتك عماد الدين نفسي وما حوت","https://www.aldiwan.net/poem31980.html","الطويل"],[285,"كلفت بليلى خدين الشباب","https://www.aldiwan.net/poem1913.html","المتقارب"],[295,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[303,"خميس اليمن توج عام خمس","https://www.aldiwan.net/poem56507.html","الوافر"],[362,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[364,"ترى آيتي في الحب حقا وتعرض","https://www.aldiwan.net/poem17023.html","الطويل"],[397,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[400,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[453,"سليمى أزمعت بينا","https://www.aldiwan.net/poem26632.html","الهزج"],[456,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[456,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[573,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"]],"verses":[["إِلى خَفِراتٍ مِن نُمَيرٍ كَأَنَّها","ظِباءٌ كَحيلاتُ المَدامِعِ عِينُ",0,"ن",1,0],["إِلى خِلَعٍ تَحكي رِياضاً أنيقَةً","بكَفَّيْهِ تَسْقيها الغَمامُ الرّواجِسُ",1,"س",1,0],["إِلى خَيلٍ مُسَوَّمَةٍ عَلَيه","حُماةُ الرَوعِ في رَهَجِ القَتامِ",2,"م",1,0],["إِلى خَيرِ خَلقِ اللَهِ مَن جاءَ ناطِقاً","بِآياتِهِ إِنجيلُ عيسى بنِ مَريَما",3,"م",2,0],["إِلى خَيرِ أَحياءِ البَرِيَّةِ كُلِّها","لِذي رَحِمٍ أَو خُلَّةٍ مُتَأَسِّنِ",4,"ن",1,0],["إلى خير أرض داسها شرّ معشر","بأرجلهم قُطّعن من أجرل جُرب",5,"ب",1,0],["إِلى خالِدٍ حَتّى أَنَخنَ بِخالِدٍ","فَنِعمَ الفَتى يُرجى وَنِعمَ المُؤَمَّلُ",6,"ل",1,0],["إِلى خُلَفاءِ سُنَّةٍ قَد تَنافَسوا","لِتَثقُلَ في أَعناقِهِم وَتُرَدَّدا",7,"د",2,0],["إِلى خَوفِ العِدى حَتّى يَبيتوا","عَلى ضِغنٍ وَأَمنِ الخائِفينا",8,"ن",2,0],["إِلى خَيرِ بَيتٍ فيهِ أَوفى مُجاوِرٍ","جِواراً إِلى أَطنابِهِ خَيرَ مَذهَبِ",9,"ب",1,0],["إِلى خَيرِ مَأتىً يَطلُبُ الناسُ خَيرُهُ","إِلَيهِ مِنَ الآفاقِ مُجتَمَعُ الرَكبِ",10,"ب",1,0],["إِلى خَيرِ مَن تَحتَ السَماءِ أَمانَةً","وَأَولاهُ بِالحَقِّ الَّذي لا يُكَذَّبُ",11,"ب",1,0],["إِلى خَيرِ أَهلِ الأَرضِ مَن يَستَغِث بِهِ","يَكُن مِثلَ مَن مَرَّت لَهُ طَيرُ أَسعَدُ",12,"د",1,0],["إِلى خَيرِ أَهلِ الأَرضِ أُمّاً وَخَيرِهِم","أَباً وَأَخاً إِلّا النَبِيَّ وَعُنصُرا",13,"ر",2,0],["إِلى خَيرِ مَسؤولَينِ يُرجى نَداهُما","إِذا اِختيرَ بِالأَفواهِ قَبلَ الأَصابِعِ",14,"ع",1,0],["إِلى خَيرِ جارٍ مُستَجارٍ بِحَبلِهِ","وَأَوفاهُ حَبلاً لِلطَريدِ المُشارِفِ",15,"ف",1,0],["إِلى خالِدٍ سيروا فَإِن تَنزِلوا بِهِ","جَميعاً وَقَد ضُمَّت إِلَيهِ ذَلاذِلُه",16,"ل",2,0],["إِلى خَيرِهِم فيهِم قَديماً وَحادِثاً","مَعَ الحِلمِ وَالإيمانِ وَالنائِلِ الجَزلِ",17,"ل",1,0],["إِلى خَيرِ مَبعوثٍ إِلى خَيرِ أُمَّةٍ","إِلى خَيرِ مَعبودٍ دَعاها بَشيرُها",18,"ر",3,0],["إِلى خَيرِ مَن ساسَ الرَعِيَّةَ عَدلُهُ","وَوَطَّدَ أَعلامَ الهُدى فَاِستَقَرَّتِ",19,"ت",1,0],["إِلى خالِدٍ راحَت بِنا أَرحَبِيَّةٌ","مَرافِقُها مِن عَن كَراكِرِها نُكبُ",20,"ب",1,0],["إِلى خَيلٍ مُسَوَّمَةٍ عَلَيها","حُماةُ الرَوعِ في رَهَجِ القَتامِ",21,"م",1,0],["إِلَى خُطَطٍ فِي العُلَى لَمْ تَدَعْ","مَجَالاً يُلِمُّ بِهِ اللُّوَّمُ",22,"م",1,0],["إِلى خُلُوصٍ فِي الطَّوَايَا بِهِ","مِمَّا بِأَزْهَارِ الرُّبَى سِرُّ",23,"ر",1,0],["إِلَى خَليلٍ وَلِنْدَا","أَصْفَى الْتَّهَاني تُهْدَى",24,"د",2,1],["إِلى خُلُقٍ مَهْمَا يَقُلْ فِيهِ مَادِحٌ","ثَنَاءً عَلَيْهِ قَالَتِ النَّاسُ أَخْلِقِ",25,"ق",1,0],["إلى خَيْرِ مَسْؤولَينِ يُرْجَى نَداهُما","إذا اخْتيرَ الأفْوَاهِ قَبلَ الأصَابِعِ",26,"ع",1,0],["إلى خالق الأرواح أشكو بلييى","بروح غدور في الغرام وماذقِ",27,"ق",1,0],["إِلى خَيرِ بَيتٍ مِن ذَوابَةِ فارِسٍ","وَأَكرَمِ عيصٍ في الأَنامِ وَمَعشَرِ",28,"ر",1,0],["إِلى خَيرِ مُستَمطَرٍ كَفُّهُ","وَخَيرِ المَقاوِلِ عَمّاً وَخالا",29,"ل",2,0],["إِلى خيرَة اللَه الَّذي شَهِدَ الوَرى","له أَنَّه المُختارُ في عالَمِ الذَرِّ",30,"ر",1,0],["إِلى خُلقٍ لو اِنّ البحرَ مدّ","لِمطريه سَرى فيهِ بيبسِ",31,"س",1,0],["إلى خيالٍ خَيالٌ في الظّلام سَرَى","نَظيُره في خَفاء الشَّخصِ إن نُظِرا",32,"ر",2,1],["إِلى خَيلٍ دَمعٍ في مَيادينِ حُبِّكُم","تَسابَقُ أَلفاظُ العِتابِ فَتَركُضُ",33,"ض",1,0],["إلى خطاب اُمتنا التحاي","من القمم الشواهق والسُهوب",34,"ب",1,0],["إلى خلق منه النسيم تعلمت","وأني لها حسن البشاشة للصحب",35,"ب",1,0],["إلى خندقٍ ينمى علاهم إذا دُعوا","ومن خير أقيالٍ إذا عُدَّ قيلها",36,"ه",2,0],["إَلى خَودٍ مُنَعَّمَةٍ","حَفَفنَ بِها وَفَدَّينا",37,"ن",2,0],["إلى خير مرعًى جميمٍ يُلَسُّ","وأعذبِ ماءِ حياً يُنهَلُ",38,"ل",1,0],["إلى خير من حلَّ شوقاً إليه","ركابُ المطيّ لأسيارِهِ",39,"ر",2,0],["إِلى خيرِ دينٍ عنده خَيْرُ مُرشِدٍ","وخيرِ إِمامٍ عنْدَهُ خيرُ مُؤْتَمِّ",40,"م",1,0]]}