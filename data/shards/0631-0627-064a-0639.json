{"poems":[[55,"رائعات أخفهن ثقيل","https://www.aldiwan.net/poem29826.html","الخفيف"],[65,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[79,"رأى عارضي لما رأى سقم بطنه","https://www.aldiwan.net/poem35877.html","الطويل"],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[30,"رأى عبد قيس خفقة شورت بها","https://www.aldiwan.net/poem5050.html","الطويل"],[63,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[82,"لها العتب هذا دأبها ولي العتبى","https://www.aldiwan.net/poem31544.html","الطويل"],[107,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[107,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[83,"تنازعني الآمال كهلا ويافعا","https://www.aldiwan.net/poem61463.html","البسيط"],[108,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[189,"يا سادة قد كملوا","https://www.aldiwan.net/poem14737.html","مجزوء الرجز"],[327,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[347,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[408,"رأي عاذلي من همت فيه صبابة","https://www.aldiwan.net/poem46683.html","البسيط"],[568,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138376",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104597","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122064","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125481","المواليا"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125437","الخفيف"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93559","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140045",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205570","الرمل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89988","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[4352,"","https://poetry.dctabudhabi.ae/diwan/poem/146802","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83183","الخفيف"],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[5121,"رَائِعُ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=214917",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[6093,"رائعُ الحُسْنِ نفاني","https://www.poetsgate.com/ViewPoem.aspx?id=176431",""],[6093,"رأيٌ على رأيٍ يُفِيْدُ وقَلَّمَا ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=180583",""],[6237,"سوزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77873&r=&rc=15",""],[6338,"أنضيت خيلي في الهوى وركابي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52541&r=&rc=3",""]],"verses":[["رائِعاتٌ أَخُفُّهُنَّ ثَقيلُ","وَخُطوبٌ أَدَقُّهُنَّ جَليلُ",0,"ل",1,1],["رأى عندَهُ الأعداءُ مِلْءَ عُيونِهِمْ","مَناقِبَ لو فازُوا بِها وَطِئوا الشُّهبا",1,"ب",2,0],["رأى عارِضي لمّا رأى سُقْمَ بَطْنِهِ","وقالَ ولمْ يُرْشَدْ لحِذْقٍ ولا كَيْسِ",2,"س",1,1],["رائِعاً كَما","شاءَ في الكُتُب",3,"ب",1,0],["رائِعٌ مُرتَفِعاً أَو واقِعاً","أَنفُسَ الشُجعانِ قَبلَ الجُبَناء",4,"ا",2,0],["رَأى عَبدُ قَيسٍ خَفقَةً شَوَّرَت بِها","يَدا قابِسٍ أَلوى بِها ثُمَّ أَخمَدا",5,"د",2,1],["رأى عليَّ بنَ عبدِ اللهِ قِبْلَتَهُ","فراحَ يَهْوي إليه أو يُقابلُه",6,"ل",2,0],["رأى عاذلي جسمي حديثاً فرابه","ولم يدرِ أني رعيت به الحبّا",7,"ب",2,0],["رأى عُمَرٌ رأيَهُ في الرَّحيلِ","فلا تُكْثِرِ الرُّومُ أوجالَها",8,"ل",3,0],["رأى عمّارُ خَطبكَ حين هبَّا","فلم يرَ مِثلَهُ من قبلُ خطبا",9,"ب",2,0],["رَأى عَزَماتِ الشَوقِ قَد نَزَعَت بِهِ","فَساعَدَ في اللَهِ النَوى وَالنَوازِعا",10,"ع",2,0],["رَأَى عهدك الميمون رؤيا سعيدةً","ولكنها في الصَّحْوِ ما ذهبت سُدى",11,"د",2,0],["رَأى عَلى شُعَبِ الأَكوارِ أَزفِلَةً","شِيباً وَيَعهَدُنا بِالأَمسِ شُبّانا",12,"ن",2,0],["رأى عظيم ذنبه","عندي فتاب واعترف",13,"ف",1,0],["رائِعاتٍ واضِحاتٍ","كَالأَقاحِيِّ المُنيرِ",14,"ر",1,0],["رائعات تهيج جذبا ودفعاً","زاخرات تموج جزراً ومدا",15,"د",2,0],["رأي عاذلي مَنْ هِمتُ فيه صَبابةً","ولَمْ يَبقَ لي فيهِ اصطبارٌ ولا جَلَدْ",16,"د",1,1],["رَأى عَوراءَ سَوداء عَلَيها","كِساء ثمَّ رَفلٌ بِالوَصيدِ",17,"د",1,0],["رأى عاهل الطليان صنعك باهراً","وانك شهم في الرجال همام",18,"م",1,0],["رأى علمَ الماءِ الذي هو واردٌ","فيمَّمهُ بالبازلِ المتحسِّرِ",19,"ر",1,0],["رَائِعٌ فِي حُسَامِهِ لِلأَعَادِي","بِسَنَا مَا لِلْكُفْرِ جَبَّ سَنَامَا",20,"م",2,0],["رائع الجمال","وجهه القمر",21,"ر",1,0],["رائعاتٌ في روض حسن بديع","مشهرٍ للدفاع حَدَّ حسامك",22,"ك",1,0],["رَأى عارِضاً يَهوى إِلى مُشمَخِرَّةٍ","قَد أَحجَمَ عَنها كُلُّ شَيءٍ يَرومُها",23,"ه",2,0],["رَأى عَبد العَزيز طَويل باع","فَتوَّجه مِن العَليا بِتاج",24,"ج",1,0],["رأى عقلي ولبي فيه حارا","فاضرم في صميم القلب نارا",25,"ر",2,1],["رائعٌ يخطر في مشيته","خطرة الطَّيْف لمن لم ينمِ",26,"م",1,1],["رأى عَليٌ قَصدَ آبائِهِ","لوضَحَ نَهجٍ في العُلى فاقتَفاه",27,"ا",2,0],["رائعاً كانَ لَم يَكُن باليَسيرِ","صَدُّهُ في سِلاحِ نَذرٍ يَسِيرِ",28,"ر",1,0],["رأى عرصات الكرخ أو حل أرضها","لأمسك عن ذكر الدخول فحومل",29,"ل",1,0],["رائِعُ الحُسنِ تَستَشِفُّ جَمالَ الن","نَفسِ في بَدئِه وَفي مُنتَهاهُ",30,"ا",2,0],["رائِعٌ فِي حُزنهِ الطّاغِي ومِنْ","حُزنِهِ الطَّاغِي ستأتيهِ الرَّوائِعْ",31,"ع",1,0],["رَائِعُ الْحَرْفِ نَالَ مِنِّيَ نَالاَ","وَزُهُورِي تَعَطَّرَتْ حِينَ قَالاَ",32,"ل",2,1],["رأى عظم بطشك بالحائدي","ن وقد حاد ظلما فما أظلما",33,"م",2,0],["رأى عزمك الوثاب بالموت أرقما","فصير صدر السيف بالسم منقعا",34,"ع",2,0],["رائعا في بيانه حين يملي","فائقا في بديع مخترعاته",35,"ت",2,0],["رائعُ الحُسْنِ نفاني","وبسوءٍ قَدْ رماني",36,"ن",2,1],["رأيٌ على رأيٍ يُفِيْدُ وقَلَّمَا","نَالَ المُشَاورَ لومة اللُوَّامِ",37,"م",1,1],["رائعةٌ كالسحر رفافةٌ","كالعطر كالصهباء مُستعذَبهْ",38,"ب",2,0],["رأي عيني منه يوم قلنية","منه شهاب خاطف شهاب",39,"ب",1,0]]}