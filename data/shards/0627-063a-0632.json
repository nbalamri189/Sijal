{"poems":[[11,"مهلا نوار أقلي اللوم والعذل","https://www.aldiwan.net/poem263.html",""],[87,"لا السهد يطويه ولا الإغضاء","https://www.aldiwan.net/poem63686.html","الكامل"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[82,"الهجر يضحك والهوى يبكي","https://www.aldiwan.net/poem31352.html","أحذ الكامل"],[46,"أغزال قولي للغزال الأحور","https://www.aldiwan.net/poem30038.html","الكامل"],[48,"لا تكوني روادة هزاله","https://www.aldiwan.net/poem23189.html","الخفيف"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[82,"الهجرُ يضحكُ والهوى يبكي","https://www.poetsgate.com/ViewPoem.aspx?id=3482",""],[87,"أعطى البرية َ إذ أعطاكَ باريها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9736&r=&rc=226",""],[119,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[119,"لي في بوادي الرقمتين غزال","https://www.aldiwan.net/poem40621.html","عموديه"],[123,"قضى حقوق الله في أعدائه","https://www.aldiwan.net/poem4368.html","الكامل"],[189,"لو كان بالصبر الجميل ملاذه","https://www.aldiwan.net/poem14515.html","الكامل"],[285,"أما وعتاق العيس لو وجدت وجدي","https://www.aldiwan.net/poem60687.html","الطويل"],[287,"ما فتكات البيض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[376,"بالذي ألهم تعذيبي","https://www.aldiwan.net/poem56953.html","مجزوء الرمل"],[412,"جسمي نحيل بالحب والحب","https://www.aldiwan.net/poem50202.html","المنسرح"],[458,"شربت فلسفتي من نبع آلامي","https://www.aldiwan.net/poem61251.html","البسيط"],[469,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[482,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[482,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[482,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96725","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80236","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199997","المجتث"],[3275,"","https://poetry.dctabudhabi.ae/diwan/poem/145179","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54485","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45130","البسيط"],[5277,"زينبُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=210873",""],[5411,"ضفاف الحب","https://www.poetsgate.com/ViewPoem.aspx?id=187954",""],[5431,"لغزة قد خرّ الفؤادُ تألما","https://www.poetsgate.com/ViewPoem.aspx?id=189720",""],[5605,"بكاء الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161345",""],[5790,"حدثوا عن صبابتي وشجوني","https://www.poetsgate.com/ViewPoem.aspx?id=112160",""],[5851,"وصية مرتحلة","https://www.poetsgate.com/ViewPoem.aspx?id=175272",""],[5881,"تنثر أعذاراً وتختلق","https://www.poetsgate.com/ViewPoem.aspx?id=183796",""],[549,"توبة في محراب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=203000",""],[6259,"جسمي نحيل بالحُبّ والحبِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59412&r=&rc=60",""],[4222,"بملك مصر أهني مالك الأمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52891&r=&rc=183",""]],"verses":[["أُغزوا بَني ثُعَلٍ فَالغَزوُ حَظُّكُمُ","عُدّوا الرَوابي وَلا تَبكوا لِمَن نَكَلا",0,"ل",2,0],["أَغَزالَةُ الإِشراقِ أَنتِ مِنَ الدُجى","وَمِنَ السُهادِ إِذا طَلَعتِ شِفاءُ",1,"ا",2,0],["أَغزَرَ العِزُّ قِرى أَضيافِهِم","وَفِياقُ النَيلِ يُغزِرنَ الفِيَق",2,"ق",1,0],["أَغزالةَ الفلكِ الَّتي عَبَقَتْ","مِسكاً فَقُلتُ غَزالةُ المِسكِ",3,"ك",1,0],["أَغَزالُ قولي لِلغَزالِ الأَحوَرِ","أَضمَرتَ غَدراً لَيسَ عَنكَ بِمُضمَرِ",4,"ر",1,1],["إِغزِلي في الحَياةِ فَالشَمسُ قِدماً","غَزَلَت خَيطَها فَقيلَ غَزالَه",5,"ه",1,0],["أغزَى بجُندٍ نحوَها مَولاهُ","في عُقبِ هذا العامِ لا سواهُ",6,"ه",1,0],["أَغزى إِليه القُرشيَّ القائدا","إذ صارَ عن قَصْدِ السبيلِ حائدا",6,"د",2,0],["أَغْزى سَماءَ الشَّرْقِ بِيضُ نُسُورِهَا","يخطُرْنَ فِي الغُدُوَاتِ والآصالِ",7,"ل",1,0],["أغزالة َ الفلك التي عقبتْ","مِسكاً فقلتُ: غزالة ُ المسك",8,"ك",1,0],["أغزُّ يستقبلُ العصرُ السلامَ به","وتشرقُ الأرضُ ما شاءتْ لياليها",9,"ي",3,0],["اغزال حاجر انت في رمضان هج","ر سوف تطوي الحسن في شواله",10,"ل",2,0],["اغزال وادي الرقمتين وانت قد","غشاك من لطف الجمال جلال",11,"ل",1,0],["أغزى بهم جيشاً تضيق الأرضُ عن","أفواجه والوهمُ عن إحصائه",12,"ا",3,0],["أَغْزيتَ حبَّك في القلوبِ فأذعنتْ","طَوْعاً وقد أَوْدَى بها اسْتِحواذه",13,"ذ",2,0],["أَغَزُّ حِمىً مَنْ فازَ مِنْهُ بِذِمَّةٍ","وَأوْفَى غِنىً مَنْ باتَ مِنْهُ عَلَى وَعْدِ",14,"د",1,0],["أَغزَرُ مِن بَحرٍ خِضَمٍّ عِلمُهُ","وَحِلمُهُ أَرزَنُ مِن كُلِّ جَبَل",15,"ل",1,0],["أغَزالاً صادَ باللَّحظِ","فُؤاداً فأصَابا",16,"ب",2,0],["أَغزَر مِن ماء دَمعَتي فَإِذا","يَئِستُ مِنهُ أَحَرّ مِن قَلبي",17,"ب",2,0],["أغزو كما غزت الدنيا وإن فشلت","وإن تمزقت من غدر لأخصامي",18,"م",2,0],["أغزلان كاظمة لا غدا","كناسك في المحل إلا مجودا",19,"د",2,0],["أغزرَ مِن دمعي اِذا","البينُ تمادَى أمدُه",20,"د",2,0],["أغزرَ مِن دمعي وقد","قُوضَ حيُّ دَعْدِ",21,"د",1,0],["أغزرُ مِن دمعي وقد أزمعتْ","على الرحيلِ العُرُبُ النهَّدُ",22,"د",1,0],["أَغزلانُ ريمٍ في الهوادجِ أم دمى","هرقنَ بأسيافِ اللحاظ لَنا دما",23,"م",2,1],["أَغزالَةَ الوادي المُخيم أَهلَها","بَينَ الخَمائل في ظِلالِ الوادي",24,"د",2,0],["أغزو ببالي ثيابي","من بالملابس غرا",25,"ر",2,0],["أغزال هذا العصر من رق غزله","له العذر إن لم يكفه غير عسجد",26,"د",1,0],["أُغْزُ الفرنجَ فهذا وقتُ غزوهِمُ","واحطِمْ جموعهمُ بالذَّابلِ الحطِمِ",27,"م",1,0],["أَغزو بِهِ كُلَّ مَن عَناني","وَفي يَمينِ الهَوى العِنان",28,"ن",1,0],["أغزالتي كلُّ الدروبِ تقطعتْ","وطريقُ عشقي بانَ من \"سقط اللوى\"",29,"ا",1,0],["أَغْزُ القَبيلةَ ثُمّ خُذْني عَنْوَة","فَالْحُبُّ بَرِّيٌّ وَلَيْسَ مُقَنَّنا",30,"ن",2,0],["أغزة هل ياطفلتي بعدُ من أسى؟","فلا تغفري يوما تقاعس أمتي",31,"ت",2,0],["أغزة يارمز الكرامة والتقى","بروح تعاف الظلم صانت لعزتي",31,"ت",2,0],["أ(غزة) ان جارك بات نحسا","ومن أسياده صيغ القرار",32,"ر",1,0],["أغزال الكناس كيف تحيل","ت إلى أن أسرت ليث العرين",33,"ن",1,0],["أغزُو الزمانَ بخيلٍ سَرجُها بيدي","صهيلُها بدماءِ القلبِ يَنسجمُ",34,"م",1,0],["أغزو المدارات أحلامي تنسقها","حديقةً من زهورٍ ريحها عبق",35,"ق",1,0],["أغزو المدى وحقول الأرض تتبعني",". في غزوتي ، والنخيل الشم راياتي",36,"ت",2,0],["أغزر من ماء مقلتي فإذا","يئست منه أحرّ من قلبي",37,"ب",2,0],["أغز الفرنج فهذا وقت غزوهم","واحكم جموعهم بالذابل الحطم",38,"م",1,0]]}