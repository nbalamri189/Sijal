{"poems":[[52,"أعبيد يا ذات الهوى النزر","https://www.aldiwan.net/poem63818.html","الكامل"],[199,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[240,"أرى الأيام صيغتها تحول","https://www.aldiwan.net/poem31790.html","الوافر"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[482,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101795","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27114","الكامل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117147","الطويل"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141231","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120528","الوافر"],[5956,"اتّق شرّ من أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=192409",""],[6256,"تحية أدباء المغرب العربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65918&r=&rc=6",""]],"verses":[["فَفَلَلتُ كَفّي عَن مساءَتِكُم","فَظَلِلتُ واضِعَها عَلى سَحري",0,"ر",2,0],["فَفَلَتهُ دِرَراً حَتّى بَدا","سامِقاً يَعلو مَصاعيبَ السِقابِ",1,"ب",1,0],["فَفَلَّ بِعَزمِهِ حَدَّ الأَعادي","وَأَرآءُ الخَليفَةِ لا تَفيلُ",2,"ل",1,0],["ففلسطين جمرة الشرق باتت","مسرحا للممثل الموسوي",3,"ي",1,0],["ففلَّلَ عزمَتي فيه وصبرى","وأمسى الجسمُ بالاْسقامِ يُكْسى",4,"س",2,0],["ففل ينادي لست ذاك وإنني","لفي شاغل عن صحبي ومتابعي",5,"ع",2,0],["ففل وشد الجيش عنه ووجهه","صبيح ووجه الكون أسود قاتم",6,"م",1,0],["ففَلَّ جيوشَ الخصمِ قَسْراً وأَدْبَرَتْ","كما تُدبِر الأغنامُ إنْ قام ضَيْغَم",7,"م",1,0],["فَفَلَقتُ هامَتَهُ فَخَرَّ كَأَنَّهُ","أَطُمٌ هَوى مَتقوضَ الأَبراجِ",8,"ج",1,0],["ففَلَّلتُ منه حدّهُ وترَكتهُ","كهُدبةِ ثوبِ الخزِّ لمّا يهدَّبِ",9,"ب",1,0],["فَفَلَّ جُمُوعَ الخَارِجِينَ بِبَأسِهِم","وَأَتهَمَ فيهم بِالفُتُوحِ وَأَنجَدَا",10,"د",2,0],["ففلق البركان لمحض نفع","وفلق البحر كان لبعض ضر",11,"ر",1,0],["\"ففلان\" يسرقني بكل غبائه","وذكائه، ويخالُ أني نائمُ",12,"م",1,0],["ففلسطين لم تعد تطلب العون","دموعا مسفوحة أو قصيدا",13,"د",2,0]]}