{"poems":[[102,"أمي","https://www.aldiwan.net/poem23695.html","عموديه"],[3,"قف بالمنازل إن شجتك ربوعه","https://www.aldiwan.net/poem175.html",""],[57,"ردت علي هدية لو أنها","https://www.aldiwan.net/poem26407.html","الكامل"],[74,"أصبحت بعد تطاول الأيام","https://www.aldiwan.net/poem19690.html","الكامل"],[93,"لو أنني يا هند بدر السما","https://www.aldiwan.net/poem8978.html","عموديه"],[91,"اخشى على الانسان ان","https://www.aldiwan.net/poem44687.html","مجزوء الكامل"],[63,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[63,"تأبى المنازل أن تجيب مسائلا","https://www.aldiwan.net/poem51474.html","البسيط"],[63,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[68,"يا رب أعط العاشقين بصبرهم","https://www.aldiwan.net/poem40106.html","الكامل"],[71,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[50,"غننا بالطلول كيف بلينا","https://www.aldiwan.net/poem65279.html","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9944","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54832","الكامل"],[3,"قف بالمنازل ان شجتك ربوعها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10711&r=&rc=65",""],[119,"ريم زها جماله","https://www.aldiwan.net/poem40603.html","عموديه"],[234,"هزني للصبوح صبح تبدى","https://www.aldiwan.net/poem50941.html","الخفيف"],[237,"ومهفهف عبث السقام بجفنه","https://www.aldiwan.net/poem14851.html","الكامل"],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[310,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[369,"تعسا لمن لا تستهل بنانه","https://www.aldiwan.net/poem60863.html","الكامل"],[409,"يا فاضلا وافى إلينا شعره","https://www.aldiwan.net/poem33763.html","الرجز"],[498,"زمن الورد أظرف الأزمان","https://www.aldiwan.net/poem67308.html","الخفيف"],[563,"كلنا بالتخصيص والتعميم","https://www.aldiwan.net/poem33852.html","الخفيف"],[567,"يا حسنها من رحلة تغنيك عن","https://www.aldiwan.net/poem52730.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138355",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138304",""],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216878","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96616","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133819","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78172","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108777","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137931",""],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109296","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27203","المديد"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77311","الخفيف"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28518","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106875","الكامل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115085","الخفيف"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126539","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118953","الرمل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103523","الكامل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104246","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129501","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128880","الخفيف"],[4413,"","https://poetry.dctabudhabi.ae/diwan/poem/146586","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33428","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120300","الكامل"],[4733,"شكوى السّهاد","https://www.poetsgate.com/ViewPoem.aspx?id=189178",""],[4859,"مازال في صدري كلام!","https://www.poetsgate.com/ViewPoem.aspx?id=190043",""],[5092,"لا موعدٌ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=178713",""],[5111,"كُؤوسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212314",""],[5408,"أدر كأسا","https://www.poetsgate.com/ViewPoem.aspx?id=190870",""],[5413,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=209108",""],[5693,"أين أنتم يا صفاتي ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=35587",""],[5751,"أنثى الماس","https://www.poetsgate.com/ViewPoem.aspx?id=214776",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5937,"حتى يليقَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=211823",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"من نفس نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=183294",""],[6113,"ان بعض الظن اثم","https://www.poetsgate.com/ViewPoem.aspx?id=26374",""],[5309,"قالوا اترجو من الهك نصرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573557",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""]],"verses":[["فيك ودّعت شبابي والصبا","وانطوت خلفي حلاوات التصابي",0,"ب",2,0],["فَيَكونُ لِلأُسدِ الضَواري لَحمُه","وَلِمَن صَحِبنا خَيلُها وَدُروعُها",1,"ع",3,0],["فَيكونُ مَورِدَها مَواردُ رِيقَتي","وَيَكونُ حَوضُ ثَنِيَّتَيها مَورِدي",2,"د",2,0],["فيكون جبركما لقلبي جبرهم","فهمُ على كلِّ الوجوه عظامي",3,"م",2,0],["فيكِ وَفي الوَردَةِ سِرُّ الصِبا","وَفي الصِبا سِرُّ الهَوى وَالجَمال",4,"ل",1,0],["فيكون قرداً في النها","ية مثلما قد كان قردا",5,"د",2,0],["فيكونَ طَوراً في مديحِك صادقاً","ويكونَ طَوراً في عِتابِك عاذِلا",6,"ل",2,0],["فيكون طورا في مديحك صادقا","ويكون طورا في عتابك عادلا",7,"ل",2,0],["فيكون ذا غيث الولي بجرده","ويكون ذاك ببأسه سم العدا",8,"د",2,0],["فَيَكونَ أَصغَرُ جاهِلٍ حَمَلَ الهَوى","يَلهو بِأَكبَرِ عالِمٍ لَم يَعشَقِ",9,"ق",1,0],["فيكِ وجدي يا هندُ وجدٌ عظيمٌ","مثلُ وجدِ الوزيرِ بالتبذير",10,"ر",1,0],["في كُؤوسٍ كَأَنَّهُنَّ نُجومٌ","جارِياتٌ بُروجُها يَبدينا",11,"ن",2,0],["فيكونُ فيه القيدُ وهو تَحرُّرٌ","ويكون فيه الموتُ وهو خَلاصُ",12,"ص",1,0],["فَيَكونُ لِلأُسدِ الضَواري لَحمُها","وَلِمَن صَحِبنا خَيلُها وَدُروعُها",13,"ع",3,0],["فَيَكُونُ عِيدُ العُمْرِ سَاعَةَ مُلْتَقىً","وَأَعَزُّ مَا نَرْجُوهُ حَلْوَى العِيدِ",14,"د",1,0],["فَيَكُونُ حوْلَ نِظامِ شَمْ","سِكَ حَيْثُ دَارَ نِظَامُ زَهرْ",15,"ر",1,0],["فيكون للأسد الضَّواري لحمها","ولمنْ صحبنا جيلها ودروءها",16,"ه",2,0],["فيك ولوه قلبه","ومستهام باله",17,"ل",2,0],["في كؤوسٍ تكاد تُخْطِئها الأع","ين لُطْفا من رِقَّةِ الْمُسْتَشَفِّ",18,"ف",1,0],["فَيَكونُ مِن شَهداءِ أَوَّلِ مُرتَضى","وَتَعودُ أَنتَ وَقَد شَقَيتُ بِوَزرِه",19,"ر",2,0],["فيكونُ من تمزيقِها لِنقابها","يوم لهُ تَنشقُّ تُربَةُ خالد",20,"د",1,0],["في كونِ عاشوراء تأريخاً له","رمزٌ لشرعٍ هُدّ فاِبكِ دروجه",21,"ج",2,0],["فيكونُ كالبحرِ الخِضَمِّ سَحابُه","للعالَمينَ ودُرُّه للغائص",22,"ص",1,0],["في كونه ليس بمخلوق ولا","بخالق من قال حل كفره",23,"ر",2,0],["في كُؤوسٍ كَأَنَّها زَهَرُ الخَش","خاشِ فيهِ شَقاشِقُ النُعمانِ",24,"ن",1,0],["فيكون الرائي الذي هو مرئي","يا عظيماً يُرجى لكل عظيم",25,"م",1,0],["فيكونُ فِكرُكَ في البلادِ مُسافِراً","ويكونُ جسمُكَ ثابتاً لم يَذهبِ",26,"ب",1,0],["فيكون عود الوفد عيداً شاملا","فيه الهنا بتمام الاستقلال",27,"ل",1,0],["فيكون أوبكما قريباً عاجلا","كاياب مجتاب لها مجتاس",28,"س",1,0],["فيكون عيشكما خصيبا مخضلا","وسنوكما من اطول الاعمار",29,"ر",1,0],["في كوكب ضخم يظل لرزهِ","بطن الجريب معضلا وصماد",30,"د",1,0],["فيكون من دونِ الأقارب لي أخاً","ومناسباً من دونِ كلِّ نسيبِ",31,"ب",1,0],["فيكونون إن بلغت مدى الحسِ","فأدركتُ ذلك الإِنسانا",32,"ن",2,0],["فيكون مخلوقاً وتزعم خالقاً","بالحس تدركه وتدرك موقفه",33,"ف",2,0],["في كَونِهِ سر البَلاغة قَد حَوى","وَكَلامُهُ الدُر النَفيس لَخابر",34,"ر",1,0],["في كؤوس كأنها حلل الغي","د على الغيد من كواعب جلق",35,"ق",1,0],["فيكون مهاجمُها هدَفاً","لمخاطرَ أيسرها الصدُّ",36,"د",1,0],["في كؤوسٍ توجت بالشهب","فعليك الحد ان لم تسكر",37,"ر",1,0],["فيكون الجهلُ في صَبٍب","ويكون العلمُ في عَلَم",38,"م",1,0],["فَيَكُونُ كُلاُّ هَذِهِ أجَزَاؤه","هذِي مقالَةُ مُدَّعِي العِرفَانِ",39,"ن",1,0],["فَيَكُونُ كُلِّيًّا وجُزئِيَّاتهُ","هَذَا الوجودُ فهذِهِ قَولاَنِ",39,"ن",1,0],["فَيَكُونُ أنواعاً وعِندَ نَظِيرِهِم","أوصَافُهُ وهُمَا فمُتَّفِقَانِ",39,"ن",1,0],["فيكُونُ كلُّ كَلاَمِ هَذَا الخَلقِ عَي","نَ كَلاَمِهِ سُبحَانَ ذِي السُّلطَانِ",39,"ن",1,0],["فَيكُونُ نصًّا عِندَ طَائِفَةٍ وَعِن","دَ سِوَاهُمُ هُوَ ظَاهرُ التبيَانِ",39,"ن",1,0],["فَيَكُونُ دَبُّوسَ الشِّقَاقِ وَعُدَّةً","للدَّفعِ فِعلَ الجَاهِلِ الفتَّانِ",39,"ن",1,0],["فَيَكُونَ تَركِيباً مُحَالاً ذَاكَ إن","قُلنَا بِهِ فَيَصِيرُ ذَا إمكَانِ",39,"ن",1,0],["فيكِ وَقفٌ عَلى المَدافِعِ صَدري","وَعَلى البيضِ ناظِري وَالحِرابِ",40,"ب",1,0],["في كونها واضحة الدلالة","فما به من لازم الموضوع له",41,"ه",1,0],["فَيَكونُ سَهمي في الغِناء مُقَدَّماً","عَنهُم وَحَظِّي في العَطاءِ مُؤخَّرا",42,"ر",2,0],["فيكون ما قد جدَّ تسليةً","للنفس فيها قد جرى مجرى",43,"ر",2,0],["فيكونُ الجَوابُ مِنّي الى الحا","جِبِ ما ان أردتُ الا السَلاما",44,"م",2,0],["فيك ومن ختم الثنا اوردت","وغلتي ذكراك ما بردت",45,"ت",1,0],["فيك واصلت صيامي","حبذا فيك الوصال",46,"ل",1,0],["فيكون جزلاً في اتفاق صنوفه","ويكون سهلاً في اتساق فنونه",47,"ن",2,0],["فيك وأطلقه من قيود البعاد","واجب بالقبول مولاي سؤلي",48,"ي",1,0],["في كوفة الجند كم غزال","يصرع في ناظريه اسدا",49,"د",2,0],["في كور حرف لم تمل من السرى","موارة الضبعين والاخفاف",50,"ف",1,0],["في كؤوس مشعشعات ولعب","مع غيد في روضة وقصور",51,"ر",1,0],["فيكون عندي العلتان كلاهما","والصحتان له بغير زوال",52,"ل",1,0],["فَيكونَ السقامُ بي ما سَقاني","مِن ضَنىً لا أملهُ ما سَقاكا",53,"ك",2,0],["فيكون في فصل الدعاوى منصفا","حكما ويكشف عنه ذا التلبيسا",54,"س",2,0],["فيكون الأمسُ يومي","مستمرا دون فصلِ",55,"ل",1,0],["في كوكبٍ يعلو به","صوتُ القطيعةِ والخصام !",56,"م",1,0],["في كؤوس الليل خمر الهوى","صار فيها شوقنا ذائبا !",57,"ب",2,0],["فِيْ كُؤُوسٍ تَتَلَظّى","مِنْ حُمُومٍ عَتَّقَتْهَا",58,"ت",3,0],["فيكويني السؤال بجمر صمتي","فمن يدنيك في المنفى إليّا",59,"ي",2,0],["في كوخ أمي جنتانِ وعالَمٌ","شوقي لرؤيته يسافرُ أكبرا",60,"ر",2,0],["في كؤوس من جمال","ساح يعلو بالتدنّي",61,"ن",2,0],["فيكونُ شعري في نهارِ عيونِها","بُرجًا ويَنزفُ حرفيَ الحَسّاسُ",62,"س",1,0],["فيكون وفق مراده في كونه","وكذاك في إعدام تكويناته",63,"ت",2,0],["في كوكب الحُسنِ كانت وحدها وطناً","والغانيات مبانٍ في عواصمها",64,"م",3,0],["فيكون مخزيًّا هناك مذمَّمًا","إن فاسقا أو مشركًا كذَّابا",65,"ب",2,0],["فيكون حتى التُّرْبُ مندمجاً","في عمق نفسك فوقه الشَّجَرُ",66,"ر",1,0],["فيك والله دوم عاصي وماحد زعزع ثباتي","لوعذلني من عذلني قلت له قم بس قم",67,"م",1,0],["فَيَكونُ قَدرُكَ فَوقَ قضدرِ مَنِ ارتَضى","ما ليسَ تَرضاهُ النُّفوسُ العاقِلَه",68,"ل",2,0],["فيكوي الرّوحَ أنَّكِ أنتِ مثلي","وأُشهدُ في هوانا العندليبا",69,"ب",2,0]]}