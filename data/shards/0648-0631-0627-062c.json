{"poems":[[37,"وراجعت نفسي واعترتني صبابة","https://www.aldiwan.net/poem39624.html","الطويل"],[39,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[49,"سلي فتيات هذا الحي عني","https://www.aldiwan.net/poem25127.html","الوافر"],[23,"لو ان اللؤم ينسب كان عبدا","https://www.aldiwan.net/poem21257.html","الوافر"],[53,"تمادى الصبا بي في غيه","https://www.aldiwan.net/poem66334.html","المتقارب"],[87,"أريد سلوكم والقلب يأبى","https://www.aldiwan.net/poem63680.html","الوافر"],[45,"المجد عوفي إذ عوفيت والكرم","https://www.aldiwan.net/poem10522.html","البسيط"],[47,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21003","الطويل"],[92,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[136,"صلاة الاستسقاء عند الحطمه","https://www.aldiwan.net/poem54659.html","الرجز"],[147,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[266,"محل العلا لولا الدني شريف","https://www.aldiwan.net/poem38231.html","الطويل"],[280,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[287,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[302,"مثال نعل رسول الله ذي الكرم","https://www.aldiwan.net/poem33178.html","البسيط"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[309,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[443,"عقت دارها إلا ثلاثا بها سحما","https://www.aldiwan.net/poem2592.html","الطويل"],[447,"وقفت ببابك اللهم","https://www.aldiwan.net/poem14363.html","الهزج"],[447,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[463,"رضيت وما من طاعة كل من رضي","https://www.aldiwan.net/poem56148.html","الطويل"],[534,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[568,"سقى دمن الحي الحيا المتفائض","https://www.aldiwan.net/poem13605.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87092","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34431","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49912","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114702","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71053","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113854","الوافر"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122475","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3042,"","https://poetry.dctabudhabi.ae/diwan/poem/199495","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112655","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97889","السريع"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104249","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62824","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62937","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109991","المنسرح"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135611","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78301","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119682","الوافر"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45046","البسيط"],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5582,"خَيالٌ سَرَى نَوْمَةَ السَّامِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187098",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[6237,"إفاقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77866&r=&rc=8",""]],"verses":[["وَراجَعتُ نَفسي وَاِعتَرَتني صَبابَةٌ","وَفاضَت دُموعي عَبرَةً خَشيَةَ النَوى",0,"ن",3,1],["وراج لين تغلبَ عن شِظافٍ","كَمتدن الصَّفا كيما يلينا",1,"ن",2,0],["وَراجِعَةٍ إِلَيَّ تَقولُ سِرّاً","أَعودُ إِلى نَصيحَتِهِ لَعَنَّه",2,"ن",2,0],["وَراجَعتَ الصِبا وَذَكَرتَ لَهواً","مِنَ الأَحشاءِ وَالخَصرِ اللَطيفِ",3,"ف",1,0],["وراجعتُ لهْوِي ولذَّاته","ونزَّهتُ نفسي عن المَحْرَم",4,"م",1,0],["وَراجَعتُ الرَشادَ عَسايَ أَسلو","فَما بالي مَعَ السُلوانِ أَصبى",5,"ب",2,0],["وَراجَعَ الشَمسَ نورٌ كانَ فارَقَها","كَأَنَّما فَقدُهُ في جِسمِها سَقَمُ",6,"م",1,0],["وَراجِيَةٌ أَن يَستَطيعَكَ سَعيُها","وَقَد سافَرَت بَينَ الرِجالِ خِلالُها",7,"ل",3,0],["وَرَاجِيَاً مِنْ إِلَهِي أَنْ يُتِيحَ لَنَا","يَوْمَاً عَلَى ظَفَرٍ أَنْ نُنْشِدَ البُرَدا",8,"د",2,0],["وراجي النّدى من غيره كمعوَّضٍ","من الماءِ إذ صلّى ترابَ التيمّمِ",9,"م",1,0],["وَراجي أُمورٍ جَمَّةٍ لَن يَنالَها","سَتُشِعبُه عَنها شَعوبٌ لِمُلحَدِ",10,"د",1,0],["وراجعت في هذا السجل فصولَه","اقلِّبُ اياماً به ولياليا",11,"ي",2,0],["وراجعتُ أشعاري سِِجَّلاً فلم أجِدْ","بهِ غيرَ ما يُودي بِحِلْمِ المُراجِع",12,"ع",1,0],["وَراجي أُمورٍ جَمَّةٍ لا يَنالُها","سَتَشعَبُهُ عَنها شَعوبٌ لِمُلحِدِ",13,"د",1,0],["وَراجِلينَ مِن طَرِيقٍ يَرجعُون","كَمَا مِن اُخرى مِثلَ عِيدٍ يَخرجُون",14,"ن",1,0],["وَراجَعتَ شَيبَ الهِندُوانيِّ حُلكَةً","وَأَبهَجُهُ ما سُمتَهُ وَهوَ شائِبُ",15,"ب",1,0],["وراجي العدا لم يدخل الأمن من قلبه","ولما يذدد عنه المخوف مخيف",16,"ف",1,0],["وَرَاجَعت بالبُشْرى نُفُوساً عَهدَتها","مُخَاطَبَةً مِن عطفِها بِمفَاتِح",17,"ح",1,0],["وَراجٍ سِوى أَبناءِ أَيّوبَ في الوَرى","كَعَشواءَ في جُنحِ الظَّلامِ لَها خَبطُ",18,"ط",1,0],["وَراجعِ النَفحات العنبريَّة في","وَصفِ النِعال الَّتي فاقَت على القِمَمِ",19,"م",1,0],["وراجٍ وباك من مخافة ربه","بفائض دمعٍ كالسحاب المواطر",20,"ر",1,0],["وراج الإله ولا تبأس وإن بعدت","مطالب أن رب العالمين ملى",21,"ل",2,0],["وراجى العلا من غير كد مخيب","ولا يرتقى من ليس دهرا بسهران",22,"ن",1,0],["وراجعت حلمي وارتجعت عن الصبا","ومن يصحب الأيام تحدث له حلما",23,"م",2,0],["وراج منك أني لس","ت دون الحوض مصدود",24,"د",1,0],["وراج منك يا مولاي عفواً","يمحي العمد منها أو خطاها",25,"ا",3,0],["وراجعت قلبي أستر الصبرَ بعده","فلم أر إلا مقبلاً نحو مُعرِض",26,"ض",1,0],["وَراجِعوا آخَراً مِنْ كُتْبِهِ وكَذَا","بابُ القَضَا واسْتَرْيحُوا منْ أَذَى التَّعَبِ",27,"ب",1,0],["وَراجٍ لِداءٍ طَبَّ مَن هُوَ مُشكِلٌ","عَلَيهِ مَريضُ الماءِ وَالمُتَمارِضُ",28,"ض",1,0],["وَراجَت بِها بَعد الكَساد تجارةٌ","لَها اليُمنُ في ظل الأمان مسالم",29,"م",1,0],["وَراجعت سهدي وَالتأسّفَ وَالأَسى","وطلَّقَ لما أَن رَحَلتِ الكرى طَرفي",30,"ف",2,0],["وراجع الحلمُ حتىَّ في الهوى سَمُجَت","أشياءُ إذا حَسُنَت في الدّيِن اشياءُ",31,"ا",2,0],["وراجع هوى القبذاقِ فالعيش بُلغَةٌ","وقد تُقطعُ المَوماةُ بالضَّامِر العَنسِ",32,"س",1,0],["وراجٍ إليه أَن تعود مَطِيَّتي","يقيني وزادي ما ادَّخَرْتُ من التَّقْوَي",33,"و",2,0],["وراجي النفع يصحب من","يعان على النفع",34,"ع",1,0],["وراجِع قَولَ جَدِّكَ فِي البُخاري","حلاوَةَ لو دُعِيتَ إلى انقِطَاعِ",35,"ع",1,0],["وَراجعته لكي يُبدي لَها شغفاً","عَن نَفسهِ فَأَراها أيما شمم",36,"م",1,0],["وراجع الحلم قلبي بعد صبوته","وقد يكون خديني الجهل أحقابا",37,"ب",2,0],["وراجعوا عندَ الفعالِ الحَسَبا","إن كُنتُم كما زَعمتُم عُرُبا",38,"ب",2,0],["وراجلٍ يمشي على رسله","ومسرع صاح به الموعد",39,"د",1,0],["وراج قبولي عند ربك صاغراً","ومن لي بأن أحظى بمرتبة السعد",40,"د",1,0],["وراجعتها الأَحلامُ واتخذتْ","من الحُبى في ظهورِها حُزمَا",41,"م",2,0],["وراجَمَها غَداةَ الوردِ عَودٌ","يقطعُ غُلّةَ الهِيمِ النّهالِ",42,"ل",1,0],["وراجعتُ تاجَ الملكِ في عزماتِه","وليس له في العازمينَ عَدِيلُ",43,"ل",1,0],["وراجَعَ الدهرُ رأيَهُ فرأى","كُلاً عن الرُشدِ والهُدى رَجَعا",44,"ع",2,0],["وراجياً بجاهه لحاجِ","مع استقامةٍ بلا اعوجاجِ",45,"ج",1,0],["وَراجي فَضلُكَ الداني جَفاه","كَفاهُ عَن تَعَرُّضُهُ الثَناء",46,"ا",2,0],["وَراجِع النَفسَ اِنّي قَد ضَلَلتُ بِها","عَمّا عَداكَ فَلَم أُبرِح وَلَم أَقف",47,"ف",1,0],["وراجعتُ الزمان بهم فضنّا","وقد كلَمَ البعادُ القلبَ كلما",48,"م",2,0],["وَراجَعتُ لّما أَطار الشَبابَ","غُرابان عَن مَفرقي طائرانِ",49,"ن",1,0],["وَراجَعَ الشَمسَ نورٌ كانَ فارَقَها","لَمّا أَطافَت بِكَ الأَلطافُ وَالنِعَمُ",50,"م",1,0],["وراجعه في أقوال كل محقق","تجده لعمري واضحاً ساطعاً صدقا",51,"ق",2,0],["وراجع كلامي ممعناً ومفكراً","فسوف ترى من كان تبدو عواضله",52,"ل",2,0],["وَراجِي نَدَىً مِنْ سِوَى كَفِّهِ","كَراجِي الوِلادَةَ مِنْ عاقِرِ",53,"ر",1,0],["وراجع كل ما صغنا","ه في ديواننا شعرا",54,"ر",2,0],["وراجعت ماضيّ الغرير وحاضري","وجرّدت من نفسي لنفسي مفندا",55,"د",2,0]]}