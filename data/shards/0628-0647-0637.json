{"poems":[[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[65,"سقى الله ليل الخيف دمعي أو الحيا","https://www.aldiwan.net/poem45811.html","الطويل"],[30,"عسى أسد أن يطلق الله لي به","https://www.aldiwan.net/poem5353.html","الطويل"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[287,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[412,"قفوا جددوا عتبا على من له العتب","https://www.aldiwan.net/poem50204.html","الطويل"],[520,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[534,"على البر نجل البر مني تحية","https://www.aldiwan.net/poem37426.html","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102074","المتقارب"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109402","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86286","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33131","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114444","الوافر"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4168,"","https://poetry.dctabudhabi.ae/diwan/poem/123833","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66132","الطويل"],[5431,"وماؤك عمّدت قلبي وفاهي","https://www.poetsgate.com/ViewPoem.aspx?id=186820",""],[5442,"سل الركب هل مروا بجرعاء مالك","https://www.poetsgate.com/ViewPoem.aspx?id=114770",""],[4623,"دعوني فاني لست أخشى من العين (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146684",""],[5787,"سقى الله ليل الخيف دمعي أو الحيا","https://www.poetsgate.com/ViewPoem.aspx?id=169337",""],[5848,"قصر وقبر","https://www.poetsgate.com/ViewPoem.aspx?id=48958",""],[6259,"قفوا جددوا عتباً على من لهُ العتب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59358&r=&rc=6",""]],"verses":[["بِهِ طالَ مِن خَطوي وَكُنتُ كَأَنَّني","مَشَيتُ إِلى نَيلِ المَعالي مُقَيَّدا",0,"د",2,0],["بِهِ طَرَقَتْ صَحبي أُمَيمَةُ مَوهِناً","وَنَحنُ بِأَذيالِ الدُّجى تَتَلَثَّمُ",1,"م",1,0],["بِهِ طامَنَ اللَهُ الَّذي كانَ ناشِزاً","وَأَرخى خِناقاً عَن يَدَي كُلِّ مُرهَقِ",2,"ق",1,0],["به طابت من الّلذّا","تِ لي والعَيْش ألوانُ",3,"ن",1,0],["بِهِ طارَ عَنّا الخَوفُ وَالأَمنُ واقِعٌ","وَخَيَّمَ رَكبُ الخِصبِ وَاِرتَفَعَ القَحطُ",4,"ط",1,0],["بِهِ طيىء طالَت عَلى مُضَرٍ وَلَن","يَقوم لَها في الحَربِ تَغلبها الغلبُ",5,"ب",1,0],["به طالت بنو رزيك باعاً","على الحيين من يمن وشام",6,"م",1,0],["بِهِ طَلَعَتْ شَمْسُ البَلاغَةِ فُلْكَها","هُوَ الطِّرْسُ في لَيْلِ السُّطورِ من الحِبْرِ",7,"ر",1,0],["به طيبة طاب ارجاؤها","كمسك وترب يداوي الفؤاد",8,"د",1,0],["بهِ طريقة سعد الدين قد سعدت","حظاً وأمسى بها للشرع متَّبعا",9,"ع",2,0],["بِهَطلٍ إِذا ما ذكرنا الصبا","عَصرنا عليه الحَشا الصاديَه",10,"ي",2,0],["بِهِ طالَما في مِصر عزت مَناصِب","لَها كانَ بِالرَاي السَديد يُدبِر",11,"ر",1,0],["بِهِ طالَ بَيتُ القُدسِ يُدنى لَهُ الهُدى","وَيَبني حَماهُ حَيثُ أَعيا مَصامُهُ",12,"م",2,0],["به طلعت شموسُ مسانِدٍ في","أقاصي مغربٍ للناظرينا",13,"ن",2,0],["به طال عمر التهاني لنا","وعمر الكآبة أضحى قصيرا",14,"ر",2,0],["بهطة تعجز عن وصفها","يا مدعي الأوصاف بالزور",15,"ر",1,1],["بهِ طافَ ابراهيمُ كالبَدْرِ حَوْلَهُ","مَلاَئِكَةُ الرحمن يَسْعَوْنَ أَنْجُما",16,"م",2,0],["بهطلك ياشقيق الروح أحيا","وماؤك عمّدت قلبي وفاهي",17,"ا",3,0],["به طهر البيت المحرم من أذى","طواف العرايا والنساء العوارك",18,"ك",1,0],["به طبت نفسا فلتطب نفسكم به","فاني به ارجوا نفوز باجرين",19,"ن",1,0],["به طرقت صحبي أميمة موهنا","ونحن بأذيال الدجى نتلثم",20,"م",1,0],["به طفلةٍ تستحم ! بزحمة اسرارها","إلى امطرت بالدموع .. يضيق عمر وصدر !",21,"ر",1,0],["به طيئٌ طالت على مضر ولن","تقومَ لها في الحرب تغلبها الغلب",22,"ب",1,0]]}