{"poems":[[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[68,"يا من غدا للأنام غيثا","https://www.aldiwan.net/poem39069.html","مجزوء البسيط"],[409,"لا زلتم في نفس","https://www.aldiwan.net/poem33709.html","مجزوء الرجز"],[566,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200024","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205738",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72447","البسيط"],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5038,"هذا البدر","https://www.poetsgate.com/ViewPoem.aspx?id=188487",""],[5401,"ضابط الإيقاع","https://www.poetsgate.com/ViewPoem.aspx?id=78141",""],[5851,"المدينة الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=175306",""]],"verses":[["من الثغر","أطفى شرر",0,"ر",1,0],["مِنَ الثَلاثا إِلى الثَلاثا","إِلى الثَلاثا إِلى الثَلاثا",1,"ث",2,0],["من الثواب والجزا","يا حبذا من أنفس",2,"س",1,0],["مِنَ الثُرَيّا اِنقَضَّ أَو دَلوِيُّ","فَاِجتَمَعَ الرَبيعُ وَالرَبلِيُّ",3,"ي",1,0],["من الثرثار نهرب ألف عام","ولو ألقى جواهر من كلام",4,"م",1,0],["من الثرى في غير ما رقاد","وقطعوا في القبر كل زاد",5,"د",1,0],["من الثريا بكل آن","اليه يمتد كف سارق",6,"ق",1,0],["من الثلة الأولى بعمق صدورهم","مصاحف تتلى للصغير ومن شبا",7,"ب",2,0],["مِنَ الثَّغْرِ النَّديِّ سُقيتُ كَأْساً","لها تاقَتْ قُلوبُ الْوالِهينا",8,"ن",2,0],["من الثمر وعقود لولك أَدّ أَدّ","زكاتك اللي في حلالك موجبه",9,"ب",2,0],["من الثّياب يشفّ الجرح منكشفا","على تردّم حلم كان يغزلهُ",10,"ل",2,0]]}