{"poems":[[102,"سندباد يمني في التحقيق","https://www.aldiwan.net/poem24836.html","عموديه"],[37,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[74,"أودت فعالك يا أسما بأحشائي","https://www.aldiwan.net/poem18168.html","البسيط"],[53,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[111,"عش ما تشاء وراقب فجعة الأجل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545631",""],[119,"لقد طال للركب المجد تلفتي","https://www.aldiwan.net/poem41193.html","عموديه"],[131,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[186,"لقد مضى نعمة الله الكريم إلى","https://www.aldiwan.net/poem61188.html","البسيط"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[240,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[280,"أمولاي حق العبد تقرير عذره","https://www.aldiwan.net/poem25424.html","الطويل"],[342,"لما رأتنا واقفي المطيات","https://www.aldiwan.net/poem45339.html","الرجز"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[463,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[463,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[463,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[505,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[543,"مقامك يا أبا حفص عظيم","https://www.aldiwan.net/poem47955.html","عموديه"],[556,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[566,"يا رب أنت تجبر الكسيرا","https://www.aldiwan.net/poem27849.html","الرجز"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110428","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110402","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110390","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48830","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77674","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96610","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56050","البسيط"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44848","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49591","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102154","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10478","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74173","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132613","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62937","الطويل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61257","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205692",""],[3854,"","https://poetry.dctabudhabi.ae/diwan/poem/47370","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90866","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33351","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72747","المتقارب"],[4578,"عُرب اللوى عن عهود الود قد حالوا","https://www.poetsgate.com/ViewPoem.aspx?id=49505",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[5629,"ديرة الامجاد","https://www.poetsgate.com/ViewPoem.aspx?id=184502",""],[5731,"تركت القريض لمن قَالَه","https://www.poetsgate.com/ViewPoem.aspx?id=189923",""],[402,"يا عائدا برعاية الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=36542",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[6115,"اذا كان مايعجبك قول الحقيقه","https://www.poetsgate.com/ViewPoem.aspx?id=180488",""],[463,"إذا فاتها روضُ الحمى وجنوبهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59984&r=&rc=40",""],[463,"عجبتُ لمرّ النفسِ كيف يضامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60327&r=&rc=383",""]],"verses":[["من الكاتب الأدنى إليك ؟ ذكرته","لديه كما يبدو ، كتابي وكاتب",0,"ب",1,0],["مِنَ الكُتمِ الحَوافِظِ لا سَقوطٌ","إِذا سَقَطَ المَطِيُّ وَلا سَؤولُ",1,"ل",1,0],["من الكميت التي تجري بصاحبها","جريَ الرهان إلى غايات سرَّاء",2,"ا",2,0],["من الكُمْت قبل المزج صهباءُ بعدَهُ","سليلةُ جُونٍ غير كُمْتٍ ولا صُهبِ",3,"ب",1,0],["من الكُمت ألواناً ولولا اصْطِلاؤها","عَلاها قميصٌ أصفر اللون وارِسه",4,"س",2,0],["من الكرامة يا مولاي ان بقيت","خلافة الله في رأس العلى علما",5,"م",2,0],["من الكرامة يا مولاي مجتمع","حوى الجموع من الآفاق مزدحما",5,"م",2,0],["من الكرامة حر الشمس حجبه","ظل الغمامة حال الدفن مرتكما",5,"م",2,0],["من الكرامة نفح الطيب من جدث","أودعت فيه ونور ساطع لسما",5,"م",2,0],["من الكرامة هذا الكون أجمعه","راض عليك كما أخلصت معتزما",5,"م",2,0],["من الكواكب في وعد وفي شرف","وفي ارتفاع واشراق وفي مثل",6,"ل",1,0],["من الكواكب في عد وفي شرف","وفي ارتفاع واشراق وفي مثل",7,"ل",1,0],["من الكاظميين الوضاح ذوي الهدى","أكابر هذا الدين أهل الفتوة",8,"ه",1,0],["مِنَ الكاتِماتِ الرَبوَ تَمزَع مُقَدّماً","سَبوقاً إِلى الغاياتِ غَيرَ مُسَبَّقِ",9,"ق",1,0],["مِن آلِ كَبّابةٍ مِن بَيتِ مَكرُمَةٍ","بِالخَيرِ وَالبِرِّ والإِحسانِ قَد عُرِفا",10,"ف",2,0],["منَ الكفرِ ذو الإسلامِ يأخذ حذرهُ","وَمِن هؤلاءِ القومِ لا يأخذ الحِذرا",11,"ر",2,0],["مِنَ الكِلَمِ الَّتي ما عَي","بَ قائِلُها وَلا وُكِسا",12,"س",2,0],["مِنَ الكَلِمِ اللائِي انْتَمَيْنَ إِلَى العُلَى","وَشَرَّفْنَ بِالتَّسْويدِ بِيضَ المَهَارِقِ",13,"ق",1,0],["مِنَ الكَلى في خُسُفٍ رَوِيّات","وَضَعنَ أَنماطاً زَربِيّات",14,"ت",1,0],["من الكَلِمِ الغُرِّ اللَّواتي كأنّها","رياضٌ لعَيْنِ النّاظرِ المُتفَرِّج",15,"ج",1,0],["من الكلِم المخزونِ نَمَّ خفيُّه","إليك وأضحى سرهُّ فيك معلَنا",16,"ن",2,0],["من الكَلِم المختصِّ يعلم ما أتى","وفيه كما فيه قائليه طَغامُ",17,"م",1,0],["من الكلم الذي إن كان حدٌّ","لغاياتِ الفصاحة فهو حدُّ",18,"د",1,0],["من الكَلمِ السهلِ المنيعِ مرامُهُ","على الناس والنَّزرِ الكثيرِ عجيبُهُ",19,"ب",2,0],["مَنَّ الكَريمُ فأَعزَّ شأنَنا","بنفحَةٍ ذاتِ شُؤُنٍ مُشبِعَهْ",20,"ع",2,0],["مَنالُكَ لا يَرومُه مَن يَرومُ","ويا ربَّ المَكَارِمِ والمَزايا",21,"ي",2,0],["من الكَلِمِ الباقي على الدّهرِ خالداً","وكم كَلِمٍ لم يُؤتَ شيئاً من الخُلدِ",22,"د",1,0],["مِن الكَديدِ وَتَغالَت زُورا","وَعايَنَت أُعيُنُها تَأمُورا",23,"ر",2,0],["منَّ الكريم بها عذرآءَ ساحبةً","ذيل الفخار بما تحوي معانيها",24,"ي",3,0],["منَّ الكريم بها عليَّ رسالةً","تًفدَى بكل وصيفةٍ ووصيفِ",25,"ف",1,0],["منَّ الكريمُ بها عذرآءَ ساحبةً","ذيلَ الفخارِ تُباهي البدوَ والحَضَرا",26,"ر",2,0],["من الكوثر الخلدي ما أنت شارب","هنا ومن الفردوس ما أنت طاعم",27,"م",1,0],["مِن الكِتاب حينَ تَمَّ الطَبعُ","تَكلّم الذئبُ لَهُ وَالسَبعُ",28,"ع",1,1],["مِنَ الكواعبِ يحوي الدرّ مبسمها","وَالطلع وَالبابليّ العذب والضربا",29,"ب",2,0],["من الكريم الذي افضالهُ غمرت","اميرنا حسن الاعطاء واهبنا",30,"ن",2,0],["مِنَ الكَلالِ واحتِمالِ مَا صَرَت","ناءَ يَمانِياً فَلَمَّا انتَشَرَت",31,"ت",1,0],["مِنَ الكَلِمِ الرَّطبِ الَّذِي لَو أَبَحتُهُ","لَزُيِّفَ عِقيانٌ وَبُهرِجَ مَرجَانُ",32,"ن",1,0],["من الكِلمِ اللائي صَدَعْتُ بها الدجى","فأَصبحَ منها الدهرُ وهْوَ كليم",33,"م",1,0],["من الكعبةِ العظمى التي انبثَّ نورُها","من الحرم الأدنى إلى المسجد الأقصا",34,"ا",1,0],["مِن آلِ كُرزِ غَداةَ الرَوعِ قَد عُرِفوا","عِندَ القِتالِ إِلى رُكنٍ وَمَحبورِ",35,"ر",1,0],["مِنَ الكثيبِ تَنظُرُ الجزيرَه","كَمِثلِ فَحِلِ مَسقَطَ الشهيرَه",36,"ه",1,0],["من الكلف الخافي انطوين على جمر","مضى الصَبر وَالشَوق المُبرح قَد غَدا",37,"د",2,0],["من الكوت منسحباً قد رجعت","لتضربهم ضربة قاسرة",38,"ر",2,0],["من الكاتمات الجهدِ وهي رديةٌ","يشارك فيها شَدقَم وجَدِيلُ",39,"ل",1,0],["مِن الكُماةِ الَّتي تُطوى ضُلوعهُم","عَلى العَزيمةِ وَالإِقدامِ لا الفَشَلِ",40,"ل",1,0],["من الكتان يا نسَّا","ج فانسج كل ما خلدا",41,"د",2,0],["مِنَ الْكاظِمِي الْغَيْظِ وَالْمُحْسِنِينَ","إِذا بَرَّحَتْ بِالصُّدُورِ الْحُقُودِ",42,"د",1,0],["من الكاظمين الغيظ أهل الرضي فلا","يضيق عن الصبر الجميل لهم صدر",43,"ر",1,0],["من الكرى جامدٌ مِن جَفنِ مقلتهِ","وماءُ مقلتهِ فوقَ الكرى يجرِي",44,"ر",2,0],["من الكاف والنون في قول كن","فتم لك الأمر فيمن مشى",45,"ا",1,0],["من الكرام تالألي تحكي مأثرهم","وفي ظلالهم أهل الرجا قالوا",46,"ل",3,0],["من الكلماتِ النائماتِ. ولي أتى ..","السؤالُ كأني للسؤال عدولُ",47,"ل",1,0],["من (آل كندة) صنو نور العلم وال","خلق الرفيع وكل فضل مجمع",48,"ع",1,0],["من الكويت الغالية اليا قطر","ديرة ألاجواد والسيف الصقيل",49,"ل",1,0],["من الكويت الغالية اليا قطر","باقة ورودن تعنت تستميل",49,"ل",1,0],["من الْكَذِب فِي نظمه للقريض","فربي كريم لمن ساله",50,"ل",2,0],["من الكمي بها وضرى طرفه","بالوثب فوق حبائل الحدثان",51,"ن",1,0],["من الكعب ، حتى ، أراقبُ حجم ال","خطى والمدارات والإرتطامْ",52,"م",1,0],["من الكذب والغيبه يجيني شقيقه","سواليف قوم مثل شلّة جراوه",53,"ا",3,0],["من الكلمِ السهلِ المنيعِ مرامعة ُ","على الناس والنزرِ الكثيرِ عجيبهُ",54,"ب",2,0],["من الكلمِ المختصِّ يعلم ما أتى","وفيه كما في قائليه طغامُ",55,"م",1,0]]}