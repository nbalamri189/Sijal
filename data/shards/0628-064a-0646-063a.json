{"poems":[[63,"أقصر الزاجر عنه فازدجر","https://www.aldiwan.net/poem51677.html","الرمل"],[438,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119916","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95595","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99498","الرمل"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13018","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45129","الرمل"],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""]],"verses":[["بينَ غَدْرٍ يَقَعُ الطَّيرُ بها","فتراهُنَّ رِياضاً في غُدُر",0,"ر",1,0],["بين غيثِ الدموعِ وهيَ أُجاجٌ","ورياحِ الزفيرِ وهي سُمومُ",1,"م",1,0],["بين غرات الصبا مع فتية","أصبحوا في ظلم الدهر غرر",2,"ر",1,0],["بين غُرٍّ من الصحاب علاهم","دونها الشمس والسما كان قدرَا",3,"ر",2,0],["بين غزلان النصارى","أمزج الريق بخمر",4,"ر",1,0],["بَينَ غُصنٍ ذي اِهتِزازٍ","وَقَضيبٍ ذي اِرتِجاجِ",5,"ج",1,0],["بَينَ غِزلان الصَريم","وَالأَغاني وَالغَواني",6,"ن",2,0],["بين غلطة من طباعة وكبوة من حصان","قمت أغسّل مشلحي من دموع الأمّتين",7,"ن",1,0],["بَيْنَ غَيْمٍ فِي سُرُورٍ","فَاضَ بِالأَمْطَارِ خَيْرَا",8,"ر",2,0],["بين غزلانٍ يعاطون الهوى","ويعاطون رفيقاً عن رفيق",9,"ق",1,0],["بين غلْقٍ مورّثٍ وانعتاقٍ","يتناهى إلى ضياع الحوافز",10,"ز",1,0]]}