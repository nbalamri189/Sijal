"],[5277,"التوباذية","https://www.poetsgate.com/ViewPoem.aspx?id=185350",""],[5277,"قسمةٌ ضيزى","https://www.poetsgate.com/ViewPoem.aspx?id=186525",""],[5277,"بقيةٌ من رمق","https://www.poetsgate.com/ViewPoem.aspx?id=191041",""],[5277,"البوحُ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=191377",""],[5277,"مشاعرٌ موحشة","https://www.poetsgate.com/ViewPoem.aspx?id=192198",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5363,"إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=144172",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5612,"أبي","https://www.poetsgate.com/ViewPoem.aspx?id=197097",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5689,"الآم أسائل عنك القمر","https://www.poetsgate.com/ViewPoem.aspx?id=143397",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[4623,"دعوني فاني لست أخشى من العين (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146684",""],[402,"هو العيش جهد طائل وفتون","https://www.poetsgate.com/ViewPoem.aspx?id=36535",""],[5815,"شهْدُ الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=196848",""],[5829,"اعترافات","https://www.poetsgate.com/ViewPoem.aspx?id=189909",""],[5948,"صلى الإلهُ على لُوطٍ وشيعتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=100619",""],[5952,"الشعر في مايا عجيب","https://www.poetsgate.com/ViewPoem.aspx?id=204159",""],[5975,"وأنت دقَّ معناكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53251",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[6218,"كلاّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65905&r=&rc=58",""],[6221,"مساء الخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64918&r=&rc=2",""],[6229,"مي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65188&r=&rc=14",""],[6259,"يهن علاك مداها القصي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59408&r=&rc=56",""],[6308,"انكسارات آخر الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87730&r=&rc=8",""],[5126,"روض وشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87814&r=&rc=29",""],[5126,"أقلّي اللَّوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87797&r=&rc=12",""]],"verses":[["وَإِن تُعطِني الإِعظامَ قَولاً فَإِنَّني","سَأُعطيكَ فِعلاً مِنهُ أَذكى وَأَعبَقا",0,"ق",2,0],["وأنْتَعِلُ الجوْزاءَ عُجْباً وإنْ غدَتْ","تُقَرّطُ آذانٌ بِها وتُشَنَّفُ",1,"ف",1,0],["وَإِنْ تَعَاظَمَ ذَنْبٌ قَدْ جنَتْهُ يَدِي","وَطَالَ قَرْعِي عَلَيْهِ السِّنَّ مِنْ نَدَمِ",2,"م",1,0],["وَأَنْتَ عِمَادِي وَاعْتِدَادِي وَمَفْزَعِي","وَذُخْرُ زَمَانِي وَالْحَدِيثُ يَطُولُ",3,"ل",1,0],["وَأَنْتَ عَلِيٌّ قَدْ عَلِمْتَ تَشَيُّعِي","فكُنْ نَاصِريِ وَأدْرَأَ جُمْوعَ بَنِي حَرْبِ",4,"ب",1,0],["وَأَنْتَ عَلَى المَبْذُولِ مِنْ حُرِّ مَالِهِمْ","وَآمَالِهِمْ فِي النَّابِنينَ أَمينُ",5,"ن",1,0],["وَإِن تَعتَذِر بِالمَحلِ عَن ذي ضُروعِها","إِلى الضَيفِ يَجرَح في عَراقيبِها نَصلي",6,"ل",2,0],["وأن تعشّقت دعداً","منحتني وصل هند",7,"د",1,0],["وإن تعرض معتس الذئاب له","أوفى بأولق ذي الزِّيَّونة الحرِبِ",8,"ب",1,0],["وَأَنتَ عَبدٌ لِقَينٍ لا فُؤادَ لَهُ","مِن آلِ شَجعٍ هُناكَ اللَومُ وَالخَوَرُ",9,"ر",1,0],["وإن تعرض في الليل طيف كرى","فلا تشقني وغيري سالياً فشق",10,"ق",1,0],["وإن تعذّر معلومي عليه ففي","معلوم جودك أو في مدحه شغلي",11,"ل",2,0],["وَأَنتَ عِندي كَروحي","بَل أَنتَ مِنها أَحَبُّ",12,"ب",1,0],["وأنت علَّمتني رَعْيَ الحقوق إذا","نابت وأدَّبتني بالصبر للمحن",13,"ن",1,0],["وإن تَعتَّبْتَ أو أعرضتَ آونةً","ناجَى النُّهى واستلانَ الجانبَ الخشنا",14,"ن",2,0],["وَإِن تَعرِضوا فيها لَنا الحَقَّ لا نَكُن","عَنِ الحَقِّ عُمياناً بَلِ الحَقَّ نَسأَلُ",15,"ل",1,0],["وَأَن تَعقِرا بَكرَينِ مِمّا جَمَعتُما","وَشَرُّ النَدامى مَن صَحا غَيرَ غارِمِ",16,"م",1,0],["وَإِن تُعرِضي عَن مَفرِقي وَهوَ أَبيَضٌ","فَيا طالَما قَبَّلتِه وَهوَ مُسوَدُّ",17,"د",1,0],["وأنت عبقرية","من اكبر العباقره",18,"ر",2,0],["وانت عون لي على الدهر","ان الدهر حزب",19,"ب",1,0],["وانت على قديم العز تبكى","وتندب رتبة لك او وساما",20,"م",2,0],["وَأَنتَ عَلى أَعِنَّتِهِم قَديرٌ","وَهُم بِكَ في الَّذي تَقضي حُفاةُ",21,"ه",1,0],["وأنت عَلاَّمُ غُيُوبِ النّثَا","يَوْماً إذا نَسْألُ أَوْ نُسْألُ",22,"ل",1,0],["وَأَنتَ عِندَ الصِراطِ مُعتَرِضي","فَلا تَخَف عَثرَةً وَلا زَلَلا",23,"ل",2,0],["وأَنت عَدْلٌ فسِرْ فيهم بسيرَتِهِ","فالعَدْلُ في المُلكِ عنه تُحْمد السيرُ",24,"ر",1,0],["وأَنْتَ عَلى أَعمارِهِم سَوفَ تَعتَلي","لِعُمرٍ مُقيمٍ في السعادَةِ مُمتَدِّ",25,"د",1,0],["وأن تعرو لسانك تمتمات","وأن يتفرط العقد الفريد",26,"د",1,0],["وَأَنتَ عَلَينا إِن نَأَيتَ وَإِن دَنَت","بِكَ الدارُ فَاِعلَم يا اِبنَ عَمِّ كَريمُ",27,"م",1,0],["وَإِن تَعدُ لا تَحفِل وَإِن تَدنُ لا تَصِل","وَإِن تَنأَ لا نَصبِر وَإِن تَدنُ أَجذَلِ",28,"ل",1,0],["وَأَنتَ عَلى الجيرانِ قُنفُذُ تَلعَةٍ","أَزومٌ عَلى السَوءاتِ وَاِبنُ أَزومِ",29,"م",1,0],["وَأَنتَ عَلَيكَ مَغضوبٌ","وَقَلبُكَ غَيرُ مُصطَبِرِ",30,"ر",1,0],["وَأَنتِ عَمّا أُلاقي فيكِ لاهِيَةٌ","بِالعِطرِ وَالمَلبَسِ القَزِّيِّ وَالسَبَدِ",31,"د",1,0],["وَإِن تَعَلَّلتُ إِلى زَلَّةٍ","أَكَلتُ في سَبعَةِ أَمعاءِ",32,"ا",2,0],["وَإِن تُعظِموا في دينِكُم جُمُعاتِكُم","فَإِنَّ رِجالاً أُولِعَت بِشِيارِها",33,"ر",3,0],["وَأَنتَ عَلى الأَقصى صَباً غَيرُ قَرَّةٍ","تَذاءَبَ مِنها مُرزِغٌ وَمُسيلُ",34,"ل",1,0],["وانتعشَ الدينُ بعدَ عَثْرتهِ","واتّصلتْ كفُّهُ على عَضدِهْ",35,"د",2,0],["وأنت على الأرض الحقيرة ذرة","تحاول جهلاً أن تحيط بها علما",36,"م",2,0],["وأن تعلو لسانك تمتماتٌ","وأن يتفرّط العقد الفريد",37,"د",1,0],["وأنتِ على فراش الطُّهْ","رِ كالزنبقة الوَسْنى",38,"ن",2,0],["وأنت عنهنَّ مشغولٌ بجاريةٍ","كأنَّ أجراسَها في الأُذن قِيثارُ",39,"ر",1,0],["وأنْ تُعْطَوا خُلوداً في سُعودٍ","كما خَلَدَتْ على الأرضِ الجِبال",40,"ل",1,0],["وَأَنْ تَعْدِلَ الأيَّامَ حتَّى تُعِيدَهَا","إِلى مُلْكِهَا الْمَبْسُوطِ في الْبَحْرِ وَالبَرِّ",41,"ر",1,0],["وأنت على الطريقة لن تبالي","بمن تفنين حينا بعد حين",42,"ن",1,0],["وان تعارضك اثنتان فاتخذ","أولاهما بالحق وانبذ الهوى",43,"ا",1,0],["وأنت عمادي واعتدادي ومفزعي","وذخر أماني والحديث يطول",44,"ل",1,0],["وإن تعتذرْ بالمحلِ منْ ذي ضروعِها","إِلَى الضَّيْفِ يَجْرَحْ فِي عَرَاقِيبهَا",45,"ه",2,0],["وأنت عَضَدْتَ الملك يَومَ بدا له","يُهدِّدُهُ قَرْنٌ من الشرّ ناجم",46,"م",1,0],["وإن تعجب فمن لَبِقٍ أريبٍ","عليه تساويا سَطْحٌ وعُمق",47,"ق",1,0],["وإن تعذلاني في نحيب ألفته","فاسكت عنه إنني لجليد",48,"د",1,0],["وأنت على فراش الطهر ، كالزنبقة الوسنى","فضمى جسمك العارى ، وصونى ذلك الحسنا",49,"ن",2,0],["وَإن تُعَادِل بالجذورِ عَدَدا","فَتِلك تَتلوها عَلى ما حُدِّدا",50,"د",2,0],["وأنت عياذي والنصير وموئلي","كفى بك يا سيف القضا في البلا ذخرا",51,"ر",2,0],["«وانتَ عاوز إيه وسَّعْ»، ومَضَتْ","مثلَ نَجمٍ في بُنَيَّاتِ المَجَرّةْ",52,"ر",2,0],["وأنت عليم بما قد لقيت","وما سألاقي وما بي يراد",53,"د",1,0],["وأنتَ عِليمٌ بالذي أنا مضمرٌ","مِن الحق في إنصافكم والتَّدبُّرِ",54,"ر",1,0],["وأنت على ما كنت تعتاد باقيا","مع الله لا تخشى مطالا ولا غدرا",55,"ر",2,0],["وأنت عليه منك اجرا على الورى","بما فيك من جهل وخبث طوية",56,"ه",1,0],["وإن تعف فعن حلم وعلم","تمُنّ ومنّك المنّ القديم",57,"م",1,0],["وَأنتَ عبدٌ للَّه صفوتهُ","وَقَد أَسأنا فإن عفَوت عفا",58,"ف",2,0],["وَاِنتَعَشَت حُشاشَةُ النَسيمِ","فَاِرتَعَشَت في وَرَقِ الكرومِ",59,"م",1,0],["وَأَنتِ عِشقي فَلِم أَغنّي","وَتَصمُتين",60,"ن",1,0],["وَأَنت عَلِيَّ القَدرِ أُبتَ معزَّرا","إِيابَ نَميرِ الماءِ وافى على ظَما",61,"م",2,0],["وإن تعمل بها خيراً وشرّاً","فمنسوخٌ تسطّر في دفاتر",62,"ر",1,0],["وَإِنْ تَعَوِّضَ قَوْمٌ مِنْ أَحِبَّتَهَمْ","فَما تَعَوَّضْتُ إِلاَّ الْوَجْدَ وَالأَسَفا",63,"ف",2,0],["وأنت عدتنا عند الخطوب إذا","لحت وهمت بإيقاع وعدوان",64,"ن",1,0],["وَإِن تعمّد ذمّي لا أمانعهُ","وَإِن أرادَ ثَنائي لست أثنيهِ",65,"ي",2,0],["وَأَن تَعتاضَ بِالتَخليطِ رُشداً","فَإِنَّ الرُشدَ مِن خَيرِ اِعتِياضِ",66,"ض",1,0],["وَأَنتَ عِندي صَدوقُ","كَما أَنا لَكَ ذاكا",67,"ك",2,0],["وإن تعلمت فبالله استعن","ثم بإخلاص وقلب مطمئن",68,"ن",1,0],["وَإِن تَعفُ فَالعَفو بَعض التُقى","وَناهيك مَنزلة المُتَّقي",69,"ق",2,0],["وَأَنتَ عندي أَجَلّ من أَن","يُشبه رَد الرِياض خَدّك",70,"ك",1,0],["وَإِن تُعطِكَ الأَيّامُ ما قَد أَخَذتَهُ","فَما زالَتِ الأَيّامُ تُعطي وَتَأخُذُ",71,"ذ",1,0],["وإن تَعوَّضتُ مِن عَوارِضِهِ","لَثماً تَجنَّى عليَّ واستَكبَر",72,"ر",1,0],["وإن تُعط العليْ نفساً وجسماً","تنل من جوده أسنى العطايا",73,"ا",3,0],["وأنت عالم بحالي","وما إليه مآلي",74,"ي",1,0],["وأنت عالم بما في باطني مخزون","أقول ما قال عبدك يونس ذو النون",75,"ن",1,0],["وأنتَ على شفا النّيرانِ إنْ لَمْ","يُغثكَ بعفوهِ الربّ الغفورُ",76,"ر",1,0],["وأنت عزيز قومك في أسود","من الأشراف ليس له مسام",77,"م",1,0],["وَأَنتَ عَميد العُلى لَم تَزَل","وَأَنتَ لك اليَعمل الشَد قَميّ",78,"ي",1,0],["وأنت عليم أنه طول دهره","يمرّ عن الأيّام والناس معرضا",79,"ض",2,0],["وأنت على الحالين تخشى وترتجى","شديد على الأعداء خرق سميدع",80,"ع",1,0],["وأَنتَ عليها شهيدُ العِيانِ","وحكمُكَ فِيهَا صريحُ الوُجوبِ",81,"ب",1,0],["وإِن تعرض باب الشر منغلقاً","دعه وَأَغلقه إِن لاقاكَ مفتتحا",82,"ح",2,0],["وان تعود ديار الانس موحشةً","وأن يكون طريق الوصل منقطعا",83,"ع",2,0],["وأن تعم شعوب الناس قاطبة","مثل الهواء ومثل النور في آن",84,"ن",1,0],["وإن تعُجْ أو تُعن فيما أتيتُ أصفْ","مع رحبِ صدري أمورا ضيَّقتْ عَطَني",85,"ن",2,0],["وأن تُعلَف الرطبَ الخليطَ ببابل","مكانَ أراك حاجرٍ وبَشامِها",86,"م",3,0],["وإنْ تَعالى رجالٌ عند جُودهُمُ","فمخبتٌ غيرُ ذي كبر ولا أشَر",87,"ر",1,0],["وَأَنتَ عَلى قُربِ ما بَينَنا","كَأَنَّكَ في البُعدِ مِنّي السَماءُ",88,"ا",2,0],["وَأَنتَ عَريض الجاه وَالفَضل واسع","وَمَهما تَقل يسمع فَجد بِالتطولِ",89,"ل",1,0],["وأَنْتَ عَبْدٌ تَحْتَ حُكْمِ القَضا","لَيْسَ لَهُ في نَفْسِهِ حُكْمُ",90,"م",1,0],["وأَنْتَ عاصٍ خَاطِي","مُفَرِّطٌ مُتَعاطِي",91,"ي",1,0],["وأن تَعِزَّ لِلتها","مي في الورَى أشبَاه",92,"ا",2,0],["وأنتَ على ظَهر مجدولةٍ","من الشّدِّ والطّرْدِ جَدْلَ العِنانِ",93,"ن",1,0],["وأنت على مَعْروقةٍ عند شدّها","كذئبِ الفلا أوْ شِدَّةً كسِلامها",94,"م",3,0],["وأنت على جَنْبَيْ سريعٍ إلى المدَا","كأنّك منه فوق ظهرِ شَمامِ",95,"م",1,0],["وَأَنتَ عَلى ظَهرِ عالي التلي","لِ عَبلِ القوائمِ وافي الحزامِ",96,"م",1,0],["وإن تَعْرَ منّا اليومَ فالغصنُ يُغتَدى","وريقاً زماناً ثُمّ يَعْرى وريقُهُ",97,"ق",2,0],["وَأَنتَ عَلى رَخْوِ العِنانِ كأنّه","منَ الضُّمْرِ طاوٍ ليس يروي ويشبعُ",98,"ع",1,0],["وأنت عقلك الذي عشت به","فوقك مسدول عليك مغرم",99,"م",1,0],["وأنت عصام الدين إن ناب حادث","بعلياك يحمى ربعه والمعاهد",100,"د",1,0],["وَأَنتَ عَمودُ الدِّينِ مَهما تَقُل يُقَل","وَمَهما تَضَع مِن باطِلٍ لا يُلَحَّقِ",101,"ق",1,0],["وإنْ تَعَرَّضَ في وَقْتٍ يُقَدِّرُهُ","لَكَ التَّشَكُّكْ جَلاَّهُ بِتَصْحِيْحِ",102,"ح",1,0],["وَإِن تَعرُهُ الأَحداثَ مِن بَعدِ بَسطَةٍ","فَيُّ الوَرى لَم يَلقَ بوسى وَأَنعُما",103,"م",2,0],["وأنتَ عندَ السراطِ تَعرفُني","فلا تَخفْ عَثرةً ولا زَلَلا",104,"ل",2,0],["وإن تعطها عبد العزيز ظلامة","فأولى بها منا ومنكم بنو حرب",105,"ب",1,0],["وَأَنتَ على تِلكَ الصِفات جَميعها","جُبلتَ بِنَص عَن عدوّ وَصاحب",106,"ب",1,0],["وَأَنتَ عَلى رَغم الحَسود مؤيَّدٌ","بِنَصرٍ عَزيزٍ غَيثُ جدواه هطال",107,"ل",1,0],["وإِنْ تَعُودُوا بَعْدَ نُصْحِي لكمْ","تخالفوني فالبراءَ البَرا",108,"ر",2,0],["وإنْ تَعُدْكُم فَحيُّوها فَعَوْدَتُها","مِنِّي بردِّ سلامٍ غَيْرِ مُنْصَرِمِ",109,"م",1,0],["وأنْتَ عرسه تغازل أيري","قلت لا تبغني فلست بزاني",110,"ن",2,0],["وأن تعود إلى ماضي نفوذك في ال","وادي وتصبح ذا نقض وإبرام",111,"م",1,0],["وأنت على حالة مكره","هي العظة المُرَّة القاسيه",112,"ي",2,0],["وأنت على وقار منه كادت","تميد الأرض ممتلئ حنانا",113,"ن",2,0],["وَأَنتَ عَلى الإِجمالِ في الدَّهرِ مفردٌ","ومثلُكَ في ذا الوقتِ لَيسَ بِمَوجودِ",114,"د",1,0],["وَأَنتَ عِندي جَوهَرٌ مُفرَدٌ","وَالجَوهَرُ الفردُ هوَ الجَوهَري",115,"ي",1,0],["وَأَنتَ عَروس الفَضلِ حَلّاك درُّه","وَمِن تِبرهِ صيغَت لديكَ السبائِكُ",116,"ك",1,0],["وَأَنتَ عَليُّ الجاهِ تَسمو بِكَ العُلى","وَكانَت لَكَ العَلياءُ أَسنى المراتبِ",117,"ب",1,0],["وان تعفقت للأغراض تختله","فاعلم بأن عيون الحق لم تنم",118,"م",1,0],["وإن تعرض أهلُ الفسق كذَّبَهم","من الكرام لكم بالمجد إقرارٌ",119,"ر",1,0],["وإنْ تعرضَ ذو لؤم لمأربَةٍ","فلبْوَة الليث لا تنقاد بالرَسَنِ",120,"ن",1,0],["وإن تعمَّدتَ على ضيْعة ال","حزْم تعمدتَ على الظلم",121,"م",1,0],["وإن تعرضت من عوارضه","لثماً تجني عليّ واستكبر",122,"ر",1,0],["وإن تعرى دعي من فضائله","فأنت مدرع منها وملتحف",123,"ف",1,0],["وَإِنْ تَعالَى كانَ أَهْلَ المَفْخَرِ","أَبْيَضَ وَضَّاحَ الجَبَيْنِ الأَزْهَرِ",124,"ر",1,0],["وان تعدوا نعمة الإله","فمالها حصر ولا تناهي",125,"ي",1,0],["وإن تعسّر حلّ الخطب مدَّ له","صمصام عزم لها مات العدى فلقا",126,"ق",2,0],["وأنت عندي حاضر","وكثرة من العدد",127,"د",1,0],["وأنت عدته في نيل همته","وأنت في كل ما يهواه مأمولُ",128,"ل",1,0],["وأن تعسر حادي الظعن ذاك فخذ","منه التحايا إلى المحبوب ذي المنن",129,"ن",1,0],["وَأَنتَ عِندَ ظَني","أَهل لِكُل منّ",130,"ن",1,0],["وَإِن تَعفُ فَعَفوُكَ قَد أَراني","لِأَفعالي وَأَوزاري الثِقالِ",131,"ل",1,0],["وأنت على الفعل الرضي تثيبني","وتوسعني شكراً وليست صنيعتي",132,"ي",1,0],["وأنتِ عَروب فيك مستمتع الصّبى","دَلالك فتّان وشرخك فائِقُ",133,"ق",1,0],["وأنتَ عزيزُ الجار مُمْتنعُ الحِمى","لديك الفناء السَّهل والمنزلُ الرحبُ",134,"ب",1,0],["وأنت على البيدر المستحب","تغني مع النغم المرسل",135,"ل",1,0],["وَأَنتَ عَلى رَفعي وَوَضعِيَ حُجَّةٌ","فَكُن بي عَلى أولاهُما بِكَ جارِيا",136,"ي",2,0],["وأنت عظيم الشان من قبل رتبةٍ","حباك بها خير الملوك الأعاظم",137,"م",1,0],["وأنت على ما يعهد النّاس مقعدٌ","أسيرٌ يعاني في مفاصله وهنا",138,"ن",2,0],["وأن تعرف الأقوامُ سَوْرَةَ عَدْلِهِ","كما احتَمَلتْ نارَ القيون السبائك",139,"ك",1,0],["وإن تعجب فمن عجب جنود","تلذ الفتك بالمستضعفينا",140,"ن",2,0],["وأنت على أناتك لا تبالي","أشاح الموت أم لمع السلاح",141,"ح",1,0],["وأنت على الصبر الجميل مفوض","لربك في صدق وثبت جنان",142,"ن",1,0],["وأنتَ عَفٌ طيّب