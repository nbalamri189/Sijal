{"poems":[[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[94,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[94,"كنا كزوجي طائر","https://www.aldiwan.net/poem38903.html","مجزوء الكامل"],[68,"توق سبعة أيام قد اطردت","https://www.aldiwan.net/poem38421.html","البسيط"],[99,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[99,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[168,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[203,"أم يكيد لها من نسلها العقب","https://www.aldiwan.net/poem45409.html","البسيط"],[228,"سمعتني أقول شعرا شقيا","https://www.aldiwan.net/poem41592.html","الخفيف"],[261,"قيل إن الوزير قد قال شعرا","https://www.aldiwan.net/poem48567.html","الخفيف"],[396,"يا طالب الأيصا هداك الله خذ مني كلام","https://www.aldiwan.net/poem54503.html","عموديه"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77575","الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47203","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102719","المواليا"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130752","الخفيف"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203551","الرجز"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110073","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131207",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131240",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111518","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45144","البسيط"],[4699,"من الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=155961",""],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[4767,"مصعد الأحوال","https://www.poetsgate.com/ViewPoem.aspx?id=180769",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5605,"معلقة الخليفة","https://www.poetsgate.com/ViewPoem.aspx?id=159729",""],[5628,"أطياف على الضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=178549",""],[5720,"طَيِّبَةُ اللَّمَىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=213055",""],[5720,"حَوْرَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214146",""],[5887,"قال السجين","https://www.poetsgate.com/ViewPoem.aspx?id=35277",""],[6115,"مايقهر الرجل ويمشيه مثل الكسير","https://www.poetsgate.com/ViewPoem.aspx?id=180483",""]],"verses":[["ثُمَّ أَخَذتُ نَبلَةً كانَت مَعي","وَدُرتُ دَورَينِ وَلَم أُوَسَّعِ",0,"ع",1,0],["ثمَّ اخْتَفَتْ خَلْفَ السَّماءِ","وراءَ هاتيكَ الغُيُومْ",1,"م",1,0],["ثمَّ اختَفَتْ أوَّاهِ","طائرةً بأَجْنِحَةِ المَنُونْ",1,"ن",1,0],["ثمَّ اختفى خَلْفَ الغُيومِ","كأَنَّهُ الطَّيفُ الحَزينْ",2,"ن",1,0],["ثم اخش حادي عشريه فخشيته","حزم ورابعها يخشى وخامسها",3,"س",3,0],["ثم اختفى خلف الغيو","ب مخلِّفاً ظُلم المساء",4,"ا",2,0],["ثم اختفت والجمع يرقبها","ويلحّ عودي ليس يرحمها",5,"ه",2,0],["ثُمَّ أَخلَدتُ يَحسبُ القَومُ أَنّي","بَينَهُم لِلأسى قَريفٌ وَخيطُ",6,"ط",1,0],["ثم اختفتْ وعلينا الشمسُ شاهدةٌ","كأنها جمرةٌ في الجوِّ تلتهبُ",7,"ب",1,0],["ثُمَّ أَخفَت في ضفة العَينِ دَمعاً","شاءَ سِرَّ الوِقار أَن تُخفيه",8,"ه",1,0],["ثم أخفاه فهو كالهر يخرا","في زوايا البيوت ثم يطمه",9,"م",2,0],["ثم أخذ عنهم وسارنحو سيرتهم وقام","التابعون لهم بإحسان إلى يوم القيام",10,"م",1,0],["ثُمَّ اِختِلافُ اللَيلِ وَالنَهارِ","وَمخرجُ الغروس وَالأَشجارِ",11,"ر",1,0],["ثُم اِختَفَيت بِمغارٍ عَنها","وَقَد تَحَقَّقت بِعَيني مِنها",12,"ه",2,0],["ثم اختفى كالشّمس قرصاً لاسناً","فابناه في فَلَكِ الحياة سناه",13,"ا",2,0],["ثم اختم بذكر الحيّ أبداً ولا زال","مع صلاة على المختار والصحب والآل",14,"ل",1,0],["ثم أخفى وجه النهار كئيبا","وهو يبكي طيَّ الظلام فحالا",15,"ل",2,0],["ثم أخاه في السلوك والسكنْ","ذا الهمة العليا الرضى أبا الحسن",16,"ن",1,0],["ثم أخاه البر إبراهيما","كان محباً صادقاً كريماً",16,"م",2,0],["ثُمَّ آخَيتَ بينهم فَتَآخَوا","وَتَواصَوا عَلى الهدى وَالوِئامِ",17,"م",1,0],["ثُمَّ اختبارُ أُناسٍ في مَوَدَّتهم","ببسطِ عُذر إذا ما زَلَّتِ القَدَمُ",18,"م",1,0],["ثم اخنى على الغصون فعادت","عارياتٍ تميس في الروض ملدا",19,"د",2,0],["ثم اختال راضياً عن شبابي","فتريني المرآة كهلاً غضوبا",20,"ب",2,0],["ثم أخيل صاح بالنبال","يطمعهم بالأفؤس الغوالي",21,"ي",1,1],["ثُمَّ اِختمِ اللَهُ لي بِخَيرٍ","يا سامِعَ القَولِ يا مُجيبُ",22,"ب",1,0],["ثم اختبر ماعشت لن تجد الهوى","كل الذي فى الأرض وهم فاني",23,"ن",2,0],["ثُمَّ اخْتِلاَطُ النَّاسِ حَتَّى كَأَنَّهُمْ","بِقَطِيعِ عَنْزٍ سِيقَ بِالبَطْحَاءِ",24,"ا",2,0],["ثم اختفى ما قد بدا في وجهه","من قبلُ للإنْهاء من آمالِ",25,"ل",1,0],["ثم َّ أخبرْ من شوّهونا لديكم","نحنُ نبقى ولن يموتَ القرارُ",26,"ر",1,0],["ثم اخسِفْ متجرَ إسكافٍ","لو رَقَّ لِكَي يَخْصِفَ نعْلَهْ",27,"ل",2,0],["ثم أخرجت زفرة وكلاما","من فؤادي قسرا ببعض انتزاع",28,"ع",1,0],["ثم اختفت في ذات ليلة","رحلت إلى الأرض الفضيلة",29,"ه",1,0],["ثمَّ اختَفتْ عنّي فلمْ أَرَها","كالطيْفِ زارَ العيْنَ وارتحلا",30,"ل",2,0],["ثُمَّ اخْتَفتْ تِلك المهاةُ واشعَلَتْ","في القلبِ آهاتٍ .. أذابَتْ عَبرَتِيْ",31,"ت",2,0],["ثمَّ اختفتْ بين الحُشُودِ .. كأنَّها","نَصَبَتْ لها عن ناظريَّ حجابا",32,"ب",2,0],["ثم اختفت بصفائها","فرجعت أرنو للقمر",33,"ر",1,0],["ثم أخلفوا هقوته في صبح ولا عصير","وهم بالسوالف رجالٍ تفتل اشنابها",34,"ب",3,0]]}