=33180",""],[5608,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=33533",""],[5628,"الشوق والمستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=178554",""],[5730,"أحبها","https://www.poetsgate.com/ViewPoem.aspx?id=210346",""],[5732,"غيض الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=177948",""],[5739,"قصيده تنتظر شاعر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131709",""],[5764,"حبيت أنبّه !","https://www.poetsgate.com/ViewPoem.aspx?id=159090",""],[5798,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=139103",""],[5841,"اموت انا بالقاف لا منك نطقتي به","https://www.poetsgate.com/ViewPoem.aspx?id=37038",""],[5851,"رسالة إلى ابن زريق البغدادي","https://www.poetsgate.com/ViewPoem.aspx?id=175230",""],[5853,"نجوايَ","https://www.poetsgate.com/ViewPoem.aspx?id=175715",""],[5944,"عنيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213101",""],[5956,"أبي والغيد","https://www.poetsgate.com/ViewPoem.aspx?id=184883",""],[5956,"الحنوُّ الغزير","https://www.poetsgate.com/ViewPoem.aspx?id=192936",""],[5957,"فراشة النبع(هديل)","https://www.poetsgate.com/ViewPoem.aspx?id=204890",""],[5977,"حب الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=213124",""],[5997,"أحبة","https://www.poetsgate.com/ViewPoem.aspx?id=214205",""],[6068,"‫#المغرب‬ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=177019",""],[6093,"(تغيير اسم) *","https://www.poetsgate.com/ViewPoem.aspx?id=205522",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6102,"مَرارَةُ الحَقِيقَة","https://www.poetsgate.com/ViewPoem.aspx?id=182766",""],[6102,"كَأَنَّ يَومَ الهَوَانِ عِيدُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=184855",""],[6256,"سُجُوّ الغروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65922&r=&rc=10",""]],"verses":[["أحِبّةَ قَلْبي لا تظنّوا بأنّني","نسيتُ وأفْنَى البُعْدُ نِيرانَ أضْلُعي",0,"ع",2,0],["أُحِبُّهُمُ لِحُبِّ اللَهِ حَتّى","أَجيءَ إِذا بُعِثتُ عَلى هَوِيّا",1,"ي",2,0],["أَحِبَّةَ قَلبي في الدُنُوِّ وَفي النَوي","وَأَقصى أَماني النَفسِ في السِرِّ وَالعَلَن",2,"ن",1,0],["أُحِبُّها وَهِيَ لي مُعانِدَةٌ","كَأَنَّني لَستُ مِن أَحِبّاها",3,"ا",3,0],["أُحِبُّها تَأبى مُوافَقَتي","خاسِرَةً دينَها وَدُنياها",3,"ا",3,0],["أَحَبِّها لَنا","عِدَّةَ الشُهُب",4,"ب",1,0],["أُحِبُّهُ وَالهَوى وَأَدأُرَهُ","وَكُلُّ حُبٍّ صَبابَةٌ وَوَلَه",5,"ل",2,0],["أحبه .. لست أدري ما أحب به","حتى خطاياه ما عادت خطاياه",6,"ا",2,0],["أحبَّةَ قلبي إنَّ قلبي نزيلَكُمْ","وحاشا نزيل الأكرمينَ يضامُ",7,"م",1,0],["أُحِبُّ هُبوطَ الوادِيَينِ وَإِنَّني","لَمُشتَهِرٌ بِالوادِيَينِ غَريبُ",8,"ب",1,0],["أَحَبَّهُ الناسُ دونَ مُختَلِفٍ","كَما أَحَبّوا الشَبابَ مُقتَبَلا",9,"ل",2,0],["أحبه والهوى وأدوره","وكل حبٍ صبابةٌ ووله",10,"ل",2,0],["أَحَبَّها وأَحَبَّتهُ وَعاهَدَها","أنْ لا يُظلِّلَهُ في الحُبِّ إِلاَّها",11,"ا",3,0],["أحبة قلبي لا تظنوا بأنني","نسيت وأفنى البعد نيران أضلع",12,"ع",1,0],["أحبة راعها والشمل منتظم","داعي الوداع فمن باك ومعتنق",13,"ق",1,0],["أحبّه كثر ماشفت الخيانه في عيون أصحاب","وأحبّه كثر ما أعقول الدواهي .. تحسب أحسابي",14,"ب",2,0],["أحبّه قلبي إن بعدتم فما نأى","عن القلب لا الذكر الملحّ ولا الحبّ",15,"ب",1,0],["أُحِبُّ هُبوطَ الوادِيَينِ وإِنَّنى","لَمُستَهتَرٌ بِالوادِيَينِ غَرِيبُ",16,"ب",1,0],["أحبّها وأراها حين أنظرها","روحا من الجن تستهوى وتختدع",17,"ع",1,0],["أَحبَّها وَأَحَبَّتهُ","وَماتا عَلى هَوىً وَتَلاقِ",18,"ق",1,1],["أُحِبُّهُ حُبَّ عِمادَ الدينِ","لِلسَماحِ",19,"ح",1,0],["أحبة هم مني قَلبي وهم أَملي","وَهم علاقة نَفسي اذنأوا وطنا",20,"ن",2,0],["أحبة قلبي هل لأيامنا التي","تقضت بذات البان إذن برجعة",21,"ه",1,0],["أحبةً كرام","وبالمليح فاهوا",22,"ا",1,0],["أُحِبُّهُما وَأَبذُلُ جُلَّ مالي","وَلَيسَ بِلائِمي فيها عِتابُ",23,"ب",1,0],["أحبها وهي لي معادية","كأنني لست من أحباها",24,"ا",3,0],["احبه ودموعي","شهود حبي وسهدي",25,"ي",1,0],["أَحِبَّة قَلبي وَالمُنى طوع أَمركم","صلوني فَلَيلي طال مِن طول هَجركم",26,"م",1,1],["أَحبّةٌ عن هوىً لا عن قِلىً جعلوا","ركائبي للنّوى محلولةَ العُقُل",27,"ل",1,0],["أُحِبُّهُ وَالسَماءِ وَالطارِقْ","حَبّاً عَفيفاً ما اِسمي بِهِ عاشِقْ",28,"ق",1,1],["أُحبّهُمُ حُبّي الحياةَ محبّةً","جرتْ في دَمي والرّوحِ فَهي لها خِلْطُ",29,"ط",1,0],["أحبَّهُم وأداريهم وأوثرهُم","بِمُهجتي وخصوصاً منهمُ نفرا",30,"ر",2,0],["أحبة قلبي كنت من قبل بينكم","جهولاً بحقي في الهوى ونصيبي",31,"ب",2,0],["أحبة قلبي إن صبري عنكم","غريباً لعمري صار أي غريب",31,"ب",1,0],["أُحبّهُ وهو باخلٌ ومن ال","عناءِ حبُّ اللَّيان والبخَل",32,"ل",1,0],["أحبُّهُ وهو نفورٌ باخل","من منصفي من النّفور الباخل",33,"ل",1,0],["أحبَّةٌ رحلوا فالدمعُ مستبقٌ","من مقلتَّي على الأثارِ يَبتدِرُ",34,"ر",1,0],["أحبَّةَ قلبي بعدَما بانَ أنسُكمْ","وبِنتمْ عنِ الجرعاءِ كيف أكونُ",35,"ن",1,0],["أحبَّةٌ لو قيلَماذا الذي","نختارُه ما قلتُإلا همُ",36,"م",1,0],["أحبَّةٌ كان مستوراً حديثُهمُ","حتى تطاولَ عمرُ البينِ فاشتهرا",37,"ر",2,0],["أحبَّةٌ قد كان ناديهمُ","له بنورِ القومِ اِشراقُ",38,"ق",1,0],["أحِبَّةً جَلَوْا بُدورَ أَوجهٍ","وبالشُّموسِ شَرَفاً تَقَنَّعوا",39,"ع",3,0],["أَحبَّةَ قلبي والمَحَبَّةُ لم تزَلْ","تُحَقِّقُ آمالي بكم يا أَحبَّتي",40,"ي",1,0],["أحبة لهم في القلب منزلة","أضحت وفردوس أخلاقي لها نزل",41,"ل",1,0],["أَحِبّةٌ لَم يَزالوا مُنتَهى أَمَلي","وَإِن هُمو بِالتَّنائي أَوجَبوا أَلَمي",42,"م",2,0],["أَحِبّةٌ ما لِقَلبي غَيرُهُم أَرَبٌ","وَحُبهم لَم يَزَل يَربو مِن القِدَمِ",42,"م",1,0],["أُحبُّهُ وقليلٌ ذاك مُحتَقَرٌ","حبَّ الغريبِ القَصِيِّ الدّارِ للوطَنِ",43,"ن",1,0],["أحبة الله بين الخلق صبرهم","معظمين كما الأعدا بضدهم",44,"م",1,0],["أُحِبُّها وَأَراها","تَرى وُجوبَ اِغتِيالي",45,"ل",2,0],["احبَّه الشعب حباً مخلصا وصفت","له نواياه في سر واعلان",46,"ن",1,0],["أحبه من فؤاد مخلص عرب","بل حفه حب إعجام وأعراب",47,"ب",1,0],["أُحِبُّهُم ويُحِبُّونِي كَما زَعموا","لكِن أَرى وُدَّهُم في ذاتِهِ عَرَضا",48,"ض",2,0],["أحِبَّةَ قَلْبي أهْلَ نَجْدٍ بِعَيْشِكُمْ","تُرى يَبْلُغُ المُشْتاقُ ما يَتَمنَّاهُ",49,"ا",2,0],["أحبَّها وهي تخفي حبَّه أدبا","وظنها جهلت نجواه فانتحبا",50,"ب",2,1],["أحبها وأحبته فما لبثا","أن أحدث الحب في قلبيهما شررا",51,"ر",2,0],["أَحِبّةَ قَلبي عَن عُيوني نَأيتُمُ","وَكُلٌّ بِأَحشائي مُقيمٌ وَقاعِدُ",52,"د",1,0],["أَحِبّةَ قَلبي إِنَّ وَجدي بِحبّكُم","يَزيدُ وَيَحيا فيكُم وَهوَ خالِدُ",52,"د",1,0],["أَحبَّةَ قَلبي قَد قَطعتم رَسائِلا","وَإِنّي بِحُسنِ المَدحِ فيها لَراجزُ",53,"ز",1,1],["أَحِبَّةُ قَلْبي مَا وَفَوْا لي بِعَهْدِهِمْ","وَمَا رَحِمُوا فِي الْحُبِّ ذِلَّةَ عَبْدِهِمْ",54,"م",1,0],["أحبها والذي براها","حب أبي الفضل للسماحِ",55,"ح",1,0],["أحبه إن شاء قتلى وإن","أساء او لم يكشف الضرا",56,"ر",2,0],["أحبه الله فداك امرؤ","قد فركت راحته الوفرا",56,"ر",2,0],["احبة مهجتي هل لي سبيل","إلى لقياكمو مناً وفضلا",57,"ل",2,0],["أحبة ختم المرسلين ونسله","وقادة أهل الصالحات إلى الوالي",58,"ل",2,0],["أحبها وهي تسبي العابدين وقد","تصيدت قلبه من داخل الجسدِ",59,"د",1,1],["أَحَبُّهُم إِلَيهِ مَن","أَدخَلَ فيها ذَنَبا",60,"ب",2,0],["أَحبة قَلبي سلام على","مَنازلكم وَالخيام البواد",61,"د",1,0],["أَحبة قَلبي يا ضياء جفوني","وَيا جيرتي في سيرتي وَسكوني",62,"ن",2,1],["أحبةَ قلبي خالفوا الصد والهجرا","ومنُّوا بقربي واغنموا الحمد والشكرا",63,"ر",2,1],["أحبها وتبناها وقرَّبها","وبالملائكة الأبرار ساواها",64,"ا",3,0],["أحبة قلبي في الشآم وددتكم","بمصر يُرى عيشي الهني وعيشتي",65,"ي",1,0],["أُحبِّه وأُحبّ النّازلين به","وما تَضُمُّ نَواحيه وأَرْبُعُهُ",66,"ع",2,0],["أُحبهُم فيه رضاً واُحبُّه","كذلك مَن أُحببهُ يُكرَمُ ويُحبَبِ",67,"ب",1,0],["احبة قلبي كم أعاني لبعدكم","غريم جوى أمسى عليَّ مُسلطا",68,"ط",2,1],["أحبةض قلبي فيكم القلب آهلٌ","وإن أوحشت منكم ومنّا المنازل",69,"ل",1,0],["أَحُبُّه أو يكاد يَقْتُلني","أضمه أو يكاد ينقَصد",70,"د",1,0],["أحبُّهم وبهم قتلي بغير دمٍ","وكيفَ قتلُ مُحبٍّ ما عليه دَمُ",71,"م",1,0],["أَحبهم لا لِدُنيا لي أحاولها","وَالحُب إِن كانَ لِلدُنيا فَقَد فَسَدا",72,"د",2,0],["أَحبة قَلبي لا محتكم يَد النَوى","وَلا شط فيكم للفراق شسوع",73,"ع",1,0],["أَحبة لَم تَصخ لِعاذلها","تسُدُّ آذانِها بِأَيديها",74,"ه",2,0],["أحبها وأحب القاطنين بها","وإن جفوني بلا ذنب ولا سبب",75,"ب",1,0],["أحبُّ هياج البحر يُعلن حسنَه","ويعرض ألعاباً ويبدي تفنّنا",76,"ن",2,1],["أُحِبُّها فَوقَ ما ظَنَّ الرِجالُ بِها","حُبَّ العَلاقَةِ لا حُبّاً عَلى الخَبَرِ",77,"ر",1,0],["أحبة قلبي أين أنسي بقربكم","لقد هدني من بعدكم طول وحشتي",78,"ت",2,0],["احبها وهي تدري بي ويمنعها","عن الوفاق اختلاف الجنس والدين",79,"ن",1,0],["أحبة قلبي لم أجد قط مخبراً","يطارحني أخباركم وأرطاحه",80,"ح",2,1],["أُحِبُّها وبلادُ اللهِ واسعةٌ","حُبَّ البخيلِ غِناءُ بعد أقتارِ",81,"ر",1,0],["أحبة قلبي اين مضجعكم غدا","فحاشكم غير القلوب لكم سكنى",82,"ن",2,0],["أَحبهم ما دمت حَياً ديانة","وَاِرغَب لَكن عَن سِواهم تَرَفَعا",83,"ع",2,0],["أحبه حبكم له","فكلنا عاشق كمدْ",84,"د",1,0],["أحِبَّةَ قَلبِي عَطفَةٌ بِزِيَارَةٍ","فَمَا وَجَدَت نَفسِي عَلَى هَجرِكُم صَبرَا",85,"ر",2,1],["أحبة صب بالجوى والنوى شطوا","وماعلموا أن الهوى للقوى شط",86,"ط",1,1],["أَحِبَّةَ قَلبي هاجَ حُزني مُصابَكُم","وَذابَ أَسىً مِن أَجلِكُم وَتَمَزَّقا",87,"ق",2,0],["أَحبةَ قلبي طالَ ليليَ بعدكمْ","أَسىً فمتى أَلقى بوجهكم الفَجْرا",88,"ر",2,1],["أَحِبَّةً كُلَّما عَنَّ ادِّكارُهُمُ","تَبَدَّلَ الدَّمعُ مِن تَذكارِهمِ بدَمِ",89,"م",1,0],["أحبَّة قلبي لستُ أقوى على النوى","فهل لي إلى يوم الوصال سَبيل",90,"ل",1,0],["أحبة القلب يا من قد تفرد بخلق","أسعفوني بمأمولي وزيدوا لحتى",91,"ت",2,0],["احِبُّها فَفاادِي مِلْهَوَى ثَمِلٌ","نَشْوانُ ما ذاقَ خَمْرَ الكاسِ والطاسِ",92,"س",1,0],["أحبه حب من طابت سرائره","ولم يعر سمعه عذاله فيه",93,"ي",2,0],["أحبّها فخمةً نجلاء ذا حورٍ","عيونها السحر منها الحسن يُحتلبُ",94,"ب",1,0],["احبها للحب واحبها صد","يمكن مع الأيام تعرف خطاها",95,"ا",3,0],["أحبه موت ما أنكِر .. ولكِن .. راحَتي دونِه","وأنَا بِنت الحروف اللي .. تِثَقِل كَفَةِ الميزان",96,"ن",1,0],["احبها وين الهروب ياعضدي الايمن خليل","دام المكان اربع جهات وعيون قمرا خامسة .",97,"س",2,0],["احبها للموت عن ساير الجيل","لو انها ماهي عليّ تغلا",98,"ل",2,0],["أحبة قلبي بأذكارهم","قلوب العوارف قد هيجوا",99,"ج",3,0],["أحب هذا النصر وآموت بِ إبداعه","لو لاعبينه شراحيلي وبرناوي",100,"ا",3,0],["أحبُّها وعروق القلبِ شاهدة","وفي دمائيَ يسري عشقُها الأبدي",101,"د",2,1],["أحبه أكثر وأنا \"مشتاق","أمر لحظة على باله\"",102,"ل",2,0],["احبة القلب اني بعدكم دنف","ولهان لم يهن مطعومي ولا مائي",103,"ا",2,0],["أًحِبُّهَا إِنَّمَا لَا أَشْتَكِي أَلَمِي","وَ هَلْ يُعَاتَبُ مَنْ فِي الْعِشْقِ يَحْتَالُ ؟!",104,"ل",1,0],["أحبَّ