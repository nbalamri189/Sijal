//www.poetsgate.com/ViewPoem.aspx?id=193211",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[5957,"أحبكَ أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=11393",""],[5309,"يئست من الأصحاب والحب زائل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573842",""],[6239,"المتنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75979&r=&rc=30",""],[6242,"التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87561&r=&rc=8",""],[2220,"أجوعُ معَ الوجدانِ من أجلِ جائعٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11713&r=&rc=583",""],[2696,"أجودُ بمضنونِ التّسلادِ وإنني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27432&r=&rc=36",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""],[5190,"القفاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85045&r=&rc=120",""]],"verses":[["أَجوّبُ آجامَ المَنايا وَأُسدُها","تُرَوِّعُني مِن بَينِها بِالهَماهِمِ",0,"م",1,0],["أَجوبُ بِلادَ اللَهِ أَو أَبلُغَ الَّتي","يَسوءُ الأَعادي أَن يَعُبَّ عُبابُها",1,"ب",3,0],["أَجودُ بِمَوجودٍ وَلَو بِتُ طاوِياً","عَلى الجوعِ كَشحاً وَالحَشا يَتَأَلَّمُ",2,"م",1,1],["أَجوازُ داوِيَةٍ خِلالَ دِمائِها","جُدَدٌ صَحاصِحُ بَينَهُنَّ هُزومُ",3,"م",1,0],["أجْوَفُ مِرْنَانٌ ومَمْلُوءَةٌ","أعْذَبَ مَكْرُوعٍ ومَنْشُوحِ",4,"ح",1,0],["أَجودُ على الجَوادِ بِحُرِّ مَدْحي","وأَبخَلُ بالثَّناءِ على البَخيلِ",5,"ل",1,0],["أَجوبُ جُيوبَ البيدِ وَالصُبحُ صارِمٌ","لَهُ اللَيلُ غِمدٌ وَالمَجَرُّ نِجادُ",6,"د",1,0],["أَجودُ فيكُم بِعِلقِ دَمعٍ","كُنتُ بِهِ قَبلَكُم ضَنينا",7,"ن",2,0],["أَجودُ وَتَبخَلينَ إِذا التَقَينا","يَلينُ لَكِ الفُؤادُ وَتَغلَظينا",8,"ن",2,0],["أَجُولُ بِها عَرمَ السُرى بِتَنُوفَةٍ","بِها لِلقَطا قَد فارَقَتهُ مَواقِعُ",9,"ع",1,0],["أَجوَرَ فَتّانٍ قَطوفِ الخُطى","أَغيَدَ مِثلِ الغُصنِ مَيّاسِ",10,"س",1,0],["أَجوَدُ الناسِ وَلَو أَص","بَحَ أَسوا الناسِ حالا",11,"ل",2,0],["أَجودُ العُفاةَ الزائِرينَ وَرُبَّما","طَلَبتُ أَميرَ المُؤمِنينَ أُجادُ",12,"د",1,0],["أجوب على سيارتي الأرض دونها","فيرفعني نهد ويخفضني وهد",13,"د",1,0],["أَجْوَادُ زَحْلَةَ لاَ يُكاثِرُهمْ","بَلَدٌ مِنَ الدُّنْيَا بِأَجْوَادِ",14,"د",1,0],["أجوازُ داوية ٍ خلالَ دماثها","جددٌ صحاصحُ بينهنَّ هرومُ",15,"م",1,0],["أجوب فيافي العيش سدمان حئراً","ومالي من لفح الزمان مقيل",16,"ل",1,1],["أجوادِ ساداتِ العَرَب","عن حاتِمٍ عن مَعَن عن",17,"ن",1,0],["إجوّز احسن لأجل ما تتلخمْ","وتفضّ مسخ الشعر يا شيخ ثمود",18,"د",1,0],["أجود بها منّ غير من عليكم","وأقدم في مرضاتكم بالغا جهدي",19,"د",2,0],["أجودُ له بالروحِ لو كان باخلاً","عليَّ مدى أوقاتِه بعناقِه",20,"ق",2,0],["أجودُ بروحي للقنا في وِدادِها","ولو بَخُلَتْ وَصْلاً عليَّ وتَحْرِصُ",21,"ص",1,0],["أجَوْراً على العُشّاق والعدلُ ظاهر","وظلماً لهمْ والحقُّ أَنْجُمُه زُهرُ",22,"ر",1,0],["أَجودُ ما كانَ إِذا","عَنَّ لَهُ أَن يَنصِفا",23,"ف",2,0],["أَجُودُ بِهِ كَيْمَا يُبَرِّدُ لَوْعَتِي","فَيُضْرِمُهَا مِثْلَ الْجَحِيمِ الْمُسَعَّرِ",24,"ر",1,0],["اجول بهاتيك الديار مسلما","ويبدي اضطرابا عند وثبته الصخر",25,"ر",1,0],["أجودُ على قومي بنفسي لأنني","تعوَّدتُ كالجندي خَوضَ عراك",26,"ك",1,0],["أَجودُ بما ضنَّ الأَنامُ ببذله","وأَبخلُ فيها يزهد الثقلان",27,"ن",1,0],["أجود بدمعي والدموع على الخد","شهود على الأشواق والحزن الوجد",28,"د",1,1],["أجوع وفي يديك الخب","ز أعجنه بأحلامي",29,"ي",1,0],["أجوب فجاجه وحدي","وادعو اللَه في سري",30,"ر",2,0],["أَجوبُ البِيدَ بالشّمسِ ارْتِداءً","إذا ارتفَعَتْ وبالظِّلِّ انْتِعالا",31,"ل",2,0],["أجورُ مِن مُقلَتِه خَصرُهُ","كِلاهُما أَصبَحَ مُستَضعَفا",32,"ف",2,0],["أجولُ كما جالت قَذاةٌ بمُقلَةٍ","وأسْرِي وسَارِي النجمِ في الأفْقِ حَيرانُ",33,"ن",1,0],["أجوبُ عليها شدَّة بعد شدَّة","وإن مت ألفي البيد موتة وحدة",34,"ه",1,0],["أَجُودُكَ أَمْ جُودِ المَطَرْ","وبِشرُكَ أَمْ بشْرُ عَرْفِ الزَّهَرْ",35,"ر",1,1],["أجود حنّى بروحي في هواك وما","تنفكّ حتى بطيبِ القول في نحَلِ",36,"ل",1,0],["أجوع إلى ليلى وأظما وإنني","أحن إليها كالنياق الفواقد",37,"د",1,0],["أجود بنفسي في عزاهم كآبة","وهم بالنفوس للكآبة أجود",38,"د",1,0],["أجود من ديمةٍ وأنفذ من","سهمٍ وأرسى في الروع من جبل",39,"ل",1,0],["أجوب الدجى تخشى الأكام ظلامه","وأغشى الفيافي يتقيها ظليمها",40,"م",3,0],["أجودُ لهُ بالنفس وبالبخلُ شأنه","وأسأل منهُ عفوه وهو مذنب",41,"ب",1,0],["أَجودُ فَلا أُبقي وَرائي ذَخيرَةً","وَأُعطي فَلا آسى وَلا أَتَنَدَّمُ",42,"م",1,1],["أجوبُ الظلامَ وأهوالَه","وعزمي إذا جبتُهُ الأدرَعُ",43,"ع",1,0],["أجوبُ نحوَهمُ البيداءَ معتسفاً","كالسيفِ غيرِ كَهامِ الحدِّ أونابي",44,"ب",2,0],["أجوبُ بها مِنْ شاسعِ البيدِ مَخرِما","اِذا جاورتهُ العيسُ يمَّمتُ مَخْرِما",45,"م",2,0],["اجودُ عَلَيها بِالحَديثِ وَتارَة","تَجودُ عَلَينا بِالرِضابِ من الثَغَر",46,"ر",1,0],["أجود عليه بالمنى وهْوَ باخلٌ","وآتِي وصالاً بينه وهو هاجرُ",47,"ر",1,0],["أُجَوِّلُ في الأَطلالِ نَظرةَ عابثٍ","وَما أَنا حزناً واِشتِياقاً بِعابثِ",48,"ث",1,0],["أجودُ ابن زين أو غيوثُ سواجم","وأزهارُ روض أم ثغورُ بواسم",49,"م",1,1],["أَجوسِ خلالَ ديارِ الحبيب","فأَعثُر في ذَيلِ دمعٍ طويلِ",50,"ل",1,0],["أجُوعُ وأظما للعَقيقِ وأهلِه","وما أنا ظَمآنٌ ولا أنا جائع",51,"ع",1,0],["أجوس في فتنة الأصلاب تعصف بي","لترتوي في عروقي نشوة الغدد",52,"د",1,0],["أَجوْراً ومِنْ تِلْقائِكُمْ يُطلَبُ العدلُ","ويُلتَمَسُ الإِحسانُ والجودُ والفضلُ",53,"ل",1,1],["أجود بروحي غير أن سبيلَها","إليكم كما يأبى الهوى متعذِّر",54,"ر",1,0],["أجوبُ فيافيهِ بهمَّتي التي","عَلت عن محلِّ الأنجمِ السَّبعةِ الزُّهرِ",55,"ر",1,0],["أجولُ وخيرُ الناس ينظرُ جرأتي","على الصّفِّ في الأقدامِ والكرِّ والفرِّ",56,"ر",1,0],["أَجوبُ الفَيافي وَالدِّيارُ بَعيدَةٌ","وَإِنَّ بَعيدَ القَصدِ يُتعِبُهُ السُّرى",57,"ا",1,0],["أَجوبُ الفَلا سَهرانَ لا أَعرِف الكَرى","يُلازِمُني سُهْدي مِنَ الصّبحِ لِلصّبحِ",58,"ح",1,0],["أَجوَدُ النّاسِ في الدّنى شاعِرٌ وَهُم","حَيثُ جادوا بِالجَوهَرِ المَكنونِ",59,"ن",1,0],["أَجوَدُ النّاسِ مُنفِقٌ كلَّ شيءٍ","نَالَ حتّى الَّذي بِهِ يَتَجمَّل",60,"ل",1,1],["أَجُودُ بِرُوحِي وَهْوَ يَمْنَعُ وَصْلَةُ","تَرَجَّيْتُ مَنْ أَهْوى وَقُلْتُ لَعَلَّهُ",61,"ه",1,0],["أجوب رحيب الأرض والكون واسع","وأهرب من هذا الورى وأهيم",62,"م",1,0],["أجول بطرفي كي أرى ما وراءه","فيقصر طرفي عن مداه ويرتد",63,"د",1,0],["أجول بطرفى في العراق فلا أرى","من الناس الا مظهر البغض والشحنا",64,"ن",2,0],["أَجوعُ إِليها ثمّ أعطشُ والهوى","يُغالبُني كيما أجوعَ وأعطشا",65,"ش",2,0],["أَجوبُ المجهلات ضحىً وسحراً","تلوّحني بها هوج الدوارِ",66,"ر",1,0],["أجودُ وأَهوَى ولم تقضني","على ذاكَ إلّا صدوداً وبخلا",67,"ل",2,0],["أَجودُ لَها بالنفسِ منّي صبابةً","كَما جادَ للوفّاد بالمال حِميَرُ",68,"ر",1,0],["أَجْوَفَ عَنْ مَقْعَدِهِ وَالمُرْتَفَقْ","فَبَاتَ وَالنَفْسُ مِنَ الحِرصِ الفَشَق",69,"ق",1,0],["أجوف كالأنبوب في خلقهِ","يكاد من ليانه يُهصر",70,"ر",1,0],["أجوى بنفسك حالفت تَذكارهَها","وقذىً بعينك أبدتِ استعْبارَها",71,"ا",1,0],["أجودُ بنفسى فى هواك محبَّةً","وتبخَلُ ضَنًّا بالقليل من الوَصلِ",72,"ل",1,0],["أجوعُ وأظْما عِفّةً وتَكرُّماً","وقد ضَجَّ بي وادٍ وغَطْغَطَ مِرجلُ",73,"ل",1,0],["أجود بروحى في الغرام وانما","اذا جادلى يوم اللقا جاد بالضحك",74,"ك",1,0],["اجو الملة البيضاء فكانوا","عليها من مراوديها غيارى",75,"ر",2,0],["أجوَدُ الناس جودهُ","عمّ بدواً وحضرا",76,"ر",2,0],["أجودُ إذا نفسُ البخيل تطلّعت","وأصبر نفسي والجماجمُ تُضرَبُ",77,"ب",1,0],["أجوع مع الةجدان من أجلِ جائعٍ","مخافة أن أنساه والله سائلي",78,"ل",2,1],["أَجودُ بِمالي دونَ عِرضي وَمَن يُرِد","رَزِيَّةَ عِرضي يَعتَرِضُ دونَهُ بُخلي",79,"ل",2,0],["أجود وأعطي المنفسات تبَرُّعاً","وأُغلي بها عند اليسارة والعسر",80,"ر",1,0],["أجود بمالي ما حييت سماحةً","وأنت بخيلٌ يجتويك المصاحب",81,"ب",1,0],["أجودُ له بروحي حينَ يدنو","ويبخلُ بالتحيَّةِ والسلام",82,"م",1,0],["أَجواد يَوم السَبق قَد جزت المَدى","لا أَنتَ بِألواني وَلا بِالكابي",83,"ب",2,0],["أجُوبُ مهامِهَ الأشواقِ طُرّاً","وأضربُ باليمين وبالشِّمالِ",84,"ل",1,0],["أجوزف المفدى قر عيناً","بمن في وصلها نلت المراما",85,"م",2,1],["أَجود بعد حتى فَيَجود فضلا","بانعام فأرفل بالثرآء",86,"ا",2,0],["أجوَدَ مِن هذي القياسَاتِ يُرَى","إن عابَهَا في الناسِ شَخصٌ فَشَرا",87,"ر",2,0],["أَجودُ بِمَضنونِ التِلادِ وَإِنَّني","بِسِرِّكَ عَمَّن سالَني لَضَنينُ",88,"ن",1,1],["أجود بنفسي دون ديني سماحة","لأبلغ في العليا منال المجاهد",89,"د",1,0],["أجود بجل مالي لا أبالي","وأبخل عند مسئلة الكتاب",90,"ب",1,1],["اجوب نهاري فيك وهو هواجرٌ","واقطع ليلي فيك وهو بهيم