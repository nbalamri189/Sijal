انتقام لنفسي","https://www.poetsgate.com/ViewPoem.aspx?id=192991",""],[5956,"عالم الأطفالِ","https://www.poetsgate.com/ViewPoem.aspx?id=193155",""],[5956,"لماذا سُمِّي الصِّهرُ صهرا؟","https://www.poetsgate.com/ViewPoem.aspx?id=204009",""],[5957,"نصوغ الحزن ريحانا","https://www.poetsgate.com/ViewPoem.aspx?id=177066",""],[5957,"ما الذي يأخذني مني إليك","https://www.poetsgate.com/ViewPoem.aspx?id=208812",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""],[5976,"امزعزعين امضعضعين","https://www.poetsgate.com/ViewPoem.aspx?id=30537",""],[6089,"حمحمة القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=213029",""],[6093,"غناء عند أصَمٍّ ( الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=180657",""],[6183,"طير شارد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79844&r=&rc=34",""],[6189,"حاشية على الجرح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83547&r=&rc=14",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""],[463,"خدعُ الزمانِ مودة ٌ من ثائرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60052&r=&rc=108",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""],[6355,"هلال رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66597&r=&rc=57",""]],"verses":[["نَغتَرُّ بِالحِفظِ مِنهُ وَهوَ يَختُلُنا","كَما يَغُرُّ ذُبولُ الجَمرَةِ الصالي",0,"ل",2,0],["نُغالِبُ ثُمَّ تَغلِبُنا اللَيالي","وَكَم يَبقى الرَمِيُّ عَلى النِبالِ",1,"ل",1,1],["نَغَّرتُها وَالبَدرُ مُطَّلِعٌ","حَتّى اِستَجابَ لِقائِدِ الأُفلِ",2,"ل",1,0],["نُغَرُّ بِإيعادِ الرَدى وَهوَ صادِقٌ","وَنَطمَعُ في وَعدِ المُنى وَهوَ كاذِبُ",3,"ب",1,0],["نَغَرَت قِدرُ المَنايا","مِن أُوارٍ وَلَهيبِ",4,"ب",1,0],["نُغاديكَ داعينا السَلامُ كَعَهدِنا","فَما يُسمَعُ الداعي وَلا يُرفَعُ السِترُ",5,"ر",1,0],["نَغَمَاتُ شَدْوِكَ فِي المَسَا","مِعِ مِنْ أَغَارِيدِ الجَنَانِ",6,"ن",1,0],["نَغَماتُ الضَيفِ أَحلى عِندَنا","مِن ثُغاءِ الشاءِ أَو ذاتِ الرُغا",7,"ا",1,0],["نَغارُ إِذا ما الرَوعُ أَبدى عَلى البُرى","وَنَقري سَديفَ الشَحمِ وَالماءُ جامِسُ",8,"س",1,0],["نُغيرُ بِهِ طَوراً وَطَوراً نَضُمُّهُ","إِلى كُلِّ مَحبوكٍ مِنَ السَروِ أَيهَما",9,"م",2,0],["نُغيرُ في الهَجمَةِ الغَرّاءِ نَنحَرُها","حَتّى لَيَعطَشُ في الأَحيانِ راعينا",10,"ن",2,0],["نَغدو بِناجودٍ وَمُسمِعَةٍ لَنا","بَينَ الكُرومِ وَبَينَ جَزعِ القَسطَلِ",11,"ل",1,0],["نغمة تسحر القلوب وضربٌ","هو بين الترتيل والإِدراجِ",12,"ج",1,0],["نغْمتُها نغمةُ مزكومة","قد جمعتْ في أنفها مَخْطه",13,"ط",2,0],["نغدو بمدح فيه أيسرُ حقِّه","فنحوز كل تليده وطريفه",14,"ف",2,0],["نغدو وأبواب الملوك مجازَنا","وببابك التعريج والتخييمُ",15,"م",1,0],["نَغشى بِلادَ الناسِ في طَلَبِ العُلى","وَبِلادَنا مَتروكَةٌ لِلناسِ",16,"س",1,0],["نَغَصّتُمُ حينَ غِبتُم","عَلَيَّ عَيشاً خَصيبا",17,"ب",2,1],["نَغَمٌ يَصْعَدُ مِنْ قلبي","كأَنفاسِ الوُرودْ",18,"د",1,0],["نَغَمٌ يَسْتَبي المَشاعِرَ كالسِّحْرِ","وصَوْتٌ يُخِلُّ بالتَّلْحينِ",19,"ن",1,0],["نغماً كالحَيَاةِ عذباً عميقاً","في حَنَانٍ ورقَّةٍ وحنينِ",20,"ن",1,0],["نغمات اودعتها كل اشجا","نك تغلي فآذنت بانفجار",21,"ر",1,0],["نغمات فاضت على الجو حتى","ملأته كما يفيض الصباح",22,"ح",1,0],["نغمات لها الخلود فلا تذ","هب في هبات بهن الرياح",22,"ح",1,0],["نغم الطبيعة في مغانيهم وما","تملى الرياض وتنشئ الأزهار",23,"ر",1,0],["نَغَمٌ في السَماءِ وَالأَرضِ شَتّى","مِن مَعاني الرَبيعِ أَو أَلحانِهِ",24,"ن",2,0],["نَغبِطُ الطَيرَ وَما نَعلَمُ ما","هِيَ فيهِ مِن عَذابٍ بَئِسِ",25,"س",1,0],["نَغتابُهُ وَنَقولُ لا","بَقِيَ الرَقيبُ وَلا عُيونُهُ",26,"ن",2,0],["نَغْدو على سَيِّدٍ يُحصَى الحَصَى عَدَداً","في الخافِقَيْنِ ولا تُحصى فَواضِلُهُ",27,"ه",1,1],["نَغْفَلُ والأَيَامُ لا تَغْفَلُ","ولا لَنَا في زَمَنٍ مَوْئِلُ",28,"ل",1,1],["نَغَّصَ البُعدُ عَنكَ قُربَ العَطايا","مَرتَعي مُخصِبٌ وَجِسمي هَزيلُ",29,"ل",1,0],["نغدُو إليكَ إِذا اعترتْنَا حاجةٌ","ونصُدُّ عنكَ إِذا توسَّمْنَا الغِنَى",30,"ن",2,1],["نَغدو عَلى غايَةٍ في المَجدِ قاصِيَةِ ال","مَحَلِّ أَو مَثَلٍ في الجودِ مَضروبِ",31,"ب",1,0],["نَغشاهُ لا نَحنُ مُشتاقونَ مِنهُ إِلى","أُنسٍ وَلا هُوَ مَسرورٌ بِنا فَرِحُ",32,"ح",1,0],["نَغُضُّ لَهُ النَواظِرَ وَهوَ مَيتٌ","لِهَيبَتِهِ وَنُخفِضُ مِن عَويلِ",33,"ل",1,0],["نَغدو فَإِمّا اِستَعَرنا مِن مَحاسِنِهِ","فَضلاً وَإِمّا اِستَمَحنا مِن أَياديهِ",34,"ي",2,0],["نَغضَبُ لِلدُنيا وَنَرضى لَها","كَأَنَّنا لَم نَرَ أَفعالَها",35,"ل",3,0],["نَغَّصَ المَوتُ كُلَّ لَذَّةِ عَيشٍ","يا لِقَومي لِلمَوتِ ما أَوحاهُ",36,"ا",2,1],["نَغُضُّ وَنَعفو لِلغَرامِ إِذا جَنى","وَيَقسو عَلَينا حُكمُهُ فَنَلينُ",37,"ن",1,0],["نَغشى الخُطوبَ بِأَيدينا فَنَدفَعُها","وَإِن دَهَتنا دَفَعناها بِأَيدينا",38,"ن",2,0],["نُغِّصتُ حُسنَ النَرجِسِ الغَضِّ مُذ","بِنتَ فَطَرفي مِنهُ مُرتَدُّ",39,"د",1,0],["نُغْني الحَياةَ ونَسْتَغْني كأنَّ لنا","رَأْدَ الضُّحى غَلَّةً والصُّبْحَ والفَلَقا",40,"ق",2,0],["نغمات أرسلنَها ذات تسجي","ع وكرِّ في اللحن واسترسال",41,"ل",1,0],["نَغِلَت ضَمائِرُ صَدرِهِ مِن دائِهِ","نَغلَ الإِهابِ مُعَطَّلاً لَم يُدبَغِ",42,"غ",1,0],["نَغلِبُها أَوَّلاً وَتَغلِبُنا","فَنَحنُ فُرسانُها وَصَرعاها",43,"ا",3,0],["نُغاذى الدَرمَكَ المَنفوطَ عِزّاً","وَنَشرَبُ في اللُجَينِ وَفي النُظارِ",44,"ر",1,0],["نَغضَبُ لِلَّهِ وَلِل","إِسلامِ أَسرى الغَضَبِ",45,"ب",1,0],["نَغَّصَ طيبَ العَيشِ تَنصيبُ","وَفي المُلِمّاتِ الأَعاجيبُ",46,"ب",1,1],["نُغلي السِباءَ بِكُلِّ عا","تِقَةٍ شَمولٍ ما صَحَونا",47,"ن",2,0],["نغت فلما لم تجد آل معبدٍ","بأسفل أدعاص المروارة حنت",48,"ت",1,1],["نَغَاءِ عُرَى الإِسْلاَمِ والعَدْلِ بَعْدَه","نَعَاءِ لَقَدْ نَابَتْ عَلَى النَّاسِ نُوَّبُ",49,"ب",1,0],["نُغِيرُ عَلى الأَبْطَالِ والصُّبْحُ باسِمٌ","وَنَأْوِي إِلَى الأَدْغَالِ واللَّيْلُ جَانِحُ",50,"ح",1,0],["نَغَمَاتٌ تَزَوَّدَتْ كُلُّ نَفْسٍ","مِنْ صَدَاهَا لِلْعُمْرِ أَطْيَبَ زَادِ",51,"د",1,0],["نَغْمَ المَلاَئِكِ بَيْنَ","مَبْدُوءٍ وَبَيْنَ مُرَجِّعِ",52,"ع",1,0],["نُغَوِرُهُم تجري المنيّةُ بَيْنَنَا","نُشارِعُهُمْ حوضَ المَنَايا ونَشْرَعُ",53,"ع",1,0],["نغمٌ لو وعنهُ أذنُ الليالي","لتمَنّت أن تغتدي أسحارا",54,"ر",2,0],["نَغَماتُ داوودٍ قَرَأتَ بِها فَلَو","أَصغى إِلَيكَ لَأَسلَمَ القِسّيسُ",55,"س",1,0],["نَغَمُ الشعرِ في رُبا جَنَّاتِهْ","أسكت ابنَ الغُصونِ في دَوْحاتِهْ",56,"ت",2,1],["نَغَماتٌ لم يعهَدِ الروضُ مِثْلاً","لِصَدَاها بين الربا والظلال",57,"ل",1,0],["نَغَمَاتٌ مِنَ الْمَلائِكِ تَسْرِي","في الْفَرَادِيسِ مَا عَرَفْنَ حُدُودا",58,"د",2,0],["َن غائِبٌ في الحُبِّ لَم يَؤُبِ","لا شَيئاَ يَرقُبُهُ سِوى العَطَبِ",59,"ب",1,1],["نغفو بلا نوم ونصحو بلا","صحو فلا نرنو ولا نحلم",60,"م",1,0],["نغتذي شعر (الشحاري) تارةً","تارةً نحسو خطابات (الربادي)",61,"د",2,0],["نغتلي نبكي على من سقطوا","إنما نمضي لإتمام المجال",62,"ل",1,0],["نُغَاذَى الدَّرْمَكَ الْمَنْقُوطَ عِزًّا","ونشرب في اللجين وفي النظار",63,"ر",1,0],["نغض لمرآك الجفون وإنما","عيون الدراري في دجاك وقاح",64,"ح",1,0],["نغمات عودي لا تملّ لأنّها","شعر يفيض عواطفا وشعورا",65,"ر",2,1],["نغمات عودي لا تملّ لأنّها","لغو الملائك إذ تناجي الحورا",65,"ر",2,0],["نغماتُ عودي لا تملُّ لأنها","لغة الملائك إذ تُناجي الحورا",66,"ر",2,0],["نغم الخفاء تجاوبت أصداؤه","في موحش غمر الرّمال يباب",67,"ب",1,0],["نغدو وأبواب الملوك مخازناً","وببابك التعريج والتخييم",68,"م",1,0],["نَغَمات لِلعَندَليب تُنادي","هاجِعات الهَوى البدار البِدارا",69,"ر",2,0],["نُغْلِقُ بابَيْنِ فَتحناهما","للأمنِ بعد الخوفِ بعدَ الحَزَنْ؟",70,"ن",1,0],["نغضي إذا حيته آنسة","ويهش إن نظرت له شزرا",71,"ر",2,0],["نغفِرُ الصدَّ للحبيب ولانق","بلُ منه على التباعُد عُذرا",72,"ر",2,0],["نَغدُو وَنَروحُ وَمَذهَبُنا","شُربُ الصَهباءِ عَلى النَغَمِ",73,"م",1,0],["نُغازلُ مِن غُزلانِها كُل آنسٍ","وَنهصر مِن أَغصانِها كُلّ أَملَدَا",74,"د",2,0],["نُغازل من غِزْلانه كل سانحٍ","له مُقْلةٌ عاداتُها قَنَص الأُسْد",75,"د",1,0],["نَغَمُ الحُداةِ بكم وزَجْرُ السائقِ","أَوْهَتْ قُوَى جَلَد المُحبِّ الوامقِ",76,"ق",1,1],["نُغنَى بوجهك عن شمس وعن قمرٍ","ونارُ خديك تغنينا عن السُرجِ",77,"ج",1,0],["نغص اللَهُ حاسداً نغص العي","شَ وقد طال للحبيب المَبيتُ",78,"ت",1,0],["نَغْتَنِمُ بُرْهَةً صَفَاءَ لَيَالٍ","عَنْ قَرِيبٍ نَمْضِي إِلَى غَفَّارِ",79,"ر",1,0],["نِغاءُ الحِسانِ المُرشِقاتِ كَأَنَّها","جَآذِرُ مِن بَينِ الخُدورُ تَطَلَّعُ",80,"ع",1,0],["نغاضب بالهجران منكم فنحلم"