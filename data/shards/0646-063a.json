{"poems":[[53,"ما بعد يومك ما يسلو به السالي","https://www.aldiwan.net/poem29885.html","البسيط"],[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[53,"من لي برعبلة من البزل","https://www.aldiwan.net/poem29900.html","الكامل"],[53,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[93,"يا أم كلثوم بفنك","https://www.aldiwan.net/poem11168.html","مجزوء الكامل"],[54,"عللاني بسماع وطلا","https://www.aldiwan.net/poem27664.html","الرمل"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[4,"عفا الرسم أم لا بعد حول تجرما","https://www.aldiwan.net/poem21202.html","الطويل"],[47,"إذا مررت بواد جاش غاربه","https://www.aldiwan.net/poem25129.html","البسيط"],[23,"أسألت رسم الدار أم لم تسأل","https://www.aldiwan.net/poem21245.html","الكامل"],[51,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[51,"يا ذا الذي كنيته كنيتي","https://www.aldiwan.net/poem64998.html","السريع"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[70,"نغصتم حين غبتم","https://www.aldiwan.net/poem43027.html","المجتث"],[92,"أقبل الصبح يغني","https://www.aldiwan.net/poem38893.html","مجزوء الرمل"],[92,"إن هذي الحياة قيثارة الله","https://www.aldiwan.net/poem38898.html","الخفيف"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[89,"هزنا الفن في كمنجة سامي","https://www.aldiwan.net/poem44773.html","الخفيف"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"يا ناعما رقدت جفونه","https://www.aldiwan.net/poem63004.html","مجزوء الكامل"],[56,"نغدو على سيد يحصى الحصى عددا","https://www.aldiwan.net/poem58535.html","البسيط"],[56,"نغفل والأيام لا تغفل","https://www.aldiwan.net/poem58538.html","السريع"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[62,"نغدو إليك إذا اعترتنا حاجة","https://www.aldiwan.net/poem52254.html","الكامل"],[45,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[45,"لك الخلائق فينا السهلة السمح","https://www.aldiwan.net/poem62686.html","البسيط"],[45,"محا نور النواظر والعقول","https://www.aldiwan.net/poem65643.html","الوافر"],[45,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[49,"ما أحسن الدنيا وإقبالها","https://www.aldiwan.net/poem63099.html","السريع"],[49,"نغص الموت كل لذة عيش","https://www.aldiwan.net/poem63184.html","البسيط"],[66,"نعم لقلوب العاشقين عيون","https://www.aldiwan.net/poem38477.html","الطويل"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[44,"آنسني من بعدك الوجد","https://www.aldiwan.net/poem30262.html","السريع"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[52,"قطعته يوما وليس يطيعه","https://www.aldiwan.net/poem26842.html","الكامل"],[48,"يا ليلة بتها أسقاها","https://www.aldiwan.net/poem66170.html","البسيط"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[50,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[50,"نغص طيب العيش تنصيب","https://www.aldiwan.net/poem64819.html","السريع"],[15,"يا ذا المخوفنا بقت","https://www.aldiwan.net/poem45242.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54994","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[48,"َن غائِبٌ في الحُبِّ لَم يَؤُبِ","https://www.poetsgate.com/ViewPoem.aspx?id=10433",""],[100,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[50,"أعاذل لا أنام على اقتسار","https://www.poetsgate.com/ViewPoem.aspx?id=22668",""],[90,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[94,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[51,"لأموركَ التكميلُ والتتميمُ","https://www.poetsgate.com/ViewPoem.aspx?id=30409",""],[107,"كوكب السعد بالنجاح أنارا","https://www.aldiwan.net/poem16288.html","الخفيف"],[115,"من ظن ظن","https://www.aldiwan.net/poem24058.html","السريع"],[122,"بين الأَنين وغصة الذكرى","https://www.aldiwan.net/poem23714.html","الكامل"],[140,"لست أقضى إذا رأيتك نذرا","https://www.aldiwan.net/poem58427.html","الخفيف"],[167,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[180,"رعى الله مغنى بالعذيب ومعهدا","https://www.aldiwan.net/poem67081.html","الطويل"],[183,"أأحبابنا بالثغر ما كان من بعدي","https://www.aldiwan.net/poem14497.html","الطويل"],[183,"نغم الحداة بكم وزجر السائق","https://www.aldiwan.net/poem14610.html","الكامل"],[202,"انظر إلى غنج هذا الفاتن الغنج","https://www.aldiwan.net/poem53348.html","البسيط"],[202,"كم تنعمت في الهوى وشقيت","https://www.aldiwan.net/poem53351.html","الخفيف"],[235,"عللاني بمطرب الأشعار","https://www.aldiwan.net/poem18802.html","الخفيف"],[247,"أصوت مناد من رميلة تسمع","https://www.aldiwan.net/poem2109.html","الطويل"],[259,"نغاضب بالهجران منكم فنحلم","https://www.aldiwan.net/poem38192.html","الطويل"],[268,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[296,"سامح الله الحمامه","https://www.aldiwan.net/poem36251.html","عموديه"],[303,"نغمات الهنا بمثنى وزير","https://www.aldiwan.net/poem56543.html","الخفيف"],[318,"لا تعجبن لآل بيت جودهم","https://www.aldiwan.net/poem61715.html","الكامل"],[320,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[340,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[374,"سهر صالح ينير العقولا","https://www.aldiwan.net/poem59171.html","الخفيف"],[399,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[400,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[406,"هو الجواد الذي يلقاه مادحه","https://www.aldiwan.net/poem32215.html","البسيط"],[413,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[426,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[434,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[436,"أضاء لها فجر النهى فنهاها","https://www.aldiwan.net/poem34917.html","الطويل"],[438,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[450,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[450,"قد لوى جيده حياء وحيا","https://www.aldiwan.net/poem13812.html","الخفيف"],[450,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"],[456,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[456,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[456,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[459,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[459,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[480,"فاح عرف المسك من عرف الخزام","https://www.aldiwan.net/poem24551.html","عموديه"],[512,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[558,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[560,"نفارقكم ونضرب في البلاد","https://www.aldiwan.net/poem52988.html","الوافر"]],"verses":[["نَغتَرُّ بِالحِفظِ مِنهُ وَهوَ يَختُلُنا","كَما يَغُرُّ ذُبولُ الجَمرَةِ الصالي",0,"ي",1,0],["نُغالِبُ ثُمَّ تَغلِبُنا اللَيالي","وَكَم يَبقى الرَمِيُّ عَلى النِبالِ",1,"ل",1,1],["نَغَّرتُها وَالبَدرُ مُطَّلِعٌ","حَتّى اِستَجابَ لِقائِدِ الأُفلِ",2,"ل",1,0],["نُغَرُّ بِإيعادِ الرَدى وَهوَ صادِقٌ","وَنَطمَعُ في وَعدِ المُنى وَهوَ كاذِبُ",3,"ب",1,0],["نَغَرَت قِدرُ المَنايا","مِن أُوارٍ وَلَهيبِ",4,"ب",1,0],["نُغاديكَ داعينا السَلامُ كَعَهدِنا","فَما يُسمَعُ الداعي وَلا يُرفَعُ السِترُ",5,"ر",1,0],["نَغَمَاتُ شَدْوِكَ فِي المَسَا","مِعِ مِنْ أَغَارِيدِ الجَنَانِ",6,"ن",1,0],["نَغَماتُ الضَيفِ أَحلى عِندَنا","مِن ثُغاءِ الشاءِ أَو ذاتِ الرُغا",7,"ا",1,0],["نَغارُ إِذا ما الرَوعُ أَبدى عَلى البُرى","وَنَقري سَديفَ الشَحمِ وَالماءُ جامِسُ",8,"س",1,0],["نُغيرُ بِهِ طَوراً وَطَوراً نَضُمُّهُ","إِلى كُلِّ مَحبوكٍ مِنَ السَروِ أَيهَما",9,"م",2,0],["نُغيرُ في الهَجمَةِ الغَرّاءِ نَنحَرُها","حَتّى لَيَعطَشُ في الأَحيانِ راعينا",10,"ن",2,0],["نَغدو بِناجودٍ وَمُسمِعَةٍ لَنا","بَينَ الكُرومِ وَبَينَ جَزعِ القَسطَلِ",11,"ل",1,0],["نغمة تسحر القلوب وضربٌ","هو بين الترتيل والإِدراجِ",12,"ج",1,0],["نغْمتُها نغمةُ مزكومة","قد جمعتْ في أنفها مَخْطه",13,"ط",2,0],["نغدو بمدح فيه أيسرُ حقِّه","فنحوز كل تليده وطريفه",14,"ف",2,0],["نغدو وأبواب الملوك مجازَنا","وببابك التعريج والتخييمُ",15,"م",1,0],["نَغشى بِلادَ الناسِ في طَلَبِ العُلى","وَبِلادَنا مَتروكَةٌ لِلناسِ",16,"س",1,0],["نَغَصّتُمُ حينَ غِبتُم","عَلَيَّ عَيشاً خَصيبا",17,"ب",2,1],["نَغَمٌ يَصْعَدُ مِنْ قلبي","كأَنفاسِ الوُرودْ",18,"د",1,0],["نَغَمٌ يَسْتَبي المَشاعِرَ كالسِّحْرِ","وصَوْتٌ يُخِلُّ بالتَّلْحينِ",19,"ن",1,0],["نغماً كالحَيَاةِ عذباً عميقاً","في حَنَانٍ ورقَّةٍ وحنينِ",20,"ن",1,0],["نغمات اودعتها كل اشجا","نك تغلي فآذنت بانفجار",21,"ر",1,0],["نغمات فاضت على الجو حتى","ملأته كما يفيض الصباح",22,"ح",1,0],["نغمات لها الخلود فلا تذ","هب في هبات بهن الرياح",22,"ح",1,0],["نغم الطبيعة في مغانيهم وما","تملى الرياض وتنشئ الأزهار",23,"ر",1,0],["نَغَمٌ في السَماءِ وَالأَرضِ شَتّى","مِن مَعاني الرَبيعِ أَو أَلحانِهِ",24,"ن",2,0],["نَغبِطُ الطَيرَ وَما نَعلَمُ ما","هِيَ فيهِ مِن عَذابٍ بَئِسِ",25,"س",1,0],["نَغتابُهُ وَنَقولُ لا","بَقِيَ الرَقيبُ وَلا عُيونُهُ",26,"ن",2,0],["نَغْدو على سَيِّدٍ يُحصَى الحَصَى عَدَداً","في الخافِقَيْنِ ولا تُحصى فَواضِلُهُ",27,"ه",1,1],["نَغْفَلُ والأَيَامُ لا تَغْفَلُ","ولا لَنَا في زَمَنٍ مَوْئِلُ",28,"ل",1,1],["نَغَّصَ البُعدُ عَنكَ قُربَ العَطايا","مَرتَعي مُخصِبٌ وَجِسمي هَزيلُ",29,"ل",1,0],["نغدُو إليكَ إِذا اعترتْنَا حاجةٌ","ونصُدُّ عنكَ إِذا توسَّمْنَا الغِنَى",30,"ن",2,1],["نَغدو عَلى غايَةٍ في المَجدِ قاصِيَةِ ال","مَحَلِّ أَو مَثَلٍ في الجودِ مَضروبِ",31,"ب",1,0],["نَغشاهُ لا نَحنُ مُشتاقونَ مِنهُ إِلى","أُنسٍ وَلا هُوَ مَسرورٌ بِنا فَرِحُ",32,"ح",1,0],["نَغُضُّ لَهُ النَواظِرَ وَهوَ مَيتٌ","لِهَيبَتِهِ وَنُخفِضُ مِن عَويلِ",33,"ل",1,0],["نَغدو فَإِمّا اِستَعَرنا مِن مَحاسِنِهِ","فَضلاً وَإِمّا اِستَمَحنا مِن أَياديهِ",34,"ي",2,0],["نَغضَبُ لِلدُنيا وَنَرضى لَها","كَأَنَّنا لَم نَرَ أَفعالَها",35,"ل",3,0],["نَغَّصَ المَوتُ كُلَّ لَذَّةِ عَيشٍ","يا لِقَومي لِلمَوتِ ما أَوحاهُ",36,"ا",2,1],["نَغُضُّ وَنَعفو لِلغَرامِ إِذا جَنى","وَيَقسو عَلَينا حُكمُهُ فَنَلينُ",37,"ن",1,0],["نَغشى الخُطوبَ بِأَيدينا فَنَدفَعُها","وَإِن دَهَتنا دَفَعناها بِأَيدينا",38,"ن",2,0],["نُغِّصتُ حُسنَ النَرجِسِ الغَضِّ مُذ","بِنتَ فَطَرفي مِنهُ مُرتَدُّ",39,"د",1,0],["نُغْني الحَياةَ ونَسْتَغْني كأنَّ لنا","رَأْدَ الضُّحى غَلَّةً والصُّبْحَ والفَلَقا",40,"ق",2,0],["نغمات أرسلنَها ذات تسجي","ع وكرِّ في اللحن واسترسال",41,"ل",1,0],["نَغِلَت ضَمائِرُ صَدرِهِ مِن دائِهِ","نَغلَ الإِهابِ مُعَطَّلاً لَم يُدبَغِ",42,"غ",1,0],["نَغلِبُها أَوَّلاً وَتَغلِبُنا","فَنَحنُ فُرسانُها وَصَرعاها",43,"ا",3,0],["نُغاذى الدَرمَكَ المَنفوطَ عِزّاً","وَنَشرَبُ في اللُجَينِ وَفي النُظارِ",44,"ر",1,0],["نَغضَبُ لِلَّهِ وَلِل","إِسلامِ أَسرى الغَضَبِ",45,"ب",1,0],["نَغَّصَ طيبَ العَيشِ تَنصيبُ","وَفي المُلِمّاتِ الأَعاجيبُ",46,"ب",1,1],["نُغلي السِباءَ بِكُلِّ عا","تِقَةٍ شَمولٍ ما صَحَونا",47,"ن",2,0],["نُغِيرُ عَلى الأَبْطَالِ والصُّبْحُ باسِمٌ","وَنَأْوِي إِلَى الأَدْغَالِ واللَّيْلُ جَانِحُ",48,"ح",1,0],["نَغَمَاتٌ تَزَوَّدَتْ كُلُّ نَفْسٍ","مِنْ صَدَاهَا لِلْعُمْرِ أَطْيَبَ زَادِ",49,"د",1,0],["نَغْمَ المَلاَئِكِ بَيْنَ","مَبْدُوءٍ وَبَيْنَ مُرَجِّعِ",50,"ع",1,0],["نُغَوِرُهُم تجري المنيّةُ بَيْنَنَا","نُشارِعُهُمْ حوضَ المَنَايا ونَشْرَعُ",51,"ع",1,0],["نغمٌ لو وعنهُ أذنُ الليالي","لتمَنّت أن تغتدي أسحارا",52,"ر",2,0],["نَغَماتُ داوودٍ قَرَأتَ بِها فَلَو","أَصغى إِلَيكَ لَأَسلَمَ القِسّيسُ",53,"س",1,0],["نَغَمُ الشعرِ في رُبا جَنَّاتِهْ","أسكت ابنَ الغُصونِ في دَوْحاتِهْ",54,"ت",2,1],["نَغَماتٌ لم يعهَدِ الروضُ مِثْلاً","لِصَدَاها بين الربا والظلال",55,"ل",1,0],["نَغَمَاتٌ مِنَ الْمَلائِكِ تَسْرِي","في الْفَرَادِيسِ مَا عَرَفْنَ حُدُودا",56,"د",2,0],["َن غائِبٌ في الحُبِّ لَم يَؤُبِ","لا شَيئاَ يَرقُبُهُ سِوى العَطَبِ",57,"ب",1,1],["نغتذي شعر (الشحاري) تارةً","تارةً نحسو خطابات (الربادي)",58,"د",2,0],["نُغَاذَى الدَّرْمَكَ الْمَنْقُوطَ عِزًّا","ونشرب في اللجين وفي النظار",59,"ر",1,0],["نغض لمرآك الجفون وإنما","عيون الدراري في دجاك وقاح",60,"ح",1,0],["نغمات عودي لا تملّ لأنّها","شعر يفيض عواطفا وشعورا",61,"ر",2,1],["نغمات عودي لا تملّ لأنّها","لغو الملائك إذ تناجي الحورا",61,"ر",2,0],["نغماتُ عودي لا تملُّ لأنها","لغة الملائك إذ تُناجي الحورا",62,"ر",2,0],["نغدو وأبواب الملوك مخازناً","وببابك التعريج والتخييم",63,"م",1,0],["نَغَمات لِلعَندَليب تُنادي","هاجِعات الهَوى البدار البِدارا",64,"ر",2,0],["نُغْلِقُ بابَيْنِ فَتحناهما","للأمنِ بعد الخوفِ بعدَ الحَزَنْ؟",65,"ن",1,0],["نغضي إذا حيته آنسة","ويهش إن نظرت له شزرا",66,"ر",2,0],["نغفِرُ الصدَّ للحبيب ولانق","بلُ منه على التباعُد عُذرا",67,"ر",2,0],["نَغدُو وَنَروحُ وَمَذهَبُنا","شُربُ الصَهباءِ عَلى النَغَمِ",68,"م",1,0],["نُغازلُ مِن غُزلانِها كُل آنسٍ","وَنهصر مِن أَغصانِها كُلّ أَملَدَا",69,"د",2,0],["نُغازل من غِزْلانه كل سانحٍ","له مُقْلةٌ عاداتُها قَنَص الأُسْد",70,"د",1,0],["نَغَمُ الحُداةِ بكم وزَجْرُ السائقِ","أَوْهَتْ قُوَى جَلَد المُحبِّ الوامقِ",71,"ق",1,1],["نُغنَى بوجهك عن شمس وعن قمرٍ","ونارُ خديك تغنينا عن السُرجِ",72,"ج",1,0],["نغص اللَهُ حاسداً نغص العي","شَ وقد طال للحبيب المَبيتُ",73,"ت",1,0],["نَغْتَنِمُ بُرْهَةً صَفَاءَ لَيَالٍ","عَنْ قَرِيبٍ نَمْضِي إِلَى غَفَّارِ",74,"ر",1,0],["نِغاءُ الحِسانِ المُرشِقاتِ كَأَنَّها","جَآذِرُ مِن بَينِ الخُدورُ تَطَلَّعُ",75,"ع",1,0],["نغاضب بالهجران منكم فنحلم","ويعذب طعم الحب والحب علقم",76,"م",1,1],["نغرِّدُ ما نغرِّدُ بالقَوافي","لنُطرِبَ نُخبةَ المتمدّنينا",77,"ن",2,0],["نغمةٌ علويَّةٌ","للرّوحِ راحٌ ومدامه",78,"م",2,0],["نَغَمات الهَنا بمثنى وزير","أَطرَبتنا بأوبِ نجل الوزيرِ",79,"ر",1,1],["نَغمُ الحَنينِ بِغَيرِ ذِكرِ جَوادِ","فَاِعجَب لِمَولودٍ يُمَهِّدُ عِزَّهُ",80,"ه",1,0],["نُغَدّي الضَعيفَ مِن قَمَعِ المَتالي","سَديفاً مُشبِعاً مِنهُ يُعَشّي",81,"ي",1,0],["نغماتها الالهام قد صاغها","وصانها بالروح والانمل",82,"ل",1,0],["نغماتٍ يقال أبرَت عليلاً","وصلاةٌ يقال أحيت قتيلا",83,"ل",2,0],["نغَّصْتَ في هذه الدّنيا معيشتَهُمْ","ومُستقرّهُمِ مِن بَعْدِها سَقَرُ",84,"ر",1,0],["نغم الأوتار من منطقها","فإذا ما شئت لحناً أعربا",85,"ب",2,0],["نَغْشى مواردَ من أخلاقِه كَرُمتْ","وِرداً ونرتادُ منها روضةً أُنُفَا",86,"ف",2,0],["نغمُ العودِ وشعر الأخرس","ومحبٌ مستهامٌ وحبيب",87,"ب",1,0],["نغم الأطيار على القضب","يدعو المشتاق إلى الطرب",88,"ب",1,1],["نغدوت مثل الدهر يأتي ال","يغظان أو يسري مع الأ",89,"ل",2,0],["نغاوِرُ قَفْرَها والليلُ داجٍ","ونعسِفُ بَحْرَها والموجُ طامِ",90,"م",1,0],["نُغِيثُ بقايا من نفوسٍ كَأَنَّهَا","بقايا نجوم القَذْفِ غارَ سَنَاها",91,"ا",3,0],["نغادرها على رغم الأنوف","نداولها الكتوف إلى الكتوف",92,"ف",1,0],["نَغْدوا فَنهْصُرُ للتآلف بيننا","غُصْناً تَورّد بالصفا وأثمرا",93,"ر",2,0],["نُغْنُغٌ في نَصَاعَةِ الزَّهْرِ مَرْآ","ه لِعَيْني وكالحريرةِ مَسَّا",94,"س",2,0],["نَغُضُّ متى شاءَ النُهى من عِنانها","بكفِّ أناة ذاتِ زَنْدٍ ومرفَقِ",95,"ق",1,0],["نَغِلا أُلفِّقُه كأنَّ يدي","رقَعتْ على أخلاقه شَنَّا",96,"ن",2,0],["نغَّصَ عندي العُرف أني أرى","طولَ يد المعطي على القابلِ",97,"ل",1,0],["نغالطُ ألحاظَ المها عن قلوبنا","وبالرمل قارىُّ السهامِ مُصيبُ",98,"ب",1,0],["نغَضتْ شمائله الحقودُ فهمَّ أن","يزري بإيجافِ الجوادِ الشَّيظم",99,"م",1,0],["نَغض العطف إذ نَطقتَ قريضٌ","مُسْكرٌ دونهُ حُميَّا الشَّرابِ",100,"ب",1,0],["نغمة القمري شاد في الربى","فهما منها على الدوم مثار",101,"ر",1,0],["نَغشى النِصال من الأجْفانِ إن برزَتْ","ونَختَشيها إذا اِنسلّت من المُقَلِ",102,"ل",1,0],["نغفو على أنْداءِ ذاكرةٍ","فيَرِفُّ فوق رؤوسنا الفرْح",103,"ح",1,0],["نَغيبُ وَلا تَغيبُ الدَّارُ عَنَّا","فَتُوهِمُنا التَقَرُّبَ في البِعادِ",104,"د",1,0]]}