{"poems":[[86,"يا مليكاً برغمه يلبس التا","https://www.aldiwan.net/poem10360.html","الخفيف"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[83,"أنا تاج كهلال","https://www.aldiwan.net/poem54252.html","مجزوء الرمل"],[27,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[27,"أمست طهية كالبكار أفزها","https://www.aldiwan.net/poem5958.html","الكامل"],[91,"يا نفس قد ذهب الرفيق الألمعي","https://www.aldiwan.net/poem8979.html","عموديه"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[43,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[62,"أنات وذكرانها صنوها","https://www.aldiwan.net/poem52217.html","المتقارب"],[45,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[69,"يا رب بالهادي النبي المجتبى","https://www.aldiwan.net/poem28577.html","الرجز"],[69,"إن اتخذتم بدلا","https://www.aldiwan.net/poem28962.html","مجزوء الرجز"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[31,"طال ليلي وتعناني الطرب","https://www.aldiwan.net/poem42651.html","الرمل"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"سقيا لغير العلياء والسند","https://www.aldiwan.net/poem62548.html","المنسرح"],[50,"أذكرت نفسي عشية الأحد","https://www.aldiwan.net/poem63909.html","المنسرح"],[46,"ربيت شبلا فلما إن غدا أسدا","https://www.aldiwan.net/poem23106.html","البسيط"],[40,"","https://poetry.dctabudhabi.ae/diwan/poem/93167","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85346","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54586","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""]],"verses":[["إِن أَتَمَّت يَداكَ تَخريبَ مِصرٍ","فَلَقَد مَهَّدَ الخَرابَ أَبوكا",0,"ك",2,0],["أَنا تاجُ العَلاءِ في مَفرِقِ الشَر","قِ وَدُرّاتُهُ فَرائِدُ عِقدي",1,"ي",1,0],["إِنَّ اتِّحَادَ قُوَاكُمْ بَعْدَهُ عِوَضٌ","مِمَنْ دَهَى مِصْر فِيهِ الثُّكْلُ وَاليَتَمُ",2,"م",1,0],["أنا تاج كهلال","أنا كرسيُّ جمالِ",3,"ل",1,1],["إِنّا تُفَضَّلُ في الحَياةِ حَياتُنا","وَنَسودُ مَن دَخَلَ القُبورَ قُبورا",4,"ر",2,0],["إِنّا تَزيدُ عَلى الحُلومِ حُلومُنا","فَضلاً وَنَجهَلُ فَوقَ جَهلِ الجاهِلِ",5,"ل",1,0],["إِنّا تَساوَينا فَبَينَ ضُلوعِكُم","نارٌ وَمِثلُ سَعيرِها في أَضلُعي",6,"ع",2,0],["إِنّا تَمَنَّينا عَلى اللَهِ المُنى","وَاللَهُ كانَ بِنَيلِهِنَّ كَفيلا",7,"ل",2,0],["أَنا تِربُ النَدى وَرَبُّ القَوافي","وَسِمامُ العِدا وَغَيظُ الحَسودِ",8,"د",1,0],["أنات وذكرانها صنوها","ونجلُهما منهما أكرمُ",9,"م",1,1],["إِن أُتبِعِ الشَوقَ إِزراءً عَلَيهِ فَقَد","جافى مِنَ النَومِ عَن عَينَيَّ ما جافى",10,"ف",2,0],["إِنّ أَتراحَ النَوى يعقُبُها","بِجَزيلِ الحَظِّ أفراحُ الإياب",11,"ب",1,0],["إنّا تشفَّعْنا إليكَ بأحمدٍ","أعلى الورى قدراً وأرفعَ منصبا",12,"ب",2,0],["إنِ اتخذتم بدلاً","مِنِّي فلا تأسُّفا",13,"ف",2,1],["أنا تلميذُ بيتكمُ قديماً","بكمْ فخري إذا افتخرَ الأنامُ",14,"م",1,0],["أَن أَتى مِنها رَسولٌ مَوهِناً","وَجَدَ الحَيَّ نِياماً فَاِنقَلَب",15,"ب",1,0],["إنّا تأمّلنا الأُمورَ فلم نَجِد","حُريةً هِبَةً ولا استقلالا",16,"ل",2,0],["آناً تُباعُ وَتَارَةً هِيَ خِدعَةً","تَمْنَى بِشَرِّ سُعاتِها الأُمَراءُ",17,"ا",2,0],["آناً تَرُدُّ عنِ الفَرِيسةِ نَابَها","تَبغِي مَقاتِلَها وآناً تَنْشَبُ",18,"ب",1,0],["إنْ آتِ ذَنْباً فما عَهْدِي بِمُنْتَقِضٍ","مِنَ النبيِّ وَلا حَبْلِي بِمُنْصَرِمِ",19,"م",1,0],["إِن أَتَحَرَّز مِنَ الغُرابِ بِها","يَكُن مَفَرّي مِنهُ إِلى الصُرَدِ",20,"د",1,0],["إِن أَترُكِ القَصدَ مِن تَذَكُّرِها","يَوماً فَما حُبُّها بِمُقتَصَدِ",21,"د",1,0],["إِن اِتَّكَلتَ عَلى مَن لا يَضيعُ لَهُ","خَلقٌ فَإِنَّ قَضاءَ اللَهِ ما وَكَّلَك",22,"ك",1,0],["أَن أَتاها مُحَرِّشٌ بِحَدِيثٍ","كاذِباً ما أَرادَ إِلّا رَداها",23,"ا",3,0],["إن أَتتني سعادتي بعد مَوتي","فَشقاء الحَياة لَيسَ يضير",24,"ر",1,0],["إن أتى الهوان فَلا","كان ذلك اللقب",25,"ب",1,0],["إن أتاها فليس فيها بباد","أو جناها فذا الورى شركاء",26,"ا",2,0],["إِنِ اتَّفَقْتُمْ أَوِ اخْتَلَفْتُمْ","لِلْخَيْرِ سَهْمٌ فِي كُلِّ مَذْهَبْ",27,"ب",1,0],["إِنَّ أَترابَهُ اِهتَدوا بِهُداهُ","فَتَحَلَّت أَخلاقُهُم تَهذيبا",28,"ب",2,0],["أنَّاتُ مَجْرُوحٍ يُعالِجُ سَهْمَهُ","وزَفِيرُ مَأسُورٍ بِغَيرِ فَكاكِ",29,"ك",1,0],["إنا تركنا الخصْم يضحك أَوَّلاً","ليزيد نَوْحَا حين نَضْحَكُ آخرا",30,"ر",2,0]]}