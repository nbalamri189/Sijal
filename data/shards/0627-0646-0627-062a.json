{"poems":[[86,"يا مليكاً برغمه يلبس التا","https://www.aldiwan.net/poem10360.html","الخفيف"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[83,"أنا تاج كهلال","https://www.aldiwan.net/poem54252.html","مجزوء الرمل"],[27,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[27,"أمست طهية كالبكار أفزها","https://www.aldiwan.net/poem5958.html","الكامل"],[91,"يا نفس قد ذهب الرفيق الألمعي","https://www.aldiwan.net/poem8979.html","عموديه"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[43,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[62,"أنات وذكرانها صنوها","https://www.aldiwan.net/poem52217.html","المتقارب"],[45,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[69,"يا رب بالهادي النبي المجتبى","https://www.aldiwan.net/poem28577.html","الرجز"],[69,"إن اتخذتم بدلا","https://www.aldiwan.net/poem28962.html","مجزوء الرجز"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[31,"طال ليلي وتعناني الطرب","https://www.aldiwan.net/poem42651.html","الرمل"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"سقيا لغير العلياء والسند","https://www.aldiwan.net/poem62548.html","المنسرح"],[50,"أذكرت نفسي عشية الأحد","https://www.aldiwan.net/poem63909.html","المنسرح"],[46,"ربيت شبلا فلما إن غدا أسدا","https://www.aldiwan.net/poem23106.html","البسيط"],[40,"","https://poetry.dctabudhabi.ae/diwan/poem/93167","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85346","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54586","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[129,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[133,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[136,"لقد تبدى كغصن البان في الميل","https://www.aldiwan.net/poem47410.html","البسيط"],[144,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[161,"ما خاب من في الله كان رجاه","https://www.aldiwan.net/poem59130.html","الكامل"],[170,"أميم لا تنكري حلي ومرتحلي","https://www.aldiwan.net/poem1651.html",""],[198,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[224,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[238,"عين الوزارة ذا المقام السامك","https://www.aldiwan.net/poem18849.html","الكامل"],[306,"يا لائما مل سمعي من مواعظه","https://www.aldiwan.net/poem56487.html","البسيط"],[329,"ألا إن سكرى سكر عبد له كأس","https://www.aldiwan.net/poem54940.html","الطويل"],[343,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[343,"نقالة الموتى وما نقلت","https://www.aldiwan.net/poem55347.html","أحذ الكامل"],[349,"أنا تبر فوق خصر","https://www.aldiwan.net/poem20748.html","مجزوء الرمل"],[403,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[410,"أنا تاج فرسان الهياج ومن بهم","https://www.aldiwan.net/poem32190.html","الكامل"],[442,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[442,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[442,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[442,"أستغفر الله العظيم","https://www.aldiwan.net/poem14398.html","مجزوء الكامل"],[450,"إلى ربيع العمر","https://www.aldiwan.net/poem1006.html",""],[459,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[466,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[469,"كم بحر حرب نقعه آذيه","https://www.aldiwan.net/poem59654.html","الكامل"],[469,"الماء بين مجوشن ومدرع","https://www.aldiwan.net/poem59892.html","الكامل"],[478,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[501,"أقلق الحاسد مني","https://www.aldiwan.net/poem38095.html","مجزوء الرمل"],[515,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[552,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[576,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"]],"verses":[["إِن أَتَمَّت يَداكَ تَخريبَ مِصرٍ","فَلَقَد مَهَّدَ الخَرابَ أَبوكا",0,"ك",2,0],["أَنا تاجُ العَلاءِ في مَفرِقِ الشَر","قِ وَدُرّاتُهُ فَرائِدُ عِقدي",1,"د",2,0],["إِنَّ اتِّحَادَ قُوَاكُمْ بَعْدَهُ عِوَضٌ","مِمَنْ دَهَى مِصْر فِيهِ الثُّكْلُ وَاليَتَمُ",2,"م",1,0],["أنا تاج كهلال","أنا كرسيُّ جمالِ",3,"ل",1,1],["إِنّا تُفَضَّلُ في الحَياةِ حَياتُنا","وَنَسودُ مَن دَخَلَ القُبورَ قُبورا",4,"ر",2,0],["إِنّا تَزيدُ عَلى الحُلومِ حُلومُنا","فَضلاً وَنَجهَلُ فَوقَ جَهلِ الجاهِلِ",5,"ل",1,0],["إِنّا تَساوَينا فَبَينَ ضُلوعِكُم","نارٌ وَمِثلُ سَعيرِها في أَضلُعي",6,"ع",2,0],["إِنّا تَمَنَّينا عَلى اللَهِ المُنى","وَاللَهُ كانَ بِنَيلِهِنَّ كَفيلا",7,"ل",2,0],["أَنا تِربُ النَدى وَرَبُّ القَوافي","وَسِمامُ العِدا وَغَيظُ الحَسودِ",8,"د",1,0],["أنات وذكرانها صنوها","ونجلُهما منهما أكرمُ",9,"م",1,1],["إِن أُتبِعِ الشَوقَ إِزراءً عَلَيهِ فَقَد","جافى مِنَ النَومِ عَن عَينَيَّ ما جافى",10,"ف",2,0],["إِنّ أَتراحَ النَوى يعقُبُها","بِجَزيلِ الحَظِّ أفراحُ الإياب",11,"ب",1,0],["إنّا تشفَّعْنا إليكَ بأحمدٍ","أعلى الورى قدراً وأرفعَ منصبا",12,"ب",2,0],["إنِ اتخذتم بدلاً","مِنِّي فلا تأسُّفا",13,"ف",2,1],["أنا تلميذُ بيتكمُ قديماً","بكمْ فخري إذا افتخرَ الأنامُ",14,"م",1,0],["أَن أَتى مِنها رَسولٌ مَوهِناً","وَجَدَ الحَيَّ نِياماً فَاِنقَلَب",15,"ب",1,0],["إنّا تأمّلنا الأُمورَ فلم نَجِد","حُريةً هِبَةً ولا استقلالا",16,"ل",2,0],["آناً تُباعُ وَتَارَةً هِيَ خِدعَةً","تَمْنَى بِشَرِّ سُعاتِها الأُمَراءُ",17,"ا",2,0],["آناً تَرُدُّ عنِ الفَرِيسةِ نَابَها","تَبغِي مَقاتِلَها وآناً تَنْشَبُ",18,"ب",1,0],["إنْ آتِ ذَنْباً فما عَهْدِي بِمُنْتَقِضٍ","مِنَ النبيِّ وَلا حَبْلِي بِمُنْصَرِمِ",19,"م",1,0],["إِن أَتَحَرَّز مِنَ الغُرابِ بِها","يَكُن مَفَرّي مِنهُ إِلى الصُرَدِ",20,"د",1,0],["إِن أَترُكِ القَصدَ مِن تَذَكُّرِها","يَوماً فَما حُبُّها بِمُقتَصَدِ",21,"د",1,0],["إِن اِتَّكَلتَ عَلى مَن لا يَضيعُ لَهُ","خَلقٌ فَإِنَّ قَضاءَ اللَهِ ما وَكَّلَك",22,"ك",1,0],["أَن أَتاها مُحَرِّشٌ بِحَدِيثٍ","كاذِباً ما أَرادَ إِلّا رَداها",23,"ا",3,0],["إن أَتتني سعادتي بعد مَوتي","فَشقاء الحَياة لَيسَ يضير",24,"ر",1,0],["إن أتى الهوان فَلا","كان ذلك اللقب",25,"ب",1,0],["إن أتاها فليس فيها بباد","أو جناها فذا الورى شركاء",26,"ا",2,0],["إِنِ اتَّفَقْتُمْ أَوِ اخْتَلَفْتُمْ","لِلْخَيْرِ سَهْمٌ فِي كُلِّ مَذْهَبْ",27,"ب",1,0],["إِنَّ أَترابَهُ اِهتَدوا بِهُداهُ","فَتَحَلَّت أَخلاقُهُم تَهذيبا",28,"ب",2,0],["أنَّاتُ مَجْرُوحٍ يُعالِجُ سَهْمَهُ","وزَفِيرُ مَأسُورٍ بِغَيرِ فَكاكِ",29,"ك",1,0],["إنا تركنا الخصْم يضحك أَوَّلاً","ليزيد نَوْحَا حين نَضْحَكُ آخرا",30,"ر",2,0],["إنْ أتاهُ فقيرُ قومٍ يريد الفضلَ","منه يُجْبِهُ قبل دُعائه",31,"ا",3,0],["إن أتَى لَم يَخشَ مَسألَةً","لَم نُكَلِّفهُ بِإهدَاءِ",32,"ا",2,0],["إن أتَانَا الشعرُ مِن أحَدٍ","لَم يُجِب عَنَّا أمرُؤٌ نَاءِ",32,"ا",2,0],["إن أتعب الخلقَ في الأفهامِ معضلةٌ","تراه أسبقهم في معركَ النُزُلِ",33,"ل",1,0],["إِنّا تَوَقَّعنا السَلامَةَ وَحدَها","فَاِستَحلَقَت ما لَم يَكُن مُتَوَقَّعا",34,"ع",2,0],["أنا تائب يارب فاقبل توبتي","فضلا ووفقني لما ترضاه",35,"ا",2,0],["إِن أَترُكِ العَودَ في أَمرِ اِغتِنائِكُمُ","فَنَهلَةُ الطَرفِ مَجزاةٌ عَنِ العَلَلِ",36,"ل",1,0],["أنا تائه في غيهَبٍ","شبحُ الردى فيه قريني",37,"ن",2,0],["إِن أَتَت شاعِرَ العَرَب","نائِحاتٍ بِمَأتَمِه",38,"ه",1,0],["إِنَّا تَوَسَّلْنَا إِلَيْكَ بِحَقِّهِ","يَا نَجْلَهُ مُجْلِي الظَّلاَمِ الْحَالِكِ",39,"ك",1,0],["إِنِ اِتّهمتَ فُؤادي في تحافظهِ","فَاِنظر إِلى السحرِ يَجري من لواحظهِ",40,"ه",1,0],["أناتك أو قل لي إذا ما تركتني","قليلا لأصحو ما الذي ضُمّن الطرس",41,"س",1,0],["أناتك يا ساقي وحسبك ما ترى","فما في دمي روح ولا في يدي أنس",41,"س",1,0],["انا تدب وتسري","في كل جسم وروح",42,"ح",1,0],["أناتهم في القلب صارخة","ووجودهم بالحس مرتهن",43,"ن",1,0],["أَنَا تِبْرٌ فَوقَ خَصْرٍ","صَارَ لي حِلْياً وَزِينا",44,"ن",2,1],["أنأَتْهُمُ عَنكَ أيْنُقٌ رُسُمٌ","ما لِي وما لِلأَيانقِ الرُّسْم",45,"م",1,0],["أنَا تاجُ فُرسانِ الهِيَاجِ ومَن بِهِمْ","ثَبتتْ أوَاخِي مُلكِ كلِّ مُتوَّجِ",46,"ج",1,1],["أنا تائب لك آيب لك سائل","أهدى الطريق وهدي ضيف طارق",47,"ق",1,0],["أنا تائب لك آيب أنا واقف","بالباب يا مولاي أسألك المنى",48,"ن",2,0],["أنا تائبٌ لك آيبٌ لك آمن","فاغفر ذنوباً أدني أثقالها",49,"ل",3,0],["أنا تائب لك آيبٌ","مما أسأت فتب عليه",50,"ي",2,0],["إنا تقاسمنا الهوى فجحيمه","في مهجتي ونعيمه لك داره",51,"ر",2,0],["إن أُتِيَ الشعرُ من قُصورٍ","صدرن من معرضِ مطيلِ",52,"ل",1,0],["إنَّا تَقاسَمْنا التَّشَرُّدَ ..عِشتَه ُ","قَبْلي ، وَها أنَذا بِه ِ أتَعَثَّرُ",53,"ر",1,0],["إِن أَتى فِرعَونُ إِعدامٍ أَتى","مِن يَداهُ بِعَصا موسى الكَليمِ",54,"م",1,0],["إِن أَتحَفَت أَوتارُهُ لِطَريقَةٍ","وَقَعَت مِنَ الأَسماعِ أَحسَنَ مَوقِعِ",55,"ع",1,0],["اِنْ أتهموا فهواكَ أوَّلُ متهِمٍ","أو أنجدوا عَطَفَ الغرامُ فانجدا",56,"د",2,0],["أنا تاجُ الأَولِياءِ","وهُمُ أهلُ وَلائي",57,"ي",1,0],["إنْ أتَيْتَ العَقيقَ عمّرَكَ اللّ","هُ ووُقّيتَ فِتنةَ الأحْداقِ",58,"ق",1,0],["أنا تِرْبُ الظَّبا رفيقُ العَوالِي","حربُ هذي الطُّلى عدوُّ التَّراقي",59,"ق",2,0],["إِنِ اتَّهَمْتَ حديثي عن شَجاعتِه","فاستنجد البيضَ عنه واسْأَل الأَسَلا",60,"ل",2,0]]}