//www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6113,"الا يالله","https://www.poetsgate.com/ViewPoem.aspx?id=12953",""],[6124,"رنات عود","https://www.poetsgate.com/ViewPoem.aspx?id=201238",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""],[6236,"إذاً .. فَلْنَقتُل الحُبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81604&r=&rc=2",""],[6237,"كوكب الشرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77890&r=&rc=32",""],[6302,"يُحيطونَ.. لكنْ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86233&r=&rc=31",""],[5922,"أَمامَ يديْ ألمانيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88227&r=&rc=2",""],[6351,"صحراء انتظارٍ أنا.. وغيمة الموعد أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86048&r=&rc=8",""],[5567,"حوادم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69069&r=&rc=7",""]],"verses":[["إِن أَتَمَّت يَداكَ تَخريبَ مِصرٍ","فَلَقَد مَهَّدَ الخَرابَ أَبوكا",0,"ك",2,0],["أَنا تاجُ العَلاءِ في مَفرِقِ الشَر","قِ وَدُرّاتُهُ فَرائِدُ عِقدي",1,"د",2,0],["إِنَّ اتِّحَادَ قُوَاكُمْ بَعْدَهُ عِوَضٌ","مِمَنْ دَهَى مِصْر فِيهِ الثُّكْلُ وَاليَتَمُ",2,"م",1,0],["أنا تاج كهلال","أنا كرسيُّ جمالِ",3,"ل",1,1],["إِنّا تُفَضَّلُ في الحَياةِ حَياتُنا","وَنَسودُ مَن دَخَلَ القُبورَ قُبورا",4,"ر",2,0],["إِنّا تَزيدُ عَلى الحُلومِ حُلومُنا","فَضلاً وَنَجهَلُ فَوقَ جَهلِ الجاهِلِ",5,"ل",1,0],["إِنّا تَساوَينا فَبَينَ ضُلوعِكُم","نارٌ وَمِثلُ سَعيرِها في أَضلُعي",6,"ع",2,0],["إِنّا تَمَنَّينا عَلى اللَهِ المُنى","وَاللَهُ كانَ بِنَيلِهِنَّ كَفيلا",7,"ل",2,0],["أَنا تِربُ النَدى وَرَبُّ القَوافي","وَسِمامُ العِدا وَغَيظُ الحَسودِ",8,"د",1,0],["أنات وذكرانها صنوها","ونجلُهما منهما أكرمُ",9,"م",1,1],["إِن أُتبِعِ الشَوقَ إِزراءً عَلَيهِ فَقَد","جافى مِنَ النَومِ عَن عَينَيَّ ما جافى",10,"ف",2,0],["إِنّ أَتراحَ النَوى يعقُبُها","بِجَزيلِ الحَظِّ أفراحُ الإياب",11,"ب",1,0],["إنّا تشفَّعْنا إليكَ بأحمدٍ","أعلى الورى قدراً وأرفعَ منصبا",12,"ب",2,0],["إنِ اتخذتم بدلاً","مِنِّي فلا تأسُّفا",13,"ف",2,1],["أنا تلميذُ بيتكمُ قديماً","بكمْ فخري إذا افتخرَ الأنامُ",14,"م",1,0],["أَن أَتى مِنها رَسولٌ مَوهِناً","وَجَدَ الحَيَّ نِياماً فَاِنقَلَب",15,"ب",1,0],["إنّا تأمّلنا الأُمورَ فلم نَجِد","حُريةً هِبَةً ولا استقلالا",16,"ل",2,0],["آناً تُباعُ وَتَارَةً هِيَ خِدعَةً","تَمْنَى بِشَرِّ سُعاتِها الأُمَراءُ",17,"ا",2,0],["آناً تَرُدُّ عنِ الفَرِيسةِ نَابَها","تَبغِي مَقاتِلَها وآناً تَنْشَبُ",18,"ب",1,0],["إنْ آتِ ذَنْباً فما عَهْدِي بِمُنْتَقِضٍ","مِنَ النبيِّ وَلا حَبْلِي بِمُنْصَرِمِ",19,"م",1,0],["إِن أَتَحَرَّز مِنَ الغُرابِ بِها","يَكُن مَفَرّي مِنهُ إِلى الصُرَدِ",20,"د",1,0],["إِن أَترُكِ القَصدَ مِن تَذَكُّرِها","يَوماً فَما حُبُّها بِمُقتَصَدِ",21,"د",1,0],["إِن اِتَّكَلتَ عَلى مَن لا يَضيعُ لَهُ","خَلقٌ فَإِنَّ قَضاءَ اللَهِ ما وَكَّلَك",22,"ك",1,0],["أَن أَتاها مُحَرِّشٌ بِحَدِيثٍ","كاذِباً ما أَرادَ إِلّا رَداها",23,"ا",3,0],["إن أَتتني سعادتي بعد مَوتي","فَشقاء الحَياة لَيسَ يضير",24,"ر",1,0],["إن أتى الهوان فَلا","كان ذلك اللقب",25,"ب",1,0],["إن أتاها فليس فيها بباد","أو جناها فذا الورى شركاء",26,"ا",2,0],["إِنِ اتَّفَقْتُمْ أَوِ اخْتَلَفْتُمْ","لِلْخَيْرِ سَهْمٌ فِي كُلِّ مَذْهَبْ",27,"ب",1,0],["إِنَّ أَترابَهُ اِهتَدوا بِهُداهُ","فَتَحَلَّت أَخلاقُهُم تَهذيبا",28,"ب",2,0],["أنَّاتُ مَجْرُوحٍ يُعالِجُ سَهْمَهُ","وزَفِيرُ مَأسُورٍ بِغَيرِ فَكاكِ",29,"ك",1,0],["إنا تركنا الخصْم يضحك أَوَّلاً","ليزيد نَوْحَا حين نَضْحَكُ آخرا",30,"ر",2,0],["إنْ أتاهُ فقيرُ قومٍ يريد الفضلَ","منه يُجْبِهُ قبل دُعائه",31,"ا",3,0],["إن أتَى لَم يَخشَ مَسألَةً","لَم نُكَلِّفهُ بِإهدَاءِ",32,"ا",2,0],["إن أتَانَا الشعرُ مِن أحَدٍ","لَم يُجِب عَنَّا أمرُؤٌ نَاءِ",32,"ا",2,0],["إن أتعب الخلقَ في الأفهامِ معضلةٌ","تراه أسبقهم في معركَ النُزُلِ",33,"ل",1,0],["إِنّا تَوَقَّعنا السَلامَةَ وَحدَها","فَاِستَحلَقَت ما لَم يَكُن مُتَوَقَّعا",34,"ع",2,0],["أنا تائب يارب فاقبل توبتي","فضلا ووفقني لما ترضاه",35,"ا",2,0],["إِن أَترُكِ العَودَ في أَمرِ اِغتِنائِكُمُ","فَنَهلَةُ الطَرفِ مَجزاةٌ عَنِ العَلَلِ",36,"ل",1,0],["أنا تائه في غيهَبٍ","شبحُ الردى فيه قريني",37,"ن",2,0],["إِن أَتَت شاعِرَ العَرَب","نائِحاتٍ بِمَأتَمِه",38,"ه",1,0],["إِنَّا تَوَسَّلْنَا إِلَيْكَ بِحَقِّهِ","يَا نَجْلَهُ مُجْلِي الظَّلاَمِ الْحَالِكِ",39,"ك",1,0],["إِنِ اِتّهمتَ فُؤادي في تحافظهِ","فَاِنظر إِلى السحرِ يَجري من لواحظهِ",40,"ه",1,0],["أناتك أو قل لي إذا ما تركتني","قليلا لأصحو ما الذي ضُمّن الطرس",41,"س",1,0],["أناتك يا ساقي وحسبك ما ترى","فما في دمي روح ولا في يدي أنس",41,"س",1,0],["انا تدب وتسري","في كل جسم وروح",42,"ح",1,0],["أناتهم في القلب صارخة","ووجودهم بالحس مرتهن",43,"ن",1,0],["أَنَا تِبْرٌ فَوقَ خَصْرٍ","صَارَ لي حِلْياً وَزِينا",44,"ن",2,1],["أنأَتْهُمُ عَنكَ أيْنُقٌ رُسُمٌ","ما لِي وما لِلأَيانقِ الرُّسْم",45,"م",1,0],["أنَا تاجُ فُرسانِ الهِيَاجِ ومَن بِهِمْ","ثَبتتْ أوَاخِي مُلكِ كلِّ مُتوَّجِ",46,"ج",1,1],["أنا تائب لك آيب لك سائل","أهدى الطريق وهدي ضيف طارق",47,"ق",1,0],["أنا تائب لك آيب أنا واقف","بالباب يا مولاي أسألك المنى",48,"ن",2,0],["أنا تائبٌ لك آيبٌ لك آمن","فاغفر ذنوباً أدني أثقالها",49,"ل",3,0],["أنا تائب لك آيبٌ","مما أسأت فتب عليه",50,"ي",2,0],["إنا تقاسمنا الهوى فجحيمه","في مهجتي ونعيمه لك داره",51,"ر",2,0],["إن أُتِيَ الشعرُ من قُصورٍ","صدرن من معرضِ مطيلِ",52,"ل",1,0],["إنَّا تَقاسَمْنا التَّشَرُّدَ ..عِشتَه ُ","قَبْلي ، وَها أنَذا بِه ِ أتَعَثَّرُ",53,"ر",1,0],["إِن أَتى فِرعَونُ إِعدامٍ أَتى","مِن يَداهُ بِعَصا موسى الكَليمِ",54,"م",1,0],["إِن أَتحَفَت أَوتارُهُ لِطَريقَةٍ","وَقَعَت مِنَ الأَسماعِ أَحسَنَ مَوقِعِ",55,"ع",1,0],["اِنْ أتهموا فهواكَ أوَّلُ متهِمٍ","أو أنجدوا عَطَفَ الغرامُ فانجدا",56,"د",2,0],["أنا تاجُ الأَولِياءِ","وهُمُ أهلُ وَلائي",57,"ي",1,0],["إنْ أتَيْتَ العَقيقَ عمّرَكَ اللّ","هُ ووُقّيتَ فِتنةَ الأحْداقِ",58,"ق",1,0],["أنا تِرْبُ الظَّبا رفيقُ العَوالِي","حربُ هذي الطُّلى عدوُّ التَّراقي",59,"ق",2,0],["إِنِ اتَّهَمْتَ حديثي عن شَجاعتِه","فاستنجد البيضَ عنه واسْأَل الأَسَلا",60,"ل",2,0],["انا تصارعنا كثيرا مثلما","قد صارع الموت الزؤام عليلا",61,"ل",2,0],["انا تقاسمنا الغضا فغصونه","في راحتيك وجمره في اضلعي",62,"ي",1,0],["إِن أَتى سر من رأى فليعرّج","نحو غاب قد ضم ليثاً هصورا",63,"ر",2,0],["ان أَتى غيركم يروض المعالي"