 لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[462,"جهلت شهاب الدين ثم بلوته","https://www.aldiwan.net/poem16035.html","الطويل"],[465,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[465,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[465,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[465,"جهلاً نظرت برامتين","https://www.aldiwan.net/poem3478.html","عموديه"],[465,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[465,"تباً لما اختلق الواشي وما نقلا","https://www.aldiwan.net/poem3504.html","عموديه"],[465,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[471,"أكرع الكرعة الروية منها","https://www.aldiwan.net/poem4796.html","البسيط"],[478,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[478,"رحلوا سحرا جلبوا فكرا","https://www.aldiwan.net/poem15312.html","المتدارك"],[501,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[501,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[501,"سقط الفحول عن الأرائك","https://www.aldiwan.net/poem38102.html","مجزوء الكامل"],[501,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[506,"النسيان","https://www.aldiwan.net/poem42457.html","السريع"],[515,"جعلتك بالسويدا من فؤادي","https://www.aldiwan.net/poem20857.html","الوافر"],[516,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[516,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[530,"فؤادك يا بن ودي من حديد","https://www.aldiwan.net/poem37455.html","الوافر"],[539,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[552,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[554,"جهد المنايا أن تميتك بعدما","https://www.aldiwan.net/poem68289.html","الكامل"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[554,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[554,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[559,"إن المحب إذا اختفت أسراره","https://www.aldiwan.net/poem34377.html","الكامل"],[559,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[559,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[559,"نفس بعلوة لا تزال أبية","https://www.aldiwan.net/poem34719.html","الكامل"],[563,"ربيبة من ذوات الغنج والحور","https://www.aldiwan.net/poem52918.html","البسيط"],[568,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[576,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[586,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["جَهمَةٌ تَضرِبُ غارَيها الصَبا","رَجَّةَ الرَكبِ يَكُدّونَ البِئارا",0,"ر",2,0],["جَهِلَ الفَضيلَةَ فهْوَ يُنْكِرُ أهْلَها","والشّمْسُ تُعْشي ناظِرَ الخَفّاشِ",1,"ش",1,0],["جُهْدُ الصّبابةِ أن أكون مَلومَا","والوَجْدُ يُظهِرُ سِرّيَ المَكتوما",2,"م",2,1],["جُهْدُ قَلْبٍ لَقّفْتُ بعْدَ جِهادٍ","نُقْطَةً منْ قَليبِه المُمْتاحِ",3,"ح",1,0],["جِهَادُ هَوىً لَكِنْ بِغَيْرِي ثَوَابي","وَشَكْوَى جَوىً لَكِنْ بِغَيْرِي جَوَابِي",4,"ب",2,1],["جَهلٌ طِلابُ الغانِياتِ وَقَد","يَكونُ لَهوٌ هَمُّهُ وَغَزَل",5,"ل",1,0],["جَهِلوا الحَياةَ وَما الحَيا","ةُ لِغَيرِ كَدّاحٍ مُغامِر",6,"ر",1,0],["جَهلاً علينا وَجُبناً عَن عَدوكُم","لَبِئسَتِ الخَلَّتانِ الجَهلُ وَالجُبُنُ",7,"ن",1,0],["جِهادٌ لِوَجهِ اللَهِ في نَصرِ دينِهِ","وَفي طاعَةِ اللَهِ العَزيزِ اِحتِسابُهُ",8,"ب",2,0],["جَهدَ المُقِلُّ نَصيحَةً مَمحوضَةً","أَفرَدتَ مُهديها فَلا إِشراكا",9,"ك",2,0],["جَهمُ المُحَيّا تُضيءُ اللَيلَ صورَتُهُ","آباؤُهُ مِن طِوالِ السَمكِ أَحرارُ",10,"ر",1,0],["جهلاً وحمقاً بدعوى","حظ له في المعالي",11,"ل",2,0],["جُهْدُ الأَسَى أَنْ تَغِيبِي","وَمَا لِعَوْدٍ وَسِيلَهْ",12,"ل",2,0],["جَهَالَةٌ وَلَّدَتْ فِيهَا قَرَائِحُهُمْ","ضُرُوبَ نَحْتٍ وَتَصْوِيرٍ وَبُنْيَانِ",13,"ن",1,0],["جُهِلَتْ مَفَاخِرُهُمْ وَرَاءَ مَكَانِهَا","وَاليَوْمَ قَدْ عُرِفَتْ بِكُلِّ مَكَانِ",14,"ن",1,0],["جَهْبَذٌ يَنْقُدُ الصَّحِيحَ مِنَ الزِّي","فِ وَيَجْفُو سَبِيلَ كُلِّ مُلِيمِ",15,"م",1,0],["جَهْلُهَا فِيهِ شِبْهُ نُورٍ وَخَيْرٌ","مِنْهُ لَوْ أَنَّهُ ظَلامٌ بَهِيمُ",16,"م",1,0],["جهَزت جيش دعاء فيه ترفعه","لذي المعارج والإخلاص رقَّاهُ",17,"ا",2,0],["جهْزْ جيوشك للجهاد موفّقاً","وكفى بربك كافياً وكفيلا",18,"ل",2,0],["جهَّزوها مدافعاً فغرت أف","واه نار قدِ اْلتَقَمْنَ الشوسا",19,"س",2,0],["جهلنا أشدّ الجهل آخر عمرنا","كما قد جهلنا قبله أوّل العمر",20,"ر",1,0],["جهلتُ كجهل الناس حكمة خالق","على الخلق طرّاً بالتعاسة حاكم",21,"م",1,0],["جَهلاً تَمَنّى حُدائي مِن ضَلالَتِهِم","فَقَد حَدَوتُهُمُ مَثنى وَوُحدانا",22,"ن",2,0],["جَهمُ المُحَيّا هِزَبرٌ ذو مُجاهَرَةٍ","يُدني الفَريسَةَ مِن غيلٍ وَأَشبالِ",23,"ل",1,0],["جَهَدوا العَداوَةَ كُلَّها فَأَصَدَّها","عَنّي مَناكِبُ عِزُّها مَعلومُ",24,"م",1,0],["جَهماً لَعَمرُكَ لَو دُهيتَ بِمِثلِها","لَأَتاكَ أَخثَمُ شابِكُ الأَنيابِ",25,"ب",1,0],["جهد المقلّ دموعه فتأمّلا","في صفو شعري دمعة المحزون",26,"ن",1,0],["جَهبَذَ العَقل لا يفوتك شيءٌ","مِثلُهُ فاتَ أعينَ البُصَراءِ",27,"ا",2,0],["جهالة وتعدٍّ في إهانته","مولاك والذنب في هاتيك مغتفر",28,"ر",1,0],["جهد الناس أن يدانوك في المج","د فما قارب الصميم الوشيظُ",29,"ظ",1,0],["جهدناكم مرياً فقال ذوو النهى","لقد أشبهت أظلاف شاة ضروعها",30,"ع",3,0],["جهلتُ الآبنوسَ فقلتُ غصنٌ","ولم أحسبه بعضَ قرون راسك",31,"ك",1,0],["جهولٌ على الأعداء جهلَ نكايةٍ","يداوَى به جهلُ الجهولِ فيُحْسَمُ",32,"م",1,0],["جَهْوريٌّ بلا جفاءٍ على السَّمْ","ع مشوبٌ بِغُنَّةِ الغِزلان",33,"ن",1,0],["جُهَراءُ بِالمَعروفِ حينَ تَراهُمُ","حُلَماءُ غَيرُ تَنابِلٍ أَشرارِ",34,"ر",1,0],["جَهِلَ النَطاسِيُّ عِلَّتي","لِلَّهِ مِن جَهلِ الخَبيرِ",35,"ر",1,0],["جَهِلَ العَذولُ بِأَنَّني في حُبِّكُم","سَهَرُ الدُجى عِندي أَلَذُّ مِنَ الكَرى",36,"ر",2,0],["جَهِلَ العاذِلُ أَمري","أَنا بِالعاذِلِ أَلعَب",37,"ب",1,0],["جَهِلَ النَّاسُ روحَهُ وأغانيها","فَسَاموا شعورَهُ سوْمَ بَخْسِ",38,"س",1,0],["جهاد على الأرض الحياة جميعها","فلست تلاقى فوقها من محايد",39,"د",1,0],["جهل الذين على قديم عولوا","ان الزمان يغير الاحكاما",40,"م",2,0],["جهلت اختيار اللَه فهو معذَّب","لبعض ومعطى البعض من فضله أجرا",41,"ر",2,0],["جَهلٌ وَتَضليلُ أَحلامٍ وَسَفسَطَةٌ","فَتَحتَ بِالسَيفِ بَعدَ الفَتحِ بِالقَلَمِ",42,"م",1,0],["جَهِلوا حَقيقَتَهُ وَحِكمَةَ حُكمِهِ","فَتَجاوَزوهُ إِلى أَذىً وَضِرارِ",43,"ر",1,0],["جَهدُ الصَبابَةِ ما أُكابِدُ فيكِ","لَو كانَ ما قَد ذُقتُهُ يَكفيكِ",44,"ك",1,1],["جِهاتٌ أَم عَذارى حالِياتُ","وَماءٌ أَم سَماءٌ أَم نَباتُ",45,"ت",1,0],["جَهِلوني وَإِن عَمَرتُ قَليلاً","نَسَبَتني لَهُم رُؤوسُ الرِماحِ",46,"ح",1,0],["جُهدُ المُقِلِّ فَكَيفَ بِاِبنِ كَريمَةٍ","توليهِ خَيراً وَاللِسانُ فَصيحُ",47,"ح",1,0],["جُهدُ الصَبابَةِ أَن تَكونَ كَما أَرى","عَينٌ مُسَهَّدَةٌ وَقَلبٌ يَخفِقُ",48,"ق",1,0],["جَهِدوا عَلى أَن يَلحَقوكَ وَأَفحَشُ ال","حِرمانِ يُقدَرُ لِلحَريصِ الجاهِدِ",49,"د",1,0],["جَهيرُ الخِطابِ يَخفِضُ القَومُ عِندَهُ","مَعاريضَ قَولٍ كَالرِياحِ الرَواكِدِ",50,"د",1,0],["جَهمٌ عَبوسٌ عَلى ظَهرِ الخِوانِ لَهُ","تَفريقُ لَحظٍ كَأَطرافِ السَكاكينِ",51,"ن",1,0],["جَهيضَ فَلاةٍ أَعجَلَتهُ تَمامَهُ","هَبوعُ الضُحى خَطّارَةٌ أُمُّ رابِعِ",52,"ع",1,0],["جَهولٍ كَجَوفِ الفيلِ لَم يُرَ مِثلُها","تَرى الزَورَ فيها كَالغُثاءَةِ طافِيا",53,"ي",2,0],["جُهْدُ المَتَّيمِ أن يَرعى العهودَ لها","حِفْظاً ويَحْمِلَ عن أجفانِها السَّقَما",54,"م",2,0],["جَهولُ الحُسامِ ولكنَّه","يَروحُ ويغدو بِكَفَّيْ حَليمِ",55,"م",1,0],["جُهدُ المَواهِبِ أَن تَغنى خَزائِنُهُ","حَتّى كَأَنَّ بِها ضَرباً مِنَ اللَجَجِ",56,"ج",1,0],["جَهّزْتَ حزْماً إليهم كلَّ ذي لجبٍ","تُحَمّ بالضرب هنديّاتُهُ الخذمُ",57,"م",1,0],["جَهِلوا فَلَم يَستَكثِروا مِن طاعَةٍ","مَعروفَةٍ بِعِمارَةِ الأَعمارِ",58,"ر",1,0],["جَهمِيَّةُ الأَوصافِ إِلّا أَنَّهُم","قَد لَقَّبوها جَوهَرَ الأَشياءِ",59,"ا",2,0],["جهادُكَ مقبولٌ وعامُكَ قابلُ","ألا في سبيل المجدِ ما أنتَ فاعِلُ",60,"ل",1,1],["جَهِلتُ وَما أَلقى عَليماً وَإِنَّما","مَرِهتُ وَأَعيا أَن أَمُرَّ بِكاحِلِ",61,"ل",1,1],["جَهِلَ الحياةَ لِكلِّ شَعبٍ حَقُّه","ورِضَى الشُّعوبِ بأن تَموتَ مُحالُ",62,"ل",1,0],["جِهادٌ تقذف الآياتُ فيهِ","بِكلِّ مُدمِّرٍ عَجِلِ الفَناءِ",63,"ا",2,0],["جِهادٌ لَهُ في ساحَةِ المَجدِ وَالعُلا","مَواقِفُ تَبقى واضِحاتِ المَعالِمِ",64,"م",1,0],["جَهِلْتُمْ جزاءَ البَغْيِ والبَغْيُ مَركبٌ","لِذي الجهلِ يُؤذِي شُؤمُهُ كلَّ راكبِ",65,"ب",1,0],["جهلتم ما وراءَ الغدرِ حتّى","رأيتم كيف يَتّعظُ الجهولُ",66,"ل",1,0],["جَهلوا فعاجلهم ببأسٍ عاصفٍ","لم يُبقِ منهم في الجزيرة ثاويا",67,"ي",2,0],["جَهِلَ العجائِبَ مَعشرٌ لم يعرفوا","منهنَّ إلا السِّحرَ والتنويما",68,"م",2,0],["جَهجاهُ مالك هِجتهَا مذمومةً","هوجاءَ لولا اللَّهُ ظلّتْ تَعصفُ",69,"ف",1,0],["جَهَنَّمُ تِلكَ لا تُبقي بَغيّاً","وَعَدنٌ لا يُطالِعُها رَجيمُ",70,"م",1,1],["جَهِلَتْ قومُهُ عليه فأَغْضَى","وَأخو الحِلْم دَأبُهُ الإِغْضَاءُ",71,"ا",2,0],["جهلتُ الهوى حتى اختبرْتُ عذابَهُ","كما اختبرَ الرِّعْديد بأسَ المُصَمِّم",72,"م",1,0],["جهِلَ البطارِقُ أنّه الملِكُ الذي","أوصى البَنِينَ بسِلمِهِ الآباء",73,"ا",2,0],["جهولٍ باللذاذةِ من غلامٍ","يظلّ ممدداً فوق البساطِ",74,"ط",1,0],["جَهَّزتُها لَيلاً إِلى مالِكٍ","يَفوتُ أَجناداً وَمَن لا يَفوتُ",75,"ت",1,0],["جَهِلوا مِن أَبوهُ إِلّا ظُنوناً","وَطَلا الوَحشِ لاحِقٌ بِمَهاتِه",76,"ت",2,0],["جَهلٌ مَرامِيَ أَن تَكونَ مُوافِقي","وَشُكوكُ نَفسي بَينَهُنَّ تَعادي",77,"د",2,1],["جِهلَ الناسُ ما أَبوهُ عَلى الدَه","رِ وَلَكِنَّهُ مُسَمّىً بِحَرسِ",78,"س",1,0],["جَهَّلَت هُرمُسَ الغُيومُ وَما تُن","جَمُ إِلّا عَن جِريَةِ الهِرماسِ",79,"س",1,0],["جَهِلنا فَحَيٌّ في الضَلالَةِ مَيِّتٌ","أَخو سَكرَةٍ في غَيِّهِ لا يُراجِعُ",80,"ع",1,0],["جَهِلَ الدِيانَةَ مَن إِذا عَرَضَت لَهُ","أَطماعُهُ لَم يُلفَ بِالمُتَماسِكِ",81,"ك",1,0],["جَهَلتُ أُقاضي الرَيَّ أَكثَرُ مَأثَماً","بِما نَصَّهُ أَم شاعِرٌ يَتَغَزَّلُ",82,"ل",1,0],["جَهَلنَ الغِناءَ وَصَوتاً يُقا","لُ غَنّاهُ دَحمانُ أَو زُلزُلُ",83,"ل",1