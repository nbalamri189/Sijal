ب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"وجماش يلوم على اللواط","https://www.aldiwan.net/poem66549.html","الوافر"],[50,"مهلا أخي لم تلق ما قد لقيت","https://www.aldiwan.net/poem64744.html","السريع"],[46,"إنما نحن في ضلال وتعلي","https://www.aldiwan.net/poem22218.html","الخفيف"],[46,"جهل مرامي أن تكون موافقي","https://www.aldiwan.net/poem22489.html","الكامل"],[46,"قال قوم ولا أدين بما قالوه","https://www.aldiwan.net/poem22851.html","الخفيف"],[46,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[46,"هي النفس عناها من الدهر فاجع","https://www.aldiwan.net/poem22934.html","الطويل"],[46,"سبح وصل وطف بمكة زائرا","https://www.aldiwan.net/poem23102.html","الكامل"],[46,"أيسجنني رب العلا منصف","https://www.aldiwan.net/poem23125.html","الطويل"],[46,"غدا كل طفل على عمره","https://www.aldiwan.net/poem23157.html","المتقارب"],[46,"جهلتك بل عرفتك ما خشوعي","https://www.aldiwan.net/poem23238.html","الوافر"],[46,"رام دنياه ناسك","https://www.aldiwan.net/poem23276.html","مجزوء الخفيف"],[46,"كبار أناس مثل جلة سائم","https://www.aldiwan.net/poem23283.html","الطويل"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[8,"جهلت علي ابن الحيا وظلمتني","https://www.aldiwan.net/poem21816.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85823","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85396","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140832",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16622","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9985","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54716","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43836","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54255","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[91,"1916","https://www.poetsgate.com/ViewPoem.aspx?id=53214",""],[46,"إنّما نحنُ في ضلالٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18126",""]],"verses":[["جَهمَةٌ تَضرِبُ غارَيها الصَبا","رَجَّةَ الرَكبِ يَكُدّونَ البِئارا",0,"ر",2,0],["جَهِلَ الفَضيلَةَ فهْوَ يُنْكِرُ أهْلَها","والشّمْسُ تُعْشي ناظِرَ الخَفّاشِ",1,"ش",1,0],["جُهْدُ الصّبابةِ أن أكون مَلومَا","والوَجْدُ يُظهِرُ سِرّيَ المَكتوما",2,"م",2,1],["جُهْدُ قَلْبٍ لَقّفْتُ بعْدَ جِهادٍ","نُقْطَةً منْ قَليبِه المُمْتاحِ",3,"ح",1,0],["جِهَادُ هَوىً لَكِنْ بِغَيْرِي ثَوَابي","وَشَكْوَى جَوىً لَكِنْ بِغَيْرِي جَوَابِي",4,"ي",1,1],["جَهلٌ طِلابُ الغانِياتِ وَقَد","يَكونُ لَهوٌ هَمُّهُ وَغَزَل",5,"ل",1,0],["جَهِلوا الحَياةَ وَما الحَيا","ةُ لِغَيرِ كَدّاحٍ مُغامِر",6,"ر",1,0],["جَهلاً علينا وَجُبناً عَن عَدوكُم","لَبِئسَتِ الخَلَّتانِ الجَهلُ وَالجُبُنُ",7,"ن",1,0],["جِهادٌ لِوَجهِ اللَهِ في نَصرِ دينِهِ","وَفي طاعَةِ اللَهِ العَزيزِ اِحتِسابُهُ",8,"ب",2,0],["جَهدَ المُقِلُّ نَصيحَةً مَمحوضَةً","أَفرَدتَ مُهديها فَلا إِشراكا",9,"ك",2,0],["جَهمُ المُحَيّا تُضيءُ اللَيلَ صورَتُهُ","آباؤُهُ مِن طِوالِ السَمكِ أَحرارُ",10,"ر",1,0],["جهلاً وحمقاً بدعوى","حظ له في المعالي",11,"ي",1,0],["جُهْدُ الأَسَى أَنْ تَغِيبِي","وَمَا لِعَوْدٍ وَسِيلَهْ",12,"ل",2,0],["جَهَالَةٌ وَلَّدَتْ فِيهَا قَرَائِحُهُمْ","ضُرُوبَ نَحْتٍ وَتَصْوِيرٍ وَبُنْيَانِ",13,"ن",1,0],["جُهِلَتْ مَفَاخِرُهُمْ وَرَاءَ مَكَانِهَا","وَاليَوْمَ قَدْ عُرِفَتْ بِكُلِّ مَكَانِ",14,"ن",1,0],["جَهْبَذٌ يَنْقُدُ الصَّحِيحَ مِنَ الزِّي","فِ وَيَجْفُو سَبِيلَ كُلِّ مُلِيمِ",15,"م",1,0],["جَهْلُهَا فِيهِ شِبْهُ نُورٍ وَخَيْرٌ","مِنْهُ لَوْ أَنَّهُ ظَلامٌ بَهِيمُ",16,"م",1,0],["جهَزت جيش دعاء فيه ترفعه","لذي المعارج والإخلاص رقَّاهُ",17,"ا",2,0],["جهْزْ جيوشك للجهاد موفّقاً","وكفى بربك كافياً وكفيلا",18,"ل",2,0],["جهَّزوها مدافعاً فغرت أف","واه نار قدِ اْلتَقَمْنَ الشوسا",19,"س",2,0],["جهلنا أشدّ الجهل آخر عمرنا","كما قد جهلنا قبله أوّل العمر",20,"ر",1,0],["جهلتُ كجهل الناس حكمة خالق","على الخلق طرّاً بالتعاسة حاكم",21,"م",1,0],["جَهلاً تَمَنّى حُدائي مِن ضَلالَتِهِم","فَقَد حَدَوتُهُمُ مَثنى وَوُحدانا",22,"ن",2,0],["جَهمُ المُحَيّا هِزَبرٌ ذو مُجاهَرَةٍ","يُدني الفَريسَةَ مِن غيلٍ وَأَشبالِ",23,"ل",1,0],["جَهَدوا العَداوَةَ كُلَّها فَأَصَدَّها","عَنّي مَناكِبُ عِزُّها مَعلومُ",24,"م",1,0],["جَهماً لَعَمرُكَ لَو دُهيتَ بِمِثلِها","لَأَتاكَ أَخثَمُ شابِكُ الأَنيابِ",25,"ب",1,0],["جهد المقلّ دموعه فتأمّلا","في صفو شعري دمعة المحزون",26,"ن",1,0],["جَهبَذَ العَقل لا يفوتك شيءٌ","مِثلُهُ فاتَ أعينَ البُصَراءِ",27,"ا",2,0],["جهالة وتعدٍّ في إهانته","مولاك والذنب في هاتيك مغتفر",28,"ر",1,0],["جهد الناس أن يدانوك في المج","د فما قارب الصميم الوشيظُ",29,"ظ",1,0],["جهدناكم مرياً فقال ذوو النهى","لقد أشبهت أظلاف شاة ضروعها",30,"ع",3,0],["جهلتُ الآبنوسَ فقلتُ غصنٌ","ولم أحسبه بعضَ قرون راسك",31,"ك",1,0],["جهولٌ على الأعداء جهلَ نكايةٍ","يداوَى به جهلُ الجهولِ فيُحْسَمُ",32,"م",1,0],["جَهْوريٌّ بلا جفاءٍ على السَّمْ","ع مشوبٌ بِغُنَّةِ الغِزلان",33,"ن",1,0],["جُهَراءُ بِالمَعروفِ حينَ تَراهُمُ","حُلَماءُ غَيرُ تَنابِلٍ أَشرارِ",34,"ر",1,0],["جَهِلَ النَطاسِيُّ عِلَّتي","لِلَّهِ مِن جَهلِ الخَبيرِ",35,"ر",1,0],["جَهِلَ العَذولُ بِأَنَّني في حُبِّكُم","سَهَرُ الدُجى عِندي أَلَذُّ مِنَ الكَرى",36,"ر",2,0],["جَهِلَ العاذِلُ أَمري","أَنا بِالعاذِلِ أَلعَب",37,"ب",1,0],["جَهِلَ النَّاسُ روحَهُ وأغانيها","فَسَاموا شعورَهُ سوْمَ بَخْسِ",38,"س",1,0],["جهاد على الأرض الحياة جميعها","فلست تلاقى فوقها من محايد",39,"د",1,0],["جهل الذين على قديم عولوا","ان الزمان يغير الاحكاما",40,"م",2,0],["جهلت اختيار اللَه فهو معذَّب","لبعض ومعطى البعض من فضله أجرا",41,"ر",2,0],["جَهلٌ وَتَضليلُ أَحلامٍ وَسَفسَطَةٌ","فَتَحتَ بِالسَيفِ بَعدَ الفَتحِ بِالقَلَمِ",42,"م",1,0],["جَهِلوا حَقيقَتَهُ وَحِكمَةَ حُكمِهِ","فَتَجاوَزوهُ إِلى أَذىً وَضِرارِ",43,"ر",1,0],["جَهدُ الصَبابَةِ ما أُكابِدُ فيكِ","لَو كانَ ما قَد ذُقتُهُ يَكفيكِ",44,"ك",1,1],["جِهاتٌ أَم عَذارى حالِياتُ","وَماءٌ أَم سَماءٌ أَم نَباتُ",45,"ت",1,0],["جَهِلوني وَإِن عَمَرتُ قَليلاً","نَسَبَتني لَهُم رُؤوسُ الرِماحِ",46,"ح",1,0],["جُهدُ المُقِلِّ فَكَيفَ بِاِبنِ كَريمَةٍ","توليهِ خَيراً وَاللِسانُ فَصيحُ",47,"ح",1,0],["جُهدُ الصَبابَةِ أَن تَكونَ كَما أَرى","عَينٌ مُسَهَّدَةٌ وَقَلبٌ يَخفِقُ",48,"ق",1,0],["جَهِدوا عَلى أَن يَلحَقوكَ وَأَفحَشُ ال","حِرمانِ يُقدَرُ لِلحَريصِ الجاهِدِ",49,"د",1,0],["جَهيرُ الخِطابِ يَخفِضُ القَومُ عِندَهُ","مَعاريضَ قَولٍ كَالرِياحِ الرَواكِدِ",50,"د",1,0],["جَهمٌ عَبوسٌ عَلى ظَهرِ الخِوانِ لَهُ","تَفريقُ لَحظٍ كَأَطرافِ السَكاكينِ",51,"ن",1,0],["جَهيضَ فَلاةٍ أَعجَلَتهُ تَمامَهُ","هَبوعُ الضُحى خَطّارَةٌ أُمُّ رابِعِ",52,"ع",1,0],["جَهولٍ كَجَوفِ الفيلِ لَم يُرَ مِثلُها","تَرى الزَورَ فيها كَالغُثاءَةِ طافِيا",53,"ي",2,0],["جُهْدُ المَتَّيمِ أن يَرعى العهودَ لها","حِفْظاً ويَحْمِلَ عن أجفانِها السَّقَما",54,"م",2,0],["جَهولُ الحُسامِ ولكنَّه","يَروحُ ويغدو بِكَفَّيْ حَليمِ",55,"م",1,0],["جُهدُ المَواهِبِ أَن تَغنى خَزائِنُهُ","حَتّى كَأَنَّ بِها ضَرباً مِنَ اللَجَجِ",56,"ج",1,0],["جَهّزْتَ حزْماً إليهم كلَّ ذي لجبٍ","تُحَمّ بالضرب هنديّاتُهُ الخذمُ",57,"م",1,0],["جَهِلوا فَلَم يَستَكثِروا مِن طاعَةٍ","مَعروفَةٍ بِعِمارَةِ الأَعمارِ",58,"ر",1,0],["جَهمِيَّةُ الأَوصافِ إِلّا أَنَّهُم","قَد لَقَّبوها جَوهَرَ الأَشياءِ",59,"ا",2,0],["جهادُكَ مقبولٌ وعامُكَ قابلُ","ألا في سبيل المجدِ ما أنتَ فاعِلُ",60,"ل",1,1],["جَهِلتُ وَما أَلقى عَليماً وَإِنَّما","مَرِهتُ وَأَعيا أَن أَمُرَّ بِكاحِلِ",61,"ل",1,1],["جَهِلَ الحياةَ لِكلِّ شَعبٍ حَقُّه","ورِضَى الشُّعوبِ بأن تَموتَ مُحالُ",62,"ل",1,0],["جِهادٌ تقذف الآياتُ فيهِ","بِكلِّ مُدمِّرٍ عَجِلِ الفَناءِ",63,"ا",2,0],["جِهادٌ لَهُ في ساحَةِ المَجدِ وَالعُلا","مَواقِفُ تَبقى واضِحاتِ المَعالِمِ",64,"م",1,0],["جَهِلْتُمْ جزاءَ البَغْيِ والبَغْيُ مَركبٌ","لِذي الجهلِ يُؤذِي شُؤمُهُ كلَّ راكبِ",65,"ب",1,0],["جهلتم ما وراءَ الغدرِ حتّى","رأيتم كيف يَتّعظُ الجهولُ",66,"ل",1,0],["جَهلوا فعاجلهم ببأسٍ عاصفٍ","لم يُبقِ منهم في الجزيرة ثاويا",67,"ي",2,0],["جَهِلَ العجائِبَ مَعشرٌ لم يعرفوا","منهنَّ إلا السِّحرَ والتنويما",68,"م",2,0],["جَهجاهُ مالك هِجتهَا مذمومةً","هوجاءَ لولا اللَّهُ ظلّتْ تَعصفُ",69,"ف",1,0],["جَهَنَّمُ تِلكَ لا تُبقي بَغيّاً","وَعَدنٌ لا يُطالِعُها رَجيمُ",70,"م",1,1],["جَهِلَتْ قومُهُ عليه فأَغْضَى","وَأخو الحِلْم دَأبُهُ الإِغْضَاءُ",71,"ا",2,0],["جهلتُ الهوى حتى اختبرْتُ عذابَهُ","كما اختبرَ الرِّعْديد بأسَ المُصَمِّم",72,"م",1,0],["جهِلَ البطارِقُ أنّه الملِكُ الذي","أوصى البَنِينَ بسِلمِهِ الآباء",73,"ا",2,0],["جهولٍ باللذاذةِ من غلامٍ","يظلّ ممدداً فوق البساطِ",74,"ط",1,0],["جَهَّزتُها لَيلاً إِلى مالِكٍ","يَفوتُ أَجناداً وَمَن لا يَفوتُ",75,"ت",1,0],["جَهِلوا مِن أَبوهُ إِلّا ظُنوناً","وَطَلا الوَحشِ لاحِقٌ بِمَهاتِه",76,"ت",2,0],["جَهلٌ مَرامِيَ أَن تَكونَ مُوافِقي","وَشُكوكُ نَفسي بَينَهُنَّ تَعادي",77,"د",2,1],["جِهلَ الناسُ ما أَبوهُ عَلى الدَه","رِ وَلَكِنَّهُ مُسَمّىً بِحَرسِ",78,"س",1,0],["جَهَّلَت هُرمُسَ الغُيومُ وَما تُن","جَمُ إِلّا عَن جِريَةِ الهِرماسِ",79,"س",1,0],["جَهِلنا فَحَيٌّ في الضَلالَةِ مَيِّتٌ","أَخو سَكرَةٍ في غَيِّهِ لا يُراجِعُ",80,"ع",1,0],["جَهِلَ الدِيانَةَ مَن إِذا عَرَضَت لَهُ","أَطماعُهُ لَم يُلفَ بِالمُتَماسِكِ",81,"ك",1,0],["جَهَلتُ أُقاضي الرَيَّ أَكثَرُ مَأثَماً","بِما نَصَّهُ أَم شاعِرٌ يَتَغَزَّلُ",82,"ل",1,0],["جَهَلنَ الغِناءَ وَصَوتاً يُقا","لُ غَنّاهُ دَحمانُ أَو زُلزُلُ",83,"ل",1,0],["جَهَلتُكَ بَل عَرَفتُكَ ما خُشوعي","لِغَيرِكَ بَينَ عِرفاني وَجَهلي",84,"ي",1,1],["جَهِلَ المُشتَري وَإِن","كانَ في الخَيرِ ذا مَحَل",85,"ل",1,0],["جَهِلنا وَلَكِن لِلخلائِقِ صانِعٌ","أَقَرَّ بِهِ فَسلٌ مِنَ القَومِ أَو شَهمُ",86,"م",1,0],["جَهِلْنا فلم نَعلمْ على الحِرْص ما الذي","يُرادُ بنا والعِلْمُ للّهِ ذي المَنِّ",87,"ن",1,0],["جَهِلْتُ فلمّا لم أرَ الجهْلَ مُغْنِياً","حَلُمْتُ فأوْسَعْتُ الزّمانَ وَقارا",88,"ر",2,0],["جَهِلتَ عَلَيَّ اِبنَ الحَيا وظَلَمتَني","وَجمَّعتَ قَولاً جاءَ بيتاً مُضَلِّلا",89,"ل",2,1],["جهلنا للجحيم أوجب أنا","بعد أن نردى للجحيم نزور",90,"ر",1,0],["جهلوا العلوم ففاتهم نيلُ الغنى","والجهلُ عنوان لفقر مدقع",91,"ع",1,0],["جهنم للذين ماتوا","في كفرهم حرها شديد",92,"د",1,0],["جهادك يفشي البرقُ أخبار نصره","وَفوزك في كل الجَرائد ينشر",93,"ر",1,0],["جهلوني وإن عمرت قليلاً","نسبتني لهم رءوس الرماح",94,"ح",1,0],["جهدُ الكرامِ به افترارُ مباسمٍ","وتكلُّفٌ في القولِ والإصغاءِ",95,"ا",2,0],["جهادٌ في العروبة واحتشادٌ","له التاريخ قد أَلقى زمامهْ",96,"م",2,0],["جهادك الحقُّ مظلوماً ومغترباً","وحيٌ لكلِّ فتىً حُرٍّ وإِلهامُ",97,"م",1,0],["جَهِلَتْ ما أنا الصّوارِمُ والخِرْ","صانُ لمّا غَدَوْتُ فيها ضَميرا",98,"ر",2,0],["جَهولٌ بالمَناسِكِ ليس يَدري","أغَيّاً باتَ يَفْعَلُ أم رَشادا",99,"د",2,0],["جَهْلٌ بمِثْلِكِ أن يَزُورَ بلادَنا","يَخْتَالُ بين أساورٍ وخَلاخلِ",100,"ل",1,0],["جَهِلْتُنّ أنّ اللّؤلؤ الذّوْبَ عندنا","رَخيصٌ وأنّ الجامِداتِ غَوال",101,"ل",1,0],["جهزه