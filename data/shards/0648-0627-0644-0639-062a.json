{"poems":[[45,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[51,"كن عند أحسن ظن من ظنا","https://www.aldiwan.net/poem63145.html","الكامل"],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[418,"إني وما مار بِالفريق وما","https://www.aldiwan.net/poem32.html","المنسرح"],[463,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55888","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[3375,"","https://poetry.dctabudhabi.ae/diwan/poem/33028","الرجز"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61271","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117855","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117889","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85087","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4248,"","https://poetry.dctabudhabi.ae/diwan/poem/105542","الرجز"],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[4816,"موت الضماير","https://www.poetsgate.com/ViewPoem.aspx?id=199479",""],[4902,"قال حاقد","https://www.poetsgate.com/ViewPoem.aspx?id=6529",""],[5183,"البيان","https://www.poetsgate.com/ViewPoem.aspx?id=186620",""],[5943,"تشطير ( يا صاحِبِي مالي وللأُنْسِ )","https://www.poetsgate.com/ViewPoem.aspx?id=138278",""]],"verses":[["وَالعُتُقِ المُحدَثَةِ الصِقالِ","سارَ لِصَيدِ الوَحشِ في الجِبالِ",0,"ل",1,0],["وَالعَتبُ يَنعَطِفُ الكَريمُ بِهِ","وَيُرى اللَئيمُ عَلَيهِ مُستَنّا",1,"ن",2,0],["والعتاقُ الجردُ هل لاقت بما","عاقها من جثث القتلى عناء",2,"ا",2,0],["والعِترِ عِتر النَّسِيكِ يُخفرُ بِال","بُدنِ لحِلِّ الإحرَامِ والنُّصُبِ",3,"ب",1,0],["والعِترة البيضاءُ لم يعلَقْ بها","من دنَس الُهجنة عِرقٌ واصمُ",4,"م",1,0],["والعتب ما بين الحبايب ملحةٌ","يزكو بها طعم الوداد ويحذقُ",5,"ق",1,0],["وَالعَتبُ يَشهَدُ بِالوِداد لِأَهله","في أَكثر الأَشياء وَالأَنحاء",6,"ا",2,0],["وَالعَتكِيَّ اليَحمَدِيَّ جَلدا","ما إِن أَرى مِنَ النِزالِ بُدّا",7,"د",2,0],["وَالعتبُ منكَ لامرئ عَلى خُلُق","مَنزِلَةٌ بَينَ السَفاهِ وَالحُمُق",8,"ق",1,0],["والعترة الأطهار أقمار السرى","ومهاجري الأصحاب والأنصار",9,"ر",1,0],["والعترة الأطهار مستودعي","أسراره والصُّحب نِعم الثقات",10,"ت",1,0],["والعترة الغر من فازوا بنسبته","بشراهم فهم في الذكر قد ذكروا",11,"ر",3,0],["والعتب بالمشافهه","ضربٌ من المسافهه",12,"ه",1,0],["والعترة الطاهرة المطهره","عليهم السلام خير الخيره",13,"ه",1,0],["والعتب ما عاد ينفع ليا فات الأوان","والدليل اللي حصل في بلاد الرافدين",14,"ن",1,0],["والعتق ميلاد يسد الملامات","ينضح على شريان الامال دفقه",15,"ق",2,0],["والعتم لابد يومٍ ينجلي","وأسود النيه يجي يوم ويطيح",16,"ح",1,0],["والعتب عنوان المحبة كالأ","مطار فاض بسيبها السحب",17,"ب",1,0],["والعَتْمُ فيهِ رَهْبةٌ وقَذَى))","( وغدي يسابق فيهما أمسي)",18,"س",2,0]]}