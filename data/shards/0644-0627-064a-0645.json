بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[549,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[549,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[551,"لا يمنعنك خفض العيش في دعة","https://www.aldiwan.net/poem68246.html","البسيط"],[551,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[551,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[556,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[560,"طال البعاد فطال الشوق والكمد","https://www.aldiwan.net/poem52804.html","البسيط"],[560,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[583,"الصفو من ماء العنب","https://www.aldiwan.net/poem1563.html",""],[584,"يا ساكنا قلبي المعنى","https://www.aldiwan.net/poem17797.html","مخلع البسيط"]],"verses":[["لا يُمسِكُ العَذلُ يَدَيهِ وَلا","تَأخُذُ مِنهُ سَورَةُ الخَمرِ",0,"ر",1,0],["لا يَمْنَحُ الْعِيشَةَ مِن بَالِهِ","إِنْ يَدْنُ فِيهَا الْهَمُّ أَدْنَى اهْتِمَامْ",1,"م",1,0],["لا يموت الندى ولا الجود ما عا","ش أبانٌ غِياث ذي الأنفاض",2,"ض",1,0],["لائمي إنَّ في الضنا ليَ عذراً","كلَّما اشتقت أهل وادِي الأراك",3,"ك",1,0],["لائميه على المكارمِ كفُّوا","إنَّ للصبِّ بالصبابة شغلا",4,"ل",2,0],["لا يمنع الري طالبيه ولا","يسقي نديماً له على تأق",5,"ق",1,0],["لا يُمنَّنَّ عليكم مادحٌ","بمديح فيه وشيٌ وَضَنه",6,"ن",2,0],["لا يمنع المسكينَ من نيكها","يا ليتني بعضُ مساكينه",7,"ن",2,0],["لا يمنعون الماءَ عند وروده","غُلل السُقاةِ ولا السّناة إذا سنَوا",8,"ن",3,0],["لأيِّ معنىً تخيَّرُوه","وكلُّ عيب له وفيهِ",9,"ه",1,0],["لا يَملَءُ السِربالَ واحِدُهُم","وَلَهُ وُعودٌ تَملَءُ البَلَدا",10,"د",2,0],["لا يَملُكُ الإِنسانَ فيها نَفسَهُ","حَتّى يُرَوِّعُهُ ضَجيجُ قِطارِ",11,"ر",1,0],["لا يَملِكونَ سِوى التَحَسُّرِ إِنَّهُ","جَهدُ الضَعيفِ الواجِدِ المَفلوكِ",12,"ك",1,0],["لِأَيِّما أَمرٍ يَعيشُ الوَرى","لِأَيِّما أَمرٍ يَموتُ الأَنام",13,"م",1,0],["لا يَمدَحُ الوَردَ إِنسانٌ يَقولُ لَهُ","يا وَردُ إِنَّكَ ذو عِطرٍ وَتَلوينِ",14,"ن",1,0],["لا يُمكِنُهُ الكَلامُ لَكِن","قَد حَمَّلَ طَرفَهُ رَسائِل",15,"ل",1,0],["لا يملكنك من غد بعد الردى","خوف فيوم الهالكين بلا غد",16,"د",1,0],["لا يموت الذي يعيش بآثا","ر له في مصانع قد بنينا",17,"ن",2,0],["لا يموت الذي يعظمه التأ","ريخ بعد القرون تقفو القرونا",17,"ن",2,0],["لا يموت الذي توفق ان يعلن","ما كان سره مكنونا",17,"ن",2,0],["لا يمشينّ السلحفا","ء وغيره للمجد طائر",18,"ر",1,0],["لا يَملكُ الإِنسانُ مِن أَحوالِهِ","ما تَملكُ الأَقدارُ مَهما قَدَّرا",19,"ر",2,0],["لا يَميلونَ إِلى البَغيِ بِها","كَيفَ يَبغي مَن إِلى العِلمِ اِنتَسَب",20,"ب",1,0],["لا يَمنَعَنَّكُمُ بِرُّ الأُبُوَّةِ أَن","يَكونَ صُنعُكُمُ غَيرَ الَّذي صَنَعوا",21,"ع",3,0],["لائمٌ لي بجهلِهِ ولماذا","أنا وَحْدِي أَحْبَبْتُ ثُمَّ قَتَلْتُ",22,"ت",1,0],["لا يَملِكُ الطَرِبُ المَحزونُ مَنطِقَهُ","وَدَمعَهُ وَهُما في قَبضَةِ الطَرَبِ",23,"ب",1,0],["لا يَميلُ الهَوى بِهِ حينَ يُمضي ال","أَمرَ بَينَ المَقلِيِّ وَالمَودودِ",24,"د",1,0],["لا يَمنَعونَ لَهُم حَرامَ حَليلَةٍ","بِمَهابَةٍ مِنهُم وَلا بِقِتالِ",25,"ل",1,0],["لا يمينٌ يجيرنا أو يسارٌ","تحت حد السكين نحن سواء",26,"ا",2,0],["لا يَمتَطي المَجدَ مَن لَم يَركَبِ الخَطَرا","وَلا يَنالُ العُلى مَن قَدَّمَ الحَذَرا",27,"ر",2,1],["لا يُمَلّ الحديثُ منها مُعَاداً","كانتشاقِ الهواء ليس يُمَلُّ",28,"ل",1,0],["لا يملكُ النّفسَ إلا أن يُؤخِرَها","مَنْ أمرُه الأَمْرُ في أخذٍ وتَأْخيرِ",29,"ر",1,0],["لا يَملِكونَ لَها رَدّاً إِذا اِنبَعَثَت","وَلا يُطيقونَ إِلّا المَوتَ وَالهَرَبا",30,"ب",2,0],["لا يَملِكونَ إِذا الكُماةُ تَدافَعَت","في غَمرَةٍ خَوَراً وَلا اِستِسلاما",31,"م",2,0],["لا يملكون لأهليهم وأنفسهم","إلا العذاب وإلا الظنَّ والأملا",32,"ل",2,0],["لا يَمتَطي حِفظاً وَلا يُمسي لَهُ","طَرَفٌ بِمِروَدِ رَقدَةٍ مَكحولا",33,"ل",2,0],["لا يَملَءُ الرِزقُ المُنى","فَالحَيُّ ذو حَسَراتِ",34,"ت",1,0],["لا يَمَلُّ النَثرَ لافِظُهُ","مُفتَنٌ يُعجَبُ إِعجابا",35,"ب",2,0],["لا يُمهِلُ الظَبيَ عَلى أَقدارِهِ","حَتّى يُرى بَينَ شَبا أَظفارِهِ",36,"ر",2,0],["لا يمنعنّك زاجرٌ","مِن نيكِ أُنثى أو ذكَر",37,"ر",1,0],["لا يَمنَعُ المِلِكَ الجَبارَ مِن قَدَرٍ","يُغَيِّرُ الحالَ ما أَجدى وَما جاسا",38,"س",2,0],["لا يمّحي من الجميل ما رسمْ","ولا يزول في القبيح ما وسمْ",39,"م",1,0],["لا يَمْلِكُ النَّظْرَةَ الْعَجْلاءَ صَاحِبُهَا","حَتَّى تَمُرَّ بِعِطْفَيْهِ فَتُحْتَبَلُ",40,"ل",1,0],["لا يَملِكُ الناسُ بِالهَدايا","مِن بَعدِ عبد الغَنِيِّ رِقّي",41,"ي",1,0],["لا يموت الحق مهما لطمت","عارضيه قبضة المغتصب",42,"ب",1,0],["لا يمتطي المجدَ من لم يركبِ الخطرا","ولا ينال العلا من قدَّم الحذَرَا",43,"ر",2,1],["لايُمنَّن عليكم مادحٌ","بمديح فيه وعشيٌ وَضَنه",44,"ن",2,0],["لا يُمكن المَدّاح عَنكَ تَخلفٌ","وَصِفات ذاتِكَ صَيقل الإِفهام",45,"م",1,1],["لا يمستنكرٍ إذا مِتُّ شوقاً","كم محبٍّ من قبلُ ماتَ بدائِهْ",46,"ا",3,0],["لا يُمتَرَى في فَضلِهِ لا تَمتَرِ","مَن رَامَهُ بالذَّمِّ فَهوَ المُفتَرِى",47,"ر",2,0],["لا يملكونَ إذا استبيح حريمهم","إلا الصراحَ بدعوةِ المظلومِ",48,"م",1,0],["لا يَمنَعَنَّكَ مِن حَقٍّ تَقومُ بِهِ","أَيدٍ تَصولُ وَلا سَلقٌ بَأَصواتِ",49,"ت",1,1],["لا يملك المعشوق صب","راً عن حين ملكتَ صبركْ",50,"ك",1,0],["لا يملِك الفارسُ المغوارُ شِدتهُ","ولا بسالَته إلا بمركوبِ",51,"ب",1,0],["لأىِّ مَرمىً تَزجُرُ الأيانِقا","إن جاوزتْ نجدا فلستَ عاشقا",52,"ق",2,1],["لا يُمسِكُ الدِينارَ إِلّا رَيثَما","يَلقى اِبنَ نَيلٍ لَم يُلاقِ مُنيلا",53,"ل",2,0],["لا يماري أحدا ما","عاش في قال وقيل",54,"ل",1,0],["لائم لامني أطال التعدّي","لم يرد بالملام إذ لام رشدي",55,"ي",1,1],["لا يَملّون غارةً وقتالا","سَلّموهُ الأرواحَ والأموالا",56,"ل",2,0],["لا يَمنَعُ الناسَ ما أَعطى الَّذينَ هُمُ","لَهُ عِبادٌ وَلا يُعطَونَ ما مَنَعا",57,"ع",2,0],["لا يمددُ الدهرُ بعدَ اليومِ لي يدَهُ","فما سوى الهمِّ أمسى بينَ أيدينا",58,"ن",2,0],["لا يَموتُ الفَيّاضُ وَالشِعرُ حَيٌّ","وَعَلى البُؤسِ بَسمَةٌ لِلثُغورِ",59,"ر",1,0],["لا يَموتُ الفَيّاضُ ما دامَت الأَر","واحُ تَهتَزُّ لاِختِلاجِ الصَريرِ",59,"ر",1,0],["لا يَملِكُ الرُوّاضُ مِن","عِنانِهِ إِذا جَمَح",60,"ح",1,0],["لائمي لا،لا تعاتبْ","لو بَدا هَمُّ الكئيبِ!",61,"ب",1,0],["لا يملكونَ دفاعاً في خصاصَتِهم","وينصرونَ الفرنسيسَ الملاعينا",62,"ن",2,0],["لائِمِي فِي الْحُبِّ وَيْحَكَ لَوْ","ذُقْتَ طَعْمَ الْحُبِّ لَمْ تَلُمِ",63,"م",1,0],["لا يَمْنَحُ الإِحْسانَ إِلاّ شامِلاً","خَيْرُ الْحَيا ما عَمَّ مِنْهُ وَطَبَّقا",64,"ق",2,0],["لا يُمْطِرُ الأَعْداءَ عارِضُ بَأْسِهِ","إِلاّ إِذا بَرْقُ الصَّوارِمِ أَوْمَضا",65,"ض",2,0],["لا يَمْنَعَنَّكَ مِنْ يَدٍ والَيْتَها","أَنِّي بِشكْرِ صَنِيعهِا لَمْ أَنْهَضِ",66,"ض",1,0],["لا يَمْنَعَنَّكَ مِنْ أَمْرٍ مَخافَتُهُ","لَيْسَ الْعُلى النَفِيسِ يَكْرَهُ الْعَطَبا",67,"ب",2,0],["لا يمزجُ الراحَ إذا صبَّها","في الكأس إلّا مِن لَماه البَرود",68,"د",1,0],["لا يَمنع الصبَّ وَعداً حين يسأَلُه","لكنَّه ربَّما عزَّت منائحُهُ",69,"ح",2,0],["لا يَمزجُ الكأسَ الّا من مَراشفِه","فاِطرب لما شِئتَ من خمرٍ ومن ضَرَبِ",70,"ب",1,0],["لا يَمتَري في مَعاليكم أخو بصرٍ","وَلا يُماري بها ذو نهية فهمُ",71,"م",1,0],["لا يَمتَطي الدنيا إِلى الأخرى سوى","ثقفٍ بملك عنانها يستضلعُ",72,"ع",1,0],["لائَمي في تَهَتُّكي جُد عَلى القَل","بِ بِصَبرٍ أَو فَاِقبَلِ الأَعذارَ",73,"ر",1,0],["لا يَمتَطي صَهوات الرأي غَير فَتى","يولي العَواقب زِنداً مِنهُ مُقتَدحا",74,"ح",2,0],["لا يَمنَعُ النَاسُ مِنّي ما أَرَدتُ وَلا","أُعطيهُمُ ما أَرادوا حَسنَ ذا أَدَبا",75,"ب",2,1],["لا يملأُ العينَ منه نظْرةً أحدٌ","ويَملأُ الأرضَ منْ عدلٍ وإحْسان",76,"ن",1,0],["لا يَمنعَنَّ كثيرُ ما أُوتيتَهُ","لقليلِ ما أَهدَيْتُ أن تَتقَبّلا",77,"ل",2,0],["لا يَمْهِلُ الدّاءَ إلا ريْثَ يَحسِمُه","والحزْمُ في نَزْعِ نابِ الشرِّ حين سَطا",78,"ط",2,0],["لا يُمَلُّ الوَردُ فِي وَجنَتِهِ","وَقُصَارَى كُلِّ وَردٍ أَن يُمَل",79,"ل",1,0],["لا يَمْنَعَنَّكَ مِنْ بُغاء","الخير تَعقادُ التمائمْ",80,"م",1,1],["لا يملُّ العَذابَ فيك معنّى","نُصحاً وسواك الَّذي يَملُّ ويُقلى",81,"ل",2,0],["لا يُمتَرى في أنها تمترى","أخلافَ نُعماها وتُمْتارُ",82,"ر",1,0],["لا يمنع الموت حجّاب ولا زَرَدُ","ولا المواضي ولا العادية الجرد",83,"د",1,1],["لا يملك العالم لنفسه نقيرا ولا فتيلا إن هم","إلا كالأنعام بل هم أضل سبيلا",84,"ل",2,0],["لا يمنع الموت جيش جحفل لجب","وليس تردعه بيض وسمر قنا",85,"ن",2,0],["لائم بعد لائم لك منهم","وعلى الرغم تنشرين الوئام",86,"م",1,0],["لا يملِكُ الغِرِّيد إطرابَه","شجواً ولا نشوتَه للمدامْ",87,"م",1,0],["لا يملك الرحلُ أكلَ غاربِه","ولا يعفِّي أوبارَهُ الجلَمُ",88,"م",1,0],["لا يَمسُّ الأرضَ إلا غلطاً","غيرَ أن يُعلِقَ بالترب نعالَهْ",89,"ل",2,0],["لا يمنع البطلَ المشهّر نفسَه","حتى يهُبَّ فيقنصَ الأبطالا",90,"ل",2,0],["لا يملك الناسُ عليكم إمرةً","كنتم ملوكاً والأنامُ سُوَقا",91,"ق",2,0],["لا يملِكُ الراقدُ من أحلامِهِ","إلا كما يملك من ودادِها",92,"د",3,0],["لا يَملكُ الحفظُ عليه أمرَهُ","ولا تُفرِّي حِلمَه الشدائدُ",93,"د",1,0],["لا يمدح الناسَ ولكن مدحُكم","يَلزَمُ في دِين العلا ويجبُ",94,"ب",1,0],["لا يُمرَجُ العَيشُ بِمِثلِ مَرجِهِ","حَتّى إِذا اللَيلُ بَدا مِن فَجِّهِ",95,"ج",2,0],["لا يمكُثُ الجُّودُ إِلاَّ في أَماكِنِهِمْ","ولا يُوازيهُمُو آلٌ ولو عَظُموا",96,"م",3,0],["لا يَمزجُ الشَّك مِنهُم صَفوَ مُعتَقَدٍ","وَلا يَشين التُّقى بِاللمِّ وَاللَّمَمِ",97,"م",1,0],["لا يَملُّ الإرمامَ إنْ وادعوه","وأخو طَيْشةٍ إذا هو رِيعا",98,"ع",2,0],["لا يُمطرُ السُّمر غداةَ الوغى","إلّا بِرشِّ الدّمِ إنْ أمطرا",99,"ر",2,0],["لا يَمنَعَنَّكَ خَفضَ العَيشِ في دِعَةٍ","نُزوعُ نَفسٍ إِلى أَهلٍ وَأَوطانِ",100,"ن",1,1],["لا يُمكِنُ الطَرفَ مِنهُ أَن يُحيطَ بِهِ","ما يَأخُذُ السَهلُ مِن عُرضَيهِ وَالجَبَلُ",101,"ل",1,0],["لا يَمنَعُ العُرفُ مِن إِلحاحِ طالِبِهِ","وَلا يُقَرِّبُ مِنهُ رِفقُ مُتَّئِدِ",102,"د",1,0],["لا يميلون للعقول ولا ما","أنتجته العقول فيما تجيد",103,"د",1,0],["لا يُمسِكُ العبدُ من حاجاتهِ بيدٍ","ما لم تُساعِدْهُ من أمرِ القديرِ يَدُ",104,"د",1,0],["لا يَمنَعُ البعدُ جَدواها وشُهرتهَا","إنّ الدَرارِي إلينا ضَوْءها يَصِلُ",105,"ل",1,0],["لا يَمْنَعَنَّكَ شُرْبَها","شهرُ المحرَّم أَو رجب",106,"ب",1,0],["لأَيِّ مَعْنَى كَسَرْتَ قَلْبي","وَما التَقَى فيهِ سَاكِنَانِ",107,"ن",1,0]]}