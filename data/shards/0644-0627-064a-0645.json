ps://www.poetsgate.com/ViewPoem.aspx?id=199845",""],[4578,"بالله نحوي بأعطاف اللقا ميلوا","https://www.poetsgate.com/ViewPoem.aspx?id=49504",""],[4858,"مصير الصحفي","https://www.poetsgate.com/ViewPoem.aspx?id=29942",""],[4858,"صبراً أُخَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=29944",""],[4929,"تنقيب عن معدن الكرامة في صحراء الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=199178",""],[4978,"رد على قصيدة لِمنْ أغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=177244",""],[4984,"عصر جديد","https://www.poetsgate.com/ViewPoem.aspx?id=190544",""],[5020,"أسعد الصّبّ يا حكم","https://www.poetsgate.com/ViewPoem.aspx?id=201046",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[5115,"دعوى سلامة قلبي في الهوى عجب","https://www.poetsgate.com/ViewPoem.aspx?id=189290",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5325,"بصادق الجد بيت المجد يرتفع","https://www.poetsgate.com/ViewPoem.aspx?id=171977",""],[259,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=180839",""],[1149,"قَدْ عِشْتُ في الدّهرِ ألواناً عَلَى خُلُقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22288",""],[5431,"القصيدة الكونية ..وثقبُ الكون سبّاقُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199015",""],[5442,"أيها السائل الذي رزق التوفيق","https://www.poetsgate.com/ViewPoem.aspx?id=114767",""],[5493,"عزوف القلب","https://www.poetsgate.com/ViewPoem.aspx?id=199529",""],[5574,"صهيل الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=206031",""],[4480,"نعم القتيل إذا الرياح تناوحت","https://www.poetsgate.com/ViewPoem.aspx?id=18227",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[5596,"الأمل والصدى","https://www.poetsgate.com/ViewPoem.aspx?id=205464",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5691,"ضياغم بيْتا","https://www.poetsgate.com/ViewPoem.aspx?id=206209",""],[5829,"صونوا البنات","https://www.poetsgate.com/ViewPoem.aspx?id=157071",""],[5956,"أحس عينيها تقولان لي:‏","https://www.poetsgate.com/ViewPoem.aspx?id=182192",""],[5956,"متوسّم فيه السموَّ إلى الذرى","https://www.poetsgate.com/ViewPoem.aspx?id=193978",""],[5956,"في عمق وادي الحُسْن","https://www.poetsgate.com/ViewPoem.aspx?id=196805",""],[6031,"إِنَّا إِذَا جَارَ الزَّمانُ وَسَامَنا","https://www.poetsgate.com/ViewPoem.aspx?id=46270",""],[6286,"برقُ الحِمى لاحَ مُجتازاً على الكثُب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27555&r=&rc=4",""],[572,"يا أَيُّها الصَّلِفُ المدلُّ بِحُسْنِهِِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9224&r=&rc=81",""]],"verses":[["لا يُمسِكُ العَذلُ يَدَيهِ وَلا","تَأخُذُ مِنهُ سَورَةُ الخَمرِ",0,"ر",1,0],["لا يَمْنَحُ الْعِيشَةَ مِن بَالِهِ","إِنْ يَدْنُ فِيهَا الْهَمُّ أَدْنَى اهْتِمَامْ",1,"م",1,0],["لا يموت الندى ولا الجود ما عا","ش أبانٌ غِياث ذي الأنفاض",2,"ض",1,0],["لائمي إنَّ في الضنا ليَ عذراً","كلَّما اشتقت أهل وادِي الأراك",3,"ك",1,0],["لائميه على المكارمِ كفُّوا","إنَّ للصبِّ بالصبابة شغلا",4,"ل",2,0],["لا يمنع الري طالبيه ولا","يسقي نديماً له على تأق",5,"ق",1,0],["لا يُمنَّنَّ عليكم مادحٌ","بمديح فيه وشيٌ وَضَنه",6,"ن",2,0],["لا يمنع المسكينَ من نيكها","يا ليتني بعضُ مساكينه",7,"ن",2,0],["لا يمنعون الماءَ عند وروده","غُلل السُقاةِ ولا السّناة إذا سنَوا",8,"ن",3,0],["لأيِّ معنىً تخيَّرُوه","وكلُّ عيب له وفيهِ",9,"ه",1,0],["لا يَملَءُ السِربالَ واحِدُهُم","وَلَهُ وُعودٌ تَملَءُ البَلَدا",10,"د",2,0],["لا يَملُكُ الإِنسانَ فيها نَفسَهُ","حَتّى يُرَوِّعُهُ ضَجيجُ قِطارِ",11,"ر",1,0],["لا يَملِكونَ سِوى التَحَسُّرِ إِنَّهُ","جَهدُ الضَعيفِ الواجِدِ المَفلوكِ",12,"ك",1,0],["لِأَيِّما أَمرٍ يَعيشُ الوَرى","لِأَيِّما أَمرٍ يَموتُ الأَنام",13,"م",1,0],["لا يَمدَحُ الوَردَ إِنسانٌ يَقولُ لَهُ","يا وَردُ إِنَّكَ ذو عِطرٍ وَتَلوينِ",14,"ن",1,0],["لا يُمكِنُهُ الكَلامُ لَكِن","قَد حَمَّلَ طَرفَهُ رَسائِل",15,"ل",1,0],["لا يملكنك من غد بعد الردى","خوف فيوم الهالكين بلا غد",16,"د",1,0],["لا يموت الذي يعيش بآثا","ر له في مصانع قد بنينا",17,"ن",2,0],["لا يموت الذي يعظمه التأ","ريخ بعد القرون تقفو القرونا",17,"ن",2,0],["لا يموت الذي توفق ان يعلن","ما كان سره مكنونا",17,"ن",2,0],["لا يمشينّ السلحفا","ء وغيره للمجد طائر",18,"ر",1,0],["لا يَملكُ الإِنسانُ مِن أَحوالِهِ","ما تَملكُ الأَقدارُ مَهما قَدَّرا",19,"ر",2,0],["لا يَميلونَ إِلى البَغيِ بِها","كَيفَ يَبغي مَن إِلى العِلمِ اِنتَسَب",20,"ب",1,0],["لا يَمنَعَنَّكُمُ بِرُّ الأُبُوَّةِ أَن","يَكونَ صُنعُكُمُ غَيرَ الَّذي صَنَعوا",21,"ع",3,0],["لائمٌ لي بجهلِهِ ولماذا","أنا وَحْدِي أَحْبَبْتُ ثُمَّ قَتَلْتُ",22,"ت",1,0],["لا يَملِكُ الطَرِبُ المَحزونُ مَنطِقَهُ","وَدَمعَهُ وَهُما في قَبضَةِ الطَرَبِ",23,"ب",1,0],["لا يَميلُ الهَوى بِهِ حينَ يُمضي ال","أَمرَ بَينَ المَقلِيِّ وَالمَودودِ",24,"د",1,0],["لا يَمنَعونَ لَهُم حَرامَ حَليلَةٍ","بِمَهابَةٍ مِنهُم وَلا بِقِتالِ",25,"ل",1,0],["لا يمينٌ يجيرنا أو يسارٌ","تحت حد السكين نحن سواء",26,"ا",2,0],["لا يَمتَطي المَجدَ مَن لَم يَركَبِ الخَطَرا","وَلا يَنالُ العُلى مَن قَدَّمَ الحَذَرا",27,"ر",2,1],["لا يُمَلّ الحديثُ منها مُعَاداً","كانتشاقِ الهواء ليس يُمَلُّ",28,"ل",1,0],["لا يملكُ النّفسَ إلا أن يُؤخِرَها","مَنْ أمرُه الأَمْرُ في أخذٍ وتَأْخيرِ",29,"ر",1,0],["لا يَملِكونَ لَها رَدّاً إِذا اِنبَعَثَت","وَلا يُطيقونَ إِلّا المَوتَ وَالهَرَبا",30,"ب",2,0],["لا يَملِكونَ إِذا الكُماةُ تَدافَعَت","في غَمرَةٍ خَوَراً وَلا اِستِسلاما",31,"م",2,0],["لا يملكون لأهليهم وأنفسهم","إلا العذاب وإلا الظنَّ والأملا",32,"ل",2,0],["لا يَمتَطي حِفظاً وَلا يُمسي لَهُ","طَرَفٌ بِمِروَدِ رَقدَةٍ مَكحولا",33,"ل",2,0],["لا يَملَءُ الرِزقُ المُنى","فَالحَيُّ ذو حَسَراتِ",34,"ت",1,0],["لا يَمَلُّ النَثرَ لافِظُهُ","مُفتَنٌ يُعجَبُ إِعجابا",35,"ب",2,0],["لا يُمهِلُ الظَبيَ عَلى أَقدارِهِ","حَتّى يُرى بَينَ شَبا أَظفارِهِ",36,"ر",2,0],["لا يمنعنّك زاجرٌ","مِن نيكِ أُنثى أو ذكَر",37,"ر",1,0],["لا يَمنَعُ المِلِكَ الجَبارَ مِن قَدَرٍ","يُغَيِّرُ الحالَ ما أَجدى وَما جاسا",38,"س",2,0],["لا يمّحي من الجميل ما رسمْ","ولا يزول في القبيح ما وسمْ",39,"م",1,0],["لا يَمْلِكُ النَّظْرَةَ الْعَجْلاءَ صَاحِبُهَا","حَتَّى تَمُرَّ بِعِطْفَيْهِ فَتُحْتَبَلُ",40,"ل",1,0],["لا يَملِكُ الناسُ بِالهَدايا","مِن بَعدِ عبد الغَنِيِّ رِقّي",41,"ق",2,0],["لا يموت الحق مهما لطمت","عارضيه قبضة المغتصب",42,"ب",1,0],["لا يمتطي المجدَ من لم يركبِ الخطرا","ولا ينال العلا من قدَّم الحذَرَا",43,"ر",2,1],["لا يملأ السربال واحدهم","وله وعود تملأ البلدا",44,"د",2,0],["لايُمنَّن عليكم مادحٌ","بمديح فيه وعشيٌ وَضَنه",45,"ن",2,0],["لا يُمكن المَدّاح عَنكَ تَخلفٌ","وَصِفات ذاتِكَ صَيقل الإِفهام",46,"م",1,1],["لا يمستنكرٍ إذا مِتُّ شوقاً","كم محبٍّ من قبلُ ماتَ بدائِهْ",47,"ا",3,0],["لا يُمتَرَى في فَضلِهِ لا تَمتَرِ","مَن رَامَهُ بالذَّمِّ فَهوَ المُفتَرِى",48,"ر",2,0],["لا يملكونَ إذا استبيح حريمهم","إلا الصراحَ بدعوةِ المظلومِ",49,"م",1,0],["لا يَمنَعَنَّكَ مِن حَقٍّ تَقومُ بِهِ","أَيدٍ تَصولُ وَلا سَلقٌ بَأَصواتِ",50,"ت",1,1],["لا يملك المعشوق صب","راً عن حين ملكتَ صبركْ",51,"ك",1,0],["لا يملِك الفارسُ المغوارُ شِدتهُ","ولا بسالَته إلا بمركوبِ",52,"ب",1,0],["لأىِّ مَرمىً تَزجُرُ الأيانِقا","إن جاوزتْ نجدا فلستَ عاشقا",53,"ق",2,1],["لا يُمسِكُ الدِينارَ إِلّا رَيثَما","يَلقى اِبنَ نَيلٍ لَم يُلاقِ مُنيلا",54,"ل",2,0],["لا يماري أحدا ما","عاش في قال وقيل",55,"ل",1,0],["لائم لامني أطال التعدّي","لم يرد بالملام إذ لام رشدي",56,"د",2,1],["لا يَملّون غارةً وقتالا","سَلّموهُ الأرواحَ والأموالا",57,"ل",2,0],["لا يَمنَعُ الناسَ ما أَعطى الَّذينَ هُمُ","لَهُ عِبادٌ وَلا يُعطَونَ ما مَنَعا",58,"ع",2,0],["لا يمددُ الدهرُ بعدَ اليومِ لي يدَهُ","فما سوى الهمِّ أمسى بينَ أيدينا",59,"ن",2,0],["لا يَموتُ الفَيّاضُ وَالشِعرُ حَيٌّ","وَعَلى البُؤسِ بَسمَةٌ لِلثُغورِ",60,"ر",1,0],["لا يَموتُ الفَيّاضُ ما دامَت الأَر","واحُ تَهتَزُّ لاِختِلاجِ الصَريرِ",60,"ر",1,0],["لا يَملِكُ الرُوّاضُ مِن","عِنانِهِ إِذا جَمَح",61,"ح",1,0],["لائمي لا،لا تعاتبْ","لو بَدا هَمُّ الكئيبِ!",62,"ب",1,0],["لا يملكونَ دفاعاً في خصاصَتِهم","وينصرونَ الفرنسيسَ الملاعينا",63,"ن",2,0],["لائِمِي فِي الْحُبِّ وَيْحَكَ لَوْ","ذُقْتَ طَعْمَ الْحُبِّ لَمْ تَلُمِ",64,"م",1,0],["لا يَمْنَحُ الإِحْسانَ إِلاّ شامِلاً","خَيْرُ الْحَيا ما عَمَّ مِنْهُ وَطَبَّقا",65,"ق",2,0],["لا يُمْطِرُ الأَعْداءَ عارِضُ بَأْسِهِ","إِلاّ إِذا بَرْقُ الصَّوارِمِ أَوْمَضا",66,"ض",2,0],["لا يَمْنَعَنَّكَ مِنْ يَدٍ والَيْتَها","أَنِّي بِشكْرِ صَنِيعهِا لَمْ أَنْهَضِ",67,"ض",1,0],["لا يَمْنَعَنَّكَ مِنْ أَمْرٍ مَخافَتُهُ","لَيْسَ الْعُلى النَفِيسِ يَكْرَهُ الْعَطَبا",68,"ب",2,0],["لا يمزجُ الراحَ إذا صبَّها","في الكأس إلّا مِن لَماه البَرود",69,"د",1,0],["لا يَمنع الصبَّ وَعداً حين يسأَلُه","لكنَّه ربَّما عزَّت منائحُهُ",70,"ح",2,0],["لا يَمزجُ الكأسَ الّا من مَراشفِه","فاِطرب لما شِئتَ من خمرٍ ومن ضَرَبِ",71,"ب",1,0],["لا يَمتَري في مَعاليكم أخو بصرٍ","وَلا يُماري بها ذو نهية فهمُ",72,"م",1,0],["لا يَمتَطي الدنيا إِلى الأخرى سوى","ثقفٍ بملك عنانها يستضلعُ",73,"ع",1,0],["لائَمي في تَهَتُّكي جُد عَلى القَل","بِ بِصَبرٍ أَو فَاِقبَلِ الأَعذارَ",74,"ر",1,0],["لا يَمتَطي صَهوات الرأي غَير فَتى","يولي العَواقب زِنداً مِنهُ مُقتَدحا",75,"ح",2,0],["لا يَمنَعُ النَاسُ مِنّي ما أَرَدتُ وَلا","أُعطيهُمُ ما أَرادوا حَسنَ ذا أَدَبا",76,"ب",2,1],["لا يملأُ العينَ منه نظْرةً أحدٌ","ويَملأُ الأرضَ منْ عدلٍ وإحْسان",77,"ن",1,0],["لا يَمنعَنَّ كثيرُ ما أُوتيتَهُ","لقليلِ ما أَهدَيْتُ أن تَتقَبّلا",78,"ل",2,0],["لا يَمْهِلُ الدّاءَ إلا ريْثَ يَحسِمُه","والحزْمُ في نَزْعِ نابِ الشرِّ حين سَطا",79,"ط",2,0],["لا يُمَلُّ الوَردُ فِي وَجنَتِهِ","وَقُصَارَى كُلِّ وَردٍ أَن يُمَل",80,"ل",1,0],["لا يَمْنَعَنَّكَ مِنْ بُغاء","الخير تَعقادُ التمائمْ",81,"م",1,1],["لا يملُّ العَذابَ فيك معنّى","نُصحاً وسواك الَّذي يَملُّ ويُقلى",82,"ل",2,0],["لا يُمتَرى في أنها تمترى","أخلافَ نُعماها وتُمْتارُ",83,"ر",1,0],["لا يمنع الموت حجّاب ولا زَرَدُ","ولا المواضي ولا العادية الجرد",84,"د",1,1],["لا يملك العالم لنفسه نقيرا ولا فتيلا إن هم","إلا كالأنعام بل هم أضل سبيلا",85,"ل",2,0],["لا يمنع الموت جيش جحفل لجب","وليس تردعه بيض وسمر قنا",86,"ن",2,0],["لائم بعد لائم لك منهم","وعلى الرغم تنشرين الوئام",87,"م",1,0],["لا يملِكُ الغِرِّيد إطرابَه","شجواً ولا نشوتَه للمدامْ",88,"م",1,0],["لا يملك الرحلُ أكلَ غاربِه","ولا يعفِّي أوبارَهُ الجلَمُ",89,"م",1,0],["لا يَمسُّ الأرضَ إلا غلطاً","غيرَ أن يُعلِقَ بالترب نعالَهْ",90,"ل",2,0],["لا يمنع