{"poems":[[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[91,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[291,"","https://poetry.dctabudhabi.ae/diwan/poem/48479","الخفيف"],[1947,"","https://poetry.dctabudhabi.ae/diwan/poem/178105","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128231","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216617","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205920","الرمل"],[5956,"أعاتب العصفور","https://www.poetsgate.com/ViewPoem.aspx?id=183460",""]],"verses":[["إنْ تائهٌ جَبَهَ الوجوهَ ببشرِهِ","ولُهَى يديهِ فليس بالجَبَّاه",0,"ه",1,0],["إن تأييد نهضة العلم مجد","فاز سعدٌ بهِ فلله سعدُ",1,"د",1,1],["أَنْتَ أَيْضاً إِذَا وَلِيْتَ","فَلا تُكْثِرْ الصَّلَفْ",2,"ف",1,0],["أنت أيدت بالخلافة ركن ال","شرع فارتد نهجه مستقيما",3,"م",2,0],["أنت أيوب حين صابرت أمرا","رجت الأرض منه حزنا وسهلا",4,"ل",2,0],["أنت أيضاً يا مغني لا تنم","قم واذهب عن فؤادي كلّ غم",5,"م",1,0],["انت ايقنت من مغبة قوم","تبعوه فلا تكن في ارتياب",6,"ب",1,0],["أنت أيقظتَ لهم تاريخهم","وهو في نومته لا يستفيق",7,"ق",1,0],["أنت أيضاً كحبيبي تزدريني","لستَ مَعْنِيّا بتاتاً في شؤوني",8,"ن",2,1]]}