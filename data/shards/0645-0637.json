"وَجَعجَعَ بِالبَيداءِ حَسرى وَظُلَّعا",4,"ع",2,0],["مَطبوعَةٌ عَلى العُلى لَو رَضِيَت","بِالذُلِّ يَوماً أَنكَرَت طِباعَها",5,"ع",3,0],["مَطرَحَ الشَنَّةِ قَد أَيبَسَها","قِدَمُ العَهدِ بِعامِيِّ الأَقَط",6,"ط",1,0],["مُطَرَّقَةُ الجالَينِ هَطلى كَأَنَّما","إِزارُ الفَتى فيها مِنَ الدَمِّ وارِسُ",7,"س",1,0],["مُطرِقاً إِطراقَ مَأمونِ الشَذا","غَمَرَ النادِيَ حِلماً وَوَقارا",8,"ر",2,0],["مُطَهَّرُ القَلبِ لا اِنهَلَّت مَدامِعُهُ","وَجداً وَما حَقَّرَ الأَنفاسَ تَصعيدُ",9,"د",1,0],["مَطاعينُ والهَيْجاءُ تُغْشى غِمارُها","مَطاعيمُ والغَبْراءُ تُخْشى مُحولُها",10,"ل",3,0],["مِطْعامُ مَسْغَبَةٍ إنْ ضنّ صوْبُ حَيا","مِطْعانُ هيْجاءَ لا جُبْناً ولا بَخِلا",11,"ل",2,0],["مُطَهّمَةً جُرداً لها منْ دَمِ العِدَى","شِياتٌ ومنْ نسْجِ القَتامِ البَراقِعُ",12,"ع",1,0],["مطيّةُ توفيقٍ منَ السّعْدِ جُلُّها","وحِلْيَتُها الدُّرُّ المرصّعُ والتِّبْرُ",13,"ر",1,0],["مطْلُ الغَني ظُلمٌ ففِيمَ ظلَمْتَني","ولوَيْتَ دَيْني عنْ وُجودِ يَسارِ",14,"ر",1,0],["مَطارِدُ فُرْسانٍ ومَجْرَى سَوابِحٍ","ومَكْنِسُ غِزْلان وغابَةُ ذي لِبْدِ",15,"د",1,0],["مَطالِعُ سَعدٍ أَم مَطالِعُ أَقمارِ","تَجَلَّت بِهَذا العيدِ أَم تِلكَ أَشعاري",16,"ي",1,1],["مَطَوتُ بِهِم حَتّى تَكِلَّ مَطِيُّهُم","وَحَتّى الجِيادُ ما يُقَدنَ بِأَرسانِ",17,"ن",1,0],["مُطعِمٌ لِلصَيدِ لَيسَ لَهُ","غَيرُها كَسبٌ عَلى كِبَرِه",18,"ر",2,0],["مطرز البرد إذا ذقته","ألهى عن المنظر بالمخبر",19,"ر",1,0],["مُطَهَّرُو الإِيمَانِ مِنْ شُبْهَةٍ","مُنَزَّهُو الصَّبْوَةِ عَنْ كُلِّ ذَامْ",20,"م",1,0],["مُطَهَّرَ الشيمَةِ مِنْ رِيبَةٍ","مُطَهَّرَ السيرَةِ مِنْ مَأْثَمِ",21,"م",1,0],["مطالع آياتٍ مثابة رحمةٍ","معاهد أملاك مظاهر إيمانِ",22,"ن",1,0],["مُطِلَ الدُيونُ فَلا يَزالُ مُطالِبٌ","يَرجو القَضاءَ وَما وَعَدنَ ضِمارُ",23,"ر",1,0],["مَطاعيمُ الشَمالِ إِذا اِستُحِنَّت","وَفي عُرَواءِ كُلِّ صَباً عَقيمِ",24,"م",1,0],["مُطَوَّقَةً تَرَنَّمُ فَوقَ غُصنٍ","إِذا ما قُلتُ مالَ بِها اِستِقاما",25,"م",2,0],["مَطَاعِيمُ حِينَ تَرُوحُ الشَّمَالُ","بِشَفَّانَ قِطقِطِها الأَشهَبٍ",26,"ب",1,0],["مطاعيم حتى تروح الشمال","بشفان قطقطها الاشهب",27,"ب",1,0],["مُطيعٌ لِأَمرِ اللَهِ بِالحَقِّ عارِفٍ","بَعيدُ الأَنامِ عِندَهُ لَقَريبُ",28,"ب",1,0],["مُطَّهَرٌ تَركَبُ السَفينَ وَقَد","أَلجَمَ نِسراً وَأَهلَهُ الغَرَقُ",29,"ق",1,0],["مطمئنٌّ على الملامِ وعندِي","شغلٌ عن ملامه بانْزعاج",30,"ج",1,0],["مطهّر الذات مطويًّا على كرمٍ","ينسي عهودَ الغوادِي وهو مذكور",31,"ر",1,0],["مطاعين في الهيجا مطاعين في الورى","قريبين من رشدٍ بعيدين من خطا",32,"ط",2,0],["مطوَّق بهباتٍ ساجعٌ بثناً","ينسي الأوائل ما جادوا وما سجعوا",33,"ع",3,0],["مطابق الوصف فوق النجم موضعه","والجود يدنيه قيس الكفّ للأمل",34,"ل",1,0],["مطالعٌ بنجومِ السعد حاليةٌ","على حمًى ببدورِ الفضل مجلال",35,"ل",1,0],["مطيل يرجي أن تحلّ عقودنا","فيا عجباً من ناقض الحبل مبرَم",36,"م",1,0],["مطل الفتى عار وحا","شاكَ من تبيانه",37,"ن",2,0],["مطوَّقةٍ تبكي ولم أرَ قبلها","بدا ما بدا من شجوها لم تسلَّب",38,"ب",1,0],["مطايبُ عيشٍ زايلَتْهُ مخابِثُهْ","ومُقْبِلُ حظٍّ أطلقْته رَوائِثُهْ",39,"ث",2,1],["مطَّرحُ الشعرِ في مدائحه","وفي الأهاجيِّ غير مطّرحِ",40,"ح",1,0],["مَطَّ للْخَصمْ جبيناً","كجبين الأيْرِ صَلْدا",41,"د",2,0],["مطالع الحق ما من شُبهة غَسَقَتْ","إلا ومنهم لديها كوكبٌ يَقِدُ",42,"د",1,0],["مُطيِّبي كلِّ تربةٍ خَبثتْ","ومؤنسيها بشرّ مجتوَرِ",43,"ر",1,0],["مطرتَ وقد أيبستُ حتى بللتني","فعُوديَ ليْن المتن غيرُ هصيرِ",44,"ر",1,0],["مُطعّمٌ طيباتِ العيش تأكلها","والصوم لا شك متبوع بإفطار",45,"ر",1,0],["مطلبه كالمغاص في دَرك ال","لجَّة من دون دُرها خطر",46,"ر",1,0],["مُطَّرَحاً حقّ من يلوذ به","إلا المُنى أو كواذبَ العِذر",47,"ر",1,0],["مطيعين أهواءً توافت على هوى","فلو أُرسلت كالنبل لم تعدُ موقعا",48,"ع",2,0],["مطرَّفُ أطرافِ الجناحِ كأنَّه","بنانُ عروسٍ بالخضاب تقَمَّعا",49,"ع",2,0],["مِطالٌ منك قد أضنى اصطباري","وظلمٌ منك قد أفنى احتيالي",50,"ي",1,0],["مطلتَ مطال النخل فاثبتْ ثباتَهُ","وأجنِ جَناه أو فدعْ نكدَ النخْلِ",51,"ل",1,0],["مُطَّرِحَ الأصدقاء مرتفعَ ال","همَّة عنهم تراهُمُ قُزُما",52,"م",2,0],["مُطَلَّبٌ بعطايا ما يُنهنهها","عذْل العواذِل طَلّابٌ بأوغامِ",53,"م",1,0],["مُطرِقاً يبحثُ الرّوي عن الظَّمْ","آنِ من عانِكٍ رُكام هيام",54,"م",1,0],["مطبوعةً مصنوعةً","تختال في الحقل الضَّموم",55,"م",1,0],["مُطفِلاتٌ وما حملن جنيناً","مرضعاتٌ ولسن ذات لَبانِ",56,"ن",1,0],["مُطلِعٌ من جَيبه شَمْ","ساً بدت في يوم دَجْن",57,"ن",1,0],["مَطاعيمُ لِلضَّيفِ حينَ الشِتا","ءِ قُبُّ البُطونِ كَثيرو الفَجَر",58,"ر",1,0],["مُطافيلَ أَبكارٍ حَديثٍ نِتاجُها","تُشابُ بِماءٍ مِثلَ ماءِ المَفاصِلِ",59,"ل",1,0],["مُطَأطَأَةً لَم يُنبِطوها وَإِنَّها","لَيَرضى بِها فُرّاطُها أُمَّ واحِدِ",60,"د",1,0],["مَطاعيمُ تَغدو بِالعَبيطِ جِفانُهُم","إِذا القُرُّ أَلوَت بِالعِضاهِ عَصائِبُه",61,"ب",2,0],["مُطِلّاً عَلى أَعدائِهِ يَزجُرونَهُ","بِساحَتِهِم زَجرَ المَنيحِ المُشَهَّرِ",62,"ر",1,0],["مُطرِبٌ في صَنعَةِ الأَل","حانِ وَالضَربِ عَليمُ",63,"م",1,0],["مَطَلَ الزَمانُ بِهِ زَماناً أَنفُساً","أَنِفَت وَعادَ لَها إِلى عاداتِهِ",64,"ت",2,0],["مُطرِقٌ يَرشُح مَوتاً كَما","أطرَقَ أَفعى يَنفُثُ السمَّ صِلُّ",65,"ل",1,0],["مَطِيَّةَ مَشعوفَينِ أَفنى عَريكَها","رَواحُ الهِبِلِّ حينَ تَحمى الظَهائِرُ",66,"ر",1,0],["مُطرِقاً يَخْبُطُ في الصحراءِ مَكْبوحَ الشَّكاةْ","تُهْتَ في الدُّنيا وما أُبْتَ بغيرِ الحَسَراتْ",67,"ت",1,0],["مطران أعطيت المكارم حقها","ورغبتُ في مائة فجدتَ بضعفها",68,"ف",3,1],["مطويّة صُعُداً والجو ينشرها","منشورة صَبباً والجو يطويها",69,"ي",3,0],["مُطمَئِنّينَ نُفوساً كُلَّما","عَبَسَت كارِثَةٌ زادوا اِبتِساما",70,"م",2,0],["مُطرِبٌ مِنَ ال","لَحنِ مُنتَخَب",71,"ب",1,0],["مُطمَئِنّاً مِنَ الكَتائِبِ وَالكُت","بِ بِما يَنتَهي إِلَيهِ العَلاءُ",72,"ا",2,0],["مَطايا لا تَذِلُّ لِمَن عَلَيها","وَلا يَبغي لَها أَحَدٌ رُكوبا",73,"ب",2,0],["مُطاعَةُ اللَحظِ في الأَلحاظِ مالِكَةٌ","لِمُقلَتَيها عَظيمُ المُلكِ في المُقَلِ",74,"ل",1,0],["مَطَرَت سَحابُ يَدَيكَ رِيَّ جَوانِحي","وَحَمَلتُ شُكرَكَ وَاِصطِناعُكَ حامِلي",75,"ي",1,0],["مطروحة في الطريق هينة","ليس لها في النفوس مقدارُ",76,"ر",1,0],["مطلِّق خفضِ العيش كُرهاً مراجعٌ","من العيشِ رنق الوِرد مرّ المطاعمِ",77,"م",1,0],["مطاعينُ حيثُ الرمحُ يزحَمُ مثلَهُ","على حَلَقِ الدِّرع ازدحامَ الغرائبِ",78,"ب",1,0],["مُطالِبٌ بُغيَةً في كُلِّ مَكرُمَةٍ","مَرحولَةٌ لِتَقَصّيها رَكائِبُهُ",79,"ب",2,0],["مُطِرنا بِالشَما