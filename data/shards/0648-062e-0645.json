{"poems":[[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[85,"من صور السحر المبين عيونا","https://www.aldiwan.net/poem63011.html","الكامل"],[80,"ومسبلة دمعا يسوغ عذوبة","https://www.aldiwan.net/poem31529.html","الطويل"],[74,"وخميلة قد أخملت سربالها","https://www.aldiwan.net/poem13266.html","الكامل"],[52,"صحوت ولكن بعد أي فتون","https://www.aldiwan.net/poem26609.html","الطويل"],[52,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[48,"ألا فاسقني خمراً وقل لي هي الخمر","https://www.aldiwan.net/poem21954.html","عموديه"],[48,"وخمار أنخت إليه رحلي","https://www.aldiwan.net/poem62483.html","البسيط"],[48,"وخمار حططت إليه ليلا","https://www.aldiwan.net/poem63266.html","الوافر"],[48,"وخمار حططت إليه رحلي","https://www.aldiwan.net/poem64502.html","الوافر"],[48,"وخمارة للهو فيها بقية","https://www.aldiwan.net/poem65286.html","الطويل"],[48,"وخمر كعين الديك صبحت سحرة","https://www.aldiwan.net/poem65292.html","الطويل"],[48,"وخمار طرقت بلا دليل","https://www.aldiwan.net/poem65294.html","الوافر"],[48,"كنت في قرة عيني","https://www.aldiwan.net/poem66168.html","مجزوء الرمل"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[46,"لم أرض رأي ولاة قوم لقبوا","https://www.aldiwan.net/poem22632.html","الكامل"],[46,"كن وشيكا في حاجة أو مكيثا","https://www.aldiwan.net/poem23260.html","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42496","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[130,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[133,"إن فؤادا آية في الحفظ","https://www.aldiwan.net/poem49102.html","الرجز"],[221,"وقفا بميروبا على أطلالها","https://www.aldiwan.net/poem41619.html","الكامل"],[227,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[227,"هجرت شرب الراح في فتيه","https://www.aldiwan.net/poem51052.html","السريع"],[254,"وخمار أعد الكأس ظئرا","https://www.aldiwan.net/poem48402.html","الوافر"],[259,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[267,"إذا قامت بواكيك","https://www.aldiwan.net/poem26747.html","الهزج"],[295,"أما والهوى حلفا ولست بحانث","https://www.aldiwan.net/poem33311.html","الطويل"],[296,"وخميلة نسج الربيع برودها","https://www.aldiwan.net/poem36829.html","عموديه"],[436,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[438,"عن المصطفى صلوا عليه وسلموا","https://www.aldiwan.net/poem14387.html","الطويل"],[450,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[456,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[456,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[459,"نحن قوم من تميم بن مر","https://www.aldiwan.net/poem16100.html","المديد"],[466,"أنداؤنا يقق ودر","https://www.aldiwan.net/poem60137.html","مجزوء الكامل"],[466,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[466,"وخمار دخلت عليه ليلا","https://www.aldiwan.net/poem60297.html","الوافر"],[513,"ابن لي عن نهارك كيف ظلا","https://www.aldiwan.net/poem12215.html","الوافر"],[536,"إن كان لا بد من غبوق","https://www.aldiwan.net/poem47533.html","عموديه"],[556,"ذات تراأى النور من صفها","https://www.aldiwan.net/poem34389.html","السريع"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[584,"وخمري الخدود يريد بعدي","https://www.aldiwan.net/poem17964.html","الوافر"]],"verses":[["وَخَمِيسٍ يَلُفُّهُ بِخَمِيسٍ","وفِئَامٍ حَوَاهُ بَعدَ فِئَامِ",0,"م",1,0],["وَخَميسٍ يَحكي النُجومَ اِنتِظاماً","عَجَباً مِن كَواكِبٍ في بيدِ",1,"د",1,0],["وَخَميلَةٍ فَوقَ الجَزيرَةِ مَسَّها","ذَهَبُ الأَصيلِ حَواشِياً وَمُتونا",2,"ن",2,0],["وخُمْصانَةٍ منقادَةٍ بذوائبٍ","لسائِقِها خَلْفَ الجَوادِ لجاجُ",3,"ج",1,0],["وَخَميلَةٍ قَد أَخمَلَت سِربالَها","كَفّا صَناعٍ تَستَهِلُّ هَتونِ",4,"ن",1,1],["وَخَمّارَةً تَعني المَسيحَ بِرَبِّها","طَرَقتُ وَضَوءُ الصُبحِ غَيرُ مُبينِ",5,"ن",1,0],["وَخَميسُ الأَرضِ مالِكُهُ","يَملَأُ الأَرضَ بِهِ غابا",6,"ب",2,0],["وخَمّارَة ٍ نَبّهْتُها بعد هجْعَة ٍ ،","وقد غابت الجوزاءُ ، وارتفعَ النّسرُ",7,"ر",1,0],["وَخَمّارٍ أَنَختُ إِلَيهِ رَحلي","إِناخَةَ قاطِنٍ وَاللَيلُ داجِ",8,"ج",1,1],["وَخَمّارٍ حَطَطتُ إِلَيهِ لَيلاً","قَلائِصَ قَد وُنينَ مِنَ السِفارِ",9,"ر",1,1],["وَخَمّارٍ حَطَطتُ إِلَيهِ رَحلي","فَقامَ مُرَنَّحاً ثَمِلاً يَميلُ",10,"ل",1,1],["وَخَمّارَةٍ لِلَّهوِ فيها بَقِيَّةٌ","إِلَيها ثَلاثاً نَحوَ حانَتِها سِرنا",11,"ن",2,1],["وَخَمرٍ كَعَينِ الديكِ صَبَّحتُ سِحرَةً","وَقَد هَمَّ نَجمُ اللَيلِ بِالخَفَقانِ",12,"ن",1,1],["وَخَمّارٍ طَرَقتُ بِلا دَليلٍ","سِوى ريحِ العَتيقِ الخَسرَواني",13,"ن",2,1],["وَخِمٌ فَظٌّ غَليظٌ","ساقَهُ اللَهُ لِحَيني",14,"ن",2,0],["وَخَمرٍ كَبَردِ الماءِ في خَمرِ بابِلٍ","جَمَعتَ فَما تَنفَكُّ كَالماءِ وَالخَمرِ",15,"ر",1,0],["وَخُمولُ ذِكرِكَ في الحَياةِ سَلامَةٌ","وَدَهاكَ مَن أَمسى لِذِكرِكَ شاهِرا",16,"ر",2,0],["وَخُمولي يَذودُعَنّي الرَزايا","نامَ عَنّي الأَذى فَلَم يَنتَبِه لي",17,"ل",2,0],["وَخَمِيلَةٍ بَكَرَتْ سَمَاوَةُ أَيْكِها","تَحْمِي الْهَجِيرَ عَنِ النُّفُوسِ وَتَدْرَأُ",18,"ر",2,1],["وخَمَائِلُ الوَادِي تَمُدُّ غُصُونَها","وتَوَدُّ لَوْ فَازَتْ بلَمْحِ ضِيائِه",19,"ا",3,0],["وخمائلٌ من أحرُفٍ قُدْسيةٍ","أخملن صوتَ الطائر الصَدّاح",20,"ح",1,0],["وخَمرِىِّ الطِّبَاع عَلَيهِ سِيمَا","بِهِنَّ لِدَاتُه ارتَقَت ارتِقَاءَ",21,"ا",2,0],["وخمسةٌ من بعد هؤلاءِ","قد استحقوا عاطر الثناءِ",22,"ا",2,0],["وَخَمائِلُ الصَفصافِ ظَلَّلتِ الثَرى","فَتَبَرَّبعَ المصطافُ تَحتَ ظلالِها",23,"ل",3,0],["وخمرٍ ترشّفتُ سَلسالها","وأَجْرَيتُ في الشَّرب جِريالها",24,"ل",3,1],["وخمرنا بعدُ فما استكملت","في دَنّها معصورةً شهرا",25,"ر",2,0],["وخمارٍ أعد الكأس ظئراً","لطارقه فلم يرضعه غيلا",26,"ل",2,1],["وخمرنا ما يقتنى والأكل","وشربنا ما يشتهي والنقل",27,"ل",1,0],["وَخَمساً مِن بَناتِ اللَي","لِ قَد أُلبِسنَ أَطمارَك",28,"ك",1,0],["وَخمرةِ حُبٍّ عُتِّقت قَبلَ آدمٍ","فَكانَ حَديثاً عندَها عَهدُ يافِثِ",29,"ث",1,0],["وخميلةٍ نسج الربيعُ برودَها","برَّاقةً من شمسِهِ وَغمامِهِ",30,"م",2,1],["وخمرِي من الدُّرِّ مِسْكٌ مُذَابٌ","وروضِي من السِّحْرِ دَلٌّ رخيمُ",31,"م",1,0],["وخمس أتت بالاجتهاد فعفهةً","فروسيةً خط جنان جهنم",32,"م",1,0],["وخمس فبالعادات مشي تغوط","نكاح وأكل والنعاس المهوم",32,"م",1,0],["وخمساه غدا بحراً","إِذا ما راج منقلبا",33,"ب",2,0],["وخَمَّرتْ أوجهَها عن غيركم","دولةُ دنيا لكُمُ إسفارُها",34,"ر",3,0],["وخمسٌ سكونٌ تحت خمسٍ حَواركٍ","تَمُدُّ ثلاثاً يمتطيهنَّ واحدُ",35,"د",1,0],["وخميسٍ ضاربٍ بِجرانٍ","مُجْلِبٍ سوْرَتُهُ ما تَقِلُّ",36,"ل",1,0],["وَخُمورُنا لِوُجوهِها","مِن نَسجِ كَفِّ الماءِ خَمرُ",37,"ر",1,0],["وَخَمّارَةٍ نَبَّهتُها بَعدَ هَجعَةٍ","وَجُنحُ الدُجى حَيرانُ كَالقارِ مُسوَدُّ",38,"د",1,0],["وَخَمّارٍ دَخَلتُ عَلَيهِ لَيلاً","وَجُنحُ اللَيلِ مُسوَدُّ الجَناحِ",39,"ح",1,1],["وخمراً صافياً فيهون عتبي","على الهجران أم صادفت خلا",40,"ل",2,0],["وخمَرةٍ في صفَا العِقيقِ","اشرَب على المنظَرِ الأنِيقِ",41,"ق",1,0],["وخمرها شاربها ما صحا","وسرها غيب الهدى أوضحا",42,"ا",1,0],["وخمر السوى منه إذا شرب امرؤٌ","عليه بأنواع الخطوب مقارع",43,"ع",1,0],["وخمرتها حتى تناسق نشؤها","وسويتها حتى لنفخي استعدت",44,"ت",1,0],["وَخَمْرِيُّ الخُدُودِ يُريدُ بُعْدِي","وَقَلْبي بالصُّدُودِ كَواهُ كَيَّا",45,"ي",2,1]]}