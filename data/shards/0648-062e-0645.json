.poetsgate.com/ViewPoem.aspx?id=212017",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5277,"آهُ القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=192266",""],[5277,"آلاءُ الجمالِ","https://www.poetsgate.com/ViewPoem.aspx?id=198434",""],[5281,"مهرجانُ الغيم.. أبها","https://www.poetsgate.com/ViewPoem.aspx?id=199736",""],[5324,"المرأة الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=210925",""],[5376,"سكنت فؤادي في الضلوع وأودعت","https://www.poetsgate.com/ViewPoem.aspx?id=197588",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5628,"حب فوق العادة","https://www.poetsgate.com/ViewPoem.aspx?id=179814",""],[5628,"المرأة الساحرة","https://www.poetsgate.com/ViewPoem.aspx?id=179898",""],[5652,"طفله تناجي وردة الحلم ل التيه","https://www.poetsgate.com/ViewPoem.aspx?id=179842",""],[5751,"كل ما فيها يُغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=215018",""],[5764,"ست وثلاثينك","https://www.poetsgate.com/ViewPoem.aspx?id=177319",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5781,"فاتِحةُ الجمالِ وأولُ جرحٍ ...أنت","https://www.poetsgate.com/ViewPoem.aspx?id=208986",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5873,"أحلى الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=215305",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[4442,"خير الصحائف ما يفوح شذاه","https://www.poetsgate.com/ViewPoem.aspx?id=171206",""],[6115,"نصايح عشر","https://www.poetsgate.com/ViewPoem.aspx?id=180461",""],[6150,"على مرفأ البوح","https://www.poetsgate.com/ViewPoem.aspx?id=25229",""]],"verses":[["وَخَمِيسٍ يَلُفُّهُ بِخَمِيسٍ","وفِئَامٍ حَوَاهُ بَعدَ فِئَامِ",0,"م",1,0],["وَخَميسٍ يَحكي النُجومَ اِنتِظاماً","عَجَباً مِن كَواكِبٍ في بيدِ",1,"د",1,0],["وَخَميلَةٍ فَوقَ الجَزيرَةِ مَسَّها","ذَهَبُ الأَصيلِ حَواشِياً وَمُتونا",2,"ن",2,0],["وخُمْصانَةٍ منقادَةٍ بذوائبٍ","لسائِقِها خَلْفَ الجَوادِ لجاجُ",3,"ج",1,0],["وَخَميلَةٍ قَد أَخمَلَت سِربالَها","كَفّا صَناعٍ تَستَهِلُّ هَتونِ",4,"ن",1,1],["وَخَمّارَةً تَعني المَسيحَ بِرَبِّها","طَرَقتُ وَضَوءُ الصُبحِ غَيرُ مُبينِ",5,"ن",1,0],["وَخَميسُ الأَرضِ مالِكُهُ","يَملَأُ الأَرضَ بِهِ غابا",6,"ب",2,0],["وخَمّارَة ٍ نَبّهْتُها بعد هجْعَة ٍ ،","وقد غابت الجوزاءُ ، وارتفعَ النّسرُ",7,"ر",1,0],["وَخَمّارٍ أَنَختُ إِلَيهِ رَحلي","إِناخَةَ قاطِنٍ وَاللَيلُ داجِ",8,"ج",1,1],["وَخَمّارٍ حَطَطتُ إِلَيهِ لَيلاً","قَلائِصَ قَد وُنينَ مِنَ السِفارِ",9,"ر",1,1],["وَخَمّارٍ حَطَطتُ إِلَيهِ رَحلي","فَقامَ مُرَنَّحاً ثَمِلاً يَميلُ",10,"ل",1,1],["وَخَمّارَةٍ لِلَّهوِ فيها بَقِيَّةٌ","إِلَيها ثَلاثاً نَحوَ حانَتِها سِرنا",11,"ن",2,1],["وَخَمرٍ كَعَينِ الديكِ صَبَّحتُ سِحرَةً","وَقَد هَمَّ نَجمُ اللَيلِ بِالخَفَقانِ",12,"ن",1,1],["وَخَمّارٍ طَرَقتُ بِلا دَليلٍ","سِوى ريحِ العَتيقِ الخَسرَواني",13,"ن",2,1],["وَخِمٌ فَظٌّ غَليظٌ","ساقَهُ اللَهُ لِحَيني",14,"ن",2,0],["وَخَمرٍ كَبَردِ الماءِ في خَمرِ بابِلٍ","جَمَعتَ فَما تَنفَكُّ كَالماءِ وَالخَمرِ",15,"ر",1,0],["وَخُمولُ ذِكرِكَ في الحَياةِ سَلامَةٌ","وَدَهاكَ مَن أَمسى لِذِكرِكَ شاهِرا",16,"ر",2,0],["وَخُمولي يَذودُعَنّي الرَزايا","نامَ عَنّي الأَذى فَلَم يَنتَبِه لي",17,"ل",2,0],["وَخَمِيلَةٍ بَكَرَتْ سَمَاوَةُ أَيْكِها","تَحْمِي الْهَجِيرَ عَنِ النُّفُوسِ وَتَدْرَأُ",18,"ر",2,1],["وخَمَائِلُ الوَادِي تَمُدُّ غُصُونَها","وتَوَدُّ لَوْ فَازَتْ بلَمْحِ ضِيائِه",19,"ا",3,0],["وخمائلٌ من أحرُفٍ قُدْسيةٍ","أخملن صوتَ الطائر الصَدّاح",20,"ح",1,0],["وخَمرِىِّ الطِّبَاع عَلَيهِ سِيمَا","بِهِنَّ لِدَاتُه ارتَقَت ارتِقَاءَ",21,"ا",2,0],["وخمسةٌ من بعد هؤلاءِ","قد استحقوا عاطر الثناءِ",22,"ا",2,0],["وَخَمائِلُ الصَفصافِ ظَلَّلتِ الثَرى","فَتَبَرَّبعَ المصطافُ تَحتَ ظلالِها",23,"ل",3,0],["وخمرٍ ترشّفتُ سَلسالها","وأَجْرَيتُ في الشَّرب جِريالها",24,"ل",3,1],["وخمرنا بعدُ فما استكملت","في دَنّها معصورةً شهرا",25,"ر",2,0],["وخمارٍ أعد الكأس ظئراً","لطارقه فلم يرضعه غيلا",26,"ل",2,1],["وخمرنا ما يقتنى والأكل","وشربنا ما يشتهي والنقل",27,"ل",1,0],["وَخَمساً مِن بَناتِ اللَي","لِ قَد أُلبِسنَ أَطمارَك",28,"ك",1,0],["وَخمرةِ حُبٍّ عُتِّقت قَبلَ آدمٍ","فَكانَ حَديثاً عندَها عَهدُ يافِثِ",29,"ث",1,0],["وخميلةٍ نسج الربيعُ برودَها","برَّاقةً من شمسِهِ وَغمامِهِ",30,"م",2,1],["وخمرِي من الدُّرِّ مِسْكٌ مُذَابٌ","وروضِي من السِّحْرِ دَلٌّ رخيمُ",31,"م",1,0],["وخمس أتت بالاجتهاد فعفهةً","فروسيةً خط جنان جهنم",32,"م",1,0],["وخمس فبالعادات مشي تغوط","نكاح وأكل والنعاس المهوم",32,"م",1,0],["وخمساه غدا بحراً","إِذا ما راج منقلبا",33,"ب",2,0],["وخَمَّرتْ أوجهَها عن غيركم","دولةُ دنيا لكُمُ إسفارُها",34,"ر",3,0],["وخمسٌ سكونٌ تحت خمسٍ حَواركٍ","تَمُدُّ ثلاثاً يمتطيهنَّ واحدُ",35,"د",1,0],["وخميسٍ ضاربٍ بِجرانٍ","مُجْلِبٍ سوْرَتُهُ ما تَقِلُّ",36,"ل",1,0],["وَخُمورُنا لِوُجوهِها","مِن نَسجِ كَفِّ الماءِ خَمرُ",37,"ر",1,0],["وَخَمّارَةٍ نَبَّهتُها بَعدَ هَجعَةٍ","وَجُنحُ الدُجى حَيرانُ كَالقارِ مُسوَدُّ",38,"د",1,0],["وَخَمّارٍ دَخَلتُ عَلَيهِ لَيلاً","وَجُنحُ اللَيلِ مُسوَدُّ الجَناحِ",39,"ح",1,1],["وخمراً صافياً فيهون عتبي","على الهجران أم صادفت خلا",40,"ل",2,0],["وخمَرةٍ في صفَا العِقيقِ","اشرَب على المنظَرِ الأنِيقِ",41,"ق",1,0],["وخمرها شاربها ما صحا","وسرها غيب الهدى أوضحا",42,"ا",1,0],["وخمر السوى منه إذا شرب امرؤٌ","عليه بأنواع الخطوب مقارع",43,"ع",1,0],["وخمرتها حتى تناسق نشؤها","وسويتها حتى لنفخي استعدت",44,"ت",1,0],["وَخَمْرِيُّ الخُدُودِ يُريدُ بُعْدِي","وَقَلْبي بالصُّدُودِ كَواهُ كَيَّا",45,"ي",2,1],["وَخَملَ الأُرجُوانِ عَلى ال","سَفينِ كَأَنَّهُ العَلَقُ",46,"ق",1,0],["وَخَمرٌ مِن ثُغُورٍ بِتُ وَهناً","أُصَفِّقُهُ بِخَمرٍ مِن كُرُومِ",47,"م",1,0],["وخمسها جبل لكن بقيتها","في مكة ترتجى فوزا بغفران",48,"ن",1,0],["وخمَّر منهُ وجهَهُ بِلحافِه","ليدفعَ عنه كيدَ مَن كان أكْيَدا",49,"د",2,0],["وخمسون أو أربعون إناء","تضيء معا حسب المشتهى",50,"ا",1,0],["وَخَمرُ لَماها يَفوحُ كَمِسكٍ","فَعُشّاقُها مِنهُ تَبدو سكارى",51,"ر",2,0],["وَخَمر ريقَتِهِ مَمزوجَةً عَسَلاً","مِن غَيرِ مَزجٍ وَلَكِن خلق ذي المِنَنِ",52,"ن",1,0],["وخمود تحته جزل الغضا","وسكون تحته الري سعى",53,"ع",2,0],["وخمسة أشهر إلا قليلاً","قضى حقاً لكسرى صار عذرا",54,"ر",2,0],["وَخَمسَةُ آباءٍ لَهُ قَد تَتابَعوا","خَلائِفُ عَدلٍ مُلكُهُم مُتَواتِرُ",55,"ر",1,0],["وخمرة من رضاب","بفيه داوت خماري",56,"ر",2,0],["وخميس عرمرم قد حماه","فزها يومه على الأعياد",57,"د",1,0],["وَخَمَائِلٌ مُخْضَرَّةٌ أم سَالِفٌ","وَغَزَالَةٌ هَاتيكَ أمْ أضْوَاءُ",58,"ا",2,0],["وَخمْسونَ من مارقات النِّساء","يُسحِّبْنَ لِلْمندَيات المُرُوطَا",59,"ط",2,0],["وخمسة منها استوت فالثرم","أولها وبعد ذاك القصم",60,"م",1,0],["وخمسة لذات تركيب أتت","اولها في وضعها تلوزت",61,"ت",1,0],["وَخَميسٍ تُقبَضُ الأَر","ضُ لَهُ ظَلَّ يَسيرُ",62,"ر",1,0],["وخمصباح مشكاة الهدى غير أنه","تجلى ليهدي الناس لئلأ سيماه",63,"ا",2,0],["وخمار وزيرك وعجيب","وبديع وفارس وجوان",64,"ن",1,0],["وَخمر لونها وافي","وَساقي ليسَ بالجافي",65,"ي",1,0],["وخمَّرَ رأياً لم يشطَّ ثباتُه","فطورٌ ورأي الأكثرين فطير",66,"ر",1,0],["وخمر الثغر يجري فوق ظلم","وليس به النزيف ولا الصداع",67,"ع",1,0],["وَخُمُودِ نِيرانٍ أطَالُوا وَقْدَهَا","وَصَرِيعِ أصنَامٍ لهَا مُتَحَطَّمِ",68,"م",1,0],["وخمسة أجزاء فريضة مخطئ","من الإبل في أسناها لا تحولُ",69,"ل",1,0],["وخمسٌ لخلع العظم من أرش كسره","وقل أناسٌ سومُ عدلٍ فأشكلُ",69,"ل",1,0],["وخمسون منهم يخلفون بقتله","وإلا فأدى من عن الحلف ينكل",69,"ل",1,0],["وخمساه بقلب فعل أمر","أو اسم قد سما بذرى الرواسي",70,"س",2,0],["وخم يركب العوصاء طاط","عَنِ المُثلى غُناماهُ القِذاعُ",71,"ع",1,0],["وَخَميسٌ أَلقى عَلى طَرَفِ السا","حِلِ شَطراً وَفي العَواصِمِ شَطرا",72,"ر",2,0],["وخّمشت باكُفّ","الاحاظ والابصارِ",73,"ر",1,0],["وخمسها الفحول بأجنبي","بعيد عن مقاصدها غريب",74,"ب",1,0],["وخمائل الورد النض","ير تقسمت بيد النظام",75,"م",1,0],["وخمس مئين بعد خمسين درهماً","وتسعون لي فلس ولم ينفع الخصم",76,"م",1,0],["وَخَمسُمائَة مِنَ الأَلوف","دَراهِماً نَقداً بِلا زُيوفِ",77,"ف",1,0],["وخمّرت بالشعر القديم جديده","ففاض على أوراقي البيض بالخمر",78,"ر",1,0],["وخمرةٌ في كأسِها","يلعبُ بالنَّرْدِ الْحَبَبْ",79,"ب",1,0],["وخمرةٍ كشعاعِ الشمس صافيَة","قَد ذكّرتني بأيّامي وماضيها",80,"ي",3,1],["وخميسٍ حفّوا بهِ حيثُ يُرْجَى","موْرِدُ الأمْنِ كالعِشارِ الخَوامِسْ",81,"س",1,0],["وخمرةٍ اذ ساءَ راووقُها","مرَّت مَذاقاً فَهيَ لن تُحتَسى",82,"س",2,0],["وَخمّارٍ آضاءَ لنا براحٍ","ظلامَ اللَيل وَالساري حَثيثُ",83,"ث",1,1],["وَخمورُه لَو قستها بخُمارها","ما هِمتَ فيما أَنتَ فيه تَنشُط",84,"ط",1,0],["وَخمول المَرء عيش حبيب","وَالمَعالي لِأَهلِها أَعداء",85,"ا",2,0],["وخميلةٍ يجني الغداف قطافها","وترود حوليها الصلال الشرَّد",86,"د",1,0],["وخمار أنخت به مسيحي","رخيم الدل ذي وجه صبيح",87,"ح",1,1],["وخمري جَنَى فيه، ووَرْديَ خَدُّهُ","وصُبْحي مُحَيّاهُ وليليَ شَعْرُه",88,"ر",2,0],["وَخَمّارَةٍ مِن بَناتِ القُسوسِ","تَبيعُ المُدامَةَ في دارِها",89,"ر",3,1],["وخمدت تخمدُ نار الغضَب","ونَحت ينحِت فاكسر تُصب",90,"ب",1,0],["وَخَمسَةٍ قَد أَبانوا لي كَيادَهُمُ","وَقَد تَلَظّى لَهُم مِقلي وَطَنجيرُ",91,"ر",1,1],["وَخَميس يَلفُّهُ في خَميسٍ","في سَحابٍ مِن الرَدى هَطّالِ",92,"ل",1,1],["وخمر كعين الديك صرف دنانها","مرازبة من آل كسرى مواثل",93,"ل",1,0],["وخمرُ معانيهِ على السمع مسكرٌ","فيا حبَّذا معنىً على السمع أسكرا",94,"ر",2,0],["وخمصمانةٌ مجدولةٌ ورَنجَلَةٌ","وغانيةٌ غنّاءُ بدر الثواقبِ",95,"ب",1,0],["وخمائلٌ من مَخْمَلٍ ديباجُها","لِينٌ تُرَوِّي هُدْبَهُ الأنداءُ",96,"ا",2,0],["وَخميلَىٍ تختالُ من","خطرتِها في حُلَّتينِ",97,"ن",1,0],["وخمولُ قَدري من يديَّ لأننَّي","لا أرتضي للِمدحِ إِلاَّ أَكبرا",98,"ر",2,0],["وخميلةٍ رقم الزمان أديمها","بمفضضٍ ومقسمٍ ومشوبِ",99,"ب",1,1],["وَخَمري أَثارَت في الجَميعِ ضِياءها","وَحَقّاً بِأَنواعِ الوُجودِ اِستَبدَّتِ",100,"ت",1,0],["وخمور هناك تشرب جهراذ","ورجال على المعاصي حراص",101,"ص",1,0],["وخمسين ٍ عليهن في زيادة","كتايب جيش منّا مخمسينا",102,"ن",2,0],["وخميلة المنصور شيدت فانجلت","عنها النّقاب فبورك الإيشاد",103,"د",1,0],["وَخَمْرُ الْعِشْقِ مُسْكِرَةٌ","تُضَاْهِيْ اِبْنَةَ الْعِنَبِ",104,"ب",1,0],["وخمر على شط الكروم 