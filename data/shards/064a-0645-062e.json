{"poems":[[53,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[93,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29284","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29282","الخفيف"],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5431,"مهجة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205811",""]],"verses":[["يُمخِّضُ ودي كل يوم وليلةٍ","بذلك صدراً لا يزال ممخّضا",0,"ض",2,0],["يَمخُرُ المِنطادُ فيهِم في الفَضاء","مِثلَما يَمخُرُ في البَحرِ السَفين",1,"ن",1,0],["يَمخَرُ المَوجَ وَالعُبابَ بِقَيدو","مٍ كَريهٍ عَلى الرَدى خَوّاضِ",2,"ض",1,0],["يَمخَرُ المَوجَ وَالعُبابَ بِقَيدو","مٍ شَتيمٍ عَلى الرَدى خَوّاضِ",3,"ض",1,0],["يمخر البحر حالما زينته","في تجلي الآفاق هيبة ماخر",4,"ر",1,0],["يمخر الشعر مسرعا فيه شَقا","فارسٌ من يقارع البحر عشقا",5,"ق",2,1]]}