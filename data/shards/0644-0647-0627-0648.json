{"poems":[[44,"تحسس عني أم سكن وأهون الشكاه","https://www.aldiwan.net/poem50435.html","الطويل"],[88,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[95,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[90,"بني الأرض هل من سامع فأبثه","https://www.aldiwan.net/poem45068.html","الطويل"],[53,"إذا ما شنطف نكهت أماتت","https://www.aldiwan.net/poem65079.html","الوافر"],[53,"أفي هوى يوسف ألام","https://www.aldiwan.net/poem66363.html","مخلع البسيط"],[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[68,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[82,"وناهدة تربت كفها","https://www.aldiwan.net/poem31467.html","المتقارب"],[46,"لها وأعارني ولها","https://www.aldiwan.net/poem30085.html","مجزوء الوافر"],[33,"ألا تجزي عثيمة ود صب","https://www.aldiwan.net/poem41326.html","الوافر"],[42,"ما هاج قلبك يوم العرج من ظعن","https://www.aldiwan.net/poem42333.html","البسيط"],[54,"هي الدار إلا أنها منهم قفر","https://www.aldiwan.net/poem27048.html","الطويل"],[52,"تقول ابنتي إذ فاخرتها غريبة","https://www.aldiwan.net/poem63870.html","الطويل"],[48,"كريم أناب وما أنبا","https://www.aldiwan.net/poem22154.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85286","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147517","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[237,"بوادي الجزع لو علم الرقيب","https://www.aldiwan.net/poem14750.html","الوافر"],[275,"هزئتم بنفس تجهلون خلالها","https://www.aldiwan.net/poem35616.html","الطويل"],[308,"لها وجنة فيها من الخال نقطة","https://www.aldiwan.net/poem57949.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[325,"أيا عبد الحليم إليك بشرى","https://www.aldiwan.net/poem67123.html","الوافر"],[327,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[401,"لها وركا عنزٍ وساقا نعامةٍ","https://www.aldiwan.net/poem560.html",""],[438,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[463,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[463,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[466,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[482,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[548,"أيا تملك يا تمل","https://www.aldiwan.net/poem1760.html","الهزج"],[580,"لقد ذهبت نفسي وقد صفرت يدي","https://www.aldiwan.net/poem2970.html","الطويل"],[580,"أخذت ضنى عينيك رهنا على قلبي","https://www.aldiwan.net/poem2991.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54058","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62457","الوافر"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96585","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61176","المتقارب"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109151","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21670","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102114","المجتث"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177824","السريع"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33872","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27589","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2461,"","https://poetry.dctabudhabi.ae/diwan/poem/110714","الطويل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103723","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137200",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116500","الطويل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34743","المتقارب"],[3091,"","https://poetry.dctabudhabi.ae/diwan/poem/141756","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68014","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89007","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86324","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86249","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108390",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91406","الطويل"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[4680,"يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=199778",""],[4862,"عجوز النحس سيدة الضلالِ","https://www.poetsgate.com/ViewPoem.aspx?id=152395",""],[4119,"إذا ما زرت ماريا","https://www.poetsgate.com/ViewPoem.aspx?id=16233",""],[5206,"الجاهل والعارف","https://www.poetsgate.com/ViewPoem.aspx?id=187359",""],[5277,"محاولات فاشلة","https://www.poetsgate.com/ViewPoem.aspx?id=210318",""],[223,"البكاء خلف أسوار الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=190683",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[6093,"بِشَامِ الغيد روحي والمرامُ ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176151",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""],[2220,"لها ولهذا لو تفكرت شيبتْ ألا إنَّ ربَّ الناسِ ربي وإنه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11592&r=&rc=466",""],[6299,"ألا أمُّ عَمْروٍ أجْمَعَتْ فکسْتَقَلَّتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19677&r=&rc=2",""]],"verses":[["لَها وَلجَةٌ في كُلِّ بَيتٍ وَخَرجَةٌ","تَحَكُّكَ جَنبِ الأَجرَبِ المُتَمَرِّسِ",0,"س",1,0],["لَها وَثَباتٌ تَحتَ ظِلِّ هِلالِها","كَما مَرَّ سَهمٌ أَو كَما اِنقَضَّ كَوكَبُ",1,"ب",1,0],["لَها وَثَباتٌ كَصَوبِ السِحابِ","فَوادٍ خِطاءٌ وَوادٍ مُطِر",2,"ر",1,0],["لَهَا وَادٍ هُوَ الدُّنْيَا جَمِيعاً","وَنُقْصِرُهَا عَلَى وَادِي الصَّريمِ",3,"م",1,0],["لها ورق قد جفّ إلاّ أقلَّه","وعيدانها بين النيوب العواجم",4,"م",1,0],["لها وجه رأيت البطَّ فيه","كشقِّ عجانها والدود يسعى",5,"ع",2,0],["لها وما إنْ لهوتُ عنهُ","ونامَ عنِّي وما أنام",6,"م",1,0],["لَها وَفضَةٌ مِنها ثَلاثونَ سَيحَفاً","إِذا آنَسَت أولى العَدِيَّ اقشَعَرَّتِ",7,"ت",1,0],["لَها وَلَدٌ بَعدَ الفِطامِ رَضاعُهُ","يُسِرُّ عُقوقاً رَفضُهُ غَيرُ واجِبِ",8,"ب",1,0],["لَها وَجنَةٌ صُقِلَتْ بِالنَّعيم","وناظرةٌ كُحِلَتْ بِالفتورِ",9,"ر",1,0],["لَها وَأَعارَني وَلَها","وَأَبصَرَ ذِلَّتي فَزَها",10,"ه",2,1],["لَها وَجهٌ يُضيءُ كَضَوءِ بَدرٍ","عَتيقُ اللَونِ باشَرَهُ النَعيمُ",11,"م",1,0],["لَها وَساوُسُ تَجري في تَحَرُّكِها","ما لَم يَكُن بَينَ أَثناءٍ مِنَ العَكَنِ",12,"ن",1,0],["لَها وَجَناتٌ يَضحَكُ الوَردُ فَوقَها","وَطَرفٌ مَريضٌ حَشوُ أَجفانِهِ السِحرُ",13,"ر",1,0],["لَها والِدٌ راعٍ إِذا راحَ عِندَها","بِأَشوِيَةٍ مِن قَلبِ ضَبٍّ وَمِن كَبِد",14,"د",1,0],["لَها والِدٌ بَيتُهُ شامِخٌ","مَعَ النَسرِ أَو مِثلَهُ طُنُبا",15,"ب",2,0],["لها وهي أدرى العالمين بحالتي","هوى في فؤادي ناره تتأجَّج",16,"ج",1,0],["لها وهَجُ الحبِّ في قُبلةٍ","على شَفةٍ شِبهِ مُفترَّةِ",17,"ه",1,0],["لها والد عال وأم كريمة","وحاضنة سوداء جائشة الصدر",18,"ر",1,0],["لَهُ أَوَابِدُ لا تَنْفَكُّ سَائِرَةً","فِي الأَرْضِ مَا بَيْنَ إِدْلاجٍ وَتَهْجِيرِ",19,"ر",1,0],["لهَا وَجَوهٌ بَادِيَاتُ القَذَى","مُبْصِرُهَا يُؤْذِي بِمَا يُبْصِرُ",20,"ر",1,0],["لَهُ أَوفى نَصيبٍ مِن غَرامي","عَلَيهِ وَلَيسَ لي مِنهُ نَصيبُ",21,"ب",1,0],["لها وثباتُ الضوءِ قبلَ انطفائهِ","وعِقدَتُها يأبى الزمانُ انحلالها",22,"ل",3,0],["لها وجنةٌ فيها من الخال نقطةٌ","مداري عليها في الهوى ومدارها",23,"ه",2,1],["له أوقدوها ثم ألقوه فانثنت","عليه بأمر الله في مثل روضة",24,"ه",1,0],["لَهُ أَو ما وَقَد ناداهُ أَرخَ","جَمالُ الدينِ في رَغدٍ تَدومُ",25,"م",1,0],["لَها وَجهٌ كَصَحنِ البَدرِ فَخمُ","وَمُنسَجِرٌ عَلى المَتنَينِ سودُ",26,"د",1,0],["لها وَركا عنزٍ وساقا نعامةٍ","وأسنانُ خِنزير ومكشرُ أرنبِ",27,"ب",1,1],["لها وكَمْ قِيلَ لها مَرَّةً","فَهْيَ بمعنى واحدٍ لاهِ",28,"ه",1,0],["لها وهي خُرْسٌ تحت عضِّ رحالِها","تشكٍّ إذا جدَّ السُّرَى وأنينُ",29,"ن",1,0],["لها وسمٌ على الأعراض باقٍ","بقاءَ الطوق في عُنُق الحمامَهْ",30,"م",2,0],["لها وطنُ المقيم بكلِّ سمعٍ","تمرّ به وسائرُها غريبُ",31,"ب",1,0],["لها ولفكر اللَّوذعيِّ مع الدُّجى","طِراد جيوش الفرس وابن محرِّقِ",32,"ق",1,0],["لها وهذي إن شئتما حلبة ال","فضل على السابقات تفضيل",33,"ل",1,0],["لها ولِمنْ عليها منهُ وِردٌ","اِذا حَنَّ العِطاشُ إلى الورودِ",34,"د",1,0],["لَها وَلوَلَةٌ في الكَفِّ","كَالمَعنِيِّ بِالثُكلِ",35,"ل",1,0],["لها وعَلَيْها ما رأًيتُ ولا أَرَى","ومنها وفيها ما أُسِرُّ وما أُبْدِي",36,"د",2,0],["لها ورْدُ خدٍّ شَوْكُه هُدْب نَاظِرٍ","وَكَمْ مدَّ ظلاَّ فوقَه الظِّلُّ كالحُجْبِ",37,"ب",1,0],["لها وجهٌ غريب الحسن أضحى","محيا البدر يحسده كماله",38,"ل",2,0],["لها وَثَباتُ حتفٍ لم","يَثِبْها الأَسد الوَرْدُ",39,"د",1,0],["لها وله دَورٌ بكلِّ قرارةٍ","ونِقعٌ بمستلقى الفضاءِ قويمُ",40,"م",1,0],["لها ورك كالجَوبِ لُزّ فقارُه","نَمَت صُعُداً فى ناشز الخَلقِ مُكمَل",41,"ل",1,0],["لَها وسط وهي غيرُ أواهل","منازل منها عامرات أواهلُ",42,"ل",1,0],["لَها وَلَد لَيسَ مِن جنسها","وَما قَط جاءَت بِطفل ذكر",43,"ر",1,0],["لها ولعٌ بالسلب والسلب دأبها","ولكنها تسبي برفق حليم",44,"م",1,0],["لَها وارِدٌ دانٍ عَلى جيدِ ظَبيَةٍ","بِسائِلَةٍ مَيثاءَ عُفرٍ ذِئابُها",45,"ب",3,0],["لها وجه كصبح تحت ليل","غدائره كأجنحة الغراب",46,"ب",1,0],["لها ولا هامَ صبٌّ","ألا يا أحمد",47,"د",1,0],["لها وللأحباب فيها موعد","للوصل وافته توفي الموعدا",48,"د",2,0],["لَها وَرَداتٌ كَوَردِ الجِنا","نِ تُشرِقنَ في خَدِّها الناعِمِ",49,"م",1,0],["لها ولهذا لو تفكرت شيبتْ","بإحكامها فينا وفيكم مفارقي",50,"ق",2,0],["لها والدٌ لم ينضج العلمُ رأسه","فما أنفك في الطبع القديم مقيدا",51,"د",2,0],["لها وجنة للمحتظي هي جنة","ونار لمن يشقى يؤججها الخال",52,"ل",1,0],["لها ولد في حجرها لا تزيله","أوان غناء ثم ترميه بالبعد",53,"د",1,0],["لها وجه محاسنه","تزيل الهم والكربا",54,"ب",2,0],["لها وكَنجَمنجَلا شِعبانِ","في مَغربِ السُّهَيلِ واقِعانِ",55,"ن",1,0],["لَهَا وَأُدخُلها بلا دليلِ","في الغَلقِ والمَوسمِ يا خليلي",56,"ي",1,0],["لَهَا ولا تَقرُب لَهَا بالمَرَّه","وَسِر على الجوزا إلى شُمُطرَه",57,"ه",1,0],["لها واحد في كل عصر مقدس","تبيح له العلياء هز المناكب",58,"ب",1,1],["لها وجهُ قردٍ إذا ازَّيَّنت","ولونٌ كَبيض القَطا الأبرَشِ",59,"ش",1,0],["لها وجهان ممدوحان حسنا","وذو الوجهين مذموم يلام",60,"م",1,0],["لَهَا وَهَجٌ بالخافِقين شعاعُه","تَشعْشَعَ من نور الخلافة قابِس",61,"س",1,0],["له أوصاف فضل ليس تقوى","على إحصائها لُسُنُ الثقات",62,"ت",1,0],["لها واكفٌ يجري عليها كأنّهُ","حصىً شِيفَ خانتْهُ السلوكُ قَشيرُ",63,"ر",1,0],["لَه اوَّلٌ مَع آخرٍ فعل بِهِ","جَرَّ الهَوى لِلعاشِقينَ هِيام",64,"م",1,0],["لَها وجنة لَو عابَد النورُ شامِلُها","لِخرّ لَدَيها ساجِداً يَتَخَوَّفُ",65,"ف",1,0],["لها وجناتٌ ناعماتٌ ترقرقت","مياهُ جمال في صفائحها الغرِ",66,"ر",1,0],["لَها وَجنةٌ وَضاءُ ما الوَردُ مثلها","عَلَيها جرى ماءُ الشَباب كَسلسال",67,"ل",1,0],["لَها وَقعَةٌ في كُلِّ يَومٍ وَلَيلَةٍ","وَتَعليمَةٌ تَجني النجاءَ الهَملعا",68,"ع",2,0],["لهاوية الضياع بما أضاعوا","وما نهبوا غناك وما أراقوا",69,"ق",3,0],["لها وجهٌ كوجه البوم شرٌ","وأردافٌ كمنتوف السبالِ",70,"ل",1,0],["لها وجه مسيحي","ترى الميت به حيا",71,"ي",2,0],["لَهَا وَالِهٌ مَن قَد لَهَى جَامِعًا لَهَا","وَلَم يَدرِ أنَّ المَوتَ تَحتَ اللُّهى لَهِي",72,"ي",1,0],["لها وجهٌ يضيءُ بهِ احتشامٌ","كمثلِ البدرِ أحلاهُ التمامُ",73,"م",1,0],["لها وفّيتُ... ومثلي","إن سالَ بالوعدِ وفّى",74,"ف",2,0],["لَها وَس