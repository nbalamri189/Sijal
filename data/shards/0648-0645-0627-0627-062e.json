{"poems":[[77,"أما والذي تبلى لديه السرائر","https://www.aldiwan.net/poem36461.html","الطويل"],[71,"وما إخوة شتى النجار فمنهم","https://www.aldiwan.net/poem3858.html","الطويل"],[82,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[88,"متى نرجو لغمتنا انكسافا","https://www.aldiwan.net/poem44828.html","الوافر"],[88,"إذا كان جهل الناس مدعاة غيهم","https://www.aldiwan.net/poem44997.html","الطويل"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[51,"لئن جلا وأقمنا إنه لفتى","https://www.aldiwan.net/poem65925.html","البسيط"],[43,"رويدك أيها الملك الجليل","https://www.aldiwan.net/poem9757.html","الوافر"],[43,"المجد عوفي إذ عوفيت والكرم","https://www.aldiwan.net/poem10522.html","البسيط"],[45,"عليك السلام أيها القمر البدر","https://www.aldiwan.net/poem63569.html","الطويل"],[45,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[17,"إذا المرء لم يدنس من اللؤم عرضه","https://www.aldiwan.net/poem1201.html",""],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[46,"ألا إن الظباء لفي غرور","https://www.aldiwan.net/poem22262.html","الوافر"],[46,"يحل بمهر رحيق الرضاب","https://www.aldiwan.net/poem22378.html","المتقارب"],[46,"إن كان لم يترك قيس له وطرا","https://www.aldiwan.net/poem22666.html","البسيط"],[46,"تجنب حانة الصهبا","https://www.aldiwan.net/poem23111.html","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85465","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42703","الوافر"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[45,"عَلَيكَ السَلامٌ، أيّها القَمَرُ البَدْرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31254",""],[46,"ألا إنّ الظّباءَ لَفي غُرُورٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18254",""],[115,"خيال حبيبي لم يزل ضمن خاطري","https://www.aldiwan.net/poem41247.html","عموديه"],[160,"من عاش حدث عن أيامه العجبا","https://www.aldiwan.net/poem58910.html","البسيط"],[160,"للصبر في مهجتي والهم معترك","https://www.aldiwan.net/poem58994.html","البسيط"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[169,"أقيما على حر المدى أو ترحلا","https://www.aldiwan.net/poem1649.html",""],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[199,"تعالي وإن لم تجملي فترفقي","https://www.aldiwan.net/poem45346.html","الطويل"],[261,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[313,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[322,"وليس بنافع ذا البخل مال","https://www.aldiwan.net/poem56339.html","الوافر"],[349,"ولو كانت إرادته تعالى","https://www.aldiwan.net/poem15572.html","الوافر"],[349,"يا مي مل الهوى إلا معناك","https://www.aldiwan.net/poem15813.html","البسيط"],[364,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[366,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[366,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[366,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[371,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[403,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[416,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[416,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[416,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[416,"دعوت فؤادي للسلو فما أجدى","https://www.aldiwan.net/poem54056.html","الطويل"],[416,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[441,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[458,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[461,"يكل الركب عن ابلاغ شوقي","https://www.aldiwan.net/poem15438.html","الوافر"],[464,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[464,"ما بأراك الحمى إلى سلمه","https://www.aldiwan.net/poem3415.html","عموديه"],[505,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[551,"حلفت بشعث من نزار تعلقوا","https://www.aldiwan.net/poem47290.html","الطويل"],[551,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[551,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[558,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"]],"verses":[["وما اخْضَرّ ذاكَ الخَدُّ نَبْتاً وإنّما","لكَثْرَةِ ما شُقّتْ عليْهِ المَرائِرُ",0,"ر",1,0],["وَما إِخوَةٌ شَتّى النِجارِ فَمِنهُمُ","نَبيهٌ وَمِنهُم خامِلٌ ما لَهُ ذِكرُ",1,"ر",1,1],["وما أخفاه بين القوم إلا","ضناه وربما نفع السقام",2,"م",1,0],["وما اختلفوا لمصلحة ولكن","ليأكل أقوياؤهم الضعافا",3,"ف",2,0],["وما أخذ اللّه العهود على الورى","بأن يعلَموا حتى قضى أن يُعلِّموا",4,"م",3,0],["وَما أَخوكَ الَّذي يَدنو بِهِ نَسَبٌ","لَكِن أَخوكَ الَّذي تَصفو ضَمائِرُهُ",5,"ر",2,0],["وما أخٌ بقريبٍ حينَ تحجُبُه","نبائثُ الأرضِ في مُنهاله الجالِ",6,"ل",1,0],["وَما أَخشى نُبوَّكَ عَن طَريقٍ","وَسَيفُ الدَولَةِ الماضي الصَقيلُ",7,"ل",1,0],["وَما أَخُصُّكَ في بُرءٍ بِتَهنِئَةٍ","إِذا سَلِمتَ فَكُلُّ الناسِ قَد سَلِموا",8,"م",3,0],["وَما اِختَرتُ داراً غَيرَ دارِكَ مِن قِلاً","وَأَينَ تُرى قَصدي وَمِن خَلفِيَ البَحرُ",9,"ر",1,0],["وَما أَخشى تَعَذُّرَ ما أُعاني","مِنَ الحاجاتِ إِذ أَمسى مُعيني",10,"ن",2,0],["وَما إِختِياري جاراً سِواكَ سِوى ال","عَجزِ أَجَنَّت رَوِيَّتي جُنَنُه",11,"ن",2,0],["وَما أُخمِدَت نارٌ لَنا دونَ طارِقٍ","وَلا ذَمَّنا في النازِلينَ نَزيلُ",12,"ل",1,0],["وما أَخْشَى عَلَى أَمْوَالِ مِصْرٍ","سِوَى مِنْ مَعْشَرٍ يَتَأَوَّلُونا",13,"ن",2,0],["وما اخترْتَه حتى صفا ونفى القَذى","بلِ اللّهُ في أُمِّ الكتابِ تخيَّرا",14,"ر",2,0],["وَما أَختارُ أَنّي المَلكُ يُجبى","إِلَيَّ المالُ مِن مَكسٍ وَخَرجِ",15,"ج",1,0],["وَما أَخَذَ العَقلَ مِن أَهلِهِ","وَإِن هُوَ غَرَّ اللَمى وَالشَنَب",16,"ب",1,0],["وَما اِختِيالُ مَغانيها بِمُنقِصَةٍ","إِذ لَيسَ ذَلِكَ مِن عُجبٍ وَلا بَطَرِ",17,"ر",1,0],["وَما أَخلَيتَ مِن سُقمٍ","يَفُضُّ الجِسمَ قُرحانَك",18,"ك",1,0],["وَما اِخترع الإنسان آلات فتكه","بآخر إلا وَالحياة هي العذر",19,"ر",1,0],["وما أخطأ الطيفُ ألوانَه","ولكنهُ اللهَبُ الأحمرُ",20,"ر",1,0],["وَمَا أُخْفِيهِ مِنْ وَجْدِي","وَحُزْنِي فَوْقَ مَا أَصِفُ",21,"ف",1,0],["وما أخْنى عليه الداء لكن","شجاعتُه هي الداء العُضال",22,"ل",1,0],["وما اختلفت عصورٌ عن عصورٍ","نعم غطَّى على الصُوَرِ الطِّلاء",23,"ا",2,0],["وَما اخترْتُ داراً غَيرَ دارِكَ من قِلًى،","وَأينَ ترَى قَصْدي وَمن خلفيَ البَحْرُ",24,"ر",1,0],["وما أختارُ أني المَلْكُ يُجبا،","إليّ، المالُ من مَكسٍ وخَرْجِ",25,"ج",1,0],["وما اختار قلبي بعده وحياته","من الناس في هذا الوجود حبيبا",26,"ب",2,0],["وما أُخاصم في غير الإله فتىً","إِليكَ لو خلتهُ للروحِ مُنتهبا",27,"ب",2,0],["وما أخادعه إلا تخادع لي","كأنه الجد وهو الهزل والضحك",28,"ك",1,0],["وما أخذتهم فيك بعض حمية","ولا أنفوا بل ظاهروهم وحزبوا",29,"ب",3,0],["وَما اِختَرتُ خِلّاً مِنهُمُ أَتَّقي بِهِ","زَمانِيَ إِلّا اِشتَقتُ أَن أَتَبَدَّلا",30,"ل",2,0],["وَما أَخَذت كلُّ المذاهبِ عندنا","بِغيرِ كتابِ اللَّه والسنّةِ الغرّا",31,"ر",2,0],["وما أخرتني في بني الدهرِ شيمةٌ","بلى ومتى أطلقتُ للسبقِ أسبقِ",32,"ق",1,0],["وما اختار للنفس الهلاك محكما","عليها ظلوم اللحظ من كان منصفا",33,"ف",2,0],["وما اختلفا بالنوع حتى يظن ما","به اختلفا فعلاً لخلق الغريزة",34,"ه",1,0],["وَما أَخَّرتَ مِن دُنياكَ نَقصٌ","وَإِن قَدَّمتَ كانَ لَكَ الزَكاءُ",35,"ا",2,0],["وَما اِختَلَفَت دَواعينا وَكانَ الص","صَلاحُ بِها وَما ظَهَرَ الفَسادُ",36,"د",1,0],["وَما اِختَفى الصُبحُ عَنّي يا مُنى أَمَلي","لَكِنَّما السَقمُ عَن عَينَيَّ أَخفاكِ",37,"ك",1,0],["وما إخالُكِ يا دُنْيا بمُنكرةٍ","أَن كنتِ من قبلُ عُطْلاً وهْو حَلاّك",38,"ك",1,0],["وَما أَخافُ مِنَ الأَيّامِ تَغلِبُني","إِذا أَمَرتَ بِنَصري كانَ لي الغَلَبُ",39,"ب",1,0],["وَما أَخصَبتَ يا نَورَ الأَقاحي","وَإِن أَجدَبتَني إِلَا لِمَطرَه",40,"ر",2,0],["وَما أَخشى عَلَيكَ عِثارَ سَبقِ","أَيَخشى نَيِّرُ الآفاقِ عَثرَه",40,"ر",2,0],["وَما أَخلَيتُكُم مِن ذِكرِ خَيرٍ","فَلِم تُخلونَ مِنّي خَيرَ ذِكرِ",41,"ر",1,0],["وَما أَخرَجتُ مِن صُندوق مالي","نَقَلتُ بِهِ إِلى صُندوقِ عُمري",41,"ي",1,0],["وما أَخَذَتهُ نَفسُه إِذ طَرَقتُه","بِما تأخذُ النَّفسُ الكَريمَةُ مُكرما",42,"م",2,0],["وما أخذ الأوقاف قط ولا اشتكت","مساجدنا في عصره كفَّ قادر",43,"ر",1,0],["وما اختلس الدهر من لَذَّةٍ","لعهدَ الصبابة واغتالها",44,"ل",3,0],["وما أخْلَفَتْ إلاَّ فؤاداً ولوعةً","هما أسقما هذا الفؤاد وأوجعا",45,"ع",2,0],["وما أخْلَفَتْ تلك النجومُ بصيّبٍ","من المُزنِ مرجوٍّ بتلك المواسم",46,"م",1,0],["وما اخترطت غير القتاد يدي بها","وغيري جنت من شوكها يده الوردا",47,"د",2,0],["وما اختصَّك السُّلطان إلاَّ لعلمه","بأنَّك لن تُرشى ولن تتبرطلا",48,"ل",2,0],["وما أخشاه في الداري","ن يا مولاي توقيني",49,"ي",1,0],["وما أخلفوا أن يُحلِّي الزما","نَ منهم أميرٌ ومستوزَرُ",50,"ر",1,0],["وما أخشى بفضل أبي سعيدٍ","أجارَ الدهرُ أمْ خَوَتٍ النُّجوم",51,"م",1,0],["وما أخذت مني الحوادث نخوةً","ونفساً أبت إلاّ لحاق الأوائل",52,"ل",1,0],["وما أخو يومه بكاظمة الشو","ق سوى ليلتي على إضمه",53,"م",2,0],["وما اخترتُ ولا خُيِّرتُ فيما","أنا فيهِ ولا يوماً سُئِلْتُ",54,"ت",1,0],["وما أُخْفيْ وما لم أُخفِ عنكِ","أليس الشِّعرُ بيتاً للسرائرْ؟",55,"ر",1,0],["وما أخلقتْ منه اللّيالي وإنّه","جديدٌ على مرّ المدى المتطاولِ",56,"ل",1,0],["وما أخذ الدّهرُ إلّا الّذي","أعاد فكيف تلوم المُعيرا",57,"ر",2,0],["وما أخّرَ النَّظْمَ الّذي كنتَ خاطباً","به بين هذا الخلق في كلِّ مشهدِ",58,"د",1,0],["وما اختفى عنك فاكفف عنه قولك في","سر وجهر ولا تجعل به زللا",59,"ل",2,0]]}