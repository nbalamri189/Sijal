abudhabi.ae/diwan/poem/28307","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103977","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103819","الطويل"],[3631,"","https://poetry.dctabudhabi.ae/diwan/poem/144740","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205542","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216425","الوافر"],[3939,"","https://poetry.dctabudhabi.ae/diwan/poem/146244","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119464","الوافر"],[164,"","https://poetry.dctabudhabi.ae/diwan/poem/127644","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127236","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45046","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58147","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136379",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5156,"وما أخذت كفي بقائم نصله","https://www.poetsgate.com/ViewPoem.aspx?id=99154",""],[5246,"تقلب الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=187046",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5419,"وهل في الشعر يا أم ارحميني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=32254",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5431,"يكاد يُضيئ...","https://www.poetsgate.com/ViewPoem.aspx?id=214558",""],[5458,"الاخلاق قبل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=72160",""],[5582,"أَبَرْقَ الأَبْرَقَيْنِ أَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63574",""],[5653,"لَعَلَّكَ بالوادي المُقَدَّسِ شاطىء ُ","https://www.poetsgate.com/ViewPoem.aspx?id=26369",""],[5909,"يا فرحة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=215604",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""]],"verses":[["وما اخْضَرّ ذاكَ الخَدُّ نَبْتاً وإنّما","لكَثْرَةِ ما شُقّتْ عليْهِ المَرائِرُ",0,"ر",1,0],["وَما إِخوَةٌ شَتّى النِجارِ فَمِنهُمُ","نَبيهٌ وَمِنهُم خامِلٌ ما لَهُ ذِكرُ",1,"ر",1,1],["وما أخفاه بين القوم إلا","ضناه وربما نفع السقام",2,"م",1,0],["وما اختلفوا لمصلحة ولكن","ليأكل أقوياؤهم الضعافا",3,"ف",2,0],["وما أخذ اللّه العهود على الورى","بأن يعلَموا حتى قضى أن يُعلِّموا",4,"م",3,0],["وَما أَخوكَ الَّذي يَدنو بِهِ نَسَبٌ","لَكِن أَخوكَ الَّذي تَصفو ضَمائِرُهُ",5,"ر",2,0],["وما أخٌ بقريبٍ حينَ تحجُبُه","نبائثُ الأرضِ في مُنهاله الجالِ",6,"ل",1,0],["وَما أَخشى نُبوَّكَ عَن طَريقٍ","وَسَيفُ الدَولَةِ الماضي الصَقيلُ",7,"ل",1,0],["وَما أَخُصُّكَ في بُرءٍ بِتَهنِئَةٍ","إِذا سَلِمتَ فَكُلُّ الناسِ قَد سَلِموا",8,"م",3,0],["وَما اِختَرتُ داراً غَيرَ دارِكَ مِن قِلاً","وَأَينَ تُرى قَصدي وَمِن خَلفِيَ البَحرُ",9,"ر",1,0],["وَما أَخشى تَعَذُّرَ ما أُعاني","مِنَ الحاجاتِ إِذ أَمسى مُعيني",10,"ن",2,0],["وَما إِختِياري جاراً سِواكَ سِوى ال","عَجزِ أَجَنَّت رَوِيَّتي جُنَنُه",11,"ن",2,0],["وَما أُخمِدَت نارٌ لَنا دونَ طارِقٍ","وَلا ذَمَّنا في النازِلينَ نَزيلُ",12,"ل",1,0],["وما أَخْشَى عَلَى أَمْوَالِ مِصْرٍ","سِوَى مِنْ مَعْشَرٍ يَتَأَوَّلُونا",13,"ن",2,0],["وما اخترْتَه حتى صفا ونفى القَذى","بلِ اللّهُ في أُمِّ الكتابِ تخيَّرا",14,"ر",2,0],["وَما أَختارُ أَنّي المَلكُ يُجبى","إِلَيَّ المالُ مِن مَكسٍ وَخَرجِ",15,"ج",1,0],["وَما أَخَذَ العَقلَ مِن أَهلِهِ","وَإِن هُوَ غَرَّ اللَمى وَالشَنَب",16,"ب",1,0],["وَما اِختِيالُ مَغانيها بِمُنقِصَةٍ","إِذ لَيسَ ذَلِكَ مِن عُجبٍ وَلا بَطَرِ",17,"ر",1,0],["وَما أَخلَيتَ مِن سُقمٍ","يَفُضُّ الجِسمَ قُرحانَك",18,"ك",1,0],["وما اختصني من بين ظهري محارب","بصحنة غير الأروع المتلذع",19,"ع",1,1],["وَما اِخترع الإنسان آلات فتكه","بآخر إلا وَالحياة هي العذر",20,"ر",1,0],["وما أخطأ الطيفُ ألوانَه","ولكنهُ اللهَبُ الأحمرُ",21,"ر",1,0],["وَمَا أُخْفِيهِ مِنْ وَجْدِي","وَحُزْنِي فَوْقَ مَا أَصِفُ",22,"ف",1,0],["وما أخْنى عليه الداء لكن","شجاعتُه هي الداء العُضال",23,"ل",1,0],["وما اختلفت عصورٌ عن عصورٍ","نعم غطَّى على الصُوَرِ الطِّلاء",24,"ا",2,0],["وَما اخترْتُ داراً غَيرَ دارِكَ من قِلًى،","وَأينَ ترَى قَصْدي وَمن خلفيَ البَحْرُ",25,"ر",1,0],["وما أختارُ أني المَلْكُ يُجبا،","إليّ، المالُ من مَكسٍ وخَرْجِ",26,"ج",1,0],["وما اختار قلبي بعده وحياته","من الناس في هذا الوجود حبيبا",27,"ب",2,0],["وما أُخاصم في غير الإله فتىً","إِليكَ لو خلتهُ للروحِ مُنتهبا",28,"ب",2,0],["وما أخادعه إلا تخادع لي","كأنه الجد وهو الهزل والضحك",29,"ك",1,0],["وما أخذتهم فيك بعض حمية","ولا أنفوا بل ظاهروهم وحزبوا",30,"ب",3,0],["وَما اِختَرتُ خِلّاً مِنهُمُ أَتَّقي بِهِ","زَمانِيَ إِلّا اِشتَقتُ أَن أَتَبَدَّلا",31,"ل",2,0],["وَما أَخَذت كلُّ المذاهبِ عندنا","بِغيرِ كتابِ اللَّه والسنّةِ الغرّا",32,"ر",2,0],["وما أخرتني في بني الدهرِ شيمةٌ","بلى ومتى أطلقتُ للسبقِ أسبقِ",33,"ق",1,0],["وما اختار للنفس الهلاك محكما","عليها ظلوم اللحظ من كان منصفا",34,"ف",2,0],["وما اختلفا بالنوع حتى يظن ما","به اختلفا فعلاً لخلق الغريزة",35,"ه",1,0],["وَما أَخَّرتَ مِن دُنياكَ نَقصٌ","وَإِن قَدَّمتَ كانَ لَكَ الزَكاءُ",36,"ا",2,0],["وَما اِختَلَفَت دَواعينا وَكانَ الص","صَلاحُ بِها وَما ظَهَرَ الفَسادُ",37,"د",1,0],["وَما اِختَفى الصُبحُ عَنّي يا مُنى أَمَلي","لَكِنَّما السَقمُ عَن عَينَيَّ أَخفاكِ",38,"ك",1,0],["وما إخالُكِ يا دُنْيا بمُنكرةٍ","أَن كنتِ من قبلُ عُطْلاً وهْو حَلاّك",39,"ك",1,0],["وَما أَخافُ مِنَ الأَيّامِ تَغلِبُني","إِذا أَمَرتَ بِنَصري كانَ لي الغَلَبُ",40,"ب",1,0],["وَما أَخصَبتَ يا نَورَ الأَقاحي","وَإِن أَجدَبتَني إِلَا لِمَطرَه",41,"ر",2,0],["وَما أَخشى عَلَيكَ عِثارَ سَبقِ","أَيَخشى نَيِّرُ الآفاقِ عَثرَه",41,"ر",2,0],["وَما أَخلَيتُكُم مِن ذِكرِ خَيرٍ","فَلِم تُخلونَ مِنّي خَيرَ ذِكرِ",42,"ر",1,0],["وَما أَخرَجتُ مِن صُندوق مالي","نَقَلتُ بِهِ إِلى صُندوقِ عُمري",42,"ر",2,0],["وما أَخَذَتهُ نَفسُه إِذ طَرَقتُه","بِما تأخذُ النَّفسُ الكَريمَةُ مُكرما",43,"م",2,0],["وما أخذ الأوقاف قط ولا اشتكت","مساجدنا في عصره كفَّ قادر",44,"ر",1,0],["وما اختلس الدهر من لَذَّةٍ","لعهدَ الصبابة واغتالها",45,"ل",3,0],["وما أخْلَفَتْ إلاَّ فؤاداً ولوعةً","هما أسقما هذا الفؤاد وأوجعا",46,"ع",2,0],["وما أخْلَفَتْ تلك النجومُ بصيّبٍ","من المُزنِ مرجوٍّ بتلك المواسم",47,"م",1,0],["وما اخترطت غير القتاد يدي بها","وغيري جنت من شوكها يده الوردا",48,"د",2,0],["وما اختصَّك السُّلطان إلاَّ لعلمه","بأنَّك لن تُرشى ولن تتبرطلا",49,"ل",2,0],["وما أخشاه في الداري","ن يا مولاي توقيني",50,"ن",2,0],["وما أخلفوا أن يُحلِّي الزما","نَ منهم أميرٌ ومستوزَرُ",51,"ر",1,0],["وما أخشى بفضل أبي سعيدٍ","أجارَ الدهرُ أمْ خَوَتٍ النُّجوم",52,"م",1,0],["وما أخذت مني الحوادث نخوةً","ونفساً أبت إلاّ لحاق الأوائل",53,"ل",1,0],["وما أخو يومه بكاظمة الشو","ق سوى ليلتي على إضمه",54,"م",2,0],["وما اخترتُ ولا خُيِّرتُ فيما","أنا فيهِ ولا يوماً سُئِلْتُ",55,"ت",1,0],["وما أُخْفيْ وما لم أُخفِ عنكِ","أليس الشِّعرُ بيتاً للسرائرْ؟",56,"ر",1,0],["وما أخلقتْ منه اللّيالي وإنّه","جديدٌ على مرّ المدى المتطاولِ",57,"ل",1,0],["وما أخذ الدّهرُ إلّا الّذي","أعاد فكيف تلوم المُعيرا",58,"ر",2,0],["وما أخّرَ النَّظْمَ الّذي كنتَ خاطباً","به بين هذا الخلق في كلِّ مشهدِ",59,"د",1,0],["وما اختفى عنك فاكفف عنه قولك في","سر وجهر ولا تجعل به زللا",60,"ل",2,0],["وما اختلفتْ حالانِ إلاّ رأيتَهُ","رَكوبَ التي تَسْبي هَيُوبَ التي تُزري",61,"ر",2,0],["وَما أَخفَيتُ في التَّسئالِ إلاَّ","لأَعلَمَ كَيفَ نَعمانٌ وَنُعمُ",62,"م",1,0],["وما اختبارٌ كأخبارٍ وما مَلِكٌ","إلاَّ ابنُ مَعْنٍ وَذَرْ قوماً وما ذَرَأوا",63,"ا",1,0],["وما أَخَّرَتْني عن تَناهٍ مبادئُ","ولا قَصَّرَتْ بِي عن تَباهٍ مَناشئُ",64,"ا",1,0],["وَما أَخذُهُ إِيّاه إِلّا لِجَعلِهِ","لَكُم فَرطاً يجدي وَمِن أَنفَعِ الذّخرِ",65,"ر",1,0],["وما اخترتُ إلاّ جراحَ العراق","بها نازفٌ وهيَ تنزفُ بي",66,"ب",2,0],["ومَا أخفَّ ثقيلاتِ الحُمولِ إذا","تقاسَمَتْ حِملَها الأكتافُ والظُعُنُ",67,"ن",1,0],["وما اختار هول البحر إلا لأنه","رأي موجه من موج سيفك أسلما",68,"م",2,0],["وَمَا اخْتَلَفَتْ فِيهِ جَمِيعُ الشَّرَائِعِ","شَرِيعَتُهُ مِنْهَا الْعُلُومُ تَفَرَّعَتْ",69,"ت",1,0],["وما أخذ الرحمن من خلقه فلا","هضيمةَ والانسان بالقتل يُهضَمُ",70,"م",1,0],["وما أخلفتهم في الإِله ظنونهم","إذا أخلفتهم في الرجال ظنون",71,"ن",1,0],["وما اخضرَّ إِلا دليلاً على","اخضرار الحياة وفيض النعم",72,"م",1,0],["وما أخشى قُصُوراً عن مرامٍ","ومثلُك لي إلى الدنيا شفيعي",73,"ي",1,1],["وما اخترتَ إلا خيرَ حيٍّ نعُدّهُ","أجلَّ الورى قدراً وكان المُقَدَّرا",74,"ر",2,0],["وَمَا اختَرتُ هَذَا البُعدَ إِلا ضَرُورَةً","وَهَل تَستَجِيزُ العَينُ أَن تَفقِدَ الشَّفرَا",75,"ر",2,0],["وَما أَخَذَت في أَوَّلِ الأَمرِ عُصبَةٌ","لَنا صَفِرَت مِن نُصحِ جَيبٍ عِيابُها",76,"ب",3,0],["وما أخذتهم الأسياف لكن","صواعق لا يبوح لها ضرام",77,"م",1,0],["وما أخوهُ عديٌّ إذ يقومُ بها","يومَ الذْنائبِ في وَهْنٍ ولا هون",78,"ن",1,0],["وما أخملوني لكنِ المجدَ أَخْمَلُوا","وما ضَيّعُوني لكنِ العلمَ ضيعوا",79,"ع",3,0],["وَما إِختَلَجَت عَينايَ إِلّا رَأَيتُها","عَلى رُغمِ واشيها وَغَيظِ الكَواشِحِ",80,"ح",1,1],["وما أخرتني عنك النجو","م يا غرة القرمر اللائح",81,"ح",1,0],["وما أخطأَت خيرَ الثلاثةِ عندَها","ولا قصَّرت عن خيرِهم عندَنا بَعدُ",82,"د",1,0],["وَما أَخي بِالَّذي يَرضى بِمُنقِصَتي","وَلا الَّذي يُظهِرُ البَغضاءَ وَالمَرضا",83,"ض",2,0],["وما اخفيت مكنونات قلبي","فدمع العين باح بكل سر",84,"ر",1,0],["وَما أَخَلَّ وَصيُّ الأَوصياءِ بِهِ","مُحَمَّدُ بنُ عَليٍّ نورُهُ الصَدِعُ",85,"ع",1,0],["وما اختارك السلطان حتى كفيته","أموراً لها عبء على المتحمل",86,"ل",1,0],["وما أخرجت نحلٌ لنا من بطونها","مصفّى لنا فيه الشفاء من الضرّ",87,"ر",1,0],["وما اختَلَفَت غيرُ عينٍ تراها","شقاءً وعينٍ تراها هناءَ",88,"ا",2,0],["وما اختياري كان طوع النوى","لكنّني أجري على بغيتك",89,"ك",1,0],["وما أخالك تنساني إذا برزت","نار الجحيم وقلت عندها حيلي",90,"ل",2,0],["ومَا اختلاطي بِهُمُ","هذا أشدَّ العجب",91,"ب",1,0],["وَما أخت صَخر يَوم أَودى اِبنُ أمها","فَأَبدَت لِأَهل الحَي خافي شُجونها",92,"ن",3,0],["وما اختار غير الله والحق وجهة","فكان له من لفظه الفتح والنصر",93,"ر",1,0],["وَما اِختارَهُ إِلا لِتَأييد مُلكه","وَإِن البَرايا دُونَهُ بُرهان",94,"ن",1,0],["وما اختص من شخص بشيء الا هما","سواء لدى اكل وشرب وفي غير",95,"ر",1,0],["وما أخطأت من نشب فمما","رمى فأصابني حظ الأديب",96,"ب",1,1],["وما أخشى على قلبي نفادا","عليهم كلهم أخشى نفادا",97,"د",2,0],["وما أخشى الفنا للخلق لكن","أخاف يساور الفن الفناء",98,"ا",2,1],["وما أخَينس جعفي بمانعه","من المتاع قيام الليل بالطّول",99,"ل",1,0],["وما اخترت نهج البحر أبغي ترفها","ولكن لضعف عن ركوب اليعامل",100,"ل",1,0],["وما اختلفت سبل الهوى غير انني","أواصل نهجاً فيه تأتلف السبل",101,"ل",1,0],["وما أخضل الاسلام حتى فجعته","بداهية أخنت على الطهر صيلم",102,"م",1,0],["وما اختطك المنصور للناس بلدة","ولكنه للعلم داراً قد اختطا",103,"ط",2,0],["وما أخرت مدحي عن","ك من عجز ولا خور",104,"ر",1,0],["وَما أَخافُ هَلاكاً بَينَ عَفوِهِما","وَما يَفوتُهُما المُستَوهِل السارِي",105,"ر",2,0],["وَمَا اختَصَّ عِلمٌ دُونَ عِلمٍ بِوِجهَتِي","بَلَى مَسرَحِي فِي كُلِّهَا الوَاسِعُ الخَصب",106,"ب",1,0],["وما اختص علم دون علم بوجهتي","بل مسرحي في كلها الواسع الخصب",107,"ب",1,0],["وما أَخْرَجَتْنَا رَغْبَةٌ عن بلادنا","ولكنه مَا قَدَّرَ اللهُ كائِنُ",108,"ن",1,0],["وما اختيارك إلا ما خُلِقتَ له","إن الطبائع ما ترضاه ترضاهُ",109,"ا",2,0],["وما أخطأت في لوميك يومًا","وقد أخطأت في عذريك حينَا",110,"ن",2,0],["وما اخترت قول الشافعي ديانة","ولكنما تهوى الذي هو حاصل",111,"ل",1,0],["وَما اِختارَ مِنها غَيرُ بلغة أَهلها","وَشَمَّ الرَواسي لَو يَشاءُ هِيَ النَقدُ",112,"د",1,0],["وما اخلاك منك الملك الا","ليبلو من عداك بما بلاكا",113,"ك",2,0],["وما اختارك الرحمن إِلا لعلمهِ","بأَنك خيرٌ نيةً وفعالا",114,"ل",2,0],["وما أخت صخر حين رق سمية","غدات رأى منها المدامع كاليم",115,"م",1,0],["وَما أَخُصّكَ في بُرءٍ بِتَهنِئَةٍ","قَد سُرّ مِنها الوَرى وَالسَهلُ وَالعَلَمُ",116,"م",1,0],["وما اختلفتْ تلك الرياحُ لواقْحا","وما لاحَ قُمْرِيُّ الأراكِ تَرَنُّمَا",117,"م",2,0],["وما اخترت إلا اخترت في الأمر قوله","وأحمدت إذا أمضيت عاقبة الأمر",118,"ر",1,0],["وما اخترقت سكين شيلوك مهجةً","من العرب إلا عدك العرب جانيا",119,"ي",2,0],["وما أخذت كفي بقائم نصله","فحدثت نفسي بانهزام ولا فر",120,"ر",1,1],["وما أخطأ الدَّبورُ وقتَ قدومِهِ","يقاتلُ في تحصيلِ حظٍّ من التمر",121,"ر",1,0],["وما أخذوا إلاَّ بصدق ولم يكن","بمكر ولا خدع وليس لنا خلقا",122,"ق",2,0],["وما أخطأت في الرمي كفي من العلى","أضاميم سرب بالسهام الصوائب",123,"ب",1,0],["وما أخلفتُ وعديَ ذات يومٍ","ولو غُيِّبتُ في أعتى السجونِ",124,"ن",1,0],["وماآخرُ العشق الجموح سوى الردى","تولهُ حلاجٍ ووجدٌ مدروشُ",125,"ش",1,0],["وما اخضرّت مزارعُ حامداتٌ","عتى فيها الجرادُ وقد تتالى",126,"ل",2,0],["وما اختير النبيُّ لفضل علمٍ","وبالأخلاق دان له الجميع",127,"ع",1,0],["وَما أُخْفِيهِ إِلاَّ قَدْ","بَدَا جَهْراً وَما انْكَتَما",128,"م",2,0],["وما أخَّرَتْني عن تَنَاهٍ مبادىء","ُ ولا قصرت بي عن تباهٍ مناشئُ",129,"ا",1,0],["وما اختُزِلتِ بثوبٍ قام صاحبُه","يسقي السويداءَ أفراحاً ويغتسلُ",130,"ل",1,0],["وما اختارت الأحزان كبشاً لعيدها","كما اختارت النائين بعد التعانقِ",131,"ق",1,0],["\" وما أخدع الحب الذي في ديارهم","يغشى على أبصارهم والبصائر \"",132,"ر",1,0]]}