ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[5720,"بعثةِ الهادي ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=199217",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5833,"قل للربيع","https://www.poetsgate.com/ViewPoem.aspx?id=197438",""],[5943,"الموت حرقًا","https://www.poetsgate.com/ViewPoem.aspx?id=34329",""],[5956,"ودعتُ حبك","https://www.poetsgate.com/ViewPoem.aspx?id=182478",""],[5956,"حالتان","https://www.poetsgate.com/ViewPoem.aspx?id=183970",""],[5956,"رقابة المطبوعات","https://www.poetsgate.com/ViewPoem.aspx?id=185617",""],[5956,"أبْشِرْ يا شعب","https://www.poetsgate.com/ViewPoem.aspx?id=192074",""],[5956,"خير أمة وخير إقامةِ","https://www.poetsgate.com/ViewPoem.aspx?id=194182",""],[5956,"أرملةٌ حنونٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194737",""],[5956,"شكراً سُمَيّةُ قد أزلتِ مخاوفي","https://www.poetsgate.com/ViewPoem.aspx?id=202641",""],[6097,"لستَ لي","https://www.poetsgate.com/ViewPoem.aspx?id=190677",""],[6152,"ما مال قلبي ولا خانت جوانحه","https://www.poetsgate.com/ViewPoem.aspx?id=213168",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""]],"verses":[["لَكِن رَمَتكَ أَشُدُّ رامِيَةٍ","سَهماً وَأَهداها إِلى العَقرِ",0,"ر",1,0],["لَكِن رَماكَ مُجَبِّنُ الشُجعانِ عَن","إِقدامِهِم وَمُضَعضِعُ الأَنجادِ",1,"د",1,0],["لَكِنْ رَأَيْتُ جَنَابَ شَالَّة مَغْنَماً","يُضْفِي عَلَيَّ الْعِزَّ فِي نَادِيكَا",2,"ك",2,0],["لَكِن رَماكِ جَبانٌ","لَو بانَ لي لَاَشتَفَيتُ",3,"ت",1,0],["لَكِن رَأَيتَ ذَوي الجاهاتِ تَشرَبُها","رِيّاً وَتَتعَبُ في تَحصيلِها العُلَما",4,"م",2,0],["لَكِنْ رَأَيْتَ البِرَّ أَجْمَلَ مَا","تُحْدَى إِلَيْهِ سَوَابِقُ الهِمَمِ",5,"م",1,0],["لَكِنَّ رُوحَكَ فيهِ أوْرَدَتْ مَا خَبِا","مِنْ شُعْلَةٍ فَذَكَتْ وَسَوْفَ تَدُومُ",6,"م",1,0],["لكن رقيت إلى السماء لتجتبى","لله في أعلى السماء رفيقا",7,"ق",2,0],["لكنْ رَفَضْتَ العرفَ مُط","طَرحاً وحَظَّكَ تَطَّرِحْ",8,"ح",1,0],["لكنْ رأى فيك الوزي","رُ كما رأى فيه الأميرُ",9,"ر",1,0],["لكنْ رأيتَ الجودَ أح","سن ما رآهُ الناس منظر",10,"ر",1,0],["لكن رضعت عريقا","للؤم ساء عُريقا",11,"ق",2,0],["لكنْ رمَوْكَ بدُهمِهم وكأنهُم","جيشٌ أجابَ دعاءَ إسرافيلا",12,"ل",2,0],["لَكِن رَأَيتُ الماءَ مُنطَلِقاً","رَياً فَإِن هُوَ لَم يَسِر أَجَنا",13,"ن",2,0],["لَكِن رَأَيتُ قَبيحاً أَن يُجادَلَنا","وَأَنَّنا بِقَضاءِ الحَقِّ بُخّالُ",14,"ل",1,0],["لكنْ رأته مُحارباً أموالَه","بنَوالِه فَجَرَتْ على عاداتِها",15,"ت",3,0],["لكن رجعنا وظلُّ","الشبابِ في اضمحلالِ",16,"ل",1,0],["لكنَّ رَبِّي أرادَ الحَرْبَ مُجْهِدَةً","وَالنَّفْسُ تَطْهُرُ إنْ عَوَّدْتَهَا الجُهُدَا",17,"د",2,0],["لكنْ رأيتُ سِماتِ الخيرِ ضائعةً","في الشرِّ كاللثغِ بين السينِ والشين",18,"ن",1,0],["لَكِنَّ رَبّي كانَ قَدَّرَهُ","فَقَضاءُ رَبّي أَفضَلُ الحُكمِ",19,"م",1,0],["لَكِن رَأَيتُ مِنَ السُكوتِ بَديهَةً","فَشَدَدتُ وَصلَكُمُ بِتَركِ جَوابي",20,"ب",2,0],["لكِنْ رُزئنا القاسِمَ بْنَ مُحمدٍ","في فَضْلِهِ والأسْوَدَ بْنَ يَزيدا",21,"د",2,0],["لَكِنَّ رَبَّكَ رَدَّ مَا أَعْطَى","وَعَجَّلَ بِالثَّوَابْ",22,"ب",1,0],["لِكنْ رَآكَ اللهُ أَجْدَرَ","بِالسَّعَادَةِ فَاصْطَفَاكْ",23,"ك",1,0],["لَكِن رَأَيتُكِ قَد مَلِلتِ زِيارَتي","فَعَلِمتُ أَنَّ دَواءَكِ الهِجرانُ",24,"ن",1,0],["لكن رُزِقْتَ بثروةٍ","ورُزِئْتُ بالفقر الشديد",25,"د",1,0],["لكن رزقتَ مَهَارة الصِّهْ","يَوْنِ في جمع النقود",25,"د",1,0],["لكن رأى زمراً تمور وعالماً","خلط الظلال هديره بِرُغائه",26,"ا",3,0],["لكن رجوتك إذ سلبت الخير إن","تسلى به ويعود عن تسليبه",27,"ب",2,0],["لَكِن رَأَيتُ اِمتِداحيكُم بِسالفِكُم","في الجاهِلِيَّةِ نَفسُ العيِّ وَالخَطَلِ",28,"ل",1,0],["لَكِن رَأَيتُ خَلائِقاً ما خِلتُني","أَحظى بِرُؤيَةِ مِثلِها في ذا المَلا",29,"ل",2,0],["لَكِنَّ رَبَّ الهَوى وَالحُبّ مُتَّهَمٌ","ما زالَ مُحتَذِراً طَوراً وَمَحذورا",30,"ر",2,0],["لكنْ رأتْ شرفَ الإقرارِ وهْولها","أَمنٌ أجلُّ من الإنكارِ والخَطر",31,"ر",1,0],["لكن رأى المجدَ مطلوباً فهبَّ له","ومن يكُن عارفاً بالقَصدِ لم يَخِبِ",32,"ب",1,0],["لكن رامة والعقيق وبانة","وقباب سلع قصده المترسخ",33,"خ",1,0],["لَكِن رَجاءَ ثَوابِ اللَهِ يَبعَثُهُ","عَلى المَراحِمِ لا فَضلي وَلا أَدَبي",34,"ب",2,0],["لكن رموز حساب يُستَّدل بها","ما ينبغي أننا فيها نسفههُ",35,"ه",1,0],["لكِنَّ رأُيَ الشَّافِعِيِّ","نتائجُ السُّنَنِ الحَنيفَهْ",36,"ف",2,0],["لكِنْ رأى تلكَ النَّضارَةَ قد ذَوَتْ","لَمَّا غَدا ماءُ الشَّبيبةِ نَاضِبَا",37,"ب",2,0],["لكنَّ رأيَكَ أدنَاهُم وأبْعَدَني","فليتَ أنَّا بِقَدْرِ الحبِّ نَقْتَسِمُ",38,"م",1,0],["لكن رأيت لك المديح مثوبةً","فمَحَوْتُ في إثباتها آثامي",39,"م",2,0],["لكن ركْبتُ الى السِّلوِّ ولم أقُلْ","أعزِزْ عليّ بفرقةِ الخُلَطاءِ",40,"ا",2,0],["لكن رب القصر جل جلاله","إذ كان ينظر نظرة العرفان",41,"ن",1,0],["لكن رآكَ هُماماً في مَطالبِهِ","يثني بما نلته نادٍومُعْتركُ",42,"ك",1,0],["لكن رأيناك في أولى وثانية","لم تأخذ الملك إلا أخذ قهار",43,"ر",1,0],["لكن رأيتُه أجفَلا","وأشار هاهو أقبَلا",44,"ا",1,0],["لكن رجائي فيكَ يغلِبُ دائماً","خَوفي لِسَطوَتِكَ الَّتي هِيَ أَعظَمُ",45,"م",1,0],["لكن رأيتُ حقيقةً فشَكرتُها","والحُرُّ مَن هو للِحقيقةِ شاكرُ",46,"ر",1,0],["لكن رأَيتُ الشهبَ ساعةَ خَطْفِها","فرأَيتُ فيها من ذَكاةُ مُشابِها",47,"ب",3,0],["لَكنْ رَأَى قَلْبي يَزيدُ بِقُرْبِهِ","صَدْعاً فأَشفَقَ إِن دَنَا أَنْ يُصْدَعا",48,"ع",2,0],["لكن رماهم فأودى من رماه فقد","لاقى المنون ولاقى ضرب مقدام",49,"م",1,0],["لكن رجوتُ لما يَمَّمت من حسنٍ","محض القبول بميلٍ يوجبُ الوهبا",50,"ب",2,0],["لَكِن رَجاءُ لِقا قاضي القضاة جَلا","لِ الدين حَثَّ عَلى أَوبي من السفرِ",51,"ر",1,0],["لكن رجائي أَن أَراكَ وخشيتي","مِن أَن تُقبِّحَني الذَّنوبُ فأهجَرُ",52,"ر",1,0],["لَكِن رَجائي بِأَن تُحبى بِعافِيةٍ","مَدى الزَّمانِ لَنا تُرضِي وتُرضيكا",53,"ك",2,0],["لَكِنَّ ربّي لَطيفٌ وَهوَ ذو كَرَمٍ","قَد مَنَّ سُبحانَهُ مِن لُطفِهِ فيكا",53,"ك",2,0],["لَكِنَّ رَبَّ الخلقِ في هَذا قَضى","وَهوَ الحكيمُ وَلَم يَكُن بِالجائِرِ",54,"ر",1,0],["لَكن رَأى في سَيرِهِ خنزيرا","وَكانَ فَظّاً عاتِياً كَبيرا",55,"ر",2,0],["لَكنَّ رَب الغيط للكَلب اِحتَقَر","وَراحَ لَمَّ عُصبَةً مِن البَشَر",56,"ر",1,0],["لَكنَّ رَبّي ذو اِنتِقام أَبَدا","لَم يُنج قَطُّ مِن بَنيكُم أَحَدا",57,"د",2,0],["لكنّ رَبّي الكَريم القادر","أَعانَني صِدق قَول الشاعِر",58,"ر",1,0],["لكن رغبت بمنزلي عن موطن","آثار فسقك منه ليست تذهب",59,"ب",1,0],["لكن رَبَعت بمربع","لا ماء فيه ولا سكنْ",60,"ن",1,0],["لكن رحمة ربنا","تعلو العذاب وتغلب",61,"ب",1,0],["لكن رأيت العلم نوراً ساطعاً","متألقاً في عالمٍ مفضال",62,"ل",1,0],["لكن رحى الأقدار لا تجري على","قطب مراد أحد من الملا",63,"ل",2,0],["لَكِنْ رَمَؤْكُمْ بِشَيْخ مِنْ ذَوِي يَمَن","لَمْ يَدْرِ مَا ضَرْبُ أخْمَاس لأسْدَاسِ",64,"س",1,0],["لكِنَّ رُضابَهُ يَقيْهِ","مِنْ لَدْغِهِما فَلَيسَ يَرْهَبْ",65,"ب",1,0],["لكن رأى وجهه فيها أعجبه","جمالهُ فأطالَ الحملَ للكاسِ",66,"س",1,0],["لكن رأيتُكِ أهلَ كلِّ فضيلةٍ","وحَقَرتُ مدحي عن أقلِّ عُلاكِ",67,"ك",1,0],["لَكِن رَأَيتُ نَبِيَّنا قَد عابَهُ","مِن كُلِّ ثَرثارٍ وَأَشدَقَ شاعِرِ",68,"ر",1,0],["لكن رأى شَرفَ المصاهر فاغتَدى","يُهدي إليك لُبَابه المكتوما",69,"م",2,0],["لكن رأيت الإحتمال","لما عرا أوفى ثوابا",70,"ب",2,0],["لكن ربك صان شخصك من أذى","وحباك حصناً ثابتَ الأركانِ",71,"ن",1,0],["لكن رأيتكَ يبا نصيري جامعاً","نقدَ البصير ودقة النقادِ",72,"د",1,0],["لَكِن رَأى جارَهُ ذا اللُّجِّ يَحمِلُهُ","فَكانَ ما كانَ بَينَ العِيِّ وَالفَشَلِ",73,"ل",1,0],["لكِن رَأى حَصرَكُم في قَعرِ دارِكُمُ","فيهِ اِحتِقارٌ لكُم أَيضاً وَإِصغارُ",74,"ر",1,0],["لكن رضى انا اقمناها هنا","كشفا برغم الأنف غير تجمجم",75,"م",1,0],["لكن رَجَوْتُ تَشبُّهاً برجالها","آبائِنا العُلَمَا وَمَنْ يُشْبِهْ فَمَا",76,"م",2,0],["لَكِنَّ رَبَّ العَالَمِينَ وجُندَهُ","وَرَسُولَهُ المبعُوثَ بِالقُرآنِ",77,"ن",1,0],["لَكِن رَسُولُ اللهِ خُصَّ نِسَاؤهُ","بِخَصِيصَةٍ عَن سَائِرِ النِّسوَانِ",77,"ن",1,0],["لَكِنَّ رُؤيَتَهُ لِمُوسَى لَيلَة ال","مِعرَاجِ فَوقَ جَمِيعِ ذِي الأكوَانِ",77,"ن",1,0],["لكن رضيتم بالأماني وابتلي","تم بالحظوظ ونصرة الاخوان",77,"ن",1,0],["لَكن رَأوا أنَّ بِدار البَقا","نيلَ الأَمائي لا بِدار الفَنا",78,"ن",2,0],["لكن رأيتُك لا تميل سجيّةً","نحوي ولا تتكلّف الإصغاء",79,"ا",2,0],["لَكنَّ رَيّا ريقِهِ قَد سَرَت","مِنهُ لطَرفٍ قَد حَكى مُرهَفا",80,"ف",2,0],["لكن رآها الذي تهوى وقد نظرت","في وجه آخر فاحمرت من الخجل",81,"ل",1,0],["لكن رأيتُكَ قد ملِلتَ مودَّتي","فعلمتُ أنَّ دواءكَ الهِجرانُ",82,"ن",1,0],["لكن رأى الخلف وخاف صحبه","أن يسلموه إن تكون الوثبه",83,"ه",1,0],["لكن رَجائِيَ فيه غَيرُ مُنقَطعٍ","ما دمتُ نَسلَ نَيٍّ أَصله طابا",84,"ب",2,0],["لكِن رَأَيتُ اللَيالي غَيرَ تارِكَةٍ","ما ساءَ مِن حادِثٍ أَو سَرَّ مُطَّرِدَ",85,"د",1,0],["لكِنّ رِزقي قَد قضى","ما حيلَتي في ما أرُوم",86,"م",1,0],["لَكِن رَجَعتُ وَقَد جَدَّ الزَّمَانُ إلَى","كَنز مِنَ العِلم وَالأخلاَق والأدَب",87,"ب",1,0],["لكنّ راحتَك الكَريمةَ بالنّدى","جادَتْ غَمائِمُ جودِها فأجادَها",88,"د",3,0],["لكن رأيت الحق فوق صنيعه","لو كان حقا بت من نصرائه",89,"ا",3,0],["لكن رأينا الأمر بعد وقوعه","لم يجد نفعا في طلول بنائه",89,"ا",3,0],["لكن روح الله غسلها وما","اشجاه إلا بعدها ورحيلها",90,"ل",3,0],["لكنَّ راحته أو طيب عيشته","بأن تنال يداه الفوز والغلبا",91,"ب",2,0],["لَكن رَأَيت قَبيحاً أَن أَكافئكم","تَقولاً أَو أَحَل البَغي تَحليلا",92,"ل",2,0],["لَكن رَأَيتك لا تُراعي ذمتي","فَأَرَدت عَتبك مجملاً وَمُفَصَلا",93,"ل",2,0],["لكِنَّ رأسي أصلعٌ وتَناطُحُ ال","جَمَّاءِ لم يُحمَد مَعَ القَرناءِ",94,"ا",2,0],["لَكن رَأَيتُ الصَبر يَجمُل بِالفَتى","وَكَما عَلمتَ الحزم مِن أَخلاقي",95,"ق",2,0],["لَكن رَأَيتك فوق ما أَمّلتُه","فلذاك لم يجسر بتهنئة فمي",96,"م",2,0],["لكن ربا سرمدياً قد قضى","الواحد المتكبر المتعالي",97,"ل",2,0],["لكِن رَأَيتُ بِبابِ دارِكَ جَفوَةً","فيها لِصَفوِ صَنيعَةٍ تَكديرُ",98,"ر",1,0],["لَكِن رَأيتُ البَحرَ لاَبِسَ حُلَّةٍ","مِن نَسجِ سُحبِهِ مُوذِناً بِالبَردِ",99,"د",1,0],["لكن ركبت به أجل سفينة","ما إن رأيت بها وحقّك من كدر",100,"ر",1,0],["لكن رجعت وما رجعت بسالم","بل ضمك التابوت في طي الكفن",101,"ن",1,0],["لكن رسول الله يشهد أنني","دوما بجاه جنابه أتوسّل",102,"ل",1,0],["لكنَّ ربّنا لمن شاء هدى","وغيره ليس له هدىً بَدا",103,"د",2,0],["لَكِن رَضيتُ بِقِسمَتي بَينَ الوَرى","وَعَلامَ أَركَبُ جانبيَّ وَاَقتَحِمْ",104,"م",1,0],["لكن رحمتك التي هي عصمة","حفظت قواها يا رحيم يرحم",105,"م",1,0],["لكن رأيت منكم ما أنكرَه","روعي مما لم أطق أن أذكرَه",106,"ه",1,0],["لكن ر