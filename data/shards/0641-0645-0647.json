{"poems":[[53,"أرى بغداد قد أخنى عليها","https://www.aldiwan.net/poem30511.html","الوافر"],[63,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[77,"بك الخطط الرفيعة فلتهنا","https://www.aldiwan.net/poem36039.html","الوافر"],[77,"أمولاي دمت الدهر منصور أعلام","https://www.aldiwan.net/poem36104.html","الطويل"],[77,"جلا الحق قلبي حتى أنارا","https://www.aldiwan.net/poem36501.html","المتقارب"],[77,"تعجلت وخط الشيب في زمن الصبا","https://www.aldiwan.net/poem36564.html","الطويل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[77,"ألا حدثاها فهي أم العجائب","https://www.aldiwan.net/poem36775.html","الطويل"],[71,"ابنا الحرستاني في لقبيهما","https://www.aldiwan.net/poem3832.html","الكامل"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[30,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[11,"هل الدهر إلا اليوم أو أمس أو غد","https://www.aldiwan.net/poem233.html",""],[37,"ألا أبلغ جماعة أهل مرو","https://www.aldiwan.net/poem6907.html","الوافر"],[37,"فمهلا يا قضاعة لا تكوني","https://www.aldiwan.net/poem7432.html","الوافر"],[37,"فمهلا يا قضاع فلا تكوني","https://www.aldiwan.net/poem7473.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[23,"أجدك لم تهتج لرسم المنازل","https://www.aldiwan.net/poem21351.html","الطويل"],[51,"أحب المهرجان لأن فيه","https://www.aldiwan.net/poem7934.html","الوافر"],[51,"ألا يا أيها الشاكر والمطنب في المدح","https://www.aldiwan.net/poem9411.html","الهزج"],[51,"أتاني عتاب من أخ فاغتفرته","https://www.aldiwan.net/poem64967.html","الطويل"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[29,"ألم تشكر لنا كلب بأنا","https://www.aldiwan.net/poem6185.html","الوافر"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[85,"حبرت مقالة جمعت فأوعت","https://www.aldiwan.net/poem7266.html","الوافر"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[62,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[45,"ضمان على عينيك أني لا أسلو","https://www.aldiwan.net/poem65536.html","الطويل"],[28,"ألا استهزأت مني هنيدة أن رأت","https://www.aldiwan.net/poem5472.html","الطويل"],[61,"هل الصبر مجد حين أدرع الصبرا","https://www.aldiwan.net/poem51671.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[87,"دع الهزل واحذر ترهات المنادمه","https://www.aldiwan.net/poem8254.html","الطويل"],[69,"سلام على نفسك الزاكيه","https://www.aldiwan.net/poem29245.html","المتقارب"],[74,"ألا فضلت ذيلها ليلة","https://www.aldiwan.net/poem12853.html","المتقارب"],[74,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[75,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[75,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[48,"وعود كرمة كرخ","https://www.aldiwan.net/poem62558.html","الخفيف"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[46,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54203","الطويل"],[45,"ضَمَانٌ عَلَى عَيْنَيْكِ أنّيَ لا أسْلُو","https://www.poetsgate.com/ViewPoem.aspx?id=32201",""],[101,"طَرِيقُ الْعُلاَ وَعْرٌ مَطيَّتُهُ الْجِدُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62418&r=&rc=10",""]],"verses":[["فَمَهما شِئتَ تَنظُرُ مِن رُباها","إِلى بيضٍ عَواقِبُهُنَّ سودُ",0,"د",1,0],["فمَهزوزَةٌ إنْ رُوِّعَتْ أسَلاتُكُمْ","ومَغْفورَةٌ إنْ أذنَبَتْ هَفَواتُها",1,"ت",3,0],["فَمَهْمَا حَلَّهَا إِنْسَانُ عَيْنٍ","فَلِلإِنْسَانِ فِيهَا مَا تَمَنَّى",2,"ن",2,0],["فَمَهْمَا سَلَلْتَ السَّيْفَ أَمْضَاهُ حُكْمُهُ","وَمَهْمَا رَمَيْتَ السَّهْمَ كَانَ هُوَ الرَّامِي",3,"ي",1,0],["فمَهْما نطَقْتُ نطقْتُ ادِّكارا","ومهْما صمَتُّ صمتُّ اعْتِبارا",4,"ر",2,0],["فمَهْما رأيْتُمْ شَيْبَةً فوْقَ مَفْرِقي","فلا تُنْكِروها إنّها شَيْبَةُ الحَمْدِ",5,"د",1,0],["فمهّدْتَ بالسِّلْمِ البِلادَ لأهْلِها","فللأمْنِ إصْدارٌ علَيْكَ وإيرادُ",6,"د",1,0],["فَمَهْمَا غَرَسْتَ الصَّبْرَ فِي تُرْبَة الرِّضَا","بِحُكْمِ الْقَضَا فَلْتَجْنِ حُسْنَ الْعَوَاقِبِ",7,"ب",1,0],["فَمُهَتَّكُ الأَستارِ يُدعى صائِناً","وَالسِفلَةُ السَفلاءُ يُدعى بِالعَلا",8,"ل",2,0],["فمهما تصب خيراً فقد جدرت به","فضائل لم يضمم على مثلها برد",9,"د",1,0],["فَمَهلاً لا تَزِد جَهلاً وَتَأمُرُ","بِهِ وَتُطاوِعُ العَينَ الهَمولا",10,"ل",2,0],["فَمَهما نَغِض مِنهُ فَإِنَّ ضَمانَهُ","عَلى طَيِّبِ الأَردانِ غَيرِ مُسَبَّبِ",11,"ب",1,0],["فَمَهلاً فِداكَ اليَومَ أُمّي وَخالَتي","فَلا يَأمُرَنّي بِالدَنِيَّةِ أَسوَدُ",12,"د",1,0],["فمهلك يا قضاعُ فلا تكوني","توابعَ لا أصول لها بنجدِ",13,"د",1,0],["فمهلاً يا قضاعة لا تكوني","كقِدح خرَّ بين يدي مُجيلِ",14,"ل",1,1],["فمهلاً يا قُضاع فلا تكوني","منيحاً في قِداح يديْ مُجيلِ",15,"ل",1,1],["فَمَهلاً اتركُوا مِنكُم عُيُوناً","وَأَفئِدَةً يَنَمنَ إِذَا كَرِينَا",16,"ن",2,0],["فَمَهما أَقُل مِمّا أُعَدِّدُ لا يَزَل","عَلى صِدقِهِ مِن جُلِّ قَومِيَ شاهِدُ",17,"د",1,0],["فَمَهما يَكُن مِنّي فَلَستُ بِكاذِبٍ","وَلَستُ بِخَوّانِ الأَمينِ المُجامِلِ",18,"ل",1,0],["فَمَهرِجْ فيه تحت ظلال عيشٍ","ممدَّدةٍ على عيشٍ فضاءِ",19,"ا",2,0],["فَمَهْلاً أيها الكائِ","دُ ذاك الطَّوْدَ بالنَّطْحِ",20,"ح",1,0],["فمهلاً هداك اللَهُ عن ذي مودةٍ","تلقّاك مظلوماً بصفحةِ مُسترضي",21,"ي",1,0],["فمهرجانُك والنيروز قد غدوا","سيان عند ذوي التقوى وعيداكا",22,"ك",2,0],["فَمَهما كانَ مِن أَلَمٍ فَإِنّا","صَبَحناهُم بِها كَأساً عُقارا",23,"ر",2,0],["فَمَهما رَحِبَ الأُفقُ","فَنَفسِيَ الأُفقُ الأَكبَرُ",24,"ر",1,0],["فمهلا فيلسوف الشر مهلا","فإن لكل نازلة نهاية",25,"ا",3,0],["فَمُهُ القاني عَلى لَبَّتِهِ","كَبَقايا الدَمِ في نَصلِ دَقيقِ",26,"ق",1,0],["فَمَهما تَهِم يَسنَح لَها ذو مُهَنَّدٍ","وَيَخرُج لَها مِن باطِنِ الأَرضِ مِحرَبُ",27,"ب",1,0],["فمهرتْ فيها وجاءتْ بما","يبهرُ من مستحسَنٍ مُعْجِبِ",28,"ب",1,0],["فَمَهما رَأَوا مِن غِبطَةٍ في اِصطِلاحِهِم","فَمِنكَ بِها النُعمى جَرَت وَلَكَ الفَضا",29,"ض",2,0],["فَمَهما أَعِش لا يُضمِنوني وَلا أَضَع","لَهُم حَسَباً ما حَرَّكَت قَدَمي نَعلي",30,"ل",2,0],["فمهلاً أبا عثمان مهلاً فإنَّما","يَغارُ على الأشعارِ مَنْ عَشِقَ الشَّعْرا",31,"ر",2,0],["فَمَهلاً آلَ عَبدِ اللَهِ عَدّوا","مَخازِيَ لا يُدَبُّ لَها الضَراءُ",32,"ا",2,0],["فَمَهما تَكُن مِن وَقعَةٍ بَعدُ لا تَكُن","سِوى حَسَنٍ مِمّا فَعَلتَ مُرَدَّدِ",33,"د",1,0],["فَمَهْ لا تَفُهْ بِالْقَوْلِ قَبْلَ انْتِقَادِهِ","فَرُبَّ كَلامٍ فَضَّ مِنْ قَائِلٍ فَمَهْ",34,"ه",1,0],["فمُهديه أفديهِ منْ سيِّدٍ","أياديهِ رائقةٌ راقيَهْ",35,"ي",2,0],["فَمَهما تَيَمَّمتُ خَمّارَةً","رَكِبتُ إِلى أَشقَرٍ أَشهَبا",36,"ب",2,0],["فَمَهما شاقَ مِن بَرقٍ مَليحٍ","أَرِقتُ لَهُ أُناجيهِ كَليما",37,"م",2,0],["فَمَهلاً بَعضَ وَجدِكَ كُلُّ أَمرٍ","يَصيرُ وَإِن أَحَمَّ إِلى اِنكِشافِ",38,"ف",1,0],["فَمَهلاً بَني عَمِّنا إِنَّها","عَطِيَّةُ رَبٍّ حَبانا بِها",39,"ب",3,0],["فمَهْلاً فقد أخرستمُونَا كأنّما","صَنائعُكُمْ عُرْبٌ ونحنُ أعاجِم",40,"م",1,0],["فمهْلاً عليهم لا أبَا لأبِيهمِ","فللهِ سهم لا يطيش له نزع",41,"ع",1,0],["فمهلاً بني عَمّي وأعيانَ مَعْشَري","وأملاكَ قومي والخضارمَ من نجري",42,"ر",2,0],["فمَهْلاً عِداه ما على اللّه مَعْتَبٌ","وليس لما يأتي به الوَحيُ مَنسَخُ",43,"خ",1,0],["فَمُهِّدَت في دِنانٍ","سَقياً لَها مِن مِهادِ",44,"د",1,0],["فَمَهلاً لا أَبا لَكَ بَعضَ لَومي","ضَجِجتَ مِنَ الهَوى وَأَنا العَميدُ",45,"د",1,0],["فَمَهلاً يا مُتَمِّمُ إِنَّ فِهراً","حَوَت مِن ما لِكٍ دِيَةَ الفُرارِ",46,"ر",1,0],["فَمَهْلاً بَنِي الدُّنْيا عَلَيْنَا فَإِنَّنَا","إِلَى غَايَةٍ تَنْفَتُّ فِيهَا الْمَرائِرُ",47,"ر",1,0],["فَمَهْمَا يُهِمُّ النّاسَ ممّا يكيدُنَا","فَنَحْنُ لَهُ من سَائِرِ النّاس أوسعُ",48,"ع",1,0],["فَمَهْلاً أَنَا النَجْمُ الَّذِي يُبْصِروُنَه","صَغِيراً وَيُخْفِي قَدْرَهُ عَنْهُمُ الْبُعُدُ",49,"د",1,0],["فَمَهما رَأوا مِن غِبْطَةٍ في صَلاحهمْ،","فمنكَ بها النُّعمى جَرَتْ ولَك الفضْلُ",50,"ل",1,0],["فَمَهْلاً أَنَا النَجْمُ الَّذِي يُبْصِرُونَه","صَغِيراً وَيُحْفي قَدْرَهُ عَنْهُمُ الْبُعْدُ",51,"د",1,0]]}