{"poems":[[55,"أرى بغداد قد أخنى عليها","https://www.aldiwan.net/poem30511.html","الوافر"],[65,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[79,"بك الخطط الرفيعة فلتهنا","https://www.aldiwan.net/poem36039.html","الوافر"],[79,"أمولاي دمت الدهر منصور أعلام","https://www.aldiwan.net/poem36104.html","الطويل"],[79,"جلا الحق قلبي حتى أنارا","https://www.aldiwan.net/poem36501.html","المتقارب"],[79,"تعجلت وخط الشيب في زمن الصبا","https://www.aldiwan.net/poem36564.html","الطويل"],[79,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[79,"ألا حدثاها فهي أم العجائب","https://www.aldiwan.net/poem36775.html","الطويل"],[73,"ابنا الحرستاني في لقبيهما","https://www.aldiwan.net/poem3832.html","الكامل"],[95,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[32,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[11,"هل الدهر إلا اليوم أو أمس أو غد","https://www.aldiwan.net/poem233.html",""],[39,"ألا أبلغ جماعة أهل مرو","https://www.aldiwan.net/poem6907.html","الوافر"],[39,"فمهلا يا قضاعة لا تكوني","https://www.aldiwan.net/poem7432.html","الوافر"],[39,"فمهلا يا قضاع فلا تكوني","https://www.aldiwan.net/poem7473.html","الوافر"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[23,"أجدك لم تهتج لرسم المنازل","https://www.aldiwan.net/poem21351.html","الطويل"],[53,"أحب المهرجان لأن فيه","https://www.aldiwan.net/poem7934.html","الوافر"],[53,"ألا يا أيها الشاكر والمطنب في المدح","https://www.aldiwan.net/poem9411.html","الهزج"],[53,"أتاني عتاب من أخ فاغتفرته","https://www.aldiwan.net/poem64967.html","الطويل"],[53,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[31,"ألم تشكر لنا كلب بأنا","https://www.aldiwan.net/poem6185.html","الوافر"],[93,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[87,"حبرت مقالة جمعت فأوعت","https://www.aldiwan.net/poem7266.html","الوافر"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[64,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[47,"ضمان على عينيك أني لا أسلو","https://www.aldiwan.net/poem65536.html","الطويل"],[30,"ألا استهزأت مني هنيدة أن رأت","https://www.aldiwan.net/poem5472.html","الطويل"],[63,"هل الصبر مجد حين أدرع الصبرا","https://www.aldiwan.net/poem51671.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[46,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[89,"دع الهزل واحذر ترهات المنادمه","https://www.aldiwan.net/poem8254.html","الطويل"],[71,"سلام على نفسك الزاكيه","https://www.aldiwan.net/poem29245.html","المتقارب"],[76,"ألا فضلت ذيلها ليلة","https://www.aldiwan.net/poem12853.html","المتقارب"],[76,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[41,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[54,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[77,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[77,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[77,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[77,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[50,"وعود كرمة كرخ","https://www.aldiwan.net/poem62558.html","الخفيف"],[52,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[48,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62227","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54203","الطويل"],[102,"بين المدية والذابح","https://www.poetsgate.com/ViewPoem.aspx?id=50372",""],[47,"ضَمَانٌ عَلَى عَيْنَيْكِ أنّيَ لا أسْلُو","https://www.poetsgate.com/ViewPoem.aspx?id=32201",""],[103,"طَرِيقُ الْعُلاَ وَعْرٌ مَطيَّتُهُ الْجِدُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62418&r=&rc=10",""],[118,"من هجرك الامان","https://www.aldiwan.net/poem40439.html","عموديه"],[132,"ترى ما انت ماذا فيك","https://www.aldiwan.net/poem67445.html","مجزوء الوافر"],[137,"ألا أبلغا عني لؤيا رسالة","https://www.aldiwan.net/poem21029.html","الطويل"],[137,"أرقت وقد تصوبت النجوم","https://www.aldiwan.net/poem21031.html","الوافر"],[146,"بنصرك يدرك الفتح المبين","https://www.aldiwan.net/poem11833.html","الوافر"],[163,"أعندك علم أم أقول فأطرب","https://www.aldiwan.net/poem58761.html","الطويل"],[188,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[192,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[213,"فؤادي منك ملآن","https://www.aldiwan.net/poem13344.html","الهزج"],[213,"بدا يختال كالقمر المفدى","https://www.aldiwan.net/poem13553.html","الوافر"],[232,"إني أتيت إلى البستان مختارا","https://www.aldiwan.net/poem51061.html","البسيط"],[238,"مولاي إن أنا أخرت الحضور فما","https://www.aldiwan.net/poem32141.html","البسيط"],[240,"أحبي علي الحسن علاك يا قمر","https://www.aldiwan.net/poem18800.html","الطويل"],[244,"جرى الدمع حتى ليس في الجفن مدمع","https://www.aldiwan.net/poem45765.html","الطويل"],[253,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[264,"حكى لحظه صادا ولا ما عذاره","https://www.aldiwan.net/poem38196.html","الطويل"],[273,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[273,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[308,"وروضة حسن بات ينشقنا الصبا","https://www.aldiwan.net/poem56422.html","الطويل"],[308,"إلهي ذنوبي ما علمت وإنني","https://www.aldiwan.net/poem56602.html","الطويل"],[316,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[356,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[360,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[374,"سلي بمواقع الأسل","https://www.aldiwan.net/poem57235.html","مجزوء الوافر"],[383,"ترى عندكم في الحب بعض الذي عندي","https://www.aldiwan.net/poem49198.html","الطويل"],[405,"أضعت العمر في إصلاح حالك","https://www.aldiwan.net/poem47007.html","الوافر"],[435,"عهدي بحيك وهو حي عامر","https://www.aldiwan.net/poem12398.html","الكامل"],[460,"سقى دارها بالرقمتين وحياها","https://www.aldiwan.net/poem55818.html","الطويل"],[460,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[463,"تهن بهاء الدين بالعام قاطعا","https://www.aldiwan.net/poem15381.html","الطويل"],[466,"سمو كما تهدى على العجم والعرب","https://www.aldiwan.net/poem3260.html","عموديه"],[555,"طلائع شيب سير أسرعها رسل","https://www.aldiwan.net/poem68424.html","الطويل"],[560,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[572,"ألم يبلغك والأنماء تنمي","https://www.aldiwan.net/poem59475.html","الطويل"],[589,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28099","البسيط"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17749","الطويل"],[932,"","https://poetry.dctabudhabi.ae/diwan/poem/203180","الطويل"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/29531","الطويل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/18782","الطويل"]],"verses":[["فَمَهما شِئتَ تَنظُرُ مِن رُباها","إِلى بيضٍ عَواقِبُهُنَّ سودُ",0,"د",1,0],["فمَهزوزَةٌ إنْ رُوِّعَتْ أسَلاتُكُمْ","ومَغْفورَةٌ إنْ أذنَبَتْ هَفَواتُها",1,"ت",3,0],["فَمَهْمَا حَلَّهَا إِنْسَانُ عَيْنٍ","فَلِلإِنْسَانِ فِيهَا مَا تَمَنَّى",2,"ن",2,0],["فَمَهْمَا سَلَلْتَ السَّيْفَ أَمْضَاهُ حُكْمُهُ","وَمَهْمَا رَمَيْتَ السَّهْمَ كَانَ هُوَ الرَّامِي",3,"م",2,0],["فمَهْما نطَقْتُ نطقْتُ ادِّكارا","ومهْما صمَتُّ صمتُّ اعْتِبارا",4,"ر",2,0],["فمَهْما رأيْتُمْ شَيْبَةً فوْقَ مَفْرِقي","فلا تُنْكِروها إنّها شَيْبَةُ الحَمْدِ",5,"د",1,0],["فمهّدْتَ بالسِّلْمِ البِلادَ لأهْلِها","فللأمْنِ إصْدارٌ علَيْكَ وإيرادُ",6,"د",1,0],["فَمَهْمَا غَرَسْتَ الصَّبْرَ فِي تُرْبَة الرِّضَا","بِحُكْمِ الْقَضَا فَلْتَجْنِ حُسْنَ الْعَوَاقِبِ",7,"ب",1,0],["فَمُهَتَّكُ الأَستارِ يُدعى صائِناً","وَالسِفلَةُ السَفلاءُ يُدعى بِالعَلا",8,"ل",2,0],["فمهما تصب خيراً فقد جدرت به","فضائل لم يضمم على مثلها برد",9,"د",1,0],["فَمَهلاً لا تَزِد جَهلاً وَتَأمُرُ","بِهِ وَتُطاوِعُ العَينَ الهَمولا",10,"ل",2,0],["فَمَهما نَغِض مِنهُ فَإِنَّ ضَمانَهُ","عَلى طَيِّبِ الأَردانِ غَيرِ مُسَبَّبِ",11,"ب",1,0],["فَمَهلاً فِداكَ اليَومَ أُمّي وَخالَتي","فَلا يَأمُرَنّي بِالدَنِيَّةِ أَسوَدُ",12,"د",1,0],["فمهلك يا قضاعُ فلا تكوني","توابعَ لا أصول لها بنجدِ",13,"د",1,0],["فمهلاً يا قضاعة لا تكوني","كقِدح خرَّ بين يدي مُجيلِ",14,"ل",1,1],["فمهلاً يا قُضاع فلا تكوني","منيحاً في قِداح يديْ مُجيلِ",15,"ل",1,1],["فَمَهلاً اتركُوا مِنكُم عُيُوناً","وَأَفئِدَةً يَنَمنَ إِذَا كَرِينَا",16,"ن",2,0],["فَمَهما أَقُل مِمّا أُعَدِّدُ لا يَزَل","عَلى صِدقِهِ مِن جُلِّ قَومِيَ شاهِدُ",17,"د",1,0],["فَمَهما يَكُن مِنّي فَلَستُ بِكاذِبٍ","وَلَستُ بِخَوّانِ الأَمينِ المُجامِلِ",18,"ل",1,0],["فَمَهرِجْ فيه تحت ظلال عيشٍ","ممدَّدةٍ على عيشٍ فضاءِ",19,"ا",2,0],["فَمَهْلاً أيها الكائِ","دُ ذاك الطَّوْدَ بالنَّطْحِ",20,"ح",1,0],["فمهلاً هداك اللَهُ عن ذي مودةٍ","تلقّاك مظلوماً بصفحةِ مُسترضي",21,"ض",2,0],["فمهرجانُك والنيروز قد غدوا","سيان عند ذوي التقوى وعيداكا",22,"ك",2,0],["فَمَهما كانَ مِن أَلَمٍ فَإِنّا","صَبَحناهُم بِها كَأساً عُقارا",23,"ر",2,0],["فَمَهما رَحِبَ الأُفقُ","فَنَفسِيَ الأُفقُ الأَكبَرُ",24,"ر",1,0],["فمهلا فيلسوف الشر مهلا","فإن لكل نازلة نهاية",25,"ا",3,0],["فَمُهُ القاني عَلى لَبَّتِهِ","كَبَقايا الدَمِ في نَصلِ دَقيقِ",26,"ق",1,0],["فَمَهما تَهِم يَسنَح لَها ذو مُهَنَّدٍ","وَيَخرُج لَها مِن باطِنِ الأَرضِ مِحرَبُ",27,"ب",1,0],["فمهرتْ فيها وجاءتْ بما","يبهرُ من مستحسَنٍ مُعْجِبِ",28,"ب",1,0],["فَمَهما رَأَوا مِن غِبطَةٍ في اِصطِلاحِهِم","فَمِنكَ بِها النُعمى جَرَت وَلَكَ الفَضا",29,"ض",2,0],["فَمَهما أَعِش لا يُضمِنوني وَلا أَضَع","لَهُم حَسَباً ما حَرَّكَت قَدَمي نَعلي",30,"ل",2,0],["فمهلاً أبا عثمان مهلاً فإنَّما","يَغارُ على الأشعارِ مَنْ عَشِقَ الشَّعْرا",31,"ر",2,0],["فَمَهلاً آلَ عَبدِ اللَهِ عَدّوا","مَخازِيَ لا يُدَبُّ لَها الضَراءُ",32,"ا",2,0],["فَمَهما تَكُن مِن وَقعَةٍ بَعدُ لا تَكُن","سِوى حَسَنٍ مِمّا فَعَلتَ مُرَدَّدِ",33,"د",1,0],["فَمَهْ لا تَفُهْ بِالْقَوْلِ قَبْلَ انْتِقَادِهِ","فَرُبَّ كَلامٍ فَضَّ مِنْ قَائِلٍ فَمَهْ",34,"ه",1,0],["فمُهديه أفديهِ منْ سيِّدٍ","أياديهِ رائقةٌ راقيَهْ",35,"ي",2,0],["فَمَهما تَيَمَّمتُ خَمّارَةً","رَكِبتُ إِلى أَشقَرٍ أَشهَبا",36,"ب",2,0],["فَمَهما شاقَ مِن بَرقٍ مَليحٍ","أَرِقتُ لَهُ أُناجيهِ كَليما",37,"م",2,0],["فَمَهلاً بَعضَ وَجدِكَ كُلُّ أَمرٍ","يَصيرُ وَإِن أَحَمَّ إِلى اِنكِشافِ",38,"ف",1,0],["فَمَهلاً بَني عَمِّنا إِنَّها","عَطِيَّةُ رَبٍّ حَبانا بِها",39,"ب",3,0],["فمَهْلاً فقد أخرستمُونَا كأنّما","صَنائعُكُمْ عُرْبٌ ونحنُ أعاجِم",40,"م",1,0],["فمهْلاً عليهم لا أبَا لأبِيهمِ","فللهِ سهم لا يطيش له نزع",41,"ع",1,0],["فمهلاً بني عَمّي وأعيانَ مَعْشَري","وأملاكَ قومي والخضارمَ من نجري",42,"ر",2,0],["فمَهْلاً عِداه ما على اللّه مَعْتَبٌ","وليس لما يأتي به الوَحيُ مَنسَخُ",43,"خ",1,0],["فَمُهِّدَت في دِنانٍ","سَقياً لَها مِن مِهادِ",44,"د",1,0],["فَمَهلاً لا أَبا لَكَ بَعضَ لَومي","ضَجِجتَ مِنَ الهَوى وَأَنا العَميدُ",45,"د",1,0],["فَمَهلاً يا مُتَمِّمُ إِنَّ فِهراً","حَوَت مِن ما لِكٍ دِيَةَ الفُرارِ",46,"ر",1,0],["فَمَهْمَا تَعَضَّ الحَرْبُ مِنَّا فَإِنَّهَا","تَعَضُّ بِأَثْبَاجِ سِوَانَا فَتَكْتِفُ",47,"ف",1,0],["فَمَهْلاً بَنِي الدُّنْيا عَلَيْنَا فَإِنَّنَا","إِلَى غَايَةٍ تَنْفَتُّ فِيهَا الْمَرائِرُ",48,"ر",1,0],["فَمَهْمَا يُهِمُّ النّاسَ ممّا يكيدُنَا","فَنَحْنُ لَهُ من سَائِرِ النّاس أوسعُ",49,"ع",1,0],["فَمَهْلاً أَنَا النَجْمُ الَّذِي يُبْصِروُنَه","صَغِيراً وَيُخْفِي قَدْرَهُ عَنْهُمُ الْبُعُدُ",50,"د",1,0],["فمه أصغر من صيحته","عبئه أكبر من حامله",51,"ل",2,0],["فَمَهما رَأوا مِن غِبْطَةٍ في صَلاحهمْ،","فمنكَ بها النُّعمى جَرَتْ ولَك الفضْلُ",52,"ل",1,0],["فَمَهْلاً أَنَا النَجْمُ الَّذِي يُبْصِرُونَه","صَغِيراً وَيُحْفي قَدْرَهُ عَنْهُمُ الْبُعْدُ",53,"د",1,0],["فمهجتي لعمري","ثار لها دخان",54,"ن",1,0],["فمَهلاً ما بلغتَ مُنى","ولست بمُدرِكٍ شأنا",55,"ن",2,0],["فَمَهلاً وَلَمّا تُنتج الحَربُ بِكرَها","يَبينُ تِمامٌ أَو تأخُّرُ مُعجَلِ",56,"ل",1,0],["فَمَهلاً قَومَنا لا تَركَبونا","بِمَظلَمَةٍ لَها أَمرٌ عَظيمُ",57,"م",1,0],["فَمَهلاً فَالحَديثُ مِنَ التَعَدّي","سَيَخلَقُ وَالحَديثُ لَهُ شُجونُ",58,"ن",1,0],["فمهما تناهي ما ذكرت فعشرما","لقيتُ ولا والله للعشر يقربُ",59,"ب",1,0],["فمهما توالتْ نعمةٌ فبشَهْدِه","ومهما تناهتْ نقمةٌ فبصَابِه",60,"ب",2,0],["فَمَهما شغلتَ الفكرَ في كلّ وجهةٍ","إِلى أبدِ الآبادِ لا غايةٌ تُدرى",61,"ر",2,0],["فمهما شئت فاصنع بي","فكلٌّ منك إحسان",62,"ن",1,0],["فمه يا مرشدي في اللوم عني","فلا بلغت فيما رمت رشدا",63,"د",2,0],["فمهِّداً عُذْرنا قُدِّمتُ قبلكما","فلم نُصِرّ على الهجْران إصرارا",64,"ر",2,0],["فَمَهِّدِ العُذرَ وَاِعلَم أَنَّني رَجُلٌ","حَبسُ اللُصوصِ مَكانٌ لا أَقولُ بِهِ",65,"ه",1,0],["فَمَهْلاً رُوَيْداً يَا حَيَاتِي عَلَى الذِي","يُحِبُّكَ قَدْ أَمْسَى يُعَانِي لَظَى سَقَرْ",66,"ر",1,0],["فمهلاً رويداً أيها اللائم الذي","يُجرِّعني في لومِه ما يُجرِّعُ",67,"ع",1,0],["فَمُهُ كأسُهُ وريقَتُهُ الخم","رُ ومن وجنَتَيهِ رَوضٌ أريضُ",68,"ض",1,0],["فمهما رنا أو كلما لاح صدغه","وسلم ايماء بجرد لي نصلا",69,"ل",2,0],["فمهما يكن حكمُ الأجانب عادلاً","يخُن دينَهُ الراضي بحكم الفرنجة",70,"ه",1,0],["فمهبطُ الوحي والتنزيلِ في بلدٍ","جبريلُ فيهِ بآي اللهِ ناجاك",71,"ك",1,0],["فَمَهما تَنسّمنا عَلى غيرِ رقبةٍ","نسيمَ الصبا جاءَت بريّا القرنفلُ",72,"ل",1,0],["فَمهلاً عبادَ اللّهِ إن كان منكم","رضى بالّذي قد كان فالأمر أعجبُ",73,"ب",1,0],["فمهما تجلت من كدورات عالم","الطبيعة شفت جوهراً وتجلت",74,"ت",1,0],["فَمَهما تَقل في مَدحِهِ قُل وَلا تَخَف","فَلا هُوَ مَطرُوٌّ وَلا أَنتَ مُطنِبُ",75,"ب",1,0],["فَمَهمَا ثَارَ فِي جَوٍّ قَتامٌ","فَفِيهِ لرَفعِ شَفرَتِهِ صَرِيعُ",76,"ع",1,0],["فَمَهما يَعتَرِض مِنها","يَجِد مَثلاً وكالمَثَلِ",77,"ل",1,0],["فَمَهما يَحط الحَظ قَدر عَميدَكُم","فَلا تَقطَعوا عَنهُ الرَسائل عَن عَمد",78,"د",1,0],["فَمَهْلاً فهيَ عند اللهِ أَدْنَى","وأهْونُ مِن ترابٍ في نعالِكْ",79,"ك",1,0],["فمُهَنَّدٌ عَضْبٌ وأَسمرُ عاسِلٌ","ومُفاضَةٌ زُعْفٌ وأَجْردُ ضامِرُ",80,"ر",1,0],["فمهما يَطُلْ هذا اللسانُ ويتَّسعْ","له القولُ تسمعْها فِصاحا وتُرواها",81,"ا",3,0],["فمهما أبقَ يسمعْ سائراتٍ","مطبِّقةً من الكلمِ البواقي",82,"ق",2,0],["فمهزومةٌ بالجودِ والبأسِ دائماً","كماةُ الوغى والمُجْدباتُ العوارقُ",83,"ق",1,0],["فمهلاً فإن المال يشكو من النوى","وصفحاً فإن الشعر يخشى من العتب",84,"ب",1,0],["فَمَهلاً أَما لي مَذهَبٌ عَنكَ واسِعٌ","مُوَطَّأَةٌ في كُلِّ وَجهٍ لَهُ السُبلُ",85,"ل",1,0],["فمهلاً رويدك إني امرؤ","تركت سلوي لمن عنفا",86,"ف",2,0],["فم هناك سميت بتربة","وقولها قيل على الأصلية",87,"ه",1,0],["فمهلاً يا حذيفة عن بناتي","فانَّ القولَ مقتصدٌ وعادي",88,"د",2,0],["فمهلاً يا أحبتنا فإنا","بذاك العهد لم نخفر ذماما",89,"م",2,0],["فمَهما كانَ مِن خَيرٍ فَاِنّا","وَرثناها أَوائِلُ أَوَّلينا",90,"ن",2,0],["فمهما تشأ منه فزارة تعطِكُم","ومهما تشأ منه فزارة تمنَعا",91,"ع",2,0],["فمهما تسل عن نصرتي السيد لا تجد","لدى الحرب بيت السيد عندي مذمما",92,"م",2,1],["فَمَهلاً أَبا الخَنساءِ لا تَشتُمَنَّني","فَتَقرَعَ بَعدَ اليَومِ سِنَّكَ مِن نَدَم",93,"م",1,0],["فَمَهلاً لِمَن غَرَّت كَفالَةَ حُقَّةٍ","بَني عامِرٍ أُخرى اللَيالي الغَوابِرِ",94,"ر",1,0]]}