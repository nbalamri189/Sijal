اعاً وإِنْ كان الوداعُ تألمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=42556",""],[5149,"رسولَ اللهِ قد عَظُمَ البَلاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=212566",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5242,"رجاء الإله لنا شامل","https://www.poetsgate.com/ViewPoem.aspx?id=125970",""],[5277,"غيرة بيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=185661",""],[5277,"هلمّوا..إنّها القدسُ","https://www.poetsgate.com/ViewPoem.aspx?id=188133",""],[5277,"أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=190317",""],[5295,"عاديتُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177298",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[5320,"العالم يغنى","https://www.poetsgate.com/ViewPoem.aspx?id=41632",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5376,"عجباً من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=188267",""],[5376,"وإنَّ لعيني رجاءً بدا","https://www.poetsgate.com/ViewPoem.aspx?id=196441",""],[5410,"هواجس على أسوار بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=152248",""],[5411,"أنا الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=185423",""],[5431,"وشكرا للحياة فلم تخنّي...","https://www.poetsgate.com/ViewPoem.aspx?id=197212",""],[3912,"كفى حَزَنًا بالهائم الصبِّ أن يرى","https://www.poetsgate.com/ViewPoem.aspx?id=136749",""],[5561,"راهبة","https://www.poetsgate.com/ViewPoem.aspx?id=192905",""],[5561,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=196755",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5691,"سيداو (*)...!","https://www.poetsgate.com/ViewPoem.aspx?id=208171",""],[5693,"رحلت هنالك.","https://www.poetsgate.com/ViewPoem.aspx?id=34851",""],[5718,"شراب الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213869",""],[5782,"تفاعل القصائد بالقوافي","https://www.poetsgate.com/ViewPoem.aspx?id=185762",""],[5790,"يا لقومي أين يذهب بي","https://www.poetsgate.com/ViewPoem.aspx?id=111981",""],[5830,"سَلامٌ لِعَيْنَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=201123",""],[5842,"رد ( الى بشار الاسد بعد خطابه الثاني ) / حسان الزا","https://www.poetsgate.com/ViewPoem.aspx?id=76594",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5956,"الحب المُعَاد","https://www.poetsgate.com/ViewPoem.aspx?id=181934",""],[5956,"شكراً لمن رعى","https://www.poetsgate.com/ViewPoem.aspx?id=183592",""],[5956,"على زنديك","https://www.poetsgate.com/ViewPoem.aspx?id=184495",""],[5956,"لأنفعَ الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=194886",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[5975,"رد ( الى بشار الاسد بعد خطابه الثاني )","https://www.poetsgate.com/ViewPoem.aspx?id=76595",""],[161,"لكل سؤال جواب وحل","https://www.poetsgate.com/ViewPoem.aspx?id=169334",""],[6048,"أروح بروحي لوقت وأرجع","https://www.poetsgate.com/ViewPoem.aspx?id=201218",""],[6167,"تحت العرش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85552&r=&rc=35",""],[5190,"المفترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78333&r=&rc=46",""]],"verses":[["فَمَهما شِئتَ تَنظُرُ مِن رُباها","إِلى بيضٍ عَواقِبُهُنَّ سودُ",0,"د",1,0],["فمَهزوزَةٌ إنْ رُوِّعَتْ أسَلاتُكُمْ","ومَغْفورَةٌ إنْ أذنَبَتْ هَفَواتُها",1,"ت",3,0],["فَمَهْمَا حَلَّهَا إِنْسَانُ عَيْنٍ","فَلِلإِنْسَانِ فِيهَا مَا تَمَنَّى",2,"ن",2,0],["فَمَهْمَا سَلَلْتَ السَّيْفَ أَمْضَاهُ حُكْمُهُ","وَمَهْمَا رَمَيْتَ السَّهْمَ كَانَ هُوَ الرَّامِي",3,"م",2,0],["فمَهْما نطَقْتُ نطقْتُ ادِّكارا","ومهْما صمَتُّ صمتُّ اعْتِبارا",4,"ر",2,0],["فمَهْما رأيْتُمْ شَيْبَةً فوْقَ مَفْرِقي","فلا تُنْكِروها إنّها شَيْبَةُ الحَمْدِ",5,"د",1,0],["فمهّدْتَ بالسِّلْمِ البِلادَ لأهْلِها","فللأمْنِ إصْدارٌ علَيْكَ وإيرادُ",6,"د",1,0],["فَمَهْمَا غَرَسْتَ الصَّبْرَ فِي تُرْبَة الرِّضَا","بِحُكْمِ الْقَضَا فَلْتَجْنِ حُسْنَ الْعَوَاقِبِ",7,"ب",1,0],["فَمُهَتَّكُ الأَستارِ يُدعى صائِناً","وَالسِفلَةُ السَفلاءُ يُدعى بِالعَلا",8,"ل",2,0],["فمهما تصب خيراً فقد جدرت به","فضائل لم يضمم على مثلها برد",9,"د",1,0],["فَمَهلاً لا تَزِد جَهلاً وَتَأمُرُ","بِهِ وَتُطاوِعُ العَينَ الهَمولا",10,"ل",2,0],["فَمَهما نَغِض مِنهُ فَإِنَّ ضَمانَهُ","عَلى طَيِّبِ الأَردانِ غَيرِ مُسَبَّبِ",11,"ب",1,0],["فَمَهلاً فِداكَ اليَومَ أُمّي وَخالَتي","فَلا يَأمُرَنّي بِالدَنِيَّةِ أَسوَدُ",12,"د",1,0],["فمهلك يا قضاعُ فلا تكوني","توابعَ لا أصول لها بنجدِ",13,"د",1,0],["فمهلاً يا قضاعة لا تكوني","كقِدح خرَّ بين يدي مُجيلِ",14,"ل",1,1],["فمهلاً يا قُضاع فلا تكوني","منيحاً في قِداح يديْ مُجيلِ",15,"ل",1,1],["فَمَهلاً اتركُوا مِنكُم عُيُوناً","وَأَفئِدَةً يَنَمنَ إِذَا كَرِينَا",16,"ن",2,0],["فَمَهما أَقُل مِمّا أُعَدِّدُ لا يَزَل","عَلى صِدقِهِ مِن جُلِّ قَومِيَ شاهِدُ",17,"د",1,0],["فَمَهما يَكُن مِنّي فَلَستُ بِكاذِبٍ","وَلَستُ بِخَوّانِ الأَمينِ المُجامِلِ",18,"ل",1,0],["فَمَهرِجْ فيه تحت ظلال عيشٍ","ممدَّدةٍ على عيشٍ فضاءِ",19,"ا",2,0],["فَمَهْلاً أيها الكائِ","دُ ذاك الطَّوْدَ بالنَّطْحِ",20,"ح",1,0],["فمهلاً هداك اللَهُ عن ذي مودةٍ","تلقّاك مظلوماً بصفحةِ مُسترضي",21,"ض",2,0],["فمهرجانُك والنيروز قد غدوا","سيان عند ذوي التقوى وعيداكا",22,"ك",2,0],["فَمَهما كانَ مِن أَلَمٍ فَإِنّا","صَبَحناهُم بِها كَأساً عُقارا",23,"ر",2,0],["فَمَهما رَحِبَ الأُفقُ","فَنَفسِيَ الأُفقُ الأَكبَرُ",24,"ر",1,0],["فمهلا فيلسوف الشر مهلا","فإن لكل نازلة نهاية",25,"ا",3,0],["فَمُهُ القاني عَلى لَبَّتِهِ","كَبَقايا الدَمِ في نَصلِ دَقيقِ",26,"ق",1,0],["فَمَهما تَهِم يَسنَح لَها ذو مُهَنَّدٍ","وَيَخرُج لَها مِن باطِنِ الأَرضِ مِحرَبُ",27,"ب",1,0],["فمهرتْ فيها وجاءتْ بما","يبهرُ من مستحسَنٍ مُعْجِبِ",28,"ب",1,0],["فَمَهما رَأَوا مِن غِبطَةٍ في اِصطِلاحِهِم","فَمِنكَ بِها النُعمى جَرَت وَلَكَ الفَضا",29,"ض",2,0],["فَمَهما أَعِش لا يُضمِنوني وَلا أَضَع","لَهُم حَسَباً ما حَرَّكَت قَدَمي نَعلي",30,"ل",2,0],["فمهلاً أبا عثمان مهلاً فإنَّما","يَغارُ على الأشعارِ مَنْ عَشِقَ الشَّعْرا",31,"ر",2,0],["فَمَهلاً آلَ عَبدِ اللَهِ عَدّوا","مَخازِيَ لا يُدَبُّ لَها الضَراءُ",32,"ا",2,0],["فَمَهما تَكُن مِن وَقعَةٍ بَعدُ لا تَكُن","سِوى حَسَنٍ مِمّا فَعَلتَ مُرَدَّدِ",33,"د",1,0],["فَمَهْ لا تَفُهْ بِالْقَوْلِ قَبْلَ انْتِقَادِهِ","فَرُبَّ كَلامٍ فَضَّ مِنْ قَائِلٍ فَمَهْ",34,"ه",1,0],["فمُهديه أفديهِ منْ سيِّدٍ","أياديهِ رائقةٌ راقيَهْ",35,"ي",2,0],["فَمَهما تَيَمَّمتُ خَمّارَةً","رَكِبتُ إِلى أَشقَرٍ أَشهَبا",36,"ب",2,0],["فَمَهما شاقَ مِن بَرقٍ مَليحٍ","أَرِقتُ لَهُ أُناجيهِ كَليما",37,"م",2,0],["فَمَهلاً بَعضَ وَجدِكَ كُلُّ أَمرٍ","يَصيرُ وَإِن أَحَمَّ إِلى اِنكِشافِ",38,"ف",1,0],["فَمَهلاً بَني عَمِّنا إِنَّها","عَطِيَّةُ رَبٍّ حَبانا بِها",39,"ب",3,0],["فمَهْلاً فقد أخرستمُونَا كأنّما","صَنائعُكُمْ عُرْبٌ ونحنُ أعاجِم",40,"م",1,0],["فمهْلاً عليهم لا أبَا لأبِيهمِ","فللهِ سهم لا يطيش له نزع",41,"ع",1,0],["فمهلاً بني عَمّي وأعيانَ مَعْشَري","وأملاكَ قومي والخضارمَ من نجري",42,"ر",2,0],["فمَهْلاً عِداه ما على اللّه مَعْتَبٌ","وليس لما يأتي به الوَحيُ مَنسَخُ",43,"خ",1,0],["فَمُهِّدَت في دِنانٍ","سَقياً لَها مِن مِهادِ",44,"د",1,0],["فَمَهلاً لا أَبا لَكَ بَعضَ لَومي","ضَجِجتَ مِنَ الهَوى وَأَنا العَميدُ",45,"د",1,0],["فَمَهلاً يا مُتَمِّمُ إِنَّ فِهراً","حَوَت مِن ما لِكٍ دِيَةَ الفُرارِ",46,"ر",1,0],["فَمَهْمَا تَعَضَّ الحَرْبُ مِنَّا فَإِنَّهَا","تَعَضُّ بِأَثْبَاجِ سِوَانَا فَتَكْتِفُ",47,"ف",1,0],["فَمَهْلاً بَنِي الدُّنْيا عَلَيْنَا فَإِنَّنَا","إِلَى غَايَةٍ تَنْفَتُّ فِيهَا الْمَرائِرُ",48,"ر",1,0],["فَمَهْمَا يُهِمُّ النّاسَ ممّا يكيدُنَا","فَنَحْنُ لَهُ من سَائِرِ النّاس أوسعُ",49,"ع",1,0],["فَمَهْلاً أَنَا النَجْمُ الَّذِي يُبْصِروُنَه","صَغِيراً وَيُخْفِي قَدْرَهُ عَنْهُمُ الْبُعُدُ",50,"د",1,0],["فمه أصغر من صيحته","عبئه أكبر من حامله",51,"ل",2,0],["فَمَهما رَأوا مِن غِبْطَةٍ في صَلاحهمْ،","فمنكَ بها النُّعمى جَرَتْ ولَك الفضْلُ",52,"ل",1,0],["فَمَهْلاً أَنَا النَجْمُ الَّذِي يُبْصِرُونَه","صَغِيراً وَيُحْفي قَدْرَهُ عَنْهُمُ الْبُعْدُ",53,"د",1,0],["فمهجتي لعمري","ثار لها دخان",54,"ن",1,0],["فمَهلاً ما بلغتَ مُنى","ولست بمُدرِكٍ شأنا",55,"ن",2,0],["فَمَهلاً وَلَمّا تُنتج الحَربُ بِكرَها","يَبينُ تِمامٌ أَو تأخُّرُ مُعجَلِ",56,"ل",1,0],["فَمَهلاً قَومَنا لا تَركَبونا","بِمَظلَمَةٍ لَها أَمرٌ عَظيمُ",57,"م",1,0],[