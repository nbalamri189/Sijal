{"poems":[[79,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[91,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[78,"شادن يسحب أذيال الطرب","https://www.aldiwan.net/poem39499.html","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[139,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[475,"ما لجديد الموت يا بشر لذة","https://www.aldiwan.net/poem4767.html","الطويل"],[741,"","https://poetry.dctabudhabi.ae/diwan/poem/199303","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64018","المنسرح"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145856","الخفيف"],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216298",""],[1717,"","https://poetry.dctabudhabi.ae/diwan/poem/147217","الكامل"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104435","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53233","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53065","السريع"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88652","الخفيف"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91551","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44904","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[4728,"الهلامة والصتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=176970",""],[5183,"جلاء الجيش الإنجليزى عن مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185638",""],[5186,"يا رعى الله ما رعت بكفيا","https://www.poetsgate.com/ViewPoem.aspx?id=156509",""],[475,"مَا لِجَدِيدِ المَوْتِ يَا بِشْرُ لَذَّة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=20620",""],[5452,"ستائر الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=112027",""]],"verses":[["مَا لَجَّ دَاءٌ أَوْ تَفَاقَمَ مُعْضِلٌ","إلاَّ وَفِي يُمْنَى يَدَيْهِ شِفَاءُ",0,"ا",2,0],["ما لجرح يصيبنا","في جهاد له الم",1,"م",1,0],["ما لجَهْلي ما أَرَاهُ ذاهِباً","وَسَوَادُ الرَّأس مِنّي قَدْ ذَهَبْ",2,"ب",1,0],["مال جدار النون بعد انحدار","وغابت الشمس وراء الجدار",3,"ر",1,0],["مَا لِجرْحٍ جُرِحْتُهُ مِنْ ضِمَاد","نَفَذَ السَّهْمُ فِي صَمِيمِ فؤادِي",4,"د",2,1],["ما لجارية الأقلام قد وقفت","وما لأطواقها منشقةً غضبا",5,"ب",2,0],["ما لجفوني فيه بالسهد يدٌ","ولا لجسمي بالسقام قبل",6,"ل",1,0],["ما لِجَديدِ المَوتِ يا بِشرُ لَذَّةٌ","وَكُلُّ جَديدٍ تُستَلَذُّ طَرائِفُه",7,"ف",2,1],["ما لجنية المحاسن لا تأ","وى لخرقٍ كأنه جنى",8,"ن",2,1],["ما لجِعِبَّاكَ ما لها جَمَعَتْ","ما لم تكنْ قطُّ جَعْبَةٌ تَجْمَع",9,"ع",1,0],["ما لجَفني شوكٌ عليهِ السُهَادُ","إتَقِ اللهَ بالفتى يا رُقادُ",10,"د",1,1],["ما لجيته كامل الدّلِّي","في وِطَنْكُم غير دانوقه",11,"ق",2,0],["ما لجَّ عاذلُه عليه بعذله","إلاَّ ولحَّ عليه في عصيانهِ",12,"ن",2,0],["ما لجوّ العُلوم داجي الذّيولِ","أَترى مال بدره للأفولِ",13,"ل",1,1],["مالج في النوح قمري على فنن","ولا بدا بارق إلا وهيجني",14,"ن",2,0],["ما لجَّجَتْ سفن المنى إلا غدا","جوديُّ جود يمينه مرساها",15,"ا",3,0],["ما لجياد الخيل مربوطة","وللقنا والمرهفات اطّراحْ",16,"ح",1,0],["مال جيد العلى وعما قَريب","كان في الجو قائما مستطيلا",17,"ل",2,0],["ما لجريرِ وجميل مثلُها","في غزَلٍ وفي نسيبٍ مونقِ",18,"ق",1,0],["ما لجفني قَد جَفا طيبَ الوَسنْ","حَيث قَلبي فيهِ وافاني الشجنْ",19,"ن",1,1],["ما لِجِبرِيلَ وَهوَ مِن نُورِهِ كا","نَ بِتَفضِيلِهِ عَلَيهِ رِضَاءُ",20,"ا",2,0],["ما لجسمي نَبا بِهِ كُلّ مرقدْ","وَلِقَلبي يَقوم بيني ويَقعُدْ",21,"د",1,1],["ما لجسمي قد تولّاهُ السقام","ما لجفني هاجراً طعم المنام",22,"م",1,0],["ما لجرحي سواكم اليوم آسي","يا خليليَّ والخليل المواسي",23,"ي",1,0],["ما لجْملي معها شداد ومسامة","إي والله إن البعد أجر وغنيمة",24,"م",2,0],["ما لجيش انجلترا في أرضكم","يصبح الحاكم كيف انقلبا",25,"ب",2,0],["ما لجسمي شقاها بل لروحي","وهي كادت تفيض من عينيا",26,"ي",2,0],["مَا لِجَدِيدِ المَوْتِ يَا بِشْرُ لَذَّة","ٌ زكلُّ جديدٍ تستلذُّ طرائفهْ",27,"ف",2,1],["ما لجنبي من هدوء","أرقب الصبح المبين",28,"ن",1,0]]}