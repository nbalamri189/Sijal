{"poems":[[93,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[87,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[108,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[96,"اطلّ من حرم الرؤيا فعزاني","https://www.poetsgate.com/ViewPoem.aspx?id=15609",""],[353,"يمينا لقد سر الإمام ابن إدريس","https://www.aldiwan.net/poem20397.html","الطويل"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[463,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[534,"أمرهف لحظه سله","https://www.aldiwan.net/poem37272.html","مجزوء الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107192","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107217","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137864",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108719","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101013","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100977","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137448",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100415","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204905","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89048","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91103","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119681","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83179","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35082","البسيط"],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[585,"أتطوي الليل تهتف بالنشيد","https://www.poetsgate.com/ViewPoem.aspx?id=161881",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"مالرجولة؟","https://www.poetsgate.com/ViewPoem.aspx?id=200498",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5776,"فَصْلٌ..... لمْ يَقُلْهُ ال...بُكَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199340",""],[5956,"تأثيرات صحاب الطفولة في أنفسنا","https://www.poetsgate.com/ViewPoem.aspx?id=194052",""],[6079,"مأساة العذريين","https://www.poetsgate.com/ViewPoem.aspx?id=207045",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["وَهَل صَحيحٌ أَنَّ كُلَّ المُنى","يَطحَنُها صِرفُ الرَدى كَالعِظام",0,"م",1,0],["وَهَل صُنَّ ماءً كانَ فيهِ كَأَنَّهُ","حَياءُ بَتولٍ في الصَلاةِ كَعابِ",1,"ب",1,0],["وهل صار للشرق أُذْنٌ تعي؟","وهل صار للشرق عينٌ ترى؟",2,"ر",2,0],["وهل صباك نموم العطر ناقلة","بعدي أحاديث أذيال وأردان",3,"ن",1,0],["وَهَلْ صَائِبٌ أَوْلَى مِن الغَيْثِ بالرُّبى","وَهَلْ صَائِلٌ أَوْلَى مِن اللَّيْثِ بالخِيسِ",4,"س",1,0],["وهل صديق يرتجى وفاؤه","هيهات هذا أمَلٌ لا يرتجى",5,"ا",1,0],["وهل صبَرت ساليا أو ناسيا","عن حسنها البادي وعن إحسانِها",6,"ن",3,0],["وهَلْ صافَحَ ذَاكَ الزَّهْ","رُ منْ سُحْب الْحَيَا وَبْلَهْ",7,"ل",2,0],["وَهَل صالِحٌ لا أَبعَدَ اللَّهُ صالِحاً","عَلى العَهدِ باقٍ أَم تَناسَاهُ صالِحُ",8,"ح",1,0],["وَهَل صِيغَ إِلا مِن لُجَينٍ وَعَسجَدٍ","وَمِسكٍ أَذاعَت عَرفَهُ رَشَحاتُهُ",9,"ت",2,0],["وهل صرت ان دعتني ولم اكن","سوى ريشة ان شبه الغير بالنسر",10,"ر",1,0],["وهل صافحت أنفاسها راحة الصبا","فإنا شممنا من أساريرها العطرا",11,"ر",2,0],["وهل صفة فيها تقوم بأختها","فنعذرهم فيها ادَّعَوه وشنَّعوا",12,"ع",3,0],["وهل صدرت يوماً ركابٌ تحثها","يد الموت للآجال والقبر مورد",13,"د",1,0],["وهل صفاؤك الا حين ننظره","طيف تراه لدى الأحلام أجفان",14,"ن",1,0],["وهل صرف الردى الا غريمٌ","يطالبنا بانفسنا ديونا",15,"ن",2,0],["وهل صَنعَ القنابل ذو شعور","مُهدرَجةً لنا أو ذو ضمير",16,"ر",1,0],["وهل صائل حاكاه في حومة الوغى","وهل هاجم ساواه والنار توقد",17,"د",1,0],["وَهَل صَفا العَيش إِلّا بعد تكدرة","وَهَل ذكا الجَمر إِلا إثر ملتهب",18,"ب",1,0],["وهل صحِبتَ فتىً جرّبت مَخبَره","في الوصف مثليَ حفّاظاً لأسرار",19,"ر",1,0],["وهل صحو لصب اسكرته","عيون العين أعيان الجمال",20,"ل",1,0],["وَهَل صِيغَ قَلبي أَو ذَخَرتُ مَدامِعي","لِغَيرِ وَفاءٍ أَو قَضاءٍ لِواجِبِ",21,"ب",1,0],["وَهَل صَبيحاتُ أَيّامٍ سَلَفنَ بِها","يَبدو مَساها وَلَو لَمحاً لِمُرتَقِبِ",22,"ب",1,0],["وهل صاحب الايقان وهو مشاهد","كاهل حجا ما قام إلا تهدما",23,"م",2,0],["وهل صفرت رحابك من ليوثٍ","غطارف من أباة الضيم صيد",24,"د",1,0],["وهل صافحتني بالسبات نجومه","وألحفني بالياسمين رداؤه",25,"ا",3,0],["وهل صار في مستنقع الشر طيب","وهل صار رمزا للمعالي مخاتل ؟",26,"ل",1,0],["وهل صحت بذلك مسندات","بهذا الرقص عن صحب وآل",27,"ل",1,0],["وهل صارت أساطيرا وصرنا","ذكورا طامحين الى الفحوله",28,"ه",1,0],["وهل صحراك إلا الخير منبجساً","من سافل الأرض يروي عالي الجبل",29,"ل",1,0],["وهل صَمَتَّ اضطراراً، أو مجانَفَةً؟","أم كنتَ أبلغَ أهلِ الأرضِ مُنشَعِبا؟!",30,"ب",2,0],["وهلْ صَالَ مَقطُوعُ الأيادي بِسَيفِهِ؟؟","لهذا توارى ثمّ عنها تصعلكا",31,"ك",2,0],["وهل صَحْبُ الطفولة غير أسٍّ","لتأسيس الصداقة في الشبابِ..؟",32,"ب",1,1],["وهل صار ذنبًا أنْ تكونَ مُلاطِفًا","لتزعُمَ ليلى أنّ قُربكَ مُقلِقُ؟!",33,"ق",1,0],["وهل صُنتَ سر اللَهِ بعدَ ظهورهِ","وكنت أميناً عنهُ هل لبست الحلا",34,"ل",2,0]]}