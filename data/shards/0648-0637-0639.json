budhabi.ae/diwan/poem/138591",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85237","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59509","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75681","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136954",""],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111198","الكامل"],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4927,"تحية البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=4573",""],[4929,"إرسالة إلى دماج","https://www.poetsgate.com/ViewPoem.aspx?id=202564",""],[4955,"هذي الدُّنا بنعيمها وعذابها","https://www.poetsgate.com/ViewPoem.aspx?id=187764",""],[585,"من مهبط الوحي حول البيت والحرم","https://www.poetsgate.com/ViewPoem.aspx?id=161898",""],[5077,"نصٌّ من الحبّ القديم ..","https://www.poetsgate.com/ViewPoem.aspx?id=36887",""],[5136,"أرج النسيم معنبر النفحات","https://www.poetsgate.com/ViewPoem.aspx?id=121528",""],[5183,"ثورة عدن","https://www.poetsgate.com/ViewPoem.aspx?id=185648",""],[5397,"هي الدنيا لها وصل وصد","https://www.poetsgate.com/ViewPoem.aspx?id=157913",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5431,"شَغِفْتُ بدفئه الأسمرْ","https://www.poetsgate.com/ViewPoem.aspx?id=185257",""],[5431,"في مهجتي سكنت سبعون عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=197383",""],[5561,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=192900",""],[5582,"أَمُوسِعَةً بِمُهْجَتِيَ الصُّدُوعا","https://www.poetsgate.com/ViewPoem.aspx?id=187177",""],[5582,"صَدَحَ الحَمامُ عَلَى الفُنُونِ وَناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186829",""],[5736,"نادمتني .. إلى إحداهن","https://www.poetsgate.com/ViewPoem.aspx?id=208249",""],[5753,"وحدي مَعِي..","https://www.poetsgate.com/ViewPoem.aspx?id=200355",""],[6056,"إسمك وعنوانك بجوالي","https://www.poetsgate.com/ViewPoem.aspx?id=130335",""],[6093,"آوَتْكَ دَارُ الكُفْرِ إذْ أرْضَيتَها","https://www.poetsgate.com/ViewPoem.aspx?id=176424",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[463,"أمنْ أسماءَ والمسرى بعيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60031&r=&rc=87",""]],"verses":[["وَطَعّانٍ إِذا ما النَق","عُ عُصفِرَ ثَوبُهُ بِدَمِ",0,"م",1,0],["وَطِعانٌ تَندَقُّ فيهِ العَوالي","وَضِرابٌ يَزوَرُّ مِنهُ الحِمامُ",1,"م",1,0],["وَطَعَنتَ مِن غُرَرِ الكَلامِ بِفَيصَلٍ","لا يَستَقِلُّ بِهِ السِنانُ الأَزرَقُ",2,"ق",1,0],["وَطَعنَةِ رُمحٍ قَد خَرَطتُ نَجيعَها","كَما ماجَ فَرغٌ في الإِناءِ ذَنوبُ",3,"ب",1,0],["وَطَعمٌ لِبازي الشَيبِ لا بُدَّ مُهجَتي","أَسَفُّ عَلى راسي وَطارَ غُرابُ",4,"ب",1,0],["وطَعْنٌ يُجِرُّ القِرْنَ عاليَةَ القنا","ويَخْطِرُ منهُ في الرِّداءِ المُضَرَّجِ",5,"ج",1,0],["وَطَعمٌ يَلَذُّ لِمَن ذاقَهُ","كَلِذَّةِ ذِكراكَ لَو لَم يُمَلّ",6,"ل",1,0],["وطعانهُ قبل النضا","ل يُمرُّ ذلك طولَ حرسه",7,"س",2,0],["وَطَعنَةِ خَلسٍ قَد طَعَنتَ مُرِشَّةٍ","كَعَطِّ الرِداءِ لا يُشَكُّ طَوارُها",8,"ر",3,0],["وَطَعنٍ كَأَنَّ الطَعنَ لا طَعنَ عِندَهُ","وَضَربٍ كَأَنَّ النارَ مِن حَرِّهِ بَردُ",9,"د",1,0],["وَطَعنٍ يُجَمِّعُ شُذّانَهُم","كَما اِجتَمَعَت دِرَّةُ الحافِلِ",10,"ل",1,0],["وَطَعنَ غَطاريفٍ كَأَنَّ أَكُفَّهُم","عَرَفنَ الرُدَينِيّاتِ قَبلَ المَعاصِمِ",11,"م",1,0],["وَطَعمُ الريقِ إِذ جادَ","بِهِ وَالصَبُّ هَيمانُ",12,"ن",1,0],["وَطَعمُها لَو عَرَفتَ لَذَّتَهُ","لَزالَ عَنكَ الوَقارُ وَالأَدَبُ",13,"ب",1,0],["وطعنتُ في سنّ الكبير وما نبا","عن طَعنِ شاكلة البديع سناني",14,"ن",2,0],["وطَعْماكَ من شَهدٍ وطابَ لأَهلِهِ","وخُلقاكَ من سَهلٍ عَلَيهِم وَمِن وَعرِ",15,"ر",1,0],["وَطَعَنتُهُمُ في مَجدِهِ فَثَنَتكُمُ","زُعفٌ يُفَلُّ بِها السِنانُ اللَهذَمُ",16,"م",1,0],["وَطَعَنتَهُم بِالمَكرُماتِ وَبِاللُها","في حَيثُ لَو طَعَنَ القَنا لَتَكَسَّرا",17,"ر",2,0],["وَطَعنَةُ اللِ في الأَعداءِ نافِذَةٌ","تُعيِي الأَطِباءَ لا يُلوي لَها السُبُرُ",18,"ر",1,0],["وَطَعنُهُم الأَعداءَ شَزراً وَإِنَّما","يُسامُ وَيَقني الخَسفَ مَن لَم يُطاعِنِ",19,"ن",1,0],["وَطَعنَةِ خَلسٍ قَد طَعَنتَ مُرِشَّةٍ","لَها نَفَذٌ تَضِلُّ فيهِ المَسابِرُ",20,"ر",1,0],["وَطَعَنوا في الفُقهِ وَالحَديثِ","وَعَجِبوا مِن مَيِّتٍ مَبعوثِ",21,"ث",1,0],["وطعامٍ قد كَانَ يَعْهَدُهُ النا","سُ مَتاعاً لهمْ ولِلسيَّارَهْ",22,"ر",2,0],["وطَعِمْتُ لَحْمَ المارقينَ فَأَخْصَبَتْ","حالي وبَلَّغَنِي الزَّمَانُ شِفائِى",23,"ا",2,0],["وَطَعْنُ السِّنَانِ كَنَفْثِ اليَرَاعِ","وَكُلُّهُمَا بِالنُّهَى حُبِّرَا",24,"ر",2,0],["وَطَعْنَةِ خَلْسٍ قَدْ طَعَنْتَ مُرِشَّةٍ","لَهَا نَفَذٌ تَضِلُّ فِيهَا المَسَابِرُ",25,"ر",1,0],["وَطَعنٌ لِسُمرِ السَمهَريِّ مُحَطِّمٌ","عَلى أَنَّهُ لِلمَجدِ بانٍ وَناصِبُ",26,"ب",1,0],["وَطَعَنتَ فيهِم حاسِراً لا تَتَّقي","وَخزَ الرِماحِ وَلا تَهابُ سِهاما",27,"م",2,0],["وَطَعنٍ إِذا ما النَّقعُ ثارَ وَأَقبَلَت","بَنو الحَربِ أَمثالَ الجِمالِ المَصاعِبِ",28,"ب",1,0],["وَطَعنٌ إِذا الغُزُّ المَساعيرُ أَقبَلَت","تَخُبُّ مَذاكيها بِها وَتُناقِلُ",29,"ل",1,0],["وطعمُها كلَذَّة العِتاب","من بعدِ صَدٍّ طالَ واجْتنابِ",30,"ب",1,0],["وطَعْمُه قدْ زرتْ بالشَهد لذتهُ","ونورُه قد زرى بالشمسِ والقَمَرِ",31,"ر",1,0],["وَطَعْنٍ أَمَرَّ مِنَ الْمَوْتِ طَعْماً","وَضَرْبٍ أَحَرَّ مِنَ النّارِ وَقْدا",32,"د",2,0],["وطعامي وشراب واحد","وهو رمز فافهموه حسنا",33,"ن",2,0],["وطعن كأَنَّ الجَيش في الرَوع جَوهر","وَرمح عبيد اللَهِ سلك نظامِهِ",34,"م",2,0],["وطعامه وشرابُه وسماعه","ومرامه ورجاؤه وصفاؤه",35,"ا",3,0],["وطعان ومطعون","ومن اشفى ومن اهوى",36,"ا",1,0],["وطعمانِ إن طَمِعَ الحلوُ في","ه قام يدافعُ عنه المريرُ",37,"ر",1,0],["وطعنةُ حاتم وطَرٌ قَديمٌ","قضى مَروانُ فيها ما يريدُ",38,"د",1,0],["وطِعانُ اليَراعِ في لَبَّةِ القِرْنِ","كَطَعْنِ المُثَقَّفِ العَسَّالِ",39,"ل",1,0],["وطعنَ كلِّ ثُغرَةٍ","من أسمرٍ بأزرقِ",40,"ق",1,0],["وطعنٍ يمزّق أُهبَ النّحورِ","كمَعْمَعَةِ النّارِ بالفَرْقَدِ",41,"د",1,0],["وَطَعنٍ كَرُمحِ الشَولِ أَمسَت غَوارِزاً","جَواذِبُها تَأبى عَلى المُتَغَبِّرِ",42,"ر",1,0],["وطعنوه قيل في وركيه","وانتزعوا الرداء عن كتفيه",43,"ه",1,0],["وطَعنتِني قصداً برم","حِ قوامِكِ اللّدنِ الرّطيبِ",44,"ب",1,0],["وطعن خليسٍ كفرْغ النّضيح","أُْفْرِغَ منْ ثَعبِ الحاجِرِ",45,"ر",1,1],["وطعم فاق طعم الرا","ح معْ لحم القطا الكدْري",46,"ر",2,0],["وطعمُ ماء لماها","كطعم شهدٍ وسكر",47,"ر",1,0],["وطعامك الخشن البسيط ولو هفت","نفس تنادى الخيرُمن فلواتهِ",48,"ت",2,0],["وطعنت في سننن الالا","هِ فيا لقلة عقلكا",49,"ك",2,0],["وطعامي بالذكر خير طعام","وشرابي بالذكر خير شرابي",50,"ب",2,0],["وَطَعنه فيهم بِما تخرصا","عَلَيهم إِذ ذَمهم تنقصا",51,"ص",2,0],["وطعيناً يتلظى عطشاً","وصريعاً يتلوَّى سغبا",52,"ب",2,0],["وَطَعنٍ كَإِيزاعِ المَخَاضِ الضّوَارِبِ","فَيَا سَيِّداً يَحكِي الرّياضَ خلائِقَا",53,"ق",2,0],["وطعانٍ يمطر السمرَ دماً","فوقها حيثُ دمُ الأشراف سالا",54,"ل",2,0],["وطعامها لا يشبعون لأكله","ماثم أجواف ولا أقصاب",55,"ب",1,0],["وطعنٍ مثل أَبْهاءِ الصياصي","وأفواه المزاد إذا كفينا",56,"ن",2,0],["وطعامٌ ذُو غُصَّةٍ وعذابٌ","منه تُكوى الجِباهُ والأحشاء",57,"ا",2,0],["وطعنهم ووخزهم وضربهم","وكيهم في سلمهم وحربهم",58,"م",1,0],["وطعناً يخرقُ اللأَمات نترا","وضرباً يفلق الهامات هبرا",59,"ر",2,0],["وطعمها يجلب للافهام","بسكره حلاوةَ المدام",60,"م",1,0],["وَطَعِمتُمُ لَونَينِ لَونَ الشَّك وَالتَّ","شكِيكِ بَعدُ فَبِئسَتِ اللَّونَانِ",61,"ن",1,0],["وطعامهم ما تشتهيه نفوسهم","ولحوم طير ناعم وسمان",61,"ن",1,0],["وَطَعنَةِ خَلسٍ كَفَرغِ الإِزا","ءِ أُفرِغَ في مِثعَبِ الحائِرِ",62,"ر",1,1],["وطعمه حلو قليل العجْم","الأبيض الصافي الكبيرُ الجسمُ",63,"م",1,0],["وطعن بالقنا الخطيّ حتى","تحل بمن أخافكم الحتوف",64,"ف",1,0],["وطعامهم عين الزكاة وإنها","حرمت على آل الرسول بلا مِرا",65,"ر",2,0],["وطعامٌ به وفاكهةٌ فيه","وفيه نور تؤج وماءُ",66,"ا",2,0],["وَطعنة خلسٍ تَلافَيتها","كَعطّ النساءِ الرداء الحجوبا",67,"ب",2,0],["وطعام موسى وهو حلو ملّهُ","أقوامهُ مِن حيث دامَ سَآمة",68,"ه",1,0],["وطَعامٌ لجابرٍ إذْ أتاه","وبخَفْضِ الإضافةِ النَّعْماءُ",69,"ا",2,0],["وَطَعنة خلسٍ قَد طعنت مُرشّةٍ","عَلى بزنيٍّ كَالشهاب رعوفِ",70,"ف",1,0],["وَطَعنة خلسٍ قَد طعنتَ مرشّة","عَلى يزنيٍّ كالشهاب رعوفِ",71,"ف",1,0],["وطعامِهم وخلالِهم وشرابِهم","ومناكرٍ يأتونها وسطَ الندي",72,"د",2,0],["وطعنَّا فَحَلَلْنا نجوةً","حولَها فارسُ والرومُ اِطَارُ",73,"ر",1,0],["وطعناً منحناه النّحورَ وحاجةً","أنِفنا لها أنْ تُقْتَضى بالخَصائِمِ",74,"م",1,0],["وطعنةُ الفارسينِ واحدةٌ","كأنّ رمحَ الأخيرِ مِسْبارُ",75,"ر",1,0],["وطعنٌ في حوادثِهِ وضَربٌ","يُقصِّرُ عن حكايتِه المَقالُ",76,"ل",1,0],["وَطَعنٍ كَفَمِ الزِقِّ","غَذا وَالزِقُّ مِلآنُ",77,"ن",1,0],["وطعنت فيه بخنجرٍ","من كف ضليل وناكب",78,"ب",1,0],["وطعن سنان بالمثقف صدره","بأحشائها جرحاً إلى الحشر أثرا",79,"ر",2,0],["وَطَعامُهُم مِن لَحمِ طَيرِ ناعِمٍ","كالبُختِ يُطعم سائِرَ الأَلوانِ",80,"ن",1,0],["وطعناً ترى نفذ الأسنة لمعاً","مِن القوم يعوي جرحها لم يسدد",81,"د",1,0],["وطعنٍ كأفواه المزادِ تحللَّت","وقد أُترعت بالماء منها المحازمُ",82,"م",1,0],["وطعن لا يذم الكر منه","إذا ذم الفرار من الجلاد",83,"د",1,0],["وَطعنة رمح تحت ضربة سيفه","هي المقلة النَجلاء من تحت حاجب",84,"ب",1,0],["وطعم البين ممجوج مريرٌ","إذا ما فارق الخلَّ الخليل",85,"ل",1,0],["وطعنت حتى ليس غير مكسر","وضربت حتى ليس غير مثلم",86,"م",1,0],["وطعن بالثغور وبالتراقي","به الأعداء أمست كالحصيد",87,"د",1,0],["وَطَعَّمُوْهَاْ(13) بِثُلْثٍ مِنْ سَمَاْسِرَةٍ","جَاْلُوْا، وَمَاْلُوْا إِلَىْ أَوْهَاْمِ وَاْشِيْهَاْ(14)",88,"ي",3,0],["وطعنةٍ في الضميرِ قاتلةً","ونكسةٍ في الأخلاقِ تنجسدُ",89,"د",1,0],["وطعامها أثمارُ زقومٍ إذا","دخلت إلى جوفٍ ستحرقُ صاهره",90,"ر",2,0],["وطعنة السيف تمضي لا بقاء لها","لكن على الدهر تبقى طعنة القلم",91,"م",1,0],["وطعونٌ سافرَتْ في الصدرِ دهراً","ثمّ عادَتْ لِترى الجُرْحَ نديّا",92,"ي",2,0],["وطعام طعم قال أحمد ماؤها","يغنى برشفته عن الأقوات",93,"ت",1,0],["وطعنت كلى العملا بشباً","فولاذ النصر مجرده",94,"د",2,0],["وطعم مذاقها حلو ومر","كأن مزاجها صبر وشهد",95,"د",1,0],["وطعنة رمح أدركت كل فارس","لدى الكر ميلا وهو عن سرجه مالا",96,"ل",2,0],["وطعم الردى أمرى من الشهد عندهم","غداة أطاعوا للحسين به أمرا",97,"ر",2,0],["وطعم القمحِ والسكرْ","وبل أكثر..وبل أكثر",98,"ر",1,0],["وطعنة الحرب ويلاتٌ تكابدها","وشهقة الروح جرح منك مكشوح",99,"ح",1,0],["وطعنةُ الحرفِ أمضى في نفوسهمُ","مِن أنْ تسيلَ دماءٌ إثرَها الجيدُ",100,"د",1,0],["وَطَعْنٍ مِنْ قَنا الخَطِّيِّ يَبْقَى","لَهُمْ بَيْنَ الضُّلُوعِ بِهِمْ ضُلُوعا",101,"ع",2,0],["وَطَعِمْتُ عَذْبَ مُجاجِها وَكأَنَّنِي","مِنْ ثَغْرِها أَسْتَطْعِمُ التُّفَّاحَا",102,"ح",2,0],["وطُعمتِ من قوتِ الفؤادِ حشاشةٌ","وشربتِ ماءَ العينِ شهدًا ماتعا",103,"ع",2,0],["وطِعانِ غدرٍ لمْ تزلْ منزوفةً","تجتاحُهَا فوضَى منَ النّيرَانِ",104,"ن",1,0],["وطعنتني من خنجر ٍ مسموم","وأنا الغدر ما جاء على بالي",105,"ل",2,0],["وطَعَنْتَ في شَرَفِ النَّبيِّ بفِرْيَةًٍ","ضَجَّ المَلائِكُ والأَنَامُ لِهُجْرِِها",106,"ر",3,0],["وطعمُ الصبر في رحم التلظّي","كطعم الموت مورده كئيبُ",107,"ب",1,0],["وطعنة ُ حاتم وطرٌ قديمٌ","قضى مروانُ فيها ما يرديُ",108,"د",2,0]]}