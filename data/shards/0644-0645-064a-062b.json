41,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77072","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77078","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119671","الكامل"],[4172,"","https://poetry.dctabudhabi.ae/diwan/poem/147786","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94330","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94391","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136650",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33176","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33330","البسيط"],[4767,"طود العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=94353",""],[4767,"صفحة الخير","https://www.poetsgate.com/ViewPoem.aspx?id=125022",""],[4767,"مولد الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179941",""],[4767,"دوحة الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179942",""],[4767,"الخطب الجلل","https://www.poetsgate.com/ViewPoem.aspx?id=202138",""],[1901,"لا تعجبوا إن قلتُ بانتْ سعادْ","https://www.poetsgate.com/ViewPoem.aspx?id=160414",""],[4858,"يا نَصْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=29797",""],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[5050,"إن جاء نصر الله والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=38195",""],[585,"أقسمتُ أنكَ روضةٌ وجنان","https://www.poetsgate.com/ViewPoem.aspx?id=161909",""],[5129,"حكايتنا","https://www.poetsgate.com/ViewPoem.aspx?id=122674",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[307,"أجملُ ما في الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=213656",""],[5376,"للموتِ في شامِ الورى أفياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=196577",""],[5459,"مدلجون..","https://www.poetsgate.com/ViewPoem.aspx?id=191597",""],[5626,"عجبي عل كل المحاسن","https://www.poetsgate.com/ViewPoem.aspx?id=189694",""],[5854,"رثاء الشيخ الوالد أبو زيد محمد حمزة","https://www.poetsgate.com/ViewPoem.aspx?id=191884",""],[6145,"على خطا شيخ الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=7796",""],[6223,"يا حادي الركب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1210&r=&rc=7",""],[6277,"ظلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64482&r=&rc=45",""],[5190,"انتفاضة الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78346&r=&rc=59",""]],"verses":[["لَم يُثَقِّف عودي الزَمانُ وَلَكِن","ضَجَّ عودُ الزَمانِ مِن تَثقيفي",0,"ف",2,0],["لَم يُثمِرِ الظَنُّ الجَميلُ بِهِ","فَقَدي مِنَ الظَنِّ الجَميلِ قَدي",1,"د",2,0],["لمْ يَثْوِ حُبُّكَ في فؤادي وَحْدَهُ","لكنْ جَرى في أعْظُمي ومُشاشي",2,"ش",2,0],["لَمَيثاءَ دارٌ قَد تَعَفَّت طُلولُها","عَفَتها نَضيضاتُ الصَبا فَمَسيلُها",3,"ل",3,1],["لَمَيثاءَ إِذ كانَت وَأَهلُكَ جيرَةٌ","رِئاءٌ وَإِذ يُفضي إِلَيكَ رَسولُها",3,"ل",3,0],["لَم يَثنِهِ عَنكَ الرَئي","سُ وَلا رَمى عَنكَ الخُطوب",4,"ب",1,0],["لَم يَثنِني عَن أَمَلٍ ما جَرى","قَد يُرقَعُ الخَرقُ وَتُؤسى الجِراح",5,"ح",1,0],["لم يُثْنني عن هواك ثانِ","يا بغية القلب قد كفاني",6,"ن",2,0],["لم يثنه عن كل ما","قد رام إلاّ أن يحوزه",7,"ز",2,0],["لم يُثقَّل ولم يشذَّبْ وإن كا","نتْ له هيبةُ الطوال البِجالِ",8,"ل",1,0],["لَم يُثكَلوا لَيثَ حَربٍ مِثلَ قَحطَبَةٍ","مِن بَعدِ قَحطَبَةٍ في سالِفِ الزَمَنِ",9,"ن",1,0],["لَم يَثنِ في السَرّاءِ مِن تيهٍ بِها","أَعطافَهُ فَيَخورُ في الضَرّاءِ",10,"ا",2,0],["لم يَثْنِها والظلمُ يَهدِرُ حولها","كالرّعدِ صَوْبٌ للردى سَحّاحُ",11,"ح",1,0],["لم يَثْنِهِ عِزُّ الخِلافَةِ والعُلى","والمجْدُ والتّعظيمُ والتبجيل",12,"ل",1,0],["لَم يُثبِتوا بِقِياسٍ أَصلَ دينِهِمُ","فَيَحكُموا بَينَ رُفاضٍ وَنُصّابُ",13,"ب",1,0],["لَم يَثنِ عَن فارِسٍ وَحِميَرِها","دُروعُها المَوتَ أَو جَواشِنُها",14,"ن",3,0],["لَمْ يَثْنِهِ دُونَ القِيَامِ بِوَاجِبٍ","بَأْسُ المُلُوكِ وَلاَ نَدَى الأَقْيَالِ",15,"ل",1,0],["لَمْ يَثْنِهِ عَنْ وَاجِبٍ بَرْحٌ بِهِ","وَزَمَانُهُ قَاسٍ عَلَيْهِ شَدِيدُ",16,"د",1,0],["لَمْ يَثْنِهِم يَومَ الذِّيَادِ عَنِ الحِمَى","ضَنٌّ بِأَموَالٍ وَلاَ بِدِمَاءِ",17,"ا",2,0],["لِمَيثاءَ دارٌ عَفا رَسمُها","فَما إِن تَبَيَّنُ أَسطارَها",18,"ر",3,1],["لم يثنه عز الخلافة والعلى ... والمجد ، والتعظيم ، والتبخيل","بين المواكب خاشعاً متواضعاً ... والأرض تخشع بالعلى ، وتميل",19,"ل",1,0],["لم يثنه عن أن يهيم بحبها","عمر أقل سنيه خمسون",20,"ن",1,0],["لم يثْنهِ عن هواهِ الطالعاتِ على","وردِ الخدودِ ولا يعروهُ إبدالُ",21,"ل",1,0],["لَم يَثنِ عَزمَكَ أَن وَجَدتَ طَريقُهُ","مُستَبعَداً وَمُحِبَّهُ مُستَعبَدا",22,"د",2,0],["لم يثنه عن نصر دين إلهه","مع كثر من يثنيه عنه ثاني",23,"ن",2,0],["لم يثنه بالعذل عن بذل اللهى","ثان ولا يلهيه عنه مفند",24,"د",1,0],["لم يثنه في الجود عن بذل اللهى","ثان ولا يلهيه عنه ملام",25,"م",1,0],["لم يثنه ثان عن العليا ولا","في الجود يسمع ما تقول اللوم",26,"م",1,0],["لم يثقب المعنى بفكر جامد","أين اقتراع البكر من عنين",27,"ن",1,0],["لَم يَثْنِ غَيّاً إلى رُشْدٍ أَعِنَّتَهُ","لا بَلْ تَعَلَّقَ أَصْناماً وأَوْثانا",28,"ن",2,0],["لَم يثنِ طائرُ صيتهِ عن جوّهِ","طولَ الثواءِ لِجسمهِ المرموسِ",29,"س",1,0],["لَم يثنِ عنها للتكاثرِ عزمهُ","يَوماً وَلَم يَستوطئ الأعذارا",30,"ر",2,0],["لَم يثنِ عَزمي عن طروقِ حماكمُ","لولا اِحتشام قَد ثَنى عَزماتي",31,"ت",2,0],["لَم يُثنِهِ عَن ظِلِّ ضالِ طُوَيلِعٍ","وَشَرابِهِ خَدعُ الفَلا بِسَرابِهِ",32,"ب",2,0],["لَم يَثنِ عَطفي عَنكَ عَطفَهُ","لِلصَدِّ عَنكَ عَلى الغِوايَةِ يَبحَثُ",33,"ث",1,0],["لَم يُثنِهِ في الحُبِّ عَن قَصدِهِ","سَيفٌ وَلا رُمحٌ وَلا جَرخُ",34,"خ",1,0],["لَم يُثنِهِعَن قَولِهِ","هَذيُ مَقالِ مَن هَذا",35,"ذ",2,0],["لَم يُثر خَيلاً إِلَى نَيلِ مَدىً","فَأصَابَت دَونَهُ مَا حُبِسَا",36,"س",2,0],["لم يُثْبِتِ الرِّجْلَ في غَرْزٍ لها أَحَدٌ","وَمَدَّ كَفّاً إلى نَجْمٍ فلم يَصِل",37,"ل",1,0],["لم يثنهم عن حقهم جبروته","لولا القوى ما كان بالجبار",38,"ر",1,0],["لم يَثنِ فأل الشهورِ عزمتَه","لا صَفَرٌ عائقٌ ولا رجبُ",39,"ب",1,0],["لم يثو في أهله أهل العباء ففا","ت القومَ وحيٌ بمثواهُ وتنزيل",40,"ل",1,0],["لم يثن عزمي تنكيت الحواسد في","شيء تثبته لم يبل بالعطب",41,"ب",1,0],["لم يثنها ما بدا بالخافقين ولم","كن التجلي على الأكوان مدرار",42,"ر",1,0],["لم يثنها عنا التباس تماثل","من وردها أضحى لنا سلسالا",43,"ل",2,0],["لم يثرِ مَن لم يُغنِ مفتقراً ولمْ","يَنَلِ الغِنى من لا تراه ينيلُهُ",44,"ل",2,0],["لم يثنهِ البعدُ عن صنعِ الجَميل وهَل","تُنسِي السنون كريماً سابقَ الذِمَمِ",45,"م",1,0],["لم يثننا سهل ولاجبل ولا","سغب ولا نصب وضيق شعاب",46,"ب",1,0],["لم يثن عزمي عن المكْ","رمات قُرٌّ ولا حَر",47,"ر",1,0],["لَمْ يَثْنِ فِي طَلَبٍ أعِنَّةَ خيله","إلاَّ اعترى مَهْزُومَهَا الخذلانٌ",48,"ن",1,0],["لَمْ يُثْنِ في طَلَبٍ أعِنَّةَ خَيْلِهِ","إلاّ اعْتَرَتْ مَهْزُومَهَا النَّكْبَاءُ",49,"ا",2,0],["لم يثنك الشوق عن سعى تكابده","ولم يغيِّرك ما تشكو من السقم",50,"م",1,0],["لَم يثنِها بَعدَ الديار عَن الَّتي","جَعَلتك حلا للحجيج وَمنسكا",51,"ك",2,0],["لَمْ يَثْنِ كَفَّيْهِ لِجامُ البُخْلِ","وَلا تَعَقَّاهُ يَمِينُ المُؤْلِي",52,"ل",2,0],["لَمْ يَثْنهِ عَنْكِ ثانٍ مِنْ حَديث هَوَىً","ولا مُغاداةُ غِزْلانٍ بِأَغْزالِ",53,"ل",1,0],["لم يثن منك الشباب عطفا","ولا استمال الفخار جيدا",54,"د",2,0],["لم يثنه عن رشف ذياك اللما","الا اجتناب الظن من أهليك",55,"ك",1,0],["لَم يَثنِهِ عَن ذاكَ بُعدُ العَهدِ","وَلا الَّذي مَرَّ بِهِ مِن جُهدِ",56,"د",1,0],["لم يَثنيها حَشدُ الجموع عن المنى","كلا ولم تَحفِل بهولِ طِعَانِ",57,"ن",1,0],["لم يَثْنِها عِزُّ الملوك عن التُّقَى","وتَزَوُّدٍ من هذه لمعاد",58,"د",1,0],["لَم يُثنِهِ قَومُهُ يَشتَدُّ غَيظُهُمُ","في إثرِهِ بِالأَذى في الحِلِّ وَالحَرَمِ",59,"م",1,1],["لم يثنه العذل عن تصميم عزمته","كانما صمتا اذناه عن عذل",60,"ل",1,0],["لم يثن عز الملك عنه منونه","فسمت له من حيث لم يك يحذر",61,"ر",1,0],["لم يثن بايعها تغليظ حوجتها","ولا ثنى مشتريها ان يسيرها",62,"ر",3,0],["لم يثنهم هول الرواعدِ والمدا","فِعِ بالرَّصاصِ كَمُكفَهِرِّ سَمَاءِ",63,"ا",2,0],["لم يثنك الجيش الكثيف بغارة","داوود سد بها الفضاء الاعظما",64,"م",2,0],["لم يثنني مرة عقوقهمو","عن بذل عطفي لهم وارشادي",65,"د",2,0],["لم يَثْنهم طولُ الطريق لهم ولا","عدمُ الرفيق ولا نفاذُ الزّاد",66,"د",1,0],["لم يُثنهْ عن عزمِه أهلُ ولا","مالُ ولا خوفُ نعيم يُعدم",67,"م",1,0],["لم يَثنِ عَزمتَهُ انحِلالُ عَزائِمٍ","مِن مَعشَر جبُنوا وَعَهدَ اللّه صانَه",68,"ن",2,0],["لم يثْنِني بذْلُ الرّغائبِ نحوَهُ","حتى انثَنى لي خدُّه والأخْدَعُ",69,"ع",1,0],["لمْ يثْنِها عن قصْدِها خجَلٌ وقدْ","راقَتْ بهِ وجَناتُها توْريدا",70,"د",2,0],["لم يَثْنِها قوْلُ الوُشاةِ وإنما","ريحُ الصَّبا مالَتْ بغصْنٍ أهْيَفِ",71,"ف",1,0],["لم يثن قطع يديه منه عزيمةً","عما يروم وكثرة العدوان",72,"ن",1,0],["لم يُثنَ عنكِ نُهىً ولم","يستثنِ نُطقٌ في ثَنائِك",73,"ك",1,0],["لم يثنه عن همة همٌّ وَلا","عن حق خالقه سرورٌ فاني",74,"ن",2,0],["لَم يَثنها لما رنت عَن مُهجَتي","حَزمي وَلَم يَسَعِ الهَوى كتماني",75,"ن",2,0],["لَم يَثنهِ عَن حُبه ذو طَلعةٍ","تَركت لها الأَحداق في أَحداق",76,"ق",1,0],["لم يثنها عن سوء عادتها مشي","ب الراس بل ركنت إلى الإصرار",77,"ر",1,0],["لم يثنه عطفٌ على ذي حاجةٍ","فكأن حبةَ قلبه جلمودُ",78,"د",1,0],["لم يثنني لاح ألح بذكركم","ومن الغباوة أن تميل إلى الغبى",79,"ب",2,0],["لم يثنه البث على الرفيق","عن موقف الطرواد والإغريق",80,"ق",1,0],["لَم يُثنِهِ عَن طلاب المَجد خَرعبة","شابَت بِغَنج بَكاها ساعَة النَقل",81,"ل",1,0],["لَم يُثنِكَ الهَولُ عَمّا رُمتُ غايَتَهُ","وَلَم تَكُن في الَّذي كابَدَتهُ جَزعا",82,"ع",2,0],["لَم يُثنِهِ زُمرُ الأَعداءِ عَن أَمَل","وَلا مَنيعُ حُصونِ اللَيثِ ذي اللَبَد",83,"د",1,0],["لَم يُثنِني عَنكُمُ تلعابُ غانِيَة","غَنجا إِلَيها صُنوفُ الحُسنِ تَنتَسِبُ",84,"ب",1,0],["لم يثنِه المثنون عن انعامه","بل يثنه المثني على الانعام",85,"م",1,0],["لم يثن من سربها سريٌ تحاذره","ولم يرُعْها بزجرٍ فتية رَصَد",86,"د",1,0],["لم يثننا عن مقيل البان من أضم","حيث الخمائل ذات الرند والعذب",87,"ب",1,0],["لَم يثنِ عزمي عن بلوغ مآربٍ","عزمٌ وشأني في الورى مشهورُ",88,"ر",1,0],["لم يُثنِ قَلبي عن مديح صفاتها","إِلّا صفات قد شملنَ محمدا",89,"د",2,0],["لم يَثنه عذلُ العواذل عن هوى","رشأٍ ثَناه اليومَ عن أوثانه",90,"ن",2,0],["لم يثنها حذرٌ عن لحظِ ذي غنجٍ","به أدام هواها فيضَ عبرتِها",91,"ت",3,0],["لم يثنِ عنك الردى يا قلبي الحذرُ","هذا الذي لم تزل يا قلبُ تنتظِرُ",92,"ر",1,1],["لم يثنهم في سعيهم ما قاله","واشٍ وساعٍ بالنميمة لائم",93,"م",1,0],["لَم يثنه عن طريق الخير معترض","حتى وإن حادث من قومه نزلا",94,"ل",2,0],["لم يَثنه عن نشرِ دعوته","مهما أتى عمرٌو ولا زيد",95,"د",1,0],["لم يُثنِهم عن طريق الحق منحرفٌ","مهما تمادى لأهل الحق يحتقر",96,"ر",1,0],["لم يُثنِه عن غايةٍ عارضٌ","كلا ولم يوقِفْه يوماً كلل",97,"ل",1,0],["لم يَثنها عني على ما أرى","ثانٍ ولكنْ رثُّ حَبلَ الودادِ",98,"د",1,0],["لم يثنهِ شُحُّ السّلاح عن الوغى","فمضى \"يُصنّع\" حارقاً أو راجما",99,"م",2,0],["لم يثنِ تيها بالمكارم عِطفه","لم يدْنُ منه تكبُّرٌ وتصلفُ",100,"ف",1,0],["لم يثنه والمجد شاهدة","عن العلى حرب ولا صلح",101,"ح",1,0],["لم يثن عزمك والكتائب شمرت","نصلٌ يشب توقداً وسنان",102,"ن",1,0],["لم يُثْنِنا عن لَهفَةٍ طُولُ المَدى","ودُريْبُ جَفْوٍ في الحياةِ قصيرْ",103,"ر",1,0],["لم يثن يومئذ سوى طاغوتهم","قد مر ثاني اثنين شبه سقاء",104,"ا",2,0],["لم يثنهمْ غسقُ النعاسِ كأنّما","قد ألّبوا بين الجفونِ خِصاما",105,"م",2,0],["لم يثنهم طعنُ المنون بصدْرِهِمْ","أطفالُهم في نومِهم عظماءُ",106,"ا",2,0],["لَمْ يُثْمِرِ الدَّمْعُ غَيْرَ الْبُؤْسِ يَدْهَسُكُمْ","وَ الضَّعْفِ يَصْرَعُكُمْ وَ الْيَأْسِ يَضْطَرِمُ..",107,"م",1,0],["لَمْ يُثْمِلِ الخَمْرُ المُعَتَّقُ صَحْوَتي","لكنْ سُقيتُ مِنَ اللّحاظِ ثُمالا",108,"ل",2,0],["لم يُثْنِهِ عنْ دينِه عَددُ العِدا","وعتادُهم وتجبّرُ الرُؤساءِ",109,"ا",2,0],["لم يثنها بطش العدو وبغيه","أو خائف متخاذل أو قاعدُ",110,"د",1,0],["لم يثنها ظلم القريب وضعفه","أو يثنها كيد رجاه الكائدُ",110,"د",1,0],["لم يثنِ سيرك في البيداء ذو ظفر","ولا ثنى العزم لا يأسٌ ولا مللُ",111,"ل",1,0],["لم يثنني عن سيره تنديد","وبيده تضلّ فيه البيد",112,"د",1,0],["لم يُثنِ همتكم بطشٌ وقنبلةٌ","ألقت بها عبثاً كفٌّ من الرَّهَبِ",113,"ب",1,0]]}