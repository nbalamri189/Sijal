{"poems":[[53,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[63,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[9,"لميثاء دار قد تعفت طلولها","https://www.aldiwan.net/poem21963.html","الطويل"],[86,"ما أنت أول كوكب","https://www.aldiwan.net/poem10470.html","مجزوء الكامل"],[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[83,"ما لي بحمل الهوى يدان","https://www.aldiwan.net/poem54237.html","مخلع البسيط"],[88,"أهلاً بأضياف العراق","https://www.aldiwan.net/poem44398.html","مجزوء الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[44,"اليوم أدرج زيد الخيل في كفن","https://www.aldiwan.net/poem30299.html","البسيط"],[74,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[46,"الدهر ينسخ أولاه أواخره","https://www.aldiwan.net/poem22194.html","البسيط"],[46,"هذي القضايا فمن يطاولها","https://www.aldiwan.net/poem23461.html","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54762","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[9,"","https://poetry.dctabudhabi.ae/diwan/poem/10545","المتقارب"],[75,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[125,"هلملم هلم نلم شعث قريضنا","https://www.aldiwan.net/poem23771.html","الكامل"],[136,"لي في الصبابة أخبار وأحوال","https://www.aldiwan.net/poem49113.html","البسيط"],[144,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[161,"خاطر بنفسك في رضى الرحمن","https://www.aldiwan.net/poem59197.html","الكامل"],[211,"أقضيب بان أم قوام أملد","https://www.aldiwan.net/poem13456.html","الطويل"],[211,"وافى السرور وصحت الأحلام","https://www.aldiwan.net/poem13476.html","الكامل"],[211,"أوميض برق بالحمى يتوهم","https://www.aldiwan.net/poem13505.html","الطويل"],[262,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[276,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[306,"ما أم ذو أمل حمى ابن عروس","https://www.aldiwan.net/poem56501.html","الكامل"],[306,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[306,"مولاي وافتني تحيتك التي","https://www.aldiwan.net/poem56592.html","الكامل"],[350,"عرض الحياة لقلما يسعى له","https://www.aldiwan.net/poem15529.html","الكامل"],[350,"غيري لمثق عهد حبك ينكث","https://www.aldiwan.net/poem15553.html","الكامل"],[350,"شرعة وجدي ما لها نسخ","https://www.aldiwan.net/poem15566.html","السريع"],[350,"لست بذي وجد إذا","https://www.aldiwan.net/poem15651.html","مجزوء الرجز"],[358,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[365,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[450,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[459,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[465,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[480,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[483,"من يوم كنت عصا الوجدان تسيار","https://www.aldiwan.net/poem24372.html","عموديه"],[483,"ماذا على من غزلته سكينة","https://www.aldiwan.net/poem24465.html","عموديه"],[552,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"]],"verses":[["لَم يُثَقِّف عودي الزَمانُ وَلَكِن","ضَجَّ عودُ الزَمانِ مِن تَثقيفي",0,"ف",2,0],["لَم يُثمِرِ الظَنُّ الجَميلُ بِهِ","فَقَدي مِنَ الظَنِّ الجَميلِ قَدي",1,"د",2,0],["لمْ يَثْوِ حُبُّكَ في فؤادي وَحْدَهُ","لكنْ جَرى في أعْظُمي ومُشاشي",2,"ش",2,0],["لَمَيثاءَ دارٌ قَد تَعَفَّت طُلولُها","عَفَتها نَضيضاتُ الصَبا فَمَسيلُها",3,"ل",3,1],["لَمَيثاءَ إِذ كانَت وَأَهلُكَ جيرَةٌ","رِئاءٌ وَإِذ يُفضي إِلَيكَ رَسولُها",3,"ل",3,0],["لَم يَثنِهِ عَنكَ الرَئي","سُ وَلا رَمى عَنكَ الخُطوب",4,"ب",1,0],["لَم يَثنِني عَن أَمَلٍ ما جَرى","قَد يُرقَعُ الخَرقُ وَتُؤسى الجِراح",5,"ح",1,0],["لم يُثْنني عن هواك ثانِ","يا بغية القلب قد كفاني",6,"ن",2,0],["لم يثنه عن كل ما","قد رام إلاّ أن يحوزه",7,"ز",2,0],["لم يُثقَّل ولم يشذَّبْ وإن كا","نتْ له هيبةُ الطوال البِجالِ",8,"ل",1,0],["لَم يُثكَلوا لَيثَ حَربٍ مِثلَ قَحطَبَةٍ","مِن بَعدِ قَحطَبَةٍ في سالِفِ الزَمَنِ",9,"ن",1,0],["لَم يَثنِ في السَرّاءِ مِن تيهٍ بِها","أَعطافَهُ فَيَخورُ في الضَرّاءِ",10,"ا",2,0],["لم يَثْنِها والظلمُ يَهدِرُ حولها","كالرّعدِ صَوْبٌ للردى سَحّاحُ",11,"ح",1,0],["لم يَثْنِهِ عِزُّ الخِلافَةِ والعُلى","والمجْدُ والتّعظيمُ والتبجيل",12,"ل",1,0],["لَم يُثبِتوا بِقِياسٍ أَصلَ دينِهِمُ","فَيَحكُموا بَينَ رُفاضٍ وَنُصّابُ",13,"ب",1,0],["لَم يَثنِ عَن فارِسٍ وَحِميَرِها","دُروعُها المَوتَ أَو جَواشِنُها",14,"ن",3,0],["لَمْ يَثْنِهِ دُونَ القِيَامِ بِوَاجِبٍ","بَأْسُ المُلُوكِ وَلاَ نَدَى الأَقْيَالِ",15,"ل",1,0],["لَمْ يَثْنِهِ عَنْ وَاجِبٍ بَرْحٌ بِهِ","وَزَمَانُهُ قَاسٍ عَلَيْهِ شَدِيدُ",16,"د",1,0],["لَمْ يَثْنِهِم يَومَ الذِّيَادِ عَنِ الحِمَى","ضَنٌّ بِأَموَالٍ وَلاَ بِدِمَاءِ",17,"ا",2,0],["لِمَيثاءَ دارٌ عَفا رَسمُها","فَما إِن تَبَيَّنُ أَسطارَها",18,"ر",3,1],["لم يثنه عز الخلافة والعلى ... والمجد ، والتعظيم ، والتبخيل","بين المواكب خاشعاً متواضعاً ... والأرض تخشع بالعلى ، وتميل",19,"ل",1,0],["لم يثنه عن أن يهيم بحبها","عمر أقل سنيه خمسون",20,"ن",1,0],["لم يثْنهِ عن هواهِ الطالعاتِ على","وردِ الخدودِ ولا يعروهُ إبدالُ",21,"ل",1,0],["لَم يَثنِ عَزمَكَ أَن وَجَدتَ طَريقُهُ","مُستَبعَداً وَمُحِبَّهُ مُستَعبَدا",22,"د",2,0],["لم يثنه عن نصر دين إلهه","مع كثر من يثنيه عنه ثاني",23,"ن",2,0],["لم يثنه بالعذل عن بذل اللهى","ثان ولا يلهيه عنه مفند",24,"د",1,0],["لم يثنه في الجود عن بذل اللهى","ثان ولا يلهيه عنه ملام",25,"م",1,0],["لم يثنه ثان عن العليا ولا","في الجود يسمع ما تقول اللوم",26,"م",1,0],["لم يثقب المعنى بفكر جامد","أين اقتراع البكر من عنين",27,"ن",1,0],["لَم يَثْنِ غَيّاً إلى رُشْدٍ أَعِنَّتَهُ","لا بَلْ تَعَلَّقَ أَصْناماً وأَوْثانا",28,"ن",2,0],["لَم يثنِ طائرُ صيتهِ عن جوّهِ","طولَ الثواءِ لِجسمهِ المرموسِ",29,"س",1,0],["لَم يثنِ عنها للتكاثرِ عزمهُ","يَوماً وَلَم يَستوطئ الأعذارا",30,"ر",2,0],["لَم يثنِ عَزمي عن طروقِ حماكمُ","لولا اِحتشام قَد ثَنى عَزماتي",31,"ت",2,0],["لَم يُثنِهِ عَن ظِلِّ ضالِ طُوَيلِعٍ","وَشَرابِهِ خَدعُ الفَلا بِسَرابِهِ",32,"ب",2,0],["لَم يَثنِ عَطفي عَنكَ عَطفَهُ","لِلصَدِّ عَنكَ عَلى الغِوايَةِ يَبحَثُ",33,"ث",1,0],["لَم يُثنِهِ في الحُبِّ عَن قَصدِهِ","سَيفٌ وَلا رُمحٌ وَلا جَرخُ",34,"خ",1,0],["لَم يُثنِهِعَن قَولِهِ","هَذيُ مَقالِ مَن هَذا",35,"ذ",2,0],["لَم يُثر خَيلاً إِلَى نَيلِ مَدىً","فَأصَابَت دَونَهُ مَا حُبِسَا",36,"س",2,0],["لم يُثْبِتِ الرِّجْلَ في غَرْزٍ لها أَحَدٌ","وَمَدَّ كَفّاً إلى نَجْمٍ فلم يَصِل",37,"ل",1,0],["لم يثنهم عن حقهم جبروته","لولا القوى ما كان بالجبار",38,"ر",1,0],["لم يَثنِ فأل الشهورِ عزمتَه","لا صَفَرٌ عائقٌ ولا رجبُ",39,"ب",1,0],["لم يثو في أهله أهل العباء ففا","ت القومَ وحيٌ بمثواهُ وتنزيل",40,"ل",1,0],["لم يثن عزمي تنكيت الحواسد في","شيء تثبته لم يبل بالعطب",41,"ب",1,0],["لم يثنها ما بدا بالخافقين ولم","كن التجلي على الأكوان مدرار",42,"ر",1,0],["لم يثنها عنا التباس تماثل","من وردها أضحى لنا سلسالا",43,"ل",2,0],["لم يثرِ مَن لم يُغنِ مفتقراً ولمْ","يَنَلِ الغِنى من لا تراه ينيلُهُ",44,"ل",2,0]]}