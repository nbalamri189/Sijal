i.ae/diwan/poem/72786","الخفيف"],[4690,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=153108",""],[4802,"طقوس","https://www.poetsgate.com/ViewPoem.aspx?id=32339",""],[3591,"على الله أجر المسّهام المتيّم","https://www.poetsgate.com/ViewPoem.aspx?id=149475",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5174,"لغةٌ وعشق","https://www.poetsgate.com/ViewPoem.aspx?id=211700",""],[5185,"القاع","https://www.poetsgate.com/ViewPoem.aspx?id=71577",""],[5273,"قَبَسٌ من دارِ الأرقَم","https://www.poetsgate.com/ViewPoem.aspx?id=208601",""],[5277,"بقيةٌ من دمع","https://www.poetsgate.com/ViewPoem.aspx?id=191380",""],[5324,"حالة حب.","https://www.poetsgate.com/ViewPoem.aspx?id=212667",""],[5330,"شكوى العبيد إلى العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=15588",""],[5353,"ورد الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=214831",""],[5356,"{حيّاك يا ورداً","https://www.poetsgate.com/ViewPoem.aspx?id=205791",""],[5363,"اللهُ يا أللهُ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=199946",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[2110,"خطرت بأم عبيدة الريح الرخا","https://www.poetsgate.com/ViewPoem.aspx?id=156269",""],[5725,"هذي جراحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=211226",""],[5818,"ماذا عسى","https://www.poetsgate.com/ViewPoem.aspx?id=181337",""],[5848,"جنب السور","https://www.poetsgate.com/ViewPoem.aspx?id=53154",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[6125,"لَهَاهُ العِزُّ والمرتعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210905",""],[6131,"روحي رهينةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189335",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[6202,"خجلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86719&r=&rc=20",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[406,"إلى أين يا قومي ؟؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63654&r=&rc=84",""],[6332,"خجل الصّحوُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65172&r=&rc=1",""],[4890,"صورة وصفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72400&r=&rc=90",""]],"verses":[["خَجِلٌ يُنَمِّقُ عُذرَهُ","وَالعُذرُ شاهِدُ مَن نَدِم",0,"م",1,0],["خجّ في هذي الرعايا","قبلَ الرحمن حجك",1,"ك",1,0],["خَجِلتْ خُدودُ الوردِ مِن تفضيله","خجلاً تَورُّدُها عليه شاهدُ",2,"د",1,1],["خجِلتُ لِشَكواكَ في طيِّها","فَما كِدتُ أَسمَعُ لِلمُنشِدِ",3,"د",1,0],["خَجَلاً يُكتَسى بِهِ حُمرَةَ العُص","فُرِ مِن خيفَتي وَطاعَةِ أَمري",4,"ر",2,0],["خَجلتْ مَسابِحُها وَتِلكَ مُسوحُها","كادت لِطولِ عَذابها تَنْصاحُ",5,"ح",1,0],["خَجِلَتْ عُيُونُ الحُورِ حِينَ وصَفْتُها","وصْفَ المَشيبِ وقُلْنَ لِي لا تَبْعَدِ",6,"د",1,0],["خجل في نعل طفل محول","أمنع الأشواك أن تجرحه",7,"ه",1,0],["خَجِلَ الوَردُ إِذ رَأى وَجهَ مَن أَه","واهُ وَالجُلَّنارُ أَخجَلُ مِنهُ",8,"ن",2,0],["خَجلت شُموس الأُفق مِنهُ عِندَما","وافى بِتلك الطَلعة الحَسناءِ",9,"ا",2,0],["خَجلت قُلت لُؤلؤ ما نَراهُ","أَم بُدور قَد كَلَلتها النُجوم",10,"م",1,0],["خجلت لمثقلها السحاب وللنوى","لمعت لها بين الضلوع بروق",11,"ق",1,0],["خجل كئيب خائف من ذنبه","وجل حتى الظهر من أثقاله",12,"ل",2,0],["خجلا يغاورلي فواتر طرفه","وإليه ألسن حالتي تنعاني",13,"ن",2,0],["خجل الحبيبُ من العتا","بِ فورَّدَ الخدَّ الخَجَلْ",14,"ل",1,1],["خَجِلاً وَقَد أَعطى فَأَب","دَعَ في العَطاءِ وَأَغرَبا",15,"ب",2,0],["خَجِلَت مِن عَطائِكَ الأَنواءُ","وَتَجَلَّت بِنورِكَ الظَلماءُ",16,"ا",2,1],["خجِلتْ خدودُ الزهرِ عنهُ بروضةٍ","غيداءَ قلّدها نداهُ وشنّفا",17,"ف",2,0],["خجلى تُمتُّ إِلى القبول برقّة","كالماء يَنطفُ في مسيل بطاح",18,"ح",1,0],["خجلاً تمتّ إِلى الولاء بعذرها","كخريدة تختال بين ولائد",19,"د",1,0],["خَجلت في النَّدى طيورٌ تغنَّت","فتغنت بحزنها الغدران",20,"ن",1,0],["خجلتْ أطلعتها الرياضُ سوافراً","فتلثّمتْ كشقائق النعمان",21,"ن",1,0],["خجدُّ السرور به ناعمٌ","وأيدي الملمات ليست بخشن",22,"ن",1,0],["خَجَل الوَرد مِن جَوارِ البَهارِ","فَمَشى بِاِحمِرارِهِ في اِصفِرارِ",23,"ر",1,1],["خجل الحبيب وقد حسرت لثامَه","فجعلتُ من قُبَلي عليه لِثَامَا",24,"م",2,1],["خجلانَةُ الوجنات إِذ عَتِبَتْ","فالوردُ عاتَبها فأَخْجلها",25,"ل",3,0],["خَجِلَ العاذلون فِيك كما يَخْ","جَلُ من بعد عُرْسِه العنِّينُ",26,"ن",1,0],["خجلت في مَشيها","حين ريعت بالأسود",27,"د",1,0],["خجلت بالإحسان حا","تم طيء وفضلت معنا",28,"ن",2,0],["خجلت سبعة أبحر ال","أرضين بالعشر الأنامل",29,"ل",1,0],["خجلي من اساءة","فضحت حسن كل ظن",30,"ن",1,0],["خجازية الألفاظ مصرية اللمى","إلى حسنها تنقاد كل قبيلة",31,"ه",1,0],["خجلاً منه إِذا عصته وَخوفاً","وَحياءً من الذنوب الكبار",32,"ر",1,0],["خجلت وقد وجلت فهاك شقائقاً","مغروسةً في أرض عاجٍ مذهب",33,"ب",1,0],["خجلت له شمس الضحى فتحجبت","في الأفق واستترت بذيل غمام",34,"م",1,0],["خجلان .. بالقصور عن بلوغ مداً","من العلى بل الحسن منه قد بانا",35,"ن",2,0],["خجِلَت والستر يحجبُها","كيف تخفي الخمرةَ القدَحُ",36,"ح",1,1],["خجل الورد من جني وجنتيه","والرياحين قبلت أصداغه",37,"غ",2,0],["خَجِلَتْ منْ خُدودِ منْ","للنّدامى أدارَها",38,"ه",2,0],["خجلتُ من النفس مما عملتُ","أتخجل يا دهر مما عملتا",39,"ت",2,0],["خجلا من شنيع أفعال جنسي","فكأني عوقبت عن أصحابي",40,"ب",2,0],["خجل الصُبح مُذ رَأى مِنهُ فرقاً","مثل بَرق رَأيته مِن كَثيب",41,"ب",1,0],["خَجلت من حُلاهُمُ فأتَتْنا","في رداءٍ مُورَّدٍ ونِقابِ",42,"ب",1,0],["خجِلَ الزّمانُ فعُرْفُهُ يَعْتادُني","ولهُ إليَّ تَلَفُّتُ المُرْتابِ",43,"ب",1,0],["خجلت من فراقها الشرق فاحمرت","حياء اذ ذاك مما تعاني",44,"ي",1,0],["خجلت من نور وجهك","إِذْا رأت أجل منظر",45,"ر",1,0],["خَجِلَت مِن أنَامِلٍ فَأراقَت","عَرَقاً يَا حَياً أرَاهُ حَيَاءُ",46,"ا",2,0],["خَجِلَ الرَّبِيعُ فَجَالَ فِي وَجَنَاتِهِ","مَاءُ الحَيَاءِ وَأنتَ تَحسِبُهُ نَدَى",47,"د",2,0],["خجلاً بات فذا الطلا السقيط","عرق من وجهه قد رشحا",48,"ح",2,0],["خجل القنا من فعله حتى غدا","مثل النساء يرى عليه المحجر",49,"ر",1,0],["خجل الظبى مذرنى طرفك السا","مر شذرا وغار من لفتاتك",50,"ك",1,0],["خجِلتْ وأدْنَت كفّها من خدّها","فحسبتُها مخضوبةً حناءها",51,"ا",3,0],["خجل الصبح من شكاتي فأهدى","سوسن الخد منه لي جلنارا",52,"ر",2,0],["خجِلٌ في ميدانِ مدحك شعري","ولو أن الجميعَ بيتُ القصيد",53,"د",1,0],["خجْلى تُداري حُسنها بأنامل","أو ما درتْ أنّ الحيا حلاّها ؟!",54,"ا",3,0],["خجلا قصايدنا تهزَّعْ لهارَوت","وترقص لسحره في نواعيس عنقا",55,"ق",2,0],["خجلت من النوح المقيم فلم أقل","قريضاً ولم أنحب ولم اتظلّم",56,"م",1,0],["خجلت ورود شقيقها إذ عاينت","أحداق نرجسها إليه تحدق",57,"ق",1,0],["خَجْلى حروفُ قَصِيدتِي فِي وَصفهَا","أنَا شَاعِرٌ خَطَّ الجَمالَ وَأبْهَرَا",58,"ر",2,0],["خجلا رسول الله أخفض هامتي","فلقد ذللت وعزت الكفار",59,"ر",1,0],["خَجَلٌ سَعى بيني وبينَ جَلالِهِ","حَقٌّ النّبيِّ بأنْ يكونَ مُهابا",60,"ب",2,0],["خجلى..وقد أرختْ كحيلَ ودادِها","كغزالةٍ رغبتْ بطيبِ المرتعِ",61,"ع",1,0],["خجلا والله من طلعة شمس","بعثت في الأماني من عدم",62,"م",1,0],["خجل الشباب من المشي","ب بل السنون من العقود",63,"د",1,0],["خجِل القرنفل من شذاك فماسه","غنج البنفسج في فؤاد مدنف",64,"ف",1,0],["خجلاً ، وهل تدري الخدودُ بأنها","حمراءُ قانيةُ الصباحِ الأفخرِ",65,"ر",1,0],["خجلي تمزّقَ باشْتدادِ حوائجي","للهِ يا أللهُ يا أللهُ",66,"ل",2,0],["خَجَلاً ، وَأسْلمتِ المَعانِي حُكْمَها","للْعجْز يَطْرُقُ بَابَهُ مُتأسِّفَا",67,"ف",2,0],["خجلانة ترجو القبول فجد به","يا خير من أسدى وأكرم من سخى",68,"خ",2,0],["خجلى جراحاتي فتكظم غيضها","حتى أقرّت للقروح عجافها",69,"ف",3,0],["خجلَتْ وقد غطّى السَنا الياقوتُ","سألَتْ وفي الشفتينِ غنّى التوتُ",70,"ت",1,1],["خجل مدري وجل مدري عجل مدري سؤال يدور","متى أو ليه أو لا لا بلاش آكسّر احلامي",71,"م",2,0],["خجولة عذبة وطيبة","لا شئ عن ذكر الله يلهيها",72,"ي",3,0],["خجولٌ بعد يا قومي","وقوت الشَّعب مُستقطعْ",73,"ع",1,0],["خَجِلًا تَسيرُ بنَجمتينِ","منَ الرُّؤَى غزَتْا عُيُونكْ",74,"ك",1,0],["خجِلَ المالكُ أنْ يُحرِجَهم","فاستأذنهم في مِشْوار",75,"ر",1,0],["خجلت لتقصيري لديك وفاخرت","بثناك عقد اللؤلؤ المنضود",76,"د",1,0],["خجلي بأني من عريب منزلي","يا بئس من نسب وبئس مآل",77,"ل",1,0],["خجل البنفسج ان يفوح","وخبأَ النسرين ندَّه.",78,"د",2,0],["خجلت – ورب البيت- من حال أوطاني","فلا الحرب أرضتني ولا السلم أرضاني",79,"ن",2,1],["خجل الصّحوُ فللطلّ انهمارْ","آنَ خبّأتِ بعينيكِ البحارْ",80,"ر",1,1],["خجلت مَرّةً يداه ، فمرّت","غيمةٌ وامّحت مع الغيم ريحُ .",81,"ح",1,0]]}