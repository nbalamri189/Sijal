{"poems":[[53,"قال الضمير بما علم","https://www.aldiwan.net/poem29764.html","مجزوء الكامل"],[72,"أشرق الشام فما أي","https://www.aldiwan.net/poem18456.html","مجزوء الرمل"],[51,"خجلت خدود الورد من تفضيله","https://www.aldiwan.net/poem10876.html","الكامل"],[78,"فديت أبا عمرو من فتى","https://www.aldiwan.net/poem14181.html","المتقارب"],[45,"وقضيب كأنه نفحة المسك","https://www.aldiwan.net/poem64559.html","الخفيف"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9518","الخفيف"]],"verses":[["خَجِلٌ يُنَمِّقُ عُذرَهُ","وَالعُذرُ شاهِدُ مَن نَدِم",0,"م",1,0],["خجّ في هذي الرعايا","قبلَ الرحمن حجك",1,"ك",1,0],["خَجِلتْ خُدودُ الوردِ مِن تفضيله","خجلاً تَورُّدُها عليه شاهدُ",2,"د",1,1],["خجِلتُ لِشَكواكَ في طيِّها","فَما كِدتُ أَسمَعُ لِلمُنشِدِ",3,"د",1,0],["خَجَلاً يُكتَسى بِهِ حُمرَةَ العُص","فُرِ مِن خيفَتي وَطاعَةِ أَمري",4,"ي",1,0],["خَجلتْ مَسابِحُها وَتِلكَ مُسوحُها","كادت لِطولِ عَذابها تَنْصاحُ",5,"ح",1,0],["خَجِلَتْ عُيُونُ الحُورِ حِينَ وصَفْتُها","وصْفَ المَشيبِ وقُلْنَ لِي لا تَبْعَدِ",6,"د",1,0],["خجل في نعل طفل محول","أمنع الأشواك أن تجرحه",7,"ه",1,0],["خَجِلَ الوَردُ إِذ رَأى وَجهَ مَن أَه","واهُ وَالجُلَّنارُ أَخجَلُ مِنهُ",8,"ن",2,0]]}