{"poems":[[53,"قال الضمير بما علم","https://www.aldiwan.net/poem29764.html","مجزوء الكامل"],[72,"أشرق الشام فما أي","https://www.aldiwan.net/poem18456.html","مجزوء الرمل"],[51,"خجلت خدود الورد من تفضيله","https://www.aldiwan.net/poem10876.html","الكامل"],[78,"فديت أبا عمرو من فتى","https://www.aldiwan.net/poem14181.html","المتقارب"],[45,"وقضيب كأنه نفحة المسك","https://www.aldiwan.net/poem64559.html","الخفيف"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9518","الخفيف"],[109,"صاد الأسود بمقلة وسناء","https://www.aldiwan.net/poem16412.html","الكامل"],[109,"هاتها والزمان عنك نؤوم","https://www.aldiwan.net/poem16519.html","الخفيف"],[115,"حتى م اجري في ميادين الهوى","https://www.aldiwan.net/poem40877.html","عموديه"],[115,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[160,"هز الغرام معاقد التيجان","https://www.aldiwan.net/poem59100.html","الكامل"],[204,"خجل الحبيب من العتاب","https://www.aldiwan.net/poem53200.html","مجزوء الكامل"],[235,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[235,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[432,"ما زال يخدع قلبه حتى هفا","https://www.aldiwan.net/poem12801.html","الكامل"],[452,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[452,"صيبت خمائلنا بأيمن وافد","https://www.aldiwan.net/poem13709.html","الكامل"],[453,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[464,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[464,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[493,"خجل الورد من جوار البهار","https://www.aldiwan.net/poem67372.html","الخفيف"],[575,"خجل الحبيب وقد حسرت لثامه","https://www.aldiwan.net/poem2869.html","الكامل"],[575,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"]],"verses":[["خَجِلٌ يُنَمِّقُ عُذرَهُ","وَالعُذرُ شاهِدُ مَن نَدِم",0,"م",1,0],["خجّ في هذي الرعايا","قبلَ الرحمن حجك",1,"ك",1,0],["خَجِلتْ خُدودُ الوردِ مِن تفضيله","خجلاً تَورُّدُها عليه شاهدُ",2,"د",1,1],["خجِلتُ لِشَكواكَ في طيِّها","فَما كِدتُ أَسمَعُ لِلمُنشِدِ",3,"د",1,0],["خَجَلاً يُكتَسى بِهِ حُمرَةَ العُص","فُرِ مِن خيفَتي وَطاعَةِ أَمري",4,"ي",1,0],["خَجلتْ مَسابِحُها وَتِلكَ مُسوحُها","كادت لِطولِ عَذابها تَنْصاحُ",5,"ح",1,0],["خَجِلَتْ عُيُونُ الحُورِ حِينَ وصَفْتُها","وصْفَ المَشيبِ وقُلْنَ لِي لا تَبْعَدِ",6,"د",1,0],["خجل في نعل طفل محول","أمنع الأشواك أن تجرحه",7,"ه",1,0],["خَجِلَ الوَردُ إِذ رَأى وَجهَ مَن أَه","واهُ وَالجُلَّنارُ أَخجَلُ مِنهُ",8,"ن",2,0],["خَجلت شُموس الأُفق مِنهُ عِندَما","وافى بِتلك الطَلعة الحَسناءِ",9,"ا",2,0],["خَجلت قُلت لُؤلؤ ما نَراهُ","أَم بُدور قَد كَلَلتها النُجوم",10,"م",1,0],["خجلت لمثقلها السحاب وللنوى","لمعت لها بين الضلوع بروق",11,"ق",1,0],["خجل كئيب خائف من ذنبه","وجل حتى الظهر من أثقاله",12,"ل",2,0],["خجلا يغاورلي فواتر طرفه","وإليه ألسن حالتي تنعاني",13,"ي",1,0],["خجل الحبيبُ من العتا","بِ فورَّدَ الخدَّ الخَجَلْ",14,"ل",1,1],["خَجِلاً وَقَد أَعطى فَأَب","دَعَ في العَطاءِ وَأَغرَبا",15,"ب",2,0],["خَجِلَت مِن عَطائِكَ الأَنواءُ","وَتَجَلَّت بِنورِكَ الظَلماءُ",16,"ا",2,1],["خجِلتْ خدودُ الزهرِ عنهُ بروضةٍ","غيداءَ قلّدها نداهُ وشنّفا",17,"ف",2,0],["خجلى تُمتُّ إِلى القبول برقّة","كالماء يَنطفُ في مسيل بطاح",18,"ح",1,0],["خجلاً تمتّ إِلى الولاء بعذرها","كخريدة تختال بين ولائد",19,"د",1,0],["خَجلت في النَّدى طيورٌ تغنَّت","فتغنت بحزنها الغدران",20,"ن",1,0],["خجلتْ أطلعتها الرياضُ سوافراً","فتلثّمتْ كشقائق النعمان",21,"ن",1,0],["خجدُّ السرور به ناعمٌ","وأيدي الملمات ليست بخشن",22,"ن",1,0],["خَجَل الوَرد مِن جَوارِ البَهارِ","فَمَشى بِاِحمِرارِهِ في اِصفِرارِ",23,"ر",1,1],["خجل الحبيب وقد حسرت لثامَه","فجعلتُ من قُبَلي عليه لِثَامَا",24,"م",2,1],["خجلانَةُ الوجنات إِذ عَتِبَتْ","فالوردُ عاتَبها فأَخْجلها",25,"ل",3,0]]}