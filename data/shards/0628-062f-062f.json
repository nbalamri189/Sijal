{"poems":[[55,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[51,"قل لأهل القبور كيف وجدتم","https://www.aldiwan.net/poem64119.html","الخفيف"],[76,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39546","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[113,"ومقلدات بالقلو","https://www.aldiwan.net/poem16611.html","مجزوء الكامل"],[147,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[398,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[443,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[470,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77531","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120020","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119864","الكامل"],[1058,"","https://poetry.dctabudhabi.ae/diwan/poem/198786","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55884","الرمل"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117113","الرمل"],[1515,"","https://poetry.dctabudhabi.ae/diwan/poem/101082","المتدارك"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108752","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108537","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69330","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77200","الخفيف"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137448",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205853","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118809","السريع"],[3327,"","https://poetry.dctabudhabi.ae/diwan/poem/144507","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105503","الخفيف"],[4549,"","https://poetry.dctabudhabi.ae/diwan/poem/203592","الرمل"],[4764,"عسى الله يصلحه","https://www.poetsgate.com/ViewPoem.aspx?id=33963",""],[4888,"دمعة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=207760",""],[4929,"جنون الغضب","https://www.poetsgate.com/ViewPoem.aspx?id=199506",""],[182,"","https://www.poetsgate.com/ViewPoem.aspx?id=72802",""],[5000,"كلُّ عام","https://www.poetsgate.com/ViewPoem.aspx?id=5540",""],[5136,"هنيت بالإقبال والنصر","https://www.poetsgate.com/ViewPoem.aspx?id=121574",""],[5459,"دوح النهى","https://www.poetsgate.com/ViewPoem.aspx?id=198288",""],[470,"الموجَعَة","https://www.poetsgate.com/ViewPoem.aspx?id=178092",""],[5606,"جددي ياعين دمعك","https://www.poetsgate.com/ViewPoem.aspx?id=195419",""],[5618,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=208911",""],[5625,"لامية القدس","https://www.poetsgate.com/ViewPoem.aspx?id=183065",""],[5652,"ياديننا عُذرآ","https://www.poetsgate.com/ViewPoem.aspx?id=174959",""],[5957,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=180143",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6056,"شمس حبي","https://www.poetsgate.com/ViewPoem.aspx?id=130140",""],[539,"بدد الفجر مطبقات الظلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83040&r=&rc=39",""]],"verses":[["بَدَّدوا ما جَمَعَ البَأسُ لَهُم","بِأَنابيبِ العَوالي في الكَرَم",0,"م",1,0],["بَدَّدَ المَوتُ شَملَهُم فَتَنادَوا","بِنَزالٍ إِلى بُيوتٍ خَرابِ",1,"ب",1,0],["بَدَداً بِمَسرى كُلِّ ريحٍ عاصِفٍ","وَمَصابِ كُلِّ غَمامَةٍ هَطلاءِ",2,"ا",2,0],["بدَّدَ الضُرَّ والأذى بكتابٍ","نَظَمَ البِرَّ والمُروءةَ نظما",3,"م",2,0],["بدَّدتِ يا قيثارتي أنغامي","ونسيتِ لحنَ صبابتي وغرامي",4,"م",2,1],["بدّدَت دُهْمُ الليالي شملَها","والليالي كلُّها من أبَوَيْنْ",5,"ن",1,0],["بَدَّدنَ شَمل عُقولِنا","حَول السَتائر وَالكلل",6,"ل",1,0],["بَدَّدتَ وَفرَكَ في فَرضٍ وَنافِلَةٍ","وَسُنَّةٍ فَجَمَعتَ السُؤدُدَ البَدَدا",7,"د",2,0],["بَدّدي يا زَوابِع النارَ أَعدا","ءَ إِلهي وَيا جَهَنَّمُ ثوري",8,"ر",2,0],["بَدَّدتَ شَملَ الكافرونَ بَصارِمٍ","في حَدِّهِ الاِشقاءُ وَالاِسعادُ",9,"د",1,0],["بدّدت جمع الكفر وهو مؤثّل","منهم بعزم في الأمور رشيد",10,"د",1,0],["بدِّدت في المحيطِ لغو أوضاعت","وأباهَا زمانها والمكان",11,"ن",1,0],["بَدد ٌ، كلُّ عُمْرِه ِبَدَد ُ","كلُّ ما يَدَّعي ، وما يَعِد ُ",12,"د",1,1],["بَدَد ٌ كلُّها ، وأوجَعُها","أنَّه ُ الآنَ عُمْرُه ُبَدَ د ُ",12,"د",1,0],["بَدَد ٌ، كلُّ عُمرِه ِ بَدَد ُ","لا وِقاءٌ لَه ُ، ولا سَنَد ُ",12,"د",1,0],["بَدَد ً ، كلُّ عُمْر ِه ِبَدَد ُ","ما أضَعْنا بِه ِ، وما نَجِد ُ",12,"د",1,0],["بَدد شَمل كُل مَن تَفَرَّجا","وَلِلحصى بِذيله قَد دَحرَجا",13,"ج",2,0],["بددت شل الجور وهو مجمع","وجمعت شمل العدل وهو مبددُ",14,"د",1,0],["بدَّدت شمل لهاك ما بين الورى","يا جامعا شمل العلى المتبددِ",15,"د",1,0],["بدد النعيَ دافئاتُ التلاقي","ما لحزن بعد المصاب خفاء",16,"ا",2,0],["بدد اللهم عنها كربا","هد حصن العز منها وهدم",17,"م",1,0],["بدد المال على جمع الأثام","فأضاع الدين والدنيا معا",18,"ع",2,0],["بدد الفرسان بخان مرا","د بما قد شاد من الهمم",19,"م",1,0],["بددي لاعج الحزن","واغنمي الأجر والثنا",20,"ن",2,0],["بدد بجودك ضرّي واغتنم مِدَحي","لا يوجد الشكر حتى يوجد السبب",21,"ب",1,0],["بَدَّدتَ مالَكَ غَيرَ مُحتَفِلٍ بِهِ","وَجَمَعتَ شَملاً لِلعَلاءِ مُبَدَّدا",22,"د",2,0],["بَدَّدوا ما لَنا عَطاءً وَبَذلا","وَالحِمى صارِخٌ لِفَلسٍ فَقيرُ",23,"ر",1,0],["بددت شمل العلى بالموت فانبعثت","في كل قلب صبابات وأشجان",24,"ن",1,0],["بدّدت شملنا المنون ولكن","نك في خاطري وفي إنساني",25,"ن",2,0],["بددتم شملي فيا هل ترى","بعد الجفا يصفو لي المشربُ",26,"ب",1,0],["بدّدتهمْ يدُ الخطوبِ فأصبح","تُ يباباً من بعدهمْ أسيانا",27,"ن",2,0],["بدّدها حادِث الفِراق وَقَد","كانَ جَميعاً لَنا مبدّدها",28,"د",3,0],["بددتها ففاض في السهل والأس","طول نوراً أشعةٍ شمسيه",29,"ه",1,0],["بددت لحمها الظبا في سبيل","اللَه كي تجمع العلى والثناءا",30,"ا",3,0],["بددت منها الليالي شملهم","فكأن لما يكونوا قبل ثم",31,"م",1,1],["بددت امه / خبر كيف اشرحه","وانسفت هالكون في اوج الغروب",32,"ب",1,0],["بَدِّدْ بموتِكَ أُفْقًا قد غَدا خلِقا","وسِرْ إلى اللهِ وارشُفْ عندَهُ الألَقا",33,"ق",2,1],["بدد برعدِكَ في سمعِ الورى صَمَماً","واصدع ببارقِه جوفَ الدجى حُجُبَا",34,"ب",2,0],["بدَّدتْنا خَيباتُنا فانْسَفَرْنا","كَسَرابٍ لا نرْتَجى مِنهُ شَيّا",35,"ي",2,0],["بدّدَ الشَّملَ جميعا","فاستحالَ الحُلمُ نِقضا",36,"ض",2,0],["بددتهم تبديد ليث الشرى","أقرانه فيمهمه قمر",37,"ر",1,0],["بددتهم ايد سبا فغدوا","كالحمر الملقاة للجرر",37,"ر",1,0],["بَدِّدِ الوَهْمَ ومَزِّقْ ثوبَهُ","وَ ارْفَعِ الْفَأسَ وحَطِّمْ نُصُبَكْ !",38,"ك",1,0],["بددٌ كلُّ عُمرنا بَدَدُ","ما أضَعنا بهِ، وما نجدُ",39,"د",1,0],["بددي كل الأماني بددي","وادري إن اللي تودينه نساك",40,"ك",1,0],["بدّدتِ بالحسن أحزانامكامنُها ..","في القلب تعلو ،،وقدْ أنهيت إزعاجا",41,"ج",2,0],["بدد غيوم الصمت عن أسيافنا","ما السيف إن لم يعل فيه صليل ؟!",42,"ل",1,0],["بدد جهل ماكان يقرى بالانساب","وحدد نفيره فوق غرن سرابه",43,"ب",2,0],["بدد جراحك والتحفْ أملا هنا","ستعود شمس الصبح يا أصحابي",44,"ب",2,0],["بدّد النور صفحة هاجسي المظلمه","وهمت في عالم ٍ ثاني وشفت العجب",45,"ب",1,0],["بدّدي ، غيم ٍ يغلّف مابقي","من ضياء شمع المحبة ياضنيني",46,"ن",2,0],["بدد الفجر مطبقات الظلام","وصحا العرب بعد طول المنام",47,"م",1,1]]}