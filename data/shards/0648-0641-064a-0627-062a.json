{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[275,"هذا قران سعيد أكسب الدارا","https://www.aldiwan.net/poem35264.html","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"]],"verses":[["وَفِي اتِّحَادِ النِّسَاءِ العَالمِي أَمَا","خَلا لَكِ الصَّدْرُ عَنْ حُبٍّ وَعَنْ رَغَبِ",0,"ب",1,0],["وفي اتحادِهما حبّاً ومصلحةً","رمزٌ لأُمنيِّةٍ تهتاجُ أحرارا",1,"ر",2,0],["وَفِى اتِّحَادِ الرُّتبَةِ الزَم فَصلاَ","وَقَد يُبِيحُ الغَيبُ فِيهِ وَصلاَ",2,"ل",2,0],["وَفى اتِّبَاعِ السَّلَفِ الهُدَاةِ","وَسِيلَةٌ للأمنِ وَالنّجَاةِ",3,"ه",1,0]]}