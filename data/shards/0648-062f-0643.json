{"poems":[[88,"نكب الشارع الكبير ببغداد","https://www.aldiwan.net/poem44426.html","الخفيف"],[88,"يقولون في الإسلام ظلما بأنه","https://www.aldiwan.net/poem45024.html","الطويل"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[129,"هجرت بعدك العيون الرقادا","https://www.aldiwan.net/poem50641.html","الطويل"],[222,"في اليوم ألف مصيبه","https://www.aldiwan.net/poem55256.html","المجتث"],[251,"قطعت شبيبتي وأضعت عمري","https://www.aldiwan.net/poem14971.html","الوافر"],[260,"دعوت وجودي حيث ما ثم داعيا","https://www.aldiwan.net/poem35965.html","الطويل"],[299,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[357,"مضت غرة والحمد للّه في أخرى","https://www.aldiwan.net/poem24533.html","الطويل"],[411,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[465,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"]],"verses":[["ودكاكين كالأفاحيص تمتدّ","يميناً بطوله ويسارا",0,"ر",2,0],["ودّك حصون الجاهلية بالهدى","وقَوّض أطناب الضلال المخيّم",1,"م",1,0],["وَدَكَّتَينِ كَمِثلِ الشِعرَيَينِ غَدَت","إِحداهُما بِإِزا الأُخرى تُساميها",2,"ي",3,0],["ودَّ كلٌّ يَفديك بالمال والأو","لاد طُرّاً لو أن شخصاً يُفَادَا",3,"د",2,0],["ودكة الأرض صارت","بمن عليها قريبه",4,"ب",2,0],["ودُكَّاني جَهَنَّمُ إذ زُبُونيَّ","زَبَانِيَةٌ بهم تعذيبُ سرِّى",5,"ر",2,0],["وَدَكدِك جِبالَ الخَطبِ عِندَ تَنَزُّلِ ال","تجَلّي الجَمالي حَيثُما الفَضلُ دانِيا",6,"ي",2,0],["وَدَّ كلٌّ منهما لو ظلَّ في","نومِه هذا إِلى يوم النشور",7,"ر",1,0],["ودُك جبالُ الصبر من بين أحمد","وفك يصديق الخلائق عن أسرى",8,"ر",2,0],["وَدَّ كُلُّ اِمرِىءٍ مِنَ الناسِ لَوكا","نَ أَبوهُ لَدى الفَخارٍ أَباكا",9,"ك",2,0],["ودُّكَ صافٍ والعهد باقٍ","وإيثارك بادٍ والجاهُ مبذول",10,"ل",1,0]]}