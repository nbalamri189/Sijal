https://www.poetsgate.com/ViewPoem.aspx?id=30461",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5386,"بين ضلوعنا","https://www.poetsgate.com/ViewPoem.aspx?id=35004",""],[5463,"قلبك أسود","https://www.poetsgate.com/ViewPoem.aspx?id=33699",""],[5529,"لبرئك كان هذا الكون صاب","https://www.poetsgate.com/ViewPoem.aspx?id=172833",""],[5739,"اغراب لكن .....!","https://www.poetsgate.com/ViewPoem.aspx?id=145119",""],[5756,"الجمهرة","https://www.poetsgate.com/ViewPoem.aspx?id=5430",""],[5848,"الحاضرين يعلمون الغايبين","https://www.poetsgate.com/ViewPoem.aspx?id=48989",""],[5848,"بعير !!","https://www.poetsgate.com/ViewPoem.aspx?id=48812",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[6038,"بيعة الخسراني","https://www.poetsgate.com/ViewPoem.aspx?id=26802",""],[6115,"في ذمتي ماكان يزعل عليه","https://www.poetsgate.com/ViewPoem.aspx?id=181763",""],[6115,"ودك تبيع الهلايم وسط سوق الحراج","https://www.poetsgate.com/ViewPoem.aspx?id=196480",""]],"verses":[["ودكاكين كالأفاحيص تمتدّ","يميناً بطوله ويسارا",0,"ر",2,0],["ودّك حصون الجاهلية بالهدى","وقَوّض أطناب الضلال المخيّم",1,"م",1,0],["وَدَكَّتَينِ كَمِثلِ الشِعرَيَينِ غَدَت","إِحداهُما بِإِزا الأُخرى تُساميها",2,"ي",3,0],["ودَّ كلٌّ يَفديك بالمال والأو","لاد طُرّاً لو أن شخصاً يُفَادَا",3,"د",2,0],["ودكة الأرض صارت","بمن عليها قريبه",4,"ب",2,0],["ودُكَّاني جَهَنَّمُ إذ زُبُونيَّ","زَبَانِيَةٌ بهم تعذيبُ سرِّى",5,"ر",2,0],["وَدَكدِك جِبالَ الخَطبِ عِندَ تَنَزُّلِ ال","تجَلّي الجَمالي حَيثُما الفَضلُ دانِيا",6,"ي",2,0],["وَدَّ كلٌّ منهما لو ظلَّ في","نومِه هذا إِلى يوم النشور",7,"ر",1,0],["ودُك جبالُ الصبر من بين أحمد","وفك يصديق الخلائق عن أسرى",8,"ر",2,0],["وَدَّ كُلُّ اِمرِىءٍ مِنَ الناسِ لَوكا","نَ أَبوهُ لَدى الفَخارٍ أَباكا",9,"ك",2,0],["ودُّكَ صافٍ والعهد باقٍ","وإيثارك بادٍ والجاهُ مبذول",10,"ل",1,0],["ودّك الجبال مصاب دهاك","وأجهش مكة أم القرى",11,"ر",2,0],["ودكّاكٍ السفوفات","لريح الجوف والخصر",12,"ر",1,0],["ودكَّ قلاعها واضطرَّ من في","معاقلها الى التسليمِ جبرا",13,"ر",2,0],["ودكان حداد ودقّ قصارة","ومدبغة تؤذي بريح منكد",14,"د",1,0],["وَدُكرك في فَم الإِشراف يَحلو","كَما يَحلو لِشاربه القراح",15,"ح",1,0],["ودكرنا كيف كنا","كم سكرنا وطربنا",16,"ن",2,0],["ودك يكفينيك في حاجتى","ورؤيتى كافية عن سؤال",17,"ل",1,1],["ودُكّت به أركان عز ومنعة","وغارت نجوم المجد وهي طوالع",18,"ع",1,0],["ودُكّت حصون الخير ثلت عروشها","وغابت شموس الفضل وهي سواطع",18,"ع",1,0],["ودكدك بسيف الحال طود النوى وقل","أزائرنا بشراك قدامك البشر",19,"ر",1,0],["ودك طود خطوب لم تزل أبدا","حال الأنام بها كالمنزل الخرب",20,"ب",1,0],["ودَكَّ ثِيبَةٍ وفَرعِي إِيبِنُس","جَنَدَل مِينيساً وإِيفِستَرُفُس",21,"س",1,0],["ودك تشوف الخفايا ويش تخفي لك","تقول أحبك وأنا أحبك ولا أبالي",22,"ل",2,0],["ودك تحطه فى العيون للعيون","وتبسط على رمض السرا يمناكله",23,"ل",2,0],["ودك تنامين؟! نامي يا بعد عيني","باين عليك التعب من أمس سهرانه",24,"ن",2,1],["ودكدك في العلى طودا تعالى","على هام النهى شرقا ومجدا",25,"د",2,0],["ودك ادور غير لقياك","ودك ادور غير ودك",26,"ك",1,0],["ودَكّوا يومَ ضَربَتِهمْ غُرورًا","فَرَنّتْ سائرُ الدُنيا رنينا",27,"ن",2,0],["ودّك تكسّر كل شي؟ .... إكسر ترى كله فداك","هاك العطور وآنيات الحبّ .......... هاك عزومنا",28,"ن",2,0],["ودّك بواحد أناني لو يزعلّك ِ تجيه","ولو بيآمر بالخطايا قلتي أمرك لي مطاع",29,"ع",1,0],["ودكت ذروة لعلاك طالت","على الشم القوارع والهضاب",30,"ب",1,0],["ودّك وحرفك عندنا ماهم اجناب.","تهامسوا بالجوف خاطوا جراحه.",31,"ح",2,0],["ودك اليامن جاتك الغلطه من الناس القراب","الصاحب اللي ماكسبت محبته ماتخسره",32,"ر",2,0],["ودك تموتني قهر؟ قلها وانا افهم مبتغاك","ياقشر حظك كان طبعك بيع من جاك وشرى",33,"ر",2,0],["ودك تعيش الحياة بدون موت الضمير !!","يا صعبها وانت عاجز تتخذ لك قرار",34,"ر",1,0],["ودك اترجع عربنا للحياة الجاهلية","للمشاكل والقلاقل والحروب الطاحناتي",35,"ت",2,0],["ودك بواحد غرامه محطات الاغاني","يدور بالريموت عن فيديو كليبي",36,"ب",2,0],["ودّك على ظهره تصوطه بمشعاب","من كفّ رجالٍ عزومه قويه",37,"ي",2,0],["ودّك تبيع الهلايم وسط سوق الحراج","بابخس ثمن والخساره يوم ثمنتها",38,"ت",3,0]]}