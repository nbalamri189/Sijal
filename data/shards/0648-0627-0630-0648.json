{"poems":[[55,"عاد الهوى بظباء مك","https://www.aldiwan.net/poem29630.html","مجزوء الكامل"],[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[55,"لولا يذم الركب عندك موقفي","https://www.aldiwan.net/poem29948.html","الكامل"],[88,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[31,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[48,"إذا ما جاءني رجل حذام","https://www.aldiwan.net/poem23408.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39655","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[102,"لعيني أم بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=50431",""],[98,"الوردة الصفراء","https://www.poetsgate.com/ViewPoem.aspx?id=15718",""],[347,"طيف الحبيب ولهفة المحزون","https://www.aldiwan.net/poem55353.html","الكامل"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[366,"ينهى محبك انه مشتاق","https://www.aldiwan.net/poem68082.html","الكامل"],[505,"آيات تلك الحضرة القدسيه","https://www.aldiwan.net/poem37708.html","الكامل"],[549,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[556,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[666,"","https://poetry.dctabudhabi.ae/diwan/poem/147419","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105006","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18023","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83214","المتدارك"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130045","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62769","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86261","الوافر"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127836","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108035","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92106","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205673","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70141","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77032","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76721","الكامل"],[4959,"لَقَدْ جَاوَزَ الظَّالِمُونَ الْمَدَى 2","https://www.poetsgate.com/ViewPoem.aspx?id=215044",""],[5005,"خلف المساء","https://www.poetsgate.com/ViewPoem.aspx?id=198696",""],[5039,"نوايا العطر","https://www.poetsgate.com/ViewPoem.aspx?id=48140",""],[5153,"تشطير أبيات (أخفي الهوى )لابن الفارض","https://www.poetsgate.com/ViewPoem.aspx?id=202452",""],[5277,"جئني","https://www.poetsgate.com/ViewPoem.aspx?id=184914",""],[5277,"وجهُ المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=206220",""],[5302,"أودت بقلبي المتاعب","https://www.poetsgate.com/ViewPoem.aspx?id=204914",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[5431,"أحتاج عمرا كي أرى دمعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=191667",""],[5431,"ويشق قلبي بدرها المتكور","https://www.poetsgate.com/ViewPoem.aspx?id=196923",""],[5431,"ومواقف القلب الوفي تُخلدُ","https://www.poetsgate.com/ViewPoem.aspx?id=197629",""],[5480,"احساسي","https://www.poetsgate.com/ViewPoem.aspx?id=10894",""],[5612,"الرَضِيّْ","https://www.poetsgate.com/ViewPoem.aspx?id=179433",""],[5638,"حنين إلى القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200124",""],[5644,"حديث آسر","https://www.poetsgate.com/ViewPoem.aspx?id=198639",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5756,"ادلعها واولعها","https://www.poetsgate.com/ViewPoem.aspx?id=5414",""],[5851,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=175978",""],[5939,"دستور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=186983",""],[6103,"تشتاقُكُم عيني","https://www.poetsgate.com/ViewPoem.aspx?id=203242",""],[6171,"عَزْفٌ عَلَى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6312,"للمائسِ المدْهوش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82953&r=&rc=3",""]],"verses":[["وَأَذودُ قَلباً ظامِئاً","لَو قيلَ وِردُكَ ما عَداها",0,"ا",3,0],["وَأَذودُ عَن سَمعي المَلامَ كَأَنَّهُ","عُصوٌ أَخافُ عَلَيهِ حَدَّ سِنانِ",1,"ن",1,0],["وَأَذودُ دَمعي أَن يَبُلَّ مَحاجِري","فَاليَومَ أَعلَمُهُ بِما لَم يَعلَمِ",2,"م",1,0],["وَأَذودُ عَن عَيني الدُموعَ وَلَو خَلَت","لَجَرَت عَلَيكَ بِوابِلٍ غَيداقِ",3,"ق",1,0],["وَآذَوكَ في ذاتِ الإِلَهِ وَأَنكَروا","مَكانَكَ حَتّى سَوَّدوا الصَفَحاتِ",4,"ت",1,0],["وَإِذ وَرَدتَ جَريرُ فَاِحبِس صاغِراً","إِنَّ البُكورَ لِحاجِبٍ وَعِقالِ",5,"ل",1,0],["وَإِذ وَشى بِيَ أَقوامٌ فَأَدرَكَني","رَهطُ الَّذي رَفَعَ الرَحمَنُ فَاِرتَفَعوا",6,"ع",3,0],["وَأَذوَت غاضِراً وَرَمَت حِبالاً","سَليلَ أَخي طُلَيحَةَ بِاِنجِذامِ",7,"م",1,0],["وأذود عَنْ عينيكِ ذكرى ليلةٍ","شابتْ ونجمٍ شاحبِ الأضواءِ",8,"ا",2,0],["وأَذُودُ عنْهُ الطيْر إِن حامتْ على","زَهْرٍ يُضِيءُ الأفقَ في عَذَباته",9,"ت",2,0],["وأذوي وهي تحملني","فتنمو في جراحاتي",10,"ت",2,0],["وأذود لون خدّيك اقطفي ما شئته","من زهرة أو كوكب وضّاء",11,"ا",2,0],["واذوب في نفسي ويصهرني الاسى","واغيب عن وعيي غياب جنون",12,"ن",1,0],["وَإذ وَادِي صَبَابَتِهِ مَرِيعٌ","عَلَيهِ لِلتّقَى حِصنٌ مَنِيعُ",13,"ع",1,0],["وَأَذوبُ خَوف الصَدّ لَولا اِنَّهُ","بَيني وَبَينِكَ في الهَوى ميثاق",14,"ق",1,0],["وأذوب إن غنى لي الحادي بكم","متطيلساً برداء صدق لنيه",15,"ي",2,0],["وأذوبُ في القبس المطرَّز جمره","بهواك حيث يقدَّس الذوبان",16,"ن",1,0],["وأذودُ عن قلبي الهمومَ كأنّني","أَحمي أسودَ شرىً عنِ الأخياسِ",17,"س",1,0],["وأذوب فيك مروءة","مطرا أجيئك او سحابا",18,"ب",2,0],["وأذويت أعواد المنابر بعدما","بعلمك منها اليابس اخضَّر مورقا",19,"ق",2,0],["وَآذَوا رَسولَ اللَهِ فيها فَجُلِّلوا","مَخازِيَ تَبقى عُمِّموها وَفُضِّحوا",20,"ح",3,0],["وَأَذُودَ عَنِ الأَوطانِ يَداً","أَذكَت فينا نارَ الفِتَنِ",21,"ن",1,0],["وأذود عنك بِمُهجتي شرّ الفِتن","واللّه أسألُ أن يفيضَ لنا المِنن",22,"ن",1,0],["وأذودُ وفدَ الدّمعِ يَركَبُ شأنَهُ","ووفودُ بابي يأمنونَ حِجابي",23,"ب",2,0],["وَاِذ وُرق المُنى غَنت سُروراً","تَهنيه بِاِحرازِ المَعالي",24,"ل",2,0],["وإذ وافى لدى التاريخ حدٌّ","رقمنا إسمهُ السامي غريبا",25,"ب",2,0],["وأذوق طيب العيش فيك وطيبه","حيث العلى ومكارم الأخلاق",26,"ق",1,0],["وإذ وافقت أيامي","تبعتُ اللهو واللعبا",27,"ب",2,0],["وأذوق من ثمراتها ما أشتهي","لا تحتمي مني ولا أنا أحتمي",28,"م",2,0],["وَاذوقُ مِن صَرفِ الزَمان مَشَقةً","واشمُ ريح الانس كَالمفئودِ",29,"د",1,0],["وَاِذود داعِيَة العَنا بِلِقاءِ مَن","شَمِلَت فَواضِلُهُ القَصِي وَمَن دَنا",30,"ن",2,0],["واذ وصلت الى الأمير مبشر","فاجعل بساطك في ذراه السندسا",31,"س",2,0],["وَآذَواْ عِبَادَكَ يَا رَبَّنَا","وَفي الْأَرْضِ كَمْ أَغْلَقُواْ مَسْجِدَا",32,"د",2,0],["وأذوب في وجه السماء إذا اختبأ","خلف المساء وقد تهادى وابتدأ",33,"ا",1,1],["وأذوب في دمعة عيون الخلاوي","والحب له في جبهة عروقي حروق",34,"ق",1,0],["وأذوبُ فيه صبابةً فيميتني","(وأميته وصبابتي تحييهِ)",35,"ي",2,0],["وأذوبُ في أهداب عينكَ دمعةً","وأغيبُ في بحرٍ هنالك أحمرا",36,"ر",2,0],["وأذوبُ فيكَ تولُّهاً","والذكرياتُ لها احْتدامْ",37,"م",1,0],["وأذوي بهم يملأ النفس ماله ان","تهاء وهم النفس للعقل ضارب",38,"ب",1,0],["وأذوت في لهيب الشوق عمراً","تلظت في لجاجته الأتونُ",39,"ن",1,0],["وأذوب في حبي الكبير كأنني","أشعلتُ وسط غرامه من مهجتي شمعه",40,"ع",2,0],["وأذوب من صوتٍ يراود ذكره","حتى كأني من صداه أسكرُ",41,"ر",1,0],["وأذوب من عبق القصيد كأنه","حبقٌ يرافقه الشعور الأغيدُ",42,"د",1,0],["وأذوق الشهد والزمزم ونرجس طيفك بروفك","وأحطك في مدار العين وأشوفك لحظة أبراقي",43,"ق",2,0],["وأذودُ عن نفْسي .. أصُدُّ مَواجِعاً","وأزيحُ عن قلْبي الهمومَ وأرْفَعُ",44,"ع",1,0],["وَأَذُودُ عَنْهُ رِجْسَ صِهْيَوْنٍ طَغَى","قَدْ فَاضَ مِنْهُ الْحِقْدُ وَالإِجْرَامُ",45,"م",1,0],["وأذوبُ بينَ كَلامِهِ وخِلالِهِ","كالنحل يرشُفُ من ندى الزهراتِ",46,"ت",1,0],["وأذويت ما انا غرست من الهنا","وكان بروض اليمن أطيب مغرس",47,"س",1,0],["وأذوّقهم ندم ماصار فيها","وأشرّبهم من اللي شرّبوها",48,"و",3,0],["وأذوب فيك كما عطور فرنسا","تمضي لتترك في الأماكن أنسا",49,"س",2,1],["وأُذَوِّبَنَّ شُعورَها","بالشِّعرِ مثلَ السُّكَّرَةْ",50,"ر",2,0],["وأذوبُ شوقًا كلَّ يومٍ دونكمْ","والشوقُ فى صدري رصاصٌ ذائبُ",51,"ب",1,0],["وَأَذُوبُ فِي دَرَجِ الضَيَاعِ مُسَافِراً","فِي غُرْبَتِي! أَحُدُو لِغَيْرِ مُرَادِي",52,"د",2,0],["وأذوق طعم مرارة","بمشاعري متمكنا",53,"ن",2,0],["وأذوي ورَحْبُ النَّفْسِ يذوي وداخلي","مَلالٌ، وإجهاشٌ يَشي، واحتِراقُ",54,"ق",1,0]]}