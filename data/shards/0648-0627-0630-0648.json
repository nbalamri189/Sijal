{"poems":[[53,"عاد الهوى بظباء مك","https://www.aldiwan.net/poem29630.html","مجزوء الكامل"],[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"لولا يذم الركب عندك موقفي","https://www.aldiwan.net/poem29948.html","الكامل"],[86,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[29,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[46,"إذا ما جاءني رجل حذام","https://www.aldiwan.net/poem23408.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39655","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[96,"الوردة الصفراء","https://www.poetsgate.com/ViewPoem.aspx?id=15718",""],[340,"طيف الحبيب ولهفة المحزون","https://www.aldiwan.net/poem55353.html","الكامل"],[355,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[359,"ينهى محبك انه مشتاق","https://www.aldiwan.net/poem68082.html","الكامل"],[498,"آيات تلك الحضرة القدسيه","https://www.aldiwan.net/poem37708.html","الكامل"],[542,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[549,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"]],"verses":[["وَأَذودُ قَلباً ظامِئاً","لَو قيلَ وِردُكَ ما عَداها",0,"ا",3,0],["وَأَذودُ عَن سَمعي المَلامَ كَأَنَّهُ","عُصوٌ أَخافُ عَلَيهِ حَدَّ سِنانِ",1,"ن",1,0],["وَأَذودُ دَمعي أَن يَبُلَّ مَحاجِري","فَاليَومَ أَعلَمُهُ بِما لَم يَعلَمِ",2,"م",1,0],["وَأَذودُ عَن عَيني الدُموعَ وَلَو خَلَت","لَجَرَت عَلَيكَ بِوابِلٍ غَيداقِ",3,"ق",1,0],["وَآذَوكَ في ذاتِ الإِلَهِ وَأَنكَروا","مَكانَكَ حَتّى سَوَّدوا الصَفَحاتِ",4,"ت",1,0],["وَإِذ وَرَدتَ جَريرُ فَاِحبِس صاغِراً","إِنَّ البُكورَ لِحاجِبٍ وَعِقالِ",5,"ل",1,0],["وَإِذ وَشى بِيَ أَقوامٌ فَأَدرَكَني","رَهطُ الَّذي رَفَعَ الرَحمَنُ فَاِرتَفَعوا",6,"ع",3,0],["وَأَذوَت غاضِراً وَرَمَت حِبالاً","سَليلَ أَخي طُلَيحَةَ بِاِنجِذامِ",7,"م",1,0],["وأذود عَنْ عينيكِ ذكرى ليلةٍ","شابتْ ونجمٍ شاحبِ الأضواءِ",8,"ا",2,0],["وأَذُودُ عنْهُ الطيْر إِن حامتْ على","زَهْرٍ يُضِيءُ الأفقَ في عَذَباته",9,"ت",2,0],["وأذود لون خدّيك اقطفي ما شئته","من زهرة أو كوكب وضّاء",10,"ا",2,0],["واذوب في نفسي ويصهرني الاسى","واغيب عن وعيي غياب جنون",11,"ن",1,0],["وَإذ وَادِي صَبَابَتِهِ مَرِيعٌ","عَلَيهِ لِلتّقَى حِصنٌ مَنِيعُ",12,"ع",1,0],["وَأَذوبُ خَوف الصَدّ لَولا اِنَّهُ","بَيني وَبَينِكَ في الهَوى ميثاق",13,"ق",1,0],["وأذوب إن غنى لي الحادي بكم","متطيلساً برداء صدق لنيه",14,"ي",2,0],["وأذوبُ في القبس المطرَّز جمره","بهواك حيث يقدَّس الذوبان",15,"ن",1,0],["وأذودُ عن قلبي الهمومَ كأنّني","أَحمي أسودَ شرىً عنِ الأخياسِ",16,"س",1,0]]}