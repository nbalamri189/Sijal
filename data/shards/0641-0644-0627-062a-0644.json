spx?id=182789",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""],[5126,"تأمل! فلا سرّ لديك ولا جهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87800&r=&rc=15",""]],"verses":[["فلا تلَقّيْتُ خِلّي حينَ تُزْعِجُهُ","فَظاظَةُ الدّهْرِ بالمَعْروفِ منْ لَطَفي",0,"ف",2,0],["فلا تُلْزِميني ذَنْبَ دَهْرٍ يَسومُني","على غِلَظِ الأيّامِ رِقّة حالِ",1,"ل",1,0],["فلا تَلعَبْ بعِطْفِكِ مُسْتَنيماً","إِلى خُدَعٍ تَطورُ بِها الأماني",2,"ن",2,0],["فلا تلم كبرياها فهي غانية","حسنا، وطبع الحسان الكبر والخفر",3,"ر",1,0],["فَلا تَلمَسِ الأَفعى يَداكَ تُريدُها","وَدَعها إِذا ما غَيَّبَتها سَفاتُها",4,"ت",3,0],["فلا تَلحَياني إِن جَزَعتُ فَما أَرى","عَلى زَفَراتِ الحُبِّ مِن أَحَدٍ جَلدِ",5,"د",1,0],["فلا تلتَمِظ في مدحها متمطِّقاً","فإن أظهرت حلواً فقد أبطنت مرا",6,"ر",2,0],["فَلا تُلزَمَنّي خِطَّةً لا أُطيقُها","فَمَجدُكَ غَلّابٌ وَفَضلُكَ باهِرُ",7,"ر",1,0],["فلا تلمْ لحظاً جرحنا بهِ","خدّك يا جارح أكباد",8,"د",1,0],["فلا تلم عويشقاً فيه تلف","ولا سكيران الذي لا ينصرف",9,"ف",1,0],["فلا تُلْقِحُوا الآن الضغائن بينكم","وبينهُم إنَّ اللواقح تُنْتجُ",10,"ج",1,0],["فلا تَلْحَيَا إن فاض دمْعٌ لفقده","فَقَلَّ له بحرٌ من الدمع يُثْمَدُ",11,"د",1,0],["فلا تلوموه إن نفى شبهاً","قد كان فيه بالواحد الصمدِ",12,"د",1,0],["فلا تَلْحينِّي في ذنوبيَ كلها","فجاني ذنوبي عفوك المتواتر",13,"ر",1,0],["فلا تَلْحَيَنّي في العتاب فإنّما","عركْتُ أديماً لا يقصّفُه العَركُ",14,"ك",1,0],["فلا تلمني يا أخي","بل ادعُ لي بالبركهْ",15,"ك",2,0],["فلا تُلحمنّ الشعر عِرضك إنه","حريقُ هجاء نارهُ تتأكّلُ",16,"ل",1,0],["فلا تلحينّي إن لَحَيتُكَ إنني","بُنصرةِ إخوان الصفاء مُوَكَّلُ",16,"ل",1,0],["فلا تَلْحَهُ يا ابنَ الكرامِ وأعْفِهِ","فما لوْمُ من لم تَبْقَ إلا رمائمه",17,"م",2,0],["فَلا تَلُمنا فَإِنّا","قُلنا وَقُلنا وَقُلنا",18,"ن",2,0],["فلا تلقى سوى حيّ كميت","ومنزوف وإن لم يسق راحا",19,"ح",2,0],["فلا تلم فرنسا","وفضلها لا تنسا",20,"س",2,0],["فلا تلمني بعد ذا","إذا تعمدت الأذى",20,"ذ",2,0],["فَلا تَلوموهُ إِذا ما سَلا","قَد فُتِحَ البابُ وَمَرَّ الهَوا",21,"و",2,0],["فَلا تُلزِمَنّي ذُنوبَ الزَمانِ","إِلَيَّ أَساءَ وَإِيّايَ ضارا",22,"ر",2,0],["فَلا تَلُمها عَلى تَواقُعِها","أَطرَبَها أَن رَأَتكَ مُبتَسِما",23,"م",2,0],["فلا تلُمها رأت شيئاً فأعجَبَها","فعاوَدتكَ ولَو ملَّتكَ لَم تَعُدِ",24,"د",1,0],["فَلا تُلحِقَن بي مَعشَراً لَم يُؤَمِّلوا","لَحاقي وَلَم يَجروا إِلى أَمَدٍ مَعي",25,"ع",2,0],["فَلا تَلُمني إنّني مُغْتَنِمٌ","مِنَ السّرورِ في زَمَاني ما مَنَحْ",26,"ح",1,0],["فَلا تُلحِمَنّي نَهشَلاً إِنَّ نَهشَلاً","بِدارِ الغِنى أَن يُستَحَلَّ حَريمُها",27,"م",3,0],["فلا تَلاقَيتَ إلاّ مَن ملكْتَ ومَن","أجَرْتَ من حادث الأيّامِ والنُّوَب",28,"ب",1,0],["فَلا تَلُمِ النَهرِيَّ إِن قَلَّ جَريُهُ","لَعَمرُ أَبيكَ الوالِقِيُّ لَقَد جَهَد",29,"د",1,0],["فلا تُلْزِمَنّي مِن مديحكَ مَنْطِقاً","يُقَصّرُ فِكري عن بُلوغِ التِزامهِ",30,"م",2,0],["فلا تُلْبِسيها أنتِ غيرِيَ باسِلاً","إذا مُتُّ لم يحْفِلْ رَدايَ وإبسالي",31,"ل",2,0],["فلا تَلُمِ السّوابِقَ والمَطايا","إذا غَرَضٌ من الأغراضِ حادا",32,"د",2,0],["فَلا تَلُمْنِي عَلَى دَمْعٍ تَحَدَّرَ في","سَفْحِ الْعَقِيقِ فَلِي في سَفْحِهِ أَرَبُ",33,"ب",1,0],["فَلا تَلُمْنِي إِذَا مَا","أَصْبَحْتُ أَلْعَنُ خَيْرِي",34,"ي",1,0],["فَلاَ تَلْقَى بِهِ خَلَقاً هَزِيلاً","وَلاَ تَلْقَى بِهِ خُلُقاً هَزِيلاَ",35,"ل",2,0],["فَلا تَلبَسُ النُعمى وَغَيرُكَ مُلبِسٌ","وَلا تُقبَلُ الدُنيا وَغَيرُكَ واهِبُ",36,"ب",1,0],["فلا تلتمس رزقا بعيش مقتر","لكل غد رزق يعود جديد",37,"د",1,0],["فلا تَلْحَهُ يا بنَ الكرامِ وأعْفِهِ","فما لوْمُ من لم تَبْقَ إلا رمائمُه",38,"م",2,0],["فلا تلح شعري إنه الريح مرةً","تقر وأخرى لاتني تتعجرف",39,"ف",1,0],["فَلا تَلِدي وَلا يَنكَحكِ مِثلي","إِذا طَرَدَ السَفا هَيفاً نَصولا",40,"ل",2,0],["فَلا تَلِدي وَلا يَنكَحكِ مِثلي","إِذا ما لَيلَةٌ طَرَقَت بِنَحسِ",41,"س",1,0],["فَلا تَلُمهُ إِذا لَم يَشكُ عِلَّتَهُ","فَالمَيتُ لا يَتَشَكّى حادِثَ العِلَلِ",42,"ل",1,0],["فَلا تَلحَوا عَزيماتٍ إِذا ما","أَرادَت نَقضَ حَبلِكَ زادَ فَتلا",43,"ل",2,0],["فَلا تُلزِمونا مَينَ واشٍ وَشى بِنا","خُذوا الحَقَّ مِنّا في المَوَدَّةِ إِن مِنّا",44,"ن",2,0],["فلا تلمهمُ على الافراط في جزعٍ","قد كاد يعقبُهم لو لم يزل جبلا",45,"ل",2,0],["فلا تلوموا في خضوع جرى","فذي التي قد أوجبت ذلتي",46,"ت",2,0],["فلا تُلَجِّجْ في غمارِ المُنَى","وارضَ بما يُمني لك الماني",47,"ن",2,0],["فلا تلزم الأيام ذنبا فإنها","مدبّرة والرزق غاد ورائح",48,"ح",1,0],["فلا تلزمن ذنبا أخاك وإن ونى","مدلا فإن الطرف في جريه يكبو",49,"ب",2,0],["فَلا تلمِ الدهرين إِن سَخِروا بهم","وَإِن خَسِروا أيضاً فمن جهةٍ أخرى",50,"ر",2,0],["فَلا تلم اِبناً قد تولّدَ بعدها","إِذا لَم يكُن طوعاً لوالدهِ برّا",50,"ر",2,0],["فلا تلمني لي سنين","أبكي عليك بكل عين",51,"ن",1,0],["فلا تلومنني على خُلقي","واقني حياءَ الكريمِ واقتعدي",52,"د",2,0],["فلا تُلْحِقَنْ بي مَعْشراً لم يَقُدْهُمُ","لحبِّك إلاّ الخوفُ ثم الدّراهم",53,"م",1,0],["فلا تلزمني الصبر في كل موطن","فقلب اخي الآمال غير صبور",54,"ر",1,0],["فَلا تَلِمُ الْقَوافِيَ إِنْ أَطَالَتْ","قَطِيعَةَ بِرَّكَ الْبَرِّ الْوَصُولِ",55,"ل",1,0],["فلا تلحني إن كنت أنحرهم هجا","لأنهم اختاروا الهجاءَ وهم شاءُ",56,"ا",2,0],["فلا تلقي لها بالا","كأن لم تك في شغل",57,"ل",1,0],["فَلا تُلزِموهُ في وِدادي كُلفَةً","فَلا خَيرَ في الودِّ الَّذي يُتَكَلَّفُ",58,"ف",1,0],["فلا تَلوموني إذا مسَّكم","من قَربها أو مَسَّها عارُ",59,"ر",1,0],["فلا تُلزِموني غيرةً ما عَرِفتُها","فإنَّ حَبيبي من أحبَّ حبيبي",60,"ب",2,0],["فلا تلاح مثله وخلَّه","ولا تحاكِ جافياً في فِعله",61,"ه",1,0],["فلا تلاعب غيرَ من قدراتهُ","عقلٌ غدا في فعِله ميزانَهُ",61,"ه",1,0],["فَلا تَلحني إِن هِمتَ شَوقاً وَحَسرَة","فَإِن اِشتياق المَرء لا شَكَ غالبه",62,"ب",2,0],["فَلا تَلُم أَهل الهَوى","فَاللَوم فيهِ سَمج",63,"ج",1,0],["فلا تلمني إذا شبهت راحته","بالكأس وهو عيون المال لا المطر",64,"ر",1,0],["فلا تلح الألى فما طلبوا","عيناً ولا غيرهم من البشر",65,"ر",1,0],["فلا تلمني على فعالي","عليك في ذلك الملام",66,"م",1,0],["فلا تلمني إنْ بكيت عَنْدَما","فإن دمع العين في العين سرى",67,"ا",1,0],["فلا تلم السكران في حالِ سُكرهِ","فقد رقع التكليف في سُكرِنا عنّا",68,"ن",2,0],["فلا تلزموا في الحزن من فقد هالك","نفوسكم ما لم يكن غير لازم",69,"م",1,0],["فَلا تَلُم حُرّاً غَدا حائِراً","مُذ صارَ مَملوكاً لِمَملوكِ",70,"ك",1,0],["ف