{"poems":[[57,"فقيها وصوفيا فكن ليس واحدا","https://www.aldiwan.net/poem24711.html","الطويل"],[77,"مشرف دار الملك ما باله","https://www.aldiwan.net/poem36003.html","السريع"],[93,"أغادية بكرت بالحيا","https://www.aldiwan.net/poem11146.html","المتقارب"],[4,"من كان مني جاهلا أو مغمرا","https://www.aldiwan.net/poem21163.html","الطويل"],[72,"صرفت لجود تاج الدين قصدي","https://www.aldiwan.net/poem19339.html","الوافر"],[72,"قضيت العمر مداحا","https://www.aldiwan.net/poem19653.html","الهزج"],[72,"إمام المسلمين تعز عمن","https://www.aldiwan.net/poem20567.html","الوافر"],[26,"وما حمل البختي عام غياره","https://www.aldiwan.net/poem24080.html","الطويل"],[26,"أبالصرم من أسماء حدثك الذي","https://www.aldiwan.net/poem24096.html","الطويل"],[91,"ماذا جنيت عليهم أيها القلم","https://www.aldiwan.net/poem62702.html","عموديه"],[70,"لي صاحب غاب عني","https://www.aldiwan.net/poem42384.html","المجتث"],[89,"وما الارض والانسان يجثم فوقها","https://www.aldiwan.net/poem44858.html","الطويل"],[85,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[85,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[28,"لوى ابن أبي الرقراق عينيه بعدما","https://www.aldiwan.net/poem5063.html","الطويل"],[58,"دع الحرص على الدنيا","https://www.aldiwan.net/poem30973.html","الهزج"],[80,"أذبت فؤادي يا فديتك بالعتب","https://www.aldiwan.net/poem31564.html","الطويل"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[69,"فقيرة غنية","https://www.aldiwan.net/poem28219.html","مجزوء الرجز"],[69,"فقيه إذا طال هجرانه","https://www.aldiwan.net/poem28322.html","المتقارب"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[105,"دعا فأجابوا والقلوب صوادف","https://www.aldiwan.net/poem44224.html","الطويل"],[52,"لا تنكرن إذا أهديت نحوك من","https://www.aldiwan.net/poem26819.html","البسيط"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[48,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[48,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[46,"أيا طفل الشفيقة إن ربي","https://www.aldiwan.net/poem22155.html","الوافر"],[46,"متى أهلك ياقومي","https://www.aldiwan.net/poem23108.html","الهزج"],[46,"كأن أكوان أعمار نعيش بها","https://www.aldiwan.net/poem23570.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85839","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30506","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[106,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[91,"أيّها القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53239",""],[91,"لقاء وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=53392",""],[113,"بحيث اندهش الفكر","https://www.aldiwan.net/poem41097.html","عموديه"],[141,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[141,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[158,"خذ النفس بالتسلم لله في الأمر","https://www.aldiwan.net/poem59180.html","الطويل"],[167,"صداق المعالي مشرفي وذابل","https://www.aldiwan.net/poem1647.html",""],[180,"قد ناح أنطون سيور مودعة","https://www.aldiwan.net/poem61192.html","البسيط"],[183,"أف لها دنيا فلا تستقر","https://www.aldiwan.net/poem14531.html","السريع"],[184,"أحب الملاح بحسن الدلال","https://www.aldiwan.net/poem43740.html","المتقارب"],[184,"صبرت لصرف هذا الدهر لما","https://www.aldiwan.net/poem43916.html","الوافر"],[184,"ضرير أحنف شيخ كبير","https://www.aldiwan.net/poem44127.html","الوافر"],[205,"أراك امرأ في ظلم قومك جاهدا","https://www.aldiwan.net/poem27963.html","الطويل"],[223,"لهف الرياسات على راحل","https://www.aldiwan.net/poem55089.html","السريع"],[254,"أيا من وجهه كالشمس توفي","https://www.aldiwan.net/poem48427.html","الوافر"],[269,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[302,"أقوم بفرض العامرية والنفل","https://www.aldiwan.net/poem16749.html","الطويل"],[351,"أشاقك صوت غنا الأورق","https://www.aldiwan.net/poem40020.html","المتقارب"],[351,"لولا العذار ولولا طرفك الساجي","https://www.aldiwan.net/poem40547.html","البسيط"],[362,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[364,"صبرت على استبطاء عاقبة الصبر","https://www.aldiwan.net/poem17308.html","الطويل"],[374,"ما بال شمسِ ضحانا في منازلها","https://www.aldiwan.net/poem59138.html","البسيط"],[374,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[374,"سقياك سقياك ربعا ظل مبتهجا","https://www.aldiwan.net/poem66893.html","البسيط"],[388,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[400,"أجاب الدمع من قبل اللسان","https://www.aldiwan.net/poem33393.html","الوافر"],[402,"شيخ لنا يقطعنا عرضه","https://www.aldiwan.net/poem49774.html","السريع"],[402,"لا تنكرن إذا أهديت نحوك من","https://www.aldiwan.net/poem49854.html","البسيط"],[413,"هل تعلمون بني الآداب لا كتبت","https://www.aldiwan.net/poem53828.html","الوافر"],[413,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[434,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[456,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[456,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"وأسود اللون وافانا وقد جنحت","https://www.aldiwan.net/poem3157.html","عموديه"],[462,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[466,"سلوت عن هاجري وعندي","https://www.aldiwan.net/poem59544.html","مخلع البسيط"],[493,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[512,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[513,"تيقنوا أن قلبي منهم يجب","https://www.aldiwan.net/poem12032.html","البسيط"],[513,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[557,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[560,"فارقت ربع بني الحداد منتقلا","https://www.aldiwan.net/poem52582.html","البسيط"],[573,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[573,"عتبنا على الأيام قبل ظهوره","https://www.aldiwan.net/poem3105.html","الطويل"]],"verses":[["فَقيهاً وَصوفِياً فَكُن لَيسَ واحِداً","فَإِنّي وَحَقُ اللَهِ إيّاكَ أَنصَحُ",0,"ح",1,1],["فَقِيلَ لِي لَيْسَ بِهِ عِلَّةٌ","لَكِنَّهُ قَدْ أَكَلَ الْقَابِضَا",1,"ض",2,0],["فَقِيدَةْ مِصْرٍ فَرِيدَةُ عَصْرٍ","لَهَا كُلُّ غَانِيَةٍ فَادِيَهْ",2,"د",3,0],["فُقَيمٌ وَعَبدُ اللَهِ في عِزِّ نَهشَلٍ","بِثَيتَلَ كُلٌّ حاضِرٌ مُتَناصِرُ",3,"ر",1,0],["فقيل ليَ القرافة أشغلته","وكم بنداه قيل لي ألق رافَه",4,"ه",1,0],["فقير الوجه والكفّ","فلا جاهٌ ولا مالُ",5,"ل",1,0],["فقيدتكَ التي صغرت كبير","قضاء عزائها بينَ القضايا",6,"ا",3,0],["فَقيلَ تَحَمَّل فَوقَ طَوقِكَ إِنَّها","مُطَبَّعَةٌ مَن يَأتِها لا يَضيرُها",7,"ر",3,0],["فَقيلَ تَجَنَّبها حَرامُ وَراقَهُ","ذُراها مُبيناً عَرضُها وَاِنتِصابُها",8,"ب",3,0],["فَقَيَّدوها لَعَلَّ القَيدَ يُسكِتُها","وَعَزَّ أَن يَسكُتَ المَظلومُ لَو عَلِموا",9,"م",3,0],["فَقيلَ إِنَّ فُلاناً","ذاكَ المَليحُ لَدَيهِ",10,"ي",2,0],["فقيل ضرورات وقيل مشيئة","وكل الذي قد قيل ظن مرجم",11,"م",1,0],["فَقيل حُرٌّ عَرَبيُّ الوَادي","وَقيل عَبدٌ مِن بَني السَوادِ",12,"د",1,0],["فَقيلَ لا ياصاحِبَ السُمُوِّ","لا يُدفَعُ العَدُوُّ بِالعَدُوِّ",13,"و",1,0],["فَقيلَ أَنِل أَقدامَكَ الأَرضَ إِنَّها","أَبَرُّ جَواداً إِن فَعَلتَ وَأَنجَبُ",14,"ب",1,0],["فَقيلَ تَخلُصُ نَفسُ المَرءِ سالِمَةً","وَقيلَ تَشرَكُ جِسمَ المَرءِ في العَطَبِ",15,"ب",1,0],["فَقيدَتِ الأُيَّلُ في الحِبالِ","طَوعَ وُهوقِ الخَيلِ وَالرِجالِ",16,"ل",1,0],["فَقيلَ أَتِهِ لَم أَتِهِ الدَهرَ ما دَعا","حَمامٌ عَلى ساقٍ هَديلاً فَقَرقَرا",17,"ر",2,0],["فَقيرٌ كُلُّ مَن يَطمَع","غَنيٌّ كُلُّ مَن يَقنَع",18,"ع",1,0],["فقيل عذابٌ لو أحطتِ بعلمِهِ","لجدتِ على الصّادي بماءِ اللّمَى العذبِ",19,"ب",1,0],["فَقَيَّدتَ بِالإِقدامِ مُطلَقَ بَأسِهِم","وَأَطلَقتَ فيهِم كُلَّ حَتفٍ مُقَيَّدِ",20,"د",1,0],["فقيرةٌ غنيَّةٌ","مرَّتْ بنا وقد خَلَتْ",21,"ت",1,1],["فقيهٌ إذا طالَ هجرانُهُ","وصبري عليهِ فعيلَ التناهي",22,"ي",1,1],["فَقَيَّدتُ مِن شَكوى وَأَطلَقتُ عَبرَتي","وَخَفَّضتُ مِن صَوتي هُنالِكَ شاكِيا",23,"ي",2,0],["فقيل اشهدوا قالوا عرفناه سيّداً","تجلُّ مَساعيه وتعلو المواقفُ",24,"ف",1,0],["فَقيِّمُ الباغِ قَد يُهدي لِصاحِبِهِ","بِرَسمِ خِدمَتِهِ مِن باغِهِ التُحَفا",25,"ف",2,0],["فَقيلَ مِرَقِّشٌ أَودى","وَلَم يَعجَز وَقَد قَدَرا",26,"ر",2,0],["فَقيلَ راشا سَهماً تُرادُ بِهِ ال","غايَةُ وَالنَصلُ سابِقُ الفوقِ",27,"ق",1,0],["فقيلَ من أنتَ قلتُ خادمكم","لا عقلٌ يُخشى له ولا قودُ",28,"د",1,0],["فقيلَ هاكَ اقتلن ذا","به وسمِّ ستُنصر",29,"ر",1,0],["فَقيراً فَاِستُضِمتُ بِلا اِتِّقاءٍ","لِرَبّي أَو أَميراً فَاِتُّقيتُ",30,"ت",1,0],["فَقيرٌ كُلُّ مَن في الأَر","ضِ إِنَّ العَبدَ لا يَملِك",31,"ك",1,0],["فَقيلَ جاءَتهُ مِن أَرضٍ عَلى كَثَبٍ","وَقيلَ خَرَّت إِلَيهِ مِن مَعاليها",32,"ي",3,0],["فقيل مت تر أن","الحياة في تلك أحلى",33,"ل",2,0],["فقيل لي إيه زدنا","من هذه الكلمات",34,"ت",1,0],["فقيل فيها أسبق الإناث","وفي عليّ أسبق الأحداث",35,"ث",1,0],["فقيل راعى المسلمين الوالي","وكان في السرّ لهم يوالي",36,"ي",1,0],["فقِيلَ ماتَ فقالَ اللَّيْلُ قاربَ ذا","فانْهَلَّ مِن مُقْلتي نَوْءٌ سِماكِيُّ",37,"ي",1,0],["فَقيدٌ عَلَى قَدْرِ المَعَالي تَعَدَّدَتْ","مَآتمُهُوَالرزْءُ فيهِ تَعَدَّدَا",38,"د",2,0],["فَقِيدَ الَمعالي وَالمُرُوءَاتِ وَالنَّدَى","وَحُلْوَ السجَايَا إِن حَلا العَيْشُ أَو مَرَّا",39,"ر",2,0],["فقيدكم خطبه -بين الورى- عَممٌ","قد حل في أمة، بل حل في أمم",40,"م",1,0],["فقيمةُ الشعب -إذا قستَها-","بقيمة الصادر والوارد",41,"د",1,0],["فقيّدوها لعلّ القيد يكتها","وعزّ أن يسكت المظلوم لو علموا",42,"م",3,0],["فقي كلّ جارحة منّي لها أثر","\" والدار صاحبها أدرى بما فيها \"",43,"ي",3,0],["فقيد حاضر العزم","وقد يفتقد البدر",44,"ر",1,0],["فَقيدُكَ مَن لا يَملِكُ الهَمَّ رَدَّهُ","وَخَصمُكَ مَن لا يُقتَضى عِندَهُ وِترُ",45,"ر",1,0],["فَقيدٌ أَماتَ المَحلَ قَبلَ فِطامِهِ","وَرَوَّعَ أَهلَ الأَرضِ لَمّا تَرَعرَعا",46,"ع",2,0],["فقيل له بلغت ليس شهادة","فقال وهل أرجو شهوداً ولي أمري",47,"ي",1,0],["فَقِيلَ لَهُ تَحتَ العَجاجَةِ دَأبُهُم","طِعانُ العِدى في حَيثُ تَخفى المَقاتِلُ",48,"ل",1,0],["فَقِيلَ إِذ ناظِمُ التأريخِ سَطَّرَهُ","اليَومَ مريمُ قَد زارت سميَّتَها",49,"ت",3,0],["فقيرُها يطلب نيلَ الغِنى","وذو الغِنى يجمعُ كيْ يَدَّخِر",50,"ر",1,0],["فقير وشيخ كبير وذو حت","ف ظاهر قد أضر",51,"ر",1,0],["فقيد جودهم وهم ملوك","وشرذهم على البلوى يزيد",52,"د",1,0],["فقير والفقير حليف ضرّ","ذليلٌ إن ذا خبرٌ عجيب",53,"ب",1,0],["فَقيلَ لَهُم أُعطيتُمُ فَتَخَيَّروا","مُناكُم وَلَكِن لا سَبيلَ إِلى الخُلدِ",54,"د",1,0],["فَقيل لي قَد سارَ في إِثرهِ","يومَ دفَنّاهُ ولم يَرجِعِ",55,"ع",1,0],["فقيل لنا اشربوا وكلوا ونيكوا","حلالاً أو على وجه الحرام",56,"م",1,0],["فَقيراً حَقيرا مستقرا بذنبه","يُبارِز بالعصيان أَعدل ناقد",57,"د",1,0],["فَقيلَ كلَّ يَوم","كالشَمسِ بين القَومِ",58,"م",1,0],["فَقيل عن أَيّام","خَوفاً من الإِبرام",58,"م",1,0],["فَقيرهُم حُرٌّ وَذو المالِ مُنفِقُ","رَجاءَ ثَوابِ اللَهِ في صالِحِ السُبُلِ",59,"ل",1,0],["فَقيّد لِسانك عَن شَتمه","فَلَيسَ المقيَّد كالمُطلقِ",60,"ق",1,0],["فَقيل في سندس خضرٍ نَرى قَمَرا","وَرُبّما قيل في إِكليل دِيباجِ",61,"ج",1,0],["فقيلَ قولٌ قد ذُكِر","فاقَ أبو بَكْرٍ عُمَر",62,"ر",1,0],["فَقيرٌ وَيَأبى اللَهُ أَن أَسأَلَ الغِنى","وَأَن يُعلَمَ اليُس