,"","https://poetry.dctabudhabi.ae/diwan/poem/111391","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125865","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125813","السريع"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136911",""],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45965","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133111","الوافر"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123459","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58045","السريع"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104894","المتقارب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52139","الطويل"],[4767,"شكوى البقيع","https://www.poetsgate.com/ViewPoem.aspx?id=175092",""],[4767,"نداء محرم","https://www.poetsgate.com/ViewPoem.aspx?id=179993",""],[4778,"إذا المرء لا يرعاك الا تكلّفا","https://www.poetsgate.com/ViewPoem.aspx?id=190721",""],[4778,"عن الإنسان إن تسَلي","https://www.poetsgate.com/ViewPoem.aspx?id=193616",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4869,"ارجل طفل . مرثيه","https://www.poetsgate.com/ViewPoem.aspx?id=139688",""],[4929,"صدى الواقع","https://www.poetsgate.com/ViewPoem.aspx?id=199284",""],[4935,"زفاف نعمت إلى الرضا منى","https://www.poetsgate.com/ViewPoem.aspx?id=129469",""],[4954,"ألْمَحتُ بَدْرًا","https://www.poetsgate.com/ViewPoem.aspx?id=207791",""],[4955,"فقيرا كنت فيها أم غنيا","https://www.poetsgate.com/ViewPoem.aspx?id=200031",""],[4988,"رجع شادي","https://www.poetsgate.com/ViewPoem.aspx?id=186968",""],[5186,"\"من \"\"البرج\"\" في كانون والليل خيما","https://www.poetsgate.com/ViewPoem.aspx?id=156441",""],[5320,"دموعى عليك حفيظ دماء","https://www.poetsgate.com/ViewPoem.aspx?id=43104",""],[1149,"ألاَ يا عمرو ، عمرو قبيلِ سهمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22302",""],[5528,"نجوى","https://www.poetsgate.com/ViewPoem.aspx?id=201009",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5652,"لآ مآ نسيتك .. وإنت أعظم خطآيآي","https://www.poetsgate.com/ViewPoem.aspx?id=135694",""],[5725,"عراق شعلان وضاري","https://www.poetsgate.com/ViewPoem.aspx?id=177471",""],[5784,"بغير الوصل لا أجد الأمان....","https://www.poetsgate.com/ViewPoem.aspx?id=190725",""],[5790,"قالوا حبيبك ملسوعٌ فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=111933",""],[5818,"دعي شِعري يموجُ","https://www.poetsgate.com/ViewPoem.aspx?id=187478",""],[5837,"مصدر الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=192086",""],[5862,"فلّسفة .. أفكار : عطّشانه .. !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31097",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[6082,"لا تثقي","https://www.poetsgate.com/ViewPoem.aspx?id=180043",""],[6102,"عيد شديد","https://www.poetsgate.com/ViewPoem.aspx?id=184462",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["فَقيهاً وَصوفِياً فَكُن لَيسَ واحِداً","فَإِنّي وَحَقُ اللَهِ إيّاكَ أَنصَحُ",0,"ح",1,1],["فَقِيلَ لِي لَيْسَ بِهِ عِلَّةٌ","لَكِنَّهُ قَدْ أَكَلَ الْقَابِضَا",1,"ض",2,0],["فَقِيدَةْ مِصْرٍ فَرِيدَةُ عَصْرٍ","لَهَا كُلُّ غَانِيَةٍ فَادِيَهْ",2,"د",3,0],["فُقَيمٌ وَعَبدُ اللَهِ في عِزِّ نَهشَلٍ","بِثَيتَلَ كُلٌّ حاضِرٌ مُتَناصِرُ",3,"ر",1,0],["فقيل ليَ القرافة أشغلته","وكم بنداه قيل لي ألق رافَه",4,"ه",1,0],["فقير الوجه والكفّ","فلا جاهٌ ولا مالُ",5,"ل",1,0],["فقيدتكَ التي صغرت كبير","قضاء عزائها بينَ القضايا",6,"ا",3,0],["فَقيلَ تَحَمَّل فَوقَ طَوقِكَ إِنَّها","مُطَبَّعَةٌ مَن يَأتِها لا يَضيرُها",7,"ر",3,0],["فَقيلَ تَجَنَّبها حَرامُ وَراقَهُ","ذُراها مُبيناً عَرضُها وَاِنتِصابُها",8,"ب",3,0],["فَقَيَّدوها لَعَلَّ القَيدَ يُسكِتُها","وَعَزَّ أَن يَسكُتَ المَظلومُ لَو عَلِموا",9,"م",3,0],["فَقيلَ إِنَّ فُلاناً","ذاكَ المَليحُ لَدَيهِ",10,"ي",2,0],["فقيل ضرورات وقيل مشيئة","وكل الذي قد قيل ظن مرجم",11,"م",1,0],["فَقيل حُرٌّ عَرَبيُّ الوَادي","وَقيل عَبدٌ مِن بَني السَوادِ",12,"د",1,0],["فَقيلَ لا ياصاحِبَ السُمُوِّ","لا يُدفَعُ العَدُوُّ بِالعَدُوِّ",13,"و",1,0],["فَقيلَ أَنِل أَقدامَكَ الأَرضَ إِنَّها","أَبَرُّ جَواداً إِن فَعَلتَ وَأَنجَبُ",14,"ب",1,0],["فَقيلَ تَخلُصُ نَفسُ المَرءِ سالِمَةً","وَقيلَ تَشرَكُ جِسمَ المَرءِ في العَطَبِ",15,"ب",1,0],["فَقيدَتِ الأُيَّلُ في الحِبالِ","طَوعَ وُهوقِ الخَيلِ وَالرِجالِ",16,"ل",1,0],["فَقيلَ أَتِهِ لَم أَتِهِ الدَهرَ ما دَعا","حَمامٌ عَلى ساقٍ هَديلاً فَقَرقَرا",17,"ر",2,0],["فَقيرٌ كُلُّ مَن يَطمَع","غَنيٌّ كُلُّ مَن يَقنَع",18,"ع",1,0],["فقيل عذابٌ لو أحطتِ بعلمِهِ","لجدتِ على الصّادي بماءِ اللّمَى العذبِ",19,"ب",1,0],["فَقَيَّدتَ بِالإِقدامِ مُطلَقَ بَأسِهِم","وَأَطلَقتَ فيهِم كُلَّ حَتفٍ مُقَيَّدِ",20,"د",1,0],["فقيرةٌ غنيَّةٌ","مرَّتْ بنا وقد خَلَتْ",21,"ت",1,1],["فقيهٌ إذا طالَ هجرانُهُ","وصبري عليهِ فعيلَ التناهي",22,"ي",1,1],["فَقَيَّدتُ مِن شَكوى وَأَطلَقتُ عَبرَتي","وَخَفَّضتُ مِن صَوتي هُنالِكَ شاكِيا",23,"ي",2,0],["فقيل اشهدوا قالوا عرفناه سيّداً","تجلُّ مَساعيه وتعلو المواقفُ",24,"ف",1,0],["فَقيِّمُ الباغِ قَد يُهدي لِصاحِبِهِ","بِرَسمِ خِدمَتِهِ مِن باغِهِ التُحَفا",25,"ف",2,0],["فَقيلَ مِرَقِّشٌ أَودى","وَلَم يَعجَز وَقَد قَدَرا",26,"ر",2,0],["فَقيلَ راشا سَهماً تُرادُ بِهِ ال","غايَةُ وَالنَصلُ سابِقُ الفوقِ",27,"ق",1,0],["فقيلَ من أنتَ قلتُ خادمكم","لا عقلٌ يُخشى له ولا قودُ",28,"د",1,0],["فقيلَ هاكَ اقتلن ذا","به وسمِّ ستُنصر",29,"ر",1,0],["فَقيراً فَاِستُضِمتُ بِلا اِتِّقاءٍ","لِرَبّي أَو أَميراً فَاِتُّقيتُ",30,"ت",1,0],["فَقيرٌ كُلُّ مَن في الأَر","ضِ إِنَّ العَبدَ لا يَملِك",31,"ك",1,0],["فَقيلَ جاءَتهُ مِن أَرضٍ عَلى كَثَبٍ","وَقيلَ خَرَّت إِلَيهِ مِن مَعاليها",32,"ي",3,0],["فقيل مت تر أن","الحياة في تلك أحلى",33,"ل",2,0],["فقيل لي إيه زدنا","من هذه الكلمات",34,"ت",1,0],["فقي كلّ جارحة منّي لها أثر","والدار صاحبها أدرى بما فيها",35,"ي",3,0],["فقيل فيها أسبق الإناث","وفي عليّ أسبق الأحداث",36,"ث",1,0],["فقيل راعى المسلمين الوالي","وكان في السرّ لهم يوالي",37,"ي",1,0],["فقِيلَ ماتَ فقالَ اللَّيْلُ قاربَ ذا","فانْهَلَّ مِن مُقْلتي نَوْءٌ سِماكِيُّ",38,"ي",1,0],["فَقيدٌ عَلَى قَدْرِ المَعَالي تَعَدَّدَتْ","مَآتمُهُوَالرزْءُ فيهِ تَعَدَّدَا",39,"د",2,0],["فَقِيدَ الَمعالي وَالمُرُوءَاتِ وَالنَّدَى","وَحُلْوَ السجَايَا إِن حَلا العَيْشُ أَو مَرَّا",40,"ر",2,0],["فقيدكم خطبه -بين الورى- عَممٌ","قد حل في أمة، بل حل في أمم",41,"م",1,0],["فقيمةُ الشعب -إذا قستَها-","بقيمة الصادر والوارد",42,"د",1,0],["فقيّدوها لعلّ القيد يكتها","وعزّ أن يسكت المظلوم لو علموا",43,"م",3,0],["فقيد حاضر العزم","وقد يفتقد البدر",44,"ر",1,0],["فَقيدُكَ مَن لا يَملِكُ الهَمَّ رَدَّهُ","وَخَصمُكَ مَن لا يُقتَضى عِندَهُ وِترُ",45,"ر",1,0],["فَقيدٌ أَماتَ المَحلَ قَبلَ فِطامِهِ","وَرَوَّعَ أَهلَ الأَرضِ لَمّا تَرَعرَعا",46,"ع",2,0],["فقيل له بلغت ليس شهادة","فقال وهل أرجو شهوداً ولي أمري",47,"ر",2,0],["فَقِيلَ لَهُ تَحتَ العَجاجَةِ دَأبُهُم","طِعانُ العِدى في حَيثُ تَخفى المَقاتِلُ",48,"ل",1,0],["فَقِيلَ إِذ ناظِمُ التأريخِ سَطَّرَهُ","اليَومَ مريمُ قَد زارت سميَّتَها",49,"ت",3,0],["فقيرُها يطلب نيلَ الغِنى","وذو الغِنى يجمعُ كيْ يَدَّخِر",50,"ر",1,0],["فقير وشيخ كبير وذو حت","ف ظاهر قد أضر",51,"ر",1,0],["فقيد جودهم وهم ملوك","وشرذهم على البلوى يزيد",52,"د",1,0],["فقير والفقير حليف ضرّ","ذليلٌ إن ذا خبرٌ عجيب",53,"ب",1,0],["فَقيلَ لَهُم أُعطيتُمُ فَتَخَيَّروا","مُناكُم وَلَكِن لا سَبيلَ إِلى الخُلدِ",54,"د",1,0],["فَقيل لي قَد سارَ في إِثرهِ","يومَ دفَنّاهُ ولم يَرجِعِ",55,"ع",1,0],["فقيل لنا اشربوا وكلوا ونيكوا","حلالاً أو على وجه الحرام",56,"م",1,0],["فَقيراً حَقيرا مستقرا بذنبه","يُبارِز بالعصيان أَعدل ناقد",57,"د",1,0],["فَقيلَ كلَّ يَوم","كالشَمسِ بين القَومِ",58,"م",1,0],["فَقيل عن أَيّام","خَوفاً من الإِبرام",58,"م",1,0],["فَقيرهُم حُرٌّ وَذو المالِ مُنفِقُ","رَجاءَ ثَوابِ اللَهِ في صالِحِ السُبُلِ",59,"ل",1,0],["فَقيّد لِسانك عَن شَتمه","فَلَيسَ المقيَّد كالمُطلقِ",60,"ق",1,0],["فَ