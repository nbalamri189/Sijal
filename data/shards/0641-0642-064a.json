{"poems":[[57,"فقيها وصوفيا فكن ليس واحدا","https://www.aldiwan.net/poem24711.html","الطويل"],[77,"مشرف دار الملك ما باله","https://www.aldiwan.net/poem36003.html","السريع"],[93,"أغادية بكرت بالحيا","https://www.aldiwan.net/poem11146.html","المتقارب"],[4,"من كان مني جاهلا أو مغمرا","https://www.aldiwan.net/poem21163.html","الطويل"],[72,"صرفت لجود تاج الدين قصدي","https://www.aldiwan.net/poem19339.html","الوافر"],[72,"قضيت العمر مداحا","https://www.aldiwan.net/poem19653.html","الهزج"],[72,"إمام المسلمين تعز عمن","https://www.aldiwan.net/poem20567.html","الوافر"],[26,"وما حمل البختي عام غياره","https://www.aldiwan.net/poem24080.html","الطويل"],[26,"أبالصرم من أسماء حدثك الذي","https://www.aldiwan.net/poem24096.html","الطويل"],[91,"ماذا جنيت عليهم أيها القلم","https://www.aldiwan.net/poem62702.html","عموديه"],[70,"لي صاحب غاب عني","https://www.aldiwan.net/poem42384.html","المجتث"],[89,"وما الارض والانسان يجثم فوقها","https://www.aldiwan.net/poem44858.html","الطويل"],[85,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[85,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[28,"لوى ابن أبي الرقراق عينيه بعدما","https://www.aldiwan.net/poem5063.html","الطويل"],[58,"دع الحرص على الدنيا","https://www.aldiwan.net/poem30973.html","الهزج"],[80,"أذبت فؤادي يا فديتك بالعتب","https://www.aldiwan.net/poem31564.html","الطويل"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[69,"فقيرة غنية","https://www.aldiwan.net/poem28219.html","مجزوء الرجز"],[69,"فقيه إذا طال هجرانه","https://www.aldiwan.net/poem28322.html","المتقارب"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[105,"دعا فأجابوا والقلوب صوادف","https://www.aldiwan.net/poem44224.html","الطويل"],[52,"لا تنكرن إذا أهديت نحوك من","https://www.aldiwan.net/poem26819.html","البسيط"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[48,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[48,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[46,"أيا طفل الشفيقة إن ربي","https://www.aldiwan.net/poem22155.html","الوافر"],[46,"متى أهلك ياقومي","https://www.aldiwan.net/poem23108.html","الهزج"],[46,"كأن أكوان أعمار نعيش بها","https://www.aldiwan.net/poem23570.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85839","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30506","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[106,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[91,"أيّها القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53239",""],[91,"لقاء وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=53392",""]],"verses":[["فَقيهاً وَصوفِياً فَكُن لَيسَ واحِداً","فَإِنّي وَحَقُ اللَهِ إيّاكَ أَنصَحُ",0,"ح",1,1],["فَقِيلَ لِي لَيْسَ بِهِ عِلَّةٌ","لَكِنَّهُ قَدْ أَكَلَ الْقَابِضَا",1,"ض",2,0],["فَقِيدَةْ مِصْرٍ فَرِيدَةُ عَصْرٍ","لَهَا كُلُّ غَانِيَةٍ فَادِيَهْ",2,"د",3,0],["فُقَيمٌ وَعَبدُ اللَهِ في عِزِّ نَهشَلٍ","بِثَيتَلَ كُلٌّ حاضِرٌ مُتَناصِرُ",3,"ر",1,0],["فقيل ليَ القرافة أشغلته","وكم بنداه قيل لي ألق رافَه",4,"ه",1,0],["فقير الوجه والكفّ","فلا جاهٌ ولا مالُ",5,"ل",1,0],["فقيدتكَ التي صغرت كبير","قضاء عزائها بينَ القضايا",6,"ا",3,0],["فَقيلَ تَحَمَّل فَوقَ طَوقِكَ إِنَّها","مُطَبَّعَةٌ مَن يَأتِها لا يَضيرُها",7,"ر",3,0],["فَقيلَ تَجَنَّبها حَرامُ وَراقَهُ","ذُراها مُبيناً عَرضُها وَاِنتِصابُها",8,"ب",3,0],["فَقَيَّدوها لَعَلَّ القَيدَ يُسكِتُها","وَعَزَّ أَن يَسكُتَ المَظلومُ لَو عَلِموا",9,"م",3,0],["فَقيلَ إِنَّ فُلاناً","ذاكَ المَليحُ لَدَيهِ",10,"ي",2,0],["فقيل ضرورات وقيل مشيئة","وكل الذي قد قيل ظن مرجم",11,"م",1,0],["فَقيل حُرٌّ عَرَبيُّ الوَادي","وَقيل عَبدٌ مِن بَني السَوادِ",12,"د",1,0],["فَقيلَ لا ياصاحِبَ السُمُوِّ","لا يُدفَعُ العَدُوُّ بِالعَدُوِّ",13,"و",1,0],["فَقيلَ أَنِل أَقدامَكَ الأَرضَ إِنَّها","أَبَرُّ جَواداً إِن فَعَلتَ وَأَنجَبُ",14,"ب",1,0],["فَقيلَ تَخلُصُ نَفسُ المَرءِ سالِمَةً","وَقيلَ تَشرَكُ جِسمَ المَرءِ في العَطَبِ",15,"ب",1,0],["فَقيدَتِ الأُيَّلُ في الحِبالِ","طَوعَ وُهوقِ الخَيلِ وَالرِجالِ",16,"ل",1,0],["فَقيلَ أَتِهِ لَم أَتِهِ الدَهرَ ما دَعا","حَمامٌ عَلى ساقٍ هَديلاً فَقَرقَرا",17,"ر",2,0],["فَقيرٌ كُلُّ مَن يَطمَع","غَنيٌّ كُلُّ مَن يَقنَع",18,"ع",1,0],["فقيل عذابٌ لو أحطتِ بعلمِهِ","لجدتِ على الصّادي بماءِ اللّمَى العذبِ",19,"ب",1,0],["فَقَيَّدتَ بِالإِقدامِ مُطلَقَ بَأسِهِم","وَأَطلَقتَ فيهِم كُلَّ حَتفٍ مُقَيَّدِ",20,"د",1,0],["فقيرةٌ غنيَّةٌ","مرَّتْ بنا وقد خَلَتْ",21,"ت",1,1],["فقيهٌ إذا طالَ هجرانُهُ","وصبري عليهِ فعيلَ التناهي",22,"ي",1,1],["فَقَيَّدتُ مِن شَكوى وَأَطلَقتُ عَبرَتي","وَخَفَّضتُ مِن صَوتي هُنالِكَ شاكِيا",23,"ي",2,0],["فقيل اشهدوا قالوا عرفناه سيّداً","تجلُّ مَساعيه وتعلو المواقفُ",24,"ف",1,0],["فَقيِّمُ الباغِ قَد يُهدي لِصاحِبِهِ","بِرَسمِ خِدمَتِهِ مِن باغِهِ التُحَفا",25,"ف",2,0],["فَقيلَ مِرَقِّشٌ أَودى","وَلَم يَعجَز وَقَد قَدَرا",26,"ر",2,0],["فَقيلَ راشا سَهماً تُرادُ بِهِ ال","غايَةُ وَالنَصلُ سابِقُ الفوقِ",27,"ق",1,0],["فقيلَ من أنتَ قلتُ خادمكم","لا عقلٌ يُخشى له ولا قودُ",28,"د",1,0],["فقيلَ هاكَ اقتلن ذا","به وسمِّ ستُنصر",29,"ر",1,0],["فَقيراً فَاِستُضِمتُ بِلا اِتِّقاءٍ","لِرَبّي أَو أَميراً فَاِتُّقيتُ",30,"ت",1,0],["فَقيرٌ كُلُّ مَن في الأَر","ضِ إِنَّ العَبدَ لا يَملِك",31,"ك",1,0],["فَقيلَ جاءَتهُ مِن أَرضٍ عَلى كَثَبٍ","وَقيلَ خَرَّت إِلَيهِ مِن مَعاليها",32,"ي",3,0],["فقيل مت تر أن","الحياة في تلك أحلى",33,"ل",2,0],["فقيل لي إيه زدنا","من هذه الكلمات",34,"ت",1,0],["فقيل فيها أسبق الإناث","وفي عليّ أسبق الأحداث",35,"ث",1,0],["فقيل راعى المسلمين الوالي","وكان في السرّ لهم يوالي",36,"ي",1,0],["فقِيلَ ماتَ فقالَ اللَّيْلُ قاربَ ذا","فانْهَلَّ مِن مُقْلتي نَوْءٌ سِماكِيُّ",37,"ي",1,0],["فَقيدٌ عَلَى قَدْرِ المَعَالي تَعَدَّدَتْ","مَآتمُهُوَالرزْءُ فيهِ تَعَدَّدَا",38,"د",2,0],["فَقِيدَ الَمعالي وَالمُرُوءَاتِ وَالنَّدَى","وَحُلْوَ السجَايَا إِن حَلا العَيْشُ أَو مَرَّا",39,"ر",2,0],["فقيدكم خطبه -بين الورى- عَممٌ","قد حل في أمة، بل حل في أمم",40,"م",1,0],["فقيمةُ الشعب -إذا قستَها-","بقيمة الصادر والوارد",41,"د",1,0],["فقيّدوها لعلّ القيد يكتها","وعزّ أن يسكت المظلوم لو علموا",42,"م",3,0],["فقي كلّ جارحة منّي لها أثر","\" والدار صاحبها أدرى بما فيها \"",43,"ي",3,0]]}