try.dctabudhabi.ae/diwan/poem/118749","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85273","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86510","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59502","البسيط"],[3854,"","https://poetry.dctabudhabi.ae/diwan/poem/47370","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133294","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102944","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40127","السريع"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77020","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105261","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125803","الكامل"],[4113,"","https://poetry.dctabudhabi.ae/diwan/poem/145508","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127309","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133107","الوافر"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139554",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139527",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139772",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139633",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/147523","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204313","الطويل"],[4797,"يالله يا عالم خفا كل ماكان","https://www.poetsgate.com/ViewPoem.aspx?id=180551",""],[4578,"عقودُ ودادي نظمها ليس يفسخ","https://www.poetsgate.com/ViewPoem.aspx?id=49389",""],[4853,"فديت إماماً صيغ من عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=181769",""],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[4119,"يا سعد ما أحسنها شمائلا","https://www.poetsgate.com/ViewPoem.aspx?id=16208",""],[4119,"ملك المدى يوم أغر محجل","https://www.poetsgate.com/ViewPoem.aspx?id=16206",""],[4119,"أيا عاذلي في الحب مالي وللعذل","https://www.poetsgate.com/ViewPoem.aspx?id=16210",""],[4119,"يا ليت أن الصد مصدود","https://www.poetsgate.com/ViewPoem.aspx?id=16113",""],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[3591,"كل يرى حسناً من لم يكن حسنا","https://www.poetsgate.com/ViewPoem.aspx?id=149412",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5376,"عجباً من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=188267",""],[5431,"بكتاب عشقي اودعتْ كي أفتحه !!","https://www.poetsgate.com/ViewPoem.aspx?id=197671",""],[5431,"غزة ...وحسبك الله سلطان السلاطين","https://www.poetsgate.com/ViewPoem.aspx?id=200866",""],[5463,"سلوى عنوان المودّه","https://www.poetsgate.com/ViewPoem.aspx?id=30881",""],[5508,"وقفنا على حكم الهوى نعلن الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=110819",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5939,"مشاغبة","https://www.poetsgate.com/ViewPoem.aspx?id=180018",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[6189,"من مذكرة قبيلة باهلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83559&r=&rc=26",""]],"verses":[["مُناقِلَةً تَنجو بِزَجرَةِ غَيرِها","وَتَرهَبُ سَوطَ المَرءِ راعَ سِواها",0,"ا",3,0],["مُناقِلٌ في عِنانِ الريحِ جَريَتُهُ","كَأَنَّهُ قَبَسٌ أَو بارِقٌ عَمِلُ",1,"ل",1,0],["مِن أَقاحٍ غُمِسنَ في البارِدِ العَذ","بِ طَويلاً وَمِن قَضيبٍ قَضيفِ",2,"ف",1,0],["مَن أَقسَموا بِأَلزَمِ الأَقسامِ","بِأَن يُقَضّوا دَولَةَ الظَلامِ",3,"م",1,0],["مُناقِلَةً عُرضَ الفَيافي شِمِلَّةً","مَطِيَّةَ قَذافٍ عَلى الهَولِ مَبعَدِ",4,"د",1,0],["مَنَاقِبٌ أَبْرَزَتْكَ مِنْ شَرَفٍ","عَالٍ وَأَذِكَتْ نُوراً عَلَى عَلَمِ",5,"م",1,0],["مناقبُ تسمو للفخار كأنما","تجاريّ إلى المجد النجوم الجواريا",6,"ي",2,0],["مناقب كنجوم الليل مُشرقةً","تَهدي إلى المجد في أنوارها الأمما",7,"م",2,0],["مناقبٌ يهتدي وفدُ الثنا لها","بواضحٍ من ضياءِ البدر منبلج",8,"ج",1,0],["مناقب شاعت في الورى علوية","فكلهمُ فيها يشيّع من عذر",9,"ر",1,0],["من أقرض الأوقاتَ أتلفَها","وقضى جميعَ قُرُوضِها جسَدُهْ",10,"د",2,0],["من أقدم الناس ولكنما","إقدامه تضييعه حِذرَهْ",11,"ر",2,0],["من أقبح الناس لا أُحاشِي","من كان منهم ومن يكونُ",12,"ن",1,0],["مَناقِبُ شَتّى لَو تَكونُ لِحاجِبٍ","لَما ذَكَرَت يَوماً لَهُ القَوسَ خِندِفُ",13,"ف",1,0],["مَنِ اِقتَضى بِسِوى الهِندِيِّ حاجَتَهُ","أَجابَ كُلَّ سُؤالٍ عَن هَلٍ بِلَمِ",14,"م",1,0],["مَناقِبُ لا يَزالُ الشِعرُ فيها","طَوالَ الدَهرِ في شُغلٍ جَديدِ",15,"د",1,0],["مناقبٌ يَنطوي الحَسودُ لها","على جَوىً أو يُميتُه حَسَدُه",16,"د",2,0],["مناقبُ تملأُ الحُسَّادَ غَيْظاً","وتُغْني الطَّالبينَ عن الطِّلابِ",17,"ب",1,0],["مَناقِبُ مَعروفُها تالِدٌ","مُحَمَّدُ أَورَثَها مِن عَلي",18,"ل",2,0],["مَناقِبُ مِلءَ الدَهرِ أَربى عِدادُها","فَقُل لِبَني التاميزِ عُدّوا المَخازِيا",19,"ي",2,0],["مَنَاقِبُ ما يزالُ لها طُلوعٌ","إذا الأقمارُ أدركها الأُفُولُ",20,"ل",1,0],["مَناقِبُ للدنيا العريضةِ هِزَّةٌ","إذا ذُكِرتْ فَلْيَشدُ من كان شاديا",21,"ي",2,0],["مَناقِبٌ فيها جَمالُ الصِّبا","وهْيَ لِداتُ الدهرِ أو أقْدَمُ",22,"م",1,0],["مِن أقصرِ الأَجزاء والشُّطورِ","حُروفُه عشرونَ في التَّقديرِ",23,"ر",1,0],["مناقب ما تولى الخبر أحرفها","إلا حسبت على عطف العلى خبره",24,"ر",2,0],["مَنَاقِبٌ كَمْ أَحَلَّتْ مُسْتَضَاماً","بِهِ الأَيَّامُ ضَاقَتْ فِي رِحَابِ",25,"ب",1,0],["مَناقِبُ قَد أَضحى بِها الدَهرُ حالِياً","فَها عِطفُهُ مِنها مُوَشّىً مُوَشَّحُ",26,"ح",1,0],["مَناقِبُ لَم تُدرَك بِكَيدٍ وَلَم تُنَل","بِشَيءٍ سِوى حَدِّ القَنا الذَرباتِ",27,"ت",1,0],["مناقب لو رأتها الشمس لانحجت","دهشا ولو انها في دارة الحمل",28,"ل",1,0],["مناقب لاحت كالنجوم ورفعة","تسامت فما ابقت مجالا لصاعد",29,"د",1,0],["مناقبه الجليلة في البرايا","لها في كل زاوية اريج",30,"ج",1,0],["مناقب كالبدور زاهرة","وخارقات من دونها الشهب",31,"ب",1,0],["مَن أقَامَ الصَّفَا ورَاضَ الحَرونَ الص","صَعبَ وأستسهل الخطوبَ الصِّعابَا",32,"ب",2,0],["مناقِبُهُ مثلُ الكواكِبِ كثرةً","ونُوراً ألا اللَهِ تلكَ المناقِبُ",33,"ب",1,0],["مناقبُ مثلُ عِدادِ الرمالِ","تكُدُّ أناملَ حُسّابها",34,"ب",3,0],["مَناقِبُ قَد خَصَّت نِزارَ يَزينُها","مَواهِبُ قَد عَمَّت نِزارَ وَيَعرُبا",35,"ب",2,0],["مَناقِبُ لَو أَنَّ اللَيالي تَوَشَّحَت","بِأَذيالِها لَاِبيَضَّ مِنهُنَّ ما اِسوَدّا",36,"د",2,0],["مَناقِبٌ عَجرُ مَن رامَ اللَحاقَ بِها","كَعَجزِ مَن رامَ أَن يُحصي لَها عَدَدا",37,"د",2,0],["مَناقِبٌ عَدَدَ الأَنفاسِ ما تَرَكَت","لِفاخِرٍ مِن جَميعِ الناسِ مُفتَخَرا",38,"ر",2,0],["مَناقِبُ لَو تَنالُ الشَمسُ أَدنى","مَداها ما دَنَت مِنها الأَصائِل",39,"ل",1,0],["مَناقِبٌ في أَقاصي الأَرضِ قَد شُهِرَت","فَما اِعتَرى مُطنِباً في وَصفِها خَجَلُ",40,"ل",1,0],["مَناقِبٌ لَم يَفُز غَيرُ الحُسَينِ بِها","حَتّى لَخِلناكَ قَد ساهَمتَهُ الشِيَما",41,"م",2,0],["مَناقِبٌ لَيسَ تُحصى خَصَّ مَفخَرُها","بَني أَبيكَ وَعَمَّ الناسَ كُلَّهُمُ",42,"م",1,0],["مَناقِبٌ لَكَ لَو فازَ المُلوكُ بِها","لَصَيَّروها عَلى التيجانِ تيجانا",43,"ن",2,0],["مُناقِضاً لَهُمُ في الأَرضِ تُبدِلُها","بِالخَوفِ أَمناً وَبِالإِخرابِ عُمرانا",43,"ن",2,0],["مناقب مختاريّة قادريّة","تسامت وعباسيّة مجدها احتوى",44,"و",2,0],["مَناقِبُهُ كالشُهبِ وَالتُربِ وَالحَصى","وَأَضعافِها وَالأَمرُ أَعلى وأَفخَمُ",45,"م",1,0],["مَناقِبُهُ لا وَصمَ فيها لِمَن لَصا","عَجائِبُهُ كالتُربِ وَالشُهبِ وَالحَصى",46,"ص",2,0],["مَناقِبُهُ فاتَت مَدى كُلِّ مُستَقصِ","دَعِ القَولَ في ذِكرِ الغَزالِ وَوَصفِهِ",47,"ه",1,0],["مَناقبٌ دونَها الأَزهارُ مُسفِرَةٌ","عَن مِثلِها جَلِّيَتْ زَهواً أَقاحيها",48,"ي",3,0],["مَناقبُ جَلَّتْ أنْ تكون لواحدٍ","وما اسملحتْ منها الورى قبلَه صِنْفا",49,"ف",2,0],["مَناقبٌ خَصَّك الفضلُ العَميم بها","وكلُّ ما لم يكن في الطبع لم يَدُم",50,"م",1,0],["مناقبه لم يحص في العقل عدها","ولس لها حد وليس لها حصر",51,"ر",1,0],["مَناقِبُ إن عُدَّت تَضَوَّعُ بَينَنا","كَأنّا اتَّخَذنا ساحةَ