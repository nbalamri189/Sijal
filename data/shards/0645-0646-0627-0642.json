],[186,"سل الخيل والسمر الذوابل والوغى","https://www.aldiwan.net/poem14593.html","الطويل"],[186,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[211,"كفاني حزنا أن أضر بي الهجر","https://www.aldiwan.net/poem13494.html","الطويل"],[226,"تدفق دموعا أو دما أو قوافيا","https://www.aldiwan.net/poem55094.html","الطويل"],[251,"متى تبلغ النفس المشوق سؤالها","https://www.aldiwan.net/poem15077.html","الطويل"],[262,"ما راعني الليل ولا السبسب","https://www.aldiwan.net/poem38366.html","السريع"],[268,"جاءوا معاً فيلقاً جأواء مشعلة","https://www.aldiwan.net/poem1139.html",""],[272,"كل شيء منكم عليكم دليل","https://www.aldiwan.net/poem52133.html","الخفيف"],[276,"بشر بأمن الله من خافا","https://www.aldiwan.net/poem25391.html","السريع"],[276,"قضى صادق الآثار في أمرك الأرضى","https://www.aldiwan.net/poem25491.html","الطويل"],[281,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[281,"يد لك عندي لا تؤدى حقوقها","https://www.aldiwan.net/poem60779.html","الطويل"],[283,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[298,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[305,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[323,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[354,"هيجت أشجان صب للربوع هفا","https://www.aldiwan.net/poem40141.html","البسيط"],[354,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[354,"هناء وإسعاد وعز مؤبد","https://www.aldiwan.net/poem40402.html","الطويل"],[372,"سقيم نهاه سقم جفنيه أن يسلو","https://www.aldiwan.net/poem57172.html","الطويل"],[372,"منيتها تفرق من عاذلي","https://www.aldiwan.net/poem57221.html","الكامل"],[372,"رأى الورد من خديه يحتمل المحلا","https://www.aldiwan.net/poem57230.html","الطويل"],[372,"سهرت اهتماما بالعيون السواهر","https://www.aldiwan.net/poem57388.html","الطويل"],[372,"فيما يقال مقيم قيل قد سارا","https://www.aldiwan.net/poem57428.html","البسيط"],[372,"إن الهوى المجحودا","https://www.aldiwan.net/poem57497.html","المجتث"],[372,"رضيت بمعصية العاتب","https://www.aldiwan.net/poem57529.html","المتقارب"],[372,"أرته الليالي كل مستقبل ذاهب","https://www.aldiwan.net/poem57531.html","الطويل"],[378,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[417,"بشراك في نجل نجيب بدا","https://www.aldiwan.net/poem53929.html","السريع"],[417,"متى يشتفي كبد مؤلم","https://www.aldiwan.net/poem53957.html","المتقارب"],[417,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[417,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[417,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[417,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[417,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[433,"كم نابل في طرفيك البابلي","https://www.aldiwan.net/poem12697.html","السريع"],[438,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[438,"ها قد بلغت الذي قد كان ينتظر","https://www.aldiwan.net/poem2614.html","البسيط"],[440,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[440,"بفتح الفتوح وسعد السعود","https://www.aldiwan.net/poem34864.html","المتقارب"],[440,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[440,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[459,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[459,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[459,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[462,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem16421.html","الوافر"],[464,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[505,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[515,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[516,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[516,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[516,"سجوداً فهذا صاحب الركن والحجر","https://www.aldiwan.net/poem12107.html","الطويل"],[516,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[530,"أتى منك يا فخر الأوان وزينة","https://www.aldiwan.net/poem37453.html","الطويل"],[563,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[576,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"],[576,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[576,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"],[588,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"]],"verses":[["مُناقِلَةً تَنجو بِزَجرَةِ غَيرِها","وَتَرهَبُ سَوطَ المَرءِ راعَ سِواها",0,"ا",3,0],["مُناقِلٌ في عِنانِ الريحِ جَريَتُهُ","كَأَنَّهُ قَبَسٌ أَو بارِقٌ عَمِلُ",1,"ل",1,0],["مِن أَقاحٍ غُمِسنَ في البارِدِ العَذ","بِ طَويلاً وَمِن قَضيبٍ قَضيفِ",2,"ف",1,0],["مَن أَقسَموا بِأَلزَمِ الأَقسامِ","بِأَن يُقَضّوا دَولَةَ الظَلامِ",3,"م",1,0],["مُناقِلَةً عُرضَ الفَيافي شِمِلَّةً","مَطِيَّةَ قَذافٍ عَلى الهَولِ مَبعَدِ",4,"د",1,0],["مَنَاقِبٌ أَبْرَزَتْكَ مِنْ شَرَفٍ","عَالٍ وَأَذِكَتْ نُوراً عَلَى عَلَمِ",5,"م",1,0],["مناقبُ تسمو للفخار كأنما","تجاريّ إلى المجد النجوم الجواريا",6,"ي",2,0],["مناقب كنجوم الليل مُشرقةً","تَهدي إلى المجد في أنوارها الأمما",7,"م",2,0],["مناقبٌ يهتدي وفدُ الثنا لها","بواضحٍ من ضياءِ البدر منبلج",8,"ج",1,0],["مناقب شاعت في الورى علوية","فكلهمُ فيها يشيّع من عذر",9,"ر",1,0],["من أقرض الأوقاتَ أتلفَها","وقضى جميعَ قُرُوضِها جسَدُهْ",10,"د",2,0],["من أقدم الناس ولكنما","إقدامه تضييعه حِذرَهْ",11,"ر",2,0],["من أقبح الناس لا أُحاشِي","من كان منهم ومن يكونُ",12,"ن",1,0],["مَناقِبُ شَتّى لَو تَكونُ لِحاجِبٍ","لَما ذَكَرَت يَوماً لَهُ القَوسَ خِندِفُ",13,"ف",1,0],["مَنِ اِقتَضى بِسِوى الهِندِيِّ حاجَتَهُ","أَجابَ كُلَّ سُؤالٍ عَن هَلٍ بِلَمِ",14,"م",1,0],["مَناقِبُ لا يَزالُ الشِعرُ فيها","طَوالَ الدَهرِ في شُغلٍ جَديدِ",15,"د",1,0],["مناقبٌ يَنطوي الحَسودُ لها","على جَوىً أو يُميتُه حَسَدُه",16,"د",2,0],["مناقبُ تملأُ الحُسَّادَ غَيْظاً","وتُغْني الطَّالبينَ عن الطِّلابِ",17,"ب",1,0],["مَناقِبُ مَعروفُها تالِدٌ","مُحَمَّدُ أَورَثَها مِن عَلي",18,"ل",2,0],["مَناقِبُ مِلءَ الدَهرِ أَربى عِدادُها","فَقُل لِبَني التاميزِ عُدّوا المَخازِيا",19,"ي",2,0],["مَنَاقِبُ ما يزالُ لها طُلوعٌ","إذا الأقمارُ أدركها الأُفُولُ",20,"ل",1,0],["مَناقِبُ للدنيا العريضةِ هِزَّةٌ","إذا ذُكِرتْ فَلْيَشدُ من كان شاديا",21,"ي",2,0],["مَناقِبٌ فيها جَمالُ الصِّبا","وهْيَ لِداتُ الدهرِ أو أقْدَمُ",22,"م",1,0],["مِن أقصرِ الأَجزاء والشُّطورِ","حُروفُه عشرونَ في التَّقديرِ",23,"ر",1,0],["مناقب ما تولى الخبر أحرفها","إلا حسبت على عطف العلى خبره",24,"ر",2,0],["مَنَاقِبٌ كَمْ أَحَلَّتْ مُسْتَضَاماً","بِهِ الأَيَّامُ ضَاقَتْ فِي رِحَابِ",25,"ب",1,0],["مَناقِبُ قَد أَضحى بِها الدَهرُ حالِياً","فَها عِطفُهُ مِنها مُوَشّىً مُوَشَّحُ",26,"ح",1,0],["مَناقِبُ لَم تُدرَك بِكَيدٍ وَلَم تُنَل","بِشَيءٍ سِوى حَدِّ القَنا الذَرباتِ",27,"ت",1,0],["مناقب لو رأتها الشمس لانحجت","دهشا ولو انها في دارة الحمل",28,"ل",1,0],["مناقب لاحت كالنجوم ورفعة","تسامت فما ابقت مجالا لصاعد",29,"د",1,0],["مناقبه الجليلة في البرايا","لها في كل زاوية اريج",30,"ج",1,0],["مناقب كالبدور زاهرة","وخارقات من دونها الشهب",31,"ب",1,0],["مَن أقَامَ الصَّفَا ورَاضَ الحَرونَ الص","صَعبَ وأستسهل الخطوبَ الصِّعابَا",32,"ب",2,0],["مناقِبُهُ مثلُ الكواكِبِ كثرةً","ونُوراً ألا اللَهِ تلكَ المناقِبُ",33,"ب",1,0],["مناقبُ مثلُ عِدادِ الرمالِ","تكُدُّ أناملَ حُسّابها",34,"ب",3,0],["مَناقِبُ قَد خَصَّت نِزارَ يَزينُها","مَواهِبُ قَد عَمَّت نِزارَ وَيَعرُبا",35,"ب",2,0],["مَناقِبُ لَو أَنَّ اللَيالي تَوَشَّحَت","بِأَذيالِها لَاِبيَضَّ مِنهُنَّ ما اِسوَدّا",36,"د",2,0],["مَناقِبٌ عَجرُ مَن رامَ اللَحاقَ بِها","كَعَجزِ مَن رامَ أَن يُحصي لَها عَدَدا",37,"د",2,0],["مَناقِبٌ عَدَدَ الأَنفاسِ ما تَرَكَت","لِفاخِرٍ مِن جَميعِ الناسِ مُفتَخَرا",38,"ر",2,0],["مَناقِبُ لَو تَنالُ الشَمسُ أَدنى","مَداها ما دَنَت مِنها الأَصائِل",39,"ل",1,0],["مَناقِبٌ في أَقاصي الأَرضِ قَد شُهِرَت","فَما اِعتَرى مُطنِباً في وَصفِها خَجَلُ",40,"ل",1,0],["مَناقِبٌ لَم يَفُز غَيرُ الحُسَينِ بِها","حَتّى لَخِلناكَ قَد ساهَمتَهُ الشِيَما",41,"م",2,0],["مَناقِبٌ لَيسَ تُحصى خَصَّ مَفخَرُها","بَني أَبيكَ وَعَمَّ الناسَ كُلَّهُمُ",42,"م",1,0],["مَناقِبٌ لَكَ لَو فازَ المُلوكُ بِها","لَصَيَّروها عَلى التيجانِ تيجانا",43,"ن",2,0],["مُناقِضاً لَهُمُ في الأَرضِ تُبدِلُها","بِالخَوفِ أَمناً وَبِالإِخرابِ عُمرانا",43,"ن",2,0],["مناقب مختاريّة قادريّة","تسامت وعباسيّة مجدها احتوى",44,"و",2,0],["مَناقِبُهُ كالشُهبِ وَالتُربِ وَالحَصى","وَأَضعافِها وَالأَمرُ أَعلى وأَفخَمُ",45,"م",1,0],["مَناقِبُهُ لا وَصمَ فيها لِمَن لَصا","عَجائِبُهُ كالتُربِ وَالشُهبِ وَالحَصى",46,"ص",2,0],["مَناقِبُهُ فاتَت مَدى كُلِّ مُستَقصِ","دَعِ القَولَ في ذِكرِ الغَزالِ وَوَصفِهِ",47,"ه",1,0],["مَناقبٌ دونَها الأَزهارُ مُسفِرَةٌ","عَن مِثلِها جَلِّيَتْ زَهواً أَقاحيها",48,"ي",3,0],["مَناقبُ جَلَّتْ أنْ تكون لواحدٍ","وما اسملحتْ منها الورى قبلَه صِنْفا",49,"ف",2,0],["مَناقبٌ خَصَّك الفضلُ العَميم بها","وكلُّ ما لم يكن في الطبع لم يَدُم",50,"م",1,0],["مناقبه لم يحص في العقل عدها","ولس لها حد وليس لها حصر",51,"ر",1,0],["مَناقِبُ إن عُدَّت تَضَوَّعُ بَينَنا","كَأنّا اتَّخَذنا ساحةَ الرَوضِ نادِيا",52,"ي",2,0],["مناقبةُ تُربى على الرَّملِ والحَصَى","وراحتُه أزرَت بكلِّ غَمامِ",53,"م",1,0],["مناقب تفحم طلابها","كم مطلب عز فما يطلب",54,"ب",1,0],["من اقتراها قرت كفاه حتفهما","أو اجتلاها بدا منها له عِبَرُ",55,"ر",1,0],["من أَقام السَماء سَقفا رَفيعا","يَرجع الطرف عنه وَهُوَ كَليل",56,"ل",1,0],["من أقرض اللّه مطيعا له","جازاه أضعافا وأضعافا",57,"ف",2,0],["مَناقِبُهُ غَنَّى القَريضُ بِوَصْفِها","وَهَيْهَاتَ جَلَّتْ أن يُوَفِّيَهَا قَرْضَا",58,"ض",2,0],["مَناقِبُ يُنْسِيكَ الْقَدِيمَ حَدِيثُها","وَيَخْجَلُ صَدْرُ الدَّهْرِ فِيها بِعُقْبِهِ",59,"ب",2,0],["مَناقِبُ إِنْ تُنْسَبْ فَأَنْتَ لَها أَبٌ","وَعَليْاءُ إِنْ عُدَّتْ فَأَنْتَ شَقِيقُها",60,"ق",3,0],["مَناقِبُهُ لَم يُحصِها ذو بَلاغَةٍ","وَهَل أَحَدٌ يُحصي مِنَ البَحرِ رَملَهُ",61,"ل",2,0],["من اِقتفاهُ أَغاثَتهُ صحائفُه","وَمَن أَباهُ أَبادَته صفايحُهُ",62,"ح",2,0],["مناقشة وتفتيش فإما","مصير للنعيم او النكال",63,"ل",1,0],["مَناقِبُ الخَيرِ أَنتَ وارِثُها","وَالحَمدُ ذُخرٌ تُغلي بِهِ رَبِحُ",64,"ح",1,0],["مَناقب فيهِ قَد عزّت مَراتبها","دَعا صَريف بَني الدُنيا بِها خَزَفا",65,"ف",2,0],["مَناقب كَالرَوض الأَريض نَضارَةً","تَسامَت عَن التَشبيه بَل هِيَ أَنضَرُ",66,"ر",1,0],["مَناقبهُ آيات حَقٍّ عَلى المَلا","متى تُليت كادَت لَها الهام تسجدُ",67,"د",1,0],["مَناقِبُ يا ابنَ اللَّيثِ ضاقَت على امرئٍ","يُحاوِلُها من حَيثُ حاوَلَها الشِّبلُ",68,"ل",1,0],["مَناقِب أَمكَن مَن لَم يكُن","إِلى اختِزانِ المالِ بالمائِلِ",69,"ل",1,0],["مَناقِبُ في الدُّنيا وَفي الدِّينِ حَملُها","ثَقيلٌ عَلَى مَن لَم يُعوَّد لَها حِملا",70,"ل",2,0],["مناقِبُ تُحيي مُلهماً وتَحثُّه","على سفرٍ فاعجَب لميتٍ مسافِرِ",71,"ر",1,0],["مناقبٌ تبهرُ الأقوالَ عدَّتها","قد أعجزَت خُطباً منها وأَشعارا",72,"ر",2,0],["مناقبٌ لك كلَّف","نَ حملهنَّ القَصيدا",73,"د",2,0],["مناقبُ جاء بها خلقةً","مسلَّمةً من يدِ العائبِ",74,"ب",1,0],["مناقبُ ألقاها عليَّ عطاؤه","فقلت انتظِرني ألتمس عاقداً حاسِب",75,"ب",1,0],["مناقبُ شتى لو عددتَ صفاتها","لفاتك أشيا لا تعدُّ وتوصف",76,"ف",1,0],["مناقبُ الآباء تحيى به","والسَّادة الغرُّ الكرام الأُوَلْ",77,"ل",1,0],["مناقبُ محمود محمودةٌ","وفوق جباه العُلى تُرقَمُ",78,"م",1,0],["مَناقِبُك النجومُ وليس بِدْعاً","إذا ما أَنكرتها عينُ أَعمى",79,"م",2,0],["مناقب تزهو بالمكارم كلُّها","وتُشْرِقُ من أنواره بوضاء",80,"ا",2,0],["مناقبُ في المعالي أورِثوها","عن الآباء منهمْ والجدود",81,"د",1,0],["مناقب إحسانٍ حسانٌ ضوامِنٌ","لعلياك أن تثني عليك وتحمدا",82,"د",2,0],["مناقبك التي مثل الدراري","نظمت بها لجِيدِ الدهر عقدا",83,"د",2,0],["مناقبٌ قد نُظِمَتْ حِليةً","على صدورِ الزمنِ العاطلِ",84,"ل",1,0],["مناقب يعجز عن حصرها","بنظم المديح ونثر الخطب",85,"ب",1,0],["مناقب حسنت أخبارها وزهت","حتى لقد صار مهجوراً بها السمر",86,"ر",1,0],["مناقِبُ يَعْيا الوَصْفُ عَنْ كُنْهِ قَدْرِها","ويَرْجِعُ عَنْها الوَهْمُ وَهْوَ حَسِيرُ",87,"ر",1,0],["مَناقِبُهُمْ لِصُدُورِ الدُّهُورِ","عُقُودٌ نُظِمْنَ نظامَ الفَرِيدِ",88,"د",1,0],["مَناقِبُ أَدَّوْها إِلَيْهِ وِرَاثَةً","فكانَ لَهَا صَدْراً وكانتْ لَهُ حَلْيا",89,"ي",2,0],["مَناقِبُ سارَتْ فِي مَعالِمِ كُنْهِها","عُقولُ بَني الدُّنيا وَمَا حُدَّ حدُّهُ",90,"د",2,0],["مناقبٌ تَفتُقُ ما رقَّعتمُ","من بأس عمرو وسماح حاتمِ",91,"م",1,0],["مناقلاً بأربعٍ كأنّما","يلاطم الجليدَ منها جَلْمَدُ",92,"د",1,0],["مناقبٌ يجمعنا مجدها","جمعَ العُرَى في عُقَدات الرِّشا",93,"ا",1,0],["مَناقِبُ دون غايتِها الثُّرَيَّا","بغَيْرِكَ لا تُنالُ ولا تُرامُ",94,"م",1,0],["مناقبهم بحور زاخرات","عماق مالها طرف وسيف",95,"ف",1,0],["مناقبه للمعضلات محلة","مدايحه للملهمات مصادر",96,"ر",1,0],["مَناقِبُ فخرٍ حُزْتَها يا اِبنَهُ","وحسبُكَ فخراً ما به من شَمائِلِ",97,"ل",1,0],["مناقب كالنجوم الزهر قد ملئت","بحسن أوافها الأسماع والكتب",98,"ب",1,0],["مناقب سجلت لي وهي صادقة","أمان صدق من التخريف والكذب",99,"ب",1,0],["مناقب وضاح الأسرة ولم يزل","على وجهه نور الطلاقة والبشر",100,"ر",1,0],["مناقب يا ذخر الأئمة أصبحت","إليهن أعناق الثناء تمال",101,"ل",1,0],["مناقِبُ لُطْفِ اللهِ جَلَّتْ فَمَنْ غَدَا","يُرَدِّدُها جَهْلاً بِها بَطَلَ الرَّدُّ",102,"د",1,0],["مِن أقاصي الدُّنيا إلى الحَرَم الأَق","صَى بِكَ اللهُ أيُّها البَدرُ أسرَى",103,"ر",2,0],["من أَقْبلَ الدِّينُ في إِقبالِ دوْلته","شوقاً إِليه وفرَّ الكفرُ من فَرق",104,"ق",1,0],["من أَقَرَّت له الملوكُ وقَالَتْ","هُو سُلطَانُنا ونَحْن عَبيدُه",105,"د",2,0],["مناقبُ سارَتْ عنه وانْتَسَبَتْ له","فسرَّت وَلِيّاً فيه أَو كَتَبَتْ ضِدّاً",106,"د",2,0],["مناقبهم لا يحصها النظم عدةً","وليس يواريها غطاء المعاديا",107,"ي",2,0]]}