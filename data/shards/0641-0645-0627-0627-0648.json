{"poems":[[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[107,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9879","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[164,"خذوا لي من سمر القدود أمانا","https://www.aldiwan.net/poem58947.html","الطويل"],[164,"بليت بكل أمعة جهول","https://www.aldiwan.net/poem59082.html","الوافر"],[190,"إذا صح لي قوت السنانير بكرة","https://www.aldiwan.net/poem43866.html","الطويل"],[234,"إذا لم تعرف الخيرا","https://www.aldiwan.net/poem51010.html","الهزج"],[240,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[266,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[275,"قضى الدهر أن أهواك غير ممتع","https://www.aldiwan.net/poem35621.html","الطويل"],[354,"ولو لم تبد لي منك","https://www.aldiwan.net/poem16026.html","الهزج"],[370,"ألم تأرق لذا البرق اليماني","https://www.aldiwan.net/poem44388.html","الوافر"],[415,"إليك فما تثني شؤونك شاني","https://www.aldiwan.net/poem32160.html","الطويل"],[422,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[466,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[510,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[510,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[580,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122588","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137715",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48558","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101044","الوافر"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105077","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204974","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45764","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117977","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131092",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70166","الوافر"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[592,"أدم بالعوال يالطن في الضدان جدا","https://www.poetsgate.com/ViewPoem.aspx?id=128845",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5809,"عازف الليل","https://www.poetsgate.com/ViewPoem.aspx?id=205359",""],[5956,"أجيبي جواباً يثيرُ اْلتذاذا","https://www.poetsgate.com/ViewPoem.aspx?id=182220",""]],"verses":[["فَما أَومَأوا بِصُدورِ الرِماحِ","يَوماً إِلى القِرنِ إِلّا تَردى",0,"د",2,0],["فَمَا أُودٌ بأكثَرَ مِن قَلِيل","ومَا أُودٌ بأَطيَبِ أَخبَثِينَا",1,"ن",2,0],["فما أؤمِّلُ إلا طولَ مُدته","أطالها اللَّه حتى يُرغمَ الأجلا",2,"ل",2,0],["فَما أَوفَتْ على النَّهريْنِ حتَّى","تخَطَّفَها الهَوى فَهوتْ رُكاما",3,"م",2,0],["فَما أَوقَدوا ناراً وَلا دَلَّ سارِياً","عَلى حَيِّ تَيمٍ مِن صَهيلٍ وَلا هَدرِ",4,"ر",1,0],["فَما أَوهى مِراسُ الحَربِ رُكني","وَلَكِن ما تَقادَمَ مِن زَمانِ",5,"ن",1,0],["فَمَا أُوتِيتِ مِنْ نَعْمَاءَ إِلاَّ","تَقَاسَمَهَا عُفَاتُكِ كالنِّهَابِ",6,"ب",1,0],["فما أوسع الدنيا وأسرع أخذه","وأثبت ممن مال عنه جنانا",7,"ن",2,0],["فما آوى إلى فرش بليل","ولا أصغي النهار إلى مقيل",8,"ل",1,0],["فماأوقع الإنسان في الخوف كالغنى","ولا أوقع الإنسان في الأمن كالفقر",9,"ر",1,0],["فما اَوْلَى بك الموتَ","وما أَوْلَى بك القَبْرا",10,"ر",2,0],["فَما أَوضَعَت إِلّا إِلَيكَ رَكائِبي","وَلا وُضِعَت إِلّا لَدَيكَ حُمولي",11,"ل",2,0],["فما اوردوها من اصم واشهب","وعادت بهم إلا معصفرة شقرا",12,"ر",2,0],["فما أوجد الإخوانُ والأخواتُ في","مماتِ الذي قد كان بهجةَ أربُع",13,"ع",1,0],["فَما أَوجَدَني فيكَ","وَما أَفقَدَني فِيَّ",14,"ي",1,0],["فما أَوهى مِراسُ الحربِ رُكني","ولكن ما تقادَمَ مِن زَماني",15,"ن",2,0],["فما أوهَنَتْ عظمي الرَّزايا ولا لَها","بحُسنِ اصطباري في المُلِمِّ يَدانِ",16,"ن",1,0],["فما أوْلَعَ الأَيَّام في جهلائها","وفي النَّاس أشباه لها وشكول",17,"ل",1,0],["فما أوفوا بموعود","ولا بالوا بما يحكى",18,"ا",1,0],["فما أوجدتني الخمرُ غير تخمُّطٍ","ولا هازلُ الأقْوالِ غيرَ إباءِ",19,"ا",2,0],["فما أُورثتُ أصنامَ ثمود","وما بجَّلتُ نجماً أو رأيتُ",20,"ت",1,0],["فما أُوذي انسيٌّ","كما أُوذي مُذ كانا",21,"ن",2,0],["فما أَوْحَش المصرَ كنتَ أُنْسَه","أَسَرَّ زَمَاناً وحدَه ثم أَعْلَنا",22,"ن",2,0],["فما أوحشَ الدنيا وأنكدَ عَيشها","وما عَيشُها لَو سالمتك بأنكد",23,"د",1,0],["فما أوجد المال كي يخزنا","ونجني في مجتناه العنى",24,"ن",2,1],["فما أوردونا الماء إلا مكدَّراً","وما أصدرونا عنه إلا صواديا",25,"ي",2,0],["فما أوفى على العشرين حتى","شهدنا من عظائمه عظاما",26,"م",2,0],["فما أوقع الدهر من قبلها","ولا برقع الدهر من بعدها",27,"د",3,0],["فما أوقفت سيري العراقيل جمة","ولا أوهنت نفساً ولا ثبطت عزما",28,"م",2,0],["فَما أَوجد الرَحمن مِثلك في الوَرى","وَمِن كُل ذا جاه عَلا كانَ أَجوَدا",29,"د",2,0],["فما أولاه منك بطيب وصل","يتم به له ولك المراما",30,"م",2,0],["فما أولع الحسناء بالنأي والقلى","وما أولع المضنى المتيم بالوجد",31,"د",1,0],["فَما اوضحت مِمّا أَنتَ جامع","مِن الأَوصاف الّا ما يضارع",32,"ع",1,0],["فَمَا أوحشَت مِنهُ لَعَمرِيَ أَربُعٌ","تحلَّت بِهِ بل أَوحشت مِنهُ أَضلُعُ",33,"ع",1,0],["فما أوهن الأعدى سوى البيض والقنى","وصيرهم الأبها آلة جندا",34,"د",2,0],["فما أومض البرق اللموع برامة","فأنشأ الأمن مدامعنا المزنا",35,"ن",2,0],["فماأوجعَ الذكرى اذا ماتعوَّدَتْ","على وتَرِ الأشواقِ بالليلِ تعزفُ",36,"ف",1,0],["فما أوجد الله شيئا بدون","مُضادٍّ له إنْ بِهذا وهذا",37,"ذ",2,0]]}