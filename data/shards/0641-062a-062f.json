{"poems":[[77,"أما وخيال في المنام يزور","https://www.aldiwan.net/poem36492.html","الطويل"],[77,"ألحظك أم سيف عمرو أعيدا","https://www.aldiwan.net/poem36612.html","المتقارب"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[27,"لما دعا الداعي لأعين لم تكن","https://www.aldiwan.net/poem5784.html","الطويل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[72,"ومضروبة من غير جرم وربما","https://www.aldiwan.net/poem19021.html","الطويل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"قد يفي للصديق غير أمينه","https://www.aldiwan.net/poem66405.html","الخفيف"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[66,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"عيينة أمسكت العجوز تريدها","https://www.aldiwan.net/poem44035.html","الطويل"],[21,"وبفرعون إذا تشاق له","https://www.aldiwan.net/poem36209.html","الخفيف"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85548","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[77,"ألحظك أم سيف عمرو أعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=33540",""],[100,"حوار جارين","https://www.poetsgate.com/ViewPoem.aspx?id=50201",""],[116,"غلب الوجد حشمة النماك","https://www.aldiwan.net/poem40863.html","عموديه"],[129,"سمعا وطوعا للإمام","https://www.aldiwan.net/poem50606.html","مجزوء الكامل"],[129,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[130,"ذكر الطائر الرياض فغنى","https://www.aldiwan.net/poem67452.html","البسيط"],[144,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[151,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[151,"أغيب وعندي بالوفاء حضور","https://www.aldiwan.net/poem68491.html","الطويل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[212,"ما الذي أنكرت مني","https://www.aldiwan.net/poem46347.html","مجزوء الرمل"],[222,"أيسديك أولى الناس بالطيش حكمة","https://www.aldiwan.net/poem55279.html","الطويل"],[236,"يا جلال الدين يا ملكا","https://www.aldiwan.net/poem31800.html","المديد"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[276,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[286,"هذه آثارنا فادع لنا","https://www.aldiwan.net/poem39385.html","الرمل"],[305,"قد كفاني علم ربي","https://www.aldiwan.net/poem16762.html","مجزوء الرمل"],[306,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[321,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[365,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[381,"يا من تناءت داره","https://www.aldiwan.net/poem48797.html","مجزوء الكامل"],[392,"رب يا عالم بحالي يا عليم","https://www.aldiwan.net/poem54508.html","عموديه"],[404,"إذا جاء طوفان المعارف والذكا","https://www.aldiwan.net/poem33659.html","الطويل"],[404,"يا رفاقا حلوا بأكناف صنعا","https://www.aldiwan.net/poem33687.html","الخفيف"],[407,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[417,"ليهنك ما بلغت من الأماني","https://www.aldiwan.net/poem54133.html","الوافر"],[430,"بسم السرور فسرت الأحياء","https://www.aldiwan.net/poem40833.html","الكامل"],[430,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[433,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[442,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[444,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[450,"شارون عربد","https://www.aldiwan.net/poem991.html",""],[469,"ماذا رميت به من","https://www.aldiwan.net/poem59755.html","المجتث"],[494,"غادني بالصبوح قبل الصباح","https://www.aldiwan.net/poem67400.html","الخفيف"],[496,"نظري لهذا العيش كيف مزاجه","https://www.aldiwan.net/poem9805.html","الكامل"],[501,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[501,"وطد فؤادك كلنا عشاق","https://www.aldiwan.net/poem37944.html","الكامل"],[501,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[501,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[539,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"],[559,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[576,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"]],"verses":[["فتُدْرَكُ آمالٌ وتُقْضى مآرِبٌ","لديّ وتُشْفى باللّقاءِ صُدورُ",0,"ر",1,0],["فتُدْخِلُني للرّضى جنّةً","وتُصْلي حَسودي ناراً وَقودا",1,"د",2,0],["فَتَدَفَّقوا حُجَجاً وَحوطوا نيلَكُم","فَلَكَم أَفاضَ عَلَيكُمُ وَتَدَفَّقا",2,"ق",2,0],["فَتُدرِكَ وِتراً يا اِبنَ قَينِ مُجاشِعٍ","فَتَحيا كَريماً أَو تَموتَ فَتُعذَرا",3,"ر",2,0],["فَتَدَلَّيتُ عَلَيهِ قافِلاً","وَعَلى الأَرضِ غَياياتُ الطَفَل",4,"ل",1,0],["فَتَدارَكَ الإِشراقُ باقِيَ نَفسِهِ","مُتَجَرِّداً كَالمائِحِ العُريانِ",5,"ن",1,0],["فتدخل فيه رأسها قبل رجلها","وتخرج منه رجلها قبل رأسها",6,"س",3,0],["فَتُدَرَّعُ اليومَ القصيرَ بأُنْسِهِمْ","وتُعَمَّرُ العمْرَ الطويل مُصَحَّحا",7,"ح",2,0],["فتداعتْ تداعِيَ القَوْمِ في الثَّل","لَة للَّيث طالعاً من عرينه",8,"ن",2,0],["فَتَدَفَّقَتْ فيهِ الدُّمُوعُ","بصَوبِها المُتَهاطِلِ",9,"ل",1,0],["فَتَدَفَّقَتْ لَحْناً يُرَدِّدُهُ","على سَمْعِ الدُّهُورْ",10,"ر",1,0],["فَتَدانى بِالرُخِّ بيتاً وَأَجرى","خَيلَهُ بَينَ مُلتَقى الصَفَيّنِ",11,"ن",1,0],["فَتُدَبِّرُ الأَفلاكَ سَبعَةُ أَجنُمٍ","وَيُدَبِّرُ الأَرضَينَ نَجمٌ واحِدُ",12,"د",1,0],["فَتَدفَّعا يستهلكانِ على الصِّبى","نفْسَينِ تزدادان طولَ بقاءِ",13,"ا",2,0],["فَتدافعتْ طَوْعَ العواصفِ ترتدِي","هَبَواتِ كلِّ سفيهةٍ هَوجاءِ",13,"ا",2,0],["فَتَدعوه أقْبِلْ لستُ فيها بِرَاغبٍ","إذا بَلَغَ الأمرُ الفِداءَ الميَسَّرا",14,"ر",2,0],["فَتَداعى عَلَيهِم المَوجُ حَتىّ","صارَ موجاً وَراءَهُ مُستَطيرا",15,"ر",2,0],["فَتَدارَكوا جُزُرَ الخِلا","فَةِ وَهيَ شاسِعَةُ النَظيرِ",16,"ر",1,0],["فتدوي السماء في السمع من تس","بيحهم مثلما يدوي القفير",17,"ر",1,0],["فتدرعي للخطب صبراً وامسحي","من أَدمع فوق الخدود سجام",18,"م",1,0],["فَتَدَافَعَتْ نَحْوَ الشَّفِيرِ وَمَا لَهَا","لَوْنٌ سِوَى لَوْنِ القُنُوطِ الشَّاحِبِ",19,"ب",1,0],["فتدخلني للرضا جنة","وتصلي حسودي نارا وقودا",20,"د",2,0],["فتدانى من جاره ورآه","مثلما ينظر الفقير النضارا",21,"ر",2,0],["فتداعوا بعد التمكن صرعى","وتراهم ما بين باك وشاك",22,"ك",1,0],["فتدارَك الخلقَ الإما","مُ بعون رب مُقْتَدِر",23,"ر",1,0],["فتدبَّروا آياتِها وتفكَّرُوا","فهي الدَّواءُ وللقلوبِ جلاءُ",24,"ا",2,0],["فتداعت حَواجزُ السِّجنِ والظُّلمةِ","واليأس حولَه واطمأنا",25,"ن",2,0],["فَتَدارَك حُشاشَةً لَم تَدَع مِن","ها صُروفُ الزَمانِ إِلّا ذَماءَ",26,"ا",2,0],["فتدرّعوا ثوب الفرار مذلة","فأسل بهم أقصى دروب الشام",27,"م",1,0],["فَتُدرَكُ آمال وتُقضَى مآربٌ","وتحدث من بعد الأُمور أمور",28,"ر",1,0],["فَتُداوي سَوداءَ قَلبٍ مُحِبٍّ","أَثَّرت فيهِ عَينُها الزَرقاءُ",29,"ا",2,0],["فَتَداعَوا إِلى الفرارِ وفرّوا","وَلهُم خشيةَ الأسودِ عواءُ",29,"ا",2,0],["فَتداركهُ قبلَ أن تَخطُرَ الأخ","طارُ فاليومَ مسّه الإعياءُ",29,"ا",2,0],["فتدلّل وتمنّع","واحتكم كيف تشاء",30,"ا",2,0],["فتدفعنا نفس إلى الخير والتقى","وتدفعنا الأخرى إلى الشر عنوة",31,"ه",1,0],["فَتَدارَك قِصَّتي فَعَلى","يَدِكَ المَبسوطَةِ الدَرَكُ",32,"ك",1,0],["فتدلَّهت بَغدادُ بينَ نخيلها","ثكلى لِطيفِ حَبيبها إلمام",33,"م",1,0],["فَتَدْبيرُهُ في حالَةِ السِّلْمِ نَاجِعٌ","وَتَشْميرُهُ في حالَةِ الحَرْبِ نَافِعُ",34,"ع",1,0],["فتدبرها أخا الفهم وقم","بدياجي الليل واجه كالبطل",35,"ل",1,0],["فَتَدارَكَني بِلُطفٍ","مِنكَ يا مَولى المَوالي",36,"ي",1,0],["فَتَدارسوه لِما عَلمتم بينكم","عَوداً على بدء بغير توانِ",37,"ن",1,0],["فَتَدومُ مَشكورَ المَواهِبِ مُصطَفى","وَلَكَ الثَناءُ طَريقُهُ وَتَليدُهُ",38,"د",2,0],["فتَداومَا أبداً حَليفَيْ رِفْعةٍ","ما تَأْمُرا يُعْطِ الزَّمانُ ويمنَع",39,"ع",1,0],["فَتدفقت أَنهارُهُ","وَتَرَنَمَت أَطيارهُ",40,"ر",2,0],["فتداركني إلهي سيدي","واشفني إن عليل وسقيم",41,"م",1,0],["فتدمى بها الآذان عند ازدحامها","فيغسلها ما فاض منها من الدمع",42,"ع",1,0],["فتدارك بقية الدين إن كن","ت لإِحْيَا ميت الدين تسعى",43,"ع",2,0],["فَتَدَرَّعوا بمتون ماء جامِدٍ","وَتَقنَّعوا بِحَباب ماء جاري",44,"ر",2,0],["فتدرك ما تحاول بالتأني","وإنْ رمتَ الجميل فلا توان",45,"ن",1,0],["فتدللي يا تحفة العلياءِ في","روض البشير فقبلتك أباءُ",46,"ا",2,0],["فتدانى الصقر لهمته","طوعا ينقاد على خبب",47,"ب",1,0],["فتدرّعتُهُ وفي راحةِ الشر","قِ حُسامٌ من الضياءِ فَتيقُ",48,"ق",1,0],["فتدهدهت في قعرها حتى انتهت","غيّاً وفيه جزاؤها ومخالها",49,"ل",3,0],["فتدلّى وقاده شبه جبّا","رٍ عظيم يقود طفلا رضيعا",50,"ع",2,0],["فتداولتها أمة من عبده","لم ترع حرمة شيخها ووليدها",51,"د",3,0],["فَتَدارَك خَفِيَّ جِسمي وَإِلّا","لَم يَبِن لِلخَيالِ مِنّي خَيالي",52,"ل",2,0],["فَتَدارَك بِها حَشاشَةَ أَفرا","حي وَحَرَّكَ بِها سُكونَ أَرتِياحي",53,"ح",2,0],["فتدفقت بنداهما أنواؤه","وتبرجت لعلاهما أبراجه",54,"ج",2,0],["فتَدارَكْني بلُطْفٍ سابِلٍ","واحْمِني من لَوْثِ آثارِ الإِحَنْ",55,"ن",1,0],["فَتَدارَكوهُ بِرَأفَةٍ وتَحَنَّنوا","وتَلَطَّفوا بدَمٍ لديهِ يُراقُ",56,"ق",1,0],["فتَداعَوْا حينَ رُدُّوا خَجَلاً","مذْ رَأَوْا منه هِزَبْراً أَسَدَا",57,"د",2,0],["فتدلَّى في آثارُ الصِّفاتْ","من طريقِ الذَّاتِ يومَ الموكِبِ",58,"ب",1,0],["فتداركته من غيرِ توانٍ","ملغياً قول الجهول العاتبِ",59,"ب",1,0],["فتدركون أنكم موتى وما","ثم سوى الحق من الأحياء",60,"ا",2,0],["فتدَاويتُ من خُماري وقد قيل","دَواءُ الخُمار في شُرب خمر",61,"ر",1,0]]}