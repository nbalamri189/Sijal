wPoem.aspx?id=178621",""],[5953,"كم بالغري لمن تبين رشده","https://www.poetsgate.com/ViewPoem.aspx?id=93810",""],[5956,"تُنسينا السيارة","https://www.poetsgate.com/ViewPoem.aspx?id=193870",""],[5957,"وأنا جئتُ إليكم","https://www.poetsgate.com/ViewPoem.aspx?id=180652",""],[6035,"يرجون عفواً، والذنوب عظامُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177489",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[6102,"أُمِّي وَأُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=182734",""],[119,"لك أشكو يا أرحم الرحماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55608&r=&rc=5",""],[6259,"حكمُ المنيَّة في البريَّة جارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59422&r=&rc=70",""],[6301,"مبارك هذا النجاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80679&r=&rc=43",""],[6337,"واهاً لسحركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81412&r=&rc=24",""],[5190,"يا قارئ القرآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85083&r=&rc=158",""]],"verses":[["فتُدْرَكُ آمالٌ وتُقْضى مآرِبٌ","لديّ وتُشْفى باللّقاءِ صُدورُ",0,"ر",1,0],["فتُدْخِلُني للرّضى جنّةً","وتُصْلي حَسودي ناراً وَقودا",1,"د",2,0],["فَتَدَفَّقوا حُجَجاً وَحوطوا نيلَكُم","فَلَكَم أَفاضَ عَلَيكُمُ وَتَدَفَّقا",2,"ق",2,0],["فَتُدرِكَ وِتراً يا اِبنَ قَينِ مُجاشِعٍ","فَتَحيا كَريماً أَو تَموتَ فَتُعذَرا",3,"ر",2,0],["فَتَدَلَّيتُ عَلَيهِ قافِلاً","وَعَلى الأَرضِ غَياياتُ الطَفَل",4,"ل",1,0],["فَتَدارَكَ الإِشراقُ باقِيَ نَفسِهِ","مُتَجَرِّداً كَالمائِحِ العُريانِ",5,"ن",1,0],["فتدخل فيه رأسها قبل رجلها","وتخرج منه رجلها قبل رأسها",6,"س",3,0],["فَتُدَرَّعُ اليومَ القصيرَ بأُنْسِهِمْ","وتُعَمَّرُ العمْرَ الطويل مُصَحَّحا",7,"ح",2,0],["فتداعتْ تداعِيَ القَوْمِ في الثَّل","لَة للَّيث طالعاً من عرينه",8,"ن",2,0],["فَتَدَفَّقَتْ فيهِ الدُّمُوعُ","بصَوبِها المُتَهاطِلِ",9,"ل",1,0],["فَتَدَفَّقَتْ لَحْناً يُرَدِّدُهُ","على سَمْعِ الدُّهُورْ",10,"ر",1,0],["فَتَدانى بِالرُخِّ بيتاً وَأَجرى","خَيلَهُ بَينَ مُلتَقى الصَفَيّنِ",11,"ن",1,0],["فَتُدَبِّرُ الأَفلاكَ سَبعَةُ أَجنُمٍ","وَيُدَبِّرُ الأَرضَينَ نَجمٌ واحِدُ",12,"د",1,0],["فَتَدفَّعا يستهلكانِ على الصِّبى","نفْسَينِ تزدادان طولَ بقاءِ",13,"ا",2,0],["فَتدافعتْ طَوْعَ العواصفِ ترتدِي","هَبَواتِ كلِّ سفيهةٍ هَوجاءِ",13,"ا",2,0],["فَتَدعوه أقْبِلْ لستُ فيها بِرَاغبٍ","إذا بَلَغَ الأمرُ الفِداءَ الميَسَّرا",14,"ر",2,0],["فَتَداعى عَلَيهِم المَوجُ حَتىّ","صارَ موجاً وَراءَهُ مُستَطيرا",15,"ر",2,0],["فَتَدارَكوا جُزُرَ الخِلا","فَةِ وَهيَ شاسِعَةُ النَظيرِ",16,"ر",1,0],["فتدوي السماء في السمع من تس","بيحهم مثلما يدوي القفير",17,"ر",1,0],["فتدرعي للخطب صبراً وامسحي","من أَدمع فوق الخدود سجام",18,"م",1,0],["فَتَدَافَعَتْ نَحْوَ الشَّفِيرِ وَمَا لَهَا","لَوْنٌ سِوَى لَوْنِ القُنُوطِ الشَّاحِبِ",19,"ب",1,0],["فتدخلني للرضا جنة","وتصلي حسودي نارا وقودا",20,"د",2,0],["فتدانى من جاره ورآه","مثلما ينظر الفقير النضارا",21,"ر",2,0],["فتداعوا بعد التمكن صرعى","وتراهم ما بين باك وشاك",22,"ك",1,0],["فتدارَك الخلقَ الإما","مُ بعون رب مُقْتَدِر",23,"ر",1,0],["فتدبَّروا آياتِها وتفكَّرُوا","فهي الدَّواءُ وللقلوبِ جلاءُ",24,"ا",2,0],["فتداعت حَواجزُ السِّجنِ والظُّلمةِ","واليأس حولَه واطمأنا",25,"ن",2,0],["فَتَدارَك حُشاشَةً لَم تَدَع مِن","ها صُروفُ الزَمانِ إِلّا ذَماءَ",26,"ا",2,0],["فتدرّعوا ثوب الفرار مذلة","فأسل بهم أقصى دروب الشام",27,"م",1,0],["فَتُدرَكُ آمال وتُقضَى مآربٌ","وتحدث من بعد الأُمور أمور",28,"ر",1,0],["فَتُداوي سَوداءَ قَلبٍ مُحِبٍّ","أَثَّرت فيهِ عَينُها الزَرقاءُ",29,"ا",2,0],["فَتَداعَوا إِلى الفرارِ وفرّوا","وَلهُم خشيةَ الأسودِ عواءُ",29,"ا",2,0],["فَتداركهُ قبلَ أن تَخطُرَ الأخ","طارُ فاليومَ مسّه الإعياءُ",29,"ا",2,0],["فتدلّل وتمنّع","واحتكم كيف تشاء",30,"ا",2,0],["فتدفعنا نفس إلى الخير والتقى","وتدفعنا الأخرى إلى الشر عنوة",31,"ه",1,0],["فَتَدارَك قِصَّتي فَعَلى","يَدِكَ المَبسوطَةِ الدَرَكُ",32,"ك",1,0],["فتدلَّهت بَغدادُ بينَ نخيلها","ثكلى لِطيفِ حَبيبها إلمام",33,"م",1,0],["فَتَدْبيرُهُ في حالَةِ السِّلْمِ نَاجِعٌ","وَتَشْميرُهُ في حالَةِ الحَرْبِ نَافِعُ",34,"ع",1,0],["فتدبرها أخا الفهم وقم","بدياجي الليل واجه كالبطل",35,"ل",1,0],["فَتَدا