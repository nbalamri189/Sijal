ewPoem.aspx?id=69123",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""],[5956,"لله درُّ الأريحية سامِيا","https://www.poetsgate.com/ViewPoem.aspx?id=208562",""],[4442,"أنت والسجن صارم وقراب","https://www.poetsgate.com/ViewPoem.aspx?id=171198",""],[4442,"أهوت به علته فانتدب","https://www.poetsgate.com/ViewPoem.aspx?id=171003",""],[6127,"كنز اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=190114",""],[6198,"المهاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79235&r=&rc=9",""],[2588,"شاخصة (فلسطين)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65593&r=&rc=25",""],[6259,"همُ علّموا عيني سؤال المعالمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59402&r=&rc=50",""]],"verses":[["هُم عَرَّضوا بِوَفاءِ العَهدِ آوِنَةً","حَتّى إِذا عَذَّبوني بِالمُنى خانوا",0,"ن",3,0],["هُمُ عَضَلوا عَنهُ الفِداءَ فَأَصبَحوا","وَهُذّونَ أَطرافَ القَريضِ المُقَصَّدِ",1,"د",1,0],["هُمُ عَقَدوا لِلَّهِ ثُمَّ وَفَوا بِهِ","بِما ضاقَ عَنهُ كُلُّ بادِ وَحاضِرِ",2,"ر",1,0],["هُمُ عَطَفوا عَلى النُعمانِ لَمّا","أَتاهُ بِتاجِ ذي مُلكٍ بَشيرُ",3,"ر",1,0],["هُم عاهَدوني إِن مَدَدتُ يَدي لَيَمُد","دَ كُلُِّ فَتىً إِلَيَّ يَدا",4,"د",2,0],["هُم عَيَّروني أَنَّ أُمّي غَريبَةٌ","وَهَل في كَريمٍ ماجِدٍ ما يُعَيَّرُ",5,"ر",1,0],["هُم عَلَّموهُ فَصارَ يَهجُرُني","رَبِّ خُذِ الحَقَّ مِن مُعَلِّمِهِ",6,"م",2,0],["هَمُّ عَبدِ الرَحمانِ نَفعُ المَوالي","وَبَوارُ الأَعداءِ وَالأَموالِ",7,"ل",1,0],["هَمَّ عَن دَعوَتي وَمَن ساءَ سَمعاً","في مَواضي أَمثالِهِم ساءَ جابَه",8,"ب",2,0],["هُمُ عَوَّضوا مِن نِعمَتي إِذ وُتِرتُها","بِأَيدٍ يَزُدُّ الفائِتاتِ مَديدُها",9,"د",3,0],["هُمُ عَمَّموا حُجراً وَكِندَةَ حَولَهُ","عَمائِمَ لا تَخفى مِنَ المَوتِ نيرُها",10,"ر",3,0],["هُمُ عُظمى الأَثافي مِن نِزارٍ","وَأَهلُ الهَضبِ مِنها وَالنِجادِ",11,"د",1,0],["هم عاقبونا بحرمانٍ وإن ضَمِنوا","رِزقَ الأُلىَ لم نَهُنْ يوماً كما هانوا",12,"ن",3,0],["هُمْ عُدَّةُ الوادي ليومِ سلامِه","وعَتادهُ المرجوُّ في هَيْجائِه",13,"ا",3,0],["هُمْ عُصبةُ الطَّمعِ الخَدو","عِ وشِيعَةُ الأَمَلِ الكَذُوبْ",14,"ب",1,0],["هُمْ عِندَ ربِّك يُرزَقون فَحيِّهم","وَصِفِ الحياةَ لأنْفُسٍ تَهواها",15,"ا",3,0],["هم عبد الرحمن نفع الموالي","وبوار الأعداء والأموال",16,"ل",1,0],["هم عالمٌ في غيِّه يمضي","مُستغرقاً في الحمأةِ الدنيا",17,"ي",2,0],["هُمُ عَرَفوني ناشِئاً ذا مَخيلَةٍ","أُمَشّي خِلالَ الدارِ كَالأَسَدِ الوَردِ",18,"د",1,0],["هُمْ عَرَّضُونِي لِلْقَنَا ثُمَّ أَعْرَضُوا","سِرَاعاً وَلَمْ يَطْرُقْ مِنَ الشَّرِّ طَارِقُ",19,"ق",1,0],["هُمْ عَزَاءٌ وَمَا سِوَاهُم عَزَاءٌ","عَنْهُ يَأْسُو جَريحَةَ الأَكْبَادِ",20,"د",1,0],["هُمْ عِيالُ الرَّحمنِ ماذا رأيتُمْ","أَو صَنَعْتُم لهؤلاءِ العِيالِ",21,"ل",1,0],["هم عبيدُ النقود في كلِّ عصر","طالما أومئُوا لها بالسُّجود",22,"د",1,0],["هم علموا الدهر مراس قرنه","ثم انتهى بعد المراس مهتدى",23,"ا",1,0],["هم علموا السيف مضاء عزمهم","فهو قرين عزمهم حيث انتوى",23,"ا",1,0],["هم عقدوا بالعز عين همهم","فلا تداني ذلة لهم حمى",23,"ا",1,0],["هم عوضوا من نعمتي إذ وترتها","بأيد يرد الفائتات مديدها",24,"د",3,0],["هُمُ عَضَلُوا عَنهُ الفِدَاءَ فأصْبَحُوا","يهدونَ أطرافَ القريضِ المقصدِ",25,"د",1,0],["هم عاهدوني إن مددت يدي","ليمدّ كلّ فتى إليّ يدا",26,"د",2,0],["هم علم جفن طرزته يد الخفا","بخط إلهي تقدس كاتبه",27,"ب",2,0],["هم عمدتي وحماي ما أملتهم","في مأرب أو مطلب إلا انقضى",28,"ض",2,0],["هُمُ عَبيدٌ له خانوه فانهزمُوا","وما يضرهُمُ لو أنهم صبَرُوا",29,"ر",3,0],["هُمُ عَرَّضوا لِلْبَيْنِ رُوحي فَأَعْرَضُوا","فَوَدَّعْتُ رُوحي حينَ وَدَّعْتُهُمْ مَعَا",30,"ع",2,1],["هم على تركِ الهوى ركبته","فاطاعها وعصى على تركيبه",31,"ب",2,0],["هم عبدوها في الجمالِ ضلالةً","ويمنعني من مثلِ ذلكَ إيماني",32,"ن",2,0],["همُ علموها اجتذابَ القلوبِ","وشقَّ مرائرِ نظَّارها",33,"ر",3,0],["هم عاكفون على الدنيا وزخرفها","والموتُ في مرصد الأعمار معتكفُ",34,"ف",1,0],["هُمُ عَلَّمُوا نَفسي الإِباءَ فَكَيفَ لي","بِتَركِ إِباءِ النَفسِ وَهوَ لَها تِربُ",35,"ب",1,0],["هم عاندوه مكابرين بجهلهم","ولكن دعوه بشاعر مجنون",36,"ن",1,0],["هم عرفوا الشيخ معروفا أَخا كرخ","أَدنوه قبل سرى وَهوَ أَدناه",37,"ا",2,0],["هُم عُصبة المُجاملَة","لا الصدقِ في المعاملَه",38,"ه",1,0],["هم عصمةٌ للوَرى تُرجى النجاةُ بهم","يا فوز من زانَه حسنُ اِتِّباعهمِ",39,"م",1,0],["هم عبيد شهوة مجنونة","هدموا الروح وشادوا البدنا",40,"ن",2,0],["هُم عِياذي إِذا ما مَسَنّي وَصَبٌ","وَذِكرُهُم في صَلاةِ اللَيلِ قُرآني",41,"ن",2,0],["هُم عَيَّروني بِالسُكوت وما دَروا","أَنّي بِأَخلاق الكِرام تَخلّقي",42,"ي",1,1],["هم عمدتي وَوَسيلَتي","مَهما لَواني الدَهر لي",43,"ي",1,0],["هُم عَلَّموا الدَهرَ غَدراً مِن شَمائِلِهِم","جَمَّ الطَرائِقِ مِن بادٍ وَمَكتومِ",44,"م",1,0],["هُمُ عَمروا الدُنيا ولادين عندهم","زماناً وإهمال الديانة حوب",45,"ب",1,0],["هُمُ عُدَّتي لِوَفاتي هُمُ","نَجاتي هُمُ الفَوزُ لِلفائِزينا",46,"ن",2,0],["هُمُ عَونُ من طَلبَ الصَّالحاتِ","فكن بمحبَّتهم مُستَعِينا",46,"ن",2,0],["هُمُ عمادي وَهُمُ حجَّتي","وَفِرحَتي ان بِتُّ مَغموما",47,"م",2,0],["هم عدتي وهم عُمْدَتي هم سلوتي","وهم الأساة لكل صب مدنف",48,"ف",1,0],["هُمُ علماء الدين شرقاً ومغرباً","ونور عيون الفضل والحق والزهد",49,"د",1,0],["هم عيون الناس لا غرو إذا","حاجب عنهم لهم قد حجبا",50,"ب",2,0],["هم عوّدوا الناس الجميل وإنَّهم","تجري عوائدهم على ما عوّدوا",51,"د",3,0],["هم عاهدوك على أن لا تُمَدَّ لهم","يدٌ إلى شجر عَدْواً ولا عشر",52,"ر",1,0],["هُمُ عَمَروا قَلْبِي وطَرْفِي وغادَرُوا","منازِلَهُمْ فيما تَظُنَّان بَلْقَعا",53,"ع",2,0],["هُمُ عَرفُوا مثواكَ فِي هَبْوَةِ الرَّدى","وَقَدْ رَابَ معهودٌ وأَنكَرَ عِرفانُ",54,"ن",1,0],["هم عزّزوه ورَمَوا دونه","بكلّ مطرورِ الشَّبا مطلَقِ",55,"ق",1,0],["هُمُ عقروها إذ تعاطَوا فعُذِّبوا","ورأيُك فيهم صالحٌ وهُم السَّقبُ",56,"ب",1,0],["همُ عاشقوا بيض المكارم والظبي","وللناس بالبيض الظباءِ تباريح",57,"ح",1,0],["هم عذلوا لكن من","هويته ما عرفوا",58,"ف",3,0],["هم عصام الأرواح سرّاً وجهرا","فعليهم من السلام السلام",59,"م",1,0],["هِمْ عن الكونِ بالحَبيبِ فما","شَ بغَبْنٍ مُوَلَّهٌ قد هاما",60,"م",2,0],["هُمْ علَّموني الهَوَى ما كنتُ أعلَهُمُ","يا لائِمي بعدَ هذا كيفَ شِئتَ لُمِ",61,"م",1,0],["همْ عشرةٌ مثلُ الأصابعِ للعُلا","خُلِقَتْ لضرْبِ طُلىً وبَذْلِ نَوالِ",62,"ل",1,0],["همُ عشرةٌ في الفضلِ كاملةٌ لهم","مآثِرُ فخرٍ للنّجومِ تُكاثِرُ",63,"ر",1,0],["هم علموني مدحهم بكرامة","وجود أطابوا منهما وأطالوا",64,"ل",3,0],["هُم عُمدَتي إن نزلت ُأمورُ","وفَرَجي إن ضاقتِ الصُّدورُ",65,"ر",1,0],["هُمُ عُميٌ عَن الكمَالِ ولكِن","قَد أعَدُّوا للنقصِ عينَ عُقَابِ",66,"ب",1,0],["همْ عوّضونِيَ هجراً من مواصلةٍ","وأبدلونِيَ إيحاشاً بإيناسِ",67,"س",1,0],["هم على الجهل فطرة ليس يدرو","ن وما العلم غير ما فيه كانوا",68,"ن",3,0],["هم على حالهم به من قديم","وكذا عندهم به الأكوان",68,"ن",1,0],["هم عوامٌ لا يعلمون وهذا","هو سر أعيى جميع الفحول",69,"ل",1,0],["هُمْ عِلَّة الأَنْفُسِ","والأَرواحِ والجُسومِ",70,"م",1,0],["هُم عثصبَةُ الدينِ الحَنيفِ وَشيعَةُ الشَر","عِ الشَريفِ وَفِتيَةُ الإيمانِ",71,"ن",1,0],["هُم عترة لمحمّدٍ","وقرابة قربى ولحمه",72,"م",2,0],["هُمُ عَضُدٌ لِلمُكَرماتِ وساعِدٌ","وكَفُّ ومِن كَفِّ البَسِيطَةِ أُصبُع",73,"ع",1,0],["همُ عدةُ الأوطان يحمونَ عزها","ببأسٍ على حدِ الظبي ابداً يجري",74,"ر",2,0],["هم عظَّموك بشعر معجب فإذا","كافأته بقبول طيب عظما",75,"م",2,0],["هم على المعدمين","أوسع ايدٍ وأفسحُ",76,"ح",1,0],["هم علموا العالمين إن عبدوا","اللَهو ألغوا عبادة اللات",77,"ت",1,0],["هُم عُصبَةُ الأروامِ","بَغَوْا على الإِسلامِ",78,"م",1,0],["هم عدتي هم عمادي هم رجائي هم","إذا لبست شعار الفخر أسيادي",79,"د",2,0],["هم عمادي إن أساء الدهرُ بي","وهُمُ الصفو إذا حلَّ الكدرْ",80,"ر",1,0],["هُم عدتي في شدتي وهم الأولى","أرجيهم في العسر مني وفي اليسر",81,"ر",1,0],["هُم عددي عِندَ الرفاهة وَالغِنى","وَهُم عددي مَهما عرتني الشدائد",82,"د",1,0],["هم عيون الزمان في كل عصر","وعليهم تعويلنا والمدار",83,"ر",1,0],["همُ عرفوه على بغضه","كما عرفوهُ على ودّه",84,"د",2,0],["هُمُ عذلوِني جاهلونَ بقِصَّتي","ولَو عَرفُوا ما نالَني رَحِمُوني",85,"ن",2,0],["همُ عذَلوني جاهلين بقصّتي","ولو عرَفوا ما نالَني رحِموني",86,"ي",1,0],["هُمُ عَمَروا البلادَ وأوطنوها","فأْمستْ ما بها مِنهمْ غريبُ",87,"ب",1,0],["هم عجزوا في الجود عن مثل بذله","فلاموه في الفعل الذي هو ألِقُ",88,"ق",1,0],["هُمُ عَلَى قُرْبٍ وَهُمْ عَلَى النَّوَى","أَقْصَى المُنَى وَمُنْتَهَى مُرَادِيَهْ",89,"ي",2,0],["هُم عارَضوني عَلى حُبّي لِعارِضِهِ","وَمَن أَحَبَّ عِذاراً فَهوَ مَعذورُ",90,