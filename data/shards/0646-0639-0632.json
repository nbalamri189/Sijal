{"poems":[[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[47,"بنا لا بك الخطب الذي أحدث الدهر","https://www.aldiwan.net/poem63611.html","الطويل"],[50,"نعزي أمير المؤمنين محمدا","https://www.aldiwan.net/poem63356.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54551","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54237","الوافر"],[47,"بِنا لا بكَ الخَطبُ الذي أحدَثَ الدّهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31290",""],[113,"نعزي الفخر والعليا بشبل","https://www.aldiwan.net/poem16204.html","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83278","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46470","الطويل"],[2171,"","https://poetry.dctabudhabi.ae/diwan/poem/110727","الوافر"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69502","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100268","الطويل"],[3348,"","https://poetry.dctabudhabi.ae/diwan/poem/81323","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86526","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4748,"كلمة الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=6408",""],[4767,"نعزيك","https://www.poetsgate.com/ViewPoem.aspx?id=180045",""],[5673,"سقى الله أرضا ضمت المجد والندى","https://www.poetsgate.com/ViewPoem.aspx?id=124960",""],[5956,"أ نعرف صالحاً ونشيم رهْقا؟","https://www.poetsgate.com/ViewPoem.aspx?id=194600",""],[5956,"ثلاث قصائد لصديق","https://www.poetsgate.com/ViewPoem.aspx?id=207975",""]],"verses":[["نُعَزّيكَ عَن شَهرِ الصِيامِ الَّذي انقَضى","فَإِنَّكَ مَفجوعٌ بِهِ فَمُصابُ",0,"ب",1,0],["نُعَزّيكَ عَن هَذي الرَزِيَّةِ إِنَّها","عَلى قَدرِ ما في عُظمِها يَعظُمُ الأَجرُ",1,"ر",1,0],["نُعَزّي أَميرَ المُؤمِنينَ مُحَمَّداً","عَلى خَيرِ مَيتٍ غَيَّبَتهُ المَقابِرُ",2,"ر",1,1],["نُعَزِّي عَنْكِ أَبْنَاءً كِرَاماً","وَهُمْ لِقُلُوبِنَا عُنْكِ الْعَزَاءُ",3,"ا",2,0],["نُعَزِّي فِيهِ لُبْنَاناً وَنَبْكِي","فَمَنْ أَوْلَى وَأَجْدَرُ بِالْعَزَاءِ",4,"ا",2,0],["نُعَزّيكَ عَنْ هَذِي الرّزِيئَةِ، إنّها","عَلى قَدْرِ ما في عِظْمِها يَعظُمُ الأجرُ",5,"ر",1,0],["نُعَزّي الفَخر وَالعَليا بِشبلٍ","لَواهُ عَن تَصيده حِمامُه",6,"م",2,1],["نَعزو إِلى لَخمٍ مِتانَةً أَصلَها","وَتَمُزُّ مِن ماءِ السماءِ صفاءَها",7,"ا",3,0],["نعزي بِكَ الأَعداء إِذ لَيسَ عِندَنا","لِقَلبِ وَلي في العَزاء نَصيب",8,"ب",1,0],["نعزي الطهر فاطم في أبيها","وشرعته ومن عنه اقيموا",9,"م",3,0],["نُعزّي بِكَ الإِسلامَ إِنَّكَ دونَهُ","إِذا نَكَلَ الحامونَ كُنتَ مُحاميا",10,"ي",2,0],["نُعَزّي أَميرَ المُؤمِنينَ وَرَهطَهُ","بِسَيفٍ لَهُ ما كانَ في الحَربِ نابيا",10,"ي",2,0],["نعزيك لو يجدي العزاء فتى المجدِ","بملحودة في القلب لا بثرى اللحد",11,"د",1,1],["نعزيك بالقربى على كل حالة","وفي عزّ ربّ المجد عزّ الأقارب",12,"ب",1,0],["نعزيهم ببعض القول عما","يخصهم من الرزء الصميم",13,"م",1,0],["نَعز بأَفضالِ العزيزِ وفضلهِ","ونَحْسبُ نفعاً كل ما مَن من ضُر",14,"ر",1,0],["نعزف امالٍ تراودنا لحن","ننتشي واحلامنا فوق الرّفوف",15,"ف",1,0],["نعزيك يا شيخنا الفاضلا","بأستاذ علمٍ قضى راحلا",16,"ل",2,1],["نعزي الشريعة من صانها","عزاءً مدى عمرنا واصلا",16,"ل",2,0],["نعزي نفوساً ترى أنها","أصيبت بسهم أتى قاتلا",16,"ل",2,0],["نعزي نفوسا بعضها البعض موقن","على أنها هلكى عدادا ومفردا",17,"د",2,0],["نُعزّك يا أشدّ الناس طرّاً","على الفقراءِ والشعراء رفقا",18,"ق",2,0],["نعزك يا مؤسسَ كلِّ خصبٍ","لنا ولغيرنا دمت الرَّبيعا",19,"ا",1,0]]}