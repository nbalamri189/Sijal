{"poems":[[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[77,"قد مررنا بدار عبو الوالي","https://www.aldiwan.net/poem36356.html","الخفيف"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[86,"قصر الدبارة هل أتاك حديثنا","https://www.aldiwan.net/poem10693.html","الكامل"],[86,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[0,"لمن الديار غشيتها بِسحام","https://www.aldiwan.net/poem64.html",""],[88,"عهد الصبا سقيا لأيام الصبا","https://www.aldiwan.net/poem44447.html","الرجز"],[88,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[27,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[27,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[27,"خف القطين فقلبي اليوم متبول","https://www.aldiwan.net/poem5952.html","البسيط"],[11,"وإني لأستحيي صحابي أن يرو","https://www.aldiwan.net/poem259.html",""],[37,"هلا سألت معالم الأطلال","https://www.aldiwan.net/poem7428.html","الكامل"],[72,"اسكنت قلبي لحدك","https://www.aldiwan.net/poem18565.html","المنسرح"],[51,"أقصر وعور","https://www.aldiwan.net/poem61923.html","مجزوء الرجز"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"يا أيها الرجل المسود شيبه","https://www.aldiwan.net/poem66425.html","البسيط"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[91,"أقص عليكم ما جرى لي بالأمس","https://www.aldiwan.net/poem8975.html","عموديه"],[85,"قف بروما وشاهد الأمر واشهد","https://www.aldiwan.net/poem63737.html","الخفيف"],[56,"أقصيتموني من بعد فرقتكم","https://www.aldiwan.net/poem58657.html","المنسرح"],[43,"أقصر فلست بزائدي ودا","https://www.aldiwan.net/poem9533.html","الكامل"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[45,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[45,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[45,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[61,"ما سره أن ذاع من أسراره","https://www.aldiwan.net/poem51672.html","الكامل"],[61,"أقصر الزاجر عنه فازدجر","https://www.aldiwan.net/poem51677.html","الرمل"],[61,"إن عن لهو أو سنح","https://www.aldiwan.net/poem51734.html","مجزوء الرجز"],[58,"قضد عرف الحرب العوان أني","https://www.aldiwan.net/poem30846.html","الرجز"],[49,"الدهر يوعد فرقة وزوالا","https://www.aldiwan.net/poem63071.html","الكامل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[97,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[80,"بك يا صبور القلب هام جزوعه","https://www.aldiwan.net/poem31382.html","الكامل"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[31,"من لقلب غير صاح","https://www.aldiwan.net/poem42589.html","مجزوء الرمل"],[74,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[105,"عندي إذا صرع الجنوب سبات","https://www.aldiwan.net/poem42095.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[40,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[48,"قل للخليفة إنني","https://www.aldiwan.net/poem64330.html","مجزوء الكامل"],[46,"أقصرت من قصر النهار وقد أنى","https://www.aldiwan.net/poem22568.html","الكامل"],[76,"أقصرت بعض الإقصار","https://www.aldiwan.net/poem39326.html","منهوك المنسرح"],[76,"هتك الحجاب عن الضمائر","https://www.aldiwan.net/poem39327.html","مجزوء الكامل"],[68,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem1489.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140861",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39672","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16648","المتقارب"],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[58,"قد عرف الحرب العوان أني","https://www.poetsgate.com/ViewPoem.aspx?id=22756",""],[126,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[135,"أقصرا عن ملامتي عاذليا","https://www.aldiwan.net/poem67920.html","الخفيف"],[158,"اضرب بسيف العزم أَعناق الكرى","https://www.aldiwan.net/poem58719.html","الكامل"],[162,"أعن الشمس عشاء","https://www.aldiwan.net/poem67842.html","مجزوء الرمل"],[183,"أقصاه جور البين عن أحبابه","https://www.aldiwan.net/poem14107.html","الكامل"],[183,"إيه على تذكار ما سلفا","https://www.aldiwan.net/poem14591.html","أحذ الكامل"],[184,"قالوا أتى العيد قلت العيد عادته","https://www.aldiwan.net/poem43794.html","البسيط"],[209,"يا جنة الخلد كيف يشقى","https://www.aldiwan.net/poem46558.html","مخلع البسيط"],[223,"أقصر فؤادي فما الذكرى بنافعة","https://www.aldiwan.net/poem55169.html","البسيط"],[227,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[233,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[235,"يارغبة لم أزل أرددها","https://www.aldiwan.net/poem18185.html","المنسرح"],[235,"يا جميل الصبر لب من دعا","https://www.aldiwan.net/poem19492.html","الرمل"],[247,"لمن الديار غشيتها بالأنعم","https://www.aldiwan.net/poem2093.html","الكامل"],[254,"لا يحسن الإشراف من مقعد","https://www.aldiwan.net/poem48342.html","السريع"],[273,"لمبشري برضاك أن يتحكما","https://www.aldiwan.net/poem25527.html","الكامل"],[295,"ما بال قلبك لا يزال مولها","https://www.aldiwan.net/poem33086.html","الكامل"],[303,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[347,"أخلصت في الحب ويا حبذا","https://www.aldiwan.net/poem15747.html","السريع"],[351,"وافى وقد لعب النسيم بردنه","https://www.aldiwan.net/poem40229.html","الكامل"],[369,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[406,"أقصر فلومي في حبهم لمم","https://www.aldiwan.net/poem32542.html","المنسرح"],[429,"يا ذرويا كان في حبه","https://www.aldiwan.net/poem12643.html","السريع"],[451,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[459,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[493,"يا معجبا مرح العنا","https://www.aldiwan.net/poem10269.html","مجزوء الكامل"],[498,"دمعي كسيل تنمنم","https://www.aldiwan.net/poem37779.html","المجتث"],[513,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[513,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[538,"أقصرت عن جهلي الأدنى وحلمني","https://www.aldiwan.net/poem56858.html","البسيط"],[549,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[551,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[551,"سرت بملام حين هوم عذلي","https://www.aldiwan.net/poem68431.html","الطويل"],[556,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[560,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[560,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[565,"ضحكت من شيبة ضحكت","https://www.aldiwan.net/poem69551.html","الرمل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَقصِر فَقَد جُزتَ المَدى","مُجامِلاً أَو فَاِقتَصِر",0,"ر",1,0],["أَقْصَدَتْ رَبَّهَا الْحَوَادِثُ لَمَّا","رَشَقَتْهُ بِصَاِئَباتِ زَوَالِ",1,"ل",1,0],["أَقصِر فَإِنَّكَ طالَما","أوضِعتَ في إِعجابِها",2,"ب",3,0],["أَقصِر فَكُلُّ طالِبٍ سَيَمَلُّ","إِن لَم يَكُن عَلى الحَبيبِ عِوَل",3,"ل",1,1],["أَقصَيتَهُم عَنّا وَجِئتَ بِفِتيَةٍ","طاشَ الشَبابُ بِهِم وَطارَ المَنصِبُ",4,"ب",1,0],["أَقَصرَ الزَعفَرانِ لَأَنتَ قَصرٌ","خَليقٌ أَن يَتيهَ عَلى النُجومِ",5,"م",1,1],["أَقصِر إِلَيكَ مِنَ الوَعيدِ فَإِنَّني","مِمّا أُلاقي لا أَشُدُّ حِزامي",6,"م",2,0],["أقصر هذا ذيك عن القول فلا","يقاس ذيّاك تاللّه بذا",7,"ا",1,0],["أقصِر فكم من حرّة مذ اُنزلت","في منزل الرجل الغني بها نبا",8,"ب",2,0],["أَقصِر فَإِنَّكَ ما لَم تُؤنِسوا فَزَعاً","عِندَ المِراءِ خَسيفُ النوكِ قَبقابُ",9,"ب",1,0],["أَقصِر فَإِنَّ نِزاراً لَن يُفاضِلَها","فَرعٌ لَئيمٌ وَأَصلٌ غَيرُ مَغروسِ",10,"س",1,0],["أَقصِر بِقَدرِكَ إِنَّ اللَهَ فَضَّلَنا","وَما لِما قَد قَضى ذو العَرشِ تَبديلُ",11,"ل",1,0],["أُقَصِّرُ كَفّي أَن تَنالَ أَكُفَّهُم","إِذا نَحنُ أَهوَينا وَحاجاتُنا مَعا",12,"ع",2,0],["أقصى مذاهبها إذا لاقيتها","في الشهر بين أسرة وحجالِ",13,"ل",1,0],["أقصدتني يا زماني","كأنَّني كنتُ قصدك",14,"ك",1,0],["أقِصَرٌ وَعَوَرٌ","وصَلَعٌ في واحِدِ",15,"د",1,1],["أقصِرْ عن الجهلِ يا مُماجِدَه","فقد قضى اللَّهُ أنه مَجدَك",16,"ك",1,0],["أَقَصَّرْتُ في فرضٍ فمثليَ قصَّرتْ","به حالُهُ عن كل ما هو لازمُ",17,"م",1,0],["أقصِرْ فلوْ سوَّدْتَ كل حمامةٍ","بيضاءَ ما عُدَّتْ من الغِرْبان",18,"ن",1,0],["أَقصَدتَ قائِدَها بِعامِلِ صَعدَةٍ","وَنَزَلتَ عِندَ تَواكُلِ الأَبطالِ",19,"ل",1,0],["أَقُصُّ عَلَيكُم ما جَرى لِيَ بِالأَمسِ","فَلي قَصَصٌ تَجلو الهُمومَ عَنِ النَفسِ",20,"س",1,1],["اِقصِري وَاِسأَلي عَنِ الدَهرِ مِصراً","هَل قَضَت مَرَّتَينِ مِنهُ اللُبانَه",21,"ن",2,0],["أَقصَيْتُموني مِنْ بَعْدِ فرْقتِكُمْ","فَخَبِّروني عَلامَ إِقْصائي",22,"ا",3,1],["أَقصِر فَلَستَ بِزائِدي وُدّا","بَلَغَ المَدى وَتَجاوَزَ الحَدّا",23,"د",2,1],["أَقصِر وَلَستَ بِمُقسِرٍ جُزتَ المَدى","وَبَلَغتَ حَيثُ النَجمُ تَحتَكَ فَاِربَعا",24,"ع",2,0],["أقصَرْنَ عن متمرّنٍ متعوِّدٍ","للخطب أن ألقَى عليه كلكلا",25,"ل",2,0],["أَقصِرا قَد أَطَلتُما تَفنيدي","وَمِنَ الجَهلِ لَومُ غَيرِ سَديدِ",26,"د",1,1],["أَقصِرا لَيسَ شَأنِيَ الإِقصارُ","وَأَقِلّا لَن يُغنِيَ الإِكثارُ",27,"ر",1,1],["أَقصِر فَإِنَّ الدَهرَ لَيسَ بِمُقصِرِ","حَتّى يَلُفَّ مُقَدَّماً بِمُؤَخَّرِ",28,"ر",1,1],["أَقصِر بِرَأيِيَ إِن شَرَّقتُ عَنكَ غَداً","وَمَرَّ بَعدَكَ لي لَيلٌ فَلَم يَطُلِ",29,"ل",1,0],["أَقَصرَ حُمَيدٍ لا عَزاءَ لِمُغرَمِ","وَلا قَصرَ عَن دَمعٍ وَإِن كانَ مِن دَمِ",30,"م",1,1],["أقصرْتُ عن ذِكْرِ السُّلُوِّ وقصَّرَت","هِمَمُ العذولِ فَزَادَ في إقصارِه",31,"ر",2,0],["أَقصَرَ الزَّاجِرُ عنه فازدَجَرْ","وطوَى اللائمُ ما كانَ نَشَرْ",32,"ر",1,1],["أقْصِرْ فمَنْ رامَ صَلا","حَ العيشِ بالكأسِ صَلُح",33,"ح",1,0],["أُقصي بِهِ كُلَّ عَدُّوٍ عَنّي","لِمثلِ هَذا وَلَدَتني أُمّي",34,"ي",1,0],["أَقصِر خُطاكَ عَنِ المَطامِعِ عِفَّةً","عَنها فَإِنَّ لَها صَفاً زَلّالا",35,"ل",2,0],["أَقصِر أَطِل إِعذِرِ اِعذُل سَلِّ خَلِّ أَغِن","خُن هُنَّ عُنَّ تَرَفَّق كُفَّ لُجَّ لُمِ",36,"م",1,0],["أَقصَيتَني بِالجودِ ثُمَّ دَعَوتَني","فَنَداكَ أَبعَدَني وَإِن أَدناني",37,"ن",2,0],["أَقُصُّ بِشِعري إِثرَ فَضلِكَ واصِفاً","عُلاكَ إِذا ما النَاسُ قُصَّت شُعورُها",38,"ر",3,0],["أقصَتهُ ثم تلفَّتت","ترجو إلَيها أوبته",39,"ه",1,0],["أقْصِرْ فما يجتثّ أصْل علاقةٍ","جُذِبَتْ بأطرافِ الملام فروعُهُ",40,"ع",2,0],["أَقُصُّ عَلى أُختَيَّ بِدءَ حَديثِنا","وَما لِيَ مِن أَن تَعلَما مُتَأَخَّرُ",41,"ر",1,0],["أَقصَدَت قَلبي وَما إِن","أَقصَدَتهُ بِسِلاحِ",42,"ح",1,0],["أَقصِر فَلا ذاكَ الخَليلُ بَآيِبٍ","يَوماً وَلا ذاكَ الشَبابُ يُعادُ",43,"د",1,0],["أقصى المواعدِ أن تَمُرَّ عَشِيّةٌ","بالمرء سلماً أو تكُرَّ غَداةُ",44,"ه",1,0],["أَقصِرْ فما لك بالعظائمِ طاقةٌ","وَاسْكتْ فمثلُكَ لا يمرُّ ببالِ",45,"ل",1,0],["أَقصَيتِهِ وَأَرادَ سِلمَكُمُ","فَليَهِنهِ إِذ جاءَكِ السِلمَ",46,"م",1,0],["أقصَدتْهُ تِرْبَ خمسٍ أسهُمٌ","لو رَمَتْه تِرْبَ عَشْرٍ لم تكَد",47,"د",1,0],["أَقصَيتَهُ وَنَسيتَهُ","وَلِعَهدِهِ بِكَ غَيرُ ناسِ",48,"س",1,0],["أَقصَرتُ مِن قَصرِ النَهارِ وَقَد أَنى","مِنّي الغُروبُ وَلَيسَ لي إِقصارُ",49,"ر",1,1],["أقْصَرتُ بَعْضَ الإقْصارْ","عَنْ شادنٍ نائي الدَّارْ",50,"ر",1,1],["أَقْصَيْتَني مِنْ بَعْدِ مَا","أَدْنَيْتني فالقلْبُ طائِرْ",51,"ر",1,0],["أقْصِر عدِمْتُك واطّرح من أثخنتْ","أحشاءَهُ النُّجلُ العُيونُ جِراحا",52,"ح",2,0],["اقصدي في هذا البكاء قليلا","لا تكوني به علي سخيا",53,"ي",2,0],["\"أقصره ولست بمقصرٍ، جزت المدى","وبلغت حيث النجم تحتك فأربعا\"",54,"ع",2,0],["أقصى منايَ سفينة ممشوقة","وبزوغُ نجم أهتدي بضيائهِ",55,"ه",1,0],["أقصى منايَ لديه يومٌ عاصفٌ","يهفو رقيق الغيم في سبحانهِ",55,"ه",1,0],["أقصى منايَ روايةٌ محبوكةٌ","من نسيجِ قرصانِ طروبٍ ضاحكِ",55,"ك",1,0],["أقُصَّتْ نُسُورُ نُجومِ السماءِ","فلم تَستطِعْ نهْضَةً للمَغِيبِ",56,"ب",1,0],["أقصى ملوكَ الفرس وال","رومان عن عرشَيْهما",57,"م",2,0],["أُقْصِي بهِ كُلَّ العُداة ِ عَنِّي","لمثلِ هذا ولدتني أمي",58,"ي",1,0],["أقصرْ لقدْ جاوزت حدَّ المنتهَى","في الجودِ والبأساءِ والإكرَامِ",59,"م",1,0],["أَقصِرا عَن مَلامَتي عاذِلَيّا","إِنَّ عَذلي يَزيدُني اليَومِ غَيّا",60,"ي",2,1],["اقصد فناهُ إذ اعترتكَ ملمةٌ","فالصَّيدُ كلُّ الصيدِ في جوفِ الفرا",61,"ر",2,0],["أَقصَدَت ضِرغامَ غابٍ","بَينَ خيسَيهِ غَريفُ",62,"ف",1,0],["أَقْصاهُ جَوْرُ البَيْنِ عن أحبابِهِ","وزَمانِه وبلادِه وشَبابِه",63,"ب",2,1],["أُقْصِي البنفسجَ ثم يُعجبني","أنْ أَنْشَقَ الظَّيّان والطَّرفا",64,"ف",2,0],["أقصى جفاء ولا أعطى بمعرفتي","وحسن فهمي بممدود ومقصور",65,"ر",1,0],["أقصى أمانيه حين يمسى","أن يهجع الخفق وانو جيب",66,"ب",1,0],["أَقصِر فُؤادي فما الذِكرى بِنافِعةٍ","ولا بِشافِعَةٍ في رَدٍّ ما كانا",67,"ن",2,1],["أَقصرتُ يا سَلْمَ عمّا تَعلمِين فما","أَصْبُو لَربْع ولا أَبْكي على طَلَل",68,"ل",1,0],["أَقصَدَني الدَهرُ بِسَه","مِ صَرفِهِ المُفَوَّقِ",69,"ق",1,0],["أَقْصَرُهَا أَمَلاً وَأَطْوَلُهَا","بَاعاً وَأَصْوَلُهَا وَأَمْجَدُهَا",70,"د",3,0],["أَقْصَدَ الْيُوسِيَّ سَهْمٌ مِنْ رَدَى","أَثْكَلَ الْعَالَمَ فِيهِ أَجْمَعَا",71,"ع",2,0],["أَقصَدنَ حُجراً قَبلَ ذَلِكَ وَالقَنا","شُرُعٌ إِلَيهِ وَقَد أَكَبَّ عَلى الفَمِ",72,"م",1,0],["أقصر من يأجوج في قده","وقرنه أطول من عوج",73,"ج",1,0],["أقْصاهُ عَنْكَ تَزَلُّفٌ بِخَطِيئَةٍ","خَالَ الصَّوابَ خِلالَها وَتَوَهَّما",74,"م",2,0],["أَقصِر فَقَد خَلَت الديارُ فَلا هَوىً","يُصبى إليه ولا مَليحٌ يُشتَهى",75,"ه",2,0],["أَقصى مَدى العلمِ منّا أنّكم قبسٌ","مِن السّراجِ الّذي اِنجابت به الظلمُ",76,"م",1,0],["أُقصي عَلى سَلوانِهِ خِلّ","لِيَ الداني صَبَّهُ القاصي",77,"ص",2,0],["أَقصر جَفاك فَإِن مِن خَلق الهَوى","خلق السلوّ فَلا يَغرَّك ما جَرى",78,"ر",2,0],["أقصِر ألم يَسمَع سوا","كَ بأنَّها دارُ الغُرورِ",79,"ر",1,0],["أَقْصِرْ فَلَومي في حُبِّهم لَمَمُ","وناصحُ العاشِقينَ مُتَّهَمُ",80,"م",1,1],["أقْصَدْتَني بالهُجْر من بعد ما","أقصدْتَني من قبلُ بالهجْرِ",81,"ر",1,0],["أقصى أمانيَّ أن أحيا شذَى وسنىً","بعد الحياة اذا التذكار أحياني",82,"ي",1,0],["أقصاه عند الناس إدلاؤه","من فضله بالنسب الأقربِ",83,"ب",1,0],["أقْصى مُؤمَّلهِ بَقاؤكَ للِعُلى","فبَقيتُما ما شَدَّ زنْداً أنْمُلُ",84,"ل",1,0],["أقصر فإنك ميت","يُهدي الفناء إليك سيله",85,"ه",1,0],["أَقصى رِفاقِيَ رَحْلي","والَهْفَ قلبي المُهَيَّمْ",86,"م",1,0],["اقصر من عنان المدح فيهم","فيغلبني ويجمح بي لجامي",87,"م",2,0],["أقصر عليك فطالما أشجاني","ريم تهيج بذكره أشجاني",88,"ن",2,0],["أَقصَرتُ عَن جَهليَ الأدنى وَحَلَّمَني","زَرعٌ مِن الشَيبِ بِالفَودَينِ مَنقودُ",89,"د",1,1],["أقصدتني عيناه يوم تلاقي","نا بفسحِ الحِمى وراح سليما",90,"م",2,0],["أقصى مرادى أنْ أراك وإنّها","أُمنيّةٌ حسبي بها لمؤمّلِ",91,"ل",1,0],["أَقصَيتِني مِن بَعدِ ما جَرَّعتِني","كَأساً لِحُبِّكِ ما تَسوغُ لِشارِبِ",92,"ب",1,0],["أُقَصِّرُ عَن أَشياءَ وَالشُكرُ جاهِدٌ","وَحَسبُكَ مِن شُكرِ اِمرِئٍ غَيرَ مُؤتَلِ",93,"ل",1,0],["أقصر عدمتك واطرح من أثخنت","مقل الظباء فؤاده فتلاحى",94,"ح",2,0],["أقصَى الجُنونِ إذا تَبصَّرنا بهِ","عُمرٌ قصيرٌ غاصَ في طول المُنَى",95,"ا",1,0],["أقصِرْ عَناكَ وحيثُ حَلَّتْ نِعمةُ الرْ","رُوحِ الأمينِ على مُحمَّدَ فانزِلِ",96,"ل",1,0],["أَقْصَدَتْ قَلْبِي بِهِ فَمَضَى","سَهْمُهُ فِيْهِ وَقَدْ قَتَلَهْ",97,"ل",2,0],["أقصى بلاد من بلاد الغرب","وكل من أبصره في كرب",98,"ب",1,0]]}