"],[5277,"مقام الأجواد","https://www.poetsgate.com/ViewPoem.aspx?id=194547",""],[5277,"معارضة داليّة الحصري القيرواني","https://www.poetsgate.com/ViewPoem.aspx?id=198895",""],[5277,"قاب قوسين أو أدنى","https://www.poetsgate.com/ViewPoem.aspx?id=201614",""],[5320,"البسمة الصفراء","https://www.poetsgate.com/ViewPoem.aspx?id=43257",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5343,"امسح دموعك،","https://www.poetsgate.com/ViewPoem.aspx?id=132672",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5353,"بيروت تحفل بالأسى","https://www.poetsgate.com/ViewPoem.aspx?id=215399",""],[5431,"مازلتُ أهواه....","https://www.poetsgate.com/ViewPoem.aspx?id=189920",""],[5431,"أقصى التوله...","https://www.poetsgate.com/ViewPoem.aspx?id=198351",""],[5449,"صقيع","https://www.poetsgate.com/ViewPoem.aspx?id=189106",""],[5465,"أصبح الملك ثابت الأثاث","https://www.poetsgate.com/ViewPoem.aspx?id=98432",""],[5496,"مابال قلبى!","https://www.poetsgate.com/ViewPoem.aspx?id=213942",""],[5542,"بابا الفاتيكان","https://www.poetsgate.com/ViewPoem.aspx?id=9673",""],[5572,"الإطاحة بعاشق نبيل","https://www.poetsgate.com/ViewPoem.aspx?id=53490",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""],[5790,"هزوا القدود وأرهفوا سمر القنا","https://www.poetsgate.com/ViewPoem.aspx?id=111945",""],[5883,"نور القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=24299",""],[5956,"لا رب عندي غير رب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=192654",""],[5956,"سأنسى سيئات قبيلتي","https://www.poetsgate.com/ViewPoem.aspx?id=194782",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[5970,"أيها النائحون خلوا نواحا","https://www.poetsgate.com/ViewPoem.aspx?id=130607",""],[5975,"إلى طرطوس الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=56849",""],[6056,"الفكة غنيمة","https://www.poetsgate.com/ViewPoem.aspx?id=130526",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[313,"هل تذكرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66481&r=&rc=6",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""],[6185,"صدمةٌ !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87025&r=&rc=11",""],[5126,"الطائف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87785&r=&rc=0",""]],"verses":[["أَقصِر فَقَد جُزتَ المَدى","مُجامِلاً أَو فَاِقتَصِر",0,"ر",1,0],["أَقْصَدَتْ رَبَّهَا الْحَوَادِثُ لَمَّا","رَشَقَتْهُ بِصَاِئَباتِ زَوَالِ",1,"ل",1,0],["أَقصِر فَإِنَّكَ طالَما","أوضِعتَ في إِعجابِها",2,"ب",3,0],["أَقصِر فَكُلُّ طالِبٍ سَيَمَلُّ","إِن لَم يَكُن عَلى الحَبيبِ عِوَل",3,"ل",1,1],["أَقصَيتَهُم عَنّا وَجِئتَ بِفِتيَةٍ","طاشَ الشَبابُ بِهِم وَطارَ المَنصِبُ",4,"ب",1,0],["أَقَصرَ الزَعفَرانِ لَأَنتَ قَصرٌ","خَليقٌ أَن يَتيهَ عَلى النُجومِ",5,"م",1,1],["أَقصِر إِلَيكَ مِنَ الوَعيدِ فَإِنَّني","مِمّا أُلاقي لا أَشُدُّ حِزامي",6,"م",2,0],["أقصر هذا ذيك عن القول فلا","يقاس ذيّاك تاللّه بذا",7,"ا",1,0],["أقصِر فكم من حرّة مذ اُنزلت","في منزل الرجل الغني بها نبا",8,"ب",2,0],["أَقصِر فَإِنَّكَ ما لَم تُؤنِسوا فَزَعاً","عِندَ المِراءِ خَسيفُ النوكِ قَبقابُ",9,"ب",1,0],["أَقصِر فَإِنَّ نِزاراً لَن يُفاضِلَها","فَرعٌ لَئيمٌ وَأَصلٌ غَيرُ مَغروسِ",10,"س",1,0],["أَقصِر بِقَدرِكَ إِنَّ اللَهَ فَضَّلَنا","وَما لِما قَد قَضى ذو العَرشِ تَبديلُ",11,"ل",1,0],["أُقَصِّرُ كَفّي أَن تَنالَ أَكُفَّهُم","إِذا نَحنُ أَهوَينا وَحاجاتُنا مَعا",12,"ع",2,0],["أقصى مذاهبها إذا لاقيتها","في الشهر بين أسرة وحجالِ",13,"ل",1,0],["أقصدتني يا زماني","كأنَّني كنتُ قصدك",14,"ك",1,0],["أقِصَرٌ وَعَوَرٌ","وصَلَعٌ في واحِدِ",15,"د",1,1],["أقصِرْ عن الجهلِ يا مُماجِدَه","فقد قضى اللَّهُ أنه مَجدَك",16,"ك",1,0],["أَقَصَّرْتُ في فرضٍ فمثليَ قصَّرتْ","به حالُهُ عن كل ما هو لازمُ",17,"م",1,0],["أقصِرْ فلوْ سوَّدْتَ كل حمامةٍ","بيضاءَ ما عُدَّتْ من الغِرْبان",18,"ن",1,0],["أَقصَدتَ قائِدَها بِعامِلِ صَعدَةٍ","وَنَزَلتَ عِندَ تَواكُلِ الأَبطالِ",19,"ل",1,0],["أَقُصُّ عَلَيكُم ما جَرى لِيَ بِالأَمسِ","فَلي قَصَصٌ تَجلو الهُمومَ عَنِ النَفسِ",20,"س",1,1],["اِقصِري وَاِسأَلي عَنِ الدَهرِ مِصراً","هَل قَضَت مَرَّتَينِ مِنهُ اللُبانَه",21,"ن",2,0],["أَقصَيْتُموني مِنْ بَعْدِ فرْقتِكُمْ","فَخَبِّروني عَلامَ إِقْصائي",22,"ا",3,1],["أَقصِر فَلَستَ بِزائِدي وُدّا","بَلَغَ المَدى وَتَجاوَزَ الحَدّا",23,"د",2,1],["أَقصِر وَلَستَ بِمُقسِرٍ جُزتَ المَدى","وَبَلَغتَ حَيثُ النَجمُ تَحتَكَ فَاِربَعا",24,"ع",2,0],["أقصَرْنَ عن متمرّنٍ متعوِّدٍ","للخطب أن ألقَى عليه كلكلا",25,"ل",2,0],["أَقصِرا قَد أَطَلتُما تَفنيدي","وَمِنَ الجَهلِ لَومُ غَيرِ سَديدِ",26,"د",1,1],["أَقصِرا لَيسَ شَأنِيَ الإِقصارُ","وَأَقِلّا لَن يُغنِيَ الإِكثارُ",27,"ر",1,1],["أَقصِر فَإِنَّ الدَهرَ لَيسَ بِمُقصِرِ","حَتّى يَلُفَّ مُقَدَّماً بِمُؤَخَّرِ",28,"ر",1,1],["أَقصِر بِرَأيِيَ إِن شَرَّقتُ عَنكَ غَداً","وَمَرَّ بَعدَكَ لي لَيلٌ فَلَم يَطُلِ",29,"ل",1,0],["أَقَصرَ حُمَيدٍ لا عَزاءَ لِمُغرَمِ","وَلا قَصرَ عَن دَمعٍ وَإِن كانَ مِن دَمِ",30,"م",1,1],["أقصرْتُ عن ذِكْرِ السُّلُوِّ وقصَّرَت","هِمَمُ العذولِ فَزَادَ في إقصارِه",31,"ر",2,0],["أَقصَرَ الزَّاجِرُ عنه فازدَجَرْ","وطوَى اللائمُ ما كانَ نَشَرْ",32,"ر",1,1],["أقْصِرْ فمَنْ رامَ صَلا","حَ العيشِ بالكأسِ صَلُح",33,"ح",1,0],["أُقصي بِهِ كُلَّ عَدُّوٍ عَنّي","لِمثلِ هَذا وَلَدَتني أُمّي",34,"ي",1,0],["أَقصِر خُطاكَ عَنِ المَطامِعِ عِفَّةً","عَنها فَإِنَّ لَها صَفاً زَلّالا",35,"ل",2,0],["أَقصِر أَطِل إِعذِرِ اِعذُل سَلِّ خَلِّ أَغِن","خُن هُنَّ عُنَّ تَرَفَّق كُفَّ لُجَّ لُمِ",36,"م",1,0],["أَقصَيتَني بِالجودِ ثُمَّ دَعَوتَني","فَنَداكَ أَبعَدَني وَإِن أَدناني",37,"ن",2,0],["أَقُصُّ بِشِعري إِثرَ فَضلِكَ واصِفاً","عُلاكَ إِذا ما النَاسُ قُصَّت شُعورُها",38,"ر",3,0],["أقصَتهُ ثم تلفَّتت","ترجو إلَيها أوبته",39,"ه",1,0],["أقْصِرْ فما يجتثّ أصْل علاقةٍ","جُذِبَتْ بأطرافِ الملام فروعُهُ",40,"ع",2,0],["أَقُصُّ عَلى أُختَيَّ بِدءَ حَديثِنا","وَما لِيَ مِن أَن تَعلَما مُتَأَخَّرُ",41,"ر",1,0],["أَقصَدَت قَلبي وَما إِن","أَقصَدَتهُ بِسِلاحِ",42,"ح",1,0],["أَقصِر فَلا ذاكَ الخَليلُ بَآيِبٍ","يَوماً وَلا ذاكَ الشَبابُ يُعادُ",43,"د",1,0],["أقصى المواعدِ أن تَمُرَّ عَشِيّةٌ","بالمرء سلماً أو تكُرَّ غَداةُ",44,"ه",1,0],["أَقصِرْ فما لك بالعظائمِ طاقةٌ","وَاسْكتْ فمثلُكَ لا يمرُّ ببالِ",45,"ل",1,0],["أَقصَيتِهِ وَأَرادَ سِلمَكُمُ","فَليَهِنهِ إِذ جاءَكِ السِلمَ",46,"م",1,0],["أقصَدتْهُ تِرْبَ خمسٍ أسهُمٌ","لو رَمَتْه تِرْبَ عَشْرٍ لم تكَد",47,"د",1,0],["أَقصَيتَهُ وَنَسيتَهُ","وَلِعَهدِهِ بِكَ غَيرُ ناسِ",48,"س",1,0],["أَقصَرتُ مِن قَصرِ النَهارِ وَقَد أَنى","مِنّي الغُروبُ وَلَيسَ لي إِقصارُ",49,"ر",1,1],["أقْصَرتُ بَعْضَ الإقْصارْ","عَنْ شادنٍ نائي الدَّارْ",50,"ر",1,1],["أَقْصَيْتَني مِنْ بَعْدِ مَا","أَدْنَيْتني فالقلْبُ طائِرْ",51,"ر",1,0],["أقْصِر عدِمْتُك واطّرح من أثخنتْ","أحشاءَهُ النُّجلُ العُيونُ جِراحا",52,"ح",2,0],["اقصدي في هذا البكاء قليلا","لا تكوني به علي سخيا",53,"ي",2,0],["\"أقصره ولست بمقصرٍ، جزت المدى","وبلغت حيث النجم تحتك فأربعا\"",54,"ع",2,0],["أقصى منايَ سفينة ممشوقة","وبزوغُ نجم أهتدي بضيائهِ",55,"ه",1,0],["أقصى منايَ لديه يومٌ عاصفٌ","يهفو رقيق الغيم في سبحانهِ",55,"ه",1,0],["أقصى منايَ روايةٌ محبوكةٌ","من نسيجِ قرصانِ طروبٍ ضاحكِ",55,"ك",1,0],["أقُصَّتْ نُسُورُ نُجومِ السماءِ","فلم تَستطِعْ نهْضَةً للمَغِيبِ",56,"ب",1,0],["أقصى ملوكَ الفرس وال","رومان عن عرشَيْهما",57,"م",2,0],["أقصى المدائح في تمجيده حسرت","وشأنه في المعالي غير منحسر",58,"ر",1,0],["أُقْصِي بهِ كُلَّ العُداة ِ عَنِّي","لمثلِ هذا ولدتني أمي",59,"ي",1,0],["أقصرْ لقدْ جاوزت حدَّ المنتهَى","في الجودِ والبأساءِ والإكرَامِ",60,"م",1,0],["أَقصِرا عَن مَلامَتي عاذِلَيّا","إِنَّ عَذلي يَزيدُني اليَومِ غَيّا",61,"ي",2,1],["اقصد فناهُ إذ اعترتكَ ملمةٌ","فالصَّيدُ كلُّ الصيدِ في جوفِ الفرا",62,"ر",2,0],["أَقصَدَت ضِرغامَ غابٍ","بَينَ خيسَيهِ غَريفُ",63,"ف",1,0],["أَقْصاهُ جَوْرُ البَيْنِ عن أحبابِهِ","وزَمانِه وبلادِه وشَبابِه",64,"ب",2,1],["أُقْصِي البنفسجَ ثم يُعجبني","أنْ أَنْشَقَ الظَّيّان والطَّرفا",65,"ف",2,0],["أقصى جفاء ولا أعطى بمعرفتي","وحسن فهمي بممدود ومقصور",66,"ر",1,0],["أقصى أمانيه حين يمسى","أن يهجع الخفق وانو جيب",67,"ب",1,0],["أَقصِر فُؤادي فما الذِكرى بِنافِعةٍ","ولا بِشافِعَةٍ في رَدٍّ ما كانا",68,"ن",2,1],["أَقصرتُ يا سَلْمَ عمّا تَعلمِين فما","أَصْبُو لَربْع ولا أَبْكي على طَلَل",69,"ل",1,0],["أَقصَدَني الدَهرُ بِسَه","مِ صَرفِهِ المُفَوَّقِ",70,"ق",1,0],["أَقْصَرُهَا أَمَلاً وَأَطْوَلُهَا","بَاعاً وَأَصْوَلُهَا وَأَمْجَدُهَا",71,"د",3,0],["أَقْصَدَ الْيُوسِيَّ سَهْمٌ مِنْ رَدَى","أَثْكَلَ الْعَالَمَ فِيهِ أَجْمَعَا",72,"ع",2,0],["أَقصَدنَ حُجراً قَبلَ ذَلِكَ وَالقَنا","شُرُعٌ إِلَيهِ وَقَد أَكَبَّ عَلى الفَمِ",73,"م",1,0],["أقصر من يأجوج في قده","وقرنه أطول من عوج",74,"ج",1,0],["أقْصاهُ عَنْكَ تَزَلُّفٌ بِخَطِيئَةٍ","خَالَ الصَّوابَ خِلالَها وَتَوَهَّما",75,"م",2,0],["أَقصِر فَقَد خَلَت الديارُ فَلا هَوىً","يُصبى إليه ولا مَليحٌ يُشتَهى",76,"ه",2,0],["أَقصى مَدى العلمِ منّا أنّكم قبسٌ","مِن السّراجِ الّذي اِنجابت به الظلمُ",77,"م",1,0],["أُقصي عَلى سَلوانِهِ خِلّ","لِيَ الداني صَبَّهُ القاصي",78,"ص",2,0],["أَقصر جَفاك فَإِن مِن خَلق الهَوى","خلق السلوّ فَلا يَغرَّك ما جَرى",79,"ر",2,0],["أقصِر ألم يَسمَع سوا","كَ بأنَّها دارُ الغُرورِ",80,"ر",1,0],["أَقْصِرْ فَلَومي في حُبِّهم لَمَمُ","وناصحُ العاشِقينَ مُتَّهَمُ",81,"م",1,1],["أقْصَدْتَني بالهُجْر من بعد ما","أقصدْتَني من قبلُ بالهجْرِ",82,"ر",1,0],["أقصى أمانيَّ أن أحيا شذَى وسنىً","بعد الحياة اذا التذكار أحياني",83,"ن",2,0],["أقصاه عند الناس إدلاؤه","من فضله بالنسب الأقربِ",84,"ب",1,0],["أقْصى مُؤمَّلهِ بَقاؤكَ للِعُلى","فبَقيتُما ما شَدَّ زنْداً أنْمُلُ",85,"ل",1,0],["أقصر فإنك ميت","يُهدي الفناء إليك سيله",86,"ه",1,0],["أَقصى رِفاقِيَ رَحْلي","والَهْفَ قلبي المُهَيَّمْ",87,"م",1,0],["اقصر من عنان المدح فيهم","فيغلبني ويجمح بي لجامي",88,"م",2,0],["أقصر عليك فطالما أشجاني","ريم تهيج بذكره أشجاني",89,"ن",2,0],["أَقصَرتُ عَن جَهليَ الأدنى وَحَلَّمَني","زَرعٌ مِن الشَيبِ بِالفَودَينِ مَنقودُ",90,"د",1,1],["أقصدتني عيناه يوم تلاقي","نا بفسحِ الحِمى وراح سليما",91,"م",2,0],["أقصى مرادى أنْ أراك وإنّها","أُمنيّةٌ حسبي بها لمؤمّلِ",92,"ل",1,0],["أَقصَيتِني مِن بَعدِ ما جَرَّعتِني","كَأساً لِحُبِّكِ ما تَسوغُ لِشارِبِ",93,"ب",1,0],["أُقَصِّرُ عَن