{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[39,"إذا الأرون إرو الحرب العوان لهم","https://www.aldiwan.net/poem7327.html","البسيط"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[74,"نجم تولد بين الشمس والأسد","https://www.aldiwan.net/poem18547.html","البسيط"],[74,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[53,"حزني منك يا ابنة الأملاك","https://www.aldiwan.net/poem65829.html","الخفيف"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[53,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[93,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[47,"لامت ملامة مشفق متعتب","https://www.aldiwan.net/poem11495.html","الكامل"],[47,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[47,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"انفرد الله بسلطانه","https://www.aldiwan.net/poem22038.html","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[47,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""],[53,"حزني منكِ يا بنة الأملاك","https://www.poetsgate.com/ViewPoem.aspx?id=30075",""],[132,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[137,"فتح يطاول فتحه الأحقابا","https://www.aldiwan.net/poem4248.html","الكامل"],[147,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[280,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[354,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[366,"با بي غزالا صد عني قسوة","https://www.aldiwan.net/poem68116.html","الكامل"],[369,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[438,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[445,"عمري لقد أعذر الدمع الذي وكفا","https://www.aldiwan.net/poem34796.html","البسيط"],[458,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[463,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[466,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[505,"ما انبلج الصباح في طالعه","https://www.aldiwan.net/poem37820.html","الرجز"],[519,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[520,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[556,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96999","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48741","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136314","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136192","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136188","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112806","البسيط"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31569","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122043","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49556","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49549","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109315","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53098","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53047","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88654","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94271","المتدارك"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112499","الطويل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121352","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62877","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48439","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48285","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86521","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133243","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95371","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35558","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75693","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44903","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199086","الكامل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111115","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105529","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95070","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83146","الرمل"],[4767,"مهر القريض","https://www.poetsgate.com/ViewPoem.aspx?id=194941",""],[5038,"يهنيك يا نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=188696",""],[585,"ما للديار خلت لكل شريد","https://www.poetsgate.com/ViewPoem.aspx?id=161917",""],[585,"أين القصائد أفوافاً توشيها","https://www.poetsgate.com/ViewPoem.aspx?id=161879",""],[5075,"الله مولانا","https://www.poetsgate.com/ViewPoem.aspx?id=190435",""],[5120,"معركة وادي أنوال الخالدة","https://www.poetsgate.com/ViewPoem.aspx?id=185808",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5149,"أيها القدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212221",""],[5206,"حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=187390",""],[5409,"بيني وبينك ألف القدر","https://www.poetsgate.com/ViewPoem.aspx?id=155500",""],[5425,"فأتِنَةُ الشُرفَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199027",""],[5596,"تحية الى العيينة واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=206718",""],[5720,"كيف الحب ؟","https://www.poetsgate.com/ViewPoem.aspx?id=198865",""],[5762,"الذبيح الصاعد","https://www.poetsgate.com/ViewPoem.aspx?id=13136",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5974,"هَنْدَسَةُ الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=200330",""],[6010,"أستاذة النحو ,,,","https://www.poetsgate.com/ViewPoem.aspx?id=175986",""],[6127,"أسد بابل","https://www.poetsgate.com/ViewPoem.aspx?id=188648",""]],"verses":[["وَأَستَشرِفُ الأَعلامَ حَتّى تَدُلَّني","عَلى طَيبِها مَرُّ الرِياحِ الهَواجِمِ",0,"م",1,0],["وَاِستَشفَعَت مِن سَراةَ الحَيِّ ذا شَرَفٍ","فَقَد عَصاها أَبوها وَالَّذي شَفَعا",1,"ع",2,0],["وَاِستَشِفّوا يَقينَنا رَغمَ ما نَل","قى فَهَل تَلمَحونَ فيهِ اِرتِيابا",2,"ب",2,0],["واستشفر الكلب إنكاراً لمولغه","في حولة قصرت عن نعتها الحُولُ",3,"ل",1,0],["واسْتشْرف العلم مصقولاً سوالفه","بدهره وزهتْ لليمن وجنات",4,"ت",1,0],["واستشرف القلم العالي للثم يدٍ","عريقة سوف تعلو فوق كل يد",5,"د",1,0],["واسْتشعر الماضي بها فلأجل ذا","قد كانَ فاضل دهرهِ متكمّشا",6,"ش",2,0],["واستشاطتْ من شكوِنا ثم قالت","شغلي عن مقالة الأفلاك",7,"ك",1,0],["واستشعرتْ نفسُ الجوادِ شجاعةً","فرجا الزمانَ على الزمانِ مُديلا",8,"ل",2,0],["واستَشْهَدَتْ من مَضَى منَّا فأنْبأَنا","عن ذاك كلُّ لقىً منا ومَدْفون",9,"ن",1,0],["وَاِستَشهِدي فيهِ فَمِن سُخرِ القَضا","أَن لا تَذوقيه وَأَن تُستَشهَدي",10,"د",2,0],["وَاِستَشهد الأَقمارُ أَهلُ بَيتِهِ","يَهوُون في التُرب فرادى وَثُنا",11,"ا",1,0],["وَأَستَشهِدُ الأَطوادَ شَمّاءَ وَالذُرا","بَواذِخَ تُلوي بِالنُجومِ وَتُجذَبُ",12,"ب",1,0],["وَاِستَشفَعَت بِدُموعِها وَدُموعُها","لُسُنٌ مَتى تَصِفُ الكَآبَةَ تُسهِبِ",13,"ب",1,0],["وَاِستَشَفَّت مُحَمَّدَ اِبنَ حُمَيدٍ","ما سَحيقٌ مِنَ الغِنى بِسَحيقِ",14,"ق",1,0],["وَاِستَشعَرَت أَلَماً لَمّا رَأَت أَلَمي","مِن حادِثِ البَينِ أَنساني جَوى الأَلَمِ",15,"م",1,0],["واستشعَرَتْ أجبالُها لك هَيْبَةً","حتى حَسِبناَ أنها ستَزُول",16,"ل",1,0],["وَاِستَشعَرَ العاقِلُ في سُقمِهِ","أَنَّ الرَدى مِمّا عَناهُ الشِفاء",17,"ف",3,0],["واستَشارَتْ إبْلي وما كنتُ في نَحْ","ريَ للرّكْبِ خَيْرَها مُستشيرا",18,"ر",2,0],["وَاسْتَشَفوا لِبَأْسِهِمْ فِيهِ سِرا","كَمْ تَحَامَى أَنْ يُدْرِكوهُ الأعَادِي",19,"د",2,0],["واستشهْدُوا الرحمن فيه عليكمو","وكفى بربك شاهدًا وحسيبا",20,"ب",2,0],["وَاستَشَفّتْ مُحَمّدَ بنَ حُمَيْدٍ،","ما سَحيقٌ من الغِنى بسَحيقِ",21,"ق",1,0],["واستشاطتْ من شكوِنا ثم قالت","شغلي عن مقالة الأفاك",22,"ك",1,0],["واسْتشفِ مِن أنوارها","فهواؤها يشفى السقيما",23,"م",2,0],["واستشعَرَ المُرَّاقُ مِنهُ مَخَافَةً","مَلَكَت عليهِم جيئَةً وذهابا",24,"ب",2,0],["وَاِستَشعَروا نَصراً فَكانَ عَلَيهِمُ","وَتَقَطَّعَت دونَ المُرادِ رِقابُ",25,"ب",1,0],["وَاِستَشفعوا لهُ بهِ واِنتَسبوا","مُعتَقدينَ نيلَ كلِّ قصدِ",26,"د",1,0],["وَاِستَشفَعوا الرسلَ فلمّا تشفعِ","فَقالَ للخلقِ رِضاكم عندي",26,"ي",1,0],["واسْتَشْرَفَتْ طُمَّحاً مِنْ لَثْمِ رَاحَتِهِ","إِلَى أَمَانِي فيها المَجْدُ والشَّرَفُ",27,"ف",1,0],["واسْتَشرفَتْ أمْصَارُها لإمَارة","عَقَدت لنَصر المُسْتضام لوَاءَها",28,"ا",3,0],["وَاِستَشعِرِ العِلمَ بِشِعري فَمِن","شَرحي لَهُ في خُطَبي خَطبُ",29,"ب",1,0],["وَاِستَشهَد الجِفن الضَعيف بِأَنَّني","فارَقت أَسقامي وَعدت لمرقدي",30,"د",2,0],["واستَشخصَ الطّيفُ في عَيْني فقلتُ له","أَفي كرىً زائري أم يقظةٍ قَصدا",31,"د",2,0],["واستشارَ الجموعَ فيكَ وما أَخ","طَأَ مَنْ قالَ في قتالِكَ آلَى",32,"ل",2,0],["واستشرفَتْ للبابِ فانفَتَحَتْ لها","طُرُقُ السَّلامَةِ من بحارِ الرحمةِ",33,"ه",1,0],["واسْتَشْرَفَتْ أَعيُنُ الأَبطالِ ناظِرَةً","أَيَّانَ يركبُ دِرْعَ الموتِ مُعْتَسِفا",34,"ف",2,0],["واستشهدوا في سبيل النبل ليس لهم","هم يمت لهذا العالم الفاني",35,"ن",2,0],["واستشرفَ الملوكُ من عطائه","والخلفاءُ ما استعَزَّ واحتقرْ",36,"ر",1,0],["واستشهد الصُّحُفَ الأولى بما نقلت","عنهم وما قصَّت الآثارُ والسِّيَرُ",37,"ر",1,0],["واستشزبت أُولى الجيادِ فأقبلتْ","مُتفرقاتٍ كالجرادِ المُشْعِلِ",38,"ل",1,0],["وأسْتَشِمُّ الرِّيحَ من أرْجائِهِ","وكأسُ فِكري بالمُناجاةِ حَلا",39,"ل",2,0],["واِستَشْعَرَتْ منه المشاعِرُ بالبَلا","وعَفا محسَّرُها جوىً وتحسَّرا",40,"ر",2,0],["واستشعروا وجه السما متبسماً","فيها وبشر جبينك المعهودا",41,"د",2,0],["وَاِستَشعرِ النُّجْحَ دِرْعاً","واِلبَسْ منَ اليُمْنِ بُرْدا",42,"د",2,0],["واستشهد الصحابة الأخيار","من العراق منهم عمار",43,"ر",1,0],["واستشهدوا كلهم من بعد ما","قد قتلوا أضعافهم تقحما",43,"م",2,0],["واستشهد الحسين صلى ربه","عليه لما أن تولى صحبه",43,"ه",1,0],["واستشعري إلا الحياة فإنما","هلك الرعية في هلاك الراعي",44,"ع",2,0],["واستشهدوا بضيوف قبل أرضكمُ","في الخصب والعذب من أخلاقكم نزلوا",45,"ل",3,0],["واستشعر المرتقى العالي يخاطب من","إليه يدعو إلا ساع على قدم",46,"م",1,0],["واستشعرن الوفا مني بما رقمت","اقلام علمي على تلحين اشعاري",47,"ر",2,0],["واستشعر الأمر جدا ان في عجب ال","اقدار معنى خلا عن فكر ذي الفكر",48,"ر",1,0],["واستشعفن به وادرج بمذهبه","واستغفرن وكرر حسن دعوات",49,"ت",1,0],["واسْتَشْرَفَتْ نَفْسي إِلى مُسْتَشْرَفٍ","لِلدَيْرِ تَاهَ بُحُسْنِهِ وبِطيبِهِ",50,"ب",2,1],["وَاسْتَشْعَرَتْ أَنَّنَا لَمْ نَدْرِ مَا قَصَدَتْ","فَأَرْسَلَتْ سَيْلَهَا يَسْعَى عَلَى الأَثَرِ",51,"ر",1,0],["واستشرفوا كلما أحرزتُ طائلةً","وللسنان مجالٌ ليسَ للإبر",52,"ر",1,0],["واستشعرِوا الصبرَ عنه فارساً نَدِس