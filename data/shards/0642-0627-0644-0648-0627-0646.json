{"poems":[[55,"أهز عاسية العيدان آبية","https://www.aldiwan.net/poem29936.html","البسيط"],[57,"أمنك للصب عند الوصل تذكار","https://www.aldiwan.net/poem26370.html","البسيط"],[79,"ترى لهذا السير من منتهى","https://www.aldiwan.net/poem35857.html","الرجز"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[73,"الحمد لله واجب الشكر","https://www.aldiwan.net/poem3812.html","المنسرح"],[90,"قالوا نخلد ذكره بحديقة","https://www.aldiwan.net/poem44396.html","الكامل"],[90,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[29,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[29,"قالوا نصيبك من أجر فقلت لهم","https://www.aldiwan.net/poem5959.html","البسيط"],[87,"قالوا نرى شعراءكم","https://www.aldiwan.net/poem7557.html","مجزوء الكامل"],[71,"يا مربعا لك في فؤادي مربع","https://www.aldiwan.net/poem28365.html","الكامل"],[50,"قالوا نزعت ولما يعلموا وطري","https://www.aldiwan.net/poem63428.html","البسيط"],[52,"أسعاد جودي لا شفيت سعادا","https://www.aldiwan.net/poem63955.html","الكامل"],[78,"دعني أصن حر وجهي عن إذالته","https://www.aldiwan.net/poem39447.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[108,"قالوا نكرمه","https://www.poetsgate.com/ViewPoem.aspx?id=179748",""],[98,"ردّوا على الوادي ربيه نهاره","https://www.poetsgate.com/ViewPoem.aspx?id=13208",""],[92,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[112,"علم الغايبيني","https://www.poetsgate.com/ViewPoem.aspx?id=8404",""],[190,"قالوا نراك بلا أهل ولا ولد","https://www.aldiwan.net/poem43977.html","البسيط"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[276,"محدثي عن فريق فارقوا العلما","https://www.aldiwan.net/poem52058.html","البسيط"],[276,"هم الأحبة إن جاروا وإن عدلوا","https://www.aldiwan.net/poem52090.html","البسيط"],[287,"أكثرت فيمن أهوى ملامك","https://www.aldiwan.net/poem32416.html","مخلع البسيط"],[302,"جاء البشير مبشرا","https://www.aldiwan.net/poem32928.html","مجزوء الكامل"],[325,"قالوا نجاشي البحيرة ناله","https://www.aldiwan.net/poem67148.html","الكامل"],[325,"مالي أرى شمس المسرة أشرقت","https://www.aldiwan.net/poem67157.html","الكامل"],[353,"وحاسد مارق لما رأى","https://www.aldiwan.net/poem20776.html","السريع"],[376,"قالوا نراك ترجل","https://www.aldiwan.net/poem57143.html","الكامل"],[400,"قالوا نراه يسل شعر عذاره","https://www.aldiwan.net/poem3673.html","الكامل"],[408,"قالوا نراك طويت عن ذكر الصبا","https://www.aldiwan.net/poem46691.html","الكامل"],[415,"قالوا نهته الأربعون عن الصبا","https://www.aldiwan.net/poem32048.html","الكامل"],[447,"شوقي إليك على نواك أهامني","https://www.aldiwan.net/poem14321.html","الكامل"],[556,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77543","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77592","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70700","البسيط"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96674","الكامل"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111291","البسيط"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29611","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108983","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108916","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108689","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128012","البسيط"],[1786,"","https://poetry.dctabudhabi.ae/diwan/poem/121956","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132252","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76674","الكامل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142768","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27862","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109668","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77217","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137363",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130762","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83206","الكامل"],[2869,"","https://poetry.dctabudhabi.ae/diwan/poem/145168","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204894","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100829","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100854","الكامل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110766","الكامل"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203630","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121603","الكامل"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124098","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112627","الرجز"],[3704,"","https://poetry.dctabudhabi.ae/diwan/poem/146109","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117898","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95336","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90927","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81689","الكامل"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125350","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33784","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4675,"الإحتفال بالمولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=193538",""],[4883,"كأس من بُرتقال","https://www.poetsgate.com/ViewPoem.aspx?id=48401",""],[3749,"أقبل ذو دولة فقالوا","https://www.poetsgate.com/ViewPoem.aspx?id=134963",""],[3749,"قالوا نراك عن الأكابر تعرض","https://www.poetsgate.com/ViewPoem.aspx?id=134969",""],[5277,"جودي بسانحةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=191154",""],[5358,"قالوا نساك","https://www.poetsgate.com/ViewPoem.aspx?id=21900",""],[5401,"بدون عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=142370",""],[5605,"دمعة على (عيلان)","https://www.poetsgate.com/ViewPoem.aspx?id=179779",""],[5672,"عطر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=206437",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5956,"أَمَرَ البصيرُ نبيَّه","https://www.poetsgate.com/ViewPoem.aspx?id=192631",""],[6093,"ضلعُ آدم ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176003",""],[6093,"الجلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201050",""]],"verses":[["قالوا نَعُدُّكَ لِلجُلّى فَقُلتُ لَهُم","حَسبي مِنَ الرَيِّ ما لا يَبلُغُ الشَرَقا",0,"ق",2,0],["قالوا نَسيرُ فَلا ساروا وَلا وَقَفوا","وَلا اِستقَلَّت بِهِم لِلبَينِ أَكوارُ",1,"ر",1,0],["قالُوا نُريدُ البُرجْ قلْتُ ارْجِعوا","عنْ سهْوِكُمْ قد جُزْتُ بُرْجَ السُّها",2,"ه",2,0],["قالوا نِمارٌ فَبَطنُ الخالِ جادَهُما","فَالعَسجَدِيَّةُ فَالأَبلاءُ فَالرِجَلُ",3,"ل",1,0],["قالوا نِفاقاً وَلَيسَ يَفرُقُ في ال","إِسلامِ بَينَ النِفاقِ وَالكُفرِ",4,"ر",1,0],["قالوا نخّلد ذكره بحديقة","غنّاء فيها تنبت الأزهار",5,"ر",1,1],["قالوا نحا شقّةً قصوى وما علموا","بأن عزمك يدني أبعد الشقق",6,"ق",1,0],["قالوا نَرى الآلَ يَزهى الدَومَ أَو ظُعُناً","يا بُعدَ مَنظَرِهِم ذاكَ الَّذي نَظَروا",7,"ر",3,0],["قالوا نَصيبَكَ مِن أَجرٍ فَقُلتُ لَهُم","مَن لِلعَرينِ إِذا فارَقتُ أَشبالي",8,"ل",2,1],["قالوا نرى شعراءكم","يتمرنون على قفاه",9,"ا",2,1],["قالوا نظنُّ ديارَهُ مملوءَةً","ذهباً فماتَ وكلُّ دارٍ بلقعُ",10,"ع",1,0],["قالوا نَزَعتَ وَلَمّا يَعلَموا وَطَري","في كُلِّ أَغيَدَ ساجي الطَرفِ مَيّاسِ",11,"س",1,1],["قالوا نَكُدُّكَ بِالهَوى وَتَكَدُّنا","المَعيشَةُ ما بَلَغتَ كِدادا",12,"د",2,0],["قالوا نَأَيتَ عنِ الإخوانِ قلتُ لهم","ما لي أخٌ ما تُطوَى عليهِ يَدي",13,"ي",1,0],["قالوا نُفِيت فهل نفى عنك الهوى","ظُلمٌ سُقِيتَ الأمس كأس عقارِهِ",14,"ر",2,0],["قالوا: نُكرمه، فقلتُ: علاما؟","بِمَ يستحقُّ جنابهُ الإكراما؟",15,"م",2,1],["قالوا نفيت ! فهل نفى عنك الهوى","طلم سقيت الأمس كأس عقاره",16,"ر",2,0],["قالوا : نَزالِ . فقلت : هل يخشى الوغى","قلبي واسمر قده معشوقه",17,"ق",2,0],["قالو أنّك .. ماخذن بزغة الاهلّه","وفلسفة هتلر . وحنكة موسليني",18,"ن",2,0],["قالوا نراك بلا أهل ولا ولد","ولا نراك تحبّ الجمع والعددا",19,"د",2,1],["قالوا نَشَأتَ بِأَرضِنا وَلِساننا","عِندَ الفَصاحَةِ عَن لِسانكِ واني",20,"ن",2,0],["قالوا ندمت عَلى ما كانَ من زمن","فقلت مالي أَن لا أَظهر الندما",21,"م",2,0],["قالوا نزيلك لا يؤذي وَها اناذا","دَمي وَعرضي مباح وَالحمى همل",22,"ل",1,0],["قالَ وَأَنّى تَرى خَيالاً","في اللَيلِ مِمَّن نَفى مَنامَك",23,"ك",1,0],["قالوا نَعَم هو ذاكَ مَن","فاقَ الوَرى من غير مَينِ",24,"ن",1,0],["قالوا نَجاشِيُّ البُحَيرَةِ نالَهُ","كَرَمُ العَزيزِ بِرُتبَةِ المُتَمايِزِ",25,"ز",1,1],["قالوا نِعمَ قَد لاحَ في تاريخِنا","خَيرٌ إِلى عَبدَ المَجيدِ فَريدِ",26,"د",1,0],["قَالَ وإنَّ الحَقَّ في قَولِه","يَكفِيهِ أَنْ يَحيَا لَهُ يَحيى",27,"ي",2,0],["قالُوا نَراكَ تَرَجَّل","تَ قلتُ لما رَكِبتُم",28,"م",1,1],["قالوا نراه يسل شعر عذاره","وسباله مستهتراً بزواله",29,"ل",2,1],["قالوا نراكَ طويت عن ذكرِ الصِّبا","كشحاً ومثلكَ مَنْ يحنُّ إليهِ",30,"ه",1,1],["قالوا نهته الأربَعون عن الصِّبا","وأخو المشيبِ يجورُ ثُمَّتَ يَهتدي",31,"د",2,1],["قالوا نراك غدوت أحدب شايباً","قلت الفارق لمن أحب أشابني",32,"ن",2,0],["قالوا نراك بلا سُقْمٍ فقلتُ لهمْ","السُّقمُ في الجسمِ ليس السُّقْمُ في البدنِ",33,"ن",1,0],["قالوا نعم قلنا فليس يعدو","قول النبي في الذي يحد",34,"د",1,0],["قالَ وَإِن وَقَعت جوف هوةِ","لَكن أزيلها بِفرط قوَّتي",35,"ي",1,0],["قالوا نَعم يَسكن هَذا وَحده","مَن ذا يطيق هَمَّه وَكَيده",36,"ه",1,0],["قالوا نراك غريباً في ديارهمُ","فقلتُ دعهمْ وذَرْهُم بئس ما قالوا",37,"ل",3,1],["قالوا نراك غير عدل في القضا","جرى علينا في الرضا يك القضا",38,"ض",2,0],["قالوا نراكَ بحبِّ سعدى هائماً","أَبداً تُكابدُ لوعةً وتقاسي",39,"س",2,0],["قالوا نراك تذيع الحب قلت لهم","ان الحبيب الذي أهواه ستار",40,"ر",1,0],["قالوا نُهَنِّيكَ بِالعيدِ الكَبيرِ فَقَد","وافى وَتَركُ الهَنا مِن أَعظَم الكبَرِ",41,"ر",1,0],["قالوا نسيت بها اِبراهيم قلت لهم","لا عشت إن كنت يا ناسي له ناسي",42,"س",2,0],["قالوا نراك تحب اليوم يافعةً","ما صف في صدرها الرمانُ كيزانَهْ",43,"ن",2,1],["قالوا نأت ليلى فقلت لصاحبي","لم يبق لي إلا الدموع عقار",44,"ر",1,0],["قالوا نراك بحب الترك في شغف","موله القلب والاحشاء في لهب",45,"ب",1,1],["قَالُوا نَرَى ابنَ فُلانِ الديِّنِ ذا غَلَطٍ","كأَنَّهُ مِن جِبالِ الصُّمِّ مَنحُوتُ",46,"ت",1,1],["قالوا نشوان فقلت لهم أجل","من سكر خمر رضابها المعطار",47,"ر",1,0],["قالوا نعم فوضعت خدي في الثرى","شكراً له وتيمناً ببنيه",48,"ي",2,0],["قالوا نراكَ ببيتٍ واحدٍ ولقدْ","تضيقُ عنكَ على رُحْبٍ بها الحُجَرُ",49,"ر",1,1],["قالوا نزلنا رسلا حفظا","ختم النبي المصطفى المجتبى",50,"ب",2,0],["قالوا نراك على الأذية صابرا","لا تشتكي من سوء فعل المعتدي",51,"ي",1,1],["قالوا نَظَرتَ إِلَيهِ نَظرَةَ شاعِرٍ","ماذا قَطَفتَ لَنا فَقُلتُ مُداعِبا",52,"ب",2,0],["قالوا نعم هذا فلان من له","ذهن بآداب الانام توقدا",53,"د",2,0],["قالوا نأى جانباً عن عبده وغدا","والحب بينهما بالصدّ مرفود",54,"د",1,0],["قالوا نَقِمتَ عَلى الزَمانِ وَفاتَهُم","غَدرُ الزَمانِ وَجهلُهُ بِرِضائي",55,"ا",2,0],["قالوا نرى ناصر الإسلام منذ ولى","لم يدخر ذهباً عن أهل دولته",56,"ت",2,1],["قالوا نبجل فعل الخير فيمَ اذن","لم يمنحوا خيّرا في الشعب تبجيلا",57,"ل",2,0],["قالوا نهضتم نهضة قال الورى","فيها أتلكم نهضة أم ثار",58,"ر",1,0],["قالوا نكثتم بالامير وانه","خير امرئ يرعى لديه ذمار",58,"ر",1,0],["قالوا نعاءِ فأَججوا جمر الغضا","في مهجتي لما سمعت الناعيا",59,"ي",2,0],["قالوا نعم حسن فقلت هلاكه","قالوا الطويل فقلت ليل شتاته",60,"ه",1,0],["قالوا نراك بكل فنٍ عالماً","فعلام حظك من دناك خسيس؟",61,"س",1,1],["قالوا نراك سقطْتَ من رُتَبٍ","أترى الزمانَ بمثل ذا غلِطَا",62,"ط",2,1],["قالوا نرى الظبي يحكيه فقلت لهم","لا الظبي يحكيه لا ساقا ولا كفلا",63,"ل",2,0],["قالوا نعم خيرُ البرايا حَسَبا","وخيرُهُم جدّا وأما وأبا",64,"ب",2,0],["قالوا: نحيف قلت: لا تعجبوا","فإنه سلك لآلي الجمال",65,"ل",1,1],["قالوا نعم إن لم تكن","فحشا فليس بها جناح",66,"ح",1,0],["قالوا نساءَ دنَف وقالوا","أبو فلا