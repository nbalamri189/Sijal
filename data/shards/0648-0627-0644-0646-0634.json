{"poems":[[457,"حتام تبدو لنا وتحتجب","https://www.aldiwan.net/poem13634.html","المنسرح"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45201","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101895","الرجز"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101896","الرجز"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143479","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66447","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136939",""],[4767,"شمس آل الخليفة","https://www.poetsgate.com/ViewPoem.aspx?id=88610",""],[5111,"الْبَدْءُ سِيرْتَا","https://www.poetsgate.com/ViewPoem.aspx?id=212610",""]],"verses":[["والنَشْر بين الرياض منفتقٌ","والزِقُّ بن الدِنان منسحبُ",0,"ب",1,0],["وَالنَشَواتِ مَن عَتيقٍ صافِ","وَعَزفِ قيناتٍ عَلَينا عُزّافِ",1,"ف",1,0],["وألن شكيمة طرف قلبي عله","ينقاد للخيرات بعد شماس",2,"س",1,0],["والنشر فيما أنبت اللحم وشد","عظم الرضيع ثابت من غير رد",3,"د",1,0],["والنشر في الزمان أدنى مدته","رضاع يوم كامل وليلته",4,"ه",1,1],["والنشر من بعد البلى","والود في أثر القلى",5,"ا",1,0],["والنشر ضاع مأرجّاً ومجرّراً","للعطر قبلاً ندّ عن ريّانه",6,"ن",2,0],["والنشء كالنبت ان تعهد مغارسه","إلى الخبير اتى بالرّيق الرطب",7,"ب",1,0],["والنشيج الذي توالى تلقت","أمره الفادح الجموع فسابت",8,"ت",1,0],["وَالنَّشْءُ تَصْدَحُ لِلْعُلْيَاءِ مِنْ قُدَسٍ","أصَلِيْ هُنَا ، وَهُنَا بِالأرْضِ نَلْتَحِمُ",9,"م",1,0]]}