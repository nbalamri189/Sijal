m/ViewPoem.aspx?id=205467",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5691,"هراوة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=206339",""],[5693,"يا مجرّات الثريا .","https://www.poetsgate.com/ViewPoem.aspx?id=35144",""],[5725,"لا غالب اليوم الا الله ياوطني","https://www.poetsgate.com/ViewPoem.aspx?id=201303",""],[5751,"صلاة الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=214777",""],[5829,"لو تعلمين","https://www.poetsgate.com/ViewPoem.aspx?id=160313",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"جنازة خنزير صهيوني يحضرها عملاء عرب","https://www.poetsgate.com/ViewPoem.aspx?id=202517",""],[5997,"كهف العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=214282",""],[6160,"خَيْبَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87088&r=&rc=5",""],[6229,"القبّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65189&r=&rc=15",""],[6315,"البَيدَاءُ وَ الجَنِينُ المُرتَقَب ... تَحِيَّتَانِ للأُنثَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87577&r=&rc=2",""]],"verses":[["فيَتْرُكُ في النّاسِ أمْثالَهُ","تُحدِّثُ لي رَغْمَ أنْفِ البِلا",0,"ل",2,0],["فيتَّقي الله أو مسبَّتَكُم","فيختصي أو يَئيم أو يئدُ",1,"د",1,0],["في تراكيبَ خمسةٍ تنشأ ال","أصباغ في مائنا النقيّ النميرِ",2,"ر",1,0],["في تَوبَةٍ مِن تائِبٍ أَو رَهبَةٍ","مِن راهِبٍ أَو رَغبَةٍ مِن راغِبِ",3,"ب",1,0],["في تِسعَةٍ وَلِواءٌ بَينَ أَظهُرِهِم","لَم يَنكُلوا عَن حِياضِ المَوتِ إِذ وَرَدوا",4,"د",3,0],["في تقاصيرَ من الدّرّ إذا","حاولوا تحصيلهَا فهيَ حِكَم",5,"م",1,0],["فيَّ تعريفٌ وعدْلٌ","فانصرافي للضرورهْ",6,"ه",1,0],["في تيهِ مَهمَهَةٍ كَأَنَّ صُوِيَّها","أَيدي مُخالِعَةٍ تَكُفُّ وَتَنهَدُ",7,"د",1,0],["فِي تَرَاكِيبِهِ وَفِي مُفْرَدَاتِ اللَّ","فْظِ حَارَتْ نَفَاسَةُ الحُسَّادِ",8,"د",1,0],["فيتحدون أخلاقا عذابا","ويأتلفون مجتمعا رزينا",9,"ن",2,0],["في تصيبينَ لَبِسنا حُسنَها","وَعَلى التَلِّ لَبِسناها مَعابا",10,"ب",2,0],["فيتَّقي الله في مشيئته","فيختصي أو يَئيم أويئد",11,"د",1,0],["في تِلوِهَا بَينَهُما يَمكُثُ مَا","يُكَبِّرُ المَأمُومُ فِيهِ فَأعلَمَا",12,"م",2,0],["فَيَترُكُ أَقوالَ الأَنامِ كَأَنَّما","بِهِ صَمَمٌ عَنها وَيَمضي مُصَمِّما",13,"م",2,0],["فئتان مختلفان جدا هذه","مثل الضباب وتلك كالنينان",14,"ن",1,0],["في تُربةٍ كَتبَ المُؤرِّخُ فَوقَها","يا رَمسُ قَد حَزَتَ المرادَ فَاِبشِرِ",15,"ر",1,0],["في تُربةٍ كَتبَ المُؤرِّخُ فَوقَها","ان النَزيلَ بِدارِ رَبكَ غالِبُ",16,"ب",1,0],["في تجلّي الصفات صفو المرائي","وتجلّي الأفعال في كلّ شييّ",17,"ي",1,0],["في تاجِهِ قَمَرٌ وَفي ثِنتَي مُفا","ضَتِهِ هِزَبرٌ بِالحَديدِ مُسَربَلُ",18,"ل",1,0],["فَيَترُكُ القِرنَ مُصفَرّاً أَنامِلُهُ","كَأَنَّ في رَيطَتَيهِ نَضخُ إِرقانِ",19,"ن",1,0],["فَيَتِمُّ المُنى لِقَلبٍ عَلَيهِ","كُلُّ يَومٍ يُجَرِّدُ اللَحظَ سَيفَه",20,"ف",2,0],["فَيَتركها إِذا اِضطربت بِطعنٍ","وَيَنهبها إِذا اِشتَجَرت قَناها",21,"ا",3,0],["في تضاعيف نفسه","تنطوي عبرة العبر",22,"ر",1,0],["في تشاعيب حانة","يحتويها رشا أغن",23,"ن",1,0],["فيتْرُكَ اللّيلَ أَغَرّ","ويَشْفيَ العينَ نَظَر",24,"ر",1,0],["في تركيا شدتّ الأمجاد مئزره","وأيّنعت ثمرات الرّوض وازدهرا",25,"ر",2,0],["فِئَتِي ألتَجِي إليهِ من الخَطْ","بِ وذُخرِي إن غَال وَفْريَ غولُ",26,"ل",1,1],["في تُرْبَةٍ جادَ النَّعِيمُ رِياضَها","فَتَفَتَّحَتْ بِنَوَاعِمٍ أَتْرَابِ",27,"ب",1,0],["فيُتْبعُ الحُجَّةَ الغَرَّاء ضرْبتهُ","الرَّعْلاء حتى يحين الحتف والهرب",28,"ب",1,0],["فيتّقيْ فعلةَ فرعون من سبقوا","ويدّعيْ أنّهُ باللهِ مُعتضدُ",29,"د",1,0],["في تربةِ الكلماتِ عَمَّقَ حَرْثَهُ","فتَنَزَّهَتْ كلُّ العصورِ بِحَقْلِهِ",30,"ل",2,0],["في تُربةٍ كتبَ المؤرّخُ فوقَها","نالَ السَّعيدُ سَعادةَ الدَّارَينِ",31,"ن",1,0],["في تُربةٍ قُلتُ لمَّا أرَّخوه بِها","يا ويحَ قلبي على غُصنٍ قد انقَصفَا",32,"ف",2,0],["فيتلو على أصحابهِ آيةَ الضُّحَى","ويتلو على أعدائِهِ آيةَ النَّحرِ",33,"ر",1,0],["في تركها ما أوجب الله له","قال الذي قد قلتم إن قاله",34,"ه",1,0],["فيتيمهم وجد الحنان كأنه","لم يفقد الأهلين في يوم غبر",35,"ر",1,0],["في تاجِه قَمرٌ وحَشو دِلاصِه","أسَدٌ وفي يَدِهِ خِضَمٌّ مزبد",36,"د",1,0],["في تاجِهِ قَمَرٌ في دِرعِه قَدَرٌ","في بَطنِ كَفَّيهش سَيحانٌ وَجيحانُ",37,"ن",1,0],["في تاجِه قَمَرٌ وحَشوُ دِلاصِهِ","أسَدٌ وفي بُردَيه بَحرٌ زاخِر",38,"ر",1,0],["فَيتنَ ينهن الحَبوبَ بِها","وَأَبيتُ مُرتَفِقاً عَلى رَحلي",39,"ل",2,0],["فيتلاشى جسدي تلاشيا","أو أحرز النصر على أعدائيا",40,"ي",2,0],["في تحسبنَّ الهوى بحالته","طارَ جرادُ الهوى وما غَرَّز",41,"ز",1,0],["في تِلكَ رَسم الصَيد بِالنُقوشِ","وَتِلكَ فيها صُور الوحوش",42,"ش",1,0],["في تومبيلَ يَخرِق القِفارا","سُبحان من سَخَّرَه تسيارا",43,"ر",2,0],["في تومبيلَ في مَدا ساعات","ثَلاثَة في نضرةِ الرَّوضات",43,"ت",1,0],["في تَومبيل مُسرع التسيار","لا يختشي مِن آفَة العِثارِ",43,"ر",1,0],["في تومبيلَ فاقَ في الإِسراع","لِما عَسى يَحدثُ لا يُراعى",43,"ع",2,0],["في تيه كسرى وخفوف أهوج","ذي منسر كاللهذم المعوج",44,"ج",1,0],["في تجرباتِ البرايا","أصاغرٍ وأكابر",45,"ر",1,0],["في تثنيه نشاط","ما وفي عينيه فترَه",46,"ر",2,0],["في تاجِهِ قمرٌ وباطن كفّهِ","بحرٌ وبطنُ الدرع ليثٌ ضارِ",47,"ر",1,0],["فيتبعكم بادي الصبابة عاشق","له بعد نوم العاشقين نحيب",48,"ب",1,0],["في تاء تأنيث يروا بالهاء","وقفا وغيرهم يرى بالباء",49,"ا",2,0],["فِئَتان طاغِيَةٌ وَباغِيَةٌ","جَلَّت أُمورُهُما عَنِ الخَطبِ",50,"ب",1,1],["في تلايا الليل من نومه يهِبّ","للتهجّد عند شيبه والشباب",51,"ب",1,0],["في تهانٍ لها إليك اختلافٌ","وسعودٍ لها عليكَ ائتلافُ",52,"ف",1,0],["في تلاع العذيب آرام رمل","باديات في صورة الأعراب",53,"ب",1,0],["فيتولاني الذي ان اكسب","ولاية منه فذاك محسبي",54,"ب",2,0],["في تخته من تحته كم شخّ كم","وبفعل ذلك لم يصر مذموما",55,"م",2,0],["فَيَترُكُ أَو يَأتي مِنَ الأَمرِ بَعدَما","يُقَلِّبُ فيهِ رَأيَهُ وَيُراجِعُه",56,"ع",2,0],["في تضاعيفه عبير من الود","د وعرف من الهوى والشجون",57,"ن",1,0],["في تقاليد عندهم ورثوها","أو بتقليد مدعي التمدين",58,"ن",1,0],["فَيَتِيهُ فِي مِحْرَابِهِ وجَنَانُهُ","بِالعَرْشِ يَستَجْدِي الرَّحِيمَ ويَعْبدُ",59,"د",1,0],["في تساويهما الكمال والا","اصبحا عرضة لنقص يشين",60,"ن",1,0],["في تولي الإمام وحي من الله","وعاه عن جبرئيل النبي",61,"ي",1,0],["في تربة على شمال النازل","ومعه اكارم افاضل",62,"ل",1,0],["فيتحفني حين اللقا بتبسم","سروراً وللإكرام بالوقفات",63,"ت",1,0],["فِئَتانِ عَقدُهُما شَريعَةُ أَحمَدٍ","بِأَبي وَأُمّي ذانِكَ الفِئَتانِ",64,"ن",1,0],["فِئَتانِ سالِكَتانِ في سُبلِ الهُدى","وَهُما بِدينِ اللَهِ قائِمَتانِ",64,"ن",1,0],["في توبة الخمسين يشغله","وجه ويملأ صدره رغبا",65,"ب",2,0],["فيتخذ النشاط له حليفاً","وينبغ بالفضائل والعلومِ",66,"م",1,0],["فيت مُدَّة يومي إذ مضى سلفاً","كانت ومدَّة أيامي على قدرِ",67,"ر",1,0],["فِي تَبُوكٍ تَبَدَّتَ آيٌ وَبَانَت","قَاصِعَاءُ النِّفَاقِ والنَّافِقَاءُ",68,"ا",2,0],["في تلال أَو فَلاة","نَلتَقي في بيت راع",69,"ع",1,0],["في تحف الرب هفست تميس","فأبصرت آخيل فوق الثرى",70,"ر",2,0],["فيتحف آخيلا بما طاب قلبه","به من عتادٍ شائقٍ ومزخرف",71,"ف",1,0],["في تلكم الطلعةِ الغرا تفيض على","ذاك المحيا صفاتٍ ذات تأثير",72,"ر",1,0],["في تل أبيبَ بنو صهيونَ قد نصبوا","تمثال حاخامهم هاري ترومانِ",73,"ن",1,1],["في تربة من صنع أيدي القر","قد حنطت أجيادها بالعطر",74,"ر",1,0],["في تَجلياتك الكُب","رى وَفي مَظهَر ذاتك",75,"ك",1,0],["في تَضاعيفها يَروح وَيَغدو","وَعَلى صَدرِها يَعيش زَمانه",76,"ن",2,0],["في تليل كأنه جذع نخل","متمهل مشذب الأكراب",77,"ب",1,0],["في تجنِّيكَ والجَفا إِفراطُ","فَإلى كمَ تَجبُّرٌ واشتطاطُ",78,"ط",1,1],["في تلك الشعاب","مع رشف شهد الرضاب",79,"ب",1,0],["في تلك البلاد","ونلتقي بالمفضل",79,"ل",1,0],["في تنادي الورود حول مساء","يتحمى بعطرك الياسمين",80,"ن",1,0],["فيتم مثقالان مع قرشين مك","ملة ثمانين من الأقراش",81,"ش",1,0],["في تضحياتٍ لن تشاهدَ مثلها","خير العباد بكلّ خيرٍ ناجحَةْ",82,"ح",2,0],["في توبةٍ مهْديّةٍ لمْ تكْتمِلْ","إلاّ بِحبّ الخمْسةِ الأطْهارِ",83,"ر",1,0],["فَيَتْبَعُهُ مِنَ الْأَعْرابِ عِلْجٌ","إِذا أَمْسى بِوادٍ كانَ نَحْسا",84,"س",2,0],["في تسَابيحَ العَذاَرى وَالمَدا","ترقصُ الأفْلاكُ فِيْ ثَوبٍ رَفِيْهِ",85,"ي",2,0],["فَيَتُوهُ اللفْظُ أفْقًا","يَنْسُجُ الآه غَرَامَهْ",86,"م",2,0],["في تضاعيف حسنه روح عشق","هم الناظرون وجداً وتاهوا",87,"ا",1,0],["في تضاعيفه تواتر للوحي","نزول يوحيه بر رؤوف",88,"ف",1,0],["فيتحفه متهماً منجدٌ","ويتحفه منجداً متهم",89,"م",1,0],["في تسع عشرة مات تاج الدين","وإما منافي التسع والعشرين",90,"ن",1,0],["في تسع عشر من الحج انقضت بضيا","يغشى العيون فأرخ , أي غشيان",91,"ن",1,0],["في تحيّاتي له المنّا","طايرٍ باعلا البساتينا",92,"ن",2,0],["في توحّدنا تكون المعجزاتي","يوم عن خلفٍ وعن فرقهْ نتوب",93,"ب",1,0],["في تلكم العينين ظلُّ سحابةٍ","هطلتْ فبلّتْ نحرَها وثيابَها",94,"ب",3,0],["في تيهِ موجدتي وجدٌ يحاورني","هلّا وجدتَ بملقى بوحهِ الوجدا",95,"د",2,0],["في تاسعِ العشْر من ذي حجّةٍ وسطٍ","فاز عليٌّ بوعدٍ خيرِ إيمان",96,"ن",1,0],["فى تعالى المرء عن أنداده","سبة كبرى ويغدو محتقر",97,"ر",1,0],["فيتبعوا القول الصواب الذي له","شواهد من نص النبي ابن هاشم",98,"م",1,0],["فيتسع البثق الممض وترتخي","ذيول حناديس الشرور وتنسدل",99,"ل",1,0],["في تربها أنبياء الله قد رمسوا","بالطهر مجبولة ممزوجة بدم",100,"م",1,0],["في ترانيمه الرقيقة رقي","لك من شر كل باغٍ وماكر",101,"ر",1,0],["في تلال الشوق رحنا","نرتوي الآمال وصلا",102,"ل",2,0],["في تلة الجوع كان البعض يرمقنا","حشدٌ بقافلة الحساد قد رمقا",103,"ق",2,0],["في تربةِ الرَّمسِ الحزينِ حلاوةٌ","وجهُ التَّرابِ على المزارِ بَشُوشُ",104,"ش",1,0],["في تغاريد المحبه ؟ ساكنه جوف المحاني","كنّك وكنّي' ياكل الناس' نمشي فوق غيمه..!",105,"م",2,0],["فيتبعونك أنَّى سرت متجهاً","لأنهم أصبحوا من أهلك اللُزَمِ",106,"م",1,0],["فيتو...هَراوةُ أمْريكا وسطْوَتُها","على حُقوقِ شُعوبِ الأرْضِ إجْحافا",107,"ف",2,0],["في ترانيم السكاري","أرسلوني للولوج",108,"ج",1,0],["فيتّمتْ كل دمعاتي بلا مقلٍ","كأنني من عقيم الآه انجبها",109,"ب",3,0],["فَيُتَمْتِمُ الليمون مِن قِدّاحِهِ","عطرًا يمارسُ في القلوبِ مكائدَهْ",110,"د",2,0],["فيتوق للذكرى ويكفر بالنوى","ويحن كلّ دقيقة للملتقى",111,"ق",2,0],["في تونس الخضراء قد جف الندى","ودنت إليه نواحل الأغصان",112,"ن",1,0],["في تاسع من رابع في الثان من","بعد المئين وللأمور مضاء",113,"ا",2,0],["في تل أبيبَ وبيت قدس والحمى","صهيون تقهرنا وفي صحرا النقبْ..",114,"ب",1,0],["في توابيْتٍ على أقْفالها","دمعة ثكْلى وعرجوْن بليد",115,"د",1,0],["في ترابِ المَدَى حَمَلْتُ حَرِيقي","وَانْطَفأْنَا مَعًا بِنِصفِ المَضِيقِ",116,"ق",1,1],["فيتّخذُ الصوتُ الذي تستجدّهُ","مع الريحِ في رحب الفضاءِ سبيلا",117,"ل",2,0],["في تَمرَةِ البَدَوِيِّ القحِّ يَنْفُثُها","شَجْوُ الدُّهُورِ تحِيَّاتٍ وترحَابا",118,"ب",2,0]]}