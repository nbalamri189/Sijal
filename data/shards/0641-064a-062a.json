{"poems":[[77,"جزتني غرناطة بعد ما","https://www.aldiwan.net/poem35718.html","المتقارب"],[51,"ترى ابن سيرين ما رأى حلما","https://www.aldiwan.net/poem61825.html","المنسرح"],[62,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[58,"ألله حي قديم قادر صمد","https://www.aldiwan.net/poem31103.html","البسيط"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[69,"أنا إن سافرت عنكم","https://www.aldiwan.net/poem28966.html","مجزوء الرمل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[85,"أنا من بدل بالكتب الصحابا","https://www.poetsgate.com/ViewPoem.aspx?id=488",""],[51,"تُرَى ابن سيرينَ ما رأى حُلُماً","https://www.poetsgate.com/ViewPoem.aspx?id=27625",""]],"verses":[["فيَتْرُكُ في النّاسِ أمْثالَهُ","تُحدِّثُ لي رَغْمَ أنْفِ البِلا",0,"ل",2,0],["فيتَّقي الله أو مسبَّتَكُم","فيختصي أو يَئيم أو يئدُ",1,"د",1,0],["في تراكيبَ خمسةٍ تنشأ ال","أصباغ في مائنا النقيّ النميرِ",2,"ر",1,0],["في تَوبَةٍ مِن تائِبٍ أَو رَهبَةٍ","مِن راهِبٍ أَو رَغبَةٍ مِن راغِبِ",3,"ب",1,0],["في تِسعَةٍ وَلِواءٌ بَينَ أَظهُرِهِم","لَم يَنكُلوا عَن حِياضِ المَوتِ إِذ وَرَدوا",4,"د",3,0],["في تقاصيرَ من الدّرّ إذا","حاولوا تحصيلهَا فهيَ حِكَم",5,"م",1,0],["فيَّ تعريفٌ وعدْلٌ","فانصرافي للضرورهْ",6,"ه",1,0],["في تيهِ مَهمَهَةٍ كَأَنَّ صُوِيَّها","أَيدي مُخالِعَةٍ تَكُفُّ وَتَنهَدُ",7,"د",1,0],["فِي تَرَاكِيبِهِ وَفِي مُفْرَدَاتِ اللَّ","فْظِ حَارَتْ نَفَاسَةُ الحُسَّادِ",8,"د",1,0],["فيتحدون أخلاقا عذابا","ويأتلفون مجتمعا رزينا",9,"ن",2,0],["في تصيبينَ لَبِسنا حُسنَها","وَعَلى التَلِّ لَبِسناها مَعابا",10,"ب",2,0],["فيتَّقي الله في مشيئته","فيختصي أو يَئيم أويئد",11,"د",1,0]]}