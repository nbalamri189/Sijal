{"poems":[[77,"جزتني غرناطة بعد ما","https://www.aldiwan.net/poem35718.html","المتقارب"],[51,"ترى ابن سيرين ما رأى حلما","https://www.aldiwan.net/poem61825.html","المنسرح"],[62,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[58,"ألله حي قديم قادر صمد","https://www.aldiwan.net/poem31103.html","البسيط"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[69,"أنا إن سافرت عنكم","https://www.aldiwan.net/poem28966.html","مجزوء الرمل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[85,"أنا من بدل بالكتب الصحابا","https://www.poetsgate.com/ViewPoem.aspx?id=488",""],[51,"تُرَى ابن سيرينَ ما رأى حُلُماً","https://www.poetsgate.com/ViewPoem.aspx?id=27625",""],[133,"صلاة عيد من عليه الجمعه","https://www.aldiwan.net/poem54660.html","الرجز"],[144,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[161,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[183,"لبني مسلم بعد فقد مرادهم","https://www.aldiwan.net/poem61172.html","الكامل"],[183,"زر باكرا قبر ابن شاول الذي","https://www.aldiwan.net/poem67012.html","الكامل"],[260,"موقع النجم في الحمى الشرقي","https://www.aldiwan.net/poem35936.html","الخفيف"],[283,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[300,"لو كان للدهر مال عند مُتلده","https://www.aldiwan.net/poem427.html",""],[321,"دع لتيه الدلال واسمح برشفه","https://www.aldiwan.net/poem61700.html","البسيط"],[342,"كأن العين خالطها قذاها","https://www.aldiwan.net/poem2237.html","الوافر"],[343,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[343,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[365,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[401,"في ليل دافوس","https://www.aldiwan.net/poem6729.html","عموديه"],[410,"فئتي ألتجي إليه من الخطب","https://www.aldiwan.net/poem32208.html","الخفيف"],[440,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[462,"وفي حشية دست المجد ذو طرب","https://www.aldiwan.net/poem16145.html","البسيط"],[506,"الأجير","https://www.aldiwan.net/poem56765.html","البسيط"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[563,"ذهب السعيد عزيز مصر طالبا","https://www.aldiwan.net/poem52565.html","الكامل"],[563,"يا نعمة الله زخور احتضنت هنا","https://www.aldiwan.net/poem52605.html","البسيط"],[563,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فيَتْرُكُ في النّاسِ أمْثالَهُ","تُحدِّثُ لي رَغْمَ أنْفِ البِلا",0,"ل",2,0],["فيتَّقي الله أو مسبَّتَكُم","فيختصي أو يَئيم أو يئدُ",1,"د",1,0],["في تراكيبَ خمسةٍ تنشأ ال","أصباغ في مائنا النقيّ النميرِ",2,"ر",1,0],["في تَوبَةٍ مِن تائِبٍ أَو رَهبَةٍ","مِن راهِبٍ أَو رَغبَةٍ مِن راغِبِ",3,"ب",1,0],["في تِسعَةٍ وَلِواءٌ بَينَ أَظهُرِهِم","لَم يَنكُلوا عَن حِياضِ المَوتِ إِذ وَرَدوا",4,"د",3,0],["في تقاصيرَ من الدّرّ إذا","حاولوا تحصيلهَا فهيَ حِكَم",5,"م",1,0],["فيَّ تعريفٌ وعدْلٌ","فانصرافي للضرورهْ",6,"ه",1,0],["في تيهِ مَهمَهَةٍ كَأَنَّ صُوِيَّها","أَيدي مُخالِعَةٍ تَكُفُّ وَتَنهَدُ",7,"د",1,0],["فِي تَرَاكِيبِهِ وَفِي مُفْرَدَاتِ اللَّ","فْظِ حَارَتْ نَفَاسَةُ الحُسَّادِ",8,"د",1,0],["فيتحدون أخلاقا عذابا","ويأتلفون مجتمعا رزينا",9,"ن",2,0],["في تصيبينَ لَبِسنا حُسنَها","وَعَلى التَلِّ لَبِسناها مَعابا",10,"ب",2,0],["فيتَّقي الله في مشيئته","فيختصي أو يَئيم أويئد",11,"د",1,0],["في تِلوِهَا بَينَهُما يَمكُثُ مَا","يُكَبِّرُ المَأمُومُ فِيهِ فَأعلَمَا",12,"م",2,0],["فَيَترُكُ أَقوالَ الأَنامِ كَأَنَّما","بِهِ صَمَمٌ عَنها وَيَمضي مُصَمِّما",13,"م",2,0],["فئتان مختلفان جدا هذه","مثل الضباب وتلك كالنينان",14,"ن",1,0],["في تُربةٍ كَتبَ المُؤرِّخُ فَوقَها","يا رَمسُ قَد حَزَتَ المرادَ فَاِبشِرِ",15,"ر",1,0],["في تُربةٍ كَتبَ المُؤرِّخُ فَوقَها","ان النَزيلَ بِدارِ رَبكَ غالِبُ",16,"ب",1,0],["في تجلّي الصفات صفو المرائي","وتجلّي الأفعال في كلّ شييّ",17,"ي",1,0],["في تاجِهِ قَمَرٌ وَفي ثِنتَي مُفا","ضَتِهِ هِزَبرٌ بِالحَديدِ مُسَربَلُ",18,"ل",1,0],["فَيَترُكُ القِرنَ مُصفَرّاً أَنامِلُهُ","كَأَنَّ في رَيطَتَيهِ نَضخُ إِرقانِ",19,"ن",1,0],["فَيَتِمُّ المُنى لِقَلبٍ عَلَيهِ","كُلُّ يَومٍ يُجَرِّدُ اللَحظَ سَيفَه",20,"ف",2,0],["فَيَتركها إِذا اِضطربت بِطعنٍ","وَيَنهبها إِذا اِشتَجَرت قَناها",21,"ا",3,0],["في تضاعيف نفسه","تنطوي عبرة العبر",22,"ر",1,0],["في تشاعيب حانة","يحتويها رشا أغن",23,"ن",1,0],["فيتْرُكَ اللّيلَ أَغَرّ","ويَشْفيَ العينَ نَظَر",24,"ر",1,0],["في تركيا شدتّ الأمجاد مئزره","وأيّنعت ثمرات الرّوض وازدهرا",25,"ر",2,0],["فِئَتِي ألتَجِي إليهِ من الخَطْ","بِ وذُخرِي إن غَال وَفْريَ غولُ",26,"ل",1,1],["في تُرْبَةٍ جادَ النَّعِيمُ رِياضَها","فَتَفَتَّحَتْ بِنَوَاعِمٍ أَتْرَابِ",27,"ب",1,0],["فيُتْبعُ الحُجَّةَ الغَرَّاء ضرْبتهُ","الرَّعْلاء حتى يحين الحتف والهرب",28,"ب",1,0],["فيتّقيْ فعلةَ فرعون من سبقوا","ويدّعيْ أنّهُ باللهِ مُعتضدُ",29,"د",1,0],["في تربةِ الكلماتِ عَمَّقَ حَرْثَهُ","فتَنَزَّهَتْ كلُّ العصورِ بِحَقْلِهِ",30,"ل",2,0],["في تُربةٍ كتبَ المؤرّخُ فوقَها","نالَ السَّعيدُ سَعادةَ الدَّارَينِ",31,"ن",1,0],["في تُربةٍ قُلتُ لمَّا أرَّخوه بِها","يا ويحَ قلبي على غُصنٍ قد انقَصفَا",32,"ف",2,0],["فيتلو على أصحابهِ آيةَ الضُّحَى","ويتلو على أعدائِهِ آيةَ النَّحرِ",33,"ر",1,0],["في تركها ما أوجب الله له","قال الذي قد قلتم إن قاله",34,"ه",1,0]]}