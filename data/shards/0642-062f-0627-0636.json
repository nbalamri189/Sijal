,[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5550,"أضاع الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=213740",""],[5626,"ما بالُ قومي","https://www.poetsgate.com/ViewPoem.aspx?id=189561",""],[5691,"يافا","https://www.poetsgate.com/ViewPoem.aspx?id=205975",""],[5691,"صلاة قلب...!","https://www.poetsgate.com/ViewPoem.aspx?id=206741",""],[5720,"رِحْلةُ الذَّات","https://www.poetsgate.com/ViewPoem.aspx?id=203389",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5873,"خدم الأعادي","https://www.poetsgate.com/ViewPoem.aspx?id=215352",""],[5873,"رنق العيش","https://www.poetsgate.com/ViewPoem.aspx?id=215357",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[6019,"يا بسمة عمري","https://www.poetsgate.com/ViewPoem.aspx?id=53786",""],[6125,"قد أضرمَ الشَّوقُ في جنبيَّ نِيرَانا","https://www.poetsgate.com/ViewPoem.aspx?id=210958",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""]],"verses":[["قد أضاءتْ وأشرقتْ فاهْتَدى السا","ري بها في مهالكِ الديمومَهْ",0,"م",2,0],["قد أضاقت عَطَني نَكراؤُه","ضيَّق اللَّه عليه عَطَنَه",1,"ن",2,0],["قَد أَضحَكَ الدَهرَ ما بَكيتُ لَهُ","كَأَنَّما البَينُ عِندَهُ وَطَرُ",2,"ر",1,0],["قَد أَضاعوكِ وَما ضَيَّعتِهِم","فَأَضاعوا كُلَّ أُمٍّ مُشبِلِ",3,"ل",1,0],["قَدْ أَضاعَ الرَّشادَ في ملعبِ الجِنِّ","فيا بؤسَهُ أُصيبَ بمَسِّ",4,"س",1,0],["قد أضاعوك غير أن الذي أظ","هرت من عبقرية لا يضيع",5,"ع",1,0],["قد اضعناهم خمسة ليس فيهم","من به رعدة فيا للضياع",6,"ع",1,0],["قَد أَضحَكَ الرَوضَ مَدمَعُ السُحُبِ","وَتَوَّجَ الزَهرُ عاطِلَ القُضُبِ",7,"ب",1,1],["قَد أَضا لَيلُهُ وَكان","صُبحُهُ يُشبِهُ المَسا",8,"س",2,0],["قَد أَضاعَ العصر الأخير لعمري","كَوكباً في جو العراق جَميلا",9,"ل",2,0],["قَد أَضاعَ العِراق أنفاً أبياً","وَلِساناً حلواً وَرأياً أَصيلا",9,"ل",2,0],["قد أَضرم الجور ناراً في مساكنها","وأهلها بين نفاخ ومحتطب",10,"ب",1,0],["قد أضَعتَ القَرِيضَ باللَّحنِ","والضَّعفِ إِتِّزَاناً وَأنتَ غَيرُ مُضِيعِ",11,"ع",1,0],["قد أضاءت سوفهم غيهب الظلم","فبان الطريق نحو الكمال",12,"ل",1,0],["قد اضاعوا شهيدهم","في الليالي البواقع",13,"ع",1,0],["قد أضحتِ الأرضُ تُحِكي تحتهم وضَماً","مِمّا قتلْتَ فلمَ تَعدَمْ بهمْ وضَرا",14,"ر",2,0],["قد أضجروا الضوء والظلماء من رهجٍ","قد كسّر البيض والسمر الأماليدا",15,"د",2,0],["قد أضلَّ النُهى فضلّ لدَيْها","فاِهتدى في الضّلالِ للمَقصودِ",16,"د",1,0],["قد أضحكَ التيهُ في أيديه صارمهُ","وهزّ في راحتَيْهِ رُمحَهُ الطّرَبُ",17,"ب",1,0],["قد أضحكَ الدُنيا سُروراً مثلَ ما","أبكى السّيوفَ وأعيُنَ الغِزلانِ",18,"ن",1,0],["قَدْ أضْحَتِ الأَمْوالُ في ال","أَقْطارِ نَهْباً والدِّما",19,"م",2,0],["قَد أضاعَ الّذين كانوا على العَهْ","دِ عهودي وما رأَوْني مُضيعا",20,"ع",2,0],["قد أضاع الزمان بالقيل والقا","ل وفرط الضلال والطغيان",21,"ن",1,0],["قد أضاءَت أمّ القرى واِستنارَت","مُذ تَجلّى بها ضيا ياسينِ",22,"ن",1,0],["قد أضفنا إلى الحِبابِ الدواوي","جَ وطابتْ للمصطلينَ النار",23,"ر",1,0],["قد اضمرت سوءا غداة تقدمت","ترمي امام محمد بدبابها",24,"ب",3,0],["قد أضاءت نيرانها فتهاوت","كالفراش الأرواح في الأشباح",25,"ح",1,0],["قد أضَرَّ البِلا بِها غيرَ لوحٍ","من رُسومٍ تخالُهُنَّ زَبورا",26,"ر",2,0],["قد أضاعوه بين فعل ظباهم","وظباهم وزودوه اشتعاله",27,"ل",2,0],["قد أضرب الزمان عن سكانها","فكأنها في القفر دار خالية",28,"ه",1,0],["قد أضرموا للعداة ناراً","من قبل يوم الجزاء تضرم",29,"م",1,0],["قد اضاءَت فيحاء بابل منه","بسني به دجى الهم يجلى",30,"ل",2,0],["قَد أَضرَمَت في حَشاهُ","ناراً حَكَت نارَ فارس",31,"س",1,0],["قد اضلوا السبيل جرياً وراء الش","ر حتى ارداهم الشر غوراً",32,"ر",2,0],["قد أضاءت له ذكاء ذكاء","في سماء المعقول والمحسوس",33,"س",1,0],["قد أضحت الأشعار لفظا فارغاً","وغدا بنا الشعراء كالألفاظ",34,"ظ",1,1],["قد أضحت بمرساها أسيرة فلكها","وعسكرها في جيراها من حفاتها",35,"ت",3,0],["قد أَضرَموا نارَ النِفاق فأَحدَقَت","فيهم وتلكَ القادحاتُ بها اكتَوَوا",36,"و",3,0],["قد أضاع الرشاد منه وأمسى","لم يفرق يمنى يد من يسار",37,"ر",1,0],["قد أضاعوا سبل الرشاد بجهل","وغدوا في الحياة كالانعام",38,"م",1,0],["قَد أَضَعتَ الحَياةَ كُلَّ ضَياعٍ","في حُطامٍ فانٍ هُوَ التَخليدُ",39,"د",1,0],["قَد أَضحى صَريعاً بادِياٍ عِظامُهُ","سِوى أَن روحاً بَينَها تَتَرَدَّدُ",40,"د",1,0],["قَد أَضاءَ القطر لِما حله","وَاِزدهت في الكَون تيجان السعود",41,"د",1,0],["قد أَضاءَ الزّمانُ بالمستضيء","وارث البُردِ وابن عمّ النّبْيْ",42,"ي",1,1],["قد أضحكت نواره باكيةٌ","قد ضحك البرقُ بها حتى زجا",43,"ا",1,0],["قد أضعفوها من زمن","ملؤوا نواحيها فتن",44,"ن",1,0],["قد أضاءت للعلم منها شموسٌ","مشرقاتٌ لكنها آراء",45,"ا",2,0],["قد أضاء الدجى بنور ذكاءٍ","منه من ضوئه أضاءت ذكاء",45,"ا",2,0],["قد أضاء البدر أطراف الطريق","وسواد الليل أضحى ابيضا",46,"ض",2,0],["قد أضاءت له الليالي بنورٍ","لامعٍ قد أتاه من نجمتيها",47,"ي",3,0],["قد آض شعري وشعري للمشيب فلا","راويه راضٍ ولا رائيه محسود",48,"د",1,0],["قد أضرَمَتْ نارَ الغوايةِ في دَمي","وَرَمَتْ بها قلبي فقلتُ مُرَدِّدا:",49,"د",2,0],["قد أضعتُ الدَّرب في أنَّاته","صار دربي صوتَ همٍّ مُوهنا",50,"ن",2,0],["قد أضْمختْ ثوبها بالطيبِ حالمةً","شوقاً على كفنٍ مع قيسَ يطويها",51,"ي",3,0],["قد اضعنا ثروةً لا دفعت","سغباً منا ولا بلت ظما",52,"م",2,0],["قد أضهر الله ما تخفين من خلقٍ","على المروة والإحسان مشتمل",53,"ل",1,0],["قد أضَاعَ الغنى فصَار وَحيدًا","بَعْدما مالَ عنْه كلُّ الصّحاب",54,"ب",1,0],["قَدْ أَضْرَموا النّيرانَ في أَنْهارِنا","هَلْ تَحْتَوي نيرانُهُمْ أنْهارا ؟",55,"ر",2,0],["قدْ أضَعْنا جَنّاتِ عَدْنٍ لأَنّا","لمْ نُجَرِّدْ لصَوْنِها الأسْيافا !",56,"ف",2,0],["قد أضاءتْ لي عتمة َالليل","فانْجابَ نهاراً على الوجودِ تجلّى",57,"ل",2,0],["قَد أَضْرَمَ البُعدُ فِيَّ النارَ فاشْتَعَلَتْ","بِيْ ذِكْرَياتٌ تَمَادَىٰ جَرْحُهَا وَجَعَا",58,"ع",2,0],["قد اضطرب العرش العظيم إذ اس","توى عليه ولم يسكن بحكم الحرارتي",59,"ت",2,0],["قد أضاعت كلّ عزٍ أورثت","ثم صارت قصعةً للأممِ",60,"م",1,0],["قد أضرم الهمُّ نيراناً تعذّبني","تكاد من حرّها الأحشاء تحترقُ",61,"ق",1,0],["قد أضأ بالقائم النيران","وزهت زمزم والمشعران",62,"ن",1,1],["قَدْ أَضحَى لَيلُكِ يَا قَمَرِي","بَأَنَاقَةِ عَصرِهِ مُكتَمِلا",63,"ل",2,0],["قد أضرمَ الشَّوقُ في جنبيَّ نِيرَانا","وحَرَّقَ العشقُ أحشاءً وأركانا",64,"ن",2,1],["قد أضعنا الكتابَ تيها وبُخلا ً","وعصينا الرسول قولا وفعلا ً",65,"ل",2,0]]}