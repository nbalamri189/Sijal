{"poems":[[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"يؤمم ذا السيف آماله","https://www.aldiwan.net/poem9936.html","المتقارب"],[47,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[47,"لبيت فيك الشوق حين دعاني","https://www.aldiwan.net/poem66690.html","الكامل"],[63,"فتح أعز به الإسلام صاحبه","https://www.aldiwan.net/poem51815.html","البسيط"],[60,"أي يومي من الموت أفر","https://www.aldiwan.net/poem31071.html","الرمل"],[50,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[92,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[47,"أتَرَاكَ تَسْمَعُ، للحَمَامِ الهُتَّفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32843",""],[208,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[215,"طلعة من ضياء عبد الحميد","https://www.aldiwan.net/poem46290.html","الخفيف"],[215,"شادن قد وفى فأسكر روحا","https://www.aldiwan.net/poem46593.html","الخفيف"],[234,"كل حي إلى الفناء يصير","https://www.aldiwan.net/poem51107.html","الخفيف"],[447,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[463,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[463,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[469,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[473,"يوم من الأيام ليس بدون","https://www.aldiwan.net/poem59633.html","الكامل"],[520,"الحمد للعيس بعد العزم والهمم","https://www.aldiwan.net/poem12243.html","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96985","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122309","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63735","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63800","الرجز"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44948","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61094","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109192","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95501","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95586","الخفيف"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131581",""],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104814","الخفيف"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/122932","المنسرح"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18055","الوافر"],[2575,"","https://poetry.dctabudhabi.ae/diwan/poem/142551","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137162",""],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124601","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100381","الخفيف"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74070","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91351","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91192","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103012","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83607","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139491",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4778,"أهزوجة للأردن","https://www.poetsgate.com/ViewPoem.aspx?id=188147",""],[4935,"لاح نجم السعد في أوج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=129484",""],[5246,"يا نسيم الصبح هل أخبرتني","https://www.poetsgate.com/ViewPoem.aspx?id=187067",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5510,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=206163",""],[5848,"نايف صقر","https://www.poetsgate.com/ViewPoem.aspx?id=51944",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""],[5974,"حكاية فلّ","https://www.poetsgate.com/ViewPoem.aspx?id=216007",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""],[5396,"الميلاد ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65508&r=&rc=7",""]],"verses":[["يَومَ مَنفيسَ وَالبِلادُ لِكِسرى","وَالمُلوكُ المُطاعَةُ الأَعداءُ",0,"ا",2,0],["يُؤَمِّمُ ذا السَيفُ آمالَهُ","وَلا يَفعَلُ السَيفُ أَفعالَهُ",1,"ل",2,1],["يَومَ مَحا عَن أَسوَدانَ سَوادَ ما","فَعَلَ النَبِيُّ بِكَعبٍ بنِ الأَشرَفِ",2,"ف",1,0],["يَومٌ مِنَ الأَيّامِ طالَ عَلَيهِم","فَكَأَنَّهُ زَمَنٌ مِنَ الأَزمانِ",3,"ن",1,0],["يومٌ من النَّصرِ مذكورٌ فواضلُه","إلى التَّنادِ ومشكورٌ مواهِبُه",4,"ب",2,0],["يَومَ ما قُدِّرَ لا أَرهَبُهُ","وَإِذا قَدِّرَ لا يُنجي الحَذَر",5,"ر",1,0],["يُؤَمَّمنَ أَهلَ الغوطَتَينِ كَأَنَّما","لَها عِندَ أَهلِ الغوطَتَينِ ثُؤورُ",6,"ر",1,0],["يَوْمٌ مِنَ الدَّهْرِ أَهْوَى لَو بَذَلْتُ لَهُ","مَا شَاءَ فِي مِثْلِهِ لَوْ كَانَ يَشْتَرِطُ",7,"ط",1,0],["يومٌ من العُمْرِ في واديكِ مَعدودُ","مُستوحِشاتٌ به أيَّاميَ السُودُ",8,"د",1,1],["يَوْمٌ مَحَا عَنْ أسوَدانَ سَوَادَ مَا","فَعلَ النّبيُّ بكَعْبِ ابنِ الأشْرَفِ",9,"ف",1,0],["يومٌ من الجُمعة الغرّاء غُرَّتُه","وفيه من بهجة النيروز تحجيلُ",10,"ل",1,0],["يوم ميلاده أغرُّ سعيدٌ","إنه طلعة الزمان السعيد",11,"د",1,0],["يومٌ مضى وضمير الروح يوهمني","بأن يكون لنا في الحب يومان",12,"ن",1,0],["يوم مات الأمير بل يوم مات الصَّ","بر فيه بل يوم مات السرور",13,"ر",1,0],["يوم مال به جبريل شق له","بطناً فقدس منه اللحم والعلقا",14,"ق",2,0],["يومٌ من العام ولكنَّه","يكُرُّ في دولتكم ألفَ عامْ",15,"م",1,0],["يومٌ من الأيام لكن رأى","له عليها الفضلَ والمفخَرا",16,"ر",2,0],["يومٌ من الفُرسِ أتى وافداً","فقالت العُرْبُ له قرِّبِ",17,"ب",1,0],["يؤم مغانيكم فيا فرحة العلى","ويعزى إلى فكري فيا خجلة اليم",18,"م",1,0],["يَومٌ مِنَ الأَيّام لَيسَ بِدونِ","ما فيهِ غَيرَ خَلاعَةٍ وَمُجونِ",19,"ن",1,1],["يوم من العمر لم يخطر على أملي","ولا ترقت إليه رغبة الهمم",20,"م",1,0],["يوم ماست تيهاً حسان المعالي","بك والمجد ثغره قد تبسم",21,"م",1,0],["يوم منا الركب بالركب التقى","وقضى حاجته الشوق الملح",22,"ح",1,0],["يومٌ مآزيبنا مُعَارِضَةٌ","فيه بأَصواتِها الطَّنابيرا",23,"ر",2,0],["يومٌ من الأيّامِ محمودُ الأثَرْ","لم أرَ يوماً مثلَهُ كان أَسَرّ",24,"ر",1,1],["يَومٌ مَطيرٌ وَعَيشٌ نَضير","وَكَأسٌ تَدورُ وَقِدرٌ تَفور",25,"ر",1,1],["يَومٌ مِن الأَيام إِلا أَنَّه","رقت حَواشيه وَغاب وشاته",26,"ت",2,0],["يوم مزقت ملبسي ثم هروا","ت لدى الصحو باحثاً عن عجوز",27,"ز",1,0],["يوم ميلاده على النيل عيد","أكرم الظل أخلَد التقويمِ",28,"م",1,0],["يوم ميلادها يشع بهاءً","وعليه من المسيح سناءُ",29,"ا",2,0],["يوم ما ورده الدم ومن بعضه رماد","وبخوره دخان الذخيره",30,"ر",2,0],["يَومَ مِيلاَدِه عَمَّنا","طالِعُ السَّعدِ وَالسَّدَاد",31,"د",1,0],["يومٌ من الزمهرير مقرورُ","عليه ثوب الضباب مزرور",32,"ر",1,1],["يَؤُمُّ مَخارِماً بِالقَومِ قَصداً","وَهُنَّ لِغَيرِهِ لا يُبتَغينا",33,"ن",2,0],["يوم من كان للوجود وجوداً","عامراً بالتّقى وكلّ الصلاح",34,"ح",1,0],["يوم مشى في كل قطر بشره","كالبرء يمشي في ذوي الاسقام",35,"م",1,0],["يوم من الخافقات الشهب يوم قضى","من هو له سال دمع العين وانخفقا",36,"ق",2,0],["يوم مدَّت لنا من السجف جيداً","اجيداً ناعما وخدّاً اسيلا",37,"ل",2,0],["يوم ملاكه بأمّ فروة","عرقب كل ذات اربع لقي",38,"ق",2,0],["يَوم مَتى ذكرت مناقبهُ","فَمَناكب الجَوزاء تزدَحمُ",39,"م",1,0],["يومَ ماج الدِّينُ وارتدتْ على","اِبرِ الأَعقابِ عَنْسٌ وصَحَارُ",40,"ر",1,0],["يَوم مسعودٌ يبادي جَهْضَماً","وله في عاملِ الرمحِ جِوَارُ",40,"ر",1,0],["يَومٌ مَضى ظَلّ يَرعاني بِهِ زَمَني","في الأَرض أَسعى وَلَكني مَع القَمَر",41,"ر",1,0],["يؤم من العلا شأواً فشأواً","بعزم تتقي الأَيام باسه",42,"س",2,0],["يوم ملنا من شدّة السكر صرعى","تحسب القوم وهي يقضى نياما",43,"م",2,0],["يَومَ مِن فَرطِ غَيظِ آمِنطُورِ","فَرعِ أُرمِينَ والِدي وأَميري",44,"ي",1,0],["يَومُ ميلادِهِ تخصَّص بالرح","ماتِ إذ خصَّهِ الرَحيمُ الوَدودُ",45,"د",1,0],["يوم ميلادِهِ سرورٌ وَنورٌ","فيه فاضَ الهدى وَفاضَ الجودُ",45,"د",1,0],["يوم ميلادِهِ مدى الدَهر عيدٌ","لَيسَ وَاللّهِ مثلهُ قطُّ عيدُ",45,"د",1,0],["يوم منها حلَّ روضاً جميماً","جعفر الفضل رشحه الأنواء",46,"ا",2,0],["يومَ مِصرُ مُمْرَعَةٌ","والزمانُ مبتسِمُ",47,"م",1,0],["يوم من التاريخ والماضي المجيد","يوم (الكرامة) والبطولة والصمود",48,"د",1,1],["يوم ميلاد اعتدال من سمت","بكمال وجمال وجلال",49,"ل",1,0],["يوم ما أحرزت شطر الدين من","نبذك العزبة سعيا للرشاد",50,"د",1,0],["يومُ ميلادِهِ بمكّةٍ حَدَثٌ","عَجِزَتْ عنْ لِباسِهِ الصُّدَفُ",51,"ف",1,0],["يومٌ من الفرح الموعود باغتني","خرجتُ من صبحيَ المكبوتِ عن صمتي",52,"ت",2,0],["يوم مريت السحايب وهم تحت القبور","يكتبون اجداثهم وانت فالغيم تعدي",53,"د",2,0],["يومٌ مضى ، مُضرِماً منَّا الكبود فلا","نسطيعُ دفعاً له ، أو عنه سُلوانا",54,"ن",2,0],["يوم مديتي بذاك الفل كان","كل ما فيني بساحاتك أسير",55,"ر",1,0],["يوم ميّلت يم الجم ّ أبا اشرب وأبلّ","ريقي اللي نشف من عقب ما شفت زوله",56,"ل",2,0],["يوم مجد فات ما أجمل ذكره","فيه لو نفطن آيات وعبره",57,"ر",2,1],["يوم ميلادي الذي قد نزلت","فيه أيّامي وأهلي نزلوا",58,"ل",3,0]]}