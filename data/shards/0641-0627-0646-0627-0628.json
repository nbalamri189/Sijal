m.aspx?id=214430",""],[4856,"قمر مسافر/لضياء عواد","https://www.poetsgate.com/ViewPoem.aspx?id=35880",""],[4927,"شقاء الْمُغرم","https://www.poetsgate.com/ViewPoem.aspx?id=29957",""],[4929,"إبقي وثاقي مُحكماً","https://www.poetsgate.com/ViewPoem.aspx?id=200429",""],[5038,"رشأ هفا","https://www.poetsgate.com/ViewPoem.aspx?id=188323",""],[5121,"دُرَّةُ الوَفَاء / أختي إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=49549",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5206,"أئمة بني خروص","https://www.poetsgate.com/ViewPoem.aspx?id=187433",""],[5232,"الوردة والشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=212114",""],[5246,"سل ما تريد فقد نريك جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=187074",""],[5256,"أنادي إلهي بيا ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=157390",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5376,"تكالبتْ أممٌ والمجْدُ في حَلَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=188444",""],[5408,"أنا لا إليك","https://www.poetsgate.com/ViewPoem.aspx?id=190581",""],[5472,"إنى إذا ما صاحبي تعدّى","https://www.poetsgate.com/ViewPoem.aspx?id=200474",""],[5528,"لا تغضبي","https://www.poetsgate.com/ViewPoem.aspx?id=201285",""],[5550,"مُلئ الدهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212116",""],[5626,"مَن يُعطيني فماً ؟","https://www.poetsgate.com/ViewPoem.aspx?id=189692",""],[5663,"نجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=200904",""],[5725,"سهم الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=181550",""],[5861,"شمس الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=188046",""],[5909,"يا رقّة الرؤيا التي آنستها","https://www.poetsgate.com/ViewPoem.aspx?id=210227",""],[5910,"لِلَّيلِ في أعيُني","https://www.poetsgate.com/ViewPoem.aspx?id=206317",""],[5943,"لاتعجبني ياسيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=37263",""],[5956,"وشاح الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182126",""],[391,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","https://www.poetsgate.com/ViewPoem.aspx?id=4653",""],[6075,"أجمل الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=210327",""],[6093,"النت ( مجزوء الكامل المرفل)","https://www.poetsgate.com/ViewPoem.aspx?id=181568",""],[6102,"وطن ولا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=182752",""],[1395,"على منزل كان الحبيب به قل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=605517",""],[242,"أقول لمن يصيخ الى اصطراخ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563805",""],[6225,"أبنائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80989&r=&rc=258",""],[6227,"قِفْ واغْتسَِل بدمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87078&r=&rc=21",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""],[6259,"أبا الفضل طال الليل أم خانني صبري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59424&r=&rc=72",""],[6345,"أنشودة للناي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78652&r=&rc=23",""]],"verses":[["فَإِنّا بَنو الدَهرِ ما نَستَفي","قُ مِن نَشوَةِ الهَمِّ حَتّى نُهَم",0,"م",1,0],["فَإِنَّ أَبَا بَكْرٍ خَلِيفَتَهُ الرِّضَا","وَفَارُوقَهُ الأدْنَى إِلَيْهِ وَعُثْمَانا",1,"ن",2,0],["فَإِنَّ ابنَ عَجلانَ الَّذي قَد عَلِمتُمُ","يُبَدِّدُ مالَ اللَهِ فِعلَ المَناهِبِ",2,"ب",1,0],["فإن أبطال هذا في النهي عَسِرٌ","وليس أبطال محض الكذب بالعسر",3,"ر",1,0],["فإن ابن بُرد وهو أكبر شاعر","تَنَقَّصه في الشعر حَمّاد عَجْرد",4,"د",1,0],["فَإِنَّ اِبنَ عَبدِ اللَهِ قَد عُرِفَت لَهُ","مَواطِنُ لا تُخزيهِ عِندا المَشاهِدِ",5,"د",1,0],["فَإِنَّ أَبي وَوالِدَهُ وَعِرضي","لِعِرضِ مُحَمَّدٍ مِنكُم وِقاءُ",6,"ا",2,0],["فَإِنَّ أَباكَ الخَيرَ حَمزَةَ فَاِعلِمي","وَزيرُ رَسولِ اللَهِ خَيرُ وَزيرِ",7,"ر",1,0],["فإن أبيتم عليّ الخلَّتينِ معاً","فلا يلومُ مُليمٌ ناله قذعي",8,"ع",2,0],["فإنْ أبيتَ لأيمانٍ مؤكدةٍ","فبَذْلُك العفوَ كفاراتُ أيمانك",9,"ك",1,0],["فإن أبيتَ السلم فاعزم بنا","فإن حربي في قفا سِلمي",10,"م",2,0],["فإنَّ أبا الحسين أخا المعالي","طَبيبٌ إنْ تَفَرَّد بي شفاني",11,"ن",2,0],["فَإِنَّ اِبنَ تُرنى إِذا جِئتُكُم","أَراهُ يُدافِعُ قَولاً بَريحا",12,"ح",2,0],["فَإِنَّ أَبا قابوسَ بَيني وَبَينها","بِأَرعَنَ يَنفي الطَيرَ حُمرٍ مَناقِلُه",13,"ل",2,0],["فَإِن أَبطَأنَ فَاِصبِر غَيرَ سالِ","كَصَبرِ الأَنبِياءِ لَها قَديما",14,"م",2,0],["فَإِن أَبكِ لا أَشفِ الغَليلَ وَإِن أَدَع","أَدَع حُرقَةً في الصَدرِ ذاتَ تَلَهُّبِ",15,"ب",1,0],["فَإِن أُبدِ حِلماً لا أَكُن مُتَضائِلاً","وَإِن أَنتَقِم أُقدِم عَلى الأَسَدِ الوَردِ",16,"د",1,0],["فَإِنَّ أَباكِ كانَ كَذاكَ يَدعو","عَلَينا في القَديمِ مِنَ الدُهورِ",17,"ر",1,0],["فَإِن أَبكِ قَومي يا نَوارُ فَإِنَّني","أَرى مَسجِدَيهِم مِنهُمُ كَالبَلاقِعِ",18,"ع",1,0],["فَإِنَّ أَباكَ الوَقبَ قَبلَكَ خالِداً","دَفَعناهُ عَن جُرثومَةِ المَجدِ أَجمَعا",19,"ع",2,0],["فَإِنَّ أَبا بَكرٍ إِمامَكِ عالِمٌ","بِتَأويلِ ما وَصّى العِبادَ رَسولُها",20,"ل",3,0],["فإن أُبْدِلَتْ عنْ صوتِ قرنٍ مؤذناً","فإبدالُ تعريفٍ منِ اسمٍ لهُ نكْرُ",21,"ر",1,0],["فإن ابنَ ابنِ شيخِ العصرِ باقٍ","يقلُّ بهِ على الدهرِ الملامُ",22,"م",1,0],["فَإِنَّ أَبا اِسحاقٍ أَخصَبُ تَلعَةً","وَأَشهى نَدى ظِلٍّ وَأَعذَبُ مَكرَعا",23,"ع",2,0],["فَإِنَّ أَباهُمُ الأَدنى أَبوكُم","وَإِنَّ صُدورَهُم لَكُمُ بُراءُ",24,"ا",2,0],["فَإِنَّ اِبنَ دَفّاعٍ طَريفاً وَجَدتُهُ","كَريماً عَلى عِلّاتِهِ غَيرَ مُقطَعِ",25,"ع",1,0],["فَإِنَّ إِباءَ اللَيثِ ماحَلَّ أَنفُهُ","بِأَنَّ مَحَلّاتِ اللُيوثِ إِباءُ",26,"ب",3,0],["فَإِن أَبيتَ قَبولَ النُصحِ مُعتَدِياً","فَاِصنَع جَميلاً وَراعِ الواحِدَ الصَمَدا",27,"د",2,0],["فإن أَبَى فالأقاحي منهُ لي عِوَضٌ","مَنْ عُوّض الدُّرّ عن زهرٍ فما بخِسا",28,"س",2,0],["فإن آب سار أسمع الكلب صوته","أتى دون نج الكلب والكلب دائب",29,"ب",1,0],["فإن أبَوْا فَسيوفُ اللَّهِ تأخذهم","من كلِّ مُتَّقِدِ الحدَّيْنِ مُشْتَعِلِ",30,"ل",1,0],["فإن أبا الأشبال يخشاه مثله","ويامن منه آرض ونمال",31,"ل",1,0],["فإن أبوا أدّبهم بيوم","ما بعده قائمةٌ للقوم",32,"م",1,0],["فأنا بصدر حبيبتي","كفراشة في قلب ورده",33,"د",2,0],["فَإِنَّ اِبنَ تُرنى إِذا جِئتُكُم","أَراهُ يُدافِعُ قَولاً عَنيفا",34,"ف",2,0],["فإن أبكه في بعض الأحاحايين لا غنىً","فكمْ مسلمٍ منا بكى قبلُ مُسْلِمَا",35,"م",2,0],["فَإِنَّ اِبنَ أُختِ القَومِ مُصغىً إِناؤُهُ","إِذا لَم يُزاحِم خالَهُ بِأَبٍ جَلدِ",36,"د",1,0],["فَإِنّا بَينَ غَولٍ أَن تَضِلّوا","فَحائِلِ سوقَتَينِ إِلى نِساحِ",37,"ح",1,1],["فَإنَّ أبَاكَ مشتهرُ المَزَايَا","يُبَادِرُ بالعِشَاءِ وبالعَشَاءِ",38,"ا",2,0],["فَإِنّا بِمَكَّةَ قِدماً لَنا","بِها العِزُّ وَالخَطَرُ الأَعظَمُ",39,"م",1,0],["فأن ابن إسماعيل بالفضل إن رمى","كمثل أبيه ليس يخطي مراميا",40,"ي",2,0],["فإن أبصرت خيرا في منامي","تلقيت المسرّة والأماني",41,"ي",1,0],["فإن ابكهِ تنهلَّ للشعر مطرةٌ","على كل أرض تفجرُ البرق والرعدا",42,"د",2,0],["فَإِنْ أَبْدَى السَّدَادَ سِرَاجُ ذِهْنٍ","فَأَخْوَفُ مَا تَكونُ مِنَ التَّراخِي",43,"خ",2,0],["فَإِنَّا بَنِي الدُّنْيَا وَإِنْ غَرَّنَا الْمُنَى","سَنَحْدَى وَإِنْ حِدْنَا إِلَى الْقَبْرِ بِالْقَسْرِ",44,"ر",1,0],["فَإِنَّ أَباكِ قَد لاقى غُلاماً","مِنَ الأَبناءِ يَلتَهِبُ اِلتِهابا",45,"ب",2,0],["فَإنَّ أَبا الحُسَيْنِ يَنَالُ مِنْهَا","مَنَالَ الذُّعْرِ في قَلْبِ الجَبانِ",46,"ن",1,0],["فَإِن أَبَيتُم فَاِركَبوها بِما","فيها مِنَ الفِتنَةِ ذاتِ البُروق",47,"ق",1,0],["فَإن أبكِ فَهُم عزّي","وَهُم رُكني وَهُم منكب",48,"ب",1,0],["فَإِن أَبى ذامِنكَ قُل مِلتَ عَن","تَوحيدَكَ المَحضِ إِلى الشِركِ",49,"ك",1,0],["فَإِن أَبصَروا في الطِرسِ أَثْرَ مِدادِهِ","فَذَلِكَ سَبقٌ قَد أَثارَ غُبارا",50,"ر",2,0],["فَإِنَّ أَبا قابوسَ عِندي بَلاؤُهُ","جَزاءً بِنُعمى لا يَحِلُّ كُنودُها",51,"د",3,0],["فَإِن أَبكِ فَالقُربى القَريبَةُ تَقتَضي","بُكايَ وَإِن أَصبِر فَبَقياً عَلى الأَجرِ",52,"ر",1,0],["فإنّ أبوابَهُم كالبَحرِ راكبُهُ","مُرَوَّعُ القَلبِ يَخشى دهرَه الغَرَقا",53,"ق",2,0],["فَإِن أَبقَ بَعدَكَ حَيّاً فَما","بَقائي سِوى طَمَعٍ في التَلاقي",54,"ق",2,0],["فأنابت الداعي له","واستلفتته عيونها",55,"ن",3,0],["فإن أبصروا فضلي تواطأ كلهم","على جحده حتى طويت ردائيا",56,"ي",2,0],["فإِنَّ ابن عمِّ المصطفى ذو شفاعةٍ","إذا غلغلت في الدهر صدمةُ اكدار",57,"ر",1,0],["فإنَّا بِكَسرٍ قد أتَيْناكَ خُلَّصاً","فَقابلْ نِطاقَ الكَسْرِ رَبَّاهُ بالجَبْرِ",58,"ر",1,0],["فإن ابتسام البرق ليس بنافع","إذا لم يبت فوق الثرى صوبه يهمي",59,"م",2,0],["فَاِن ابكه اعذُر وَاِن اِغلِب الاِسى","بِصَبر فَمِثلي عِندَما اشتَدَّ يَصبِر",60,"ر",1,0],["فإنْ أَبَيْتَ إلاّ","طَرْحَكَ هَذَا الْقَوْلا",61,"ل",2,0],["فإنّ ابنةَ الحَبرِ اليهوديّ تيّمَت","فؤادي فهل لي من سُميّةَ زاجرُ",62,"ر",1,0],["فَإِن أَبلغِ القُصوى فشيمةُ ماجدٍ","وَإِن تَنبُ أَسيافِي فَلَن أَدع الضّربا",63,"ب",2,0],["فإنّ أباه الهمام الذي","بأفقِ الفخارِ سَما فَرقدا",64,"د",2,0],["فَإِنَّ أَبي عِندَ الحِفاظِ أَبوهُمُ","وَخالُهُمُ خالي وَجَدُّهُمُ جَدّي",65,"د",2,0],["فإن أبدلتني بالسَّهْ","لِ من أخلاقِكَ الوعرا",66,"ر",2,0],["فَإِنَّ اِبنَ عَمّي زَعيمٌ لَها","بِغَزوٍ يُساقِطُ مِنها السِخالا",67,"ل",2,0],["فإنَّ ابن تركي فيصلا غوثُنا إذا","ألمَّ بنا من دهرنا كلُّ فاجعِ",68,"ع",1,0],["فإن أبا صالحٍ يرتجي","لإصلاح ما الدهر قد غيرا",69,"ر",2,0],["فأنا بؤت بالمآثم فاصرف","أوجه العذر للعفو الغفور",70,"ر",1,0],["فإن ابيض او فشق عليه","وألق ما اسود واعطه القصارى",71,"ر",2,0],["فإن أبا الأجواد لولاه عاقر","عقيم وأم المكرمات ثكول",72,"ل",1,0],["فأنا بذلك حائر","وأنا بذاك مذبذب",73,"ب",1,0],["فإن أبكي فهُم عزّي","وهُم رُكني وهُم منكِب",74,"ب",1,0],["فإن أبت نجدٌ فلا تأبى الحسا","فاقْسُ على أشْرَارِهم كما قسا",75,"س",2,0],["فإن إبراهيمَ لا هوتُ العُلا","من دعاهُ بشَرا ما أنصفَه",76,"ف",2,0],["فإن أبيت سوى ما قد أتيت به","بغيا ولا بد للأصوات تشتبك",77,"ك",1,0],["فأنا بروح الحب مسكون فلا","للنار أو للماء رحت أسلم",78,"م",1,0],["فأنا بحبل الوهم لا أتعلّق","ما لم يؤيده هدىً ويقين",79,"ن",1,0],["فإنْ أبتْ فالرَّدى رَهْنٌ بِمُعْضِلَةٍ","لا القارةُ انتصفتْ منها ولا عضَلُ",80,"ل",1,0],["فإنْ أبْلَتِ الأيّامُ ناظرَ بَهْجَتي","فلم تُبل مِنّي ما به أتقدّمُ",81,"م",1,0],["فإن ابواه عالجا ذاك دونهُ","وجاز فلا رد ولا هو يبرحُ",82,"ح",1,0],["فإن أبدى الطلاق وكان ينوي","ظهاراً في الضمير بغير بين",83,"ن",1,0],["فإن أبواه وابنياه تخلفوا","ومات وماتت بنته وهي ملمعُ",84,"ع",1,0],["فَإِنَّ اِبنَ عَبسٍ قَد عَلِمتُم مَكانَهُ","أَذاعَ بِهَ ضَربٌ وَطَعنٌ جَوائِفُ",85,"ف