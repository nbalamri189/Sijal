{"poems":[[90,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[30,"إذا سومت للبأس أغشى صدورها","https://www.aldiwan.net/poem5119.html","البسيط"],[77,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[48,"خوى دن شرب فاستحابوا إلى التقى","https://www.aldiwan.net/poem22453.html","الطويل"],[358,"تعز ولا تكثر من النوح إنني","https://www.aldiwan.net/poem40018.html","الطويل"],[443,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38818","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78187","الوافر"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36189","الوافر"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103250","البسيط"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89705","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89522","البسيط"],[2344,"","https://poetry.dctabudhabi.ae/diwan/poem/131383","الطويل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17737","البسيط"],[3556,"","https://poetry.dctabudhabi.ae/diwan/poem/138020","الرجز"],[3843,"","https://poetry.dctabudhabi.ae/diwan/poem/131372","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[5277,"تباريحٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=202456",""],[5309,"هي الأخلاق تنبت كالنبات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573769",""]],"verses":[["وليس ربيب عالية المَزايا","كمثل ربيب سافلة الصفات",0,"ت",1,0],["وَلَيسَ رَئيسٌ زارَ ضَبَّةَ مُخطِئاً","يَدَيهِ اِصفِرارٌ بِالأَسِنَّةِ أَو أَسرُ",1,"ر",1,0],["وليسَ رِشاءٌ وإنْ مُدّ مِن","رشاءٍ ولا وَذَمٌ مِن وَذَم",2,"م",1,0],["وَلَيسَ رِكابي عَن رِضايَ عَوادِناً","وَلَكِن عَداها أَن تَسيرَ عَوادي",3,"د",2,0],["وَلَيسَ رِثاءُ الخلِّ مُجدٍ وَإِنَّما","يَحقُّ لَهُ أَن لا تُضيع لَهُ حَقّا",4,"ق",2,0],["وليس رجائب غير قرب محله","أو الجود من كف الوزير أبي الرضا",5,"ض",2,0],["وليس رثائي غيرَ رمزٍ لوحشتي","فشأنُك بين العبقريةِ والقدر",6,"ر",1,0],["وَلَيسَ رُعافُ المَرءِ مِن غَيرِ أَنفِهِ","وَلَكِنّني مِن مُقلَتي كنتُ أَرعفُ",7,"ف",1,0],["وَلي سرٌ سَرى بِأَمين حُبي","وَإِني بِالبقا أَسمى وَحَسبي",8,"ي",1,0],["وَلي سِرٌّ عَظيمٌ أَنكَروهُ","يَدقّونَ الرّؤوسَ عَلى الجدارِ",9,"ر",1,0],["وليس رزق الفتى من حسن حيلته","لكن حدود وأرزاق بأقسام",10,"م",1,0],["وَلَيسَ رِزق الفَتى من لُطف حيلَتِه","لكِن حدود بِأَرزاقِ وَأَقسامِ",11,"م",1,0],["وَلَيسَ رَأيُكَ في مالٍ تُجَمِّعُهُ","كَنزاً إِذا جَمَّعَ الخُزّانُ وَاِدَّخَروا",12,"ر",3,0],["وليس رغا الجذعان يدنى من المدى","إذا برزت بزل مرافقها فتل",13,"ل",1,0],["وَلّى سَريعاً مُدِلّاً غَيرَ مُكتَرِثٍ","يَعلو العِلابَ وَرَوقاهُ قَد اِختَصَبا",14,"ب",2,0],["وليس ردا للذي قد مرا","واستبعد التأكيد بعض القرا",15,"ر",2,0],["ولي سريرة خير سيرتي حمدت","بهاء فضلى ذكائي منصبي صانا",16,"ن",2,0],["وليس رُسوخُ علمٍ الا بها ومن","يزغ زاغَ قلباً قلما منه يسلم",17,"م",1,0],["وليسَ رصافتي إلَّا طلولٌ","عليها منْ بقايا الأمسِ زغبُ",18,"ب",1,0],["وَلَيسَ رَبيبُ عالِيَةِ المَزايا","إِذا زانَتهُ أَخلاقُ الأُباةِ",19,"ه",1,0]]}