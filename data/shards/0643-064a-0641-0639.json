{"poems":[[43,"يا لقومي لكثرة العذال","https://www.aldiwan.net/poem42361.html","الخفيف"],[53,"يا يوم إسحاق بن عبد الملك","https://www.aldiwan.net/poem65782.html","السريع"],[63,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[104,"كيف عيناك يا عمر","https://www.aldiwan.net/poem33113.html","مجزوء الخفيف"],[52,"نور عيني أصبت عيني بسكب","https://www.aldiwan.net/poem64824.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55019","السريع"],[109,"كيف عشقت امرأة لم ألقها.. ؟","https://www.poetsgate.com/ViewPoem.aspx?id=214005",""],[102,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38666","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96642","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50033","الخفيف"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216504","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77438","الخفيف"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115375","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201755","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118784","المديد"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91618","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33435","الخفيف"],[4691,"اعتذارات بين يدي النقاء","https://www.poetsgate.com/ViewPoem.aspx?id=102702",""],[4767,"خير الزاد","https://www.poetsgate.com/ViewPoem.aspx?id=89611",""],[4823,"زهرة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=188280",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[5732,"كلما قلت","https://www.poetsgate.com/ViewPoem.aspx?id=177952",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6056,"الحظ الأقشر","https://www.poetsgate.com/ViewPoem.aspx?id=156697",""]],"verses":[["كَيفَ عَذلي عَلى الَّتي هِيَ مِنِّي","بمكَان اليَمينِ أُختِ الشِّمَالِ",0,"ل",1,0],["كيف عزائي عن فتىً لا يُرى","شبيهُهُ في أيّ فجّ سُلك",1,"ك",1,0],["كيفَ عنَّتْ لنا ظِباءُ كِناسٍ","غادَرَتْها النَّوى شموسَ قِبابِ",2,"ب",1,0],["كَيفَ عَيناك يا عُمَر","أَنا أَدماهما السَهر",3,"ر",1,1],["كَيفَ عَيشي وَما نَعودُ كَما كن","نا إِلى اللَهِ أَشتَكي جَهدَ كَربي",4,"ب",2,0],["كَيْفُ عَفَت أَزْهَارُهَا وَانْقَضَتْ","سَعَادَةُ الشَّمْلِ الهَنِيءِ الجَميعْ",5,"ع",1,0],["كيف عشقت امرأة لم ألقها.. ؟","عشقتها حتى خشيت عشقها..",6,"ه",2,1],["كيف عشقت امرأة لم أرها..؟","ولا عرفت خيرها وشرها..",6,"ه",2,0],["كيف عادت ( أزاد) بالحب تردي","وتسن الطلاق بالموت: دينا؟",7,"ن",2,0],["كَيفَ عودي إِلى لَظى وَمحلّي","جنَّة الوردِ تَحتَ ظلِّ الآسِ",8,"س",1,0],["كَيفَ عُذري بعدَما أخبرَ بالذ","ذنب منّي كلّ عضوٍ وَشَهِد",9,"د",1,0],["كيف عدنا عودةً فقعدنا","من عهدنا فيك منذ زمانِ",10,"ن",1,0],["كيف عكاء جبهة الفخر والمجد","أذلت لحكم الاستبداد",11,"د",1,0],["كيف عيني لم تغدُ بيضاء حزناً","وهي قد أصبحت بلا إنسان",12,"ن",1,0],["كَيفَ عَيشُ الزَوجَينِ فَاتَهما ال","حُبّ وَلَجَّ الأَذى وَحالَ الصَفاءُ",13,"ا",2,0],["كيف عيش امرئ له كل يوم","على دون بلدة منشور",14,"ر",1,1],["كيف عطلتِ حاليات السواقي","من غوانٍ كوردها في صفوف",15,"ف",1,0],["كيف عن وادي الأراك يرى","وارد يرغب في صدرِه",16,"ر",2,0],["كَيفَ عاشت بَعدَه في نُعمةٍ","وَالبَقاء لَهنّ أَمر متفق",17,"ق",1,0],["كيفَ عيشي ولم أنل","أملي من وصالِكا",18,"ك",2,0],["كيف عيني سترى عين الذي","زرع الود لقلبي وقطف",19,"ف",1,0],["كيف عشنا شهر شعبان وهل","نحن عبدنا إلى الله الدروب",20,"ب",1,0],["كيف عاملنا به أنفسنا","كيف كانت فيه أسرار القلوب",20,"ب",1,0],["كيف عاداك فٱزدهرت ربيعاً","قاحلٌ موحشٌ ونوءٌ مخيفُ",21,"ف",1,0],["كيف عزمي على امتثال وترك","بين قهر وبين أمر أبينا",22,"ن",2,0],["كَيْفَ عُذْرِي بَعْدَما أَخْبَرَ بِال","ذَّنْبِ مِنِّي كُلُّ عُضْوٍ وَشَهِدْ",23,"د",1,0],["كيف عقب الغلامنك العداوه تصير","الزعل ما نريده منك نبي الرضا",24,"ا",1,0],["كَيفَ عُيُونُ المَهدِ يَغفُو جَفنُهَا","وَالزَّهرُ يَصحوُ والنَّدى تَلاقيَا",25,"ي",2,0],["كيف عقب الود قرّر* للهجر من غير زله ّ","عاذل ٍ قد حال دونه * ليتني أعرف مرامه",26,"م",2,0]]}