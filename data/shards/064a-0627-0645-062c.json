صخرة","https://www.poetsgate.com/ViewPoem.aspx?id=61895",""],[5431,"رحماك يارب السماء","https://www.poetsgate.com/ViewPoem.aspx?id=185254",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5458,"جولة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=113370",""],[5458,"أحببت مستعمري","https://www.poetsgate.com/ViewPoem.aspx?id=113368",""],[5533,"يا غَزَّةُ يا صَوْتَ الأُمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=176419",""],[470,"المجرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=178071",""],[5582,"شَرَعَ الحُبُّ لَهُ ما شَرَعا","https://www.poetsgate.com/ViewPoem.aspx?id=63529",""],[5596,"مجلس بوشر العام","https://www.poetsgate.com/ViewPoem.aspx?id=206172",""],[5596,"مجلس الدولة","https://www.poetsgate.com/ViewPoem.aspx?id=206753",""],[5688,"قالت حبيبتي:","https://www.poetsgate.com/ViewPoem.aspx?id=200940",""],[5693,"يا مجرّات الثريا .","https://www.poetsgate.com/ViewPoem.aspx?id=35144",""],[5742,"المجلس الميمون","https://www.poetsgate.com/ViewPoem.aspx?id=207146",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5897,"قم يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=156690",""],[5897,"على بركات الله","https://www.poetsgate.com/ViewPoem.aspx?id=177077",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5953,"كم بالغري لمن تبين رشده","https://www.poetsgate.com/ViewPoem.aspx?id=93810",""],[6056,"مجاريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=130501",""],[6082,"الحب الافتراضي","https://www.poetsgate.com/ViewPoem.aspx?id=59115",""],[6089,"خذ غيومك وارتحلْ","https://www.poetsgate.com/ViewPoem.aspx?id=214046",""],[6113,"يامجنوووووووون","https://www.poetsgate.com/ViewPoem.aspx?id=12872",""],[6133,"قولة أهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=33826",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[520,"لا وعيون لحظها ساحر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577520",""],[6201,"كينونة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87476&r=&rc=0",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""]],"verses":[["يَا مَجْمَع الْبَحْرِيْنِ كَمْ مَزَّقْتَ مِنْ","جَمْعٍ وَكَمْ بَاعَدْتَ بَعْدَ تَدَانِي",0,"ن",2,0],["يا مُجْزِلَ الصّدَقاتِ في جُنْحِ الدّجى","واللّيْلُ قدْ سُدِلَتْ لهُ أسْتارُهُ",1,"ر",2,0],["يا مُجَلّي العَمى وكافِي الدّواهي","ومُداوي المَرْضى وآسِي الجِراحِ",2,"ح",1,0],["يَا مَجْدَ رَمْسِيسَ كَمْ أَبْقَيْتَ مِنْ عَجَبٍ","فِيهِ وَمَسْأَلةٍ عَنْهُ لِحَيْرَانِ",3,"ن",1,0],["يا مجزل الرَّفد للنزيل به","جائزة جمة وزوَّاده",4,"ه",1,1],["يا مجرياً دمعي وموقف لوعتي","من جسمي المضنى على أطلال",5,"ل",1,0],["يا مجيرَ الورى من الحَدثانِ","وربيعَ العُفاةِ كُلَّ أَوانِ",6,"ن",1,1],["يا مُجابا دَعا إِلى مُستَجِيبِ","فَسَمِعنا دُعاءَه مِن قَريبِ",7,"ب",1,1],["يا مُجِيبَ الإسلامِ حينَ دعَاه","ومُقِيلَ الإسلامِ حينَ استقَالا",8,"ل",2,0],["يا مجدُ قَدْ فاتَ العُلى","مَنْ لا ينامُ عنِ السُّرى",9,"ر",2,1],["يا مجمعَ الشملِ من صحبٍ فُجعتُ به","وآخرٍ رُحْتُ أبلوه ويبلوني",10,"ن",2,0],["يا مَجلِساً ضَمَّ فِتياناً غَطارِفَةً","حازوا البَشاشَةَ وَالإِنعامَ وَالكَرَما",11,"م",2,0],["يا مَجلِساً أَكرِم بِهِ مَجلِساً","حُفَّ بِرَيحانٍ وَعَيشٍ عُجاب",12,"ب",1,0],["يا مَجْلِساً أَيْنَعَتْ مِنْهُ أزاهِرهُ","يُنْسيكَ أَوَّلَهُ في الحُسْنِ آخِرُهُ",13,"ر",2,1],["يَا مُجِيلَ الرُّوحِ في جَسَدي","والذِي يَفْتَرُّ عَنْ بَرَدِ",14,"د",1,1],["يا مجاريَّ إن تحتي جواداً","لا تجاريه في السباق الخيول",15,"ل",1,0],["يا مَجْلِسَ البَلَدَيْنِ منْتَظِماً","كَالعِقْدِ مِنْ نُبَلاَءَ أَمْجَادِ",16,"د",1,0],["يا مجدُ يا فنّ يا جنون","لم تُبقِ منّي الليالي سوى خيال خيالي",17,"ي",1,1],["يا مجدُ يا فنُّ يا جنون","أين الهوى والفتون والعصبةُ المعجون",17,"ن",1,0],["يَا مُجِيرَ الْفُصْحَى وَقَدْ عَقّهَا","الدَّهْرُ وأَغْرَى بِقَوْمِها حِدْثَانَه",18,"ن",2,0],["يا مجلساً عاد وجْداً","يُذْكي الفؤادَ ويُضْني",19,"ن",2,0],["يا مَجْلسَ الأمن، جِدُّ أنتَ أَم لعبُ؟","وصورةٌ حيَّةٌ، أمَ هيكلُ خشبُ؟",20,"ب",1,1],["يا مجلسَ الأَمن، من أَمَّنْتَهُ فَزعٌ","من خوفه قلبُه في صدره يَجِب!",20,"ب",1,0],["يا مجمع البحرين كم مزقت من","جمع وكم باعدت بعد تدان",21,"ن",1,0],["يامجاميع.. المسافات... العذاب....","ياحرام العين.... ياحل .. اليدين",22,"ن",1,1],["يا مجري النهر إلى البحر","ومسقط الطل على الزهر",23,"ر",1,0],["يا مجرياً في البيان طرفا","نائي المدى واسع المجال",24,"ل",1,0],["يا مُجيري مِنَ الزَّمانِ إِذا لَمْ","أَسْتَجِرْ منْ خُطُوبِهِ لي بِجارِ",25,"ر",1,0],["يا مَجْلِساً جَعَلْتُهُ","فِي مُدَّتِي أُنْمُوذَجِي",26,"ج",2,0],["يا مُجْتَدى الكرماءِ حَسْبُك قد طَما","بحرُ النوالِ فهانتِ الغُدران",27,"ن",1,0],["يا مُجرِياً دمعَ المَلا أَبحُراً","أَدرِكهُمُ يا مُرقىءَ الأَدمُعِ",28,"ع",1,0],["يَا مَجْمَعَ الْبَحْرَيْنِ بَحْ","رِ النُّور ِوَالطُّولِ الْمَدِيدْ",29,"د",1,0],["يا مُجيبَ الدُعاءِ إِنَّكَ أَدرى","بِصِفاتٍ لَهُ تَجلُ وَتَمدَح",30,"ح",1,0],["يا مُجيب المُضطرّ حينَ دَعاهُ","مُستَغيثاً وَكاشف الأَسواءِ",31,"ا",2,0],["يامجمل لا تهمل","إن عادتك الجماله",32,"ل",2,1],["يا مَجهَلي ما أَطوَلَك","أَلهَمُّ لي وَالسهدُ لَك",33,"ك",1,0],["يا مُجيبَ الدُّعَاةِ والعَضْبُ والعّذْ","بُ لِسانَا جِلادِهِ والجِدالِ",34,"ل",1,0],["يا مُجيري من صرفِ دهرٍ أذلاّ","وعمادي الأعلى وقِدْحي المُعلّى",35,"ل",2,1],["يا مجيب الداعي ويا خاذل","العادي وفكَّ العاني وجبر الكسير",36,"ر",1,0],["يا مَجدَ دين اللَّه وال","قرْمَ الّذي فاتَ النّعوتا",37,"ت",2,0],["يا مُجدِبَ الْحَالِ زُرْ نَادِيه مُعْتَفِياً","واسْأَلْ نَدَاهُ ولاَ تَسْأَلْ عَنِ المَطَرِ",38,"ر",1,0],["يا مُجَارِيه قَدْ جَهِدْتَ فَأَقْصِر","طَالَمَا خَابَ طَالِبٌ مَجْهودُ",39,"د",1,0],["يا مُجيبَ المُضْطَرِّ عِنْدَ الدُّعاءِ","مِنكَ دائِي وفي يَدَيْكَ دوائي",40,"ي",1,1],["يا مجلساً يضحكُ عن","كلِّ جليسٍ أزهرِ",41,"ر",1,1],["يا مجليِّ الثنايا","عنّي كفْ الّنظر",42,"ر",1,1],["يا مجد دين الإله لا عجب","إن قصر الطالبون عن أمدك",43,"ك",1,1],["يا مجيب الدعا وغوث الأسير","يا مزيل الأذى وجبر الكسير",44,"ر",1,1],["يا مجري الأنفاس يا","حصي مجاربها عدد",45,"د",1,0],["يا مجيري ومعتقي ونصيري","يا شفيعي منقذي ورشادي",46,"د",2,0],["يا مُجدّاً في اِكتسابِ الرزقِ عُج","نَحوَ بهلا ما قد دَنا ما شسعا",47,"ع",2,0],["يا مجد قومي لم أفدك زيادة","قد مُجّدوا في عصرهم ما مُجدوا",48,"د",3,0],["يا مجيب الدعا وغافر ذنب","المستجير اغثنا اغثنا",49,"ن",2,0],["يا مجدي القهار ذا العرش هب لي","مجد قهر يقتاد أنف الأجل",50,"ل",1,0],["يا مجدنا إن قيل مجدويا","سيدنا المستعظم الأكبرا",51,"ر",2,0],["يا مجدين مُهَيلا","خَفَفوا ظعناً وَشيل",52,"ل",1,1],["يا مجلَس واللذَّات والطَّربِ","لا زلت في العزِّ مغموراً مدى الحُقُبِ",53,"ب",1,1],["يا مُجرياً بخلائه لا تَفتخِر","بِحُلى السّباق فما أراك تنالُها",54,"ل",3,0],["يامجيراً وخَيِّراً وخطيراً","وصديقا يصون وهو مصونُ",55,"ن",1,0],["يا مجة الباري","يا ذات يا ملكون",56,"ن",1,0],["يا مجد هل تأسى لما لقيته","إنَّ به خدك عاد أضرعا",57,"ع",2,0],["يا مُجيرَ النفوسِ من كَربِ يومٍ","يُفقِدُ الرُّشدَ هَولُهُ والبلاء",58,"ا",2,0],["يا مجهد النَفس في نيل المُنى طَمَعاً","الجَدُّ يَجديك لَيسَ المال يا رَجُل",59,"ل",1,1],["يا مجيب الندا يعز علينا","ان ننادي ولا نلاقي مجيبا",60,"ب",2,0],["يا مجيداً بالشعرِ مثل ابيه","هل نر بعدُ ربّ شعرٍ مجيدا",61,"د",2,0],["يا مجيري من زمان لم يزل","جوده يمنح قلبي مضضا",62,"ض",2,0],["يا مجيري من جور حادثة الده","ر وفي حكمها عليّ اعتداء",63,"ا",2,0],["يا مجيري في الزمان وقد ج","ار ولجت خطوبه في عناد",64,"د",1,0],["يا مجمَعَ البَحْرَيْنِ يا برنازُ مَنْ","أبقيت نوراً في دُجى الإِظلام",65,"م",1,0],["يا مجري الفلك الثقال كأنها","شم الجبال على الخضم الساري",66,"ر",2,0],["يا مجملاً فيه الجمال له","خصر كحظي منه مختصر",67,"ر",1,0],["يا مجال الأنس في عهد الهوى","وليالينا بضوء القمر",68,"ر",1,0],["يا مجمع الأحباب يا درمينا","كم ذا بأشراك الهوى ترمينا",69,"ن",2,0],["يا مجيب المضطر حيث دعاه","منك أرجو إكرام مثوى العافي",70,"ف",2,0],["يا مجتبىً هو في جيد الزمان حلا","يا طيباً عذبت أخلاقه وحلا",71,"ل",2,0],["يا مجلس القوم الذي","ن بهم تفرقت المنازل",72,"ل",1,1],["يا مجلسي في سفح بقين وما","يحويه من حسن وعيش أرغد",73,"د",1,0],["يا مجلس الأمن لا حيتك إيمان","ولا رست لك في الأنداء أركان",74,"ن",1,1],["يا مجري الفكر الى أقصى امد","سامع فقد انجز حر ما وعد",75,"د",1,0],["يا مُجيداً أتى بحسن المقال","ومَجيداً له كرام الفعالِ",76,"ل",1,1],["يا مجلس الأمّة الميمون طالعه","بك العلاء إلى تركية رجعا",77,"ع",2,1],["يا مُجيري إنْ خِفْتُ يَوْماً عَبوساً","مُكْفَهراً مستصعباً قمطريرا",78,"ر",2,0],["يا مَجْلِسَ اللَّهْوِ لا أَصْبُو إِلَيْكَ وَلا","شَخْصُ النَّدِيمِ إِلى شَخْصِي بِمُقْتَرِبِ",79,"ب",1,0],["يا مجير الطريد كان لك اللَه","تعالى من كل بأس مجيرا",80,"ر",2,0],["يا مجلسَ الأَمنِ بل يا هيئةَ الأُمم","ماذا التلاعُب بالألفاظ والكلمِ",81,"م",1,1],["يا مجتلي الخد مواجا برونقه","ماء الصبا لا عدمناه ورونقه",82,"ق",2,0],["يا مجهداً يتمنى أن يجيء له","بمشبهٍ في طوامير من السير",83,"ر",1,0],["يا مَجلِساً جَمعَ الأَحِبَّةِ إِنَّهُ","يَسبي العُقولَ بِلُطفِهِ وَبِأُنسِهِ",84,"ه",1,1],["يا مُجيرَ العفُاةِ من جَورِ دَهرٍ","لَم يَزَل بالكِرامِ فيهِ بَخيلا",85,"ل",2,0],["((يا مجلسَ المتعاونينَ)) بقيتَ في","نَحْرِ العِدَا كالبارِقِ الصّمصامِ",86,"م",1,0],["يا مَجْلِساً عَقَدْتْهُ عُصْبَةٌ ظَلَمَتْ","خَطَّتْ أَساطِيرَهُ بالجَوْرِ طَغْواها",87,"ا",3,0],["يامجيبٍ دعوت المضطر والمتعافي","لاتغير واقعٍ صرت المسه بيديّه",88,"ي",2,0],["يا مجلس الأمن أين الأمن عندكمُ","ما زال عن أهلنا في الشرق محتجبا",89,"ب",2,0],["يا مجلس الأمن هل يرجى الأمان بكم","والغرب ما زال بالأحقاد ملتهبا",89,"ب",2,0],["يا مجهدُ الآمالِ في طلبِ العلى","هيهاتَ تدركها بحظِ مقعدِ",90,"د",1,0],["يا مجّلس النيّام ما يكفي آ سبات؟","حال المواطن بالوطن نيله وطين",91,"ن",1,0],["ياَ مجيري مِنَ اللظى ذات روعٍ","كُنْ دليلي لو حاصرتني اللئامُ",92,"م",1,0],["يا مجلس السعد لو أني ظفرت به","منه ويا سعد جلاّسٍ به ظفروا",93,"ر",3,0],["يا مجلساً هِبةَ المليكِ لشعبه","جمعٌ رشيدٌ شأنُه الصحراءُ",94,"ا",2,1],["يا مجيب الدعا ويا سامع الأص","وات وهناً يا راحم العبرات",95,"ت",1,0],["يا مجد دين الله والصدر الذي","غاضت لو شك وفاته الآمال",96,"ل",1,0],["يا مجد دين الله هذي دعوةٌ","من سر قلب في هواك مكين",97,"ن",1,0],["يا مجددين الله يا كهف الورى","هاتيك نفثة خاطرٍ ملآن",98,"ن",1,0],["يا مجد دين الله دعوة خادمٍ","في صالح الدعوات غير مقصّر",99,"ر",1,0],["يا \\\" مجدُ \\\" يا ابنَ النيلِ:لونُكَ لونُهُ","وصفاءُ روحِكَ كالنسيمِ الساري",100,"ر",2,0],[