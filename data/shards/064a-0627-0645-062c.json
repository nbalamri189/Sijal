{"poems":[[77,"ذكروا العهود فهاج من أشجاني","https://www.aldiwan.net/poem36070.html","الكامل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[72,"يا مجزل الرفد للنزيل به","https://www.aldiwan.net/poem18680.html","المنسرح"],[72,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[51,"يا مجير الورى من الحدثان","https://www.aldiwan.net/poem66415.html","الخفيف"],[78,"يا مجابا دعا إلى مستجيب","https://www.aldiwan.net/poem14150.html","الخفيف"],[61,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[69,"يا مجد قد فات العلى","https://www.aldiwan.net/poem28718.html","مجزوء الكامل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[48,"يوم الخميس أقمنا ساقيا حكما","https://www.aldiwan.net/poem65113.html","البسيط"],[50,"أفنيت عمري وتقضى الشباب","https://www.aldiwan.net/poem64823.html","السريع"],[76,"يا مجلسا أينعت منه أزاهره","https://www.aldiwan.net/poem39309.html","البسيط"],[76,"يا مجيل الروح في جسدي","https://www.aldiwan.net/poem39433.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85506","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141996","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[77,"ذكروا العهود فهاج من أشجاني","https://www.poetsgate.com/ViewPoem.aspx?id=34168",""],[109,"قطعة الحلوى","https://www.poetsgate.com/ViewPoem.aspx?id=8390",""],[121,"آنستني بالأملا المغري","https://www.aldiwan.net/poem49283.html","السريع"],[151,"لبيك من مخلص موال","https://www.aldiwan.net/poem68440.html","مخلع البسيط"],[156,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[175,"وناظر عن دعج","https://www.aldiwan.net/poem46055.html","مجزوء الرجز"],[186,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[226,"لهف الرياسات على راحل","https://www.aldiwan.net/poem55089.html","السريع"],[238,"رد فضل ذي العرش المجيد","https://www.aldiwan.net/poem18156.html","مجزوء الكامل"],[321,"ماس عجبا بعطفه وترنح","https://www.aldiwan.net/poem67138.html","الخفيف"],[354,"يا رجائي في شدتي ورخائي","https://www.aldiwan.net/poem40841.html","الخفيف"],[392,"يامجمل لا تهمل","https://www.aldiwan.net/poem54431.html","عموديه"],[430,"يا ليل يا ليل ما هلك","https://www.aldiwan.net/poem41449.html","مخلع البسيط"],[433,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[433,"يا مجيري من صرف دهر أذلا","https://www.aldiwan.net/poem12535.html","الخفيف"],[465,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[552,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[576,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[576,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"]],"verses":[["يَا مَجْمَع الْبَحْرِيْنِ كَمْ مَزَّقْتَ مِنْ","جَمْعٍ وَكَمْ بَاعَدْتَ بَعْدَ تَدَانِي",0,"ن",2,0],["يا مُجْزِلَ الصّدَقاتِ في جُنْحِ الدّجى","واللّيْلُ قدْ سُدِلَتْ لهُ أسْتارُهُ",1,"ر",2,0],["يا مُجَلّي العَمى وكافِي الدّواهي","ومُداوي المَرْضى وآسِي الجِراحِ",2,"ح",1,0],["يَا مَجْدَ رَمْسِيسَ كَمْ أَبْقَيْتَ مِنْ عَجَبٍ","فِيهِ وَمَسْأَلةٍ عَنْهُ لِحَيْرَانِ",3,"ن",1,0],["يا مجزل الرَّفد للنزيل به","جائزة جمة وزوَّاده",4,"ه",1,1],["يا مجرياً دمعي وموقف لوعتي","من جسمي المضنى على أطلال",5,"ل",1,0],["يا مجيرَ الورى من الحَدثانِ","وربيعَ العُفاةِ كُلَّ أَوانِ",6,"ن",1,1],["يا مُجابا دَعا إِلى مُستَجِيبِ","فَسَمِعنا دُعاءَه مِن قَريبِ",7,"ب",1,1],["يا مُجِيبَ الإسلامِ حينَ دعَاه","ومُقِيلَ الإسلامِ حينَ استقَالا",8,"ل",2,0],["يا مجدُ قَدْ فاتَ العُلى","مَنْ لا ينامُ عنِ السُّرى",9,"ر",2,1],["يا مجمعَ الشملِ من صحبٍ فُجعتُ به","وآخرٍ رُحْتُ أبلوه ويبلوني",10,"ن",2,0],["يا مَجلِساً ضَمَّ فِتياناً غَطارِفَةً","حازوا البَشاشَةَ وَالإِنعامَ وَالكَرَما",11,"م",2,0],["يا مَجلِساً أَكرِم بِهِ مَجلِساً","حُفَّ بِرَيحانٍ وَعَيشٍ عُجاب",12,"ب",1,0],["يا مَجْلِساً أَيْنَعَتْ مِنْهُ أزاهِرهُ","يُنْسيكَ أَوَّلَهُ في الحُسْنِ آخِرُهُ",13,"ر",2,1],["يَا مُجِيلَ الرُّوحِ في جَسَدي","والذِي يَفْتَرُّ عَنْ بَرَدِ",14,"د",1,1],["يا مجاريَّ إن تحتي جواداً","لا تجاريه في السباق الخيول",15,"ل",1,0],["يا مَجْلِسَ البَلَدَيْنِ منْتَظِماً","كَالعِقْدِ مِنْ نُبَلاَءَ أَمْجَادِ",16,"د",1,0],["يا مجدُ يا فنّ يا جنون","لم تُبقِ منّي الليالي سوى خيال خيالي",17,"ي",1,1],["يا مجدُ يا فنُّ يا جنون","أين الهوى والفتون والعصبةُ المعجون",17,"ن",1,0],["يَا مُجِيرَ الْفُصْحَى وَقَدْ عَقّهَا","الدَّهْرُ وأَغْرَى بِقَوْمِها حِدْثَانَه",18,"ن",2,0],["يا مجلساً عاد وجْداً","يُذْكي الفؤادَ ويُضْني",19,"ن",2,0],["يا مَجْلسَ الأمن، جِدُّ أنتَ أَم لعبُ؟","وصورةٌ حيَّةٌ، أمَ هيكلُ خشبُ؟",20,"ب",1,1],["يا مجلسَ الأَمن، من أَمَّنْتَهُ فَزعٌ","من خوفه قلبُه في صدره يَجِب!",20,"ب",1,0],["يا مجمع البحرين كم مزقت من","جمع وكم باعدت بعد تدان",21,"ن",1,0],["يامجاميع.. المسافات... العذاب....","ياحرام العين.... ياحل .. اليدين",22,"ن",1,1],["يا مجري النهر إلى البحر","ومسقط الطل على الزهر",23,"ر",1,0],["يا مجرياً في البيان طرفا","نائي المدى واسع المجال",24,"ل",1,0],["يا مُجيري مِنَ الزَّمانِ إِذا لَمْ","أَسْتَجِرْ منْ خُطُوبِهِ لي بِجارِ",25,"ر",1,0],["يا مَجْلِساً جَعَلْتُهُ","فِي مُدَّتِي أُنْمُوذَجِي",26,"ج",2,0],["يا مُجْتَدى الكرماءِ حَسْبُك قد طَما","بحرُ النوالِ فهانتِ الغُدران",27,"ن",1,0],["يا مُجرِياً دمعَ المَلا أَبحُراً","أَدرِكهُمُ يا مُرقىءَ الأَدمُعِ",28,"ع",1,0],["يَا مَجْمَعَ الْبَحْرَيْنِ بَحْ","رِ النُّور ِوَالطُّولِ الْمَدِيدْ",29,"د",1,0],["يا مُجيبَ الدُعاءِ إِنَّكَ أَدرى","بِصِفاتٍ لَهُ تَجلُ وَتَمدَح",30,"ح",1,0],["يا مُجيب المُضطرّ حينَ دَعاهُ","مُستَغيثاً وَكاشف الأَسواءِ",31,"ا",2,0],["يامجمل لا تهمل","إن عادتك الجماله",32,"ل",2,1],["يا مَجهَلي ما أَطوَلَك","أَلهَمُّ لي وَالسهدُ لَك",33,"ك",1,0],["يا مُجيبَ الدُّعَاةِ والعَضْبُ والعّذْ","بُ لِسانَا جِلادِهِ والجِدالِ",34,"ل",1,0],["يا مُجيري من صرفِ دهرٍ أذلاّ","وعمادي الأعلى وقِدْحي المُعلّى",35,"ل",2,1],["يا مجيب الداعي ويا خاذل","العادي وفكَّ العاني وجبر الكسير",36,"ر",1,0],["يا مَجدَ دين اللَّه وال","قرْمَ الّذي فاتَ النّعوتا",37,"ت",2,0],["يا مُجدِبَ الْحَالِ زُرْ نَادِيه مُعْتَفِياً","واسْأَلْ نَدَاهُ ولاَ تَسْأَلْ عَنِ المَطَرِ",38,"ر",1,0],["يا مُجَارِيه قَدْ جَهِدْتَ فَأَقْصِر","طَالَمَا خَابَ طَالِبٌ مَجْهودُ",39,"د",1,0]]}