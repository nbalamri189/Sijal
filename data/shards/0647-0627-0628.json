{"poems":[[55,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[55,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[79,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[29,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[74,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[45,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[82,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[22,"يا عام قد كنت ذا باع ومكرمة","https://www.aldiwan.net/poem21654.html","البسيط"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[79,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[92,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[132,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[280,"يا سقى الله شادنا بات يسقي","https://www.aldiwan.net/poem25473.html","الخفيف"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[487,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[495,"منا مُسافٍ يُسافي الناس ما يسروا","https://www.aldiwan.net/poem661.html",""],[543,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[563,"حرف عين العمى إلى النور داعي","https://www.aldiwan.net/poem34379.html","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88602","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86907","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38764","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72315","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126184","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126226","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93523","الرمل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84537","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83216","المديد"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130037","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133308","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4108,"","https://poetry.dctabudhabi.ae/diwan/poem/206282","الكامل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81692","المنسرح"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73142","المديد"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120515","السريع"],[4755,"كم جَهْد قلبي يضاوي لَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=192871",""],[5055,"خفايا الكون","https://www.poetsgate.com/ViewPoem.aspx?id=120915",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5186,"مخرت تحمل خمرا، وجعه","https://www.poetsgate.com/ViewPoem.aspx?id=156525",""],[5254,"نون","https://www.poetsgate.com/ViewPoem.aspx?id=211772",""],[5490,"عقد الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176377",""],[5806,"في شوفتك أعظم جروحي تشآفت","https://www.poetsgate.com/ViewPoem.aspx?id=176649",""],[5952,"إنَّهمْ زَبَدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197203",""],[5953,"ديني دان فاعرفوه","https://www.poetsgate.com/ViewPoem.aspx?id=93916",""],[6127,"صوت السماء","https://www.poetsgate.com/ViewPoem.aspx?id=215364",""]],"verses":[["هابَ ضَحضاحَها وَمَرَّ بِهِ الدَه","رُ عَلى سُبلِها فَخاضَ الغَمرا",0,"ر",2,0],["هابوا اِبتِسامَكَ في دَهياءَ مُظلِمَةٍ","وَلَيسَ يوصَفُ ثَغرُ اللَيثِ بِالشَنَبِ",1,"ب",1,0],["هابَ العِدا غَمَراتِ المَوْتِ إذْ بَصُروا","بالأُسْدِ تَنْزِلُ مِنْ سُمْرِ القَنا أجَما",2,"م",2,0],["هَابُوا الشَّرَى فَتَخَاذَلَتْ عَزَمَاتُهُمْ","جَهْلُ الرُّعَاةِ قَضَى بِهُلْكِ الضَّانِ",3,"ن",1,0],["هَابَتْ مَقَامَكَ فَاطَّبَيْتُ صِعَابَهَا","حَتَّى غَدَتْ ذُلُلاً عَلَى التَّدْرِيبِ",4,"ب",1,0],["هابَ الخَواتِنُ مِن بَناتِ مُجاشِعٍ","مِثلَ المَحاجِنِ أَو قُرونَ الأَيِّلِ",5,"ل",1,0],["ها بهجة الشهر في وصف المليح وفي","مدح العلاء مدى الأيام تروى لي",6,"ل",2,0],["هابَكَ اللَيلُ وَالنَهارُ فَلَو تَن","هاهُما لَم تَجُز بِكَ الأَيّامُ",7,"م",1,0],["هابكَ الموتُ إذ رآك مِسَحّاً","بطلاً لا يصولُ حَيثُ تَصولُ",8,"ل",1,0],["هابَت بَنو مالِكٍ مَجداً وَمَكرُمَةً","وَغايَةً كانَ فيها المَوتُ لَو قَدِموا",9,"م",3,0],["هابَ أن يُجري عليه حُكمَه","فنَوى الغَدْرَ له يومَ وُلِدْ",10,"د",1,0],["هابطاتٍ تئنُّ في قبضةِ الري","حِ وتُرغي على الصخورِ الصلابِ",11,"ب",1,0],["هابتْهُ أسبابُ المنيةِ جَهَرةً","فَرمتهُ خائنةً بِموت زُؤافِ",12,"ف",1,0],["هابوا الشرى فتخاذلت عزاماتهم","جهل الرعاة قضى بهلاك الضان",13,"ن",1,0],["هابُوا جلالتَك العُليا فما نَطَقُوا","حَرْفاً ولا سَلَّموا إلا بايماء",14,"ا",2,0],["هابكم دهرنا فلو أنكم تَنْهَوْ","نَه لم تَجُرْ بنا ساعاتُه",15,"ت",2,0],["هَابَ وَارْتابَ لاتِّقادِ سَنَاه","أَرَحيقاً يَصُبُّهُ أَمْ حَرِيقا",16,"ق",2,0],["هابَ الظَّلامَ وذاعريه فجرْسهُ","هَمْسٌ ونُطْقُ لسانهِ إيماءُ",17,"ا",2,0],["ها بارق من أهيل الحي أزعجني","فالدمع منسجم والطرف في لجج",18,"ج",1,0],["هابٍ هِبِلٌّ مُدِلٌّ يَعمَلٌ هَزِجٌ","طَفطافُهُ ذو عِفاءٍ نِقنِقٌ جَنِف",19,"ف",1,0],["ها بهَمسٍ على الدَّوامِ سَلاما","كلَّ عامٍ تُهدي الطبيعةُ تاجاً",20,"ج",2,0],["ها بلا ها وها هو الشان دان","وبعيد في عالم الإختراع",21,"ع",1,0],["هابَت سيوفك يَقضي وهي لو رقدت","لروعت من شباها وهي في الحلم",22,"م",1,0],["ها بكري أَمهِرْ بِأَنواع القبول عَسى","هِلال جاه الثَنا يَسمو بِأَنوار",23,"ر",1,0],["هابَتهُ في آجامِها فَتَخَبّأَت","لِتَفوزَ مِنهُ بِالنّجاةِ وَتَسلَما",24,"م",2,0],["هابت سطاي ليوث الغاب غادية","ورحت من لحظات الظبي في وجل",25,"ل",1,0],["هابت به مشكلات العلم حيَّ على","من في دنى فهمها صما وعميانا",26,"ن",2,0],["هابَنى هَيبَةَ الأُسُودِ لأنّى","لاحَظتنِى عُيُونُهُ فى قواه",27,"ا",2,0],["هابهُ أَهل الشَقا حَتّى لَقَد","رَعَت الشاة إِلى جَنب الذِئاب",28,"ب",1,0],["هابَت جيوش العدا في الحرب عزمته","حتى تولى عَلى الاعقاب أَجراها",29,"ا",3,0],["ها بَنوكِ الغُرُّ قَد نَهَضوا","فَاِرفَعي فَوقَ الرُبى الشارا",30,"ر",2,0],["هابوكَ في طيّ اللفائفِ مُغمداً","ما بالهم لو أبصروك مشهّرا",31,"ر",2,0],["هابتك أبطال السياسة والحجا","وطلبت إنصافا فقالوا أنصفا",32,"ف",2,0],["هابَها كُلُّ إِلاهٍ وَبَشَر","فَتَرَوّى زَفسُ في حِدَّتِهِ",33,"ه",1,0],["هابُوكَ فانْذَعَرُوا ومِنْ أَعذارهمْ","أن السَّوامَ تهابُ ليثَ الغاب",34,"ب",1,0],["هابوا اللِّقاءَ، فخلَّفوا ألغامَهُم","وكذا يُحاربُ في الوغى الجُبنَاءُ",35,"ا",2,0],["هابطة النهر منك أذكرها","من شطٍّ اعلاه جسرُ وضَّاح",36,"ح",1,0],["هابطٌ حظِّي بهِ وأرَى","أنَّ في عِشقي لهُ شَرَفي",37,"ف",2,0],["هابت ملوك الأرض طرا حمى","مقامه من كل فاص ودان",38,"ن",1,0],["هابيلَكَ اليوم قابيلَك","حارَه ومجنونَها العاقل",39,"ل",1,0],["هابيل مات وعارضٍ بعض لحوالي","أسباب فالأيام تفتح لك أبوابه",40,"ب",2,0],["هابوه لا لغضاضة بل أذعنوا","لكمال منقطع القرين خطير",41,"ر",1,0],["هابه الناس وخافوا شره","ورفاق الشغل مجوا جشعه",42,"ع",2,0],["ها بسمة الوهم في أضلاع عافيتي","إذ ترفع الصمت غربالا على وهني",43,"ن",2,0],["ها بتّ كالظبي يهفو حيث مورده","يصطاده الموت وهو الغافل السالي",44,"ل",2,0],["هابت ، ونآلت وآستظلت وخآفت","عن كل عين\"ن\" ودها يمك آتسوم",45,"م",1,0],["(هابيلُ) يدفع بالقربان مِنْ دَمِهِ","مِنْ مِثِْلِ (قابيلَ)... أنّى يُطلبُ المَددُ؟!",46,"د",1,0],["هابيل شيث بلا زوالٍ","ويوسفٌ ويوشع الجليل",47,"ل",1,0],["هابوه مذ وثقوا أن لا سبيل سوى","ما تستطيع يداه، والندى حملا",48,"ل",2,0]]}