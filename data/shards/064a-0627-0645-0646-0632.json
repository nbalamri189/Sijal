"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36716","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89991","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59513","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102940","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69922","الكامل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139431",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86484","السريع"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103259","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73206","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33764","البسيط"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89580","الكامل"],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[5271,"أجهلُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=64038",""],[5277,"تباريح","https://www.poetsgate.com/ViewPoem.aspx?id=185473",""],[5277,"شرنقةُالحرير..","https://www.poetsgate.com/ViewPoem.aspx?id=190715",""],[5277,"بوّابةُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=198599",""],[5376,"يا من زعمتم بأن الفجر وضاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=197731",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[5431,"في رثاء القسيس المذبوح","https://www.poetsgate.com/ViewPoem.aspx?id=183047",""],[482,"خلا مِنَ القومِ مصطاف ومرتبعُ","https://www.poetsgate.com/ViewPoem.aspx?id=111303",""],[5732,"دار خلت","https://www.poetsgate.com/ViewPoem.aspx?id=177925",""],[5736,"أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=203883",""],[5780,"المرء بالأعمال","https://www.poetsgate.com/ViewPoem.aspx?id=187625",""],[5786,"مِلْ يمنَةً بلوى العقيقِ وبانهِ","https://www.poetsgate.com/ViewPoem.aspx?id=50659",""],[5786,"حتّامَ دمعك في الأطلال ينسكبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50654",""],[5851,"الوطن المسافر","https://www.poetsgate.com/ViewPoem.aspx?id=175286",""],[5957,"أهويتَ غيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=12236",""],[6078,"بلقيس شعري","https://www.poetsgate.com/ViewPoem.aspx?id=203024",""],[6120,"‏إِنْهَضْ فَأَنْتَ مَشَاْرِقُ الإِصْبَاْحِ","https://www.poetsgate.com/ViewPoem.aspx?id=215467",""],[6155,"يا هادي الضلال للدين القويم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=540438",""]],"verses":[["يا مَنزِلاً أَدمُعي تَجري عَلَيهِ إِذ","ضَنَّ السَحابُ عَلى الأَطلالِ بِالمَطَرِ",0,"ر",1,0],["يا مُنزِلَ الغَيثِ وَالمُفَرَّجَ لِل","كَربِ وَيا ذا الإِفضالِ وَالنِعَمِ",1,"م",1,1],["يا من زكت أحسابهم","فأتوا بأخلاق نوابه",2,"ب",2,0],["يا من زهت عن أن تماشي شخصها","قمراً وعن غصنِ الرياض تماشي",3,"ي",1,1],["يا منزل ابن عليّ حيتك الصبا","وسقى مرابعك الغمام الهامع",4,"ع",1,1],["يا من زكا جهرُه وإسرارُهُ","وصحَّ إبداؤه وإضمارُهُ",5,"ر",2,1],["يا منزلاً تَنْشُرُه يدُ البلى","نَشْرَ يمان خَلَقٍ لم يُرْقعِ",6,"ع",1,0],["يا مَنزِلاً أَعنَقَت فيهِ الجَنوبُ عَلى","رَسمٍ مُحيلٍ وَشِعبٍ غَيرِ مُلتَئِمِ",7,"م",1,0],["يا مَنزِلاً أَعطى الحَوادِثَ حُكمَها","لا مَطلَ في عِدَةٍ وَلا تَسويفا",8,"ف",2,0],["يَا مَنْزِلاً لَمْ يَدَعْ وَشْكُ الْفِرَاقِ بِهِ","إِلَّا رُسُوماً كَوَحْيِ الْخَطِّ بِالْقَلَمِ",9,"م",1,0],["يا مَنزلَ النَفسِ تَرضاهُ إِلى أَجلٍ","مِن الحَياةِ وَتجفوه إِلى حينِ",10,"ن",1,1],["يا مَنزِلاً فيه تعاطينا الهَوى","لا أَنتَ أَنتَ وَلا الزَمان زَمان",11,"ن",1,0],["يا مَنْزِلاً نَزَلَت به وبأَهْلِهِ","طَيْرُ النَّوى فَتَغَيَّرُوا وتَنَكَّرُوا",12,"ر",3,0],["يا مَنزِلاً أَدمُعي تَجري عَلَيهِ إِذا","ضَنَّ السَحابُ عَلى الأَطلالِ بِالمَطَرِ",13,"ر",1,0],["يَا مَنْ زَهَا بِسَنَاهُ صَدْرُ النَّادِي","وَهَوَاهُ فِي المُهَجَاتِ وَالأكْبَادِ",14,"د",1,1],["يا من زمام القلب طو","ع قياده أنى يميل",15,"ل",1,1],["يا منزِلَ الحَيِّ بِالجَرعاءِ لا بَرِحَت","تَهمي بِكَ المُزنُ مُنهَلّاً عَزالِيها",16,"ي",3,0],["يا منزلا فيه لأرباب الهوى","مرأى يروق من الجمال ومسمع",17,"ع",1,0],["يا منزلاً عكفت به غرر النهى","وبقدس ساكنه القلوب تطهرت",18,"ت",1,0],["يا مَنزِلا بِاللِوى أَقوى مَعالِمُهُ","لَم يَعفُ وَجدي عَلى سُكّانِهِ وَعَفا",19,"ف",2,0],["يا منْزلاً كانَ الحِفاظُ يُجِلُّهُ","والجودُ بالضِّيفَانِ فيهِ يُرَحّبُ",20,"ب",1,0],["يَا مَنزِلاً كَانَ أهلُوهُ لِرفعَتِهِ","يَرَونَهُ فِي الدَّراري مُعرِقَ النَّسَبِ",21,"ب",1,1],["يا مَن زِمامُ الزّمانِ الصّعْبِ في يَدِه","فكيف ما شاء أَنْ يَمْشي يُمشِّيه",22,"ي",2,0],["يا مَنزلاتً كان بالجرعاء يجمعُنا","بكَتْ عليكَ عيونُ العارض الهتنِ",23,"ن",1,0],["يا مَنزِلاً ما كنت أَحسَبُ أَنَّني","أَحيا إِذا ما بِنتُ عَن آرامِهِ",24,"م",2,0],["يا منزلا كان فيه العز مقترنا","بالسيف والمال مقرونا إلى الكرم",25,"م",1,1],["يا منزلَ السّادة الأشرافِ قد نَزَلَتْ","فيك الأماجد من أشراف عدنان",26,"ن",1,1],["يا منزلَ الأَحباب أينَ أحبَّة","سارت بهم قبّ البطون ذميلا",27,"ل",2,0],["يا منزلا لعبت به أيدي الصَّبا","لعبَ الشكوك وقد بدت بتيقُّني",28,"ن",2,0],["يا منزلاً بينَ العُذَيْبِ وحاجرٍ","حُوشيتَ أن ألْفَى لعهدِكَ ناسيا",29,"ي",2,0],["يا منزلاً نحوَه للنجبِ مُنْعَرَجٌ","في البيدِ يذعرنَ رضراضاً وصُفّاحا",30,"ح",2,0],["يا منزلاً لعِبَ الزمانُ بأهلهِ","وأعادَه الحَدَثانُ قَفْراً بَلْقعا",31,"ع",2,0],["يا منزلاً بينَ العُذَيبِ ولَعْلَعٍ","أشتاقُهُ سُقيَ العُذَيبُ ولَعْلَعُ",32,"ع",1,0],["يا منزلاً أدمعي وقفٌ عليه اِذا","ضَنَّ السحابُ على الأطلالِ بالمَطَرِ",33,"ر",1,0],["يا منزلاً أستافُ رَوْحَ صعيده","فكأننَّي أستافُ مسكاً أذفَرا",34,"ر",2,0],["يا منزلاً قد طالَ نحوَ ربوعهِ","خَبَبي على طولِ المدى ووجيفي",35,"ي",1,0],["يا منزلا حسن الفؤاد لأهله","وسعى له الخل الوفي فزارا",36,"ر",2,1],["يا مَنزل الغيثِ مرخىً من ذَلاذِلِهِ","يحثّه صَخَبُ التّغريدِ مهتزمُ",37,"م",1,0],["يا منزل الركب بين البانِ فالعلمِ","من سفح كاظمةٍ حبيت بالديمِ",38,"م",1,1],["يا منزلا فيه ودّعتني","جمل وسارت بها الجمالُ",39,"ل",1,0],["يا من زكا فلذاك لم يولد لا","دم مثله وبمثله حوا عقيم",40,"م",1,0],["يا منزل القرآن كيما نستمد","ومرسل الإرسال كيما نستقيم",40,"م",1,0],["يا منزلاً للضيف يحكي صدرهُ","رحب الفضا ونداه يحكى الوابلا",41,"ل",2,1],["يا منزلا فيه الحبيب نازل","لا زال جود الله فيه هاطل",42,"ل",1,0],["يا منزلاً بات الهوى صبه","وإنني قبل الهوى صبه",43,"ه",1,0],["يا منزل الأحرار إذ ملكوا","يبكي عليك مرادك الحر",44,"ر",1,0],["يا منزلاً لا يزال القلبُ بالغهُ","وإن تباعد أَهلوه وإن هَجَروا",45,"ر",3,0],["يا مَنزِلاً نَشطَت إِلَيهِ عَبرَتِي","حَتَّى تَبَسَّمَ زَهرُهُ لِبُكائِي",46,"ا",2,0],["يا منزل الغيث فضلا بعدما قنطوا","وناشر الرحمة العظمى بحسن وفا",47,"ف",2,0],["يا منزلَها عند الوادي","لا سافر عنكَ الإشراق",48,"ق",1,0],["يا منزل القرآن نو","راً للبصائر والعقول",49,"ل",1,0],["يا منزل الدين أهل الدين قد خرجوا","بغياً عليه وعن منهاجه حردوا",50,"د",3,0],["يا مَنزِلَ الأَحبابِ كُنتَ أَنِيساً","وَأَراكَ بَعدَ الظاعِنينَ دَرِيسا",51,"س",2,1],["يا منزلاً تمت أهلّة حُسنه","هنّى أهاليك البقا من منزل",52,"ل",1,1],["يا من زعامته يقي","دونه كبت الظنون",53,"ن",1,0],["يا منزلاً لم يساعدني الزمان به","لم يدر لي بأن أحيا به الفلك",54,"ك",1,0],["يا منزلاً بمحاني الطف لا برحت","تسقي السحائب منك البان والكثب",55,"ب",1,0],["يا مَنزِلَ الحَيِّ ذا المَغاني","انعَم صَباحاً عَلى بِلاكا",56,"ك",2,1],["يا من زها حسنه بلا دل وذهوب","زين السجايا مولع بالمزاحي",57,"ح",2,0],["يا مَنزلاً ما له نظير","لم يبقَ سكناك في الصدور",58,"ر",1,1],["يَا مَنْزِلَ التنزيل هل أنا نَازِلٌ","بك مَنْزِلاً يَشْفي من الحسرات",59,"ت",1,0],["يا منزِلَ ابن همشكٍ لا خلوتَ منَ ال","أفراح والجاهِ والراحاتِ والنِعَمِ",60,"م",1,0],["يا منزل الغيث بعدما قنطوا","ويا ولي النعماء والمنن",61,"ن",1,1],["يا منزل الأحباب والمعهدا","حياك وكاف الحيا مرعدا",62,"د",2,1],["يا منزل الحي بالأجراع من لجب","بادت معارفه في سالف الحقب",63,"ب",1,1],["يا منزلاً بالحمى قَدْ شِيد بالهمم","أصبحتَ فِي ذِروة العَلْياء كالعَلم",64,"م",1,0],["يا منزلَ العظماءِ إن تك للنوى","تبكي فهجرُ الصَّب أعظمُ دائه",65,"ا",3,0],["يا منزلاً عبثَ النسيمُ بتربهِ","لا غيرتْكَ حَوادثُ الأَيَّامِ",66,"م",1,0],["يا منزلَ الحيِّ بسَقطِ اللوى","لا دَلَّ من دَلَّ عليكَ النوى",67,"ا",1,1],["يا منزلاً قضتِ الصبابَةُ لي بِه","ذِمَمَ الصِبا وَمآربَ العشرينِ",68,"ن",1,0],["يا من زهدت بكل وجه بعد ما","نظرت عيوني وجه الوضاحا",69,"ح",2,0],["يا منزلاً بالبلى غيبن أرسمه","يبكيه شجواً على بعد متيمه",70,"م",2,1],["يا منزلاً قد أبعدته يد النوى","حياك من غيث السماء مريعه",71,"ع",2,0],["يا منزلاً طال عهدي عن معاهدة","فبت احي الدجى شوقاً أناجيه",72,"ي",2,0],["يا مَنزل الآياتِ وَالفُرقانِ","بيني وَبينَك حرمةُ القرآنِ",73,"ن",1,1],["يا منزلاً باهى بتفويقهِ","حدائقَ الروضِ وزَهرَ الأَكَم",74,"م",1,1],["يا من زرعت بكل جارحة لنا","أملا سقاه الحب من مدراره",75,"ر",2,0],["يا مَنزِلاً عَهدي بِهِ","سامي الضُحى زاهي الغلس",76,"س",1,0],["يا منزلاً أفقُهُ بانَت كَواكبه","مِن بَعد ما كان عَن زَهر السَماء غنى",77,"ن",2,0],["يا مَنزِلاً لَعِبَ الزَمانُ بِأَهلِهِ","طَوراً يُفَرِّقُهُم وَطَوراً يَجمَعُ",78,"ع",1,1],["يا مَنزِلاً بِجَنوب الغُوطَتينِ غَدا","يَهيجُ للصَبِّ بِالتِذكارِ أَشجانا",79,"ن",2,0],["يا مَنزِلاً نَزَلَتهُ أَحداثُ النَوى","وَخُطوبُ دَهرٍ لِلصِعاب مُذلَّلِ",80,"ل",1,0],["يا منزلا بات من سُكانه عُطلا","ماق يل حلُّوه حتى قيل قد ساروا",81,"ر",3,0],["يا منزلا جمحَ الزمان بأهله","فرماهمُ بتشتُّتٍ وتباينِ",82,"ن",1,0],["يا منزلا كانت لنا في حانه","أكواب عيش بالبطالة تتضح",83,"ح",1,0],["يا مَن زرعت الفَضل بِالفَضل بشرا","لا رَيب انك حاصدٌ ما تزرعُ",84,"ع",1,0],["يا منزلاً لم تبل أطلاله","حاشا لأطلالك أن تبلى",85,"ل",2,1],["يا منزل الحي بدار السلام","جاد مغانيك ملث الغمام",86,"م",1,1],["يا منزلٌ دك القضاء عماده","دكاً وليس عن القضاء محيدُ",87,"د",1,0],["يا منَزلاً بين رضوى والعقيقِ سقَى","أيامكَ الغُرَّ هطَّالٌ من الدِّيمِ",88,"م",1,0],["يا منزلَ القصفِ في سَمالُو","مالي عن طيبكَ انتقالُ",89,"ل",1,1],["يا مَن زَها في نَضرَةٍ","طاحَت بِآياتِ الفِكَر",90,"ر",1,0],["يا من زرعت الشر لن تجني سوى","شرٍ وحقدٍ في الصدور دفين",91,"ن",1,0],["يَا مَنْ زَرَعتُكِ وَردَة في أَضلعي","مازِلتُ أَصرخُ أَنني أَتَحملُكْ",92,"ك",1,0],["يا من زرعتك نخلةً","وجنيتُ أعذاقَ الهجيرْ",93,"ر",1,0],["يا من زرعتك زهرةً","وحصدتُ أشواكَ الهجيرْ",94,"ر",1,0],["يا من زرعتُ شغافها في أضلعي","وحصدته عسلا من الدرّاقِ",95,"ق",1,0],["يا من زعمتم بأن الفجر وضاحُ","بكم تجارتنا بالخسر تنداحُ",96,"ح",1,1],["يَا مَنْ زَرَعتِ رُقَيْمَاتَ الأُلَى عَشِقُوا","غَابَاتِ نَخْلٍ وأَعرَاسَاً مِنَ الجُمَلِ",97,"ل",1,0],["يامن زرعتَ الخيرَ حولك ناشرا",".وبذرتَ أمناً حانيا ومثابرا",98,"ر",2,1],["يا منزلاً بانَ أهلوه وغيَّرَهُ","طولُ الزمانِ فدمعي فوقه دُفَعُ",99,"ع",1,0],["يا منزل الغالين رد الخبر به","وعطني سراير خافي العلم منها",100,"ن",3,0],["يا منْ زرعتُكَ في العلياءِ بدرَ دُجًى","شمسًا إليها يحُجُّ الليلُ والغَسقُ",101,"ق",1,0],["يا من زكتْ أعمالُه والمرء بالْ","أعمالِ لا في شخصه إنسان",102,"ن",1,0],["يا منزلاً سكن الجوى في مُهجتي","مُذْ أصبحَ التشتيتُ في سُكّانه",103,"ن",2,0],["يا منزلاً زفراتي رحنَ في صَعدٍ","منهُ ودَمعي في أطلاله صَبْبُ",104,"ب",1,0],["يامن زرعت الورد في كل المدى","ورأيت موتك مقبلا بقفاره",105,"ر",2,0],["يا مَنْ زرعت الوجد ما بين الرؤى از","دهت الحنايا فجرت إحساسي",106,"ي",1,0],["يامن زرعتَ بساتينا\" بأوردتي","رَبيعُ حُبِّكَ باﻷطيابِ يغشاني",107,"ن",2,0],["يَا مَنْ زَرَعْتَ الْحُبَّ بَيْنَ قُلُوبِنَا","وَقَتَلْتَنَا حُبًّا بِغَيْرِ سِلَاحِ",108,"ح",1,0],["يا من زكا فلذاك لم يولد لا","دم مثله وبمله حوا عقيم",109,"م",1,0]]}