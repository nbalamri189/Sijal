"https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"على حدود فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179015",""],[46,"ما عاقدُ الحبل يبغي بالضّحى عَضَداً،","https://www.poetsgate.com/ViewPoem.aspx?id=18255",""],[85,"خَطَّتْ يداكَ الرَّوْضَة َ الغَنَّاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9650&r=&rc=140",""]],"verses":[["أُلَعِّنُهُ مُستَثنِياً مِن عِنانِهِ","كَرَدِّكَ في الغِمدِ الكَهامَ المُفَلَّلا",0,"ل",2,0],["العَقلُ أَبلَغُ مَن عَزّاكَ مِن جَزَعٍ","وَالصَبرُ أَذهَبُ بِالبَلوى مِنَ الأَجَلِ",1,"ل",1,0],["العِرضُ يُترَكُ لِلرامي بِمَضيَعَةٍ","وَالمالُ يُحفَظُ بِالأَعوانِ وَالحَرَسِ",2,"س",1,0],["العاطِفونَ إِذا الصَديقُ نَبا","وَالمُحسِنونَ إِذا الزَمانُ أَسا",3,"س",2,0],["العِزُّ مِن شِيَعِ الغِنى","وَالذُلُّ أَولى بِالفَقيرِ",4,"ر",1,0],["أَلِعَقرِ القَلبِ راحوا","أَم لِعَقرِ البَدَناتِ",5,"ت",1,0],["العاشِقانِ كِلاهُما مُتَغَضِّبُ","وَكِلاهُما مُتَشَوِّقٌ مُتَطَرِّبُ",6,"ب",1,1],["العِلمُ ما كانَ فيهِ قالَ حَدَّثَنا","وَما سِوى ذاكَ وَسواسُ الشَياطينِ",7,"ن",1,0],["العِلمُ مِن فَضلِهِ لِمَن خَدَمَهُ","أَن يَجعَلَ الناسَ كُلَّهُم خَدَمَه",8,"م",2,1],["العِلمُ مَغرَسُ كُلِّ فَخرٍ فَاِفتَخِر","وَاِحذَر يَفوتُكَ فَخرُ ذاكَ المَغرَسِ",9,"س",1,1],["الْعًمْرُ نَوْمٌ وَالْمُنَى أَحْلاَمُ","مَاذَا عَسَى أَنْ يَسْتَمِرَّ مُقَامُ",10,"م",1,1],["الْعَدْلُ وَالشِّيَمُ الْكَرِيمَةُ وَالتُّقَى","وَالدَّارُ وَالأَلْقَابُ وَالْخُدَّامُ",10,"م",1,0],["العُذرُ أوضَحُ منْ نِورٍ على علَمٍ","فعَدِّ إنْ غِبْتَ عن لهْوٍ وعنْ فَنَدِ",11,"د",1,0],["العَيشُ لا عَيشَ إِلّا ما اِقتَصَدتَ فَإِن","تُسرِف وتبذر لَقيتَ الضُرَّ وَالعَطبا",12,"ب",2,1],["العِلمُ زَينٌ وَتَشريفٌ لِصاحِبِهِ","فاِطلُب هُديتَ فنونَ العِلمِ وَالأَدَبا",12,"ب",2,0],["العِلمُ كَنزٌ وَذُخرٌ لا نَفادَ لَهُ","نِعمَ القَرينُ إِذا ما صاحَبَ صُحبا",12,"ب",2,0],["العِلمُ يُذكي نارَها وَتُثيرُها","مَدَنِيَّةٌ خَرقاءُ لا تَتَرَفَّقُ",13,"ق",1,0],["العِلمُ شَرقِيٌّ تَغافَلَ أَهلُهُ","عَنهُ فَعاقَبَهُم بِطولِ غِيابِ",14,"ب",1,0],["العِلمُ في البَأساءِ مُزنَةُ رَحمَةٍ","وَالجَهلُ في النَعماءِ سَوطُ عَذابِ",14,"ب",1,0],["أَلَعَلَّها وَالتيهُ يَثني عِطفَها","حَمَلَت رِكابَ زَعيمِ قَلبِ المَشرِقِ",15,"ق",1,0],["العَجزُ أَقعَدَني وَإِنَّ عَزائِمي","لَولاكُما فَوقَ السِماكِ تُحَلِّقُ",16,"ق",1,0],["العاصِمينَ إِذا النُفوسُ تَطايَرَت","بَينَ الصَوارِمِ وَالوَشيجِ الراعِفِ",17,"ف",1,0],["العادِلِ المَلِكِ الَّذي أَسماؤُهُ","في كُلِّ ناحِيَةٍ تُشَرِّفُ مِنبَرا",18,"ر",2,0],["العِطرُ مِنهُ سَرى لَهُ نَفَسٌ","مِن نَفَسِ الرَوضِ رَقَّ في السَحَرِ",19,"ر",1,0],["أَلعَدْلُ شَيْءٌ فَوْقَ حِسْبَةِ سَيِّدٍ","فِي قَوْمِهِ أَوْ قَائِدٍ فِي جُنْدِهِ",20,"د",2,0],["أَلعَدْلُ شَيْءٌ مُطْلَقٌ مَنْ يَلْتَزِمْ","تَجْنِيسَهُ يَفْسُدْ عَلَيْهِ وَيُرْدِهِ",20,"د",2,0],["أَلعِلْمُ يَجْلُوهُ لأَرْبَابِ النُّهَى","وَالحَقُّ يَسْطَعُ فِيهِ وَالبُرْهَانُ",21,"ن",1,0],["أَلعَالِمينَ بِأَنَّ الْغُنْمَ إِنْ هُوَ لَمْ","يَعُدْ عَلَيْهَا بِقِسْطٍ مَحْضُ خُسْرَانِ",22,"ن",1,0],["العَقْلُ بِالرَّجْحَانِ عَقْلُ حَصِيفَةٍ","وَالقَلْبُ بِالتَّحْنَانِ قَلْبُ رَؤُومِ",23,"م",1,0],["العِزَّةُ العقساءُ لا تَأْبَى عَلَى","بَطَلٍ المَوَاقِفِ أَنْ يَكُونَ رَحِيمَا",24,"م",2,0],["إِلعَيْشُ فِيمَا يَرَاهُ يَقْظَةٌ شُغِلَتْ","بِالسَّعْيِ وَالجِدِّ لا رُؤْيَا وَلا حُلُمُ",25,"م",1,0],["ألعرَقُ الذُّوقِيُّ أَشْهَى الطَّلا","كَيْفَ وَقَدْ عُتِّقَ أَعْوَامَا",26,"م",2,1],["أَلعَالَمُ العَرَبِيُّ مِنْ أَطْرَافِهِ","بَادِي الوُجُومِ مُنَكَّسُ الأَعْلامِ",27,"م",1,0],["أَلعَبْدُ يُعْطِي مِنْ حُطَامٍ بَائِدٍ","وَاللهُ يَجْزِي بِالنَّعِيمِ الدَّائِمِ",28,"م",1,0],["أَلْعُمْرُ أعمارٌ اسْتَثْمَرْتَهُ","وَيَزِيدُ غَلَّةَ وَقْتِهِ التَّقْسِيمُ",29,"م",1,0],["العِزُّ ضَافِي وَالحَيَاةُ مَدِيدَةٌ","وَالبَيتُ بِالنَّسْلِ الكَرِيمِ حَفِيلُ",30,"ل",1,0],["العِلمُ يَنهَضُ بِالخَسيسِ إِلى العُلا","وَالجَهلُ يَقعُدُ بِالفَتى المَنسوبِ",31,"ب",1,1],["العلو فيه والمل","كل من ريّه توهل",32,"ل",1,0],["العود أخذ وسوّاه","والدر أنثر من فاه",33,"ه",1,0],["العلم والحلم والإفضال شيمته","والبأس والجود بعض من سجاياهُ",34,"ا",2,0],["العَوَثُ من هذا الجمود فإنّه","تالله أهَونُ منه صُمُّ الجَنْدل",35,"ل",1,0],["العدل شيمتهم والعفو عادتهم","والصبر دَيْدنهم في كل مُحْتَرَب",36,"ب",1,0],["العار يرحل معهم أينما رحلوا","والخِزي يهبِط معهم أينما هبطوا",37,"ط",3,0],["العلم فَيْض تحيا القلوب به","فأمتّح بسَجْل الحياة من قُلُبه",38,"ب",2,0],["العلم كالنور بل أفضله","ما أفقرَ النورَ أن يُشبَّه به",38,"ب",2,0],["العُذرُ مِنكَ عَلى الحالاتِ مَقبولُ","وَالعَتبُ مِنكَ عَلى العِلّاتِ مَحمولُ",39,"ل",1,1],["العلم والزهد والعطايا","فكلنا طالب مريد",40,"د",1,0],["العبد ما حليَ في عهدة","والأهل لا حلي ولا سيري",41,"ر",2,0],["العالم الملك السيَّار سؤددهُ","في الأرضِ سير الدراري بين أفلاك",42,"ك",1,0],["العيد قد حمل الهنا أعلامه","فتهنّ يا علاّمةَ الأعلام",43,"م",1,0],["العيد أنت وهذا عيدنا الثاني","ما للهنا عن قلوب الخلق من ثاني",44,"ي",1,1],["العبد يهدى على مقداره وعلى","مقدار ساداتها تسدي يد المنن",45,"ن",1,1],["ألعصر أقرأ تعويذاً لحاسده","من شرِّ حاسدها والعصر تقريني",46,"ي",1,0],["العَينُ تُبصِرُ مَن تَهوي وَتَفقِدُهُ","وَناظِرُ القَلبِ لا يَخلو مِنَ النَظَرِ",47,"ر",1,1],["العُشقُ في أَزَلِ الآزالِ مِن قِدَمٍ","فيهِ بِهِ مِنهُ يَبدو فيهِ إِبداءُ",48,"ا",2,1],["العُشقُ لا حَدَثٌ إِذ كانَ هُو صفةً","مِنَ الصَفاتِ لِمَن قَتَلاهُ أَحياءُ",48,"ا",2,0],["العاسِف المالَ لِسُؤَّاله","والسالك الرأيَ على القصْدِ",49,"د",1,0],["العلاءُ المبتَني شُمَّ العُلا","مُنْجِد المنجود طَلّاع النِّجادِ",50,"د",1,0],["العَلاء المبتَنى شُمّ العُلا","فوق ما أَثَّل قَحطانُ وهُودُ",51,"د",1,0],["العارض المستهلّ منذ رأى","أنّ العلى في الكرام مبتَدره",52,"ر",2,0],["العينُ لا تنفكُّ من نَظرٍ","والقلبُ لا ينفك من وطرِ",53,"ر",1,1],["العقلُ مِعشار عقل","والشخص مثل شُخوص",54,"ص",1,0],["العادلين موازيناً إذا حكموا","والراجحين إذا ما شالت الكِفف",55,"ف",1,0],["العارُ منك وأنت من","هُ فليس من عار يمضُّك",56,"ك",1,0],["العذابُ الأفواه تشهدُ بالطي","بِ عن طيبها غصونُ الأراك",57,"ك",1,0],["العدلُ فرضٌ وبذلُ الفضلِ نافلةٌ","يا ابنَ الكرامِ فعدلاً ثم إفضالا",58,"ل",2,1],["العرفُ غيث وهو منك مؤمَّلٌ","والبشر برقٌ وهو منك مشيمُ",59,"م",1,0],["العارُ قدماً والشنا","ر لخالدٍ خالٌ وعمُّ",60,"م",1,0],["العين قبْل السِّنِّ وهْي المُبْتَسَمْ","فما لها والخدُّ وهْي الملتدَمْ",61,"م",1,0],["العادِلينَ بِدارِمٍ يَربوعَهُم","جَدعاً جَريرُ لِأَلأَمِ الأَعدالِ",62,"ل",1,0],["العِطرُ في أَثمارِها وَالشَهدُ في","أَنهارِها وَالسِحرُ في الأَنداءِ",63,"ا",2,0],["العُمرُ إِلّا بِالمَآثِرِ فارِغٌ","كَالبَيتِ مَهجورا وَكَالموماتِ",64,"ت",1,0],["العُمرُ إِلّا بِالمَآثِرِ فارِغٌ","كَالقَفرِ طالَ بِهِ عَناءُ الحادي",65,"ي",1,0],["العِطرُ يَعبُقُ من جَميعِ وُرودِها","ما أَن مَرَرتَ بِزَهرَةٍ لَم تَعبُقِ",66,"ق",1,0],["العَينُ بعدك تَقذي","بِكُلّ شَيءٍ تَراهُ",67,"ه",1,1],["العَجزُ خُلقٌ ذَميمٌ","فَلا تَحَدِّث عَنهُ",68,"ه",1,0],["العود شاعر بها","وهي به لشاعره",69,"ر",2,0],["العلم كالصبح الذي","تبيض منه الاكم",70,"م",1,0],["العلم ثم العلم فهو","وحده المنظم",70,"م",1,0],["العلم يبني المجد","والجهل له يهدم",70,"م",1,0],["العاريات للخلا","عات من الجلابب",71,"ب",1,0],["العين ترسل دمعها","والدمع اكثره نجيع",72,"ع",1,0],["العيب في امة اخلاقها فسدت","لا عيب في الدين عنه اهله انحرفوا",73,"ف",3,0],["العين شكرى والفؤا","د يذوب حزنا في مصابك",74,"ك",1,0],["العقل مفتكر والقلب مرتجل","وما كمرتجل للشعر مفتكر",75,"ر",1,0],["العقل بالعلم لا بالشعر منتفع","والقلب بالشعر لا بالعلم مزدهر",75,"ر",1,0],["العقل في الانسان ليس","من الضمير بافضل",76,"ل",1,0],["العقل يرفعني","ولكن الضمير ممثلى",76,"ل",2,0],["العبقري الفذ في ايامه","وله بذلك تشهد الايام",77,"م",1,0],["العلم هذا رأيهُ","فيها ورأُى العلم صائب",78,"ب",1,0],["العدل ثمّ آمن","والظلم ثَمَّ واجل",79,"ل",1,0],["العدل والظلم به","مخيم وراحل",79,"ل",1,0],["العقل ينفي اللَه بعد روية","ربأ بكون ليس بالمتناهى",80,"ه",2,0],["العيد هلّل في ذُراك وكبّرا","وسعى إليك يزف تهنئة الورى",81,"ر",2,1],["العز للإسلام","منارة الوجود",82,"د",1,1],["العلم في ظل البيان حَيالها","مثل الأزاهر في ظلال الماء",83,"ا",2,0],["العلم والبر هذا مهرجانهما","في ظل دار تناغى النجم أركانا",84,"ن",2,1],["العلم عندك