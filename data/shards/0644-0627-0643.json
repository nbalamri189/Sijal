بَ الفوائد","يُريغ بالمعروف حمد الحامدِ",115,"د",1,0],["لا كالذي يدعى وداً ، وباطنهُ","من جمر أحقادهِ تغلى مراجلهُ",116,"ل",2,0],["لا كالرياح سميرٌ حين ثورتها","إذ ما لأسرارها في الصدر أجنان",117,"ن",1,0],["لا كبعض لا يستوى عنده الثِّنتا","نِ أقصاه زوجة بالحِراءِ",118,"ا",2,0],["لِأَكوِيَهُ عِندَهُ كَيَّةً","أُقيمُ بِها نَخوَةَ الأَصعَرِ",119,"ر",1,0],["لا كان يوم سار فيه نُعاته","يُلثون في مهج الورى إحراقا",120,"ق",2,0],["لا كان من ينسى الولاء لراحل","يوماً وينقض بَعده الميثاقا",120,"ق",2,0],["لا كان عيدٌ رأينا صفوه كدراً","بفقده وانثنت راحاته تَعبا",121,"ب",2,0],["لاكثرةٌ تجْدي وليس شجاعةٌ","تغنِي بغير الفكر والتنظيمِ",122,"م",1,0],["لا كان يومٌ أهلُك استسلموا","إلى العدا فيه ونام الرقيب",123,"ب",1,0],["لا كان زادٌ في وعائك إنه","سببٌ لطاعمه من الطاعونِ",124,"ن",1,0],["لا كان هذا الدهرُ إن عطاءَهُ","بالله يسمُجُ في العقول ويفظُعُ",125,"ع",1,0],["لا كَما يَسبِقُ المُجاري المُجارى","بَل كَما يَسبِقُ الشَبابُ المَشيبا",126,"ب",2,0],["لا كَالرِجالِ تَبايَنوا لَكِن كَما","يَتَبايَنُ المَوجودُ وَالمَفقودُ",127,"د",1,0],["لا كَقَومٍ كَم طولِبوا بِالمَساعي","فَأَحالوا بِها عَلى الأَسلافِ",128,"ف",1,0],["لا كَالَّذي إِن عَدَّ يَوماً فَخرَهُ","فَعَلى مَآثِرِ أَوَّليهِ يُحيلُ",129,"ل",1,0],["لا كانَ رَأيُكَ ذا الصَحي","حُ وَلا مَوَدَّتُكَ العَليلَه",130,"ل",2,0],["لا كسب لي بل ولا شغلٌ ولا عملٌ","ففي حديثهم تجر وأرباح",131,"ح",1,0],["لا كانَ عَائِبُهُ فَقَدْ أَبْدى لَنا","عَيْنَ المُحالِ وَجاءَ بِالبُهْتَانِ",132,"ن",1,0],["لا كنسيم صالة إِذا جرى","يكدر العيشَ ولا بَردَ صبر",133,"ر",1,0],["لا كمياه إذا ترقرقت","رأيت منها الجسم مقشعرا",134,"ر",2,0],["لأكسب خيرا بالدعا من ذوى التقى","وبالسب من ذى شقوة حمل الثقلا",135,"ل",2,0],["لاكَهُ نابُ المُبيرِ المُعادي","مَرَّةً ضَغماً وَطَوراً صَريفا",136,"ف",2,0],["لا كانَ هَذا السَيرُ آخِرَ عَهدِنا","فَهِيَ اللَيالي رِحلَةٌ وَمَقامُ",137,"م",1,0],["لا كتاب بعهدة وشهود","بل جعلت الفراق قبل الطلاق",138,"ق",1,0],["لا كِتابٌ ولا حسابٌ ولا غر","بَةَ طالت ولا له اِستخفاءُ",139,"ا",2,0],["لا كشيءٍ في العالمينَ ولا تش","بههُ جلّ قدرهُ الأشياءُ