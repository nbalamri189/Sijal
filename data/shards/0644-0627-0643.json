ي","https://www.aldiwan.net/poem54927.html","المجتث"],[348,"قلم الوزير هو الشقيق لبيضه","https://www.aldiwan.net/poem20441.html","الكامل"],[349,"لا كنت إن كان لقلبي التذاذ","https://www.aldiwan.net/poem15647.html","السريع"],[364,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[364,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[366,"ما منك لي خلف ولا عوض","https://www.aldiwan.net/poem17025.html","أحذ الكامل"],[366,"لا كمثل القضيب والحق","https://www.aldiwan.net/poem17073.html","الخفيف"],[366,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[366,"يا ذا الذي مرج البحرين خاطره","https://www.aldiwan.net/poem17154.html","البسيط"],[366,"لا كنتما خلين قد لزماني","https://www.aldiwan.net/poem17290.html","الكامل"],[371,"دون اعتدالك حكم غير معتدل","https://www.aldiwan.net/poem57199.html","البسيط"],[371,"إن كان أطلق دمعه المحبوسا","https://www.aldiwan.net/poem57367.html","الكامل"],[380,"يقضي علي تعسفا","https://www.aldiwan.net/poem48808.html","مجزوء الكامل"],[380,"لبيك داعية الغرام","https://www.aldiwan.net/poem49199.html","مجزوء الكامل"],[402,"أنا وحدي في المكان","https://www.aldiwan.net/poem46526.html","مجزوء الرمل"],[402,"رح خاليا عما تكابد اضلعي","https://www.aldiwan.net/poem46746.html","الكامل"],[402,"الآن باح بمضمر الأسرار","https://www.aldiwan.net/poem46978.html","الكامل"],[402,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[403,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[403,"هذا سؤالي أتى من عالم فطن","https://www.aldiwan.net/poem33391.html","البسيط"],[403,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[403,"تجد البين فاستأنفت في العدد","https://www.aldiwan.net/poem33979.html","البسيط"],[416,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[416,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[432,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[432,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[432,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[432,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[432,"ولو أنني وقرت شعري وقاره","https://www.aldiwan.net/poem12662.html","الطويل"],[432,"اقطع مؤاخاة أخ جاف","https://www.aldiwan.net/poem12673.html","السريع"],[437,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[458,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[458,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[458,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[458,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[458,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[458,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[461,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"ديار هند أقفرت منذ أزمان","https://www.aldiwan.net/poem3492.html","عموديه"],[515,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[515,"أركبك الموت يا عطيه","https://www.aldiwan.net/poem12305.html","مخلع البسيط"],[529,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[538,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[551,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[551,"أفي كل يوم لي حميم أفارقه","https://www.aldiwan.net/poem47369.html","الطويل"],[558,"لا ووجه مسفر حاز الجمالا","https://www.aldiwan.net/poem33532.html","الرمل"],[558,"إن الذي أكد وعدي وفاه","https://www.aldiwan.net/poem33660.html","السريع"],[567,"لا وجفون ينفثن في العقد","https://www.aldiwan.net/poem69709.html","البسيط"],[575,"غلابة القول بل خلابة الخلس","https://www.aldiwan.net/poem2741.html","البسيط"],[575,"لا كانت الشمس فكم أصدأت","https://www.aldiwan.net/poem2808.html","السريع"],[575,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"]],"verses":[["لا كُنتُ مِن رَيبِ الزَمانِ بِسالِمٍ","إِن كُنتَ تَسلَمُ مِن يَدَيَّ كِفافا",0,"ف",2,0],["لا كَقَومِ لَم يَطلُعوا شَرَفَ الجَو","دِ وَلَم يَرفَعوا لِمَجدٍ مَنارا",1,"ر",2,0],["لا كانَ مَوضِعُكَ الَّذي مُلِّكتَهُ","بَينَ الأَضالِعِ بَعدَ ذا لَحَبيبِ",2,"ب",1,0],["لا كانَ قَلبي حينَ يَعبا بِمَن","لَهُ لِسانانِ وَوَجهانِ",3,"ن",1,1],["لا كانَ قَلبي فَقَد شَقيتُ بِهِ","يُخفي وَجيباً وَتارَةً يَجِفُ",4,"ف",1,0],["لاَكِنَّنِي كَلِفٌ بِكُلِّ غَرِيبَةٍ","تَحْوِي نُهىً وَبَلاَغَةً وَبَيَانَا",5,"ن",2,0],["لاَ كَانَ يَوْمُكَ يَا طَرِيْفُ فَطَالَمَا","أَطْلَعْتَ لِلآمَالِ بَرْقاً خُلَّبَا",6,"ب",2,0],["لا كانَ يَومُكِ يَومَ لا","حَ الحُزنُ مُختَلِفَ الصُوَر",7,"ر",1,0],["لا كِتابٌ مِنكَ يُطفِئُ ما","في فُؤادي باتَ يَشتَعِلُ",8,"ل",1,0],["لا كانَ يَومٌ بُدِّلَت","فيهِ الكَنائِسُ بِالمَساجِد",9,"د",1,1],["لا كانَ عِشقٌ لا يُصَكُّ لِعاشِقٍ","بِالنَعلِ فيهِ هامَةٌ وَأَخادِعُ",10,"ع",1,1],["لاَ كَبَا جَدُّكِ مِنْ سَيِّدَةٍ","فَضْلُهَا يَشْمَلُهُ فِي كُلِّ حِينْ",11,"ن",1,0],["لاَ كَمَنْ فِي الجَمِيلِ مَرْتَعُهُ","وَكَأَنَّ الجَمِيلَ لَمْ يَكُنِ",12,"ن",1,0],["لا كَافِرٌ مِنْهُمْ وَلا مُلْحِدٌ","وَلا جُحُودُ خَافِرٍ لِلذِّمَامْ",13,"م",1,0],["لا كَسَاكَ اللَّهُ ما عِشتَ رِيشَاً","وَبِخَوفٍ بِتَّ ثُمَّ تقِيلُ",14,"ل",1,0],["لا كَعَبدِ المَلِيكِ أو كَوَلِيدٍ","أو سُلَيمَانَ بَعدُ أو كَهِشَامِ",15,"م",1,0],["لا كانَ ذاكَ البخ منه ولا","كرَّر في أيَّامهِ قول بخ",16,"خ",1,0],["لا كان نشر العاذلين بضائع","عندي ولا عهد الهوى بمضيع",17,"ع",1,0],["لا كبغل مصر إذ قلت قدماً","فيه أو في بغال صحبي الأذله",18,"ل",2,0],["لا كمن تنتحي بمعشوقِهِ النح","وفمن فاعلٍ ومن مفعول",19,"ل",1,0],["لا كنتَ يا قلبُ كم تصبيك غانيةٌ","يعدي أخا اللحظ من ألحاظها السقم",20,"م",1,0],["لا كُنتُ إِن كَنتُ أَدري","كَيفَ السَبيلُ إِلَيكا",21,"ك",2,1],["لا كُنتُ إِن كُنتُ أَدري كَيفَ كُنتُ وَلا","لا كُنتُ إِن كُنتُ أَدري كَيفَ لَم أَكُنِ",22,"ن",1,0],["لأكدَّنَّ للمدائح فيه","فِكَري أو أردَّها أنضاءَ",23,"ا",2,0],["لا كذِبُ المُنية التي وَعدتْ","معروفَهُ يُشتكَى ولا لَعِبُهْ",24,"ب",2,0],["لا كخِلٍّ علمتُهُ لا يُرَجَّى","منه خيرٌ وشرُّهُ مرقوبُ",25,"ب",1,0],["لا كَثمارٍ سُمتُ أغْصانَها","إدْناءها مني فقصَّفْتُها",26,"ت",3,0],["لا كَمَنْ كانَ عِلْمُه واقلب العل","مَ يُريهِ الذَّبِيحَ كالمفْصُودِ",27,"د",1,0],["لا كَنُعْمَى ابن يزيدٍ إنها","أبداً حيث يلاقيها الوُجودُ",28,"د",1,0],["لا كقوم هامد معروفُهُمْ","بل هُمُ موْتى عن العُرفِ هُمُودُ",28,"د",1,0],["لا كالأُلى حملوا ما لا يفون به","وأُوقِروا من أثام أي إيقار",29,"ر",1,0],["لا كأقوام حَماهم","حظَّهم ضعفُ النَحائز",30,"ز",1,0],["لا كغُثاء تظل تلفظه","تخليطُ خرقاءَ مَيْش ميّاش",31,"ش",1,0],["لا كمنْ لو مشى لظلَّ يداني","فقحةً لا تُفارقُ المِسْواطا",32,"ط",2,0],["لا كان ذاك فلو رأوْه لأصبحوا","حلفاءَ خوفٍ لا ينام وجُوع",33,"ع",1,0],["لا كمن أعتب العواذل مذمو","ماً فأضحى أديمه ممزوقا",34,"ق",2,0],["لا كإمْضاءِ جاهلٍ عجرفيٍّ","يركبُ الرأيَ قبل شَدِّ الحزام",35,"م",1,0],["لا كان فيه مع النَّماءِ نقيصةٌ","وصفا له التَّخلْيدُ والتَتْميم",36,"م",1,0],["لا كالبيوتِ بيوتٌ حين تدخُلُها","إذْ لا كَسُكَّانِها في الأرضِ سُكَّان",37,"ن",1,0],["لا كمن يغلط في أحكامه","يَهَبُ العُرف ويبغي ثمنه",38,"ن",2,0],["لا كمن لم يَنَلْه واصطُلِمت إذ","ناه لمّا ابتغاهُ يا طُولَ حُزنِهْ",39,"ن",2,0],["لا كابن بلبلٍ الدعيِّ وعُصبةٍ","عَدِمُوا خِلالَ الخيرِ غيرَ هَواه",40,"ه",1,0],["لا كَما قَد حَيّتَ غَيرَ حَميدٍ","وَإِذا مُتَّ مُتَّ غَيرَ فَقيدِ",41,"د",1,0],["لِأَكبِتَ حاسِداً وَأَرى عَدُوّاً","كَأَنَّهُما وَداعُكَ وَالرَحيلُ",42,"ل",1,0],["لَأُكَلِّفَنَّ العيسَ أَبعَدَ غايَةِ","يَجري إِلَيها خائِفٌ أَو مُرتَجِ",43,"ج",1,0],["لا كانَ يَومُ البَينِ بَل لا كانَ مَن","نادى بِهِ فَأَهابَ كُلَّ هُجودِ",44,"د",1,0],["لَأَكدَيتُ حَتّى خِلتُ دِجلَةَ شُبِّهَت","وَقُلتُ السَرابُ في مَناقِعِها يَجري",45,"ي",1,0],["لا كَوثَرٌ أَغنى وَلا أَشياعُهُ","مِن رَهطِ بَيدونٍ وَلا فِرناسِ",46,"س",1,0],["لَأَكبَرتُ أَن أومِئَ إِلَيكَ بِإِصبَعٍ","تَضَرَّعُ أَو أُدني لِمَعذِرَةٍ فَما",47,"م",2,0],["لا كانَ وَجدي أَينَ كانَ وَأَنتَ لي","مِلكٌ وَعَهدي مِنكَ غَيرُ ذَميمِ",48,"م",1,0],["لَأَكسُوَنَّ بَني الفَيّاضِ مِن مِدَحي","ما باتَ مِنهُ لَئيمُ الناسِ عُريانا",49,"ن",2,0],["لِأَكلَفَ أُمُّهُ دَهماءَ مِنها","كَأَنَّ عَلَيهِ مِن جَلَدٍ جِلالا",50,"ل",2,0],["لا كَيفَ إِلّا عَلى غَلباءَ دَوسَرَةٍ","تَأوي إِلى عَيدَةٍ لِلرَحلِ مَلمومِ",51,"م",1,0],["لا كان عبد الحميد من رجل","مجاوز للمجون للحد",52,"د",1,1],["لا كانَ يَوماً يَدومُ غَيرَكُمُ","قَلبٌ عَلى فَرطِ حُبِّكُم جُبِلا",53,"ل",2,0],["لاكَت بِهِ خَيلُنا مَراوِدَها","ثُمَّ اِستَحَبَّت مِن بَعدِنا العَطَلا",53,"ل",2,0],["لا كِتابٌ يَأتي اِبتِداءً وَلا رَد","دُ جَوابٍ إِذا اِبتَدَأتُ بِكُتبي",54,"ب",2,0],["لا كُنتُ إِن اِنثَنَيتُ عَن دينِ هَواك","أُدعى في الأَنامِ مِن أَهلِ الذِمامِ",55,"م",1,0],["لا كِتابٌ بِهِ اِبتَدَأتَ وَلا رَد","دُ جَوابٍ وَلَو بِحَبَّةِ وَردِ",56,"د",1,0],["لا كَالَّذي جَعَلَ القَريضَ بِضاعَةً","مَتَوَقِّعاً كَسبَ الغِنى مِن كَدِّهِ",57,"د",2,0],["لِأُكابِدَنَّ لَهيبَ نارِ صُدودِهِ","وَلَأَركَبَنَّ عُبابَ بَحرِ مَلالِهِ",58,"ل",2,0],["لا كَالشَآمِ فَإِنَّ شَرطَ وُلاتِها","اللِصُّ يَجني وَالمُقَدَّمُ يَغرَمُ",59,"م",1,0],["لا كانَتِ الآمالُ يَكفُلُ نُجحَها","كَرَمٌ يُريكَ تَجَهُّماً وَقُطوبا",60,"ب",2,0],["لا كَعبَ أَسفَلُ مَوضِعاً مِن كَعبِهِ","مَعَ أَنَّهُ عَن كُلِّ كَعبٍ عالِ",61,"ل",1,0],["لا كَأُناسٍ قَد أَصبَحوا صَدَأَ ال","عَيشِ كَأَنَّ الدُنيا بِهِم حَبسُ",62,"س",1,0],["لا كَمُصفيهِمُ إِذا حَضَروا الوُد","دَ وَلاحٍ قُضبانَهُم بِالمَغيبِ",63,"ب",1,0],["لا كُتْبُهُ تَتْرَى وَلا رُسْلُهُ","تَأْتِي وَلا الْطَّيْفُ يُوافِي لِمَامْ",64,"م",1,0],["لا كَالَّذِي يَدَّعِي وُدّاً وَبَاطِنُهُ","بِجَمْرِ أَحْقَادِهِ تَغْلِي مَرَاجِلُهُ",65,"ل",2,0],["لا كانَ من قاضٍ حكى ال","فُقَّاع خدَّ باردِ",66,"د",1,0],["لا كنتَ حينَ شَمَمْتَها فسمَمْتَها","ولثمْتَ فاها آخذاً بقرونها",67,"ه",2,0],["لا كنت من حجر ٍ(تبغدد) حوله","عّبادُ أصنام ٍ به أحجار",68,"ر",1,0],["لا كَيفَ قَلبُكَ إِن ثَوَيتَ مُخامِراً","سَقَماً خِلافَهُمُ وَحُزنُكَ بادي",69,"ي",1,0],["لا كان مَن حَفِظَ الأمانَة واتّقَى","إن كان مَن يَأْبَى الخيانةَ يأثَمُ",70,"م",1,0],["لا كُنتِ من شجرٍ لنا أشواكُها","نشقَى بها ولغيرنا الثَّمَراتُ",71,"ت",1,0],["لا كُنتَ يا زمنَ الأوهامِ مِن زَمَنٍ","أرخَى على النّاسِ من ظَلْمَائِهِ سُجُفا",72,"ف",2,0],["لأَكْشِفَنَّ عن الأبصارِ إذ عَميتْ","ما أسْدَلَ الجهلُ من حُجْبٍ وأستارِ",73,"ر",1,0],["لا كإيمان من ترى","في فلسطين قصيرِ المدى كليلِ الزناد",74,"د",1,0],["لأَكسِبَ مالاً أَو أَؤولَ إِلى غِنىً","مِنَ اللَهِ يَكفيني عُدَاةَ الخَلائِفِ",75,"ف",1,0],["لا كَما كُنتَ تَرى","بَهِجاً مُغتَبِطا",76,"ط",2,0],["لا كَمَن يُكني عَنِ الأَم","رِ إِذا ما خافَ عارا",77,"ر",2,0],["لا كانَ أَحسَنَ مِمَّن قالَ مُلتَفِتاً","وَقَد تَغَضَّبَ ما مَشّاكَ في أَثَري",78,"ر",2,1],["لا كَرمُها مِمّا يُذالُ وَلا","فُتِلَت مَرائِرُها عَلى عَجمِ",79,"م",1,0],["لا كَما قَد أَرى فَقَطَّعَ قَلبي","أَن أَراكَ المُهانَ وَالمَشتوما",80,"م",2,0],["لا كُنتُ إِن لَم أَكُن أُحِبُّكُمُ","جُهدي فَما بَعدَ حُبِّ مُجتَهِدِ",81,"د",1,0],["لا كُنتُ إِن كُنتُ تَناسَيتُكُم","لِهائِجٍ بَعدَكُمو ناحا",82,"ح",2,0],["لا كَالفَتى المَهدِيُّ في رَهطِهِ","ذو شَيبَةٍ كَهلٍ وَلا ذو شَباب",83,"ب",1,0],["لا كانَتِ الدُنيا فَلَيسَ يَسُرُّني","أَنّي خَليفَتُها وَلا مَحمودُها",84,"د",3,1],["لا كيسَ بَينَهُم وَأَفضَلُ مَن تَرى","في دينِهِ مِثلُ العَقيرِ يَكوسُ",85,"س",1,0],["لا كَرىً نائِمٌ بِجَفني وَلا أَع","لَمتُ في الدَهرِ فِتنَةً بِكِرانِ",86,"ن",1,0],["لا كَبيرٌ دالِفٌ مِن هَرَمٍ","أَرهَبُ اللَيلَ وَلا كَلُّ الظُفُر",87,"ر",1,0],["لا كانَ وَجْدٌ بِه الآماقُ جامدةٌ","ولا غرامٌ به الأشواقُ لم تَهِجِ",88,"ج",1,0],["لا كالَّذين عَلى طعا","م واحِدٍ لَم يصبروا",89,"ر",3,0],["لا كمن يطري به","لِنَوال نفرا",90,"ر",2,0],["لا كُسوفٌ وَلا خسوفٌ إذا لَم","يقع النيران في الأفياء",91,"ا",2,0],["لا كما قد حييت غير حميدٍ","وإذا مت مت غير فقيد",92,"د",1,0],["لا كالرياحين ولا البقول","لكن تبنّى ثمر 