م إن سمحت بنور جفني",191,"ي",1,0],["لا كنت إن كنت أدري كيف كنت ولا","ما كنت إن كنت أدري كيف لم أكن",192,"ن",1,0],["لا كهذا النظم قد لفقته","من هزيل القول ما فيه سمن",193,"ن",1,0],["لا كنت ولا كنتُ من نسل الرسول إذا","أقمت بين ذوي الشحناء والحسد",194,"د",1,0],["لا كانَ هذا الدَّهر من مُتمرِّدٍ","ماذا يلاقي الحرُّ من أهواله",195,"ل",2,0],["لا كانَ يوم وداعهم من موقف","وقف المتيم فيه وقفة حائر",196,"ر",1,0],["لا كالذي انقلبَ الزمانُ به","فأَتى يُؤَذِّنُ بَعْدَ ما صَلَّى",197,"ل",2,0],["لا كما قُمْتَ فيه أَيَّدَكَ الَّل","هُ شهيرَ السِّلاحِ أَوَّلَ صَفِّ",198,"ف",1,0],["لا كَمَنْ ماتَتِ المَنَاسِبُ منهُ","فَهْوَ يُحْيِي أَرضَ المِحالِ المَوَاتا",199,"ت",2,0],["لأكلفنّ العيسَ طيّ مهامهٍ","تُردي كواهلَها به والهادي",200,"د",2,0],["لأكبرتُ أن أومي إليك بنظرةٍ","لعُظْمِكَ عندي أو أشيرَ بأصبَعي",201,"ي",1,0],["لا كيلُهُمْ وافٍ ولا عرْضُهُم","صافٍ ولا مَعروفُهُم ضافِ",202,"ف",1,0],["لا كان سهم نوى أصمى فؤادي من","عوجا وتين بمرنان ومذعان",203,"ن",1,0],["لا كانَ إلا ميِّتا ميثاقُهُ","مَن سرَّه أن كان بعدك باقيا",204,"ي",2,0],["لا كانَ للغدرِ المطا","عِ علَى وفِيِّ هوايَ سطوَهْ",205,"و",2,0],["لا كالغريبةِ أيديهم وألسنُهم","لم يركبوا الخيلَ إلا بعد ما هَرِموا",206,"م",3,0],["لا كالمخادع بِشرُهُ عن لؤمه","إن سرّ قول منه ساء فعالا",207,"ل",2,0],["لا كرجالٍ قُلِّدوا حكمَه","فخلطوا الممذوق بالرِّيقِ",208,"ق",1,0],["لا كان يومٌ مثلُ ذاك لآيب","بجوىً ولا غادٍ سَرَى لم يُمتَعِ",209,"ع",1,0],["لا كقولٍ يطرد الساقي به","جذوةً تخمدُ من قبلِ اللهيبِ",210,"ب",1,0],["لا كرىً أو أبعث الخيل ضُحىً","كالدَّبى زفزفهُ عصفُ الشمال",211,"ل",1,0],["لا كانت الدنيا فاية عيشةٍ","تصفو من التكدير والتنكيد",212,"د",1,0],["لأكسدَ قدر المسك بعد نفاقهِ","ثناءُ صفيِ الدين إذ يتأرَّج",213,"ج",1,0],["لا كان لأن رام السلوّ لا كان","سل أن سألتَ عالماً بالأحزان",214,"ن",1,0],["لا كملوك خلفت خالفاً","معقبة مات ولم يعقب",215,"ب",1,0],["لا كفل قابل رديفاً","منها ولا صهوة وطيه",216,"ط",3,0],["لا كُفْرَ في الدُّنْيا عَلَى كُلِّ الوَرى","إنْ كانَ هَذا القوْلُ دُونَ نِصابِهِ",217,"ب",2,0],["لا كالذي طَمَسَ الغُرورُ سَبيله","فأضَلَّ شعبَه ذلكَ المَغرورُ",218,"ر",1,0],["لا كقومٍ عن شرابٍ","صومُهمْ أو عن طعامِ",219,"م",1,0],["لأكرعتُ نفسي بعدها مَكرعَ الرّدى","تصابحه حزناً لها وتغابقُهْ",220,"ق",2,0],["لاك في فيه حديثي ورمى","يمنة بالحق منه وشمالا",221,"ل",2,0],["لا كان من ينظر في غيره","ولا تهنَّى من يلاقي سواه",222,"ا",2,0],["لا كُنْتُ ممن يُضِيْعُ دَمْعَتَهُ","بينَ الأَثَافي والنُّؤَى والوَتَدِ",223,"د",1,0],["لا كالنَّهار ولا كاللَّيل تبْصِرُها","كاللَّون ما بين لَون الصُّبْحِ والغَلَسِ",224,"س",1,0],["لا كَانتِ الشَّمسُ فكَمْ أَصْدَأَتْ","صفحةَ خدٍّ كالحُسام الصَّقيلْ",225,"ل",1,1],["لأَكثرِ هذا الناسِ منِّيَ ذمُّه","وللفاضِلِ المشكورِ في النَّاسِ شُكْرُه",226,"ر",2,0]]}