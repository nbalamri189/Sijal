{"poems":[[49,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[74,"عاش وصلا وغيره مات صدا","https://www.aldiwan.net/poem18558.html","الطويل"],[53,"وفارس أجبن من صفرد","https://www.aldiwan.net/poem62889.html","الطويل"],[53,"يا يوم إسحاق بن عبد الملك","https://www.aldiwan.net/poem65782.html","السريع"],[107,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[102,"الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50342",""],[132,"إن فقد الأهلين كان عظيما","https://www.aldiwan.net/poem50499.html","الخفيف"],[200,"ألا لست في شيء فروحاً معاوياً","https://www.aldiwan.net/poem527.html",""],[287,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[396,"يا عمران زرت سيدنا الرسول","https://www.aldiwan.net/poem54519.html","عموديه"],[406,"العصفورة الراحلة","https://www.aldiwan.net/poem6783.html","عموديه"],[556,"في كل يوم أرى عجيبا","https://www.aldiwan.net/poem48077.html","مخلع البسيط"],[563,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120050","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25323","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46542","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115912","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109011","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108897","الخفيف"],[1677,"","https://poetry.dctabudhabi.ae/diwan/poem/198592","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125403","المتقارب"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116648","المنسرح"],[2162,"","https://poetry.dctabudhabi.ae/diwan/poem/96054","الخفيف"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67885","الرجز"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102462","الرمل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123886","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123943","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131268",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103263","الطويل"],[4764,"يرحم ابويه الي فطمني على الزين","https://www.poetsgate.com/ViewPoem.aspx?id=35480",""],[4988,"حلم وأماني","https://www.poetsgate.com/ViewPoem.aspx?id=198223",""],[5122,"((بنات أبتكارأفكار فكري))","https://www.poetsgate.com/ViewPoem.aspx?id=24260",""],[2365,"ظربت وشاقتك البروق اللوامع","https://www.poetsgate.com/ViewPoem.aspx?id=200652",""],[5573,"لاهبت الريح بقلوب الهواويه","https://www.poetsgate.com/ViewPoem.aspx?id=200306",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5652,"ياعبيد حدوني كثير المقاريد","https://www.poetsgate.com/ViewPoem.aspx?id=208684",""],[5956,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183218",""],[5956,"النبأ المُفْجع","https://www.poetsgate.com/ViewPoem.aspx?id=192921",""],[5970,"يقولون في الصبر الجميل تعلة","https://www.poetsgate.com/ViewPoem.aspx?id=130657",""],[5981,"غاب فلم يرجع إلى أهله","https://www.poetsgate.com/ViewPoem.aspx?id=186656",""],[6115,"يارصيف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=180526",""],[6164,"صراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66057&r=&rc=66",""]],"verses":[["يُرَحِّلُ كُلَّ مَن يَأوي إِلَيهِ","وَيَختِمُها بِتَرحيلِ الدِيارِ",0,"ر",1,0],["يرحم الجمع دون مغناه جمعاً","مستميراً ويتبع الرفد رفدا",1,"د",2,0],["يرحمه الرحمن من جبنه","فيُطعم الله به نصرَهْ",2,"ر",2,0],["يرحمكَ الرحمنُ من هالك","لو تُقبَل الفدية غاليتُ بك",3,"ك",1,0],["يُرَحِّبُ ما يرحِّبُ ثمّ يُضفي","عليكِ حَنانَ ذِي النَّسَبِ القريبِ",4,"ب",1,0],["يرحب الشعب بابن الذادة العربِ","بابن الدواوين والأقلام والكتبِ",5,"ب",1,0],["يرحل النبع للرّفيف ويفنى","وهو يوصي : تسنبلي يا رفاتي",6,"ت",2,0],["يرحمُ اللّهَ من تعزى وعزَّى","مؤمناً كي يزبح عنهُ الهمُومَا",7,"م",2,0],["يَرُحنَ عَلَيهِ أَو يُغَيِّرنَ ما بِهِ","وَإِن لَم يَكُن في جَوفِهِ العَيشُ وانِيا",8,"ي",2,0],["يَرحَمُهُ اللَهُ فَكَم كَفّ مِن","عاتٍ عَلى الدينِ وَكَم فَكَّ عان",9,"ن",1,0],["يرحم المسكين يرثى للذي","ضاع عمره في ذنوب وفضول",10,"ل",1,0],["يرحل المرتاب في دنياه","من خطب لخطب",11,"ب",1,0],["يُرحِلنَني عَن قرا أَمونٍ","أَردت وَحدي لَها الرّكوبا",12,"ب",2,0],["يرحمهم دوماً وهم في عمى","عنه حمير بالغت في النهيق",13,"ق",1,0],["يرحب بالزوار ما نزلوا به","إذا أضقن أخلاقا ويفرح بالوفدِ",14,"د",1,0],["يَرْحَضُ آثارَ السِنِينِ الجُرْدِ","إِنْ بَلَّ أَرْضِي لَمْ يُصِبْنِي وَحْدِي",15,"د",2,0],["يَرحَم مَن يَقتَصد","بسيء لا يَقصد",16,"د",1,0],["يرحمُك اللهُ من أخى ثقةٍ","ما كَان فى صفوه كدَرُ",17,"ر",1,0],["يرحم اللَه إماماً","كان في العلم مفرد",18,"د",1,0],["يرحم اللَه ذلك الليث أحيا","ذكره ماجدٌ عن الليث يغني",19,"ن",2,0],["يرحمه الله على أنّني","قتلي له لم أدر ما أوجبه",20,"ب",2,0],["يرحِّب قلبي بفنِّ الأغاني","وكلِّ مُجدٍّ إليه انتسَب",21,"ب",1,0],["يَرحم اللَّه والدي ماتَ إِذ كُن","تُ صَغيراً فَبتّ أَنت كَفيلي",22,"ل",2,0],["يرحَمُكَ اللَهُ مِن أَخي ثِقَةٍ","مَا كان في صَفوِ وُدِّهِ كَدَرُ",23,"ر",1,0],["يرحم الله مصعباً فلقد ما","ت كريماً ورام أمراً جسيماً",24,"م",2,1],["يرحمُهُ مِمّا بهِ","من ضُرِّهِ ذو حَسدِه",25,"د",2,0],["يرحمُ ربّي ذا الوُثوق","من بفضلهِ اعتصَم",26,"م",1,0],["يرحمه اللّه لقد","كان طويل الذنب",27,"ب",1,0],["يرحب صردي بالهموم لأنني","أرى هممي تخبو فيوقدها همي",28,"م",2,0],["يرحب فيها بالغني إذا أتى","وحظ الفقير الشتم واللعنات",29,"ت",1,0],["يرحّلهم هواك بلا اختيارٍ","وتخلع في طواك لهم نعال",30,"ل",1,0],["يرحب بالعود السعيد وباللقا","تباركت الروحات والغدواتُ",31,"ت",1,0],["يرحم ابويه الي فطمني على الزين","ع الخير علمني وقضى حياته",32,"ت",2,0],["يرحم آيام المحبه بين ظحكات ومزوح","قانعين آبكلّ شيّ ونكتفي لو بالقليل",33,"ل",1,0],["يرحب أبحر غيبته وحشتن لدار","عسالله يونس وحشت ºالدار بايابه",34,"ب",2,0],["يرحى الفتى والموت دون رجائه","ويسرى له ساري الرّدى وهو هاجع",35,"ع",1,0],["يرحل مع الطيف لو في رحلته كيه","حتى مع الطيف دون الحيف يدراها",36,"ا",3,0],["يرحم الله حبيبا راحما","ما له عن عهد من يهواه لي",37,"ي",1,0],["يرحم صحيبٍ لابدا العلم صنديد","واليا ارتكى ينطح كثير البلاوي",38,"ا",3,0],["يرحِّب بي ولا يألو هُتافا","ولكنْ غَيْرُهُ يسقي الزُّعافا",39,"ف",2,1],["يرحمك الرحمن تعالى","ويُنيلُكَ جنّاتِ الخُلْدِ",40,"د",1,0],["يرحب بالخطب الجديد مودعا","لسابقه تعرو الخطوب كما تعرو",41,"ر",2,0],["يرحمه الله أخاً لم يكن","يذخرنا شيئاً من الود",42,"د",1,0],["يرحم الله من يشوتك بالنعال","لين يسمع فيك من شوته وحا",43,"ح",2,0],["يَرْحَمْهُ الله.. وكم أَنْقَدَتْ","رَحْمَتُه. كم أَخْصَبَتْ من يَبابْ!",44,"ب",1,0]]}