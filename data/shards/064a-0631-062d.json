{"poems":[[49,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[74,"عاش وصلا وغيره مات صدا","https://www.aldiwan.net/poem18558.html","الطويل"],[53,"وفارس أجبن من صفرد","https://www.aldiwan.net/poem62889.html","الطويل"],[53,"يا يوم إسحاق بن عبد الملك","https://www.aldiwan.net/poem65782.html","السريع"],[107,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[102,"الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50342",""],[132,"إن فقد الأهلين كان عظيما","https://www.aldiwan.net/poem50499.html","الخفيف"],[200,"ألا لست في شيء فروحاً معاوياً","https://www.aldiwan.net/poem527.html",""],[286,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[395,"يا عمران زرت سيدنا الرسول","https://www.aldiwan.net/poem54519.html","عموديه"],[404,"العصفورة الراحلة","https://www.aldiwan.net/poem6783.html","عموديه"],[554,"في كل يوم أرى عجيبا","https://www.aldiwan.net/poem48077.html","مخلع البسيط"],[561,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"]],"verses":[["يُرَحِّلُ كُلَّ مَن يَأوي إِلَيهِ","وَيَختِمُها بِتَرحيلِ الدِيارِ",0,"ر",1,0],["يرحم الجمع دون مغناه جمعاً","مستميراً ويتبع الرفد رفدا",1,"د",2,0],["يرحمه الرحمن من جبنه","فيُطعم الله به نصرَهْ",2,"ر",2,0],["يرحمكَ الرحمنُ من هالك","لو تُقبَل الفدية غاليتُ بك",3,"ك",1,0],["يُرَحِّبُ ما يرحِّبُ ثمّ يُضفي","عليكِ حَنانَ ذِي النَّسَبِ القريبِ",4,"ب",1,0],["يرحب الشعب بابن الذادة العربِ","بابن الدواوين والأقلام والكتبِ",5,"ب",1,0],["يرحل النبع للرّفيف ويفنى","وهو يوصي : تسنبلي يا رفاتي",6,"ت",2,0],["يرحمُ اللّهَ من تعزى وعزَّى","مؤمناً كي يزبح عنهُ الهمُومَا",7,"م",2,0],["يَرُحنَ عَلَيهِ أَو يُغَيِّرنَ ما بِهِ","وَإِن لَم يَكُن في جَوفِهِ العَيشُ وانِيا",8,"ي",2,0],["يَرحَمُهُ اللَهُ فَكَم كَفّ مِن","عاتٍ عَلى الدينِ وَكَم فَكَّ عان",9,"ن",1,0],["يرحم المسكين يرثى للذي","ضاع عمره في ذنوب وفضول",10,"ل",1,0],["يرحل المرتاب في دنياه","من خطب لخطب",11,"ب",1,0],["يُرحِلنَني عَن قرا أَمونٍ","أَردت وَحدي لَها الرّكوبا",12,"ب",2,0],["يرحمهم دوماً وهم في عمى","عنه حمير بالغت في النهيق",13,"ق",1,0]]}