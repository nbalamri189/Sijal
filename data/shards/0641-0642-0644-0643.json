{"poems":[[58,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[254,"وإني لراج منك يا أوس نعمة","https://www.aldiwan.net/poem2125.html","الطويل"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[463,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28034","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72714","الوافر"]],"verses":[["فقلَّ كَرَى عيني لِهَمٍّ مُسَهِّدٍ","وفِكْرٍ طويلِ الذَّيْلِ بالقلبِ لاعبِ",0,"ب",1,0],["فَقُل كَالَّذي قالَ اِبنَ يَعقوبَ يوسُفٌ","لِإِخوَتِهِ وَالحُكمُ في ذاكَ راسِبُ",1,"ب",1,0],["فَقُل كَما يُفعَل ما لا يأمُر","وَهو المَليكُ وَالالهُ الأَقدَرُ",2,"ر",1,0],["فقل كيف تنبو روضةٌ غاضَ برهةً","جدَا الماءِ عنها ثم فاضَ غديرُها",3,"ر",3,0],["فقل كما قال الذي","بقوله من قد أمن",4,"ن",1,0],["فقل كذبت كله اضطرار","وليس بعد الاضطرار عار",5,"ر",1,0],["فقل كلاهما حليف وجد","وهكذا مهما استقر الوصف",5,"ف",1,0],["فقل كي لا يضلَّ المستفيد","لآل المصطفة علم وجود",6,"د",1,0]]}