ps://www.aldiwan.net/poem55845.html","أحذ الكامل"],[461,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[461,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[461,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[461,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[461,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[461,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[461,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[461,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[461,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[461,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[464,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[467,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[467,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[482,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[482,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[482,"يا صاحب التقويم بل","https://www.aldiwan.net/poem36985.html","مجزوء الكامل"],[482,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[482,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[482,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[482,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[482,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[482,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[482,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[482,"بلبل في الروض غنى","https://www.aldiwan.net/poem37611.html","مجزوء الرمل"],[482,"فلتحى تونس وليعش","https://www.aldiwan.net/poem37624.html","مجزوء الكامل"],[509,"أصبحت مثل الجنان في الصدر","https://www.aldiwan.net/poem2463.html","المنسرح"],[517,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[517,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[518,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[532,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[541,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[541,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[541,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[541,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[541,"الشبل قد تبع الأسود وقد غدا","https://www.aldiwan.net/poem48220.html","عموديه"],[554,"جسيمة حملها جسيم","https://www.aldiwan.net/poem47244.html","الرجز"],[554,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[561,"نحن قوم متنا به وفنينا","https://www.aldiwan.net/poem33804.html","الخفيف"],[561,"في كل جنس من الأجناس معلوم","https://www.aldiwan.net/poem34094.html","البسيط"],[561,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[578,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[579,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216878","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/22574","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/31383","الكامل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2521","الكامل"],[1098,"","https://poetry.dctabudhabi.ae/diwan/poem/18405","الرجز"]],"verses":[["فَلتُرجِعوا آمَماً تَلَوُّمَها","وَلتُقلِعوا نَدَماً تَوَقَّفَها",0,"ف",3,0],["فَلتَدخُلَنَّ عَلَيهِ قُبَّتَهُ","وَلّاجَةً تَخفى عَلى الرَصَدِ",1,"د",1,0],["فَلتَعلَمِ الأَيّامُ أَنَّكَ لَم تَزَل","تَفري الخُطوبَ وَتَكشِفُ الغَمّاءِ",2,"ا",2,0],["فَلتَعلَمَنَّ إِذا اِلتَقَت فُرسانُن","بِلِوى النُجَيرَةِ أَنَّ ظَنَّكَ أَحمَقُ",3,"ق",1,0],["فَلْتُقَبِّلْ عنّي بغَيْرِ تَوانٍ","كَفَّ موْلَى الوَرى أبي الحَجّاجِ",4,"ج",1,0],["فَلتَقصِدوا ما اِسطَعتُمُ فيهُمُ","فَإِنَّما في القِلَّةِ المَنجَحُ",5,"ح",1,0],["فَلتَضرِبَن مَعَهُم بِأَوفَرِ شِركَةٍ","في أَجرِهِم مِن موتِرٍ أَو شافِعِ",6,"ع",1,0],["فَلتَغدُ أَلسِنَةُ الأَنامِ وَدَأبُها","شُكرٌ يُجاذِبُهُ الخَطيبَ الشاعِرُ",7,"ر",1,0],["فلتحيى سرويا ولا برحت كما","تهوى علاها طارفاً وتليدا",8,"د",2,0],["فَلْتَكُ الجَنَّاتُ مَرْتَعَهُ","خَالِداً فِيهَا عَلَى الرُّحْبِ",9,"ب",1,0],["فَلْتَشْهَدِ الأَيَّامُ بَعْثَةَ شَمْسِهَا","وَليَغْمُرِ الأفَاقُ ظِلُّ هِلالِهَا",10,"ل",3,0],["فَلْتَحْيَا مِصْرُ وَتَحْيَا أُمَّتُهَا","وَلتَرْقَ أَوْجَ السَّعْدِ يَا وَطَنُ",11,"ن",1,0],["فَلْتَحْيَا مِصْرُ وَشَطْرُهَا سُودَانُهَا","وَلتَحْيَا وِحْدَةُ مِصْرَ وَالسُّودَانِ",12,"ن",1,0],["فَلْتَلْتَقِي مَأْثُرَاتُ قَوْمِي","يُصَدِّقُ الدَّفِينَا",13,"ن",2,0],["فَلْتَفُزْ بِالرِّضَى من الله وَلْتَغْنَمْ بِهِا","الخُلْدَ فِي قَرَارٍ مَكِينِ",14,"ن",1,0],["فَلْتَحْيَا مِصْرٌ حُرَّةً تَسْمُو إلى","غَايَاتِهَا فِي غِبْطَةٍ وَأَمانِ",15,"ن",1,0],["فَلْتَحْيَا مِصْرُ وَأَبْرارٌ نُجِلُّهُمُو","وَنَحْتَفِي بِهِمْ حُبّاً وَتَكْرِيمَا",16,"م",2,0],["فلْتَبْعثوا لي كلَّ بكرٍ فذّةِ","تأتي بفخر حلالها وسْطَ النَّدي",17,"ي",1,0],["فلْتَسْمحوا لي بالقصائد عاجلاً","ولتَبلغوا مما أؤمَل مقصدي",18,"د",2,0],["فلتتّخذه خير عيد لنا","نذكر فيه فوزنا والظفر",19,"ر",1,0],["فلتَكُ زَيناً للأسرّة قاعداً","فانك زَينٌ للفوارس والرجل",20,"ل",1,0],["فَلتُصبِحَنَّ وَأَنتِ ما","لِيَقينِ عِلمِكِ حامِدَه",21,"د",2,0],["فلتهنه خلعٌ دامت مبشرة","بيمنه منصباً أضحى مباشره",22,"ر",2,0],["فلتظهر الفطن الثواقب عجزها","فظهوره سر من الأسرار",23,"ر",1,0],["فلتدُمْ نعمةُ الإله عليكم","ما أقامت ودامتِ الملكوتُ",24,"ت",1,0],["فلتخبرنَّك عن جِلاَدِ مُغَامِسٍ","ولتخبرنَّك عن طِرَادِ مُشِيحِ",25,"ح",1,0],["فَلَتِلْكَ أحسنُ 