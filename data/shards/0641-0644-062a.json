.aldiwan.net/poem55948.html","مخلع البسيط"],[459,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[459,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[459,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[459,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[459,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[459,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[459,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[459,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[462,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[465,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[465,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[480,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[480,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[480,"يا صاحب التقويم بل","https://www.aldiwan.net/poem36985.html","مجزوء الكامل"],[480,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[480,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[480,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[480,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[480,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[480,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[480,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[480,"بلبل في الروض غنى","https://www.aldiwan.net/poem37611.html","مجزوء الرمل"],[480,"فلتحى تونس وليعش","https://www.aldiwan.net/poem37624.html","مجزوء الكامل"],[507,"أصبحت مثل الجنان في الصدر","https://www.aldiwan.net/poem2463.html","المنسرح"],[515,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[515,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[516,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[530,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[539,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[539,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[539,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[539,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[539,"الشبل قد تبع الأسود وقد غدا","https://www.aldiwan.net/poem48220.html","عموديه"],[552,"جسيمة حملها جسيم","https://www.aldiwan.net/poem47244.html","الرجز"],[552,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[559,"نحن قوم متنا به وفنينا","https://www.aldiwan.net/poem33804.html","الخفيف"],[559,"في كل جنس من الأجناس معلوم","https://www.aldiwan.net/poem34094.html","البسيط"],[559,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[576,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[577,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"]],"verses":[["فَلتُرجِعوا آمَماً تَلَوُّمَها","وَلتُقلِعوا نَدَماً تَوَقَّفَها",0,"ف",3,0],["فَلتَدخُلَنَّ عَلَيهِ قُبَّتَهُ","وَلّاجَةً تَخفى عَلى الرَصَدِ",1,"د",1,0],["فَلتَعلَمِ الأَيّامُ أَنَّكَ لَم تَزَل","تَفري الخُطوبَ وَتَكشِفُ الغَمّاءِ",2,"ا",2,0],["فَلتَعلَمَنَّ إِذا اِلتَقَت فُرسانُن","بِلِوى النُجَيرَةِ أَنَّ ظَنَّكَ أَحمَقُ",3,"ق",1,0],["فَلْتُقَبِّلْ عنّي بغَيْرِ تَوانٍ","كَفَّ موْلَى الوَرى أبي الحَجّاجِ",4,"ج",1,0],["فَلتَقصِدوا ما اِسطَعتُمُ فيهُمُ","فَإِنَّما في القِلَّةِ المَنجَحُ",5,"ح",1,0],["فَلتَضرِبَن مَعَهُم بِأَوفَرِ شِركَةٍ","في أَجرِهِم مِن موتِرٍ أَو شافِعِ",6,"ع",1,0],["فَلتَغدُ أَلسِنَةُ الأَنامِ وَدَأبُها","شُكرٌ يُجاذِبُهُ الخَطيبَ الشاعِرُ",7,"ر",1,0],["فلتحيى سرويا ولا برحت كما","تهوى علاها طارفاً وتليدا",8,"د",2,0],["فَلْتَكُ الجَنَّاتُ مَرْتَعَهُ","خَالِداً فِيهَا عَلَى الرُّحْبِ",9,"ب",1,0],["فَلْتَشْهَدِ الأَيَّامُ بَعْثَةَ شَمْسِهَا","وَليَغْمُرِ الأفَاقُ ظِلُّ هِلالِهَا",10,"ل",3,0],["فَلْتَحْيَا مِصْرُ وَتَحْيَا أُمَّتُهَا","وَلتَرْقَ أَوْجَ السَّعْدِ يَا وَطَنُ",11,"ن",1,0],["فَلْتَحْيَا مِصْرُ وَشَطْرُهَا سُودَانُهَا","وَلتَحْيَا وِحْدَةُ مِصْرَ وَالسُّودَانِ",12,"ن",1,0],["فَلْتَلْتَقِي مَأْثُرَاتُ قَوْمِي","يُصَدِّقُ الدَّفِينَا",13,"ن",2,0],["فَلْتَفُزْ بِالرِّضَى من الله وَلْتَغْنَمْ بِهِا","الخُلْدَ فِي قَرَارٍ مَكِينِ",14,"ن",1,0],["فَلْتَحْيَا مِصْرٌ حُرَّةً تَسْمُو إلى","غَايَاتِهَا فِي غِبْطَةٍ وَأَمانِ",15,"ن",1,0],["فَلْتَحْيَا مِصْرُ وَأَبْرارٌ نُجِلُّهُمُو","وَنَحْتَفِي بِهِمْ حُبّاً وَتَكْرِيمَا",16,"م",2,0],["فلْتَبْعثوا لي كلَّ بكرٍ فذّةِ","تأتي بفخر حلالها وسْطَ النَّدي",17,"ي",1,0],["فلْتَسْمحوا لي بالقصائد عاجلاً","ولتَبلغوا مما أؤمَل مقصدي",18,"د",2,0],["فلتتّخذه خير عيد لنا","نذكر فيه فوزنا والظفر",19,"ر",1,0],["فلتَكُ زَيناً للأسرّة قاعداً","فانك زَينٌ للفوارس والرجل",20,"ل",1,0],["فَلتُصبِحَنَّ وَأَنتِ ما","لِيَقينِ عِلمِكِ حامِدَه",21,"د",2,0],["فلتهنه خلعٌ دامت مبشرة","بيمنه منصباً أضحى مباشره",22,"ر",2,0],["فلتظهر الفطن الثواقب عجزها","فظهوره سر من الأسرار",23,"ر",1,0],["فلتدُمْ نعمةُ الإله عليكم","ما أقامت ودامتِ الملكوتُ",24,"ت",1,0],["فلتخبرنَّك عن جِلاَدِ مُغَامِسٍ","ولتخبرنَّك عن طِرَادِ مُشِيحِ",25,"ح",1,0],["فَلَتِلْكَ أحسنُ من نوالك موقعاً","والعِلم أفضلُ ما أراه يُفادُ",26,"د",1,0],["فلْتُنْصَرَنَّ على الطُّغاةِ به","ولْتُكْفَيَنَّ السيفَ بالقلمِ",27,"م",1,0],["فَلتَدُم آمِرِكا ما اِلتَطَما","ما لِهَذا الفَتحِ في التاريخِ ثان",28,"ن",1,0],["فَلتَحيَ سورِيّا الَّتي نَحيا لَها","وَليَحيى لُبنانُ الأَشَمِّ الراسِ",29,"س",1,0],["فَلتَنبَسِط أَيديكُمو كَرَماً","السُحبُ أَنفَعُها الَّذي هَتَنا",30,"ن",2,0],["فلتجتن الثأرات","ولترقب الساعات",31,"ت",1,0],["فَلتَحيَ مِلَّتُنا فَلتَحيَ أُمَّتُنا","فَليَحيى سُلطانُنا فَليَحيى عَبّاسُ",32,"س",1,0],["فَلتَسمَعُنَّ بِكُلِّ أَرضٍ داعِياً","يَدعو إِلى الكَذّابِ أَو لِسَجاحِ",33,"ح",1,0],["فلتهنأِ الأيامُ أنّك مالكُ ال","دنيا وطوعُ مرادِكَ الأقدارُ",34,"ر",1,0],["فَلْتُظهرِ الأيامُ أقصى كيدِهَا","وليبْلُغِ المقدارُ غايةَ جُهْدِهِ",35,"د",2,0],["فَلتَشكُرَنَّكَ مَذحِجُ ابنَةُ مَذحِجٍ","مِن آلِ غَوثِ الأَكثَرينَ وَجُندَبِ",36,"ب",1,0],["فَلتَعزِفَنَّ عَنِ البَطالَةِ هِمَّتي","وَليَقصُرَنَّ عَلى الدِيارِ وُقوفي",37,"ف",2,0],["فَلتُخبِرَنَّكَ أَنَّ عِزَّةَ دارِمٍ","سَبَقَتكَ يا اِبنَ مُسَوِّقِ الأَعيارِ",38,"ر",1,0],["فلتلبسن بها الثناء مسيرا","ومخلدا ما دام يذبل خالدا",39,"د",2,0],["فلتشكرنَّكَ دولةٌ جَدَّدْتَها","فتجدَّدَتْ أعلامُها ومنارُها",40,"ر",3,0],["فَلْتَلْفَحَنَّكُما سمائمُ مَنطِقي","ولتُغْرِقَنَّكُما سُيولُ شِعابي",41,"ب",2,0],["فلْتَعْلَما إن لم تَهُبَّ عليكما","أبداً نسيمَ جِنايتي وجَنابي",41,"ب",2,0],["فَلتَلحَقَنَّ بِعَرصَةِ المَوتى","وَلَتَنزِلَنَّ مَحَلَّةَ الهَلكى",42,"ا",1,0],["فَلتَنزِلَنَّ بِمَنزِلٍ","تَحتاجُ فيهِ إِلى ادِّخارِك",43,"ك",1,0],["فَلتُخبِرَنَّكَ أَنَّهُم خُلِقوا لِما","خُلِقوا لَهُ فَمَضَوا لَهُ أَرسالا",44,"ل",2,0],["فَلَتَنزِلِنَّ بِمَنزِلٍ","يَنسى الخَليلَ بِهِ الخَليلُ",45,"ل",1,0],["فَلَتَغشَيَنّي غَشيَةٌ","يَندى لِسَكرَتِها جَبيني",46,"ن",2,0],["فَلتَةً كانَ مِنكَ عَن غَيرِ قَصدِ","يا أَبا بَكرَ عَقدُ بَيعَةِ وُدّي",47,"د",2,1],["فَلتَعلَمَن حِرُ أُمِّ مَن وَإِهابُ مَن","وَقَديمُ مَن وَحَديثُ مَن يَتَمَزَّقُ",48,"ق",1,0],["فَلتَلقَيَنَّكَ حَيثُ كُنتَ قَصائِدٌ","فيها لِأَهلِ المَكرُماتِ مَآرِبُ",49,"ب",1,0],["فَلتوشِكَنَّ وَأَنتَ تَزعُمُ أُمُّهُم","أَن يَركَبوكَ بِثِقلِهِم أَو يَرضَعوا",50,"ع",3,0],["فلْتَعْلَمِ الأعلاجُ عِلماً ثاقِباً","أنّ الصّليبَ وقد عززتَ ذليل",51,"ل",1,0],["فلتأخذَنّ من الزمان حَمامَةً","ولتدفعنّ إلى الزّمانِ غُرابا",52,"ب",2,0],["فلتأتينّكَ من بيوتي شرّدٌ","تبلى الجبالُ وأنّها لكماهيه",53,"ي",2,0],["فَلَتَنزِلَنَّ بِهِ الَّتي نَزَلَت","يَوماً بِصاحِبِ عُروَةَ العُذري",54,"ر",2,0],["فَلَتَأتِيَنكَ قَصائِدٌ وَلَيَدفَعَن","جَيشٌ إِلَيكَ قَوادِمَ الأَكوارِ",55,"ر",1,0],["فَلتَفعَلِ النَفسُ الجَميلَ 