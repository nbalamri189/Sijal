{"poems":[[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[50,"أفناني الدهر نهسا","https://www.aldiwan.net/poem64323.html","الخفيف"],[78,"سواد المرء تنفده الليالي","https://www.aldiwan.net/poem39444.html","الوافر"],[113,"أربوتنا حيتك عنا السحائب","https://www.aldiwan.net/poem16469.html","الطويل"],[164,"في الله سبحانه عمن مضى خلف","https://www.aldiwan.net/poem58711.html","البسيط"],[214,"هويته شاعرا بالنظم جئت له","https://www.aldiwan.net/poem13428.html","البسيط"],[275,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[280,"حملت نفسي ما تنوء به كما","https://www.aldiwan.net/poem25472.html","الكامل"],[287,"أطربني صوت حمام شدا","https://www.aldiwan.net/poem32796.html","السريع"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53810","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104600","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64175","الخفيف"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119272","الطويل"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18478","الرجز"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126658","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110271","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93863","البسيط"],[3407,"","https://poetry.dctabudhabi.ae/diwan/poem/105102","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199100","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127357","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127079","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141606","الهزج"],[4767,"عمري","https://www.poetsgate.com/ViewPoem.aspx?id=87029",""],[5566,"ميسم","https://www.poetsgate.com/ViewPoem.aspx?id=192930",""],[5638,"رثاء البطل عمر أبو ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=203607",""],[5725,"ودق السما","https://www.poetsgate.com/ViewPoem.aspx?id=215842",""],[5906,"فليتك يا أميمة","https://www.poetsgate.com/ViewPoem.aspx?id=188229",""],[5956,"عيب الشفاه ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182646",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""]],"verses":[["فاسودَّ مبيَضٌّ كسا نورُهُ","قَلْبي ظلاماً حالك الطرمس",0,"س",1,0],["فَاِسوَدَّ وَجهِيَ مِنهُ","حَتّى تَحَوَّلَ نِقسا",1,"س",2,0],["فأسودُهُ يصيرُ إلى بَياضٍ","وأبيضُهُ يعودُ إلى سَوادِ",2,"د",1,0],["فَاسودك الغَريد بِالدَف مولَع","تَبَدَت لَنا بِالجَنك مِنهُ عَجائب",3,"ب",1,0],["فاسودّ زاهرُه وابيضّ ناظره","وودّ لو أنه أودى به التلفُ",4,"ف",1,0],["فاسود ناظره وابيض سالفه","واخضر عارضه واحمر خداه",5,"ه",1,0],["فاسٌ وتونُسُ والجزائر جمّةٌ","فيها الفرائسُ مُذ عدا ضاريك",6,"ك",1,0],["فاسْودَّ مِن طولِ التذكُّرِ مُضْمَرِي","وابيَض مِنْ هَوْلِ التَّفرُّقِ مَفْرقي",7,"ي",1,0],["فَاِسوَدَّ ما أُلبِستُهُ أَبيَضاً","وَاِبيَضَّ ما أُلبِستُهُ أَسوَدا",8,"د",2,0],["فأسوف الغبار ساعة القا","ك برشف الخدين والتقبيلِ",9,"ل",1,0],["فاسودادٌ فوقَ ابيضاضِ احمرارٍ","كالنّسيجِ المُشّهرِ الخَسروي",10,"ي",1,0],["فاسودادُ العذارِ بعد ابيضاضٍ","كابيضاضِ العذارِ بعد اسوداد",11,"د",1,0],["فآسوا أخابوس رشيق كنانة","رماه بها كف الحوادث عابثا",12,"ث",2,0],["فَاِسوَدَّ مِن جُفرَتِهِ إِبطاها","كَما طَلى النُقبَةَ طالِياها",13,"ا",3,0],["فآسوه بأنفسهم وأصفوا","له ما ملَّكوه طايعينا",14,"ن",2,0],["فاسودّ مبيض النها","ر وغاب بدر الداجيه",15,"ي",2,0],["فاسودادي ووحدتي في مقامي","قد أشارا إلى حداد الصنوبر",16,"ر",1,0],["فاسود مبيض أيامي لصفر يدي","وفي وفا البحر ما يغني عن الخلج",17,"ج",1,0],["فاسود وجه الأفق حتى أنني","خلت الكواكب قد عفت آثارها",18,"ر",3,0],["فاسودَّ وجه الضحى مما ألمَّ به","وابيضَّ فرعُ الدجى من هول داهيها",19,"ي",3,0],["فاسود منه محياه وقد علقت","بطيب أثوابه آثاره السحم",20,"م",1,0],["فَإِسوَةٌ لَكِ آِريسٌ وَهَيبَتُهُ","عَاماً وَشهراً ثَوى في السِّجنِ لم يُهَبِ",21,"ب",1,0],["فأسود أهلها أهلي وساكنها","بنو الوشاحات في أخلاق كل كمي",22,"م",2,0],["فاسود لما صبت السودا به","فكأنه بدر علاه كسوف",23,"ف",1,0],["فاسودت الآفاق والدنيا غدت","مقلية المنظور والمسموع",24,"ع",1,0],["فأسوائي لا ينفك","من لهج بأسواء",25,"ا",2,0],["فاسود جوفي والحشا","بالنار تلك تفحما",26,"م",2,0],["فاسود محراب اليقين وأوصدت","أبوابه بسلاسل من يأسك",27,"ك",1,0],["فَأُسُودُهَا سَتَظَلُّ تَزْ","أَرُ وَالدَّلِيلُ فَذَا عُمَرْ",28,"ر",1,0],["فأسودتا كالليل يرسل خلسةً","ساعٍ تحاشى الطرق بالأبوابِ",29,"ب",1,0],["فأسواطُ الزَّمانِ تُذيبُ جِلْدي","وكَونٌ للإلهِ يَضيقُ فِيْني",30,"ن",2,0],["‏ ‏فأسوح فيك كما أشاء أُعِزُّ شأن","‏ ‏ ك فوق كل الكائنات الناعمة",31,"م",2,0],["فأسودها فوق التراب أداؤها","أنثى تقاوم والرجال فداء",32,"ا",2,0]]}