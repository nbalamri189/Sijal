,"هو الشعر !..","https://www.poetsgate.com/ViewPoem.aspx?id=110863",""],[5324,"يامظهر الوجه الضحك.","https://www.poetsgate.com/ViewPoem.aspx?id=211079",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5444,"سجن وكراسي","https://www.poetsgate.com/ViewPoem.aspx?id=205076",""],[5725,"تداعى علينا القوم","https://www.poetsgate.com/ViewPoem.aspx?id=177466",""],[6019,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=53054",""],[6031,"تَوَشَّحَتِ السَّمَاءُ بِبُرْدِ غَيْمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46337",""],[161,"زَهْرَةُ الحيَاةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202595",""],[6056,"بالخير متبرّع","https://www.poetsgate.com/ViewPoem.aspx?id=156715",""],[6102,"قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=184624",""],[6102,"لا كرامة لنبي في قومه ..","https://www.poetsgate.com/ViewPoem.aspx?id=186289",""],[6262,"أحلامُ نورِ الدين الصغيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80126&r=&rc=24",""],[6299,"بِكَفَّيِّ مِنْها لِلْبَغيضِ عُرَاضة ٌ وَمَرْقَبَة ٍ عَنْقَاءَ يَقْصُرُ دُونَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19688&r=&rc=13",""]],"verses":[["بِكَفِّيَ أَنّى شِئتُ ناصِيَةَ العُلى","أَهُزُّ وَأَعناقُ المَكارِمِ في أَسري",0,"ر",2,0],["بِكَفَّيكَ عَقدُ المَكرُماتِ وَحَلُّها","وَعِندَكَ إِشراقُ العُلى وَغِيابُها",1,"ب",3,0],["بكَفِّ أرْوَعَ لم يَطْمَحْ لغايَتِهِ","ثَواقِبُ الشُّهْبِ في أعلى مساريها",2,"ي",3,0],["بِكَفٍّ تُعيرُ السُّحْبَ من نَفَحاتِها","فتُرخي عَزالِيها الغُيوثُ الهَواطِلُ",3,"ل",1,0],["بِكَفِّ أرْوَعَ يُرخي مِن ذَوائِبِهِ","جِنُّ المِراحِ فَيَمْشي مِشْيَةَ الثَّمِلِ",4,"ل",1,0],["بِكَفَيَّ مِنَ النُّوَّارِ ذَاتُ أَشِعَّةٍ","لَهَا قُرْصُ شَمْسٍ زَانَهُ تَاجُ أَلوَانِ",5,"ن",1,0],["بكفِّك غيث للبلاد وأهلها","يُروَّض مَحلَ الأرض والعام ماحلُ",6,"ل",1,0],["بِكُفرِهِمُ بِاللَهِ وَالدينُ قائِمٌ","وَما طَلَبوا فينا بِطائِلَةِ الوِترِ",7,"ر",1,0],["بِكَفِّ رَسولِ اللَهِ حَتّى تَلَفَّفَت","عَلى القَومِ مِمّا قَد يُثِرنَ نُقوعُ",8,"ع",1,0],["بكف مزركش الأصداغ تهوى","لقبلتها وجوه للملاح",9,"ح",1,0],["بكَ فازتْ يدي وأنجبَ ظنِّي","وزكا مقصدي وسار قصيدي",10,"د",2,0],["بكف كريم الإرث والكسب في العلى","فمن خبرٍ نامي الفخار ومن خبر",11,"ر",1,0],["بكف فتىً لو كان للبحر جودُهُ","لفاضَ كما فاضَ في الطرسِ درّه",12,"ر",2,0],["بكفَّيه يستسقى الحيا ودعائه","فتهمي بماءٍ حالتاه ومال",13,"ل",1,0],["بكفِّ كريمٍ يملأ العلم والقرى","لديه قلوب الطالبين بشحمها",14,"م",3,0],["بكفّ كريم الرَّاحتين مؤمَّل","فيا لك برقاً في الندَى وغماما",15,"م",2,0],["بكفٍّ زاكي السجايا إن برى قلماً","يكاد ينطقُ تمجيداً لباريه",16,"ي",2,0],["بكف روت أقلامه عن تميرها","وزند روت آراؤه عن وريه",17,"ي",2,0],["بِكَفِّ سوءٍ بُتِكَتْ","ذِراعُها من عَضُدِهْ",18,"د",2,0],["بكفَّي عبيد الله يهوي بحدّه","إلى حيث أهوى الحقُّ لا يتلعثمُ",19,"م",1,0],["بكفِّ فتىً له نَفْعٌ وضرٌّ","وإنعامٌ يُؤمَّلُ وانتقامُ",20,"م",1,0],["بِكَفَّي رَقاحِيٍّ يُحِبُّ نَماءَها","فَيُبرِزُها لِلبَيعِ فَهِيَ فَريجُ",21,"ج",1,0],["بِكَفَّيهِ الأَعِنَّةُ لا سَؤومٌ","قِتالَ الأَعجَمينَ وَلا ضَجورُ",22,"ر",1,0],["بِكَفّي مِنَ المَأثورِ كَالمِلحِ لَونُهُ","حَديثٌ بِإِخلاصِ الذُكورَةِ قاطِعُ",23,"ع",1,0],["بِكَفَّيَ مِنها لِلبَغيضِ عُراضَةٌ","إِذا بِعتُ خُلاًّ مَالَهُ مُتَعَرَّفُ",24,"ف",1,0],["بك في امة قد ازدادت الاخلاق","طيبا وازدانت الآداب",25,"ب",1,0],["بِكَفِّ جَوادٍ لَو حَكَتها سَحابَةٌ","لَما فاتَها في الشَرقِ وَالغَربِ مَوضِعُ",26,"ع",1,0],["بِكَفِّهِ خَيزُرانٌ ريحُهُ عَبِقٌ","مِن كَفِّ أَروَعَ في عِرنينِهِ شَمَمُ",27,"م",1,0],["بِكَفَّينِ بَيضاوَينِ في راحَتَيهِما","حَيا كُلُّ شَيءٍ بِالغُيوثِ السَواجِمِ",28,"م",1,0],["بكَفٍّ تُرَقرِقُ ماءَ الحياةِ","ووجهٍ يُرَقرقُ ماءَ الحَياء",29,"ا",2,0],["بِكَفِّكَ سَلَّ الدِّينُ للضربِ سَيفَهُ","وأَضحى عَلى أَعدائِهِ بِكَ يَستَعدي",30,"د",2,0],["بِكَفِّ ساقٍ حُلوٍ شَمائِلُهُ","مُكَرِّهٌ لَحظَ عَينِهِ صَلَفا",31,"ف",2,0],["بِكَفِّ غَزالٍ ذي عِذارٍ وَطِرَّةٍ","وَصُدغَينِ كَالقافَينِ في طَرَفي سَطرِ",32,"ر",1,0],["بكفِّ مُقَرْطَقٍ يُزْهى برِدْفٍ","يضيقُ بحَملِهِ وُسعُ الإزار",33,"ر",1,0],["بِكَفِّ ضَنّانٍ بِهِ شَحيحِ","مِمّا اِشتَرى بِالثَمَنِ الرَبيحِ",34,"ح",1,0],["بِكَفَّي فاتِرِ اللَحظِ","رَخيمِ الدَلِّ مَيّاسِ",35,"س",1,0],["بِكَفِّ مُزَنَّرٍ أَعلاهُ غُصنٌ","وَأَسفَلُ خَصرِهِ رِدفٌ ثَقيلُ",36,"ل",1,0],["بِكَفِّ أَغَنَّ مُختَضِبٍ بَناناً","مُذالِ الصَدغِ مَضفورِ القُرونِ",37,"ن",1,0],["بِكَفٍّ تَكادُ الكَأسُ تُدمي بَنانَها","إِذا أُزعِجَ التَحريكُ مِنها سُكونَها",38,"ن",3,0],["بكفَّهِ ساحرُ البيانِ إذا","أدارَهُ في صحيفةٍ سَحَرا",39,"ر",2,1],["بكفيّ ألقيت العصا واشتريتكم","بحيّ حلال يحبسون المحابسا",40,"س",2,1],["بكفك مصباحٌ من العلم ساطعٌ","به لعقول الناشئين تنير",41,"ر",1,0],["بكفيَّ هاتينِ جمَّعتهنَّ","من كلِّ روضٍ ومن كلِّ وادْ",42,"د",1,0],["بَكْفِيهِ أَنَّ المُوسعِيهِ حَفَاوَةً","لَهُمُ بِمِصْرَ المَوْضِعُ المَرْمُوقُ",43,"ق",1,0],["بِكَفٍّ من الإِحْسانِ وَالرِّفقِ صُوِّرَتْ","وعَيْنٍ تَرَى في يَوْمها ما تَرَى غَدَا",44,"د",2,0],["بك في \" العلي \" عن \" الحسينِ \" تصبرٌ","بممجدٍّ ثبتِ الجِنان رؤوفه",45,"ف",2,0],["بِكَ فَخر القَريض شَرقاً وَغَرباً","وَيَرى عِندَ جاهِكَ المِقدارا",46,"ر",2,0],["بِكَفِّ الَّذي قامَ من حَينه","إِلى الصابِرِ الصادِقِ المُتَّقي",47,"ق",2,0],["بِكَفِّ اِمرِئٍ مِثلَ الشِهابِ سمَيدَعٍ","أَخي ثِقَةٍ حامي الحَقيقَةِ باسِلِ",48,"ل",1,0],["بكفك باس يحرق النار وقده","وبحر ندى في موجه يغرق البحر",49,"ر",1,0],["بِكَفِّ نَديمٍ أَو تَراءَى بِحُسنِهِ","لِيَعقُوبَ لَم يَأسَف لِفُقدانِ يُوسُفا",50,"ف",2,0],["بكفِّ بدرٍ نصفه أبيض","ونصفه أحمر كالخَمرِ",51,"ر",1,0],["بكف مدلَّهٍ بجمال حُسنٍ","يفوق مثاله درّاً بقارِ",52,"ر",1,0],["بكفيكَ نيران تفورُ على العدا","وجنّاتُ للراجينَ روضاتُها خضرُ",53,"ر",1,0],["بِكَفِّ مُهَفهَفٍ نَشوانَ أَلمى","خَطائِيِّ النِّجارِ إِذا تَكَلَّم",54,"م",1,0],["بك في ملَّة الغَرام اِقتديتُ","أَتُراني إلى سواكَ اِنتميتُ",55,"ت",1,1],["بِكفِّ أبي العبّاسِ يستمطرُ الغِنى","وَيُشفى من الأدوا ويستنجدُ النصرُ",56,"ر",1,0],["بكَفّ أغرٍّ ما يَنْفَكُّ دُرٌّ","يَجودُ به انْتثاراً وانْتظاما",57,"م",2,0],["بكفّ مُتَوِّجٍ للكُتْبِ عِزّاً","فتَأْتي وهْي تَخْتالُ اخْتِيالا",58,"ل",2,0],["بكفِّه إن مضَتْ قلتُ الحسامُ مضَى","شَباتُها أَو جَرتْ قلتُ القضاءُ جرى",59,"ر",2,0],["بَكَفّ شجاعٍ سافحٍ لدَمِ العِدا","وعن جُرْمِ ذي وُدٍّ وإن جَلَّ صافح",60,"ح",1,0],["بكَفِّ هُمامٍ كلّما طاعَن العِدا","بما خَطَّ جَلّى عن نُفوسٍ عَواطب",61,"ب",1,0],["بِكَفٍّ بِها لِلحَربِ وَالسِلمِ آيَةٌ","فَيُحيي لَدَيها الخَطُّ أَو يَقتُل الخَطُّ",62,"ط",1,0],["بك في العالمين يرحمنا اللَّ","هُ وعنَّا تخفّف الأَثقال",63,"ل",1,0],["بكفه للعدا نارٌ مضرمةٌ","يوم الهياج وللعافين راموزُ",64,"ز",1,0],["بكف نديمٍ لو تبدى بوجهه","ليعقوب لم يأسف على فقد يوسفا",65,"ف",2,0],["بكفاحٍ قد صيَّر الآلَ بحراً","وسماح قد صيَّرَ البحرَ آلا",66,"ل",2,0],["بكفّ يكفّ الخطب عن سوء فعله","وعن بغيه ذ تضمحلّ جرائمه",67,"م",2,0],["بكفّك للراجين بالجود خضرمُ","وفي الروع للأعداء سيف مُذلّق",68,"ق",1,0],["بكَفِّ أغرَّ تحْسُدُه الغَوادي","ويرْهبُ بأسَهُ اللَّيثُ الهصورُ",69,"ر",1,0],["بِكَ في طُولِ بَقاءٍ آمِنٍ","دونَهُ الحادثُ أعْمى وأصَمْ",70,"م",1,0],["بك فتحَ الدين الحنيف أذلّ","السيفُ عزَّ الصليبِ والأزلاما",71,"م",2,0],["بِكَ فَحَقِّقَنَّهُ","يا خَجلَةَ الشُّبَّانِ",72,"ن",1,0],["بِكَفِّ أَبي العَباسِ يُستَمطَرُ الغِنى","وَتُستَنزَلُ النُعمى وَيُستَرعَفُ النَصلُ",73,"ل",1,0],["بِكَفّي زُهَيرٍ عُصبَةُ العَرجِ مِنهُمُ","وَمَن يَبغِ في الرُكنَينِ لَخمٍ وَغالِبِ",74,"ب",1,0],["بِكَفِّ رَشاً لَهُ شِبْهَانِ مِنْهَا","شِفَاؤُكَ فِيْهِمَا رِيْقٌ وَخَدُّ",75,"د",1,0],["بِكَفٍّ أَبلَجَ مَيمونٍ مَطالِعُهُ","فَخَمُّ الجَنابِ وَقيلٍ قيلُهُ القيلُ",76,"ل",1,0],["بكفّك صارَ مفتاح لباب","على تَقبيلها الأملاك تَترى",77,"ر",2,0],["بكفّيهِ ستّاً بعد ستّين بَكرةً","هدايا له قد ساقها مائةً معا",78,"ع",2,0],["بكفي رخصةٍ تَسْرِ","قًها الألحاظُ أو رَخْص",79,"ص",1,0],["بكفِّ ساقٍ رخيمِ الدلّ تحسبه","لِمّا حوى من فتورِ الطرف وسنانا",80,"ن",2,0],["بكفّ ساقٍ كأن الكأسَ في يده","جسمٌ من النور أو روحٌ من الحبب",81,"ب",1,0],["بكفِّ ساقٍ يظلُّ يسعى على الشَّ","ربِ بوحهٍ قد صيغ من نُور",82,"ر",1,0],["بكفِّ ساقٍ يُزْهَى على غُصُنِ ال","بان إذا ما انثنى أو اعتدلا",83,"ل",2,0],["بِكَفِّ حَبيبي وَردَتان تَبَدَّتا","فَصَفرا وَحَمراءٌ بِظَنٍّ وتحقيقِ",84,"ق",1,1],["بكفّ الثّريا وهي جَذْما تقاس لي","شقاق دجًى مُدت من الشرق للغرب",85,"