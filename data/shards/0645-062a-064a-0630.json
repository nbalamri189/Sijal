{"poems":[[53,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[48,"أما والركاب وأقتابها","https://www.aldiwan.net/poem22365.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[119,"اضرني جفاك يا فلان","https://www.aldiwan.net/poem40438.html","عموديه"],[119,"لك الاضافات بالاسرار والنسب","https://www.aldiwan.net/poem41224.html","عموديه"],[422,"أقول لها يوم جدت بنا","https://www.aldiwan.net/poem53955.html","المتقارب"],[482,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105424","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93678","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131270",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52155","الوافر"],[4759,"من يهدني عرشها؟","https://www.poetsgate.com/ViewPoem.aspx?id=204019",""],[5092,"أُرتّقُ ثوبَ المنى موعدا","https://www.poetsgate.com/ViewPoem.aspx?id=176220",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""]],"verses":[["متى ذِيقَ لم يلفظهُ من فيهِ ذائقٌ","وعزَّ فلم يسْرطه إذ ذاك سارط",0,"ط",1,0],["مَتى ذُكِرَت عِندَهُ مومِسٌ","فَلَيسَ حِذاراً بِمُغتابِها",1,"ب",3,0],["متى ذَنّ أنْفُ البَرْدِ سِرْتُمْ فلَيْتَهُ","عَقِيبَ التّنائي كان عوقِبَ بالجَدْع",2,"ع",1,0],["متى ذكروه في خُشوعٍ تذكَّروا","مآثِرَهُ الْجُلَّى ونائَله الْجَمّا",3,"م",2,0],["متى ذكرت وبرزت معرضا","تشب في احشائه نيران",4,"ن",1,0],["متى ذكرت وجمر النار ملتهب","بقدرة الله ذابت وانطوى اللهب",5,"ب",1,0],["متى ذكرت عهدها باللّوى","أهاج التذكُّر بلبالَها",6,"ل",3,0],["متى ذكرتْها النفسُ ذابتْ صبابةً","وتَذكارُ أيامِ اللقاءِ يُذيبُها",7,"ه",2,0],["متى ذكرتها الخيل قل صهيلها","وإن ذكرتها البذل قل هديرها",8,"ر",3,0],["متى ذكرت أذكت حشى كل مؤمنٍ","بزند جوىً أوراه للحشر قادحه",9,"ح",2,0],["مَتى ذل قَوم أَنتَ خَلفت فيهم","إباء لَهُ يَندَق أَنف المجادل",10,"ل",1,0],["متى ذكرت مصرٌ سجاياه لم يكن","لها من طوافٍ حول تربته بد",11,"د",1,0],["متى ذُكِرَ البيانُ لنا جميلاً","ذكرنا شيخه الفذَّ الرَّصينا",12,"ن",2,0],["متى ذكرتك في إيوان قافيتي","أبحرت أبحث عنك في. شرايني",13,"ن",2,0],["متى ذا الفؤاد يتوبُ متى ؟","فمِنْ كلِّ ماضٍ أراهُ ابتدا",14,"د",2,0],["متى ذيك الهبوب الشرق هبتْ","تُثير الأرض واللي نازلينا",15,"ن",2,0]]}