em.aspx?id=184436",""],[6102,"عرس برسم الدم!!","https://www.poetsgate.com/ViewPoem.aspx?id=186280",""],[6127,"سقطَ النصيفُ","https://www.poetsgate.com/ViewPoem.aspx?id=198388",""],[6152,"المُتلون","https://www.poetsgate.com/ViewPoem.aspx?id=204602",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""],[5051,"سَقْطُ القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87709&r=&rc=3",""],[6276,"صورة المعنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80033&r=&rc=166",""],[6320,"جَوَى الأَشْجَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84337&r=&rc=34",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""],[6355,"أضغاث حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66585&r=&rc=45",""],[6360,"عَطَشُ السَّنَابِلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87601&r=&rc=3",""],[6362,"الدراجة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73533&r=&rc=92",""]],"verses":[["سَقَطْتَ يَا دَمْعُ مِنْ عَيْني غَدَاةَ نَأى","عَنِّي الْحَبِيبُ وَلَمْ تَقْضِ الَّذِي وَجَبَا",0,"ب",2,0],["سِقْطَةٌ مِلْطَةٌ شَرُوخٌ رَبُوخٌ","شُنْطُفٌ صُدِّقَ الذي سمّاها",1,"ا",3,0],["سِقطة سوءٍ أبداً تحتها","سِقط لدى الغائطِ أو سِقْطه",2,"ط",2,0],["سقط البواكرُ والروائحُ خِلْفةً","أيامَ لم استسقِ للأيامِ",3,"م",1,0],["سَقَطَت مِنَ العَجَلاتِ واحِدَةٌ","فَطَحَطَّمَت إِرَباً عَلى الصَخرِ",4,"ر",1,0],["سَقَطَ التَكَلُّفُ وَالتَجَمُّلُ بَينَنا","وَالأَهلُ أَهلي وَالمَكانُ مَكاني",5,"ن",2,0],["سقطت فلا تحزن على ما فقدته","فما انت بين الساقطين باول",6,"ل",1,1],["سَقَطَ الحِمارُ مِنَ السَفينَةِ في الدُجى","فَبَكى الرِفاقُ لِفَقدِهِ وَتَرَحَّموا",7,"م",3,1],["سَقَطتُ مِن حَماقَتي في الماءِ","وَصِرتُ بَينَ الأَرضِ وَالسَماءِ",8,"ا",2,0],["سَقَطَت في شِبرِ ماءٍ","هُوَ عِندَ النَملِ كَاليَم",9,"م",1,0],["سَقَطتَ إِلى الدُنيا وَحيداً مُجَرَّداً","وَتَمضي عَنِ الدُنيا وَأَنتَ وَحيدُ",10,"د",1,0],["سقطوا فحسبُ القومِ ما يجدونه","وكفى شهيدَ الحقِّ ما يَتَسنَّمُ",11,"م",1,0],["سَقطوا صَرْعَى عليهم غَبرةٌ","من قتام البغيِ تُخزِي الظالمين",12,"ن",1,0],["سقطت يَداهُ وما يزالُ لواؤُه","في صَدْرهِ يحنو عليه ويَحدِبُ",13,"ب",1,0],["سَقَطَت أَوانَ غُروبِها مُحمَرَّةً","كَالكَأسِ خَرَّت مِن أَنامِلِ ساقِ",14,"ق",1,0],["سَقَطَتْ قُوَّةُ المَرِيضِ التِي كا","نَتْ قديماً تُزادُ بالكافُورِ",15,"ر",1,0],["سَقَطَ النِقابُ فَراقَني","إِذ راحَ قُرطاهُ وَقُلبُه",16,"ب",2,0],["سَقَطَ النَصيفُ وَلَم تُرِد إِسقاطَهُ","فَتَناوَلَتهُ وَاِتَّقَتنا بِاليَدِ",17,"د",1,0],["سَقَطُوا عَلى أَسَد بلَحظَةَ مَش","بوحِ السَواعِدِ بِاسِلٍ جَهمِ",18,"م",1,0],["سقطت وَقَد خطف الرزية لونها","فكأنها فوق التراب تراب",19,"ب",1,0],["سقطَ السيفُ بعد طول الضرابِ","من يدِ المجد أحمرَ الجلبابِ",20,"ب",1,1],["سقطت على قدم الشقا فبكت لها","عين العلى ومكارم الأخلاق",21,"ق",1,0],["سقط الفكر في النفاق السياسي","وصار الاديب كالبهلوان",22,"ن",1,0],["سقطت وانتفض التاريخ يلعننا","وأطرقت في أسى المجد المحاريب",23,"ب",1,0],["سقطا؛ فأجفلت الريا","حُ، وضجَّ سكان السماء",24,"ا",2,0],["سقط المكياج ، لا جدوى بأن","تستعير الآن ، وجها مفتعل",25,"ل",1,0],["سَقَطَ النّصيفُ، ولم تُرِدْ إسقاطَهُ","، فتناولتهُ ، واتقنا باليدِ",26,"د",1,0],["سقطت من العجلات واحدة","فتحطّمت إربا على الصّخر",27,"ر",1,0],["سقطت في الوحول كل الفصاحات","ومات الخليل والفرّاء",28,"ا",2,0],["سقطت عن الزمنى الحقوق فكيف بي","وزمانتي قرنت بنقص المال",29,"ل",1,0],["سقط العتاب عن الفقي","د كما من فصل الصغير",30,"ر",1,1],["سقط العتاب عن السفيه","فليس يصلحه العتاب",31,"ب",1,1],["سقطت ألحاظُها مُغريةً","كنثارٍ فوقَ أشراكٍ سَقط",32,"ط",1,0],["سقطت دِمشقُ ولم تقف لسُقوطها","بينَ الأعارِبِ فِتنَةٌ وخِصام",33,"م",1,0],["سقطتُ لذاك صَعْقاً مُقشعرّاً","ودُكَّ الطورُ دكّاً كالرمال",34,"ل",1,0],["سقطتُ به صَعقاً فأضحيتُ ذاهلاً","وإندكَّ ذاك الطور للأرض منكوسا",35,"س",2,0],["سقط القناع عن الوجوه فلم يعد","يخفى العدوُّ وُروحه الهوجاء",36,"ا",2,0],["سقطت كجنديّ شهيد مماته","حياة لعمري حرة تخلد الفكرا",37,"ر",2,0],["سقطتْ بها الأنواءُ عاثرةً ولا","سلمتْ عشارُ المزن من أن تعقرا",38,"ر",2,0],["سقط الفؤاد الخلو في يده ومن","عجب رأيته بالسقوط تعالى",39,"ل",2,0],["سقطَ الفُحولُ عن الأَرائِكْ","لمَّا برزْتَ بكِبْرِيائِكْ",40,"ك",1,1],["سقطتُ وراءَ الحزمِ إِنْ لم أَشُنَّه","على الجَوْرِ يوماً مستطيرَ البوائقِ",41,"ق",1,0],["سقطتَ بساحاتِ الجهاد من العنا","كما يسقطُ المغوارُ حين يجول",42,"ل",1,0],["سَقَطَتْ نَجْمةٌ بكفّي وَصَارَتْ","طفلة تسحرُ القلوبَ اشتهاءا",43,"ا",3,1],["سَقطتْ وُريقاتُ الخريفِ وظلَّ مَنْ","أمْسَى بهُدْبِ عيونهِ مُتمِسِّكا",44,"ك",2,0],["سَقَطَ القِنَاعُ عنِ المُهَرِّجِ وانتهى","العَرضُ الهزيلُ فأنزِلِ الأسْتارا",45,"ر",2,0],["سقط النصيف ولم ترد إسقاطه","فتناولته وأتقنتنا باليدِ",46,"د",1,0],["سقطوا برفعة فضله","كالشمس في شرف المناقل",47,"ل",1,0],["سقَطَ الشُّكْرُ وَهْو مُوْجِبُ نُعْما","كَ سُقوطَ الأَنْواءِ بالأَثْمارِ",48,"ر",1,0],["سَقَطَتْ ثَنِيَّتُهُ فأُوجِعَ قَلْبُهُ","لِسُقوطِها وَجَرى عَليْهِ عظيمُ",49,"م",1,1],["سقطت على جهينته فسله","فعند جهينة الخبر اليقين",50,"ن",1,0],["سقطن على الشهيد بحر قلب","إلى تقبيل منحره ظوامي",51,"م",2,0],["سقطْتُ لحيني في فراشٍ لزِمْتُه","أضمُّ إلى قلبي جناحَ مهيضِ",52,"ض",1,1],["سقطت الأحبة وقع كيدي","فطب نفسا ولا تفرق قبيلا",53,"ل",2,0],["سقط اللوى فوقه إذا تُيَمّمُهُ","دار تحيتها فوق التحيات",54,"ت",1,0],["سقط الخلاف وَحرفه عَن لفظهم","فَلَهُم بحرف الائتلاف غَرام",55,"م",1,0],["سقط السّيف على ساعدها","فبراه والفتى لم يفقد",56,"د",1,0],["سقط القطار بهم فهل عجزت","عن حَمل ما نهضوا به القُطُر",57,"ر",1,0],["سقط الخصم تحتكم مستريحا","من أمور يشيب منها الغلام",58,"م",1,0],["سقط الندى فيه سقوط نداكما","وجلت عليه الشمس مثل سناكا",59,"ك",2,0],["سقطت بدور المجد من هالاتها","فاسودَّت الدنيا بوجه سراتها",60,"ت",3,1],["سقطت في الصعيد يشكو لسان ال","دم في حلقها من الناس غدرا",61,"ر",2,0],["سقطت دولة وجاءت سواها","فجرت مثل أختها في القياس",62,"س",1,0],["سقطت خضراء من فوق الفنن","بعدما غنى عليها البلبل",63,"ل",1,0],["سَقَطَ القَولُ إنَّ ذَلِكَ ذنبٌ","وَإِذَا الحَقُّ جَاءَ زَالَ المِرَاءُ",64,"ا",2,0],["سقطوا رمّة وطاروا سراعاً","حيث أن النسور كانت قبورا",65,"ر",2,0],["سَقَطَ القَتِيلُ ِإلى الحَضِيضِ ولوقُسٌ","وَرَدَ الرَّدى من جُملَةِ الوُرَّادِ",66,"د",1,0],["سَقَطَتَ لعَمرُ اللَهِ سَقطَةَ عاجزٍ","أَلَمَّت بِهِ البَلوى فَما هُوَ قادرُ",67,"ر",1,0],["سقَطَت إليكَ صحيفَةٌ بعتابِها","يا بؤسَ قلبِكَ بالكتابِ الساقطِ",68,"ط",1,1],["سقطت من الوفاء على خبير","فذرني والذي لك في ضميري",69,"ر",2,1],["سَقَطَت وَلَم تَملِك يَمينُكَ رَدَّها","فَوَدِدتُ يا مُوسى لَوَ اَنَّكَ يُوشَعُ",70,"ع",1,0],["سقطوا ولهفي عليهم صرعى","بحراب العوامل اللفظيَّة",71,"ي",2,0],["سقطت قصيدتك الرهيبة من علٍ","للضّرب ريحٌ والعروض يبولُ",72,"ل",1,0],["سَقَطَ القِنَاعُ، تَكَشَّفَتْ","عَوْرَاتُ قَلْبِكِ يَا مَلاَكِي",73,"ك",2,0],["سَقَطَ الرِّهَانُ ولَم أَكُنْ بمُرَاهِنٍ","ولَو استَطعتُ بُلُوغَهُ لَبَكَانِي",74,"ن",2,0],["سَقَطَت قَدَاسَةُ مَن يُحِبُّ ويَكرَهُ","فَلِمَن يُقَدِّمُ يا قصيدةُ شُكرَهُ؟!",75,"ر",2,1],["سَقَطْنَا لِأَنَّ الأَرضَ أَعلَى مِن الفَضَا","وقَد يَسقُطُ العالِي إِذا المَوقِفُ اقتَضَى",76,"ض",2,1],["سَقَطُوا.. وألْقَوا بالبلادِ, تَآمَرُوا","وتَحَاوَرُوا, وتَأَخوَنُوا, وتَحَوَّثُوا",77,"ث",3,0],["سَقَطَ الرِّدَاءُ.. فَلَم تَعُد بقَدِيمِها ال","مَخلُوعِ, أَو بجدِيدِها المَوقوفِ",78,"ف",1,0],["سَقَطَت جَمَاجِمُنا عَلَيهِ,و حينما","سَقَطَ النِّظامُ أعَدْتُمُ التّنظِيما",79,"م",2,0],["سَقَطَ الرِّهَانُ ولَم أَكُن بمُرَاهِنٍ","فَلَو استَطعتُ بُلُوغَهُ لَبَكَانِي",80,"ن",2,0],["سَقَطَتْ قَدَاسَاتُ القُبُورِ، فَمَن","سَيعُودُ يا صنعاءُ لِلنَّفَقَة!",81,"ق",2,0],["سَقَطَت كَفَّايَ عَلى يَدِهِ","ودَمِي, لَم يُبْدِ اسْتِغرَابَهْ",82,"ب",2,0],["سَقَطَت رِجلايَ فَكَانَ عَلى","كَتِفَيَّ يُعَلِّقُ أَذنابَهْ",82,"ب",2,0],["سَقَطَ الَّذِينَ اسْتَعْبَدُوا أَهْلَ التُّقَى","وَعَلا عِبَادُ اللهِ والفُضَلاءُ",83,"ا",2,0],["سقطَ الغرامُ مُضَرَّجاً بدمائِه","وغدا يصارعُ وحدهُ الآلامَا",84,"م",2,0],["سقطَ الغرامُ ومَالَهُ مِنْ صَاحِبٍ","يَحْنُو عليه وَيقتلُ الأوهاما",84,"م",2,0],["سقط الضمير ولم يعد يا أمتي","يقوى على الإخراج والتمثيل",85,"ل",1,1],["سَقَطَ الْقِنَاْعُ، وَمَاجَتِ الأَضْغَاْنُ","كَالْبَحْرِ، يَا عَوَّاْدُ، يَابَرْزَاْنُ",86,"ن",1,1],["سقَطنَا من علوِ المجد حتى","غدونا سُبَّةًً بين الأنام",87,"م",1,0],["سقط الستار وبانت الأسرار","وجه الحقيقة ما عليه غبارُ",88,"ر",1,1],["سقط الفؤاد ببئر حبكَ مرغما","والحب ان دخل الفؤاد تربعا",89,"ع",2,0],["سَقَطَتْ حُرُوفُ الضَّادِ لَمَّا أَظْلَمتْ","عَينُ الرَّقيبِ وَأَحْجمَ الشُّرَفَاءُ",90,"ا",2,1],["سَقَطَ القِناعُ، فَما تُرَدِّدُهُ اللُّغاتُ","تَقَوُّلٌ، والأنْسَناتُ تَجَمُّلُ",91,"ل",1,0],["سقطتْ ذنوبُ مُبَاحنا","عند الرؤى في اللامباحْ!!",92,"ح",1,0],["سَقطتُّ كنجمٍ على حضن نهرٍ","فكنتُ الشآم بنورٍ وطين",93,"ن",1,0],["سَقَطَ القِنَاعُ فَأَقْنَعَتْ قَلبِيْ بِسَاعْ","أَنْتَ الَّذي مِنْ مُبتَدَاهُ رَمَىْ القِنَاعْ",94,"ع",1,1],["سَقَطَ القِنَاعُ فَأُسْقِطَتْ رَايَاتُنَا","مَاْ قَاْوَمَتْ .. جَيْشِيْ وَحِصْنِيْ وَالقِلَاعْ",94,"ع",1,0],["سَقَطَتْ فِي رِحَابِهِ","فَالْتَهَى بِالْوَسَاوِسِ",95,"س",1,0],["سَقَطَ اللَّيْلُ عَلَى الدُّنْيَا ثَقِيلَا","وَاسْتَفَاقَ الْيَوْم مُرْتَابَاً عَلِيلَا",96,"ل",2,1],["سقط الكلام ، وغابت الألوانُ","للخُلف حين ، والتوحدِ آنُ",97,"ن",1,1],["سَقَطَ الحُسينُ وَتِلْكَ آخِرُ قِصَّةٍ","تُتْلى وَرَأسُ السِّبْطِ ذاكَ يُرَتِّلُ",98,"ل",1,0],["سقّطته بمستدير كالطبق","كضغطة القبر إذا القبر انطبق",99,"ق",1,0],["سَقَطَ الوِشاحُ وأشرقَ العُنُقُ","والشَّعرُ قُرْبَ الخَدِّ يَأتلِقُ",100,"ق",1,1],["سقطَ الجميعُ..وسيفُ علمِكَ مُشهَرُ","وتناثروا ..وقد التأمتَ ليُقهَروا",101,"ر",3,1],["سقط المعنى شهيدا يال جهلي","إنني أودعت روح الحب أعمى.",102,"م",2,0],["سقطَ القناع ُعن العروبةِ كلِّها","فتياتُها راحتْ تقودُ حرابا",103,"ب",2,0],["سقطتُ في الجُبّ لكن ها أنا أقفُ","وعدتُ لكنّني من وَقْعِهَا نزِفُ",104,"ف",1,1],["سقطتْ على كوم القمامة لهفةً","ورأتْ بأكوام القمامة مغنما",105,"م",2,0],["سقطتْ أقنعة حضارتنا","فبدتْ كعجوزٍ شمطاءِ",106,"ا",2,0],["سَقَطَ النَّدَى كَسَفًَا عَلَيْنا وَالْهَوَى","ماظَلَّ إلاّ شَهْقَةٌ كَيْفَ اجْتَرَأَتْ !!",107,"ت",1,0],["سَقَطَ الثَّائِرونَ حَوْلَ ضِفافي","ذاتَ صَيْفٍ وَما أَتَى جيفارا",108,"ر",2,0],["سقط النصيف عن الولاة فأرجفوا","وتلطخت بدم الحقيقة أحرفُ",109,"ف",1,1],["سقط النصيف وطاح بالسر الذي","حاك الغواية مدغما لايُكشفُ",109,"ف",1,0],["سقط النصيف وكلّ مابي ثورة","نزفت من الأوجاع لاتتوقفُ",109,"ف",1,0],["سقط النصيف فلن يضرّك ليله","إنْ مدَّ بئرا من 