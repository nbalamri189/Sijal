{"poems":[[44,"حسدوا الفتى إذ لم ينالوا سعيه","https://www.aldiwan.net/poem50221.html","الكامل"],[73,"ما عند مودود من قلت مثالبه","https://www.aldiwan.net/poem3785.html","البسيط"],[94,"خلقت طليقا كطيف النسيم","https://www.aldiwan.net/poem38896.html","المتقارب"],[87,"عندي لكم منتخب","https://www.aldiwan.net/poem7577.html","مجزوء الرجز"],[30,"من كل ذات حبائك ومفاضة","https://www.aldiwan.net/poem5179.html","الكامل"],[54,"قد عضني صرف النوائب","https://www.aldiwan.net/poem27242.html","مجزوء الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[92,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[190,"لا تصحبن وإن صحب","https://www.aldiwan.net/poem43844.html","الكامل"],[215,"ما بكى باك على الحسن الأصيل","https://www.aldiwan.net/poem46773.html","الرمل"],[242,"أهدى لنا الخيري في الروضه","https://www.aldiwan.net/poem19485.html","السريع"],[309,"ذكر العهد والربى والمنازل","https://www.aldiwan.net/poem16855.html","الخفيف"],[333,"أمل لا يزال فوق المرام","https://www.aldiwan.net/poem54962.html","الخفيف"],[438,"عقدوا شعورهم عمائم","https://www.aldiwan.net/poem12340.html","مجزوء الكامل"],[438,"عندنا نبت ربيع","https://www.aldiwan.net/poem12668.html","مجزوء الرمل"],[438,"ما زال يخدع قلبه حتى هفا","https://www.aldiwan.net/poem12801.html","الكامل"],[505,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[510,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"],[563,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53935","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77601","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145888","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145847","المجتث"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138061","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138063","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64847","البسيط"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26255","الرمل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87313","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93430","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216729","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216834","الوافر"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99244","الكامل"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125838","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4798,"وطن الجنى","https://www.poetsgate.com/ViewPoem.aspx?id=20227",""],[4869,"المقفص","https://www.poetsgate.com/ViewPoem.aspx?id=151534",""],[5605,"للمسيلة كل الحب !!","https://www.poetsgate.com/ViewPoem.aspx?id=159575",""],[5704,"طفح الجمال ولاحت الأسرارُ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204228",""],[5770,"صديقي الصامت","https://www.poetsgate.com/ViewPoem.aspx?id=178683",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"كل أب يخشى على ابنه خَشيةً مشروعة","https://www.poetsgate.com/ViewPoem.aspx?id=215770",""],[6144,"من يوم مابقينا بشناب","https://www.poetsgate.com/ViewPoem.aspx?id=21673",""],[242,"أهدى لنا الخيري في الروضه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563766",""],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""]],"verses":[["وَالأَحمَقُ المَرزوقُ أَعجَبُ مَن أَرى","مِن أَهلِها وَالعاقِلُ المَحرومُ",0,"م",1,0],["وَالأَحمَقُ الجاهِلُ الكُردِيُّ يَسأَلُ في حَبسِ","العُقَيبَةِ عَن عَلَقٍ يَداعِبُهُ",1,"ب",2,0],["وإلاَّ حَمَامُ المروجِ الأَنيقُ","يغرِّدُ منطلِقاً في غِنَاهْ",2,"ا",2,0],["والاحتلال يتقى","آراءه ويرهب",3,"ب",1,0],["وَالأَحلَمونَ إِذا الحُلومُ تَهَزهَزَت","بِالقَومِ لَيسَ حُلومُهُم بِصِغارِ",4,"ر",1,0],["وَأَلاحَ شَعرَ الرَأسِ دَه","رٌ غادِرٌ جَمُّ المَصائِب",5,"ب",1,0],["وَأَلاحَت مِن رَزِيَّتِهِ","فِهرُ إِذ وَلّى وَإِذ وَأَلا",6,"ل",2,0],["والاحاديثُ كلُّها تشتكي \" البؤسَ \"","وفصلُ الخطاب أنّا \" يَئِسْنا \"",7,"ن",2,0],["والأحمق الغرّ اللحو","ج فأنت منه على غرر",8,"ر",1,0],["وألاحيظ من الإخفاق عور","كالذي تلمح في تلك البدور",9,"ر",1,0],["وَالأَحْمَرُ الْفَاقِعُ وَجْنَةُ مَنْ","أَغْرَى بِكُلِّ الْمُبْتَلَى بَعْضَهْ",10,"ض",2,0],["والأحبة والمجتبين والسا","دات من فاضل وابن فاضل",11,"ل",1,0],["والأحاديث عن وجود صديق","كالأحاديث عن وجود السلام",12,"م",1,0],["والأَحْمَقُ الكَعْكِيُّ ظم","آنٌ لذاكَ الرَِّيِّ حائم",13,"م",1,0],["وألاحَ الوردُ منها","وجنةً والآسُ صِدْغا",14,"غ",2,0],["وألاحَ منها يستطيرُ كشاربٍ","نشوانَ رشّ على الحديقِة قَرْقَفا",15,"ف",2,0],["والأَحْمَدِيُّونَ لا تترُكْ محاضِرَهُمْ","فهُمْ رِجالٌ لَهُمْ في الحَيِّ ديوَانُ",16,"ن",1,0],["والاحبُّ بينهم كذّبُوه","وارْتأوه جامحاً في ضلالِ",17,"ل",1,0],["والأحباء حضرة البسط تجلى","من هدانا عليه الأسرار",18,"ر",1,0],["وإلاَّ حُلولَ البُرْءِ في الجسم ذي الضّنى","أتى معْ طبيب السُّقْمِ منكم لموعِد",19,"د",1,0],["وَالاحتراسُ إِن يَكُن مُؤكدا","بِمثله لَيسَ يَضُّر أَحَدا",20,"د",2,0],["والاحتلال خلاصاً نستجيرُ بهِ","بدونهِ لم نكنْ شوساً ميامينا",21,"ن",2,0],["والإحتلالُ صديقاً","يُمْلا بهِ كلُ أجوَفْ",22,"ف",1,0],["والاحْتِياطُ عِنْدَهُمْ وَالتَّقْوى","لِذلِكَ اخْتَرْناهُ فَهْوَ الاََقْوى",23,"ق",3,0],["وَالاحْتِياطُ ها هُنا مِنْ أَجْلِ مَنْ","خالَفَ فِي الْكُلِّ وَإنْ كانَ وَهَنْ",24,"ن",1,0],["والأَحْمقُ الغِرُّ لا يُصْغي لِمَوْعِظةٍ","كالأَقْرَعِ الزُّطِّ لا يَلْوي على مَشَطِهْ",25,"ط",2,0],["وَأَلاحَ الفَجرُ خَدّاً خَجِلاً","جالَ مِن رَشحِ النَدى في عَرَقِ",26,"ق",1,0],["والأَحمرَانِ فَهُمَا ضِدَّانِ","لا نَجمَ بَينَهُم سوى الهِيرانِ",27,"ن",1,0],["وَإِلا حَشا غَرسيَّةَ الخافِق الَّذي","تُزَعزِعُهُ أَرماحُ يَحيِى بن هاشِمِ",28,"م",1,0],["والأحاديث التي في فضلهم","بثها المختار سلها والكتابا",29,"ب",2,0],["والأحباء كالصخور سواء","إن أبوا عطفة على المعمود",30,"د",1,0],["وإلا حلكة فيها تلاقى","سواد القلب والطرف الكئيب",31,"ب",1,0],["وأَلاحَ تحت مراشفٍ بمباسمٍ","درّاً مَصُوناً في عقيقٍ أَحْمَرِ",32,"ر",1,0],["والأحباءُ يرحلونَ تباعاً","وسراعاً.. تَسهّلوا إخواني!",33,"ن",2,0],["والاحتجاج سلاحنا","نفرى به هامَ العدى",34,"د",2,0],["والأحسن ابن الأحسن ابن الأحسن","إلى سليمان الزمان الأوحد",35,"د",1,0],["والأحمرُ القاني بأوردةِ الصِّبا","والأرضُ حُضنك إنْ عرضتَ مُهادنا",36,"ن",2,0],["والا حبيب القلب ماهو مْتقلص","لكن من احداث الزمن صار مقهور",37,"ر",1,0],["و(الأَْحْمَدِيُّ) َضِليعَ الَوَزْنِ عَلَّمَنَا","قُلْ مَا تَشَاءُ فَإِنَ الشِّعْرَ يُرْتَجَل",38,"ل",1,0],["والأحور المكحول شحَّذَهُ رمشهُ","فغدت حصوني كلها تنهارُ",39,"ر",1,0],["والأحاديث على كثرتها","هذرٌ غث، وترداد غبي",40,"ي",1,0],["والأحقون فهم أواخركم","لحقوا فما درسوا ولا محوا",41,"ح",3,0],["والأحد الفرد إذ أبدى تعبده","لاسمه طاعةً فيه تفقهنا",42,"ن",2,0],["والأحمدُ بْنُ المير كان عديلَه","وكلاهما قد واجهَ الأشواكا",43,"ك",2,0],["والأحسن لو تبقى رقيق وتضحي في ساعات الضيق","وتخالف دُرية شفيق\" الطالبة بحق المساوات",44,"ت",1,0],["وَالأَحمَرُ الساطِعُ وَجنَةُ مَن","أَغرى بِكُلِّ المُبتَلى بِعضَه",45,"ض",2,0],["والْأَحَادِيْثُ بَيْنَنَا مُفْعَمَاتٌ","والْقَوَافِيْ لَهَا حَيَاةٌ وَمَعْنَى",46,"ن",2,0]]}