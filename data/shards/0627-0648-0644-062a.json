{"poems":[[87,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[47,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[33,"تلك هند تصد للهجر صدا","https://www.aldiwan.net/poem42580.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[108,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[33,"تِلْكَ هِنْدٌ تَصُدُّ لِلْهَجْرِ صَدَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18823&r=&rc=86",""],[102,"في بيتها العريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67676&r=&rc=164",""],[435,"قد كان صاحب هذا اللحد ذا شرف","https://www.aldiwan.net/poem39825.html","البسيط"],[454,"أين الشعور ؟","https://www.aldiwan.net/poem999.html",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66809","السريع"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54165","السريع"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101137","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100975","المجتث"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27786","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110641","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93778","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65317","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85220","الكامل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105510","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139635",""],[585,"أقسمتُ أنكَ روضةٌ وجنان","https://www.poetsgate.com/ViewPoem.aspx?id=161909",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5186,"يا لمنطاد أرضنا يتقلى","https://www.poetsgate.com/ViewPoem.aspx?id=156522",""],[5431,"وبغفلة قد يأكلك!","https://www.poetsgate.com/ViewPoem.aspx?id=196978",""],[5431,"للبصرة_وسنة الله حق دون تبديلِ","https://www.poetsgate.com/ViewPoem.aspx?id=199512",""],[5431,"يضحك الشفق...","https://www.poetsgate.com/ViewPoem.aspx?id=203089",""]],"verses":[["أو لتطوف بالألى","هناك من أهل الطرب",0,"ب",1,0],["أَولَتكَ آراءُ المَوالي نُصرَةً","بِسُيوفِهِم وَالمُلكُ جِدُّ مُمَزَّقِ",1,"ق",1,0],["أَو لِتَنكا بِهِ كُلومَ فُؤادي","أَم أَرادَت قَتلي ضِراراً وَعَمدا",2,"د",2,0],["أَولَّتني الأَيّامُ ثُمَّ بَدا لَها","فَما كانَ أَدنى مِن ولايَتي الخلعا",3,"ع",2,0],["أولت تعرف فيه مَن أجدادُه","قطعوك عرضًا بالسفين وطولا؟",4,"ل",2,0],["أوْلَتكَ مصرُ قيادَها فأعِدْ لها","مجدًا بناه الأقدمون؛ أثيلا",4,"ل",2,0],["أَوْ لِتَنْكَا بِهِ كُلُومَ فُؤادي","م أرادتْ قتلي ضراراً وعمدا؟",5,"د",2,0],["أولت صديقا تعرفني","هذي الحجرات المملوله ! ؟",6,"ل",2,0],["أولت ولايته لبنان طيب ثناً","وشاد بالعدل فيه كل منتقض",7,"ض",1,0],["أولت جهاد النفس أكبر همه","وقضت على ما شيد الشيطان",8,"ن",1,0],["أولَتهم عندي يدُ المصطفى","ذي الفضل والمنِّ أبي القاسمِ",9,"م",1,0],["أوْلتَ للعُرْسِ فلم تَدْعُنِي","ولم تَخَفْ مُعْترضاً لائمَا",10,"م",2,0],["أولتك مرشفياً فعدت برشفه","ثملا وما غير الرضاب مدام",11,"م",1,0],["أولتني قبل برّاً","به أتيتك عبدا",12,"د",2,0],["أوّلتها أسماءه ونعوته","فلها على كلِّ الوجوهِ ظهورِ",13,"ر",1,0],["أولتك مرشفها فعدت برشفة","ثملا وما غير الرضاب مدام",14,"م",1,0],["أولتني ما به تلافي تلافي","أنا ممن له إليك التجاء",15,"ا",2,0],["أوّلتُ بعض شفائي من محاسنه","فنّص لي حظه الأمراض والعللا",16,"ل",2,0],["أولت محاسنه ذكا خجلاً","حتى بكاها الجو بالقطر",17,"ر",1,0],["أو لتحريره الحريري يصو","لرأى أنه به منه أحرى",18,"ر",2,0],["أولتك غرُّ المكرمات سعودَها","ووفتكَ من بعد الجحود عهودَها",19,"د",3,1],["أولت عمامتك العمائم كلها","شرفاً تقصر عندها التيجان",20,"ن",1,0],["أو لتجلوهم على الكره عنها","لا اختيارا ويذهبوا للبلاء",21,"ا",2,0],["أو لتبد الجهود رأيا، يؤدي","بخفي، إلى تمام وضوحه",22,"ح",2,0],["أوّلتَ حلميَ طعنةً !","من في الغرام يؤولك؟",23,"ك",1,1],["أوّلتَ ليلي قبلة!!","ياليل من ذا يسدلك",23,"ك",1,0],["أوّلتكِ النهر خان النهرُ تأويلي","أقلبك الماء أم ملحٌ سيأوي لي؟",24,"ل",2,1],["أوّلتك الفجر إذْ بدا ألقا","نسيمه الحبّ حوله طلقُ",25,"ق",1,0]]}