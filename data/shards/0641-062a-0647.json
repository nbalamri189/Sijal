net/poem60609.html","الخفيف"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[364,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[371,"هجوتك لا حاجة لي إلي","https://www.aldiwan.net/poem57170.html","المتقارب"],[371,"ربما أنكر الصبابة مني","https://www.aldiwan.net/poem57483.html","الخفيف"],[377,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[377,"أفنظم در ما أره نفيسا","https://www.aldiwan.net/poem59382.html","الكامل"],[380,"لئن حل في دين الهوى لكم ظلمي","https://www.aldiwan.net/poem49259.html","الطويل"],[406,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[416,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[432,"سندوها من القدود رماحا","https://www.aldiwan.net/poem12579.html","الخفيف"],[432,"عاف سمعي ذكر المحل العافي","https://www.aldiwan.net/poem12674.html","الخفيف"],[432,"شق الصباح غلالة الظلماء","https://www.aldiwan.net/poem12771.html","الكامل"],[439,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[453,"أرقصي أيتها الأضواء","https://www.aldiwan.net/poem61391.html","مجزوء الرمل"],[453,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[453,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[458,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[461,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[461,"يا إمام الحق يا من فضله","https://www.aldiwan.net/poem16247.html","الرمل"],[468,"تمتعت من شعرك الباهر","https://www.aldiwan.net/poem60131.html","المتقارب"],[514,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[515,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[515,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[515,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[538,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"],[551,"حلفت بمن لاذت قريش ببيته","https://www.aldiwan.net/poem47812.html","الطويل"],[558,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[575,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[575,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[575,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[575,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"],[575,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[575,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[575,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"]],"verses":[["فَتَهافَتوا عَن رَحلِ كُلِّ مُذَلَّلٍ","وَتَطاوَحوا عَن سَرجِ كُلِّ جَوادِ",0,"د",1,0],["فَتَهَنَّ السُرورَ فَاليَومَ مَصقو","لُ الحَواشي مُجَرَّرُ الأَبرادِ",1,"د",1,0],["فَتَهَنَّ طَمّاحَ العَلاءِ وَلا تَزَل","في غَمرِ جودِكَ لِلرِجالِ رَغائِبُ",2,"ب",1,0],["فتُهْدى بأشْواقي السّراةُ إذا سَرَتْ","وتُحْدى بأشْعاري الرِّكابُ إذا تُحْدى",3,"د",2,0],["فتُهْدي الى كُلٍّ مَقالاً يَخُصُّهُ","فمِنّا لَها دُرٌّ ومنْهُنّ أجْيادُ",4,"د",1,0],["فتهدي بك الأمداح قصد صوابها","إذا أغوزتها في سواك المذاهب",5,"ب",1,0],["فَتِه ما شِئتَ إِذ كُنتَ","بِلا أَصلٍ وَلا جَدِّ",6,"د",1,0],["فَتَهادَتها ثَمودُ إِلى","قَومِها مِن وارِثي إِرَمِ",7,"م",1,0],["فتهاجم الماءان من ضَفَوَيْهما","فتناطحا وتوالت الهَجَمات",8,"ت",1,0],["فتهنَّ بالعيد السعيد ممتعاً","بذخائر التقوى وأيّ ذخائر",9,"ر",1,0],["فتهاوت كواكب الأفق تسعى","وانْحنى يبدأ السلام هلاله",10,"ل",2,0],["فتهنى بها فربَّ كريمٍ","قبلنا عدَّ مثلها في التهاني",11,"ن",2,0],["فتهافتوا في شُهْدِها","فتهالكوا مثل الأذِبَّهْ",12,"ب",2,0],["فتهدي لهم حزناً طويلاً وحسرةً","وإن منعوا منك النوالَ فبالعدلِ",13,"ل",1,0],["فَتَهُمُّ أَن تَدنو إِلَيه وَتَنثَني","حَتّى كَأَنَّكَ خائِفٌ أَن تَهتَدي",14,"د",2,0],["فَتَهافَتُّ كالهشيمِ على الأَر","ضِ وناديتُ أَيْنَ يا قلبُ رفشي",15,"ي",1,0],["فَتَهَامَلَتْ أَحْزانُ قلبي","في أَغاريدِ الأَنِينْ",16,"ن",1,0],["فَتَهتَزُّ آمالي وَتَقوى عَزائِمي","وَتُذَكِرُني لذَاتِهُنَّ الهَزائِمُ",17,"م",1,0],["فَتَهَنَّ بِالعيدِ السَعيدِ وَإِن كا","نَ لِكُلِّ الأَنامِ مِنهُ التَهاني",18,"ن",2,0],["فَتَهَنِّ العيدَ السَعيدَ وَإِن كا","نَ لِكُلِّ الأَعيادِ مِنكَ التَهاني",19,"ي",1,0],["فَتَهبِطُ مِن كَشحَيهِ كَفَّي تَهامَةً","وَتَصعَدُ مِن نَهدَيهِ أُخرى إِلى نَجدِ",20,"د",1,0],["فتهاوتْ ذات اليمين ديار","لفظت أهلها وذات الشمالِ",21,"ل",1,0],["فتَهَيَّبُوه وما أتَوْهُ بِسُورَةٍ","مِنْ مِثله وبيانُهُم يُتَهَيَّبُ",22,"ب",1,0],["فَتَهتِكُ أَستارَ الضَميرِ مِنَ الحَشا","وَتُبدي مِنَ الأَسرارِ كُلَّ حَبيسِ",23,"س",1,0],["فَتَهاوَنَت في البدايات فيه","راجياً أن وطأه سيزول",24,"ل",1,0],["فَتَهادَرنَ لِذاكَ زَماناً","ثُمَّ مُوِّتنَ فَكُنَّ قُبُورا",25,"ر",2,0],["فَتَهَاوَى سِتْرُ الدَّجَى وَتَوَارَى","مَا عَلَيْهِ مِنْ لُؤْلُؤٍ مَنْثُورِ",26,"ر",1,0],["فَتَهَيَّأَ الأَلَمانُ لاِسْتِقْبَالِهِ","كَالْحَائِطِ المَرْصُوصِ مِنْ أَجْسَادِ",27,"د",1,0],["فَتَهَيَّبْنَهُ فَحَيَّا بَشُوشاً","عَنْ وَمِيضٍ فِي حَالِكٍ مُسْوَدِّ",28,"د",1,0],["فَتَهْجُرُ التَّرْفِيهَ فِي بَيْتِهَا","وَهْوَ الَّذِي مَا اسْطِيعَ لاَ يُهْجَرُ",29,"ر",1,0],["فتُهْدى بك الأمْداحُ قَصْدَ صوابِها","إذا أعْوَزتْها في سواكَ المذاهِبُ",30,"ب",1,0],["فتهدي بأشواقي السراة إذا سرت","وتحدي بأشواقي الركاب إذا تحدى",31,"د",2,0],["فتهادت مواكب الشعب ألوانا","كنسيان مائج الحسن فاغم",32,"م",1,0],["فتهاوى الذي تلقّى وأعطى","وشمخنا مستهزئين جياعا ..!",33,"ع",2,0],["فتهاوت حصّى وطارت عيونا","هربت من وجوهها مستجيره",34,"ر",2,0],["فتهمّ أن تدنو إليه وتنئني","حتى كأنك خائف أن تهتدي",35,"د",2,0],["فَتَهادَرنَ كَذاكَ زَماناً","ثمَّ مُوِّتنَ فَكُنَّ قُبورا",36,"ر",2,0],["فتهاجم الماء إن من صفتَيهما","فتناطحها وتوالت الهجمات",37,"ت",1,0],["فتهتافُ الحمائم هاج هَمّى","وشوقى للمعاهد والخيام",38,"م",1,0],["فتة ملوخية بفرّوج","تاكلْ صوابْعك وياها",39,"ه",2,0],["فتهنأ به وقل إن تؤرخ","راق إشراق بدر عبد الحكيمِ",40,"م",1,0],["فتهنّ يا رب المعارفِ واقترح","ما شئتهُ وترقَّ كل تراقِ",41,"ق",1,0],["فتهنَّ بالإقبالِ من ربِ الورى","فالسعدِ أصبح نحو بابكَ خادما",42,"م",2,0],["فتِه بغرامها واخلع عذاراً","فما أهنى الغرامُ وما أحَيلى",43,"ل",2,0],["فَتَهَنَّ العيدَينِ بِاليُمنِ زارا","مِن مُقيمٍ وَظاعِنٍ في الحالِ",44,"ل",1,0],["فَتَهَنَّهُ وَاِسلَم وَعِزُّكَ قاهِرٌ","أَبَداً فَسُلطانُ الهُدى سُلطانُهُ",45,"ن",2,0],["فتهنَّ من طاعاتهِ ما نلتهُ","سهلاً وعز على الملوك منالا",46,"ل",2,0],["فتهنه ولك البقا في نعمةٍ","حتى ترى فيها قروناً تذهبُ",47,"ب",1,0],["فتهنهُ عيداً أتى ووراه من","نصر الإِله وفتحهِ أنجادُ",48,"د",1,0],["فتهنا ابن إسماعيل جوداً أقله","لدى الله أسنى ما أعد امرؤ ذخرا",49,"ر",2,0],["فتهنهُ عيداً أتاك مبشراً","لك بالمنى ونبيل كلٍّ مرامِ",50,"م",1,0],["فتهنِ ملكاً فيه أصبح ضامناً","لك بالإعانة من رضيت ضمانا",51,"ن",2,0],["فتهنه عيداً يعدك عيده","وجميع ما يلقاه من فرحاتهِ",52,"ت",2,0],["فتهوينه من حيث أطماع ناظري","ومن حيث أني لم أصبها بمؤلم",53,"م",1,0],["فتَهنَّ هذا العيدَ فهْو مهنَّأُ","بوُرود زاخرِ فَضْلِك العَجّاج",54,"ج",1,0],["فتَهنَّ هذا العيدَ فهْو مُهَنَّأٌ","فيما لديك بقُربِه ووُصوله",55,"ل",2,0],["فتهنَّ هذا العامَ فهْو مُبِّشر","بسعادةٍ ملأتْ مَسالكَ سُبْلِها",56,"ل",3,0],["فتَهَنَّ شهرَك واسْتزِدْ","بقدومه سعدا ويُمْنا",57,"ن",2,0],["فتَهَنَّ عيدَ الفطرِ والسعدِ الذي","لك فيه فهْو بكَوْنِه مقرون",58,"ن",1,0],["فتهذّبت نفسي وكانت بالصبا","عكريّة شوهاء حين حمامها",59,"م",3,0],["فتهللتْ غررُ النجومِ كأنما","كانت لضاحيةِ السماءِ بمرصدِ",60,"د",1,0],["فتَهوي فَوارغَ في بِئرِها","وتصعَدُ مِنها مِلاءَ العيونِ",61,"ن",1,0],["فتهدي عن الداعي دعاءً لمن غدا","له في سماء القلب أحسن منزل",62,"ل",1,0],["فتهلّلت أنهارُها وبحارُها","طرباً لصوتِ مهلِّلٍ ومكبِّر",63,"ر",1,0],["فتهَجّد واخش البيات فمن تض","ييعه بزّ ملكه أبرويزُ",64,"ز",1,0],["فتَهَنَّهُ وَتَمَلَّ عَيْشَكَ لابِساً","فَضْفاضَ عَيْشٍ لا يَضِيقُ فَضاؤُهُ",65,"ا",3,0],["فَتَهَنَّهُ وَتَمَلَّ عُمْرَ سَعادَةٍ","تَقْضِي النَّجُومُ الْخالِداتُ وَما انْقَضا",66,"ض",2,0],["فتهدَّلت أَغصانُها كرماً","زكت الفروع وأَنجبَ العِترُ",67,"ر",1,0],["فَتهطعُ نخوةُ العُظماء لمّا","تَصعّر مِن إيالتك الخدودُ",68,"د",1,0],["فَتَهنَأ وَاِبشِر بِكُلِّ عَلاءِ","إِنَّما السَعدُ خاتَمٌ في الخُنصَرُ",69,"ر",1,0],["فَتَهني بِكَ الدُنيا وَيَحلو بِها الصَفا","وَتَدجلي لَكَ العُليا تِباعاً بِها تَترى",70,"ر",2,0],["فَتَهنَأ وَدُم حَليفَ المَعالي","أَنتَ وَالأَهلُ في كَمالِ الحُبورِ",71,"ر",1,0],["فتهلّلت ثم قمت إلى المذ","بح نشوى وهنانةَ الأعضاء",72,"ا",2,0],["فتَهنَّ النّيروزَ وازْدَدْ سُروراً","فهْو عيدٌ مُعظَّمٌ خُسْرُواني",73,"ي",1,0],["فتَهَنَّ الشّهرَ الشّريفَ الّذي وا","فاك يُهدِي إليك حَمْداً وأجرا",74,"ر",2,0],["فتَهنَّها نِعَماً تَفيضُ على الفتى","بينَ الأماثلِ بُردةَ المَحْسود",75,"د",1,0],["فَتِه يا ابنَ نَصرٍ عَلى سالِفَيكَ","فقَد صارَ آخرُكُم أوَّلا",76,"ل",2,0],["فتهدى إلى اجتلابِ أحادي","ثي فجاءت مُنساقةً تَتَهادى",77,"د",2,0],["فَتهنَّ في عيشٍ رغيدٍ واسعٍ","مذ بِتُّ فيك ورَبعُ عيشي ضيق",78,"ق",1,0],["فتهنَّ في فخرٍ جَذبت بضبعه","فأطاع ثم عصى سواك نفيسا",79,"س",2,0],["فَتَهفو بِريّاهُم فَتَذكي ليَ الأَسى","وَتَتَرُك رَسم الصَبر اِنحَلَ مِن جِسمي",80,"ي",1,0],["فَتُهاجِرُ الأَجفان آخِر عَهدِهِ","يَوم الفِراق بِظَعنهم وَرِقادِهِ",81,"د",2,0],["فتهدي الأنام لسلطانه","بحسن الثناء وطيب الكلم",82,"م",1,0],["فتهنّأ به فقد صحّ لمّا","أن رأينا هِلالَ وجهِكَ لاحا",83,"ح",2,0],["فتهنّ الشهرَ الأصمَّ وإن كا","نَ سميعاً لمُحكَماتِ القَوافي",84,"ف",2,0],["فتهلّلت لما حططتُ ببابِه","رَحْلي أسرّةُ أوجهِ السّرّاءِ",85,"ا",2,0],["فتهنَّ يَا يَحْيى تُرَاثَ مآثِرٍ","أَحرزْتَ منها حظَّكَ الموفورا",86,"ر",2,0],["فتهادي اليوم يا","دنيا بماس أو بعسجد",87,"د",1,0],["فتهاووا عليه ضرباً ونحراً","وتغنوا غناء أهلِ الفخارِ",88,"ر",1,0],["فتهاوى ذلك القاسي كمن","ناله العُّى وإن فات الحياء",89,"ا",2,0],["فتَّهُمُ فربَعُوا من ظَلَعٍ","على رضاً بادٍ وسخطٍ مستسِرّْ",90,"ر",1,0],["فتهنَّ انقيادَه لك واعلمْ","أيّ طِرْفٍ جعلتهُ لك ظَهرا",91,"ر",2,0],["فتهنئتي للناسِ فيها لأنَّهم","بك اعتصموا من مُردياتِ المصارع",92,"ع",1,0],["فَتَهنَّأتَ مَدى أمْثالِهِ","ما غَدذا الماطِرُ نَبْتاً ونَعَمْ",93,"م",1,0],["فَتِه ما اِستَطَعتَ بِمَنظومِهِ","فَما فيهِ بَيتٌ سِوى نادِرِ",94,"ر",1,0],["فتهنَّ بالعيدِ المُبارك واِغتَنِمْ","أجرَ الصيام وبهجةَ الفِطرَينِ",95,"ن",1,0],["فتهنّ بالولدِ السّعيدِ وخَتْنِه","واِرْشُفْ هَنيئاً شهدَةَ السّرّاءِ",96,"ا",2,0],["فتهيج لي نار إذا بردتها","فعجبت من نار تهيج بماء",97,"ا",2,0],["فتهن بالأجر العظيم وميتة","درجت عليها قبلك الأخيار",98,"ر",1,0],["فتهنه صوماً أتت بركاته","منهلة وجبينه متهلل",99,"ل",1,0],["فَتهامي الجَمالِ خَيرُ جَميلِ","وعُيونُ الجَميلِ خَيرُ عُيونِ",100,"ن",1,0],["فَتَهبِطُ مِنكم أَرؤُسٌ كنّ في الذُّرا","ويخبو لكم ذاك اللّهيب المُسَعَّرُ",101,"ر",1,0],["فتهتكوا لما رأوه وصاحوا","نور التجلي الحق حيَّر عقلهمْ",102,"م",1,0],["فَتِهْ وتَسلَّطْ كيف شِئْتَ فإِنَّما","خُلِقتَ لأَشْقَى إِذ خُلِقْتُ لِتَسْعَدا",103,"د",2,0],["فَتَهنَّهُ عيداً أَتاك مبشِّراً","من رَبِّه بالعَفْوِ والغُفْران",104,"ن",1,0],["فتَهمِي على العادين طوراً بأَبْؤُسٍ","وتهْمِي على العافِين طَوراً بأَنعُم",105,"م",1,0],["فتهنَّ يا َملِكَ الملوكِ بدولَةٍ","تُؤذي العدوَّ بها كما تُولى الوَلي",106,"ل",2,0],["فتهنَّه وتهنَّ أَحسَنها","وتملَّه وتملَّ أَجملَها",107,"ل",3,0],["فتهنَّ الصِّيامَ زارَك بالأَك","رِ وأَكْرِمْ بزائرٍ منه زَارَا",108,"ر",2,0],["فتَهنَّ صوماً بَعد عيدٍ قد أَتَى","فالعِزُّ يأْتِي في زَمَانِك والمُلَح",109,"ح",1,0],["فتهنَّ بالنِّعَمِ الَّتي هُنِّئْتَهَا","برَبَابِها دانَتْ عَلَى أَرْبابِها",110,"ب",3,0]]}