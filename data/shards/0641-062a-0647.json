iewPoem.aspx?id=200552",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[592,"سلام عيلكم كلما ذر شارق","https://www.poetsgate.com/ViewPoem.aspx?id=128853",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5351,"على وثبة الصحو","https://www.poetsgate.com/ViewPoem.aspx?id=202102",""],[5351,"قبل الهزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=203799",""],[5414,"بكائية بين يدي بشار بن برد","https://www.poetsgate.com/ViewPoem.aspx?id=12926",""],[5419,"خيرٌ وأبقى","https://www.poetsgate.com/ViewPoem.aspx?id=39918",""],[5431,"أمريم في الأقصى وأنت الممانعُ","https://www.poetsgate.com/ViewPoem.aspx?id=190318",""],[5459,"لغز الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=190964",""],[5490,"من أغضب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176263",""],[5493,"أتحيا لأجل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=197672",""],[5512,"إسراف في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206699",""],[5535,"يا مرحباً بقدوم جيران النقا","https://www.poetsgate.com/ViewPoem.aspx?id=201512",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[5638,"سلام على الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=199062",""],[5691,"شدّوا الحزام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207057",""],[5703,"جاءتْكَ زائرةً","https://www.poetsgate.com/ViewPoem.aspx?id=207960",""],[5704,"يا صاحبي ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200012",""],[5741,"قل للعين طيف إلفك سارٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187496",""],[5781,"جنون بلون وحدتي","https://www.poetsgate.com/ViewPoem.aspx?id=202843",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5784,"وبعض الهوى .....","https://www.poetsgate.com/ViewPoem.aspx?id=191324",""],[5881,"لهب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=183864",""],[5906,"بِترا","https://www.poetsgate.com/ViewPoem.aspx?id=188068",""],[5939,"أسيرتي","https://www.poetsgate.com/ViewPoem.aspx?id=129125",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""],[4983,"تشربت وجهك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82962&r=&rc=2",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""]],"verses":[["فَتَهافَتوا عَن رَحلِ كُلِّ مُذَلَّلٍ","وَتَطاوَحوا عَن سَرجِ كُلِّ جَوادِ",0,"د",1,0],["فَتَهَنَّ السُرورَ فَاليَومَ مَصقو","لُ الحَواشي مُجَرَّرُ الأَبرادِ",1,"د",1,0],["فَتَهَنَّ طَمّاحَ العَلاءِ وَلا تَزَل","في غَمرِ جودِكَ لِلرِجالِ رَغائِبُ",2,"ب",1,0],["فتُهْدى بأشْواقي السّراةُ إذا سَرَتْ","وتُحْدى بأشْعاري الرِّكابُ إذا تُحْدى",3,"د",2,0],["فتُهْدي الى كُلٍّ مَقالاً يَخُصُّهُ","فمِنّا لَها دُرٌّ ومنْهُنّ أجْيادُ",4,"د",1,0],["فتهدي بك الأمداح قصد صوابها","إذا أغوزتها في سواك المذاهب",5,"ب",1,0],["فَتِه ما شِئتَ إِذ كُنتَ","بِلا أَصلٍ وَلا جَدِّ",6,"د",1,0],["فَتَهادَتها ثَمودُ إِلى","قَومِها مِن وارِثي إِرَمِ",7,"م",1,0],["فتهاجم الماءان من ضَفَوَيْهما","فتناطحا وتوالت الهَجَمات",8,"ت",1,0],["فتهنَّ بالعيد السعيد ممتعاً","بذخائر التقوى وأيّ ذخائر",9,"ر",1,0],["فتهاوت كواكب الأفق تسعى","وانْحنى يبدأ السلام هلاله",10,"ل",2,0],["فتهنى بها فربَّ كريمٍ","قبلنا عدَّ مثلها في التهاني",11,"ن",2,0],["فتهافتوا في شُهْدِها","فتهالكوا مثل الأذِبَّهْ",12,"ب",2,0],["فتهدي لهم حزناً طويلاً وحسرةً","وإن منعوا منك النوالَ فبالعدلِ",13,"ل",1,0],["فَتَهُمُّ أَن تَدنو إِلَيه وَتَنثَني","حَتّى كَأَنَّكَ خائِفٌ أَن تَهتَدي",14,"د",2,0],["فَتَهافَتُّ كالهشيمِ على الأَر","ضِ وناديتُ أَيْنَ يا قلبُ رفشي",15,"ي",1,0],["فَتَهَامَلَتْ أَحْزانُ قلبي","في أَغاريدِ الأَنِينْ",16,"ن",1,0],["فَتَهتَزُّ آمالي وَتَقوى عَزائِمي","وَتُذَكِرُني لذَاتِهُنَّ الهَزائِمُ",17,"م",1,0],["فَتَهَنَّ بِالعيدِ السَعيدِ وَإِن كا","نَ لِكُلِّ الأَنامِ مِنهُ التَهاني",18,"ن",2,0],["فَتَهَنِّ العيدَ السَعيدَ وَإِن كا","نَ لِكُلِّ الأَعيادِ مِنكَ التَهاني",19,"ن",2,0],["فَتَهبِطُ مِن كَشحَيهِ كَفَّي تَهامَةً","وَتَصعَدُ مِن نَهدَيهِ أُخرى إِلى نَجدِ",20,"د",1,0],["فتهاوتْ ذات اليمين ديار","لفظت أهلها وذات الشمالِ",21,"ل",1,0],["فتَهَيَّبُوه وما أتَوْهُ بِسُورَةٍ","مِنْ مِثله وبيانُهُم يُتَهَيَّبُ",22,"ب",1,0],["فَتَهتِكُ أَستارَ الضَميرِ مِنَ الحَشا","وَتُبدي مِنَ الأَسرارِ كُلَّ حَبيسِ",23,"س",1,0],["فَتَهاوَنَت في البدايات فيه","راجياً أن وطأه سيزول",24,"ل",1,0],["فَتَهادَرنَ لِذاكَ زَماناً","ثُمَّ مُوِّتنَ فَكُنَّ قُبُورا",25,"ر",2,0],["فَتَهَاوَى سِتْرُ الدَّجَى وَتَوَارَى","مَا عَلَيْهِ مِنْ لُؤْلُؤٍ مَنْثُورِ",26,"ر",1,0],["فَتَهَيَّأَ الأَلَمانُ لاِسْتِقْبَالِهِ","كَالْحَائِطِ المَرْصُوصِ مِنْ أَجْسَادِ",27,"د",1,0],["فَتَهَيَّبْنَهُ فَحَيَّا بَشُوشاً","عَنْ وَمِيضٍ فِي حَالِكٍ مُسْوَدِّ",28,"د",1,0],["فَتَهْجُرُ التَّرْفِيهَ فِي بَيْتِهَا","وَهْوَ الَّذِي مَا اسْطِيعَ لاَ يُهْجَرُ",29,"ر",1,0],["فتُهْدى بك الأمْداحُ قَصْدَ صوابِها","إذا أعْوَزتْها في سواكَ المذاهِبُ",30,"ب",1,0],["فتهدي بأشواقي السراة إذا سرت","وتحدي بأشواقي الركاب إذا تحدى",31,"د",2,0],["فتهادت مواكب الشعب ألوانا","كنسيان مائج الحسن فاغم",32,"م",1,0],["فتهاوى الذي تلقّى وأعطى","وشمخنا مستهزئين جياعا ..!",33,"ع",2,0],["فتهاوت حصّى وطارت عيونا","هربت من وجوهها مستجيره",34,"ر",2,0],["فتهمّ أن تدنو إليه وتنئني","حتى كأنك خائف أن تهتدي",35,"د",2,0],["فَتَهادَرنَ كَذاكَ زَماناً","ثمَّ مُوِّتنَ فَكُنَّ قُبورا",36,"ر",2,0],["فتهاجم الماء إن من صفتَيهما","فتناطحها وتوالت الهجمات",37,"ت",1,0],["فتهتافُ الحمائم هاج هَمّى","وشوقى للمعاهد والخيام",38,"م",1,0],["فتة ملوخية بفرّوج","تاكلْ صوابْعك وياها",39,"ه",2,0],["فتهنأ به وقل إن تؤرخ","راق إشراق بدر عبد الحكيمِ",40,"م",1,0],["فتهنّ يا رب المعارفِ واقترح","ما شئتهُ وترقَّ كل تراقِ",41,"ق",1,0],["فتهنَّ بالإقبالِ من ربِ الورى","فالسعدِ أصبح نحو بابكَ خادما",42,"م",2,0],["فتِه بغرامها واخلع عذاراً","فما أهنى الغرامُ وما أحَيلى",43,"ل",2,0],["فَتَهَنَّ العيدَينِ بِاليُمنِ زارا","مِن مُقيمٍ وَظاعِنٍ في الحالِ",44,"ل",1,0],["فَتَهَنَّهُ وَاِسلَم وَعِزُّكَ قاهِرٌ","أَبَداً فَسُلطانُ الهُدى سُلطانُهُ",45,"ن",2,0],["فتهنَّ من طاعاتهِ ما نلتهُ","سهلاً وعز على الملوك منالا",46,"ل",2,0],["فتهنه ولك البقا في نعمةٍ","حتى ترى فيها قروناً تذهبُ",47,"ب",1,0],["فتهنهُ عيداً أتى ووراه من","نصر الإِله وفتحهِ أنجادُ",48,"د",1,0],["فتهنا ابن إسماعيل جوداً أقله","لدى الله أسنى ما أعد امرؤ ذخرا",49,"ر",2,0],["فتهنهُ عيداً أتاك مبشراً","لك بالمنى ونبيل كلٍّ مرامِ",50,"م",1,0],["فتهنِ ملكاً فيه أصبح ضامناً","لك بالإعانة من رضيت ضمانا",51,"ن",2,0],["فتهنه عيداً يعدك عيده","وجميع ما يلقاه من فرحاتهِ",52,"ت",2,0],["فتهوينه من حيث أطماع ناظري","ومن حيث أني لم أصبها بمؤلم",53,"م",1,0],["فتَهنَّ هذا العيدَ فهْو مهنَّأُ","بوُرود زاخرِ فَضْلِك العَجّاج",54,"ج",1,0],["فتَهنَّ هذا العيدَ فهْو مُهَنَّأٌ","فيما لديك بقُربِه ووُصوله",55,"ل",2,0],["فتهنَّ هذا العامَ فهْو مُبِّشر","بسعادةٍ ملأتْ مَسالكَ سُبْلِها",56,"ل",3,0],["فتَهَنَّ شهرَك واسْتزِدْ","بقدومه سعدا ويُمْنا",57,"ن",2,0],["فتَهَنَّ عيدَ الفطرِ والسعدِ الذي","لك فيه فهْو بكَوْنِه مقرون",58,"ن",1,0],["فتهذّبت نفسي وكانت بالصبا","عكريّة شوهاء حين حمامها",59,"م",3,0],["فتهللتْ غررُ النجومِ كأنما","كانت لضاحيةِ السماءِ بمرصدِ",60,"د",1,0],["فتَهوي فَوارغَ في بِئرِها","وتصعَدُ مِنها مِلاءَ العيونِ",61,"ن",1,0],["فتهدي عن الداعي دعاءً لمن غدا","له في سماء القلب أحسن منزل",62,"ل",1,0],["فتهلّلت أنهارُها وبحارُها","طرباً لصوتِ مهلِّلٍ ومكبِّر",63,"ر",1,0],["فتهَجّد واخش البيات فمن تض","ييعه بزّ ملكه أبرويزُ",64,"ز",1,0],["فتَهَنَّهُ وَتَمَلَّ عَيْشَكَ لابِساً","فَضْفاضَ عَيْشٍ لا يَضِيقُ فَضاؤُهُ",65,"ا",3,0],["فَتَهَنَّهُ وَتَمَلَّ عُمْرَ سَعادَةٍ","تَقْضِي النَّجُومُ الْخالِداتُ وَما انْقَضا",66,"ض",2,0],["فتهدَّلت أَغصانُها كرماً","زكت الفروع وأَنجبَ العِترُ",67,"ر",1,0],["فَتهطعُ نخوةُ العُظماء لمّا","تَصعّر مِن إيالتك الخدودُ",68,"د",1,0],["فَتَهنَأ وَاِبشِر بِكُلِّ عَلاءِ","إِنَّما السَعدُ خاتَمٌ في الخُنصَرُ",69,"ر",1,0],["فَتَهني بِكَ الدُنيا وَيَحلو بِها الصَفا","وَتَدجلي لَكَ العُليا تِباعاً بِها تَترى",70,"ر",2,0],["فَتَهنَأ وَدُم حَليفَ المَعالي","أَنتَ وَالأَهلُ في كَمالِ الحُبورِ",71,"ر",1,0],["فتهلّلت ثم قمت إلى المذ","بح نشوى وهنانةَ الأعضاء",72,"ا",2,0],["فتَهنَّ النّيروزَ وازْدَدْ سُروراً","فهْو عيدٌ مُعظَّمٌ خُسْرُواني",73,"ن",2,0],["فتَهَنَّ الشّهرَ الشّريفَ الّذي وا","فاك يُهدِي إليك حَمْداً وأجرا",74,"ر",2,0],["فتَهنَّها نِعَماً تَفيضُ على الفتى","بينَ الأماثلِ بُردةَ المَحْسود",75,"د",1,0],["فَتِه يا ابنَ نَصرٍ عَلى سالِفَيكَ","فقَد صارَ آخرُكُم أوَّلا",76,"ل",2,0],["فتهدى إلى اجتلابِ أحادي","ثي فجاءت مُنساقةً تَتَهادى",77,"د",2,0],["فَتهنَّ في عيشٍ رغيدٍ واسعٍ","مذ بِتُّ فيك ورَبعُ عيشي ضيق",78,"ق",1,0],["فتهنَّ في فخرٍ جَذبت بضبعه","فأطاع ثم عصى سواك نفيسا",79,"س",2,0],["فَتَهفو بِريّاهُم فَتَذكي ليَ الأَسى","وَتَتَرُك رَسم الصَبر اِنحَلَ مِن جِسمي",80,"م",2,0],["فَتُهاجِرُ الأَجفان آخِر عَهدِهِ","يَوم الفِراق بِظَعنهم وَرِقادِهِ",81,"د",2,0],["فتهدي الأنام لسلطانه","بحسن الثناء وطيب الكلم",82,"م",1,0],["فتهنّأ به فقد صحّ لمّا","أن رأينا هِلالَ وجهِكَ لاحا",83,"ح",2,0],["فتهنّ الشهرَ الأصمَّ وإن كا","نَ سميعاً لمُحكَماتِ القَوافي",84,"ف",2,0],["فتهلّلت لما حططتُ ببابِه","رَحْلي أسرّةُ أوجهِ السّرّاءِ",85,"ا",2,0],["فتهنَّ يَا يَحْيى تُرَاثَ مآثِرٍ","أَحرزْتَ منها حظَّكَ الموفورا",86,"ر",2,0],["فتهادي اليوم يا","دنيا بماس أو بعسجد",87,"د",1,0],["فتهاووا عليه ضرباً ونحراً","وتغنوا غناء أهلِ الفخارِ",88,"ر",1,0],["فتهاوى ذلك القاسي كمن","ناله العُّى وإن فات الحياء",89,"ا",2,0],["فتَّهُمُ فربَعُوا من ظَلَعٍ","على رضاً بادٍ وسخطٍ مستسِرّْ",90,"ر",1,0],["فتهنَّ انقيادَه لك واعلمْ","أيّ طِرْفٍ جعلتهُ لك ظَهرا",91,"ر",2,0],["فتهنئتي للناسِ فيها لأنَّهم","بك اعتصموا من مُردياتِ المصارع",92,"ع",1,0],["فَتَهنَّأتَ مَدى أمْثالِهِ","ما غَدذا الماطِرُ نَبْتاً ونَعَمْ",93,"م",1,0],["فَتِه ما اِستَطَعتَ بِمَنظومِهِ","فَما فيهِ بَيتٌ سِوى نادِرِ",94,"ر",1,0],["فتهنَّ بالعيدِ المُبارك واِغتَنِمْ","أجرَ الصيام وبهجةَ الفِطرَينِ",95,"ن",1,0],["فتهنّ بالولدِ السّعيدِ وخَتْنِه","واِرْشُفْ هَنيئاً شهدَةَ السّرّاءِ",96,"ا",2,0],["فتهيج لي نار إذا بردتها","فعجبت من نار تهيج بماء",97,"ا",2,0],["فتهن بالأجر العظيم وميتة","درجت عليها قبلك الأخيار"