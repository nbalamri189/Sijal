poem/145879","الرمل"],[3420,"","https://poetry.dctabudhabi.ae/diwan/poem/177889",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117888","المجتث"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131220",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73132","الكامل"],[4585,"","https://poetry.dctabudhabi.ae/diwan/poem/110720","الخفيف"],[4767,"السيرة العظيمة","https://www.poetsgate.com/ViewPoem.aspx?id=204762",""],[4855,"أفسدت معرفتي بفرط تخلف","https://www.poetsgate.com/ViewPoem.aspx?id=189311",""],[4896,"نضال لا ينتهي","https://www.poetsgate.com/ViewPoem.aspx?id=180869",""],[5279,"المصيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=183492",""],[5691,"رجس الأرض...!","https://www.poetsgate.com/ViewPoem.aspx?id=206310",""],[5948,"يا طالبَ النحوِ ألا فابِكهِ","https://www.poetsgate.com/ViewPoem.aspx?id=100591",""],[5948,"أفسَدَ النحوَ الكسائيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=100610",""],[5956,"بوساطة محمد عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=205162",""],[5981,"غاب فلم يرجع إلى أهله","https://www.poetsgate.com/ViewPoem.aspx?id=186656",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[6341,"مع البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87277&r=&rc=6",""]],"verses":[["أَفسَدوا الدَهرَ عَلى أَولادِهِ","لا يُرى مِثلُهُمُ فيمَن وَلَد",0,"د",1,0],["أَفسَدَ قَلبي شادِنٌ أَحوَرٌ","يَسحَرُ بالعَينَينِ وَالثَغرِ",1,"ر",1,0],["أَفسِحوا لِلجِيادِ فيها مَجالاً","قَد أَضَرَّ الجِيادَ ضيقُ المَجالِ",2,"ل",1,0],["أَفسَدتَ مالَكَ قُلتُ المالُ يُفسِدُني","إِذا بَخِلتُ بِهِ وَالجودُ مَصلَحَتي",3,"ي",1,0],["أفسدتُمُونِيَ لا إفْسَادَ تَنْحِيَةٍ","للخير عنِّيَ بلْ إفساد تَعْويدِ",4,"د",1,0],["أفسدتْ توبتي عليَّ غلامُ","غُصُنٌ ناعمٌ وبدرٌ تمامُ",5,"م",1,1],["افسدت عيشه صروف الليالي","هل لما افسدته من اصلاح",6,"ح",1,0],["أفسيّد من عاش وهو لغيره","في حاجة بل ذاك عيش مَسود",7,"د",1,0],["أَفسَدَت بَينَنا الأَماناتِ عَينا","ها وَخانَت قُلوبَهُنَّ العُقولُ",8,"ل",1,0],["أفسدوا العالمَ مّما عَبثوا","بالدساتيرِ القُدامى والنُّظُمْ",9,"م",1,0],["أفْسَدَ العهدُ أمرَنَا فَعَرفْنا","هُ وماذا لنا إذا الأمرُ غُمّا",10,"م",2,0],["أَفسَدَ الواشونَ إِلفي حَسَداً","تَعِسَ الواشي لِوَقتٍ وَنُكِس",11,"س",1,0],["أَفسَدتَ قَلبي بَعدَ إِصلاحِهِ","فَعادَ بِالصَرمِ مِنَ الراسِ",12,"س",1,0],["أَفْسَدْتُ فِي حُبِّكُمْ نَفْسِي جَوىً وَأَسىً","والنَّفْسُ في الْحُبِّ مَهْمَا أُفْسِدَتْ صَلَحَتْ",13,"ت",1,0],["أَفسَدَ الْقَوْمَ عَلى أَنْفُسِهِمْ","فَإِذَا الأَخْفَرُ مَنْ كَان الأَبَرَّا",14,"ر",2,0],["أفسَدتُمُ الدِّينَ حَتَّى صَارَ مُختَلِطاً","والعِلمَ حتى تَرَدَّى سابِغاتِ بِلى",15,"ل",2,0],["أَفسَدَ خَطمي الصَفا وَالهَوى","نَخالَة الناقِضِ لِلعَهدِ",16,"د",1,0],["أفسد سوء مذهبي","في الشعر حسن مذهبي",17,"ب",2,1],["أفسدوا الدين والحياة وكانوا","سبب الغلّ في رقاب العباد",18,"د",1,0],["إِفسادُه العقلَ مَمنوعٌ كما شَهِدَت","به التَجاربُ فاِسأل من به عَلما",19,"م",2,0],["أفسحوا للذي تريد المجالا","ودعوها إذا أردتم كمالا",20,"ل",2,1],["أفسَدتَ دُنيايَ ولا دينَ لي","تُفسِدُه فاصدَع بِما تُؤمَرُ",21,"ر",1,0],["أفسدت شرع اللَه وال","أحكام طرّاً والقضا",22,"ا",1,0],["أفسده الدهر ومن ذا الذي","يحافظ العهد بظهر المغيب",23,"ب",1,0],["أفسدتُمُ عمْرِيَ الباقي عليَّ فما","أَنْفَكُّ فيه كئيبَ القَلبِ ولهانا",24,"ن",2,0],["أفسدتَ دينَكَ والسبعونَ أفسَدَتِ اُلدْ","دُنيا فَلَسْتَ بذي دُنيا ولا دينِ",25,"ن",1,0],["أفسدتَ قلبي وعَقَلْ","تَ قارحي وجذَعي",26,"ع",2,0],["أفسدتَ فيها فريضة الحجّ بال","ذُلِّ لغير المهيمن القاهرْ",27,"ر",1,0],["أفسدني إفراطُها","بعضُ العطاء يُفسدُ",28,"د",1,0],["أفسدن خلاَّني فما لي في","السرَّاء والضرَّاء من خلّ",29,"ل",1,0],["أفسد الحج ما أتاه حسين","ليس حجا ولا الحجاز حجاز",30,"ز",1,1],["أفسدتهم عوائد لك فيهم","ضل عنها الحادي وحار الدليل",31,"ل",1,0],["أفسَدَت سَعيَها بِكَيدٍ فَكانَت","كَمصلٍ صَلَّى بِغَيرِ وُضُوِّ",32,"و",1,0],["أَفسِد ربّي آراءَهُمُ","نَكِّسْ يا ربِّ لواءَهُمُ",33,"م",1,0],["أفسدوا مذ فسدوا جهراً ولا","يَصلح الفرع إذا الأصل فسدْ",34,"د",1,0],["أَفسَدت إِنساناً عَلى أَهلِهِ","يا مُفسِد الناسِ عَلى الناسِ",35,"س",1,0],["افسدوا جوهر البسيط وفيه","ركّبوا اقبح الصفات الذميمهْ",36,"م",2,0],["أفسد الظلم أنفس الناس حتى","لو رأى الناس عادلاً لارتابوا",37,"ب",3,0],["أَفَسْوَةُ الْكَلْبِ جاءَ يَمْلِكُنا","فَكَيْفَ لَوْ ضَرْطَةَ الأَسَدِ",38,"د",1,0],["إِفساد ما بنت الأجساد نافخة","في صور أَفئدة ماتَت بأَشباح",39,"ح",1,0],["أفسدتَ صبري بإدخال الغرام على","صدري فلم أحتفل فيمن لحى وهذى",40,"ذ",2,1],["أَفسَدتَ أَمرَ الدينِ حينَ وَليتَهُ","وَرَمَيتَهُ بِأَبي الوَليدِ وَليدا",41,"د",2,0],["أفسح المالَ للفسادِ مجالا","بين كأس الطلا ودلِّ الغواني",42,"ن",2,0],["أفسر قولي بما أشتهي","لتضمينه كل ما يرغب",43,"ب",1,0],["أفسَدتُمُ المنقُولَ وَالمعقُولَ وال","مَسمُوعَ مِن لُغَةٍ بِكُلِّ لِسَانِ",44,"ن",1,0],["أفسبع أثمان تضيق وقد","وسع العدى تسعان من ثُمُن",45,"ن",1,0],["أفسدتم نظري علي فما أرى","مذ غبتم حسناً إلى أن تقدموا",46,"م",3,1],["أفسدَ الدهر حالهم ليُرى حا","لك رغماً بمن يناويكَ صالح",47,"ح",1,0],["أفسدت فلسفة للشرق صافية","ويفسد الماء في المستنقع الوخم",48,"م",1,0],["أفسدت حيث سوست باقي الجسم","فمن لي بقلع ذي الأضراس",49,"س",1,0],["أفسو فيفسو وهو لي مسعدٌ","كأنما أملي ويستملي",50,"ي",1,0],["أفسدت صالحنا المثري محجبةٌ","فإن سفرت فما حال المساكين",51,"ن",1,0],["أفسدوا شعبي وأهلي","ورموهم للشتات",52,"ت",1,0],["أفسدت عيشك بالعنا","وزعمت أنك تنصلح",53,"ح",1,0],["أَفسحوا اليوم عَن عروش المَعالي","لإِمامٍ يزيدها إِعلاءَ",54,"ا",2,0],["أفسدت قوماً كراماً","من أمنع العرب بيتاً",55,"ت",2,0],["أفسدت عشرتهم أخلاقها","فجرت من لهوها في سبل",56,"ل",1,0],["أفسدنَ يوم سويقةٍ لبِّي فما","يُرجَى لِما أفسدنَهُ إِصلاحُ",57,"ح",1,0],["أفسد الانس بالدخول ثقيل","حيث كنا بدار من نهواه",58,"ه",1,1],["أفسدَ الحرثَ فالْتَوَت حولَ بعضٍ","كلُّ أغصانِه ضِئالاً جِثيا",59,"ي",2,0],["أفسدت معرفتي بفرط تخلف","وَنسخت بالتشكيك صدق يقيني",60,"ي",1,1],["أفسحوا الطرق لحريتكم","تجدوا الجنة في ساحتنا",61,"ن",2,0],["أَفْسَدُوا زَرْعَ السِّنِينِ فِي ثَوَانٍ","ثُمَّ قَالُوا مَا فَعَلْنَا لاَ يُضِيرْ",62,"ر",1,0],["أفْسدتُّمُ الشَّيْطانَ ترْبِيَةً","ومُعَلِّمُ الشَّيْطانِ حاخامُ",63,"م",1,0],["أفسده قومٌ وأزرَوا بهِ","من بين اغتنامٍوأوغادٍ",64,"د",1,0],["أفسَدَ النحوَ الكسائيُّ","وثنى ابنُ غزالَهْ",65,"ه",1,1],["أفسِّرُ غيبته بخيالي","بما لي يوسوسُهُ غاسقُ",66,"ق",1,0],["أفسح له يا رب في قبره","واسكننه جنة الخلد",67,"د",1,0],["أفسَدْتَ- لا تَربتْ يَداكَ –أمَا تَرى","ويلَ السَّماءِ على الطغاةِ تَكسَّرَا",68,"ر",2,0],["أفسحْ شِغافك.. ضمّني في وسطها","وارحل بكُلّي أينما تتعمقُ!",69,"ق",1,0]]}