{"poems":[[55,"أيا راكبا ترمي به الليل جسرة","https://www.aldiwan.net/poem29913.html","الطويل"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[53,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[53,"إذا أحدقوا بي في المكر حجزتهم","https://www.aldiwan.net/poem65735.html","الطويل"],[30,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[52,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[40,"","https://poetry.dctabudhabi.ae/diwan/poem/628","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54237","الوافر"],[154,"دموع على الخدين ترسل مزنها","https://www.aldiwan.net/poem68585.html","الطويل"],[287,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[290,"لها في الجبال الشامخات معاقل","https://www.aldiwan.net/poem39403.html","الطويل"],[369,"وبيت مثل بيت الله فرد","https://www.aldiwan.net/poem60976.html","الوافر"],[447,"قرعت على ليلى الشريفة بابها","https://www.aldiwan.net/poem14323.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104106","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130208","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137728",""],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102240","الطويل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216396",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202398","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86259","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[4307,"","https://poetry.dctabudhabi.ae/diwan/poem/31539","الطويل"],[4935,"هنئو هذا الكريم الراقيا","https://www.poetsgate.com/ViewPoem.aspx?id=129513",""],[4935,"إلى ولدي وإنساني","https://www.poetsgate.com/ViewPoem.aspx?id=129465",""],[5121,"رَيَّانَةُ الدِّبْسِ / إبنتي حنين","https://www.poetsgate.com/ViewPoem.aspx?id=49548",""],[5122,"((بنات أبتكارأفكار فكري))","https://www.poetsgate.com/ViewPoem.aspx?id=24260",""],[6125,"لَهَاهُ العِزُّ والمرتعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210905",""],[6302,"هَدْهَدهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86232&r=&rc=30",""]],"verses":[["لَها هادِيا عَينٍ وَأُذنٍ سَميعَةٍ","إِذا غارَ أَو غَرَّ العُيونَ سِماكُ",0,"ك",1,0],["لها هَزَمات في الرؤوس كأنها","ركايا ابن عادٍ غورُها ليس يسبَر",1,"ر",1,0],["لها هَنٌ تستعير وقدتَه","من قلب صب وصدر ذي حنق",2,"ق",1,0],["لها هبّةٌ بعد المضاء كأنها","هزيز الصبا بين الأباء المُحرَّق",3,"ق",1,0],["لَها هَزَمٌ وَسطَ البُيوتِ كَأَنَّهُ","صَريحِيَّةٌ لا تَحرِمُ اللَحمَ جادِيا",4,"ي",2,0],["لَها هاتِفٌ يَحكي غِناءً عَشَنَّقاً","سَميعاً بِما أَدّى لَهُ الصَوتُ مُعرِبُ",5,"ب",1,0],["لَها هَذَباتٌ فَوقَ مَيثاءَ سَهلَةٍ","نَواعِمَ ما في ظِلِّهِنَّ فُتوقُ",6,"ق",1,0],["لَهُ اهْتَزَّتْ بَوَاسِقُ نَخْلِ مِصْرٍ","وَهَالَ الأَرْزَ إِرْجَافُ الْفَضَاءِ",7,"ا",2,0],["لَها هَبَّ وَسَنانٌ وَحَجَّ صَرورَةٌ","وَلي فيهِم قلَبٌ وَفي الحَيِّ صورَةٌ",8,"ه",1,0],["لَهُ إِهاب كَتِجفافِ الكَمّي حصا","نُهُ حَريصٌ عَلى المَسلوبِ لا السَلَبِ",9,"ب",1,0],["لها همم عليا ترى الذل خسة","ترى الذود عن أوطانها متحتما",10,"م",2,0],["له أُهدِي قَوافِيَ سائراتٍ","أَبِيتُ لنَظْمِها قَلِقَ المَبيت",11,"ت",1,0],["لها هيبة العظماء من دون لثمها","إذا ما رآها ضو المهابة هابها",12,"ب",3,0],["لها هدير إذا نُصّت فتَحسبُها","تخاصمَ الشَّربِ عن إفكٍ وبُهتانِ",13,"ن",1,0],["لَهُ اِهتِزازٌ وَاِرتِياحٌ وَطَرَبْ","لِوَجهِ مَن أَورَثَهُ طولَ الكُرَبْ",14,"ب",1,0],["لها هدب هد القوى من محبها","وطرف كسير فهو افتى بكسرتي",15,"ي",1,0],["لها هدبتان كما يتجع","د بالريح ماء غدير تحدر",16,"ر",1,0],["لها هيئةٌ كالشَمسِ عند طلوعُها","ولكنَّها في الحينِ تغرُبُ في الجوفِ",17,"ف",1,0],["له أهل مِ الضِّيف ما تْمِلّي","وِلِمْعَنَى كلّه يِعَرِفُونه",18,"ن",2,0],["لها همة في حمل أضعاف حجمها","فإن لم تطق عادت له كرة أخرى",19,"ا",1,0],["لَهُ اهدى وسام الفَخر مِنهُ","وَقَد والاهُ بِالوُدِّ الاكيد",20,"د",1,0],["لها هوجٌ عند المسير كأنما","تقمصها عاتٍ من الجن غاضب",21,"ب",1,0],["لَها هَجَلاتٌ سَهلَةٌ وَنِجادَةٌ","دَكادِكُ لا توبى بِهِنَّ المَراتِعُ",22,"ع",1,0],["له أهدى ميرميران التي","فيه تسمو الكنس الجواريا",23,"ي",2,0],["له أهدي كمال ثنا","كمثل ثناء حسان",24,"ن",1,0],["لَهَا هَالَةٌ بَيْضَاءُ فَوْقَ جَبِيِنِهَا","تَمُدُّ لُجَيْنَ الْبَدْرِ وَالْعَكْسُ بِالْعَكْسِ",25,"س",1,0],["لها هيبتن لا سمعت صوتها اشعار","تدور رضاك وغيرك أتدور أغضابه",26,"ب",2,0],["لَهَاهُ العِزُّ والمرتعْ","وطبع الوغد لم يشبعْ",27,"ع",1,1],["لها هِيَ ..إنْ تشأْ ..أحْتَمُّ شَدواً","أُهدْهدُ بردَها في دِفء حُضنِي",28,"ن",2,0]]}