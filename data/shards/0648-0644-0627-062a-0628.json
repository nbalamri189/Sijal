wPoem.aspx?id=180186",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5206,"مَرثاة الصديق الغِشْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=187432",""],[5246,"عتاب الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=187064",""],[5265,"أقول لقلبٍ لجّ في إثر بينهم","https://www.poetsgate.com/ViewPoem.aspx?id=187100",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5323,"عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=207566",""],[5363,"طوبي ليبيا ابْتسمي","https://www.poetsgate.com/ViewPoem.aspx?id=144294",""],[5419,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=32275",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5458,"كلاب مسعورة","https://www.poetsgate.com/ViewPoem.aspx?id=113373",""],[5497,"في عالم الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=207251",""],[5503,"هِيَ النَّفس بَين الْعقل الطَّبْع والهوى","https://www.poetsgate.com/ViewPoem.aspx?id=194724",""],[5512,"الأب والبنون ..","https://www.poetsgate.com/ViewPoem.aspx?id=207955",""],[5550,"الأعمى","https://www.poetsgate.com/ViewPoem.aspx?id=211617",""],[5573,"ضحايا العيد","https://www.poetsgate.com/ViewPoem.aspx?id=200331",""],[5582,"أَسِيرُ غَرامٍ ذائِبُ القَلْبِ مَعْمُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=63499",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5725,"غنى النفس","https://www.poetsgate.com/ViewPoem.aspx?id=183491",""],[5738,"فَدَتْ نَفْسِ وَمَا مَلَكَتْ يَمِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=201130",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5845,"لكَ الحمدُ حمداً نستلذُّ به ذكراً","https://www.poetsgate.com/ViewPoem.aspx?id=15449",""],[5873,"عهد الكفاح","https://www.poetsgate.com/ViewPoem.aspx?id=215311",""],[5910,"فسبِّحْ بحمدِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206240",""],[5939,"لِقلبي أكملي الرحلةْ","https://www.poetsgate.com/ViewPoem.aspx?id=178592",""],[5952,"ليلُكَ مُنْجَلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=197047",""],[5957,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=24468",""],[5968,"سميت بالله من ياني الخبر جدام","https://www.poetsgate.com/ViewPoem.aspx?id=175413",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""],[6031,"عَزيزٌ أَمرُنا لَكَ بالتعزِّي","https://www.poetsgate.com/ViewPoem.aspx?id=46290",""],[6070,"رَأيتُ العُمرَتبكيهِ الورودُ*","https://www.poetsgate.com/ViewPoem.aspx?id=189502",""],[6152,"كن جابرا للقلوب","https://www.poetsgate.com/ViewPoem.aspx?id=213151",""],[6152,"تواصلي لاتقولي بيننا زعل","https://www.poetsgate.com/ViewPoem.aspx?id=213179",""],[5309,"تنكر لدنيا اخلصت لخليلها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573643",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[5957,"شذا كل حرف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82614&r=&rc=134",""],[557,"أحزان مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67203&r=&rc=65",""]],"verses":[["ولا تبكياه من وقوف فإنه","بكا الحسن الإحسان فانهد غاربه",0,"ب",2,0],["وَلا تَبرُكوا بِمُناخِ الذَليلِ","يُرَحِّلُهُ الضَيمُ عاما فَعاما",1,"م",2,0],["وَلا تُبالِ بِفِعلٍ إِن هَمَمتَ بِهِ","وَلَو رَمى بِكَ بَينَ العُذرِ وَالعَذَلِ",2,"ل",1,0],["وَلا تَبرِ مِنهُم كُلَّ عودٍ تَخافُهُ","فَإِنَّ الأَعادي يَنبُتونَ مَعَ الدَهرِ",3,"ر",1,0],["ولا تُبَلْ سَخَطَ الأعداءِ إنّهمُ","يَرضَوْنَ منكَ بأن تَرضى بهِمْ خَدَما",4,"م",2,0],["وَلاَ تُبْعِدِ الأَمْرَ البَعِيدَ وُقُوعُهُ","فَإِنَّ اللَّيَالي أًمَّهَاتُ الْعَجَائِبِ",5,"ب",1,0],["وَلا تُبقي دُموعاً بَعدَ صَخرٍ","فَقَد كُلِّفتِ دَهرَكِ أَن تَفيضي",6,"ض",2,0],["وَلا تَبخَلا بُخلَ اِبنَ قَزعَةَ إِنَّهُ","مَخافَةَ أَن يُرجي نَداهُ حَزينُ",7,"ن",1,0],["ولا تبتئس بالدهر أن خطوبه","سحابة صيف لا تَدوم ثوانيا",8,"ي",2,0],["وَلا تَبيتَنَّ ذا هَمٍّ تُكابِدُهُ","كَأَنَّما النارُ في الأَحشاءِ تَستَعِرُ",9,"ر",1,0],["وَلا تَبيتُ لَهُم خُنثى تُنادِمُهُم","وَلا يُرى لَهُمُ قِردٌ لَهُ حَشَمُ",10,"م",1,0],["ولا تبخلا عني بإنفاق أدمعٍ","ملوّنة أكوى بها إن كنزتها",11,"ت",3,0],["ولا تبعدنْ من أكلة سبقتْ بها","يدا سابق في حَلْبة المجدِ مبعدِ",12,"د",1,0],["ولا تبخسنِّي حقَّ مَدحي فإنني","أرى باخسي سيَّانَ عندي وباخصي",13,"ص",2,0],["ولا تبتئسْ بالعسر فاليسرُ بعده","وهل دونَ ما ترجوه باللَّه أقفالُ",14,"ل",1,0],["ولا تبخلوا عني بعرضٍ فكلُّكُم","بني طاهرٍ بالعرضِ غيرُ بخيلِ",15,"ل",1,0],["ولا تبنوا مقالَ الإفكِ فيه","فليس لما بنى اللَّهُ انهدامُ",16,"م",1,0],["ولا تبال ما تسمى","مؤمناً أم ملحدا",17,"د",2,0],["وَلا تُبالِ بِكِنزٍ بَعدَ مَبسِمِهِ","أَغلى اليَواقيتُ ما أُعطيتَ وَالدُرَرِ",18,"ر",1,0],["وَلا تُبالِ بِشِعرٍ بَعدَ شاعِرِهِ","قَد أُفسِدَ القَولُ حَتّى أُحمِدَ الصَمَمُ",19,"م",1,0],["ولا تبطروا إن نلتمُ ما ذكرته","وروموا به العتى وحوزوا به المنى",20,"ن",2,0],["ولا تبالِ بصرفِ الدهر كيفَ جرى","فإنما الدهرُ غُولٌ ذاتُ ألوانِ",21,"ن",1,0],["ولا تُبْلِني بالبعدِ عنك فإِنَّما","حياتيَ إِلّا في ذُراكَ حِمامُ",22,"م",1,0],["ولا تبحثُوا عن سرِّ قلبيَ إنَّهُ","صفَاً ليس يمضي فيه مِعْوَلُ باحثِ",23,"ث",1,0],["وَلا تَبكِ مِن فَقدِ اِمرِئٍ لَستَ ذاكِراً","لَهُ لامَةً إِلّا اِستَمَرَّت مَرائِرُه",24,"ر",2,0],["ولا تبكِ إلاّ بعدَ طولِ صبابةٍ","وحسْبُك من فرطِ الصَّبابةِ ما أَبكى",25,"ا",1,0],["وَلا تَبْتَئِسْ مِنْ مِحْنَةٍ سَاقَهَا الْقَضَا","إِلَيْكَ فَكَمْ بُؤْسٍ تَلاهُ نَعِيمُ",26,"م",1,0],["ولا تبتدرْ بالبيدرين فأضلعي","أخافُ منَ الأشواقِ أن تتقضقضا",27,"ض",2,0],["وَلا تَبتَئِس بِهِمُ أَن جَرى","عَدُوٌّ بِأَمرٍ فَلَم يَسجَحُوا",28,"ح",3,0],["وَلا تَبكِ مَيتاً بَعدَ مَيتٍ أَجَنَّهُ","عَلَيَّ وَعَبّاسٌ وَآلُ أَبي بَكرِ",29,"ر",1,0],["ولا تبكينّ على ناسكِ","وإن ماتَ ذو طربٍ فابكهِ",30,"ك",2,1],["وَلا تَبكِ مِن خَيسٍ بِبابِ خَليفَةٍ","يَذِلُّ عَلَيهِ القَسوَرِيُّ الخَمَرنَجُ",31,"ج",1,0],["وَلا تَبغِيَن لَمحَةً في الحَياةِ","إِلى جارَتَيكَ إِذا كَنَّتا",32,"ت",2,0],["وَلا تُبدوا عَداوَتَكُم لِقَومٍ","أَتَوكُم في الحَياةِ مُجامِلينا",33,"ن",2,0],["ولا تبال إذا عاداك من سفه","بنو اللقيطة من ذهل بن شيبانا",34,"ن",2,0],["ولا تبال ما تُسَم","مى مؤمناً أَو ملحدا",35,"د",2,0],["ولا تبكي على يومِك","أو تأسَيْ على الأمسِ",36,"س",1,0],["ولا تُبالي بمَحْلٍ إنْ ألَمّ بها","ولا تَهَشّ لإخْصابٍ وإمْراعِ",37,"ع",1,0],["وَلا تُبْقِيَنَّ عَلَى فَاجِر","فَإِنَّ اللِّئَامَ عَبِيدُ الْعَصَا",38,"ص",2,0],["وَلا تَبسَّمُ إِلاَّ","وجفْنُ باِكٍ يَمُورُ",39,"ر",1,0],["ولا تَبْقَ وحدَكَ في حِطّة","ومهما يكن سلّمٌ فاصعد",40,"د",1,0],["ولا تبخَلوا أنْ تَمُدوا يداً","لتحضِنَ منه خيالاً سَرى",41,"ا",1,0],["وَلا تَبكِ مِن فَقدِ امرِىءٍ لستَ ذاكراً","لَهُ لامَةً إلاّ استَمَرّتْ مَرَائِرُهْ",42,"ر",2,0],["ولا تَبِتْ فوق شفيرٍ هاجدا","ولا عن الساهر فيكَ راقدا",43,"د",2,0],["ولا تبقوا الذين قد استبدوا","وراموا كيدنا وتخونونا",44,"ا",1,0],["ولا تبعث لشأن الدهر فكرا","ففيه الهم منفلت الجماح",45,"ح",1,0],["ولا تبتلي المضنى بحب مباعد","ويا رب لا تحكم على الناس بالحب",46,"ب",1,0],["ولأتباع كرام","عرفوا سر التجلي",47,"ل",2,0],["ولا تبتئس فالدهرُ رَبُّ تقَلُّبٍ","عسَى بعد هذا البُعْدِ يلتئمُ الشملُ",48,"ل",1,0],["ولا تبدينَّ المزحَ في كلِّ ساعةٍ","بكل مكانٍ يستخفُّ بك النَّذْل",48,"ل",1,0],["ولا تُبديَنَّ الضحك في كل لفظةٍ","ولكن قليلا في الأمورِ العَجائبِ",49,"ب",1,0],["وَلا تَبدَؤونا بِالظُلامَةِ وَالأَذى","فَنَجزيكُمو ضِعفاً مَعَ الأُمِّ وَالأَبِ",50,"ب",1,0],["ولا تُبالي جفاءً","أسُرَّ يوميَ أَم سِي",51,"س",2,0],["وَلا تَبغِ بالإِحسانِ إِرضاءَ كاشِحٍ","فَلَيسَ بِمغنٍ في دَمالٍ تَدامُلُه",52,"ل",2,0],["وَلا تَبسُطَن كَفّاً إِلَيها وَخَلِّها","لِأَروَعَ يُغلي مَهرَها غَيرَ نادِمِ",53,"م",1,0],["وَلا تَبادِرُ بالشِتاءِ وَلِيدَنا","القِدرَ تُنزِلُها بِغَيرِ جِعالِ",54,"ل",1,0],["ولا تُبعِد الكانونَ عنك فإنه","لأَمْنَعُها دِرْعا وَأَمْضَى مُهَنَّدِ",55,"د",1,0],["ولا تَبْخَس الناسَ أقدارَهم","فما البَخْس إلا أقلُّ الحرام",56,"م",1,0],["ولا تبعني المدح بالشكر يا","اخا ربيع الجود والفضل",57,"ل",1,0],["ولا تبخل عليّ كما تناهت","إلى الغايات باخلة دموعي",58,"ي",1,0],["وَلا تَبخَلوا أَن تَسمَحوا لي بِنَظرَةٍ","تُخَفِّفُ أَشجاني وَفَرطِ صَبابَتي",59,"ت",2,0],["ولا تبغ الفساد فكلّ باغٍ","عليه أدار مولانا الدوائر",60,"ر",1,0],["ولا تبلني حمل الحوادث عالماً","بصبري فأن الحادثات ثقال",61,"ل",1,0],["ولا تبغ خلا من زمانك إنه","أعز وأنأى من مصادقة الخل",62,"ل",1,0],["ولا تبلني بالبعد عنك فطالما","رحلت ولا قلبي صحبت ولا عقلي",62,"ل",2,0],["ولا تبك عيناك إلّا دما","لعلّ الخطايا به تنضحُ",63,"ح",1,0],["وَلا تَبْخَلوا بِالوَصلِ عَني فَإِنَّكُم","أَجَلُّ مَقَاما أَنْ يضاف لكُم بُخل",64,"ل",1,0],["ولا تُبدِ للبأساءِ إِلّا تكرُّماً","وإِن بالغت في النَهر يَوماً وفي النَهكِ",65,"ك",1,0],["ولا تبقنا يا ربنا عرضة لهم","وهدف مرامي كل من خان وامترى",66,"ر",2,0],["وَلا تَبرَح بِنا برّاً رحمياً","تعمّ جَميعَنا عدلاً وفضلا",67,"ل",2,0],["وَلا تُبكِ المُصابَ وَأَيُّ حَيٍّ","إِذا ما ماتَ يُحييهِ البُكاءُ",68,"ا",2,0],["وَلا تبعديني عَمدَ عينٍ فَتشمتي","وشاتي وَتغري في المَلامة بي عيني",69,"ن",2,0],["ولا تبق ديَّاراً على الأرضِ منهمو","فما قوم عاد منهمو بعدوا أمرا",70,"ر",2,0],["ولا تَبِتْ على وَغَر","فلو وخَزْتَ بالإبَر",71,"ر",1,0],["وَلا تَبسُّمُ وَجهِ البَرقِ مِن مَلَقٍ","وَلا تَصوُّبُ دَمعِ السُحبِ مِن حَصَبِ",72,"ب",1,0],["ولا تُبدلنَّ الحق بالكذب عنوةً","ولا تُرضِنا عن ذاك بالأفِّ والتُّفِّ",73,"ف",1,0],["ولا تَبسَمْتُ أُبدِي للعِدَا جَلَداً","إلاّ تميَّزْتُ من غيظٍ ومن حَنَقِ",74,"ق",1,0],["ولا تبذل الشورى يقال لخمسةٍ","رواه ابن زيد جابر وهو عالم",75,"م",1,0],["ولا تبقوا ولا تعنوا","فقتل المعتدي أنفي",76,"ي",1,0],["ولا تبالي عزوفي فهو عن مقة","كأنما أنا أخشى بث أجشاني",77,"ن",2,0],["وَلا تَبدأوا بِالحَربِ مَن لَم يَكُن لَكُم","مِنَ الناسِ لِلعُدوانِ وَالظُلمِ بادِيا",78,"ي",2,0],["ولا تَبدَّلْ بسواكم دولةٌ","أنتم على أرجائها سِتر يُمَدّْ",79,"د",1,0],["ولا تبرحنَّ بشعري عليك","عرائسُ يُجْلَيْنَ هِيفاً وغِيدا",80,"د",2,0],["ولا تبلُغ الأثقالُ غايةَ جَهدِهِ","إذا ظلَّت البُزْلُ المصاعيبُ تشغَبُ",81,"ب",1,0],["ولا تُبلِ أثوابَ الوزارةِ بعد ما","كستك بها الأيّام وهي سليبُ",82,"ب",1,0],["وَلا تَبِع نُسكاً بِغَيٍّ فَما","يَربَحُ إِلّا مَن لَهُ نُسكُ",83,"ك",1,0],["وَلا تَبتَدِع حَرباً تُطيقُ اِجتِنابَها","فَيَلحَمَكَ الناسَ الحُروبُ البَدايِعُ",84,"ع",1,0],["ولا تبغِ غير الله عوناً بفادحٍ","وابشر فإن الله يغلب من غلب",85,"ب",1,0],["ولا تبِعْتُ جُدودي في مَفاخِرِهِمْ","ولا تَباهى بإِرْثي الحِجْرُ والحَرَمُ",86,"م",1,0],["ولا تُبعِدوني عن حِبالِ خَيالِكُمْ","فعندي شَميمُ التُّربِ من رُحْبِكُمْ غالِ",87,"ل",1,0],["ولا تبعثْ لغيرِ اللهِ قلباً","فبعثُ الغيرِ يقلِبُ في الصِّرَاعِ",88,"ع",1,0],["ولا تبسُطْنَ كفًّا ولا تغلُلْنَ يداً","وِساطاً كشأنِ الهاشِمِيِّ المُطَهَّرِ",89,"ر",1,0],["ولا تبيعين دينك في ذهب ولجين","خافي من اللَه بعد الشيب ما ترجين",90,"ن",1,0],["ولا تبت من دون جمات الغنى","ترضى بما تمتص من ثماده",91,"د",2,0],["ولا تبعث بقيمتها فإني","أراه من التكلف والغرامة",92,"م",2,0],["ولا تَبخَسوا باللهِ قَدرَ حُقوقِكُم","بني المَغرِبِ الأقصى فأَنتمُ أنتمُ",93,"م",1,0],["وَلا تُبقي صُروف الده","رِ إِنساناً عَلى حالِ",94,"ل",1,0],["ولا تُبدوا صريحَ المنعِ منكمْ","فيُغنينا عن الخبرِ اليقينُ",95,"ن",1,0],["ولا تبعُدَنْ عن نداءِ الصّريخِ","وعن هبّةِ الثّائرِ العازِم",96,"م",1,0],["وَلا تبعْ بحرامٍ","من المعيشةِ حِلّا",97,"ل",2,0],["ولا تبكهِ منّا العيونُ وإِنّما","بكته المواضي والقنا والعواملُ",98,"ل",1,0],["وَلا تَبِتْ جَذِلاً بِالشّيء يتركُهُ","عليك خطبٌ جفا عمداً ولم يَذَرِ",99,"ر",1,0],["ولا تبعدوا عني بأحوال غفلةٍ","دهتكم فأصبحتم بعادَ التأمُّلِ",100,"ل",1,0],["ولا تبقنا كَلّاً على أحد سوى","جنابك واحرسنا من المهيع الدحض",101,"ض",1,0],["ولا تبالي بكل داع","إلى سواه أتى برد",102,"د",1,0],["ولا تبت من كدور الدهر منقبضاً","فإنما الدهر ميال إلى العوج",103,"ج",1,0],["ولا تَبرَحُوا ظِلَّ الخيامِ فَرُبَّما","وَقَتكُم مِنَ المَوتِ الوَحيُّ سُجُوفُها",104,"ف",3,0],["ولا تَبعدي مِنّي وأنتِ قريبة","فقد يبعد المحبوب وهو قريب",105,"ب",1,0],["ولا تبخسن وزنا لديك محررا","وفي كل شيء آية فتبصرا",106,"ر",2,0],["ولا تبقي على","وحاصر حصنَ قوَّتِه وزلزل",107,"ل",1,0],["وَلا تَبرَحوا عَن نَشر راية بشركم","عَلى هام مَن سالمتموه تلطفا",108,"ف",2,0],["وَلا تَبخلي بِالوَصل في أَيّ حالة","عَلى مُغرم للغانيات ودود",109,"د",1,0],["ولا تَبْغِ في أمرِ اللِّباسِ تَواضُعاً","فَعُنوانُ نُبْلِ المَرءِ حُسْنُ لِباسِهِ",110,"ه",1,0],["وَلا تَبِع عاجِلَ الدُنيا بِآجِلِ ما","تَرجو فَذلِكَ أَمرٌ شَأنُهُ الطولُ",111,"ل",1,0],["ولا تبدل في أمر إن انتصروا","ولا تحول في شأن إذا انهزموا",112,"م",3,0],["ولا تبعدوا عن جانب عون جانب","فهذا لكم خال وهذا لكم عم",113,"م",1,0],["ولا تبالوا بما ضج الرواة به","على البريء من الدعوى وما نقلوا",114,"ل",3,0],["ولا تبيتوا على عجز يعولكم","من ليس يأمن عدواناً ومزدحما",115,"م",2,0],["وَلا تَبنِ هَيئة زَعماً كَهَيئَتِهِ","فَإِنَّ عَينِيَ عَن ذا القُبحِ عَمياءُ",116,"ا",2,0],["وَلا تَبغي عَلَيَّ بِهِ دَليلاً","فَإِنَّ الجُرحَ بَيِّنَةُ الجَريحِ",117,"ح",1,0],["ولا تبكى عليه إنْ","توارَى عنك أو بانا",118,"ن",2,0],["ولا تُبطلوا شرعَ النبيَّ وحُكمه","فذاك إلى الجانيِّ يُوغبُ في الجرم",119,"م",1,0],["ولا تبيتن إلا خاليَ البالِ","وللمقادير أحكام بعادتها",120,"ت",3,0],["ولا تباعةَ على ام","رئٍ قضى ما وجبا",121,"ب",2,0],["وَلا تَبغِ الخِلافَ فَإِنَّ فيهِ","تَفَرُّقَ من ذَواتِ الأَصفِياءِ",122,"ا",2,0],["ولا تبتئس من قول واش وحاسد","فما برحت أهل الفضائل تحسد",123,"د",1,0],["ولا تبنع المسكين ظلماً وتنثني","الى كل جبار جنى المجد طلقا",124,"ق",2,0],["ولا تبت بفراش الافك تخلقه","فالافك يدنو لثوب المجد يخلقه",125,"ق",2,0],["ولا تَبَسَّم ثغرُ النَّوْرِ مُحْتَجباً","إلاّ سَقَتْهُ الغَوادي أكْؤُس المطرِ",126,"ر",1,0],["وَلا تَبتئس إِن عشتَ فيهم مُحسّداً","فَذو الفضلِ مِن بين الآنام محسّدُ",127,"د",1,0],["ولا تبع تحقيق شيء يعرف","بشبهة يأتي بها محرف",128,"ف",1,0],["ولا تبد له تيها","فيشنا كل تياه",129,"ه",1,0],["وَلا تَبخل عَلي بِها","فَقَد طابَت لي الخَمر",130,"ر",1,0],["ولا تبع من طال منه الباع","إنّ طويل الباع لا يباع",131,"ع",1,0],["وَلا تَبخَلي عَيني بدمعك إِنَّهُ","مَتى تُسبلي لي رقّ دَمعي وَتَجمُدي",132,"د",2,0],["وَلا تَبعَثُوهُ بِالنَكالِ عَلَيكُمُ","فَآجالُ مَن عادى عُلاهُ قِصارُ",133,"ر",1,0],["وَلا تَبرح الأَعيادُ يُشرِقُ نورُها","بِغُرّته إِن راحَ يَوماً أَوِ 