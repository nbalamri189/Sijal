{"poems":[[93,"يا متقن الخط ويا ملبساً","https://www.aldiwan.net/poem11079.html","السريع"],[72,"يا متقنا علم الشريعة والندى","https://www.aldiwan.net/poem19617.html","الكامل"],[78,"يا متبع الاكرام إنعاما","https://www.aldiwan.net/poem14073.html","السريع"],[74,"يا مترفا يمشي الهوينا غرة","https://www.aldiwan.net/poem13185.html","الكامل"],[143,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[160,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[169,"عذل المشوق يهيج في برحائه","https://www.aldiwan.net/poem1595.html",""],[186,"يا متعب النفس في تصرفه","https://www.aldiwan.net/poem43849.html","المنسرح"],[210,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[297,"يا متعبا بنقوش الخط أنمله","https://www.aldiwan.net/poem32936.html","البسيط"],[364,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[366,"الدار راحلة على آثارهم","https://www.aldiwan.net/poem16996.html","الكامل"],[416,"علي لا زلت مسرورا بسلمان","https://www.aldiwan.net/poem53863.html","البسيط"],[437,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[452,"حتام تبدو لنا وتحتجب","https://www.aldiwan.net/poem13634.html","المنسرح"],[513,"يا مت قبلك طال الحزن والأسف","https://www.aldiwan.net/poem67724.html","البسيط"],[513,"يا مت قبلك قد والله برح بي","https://www.aldiwan.net/poem67732.html","البسيط"],[575,"سبحان ربك فالق الإصباح","https://www.aldiwan.net/poem2975.html","الكامل"],[586,"لو أن قلبك لي يرق ويرحم","https://www.aldiwan.net/poem17728.html","الكامل"]],"verses":[["يا متقن الخط ويا ملبساً","منه بديعات المعاني حلى",0,"ل",2,1],["يا متقناً علم الشريعة والندى","أنت الأحق بما يقول الأول",1,"ل",1,1],["يا مُتبِعَ الاكرام إِنعاما","وَمُتبَعَ الانعام إِتماما",2,"م",2,1],["يا مُترَفاً يَمشي الهُوَينا غِرَّةً","وَيَهُزُّ أَعطافَ القَضيبِ المورِقِ",3,"ق",1,1],["يا مُتعِبَ النَفسِ النَفيسَةِ حَسبُ مَن","قارَعتَ عَنهُ راحَةً إِتعابُها",4,"ب",3,0],["يا متبع الحسنى بعشر مثلها","أصلح لي العيد بهذي العشر",5,"ر",1,0],["يا مُتعَباً أَودى الكَلالُ بِعيسِهِ","مُذ غالَ صَرفَ الدَهرِ صِرفَ ثَرائِهِ",6,"ا",3,0],["يا متعب النفس في تصرفه","بالكد بين الرواح والبكر",7,"ر",1,1],["يا متهمي بالسلو مهلا","تظن اني سلوت مه لا",8,"ل",2,1],["يا متعباً بنقوشِ الخَطِّ أَنملَه","وَساهرَ اللّيلِ لَم يَرقُد وَلَم يَنَمِ",9,"م",1,1],["يا مُتعِباً نفسَه في أن يُساجِلَه","أينَ السّماكُ إذا قايَسْتَ والسَّمك",10,"ك",1,0],["يا مُتعَةَ الصَدرِ الَّذي هُم سِرُّهُ","وَيَسُرُّني التَرويحُ مِن أَسرارِهِم",11,"م",1,0],["يا متبعاً هبة الأولى بثانية","وطالما تتبع الحسنى بإحسان",12,"ن",1,0],["يا متلف روحي ما علقت","بسوى تعذيب منك يدي",13,"ي",1,0],["يا مترع كأس الجود لقد","ظمأ روحي فالقلب صد",13,"د",1,0],["يا مُترَفاً لا يزال يلحظني","والقلب مستبشر ومرتقب",14,"ب",1,0],["يا مت قبلك طال الحزن والأسف","وجاوز الشوق بي حد الذي أصف",15,"ف",1,1],["يا مت قبلك قد واللَه برح بي","شوقي إليك فهل فيك من حظ",16,"ظ",1,1],["يا مُتْعبَ العُذَّالِ والعُشَّاقِ وال","حُسادِ والوُصَّافِ والمُدَّاح",17,"ح",1,0],["يا مُتْهِمَا قَلْبي بِسَلْوةِ حُبِّهِ","هَيْهَاتَ يُنْجِدُه وَأَنْتَ المُتْهِمُ",18,"م",1,0]]}