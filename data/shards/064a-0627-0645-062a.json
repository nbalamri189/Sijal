{"poems":[[95,"يا متقن الخط ويا ملبساً","https://www.aldiwan.net/poem11079.html","السريع"],[74,"يا متقنا علم الشريعة والندى","https://www.aldiwan.net/poem19617.html","الكامل"],[80,"يا متبع الاكرام إنعاما","https://www.aldiwan.net/poem14073.html","السريع"],[76,"يا مترفا يمشي الهوينا غرة","https://www.aldiwan.net/poem13185.html","الكامل"],[147,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[164,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[173,"عذل المشوق يهيج في برحائه","https://www.aldiwan.net/poem1595.html",""],[190,"يا متعب النفس في تصرفه","https://www.aldiwan.net/poem43849.html","المنسرح"],[214,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[302,"يا متعبا بنقوش الخط أنمله","https://www.aldiwan.net/poem32936.html","البسيط"],[369,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[371,"الدار راحلة على آثارهم","https://www.aldiwan.net/poem16996.html","الكامل"],[422,"علي لا زلت مسرورا بسلمان","https://www.aldiwan.net/poem53863.html","البسيط"],[443,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[457,"حتام تبدو لنا وتحتجب","https://www.aldiwan.net/poem13634.html","المنسرح"],[518,"يا مت قبلك طال الحزن والأسف","https://www.aldiwan.net/poem67724.html","البسيط"],[518,"يا مت قبلك قد والله برح بي","https://www.aldiwan.net/poem67732.html","البسيط"],[580,"سبحان ربك فالق الإصباح","https://www.aldiwan.net/poem2975.html","الكامل"],[591,"لو أن قلبك لي يرق ويرحم","https://www.aldiwan.net/poem17728.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122624","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122805","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63937","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120019","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120101","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64497","الطويل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53153","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201250","الكامل"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138836",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67973","الكامل"],[3651,"","https://poetry.dctabudhabi.ae/diwan/poem/97592","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91684","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135733","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135729","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135732","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44729","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28648","المجتث"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117243","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117226","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33185","الخفيف"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144262","الكامل"],[4680,"أودى بكَ الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=185075",""],[4788,"خلاص جزنا من المحبه وتبنا","https://www.poetsgate.com/ViewPoem.aspx?id=132246",""],[4859,"ياقرّة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=192955",""],[4869,"ورديّ الاحلام","https://www.poetsgate.com/ViewPoem.aspx?id=151512",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5596,"عبق الزهر","https://www.poetsgate.com/ViewPoem.aspx?id=205463",""],[5599,"هديه جزيله","https://www.poetsgate.com/ViewPoem.aspx?id=213862",""],[5612,"ماذا ستفْعَلْ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=181615",""],[5732,"ياما برأس الناب","https://www.poetsgate.com/ViewPoem.aspx?id=177954",""],[5879,"يا راكب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=215462",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["يا متقن الخط ويا ملبساً","منه بديعات المعاني حلى",0,"ل",2,1],["يا متقناً علم الشريعة والندى","أنت الأحق بما يقول الأول",1,"ل",1,1],["يا مُتبِعَ الاكرام إِنعاما","وَمُتبَعَ الانعام إِتماما",2,"م",2,1],["يا مُترَفاً يَمشي الهُوَينا غِرَّةً","وَيَهُزُّ أَعطافَ القَضيبِ المورِقِ",3,"ق",1,1],["يا مُتعِبَ النَفسِ النَفيسَةِ حَسبُ مَن","قارَعتَ عَنهُ راحَةً إِتعابُها",4,"ب",3,0],["يا متبع الحسنى بعشر مثلها","أصلح لي العيد بهذي العشر",5,"ر",1,0],["يا مُتعَباً أَودى الكَلالُ بِعيسِهِ","مُذ غالَ صَرفَ الدَهرِ صِرفَ ثَرائِهِ",6,"ا",3,0],["يا متعب النفس في تصرفه","بالكد بين الرواح والبكر",7,"ر",1,1],["يا متهمي بالسلو مهلا","تظن اني سلوت مه لا",8,"ل",2,1],["يا متعباً بنقوشِ الخَطِّ أَنملَه","وَساهرَ اللّيلِ لَم يَرقُد وَلَم يَنَمِ",9,"م",1,1],["يا مُتعِباً نفسَه في أن يُساجِلَه","أينَ السّماكُ إذا قايَسْتَ والسَّمك",10,"ك",1,0],["يا مُتعَةَ الصَدرِ الَّذي هُم سِرُّهُ","وَيَسُرُّني التَرويحُ مِن أَسرارِهِم",11,"م",1,0],["يا متبعاً هبة الأولى بثانية","وطالما تتبع الحسنى بإحسان",12,"ن",1,0],["يا متلف روحي ما علقت","بسوى تعذيب منك يدي",13,"د",2,0],["يا مترع كأس الجود لقد","ظمأ روحي فالقلب صد",13,"د",1,0],["يا مُترَفاً لا يزال يلحظني","والقلب مستبشر ومرتقب",14,"ب",1,0],["يا مت قبلك طال الحزن والأسف","وجاوز الشوق بي حد الذي أصف",15,"ف",1,1],["يا مت قبلك قد واللَه برح بي","شوقي إليك فهل فيك من حظ",16,"ظ",1,1],["يا مُتْعبَ العُذَّالِ والعُشَّاقِ وال","حُسادِ والوُصَّافِ والمُدَّاح",17,"ح",1,0],["يا مُتْهِمَا قَلْبي بِسَلْوةِ حُبِّهِ","هَيْهَاتَ يُنْجِدُه وَأَنْتَ المُتْهِمُ",18,"م",1,0],["يا مُتبِع الزَّفراتِ إنَّك إن تُدِم","وَلَه الجزوعِ حُرِمتَ أجرَ الصّابِر",19,"ر",1,0],["يا مُتلِفي بَعضُ هَذا لَو قَنِعتَ بِهِ","يَكفيكَ فيَّ وَبَعضُ الهَجرِ يَكفيني",20,"ن",2,0],["يا مُتْلِعاً في النوالِ يُحْتَسَبُ ال","أتلعُ في النّيل عنده أَوقص",21,"ص",1,0],["يا متبعا كل يوم جود","بكور نعماه بالعشابا",22,"ا",3,0],["يا متبع الجدوى ولب","س وتبع جدواه منا",23,"ن",2,0],["يا متعال كل نقص وخسة","لدي إذا ألقيتني تحت خستي",24,"ي",1,0],["يا مُتهِمينَ عَسى أَن تُنجِدوا رَجُلاً","لَم يَسلُ عَنكُم وَلَم يُصبِح بِمُتَّهَمِ",25,"م",1,0],["يا متعب الأملاك بالسعي وقد","سار إلى العلياء سيراً رافقا",26,"ق",2,0],["يا متحف الفن الرفيع فتنتنا","وسحرت منّا أنفساً وعيونا",27,"ن",2,1],["يا متعبَ النفس في شدٍّ ومرتحل","والرزق يدركه في غير تغريب",28,"ب",1,0],["يا مُتْلِفِي بالهجرِ حَسْبُك ذا الجَفا","فالحبُّ يقتل والتَّجافِي يَسلُب",29,"ب",1,0],["يا متحفاً بالخوخِ أحبابه","أهلاً بهِ من مثلج للصدور",30,"ر",1,1],["يامترعَ الكاسات وهيَ سقاتها","وَالطَيرُ يهتاج الهَوى تغريدها",31,"د",3,0],["يا متكبرُ محيطُ ماجدُ","جُدْ لي بقدرٍ لا يَنال ساجدُ",32,"د",1,0],["يا متكلِّمُ ومنذرٌ مُعادْ","أصلحْ لنا الدنيا وأصلحِ المَعادْ",32,"د",1,0],["يا متوفِّ مبتلٍ ممتحنُ","تجيء ربي لعِدانا المِحَنُ",32,"ن",1,0],["يا متفضِّلُ منيلُ منعِمُ","اجعلْ حياتي رَغَداً أنعَّمُ",32,"م",1,0],["يا متعالي للبلاد وارثْ","بالغيث فابعثها لنا يا باعثْ",33,"ث",1,0],["يا متكبر يا خالق يا","باريء ما فيه صلاحي ارزق ليا",34,"ي",2,0],["يا متعالي أعلِ في الأنامِ","قدري بذي الجلالِ والإكرامِ",35,"م",1,0],["يا متعالي أعلِ قدري اغتنمْ","وأهلكن عداي أنت المنتقمْ",36,"م",1,0],["يا مَتحَفاً ما لي أَرى بِكَ وَحشة","وَأَرى فُؤادَك بِالفِراق تَكَلَّما",37,"م",2,0],["يا متُّ قَبلكَ حَتّى","مَتى يَكونُ رُكوبُك",38,"ك",1,1],["يا متلفى بصدوده رفقاً بمن","ببعادكم عن وصلكم قد عوّضا",39,"ض",2,0],["يا متلفى وهواه بين جوانحي","رفقاً بمضنى لا يطيق حراكا",40,"ك",2,0],["يا متى لم منك كفر نجاتي","كيف أقررت بي عيون الأعادي",41,"د",2,0],["يا متلفي ببعاده","عني أما خفت الرقيب",42,"ب",1,0],["يا متعَب الروح في دنيا تكابدها","متى ستبلغ من أحلامك الغرضا",43,"ض",2,0],["يامترفه لأهل الكبر مارغبنا","من يامن الحيه ومن يامن الداب",44,"ب",1,0],["يامتلفَ الروحِ ما أقسى تفرّقنا","لاباركَ الله فيمن خانَ أوباعَا!",45,"ع",2,0],["يا متعّبتني إتعِب لعينك اقدام","مرّات افك الصدر ,, مرّات ازرّه",46,"ر",2,0],["يا مُتْعِبَ النَّفْسِ فِي الآمالِ مُطَّلِباً","رِئاسَةً ما بِها ساعَفْنَ أَعْصُرُها",47,"ر",3,0],["يا مترفاً كالزهر لا بل أرقّ","أضنيت جفني سهراً بالأرق",48,"ق",1,1],["يا مترفه يا جاذبه يا جميله","يا فاتنه يا اطهر جهة من جهاتي",49,"ت",2,0],["يا مُتْعَبَ الرُّوحِ هل في الأُفْقِ بارِقَةٌ ؟","باللهِ قُلْ لي بهذا التِّيهِ ما العَمَلُ ؟",50,"ل",1,0],["يا متلف روحي تحملت الاثام","ما خفت من يوم تدور الدواير",51,"ر",1,1],["يا متعبي في الهوى، دنياك زاهية","صارت لها مُثُلٌ، فانساق جهّال",52,"ل",1,0],["يا مَتْحَفَ الحَشَراتِ، ما تُريدُ بِنا","جَلداً على دُبُرٍ، أمْ صَفْعَةَ القُبُلِ",53,"ل",1,0]]}