"خَلِيلَيَّ قُومَا فَاعْذِرَا أوْ تَعَتَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=17139",""],[90,"الأصيل في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179198",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"أول العهد","https://www.poetsgate.com/ViewPoem.aspx?id=179151",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[45,"أطلُبُ النّوْمَ كَيْ يَعودَ غِرَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31262",""],[45,"أنزاعا في الحب بعد نزوع","https://www.poetsgate.com/ViewPoem.aspx?id=2812",""],[80,"من شاء أن تسكر راحٌ براحْ","https://www.poetsgate.com/ViewPoem.aspx?id=3060",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[31,"ألم تسألِ الأطلالَ والمتربعا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18932&r=&rc=195",""],[31,"إعْتادني، بَعْدَ سَلْوَة ٍ، حَزَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19111&r=&rc=373",""],[88,"بدت كالشمس يحضنها الغروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19504&r=&rc=7",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[96,"الشّاطئ المهجور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66348&r=&rc=24",""],[92,"راعها منهُ صَمتُه ووجُومُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14597&r=&rc=42",""]],"verses":[["وَهَيهاتَ لَقَد أَغلَ","قَ دونَ الرِزقِ بابَينِ",0,"ن",1,0],["وَهَيهاتَ ما يُغني العَزيزَ تَعَزُّزٌ","فَيَبقى وَلا يُنجي الذَليلَ خُمولُ",1,"ل",1,0],["وَهَيهاتَ حالَت بَينَنا مُستَطيلَةً","ضَمومٌ عَلى الأَجرامِ مِن كُلِّ مَطلَعِ",2,"ع",1,0],["وَهَيهاتَ لَقَد طالَ","عَكَ الحَينُ مِنَ النَقبِ",3,"ب",1,0],["وهيَ تَسري روضَةً مطلولَةً","كَيفَ يُخفي نَشرَهُ الرَّوضُ النَّفوحُ",4,"ح",1,0],["وَهَيفاءَ إِن قامَت فَعاذَت بِخَصرِها","مِنَ الرِّدفِ قالَ المِرطُ لَيسَ يُعيذُ",5,"ذ",1,1],["وَهَيفاءَ نَشوى اللَّحظِ وَالقِدِّ وَالخُطا","غَذيَّةَ عَيشٍ في الشَّبيبَةِ صالِحِ",6,"ح",1,0],["وَهَيفاءَ لا أُصغي إِلى مَن يَلومُني","عَلَيها وَيُغريني بِها أَن يَعيبَها",7,"ب",3,1],["وهَيْبَةُ الكامِلِ الموفي على أمَدٍ","ما مَدّ طَرْفاً إِلى أدناهُ مفْتَخِرُ",8,"ر",1,0],["وَهَيهاتَ يَخفى ما أُكِنُّ مِنَ الهَوى","وَثَوبُ سِقامي كُلَّ يَومٍ يُجَدَّدُ",9,"د",1,0],["وَهَيَّأتِ القَطيعَةَ لي فَأَمسى","جَوابَ تَحيَتي مِنكِ السِبابُ",10,"ب",1,0],["وهِيَ العَقيلَةُ منْ قُرَيْشٍ أحْرَزَتْ","منْ مَنْصِبِ الشّرَفِ المُنيفِ حَليلا",11,"ل",2,0],["وَهِيَ النَّفْسُ إِذَا الْحَقُّ اجتلَتْ","جَرَّدَتْ كُلَّ حِجَابٍ وَنَضَتْ",12,"ت",1,0],["وَهِيَ الْبَدْرُ غَيْرَ أَنَّ عَفَافِي","طَابَ خُبْراً وَطَالَ فَضْلاً وًرُدْنَا",13,"ن",2,0],["وهيَ اللّيالي كلّما عثرَ امْرُؤٌ","يوْماً أبتْ منْ أنْ يقال عثارهُ",14,"ر",2,0],["وهيَ اللّيالي لاتزالُ صُروفُها","يَشْقى بموقِعِها الكَريمُ الماجِدُ",15,"د",1,0],["وَهيَ الْكَتَائِبُ إِنْ تُنُوسِي عَرْضُهَا","كَانَتْ مُدَوَّنَةً بِلاَ تَهْذيِبِ",16,"ب",1,0],["وَهيَ تَتلو رَخصَ العِظامِ ضَئيلاً","فاتِرَ الطَرفِ في قُواهُ اِنسِراقُ",17,"ق",1,0],["وَهيَ إِن تَقعُد نَقاً مِن عالِجٍ","وَإِذا قامَت نِيافاً كَالشَطَن",18,"ن",1,0],["وَهَيهاتَ يَأتي الحَيُّ لِلمَيتِ زائِراً","فَإِنّي رَأَيتُ الوُدَّ في الحَيِّ أُسقِما",19,"م",2,0],["وَهيَ في الحَربِ قَضاءٌ سابِحٌ","يَدَعُ الحِصنَ تِلالاً وَرِجاما",20,"م",2,0],["وَهيَ بُركانٌ إِذا ما هاجَها","هائِجُ الشَرِّ عِداءً وَخِصاما",20,"م",2,0],["وَهيَ وَالأَحداثُ تَستَهدِفُها","تَعشَقُ اللَهوَ وَتَهوى الطَرَبا",21,"ب",2,0],["وَهيَ حَربٌ عَلى البَخيلِ وَذي البَغ","يِ وَسَيفٌ عَلى رِقابِ اللِئامِ",22,"م",1,0],["وَهيَ ضَيفٌ أَصابَهُ عَنَتُ الدَه","رِ وَأَلفى هَذا الفَناءِ رَحيبا",23,"ب",2,0],["وَهيَ مَتى اِستَنتَجَت بَدا ذِكرٌ","وَأُختُهُ في الحَشا وَما تَسلَم",24,"م",1,0],["وَهِيَ الَّتِي وَطَأَتْ أكْنَافَ مَنْصِبِهِ","لَهُ وَأَذْنَتْ إِلَيْهِ أَرْفَعَ الرُّتَبِ",25,"ب",1,0],["وَهْيَ وَجْهُ العَفَافِ يَنْظُرُهَا الطَّرْ","فُ قَريراً وَإِنْ دَعَوْهَا بِفِتْنَهْ",26,"ن",2,0],["وَهَى بِهَا الرُّكُنُ الرَّكِينُ الَّذِي","مَا لَبِثَ الوَاجِبُ أَنْ أَوْهَنَهْ",27,"ن",2,0],["وَهْيَ الني أَبْنَاؤُهَا شُهُبٌ","عَنْ حَقِّ مِصْرٍ مَا بِهَا وَسَنُ",28,"ن",1,0],["وَهَيْهَاتِ فِيمَنْ عَاشَ بِرّاً بِأَهْلِهِ","أَبٌ عَاشَ بِرّاً مثْلُهُ وَقَرِينُ",29,"ن",1,0],["وَهَى الجَلَدُ البَاقِي بِهِ إِذْ تَرَحَّلَتْ","وَأَوْدَى أَسىً يَبْكِيهِ أَهْلٌ وَإِخْوَانُ",30,"ن",1,0],["وَهْيَ فِي يَوْمِنَا حِمَى آثَارِ","أَيُّهَا النَّائِبُونَ عَنَّا بَدَارِ",31,"ر",1,0],["وَهِي الهَمُّ وَالمُنَى وَهَوَى النَف","سِ إِذَا اعتَلَّ ذو هَوىً باعتِلاَلِ",32,"ل",1,0],["وَهَيفٌ تَهيجُ البَينُ بَعدَ تَجاوُرٍ","إِذا نَفَحَت مِن عَن يَمينِ المَشارِقِ",33,"ق",1,0],["وهي المنازل أشبهت سكانها","أعمارها تفضي إلى الآجالِ",34,"ل",1,0],["وهي أن أدبرت بهزّة ردف","أدبرت بالمرجرج المرجحنّ",35,"ن",1,0],["وهي غدت ممّا بها من خفر","محمرّةً من نظر مخجل",36,"ل",1,0],["وهي غدت من أجله جاثية","واحتضنته كاحتضان الفطيم",37,"م",1,0],["وهي في كل ذا تصيب الرمايا","مثلما طرفها يصيب القلوبا",38,"ب",2,0],["وهي التي كانت لهم قبل ذا","مادحةً حامدة شاكره",39,"ر",2,0],["وهي لعمري دون ما رِيبةٍ","منسوجة في مَنسَج الاغتصاب",40,"ب",1,0],["وهي التي تجلو النفوس فتَمتَلي","منها الوجوه تلألُؤاً وبريقا",41,"ق",2,0],["وهي التي بمذاقها ومشاقها","يُمسي الغليظ من الطباع رقيقا",41,"ق",2,0],["وهي تَعوِيذة له من عيون","بالمَساوي هَمّازة غَمّازه",42,"ز",2,0],["وهَي حبل الزواج ورقّ حتى","يكاد إذا نفختَ به يذوب",43,"ب",1,0],["وهي إن آنست من الخصم ضعفاً","كانت الليث مبرزاً أضراسه",44,"س",2,0],["وَهيَ إِذا ما اِستَصعَبَت لِلقادَه","صَرَّفَها الجوعُ عَلى الإِرادَه",45,"ه",1,0],["وهيَّجتَ أحزانِي على خيرِ صاحبٍ","لقيت الذي لاقاه يا خيرَ مصحوب",46,"ب",1,0],["وهيهات أن تحصى بتقدير مادحٍ","مناقبُ في الذكر الحكيم تقرّر",47,"ر",1,0],["وهيَّج عندي قرب خدِّي لخدِّها","بكى فتلاقى روضةٌ وغدير",48,"ر",1,0],["وهيهات أن ينجو الظلوم وخلفه","منصّلة أطرافها بدموع",49,"ع",1,0],["وهيج شوقي في الدجى صوت طائر","فقل في فصيح شاقه شوق أعجمي",50,"م",2,0],["وهيَّجوا يوم سلعٍ من بلابلنا","لما أمالوا من الأعطاف أغصانا",51,"ن",2,0],["وهيَ غمامٌ لمن تأمَّلها وطفا","سبحان من للعبادِ أرسلها لطفا",52,"ف",2,0],["وهيَ لا تألفُ إلاَّ بخلِّها","بهواها يا رسولي قلْ لها",53,"ه",2,0],["وهي خُرْسُ البيان من جهة النُّط","ق فصاحُ الآثار والأنباءِ",54,"ا",2,0],["وهْي مما أفاد تأديبُك الفا","ضلُ واهاً لذاك من تأديبِ",55,"ب",1,0],["وهي الشكرُ والمحامد تَنْثو","ها أقاويليَ الرِّصانُ الصُّيابُ",56,"ب",1,0],["وهْي على ما أظهرت من عُجْبِ","وتدَّعيه من شَجىً وحُبِّ",57,"ب",1,0],["وهْيَ أجْدَى عَلَيَّ إذ هي ظَهْرٌ","ومَنَاكٌ متى تمادى عُزُوبُ",58,"ب",1,0],["وهي رهن بذاك أو تفتديها","ذَات دَلٍّ لها قَناً خُرعُوبُ",58,"ب",1,0],["وهَيَّجَتِ الصَّبَا لمَّا تبدَّتْ","بريّاً منك في القلب الكئيبِ",59,"ب",1,0],["وهي في نسوةٍ حواسرِ لم يَكْ","حلنَ جفناً برقدةٍ لارتقابي",60,"ي",1,0],["وهْيَ من حَرِّ فَيشتي","تتلظَّى وتَلْهَثُ",61,"ث",1,0],["وهي تفدِّيه بالأب الأحمق ال","مائق والرُّهزُ طائرُ الشَّرر",62,"ر",1,0],["وهْي بخراءُ ذات فرجٍ رحيب","ذي فتوقٍ كثيرةٍ ودُروز",63,"ز",1,0],["وهي بحر الدجى أمالك عنها","شُغل في قَراحك المنزوز",63,"ز",1,0],["وهي تفديه منك بالنفس والما","لِ على رغم أنفك المحزوز",63,"ز",1,0],["وهي إذا أمَّتك أطلاقٌ ذُمُل","نوازعٌ لا يتَّرِعنَ للجُدُل",64,"ل",1,0],["وهي تختالُ بين بُرقعِ قبحٍ","وقميصٍ من الضَّنى والهزالِ",65,"ل",1,0],["وهي التي قد أقسمتْ","أن لا تُعَدَّ مع الحوائلْ",66,"ل",1,0],["وهْي قُرْبٌ وإنما أنا في الشَّيْ","ءِ وكيلٌ وأنت قاضي ذِمامِ",67,"م",1,0],["وهْيَ أنْثَى وما تثنَّت تمشَّى","قطُّ إلا بدا لعيني غُلام",68,"م",1,0],["وَهى خَرجُهُ وَاِستُجيلَ الرَبا","بُ عَنهُ وَغُرِّمَ ماءً صَريحا",69,"ح",2,0],["وَهيَ عِندَ الأُمِّ الَّتي اِختَرَمَ المَو","تُ بَنيها وَضَلَّ عَنها العَزاءُ",70,"ا",2,0],["وَهيَ عِندَ الفَقيرِ أَرضٌ وَراءَ ال","أُفقِ فيها ما يَشتَهي الفُقَراءُ",70,"ا",2,0],["وَهيَ عِندَ المَظلومِ أَرضٌ كَهَذي ال","أَرضِ لَكِن قَد شاعَ فيها الإِخاءُ",70,"ا",2,0],["وَهيَ عِندَ الخَليعِ أَرضٌ تَميسُ ال","حورُ فيها وَتَدفُقُ الصَهباءُ",70,"ا",2,0],["وَهِيَ في جِسمي دَمٌ يَسري فيه وَيَمورُ","إِنَّما مِن قَبلِ هَذا كَيفَ كانَت لَستُ أَدري",71,"ي",1,0],["وَهيَ في أَهوائِها لاهِيَةٌ","وَكَذاكَ الأُمَّةُ المُستَهتِرَه",72,"ر",2,0],["وَهيَ طَوراً عَلى الثَرى واقِعاتٌ","تَلقُطُ الحَبَّ أَو تُجَرُّ الذُيولا",73,"ل",2,0],["وَهيَ البَرقُ مِمّا حَمَلوهُ فَلَم يُطِق","يُحَدِّثُنا عَنهُ بِغَيرِ الأَشائِرِ",74,"ر",1,0],["وَهِيَ بِجُندِ الهَوى تُبارِزُني","وَأَيُّ صَبرٍ يُطيقُ هَيجاها",75,"ا",3,0],["وَهيفاءَ كَما تَهوى","تُريكَ القَدَّ وَالخَدّا",76,"د",2,0],["وَهَيفاءَ بَيضاءُ التَرائِبِ أَبصَرَت","مَشيبي فَأَبدَت رَوعَةً وَتَعَجُّبا",77,"ب",2,0],["وَهِيَّ إِذا قامَ في غَرزِها","كَمِثلِ السَفينَةِ أَو أَوقَرُ",78,"ر",1,0],["وهْي إنجيليَ الجَميلُ فصدِّقْ","هُ وإلاَّ فلِلغرامِ جَحِيمُهْ",79,"م",2,0],["وهي الأرض في السماء تضاهى","ذرة هاجتها رياح الموامى",80,"م",2,0],["وهي والشمس والتوابع يحكي","ن سفينا تجرى ببخر طامي",80,"م",2,0],["وهي المنون ينلن من أجسادها","من غير تعويض كفعل المبرد",81,"د",1,0],["وهي التي قد مثلت في الليل بالشهداء","بعد القتل والاجهاز",82,"ز",1,0],["وهي ليست اذا نظرت اليها","في جميع البقاع غير جهاد",83,"د",1,0],["وهي تحكي رنات ثكلى اصيبت","بوحيد لها كضوء النهار",84,"ر",1,0],["وهي ما زالت لنا محبوبة","لا نرى الفرقة منها هينا",85,"ن",2,0],["وهي شوهاء ولكن","عن هواها لا يتاب",86,"ب",1,0],["وَهِيَ لَما يَقتَرِحون أَجرى","وَهِيَ عَلى بَني النَبيّ أَجرا",87,"ر",2,0],["وَهيَ تَقولُ لِأَبي","بِلَهجَةِ المُؤَنِّبِ",88,"ب",1,0],["وَهيَ تَقولُ يا جَمالَ العُشِّ","لا تَعتَمِد عَلى الجَناحِ الهَشِّ",89,"ش",1,0],["وَهَيهاتَ ما تُوِّجوا بِالسَنا","وَلا عَرشُهُم كانَ فَوقَ السُحُب",90,"ب",1,0],["وَهيَ هَهُنا وَهُنا","تَلتَقي وَتَصطَحِبُ",91,"ب",1,0],["وَهيَ بَينَنا سَلَبٌ","وَالنُهى لَها سَلَبُ",91,"ب",1,0],["وَهيَ مَعشوقَةٌ عَلى الغَدرِ لا تَح","فَظُ عَهداً وَلا تُتَمِّمُ وَصلاً",92,"ل",2,0],["وهي التي تغلظ فيها القوى","ويستفاد اللون والصبغة",93,"غ",2,0],["وهي النجوم التي إن كنّ ناقصة","ضاعت فلم تغن أعمال وأيام",94,"م",1,0],["وهي عطاء الله للأبرارِ","تنجيهمُ من فقر هذي الدار",95,"ر",1,0],["وهي إذا أحكمت طبائعها","ملك عزيز الوجود جبارُ",96,"ر",1,0],["وهيكلنا المقدس فيه روح","وجسم والقرين مع القرينِ",97,"ن",1,0],["وهي المقر لسرنا ال","مكتوم والمستودعُ",98,"ع",1,0],["وَهيَ القَوافي ما تَقِرُّ ثَوابِتاً","لِمُمَدَّحٍ حَتّى تَعيرَ شَوارِدا",99,"د",2,0],["وَهِيَ مَوقوفَةٌ إِلى أَن يُوافي","غائِبٌ ما وَفى بِهِ الحُضّارُ",100,"ر",1,0],["وَهيَ القَوافي إِذا سارَت هَوىً صُغرا","قَدرُ الدَراهِمِ عَنها وَالدَنانيرُ",101,"ر",1,0],["وَهَيَّجَ شَوقي ساقُ حُرٍّ أَجابَهُ","هَديلٌ عَلى غُصنٍ مِنَ البانِ أَفرَعا",102,"ع",2,0],["وَهيَ المَآثِرُ لَيسَ يَبنى مِثلَها","بانٍ وَلا يَسمو إِلى تَحويلِها",103,"ل",3,0],["وَهيَ السِياسَةُ لَم تَزَل مَعروفَةً","لِذَوي السِياسَةِ مِن بَني خاقانِ",104,"ن",1,0],["وَهيَ الوَديعَةُ لا يُؤَمَّلُ حِفظُها","حَتّى تَصِحَّ حَفيظَةُ المُستَودَعِ",105,"ع",1,0],["وَهيَ العيسُ دَهرَها في اِرتِحالٍ","مِن حولولٍ أَو فُرقَةٍ مِن جَميعِ",106,"ع",1,0],["وَهَيَّجَني ضَنّي بِبَكرٍ عَلى الَّذي","نَطَقتُ وَما غَيبي لِبَكرٍ بِمُتهَمِ",107,"م",1,0],["وَهيجا إِذا نامَ الخَلِيُّ وَأَسعِدا","عَلَيهِ بِنَوحٍ مِنكُما كُلَّ مَأتَمِ",108,"م",1,0],["وهي وإن لم تَذُق طَعاماً","مملوءةُ البَطنِ من طَعامِ",109,"م",1,0],["وَهي الشُموسُ فإنْ رأينَ طَوالِعا","يَضحكْنَ في الفَودَين عُدن أوافِلا",110,"ل",2,1],["وهي أوتارُنا القديمةُ لا تُخ","رِجُ أوتارَنا من الأَفواقِ",111,"ق",1,0],["وهيَّجَ من وَجدي حنينُ ابنِ قينةٍ","إذا استَنطَقَتْه بالأناملِ زمجرَا",112,"ر",2,0],["وهي وَقُودُ النَّارِ يومَ المّحشَرِ","لانتَهَبَت ظَهرَ الصَفا والمَشعَرِ",113,"ر",1,0],["وَهِيَ السَبيلُ فَخُذ لِذَلِكَ عُدَّةً","فَكَأَنَّ يَومَكَ عَن قَريبٍ قَد أَتى",114,"ا",1,0],["وَهِيَ المُنغَصِّةَ السُرو","رِ وَإِن زَهاكَ أَنيقُها",115,"ق",3,0],["وهيج لي شوقا وما كان كامنا","وأذكرني عهدا وما كنت ناسيا",116,"ي",2,0],["وَهى جَلَدي إِن كانَ أَضمَرَ خاطِري","سُلُوّاً وَلَو أَنّي قَضَيتُ مِنَ البَلوى",117,"و",2,0],["وَهَيفاءُ لَو أَهدَت إِلى المَيِّتِ نَشرَها","لَأُنشِرَ مَن ضُمَّت عَلَيهِ الصَفائِحُ",118,"ح",1,0],["وَهَيتُ وخانني جَلَدِي وإلا","فهذي الدمعةُ الحرَّى علاما",119,"م",2,0],["وهي لو تَملِك كفّاً صافحت","كفَّكِ الغَضَّةَ في كلِّ مساء",120,"ا",2,0],["وهي لو تملك كفا صافحت","كفك الحلوة في كل مساء",121,"ا",2,0],["وهي لو تملك جوداً بذلت","كل ما تملك كف من سخاء",121,"ا",2,0],["وهي في الطرس قصة تذكر الأحباب فيها وتحشد الأنباء","صدفة ثم وقفة فاتفاق فاشتياق فموعد فلقاء",122,"ا",2,0],["وهي في كَرّها عساكُر حرْبٍ","غُرَّ مَنْ ظنّها عساكرَ سلمِ",123,"م",1,0],["وهي من العفة لم تَدْرِ مَنْ","جُنّ بها دونَ الغواني وهام",124,"م",1,0],["وهي لمياءُ تمنعُ الريقَ صوناً","وتروّي السواكَ منه برغمي",125,"ي",1,0],["وهيَ لا تَستَبي بِلَفظٍ رَخيمٍ","يُنزِلُ العُصْمَ وهيَ في الطود فُورُ",126,"ر",1,0],["وهَيجاءُ لا يُفْشي بها الموتُ سرّهُ","إِذا لَم يَكُن بِالضَّرب من بيضها جَهْرُ",127,"ر",1,0],["وهي ياقوتةٌ تُبَرْقعُ خدّاً","من جُمانٍ منظَّم بِعِجارِ",128,"ر",1,0],["وهيَ مِن عُجْبٍ وَمِن تيهٍ لَها","كبدٌ تُرحمُ منها كبدي",129,"د",2,0],["وهيَ نَجلاءُ حَكاها سِعَةً","جُرحُها في كُلِّ قَلبٍ مكمَدِ",129,"د",1,0],["وهي جَمُوحٌ كُلّما أُلْجِمَتْ","بالماءِ كَفّتْ من غلوّ الجماح",130,"ح",1,0],["وَهيَ نَزرٌ لَو أَنَّها مِن دُموعِ ال","صبِّ لَم تَشفِ مِنهُ حَرَّ الغَليلِ",131,"ل",1,0],["وَهيَ لا عَقدُ وُدِّها ساعَةَ البَي","نِ وَلا عَقدُ خَصرِها بِوَثيقِ",132,"ق",1,0],["وَهِيَ كَالظَبيَةِ النَوارِ وَلَكِن","رُبَّما أَمكَنَت جَناةُ السَحوقِ",132,"ق",1,0],["وَهِيَ الحَوادِثُ لَم تَزَل نَكَباتُها","يَألَفنَ رَبعَ المَنزِلِ المَألوفا",133,"ف",2,0],["وَهَيهاتَ ما رَيبُ الزَمانِ بِمُخلِدٍ","غَريباً وَلا رَيبُ الزَمانِ بِخالِدِ",134,"د",1,0],["وَهيَ أَهلُ الصَفاءِ وَالوِدِّ مِنّي","وَإِلَيها الهَوى فَلا تَعذُلاني",135,"ي",1,0],["وَهيَ لَنا بِالوِصالِ طَيِّبَةُ ال","نَفسِ وَرَبّي بِها قَدِ اِغرَمَني",136,"ن",2,0],["وَهيَ إِن شِئتَ تَسيرُ نَحوَنا","لَو تُريدُ الوَصلَ أَو تُعقَلَ عَن",137,"ن",1,0],["وَهيَ فينا فَلا تُبا","ليهِ تُلحى وَتَعذَلُ",138,"ل",1,0],["وَهيَ كَالشَمسِ إِذ بَدَت في ضُحاها","فَأَبانَت لِلناظِرينَ طُلوعا",139,"ع",2,0],["وَهَيَّجتَ قَلباً كانَ قَد وَدَّعَ الصِبا","وَأَشياعَهُ فَاِشفَع عَسى أَن تُشَفَّعا",140,"ع",2,0],["وَهِيَ الَّتي لَما مَرَرتُ بِها","في الطَوفِ بَينَ الرُكنِ وَالحِجرِ",141,"ر",1,0],["وَهيَ مَكنونَةٌ تَحَيَّرَ مِنها","في أَديمِ الخَدَّينِ ماءُ الشَبابِ",142,"ب",1,0],["وَهيَ إِذ ذاكَ عَلَيها مِئزَرٌ","وَلَها بَيتُ جَوارٌ مِن لُعَب",143,"ب",1,0],["وَهَيهاتَ لا أَغنى خَليلٌ غِناءَهُ","وَهَل عَدَلَ العَذبَ الفُراتَ سَرابُ",144,"ب",1,0],["وَهَيهاتَ أَن أَسلو مِنَ الحُزنِ وَالهَوى","وَهَذا قَميصي مِن جَوى البَينِ بالِيا",145,"ي",2,0],["وهي عَيْنٌ من حَياةٍ عَذبةٍ","في يَفاعِ من سناءٍ مُشرقِ",146,"ق",1,0],["وَهى عَزمُه ما يُطيقُ الحِراكَ","وَقَد كانَ كالليثِ في وَثبتِه",147,"ت",2,0],["وَهَى منه الأديمُ فلا أديمٌ","وأعوزه الإهابُ فلا إهاب",148,"ب",1,0],["وَهيَ الكَواكِبُ تَعنو","لِحُسنِهِ وَبَهائِهِ",149,"ه",1,0],["وَهَيَ من عُنصر الفِدَا","ء ومن جوْهر الكرم",150,"م",1,0],["وَهِيَ تَستَأنف الجِهادَ بَعَزمٍ","كُلَّ يَومٍ إِذا النَهار تَعالى",151,"ل",2,0],["وَهِيَ العَداوَةُ لا خَفاءِ بِها","كَالشَمسِ تَكسُفُ ساعَةَ الدَجنِ",152,"ن",1,0],["وَهيَ عِندي لا ذا وَلا ذا وَهَذا","هِيَ سَعدٌ قَد فارَقَتهُ النُحوسُ",153,"س",1,0],["وهي الأقاصي من ثُغور المُلك لا","تُخشَى مخاوِفُها وأنتَ أمانُها",154,"ن",3,0],["وهي البخِيلةُ أو خَيَالٌ طارقٌ","منها أو الذكرى التي تَتَخيَّل",155,"ل",1,0],["وهي الجرائمُ والرّغائبُ ما التَقَتْ","إلاّ لِتَصْفَحَ قادِراً وتُنِيلا",156,"ل",2,0],["وهي شُمُّ الأنوفِ يَشمَخن كِبْراً","ثمّ يَرْعُفْنَ بالدّمِ المُهراق",157,"ق",1,0],["وَهيَ الأيّامُ لا يأمَنُهَا","حازمٌ يأخُذُ من يومٍ لِغَد",158,"د",1,0],["وهْيَ في ظِلّ أراكٍ مائِدٍ","تَرتَدي المَرْدَ إذا ذابَ الوَمَد",158,"د",1,0],["وهيَ تَعْطوهُ على خوْفٍ كمَا","مَدَّ رَقّاءٌ إلى الأرْقَمِ يَدْ",158,"د",1,0],["وهَيهاتَ ما طَلَبتُ","وَهَيهاتَ ما اِبتَغَيت",159,"ت",1,0],["وَهيَ رَواقٍ بِالبِساطِ الأَفيَح","وَمِتيَحاتٌ لِلَّحاقِ مُتيحِ",160,"ح",1,0],["وَهيَ في ذاكَ مِنِ إِبرا","هيمَ تَستَشفِئُ خالا",161,"ل",2,0],["وهي في كدٍّ وكدح دائبٍ","لا تشكى من عياءٍ وعنَن",162,"ن",1,0],["وهَيجَ يوم كُلابٍ","وفعلَ زيدٍ بحجّر",163,"ر",1,0],["وَهَيهاتَ ظَنُّ الجاهِلينَ مِن اِمرِىءٍ","بَعيدِ الرِضى سُقمٍ عَلى مَن تَحَزَّبا",164,"ب",2,0],["وَهِيَ النُفوسُ إِذا تُمَيِّزُ بَينَها","فَأَعَزُّها في العَيشِ مُقتَنِعاتُها",165,"ت",3,0],["وَهيَ تُقَفِّي بِالرَدى دَرَّها","كَما تَقَفَّت بِالرَدى بُختَها",166,"ت",3,0],["وَهَينَم وَالظَلامُ عَلَيكَ داجٍ","لَدى وُرقٍ سُمِعنَ مُهَينَماتِ",167,"ت",1,0],["وَهِيَ القَتيلَةُ لَم تُؤذَّ بِقَتلِها","أَصَمتَكِ مِن عُرُضٍ وَما أَصمَيتِها",168,"ت",3,0],["وَهَيَّجَها قَولٌ يُقالُ عَنِ الحِمى","وَذاكَ حَديثٌ ما مُحَدِّثُهُ ثَبَتُ",169,"ت",1,0],["وَهيَ الحَوادِثُ عُوَّذٌ وَلَواقِحٌ","وَشَوائِلٌ وَحَوائِلٌ وَعِشارُ",170,"ر",1,0],["وَهِيَ الحَياةُ فَعِفَّةٌ أَو فِتنَةٌ","ثُمَّ المَماتُ فَجَنَّةٌ أَو نارُ",171,"ر",1,0],["وَهيَ المَقاديرُ فَذا حَتفُهُ","قَيظٌ وَذا ميتَتُهُ قُرُّ",172,"ر",1,0],["وَهِيَ الدُنِّيا أَذاها أَبَداً","زُمَرٌ وارِدَةٌ إِثرَ زُمَر",173,"ر",1,0],["وَهيَ المَقاديرُ لا يَغبِطُ بِحِليَتِهِ","جيدَ الحَمامَةِ جيدٌ غَيرُهُ عَطِلا",174,"ل",2,0],["وَهيَ رومِيَّةٌ لِزِنجِيَّةِ الأَع","نابِ فيها طَعمٌ مِنَ الزَنجَبيلِ",175,"ل",1,0],["وَهيَ السَعادَةُ لِلحِجرَينِ مائِزَةٌ","مَغنى ثَمودٍ وَحِجرُ البَيتِ وَالحَرَمِ",176,"م",1,0],["وَهَيهاتَ لَو حَلَّت لَما كُنتُ شارِباً","مُخَفَّفَةً في الحِلمِ كِفَّةَ ميزاني",177,"ي",1,0],["وَهَيهاتَ ما تَنفَكُّ وَلهانَ مُغرَماً","بِوَرهاءَ لا تُعطي الصَفاءَ مُصافيها",178,"ي",3,0],["وَهَيهاتَ البَريَّةُ في ضِلالٍ","وَقَد فَطَنَ اللَبيبُ لِما اِعتَراها",179,"ا",3,0],["وهي مثل النار التي تتلظى","ولها مثلما لهذي زفير",180,"ر",1,0],["وَهيَ في عالم المَجَرَّة فاِعلَم","قدر صاغر من الأقدار",181,"ر",1,0],["وهي في سالف الزمان بلاد","عامرات الأكناف مرتقيات",182,"ت",1,0],["وَهيَ تنحل في العَناصر بالبط","ءِ إلى قوة بلا اِستثناء",183,"ا",2,0],["وَهيَ مثل الغَزال تشدو وَرائي","ببغام له فؤادي يطرب",184,"ب",1,0],["وهي التي زانت مَشي","بي بأكاليلِ الصّبا",185,"ب",2,0],["وهي التي قد علَّمت","ني حين ألقَى النُّوَبا",185,"ب",2,0],["وهي التي تهتِكُ سِت","ر القلب مهما انتقبا",185,"ب",2,0],["وهي مغدَى السفينِ والدُّبِّ لا مغ","دى نياقِ الفلا وذئبِ الفيافي",186,"ف",2,0],["وهيهات تشفي غُلَّةً من دمائنا","ويا ليتَ ترويها الدموعُ الذوارفُ",187,"ف",1,0],["وهي في ميعةِ الصَّبا يزدهيها","ضَحكٌ لا تملّه ومزاحُ",188,"ح",1,0],["وهي مأساةُ حبِّهِ صورتها","ريشةُ الليلِ مبدع التصويرِ",189,"ر",1,0],["وَهيَ تَزوَرُّ كَالجَوادِ إِذا ما","ساقَهُ لِلطِعانِ نَدبٌ جَسورُ",190,"ر",1,0],["وهْيَ أُخْتُ الجُرازِ تَدعو ويدعو","والِداً ما استعانَ إلاّ سَعيرا",191,"ر",2,0],["وهْيَ بيضاءُ مثْلَما أوْدَعَ الصّيْ","فُ حِمى الوَهْدِ نُطْفَةَ الشّؤبوبِ",192,"ب",1,0],["وَهْيَ إذا المَوْتُ بَدا مُعْلَماً","نِعْمَ دِثارُ الفارِسِ المُعْلَم",193,"م",1,0],["وهيهات هيهات الجبال صوامت","وهذا كثير النطق جم الصواهل",194,"ل",1,0],["وهي تموج بجموع قيصرا","وعالم من عرب تنصرا",195,"ر",2,0],["وَهيَ تُذري مِن خيفَةِ البُعدِ دَمعاً","مُستَهِلّاً بِلَوعَةٍ وَسُهادِ",196,"د",1,0],["وَهْيَ إِنْ سَرَتْ","فِي الْعَلِيلِ صَحْ",197,"ح",1,0],["وَهَيْهَاتَ مَا بَعْدَ الشَّبِيبَةِ مَوْسِمٌ","يَطِيبُ وَلا بَعْدَ الْجَزِيرَةِ مَعْهَدُ",198,"د",1,0],["وَهْيَ حُسْنُ الحَيَاةِ سَعْداً وَبُؤْساً","وَاصْطِبَاحاً لِشَرْبِهَا وَغَبُوقَا",199,"ق",2,0],["وَهْيَ لَيْسَتْ عَلى التحَوُّلِ إِلاَّ","لَمَعَات مَآبُهَا الدَّيْجُورُ",200,"ر",1,0],["وَهَيَّأتَ فِتْياناً يُدِيلُونَ لِلْحِمَى","إِبَاءً وَعِزَّاً مِنْ هَوَانٍ وَمِنْ ذُلِّ",201,"ل",1,0],["وَهِيَ الَّتِي لوْ قُسِّمَتْ لَنَمَا بِهَا","شَعْبٌ يَعِزُّ بِنَفْسِهِ مُسْتَنْصِفَا",202,"ف",2,0],["وَهَيَّا يَا أَمِينَ الْخَيْرِ","طَالَ لَدَيْكُمَا أَسْرِي",203,"ر",2,0],["وَهَيْهَاتَ أَنْ عَانى مَلِيكٌ وَأَمَة","عَناءِهِمْ مِنْ ضَنْكِ عَيْشٍ وَمِنْ ضُرِّ",204,"ر",1,0],["وَهْيَ خَفْقُ اللِّوَاءِ يَحْدُوهُ مِنْ إِي","قَاعِ أَبْطَالِهِ إِلى المَجْدِ حَادِي",205,"د",2,0],["وَهْيَ بَيْنَ الْغُصُونِ نَسْجٌ دَقِيقٌ","مِنْ نُضَارٍ يَشِفُّ عَنْ لاَزوَرْدِ",206,"د",1,0],["وَهْيَ الَّتِي مَا زَالَ أَغْلَى إِرْثِهَا","مِنْ خَالِدِ الأَلْوَانِ وَالأَشْكَالِ",207,"ل",1,0],["وهَيْهَاتَ أَنْ يُوفَى بِشِعْرٍ جَمِيلُهُ","وَلَوْ كَانَ دِيوَاناً لَقَلَّ وَفَاءَ",208,"ا",2,0],["وَهِيَ القُبْلَةُ فِي مَرْشَفِ مَنْ","شَاقَهُ لَثْمُ حَبِيبٍ هَجَرَا",209,"ر",2,0],["وَهِيَ النَّفْحَةُ يَسْتَشْفِي بِهَا","مَن تَلَظَّى وَجْدُهُ مُستَعِرَا",209,"ر",2,0],["وَهِيَ التُّحْفَةُ فِي العُرْسِ لِمَنْ","آثَرَ المَهْرَ الأَحَبَّ الأَطْهَرَا",209,"ر",2,0],["وَهُيَامُ أَرْوَاحٍ تُحِسُّ بِهِ","مَا لاَ تُحِسُّ جُسُومُ أَشْهَادِ",210,"د",1,0],["وَهْيَ هَيْفَاءُ كَاعِبٌ زَهْرَاءُ","لِيَدِ اللهِ مَظْهَرٌ وُضَّاءُ",211,"ا",2,0],["وَهْيَ سُلْطَانَةٌ عَلَيْكُمْ تَوَلَّتْ","وَهْيَ فِي يَوْمِهَا عَرُوسٌ تَجَلَّتْ",211,"ت",1,0],["وَهَيِّأَ فِي الحِمَى عَيْشاً رَغِيداً","لَقَوْمٍ كَانَ حِلْفَهُمْ الشَّقَاءُ",212,"ا",2,0],["وهي تملي عليّ فسي الحب درسا","كيف أنسى",213,"ا",1,0],["وَهَيجُ التَناهي وَاِطِّرادٌ مِنَ السَفا","وَتَشلالُ مَخطوفِ الحَشا مُتَجانِفِ",214,"ف",1,0],["وَهيَ القِيامَةُ قامَت","فَعِبرَةٌ وَاِعتِبارُ",215,"ر",1,0],["وهي ترجو لا بل تريدُ وأَجْدِرْ","بابنةِ النيلِ وَحْدها أنْ تُريدا",216,"د",2,0],["وهي تلهو به فآناً تُجافِيهِ","وآناً تُمْلِي له فَتُداني",217,"ن",2,0],["وهي المشاكل كلها وجدتْ لها","في عهدك الزاهي السعيد حلولا",218,"ل",2,0],["وهي الحنيفة: دين كلِّ حضارة","وعدالة، وهداية، ورشاد",219,"د",1,0],["وهْيَ الحضارة أمُّ أنجبته، وما","زالت - كمريم ذات الطهرَ عذراء",220,"ا",2,0],["وهي الحضارةُ؛ كم علي","ها للحنيفة من مآثر",221,"ر",1,0],["وهي الجراح إذا اندملْنَ فإنما","يتركْنَ في جسد الريح ندوبا",222,"ب",2,0],["وهي السعادة، كم أوت كوخًا، وكم","هجرت أشمَّ من القصور رحيبا",223,"ب",2,0],["وهي العقيلة من قريش أحرزت","من منصب الشرف المنيف جليلا",224,"ل",2,0],["وهيهات أين البدر منك إذا بدا","وكيف يجوز اللبس والفرق ظاهر",225,"ر",1,0],["وهيى الليالي لا تزال صروفها","يشقى بموقعها الكريم الماجد",226,"د",1,0],["وهيهات من للشمس منك بمشبه","كمال بلا نقص ونفع بلا ضر",227,"ر",1,0],["وهي في خاطري وأشكو نواها","وأقاسي ظلم الهوى والتجنّي",228,"ن",2,0],["وهيهات ظنُّ الجاهلين من امرئٍ","بَعيدِ الرِّضى سُقْمٍ علَى منْ تحزَّبا",229,"ب",2,0],["وهيمنَ رَوحٌ من جِمام ورقةٍ","على الشاطئين استيقظا فتوثّبا",230,"ب",2,0],["وهي ذي الحفرة إذ طارت عَجاجاً","الفُ نفسٍ معها طارت فداء",231,"ا",2,0],["وهي ما كانت لتدلي سببا","لك ، لولا أنها كانت بَراء",231,"ا",2,0],["وهيَ سمراءُ في التقاطيع منها","يجِدُ الحالمونَ شِبعاً ورِيّا",232,"ي",2,0],["وهيمَنَ إرهابٌ على كل خَطرةٍ","تَرَدَّدُ ما بين اللَّهى والحناجر",233,"ر",1,0],["وهيهاتَ لا تدركين المنى","بسيرِ أخي مَهَلٍ مُقْصِد",234,"د",1,0],["وهي في الحالتين فِتنةُ راءٍ","بينَ لونينِ من مُشِعٍّ وخابي",235,"ب",2,0],["وَهيَ في حِلْيَةِ الشّبابِ يضَاهي","جِدّةَ الرّوْضِ، مُشرِقاً نُوّارُهْ",236,"ر",2,0],["وَهيَ العِيسُ، دَهرَها، في ارْتحالٍ","مِنْ حلولٍ، أوْ فُرْقةٍ من جَميع",237,"ع",1,0],["وهي جموحٌ كلّما ألجمت","بالماء كفّتْ من علو الجماح",238,"ح",1,0],["وهي إن نابها الأذى فتمادى","لم يطل للايلاف منها الشكاة",239,"ه",1,0],["وَهَيَّجْتَ قَلْباً كَانَ قَدْ وَدَّعَ الصِّبا","وأَشْيَاعَهُ فَکشْفعْ عَسَى أَنْ تُشَفَّعا",240,"ع",2,0],["وَهْيَ لَنَا بِکلوِصَالِ طَيِّبَة ُ النَّ","س، وربي بها قد اغرمني",241,"ن",2,0],["وهي حبلُ الزواج ورقَّ حتى","يكاد اذا نفخت له يذوب",242,"ب",1,0],["وهي في كل ذا تصيب الرمايا","مثلما طرفها يصيب القلويا",243,"ي",2,0],["وهي مأساة حبّه صوّرتها","ريشة اللّيل المبدع التّصوير",244,"ر",1,0],["وهي إنجيليَ الجميلُ، فصدُّقه","ه وإلاّ..، فلِلغرامِ جَحِيمُهْ..»",245,"م",2,0]]}