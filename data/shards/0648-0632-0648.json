=191005",""],[5431,"جوارح معتلة...","https://www.poetsgate.com/ViewPoem.aspx?id=208901",""],[5526,"الصبر والياس","https://www.poetsgate.com/ViewPoem.aspx?id=198261",""],[5582,"تَوَلَّى الشَّبابُ وَقَدْ أَدْبَرا","https://www.poetsgate.com/ViewPoem.aspx?id=187104",""],[5582,"قِفا وَاَسْعِدانِي كَيْ نُحَيِّي المَنازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=187238",""],[5605,"هذي المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=159788",""],[5664,"دعوة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=46525",""],[5725,"الى الحلاج","https://www.poetsgate.com/ViewPoem.aspx?id=201834",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[5956,"وحيد","https://www.poetsgate.com/ViewPoem.aspx?id=185444",""],[6031,"بكيتُكِ لو أنّ الدموع تُديلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46287",""],[6093,"تمويه","https://www.poetsgate.com/ViewPoem.aspx?id=200186",""],[6127,"ناي الكآبات","https://www.poetsgate.com/ViewPoem.aspx?id=207517",""],[6225,"زارعات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81312&r=&rc=339",""],[6237,"تأملي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77902&r=&rc=44",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[6320,"بَلْسَمُ الرُّوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84332&r=&rc=29",""]],"verses":[["وَزَوالُ مُلكٍ لَم يَكُن","يَوماً يُقَدَّرُ أَن يَزولا",0,"ل",2,0],["وَزورُ المَآقي مِن جَديلٍ وَشَدقَمِ","تَبَلَّدَ عَنها شَدقَمٌ وَجَديلُ",1,"ل",1,0],["وَزَورٍ مِنَ الأَضغانِ نَحوي كَأَنَّما","يُلاقيهِمُ شَخصي لِقاءَ المُحارِبِ",2,"ب",1,0],["وَزَوْرٍ أَتَى وَاللَّيْلُ يَحْدُو رِكابَهُ","وَما لِقِلاصِ النَّجْمِ فيهِ مُنيخُ",3,"خ",1,1],["وزَوْرَةِ حِبٍّ على غَفلَةٍ","ووصْلٍ ألَمّ برَبْع الصَّدودْ",4,"د",1,0],["وَزَوراً تَرى في مِرفَقَيهِ تَجانُفاً","نَبيلاً كَبَيتِ الصَيدَلانِيِّ دامِكا",5,"ك",2,0],["وَزَوِّدهُ عَنّا بِالكَرامَةِ كُلِّها","وَإِن لَم يَكُن بِالباقِياتِ مُزَوَّدا",6,"د",2,0],["وزورة لمعاني طيبة اقْتبلت","وللصباح بلا شكٍّ تباشير",7,"ر",1,0],["وَزَوجَةٍ عَلَّمتُها لخِيانَه","وَوالِدٍ أَنسَيتُهُ الأَمانَه",8,"ه",1,0],["وَزَوَّدَ خَيراً مالِكاً إِنَّ مالِكاً","لَهُ رِدَّةٌ فينا إِذا القَومُ زُهَّدُ",9,"د",1,0],["وَزَوجَتُهُ قَد عَشا بَظرُها","عَلى كَبرَةٍ وَاِبنُهُ قَد عَلُج",10,"ج",1,0],["وَزَورِ خَيالٍ بَعدَ وَهنٍ أَلَمَّ بي","وَأَحشاؤُهُ مِن فَرطِ خيفَتِهِ تَهفو",11,"ف",2,0],["وَزَورٍ أَتاني طارِقاً فَحَسِبتُهُ","خَيالاً أَتى مِن آخِرِ اللَيلِ يَطرُقُ",12,"ق",1,0],["وَزَوراءَ أَدنى ما بِها الخِمسُ لا تَرى","بِها العيسُ لَو حَلَّت بِها مُتَعَلَّلا",13,"ل",2,0],["وَزَوِّج بِماءِ الحَيا السَلسَلِ","عَروساً مِنَ الخَمرِ",14,"ر",1,0],["وَزُوّارُهُ لِلعَطايا حُضورٌ","كَأَنَّ حُضورَهُمُ لِلعَطاءِ",15,"ا",2,0],["وزوجٌ ذو مُحافَظةٍ نَجِيبٌ","يَفِيءُ إلى ذُرَى النَّسَبِ النَّجِيبِ",16,"ب",1,0],["وَزَوالِ ما بِكَ لَيسَ فيهِ مَرِيَّةٌ","إِن عادَكَ اللَهَبيُّ في العُوّادِ",17,"د",1,0],["وَزَوجُكِ أَيُّها الدُنِّيا تَمَنّى","طَلاقَكِ قَبلَ أَن يَقَعَ المَسيسُ",18,"س",1,0],["وَزَوجُ الكِلابِيَّةِ الكاسِكِيُّ","وَعِرسُ الكِلابِيِّ كُردِيَّه",19,"د",3,0],["وَزَوْجُ بِنْتِ الْحَبِيبِ مَاذَا","يَكُونُ غَيرَ ابْنِنَا الحَبِيبِ",20,"ب",1,0],["وَزَوْجِهِ ذَاتَ الحُلِيِّ","الكَاسِفَاتِ لِلْحُلِي",21,"ل",2,0],["وَزَوْجِهِ ذَاتِ النُّهَى وَالطُّهْرِ","بِنْتِ الوَزِيرِ الأَلْمَعِيِّ الحُرِّ",22,"ر",1,0],["وزوجةُ ابنِ العَصَبِ المحكَّر","وهي وَقُودُ النَّارِ يومَ المّحشَرِ",23,"ر",1,0],["وَزَوْرَة ٍ مِنْ حَبِيبٍ طَالَ مَا هَجَرَا","هَيْهَاتَ مَيَّة ُ مِنْ رَكْبٍ عَلَى قُلُصٍ",24,"ص",1,0],["وزوجةٍ ألبسها المصابا","تسفى على واضحها الترابا",25,"ب",2,0],["وَزَوَتني عَنهُ مَواهِبُ مَلكٍ","جَلَّ عَن أَن يُهَزَّ أَو يُستَزادا",26,"د",2,0],["وزوجة الآخر لم تفسخ ولم","تأت بأمر موجب لفرقته",27,"ت",2,0],["وَزَوَّدَهُ صِدقاً وَبِرّاً وَنائِلاً","وَما كانَ في تِلكَ الوِفادَةِ مِن حَمدِ",28,"د",1,0],["وزوال النعيم صيرنا","لضروب الارزاء نحتمل",29,"ل",1,0],["وزوجه الهادي ابنتيه كرامةً","ولو كنّ عشراً لم يكن بعد يمنع",30,"ع",1,0],["وَزَوراءِ العِراقِ وَأَرضِ طوسٍ","سَقاها الغَيثُ مِن بَلَدٍ قَصِيِّ",31,"ي",1,0],["وَزَوَّدتَني قُبَلاً لِلوَداعِ","بِأَبرَدِها وَهيَ في القَلبِ جَمرُ",32,"ر",1,0],["وزودي جفني طيف الكرى","فليس بعد اليوم من نوم",33,"م",1,0],["وَزوّدوا القلب هما لا اِنقطاع له","وَبدلوا جثَتي بالصحة السقما",34,"م",2,0],["وَزوروا شعبها فَعَلى فؤادي","وَقَلبي من نسيمه برود",35,"د",1,0],["وَزورا بلودانَ المَنيفَةَ تَظفَرا","بِعَيشٍ هَنيءٍ رَبعُهُ غَيرُ ماحِلِ",36,"ل",1,0],["وزوج خير نساء العالمين أبي ال","سبطين صنو النبي المصطفى الطهر",37,"ر",1,0],["وَزورنا المَعروفَ مِن جِبريلِ","فَما لَهُ في الرزءِ مِن عَديلِ",38,"ل",1,0],["وَزَوجا رِماحٍ خَلفَ فَردٍ مِنَ الوَرى","فَكُلُّ لِكُلِّ حَيثٍ سارَ مُلازِم",39,"م",1,0],["وزُوِّدْتُ من بَحْرِ المكارمِ قَطرةً","وكم شاربٍ قيل احْتَسى وقدِ ارتَغى",40,"غ",2,0],["وزَوْرة ذاتِ الخالِ من غيرِ مَوْعدٍ","فيا حُسْنَها لو أنّني غيرُ هاجد",41,"د",1,0],["وزوَّدتُه ما قد سدَدتُ ببعضِه","مسالكَه ما بينَ صورٍ إلى مِصرِ",42,"ر",1,0],["وَزَوجَتُه الزَهراء خَيرُ كَريمَةٍ","لِخَير كَريمٍ فَضلُها لَيسَ يُجحَدُ",43,"د",1,0],["وزوَّجه الزهرا سيدة النسا","بِوَحْي وسائل كل راو ومخبر",44,"ر",1,0],["وزواج أضحى أمين اقتران","كل سعد يأتي به ويزورُ",45,"ر",1,0],["وزواهرٌ يُطْوَى الظَّلا","مُ بها وتنتشر المَظالِمْ",46,"م",1,0],["وَزَوَّدَكُم كُلَّ هَدْيٍ زَكِيٍّ","وأَوْدَعَكمْ كُلَّ رَأْيٍ أَصِيلِ",47,"ل",1,0],["وزوجة ابنك أو زوج بنتك يا","غر وهمٍ لك كالحيات في العقر",48,"ر",1,0],["وزوالُ عرِشكَ بعدما دَنسَّتهُ","وَمَحوتَ سُؤدَدهُ بعهدٍ أولِ",49,"ل",1,0],["وزُوّجتِ الوزارةُ من أخيه","ومنهُ بعدُ نِعْم الكافلانِ",50,"ن",1,0],["وزَورٍ ولسنا بمستيقظينَ","ببطن العقيقِ ولا هُجَّعِ",51,"ع",1,0],["وزورٍ عن العَلياءِ لا يَطبيَّهُمُ","إلى المجد لا نظم فصيحٌ ولا نثْرُ",52,"ر",1,0],["وزوال راعي الذود عهدأً فلم يُطق","وفاءً ولم يبرحٍ أميناً ووافيا",53,"ي",2,0],["وزورةٍ لي وعين النجم ناعسةٌ","من السّرى وخضاب الليل ما نصلا",54,"ل",2,0],["وَزَوِّجِ العودَ نَغمَةً فَلَقَد","أَرمَلَت أَوتارُهُ مِنَ الرَمَلِ",55,"ل",1,0],["وزوراء من كافي الكفاة على النوى","وضعت لها يمناي في فم أسود",56,"د",1,0],["وزَوْجَةِ مِغْيارٍ وَصَلْتُ وجَسْرَةٍ","عَجَرْتُ عليها لِمَّتي بردائِيا",57,"ي",2,1],["وزورا المقام الصالحي فكل من","على الأرض ينسى ذكره عند ذكره",58,"ر",2,0],["وزَوْرٍ زارني واللّيلُ داجٍ","وقد ملأ الكرى منّا العيونا",59,"ن",2,0],["وزوْراءٌ لغيرِ الثَّكْ","لِ بالأهلين مِرْنانُ",60,"ن",1,0],["وزَوْرٍ أتاني وكلُّ العيون","من النّومِ في شُغُلٍ شاغِلِ",61,"ل",1,0],["وزَوْرٍ زارني واللَّيلُ داجٍ","فعلّلني بباطله وولّى",62,"ل",2,1],["وزَوْرٍ تخطّى جَنوبَ المَلا","فناديت أهلاً بذا الزّائرِ",63,"ر",1,0],["وَزَوْرُ المَنايا إِنْ حَميناه جانباً","أَتانا كَأَنْ لَمْ يُحْمَ مِن كلِّ جانبِ",64,"ب",1,0],["وزوّدَتْ لحيةَ مس","ك نفحَت وعَبَّقَتْ",65,"ت",1,0],["وَزَوَّرُوا قَوْلَهُمْ وَمَا صَدَقُوا","في نَقْلِ شَيءٍ ضُرِّي به قَصَدُوا",66,"د",3,0],["وَزَوايا في كُلِّ غَورٍ وَنَجدِ","لَيسَ يَسطيعُ حَصرُها الإِحصاءُ",67,"ا",2,0],["وزوجتُهُ صِدِّيقة لم يكن لها","مقارِنةٌ غيرُ البَتولةِ مريمِ",68,"م",1,0],["وزوجُك بِكرٌ لا مخاضَ ينالُها","وأنت بها قيسٌ أقام ببرّيّه",69,"ي",2,0],["وَزَوجَةٌ عاشَت بِلا مَحَبّه","فَتِلكَ كَالنَعجَة أَو كَالدُبَّه",70,"ه",1,0],["وزور إذا ما العطف سهل حزنه","حكى طيفه استعجاله حين يطرق",71,"ق",1,1],["وزور الغيث سح راحته","حتى اعتزى للسخاء بالحيل",72,"ل",1,0],["وزودني ثغرها ما به","تعلمت نظم الدراري سطورا",73,"ر",2,0],["وزوِّدُوهُ بِنَعْشٍ كُلَّ ثانيةٍ","فإنَّهُ لِرحابِ اللهِ قَدْ عَزَما",74,"م",2,0],["وزوّجت بنت الكرم بابن غَمامة","فصحّ على التعليق والشرط أملك",75,"ك",1,0],["وَزَوَّرَهُمْ مِنْ بَعْدِ حَجِّ وَعُمْرَةٍ","أَقُولُ وَقَدْ هَمَّ الْحَجِيجُ بِسَفْرَةٍ",76,"ه",1,0],["وزور إذا وافى وأوفى لرجعةٍ","يوافيه زور بعده متعقب",77,"ب",1,0],["وزورة القبر الشريف الذي","فيه ثوى من حل أعلى مقام",78,"م",1,0],["وزوجَّه الرحمن بالطهر فاطماً","وقد رد عنها راغماً كل خاطب",79,"ب",1,0],["وَزَوارق تَحتَ الظلال حسبتها","حلبات خيل تَهتَدي بمقدم",80,"م",1,1],["وزوجينِ من سبيٍ رأيت تناتجا","بزوج عقيم فهو صنفٌ سواهما",81,"م",2,1],["وزوجها أوس أبو الصامت","بر تقي مستجيب قانت",82,"ت",1,0],["وزورقِ فضَّةٍ لم تحظَ منه","عيونُ السربِ من فرطِ البريقِ",83,"ق",1,1],