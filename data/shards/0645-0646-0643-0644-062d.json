{"poems":[[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[29,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[53,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[31,"بئس الفوارس عند معترك القنا","https://www.aldiwan.net/poem6062.html","الكامل"],[93,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[82,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[52,"يا طير إنا في غد طير","https://www.aldiwan.net/poem63822.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[93,"عصر الشبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=53194",""],[138,"لا توصني بلازم وواجب","https://www.aldiwan.net/poem20985.html","الرجز"],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[266,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[285,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[287,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[369,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[415,"أطع الهوى واعص المعاتب","https://www.aldiwan.net/poem32615.html","مجزوء الكامل"],[463,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[469,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[482,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[543,"محمد فاضل الشنقيطي قد","https://www.aldiwan.net/poem48221.html","عموديه"],[567,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34414","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34400","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48727","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38159","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70863","السريع"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35400","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136352","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49601","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118325","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118418","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89562","البسيط"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69498","البسيط"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200277","الكامل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32583","المنسرح"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60937","الكامل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17735","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100910","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130839",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100212","البسيط"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9608","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74247","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61276","الرجز"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36737","السريع"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86521","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133079","البسيط"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123852","السريع"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204162","الكامل"],[4578,"هذي رواية آدابٍ لذي أدبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49350",""],[4978,"تشطير لقصيدة الأستاذة هيام الأحمد","https://www.poetsgate.com/ViewPoem.aspx?id=177212",""],[5038,"جيش العراق","https://www.poetsgate.com/ViewPoem.aspx?id=195220",""],[5085,"ياقاتلي باللحظ","https://www.poetsgate.com/ViewPoem.aspx?id=188439",""],[5191,"شمس من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=215184",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5219,"المشهد العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=194500",""],[5353,"قيامة الوطن المدجج بالعويل","https://www.poetsgate.com/ViewPoem.aspx?id=212241",""],[5512,"قمحانة ( هل نعشق )","https://www.poetsgate.com/ViewPoem.aspx?id=204385",""],[5533,"أُولُو العَزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=177397",""],[5581,"أنذار","https://www.poetsgate.com/ViewPoem.aspx?id=22501",""],[5829,"دواعش","https://www.poetsgate.com/ViewPoem.aspx?id=215122",""],[5957,"ليس حبي من هيام وشغب","https://www.poetsgate.com/ViewPoem.aspx?id=128188",""],[6009,"أودى الشباب حميدا ذو التعاجيب","https://www.poetsgate.com/ViewPoem.aspx?id=182950",""],[6019,"فراشة في الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=53049",""],[6078,"قُلْ للمعلمِ","https://www.poetsgate.com/ViewPoem.aspx?id=203559",""],[415,"أَطِع الهَوى ، واعصِ المُعاتِبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7779&r=&rc=9",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["مِن كُلِّ حامِلِ إِحنَةٍ لا تَنجَلي","غَطشى دُجُنَّتُها وَلا تَتَوَضَّحُ",0,"ح",1,0],["مِن كُلِّ حَنكَلَةٍ تَرى جِلبابَها","فَرواً وَتَقلِبُ لِلعَباءَةِ نيرا",1,"ر",2,0],["من كلِّ حرفٍ وفقها للساكني","تلك الرّبوع وعطفها للموضع",2,"ع",1,0],["من كل حرفٍ عن سواك بمدحها","ورقاء ذات تعزّزٍ وتمنّع",2,"ع",1,0],["من كلّ حوساءَ إذا جدَّ العركْ","لو أنّها استلْقتْ على شوكِ الحَسكْ",3,"ك",1,0],["مِن كُلِّ حَتٍّ يَحتَديها مِرجَمٌ","وَطَمِرَّةٌ كَالكاسِراتِ نَسولُ",4,"ل",1,0],["مِن كُلِّ حَسناءَ كَأَنَّ حَديثَها","السَلوى أَوِ الوَحيُ الطَهورُ المُنزَلُ",5,"ل",1,0],["مِن كُلِّ حَوراءَ لم تُخذَلْ لَواحِظُها","في الفتكِ مُذ نَصَرَتْها فَتكَةُ النظرِ",6,"ر",1,0],["مِن كُلِّ حَوراءَ هَضيمِ الحَشا","غالى بِها نَبتٌ وَتَوقيرُ",7,"ر",1,0],["من كلِّ حوّاءَ مثلما خُلقَتْ","يعجبُ منها الحرير والوبرُ",8,"ر",1,0],["من كلِّ حُرٍّ نافضٍ مما اقتنى","يَده ووهَّابِ الحشاشةِ مانحِ",9,"ح",1,0],["مِنْ كُلِّ حَوْرَاءَ مِثْلِ الظَبْيِ لَوْ نَظَرَتْ","لِعَابِدٍ لَشَجَاهُ اللَّهْوُ وَالدَّدَنُ",10,"ن",1,0],["مِنْ كُلِّ حَرْفٍ فيهِ مَعْنَى صَبْوَةٍ","تَتْلُو بِهِ الوَرْقَاءُ لَحْنَ غِنَاءِ",11,"ا",2,0],["من كلّ حسناء كأنّ حديثها","السلوى أو الوحي الطهور المزل",12,"ل",1,0],["مِن كُلِّ حَبرٍ عالمٍ وَكاتِبِ","بِأَن يَحمَدَ اللَهُ قَولَ الراهِبِ",13,"ب",1,0],["من كل حدبٍ ينسلّو","ن لنصركم متطوعين",14,"ن",1,0],["من كل حالية كأن مدامعي","ودمى لتنك قلائد وعقود",15,"د",1,0],["مِنْ كُلِّ حَسْناءَ تَقْتادُ النُّفُوسَ هَوىً","إِذا أَلَمَّ بِسَمْعٍ رَجْعُها خَلَبا",16,"ب",2,0],["مِن كُلِّ حَوراءَ كَشَمسِ الضُحى","تُخجِلُ بِالأَلحاظِ حُورَ الجِنان",17,"ن",1,0],["مِن كُلِّ حورِيٍّ ضَئيل موَشَّج","كَالغُصنِ مَيّاداً ثَقيل مُؤَزَّرِ",18,"ر",1,0],["مِن كلِّ حَرْفٍ من حُروفِ سُرىً","مُتَعاقَباها الرَّفع والنّصب",19,"ب",1,0],["من كلِّ حَاوٍ قد تَكَن","نَفَهُ ثَعابِينُ الذّوائِبْ",20,"ب",1,0],["من كلّ حاملةِ الهلا","لِ بنىَ عليها البينُ بُرجا",21,"ج",2,0],["من كل حالية تضم إلى المهى","أحشاء محراب على تمثال",22,"ل",1,0],["مِن كلَّ حوراءِ اللحاظِ جفونُها","ترمي فؤادَ محبَها بنبالِ",23,"ل",1,0],["مِن كلِّ حارِسٍ تَبدَّى كالأسَد","أعوذُ منهُم بالمُهيمِن الأحَد",24,"د",1,0],["من كلِّ حاضرةِ الألطافِ باديةٍ","تَبختَرَتْ بينَ أسبابٍ وأوتادِ",25,"د",1,0],["مِن كُلِّ حِصنٍ أَماطَ عَرَّتُهُم","بِالسَيفِ لَم يَمشِ نَحوَهُم خَمرُ",26,"ر",1,0],["مِن كُلِّ حَرفٍ مِثلِ سَيفٍ خاطِفٍ","بَصَر العِدا كالبَرقِ لَمعُ فرِندِهِ",27,"د",2,0],["مِن كُلِّ حَبرٍ تابِعٍ سنَنَ الهُدى","وَلّى عَلى أثرِ الهُداةِ حَميدا",28,"د",2,0],["من كل حرٍّ ليس يهدأ روعه","حتى يطاول مصره الأمصارا",29,"ر",2,0],["من كلِّ حاضئِ نارٍ للشقاق إذا","ما شيم إِطفاءُ نارٍ للشقاق حَضا",30,"ض",2,0],["مِن كلِّ حَبرٍ في الأنامِ أَخي تُقىً","مِن كلِّ أَورعَ في الأَثامِ وَأَزهَدِ",31,"د",1,0],["من كل حسناءَ إذا أقبلتْ","بوجهها ليلاً تعيدُ النهارْ",32,"ر",1,0],["مِن كُلِّ حامِيِّ النِجارِ وَبَعضُهُم","يَسمو لِتُبَّعَ مِنهُ جَدٌّ أَمتَنُ",33,"ن",1,0],["من كل حبر امام زاهر ورع","بر رؤف رحيم بالمساكين",34,"ن",1,0],["من كلِّ حاملةٍ وقلْ محمولةٍ","لو لم تعُمْ عُدَّتْ من الغربان",35,"ن",1,0],["من كل حام شوله بعقاله","تثنى خشاة مساله المتمردا",36,"د",2,0],["من كل حورا يكاد الطرف يجرحها","من لين بص كلون الدر وهراه",37,"ه",1,0],["مِن كلِّ حَرفٍ كَحَرفِ الخَطِّ مُعمِلَةً","رَفعاً وَخَفضاً وَتَسكيناً بِتَنصيبِ",38,"ب",1,0],["مِن كُلِّ حَرّاقَةٍ يَعلو فَقارَتَها","قَصرٌ مِنَ الساجِ عالٍ ذو أَساطينِ",39,"ن",1,0],["من كل حوراء كأن لحاظها","نفثات سحر غالهن صدور",40,"ر",1,0],["مِن كُلِّ حَدباءَ ذاتِ خَشخَشَةٍ","أَو جُرَذٍ ذي شَوارِبٍ أَرِنا",41,"ن",2,0],["من كل حائلة الوشاح كأنّها","غُصْنُ الأراك على الكَثيب الأعْفَر",42,"ر",1,0],["مِن كُلِّ حُلسٍ غَداةَ الخِمسِ يَلحَقُها","قَلبٌ وَطَرفٌ حِذارَ السَوطِ مَزؤودُ",43,"د",1,0],["من كلِّ حُسنٍ ترتدى لك حُلَّةً","كيَما تصادفَ من قبولك موقعا",44,"ع",2,0],["من كل حر أخي جد مآثرهُ","تغنى عن الذكر تفصيلاً وتفضيلا",45,"ل",2,0],["من كل حرف كحرف هاض جانبها","من خلف طرف طموح الطرف مجنوب",46,"ب",1,0],["مِن كُلِّ حَتٍّ إِذا ما اِبتَلَّ مُلبَدُهُ","ضافي السَبيبِ أَسيلِ الخَدِّ يَعبوبِ",47,"ب",1,0],["مِن كُل حَيدرة يَطول بِحَيدر","أَو قسور يَرد الحُروب بِقسور",48,"ر",1,0],["مِن كلِّ حالٍ بحُلى الفَضائِل","حُلوِ الحَديث حَسنِ الشَمائِل",49,"ل",1,0],["مِن كُلِّ حَسناءَ سَقاها الصِبا","ماءَ الشَبابِ الرَيِّقِ الأَطيَبِ",50,"ب",1,0],["من كل حر ليس يخفق قلبه","إلا على الأبصار أبدع منظر",51,"ر",1,0],["من كل حرفٍ قد نظمت عددا","شهور عامٍ كي يكون مَدَدا",52,"د",2,0],["من كل حبر بحبل اللَه معتصم","وكل أروع بالرحمن محتسب",53,"ب",1,0],["من كل حبر ولي شهير","من قد رقى عالي المقام",54,"م",1,0],["من كل حسناء ورعبوبة","فتانة الألحاظ خودٍ رداح",55,"ح",1,0],["من كل حر ماجد صنديد","في كل وغد عاجز رعديد",56,"د",1,0],["من كل حمالةٍ للحلي قامتها","تسمو غضون الربي حمالة الحطب",57,"ب",1,0],["من كل حرف سوف تُهدى زهرةً","(عزّافةً. هل تعزف الأزهارُ)",58,"ر",1,0],["مِنْ كُلِّ حَدْبٍ حِين ناصَبَهُ الْعِدى","يَبْغونَ في بُنْيانِهِ الْخُذْلانا",59,"ن",2,0],["مِنْ كُلِّ حُسْنٍ مِنْ جَمِيعٍ جَامِعٌ","سُبْحَانَ رَبِّ الكوْنِ مِثلُكَ مَا خَلَقْ",60,"ق",1,0],["من كلِّ حسنٍ لها معنى به اكتملتْ","وكلُّ حسنٍ لهُ شيءٌ.. بمعناها",61,"ا",3,0],["منْ كُلِّ حدْبٍ قدْ تَتالَى جمْعُهُم","مِنْ كُلِّ صَوْبٍ والهُدَى سِيماءُ",62,"ا",2,0],["من كل حدب أتوا شوقا لبارئنا","شعثا وغبرا وقبح الذنب يخزينا",63,"ن",2,0],["من كلِّ حدب أراها اليوم ناسلة","تلك الوجوه التي قوّضتها جَدَلا",64,"ل",2,0],["من كلِّ حرفٍ تدلَّى عِزِّ قامَتِهَا","قُمحانةُ المجدِ إسمٌ قد علا رُتَبَا",65,"ب",2,0],["مِنْ كلِّ حَظٍّ وَافِرٍ قُسِمَت لَهُمْ","آياتُ فَوْزٍ بالظَّلامِ تُنَوِّرُ",66,"ر",1,0],["من كل حبه رمل","من ارض الوطن",67,"ن",1,0],["من كل حدب ينسلون لما رأوا","إلا اسوداُ واللظى ميدان",68,"ن",1,0],["منكَ لحنُ الورد يجري في دمي","منك سحرُ الليل يمحو لي التعب",69,"ب",1,0],["من كل حتٍّ إذا ما ابتل ملبده","صافي الأديم أسيل الخد يعبوب",70,"ب",1,0],["مِنْ كُلِّ حَرفٍ فِي القَصِيدَةِ يَحتَوِي","عَذبَ المَشَاعِرِ مِنْ وَرِيدِيَ يُسْكَبُ",71,"ب",1,0],["من كلِّ حرفٍ بالعقولِ غرستَهُ","مجدٌ بنتهُ تراجمٌ وعقولُ",72,"ل",1,0],["من كل حاوٍ قد تكنّف","فَهُ ثَعابينُ الذَّوانِبْ",73,"ب",1,0],["مِنْ كلِّ حسناءَ طرازيّة ٍ","تفوق الأَرنب إِحضارا",74,"ر",2,0]]}