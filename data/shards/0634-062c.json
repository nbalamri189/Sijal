ة والحمى","https://www.aldiwan.net/poem40503.html","الطويل"],[426,"نزه الطرف بمجرى بركة","https://www.aldiwan.net/poem40781.html","الرمل"],[426,"أخلاي أن الشوق هبت نواسمه","https://www.aldiwan.net/poem40836.html","الطويل"],[429,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[429,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[436,"إن تفخر الدنيا فأنت فخارها","https://www.aldiwan.net/poem34810.html","الكامل"],[436,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[438,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[456,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[456,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[456,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[456,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[456,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[456,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[456,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[456,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[456,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[456,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[459,"شجع الطبيب وليس بابن مكدم","https://www.aldiwan.net/poem15435.html","الكامل"],[459,"أضاء الليل من زمن وحظ","https://www.aldiwan.net/poem15450.html","الوافر"],[459,"احفظ مغيب الناس ما أحسنوا","https://www.aldiwan.net/poem16128.html","السريع"],[462,"وذي كرم يعطي معاقل ملكه","https://www.aldiwan.net/poem3131.html","عموديه"],[462,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[462,"قلبي ببيض المعالي هائم دنف","https://www.aldiwan.net/poem3449.html","عموديه"],[462,"تثنت من الأعطاف مخطفة سمر","https://www.aldiwan.net/poem3483.html","عموديه"],[462,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[475,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[512,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[541,"ليس يغني القول إلا لامرئ","https://www.aldiwan.net/poem1759.html","الرمل"],[549,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[551,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[556,"إن هذا الأحد الديموم","https://www.aldiwan.net/poem33854.html","الرمل"],[562,"تحمل في الهوى ما لا يطاق","https://www.aldiwan.net/poem876.html",""],[565,"حبذا الزائر في وقت السحر","https://www.aldiwan.net/poem69697.html","الرمل"],[573,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"]],"verses":[["شُجاعٌ لِأَعناقِ النَوائِبِ راكِبٌ","هُمامٌ لِأَطوادِ الحَوادِثِ فارِعُ",0,"ع",1,0],["شُجَعاءُ أَفئِدَةٍ بِغَيرِ صَوارِمِ","خُطَباءُ أَلسِنَةٍ بِغَيرِ مَنابِرِ",1,"ر",1,0],["شَجَوني وَلَم يُبقوا لِعَينِيَ بَلَّةً","مِنَ الدَمعِ إِلّا اِستَفرَغوها مِنَ الوَجدِ",2,"د",1,0],["شَجاً لِنَفسِ شُجاعِ الحَربِ مُعتَرِضاً","وَفَرحَةً لِفُؤادِ العاشِقِ الرودِ",3,"د",1,0],["شَجاني بأَعلامِ المُحَصِّبِ من مِنىً","خَفِيُّ حَنينٍ رَجَّعَتْهُ الأَباعِرُ",4,"ر",1,1],["شَجاهُ البَرقُ فهْوَ كما تَنَزّى","إليك السِّقْطُ من أطرافِ زَنْدِ",5,"د",1,0],["شُجَّت بِذي شَبَمٍ مِن ماءِ مَحنِيَةٍ","صافٍ بِأَبطَحَ أَضحى وَهُوَ مَشمولُ",6,"ل",1,0],["شَجَتنا مَطالِعُ أَقمارِها","فَسالَت نُفوسٌ لِتَذكارِها",7,"ر",3,1],["شَجا البُحتُري إيوانُ كِسرى وَهاجَهُ","وَهاجَت بِكَ الحَمراءُ أَشجانَ موجَعِ",8,"ع",1,0],["شَجا قَلبَهُ أَظعانُ سُعدى السَوالِكُ","وَأَجمالُها يَومَ البُلَيدِ الرَواتِكُ",9,"ك",1,1],["شَجا أَظعانُ غاضِرَةَ الغوادي","بِغَيرِ مَشورَةٍ عَرَضًا فُؤادي",10,"ي",1,1],["شَجَانَا نَوْحٌ شَادِيهَا","وَتَصْوِيعُ بَوادِيهَا",11,"ي",3,1],["شَجَاعَةٌ تَغْلُبُ الخُطُوبَ وَمَا","تَغْلَبُهَا أَنْ تَوَالَتْ الأُزَمُ",12,"م",1,0],["شَجَجنَ الفَلا بِالأَمِّ شَجّاً وَشَمَّرَت","يَمانِيَةٌ يُدني البَعيدَ اِنتِقالُها",13,"ل",3,0],["شَجَجنَ الدُجى حَتّى إِذا قالَ صُحبَتي","وَحَلَّقَ أَردافُ النُجومِ الغَوائِرِ",14,"ر",1,0],["شجاعاَ إن جئته يوم هج","تلق في الهيج بهمة صنديدا",15,"د",2,0],["شَجا فُؤادي طَرفُها الساجي","وَكُلُّ ساجٍ طَرفُهُ شاجِ",16,"ج",1,0],["شُجَّت بِصَهباءَ لَها سَورَةٌ","مِن بَيتِ رَأسٍ عُتِّقَت في الخِتام",17,"م",1,0],["شجونٌ نحوَها العشاقُ فاؤا","وصبّ ما لهُ في الصبرِ راء",18,"ا",2,1],["شجاني منه أمرد ما شجاني","وثنى بالعذار فمن عذيري",19,"ر",2,0],["شجونيَ لا تُرقى كملسوع خاطئٍ","ودمعِي كحظِّي ساقط وهو لا يرقى",20,"ق",2,0],["شجٍ بالعلى والعلم والبأس والندى","فلله ما أحلى حديث شجونه",21,"ن",2,0],["شجوُ قلبي من سائر الخلق شاجي","ليس للقلب دونَهَا من مَعَاجِ",22,"ج",1,1],["شجتْك رسومٌ دارسات بثَهمَدِ","كَمُلْحِمة ابن السِّمَّريِّ مُحمَّدِ",23,"د",1,1],["شجرٌ ونخلٌ لا يُطي","ر غراب أيْكهما مُطيرُ",24,"ر",1,0],["شجاً أن أروم الصبر عنك فيلتوي","عليَّ ولؤمٌ أن يساعدني الصبرُ",25,"ر",1,1],["شَجِيَ الإزارُ لها برابيةٍ","وجرى الوِشاحُ لها على هَضَمِ",26,"م",1,0],["شَجَتكَ النائِحاتُ بِجُنحِ لَيلٍ","فَبِتَّ تُساجِلُ النَوحَ الحَماما",27,"م",2,0],["شَجعاءُ مُعمَلَةٌ تَدمى مَناسِمُها","كَأَنَّها حَرَجٌ بِالقِدِّ مَأسورُ",28,"ر",1,0],["شُجونٌ مَنعن الجُفونَ الكَرى","وَعَوَّضنَها أَدمُعا تُنزَفُ",29,"ف",1,0],["شجو النفوس يأسها","والامل المنحطم",30,"م",1,0],["شجوني إذا جُن الظلام كثير","يؤلبها عادي الهوى ويثير",31,"ر",1,1],["شَجَرٌ نامٍ وَظِلٌّ سابِغٌ","بَيدَ أَنَّ الصِلَّ في أَصلِ الشَجَر",32,"ر",1,0],["شَجاكَ صِغارٌ كَالجُمانِ وَمَوطِنٌ","نَدٍ مِثلَ أَيّامِ الحَداثَةِ مُمرَعُ",33,"ع",1,0],["شَجَّ قِراعُ المِزَاجِ صُورَتَها","كَلُؤْلُؤٍ جائلٍ على ذَهَبِ",34,"ب",1,0],["شُجاعٌ كَأَنَّ الحَربَ عاشِقَةٌ لَهُ","إِذا زارَها فَدَّتهُ بِالخَيلِ وَالرَجلِ",35,"ل",1,0],["شَجراتُ وَرْدٍ أصْفَرٍ بَعَثَتْ","في قلب كلِّ متيَّمٍ طرَبَا",36,"ب",2,1],["شَجىً مِن هَوىً زادَ الغَليلَ تَوَقُّداً","وَكانَ الهَوى أَلباً عَلى المُغرَمِ الشَجِي",37,"ي",1,0],["شَجَت صاحِبي أَطلالُها فَتَهَلَّت","مَدامِعُهُ فيها وَما قُلتُ أَسعِدِ",38,"د",1,0],["شَجَرٌ تُلاعِبُهُ الرِياحُ فَتَنثَني","أَعطافُهُ في سائِحٍ مُتَفَجِّرِ",39,"ر",1,0],["شَجوُ حُسّادِهِ وَغَيظُ عِداهُ","أَن يَرى مُبصِرٌ وَيَسمَعَ واعِ",40,"ع",1,0],["شَجَرٌ عَلى خُضَرٍ تَرِفُّ غُصونُهُ","مِن مُزهِرٍ أَو مُثمِرٍ أَو مورِقِ",41,"ق",1,0],["شُجاعٌ إِذا لاقى وَرامٍ إِذا رَمى","وَهادٍ إِذا ما أَظلَمَ اللَيلُ مِصدَعُ",42,"ع",1,0],["شَجَرٌ إذا ما الصُّبحُ أسفرَ لم يِنُحْ","للأمنِ طائرُه ولكن غَرَّدا",43,"د",2,0],["شَجَّ السُقاةُ عَلى ناجودِها شَبِماً","مِن ماءِ لينَةَ لا طَرقاً وَلا رَنِقا",44,"ق",2,0],["شُجاعٌ تَرى مَتنَ الجِيادِ مِهادَهُ","وَتَألَمُ جَنبَيهِ الوَسائِدُ وَالفُرشُ",45,"ش",1,0],["شَجى وَشَفى لَمّا شَدا وَتَرَنَّما","فَأَنعَسَ أَيقاظاً وَأَيقَظَ نُوَّما",46,"م",2,1],["شَجنٌ على شَجنٍ وحرقةُ نارِ","مَن مُسعدي في ساعةِ التذكارِ",47,"ر",1,1],["شجريةٍ ذهبيةٍ نزعتْ إلى","سحر يؤثّر في النهى تأثيرا",48,"ر",2,0],["شَجَرٌ بالبّرِ مورّقَةٌ","ننتابُ لها ظلّاً وَجَنى",49,"ن",2,0],["شَجٍ كانَ من قبلِ التفرّق يشتكي","نميمةَ واشيه وتأنيبَ عاذِلِه",50,"ل",2,0],["شُجاعٌ يَصيدُ القِرْنَ حَتَّى كَأَنَّهُ","إِذا ما كَساهُ الرمحُ أحقبُ ذَيّالُ",51,"ل",1,0],["شجىً ذكره للروم كالموت إن جرى","أخافَ وإن أوفى على النفس أتلفا",52,"ف",2,0],["شَجَراتٌ حَمْلُها البيضُ إذا","نَوّرَتْ بالمشرفياتِ العضاب",53,"ب",1,0],["شجاعٌ له في القرْن نجلاءُ ثرّةٌ","يُجَرّرُ منْها وهو كالثَّملِ القُضْبا",54,"ب",2,0],["شَجا الريحَ فَاِزدادَت حَنيناً لِفَقدِهِ","وَأَحدَثَ شَجواً في بُكاءِ الحَمائِمِ",55,"م",1,0],["شَجاً بِما عَنَّ لِلأَميرِ أَبي العَبّا","سِ أَمسى نَصباً لِمُعتَرِضِه",56,"ض",2,0],["شَجاً في الحَشى تَردادُهُ لَيسَ يَفتُرُ","بِهِ صُمنَ آمالي وَإِنّي لَمُفطِرُ",57,"ر",1,1],["شَجعاءَ جِرَّتُها الذَميلُ تَلوكُهُ","أُصُلاً إِذا راحَ المَطِيُّ غِراثا",58,"ث",2,0],["شَجىً في حُلوقِ الحادِثاتِ مُشَرِّقٍ","بِهِ عَزمُهُ في التُرُّهاتِ مُغَرِّبِ",59,"ب",1,0],["شجَّ الخفيرَ بارقٌ","في عينه وقلبهِ",60,"ه",1,0],["شُجَّت بِماءِ سَحابٍ زَلَّ عَن رَصَفٍ","مِن ماءِ أَزهَرَ لَم يُخلَط بِهِ كَدَرُ",61,"ر",1,0