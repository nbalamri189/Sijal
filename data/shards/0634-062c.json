ي","https://www.aldiwan.net/poem31233.html","الكامل"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[80,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[80,"لها العتب هذا دأبها ولي العتبى","https://www.aldiwan.net/poem31544.html","الطويل"],[44,"أمالك إن الحزن أحلام حالم","https://www.aldiwan.net/poem30352.html","الطويل"],[44,"أقلق جفن العينين عن غمضه","https://www.aldiwan.net/poem30467.html","المنسرح"],[44,"شجا في الحشى ترداده ليس يفتر","https://www.aldiwan.net/poem30502.html","الطويل"],[44,"قف بالطلول الدارسات علاثا","https://www.aldiwan.net/poem30565.html","الكامل"],[44,"تقي جمحاتي لست طوع مؤنبي","https://www.aldiwan.net/poem30583.html","الطويل"],[69,"بعدا لقاض تاجر","https://www.aldiwan.net/poem29151.html","مجزوء الرجز"],[31,"ألمم بعفراء إن أصحابك ابتكروا","https://www.aldiwan.net/poem42541.html","البسيط"],[33,"شجتني وأبلتني منازل درس","https://www.aldiwan.net/poem25898.html","الطويل"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[40,"ألا قاتل الله الهوى كيف أخلقا","https://www.aldiwan.net/poem42279.html","الطويل"],[52,"شجاك الحي إذ بانوا","https://www.aldiwan.net/poem26661.html","الهزج"],[52,"شجتك لهند دمنة وديار","https://www.aldiwan.net/poem27053.html","الطويل"],[75,"لمن صولجان فوق خدك عابث","https://www.aldiwan.net/poem69097.html","الطويل"],[48,"شجاني وأبلاني تذكر من أهوى","https://www.aldiwan.net/poem10420.html","الطويل"],[48,"شجر التفاح لا ذقت القحل","https://www.aldiwan.net/poem64516.html","الرمل"],[48,"صفة الطلول بلاغة القدم","https://www.aldiwan.net/poem65092.html","الكامل"],[46,"ذكرتني عقوبة من إلهي","https://www.aldiwan.net/poem22732.html","الخفيف"],[46,"إدفع الشر إذا جاء بشر","https://www.aldiwan.net/poem22738.html","الرمل"],[46,"زعموا بأنهم صفوا لمليكهم","https://www.aldiwan.net/poem22990.html","الكامل"],[46,"من لي بترك الطعام أجمع إن ال","https://www.aldiwan.net/poem23538.html","المنسرح"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85435","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85580","المجتث"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72195","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54827","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43676","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[80,"أرأيتَ لنَا ولهم ظُعُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=3765",""],[28,"لو لم يفارقني عطية لم أهن","https://www.poetsgate.com/ViewPoem.aspx?id=16988",""],[51,"شجتْك رسومٌ دارسات بثَمْهَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27804",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"]],"verses":[["شُجاعٌ لِأَعناقِ النَوائِبِ راكِبٌ","هُمامٌ لِأَطوادِ الحَوادِثِ فارِعُ",0,"ع",1,0],["شُجَعاءُ أَفئِدَةٍ بِغَيرِ صَوارِمِ","خُطَباءُ أَلسِنَةٍ بِغَيرِ مَنابِرِ",1,"ر",1,0],["شَجَوني وَلَم يُبقوا لِعَينِيَ بَلَّةً","مِنَ الدَمعِ إِلّا اِستَفرَغوها مِنَ الوَجدِ",2,"د",1,0],["شَجاً لِنَفسِ شُجاعِ الحَربِ مُعتَرِضاً","وَفَرحَةً لِفُؤادِ العاشِقِ الرودِ",3,"د",1,0],["شَجاني بأَعلامِ المُحَصِّبِ من مِنىً","خَفِيُّ حَنينٍ رَجَّعَتْهُ الأَباعِرُ",4,"ر",1,1],["شَجاهُ البَرقُ فهْوَ كما تَنَزّى","إليك السِّقْطُ من أطرافِ زَنْدِ",5,"د",1,0],["شُجَّت بِذي شَبَمٍ مِن ماءِ مَحنِيَةٍ","صافٍ بِأَبطَحَ أَضحى وَهُوَ مَشمولُ",6,"ل",1,0],["شَجَتنا مَطالِعُ أَقمارِها","فَسالَت نُفوسٌ لِتَذكارِها",7,"ر",3,1],["شَجا البُحتُري إيوانُ كِسرى وَهاجَهُ","وَهاجَت بِكَ الحَمراءُ أَشجانَ موجَعِ",8,"ع",1,0],["شَجا قَلبَهُ أَظعانُ سُعدى السَوالِكُ","وَأَجمالُها يَومَ البُلَيدِ الرَواتِكُ",9,"ك",1,1],["شَجا أَظعانُ غاضِرَةَ الغوادي","بِغَيرِ مَشورَةٍ عَرَضًا فُؤادي",10,"ي",1,1],["شَجَانَا نَوْحٌ شَادِيهَا","وَتَصْوِيعُ بَوادِيهَا",11,"ي",3,1],["شَجَاعَةٌ تَغْلُبُ الخُطُوبَ وَمَا","تَغْلَبُهَا أَنْ تَوَالَتْ الأُزَمُ",12,"م",1,0],["شَجَجنَ الفَلا بِالأَمِّ شَجّاً وَشَمَّرَت","يَمانِيَةٌ يُدني البَعيدَ اِنتِقالُها",13,"ل",3,0],["شَجَجنَ الدُجى حَتّى إِذا قالَ صُحبَتي","وَحَلَّقَ أَردافُ النُجومِ الغَوائِرِ",14,"ر",1,0],["شجاعاَ إن جئته يوم هج","تلق في الهيج بهمة صنديدا",15,"د",2,0],["شَجا فُؤادي طَرفُها الساجي","وَكُلُّ ساجٍ طَرفُهُ شاجِ",16,"ج",1,0],["شُجَّت بِصَهباءَ لَها سَورَةٌ","مِن بَيتِ رَأسٍ عُتِّقَت في الخِتام",17,"م",1,0],["شجونٌ نحوَها العشاقُ فاؤا","وصبّ ما لهُ في الصبرِ راء",18,"ا",2,1],["شجاني منه أمرد ما شجاني","وثنى بالعذار فمن عذيري",19,"ر",2,0],["شجونيَ لا تُرقى كملسوع خاطئٍ","ودمعِي كحظِّي ساقط وهو لا يرقى",20,"ق",2,0],["شجٍ بالعلى والعلم والبأس والندى","فلله ما أحلى حديث شجونه",21,"ن",2,0],["شجوُ قلبي من سائر الخلق شاجي","ليس للقلب دونَهَا من مَعَاجِ",22,"ج",1,1],["شجتْك رسومٌ دارسات بثَهمَدِ","كَمُلْحِمة ابن السِّمَّريِّ مُحمَّدِ",23,"د",1,1],["شجرٌ ونخلٌ لا يُطي","ر غراب أيْكهما مُطيرُ",24,"ر",1,0],["شجاً أن أروم الصبر عنك فيلتوي","عليَّ ولؤمٌ أن يساعدني الصبرُ",25,"ر",1,1],["شَجِيَ الإزارُ لها برابيةٍ","وجرى الوِشاحُ لها على هَضَمِ",26,"م",1,0],["شَجَتكَ النائِحاتُ بِجُنحِ لَيلٍ","فَبِتَّ تُساجِلُ النَوحَ الحَماما",27,"م",2,0],["شَجعاءُ مُعمَلَةٌ تَدمى مَناسِمُها","كَأَنَّها حَرَجٌ بِالقِدِّ مَأسورُ",28,"ر",1,0],["شُجونٌ مَنعن الجُفونَ الكَرى","وَعَوَّضنَها أَدمُعا تُنزَفُ",29,"ف",1,0],["شجو النفوس يأسها","والامل المنحطم",30,"م",1,0],["شجوني إذا جُن الظلام كثير","يؤلبها عادي الهوى ويثير",31,"ر",1,1],["شَجَرٌ نامٍ وَظِلٌّ سابِغٌ","بَيدَ أَنَّ الصِلَّ في أَصلِ الشَجَر",32,"ر",1,0],["شَجاكَ صِغارٌ كَالجُمانِ وَمَوطِنٌ","نَدٍ مِثلَ أَيّامِ الحَداثَةِ مُمرَعُ",33,"ع",1,0],["شَجَّ قِراعُ المِزَاجِ صُورَتَها","كَلُؤْلُؤٍ جائلٍ على ذَهَبِ",34,"ب",1,0],["شُجاعٌ كَأَنَّ الحَربَ عاشِقَةٌ لَهُ","إِذا زارَها فَدَّتهُ بِالخَيلِ وَالرَجلِ",35,"ل",1,0],["شَجراتُ وَرْدٍ أصْفَرٍ بَعَثَتْ","في قلب كلِّ متيَّمٍ طرَبَا",36,"ب",2,1],["شَجىً مِن هَوىً زادَ الغَليلَ تَوَقُّداً","وَكانَ الهَوى أَلباً عَلى المُغرَمِ الشَجِي",37,"ي",1,0],["شَجَت صاحِبي أَطلالُها فَتَهَلَّت","مَدامِعُهُ فيها وَما قُلتُ أَسعِدِ",38,"د",1,0],["شَجَرٌ تُلاعِبُهُ الرِياحُ فَتَنثَني","أَعطافُهُ في سائِحٍ مُتَفَجِّرِ",39,"ر",1,0],["شَجوُ حُسّادِهِ وَغَيظُ عِداهُ","أَن يَرى مُبصِرٌ وَيَسمَعَ واعِ",40,"ع",1,0],["شَجَرٌ عَلى خُضَرٍ تَرِفُّ غُصونُهُ","مِن مُزهِرٍ أَو مُثمِرٍ أَو مورِقِ",41,"ق",1,0],["شُجاعٌ إِذا لاقى وَرامٍ إِذا رَمى","وَهادٍ إِذا ما أَظلَمَ اللَيلُ مِصدَعُ",42,"ع",1,0],["شَجَرٌ إذا ما الصُّبحُ أسفرَ لم يِنُحْ","للأمنِ طائرُه ولكن غَرَّدا",43,"د",2,0],["شَجَّ السُقاةُ عَلى ناجودِها شَبِماً","مِن ماءِ لينَةَ لا طَرقاً وَلا رَنِقا",44,"ق",2,0],["شُجاعٌ تَرى مَتنَ الجِيادِ مِهادَهُ","وَتَألَمُ جَنبَيهِ الوَسائِدُ وَالفُرشُ",45,"ش",1,0],["شَجى وَشَفى لَمّا شَدا وَتَرَنَّما","فَأَنعَسَ أَيقاظاً وَأَيقَظَ نُوَّما",46,"م",2,1],["شَجنٌ على شَجنٍ وحرقةُ نارِ","مَن مُسعدي في ساعةِ التذكارِ",47,"ر",1,1],["شجريةٍ ذهبيةٍ نزعتْ إلى","سحر يؤثّر في النهى تأثيرا",48,"ر",2,0],["شَجَرٌ بالبّرِ مورّقَةٌ","ننتابُ لها ظلّاً وَجَنى",49,"ن",2,0],["شَجٍ كانَ من قبلِ التفرّق يشتكي","نميمةَ واشيه وتأنيبَ عاذِلِه",50,"ل",2,0],["شُجاعٌ يَصيدُ القِرْنَ حَتَّى كَأَنَّهُ","إِذا ما كَساهُ الرمحُ أحقبُ ذَيّالُ",51,"ل",1,0],["شجىً ذكره للروم كالموت إن جرى","أخافَ وإن أوفى على النفس أتلفا",52,"ف",2,0],["شَجَراتٌ حَمْلُها البيضُ إذا","نَوّرَتْ بالمشرفياتِ العضاب",53,"ب",1,0],["شجاعٌ له في القرْن نجلاءُ ثرّةٌ","يُجَرّرُ منْها وهو كالثَّملِ القُضْبا",54,"ب",2,0],["شَجا الريحَ فَاِزدادَت حَنيناً لِفَقدِهِ","وَأَحدَثَ شَجواً في بُكاءِ الحَمائِمِ",55,"م",1,0],["شَجاً بِما عَنَّ لِلأَميرِ أَبي العَبّا","سِ أَمسى نَصباً لِمُعتَرِضِه",56,"ض",2,0],["شَجاً في الحَشى تَردادُهُ لَيسَ يَفتُرُ","بِهِ صُمنَ آمالي وَإِنّي لَمُفطِرُ",57,"ر",1,1],["شَجعاءَ جِرَّتُها الذَميلُ تَلوكُهُ","أُصُلاً إِذا راحَ المَطِيُّ غِراثا",58,"ث",2,0],["شَجىً في حُلوقِ الحادِثاتِ مُشَرِّقٍ","بِهِ عَزمُهُ في التُرُّهاتِ مُغَرِّبِ",59,"ب",1,0],["شجَّ الخفيرَ بارقٌ","في عينه وقلبهِ",60,"ه",1,0],["شُجَّت بِماءِ سَحابٍ زَلَّ عَن رَصَفٍ","مِن ماءِ أَزهَرَ لَم يُخلَط بِهِ كَدَرُ",61,"ر",1,0],["شَجَتني وَأَبلَتني مَنازِلُ دُرَّسُ","أُسائِلُها عَمَّن عَهِدتُ وَتَخرَسُ",62,"س",1,1],["شجنٌ بِقَلبِكَ يَطمَئِنُّ وَيَفزَعُ","وَهَوىً لِنَفسِكَ يَستَقِلُّ وَيَرجِعُ",63,"ع",1,1],["شَجِي الحِجلِ يَغتالُ العَجيزَةَ مُرطُهُ","وَإِمّا وَشاحاهُ عَلَيهِ فَأَملَقا",64,"ق",2,0],["شَجاكَ الحَيُّ إِذ بانوا","فَدَمعُ العَينِ تَهتانُ",65,"ن",1,1],["شَجَتكَ لِهِندٍ دِمنَةٌ وَدِيارُ","خِلاءٌ كَما شاءَ الفِراقُ قِفارُ",66,"ر",1,1],["شَجاً لِعِداه لا مزار نفوسهم","قريبٌ ولا الأعمار فيهِم لوابث",67,"ث",1,0],["شَجاني وَأَبلاني تَذَكُّرُ مَن أَهوى","وَأَلبَسَني ثَوباً مِنَ الضُرِّ وَالبَلوى",68,"ا",1,1],["شَجَرَ التُفّاحِ لا ذُقتَ القَحَل","لا وَلا زِلتَ لِغاياتِ المَثَل",69,"ل",1,1],["شُجَّت فَعالَت فَوقَها حَبَباً","مُتَراصِفاً كَتَراصُفِ النَظمِ",70,"م",1,0],["شَجَرُ العَيشِ مَعدِنٌ لِلرَزايا","أَودَتِ الطَيرَ فيهِ بِالتَوكيرِ",71,"ر",1,0],["شَجَرٌ أَفضَلُهُ مُثمِرُهُ","وَمِنَ الناسِ نَخيلٌ وَعُشَر",72,"ر",1,0],["شَجَرُ الخِلافِ قُلوبُهُم وَيحٌ لَها","غَرَضي خِلافُ الحَقِّ لا الصَفصافُ",73,"ف",1,0],["شَجَّعَ قَلبي عَلى الرَدى رَشَدي","وَالنَفسُ مَجبولَةٌ عَلى الجُبُنِ",74,"ن",1,0],["شَجَتْكَ بظَاهِرٍ كقَريضِ ليْلى","وباطِنُهُ عَوِيصُ أبي حِزامِ",75,"م",1,0],["شَجَا رَكْباً وأفْراساً وإبْلاً","وزاد فكاد أنْ يَشْجو الرّحالا",76,"ل",2,0],["شَجاني فأبكاني بشاطيء دجلةٍ","حمام عَلى غصن الأراك سجوع",77,"ع",1,0],["شجاعة لا تبارى","وهمة لا تكل",78,"ل",1,0],["شُجاعٌ لدى الهَيْجاءِ ثبْتٌ مشايحٌ","إذا انْحازَ عن أقْرانِهِ كُلُّ سابحِ",79,"ح",1,0],["شَجْرَاءُ تَسْلُكُها السَّمُومُ فَتَغْتَدِي","رَهْواً وَيَسْكُنُها الْهَجِيرُ فَيَمْرَأُ",80,"ر",2,0],["شَجٍ بِهَا يَكْتُمُهَا نَفْسَهُ","وَهْوَ لِيَرْضَاهَا غَدَاً صَابِرُ",81,"ر",1,0],["شَجِّعِينِي عَلَى فِرَاقِ نعِيمِي","وَاجْعَلِي قَلْبِيَ الجَزُوعَ صَبُورَا",82,"ر",2,0],["شَجَا مَا شَجَاكُمْ أُمَّةَ الضَّادِ كُلَّهَا","فَقَيْسُونُ مُهْتَزٌّ وَلُبْنَانُ مَائِد",83,"د",1,0],["شَجا الأسدَ ناعي اِبنِهِ","وَأَشمَت كَلباً لَهَث",84,"ث",1,0],["شَجاً بِحَلْقِ الوَطَنِ الْمُفْتَدَى","وشَوْكَةٌ كالنَّصْلِ في ظَهْرِه",85,"ر",2,0],["شجاعَةٌ مزَّقتْ أحلامَ ساستِهمْ","وعلَّمتْ مُترفيهِم كيفَ يصْحُونَا",86,"ن",2,0],["شجاعٌ إذا ضنّ الشُّجاع بنفسه","ولم يبقَ في الميدان فردٌ يؤازره",87,"ر",2,0],["شجتْك كربةُ أبياتٍ وجدتَ بها","على كآبتها تفريجةَ الكُرَب",88,"ب",1,0],["شجرٌ بالبرّ مورّقة","ٌ نتابُ لها ظلاٍّ وَجَنى",89,"ن",2,0],["شُجاعٌ إذا لاقَى، وَرَامٍ إذا رَمعى،","وَهادٍ إذا ما أظْلَمَ اللّيلُ مِصْدَعُ",90,"ع",1,0],["شجتْك رسومٌ دارسات بثَمْهَدِ","كَمُلْحَمة ابن السِّمَّريِّ مُحمَّدِ",91,"د",1,1],["شجر باسق تغنى طيور","فوق أفنانه وظل ظليل",92,"ل",1,0]]}