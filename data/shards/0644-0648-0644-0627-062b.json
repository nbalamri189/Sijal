{"poems":[[286,"أمشرفي بصفاته وحلاه","https://www.aldiwan.net/poem1400.html",""],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[520,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[534,"لولا ثلاث هن أقصى المنى","https://www.aldiwan.net/poem37434.html","السريع"],[534,"إذا كنت في دنياك والدين تابعا","https://www.aldiwan.net/poem37435.html","الطويل"],[556,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72271","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64925","البسيط"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137947",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27459","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27436","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92303","الكامل"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147672","الكامل"],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[520,"لولا ثباتك والألباب خافقة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577439",""]],"verses":[["لولا ثناؤك ما تضوَّع نشرها","أرجاً ولا سر الربا مسراه",0,"ا",2,0],["لولا ثناؤك ما امتننت بوصلها","والمرءُ يقدحُ في صَفاة المحسنِ",1,"ن",1,0],["لولا ثباتك والألباب خافقة","لم ينج روح الهدى من راحة العطب",2,"ب",1,0],["لَوْلا ثَلاثٌ هُنَّ أَقْصَى الْمُنى","ما كَانَ طُولُ العُمْرِ منْ قَصْدِي",3,"د",2,1],["لَوْلاَ ثَلاثٌ لَمْ أَخَفْ صَرْعَتي","لَيْسَتْ كما قَالَ فَتَى العَبْدِ",4,"د",1,0],["لولا ثناءٌ خالدٌ ذكرُهُ","ما اِنتصف العالِمُ من جاهِلِ",5,"ل",1,0],["لولا ثغور كالأقاحي","ما جاز عندي شرب راح",6,"ح",1,1],["لولا ثَلاثونَ تَحْدوها ثَمانيَةٌ","لَكانَ مِثْلُكِ مِنْ مِثْلي على بالِ",7,"ل",1,0],["لولا ثباتٌ شدَّ بنيانها","من كل شهم حازم باقعه",8,"ع",2,0],["لولا ثبوتُ الحقِّ لم يجز الذي","قد كان لكن بالثبوتِ يجوز",9,"ز",1,0],["لولا ثبوتُ المنع قلتُ بجودِه","المنعُ يُذهبُ رتبةَ الكرماء",10,"ا",2,0],["لولا ثلاثٌ في الهوى يا صاحبي","ما اعتضتُ عنه بنضرةٍ ونعيمِ",11,"م",1,1],["لولا ثلاث قد شغفت بحبها","ما عفت في حوض المنية موردي",12,"ي",1,1],["لولا ثناياه ما حسبنا","أن صغار الجمان أثمن",13,"ن",1,0],["لولا ثباتك والألباب خافقة","لم تنج روح الهدى من راحة العطب",14,"ب",1,1]]}