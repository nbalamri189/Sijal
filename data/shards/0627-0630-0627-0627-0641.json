s://www.poetsgate.com/ViewPoem.aspx?id=186672",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5970,"طلبت العلا حتى استلان لي الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=130656",""],[6093,"ابتسامة أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=200241",""],[6277,"على الأطلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64490&r=&rc=53",""]],"verses":[["إِذا اِفتَخَروا ضَعضَعوا الفاخِري","نَ خَطمَ القُرومِ رِقابَ الإِفالِ",0,"ل",1,0],["إِذا أَفلَتوا طَعنَ الرِماحِ رَمَتهُمُ","بِطَعنِ عَواليها النُجومُ الأَناحِسُ",1,"س",1,0],["إذا افْتَخَرَتْ عُليا كِنانَةَ والْتَقَتْ","على غايةٍ في المَجْدِ تُعْيِي المُسامِيا",2,"ي",2,0],["إِذا اِفتَلَتَت مِنكَ النَوى ذا مَوَدَّةٍ","حَبيباً بِتَصداعٍ مِنَ البَينِ ذي شَغبِ",3,"ب",1,0],["إِذا اِفتَرَّ الحُداةُ مَضَينَ قُدماً","وَفي الخِمسِ الجُموحُ لَهُنَّ حادي",4,"د",2,0],["إِذا اِفتَخَروا عَدّوا الصَبَهبَذَ مِنهُمُ","وَكِسرى وَآلَ الهُرمُزانِ وَقَيصَرا",5,"ر",2,0],["إذا افتخرَ السادات يوماً سكتُّمُ","ولم تَسكُتِ الأحلامُ والأَمرات",6,"ت",1,0],["إذا افترستَ الرغيف أنَّ لهُ","كأن ليثاً هنالك افترسَهْ",7,"س",2,0],["إذا افترقنا وَشَى الوشاةُ وإنْ","كان التلاقي وجدتُهم رصَدَكْ",8,"ك",1,0],["إِذا اِفتَرَقَت أَسيافُهُ وَسطَ جَحفَلٍ","تَفَرَّقَ عَنهُ هامُهُ وَسَواعِدُه",9,"د",2,0],["إِذا اِفتَتَحوا أَرضاً أَعَضّوا لِمِثلِها","كَتائِبَ تَفري مِن أَعاديكَ ما تَفري",10,"ر",2,0],["إِذا أَفلَتَت مِن سَملَقٍ بِنُفوسِها","أَعادَ عَلَيها رَئِدُ المَوتِ سَملَقا",11,"ق",2,0],["إِذا اِفتَرَقوا عَن وَقعَةٍ جَمَعَتهُمُ","لِأُخرى دِماءٌ ما يُطَلُّ نَجيعُها",12,"ع",3,0],["إذا أَفْنَتْ سَجايا الخَصْرِ منها","ذَمَمتُ لها سَجايا الخَيزُرانِ",13,"ن",1,0],["إِذا اِفتَخَرَت فِتيَةٌ بِالرِجالِ","فَفَخرُ طُفَيلٍ بِنِسوانِها",14,"ه",2,0],["إِذا اِفتَخَرَ الأَقوامُ يَوماً بِمَجدِهِم","فَإِنَّكَ مِن قَومٍ بِهِم يَفخَرُ المَجدُ",15,"د",1,0],["إِذا اِفتَخَرَت يَوماً تَميمٌ بِقَوسِها","وَزادَت عَلى ما وَطَّدَت مِن مَناقِبِ",16,"ب",1,0],["إِذا اِفتَخَرَت يَوماً رَبيعَةُ أَقبَلَت","مُجَنَّبَتَي مَجدٍ وَأَنتَ لَها قَلبُ",17,"ب",1,0],["إذاً أفِرُّ ويُخْزِي الأزْدَ شاعِرُهَا","فلا تَظُنَّ الجُلَندَى كلَّ أزديّ",18,"ي",1,0],["إِذا اِفتَرَقَت أَجزاؤُنا حُطَّ ثُقلُنا","وَنَحمِلُ عِبئاً حينَ يَلتَئِمُ الشَعبُ",19,"ب",1,0],["إِذا اِفتَرَقَت أَجزاءُ جِسمي لَم أُبَل","حُلولَ الرَزايا في مَصيفٍ وَلا مَشتى",20,"ت",2,0],["إِذا اِفتَكَرَ الإِنسانُ في أَمرِ دينِهِ","بَدا نَبَأٌ يَثني الحِجى وَبِهِ كَبت",21,"ت",1,0],["إِذا اِفتَكَرَ الَّذينَ لَهُم عُقولٌ","رَأَوا نَبَأً يَحُقُّ لَهُ السُهودُ",22,"د",1,0],["إِذا اِفتَكَرنا عَلِمنا أَنَّ ذا ضَعَةٍ","أَعلى النُجومِ وَلِلَّهِ اِنتَهى الشَرَفُ",23,"ف",1,0],["إِذا أَفِكوا فَلا تَقبَل وَمَيِّز","فَأَكثَرُ ماجَلَوهُ عَلَيكَ إِفكُ",24,"ك",1,0],["إِذا اِفتَكَرَ اللَبيبُ رَأى أُموراً","تَرُدُّ الضاحِكاتِ إِلى الوُجومِ",25,"م",1,0],["إذا افتخرَ المَسكُ الذكيّ فإنما","يقولُ ادّعاءً إنّه مِن رَغامِهِ",26,"م",2,0],["إذا أفرعَتْ من ذاتِ نِيقٍ حَسِبْتَها","تُفيضُ على أهلِ الوُهودِ بِحارا",27,"ر",2,0],["إِذَا اِفتَخَرَ الأَزدِيُّ يوماً فَقُل لَهُ","تأَخّر فَلَن يَجعَل لَكَ اللَهُ مَفخرا",28,"ر",2,0],["إذا افتقدَ التاريخُ آثار أمَّةٍ","أشرْتِ بما خلَّدتِه من مآثرِ",29,"ر",1,0],["إِذَا افْتَقَرَ الْمَرْءُ اسْتَهَانَ بِفَضْلِهِ","ذَوُو قُرْبِهِ وَاسْتَهْجَنَتْهُ الأَبَاعِدُ",30,"د",1,1],["إِذَا افْتَرَّ ثَغْرِي مِنْ خِلاَلِ كَآبَتِي","عَلَى مَا بِقَلْبِي مِنْ أَسى وَتَفَجُّعِ",31,"ع",1,0],["إذا افترقت أهواءُ قومِ تشَّتتوا","ولم يرجِعوا إلاّ بعارِ التخاذلِ",32,"ل",1,0],["إذا افترقتْ أجزاءُ جسمي لم أُبَلْ،","حُلولَ الرّزايا في مَصيفٍ، ولا مشتا",33,"ت",2,0],["اذا افتر جادت بالمدامع مقلتي","وراحت سماء الروح تزهو به الشهب",34,"ب",1,0],["إذا افتخر العدا يوماً بمال","وهموا بالجفا والانقطاع",35,"ع",1,1],["إذا أفلتته الأعين النجل أنشبت","به ظفرها الدامي بنان مخضب",36,"ب",1,0],["إذاً إفامَتْ فيه الجنوب كأنما","يدق به قِرفَ القَرَتفُل ناجبُه",37,"ب",2,0],["إذا افتخر الإنسانُ يوما بُبردِه","فما بُرُده إلا كريمُ خصالِ",38,"ل",1,0],["إِذا أُفحِموا قالوا وَإِن خَنَعوا نَخَوا","وَإِن بَخِلوا جادوا وَإِن هَزَلوا جَدّوا",39,"د",3,0],["إذا افتخر الطائي بنحر عشاره","ففخرك في نحر الألوف من التبر",40,"ر",1,0],["إذا أفاق امرؤ أومى لصاحبه","مقلباً كفه ما هكذا البشر",41,"ر",1,0],["إِذا اِفتَخَرَت بِالضَجعَمِيِّينَ قَومها","قُضاعَةُ وَاِنتاشَت عُرى العِزِّ قَحطانُ",42,"ن",1,0],["إذا افتخروا بمُلْكٍ ثم ملكٍ","فمِنْك كلاهما لا شكَّ قَرْض",43,"ض",1,0],["إذا أفلست أعرض أو تجنّى","وإن أيسرت قال أخي وروحي",44,"ح",2,0],["إذا أفقرت أغنت وإن هيّ ارخصَت","أعادت غلاء السعر في سنواتها",45,"ت",3,0],["إِذا اِفتَرَّ جادَت بِالمَدامِعِ مقلتي","كذا عند وَمضِ البرق تَنهَمِلُ السحبً",46,"ب",1,0],["إذا افترَّ ثغرُ الخودِ أو طرفُها رَنا","تطايرَ قَلبي من هُناكَ ومن هُنا",47,"ن",2,1],["إِذا اِفتَخَرَت مِصرٌ عَلَينا بِنيلِها","فَدَمعي فُراتٌ في دِمَشقَ وَنيلُ",48,"ل",1,0],["إِذا اِفتَرَّ عَن ثَغرِهِ أُخجِلَت","مِنَ الأُقحُوانِ الأَنيقِ الثُغورُ",49,"ر",1,0],["إِذا اِفتَرَّ ثَغرُ الهَزلِ عَبَّسَ جِدُّهُ","فَيالَكَ مِن هَزلٍ وَيا لَكَ مِن جِدِّ",50,"د",1,0],["إِذا اِفترَّ للنَدمانِ ثَغرُ حَبابِها","يُقابلُ مِنها البشر كلٌّ بتَعبيسِ",51,"س",1,0],["إذا أفاقوا على صدى","جلبة تجلب الضغن",52,"ن",1,0],["إذا افتخرَتْ مُلوكُ الأرضِ قِدْماً","بآثارٍ تُخَلِّفُها حِسان",53,"ن",1,0],["إذا افْتخرَتْ غدوْتَ لها لِساناً","أوِ انْتصرَتْ غدوْتَ لها حُساما",54,"م",2,0],["إذا افتْخَرَتْ بأَملاكٍ رِجالٌ","فمُفْتَخِرٌ بكَ المُلْكُ العَقيم",55,"م",1,0],["إذا افتخرَ الناسُ يومَ الندى","بأن يَرشَحوا وبأن يَقطروا",56,"ر",3,1],["إذا أفلتت من كف مختلس لها","تلقفها لص يطيل جفاها",57,"ا",3,0],["إذا افتَخر الأَنام وكان فيهم","فليس بغيره افتخر الأَنام",58,"م",1,0],["إذا افتخرت بنو آلٍ بآلٍ","ففخر الدِّين أَنت وفخر آلك",59,"ك",1,0],["إذا أفصَحَتْ عن كنه ذاتك غادرت","حَسودَك في إعرابها وهو أبكم",60,"م",1,0],["إذا افتخرت دولة بالرجال","وباهت محاسن أقرانها",61,"ن",3,0],["إذا أفيضت كؤوس الصاب في بلد","يفيض في غيرها شهدٌ وجريالُ",62,"ل",1,0],["إذا افترّ منها الثغر وجهها","ارتك سهيلا قد تصور بالثغر",63,"ر",1,0],["إِذا افترَّتِ الرَّاياتُ عن غُرَّتَيهِمَا","فيا لِلعِدَى أَضلَلتِ منهُم فِرَارَكِ",64,"ك",1,0],["إذا افتض منهن حورية","تعود كما فاتضها بانتهاد",65,"د",1,0],["أذا أفاق تعالت صيحةٌ كذبت","فلم تُعقَّب بمجهودٍ ليقظان",66,"ن",1,0],["إذا افتقدتَ نصره لغايةٍ","داس لها النار وخاضَ الفَحَما",67,"م",2,0],["إذا أفحمتني قولةٌ فُصحتْ له","وأقتلُ ألفاظِ الإناثِ ذُكورُها",68,"ر",3,0],["اذا افتخرتْ عُليا تيميم بن خندفٍ","وعَدَّتْ عُلاها مفخراً بعد مفْخر",69,"ر",1,0],["اذا افتخرتْ عليا ربيعة بالذي","سَما من عُلاها بين كعبٍ وعامرِ",70,"ر",1,1],["إذا افْترَّ ثغر الجهل عند قطوبهِ","أشاحَ بهَطَّالٍ من الدمع مُسْبلِ",71,"ل",1,0],["إذا افتخرت عُليا خُزيمة وانثنت","تعُدُّ المعالي منْ أخيرٍ وأوَّلِ",71,"ل",1,0],["إذا افتخرت عُلْيا عُقيلٍ وعُدِّدتْ","حوادثُ منْ عَلْيائها وقَدايمُ",72,"م",1,0],["إذا افعوعم الوادي فلا سال مذنب","وإن صرصر البازي فلا نطق النمل",73,"ل",1,0],["إِذا اِفتُرِعَت رَأَيتُ لَها حَبابا","كَعِقدِ كَواكِبٍ في جيدِ الشَمسِ",74,"س",1,0],["إِذا اِفتَخروا حازوا الفخارَ وطأطأوا","بأيديهمُ طولَ الفتى المتطاولِ",75,"ل",1,0],["إذا اِفْتَرَّ يوماً أو تبسّمَ مُغرِباً","فعن لؤلؤٍ عذبٍ نقيّ المضاحِكِ",76,"ك",1,0],["إِذا اِفتَرَّتِ الثَغرَ الخُطوبُ اِنبَرى لَها","بِعابِسَةٍ مُفتَرُّها الأَسرُ وَالقَتلُ",77,"ل",1,0],["إذا أفاضَ لِسانٌ منهُ في جَدَلٍ","مَضَى فأبلى لِسانَ الخَصْمِ بالخَرَسِ",78,"س",1,0],["إذا افتَخَرَتْ عُرْبُ البوادي ففخرُها","لهُ غُرَرٌ من تَغلِبٍ وحُجُولُ",79,"ل",1,0],["إذا افتخرت بلاد أنت منها","فقد أكسبتها مجدا وفخرا",80,"ر",2,0],["إِذا اِفتَخَرَ الشَرقُ القَديمُ بِسَيِّدٍ","تَميدُ بِذِكراهُ اِبتِهاجاً مَحافِلُه",81,"ل",2,1],["إِذا أَفاضَ عَلى العافي مَواهِبُهُ","أزرى بِغَيثٍ مِنَ الوَطفاءَ مُنهَمِرُ",82,"ر",1,0],["إذا أفتر أبرز قلح الأصول","كما كشر العير للنهقةِ",83,"ه",1,1],["إِذا اِفتخَرَ الأشراف يوماً بمفخرٍ","فإنّ له الفخر المحجّل يُنسبُ",84,"ب",1,0],["إذا اِفتخرَ الأشراف يوماً بمفخرٍ","فإنّ له الفخر المؤثّل يُنسبُ",85,"ب",1,0],["إذا أفلاكُها دارت فليست","لهنَّ كواكبٌ غيرُ الكؤوس",86,"س",1,0],["إَذا أَفلتَ الخطّيَّ في القوم طاعناً","تَراهُ إِذن يَنسابُ مِثلَ الأراقمِ",87,"م",1,0],["إذا افتخرتم ذكرتم جعفراً وكفى","ما انفك يفرج للغماء مشكلها",88,"ل",3,0],["إذا افتخرت م