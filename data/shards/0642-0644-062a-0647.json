etsgate.com/ViewPoem.aspx?id=36043",""],[4987,"النصايب","https://www.poetsgate.com/ViewPoem.aspx?id=49593",""],[5056,"<< هذيانُ شاعر..>>","https://www.poetsgate.com/ViewPoem.aspx?id=33175",""],[5183,"قلت","https://www.poetsgate.com/ViewPoem.aspx?id=186482",""],[5183,"ناشد الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=180191",""],[5194,"يا طيور","https://www.poetsgate.com/ViewPoem.aspx?id=30810",""],[5194,"شاعر وفنان","https://www.poetsgate.com/ViewPoem.aspx?id=35161",""],[5302,"هام قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201901",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5526,"مفردات الانعدام","https://www.poetsgate.com/ViewPoem.aspx?id=192429",""],[5573,"الفصول الاربعة","https://www.poetsgate.com/ViewPoem.aspx?id=200352",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5606,"الثقه متبادله بين الثقات","https://www.poetsgate.com/ViewPoem.aspx?id=196664",""],[4444,"لي خَليطانِ مُحكَمانِ يُجيدا","https://www.poetsgate.com/ViewPoem.aspx?id=85454",""],[5691,"روابي","https://www.poetsgate.com/ViewPoem.aspx?id=206590",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5718,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213899",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5739,"ساحر البطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127034",""],[5739,"زارع وخرّاف ..!","https://www.poetsgate.com/ViewPoem.aspx?id=145118",""],[5747,"ثمين الهرج","https://www.poetsgate.com/ViewPoem.aspx?id=61667",""],[5829,"نحن في الحال سوية","https://www.poetsgate.com/ViewPoem.aspx?id=153012",""],[5829,"انا والحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=157557",""],[5829,"كل ود","https://www.poetsgate.com/ViewPoem.aspx?id=211081",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""],[6249,"أفّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85663&r=&rc=6",""],[5190,"ها أنا يا نبض قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78297&r=&rc=10",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""],[572,"إِنَّ مظلومَة َ التي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9281&r=&rc=138",""]],"verses":[["قُلْتَ هَذَا بَتِّي سَأَلحَقُ بِالجَيْ","شِ فَإِمَّا العُلَى وَإِمَّا المَنُونُ",0,"ن",1,0],["قلت هَبْ أَنَّني كذبْتُ عليهم","فأرونِي من يستحقُّ المديحا",1,"ح",2,0],["قلت هل يبلغ اللهاة فقالت","إي لعمر الإله أيَّ بلوغ",2,"غ",1,0],["قلت هيهات أو يحل","لَ لأيري التكفُّف",3,"ف",1,0],["قُلتُ هَل تَحفَظينَ عَه","دي إِذا صاغَ عَسجَدي",4,"د",2,0],["قلته لا هيا به في شبابي","من هموم الهوى وبرح الصدود",5,"د",1,0],["قلت هاكم نوراً فظلوا عليه","يؤثرون البقاء في الظلمات",6,"ت",1,0],["قلت هذا ما لست افعل شيئاً","منه حتى اردى فدعني وتعسى",7,"س",2,0],["قلتها ومن أين أدرى","ربما صار حاجبا أو خفيرا",8,"ر",2,0],["قُلتُ هَب شَرَّ ما تُعاني وَقَد يُن","جيكَ مِن شَرِّ مَؤيِدٍ أَن تَهابَه",9,"ب",2,0],["قلتُ هيَّا قلتِ نمشي سِر فما","من طريقٍ طالَ لا نَذرَعُهُ",10,"ه",1,0],["قلت هيهات كم لعينيك عندي","من جميلٍ كم بات يهدى ويسدى",11,"د",2,0],["قلت هذا علمتُهُ غيرَ أنّي","أسألُ اليومَ منك ما لا يضيرُ",12,"ر",1,0],["قُلتُ هَذا خَيالُهُ لَيسَ هَذا","شَخصَهُ وَالغَرامُ يُعمي البَصيرا",13,"ر",2,0],["قلتُ هذَا شادُّ الدَّوَاوِينِ قالتْ","ما أَوَلّي هذا عَلَى الخَرَّارَهْ",14,"ر",2,0],["قُلتُ هَل بَعدَ ذا تَلاقٍ فَقالَت","كَيفَ تُلفى صَحيحَةٌ بَينَ جُربِ",15,"ب",1,0],["قلتها يوم جد عنها رحيلي","فمشت تدنو في صموت اليا",16,"ي",2,0],["قُلْتُ هَبْ لي يا حبِيبِي قُبْلَةً","تَشْفِ مِن غَمّك تَبريح الصَّدى",17,"د",2,0],["قُلْتُهُ عَنْ صَدَاقَةٍ وَإِذَا آ","يَاتُكَ ازْدَدْنَ فَهْوَ رَهْنُ ازْدِيَادِ",18,"د",1,0],["قلتُ هذِي جَنَّةٌ أم ما أرَى","أم تهاويلُ خَيالٍ كَذِبِ",19,"ب",1,0],["قلتُ هل أبصرتُمُ جسماً يُرَى","للإِخاءِ المحضِ أو صِدق الوفاء",20,"ا",2,0],["قلتُ: هل تحسب العصافير يومًا","لركوب الهواءِ أيَّ حساب؟",21,"ب",1,0],["قلت هل صار ثائرا وعلى من","وهو منّا هل يصبح الهزّ فيلا؟",22,"ل",2,0],["قلت هب لي يا حبيبي قبلة","تشف من عمك تبريح الصدى",23,"د",2,0],["قُلتُ هِى البَتُولُ قَالَ أَلَمَّا","تَسلُ عَنها فَقُلتُ قُلتَ عَظِيمَا",24,"م",2,0],["قلت هذا يروم شرباً وآلى","ليس يفتر عن لما الثغرِ ما لم",25,"م",1,0],["قُلتُ هَل أَبصَرتَ سَلمى","قالَ لا ثُمَّ تَوَلّى",26,"ل",2,0],["قلت همّي أنني رجل","مولع بالفكر والفطن",27,"ن",1,0],["قلت هل حرت مثلنا","في جمال يحير",28,"ر",1,0],["قُلتِ هذا الطَلى عَصَرناهُ مِنّا","وَشَرِبنا رُقاهُ في الميثاقِ",29,"ق",1,0],["قُلتُ هذا بَيني وَبَينَكِ حَقٌّ","إِنَّما لِلوَرى فُروضٌ وَكُتبُ",30,"ب",1,0],["قُلتُ هذا كلُّهُ عَبَثٌ","والتقى نوعٌ من الخلط",31,"ط",1,0],["قُلتُ هَذا رَأبي القَديمُ وَلَكِن","جِدلِيَ اليَومَ مِن عُيونِكَ أَمرُ",32,"ر",1,0],["قُلتُ هَل يُرجى لِنَفعٍ","قالَ كَنزٌ وَذَخيرُهُ",33,"ر",2,0],["قلت هذا وعد أعيش عليه","وأفدّى بالعالمين مكانه",34,"ن",2,0],["قلت هذا الضياء كان تراباً","أودع اللَهُ فيه سرّ سمائه",35,"ا",3,0],["قلت هذا حديثها سوف تحكي","ه وكم في شبابها قد حكاها",36,"ه",2,0],["قلتُ هذا البعث مجهول الندى","أترى يمتدُّ بي أم يقصرُ",37,"ر",1,0],["قلتُ هل أزعجتكَ نائحةُ القو","مِ وفي نوحِها حياةُ الفناء",38,"ا",2,0],["قُلتُ هَل عوداً لِأَعيادِ الصَفا","قالَ كَي تَقضي وَتَقضي أَجَلَي",39,"ي",1,0],["قُلت هَلّا اِشتَرَيتُم الشِعرَ مِنّي","قيل إِنّا لا نَشتَريهِ بِفلسِ",40,"س",1,0],["قلتُ هذا لصَوْمِ ستّةِ شَوّا","لٍ مُثيراً قد بان بالإيماء",41,"ا",2,0],["قلتَ هذا قد جاء يَطْلُبُ دارَيْ","نِ ومَن لي أنا بدُور العطاء",42,"ا",2,0],["قلت هذي درَّه","منظومةٌ بالسخب",43,"ب",1,0],["قُلتُ هذا مِصداق ما ذكروه","إنّ لِلْغيث باغِضاً ومحبّا",44,"ب",2,0],["قلت هذا بغيتي لكنه","لم يقل ذا أحد يا أملي",45,"ل",2,0],["قلت هذا حاصل في كل مَنْ","خالف الآل ففتش وسل",45,"ل",1,0],["قُلتُ هَذي صِبغَةُ اللّهِ ومَن","يصبُغُ الأسوَدَ مبيضّاً سِواهُ",46,"ه",1,0],["قلت هبني منيَّته كان ماذا","يتمنى قال الصِبا والتصابي",47,"ب",2,0],["قلت هل غير ذين قال دواع","ي الأنس تقضي لكل أمر عجاب",47,"ب",1,0],["قلت هل ترضى بدو","لار أجبني يا صديقي",48,"ي",1,0],["قلت هيهات أن أفوتك طوعا","أنت كنزي بل أنت روحي وفنّي",49,"ن",2,0],["قلت هل أحببت قالت","فتح الدمع عيوني",50,"ن",2,0],["قلتُ هَنيئا قَد وجَد","تَ الحِرفةَ المُوَاتِيَه",51,"ي",2,0],["قلتُ هَذا لعَمرِي مِنَّا قَليلٌ","كيفَ والطَّيّبُ المِريني عَرِيسُ",52,"س",1,0],["قلتُ هل تَعلَمُ ما أطلُبُه","قالَ هل تعلَمُ إنَّ الوقتَ ضَاق",53,"ق",1,0],["قلت هُنِّيْتَهُ عَلَى","رَغْمِ من خَالَفَ الخَبَرْ",54,"ر",1,0],["قلت هل تبغي بهذا ال","رقص باللّه اتصالا",55,"ل",2,0],["قلتُ هل لي منك وصل","قالَ لا يا عزّ لا لا",56,"ل",2,0],["قلت هل لي منك رزقٌ","قال دَع هذا المقالا",56,"ل",2,0],["قلت هل ذنباً ترى لي","قال ذنباً لن يقالا",56,"ل",2,0],["قلت هذا مولى الأنام معد","قد حوى الملك والإمامة طفلا",57,"ل",2,0],["قُلت هَذا قَول مُبغض","أَيُّها النَرجس أَعرض",58,"ض",1,0],["قلت هذا المقام قال نعم","قلت وما يدعى فقال الحيره",59,"ر",2,0],["قلت هذا من كيد كنّ عظيمٌ","يا حبال الشيطان أو يا ظباء",60,"ا",2,0],["قلت هذا بشرط أن تطفئوا ما","في الحوايا وهل له إطفاء",60,"ا",2,0],["قلت هب لي أسد اللَه","ودعني في جهنم",61,"م",1,0],["قُلت هاتي الَّتي بِها يُستَمال ال","شادن الصَعبُ وَالنُفوس الأَبيه",62,"ي",2,0],["قلت هل أبصرت ظبياً شرداً","قال هل أبصرت ظبياً شردا",63,"د",2,0],["قلت هذي الشهباء فانتجع الخ","صب تجد للغِنَى ثماراً جنيّه",64,"ي",2,0],["قلت هذا وعظ لغيري وما","مثلي ممن يخشى بياض القتير",65,"ر",1,0],["قلتُ هَل في محبَّتي لك رَيبٌ","قَالَ أَقصِر فلستُ أعلمُ غَيبا",66,"ب",2,0],["قلتُ هَل تمزِجُنَّها بِالسحابِ","قُلنَ آناً وَتارَةً بِالرُضابِ",67,"ب",1,0],["قُلتُ هذا صَومُ النَصارى فَحُلّوا","لا تُليحوا شُيوخَكُم في السَموم",68,"م",1,0],["قلتَ هذي زَرَابيٌ نمَّقتها","عُلَماءُ الأتراكِ للخاقانِ",69,"ن",1,0],["قلت هذا سلامةٌ من نعاهُ","قالتِ الآن حدَّث الطائران",70,"ن",1,0],["قلت: هاجي ابن قنبر، فتسربل","ت بذكري فخراً لدى النسّاب",71,"ب",1,0],["قلت هذه معجزات لا أرى","قدرة الناس بها تستقرن",72,"ن",1,0],["قلتَ هاكُمْ فانتُفوا أسودَها","لحيتي تنمي على هذا الحساب",73,"ب",1,0],["قلت هاتيك شظايا مهجتي","قُبَلاَ تُدعى وتُدعى لهفات",74,"ت",1,0],["قلت هذا الجمال حولك فانظر","ودع الفلسفات والأقوالا",75,"ل",2,0],["قلت هل في الهوى على الصب عار","قال ما اهتم بالغرام شريف",76,"ف",1,0],["قلت هذي معاهد الانس لكن","أين عهد الهنا وعهد التصابي",77,"ب",2,0],["قلت هات الكاس هاتِ","فأنا جمع الشتاتِ",78,"ت",1,0],["قلت هلا شفيت وجد قلوب","نارها مثل وجنتيك ذكيه",79,"ي",2,0],["قلت هذا الجمال لما تبدى","أشغل الكاتبين عن سيئاتي",80,"ي",1,0],["قلت هَلاّ صدقتِ فِي الوعدِ قالت","كَيْفَ صدقي وهل تُرى الشمسُ ليلا",81,"ل",2,0],["قلتُ هذي روضَةٌ هيّا بنَا","نتصابى فمشينَاها الهوينَا",82,"ن",2,0],["قُلْتُ هذا تخرُّصٌ","قلبُ بهرام ما رهبْ",83,"ب",1,0],["قُلتُ هَل تَألَمُ شَيئاً","قالَ أَثقالَ الذُنوبِ",84,"ب",1,0],["قُلتُ هاذي لُغَةٌ أُنكِرُها","زادَتِ القَلبَ المُعَيّى خَبَلا",85,"ل",2,0],["قلت هلا صدقت في الوعد قالت","هل توهمت أن ترى الشمس ليلا",86,"ل",2,0],["قلت هذا منيتي منها فما","لي عنها للذي قلتم عدول",87,"ل",1,0],["قلت: هل دام غرام بينهم","ريثما يُفرَغ من نظم القصيدْ",88,"د",1,0],["قلت هذا، وتقدمت إلى","هوة الغيب، وفي الثغر ابتسامْ",89,"م",1,0],["قُلتُ هَيهاتَ شَفيع أَو أَرى","فَضلَ سَعدِ الدينِ فيهِنَّ شَفيعا",90,"ع",2,0],["قُلتُ هَيّا قومي فَإِنَّ فُؤادي","يا حَياتي يَهدُّهُ طولُ حُزني",91,"ي",1,0],["قلت هَل أَبصَرتم الن","عشَ مَحمولا",92,"ل",2,0],["قلت هذا شُغُلي فما زال يُدْ","ني ويحتال لي بفَرْكٍ ولَكْزِ",93,"ز",1,0],["قلت هذَاك للضَّرورة فاسْتَضْ","حَكَ تِيهاً وقال كالمُستهزي",93,"ز",2,0],["قلتَ هَذا وَقُلتُ أَكثر لَكِن","لَم أَجد لي وَاذلَّتي مِن سَميعِ",94,"ع",1,0],["قلت هل تنكرن صباً مولعا","بذوات الأعين المرضى الصحاح",95,"ح",1,0],["قُلتُ هذا لَكُم فَما حَظُّنا مِن","هُ فَقالَت حَظُّ الحَسودِ حِجارَه",96,"ر",2,0],["قلت هل يجهل معروف له","صوت صيت فيه غنى الثقلان",97,"ن",1,0],["قلت: هبني خلال عود وهب لي","فضل ريق توليه عود الخلال",98,"ل",1,0],["قُلتُ هَيهاتَ أنت تَلقاهُ يَوماً","ثُمَّ تغدو من اللِّقا مَحرُومَا",99,"م",2,0],["قلتُ هذه جنات عدن