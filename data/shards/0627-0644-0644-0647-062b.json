{"poems":[[87,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[107,"أمل يزف مع السنين عروسا","https://www.aldiwan.net/poem42084.html","الكامل"],[104,"كفكف دموعك ليس ينفعك","https://www.aldiwan.net/poem33114.html","مجزوء الكامل"],[201,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[240,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[333,"أكبرت عيدك هجرة المختار","https://www.aldiwan.net/poem54964.html","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200007","البسيط"]],"verses":[["اللَهُ ثَبَّتَ أَرضَهُ بِدَعائِمٍ","هُم حائِطُ الدُنيا وَرُكنُ المَجمَعِ",0,"ع",1,0],["اللهُ ثَبّتَ جانِبَيْكَ بمؤمنٍ","شدَّ البناءَ وأحكمَ التاسيسا",1,"س",2,0],["اللهَ ثم أللهَ ما أْح","لى التَّضاُمنَ والوفاقا",2,"ق",2,0],["اللَهُ ثالثنا ورا","بِعنا ابنة الطلعِ الهضيم",3,"م",1,0],["اللَهَ ثُمَّ اللَهَ إِن","رُفِعَ الحِجابُ وَأَنتَ واقِف",4,"ف",1,0],["اللَه ثالثنا فلا تحزن ومن","ينصره يأمَن من أذىً وضِرار",5,"ر",1,0],["اللهُ ثَالِثُنَا وتِلكَ فَضِيلةٌ","مَا حَازَهَا إلاَّ فَتَى عُثمَانِ",6,"ن",1,0],["الله ثالثنا في جوف معبدنا","ولا أقول إلهي ثالث اثنين",7,"ن",1,0]]}