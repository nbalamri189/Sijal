ُ","كَذا الدَهرُ يَعصي مَرَّةً وَيُطيعُ",0,"ع",1,1],["خَصَّني اللَهُ بِهذا","الحُبِّ دونَ الناسِ وَحدي",1,"د",2,0],["خُصِصْتُ بالحُسْنِ وانْفَرَدْتُ بِه","فجَلّ وزْني وقَلّ أشْباهِي",2,"ي",1,1],["خَصَصْتُكَ يَا مَوْلَى الْمُلُوكِ بِخِدْمَتِي","وَإِنْ كَانَتِ الأَفْلاَكُ مِنْ بَعْضِ خُدَّامِي",3,"ي",1,0],["خصّكَ اللهُ بالكَمالِ وزَنْدُ الكوْ","نِ لم تَقْتَرِنْ بكَفِّ اقْتِداح",4,"ح",1,0],["خَصَّها اللَهُ بِأُفقٍ مُشرِقٍ","ضَمَّ في اللَألاءِ مِصراً وَالشَآما",5,"م",2,0],["خَصَّها اللَهُ في الكِتابِ بِذِكرٍ","فَهيَ رُكنُ الأَركانِ في الإِسلامِ",6,"م",1,0],["خَصَّهُ اللَهُ حَيثُ يُصبِحُ بِالإِق","بالِ وَالعِزِّ وَالعُلا حَيثُ يُمسي",7,"س",2,0],["خَصَّني بِالأَدَبِ اللَهُ","فَأَعلى فيهِ شاني",8,"ي",1,0],["خَصَصتُ بِها أَخا الأَحرارِ قَيساً","فَتىً في بَيتِ مَكرُمَةٍ كَريمِ",9,"م",1,0],["خَصَّ بِالأَقْرَبِينَ مُجَلاَّهُ إِلاَّ","إِنَّهُ مَبْعَثُ ابْتِهَاجٍ عَمِيمِ",10,"م",1,0],["خِصْبَ الْجَنَانِ بَعِيداً","عَنِ الْجُمُودِ الْعَقِيمِ",11,"م",1,0],["خصام يضحك السُفهاءُ منه","ويبكي منه أرباب الحَصافه",12,"ف",2,0],["خَصَيتُ مُجاشِعاً وَشَدَدتُ وَطئي","عَلى أَعناقِ تَغلِبَ وَاِعتِمادي",13,"ي",1,0],["خَصَيتُ مُجاشِعاً وَجَدَعتُ تَيماً","وَعِندي فَاِعلَموا لَهُمُ مَزيدُ",14,"د",1,0],["خُصِيَ الفَرَزدَقُ وَالخَصاءُ مَذَلَّةٌ","يَرجو مُخاطَرَةَ القُرومِ البُزَّلِ",15,"ل",1,0],["خُصَيَّ حِمارٍ ماتَ بِالأَمسِ نَوفَلاً","مَتى كُنتَ مِفلاحاً عَدُوَّ الحَقائِبِ",16,"ب",1,0],["خصصت بالمدحِ اللاتي قد ارْتفعت","منِّي الثناء ومن نعماك آلات",17,"ت",1,0],["خصَّ في وصفِ لفظه وبهاه","بأمينٍ على الورى ورشيد",18,"د",1,0],["خصمى من الأولاد جا","ر وأنت أولى من خصم",19,"م",1,0],["خصصّت فيك بسهدي والدموع كما","خصّ ابن جاديك بالتقوى وبالكرم",20,"م",1,0],["خَصَّني واحِدي بِتَوحيدِ صدقٍ","ما إِلَيهِ مِنَ المَسالِكِ طُرقُ",21,"ق",1,1],["خَصصتُ وأَثنى بالعموم ولم أكن","كصاحب نومٍ هبَّ بعد هجودِهِ",22,"د",2,0],["خص الإمام وعمَّ الناس كلهُمُ","رزءٌ لعمر المنايا غير مجبور",23,"ر",1,0],["خصيمُك اللَه فانظر كيف تخصمُهُ","بل أنت أدحض خصمٍ فوكَ للحجر",24,"ر",1,0],["خُصَّ الوزير ببيت مجد زاده","بيديه تشريفاً على تشريفه",25,"ف",2,0],["خصيمُ الليالي والغواني مُظلَّمُ","وعهد الليالي والغواني مُذمَّمُ",26,"م",1,1],["خَصمانِ لي أَنا مِنهُما","في شِدَّةٍ بَل شِدَّتَينِ",27,"ن",1,0],["خَصْرُهُ من نَحافَتي","وَنُحولي تَمَنْطَقا",28,"ق",2,0],["خصيب الرحاب رهيب الجناب","إذا ما أمرتَ الزمان امتثل",29,"ل",1,0],["خصر نحيل لين","على ثقيل مفعم",30,"م",1,0],["خَصرُهُ هَبا","صَدرُهُ صَبَب",31,"ب",1,0],["خَصّوكَ مِن أُسطولِهِم بِدَعامَةٍ","يُبنى عَلَيها رُكنُهُ وَيُقامُ",32,"م",1,0],["خَصَّ الجَماجِمَ وَالوُجوهَ كَأَنَّما","جاءَت إِلَيكَ جُسومُهُم بِأَمانِ",33,"ن",1,0],["خُصومُ النائِباتِ وَكانَ مَجداً","تَوَلّيهِم دِفاعَ النائِباتِ",34,"ت",1,0],["خَصيبٌ إِذا ما الأَرضُ صَوَّحَ نَبتُها","حَليمٌ إِذا أَخفى المَلومَ الرَواسِخُ",35,"خ",1,0],["خِصالٌ حَواها مِن أَبيهِ وَجَدِّهِ","وَأَكسَبَهُ أَسيافُهُ وَالمَشايِخُ",35,"خ",1,0],["خُصِصتَ بِقَلبٍ في الشَدائِدِ جامِدٍ","فَزانَكَ كَفٌّ بِالمَكارِمِ ناصِخُ",35,"خ",1,0],["خصّتْ بطائرَةٍ على فَنَنٍ لها","حَسُنَتْ فَأُفْرِدَ حُسْنُها من ثانِ",36,"ن",1,0],["خُصِصْتَ بالجود والبأس المنوط به","والجودُ والبأسُ مولودان في الشيمِ",37,"م",1,0],["خُصَّتْ مِنَ الصوتِ بمعنى مؤيسٍ","من لغة الوصل ولفظٍ مُطْمِعِ",38,"ع",1,0],["خُصَّتْ بِنَوالٍ شيمَتُهُ","عَجِلٍ وكلامٍ مُتّئِدِ",39,"د",1,0],["خصْرُ خبازِكمْ رقيقٌ ولكنْ","بطنُهُ عجنةٌ فدعْ فيهِ نصحي",40,"ي",1,1],["خصرُكَ يا مَنْ حوى ببهجتِهِ","محاسناً ما اجتمعنَ في عبدِ",41,"د",1,1],["خَصَصتُ الأَخَصَّ بِها أَثرَةً","وَحَيَّيتُ بِالأَطيَبِ الأَطيَبا",42,"ب",2,0],["خَصمان يَعصفُ بالمضاجعِ منكما","تحت الظّلامِ تَغضُّبٌ وشِقاقُ",43,"ق",1,0],["خُصَّت بِهِ مَنورَقَةٌ وَسَناؤُهُ","قَد نَوَّرَ الآفاقَ حَتّى أَقمَرا",44,"ر",2,0],["خِصافِ النَعلِ إِذ يُمشى عَلَيها","مُوَطَّأَةً مَطِيَّةَ كُلِّ حافي",45,"ي",1,0],["خَصَّكَ اللَهُ بِالعِمارَةِ مِنهُ","وَوَقاكَ المَليكُ وَشكَ الخَرابِ",46,"ب",1,0],["خَصَّهُ اللَّهُ بِخُلْقٍ كريمٍ","وَدَعا الفَضلَ له فاسْتجابا",47,"ب",2,0],["خَصَمَ العِبادَ بِحُجَّةِ اللَّهِ الَّتي","أمْسَى بها عُذْرُ الوَرَى مَتْبُولا",48,"ل",2,0],["خَصَّ بِهِ اللَهُ الأَمينَ الَّذي","أَضحى بِتاجِ المُلكِ قَد تُوِّجا",49,"ج",2,0],["خَصرٌ لَطيفٌ كَشحُهُ","مَجرى الوِشاحِ لَها خَضيدُ",50,"د",1,0],["خَصَيتُ عَدوانَ بَعدَ شَيلَتِهِ","وَاللَيثُ يُخصى وَيُخدَعُ الشَبَبُ",51,"ب",1,0],["خِصاؤُكَ خَيرٌ مِن زَواجِكَ حُرَّةً","فَكَيفَ إِذا أَصبَحتَ زَوجاً لِمومِسِ",52,"س",1,1],["خَصَّتكَ نَخلَةُ أَرضٍ أَطعَمَتكَ جِنىً","فَاِجعَلَ لَها دونَ نَخلِ القَومِ تَحويضا",53,"ض",2,0],["خَصِرُ اللّمى عذْبُ المُقَبَّلِ بُكْرةً","قبلَ السّواكِ المِسْكَ ساد وشاذى",54,"ذ",2,0],["خصها اللَه في الوَرى بِمَزايا","أكبرتها فراسة الأقوام",55,"م",1,0],["خَصِيمانِ هَذا بِالْفُؤَادِ مُخَيِّمٌ","وَذلكَ عَنْ مَرْمَى الْقَذِيفَةِ نازِحُ",56,"ح",1,0],["خصَّ بِالقَدْرِ صَاحِبُ الوَفْرِ حَتَّى","وَهْوَ لِلصْخْرِ بِالجَفَاف مَثيلُ",57,"ل",1,0],["خُصصتُ بِذا المُصابِ وَعَمّ كُلّ","وَلَيسَ عُمومهُ مِثل الخُصوصِ",58,"ص",1,1],["خَصْمٌ شَرِيفٌ نَالَ مِنْ خُصَمَائِهِ","مَا نَالَ مِنْ إِجْلالِ كُلِّ مُوَاليِ",59,"ل",2,0],["خصمٌ شريفٌ إذ يصول، وربما","أغضى، فكان القتلُ في إغضائه",60,"ا",3,0],["خصمنا اليوم غيره الأمس طبعا","البراميل أمركت (شيخ ضبّه)",61,"ب",2,0],["خصيبُ عدوانَ بعد شيلتهِ","والليثُ يخصى ويخدعُ الشببُ",62,"ب",1,0],["خَصَّتْهُ باللُطفِ منها فهو مُنْبَعِثٌ","ورُبَّ وادٍ جَفتْهُ فهو موءود",63,"د",1,0],["خصبَ الشُعور ستَحَمدين مولَّهاً","من أهله ، ومُغازلاً ، ومُراوِدا",64,"د",2,0],["خُصَّ بالمحض من بُلهَنَيةِ العَيشِ","وأُعطي من الصبا عنفوانه",65,"ن",2,0],["خصال الذي اهوى تسيء وانما","هو الحب حكم في الحقيقة مقضي",66,"ي",1,0],["خصال طه قامت ببضعته","سبحانه الخالق الذي يهب",67,"ب",1,0],["خصوصاً لأصحاب الطريق شيوخنا","أولى العلم أهل الإطلاع على السر",68,"ر",1,0],["خصَّه اللهُ بالضياءِ وبالرحمةِ","ثمَّ القرآن والتَّصديقِ",69,"ق",1,0],["خصصْتكُم بها فاخلعْ عليها","لباسَ الجودِ والإحسان خَلْعَا",70,"ع",2,0],["خصت إماماً للبريةِ مجتبىً","براً تقياً خاشعاً أوابا",71,"ب",2,0],["خُصومٌ ينظرون إلىَّ شَزْرا","ومن ذا يقهَر الخصمَ المُوَلَّى",72,"ل",2,0],["خَصَّ الإِلَهُ مُحَمَّداً مِن بَينِكُم","لا زالَ مَحروساً بِأَكرَمِ آلِ",73,"ل",1,0],["خَصَّتكَ بِالخَطَرِ العَظيمِ مَناقِبٌ","تَستَغرِقُ الإِجلالَ وَالإِعظاما",74,"م",2,0]