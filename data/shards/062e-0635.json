{"poems":[[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[55,"لم أجد أهلا لودي","https://www.aldiwan.net/poem26394.html","مجزوء الرمل"],[77,"خصصت بالحسن وانفردت به","https://www.aldiwan.net/poem35852.html","المنسرح"],[77,"أمولاي دمت الدهر منصور أعلام","https://www.aldiwan.net/poem36104.html","الطويل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[86,"بالذي أجراك يا ريح الخزامى","https://www.aldiwan.net/poem10684.html","الرمل"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[73,"لا افتنان كافتناني","https://www.aldiwan.net/poem11970.html","مجزوء الرمل"],[10,"فدى للفارس الجشمي نفسي","https://www.aldiwan.net/poem21133.html","الوافر"],[93,"بارك الله في قران النجيبين","https://www.aldiwan.net/poem11381.html","الخفيف"],[93,"أطاش حلم الحليم","https://www.aldiwan.net/poem11407.html","المجتث"],[88,"أرى الأتراك في دار الخلافه","https://www.aldiwan.net/poem44827.html","الوافر"],[27,"أتنسى دارتي هضبات غول","https://www.aldiwan.net/poem5725.html","الوافر"],[27,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[23,"لحا الله قوما لم ندع من سراتهم","https://www.aldiwan.net/poem21534.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"لا ورشف اللمى ولثم الخدود","https://www.aldiwan.net/poem18561.html","الخفيف"],[72,"بانت سعاد حقيقة","https://www.aldiwan.net/poem19689.html","مجزوء الكامل"],[72,"يا فاتكا خده لي شامتا بدمي","https://www.aldiwan.net/poem19988.html","البسيط"],[64,"خصني واحدي بتوحيد صدق","https://www.aldiwan.net/poem67622.html","الخفيف"],[51,"قدمت قدوم البدر بيت سعوده","https://www.aldiwan.net/poem61823.html","الطويل"],[51,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[70,"حتى متى وإلى متى","https://www.aldiwan.net/poem42433.html","مجزوء الكامل"],[92,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[85,"أنلني يدا خلقت للقبل","https://www.aldiwan.net/poem7351.html","المتقارب"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[85,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[43,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[45,"نصيبي منك لوم العاذلات","https://www.aldiwan.net/poem62649.html","الوافر"],[66,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[80,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[80,"حتى متى بين اللوى فالأجرع","https://www.aldiwan.net/poem31391.html","الرجز"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[69,"خصر خبازكم رقيق ولكن","https://www.aldiwan.net/poem28455.html","الخفيف"],[69,"خصرك يا من حوى ببهجته","https://www.aldiwan.net/poem28881.html","المنسرح"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[105,"يا مالكا عنت الوجوه لعزه","https://www.aldiwan.net/poem42114.html","الكامل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[40,"تلك عرسي تلومني في التصابي","https://www.aldiwan.net/poem42300.html","الخفيف"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"قد ركب الدلفين بدر الدجى","https://www.aldiwan.net/poem62491.html","السريع"],[50,"عاد الغداة الصب عيد","https://www.aldiwan.net/poem63944.html","مجزوء الكامل"],[50,"عامت سليمى ومسها سغب","https://www.aldiwan.net/poem64838.html","المنسرح"],[46,"خصاؤك خير من زواجك حرة","https://www.aldiwan.net/poem22821.html","الطويل"],[46,"بعض الرجال كقبر الميت تمنحه","https://www.aldiwan.net/poem22888.html","البسيط"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85381","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43767","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[50,"عامت \"سليمى \" ومسّها سغبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17136",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""]],"verses":[["خَصيمٌ مِنَ الأَيّامِ لي وَشَفيعُ","كَذا الدَهرُ يَعصي مَرَّةً وَيُطيعُ",0,"ع",1,1],["خَصَّني اللَهُ بِهذا","الحُبِّ دونَ الناسِ وَحدي",1,"د",2,0],["خُصِصْتُ بالحُسْنِ وانْفَرَدْتُ بِه","فجَلّ وزْني وقَلّ أشْباهِي",2,"ي",1,1],["خَصَصْتُكَ يَا مَوْلَى الْمُلُوكِ بِخِدْمَتِي","وَإِنْ كَانَتِ الأَفْلاَكُ مِنْ بَعْضِ خُدَّامِي",3,"ي",1,0],["خصّكَ اللهُ بالكَمالِ وزَنْدُ الكوْ","نِ لم تَقْتَرِنْ بكَفِّ اقْتِداح",4,"ح",1,0],["خَصَّها اللَهُ بِأُفقٍ مُشرِقٍ","ضَمَّ في اللَألاءِ مِصراً وَالشَآما",5,"م",2,0],["خَصَّها اللَهُ في الكِتابِ بِذِكرٍ","فَهيَ رُكنُ الأَركانِ في الإِسلامِ",6,"م",1,0],["خَصَّهُ اللَهُ حَيثُ يُصبِحُ بِالإِق","بالِ وَالعِزِّ وَالعُلا حَيثُ يُمسي",7,"س",2,0],["خَصَّني بِالأَدَبِ اللَهُ","فَأَعلى فيهِ شاني",8,"ي",1,0],["خَصَصتُ بِها أَخا الأَحرارِ قَيساً","فَتىً في بَيتِ مَكرُمَةٍ كَريمِ",9,"م",1,0],["خَصَّ بِالأَقْرَبِينَ مُجَلاَّهُ إِلاَّ","إِنَّهُ مَبْعَثُ ابْتِهَاجٍ عَمِيمِ",10,"م",1,0],["خِصْبَ الْجَنَانِ بَعِيداً","عَنِ الْجُمُودِ الْعَقِيمِ",11,"م",1,0],["خصام يضحك السُفهاءُ منه","ويبكي منه أرباب الحَصافه",12,"ف",2,0],["خَصَيتُ مُجاشِعاً وَشَدَدتُ وَطئي","عَلى أَعناقِ تَغلِبَ وَاِعتِمادي",13,"ي",1,0],["خَصَيتُ مُجاشِعاً وَجَدَعتُ تَيماً","وَعِندي فَاِعلَموا لَهُمُ مَزيدُ",14,"د",1,0],["خُصِيَ الفَرَزدَقُ وَالخَصاءُ مَذَلَّةٌ","يَرجو مُخاطَرَةَ القُرومِ البُزَّلِ",15,"ل",1,0],["خُصَيَّ حِمارٍ ماتَ بِالأَمسِ نَوفَلاً","مَتى كُنتَ مِفلاحاً عَدُوَّ الحَقائِبِ",16,"ب",1,0],["خصصت بالمدحِ اللاتي قد ارْتفعت","منِّي الثناء ومن نعماك آلات",17,"ت",1,0],["خصَّ في وصفِ لفظه وبهاه","بأمينٍ على الورى ورشيد",18,"د",1,0],["خصمى من الأولاد جا","ر وأنت أولى من خصم",19,"م",1,0],["خصصّت فيك بسهدي والدموع كما","خصّ ابن جاديك بالتقوى وبالكرم",20,"م",1,0],["خَصَّني واحِدي بِتَوحيدِ صدقٍ","ما إِلَيهِ مِنَ المَسالِكِ طُرقُ",21,"ق",1,1],["خَصصتُ وأَثنى بالعموم ولم أكن","كصاحب نومٍ هبَّ بعد هجودِهِ",22,"د",2,0],["خص الإمام وعمَّ الناس كلهُمُ","رزءٌ لعمر المنايا غير مجبور",23,"ر",1,0],["خصيمُك اللَه فانظر كيف تخصمُهُ","بل أنت أدحض خصمٍ فوكَ للحجر",24,"ر",1,0],["خُصَّ الوزير ببيت مجد زاده","بيديه تشريفاً على تشريفه",25,"ف",2,0],["خصيمُ الليالي والغواني مُظلَّمُ","وعهد الليالي والغواني مُذمَّمُ",26,"م",1,1],["خَصمانِ لي أَنا مِنهُما","في شِدَّةٍ بَل شِدَّتَينِ",27,"ن",1,0],["خَصْرُهُ من نَحافَتي","وَنُحولي تَمَنْطَقا",28,"ق",2,0],["خصيب الرحاب رهيب الجناب","إذا ما أمرتَ الزمان امتثل",29,"ل",1,0],["خصر نحيل لين","على ثقيل مفعم",30,"م",1,0],["خَصرُهُ هَبا","صَدرُهُ صَبَب",31,"ب",1,0],["خَصّوكَ مِن أُسطولِهِم بِدَعامَةٍ","يُبنى عَلَيها رُكنُهُ وَيُقامُ",32,"م",1,0],["خَصَّ الجَماجِمَ وَالوُجوهَ كَأَنَّما","جاءَت إِلَيكَ جُسومُهُم بِأَمانِ",33,"ن",1,0],["خُصومُ النائِباتِ وَكانَ مَجداً","تَوَلّيهِم دِفاعَ النائِباتِ",34,"ت",1,0],["خَصيبٌ إِذا ما الأَرضُ صَوَّحَ نَبتُها","حَليمٌ إِذا أَخفى المَلومَ الرَواسِخُ",35,"خ",1,0],["خِصالٌ حَواها مِن أَبيهِ وَجَدِّهِ","وَأَكسَبَهُ أَسيافُهُ وَالمَشايِخُ",35,"خ",1,0],["خُصِصتَ بِقَلبٍ في الشَدائِدِ جامِدٍ","فَزانَكَ كَفٌّ بِالمَكارِمِ ناصِخُ",35,"خ",1,0],["خصّتْ بطائرَةٍ على فَنَنٍ لها","حَسُنَتْ فَأُفْرِدَ حُسْنُها من ثانِ",36,"ن",1,0],["خُصِصْتَ بالجود والبأس المنوط به","والجودُ والبأسُ مولودان في الشيمِ",37,"م",1,0],["خُصَّتْ مِنَ الصوتِ بمعنى مؤيسٍ","من لغة الوصل ولفظٍ مُطْمِعِ",38,"ع",1,0],["خُصَّتْ بِنَوالٍ شيمَتُهُ","عَجِلٍ وكلامٍ مُتّئِدِ",39,"د",1,0],["خصْرُ خبازِكمْ رقيقٌ ولكنْ","بطنُهُ عجنةٌ فدعْ فيهِ نصحي",40,"ي",1,1],["خصرُكَ يا مَنْ حوى ببهجتِهِ","محاسناً ما اجتمعنَ في عبدِ",41,"د",1,1],["خَصَصتُ الأَخَصَّ بِها أَثرَةً","وَحَيَّيتُ بِالأَطيَبِ الأَطيَبا",42,"ب",2,0],["خَصمان يَعصفُ بالمضاجعِ منكما","تحت الظّلامِ تَغضُّبٌ وشِقاقُ",43,"ق",1,0],["خُصَّت بِهِ مَنورَقَةٌ وَسَناؤُهُ","قَد نَوَّرَ الآفاقَ حَتّى أَقمَرا",44,"ر",2,0],["خِصافِ النَعلِ إِذ يُمشى عَلَيها","مُوَطَّأَةً مَطِيَّةَ كُلِّ حافي",45,"ي",1,0],["خَصَّكَ اللَهُ بِالعِمارَةِ مِنهُ","وَوَقاكَ المَليكُ وَشكَ الخَرابِ",46,"ب",1,0],["خَصَّهُ اللَّهُ بِخُلْقٍ كريمٍ","وَدَعا الفَضلَ له فاسْتجابا",47,"ب",2,0],["خَصَمَ العِبادَ بِحُجَّةِ اللَّهِ الَّتي","أمْسَى بها عُذْرُ الوَرَى مَتْبُولا",48,"ل",2,0],["خَصَّ بِهِ اللَهُ الأَمينَ الَّذي","أَضحى بِتاجِ المُلكِ قَد تُوِّجا",49,"ج",2,0],["خَصرٌ لَطيفٌ كَشحُهُ","مَجرى الوِشاحِ لَها خَضيدُ",50,"د",1,0],["خَصَيتُ عَدوانَ بَعدَ شَيلَتِهِ","وَاللَيثُ يُخصى وَيُخدَعُ الشَبَبُ",51,"ب",1,0],["خِصاؤُكَ خَيرٌ مِن زَواجِكَ حُرَّةً","فَكَيفَ إِذا أَصبَحتَ زَوجاً لِمومِسِ",52,"س",1,1],["خَصَّتكَ نَخلَةُ أَرضٍ أَطعَمَتكَ جِنىً","فَاِجعَلَ لَها دونَ نَخلِ القَومِ تَحويضا",53,"ض",2,0],["خَصِرُ اللّمى عذْبُ المُقَبَّلِ بُكْرةً","قبلَ السّواكِ المِسْكَ ساد وشاذى",54,"ذ",2,0],["خصها اللَه في الوَرى بِمَزايا","أكبرتها فراسة الأقوام",55,"م",1,0],["خَصِيمانِ هَذا بِالْفُؤَادِ مُخَيِّمٌ","وَذلكَ عَنْ مَرْمَى الْقَذِيفَةِ نازِحُ",56,"ح",1,0],["خصَّ بِالقَدْرِ صَاحِبُ الوَفْرِ حَتَّى","وَهْوَ لِلصْخْرِ بِالجَفَاف مَثيلُ",57,"ل",1,0],["خُصصتُ بِذا المُصابِ وَعَمّ كُلّ","وَلَيسَ عُمومهُ مِثل الخُصوصِ",58,"ص",1,1],["خَصْمٌ شَرِيفٌ نَالَ مِنْ خُصَمَائِهِ","مَا نَالَ مِنْ إِجْلالِ كُلِّ مُوَاليِ",59,"ل",2,0],["خصمٌ شريفٌ إذ يصول، وربما","أغضى، فكان القتلُ في إغضائه",60,"ا",3,0],["خصيبُ عدوانَ بعد شيلتهِ","والليثُ يخصى ويخدعُ الشببُ",61,"ب",1,0],["خَصَّتْهُ باللُطفِ منها فهو مُنْبَعِثٌ","ورُبَّ وادٍ جَفتْهُ فهو موءود",62,"د",1,0],["خصبَ الشُعور ستَحَمدين مولَّهاً","من أهله ، ومُغازلاً ، ومُراوِدا",63,"د",2,0],["خُصَّ بالمحض من بُلهَنَيةِ العَيشِ","وأُعطي من الصبا عنفوانه",64,"ن",2,0]]}