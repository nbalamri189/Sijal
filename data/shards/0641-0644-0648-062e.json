{"poems":[[72,"سأعرض عمن راح عني معرضا","https://www.aldiwan.net/poem42835.html","الطويل"],[45,"أرى ذلك القرب صار ازورارا","https://www.aldiwan.net/poem9565.html","المتقارب"],[68,"عيون لها مرأى الأحبة إثمد","https://www.aldiwan.net/poem40291.html","الطويل"],[35,"ألا يا نسيم الريح حكمك جائر","https://www.aldiwan.net/poem25980.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[203,"أدرت عيونك في كل وجه","https://www.aldiwan.net/poem45182.html","المتقارب"],[208,"تظرفت لما قلت لا تتظرفي","https://www.aldiwan.net/poem53247.html","الطويل"],[422,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[447,"لقد أكثرت في الترب المراثي","https://www.aldiwan.net/poem14357.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38659","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17571","الطويل"],[1594,"","https://poetry.dctabudhabi.ae/diwan/poem/97767","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96028","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205030","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204579","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118780","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62778","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86244","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86265","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59474","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45056","الطويل"],[4955,"قالوا تصبر فقلت الصبر من شيمي","https://www.poetsgate.com/ViewPoem.aspx?id=198919",""],[4119,"أبرق في الثغور من الثغور","https://www.poetsgate.com/ViewPoem.aspx?id=16161",""]],"verses":[["فَلَو خانَ طَرفي ما حَوَتهُ جُفونُهُ","وَلَو خانَ قَلبي ما حَوَتهُ ضُلوعُهُ",0,"ع",2,0],["فَلَو خُلِقَ الناسُ مِن دَهرِهِم","لَكانوا الظَلامَ وَكُنتَ النَهارا",1,"ر",2,0],["فَلَو خَلَّدَ المَعروفُ قَبلَكَ ماجِداً","لَكُنتَ بِإِسداءِ الجَميلِ مُخَلَّدُ",2,"د",1,0],["فَلَو خُلِطَ السَمُّ الزُعافُ بِريقِها","تَمَصَّصتُ مِنهُ نَهلَةً وَرَويتُ",3,"ت",1,0],["فلو خَبَرَتْهُمُ الجَوزاءُ خُبْري","لَما طَلَعَتْ مَخافَةَ أن تُكادا",4,"د",2,0],["فَلو خصّني بالشتمِ مع عظم جرمهِ","لَما لمتهُ لكنّهُ عمّم الشرّا",5,"ر",2,0],["فلو خلقَ للهُ فيكَ العيونَ","طيوراً لما بتَّ إلا ضريرا",6,"ر",2,0],["فلو خرجت روحي لهانت ولم يهُن","خروجُكِ من ذاك الحِجالِ المُسَجَّفِ",7,"ف",1,0],["فَلَو خَلَتِ الأرض من مثلكم","لزُلْزِلَتْ الأرض زلزالها",8,"ل",3,0],["فلو خيلتني عقبى ثلاث","لتكرهني ولو قبل الثلاث",9,"ث",1,0],["فَلَو خَزّ في الأَوراقِ يَوماً يَراعُهُ","عَلى صَدرِها في الحالِ يَجري كَلامُهُ",10,"م",2,0],["فَلَو خَذَلَت أَموالُهُ بَذلَ كَفِّهِ","لَقاسَم مَن يَرجوهُ شَطرَ حَياتِهِ",11,"ت",2,0],["فلو خلد امرؤ لقديم مجيد","ولكن لا سبيل الى الخلود",12,"د",1,0],["فلو خلت كيف الشمر بقطع راسه","وكيف حسين يستغيث وتقتل",13,"ل",1,0],["فلو خلعوا ثيابك عنك أبدت","إلينا كل أنواع العيوب",14,"ب",1,0],["فلو خيروني لما اخترتها","بحال ولكن حياتي اضطرار",15,"ر",1,0],["فلو خلها في الأرض غصت لقعرها","وإن تك في نجم صعدت الى النجم",16,"م",1,0],["فلو خطرت في خاطري عنك سلوةٌ","تمنيتُ أن أقضي قبيل السّلى نحبي",17,"ب",2,0],["فلو خالفَ المقدادُ أمركَ لم يكنْ","له أبَدَ الأيامِ في النّاسِ مذهَبُ",18,"ب",1,0],["فَلَو خَيَّروا نَفس العلى بَينَ رِفقَة","لَما خِلتُها اِختارَت سِواهُ رَفيقا",19,"ق",2,0],["فَلَو خَيروا العَلياءَ في خاطِب لَها","سِواهُ من الاِقوامِ لا تَتَخَيَّر",20,"ر",1,0],["فلو خلقَ الرحمنُ قوماً كأسرتي","أتى بهم في مُحكمٍ غير مُدْفَعِ",21,"ع",1,0],["فَلَو خَلَّدَ الذِكرُ الجَميلُ ابن آدَمٍ","لأَصبضحَ في ذا القُطرِ فَرداً مُخَلَّدا",22,"د",2,0],["فلو خَطَطتُ حروفًا لاسمِهِ لبدت","في كلِّ حرفٍ على القرطاسِ أنوارُ",23,"ر",1,0],["فلو خادعت طرفك لم تعرج","به إلا على قمر منير",24,"ر",1,0]]}