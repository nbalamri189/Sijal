.dctabudhabi.ae/diwan/poem/83392","المجتث"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33593","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33519","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33439","المنسرح"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139540",""],[4729,"يَا خاتَم الأنبياءِ قَاطِبَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=109461",""],[4804,"واشفِ السقام بأن تزورهم","https://www.poetsgate.com/ViewPoem.aspx?id=92097",""],[4578,"لقلبي في مهاوي الحب أهوى","https://www.poetsgate.com/ViewPoem.aspx?id=49607",""],[4578,"بروح العلا بالسعد أبدت سماؤها","https://www.poetsgate.com/ViewPoem.aspx?id=49341",""],[4899,"خانة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=177029",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[4966,"كرونا","https://www.poetsgate.com/ViewPoem.aspx?id=211239",""],[5136,"مثلي من عيشه يطيب","https://www.poetsgate.com/ViewPoem.aspx?id=121519",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5219,"دمعة على القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194900",""],[5246,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=187037",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[307,"الرحيل الى الله تعالى","https://www.poetsgate.com/ViewPoem.aspx?id=213747",""],[5320,"إلى رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=40398",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[4623,"محبتي لك نجتني من العطب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146603",""],[5829,"قم لرمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212930",""],[5829,"شاب الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=213964",""],[5901,"العقود الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=204927",""],[5939,"رسالة إلى أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=178589",""],[5956,"أحتاج للحب العميق منَ أمرأة","https://www.poetsgate.com/ViewPoem.aspx?id=182280",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[5309,"عذابي اليم من مهاة اصابها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573548",""],[572,"بُليتُ وَلَجّ بي وَجْدٌ بِظَبْيٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9196&r=&rc=53",""]],"verses":[["وَأَشفي غَليلاً عَزَّ شِفاؤُهُ","بِمُنجَرِدٍ قَيدِ الأَوابِدِ هَيكَلِ",0,"ل",1,0],["وَاشفَع فَلِلشافِعِ نُعمى بِما","سَنّاهُ مِن عَقدٍ وَثيقِ النَواح",1,"ح",1,0],["وَأَشفَقُ مِن هِجرانِكُم وَتَشُفُّني","مَخافَةُ وَشَكِ البَينِ وَالشَملُ جامِعُ",2,"ع",1,0],["وَأَشفي مِن تَخَلُّجِ كُلِّ جِنٍّ","وَأَكوي الناظِرينَ مِنَ الخُنانِ",3,"ن",1,0],["وَأُشفِقُ مِن تَأَوِّدِهِ","أَخافُ يُذيبُهُ التَرَفُ",4,"ف",1,0],["وَأَشفَي غُلَّتي مِنكُم إِلَيكُم","فَإِنَّ الكُتبَ لاتَسَعُ اِشتِياقي",5,"ق",2,0],["وإشفاقُ نفسي من خِلافِ أعِزَّتِي","وخوفيَ أعقابَ الأحاديثِ في غَدِ",6,"د",1,0],["وَأُشفِقُ أَن أَرى خَدَّي","كَ نَصبَ مَواقِعِ المُقَلِ",7,"ل",1,0],["وَاشْفِ نَفْسَاً أَنْتَ بَارِئُهَا","فَإِلَيْكَ الْبُرْءُ وَالسَّقَمُ",8,"م",1,0],["وَأُشَفّي البُردَ عَنكِ لَهُ","كَي تَشوقيهِ إِذا نَظَرا",9,"ر",2,0],["وَأُشفِقُ مِن مَوتِ الصِبا ثُمَّ إِنَّني","لَآمُلُ أَنَّ اللَهَ يَعفو وَيَصفَحُ",10,"ح",1,0],["وَاِشفَع عَلى شَحطِ الدِيارِ لِآمِلٍ","أَهدى الثَناءَ عَلى تَنائي الدارِ",11,"ر",1,0],["وأشفَقَ البحرُ منها وهو طاغيةٌ","عاتٍ على ضرباتِ الصَّخرِ جَبَّارُ",12,"ر",1,0],["وَاشْفِني مِنْ بَرْحِ وجْدِي","يَا أَمِيرِي",13,"ي",1,0],["وَاِشفَع لَهُ لَعَلَّهُ","يجبرُهُ مَن جَبَرَك",14,"ك",1,0],["واشفعوا لي واحذروا غضْبَتها","آهِ من صَوْلة هذا الغضبِ",15,"ب",1,0],["وأشفق على تلك الجوانح إنها","حُنيت أضالعُها على الأحقاد",16,"د",1,0],["وَاِشفَع بِها تِلكَ القَلائِدَ إِنَّها","مِن خَيرِ ما تُزهى بِهِ الأَجيادُ",17,"د",1,0],["وأشفقت السهام على شبابي","وناحت والجراحاتُ سويا",18,"ي",2,0],["واشفي غليلي وابعثي","ميتَ اليَقينِ ودَلّليني",19,"ن",2,0],["وَأشفي غَليلي مِن سَراةِ قُضاعَةٍ","وَكُلُّ صَقيلٍ يَملَأُ الكَفَّ حامِلُه",20,"ل",2,0],["واشفع إلى الرحمن في غفران ما","هذي عقوبته فأنت مشفع",21,"ع",1,0],["واشفع إلى الله في إحسان خاتمتي","فإنني بك بعد الله اعتضد",22,"د",1,0],["وَاِشفَع تُشَفَّعُ ثُمَّ يَشفَعُ مَرَّةً","أُخرى لِأَهلِ الخطّ وَالعِصيانِ",23,"ن",1,0],["وَاِشفِ العَليلَ مِنَ الوُقوفِ بِمَنزِلٍ","في القَلبِ مِن ذِكراهُ وَخزُ أَشافِ",24,"ف",1,0],["وَاِشفِ بِلُقياكَ ما بِقَلبي","لِلشَوقِ مِن حَرقَةٍ وَلَذعِ",25,"ع",1,0],["وَاشْفَعَنْ أَسَيِّدِي لِرَسُولِ ال","لَّهِ شَمْسِ الرّشَادِ عَيْنِ النَّجَاةِ",26,"ه",1,0],["وَاشْفَعْ لَنَا يَا سَيِّدِي","لأَِمَانِ ذِي الْبَطْشِ الشَّدِيدْ",27,"د",1,0],["وَاشْفَعْ لَنَا يَوْمَ الْقِيَامَةِ عَلَّنَا","نَغْدُو مِنَ النَّاجِينَ مِنْ أَهْوالِهَا",28,"ل",3,0],["واشفع مسيرك بالسُرى","في جنح ليلٍ أليل",29,"ل",1,0],["وأشفقت من وداعي ثم قائلة","استودع اللَه قلبي إثر من ظعنا",30,"ن",2,0],["واشفع الى الباري له وَلسربه","اذ صار سبحن الظالمين جهنما",31,"م",2,0],["واشفع الى الباري له وَلسربه","وَقهم عذابا ماله من واق",32,"ق",1,0],["واشفَع له ولِمَن يَليه وَقم بهم","في كل حال يا شَفيع المذنب",33,"ب",1,0],["وَأُشفِقُ كُلَّما ناحَت سُحَيراً","حَمامٌ أَن يُفاجِئَني حِمامي",34,"م",2,0],["واِشفِ جوى القلوبِ","بوصلكَ المطلوبِ",35,"ب",1,0],["واِشفَع بها شمسَ الصباح وإِن","أَضحت وبدءُ شروقها العَصرُ",36,"ر",1,0],["وَأشفقُ مِن قولِ المبكّرِ ناشقاً","نَسيم الصّبا جاءَت بريّا القرنفلِ",37,"ل",1,0],["وَأَشفَت بِما شَفَّت بِهِ الجِسمَ مِن ضَنّي","عَذولي عَلى وُجودي وَلَم تَشِفِ غِلَّتي",38,"ي",1,0],["وَاِشفِ العَليل تَلافياً بِتعِلَّةٍ","إِنّ العَليل مِن التلاف عَلى شَفا",39,"ف",2,0],["وَاِشفَع اللهو بِأَصو","ت المَثاني المُطرِبات",40,"ت",1,0],["واشفه بل أحيه قبل الممات","تب عليه توبة قبل الفوات",41,"ت",1,0],["واشف إلهي لنا مرضى","من كل أوجاعهم بأمان",42,"ن",1,0],["وأُشفي فؤادي يا حبيبي بنظرةٍ","إليك فقد أضناه طول بعادي",43,"د",2,0],["واشفعْ لَهُ إذْ لَيْسَ يَنْفَعُهُ","الصَّديقُ ولا الحميمُ",44,"م",1,0],["وأشفق أولادي وأهلي وجيرتي","وظن حميمي أن فيه حمامي",45,"م",2,0],["وأشفِقْ على هَذا الزَّمانِ ومرِّه","فإنَّ زمانَ المَرءِ أضلَعُ من خَلْفِ",46,"ف",1,0],["وَأَشفَيتَ مُنتَظِراً لِلبَوارِ","وَصَدرُكَ حَرّانُ لَم تُشفِهِ",47,"ف",2,0],["واشٍ فَذاك الذي يُحبى ويُحتَرَمُ","أَخفَوْا من الغِلِّ ما أخفَوْهُ ثمَّ عَلَنْ",48,"ن",1,0],["واشفي الجوى بسبيلها الصافي وذق","شهداً يعيض عن ابنة الزرجونِ",49,"ن",1,0],["واشفَعْ لعبدِكَ عند صر","فِ زمانِهِ يا خَيْرَ شافعْ",50,"ع",1,0],["وأُشفق أن تبدِّلكِ المطايا","بوطأتها كأنَّ ثراكِ خدّي",51,"د",2,0],["وأشفقتُ من أن يضمر الخطبُ فارساً","جريئاً إذا ما المَشْرفيَّةُ سُلَّتِ",52,"ت",1,0],["وأشفقُ من ساعةٍ لا أراك","بها فمنيتُ ببين الأبد",53,"د",1,0],["وأشفق من دمعي على عرصاته","وقد فاض منها سائلاً وهو سائل",54,"ل",1,0],["واشفنا يا شافي فقد عم الحرج","واشتدت الأزمة عجل بالفرج",55,"ج",1,0],["وأشفى ملكها سقماً فداوى","دخيلة دائها وشفى السقاما",56,"م",2,0],["وَاِشفَع إِلى المَولى بِتَبليغ المنى","مِن جُودِهِ الوافي وَجم عَطائِهِ",57,"ا",3,0],["وَاِشفِقَنْ عَن ضميره تُلْفِ حبّي","رافلاً بين خِلْبِهِ والصِّفاقِ",58,"ق",1,0],["وأُشفِقُ ممّا لا محالةَ واقعٌ","وهلْ للمنايا قادرٌ أن يردّها",59,"د",3,0],["وأَشفعُ حتى لا تُردَّ شفاعَتي","ولو فيَّ إِذ أَصبحتُ بالبُعدِ مَذْنِبا",60,"ب",2,0],["واشفعِي لي فجنَّتي تحتَ أَقدا","مِكِ من غيرِ شُبْهةٍ وامْتِرَاءِ",61,"ا",2,0],["وَاشْفَعْ إلى ما رَقَّ مِنْ تَرَفِ الصِّبا","في وَجْنَتَيْكَ بِرِقَّةِ الأَخْلَاقِ",62,"ق",1,0],["وأشفقني مِن تَركِ وجَهِكَ لِلبِلى","تُقَبلُه بيضُ الوُجوهِ الخَرائد",63,"د",1,0],["وَاشْفَعُوا لِي بِفَضْلكُمْ فِي ذُنُوبٍ","خِلتُ جَهْلاً تَقْبِيحَهَا تَحْسِينَا",64,"ن",2,0],["وأشفقتُ من بلوى حبيبين لم تَطِب","حياتهما في الحب حتى يُفَجَّعا",65,"ع",2,0],["وأشفق من بغي الليالي عليهمُ","وإن كنت من عدوانهم غير محروم",66,"م",1,0],["وأشفق من حقّي عليهم وطالما","تقاضاهمُ زور المغارم دائن",67,"ن",1,0],["وَأَشفي غَليلي مِن مَرينَ الَّتي طَغَت","بسبي غَوانيها وَقتل خِيارها",68,"ه",2,0],["واشفع صبوحك بالغبو","ق وصل غدوّك بالأصائل",69,"ل",1,0],["واشفع تشفّع وقل لأسمع","وسل لأعطيك بازدياد",70,"د",1,0],["واشفع بفضلك فيما قد جناه وهل","ترجى الشفاعة إلا للجنايات",71,"ت",1,0],["واشفع وبشر بالرضى وارحم فانتذ","مؤملي وقد اعتدت اعداء",72,"ا",2,0],["واشفعن فيه إلى الله","فكم امنت خوفا",73,"ف",2,0],["واشفع به لي عنده يا سيداً","حاز الكمال وقد غدا أعلى سند",74,"د",1,0],["واشفع لنا ولا هلنا يا ذخرنا","وببر برك يا مكرم حفنا",75,"ن",2,0],["وأشفقُ أن يلمّ به خيالٌ","من الماضي المثقّل بالذنوب",76,"ب",1,0],["واشفقت من إخفاء امري فإنه","ستظهره الأيام إن خفي الآنا",77,"ن",2,0],["واشفع لشعبان الخديم الذي","في مدحك الزاكي أجاد النظام",78,"م",1,0],["واشفي غليلي من أعادي محمد","واعطى بعون الله أقصى المطالب",79,"ب",1,0],["واشفع بحقك لي يوم الحساب إذا","عاينت شدة أوجال وأهوال",80,"ل",1,0],["واشفع حنانيك في فصل القضاء إذا","عم البلاء وقلّت في الورى حيلي",81,"ل",2,0],["واشفق على سوءِ حالي","فأنتَ تعلم اني",82,"ي",1,0],["واشفق على ياسمينٍ كان ذا شفقٍ","في روض وجنتها من وردة الخفر",83,"ر",1,0],["واشفع برياها عبيراً ثانياً","من طيب فيك يضاعف الأفراحا",84,"ح",2,0],["وأشفقتِ النجومُ الزُّهرُ حتى","تبدتْ في النواظِر وهي جون",85,"ن",1,0],["وَأَشفِقُ مِن وَشكِ الفِراقِ وَإِنَّني","أَظُنُّ لَمَحمولٌ عَلَيهِ فَراكِبُه",86,"ب",2,0],["واشفِ الصَّبابة بالعنا","قِ موسِّدى كفّا وَساعد",87,"د",1,0],["واشفى جميعي من سقامى وعلني","واجعل قُوايا دائماً بأماني",88,"ن",2,0],["واشفعا مصر بعد فتح قريب","بطرابلس إذ هما أختان",89,"ن",1,0],["وَاشفَع لأُمِّى واكرِم يا شَفِيعُ أبى","وَاصلِحَن إِخوَتِى فَرعِى كَذا نَسَبى",90,"ب",2,0],["واشفع فأنت شافع مشفع","فيمن غدا بذنبه مصفدا",91,"د",2,0],["واشف بالقرب منه غلة شوقي","فلبعدي عنه لقد جل ما بي",92,"ب",2,0],["وإشفاؤك التسليم يوجب محبّة","من الناس مجهولا ومعروفا اقصد",93,"د",1,0],["وأشفق مذعور النهى متراجعاً","مهولاً كما لَو حَيَّةٌ لسعت يدا",94,"د",2,0],["واشفع يمينك بالطلاق ثلاثة","ان شاء تحلفها بلا تأويل",95,"ل",1,0],["واشفع فوجهك لا يرد ولم يزل","يُعفى بوجهك كل زلِة مذنب",96,"ب",1,0],["واشفع بامنِهم وَخِصْب بلادهم","فالعبد يطمع في جناب السيد",97,"د",1,0],["وأشفى غليلي وأرغم به عذولي","وأحط رحلي وحملي والثقول",98,"ل",1,0],["واشفع وقل بتذلل وتخشع","يا ساكني وادي النقا والأجرع",99,"ع",1,0],["واشف دائي فأنت أنت طبيبي","كثر المشتكي وقل احتمالي",100,"ل",2,