{"poems":[[47,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[240,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[303,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[358,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[358,"ما تراءى هلال عام جديد","https://www.aldiwan.net/poem40399.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86909","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78179","الرمل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122045","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53077","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93554","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204945","الخفيف"],[3483,"","https://poetry.dctabudhabi.ae/diwan/poem/111137","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90830","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94472","الكامل"],[4343,"","https://poetry.dctabudhabi.ae/diwan/poem/123793","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52173","الكامل"],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["وَعَلى غَيرِهِنَّ أُحزِنَ يَعقو","بُ وَقَد جاءَهُ بَنوهُ عِشاءَ",0,"ا",2,0],["وَعَلى غَوارِبِها نُفو","سٌ لا تُحَسُّ لَها جُسومُ",1,"م",1,0],["وعَلَى غيرِ القذى غضّ الجفون","من رأَى الإِلفين في عيشٍ قرير",2,"ر",1,0],["وَعَلى غَيرِهِ غَدَت","صَعبة لَيسَ تُرتَقى",3,"ق",2,0],["وَعَلى غَيرِها بِكَ اِمتازَت اليَو","مَ اِمتِياز المَوجود عَن مَفقودِ",4,"د",1,0],["وَعَلى غَيرِها سَمَت بِضياء","دُونَهُ في صِفاته ضُوءُ بَدر",5,"ر",1,0],["وَعَلى غُصن النَقا قامتها","لِحمام الحلي تَغريد وَصَدحُ",6,"ح",1,0],["وَعَلَى غَيَارَى الْحَيِّ إِنْ هَزُّوا الْقَنَا","بَشَرَى بِلَبَّاتِ الْفَوَارِسُ تُغْرَزُ",7,"ز",1,0],["وعلى غصون رماحه","شرك يصيد الليث ورْدا",8,"د",2,0],["وَعَلى غَفلة الرَقيب نعمنا","بِفَتاة تغار مِنها المهاة",9,"ه",1,0],["وعلى غير مبدعٍ حرّموها","حظّه حسرة لها وتمنّي",10,"ن",2,0],["وعلى غصن الأماني","طير انسي قد ترنم",11,"م",1,0],["وعلى غدير الغرب رنق نسره","وغرابه قد هم بالطيران",12,"ن",1,0],["وعلى غناءِ المَشْرِفيّةِ في الطُّلَى","والهامِ رَقْصُ عواملِ المُرَّانِ",13,"ن",1,0],["وعلى غزير نسمي وتحدَّثي","بغزير شوقٍ بالحشاءِ تضرَّما",14,"م",2,0],["وعلى غصن قدّه بدر تمّ","مشرق لاح من دياجر شعره",15,"ر",2,0],["وعلى غِرارِك قد طبعت شعورَهُ","فخلقتِ منه الشاعرَ المطبوعا",16,"ع",2,0],["وَعَلى غَير حَق اللَه واسوا جنايتوا","الملحدين اللي الخبايث عمالها",17,"ل",3,0]]}