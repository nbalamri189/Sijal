What=shqas&qid=84903&r=&rc=3",""],[203,"لأمرٍ فيهِ يرتفعُ السحابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72520&r=&rc=14",""],[5126,"المشيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87786&r=&rc=1",""],[6352,"كذا يظهر المعجز الباهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22746&r=&rc=7",""]],"verses":[["فَإِن تَلاقَينا فَفي خُفيَةٍ","لا نَشتَفي مِن نَظَرٍ وَاِستِماع",0,"ع",1,0],["فَإِن تَلِفَت نَفسي فَلِلَّهِ دَرُّها","وَإِن سَلِمَت كانَ الرُجوعُ قَريبا",1,"ب",2,0],["فَإِن تَلقَحوا الحَربَ بَينَ الرِجالِ","فَمُلقِحُها جَدُّهُ الأَنكَدُ",2,"د",1,0],["فَأَنتَ لَها إِن قامَ في الشَرقِ مُرجِفٌ","وَأَنتَ لَها إِن قامَ في الغَربِ مُرجِفُ",3,"ف",1,0],["فَأَنتَ لِأَوَّلِهِم آخِرُ","وَأَنتَ لِآخِرِهِم أَوَّلُ",4,"ل",1,0],["فأنت للكائنات روح","إن كانت الروح للبقاء",5,"ا",2,0],["فَأَنتَ لِرَبِّ العالَمينَ خَليفَةٌ","وَلِيٌّ لِعَهدِ اللَهِ بِالحَقِّ عارِفُ",6,"ف",1,0],["فأنت للطالب العر","ف روضةٌ وغدير",7,"ر",1,0],["فأنت له حلْيٌ وإن كان حليةً","لكل غضيض الطرف أكحلَ أحورا",8,"ر",2,0],["فأنت لنا واد خصيب جنابه","وأنت لنا طود من العز فارع",9,"ع",1,0],["فأنت له أهْجَى البريَّة نيَّةً","وإن كنتَ قد أطريْتَهُ في مقالِكا",10,"ك",2,0],["فأنت لعمري في العلوِّ نظيرُها","وفي المجد مولاها وفي الحسنِ شكلُها",11,"ل",3,0],["فَإِن تَلمَسِ الثَوبَ الَّذي أَنا لابِسٌ","قَدَدتُ بِكَفِّيَ الثَوبَ مِن قَبلُ يَنقَدُّ",12,"د",1,0],["فأنت لكل موجودٍ وجودٌ","وأنت لكل موجودٍ وعاء",13,"ا",2,0],["فَأَنتَ لِمَن وَدَّ الرَشادَ مُراصِدٌ","لِساعاتِ حَزمٍ لِلجَليلِ اِستُعِدَّتِ",14,"ت",1,0],["فَإِن تُلحِقِ النُعمى بِنُعمى فَإِنَّهُ","يَزينُ اللَآلي في النِظامِ اِزدِواجُها",15,"ج",3,0],["فَإِن تَلقَني نِضوَ العِظامِ فَإِنَّها","جَريرَةُ قَلبي مُنذُ كُنتُ عَلى جِسمي",16,"م",2,0],["فَإِن تَلتَمِسني في تَميمٍ تُلاقِني","بِرابِيَةٍ غَلباءَ تَعلو الرَوابِيا",17,"ي",2,0],["فإن تُلحِقْ ثوابَك بي ثياباً","فأيسرُ ما تجودُ به الثِّيابُ",18,"ب",1,0],["فَأَنتِ لَنا قُطبٌ عَلَيهِ مَدارُنا","وَأَيِّ رَحىً أَضحَت تَدورُ بِلا قُطبِ",19,"ب",1,0],["فَأَنتَ لَدَيهِ حاضِرٌ غَيرُ حاضِرٍ","جَميعاً وَعَنهُ غائِبٌ غَيرُ غائِبِ",20,"ب",1,0],["فَإِن تَلقَهُم يَوماً عَلى قيدِ فَترَةٍ","مِنَ الأَمرِ تَختَر قُربَ قَيسٍ عَلى البُعدِ",21,"د",1,0],["فأنت لا تعيش في","دنياك هذي أَبَدا",22,"د",2,0],["فَأَنْتِ لَهُمُ أُمُّ وَأَنْتِ أَمِيرَةٌ","أَجَلْ وَلَكِ الدُّنْيَا وَأَجْوَادِهَا فِدَى",23,"د",2,0],["فإن تُلقُوا إلينا السِّلْمَ نَقْبَلْ","وَنَجْعَلْكُمْ لَنَا عَضُداً وَرِيفَا",24,"ف",2,0],["فأنت لحبل الملك لا شك واصل","وأنت لصدع الدين لا شك جابر",25,"ر",1,0],["فَأنْتَ لمن ود الرشاد مرصاداً","لساعات حزم للجليل استعدت",26,"ت",1,0],["فأنت لطالب العر","فِ روضة ٌ وغدير",27,"ر",1,0],["فانت لسر علم الله كنز","وانت لكل منقبة عصام",28,"م",1,0],["فانت لعمري روح روحي وسكرتي","وانت كما تهوى مصحي وممرضي",29,"ض",2,0],["فانت للقوم حصن يحتمون به","ان اظلم الوقت او ذو مظهر عثرا",30,"ر",2,0],["فانت لمقلتي يا حب نور","وانت لجسمي المضني روح",31,"ح",1,0],["فأنت لي ولآمالي وإن بعدت","قوس الغمائم في آفاق غمائي",32,"ا",2,0],["فأنتَ لها كُفءٌ وفٍ فتملَّها","وأظهرْ لها حسن القبول وبادرِ",33,"ر",1,0],["فأنت لرب العرش فينا خليفة","وجودك فينا كالحليفة للقطر",34,"ر",1,0],["فإن تلعنوا الشيخ الكفور بربه","فلا تعد من تلميذه رُب لعنة",35,"ه",1,0],["فَأَنتَ لِناشِيها أَخٌ وَلِطِفلِها","أَبٌ راحِمٌ وَاِبنٌ لِذي الشَيبِ واصِلُ",36,"ل",1,0],["فَأَنت لَعَمري بَينَ خالٍ وَوالِدٍ","يُعيدانِ لِلعَليا سَناماً وَكاهِلا",37,"ل",2,0],["فأنت للخَلْق روحٌ ظاهِر وبه","يَحْيا ولولاك أضحى رِكَّ أجساد",38,"د",1,0],["فأنت لهذا الخَلْق روحٌ وناظِر","وكهفٌ به يَحْيَا ويَغْنَى ويَنظر",39,"ر",1,0],["فإن تلقَ البحاَ تكنْ سفينا","وإن تردِ السما فهي الشِّهابُ",40,"ب",1,0],["فَإِن تَلقَني تَلقَ اِمرَأً قَد بَلَوتَهُ","حَديثاً وَإِن تَفجُر عَلَيَّ تُفَنَّدِ",41,"د",1,0],["فانت لها نعم الولي وخير من","تكفل بالأيتام يا واحد الدهر",42,"ر",1,0],["فانت للملك روح في تجسده","بما بقوم وانت السمع والبصر",43,"ر",1,0],["فَأَنتَ لي وَجَحيمي لي أَوزِّعُه","عَلى الأُلى أَنشَدوا شِعراً وَما شَعروا",44,"ر",3,0],["فَأَنتَ لي وَجَحيمي لي أَوزِّعُه","عَلى الأُلى أَقسَموا لِلشَّعبِ وَاِبتَهَروا",44,"ر",3,0],["فَأَنتَ لي وَجَحيمي لي أَوزِّعُه","عَلى الأُلى ما جَزوا إِلا لِيثّئروا",44,"ر",3,0],["فأنت لسان فخر بني عليّ","وبدر ملوكها التمُّ المنير",45,"ر",1,0],["فأنت له في الحرب سَهْم ومُنْصُلٌ","وفي السِّلم لألاءٌ يلوحُ ونور",46,"ر",1,0],["فأنت لهم كالغيث بالجود مطعم","وغيث سماء الله بالجود مشرب",47,"ب",1,0],["فأنتِ لتذكارِ الجمالِ جميلةٌ","تشُوقينَ قلبي كلّما ذِكرُها عنّا",48,"ن",2,0],["فأَنتَ لنا كنز وَعز وَملجأ","وَنهج لمأمول وَفتح لمقفل",49,"ل",1,0],["فإن تَلفَها من ساكنيها عواطِلا","فَعَهدي بها مَرَّ اللَيالي حَواليا",50,"ي",2,0],["فأَنتَ لِهَذا الخلق إِن دان مؤئلٌ","وَللدين والدُنيا إِذا نُكبا كَهفُ",51,"ف",1,0],["فأنتِ لديَّ ماثلةٌ","عَلَى بعدكِ أو قربكْ",52,"ك",1,0],["فَإِن تَلَقّاكَ بِمَكروهِهِ","فَاِصبِر فَإِنَّ الدَهرَ لا يَصبِرُ",53,"ر",1,0],["فَإِن تلوي بِجيدك وَهوَ حالٍ","لإِبراهيم مِنكَ شَكَوت حالي",54,"ل",2,0],["فأنت لنا المَولَى العظيمُ جلالُه","ونحن فأَسعِدْنا العَبيدُ الأصاغر",55,"ر",1,0],["فأنت للَه أرضٌ فيك قد بَرَزَت","بذورُها عنصرُ الخيرات والنِعَمِ",56,"م",1,0],["فإن تلتمس مجداً وشأنك شائنٌ","تكن مثل من يملي علينا ومن يمحو",57,"ح",2,0],["فإن تلقهم لاقيت كل محقق","وخضت بهم بحراً من الدر مفعما",58,"م",2,0],["فأنت لعمري للمكارم فاتح","وأنت لعمري للأكارم حاتم",59,"م",1,0],["فإن تلحُني بعدها مرَّةً","جزيتك يا سعد بئس الجزا",60,"ا",1,0],["فأنت للعفو أهلٌ","وأن تعظم وزري",61,"ر",2,0],["فإن تلبسْ ثيابَ الحُسنِ يوماً","فإن ملابسي خِلَعُ النُحولِ",62,"ل",1,0],["فإن تُلحِقْ بهم يوماً سواهُمْ","فما السَعْدانُ كالمَرْعى الوَبيلِ",62,"ل",1,0],["فأنت لأبكار المكارم معدن","ولا غرو أن يقفو البديع بديعه",63,"ع",2,0],["فأنت له يا قرة العين واحة","يحف بها روض تهادى غديره",64,"ر",2,0],["فأنت له يا نفحة العمر ظله","ومغناه في دنيا الهوى وزهوره",64,"ر",2,0],["فأنت لطول العمرأهلٌ وللعُلى","وللمجد ما حلَّ الأراكَةَ ساجعُ",65,"ع",1,0],["فأنْتَ لها المواسِمُ والتَّهاني","واِنْ فخرتْ بموسمها السَّعيدِ",66,"د",1,0],["فأنت لِكُلِّ مَجْدِبَةٍ قِطارٌ","وأنت لكُلِّ مُجْلِبَةٍ هُمامُ",67,"م",1,0],["فأنت لجيد هذا الدهر عقدٌ","وأنت لمعصم الدنيا سوار",68,"ر",1,0],["فأنت لنا وصل وعيد وموسم","وروح وريحان وكأس مكلل",69,"ل",1,0],