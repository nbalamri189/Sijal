{"poems":[[55,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[37,"خليلي هذا ربع عزة فاعقلا","https://www.aldiwan.net/poem39177.html","الطويل"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[64,"خذي صفو ما أوتيت واغتنميه","https://www.aldiwan.net/poem52247.html","الطويل"],[64,"تصدى وللحي الجميع رحيل","https://www.aldiwan.net/poem52316.html","الطويل"],[60,"ألا فاصبر على الحدث الجليل","https://www.aldiwan.net/poem30920.html","الوافر"],[52,"يا حب طال تمنينا زيارتكم","https://www.aldiwan.net/poem63933.html","البسيط"],[48,"تحفظ بدينك يا ناسكا","https://www.aldiwan.net/poem22753.html","المتقارب"],[154,"تصبر إذا نابتك للخطب شدة","https://www.aldiwan.net/poem68509.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[239,"فلا تيأسا من رحمة الله وانظرا","https://www.aldiwan.net/poem4607.html","الطويل"],[343,"فلا تجزع وإن أعسرت يوما","https://www.aldiwan.net/poem68648.html","الوافر"],[445,"ما أطبق الهم إلا ريثما انفرجا","https://www.aldiwan.net/poem34794.html","البسيط"],[520,"بان العزا وفؤادي ماله جلد","https://www.aldiwan.net/poem12086.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59125","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96643","الطويل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204058","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112791","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112744","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112741","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112962","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112818","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64558","الطويل"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114920","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11138","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200274","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47197","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93960","المتدارك"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143972","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104229","المتقارب"],[3480,"","https://poetry.dctabudhabi.ae/diwan/poem/202493","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103818","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48346","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91111","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135916","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102977","الطويل"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114868","الطويل"],[4393,"","https://poetry.dctabudhabi.ae/diwan/poem/124787","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116026","الطويل"],[1901,"أتذكرُ من يومِ الفِراقِ حديثَنا","https://www.poetsgate.com/ViewPoem.aspx?id=160378",""],[4858,"هنيئاً ذا التّخرّجُ يا صُهيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=156818",""],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[307,"جَمَالُ الشّيْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=214156",""],[5768,"تَفاءَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=215803",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[6152,"يخبرني الصباح 6","https://www.poetsgate.com/ViewPoem.aspx?id=207650",""]],"verses":[["وَلا تَيأَسَن مِن عَفوِ حُرٍ فَإِنَّما","تَحَلُّمُهُ باقٍ إِذا ضاعَ حِلمُهُ",0,"م",2,0],["وَلا تَيأَسا أَن يَمحُوَ اللهُ عَنكُما","ذُنوبًا إِذا صَلَّيتُما حَيثُ صَلَّتِ",1,"ت",1,0],["وَلا تَيأَس وَلا تَكُ بِالضَجورِ","وَلا تَثِقَنَّ مِن مَجرى الأُمورِ",2,"ر",1,0],["ولا تيأسي من رَوْحِ ربِّكِ إنَّهُ","متى تستحقّي رَوْحَهُ تجديهِ",3,"ي",2,0],["ولا تيأسَنْ من صنْعِ ربِّكَ إنَّني","ضمينٌ بأنَّ اللّهَ سوف يُدِيلُ",4,"ل",1,0],["وَلا تَيأَس فَإِنَّ اليَأسَ كُفرٌ","لَعَلَّ اللَهَ يَغني مِن قَليلِ",5,"ل",1,0],["وَلا تَيَمَّمتُ أُخرى أَستَسِرُّ بِها","إِلّا وَجَدتُ خَيالاً مِنكِ بِالرَصَدِ",6,"د",1,0],["وَلا تَيأَسَنَّ مِنَ المُلكِ أَن","يَعودَ إِذا جَيشُ قَومٍ كُسِر",7,"ر",1,0],["ولا تيأسن من فرحةٍ بعد ترحة","فقد تخذل الأيامُ ثم تعين",8,"ن",1,0],["وَلا تَيأَسوا من رحمةِ اللَّه إنّكم","مَتى ما أطعتُم ربّكم جبَرَ الكَسرا",9,"ر",2,0],["وَلا تَيأَسا أَن تُرزَقا أَرحَبِيَّةً","كَعَينِ المَها أَعناقُهُنَّ طِوالُ",10,"ل",1,0],["وَلا تَيأَس فَإِنَّ اليَأسَ كُفرٌ","لَعَلَّ اللَهَ يُغني عَن قَليلِ",11,"ل",1,0],["ولا تَيَمَّمَكَ التأْميلُ مبتكِراً","إِلّا ووافاكَ بالإِنعامِ مُدَّلِجَا",12,"ج",2,0],["ولا تيقنت أن البين يصدعني","ولا وقوع المنايا كنت أعتقد",13,"د",1,0],["وَلاَ تَيْأسَا مِنْ روْحِ عَهْدِ مَوَدَّةٍ","فَلاَ العَهْدُ مَنْسِيُّ وَلاَ الوُدُّ دَائِرُ",14,"ر",1,0],["وَلا تيئسيهِ مِن وصالك إنّه","لَكم مخلصٌ في حبّه وودادهِ",15,"د",2,0],["ولا تيأسا أن يجمع الله بيننا","كأحسن ما كنا عليه تصافيا",16,"ي",2,0],["ولا تيأس وان كثرت ذنوب","ولو أسرفت من سوء الخصال",17,"ل",1,0],["ولا تيأسن من فضل ربك للذي","جرى منك واطلب رفده مثل من جدُوا",18,"د",3,0],["ولا تىرر فأنت اللَه ربي","فكم انجيت من هول أراعا",19,"ع",2,0],["ولا تيأسن من أجل ذنبك واسألن","اقالته والفوز من غافر الذنب",20,"ب",1,0],["ولا تيأسن منه لسوء جرى ولا","تظن غير خير في إله البرية",21,"ه",1,0],["ولا تيؤسني من شئون علمتها","وإن سكتت عن ذكرهن لسانيا",22,"ي",2,0],["ولا تَيأَسَنَّ الدَهرَ مِنّ حُبِّ كاشِحٍ","ولا تأمَنَنَّ الدَهر صرمَ حبيبِ",23,"ب",1,0],["ولَآتِيَنَّ بَني عَليٍّ إِنَّهُم","مَن يَأتِهِم يُتَلَقىّ بِالإِفلاحِ",24,"ح",1,0],["ولا تيمم برمادٍ ولا","هكٍ ولا بالملح في السفر",25,"ر",1,0],["ولا تيمم بتراب به","كنتَ تيممتَ سوى مرِّ",25,"ر",1,0],["(ولا تيأسا أن يغفر الله مامضى","من الذنب إن رد الخطاب مناديها",26,"ي",3,0],["ولا تيأسوا من ذاك إن مات صالحٌ","فهذا ابنُه راياته فيه خافقَة",27,"ق",2,0],["ولآتى العذر أجبر كسرا","واضمم من يعذل إن حاذا",28,"ذ",2,0],["ولا تيأسا أن يجمع الله بينا","كأحسن ما كنا عليه تصافيا",29,"ي",2,0],["ولا تيأسن لطول الصدود","ولا تسأمن قرع أبوابها",30,"ب",3,0],["ولا تيأسوا منه ولو لان عوده","عسى فهو صدق العود والود سالمه",31,"م",2,0],["ولا تيأسن مما ينال بحيله","وإن بعدت فالأمر ينأى ويصعب",32,"ب",1,0],["ولا تيْأسْ منَ العَفْوِ المُرجّى","فربُّكَ غافِرُ الذّنْبِ العظيمِ",33,"م",1,0],["وَلا تَيأسن إِن أَعرض الحَظُّ مَرةً","فَحظُّ بَني الأَدهار طفل يدعلج",34,"ج",1,0],["ولا تيتِّمنَّ منا ولدا","ولا تمته منا ربّ سرمدا",35,"د",2,0],["ولا تيأسن من فرجة بعد شدة","فقد يرخص الغالي وتغلو البوائر",36,"ر",1,0],["ولا تيأسَن من صالح أن تَنَالَهُ","وان كان بُؤساً بين أيدٍ تُبادِرهُ",37,"ر",2,0],["وَلاَ تَيأسُوا مِن كَشفِ مانابَ إنَّهُ","إذَا شَاء رَبِّي كَشفَ ذَاكَ تَمَزَّعَا",38,"ع",2,0],["ولا تيئسا من رحمةِ اللهِ أن أرى","سريعاً بفضل الكاملِ العفوَ والصَّفحا",39,"ح",2,0],["ولا تيأسَنْ من رحمة اللهِ واتئدْ","فأَن قنوطَ العاقلينَ جنونُ",40,"ن",1,0],["ولا تيأس , فذي الدّنيا جهادٌ","وأنت سليلُ ضرغامٍ وصِيدِ",41,"د",1,0],["ولا تيأس ْ فجود ُ الله ِ جود ٌ","به ِ يعيى التصوُّر ُ لو يُبادر ْ",42,"ر",1,0],["ولَا تَيْأَسْ إِذَا جَفَّتْ رِيَاضٌ","يُسَوقُ اللهُ مِنْ فَوْقٍ سَحَابا",43,"ب",2,0],["ولا تَيْأسْ وإنْ أَخْفَقْتَ يَوْمًا","وَكُنْ جَبَلًا وَقُلْ يَحْيَا الطّمُوحُ",44,"ح",1,0],["ولا تيأس إذا واجهت عسرا","فسحب اليسر بالخيرات حبلى",45,"ل",2,0],["ولا تيأس فبعد العسر يس","ورغم ذبول قلبك سوف يزهر",46,"ر",1,0]]}