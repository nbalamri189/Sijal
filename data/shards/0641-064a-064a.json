{"poems":[[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[74,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[53,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[93,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[91,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[87,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[87,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[87,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[47,"أحبب إلي بطيف سعدى الآتي","https://www.aldiwan.net/poem62643.html","الكامل"],[47,"متى تسألي عن عهده تجديه","https://www.aldiwan.net/poem66847.html","البسيط"],[63,"لنا مغن حسن الغناء","https://www.aldiwan.net/poem51825.html","الرجز"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[51,"يا نفس ما هو إلا صبر أيام","https://www.aldiwan.net/poem63107.html","البسيط"],[99,"البحر أسأله ويسألني","https://www.aldiwan.net/poem24909.html","أحذ الكامل"],[46,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[104,"أنتم المخلصون للوطنية","https://www.aldiwan.net/poem32949.html","الخفيف"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[77,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[50,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140885",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54965","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54634","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43729","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[108,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[109,"طمنوا ستي ام عطا","https://www.poetsgate.com/ViewPoem.aspx?id=29671",""],[92,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[146,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[146,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[163,"حلفت يقظان مروج العنان","https://www.aldiwan.net/poem58767.html","السريع"],[172,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[189,"زهد الناس في العلوم","https://www.aldiwan.net/poem44141.html","مجزوء الخفيف"],[202,"يا طير ما للنوم قد طارا","https://www.aldiwan.net/poem45627.html","السريع"],[226,"سمعتني أقول شعرا شقيا","https://www.aldiwan.net/poem41592.html","الخفيف"],[228,"يا بنت روما لا تكوني كما","https://www.aldiwan.net/poem55110.html","السريع"],[270,"جاءوا معاً فيلقاً جأواء مشعلة","https://www.aldiwan.net/poem1139.html",""],[273,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[274,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[278,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[288,"في جيشها الجرار من","https://www.aldiwan.net/poem39399.html","مجزوء الكامل"],[288,"يا سيد ما أنت إلا سيد","https://www.aldiwan.net/poem39427.html","الكامل"],[301,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[303,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[345,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[367,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[367,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[367,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[369,"ماضيات على الدمام دوامي","https://www.aldiwan.net/poem17703.html","الخفيف"],[380,"مريم مدينة مولاها معظمة","https://www.aldiwan.net/poem59157.html","البسيط"],[394,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[397,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[432,"في يوم قلعة جندل","https://www.aldiwan.net/poem40755.html","مجزوء الكامل"],[435,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[435,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[440,"ها قد بلغت الذي قد كان ينتظر","https://www.aldiwan.net/poem2614.html","البسيط"],[454,"في يد الارتهان عيني تملت","https://www.aldiwan.net/poem13676.html","الخفيف"],[460,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[463,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[481,"هذا المثال المرتسم","https://www.aldiwan.net/poem36898.html","مجزوء الكامل"],[481,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[481,"التفتنا فرأينا","https://www.aldiwan.net/poem37010.html","مجزوء الرمل"],[481,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"],[481,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[507,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[542,"ومعجب بمديح الشعر يمنعه","https://www.aldiwan.net/poem56732.html","البسيط"],[564,"هذا الضريح لجرجس الصباغ قد","https://www.aldiwan.net/poem52578.html","الكامل"],[569,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/31384","البسيط"],[708,"","https://poetry.dctabudhabi.ae/diwan/poem/1900","الكامل"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/21213","الكامل"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2536","الكامل"]],"verses":[["في يافِعٍ جَونٍ يُلَفَّعُ بِال","صَحرى إِذا ما تَجتَنيهِ أَهَل",0,"ل",1,0],["في يَومِ هَيجا فَاِصطَلَيتُ بِحَرِّها","أَو في غَداةِ تَحافُظٍ وَخُصومِ",1,"م",1,0],["في يدك البيضاء يوم الوغى","يلتقم الأهوال ثعبانه",2,"ن",2,0],["فِيئِي إليك فقد هَبَّت مُصوّحةٌ","أضحى لها مجتَنِي لهوٍ كمحتطِبِ",3,"ب",1,0],["فيئي إليكِ فقد هزَّته مُعْصفةٌ","لم تَتركْ وَرِقاً منهُ ولا هَدَبَا",4,"ب",2,0],["في يدِ الله والخليفةِ منه","سيفُ كيدٍ على ذوي الإخلالِ",5,"ل",1,0],["في يَدَيْ كُلِّ ذي رجاء وخوفٍ","عروةٌ منه غير ذاتِ انفصام",6,"م",1,0],["في يَدي أَمري وَلا أَملُكُهُ","وَمَعي ذاتي وَأَخشى أَن أَراها",7,"ا",3,0],["في يديك القويتين اذا الامر","دعا حق النقض والابرام",8,"م",1,0],["في يقظة كنت أو منامِ","أراه يا أُمُّ نصب عيني",9,"ي",1,0],["في يوم ملّونا ويوم سقاريا","ما ليس في الأذكار والأوراد",10,"د",1,0],["في يَبابٍ مِنَ الثَرى رَدَّهُ المَو","تُ نَقِيّاً مِنَ الحُقودِ غَسيلا",11,"ل",2,0],["في يَدِ النَشءِ مِن بَيانِ المُوَيلِحي","مَثَلٌ يَنفَعُ الشَبابَ اِتِّباعُه",12,"ع",2,0],["فَيئي إِلَيكَ فَقَد تَخَوَّنَ أُسرَتي","حَيفُ الرَدى وَتَحامُلُ النَكَباتِ",13,"ت",1,0],["فَئيهٍ لَكَ الخَيراتُ مِن سَيبِكَ الَّذي","غَمَرتَ بِهِ سَيبَ المُساجِلِ إيهِ",14,"ي",2,0],["في يَلْمَقٍ مُشهَّرِ الأَثناءِ","كأنما طُوِّقَ بالدِّماءِ",15,"ا",2,0],["في يَومِ دَجنٍ يُوالي الشَدَّ في عَجَلٍ","إِلى لِوى حَضَنٍ مِن خيفَةِ المَطَرِ",16,"ر",1,0],["في يَومِ آخِرِ تَوديعٍ تُوَدَّعُهُ","تُهدى إِلى حَيثُ لا فادٍ وَلا حامِ",17,"م",1,0],["في يقظةٍ مني وفي وسنٍ","صَرحٌ بِذِروَتِهِنّ متَّحد",18,"د",1,0],["في يَومِ أَرشَقَ وَالهَيجاءُ قَد رَشَقَت","مِنَ المَنِيَّةِ رَشقاً وابِلاً قَصِفا",19,"ف",2,0],["في يدينا بقيَّةٌ من بلادٍ","فاستريحوا كيلا تطير البقيَّةْ",20,"ي",2,0],["في يَديهُم سِلاح قَوم عَلَيه","أَسَدٌ في حَديده مَختوم",21,"م",1,0],["في يدَيْهِ خَزائِنُ اللّهِ في الأرْ","ضِ ولكنّها على الإنْفاقِ",22,"ق",1,0],["في يَومِ عيدٍ مَبرَزِ الصَليبِ","ذَعَرتُها بِمُلهَبِ الشُؤبوبِ",23,"ب",1,0],["في يدها طاقةٌ تشير بها","لكل طيبٍ من طيبها ريح",24,"ح",1,0],["في يديه حُطامةُ الأمل الذا","هبِ في ميعة الصبا الموموقِ",25,"ق",1,0],["في يديه زهرةٌ تقطرُ ماءَ","عَرفتْ عيني بها أدمعَ قلبي",26,"ي",1,0],["فِي يَوْمِ قَانَا الجَلِيلِ شَرَّفَهَا","فادِي البَرَايَا وَغَافِرُ الوِزْرِ",27,"ر",1,0],["فِي يَوْمِ الاسْتِبْشَارِ بِالْعِيدِ الَّذي","هُوَ مَعْقَدُ الآمَالِ مِنْ أَحْقَابِ",28,"ب",1,0],["في يد الآسي وعلم الصيدلي","أنقذ الإنسان من آلامه",29,"ه",1,0],["في يَقظٍ طيّبٍ فُجِعتُ بِهِ","فَخَرَّ عَلى كُلِّ طَيِّبٍ يَقِظِ",30,"ظ",1,1],["في يَدَيْكَ الرِّيحُ تُرْسِلُها","كَيْفَما تَهْوَى بلا رَسَن",31,"ن",1,0],["في يديه مِجْهَرٌ من عَجَبٍ","تُفَتَحُ العينُ به عن عَجبِ",32,"ب",1,0],["في يديه لَوْحُه، ما همَسَا","همسة إلا وخطتها يداه",33,"ا",2,0],["في يدينا بقية من بلادٍ","فاستريحوا كي لا تضيع البقية",34,"ي",2,0],["في يَديك الجميلتَينِ إذا شئتِ","ارتهاني ومن يَديَك فَكاكي",35,"ك",2,0],["فيّئ الشام باللواء ونضّر","شاطئيها بظلّك الممدود",36,"د",1,0],["في يَومِ قارٍ رايَةٌ لَكَ فَهَّمَت","مِن قادَةِ الأَتراكِ مَن لَم يَفهَمِ",37,"م",1,0],["في يَومِ أَرتاحٍ غَداةَ سَقَتهُمُ","مَوتاً تَحَكَّمَ في النُفوسِ زُؤاما",38,"م",2,0],["في يده شمطاء معسولة","ترفل في ملحفتي أرجوان",39,"ن",1,0],["فَئيدٌ كَعِلّوصِ الأَباءِ لَدى الوَغى","وَإِمّا مَشى بَينَ البَغايا تَقيّدا",40,"د",2,0],["في يديه صبابه","من تراب ومن ذهب",41,"ب",1,0],["في يدكمْ غريمٌ ظبي من الغر","بِ سبى المشرقينِ والمغربينِ",42,"ن",1,0],["في يَراعٍ عَلَّمتَه الحُبَّ حَتّى","صِرتُ أَهواهُ صِرتُ مِن عاشِقيهِ",43,"ه",1,0],["في يَدِكَ المِنجَلُ فاحصُد به","أَعمارَ أَقوامٍ طَغوا في الضَلالِ",44,"ل",1,0],["في يوم حتف يهال الناظرون له","ما إن تبين له شمس ولا قمرُ",45,"ر",1,0],["في يَدَيكَ الفنُّ فاشٍ سرُّهُ","مِنه مَتِّع نظري أو مِسمَعي",46,"ي",1,0],["في يوم المَظلوم منتصر له","وَبسجن سَجين يعاقب ظالمه",47,"م",2,0],["في يَوْمِهِم أحْيَوْا خَليفَةَ أمْسهِم","شَبَهاً بِهِ في النَّقْضِ والإبْرَامِ",48,"م",1,0],["في يلدزٍ قطب الملو","ك امامه السفرا تخر",49,"ر",1,0],["في يومها جلس الخيفة بالرضا","عبد الحميد على الكيان المنتظم",50,"م",1,0],["في يديها وعَلَى أَقدامها","مهجٌ سالتْ ودمعٌ غُيَّضا",51,"ض",2,0],["في يَومِ طَلٍّ وَأَشباهٍ وَضافِيَةٍ","شَهبا وَثَلجٍ وَقَطرٍ وَقعُهث دِرَرُ",52,"ر",1,0],["في يديه وردة حم","راء تزهو كالدهان",53,"ن",1,0],["في يومِ ذي قارٍ غداةَ سُيوفُهمْ","نيرانُ أهْلِ عبادةِ النِّيران",54,"ن",1,0],["فيئوا إلى كُتْبِه واخشَوْا كتائبَهُ","قد أصحَر اليومَ ليثٌ طالما خَدَرا",55,"ر",2,0],["في يدِ الدّولةِ العزيزةِ منه","أَبدَ الدّهرِ سَهْمُ رأيٍ سديد",56,"د",1,0],["في يَمينِ السُلطانِ إِن جَرَّدَتها","أَشهَتها صَواعِقٌ في غَمامِ",57,"م",1,0],["في يوم شدتِنا ننحو حماك على","رومٍ لمرحمةٍ في موقف القَدَم",58,"م",1,0],["في يوم حق آت","يقتص فيه الله",59,"ه",1,0],["في يديه الناي الطروب يناجي","ه ويشدو على خطى الأغنام",60,"م",1,0],["في يوم قلعة جندلٍ","صالت بزاة لا تصد",61,"د",1,1],["في يَدَيْ كلِّ كميٍّ باسمِهِ","يخدُمُ الموتُ شِفارَ المِخْذَمِ",62,"م",1,0],["في يَدِهِ لِلنَّوالِ معركة","أَرى بها البخل صارم الجيدِ",63,"د",1,0],["في يوم ذي هج لا وصف يدركه","يكاد منه فؤاد الدهر ينفطِرُ",64,"ر",1,0],["في يد الإِرتهان عيني تملت","بعد عشر بطيف من قد تولّتْ",65,"ت",1,1],["في يده مذروبةٌ مَزيدةٌ","ودِرعهُ سابغةٌ من اللَّبَدِ",66,"د",1,0],["فيُيْتِمُ مِنْ وَغاهُ ومنْ قِراهُ","أصَيْبيَةَ الفَوارِسِ والسِّقابُ",67,"ب",1,0],["في يوم مأدبة أع","دت للزعيم المحترم",68,"م",1,0],["في يوم مسغبة أضحت مفككة","تلك الرقاب وأجرى تحتها النيلا",69,"ل",2,0],["في يديها بسكلات","ليتها كانت يدينا",70,"ن",2,0],["في يومها المشهود كن","يا فارس الهيجا سبوق",71,"ق",1,0],["في يوم عيد قدما","كضحية بين البنين",72,"ن",1,0],["في يدِ من ربَّني مصِيريْ","وهْوَ عليّ إذن رقيبُ",73,"ب",1,0],["في يَوم لا مالَ عِن