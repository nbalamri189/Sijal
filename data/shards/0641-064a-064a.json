{"poems":[[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[45,"أحبب إلي بطيف سعدى الآتي","https://www.aldiwan.net/poem62643.html","الكامل"],[45,"متى تسألي عن عهده تجديه","https://www.aldiwan.net/poem66847.html","البسيط"],[61,"لنا مغن حسن الغناء","https://www.aldiwan.net/poem51825.html","الرجز"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[49,"يا نفس ما هو إلا صبر أيام","https://www.aldiwan.net/poem63107.html","البسيط"],[97,"البحر أسأله ويسألني","https://www.aldiwan.net/poem24909.html","أحذ الكامل"],[44,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[102,"أنتم المخلصون للوطنية","https://www.aldiwan.net/poem32949.html","الخفيف"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[48,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140885",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54965","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54634","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43729","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""]],"verses":[["في يافِعٍ جَونٍ يُلَفَّعُ بِال","صَحرى إِذا ما تَجتَنيهِ أَهَل",0,"ل",1,0],["في يَومِ هَيجا فَاِصطَلَيتُ بِحَرِّها","أَو في غَداةِ تَحافُظٍ وَخُصومِ",1,"م",1,0],["في يدك البيضاء يوم الوغى","يلتقم الأهوال ثعبانه",2,"ن",2,0],["فِيئِي إليك فقد هَبَّت مُصوّحةٌ","أضحى لها مجتَنِي لهوٍ كمحتطِبِ",3,"ب",1,0],["فيئي إليكِ فقد هزَّته مُعْصفةٌ","لم تَتركْ وَرِقاً منهُ ولا هَدَبَا",4,"ب",2,0],["في يدِ الله والخليفةِ منه","سيفُ كيدٍ على ذوي الإخلالِ",5,"ل",1,0],["في يَدَيْ كُلِّ ذي رجاء وخوفٍ","عروةٌ منه غير ذاتِ انفصام",6,"م",1,0],["في يَدي أَمري وَلا أَملُكُهُ","وَمَعي ذاتي وَأَخشى أَن أَراها",7,"ا",3,0],["في يديك القويتين اذا الامر","دعا حق النقض والابرام",8,"م",1,0],["في يقظة كنت أو منامِ","أراه يا أُمُّ نصب عيني",9,"ي",1,0],["في يوم ملّونا ويوم سقاريا","ما ليس في الأذكار والأوراد",10,"د",1,0],["في يَبابٍ مِنَ الثَرى رَدَّهُ المَو","تُ نَقِيّاً مِنَ الحُقودِ غَسيلا",11,"ل",2,0],["في يَدِ النَشءِ مِن بَيانِ المُوَيلِحي","مَثَلٌ يَنفَعُ الشَبابَ اِتِّباعُه",12,"ع",2,0],["فَيئي إِلَيكَ فَقَد تَخَوَّنَ أُسرَتي","حَيفُ الرَدى وَتَحامُلُ النَكَباتِ",13,"ت",1,0],["فَئيهٍ لَكَ الخَيراتُ مِن سَيبِكَ الَّذي","غَمَرتَ بِهِ سَيبَ المُساجِلِ إيهِ",14,"ي",2,0],["في يَلْمَقٍ مُشهَّرِ الأَثناءِ","كأنما طُوِّقَ بالدِّماءِ",15,"ا",2,0],["في يَومِ دَجنٍ يُوالي الشَدَّ في عَجَلٍ","إِلى لِوى حَضَنٍ مِن خيفَةِ المَطَرِ",16,"ر",1,0],["في يَومِ آخِرِ تَوديعٍ تُوَدَّعُهُ","تُهدى إِلى حَيثُ لا فادٍ وَلا حامِ",17,"م",1,0],["في يقظةٍ مني وفي وسنٍ","صَرحٌ بِذِروَتِهِنّ متَّحد",18,"د",1,0],["في يَومِ أَرشَقَ وَالهَيجاءُ قَد رَشَقَت","مِنَ المَنِيَّةِ رَشقاً وابِلاً قَصِفا",19,"ف",2,0],["في يدينا بقيَّةٌ من بلادٍ","فاستريحوا كيلا تطير البقيَّةْ",20,"ي",2,0],["في يَديهُم سِلاح قَوم عَلَيه","أَسَدٌ في حَديده مَختوم",21,"م",1,0],["في يدَيْهِ خَزائِنُ اللّهِ في الأرْ","ضِ ولكنّها على الإنْفاقِ",22,"ق",1,0],["في يَومِ عيدٍ مَبرَزِ الصَليبِ","ذَعَرتُها بِمُلهَبِ الشُؤبوبِ",23,"ب",1,0],["في يدها طاقةٌ تشير بها","لكل طيبٍ من طيبها ريح",24,"ح",1,0],["في يديه حُطامةُ الأمل الذا","هبِ في ميعة الصبا الموموقِ",25,"ق",1,0],["في يديه زهرةٌ تقطرُ ماءَ","عَرفتْ عيني بها أدمعَ قلبي",26,"ي",1,0],["فِي يَوْمِ قَانَا الجَلِيلِ شَرَّفَهَا","فادِي البَرَايَا وَغَافِرُ الوِزْرِ",27,"ر",1,0],["فِي يَوْمِ الاسْتِبْشَارِ بِالْعِيدِ الَّذي","هُوَ مَعْقَدُ الآمَالِ مِنْ أَحْقَابِ",28,"ب",1,0],["في يد الآسي وعلم الصيدلي","أنقذ الإنسان من آلامه",29,"ه",1,0],["في يَقظٍ طيّبٍ فُجِعتُ بِهِ","فَخَرَّ عَلى كُلِّ طَيِّبٍ يَقِظِ",30,"ظ",1,1],["في يَدَيْكَ الرِّيحُ تُرْسِلُها","كَيْفَما تَهْوَى بلا رَسَن",31,"ن",1,0],["في يديه مِجْهَرٌ من عَجَبٍ","تُفَتَحُ العينُ به عن عَجبِ",32,"ب",1,0],["في يديه لَوْحُه، ما همَسَا","همسة إلا وخطتها يداه",33,"ا",2,0],["في يَديك الجميلتَينِ إذا شئتِ","ارتهاني ومن يَديَك فَكاكي",34,"ك",2,0]]}