{"poems":[[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[45,"أحبب إلي بطيف سعدى الآتي","https://www.aldiwan.net/poem62643.html","الكامل"],[45,"متى تسألي عن عهده تجديه","https://www.aldiwan.net/poem66847.html","البسيط"],[61,"لنا مغن حسن الغناء","https://www.aldiwan.net/poem51825.html","الرجز"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[49,"يا نفس ما هو إلا صبر أيام","https://www.aldiwan.net/poem63107.html","البسيط"],[97,"البحر أسأله ويسألني","https://www.aldiwan.net/poem24909.html","أحذ الكامل"],[44,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[102,"أنتم المخلصون للوطنية","https://www.aldiwan.net/poem32949.html","الخفيف"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[48,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140885",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54965","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54634","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43729","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[141,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[141,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[158,"حلفت يقظان مروج العنان","https://www.aldiwan.net/poem58767.html","السريع"],[167,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[184,"زهد الناس في العلوم","https://www.aldiwan.net/poem44141.html","مجزوء الخفيف"],[197,"يا طير ما للنوم قد طارا","https://www.aldiwan.net/poem45627.html","السريع"],[221,"سمعتني أقول شعرا شقيا","https://www.aldiwan.net/poem41592.html","الخفيف"],[223,"يا بنت روما لا تكوني كما","https://www.aldiwan.net/poem55110.html","السريع"],[265,"جاءوا معاً فيلقاً جأواء مشعلة","https://www.aldiwan.net/poem1139.html",""],[268,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[269,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[273,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[283,"في جيشها الجرار من","https://www.aldiwan.net/poem39399.html","مجزوء الكامل"],[283,"يا سيد ما أنت إلا سيد","https://www.aldiwan.net/poem39427.html","الكامل"],[296,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[298,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[340,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[362,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[362,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[362,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[364,"ماضيات على الدمام دوامي","https://www.aldiwan.net/poem17703.html","الخفيف"],[374,"مريم مدينة مولاها معظمة","https://www.aldiwan.net/poem59157.html","البسيط"],[388,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[391,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[426,"في يوم قلعة جندل","https://www.aldiwan.net/poem40755.html","مجزوء الكامل"],[429,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[429,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[434,"ها قد بلغت الذي قد كان ينتظر","https://www.aldiwan.net/poem2614.html","البسيط"],[450,"في يد الارتهان عيني تملت","https://www.aldiwan.net/poem13676.html","الخفيف"],[456,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[459,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[477,"هذا المثال المرتسم","https://www.aldiwan.net/poem36898.html","مجزوء الكامل"],[477,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[477,"التفتنا فرأينا","https://www.aldiwan.net/poem37010.html","مجزوء الرمل"],[477,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"],[477,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[503,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[538,"ومعجب بمديح الشعر يمنعه","https://www.aldiwan.net/poem56732.html","البسيط"],[560,"هذا الضريح لجرجس الصباغ قد","https://www.aldiwan.net/poem52578.html","الكامل"],[565,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"]],"verses":[["في يافِعٍ جَونٍ يُلَفَّعُ بِال","صَحرى إِذا ما تَجتَنيهِ أَهَل",0,"ل",1,0],["في يَومِ هَيجا فَاِصطَلَيتُ بِحَرِّها","أَو في غَداةِ تَحافُظٍ وَخُصومِ",1,"م",1,0],["في يدك البيضاء يوم الوغى","يلتقم الأهوال ثعبانه",2,"ن",2,0],["فِيئِي إليك فقد هَبَّت مُصوّحةٌ","أضحى لها مجتَنِي لهوٍ كمحتطِبِ",3,"ب",1,0],["فيئي إليكِ فقد هزَّته مُعْصفةٌ","لم تَتركْ وَرِقاً منهُ ولا هَدَبَا",4,"ب",2,0],["في يدِ الله والخليفةِ منه","سيفُ كيدٍ على ذوي الإخلالِ",5,"ل",1,0],["في يَدَيْ كُلِّ ذي رجاء وخوفٍ","عروةٌ منه غير ذاتِ انفصام",6,"م",1,0],["في يَدي أَمري وَلا أَملُكُهُ","وَمَعي ذاتي وَأَخشى أَن أَراها",7,"ا",3,0],["في يديك القويتين اذا الامر","دعا حق النقض والابرام",8,"م",1,0],["في يقظة كنت أو منامِ","أراه يا أُمُّ نصب عيني",9,"ي",1,0],["في يوم ملّونا ويوم سقاريا","ما ليس في الأذكار والأوراد",10,"د",1,0],["في يَبابٍ مِنَ الثَرى رَدَّهُ المَو","تُ نَقِيّاً مِنَ الحُقودِ غَسيلا",11,"ل",2,0],["في يَدِ النَشءِ مِن بَيانِ المُوَيلِحي","مَثَلٌ يَنفَعُ الشَبابَ اِتِّباعُه",12,"ع",2,0],["فَيئي إِلَيكَ فَقَد تَخَوَّنَ أُسرَتي","حَيفُ الرَدى وَتَحامُلُ النَكَباتِ",13,"ت",1,0],["فَئيهٍ لَكَ الخَيراتُ مِن سَيبِكَ الَّذي","غَمَرتَ بِهِ سَيبَ المُساجِلِ إيهِ",14,"ي",2,0],["في يَلْمَقٍ مُشهَّرِ الأَثناءِ","كأنما طُوِّقَ بالدِّماءِ",15,"ا",2,0],["في يَومِ دَجنٍ يُوالي الشَدَّ في عَجَلٍ","إِلى لِوى حَضَنٍ مِن خيفَةِ المَطَرِ",16,"ر",1,0],["في يَومِ آخِرِ تَوديعٍ تُوَدَّعُهُ","تُهدى إِلى حَيثُ لا فادٍ وَلا حامِ",17,"م",1,0],["في يقظةٍ مني وفي وسنٍ","صَرحٌ بِذِروَتِهِنّ متَّحد",18,"د",1,0],["في يَومِ أَرشَقَ وَالهَيجاءُ قَد رَشَقَت","مِنَ المَنِيَّةِ رَشقاً وابِلاً قَصِفا",19,"ف",2,0],["في يدينا بقيَّةٌ من بلادٍ","فاستريحوا كيلا تطير البقيَّةْ",20,"ي",2,0],["في يَديهُم سِلاح قَوم عَلَيه","أَسَدٌ في حَديده مَختوم",21,"م",1,0],["في يدَيْهِ خَزائِنُ اللّهِ في الأرْ","ضِ ولكنّها على الإنْفاقِ",22,"ق",1,0],["في يَومِ عيدٍ مَبرَزِ الصَليبِ","ذَعَرتُها بِمُلهَبِ الشُؤبوبِ",23,"ب",1,0],["في يدها طاقةٌ تشير بها","لكل طيبٍ من طيبها ريح",24,"ح",1,0],["في يديه حُطامةُ الأمل الذا","هبِ في ميعة الصبا الموموقِ",25,"ق",1,0],["في يديه زهرةٌ تقطرُ ماءَ","عَرفتْ عيني بها أدمعَ قلبي",26,"ي",1,0],["فِي يَوْمِ قَانَا الجَلِيلِ شَرَّفَهَا","فادِي البَرَايَا وَغَافِرُ الوِزْرِ",27,"ر",1,0],["فِي يَوْمِ الاسْتِبْشَارِ بِالْعِيدِ الَّذي","هُوَ مَعْقَدُ الآمَالِ مِنْ أَحْقَابِ",28,"ب",1,0],["في يد الآسي وعلم الصيدلي","أنقذ الإنسان من آلامه",29,"ه",1,0],["في يَقظٍ طيّبٍ فُجِعتُ بِهِ","فَخَرَّ عَلى كُلِّ طَيِّبٍ يَقِظِ",30,"ظ",1,1],["في يَدَيْكَ الرِّيحُ تُرْسِلُها","كَيْفَما تَهْوَى بلا رَسَن",31,"ن",1,0],["في يديه مِجْهَرٌ من عَجَبٍ","تُفَتَحُ العينُ به عن عَجبِ",32,"ب",1,0],["في يديه لَوْحُه، ما همَسَا","همسة إلا وخطتها يداه",33,"ا",2,0],["في يَديك الجميلتَينِ إذا شئتِ","ارتهاني ومن يَديَك فَكاكي",34,"ك",2,0],["في يَومِ قارٍ رايَةٌ لَكَ فَهَّمَت","مِن قادَةِ الأَتراكِ مَن لَم يَفهَمِ",35,"م",1,0],["في يَومِ أَرتاحٍ غَداةَ سَقَتهُمُ","مَوتاً تَحَكَّمَ في النُفوسِ زُؤاما",36,"م",2,0],["في يده شمطاء معسولة","ترفل في ملحفتي أرجوان",37,"ن",1,0],["فَئيدٌ كَعِلّوصِ الأَباءِ لَدى الوَغى","وَإِمّا مَشى بَينَ البَغايا تَقيّدا",38,"د",2,0],["في يديه صبابه","من تراب ومن ذهب",39,"ب",1,0],["في يدكمْ غريمٌ ظبي من الغر","بِ سبى المشرقينِ والمغربينِ",40,"ن",1,0],["في يَراعٍ عَلَّمتَه الحُبَّ حَتّى","صِرتُ أَهواهُ صِرتُ مِن عاشِقيهِ",41,"ه",1,0],["في يَدِكَ المِنجَلُ فاحصُد به","أَعمارَ أَقوامٍ طَغوا في الضَلالِ",42,"ل",1,0],["في يوم حتف يهال الناظرون له","ما إن تبين له شمس ولا قمرُ",43,"ر",1,0],["في يَدَيكَ الفنُّ فاشٍ سرُّهُ","مِنه مَتِّع نظري أو مِسمَعي",44,"ي",1,0],["في يوم المَظلوم منتصر له","وَبسجن سَجين يعاقب ظالمه",45,"م",2,0],["في يَوْمِهِم أحْيَوْا خَليفَةَ أمْسهِم","شَبَهاً بِهِ في النَّقْضِ والإبْرَامِ",46,"م",1,0],["في يلدزٍ قطب الملو","ك امامه السفرا تخر",47,"ر",1,0],["في يومها جلس الخيفة بالرضا","عبد الحميد على الكيان المنتظم",48,"م",1,0],["في يديها وعَلَى أَقدامها","مهجٌ سالتْ ودمعٌ غُيَّضا",49,"ض",2,0],["في يَومِ طَلٍّ وَأَشباهٍ وَضافِيَةٍ","شَهبا وَثَلجٍ وَقَطرٍ وَقعُهث دِرَرُ",50,"ر",1,0],["في يديه وردة حم","راء تزهو كالدهان",51,"ن",1,0],["في يومِ ذي قارٍ غداةَ سُيوفُهمْ","نيرانُ أهْلِ عبادةِ النِّيران",52,"ن",1,0],["فيئوا إلى كُتْبِه واخشَوْا كتائبَهُ","قد أصحَر اليومَ ليثٌ طالما خَدَرا",53,"ر",2,0],["في يدِ الدّولةِ العزيزةِ منه","أَبدَ الدّهرِ سَهْمُ رأيٍ سديد",54,"د",1,0],["في يَمينِ السُلطانِ إِن جَرَّدَتها","أَشهَتها صَواعِقٌ في غَمامِ",55,"م",1,0],["في يوم شدتِنا ننحو حماك على","رومٍ لمرحمةٍ في موقف القَدَم",56,"م",1,0],["في يوم حق آت","يقتص فيه الله",57,"ه",1,0],["في يديه الناي الطروب يناجي","ه ويشدو على خطى الأغنام",58,"م",1,0],["في يوم قلعة جندلٍ","صالت بزاة لا تصد",59,"د",1,1],["في يَدَيْ كلِّ كميٍّ باسمِهِ","يخدُمُ الموتُ شِفارَ المِخْذَمِ",60,"م",1,0],["في يَدِهِ لِلنَّوالِ معركة","أَرى بها البخل صارم الجيدِ",61,"د",1,0],["في يوم ذي هج لا وصف يدركه","يكاد منه فؤاد الدهر ينفطِرُ",62,"ر",1,0],["في يد الإِرتهان عيني تملت","بعد عشر بطيف من قد تولّتْ",63,"ت",1,1],["في يده مذروبةٌ مَزيدةٌ","ودِرعهُ سابغةٌ من اللَّبَدِ",64,"د",1,0],["فيُيْتِمُ مِنْ وَغاهُ ومنْ قِراهُ","أصَيْبيَةَ الفَوارِسِ والسِّقابُ",65,"ب",1,0],["في يوم مأدبة أع","دت للزعيم المحترم",66,"م",1,0],["في يوم مسغبة أضحت مفككة","تلك الرقاب وأجرى تحتها النيلا",67,"ل",2,0],["في يديها بسكلات","ليتها كانت يدينا",68,"ن",2,0],["في يومها المشهود كن","يا فارس الهيجا سبوق",69,"ق",1,0],["في يوم عيد قدما","كضحية بين البنين",70,"ن",1,0],["في يدِ من ربَّني مصِيريْ","وهْوَ عليّ إذن رقيبُ",71,"ب",1,0],["في يَوم لا مالَ عِندَ المَرءِ يَنفَعُهُ","إِلّا السِّنانُ وَإِلّا الرُمحُ وَالدَرَقُ",72,"ق",1,0],["في يومِ عيد الشَّيخِ سِمعانَ ارتَقى","شيخاً وكان لهُ هُناكَ مُقارِنا",73,"ن",2,0],["في يَدَيْ رأيه من الفِكْر مِرْآ","ةٌ تُرِيه الحِجَا بغير حِجابِ",74,"ب",1,0],["في يوم مات لم يؤخروه","حتى يواروه ويدفنوه",75,"ه",1,0],["في يوم مات الصادق المرجى","وهو صريع بينهم مسجي",75,"ي",1,0],["في يَده قائِمُ سَيْ","فِ الَّلحظِ وَهْوَ جَالِسْ",76,"س",1,0]]}