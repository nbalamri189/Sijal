آن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5533,"في ذكرى المولد النَّبَوي","https://www.poetsgate.com/ViewPoem.aspx?id=176283",""],[5533,"يا غَزَّةُ يا صَوْتَ الأُمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=176419",""],[5550,"أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=211701",""],[5561,"الحوار الرابع عشر","https://www.poetsgate.com/ViewPoem.aspx?id=202115",""],[5574,"كروان","https://www.poetsgate.com/ViewPoem.aspx?id=205989",""],[5596,"الجمعة الممطرة","https://www.poetsgate.com/ViewPoem.aspx?id=205815",""],[5596,"تتابُع الأكدار","https://www.poetsgate.com/ViewPoem.aspx?id=206775",""],[5606,"اليوم الوطني87","https://www.poetsgate.com/ViewPoem.aspx?id=194254",""],[5612,"في يوم عيد الحج","https://www.poetsgate.com/ViewPoem.aspx?id=199230",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[5720,"عيدٌ . . ويومٌ للبلاد","https://www.poetsgate.com/ViewPoem.aspx?id=199361",""],[5720,"الْرَوْنَةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199382",""],[5770,"قم حي غزة","https://www.poetsgate.com/ViewPoem.aspx?id=178369",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5848,"ياشعل سيجارة","https://www.poetsgate.com/ViewPoem.aspx?id=48950",""],[5854,"همًّ تعرّاني فبتُّ أسِيفا ((اعتذار إلى أخ حبيب))","https://www.poetsgate.com/ViewPoem.aspx?id=191828",""],[5877,"سوّد الله قلب جوالي","https://www.poetsgate.com/ViewPoem.aspx?id=37474",""],[6019,"تفيّأتْ روحٌ ظِلالَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=200951",""],[6070,"خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=188063",""],[6093,"إنَّ السَّلامَ على المُختارِ قدْ وَجَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=211222",""],[6139,"ميلاد آذار","https://www.poetsgate.com/ViewPoem.aspx?id=212333",""],[6142,"أذاكر أنت أم ناس خطاب رسو","https://www.poetsgate.com/ViewPoem.aspx?id=155718",""],[5377,"صوت الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79570&r=&rc=26",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6291,"هنا ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87673&r=&rc=7",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""],[6345,"ألم المسيح ردائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78632&r=&rc=3",""],[6351,"مخطوطة للمتنبي.. لم تُحقَّق بعد!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86051&r=&rc=4",""],[6355,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66634&r=&rc=94",""]],"verses":[["في يافِعٍ جَونٍ يُلَفَّعُ بِال","صَحرى إِذا ما تَجتَنيهِ أَهَل",0,"ل",1,0],["في يَومِ هَيجا فَاِصطَلَيتُ بِحَرِّها","أَو في غَداةِ تَحافُظٍ وَخُصومِ",1,"م",1,0],["في يدك البيضاء يوم الوغى","يلتقم الأهوال ثعبانه",2,"ن",2,0],["فِيئِي إليك فقد هَبَّت مُصوّحةٌ","أضحى لها مجتَنِي لهوٍ كمحتطِبِ",3,"ب",1,0],["فيئي إليكِ فقد هزَّته مُعْصفةٌ","لم تَتركْ وَرِقاً منهُ ولا هَدَبَا",4,"ب",2,0],["في يدِ الله والخليفةِ منه","سيفُ كيدٍ على ذوي الإخلالِ",5,"ل",1,0],["في يَدَيْ كُلِّ ذي رجاء وخوفٍ","عروةٌ منه غير ذاتِ انفصام",6,"م",1,0],["في يَدي أَمري وَلا أَملُكُهُ","وَمَعي ذاتي وَأَخشى أَن أَراها",7,"ا",3,0],["في يديك القويتين اذا الامر","دعا حق النقض والابرام",8,"م",1,0],["في يقظة كنت أو منامِ","أراه يا أُمُّ نصب عيني",9,"ي",1,0],["في يوم ملّونا ويوم سقاريا","ما ليس في الأذكار والأوراد",10,"د",1,0],["في يَبابٍ مِنَ الثَرى رَدَّهُ المَو","تُ نَقِيّاً مِنَ الحُقودِ غَسيلا",11,"ل",2,0],["في يَدِ النَشءِ مِن بَيانِ المُوَيلِحي","مَثَلٌ يَنفَعُ الشَبابَ اِتِّباعُه",12,"ع",2,0],["فَيئي إِلَيكَ فَقَد تَخَوَّنَ أُسرَتي","حَيفُ الرَدى وَتَحامُلُ النَكَباتِ",13,"ت",1,0],["فَئيهٍ لَكَ الخَيراتُ مِن سَيبِكَ الَّذي","غَمَرتَ بِهِ سَيبَ المُساجِلِ إيهِ",14,"ي",2,0],["في يَلْمَقٍ مُشهَّرِ الأَثناءِ","كأنما طُوِّقَ بالدِّماءِ",15,"ا",2,0],["في يَومِ دَجنٍ يُوالي الشَدَّ في عَجَلٍ","إِلى لِوى حَضَنٍ مِن خيفَةِ المَطَرِ",16,"ر",1,0],["في يَومِ آخِرِ تَوديعٍ تُوَدَّعُهُ","تُهدى إِلى حَيثُ لا فادٍ وَلا حامِ",17,"م",1,0],["في يقظةٍ مني وفي وسنٍ","صَرحٌ بِذِروَتِهِنّ متَّحد",18,"د",1,0],["في يَومِ أَرشَقَ وَالهَيجاءُ قَد رَشَقَت","مِنَ المَنِيَّةِ رَشقاً وابِلاً قَصِفا",19,"ف",2,0],["في يدينا بقيَّةٌ من بلادٍ","فاستريحوا كيلا تطير البقيَّةْ",20,"ي",2,0],["في يَديهُم سِلاح قَوم عَلَيه","أَسَدٌ في حَديده مَختوم",21,"م",1,0],["في يدَيْهِ خَزائِنُ اللّهِ في الأرْ","ضِ ولكنّها على الإنْفاقِ",22,"ق",1,0],["في يَومِ عيدٍ مَبرَزِ الصَليبِ","ذَعَرتُها بِمُلهَبِ الشُؤبوبِ",23,"ب",1,0],["في يدها طاقةٌ تشير بها","لكل طيبٍ من طيبها ريح",24,"ح",1,0],["في يديه حُطامةُ الأمل الذا","هبِ في ميعة الصبا الموموقِ",25,"ق",1,0],["في يديه زهرةٌ تقطرُ ماءَ","عَرفتْ عيني بها أدمعَ قلبي",26,"ي",1,0],["فِي يَوْمِ قَانَا الجَلِيلِ شَرَّفَهَا","فادِي البَرَايَا وَغَافِرُ الوِزْرِ",27,"ر",1,0],["فِي يَوْمِ الاسْتِبْشَارِ بِالْعِيدِ الَّذي","هُوَ مَعْقَدُ الآمَالِ مِنْ أَحْقَابِ",28,"ب",1,0],["في يد الآسي وعلم الصيدلي","أنقذ الإنسان من آلامه",29,"ه",1,0],["في يَقظٍ طيّبٍ فُجِعتُ بِهِ","فَخَرَّ عَلى كُلِّ طَيِّبٍ يَقِظِ",30,"ظ",1,1],["في يَدَيْكَ الرِّيحُ تُرْسِلُها","كَيْفَما تَهْوَى بلا رَسَن",31,"ن",1,0],["في يديه مِجْهَرٌ من عَجَبٍ","تُفَتَحُ العينُ به عن عَجبِ",32,"ب",1,0],["في يديه لَوْحُه، ما همَسَا","همسة إلا وخطتها يداه",33,"ا",2,0],["في يدينا بقية من بلادٍ","فاستريحوا كي لا تضيع البقية",34,"ي",2,0],["في يَديك الجميلتَينِ إذا شئتِ","ارتهاني ومن يَديَك فَكاكي",35,"ك",2,0],["فيّئ الشام باللواء ونضّر","شاطئيها بظلّك الممدود",36,"د",1,0],["في يَومِ قارٍ رايَةٌ لَكَ فَهَّمَت","مِن قادَةِ الأَتراكِ مَن لَم يَفهَمِ",37,"م",1,0],["في يَومِ أَرتاحٍ غَداةَ سَقَتهُمُ","مَوتاً تَحَكَّمَ في النُفوسِ زُؤاما",38,"م",2,0],["في يده شمطاء معسولة","ترفل في ملحفتي أرجوان",39,"ن",1,0],["فَئيدٌ كَعِلّوصِ الأَباءِ لَدى الوَغى","وَإِمّا مَشى بَينَ البَغايا تَقيّدا",40,"د",2,0],["في يديه صبابه","من تراب ومن ذهب",41,"ب",1,0],["في يدكمْ غريمٌ ظبي من الغر","بِ سبى المشرقينِ والمغربينِ",42,"ن",1,0],["في يَراعٍ عَلَّمتَه الحُبَّ حَتّى","صِرتُ أَهواهُ صِرتُ مِن عاشِقيهِ",43,"ه",1,0],["في يَدِكَ المِنجَلُ فاحصُد به","أَعمارَ أَقوامٍ طَغوا في الضَلالِ",44,"ل",1,0],["في يوم حتف يهال الناظرون له","ما إن تبين له شمس ولا قمرُ",45,"ر",1,0],["في يَدَيكَ الفنُّ فاشٍ سرُّهُ","مِنه مَتِّع نظري أو مِسمَعي",46,"ي",1,0],["في يوم المَظلوم منتصر له","وَبسجن سَجين يعاقب ظالمه",47,"م",2,0],["في يَوْمِهِم أحْيَوْا خَليفَةَ أمْسهِم","شَبَهاً بِهِ في النَّقْضِ والإبْرَامِ",48,"م",1,0],["في يلدزٍ قطب الملو","ك امامه السفرا تخر",49,"ر",1,0],["في يومها جلس الخيفة بالرضا","عبد الحميد على الكيان المنتظم",50,"م",1,0],["في يديها وعَلَى أَقدامها","مهجٌ سالتْ ودمعٌ غُيَّضا",51,"ض",2,0],["في يَومِ طَلٍّ وَأَشباهٍ وَضافِيَةٍ","شَهبا وَثَلجٍ وَقَطرٍ وَقعُهث دِرَرُ",52,"ر",1,0],["في يديه وردة حم","راء تزهو كالدهان",53,"ن",1,0],["في يومِ ذي قارٍ غداةَ سُيوفُهمْ","نيرانُ أهْلِ عبادةِ النِّيران",54,"ن",1,0],["فيئوا إلى كُتْبِه واخشَوْا كتائبَهُ","قد أصحَر اليومَ ليثٌ طالما خَدَرا",55,"ر",2,0],["في يدِ الدّولةِ العزيزةِ منه","أَبدَ الدّهرِ سَهْمُ رأيٍ سديد",56,"د",1,0],["في يَمينِ السُلطانِ إِن جَرَّدَتها","أَشهَتها صَواعِقٌ في غَمامِ",57,"م",1,0],["في يوم شدتِنا ننحو حماك على","رومٍ لمرحمةٍ في موقف القَدَم",58,"م",1,0],["في يوم حق آت","يقتص فيه الله",59,"ه",1,0],["في يديه الناي الطروب يناجي","ه ويشدو على خطى الأغنام",60,"م",1,0],["في يوم قلعة جندلٍ","صالت بزاة لا تصد",61,"د",1,1],["في يَدَيْ كلِّ كميٍّ باسمِهِ","يخدُمُ الموتُ شِفارَ المِخْذَمِ",62,"م",1,0],["في يَدِهِ لِلنَّوالِ معركة","أَرى بها البخل صارم الجيدِ",63,"د",1,0],["في يوم ذي هج لا وصف يدركه","يكاد منه فؤاد الدهر ينفطِرُ",64,"ر",1,0],["في يد الإِرتهان عيني تملت","بعد عشر بطيف من قد تولّتْ",65,"ت",1,1],["في يده مذروبةٌ مَزيدةٌ","ودِرعهُ سابغةٌ من اللَّبَدِ",66,"د",1,0],["فيُيْتِمُ مِنْ وَغاهُ ومنْ قِراهُ","أصَيْبيَةَ الفَوارِسِ والسِّقابُ",67,"ب",1,0],["في يوم مأدبة أع","دت للزعيم المحترم",68,"م",1,0],["في يوم مسغبة أضحت مفك