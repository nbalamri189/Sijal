{"poems":[[53,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[53,"لحب إلي بالدهناء ملقى","https://www.aldiwan.net/poem29852.html","الوافر"],[53,"رب مستغمز إبائي وفي الناس","https://www.aldiwan.net/poem30176.html","الخفيف"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[72,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[70,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[92,"ترجو السعادة يا قلبي ولو وجدت","https://www.aldiwan.net/poem38910.html","البسيط"],[78,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[85,"قالوا تمايز حمزة","https://www.aldiwan.net/poem8057.html","مجزوء الكامل"],[61,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[74,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[102,"هواك أصبح نسيا","https://www.aldiwan.net/poem32994.html","المجتث"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[50,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[46,"قد طال في العيش تقييدي وإرسالي","https://www.aldiwan.net/poem23221.html","البسيط"],[76,"بادر إلى التوبة الخلصاء مجتهدا","https://www.aldiwan.net/poem39455.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54947","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141975","الكامل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142345","الرمل"],[106,"أجادير","https://www.poetsgate.com/ViewPoem.aspx?id=179602",""],[100,"لست أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=50150",""],[73,"هَلْ تذكُرونَ غريباً عادَهُ شَجَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=201341",""],[51,"بدا الشيبُ إلا ما تُداوي المواشطُ","https://www.poetsgate.com/ViewPoem.aspx?id=29405",""],[115,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[128,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[128,"أنا مذ نشأت بسيبكم مغمور","https://www.aldiwan.net/poem50604.html","الكامل"],[137,"سرى طيف ذا الظبي بالعاقدان","https://www.aldiwan.net/poem67914.html","الكامل"],[197,"أترعي الأقداح يا حوا","https://www.aldiwan.net/poem39879.html","مجزوء الرمل"],[197,"يا طائر الفجرِ من بالراح أغرانا","https://www.aldiwan.net/poem39886.html","البسيط"],[197,"يا مي ناب السمع عن بصري","https://www.aldiwan.net/poem39941.html","أحذ الكامل"],[197,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[197,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[222,"حكم اخص بها منادمة الفكر","https://www.aldiwan.net/poem55468.html","الكامل"],[223,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[223,"كنت بالأمس ربة العاشقينا","https://www.aldiwan.net/poem41911.html","الخفيف"],[229,"وأرق العين بالحيين متله","https://www.aldiwan.net/poem51141.html","البسيط"],[235,"أبثك وجدي لو أصخت لمعمود","https://www.aldiwan.net/poem32105.html","الطويل"],[237,"يا من ألح علي في الإنشاد","https://www.aldiwan.net/poem18166.html","الكامل"],[237,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[237,"فخذ الزكاة ولا تخف","https://www.aldiwan.net/poem19502.html","مجزوء الكامل"],[237,"لله يوم شربنا فيه كأس منى","https://www.aldiwan.net/poem19743.html","البسيط"],[254,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[281,"اختم بذكر محمد فذكره","https://www.aldiwan.net/poem1378.html",""],[297,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[297,"اسقياني على اقتراح العذارى","https://www.aldiwan.net/poem33258.html","الخفيف"],[303,"طل في العلا والعلوم حتى","https://www.aldiwan.net/poem57694.html","مخلع البسيط"],[320,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[328,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[342,"يا عروسا في ثياب الرقص","https://www.aldiwan.net/poem55341.html","مجزوء الرمل"],[342,"يا شعاع الصباح","https://www.aldiwan.net/poem55362.html","مجزوء الخفيف"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[353,"أظباء رامة بالظبى آرامها","https://www.aldiwan.net/poem39962.html","الكامل"],[364,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[377,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[377,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[380,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[403,"نظم أرق من الرحيق السلسل","https://www.aldiwan.net/poem33480.html","الكامل"],[416,"متى يشتفي كبد مؤلم","https://www.aldiwan.net/poem53957.html","المتقارب"],[416,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[416,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[416,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[432,"يقر لغليلم المليك بن غليلم","https://www.aldiwan.net/poem12345.html","الطويل"],[432,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[439,"جاءتك خاضعة أعناقها الأمم","https://www.aldiwan.net/poem34812.html","البسيط"],[439,"ألا هكذا فليسم للمجد من سما","https://www.aldiwan.net/poem34814.html","الطويل"],[448,"حبذا والحال داجي الظلم","https://www.aldiwan.net/poem53777.html","الرمل"],[453,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[458,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[458,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[484,"وأرقني والليل قد ذر ساحه","https://www.aldiwan.net/poem1124.html",""],[500,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[500,"قمنا لنساوت النبي مثالا","https://www.aldiwan.net/poem37629.html","الكامل"],[500,"ماذا يضر البدر وهو في السما","https://www.aldiwan.net/poem37630.html","الرجز"],[500,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[505,"الحظّ","https://www.aldiwan.net/poem42462.html","الطويل"],[515,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[551,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[587,"إن القريض إن أرسلت قد وصلا","https://www.aldiwan.net/poem11507.html","عموديه"]],"verses":[["وَأَرقُبُ خَفاقَ النَسيمِ إِذا حَدا","مِنَ الغَربِ أَعناقَ الرِياحِ الهَواجِمِ",0,"م",1,0],["وَأَرَّقَني دُعاءُ الوُرقِ فيها","عَلى جُرحٍ قَريبِ الاِندِمالِ",1,"ل",1,0],["وَاِرقُبي عَطفَةَ الزَمانِ بِجِدٍّ","رُبَّما حَلَّقَ الجَناحُ الحَصيصُ",2,"ص",1,0],["وَاِرقَ عَلى ظَلعِكَ هَيهاتَ أَن","يُزَعزَعَ الطَودُ بِمَرِّ الرِياح",3,"ح",1,0],["وَإِرقاصِ المَطِيِّ عَلى وَجاها","يَجبُنَ إِلى العُلى طُرُقاً نِهاجا",4,"ج",2,0],["وَاِرقَ المَعالي الَّتي أَوفى أَبوكَ بِها","فَكَم تَناوَلَها قَومٌ بِغَيرِ أَبِ",5,"ب",1,0],["وَأرَّقَ عَيْنِي والأسَى يَبْعَثُ الأَسَى","مُطَوّقَةٌ نَاحَتْ عَلَى غُصُنِ الْبَانِ",6,"ن",1,0],["وَاِرقُبيهِ كُلَّ يَومٍ إِنَّما","نَحنُ في قَبضَةِ عَلّامِ الغُيوبِ",7,"ب",1,0],["وأرقب الشهبَ فيه وهي ثابتةٌ","كأنَّما سمّرتْ منها مسامره",8,"ر",2,0],["وأرقَّ الدلالُ والغُنْجُ منه","وبَراهُ الشَّجا فكاد يبيدُ",9,"د",1,0],["وَأَرَّقَني مِن بَعدِ ما نِمتُ نَومَةً","وَعَضبٌ جَلَت عَنهُ القُيونُ بِطاني",10,"ن",2,0],["وَأَرَقتُ فيهِ دَمي فَكَي","فَ أُلامُ في دَمعي المُراقِ",11,"ق",1,0],["وارقصْ مع الأَضواءِ والأَنسامِ","ومع الينابيع الطليقة والصدى",12,"د",2,0],["وارقصْ على الوردِ والأَشواكِ متَّئِداً","غنَّتْ لكَ الطَّيرُ أَو غنَّتْ لكَ الرُّجُمُ",13,"م",1,0],["وَأُرقيهِم ذُرى دَرَجِ المَعالي","كَما أُجنيهِمُ ثَمرَ الأَماني",14,"ي",1,0],["وَاِرقَ المَنازِلَ كُلَّها","حَتّى تُنيفَ عَلى النُجومِ",15,"م",1,0],["وأرَّقَه وَبَادَرَ في سُراه","إليه فما يُنيمُ ولا يَنامُ",16,"م",1,0],["وأرْقُبُ يوماً فيهِ بالوَصْلِ تَلتقي","سجامُ دموعٍ بيننا بسِجامِ",17,"م",1,0],["وَأَرَقتُ فَضلَ صُبابَةٍ لِصَبابَةٍ","فَرَقَعتُ ما أَخلَقتُ مِن أَخلاقي",18,"ق",2,0],["وأرقصْ على حبّ ليلا","ك يا فؤادُ مليّا",19,"ي",2,0],["وأرقُّ النسيم لو مرَّ بالقا","ئم منها لدكَّه فهو بالِ",20,"ل",1,0],["وَأَرِقتَ مِن سارٍ سَرى","لَكَ في السُموطِ وَفي القَلائِد",21,"د",1,0],["وَاِرقُب إِلَهَكَ في عُسرٍ وَفي يُسُرٍ","وَاِترُك جِدالَكَ في بَعثٍ وَإِرسالِ",22,"ل",1,0],["وَارْقُبْ مِنَ اللَّهِ وَعْداً لَيْسَ يُخْلِفُهُ","لا بُدَّ ِللَّهِ مِنْ إِنْجازِ ما وَعَدا",23,"د",2,0],["وأرقّ من كلمَ يفوه بلفظها","يوم الفراق مودِّع لمودّع",24,"ع",1,0],["وَأَرْقَصْنَا الغصُونَ لَهُ","وَأَنْشدْنَا لَهُ الشِّعْرَا",25,"ر",2,0],["وأرق من طبع النسيم","فهل خلعت عليه بردك",26,"ك",1,0],["وارْقَدَّ كالكوْكَبِ في الإغْذاذِ","وامْتَدَّ باعُ القَرَبِ الحَذْحاذِ",27,"ذ",1,0],["وأرقناها دماء حرة","فاغرفي ما شئت منها واشربي",28,"ب",2,0],["وأرَّق بالهمِّ أسْحارها","وجلَّلَ بالغيم آصالَها؟",29,"ل",3,0],["وأرقت الدموع منك ولكن","غسل الدمع حرقتي والعناء",30,"ا",2,0],["وأرَّق العينَ والظلماءُ عاكفةٌ","ورقاءُ قد شفَّها إذْ شفَّني حزَنُ",31,"ن",1,0],["وإرقادُ قوم قد تركتُ لرفدِهِ","وعند ورود اليمِّ تُنسى المطائط",32,"ط",1,0],["وأرق الحديد بالحن والأ","ن اذا شمت طرفك الفتاكا",33,"ك",2,0],["وارقُد الليل كلّه لا تكُن سا","هرَ جَفْن على فراش وثيرِ",34,"ر",1,0],["وارقَ العُلَى وابْق البقاءَ ودُمْ وعِشْ","عمراً وأنت بما تَرَى مَسرُورُ",35,"ر",1,0],["وَأَرَّقَ عَينى عَلى غِرَّةٍ","فَباتَت بِحُزنٍ تُقاسي السُهودا",36,"د",2,0],["وارقصي فالقلب ما","بين الحنايا قد رقص",37,"ص",1,0],["وارقص وصفق وطر واهتف وغن به","وحيه واسكب الأشواق ألحانا",38,"ن",2,0],["وأرَقتُها كرهاً على جزعٍ","فوقَ الرمالِ وبتُّ في سقرِ",39,"ر",1,0],["وارقُصي وانفُثيه سما زعافاً","يا أفاعي الخنا بكل رذيلِ",40,"ل",1,0],["وأرقُّ من نَغَم البلابلِ عندما","تستَقبِلُ الأصباحَ بالألحانِ",41,"ن",1,0],["وارقب طلوع الفجر من أزراره","واعذر لطلعته المؤذن في السحر",42,"ر",1,0],["وَاِرقُصي إِنَّما البَراكينُ تَغلي","تَحتَ رجلَيكِ كَالجَحيمِ النَذيرِ",43,"ر",1,0],["وَاِرقُصي إِن وَدَدتِ فَوقَ تُرابٍ","ضَمَّ قَلباً لِمُغرَمٍ وَعُيونا",44,"ن",2,0],["وأرَّق العينَ بالحيَّين مُتَّلهِ","يُقَطِّع الليلَ تغريدا وتعديدا",45,"د",2,1],["وَأَرَّقَني في اللَيلِ تَرجيعُ وادِعٍ","مِنَ الوُرقِ في فَرعٍ مِنَ البانِ مَكدودِ",46,"د",1,0],["وَارْقَيْ عُلاً مَهْمَا تَبَارَى وَازْدَرَى","بِالْقَصْرِ ذِي الشُّرُفَاتِ مِنْ سِنْدَادِ",47,"د",1,0],["وَأَرْقَاهُ إِلَى الأَعْلَى وَرَقَّى","مَزِيَّتَهُ لَدَى الْمَلإِ الْمَكِينِ",48,"ن",1,0],["وَارْقَعْ بِهَا خَرْقَ الدُّيُو","نِ وَجُدَّ أَسْبَابَ التَّلَفْ",49,"ف",1,0],["وَارْقَيْنَ شَامِخَ الْعُلاَ باِلتَّعَامِي","فَكَذَلِكَ الْكِرَامُ قِدْماً رَقَوْهُ",50,"و",2,0],["وارْقِني من أيِّ مَسٍّ","من جُنونٍ قد يُصِبْني",51,"ن",2,0],["وأرقمْ صحائفك الحسانَ بوصفه","فبه تروق الناظرين وتؤنقُ",52,"ق",1,0],["وأَرقَم الصدغَ والعذارَ على","صفحةِ خدّيه من بَرى قلمَه",53,"م",2,0],["وأَرقنَ الدماءَ طَعناً وَقَتلاً","وَأَمِنَّ الجزا قِصاصاً وَثارا",54,"ر",2,0],["وارق وخل الحسود يهذي","إذا رأى في الورى علاك",55,"ك",1,0],["وَاِرقُب مَقاماً عالِياً","إِلَيكَ حالاً صائِرُ",56,"ر",1,0],["وأرقبُ خلقَك من عالمي","جياع ذئابٍ على جيفةٍ",57,"ه",1,0],["وأرقنَ الدموع من خشية الله","وزودننا بنصح سديد",58,"د",1,0],["وارقصي في ثوبك ال","شفاف رقصاً يستبيني",59,"ي",1,0],["وارقصي فوق الزهور","وارقصي فوق السماء",