"أيها الموت قد أخذلت الرجالا","https://www.poetsgate.com/ViewPoem.aspx?id=149461",""],[5111,"مَوجَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212369",""],[5277,"المقصورة النبوية","https://www.poetsgate.com/ViewPoem.aspx?id=187883",""],[5277,"هكذا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=187898",""],[5277,"سرُّ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=188635",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[5376,"تكالبتْ أممٌ والمجْدُ في حَلَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=188444",""],[5376,"ففيك الرجاء ومنك السلامْ","https://www.poetsgate.com/ViewPoem.aspx?id=188505",""],[333,"هجرة وميثاق","https://www.poetsgate.com/ViewPoem.aspx?id=98235",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5409,"تخشع النفس هيبةً من جلال ال","https://www.poetsgate.com/ViewPoem.aspx?id=155478",""],[5409,"فنُّ البيان رثاك قبل لساني","https://www.poetsgate.com/ViewPoem.aspx?id=155483",""],[5431,"رقص سوريالي!!","https://www.poetsgate.com/ViewPoem.aspx?id=200445",""],[5452,"الشّعر","https://www.poetsgate.com/ViewPoem.aspx?id=148452",""],[5497,"جادت تودعني","https://www.poetsgate.com/ViewPoem.aspx?id=210242",""],[5664,"اوراق","https://www.poetsgate.com/ViewPoem.aspx?id=46532",""],[5688,"وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=200896",""],[5851,"سندبادة وزادها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=175305",""],[5861,"أنت عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=189721",""],[5937,"حتى يليقَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=211823",""],[5939,"وقد يُفصِحُ الزهرُ عمّا مَسَك","https://www.poetsgate.com/ViewPoem.aspx?id=178613",""],[5956,"يحترق العاشق من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=182588",""],[5956,"دموعُ الفنِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193841",""],[6003,"شكوى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=188912",""],[6004,"خيال النَّدامى","https://www.poetsgate.com/ViewPoem.aspx?id=59141",""],[6017,"أفي كل عام غربة ونزوح","https://www.poetsgate.com/ViewPoem.aspx?id=129787",""],[6019,"،،\"اللهُ أَكبَرُ\" تَملَأُ الدُّنيَا صَدَى،،","https://www.poetsgate.com/ViewPoem.aspx?id=211904",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[6147,"رقاد في جوف الجنون","https://www.poetsgate.com/ViewPoem.aspx?id=213050",""],[1376,"وارقني خيال من حبيب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599386",""],[3155,"في حرم الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72292&r=&rc=4",""],[4222,"عفا الله عنكم مالكم أيها الرهط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52823&r=&rc=115",""]],"verses":[["وَأَرقُبُ خَفاقَ النَسيمِ إِذا حَدا","مِنَ الغَربِ أَعناقَ الرِياحِ الهَواجِمِ",0,"م",1,0],["وَأَرَّقَني دُعاءُ الوُرقِ فيها","عَلى جُرحٍ قَريبِ الاِندِمالِ",1,"ل",1,0],["وَاِرقُبي عَطفَةَ الزَمانِ بِجِدٍّ","رُبَّما حَلَّقَ الجَناحُ الحَصيصُ",2,"ص",1,0],["وَاِرقَ عَلى ظَلعِكَ هَيهاتَ أَن","يُزَعزَعَ الطَودُ بِمَرِّ الرِياح",3,"ح",1,0],["وَإِرقاصِ المَطِيِّ عَلى وَجاها","يَجبُنَ إِلى العُلى طُرُقاً نِهاجا",4,"ج",2,0],["وَاِرقَ المَعالي الَّتي أَوفى أَبوكَ بِها","فَكَم تَناوَلَها قَومٌ بِغَيرِ أَبِ",5,"ب",1,0],["وَأرَّقَ عَيْنِي والأسَى يَبْعَثُ الأَسَى","مُطَوّقَةٌ نَاحَتْ عَلَى غُصُنِ الْبَانِ",6,"ن",1,0],["وَاِرقُبيهِ كُلَّ يَومٍ إِنَّما","نَحنُ في قَبضَةِ عَلّامِ الغُيوبِ",7,"ب",1,0],["وأرقب الشهبَ فيه وهي ثابتةٌ","كأنَّما سمّرتْ منها مسامره",8,"ر",2,0],["وأرقَّ الدلالُ والغُنْجُ منه","وبَراهُ الشَّجا فكاد يبيدُ",9,"د",1,0],["وَأَرَّقَني مِن بَعدِ ما نِمتُ نَومَةً","وَعَضبٌ جَلَت عَنهُ القُيونُ بِطاني",10,"ن",2,0],["وَأَرَقتُ فيهِ دَمي فَكَي","فَ أُلامُ في دَمعي المُراقِ",11,"ق",1,0],["وارقصْ مع الأَضواءِ والأَنسامِ","ومع الينابيع الطليقة والصدى",12,"د",2,0],["وارقصْ على الوردِ والأَشواكِ متَّئِداً","غنَّتْ لكَ الطَّيرُ أَو غنَّتْ لكَ الرُّجُمُ",13,"م",1,0],["وَأُرقيهِم ذُرى دَرَجِ المَعالي","كَما أُجنيهِمُ ثَمرَ الأَماني",14,"ن",2,0],["وَاِرقَ المَنازِلَ كُلَّها","حَتّى تُنيفَ عَلى النُجومِ",15,"م",1,0],["وأرَّقَه وَبَادَرَ في سُراه","إليه فما يُنيمُ ولا يَنامُ",16,"م",1,0],["وأرْقُبُ يوماً فيهِ بالوَصْلِ تَلتقي","سجامُ دموعٍ بيننا بسِجامِ",17,"م",1,0],["وَأَرَقتُ فَضلَ صُبابَةٍ لِصَبابَةٍ","فَرَقَعتُ ما أَخلَقتُ مِن أَخلاقي",18,"ق",2,0],["وأرقصْ على حبّ ليلا","ك يا فؤادُ مليّا",19,"ي",2,0],["وأرقُّ النسيم لو مرَّ بالقا","ئم منها لدكَّه فهو بالِ",20,"ل",1,0],["وَأَرِقتَ مِن سارٍ سَرى","لَكَ في السُموطِ وَفي القَلائِد",21,"د",1,0],["وَاِرقُب إِلَهَكَ في عُسرٍ وَفي يُسُرٍ","وَاِترُك جِدالَكَ في بَعثٍ وَإِرسالِ",22,"ل",1,0],["وَارْقُبْ مِنَ اللَّهِ وَعْداً لَيْسَ يُخْلِفُهُ","لا بُدَّ ِللَّهِ مِنْ إِنْجازِ ما وَعَدا",23,"د",2,0],["وأرقّ من كلمَ يفوه بلفظها","يوم الفراق مودِّع لمودّع",24,"ع",1,0],["وَأَرْقَصْنَا الغصُونَ لَهُ","وَأَنْشدْنَا لَهُ الشِّعْرَا",25,"ر",2,0],["وأرق من طبع النسيم","فهل خلعت عليه بردك",26,"ك",1,0],["وارْقَدَّ كالكوْكَبِ في الإغْذاذِ","وامْتَدَّ باعُ القَرَبِ الحَذْحاذِ",27,"ذ",1,0],["وأرقناها دماء حرة","فاغرفي ما شئت منها واشربي",28,"ب",2,0],["وأرَّق بالهمِّ أسْحارها","وجلَّلَ بالغيم آصالَها؟",29,"ل",3,0],["وأرقت الدموع منك ولكن","غسل الدمع حرقتي والعناء",30,"ا",2,0],["وأرَّق العينَ والظلماءُ عاكفةٌ","ورقاءُ قد شفَّها إذْ شفَّني حزَنُ",31,"ن",1,0],["وإرقادُ قوم قد تركتُ لرفدِهِ","وعند ورود اليمِّ تُنسى المطائط",32,"ط",1,0],["وأرق الحديد بالحن والأ","ن اذا شمت طرفك الفتاكا",33,"ك",2,0],["وارقُد الليل كلّه لا تكُن سا","هرَ جَفْن على فراش وثيرِ",34,"ر",1,0],["وارقَ العُلَى وابْق البقاءَ ودُمْ وعِشْ","عمراً وأنت بما تَرَى مَسرُورُ",35,"ر",1,0],["وَأَرَّقَ عَينى عَلى غِرَّةٍ","فَباتَت بِحُزنٍ تُقاسي السُهودا",36,"د",2,0],["وارقصي فالقلب ما","بين الحنايا قد رقص",37,"ص",1,0],["وارقص وصفق وطر واهتف وغن به","وحيه واسكب الأشواق ألحانا",38,"ن",2,0],["وأرَقتُها كرهاً على جزعٍ","فوقَ الرمالِ وبتُّ في سقرِ",39,"ر",1,0],["وارقُصي وانفُثيه سما زعافاً","يا أفاعي الخنا بكل رذيلِ",40,"ل",1,0],["وأرقُّ من نَغَم البلابلِ عندما","تستَقبِلُ الأصباحَ بالألحانِ",41,"ن",1,0],["وارقب طلوع الفجر من أزراره","واعذر لطلعته المؤذن في السحر",42,"ر",1,0],["وَاِرقُصي إِنَّما البَراكينُ تَغلي","تَحتَ رجلَيكِ كَالجَحيمِ النَذيرِ",43,"ر",1,0],["وَاِرقُصي إِن وَدَدتِ فَوقَ تُرابٍ","ضَمَّ قَلباً لِمُغرَمٍ وَعُيونا",44,"ن",2,0],["وأرَّق العينَ بالحيَّين مُتَّلهِ","يُقَطِّع الليلَ تغريدا وتعديدا",45,"د",2,1],["وَأَرَّقَني في اللَيلِ تَرجيعُ وادِعٍ","مِنَ الوُرقِ في فَرعٍ مِنَ البانِ مَكدودِ",46,"د",1,0],["وَارْقَيْ عُلاً مَهْمَا تَبَارَى وَازْدَرَى","بِالْقَصْرِ ذِي الشُّرُفَاتِ مِنْ سِنْدَادِ",47,"د",1,0],["وَأَرْقَاهُ إِلَى الأَعْلَى وَرَقَّى","مَزِيَّتَهُ لَدَى الْمَلإِ الْمَكِينِ",48,"ن",1,0],["وَارْقَعْ بِهَا خَرْقَ الدُّيُو","نِ وَجُدَّ أَسْبَابَ التَّلَفْ",49,"ف",1,0],["وَارْقَيْنَ شَامِخَ الْعُلاَ باِلتَّعَامِي","فَكَذَلِكَ الْكِرَامُ قِدْماً رَقَوْهُ",50,"و",2,0],["وارْقِني من أيِّ مَسٍّ","من جُنونٍ قد يُصِبْني",51,"ن",2,0],["وأرقمْ صحائفك الحسانَ بوصفه","فبه تروق الناظرين وتؤنقُ",52,"ق",1,0],["وأَرقَم الصدغَ والعذارَ على","صفحةِ خدّيه من بَرى قلمَه",53,"م",2,0],["وأَرقنَ الدماءَ طَعناً وَقَتلاً","وَأَمِنَّ الجزا قِصاصاً وَثارا",54,"ر",2,0],["وارق وخل الحسود يهذي","إذا رأى في الورى علاك",55,"ك",1,0],["وَاِرقُب مَقاماً عالِياً","إِلَيكَ حالاً صائِرُ",56,"ر",1,0],["وأرقبُ خلقَك من عالمي","جياع ذئابٍ على جيفةٍ",57,"ه",1,0],["وأرقنَ الدموع من خشية الله","وزودننا بنصح سديد",58,"د",1,0],["وارقصي في ثوبك ال","شفاف رقصاً يستبيني",59,"ي",1,0],["وارقصي فوق الزهور","وارقصي فوق السماء",59,"ا",2,0],["وارقصي في جنون","واعشقي في اضطراب",60,"ب",1,0],["وَاِرقَ إِلى سَطحِ سَطيحٍ تَجِدِ ال","جَنّاتِ وَالوَلَدانَ فيها وَالسُرُر",61,"ر",1,0],["واِرقَ عَلى فلك السَعادة وَالعُلى","فَلَكَ التَهاني بدؤها وَخِتامُها",62,"م",3,0],["وأرَّقني والمَشْرَفيُّ مُضاجِعي","سَنا بارقٍ أسْرَى فَهيَّجَ أَحزاني",63,"ن",2,0],["وأرِقتُ حتى قال شوقي نحوكم","أَرَقٌ على أرقٍ ومثلي يأرق",64,"ق",1,0],["وأرقت فينا رائق النعمى لذا","راق الغرام بروقك المُترائي",65,"ي",1,0],["وَأَرق مِن نَفسي وَقَد","أَزف الرَحيل وَوَدعوا",66,"ع",3,0],["وأرق للعينين من تهويمها","وأجل من نظم البديع وجرول",67,"ل",1,0],["وأرَّقَني في الدُّجى بارقٌ","كما استُلَّ من غمده مخذم",68,"م",1,0],["