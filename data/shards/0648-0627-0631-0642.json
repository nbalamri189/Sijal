ٍ","أراها اليومَ ليس لها ازدجارُ",95,"ر",1,0],["وأرَّقَني ما لا يزالُ يروقني","غَزالُ اناسِ قاصِرُ الطَّرفِ فاتِرُهُ",96,"ر",2,0],["وارقب للمهدي وثبة خاذر","يقوم من دين الهدى ما تأودا",97,"د",2,0],["وارق علوا إذا تواضعت سفلا","واحظ بالعز إن أتيت ذليلا",98,"ل",2,0],["وَأرَّقَنِي فِي اللَّيْلِ بَدْرٌ لأجْلِهِ","سَهِرْتُ غَرَامًا وَالْعُيُونُ رُقُودُ",99,"د",1,0],["وَأرقبُ البرقَ أنَّي سَار سَائِرُهُ","مِنْ أجْلِ مَا أنَّهُ للثَّغرِ يَنْتَسِبُ",100,"ب",1,0],["وأرقم الوصف فيه إنه حسن","والثوب بحسن إن نساجه رقما",101,"م",2,0],["وأرقب أني ساعة بعد ساعة","لأنيابه مُلْقًى وللفم ملقم",102,"م",1,0],["وأرقب بعد غد","وأهرب من حاضري",103,"ر",2,0],["وارق المعالي راشداً","ودع الحسود على الضلال",104,"ل",1,0],["وارقم على صفحات الوجد احرفها","وافهم رموز العلى في الخبر والخبر",105,"ر",1,0],["وارقى مقام الكمال على","طريق النبي الذي قد ختم",106,"م",1,0],["وأرقني خيالٌ من حبيبٍ","تناءت داره حتى نآني",107,"ي",1,1],["وَأَرَّقَنِي وَالعُيُونُ هُجُوعٌ","حَمَامٌ كَقَلْبِي بِذِي الأثْلِ طَارَا",108,"ر",2,0],["وَأَرَّقَنِي مِنْ جَانِبِ الرَّمْلِ سَاجِعٌ","طَرُوبٌ إِذَا هَزَّتْ صَباً أعْطُفَ الرَّنْدِ",109,"د",1,0],["وأرقشَ في مجاجته مَشوبٌ","نَقيعُ السمِّ بالضرب المُذاب",110,"ب",1,0],["وارق الصفا واسع منها نحو مروتها","سبعا وأنت بذكر الله مشغول",111,"ل",1,0],["وأرقني من جانب الروض نفحةٌ","بأنفاسها ريح الصبا تتأرج",112,"ج",1,0],["وأرقُب نجم الليل غيرانَ أنه","يرى آلَ نُعمٍ عند كلِّ طلوع",113,"ع",1,0],["وَأَرَقتُ الدُموعَ مِلءَ اِبتِساما","تي اللَواتي وارَيتُ فيها التَوَجُّد",114,"د",1,0],["وَاِرقُص عَلى الغُصنِ النَضيرِ مُرَجِّعاً","في كُلِّ مُؤنِقَةٍ وَرَوضٍ مُمرَعِ",115,"ع",1,0],["وأَرقشَ مشقوقِ اللسان لُعابه","يُميتُ ويُحيي في حُروفٍ وأسطر",116,"ر",1,0],["وارقب الأعداء واحذر","للعيون الناظراتِ",117,"ت",1,0],["وارقب العرش في بطانة خير","خيرها تحت ظله مكفول",118,"ل",1,0],["وأَرْقى إليها في سلاليمَ لم تكن","ليجعل ذابِلا وقَضِيبا",119,"ب",2,0],["وأرقني بالأبرق الفرد طارق","وَوُرق غدت في مورق البان تسجع",120,"ع",1,0],["وارقب أحوالي إذا كان عينها","واشهده في صورة الوهب والمنع",121,"ع",1,0],["وارقبه