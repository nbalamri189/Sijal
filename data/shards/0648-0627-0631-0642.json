{"poems":[[53,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[53,"لحب إلي بالدهناء ملقى","https://www.aldiwan.net/poem29852.html","الوافر"],[53,"رب مستغمز إبائي وفي الناس","https://www.aldiwan.net/poem30176.html","الخفيف"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[72,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[70,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[92,"ترجو السعادة يا قلبي ولو وجدت","https://www.aldiwan.net/poem38910.html","البسيط"],[78,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[85,"قالوا تمايز حمزة","https://www.aldiwan.net/poem8057.html","مجزوء الكامل"],[61,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[74,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[102,"هواك أصبح نسيا","https://www.aldiwan.net/poem32994.html","المجتث"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[50,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[46,"قد طال في العيش تقييدي وإرسالي","https://www.aldiwan.net/poem23221.html","البسيط"],[76,"بادر إلى التوبة الخلصاء مجتهدا","https://www.aldiwan.net/poem39455.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54947","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141975","الكامل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142345","الرمل"],[106,"أجادير","https://www.poetsgate.com/ViewPoem.aspx?id=179602",""],[73,"هَلْ تذكُرونَ غريباً عادَهُ شَجَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=201341",""],[51,"بدا الشيبُ إلا ما تُداوي المواشطُ","https://www.poetsgate.com/ViewPoem.aspx?id=29405",""],[113,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[126,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[126,"أنا مذ نشأت بسيبكم مغمور","https://www.aldiwan.net/poem50604.html","الكامل"],[135,"سرى طيف ذا الظبي بالعاقدان","https://www.aldiwan.net/poem67914.html","الكامل"],[195,"أترعي الأقداح يا حوا","https://www.aldiwan.net/poem39879.html","مجزوء الرمل"],[195,"يا طائر الفجرِ من بالراح أغرانا","https://www.aldiwan.net/poem39886.html","البسيط"],[195,"يا مي ناب السمع عن بصري","https://www.aldiwan.net/poem39941.html","أحذ الكامل"],[195,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[195,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[220,"حكم اخص بها منادمة الفكر","https://www.aldiwan.net/poem55468.html","الكامل"],[221,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[221,"كنت بالأمس ربة العاشقينا","https://www.aldiwan.net/poem41911.html","الخفيف"],[227,"وأرق العين بالحيين متله","https://www.aldiwan.net/poem51141.html","البسيط"],[233,"أبثك وجدي لو أصخت لمعمود","https://www.aldiwan.net/poem32105.html","الطويل"],[235,"يا من ألح علي في الإنشاد","https://www.aldiwan.net/poem18166.html","الكامل"],[235,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[235,"فخذ الزكاة ولا تخف","https://www.aldiwan.net/poem19502.html","مجزوء الكامل"],[235,"لله يوم شربنا فيه كأس منى","https://www.aldiwan.net/poem19743.html","البسيط"],[252,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[279,"اختم بذكر محمد فذكره","https://www.aldiwan.net/poem1378.html",""],[295,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[295,"اسقياني على اقتراح العذارى","https://www.aldiwan.net/poem33258.html","الخفيف"],[301,"طل في العلا والعلوم حتى","https://www.aldiwan.net/poem57694.html","مخلع البسيط"],[318,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[326,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[326,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[340,"يا عروسا في ثياب الرقص","https://www.aldiwan.net/poem55341.html","مجزوء الرمل"],[340,"يا شعاع الصباح","https://www.aldiwan.net/poem55362.html","مجزوء الخفيف"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[351,"أظباء رامة بالظبى آرامها","https://www.aldiwan.net/poem39962.html","الكامل"],[362,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[374,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[374,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[377,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[400,"نظم أرق من الرحيق السلسل","https://www.aldiwan.net/poem33480.html","الكامل"],[413,"متى يشتفي كبد مؤلم","https://www.aldiwan.net/poem53957.html","المتقارب"],[413,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[413,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[413,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[429,"يقر لغليلم المليك بن غليلم","https://www.aldiwan.net/poem12345.html","الطويل"],[429,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[436,"جاءتك خاضعة أعناقها الأمم","https://www.aldiwan.net/poem34812.html","البسيط"],[436,"ألا هكذا فليسم للمجد من سما","https://www.aldiwan.net/poem34814.html","الطويل"],[446,"حبذا والحال داجي الظلم","https://www.aldiwan.net/poem53777.html","الرمل"],[451,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[456,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[456,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[482,"وأرقني والليل قد ذر ساحه","https://www.aldiwan.net/poem1124.html",""],[498,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[498,"قمنا لنساوت النبي مثالا","https://www.aldiwan.net/poem37629.html","الكامل"],[498,"ماذا يضر البدر وهو في السما","https://www.aldiwan.net/poem37630.html","الرجز"],[498,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[503,"الحظّ","https://www.aldiwan.net/poem42462.html","الطويل"],[513,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[549,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[585,"إن القريض إن أرسلت قد وصلا","https://www.aldiwan.net/poem11507.html","عموديه"]],"verses":[["وَأَرقُبُ خَفاقَ النَسيمِ إِذا حَدا","مِنَ الغَربِ أَعناقَ الرِياحِ الهَواجِمِ",0,"م",1,0],["وَأَرَّقَني دُعاءُ الوُرقِ فيها","عَلى جُرحٍ قَريبِ الاِندِمالِ",1,"ل",1,0],["وَاِرقُبي عَطفَةَ الزَمانِ بِجِدٍّ","رُبَّما حَلَّقَ الجَناحُ الحَصيصُ",2,"ص",1,0],["وَاِرقَ عَلى ظَلعِكَ هَيهاتَ أَن","يُزَعزَعَ الطَودُ بِمَرِّ الرِياح",3,"ح",1,0],["وَإِرقاصِ المَطِيِّ عَلى وَجاها","يَجبُنَ إِلى العُلى طُرُقاً نِهاجا",4,"ج",2,0],["وَاِرقَ المَعالي الَّتي أَوفى أَبوكَ بِها","فَكَم تَناوَلَها قَومٌ بِغَيرِ أَبِ",5,"ب",1,0],["وَأرَّقَ عَيْنِي والأسَى يَبْعَثُ الأَسَى","مُطَوّقَةٌ نَاحَتْ عَلَى غُصُنِ الْبَانِ",6,"ن",1,0],["وَاِرقُبيهِ كُلَّ يَومٍ إِنَّما","نَحنُ في قَبضَةِ عَلّامِ الغُيوبِ",7,"ب",1,0],["وأرقب الشهبَ فيه وهي ثابتةٌ","كأنَّما سمّرتْ منها مسامره",8,"ر",2,0],["وأرقَّ الدلالُ والغُنْجُ منه","وبَراهُ الشَّجا فكاد يبيدُ",9,"د",1,0],["وَأَرَّقَني مِن بَعدِ ما نِمتُ نَومَةً","وَعَضبٌ جَلَت عَنهُ القُيونُ بِطاني",10,"ن",2,0],["وَأَرَقتُ فيهِ دَمي فَكَي","فَ أُلامُ في دَمعي المُراقِ",11,"ق",1,0],["وارقصْ مع الأَضواءِ والأَنسامِ","ومع الينابيع الطليقة والصدى",12,"د",2,0],["وارقصْ على الوردِ والأَشواكِ متَّئِداً","غنَّتْ لكَ الطَّيرُ أَو غنَّتْ لكَ الرُّجُمُ",13,"م",1,0],["وَأُرقيهِم ذُرى دَرَجِ المَعالي","كَما أُجنيهِمُ ثَمرَ الأَماني",14,"ي",1,0],["وَاِرقَ المَنازِلَ كُلَّها","حَتّى تُنيفَ عَلى النُجومِ",15,"م",1,0],["وأرَّقَه وَبَادَرَ في سُراه","إليه فما يُنيمُ ولا يَنامُ",16,"م",1,0],["وأرْقُبُ يوماً فيهِ بالوَصْلِ تَلتقي","سجامُ دموعٍ بيننا بسِجامِ",17,"م",1,0],["وَأَرَقتُ فَضلَ صُبابَةٍ لِصَبابَةٍ","فَرَقَعتُ ما أَخلَقتُ مِن أَخلاقي",18,"ق",2,0],["وأرقصْ على حبّ ليلا","ك يا فؤادُ مليّا",19,"ي",2,0],["وأرقُّ النسيم لو مرَّ بالقا","ئم منها لدكَّه فهو بالِ",20,"ل",1,0],["وَأَرِقتَ مِن سارٍ سَرى","لَكَ في السُموطِ وَفي القَلائِد",21,"د",1,0],["وَاِرقُب إِلَهَكَ في عُسرٍ وَفي يُسُرٍ","وَاِترُك جِدالَكَ في بَعثٍ وَإِرسالِ",22,"ل",1,0],["وَارْقُبْ مِنَ اللَّهِ وَعْداً لَيْسَ يُخْلِفُهُ","لا بُدَّ ِللَّهِ مِنْ إِنْجازِ ما وَعَدا",23,"د",2,0],["وأرقّ من كلمَ يفوه بلفظها","يوم الفراق مودِّع لمودّع",24,"ع",1,0],["وَأَرْقَصْنَا الغصُونَ لَهُ","وَأَنْشدْنَا لَهُ الشِّعْرَا",25,"ر",2,0],["وأرق من طبع النسيم","فهل خلعت عليه بردك",26,"ك",1,0],["وارْقَدَّ كالكوْكَبِ في الإغْذاذِ","وامْتَدَّ باعُ القَرَبِ الحَذْحاذِ",27,"ذ",1,0],["وأرقناها دماء حرة","فاغرفي ما شئت منها واشربي",28,"ب",2,0],["وأرَّق بالهمِّ أسْحارها","وجلَّلَ بالغيم آصالَها؟",29,"ل",3,0],["وأرَّق العينَ والظلماءُ عاكفةٌ","ورقاءُ قد شفَّها إذْ شفَّني حزَنُ",30,"ن",1,0],["وإرقادُ قوم قد تركتُ لرفدِهِ","وعند ورود اليمِّ تُنسى المطائط",31,"ط",1,0],["وأرق الحديد بالحن والأ","ن اذا شمت طرفك الفتاكا",32,"ك",2,0],["وارقُد الليل كلّه لا تكُن سا","هرَ جَفْن على فراش وثيرِ",33,"ر",1,0],["وارقَ العُلَى وابْق البقاءَ ودُمْ وعِشْ","عمراً وأنت بما تَرَى مَسرُورُ",34,"ر",1,0],["وَأَرَّقَ عَينى عَلى غِرَّةٍ","فَباتَت بِحُزنٍ تُقاسي السُهودا",35,"د",2,0],["وارقصي فالقلب ما","بين الحنايا قد رقص",36,"ص",1,0],["وارقص وصفق وطر واهتف وغن به","وحيه واسكب الأشواق ألحانا",37,"ن",2,0],["وأرَقتُها كرهاً على جزعٍ","فوقَ الرمالِ وبتُّ في سقرِ",38,"ر",1,0],["وارقُصي وانفُثيه سما زعافاً","يا أفاعي الخنا بكل رذيلِ",39,"ل",1,0],["وأرقُّ من نَغَم البلابلِ عندما","تستَقبِلُ الأصباحَ بالألحانِ",40,"ن",1,0],["وارقب طلوع الفجر من أزراره","واعذر لطلعته المؤذن في السحر",41,"ر",1,0],["وَاِرقُصي إِنَّما البَراكينُ تَغلي","تَحتَ رجلَيكِ كَالجَحيمِ النَذيرِ",42,"ر",1,0],["وَاِرقُصي إِن وَدَدتِ فَوقَ تُرابٍ","ضَمَّ قَلباً لِمُغرَمٍ وَعُيونا",43,"ن",2,0],["وأرَّق العينَ بالحيَّين مُتَّلهِ","يُقَطِّع الليلَ تغريدا وتعديدا",44,"د",2,1],["وَأَرَّقَني في اللَيلِ تَرجيعُ وادِعٍ","مِنَ الوُرقِ في فَرعٍ مِنَ البانِ مَكدودِ",45,"د",1,0],["وَارْقَيْ عُلاً مَهْمَا تَبَارَى وَازْدَرَى","بِالْقَصْرِ ذِي الشُّرُفَاتِ مِنْ سِنْدَادِ",46,"د",1,0],["وَأَرْقَاهُ إِلَى الأَعْلَى وَرَقَّى","مَزِيَّتَهُ لَدَى الْمَلإِ الْمَكِينِ",47,"ن",1,0],["وَارْقَعْ بِهَا خَرْقَ الدُّيُو","نِ وَجُدَّ أَسْبَابَ التَّلَفْ",48,"ف",1,0],["وَارْقَيْنَ شَامِخَ الْعُلاَ باِلتَّعَامِي","فَكَذَلِكَ الْكِرَامُ قِدْماً رَقَوْهُ",49,"و",2,0],["وارْقِني من أيِّ مَسٍّ","من جُنونٍ قد يُصِبْني",50,"ن",2,0],["وأرقمْ صحائفك الحسانَ بوصفه","فبه تروق الناظرين وتؤنقُ",51,"ق",1,0],["وأَرقَم الصدغَ والعذارَ على","صفحةِ خدّيه من بَرى قلمَه",52,"م",2,0],["وأَرقنَ الدماءَ طَعناً وَقَتلاً","وَأَمِنَّ الجزا قِصاصاً وَثارا",53,"ر",2,0],["وارق وخل الحسود يهذي","إذا رأى في الورى علاك",54,"ك",1,0],["وَاِرقُب مَقاماً عالِياً","إِلَيكَ حالاً صائِرُ",55,"ر",1,0],["وأرقبُ خلقَك من عالمي","جياع ذئابٍ على جيفةٍ",56,"ه",1,0],["وأرقنَ الدموع من خشية الله","وزودننا بنصح سديد",57,"د",1,0],["وارقصي في ثوبك ال","شفاف رقصاً يستبيني",58,"ي",1,0],["وارقصي فوق الزهور","وارقصي فوق السماء",58,"ا",2,0],["وارقصي في جنون","واعشقي في اضطراب",59,"ب",1,0],["وَاِرقَ إِلى سَطحِ سَطيحٍ تَجِدِ ال","جَنّاتِ وَالوَلَدانَ فيها وَالسُرُر",60,"ر",1,0],["واِرقَ عَلى فلك السَعادة وَالعُلى","فَلَكَ التَهاني بدؤها وَخِتامُها",61,"م",3,0],["وأرَّقني والمَشْرَفيُّ مُضاجِعي","سَنا بارقٍ أسْرَى فَهيَّجَ أَحزاني",62,"ي",1,0],["وأرِقتُ حتى قال شوقي نحوكم","أَرَقٌ على أرقٍ ومثلي يأرق",63,"ق",1,0],["وأرقت فينا رائق النعمى لذا","راق الغرام بروقك المُترائي",64,"ي",1,0],["وَأَرق مِن نَفسي وَقَد","أَزف الرَحيل وَوَدعوا",65,"ع",3,0],["وأرق للعينين من تهويمها","وأجل من نظم البديع وجرول",66,"ل",1,0],["وأرَّقَني في الدُّجى بارقٌ","كما استُلَّ من غمده مخذم",67,"م",1,0],["وأرَّقتني الوُرْقُ في أفنانها","تردِّد التغريد واللُّحونا",68,"ن",2,0],["وأرّقني يا سعد برقٌ أشيمه","يزرّ على الأكناف برقاً مذهبا",69,"ب",2,0],["وأرِق دموعك إنَّما هي لوعةٌ","بعثَتْ إليك من الدموع سيولا",70,"ل",2,0],["وأَرقصْتَ أَعطافَ السَّرِيرِ مَسَرَّةً","غداةَ هَفَا تحتَ السِّياسَةِ والحِلمِ",71,"م",1,0],["وأرقطَ إما نسبةٌ حين يَنتَمي","فصقرٌ وإما نصْبةٌ فهو بُسْتانُ",72,"ن",1,0],["وأَرقَمٍ يتلَوَّى نحو أَرْؤُسِهِمْ","حَتَّى يكادُ لَهَا فِي الجو يَلْتَقِمُ",73,"م",1,0],["وأَرْقَمُ يسطُو بالهواءِ اضْطِرابُهُ","يناهِسُ فِي ليلٍ من النقعِ أَرقما",74,"م",2,0],["وارق اعلى رتب عن رتب","وابق مولى نعم في نعم",75,"م",1,0],["وأرقب الكادح الفلاح ممتلكا","لأرضه لا بهيما ملك أطيان",76,"ن",1,0],["وأرقَبُ الناسِ لما لا يرَى","في الليل باغِي عثرةِ الأنجمِ",77,"م",1,0],["وأرقَعُ أيّامي أروم صلاحَها","وقد فسد العيشُ الذي كنت تُصلِحُ",78,"ح",1,0],["وأرقى لمرقى القدس والبخت راقيا","بإقباله في السعديات الإقباليه",79,"ي",2,0],["وأرَّقني واللَّيْلُ قد ذَرَّ ساحَه","غِناءُ بني سعْدٍ على زِقِّ حازِمِ",80,"م",1,1],["وارقب تغيُّر حاله","فالبحر يغرق راكبه",81,"ب",2,0],["وارقب بشارات السماء فإننا","قمنا عن الهادي الأمين ظلالا",82,"ل",2,0],["وارقت من النصر الإلهي بدا","تمحو من الخصم الألدِّ الأرسما",83,"م",2,0],["وارقُبْ بِشاراتِ السَّماءِ فإنَّها","نقَشَتْ على صُحُفِ القُلُوبِ سُطُورَا",84,"ر",2,0],["وأرقبُ ساعة الغروبِ وأهربُ","إلى الليلِ علّه من الحظِّ أرحمُ",85,"م",1,0],["وأرقهم ديباجة من عنده","غزل يرود هوى الفتاة الرود",86,"د",1,0],["وأرقُبُ منك خدّاعاً لِحسّي","مَروقاً ب