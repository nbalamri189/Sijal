لعيني رجاءً بدا","https://www.poetsgate.com/ViewPoem.aspx?id=196441",""],[5431,"واستكثر من الشعر...","https://www.poetsgate.com/ViewPoem.aspx?id=210836",""],[5431,"وما كلّ وجه بالبشاشة صادق","https://www.poetsgate.com/ViewPoem.aspx?id=211697",""],[5533,"الغفلة","https://www.poetsgate.com/ViewPoem.aspx?id=181532",""],[5956,"أجبني","https://www.poetsgate.com/ViewPoem.aspx?id=182296",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"سيغرد القلب الحنونُ بعودتكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193305",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[6070,"إذا ما كنْتَ تَرغبُ في أمانِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=190291",""],[6093,"أخْلو ، ونفسيَ للهمومِ مَطَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=176070",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""]],"verses":[["سيغوصن بنا مركبنا","في خضم قد ابى ان يسكنا",0,"ن",2,0],["سَيُغنيني الَّذي أَغناهُ عَنّي","فَلا فَقرٌ يَدومُ وَلا ثَراءُ",1,"ا",2,0],["سَيغفِرُ ما أسلفتَ من جَاهليَّةٍ","لَيالِيَ تأبَى أن يُطاعَ وَيُعْبَدَا",2,"د",2,0],["سيُغنيك رسمي عن أمور كثيرة","فظاهرُهُ عن باطن الأمر كاشف",3,"ف",1,0],["سيغضبُ يا شقيُّ له مليكٌ","زئير الأَسد حوليه نباحُ",4,"ح",1,0],["سَيغضب لي منهُ على الدهرِ مصرخ","يرى الحلمَ عجزاً إن يسم جاره نكبا",5,"ب",2,0],["سيغسل عنها السيف أدران بدعة","فيشرق في الآفاق نور سناها",6,"ا",3,0],["سيغشِم قائدُ الأطماع عُنْقي","بأنفٍ لا يلين على الخِزامَهْ",7,"م",2,0],["سَيَغدو لَكُم دورٌ جَديدٌ بِجودِهِ","وَقَبلاً أَياديهِ عَلى هامِكُم تَترى",8,"ر",2,0],["سَيَغلِبُ قَوماً غالَبوا اللَهَ مَن كانَ قَلبُهُ","وَإِن كايَدوهُ كانَ أَقوى وَأَكيَدا",9,"د",2,0],["سيُغني الله عن فرج القريبِ","ويأتي اللهُ بالفرج القريبِ",10,"ب",1,1],["سَيُغني أَبا الهِنديِّ عَن وَطبِ سالِمٍ","أَباريقَ كالغُزلانِ بيضٌ نُحورُها",11,"ر",3,0],["سَيغني أَبا الهنديّ عَن وَطبِ سالِمٍ","أَباريقَ لَم يعلق بِها وَضرَ الزبدِ",12,"د",1,0],["سيغشاك ما تخشى قريباً وهل بها","من الليل إذ يغشى فرار لشارد",13,"د",1,0],["سيغطّي على ضيائك نوري","وعيوني تحيل عينك رمدا",14,"د",2,0],["سيَغْزو أعاديهِ بشُهْبِ كتائِبٍ","تُطاوِلُها شهْبُ الدُجى فتَطولُها",15,"ل",3,0],["سيغني الورى عن شرح حالي رعايتي","بعين العزيز الحاذق المتفرس",16,"س",1,0],["سيغلبني الشيخ وهو الغني","وأحر بذي المال أن يغلبا",17,"ب",2,0],["سيُغضِبُ قَولِي سيِّداً ذَا خُطُورةٍ","لدَيهِ الأَخائِيُّون تَعنُو كما تَرى",18,"ر",2,0],["سيغنيني الذي أغناك عني","وولاك المكارم واصطفاك",19,"ك",1,0],["سيغيب هذا الليل عن وطني فلا","تعلو سوى شمس الضحى بدياري",20,"ر",2,0],["سيُغادرُ الجَسَدُ المَهيبُ مُوَلِّيًا","شَطْرَ البلادِ ومَشرِقَ الأعوامِ",21,"م",1,0],["سَيَغْرَقُ مَرْكَبِي فِي بَحْرِ قَلْبِي","وَ يُخْفِي الْبَدْرُ عَنْ عَيْنِي بَرِيقَهْ",22,"ق",2,0],["سيغدو المسجدُ الأقصى","طلولاً أُسُّها خَرِبُ",23,"ب",1,0],["سيغلبُك العراقُ بلا سلاحٍ","وتدحركَ البنادقُ والسهامُ",24,"م",1,0],["سيغسل عنها السيف أوساخ بدعةٍ","فتسمق أنوار الهدى فتراها",25,"ا",3,0],["سيغدو الفداء بداري ربيعاً","فلن تذهبَ التضحياتُ سدى",26,"د",2,0],["سيغلب الحبّ: قال الطير حين شدا","فداوِ بالحب واستكثر من الشعر",27,"ر",1,0],["سيغزو جراد الغي أرضي لتقفرا","ويغدو اشتهاء البرّ في الصدر خنجرا",28,"ر",2,0],["سيَغْزو أَهْلُ كُفْرٍ عُقْرَ دارٍ","غَفَا أَبْناؤُها وبَنوا قُصُورا",29,"ر",2,1],["سيغزوني الجنون فيا لَعقلي","ورغم شبيبتي سأحِسُّ موتا",30,"ت",2,0],["سيغيّرون مقاسنا ونفوسنا","وفقاً لمعيار الصهاينة الأشِرْ",31,"ر",1,0],["سيُغرد القلب الحنونُ بعودتكْ","وتُسَرُّ أطيار السلام بطلعتكْ",32,"ك",1,1],["سيغمر خِصْبُ فكري كلَّ أرضٍ","لتغْنَى بالرَّفاهة لا القبورِ",33,"ر",1,0],["سَيَغْرفُ منْ فؤادكَ قولَ كُرهٍ","وإنْ كنتَ المقفعَ في بيانِكْ",34,"ك",1,0],["سيغار للعرض السليبِ وربِّه","ربّ ٌ عظيم قادرٌ جبَّار",35,"ر",1,0],["سيغرق في بحر الدموع فقوله","هراء لعمري للصواب مخالف",36,"ف",1,0]]}