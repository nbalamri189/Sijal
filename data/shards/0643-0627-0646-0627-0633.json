{"poems":[[55,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[95,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[23,"أبلغ هوازن أعلاها وأسفلها","https://www.aldiwan.net/poem21365.html","البسيط"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[87,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[47,"من قائل للزمان ما أربه","https://www.aldiwan.net/poem11054.html","المنسرح"],[51,"كأنا وإن كنا نياما عن الردى","https://www.aldiwan.net/poem62059.html","الطويل"],[82,"وطيبة الأنفاس تحسب وصلها","https://www.aldiwan.net/poem31311.html","الطويل"],[33,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[50,"رأيت نسا هذا الزمان خبائي","https://www.aldiwan.net/poem66241.html","الطويل"],[48,"يزورني القوم هذا أرضه يمن","https://www.aldiwan.net/poem22795.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55139","الطويل"],[102,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[190,"قولوا لنا من في الأكاسرة","https://www.aldiwan.net/poem43225.html","مجزوء الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[280,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[302,"أشمس سناها في الدجنة بازغ","https://www.aldiwan.net/poem33222.html","الطويل"],[435,"نادت ذوابله في كفه عجبا","https://www.aldiwan.net/poem40829.html","البسيط"],[469,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[482,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[572,"بكرت تلوم ومثلها لك لائمه","https://www.aldiwan.net/poem69523.html","الرجز"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/79625","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64218","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71022","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96623","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72299","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80177","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105867","الرجز"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74993","الوافر"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138802",""],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121757","الرجز"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102390","الوافر"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105784","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91775","الطويل"],[3854,"","https://poetry.dctabudhabi.ae/diwan/poem/47370","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103025","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103062","البسيط"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198562","الطويل"],[4366,"","https://poetry.dctabudhabi.ae/diwan/poem/31513","الوافر"],[4755,"هُطُول","https://www.poetsgate.com/ViewPoem.aspx?id=184806",""],[5005,"حرفٌ في مهبِّ الريح..","https://www.poetsgate.com/ViewPoem.aspx?id=189357",""],[5122,"(( يامضيع العشاق..1))","https://www.poetsgate.com/ViewPoem.aspx?id=27095",""],[5277,"عهدٌ... إلى عهدٍ التميميِّ تلكَ الَّتي كشفتْ بصفعتِها عِوارَنا...","https://www.poetsgate.com/ViewPoem.aspx?id=194810",""],[5358,"همسات القدر","https://www.poetsgate.com/ViewPoem.aspx?id=21894",""],[5573,"صلوا في رحالكم","https://www.poetsgate.com/ViewPoem.aspx?id=210867",""],[5582,"هَلاَّ شَجِيتَ لِلَحْنِ الشَّادِنِ الغَنِجِ","https://www.poetsgate.com/ViewPoem.aspx?id=63475",""],[2110,"كرعتها وحباب الكأس مشتبك","https://www.poetsgate.com/ViewPoem.aspx?id=156284",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5939,"زار كالسحر ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=195323",""],[572,"قَدْ عَزَمْنَا على مباكَرَة ِ الشّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9474&r=&rc=331",""]],"verses":[["كَأَنَّ أَسِنَّتَهُ في القَنا","شَرارٌ ظُبى البيضِ نيرانُهُ",0,"ن",2,0],["كَانَ أسْمَى مَعْنًى وَألْطَفُهُ","مَا بِهذَا الحَشْدِ المَهِيبِ عُنِي",1,"ن",2,0],["كَأَنَّ أَسنانَهُم مِن خُبثِ طِعمَتِهِم","أَظفارُ خاتِنَةٍ كَلَّت مَواسيها",2,"ي",3,0],["كأن إسرافهُ برهبة مق","هور عليه وحرص مؤتجَرِ",3,"ر",1,0],["كَأَنَّ أَسامِيَ الأَبطالِ فيهِ","حَوامِمٌ عَلى رِقٍّ تَتالى",4,"ل",2,0],["كَأَنَّ إِسراعَهُ تَرَسُّلُهُ","قَرارَ جَأشٍ أَو جِدَّهُ لَعِبُه",5,"ب",2,0],["كَأَنّا سَفاهاً لَم نُصَب بِمُصيبَةٍ","وَلَم نَرَ مِنّا مَيِّتاً جَوفَ مُلحَدِ",6,"د",1,0],["كَأَنَّ استِماعَ اللَّفظ منها تَعَلُّلٌ","بلذّة راحٍ واقتراحِ ترنُّمِ",7,"م",1,0],["كَأَنَّ إِسفِنطَةً شيبَت بِذَي شَبَمٍ","مِن صَوبِ أَزرَقَ هَبَّت ريحُهُ شَمَلا",8,"ل",2,0],["كَأَنَّ إِسحاقَ يَشدو في هَيادِبِها","أَو مَعبداً يَتَغَنّى في عَزاليها",9,"ي",3,0],["كأنّ استَهُ كانت لأيريَ عن أبي","أبيهِ لهُ دون الأنام تراثا",10,"ث",2,0],["كَأَنَّ أَسرارَ أَقوامٍ وَإِن كُتِمَت","أَنفاسُ وَلهانَ تُطَفّى حينَ تُحتَبَسُ",11,"س",1,0],["كَأَنَّ أَسَاطِيلَ البِحَارِ وَقَدْ مَشَتْ","بِهِ جَزِعَاتٌ وَالخِضَّمَّ مَهُولُ",12,"ل",1,0],["كان اسمه ((يحيى)) وكان يوافي","بيتا ، من الميعاد والأحلاف",13,"ف",1,1],["كان اسمه ذا الاسم أو","في العرب والعجم ابتدانا",14,"ن",2,0],["كانَ إِسلامهُ عَلى الشركِ خفضاً","وَبهِ صارَ للهدى اِستعلاءُ",15,"ا",2,0],["كأنّ اسمه رمزٌ لسرِّ قضاؤه","عجيبٌ ولكن عزمُه منه أعجب",16,"ب",1,0],["كَأنَّ أسْنَى اللآلي في تَرَائِبِهَا","مِمّا تَلأَلأَ حُسْناً وَهْيَ مِعْطَالُ",17,"ل",1,0],["كأَنَّ اِسودادَ الخال في صَحن خدِّها","له حبُّها من حبَّة القلب صائغُ",18,"غ",1,0],["كأن أسمره لقمان حين بدا","يبري القلوب إذا أخفت بها المرضا",19,"ض",2,0],["كأنا سهامٌ في صدور تنائف","تفوّقنا مثلَ الحنايا من الضَّمر",20,"ر",1,0],["كانا سبباً للدمعِ عَقَي","بَ نوى الأحبابِ وللسَّهرِ",21,"ر",1,0],["كَأُنَاسٍ يُوَشَّحُنَ المَنَادِيْلَ","إِذَا أُخْرِجُوا مِنَ الحَمَّامِ",22,"م",1,0],["كأنّ اسْتهُ إذا أخطاتْه رماحُنا","وفاتَ البُريتُ لبْدُه يتصبَّبُ",23,"ب",1,0],["كأناسٍ يُوَشَّحون منادي","ل إذا أخرجوا من الحمام",24,"م",1,0],["كأن أسيافَهم تحتَ العجاج أَضَتْ","بروقَ نبسان تحت المزْن والظلم",25,"م",1,0],["كَأنَّ أسْيَافَهُ فِي النقع إذْ لَمَعَتْ","أشِعَّةُ البَرْقِ فِي أكْنَافِ وَطْفَاءِ",26,"ا",2,0],["كأنّ أسهم عينيها سهام أبي الط","طيب المليك غداةَ الروعِ والرهجِ",27,"ج",1,0],["كأن أسماعنا لما أصخن لها","عجباً أتيح لها من حليها شنف",28,"ف",1,0],["كانَ إِسمَهُ يَنبي عَلَيهِ فَإِنَّما","هُوَ في الأَعالي غالِبٌ يَتَمتَّعُ",29,"ع",1,0],["كان اسمُها نَسُوسُ لا","كِن قُرِئَت مُنَكَّسه",30,"س",2,0],["كأن أَسنة الأنصار أَيك","محمد ليثها وَهيَ العَرين",31,"ن",1,0],["كأن أسيافه إذ تستحل دما","صفائح البرق حلت عقدة المزن",32,"ن",1,0],["كأنَّ إسْرافيلَ قد وكَّلَه","لِيبْعثَ الأرْواحَ من فَرْطِ النَّشاطْ",33,"ط",1,0],["كأنَّ أسنّةً ذُلقتْ فلمّا","تلمَّظ كلُّ مُلتهبٍ هُذامِ",34,"م",1,0],["كأنّ اسوداد الافق بالليل ثاكلٌ","تسربل للاحداد ثوباً مسوّدا",35,"د",2,1],["كَأن اسودادَ الشعر قَد شَبَّ جَمرُه","لَدى زَفرةٍ مِن وَجدِ حَيرانَ ذائب",36,"ب",1,0],["كَأَنّا سَقانا بِنُعْماهُ أَوْ","حَمانا بِظِلِّ عُلاهُ الْعَمِيدُ",37,"د",1,0],["كأن أسيافه إذ تستهل دماً","صفائح البرق حلت عقدة المزن",38,"ن",1,0],["كان أسيافه نار وهامهم","قوم عكوف على الدين المجوسيّ",39,"ي",1,0],["كأنا سألناه مزيداً لما شدا","به فهو من إلحاحنا يتبرم",40,"م",1,0],["كَأَنَّ أَسِنَّةَ الخَطِّي","يِ تَخطِرُ بَينَهُم شُهُبُ",41,"ب",1,0],["كانَ اسمُهَا (يَرْنَا) وكُنتُ أقُولُ: يا","يَرْنَا أُحِبُّكِ, والمَحَبَّةُ مَبدَأُ",42,"ا",1,0],["كأنَّ أسئلتي أنواءُ زوبعةٍ","إعصارُها ألمٌ في القلب تحشُدُه",43,"د",2,0],["كان استرحت ولأحصل عندي أضرار","ولاشفت ماشفته على أقل تقدير",44,"ر",1,0],["كأنَّا سُقينا الهونَ والجبنَ والخنا","على نومةِ المحتلِّ نمضي وكمْ نغدو",45,"د",2,0],["كأنّ أسواراً بَنَتْ بيننا","في هذهِ اللحظةِ أيدي القدَرْ",46,"ر",1,0],["كان استثارت على الفتنه زوابعهم","إلين تقلع مداها جوف الأهوالي",47,"ل",2,0],["-كَأَنَّ أَسْهُمَ عَيْنَيْها سِهامُ أَبِي ال","طِّيبِ المَلِيكِ غَداةَ الرَّوْعِ وَالرَّهَجِ",48,"ج",1,0],["كأن اسمها رسل المنون لنا","يا قوم فاعتبروا فيها بمن هلكوا",49,"ك",3,0],["كأن أسيافهم في كل معمعة","جسر الى جنة الفردوس قد نصبا",50,"ب",2,0],["كانَ أسرِي بعشقِهِ","كنتُ غِرًّا مُخَدَّرا",51,"ر",2,0],["كأناسٍ توسَّخُوا بالمنادي","لِ وقد أخرجوا من الحمّامِ",52,"م",1,0]]}