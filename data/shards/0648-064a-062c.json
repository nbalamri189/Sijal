t/poem34151.html","الرمل"],[403,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[413,"تلفت في منازل آل مي","https://www.aldiwan.net/poem53835.html","الوافر"],[418,"متى يا عريب الحي عيني تراكم","https://www.aldiwan.net/poem46394.html","الطويل"],[429,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[434,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[436,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[436,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[436,"تخيرت فاستمسكت بالعروة الوثقى","https://www.aldiwan.net/poem34892.html","الطويل"],[438,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[438,"ألا إن آلات المداد فتسعة","https://www.aldiwan.net/poem14418.html","الطويل"],[438,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[438,"أيا قاطع الحبل الذي إن قطعته","https://www.aldiwan.net/poem14468.html","الطويل"],[447,"الجمال اليعربي","https://www.aldiwan.net/poem1001.html",""],[451,"يا سلم خير أن نراك مزعزعا","https://www.aldiwan.net/poem61230.html","الكامل"],[451,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[456,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[459,"مدحتكم والمادحون بني العلى","https://www.aldiwan.net/poem15401.html","الطويل"],[459,"سل الحي عني هل غشيت لغيره","https://www.aldiwan.net/poem15481.html","الطويل"],[459,"دعوت الذي أرسى ثيرا بحوله","https://www.aldiwan.net/poem15631.html","الطويل"],[459,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[459,"تحوي القلوب له مكاسر لطفه","https://www.aldiwan.net/poem16147.html","الكامل"],[462,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[462,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[462,"هذا العقيق تلك أعلام الحمى","https://www.aldiwan.net/poem3211.html","عموديه"],[462,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[466,"وذي حلة من نسيج الزمان","https://www.aldiwan.net/poem60014.html","الكامل"],[468,"ومولى سخيف الرأي رخو تزيده","https://www.aldiwan.net/poem4805.html","الطويل"],[480,"ماذا على من غزلته سكينة","https://www.aldiwan.net/poem24465.html","عموديه"],[480,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[491,"جيش يفوت الطرف حتى لا يرى","https://www.aldiwan.net/poem67282.html","عموديه"],[498,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[503,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[504,"عجبت للمرء في دنياه تطمعه","https://www.aldiwan.net/poem2419.html","البسيط"],[527,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[549,"ولما تعانقنا ولم يك بيننا","https://www.aldiwan.net/poem47150.html","الطويل"],[549,"لو أنصف القلب لما ودكم","https://www.aldiwan.net/poem47399.html","السريع"],[556,"نظرت إلى وجه الذي الكل هالك","https://www.aldiwan.net/poem33855.html","الطويل"],[557,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[560,"ضاق الرثاء بنا من فرط ما اتسعا","https://www.aldiwan.net/poem52762.html","البسيط"],[565,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أرى واحدا في الحسن ثاني عطفه","https://www.aldiwan.net/poem3050.html","الطويل"],[573,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[573,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"]],"verses":[["وَيَجلو لَنا لَمعَ الغَمامِ وَبِشرَهُ","وَأَينَ لَنا مِنهُ بِجَودِ الغَمائِمِ",0,"م",1,0],["وَيُجيبُ الطالِبَ المُثري وَقَد","يُدرِكُ الشَأوَ أَخو العَجزِ الهَرِم",1,"م",1,0],["وَيُجَبِّنُ الشُجعانَ دونَ لِقائِهِ","يَومَ الوَغى وَيُشَجِّعُ السُؤالا",2,"ل",2,0],["وَيَجمَعُ قَلباً جَريئاً وَوَجهاً","أَتَمُّ مِنَ البَدرِ نوراً وَأَملا",3,"ل",2,0],["وَيُجري لَنا عَذباً نَميراً وَبَعضُهُم","إِذا قالَ أَجرى لِلمَسامِعِ آلا",4,"ل",2,0],["وَيُجيرُ مِن عَوراءِ هَمِّكَ سابِحٌ","أَو صارِمٌ أَو ذابِلٌ أَو مِقوَلُ",5,"ل",1,0],["وَيَجري عَلى مَن ماتَ دَمعي وَما لَهُ","بَكَيتُ وَلَكِنّي بَكَيتُ عَلى نَفسي",6,"س",2,0],["وَيَجودُ عَنكَ بِنَفسِهِ","وَالحَربُ تَقرَعُها الحِرابُ",7,"ب",1,0],["وَيَجتَنِبونَ النَّارَ خَوفاً مِنَ الرَدَى","وَلا يَحسبونَ العارَ ضَربَةَ لازِمِ",8,"م",1,0],["ويَجْمَحُ بي إِلى العَلَمَيْنِ شَوْقٌ","أفُضُّ لهُ اللِّجامَ منَ المِراحِ",9,"ح",1,0],["ويَجوبُ أرديَةَ العَجاجِ بجَحْفَلٍ","لَجِبٍ تئِنُّ لهُ الرُّبا جَرّارِ",10,"ر",1,0],["وَيَجْذُبُ الْجُنْدَ إِلَى نَفْسِهِ","بِخَادِعِ الْقَوْلِ وَخَلاَّبِهِ",11,"ب",2,0],["وَيُجبى إِلَيهِ السَيلَحونَ وَدونَها","صَريفونَ في أَنهارِها وَالخَوَرنَقُ",12,"ق",1,0],["ويجر الدجى ذوابل شمع","عكست في الزجاج نور الذبال",13,"ل",1,0],["وَيَجعَلنَ الخَلاخِلَ حينَ تُلوى","بِأَسؤقِهِنَّ في قَصَبٍ خِدالِ",14,"ل",1,0],["وَيَجْمَعُ البِرُّ حُفَّاظَ المَآثِرِ مِنْ","شَتَّى العَشَائِرِ حَوْلَ الوَالِدِ الحَدِبِ",15,"ب",1,0],["ويَجُولُ بَيْنَ السُّحْبِ جَوْلَةَ مُمْعِنٍ","فِي الفَتْحِ لا يَثْنِيهِ عَنْهُ ثَانِ",16,"ن",1,0],["وَيُجَدِّدُ الحُزْنَ الْعَتِيدَ عَلَى أَخٍ","حُزْنِي عَلَى المَاضِينَ مِنْ إِخْوَانِي",17,"ن",2,0],["ويجد روح معيتب","حين يطول عنّه غياب",18,"ب",1,0],["ويجري النسيم الرطب فيها كأنه","تبختر بيضاء الترائب معطار",19,"ر",1,0],["ويُجيد تقطير العواطف للورى","فتخاله لقلوبهم أنبيقا",20,"ق",2,0],["ويجمعهم وأياك انتساب","إلى مَنُ خصّ منطقهم بضاد",21,"د",1,0],["ويجتنب المرء العيوبَ لأنّها","لدى عائبيه لا لديه عيوب",22,"ب",1,0],["وَيَجزُزنَ النَّوَاصِي مُنعمَات","غَوَانيَ عن ثَوَابٍ المُعرضِينَا",23,"ن",2,0],["وَيَجيءُ طَوراً ضُرُّهُ في نَفعِهِ","جَهلاً وَطَوراً نَفعُهُ في ضُرِّهِ",24,"ر",2,0],["وَيَجمَعُنا في وائِلٍ عَشَرِيَّةٌ","وَوِدٌّ وَأَرحامٌ هُناكَ شَواجِرُ",25,"ر",1,0],["ويجتلَى من سجاياه التي اشْتهرت","للضدِّ هلكٌ وللمعتزِّ منجاة",26,"ه",1,0],["ويجري بأمرِ الملك سودَ يراعهِ","فيا حبَّذا ساداتنا وعبيده",27,"د",2,0],["ويجري بإسعاد العباد فحبذا","بسعدك يا سلطانها ساعياً يجري",28,"ر",2,0],["ويجلب الصبح لي ممَّا أساء به","بياض شعر فيا فرقي ويا فَرقي",29,"ي",1,0],["ويجمع بالثنا والأجر دنيا","وآخرة فيرضي الضرَّتين",30,"ن",1,0],["ويُجيلُ في الخَطْب الذي","تُضحي شواكِلُهُ تَشَابهْ",31,"ب",2,0],["ويجم عنها تارةً فكأنه","حتى أكون شريكه متنغِّصُ",32,"ص",1,0],["ويجْنينَ نُوَّار الأقاحي تعالياً","عن الجانيات الكمْءَ بين القصائص",33,"ص",1,0],["ويجسُمُ قَدْرُهُ ويزيدُ نُبلاً","بأقدارٍ لكم فيه جِسامِ",34,"م",1,0],["ويُجيزُ جَوْرَ قَضائه","أَهلُ المكارم حين يَحْكُمْ",35,"م",1,0],["ويجوز الخريفُ وهو ربيعٌ","وتَسورُ المياهُ في العيدان",36,"ن",1,0],["وَيَجتَمِعُ النَملُ في قَريَتِه","إِذا خَشِيَ الغَدرَ مِن جارِهِ",37,"ه",1,0],["وَيُجَشِّمُ النَفسَ المَخاطِرَ هادِئً","كَيلا تُلِمَّ بِقَومِهِ الأَخطارُ",38,"ر",1,0],["وَيَجعَلُ الحُبَّ دينَ القانِطينَ بِها","دينٌ يُقَرِّبُ بَينَ البَيتِ وَالقُدُسِ",39,"س",1,0],["ويُجري عليها الهَوَى في حُنُوٍّ","أَناملَ لُدْناً كرَطْبِ الزَّهَرْ",40,"ر",1,0],["ويجحد هذا الامر من هو لم يزل","اليك قريباً في الغباوة والحقد",41,"د",1,0],["ويجمعهم والشر طبع وإنما","قلوبهمُ في غير ذلك أشتات",42,"ت",1,0],["ويجعل الخير فيه","عمرا ودنيا ودينا",43,"ن",2,0],["ويجل قدر قلادة في صدره","وله القلائد سمطها الإلهام",44,"م",1,0],["وَيَجمَعُ قَومَكَ بِالمُسلِمينَ","عَظيمَ الفُروضِ وَسَمحُ السُنَن",45,"ن",1,0],["وَيَجلِسونَ إِلى عِلمٍ وَمَعرِفَةٍ","فَلا يُدانَونَ في عَقلٍ وَلا فَهَمِ",46,"م",1,0],["وَيَجمَعُ الآيَ تَرتيباً وَيَنظُمُها","عِقداً بِجيدِ اللَيالي غَيرَ مُنفَصِمِ",46,"م",1,0],["وَيَجمَعُنا إِذا اختَلَفَت بِلادٌ","بَيانٌ غَيرُ مُختَلِفٍ وَنُطقُ",47,"ق",1,0],["وَيَجولُ في زُهرِ الرِياضِ كَأَنَّهُ","صَيبُ الرَبيعِ مَشى بِهِنَّ وَجالا",48,"ل",2,0],["وَيَجعَلُ ميقاتاً لَها تَنبَري لَهُ","كَما دارَ يَلقى عَقرَبَ السَيرِ عَقرَبُ",49,"ب",1,0],["وَيَجهَلُ أَنّي مالِكَ الأَرضِ مُعسِرٌ","وَأَنّي عَلى ظَهرِ السَماكَينِ راجِلُ",50,"ل",1,0],["وَيَجعَلُ ما خُوِّلتُهُ مِن نَوالِهِ","جَزاءً لِما خُوِّلتُهُ مِن كَلامِهِ",51,"م",2,0],["ويجعل باطنها ظاهرا","ويبرز من سرها ما اكتتم",52,"م",1,0],["وَيُجَمِّرونَ بِغَيرِ أَعطِيَةٍ","في البَرِّ مَن بَعَثوا وَفي البَحرِ",53,"ر",1,0],["ويجعلُ بِشرَه يَذِرُ الأعادي","فيبعَثُه جَنوباً أو شَمالا",54,"ل",2,0],["وَيَجهَدُ الناسُ في الدُنيا مُنافَسَةً","وَلَيسَ لِلناسِ شَيءٌ غَيرَ ما رُزِقوا",55,"ق",3,0],["وَيُجريها مِنَ الشِعبَينِ قُبّاً","إِلى الهَيجاءِ تَسعى كَالسَعالي",56,"ي",1,0],["ويجلو لي النجوم فأزدريها","وأغمض لا أريد سواك نجما",57,"م",2,0],["ويجري لك المعروفُ من كفّ واهبٍ","إذا جَمَدَ المعروفُ من كفّ حارمِ",58,"م",1,0],["وَيجعَلُ النائِلَ أَدنى سُبلِهِ","وَبَلَدٍ نائي المَحَلِّ مَحلِهِ",59,"ل",2,0],["وَيَجزيكَ بِالحُسنى إِذا كُنتَ مُحسِناً","وَيَغتَفِرُ العُظمى إِذا النَعلُ زَلَّتِ",60,"ت",1,0],["وَيُجمَلُ في حُباهُ طَودُ حِلمٍ","تُعَدُّ خِلالَهُ رَملَ الكَثيبِ",61,"ب",1,0],["وَيُجتَنى نورُ نَسيبي بِهِ","غَضّاً وَجِسمي غُصناً ذابِلا",62,"ل",2,0],["ويَجتنبُ المناهِلَ مُتْرعاتٍ","تَطيبُ نِطافُها للنّاهلينا",63,"ن",2,0],["وَيَجودُ في الأَزَماتِ تَحُزبُهم بِما","يَبتَزُّ مِن مالِ الغُواةِ وَيَسلِبُ",64,"ب",1,0],["وَيَجلِبُ الصافِناتِ الجُردِ يُطرِبُهُ","صَهيلُها وَيُعدُّ الجَحفَلَ اللَجِبا",65,"ب",2,0],["وَيَجتَلي غُرَّةَ مَجهولِها","بِالرَأيِ مِنهُ قَبلَ إِنجامِها",66,"م",3,0],["وَيَجرَحُ أَحشائي بِعَينٍ مَريضَةٍ","كَما لانَ مَتنُ السَيفِ وَالسَيفُ قاطِعُ",67,"ع",1,0],["وَيَجيشُ نارُ الحَربِ تَحتَ عُقابِها","وَالمَوتُ في صَرفي الفَوارِسِ جَمرُهُ",68,"ر",2,0],["وَيَجعَلُ هاماتِ أَعدائِهِ","قَلانِسَ يُلبِسُهُنَّ الرِماحا",69,"ح",2,0],["وَيَجُرُّني بِالمَطلِ مَوعِدُ حاجَةٍ","لَو شِئتُ قَد بَرَدَ الغَليلُ بِطيبِها",70,"ب",3,0],["ويَجْمَعُ مِنْ أَشْلائِهِمْ مُتَفَرِّقاً","بِصارِمهِ جَمْعَ الهَشِيم حَظيرُ",71,"ر",1,0],["وَيَجْمَعُ شرَّ الماءِ والنارِ سيْفُهُ","وَفي العُودِ سِرُّ النارِ والعُودُ أَخْضَرُ",72,"ر",1,0],["ويُجْرِي عَلَى وَفْقٍ المُرَادِ أُمُورَهُ","فَيَبْسُطُ فيها ما يشاء وَيَقْدُرُ",72,"ر",1,0],["ويَجِلُّ عنها قَدرُهُ حتى إذا","راقَتْهُ كانَتْ نائِلاً مبذولا",73,"ل",2,0],["وَيَجري قَضاءٌ ما لَكُم عَنهُ حاجِزٌ","فَأَلقوا إِلى مَولاكُمُ بِالمَقالِدِ",74,"د",1,0],["وَيَجهَلُ حَتّى يَسأَلَ الفَلَكَ الَّذي","يَدورُ عَلَيهِ كَيفَ بَدءُ مَدارِهِ",75,"ر",2,0],["وَيَجمَعُ مِنِّيَ الشَفَتَينِ صَمتي","وَأَبخَلُ في المَحافِلِ بِاِفتِراري",76,"ر",2,0],["وَيَجمَعُنا مِن صَنعَةِ الرَبِّ أَربَعٌ","وَمِن فَوقِها وَالمُلكُ لِلَّهِ خامِسُ",77,"س",1,0],["وَيَجري سابِحي وَلَهُ عُيوبٌ","وَيَقطَعُ صارِمٌ وَبِهِ اِنثِلامُ",78,"م",1,0],["ويَجْشِمُ فيه السِّيدُ رُعْباً فكُلما","أضاءتْ لعينيه القَواضِبُ سارا",79,"ر",2,0],["وَيجعل القبر يوماً","بيني وبينك سدا",80,"د",2,0],["وَيَجوز أجوازاً لَها","متعسفاً فَيَكاد يَردى",81,"د",2,0],["ويجوبُ الحياة في كل آنٍ","هاتفٌ منكمو وطيفٌ تأوَّبْ",82,"ب",1,0],["ويَجْلُو العَمَى عنَّا بأَنْوارِ رأيهِ","إِذا أَظْلَمَت ظَلْمَاءُ ذات غُيومِ",83,"م",1,0],["ويجْلِبُ لِي فَهْمِي ضُرُوباً مِن الأَذَى","وأَشقَى امْرِئٍ في قَرْيةِ الجهْلِ عالِمُ",84,"م",1,0],["وَيَجْزَعُ قَلْبِي لِلصُّدودِ وَإِنَّنِي","لَدَى الْبَأْسِ إِنْ طَاشَ الْكَمِيُّ صَبُورُ",85,"ر",1,0],["ويُجِدْنَهَا فَلَوِ الشَِّفَاهَ تَعَفَّفَتْ","عَنْ أَكْلِهَا لَضَمِنْتُهَا لخُلُودِ",86,"د",1,0],["وَيَجُوزُ مَا فَرَضَتْ عَلَيْهِ نَفْسُهُ","مِنْ نَجْدَةٍ وَنَدّى إِلى الأَنْفَالِ",87,"ل",1,0],["وَيُجْهِدُ ذِهْنِي شَاغِلٌ بَعْدَ شَاغِلٍ","فَمِنْ أَيِّ رُوحٍ تُسْمَتَدُّ القَصَائِدُ",88,"د",1,0],["وَيَجْعَلُ الخُلْفَ بِمَا فِي وُسْعِه","زِيَادَةً فِي الإِلْفِ وَالوِدَادِ",89,"د",1,0],["وَيَجْتَلِي حُسْنَ السُّهَى","إِنْ فَاتَهُ حُسْنُ القَمَرْ",90,"ر",1,0],["وَيَجْبها رَأْيٌ يُزلُ عَدَاهَا","رُبَّ رَأْيٍ أَغْزَى منَ الأجْناد",91,"د",1,0],["وَيَجِلُّ عَنْ نَفْعِ الشُّجَاعِ بِلادَهُ","مَا قَدْ يُفِيدُ بِلاَدَهُ المُتَبَرِّعُ",92,"ع",1,0],["وَيَجِيئُنِي إِرْهَافُ حَافِظَتِي","فِي منْتَهَى عَامِي بِأَمْدَادِ",93,"د",1,0],["ويجوبُ البحرَ من لم يَرَهُ","غيرَ طْيف من خَيالٍ في كراء",94,"ا",2,0],["ويجثو الصباح مليا يرش","شبابيكها ، بأرقّ التحايا",95,"ا",3,0],["ويجلو العمى عنا بأنوار رأيه","إذا أظلمت ظلماء ذات عموم",96,"م",1,0],["ويجتَثُّ إقطاعاً أقَرَّتْ جُذُورَهُ","سياسةُ تفريقٍ وحَوْزُ مغانم",97,"م",1,0],["ويجمعُ بينَ ظِلالِ القصورِ","وعَصْرِ الخمورِ ورشْفِ اللَّمى",98,"ا",1,0],["ويُجَنِّبونَ الكلب وَخزةَ واخزٍ","ويجَهِّزُونَ على الجُموعِ معاطِبا",99,"ب",2,0],["ويجعل الحبّ دين القاطنين بها","دين يقرّب بين \" البنت \" والقدس",100,"س",1,0],["ويجمَعُ قومك بالمسلمين","عظيمُ الفروضِ وسمحُ السن",101,"ن",1,0],["ويجبى إليها خمرُها من مشارقٍ","يجادُ بها تقطيرُها وَمغارب",102,"ب",1,0],["وَيُجرد الأَرواح مِن أَجسادِها","فَكَأَنَّما الآجال طَوع يَمينِهِ",103,"ن",2,0],["وَيجتَني ثمر الاقبال مجتَلياً","كأس المسرة فَلَيهنأ بمشربه",104,"ب",2,0],["ويجل الانذال خبثا واذلا","ل اولى المجد دينه اذ يترجم",105,"م",1,0],["ويجمع منا الشعب شملا مفرقا","لما كان قبل اليوم يجمعنا الشعب",106,"ب",1,0],["ويُجِيبُ مِنْ خَلْفِ الضُّلُوعِ كأنَّهُ","في الأَسْرِ يَبكي مِن قيودِ الآسِرِ",107,"ر",1,0],["ويجسدها من أجله كلُّ موضع","من الأرضِ من سهلٍ سواها وأجْبُلِ",108,"ل",1,0],["ويجمعُ مالَه للبذْل جُوداً","وتفريقاً على الأصحاب جَمْعا",109,"ع",2,0],["وَيَجذِبُ قَدُّه الرُّمحِىُّ حِقفاً","إِذَا قَصَدَ القِيامَ بِه تَوَانَى",110,"ن",2,0],["ويَجرِيَ علَى مُقتضى جَريِهِ","فَفِي جَرِيهِ مُقتَضَى المُقتَضَى",111,"ض",2,0],["ويجرحن قلبي بالظبا وهي أعين","ويقتلنَ بالمرّانِ وهي من القدِ",112,"د",1,0],["ويجيء في تفسيره بعجائب","ويذيع من مكنونه الأسرارا",113,"ر",2,0],["ويجادل الأشرار بالحسنى فلا","ينفك حتى يصبحوا أخيارا",113,"ر",2,0],["ويجدد العربية الأولى وقد","صارت بغفلة أهلها آثارا",113,"ر",2,0],["ويجلو ظلام المشكلات إِذا دجت","بأفكارِ قلب منتجات لواقحِ",114,"ح",1,0],["وَيَجمَعُنا في الأُمَّهاتِ اِبنُ يُوسُفٍ","عَلِيٌّ وَنُعمان الأَغَرُّ الحُلاحِلُ",115,"ل",1,0],["وَيَجلِبُ الخَيلَ كَالعِقبانِ يَقدُمُها","عَلَيهِمُ القُورُ وَالغِيطانُ وَالأَكَمُ",116,"م",1,0],["ويُجمِّش الرَّيحانَ راحُ رياحِه","فيَشُوقُ منه ما يُحدِّثُنا به",117,"ب",2,0],["وَيجلبُ مِغناطيسَ إِلحادهم لهم","منَ الناسِ لعناتٍ وإن لعَنوا الغَيرا",118,"ر",2,0],["وَيَجمعهُم في الحشرِ تحت لوائهِ","وَكلٌّ يقولُ اِشفَع فأنتَ بِها أَحرى",119,"ر",2,0],["وَيجودَ لي بمروّقٍ من شربهِ","فَأظلَّ ثمَّ بمدحهِ أترنّمُ",120,"م",1,0],["وَيجعلُ التقريبَ عينَ البعدِ","وَلينفِقِ الأموالَ من حلال",121,"ل",1,0],["ويجود إذ ذاك العظيم","بحسنه بالخد والفم",122,"م",1,0],["ويُجِنُّ منه الليل ليلاً مثله","مهما جرى جنح الظلام الأسحم",123,"م",1,0],["ويجلوه لوجداني وروحي","إذا ما شئتُ إظلال السحاب",124,"ب",1,0],["ويَجْتَاحُها والكمت في الجوِّ حُوَّمٌ","وسمرُ القنا في الدّارعين قواصد",125,"د",1,0],["ويَجمع الجَدُّ منّا في مُلاءته","لَيثاً هَصوراً وظَبْياً تَمَّ واحتَشَما",126,"م",2,0],["ويجذِبُني قلبي إليك وهِمِّتي","ويعذبُ لي في حوك شعري لك الفكر",127,"ر",1,0],["ويجلس فوق الأرض لا فرش تحته","ومطعمه أيضاً على الأرض يُوضع",128,"ع",1,0],["وَيَجيءُ تابِعُهُ بِنورٍ واحِدٍ","وَلِأَحمَد الداعي إِلى الإيمانِ",129,"ن",1,0],["وَيَجيءُ قَومٌ لا أَمانَةَ عِندَهُم","مِن عُصبَةٍ ثلجِ البُطونِ سِمانِ",129,"ن",1,0],["وَيَجمَعُ الأَيّامُ مِن","شَملِ هَوىً مُفَرَّقِ",130,"ق",1,0],["وَيُجَارُ منْ جَمْعِ الْعِدَى","مَنْ يَنْتَمي مِنْهُ لِمُفْرَدْ",131,"د",1,0],["وَيَجْمَعُنَا كُلُّ عِيدْ","وَكُلُّ زَمَانٍ سَعِيدْ",132,"د",1,0],["ويُجيز الإيطاءَ في الجود لكن","شَأنُنا نحن في المديح اللزوم",133,"م",1,0],["ويجيء يوم الحشر في","عرق الّذي تعروه حُمّه",134,"م",2,0],["ويجرّرُ الأذيالَ عند خليفة","قد رصَّعَ الإكليلَ بالإكليل",135,"ل",1,0],["وَيُجِلُّ قَدْرَ الْمَدْحِ عاطِرُ مَدْحِهِ","وَيَطُولُ عَنْ حُسْنِ الثَّناءِ ثَناؤُهُ",136,"ا",3,0],["وَيَجْزِي حُسْنَ صُنْعِكَ رَبُّ فِكْرٍ","ذَكِيُّ الزَّنْدِ وَهّاجُ السِّراجِ",137,"ج",1,0],["وَيُجْدِبُ ظَنِّيَ فِيمَنْ أَوَدُّ","وَظَنِّيَ فِيكَ خَصِيبُ الْمَرادِ",138,"د",1,0],["وَيَجعَلُ النَجمَ الثُرَي","يا خاضِعاً تَحتَ الثَرى",139,"ر",2,0],["ويجمعنا الروض عند الأصيل","وفي ظل سرحته العاليه",140,"ي",2,0],["ويجري ماؤه في وجْ","هِها فيكادُ ينبجس",141,"س",1,0],["ويجعل أفضل الصلوات منا","علي خير الورى في كل حال",142,"ل",1,0],["ويجزى الناظم للإسناد","خير الجزا في الحال والمعاد",143,"د",1,0],["ويجبر الكسر فهو المرتجي والكفيل","والمحسن المنعم المفضل ومعطي الجزيل",144,"ل",1,0],["ويجمع الشمل منا حيث حضرته","بمقعد الصدق غاية قصد كل ولي",145,"ي",1,0],["وَيَجتازُ حَلقَ الوادي مُشجىً كتائباً","تَعثّرُ أنفاسُ النسيمِ به خَنطا",146,"ط",2,0],["وَيَجلو وَجهُها روضاً نضيراً","وَيَحمي الوردَ والوِرد المقرّا",147,"ر",2,0],["وَيَجلو أسعداً ما أرّخوه","لِصادقِ رعيهِ القصرُ السعيدُ",148,"د",1,0],["ويجيء بالمعنى الغريب مشاهد ال","أمر العجيب إذا أعان ذكاءُ",149,"ا",2,0],["ويجمع الشمل بين العاشقينا رضا","منه وحبّاً لمن عاشوا محبّينا",150,"ن",2,0],["ويجهش ربّانُها بالصلاة","فيغرقُها الموجُ مستهزِئا",151,"ا",2,0],["ويجرى به الفلك السرمدي","عتِيّ الألوهة في جذبه",151,"ه",1,0],["ويجمعنا بكم ألم وحقد","على قوم إذاقونا العذابا",152,"ب",2,0],["ويجف الدمع في المقل","مثل ماء المزن في القنن",153,"ن",1,0],["ويُجنَى دوحُ أنعمه رطَابا","إِذا اصفَرَّت عَلَى الغُصنِ الفُروعُ",154,"ع",1,0],["وَيُجعلَ دوني مَن يَوَدُّ لَوَ اَنَّكُم","ضِرامٌ بِكَّفي قابِسٌ يَتَلَهَّبُ",155,"ب",1,0],["ويَجْني علَيَّ بإعْراضِه","وماذا على ظالِمٍ لو عَدَل",156,"ل",1,0],["ويُجِدُّ تَشريفي الوزيرُ ويُبْصروا","تَشْنيفَه بالدُّرِّ من تَرْصيعي",157,"ي",1,0],["ويجعلُ أثمانَ المحامدِ مالَهُ","إذا ضَنَّ بالأموالِ يوماً جَموعها",158,"ع",3,0],["ويَجْمَعُ طولَ العامِ شَمْلاً لعَسْكرٍ","وتَجْعلُه في ساعةٍ مُتَبَدِدّا",159,"د",2,0],["وَيَجنُبُ ريحُ العِنانِ الدُبورَ","فَيُحدِثُ ما يَقطَعُ الدابِرا",160,"ر",2,0],["وَيَجبُرُ ناهِضُ هِمّاتِهِ","لَكَ المَجدُ ذا الزَمَنَ الفاتِرا",160,"ر",2,0],["ويُجيرُ إن قَعدَ الزَّما","نُ وأهلُه بالمستَجيرِ",161,"ر",1,0],["ويَجعلُ نصبَ العين ميقات يونُسٍ","يراقبُهُ أضعافَ شهرٍ يوافقهْ",162,"ه",1,0],["وَيَجني فَأَمحو بِاِعتِذاري ذُنوبَهُ","فَلا يَنقَضي عُذري وَلا يَنقَضي العَتَب",163,"ب",1,0],["ويجعل العمر حسن الخاتمه آخره","ولا نرى باس يوم الدين والساهره",164,"ر",2,0],["ويجمعنا والاحبا","ب في دار السلام",165,"م",1,0],["وَيُجازى كُلٌّ بِما كانَ مِنهُ","من عِقابِ التَخليدِ وَالَتنكيلِ",166,"ل",1,0],["ويجمع لي جيش المعاني فأصطفي","بذهني منها ما أشاء مغنما",167,"م",2,0],["ويجعل كل ذي علم أخاه","حبيباً لا يراه بعين قال",168,"ل",1,0],["ويجوز أن لها بتلك مداركاً","خلقت لها حقاً من الرب العلي",169,"ل",2,0],["ويجيرنا من حر نا","ر والعباد لها وَقُودُ",170,"د",1,0],["ويجوز صلح محارب في قوة","إن كان للإِسلام ضعف زائد",171,"د",1,0],["ويجاري إذ يجاريك وقد","عجز الماهر أن يلحق بك",172,"ك",1,0],["وَيَجُرُّ حينَ يُجَرُّ صَعدَةَ رُمحِهِ","في الجَحفَلِ المُتَضائِق الجِرارِ",173,"ر",1,0],["ويجمَعُنا ومن نهواه شملٌ","بحَيثُ يضمُّنا والحيّ شِعب",174,"ب",1,0],["ويجمعنا الدهر الذي حال بيننا","ويحظى بكم قلبي وعيني تراكمُ",175,"م",1,0],["ويَجْتَنِي ثمراتِ العِزِّ يانِعَةً","في مَغْرِسِ الحَرْبِ من مُنْآدةِ اللُّدُنِ",176,"ن",1,0],["ويجلب الشيب لي حزنا إلى حزن","أبيت منه على خوف وأخطار",177,"ر",1,0],["ويُجْمَعُ شملُ الوَصْلِ من فُرْقَةِ القِلى","ويُرْفَعُ بَنْدُ الوَصلِ من مَصْرَعِ النِّكْسِ",178,"س",1,0],["وَيَجِلُّ قَدْرُكَ عن وِلادَةِ يافِث","أَوْ قَيصَرٍ أَوْ عن أَرُومِ صَقالِبِ",179,"ب",1,0],["وَيَجْلُونَ عن لَيْلِ العَجاج كَأَنَّمَا","تُقَلِّبُ إِحداهُنَّ ناظِرَتَيْ زَرْقا",180,"ق",2,0],["ويجمع أهل الجنان جيمعاً","لنص الأحاديث فيها نوادي",181,"ي",1,0],["ويجعل في طاس وفي الشمس ساعة","لينحلَّ ذاكَ الماء خلطا مُنَجَّما",182,"م",2,0],["ويجمعنا بعد المقابر موقف","به سعدت قوم وقوم به شقوا",183,"ق",3,0],["ويجمعنا يوم أخو الصدق فائز","به وأخو التمويه يلقى المهالكا",184,"ك",2,0],["ويجمع بيننا شعر وحسن","كلانا من معادنه ثري",185,"ي",1,0],["ويجيء يوم للحياة مقدّس","فتكون معبود الحياة المعلنا",186,"ن",2,0],["ويجعلوا الدين معنى لا يلوّنه","إفك السياسة أو تسميم ثعبان",187,"ن",1,0],["ويجبُنُ السيفُ فتس","تلُّ اليراعَ البطَلا",188,"ل",2,0],["ويجتمعون على زعمهم","وينبيك سعدٌ بما أَشكلا",189,"ل",2,0],["ويجدِب المرءُ على","أذيالِ عامٍ ممرِعِ",190,"ع",1,0],["ويجذِبُ من يد الزمن المُعاصي","بأضباعِي إلى الزمن المُواتِي",191,"ي",1,0],["ويجلو ظَلام الخطب ثاقبُ رأيهِ","وقد أحجمت عنه الظبُّي والذوابل",192,"ل",1,0],["ويجمعُ ضدَّيْ هيبةٍ ودُعابةٍ","ويقرنُ ما بن اللَّطافةِ والجِدِّ",193,"د",1,0],["ويجلو دُجى الظلمات من كل حادث","بواضحِ أمرٍ مثلِ وجهكَ أبْلجِ",194,"ج",1,0],["ويجولُ طِرفُك في مشارق شمسها","والغربُ يُنْغِض عِطفه الخُيلاء",195,"ا",2,0],["ويجيش بحرُ خواطري في مدحه","فأُجيدُ إذْ بحر الخواطِر جدول",196,"ل",1,0],["ويجذبني شوقي إلى المجد نحوهُ","وفي المجد مصقولُ الترائبِ أدعج",197,"ج",1,0],["ويجلُّ عن كذبِ البروق فلا يرى","في خلبِ الأزمانِ إلاَّ ممطرا",198,"ر",2,0],["ويجول في حيث الرماح شوابك","وإذا تأخرت الكماة تقدما",199,"م",2,0],["ويجرُّ الأرزاق أو يرفع الأقدار","منّا أو ينصب الأعلاما",200,"م",2,0],["وَيَجلو عَلى أَهلِهِ نَفسَهُ","بِتاجِ عَقيقٍ عَلَيهِ يُرى",201,"ر",2,0],["وَيَجهَلُ أَحياناً فَلا يَستَخِفُّني","وَلا أَجهَلُ العُتبى إِذا راجَعَ الحِلما",202,"م",2,0],["ويجر من زهو يبسط شعاعها","أذيال فخر في الهوى إجلالا",203,"ل",2,0],["ويجعل لي من كل خطب ألم بي","أنادي أيا قهار أوصل حباليا",204,"ي",2,0],["ويجيش حتى لا يظن عديده","أحد لكثرة جمعه معدودا",205,"د",2,0],["ويَجولُ منها للطَّريقَةِ في الوَرَى","منهُ هِزَبْرٌ وجهُهُ لا يُخْذَلُ",206,"ل",1,0],["ويجثم فوق ما علّوا","عمىً ينفثُ نِسْيانا",207,"ن",2,0],["ويجمع المالَ حِرصاً لا يفارقه","وقد درى أنه للغَير يجمعه",208,"ع",2,0],["ويَجُولُ في الأَصْلَيْنِ جَوْلَةَ ماهِرٍ","لا مِثْلَ مَنْ قَدْ جالَ وَهْوَ مُكَبّلُ",209,"ل",1,0],["وَيَجني على مَنْ شئتِ منكِ غِرارُهُ","وأمّا عليكِ ساعةً فهو لا يَجني",210,"ن",2,0],["ويجحدُ المرَّ الّذي ذُقتُه","في حبّه وهو به أعرفُ",211,"ف",1,0],["ويجزيه عنا ربه سوء حالة","هنا وله يوم الحساب جهنم",212,"م",1,0],["ويجْعلُ سُفليها ويوهِمُ أنَّه","لِسُفْلِيِّه المجعول بالذَّاتِ أهبِطْنا",213,"ن",2,0],["ويَجمعُ المالَ من بالكدِّ حصلَّهُ","دهراً ويُنفِقُهُ غيرُ الذي جَمَعا",214,"ع",2,0],["وَيَجْرِي بِذَكِيِّ العَرْ","فِ مَجْرَى الأَمْنِ فِي الذُّعْرِ",215,"ر",1,0],["ويجعل الأمر على ما دبروا","في رجل منهم إذا تخيروا",216,"ر",3,0],["ويَجْحَدُ ضعَف الجفنِ منه تدللاً","وكَسرةُ ذاك الجفن عُنوانُ ضَعْفِه",217,"ف",2,0],["ويَجْلو له البدرُ المنيرُ مَسالِكاً","فيسهلُ مِنها كلُّ مُستوعَرٍ صَعْب",218,"ب",1,0],["ويَجتلي الخلقُ من راياتهِ أَبداً","مبيضةَ النَّصرِ من مصفَّرة العَذَب",219,"ب",1,0]]}