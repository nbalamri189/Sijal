751.html","الكامل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"قفا تريا ودقي فهاتا المخايل","https://www.aldiwan.net/poem9986.html","الطويل"],[43,"أيا راميا يصمي فؤاد مرامه","https://www.aldiwan.net/poem10526.html","الطويل"],[62,"بنزع الرطوبة من جسمها","https://www.aldiwan.net/poem52225.html","المتقارب"],[28,"تمسي الرياح بها وقد لغبت","https://www.aldiwan.net/poem5127.html","الكامل"],[61,"أهجرا كان صدك أم ملالا","https://www.aldiwan.net/poem51492.html","الوافر"],[49,"الرفق يبلغ ما لا يبلغ الخرق","https://www.aldiwan.net/poem62187.html","الكامل"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[97,"لعينيك احتملنا ما احتملنا","https://www.aldiwan.net/poem24770.html","الوافر"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[44,"وعاذل عذلته في عذله","https://www.aldiwan.net/poem29687.html","الرجز"],[44,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[74,"وعاذر قد كان لي عاذلا","https://www.aldiwan.net/poem13215.html","السريع"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"ولقد عجبت من الغواة وقولهم","https://www.aldiwan.net/poem43117.html","الكامل"],[105,"يا دولة من بقايا الظلم طاف بها","https://www.aldiwan.net/poem43379.html","البسيط"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[52,"عليم بما تحت الصدور من الهوى","https://www.aldiwan.net/poem26863.html","الطويل"],[52,"طال الفراق فبان عنه صبره","https://www.aldiwan.net/poem27016.html","الكامل"],[52,"لقد شد ملك بني هاشم","https://www.aldiwan.net/poem27156.html","المتقارب"],[52,"سقيا لمنزلة الحمى وكثيبها","https://www.aldiwan.net/poem27267.html","الكامل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[46,"يكون الذي سمى من القوم خالدا","https://www.aldiwan.net/poem22449.html","الطويل"],[46,"يقول لك العقل الذي بين الهدى","https://www.aldiwan.net/poem22656.html","الطويل"],[46,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[46,"نراقب ضوء الفجر والليل دامس","https://www.aldiwan.net/poem22783.html","الطويل"],[46,"إذا لؤم الفتى لم يخشى مما","https://www.aldiwan.net/poem23313.html","الوافر"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30489","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30495","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42601","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[84,"أفي كل عام مصرع لعظيم","https://www.poetsgate.com/ViewPoem.aspx?id=26353",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[91,"سبيل التوحيد","https://www.poetsgate.com/ViewPoem.aspx?id=53118",""],[85,"مضى الدهر بابن إمام اليَمَنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9632&r=&rc=122",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""]],"verses":[["وَيَجلو لَنا لَمعَ الغَمامِ وَبِشرَهُ","وَأَينَ لَنا مِنهُ بِجَودِ الغَمائِمِ",0,"م",1,0],["وَيُجيبُ الطالِبَ المُثري وَقَد","يُدرِكُ الشَأوَ أَخو العَجزِ الهَرِم",1,"م",1,0],["وَيُجَبِّنُ الشُجعانَ دونَ لِقائِهِ","يَومَ الوَغى وَيُشَجِّعُ السُؤالا",2,"ل",2,0],["وَيَجمَعُ قَلباً جَريئاً وَوَجهاً","أَتَمُّ مِنَ البَدرِ نوراً وَأَملا",3,"ل",2,0],["وَيُجري لَنا عَذباً نَميراً وَبَعضُهُم","إِذا قالَ أَجرى لِلمَسامِعِ آلا",4,"ل",2,0],["وَيُجيرُ مِن عَوراءِ هَمِّكَ سابِحٌ","أَو صارِمٌ أَو ذابِلٌ أَو مِقوَلُ",5,"ل",1,0],["وَيَجري عَلى مَن ماتَ دَمعي وَما لَهُ","بَكَيتُ وَلَكِنّي بَكَيتُ عَلى نَفسي",6,"س",2,0],["وَيَجودُ عَنكَ بِنَفسِهِ","وَالحَربُ تَقرَعُها الحِرابُ",7,"ب",1,0],["وَيَجتَنِبونَ النَّارَ خَوفاً مِنَ الرَدَى","وَلا يَحسبونَ العارَ ضَربَةَ لازِمِ",8,"م",1,0],["ويَجْمَحُ بي إِلى العَلَمَيْنِ شَوْقٌ","أفُضُّ لهُ اللِّجامَ منَ المِراحِ",9,"ح",1,0],["ويَجوبُ أرديَةَ العَجاجِ بجَحْفَلٍ","لَجِبٍ تئِنُّ لهُ الرُّبا جَرّارِ",10,"ر",1,0],["وَيَجْذُبُ الْجُنْدَ إِلَى نَفْسِهِ","بِخَادِعِ الْقَوْلِ وَخَلاَّبِهِ",11,"ب",2,0],["وَيُجبى إِلَيهِ السَيلَحونَ وَدونَها","صَريفونَ في أَنهارِها وَالخَوَرنَقُ",12,"ق",1,0],["ويجر الدجى ذوابل شمع","عكست في الزجاج نور الذبال",13,"ل",1,0],["وَيَجعَلنَ الخَلاخِلَ حينَ تُلوى","بِأَسؤقِهِنَّ في قَصَبٍ خِدالِ",14,"ل",1,0],["وَيَجْمَعُ البِرُّ حُفَّاظَ المَآثِرِ مِنْ","شَتَّى العَشَائِرِ حَوْلَ الوَالِدِ الحَدِبِ",15,"ب",1,0],["ويَجُولُ بَيْنَ السُّحْبِ جَوْلَةَ مُمْعِنٍ","فِي الفَتْحِ لا يَثْنِيهِ عَنْهُ ثَانِ",16,"ن",1,0],["وَيُجَدِّدُ الحُزْنَ الْعَتِيدَ عَلَى أَخٍ","حُزْنِي عَلَى المَاضِينَ مِنْ إِخْوَانِي",17,"ن",2,0],["ويجد روح معيتب","حين يطول عنّه غياب",18,"ب",1,0],["ويجري النسيم الرطب فيها كأنه","تبختر بيضاء الترائب معطار",19,"ر",1,0],["ويُجيد تقطير العواطف للورى","فتخاله لقلوبهم أنبيقا",20,"ق",2,0],["ويجمعهم وأياك انتساب","إلى مَنُ خصّ منطقهم بضاد",21,"د",1,0],["ويجتنب المرء العيوبَ لأنّها","لدى عائبيه لا لديه عيوب",22,"ب",1,0],["وَيَجزُزنَ النَّوَاصِي مُنعمَات","غَوَانيَ عن ثَوَابٍ المُعرضِينَا",23,"ن",2,0],["وَيَجيءُ طَوراً ضُرُّهُ في نَفعِهِ","جَهلاً وَطَوراً نَفعُهُ في ضُرِّهِ",24,"ر",2,0],["وَيَجمَعُنا في وائِلٍ عَشَرِيَّةٌ","وَوِدٌّ وَأَرحامٌ هُناكَ شَواجِرُ",25,"ر",1,0],["ويجتلَى من سجاياه التي اشْتهرت","للضدِّ هلكٌ وللمعتزِّ منجاة",26,"ه",1,0],["ويجري بأمرِ الملك سودَ يراعهِ","فيا حبَّذا ساداتنا وعبيده",27,"د",2,0],["ويجري بإسعاد العباد فحبذا","بسعدك يا سلطانها ساعياً يجري",28,"ر",2,0],["ويجلب الصبح لي ممَّا أساء به","بياض شعر فيا فرقي ويا فَرقي",29,"ي",1,0],["ويجمع بالثنا والأجر دنيا","وآخرة فيرضي الضرَّتين",30,"ن",1,0],["ويُجيلُ في الخَطْب الذي","تُضحي شواكِلُهُ تَشَابهْ",31,"ب",2,0],["ويجم عنها تارةً فكأنه","حتى أكون شريكه متنغِّصُ",32,"ص",1,0],["ويجْنينَ نُوَّار الأقاحي تعالياً","عن الجانيات الكمْءَ بين القصائص",33,"ص",1,0],["ويجسُمُ قَدْرُهُ ويزيدُ نُبلاً","بأقدارٍ لكم فيه جِسامِ",34,"م",1,0],["ويُجيزُ جَوْرَ قَضائه","أَهلُ المكارم حين يَحْكُمْ",35,"م",1,0],["ويجوز الخريفُ وهو ربيعٌ","وتَسورُ المياهُ في العيدان",36,"ن",1,0],["وَيَجتَمِعُ النَملُ في قَريَتِه","إِذا خَشِيَ الغَدرَ مِن جارِهِ",37,"ه",1,0],["وَيُجَشِّمُ النَفسَ المَخاطِرَ هادِئً","كَيلا تُلِمَّ بِقَومِهِ الأَخطارُ",38,"ر",1,0],["وَيَجعَلُ الحُبَّ دينَ القانِطينَ بِها","دينٌ يُقَرِّبُ بَينَ البَيتِ وَالقُدُسِ",39,"س",1,0],["ويُجري عليها الهَوَى في حُنُوٍّ","أَناملَ لُدْناً كرَطْبِ الزَّهَرْ",40,"ر",1,0],["ويجحد هذا الامر من هو لم يزل","اليك قريباً في الغباوة والحقد",41,"د",1,0],["ويجمعهم والشر طبع وإنما","قلوبهمُ في غير ذلك أشتات",42,"ت",1,0],["ويجعل الخير فيه","عمرا ودنيا ودينا",43,"ن",2,0],["ويجل قدر قلادة في صدره","وله القلائد سمطها الإلهام",44,"م",1,0],["وَيَجمَعُ قَومَكَ بِالمُسلِمينَ","عَظيمَ الفُروضِ وَسَمحُ السُنَن",45,"ن",1,0],["وَيَجلِسونَ إِلى عِلمٍ وَمَعرِفَةٍ","فَلا يُدانَونَ في عَقلٍ وَلا فَهَمِ",46,"م",1,0],["وَيَجمَعُ الآيَ تَرتيباً وَيَنظُمُها","عِقداً بِجيدِ اللَيالي غَيرَ مُنفَصِمِ",46,"م",1,0],["وَيَجمَعُنا إِذا اختَلَفَت بِلادٌ","بَيانٌ غَيرُ مُختَلِفٍ وَنُطقُ",47,"ق",1,0],["وَيَجولُ في زُهرِ الرِياضِ كَأَنَّهُ","صَيبُ الرَبيعِ مَشى بِهِنَّ وَجالا",48,"ل",2,0],["وَيَجعَلُ ميقاتاً لَها تَنبَري لَهُ","كَما دارَ يَلقى عَقرَبَ السَيرِ عَقرَبُ",49,"ب",1,0],["وَيَجهَلُ أَنّي مالِكَ الأَرضِ مُعسِرٌ","وَأَنّي عَلى ظَهرِ السَماكَينِ راجِلُ",50,"ل",1,0],["وَيَجعَلُ ما خُوِّلتُهُ مِن نَوالِهِ","جَزاءً لِما خُوِّلتُهُ مِن كَلامِهِ",51,"م",2,0],["ويجعل باطنها ظاهرا","ويبرز من سرها ما اكتتم",52,"م",1,0],["وَيُجَمِّرونَ بِغَيرِ أَعطِيَةٍ","في البَرِّ مَن بَعَثوا وَفي البَحرِ",53,"ر",1,0],["ويجعلُ بِشرَه يَذِرُ الأعادي","فيبعَثُه جَنوباً أو شَمالا",54,"ل",2,0],["وَيَجهَدُ الناسُ في الدُنيا مُنافَسَةً","وَلَيسَ لِلناسِ شَيءٌ غَيرَ ما رُزِقوا",55,"ق",3,0],["وَيُجريها مِنَ الشِعبَينِ قُبّاً","إِلى الهَيجاءِ تَسعى كَالسَعالي",56,"ي",1,0],["ويجلو لي النجوم فأزدريها","وأغمض لا أريد سواك نجما",57,"م",2,0],["ويجري لك المعروفُ من كفّ واهبٍ","إذا جَمَدَ المعروفُ من كفّ حارمِ",58,"م",1,0],["وَيجعَلُ النائِلَ أَدنى سُبلِهِ","وَبَلَدٍ نائي المَحَلِّ مَحلِهِ",59,"ل",2,0],["وَيَجزيكَ بِالحُسنى إِذا كُنتَ مُحسِناً","وَيَغتَفِرُ العُظمى إِذا النَعلُ زَلَّتِ",60,"ت",1,0],["وَيُجمَلُ في حُباهُ طَودُ حِلمٍ","تُعَدُّ خِلالَهُ رَملَ الكَثيبِ",61,"ب",1,0],["وَيُجتَنى نورُ نَسيبي بِهِ","غَضّاً وَجِسمي غُصناً ذابِلا",62,"ل",2,0],["ويَجتنبُ المناهِلَ مُتْرعاتٍ","تَطيبُ نِطافُها للنّاهلينا",63,"ن",2,0],["وَيَجودُ في الأَزَماتِ تَحُزبُهم بِما","يَبتَزُّ مِن مالِ الغُواةِ وَيَسلِبُ",64,"ب",1,0],["وَيَجلِبُ الصافِناتِ الجُردِ يُطرِبُهُ","صَهيلُها وَيُعدُّ الجَحفَلَ اللَجِبا",65,"ب",2,0],["وَيَجتَلي غُرَّةَ مَجهولِها","بِالرَأيِ مِنهُ قَبلَ إِنجامِها",66,"م",3,0],["وَيَجرَحُ أَحشائي بِعَينٍ مَريضَةٍ","كَما لانَ مَتنُ السَيفِ وَالسَيفُ قاطِعُ",67,"ع",1,0],["وَيَجيشُ نارُ الحَربِ تَحتَ عُقابِها","وَالمَوتُ في صَرفي الفَوارِسِ جَمرُهُ",68,"ر",2,0],["وَيَجعَلُ هاماتِ أَعدائِهِ","قَلانِسَ يُلبِسُهُنَّ الرِماحا",69,"ح",2,0],["وَيَجُرُّني بِالمَطلِ مَوعِدُ حاجَةٍ","لَو شِئتُ قَد بَرَدَ الغَليلُ بِطيبِها",70,"ب",3,0],["ويَجْمَعُ مِنْ أَشْلائِهِمْ مُتَفَرِّقاً","بِصارِمهِ جَمْعَ الهَشِيم حَظيرُ",71,"ر",1,0],["وَيَجْمَعُ شرَّ الماءِ والنارِ سيْفُهُ","وَفي العُودِ سِرُّ النارِ والعُودُ أَخْضَرُ",72,"ر",1,0],["ويُجْرِي عَلَى وَفْقٍ المُرَادِ أُمُورَهُ","فَيَبْسُطُ فيها ما يشاء وَيَقْدُرُ",72,"ر",1,0],["ويَجِلُّ عنها قَدرُهُ حتى إذا","راقَتْهُ كانَتْ نائِلاً مبذولا",73,"ل",2,0],["وَيَجري قَضاءٌ ما لَكُم عَنهُ حاجِزٌ","فَأَلقوا إِلى مَولاكُمُ بِالمَقالِدِ",74,"د",1,0],["وَيَجهَلُ حَتّى يَسأَلَ الفَلَكَ الَّذي","يَدورُ عَلَيهِ كَيفَ بَدءُ مَدارِهِ",75,"ر",2,0],["وَيَجمَعُ مِنِّيَ الشَفَتَينِ صَمتي","وَأَبخَلُ في المَحافِلِ بِاِفتِراري",76,"ر",2,0],["وَيَجمَعُنا مِن صَنعَةِ الرَبِّ أَربَعٌ","وَمِن فَوقِها وَالمُلكُ لِلَّهِ خامِسُ",77,"س",1,0],["وَيَجري سابِحي وَلَهُ عُيوبٌ","وَيَقطَعُ صارِمٌ وَبِهِ اِنثِلامُ",78,"م",1,0],["ويَجْشِمُ فيه السِّيدُ رُعْباً فكُلما","أضاءتْ لعينيه القَواضِبُ سارا",79,"ر",2,0],["وَيجعل القبر يوماً","بيني وبينك سدا",80,"د",2,0],["وَيَجوز أجوازاً لَها","متعسفاً فَيَكاد يَردى",81,"د",2,0],["ويجوبُ الحياة في كل آنٍ","هاتفٌ منكمو وطيفٌ تأوَّبْ",82,"ب",1,0],["ويَجْلُو العَمَى عنَّا بأَنْوارِ رأيهِ","إِذا أَظْلَمَت ظَلْمَاءُ ذات غُيومِ",83,"م",1,0],["ويجْلِبُ لِي فَهْمِي ضُرُوباً مِن الأَذَى","وأَشقَى امْرِئٍ في قَرْيةِ الجهْلِ عالِمُ",84,"م",1,0],["وَيَجْزَعُ قَلْبِي لِلصُّدودِ وَإِنَّنِي","لَدَى الْبَأْسِ إِنْ طَاشَ الْكَمِيُّ صَبُورُ",85,"ر",1,0],["ويُجِدْنَهَا فَلَوِ الشَِّفَاهَ تَعَفَّفَتْ","عَنْ أَكْلِهَا لَضَمِنْتُهَا لخُلُودِ",86,"د",1,0],["وَيَجُوزُ مَا فَرَضَتْ عَلَيْهِ نَفْسُهُ","مِنْ نَجْدَةٍ وَنَدّى إِلى الأَنْفَالِ",87,"ل",1,0],["وَيُجْهِدُ ذِهْنِي شَاغِلٌ بَعْدَ شَاغِلٍ","فَمِنْ أَيِّ رُوحٍ تُسْمَتَدُّ القَصَائِدُ",88,"د",1,0],["وَيَجْعَلُ الخُلْفَ بِمَا فِي وُسْعِه","زِيَادَةً فِي الإِلْفِ وَالوِدَادِ",89,"د",1,0],["وَيَجْتَلِي حُسْنَ السُّهَى","إِنْ فَاتَهُ حُسْنُ القَمَرْ",90,"ر",1,0],["وَيَجْبها رَأْيٌ يُزلُ عَدَاهَا","رُبَّ رَأْيٍ أَغْزَى منَ الأجْناد",91,"د",1,0],["وَيَجِلُّ عَنْ نَفْعِ الشُّجَاعِ بِلادَهُ","مَا قَدْ يُفِيدُ بِلاَدَهُ المُتَبَرِّعُ",92,"ع",1,0],["وَيَجِيئُنِي إِرْهَافُ حَافِظَتِي","فِي منْتَهَى عَامِي بِأَمْدَادِ",93,"د",1,0],["ويجوبُ البحرَ من لم يَرَهُ","غيرَ طْيف من خَيالٍ في كراء",94,"ا",2,0],["ويجثو الصباح مليا يرش","شبابيكها ، بأرقّ التحايا",95,"ا",3,0],["ويجلو العمى عنا بأنوار رأيه","إذا أظلمت ظلماء ذات عموم",96,"م",1,0],["ويجتَثُّ إقطاعاً أقَرَّتْ جُذُورَهُ","سياسةُ تفريقٍ وحَوْزُ مغانم",97,"م",1,0],["ويجمعُ بينَ ظِلالِ القصورِ","وعَصْرِ الخمورِ ورشْفِ اللَّمى",98,"ا",1,0],["ويُجَنِّبونَ الكلب وَخزةَ واخزٍ","ويجَهِّزُونَ على الجُموعِ معاطِبا",99,"ب",2,0],["ويجعل الحبّ دين القاطنين بها","دين يقرّب بين \" البنت \" والقدس",100,"س",1,0],["ويجمَعُ قومك بالمسلمين","عظيمُ الفروضِ وسمحُ السن",101,"ن",1,0],["ويجبى إليها خمرُها من مشارقٍ","يجادُ بها تقطيرُها وَمغارب",102,"ب",1,0]]}