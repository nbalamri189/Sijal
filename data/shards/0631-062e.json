{"poems":[[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[93,"ألصيد لهو الملوك من قدم","https://www.aldiwan.net/poem11360.html","المنسرح"],[30,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[72,"سر بنا عن دمشق يا طالب العي","https://www.aldiwan.net/poem18264.html","الخفيف"],[51,"رخصت معاملتي على رجل","https://www.aldiwan.net/poem64939.html","أحذ الكامل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[85,"حلو الوعود متى وفاك","https://www.aldiwan.net/poem7885.html","مجزوء الكامل"],[62,"نجومنا سبعة في الكتب قد وضعت","https://www.aldiwan.net/poem52171.html","البسيط"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[52,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140930",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30473","المنسرح"],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[161,"على الطالع الميمون قد أسس القصر","https://www.aldiwan.net/poem59039.html","الطويل"],[161,"على الطالع الميمون أسست يا قصر","https://www.aldiwan.net/poem59089.html","الطويل"],[167,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[211,"يا ظبية البان يا غصن النقا النضر","https://www.aldiwan.net/poem13316.html","البسيط"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[372,"لا مقصر عن هوى ولا سال","https://www.aldiwan.net/poem57226.html","المنسرح"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[459,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[459,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[501,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[530,"خود رداح ربحله","https://www.aldiwan.net/poem37219.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["رَخيمةٌ ألْفاظُها فاتِرةٌ","ألحاظُها والسِّحْرُ منها يُجْتَنى",0,"ا",1,0],["رَخصٌ أَحَمُّ المُقلَتَينِ ضَعي","فُ المَنكَبَينِ لِلعِناقِ زَجِل",1,"ل",1,0],["رُخامٌ بَنَتهُ لَهُم حِميَرٌ","إِذا جاءَهُ ماؤهُم لَم يَرِم",2,"م",1,0],["رخصت عليه حياته","وغلت على قدر بلاده",3,"د",2,0],["رَخَاوَةُ العَيْشِ لَيْسَ يَعْقَبُهَا","فِي الجِسْمِ غَيْرُ الفُتورِ وَالسَّقَمِ",4,"م",1,0],["رَخيمُ الرُغاءِ شَدقَمٌ مُتَقارِبٌ","جُلالٌ إِذا اِنضَمَّت إِلَيهِ أَياطِلُه",5,"ل",2,0],["رَخيماتُ الكَلام مُبَطَّناتٌ","جَواعِلُ في البُرى قَصَباً خِدالا",6,"ل",2,0],["رخصت أنفس الخلائق بالطا","عون فيها فكل نفس بحبه",7,"ه",1,0],["رخصْت معاملتي على رجلٍ","وليغلُوَنّ عليه ما رَخُصا",8,"ص",2,1],["رخَّمتْهُ ورقرقته وضاهَى","فعلَها الأحمران والأسمرانِ",9,"ن",1,0],["رَخيمَةُ الصَوتِ إِن شَدَت لَفَتَت","لَها الدَراري وَأَنصَتَ السَحَرُ",10,"ر",1,0],["رخصت به الدنيا فكي","ف إذا أنالته يداك",11,"ك",1,0],["رخو صليب منير مظلم ذكر","أنثى خروج ولوج منضج خامٌ",12,"م",1,0],["رَخيمٌ مِن بَني الأَعرابِ طِفلٌ","يُجاذِبُ خَصرُهُ جَبَلَي حُنَينِ",13,"ن",1,0],["رَخصَةٍ حَوراءَ ناعِمَةٍ","طَفلَةٍ كَأَنَّها قَمَرُ",14,"ر",1,0],["رَخَصاتُ أَطرافٍ تَظَلُّ لَواعِباً","لا تَهتَدي طَوراً وَطَوراً تَهتَدي",15,"د",2,0],["رخص الشعر في بلاد قد انحط","طت كما قد غلا بقطرٍ راقي",16,"ق",2,0],["رخو اللبان نائه الطرائق","ذي منخرٍ رحبٍ وإطلٍ لاحق",17,"ق",1,0],["رَخَّصَ فيهِ شَيْخٌ له قَدَرٌ","فكانَ حَسْبِي مِن المُنَى وَكَفَى",18,"ف",2,0],["رخياً أمينَ السربِ محسودَ نِعمةٍ","تَرِفُّ على جنَبيَّ منها مباذل",19,"ل",1,0],["رخامية الأركان تبريه الحلا","مدبجة الارجاء أكنافها خضر",20,"ر",1,0],["رخامية الاركان تبرية الحلا","مدبجة الارجاء يزهو بها القطر",21,"ر",1,0],["رَخيمُ الدلِّ مكسالُ التّهادي","طويلُ الذيلِ صَرارُ النِّعالِ",22,"ل",1,0],["رخيمة الدل يغنى حسن منطقها","وثغرها لك عن كاس وعن وتر",23,"ر",1,0],["رَخيّ بالٍ وريفَ الظلّ من عمرٍ","مَعَ الأحبّة مبدوءٌ ومختتمُ",24,"م",1,0],["رَخيصُ بَيعِ الوِدادِ حينَ يَرى ال","مبتاعُ أَنَّ الَّذي اشتَرى غالِ",25,"ل",1,0],["رخُصتْ على قومٍ فقام لها","منك المنافسُ دونها المُغلي",26,"ل",2,0],["رِخوة المفصِل لَينٍ مسّها","صعبةٍ مزجَك جوراً باعتدلِ",27,"ل",1,0],["رخيُّ البنانِ في النوائب كلّما","أضبَّ على المال الحسيبُ المباكتُ",28,"ت",1,0],["رخ بالتواضع للإل","هِ وخذ بنيَّ مواهبه",29,"ب",2,0],["رَخيمَةٌ عَرُوبُ","وَبَرْزَةٌ لَعُوبُ",30,"ب",1,0],["رخّص في عصيانه أو قد جعل","طاعته فرضا فقولوا ما فعل",31,"ل",1,0]]}