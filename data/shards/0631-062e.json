","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28683","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62056","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83149","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33589","الهزج"],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[4984,"\" ليس الأدل \" 2","https://www.poetsgate.com/ViewPoem.aspx?id=175833",""],[5582,"أَلا عُوجُوا عَلَى الطَّلَلِ القَدِيمِ","https://www.poetsgate.com/ViewPoem.aspx?id=187263",""],[5582,"قِفْ وَسَلِّمْ فِي مَغانِي ذِي سَلَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=63570",""],[5605,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=159457",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""]],"verses":[["رَخيمةٌ ألْفاظُها فاتِرةٌ","ألحاظُها والسِّحْرُ منها يُجْتَنى",0,"ا",1,0],["رَخصٌ أَحَمُّ المُقلَتَينِ ضَعي","فُ المَنكَبَينِ لِلعِناقِ زَجِل",1,"ل",1,0],["رُخامٌ بَنَتهُ لَهُم حِميَرٌ","إِذا جاءَهُ ماؤهُم لَم يَرِم",2,"م",1,0],["رخصت عليه حياته","وغلت على قدر بلاده",3,"د",2,0],["رَخَاوَةُ العَيْشِ لَيْسَ يَعْقَبُهَا","فِي الجِسْمِ غَيْرُ الفُتورِ وَالسَّقَمِ",4,"م",1,0],["رَخيمُ الرُغاءِ شَدقَمٌ مُتَقارِبٌ","جُلالٌ إِذا اِنضَمَّت إِلَيهِ أَياطِلُه",5,"ل",2,0],["رَخيماتُ الكَلام مُبَطَّناتٌ","جَواعِلُ في البُرى قَصَباً خِدالا",6,"ل",2,0],["رخصت أنفس الخلائق بالطا","عون فيها فكل نفس بحبه",7,"ه",1,0],["رخصْت معاملتي على رجلٍ","وليغلُوَنّ عليه ما رَخُصا",8,"ص",2,1],["رخَّمتْهُ ورقرقته وضاهَى","فعلَها الأحمران والأسمرانِ",9,"ن",1,0],["رَخيمَةُ الصَوتِ إِن شَدَت لَفَتَت","لَها الدَراري وَأَنصَتَ السَحَرُ",10,"ر",1,0],["رخصت به الدنيا فكي","ف إذا أنالته يداك",11,"ك",1,0],["رخو صليب منير مظلم ذكر","أنثى خروج ولوج منضج خامٌ",12,"م",1,0],["رَخيمٌ مِن بَني الأَعرابِ طِفلٌ","يُجاذِبُ خَصرُهُ جَبَلَي حُنَينِ",13,"ن",1,0],["رَخصَةٍ حَوراءَ ناعِمَةٍ","طَفلَةٍ كَأَنَّها قَمَرُ",14,"