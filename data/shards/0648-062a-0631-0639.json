{"poems":[[95,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[90,"نزلت تجر إلى الغروب ذيولا","https://www.aldiwan.net/poem44454.html","الكامل"],[87,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[76,"أرقت على الصبا لطلوع نجم","https://www.aldiwan.net/poem12871.html","الوافر"],[22,"ألا من لقلب عارم النظرات","https://www.aldiwan.net/poem21659.html","الطويل"],[146,"نظرت ولم أبغ إلا شفائي","https://www.aldiwan.net/poem58423.html","المتقارب"],[170,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[266,"عوفيت نضو هواك برح داؤه","https://www.aldiwan.net/poem38139.html","الكامل"],[276,"مضى زمن الصبا فدع التصابي","https://www.aldiwan.net/poem52055.html","الوافر"],[287,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[287,"أتى نعي ملك أظلم الشمس والقمر","https://www.aldiwan.net/poem32742.html","الطويل"],[422,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[447,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[463,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[466,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[466,"هنيئا بهاء الدين للمجد والعلى","https://www.aldiwan.net/poem16174.html","الطويل"],[520,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54058","الوافر"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96370","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203698","الخفيف"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44855","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100214","الوافر"],[3042,"","https://poetry.dctabudhabi.ae/diwan/poem/96135","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132009","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131009",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59441","الرجز"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22062","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/19000","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76758","الطويل"],[3271,"ويعيش أحرار العقول بظلها غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=104120",""],[5122,"الدرة اللي تلبس اللماسي","https://www.poetsgate.com/ViewPoem.aspx?id=27279",""],[5174,"لغة الضاد ليلة الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=184937",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5410,"بَشَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=143854",""],[5480,"عزوتي","https://www.poetsgate.com/ViewPoem.aspx?id=16305",""],[5759,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213914",""],[5943,"ألا انتبهتا","https://www.poetsgate.com/ViewPoem.aspx?id=56465",""]],"verses":[["وَتَرْعَى مَا النُّفُوسُ بِهِ تَنَاجَى","بِأَخْفَتَ مِنْ مُنَاجَاةِ النَّسِيمِ",0,"م",1,0],["وترع قلبي للدوالي نعرةٌ","في البين يحبسها الحزين عويلا",1,"ل",2,0],["وَتُرعَةٌ لَو لَم تَكُن حُلوَةً","أَنسَت لِمَرتينَ بُحَيراتِهِ",2,"ت",2,0],["وَتَرعى مِنهُ عَينُ الظَبيِ شُهباً","لَها فَيُسالِفُ الظَبيَ الرَبيبا",3,"ب",2,0],["وَتَرعى بَراحاً حَيثُ لا يَستَطيعُها","مِنَ الناسِ أَهلُ الشاءِ وَالحُمُراتِ",4,"ت",1,0],["وترعَى العيونُ إذا لاحظتْ","هُ في روِض رونِقهِ والرُّواءِ",5,"ا",2,0],["وتَرعرعتْ فيها أُطَيفالُ الكَلا","مُمتْكّةً ضرعَ الغَمامِ الغادي",6,"د",2,0],["وترعرت فيه الصغار بعيدما","لبسوا الصغار وقد ذوت كبراؤه",7,"ا",3,0],["وَتَرعى ريف رأفته البرايا","فتنعم في خلائقه الرحاب",8,"ب",1,0],["وَتُرعدُ الجِبالُ مِن حَملَتِهِ","وَتَقشَعِرُّ الأَرضُ خَوفاً أَن تُدَك",9,"ك",1,0],["وَتُرعِشُ أَيديهِم مَهابَتُهُ فَما","لِضَربِهِم وَالطَعنِ في جِسمِهِ أَثَر",10,"ر",1,0],["وترعاك من عين الإِله عناية","تصاحب من صاحبته وتسالم",11,"م",1,0],["وتَرْعى موقِفَ المَلْهوفِ عَنْهُ","يُلَبِّي نَفْسَهُ قَبْلَ النِّداءِ",12,"ا",2,0],["وترعد لي من دون غاية مطلبي","لتصعقني أبراقها ورعودها",13,"د",3,0],["وترعى لهم حرمةَ الإختلاطِ","بهم والمزارَ لهم والوصالا",14,"ل",2,0],["وترعى مقالي سمع يقظان عالمٍ","بما أودع الرحمن عندي من سر",15,"ر",1,0],["وترعى فروض العهد والنِّكس غادرٌ","خَؤونٌ ولم يبق الثَّناءُ مع الغَدْرِ",16,"ر",1,0],["وترعف آناف اليراع بكفه","ندى وردى في الخلق ترجى وتحذر",17,"ر",1,0],["وترعى ما حييت ولا تبالي","عهودك كلها في كل حاله",18,"ل",2,0],["وتَرعِيَّةٍ لم يَدرِ ما الخمرُ قبلَنا","سقيناهُ حتى صارَ قيداً له السُّكرُ",19,"ر",1,0],["وترعرعتُ، صرخة الثأر في سم","عي ونار الحقود في أعصابي",20,"ب",2,0],["وَتُرعِد أحشَاءَ النّجوم نِصالُهَا","وَتَملِكُ أحرارَ المُلُوكِ فِصالُهَا",21,"ه",2,0],["وترعي الطرف زهر أريض روض","بمرعى فوق خدك غير موبي",22,"ب",2,0],["وترعى بلا جهلٍ قرابة بيننا","وبينكم لما قطعتم وصالها",23,"ل",3,0],["وترعاك عين الله في كل موطن","ولا تلفى إلا الدهر نحوك مقبلا",24,"ل",2,0],["وترعى له العهد المتين ومثله","جدير بان يرعى له ابدا عهد",25,"د",1,0],["وتُرعدُ أيديُ الأملاك خوفاً","إذا مسكت لتنظُرَ في كتابيِ",26,"ب",2,0],["وَتَرعى مِنَ الوُدِّ الَّذي كانَ بَينَنا","فَما يَستَوي راعي الأَمانَةِ والمُبدي",27,"د",2,0],["وَتَرعى بِها البُردَينِ ثُمَّ مَقيلُها","غَياطِلُ مُلتَجٌّ عَلَيها ظِلالُها",28,"ل",3,0],["وترعى ربيعا للصوارم حوله","رياض بما فيها من الدهر تحتمي",29,"م",2,0],["وترٌ على شطّ المنيّةِ غافي","شُلّتْ عليه أناملُ العزافِ",30,"ف",1,1],["وترعد وتبرق : مخايلها وتسكبها","وتحييبها فياض روح ، فبل يباسي",31,"س",2,0],["وترعّشتْ شهُبُ الخيال كناية ً","فترجّجت هُوجُ العقول مِراسا",32,"س",2,0],["وترعاه فشيمتك العجوز39","وتنزلها فتبهجك العجوز40",33,"ز",1,0],["وترعد مني الشفاه لترسل","قبلة حبّ لأحلى قمرْ",34,"ر",1,0],["وترعى رعايها سيوح المواجيب","من خير طلعات المعاني صلابه",35,"ب",2,0],["وترعى نجومَ الليلِ عيني كأنها","تُطاردُ نجمَ الليلِ والنجمُ يَهربُ",36,"ب",1,0],["وترعى بالصبا شهد الأماني","فهل عسلا مصفى قد جنيتا؟",37,"ت",2,0]]}