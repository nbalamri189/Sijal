{"poems":[[55,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[40,"أفي أثر الأظعان عينك تلمح","https://www.aldiwan.net/poem7695.html","الطويل"],[87,"بي مثل ما بك يا قمرية الوادى","https://www.aldiwan.net/poem6813.html","البسيط"],[30,"تقول كليب حين مثت سبالها","https://www.aldiwan.net/poem1306.html","الطويل"],[68,"لم أنس ما عشت حماما دخلت به","https://www.aldiwan.net/poem40667.html","البسيط"],[76,"ألم يسقيني سلافة ريقه","https://www.aldiwan.net/poem12916.html","الطويل"],[76,"وأروع أمجد قرظته","https://www.aldiwan.net/poem12957.html","المتقارب"],[54,"وزائر زارني على عجل","https://www.aldiwan.net/poem26754.html","المنسرح"],[54,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[77,"أغيد مثل الشمس لما بدا","https://www.aldiwan.net/poem69013.html","السريع"],[50,"دعني من الناس ومن لومهم","https://www.aldiwan.net/poem63425.html","السريع"],[50,"تركت الربع لا أبكيه","https://www.aldiwan.net/poem65246.html","مجزوء الوافر"],[50,"وشاطرِ أحورِ طاوي الحشا","https://www.aldiwan.net/poem66292.html","السريع"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30478","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[108,"حول الامتيازات","https://www.poetsgate.com/ViewPoem.aspx?id=179640",""],[53,"رُبَّ كعاب في حجابٍ لم تزلْ","https://www.poetsgate.com/ViewPoem.aspx?id=30250",""],[53,"ربّ كعابٍ في حجابٍ لم تزل","https://www.poetsgate.com/ViewPoem.aspx?id=25848",""],[189,"دخلت حماما على غرة","https://www.aldiwan.net/poem14671.html","السريع"],[202,"سرى وهنا وليلتنا","https://www.aldiwan.net/poem51975.html","مجزوء الوافر"],[240,"إلام أكتم فضلا ليس ينكتم","https://www.aldiwan.net/poem31760.html","البسيط"],[275,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[290,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[408,"تنبه حظي بعد طول منام","https://www.aldiwan.net/poem46935.html","الطويل"],[422,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[422,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[556,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[563,"هو الوارد القدسي كالسيل يحطم","https://www.aldiwan.net/poem33881.html","الطويل"],[572,"قامر باللهو في هوى قمر","https://www.aldiwan.net/poem69678.html","السريع"],[592,"سبحان من كون الأشياء تكوينا","https://www.aldiwan.net/poem11513.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83305","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48515","الطويل"],[834,"","https://poetry.dctabudhabi.ae/diwan/poem/130357","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38334","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38448","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107204","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120037","المتقارب"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80209","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64967","البسيط"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128302","الطويل"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128283","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109271","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95517","المتقارب"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141329","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49617","الوافر"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106706","المتقارب"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104802","البسيط"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100110","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60940","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45662","المنسرح"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137015",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94319","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109861","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201195",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134206","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134180","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134177","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11250","المتقارب"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100198","المتقارب"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89993","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131192",""],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139838",""],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122290","الوافر"],[3833,"","https://poetry.dctabudhabi.ae/diwan/poem/147703","الوافر"],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142889","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69981","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83562","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83491","الوافر"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104513","الهزج"],[4784,"برق التهاني في سناه ائتلقا","https://www.poetsgate.com/ViewPoem.aspx?id=170935",""],[4984,"أثر الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=191621",""],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[6179,"وكَانَ هُرَيْمٌ من سِنَانٍ خَلِيفَة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7628&r=&rc=11",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""]],"verses":[["فَنَل ما أَنالَ الدَهرُ سَعداً وَغِبطَةً","فَرُبَّ زَمانٍ حَلَّ غَيرِ مُنيلِ",0,"ل",1,0],["فَنِلنا غِراراً مِن حَديثٍ نَقودُهُ","كَما اِغبَرَّ بِالنَصِّ القَضيبُ المُسَمَّحُ",1,"ح",1,0],["فنلتُ ما نلت من سؤل ومن أمل","ورحت لم أحص أفراحي وأعيادي",2,"د",2,0],["فَنَل مِثلَها مِن مِثلِهِم ثُمَّ لُمهُمُ","بِما لَكَ مِن مالٍ مُراحٍ وَعازِبِ",3,"ب",1,0],["فَنِلتُ مِن حَرِّها بَرداً عَلى كَبِدي","وَفُزتُ مِن مالِكٍ مِنها بِرُضوانِ",4,"ن",1,0],["فَنِلتُ مُرادَ النَفسِ مِن أُقحُوانَةٍ","شَمَمتُ عَلَيها نَفحَةً لِعَرارِ",5,"ر",1,0],["فَنَلثُمُ أَوضاعَ تِلكَ الرِقاعِ","وَلُعسَ مَراشِفِ تِلكَ السُطورِ",6,"ر",1,0],["فَنِلتُ مِنهُ الَّذي أُؤَمِّلُهُ","بَلِ الَّذي كانَ دونَهُ أَمَلي",7,"ل",2,0],["فَنِلنا طَرِيَّ اللَحمِ وَالشَمسُ غَضَّةٌ","كَأَنَّ سَناها صَبَّ في الأَرضِ زِريابا",8,"ب",2,0],["فنلتُ منهُ فوقَ ما اشتهي","وفوقَ ما يرُغِمُ أنفَ الحسود",9,"د",1,0],["فَنِلتُ ما ضَنَّ بِهِ صاحِياً","وَالقَلبُ مِنّي جامِحٌ قاسِ",10,"س",1,0],["فَنَلزَمُ حَيثُ ذا حَمداً","وَنَلزَمُ حَيثُ ذا ذَمّا",11,"م",2,0],["فنلتُ تقبيلاً على خدّهِ","ونام منكبّاً على فرشي",12,"ش",2,0],["فنِلْتَ الَّذِي قد نِلْتَ إِذ لَيْسَ للعُلا","سواكَ كأَنَّ الدَّهْرَ للنَّاسِ منْتَقِ",13,"ق",1,0],["فَنِلْنا وَنَالَ القَوْمُ مِنَّا وربَّما","فَعَلْنَا ولكنْ ما لَدَى اللِ أوسعُ",14,"ع",1,0],["فنلتُطلقوها كالقذيفة؛ جملةً","تَشْفى فؤاد النيل من أوجاعِهِ",15,"ع",2,0],["فنلت مِنها نظرة على عجل","مص رُبَّ كعاب في حجابٍ لم تزلْ",16,"ل",1,0],["فنلت مِنها نظرة على عجل","آخِرُها أولُها من العجل",17,"ل",1,0],["فنلتُ منها كلَّ ما ساءني","من همِّ نفسٍ ثم إسخانِ عين",18,"ن",1,0],["فنلتُ السكرَ من خمرٍ","ومن ثَغْرٍ ومن غَنَجِ",19,"ج",1,0],["فَنِلتُ مِن وَصلِها ما كُنتُ آمُلُهُ","بَعِدتَ مِن زَمَنٍ لَذّاتُهُ حُلُمُ",20,"م",1,0],["فنلهبُ أذيالَ الظلامِ بزفرةٍ","ونخرقُ طيّاتِ السكونِ بأنّة",21,"ه",1,0],["فنلت عفواً ونال الفخر محتبسا","ذو العز عارف موسى اذ قضى وطرا",22,"ر",2,0],["فَنِلتُ بِهِم عَلّاً عَلى نَهلِ الهَوى","وَقَد كُنتُ أَرجو أَن أَفوزَ بِنَهلَةِ",23,"ه",1,0],["فَنِلتُمُ ما تَمَنَّيتُم عَلى يَدِهِ","وَما أَصابَكُمُ كَدٌّ وَلا نَصَبُ",24,"ب",1,0],["فَنِلتُ به رُمحَ السِّماكِ مصاعداً","وطَنّبتُ فوقَ الْفَرقدين خيامي",25,"م",2,0],["فنَلْ ما تَمنَّى عند مشتجر القنا","فَنَيْلُ الأَماني بالقنا المتشاجر",26,"ر",1,0],["فنلْ أجرَ هذا الصَّوم واهنأ بعيده","ورمْ مجدعاً أنفَ الحسود ومرغما",27,"م",2,0],["فنلْ منه الطِّلابَ فكلُّ يومٍ","أَنَالَكَ ما طلبتَ أخٌ حميمُ",28,"م",1,0],["فنلقيه نظماً تارة بكلامنا","ونلقيه نثراً عند من هو يفهم",29,"م",1,0],["فَنِلْتُ سُؤْلي من رشفِ رِيْقَتِهِ","ومُنْيَتي من مآربٍ أُخَرِ",30,"ر",1,0],["فنلتقي بعد هذا البين في دعةٍ","والبين قد حل فيما بين قالينا",31,"ن",2,0],["فَنِلتُم بِنُعماهُ حَياةً جَديدَةً","غَدَت بِنُفوسٍ عِندَ غَيرِكُم تَشرى",32,"ر",2,0],["فنلت رضا خير الخلائف موقناً","بأنك أولى من أحب وكرّما",33,"م",2,0],["فَنِلتُ به ثأْري وأدركت ثؤرتي","إذا ما تناسى ذَحْله كلُّ عَيْهبِ",34,"ب",1,1],["فَنِلتُ شِفاءَ القَلبِ مِن وَسمَةِ الرّدى","وَنِلتُ شِفاءَ الجسمِ مِن كلّ أَوصابي",35,"ب",2,0],["فَنِلت السّقمَ يا تيهي سُروراً","فَقَد أَشبهته عَيناً وَخصرا",36,"ر",2,0],["فَنَلتَزِمَ الشَّرعَ الشَّريفَ بجَمعِنا","وعن سُنَنِ التَّنزِيلِ لا نَتَنَكَّبُ",37,"ب",1,0],["فنلت أَمانيك من منعم","كريم ولا زلت مسترفدا",38,"د",2,0],["فِنلتَ نِعمَةَ مَولى المُلك سَيدنا","مُحيي العِباد بِهامي فَضلِهِ الهَطلِ",39,"ل",1,0],["فَنِلْتُ وَصْلَكَ لا الأَعداءُ تأْمُرُني","بِالصَّدِّ عَنهُ ولا الْعُذَّالُ تَنْهاني",40,"ن",2,0],["فنلني بعفو منك أحيى بقربه","وغش بيسر منك فقري وإعساري",41,"ر",2,0],["فَنَلْني بعفو مِنْك أحيا بِقُرْبِه","اَغِثْنِي بِيُسْرٍ منك يَطْرُدُ اِعْساري",42,"ر",2,0],["فنلتقي حول طعام جيد","على بساط الخضرة الزمردي",43,"ي",1,0],["فنلتَ الوسام حباه المليك","وفي كل فضلٍ له شاهد",44,"د",1,0],["فنلت على تلك الحداثة شهرةً","لدى أدباء القطر طارت إلى الشّهب",45,"ب",1,0],["فنلتَ حقائقَ الأشياء علماً","كفاكَ البحثَ عنها والسؤالا",46,"ل",2,0],["فنِلنَا الأمَانَ علَى دِينِنَا","وأبنَائِنَا وَخُدُورِ العِيَال",47,"ل",1,0],["فَنلتَ ما نِلتهُ مِن مَحوِ سابِقَةٍ","وَبُدِّلَ الحُزنُ أيضاً بالمَسَرَّاتِ",48,"ت",1,0],["فنلت المنى والحمد للَه عندما","أنخت على باب الجوادين ضامري",49,"ر",2,0],["فنْ لاحَ قلتُ البدرَ أظهره الدجى","وإن فاح قلت المسك هبت به الصبا",50,"ب",2,0],["فَنلت يَقظان مِن ضيافتِهِ","ما نلتُهُ نائِماً مِن الطَيف",51,"ف",1,1],["فنلت من الوزير رضى وعطفاً","ورحت تشد للاحكام ازرا",52,"ر",2,0],["فنلت ما رجوت من أماني","وصرت مما خفت في أمان",53,"ن",1,0],["فنلت من يوسف حسن الخصال كما","قد نلت حكما وجاهاً من سليمان",54,"ن",1,0],["فنلتُ بالاتفاق مالاً","نال به حظه اليتيمُ",55,"م",1,0],["فنلت عليا الدرجات في هنا","واضحت الدنيا لنا محزونه",56,"ن",2,0],["فنل بعده ما شئت واسمُ مؤرخا","تهنى بَها الثاني المجيد بحشمت",57,"ت",1,0],["فنل بعدها الأسمى وفز حيث ارخت","بك الرتبة العليا لها السر فائق",58,"ق",1,0],["فَنِلتَ فَأَقصَيتَني عامِداً","كَأَنّي ذو عُرَّةٍ أَجرَبُ",59,"ب",1,0],["فنلت لدى رمسه ما نويت","وللمرء من عمل ما نوى",60,"و",2,0],["فنلتُ في قُربه الدنيا يا جمعها","ومرّ أسعَدُ وقتٍ لي برؤيته",61,"ت",2,0],["فنلت من جود المليك رتبة","عن نيلها كلّ سريّ عاجز",62,"ز",1,0],["فنلتقي في حمى المولى الوصي أبي","الأئمة الطاهرين السادة الغرر",63,"ر",1,0],["فنلنا الانس مقروناً بحظ","تزوجنا وطلقنا بشهر",64,"ر",1,0],["فنل ما شئت إن الفقر حدٌّ","وعش ما شئت إن الموت غايه",65,"ا",3,0],["فنلهو وما ندري بما دارَ حولنا","وهل يربحُ المأتيُّ أم هو خاسرُ",66,"ر",1,0],["فَنلتم رفعة القمرين حَتّى","نَبينا عَن بِعادٍ للقطينِ",67,"ن",1,0],["فَنِلتُ الَّذي قَد نِلتُ جوداً وَمِنَّةً","وَقد جَدَّ جدُّ الحَرب وَالهَولُ مُشتَدُّ",68,"د",1,0],["فَنِلتُ بِجاهِهِ العالي أَماناً","وَأَقبلتِ المُنى لي باِندِفاعِ",69,"ع",1,0],["فنلت السهل بالسهل","ورضت الصعب بالأصعب",70,"ب",1,0],["فنلت في زورته أقصى المنى","وعدت كالبدر لدينا مشرقا",71,"ق",2,0],["فنلوذ بالمعمور من دوحاته","نرجو التمسك للنجاة بحبله",72,"ل",2,0],["فنَل ْ هذي الليالي بالتقى لا","تدعْها  إذ تمر ُّك َ  كالعَوابر",73,"ر",1,0],["فنلنا المنى من بعد أن كادت العدا","تحيط بنا من كل قطر وجانب",74,"ب",1,0],["فنلت ولم تشعر به الوقت في الهوى","ولم تحو منها غير همٍّ وخسران",75,"ن",1,0],["فَنلْنا من اللاَّهوت كأس هداية","وغنَّى لنا شادٍ معانيه تُطربُ",76,"ب