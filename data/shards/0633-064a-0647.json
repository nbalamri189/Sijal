{"poems":[[79,"ألما على شط الفرات المقدس","https://www.aldiwan.net/poem35873.html","الطويل"],[37,"أمن طلل أقوى من الحي ماثله","https://www.aldiwan.net/poem39102.html","الطويل"],[60,"يا أكرم الخلق على الله","https://www.aldiwan.net/poem30804.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85535","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[102,"لص تحت الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=50429",""],[369,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[371,"أقلامه من غلط طاغيه","https://www.aldiwan.net/poem17676.html","السريع"],[475,"سيهلك يا سلمى شفيق عليكم","https://www.aldiwan.net/poem4791.html","الطويل"],[1426,"","https://poetry.dctabudhabi.ae/diwan/poem/124626","المنسرح"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100736","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205922","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54398","الطويل"],[4767,"مهرجان صفوى","https://www.poetsgate.com/ViewPoem.aspx?id=92537",""],[4767,"صرح الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=100459",""],[4767,"سلم الصعود","https://www.poetsgate.com/ViewPoem.aspx?id=180948",""],[4767,"جِنان الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=213975",""],[5090,"سوادُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=184961",""],[5273,"الشاعر القتيل","https://www.poetsgate.com/ViewPoem.aspx?id=197218",""],[5351,"دعوه يعد للعشرة","https://www.poetsgate.com/ViewPoem.aspx?id=203209",""],[5411,"سَيُهْزَمُ الْجَمْعُ","https://www.poetsgate.com/ViewPoem.aspx?id=208610",""],[5431,"للبردوني ..في يوم ذكراه","https://www.poetsgate.com/ViewPoem.aspx?id=199645",""],[5449,"أرقُّ العطر","https://www.poetsgate.com/ViewPoem.aspx?id=188954",""],[5956,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=182144",""],[6019,"شهقةُ قصيدةٍ في رثائه","https://www.poetsgate.com/ViewPoem.aspx?id=137041",""],[6093,"اللعبة","https://www.poetsgate.com/ViewPoem.aspx?id=206566",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[6291,"هنا ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87673&r=&rc=7",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["سَيَهْديكَ عرْفُ الطّيبِ واليومُ شامِسٌ","ونارُ القِرَى تدْعوكَ في جُنْحِ حِنْدِسِ",0,"س",1,0],["سَيَهلِكُ في الدُنيا شفيقٌ عَلَيكُمُ","إِذا غالَهُ مِن حادِثِ الدَهرِ غائِلُه",1,"ل",2,0],["سَيهزمُ الجَمعُ عَلى عقبِهِ","بِحَيدَرٍ وَالنَصرُ بِاللَهِ",2,"ه",1,0],["سيهذب المستقبل الإنسانا","حتى يَكون أبرَّ مِمّا كانا",3,"ن",2,1],["سيَهوِيانِ وَيُطفي اللَهُ نورَهُما","وَإِن تَراخى بَقاءُ النَيِّرِ السامي",4,"م",2,0],["سيهلّ غد وله طرق","أتقى زمتاعبه أهون",5,"ن",1,0],["سيُهدي خاطري لكَ سائراتٍ","إلى ناديكَ تَتّصِلُ اتِّصالا",6,"ل",2,0],["سَيَهلَكُ الكَلبُ بِها عاجِلاً","ثَمودُ قَد تَهلَكُ بِالطاغِيَه",7,"ه",1,0],["سَيَهلَكُ يا سَلمى شَفيق عَلَيكُمُ","إِذا غالَني مِن حادِثِ الدَهرِ غائِلُه",8,"ل",2,1],["سيهدم العارضان كل بنا","وما بنى المجد ليس ينهدم",9,"م",1,0],["سيهدم دهر العدل ما قد بنيتمُ","وتصبح دور الظلم وهي طلول",10,"ل",1,0],["سيهدم الطَّوْدُ مَنْ يبغيه معتديًا","وليس يُهدم من أركانكم حجرُ",11,"ر",1,0],["سيهدي إلى المهديّةِ النّصرَ والهُدَى","بهديكُم فيها وتونسُ تُؤْنَسُ",12,"س",1,0],["سيهات تبعث بالسرور سلامها","شعرا تصاغ إلى الحبيب قصائده",13,"د",2,1],["سيهات حق عليك أن","تبكي أباً ومعلما",14,"م",2,1],["سيهات هذا حَيُّنا","من بعده قد أظلما",14,"م",2,0],["سيهات نالت ما يليق بِها","نصراً على الهامات كالكُلل",15,"ل",1,0],["(سيهاتُ) كانت لي جِنانَ الصِّبا","والروضةَ الغنَّاءَ والملعبا",16,"ب",2,1],["سيُهْزَمُ جيشُ البغي مهما تعاظمت","قواه ومهما جاء من كيده شرُ",17,"ر",1,0],["سيُهْلِكُ حِقْدٌ أهلَهُ ولَطالَما","بِخِنْجَرِهِ المَصْقولِ يُقْتَلُ صَاقِلُهْ",18,"ل",2,0],["سيهزم وهو مذعورٌ","ومرتعبٌ بما خسره",19,"ر",2,0],["سَيُهْزَمُ الْجَمْعُ مِنْ بِيْتينِ قُلْتَهُما","ويَحْملُ البَحر باقي رغْوة الزَّبدِ...",20,"د",1,0],["((سيهزمُ الليل)) : قد خُطّتْ جباههمُ","مازال للحبِ أنوارٌ ومتسعُ",21,"ع",1,0],["سيهزمُ كيدَ أعداءٍ","ويُرجعُ أرضَ مَنْ قُهِروا",22,"ر",3,0],["سيهنأ قلبي ويزهر حبي","وأعزف لحني إلى العاشقين",23,"ن",1,0],["سيهاتُ تمتدُّ في أفق الهوى وجعاً","ثكلى وأرخى عليها ساتراً ليلُ",24,"ل",1,0],["سيهزمون وفي صنعاء موعدهم","ويلعنون بأفواه لنا عذبة",25,"ب",2,0],["سَيَهرَمُ مِن مُقارَعَةِ اللَّيالي","وَيَسأَمُ مِن مُدامٍ أَو سَماعِ",26,"ع",1,0],["سيهزم الجمع إن همّوا بخائنة","وأنت أبناؤك الأبطال ما هُزموا",27,"م",3,0],["سَيَهرُبُ النَّحلُ عن أرضِ النِّفاقِ ضُحىً","وَيَغْرَقُ الجَمْعُ في بَحْرٍ مِنَ الوَحَلِ",28,"ل",1,0]]}