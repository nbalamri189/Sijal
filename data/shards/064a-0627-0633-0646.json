{"poems":[[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[64,"يا سندي والذي مودته","https://www.aldiwan.net/poem52432.html","المنسرح"],[108,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[124,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[228,"هبة الحب يا شعاع رؤايا","https://www.aldiwan.net/poem39735.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2439","المنسرح"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122321","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64073","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119994","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56615","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130750","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93881","الخفيف"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147352","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205588",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114458","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35447","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204244",""],[4684,"مع (دونكيشوته) بدون همز.","https://www.poetsgate.com/ViewPoem.aspx?id=201111",""],[4902,"جتني","https://www.poetsgate.com/ViewPoem.aspx?id=5043",""],[4916,"ياسنين","https://www.poetsgate.com/ViewPoem.aspx?id=135641",""],[4930,"من قصيدة (رمسيس يدعو السندباد)","https://www.poetsgate.com/ViewPoem.aspx?id=213626",""],[5039,"من وين ؟..ولو ين؟","https://www.poetsgate.com/ViewPoem.aspx?id=48138",""],[5455,"بايعها","https://www.poetsgate.com/ViewPoem.aspx?id=35124",""],[5652,"كنتي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=168821",""],[5694,"اعشقك نجد","https://www.poetsgate.com/ViewPoem.aspx?id=132105",""],[5851,"الوطن المسافر","https://www.poetsgate.com/ViewPoem.aspx?id=175286",""],[6102,"منة","https://www.poetsgate.com/ViewPoem.aspx?id=185063",""]],"verses":[["يا سندي وعمدتي","يا عدّتي لشدّتي",0,"ي",1,0],["يا سندي والذي مودَّتُه","عنديَ رُوحٌ يَحْيا بها الجَسدُ",1,"د",1,1],["يأسَنُ العشرُ، فإن مرَّ علي","فمها، عاد بنفح طيب",2,"ب",1,0],["يا سنةً غالها الزمان وما","غالت سوانا حوائل العصر",3,"ر",1,0],["يا سنا الحُبُّ يا سَنا اللَهُ ما أَح","رَقتَ ناري إِلّا لِيَنقى سَنايا",4,"ا",3,0],["يا سَنَدَ الظاعِنينَ مِن أُحُدِ","حُيِّيتَ مِن مَنزِلٍ وَمِن سَنَدِ",5,"د",1,1],["يا سندس الاكياس يا عالي الذرى","باد هواك صبرت ام لم تصبرا",6,"ر",2,0],["يا سناءَ الملوك مَن كان بالشا","م ومن كان منهمُ بالعراق",7,"ق",1,0],["يا سند العافي ويا ابن الذي","عن جوده تقوى الأسانيد",8,"د",1,0],["يا سنة قدح الحمام زنادها","من أي كف أم بأي زناد",9,"د",1,0],["يا سنى الجمال أنعم بقربٍ","يصبح القلب فيه أسعد حالا",10,"ل",2,0],["يا سني الكمال يا بدر تم","من سناه استمد كل اقتباس",11,"س",1,0],["يَا سُنْبُلاتِ الفَجْرِ تِلكَ حِكَايةٌ","مَرْوِيَّةٌ عَنْ بُلْبُلِ الأَطْهَارِ",12,"ر",1,0],["يا سنة أقبلت لنا","أقبلت ميمونة الجبينْ",13,"ن",1,0],["يا سنى القلبِ يا ضياءَ جُفُوني","يا فريداً فيما له من زينِ",14,"ن",1,1],["يا سَنا الكُلِّ إِن شَهِدناكَ يَوماً","فَهوَ يَومٌ مِنَ الزَّمانِ سَعيدُ",15,"د",1,0],["يا سنة البدر في الدياجي","وغرة الشمس في الصباحِ",16,"ح",1,1],["يا(سنْشوَ) المسكين مالك مطرقٌ","والحلم ينهش أحمقاً حد الفنا",17,"ا",1,0],["يا سنا الفضة ويا جيد المهاة","يا شذا نبت الخزامى في وطاها",18,"ا",3,0],["ياسنين عمري مالفاني كفاني","الى متى والحظ طايح ومقرود !!",19,"د",1,0],["يا سندبادُ انسَ الجراحَ وقفْ على برِّ الأمانِ","اقذفْ شراعَ اليأسِ في بحرٍ طغَى بالامتهانِ",20,"ن",1,0],["ياسندرلا .. والعمر سبعة أقزام","وقلبي سفينه .. والمجاديف ضلعين",21,"ن",1,0],["يا سنيني اللي قضيت العمر اجمّعها","يا ذكرياتي من اولها لتاليها",22,"ي",3,0],["ياسنبله في ارض صدري ميادين","جوعي ينادي .. ليه ماله إجابه",23,"ب",2,0],["ياسنام الأرض في حاضر وبادي","ياديار الوجه الأبيض والوسامه",24,"م",2,0],["ياسندباد البوح فاترك عالما","لا ينبت النسرين من أحجاره",25,"ر",2,0],["يا سَنا النُّورِ ؛ يا مَلاءَكَ عُمري","أَخرِجِي مِنْ ضَلالَةِ العُمرِ جِنَّهْ",26,"ن",2,0]]}