 يوم أنسنا","https://www.aldiwan.net/poem24279.html","الطويل"],[485,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[485,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[496,"بقربك من بعادك استجير","https://www.aldiwan.net/poem67376.html","الوافر"],[503,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[503,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[508,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[518,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[518,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[532,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[543,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[554,"رضيت بالدون لما لم أجد وزرا","https://www.aldiwan.net/poem47161.html","البسيط"],[554,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[554,"ما ارتبت منكم على مر الزمان فلم","https://www.aldiwan.net/poem48042.html","البسيط"],[554,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[561,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[561,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[578,"عسى أن يسر السائرين إياب","https://www.aldiwan.net/poem3102.html","الطويل"],[578,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[589,"تسلطن في الملاح بخانقي","https://www.aldiwan.net/poem17451.html","الوافر"],[589,"رشيق القامة النضره","https://www.aldiwan.net/poem17529.html","مجزوء الوافر"],[589,"يا قلب كم ذا الخفوق والقلق","https://www.aldiwan.net/poem17614.html","المنسرح"],[590,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[590,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[590,"على الدين فليبكي ذوو العلم والهدى","https://www.aldiwan.net/poem11555.html","عموديه"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2580","الوافر"]],"verses":[["وَقَد صُقِلَ السَيفُ بَعدَ الصَدا","وَبانَ لَظى النارِ بَعدَ الدُخانِ",0,"ن",1,0],["وَقَد صاحَ بِنا المَجدُ","إِلى أَينَ إِلى أَينا",1,"ن",2,0],["وقد صَغَتِ الجَوْزاءُ والفَجْرُ ساطِعٌ","كَما لمَعَتْ رَيّا إليَّ بدُمْلُجِ",2,"ج",1,0],["وقد صَرّتِ الخَضْراءُ أخْلافَ مُزْنِها","وليسَ على الغَبْراءِ رَطْبٌ ويابِسُ",3,"س",1,0],["وَقَد صَبَرتُ عَلى قَومٍ مُنيتُ بِهم","وَما تَكَلَّمتُ إِلّا بَعدَ إِعذارِ",4,"ر",1,0],["وَقَد صادَت فُؤادَكَ إِذ رَمَتهُ","فَلَو أَنَّ اِمرَأً دَنِفاً يَصيدُ",5,"د",1,0],["وقد صوَّحت تلك الأمانيّ كلها","فحاكت نبات الأرض إذ هاج مصفرّا",6,"ر",2,0],["وَقَد صارَ هَذا الناسُ إِلّا أَقَلَّهُم","ذِئاباً عَلى أَجسادِهِنَّ ثِيابُ",7,"ب",1,0],["وقد صدِئتُ ولي تحتَ الترابِ جلاً","إنَّ الترابَ لجلاَّءٌ لكلِّ صدي",8,"د",2,0],["وقد صرعت قلبي وشقّته فاعجبوا","لبيت لها في الحالتين مصرّع",9,"ع",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزيدَ الخيرِ من خيرِ مَطْلبِ",10,"ب",1,0],["وقد صُغْتُ ما التيجانُ أشباهُ بعضِهِ","وقد حِكْتُ ما أشْباهُهُ الحَبِراتُ",11,"ت",1,0],["وَقَد صارَتِ الأَسرى لِمَن يَصطَلي الوَغى","فَخابَت مِنَ الأَسرى حُبَينٌ وَيَعمَرُ",12,"ر",1,0],["وَقَد صَفّا خُدودَهُما وَبَلّا","بِبَردِ الماءِ أَجوافاً حِرارا",13,"ر",2,0],["وَقَد صَفا بَرَدى لِلريحِ فَاِبتَدَرَت","لَدى سُتورٍ حَواشيهُنَّ أَفنانُ",14,"ن",1,0],["وَقَد صُغتَ الأَسِنَّةَ مِن هُمومٍ","فَما يَخطُرنَ إِلّا في فُؤادِ",15,"د",1,0],["وَقَد صارَتِ الأَجفانُ قَرحى مِنَ البُكا","وَصارَ بَهاراً في الخُدودِ الشَقائِقُ",16,"ق",1,0],["وقد صَرَدتْ في جانبيَّ نِبالُهُ","وأولعَ بي أنيابُهُ وأظافِرُهْ",17,"ر",2,0],["وَقَد صَلُبَت عَلى ظَنِّ المُناوي","قَناةٌ آيَسَت مِن أَن تَلينا",18,"ن",2,0],["وَقَد صَدَمَت عَظيمَ الرومِ عُظمى","مِنَ الأَحداثِ قاطِعَةُ الوَتينِ",19,"ن",1,0],["وقد صَفَتْ بالزَّهرِ المُجتلى","مَوارِدُ الرَّاحِ لوُرَّادِها",20,"د",3,0],["وَقَد صَبَرت عَكٌّ وَلَخمٌ وَحِميَرٌ","لِمذحَجٍ حَتّى أَورَثوها التَنَدُّما",21,"م",2,0],["وَقَد صاغَت يَدُ الأَزهارِ تاجاً","عَلى الأَغصانِ فَوقَ الجانِبَينِ",22,"ن",1,0],["وقد صَفِرتْ كفَّايَ من رَيّقِ الصبا","ومنّيَ ملآنٌ بذكرِ الصّبا فمُ",23,"م",1,0],["وَقَد صَوَّبَ النَّسرُ المُحَلِّقُ تالِياً","أخاه ومات الليل إذْ وُلِدَ الفجرُ",24,"ر",1,0],["وَقَد صَدِئَت مِرآةُ طَرفي وَمِسمَعي","فَما أَجِدُ الأَشياءَ كَالعَهدِ فيهِما",25,"م",2,0],["وَقَد صِرتُ مَجنوناً مِنَ الحُبِّ هائِماً","كَأَنِّيَ عانٍ في القُيودِ وَثيقُ",26,"ق",1,0],["وَقَد صَدَّقتُ دَعواك","وَلا أتبَعُ إِلّاك",27,"ك",1,0],["وَقَد صنف في الحُبِّ","عَن العلمِ الَّذي صنف",28,"ف",1,0],["وَقَد صِحتُ فيآثارِ حَومٍ كَأَنَّها","عَذارى عُقَيلٍ أَو بَكارَةُ حِميَرا",29,"ر",2,0],["وَقَد صَغَتِ الجَوزاءُ حَتّى كَأَنَّها","وَراءَ نُجومٍ هاوِياتٍ وَغُوَّرِ",30,"ر",1,0],["وقد صَدّقَتْ ما ظنَّ نَفحَةَ عازِبٍ","من الرّوضِ دَلّتْهُ على الطارقِ المُلِمّ",31,"م",1,0],["وقد صَوّرَتْ نفسي ليَ الفتحَ صورةً","وشامتْهُ لي من غيرِ نظرةِ شائم",32,"م",1,0],["وَقَد صَهِلَتني مِن خَبيثِ فِعالِكُم","بَراذينُ ما يَقضِمنَ غَيرَ أَيورِ",33,"ر",1,0],["وَقَد صَدَقَت ظُنونٌ مِن رِجالٍ","تَخَفّوا ما تَوارى بِالتَخَفّي",34,"ف",2,0],["وَقَد صَدِئَت نَفسي بِجِسمي وَلُبسِهِ","فَهَل تَصطَفيها ميتَتي بِصِقالِ",35,"ل",1,0],["وَقَد صَمَتَت أَحجالُها عَن تَرَنُّمٍ","وَأَعيا غَريقاً كُظَّ أَن يَتَرَنَّما",36,"م",2,0],["وَقَد صَعِدَت عَن ذِي بِحارٍ نِساؤُهُم","كإِصعادِ نَسرٍ لا يَرُموُنَ مَنزِلا",37,"ل",2,0],["وَقَد صرعتني خطوب عدت","فَما ذم من ناظر مصرعي",38,"ي",1,0],["وقد صَدِئَتْ حتى كأنّ قَتِيرَها","عُيونُ دَبا قَيْظٍ عَمِينَ من الصّدى",39,"د",2,0],["وقد صَمَتَ الكونَ الرهيبُ ضجيجُه","على أنّهُ في صمتهِ كان أرهبا",40,"ب",2,0],["وقد صدَقوا فانَّ يديكَ تهزا","على رجليكَ إنْ نضبَ الرخاء",41,"ا",2,0],["وقد صِيح بالإخلاص نَهبْاً فلا تَرَى","سوى بؤَر التضليلِ جِسراً لعابر",42,"ر",1,0],["وقد صيحَ نهباً بالبلادِ ومُزِّقت","بظفُرٍ وداسوها بخُفٍّ ومَنْسِم",43,"م",1,0],["وقد صحبت شعوب الأرض من عرب","شمّ الأنوف إلى روم وكلدان",44,"ن",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزبدَ الخيرِ من خيرِ مَطْلبِ",45,"ب",1,0],["وقد صح مصداق الحديث فديننا","غريب كيوم الابتداء وحيد",46,"د",1,0],["وَقد صوّروا فيه شبه الثُرَيّا","كَواكِبَ تَقضي لَهُ بِالنَّجاح *",47,"ح",1,0],["وَقَد صَفت الخَيل العِتاق عَشية","كَسَطرين مَمدودين في جانِبي طرس",48,"س",1,0],["وقد صبرت على المرضين كبرا","على أن لا ترى عندي مريضه",49,"ه",1,0],["وقَد صَارَ عِندَ يَمِينِ الإِمَامِ","وذَلِكَ أمرٌ لَو استُخلِفَا",50,"ف",2,0],["وَقَد صارَحونا بِالعَداوَةِ وَالأَذى","وَقَد طاوَعُوا أَمرَ العَدوِّ المُزايِلِ",51,"ل",1,0],["وَقَد صَدَرَت تَمايَلُ كَالنَشاوى","فَهَل سُقِيَت نَجيعاً أَو رَحيقا",52,"ق",2,0],["وَقَد صارَ طَيرُ الأَمنِ فيها مُغَرِّداً","وَكانَت لِطَيرِ الذُلِّ وَالخَوفِ مَجثَما",53,"م",2,0],["وقد صدَر الكتابُ وكم عيونٍ","تراقب ما يكونَ به الجوابُ",54,"ب",1,0],["وقد صبت به البركات صبا","عليك وفضن كالديم السجام",55,"م",1,0],["وقد صنفوا في المدح فيه أكاذبا","ليستفززوا عن دينك الجاهل الغفلا",56,"ل",2,0],["وَقَد صَبَرُوا القَنا والخَيلَ حَتَّى","عَلَوناها كِرَاماً مُعذِرِينَا",57,"ن",2,0],["وقد صحّ أن الله عدل قضاؤه","وتعويجه رجلي دليل على العدل",58,"ل",1,0],["وَقَد صوّروا عَيناً لفاقدِ نورها","وَما صوّروا نوراً فما بَرِحَت عورا",59,"ر",2,0],["وقد صفتِ الآجالُ في حومةِ الوغى","وحامتْ على القومِ العُداةِ نُسورُها",60,"ر",3,0],["وَقَد صَبرنا بِأَوطاسٍ أَسِنَّتَنا","لِلَّهِ نَنصُرُ مَن شِئنا وَنَنتَصِرُ",61,"ر",1,0],["وقد صرت معتادا ببذل وانما","لكل امرىءٍ من دهره ما تعودا",62,"د",2,0],["وَقَد صَحَّ عَزمي عَلى طُهرِهِ","وَما لِيَ إِلّا عَطاياكَ ذُخرُ",63,"ر",1,0],["وقد صادفت دعوى فروق هوى لها","بقلب الخديوي وهو يقظان يرقب",64,"ب",1,0],["وقد صرّح الناي الرخيم بما نوى","لنا عن صبا نجد التجلّي يترجّم",65,"م",1,0],["وقد صحّ أنّ الله جلّ جليسهم","فيا حبّذا ذاك الجليس لذي اهتِدا",66,"د",2,0],["وَقَد صارَ مِنَ النارِ","إِلى أَطباقِها السُفلى",67,"ل",2,0],["وَقَد صارَ هَذا السُخطُ مِنكَ سَجِيَّةً","فَلَيتَكَ يَوماً بِالرِضى تَتَجَمَّلُ",68,"ل",1,0],["وقد صرت أبكي كل شيءٍ بمثله","لأني فرد في الصبابة والوجد",69,"د",1,0],["وقد صح القياس لها","بردِّ الفرع للأصلِ",70,"ل",1,0],["وقد صار بينهما نسبةٌ","فهذا يدب وذا ينعس",71,"س",1,0],["وقد صح أن الحسن لبس تأدب","اذا حاز تقوى اللّه في كل أحيان",72,"ن",1,0],["وَقَد صارَ بيت البدرِ طالع ملكهِ","وَجرت بهِ الزهراءُ مِن ذَيلِها هدبا",73,"ب",2,0],["وَقَدْ صَافَحَتْ شُهْبَ الدُّجَى شُرفاتُهُ","فَما هِيَ بَيْنَ الشُّهْبِ إلاَّ فَرَاقِدُ",74,"د",1,0],["وقد صَدِئَتْ نَفْسي بناشئةِ الورَى","فلمّا رأَتْه حُودِثَتْ بصِقال",75,"ل",1,0],["وَقَد صَفَّقَت مِمّا طَرِبنَ جَداوِلٌ","وَقَد غَرَّدَت بِالحَمدِ فيكُم حَمائِمُ",76,"م",1,0],["وقَد صُبغَت بيضُ الظُّبى بِدَمِ الطُّلى","وغُيِّرَ مِنها حُسنُها وصِقالُها",77,"ل",3,0],["وقد صارَ تخطر في حبِّه","وساوِسُ ما خِلتُ أن تَخطُرا",78,"ر",2,0],["وقد صَبَحَتهم حالةٌ لا تُصيبكم","يساوي كبيرَ القوم فيها صغيرها",79,"ر",3,0],["وقد صارتا من بعد ذاك طبيعةً","موحدةً فاحذر ضلالته التي",80,"ي",1,0],["وَقَد صَدع الهَوى مِرآة قَلبي","وَأَصدأ وَجهَها الهَم الدَخيل",81,"ل",1,0],["وقَد صارَ بِها أَشهَ","رَ من رايَة بيطارِ",82,"ر",1,0],["وقد صير الكشاف جل كلامه","مباحث تنفي كل داء وتشفيه",83,"ي",2,0],["وقد صين عن كل ابتداع وكيف ذا","وقد طيف الآفاق منه عباب",84,"ب",1,0],["وقد صَارَ يأْتِي بعد حَوْلٍ مُجرَّمٍ","كتابُكَ مَقصوراً على اللّوم والعَتْبِ",85,"ب",1,0],["وَقَد صَدَرَ الحُجّاجُ إِلّا أَقَلَّهُم","مَصادِرَ شَتّى مَوكِباً بَعدَ مَوكِبِ",86,"ب",1,0],["وقد صَدَقتْنا بالذي هو أهْلُه","ظُنونٌ بما نرجو به وعقائد",87,"د",1,0],["وقد صَدَحَتْ على الأَغصان وُرقٌ","فأغصانُ النقا إذ ذاكَ ميد",88,"د",1,0],["وقد صدقته بما عاهدت","عليه العلى جهد إيمانها",89,"ن",3,0],["وقد صَرَمَتْهُ حادِثَاتٌ كَأَنَّها","بيُمْناكَ يَا مَنْصُورُ بِيضٌ صوارِمُ",90,"م",1,0],["وَقَدْ صَدَرَتْ عَنْهُ خيولُكَ آنِفاً","وَأَحْشَاؤُهُ فَيْءٌ لَهَا ومَغانِمُ",90,"م",1,0],["وقد صمدت إلى جو وردت به","ماء كمطعم شري عند مشربه",91,"ه",1,0],["وقد صَدَقت فينا مَقالةُ شاعِر","شَددتُ حيازيمي عليها إِلى الحَشْر",92,"ر",1,0],["وقد صغته حتى كأن عواطفي","سكن به أو انه آيتي الفصحى",93,"ح",2,0],["وقد صَدقتني في الصَّبا عن مكانهم","أخابيرُ أرواحٍ سبتني نوافحا",94,"ح",2,0],["وقد صحّف العيدَ الأنام وإنما","هو العبد والموالى به بهجة العبد",95,"د",1,0],["وقد صبغت شمس العشي بلونها","صفائح نهر فالأسى ب