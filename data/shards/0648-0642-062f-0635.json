701",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139669",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101935","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"],[4755,"كَمَا يَحزَنُ المَوتُ","https://www.poetsgate.com/ViewPoem.aspx?id=183625",""],[4755,"طَلَبناكَ -يا ذا الجُودِ والفضلِ- مَوطِنا","https://www.poetsgate.com/ViewPoem.aspx?id=200019",""],[4755,"هو الآنَ يَنهارُ.. أَو يُوشِكُ","https://www.poetsgate.com/ViewPoem.aspx?id=201066",""],[4852,"خدعوني فقالوا ..","https://www.poetsgate.com/ViewPoem.aspx?id=214969",""],[4927,"العشقُ والمؤرِّخ الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=29946",""],[4978,"تشطير لنا القرآن دستورٌ","https://www.poetsgate.com/ViewPoem.aspx?id=178203",""],[5050,"أللمجد بالناس ينتظر السعدد","https://www.poetsgate.com/ViewPoem.aspx?id=38202",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[5087,"لو أعرض الناس كلهم وأبوا","https://www.poetsgate.com/ViewPoem.aspx?id=96357",""],[5150,"إلام الصمت يا عرب ..؟؟!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202873",""],[5213,"خليلي هل يدنو من الحي شاسعه","https://www.poetsgate.com/ViewPoem.aspx?id=170502",""],[5213,"ألا للّه خطبك ما أجلا","https://www.poetsgate.com/ViewPoem.aspx?id=170531",""],[5318,"\"لإربدَ\" أن تُعاتبَ ما اْستطابتْ..","https://www.poetsgate.com/ViewPoem.aspx?id=211011",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[592,"سلام عيلكم كلما ذر شارق","https://www.poetsgate.com/ViewPoem.aspx?id=128853",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"ألا بلغا من قد تسامى به الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=128830",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"أبدر تبدى في دياجي الغياهب","https://www.poetsgate.com/ViewPoem.aspx?id=128831",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5351,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=202129",""],[5358,"وداع في الليل","https://www.poetsgate.com/ViewPoem.aspx?id=21888",""],[5431,"الموناليزا السورية","https://www.poetsgate.com/ViewPoem.aspx?id=183078",""],[5431,"روما وعربي مغترب....","https://www.poetsgate.com/ViewPoem.aspx?id=208557",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5870,"مشوارٌ صَغير","https://www.poetsgate.com/ViewPoem.aspx?id=60862",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[5957,"شهد قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=30112",""],[5979,"منازل عزٍ لو يحل ابن مزنةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181358",""],[6102,"مَرارَةُ الحَقِيقَة","https://www.poetsgate.com/ViewPoem.aspx?id=182766",""],[6143,"عذرا رسول الله...","https://www.poetsgate.com/ViewPoem.aspx?id=175095",""],[6164,"أيها الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66015&r=&rc=25",""]],"verses":[["وَقَد صُقِلَ السَيفُ بَعدَ الصَدا","وَبانَ لَظى النارِ بَعدَ الدُخانِ",0,"ن",1,0],["وَقَد صاحَ بِنا المَجدُ","إِلى أَينَ إِلى أَينا",1,"ن",2,0],["وقد صَغَتِ الجَوْزاءُ والفَجْرُ ساطِعٌ","كَما لمَعَتْ رَيّا إليَّ بدُمْلُجِ",2,"ج",1,0],["وقد صَرّتِ الخَضْراءُ أخْلافَ مُزْنِها","وليسَ على الغَبْراءِ رَطْبٌ ويابِسُ",3,"س",1,0],["وَقَد صَبَرتُ عَلى قَومٍ مُنيتُ بِهم","وَما تَكَلَّمتُ إِلّا بَعدَ إِعذارِ",4,"ر",1,0],["وَقَد صادَت فُؤادَكَ إِذ رَمَتهُ","فَلَو أَنَّ اِمرَأً دَنِفاً يَصيدُ",5,"د",1,0],["وقد صوَّحت تلك الأمانيّ كلها","فحاكت نبات الأرض إذ هاج مصفرّا",6,"ر",2,0],["وَقَد صارَ هَذا الناسُ إِلّا أَقَلَّهُم","ذِئاباً عَلى أَجسادِهِنَّ ثِيابُ",7,"ب",1,0],["وقد صدِئتُ ولي تحتَ الترابِ جلاً","إنَّ الترابَ لجلاَّءٌ لكلِّ صدي",8,"د",2,0],["وقد صرعت قلبي وشقّته فاعجبوا","لبيت لها في الحالتين مصرّع",9,"ع",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزيدَ الخيرِ من خيرِ مَطْلبِ",10,"ب",1,0],["وقد صُغْتُ ما التيجانُ أشباهُ بعضِهِ","وقد حِكْتُ ما أشْباهُهُ الحَبِراتُ",11,"ت",1,0],["وَقَد صارَتِ الأَسرى لِمَن يَصطَلي الوَغى","فَخابَت مِنَ الأَسرى حُبَينٌ وَيَعمَرُ",12,"ر",1,0],["وَقَد صَفّا خُدودَهُما وَبَلّا","بِبَردِ الماءِ أَجوافاً حِرارا",13,"ر",2,0],["وَقَد صَفا بَرَدى لِلريحِ فَاِبتَدَرَت","لَدى سُتورٍ حَواشيهُنَّ أَفنانُ",14,"ن",1,0],["وَقَد صُغتَ الأَسِنَّةَ مِن هُمومٍ","فَما يَخطُرنَ إِلّا في فُؤادِ",15,"د",1,0],["وَقَد صارَتِ الأَجفانُ قَرحى مِنَ البُكا","وَصارَ بَهاراً في الخُدودِ الشَقائِقُ",16,"ق",1,0],["وقد صَرَدتْ في جانبيَّ نِبالُهُ","وأولعَ بي أنيابُهُ وأظافِرُهْ",17,"ر",2,0],["وَقَد صَلُبَت عَلى ظَنِّ المُناوي","قَناةٌ آيَسَت مِن أَن تَلينا",18,"ن",2,0],["وَقَد صَدَمَت عَظيمَ الرومِ عُظمى","مِنَ الأَحداثِ قاطِعَةُ الوَتينِ",19,"ن",1,0],["وقد صَفَتْ بالزَّهرِ المُجتلى","مَوارِدُ الرَّاحِ لوُرَّادِها",20,"د",3,0],["وَقَد صَبَرت عَكٌّ وَلَخمٌ وَحِميَرٌ","لِمذحَجٍ حَتّى أَورَثوها التَنَدُّما",21,"م",2,0],["وَقَد صاغَت يَدُ الأَزهارِ تاجاً","عَلى الأَغصانِ فَوقَ الجانِبَينِ",22,"ن",1,0],["وقد صَفِرتْ كفَّايَ من رَيّقِ الصبا","ومنّيَ ملآنٌ بذكرِ الصّبا فمُ",23,"م",1,0],["وَقَد صَوَّبَ النَّسرُ المُحَلِّقُ تالِياً","أخاه ومات الليل إذْ وُلِدَ الفجرُ",24,"ر",1,0],["وَقَد صَدِئَت مِرآةُ طَرفي وَمِسمَعي","فَما أَجِدُ الأَشياءَ كَالعَهدِ فيهِما",25,"م",2,0],["وَقَد صِرتُ مَجنوناً مِنَ الحُبِّ هائِماً","كَأَنِّيَ عانٍ في القُيودِ وَثيقُ",26,"ق",1,0],["وَقَد صَدَّقتُ دَعواك","وَلا أتبَعُ إِلّاك",27,"ك",1,0],["وَقَد صنف في الحُبِّ","عَن العلمِ الَّذي صنف",28,"ف",1,0],["وَقَد صِحتُ فيآثارِ حَومٍ كَأَنَّها","عَذارى عُقَيلٍ أَو بَكارَةُ حِميَرا",29,"ر",2,0],["وَقَد صَغَتِ الجَوزاءُ حَتّى كَأَنَّها","وَراءَ نُجومٍ هاوِياتٍ وَغُوَّرِ",30,"ر",1,0],["وقد صَدّقَتْ ما ظنَّ نَفحَةَ عازِبٍ","من الرّوضِ دَلّتْهُ على الطارقِ المُلِمّ",31,"م",1,0],["وقد صَوّرَتْ نفسي ليَ الفتحَ صورةً","وشامتْهُ لي من غيرِ نظرةِ شائم",32,"م",1,0],["وَقَد صَهِلَتني مِن خَبيثِ فِعالِكُم","بَراذينُ ما يَقضِمنَ غَيرَ أَيورِ",33,"ر",1,0],["وَقَد صَدَقَت ظُنونٌ مِن رِجالٍ","تَخَفّوا ما تَوارى بِالتَخَفّي",34,"ف",2,0],["وَقَد صَدِئَت نَفسي بِجِسمي وَلُبسِهِ","فَهَل تَصطَفيها ميتَتي بِصِقالِ",35,"ل",1,0],["وَقَد صَمَتَت أَحجالُها عَن تَرَنُّمٍ","وَأَعيا غَريقاً كُظَّ أَن يَتَرَنَّما",36,"م",2,0],["وَقَد صَعِدَت عَن ذِي بِحارٍ نِساؤُهُم","كإِصعادِ نَسرٍ لا يَرُموُنَ مَنزِلا",37,"ل",2,0],["وَقَد صرعتني خطوب عدت","فَما ذم من ناظر مصرعي",38,"ي",1,0],["وقد صَدِئَتْ حتى كأنّ قَتِيرَها","عُيونُ دَبا قَيْظٍ عَمِينَ من الصّدى",39,"د",2,0],["وقد صَمَتَ الكونَ الرهيبُ ضجيجُه","على أنّهُ في صمتهِ كان أرهبا",40,"ب",2,0],["وقد صدَقوا فانَّ يديكَ تهزا","على رجليكَ إنْ نضبَ الرخاء",41,"ا",2,0],["وقد صِيح بالإخلاص نَهبْاً فلا تَرَى","سوى بؤَر التضليلِ جِسراً لعابر",42,"ر",1,0],["وقد صيحَ نهباً بالبلادِ ومُزِّقت","بظفُرٍ وداسوها بخُفٍّ ومَنْسِم",43,"م",1,0],["وقد صحبت شعوب الأرض من عرب","شمّ الأنوف إلى روم وكلدان",44,"ن",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزبدَ الخيرِ من خيرِ مَطْلبِ",45,"ب",1,0],["وقد صح مصداق الحديث فديننا","غريب كيوم الابتداء وحيد",46,"د",1,0],["وَقد صوّروا فيه شبه الثُرَيّا","كَواكِبَ تَقضي لَهُ بِالنَّجاح *",47,"ح",1,0],["وَقَد صَفت الخَيل العِتاق عَشية","كَسَطرين مَمدودين في جانِبي طرس",48,"س",1,0],["وقد صبرت على المرضين كبرا","على أن لا ترى عندي مريضه",49,"ه",1,0],["وقَد صَارَ عِندَ يَمِينِ الإِمَامِ","وذَلِكَ أمرٌ لَو استُخلِفَا",50,"ف",2,0],["وَقَد صارَحونا بِالعَداوَةِ وَالأَذى","وَقَد طاوَعُوا أَمرَ العَدوِّ المُزايِلِ",51,"ل",1,0],["وَقَد صَدَرَت تَمايَلُ كَالنَشاوى","فَهَل سُقِيَت نَجيعاً أَو رَحيقا",52,"ق",2,0],["وَقَد صارَ طَيرُ الأَمنِ فيها مُغَرِّداً","وَكانَت لِطَيرِ الذُلِّ وَالخَوفِ مَجثَما",53,"م",2,0],["وقد صدَر الكتابُ وكم عيونٍ","تراقب ما يكونَ به الجوابُ",54,"ب",1,0],["وقد صبت به البركات صبا","عليك وفضن كالديم السجام",55,"م",1,0],["وقد صنفوا في المدح فيه أكاذبا","ليستفززوا عن دينك الجاهل الغفلا",56,"ل",2,0],["وَقَد صَبَرُوا القَنا والخَيلَ حَتَّى","عَلَوناها كِرَاماً مُعذِرِينَا",57,"ن",2,0],["وقد صحّ أن الله عدل قضاؤه","وتعويجه رجلي دليل على العدل",58,"ل",1,0],["وَقَد صوّروا عَيناً لفاقدِ نورها","وَما صوّروا نوراً فما بَرِحَت عورا",59,"ر",2,0],["وقد صفتِ الآجالُ في حومةِ الوغى","وحامتْ على القومِ العُداةِ نُسورُها",60,"ر",3,0],["وَقَد صَبرنا بِأَوطاسٍ أَسِنَّتَنا","لِلَّهِ نَنصُرُ مَن شِئنا وَنَنتَصِرُ",61,"ر",1,0],["وقد صرت معتادا ببذل وانما","لكل امرىءٍ من دهره ما تعودا",62,"د",2,0],["وَقَد صَحَّ عَزمي عَلى طُهرِهِ","وَما لِيَ إِلّا عَطاياكَ ذُخرُ",63,"ر",1,0],["وقد صادفت دعوى فروق هوى لها","بقلب الخديوي وهو يقظان يرقب",64,"ب",1,0],["وقد صرّح الناي الرخيم بما نوى","لنا عن صبا نجد التجلّي يترجّم",65,"م",1,0],["وقد صحّ أنّ الله جلّ جليسهم","فيا حبّذا ذاك الجليس لذي اهتِدا",66,"د",2,0],["وَقَد صارَ مِنَ النارِ","إِلى أَطباقِها السُفلى",67,"ل",2,0],["وَقَد صارَ هَذا السُخطُ مِنكَ سَجِيَّةً","فَلَيتَكَ يَوماً بِالرِضى تَتَجَمَّلُ",68,"ل",1,0],["وقد صرت أبكي كل شيءٍ بمثله","لأني فرد في الصبابة والوجد",69,"د",1,0],["وقد صح القياس لها","بردِّ الفرع للأصلِ",70,"ل",1,0],["وقد صار بينهما نسبةٌ","فهذا يدب وذا ينعس",71,"س",1,0],["وقد صح أن الحسن لبس تأدب","اذا حاز تقوى اللّه في كل أحيان",72,"ن",1,0],["وَقَد صارَ بيت البدرِ طالع ملكهِ","وَجرت بهِ الزهراءُ مِن ذَيلِها هدبا",73,"ب",2,0],["وَقَدْ صَافَحَتْ شُهْبَ الدُّجَى شُرفاتُهُ","فَما هِيَ بَيْنَ الشُّهْبِ إلاَّ فَرَاقِدُ",74,"د",1,0],["وقد صَدِئَتْ نَفْسي بناشئةِ الورَى","فلمّا رأَتْه حُودِثَتْ بصِقال",75,"ل",1,0],["وَقَد صَفَّقَت مِمّا طَرِبنَ جَداوِلٌ","وَقَد غَرَّدَت بِالحَمدِ فيكُم حَمائِمُ",76,"م",1,0],["وقَد صُبغَت بيضُ الظُّبى بِدَمِ الطُّلى","