76.html","الوافر"],[498,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[498,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[503,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[513,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[513,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[527,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[538,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[549,"رضيت بالدون لما لم أجد وزرا","https://www.aldiwan.net/poem47161.html","البسيط"],[549,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[549,"ما ارتبت منكم على مر الزمان فلم","https://www.aldiwan.net/poem48042.html","البسيط"],[549,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[556,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[573,"عسى أن يسر السائرين إياب","https://www.aldiwan.net/poem3102.html","الطويل"],[573,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[584,"تسلطن في الملاح بخانقي","https://www.aldiwan.net/poem17451.html","الوافر"],[584,"رشيق القامة النضره","https://www.aldiwan.net/poem17529.html","مجزوء الوافر"],[584,"يا قلب كم ذا الخفوق والقلق","https://www.aldiwan.net/poem17614.html","المنسرح"],[585,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[585,"على الدين فليبكي ذوو العلم والهدى","https://www.aldiwan.net/poem11555.html","عموديه"]],"verses":[["وَقَد صُقِلَ السَيفُ بَعدَ الصَدا","وَبانَ لَظى النارِ بَعدَ الدُخانِ",0,"ن",1,0],["وَقَد صاحَ بِنا المَجدُ","إِلى أَينَ إِلى أَينا",1,"ن",2,0],["وقد صَغَتِ الجَوْزاءُ والفَجْرُ ساطِعٌ","كَما لمَعَتْ رَيّا إليَّ بدُمْلُجِ",2,"ج",1,0],["وقد صَرّتِ الخَضْراءُ أخْلافَ مُزْنِها","وليسَ على الغَبْراءِ رَطْبٌ ويابِسُ",3,"س",1,0],["وَقَد صَبَرتُ عَلى قَومٍ مُنيتُ بِهم","وَما تَكَلَّمتُ إِلّا بَعدَ إِعذارِ",4,"ر",1,0],["وَقَد صادَت فُؤادَكَ إِذ رَمَتهُ","فَلَو أَنَّ اِمرَأً دَنِفاً يَصيدُ",5,"د",1,0],["وقد صوَّحت تلك الأمانيّ كلها","فحاكت نبات الأرض إذ هاج مصفرّا",6,"ر",2,0],["وَقَد صارَ هَذا الناسُ إِلّا أَقَلَّهُم","ذِئاباً عَلى أَجسادِهِنَّ ثِيابُ",7,"ب",1,0],["وقد صدِئتُ ولي تحتَ الترابِ جلاً","إنَّ الترابَ لجلاَّءٌ لكلِّ صدي",8,"د",2,0],["وقد صرعت قلبي وشقّته فاعجبوا","لبيت لها في الحالتين مصرّع",9,"ع",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزيدَ الخيرِ من خيرِ مَطْلبِ",10,"ب",1,0],["وقد صُغْتُ ما التيجانُ أشباهُ بعضِهِ","وقد حِكْتُ ما أشْباهُهُ الحَبِراتُ",11,"ت",1,0],["وَقَد صارَتِ الأَسرى لِمَن يَصطَلي الوَغى","فَخابَت مِنَ الأَسرى حُبَينٌ وَيَعمَرُ",12,"ر",1,0],["وَقَد صَفّا خُدودَهُما وَبَلّا","بِبَردِ الماءِ أَجوافاً حِرارا",13,"ر",2,0],["وَقَد صَفا بَرَدى لِلريحِ فَاِبتَدَرَت","لَدى سُتورٍ حَواشيهُنَّ أَفنانُ",14,"ن",1,0],["وَقَد صُغتَ الأَسِنَّةَ مِن هُمومٍ","فَما يَخطُرنَ إِلّا في فُؤادِ",15,"د",1,0],["وَقَد صارَتِ الأَجفانُ قَرحى مِنَ البُكا","وَصارَ بَهاراً في الخُدودِ الشَقائِقُ",16,"ق",1,0],["وقد صَرَدتْ في جانبيَّ نِبالُهُ","وأولعَ بي أنيابُهُ وأظافِرُهْ",17,"ر",2,0],["وَقَد صَلُبَت عَلى ظَنِّ المُناوي","قَناةٌ آيَسَت مِن أَن تَلينا",18,"ن",2,0],["وَقَد صَدَمَت عَظيمَ الرومِ عُظمى","مِنَ الأَحداثِ قاطِعَةُ الوَتينِ",19,"ن",1,0],["وقد صَفَتْ بالزَّهرِ المُجتلى","مَوارِدُ الرَّاحِ لوُرَّادِها",20,"د",3,0],["وَقَد صَبَرت عَكٌّ وَلَخمٌ وَحِميَرٌ","لِمذحَجٍ حَتّى أَورَثوها التَنَدُّما",21,"م",2,0],["وَقَد صاغَت يَدُ الأَزهارِ تاجاً","عَلى الأَغصانِ فَوقَ الجانِبَينِ",22,"ن",1,0],["وقد صَفِرتْ كفَّايَ من رَيّقِ الصبا","ومنّيَ ملآنٌ بذكرِ الصّبا فمُ",23,"م",1,0],["وَقَد صَوَّبَ النَّسرُ المُحَلِّقُ تالِياً","أخاه ومات الليل إذْ وُلِدَ الفجرُ",24,"ر",1,0],["وَقَد صَدِئَت مِرآةُ طَرفي وَمِسمَعي","فَما أَجِدُ الأَشياءَ كَالعَهدِ فيهِما",25,"م",2,0],["وَقَد صِرتُ مَجنوناً مِنَ الحُبِّ هائِماً","كَأَنِّيَ عانٍ في القُيودِ وَثيقُ",26,"ق",1,0],["وَقَد صَدَّقتُ دَعواك","وَلا أتبَعُ إِلّاك",27,"ك",1,0],["وَقَد صنف في الحُبِّ","عَن العلمِ الَّذي صنف",28,"ف",1,0],["وَقَد صِحتُ فيآثارِ حَومٍ كَأَنَّها","عَذارى عُقَيلٍ أَو بَكارَةُ حِميَرا",29,"ر",2,0],["وَقَد صَغَتِ الجَوزاءُ حَتّى كَأَنَّها","وَراءَ نُجومٍ هاوِياتٍ وَغُوَّرِ",30,"ر",1,0],["وقد صَدّقَتْ ما ظنَّ نَفحَةَ عازِبٍ","من الرّوضِ دَلّتْهُ على الطارقِ المُلِمّ",31,"م",1,0],["وقد صَوّرَتْ نفسي ليَ الفتحَ صورةً","وشامتْهُ لي من غيرِ نظرةِ شائم",32,"م",1,0],["وَقَد صَهِلَتني مِن خَبيثِ فِعالِكُم","بَراذينُ ما يَقضِمنَ غَيرَ أَيورِ",33,"ر",1,0],["وَقَد صَدَقَت ظُنونٌ مِن رِجالٍ","تَخَفّوا ما تَوارى بِالتَخَفّي",34,"ي",1,0],["وَقَد صَدِئَت نَفسي بِجِسمي وَلُبسِهِ","فَهَل تَصطَفيها ميتَتي بِصِقالِ",35,"ل",1,0],["وَقَد صَمَتَت أَحجالُها عَن تَرَنُّمٍ","وَأَعيا غَريقاً كُظَّ أَن يَتَرَنَّما",36,"م",2,0],["وَقَد صَعِدَت عَن ذِي بِحارٍ نِساؤُهُم","كإِصعادِ نَسرٍ لا يَرُموُنَ مَنزِلا",37,"ل",2,0],["وَقَد صرعتني خطوب عدت","فَما ذم من ناظر مصرعي",38,"ي",1,0],["وقد صَدِئَتْ حتى كأنّ قَتِيرَها","عُيونُ دَبا قَيْظٍ عَمِينَ من الصّدى",39,"د",2,0],["وقد صَمَتَ الكونَ الرهيبُ ضجيجُه","على أنّهُ في صمتهِ كان أرهبا",40,"ب",2,0],["وقد صدَقوا فانَّ يديكَ تهزا","على رجليكَ إنْ نضبَ الرخاء",41,"ا",2,0],["وقد صِيح بالإخلاص نَهبْاً فلا تَرَى","سوى بؤَر التضليلِ جِسراً لعابر",42,"ر",1,0],["وقد صيحَ نهباً بالبلادِ ومُزِّقت","بظفُرٍ وداسوها بخُفٍّ ومَنْسِم",43,"م",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزبدَ الخيرِ من خيرِ مَطْلبِ",44,"ب",1,0],["وَقَد صَفت الخَيل العِتاق عَشية","كَسَطرين مَمدودين في جانِبي طرس",45,"س",1,0],["وقد صبرت على المرضين كبرا","على أن لا ترى عندي مريضه",46,"ه",1,0],["وقَد صَارَ عِندَ يَمِينِ الإِمَامِ","وذَلِكَ أمرٌ لَو استُخلِفَا",47,"ف",2,0],["وَقَد صارَحونا بِالعَداوَةِ وَالأَذى","وَقَد طاوَعُوا أَمرَ العَدوِّ المُزايِلِ",48,"ل",1,0],["وَقَد صَدَرَت تَمايَلُ كَالنَشاوى","فَهَل سُقِيَت نَجيعاً أَو رَحيقا",49,"ق",2,0],["وَقَد صارَ طَيرُ الأَمنِ فيها مُغَرِّداً","وَكانَت لِطَيرِ الذُلِّ وَالخَوفِ مَجثَما",50,"م",2,0],["وقد صدَر الكتابُ وكم عيونٍ","تراقب ما يكونَ به الجوابُ",51,"ب",1,0],["وقد صبت به البركات صبا","عليك وفضن كالديم السجام",52,"م",1,0],["وقد صنفوا في المدح فيه أكاذبا","ليستفززوا عن دينك الجاهل الغفلا",53,"ل",2,0],["وَقَد صَبَرُوا القَنا والخَيلَ حَتَّى","عَلَوناها كِرَاماً مُعذِرِينَا",54,"ن",2,0],["وقد صحّ أن الله عدل قضاؤه","وتعويجه رجلي دليل على العدل",55,"ل",1,0],["وَقَد صوّروا عَيناً لفاقدِ نورها","وَما صوّروا نوراً فما بَرِحَت عورا",56,"ر",2,0],["وقد صفتِ الآجالُ في حومةِ الوغى","وحامتْ على القومِ العُداةِ نُسورُها",57,"ر",3,0],["وَقَد صَبرنا بِأَوطاسٍ أَسِنَّتَنا","لِلَّهِ نَنصُرُ مَن شِئنا وَنَنتَصِرُ",58,"ر",1,0],["وقد صرت معتادا ببذل وانما","لكل امرىءٍ من دهره ما تعودا",59,"د",2,0],["وَقَد صَحَّ عَزمي عَلى طُهرِهِ","وَما لِيَ إِلّا عَطاياكَ ذُخرُ",60,"ر",1,0],["وقد صادفت دعوى فروق هوى لها","بقلب الخديوي وهو يقظان يرقب",61,"ب",1,0],["وقد صرّح الناي الرخيم بما نوى","لنا عن صبا نجد التجلّي يترجّم",62,"م",1,0],["وقد صحّ أنّ الله جلّ جليسهم","فيا حبّذا ذاك الجليس لذي اهتِدا",63,"د",2,0],["وَقَد صارَ مِنَ النارِ","إِلى أَطباقِها السُفلى",64,"ل",2,0],["وَقَد صارَ هَذا السُخطُ مِنكَ سَجِيَّةً","فَلَيتَكَ يَوماً بِالرِضى تَتَجَمَّلُ",65,"ل",1,0],["وقد صرت أبكي كل شيءٍ بمثله","لأني فرد في الصبابة والوجد",66,"د",1,0],["وقد صح القياس لها","بردِّ الفرع للأصلِ",67,"ل",1,0],["وقد صار بينهما نسبةٌ","فهذا يدب وذا ينعس",68,"س",1,0],["وقد صح أن الحسن لبس تأدب","اذا حاز تقوى اللّه في كل أحيان",69,"ن",1,0],["وَقَد صارَ بيت البدرِ طالع ملكهِ","وَجرت بهِ الزهراءُ مِن ذَيلِها هدبا",70,"ب",2,0],["وَقَدْ صَافَحَتْ شُهْبَ الدُّجَى شُرفاتُهُ","فَما هِيَ بَيْنَ الشُّهْبِ إلاَّ فَرَاقِدُ",71,"د",1,0],["وقد صَدِئَتْ نَفْسي بناشئةِ الورَى","فلمّا رأَتْه حُودِثَتْ بصِقال",72,"ل",1,0],["وَقَد صَفَّقَت مِمّا طَرِبنَ جَداوِلٌ","وَقَد غَرَّدَت بِالحَمدِ فيكُم حَمائِمُ",73,"م",1,0],["وقَد صُبغَت بيضُ الظُّبى بِدَمِ الطُّلى","وغُيِّرَ مِنها حُسنُها وصِقالُها",74,"ل",3,0],["وقد صارَ تخطر في حبِّه","وساوِسُ ما خِلتُ أن تَخطُرا",75,"ر",2,0],["وقد صَبَحَتهم حالةٌ لا تُصيبكم","يساوي كبيرَ القوم فيها صغيرها",76,"ر",3,0],["وقد صارتا من بعد ذاك طبيعةً","موحدةً فاحذر ضلالته التي",77,"ي",1,0],["وَقَد صَدع الهَوى مِرآة قَلبي","وَأَصدأ وَجهَها الهَم الدَخيل",78,"ل",1,0],["وقَد صارَ بِها أَشهَ","رَ من رايَة بيطارِ",79,"ر",1,0],["وقد صير الكشاف جل كلامه","مباحث تنفي كل داء وتشفيه",80,"ي",2,0],["وقد صين عن كل ابتداع وكيف ذا","وقد طيف الآفاق منه عباب",81,"ب",1,0],["وقد صَارَ يأْتِي بعد حَوْلٍ مُجرَّمٍ","كتابُكَ مَقصوراً على اللّوم والعَتْبِ",82,"ب",1,0],["وَقَد صَدَرَ الحُجّاجُ إِلّا أَقَلَّهُم","مَصادِرَ شَتّى مَوكِباً بَعدَ مَوكِبِ",83,"ب",1,0],["وقد صَدَقتْنا بالذي هو أهْلُه","ظُنونٌ بما نرجو به وعقائد",84,"د",1,0],["وقد صَدَحَتْ على الأَغصان وُرقٌ","فأغصانُ النقا إذ ذاكَ ميد",85,"د",1,0],["وقد صدقته بما عاهدت","عليه العلى جهد إيمانها",86,"ن",3,0],["وقد صَرَمَتْهُ حادِثَاتٌ كَأَنَّها","بيُمْناكَ يَا مَنْصُورُ بِيضٌ صوارِمُ",87,"م",1,0],["وَقَدْ صَدَرَتْ عَنْهُ خيولُكَ آنِفاً","وَأَحْشَاؤُهُ فَيْءٌ لَهَا ومَغانِمُ",87,"م",1,0],["وقد صمدت إلى جو وردت به","ماء كمطعم شري عند مشربه",88,"ه",1,0],["وقد صَدَقت فينا مَقالةُ شاعِر","شَددتُ حيازيمي عليها إِلى الحَشْر",89,"ر",1,0],["وقد صغته حتى كأن عواطفي","سكن به أو انه آيتي الفصحى",90,"ح",2,0],["وقد صَدقتني في الصَّبا عن مكانهم","أخابيرُ أرواحٍ سبتني نوافحا",91,"ح",2,0],["وقد صحّف العيدَ الأنام وإنما","هو العبد والموالى به بهجة العبد",92,"د",1,0],["وقد صبغت شمس العشي بلونها","صفائح نهر فالأسى به يذهب",93,"ب",1,0],["وقد صرت في تكذيب رسلي موجها","لهم حجج الإبطال شأن رعيتي",94,"ي",1,0],["وقد صديت عنك المراء بما أُتي","ح من بخار من جسمانيات سفليه",95,"ي",2,0],["وقد صادمتك القارعات بصدمة","وهالك خطب الفاتكات الهجوميه",95,"ي",2,0],["وقد صار منه الجأش منعكسا بما","بدا من نعوت البارقات المراديه",95,"ي",2,0],["وَقَد صاحَبتُ إِخواناً وَلكِن","مَتى تُغنى عَنِ الشَمسِ البُدورُ",96,"ر",1,0],["وقد صِرتُ صبًّا صابَهُ الصَّبُّ من صَبا","أَحبَّائيَ المَشْغولِ فيهِمْ مَدًى بَالِي",97,"ي",1,0],["وقد صِرتُ مجبولاً على الصَّدِّ والجَفا","يَطيبُ لقلبي في الهَوَى الهجرُ والصَّدُّ",98,"د",1,0],["وقد صارَ لهوكُمْ لذي العينِ مرْجِعا","وما يفعلُ الشيطانُ وابنهُ مَرْصَدا",99,"د",2,0],["وقد صدعت بالبين قلبي وأضرمت","لهيباً تقويها به زفراتي",100,"ي",1,0],["وقد صدرت في طي ذا النظم رقعة","غدا طمعي فيها إلى خير مطمع",101,"ع",1,0],["وَقَدْ صانَ رَبُّ الْخَلْقِ أَعْلاَم عَصْرِنا","وَمَنْ قَبْلَهُمُ عَنْ مُوبِقاتِ المآثِمِ",102,"م",1,0],["وَقَد صحِبتُ وَجاورتُ الرِجالَ فَلَم","أُملُل إِخاءً وَلَم أَغدُر وَلَم أَخُنِ",103,"ن",1,0],["وَقَد صَحبتُ الّذي بالغيِّ يَأمُرُني","وبالّذي يُدنِسُ الأعراضَ يُغرِيني",104,"ي",1,0],["وقد صَلُحَتْ أيّامُكمْ باِجتِهادِهِ","فَلِمْ يومُهُ ما بَينكمْ غيرُ صالحِ",105,"ح",1,0],["وقد صَدقتُكُمُ حتّى رأيتُ لكمْ","وما كذبتكُمُ حظّاً من الكَذب",106,"ب",1,0],["وَقَد صَفِرتْ مِن كُلّ مَجدٍ أكفّهُمْ","ولم تخلُ من مجدٍ حَوَتْهُ وِطابي",107,"ي",1,0],["وقد صار ذاك الروح كل العقول وال","نفوس وأجسام الورى تتوارد",108,"د",1,0],["وقد صرت أياماً لكم وليالياً","ودهراً وساعات وكل دقيقة",109,"ه",1,0],["وقد صادَقَ الإِنجازَ منه مَواعِدٌ","كما جَانَبَ الإِخْلافَ منه جَنَابُ",110,"ب",1,0],["وقد صُحِّفَتْ جنَّاتُه أَو جِنَانُه","فقيل على رَغْمِ الحَسودِ جَنَابُه",111,"ب",2,0],["وَقَدْ صَفّتْ لهُ الأتراكُ جُنْداً","وَأَصْبَحَ رَاكباً تَحْتَ العَصَائِبْ",112,"ب",1,0],["وَقَدْ صَيَّرَني هَجْرُ","كَ في أُخْتِ ما أكْرَهْ",113,"ر",2,0],["وَقَدْ صَفا وُدُّ مِنْ كَلِفْتَ بِهِ","وَلَاحَ بَرْقُ الوِصَالِ يَأْتَلِقُ",114,"ق",1,0],["وقد صار في عيني غواشٍ وحمرة","وأوساخ ما يطفو عليها ويحجب",115,"ب",1,0],["وقد صابنا من خوفه وركوبه","غموم وأهمام عضال وأكرب",116,"ب",1,0],["وقد صار إقبال الورى واحتيالهم","على هذه الدنيا وجمع الدراهم",117,"م",1,0]]}