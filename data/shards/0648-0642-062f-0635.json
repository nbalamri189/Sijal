{"poems":[[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[63,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[63,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[47,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[72,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[72,"بروحي مهاة تفضل الشمس مطلعا","https://www.aldiwan.net/poem19234.html","الطويل"],[51,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[29,"نبئت أن الخزرجيين حافظوا","https://www.aldiwan.net/poem6084.html","الطويل"],[38,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[85,"قم ناج جلق وانشد رسم من بانوا","https://www.aldiwan.net/poem63693.html","البسيط"],[43,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[43,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[62,"أقول وصرف الدهر يحرق نابه","https://www.aldiwan.net/poem52390.html","الطويل"],[45,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[45,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[61,"قد وفت المزن بميعادها","https://www.aldiwan.net/poem51702.html","السريع"],[58,"لنا الراية الحمراء يخفق ظلها","https://www.aldiwan.net/poem30883.html","الطويل"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[80,"رعى ورق البيض الذي زهره دم","https://www.aldiwan.net/poem31308.html","الطويل"],[80,"خيالك للأجفان مثله الفكر","https://www.aldiwan.net/poem31436.html","الطويل"],[74,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[33,"ألا إن ليلى بالعراق مريضة","https://www.aldiwan.net/poem25861.html","الطويل"],[81,"شكا بالعتب مضناك","https://www.aldiwan.net/poem61407.html","الهزج"],[102,"بها لم تقع العين","https://www.aldiwan.net/poem33031.html","الهزج"],[13,"ألا عجب الفتيان من أم مالك","https://www.aldiwan.net/poem2223.html","الطويل"],[52,"أضاف إلي الليل طول تفكر","https://www.aldiwan.net/poem27011.html","الطويل"],[75,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[50,"أباهل إني حين لاح قتيري","https://www.aldiwan.net/poem63805.html","الطويل"],[46,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[46,"إذا ما عددت السن عدت بترحة","https://www.aldiwan.net/poem23210.html","الطويل"],[46,"أراك زنيما إذا تعرضت ليلة","https://www.aldiwan.net/poem23340.html","الطويل"],[8,"جهلت علي ابن الحيا وظلمتني","https://www.aldiwan.net/poem21816.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85645","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16696","الطويل"],[90,"الأصيل في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179198",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[51,"صفا لك شِربُ العيشِ غيرَ مُثَرَّبِ","https://www.poetsgate.com/ViewPoem.aspx?id=27037",""]],"verses":[["وَقَد صُقِلَ السَيفُ بَعدَ الصَدا","وَبانَ لَظى النارِ بَعدَ الدُخانِ",0,"ن",1,0],["وَقَد صاحَ بِنا المَجدُ","إِلى أَينَ إِلى أَينا",1,"ن",2,0],["وقد صَغَتِ الجَوْزاءُ والفَجْرُ ساطِعٌ","كَما لمَعَتْ رَيّا إليَّ بدُمْلُجِ",2,"ج",1,0],["وقد صَرّتِ الخَضْراءُ أخْلافَ مُزْنِها","وليسَ على الغَبْراءِ رَطْبٌ ويابِسُ",3,"س",1,0],["وَقَد صَبَرتُ عَلى قَومٍ مُنيتُ بِهم","وَما تَكَلَّمتُ إِلّا بَعدَ إِعذارِ",4,"ر",1,0],["وَقَد صادَت فُؤادَكَ إِذ رَمَتهُ","فَلَو أَنَّ اِمرَأً دَنِفاً يَصيدُ",5,"د",1,0],["وقد صوَّحت تلك الأمانيّ كلها","فحاكت نبات الأرض إذ هاج مصفرّا",6,"ر",2,0],["وَقَد صارَ هَذا الناسُ إِلّا أَقَلَّهُم","ذِئاباً عَلى أَجسادِهِنَّ ثِيابُ",7,"ب",1,0],["وقد صدِئتُ ولي تحتَ الترابِ جلاً","إنَّ الترابَ لجلاَّءٌ لكلِّ صدي",8,"د",2,0],["وقد صرعت قلبي وشقّته فاعجبوا","لبيت لها في الحالتين مصرّع",9,"ع",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزيدَ الخيرِ من خيرِ مَطْلبِ",10,"ب",1,0],["وقد صُغْتُ ما التيجانُ أشباهُ بعضِهِ","وقد حِكْتُ ما أشْباهُهُ الحَبِراتُ",11,"ت",1,0],["وَقَد صارَتِ الأَسرى لِمَن يَصطَلي الوَغى","فَخابَت مِنَ الأَسرى حُبَينٌ وَيَعمَرُ",12,"ر",1,0],["وَقَد صَفّا خُدودَهُما وَبَلّا","بِبَردِ الماءِ أَجوافاً حِرارا",13,"ر",2,0],["وَقَد صَفا بَرَدى لِلريحِ فَاِبتَدَرَت","لَدى سُتورٍ حَواشيهُنَّ أَفنانُ",14,"ن",1,0],["وَقَد صُغتَ الأَسِنَّةَ مِن هُمومٍ","فَما يَخطُرنَ إِلّا في فُؤادِ",15,"د",1,0],["وَقَد صارَتِ الأَجفانُ قَرحى مِنَ البُكا","وَصارَ بَهاراً في الخُدودِ الشَقائِقُ",16,"ق",1,0],["وقد صَرَدتْ في جانبيَّ نِبالُهُ","وأولعَ بي أنيابُهُ وأظافِرُهْ",17,"ر",2,0],["وَقَد صَلُبَت عَلى ظَنِّ المُناوي","قَناةٌ آيَسَت مِن أَن تَلينا",18,"ن",2,0],["وَقَد صَدَمَت عَظيمَ الرومِ عُظمى","مِنَ الأَحداثِ قاطِعَةُ الوَتينِ",19,"ن",1,0],["وقد صَفَتْ بالزَّهرِ المُجتلى","مَوارِدُ الرَّاحِ لوُرَّادِها",20,"د",3,0],["وَقَد صَبَرت عَكٌّ وَلَخمٌ وَحِميَرٌ","لِمذحَجٍ حَتّى أَورَثوها التَنَدُّما",21,"م",2,0],["وَقَد صاغَت يَدُ الأَزهارِ تاجاً","عَلى الأَغصانِ فَوقَ الجانِبَينِ",22,"ن",1,0],["وقد صَفِرتْ كفَّايَ من رَيّقِ الصبا","ومنّيَ ملآنٌ بذكرِ الصّبا فمُ",23,"م",1,0],["وَقَد صَوَّبَ النَّسرُ المُحَلِّقُ تالِياً","أخاه ومات الليل إذْ وُلِدَ الفجرُ",24,"ر",1,0],["وَقَد صَدِئَت مِرآةُ طَرفي وَمِسمَعي","فَما أَجِدُ الأَشياءَ كَالعَهدِ فيهِما",25,"م",2,0],["وَقَد صِرتُ مَجنوناً مِنَ الحُبِّ هائِماً","كَأَنِّيَ عانٍ في القُيودِ وَثيقُ",26,"ق",1,0],["وَقَد صَدَّقتُ دَعواك","وَلا أتبَعُ إِلّاك",27,"ك",1,0],["وَقَد صنف في الحُبِّ","عَن العلمِ الَّذي صنف",28,"ف",1,0],["وَقَد صِحتُ فيآثارِ حَومٍ كَأَنَّها","عَذارى عُقَيلٍ أَو بَكارَةُ حِميَرا",29,"ر",2,0],["وَقَد صَغَتِ الجَوزاءُ حَتّى كَأَنَّها","وَراءَ نُجومٍ هاوِياتٍ وَغُوَّرِ",30,"ر",1,0],["وقد صَدّقَتْ ما ظنَّ نَفحَةَ عازِبٍ","من الرّوضِ دَلّتْهُ على الطارقِ المُلِمّ",31,"م",1,0],["وقد صَوّرَتْ نفسي ليَ الفتحَ صورةً","وشامتْهُ لي من غيرِ نظرةِ شائم",32,"م",1,0],["وَقَد صَهِلَتني مِن خَبيثِ فِعالِكُم","بَراذينُ ما يَقضِمنَ غَيرَ أَيورِ",33,"ر",1,0],["وَقَد صَدَقَت ظُنونٌ مِن رِجالٍ","تَخَفّوا ما تَوارى بِالتَخَفّي",34,"ي",1,0],["وَقَد صَدِئَت نَفسي بِجِسمي وَلُبسِهِ","فَهَل تَصطَفيها ميتَتي بِصِقالِ",35,"ل",1,0],["وَقَد صَمَتَت أَحجالُها عَن تَرَنُّمٍ","وَأَعيا غَريقاً كُظَّ أَن يَتَرَنَّما",36,"م",2,0],["وَقَد صَعِدَت عَن ذِي بِحارٍ نِساؤُهُم","كإِصعادِ نَسرٍ لا يَرُموُنَ مَنزِلا",37,"ل",2,0],["وَقَد صرعتني خطوب عدت","فَما ذم من ناظر مصرعي",38,"ي",1,0],["وقد صَدِئَتْ حتى كأنّ قَتِيرَها","عُيونُ دَبا قَيْظٍ عَمِينَ من الصّدى",39,"د",2,0],["وقد صَمَتَ الكونَ الرهيبُ ضجيجُه","على أنّهُ في صمتهِ كان أرهبا",40,"ب",2,0],["وقد صدَقوا فانَّ يديكَ تهزا","على رجليكَ إنْ نضبَ الرخاء",41,"ا",2,0],["وقد صِيح بالإخلاص نَهبْاً فلا تَرَى","سوى بؤَر التضليلِ جِسراً لعابر",42,"ر",1,0],["وقد صيحَ نهباً بالبلادِ ومُزِّقت","بظفُرٍ وداسوها بخُفٍّ ومَنْسِم",43,"م",1,0],["وقد صدّق اللَّهُ الرجاءَ وإنما","طلبتُ مزبدَ الخيرِ من خيرِ مَطْلبِ",44,"ب",1,0]]}