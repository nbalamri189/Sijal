{"poems":[[88,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[95,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[91,"رمت للقوم نهضة في الحياة","https://www.aldiwan.net/poem44919.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54974","السريع"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[108,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[101,"بريدها التي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=16904",""],[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[165,"ملت عني لما حكاه العذول","https://www.aldiwan.net/poem4115.html","الخفيف"],[228,"ذلك الطير لم عراه ذهول","https://www.aldiwan.net/poem39724.html","الخفيف"],[242,"نور الهوى في ظلام البين هادينا","https://www.aldiwan.net/poem19090.html","البسيط"],[333,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[347,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[369,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[411,"لا تظنن بي وبرك حي","https://www.aldiwan.net/poem50041.html","الخفيف"],[470,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[580,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[580,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138435",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126911","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126751","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62464","الرمل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115950","الرمل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126649","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93553","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201975","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204703","الخفيف"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138925",""],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70398","الرمل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139966","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104306","الخفيف"],[3437,"","https://poetry.dctabudhabi.ae/diwan/poem/102029","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35610","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147273","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52193","الكامل"],[4691,"ودَادُكِ ثلجٌ أم سعير ٌ مؤججُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=124288",""],[4764,"فديت اللي تذكرني","https://www.poetsgate.com/ViewPoem.aspx?id=32579",""],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5464,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=772",""],[5693,"أنا العاصي أنا العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=37317",""],[5956,"كل شيء فيكِ يغري","https://www.poetsgate.com/ViewPoem.aspx?id=182627",""],[5956,"الأحزاب","https://www.poetsgate.com/ViewPoem.aspx?id=182754",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5956,"أنا أرجو ربي يُلْهمُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194044",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[5980,"يا أميري وسيّدي ومجيري","https://www.poetsgate.com/ViewPoem.aspx?id=146272",""],[6056,"قديمة نديمة","https://www.poetsgate.com/ViewPoem.aspx?id=130512",""],[6102,"حَبو","https://www.poetsgate.com/ViewPoem.aspx?id=182762",""],[6102,"جرش المداميك ..","https://www.poetsgate.com/ViewPoem.aspx?id=183608",""]],"verses":[["أَنا أَرثى شَمائِلاً مِنهُ عِندي","كُنَّ أَحلى مِنَ الشِهادِ المُذابِ",0,"ب",1,0],["أَنَا أَرْثِي لأُسْرَةٍ","رُكْنُهَا الرَّاسِخُ انْهَدَمْ",1,"م",1,0],["انا ارجو لهم اليك مآبا","وبودي ان لا تخيب رجاتي",2,"ت",2,0],["أَنا أَرجو إذا سَرى فيك قَومي","أن تكون الشعرى لقومي دَليلا",3,"ل",2,0],["آناً أَرَاهُ كالوِشَاحِ انْطَوَى","ثُمَّ أَرَاهُ شِبْهَ تَاجِ العَرُوس",4,"س",1,0],["أنا أرضي الفنّ لكن","كيف ترضي أنت عنّي",5,"ي",1,0],["أَنا أَرْثِيكَ شاعِراً وأَديباً","ثُمَّ أَبْكِيكَ صَاحِباً وخَلِيلاَ",6,"ل",2,0],["أنا أرجو ألاَّ يخيبَ لَهُمْ مَسْ","عىً، وألاَّ يطيشَ فيهم رجاءُ",7,"ا",2,0],["أنا أرثي للمترفين فما يبدع","إلاّ الشّقاء والأحزان",8,"ن",1,0],["أنا أرفضُ الاحسانَ من يد خالقي","قد يأخذ الاحسانُ شكلاً مُفْجِعا",9,"ع",2,0],["أَنَا أَرْضَى إن كان يُرْضيكُمُ","قتلَى وما قد لقيت منكم وألقىَ",10,"ق",2,0],["أنا أَرسلت لِلحَبيب ولكن","ليت شعري بما يَعود الرَسول",11,"ل",1,0],["أَنا أَرى بِنَظرَةٍ مِنهُ هَل يَن","شَقُّ عَنها سِتارُهُ المَسدولُ",12,"ل",1,0],["إِنَّا أَرَقُّ عِبَادِ اللهِ أَفْئِدَةً","فَلاَ تَلُمْنَا فَإِنَّ اللَّوْمَ يُرْدِينَا",13,"ن",2,0],["أنا أرنو إلى الغروب بعين","قبَست نورها من الظلمات",14,"ت",1,0],["انا اروم اندماجي","بك وعنها انفصالي",15,"ل",2,0],["أنا أرتضِي أن يُثْرَى اللُّومَاءُ في الدْ","دُنْيا ويَشكو الخِلّةَ الكُرماء",16,"ا",2,0],["أنا أرضٌ وراحتاكَ سماءٌ","والأيادي غَيْثٌ وشكُري نَباتُ",17,"ت",1,0],["أنا أرى حَدَّ عَيني، وارتِفاعَ يَدي","وأنتَ مِن مَلَكُوتِ اللهِ تَرتَشِفُ",18,"ف",1,0],["أنا أرسلت بالكتاب إليكمْ","قلت أهل الهوى سلامٌ عليكمْ",19,"م",1,0],["أَنا أَرجو وأَنت صبحيَ أَن ين","جاب ليلٌ خفيتُ منه بقَطعْ",20,"ع",1,0],["أَنا أَرجو نصري على الدّهر إِذ جئ","تَ وبَيْني دَهْرِيَ حَرْبُ",21,"ب",1,0],["انا ارتجى عند الوفاة وقد دنت","ليَ الراحة الكبرى وذي غايتي القصوى",22,"و",2,0],["أنا أرجو لكَ البقاءَ ليجني","ناشراً للبلادِ عزّاً لِواها",23,"ا",3,0],["أنا أرجو حكومة الهند تبقى","بسعودٍ وعزّةٍ لا تبارى",24,"ر",2,0],["أنا أرجو له البقاءَ فلا زا","لَ على شانِئيه يرمي شرارا",24,"ر",2,0],["أنا أرجوكم وأرجو فيصلا","وبنيه اليوم من بين البشرْ",25,"ر",1,0],["أنا أرعاهُ وإن خان الهوى","وأُدَارِيهِ ومثلى مَن رَعى",26,"ع",2,1],["أنا أرجو أن يبصر الناس في جي","شك يوم الطعان سعدا وعمرا",27,"ر",2,0],["أَنا اَرجو الدنوَّ مِنكَ وَدهري","لَم يَزَل معقبا رَجائي خَيبه",28,"ب",2,0],["إنّا ارتضينا بالبحر مُنتجَعاً","نُزجي اليكم من فضلنا السُحبا",29,"ب",2,0],["أنا أرثي في الشام عندي مقاما","كان خلداً لدي عشرين عاما",30,"م",2,1],["أنا أرجو أن لا يعد نظامي","عنده كالقصيدة الهزليه",31,"ي",2,0],["أنا أرجو أَوْ أخشى","سطوة من سطواتكْ",32,"ك",1,0],["إنا أردنا إن رعبنا قومنا","فيكم فيرجعُ من مضى بتزيّدِ",33,"د",1,0],["أنا أرجو منك الجنان فما مق","دار دنياً سريعة الاخلاق",34,"ق",1,0],["أنا أرعى عهود كل صديق","واليف وإن أطال جفاه",35,"ا",2,0],["أَنا أَرعاهُ مُكرّما وَبِقَلبي","مِنهُ ما يُتلِف الحَياةَ أَقَلّه",36,"ل",2,0],["أنا ارتضيت بما أهداه لي قدري","أما الخلائق أحرار لمن سجدوا",37,"د",3,0],["آناً أراها جنةً فينانة","وأراكمُ يا سادتي الأزهارا",38,"ر",2,0],["أنا أرتقي فيهِ الجبالَ مطامحاً","فلا تنقذيني حينما أتدحرجُ !!",39,"ج",1,0],["انا ارسل بريدي له ،، حروفٍ منه مسحوره","عسى يكفي عطش حرفي يبين صدق وجداني",40,"ن",2,0],["أنا أرقي بنت البيان ابتكارا","وترقي بنت الدنان اصطناعا",41,"ع",2,0],["أنا أرضى بالذي قَلَّ ودَلْ","خيمةٌ في وطني دونَ وَجَلْ",42,"ل",1,1],["أنا أرنو لحضرته","صلاة الجمع مقياسي",43,"س",2,0],["‏ ‏أنا أرجو لي قريناً","‏ ‏ خالياً من أي شرِّ",44,"ر",1,0],["أنا أرجو وحدة للأرض لا أر","ضَى بتفريق وتحزيب كريهِ",45,"ي",2,0],["أنا أرجو منك تحريكاً شُجاعاً","لجباناتي لأغدو كالفهودِ",46,"د",1,0],["أنا أرجو ربي يُلْهمُهُ","أن يعلمَ ما لا أعْلمُهُ",47,"ه",1,1],["أنا أرتين المشاغِبْ","أنا فعّالُ العجائبْ",48,"ب",1,1],["أنا أرتين المغذى","بالسَّحالي والعقاربْ",48,"ب",1,0],["أنا أرتينٌ الذي في كل جانب","لي حقوق ومطالبْ",48,"ب",1,0],["أنا أرتين ُالمفدى","لستُ في التخطيط راسبْ",48,"ب",1,0],["أنا أرجوك أن أكون نديماً","أو خديماً أو عبد عبد لعبدك",49,"ك",1,0],["أنا ارتكبت ! بحق نفسي جريمة","ذليّتها لك ! وإنحنى لأجلك الراس",50,"س",1,0],["أَنا أَرَقُّ القُلُوبِ؛ اللَّهُ يَعلَمُ بِي","وَيَعلَمُ اللَّهُ أَلَّا أُمَّ لِي, وَأَبا",51,"ب",2,0],["أَنَا ارتِدادُ الصَّدَى فَوقَ المَدَارِجِ مُذ","تَرَكتِني - لِالتِياثِي - عالِقًا فِيكِ",52,"ك",1,0]]}