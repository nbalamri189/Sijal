{"poems":[[72,"يا قضيبا من لجين","https://www.aldiwan.net/poem42676.html","مجزوء الرمل"],[68,"صال فينا الردى جهارا نهارا","https://www.aldiwan.net/poem40126.html","الخفيف"],[68,"يا قضيبا ذوى وكان نضيرا","https://www.aldiwan.net/poem40295.html","الخفيف"],[46,"يا قضيبا لا يدانيه","https://www.aldiwan.net/poem30279.html","مجزوء الرمل"],[33,"يا قضاة العباد إن عليكم","https://www.aldiwan.net/poem42665.html","الخفيف"],[50,"يا قضيبا في كثيب","https://www.aldiwan.net/poem10802.html","مجزوء الرمل"],[50,"قل لذي الطرف الخلوب","https://www.aldiwan.net/poem10816.html","مجزوء الرمل"],[78,"صدعت قلبي صدع الزجاج","https://www.aldiwan.net/poem39471.html","المديد"],[203,"يا طير ما للنوم قد طارا","https://www.aldiwan.net/poem45627.html","السريع"],[228,"نظر النيل والمدامع تهمي","https://www.aldiwan.net/poem41910.html","الخفيف"],[228,"كيف قوضتم بناء القضاء","https://www.aldiwan.net/poem41913.html","الخفيف"],[240,"يا قضيبا إذا انثنى","https://www.aldiwan.net/poem31897.html","مجزوء الخفيف"],[309,"زارني بعد الجفا ظبي النجود","https://www.aldiwan.net/poem16824.html","الرمل"],[438,"أنا من عينيك نشوان","https://www.aldiwan.net/poem12743.html","المديد"],[580,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"],[591,"ما عهدنا كذا تكون الرفاق","https://www.aldiwan.net/poem17612.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122609","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63861","الخفيف"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118078","الخفيف"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93092","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108517","الرمل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74992","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115795","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65357","الخفيف"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31691","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86478","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127221","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136805",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81276","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73429","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33397","الخفيف"],[5111,"يا قُضَاةً","https://www.poetsgate.com/ViewPoem.aspx?id=212529",""],[5436,"صبر ايوب / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177648",""],[5491,"رفيقة الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=197550",""],[5785,"لا رعى الله من بالجفا والهجر شار","https://www.poetsgate.com/ViewPoem.aspx?id=131574",""],[6069,"من لصبٍ مسه فرط الكمد","https://www.poetsgate.com/ViewPoem.aspx?id=105660",""],[6251,"الهديل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76469&r=&rc=9",""]],"verses":[["يا قَضيباً مِن لُجَينِ","يا مَليحَ المُقلَتَينِ",0,"ن",1,1],["يا قَضيباً ذَوى وَصَوَّحَ لَمّا","أَظهَرَ الزَهرُ غُصنَهُ وَالثِمارا",1,"ر",2,0],["يا قَضيباً ذَوى وَكانَ نَضيرا","ما رَأَينا لَهُ الغَداةَ نَظيرا",2,"ر",2,1],["يا قَضيباً لا يُدانيهِ","مِنَ الإِنسِ قَضيبُ",3,"ب",1,1],["يا قُضاةَ العِبادِ إِنَّ عَلَيكُم","في تُقى رَبِّكُم وَعَدلِ القَضاءِ",4,"ا",2,1],["يا قَضيباً في كَثيبِ","تَمَّ في حُسنٍ وَطيبِ",5,"ب",1,1],["يا قَضيبَ البانِ يَهتَز","زُ عَلى دِعصِ كَثيبِ",6,"ب",1,0],["يَا قضيباً فَوْقَ دِعْصِ نقا","وَكثيباً تَحْتَ تِمثالِ عاجْ",7,"ج",1,0],["يا قضاةَ الغرامِ في أيِّ شرعٍ","أن يحولوا بينَ الحبيبِ وبيني",8,"ي",1,0],["يا قُضاةً ظَلَمتُمُ العَدلَ مرّه","فَاِسمَعوا اليَومَ في القَضِيَّةِ أَمرَه",9,"ه",1,0],["يا قضاةً ظَلمتُمُ العَدلَ حَتّى","تَرحَموا الحُسنَ في عُيونِ النِساءِ",10,"ا",2,0],["يا قَضاةً وَالعَدلُ أَعظَمُ ركنٍ","لِمَسيرِ النظامِ في الغَبراءِ",10,"ا",2,0],["يا قَضيباً إِذا اِنثَنى","وَهِلالاً إِذا أَضا",11,"ض",2,1],["يا قضيباً يتمايل في كثيب","عندما هبت له ريح الجنوب",12,"ب",1,0],["يا قضيباً كلُّ زاهرةٍ","واجهَتْنا منه بستانُ",13,"ن",1,0],["يا قضِيباً يميسُ سُكْراً وَدلاًّ","وأَرَاهُ يَمِيسُ همّاً وَوَجْدا",14,"د",2,0],["يا قَضِيباً تَهزُّهُ نَشواتٌ","زُرْ مُحبّاً تَهزُّهُ الأَشْواقُ",15,"ق",1,0],["يا قَضيباً مِن فِضَّةٍ يُقطفُ النَّر","جَسُ مِن وجنَتَيهِ والجلّنارُ",16,"ر",1,0],["يا قضيباً يهتزُّ فوقَ كثيبٍ","كلما ملَّ كثرةَ الهزِّ هَزَّهْ",17,"ز",2,1],["يا قضيب الأراك عند التثني","هز عطفيه حين ماسَ الشبابُ",18,"ب",1,1],["يا قضاء الله والموت الذي","ما قضى الموت عليه لو أبى",19,"ب",2,0],["يا قضاة الشرع باهوا","عندكم فصل الخطاب",20,"ب",1,1],["يا قضاة الهَوى علمتم بأمري","إن لي منه رقة واِصفرارا",21,"ر",2,0],["يا قضيباً إذا تثنّى","وغزالاً إذا رنا",22,"ن",2,1],["يا قضيبا أتي بأزهار ورد","وكذلك القضيبُ يعرفُ حقّه",23,"ه",1,1],["يا قَضيباً يَميسُ تَحْتَ هِلالٍ","وهِلالاً يَرْنو بِعَيْنَيْ غَزالِ",24,"ل",1,1],["يا قضيباً بقده أن تثنى","وكثيباً بردفه أن ترجرج",25,"ج",1,0],["يا قضيبا مهفهفا","ينعش الروح ظله",26,"ه",1,1],["يا قضيب الذهب","شنف لي الكاس بشرب",27,"ب",1,1],["يا قَضاء رَمى فَأقصد قَلب الدَ","هر في قُدسِهِ وَفي كِبرِيائه",28,"ا",3,0],["يا قَضيباً حامِلاً بدرَ الدُّجى","رَبُّهُ بالحُسنِ قَد كَمَّلهُ",29,"ل",2,0],["يا قضيباً ريانَ يهتزُّ نصفاً","وكثيباً يحادِثُ الخصرَ نِصفا",30,"ف",2,0],["يَا قُضَاةً فِيْ فُؤَادِيْ","أيَّ ذَنْبٍ أقَرَفَا ؟'",31,"ف",2,1],["ياقضاة افي العيون رماد","فانظروا الفعل والدليلُ جليُّ",32,"ي",1,0],["يا قُضاةَ الحُبِّ هَيّا أقبلوا","أنقذوا من سَوطهِ هذي العَشِيقَه",33,"ق",2,0],["ياقضاة الهوى أنصفوا طار الشجار","أنجزوا حكم في طي قرطاس",34,"س",1,0],["يا قضيباً ماس في دعص نقاً","وغزالاً بين جفنيه أسد",35,"د",1,0],["ياقُضَاةَ القُلوبِ أيُّ القَضَايَا","مِثْلُهَا في الهَوى قَضِيةُ قَلْبِي",36,"ب",2,1]]}