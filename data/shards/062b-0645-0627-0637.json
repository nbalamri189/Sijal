{"poems":[[49,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[64,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[63,"أنخت في حانة أترجة","https://www.aldiwan.net/poem51730.html","السريع"],[46,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[92,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[376,"لبى هواكم فابتدى يكتم","https://www.aldiwan.net/poem57110.html","السريع"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[505,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[556,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66705","الخفيف"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204061","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128231","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131253",""],[4656,"","https://poetry.dctabudhabi.ae/diwan/poem/98048","الكامل"],[669,"قائل للنبي إني غريب","https://www.poetsgate.com/ViewPoem.aspx?id=19356",""],[5198,"ليل داجي","https://www.poetsgate.com/ViewPoem.aspx?id=136228",""],[5652,"يمه حنيني بالمعاني يناجيك","https://www.poetsgate.com/ViewPoem.aspx?id=192042",""]],"verses":[["ثُمَّ اِطَّباهُ ضارِجٌ فَبارِقُه","إِلى مُلَثٍّ لَم يَكُس يُفارِقُه",0,"ق",2,0],["ثم أطل عذابها في النارِ","مطروحة في جاحم الأوارِ",1,"ر",1,0],["ثم اطَّرَحْنا الدِّينَ في بيتِها","حتى انسلَخْنا منه أيَّ انسلاخْ",2,"خ",1,0],["ثُمَّ اِطَّرَحتُم قَراباتي وَآصِرَتي","حَتّى تَوَهَّمتُ أَنّي مِن بَني أَسَدِ",3,"د",1,0],["ثم اطلِعي من كلِّ زاوية","ذاك الجبينَ ووجهَه الطَلِقا",4,"ق",2,0],["ثم اطمأن بنا التعريف بعداذ","في موقف جمع السادات وَالكبرا",5,"ر",2,0],["ثمَّ اطَّرَحناهُ ومَجفُونَه","فصارَ لا مِنَّا ولا مِنكُمُ",6,"م",1,0],["ثم أطار الدجى فطارت","به جناحا غرابِ بينِ",7,"ن",1,0],["ثمَّ اطْرَحيني ضمنَ ذَيَّاكَ الحِمى","وكون كلِّ الحادثاتِ فاطرحي",8,"ح",2,0],["ثمَّ أطاب وَسَنِي","لمّا أطار وَسَنَهْ",9,"ن",2,0],["ثمّ اطفي المصباحَ كي لا يراني","فأخلّي طعامَه موفورا",10,"ر",2,0],["ثم اطَّلعت على الكتاب فكدت من","قلقٍ له أطفا ولا يدرى بي",11,"ب",2,0],["ثم أطربني بأشعار العجم","واطردن هماً على قلبي هجم",12,"م",1,0],["ثم اطلق في الناس سيفك حتى","تخضع العالمين بيضاً وسودا",13,"د",2,0],["ثمّ اِطّلعنَ كأنّهنَّ حمائمٌ","زمنَ الربيعِ هَممن بِاِستهلالِ",14,"ل",1,0],["ثم اطفئي المصباح كي لا يراني","فاخلي طعامه موفورا",15,"ر",2,0],["ثم اطلب الله رحمته واطلب العون","ياآرب زيًن منهجي وانتهاجي",16,"ج",2,0],["ثم اطلبي كلي فدا وطي رجليك","ياجنتي هذي سماتك سماتي ..!!",17,"ت",2,0]]}