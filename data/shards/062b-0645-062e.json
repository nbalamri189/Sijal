{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[90,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[53,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[94,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[64,"ملنا إلى النشر الذي تلتقي","https://www.aldiwan.net/poem52394.html","السريع"],[71,"بالله يا سائق الجمال","https://www.aldiwan.net/poem28358.html","مخلع البسيط"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[92,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[96,"وذرني أحيّي الصباحا","https://www.poetsgate.com/ViewPoem.aspx?id=15649",""],[261,"من شروط الصبوح في المهرجان","https://www.aldiwan.net/poem48463.html","الخفيف"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20580","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104990","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205812","الخفيف"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103195","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118774","الرجز"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36769","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36791","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88573","الخفيف"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141841","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133115","المجتث"],[4747,"رسالة إلى صدام","https://www.poetsgate.com/ViewPoem.aspx?id=17213",""],[5120,"ضَوْءٌ","https://www.poetsgate.com/ViewPoem.aspx?id=186010",""],[5136,"قل لمن يشكو سقاماً شفه","https://www.poetsgate.com/ViewPoem.aspx?id=121507",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5463,"نامي وزيدي المنام","https://www.poetsgate.com/ViewPoem.aspx?id=25790",""],[6124,"ما لقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=159899",""]],"verses":[["ثُمَّ خَيلٌ مِن بَعدِ ذاكَ مَعَ الغَ","لّاقِ لا رَأَفَةٌ وَلا إِبقاءُ",0,"ا",2,0],["ثُمَّ خَلَّفتَ بِالكِنانَةِ أَبطا","لاً كُهولاً أَعِزَّةً وَشَبابا",1,"ب",2,0],["ثم خابت ظنونهم فيه لَما","مرّ في الجوّ خُلَّباً وجَهاما",2,"م",2,0],["ثم خلّاه وأهدى قلبه","للتباريح وأنْضى بدنه",3,"ن",2,0],["ثمَّ خَلَّفْتَني وحيداً فريداً","بَيْنَ داعٍ من الرِّياحِ ونَاهِ",4,"ه",1,0],["ثُمَّ خانَ التاجُ وُدَّ المَفرِقِ","وَنَبَت بِالأَنجُمِ الزُهرِ الدِيار",5,"ر",1,0],["ثم خلعْنا لُجُمَ الخيلِ في","رياضهِ المونقةِ الناضِرَه",6,"ر",2,0],["ثمَّ خلعْتُ به عذاري","لما غدا لابسَ الجمالِ",7,"ل",1,0],["ثم خيلٌ من بعد ذاك مع الفلا","ق لا رأفةٌ ولا إبقاء",8,"ا",2,0],["ثم خَفِّضْ من جَناحيك بها","ثم أبلغْها إذا شِئتَ \" مقالاً \" !",9,"ل",2,0],["ثمّ خذني إليك يا موت جذلان","طروبا إلى الردى مرتاحا",10,"ح",2,0],["ثم خفق الطبول بين الأغاني","واصطكاك الأوتار في العيدان",11,"ن",1,0],["ثُمّ خافَتْ لمّا رأتْ أنجمَ الّلي","لِ شَبيهاتِ أعيُنِ الرُّقبَاء",12,"ا",2,0],["ثُمَ خَفّوا عِندَ ذاكُم رُقَّصا","رَقَصَ الحَفّانِ يَعلو في الجَبَل",13,"ل",1,0],["ثم خلف المقام فاركع إذا","أطقت وألحق بعد الركوع سؤالا",14,"ل",2,0],["ثم خبِّره أن لي منه شكوى","غير أنّي شكوت منه إليه",15,"ه",1,0],["ثمَّ خُرِاسَانٍ معَ الجَنوبِ","منَ العِرَاقَينِ على التهذيبِ",16,"ب",1,0],["ثم خلفتُها وقد أطرقتْ حز","نا وأطرقتُ من جوى البلبال",17,"ل",1,0],["ثم خذني بالشكر يا ابن سليم","حيث كانت داري في البلدان",18,"ن",1,0],["ثم ختام المرشدين مصطفى","عرف بالخوجا وكان ذا صفا",19,"ف",2,0],["ثم خلا حاشا ومثلها عدا","إن كان من ما لفظها تجردا",20,"د",2,0],["ثُم خُصُّوا قاضي العَساكر مِنهُ","ثُمَّ عُمّوا الفَقير مِنهُ بِخَرجِ",21,"ج",1,0],["ثُمَّ خَصَّ الكاتِبَ الحَب","رَ بِأَنواعِ الكَمالِ",22,"ل",1,0],["ثُمَّ خَتماً لَهُ ولَم تَألُ نُصحَا","وإِذَا الأنبياءُ سَاوَوكَ مَدحَا",23,"ح",2,0],["ثم خاصرتُها إلى القبّة الخض","راء تمشي في مرمرٍ مسنونِ",24,"ن",1,0],["ثم خطت بالنصر منه سجلاً","رملته بأحسن اللازوردي",25,"د",2,0],["ثُم خرّاجٌ وولّاجٌ طَبِن","فكِهٌ بل مِذيلٌ يأبى السكر",26,"ر",1,0],["ثم خطك نديم","وافى لقصد الإشاره",27,"ه",1,0],["ثم خل غيره يشوف ويعتبر خله","واللي يبي مثلها بالحال تثنى له",28,"ل",2,0],["ثُمَّ خُضْتُ الْحُرُوبَ تِلْوَ حُرُوبٍ","بِجُيُوشِي، وَ الصَّافِنَاتِ النِّطَاحِ",29,"ح",1,0],["ثم خذ نصفاً ونصفاً هذه","للذي تهوى فذا طب القلوب",30,"ب",1,0],["ثم خروا على الجباه سجودا","لأخيهم في عرشه والعلاء",31,"ا",2,0],["ثُمَّ خَانوهُ تُجَاذِبُهُمْ","سَالِفَاتُ الثَّأْرِ بِالْحَرَدِ(١٨)",32,"د",1,0],["ثمّ خلّي عنك قصة \" هالمفارق \" و\" الخصام \"","لأن هذي يا حياتي في حياتي شي كبير",33,"ر",1,0],["ثمَّ خلُّوا الزيتَ منهُ","كي يظلَّ العمرَ في قبوِ المطارح.",34,"ح",1,0]]}