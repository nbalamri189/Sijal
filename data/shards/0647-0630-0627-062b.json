{"poems":[[56,"لم آت مطلبا إلا بمطلب","https://www.aldiwan.net/poem27360.html","البسيط"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[53,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[99,"قل للذين بكوا على شوقي","https://www.aldiwan.net/poem24774.html","أحذ الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[104,"لي بالحياة تعلق وتشدد","https://www.aldiwan.net/poem33119.html","الكامل"],[50,"يا أيها المطنب ذا الغرور","https://www.aldiwan.net/poem63413.html","الرجز"],[240,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[325,"هات اسقني من رائق الصهباء","https://www.aldiwan.net/poem67192.html","الكامل"],[434,"لا يبعدن قومي الذين هم","https://www.aldiwan.net/poem766.html",""],[447,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[520,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[567,"كادت تذوب ثغور البحر من حسد","https://www.aldiwan.net/poem52927.html","البسيط"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198605","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64075","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63990","البسيط"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18688","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105014","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132790","السريع"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100186","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85054","السريع"],[4961,"زهرةُ آخرِالأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=40463",""],[5213,"قل للذين استبدوا في زمانهم","https://www.poetsgate.com/ViewPoem.aspx?id=170566",""],[5408,"إليّ ولا أحد","https://www.poetsgate.com/ViewPoem.aspx?id=190738",""]],"verses":[["هَذا ثَنائي وَهَذي مِصرُ سانِحَةٌ","وَأَنتَ أَنتَ وَقَد نادَيتُ مِن كَثَبِ",0,"ب",1,0],["هذا ثَنَائي على الدِيارِ وقد","تأخذُ مني الدِيارُ والنَّسَبُ",1,"ب",1,0],["هذا ثنائي وهاتيكُم مناقبُكم","بأعين الناس ما أبْعدتُ إشهادي",2,"د",2,0],["هذا ثَرى مصرَ الكريمُ وكم","أكرمتَهُ وأشدتَ بالذكرِ",3,"ر",1,0],["هَذا ثَنائِي وَإِن قَصَّرتُ فيهِ فَلي","عُذرٌ وَأَينَ السُّها مِن كَفِّ مُستَلِمِ",4,"م",1,0],["هَذا ثَرى مَصرَ الَّتي أَحببتها","نَم هادِئاً يا سَعدُ طابَ المرقد",5,"د",1,0],["هَذا ثَناءُ حُسنِها المَشهورِ","يا حُسنَها فَوقَ أَعالي الدورِ",6,"ر",1,0],["هَذا ثَناءُ أَخي وَلا","ءٍ وَدُّهُ مَحضٌ سَليمُ",7,"م",1,0],["هَذا ثَنا عَبدُ اللَطيفِ يَبُثُّهُ","بِالحَمدِ مَشفوعاً وَحُسنُ دُعاءِ",8,"ا",2,0],["هَذا ثَنائي ما بَقَيتُ لَهُم","فَإِذا هَلَكتُ أَجَنَّني قَبري",9,"ر",2,0],["هذا ثناي عليك واللَه الذي","أثنى عليك بما يقول ورتل",10,"ل",1,0],["هذا ثناء أنظقته صنائع","ملك الجميل بها جميل ثنائي",11,"ا",2,0],["هذا ثناء غريق في نَداكَ يَرَى","ثَناكَ في الشِّعرِ مثلَ الرُوحِ في الجسَدِ",12,"د",1,0],["هذا ثناء محق في شهادته","إلى جنابكم الميمون منتسب",13,"ب",1,0],["هذا ثنائي وشعري فيك زَخْرَفَهُ","صدقُ الثناءِ من المُنْشي وَنَمَّقَه",14,"ق",2,0],["هذا ثنائي وأنتم هاشمٌ وبكمْ","رأسُ الثناء من المثنين يَرْتَفِع",15,"ع",1,0],["هَذا ثَنائي بِما أَولَيتَ مِن حَسَنٍ","لا زِلتَ عَوضُ قَريرَ العَينِ مَحسودا",16,"د",2,0],["هذا ثري يحمي حماه حيدر","يخشى نكيرٌ من لقاه ومنكر",17,"ر",1,1],["هذا ثنائي والنظام البديع","تزهو كما يزهو رياض الربيع",18,"ع",1,0],["هذا ثرى حط الأثير لقدره","لوعزه هام الثريا يخضع",19,"ع",1,1],["هذا ثقيل مثل عذاله","وذاك في خفته عقل لاح",20,"ح",1,0],["هذا ثراؤكِ في علم ٍ وفي أدبٍ","هيهاتَ يخلقُ فيكِ الجزرَ والنضبا",21,"ب",2,0],["هذا ثريا وقد شقت كواكبه","وهي الثواقب تردي كل شيطان",22,"ن",1,0],["هذا ثراي ثرى العراق بكلّه","كلي وكلي تهتُ في الزمن الردي",23,"د",2,0]]}