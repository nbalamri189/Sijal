{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[53,"دوام الهوى في ضمان الشباب","https://www.aldiwan.net/poem30745.html","المتقارب"],[53,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[9,"ألا حي ميا إذ أجد بكورها","https://www.aldiwan.net/poem21932.html","الطويل"],[73,"في جواركم الذليل","https://www.aldiwan.net/poem11933.html","الوافر"],[35,"لعمري لقد رعتم غداة سويقة","https://www.aldiwan.net/poem39133.html","الطويل"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[30,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[30,"ألا يا اسلمي يا دار مي على البلي","https://www.aldiwan.net/poem29589.html","الطويل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"وماء جلت عن حر صفحته القذى","https://www.aldiwan.net/poem62882.html","الخفيف"],[91,"أحب إله في صباه إلاهة","https://www.aldiwan.net/poem8744.html","عموديه"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[28,"تقول ابنة الغوثي ما لك ههنا","https://www.aldiwan.net/poem1290.html",""],[28,"وأطلس عسال وما كان صاحبا","https://www.aldiwan.net/poem5628.html","الطويل"],[61,"لنا روضة في الدار صيغ لزهرها","https://www.aldiwan.net/poem51554.html","الطويل"],[66,"البيض دون لحاظ الأعين السود","https://www.aldiwan.net/poem39930.html","البسيط"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[80,"وأبيض تحسب فيه الفرند","https://www.aldiwan.net/poem31325.html","المتقارب"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[74,"أرقت وقد نام الخلي لنازح","https://www.aldiwan.net/poem12977.html","الطويل"],[52,"ألا حي من أهل المحبة منزلا","https://www.aldiwan.net/poem26719.html","الطويل"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[50,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[50,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[46,"وجدت سواد الرأس تقلب لونه","https://www.aldiwan.net/poem23444.html","الطويل"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/12322","الطويل"],[31,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""]],"verses":[["وَماءٌ تَشيهِ الريحُ كُلَّ عَشِيَّةٍ","كَما رَقَمَ البُردَ الصَبيغَ يَماني",0,"ي",1,0],["وَماءٍ قَد تَخَفَّرَ بِالدَياجي","عَنِ الطُرّاقِ وَالسَلَمِ المُقيمِ",1,"م",1,0],["وَماءٍ وَرَدتُ عَلى كورِها","وَعَرَّجتُ عَنهُ قَتيلَ الأُوامِ",2,"م",1,0],["وَماءٌ يُضارِعُ خَيطَ السَقاءِ","وَيُرمى بِهِ في وُجوهِ الشِعابِ",3,"ب",1,0],["وَماءٍ تُصارِعُهُ بِالرِكابِ","وَجَيشٍ تُقارِعُهُ بِالقَنا",4,"ا",1,0],["وَماءٍ صَرىً لَم أَلقَ إِلّا القَطا بِهِ","وَمَشهورَةَ الأَطواقِ وُرقاً نُحورُها",5,"ر",3,0],["وَماءُ العَيشِ بَينَهُمُ فَضيضٌ","وَظِلُّ الأَمنِ فَوقَهُمُ ظَليلُ",6,"ل",1,0],["وَماءٍ كَأَنَّ اليَثرَبِيَّةَ أَنصَلَت","بِأَعقارِهِ دَفعَ الإزاءِ نَزوعِ",7,"ع",1,0],["وَماءٍ هَتَكتُ الدِمنَ عنَهُ وَلَم تَرِد","رَوايا الفِراخِ وَالذئابِ اللَغاوِسُ",8,"س",1,0],["وَماءٍ كَماءِ السُخدِ لَيسَ لِجَوفِهِ","سَواءَ الحَمامِ الوُرقِ عَهدٌ بِحاضِرِ",9,"ر",1,0],["وَماءٍ تَجافى الغَيثُ عَنهُ فَما بِهِ","سَواءَ الحَمامِ الحُضَّنِ الخُضرِ حاضِرُ",10,"ر",1,0],["وَماءٍ كَلَونِ الغِسلِ أَقوى فَبَعضُهُ","أَواجِنُ أَسدامٌ وَبَعضٌ مُعَوَّرُ",11,"ر",1,0],["وَماء هَتَكتُ الدِمنَ عَن آجِناتِهِ","بِأَسارِ أَخماسٍ جَماجِمُها صُعرُ",12,"ر",1,0],["وَمآءٍ صَرىَ عافي الثَنايا كَأَنَّهُ","مِنَ الأَجنِ أَبوالُ المَخاضِ الضَوارِبِ",13,"ب",1,0],["ومَاءٍ كفَقْدِ الماءِِ أعْلاَهُ عَرْمَضٌ","وأسْفَلُهُ لِلمُستَمِيحينَ حَرْمَدُ",14,"د",1,0],["وماءٍ جلتْ عن حُرِّ صفحته القذى","من الريحِ معطارُ الأصائل والبُكرِ",15,"ر",1,1],["وَماءً يَموجُ وَلا جَدوَلٌ","وَناراً بِلا حَطَبٍ تَستَعِر",16,"ر",1,0],["وَماءٍ تُصبِحُ الفَضَلاتُ مِنهُ","كَخَمرِ بُراقَ قَد فَرَطَ الأُجونا",17,"ن",2,0],["وَماءَ كُلِّ مُسبِلٍ هَطّالِ","يا أَقدَرَ السُفّارِ وَالقُفّالِ",18,"ل",1,0],["وَماءٍ كَأَنَّ الغِسلَ خيضَ صَبيبُهُ","عَلى لَونِهِ وَالطَعمِ يَعبِسُ شارِبُه",19,"ب",2,0],["وَماءُ سَدىً مِن آخِرِ اللَيلِ أَرزَمَت","لِعِرفانِهِ مِن آجِنٍ وَدِفانِ",20,"ن",1,0],["وماءٍ حكى أشعارَ حَمْدٍ ببَردِه","ولكنَّه مَحياً وتلكَ حُتوفُ",21,"ف",1,0],["وَماءِ وَجهٍ غَدا بِالنورِ مُتَّقِداً","كَأَنَّ في كُلِّ خَدٍّ نارَ أُخدودِ",22,"د",1,0],["وَماءُ حَياءٍ لَيسَ يَنقَعُ غُلَّةً","وَنارُ خُدودٍ لِلجَوانِحِ تَلفَحُ",23,"ح",1,0],["وماءً به شرقاتُ الردى","تمَيّعَ في قَبَسٍ مُشْعلِ",24,"ل",1,0],["وَماءٍ بِمَوماءٍ قَليلٍ أَنيسُهُ","بَسابِسَ لَم يَحدُث بِهِ الصَيفَ مَحضَرُ",25,"ر",1,0],["وَماءً بِوادي الغَضا سَلسَلاً","وَمُرتَبَعاً بِالحِمى مُعشِبا",26,"ب",2,0],["وَماءِ مَسيلٍ سائِلٍ لِقَرارَةٍ","فَبَينا تَرى مِنهُ حُساماً تَرى دِرعا",27,"ع",2,0],["وَماءٍ كَأُفقِ الصُبحِ صافٍ جِمامُهُ","دَفَعتُ القَطا عَنهُ وَخَفَّفتُ كَلكَلا",28,"ل",2,0],["وَماءِ خَلاءٍ قَد طَرَقتُ بِسُدفَةٍ","عَلَيهِ القَطا كَأَنَّ آجِنَهُ الزَيتُ",29,"ت",1,0],["وَماءٍ خَلاءٍ قَد طَرَقتُ بِسُدفَةٍ","تَخالُ بِهِ ريشَ القَطا الكُدرِ نُشّابا",30,"ب",2,0],["وَماءٍ صَرى الجَمّاتِ طامَ كَأَنَّهُ","عَبِيَّةُ طالٍ مُتلَداتٍ صَعائِدِ",31,"د",1,0],["وَماءٍ تَرى ريشَ الغَطاطِ بَجَوِّهِ","خَفِيِّ الحَيا ما إِن تَلينُ نَضائِبُه",32,"ب",2,0],["وَماءِ عَفاءٍ لا أَنيسَ بِجَوِّهِ","حَليفاهُ مِن شَتّى عِفاءٌ وَطُحلُبُ",33,"ب",1,0],["وَماءُ الصِبا إِن طالَ في الشَخصِ مُكثُهُ","أَضَرَّ بِهِ بَعدَ الصَفاءِ أُجونُ",34,"ن",1,0],["وَماءً مِنَ الأَفلاجِ مُرّاً وغُدَّةً","وَذِئباً إِذا ما جَنَّهُ الليلُ عادِيا",35,"ي",2,0],["وماءُ بلادي كان أنْجَعَ مَشْرَباً","ولو أنّ ماءَ الكَرْخِ صَهْباءُ جِرْيال",36,"ل",1,0],["وَماءٍ قَديمِ العَهدِ بِالناسِ آجِنٍ","كَأَنَّ الدَبا ماءَ الغَضى فيهِ يَبصُقُ",37,"ق",1,0],["وماءٍ بِمَوْماة قَليلٍ أَنِيسُهُ","بسابسَ لم يحدث به الصيفَ محضر",38,"ر",1,0]]}