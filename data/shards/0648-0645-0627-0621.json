 الفرند","https://www.aldiwan.net/poem31325.html","المتقارب"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[74,"أرقت وقد نام الخلي لنازح","https://www.aldiwan.net/poem12977.html","الطويل"],[52,"ألا حي من أهل المحبة منزلا","https://www.aldiwan.net/poem26719.html","الطويل"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[50,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[50,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[46,"وجدت سواد الرأس تقلب لونه","https://www.aldiwan.net/poem23444.html","الطويل"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/12322","الطويل"],[31,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""],[114,"لشماء بعد شتات النوى","https://www.aldiwan.net/poem20958.html","المتقارب"],[124,"مالي وللبان والزوراء والعلم","https://www.aldiwan.net/poem23795.html","البسيط"],[135,"سألتها ما اسمها قالت وقد ضحكت","https://www.aldiwan.net/poem49154.html","البسيط"],[166,"وفى السحاب لمغناه وإن خانا","https://www.aldiwan.net/poem46863.html","البسيط"],[185,"تأمل هيئة الهرمين وانظر","https://www.aldiwan.net/poem14085.html","الوافر"],[186,"عروب تدور وماء يمور","https://www.aldiwan.net/poem43826.html","المتقارب"],[195,"علاني الشيب واشتعل اشتعالا","https://www.aldiwan.net/poem54419.html","الوافر"],[235,"وجه سعيد إذا تأمله ال","https://www.aldiwan.net/poem31648.html","المنسرح"],[235,"تأوبني فأرقني خيال","https://www.aldiwan.net/poem31734.html","الوافر"],[259,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[282,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[282,"فبادر بنا يا أخي فرصة","https://www.aldiwan.net/poem32723.html","المتقارب"],[282,"جيب الربيع على الإحسان مزرور","https://www.aldiwan.net/poem32762.html","البسيط"],[285,"رسول جاء بالبشر","https://www.aldiwan.net/poem39382.html","مجزوء الوافر"],[322,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[337,"كلا يومي طوالة وصل أروى","https://www.aldiwan.net/poem45418.html","الوافر"],[366,"ما كذب العاذل لا بل قد صدق","https://www.aldiwan.net/poem17043.html","الرجز"],[366,"سأركب بحر الهوى مقدما","https://www.aldiwan.net/poem17056.html","المتقارب"],[371,"تبيت أحاديث الهوى لك تفتري","https://www.aldiwan.net/poem57453.html","الطويل"],[406,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[406,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[432,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[441,"سرور المرء مقرون ببوس","https://www.aldiwan.net/poem14375.html","الوافر"],[443,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[443,"جرت في ذلك السهل","https://www.aldiwan.net/poem56029.html","عموديه"],[458,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[458,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[458,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[468,"وستر له منظر مونق","https://www.aldiwan.net/poem59805.html","المتقارب"],[468,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[475,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[477,"دمع على عرصات الربيع مسكوب","https://www.aldiwan.net/poem15258.html","البسيط"],[527,"أكل بناءٍ أنت بانيه معجز","https://www.aldiwan.net/poem45542.html","الطويل"],[527,"كتابي أبا نصر إليك وحالتي","https://www.aldiwan.net/poem46019.html","الطويل"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[553,"خرجن خروج الأنجم الزهر فالتقى","https://www.aldiwan.net/poem68273.html","الطويل"],[558,"هو العظيم الذي علا شانه","https://www.aldiwan.net/poem33693.html","المنسرح"],[558,"قلوب متى منه خلت فنفوس","https://www.aldiwan.net/poem34450.html","الطويل"]],"verses":[["وَماءٌ تَشيهِ الريحُ كُلَّ عَشِيَّةٍ","كَما رَقَمَ البُردَ الصَبيغَ يَماني",0,"ي",1,0],["وَماءٍ قَد تَخَفَّرَ بِالدَياجي","عَنِ الطُرّاقِ وَالسَلَمِ المُقيمِ",1,"م",1,0],["وَماءٍ وَرَدتُ عَلى كورِها","وَعَرَّجتُ عَنهُ قَتيلَ الأُوامِ",2,"م",1,0],["وَماءٌ يُضارِعُ خَيطَ السَقاءِ","وَيُرمى بِهِ في وُجوهِ الشِعابِ",3,"ب",1,0],["وَماءٍ تُصارِعُهُ بِالرِكابِ","وَجَيشٍ تُقارِعُهُ بِالقَنا",4,"ا",1,0],["وَماءٍ صَرىً لَم أَلقَ إِلّا القَطا بِهِ","وَمَشهورَةَ الأَطواقِ وُرقاً نُحورُها",5,"ر",3,0],["وَماءُ العَيشِ بَينَهُمُ فَضيضٌ","وَظِلُّ الأَمنِ فَوقَهُمُ ظَليلُ",6,"ل",1,0],["وَماءٍ كَأَنَّ اليَثرَبِيَّةَ أَنصَلَت","بِأَعقارِهِ دَفعَ الإزاءِ نَزوعِ",7,"ع",1,0],["وَماءٍ هَتَكتُ الدِمنَ عنَهُ وَلَم تَرِد","رَوايا الفِراخِ وَالذئابِ اللَغاوِسُ",8,"س",1,0],["وَماءٍ كَماءِ السُخدِ لَيسَ لِجَوفِهِ","سَواءَ الحَمامِ الوُرقِ عَهدٌ بِحاضِرِ",9,"ر",1,0],["وَماءٍ تَجافى الغَيثُ عَنهُ فَما بِهِ","سَواءَ الحَمامِ الحُضَّنِ الخُضرِ حاضِرُ",10,"ر",1,0],["وَماءٍ كَلَونِ الغِسلِ أَقوى فَبَعضُهُ","أَواجِنُ أَسدامٌ وَبَعضٌ مُعَوَّرُ",11,"ر",1,0],["وَماء هَتَكتُ الدِمنَ عَن آجِناتِهِ","بِأَسارِ أَخماسٍ جَماجِمُها صُعرُ",12,"ر",1,0],["وَمآءٍ صَرىَ عافي الثَنايا كَأَنَّهُ","مِنَ الأَجنِ أَبوالُ المَخاضِ الضَوارِبِ",13,"ب",1,0],["ومَاءٍ كفَقْدِ الماءِِ أعْلاَهُ عَرْمَضٌ","وأسْفَلُهُ لِلمُستَمِيحينَ حَرْمَدُ",14,"د",1,0],["وماءٍ جلتْ عن حُرِّ صفحته القذى","من الريحِ معطارُ الأصائل والبُكرِ",15,"ر",1,1],["وَماءً يَموجُ وَلا جَدوَلٌ","وَناراً بِلا حَطَبٍ تَستَعِر",16,"ر",1,0],["وَماءٍ تُصبِحُ الفَضَلاتُ مِنهُ","كَخَمرِ بُراقَ قَد فَرَطَ الأُجونا",17,"ن",2,0],["وَماءَ كُلِّ مُسبِلٍ هَطّالِ","يا أَقدَرَ السُفّارِ وَالقُفّالِ",18,"ل",1,0],["وَماءٍ كَأَنَّ الغِسلَ خيضَ صَبيبُهُ","عَلى لَونِهِ وَالطَعمِ يَعبِسُ شارِبُه",19,"ب",2,0],["وَماءُ سَدىً مِن آخِرِ اللَيلِ أَرزَمَت","لِعِرفانِهِ مِن آجِنٍ وَدِفانِ",20,"ن",1,0],["وماءٍ حكى أشعارَ حَمْدٍ ببَردِه","ولكنَّه مَحياً وتلكَ حُتوفُ",21,"ف",1,0],["وَماءِ وَجهٍ غَدا بِالنورِ مُتَّقِداً","كَأَنَّ في كُلِّ خَدٍّ نارَ أُخدودِ",22,"د",1,0],["وَماءُ حَياءٍ لَيسَ يَنقَعُ غُلَّةً","وَنارُ خُدودٍ لِلجَوانِحِ تَلفَحُ",23,"ح",1,0],["وماءً به شرقاتُ الردى","تمَيّعَ في قَبَسٍ مُشْعلِ",24,"ل",1,0],["وَماءٍ بِمَوماءٍ قَليلٍ أَنيسُهُ","بَسابِسَ لَم يَحدُث بِهِ الصَيفَ مَحضَرُ",25,"ر",1,0],["وَماءً بِوادي الغَضا سَلسَلاً","وَمُرتَبَعاً بِالحِمى مُعشِبا",26,"ب",2,0],["وَماءِ مَسيلٍ سائِلٍ لِقَرارَةٍ","فَبَينا تَرى مِنهُ حُساماً تَرى دِرعا",27,"ع",2,0],["وَماءٍ كَأُفقِ الصُبحِ صافٍ جِمامُهُ","دَفَعتُ القَطا عَنهُ وَخَفَّفتُ كَلكَلا",28,"ل",2,0],["وَماءِ خَلاءٍ قَد طَرَقتُ بِسُدفَةٍ","عَلَيهِ القَطا كَأَنَّ آجِنَهُ الزَيتُ",29,"ت",1,0],["وَماءٍ خَلاءٍ قَد طَرَقتُ بِسُدفَةٍ","تَخالُ بِهِ ريشَ القَطا الكُدرِ نُشّابا",30,"ب",2,0],["وَماءٍ صَرى الجَمّاتِ طامَ كَأَنَّهُ","عَبِيَّةُ طالٍ مُتلَداتٍ صَعائِدِ",31,"د",1,0],["وَماءٍ تَرى ريشَ الغَطاطِ بَجَوِّهِ","خَفِيِّ الحَيا ما إِن تَلينُ نَضائِبُه",32,"ب",2,0],["وَماءِ عَفاءٍ لا أَنيسَ بِجَوِّهِ","حَليفاهُ مِن شَتّى عِفاءٌ وَطُحلُبُ",33,"ب",1,0],["وَماءُ الصِبا إِن طالَ في الشَخصِ مُكثُهُ","أَضَرَّ بِهِ بَعدَ الصَفاءِ أُجونُ",34,"ن",1,0],["وَماءً مِنَ الأَفلاجِ مُرّاً وغُدَّةً","وَذِئباً إِذا ما جَنَّهُ الليلُ عادِيا",35,"ي",2,0],["وماءُ بلادي كان أنْجَعَ مَشْرَباً","ولو أنّ ماءَ الكَرْخِ صَهْباءُ جِرْيال",36,"ل",1,0],["وَماءٍ قَديمِ العَهدِ بِالناسِ آجِنٍ","كَأَنَّ الدَبا ماءَ الغَضى فيهِ يَبصُقُ",37,"ق",1,0],["وماءٍ بِمَوْماة قَليلٍ أَنِيسُهُ","بسابسَ لم يحدث به الصيفَ محضر",38,"ر",1,0],["وَماءٍ وَرَدتُ عَلى زَورَةٍ","كَمَشيِ السَبَنتي يَراحُ الشَفيفا",39,"ف",2,0],["وماء راحوب ان تصفو وإن كدرت","تظل أعذب ماء سائغ بفمي",40,"ي",1,0],["وماءُ إفيانَ يشفي الناس من سَقمٍ","لكنّ قلبيَ لا يشفيهِ إلاّكِ",41,"ك",1,0],["وماءِ بشرٍ مصونٍ في قَرارتهِ","يروي الرَّجاءَ إذا وافاهُ عطشانا",42,"ن",2,0],["وماءُ النيلِ تحتَهما دموعٌ","وصوتُ الريحِ عندهما نَحيب",43,"ب",1,0],["وماء من المزن مثعنجر","تخلله عن جناه الديور",44,"ر",1,0],["وَماءٌ سَحابِ مُقفَرَةٍ زَهَتها","جَنوبٌ نَفَّضَت عَنها الطِلالا",45,"ل",2,0],["وَماءُ حَمّامِهِ مَعينٌ فَما","تَنفَكُّ مَملوءَةً خَزائِنُهُ",46,"ن",2,0],["وَماءٍ ما ظَمِئتُ إِلَيهِ حَتّى","شَرِقتُ مِنَ البُكاءِ بِماءِ جَفني",47,"ي",1,0],["وماء الوجه صنه ولا تُرِقه","لغير الله لو منح الجواهر",48,"ر",1,0],["وَماءُ الحَيا لَو حَكى ريقَهُ","لأَحيا رُفاتاً طَويلاً بَلاها",49,"ا",3,0],["وَماءً صَفا وَحَلا طَعمُهُ","وَرَقَّ وَزادَ فَما يَنقُصُ",50,"ص",1,0],["وَماءُ وَردِ نَصيبين اِنثَنى خَجَلاً","مِن نَشرِها فَهوَ مَغلوبٌ فَمَقهورُ",51,"ر",1,0],["وماء بارد شهد","زلال راق كالتبر",52,"ر",1,0],["وَماءٍ كَأَنَّ الزَيتَ فَوقَ جِمامهُ","مَتى ما يَذُقهُ فُرَّطُ القَومِ يَسبِقُ",53,"ق",1,0],["وَماءٍ قَد وَرَدتُ لِوَصلِ أَروى","عَلَيهِ الطَيرُ كَالوَرَقِ اللَجينِ",54,"ن",1,0],["وَماءِ عَينٍ نارُ قَلبٍ دونَها","كَالجيدِ قَد أَلبَستَهُ ثَوبَ المَلَقْ",55,"ق",1,0],["وَماءَينِ مِن وَجهِهِ وَالعُيونِ","وَهَذا أَقامَ وَذاكَ اِندَفَق",56,"ق",1,0],["وماء ندىً يكسُو فيُسبَلُ حوضُه","وفي كلِّ ماءٍ كلُّ من خاضَ شَمَّرا",57,"ر",2,0],["وَماءٍ من بشاشته زُلالٍ","وروض من مَكارِمِهِ مُريعِ",58,"ع",1,0],["وَماء وَجه ينِّبي عَن صَرامَتِهِ","إِن الفرند دَليلُ الصارِمِ الذَكَرِ",59,"ر",1,0],["وماءُ مكارمِ الأَخلاقِ منه","يكادُ يردُّ صاعِدَةَ الزَّفيرِ",60,"ر",1,0],["وماء الوجه أصون كل شيء","فلم يهرق على الطمع الغميس",61,"س",1,0],["وماء النهر مكدر","ونبت الأرض قد اقوى",62,"ا",1,0],["وماء سلسل عذب","وصدح بلابل الحقل",63,"ل",1,0],["وماءٌ فاضلٌ عنها وبَقْلٌ","تَبزَّلُ في كمائمه البِكارُ",64,"ر",1,0],["وماءٍ تَعرمَضُ أوشالُهُ","ببابلَ أشهَى اليها وأَمْرى",65,"ر",2,0],["وماء تُحبَسُ الأنفاسُ منه","وتُستشرَى به اللَّهَوَاتُ حَرَّا",66,"ر",2,0],["وَماءٌ يَفورُ بِساحاتِهِ","حَديقٌ بِأَشجارِهِ مَحدَقُ",67,"ق",1,0],["وَماءُ السُرورِ لِوُرّادِهِ","إِذا فاضَ لَم يَكُ فيهِ كَدَر",68,"ر",1,0],["وَماءٍ قَد وَرَدتُ أُمَيمَ طامٍ","عَلى أَرجائِهِ زَجَلُ الغَطاطِ",69,"ط",1,0],["وماءُ مزنتهِ لم يَهْمِ مُنبجِساً","إِلاّ انثنى بدموعي وهو مقطوبُ",70,"ب",1,0],["وماءٌ إذا أبصرتَ منه صفاءه","حسبت نجوم الليل ذابت سوائلا",71,"ل",2,0],["وماءٍ زلالٍ قد تركنا وروده","زلالاً وبعناه بشربة علقمِ",72,"م",1,0],["وَماءُ قومٍ حلَلتَ بينهُمُ","لا كان عَذْباً لهمْ ولا شَبما",73,"م",2,0],["وَماءٍ كَعَينِ الشَمسِ لا يَقبَلُ القَذى","إِذا دَرَجَت فيهِ الصِبا خِلتَهُ يَعلو",74,"ل",2,0],["وماء حوض النبي راق لنا","ونحن أكوابه وكيزانُهُ",75,"ن",2,0],["وماءً شربناه ولحماً وخبزةً","أكلناه واندارت بذاك ضروس",76,"س",1,0]]}