{"poems":[[164,"رثت لنحولي في هواها وذلتي","https://www.aldiwan.net/poem59010.html","الطويل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204061","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136261","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46436","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52970","الوافر"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4958,"على قدر التعلق","https://www.poetsgate.com/ViewPoem.aspx?id=59099",""],[4984,"إِذَا انْجَلَى صُبْحُ هَذَا الْيَوْمِ","https://www.poetsgate.com/ViewPoem.aspx?id=201809",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[5536,"المسيح ومريم العذرا وجذع النخلة!!","https://www.poetsgate.com/ViewPoem.aspx?id=27505",""],[5536,"معشوقتي والغول والعنقاء..!!","https://www.poetsgate.com/ViewPoem.aspx?id=19879",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5309,"أنا من سكر هواهم ثمل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573771",""]],"verses":[["فاأقبت الإيام خيرا وأجزلت","عطية أنس بعد شدة وحشة",0,"ه",1,0],["فاأذن لألسنة الظبى فيهم بأن","يخطبْنَ فوق منابر الأرقاب",1,"ب",1,0],["فا أين أولي البصيرة من معان","تولت فهمها النفس العتيقه",2,"ق",2,0],["فا أَمر بِما تَهوى تُطعك فَإِنَّهُ","كادَ العَروسُ يَعد في الأمراء",3,"ا",2,0],["فإا عليه مثلها اذ ليس يل","حق أهلها شيء من الأحزان",4,"ن",1,0],["فا أسمى ذراها من بيوتٍ","رَزانٍ في حماستها شداد",5,"د",1,0],["فَا أمرٍ أو مُضَارِعٍ مِن كَوَعَد","احذِف وضفِى كَعِدَةِ ذَاك اطَّرَد",6,"د",1,0],["فَاإذَنْ بتأْبينِ الكلا","مِ وقدْ عَقَدْتَ الألسنا",7,"ن",2,0],["فا اقنع بِفَيْءٍ قليل تستظل به","وامسك بحبل دوام من عرى الأمل",8,"ل",1,0],["فا اقتحمت نيران ما هاجني","عمق الحشا تنشد إحراقها",9,"ق",3,0],["فا المسيح ومريم العذرا وجذع النخلة","المخاض الصعب في لحظة سقوط التمرة",10,"ر",2,0],["فا المستحيلُ من الامورِ ِثلاثةُ","معشوقتي والغولُ والعنقاءُ",11,"ا",2,0],["فاانا معه يمنى با الشدايد ومسنده","وأعاونه لاجار الدهر في مصايبه",12,"ب",2,0],["فَإِا لَم يَرجِعِ الدَّهرُ بِهِم","أَدمُعي عَن مُقلَتي تَرتَحِلُ",13,"ل",1,0]]}