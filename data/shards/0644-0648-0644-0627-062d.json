{"poems":[[43,"مالك وضاح دائم الغزل","https://www.aldiwan.net/poem42362.html","المنسرح"],[29,"قد غير الحي بعد الحي إقفار","https://www.aldiwan.net/poem5739.html","البسيط"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[93,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[68,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[82,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[46,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[71,"مدحت أنطاكية","https://www.aldiwan.net/poem29298.html","مجزوء الرجز"],[107,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[107,"أتنام عينك والعيون سهاد","https://www.aldiwan.net/poem42119.html","الوافر"],[107,"أنا بنو عثمان أعلام الورى","https://www.aldiwan.net/poem43424.html","الكامل"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[77,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[77,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[77,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[50,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[50,"لولا حذاري من جنان","https://www.aldiwan.net/poem66095.html","مجزوء الكامل"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[48,"إنا معاشر هذا الخلق في سفه","https://www.aldiwan.net/poem22978.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85840","المجتث"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43846","البسيط"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10210","السريع"],[56,"لَولا حُوَيُّ بيْتِ لهيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=14506",""],[93,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[173,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[189,"يا صاح أين مضى قلبي فأطلبه","https://www.aldiwan.net/poem14130.html","البسيط"],[202,"وسافر عن قمر","https://www.aldiwan.net/poem51855.html","مجزوء الرجز"],[242,"لولا حلولي بذرى لمطه","https://www.aldiwan.net/poem18844.html","السريع"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[280,"أما الكثيب فما يطار حماه","https://www.aldiwan.net/poem25463.html","الكامل"],[287,"أنى اهتدى طيف الحبيب لمرقدي","https://www.aldiwan.net/poem32794.html","الكامل"],[303,"(أدمشق) ما للحسن لا يعدوك","https://www.aldiwan.net/poem36849.html","عموديه"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[374,"يا طالب الرزق بالتقويم تصنعه","https://www.aldiwan.net/poem4277.html","البسيط"],[435,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[458,"يا نجمة في الأفق","https://www.aldiwan.net/poem61564.html","مجزوء الرجز"],[463,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[498,"بالقفص للقصف منزل كثب","https://www.aldiwan.net/poem67420.html","المنسرح"],[511,"لي نحو أرض المنى من شرق اندلس","https://www.aldiwan.net/poem2422.html","البسيط"],[519,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[519,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[520,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[556,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66748","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39224","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120119","المنسرح"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73506","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19971","الكامل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132901","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77740","الكامل"],[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127841","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125476","البسيط"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104435","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102539","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100902","السريع"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115650","الرجز"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118785","الكامل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22545","البسيط"],[3238,"","https://poetry.dctabudhabi.ae/diwan/poem/144392","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86274","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35909","المنسرح"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45823","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91497","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131269",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95323","الكامل"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130560","السريع"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40128","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97072","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90869","الكامل"],[4702,"نار الغبن","https://www.poetsgate.com/ViewPoem.aspx?id=155214",""],[4929,"دردشة مع أبي الطيب المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=199189",""],[3591,"أشتاق وجهج بعد ما نتفرق","https://www.poetsgate.com/ViewPoem.aspx?id=149499",""],[5206,"في علم الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187418",""],[709,"رنا فسلَّ على العشاق أحوره","https://www.poetsgate.com/ViewPoem.aspx?id=2883",""],[5595,"بَانَتْ سُعَادُ","https://www.poetsgate.com/ViewPoem.aspx?id=144557",""],[5616,"قصب","https://www.poetsgate.com/ViewPoem.aspx?id=203436",""],[5674,"شوقا إلى الفرات أصوم وأفطر","https://www.poetsgate.com/ViewPoem.aspx?id=186708",""],[5691,"ضياغم بيْتا","https://www.poetsgate.com/ViewPoem.aspx?id=206209",""],[5803,"أنت الهيام وصبر العاشقين أنا","https://www.poetsgate.com/ViewPoem.aspx?id=104035",""],[5956,"إن لستِ راحمتي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181991",""],[5956,"‏ بم سوف تشعر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=185413",""],[6229,"أمّتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65214&r=&rc=37",""]],"verses":[["لَولا حِذَارِي مِنَ الحُتُوفِ فَقَد","أَصبَحتُ مِن خَوفِها عَلى وَجَلِ",0,"ل",1,0],["لَولا حِمايَةُ يَربوعٍ نِساءَكُمُ","كانَت لِغَيرِكُمُ مِنهُنَّ أَطهارُ",1,"ر",1,0],["لولا حذار القوس في يديهِ","لغنَّت الورق على عطفيه",2,"ه",1,0],["لَولا حَنانُ الغانِياتِ وَعَطفُها","ما كانَتِ الدُنيا سِوى أَحزانِ",3,"ن",1,0],["لَولا حُماةٌ لَها هَبّوا لِنُصرَتِها","بِالسَيفِ ما اِنتَفَعَت بِالرِفقِ وَالرُحَمِ",4,"م",1,0],["لَولا حَيائي مِن نَوالي بِرِّكُم","ما قَلَّ نَحوَ رَبعِكُم تَرَدُّدي",5,"د",2,0],["لَولا حَديثُ عَلِيٍّ قلتُ من أسَفٍ","بِفيكَ يا مَن نَعى يَحيَى لَنا العَفَرُ",6,"ر",1,0],["لَولا حَداثَتُها وَأَنِّيَ لا أَرى","عَرشاً لَها لَظَنَنتُها بِلقيسا",7,"س",2,0],["لولا حبيبٌ ساكن","فيها ولولا ظلُّها",8,"ل",3,0],["لولا حِجاكَ وَطُولُ باعِكَ جاوزتْ","بَاعَ الرجاءِ ومُستطاعَ المطمعِ",9,"ع",1,0],["لولا حميّتُه لكان محَلُّهُ","فيهم محلَّ اللَّيْثِ حيثُ يُصادُ",10,"د",1,0],["لَولا حَزامتُه وَشدّةُ بَأسِهِ","وَمَضاؤُهُ لَتضعضعَ الإِسلامُ",11,"م",1,0],["لولا حِجابٌ دونَ علمِك حاجِزٌ","وَجَدوا إلى عِلمِ الغُيُوبِ سَبيلا",12,"ل",2,0],["لولا حياءُ البحرِ منْ موجِهِ","والعارضِ الجَون من الأفْق",13,"ق",1,0],["لولا حياتُكَ ما اغتبطتُ بعيشةٍ","ولوَ انّني عُمِّرْتُ عُمْرَ لَبيد",14,"د",1,0],["لولا حفائظهُ وصَعْبُ مِراسِهِ","ما كانتِ العرَبُ الصّعاب صِعابا",15,"ب",2,0],["لَو لاحَ لي مِنهُ نَهجٌ","رَكِبتُ نَهجَ صَعيدِه",16,"د",2,0],["لَولا حِذاري مِن جِنانِ","لَخَلَعتُ عَن رَأسي عِناني",17,"ن",2,1],["لَولا حَبائِلُ مِن نُعمٍ عَلِقتُ بِها","لَأَقصَرَ القَلبُ عَنها أَيَّ إِقصارِ",18,"ر",1,0],["لَولا حِذارِيَ أَنَّ اللَهَ يَسأَلُني","عَمّا فَعَلتُ لَقَلَّت عِندِيَ الكُلَفُ",19,"ف",1,0],["لولا حذار الردى ما","كان الأمين أمينا",20,"ن",2,0],["لَولا حُسَينٌ لَم تَدُم","إِلّا كَما دامَ الحَباب",21,"ب",1,0],["لَولا حَياتي وَقَولُ قَومٍ","سُفِّهَ أستاذُنا الخَليلُ",22,"ل",1,0],["لَولا حُوَيُّ بَيتِ لِهيانِ","ما قامَ أَيرُ العَزَبِ الفاني",23,"ي",1,1],["لَولا حُوَيُّ بيْتِ لهيانِ","ماقامَ أ... العَزَبِ الفَاني",24,"ي",1,1],["لولا حنان الغابيات وعطفها","ما كانت الدّنيا سوى أحزان",25,"ن",1,0],["لَولا حَملاتُ عِمادِ الدِّي","نِ عَلى الأَبطالِ بِلا سَأَمِ",26,"م",1,0],["لو لاح بابُ خَلاصِى كنتُ أدخلُه","أو ذلَّ ظهرُ جوادِي كنت أركبه",27,"ب",2,0],["لو لاحَ للحورِ وقد","سلَّ حُسامَ الحَوَرِ",28,"ر",1,0],["لَوْلاَ حُلُولِي بِذُرَى لَمْطَهْ","لَمْ يُبْدِ لِي فَجْرُ الْمُنَى خَيْطَهْ",29,"ط",2,1],["لولا حياءٌ فيهِ ضِعفُكِ قوةٌ","أطلقت للأوطارِ منكِ عنانا",30,"ن",2,0],["لَوْلا حَيَاءُ الحَيِّ مِنْ أَكْفَائِهِ","لَكَفَاهُ سِحْرُ جُفونِهن عِدَاهُ",31,"ا",2,0],["لَولا حَديثُ نُفوسِنا ما اِصطادَتِ ال","أَحلامُ لَيلاً طَيفَ مَن لَم يُصطَدِ",32,"د",1,0],["لولا حمى (البيت الحرام) وَشطره","عند الصلاةِ وجوههم وَلُّوكِ",33,"ك",1,0],["لولا حَمامٌ هادرُ إسعادُه","يَنْفَى الجوى بلَحْنِه المُردَّد",34,"د",1,0],["لولا حسابٌ وتأريخٌ وصنعة ما","فيه لكان هذا كلّ ما فيه",35,"ي",2,0],["لولا حسامك يا فتاك ما نشدوا","السيف أصدق أنباءً من القلمِ",36,"م",1,0],["لولا حنانك ماتت","دنياي في كل شي",37,"ي",1,0],["لولا حظوظٌ في ذَراك سمينةٌ","ما جئت ملتحفاً بجسمِ هُزالِ",38,"ل",1,0],["لَولا حِفاظي المَشهورما أَمِنت","مِن بُعدِ بغدادَ سَلوَتى حَلَبُ",39,"ب",1,0],["لولا حِذارى أن اذكي لها لَهَبا","زَجّيتها برياحِ الشّوق في نفسِ",40,"س",1,0],["لولا حيا كفّيكَ ما حيّا الحَيا","رَوضي ولا ساحَتْ بطاحُ مَعيني",41,"ن",2,0],["لولا حَريرُ عِذارَيه لمَا نسجَ الد","ديباجَ شِعري ولا فِكْري يُصوّرُهُ",42,"ر",2,0],["لولا حفاظك يوم القصر لاضطربت","قواعد الملك واحتاجت إلى التعب",43,"ب",1,0],["لولا حِمامُك ما اِهتَدى همٌّ إلى","قلبي ولا نارٌ إلى إحراقي",44,"ق",2,0],["لولا حِذارُ أبي بُجير أظهروا","شنانَهم وتَفرَّقوا وتَصدَّعوا",45,"ع",3,0],["لَولا حَيائي من عُيونِ النَّرجِس","للَثمْتُ خَدَّ الوَرْدِ بين السُّندُسِ",46,"س",1,1],["لَولا حُقوق الأهلِ وَالبَنات","وَما لَنا بِفاس مِن حاجاتِ",47,"ت",1,0],["لولا حقوق للقس عندي","ليس لقر عندة المهينِ",48,"ن",1,1],["لَو لاحَ لي فيما تَظاهَرَ لَم أَقُل","عَرِّج بِمُنعرجِ الكَثيبِ الأَعفرِ",49,"ر",1,0],["لَولا حُمَيدٌ لَم يَكُن","حَسَبٌ يُعَدُّ وَلا نَسَب",50,"ب",1,1],["لو لاحظَتك جُفُونُه بِفُتُورِها","أقسمتَ أنك ما رأيتَ كَحُسنِهِ",51,"ن",2,0],["لَو لاحَ لائح وَجهها لتهتكت","أَلبابنا لوميض برق سَناها",52,"ا",3,0],["لولا حجابٌ أَمام النفس يمنعها","عن الحقيقة فيما كان في الأزلِ",53,"ل",1,1],["لو لاحظت أدمعي تجري دماً لبكَت","فكيف لو نظرَت قلبي عَلَى اللَّهَبِ",54,"ب",1,0],["لولا حرارة أنفاسي لأغرقني","دمعي ولولاه جمر الوجد أحرقني",55,"ن",2,0],["لولا حديث أبي رزين كان ذا","كلنص يقرب منه في التبيان",56,"ن",1,0],["لَولا حُدوثك قُلت إِنكَ جاعل ال","أَرواح في الأَشباح وَالمستنزع",57,"ع",1,0],["لو لاح نورك للجبال لنوديت","أتصدّعي أتصدّعي أتصدّعي",58,"ع",2,0],["لولا حسينٌ وايادٍ له","تخذلُ فى الجود طلاَلَ السَّمِى",59,"م",2,0],["لولاح في جنحِ الدجى","جلا سناهُ غسَقَه",60,"ق",2,0],["لو لاح أدنى بارقٍ من حسنها","للكون صار إلى الفناء المفظعِ",61,"ع",1,0],["لَولا حُمَيدَةُ ما هامَ الفُؤادُ وَلا","رَجَّيتُ وَصَلَ الغَواني آخِرَ العُمُرِ",62,"ر",1,0],["لولا حذاري من أن ألام على","عتاب يوم منه وإعتابه",63,"ه",1,1],["لَو لاحَ لِلشَّمسِ في أُفُقٍ لما طَلَعت","مِنهُ حَياءً وَلا بَدرُ الدجى ظُهرا",64,"ر",2,0],["لَو لاحَ يَوماً إِلى العَبّادِ لانذَهَلوا","بِهِ حيارى وَفي اِوصافِهِ هاموا",65,"م",3,0],["لَولا حِفاظٌ لما أَضاعَ لَقَد","أَعرَبَ قَولٌ عَنِ المُبيحِ دَمَه",66,"م",2,0],["لَو لاحَ وَالبَدر بِالأَنوار مُبتَهج","لَقُلت باللَه فَاِخسَأ