{"poems":[[79,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[88,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[46,"داب عيني البكاء والحزن دابي","https://www.aldiwan.net/poem30320.html","الخفيف"],[71,"لقيت خبرا يا نوى","https://www.aldiwan.net/poem27991.html","مجزوء الكامل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142181","الكامل"],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[266,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[358,"لي في الحمى خل خلا عن نية","https://www.aldiwan.net/poem40565.html","الكامل"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[409,"لا والغرام وما تجن الأضلع","https://www.aldiwan.net/poem33683.html","الكامل"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[435,"باب بسعد بشيره","https://www.aldiwan.net/poem40730.html","مجزوء الكامل"],[438,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[572,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138856",""],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145645","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72307","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80219","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80184","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49964","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35794","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108639","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101566","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202172","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202168","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100464","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47206","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88654","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60831","الكامل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128693","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93916","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74236","الرمل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61256","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85187","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29303","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40144","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4120,"","https://poetry.dctabudhabi.ae/diwan/poem/142544","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94979","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72789","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139732",""],[5145,"أرأيت كيف تزعزع الأجيال؟","https://www.poetsgate.com/ViewPoem.aspx?id=108230",""],[5183,"معنى الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=186497",""],[5621,"قِبلةُ الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=24566",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5803,"لو لا العراق لما ترنم خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=101216",""],[5956,"لا دين إلا لذي النوايا الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=192044",""],[6262,"لغةٌ أخرى لمرايا البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80107&r=&rc=5",""]],"verses":[["وعلَى عبْدِ العزيزِ اعْطِفْ تجِدْ","ناسِكاً للّهِ والنّاسِ اتّضَعْ",0,"ع",1,0],["وَعَلى عَلِيٍّ وَهوَ أَطهَرُنا فَماً","وَيَداً وَسَيفُ نَبِيِّنا المَسلولُ",1,"ل",1,0],["وعلى عين الشرق ران رقاد","دونه في غير الرجاء المنون",2,"ن",1,0],["وَعَلى عارِضَيهِ ماءُ النَدى الجا","ري وَماءُ الحِجى وَماءُ الشَبابِ",3,"ب",1,0],["وعلى عداهُ فضلُهُ","فضلُ الحبوبِ على النوى",4,"ن",3,0],["وعلى عيونك تنثر","الأحلام أنجمها المذابه",5,"ب",2,0],["وَعَلى عَوامِلِ ما رَكَزتَ كَواكِبٌ","مِمّا اِنتَصَيتَ لَها وَخَلَّفَ قَعدَبُ",6,"ب",1,0],["وعَلى عرشهِ اِستوى ليس يدري","غيرهُ كيفَ ذلِك الإِستواءُ",7,"ا",2,0],["وعلى عبد الكريم الن","دب مدحي كالدلاص",8,"ص",1,0],["وَعَلى عُهودٍ بَيننا عَربيَّةٍ","ما زالَ يَحلف لي بِكُلِّ أَلِيّةِ",9,"ه",1,0],["وعلى عبده المذنب يتوب","توبة الصدق تمحو كل ران",10,"ن",1,0],["وعلى عُلاكَ من المحب تحيةٌ","منها تعطرتِ الجهاتُ الأربع",11,"ع",1,0],["وعلى عارضه من خَطِّهِ","كتَبَ الرَّيحانُ فوق الخد سطرا",12,"ر",2,0],["وعلى علاه أرخوا","دارٌ بجودٍ أشرقت",13,"ت",1,0],["وعلى عُلاهُ قدِ انطوَتْ","أبداً رُواقُ العزّ مَدّا",14,"د",2,0],["وعَلَى عليّ أجْمَعَتْ","بالشُّكْرِ ألسنَةُ القصائِدْ",15,"د",1,0],["وَعَلى عاشر المشاة وَثاني","عَشرِهِم كانَ حُكمُه وَنَداه",16,"ا",2,0],["وعليَّ عزّ أخي انفرادكَ بين مَن","لم يُرعَ إلٌّ منهم وذِمام",17,"م",1,0],["وعلى عَهْدِكَ الوَفِيِّ سَيَبْقَى","وَسَيُحْيي إيمانَهُ وَيَقِينَهْ",18,"ن",2,0],["وعلى عرشه استوى وتجلى","جل من عز رفعة واقتدارا",19,"ر",2,0],["وعلى علي ان عددت فضيلة","لسوى النبي عريت محصولي",20,"ل",2,0],["وَعَلى عَلى الفَرق المُنير","يَرى الرَجا مُتَوسما",21,"م",2,0],["وَعَلى عُلى لُبنان فَضلٌ شامِخٌ","فَوقَ الشَوامِخِ مُعلِنٌ بِالمنَّةِ",22,"ه",1,0],["وعلى عزيزتك السّلامُ لها","منه على طول المدى مَدَدث",23,"د",2,0],["وَعَلى عَدُوِّكَ يا اِبنَ عَمِّ مُحَمَّدٍ","رَصَدانِ ضوءُ الصُبحِ وَالإِظلامُ",24,"م",1,0],["وعلى عوامله الرؤوس كأنها","بعد انفجار مواضع الأفكار",25,"ر",1,0],["وعلى عمود الصبح قد شاد الضُحى","برج النهار مسلحاً بالنارِ",26,"ر",1,0],["وعلى عاشيقيه تاه دلالا","حيقما كنت حسنه وجماله",27,"ل",2,0],["وعُلىً على وجْهِ الزَّمان نَضارَةٌ","منها وفي ثَغْر الكمال تَبَسُّمُ",28,"م",1,0],["وعلى عزائمه الشَّريفة أَنَّها","تَجْزي بِضِعْفي قَرْضِه ما أَقْرضا",29,"ض",2,0],["وعلى علومك أجمع العلماء فال","إجماع منقولٌ بها ومحصل",30,"ل",1,0],["وعلى عيون الكاتبي","ن ذوي البراعة كان جلاَّ",31,"ل",2,0],["وعلى علي وهو في محرابه","عطف بحاسمة تبل غرارها",32,"ر",3,0],["وعَلَى عليٍّ بن الحُسينِ توكلي","وإليه من بعدِ الإِلهِ معادي",33,"د",2,0],["وعلى عهدٌ إن ظَفِرتُ بِقُربِكُم","لَبَذلتُ مني الروحَ دون تَوَقُّفِ",34,"ف",1,1],["وعلى عود أيكها الطير غنى","معرباً عن ملحن الأسجاع",35,"ع",1,0],["وَعَلى عُثمانَ ذي النورَينِ مَن","فازَ بالرِضوانِ فَوزاً حَسَنا",36,"ن",2,0],["وَعلى عترتك الأَطهار وَالص","صَفوة الأَبرار ما حادَ حدا",37,"د",2,0],["وَعلى عُبابِ البَحر مِن سُبّاحِه","أُممٌ يغصُّ بِها الفَضاءُ وَيشرقُ",38,"ق",1,0],["وعلى عليائه والده","كم وكم اثنى ثناء مستطابا",39,"ب",2,0],["وعلى عبده جميل المزايا","صلوات له بغير انتهاء",40,"ا",2,0],["وَعَلى عالَمي الشِتائِيِ فيضي","نورَ دِفءٍ يُفني ظَلامِيَ الحالِكِ",41,"ك",1,0],["وَعَلى عَزاز عَنَوْا وَثَلّ عُروشَهُم","مَلكٌ مُقيّدُ مَن عَصاهُ مَقيدُ",42,"د",1,0],["وَعَلى عَينَيهِ إِن تَلقَ السَبيل","سَكَبَت روحَ السُباتِ المُستَطيل",43,"ل",1,0],["وعلى عجلونَ فيها تتباهى","من صلاح الدين آياتُ الخلود",44,"د",1,0],["وعلى عُلا رمسي أجاد بقبَّةٍ","كي يطلب الراؤون لي رُحم السميع",45,"ع",1,0],["وعلى عرنينها شرذمةٌ","كل عالي الانف بالعينِ شراها",46,"ا",3,0],["وعلى علاك ثناءُ مَن رفع السما","ومن السلام لك السلام ختام",47,"م",1,0],["وعلى عداك له إذا استنجدته","يوم الجدال أسنة ونصال",48,"ل",1,0],["وعلى ( عطاء الله ) ذلك مَن","جادت به الأردنّ فالعُرب",49,"ب",1,0],["وعلى عيونِكِ ألفُ ألفِ حكايةٍ","شمَخَتْ بمجدِكِ نَسْجُهُنَّ فِداءُ",50,"ا",2,0],["وعلى عرشك المقدس قامت","لسليمان دولة الدهر أمس",51,"س",1,0],["وَعَلى عَوَاتِقِ دِجْلَةٍ فِيْ سُمْرِهَا","(إسْحَاقُ) تَاهَ بِلَحْنِهِ الْمِطْرَابِ",52,"ب",1,0],["وعلى عقائدنا التفاف مخلص","حول السلام وعون أي فقيرِ",53,"ر",1,0],["وعلى عاداتِه يحسو دَمِي","بينما تقتاتُني ذكرى امْرَأه",54,"ا",2,0]]}