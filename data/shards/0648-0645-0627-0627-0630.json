{"poems":[[68,"ليالي الحمى ما كنت إلا لآليا","https://www.aldiwan.net/poem40988.html","الطويل"],[52,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[242,"يا سيدي سيد الجمهور جمهور","https://www.aldiwan.net/poem18816.html","البسيط"],[447,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64903","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108622","الوافر"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103573","الطويل"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141234","المتقارب"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21569","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52141","الرمل"],[5355,"أما آن الرجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87208&r=&rc=33",""]],"verses":[["وَما أَذكَرَتني سالِفاتُ عُهودِهِم","تُذَكِّرُ بِالأَشياءِ مَن كانَ ناسِياً",0,"ي",2,0],["وَما أَذنَبتُ مِن ذَنبٍ","سِوى حُبّي فَما ذَنبي",1,"ب",2,0],["وما أذهلَتْني عن وِدادِكَ رَوْعَةٌ","وكيف وفي أمثالِه يجِبُ الغَبْطُ",2,"ط",1,0],["وَما أَذنَبتُ مَحضاً في كِتابٍ","وَمَحوُ الذَنبِ تَوبَتي النَصوحُ",3,"ح",1,0],["وَمَا أَذَاعَتْ لَنَا مِنْ عَرْفِ فَخْرِكُمُ","صَبَا الْمَحَامِدِ مِنْ مِسْكٍ وَكَافُورِ",4,"ر",1,0],["وما أذخرت من ماضي شبابي","ذخيرة محرص منه مكين",5,"ن",1,0],["وما آذى كرامتك افتراءٌ","وإن آذى مروءتك الجحود",6,"د",1,0],["وما إِذا صحَّفْتَ معكوسَهُ","عادَ إلى صيغتِهِ فُسْتُقُ",7,"ق",1,0],["وما أذخرت لي عملاً حميداً","يجمل حالتي يوم النشور",8,"ر",1,0],["وما أذهلتني عن ودادك غيبةٌ","قدحتَ بها نار الأسى في حيازمي",9,"م",2,0],["وَمَا أَذَّنَ القَوم لَمَّا أَقاموا","صَلاَةَ الجَنَازَةِ يَومَ الوَفَاة",10,"ه",1,1],["وَما إِذا صاحَ غرا","بٌ في الدِيار احتَمَلوا",11,"ل",3,0],["وما أذلَّ الدمعَ للَملْكِ وما","أشرفَ الدمعَ أذا سال غراما",12,"م",2,0],["وما آذيت عن قصد فؤادي","ولا أشعلت بالأحشاء نارا",13,"ر",2,0]]}