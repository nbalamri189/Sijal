x?id=214762",""],[5758,"ألوان","https://www.poetsgate.com/ViewPoem.aspx?id=200518",""],[5771,"بطاقة زائر","https://www.poetsgate.com/ViewPoem.aspx?id=189060",""],[5848,"مترين !!","https://www.poetsgate.com/ViewPoem.aspx?id=50607",""],[5848,"الموت في بعض المواقف شجاعة","https://www.poetsgate.com/ViewPoem.aspx?id=53381",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5943,"نوارس الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=60767",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"العالمية قد تجلت عنده","https://www.poetsgate.com/ViewPoem.aspx?id=192636",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[5997,"ثَغْرُ الحَنَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=214535",""],[6019,"نَفَحَات غَدِيرِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=150972",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""],[6102,"زيشان","https://www.poetsgate.com/ViewPoem.aspx?id=184170",""],[6115,"نصايح عشر","https://www.poetsgate.com/ViewPoem.aspx?id=180461",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""],[6186,"متجردٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82884&r=&rc=4",""],[2914,"أَودَى الشَّبابُ ، حَميدا ، ذو التَّعاجِيبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24234&r=&rc=0",""],[6318,"الهند .. تقاوم الاحتلال البريطاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65940&r=&rc=0",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""],[5190,"أين الوفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85064&r=&rc=139",""]],"verses":[["وَالعاجِزُ المَأفونُ أَق","عَدُ ما يَكونُ إِذا أُقيما",0,"م",2,0],["وَالعاذِلاتُ هواجِعٌ خاضَ الكَرى","أَجفانَها وَذوُو الهَوى أَيقاظُ",1,"ظ",1,0],["وَالعامِريَّةُ تُذري دمعَها وَجَلاً","وَالصَبُّ لا آمِنٌ فيهِ وَلا خاشي",2,"ش",2,0],["والعامريّةُ تَسْقي الوَرْدَ مُجْهِشَةً","بنَرْجِسٍ من سِجالِ الدّمْعِ مُغْتَرِفِ",3,"ف",1,0],["وَالعامِرينَ شَبابَها وَكُهولِها","وَبَني المُسَيَّبِ يَومَ دَعوَةِ لَعلَعِ",4,"ع",1,0],["والعاديات إذا تلت فرسانها","آيَ القتال صفوفها تترتلُ",5,"ل",1,0],["والعَأرِفو الحَقَّ للمُدّلِ به","والمُستَقِلّو كثيرِ ما وَهَبُوا",6,"ب",3,0],["وَالعاصِمُ المَقتولُ عِندَ رَجيعِهِم","كَسَبَ المَعالي إِنَّهُ لَكَسوبُ",7,"ب",1,0],["والعارض النونيّ ما أنصفته","وإن تكن باللام قد عرفته",8,"ه",1,0],["والعاصفاتُ القاصفا","تُ المُعصراتُ الرمَّسُ",9,"س",1,0],["والعائد العرف بعد بدأته","ينفع إخوانه وينتفع",10,"ع",1,0],["والعاصِفُ الجبَّار في سُخْطِهِ","لا يَرْحَمُ الغُصْنَ الرَّشيقَ القَوِيمْ",11,"م",1,0],["والعالِمُ النَّحريرُ يُنْفِقُ عُمْرَه","في فَهْمِ ألفاظٍ ودَرسِ كِتابِ",12,"ب",1,0],["والعَارِفُو سِيما الوُجُوهِ على ال","أعْرافِ مَعْرِفَةً بلا نُكْرِ",13,"ر",1,0],["وَالعاذِلينَ في النَدى العَواذِلا","قَد فَضَلوا بِفَضلِكَ القَبائِلا",14,"ل",2,0],["وَالعارُ مَضّاضٌ وَلَيسَ بِخائِفٍ","مِن حَتفِهِ مَن خافَ مِمّا قيلا",15,"ل",2,0],["وَالعاطِفينَ عَلى المَولى حُلومَهُمُ","وَالأَمجَدينَ فَمَن جاراهُمُ مَجَدوا",16,"د",3,0],["وَالعابِطُ الكومَ لِلأَضيافِ إِذ نَزَلوا","في يَومِ صِرٍّ مِنَ الصُرّادِ هَرّارِ",17,"ر",1,0],["والعارُ في فِعلِهما المُشهَّرِ","تَشابَها في مَنْظَرٍ ومَخبَرِ",18,"ر",1,0],["وَالعارُ في رَجُلٍ يَبيتُ وَجارُهُ","طاوي الحَشى مُتَمَزِّقُ الأَطمارِ",19,"ر",1,0],["وَالعارُ في هَضمِ الضَعيفِ وَظُلمِهِ","وَإِقامةِ الأَخيارِ بِالأَشرارِ",19,"ر",1,0],["وَالعاقِبُ الحَبرُ في نَجرانَ لاحَ لَهُ","يَومَ التَباهِلِ عُقبى زَلَّةِ القَدَمِ",20,"م",1,0],["وَالعاذِلُ يُغري فيهِ إِن لامَ وَفاهُ","أَمسى في ضِرامٍ مِن نارِ الغَرام",21,"م",1,0],["والعائشينَ على الأهواء مُنزلةً","على بيانٍ بلا هَديٍ وتبيين",22,"ن",1,0],["والعازفين عن اللذائذِ همُّهمْ","\" جَرَسٌ \" يُدقُّ ومِنبرٌ وخطيب",23,"ب",1,0],["والعاملونَ عَلَى الأموال ما عَلِمُوا","مِنْ أيِّما جهة يأْتي وما شَعَرُوا",24,"ر",3,0],["والعابِدُونَ العِجْلَ قد فُتِنُوا به","ودُّوا اتِّخاذَ المُرْسَلِينَ عُجُولا",25,"ل",2,0],["وَالعامُ يَمضي دَولَتَي","نِ فَمِنهُما وَمِدٌ وَقُرُّ",26,"ر",1,0],["وَالعالَمُ اِبنٌ وَالدَهرُ والِدُهُ","نَجلٌ غَوِيٌّ وَوالِدٌ غُدَرُ",27,"ر",1,0],["والعَادِيَاتِ البَرْدَ كُلَّ عَشِيَّةٍ","قُبَّ البُطُونِ كَأَنَّهُنَّ صَوَارِي",28,"ر",2,0],["والعالِمُونَ إذا ما الأمْرُ ضاقَهُمُ","أَنَّى يُحاوَلُ فيه الوِرْدُ والصَدَرُ",29,"ر",1,0],["والعاقِرُ الكُومَ الجِلادَ إذا غَدَتْ","ريحٌ يكادُ الماءُ مِنها يُجْمُدُ",30,"د",1,0],["والعالم العربي إما نعجةٌ","مذبوحة أو حاكمٌ قصاب",31,"ب",1,0],["والعالم العربي يرهن سيفه","فحكاية الشرف الرفيع سراب",31,"ب",1,0],["والعالم العربي يخزن نفطه","في خصيتيه وربك الوهاب",31,"ب",1,0],["وألعاب صبيان تمرّ بمسرحٍ","يقوم عليه كلَّ يومٍ مُمثِّل",32,"ل",1,0],["والعالم العلوي والسفلي معا","للَه بين مكبر ومقدس",33,"س",1,0],["والعاشقاتُ حَدِيثكَ العَذْبَ الّذي","عَوَّدْتَهُنَّ عليه في حُزنٍ وغَمّْ",34,"م",1,0],["والعارفَ ابن أبي بكر سليلَ فتى","وكان نعم الفتى في كل ما يرد",35,"د",1,0],["والعارفون إذا صحَّت معارِفُهُم","للَّهِ إن صمتوا بالله إن نطقوا",36,"ق",3,0],["وَالعابِدُ الزاهِدُ الصَوّامُ إِن حَمِيَت","هَواجِرُ الصَيفِ وَالقَوّامُ بِالسَحَرِ",37,"ر",1,0],["وَالعارِضُ الهَتفُ المُجَلجِلُ صَوبُهُ","وَالمورِدُ العَذبُ النَميرُ الصافي",38,"ف",2,0],["وَالْعَامُ أَلْفُ تَقَضَّتْ بَعْدَهُ مِائَةٌ","مِنْ هِجْرَةِ الْمُنْتَفِي مِنْ بَعْثِهِ الدَّرَكُ",39,"ك",1,0],["وَالْعَالَمُ الْعُلْوِي وَالسُّفْلِي قَدْ","شَهِدَتْ بِهِ أَعْرَاضُهُ وَشُخُوصُهُ",40,"ص",2,0],["والعالم الورع الذي بعلومه","بهر ابن حنبل والأمام الأعظما",41,"م",2,0],["والعالم العلم الشهير","بعلمه بالاتفاق",42,"ق",1,0],["وَالعاشِقُ في هَواكَ ساهٍ ساهِر","يَرجو وَيَخافُ فَهوَ شاكٍ شاكِر",43,"ر",1,0],["وَالعارف القُطب المُقدَم في الوَرى","شَيخ الشَيوخ المُستَقيم الصابر",44,"ر",1,0],["والعاطفين على المصافِ خيولَهم","والمُلحقينَ رماحَهم بالقاتلِ",45,"ل",1,0],["وَالعالَمِ الناقِدِ في عِلمِهِ","وَالحاكِمِ الفاضِلِ وَالعادِلِ",46,"ل",1,0],["والعَامُ قَدْ عَامَ مِنْهُ في كَرَمٍ","أَغْرَقْتَهُ فِيهِ أَيَّ إغْرَاقِ",47,"ق",1,0],["والعاشقُ السُّمْرَ يثنيها الطعانُ كما","يثني نسيمُ الدلالِ الغادةَ الرّودا",48,"د",2,0],["والعاقل الندب لا يأوي إلى بلدٍ","إلا إذا فاض نفعا ذلك البلد",49,"د",1,0],["والعام ما عرف الحياة كأنها","معنى حواه الموت بالإضمار",50,"ر",1,0],["والعاطرات من الجنان وما أرى","إلاك ينفحها العبير الغاليا",51,"ي",2,0],["والعائشين تضاعفت أعمارهم","في موطنٍ لبنى الكماةِ الصيِّدِ",52,"د",1,0],["والعادلُ المقيم منها صعدةً","لا يظفَر الثقّافُ باعتدالها",53,"ل",3,0],["والعارُ كلّ العارِ في أديانهم","أن يُقتر الرجلُ الشريفُ ويُرملا",54,"ل",2,0],["والعاقرِ الكومَ العشار تكوسُ","فعلةَ مبدىءٍ للمكرماتِ معيد",55,"د",1,0],["والعادل الأحكام خيفة ربهِ","حيث الزمانُ كأهلهِ لم يعدل",56,"ل",1,0],["والعالم اليوم، هذا فوق خيبته","غاف، وهذا إلى أطماعه عجل",57,"ل",1,0],["والعارِفُ البَرُّ يَرُدُّ ما بَدا","لأصْلِهِ فَيَمْحَقُ الغَثَّ الصَّفا",58,"ف",2,0],["والعاج بين الأبنوس كأنه","أرض من الكافور تنبت عنبرا",59,"ر",2,0],["والعامرُ الكفّين من هذا الورى","لا يَنثني إلّا بكفٍّ بَلْقَعِ",60,"ع",1,0],["والعارفون هم الذين قد اهتدوا","فاتبعْ طريقَهمو وخذْها سُلَّما",61,"م",2,0],["والعاذلون لقد زاد دوابكم عمهاً","رفقا بقلبي الذي فيكم قضى ولهاً",62,"ه",2,0],["والعارف الذي به يتصل","وجاهل عنه هو المنفصل",63,"ل",1,0],["والعالم ليل أجمعه","يا غفلة عبد يرقده",64,"د",2,0],["والعارفون رعيتي في قبضتي","والغوث والأقطاب من خدامي",65,"م",2,0],["والعادلُ الحُكمِ لا يُرشَى على عَمَلٍ","وليسَ يَفرُقُ مخدوماً عن الخَدَمِ",66,"م",1,0],["والعاشِقُ المسكينُ في أَطْلالِهم","مِثْلُ المنَاطِق جُلنْ في أَخْصَارِهم",67,"م",1,0],["والعارِضُ الهَطِلُ المُحيي بِدَيمَتِهِ","ما لَيسَ يَجمَعُ فيه العارِضُ الهَطِلُ",68,"ل",1,0],["والعالمُ الصامتُ والناطقُ ال","باقرُ عِلماً كان أخفاهُ",69,"ا",2,0],["والعاندونُ لهم عليهمْ لَعنتي","واخصُّهمُ مِنّي بقصدِ هِجاء",70,"ا",2,0],["والعاديات من الفسطاط ضابحةً","والموريات زناد الحزن في لهب",71,"ب",1,0],["والعالِم النحرير ذو القلمِ الذي","قد كلَّلت هامَ الفخار فرائدُهُ",72,"د",2,0],["والعالم العلم الشه