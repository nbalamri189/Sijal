,"الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16631","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19362","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9976","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54524","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141963","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43642","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43870","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43738","الرجز"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9550","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54298","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[77,"يا ربة البيت الممنع جاره","https://www.poetsgate.com/ViewPoem.aspx?id=34095",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[90,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[45,"هُبِلَ الوَاشِي بهَا، أنّى أفَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=33095",""],[46,"اللَّه أكبرُ! ما اشتريتُ بِضاعةً،","https://www.poetsgate.com/ViewPoem.aspx?id=18377",""],[38,"كَمْ مِنْ أبٍ لي، يا جَرِيرُ، كَأنّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=21185",""],[105,"قصوا الحديث عن الفريق النائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55043&r=&rc=213",""]],"verses":[["شَغَلتَ عَيني دُموعاً وَالحَشى حُرَقاً","فَكَيفَ أَلَّفتَ أَمواهاً وَنيرانا",0,"ن",2,0],["شَغَلوا قِدماً عَنِ الناسِ العُلى","وَرَمَوا عَن ثُغَرِ المَجدِ الأَناما",1,"م",2,0],["شَغَلتُ بِكُم قَولي وَعِندي بَقِيَّةٌ","وَقَد يُردَفُ الظَهرُ الَّذي آدَ حَملُهُ",2,"ل",2,0],["شَغَلَ الهَمُّ أَهلَهُ وَاِستَقَلنا ال","لَيلَ مِن زَورَةِ الخَيالِ المُطيفِ",3,"ف",1,0],["شَغَلتُ بِكُنَّ النَفسَ عَن كُلِّ حاجَةٍ","وَهَيهاتَ مِن شُغلٍ بِكُنَّ فَراغُ",4,"غ",1,0],["شَغَلوا مَلابِسَها فَلَم يَدَعوا","لِلناسِ إِلّا الدَنِسَ اللُبُسا",5,"س",2,0],["شُغِلتُ بِالمَجدِ عَمّا يُستَلَذُّ بِهِ","وَقائِمُ اللَيلِ لا يَلوي عَلى السَمَرِ",6,"ر",1,0],["شَغَلَ الدُموعَ عَنِ الدِيارِ بُكاؤُنا","لِبُكاءِ فاطِمَةٍ عَلى أَولادِها",7,"د",3,0],["شُغِلتُ بِالهَمِّ حَتّى ما يُفَرِّحُني","لَولا الخَليفَةُ نوروزٌ وَلا عيدُ",8,"د",1,0],["شَغَلتُ قَريضي بالنَّسيبِ فَأَصبَحَتْ","شَوارِدُهُ في الخافِقَيْنِ تَجولُ",9,"ل",1,0],["شُغِلتُ بِذِكرِ عَبلَةَ عَن سِواه","وَقُلتُ لِصاحِبي هَذا المَرامُ",10,"م",1,0],["شُغِفَتْ به بيضُ الصّوارم في الطُّلا","ووَفَتْ بأوْكارِ الرّدى أوْتارُهُ",11,"ر",2,0],["شُغِلْتُ بيوْمِ العرْضِ عمّنْ وسيلَتي","الى اللّهِ يوْمَ العرْضِ رحْمَةُ جدِّهِ",12,"د",2,1],["شَغَلَت قَلبها عَليَّ فَراغاً","هَل سَمِعتُم بِفارغٍ مِشغولِ",13,"ل",1,0],["شُغِلوا عَن أَديبِهِم بِمُنَجّي","هِم فَلَم يَسمَعوا نِداءَ النُعاةِ",14,"ه",1,0],["شَغَلَتكَ الجُهودُ وَالداءُ يَمشي","فيكِ مَشيَ المُحاذِرِ المُغتالِ",15,"ل",1,0],["شَغَلَتكَ عَن دُنياكَ أَربَعَةٌ","وَالمَرءُ مِن دُنياهُ في شُغُلِ",16,"ل",1,0],["شغفتني تلك المليحة حتى","علّمتني بكر الهوى وعوانه",17,"ن",2,0],["شغل الكاتبين وصفك حتى","لا دويّاً أبقوا ولا أقلاما",18,"م",2,0],["شغلتنا الدنيا بلهوٍ ولعبٍ","فغفلنا والموت بالمرصاد",19,"د",1,0],["شَغَفَ القُلوبَ وَما تُقَضّى حاجَةٌ","مِثلُ المَها بِصَريمَةِ الحَومانِ",20,"ن",1,0],["شغلَ القرائح بالدعاءِ الصالح","إشغالُ وقتك عن قريض المادح",21,"ح",1,1],["شغلاً وتدبيراً بمملكةٍ رأت","منك الجميلَ فأعرضت عن طامح",21,"ح",1,0],["شغلتمُ بصباحِ الأنس مبتسماً","وناظري بظلامِ الليل مشغول",22,"ل",1,0],["شغلت بذكراه ومدح محمدٍ","فيا لك من حسن لديَّ وإحسان",23,"ن",1,0],["شغلَ الكبار من الرعيَّة فكرهم","في شأنهم فكبارنا كصغارنا",24,"ن",2,1],["شغف العذار بخدِّه ورآه قد","نعست نواظره فدبَّ عليهِ",25,"ه",1,0],["شغلتك الذنوبُ عنّا فأعرض","تَ عن الصالحات للفَحْشاءِ",26,"ا",2,0],["شَغَلتْ موضعَ الكُنى لا بلِ الأسْ","ماء منهم قبائحُ الألقابِ",27,"ب",1,0],["شُغْلي بإطراءِ الذي مَهْمَا ادَّعَى","مُطْرِيهِ أعربَ عنه بالتَّصْحيحِ",28,"ح",1,0],["شُغِلْتُ عنك بِعُوَّارٍ أكابِدُهُ","لا بالملاهي ولا ماءِ العَناقيدِ",29,"د",1,0],["شَغَلَتْنا عن نصيبٍ وافرٍ","من سرورٍ بك يا ذُخْر الأبدْ",30,"د",1,0],["شُغِلت بصيد الظبي حتى اقتنصتُهُ","وها هو ذا قد قَبَّضتْهُ الأظافر",31,"ر",1,0],["شغلْتُهُ بالهواهي عن معيشتِه","وذاك أنِّي عليه غيرُ مُحتاط",32,"ط",1,0],["شُغِفْتُ بالخرَّد الحِسان وما","يصلحُ وجهي إلا لذي ورع",33,"ع",1,0],["شغَلَ المجدُ قلبه ويديه","والقوافي بمدحهِ مشغولهْ",34,"ل",2,0],["شغَلَ المُحبَّ عن الرسو","مِ وإن غدتْ مثلَ الوُشومِ",35,"م",1,1],["شُغِفَت بِالبَدرِ حُبّاً فَهيَ لا","تَعرِفُ الغَمضَ إِلى أَن يُسفَرا",36,"ر",2,0],["شَغَلَ الدَهرُ عَن لِقاءِ حَبيبٍ","هاتِ قُل لي مَتى وَكَيفَ وَأَينا",37,"ن",2,0],["شَغّارَةٌ تَقِذُ الفَصيلَ بِرِجلِها","فَطّارَةٌ لِقَوادِمِ الأَبكارِ",38,"ر",1,0],["شَغَلَتْهُمُ عنكَ الحَيَاةُ","وحَرْبُ هذي الكائنَاتْ",39,"ت",1,0],["شغل الناس منذ كان بشعر","قاله معجزا لكل أديب",40,"ب",1,0],["شغلتهم عن الحسود المعالي","إنما يُحسد العظيم ويُشنا",41,"ن",2,0],["شُغلُها الفارُ تُنَقّي ال","رَفَّ مِنهُ وَالسَقيفَه",42,"ف",2,0],["شَغَلَتهُ أَشغالٌ عَنِ الآرامِ","وَقَضى اللُبانَةَ مِن هَوىً وَغَرامِ",43,"م",1,1],["شُغِلَ المَشايِخُ بِالمَتابِ وَشُغلُهُ","بِتَبَدُّلِ الأَزواجِ وَالأَصهارِ",44,"ر",1,0],["شَغَلَ الزَّمانُ كَرَاكَ في ديوانهِ","فَتَفَرَّغَتْ لِدَواتِكَ الأَقْلامُ",45,"م",1,0],["شَغَلتَ قَلبي بِلَحظِ عَيني","إِلَيكَ عَن حُسنِ ذا الغِناءِ",46,"ا",2,0],["شَغَلَت قَلبَهُ حِسانُ المَعالي","عَن حِسانِ الوُجوهِ وَالأَعجازِ",47,"ز",1,0],["شغْلي عن الرّبع أن أُسائلَه","وأن أطيلَ البُكاء في خَلَقِهْ",48,"ق",2,1],["شُغِفتْ بدعوَتِهِ المنابرُ يافعاً","وصبا إِليهِ المُلكُ وهو جنينُ",49,"ن",1,0],["شُغِلَ الرَقيبُ وَأَسعَدَتنا خَلوَةٌ","في هَجرِ هَجرٍ وَاِجتِنابِ تَجَنُّبِ",50,"ب",1,0],["شَغَفاً بِقُربِكَ دونَ رَأيِ المُرتَئي","وَمَوَدَّةً لَكَ فَوقَ حَسبِ الحاسِبِ",51,"ب",1,0],["شُغلانِ مِن عَذلِ وَمِن تَفنيدِ","وَرَسيسِ حُبٍّ طارِفٍ وَتَليدِ",52,"د",1,1],["شَغَلَ الحَمدَ وَالثَناءَ جَميعاً","عَن جَميعِ الوَرى نَوالُ الأَميرِ",53,"ر",1,0],["شَغَلَ الحاسِدينَ أَن لَم يَبيتوا","قَطُّ مِن هَمِّهِ وَلا أَشغالِه",54,"ل",2,0],["شَغَلَ المُدافِعَ عَن مَحالَةِ كَيدِهِ","وَأَذَلَّ جَبّارَ البِلادِ الأَعظَما",55,"م",2,0],["شَغَلوا عَلى غَطَفانَ شَأساً في الوَغى","وَبَنو جَذيمَةَ شاهِدوهُ وَحِذيَمِ",56,"م",1,0],["شُغِفَ السَحابُ بِها فَرَوّى زَهرَها","رَيقاً فَراحَ كَرائِحٍ نَشوانِ",57,"ن",1,0],["شغَلَتني الدموعُ فيه فما أَع","رفُ إلا بفَيضِهنَّ اشتِغَالا",58,"ل",2,0],["شغَلَتْكَ عن حُسْنِ السَّماعِ مَدائِحٌ","حَسُنَتْ فما تَنفَكُّ تُطْرِبُ سامِعا",59,"ع",2,0],["شغلَتْ روائِحُهُ العَجاجَ وطيبُها","بين القَنا عن طيبِ ريحِ المِجمَر",60,"ر",1,0],["شَغَلْتُ بها قلوبَ النّاسِ طُرّاً","فما تَنفَكُّ نَسْخاً أو نَشيدا",61,"د",2,0],["شَغَفاً بذي القُربانِ يصدُقُ أنه","ينشقُّ من نَسَبٍ إليه قُرابِ",62,"ب",1,0],["شُغِلَ الخَلائِقُ بِالحَياةِ وَأَغفَلوا","زَمَناً حَوادِثُهُ عَلَيهِم تَقتَرِع",63,"ع",1,0],["شُغِلَ الأُلى كَنَزوا الكُنوزَ عَنِ التُقى","وَسَهوا بِباطِلِهِم عَنِ الآجالِ",64,"ل",1,0],["شُغِلَ المِسكينُ عَن تِلكَ المِحَن","فارَقَ الروحَ وَأَخلى مِن بَدَن",65,"ن",1,1],["شُغِفنا بِها وَالعِزُّ قَد مَدَّ ظِلَّهُ","عَلَينا وَوَجهُ الأَرضِ هَشٌّ لَنا بَشُّ",66,"ش",1,0],["شَغَلتَ صُروفَ الحادِثاتِ عَنِ الوَرى","فَأَبصارُها كُمهٌ وَأَسماعُها طُرشُ",66,"ش",1,0],["شُغِفتُ بِذي جَنَفٍ بَيِّنٍ","بِنَزغٍ تَبَيَّنَ في غَيبَتي",67,"ت",2,0],["شَغَلَ الطُيورَ بِحُسنِ مَنظَرِ وَجهِهِ","فَتَوَقَّفَت فَأَصابَها بِالبُندُقِ",68,"ق",1,0],["شُغلنَ عن الحياة ونمنَ عنها","وبتنَ بمن نحِبُّ موكلينَا",69,"ن",2,0],["شُغِلَت قُلوبُ الناسِ ثُمَّ عُيونُهُم","مُذ مُتَّ بِالخَفقانِ وَالهَمَلانِ",70,"ن",1,0],["شُغِلْتُ بحبِّ العلمِ عن رفعةِ القضا","أيلوي على الأصدافِ مَنْ قصدُهُ الدرُّ",71,"ر",1,0],["شُغِفَ الفُؤادُ بِجارَةِ الجَنبِ","فَظَلِلتُ ذا أَسَفٍ وَذا كَربِ",72,"ب",1,1],["شُغِلَ الفوارسُ بالوَغى وأراهمُ","شُغلوا بِبَيْعٍ خاسرٍ وشراءِ",73,"ا",2,0],["شُغِفَت بِهِ وَاِهتاجَ مِن بُرَحائِهِ","شَوقٌ إِلَيها في الجَوانِحِ وارِ",74,"ر",1,0],["شُغِفنا بِوادي النيلِ إِذ نَحنُ أَهلُهُ","فَأَحبِب بِنا أَهلاً وَبِالنيلِ وادِيا",75,"ي",2,0],["شَغَلَ القتالُ عن الصلاةِ وإنّها","سَكَنٌ لنا من ربِّنا وثوابُ",76,"ب",1,0],["شُغِلَ الأهلُ عن الأهلِ فيا","عجباً للدهر ماذا صنعا",77,"ع",2,0],["شُغِلَتْ بها الدُّنيا وما هي بالتّي","تُعْنَى بدنيا الجاهلين وتُشغَلُ",78,"ل",1,0],["شَغَفٌ قُيِّدَ ما يَبرَحُني","وَفُؤادٌ مولَعٌ بِالطَيَرانِ",79,"ن",1,0],["شَغفت بِها وَمَن يبلُ","غَرائبَ دلّها يَشغف",80,"ف",1,0],["شَغَلوا مُؤازَرَتي عَلَي","كَ الآنَ فَاِبتَغِ مَن تُؤازِر",81,"ر",1,0],["شَغَلَتهُ لَواقِحٌ مَلَأَتهُ","عِبرَةً فَهوَ خَلفَهُنَّ كَمِيُّ",82,"ي",1,0],["شَغَلَ الفُؤادَ بِكُربَةٍ","قَبَضَت عَلَيهِ وَصارَ خِلوا",83,"و",2,0],["شُغِلتُ بِلَذَّةِ القُبَلِ","وَوَعدِ الكُتبِ وَالرُسُلِ",84,"ل",1,1],["شَغَلتُ هُمومَ النَفسِ عَنّي بِرِحلَةٍ","فَأَصبَحتُ مِنها فَوقَ رَحلي وَأَمسَيتُ",85,"ت",1,0],["شَغَلَتهُم دُنياهُ تَأكُلُ مِن دَر","رَت عَلَيهِ بِالحِرصِ وَالتَرغيبِ",86,"ب",1,0],["شُغِفَتْ بِهِ الدُّنْيَا وآثَرَ أُخْتَهَا","حُبَّاً فَأَوْهَمَ رَغْبَةً بِتَزَهُّدِ",87,"د",1,0],["شَغلوا الفيلَ عليه في الوغى","بتُوامِ الطَّعْنِ في الخَطْوِ الفُراد",88,"د",1,0],["شَغَلَت خِداشاً عَن مَساعي مَخلَدِ","خَمرٌ تَوَقَّدُ في صِحافِ العَسجَدِ",89,"د",1,1],["شَغَلَتني المُدامُ وَالقَصفُ عَنها","وَقِراعُ الطُنبورِ وَالأَوتارِ",90,"ر",1,0],["شُغلي بحبّكِ يا مليحةُ ليس لي","قلبانِ مشغولٌ وآخر صاحِ",91,"ح",1,0],["شَغَلتُ بِها نَفسي فَلَستُ بِفارِغٍ","لِدانٍ يُرَجّيني وَلا لِبَعيدِ",92,"د",1,0],["شُغِلَت نَفسِيَ عَن وَصفِ الهَوى","بِاِشتِياقي أَن أَراها وَطَرَب",93,"ب",1,0],["شَغَلَتهُ بِحُبِّها","عَن حِسابِ المُحاسِبِ",94,"ب",1,0],["شُغولٌ يَنقَضَينَ بِغَيرِ حَمدٍ","وَلا يَرجِعنَ إِلّا بِالتَبابِ",95,"ب",1,0],["شَغيلَ السَعادَةَ عَنكَ أَهلُ مَمالِكٍ"