m14297.html","الطويل"],[442,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[444,"شغلتني حوادث الدهر عنكم","https://www.aldiwan.net/poem55943.html","عموديه"],[459,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[459,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[462,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[462,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[465,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[465,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[465,"شغفي بأعطاف الغصون الهيف","https://www.aldiwan.net/poem3453.html","عموديه"],[465,"شاق الحمام برامتين فغردا","https://www.aldiwan.net/poem3584.html","عموديه"],[480,"تذكرت من أهوى وما كنت ناسيا","https://www.aldiwan.net/poem37062.html","الطويل"],[480,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[483,"فاشهدوا أني غلام","https://www.aldiwan.net/poem24340.html","عموديه"],[501,"حسد الولي الجاهل","https://www.aldiwan.net/poem37807.html","مجزوء الكامل"],[501,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[505,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[514,"يا قلب قد خان من كلفت به","https://www.aldiwan.net/poem67742.html","المنسرح"],[515,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[515,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[516,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[516,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[516,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[530,"شغل الفؤاد بحاجة","https://www.aldiwan.net/poem37367.html","مجزوء الكامل"],[552,"أقول لها لما التقينا على منى","https://www.aldiwan.net/poem47696.html","الطويل"],[552,"أعلى العهد منزل بالجناب","https://www.aldiwan.net/poem48064.html","الخفيف"],[554,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[559,"شملتني بثوبها المنقوش","https://www.aldiwan.net/poem33547.html","الخفيف"],[559,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[563,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[563,"غضي جفونك يا عيون النرجس","https://www.aldiwan.net/poem52891.html","الكامل"],[565,"فؤادي قد أغواه من بعد رشده","https://www.aldiwan.net/poem901.html",""],[568,"ولها من الأوتار حين تجسها","https://www.aldiwan.net/poem69596.html","الكامل"],[576,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[576,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[576,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"],[576,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[576,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[587,"لما رأت عشاقها قد أحدقوا","https://www.aldiwan.net/poem17630.html","الكامل"]],"verses":[["شَغَلتَ عَيني دُموعاً وَالحَشى حُرَقاً","فَكَيفَ أَلَّفتَ أَمواهاً وَنيرانا",0,"ن",2,0],["شَغَلوا قِدماً عَنِ الناسِ العُلى","وَرَمَوا عَن ثُغَرِ المَجدِ الأَناما",1,"م",2,0],["شَغَلتُ بِكُم قَولي وَعِندي بَقِيَّةٌ","وَقَد يُردَفُ الظَهرُ الَّذي آدَ حَملُهُ",2,"ل",2,0],["شَغَلَ الهَمُّ أَهلَهُ وَاِستَقَلنا ال","لَيلَ مِن زَورَةِ الخَيالِ المُطيفِ",3,"ف",1,0],["شَغَلتُ بِكُنَّ النَفسَ عَن كُلِّ حاجَةٍ","وَهَيهاتَ مِن شُغلٍ بِكُنَّ فَراغُ",4,"غ",1,0],["شَغَلوا مَلابِسَها فَلَم يَدَعوا","لِلناسِ إِلّا الدَنِسَ اللُبُسا",5,"س",2,0],["شُغِلتُ بِالمَجدِ عَمّا يُستَلَذُّ بِهِ","وَقائِمُ اللَيلِ لا يَلوي عَلى السَمَرِ",6,"ر",1,0],["شَغَلَ الدُموعَ عَنِ الدِيارِ بُكاؤُنا","لِبُكاءِ فاطِمَةٍ عَلى أَولادِها",7,"د",3,0],["شُغِلتُ بِالهَمِّ حَتّى ما يُفَرِّحُني","لَولا الخَليفَةُ نوروزٌ وَلا عيدُ",8,"د",1,0],["شَغَلتُ قَريضي بالنَّسيبِ فَأَصبَحَتْ","شَوارِدُهُ في الخافِقَيْنِ تَجولُ",9,"ل",1,0],["شُغِلتُ بِذِكرِ عَبلَةَ عَن سِواه","وَقُلتُ لِصاحِبي هَذا المَرامُ",10,"م",1,0],["شُغِفَتْ به بيضُ الصّوارم في الطُّلا","ووَفَتْ بأوْكارِ الرّدى أوْتارُهُ",11,"ر",2,0],["شُغِلْتُ بيوْمِ العرْضِ عمّنْ وسيلَتي","الى اللّهِ يوْمَ العرْضِ رحْمَةُ جدِّهِ",12,"د",2,1],["شَغَلَت قَلبها عَليَّ فَراغاً","هَل سَمِعتُم بِفارغٍ مِشغولِ",13,"ل",1,0],["شُغِلوا عَن أَديبِهِم بِمُنَجّي","هِم فَلَم يَسمَعوا نِداءَ النُعاةِ",14,"ه",1,0],["شَغَلَتكَ الجُهودُ وَالداءُ يَمشي","فيكِ مَشيَ المُحاذِرِ المُغتالِ",15,"ل",1,0],["شَغَلَتكَ عَن دُنياكَ أَربَعَةٌ","وَالمَرءُ مِن دُنياهُ في شُغُلِ",16,"ل",1,0],["شغفتني تلك المليحة حتى","علّمتني بكر الهوى وعوانه",17,"ن",2,0],["شغل الكاتبين وصفك حتى","لا دويّاً أبقوا ولا أقلاما",18,"م",2,0],["شغلتنا الدنيا بلهوٍ ولعبٍ","فغفلنا والموت بالمرصاد",19,"د",1,0],["شَغَفَ القُلوبَ وَما تُقَضّى حاجَةٌ","مِثلُ المَها بِصَريمَةِ الحَومانِ",20,"ن",1,0],["شغلَ القرائح بالدعاءِ الصالح","إشغالُ وقتك عن قريض المادح",21,"ح",1,1],["شغلاً وتدبيراً بمملكةٍ رأت","منك الجميلَ فأعرضت عن طامح",21,"ح",1,0],["شغلتمُ بصباحِ الأنس مبتسماً","وناظري بظلامِ الليل مشغول",22,"ل",1,0],["شغلت بذكراه ومدح محمدٍ","فيا لك من حسن لديَّ وإحسان",23,"ن",1,0],["شغلَ الكبار من الرعيَّة فكرهم","في شأنهم فكبارنا كصغارنا",24,"ن",2,1],["شغف العذار بخدِّه ورآه قد","نعست نواظره فدبَّ عليهِ",25,"ه",1,0],["شغلتك الذنوبُ عنّا فأعرض","تَ عن الصالحات للفَحْشاءِ",26,"ا",2,0],["شَغَلتْ موضعَ الكُنى لا بلِ الأسْ","ماء منهم قبائحُ الألقابِ",27,"ب",1,0],["شُغْلي بإطراءِ الذي مَهْمَا ادَّعَى","مُطْرِيهِ أعربَ عنه بالتَّصْحيحِ",28,"ح",1,0],["شُغِلْتُ عنك بِعُوَّارٍ أكابِدُهُ","لا بالملاهي ولا ماءِ العَناقيدِ",29,"د",1,0],["شَغَلَتْنا عن نصيبٍ وافرٍ","من سرورٍ بك يا ذُخْر الأبدْ",30,"د",1,0],["شُغِلت بصيد الظبي حتى اقتنصتُهُ","وها هو ذا قد قَبَّضتْهُ الأظافر",31,"ر",1,0],["شغلْتُهُ بالهواهي عن معيشتِه","وذاك أنِّي عليه غيرُ مُحتاط",32,"ط",1,0],["شُغِفْتُ بالخرَّد الحِسان وما","يصلحُ وجهي إلا لذي ورع",33,"ع",1,0],["شغَلَ المجدُ قلبه ويديه","والقوافي بمدحهِ مشغولهْ",34,"ل",2,0],["شغَلَ المُحبَّ عن الرسو","مِ وإن غدتْ مثلَ الوُشومِ",35,"م",1,1],["شُغِفَت بِالبَدرِ حُبّاً فَهيَ لا","تَعرِفُ الغَمضَ إِلى أَن يُسفَرا",36,"ر",2,0],["شَغَلَ الدَهرُ عَن لِقاءِ حَبيبٍ","هاتِ قُل لي مَتى وَكَيفَ وَأَينا",37,"ن",2,0],["شَغّارَةٌ تَقِذُ الفَصيلَ بِرِجلِها","فَطّارَةٌ لِقَوادِمِ الأَبكارِ",38,"ر",1,0],["شَغَلَتْهُمُ عنكَ الحَيَاةُ","وحَرْبُ هذي الكائنَاتْ",39,"ت",1,0],["شغل الناس منذ كان بشعر","قاله معجزا لكل أديب",40,"ب",1,0],["شغلتهم عن الحسود المعالي","إنما يُحسد العظيم ويُشنا",41,"ن",2,0],["شُغلُها الفارُ تُنَقّي ال","رَفَّ مِنهُ وَالسَقيفَه",42,"ف",2,0],["شَغَلَتهُ أَشغالٌ عَنِ الآرامِ","وَقَضى اللُبانَةَ مِن هَوىً وَغَرامِ",43,"م",1,1],["شُغِلَ المَشايِخُ بِالمَتابِ وَشُغلُهُ","بِتَبَدُّلِ الأَزواجِ وَالأَصهارِ",44,"ر",1,0],["شَغَلَ الزَّمانُ كَرَاكَ في ديوانهِ","فَتَفَرَّغَتْ لِدَواتِكَ الأَقْلامُ",45,"م",1,0],["شَغَلتَ قَلبي بِلَحظِ عَيني","إِلَيكَ عَن حُسنِ ذا الغِناءِ",46,"ا",2,0],["شَغَلَت قَلبَهُ حِسانُ المَعالي","عَن حِسانِ الوُجوهِ وَالأَعجازِ",47,"ز",1,0],["شغْلي عن الرّبع أن أُسائلَه","وأن أطيلَ البُكاء في خَلَقِهْ",48,"ق",2,1],["شُغِفتْ بدعوَتِهِ المنابرُ يافعاً","وصبا إِليهِ المُلكُ وهو جنينُ",49,"ن",1,0],["شُغِلَ الرَقيبُ وَأَسعَدَتنا خَلوَةٌ","في هَجرِ هَجرٍ وَاِجتِنابِ تَجَنُّبِ",50,"ب",1,0],["شَغَفاً بِقُربِكَ دونَ رَأيِ المُرتَئي","وَمَوَدَّةً لَكَ فَوقَ حَسبِ الحاسِبِ",51,"ب",1,0],["شُغلانِ مِن عَذلِ وَمِن تَفنيدِ","وَرَسيسِ حُبٍّ طارِفٍ وَتَليدِ",52,"د",1,1],["شَغَلَ الحَمدَ وَالثَناءَ جَميعاً","عَن جَميعِ الوَرى نَوالُ الأَميرِ",53,"ر",1,0],["شَغَلَ الحاسِدينَ أَن لَم يَبيتوا","قَطُّ مِن هَمِّهِ وَلا أَشغالِه",54,"ل",2,0],["شَغَلَ المُدافِعَ عَن مَحالَةِ كَيدِهِ","وَأَذَلَّ جَبّارَ البِلادِ الأَعظَما",55,"م",2,0],["شَغَلوا عَلى غَطَفانَ شَأساً في الوَغى","وَبَنو جَذيمَةَ شاهِدوهُ وَحِذيَمِ",56,"م",1,0],["شُغِفَ السَحابُ بِها فَرَوّى زَهرَها","رَيقاً فَراحَ كَرائِحٍ نَشوانِ",57,"ن",1,0],["شغَلَتني الدموعُ فيه فما أَع","رفُ إلا بفَيضِهنَّ اشتِغَالا",58,"ل",2,0],["شغَلَتْكَ عن حُسْنِ السَّماعِ مَدائِحٌ","حَسُنَتْ فما تَنفَكُّ تُطْرِبُ سامِعا",59,"ع",2,0],["شغلَتْ روائِحُهُ العَجاجَ وطيبُها","بين القَنا عن طيبِ ريحِ المِجمَر",60,"ر",1,0],["شَغَلْتُ بها قلوبَ النّاسِ طُرّاً","فما تَنفَكُّ نَسْخاً أو نَشيدا",61,"د",2,0],["شَغَفاً بذي القُربانِ يصدُقُ أنه","ينشقُّ من نَسَبٍ إليه قُرابِ",62,"ب",1,0],["شُغِلَ الخَلائِقُ بِالحَياةِ وَأَغفَلوا","زَمَناً حَوادِثُهُ عَلَيهِم تَقتَرِع",63,"ع",1,0],["شُغِلَ الأُلى كَنَزوا الكُنوزَ عَنِ التُقى","وَسَهوا بِباطِلِهِم عَنِ الآجالِ",64,"ل",1,0],["شُغِلَ المِسكينُ عَن تِلكَ المِحَن","فارَقَ الروحَ وَأَخلى مِن بَدَن",65,"ن",1,1],["شُغِفنا بِها وَالعِزُّ قَد مَدَّ ظِلَّهُ","عَلَينا وَوَجهُ الأَرضِ هَشٌّ لَنا بَشُّ",66,"ش",1,0],["شَغَلتَ صُروفَ الحادِثاتِ عَنِ الوَرى","فَأَبصارُها كُمهٌ وَأَسماعُها طُرشُ",66,"ش",1,0],["شُغِفتُ بِذي جَنَفٍ بَيِّنٍ","بِنَزغٍ تَبَيَّنَ في غَيبَتي",67,"ت",2,0],["شَغَلَ الطُيورَ بِحُسنِ مَنظَرِ وَجهِهِ","فَتَوَقَّفَت فَأَصابَها بِالبُندُقِ",68,"ق",1,0],["شُغلنَ عن الحياة ونمنَ عنها","وبتنَ بمن نحِبُّ موكلينَا",69,"ن",2,0],["شُغِلَت قُلوبُ الناسِ ثُمَّ عُيونُهُم","مُذ مُتَّ بِالخَفقانِ وَالهَمَلانِ",70,"ن",1,0],["شُغِلْتُ بحبِّ العلمِ عن رفعةِ القضا","أيلوي على الأصدافِ مَنْ قصدُهُ الدرُّ",71,"ر",1,0],["شُغِفَ الفُؤادُ بِجارَةِ الجَنبِ","فَظَلِلتُ ذا أَسَفٍ وَذا كَربِ",72,"ب",1,1],["شُغِلَ الفوارسُ بالوَغى وأراهمُ","شُغلوا بِبَيْعٍ خاسرٍ وشراءِ",73,"ا",2,0],["شُغِفَت بِهِ وَاِهتاجَ مِن بُرَحائِهِ","شَوقٌ إِلَيها في الجَوانِحِ وارِ",74,"ر",1,0],["شُغِفنا بِوادي النيلِ إِذ نَحنُ أَهلُهُ","فَأَحبِب بِنا أَهلاً وَبِالنيلِ وادِيا",75,"ي",2,0],["شَغَلَ القتالُ عن الصلاةِ وإنّها","سَكَنٌ لنا من ربِّنا وثوابُ",76,"ب",1,0],["شُغِلَ الأهلُ عن الأهلِ فيا","عجباً للدهر ماذا صنعا",77,"ع",2,0],["شُغِلَتْ بها الدُّنيا وما هي بالتّي","تُعْنَى بدنيا الجاهلين وتُشغَلُ",78,"ل",1,0],["شَغَفٌ قُيِّدَ ما يَبرَحُني","وَفُؤادٌ مولَعٌ بِالطَيَرانِ",79,"ن",1,0],["شَغفت بِها وَمَن يبلُ","غَرائبَ دلّها يَشغف",80,"ف",1,0],["شَغَلوا مُؤازَرَتي عَلَي","كَ الآنَ فَاِبتَغِ مَن تُؤازِر",81,"ر",1,0],["ش