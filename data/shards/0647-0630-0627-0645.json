m37427.html","مجزوء الكامل"],[561,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[561,"يحبني وأنا المعدوم لم أزل","https://www.aldiwan.net/poem34199.html","البسيط"],[561,"عبادة للغافلين تكليف","https://www.aldiwan.net/poem34356.html","المنسرح"],[561,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[561,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[561,"إن رمت بالمثل التقريب مقتصدا","https://www.aldiwan.net/poem34599.html","البسيط"],[561,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[565,"هذا مقام لابن أحمد قد حكى","https://www.aldiwan.net/poem52554.html","البسيط"],[565,"هذا مقام السيد العلم الذي","https://www.aldiwan.net/poem52622.html","الكامل"],[565,"هذا مقام خليل الله نحسبه","https://www.aldiwan.net/poem52631.html","البسيط"],[565,"هذا مكان للطهارة والنقا","https://www.aldiwan.net/poem52642.html","الكامل"],[565,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[565,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[578,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2532","الكامل"],[1198,"","https://poetry.dctabudhabi.ae/diwan/poem/97745","البسيط"]],"verses":[["هَذا مَنارُ البَرلَمانِ أَمامَكُم","لِهُدى السَبيلِ كَإِبرَةِ المَلّاحِ",0,"ح",1,0],["هَذا مِنَ العُربِ لا يُلوي بِهِ فَزَعٌ","وَذاكَ أَروَعُ مِن آسادِ خَفّانِ",1,"ن",1,0],["هَذا مِنَ الغَربِ قَد سالَت مَراكِبُهُ","وَذا مِنَ الشَرقِ قَد أَوفى بِطوفانِ",2,"ن",1,0],["هَذَا مُحَيَّاك المُضِيءُ وَهَذِهِ","حُرَقُ النُّهَى فِي ذَائِبَاتِ الأَعْظُمِ",3,"م",1,0],["هَذا مُصابٌ ما أُصيبَ بِمِثلِهِ","بَشَرٌ مِنَ المَخلوقِ إِلّا",4,"ل",2,0],["هَذا مَشابِهُ مِن خَرقاءَ نَعرِفُها","وَالعَينُ وَاللَونُ وَالكَشحانِ وَالجيدُ",5,"د",1,0],["هذا مزاحٌ يا أخي كُلُّهُ","لشانئيك الشَجَبُ الشاجبُ",6,"ب",1,0],["هذا مقامٌ يا بني وائل","من مستجيرٍ بكُمُ عائذِ",7,"ذ",1,1],["هذا مقام المستجي","ر وأنت أكرمُ من يُجيرُ",8,"ر",1,0],["هذا مقالُ الحاسديك برغْمِهم","ولهم من الحسدِ المُمِضّ تململُ",9,"ل",1,0],["هَذا مَقامٌ لا التَفَجُّعُ سُبَّةُ","فيهِ وَلا الصَبرُ الجَميلُ جَميلُ",10,"ل",1,0],["هَذا مَجالٌ لِلفَتى أَن يَزدَهي","فيهِ وَلِلحَسناءِ أَن تَختالا",11,"ل",2,0],["هذا مصيري يا بني","أُمِّي فما أَشقى المصيرْ",12,"ر",1,0],["هذا ما دِرٌ","الجوع يا أخي ولا الأكل معه",13,"ه",1,1],["هذا مقام القول فيك ولم يزل","لك في الضمائر محفل ومقام",14,"م",1,0],["هَذا مَقامٌ مِنَ الرَحمَنِ مُقتَبَسٌ","تَرمي مَهابَتُهُ سَحبانَ بِالبَكَمِ",15,"م",1,0],["هَذا مَقامٌ أَنتَ فيهِ مُحَمَّدٌ","وَالرِفقُ عِندَ مُحَمَّدٍ مَأمولُ",16,"ل",1,0],["هَذا مَقامٌ كُلُّ عِزٍّ دونَهُ","شَمسُ النَهارِ بِمِثلِهِ لَم تَطمَعِ",17,"ع",1,0],["هَذا مُقامٌ أَنتَ فيهِ مُحَمَّدٌ","أَعداءُ ذاتِكَ فِرقَةٌ في النارِ",18,"ر",1,0],["هَذا مَقامُ الأُمَّها","تِ فَهَل قَدَرتَ الأُمَّهاتِ",19,"ت",1,0],["هذا مكان \"أبي المعتز\".. منتظرٌ","ووجه \"فائزةٍ\" حلوٌ ولماح",20,"ح",1,0],["هَذا مُحِبُّكَ أَدمى الشَوقُ مُهجَتَهُ","فَكَيفَ تُنكِرُ أَن تَدمى مَآقيهِ",21,"ي",2,0],["هَذا مُحَمَّدٌ الَّذي لَم أَنتَصِف","إِلّا بِهِ مِن نائِباتِ زَماني",22,"ن",2,0],["هَذا مَقامُ شُنوعٍ لا خَفاءَ بِهِ","أَلا تَخَفنَ مِنَ الأَعداءِ وَالرُقُبِ",23,"ب",1,0],["هذا مَجالُكَ فَارْكُضْ غيرَ مُتَّئِدٍ","وإنْ رأيتَ المنايا جُوَّلاً فَجُلِ",24,"ل",1,0],["هذا مكانكِ عالياً ما مِثلُه","في السُّؤدُدِ العالي مَكانٌ يُؤثَرُ",25,"ر",1,0],["هذا مكانُكَ لا العطاءُ مُقَتَّرٌ","عِندَ الإلهِ ولا الجزاءُ مُضَيَّعُ",26,"ع",1,0],["هذا مَقَامُ محمدٍ في قومِهِ","هل لامرئٍ في الدهرِ مِثلُ مَقامِهِ",27,"م",2,0],["هذا معدٌّ والخلائق كلها","هذا المعز متوَّجاً والدّين",28,"ن",1,0],["هَذا مَقالٌ سَمِجُ","عَلَيكَ فيهِ حَرَجُ",29,"ج",1,1],["هَذا مَقالي لَكُم وَاللَهُ يُرشِدُكُم","وَيَعلَمُ اللَهُ رَبّي الواحِدُ الصَمَدُ",30,"د",1,0],["هذا مقامُ خادمِ الشّيطانِ","ومَن عَصى خليفَةَ الرحمنِ",31,"ن",1,0],["هَذَا مَقَامُ التَّهِنئَآتِ فَقِفْ لَدَى","أَسْمَى أَميرٍ فِي أَجَلِّ جَنَابِ",32,"ب",1,0],["هَذا مِثالُك لاَحَ يَرْعَانا وَقدْ","كشفَ الجَوَى عَنه الحِجَابَ فَأَشْرَفا",33,"ف",2,0],["هذا مِثالُكَ نُصْبَ أَعْيُنِنا","أَجَلاَ مُحَيّاً أَمْ جلاَ بَدْرا",34,"ر",2,0],["هذا مَحَلٌّ لا أُحِبُّ حُلولَهُ","وَالمَحلُ أَقصَدَني إِلَيهِ وَأَشخَصا",35,"ص",2,0],["هذا مقامك في دنياك غايته","بدءا وما نقص المقدار مختتما",36,"م",2,0],["هذا ما جدّ ، ولا أدري","ماذا سيجدّ ، وما يبلى",37,"ل",2,0],["هذا ما أعىّ حارسه","بل هذا حارسه أخشن",38,"ن",1,0],["هذا مقامٌ لا يليقُ بمثله","قولٌ فطيرُ الرأي غيرُ حكيم",39,"م",1,0],["هذا مغنٍّ أغنُّ الصوت ذو هيف","العود في يده يرجوك إيذانا",40,"ن",2,0],["هذا محالٌ من مقالِك لم يكن","هلْ أنتَ ناشٍ من حصى أو جندلِ",41,"ل",1,0],["هذا من العَبْدِ الذي","بمديحِه كى يَفْتخر",42,"ر",1,0],["هذا مقامُ المصطفى يا فوزَ من","حازَ النيابةَ فيهِ عن حسانِ",43,"ن",1,0],["هذا مكانٌ به الإقبال معهودُ","والفضل والحسن معلوم ومشهودُ",44,"د",1,1],["هذا مقالى إن هززت فعنده","ما يَحسُنُ المطبوعُ والمتطبِّعُ",45,"ع",1,0],["هذا مقام التهاني قد حللت به","فارتع ولا تخش بعد اليوم أنكالا",46,"ل",2,0],["هذا مكان القول ذو سعة","فضل التقى وطهارة العرض",47,"ض",1,0],["هَذا مَقامِيَ وَالأَعصارُ ماضِيَةٌ","وَالغَيُّ لِلنّاسِ مَحبوبٌ إِذا وُعِظوا",48,"ظ",3,0],["هَذا مَقامُ خَليلِ اللَه شَيَّدهُ","لِلمَكرُماتِ بِعونِ الواحدِ الصَمَدِ",49,"د",1,1],["هَذا مَقامٌ لِلمَعارفِ قَد غَدا","بِبَهاءِ أَنوارِ المُخلِّصِ مُشرِقا",50,"ق",2,1],["هَذا مَقامُ القُدسِ شادَ بِناءَهُ","اِيناسِيوسْ راعي الخرافِ الأَروعُ",51,"ع",1,1],["هَذا مَقامُ اليازجِيِّ فَقِف بِهِ","وَقُلِ السَلامُ عَلَيكَ يا عَلَم الهُدى",52,"د",2,1],["هذا مقامٌ سَمَا عن كلِّ مرتبةٍ","تسمو لها في المعالي نفسُ مرتاد",53,"د",1,0],["هذا مُذِلُّ الشِّرْكِ بالعَزْم الذي","ما فيه غيرُ أسيره وقتيله",54,"ل",2,0],["هذا مقام كنت أَجْهَد دائِبا","في نَيْله وأَجِدُّ في تحصيله",54,"ل",2,0],["هذا محبٌّ إليك يشكو","وبالرضا منك يستجيرُ",55,"ر",1,0],["هذا مقال من فعالك يحتذى","فاسمعه لا لغواً ولا كِذّابا",56,"ب",2,0],["هذا من العبد الفقير محمد","من بات عن فعل الصلاح تخلفا",57,"ف",2,0],["هذا مثالك في يوم من دون ضحى","وأنت أجمل خطّار وميّاس",58,"س",1,0],["هذا معين التّقى يا قوم منهمر","يروي القلوب فعبّوا من سواقيه",59,"ي",2,0],["هذا مليكُ القبّةِ الزرقاءِ","يَنضو نِقابَ الليلةِ الورقاءِ",60,"ا",2,1],["هَذا محمد السامي فَتى عمر","لب اللباب ابن أم الجود وَالكرم",61,"م",1,0],["هَذا محمد المَحمود سيرته","هَذا أبر بني الدنيا وَأَوفاها",62,"ا",3,0],["هَذا مَنارك يا محمد مذسمها","طلعت طَلائعه بنور النير",63,"ر",1,0],["هَذا مقامٌ فيهِ كُلُّ مُفَوَّهٍ","غَيري لَدَيكَ مُفَهَّهٌ تَمتامُ",64,"م",1,0],["هَذا مِنَ الدَّهرِ مَشهورٌ وَما بَرِحَت","أَهلُ المَعالي ذُرابى أَلسُنِ السفلِ",65,"ل",1,0],["هذا مصير الثائرين وهذه","نظم الحياة وسنة الاحقاب",66,"ب",1,0],["هَذا مقامُ الأَمنِ","من كُلِّ خوفٍ يَعني",67,"ي",1,0],["هَذا مُحبُّكِ ناصباً أَحشاءَه","غَرَضاً لأسهم مقلتيكِ فَقَرطسي",68,"س",2,0],["هَذا مُصابٌ جاءَ تاريخُهُ","ثَكَلَت يا مِصرُ لِمَوتِ الأَمينِ",69,"ن",1,0],["هَذا مُبَجَّلٌ قَومُهُ","عالي السَنا وَالمُحتَدِ",70,"د",1,0],["هَذا مَقامُ أَخي الهَوى المُتَتَسَيِّمُ","لا تَجزَعَن فَلَستَ أَوَّلَ مُغرَمِ",71,"م",1,0],["هذا مكانك في الهوى ومكاني","رغم اختلاف الدار مقتربان",72,"ن",1,1],["هذا مَقام شَريف","من نَبعة تَأنف الذم",73,"م",1,0],["هذا مقام المُستَعيذ المُستَجي","ر المُذنِب المُتَأَوّه المتوجع",74,"ع",1,0],["هذا مَقام أَبي اللثامين الَّذي","نارَت بِهِ الاِعصار وَالاِمصار",75,"ر",1,0],["هذا مَقام القطب سُلطان الوَرى","كَهف العفاة الصارِم البتار",75,"ر",1,0],["هَذا مَضى وَالشِعرُ بُستانُنا","وَفيهِ قَد تَرتَعُ أَذهانُ",76,"ن",1,0],["هذا مديحي لا يفي","عني لمن هذا مديحه",77,"ح",2,0],["هذا مكانٌ ليس فيه رحمةٌ","والويل ضمن رحابه وفِنائه",78,"ا",3,0],["هذا مع أنني المذنب","كثير الأوزار والإصرار",79,"ر",1,0],["هذا مقالُ ابن إدريس الّذي روَتِ","الأَعلام عنه فمِل عنْ منهج الكذِب",80,"ب",1,0],["هذا مع الأفلاك مر","تفع وذا بحضيض أرض",81,"ض",1,0],["هذا محلُّ العلم والإفتاءِ","تأوي إليه أكابرُ العلماء",82,"ا",2,1],["هذا محلُّ الافتخار فدم به","بالعزِّ والتمكين والإِمكان",83,"ن",1,0],["هذا مداد العلم هذا بابُه","إنَّ العلوم بصدره تتفجَّر",84,"ر",1,0],["هذا مَقامُ أبيكَ فاسْمُ بمجدِه","فالشّهمُ يروي عن أبيه وجدِّهِ",85,"د",2,1],["هَذَا مُحَمَدٌّ المَحمُودُ أَجمَعُهُ","قَد خَلَّفَ الدَّهرَ فِينَا غَيرَ مَحمُودِ",86,"د",1,0],["هذا مُعانِقهُ يأْساً فَمُسلِمُهُ","وذا مُعانِقهُ إِلفاً فَشافِعُهُ",87,"ع",2,0],["هذا مثال فتى تضن بمثله","غرر العصور كذا بكل نجيب",88,"ب",1,0],["هذا مثال من التاريخ أنقله","كما روته لنا الأخبار والكتب",89,"ب",1,0],["هذا مآل والضباب يحفّني","بالحزن لا أدري سواه مآلي",90,"ل",2,0],["هذا مآلُ الألمعية والهدَى","والنبلِ تحت جنادلٍ ورغام",91,"م",1,0],["هذا محبك دون ذل واقف","يرجو نداك ولا أراه يخيب",92,"ب",1,0],["هذا من البرح المرفرف هابطٌ","إذ ذا بمعراج التداني صاعدُ",93,"د",1,0],["هذا مقام فتي اضاع زمانه","في بعض ما شيدت من بنيانه",94,"ن",2,1],["هذا مقام فتى أقصاه مالكه","فحاول الصبر حيناً ثم ما صبرا",95,"ر",2,0],["هذا ملخّصُ نُسخةِ السّاداتِ من","آلِ النّبيّ ففضلُه لا يُشرَحُ",96,"ح",1,0],["هَذا مَلاذ الأَولياء هَذا غِيا","ث الأَتقيا هَذا جَمال الدار",97,"ر",1,0],["هذَا مَقامُ العائِذِ","بِذِي الجَلالِ اللائِذِ",98,"ذ",1,1],["هذا مديحي فإن نلت القبول به","سعدت أولا فحسبي موقف التهمِ",99,"م",1,0],["هذا مقامك في دنيا وآخرة","واترك وجودك تقرب منه بل تَصِل",100,"ل",1,0],["هذا مقام يجل عن رجل","له ادعاء به وتوصيف",101,"ف",1,0],["هذا مدد باق أبداً","من حضرة غيب يورده",102,"د",2,0],["هذا مقام أولي النهى","تلك الجهابذة الأسود",103,"د",1,0],["هذا مثالٌ ولم أقصد حقيقته","لديك فافهم مرادي واترك النكدا",104,"د",2,0],["هذا ملة بها الله أدنى","منه أهل الكمال والأقطابا",105,"ب",2,0],["هذا مقامٌ لابنِ أحمدَ قد حكَى","بُرجاً تجلَّى فيهِ ضَوءُ الفَرقَدِ",106,"د",1,1],["هذا مَقامُ السيِّدِ العَلَمِ الذي","وَرِثَ الكمالَ عن الأميرِ السيِّدِ",107,"د",1,1],["هذا مَقامُ خليلِ اللهِ نَحسبُهُ","في أرضِنا للعلمِ والرَّشَدِ",108,"د",1,1],["هذا مكَانٌ للطَّهارةِ والنَّقا","فادخُل إليهِ بالسُّرورِ مُلازِما",109,"م",2,1],["هذا مسيحُ اللهِ فادينا الذي","صَلَبَتْهُ طائفةُ اليهودِ كمُجرِمِ",110,"م",1,0],["هذا مُرادُ المُرادِيُّ الأميرُ لهُ","من نِسبةِ اللَّمعِ أصلٌ غيرُ مجحودِ",111,"د",1,0],["هذا مُرادي مِنْ إِلهي وَمَا","يكذِبُ في الله مُرادُ المُريدْ",112,"د",1,0],["هَذا مَقامي قَد سَأَلتِ وَمَوقِفي","وَعَنِ المَسيرِ فَسائِلي بَعدُ",113,"د",1,0],["هَذا مَقامي وَقومي قائِلون مَعي","كَما أَقول لسانٌ صادقٌ بفمِ",114,"م",1,1]]}