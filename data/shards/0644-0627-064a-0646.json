,"الكامل"],[420,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[420,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[420,"ما غاب بدر دجى منكم ولا غربا","https://www.aldiwan.net/poem53990.html","البسيط"],[420,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[420,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[433,"لا ينفعنّ الفتى إلا سريرته","https://www.aldiwan.net/poem40997.html","البسيط"],[447,"إن كان بعض الشعر غير سديد","https://www.aldiwan.net/poem55916.html","عموديه"],[447,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[447,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[461,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[461,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[461,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[461,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[461,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[461,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[461,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[464,"حاشا الليوث من التيا","https://www.aldiwan.net/poem15432.html","الكامل"],[467,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[478,"لا ينسإ الله منا معشراً شهدوا","https://www.aldiwan.net/poem1821.html","البسيط"],[482,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[498,"يا آل عصم أنتم أولو العصم","https://www.aldiwan.net/poem10276.html","مشطور الرجز"],[517,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[518,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[532,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[554,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[554,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[556,"لاينتها باختلاس اللحظ فانخشعت","https://www.aldiwan.net/poem68383.html","البسيط"],[561,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[565,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[565,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[567,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[578,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[578,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[578,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"],[656,"","https://poetry.dctabudhabi.ae/diwan/poem/200324","الكامل"],[707,"","https://poetry.dctabudhabi.ae/diwan/poem/31553","البسيط"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18058","البسيط"],[910,"","https://poetry.dctabudhabi.ae/diwan/poem/20977","البسيط"],[940,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[971,"","https://poetry.dctabudhabi.ae/diwan/poem/28230","المديد"],[1092,"","https://poetry.dctabudhabi.ae/diwan/poem/97719","البسيط"],[390,"تَهَزَّأَتْ عِرْسيَ واستَنكَرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=4681",""]],"verses":[["لا يَنامُ السَيفُ في يَدِهِ","وَيُرى في بابِلٍ رَجِلا",0,"ل",2,0],["لا يَنشُدُ الحُبُّ رَأياً كانَ أَصلَحَهُ","إِذا الفَتى طَرَدَ الآراءَ بالغَزَلِ",1,"ل",1,0],["لا يَنبُذونَ إِلى الخَلائِفِ طاعَةً","بِقَعاقِعِ الإيعادِ وَالإِنذارِ",2,"ر",1,0],["لا يَنفَدُ الدَمعُ الَّذي يُبكى بِهِ","إِنَّ القُلوبَ لَهُ مِنَ الأَمدادِ",3,"د",1,0],["لا يَنْبَغي لسِواكُمْ بعْدَكُم فلَكُمْ","فخْرٌ على الخُلَفاءِ الجِلّةِ الصّيدِ",4,"د",1,0],["لا يُنْكِرُ الفضْلَ لمُلاّكِهِ","إلا امْرُؤٌ غطّى علَيْهِ الحَسَدْ",5,"د",1,0],["لا يَنثَني أَو تَخرُجَ ال","أَجرامُ عَن فَلَكِ المَدار",6,"ر",1,0],["لا يُنَجّي الفِرارُ مِنهُنَّ في البَح","رِ وَلا في ذُرى الجِبالِ الشُمِّ",7,"م",1,0],["لا يَنَمِ الواشي الَّذي غَرَّني","ها أَنا في ظِلِّ الرِضى نائِمُ",8,"م",1,0],["لا يَنطِقُ العُرفَ وَلا يَلحَنُ","العَزفَ وَلا يَنفُذُ بِالغازِيَه",9,"ي",2,0],["لا يَنطِقُ النُكرَ لَدى حُرَّةٍ","يَبتارُ خالي الهَمِّ في الغاوِيَه",9,"ي",2,0],["لاَ يَنْثَنَي يُوْماً عَنِ الْ","إِحْسَانِ لَوْ سَاءَ انْقِلاَبَا",10,"ب",2,0],["لا يَنْقُضُ البَانِي يَدَا إِلاَّ وَقَدْ","نُقِضَ البِنَاءُ وَفَالَ رَأْيُ البَانِي",11,"ن",2,0],["لا يَنعَشُ الطَرفَ إِلّا ما تَخَوَّنَهُ","داعٍ يُناديهِ بِاِسمِ الماءِ مَبغومُ",12,"م",1,0],["لا يَنقُلونَ إِلى الجَبّانِ مَيِّتَهُم","حَتّى يُؤاجِرَ يَعقوبٌ لَهُم نَفَرا",13,"ر",2,0],["لا يُنكِرُ الناسُ قِدماً أَن تُعَرِّفَهُم","سَبقاً إِذا بَلَغوا نَحزَ المَضاميرِ",14,"ر",1,0],["لا يَنفَعُ الحاضِرُ المَجهودُ بادِيَهُ","وَلا يَعودُ لَنا بادٍ عَلى حَضَرِ",15,"ر",1,0],["لا ينقض الأمر إلا ريث يبرمه","ولا تعرَّب إلا حوله العرب",16,"ب",1,1],["لا ينضح الصاربات الوَطْبُ من يُبس","لحالب قبل أن يروين مصطربِ",17,"ب",1,0],["لا ينظر العَشوة الملتخ غيْهبها","ولا تضيق على زُوَّاره الحلل",18,"ل",1,1],["لا ينبت النخل إلا في مغارسه","منهم ولا يُنبِت الخطيةَ السَّلَمُ",19,"م",1,1],["لا ينبت الناس إلا في أرومتهم","ولا ترى ثمر القِنْوان في السَّلمِ",20,"م",1,1],["لا يَنفُعُ الطولُ مِن نوكِ القُلوبِ وَلا","يَهدي الإِلَهُ سَبيلَ المَعشَرِ البورِ",21,"ر",1,0],["لا ينزل الدهر عن يدي قدَماً","كأنني صورةٌ على قدَحِ",22,"ح",1,0],["لا ينبغي حرّ المقال فريده","إلاَّ على حرّ الكرام فريدها",23,"د",3,0],["لا ينخبُ الروعُ قلبَه فلهُ","من كلّ حزمٍ يُريغهُ نُخَبُهْ",24,"ب",2,0],["لا يُنكر الدهرُ بعد مهلِكها","هُلكَ ذوات الجلال والخطرِ",25,"ر",1,0],["لا ينكر اللَّه إثباتي فضيلتَهُ","ولا الملائكةُ الأبرارُ والناس",26,"س",1,0],["لا يَنْبِشونَ عيوبَ من آخاهُمُ","سَفَهاً ولؤْماً عند نَبش النابش",27,"ش",1,0],["لا ينكر الناسُ هزلاً","في عُرض شعرٍ نَقيِّ",28,"ي",1,1],["لا ينقطع وثنائي غير منقطع","كلّا بل الحسي قبل البحر منزوف",29,"ف",1,0],["لا ينْثَني عنه الرُّقا","ةُ فإنه حَنَشٌ أصمُّ",30,"م",1,0],["لا ينطِقُ الإفكَ والبهتان قائلهُمْ","بل قَوْلُ عائبهم إفكٌ وبهتان",31,"ن",1,0],["لا ينفسُونَ بِمَنْفوس التلادِ ولا","يفدي لديهم شحومَ الكُوم ألبان",31,"ن",1,0],["لا ينصرفْ عنك من يَمُتُّ بها","وحظُّه حظ عابدِ الوثن",32,"ن",1,0],["لا يُنجي الشاةَ مِن سَغَبٍ","أَنَّ في أَرضِ السُهى عَشَبا",33,"ب",2,0],["لايُنكِرُ الإِسلامُ ما أَولَيتَهُ","بِكَ لَم يَزَل مُستَنجِداً مُستَنصِرا",34,"ر",2,0],["لا يَنبَحُ الكَلبُ فيها غَيرَ واحِدَةٍ","حَتّى يُلَفَّ عَلى خَيشومِهِ الذَنَبا",35,"ب",2,1],["لا يَنْهَضُ الشَّعبُ إلاَّ حينَ يَدْفَعُهُ","عَزْمُ الحَيَاةِ إِذا مَا اسْتَيْقَظَتْ فيهِ",36,"ي",2,1],["لا ينكر الحق المبين سوى امرئ","يعمى وشر منه من يتعامى",37,"م",2,0],["لا ينبغي ان يكون البحر قاتله","ان كان للبحر ذي الامواج وجدان",38,"ن",1,0],["لا ينكر الاعقاب صدقي بعدما","في صفحة التاريخ سجله الدم",39,"م",1,0],["لا ينِسينَّك عهدَها","عِين من الفردوس حور",40,"ر",1,0],["لا يَنفَعُ النَفسَ فيهِ وَهيَ حائِرَةٌ","إِلّا زَكاةُ النُهى وَالجاهِ وَالمالِ",41,"ل",1,0],["لا يَنفَعُ المَيتَ سِوى","صالِحَةٍ مُدَّخَرَه",42,"ر",2,0],["لا يَنقُصُ الهالِكونَ مِن عَدَدٍ","مِنهُ عَلِيٌّ مُضَيَّقُ البيدِ",43,"د",1,0],["لا يُنجِزُ الميعادَ في يَومِهِ","وَلا يَعي ما قالَ في أَمسِهِ",44,"س",2,0],["لا يُنكَرُ العَقلُ مِن دارٍ تَكونُ بِها","فَإِنَّ ريحَكَ روحٌ في مَغانيها",45,"ي",3,0],["لا يَنفُذُ القوتُ إِلى غَيرِهِ","كَأَنَّما نُضمَرُ لِلحَلبَه",46,"ب",2,0],["لا يَني يوفِدُ الحَبيبَ إِلَينا","كَذِبُ الطَيفِ سارِيَن وَغُرورُه",47,"ر",2,0],["لا يَنقُصُ الطَمَعُ الغالي عَزيمَتَهُ","وَلا سَبيلَ إِلى عَيبٍ يُدانيهِ",48,"ي",2,0],["لا يُنعِمونَ فَيَستَثيبوا نِعمَةً","لَهُمُ وَلا يَجزونَ بِالأَفضالِ",49,"ل",1,0],["لا يُنقِصُ العُسرُ بَسطاً مِن أَكُفِّهِمُ","سِيّانِ ذَلِكَ إِن أَثرَوا وَإِن عَدِموا",50,"م",3,0],["لا يُنَبِّي عن مَعالي","كَ الورى مثلُ خبيرِكْ",51,"ك",1,0],["لا يُنقِصُ الكامِلُ مِن كَمالِهِ","ما جَرَّ مِن نَفعٍ إِلى عيالِهِ",52,"ه",1,1],["لا يَنتَهونَ عَن الفَحشاءِ ما سَلِموا","وَالغَدرُ فيهُم سَبيلٌ غَيرُ مَأمونِ",53,"ن",1,0],["لايَنظُرُ الناسُ إِلى المُبتَلى","وَإِنَّما الناسُ مَعَ العافِيَه",54,"ي",2,0],["لا يَنث