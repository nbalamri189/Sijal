,"م",1,0],["لا يَنفَعُ الهارِبَ إيغالُهُ","وَلا يُنَجّي ذا الحَذارِ الحَذار",164,"ر",1,0],["لا ينتهون الدهر عن مولى لنا","قورك بالسهم حافاتِ الأديم",165,"م",1,0],["لا ينظر المرؤ منهُ قَصْدَ ناحيةٍ","إلاّ رأى منه أو من أهلِه عَجَبا",166,"ب",2,0],["لا يَنْبحُ الكلبُ فيها غيرَ واحدةٍ","حتّى يلفّ خيشومِهِ الذّنبا",166,"ب",2,0],["لا ينصفون مهذباً في قوله","لو كان يأتي بالشموس دليلا",167,"ل",2,0],["لا ينفع الدمع ولو أنه","كان دماً من جفنه مطبقاً",168,"ق",2,0],["لا يَنْثني عمّا يَهِمُّ بِهِ","أو يَنْثَني الصّمصامَةُ الذّكَرُ",169,"ر",1,0],["لا ينْكُرنَّ المستهام دموعه","ممَّا يَجنّ فإنَّها إقرار",170,"ر",1,0],["لا ينزع الله هذا السّرّ من رجلٍ","فيه السَّعادة والمسعود مسعود",171,"د",1,0],["لا ينال الشيطانُ منه مراماً","ثقةً منه بالتقى واعتصاما",172,"ا",1,0],["لا ينزع الله مجداً كانَ مُعطيَه","آل النبيّ ولا فضلاً ولا أدبا",173,"ب",2,0],["لا ينال الحمد في مدحي له","من يعد الفضل من نوع الفضول",174,"ل",1,0],["لا ينزلون على كرهٍ بمنزلة","ولا يضامون في بدو وفي حضر",175,"ر",1,0],["لا ينفعنّ الفتى إلّا سريرته","بالله أو حل خطب فهي عمدته",176,"ه",1,1],["لا ينتهي حتى يناجي نفسه بسعادة","بمواقف ليست من المعهود",177,"د",1,0],["لا ينكرن عظيم فضلك منصف","في العرب أو يلفى اذل كذوب",178,"ب",1,0],["لا ينتهي في العشق بي زمن كما","قد فات حسن العالمين مثالك",179,"ك",1,0],["لا يُنسَبون لِعَلّةٍ","وإن انتأت بهم الأبوَّهَ",180,"و",2,0],["لا ينزلُ الضيفُ وإن تموَّلوا","بمتمِرٍ منهم ولا بمُلبِنِ",181,"ن",1,0],["لاينسَينْ ملكٌ ضمنتَ بقاءه","بالأمس غَمْدَك منه سيفَ المقتني",182,"ي",1,0],["لا يُنكرنَّ حسودُ ملكك ما رأى","فاللهُ أعلمُ ما اجتبَى وبمن عُني",182,"ي",1,0],["لا ينطِقون لغةً وكلُّهم","بين الأنام رُسُلٌ تَراجمُ",183,"م",1,0],["لا ينطقون الخنا ولا يُثبت ال","ماشي بشرٍّ إليهمُ قدَما",184,"م",2,0],["لايَنْتَهُ الأخلاقَ من كرمٍ","فاغترّ منك بمِشيةِ الصِّلِّ",185,"ل",1,0],["لايِنْهُ لا تُلفِ القضيبَ عاسياً","واصعُبْ يزاحمْك ثقيلاً أُحْدُ",186,"د",1,0],["لا ينقضي يومٌ خَلا","لكَ من ثناءٍ أو ثوابِ",187,"ب",1,0],["لا ينثني عنه الثناء لا","ولا للعذل يوماً عن ذراه معدل",188,"ل",1,0],["لا يَنسَإِ اللَهُ