l","عموديه"],[583,"خان المحالف والمعاهد","https://www.aldiwan.net/poem1569.html",""],[584,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[584,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"]],"verses":[["سَهمٌ وَجَدتُ لَهُ عَلى كَبِدي","أَلَماً وَآلَمُ صَرفَهُ عَنّي",0,"ي",1,0],["سَهِرتُهُ وَالأَماني تَرتَقي فِكَري","حَتّى تَطَلَّعَ مِن هَمّي إِلى هِمَمي",1,"م",2,0],["سَهمُكَ مَدلولٌ عَلى مَقتَلي","فَمَن تُرى دَلَّكَ يا قاتِلُ",2,"ل",1,1],["سَهمٌ أَصابَ وَراميهِ بِذي سَلَمٍ","مَن بِالعِراقِ لَقَد أَبعَدتِ مَرماكِ",3,"ك",1,0],["سَهماً رَمى غَرَضَ العُلى مِن بَعدِما","لَم يَبقَ في قَوسِ المَعالي مَنزَعُ",4,"ع",1,0],["سَهامُكُمُ في كُلِّ عارٍ سَديدَةٌ","وَسَهمُكُمُ في مَرشَقِ المَجدِ عائِرُ",5,"ر",1,0],["سَهِرتُ لَهُ نابي الوِسادَةِ بَرقُهُ","يَحومُ عَلى أَعناقِهِ وَيَلوبُ",6,"ب",1,0],["سَهمٌ أَصابَكِ مِنهُ","لِلقَدرِ فوقٌ وَغَربٌ",7,"ب",1,0],["سَهْلِ الشّريعَةِ سَبّاقٍ إِلى أمدٍ","تَسْري الرّياحُ بهِ حَسْرى على مَهَلِ",8,"ل",1,0],["سَهلَ المَباءَةِ مُحضَرَاً مَحَلُّهُ","ما يُصبِحُ الدَهرُ إِلّا حَولَهُ حَلَقُ",9,"ق",1,0],["سَهِرَت أَعيِنٌ وَنامَت عُيونُ","في أُمورٍ تَكونُ أَو لا تَكونُ",10,"ن",1,1],["سَهَري لِتَنقيحِ العُلومِ أَلَذُّ لي","مِن وَصلِ غانِيَةٍ وَطيبِ عِناقِ",11,"ق",1,1],["سِهامُ اللَيلِ لا تُخطِي وَلَكِن","لَها أَمَدٌ وَلِلأَمَدِ اِنقِضاءُ",12,"ا",2,0],["سِهَامُ الْمَنَايَا لاَ تَطِيشُ وَلاَ تُخْطِى","وَلِلدَّهْرِ كَفُّ يَسْتَرِدُّ الَّذي يُعْطِي",13,"ي",1,1],["سهِرْنَا وَفِي سيْرِ النَّجُومِ اعْتِبَارُنَا","إِلَى أَنْ ضَفَا لِلَّيْلِ مِنْ فَوْقِنَا رَيْطُ",14,"ط",1,1],["سَهْرَانُ تَفْتَرُّ أَحْدَاقُ الدُّجَى فَتُرَى","وَسْنَى وَتَنْجَابُ عَنْ أَحْدَاقِهِ الظُّلَمُ",15,"م",1,0],["سهم أصاب وراميه بذي سلم","لقد رمى الغرض الأقصى فأصماهُ",16,"ا",2,0],["سهرتَ بها والله يكتب أجرَها","تُؤمِّن فيها الخلْق والخلق نُوَّمُ",17,"م",1,0],["سهام جفونِ عن قسِيِّ حواجبٍ","يُصاب بها قلبُ البريء على عمدِ",18,"د",1,0],["سهام دعاً له وسهامُ رأيٍ","لها في كل معركةٍ مضاء",19,"ا",2,0],["سهرَت عليكِ لواحظُ الرُّقباء","سهراً ألذُّ لها من الإغفاء",20,"ا",2,1],["سهمٌ لمن رامَ تنفيذَ الأمور به","لكنَّه هدفٌ للطالب الرَّاجي",21,"ي",1,0],["سهرت في الوصلِ غنماً والجفا أسفاً","سبحان فاطر أجفاني على السهرِ",22,"ر",1,0],["سَهِّلْ حجابك أيها المحجوبُ","واعلمْ بأنَّ النائبات تَنوبُ",23,"ب",1,1],["سَهَّل عندي خلتي أنني","طال على خسفكمُ مَحْبِسي",24,"س",2,1],["سهلة في الحلوق لا غَوْل فيها","وهي خشناء صعبة في الرؤوس",25,"س",1,0],["سهوتُ أقيلوني فإنِّي مغفَّلٌ","وإن له شأناً أجلّ من الحرش",26,"ش",1,0],["سهل الخليقة لم يَشرِك سياسته","عنف وإن كان بالملحاح معنافا",27,"ف",2,0],["سهَّلَتْهُ ووعَّرتْهُ سجايا","خالطتْها وعورةٌ وسُهولهْ",28,"ل",2,0],["سهادُ أخي البلوى حقيقٌ به السَّهْوُ","ولم يُلْهه عن هَجْر أحبابه لهوُ",29,"و",1,1],["سَهلُ الشَرائِعِ تَروى الحائِماتُ بِهِ","إِذا العِطاشُ رَأَوا أَوضاحَهُ وَرَدوا",30,"د",3,0],["سَهَدَت سُهدي الدَراري إِنَّما","شَدَّ ما بَينَ المُعَنّى وَالخَلي",31,"ل",2,0],["سَهِرتَ شَوقاً إِلى ذَكاءِ","أَم عِندَكَ المِقعَدُ المُقيمُ",32,"م",1,0],["سَهِرنا لَهُ فَكَأَنَّ السُيوفَ","تَحُزُّ بِأَكبادِنا هَهُنا",33,"ن",2,0],["سَهِرنا عَلى حِفظِ الغَرامِ وَنِمتُمُ","وَلَيسَ سَواءً ساهِرونَ وَنُوَّمُ",34,"م",1,0],["سَهِرنا قُبَيلَ الرَدى لَيلَةً","وَمادارَ ذِكرُ الرَدى في السَمَر",35,"ر",1,0],["سُهولٌ مِنَ الفُصحى وَقَفتَ بِها الهَوى","عَلى ما لَدَيها مِن رُبىً وَهِضابِ",36,"ب",1,0],["سَهِرتَ وَلَم تَنَم لِلرَكبِ عَينُ","كَأَن لَم يُضوِهِم ضَجَرٌ وَأَينُ",37,"ن",1,0],["سَهِرتَ وَلَذَّ النَومُ وَهوَ مَنِيَّةٌ","رَعايا تَوَلّاها الهَوى وَرُعاةُ",38,"ه",1,0],["سَهِرتَ وَنامَ المُسلِمونَ بِغَبطَةٍ","وَما يُزعِجُ النُوّامَ وَالساهِرُ الأَبُ",39,"ب",1,0],["سِهامُ لحاظٍ مِنْ قِسِيِّ الحواجبِ","نَظَمْنَ الأسى في القَلْبِ مِنْ كلِّ جانبِ",40,"ب",1,1],["سُهادٌ أَتانا مِنكَ في العَينِ عِندَنا","رُقادٌ وَقُلّامٌ رَعى سَربُكُم وَردُ",41,"د",1,0],["سُهادٌ لِأَجفانٍ وَشَمسٌ لِناظِرٍ","وَسُقمٌ لِأَبدانٍ وَمِسكٌ لِناشِقِ",42,"ق",1,0],["سَهِرتُ بَعدَ رَحيلي وَحشَةً لَكُمُ","ثُمَّ اِستَمَرَّ مَريري وَاِرعَوى الوَسَنُ",43,"ن",1,0],["سَهَّلتَ مِنها وَعرَ كُلِّ حُزونَةٍ","وَمَلَأتَ مِنها عَرضَ كُلِّ فَضاءِ",44,"ا",2,0],["سَهلُ البَلاغَةِ وَالفَصاحَةِ قُلَّب","غَضُّ الحِجى وَالفَهمِ صُلبُ العودِ",45,"د",1,0],["سَهَرٌ أَصابَكَ بَعدَ طولِ نُعاسِ","لِصُدودِ أَغيَدَ فاتِنٍ مَيّاسِ",46,"س",1,1],["سَهُلَت لِرائِدِها الجِبالُ ثَبيرُها","فَجَليلُها فَشَمامُها فَأَبانُها",47,"ن",3,0],["سَهلُ الخَليقَةِ لا تُخشى بَوادِرُهُ","يَزينُهُ اِثنانِ حُسنُ الخَلقِ وَالشِيَمُ",48,"م",1,0],["سَهْلُ الخَلِيقَةِ لاَ تُخْشَي‌ بَوَادِرُهُ","يَزِينُهُ خَصْلَتَانِ: الحِلْمُ وَالكَرَمُ",49,"م",1,0],["سُهادي فيكَ أعذبُ من رُقادي","وغَيِّي فيكَ أحسنُ من رَشادي",50,"ي",1,1],["سَهَوتُ وَغَرَّني أَمَلي","وَقَد قَصَّرتُ في عَمَلي",51,"ل",2,1],["سَهماهُ عَينانِ لَهُ كُلَّما","أَرادَ قَتلي بِهِما سَلَّما",52,"م",2,0],["سَهلُ الخَلائِقِ لَيِّنٌ عِندَ النَدى","لَكِنَّهُ عِندَ الشَدائِدِ قاسِ",53,"س",1,0],["سَهَّدتَ نَجمَ الدينِ طَرفَكَ لِلعُلى","فَحَفِظتَ دَوحَتَها مِنَ الإِيباسِ",53,"س",1,0],["سَهلٌ خَلائِقُهُ صَعبٌ عَرائِكُهُ","جَمٌّ عَجائِبُهُ في الحُكمِ وَالحِكَمِ",54,"م",1,0],["سَهلُ الخَلائِقِ سَمحُ الكَفِّ باسِطُها","مُنَزَّهٌ لَفظُهُ عَن لا وَلَن وَلَمِ",54,"م",1,0],["سُهاداً يَذودُ النَومَ أَن يَألَفَ الجَفنا","وَخِلتُ بِأَنّي عَن مَغانيكِ راحِلٌ",55,"ل",1,0],["سَهلُ الخَلائِقِ ما في خُلقِهِ شَرَسٌ","لِلوارِدينَ وَلا في خَدِّهِ صَعَرُ",56,"ر",1,0],["سهدٌ على سهدٍ وذك","رى فوق ذكرى تزدحم",57,"م",1,0],["سهرت ترقب الصباح وعين الن","جم كلّت وما بها إغفاء",58,"ا",2,0],["سَهّلوا من نفوسهمْ كلّ صعبٍ","فالرّدى لا يُقيلُ مَنْ يَسْتقيلُ",59,"ل",1,0],["سَهمُ غَربٍ أصابَ ضَيغَمَ حربٍ","خاضَ في العيشِ منه نَصلٌ قَتولُ",59,"ل",1,0],["سَهَرٌ كرى مُقَلٍ تخافُ من الرّدى","للخوْفِ هَجْرُ الطيرِ ماءَ ثمادِ",60,"د",1,0],["سَهّادَةً نَوّامَةً بِالوادي","كَثيرَةَ التَعريسِ بِالوِهادِ",61,"د",1,0],["سَهَّلَ الأَمرَ إِذ تَوَعَّرَ بِالشَع","رِ فَجاءَت سُهولَةً وَوُعورَه",62,"ر",2,0],["سَهِرتُ فيكَ فَلَم أَجحَد يَدَ السَهَرِ","وَطالَ فِكري وَلا عَتبٌ عَلى الفِكَرِ",63,"ر",1,1],["سَهمُ بنُ أَوسٍ في ضَمانِكَ عالِمٌ","أَن لَستَ بِالناسي وَلا بِالساهي",64,"ه",2,0],["سَهُلنَ عَلَيكَ المَكرُماتُ فَرَصفُها","عَ