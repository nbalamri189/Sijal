{"poems":[[55,"أحبك بالطبع البعيد من الحجى","https://www.aldiwan.net/poem29875.html","الطويل"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[24,"أمن أم شداد رسوم المنازل","https://www.aldiwan.net/poem21878.html","الطويل"],[37,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[37,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[10,"ألا ما لعينك أم ما لها","https://www.aldiwan.net/poem21129.html","المتقارب"],[85,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[39,"فإن تصغ تكفأه العداة اناءنا","https://www.aldiwan.net/poem7603.html","الطويل"],[74,"اسكنت قلبي لحدك","https://www.aldiwan.net/poem18565.html","المنسرح"],[53,"أقول إذ هتف الداعي بمصرعه","https://www.aldiwan.net/poem66399.html","البسيط"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[31,"ألا جعل الله الأخلاء كلهم","https://www.aldiwan.net/poem6201.html","الطويل"],[30,"لقد كذب الحي اليمانون شقوة","https://www.aldiwan.net/poem5024.html","الطويل"],[30,"ترى كل منشق القميص كأنما","https://www.aldiwan.net/poem5398.html","الطويل"],[33,"لقد أرسلت في السر ليلى تلومني","https://www.aldiwan.net/poem42581.html","الطويل"],[13,"ألم تشل اليوم الحمول البواكر","https://www.aldiwan.net/poem2224.html","الطويل"],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55178","السريع"],[108,"الكبش والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=179570",""],[102,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[13,"فَإنْ تَصْرِمِينِي أَوْ تُسِيئِي جَنَابَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=180817",""],[0,"أجارتنا ان الخطوب تنوب","https://www.poetsgate.com/ViewPoem.aspx?id=6446",""],[53,"أقولُ إذْ هَتَفَ الدَّاعي بمصْرعهِ","https://www.poetsgate.com/ViewPoem.aspx?id=25841",""],[146,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[267,"قف بالديار وأي الدهر لم تقف","https://www.aldiwan.net/poem68198.html","البسيط"],[275,"ما زلت يا كاس تعلينا ونعليك","https://www.aldiwan.net/poem35296.html","البسيط"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[369,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[382,"أرى الشيطان يرمينا بحرب","https://www.aldiwan.net/poem66941.html","الوافر"],[447,"بنفسي رسوم بين نفعي وغرب","https://www.aldiwan.net/poem14331.html","الطويل"],[466,"خليلي أما الحلم عني فعازب","https://www.aldiwan.net/poem15167.html","الطويل"],[469,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[473,"يابن الفطوسة عندي","https://www.aldiwan.net/poem59571.html","المجتث"],[475,"فإن تصلي أصلك وإن تبيني","https://www.aldiwan.net/poem4793.html","الوافر"],[521,"فان تصلي اصلك وان تعودي","https://www.aldiwan.net/poem48622.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[694,"","https://poetry.dctabudhabi.ae/diwan/poem/97816","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87106","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77629","الرجز"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/131382","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70906","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59647","الخفيف"],[1128,"","https://poetry.dctabudhabi.ae/diwan/poem/146942","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64776","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35758","المتقارب"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113945","الطويل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118334","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82220","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46742","الوافر"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118791","المتقارب"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87564","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139968","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117169","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91903","البسيط"],[3771,"","https://poetry.dctabudhabi.ae/diwan/poem/67773","البسيط"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21504","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202346","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131267",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76447","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20891","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86423","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28678","المنسرح"],[4691,"مُؤنثَة ٌ أحْلامُهُ ومُذَكّرَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=125543",""],[4691,"لي الظمأ الصريح إلى المواعد","https://www.poetsgate.com/ViewPoem.aspx?id=215926",""],[4767,"جِنان الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=213975",""],[4858,"ألا ياربِّ فارحمْ مِن فقدنا","https://www.poetsgate.com/ViewPoem.aspx?id=148456",""],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[4901,"وحقك إن أدخلتني النار قلت","https://www.poetsgate.com/ViewPoem.aspx?id=186128",""],[4954,"هلْ لي منْ غزالٍ سماحةً","https://www.poetsgate.com/ViewPoem.aspx?id=208832",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[5720,"أبا أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=206679",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[6152,"طاب بكِ الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=213173",""],[5309,"طوينا رحاب الأرض كي ندرك المنى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573582",""]],"verses":[["فَأَنتَ صَديقي إِن ذَهَبتُ إِلى الهَوى","وَأَنتَ عَدوّي إِن رَجَعتُ إِلى العَقلِ",0,"ل",1,0],["فَإِن تُصبِحوا أَدنى العَدُوُّ فَقَبلَكُم","مِنَ الدَهرِ عادَتنا الرِبابُ وَدارِمُ",1,"م",1,0],["فَإِن تَصرِميني وَيبَ غَيرُكِ تُصرَمي","وَأوذِنتِ إيذانَ الخَليطِ المُزايِلِ",2,"ل",1,0],["فَإِن تُصبِحِ الدُنيا تَغَيَّرَ صَفوُها","فَحالَت وَأَمسَت وَهيَ غَثٌّ سَمينُها",3,"ن",3,0],["فَإِن تَصدُفي يا عَزَّ عَنّي وَتَصرِمي","وَلا تَقبَلي مِنّي خِلالاً أَسومُها",4,"م",3,0],["فَإِن تَصبِرِ النَفسُ تُلقَ السُرورَ","وَإِن تَجزَعِ النَفسُ أَشقى لَها",5,"ل",3,0],["فإن تصُبْ سحبُه بالماء حين هَمتْ","بعسجدٍ ولُجَيْنٍ صاب هاميها",6,"ي",3,0],["فإن تُصغِ تكفأه العداة اناءنا","وتسمعْ لنا أقوال أعدائنا تَخَلْ",7,"ل",1,1],["فأنتَ صاحبُ عهدٍ","فوفّ للحسنِ عهدَك",8,"ك",1,0],["فإن تُصبْكَ من الأَيَّام جائحةٌ","لم يُبْكَ منكَ على دُنْيا ولا دين",9,"ن",1,0],["فَإِن تَصرِمي حَبلي وَإِن تَتَبَدَّلي","خَليلاً وَمِنهُم صالِحٌ وَسَميجُ",10,"ج",1,0],["فَإِن تَصرِمي حَبلي وَإِن تَتَبَدَّلي","خَليلاً وَإِحداكُنَّ سوءٌ قُصارُها",11,"ر",3,0],["فَإِن تُصفِقِ الأَحلافُ لِاِبنِ مُطَرِّفٍ","فَيَمرَحَ وَالغَضبانُ ذو العِزِّ يَمرَحُ",12,"ح",1,0],["فَإِن تَصبِروا فينا تُقِرّوا بِحُكمِنا","وَإِن عُدتُمُ فيها فَسَوفَ نُعيدُها",13,"د",3,0],["فَإِن تَصحَبينا يا نَوارُ تُناصِفي","صَلاتَكِ في فَيفٍ تَكُرُّ حَواجِلُه",14,"ل",2,0],["فَإِن تَصرِميني لا أَرى الدَهرَ قُرَّةً","لِعَيني وَلا أَلقى سُروراً وَلا سَعدا",15,"د",2,0],["فَإِن تَصرِميني أَو تُسيإي لِعِشرَتي","فَإِنّي لَصَرّامُ القَرينِ مُعاشِرُ",16,"ر",1,0],["فَإِن تَصِلونا نُواصِلكُمُ","وَإِن تَصرِمونا فَإِنّا صُبُر",17,"ر",1,0],["فَإِنْ تُصَمِّمْ وَلَمْ","تُحْجِمْ فَأَنْتَ البَطَلْ",18,"ل",1,0],["فإن تصِبْ أحدًا منكم مخالبُه","فإنها بلسمٌ يشفي من السَّقم",19,"م",1,0],["فانتصبنا على ( الطويل) طويلاً","والتحمنا للحصن، سوراً حصينا",20,"ن",2,0],["فَإنْ تَصْرِمِينِي أَوْ تُسِيئِي جَنَابَتِي","فَإنِّي لَصَرَّامُ المُهِينِ جُذَامِرُ",21,"ر",1,1],["فإن تصلينا فالقرابة بيننا","وإن تصرمينا فالغريب غريب",22,"ب",1,0],["فإن تُصبْكَ من الأَيَّام جائحة","ٌ لم نبك منك على دنيا ولا دين",23,"ن",1,0],["فإن تصطنعْ نُعْمى فأنتَ وليُّها","وهيهات تُقضَى من رجائك أحلاسى",24,"س",2,0],["فإن تَصِلنِي قَضَيتُ القَومَ حَقَّهُمُ","وإن تقل لا فَحَقُّ القومِ في تَلَفِ",25,"ف",1,0],["فأنتِ صبحٌ جميلٌ في أشِعَّتِهِ","تبدو زخارفُ أحلامٍ لهاويك",26,"ك",1,0],["فَإنْ تُصْبِحْ لَها الدُّنيا طُرُوساً","فَقَد صُفَّت عَلَيها كالسطورِ",27,"ر",1,0],["فَإِن تُصِب قَلبَهُ يَوماً بِأَسهُمِها","يَكنُ عَلَيها وَمِنها الإِثمُ وَالجَنَفُ",28,"ف",1,0],["فإنْ تُصْفِ خُوزِسْتانَ أقلامَك الّتي","بها اليومَ تَحمي أن يُرامَ مَنيعها",29,"ع",3,0],["فإن تُصلب ترِث مجداً مُعَدّاً","لمصلوبٍ فمجدُك بالصليب",30,"ب",1,0],["فإن تصليني ترزقي شكر معشري","وإن تقتليني يا علية تطلبي",31,"ب",2,0],["فإنْ تَصِلي أو تهجري عن ملالةٍ","فإني على الحالين صَبٌّ مُساعِفُ",32,"ف",1,0],["فانتصف لي من الزمان فقد حا","ول ظلمي والرأي أعلى وأسمى",33,"م",2,0],["فَإِن تَصاوَنتَ عَمّا يَقولُهُ","فيكَ صانَك",34,"ك",1,0],["فَإِن تَصلي أَصِلكِ وَإِن تَبيني","بِصُرمِكِ قَبلَ وَصلِكِ لا أُبالي",35,"ل",2,1],["فَاِن تَصلي اصلَك وَاِن تَعودي","لِهَجر بُعد وَصلِكَ لا أُبالي",36,"ي",1,1],["فانتصب الأمر على نصابه","ورد نصل السيف في قرابه",37,"ه",1,0],["فَإِن تُصبح النيرانُ قَد ماتَ ضوؤها","فَقَد كانَ يُذكيهنّ بالحطبِ الجزلِ",38,"ل",1,0],["فَاِنتصر لي مِنهُ يا لَيث الشَرى","حَيث زلت في اللقا مِني القدم",39,"م",1,0],["فَإِن تُصدقني فَعُد إِلَيّا","وَرُدَّ لي إِهانَتي عَلَيّا",40,"ي",2,0],["فإن تصديت للأحكام تنقضُها","فإن أحكام أهل العصر كالعدم",41,"م",1,0],["فإنْ تصلبني لم أحِدْ لك بغتةً","ولو نلتُ منك الحب بالسخط والرضى",42,"ض",2,0],["فانتصرتُ بمَدْمعي","حين عِيلَ تصبُّري",43,"ر",2,0],["فإن تصلينا فالمودة بيننا","وإن تقطعينا فالغريب غريب",44,"ب",1,0],["فأَنْتَ صَلاحُ الدين وابْنُ صَلاحِهِ","فلا ملْكَ أَولى منكَ بالنَّهْي والأَمْرِ",45,"ر",1,0],["فَإِن تُصبِح الأَرضُ عِريانَةً","تَهُبُّ بِها الشَمأَلُ الزَعزَعُ",46,"ع",1,0],["فإن تصرميني ليسَ في الصرمِ موئِلٌ","وإن تصِليني حَبَّذا الوصلُ من عُوَذ",47,"ذ",1,0],["فانتصر إن ذنوبي كثرت","قيدت عزمي الخَطايا وَالكسل",48,"ل",1,0],["فان تصغ لي اذنيك اسقهما اذن","نصيحة ذي ود يقودك للرشد",49,"د",1,0],["فَإِن تُصدري يَحلُبنَ دونَكِ حَلبَةً","وَإِن تَحضُري يَلبث عَلَيكِ المَعجَلِ",50,"ل",1,0],["فأن تصبح الأيام شيبن مفرقي","وأذهبن أشجاني وفللن من غربي",51,"ب",2,1],["فَإِن تُصبِح أُمَيَّةُ قَد تَوَلَّت","وَعادَ الوَصلُ صُرماً وَاِعتِلالا",52,"ل",2,0],["فإن تصِلوني فيا حبذا","وإلا ففي الباب سِرِّي مقيم",53,"م",1,0],["فأن تصل دعوة من أهل او احد","من الاجانب كانت اكبر النعم",54,"م",1,0],["فانتَ صديقهُ ما دمتَ منهُ","بحيث يَقول مِسكين فُلانُ",55,"ن",1,0],["فانتصفوا للدينِ من أعدائه","واقترعُوا عليهم واقتسموا",56,"م",3,0],["فإن تُصب الأعداء يوماً مَقاتِلي","فإن الفتى للموتِ حتما مُسلّم",57,"م",1,0],["فإن تصِبها فأنتَ ذو فطَن","وحاجَتي أن تصيبَ معناها",58,"ا",3,0],["فَإِن تصوّره كَلباً كانَ ذاكَ وَلم","يَصعبْ عليك إِذ صَوّرته أَسدا",59,"د",2,0],["فإن تُصَب سادة منا فإنَّ لنا","بيضاً مسابح يومَ الروع أبطالا",60,"ل",2,0],["فَإِن تَصرِميني تَصرِمي فِيَّ واصِلاً","لَدى الوُدِّ مِعراضاً إِذا ما التوى صَعبا",61,"ب",2,0],["فان تصطنعني بالجميل فإنني","لأحمد من تزكو لديه الصنائع",62,"ع",1,0],["فإن تصحبيني كنت لي خير عدةٍ","إذا اشتد في يوم الوغى الطعن والضرب",63,"ب",1,0],["فان تصلحا كان اصلاحنا","وَهَيهات للغرب أَن يزدري",64,"ر",2,0],["فَاِنتَصَبَت مُنتَصَفَ الأُسطولِ في","مَركَبِ أوذيسَ الكبيرِ المُشرِفِ",65,"ف",1,0],["فإن تصبك من الأيام جائحة","لم أبك منك على دنيا ولا دين",66,"ن",1,0],["فإن تصلوا فالوصل غاية منيتي","وإلا فسير اليعملات وجيف",67,"ف",1,0],["فإن تصلي حبلي بخيرٍ وصلتُهُ","وإن كنتِ قد أزمعتِ صَرْمي فأَجملي",68,"ل",2,0],["فَاِنتَصَحَت رَأيها فَكانَ لَها","شَرَّ مُشيرٍ وَشَرَّ مُنتَصِحِ",69,"ح",1,0],["فأنت ِ صباح القلب إن غيّبوا المنى","وكل أمانيه بعينيك مزه