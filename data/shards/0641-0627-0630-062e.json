{"poems":[[79,"بشرى تقوم لها الدنيا على قدم","https://www.aldiwan.net/poem36125.html","البسيط"],[95,"يا من بكى والخطب جد أليم","https://www.aldiwan.net/poem11284.html","الكامل"],[48,"المرء كالنار تبدو عند مسقطها","https://www.aldiwan.net/poem23306.html","البسيط"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137339",""],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66971","الطويل"],[6069,"يا باكي الدار بكاظمةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105659",""]],"verses":[["فَاذْخَرْ لَهُ الْخَيْلَ تُزْهَى فِي مَرَابِطِهَا","شُوسَ اللِّحَاظِ لَهَا حِقْدٌ عَلَى اللُّجُمِ",0,"م",1,0],["فَاذْخَرْ فُؤَادَكَ لِلَّذِينَ تَخَلَّفُوا","فَهُمُ الضِّعَافُ وَأَنْتَ أَيُّ كَرِيمِ",1,"م",1,0],["فَاِذخَر لِنَفسِكَ خَيراً كَي تُسَرَّ بِهِ","فَإِن فَعَلتَ وَإِلّا عادَكَ النَدَمُ",2,"م",1,0],["فاذخرنا لحادثاتِ الليالي","فابنُ لبنانَ في الوغى مشهور",3,"ر",1,0],["فاذْخَرْ مِنَ الكَلِمِ العَليِّ لآلِئاً","يَبْأَيَ بها جِيدُ العلا ويَجْبَحُ",4,"ح",1,0],["فاذخره مخافة نازلةٍ","أأمنت اليوم صروف غد",5,"د",1,0]]}