{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54754","الخفيف"],[591,"من كحل المقلة السوداء بالدعج","https://www.aldiwan.net/poem17465.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38014","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88976","الكامل"],[4748,"صورتك","https://www.poetsgate.com/ViewPoem.aspx?id=6664",""],[4935,"مالك الملك بجودٍ كملك","https://www.poetsgate.com/ViewPoem.aspx?id=129536",""],[5277,"رَبْح..أم الخير","https://www.poetsgate.com/ViewPoem.aspx?id=191819",""]],"verses":[["مِنْكَ حَيفَا وَإنَّ حَيفَا لأغْلَى","درَّةٍ فِي الثُّغورِ يُنَظمْنَ عِقْدَا",0,"د",2,0],["مَنْ كَحَّلَ المُقْلَةَ السَّوْداءَ بِالدَّعَجِ","وَخَضَّبَ الوَجْنَةَ الحَمْراءَ بالضَّرَجِ",1,"ج",1,1],["مَن كُحِّلت عينا بَصيرةِ قَلبهِ","من نور عِرفانٍ بأنفعِ إثمدِ",2,"د",1,0],["منك حيّت عمر والعُلى ذلك المُ","كثر للضيف زادَه والمطيبا",3,"ب",2,0],["من كحلك الموصوف عين الشمس لو","كحلتها لتركتها كحلاءَ",4,"ا",2,1],["مِنكْ حالي قرّب احتوفه","يا حبيبي وش بعد باقي",5,"ق",2,0],["منك حلوان المعالي تكتسي","رونقاً والأنس فيها حل لك",6,"ك",1,0],["من كحلِ عينِ القطا احلى.. فمقلتُها","من أثمدِ الحسنِ هدبُ العينِ يكتحلُ",7,"ل",1,0]]}