{"poems":[[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[72,"ثغر عليه من الملاحة سكر","https://www.aldiwan.net/poem18771.html","الكامل"],[72,"هناء محا ذاك العزاء المقدما","https://www.aldiwan.net/poem19668.html","الطويل"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[92,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[62,"وفاتك أفديه من فاتك","https://www.aldiwan.net/poem52325.html","السريع"],[62,"رشأ فتور لحاظه","https://www.aldiwan.net/poem52412.html","مجزوء الكامل"],[45,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[97,"ثغر كما يعشق الفنان بسام","https://www.aldiwan.net/poem24346.html","البسيط"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[94,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=12695",""],[143,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[150,"أروح على ذكر النبي وأغتدي","https://www.aldiwan.net/poem68602.html","الطويل"],[185,"لو كان هجرك يبقيني إلى أمد","https://www.aldiwan.net/poem14501.html","البسيط"],[185,"سلام على الثغر الذي طال عنهده","https://www.aldiwan.net/poem14510.html","الطويل"],[199,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[210,"قد حكى الغصن بالقوام النضير","https://www.aldiwan.net/poem13372.html","الخفيف"],[210,"أقضيب بان أم قوام أملد","https://www.aldiwan.net/poem13456.html","الطويل"],[223,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[237,"ثغر السيادة قد تبسم","https://www.aldiwan.net/poem19070.html","الكامل"],[237,"ثغر الزمان تبسم","https://www.aldiwan.net/poem19075.html","المجتث"],[270,"طال ليلي من شعرها النضناض","https://www.aldiwan.net/poem35383.html","الخفيف"],[275,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[282,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[282,"أقيم طليقا بالحمى وأسير","https://www.aldiwan.net/poem32784.html","الطويل"],[328,"أطرقت في ضراعة تذكر الله","https://www.aldiwan.net/poem55062.html","الخفيف"],[364,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[377,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[449,"مع صادق الشعر","https://www.aldiwan.net/poem970.html",""],[479,"ثغر الحبيب تبسما","https://www.aldiwan.net/poem36896.html","مجزوء الكامل"],[482,"وغزالة لغزالة خضعت ولكن","https://www.aldiwan.net/poem24327.html","عموديه"],[514,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[514,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[514,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[514,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[515,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[515,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[558,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[575,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[575,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[586,"دمع تناثر عقده","https://www.aldiwan.net/poem17489.html","مجزوء الكامل"]],"verses":[["ثُغورٌ غدَتْ مثْلَ الثّغورِ ضَواحِكاً","أقامَ علَيْها الكُفْرُ يرْشُفُها رَشْفا",0,"ف",2,0],["ثغرٌ عليه من الملاحة سكّر","يحلو الحديثُ عليه وهو مكرر",1,"ر",1,1],["ثغور ابتسامٍ في ثغور مدامعٍ","شبيهان لا يمتاز ذو السبق منهما",2,"م",2,0],["ثَغَبٌ يَنْقَعُ الصَّدَى وغِناءٌ","عنده يوجد السرورُ الفقيدُ",3,"د",1,0],["ثَغْرُهُ من عُقودِهِ","ودُموعي تَنَسَّقا",4,"ق",2,0],["ثغرِيَ هذا بَرَدٌ جامِدٌ","تُذيبُهُ جمرةُ أنفاسِكْ",5,"ك",1,0],["ثغرٌ هو الإغريضُ قد","جُعِلَ اللثامُ عليه قِشْرَا",6,"ر",2,0],["ثَغرُ حَبيبٍ إِذا تَأَلَّقَ في","لَماهُ عادَ المُحِبُّ في لَمَمِه",7,"م",2,0],["ثَغرُ الفَلا مِن نورِهِ مُتَبَسِّمٌ","وَفَمُ الزَمانِ بِفَضلِهِ مُتَحَدِّثُ",8,"ث",1,0],["ثغرٌ كما يعشقُ الفنَّانُ بسَّامُ","لكَ النعيمُ أخي موسى وإنعامُ",9,"م",1,1],["ثَغْرُها الدُّرِّيُّ مِنْ أنْفاسِهِ","مِسْكُ دارينَ وَخَمْرُ الأَنْدرِينا",10,"ن",2,0],["ثَغْرٌ أضاعَ حريمَهُ أربابُهُ","حتى أُهينَ عزيزهُ واستُضْعِفا",11,"ف",2,0],["ثُغورُ مُحارِبٍ مَنَعَت هُجوعاً","ثُغوراً في مَضاحِكِها غُرِسنَه",12,"ن",2,0],["ثغرةٌ أنفذِ منها خنجرٌ","قد تلقّته على حزّ الوريد",13,"د",1,0],["ثغرك ريّان من رحيق","ألحب يحيى به صريعَه",14,"ع",2,0],["ثَغْرُ السُّوَيْس الْيَوْمَ يَفْتَرُّ عَنْ","حَظٍّ عَدَتْهُ أَمْسِ عَنْهُ عَوَادْ",15,"د",1,0],["ثَغر الحبيب من الإطار تَبَسَّما","فحسبته أوما إليَّ، وسلَّما",16,"م",2,1],["ثغر على ثغر . تسرّب فيه ، فاختلط الرضاب","قبل ، أغاريد الشفاه فتستعاد وتستطاب",17,"ب",1,0],["ثُغورُ العِدى إِن رُمتُموهُنَّ كَالفَلا","وَكُلُّ فَلاةٍ رُمتُمُ مَنعَها ثَغرُ",18,"ر",1,0],["ثِغابُهُمُ قَد أُفهِقَت بِأَتيَّهِ","فَكَم تائِهٍ عَن وردِها وَهوَ يَلهَثُ",19,"ث",1,0],["ثغرٌ تَجمّع خيرُ الأرض فيه كما","جَمعتَ من كلِّ فضلٍ كلَّ منفرِد",20,"د",1,0],["ثغورٌ بذاك الثغر تَحِكي أَقاحَه","إذا لمحتْه الشمسُ وهْو يَميد",21,"د",1,0],["ثغراً على ثغرٍ وأحسنَ ما","تجدِ الهوى ثغراً على ثغرِ",22,"ر",1,0],["ثغره بالنظام طابق جسمي","حين ابدى غرائب المنشور",23,"ر",1,0],["ثغر تجانس بالمحاسن وصفه","فالدر فيه منظم ومنضد",24,"د",1,0],["ثغرُهُ قارورَةٌ من عَسَلٍ","مَزجت مرشفَه بِالعَسَلِ",25,"ل",1,0],["ثَغْرُ السِّيَادَةِ قَدْ تَبَسَّمْ","عَنْ هَدْيِ قُدْوَتِنَا الْمُعَظَّمْ",26,"م",1,1],["ثَغْرُ الزَّمَانِ تَبَسَّمْ","مِنْ شَدْوِ طَيْرٍ تَرَنَّمْ",27,"م",1,1],["ثغرُها العذبُ فيهِ رقراقُ وادٍ","شفَّ يومَ الهجيرِ عن رَضراضِ",28,"ض",1,0],["ثُغُورُ ثُغُورِ المُسْلِمِين بَوَاسِمٌ","بِهِ وَرِقابُ المُشْرِكين خَواضِعُ",29,"ع",1,0],["ثَغرُهُ ثَغرٌ حَماهُ لَحظُهُ","بِشَبا سَيفٍ جُرازٍ مَشرَفِيِّ",30,"ي",1,0],["ثُغورُ ظِباءٍ حُصِّنَت بِشَبا الظبى ال","مَواضي فَهَل تِلكَ الثُغورُ ثُغورُ",31,"ر",1,0],["ثغرها كأس جنة بارك الل","ه طلاها سحرية عذراء",32,"ا",2,0],["ثَغْرُكَ معْ خَدِّكَ في جُنْحِه","ماءُ أخي الوَجْدِ ومَرْعاه",33,"ا",2,0],["ثَغَرَت لها الأَحداثُ خُلجاناً وَقد","ضَمَّ البَنونَ برَمسِها الآباءَ",34,"ا",2,0],["ثغور القوافي حينما تتبسم","يرف لها قلب ويشدو بها فم",35,"م",1,1],["ثغر الحبيب تبسما","فبدا الجمان منظما",36,"م",2,1],["ثغر المها أضحى كبرق لامق","من ذا يقبل برق برد سقاتي",37,"ت",2,0],["ثغرٌ حمَتْهُ صِفاحُ أجفانِ المَهى","وتكلّفَتْهُ رِماحُ أُسْدِ طِعانهِ",38,"ن",2,0],["ثغرُ حسنٍ حمَتْهُ سُمرُ قُدودٍ","وظُبى أجفُنٍ ونَبْلُ حِداقِ",39,"ق",1,0],["ثُغورُ البيضِ فيه باسِماتٌ","وقاماتُ الرِّماحِ بها قِيامُ",40,"م",1,0],["ثغرٌ يُجابُ صهيلُه بصهيلِه","ويُجيبُ باغِمَهُ الهزَبرُ بزأرِهِ",41,"ر",2,0],["ثغورٌ تُذيبُ القلبَ وهي جوامدٌ","وتُضرِمُ فيّ النارَ وهي بَرودُ",42,"د",1,0],["ثغر الهدى متبلج بسام","ووجوه أيام الزمان وسام",43,"م",1,1],["ثغر الزمان بنجم الدين مبتسم","ووجهه بدوام العز يتسم",44,"م",1,1],["ثغرها بث عن صحيح البخاري","وأنا مسلم وقلبي موطَّا",45,"ط",2,0],["ثغرٌ هو المسكِرُ في فِعله","لكنَّه السكَّرُ في الطَّعمِ",46,"م",1,0],["ثغرُ يُريك الأَقحوانَ به شفى","وقتَ الظهيرةِ أَو يُريك به قَلَح",47,"ح",1,0],["ثَغْرٌ يُبَاحُ شَهيدُهُ","فَعلامُ يُحْمَى شَهْدُهُ",48,"د",2,0]]}