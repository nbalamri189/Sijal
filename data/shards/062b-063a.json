{"poems":[[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[72,"ثغر عليه من الملاحة سكر","https://www.aldiwan.net/poem18771.html","الكامل"],[72,"هناء محا ذاك العزاء المقدما","https://www.aldiwan.net/poem19668.html","الطويل"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[92,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[62,"وفاتك أفديه من فاتك","https://www.aldiwan.net/poem52325.html","السريع"],[62,"رشأ فتور لحاظه","https://www.aldiwan.net/poem52412.html","مجزوء الكامل"],[45,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[97,"ثغر كما يعشق الفنان بسام","https://www.aldiwan.net/poem24346.html","البسيط"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""]],"verses":[["ثُغورٌ غدَتْ مثْلَ الثّغورِ ضَواحِكاً","أقامَ علَيْها الكُفْرُ يرْشُفُها رَشْفا",0,"ف",2,0],["ثغرٌ عليه من الملاحة سكّر","يحلو الحديثُ عليه وهو مكرر",1,"ر",1,1],["ثغور ابتسامٍ في ثغور مدامعٍ","شبيهان لا يمتاز ذو السبق منهما",2,"م",2,0],["ثَغَبٌ يَنْقَعُ الصَّدَى وغِناءٌ","عنده يوجد السرورُ الفقيدُ",3,"د",1,0],["ثَغْرُهُ من عُقودِهِ","ودُموعي تَنَسَّقا",4,"ق",2,0],["ثغرِيَ هذا بَرَدٌ جامِدٌ","تُذيبُهُ جمرةُ أنفاسِكْ",5,"ك",1,0],["ثغرٌ هو الإغريضُ قد","جُعِلَ اللثامُ عليه قِشْرَا",6,"ر",2,0],["ثَغرُ حَبيبٍ إِذا تَأَلَّقَ في","لَماهُ عادَ المُحِبُّ في لَمَمِه",7,"م",2,0],["ثَغرُ الفَلا مِن نورِهِ مُتَبَسِّمٌ","وَفَمُ الزَمانِ بِفَضلِهِ مُتَحَدِّثُ",8,"ث",1,0],["ثغرٌ كما يعشقُ الفنَّانُ بسَّامُ","لكَ النعيمُ أخي موسى وإنعامُ",9,"م",1,1],["ثَغْرُها الدُّرِّيُّ مِنْ أنْفاسِهِ","مِسْكُ دارينَ وَخَمْرُ الأَنْدرِينا",10,"ن",2,0],["ثَغْرٌ أضاعَ حريمَهُ أربابُهُ","حتى أُهينَ عزيزهُ واستُضْعِفا",11,"ف",2,0],["ثُغورُ مُحارِبٍ مَنَعَت هُجوعاً","ثُغوراً في مَضاحِكِها غُرِسنَه",12,"ن",2,0],["ثغرةٌ أنفذِ منها خنجرٌ","قد تلقّته على حزّ الوريد",13,"د",1,0],["ثغرك ريّان من رحيق","ألحب يحيى به صريعَه",14,"ع",2,0],["ثَغْرُ السُّوَيْس الْيَوْمَ يَفْتَرُّ عَنْ","حَظٍّ عَدَتْهُ أَمْسِ عَنْهُ عَوَادْ",15,"د",1,0],["ثَغر الحبيب من الإطار تَبَسَّما","فحسبته أوما إليَّ، وسلَّما",16,"م",2,1]]}