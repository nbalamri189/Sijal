ttps://www.poetsgate.com/ViewPoem.aspx?id=194938",""],[5273,"مكسور الجناح","https://www.poetsgate.com/ViewPoem.aspx?id=180953",""],[5273,"ترنيمة الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=183231",""],[5273,"قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=186924",""],[5273,"فنجان قهوة","https://www.poetsgate.com/ViewPoem.aspx?id=198524",""],[5273,"ماتا على ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=215886",""],[5356,"أشكو بِعادك","https://www.poetsgate.com/ViewPoem.aspx?id=201904",""],[5356,"نبض","https://www.poetsgate.com/ViewPoem.aspx?id=205793",""],[5356,"أنا امرؤٌ","https://www.poetsgate.com/ViewPoem.aspx?id=210942",""],[5365,"تراتيل في محراب الألم","https://www.poetsgate.com/ViewPoem.aspx?id=191272",""],[5431,"كأن قبلته للثغر إمضاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=185586",""],[5431,"إنّ الغناء محبةٌ وسلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=197009",""],[5431,"ماتيسر من مقام العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=201525",""],[5512,"ذات العيون الشهل","https://www.poetsgate.com/ViewPoem.aspx?id=205887",""],[5563,"أحلى الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=213091",""],[2110,"ثقل الملام وطالت الأبحاث","https://www.poetsgate.com/ViewPoem.aspx?id=156266",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[5818,"احشر الكون في لهاث المضيقِ","https://www.poetsgate.com/ViewPoem.aspx?id=196652",""],[5843,"مكاسر عود جاوي!","https://www.poetsgate.com/ViewPoem.aspx?id=51287",""],[5894,"ثبت الغرام وفي فؤادي يحدث","https://www.poetsgate.com/ViewPoem.aspx?id=131413",""],[5943,"يا أنَّةَ الصَّدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=61778",""],[6019,"طيفاً أُعانقُ في محرابَكَ الأجلا","https://www.poetsgate.com/ViewPoem.aspx?id=143419",""],[6070,"افراح الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=187787",""],[6102,"ثغر","https://www.poetsgate.com/ViewPoem.aspx?id=183322",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[6102,"قَبِّليني","https://www.poetsgate.com/ViewPoem.aspx?id=184635",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6229,"تفاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82506&r=&rc=41",""]],"verses":[["ثُغورٌ غدَتْ مثْلَ الثّغورِ ضَواحِكاً","أقامَ علَيْها الكُفْرُ يرْشُفُها رَشْفا",0,"ف",2,0],["ثغرٌ عليه من الملاحة سكّر","يحلو الحديثُ عليه وهو مكرر",1,"ر",1,1],["ثغور ابتسامٍ في ثغور مدامعٍ","شبيهان لا يمتاز ذو السبق منهما",2,"م",2,0],["ثَغَبٌ يَنْقَعُ الصَّدَى وغِناءٌ","عنده يوجد السرورُ الفقيدُ",3,"د",1,0],["ثَغْرُهُ من عُقودِهِ","ودُموعي تَنَسَّقا",4,"ق",2,0],["ثغرِيَ هذا بَرَدٌ جامِدٌ","تُذيبُهُ جمرةُ أنفاسِكْ",5,"ك",1,0],["ثغرٌ هو الإغريضُ قد","جُعِلَ اللثامُ عليه قِشْرَا",6,"ر",2,0],["ثَغرُ حَبيبٍ إِذا تَأَلَّقَ في","لَماهُ عادَ المُحِبُّ في لَمَمِه",7,"م",2,0],["ثَغرُ الفَلا مِن نورِهِ مُتَبَسِّمٌ","وَفَمُ الزَمانِ بِفَضلِهِ مُتَحَدِّثُ",8,"ث",1,0],["ثغرٌ كما يعشقُ الفنَّانُ بسَّامُ","لكَ النعيمُ أخي موسى وإنعامُ",9,"م",1,1],["ثَغْرُها الدُّرِّيُّ مِنْ أنْفاسِهِ","مِسْكُ دارينَ وَخَمْرُ الأَنْدرِينا",10,"ن",2,0],["ثَغْرٌ أضاعَ حريمَهُ أربابُهُ","حتى أُهينَ عزيزهُ واستُضْعِفا",11,"ف",2,0],["ثُغورُ مُحارِبٍ مَنَعَت هُجوعاً","ثُغوراً في مَضاحِكِها غُرِسنَه",12,"ن",2,0],["ثغرةٌ أنفذِ منها خنجرٌ","قد تلقّته على حزّ الوريد",13,"د",1,0],["ثغرك ريّان من رحيق","ألحب يحيى به صريعَه",14,"ع",2,0],["ثَغْرُ السُّوَيْس الْيَوْمَ يَفْتَرُّ عَنْ","حَظٍّ عَدَتْهُ أَمْسِ عَنْهُ عَوَادْ",15,"د",1,0],["ثَغر الحبيب من الإطار تَبَسَّما","فحسبته أوما إليَّ، وسلَّما",16,"م",2,1],["ثغر على ثغر . تسرّب فيه ، فاختلط الرضاب","قبل ، أغاريد الشفاه فتستعاد وتستطاب",17,"ب",1,0],["ثُغورُ العِدى إِن رُمتُموهُنَّ كَالفَلا","وَكُلُّ فَلاةٍ رُمتُمُ مَنعَها ثَغرُ",18,"ر",1,0],["ثِغابُهُمُ قَد أُفهِقَت بِأَتيَّهِ","فَكَم تائِهٍ عَن وردِها وَهوَ يَلهَثُ",19,"ث",1,0],["ثغرٌ تَجمّع خيرُ الأرض فيه كما","جَمعتَ من كلِّ فضلٍ كلَّ منفرِد",20,"د",1,0],["ثغورٌ بذاك الثغر تَحِكي أَقاحَه","إذا لمحتْه الشمسُ وهْو يَميد",21,"د",1,0],["ثغراً على ثغرٍ وأحسنَ ما","تجدِ الهوى ثغراً على ثغرِ",22,"ر",1,0],["ثغره بالنظام طابق جسمي","حين ابدى غرائب المنشور",23,"ر",1,0],["ثغر تجانس بالمحاسن وصفه","فالدر فيه منظم ومنضد",24,"د",1,0],["ثغرُهُ قارورَةٌ من عَسَلٍ","مَزجت مرشفَه بِالعَسَلِ",25,"ل",1,0],["ثَغْرُ السِّيَادَةِ قَدْ تَبَسَّمْ","عَنْ هَدْيِ قُدْوَتِنَا الْمُعَظَّمْ",26,"م",1,1],["ثَغْرُ الزَّمَانِ تَبَسَّمْ","مِنْ شَدْوِ طَيْرٍ تَرَنَّمْ",27,"م",1,1],["ثغرُها العذبُ فيهِ رقراقُ وادٍ","شفَّ يومَ الهجيرِ عن رَضراضِ",28,"ض",1,0],["ثُغُورُ ثُغُورِ المُسْلِمِين بَوَاسِمٌ","بِهِ وَرِقابُ المُشْرِكين خَواضِعُ",29,"ع",1,0],["ثَغرُهُ ثَغرٌ حَماهُ لَحظُهُ","بِشَبا سَيفٍ جُرازٍ مَشرَفِيِّ",30,"ي",1,0],["ثُغورُ ظِباءٍ حُصِّنَت بِشَبا الظبى ال","مَواضي فَهَل تِلكَ الثُغورُ ثُغورُ",31,"ر",1,0],["ثغرها كأس جنة بارك الل","ه طلاها سحرية عذراء",32,"ا",2,0],["ثَغْرُكَ معْ خَدِّكَ في جُنْحِه","ماءُ أخي الوَجْدِ ومَرْعاه",33,"ا",2,0],["ثَغَرَت لها الأَحداثُ خُلجاناً وَقد","ضَمَّ البَنونَ برَمسِها الآباءَ",34,"ا",2,0],["ثغور القوافي حينما تتبسم","يرف لها قلب ويشدو بها فم",35,"م",1,1],["ثغر الحبيب تبسما","فبدا الجمان منظما",36,"م",2,1],["ثغر المها أضحى كبرق لامق","من ذا يقبل برق برد سقاتي",37,"ت",2,0],["ثغرٌ حمَتْهُ صِفاحُ أجفانِ المَهى","وتكلّفَتْهُ رِماحُ أُسْدِ طِعانهِ",38,"ن",2,0],["ثغرُ حسنٍ حمَتْهُ سُمرُ قُدودٍ","وظُبى أجفُنٍ ونَبْلُ حِداقِ",39,"ق",1,0],["ثُغورُ البيضِ فيه باسِماتٌ","وقاماتُ الرِّماحِ بها قِيامُ",40,"م",1,0],["ثغرٌ يُجابُ صهيلُه بصهيلِه","ويُجيبُ باغِمَهُ الهزَبرُ بزأرِهِ",41,"ر",2,0],["ثغورٌ تُذيبُ القلبَ وهي جوامدٌ","وتُضرِمُ فيّ النارَ وهي بَرودُ",42,"د",1,0],["ثغر الهدى متبلج بسام","ووجوه أيام الزمان وسام",43,"م",1,1],["ثغر الزمان بنجم الدين مبتسم","ووجهه بدوام العز يتسم",44,"م",1,1],["ثغرها بث عن صحيح البخاري","وأنا مسلم وقلبي موطَّا",45,"ط",2,0],["ثغرٌ هو المسكِرُ في فِعله","لكنَّه السكَّرُ في الطَّعمِ",46,"م",1,0],["ثغرُ يُريك الأَقحوانَ به شفى","وقتَ الظهيرةِ أَو يُريك به قَلَح",47,"ح",1,0],["ثَغْرٌ يُبَاحُ شَهيدُهُ","فَعلامُ يُحْمَى شَهْدُهُ",48,"د",2,0],["ثغرُ السرور بدا بالسعد مبتسما","ام لاحَ وجهُ الصفا بالبشر متسما",49,"م",2,1],["ثغر الميامن مفترّ له وغدا","اشراق طلعته بالخير مقترنا",50,"ن",2,0],["ثغر غدا جذلا به يفتر عن","ثغر الحبور وبش منه معبس",51,"س",1,0],["ثَغرُ الثُغورِ حَماهُ اللَهُ قامَ لَهُ","مِن لُطفٍ بِوَسفورِهِ أَحلى مِنَ الشَنَبِ",52,"ب",1,0],["ثَغر التَهاني بِالأَماني باسمُ","وَالسَعد للصدر المؤيد خادمُ",53,"م",1,1],["ثغور التهاني للعَزيز بواسمُ","وَأَيامه بيض الليالي مَواسمُ",54,"م",1,1],["ثغور المَعالي في التَهاني بواسمُ","وَأَنفاس أَرواح الأَماني نواسمُ",55,"م",1,1],["ثغور الهَنا اِفتَرَّت عَن الثغر وَالبشرِ","لإيماض بَرق لاحَ مِن كَوكَب العَصرِ",56,"ر",1,1],["ثَغرُها حالي اللّمى","لَثمُهُ يَشفي السّقام",57,"م",1,0],["ثَغرُكَ البرقُ إذا ما اِبتَسما","أَذهَبَ اللّيلَ وَجنحَ الحِنْدِس",58,"س",1,0],["ثَغرهُ يَحوي جُماناً وَزلال","فَهوَ شَهدٌ وَرَحيقٌ قَرقفُ",59,"ف",1,0],["ثَغرُكَ الكَأسُ يُعاطي قَرقفا","كَلُجَينٍ ضمنَ ياقوتٍ فريدْ",60,"د",1,0],["ثَغرهُ الدُّرِّيُّ مِنهُ لَمَعا","بَرقُ دُرٍّ ضَوؤه ظلْم اللّآل",61,"ل",1,0],["ثَغرُها بِالبشرِ حُسناً بسما","لاِبتِهاجِ الرّوحِ ثمّ الأَنفسِ",62,"س",1,0],["ثَغرُها الأَلمى العُذيبُ الأَشنَبُ","يَلفِظُ الجَوهَرَ مِن بَينِ العَقيقْ",63,"ق",1,0],["ثَغرُهُ الباسِمُ يَحوي جَوهَرا","وَرُضاباً مِن سُلافٍ وَزُلال",64,"ل",1,0],["ثغر الزمان باسمٌ","وباسطٌ للأنس كفّْ",65,"ف",1,0],["ثَغْره المَعْسُول فِيهِ رِيقَةٌ","لَيْسَ إلاَّ الرَّاحَ شَابَ الضَّرَبَا",66,"ب",2,0],["ثغر تعلَّل بالمسواكِ تحسبهُ","مِن بعد رقدتها بالمسكِ معلولا",67,"ل",2,0],["ثغره الأشنب لو عللني","لشفى لي عللي أو غللي",68,"ل",2,0],["ثغر جلا الحسن له انجما","دار بها الشارب دور الهلال",69,"ل",1,0],["ثغر إذا لحن ثناياه لي","عجبت للؤلؤ وسط الفرات",70,"ت",1,0],["ثَغْرُ الذي أهْوى له بارِقٌ","قد لاح للصَّادرِ والوارِدِ",71,"د",1,1],["ثغر كلمحِ البرقِ حسنُ بريقِهِ","يشفي غليلَ المستهامِ بريقِهِ",72,"ه",1,1],["ثغر لمبيض الحباب مذاقه","حلو ووجه بالملاحة حالي",73,"ل",2,0],["ثغرُهُ مثلُ وَمِيضِ ال","بَرقِ إذ لاحَ ابتِساما",74,"م",2,0],["ثغورٌ على المجدِ التليدِ ضواحكٌ","وايدٍ إلى المجد التليد تصوبُ",75,"ب",1,0],["ثغره كنز جوهر ختموه","بعقيق وأحكموا ارصادة",76,"د",2,0],["ثغورهنّ بروق في الدجا لمعت","يزينها الشين بعد الباء والنون",77,"ن",1,0],["ثغور الورد تبسم لي","كقلب العاشق الوجل",78,"ل",1,0],["ثغرت حمى مولاك مقتحماً على","محارمه كالموجب الحقِّ بالإرثِ",79,"ث",1,0],["ثغورُ قبا تنعي وتبكي تشاؤماً","إلى سيدٍ عنه المكارمُ تورثُ",80,"ث",1,0],["ثغره قد أشت شم","ل اصطباري شتيته",81,"ت",2,0],["ثغره يظهر للرائي به","لامعُ البرق ومنظوم الجمان",82,"ن",1,0],["ثغور بدت للمهتدي ونحور","وركايب بالظاعنين تسير",83,"ر",1,1],["ثَغرُهُ ما السَعدُ مِن بَسمَتِهِ","ما رَحيقُ الخُلدِ مِن مَعسولِهِ",84,"ل",2,0],["ثغر به للسواك رشف","ولي به نشوة وسكره",85,"ر",2,0],["ثَغرَهُ عِندَ سَردِهِ","كَالعناب المُزرد",86,"د",1,1],["ثغور الردى لا يَستَطيع سدادها","سوى كف قرم هيئت للحوادث",87,"ث",1,0],["ثغورُ المعالي قابلتهم ضواحكاً","إليهم وكم مصوا لمى ذلك الثغر",88,"ر",1,0],["ثَغرُهُ وَجَوهَرُهُ","لَم نَجِد بِهِ عَرَضا",89,"ض",2,0],["ثَغرٌ كحُقٍّ بِهِ الدُّرُّ النفيسُ غَدا","مَلآن مِنهُ فَمَنظوماً وَمُنتَثرا",90,"ر",2,0],["ثغره والريق كأس ورحيق","لم ير الراووق يوما والدنان",91,"ن",1,0],["ثغر حوى بجوار طه المصطفى","شرفا على شرف بلا تمويه",92,"ي",2,0],["ثغرك برق والدمع غيث","وليس إلا الحنين رعدُ",93,"د",1,0],["ثغر له الدمع خد خدي","سبحان من شقه وخده",94,"د",2,0],["ثغره درّ نضيد","ابدع الحسن نظامه",95,"م",2,0],["ثغر كان الاقاح فيه","يفترّ واللؤلؤ المنضد",96,"د",1,0],["ثغرك الاشنب ميم والعذار","هو لام والقوام الألف",97,"ف",1,0],["ثغر الربيع ضاحك","لضحك ثغر زهره",98,"ر",2,1],["ثغر السداد بكى من ضحك ضد هدى","سيف العناد غدا طوعا لمنتقم",99,"م",1,0],["ثغر الفصاحة منك أصبح ضاحكا","وشذا البلاغة من مقالك ينشر",100,"ر",1,0],["ثغور الهنا افترت وأنجمه الزهر","تبدت وغنى الطير وابتسم الزهر",101,"ر",1,1],["ثُغرةُ القِرنِ به فاعلةٌ","مِثْل ما يفعلُ بالخَدِّ الخَجَلْ",102,"ل",1,0],["ثغرك اللؤلؤي من","عقرب الصدغ في رصد",103,"د",1,0],["ثُغورٌ بدَتْ مثلَ الثغورِ بَواسِماً","وقد أعْذَبَتْ وِرْدَ المَنايا عِذابُها",104,"ب",3,0],["ثغراً دراً شعراً ليلا","وجهاً كالصبح إذا أسفر",105,"ر",1,0],["ثغرُ الزمانِ لقد غدا متبسِّم