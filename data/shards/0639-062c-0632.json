dules.php?name=Sh3er&doWhat=shqas&qid=85083&r=&rc=158",""]],"verses":[["عَجِزنا عَن مُراغَمَةِ الحِمامِ","وَداءُ المَوتِ مُغرىً بِالأَنامِ",0,"م",1,1],["عَجِزَ السُقمُ عَن بُلوغِ مَداها","فَمَضَت في سَبيلِها لا تُبالي",1,"ل",2,0],["عَجَزَت حيلَةُ الشِباكِ وَكانَ ال","شَرقُ لِلصَيدِ مَغنَماً مُستَطابا",2,"ب",2,0],["عَجِزَ الرُماةُ عَنِ الرُماةِ فَأَرسَلوا","كِسَفاً يَموجُ بِها دُخانٌ يَخنُقُ",3,"ق",1,0],["عَجِزَ الطُليانُ عَن أَبطالِنا","فَأَعَلّوا مِن ذَرارينا الحُساما",4,"م",2,0],["عَجِزُوا اليَوْمَ عَنْ فِدَاءٍ وَمَا","أَغْنَى الوَفَاءَ البُكَاءُ وَالأَشْجَانُ",5,"ن",1,0],["عَجِزَ البَيَانُ وَقَدْ هَمَمْتُ بِهِ","عَنْ أَنْ يُحِيطَ بِذَلِكَ العِظَمِ",6,"م",1,0],["عَجزاءُ مَمكورَةٌ خَمصانَةٌ قَلِقٌ","عَنها الوِشاحُ وَتَمَّ الجِسمُ وَالقَصَبُ",7,"ب",1,0],["عجزوا عن لقاك بالجيش حرباً","فاستجاشوا العدوان كيداً ومكرا",8,"ر",2,0],["عجزت عن راتبِي الأدنى فوا حربا","واهاً لأشهرِ عامٍ عجّزت طلبا",9,"ب",2,1],["عجز اجتهاد الشكر عن مننٍ","قدّمتها عندِي فيا أسفا",10,"ف",2,0],["عجزتْ وعيشِك عن حقوقك طاقتي","أأطيقُها وحدي وأنت قبيلُ",11,"ل",1,0],["عجزت يداي عن الجزاء فألقتا","عبء الشكور على ثناء لساني",12,"ن",2,0],["عَجزُ الفَتى في ظَنِّهِ وَرَجائِهِ","الظَنُّ يُخلِفُ وَالرَجاءُ يُخَيَّبُ",13,"ب",1,0],["عَجزٌ بِحُرٍّ فاقَةٌ وَوَراءَهُ","رِزقُ الإِلَهِ وَبابَكَ المَفتوحُ",14,"ح",1,0],["عَجزٌ مِنَ الدَهرِ لا يَأتي بِعارِفَةٍ","إِلّا تَلَبَّثَ دونَ الأَتيِ وَاِستانى",15,"ن",2,0],["عَجْزاً ولم تقِفِ العبيدُ إذا جرَتْ","يومَ الرِّهانِ مواقفَ الأربابِ",16,"ب",1,0],["عَجَزي عَن قَضاءِ حَقِّكَ بِالشُك","رِ ثَناني عَنِ الجَنابِ السامي",17,"ي",1,1],["عَجزاءُ يُحسِنُ إِن أَتاها خائِفٌ","وَقَدِ اِستَجارَ بِصَدعِها أَن تُحسِنا",18,"ن",2,0],["عَجَزتُ فَأَلقى السِلمَ قَلبي لِطَرفِهِ","عَلى أَنَّهُ عَن غَيرِهِ غَيرُ عاجِزِ",19,"ز",1,0],["عَجزَ الحماةُ فنائمٌ مُتقلِّبٌ","فوق الحشيّةِ أو مَغيظٌ مُحنَقُ",20,"ق",1,0],["عَجَزُوا عَنْ سُورَةٍ مِنْ مِثْلِهِ","فَهُمُ اليَوْمَ له مُسْتَسْلِمُونا",21,"ن",2,0],["عَجِزتَ يا مَهجورُ أَن تَذهَلا","وَمِن ذَوي نُصحِكَ أَن تَقبَلا",22,"ل",2,1],["عَجزاءُ مِن سِربِ بَني مالِكٍ","لَها مِن بَطنِها أَرفَعُ",23,"ع",1,1],["عَجزٌ لَعَمري وَلَيسَ يَنفَعُني","فَكُفَّ عَنّي العِتابَ يا عُمَرُ",24,"ر",1,0],["عَجزاءُ مِن نِسوَةٍ مُنَعَّمَةٍ","هيفٍ ثِقالٍ أَردافُها خُرُدِ",25,"د",1,0],["عَجَزَ الأَطِبَّةُ عَن جُروحِ نَوائِبٍ","لَيسَت بِغَيرِ قَضاءِ رَبِّكَ تُسبَرُ",26,"ر",1,0],["عَجَزتَ عَنِ الكَسبِ الَّذي يَجلُبُ الغِنى","وَما أَنتَ عَن كَسبِ الدَنايا بِعاجِزِ",27,"ز",1,0],["عُجُزٌ شُمطٌ مَعاً لَكُمُ","تَصطَلي نيرانَهُ خَدَمُه",28,"م",2,0],["عجزت عما عليه كنت مقتدراً","والمرء يعجز أَحياناً وَيقتدرُ",29,"ر",1,0],["عَجَزَ المُؤَرِّخُ أَنْ يَرَى أًشْبَاهَه","فِيما طَوَاه الدَّهْرُ مِنْ أَنْبائِهِ",30,"ا",3,0],["عَجَز الدَّهْرُ أَنْ يُحِيطَ بمَعْنا","كَ وأَلْقَتْ قِيادَها شُعَراؤُه",31,"ا",3,0],["عَجَزَ الشِّعرُ أن ينالَ مَدَاكُمْ","وكَبَتْ دونَ وَصْفِكُمْ أمْداحي",32,"ح",2,0],["عَجَزَ النايُ فَابْتَكِرْ مِنْ قَوَافِيكَ","وَرَنَّاتِهِنَّ نَاياً وَعُودا",33,"د",2,0],["عَجْزٌ مِنَ الدَّهْرِلا يأَْتِي بِعَافَةٍ","إِلاَّ تَلَبَّثَ دُونَ الأَتْيِ واسْتَانَىِ",34,"ن",2,0],["عَجَزَ الأَنامُ وذُدتَ عَنها قاهِراً","زَمَناً سَطا في عَصرِ غَيرِكَ وَاِعتَدا",35,"د",2,0],["عَجَزتُ عَنِ الأَعداءِ بَعدَ فِراقِهِم","كَعَجزِ بَنانٍ لَم يُنَط بِأَشاجِعِ",36,"ع",1,0],["عَجَزْتَ يَا مُحْصِيَ الْعُيُوبِ بِهَا","قَدْكَ أَتُحْصِي عَجَائِبَ الْبَحْرِ",37,"ر",1,0],["عَجزَاءُ مُدبِرَةً هَيفَاءٌ مُقبِلَةً","كَمُخَّةِ السّاقِ رَضَّ العَظمَ نَاقِيهَا",38,"ي",3,0],["عجزتُ عنها وعن وصفِى ولو ظَهرتْ","فيما مضى أعجزتْ قُسا وسَحْبانا",39,"ن",2,0],["عجزت عن التعجرف في المساعي","فملت إلى القطيعة والرغيف",40,"ف",1,0],["عَجَزَ الورى عَن مُعجزات جنابهِ","وَالكونُ مَهما شاء طوع خطابهِ",41,"ه",1,0],["عَجزَ الوَرى كلُّ الورى عن بعضهِ","عَن نهيهِ عَن نفلهِ عن فرضهِ",41,"ه",1,0],["عجزتُ وألقى السلمَ قلبي لطرفِهِ","على أنه عن غيره غير عاجِزِ",42,"ز",1,0],["عجز الطب عن شفائك آها","من جراح يحار فيها الطبيب",43,"ب",1,0],["عُجَّزٌ لا نَصيرَ يَدفَعُ عَنّا","ما نُقاسي ما لِلذُنوبِ نَصيرُ",44,"ر",1,0],["عجزوا وقد رمقوا الردى فتعاهدوا","ضلت مداركهم عن البيت القصيد",45,"د",1,0],["عَجزاءُ عَبهَرَةٌ غَرّاءُ مُكمَلَةٌ","في مُقلَتَيها وَإِن لَم تَكتَحِل كَحَلُ",46,"ل",1,0],["عَجز اللِسان بِنيله فَلذا","بِالقَلب أمدحهم وَلا دخلُ",47,"ل",1,0],["عَجزَ الناسُ كلُّهم عَنه حتَّى","لَحِقَ المُستَعانُ بالمُستَعينِ",48,"ن",1,0],["عجزتْ وربِّكَ أنْ تصوِّر لوعتي","أنَّى تصوِّرُ جمرةً ودُخانا ؟!",49,"ن",2,0],["عجزت عن الأسفار قصداً لمكة","وطيبة دار المصطفى مفخر الفخر",50,"ر",1,0],["عجزتُ عن الدنيَا فما ليَ من يدٍ","بِها وليَ الأيَدُ المساعدُ واليَدُ",51,"د",1,0],["عجز الطَّبيب وأيُّ داءٍ","في الفؤاد له وجيب",52,"ب",1,0],["عجزت بأن أقضي لها حقَّ شكرها","فليسَ يعني نظمي بذاك ولا نثري",53,"ر",2,0],["عجزاءُ ممكورةُ الوشاحِ لها","صفحةُ وجهٍ ما عيبَ بالنّدَبِ",54,"ب",1,0],["عجزٌ ثَناهُ عن الجوابِ فعذرُه","خافٍ وعُذْري في الهِجاءِ جَليُّ",55,"ي",1,0],["عَجَزتْ قرائحُهم وأغدرُ غادرٍ","يومَ الخصام الفاءُ بالفأفاءِ",56,"ا",2,0],["عجزتُ فما لي حيلةٌ في هواكمُ","سوى أنني أزداد وجداً مع الصدِّ",57,"د",1,1],["عجزتْ نحاةُ الحربِ يومَ نزاله","عن كنه أفعال لهُ ومصادر",58,"ر",1,0],["عجزي جسيم أمام القاصرين بما","قالوه فيه وإن حفوا بإمداد",59,"د",1,0],["عجزُ البريَّة عند قدسك ظاهر","وخلاف هذا الشرط بيعٌ فاسدُ",60,"د",1,0],["عجزُهُمْ لولا القَضا في نَعْلِهِمْ","ظاهِرٌ إنْ قُدَّ منها الشَّرَكُ",61,"ك",1,0],["عجزت ولا أدري تدارك أمره","أرى حالة في الحالتين على السوا",62,"ا",1,0],["عَجِزَتْ خيولُ (الرُّومِ) عنك فلم تَطَأْ","مأواكَ في جَبَلِ البيانِ وسَهْلِهِ",63,"ل",2,0],["عَجزوا مُعظمَ الزّمانِ فلمّا","قَدَروا بعد عجزهمْ ظلمونا",64,"ن",2,0],["عجزتْ يدي عن أنْ تَبَرَّكَ ميّتاً","فخذ المبرَّةَ كلّها من منطقي",65,"ق",2,0],["عجزنا عن مواقع الشكر شكرٌ","لممدٍّ فناءنا بدوامِهْ",66,"ه",1,1],["عجزت عقول ذوي النهى عن كنهه","وتولهت عين السوى في شبهه",67,"ه",1,0],["عَجزتُ فَأَظهَرتُ القَبولَ كَتابِعٍ","عَجوزاً يُصَلّي خَلفَها وَهيَ حائِضُ",68,"ض",1,0],["عجزَ الملوكُ بما نهضتَ بحمْلهِ","وسهرتَ فيه حِينَ باتُوا هُجَّدا",69,"د",2,0],["عجِزَت سيوفُ الهندِ من أَقْلامِه","عن قَطْعها فكأَنَّما هي قِرْبُها",70,"ب",3,0],["عجز الطبيب فأسرعوا لمقدس","كي يستطبوا منه ما يُبرى الضنى",71,"ن",2,0],["عجز اليراع عن الق