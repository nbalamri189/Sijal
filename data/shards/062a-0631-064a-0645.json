ك الشر","https://www.poetsgate.com/ViewPoem.aspx?id=407",""],[6096,"رافض النعمة","https://www.poetsgate.com/ViewPoem.aspx?id=177722",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[6142,"لم تغن يوم حنين كثرة لبني ال","https://www.poetsgate.com/ViewPoem.aspx?id=155716",""],[6172,"إسْتِبْطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82520&r=&rc=7",""],[6212,"عيون الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1622&r=&rc=3",""],[463,"خصيمايَ من ظمياءَ واشٍ وشامتُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59995&r=&rc=51",""],[463,"هلْ لقتيلٍ على اللِّوى ثائرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60089&r=&rc=145",""],[572,"أَخِي بَلْ رئِيسي بَلْ أميري وسيّدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9500&r=&rc=357",""]],"verses":[["تُرَى منْ أحَلّ الغَدْرَ وهْوَ محرَّمٌ","وحرّمَ غُصْنَ الأقْحُوانِ على الرّشْفِ",0,"ف",1,0],["تَرى مِنكَ سَروَ المُلكِ في قَشَفِ التُقى","فَيَبرُقُها مَرأىً هُناكَ عُجابُ",1,"ب",1,0],["تَرى مِنهُ العِمامَةَ فَوقَ وَجهٍ","كَأَنَّ عَلى صَفيحَتِهِ صِقالا",2,"ل",2,0],["ترى مصفرّةً وبها أرتجاف","كعاشقة تململ في الفراش",3,"ش",1,0],["تَرى مَحجِراً مِنها إِذا ما تَنَقَّبَت","قَبيحاً وَما تَحتَ النِقابَينِ أَقبَحُ",4,"ح",1,0],["تَرى مِنهُمُ مُستَبصِرينَ عَلى الهُدى","وَذا التاجِ يُضحي مَرزُباناً مُسَوَّرا",5,"ر",2,0],["تَرى مِنَ اللُؤمِ رَقماً بَينَ أَعيُنِهِم","كَما كَوى أَذرُعِ العاناتِ كاويها",6,"ي",3,0],["تَرى مُترَعَ الشيزى يَزينُ فُروعَها","عَبائِطُ مِتلافِ اليَدَينِ خَصيبِ",7,"ب",1,0],["تَرى مُترَعَ الشيزى الثِقالِ كَأَنَّما","تَحَضَّرَ مِنها أَهلُها فُرَضَ البَحرِ",8,"ر",1,0],["تَرى ما يَمَسُّ الأَرضَ مِنهُ إِذا مَشى","صُدوعاً نَفَت عَنها مُتونَ الدَكادِكِ",9,"ك",1,0],["تَرى مَشفَرَ العَيساءِ حينَ تَسوفُهُ","إِذا وَجَدَت طَعمَ المَرارَةِ أَكزَما",10,"م",2,0],["تَرى مِصرَ كَعبَةَ أَشعارِهِ","وَكُلِّ مُعَلَّقَةٍ قالَها",11,"ل",3,0],["تَرى مُقلَتي ما لا تَرى في لِقائِهِ","وَتَسمَعُ أُذني رَجعَ ما لَيسَ تَسمَعُ",12,"ع",1,0],["تَرى ما يَمُسُّ الأَرضَ مِنهُ إِذا سَرى","صُدوعاً تَفَأّى بِالدَكادِكِ صُلَّدا",13,"د",2,0],["تَرى مِن تَلَظّيها الظِباءَ كَأَنَّها","مُوَقَّفَةٌ تَغشى القُرونَ وُعولُها",14,"ل",3,0],["تُرى مِثلَ أَنضاءِ السُيوفِ مِنَ السُرى","جَراشِعَةَ الأَجوازِ يَنجو رَعيلُها",14,"ل",3,0],["تَرى مَزِقَ السِربالِ فَوقَ سَمَيدَعٍ","يَداهُ لِأَيتامِ الشِتاءِ طَعامُها",15,"م",3,0],["تَرَى ما تَرى من بَأسِهِم في عِداتِهم","بِأَطرافِ بيضِ الهندِ والأسَل الخطي",16,"ط",2,0],["تَرى مَواقِعَها في الأَرضِ لائِحَةً","مِثلَ الدَراهِمِ تَبدو ثُمَّ تَستَتِرُ",17,"ر",1,0],["تَرى مَشيَها تَحتَ القِناعِ كَأَنَّهُ","ضَفائِرُ ليفٍ في هَدِيَّةِ حُجّاجِ",18,"ج",1,0],["تَرى مِنّي لَهُ بُدّاً","وَما لي مِنهُ مِن بُدِّ",19,"د",1,0],["تَرَى ما نالت الأضْيافُ نَزْراً","ولو مُلِئَتْ من الذّهَبِ الجِفانُ",20,"ن",1,0],["ترى مَيْعة الأطراب والطبل هادر","تفيض وفي أعصابهم تتميَّع",21,"ع",1,0],["تَرَى مَا اعْتِذَارُ الكَاذِبِينَ الأُولَى سَعَوْا","سِعَايَاتِهِمْ فِيهِ وَقَدْ زَهَقَ البُطْلُ",22,"ل",1,0],["ترى مصرُ روحَك في كلِّ نجمٍ","يغيبُ، وفي كلِّ نجمٍ ظهر",23,"ر",1,0],["ترى معجزات العلم تتْرى، فهَلْ أرى","شبابِيَ من بعد المَشِيبِ يضيء؟",24,"ي",2,0],["ترى ما اسمه ؟ لا يعرف الناس ما اسمه","وسوف تسميه العصافير ، أخضرا",25,"ر",2,0],["ترى مقلتي ما ليس تملكه يدي","وما زلت اسعى منفض الكف محوجا",26,"ج",2,1],["ترى ميعة الاطراب والطبل هادرٌ","تفيض وفي أسماعهم تتميع",27,"ع",1,0],["ترى ما انت ماذا فيك","من سِرٍّ ومن مَعنى",28,"ن",2,1],["تَرى من أنت هل رَب","هَبَطتَ الأرضَ للسُكنى",28,"ن",2,0],["ترى مَن أنت يا بَرقاً","يُردِّدُ رَعدهُ اللَحنا",28,"ن",2,0],["تَرى مزْوَجَ الحُسْنِ في مُفْرَدٍ","جَلِيلُ المَحاسِنِ فيهِ دَقيقُ",29,"ق",1,0],["تَرى مَناقِب كُلِّ الناسِ إِن سَفَرَت","أَدنى مَناقِبهِ تَخزى فَتَنتَقِبُ",30,"ب",1,0],["تَرى منه تحتَ الريح دِرْعا وجَوْشنَا","وسيفا بلا غمد إذا كان راكدا",31,"د",2,0],["ترى من بعده من للفتاوي","اذا ما الامر اشكل في خفاء",32,"ا",2,0],["ترى مباسِمَهم تحكي قلائدَهم","تحتَ الفروعِ بروقٌ في دُجن الظُلَمِ",33,"م",1,0],["تُرى ماذا يَحُلُّ بِنا إِذا ما","أُصيبَ بِنَكبَةٍ اللَهُ أَدرى",34,"ر",2,0],["تَرى مِنهُمُ العاتي يَقيء نخاعَه","صَباغاً عَلى شَسع الغُزاةِ وَيسجدُ",35,"د",1,0],["تُرى مَن رَأى قَبلي الوجودَ مهدّماً","وَمن ذا رَأى الأَحرارَ بانِيَةً قَبلي",36,"ل",2,0],["تَرى ما عَلى اللاحينَ في حُبِّكُم مِني","فُؤادي المُعَنّى وَالقَريحُ بِكُم جَفني",37,"ن",2,1],["ترى مالَه نَهْبَ العُفاة وعِرضَهُ","يطاعن عنه بالقَنا كلُّ فَيْلَقِ",38,"ق",1,0],["تَرى من غَرامي به دائِمٌ","وَحاليَ مِن فقده حائِلُ",39,"ل",1,0],["تَرى مَدى الدَهر من أفضاله عجباً","فَنَحنُ كُلَّ شهورِ الدَهر في رَجَبِ",40,"ب",1,0],["ترى من نبيها كلَّ بشٍ تخاله","من البشر ذا قربى وَخلاً مصافيا",41,"ي",2,0],["تَرى منه مَلْكاً لا يُوازيهِ مُشبِهٌ","من النّاسِ لا أصلاً شريفاً ولا نَفْسا",42,"س",2,0],["تَرى منه مَلْكاً عظَّم اللهُ شَأنَه","فعِصْيانُه غَيٌّ وطاعتُه هُدى",43,"د",2,0],["تُرى مِن دُموعي قَبلَ تَرجِعُ مِن دَمٍ","سُقيتَ فَأَطلَعتَ الأَقاحَ شَريقا",44,"ق",2,1],["تَرى مِنهُ سَدّاً مِن حَديدٍ كَأَنَّما","رَأَيتَ بِهِ في اليَومِ لَيلاً إِذا يَسري",45,"ر",2,0],["تَرى منهُم يوم الوَغى كلَّ ناِشرٍ","من النَّقعِ فوقَ الدّارِ عينَ مطاردا",46,"د",2,0],["تَرى ماءَ الشَّباب يَجولُ فيها","وقَد أفنَت من النَّاسِ القرُونا",47,"ن",2,0],["ترى منهم عَرِيّاً بل سَرِيّاً","وصدّيقاً مضيئاً كاللآلي",48,"ل",2,0],["ترى منهمُ عدلاً سريّاً وناسكاً","عريّا وصديقاً بريّا وقِدّيسا",49,"س",2,0],["ترى منه نماماً ضجوراً وكاذباً","يبيد خشوعاً حين يلهو ويعبث",50,"ث",1,0],["ترى معاديَهمُ في كلِّ معركةٍ","شهبُ البزاةِ سواءٌ فيه والرخَمُ",51,"م",1,0],["ترى ماله في كل كف مفرقاً","يباع بأدنى سومة لمساوم",52,"م",1,0],["تَرى مياه النَدى تَجري بأنملة","تَرَقرَقَ الماءِ في الهِندِيَّةِ البترِ",53,"ر",1,0],["تَرى محاسِنَهُ عَيْنِي وتُعرِضُ عن","قَبِيحِ أفعالِهِ أو ليسَ تُبْصِرهُ",54,"ر",2,0],["ترى من وجهه ما قد تراه","على وجه الصَّباح المستنير",55,"ر",1,0],["ترى من ثغور الغيد جئت مبلغاً","فؤاد أخي الأشواق رمضاً على رمضِ",56,"ض",1,0],["ترى مالَه نهباً ترى عِرضَه حِمًى","وسؤدُدَه جمّاً ونائلَه غَمرا",57,"ر",2,0],["ترى من الاجتهار منها طوالعاً","وفيها منال الكف عنها اعترابها",58,"ب",3,0],["ترى مغسولة الأعراض منها","نتائجَ ما تدرَّن من ظُباها",59,"ا",3,0]