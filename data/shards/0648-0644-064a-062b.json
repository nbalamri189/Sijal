{"poems":[[39,"نفى عن عينك الأرق الهجوعا","https://www.aldiwan.net/poem7654.html","الوافر"],[80,"أوجه البدر يشرق في الظلام","https://www.aldiwan.net/poem14061.html","الوافر"],[82,"وليث مقيم في غياض منيعة","https://www.aldiwan.net/poem31232.html","الطويل"],[82,"أباد حياتي الموت إن كنت ساليا","https://www.aldiwan.net/poem31246.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[173,"ترى حيث أعلام العيون تراها","https://www.aldiwan.net/poem1689.html",""],[214,"تريك الصبح في الليل البهيم","https://www.aldiwan.net/poem13402.html","الوافر"],[286,"إذا ما علا يأسي يغالب لي الرجا","https://www.aldiwan.net/poem1362.html",""],[358,"طريفا كان مجدك أم تليدا","https://www.aldiwan.net/poem40396.html","الوافر"],[385,"بدا البرق مشتاقا فباتت سيوفه","https://www.aldiwan.net/poem48839.html","الطويل"],[408,"جمال الهدى والمكرمات ومن له","https://www.aldiwan.net/poem46522.html","الطويل"],[422,"أفي الطلل الحديث أو القديم","https://www.aldiwan.net/poem54063.html","الوافر"],[438,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[445,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[445,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[466,"ترفعت عن مدح الرجال وقادني","https://www.aldiwan.net/poem15117.html","الطويل"],[466,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[473,"وليث لم يخس مذ كان شبلا","https://www.aldiwan.net/poem59956.html","الطويل"],[519,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[534,"أجزتك أيها المولى بما في","https://www.aldiwan.net/poem37478.html","الوافر"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[568,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87017","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87118","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130204","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122377","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63990","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38407","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105449","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120053","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59118","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59117","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59113","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96706","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96707","الوافر"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203796","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35412","المتقارب"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35399","الوافر"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/97672","الوافر"],[1114,"","https://poetry.dctabudhabi.ae/diwan/poem/124084","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64877","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31560","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137866",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49949","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122105","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122089","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21665","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118440","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143007","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74238","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46914","الطويل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104829","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108390",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117997","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36768","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66582","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69970","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127259","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97066","الطويل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117201","المتقارب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83175","الوافر"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124649","الطويل"],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""],[5358,"لكِ الأمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=202300",""],[5409,"أصقر تهامة والأبطحين","https://www.poetsgate.com/ViewPoem.aspx?id=155485",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[463,"إذا صاحَ وفدُ السحبِ بالريح أو حدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60015&r=&rc=71",""]],"verses":[["وَليثاً فِي المَشَاهِدِ غَيرَ نِكسٍ","لِتَقوِيمِ البَرِيَّةِ مُستَطِيعَا",0,"ع",2,0],["وَلَيثَ الغاب إِقداما وَبأسا","وَرَبَّ الفَضلِ وَالنِعَم الجِسامِ",1,"م",1,0],["وليثٍ مقيم في غياضٍ منيعَةٍ","أميرٍ على الوَحشِ المقيمةِ في القَفْرِ",2,"ر",1,1],["وليث حروب فيه أعدوا برقِّه","وقد كان مقداماً على الليث عاديا",3,"ي",2,0],["وَلْيَثْبُتُوا وَيُجَدِّدُوا","نَجَدَاتِهِمْ مِنْهُمْ بُهَمْ",4,"م",1,0],["وَلَيثٌ مِنَ العِيصِ بنِ إِسحاقَ عِيصُهُ","يَراها بِعَينِ الوُدِّ حينَ يَراها",5,"ا",3,0],["ولي ثعبان ذاك الشعر القت","فصحت من الجوى يا للكليم",6,"م",1,0],["ولي ثقة بالله أعلم وأنها","تسهِّل صعبي إن زمانيَ حرّجا",7,"ج",2,0],["وَلَيث الغاب لَيسَ يَتيه عزّاً","عَلى الأَقران إِلّا أَن يَصيدا",8,"د",2,0],["وَلي ثُمَّ أَلف بنت عَنهُ فَلَم يَكُن","يَرى لي إِلى وَجه مِن الصَبر مسلك",9,"ك",1,0],["وليث الوغى إن قهقرتْ أسد الشرى","وقيل غداة الرّوع أين فلان",10,"ن",1,0],["وليثٍ دون ذاك الحيّ يرمي","فيصرَعُ في سهام لحاظ ريم",11,"م",1,0],["وليثاها اللَّذانِ ترى الأَعادي","متى شَاءَا لَهُمْ إِبلاً وشاءَ",12,"ا",2,0],["وليثُ ليوثٍ يُصْعِقُ الأرضَ زأرُها","ويَقْدُمُها فِي حَوْمَةِ الموتِ زَارُهُ",13,"ر",2,0],["ولَيثٌ تَحْتَ سابغَةٍ دلاصٍ","وغيثٌ بَيْنَ أَثناءِ الوشاحِ",14,"ح",1,0],["وليثَ الشرى تحت السُّرادق مُلبِداً","وبحرَ الندى فوق الأسرَّة مُزبِدا",15,"د",2,0],["وليثٌ إذا خامَ الكميُّ جرتْ به","عزائكُ لا نابٌ طريرٌ ومِخلبُ",16,"ب",1,0],["وليث أنت لكن الضَّواري","لها من فَرْط هيبته حِذارُ",17,"ر",1,0],["وَلَيثٍ لَم يَخِس مُذ كانَ شِبلاً","لَهُ الأَقدامُ وَالخَطِّيُّ خيسُ",18,"س",1,1],["وليثِ عَرينٍ بالحديدِ مسرْبَلٍ","وخِشفِ كِناسٍ بالنُضارِ تخزّما",19,"م",2,0],["وَلِي ثَبَتٌ سَتَعْرِفُهُ ففِيهِ","رِواياتٌ أَطَلْتُ بِها مَرَاحي",20,"ح",2,0],["وليثاً ترى في كلّ يومٍ بجنبه","لصرعاه أعضاداً قُطعن وأسؤقا",21,"ق",2,0],["وَلَيثٌ بِحَقِّ اللَهِ لَم يُبقِ رُعبُهُ","عُواءً لِكَلبِ التُرَّهاتِ وَلا نَبحا",22,"ح",2,0],["وَلَيثٍ يَلتَقي الأَعدا بِصَدر","رَحيب لا يَهاب وَلا يمل",23,"ل",1,0],["وَليث هصور إن سطا جَيشُ فهمه","عَلى الجهل أَمسى في قيود حمام",24,"م",1,0],["وليث الشرى لو كان لليث فطنة","وسمر القنا بالعدل لم تتعقد",25,"د",1,0],["وليث هياج ما غنين جفونه","من الكحل الا والعجاج لها كحل",26,"ل",1,0],["ولي ثناءٌ متى أَلقَ ذا كرَمْ","أَضعْ له منه حدّاً لم أكُنْ أَضَع",27,"ع",1,0],["وَلَيث عَرينٍ بَينَ أسد ضَياغِمٍ","أَضاقَ بِمَن عاداهُ رَحب المَذاهِبِ",28,"ب",1,0],["وليث إذا ما الحرب تسعر نارها","يخوض لظاها بالحسام المهند",29,"د",1,0],["وليثا يوم معركة","وغيثا ينبت النعما",30,"م",2,0],["وليث كفاح إن تراكم حارث","وغيث سماح إن تكاثر حوب",31,"ب",1,0],["وَلَيْثٌ أرَادَ اللَّيْثُ يَحْكِيهِ شِدَّةً","وَكَيْفَ يُضَاهِي الصّيدَ في البَأسِ ثعْلبُ",32,"ب",1,0],["وليث حرب به كففنا","صوائل العتل العوادي",33,"د",2,0],["وَلَيْثُ وَغىً خَاضَ المَنَايَا بِصَارِمٍ","يُزِيحُ سَنَاهُ خَطْبَ لَيْلِ القَوَاضِبِ",34,"ب",1,0],["وَلَيْثُ غَابٍ إذَا مَا ازْوَرَّ عَنْ حَنَقٍ","أقَامَ جَيْشَ العِدَى في موْقفِ الدُّونِ",35,"ن",1,0],["وَليثُ حربٍ له تعنو ضراغمهُ","وَليسَ غاباته إلّا عواسلهُ",36,"ل",2,0],["وَليثُ وغىً وليسَ له عرين","سوى الأسياف والسمر المعالي",37,"ل",2,0],["وليثٍ عن خميلته طريدٍ","ونسرٍ فوق ملعبه طريح",38,"ح",1,0],["وَلَيثٍ تَوَقّى أُسودُ الشَرى","لَدى الحَربِ أَسيافَهُ الماضِيَه",39,"ي",2,0],["وَلَيثُ وَغىً إِذا زَأَرَ اِمتِعاضاً","يَروعُ زَئيرُهُ هِنداً وَصينا",40,"ن",2,0],["ولَيثاً حين تشتَجِرُ العوالي","تروقُ له عيونُ الناظِراتِ",41,"ت",1,0],["وليث الشرى غضبان يحرق نابه","حلائله غرثى وغرثى ضراغمه",42,"م",2,0],["ولي ثَوبُ سُقْمٍ مُحْرِقٌ مِنْ جٌفونِهِ","معارٌ وأَثْوابُ العَواري لا تُدفّي",43,"ف",2,0],["وَلَيْثُ الشَّرى لا تُنْكِرُ العَيْنُ أَنْ تُرَى","بَرَاثِنُه مَخْضُوبَةً والمَخَالِبُ",44,"ب",1,0],["وليث حمى يحمى من الجور جاره","وبدر كمال يحسد البدر علياه",45,"ا",2,0],["وليثان فرّاسانِ كلّ مدَّججٍ","وأيهما لاقى العدى لم يُعرِّدِ",46,"د",1,0],["وَلَيْثٌ إِذَا مَا ظَلَّ يَهْدِرُ غَاصَ فِي","دِمَاءِ العِدَى الذِّئْبُ الذي إِثْرَهُ عَوَى",47,"و",2,0],["وَلَيْثُ الوَغَى الشَّهْمُ الَّذِي لِعدَاتِهِ","بِأَسْيَافِهِ فِي التُّرْبِ أَيّ مَرَاغِ",48,"غ",1,0],["وَلِيُثنِيَنَّ عَلَيَّ مِنهُم صادِقٌ","خَيراً وَمَحمَدَةً تُعَدُّ فَعالُها",49,"ل",3,0],["وليثني لستُ أرضى","أورست عمَّا قليل",50,"ل",1,0],["وليث صيود لليوث وماله","نيوب ولا ظفر خبعثنة ورد",51,"د",1,0],["وليث قتال، دون حق يغوله","عدوّ اخو حمق، وربّ حصاة",52,"ه",1,0],["وَلَيث جدال أفحم الخصم وَحده","وَإن كثرت يَوم الجِدال خصام",53,"م",1,0],["ولَيْثَ كِفاح كُلَّما اسْتَشْرَفَ الوَغَى","وَما أغْنَتِ الأَبْطَالُ عَنْهُ ولا عَنَّا",54,"ن",2,0],["وليث وغى يأبى سوى شجر القنا","لدى الروع غابا والمهند مخلبا",55,"ب",2,0],["وليث عرين خادر دون بابها","هناك حمى من دوننا غادة الخدرِ",56,"ر",1,1],["وليث القراع القاسم ابن محمد","خضم الندى الفياض والطور من سينا",57,"ن",2,0],["وَلَيث مَوالي العَصر دانَت لِمَجدِهِ","وَحَسبُكَ مَجدٌ لا يُدانيه طامِعُ",58,"ع",1,0],["وَلَيْثُ غابٍ تَرُدُّ الْجَيْشَ سَطْوَتُهُ","أَخْنَى عَلَيْهِ قَضاءٌ غَيْرُ مَرْدودِ",59,"د",1,0],["وَلَيثاً في الوَغى يَوم الطعانِ","إِلى يَومٍ نَراكُم في الجِنانِ",60,"ن",1,0],["وليثا منه يخشى الموت حتفا","رعاه الله من ليث همام",61,"م",1,0],["وليث إذا ما استل صارم بأسه","له مدت الأعناق طوعاً رقابها",62,"ب",3,0],["ولَيثٌ يصولُ على قرنهِ","إذا ما دعيتَ إلى أكلَه",63,"ل",2,0],["وَلَيثٌ لَم يُحَطِّمهُ جِهادٌ","وَلَم يَخذُله في الهَيجاء نابُ",64,"ب",1,0],["وليث نمته الغلب من هاشم الألى","قبابهم في ذروة المجد تضرب",65,"ب",1,0],["وليث هصور تتقى جيشه به","وطيس الوغى والحرب نار تضرم",66,"م",1,0],["وليث الغاب من يدعى علي","كريم الوجه عنوان الفداء",67,"ا",2,0],["ولي ثقةٌ باللهِ أني بحبِّها","سأُنجحُ في الأولى وأنجحُ في الأخرى",68,"ر",2,0],["وليثا تأجم في غابه","عروش الملوك وتيجانها",69,"ن",3,0],["وَلَيْثُ حُرُوبٍ يَتْرُكُ اللَّيْثَ مُلْحَما","وَما غابُهُ إِلاَّ قَناً وَصِفاحُ",70,"ح",1,0],["وليثُ وغىً لو قَابَلَ الليثَ أَعْزَلاً","وحَارَبَهُ لم يُغْنِهِ النابُ والظُّفْرُ",71,"ر",1,0],["وليثُ الغابِ إن غابَ","حَمَى موضِعَهُ الشِّبْلُ",72,"ل",1,0],["وليثَ الشرى تحت السرادق ملبدا","وبحرَ الندى فوق الأسرة مزدا",73,"د",2,0]]}