{"poems":[[37,"نفى عن عينك الأرق الهجوعا","https://www.aldiwan.net/poem7654.html","الوافر"],[78,"أوجه البدر يشرق في الظلام","https://www.aldiwan.net/poem14061.html","الوافر"],[80,"وليث مقيم في غياض منيعة","https://www.aldiwan.net/poem31232.html","الطويل"],[80,"أباد حياتي الموت إن كنت ساليا","https://www.aldiwan.net/poem31246.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[169,"ترى حيث أعلام العيون تراها","https://www.aldiwan.net/poem1689.html",""],[210,"تريك الصبح في الليل البهيم","https://www.aldiwan.net/poem13402.html","الوافر"],[281,"إذا ما علا يأسي يغالب لي الرجا","https://www.aldiwan.net/poem1362.html",""],[353,"طريفا كان مجدك أم تليدا","https://www.aldiwan.net/poem40396.html","الوافر"],[380,"بدا البرق مشتاقا فباتت سيوفه","https://www.aldiwan.net/poem48839.html","الطويل"],[402,"جمال الهدى والمكرمات ومن له","https://www.aldiwan.net/poem46522.html","الطويل"],[416,"أفي الطلل الحديث أو القديم","https://www.aldiwan.net/poem54063.html","الوافر"],[432,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[439,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[439,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[458,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[461,"ترفعت عن مدح الرجال وقادني","https://www.aldiwan.net/poem15117.html","الطويل"],[461,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[468,"وليث لم يخس مذ كان شبلا","https://www.aldiwan.net/poem59956.html","الطويل"],[514,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[529,"أجزتك أيها المولى بما في","https://www.aldiwan.net/poem37478.html","الوافر"],[551,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[563,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"]],"verses":[["وَليثاً فِي المَشَاهِدِ غَيرَ نِكسٍ","لِتَقوِيمِ البَرِيَّةِ مُستَطِيعَا",0,"ع",2,0],["وَلَيثَ الغاب إِقداما وَبأسا","وَرَبَّ الفَضلِ وَالنِعَم الجِسامِ",1,"م",1,0],["وليثٍ مقيم في غياضٍ منيعَةٍ","أميرٍ على الوَحشِ المقيمةِ في القَفْرِ",2,"ر",1,1],["وليث حروب فيه أعدوا برقِّه","وقد كان مقداماً على الليث عاديا",3,"ي",2,0],["وَلْيَثْبُتُوا وَيُجَدِّدُوا","نَجَدَاتِهِمْ مِنْهُمْ بُهَمْ",4,"م",1,0],["وَلَيثٌ مِنَ العِيصِ بنِ إِسحاقَ عِيصُهُ","يَراها بِعَينِ الوُدِّ حينَ يَراها",5,"ا",3,0],["ولي ثعبان ذاك الشعر القت","فصحت من الجوى يا للكليم",6,"م",1,0],["ولي ثقة بالله أعلم وأنها","تسهِّل صعبي إن زمانيَ حرّجا",7,"ج",2,0],["وَلَيث الغاب لَيسَ يَتيه عزّاً","عَلى الأَقران إِلّا أَن يَصيدا",8,"د",2,0],["وَلي ثُمَّ أَلف بنت عَنهُ فَلَم يَكُن","يَرى لي إِلى وَجه مِن الصَبر مسلك",9,"ك",1,0],["وليث الوغى إن قهقرتْ أسد الشرى","وقيل غداة الرّوع أين فلان",10,"ن",1,0],["وليثٍ دون ذاك الحيّ يرمي","فيصرَعُ في سهام لحاظ ريم",11,"م",1,0],["وليثاها اللَّذانِ ترى الأَعادي","متى شَاءَا لَهُمْ إِبلاً وشاءَ",12,"ا",2,0],["وليثُ ليوثٍ يُصْعِقُ الأرضَ زأرُها","ويَقْدُمُها فِي حَوْمَةِ الموتِ زَارُهُ",13,"ر",2,0],["ولَيثٌ تَحْتَ سابغَةٍ دلاصٍ","وغيثٌ بَيْنَ أَثناءِ الوشاحِ",14,"ح",1,0],["وليثَ الشرى تحت السُّرادق مُلبِداً","وبحرَ الندى فوق الأسرَّة مُزبِدا",15,"د",2,0],["وليثٌ إذا خامَ الكميُّ جرتْ به","عزائكُ لا نابٌ طريرٌ ومِخلبُ",16,"ب",1,0],["وليث أنت لكن الضَّواري","لها من فَرْط هيبته حِذارُ",17,"ر",1,0],["وَلَيثٍ لَم يَخِس مُذ كانَ شِبلاً","لَهُ الأَقدامُ وَالخَطِّيُّ خيسُ",18,"س",1,1],["وليثِ عَرينٍ بالحديدِ مسرْبَلٍ","وخِشفِ كِناسٍ بالنُضارِ تخزّما",19,"م",2,0],["وَلِي ثَبَتٌ سَتَعْرِفُهُ ففِيهِ","رِواياتٌ أَطَلْتُ بِها مَرَاحي",20,"ح",2,0],["وليثاً ترى في كلّ يومٍ بجنبه","لصرعاه أعضاداً قُطعن وأسؤقا",21,"ق",2,0],["وَلَيثٌ بِحَقِّ اللَهِ لَم يُبقِ رُعبُهُ","عُواءً لِكَلبِ التُرَّهاتِ وَلا نَبحا",22,"ح",2,0]]}