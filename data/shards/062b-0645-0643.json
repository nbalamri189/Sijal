الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[201,"ليس عيدا بل مأتم يا صحابي","https://www.aldiwan.net/poem39805.html","الخفيف"],[302,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[409,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[409,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[500,"أخرجته يا سيدي","https://www.aldiwan.net/poem9810.html","مجزوء الرجز"],[510,"نحن لا نكذب ولكن نتجمّل","https://www.aldiwan.net/poem27793.html","الخفيف"],[563,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[563,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[563,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2410","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70922","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46510","الرجز"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33091","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205780","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204578","الخفيف"],[2950,"","https://poetry.dctabudhabi.ae/diwan/poem/141825","الرمل"],[2959,"","https://poetry.dctabudhabi.ae/diwan/poem/99063","المنسرح"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203551","الرجز"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/6","الخفيف"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202268","الرجز"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131345","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123495","الخفيف"],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5797,"عجبًا لابن آدم","https://www.poetsgate.com/ViewPoem.aspx?id=187797",""]],"verses":[["ثُمَّ كانَت بِقُباءٍ وَقفَةٌ","ضَمِنَت لِلشَوقِ قَلباً ضَمِنا",0,"ن",2,0],["ثُمَّ كانَت فَترَةٌ مَقدورَةٌ","غَرَّ فينا الدَهرُ ضَعفٌ فَهَجَم",1,"م",1,0],["ثُمَّ كانا خَيرَ مَن نالَ النَدى","سَبَقا الناسَ بِإِقساطٍ وَبِرّ",2,"ر",1,0],["ثم كفاني بالذي تَرْتَئي","في جَيّد الشعر وفي شاعرِهْ",3,"ر",2,0],["ثم كَمْ خَلْوةٍ لهم يَمخضونَ ال","رأى فيها ناهيكَ من مُخَّاض",4,"ض",1,0],["ثم كان الغواة فيه فريقين","لكل عتاده والسلاح",5,"ح",1,0],["ثم كان الذي به جرت الاقدار","من سقطة لهم وبوار",6,"ر",1,0],["ثُمَّ كَشَّحتَني عَلى غَيرِ جُرمٍ","فَأَنا وَالمُبارَكِيُّ سَواءُ",7,"ا",2,0],["ثم كنَّا لا نَبدأُ النّاسَ بالظل","مِ نَعافُ الذي يَعافُ الكِرَامُ",8,"م",1,0],["ثُم كانَت يَدٌ سَأَسكتُ عَنها","هَدَّمته إِلى سَواء الترابِ",9,"ب",1,0],["ثُمَّ كَسا الرِيشَ والعَقائِقَ أَب","شاراً وَجِلداً تَخالُهُ أَدَما",10,"م",2,0],["ثم كوبرنيك الذي كان قد أف","همنا أن الأرض جرمٌ يدور",11,"ر",1,0],["ثم كانَت حوادِثٌ خر منها","دَمعها فوق خدها مدرارا",12,"ر",2,0],["ثم كلمتها فردت كَلامي","بابتسام تَلوح فيه المَعاني",13,"ن",2,0],["ثم كان الغدُ ما نُبِّئتِ هجراً وفراقا","ونسينا قبلةً ساغتْ على الأمسِ مذاقا",14,"ق",2,0],["ثُمَّ كانَ المِزاجَ ماءَ سَحابٍ","لا صِرً آجِنٌ ولا مَطروقُ",15,"ق",1,0],["ثُمَّ كَانَ اليَوْمُ الَّذِي نَدَبَتْهُ","مِصْرُ فِيهِ وَالأَمْرُ أَمْرٌ جُسَامُ",16,"م",1,0],["ثُمَّ كَلَّتْ شِبَعاً وَافْترَقَتْ","فِي الزوَايا تَتوَخَّى مُسْتَقَرَّا",17,"ر",2,0],["ثُمَّ كَانَ الفِرَاقُ مَا مِنْ رَجَاءٍ","بَعْدَهُ لِلِّقَاءٍ قَبْلَ المَعادِ",18,"د",1,0],["ثُمَّ كانَت دونَ اللِحافِ لِمَشغو","فٍ مُعَنّىً بِها مَشوقٍ شِعارا",19,"ر",2,0],["ثمَّ كُوني كالشَّمس تَسْطَع لِلنَّا","سِ سَواءً مَْ عَزّ مِنْهُم وَذلاّ",20,"ل",2,0],["ثم كانتْ عَواقِبُ الصَبْرِ أَنْ ذَلَّتْ","له الشَارِداتُ بَعْدَ الحِرانِ",21,"ن",1,0],["ثم كَمْ خَلْوة ٍ لهم يَمْخضونَ الرْ","رأى فيها ناهيكَ من مُخَّاضِ",22,"ض",1,0],["ثمَّ كُوني كالشَّمس تَسْطَع للِنَّا","سِ سَواءً مَنْ عَزّ مِنْهُم وَذلاّ",23,"ل",2,0],["ثُمَّ كانَ المِزاجُ ماءَ سَحابٍ","لا صَدىً آجِنٌ وَلا مَطروق",24,"ق",1,0],["ثمّ كانَت سَعادةُ الأنصارِ","وَحَماهم بهجرة المختارِ",25,"ر",1,0],["ثمَّ كعبٌ ومرّةٌ وكلابٌ","وقصيٌّ وكلُّهم كرماءُ",26,"ا",2,0],["ثمّ كسّرتُ بعد ذلك إبري","قي وعودي ولم أدع أكوابي",27,"ب",2,0],["ثمّ كُن لي من ذُنوبي شافعاً","يوم يَقضي اللَه عفواً واِنتقاما",28,"م",2,0],["ثم كان الفتح والفيْءُ بها","واصطفى المختار من تلك صفيا",29,"ي",2,0],["ثم كَلَّ الصبر إذ طال النوى","وانتهى إذ بلغ السيل الزُّبا",30,"ب",2,0],["ثم كان المهديُّ يجلس للأن","س فيصفي لشربه أوطاره",31,"ر",2,0],["ثم كان الهادي إِذا حاول الشر","ب وغنى ابن جامعٍ مختاره",31,"ر",2,0],["ثم كان الأمين يمرح من لذا","ته في أَعِنَّةٍ مَوّارهْ",31,"ر",2,0],["ثم كَمَحْني فمه","ثم كشدّ في الهجا",32,"ج",2,0],["ثم كونوا لي لا لِمنْ هنّ دوني","قد علِمتم أنّي امراةٌ غيورُ",33,"ر",1,0],["ثم كونوه بالفنا وليَكُنْكُم","بالبقا فهو أصلُ فرع أصيل",34,"ل",1,0],["ثم كن فيما يكون كما","كنت في أيامك الأُوَل",35,"ل",1,0],["ثم كونوا إثر سنته","وبها فامشوا على نسق",36,"ق",1,0],["ثم كساه خلعا وغلفه","بيده مبجلا وصرفه",37,"ه",1,0],["ثُمَّ كانَ الَّذي تَلَقّاكَ مِنهُ","نائِلٌ واسِعٌ وَسَيبٌ غَزيرُ",38,"ر",1,0],["ثم كاد الورى فأكثر فيهم","نقصَ أموالهم ونقصَ المواشى",39,"ش",2,0],["ثُم كناه مُسرِعاً وَنسبه","وَقَص كُل أمرِه وَمكسبه",40,"ه",1,0],["ثُمَّ كُفتَم دورَ بادٍ","وَيحَكُم آنَ خَرِ كُفتِ",41,"ت",1,0],["ثم كانا إلى القلوب رسولي","يَ وكانا عن كل شاك لساني",42,"ن",2,0],["ثم كم لي على السماء ديون","لست أرجو بأن تفيها السماء",43,"ا",2,0],["ثم كوني لولي ال","دهر خلداً وقرارا",44,"ر",2,0],["ثم كتبت العطوف حتى بتد","بيري بين الرؤوس ألّفت",45,"ت",1,0],["ثم كبيراً وأبا ماضي مع","خادم الرمل الذي ينْتَفِعا",46,"ع",2,0],["ثُمَّ كانَ الحِساءُ مِنهُم مُصيفاً","ضارِباتِ الخُدورِ تَحتَ الهَدالِ",47,"ل",1,0],["ثم كفاني في الأمور أمرا","قد كان أشجاني وهد الظهرا",48,"ر",2,0],["ثُمَّ كَلَّتْ فريحتي عن مَدِيحٍ","فاسْتعارَتْ له حَدِيقةَ حَمْدِ",49,"د",1,0],["ثم كسا الصدر بدرع تنير","وبين كتفيه الحسام الخطير",50,"ر",1,0],["ثم كساها أحمّ أسحمَ وبا","صاً وكلّ الظواهرِ اتبعا",51,"ع",2,0],["ثم كبت على الثرى أوجه الاصنام","فاستشعروا هجوم فسا",52,"س",2,0],["ثم كن ساحة عليها من الفر","دوس روح وروضة غناء",53,"ا",2,0],["ثم كحلٌ وما احتوت من نجومٍ","تتوالى مدى المدى باتصال",54,"ل",1,0]]}