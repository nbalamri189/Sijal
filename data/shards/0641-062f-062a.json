","https://poetry.dctabudhabi.ae/diwan/poem/40134","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45925","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146770","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72619","الوافر"],[4767,"نداء محرم","https://www.poetsgate.com/ViewPoem.aspx?id=179993",""],[4852,"أهواه","https://www.poetsgate.com/ViewPoem.aspx?id=214391",""],[5266,"إِنْطِوَاءٌ مُحَمّدِي","https://www.poetsgate.com/ViewPoem.aspx?id=210270",""],[5368,"أنين الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=184141",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5402,"لايجبر الكسر","https://www.poetsgate.com/ViewPoem.aspx?id=215526",""],[5431,"ستنتصر الشعوبُ بلا محالِ","https://www.poetsgate.com/ViewPoem.aspx?id=183074",""],[5431,"فدتك روحي يانبضي ويانغمي","https://www.poetsgate.com/ViewPoem.aspx?id=185003",""],[5431,"فداك القلب ياطفلا بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=188499",""],[5431,"فديتك...","https://www.poetsgate.com/ViewPoem.aspx?id=196955",""],[5508,"فدتك العلى إنّ وعد الكري","https://www.poetsgate.com/ViewPoem.aspx?id=110838",""],[5595,"منّا اليك ومن ميسانَ نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=144640",""],[5720,"خيرُ البريّةﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200025",""],[5738,"فَدَتْ نَفْسِ وَمَا مَلَكَتْ يَمِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=201130",""],[5742,"مولد النور","https://www.poetsgate.com/ViewPoem.aspx?id=206973",""],[5790,"تعشقت بدرا وجهه مشرقٌ كذا","https://www.poetsgate.com/ViewPoem.aspx?id=111948",""],[5881,"فدتك القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=183769",""],[6127,"تدور مدار العشق","https://www.poetsgate.com/ViewPoem.aspx?id=188376",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[6345,"جور الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78653&r=&rc=24",""]],"verses":[["فَدَتْهُنَّ نَفْسي لو سَمِعْنَ بِما أرى","رَمَى كُلُّ جِيدٍ مِنْ تنَهُّدِها عِقْدا",0,"د",2,0],["فدَتْكَ الأعاريبُ منْ ماجِدٍ","قَريبِ النّوالِ بَعيدِ المَدى",1,"ا",1,0],["فدتكِ كَوَاكِبُ الْخَضْرَا","ءِ لاَ عَجَمٌ وَلاَ عَرَبُ",2,"ب",1,0],["فَدَتكَ اِبنَ لَيلى ناقَتي حَدَثَ الرَدى","وَراكِبُها إِن كانَ كونٌ وَكورُها",3,"ر",3,0],["فَدَتكَ سُلَيمٌ كَهلُها وَغُلامُها","وَجُدَّعَ مِنها كُلُّ أَنفٍ وَمِسمَعِ",4,"ع",1,0],["فَدَت نَفسي الأَميرَ كَأَنَّ حَظّي","وَقُربي عِندَهُ مادامَ قُربُ",5,"ب",1,0],["فدتكم بني السبكيّ خلقٌ رفعتمو","فلا أحد إلا إذاً لكم الفداْ",6,"د",2,0],["فدت طلعة البدر المنير أبا الفدا","وإن كان أعلى من فداها وأرفعا",7,"ع",2,0],["فدَتْكَ نفوسُ الناس من ذي حياطةٍ","غدوتَ لهم أمّاً ممهّدة الحِجر",8,"ر",1,0],["فدتْ تلكم الأسماءَ بل حاملاتِها","زيانبُ أرضِ اللَّهِ بعد العواتك",9,"ك",1,0],["فدَتْكِ النفسُ وهي أقلُّ بذلٍ","صِلي حُسنَ المقالِ بحُسنِ فِعْلِ",10,"ل",1,1],["فدتْ نفسَ هذا نفسُ هذا من الردى","ومن كل محذورٍ من الأمرِ نازلِ",11,"ل",1,0],["فدته النفسُ من بانٍ كريمٍ","مبانيه المكارمُ لا الرُّخامُ",12,"م",1,0],["فَدَتكَ نَفسي لَو أَنَّهُمُ عَقَلَوا","وَاِستَشعَروا الحُبَّ مِثلَنا عَذَروا",13,"ر",3,0],["فَدَتكَ الجَوانِحُ مِن نازِلٍ","وَأَهلاً بِطَيفِكَ مِن واصِلِ",14,"ل",1,1],["فَدَتكَ مِياهُ دِجلَةَ وَهيَ سَعدٌ","وَلا جُعِلَت فِداءَكَ وَهيَ نَحسُ",15,"س",1,0],["فَدَتكَ نُفوسُ الحاسِدينَ فَإِنَّها","مُعَذَّبَةٌ في حَضرَةٍ وَمَغيبِ",16,"ب",1,0],["فَدَتكَ الخَيلُ وَهيَ مُسَوَّماتُ","وَبيضُ الهِندِ وَهيَ مُجَرَّداتُ",17,"ت",1,1],["فَدَتْكَ مُلُوكٌ لم تُسَمَّ مَوَاضِياً","فإنّكَ ماضِي الشّفْرَتَينِ صَقيلُ",18,"ل",1,0],["فَدَتكَ أَبا الخَطّابِ نَفسي مِنَ الرَدى","وَلازِلتَ تُفدى بِالنُفوسِ وَلا تَفدي",19,"د",2,0],["فَدَتكَ أَكُفُّ قَومٍ ما اِستَطاعوا","مَساعيكَ الَّتي لا تُستَطاعُ",20,"ع",1,1],["فَدَتكَ أَنفُسُ مُلتاحينَ أَنفُسُهُم","مُعَلَّقاتٌ بِرِيٍّ مِنكَ يُؤتَنَفُ",21,"ف",1,0],["فَدَتكَ يَدي مِن عاتِبٍ وَلِسانِيا","وَقَولِيَ في حُكمِ العُلا وَفَعالِيا",22,"ي",2,1],["فَدَتْكَ نَفيساتُ النُّفوسِ مِنَ الرَّدَى","ومثلُكَ يُفْدى بالنُّفوسِ النَّفائِسِ",23,"س",1,0],["فدتْكَ عدى همُ الأعداءُ غياً","وقدْ كانوا ذوي لسنٍ فصاحِ",24,"ح",1,0],["فَدَتكَ نَفسي يا أَبا جَعفَرِ","جارِيَةٌ كَالقَمَرِ الأَزهَرِ",25,"ر",1,1],["فدتك عراب اليوم أمي وخالتي","وناقتي الناجي إليك بريدها",26,"د",3,0],["فَدَتْكِ نَدامى لنا كالقِسِي","ي لا يَسْتَقيمونَ إلاّ ازْوِرارا",27,"ر",2,0],["فدت العيونُ النجل أجمعها","عينا تدفق ماؤها الهتن",28,"ن",1,0],["فدَتِ المنائِرُ كلُهُنّ منارةً","هي في فم الدنيا هدىً وتبسُمُ",29,"م",1,1],["فدَتِ المباسِمُ بسمةً في ثغرهِ","بأكرم دمعة وجراح",30,"ح",1,0],["فَدَتهُ مِن مُخوِلٍ مُعِمٍّ","غَطارِفٌ كُلُّها حَنيفُ",31,"ف",1,0],["فدّتك ناشئة البلاد وشمرت","لك عن سواعد عزمها الفتيان",32,"ن",1,0],["فدتك نفسي لو أنّهم عقلوا","واستشعروا الحبّ مثلما عذروا",33,"ر",3,0],["فَدَتْكِ نَدامى لنا كالقِسِيّ لا","يَسْتَقيمونَ إلاّ ازْوِرارا",34,"ر",2,0],["فدتكم أناس نازعوكم سيادة ً","فلم أدْرِ ساداتٌ هُمُ أَمْ أسَاوِدُ",35,"د",1,0],["فَدَت رَشَفَاتِ ثَغرِكَ بَعدَ هَدءٍ","عَلَى عِلاَّتِها جُرُعُ المُدَامِ",36,"م",1,0],["فَدَت سائِرُ الأَرواحِ مَلكاً فِداؤُهُ","وَطاعَتُهُ فَرضٌ عَلى الناسِ وَاجِبُ",37,"ب",1,0],["فَدَت سابِقاً شوسُ المُلوكِ فَإِنَّهُ","حَقيقٌ بِأَن يُثنى عَلَيهِ وَأَن يُفدا",38,"د",2,0],["فَدَتكَ مُلوكٌ عَلَت بِالجُدودِ","وَأَعلاكَ مَجدُكَ لَمّا ظَهَر",39,"ر",1,0],["فَدَت أَنفُسُ الأَملاكِ نَفساً شَريفَةً","إِذا اِنفَرَدَت عَنهُم فَسائِرُهُم أَكفا",40,"ف",2,0],["فدتك رجالٌ عن مساعيك قصرت","ويكفيك داء من يباريك جهلهُ",41,"ل",2,0],["فدتكَ ملوك قد أساؤوا بجورهم","إذا برزوا لم يعدموا سوء سمعةِ",42,"ه",1,0],["فدتك ملوك لا يبالون أن يروا","بأعين حب أم بأعين بغضة",43,"ه",1,0],["فدتك ملوك طالب الخير منهم","يحث بهم صخرا ويعصر جلمدا",44,"د",2,0],["فدتك ملوك لا تهش لمدحة","ولا ترتجي يوما لنائبة الدهر",45,"ر",1,0],["فدتْكِ النفسُ يا قَمَري وشَمسي","ويَومي في ودادِكِ مثلُ أمسي",46,"س",2,1],["فَدتكِ نفوسُ العالمينَ مليكةً","وَأسألُ ربّي أَن يُديمَ لك الأمرا",47,"ر",2,0],["فدتك كريماتُ النساءِ وربما","رأينَ قليلاً أنْ يكنَّ فداكِ",48,"ك",1,0],["فدتك النفوس ومن لي بنفس","إذا بخل الناس كانت فداك",49,"ك",1,0],["فَدَتكَ عِمادَ الدينِ نَفسي وَما حَوَت","يَميني وَأَهلي الأَقرَبونَ وَمَعشَري",50,"ر",2,1],["فَدَتْكَ الصَّواهلُ قُبّاً وَجُرْدا","وَشُمُّ الْقَبائِلِ شِيباً وَمُرْدا",51,"د",2,0],["فَدَت ظِباءُ الفَلاةِ نافِرَةً","كلَّ طلاً في القُصورِ مقصورِ",52,"ر",1,0],["فدتكَ أناسٌ أَنتَ أَوَّلُ عزِّها","ودولةُ قومٍ كنت بَدءَ قوامِها",53,"م",3,0],["فَدَتكَ النَفس قَد حسن اِعتِقادي","بِأَنّ برمح قامتك اِعتِقالي",54,"ل",2,0],["فدَتْكَ نُفوسُ الحاسدِينَ من الورَى","وإن هي قَلّتْ أن تكونَ فِداكا",55,"ك",2,0],["فدَتْك رجالٌ أَصبحوا وجسومُهمْ","إذا هيَ قِيستْ للقُلوبِ قُبور",56,"ر",1,0],["فدَتْك نَفْسي يا ضياءَ الهُدى","من ماجدٍ مُسعِدِ أحرار",57,"ر",1,0],["فدَتْكَ نظامَ الحَضرتَيْنِ منَ الوَرى","أكفُّ رجالٍ لا تَريشُ ولا تَبْري",58,"ر",2,0],["فدَتْكَ وجوهٌ من مَوالٍ ومن عِداً","جُموعٌ كخَلْطِ النّاثرِ البِيضَ والصُّفْرا",59,"ر",2,0],["فدتْكَ ملوكُ الأرضِ من طارقِ الرَّدى","وذلك إن قِسْنا أَقَلُّ فِداء",60,"ا",2,0],["فَدتك رِجالٌ تحذر الفقر في النَدى","وَفي البُخلِ فَقرٌ لَيسَ مِنهُ حِذارُها",61,"ر",3,0],["فَدَتْكَ صناديدُ الرِّجال وأرْخصَتْ","نفوساً أهانَتْها المنايا غواليا",62,"ي",2,0],["فَدَتْكَ ملوكٌ لا يُرَجّى نوالها","وما لاحَ منها برق جود لشايم",63,"م",1,0],["فدتك الأَعادي من رفيع محلق","كأَن يبتغي وصلاً من الأَنجم الزّهر",64,"ر",1,0],["فَدَتْه الناسُ من رجلٍ كريمٍ","تنبَّه للجميل وهم رقود",65,"د",1,0],["فدتك الأَعادي من كريمٍ مهذَّبٍ","غزارٍ أياديه وقلّ لك الفدا",66,"د",2,0],["فدتك نفسي من هزبر باسل","وقلَّ من نفسي لعلياك الفدا",67,"ا",1,0],["فدته أناس غدا لؤمهم","لباب المنى والأراجي سدادا",68,"د",2,0],["فدتك من الأسوا نزار ويعرب","كما أوجدوك الفخر يوم نضالا",69,"ل",2,0],["فدتك أبا المعالي كلُّ كفّ","تقصِّر عنك في بسطٍ وقبضِ",70,"ض",1,0],["فدتك ملوكٌ ذكرُ مجدِك بينهم","مثالبُ في أعراضهم وجرائحُ",71,"ح",1,0],["فدَتْني كما شاءتْ وما شئتُ أنّها","فَدَتْنِي ولا كانَ الّذي حُمَّ سابقُهْ",72,"ق",2,0],["فَدَتْكَ نُفُوسٌ قَدْ حَلا بِكَ حَالُهَا","وَأَضْحَى صَحِيحاً فِي هَواكَ اعْتِلالُها",73,"ا",1,1],["فَدَتْكَ حياتي قد تقَدَّمَ قبلنا","إلى مَدْحهِم قومٌ وقالوا فأَفْصَحوا",74,"ح",3,0],["فدتك روحي قم فاغتبقها","عقيقة فوقها فرائد",75,"د",1,0],["فَدَتكَ المُردُ بالجُردِ المذاكِي","إِذا ما الفَيءُ فاءَ فَلِي تَهَيّا",76,"ي",2,0],["فدت نفسي وراحلتي ورحلي","نجادك بله ما تحت النّجاد",77,"د",1,0],["فدتك روحي أنت","من حبيبة للأبد",78,"د",1,0],["فدته الروح مقدام شجاعٌ","من العبسيّ ذاك القرم أشجع",79,"ع",1,0],["فدتهُ الروح مني نعم ليثٌ","له شبلٌ يماثله فلاحا",80,"ح",2,0],["فدته النفس من رؤوف رحيم","كريم النفس مختار امام",81,"م",1,0],["فَدَتها الغَواني إِذ أَتَتنِيَ مَوهِناً","كَشَمسِ الضُحَى تَختَالُ في حُلَّةٍ خَضرا",82,"ر",2,0],["فدتكَ نفسي تثبَّت في مقاطعتي","انَّ التثبتَ منجاةٌ من الخطلِ",83,"ل",1,1],["فَدَتكَ نُفوسٌ مِن تَميمٍ وَعامِرٍ","ومِن مُضَرِ الحَمراءِ عندَ المآزمِ",84,"م",1,0],["فدت نفراً في نُصرة الدين أَرخصوا","كرائمَ يستخزي لعزَّتها الدهر",85,"ر",1,0],["فَدَتكَ يا نفسُ نفسِي ومَن","أُعزى إليهم من كرامِ الأَبِين",86,"ن",1,0],["فدت نفسي ولو ملكت يميني","سواها ما بخلت به يمينا",87,"ن",2,0],["فدَتكَ النَّفسُ يا مَن غابَ عني","فغابَ لبُعدِهِ عقلي وبالي",88,"ل",2,0],["فدت نفسي من أهلي ساكنيها","وقلّت فدية للساكنات",89,"ت",1,0],["فدتك وقلت للفدى كل غانيه","من العين والارام عين رابيه",90,"ي",2,1],["فَدَت نَفسي فَوارِسَ مِن تَميمٍ","غَداةَ الرَوعِ في ضَنِّكِ المَقامِ",91,"م",1,1],["فَدَت نَفسي فَوارِساً اِكتَفوني","عَلى الأَعداءِ في رَهَجِ القِتامِ",91,"م",1,0],["فَدَت رُوحي فَتىً ما ضاقَ ذَرعاً","بِنائِبَةٍ تَنوبُ وَلا ذِراعا",92,"ع",2,0],["فدته الروح من صَلِفٍ لَبيب","عفيف طاهر سَمح أمين",93,"ن",1,0],["فدتك روحي مَن في الحب عذّبتني","هل ذاك حل نعم فيما مضى وبقي",94,"ق",2,0],["فدته الروح من ظبي أنيس","بلفتة جيده صاد البريه",95,"ي",2,0],["فدْتَك أسرابُ غزلان وقد نظرتْ","وراءَ طرفكَ تمشي أسدُ خفَّان",96,"ن",1,0],["فَدَت نَفسٌ جَبينَكَ مِن جَبينٍ","جَرى دَمُهُ عَلى خَدٍّ أَسيلِ",97,"ل",1,0],["فَدَتْ ثَرَاهُ وجوهُ قوم","لم ير فيها الندى مقرّا",98,"ر",2,0],["فدته أنفسنا لو كان يقبلها","منا وكانت على الإبلال قربانا",99,"ن",2,0],["فَدَته المطايا الحافِداتُ وقَطَّعَت","نِعالاً لَهُ دونَ الإِكام جُلو