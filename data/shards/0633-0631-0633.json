{"poems":[[63,"سر سرك الله فيما أنت منتظر","https://www.aldiwan.net/poem51675.html","البسيط"],[48,"يا نفس آه لمتجر متنزر","https://www.aldiwan.net/poem22699.html","الكامل"],[382,"حب الإله وحب العالم اختلفا","https://www.aldiwan.net/poem59329.html","البسيط"],[445,"سر سار صنع الله حيث تسير","https://www.aldiwan.net/poem34815.html","الكامل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[567,"الشمس والبدر في أفق العلى افترقا","https://www.aldiwan.net/poem52817.html","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104543","المديد"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126182","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77856","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77848","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77887","الكامل"],[276,"","https://poetry.dctabudhabi.ae/diwan/poem/80491","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125466","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27235","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130387","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""]],"verses":[["سِرْ سَرَّكَ اللُه فيما أنت مُنتظِرُ","فقَد جَرى بالذي تَهوى لك القدرُ",0,"ر",1,1],["سِرٌّ سَيُعلَنُ وَالحَياةُ مُعارَةٌ","وَلِتُقضِيَنَّ بِها دُيونُ المُعسِرِ",1,"ر",1,0],["سر سيرَ عبدٍ أمينٍ شاخصٍ أبداً","نحو الصليب وكن بالصبر ملتحفا",2,"ف",2,0],["سِرْ سارَ صُنْعُ اللهِ حَيْثُ تسيرُ","قُدُماً وساعَدَ عَزْمَكَ المقدورُ",3,"ر",1,1],["سِرٌّ سَرى لِجَوانِحي فَسَرى بِهَا","وهَوىً هَوَيْتُ لطَوْعِهِ فَهَوى بِي",4,"ب",2,0],["سِرٌّ سَرَى من أبيهِ فيهِ مُندرِجاً","في نفسِهِ كَدَمٍ في جِسمِهِ سارِ",5,"ر",1,0],["سِرُّ سَرِّ الحُبِّ مُشتَهِرُ","فلماذا فيهِ أَستترُ",6,"ر",1,1],["سر سيدي لمقام عز أقدس","فلكم بذلكم الحمى نظراء",7,"ا",2,0],["سر سر سرى بسر سرور","وَبَشير مؤيد بِنَذير",8,"ر",1,1],["سر سرى من أَرسطائيل","المنتهى في العرض وَالطول",9,"ل",1,1],["سر سرى بالسر حين سرى له","فأَطار قَلباً لِلغَرام غَريما",10,"م",2,0],["سر سرى من يوسف بن محمد","لمحمد فهو الجَمال الامجد",11,"د",1,0],["سِرٌّ سَرى في دمائي فانصَرَفت به","عن عالمِ الأرضِ أو عن مطمعِ الجَسَدِ",12,"د",1,0],["سرُّ سرِّ الوجودِ فردٌ بعيدٌ","عن نظيرٍ له بدارِ أمانِ",13,"ن",1,1],["سر سري لم يغب","وتراني أطلب",14,"ب",1,1],["سِرٌّ سَرِيٌ فائقُ الأَسرارِ لم","تُحِطِ الملائكُ آيَ مُعجِزِ ما حَوَى",15,"ا",1,0],["سرسنا سيوفنا في ضرب هام(ن)","عنت واخفاه عن جسمه سرارس",16,"س",1,0]]}