{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85504","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[128,"ما ذم شعرك إلا معشر سمج","https://www.aldiwan.net/poem23757.html","البسيط"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[190,"صرّف زمانك في مهمك","https://www.aldiwan.net/poem43525.html","مجزوء الكامل"],[234,"ما ذم يوم الفراق إلا","https://www.aldiwan.net/poem50910.html","مخلع البسيط"],[567,"ما بال موسى بلا سمع ولا بصر","https://www.aldiwan.net/poem52934.html","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109453","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93666","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103605","البسيط"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67647","الخفيف"],[5205,"سما أكباد ارباب النهى انفطرت","https://www.poetsgate.com/ViewPoem.aspx?id=120993",""],[307,"جاهدتُ دهري للحروف وصولا","https://www.poetsgate.com/ViewPoem.aspx?id=213776",""],[6277,"ما ذم شعرك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64471&r=&rc=34",""]],"verses":[["ما ذم قط حياتَه","في الأَرض من هو ذو يسار",0,"ر",1,1],["مَا ذِمَامِي مَا نجْدَتِي ما وَفَائِي","إِنْ يَكُ النَّوْحَ فَالفِداءُ يسِيرُ",1,"ر",1,0],["ما ذم شعرك إلا معشر سمج","في حلبة الذوق إن أرسلتهم عرجوا",2,"ج",3,1],["ما ذم تصفيق أيديهم لأجلهم","إذ ليس مع كفرهم هذا بمحتسب",3,"ب",1,0],["ما ذم نفسك مثل فع","لك فامتنع من كسب ذمّك",4,"ك",1,0],["ما ذمّ يومَ الفِراقِ إلا","مَن غاب عن موقِفِ الفِراقِ",5,"ق",1,1],["ما ذَمَّ قَطُّ ولا ذُمَّتْ خَلائقُهُ","يوماً فماتَ حميدَ العينِ والأثَرِ",6,"ر",1,0],["ما ذمها في الناس إلا جاهل","لا يظهر الحق له والباطل",7,"ل",1,0],["ما ذمك الناس إِلا بِالسَماح فَقَد","قالوا لِجهلهم في جُوده سرف",8,"ف",1,0],["ما ذمّ شعري وأيم اللَه لي قسم","الا امرؤ ليست الأشعار من طرقه",9,"ق",2,0],["ما ذممتُ المُقامَ في بلدٍ يو","ماً فعاتبته بغير الرحيلِ",10,"ل",1,0],["ماذم تفعل الغزلان ذوسفه","بلاسد في العشق الانفسه شكرت",11,"ت",1,0],["ما ذمّ حرْفي في الخليقةِ كائناً","بل كانَ يرجو في القفارِ ظليلا",12,"ل",2,0],["ما ذمّ شعرك إلاّ معشر سمجوا","في حلبة الذوق إن أرسلتهم عرجوا",13,"ج",3,1]]}