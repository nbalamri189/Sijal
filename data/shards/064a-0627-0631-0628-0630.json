{"poems":[[57,"مرت بنا تشرق الدنيا ببهجتها","https://www.aldiwan.net/poem26419.html","البسيط"],[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[51,"الله أعلى يدا وأكبر","https://www.aldiwan.net/poem62107.html","مجزوء البسيط"],[68,"يا رب ذنبي عظيم","https://www.aldiwan.net/poem38525.html","المجتث"],[82,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[71,"قضت الحبيبة والشبيبة آه وا","https://www.aldiwan.net/poem28495.html","الكامل"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[7,"قالت بنو عامر خالوا بني أسد","https://www.aldiwan.net/poem1972.html","البسيط"],[93,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[473,"يا رب ذات قلائد نازعتها","https://www.aldiwan.net/poem59687.html","المتقارب"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53784","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76166","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200942","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97883","الكامل"],[3325,"","https://poetry.dctabudhabi.ae/diwan/poem/115034","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59450","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35570","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35429","البسيط"],[5442,"يا رب ذا البيت قد وافيت ساحته","https://www.poetsgate.com/ViewPoem.aspx?id=114742",""]],"verses":[["يا رُبَّ ذي حَسَدٍ يا فَوزُ يُظهِرُهُ","لَو كانَ يَعلَمُ حَظّي مِنكِ ما حَسَدا",0,"د",2,0],["يا رُبَّ ذي حسدٍ يودُّ لك الردى","ولأنت واضعُ إصرهِ الموضوع",1,"ع",1,0],["يا رُبَّ ذي أَعظَمٍ رُفاتٍ","كانَ إِذا ما مَشى تَبَخَّر",2,"ر",1,0],["يا رَبِّ ذَنبي عَظيمُ","وَأَنتَ عَنّي حَليمُ",3,"م",1,1],["يا ربَّ ذي مَدٍّ وجزرٍ ماؤهُ","للفلك هُلْكٌ قَطْعُهُ فَتَيَسّرا",4,"ر",2,0],["يا ربُّ ذقْتُ الحادثاتِ فلمْ أجدْ","شيئاً أمرَّ منَ الفراقِ وأصعبا",5,"ب",2,0],["يا رُبَّ ذِي عِلْمٍ رَأى نُصْحِي لَهُ","فأجابَني أتُطِبُّ جالِينُوسا",6,"س",2,0],["يا رُبَّ ذاتِ خَليلٍ قَد فُجِعنَ بِهِ","وَموتَمينَ وَكانوا غَيرَ أَيتامِ",7,"م",1,0],["يا ربذ معركة تراكم نقعها","حتى اختفى في ظلّها الجيشان",8,"ن",1,0],["يا رُبَّ ذاتِ قَلائِدٍ نازَعتُها","راحاً لَها حَبَبٌ كَسَلخِ الأَرقَمِ",9,"م",1,1],["يا رُبَّ ذي افكٍ كثير خدعهْ","مستجهل الحلم خبيث مرتَعهْ",10,"ع",2,1],["يا رُبَّ ذي بُهتان","يعذل في الراح",11,"ح",1,0],["يا ربّ ذنبي عن لقاك يصدّني","فاشمل ذنوبي منك بالغفران",12,"ن",1,1],["يا رب ذكرى للذنوب يذيبني","أسفاً فقد ساء الزمان الغابرُ",13,"ر",1,0],["يا رُبَّ ذي أمل فيه على وَجل","أضحى به آمناً أمسى وقد جُئثا",14,"ث",2,0],["يا رُبَّ ذي ظلُمٍ وَطِئْ","ت وثوْبِ مَظلمةٍ طويَتُ",15,"ت",1,0],["يا ربَّ ذي حَسَدٍ قَد زِدتهُ كَمَدا","إِذ رامَ يَنقُص مِن قَدري فَما نَقَصا",16,"ص",2,1],["يا رُبَّ ذي عِزَّةٍ أَضحى بِعِزَّتِهِ","يُذِلُّني وَأَنا وَاللَهِ في وَهنِ",17,"ن",1,1],["يا رب ذا البيت قد وافيت ساحته","خجلان أحمل بين الناس أوزاري",18,"ي",1,1]]}