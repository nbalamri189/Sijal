{"poems":[[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[30,"ألا حبذا أهل الملا غير أنه","https://www.aldiwan.net/poem29429.html","الطويل"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[43,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[45,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[66,"حبذا بالشعب يومي","https://www.aldiwan.net/poem38810.html","مجزوء الرمل"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[50,"يا رحمة الله حلي في منازلنا","https://www.aldiwan.net/poem63828.html","البسيط"],[50,"لقد زادني ما تعلمين صبابة","https://www.aldiwan.net/poem64860.html","الطويل"],[50,"ألا قل لتلك المالكية أصحبي","https://www.aldiwan.net/poem64863.html","الطويل"],[7,"نأت بسعاد عنك نوى شظون","https://www.aldiwan.net/poem1957.html","الوافر"],[46,"إستنبط العرب لفظا وانبرى نبط","https://www.aldiwan.net/poem22204.html","البسيط"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140930",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[100,"أصيل القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50335",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[134,"سقى الله رهطا هم بالحجون","https://www.aldiwan.net/poem21032.html","المتقارب"],[143,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[160,"وقفت على بيتين من أثقل الشعر","https://www.aldiwan.net/poem59177.html","الطويل"],[160,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[185,"أروض جاءني لك أم كتاب","https://www.aldiwan.net/poem14123.html","الوافر"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[198,"أرض منمنمة وظل سجسج","https://www.aldiwan.net/poem51974.html","الكامل"],[199,"هي الأفلاك لا شم القباب","https://www.aldiwan.net/poem45404.html","الوافر"],[204,"والكأس فيه يديرها","https://www.aldiwan.net/poem53084.html","مجزوء الكامل"],[206,"يا أحباباً نأوا عني فسال","https://www.aldiwan.net/poem923.html",""],[222,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[259,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[270,"حذار فأحداق الملاح حبوب","https://www.aldiwan.net/poem35457.html","الطويل"],[282,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[304,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[309,"ولم يطلب علو القدر فيها","https://www.aldiwan.net/poem50278.html","الوافر"],[337,"أعائش ما لأهلك لا أراهم","https://www.aldiwan.net/poem45426.html","الوافر"],[371,"جاءنا منك تحفة نحن منها","https://www.aldiwan.net/poem56954.html","الطويل"],[371,"بعين الله هجرك لا بعيني","https://www.aldiwan.net/poem57100.html","الوافر"],[371,"أنا أعرف فيمن","https://www.aldiwan.net/poem57424.html","البسيط"],[403,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[403,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[409,"أتهم فيكم لائمي وأنجدا","https://www.aldiwan.net/poem32486.html","الرجز"],[416,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[416,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[416,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[432,"نسخ الجد مقال اللعب","https://www.aldiwan.net/poem12556.html","الرمل"],[439,"أياديك ردت يدي في يديكا","https://www.aldiwan.net/poem34780.html","المتقارب"],[441,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[461,"يرى المخلصون الغر أن فناءهم","https://www.aldiwan.net/poem16352.html","الطويل"],[490,"كقُنفُذ القن لا تخفى مدارجُهُ","https://www.aldiwan.net/poem669.html",""],[529,"كقطيفة خضراء قد نثرت بها","https://www.aldiwan.net/poem37380.html","الكامل"],[538,"مفضل مستعجل","https://www.aldiwan.net/poem47928.html","عموديه"],[558,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[562,"أوصى بها من بني العبسي منتقل","https://www.aldiwan.net/poem52516.html","البسيط"]],"verses":[["كَقَومِكِ لا يُعيدُ الدَهرُ قَوماً","وَمِثلِ أَبيكِ لا تَلِدُ اللَيالي",0,"ل",2,0],["كَقَولٍ مَضى مِنهُ وَلكِن لَرَدَّهُ","إِلى غَيرِ مَيٍّ أَو لأَصبَحَ سالِيا",1,"ي",2,0],["كقدر لا يزال يسي","ل من أثقابها المرق",2,"ق",1,0],["كَقَشرِكَ الحِبرَ عَنِ المَهارِقِ","أَرودُهُ مِنهُ بِكَلشَوذانِقِ",3,"ق",1,0],["كَقَصرِ حُمَيدٍ بَعدَما غاضَ حُسنُهُ","وَأَقوَت نَواحيهِ وَأَجدَبَ رائِدُه",4,"د",2,0],["كَقُدودٍ وَخُدودٍ","وَعُيونٍ وَثُغورٍ",5,"ر",1,0],["كَقُطبِ الرَحى وافَقَت أُختَها","دَعونا بِها وَغَلَبنا بِها",6,"ب",3,0],["كقَناة الخَطِّ إنْ زَعْزَعْتَهَا","لم تَزِدْ غيرَ اعتِدالٍ واطِّراد",7,"د",1,0],["كَقَولِ كِسرى فيما تَمَثَّلَهُ","مِن فُرَصِ اللِصِّ ضَجَّةُ السوقِ",8,"ق",1,0],["كَقائِلٍ إِذ لَحى في الخَمرِ عاذِلُهُ","لَأَشرَبَنَّ وَلَو كَأساً بِدينارِ",9,"ر",1,0],["كَقارورَةِ العَطّارِ أَو زادَ نَعتُها","تَلينُ إِذا عاتَبتُها وَتَطيبُ",10,"ب",1,0],["كَقائِلَةٍ إِنَّ الحِمارَ فَنَحِّهِ","عَنِ القَتِّ أَهلُ السِمسِمِ المُتَهَذِّبِ",11,"ب",1,0],["كَقَوسِ الماسِخيِّ أَرَنَّ فيها","مِنَ الشَرعيِّ مَربوعٌ مَتينُ",12,"ن",1,0],["كَقينَةِ الكَأسِ إِذ باتَت مُطَرِّبَةً","بَينَ الشُروبِ وَلَيسَت ذاتَ إِطرابِ",13,"ب",1,0],["كَقَنطَرَةِ الروميِّ أَقسَمَ رَبُّها","لَتُكتَنَفَن حَتّى تُشادَ بِقَرمَدِ",14,"د",1,0],["كقشرك الحبر من المهارق","أروده منه بكالسوذانق",15,"ق",1,0],["كَقَلِيبٍ دَلْوُها مُتْرَعَةٌ","أَشْرَقَتْ بالماءِ عَقْدَ الكَرَبِ",16,"ب",1,0],["كقيثار هاو ، دؤوب ، يلحّ","على وتر ، ويدمّي وتر",17,"ر",1,0],["كقنطرة الرومي أقسم ربها","لتكتنفن حتى تشاد بقرقد",18,"د",1,0],["كقنطرة الرُّوميِّ أقسمَ ربها","لتكفننْ حتى تُشادَ بقرمد",19,"د",1,0],["كَقَصيرٍ إِذ لَم يَجِد غَيرَ أَن جَد","دَعَ أَشرافَهُ لِمَكرٍ قَصيرُ",20,"ر",1,0],["كَقَاذف يَوْماً بأَجْرَامِهِ","في هوة ٍ ليسَ لها منْ طريقْ",21,"ق",1,0],["كَقَولِ قُصَيٍّ أَلا أَقصِروا","وَلا تَركَبوا ما بِهِ المَأثَمُ",22,"م",1,0],["كَقائِلٍ بِلِسانٍ لَم يَحُطهُ فَمٌ","وَصائِلٍ بِذِراعٍ زايَلَت عَضُدا",23,"د",2,0],["كقولكم موسى عجول ووصفكم","لفرعون بالرأى المرجح والحجر",24,"ر",1,0],["كقوله فيه في إنشاد ضائعة","لا ردها الله قول المنكر الحرب",25,"ب",1,0],["كقولِ أخيِ مُمارسةٍ وفَهْمٍ","يروقك في مقالته الصواب",26,"ب",1,0],["كَقطرةِ بحرٍ من بحارِ اِقتدارهِ","إِلى الناسِ أَجراها فَكانوا لها مجرى",27,"ر",2,0],["كقطائعِ البُستانِ أينعَ زهرُها","أو كالعذارى البيضِ إذ تتبرَّج",28,"ج",1,0],["كقطعةِ سكرٍ في كأسِ بنٍ","تذوبُ ليغتدي حلوَ الشرابِ",29,"ب",1,0],["كقدود غلمانٍ رشا","قٍ فوقها غُرَرُ الجواري",30,"ر",2,0],["كقفار الأرض تحيا إن أتى","مزن غيم نحوها يوماً فسال",31,"ل",1,0],["كقاتل العدا وأولغ القنا","وجرد السيوف واجتنا المنا",32,"ن",2,0],["كقاب قوسين تدلّى ودنا","من المنى بقوله إنّي أنا",33,"ن",2,0],["كقشرٍ من الرمّانِ أصبَحَ يابساً","وحبُّكِ مثلُ الحَبّ فيهِ رطيب",34,"ب",1,0],["كَقَوسِ الأَشرَفِ المَلِكِ المُرَجّى","يَطيرُ إِلى العِدا مِنهُ الحِمامُ",35,"م",1,0],["كقضيب البان في كثب","ينثني في الحلى والحلل",36,"ل",1,0],["كَقَصرٍ قَد تَهَدَّمَ حافَتاهُ","إِذا صارَ البِناءُ إِلى الفَراغِ",37,"غ",1,0],["كَقُضبِ النَبعِ مِن نُحُصٍ أَوابٍ","صَوَت مِنهُنَّ أَقراطُ الضُروعِ",38,"ع",1,0],["كقُموعٍ على أنامِل خَودٍ","لُحنَ من كُمِّ لاذةٍ خَضراءِ",39,"ا",2,0],["كقُضبانِ اللُّجَينِ مُعلَّقاتٌ","وبِئسَ الحَليُ قُضبانُ اللُّجَينِ",40,"ن",1,0],["كقاضٍ فضلُه أن","نَ قَراه أبداً يَقري",41,"ي",1,0],["كقصد الرسول في أمم تقضَّتْ","وحسبي أحمد مسك الختام",42,"م",1,0],["كقوم عُرَاةٍ في ذرى مصر ما علا","على عورة منهم هناك ثياب",43,"ب",1,0],["كَقانِصٍ فاتَ القنيصُ يَده","أو واجدٍ أضَلّ ما قَد وَجَدَا",44,"د",2,0],["كقضيب البان أنَّى ينثني","ذو قوام يشبه الرّمح المقوَّم",45,"م",1,0],["كقطرِ المزن يسجم من نمير","وروض المزن يبسم عن ورود",46,"د",1,0],["كقلائد العقيان فيه محاسن","جيد الزمان بعقدها يتقلد",47,"د",1,0],["كقضيب الملك إلا أنها","قلّدوها بعُقود الشُهُب",48,"ب",1,0],["كقَوْدِكَ للحربِ خَيْلاً تَهُزُّ","عَوَاليَها من كِلا جانِبَيْكا",49,"ك",2,0],["كقاب قوسين ذاك اليوم كان له","أدنى وكان له مما أخاف وقا",50,"ق",2,0],["كقول عليٍّ مُعْلناً قبل موتِهِ","لقد فُزْتُ والبيتِ العتيقِ المُحرَّم",51,"م",1,0],["كَقُنفُذِ القِنِّ لا تَخفى مَدارِجُهُ","خَبٌّ إِذا نامَ عِندَ الناسِ لَم يَنَمِ",52,"م",1,1],["كَقَطيفَةٍ خَضْراءَ قَدْ نُثِرَتْ بِها","حَبُّ الْزُّمُرُّدِ ناظِرٌ في ناظِرِ",53,"ر",1,1],["كقِربَةٍ مَنفوخَةٍ","تُداسُ بِالأُقدَامِ",54,"م",1,0],["كقاض بقصد قد قضى بجناية","عليك ولا يرضى بتلك الجناية",55,"ه",1,0],["كقُبَّةِ العهدِ ذاتِ القُدسِ قد رُفعتْ","نحوَ الأعالي على أعضادِ أملاكِ",56,"ك",1,0]]}