etsgate.com/ViewPoem.aspx?id=176417",""],[5491,"أنت علمتني بألا أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=215041",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5561,"قارورة عطر","https://www.poetsgate.com/ViewPoem.aspx?id=192898",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[5818,"أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=193071",""],[5952,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=202282",""],[5956,"هواء وغذاء","https://www.poetsgate.com/ViewPoem.aspx?id=184255",""],[6093,"كالحق ينزل في ضيافة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=205866",""],[6102,"لَو بِيَدي ..","https://www.poetsgate.com/ViewPoem.aspx?id=184868",""],[6262,"اللغةُ لم تكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80118&r=&rc=16",""],[5555,"راقصة الجاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87419&r=&rc=14",""],[6288,"فضاء وانطلاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78108&r=&rc=32",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""],[4222,"لائم للمحب غير ملائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52884&r=&rc=176",""]],"verses":[["كَقَومِكِ لا يُعيدُ الدَهرُ قَوماً","وَمِثلِ أَبيكِ لا تَلِدُ اللَيالي",0,"ل",2,0],["كَقَولٍ مَضى مِنهُ وَلكِن لَرَدَّهُ","إِلى غَيرِ مَيٍّ أَو لأَصبَحَ سالِيا",1,"ي",2,0],["كقدر لا يزال يسي","ل من أثقابها المرق",2,"ق",1,0],["كَقَشرِكَ الحِبرَ عَنِ المَهارِقِ","أَرودُهُ مِنهُ بِكَلشَوذانِقِ",3,"ق",1,0],["كَقَصرِ حُمَيدٍ بَعدَما غاضَ حُسنُهُ","وَأَقوَت نَواحيهِ وَأَجدَبَ رائِدُه",4,"د",2,0],["كَقُدودٍ وَخُدودٍ","وَعُيونٍ وَثُغورٍ",5,"ر",1,0],["كَقاذِفَ يَوماً بِأَجرامِهِ","في هُوَّةٍ لَيسَ لَها مِن طَريق",6,"ق",1,0],["كَقُطبِ الرَحى وافَقَت أُختَها","دَعونا بِها وَغَلَبنا بِها",7,"ب",3,0],["كقَناة الخَطِّ إنْ زَعْزَعْتَهَا","لم تَزِدْ غيرَ اعتِدالٍ واطِّراد",8,"د",1,0],["كَقَولِ كِسرى فيما تَمَثَّلَهُ","مِن فُرَصِ اللِصِّ ضَجَّةُ السوقِ",9,"ق",1,0],["كَقائِلٍ إِذ لَحى في الخَمرِ عاذِلُهُ","لَأَشرَبَنَّ وَلَو كَأساً بِدينارِ",10,"ر",1,0],["كَقارورَةِ العَطّارِ أَو زادَ نَعتُها","تَلينُ إِذا عاتَبتُها وَتَطيبُ",11,"ب",1,0],["كَقائِلَةٍ إِنَّ الحِمارَ فَنَحِّهِ","عَنِ القَتِّ أَهلُ السِمسِمِ المُتَهَذِّبِ",12,"ب",1,0],["كَقَوسِ الماسِخيِّ أَرَنَّ فيها","مِنَ الشَرعيِّ مَربوعٌ مَتينُ",13,"ن",1,0],["كَقينَةِ الكَأسِ إِذ باتَت مُطَرِّبَةً","بَينَ الشُروبِ وَلَيسَت ذاتَ إِطرابِ",14,"ب",1,0],["كَقَنطَرَةِ الروميِّ أَقسَمَ رَبُّها","لَتُكتَنَفَن حَتّى تُشادَ بِقَرمَدِ",15,"د",1,0],["كقشرك الحبر من المهارق","أروده منه بكالسوذانق",16,"ق",1,0],["كَقَلِيبٍ دَلْوُها مُتْرَعَةٌ","أَشْرَقَتْ بالماءِ عَقْدَ الكَرَبِ",17,"ب",1,0],["كقيثار هاو ، دؤوب ، يلحّ","على وتر ، ويدمّي وتر",18,"ر",1,0],["كقنطرة الرومي أقسم ربها","لتكتنفن حتى تشاد بقرقد",19,"د",1,0],["كقنطرة الرُّوميِّ أقسمَ ربها","لتكفننْ حتى تُشادَ بقرمد",20,"د",1,0],["كَقَصيرٍ إِذ لَم يَجِد غَيرَ أَن جَد","دَعَ أَشرافَهُ لِمَكرٍ قَصيرُ",21,"ر",1,0],["كَقَولِ قُصَيٍّ أَلا أَقصِروا","وَلا تَركَبوا ما بِهِ المَأثَمُ",22,"م",1,0],["كَقائِلٍ بِلِسانٍ لَم يَحُطهُ فَمٌ","وَصائِلٍ بِذِراعٍ زايَلَت عَضُدا",23,"د",2,0],["كقولكم موسى عجول ووصفكم","لفرعون بالرأى المرجح والحجر",24,"ر",1,0],["كقوله فيه في إنشاد ضائعة","لا ردها الله قول المنكر الحرب",25,"ب",1,0],["كقولِ أخيِ مُمارسةٍ وفَهْمٍ","يروقك في مقالته الصواب",26,"ب",1,0],["كَقطرةِ بحرٍ من بحارِ اِقتدارهِ","إِلى الناسِ أَجراها فَكانوا لها مجرى",27,"ر",2,0],["كقطائعِ البُستانِ أينعَ زهرُها","أو كالعذارى البيضِ إذ تتبرَّج",28,"ج",1,0],["كقطعةِ سكرٍ في كأسِ بنٍ","تذوبُ ليغتدي حلوَ الشرابِ",29,"ب",1,0],["كقدود غلمانٍ رشا","قٍ فوقها غُرَرُ الجواري",30,"ر",2,0],["كقفار الأرض تحيا إن أتى","مزن غيم نحوها يوماً فسال",31,"ل",1,0],["كقاتل العدا وأولغ القنا","وجرد السيوف واجتنا المنا",32,"ن",2,0],["كقاب قوسين تدلّى ودنا","من المنى بقوله إنّي أنا",33,"ن",2,0],["كقشرٍ من الرمّانِ أصبَحَ يابساً","وحبُّكِ مثلُ الحَبّ فيهِ رطيب",34,"ب",1,0],["كَقَوسِ الأَشرَفِ المَلِكِ المُرَجّى","يَطيرُ إِلى العِدا مِنهُ الحِمامُ",35,"م",1,0],["كقضيب البان في كثب","ينثني في الحلى والحلل",36,"ل",1,0],["كَقَصرٍ قَد تَهَدَّمَ حافَتاهُ","إِذا صارَ البِناءُ إِلى الفَراغِ",37,"غ",1,0],["كَقُضبِ النَبعِ مِن نُحُصٍ أَوابٍ","صَوَت مِنهُنَّ أَقراطُ الضُروعِ",38,"ع",1,0],["كقُموعٍ على أنامِل خَودٍ","لُحنَ من كُمِّ لاذةٍ خَضراءِ",39,"ا",2,0],["كقُضبانِ اللُّجَينِ مُعلَّقاتٌ","وبِئسَ الحَليُ قُضبانُ اللُّجَينِ",40,"ن",1,0],["كقاضٍ فضلُه أن","نَ قَراه أبداً يَقري",41,"ر",2,0],["كقصد الرسول في أمم تقضَّتْ","وحسبي أحمد مسك الختام",42,"م",1,0],["كقوم عُرَاةٍ في ذرى مصر ما علا","على عورة منهم هناك ثياب",43,"ب",1,0],["كَقانِصٍ فاتَ القنيصُ يَده","أو واجدٍ أضَلّ ما قَد وَجَدَا",44,"د",2,0],["كقضيب البان أنَّى ينثني","ذو قوام يشبه الرّمح المقوَّم",45,"م",1,0],["كقطرِ المزن يسجم من نمير","وروض المزن يبسم عن ورود",46,"د",1,0],["كقلائد العقيان فيه محاسن","جيد الزمان بعقدها يتقلد",47,"د",1,0],["كقضيب الملك إلا أنها","قلّدوها بعُقود الشُهُب",48,"ب",1,0],["كقَوْدِكَ للحربِ خَيْلاً تَهُزُّ","عَوَاليَها من كِلا جانِبَيْكا",49,"ك",2,0],["كقاب قوسين ذاك اليوم كان له","أدنى وكان له مما أخاف وقا",50,"ق",2,0],["كقول عليٍّ مُعْلناً قبل موتِهِ","لقد فُزْتُ والبيتِ العتيقِ المُحرَّم",51,"م",1,0],["كَقُنفُذِ القِنِّ لا تَخفى مَدارِجُهُ","خَبٌّ إِذا نامَ عِندَ الناسِ لَم يَنَمِ",52,"م",1,1],["كَقَطيفَةٍ خَضْراءَ قَدْ نُثِرَتْ بِها","حَبُّ الْزُّمُرُّدِ ناظِرٌ في ناظِرِ",53,"ر",1,1],["كقِربَةٍ مَنفوخَةٍ","تُداسُ بِالأُقدَامِ",54,"م",1,0],["كقاض بقصد قد قضى بجناية","عليك ولا يرضى بتلك الجناية",55,"ه",1,0],["كقُبَّةِ العهدِ ذاتِ القُدسِ قد رُفعتْ","نحوَ الأعالي على أعضادِ أملاكِ",56,"ك",1,0],["كقلائد العقيان يصلح سفره","لطلى غواني المجد أن تتقلدا",57,"د",2,0],["كقينةِ مجلسِ حَسناءَ تعلو","على القيناتِ في حُسن الجلوس",58,"س",1,0],["كَقُرصٍ مِنَ البلّورِ قَد جاءَ خاطِف","لِيَخطِفَه فَزعانَ فَاختَطَف النّصفا",59,"ف",2,0],["كَقبّةِ الفلكِ العالي بِها اِرتَفَعَت","بُروجُ جاهٍ لَها العَلياءُ تَكتَنِفُ",60,"ف",1,0],["كقَضيبِ البان وفي الأجفا","ن من الغِزلانِ له مثَلُ",61,"ل",1,0],["كَقَولِ المَرءِ عَمرٍو في القَوافي","لِقَيسٍ حينَ خالَفَ كُلَّ عَدلِ",62,"ل",1,0],["كقارورة العطار في مستقرِّها","بقيةُ أَحوى خَنَّقَ المِلءَ ناصَف",63,"ف",1,0],["كقوسٍ من الشريانِ ليس يعجزها","فطورٌ ولا بالطائفين وصُومُ",64,"م",1,0],["كَقَفَل الرُومِيِّ لا بَل أَغْلَقا","تَحْمِيه أَطْرافُ الشَبَا أَنْ يَقْلِقا",65,"ق",2,0],["كقوله وقد أتى موزونا","هل يستوي الذين يعلمونا",66,"ن",2,0],["كقُنْفُذِ الرَّمْلِ لاَ تَخْفَى مَدَارِجُهُ","خَبٌّ إذَا نَامَ لَيْلُ النَّاسِ لَمْ يَنَمِ",67,"م",1,1],["كقلبِ الذي يَهوى يُعذبُ دائماً","ولم يجنِ ذنباً إنما الذنبُ للبَصَر",68,"ر",1,0],["كقِصَّة البَعير وَالجمال","وَالشَّيء قَد يعرف بِالمثال",69,"ل",1,1],["كَقصة القادر وَالخَباز","وَالكَيد داء ما له مُؤاز",70,"ز",1,0],["كقولهم أياك والإحسانا","إليه أو أمّك يا إنسانا",71,"ن",2,0],["كقولهم هند لنا لم تكرم","وأنت يا زيد لها لم تكرم",72,"م",1,0],["كقلائد هدى جد بها","طلب وتجاذبها طرب",73,"ب",1,0],["كقائم في نائم","سَنا تجلى في سَنا",74,"ا",1,0],["كقضيب آس أو كنرجسة","زهراء بين رياضها الخضر",75,"ر",1,0],["كقناة تأودت","أو شهابٍ قد اندفع",76,"ع",1,0],["كقولك جهُ الأمرِ للأمرِ نفسهِ","وما وجههُ وجهاً يحد كما زعم",77,"م",1,0],["كقولِكَ قامَت بالقنابِلِ والقنا","على ساقِها الهيجاءُ نيرانُها حدَم",77,"م",1,0],["كقولهم الدنيا استوت لأميرها","فأضحى قد استولى على الحلِّ والحرم",77,"م",1,0],["كقولكَ كان الناسُ ناساً وربما","أحالوا فقالوا إن في قولهم نعم",77,"م",1,0],["كَقَهوَةٍ صُفِّقَت في الكَأسِ فَاكتَسَبَت","بِالمَزجِ لُوِّنَ لَونَ الراحِ وَالحَبَبِ",78,"ب",1,0],["كقاب قوسين وأدنى قد دنا","وأين مع كيف اتركَن تأمَن من الخطر",79,"ر",1,0],["كقارىءٍ يَقْرَأُ للأَصْحَابِ","أَبْدَعَ في الإظهار والإقلابِ",80,"ب",1,0],["كقوله ما رمى من قد رمى ومضى","في أفقه طالعا لقطاً وما غربا",81,"ب",2,0],["كقصرك الوصف على الموصوف","وعكسه من نوعه المعروف",82,"ف",1,0],["كقابلة حل لها نظر إلى","مكان ولادات النسا في التولد",83,"د",1,0],["كقدي جربان وريشة إذ","حشر القضيض عليك والقض",84,"ض",1,0],["كَقَدحِ النَبعِ أَوَّلُها","وَسَلكِ النَظمِ آخِرُها",85,"ر",3,0],["كقلوب أعداء الخديو بنارها","وقلوب أهل وداده بضيائها",86,"ه",2,0],["كقاتل الصيد وهو في حرم الله","يجازي الحمار بالبدنه",87,"ن",2,0],["كَقيلِنا لِلمُقَدَّمينَ قِفوا","عَن شَأوِكُم وَالحِرابُ تَختَلِفُ",88,"ف",1,0],["كَقولهم يتعبُ هنداً رِدفُها","كَمثل ما يريح دَعداً عِطفُهما",89,"م",2,0],["كَقارئٍ إِن تَأتِهِ وِقفَةٌ","مدَّ بِها الصَّوت وَجَلاها",90,"ا",3,0],["كَقُبّةٍ بُنيتْ عمداً على عَمَد","وَقُيِّرَت ظاهراً بالزّفتِ والقارِ",91,"ر",1,0],["كقطرة البحر وهي ملح","تحلو متى صبها الغمام",92,"م",1,0],["كقوس قده وعصاه سهم","يسدده لدهر قد دهاه",93,"ا",2,0],["كقرع ديريّ بنا قوسٍ على شرفٍ","مسبح في ظلامَ الليل دعّاء",94,"ا",2,0],["كَقُبّعَةِ الحُوذِيِّ فِي رَأْسِ نَاسِكٍ","يَجُرُّ سَرَادِيبَ الْوُجُودِ وَيَسْحَبُ",95,"ب",1,1],["كقادني في أسره كمن غلب","وحذفهم لوجه تشبيه غلب",96,"ب",1,0],["كقضيب بدا بروضة أنس","ساجعاً طيرُهُ بأعلى الجبال",97,"ل",1,0],["كقِران بدرِ التِّمِّ تي","مور المَليك إذ ابْتَنى",98,"ن",2,0],["كقومٍ مددتَ لهم في المُنى","مطامعَ كانتْ عليهم دَمارا",99,"ر",2,0],["كقضيب البان والأسل","عن سواها قط لم أسل",100,"ل",1,0],["كقول أهل النار","وعصبة الكفار",101,"ر",1,0],["كقوم عراةً في ذرى مصر ما على","على عورة منهم هناك ثياب",102,"ب",1,0],["كقضب الزّبَرْجَدِ قد عَطِّفَتْ","صوالجُ تحت كُرَاتِ الذهب",103,"ب",1,0],["كقلادة العقيان في عنق","يزدان منها الليت والنحر",104,"ر",1,0],["كقاب قوسين أو أدنى له انكشفت","حجب الغيوب وبالتعظيم حياه",105,"ا",2,0],["كقدسهم ربي وإكمال قدسهم","بإرثهم ذي طاب والأم والقدس",106,"س",1,0],["كقيم الكيكون ميتيس نهض وصا","ح يا هكطور أخطأت الغرب",107,"ب",1,0],["كقلبٍ بيننا في غل","لة الأضغان متقد",108,"د",1,0],["كَقَرِينِ هِيرا إِن أَقامَ مُهَيِئاً","بَرداً وَسَيلاً في البِلادِ عرَمرَما",109,"ا",1,0],["كَقَولِهِ كَمَا تَرَونَ القَمَرَا","وَقَبلَ هَذَا سَتَرَونَ الخَبَرَا",110,"ر",2,0],["كقرطين حلي عاطل المجد فيهما","فزينا بدري النظام وزانا",111,"ن",2,0],["كقدودٍ تعلَّقتْها قلوبٌ","ذاتُ شجوٍ غصونُها والحمائمْ",112,"م",1,0],["كَقُبلة سَكرى سَماوية","تَهبط في وَجنة نَشوان",113,"ن",1,0],["كقابي القوس قطرا","دنياي ضيقا وقصرا",114,"ر",2,1],["كقصيد ٍ أتى بنكهة حب ٍّ","كهدايا الأحباب والخلّان ِ",115,"ن",1,0],["كقائلةٍ لبنتِ الجار فُحْشًا","وتزني في الصَّباح وفي الغساقِ",116,"ق",1,0],["\"كقرص\" حوى الأحلام لما قر