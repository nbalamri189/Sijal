{"poems":[[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[30,"ألا حبذا أهل الملا غير أنه","https://www.aldiwan.net/poem29429.html","الطويل"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[43,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[45,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[66,"حبذا بالشعب يومي","https://www.aldiwan.net/poem38810.html","مجزوء الرمل"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[50,"يا رحمة الله حلي في منازلنا","https://www.aldiwan.net/poem63828.html","البسيط"],[50,"لقد زادني ما تعلمين صبابة","https://www.aldiwan.net/poem64860.html","الطويل"],[50,"ألا قل لتلك المالكية أصحبي","https://www.aldiwan.net/poem64863.html","الطويل"],[7,"نأت بسعاد عنك نوى شظون","https://www.aldiwan.net/poem1957.html","الوافر"],[46,"إستنبط العرب لفظا وانبرى نبط","https://www.aldiwan.net/poem22204.html","البسيط"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140930",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["كَقَومِكِ لا يُعيدُ الدَهرُ قَوماً","وَمِثلِ أَبيكِ لا تَلِدُ اللَيالي",0,"ل",2,0],["كَقَولٍ مَضى مِنهُ وَلكِن لَرَدَّهُ","إِلى غَيرِ مَيٍّ أَو لأَصبَحَ سالِيا",1,"ي",2,0],["كقدر لا يزال يسي","ل من أثقابها المرق",2,"ق",1,0],["كَقَشرِكَ الحِبرَ عَنِ المَهارِقِ","أَرودُهُ مِنهُ بِكَلشَوذانِقِ",3,"ق",1,0],["كَقَصرِ حُمَيدٍ بَعدَما غاضَ حُسنُهُ","وَأَقوَت نَواحيهِ وَأَجدَبَ رائِدُه",4,"د",2,0],["كَقُدودٍ وَخُدودٍ","وَعُيونٍ وَثُغورٍ",5,"ر",1,0],["كَقُطبِ الرَحى وافَقَت أُختَها","دَعونا بِها وَغَلَبنا بِها",6,"ب",3,0],["كقَناة الخَطِّ إنْ زَعْزَعْتَهَا","لم تَزِدْ غيرَ اعتِدالٍ واطِّراد",7,"د",1,0],["كَقَولِ كِسرى فيما تَمَثَّلَهُ","مِن فُرَصِ اللِصِّ ضَجَّةُ السوقِ",8,"ق",1,0],["كَقائِلٍ إِذ لَحى في الخَمرِ عاذِلُهُ","لَأَشرَبَنَّ وَلَو كَأساً بِدينارِ",9,"ر",1,0],["كَقارورَةِ العَطّارِ أَو زادَ نَعتُها","تَلينُ إِذا عاتَبتُها وَتَطيبُ",10,"ب",1,0],["كَقائِلَةٍ إِنَّ الحِمارَ فَنَحِّهِ","عَنِ القَتِّ أَهلُ السِمسِمِ المُتَهَذِّبِ",11,"ب",1,0],["كَقَوسِ الماسِخيِّ أَرَنَّ فيها","مِنَ الشَرعيِّ مَربوعٌ مَتينُ",12,"ن",1,0],["كَقينَةِ الكَأسِ إِذ باتَت مُطَرِّبَةً","بَينَ الشُروبِ وَلَيسَت ذاتَ إِطرابِ",13,"ب",1,0],["كَقَنطَرَةِ الروميِّ أَقسَمَ رَبُّها","لَتُكتَنَفَن حَتّى تُشادَ بِقَرمَدِ",14,"د",1,0],["كقشرك الحبر من المهارق","أروده منه بكالسوذانق",15,"ق",1,0],["كَقَلِيبٍ دَلْوُها مُتْرَعَةٌ","أَشْرَقَتْ بالماءِ عَقْدَ الكَرَبِ",16,"ب",1,0],["كقنطرة الرومي أقسم ربها","لتكتنفن حتى تشاد بقرقد",17,"د",1,0],["كقنطرة الرُّوميِّ أقسمَ ربها","لتكفننْ حتى تُشادَ بقرمد",18,"د",1,0],["كَقَصيرٍ إِذ لَم يَجِد غَيرَ أَن جَد","دَعَ أَشرافَهُ لِمَكرٍ قَصيرُ",19,"ر",1,0],["كَقَاذف يَوْماً بأَجْرَامِهِ","في هوة ٍ ليسَ لها منْ طريقْ",20,"ق",1,0]]}