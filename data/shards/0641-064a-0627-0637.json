{"poems":[[63,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[35,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[88,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[70,"لك الله من وال ولي مقرب","https://www.aldiwan.net/poem43025.html","الطويل"],[85,"فيا طير يهنيك طيب الكرى","https://www.aldiwan.net/poem7759.html","المتقارب"],[44,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[69,"فراقك للأجساد مفن ومتلف","https://www.aldiwan.net/poem28462.html","الطويل"],[31,"يقول خليلي إذ أجازت حمولها","https://www.aldiwan.net/poem42550.html","الطويل"],[50,"خليلي ما بال الدجى لا تزحزح","https://www.aldiwan.net/poem63979.html","الطويل"],[46,"وجوهكم كلف وأفواهكم عدى","https://www.aldiwan.net/poem23008.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9959","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[129,"أرى الدنيا وزخرفها غرورا","https://www.aldiwan.net/poem50617.html","الطويل"],[144,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[161,"رمتني فلا شلت يداها بأسهم","https://www.aldiwan.net/poem58914.html","الطويل"],[182,"خليلى ليس الشوق أن تشحط النوى","https://www.aldiwan.net/poem58832.html","الطويل"],[186,"على الجانب الإسكندري سلام","https://www.aldiwan.net/poem14658.html","الطويل"],[207,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[211,"تعلمت الألحان من نوحي الورقا","https://www.aldiwan.net/poem13299.html","الطويل"],[223,"دعاك الهوى فاجب من دعاك","https://www.aldiwan.net/poem55466.html","المتقارب"],[232,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[257,"أيا من وجهه كالشمس توفي","https://www.aldiwan.net/poem48427.html","الوافر"],[262,"أشاقك من هذا الرديني قده","https://www.aldiwan.net/poem38143.html","الطويل"],[272,"رفاقي الظاعنين متى الورود","https://www.aldiwan.net/poem52071.html","الوافر"],[272,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[306,"سلام إذا ما افتر أنشقكم عطرا","https://www.aldiwan.net/poem56542.html","الطويل"],[306,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[350,"شربت من الحميا ما سقتني","https://www.aldiwan.net/poem15973.html","الوافر"],[354,"أما والهوى لولا الألى نزلوا السفحا","https://www.aldiwan.net/poem40542.html","الطويل"],[367,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[378,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[378,"أحن إلى الوادي المقدس رغبة","https://www.aldiwan.net/poem66892.html","الطويل"],[403,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[407,"همو علموا عيني سؤال المعالم","https://www.aldiwan.net/poem50112.html","الطويل"],[417,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[417,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[442,"أخي ولدي ما بال قلبك لاه","https://www.aldiwan.net/poem14433.html","الطويل"],[442,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[465,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[465,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[516,"أما وخدود ألفن الصدودا","https://www.aldiwan.net/poem12070.html","المتقارب"],[530,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[564,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[576,"حذار سيوف الهند من أعين الترك","https://www.aldiwan.net/poem2903.html","الطويل"],[576,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"]],"verses":[["فيا طِيبَها والشَّرْبُ صاحٍ ومُنْتَشٍ","تَخِفُّ بها أيْدٍ وتَثْقُلُ أجْفانُ",0,"ن",1,0],["فَيا طالَما مازَحتُ فيها عُبَيلَةً","وَمازَحَني فيها الغَزالُ المُغَنَّجُ",1,"ج",1,0],["فَيا طولَ ما شَوقي إِذا حالَ دُونَها","بُصاقٌ وَمَن أَعلامِ صِندِدَ مَنكِبُ",2,"ب",1,0],["فيا طلقةً ريع العراق بصوتها","فبانت به الآفاق عابسةً دكنا",3,"ن",2,0],["فيا طرسيَ ألثم ثراه المري","ع ألفاً ويا مدحةُ عانق",4,"ق",1,0],["فَيا طالِباً لِلجودِ مِن غَيرِ جَلدَكٍ","نَصَحتُكَ لا تَتعَب وَلا تَتَطَلَّبِ",5,"ب",1,0],["فيا طير يهنيك طيب الكرى","وطول العناق وفرط النعيم",6,"م",1,1],["فَيا طيبَ مَجناها وَيا بَردَ وَقعِها","عَلى الكَبِدِ الحَرّى وَزادَ عَلى البَردِ",7,"د",1,0],["فيا طولَ ذكرانا لأوصافِكَ التي","تجلُّ عن المسكِ الذكيِّ وتلطفُ",8,"ف",1,0],["فَيا طيبَ لَهوٍ ما هُناكَ لَهَوتُهُ","بِمُستَمَعٍ مِنها وَيا حُسنَ مَنظَرِ",9,"ر",1,0],["فَيا طولَ هَذا اللَيلِ لا أَعرِفُ الكَرى","وَلا الصُبحُ فيهِ راحَةٌ فَأُرَوَّحُ",10,"ح",1,0],["فَيا طائِرُ اِئمَنّي وَيا ظَبيُ لا تَخَف","شَذايَ فَما بَيني وَبَينَكُما فَرقُ",11,"ق",1,0],["فَيا طَيرَ الأَراكِ بِحَقِّ رَبٍّ","بَراكَ عَساكَ تَعلَمُ أَينَ حَلّوا",12,"ل",3,0],["فَيَا طَالِباً مَسْعَاتَهُ لِيَنَالَهَا","رُوَيْدَكَ إِنَّ الْحِرْصَ لِلنَّفْسِ خَاذِلُ",13,"ل",1,0],["في إطار من انتظار العصافير","ومن لهفة الصباح الكفيف",14,"ف",1,0],["فيا طالما كانَ حدُّ البَغِيِّ","يُخفِّفُ مِن فحشِ أهل البِغا",15,"ا",1,0],["فيا طير لا تسجع ويا ريح سكني","هبوبا على جسمي ليسكن ثائره",16,"ر",2,0],["فيَا طُوبى لهم فازُوا بخيرٍ","وقد صارَ الرحيق لهم نميرَا",17,"ر",2,0],["فَيا طيبَ ما حَيَّت بِهِ مِصرَ بابِلٌ","وَيا حُسنَ ما أَهدَت إِلى حَلَبٍ مِصرُ",18,"ر",1,0],["فيا طالبي العليا اصرفوا عن حديثها","فما ثَم فيها موضع المتكلم",19,"م",1,0],["فَيا طَلحَتَى لُوذانَ لا زالَ فِيكُما","لِمَن يَبتَغِى ظِلَّيكُما فَنَنَانِ",20,"ن",1,0],["فيا طالَما شِيمَ الحَيا من أَكُفِّها","وفي غُرَرٍ منها الحياءُ يُشام",21,"م",1,0],["فيا طالباً للعلم اسع إليه كي","تنور قلباً بالذنوب تسوّدا",22,"د",2,0],["فياطيبة طوبى لما قد حويت من","محل علا اعلى السماك له مرقى",23,"ق",2,0],["فيا طرف أرخصت سوق الغرام","تسوم فرائده ببكاك",24,"ك",1,0],["فيا طالباً أرض الحجاز إذا انطوى","له أجرعٌ منها تعرّض أجرع",25,"ع",1,0],["فيا طوبى لمن صلوا قعوداً","وناكوا في الكواشل من قيام",26,"م",1,0],["فيا طالما خصصت منه بنائل","يعيي الورى والوفد بالوفر رفده",27,"د",2,0],["فَيا طَرَب النفوس إِلى صعيد","يكفر ذنبها ذاكَ الصعيد",28,"د",1,0],["فَيا طول ما يَتلوه يَرجو بضاعة","مضاعَفة يَوم الجَزا لَيسَ تهمل",29,"ل",1,0],["فَيا طالَما غِبنا وَكان مجيؤنا","عَلى عجَلاتٍ لِلنّصارى غَدت تُكرى",30,"ر",2,0],["فَيا طيبَ أيّامٍ جَلَتها جَميعها","مَواسمُ مجموعٌ بِها الفطر والنحرُ",31,"ر",1,0],["فيا طيبَ ما سَعيٍ ويا حسنَ موفدٍ","مِنَ المجدِ وَالعلياءِ أزلفها قربا",32,"ب",2,0],["فَيا طَرَبي بِهِ طِربي إِلَيهِ","وَعَن عَينِ الغَلاةِ إِلَيكَ عَنّي",33,"ن",2,0],["فيا طاويَ الوَعساء مَهلاً فَكَم عَلى","هوى ظبيات القاع مضنىً طَوى الكَشحا",34,"ح",2,0],["فَيَأطِرنَهُ مِثلَ أَطرِ القِسِيِّ","وَيَبرينَهُ مِثلَ بَريِ النِبالِ",35,"ل",1,0],["فيا طالما لَعْبَتْ بروسٍ رؤوسُها","كما لعبت بالمَلْحَمات ذكورها",36,"ر",3,0],["فيا طالما نادى بها كل حائرٍ","فأهداه منها عَرفُها المتأرج",37,"ج",1,0],["فيا طَالباً للرزق من عند مِثْلِه","يبيتُ كئيباً لِلهموم مُسامِرا",38,"ر",2,0],["فَيا طيئاً طَيَّ الأَمير وَمن غَدا","لَهُ شرف عالي الذُرى وَالدَعائِمِ",39,"م",1,0],["فيا طيب معسول ذاك اللمى","إذا هَصَرَ الصَبُّ عسَّالها",40,"ل",3,0],["فيا طالباً يمَّمتُه فبلغته","لأَبلغ جاهاً من لَدُنْه ومالا",41,"ل",2,0],["فيا طال ما قضيت دهري سبهللا","أَسير صبابات حليف ملاه",42,"ه",1,0],["فيا طالباً نهج النفاه من الشقا","ونهج الشقا وعر وغير نفاه",42,"ه",1,0],["فيا طوبى لمن أمسى سعيداً","مآل إيابه دار السلام",43,"م",1,0],["فيا طالما يمسي ويصبح لاهياً","سل الوجد عنّي كيف أمسي وأصبحُ",44,"ح",1,0],["فيا طولَ ليلِ الفرع في فلق الضحى","ويا حسنَ صبح الخدّ حين دجا اسرة أس الخال",45,"ل",1,0],["فيا طالباً شاو بدر لقد","رمى بك ظنك مرمى بعيدا",46,"د",2,0],["فيَا طَالَ ما قَدْ صِحٍْتُ هَلْ مِنْ مُساعِدٍ","ويا طَالَ ما قَدْ دُرْتُ بَيْنَ البَريَّةِ",47,"ه",1,0],["فَيا طِرفَهُ ما كُنتَ كَالخَيلِ لا أَرى","سِواكَ غَداةَ الهَيعَةِ البَدر راكِبُه",48,"ب",2,0],["فيا طيبَ ذاكَ الشَّهدِ في ذَلك اللَّمى","ويا حُسْنَ ذَاكَ الدُّرِّ في ذَلك السِّلْكِ",49,"ك",1,0],["فيا طفيليَّ عِذَارِ خدِّه","لقد تطفلتَ على ذا الطِّفل",50,"ل",1,0]]}