{"poems":[[65,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[37,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[90,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[74,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[72,"لك الله من وال ولي مقرب","https://www.aldiwan.net/poem43025.html","الطويل"],[87,"فيا طير يهنيك طيب الكرى","https://www.aldiwan.net/poem7759.html","المتقارب"],[46,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[71,"فراقك للأجساد مفن ومتلف","https://www.aldiwan.net/poem28462.html","الطويل"],[33,"يقول خليلي إذ أجازت حمولها","https://www.aldiwan.net/poem42550.html","الطويل"],[52,"خليلي ما بال الدجى لا تزحزح","https://www.aldiwan.net/poem63979.html","الطويل"],[48,"وجوهكم كلف وأفواهكم عدى","https://www.aldiwan.net/poem23008.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9959","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[102,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[92,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[132,"أرى الدنيا وزخرفها غرورا","https://www.aldiwan.net/poem50617.html","الطويل"],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[164,"رمتني فلا شلت يداها بأسهم","https://www.aldiwan.net/poem58914.html","الطويل"],[185,"خليلى ليس الشوق أن تشحط النوى","https://www.aldiwan.net/poem58832.html","الطويل"],[189,"على الجانب الإسكندري سلام","https://www.aldiwan.net/poem14658.html","الطويل"],[210,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[214,"تعلمت الألحان من نوحي الورقا","https://www.aldiwan.net/poem13299.html","الطويل"],[226,"دعاك الهوى فاجب من دعاك","https://www.aldiwan.net/poem55466.html","المتقارب"],[235,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[260,"أيا من وجهه كالشمس توفي","https://www.aldiwan.net/poem48427.html","الوافر"],[265,"أشاقك من هذا الرديني قده","https://www.aldiwan.net/poem38143.html","الطويل"],[275,"رفاقي الظاعنين متى الورود","https://www.aldiwan.net/poem52071.html","الوافر"],[275,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[309,"سلام إذا ما افتر أنشقكم عطرا","https://www.aldiwan.net/poem56542.html","الطويل"],[309,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[309,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[353,"شربت من الحميا ما سقتني","https://www.aldiwan.net/poem15973.html","الوافر"],[357,"أما والهوى لولا الألى نزلوا السفحا","https://www.aldiwan.net/poem40542.html","الطويل"],[370,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[381,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[381,"أحن إلى الوادي المقدس رغبة","https://www.aldiwan.net/poem66892.html","الطويل"],[406,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[410,"همو علموا عيني سؤال المعالم","https://www.aldiwan.net/poem50112.html","الطويل"],[420,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[420,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[445,"أخي ولدي ما بال قلبك لاه","https://www.aldiwan.net/poem14433.html","الطويل"],[445,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[467,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[467,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[518,"أما وخدود ألفن الصدودا","https://www.aldiwan.net/poem12070.html","المتقارب"],[532,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[566,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[578,"حذار سيوف الهند من أعين الترك","https://www.aldiwan.net/poem2903.html","الطويل"],[578,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/20908","الطويل"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[1140,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"]],"verses":[["فيا طِيبَها والشَّرْبُ صاحٍ ومُنْتَشٍ","تَخِفُّ بها أيْدٍ وتَثْقُلُ أجْفانُ",0,"ن",1,0],["فَيا طالَما مازَحتُ فيها عُبَيلَةً","وَمازَحَني فيها الغَزالُ المُغَنَّجُ",1,"ج",1,0],["فَيا طولَ ما شَوقي إِذا حالَ دُونَها","بُصاقٌ وَمَن أَعلامِ صِندِدَ مَنكِبُ",2,"ب",1,0],["فيا طلقةً ريع العراق بصوتها","فبانت به الآفاق عابسةً دكنا",3,"ن",2,0],["فيا طرسيَ ألثم ثراه المري","ع ألفاً ويا مدحةُ عانق",4,"ق",1,0],["فَيا طالِباً لِلجودِ مِن غَيرِ جَلدَكٍ","نَصَحتُكَ لا تَتعَب وَلا تَتَطَلَّبِ",5,"ب",1,0],["فيا طير يهنيك طيب الكرى","وطول العناق وفرط النعيم",6,"م",1,1],["فَيا طيبَ مَجناها وَيا بَردَ وَقعِها","عَلى الكَبِدِ الحَرّى وَزادَ عَلى البَردِ",7,"د",1,0],["فيا طولَ ذكرانا لأوصافِكَ التي","تجلُّ عن المسكِ الذكيِّ وتلطفُ",8,"ف",1,0],["فَيا طيبَ لَهوٍ ما هُناكَ لَهَوتُهُ","بِمُستَمَعٍ مِنها وَيا حُسنَ مَنظَرِ",9,"ر",1,0],["فَيا طولَ هَذا اللَيلِ لا أَعرِفُ الكَرى","وَلا الصُبحُ فيهِ راحَةٌ فَأُرَوَّحُ",10,"ح",1,0],["فَيا طائِرُ اِئمَنّي وَيا ظَبيُ لا تَخَف","شَذايَ فَما بَيني وَبَينَكُما فَرقُ",11,"ق",1,0],["فَيا طَيرَ الأَراكِ بِحَقِّ رَبٍّ","بَراكَ عَساكَ تَعلَمُ أَينَ حَلّوا",12,"ل",3,0],["فَيَا طَالِباً مَسْعَاتَهُ لِيَنَالَهَا","رُوَيْدَكَ إِنَّ الْحِرْصَ لِلنَّفْسِ خَاذِلُ",13,"ل",1,0],["فيا طالب الله ائته من طريقه","وإلا فبالحرمان أنت جدير",14,"ر",1,0],["في إطار من انتظار العصافير","ومن لهفة الصباح الكفيف",15,"ف",1,0],["فيا طالما كانَ حدُّ البَغِيِّ","يُخفِّفُ مِن فحشِ أهل البِغا",16,"ا",1,0],["فيا طير لا تسجع ويا ريح سكني","هبوبا على جسمي ليسكن ثائره",17,"ر",2,0],["فيَا طُوبى لهم فازُوا بخيرٍ","وقد صارَ الرحيق لهم نميرَا",18,"ر",2,0],["فَيا طيبَ ما حَيَّت بِهِ مِصرَ بابِلٌ","وَيا حُسنَ ما أَهدَت إِلى حَلَبٍ مِصرُ",19,"ر",1,0],["فيا طالبي العليا اصرفوا عن حديثها","فما ثَم فيها موضع المتكلم",20,"م",1,0],["فَيا طَلحَتَى لُوذانَ لا زالَ فِيكُما","لِمَن يَبتَغِى ظِلَّيكُما فَنَنَانِ",21,"ن",1,0],["فيا طالَما شِيمَ الحَيا من أَكُفِّها","وفي غُرَرٍ منها الحياءُ يُشام",22,"م",1,0],["فيا طالباً للعلم اسع إليه كي","تنور قلباً بالذنوب تسوّدا",23,"د",2,0],["فياطيبة طوبى لما قد حويت من","محل علا اعلى السماك له مرقى",24,"ق",2,0],["فيا طرف أرخصت سوق الغرام","تسوم فرائده ببكاك",25,"ك",1,0],["فيا طالباً أرض الحجاز إذا انطوى","له أجرعٌ منها تعرّض أجرع",26,"ع",1,0],["فيا طوبى لمن صلوا قعوداً","وناكوا في الكواشل من قيام",27,"م",1,0],["فيا طالما خصصت منه بنائل","يعيي الورى والوفد بالوفر رفده",28,"د",2,0],["فَيا طَرَب النفوس إِلى صعيد","يكفر ذنبها ذاكَ الصعيد",29,"د",1,0],["فَيا طول ما يَتلوه يَرجو بضاعة","مضاعَفة يَوم الجَزا لَيسَ تهمل",30,"ل",1,0],["فَيا طالَما غِبنا وَكان مجيؤنا","عَلى عجَلاتٍ لِلنّصارى غَدت تُكرى",31,"ر",2,0],["فَيا طيبَ أيّامٍ جَلَتها جَميعها","مَواسمُ مجموعٌ بِها الفطر والنحرُ",32,"ر",1,0],["فيا طيبَ ما سَعيٍ ويا حسنَ موفدٍ","مِنَ المجدِ وَالعلياءِ أزلفها قربا",33,"ب",2,0],["فَيا طَرَبي بِهِ طِربي إِلَيهِ","وَعَن عَينِ الغَلاةِ إِلَيكَ عَنّي",34,"ن",2,0],["فيا طاويَ الوَعساء مَهلاً فَكَم عَلى","هوى ظبيات القاع مضنىً طَوى الكَشحا",35,"ح",2,0],["فَيَأطِرنَهُ مِثلَ أَطرِ القِسِيِّ","وَيَبرينَهُ مِثلَ بَريِ النِبالِ",36,"ل",1,0],["فيا طالما لَعْبَتْ بروسٍ رؤوسُها","كما لعبت بالمَلْحَمات ذكورها",37,"ر",3,0],["فيا طالما نادى بها كل حائرٍ","فأهداه منها عَرفُها المتأرج",38,"ج",1,0],["فيا طَالباً للرزق من عند مِثْلِه","يبيتُ كئيباً لِلهموم مُسامِرا",39,"ر",2,0],["فَيا طيئاً طَيَّ الأَمير وَمن غَدا","لَهُ شرف عالي الذُرى وَالدَعائِمِ",40,"م",1,0],["فيا طيب معسول ذاك اللمى","إذا هَصَرَ الصَبُّ عسَّالها",41,"ل",3,0],["فيا طالباً يمَّمتُه فبلغته","لأَبلغ جاهاً من لَدُنْه ومالا",42,"ل",2,0],["فيا طال ما قضيت دهري سبهللا","أَسير صبابات حليف ملاه",43,"ه",1,0],["فيا طالباً نهج النفاه من الشقا","ونهج الشقا وعر وغير نفاه",43,"ه",1,0],["فيا طوبى لمن أمسى سعيداً","مآل إيابه دار السلام",44,"م",1,0],["فيا طالما يمسي ويصبح لاهياً","سل الوجد عنّي كيف أمسي وأصبحُ",45,"ح",1,0],["فيا طولَ ليلِ الفرع في فلق الضحى","ويا حسنَ صبح الخدّ حين دجا اسرة أس الخال",46,"ل",1,0],["فيا طالباً شاو بدر لقد","رمى بك ظنك مرمى بعيدا",47,"د",2,0],["فيَا طَالَ ما قَدْ صِحٍْتُ هَلْ مِنْ مُساعِدٍ","ويا طَالَ ما قَدْ دُرْتُ بَيْنَ البَريَّةِ",48,"ه",1,0],["فَيا طِرفَهُ ما كُنتَ كَالخَيلِ لا أَرى","سِواكَ غَداةَ الهَيعَةِ البَدر راكِبُه",49,"ب",2,0],["فيا طيبَ ذاكَ الشَّهدِ في ذَلك اللَّمى","ويا حُسْنَ ذَاكَ الدُّرِّ في ذَلك السِّلْكِ",50,"ك",1,0],["فيا طفيليَّ عِذَارِ خدِّه","لقد تطفلتَ على ذا الطِّفل",51,"ل",1,0],["فَيا طيبَ ما رَيّا وَيا حُسنَ مَنظَرٍ","لَهَوتُ بِهِ لَو اِنَّ رُؤياكَ تَصدُقُ",52,"ق",1,0],["فَيا طيبَ رَيّاها وَيا بَردَ ظِلِّها","إِذا حانَ من حامي النَّهارِ ودوقُ",53,"ق",1,0],["فَيا طَعنَة مَا تَسُوءُ العَدُوَّ","وَتَبلُغُ مِن ذاكَ أَمراً قَرارا",54,"ر",2,0]]}