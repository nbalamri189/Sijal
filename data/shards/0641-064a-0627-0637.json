يل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117202","الطويل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117200","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33619","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120484","الوافر"],[4675,"دفاع عن علامة الصومال عبد الكريم حسن حوش","https://www.poetsgate.com/ViewPoem.aspx?id=192203",""],[4680,"خليليَّ مرّا بالديار","https://www.poetsgate.com/ViewPoem.aspx?id=196736",""],[4578,"بماذا يوفي قدر علياك مادحُ","https://www.poetsgate.com/ViewPoem.aspx?id=49378",""],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[4858,"حنين إلى الأهل والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=138206",""],[4927,"الْخِمَاْرُ المغرِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=29847",""],[4978,"أحبكِ في صمت ولست بطامعِ","https://www.poetsgate.com/ViewPoem.aspx?id=177193",""],[5038,"حان الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=188122",""],[5043,"وعد العرس الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=203387",""],[5112,"إلى الشيخ عبده","https://www.poetsgate.com/ViewPoem.aspx?id=212775",""],[5127,"عشقتُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=177306",""],[5186,"رفعت إلى أوج العلى راية الهند","https://www.poetsgate.com/ViewPoem.aspx?id=156480",""],[5277,"وجعٌ على قارعةِ الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=201006",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5582,"قِفُوا حَدِّثُوا عَنْ حاجِرٍ وَمُحَجَّرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63520",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63500",""],[5582,"أَسِيرُ غَرامٍ ذائِبُ القَلْبِ مَعْمُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=63499",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[5736,"عناق","https://www.poetsgate.com/ViewPoem.aspx?id=208230",""],[5957,"العناق الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=53578",""],[6106,"طيفها الساحر !","https://www.poetsgate.com/ViewPoem.aspx?id=6312",""],[6152,"فيكِ أسافر","https://www.poetsgate.com/ViewPoem.aspx?id=203282",""],[6167,"مأتم الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85580&r=&rc=63",""]],"verses":[["فيا طِيبَها والشَّرْبُ صاحٍ ومُنْتَشٍ","تَخِفُّ بها أيْدٍ وتَثْقُلُ أجْفانُ",0,"ن",1,0],["فَيا طالَما مازَحتُ فيها عُبَيلَةً","وَمازَحَني فيها الغَزالُ المُغَنَّجُ",1,"ج",1,0],["فَيا طولَ ما شَوقي إِذا حالَ دُونَها","بُصاقٌ وَمَن أَعلامِ صِندِدَ مَنكِبُ",2,"ب",1,0],["فيا طلقةً ريع العراق بصوتها","فبانت به الآفاق عابسةً دكنا",3,"ن",2,0],["فيا طرسيَ ألثم ثراه المري","ع ألفاً ويا مدحةُ عانق",4,"ق",1,0],["فَيا طالِباً لِلجودِ مِن غَيرِ جَلدَكٍ","نَصَحتُكَ لا تَتعَب وَلا تَتَطَلَّبِ",5,"ب",1,0],["فيا طير يهنيك طيب الكرى","وطول العناق وفرط النعيم",6,"م",1,1],["فَيا طيبَ مَجناها وَيا بَردَ وَقعِها","عَلى الكَبِدِ الحَرّى وَزادَ عَلى البَردِ",7,"د",1,0],["فيا طولَ ذكرانا لأوصافِكَ التي","تجلُّ عن المسكِ الذكيِّ وتلطفُ",8,"ف",1,0],["فَيا طيبَ لَهوٍ ما هُناكَ لَهَوتُهُ","بِمُستَمَعٍ مِنها وَيا حُسنَ مَنظَرِ",9,"ر",1,0],["فَيا طولَ هَذا اللَيلِ لا أَعرِفُ الكَرى","وَلا الصُبحُ فيهِ راحَةٌ فَأُرَوَّحُ",10,"ح",1,0],["فَيا طائِرُ اِئمَنّي وَيا ظَبيُ لا تَخَف","شَذايَ فَما بَيني وَبَينَكُما فَرقُ",11,"ق",1,0],["فَيا طَيرَ الأَراكِ بِحَقِّ رَبٍّ","بَراكَ عَساكَ تَعلَمُ أَينَ حَلّوا",12,"ل",3,0],["فَيَا طَالِباً مَسْعَاتَهُ لِيَنَالَهَا","رُوَيْدَكَ إِنَّ الْحِرْصَ لِلنَّفْسِ خَاذِلُ",13,"ل",1,0],["فيا طالب الله ائته من طريقه","وإلا فبالحرمان أنت جدير",14,"ر",1,0],["في إطار من انتظار العصافير","ومن لهفة الصباح الكفيف",15,"ف",1,0],["فيا طالما كانَ حدُّ البَغِيِّ","يُخفِّفُ مِن فحشِ أهل البِغا",16,"ا",1,0],["فيا طير لا تسجع ويا ريح سكني","هبوبا على جسمي ليسكن ثائره",17,"ر",2,0],["فيَا طُوبى لهم فازُوا بخيرٍ","وقد صارَ الرحيق لهم نميرَا",18,"ر",2,0],["فَيا طيبَ ما حَيَّت بِهِ مِصرَ بابِلٌ","وَيا حُسنَ ما أَهدَت إِلى حَلَبٍ مِصرُ",19,"ر",1,0],["فيا طالبي العليا اصرفوا عن حديثها","فما ثَم فيها موضع المتكلم",20,"م",1,0],["فَيا طَلحَتَى لُوذانَ لا زالَ فِيكُما","لِمَن يَبتَغِى ظِلَّيكُما فَنَنَانِ",21,"ن",1,0],["فيا طالَما شِيمَ الحَيا من أَكُفِّها","وفي غُرَرٍ منها الحياءُ يُشام",22,"م",1,0],["فيا طالباً للعلم اسع إليه كي","تنور قلباً بالذنوب تسوّدا",23,"د",2,0],["فياطيبة طوبى لما قد حويت من","محل علا اعلى السماك له مرقى",24,"ق",2,0],["فيا طرف أرخصت سوق الغرام","تسوم فرائده ببكاك",25,"ك",1,0],["فيا طالباً أرض الحجاز إذا انطوى","له أجرعٌ منها تعرّض أجرع",26,"ع",1,0],["فيا طوبى لمن صلوا قعوداً","وناكوا في الكواشل من قيام",27,"م",1,0],["فيا طالما خصصت منه بنائل","يعيي الورى والوفد بالوفر رفده",28,"د",2,0],["فَيا طَرَب النفوس إِلى صعيد","يكفر ذنبها ذاكَ الصعيد",29,"د",1,0],["فَيا طول ما يَتلوه يَرجو بضاعة","مضاعَفة يَوم الجَزا لَيسَ تهمل",30,"ل",1,0],["فَيا طالَما غِبنا وَكان مجيؤنا","عَلى عجَلاتٍ لِلنّصارى غَدت تُكرى",31,"ر",2,0],["فَيا طيبَ أيّامٍ جَلَتها جَميعها","مَواسمُ مجموعٌ بِها الفطر والنحرُ",32,"ر",1,0],["فيا طيبَ ما سَعيٍ ويا حسنَ موفدٍ","مِنَ المجدِ وَالعلياءِ أزلفها قربا",33,"ب",2,0],["فَيا طَرَبي بِهِ طِربي إِلَيهِ","وَعَن عَينِ الغَلاةِ إِلَيكَ عَنّي",34,"ن",2,0],["فيا طاويَ الوَعساء مَهلاً فَكَم عَلى","هوى ظبيات القاع مضنىً طَوى الكَشحا",35,"ح",2,0],["فَيَأطِرنَهُ مِثلَ أَطرِ القِسِيِّ","وَيَبرينَهُ مِثلَ بَريِ النِبالِ",36,"ل",1,0],["فيا طالما لَعْبَتْ بروسٍ رؤوسُها","كما لعبت بالمَلْحَمات ذكورها",37,"ر",3,0],["فيا طالما نادى بها كل حائرٍ","فأهداه منها عَرفُها المتأرج",38,"ج",1,0],["فيا طَالباً للرزق من عند مِثْلِه","يبيتُ كئيباً لِلهموم مُسامِرا",39,"ر",2,0],["فَيا طيئاً طَيَّ الأَمير وَمن غَدا","لَهُ شرف عالي الذُرى وَالدَعائِمِ",40,"م",1,0],["فيا طيب معسول ذاك اللمى","إذا هَصَرَ الصَبُّ عسَّالها",41,"ل",3,0],["فيا طالباً يمَّمتُه فبلغته","لأَبلغ جاهاً من لَدُنْه ومالا",42,"ل",2,0],["فيا طال ما قضيت دهري سبهللا","أَسير صبابات حليف ملاه",43,"ه",1,0],["فيا طالباً نهج النفاه من الشقا","ونهج الشقا وعر وغير نفاه",43,"ه",1,0],["فيا طوبى لمن أمسى سعيداً","مآل إيابه دار السلام",44,"م",1,0],["فيا طالما يمسي ويصبح لاهياً","سل الوجد عنّي كيف أمسي وأصبحُ",45,"ح",1,0],["فيا طولَ ليلِ الفرع في فلق الضحى","ويا حسنَ صبح الخدّ حين دجا اسرة أس الخال",46,"ل",1,0],["فيا طالباً شاو بدر لقد","رمى بك ظنك مرمى بعيدا",47,"د",2,0],["فيَا طَالَ ما قَدْ صِحٍْتُ هَلْ مِنْ مُساعِدٍ","ويا طَالَ ما قَدْ دُرْتُ بَيْنَ البَريَّةِ",48,"ه",1,0],["فَيا طِرفَهُ ما كُنتَ كَالخَيلِ لا أَرى","سِواكَ غَداةَ الهَيعَةِ البَدر راكِبُه",49,"ب",2,0],["فيا طيبَ ذاكَ الشَّهدِ في ذَلك اللَّمى","ويا حُسْنَ ذَاكَ الدُّرِّ في ذَلك السِّلْكِ",50,"ك",1,0],["فيا طفيليَّ عِذَارِ خدِّه","لقد تطفلتَ على ذا الطِّفل",51,"ل",1,0],["فَيا طيبَهُ إذ شيحُهُ مُتَزاوِجٌ","يَضُوعُ وإذ حُواذانُهُ مُتَعانِقُ",52,"ق",1,0],["فيا طيب راح فيه روح وراحة","ويا طيب ما غنى بفقى به أغنى",53,"ن",2,0],["فيا طيبَ ليلٍ بتّ فيه مُمَتَّعاً","إلى أن بدا وجهٌ من الصّبحِ يَشنُعُ",54,"ع",1,0],["فيا طيبا أصلاً وذكراً وتربة","ومنه استفاد الطيب أطيب رياه",55,"ا",2,0],["فَيا طالَما عايَنتِ مني مَودة","يَدوم عَلى طُول الزَمان بقاها",56,"ا",3,0],["فَيا طوسن اِقرأ التَنزيل وَاتلو","بِهِ حكماً كَما قَرأ البَشير",57,"ر",1,0],["فَيا طَرفُ لا تَدمَع وَأَقصر من الأَسى","وَيا قلبُ لا تَحزَن فَتَفتَقِد الحِجى",58,"ج",2,0],["فيا طيوف المنى.. فاض الحنين بنا","وزادنا شجنًا أن النوى قدر",59,"ر",1,0],["فيا طيب ما يحوى من السر صدره","ويا طيب ما يحوى من البدن الأزر",60,"ر",1,0],["فيا طائر الوادي ويا شاعر الحمى","ذهبت فأوحشت الربى والمغانيا",61,"ي",2,0],["فيا طيبَ دنياه ويا حسن دينهِ","حمى بالذي أوليتِه اعتز واستغنى",62,"ن",2,0],["فيا طالما طرَّزتُه بمكارمٍ","غدا مِن سناها رافلاً في حُلي الفَخرِ",63,"ر",1,0],["فَيا طَرْفاً رآهُ مُستَطيعاً","لَقَد نِلتَ المُنى فَرِحاً قَريرا",64,"ر",2,0],["فَيا طيبَ عَكّارٍ تَسيرُ بِهِ الصّبا","وَفي مِثلِهِ لَم تَسرِ يَوماً صَبا نَجدِ",65,"د",1,0],["فَيا طَرفَهُ يَرمي السِّهامَ بِمُهجَتي","وَيجهدُ فيهِ النَّفسَ دونَ غموضِ",66,"ض",1,0],["فيا طيبَ ما يُملي عليَّ خِطابُها","ويا لُطفَ ما جاءت به من بشائر",67,"ر",1,0],["فيا طلعة للحسن بان كمالها","أما لصباح الوصل في الهجر مَطلع",68,"ع",1,0],["فيا طود عز قد أمنا بظله","تكنفه ريب الردى فتزعزعا",69,"ع",2,0],["فيا طولَ ليلِ الفرع في فلق الضحى","ويا حسنَ صبح الخدّ حين دجا الخال",70,"ل",1,0],["فيا طالب الدنيا يجمع حطامها","ستترك ما جمعته يوم تحكم",71,"م",1,0],["فَيا طالباً شكلاً ففرّ واِرعوي","فَما شكلهُ في جملةِ الخلق موجودُ",72,"د",1,0],["فَيا طالَ ما قد بتُّ مُستمعاً بها","وَمنهل صفو الفضل لم يتكدّرِ",73,"ر",1,0],["فَيا طولَ وَجدي يومَ كنتُ رأيتهم","يَطوفونَ في يوم الوداع بمقعدِ",74,"د",1,0],["فيا طوبى لمَن يحظى","برشفِ الظلم من فيهِ",75,"ي",2,0],["فيا طيب الرقاد بأرض قوم","وقد طابت سرائرهم وطابوا",76,"ب",3,0],["فيا طالب العلم خب فالكتاب","قد مزق الكفر قرطاسه",77,"س",2,0],["فَيا طِيبَ مُصْطَافي لَدَيْكَ ومَرْبَعي","ويا عِزَّ إِصْباحي لَدَيْكَ وإِمْسَائي",78,"ي",1,0],["فيا طوبى لحضرتها","بحضرة خير منتخب",79,"ب",1,0],["فيا طوبى لمن حازوا","محبة نحبة النخب",79,"ب",1,0],["فيا طفلتي بوسي الوجود بأسرهِ","كما شئت لكن حاذري بوسة الهوى",80,"و",2,0],["فيا طوبى لمن أثنى عليه","وبا بشرى لمن صلّى وسلّم",81,"م",1,0],["فيا طالبا أن تعيش الدُّهور","تَعلّم وثابر تنل ما تشاء",82,"ا",2,0],["فَيا طَيفَهُ قُل لِي أَهَل هو لم يَزَل","عَلَى العَهدِ باقٍ بعدَنَا أَم تَنَاسَاهُ",83,"ا",2,0],["فيا طفلةٌ كم تمنيتُها","لزينةِ وِلدي ولم أَقنعِ",84,"ع",1,0],["فيا طفلتي إن رُزقتِ الحياةَ","فرودي مباني النّهى واْنجعي",84,"ع",2,0],["في أطيعوا وقوله وأولي الأم","ر الدليل العظيم للتمجيد",85,"د",1,0],["فيا طالبا خوضا بسبعة أبحر","ستكفيك سبع من أنامله العشر",86,"ر",1,0],["فيا طالباً في الورى مثله","إلا أقصر ولا تطلب المستحيلا",87,"ل",2,0],["فَيا طَالما كنَّا هُناكَ بأَنعُمٍ","وَوَصل وأُنس وَالزَّمانُ مُصرّف",88,"ف",1,0],["فيا طوبى لمن رفض المعاصي","وامسى آخذاً منها حذاره",89,"ر",2,0],["فَيا طيبَ ما رَيّا وَيا حُسنَ مَنظَرٍ","لَهَوتُ بِهِ لَو اِنَّ رُؤياكَ تَصدُقُ",90,"ق",1,0],["فيا طالب العلياء أعوز نيلها","يميناً لقد نادتك لو كنت تسمع",91,"ع",1,0],["فيا طالما حدثت عنك بفضل ما","سمحت به لما سألت وقيل لي",92,"ل",2,0],["فيا طاعتي لو كنت كنت مقرّباً","ومعصيتي لولاك ما كنتُ مجتبى",93,"ا",1,0],["في أطلس ما فيه نجمٌ ثابتٌ","يبدو يشاهد نوره للرائي",94,"ا",2,0],["فيا طالما جربتهم واختبر