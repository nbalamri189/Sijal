{"poems":[[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[190,"أرى قوما شجيت بهم رذالا","https://www.aldiwan.net/poem43473.html","الوافر"],[568,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63903","السريع"],[1390,"","https://poetry.dctabudhabi.ae/diwan/poem/117141","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136480",""],[4927,"ضِيم الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=80798",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""]],"verses":[["فَلَم وِبقِ غَمراً طَعنُهُ الغَمرُ فيهِمُ","وَلَم يُبقِ وِتراً ضَربُهُ المُتَواتِرُ",0,"ر",1,0],["فلم ورثوهما دوني قضاء","كما قالوا حرى فبم احتيالي",1,"ل",2,0],["فَلم وَلَدَيكَ رَوضُ العِلمِ غَضّاً","رَعاكَ اللَهُ تُعنى بِالهَشيمِ",2,"م",1,0],["فلْمْ وقد قامتْ تُباهيك لمْ","يُومئ إِليها الخلقُ بالخمس",3,"س",1,0],["فلم وعلاك تهتك غير عرض","سمين ليس يعتاد الهزالا",4,"ل",2,0],["فلموسى يا نفسُ ذوبي ووجداً","يا سماء شبلٍ له وخيرُ سليل",5,"ل",1,0],["فَلِمَوْجِهَاْ فِيْ بَاْنِيَاْسَ مَوَاْقِعٌ","وَمَرَاْفِئٌ وَمَعَاْمِعٌ وَلِوَاْءُ",6,"ا",2,0],["فلم وما بالهم يروون مشتهراً","من الحديث بلا رأي ومعتقد",7,"د",1,0]]}