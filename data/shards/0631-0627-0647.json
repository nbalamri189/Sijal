ق قلبكَ أن يموت","https://www.poetsgate.com/ViewPoem.aspx?id=53749",""],[5072,"خريف الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=53931",""],[3591,"لكم بفؤادي كلما قدم العهدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149423",""],[5106,"عَاْشَ صَقْرَاً قَلَصَ الْكِبْرَ حِيْاْضَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150032",""],[5111,"رَاهِبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212530",""],[5198,"مزهرية","https://www.poetsgate.com/ViewPoem.aspx?id=135379",""],[5198,"ضحكتك حفلة","https://www.poetsgate.com/ViewPoem.aspx?id=135389",""],[4045,"لتمد برّز الفضل بن يحيى ولم يزل","https://www.poetsgate.com/ViewPoem.aspx?id=200280",""],[5351,"ماذا هناك","https://www.poetsgate.com/ViewPoem.aspx?id=202284",""],[5444,"عصامي العلا","https://www.poetsgate.com/ViewPoem.aspx?id=205517",""],[5536,"لحن بيتهوفن!!","https://www.poetsgate.com/ViewPoem.aspx?id=22594",""],[5691,"فخ وبصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=206216",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[5703,"قد كان درساً","https://www.poetsgate.com/ViewPoem.aspx?id=206167",""],[5751,"أميرة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214765",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5926,"ذكريات لم تنتهِ بعد","https://www.poetsgate.com/ViewPoem.aspx?id=213775",""],[6237,"أمامك دنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77858&r=&rc=0",""]],"verses":[["رَآها عَلى عِلّاتِها ظَهرَ صَعبَةٍ","تَحادَرُ مِن إِرقاصِها وَتُحاذِرُ",0,"ر",1,0],["رآه مُستَغرقاً في نَومِه فَرأى","فيه الجَلالَة في أسمَى مَعانيها",1,"ي",3,0],["رَآهُ مَعشَرٌ مِنّا مُباحاً","وَفي أَعناقِهِم ذاكَ النِكاحُ",2,"ح",1,0],["رَآهُ اللَهُ أَجوَدَ بِالعَطايا","وَأَطعَنَ بِالمَكايِدِ وَالرِماحِ",3,"ح",1,0],["رآهم عبيداً فاستبدّ بمائه","ولم يَجْر بين المُجْدِباتِ مُشاعا",4,"ع",2,0],["رآه أبو العباس أَقومَ قائمٍ","بأعماله عند امتحانِ كُفاتِهِ",5,"ت",2,0],["رَآهُ رَضِيعاً كلُّ مَاضِي بَصِيرَةٍ","فقالُوا جميعاً قُنَّةٌ ستُطوَّدُ",6,"د",1,0],["رَآها الفُؤادُ فَاِستُضِلَّ ضَلالُهُ","نِيافاً مِنَ البيضِ الحِسانِ العَطابِلِ",7,"ل",1,0],["رَآها يَحُلُّ الفَجرُ عَقدَ جُفونِها","وَيُلقي عَلَيها تِبرَهُ فَيَذوبُ",8,"ب",1,0],["راهِبٌ في الضُلوعِ لِلسُفنِ فَطنُ","كُلَّما ثُرنَ شاعَهُنَّ بِنَقسِ",9,"س",1,0],["راهبةٌ للهِ في نُسوَةٍ","قد أُلبِسَتْ قُضْبَ اللُّجَينِ المُسُوحُ",10,"ح",1,0],["رَآها أُناسٌ","بِعَينِ القُلوبِ",11,"ب",1,0],["رَآهُ العِلجُ مُقتَحِماً عَلَيهِ","كَما اِقتَحَمَ الفَناءُ عَلى الخُلودِ",12,"د",1,0],["رآهُ مجرَّداً يوماً عذولي","فما عَرَفَ النضارَ من اللجينِ",13,"ن",1,0],["رَآهُ أَخْوَنَ مِن ذئبٍ فَعاجَلَهُ","بالسَّيفِ يُوردُه مِنه دماً هَدَرا",14,"ر",2,0],["رآه وَلِيُّهُ كَذِباً فَوَلَّى","يُسائِلُ نفسَهُ ماذا عَرَاها",15,"ا",3,0],["رَآها نِعمَ الخَدينُ فَلَم يَزَل","لِحاجاتِها ما لَم تَحُل يَتَحَمَّلُ",16,"ل",1,0],["رآه أميرُ المؤمنين كعهدِهِ","تشبُّ لَظى الهيجاء ألفَحَ ألفَحا",17,"ح",2,0],["رَآها كِباراً مَن بَراها كَأَنَّها","تَريكُ نَعامٍ أَودَعَتهُ الصَرائِمُ",18,"م",1,0],["رَآهُم عَلى ما يَكرَهُ الناسَ رَبُّهُم","وَعُذتُ بِهِ فيما تَمَنَّوا وَما مَنَّوا",19,"ن",3,0],["رآها سليلُ الطّينِ والشّيبُ شامِلٌ","لها بالثّرَيّا والسّماكَينِ والوَزْنِ",20,"ن",1,0],["رآها عَلى وجه الفراش كأنها","عروس هوت كسلانة فَهي تهجع",21,"ع",1,0],["رَآهاً فُؤَادِي أُمَّ خِشْفٍ خَلاَلَهَا","بِقُورِ الوِرَاقَيْنِ السَّرَاءُ المُصَنِّفُ",22,"ف",1,0],["رآها على النبع بعضُ الرُّعاةِ","مصوَّرةً في إطار الغصونْ",23,"ن",1,0],["رآها فجنَّ غراماً بها","وغنَّى بها الليلَ بعد النهارْ",23,"ر",1,0],["رآهُ كَهْلانُ مِن مَعَاقِلِهِ","في الحَرْبِ دونَ العَبيدِ والحَشَم",24,"م",1,0],["رَآهُ فِيهِ صَامِتاً مُوحَشاً","كَمَا يَكونُ الحُرُّ مُسْتَأْسرَا",25,"ر",2,0],["رَآهَا فتى خَالٍ فَمَلَّكَ حُسْنَها","قِيَادَ الْهَوَى فِي قَلْبِهِ المُتَوَزِّعِ",26,"ع",1,0],["رآهَا وفي العنقودِ والكرم ما اشْتهَى","وأيْنَ من العنقُودِ أيدِي الثعالبِ",27,"ب",1,0],["رآه الصبحُ منه فزاد حسناً","وغار البدرُ منه فزاد سُهدا",28,"د",2,0],["رآهُ سَلِيلُ الطّينِ يَجْتَابُ لَيْلَه","فَهَلْ هَدَأَتْ دُون المَسِيرِ جَوائِبُه",29,"ب",2,0],["رآها آدمٌ وَعَدَتْ بنُوحٍ","وولَّى بعدَها نَسْلٌ ونسل",30,"ل",1,0],["راهِبٌ خطَّ في القُرى محرابَهْ","بين شطِّ الغَدير واللَّبْلابَهْ",31,"ب",2,1],["راهب الفنّ صدره","للصبابات مزدحم",32,"م",1,0],["رآهم عبيداً فاستبد بمائه","جرى شاكراً صنعَ الطبيعة إنها",33,"ا",1,0],["رَآهُ بِعَينِ الفِكرِ قَبلَ وُقوعِهِ","فَصادَفَ مِنهُ قُلَّبَ الرَأيِ حُوَّلا",34,"ل",2,0],["رَآها الأَقرَبونَ فَأَعظَموها","وَسارَ حَديثُها في الأَبعَدينا",35,"ن",2,0],["رآه الله أطهرهم ضميراً","فقلّد جيده العلق الثمينا",36,"ن",2,0],["رَآها كعقدٍ زيّن العصرَ حسنهُ","فَيا حُسنها عقداً ويا قبحهُ عَصرا",37,"ر",2,0],["رأه بحيرا والغمامة فوقه","ومسيرةٌ والحرّ للوجه يسفع",38,"ع",1,0],["راهِنَةٍ شُكري بِها","إِلى المَماتِ مُرتَهَن",39,"ن",1,0],["رَآهُ أَميرُ المُؤمِنينَ لِدائِها","وَقَد أَعضَلَت أَدواؤُها خَيرَ حاسِمِ",40,"م",1,0],["رَآهُ أَبقى عِتادٍ","وَالمالُ غادٍ وَرائِح",41,"ح",1,0],["رَآها عَذولي فَاِنثَنى وَهوَ عاذِري","فَحَسبي عَذولٌ راحَ وَهوَ عَذيرُ",42,"ر",1,0],["رَآهُ طَرفي عَلى طرفٍ يمرّ بهِ","فَشنَّ غارةَ دمعٍ منهُ مُنسفكِ",43,"ك",1,1],["رَآه يعدّ الحربَ سلماً شهامة","وَيَحسب حزماً أنّ في الهدنةِ الحربا",44,"ب",2,0],["رَآهَا الشَّيْخُ فَانْبَعَثتْ قُواهُ","وَبُشِّرَ بِالشَّبابِ المُسْتَجَدِّ",45,"د",1,0],["راهِبٌ كِالبَدرِ في البِر","نُسِ مِنهُ الوَجهُ يَبدو",46,"د",2,0],["رآه معَ الإصباحِ في كَفِّ جارحٍ","وقد أنشبَتْ فيه مَخالبَها الحُجْنا",47,"ن",2,0],["رآه سديداً من سهامِ كِفايةٍ","وعن ساعدٍ يَنْضو من الرأيِ مُستَدّ",48,"د",1,0],["رآه غَيورُ الحَيَ يَتْبَعُ ظَعْنَهم","فشَنَّ عليه الخيلَ خوفاً فَرَدَّه",49,"د",2,0],["رآها المجدُ أوَّل ما رآه","مبجَّلةً لها في الخير شانُ",50,"ن",1,0],["رآه بالمعاني ذا غرام","فناصحه يراعي والنظام",51,"م",1,0],["رآهُ اللَهَ لِلعَلياءِ أَهلاً","فَأَعلاهُ عَلى قِمَمِ الكِرامِ",52,"م",1,0],["رآها هذيم كأَنَّ الغرام","يقطّع بالوجد أوصالَها",53,"ل",3,0],["رآها قد أَضرَّ بها الكلال","وقد ساءَت لها يا سعد حال",54,"ل",1,1],["رآه مدحت الدنيا حُساماً","وقد يغنيه عن حمل الحسام",55,"م",1,0],["راهنَ في شوط الندى","جريَ الرياح فسبَقْ",56,"ق",1,0],["رآه أبوه وابن الليث شبل","لسَدَّةِ ثُغرةٍ وهو ابن مَهدِ",57,"د",1,0],["رآهُ أميرُ المؤمنينَ بعَيْنِهِ","من الأكرَمَيْنِ صَحَّةٍ ووَفاءِ",58,"ا",2,0],["رآهُ أميرُ المؤمنينَ مُهَنَّداً","يَقُدُّ به صِيدَ الرِّقابِ وينْثُرُ",59,"ر",1,0],["رآهُ لِلعُلى والمَجْدِ أهْلاً","فقدَّمهُ على الناسِ الإِمامُ",60,"م",1,0],["راها كصب حامل لمحبه","يحاول إسراعا فيخطو مرعشا",61,"ش",2,0],["رَآهُ أَكرَمَهُم في الخَيرِ إِن ذُكِروا","وَصفاً وَأَفضَلُهُم في القَولِ وَالعَمَلِ",62,"ل",1,0],["رآه موسى الكليم ناراً","عنه بدا الكل كالدخان",63,"ن",1,0],["رآه في كل ما رآه","فلم يقل بعده لعلِّي",64,"ل",2,0],["رآها لا تطيعُ لها أميراً","فخلاَّها تردَّدُ في خلاها",65,"ه",2,0],["رآه الغائبون بما تلقَّوا","من النجوى كأنهمُ حضور",66,"ر",1,0],["رآها المسلمون مؤكدات","لقرب مناهم المتوقعات",67,"ت",1,0],["رآهُ في المكرماتِ متبعاً","فكان أسنى مَن كان مِن تَبَعه",68,"ع",2,0],["رَآه يَوماً صاحب البُستانِ","فَمالَ للجَهلِ بِلا تَواني",69,"ي",1,0],["رَآه مَصلوباً فَراحَ مُسرِعا","وَأَخبر القَوم بِما قَد وَقَعا",70,"ع",2,0],["رَآه عَونٌ مِن ذكور الجنِّ","وَهوَ بِحُسن صَوتِهِ يُغني",71,"ي",1,0],["رَآه ضَيفاً فَشَكا عُدم القرى","إِذ لَم يَكُن شَيء هُناك ادُّخِرا",72,"ر",2,0],["رآها توقد في كأسها","فيممها يحسب النور نارا",73,"ر",2,0],["رَآهُ الغُصْنُ ثُمَّ سَهَا فَلِمْ لاَ","أتَى مِنْ بَعْدِ ذَلِكَ بِالسُّجُودِ",74,"د",1,0],["رَاهَنتُ قَومِى والرِّهَانُ لَجَاجَةٌ","أحمَى لِمُهرِى أَن يُسَبَّ وَأَرغَبُ",75,"ب",1,0],["رَأَهُ المَليك الشاه روحا إِلى الذَكا","وَلِلمَجدِ جِسماً فَاِصطَفاهُ سَفيرا",76,"ر",2,0],["رآهُ وهو يعطيها ريالاً","فإن يشهد فلم يشهد يزور",77,"ر",1,0],["رآه لما أولاهُ أهلاً فخاره","وليس له في العالمين مناظِرُ",78,"ر",1,0],["رآه حقا بعيني راسه ورأى","آياته حيث لا ستر ولا حجب",79,"ب",1,0],["رآه يسحب قلبي بالهوى فهوى","ليخطف القلب مني بالجناحين",80,"ن",1,0],["رآه الدهر أثبت منه جاشاً","فأقسم لا يعززه بثان",81,"ن",1,0],["رآه البدر أبهى منه وجهاً","فحول طرفه حسداً وراحا",82,"ح",2,0],["رآه صبا بنيل المجد ليس له","هم سوى أن يقيم الملك في مضر",83,"ر",1,0],["راهَنَتْ أوظافُهُ ألحاظَهُ","ثم جاءَا غايةَ السَّبْقِ معا",84,"ع",2,0],["رآه إله العرش أهلاً فمذ نشا","تولى رقاب المسلمين فولاه",85,"ا",2,0],["رآه المُستَعين لَها فَوافى","بِهِ مِنها عَلى أَعلى السَنام",86,"م",1,0],["رآهم يشربون الماء إن عطشوا","ويأكلون إذا جاعوا من الزاد",87,"د",1,0],["رَآهُ إِمامُ المُسلِمينَ لِعَهدِهِ","كَفِيّاً وَفيما قَد رَأى الحَزمُ وَالرُشدُ",88,"د",1,0],["رآه شيخٌ صدوقٌ من مشايخنا","فقال مسكنكم فقال تكريتُ",89,"ت",1,0],["رآه خير وليد يستجار به","وخير مستشهد في الدين يحميه",90,"ي",2,0],["رآه أجدر أن يرعى رعيته","وأن يقوم بما يرجوه راجيها",91,"ي",3,0],["رآه الوزير على غاية","من الفضل تعلو على الخنس",92,"س",1,0],["راهنتُهُ في قُبلةٍ يَشتفي","بها فؤادي من جوى الوَقدِ",93,"د",1,0],["رآه العرب منذ التح لغزا","فأمسى مغلقا هذي السنينا",94,"ن",2,0],["رآه على الثرى شلوا فنادى","وجاري دمع مقلته همول",95,"ل",1,0],["رآه الصيرفيّ فقال هذا","عيارُ من لجين في مَحكّ",96,"ك",1,0],["رأه بعين العقل لا عين رأسه","وشاهد نورا في ظلام الغياهب",97,"ب",1,0],["رآها الردى قبلَ وِرْدِ المياهِ","كرُوْعاً على حَوضِهِ تَزدَحِمْ",98,"م",1,0],["رآها تضاغي في الجبالِ وتجتوي","مباركُها بين التخمطِ والقَسرِ",99,"ر",1,0],["رآها تَعُلُّ النقعَ منه فخالَها","أَمامَ السَّواقى سُرَبةً وهي فيلَقُ",100,"ق",1,0],["رَآهُ الخديوي قَد تَحَلَّت صِفاتُه","بِخَلقِ حكى زَهر الرِياضِ أَنيقاً",101,"ق",2,0],["رَآهُ مَليكُ العَصرِ رَب دِرايَة","وَقد دَرَّبتَهُ في الامورِ التجارُب",102,"ب",1,0],["رَآهُ فُؤادي لاحَ كَالبَدرِ سافِراً","فَكادَ لِشَوقٍ ان يَذوب وَاِوشَكا",103,"ك",2,0],["رآه ممثلاً فيه ومنه","بغي ادركت اقصى مرام",104,"م",1,0],["رآه خضيباً بالدما فدعا ايا","سرور فؤادي من عليك تجاسرا",105,"ر",2,0],["رآه طَرفي عَلى طِرفٍ يَمرّ بِهِ","مِثل السَحابة تَحتَ البَدر في الأُفق",106,"ق",1,1],["رَآها وَما شَبَت فَشابَت قُرونه","وَما اتقدمت فَانقاد وَهُوَ صَغير",107,"ر",1,0],["رآه الوزير الراعفات سيوفه","وما كملث سح من عارض ساري",108,"ر",2,0],["رَآهُ الرَّدى حصناً يَقي الناس غَدرَهُ","فَكادَ لَهُ كَيداً أفاقَ لَهُ الحِقدُ",109,"د",1,0],["رَآهُ فَلَم يُسلِم هَواهُ لِشَركَةٍ","وَأَربى عَلَيهِ ما جَلاهُ 