{"poems":[[53,"ولولا هناة والهناة معاذر","https://www.aldiwan.net/poem30412.html","الطويل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[71,"وما أنثى وينكحها أخوها","https://www.aldiwan.net/poem3855.html","الوافر"],[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[88,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[51,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[26,"أساءلت رسم الدار أم لم تسائل","https://www.aldiwan.net/poem24083.html","الطويل"],[91,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[61,"قامت تثنى بين أترابها","https://www.aldiwan.net/poem51739.html","السريع"],[66,"شربنا سلافا بلا آنيه","https://www.aldiwan.net/poem38521.html","المتقارب"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[69,"أحب لوجنتيه الجمرتين","https://www.aldiwan.net/poem28936.html","الوافر"],[105,"أأنت يا ابن رزام تغلب القدرا","https://www.aldiwan.net/poem43581.html","البسيط"],[105,"إلى العزى فقد بلغت مداها","https://www.aldiwan.net/poem44038.html","الوافر"],[40,"تطاول أيامي وليلي أطول","https://www.aldiwan.net/poem42283.html","الطويل"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"لعمرك ما زوج الفتاة بحازم","https://www.aldiwan.net/poem23603.html","الطويل"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54879","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[100,"راهب الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50160",""],[88,"لقد طوَّحتني في البلادُ مُضاعَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19522&r=&rc=25",""],[143,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[143,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[150,"ألا قل للثقاة السامعين","https://www.aldiwan.net/poem68502.html","الوافر"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[231,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[235,"أثقل ظهري بالمنن","https://www.aldiwan.net/poem31740.html","مجزوء الرجز"],[235,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[235,"يا صاحبي لمن هذه","https://www.aldiwan.net/poem32116.html","المجتث"],[282,"ألي من جفون الغانيات مجير","https://www.aldiwan.net/poem32787.html","الطويل"],[305,"رآه طرفي على طرف يمر به","https://www.aldiwan.net/poem56440.html","البسيط"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[348,"وجارية ظنناها غلاما","https://www.aldiwan.net/poem20185.html","الوافر"],[349,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[364,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[364,"أضم على قلبي يدي من الوجد","https://www.aldiwan.net/poem60941.html","الطويل"],[364,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[400,"أمام حجرة عائشة رضي الله عنها","https://www.aldiwan.net/poem6772.html","عموديه"],[403,"ترفق بالمعنى يا غرام","https://www.aldiwan.net/poem33423.html","الوافر"],[406,"بعثن غداة تقويض الخيام","https://www.aldiwan.net/poem50124.html","الوافر"],[416,"أقول لها يوم جدت بنا","https://www.aldiwan.net/poem53955.html","المتقارب"],[416,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[416,"ألا من مبلغ عني سلامي","https://www.aldiwan.net/poem54135.html","الوافر"],[458,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[458,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[461,"لتهن قصور المجد زيدت جلالة","https://www.aldiwan.net/poem16249.html","الطويل"],[461,"تبلج دين الله في كل خطة","https://www.aldiwan.net/poem16263.html","الطويل"],[461,"تميس الدولة الغراء تيها","https://www.aldiwan.net/poem16383.html","الوافر"],[479,"وذات محيا يخلق الله ما يشا","https://www.aldiwan.net/poem36913.html","الطويل"],[493,"كأنما ادخر الرحمن معظمة","https://www.aldiwan.net/poem67336.html","البسيط"],[558,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[558,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"]],"verses":[["رَآها عَلى عِلّاتِها ظَهرَ صَعبَةٍ","تَحادَرُ مِن إِرقاصِها وَتُحاذِرُ",0,"ر",1,0],["رآه مُستَغرقاً في نَومِه فَرأى","فيه الجَلالَة في أسمَى مَعانيها",1,"ي",3,0],["رَآهُ مَعشَرٌ مِنّا مُباحاً","وَفي أَعناقِهِم ذاكَ النِكاحُ",2,"ح",1,0],["رَآهُ اللَهُ أَجوَدَ بِالعَطايا","وَأَطعَنَ بِالمَكايِدِ وَالرِماحِ",3,"ح",1,0],["رآهم عبيداً فاستبدّ بمائه","ولم يَجْر بين المُجْدِباتِ مُشاعا",4,"ع",2,0],["رآه أبو العباس أَقومَ قائمٍ","بأعماله عند امتحانِ كُفاتِهِ",5,"ت",2,0],["رَآهُ رَضِيعاً كلُّ مَاضِي بَصِيرَةٍ","فقالُوا جميعاً قُنَّةٌ ستُطوَّدُ",6,"د",1,0],["رَآها الفُؤادُ فَاِستُضِلَّ ضَلالُهُ","نِيافاً مِنَ البيضِ الحِسانِ العَطابِلِ",7,"ل",1,0],["رَآها يَحُلُّ الفَجرُ عَقدَ جُفونِها","وَيُلقي عَلَيها تِبرَهُ فَيَذوبُ",8,"ب",1,0],["راهِبٌ في الضُلوعِ لِلسُفنِ فَطنُ","كُلَّما ثُرنَ شاعَهُنَّ بِنَقسِ",9,"س",1,0],["راهبةٌ للهِ في نُسوَةٍ","قد أُلبِسَتْ قُضْبَ اللُّجَينِ المُسُوحُ",10,"ح",1,0],["رَآها أُناسٌ","بِعَينِ القُلوبِ",11,"ب",1,0],["رَآهُ العِلجُ مُقتَحِماً عَلَيهِ","كَما اِقتَحَمَ الفَناءُ عَلى الخُلودِ",12,"د",1,0],["رآهُ مجرَّداً يوماً عذولي","فما عَرَفَ النضارَ من اللجينِ",13,"ن",1,0],["رَآهُ أَخْوَنَ مِن ذئبٍ فَعاجَلَهُ","بالسَّيفِ يُوردُه مِنه دماً هَدَرا",14,"ر",2,0],["رآه وَلِيُّهُ كَذِباً فَوَلَّى","يُسائِلُ نفسَهُ ماذا عَرَاها",15,"ا",3,0],["رَآها نِعمَ الخَدينُ فَلَم يَزَل","لِحاجاتِها ما لَم تَحُل يَتَحَمَّلُ",16,"ل",1,0],["رآه أميرُ المؤمنين كعهدِهِ","تشبُّ لَظى الهيجاء ألفَحَ ألفَحا",17,"ح",2,0],["رَآها كِباراً مَن بَراها كَأَنَّها","تَريكُ نَعامٍ أَودَعَتهُ الصَرائِمُ",18,"م",1,0],["رَآهُم عَلى ما يَكرَهُ الناسَ رَبُّهُم","وَعُذتُ بِهِ فيما تَمَنَّوا وَما مَنَّوا",19,"ن",3,0],["رآها سليلُ الطّينِ والشّيبُ شامِلٌ","لها بالثّرَيّا والسّماكَينِ والوَزْنِ",20,"ن",1,0],["رآها عَلى وجه الفراش كأنها","عروس هوت كسلانة فَهي تهجع",21,"ع",1,0],["رآها على النبع بعضُ الرُّعاةِ","مصوَّرةً في إطار الغصونْ",22,"ن",1,0],["رآها فجنَّ غراماً بها","وغنَّى بها الليلَ بعد النهارْ",22,"ر",1,0],["رآهُ كَهْلانُ مِن مَعَاقِلِهِ","في الحَرْبِ دونَ العَبيدِ والحَشَم",23,"م",1,0],["رَآهُ فِيهِ صَامِتاً مُوحَشاً","كَمَا يَكونُ الحُرُّ مُسْتَأْسرَا",24,"ر",2,0],["رَآهَا فتى خَالٍ فَمَلَّكَ حُسْنَها","قِيَادَ الْهَوَى فِي قَلْبِهِ المُتَوَزِّعِ",25,"ع",1,0],["رآهَا وفي العنقودِ والكرم ما اشْتهَى","وأيْنَ من العنقُودِ أيدِي الثعالبِ",26,"ب",1,0],["رآه الصبحُ منه فزاد حسناً","وغار البدرُ منه فزاد سُهدا",27,"د",2,0],["رآهُ سَلِيلُ الطّينِ يَجْتَابُ لَيْلَه","فَهَلْ هَدَأَتْ دُون المَسِيرِ جَوائِبُه",28,"ب",2,0],["رآها آدمٌ وَعَدَتْ بنُوحٍ","وولَّى بعدَها نَسْلٌ ونسل",29,"ل",1,0],["راهِبٌ خطَّ في القُرى محرابَهْ","بين شطِّ الغَدير واللَّبْلابَهْ",30,"ب",2,1],["راهب الفنّ صدره","للصبابات مزدحم",31,"م",1,0],["رآهم عبيداً فاستبد بمائه","جرى شاكراً صنعَ الطبيعة إنها",32,"ا",1,0],["رَآهُ بِعَينِ الفِكرِ قَبلَ وُقوعِهِ","فَصادَفَ مِنهُ قُلَّبَ الرَأيِ حُوَّلا",33,"ل",2,0],["رَآها الأَقرَبونَ فَأَعظَموها","وَسارَ حَديثُها في الأَبعَدينا",34,"ن",2,0],["رآه الله أطهرهم ضميراً","فقلّد جيده العلق الثمينا",35,"ن",2,0],["رَآها كعقدٍ زيّن العصرَ حسنهُ","فَيا حُسنها عقداً ويا قبحهُ عَصرا",36,"ر",2,0],["رأه بحيرا والغمامة فوقه","ومسيرةٌ والحرّ للوجه يسفع",37,"ع",1,0],["راهِنَةٍ شُكري بِها","إِلى المَماتِ مُرتَهَن",38,"ن",1,0],["رَآهُ أَميرُ المُؤمِنينَ لِدائِها","وَقَد أَعضَلَت أَدواؤُها خَيرَ حاسِمِ",39,"م",1,0],["رَآهُ أَبقى عِتادٍ","وَالمالُ غادٍ وَرائِح",40,"ح",1,0],["رَآها عَذولي فَاِنثَنى وَهوَ عاذِري","فَحَسبي عَذولٌ راحَ وَهوَ عَذيرُ",41,"ر",1,0],["رَآهُ طَرفي عَلى طرفٍ يمرّ بهِ","فَشنَّ غارةَ دمعٍ منهُ مُنسفكِ",42,"ك",1,1],["رَآه يعدّ الحربَ سلماً شهامة","وَيَحسب حزماً أنّ في الهدنةِ الحربا",43,"ب",2,0],["رَآهَا الشَّيْخُ فَانْبَعَثتْ قُواهُ","وَبُشِّرَ بِالشَّبابِ المُسْتَجَدِّ",44,"د",1,0],["راهِبٌ كِالبَدرِ في البِر","نُسِ مِنهُ الوَجهُ يَبدو",45,"د",2,0],["رآه معَ الإصباحِ في كَفِّ جارحٍ","وقد أنشبَتْ فيه مَخالبَها الحُجْنا",46,"ن",2,0],["رآه سديداً من سهامِ كِفايةٍ","وعن ساعدٍ يَنْضو من الرأيِ مُستَدّ",47,"د",1,0],["رآه غَيورُ الحَيَ يَتْبَعُ ظَعْنَهم","فشَنَّ عليه الخيلَ خوفاً فَرَدَّه",48,"د",2,0],["رآها المجدُ أوَّل ما رآه","مبجَّلةً لها في الخير شانُ",49,"ن",1,0],["رآه بالمعاني ذا غرام","فناصحه يراعي والنظام",50,"م",1,0],["رآهُ اللَهَ لِلعَلياءِ أَهلاً","فَأَعلاهُ عَلى قِمَمِ الكِرامِ",51,"م",1,0],["رآها هذيم كأَنَّ الغرام","يقطّع بالوجد أوصالَها",52,"ل",3,0],["رآها قد أَضرَّ بها الكلال","وقد ساءَت لها يا سعد حال",53,"ل",1,1],["رآه مدحت الدنيا حُساماً","وقد يغنيه عن حمل الحسام",54,"م",1,0],["راهنَ في شوط الندى","جريَ الرياح فسبَقْ",55,"ق",1,0],["رآه أبوه وابن الليث شبل","لسَدَّةِ ثُغرةٍ وهو ابن مَهدِ",56,"د",1,0],["رآهُ أميرُ المؤمنينَ بعَيْنِهِ","من الأكرَمَيْنِ صَحَّةٍ ووَفاءِ",57,"ا",2,0],["رآهُ أميرُ المؤمنينَ مُهَنَّداً","يَقُدُّ به صِيدَ الرِّقابِ وينْثُرُ",58,"ر",1,0],["رآهُ لِلعُلى والمَجْدِ أهْلاً","فقدَّمهُ على الناسِ الإِمامُ",59,"م",1,0],["راها كصب حامل لمحبه","يحاول إسراعا فيخطو مرعشا",60,"ش",2,0],["رَآهُ أَكرَمَهُم في الخَيرِ إِن ذُكِروا","وَصفاً وَأَفضَلُهُم في القَولِ وَالعَمَلِ",61,"ل",1,0],["رآه موسى الكليم ناراً","عنه بدا الكل كالدخان",62,"ن",1,0],["رآه في كل ما رآه","فلم يقل بعده لعلِّي",63,"ي",1,0]]}