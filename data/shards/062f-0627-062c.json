{"poems":[[23,"لمن الدار أقفرت ببواط","https://www.aldiwan.net/poem21250.html","الخفيف"],[87,"لا السهد يطويه ولا الإغضاء","https://www.aldiwan.net/poem63686.html","الكامل"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[487,"وقد لاقيت من وقع سهمها","https://www.aldiwan.net/poem24490.html","عموديه"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106988","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99147","الكامل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146877","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101393","الكامل"]],"verses":[["داجِنٌ بِالطِرادِ يَرمي بِطَرفٍ","في فَضاءٍ وَفي صَحارٍ بَساطِ",0,"ط",1,0],["داجي عُبابِ الجُنحِ فَوضى فُلكُهُ","ما لِلهُمومِ وَلا لَها إِرساءُ",1,"ا",2,0],["داجٍ كَجُنحِ اللَيلِ زانَ جَبينُهُ","وَضَحٌ عَلَيهِ مِنَ الأَهِلَّةِ أَشرَقُ",2,"ق",1,0],["داجاهُ حيناً عَلَّهُ أَن يَرعَوي","فَأَبى وَمالَ إِلى الهِجَفِّ الجاسي",3,"س",2,0],["داجٍ وَيُشرِقُ مِن ضِياءِ حُجولِهِ","فَيَخالُهُ رائيهِ لَيلاً مُقمِرا",4,"ر",2,0],["داجانِيَ الكَلِمَ العِذابَ وكدَّني","وعداً تحنظلَ طعمُه ومِطالا",5,"ل",2,0],["داجمعا","علينا فصرنا في انتهاز المثاني",6,"ن",2,0],["داجي مشق المقلتين سرقت","منه ظباء وجرة إحورارها",7,"ر",3,0],["داجي الغيوم مطلخم ضمضم","مسَّهم مزهم مهمهم",8,"م",1,0],["داجي القناع كأن في إظلامه","إظلام يوم تفرّق وتغرب",9,"ب",1,0],["داج إذا زرت على جيوبه","كنت الحسام وكانت الأغمادا",10,"د",2,0],["داجي مشق الطرف الاَّ انَّ في","وجناته لسنا الصباح مخائلا",11,"ل",2,0]]}