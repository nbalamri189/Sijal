{"poems":[[64,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[54,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[353,"فضضت عن الدن مسك الختام","https://www.aldiwan.net/poem20680.html","المتقارب"],[447,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108541","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66559","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54448","المتقارب"],[4222,"عجبت من الموت كيف اهتدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52854&r=&rc=146",""]],"verses":[["وكيف ثَوائي بالعراق وقد غَدا","عليّ بها رَوْحُ النسيم عَذابَا",0,"ب",2,0],["وَكَيفَ ثَوائي بَينَ قَومٍ كَأَنَّما","تُرَضُّ تَحِيّاتي وُجوهَهُمُ رَضّا",1,"ض",2,0],["وَكَيْفَ ثُبُوتي علَى تَوْبَةٍ","وَقَد هَزَمَ الفِطْرُ شَهْرَ الصِّيامِ",2,"م",1,0],["وكيف ثنائي فيك واللَه بالثنا","عليك فقد أثنى وذاك هو الثنا",3,"ن",2,0],["وكيف ثنت عني ثناه نواظري","وكم نظرت فختاً وما أفل الفخت",4,"ت",1,0],["وَكَيْفَ ثَبَتَّ طَوْداً مُشْمَخِرّاً","وَأنتَ أَخَفُّ مِن أَسَدٍ جَرِيِّ",5,"ي",1,0],["وكيف ثَوَى الفَلَكُ المستدي","رُ في الأرضِ والأرضُ وسط الفَلَكْ",6,"ك",1,0],["وكيف ثوى الفلك المستدير","في الأرض الأرض وسط الفلك",7,"ك",1,0]]}