://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[5444,"راية الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=209112",""],[709,"أَمَا وَالْهَوَى لَوْلاَ الْجُفُونُ السَّوَاحِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=2923",""],[5829,"دنيا غرور","https://www.poetsgate.com/ViewPoem.aspx?id=178227",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[3984,"الذئاب الحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64417&r=&rc=23",""],[2220,"لطيبة َ ظبيٍ ظُبى صارمٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19315&r=&rc=857",""]],"verses":[["حَمَتهُ عَنّى المَخازي إِن أُعاقِبَهُ","كَذاكَ تُحمى لُحومُ الذَودِ بِالدَبَرِ",0,"ر",1,0],["حَمَتهُ مَذَلَّتُهُ سَطوَتي","وَكَيفَ يَنالُ ذُباباً ذُبابي",1,"ب",2,0],["حَمَتْهُ سُراةُ الحَيِّ غُنْمُ بنُ مالِكٍ","وإخوَتُها الشّمُّ العَرانينِ منْ فِهْرِ",2,"ر",1,0],["حَمَتْهَا النَّوَى قُرْبَ الْقَضِيمِ أَوِ النَّوَى","فَلَمْ تَبْقَ إِلاَّ جِلْدَةٌ تَحْتَهَا عَظْمُ",3,"م",1,0],["حَمَتهُ بَنو الرَبداءِ مِن آلِ يامِنٍ","بِأَسيافِهِم حَتّى أَقَرَّ وَأَوقَرا",4,"ر",2,0],["حَمَتني لِيَربوعٍ جِبالٌ حَصينَةٌ","وَيَزخَرُ دوني قُمقُمانٌ مِنَ البَحرِ",5,"ر",1,0],["حَمَت قَيسٌ بِدِجلَةَ عَسكَرَيها","فَأُنهِبَ يَومَ دِجلَةَ عَسكَراكا",6,"ك",2,0],["حَمَت كُلَّ وادٍ مِن تِحامَةَ وَاِحتَمَت","بِصُمِّ القَنا وَالمُرهَفاتِ البَواتِرِ",7,"ر",1,0],["حمت عقدةَ الإسلامِ بدءأً وعودةً","كتيبةُ ملكٍ منهمو وكتاب",8,"ب",1,0],["حمت وهمت فالناسُ ما بين هاجدٍ","أماناً وداعٍ في الدّجى متهجد",9,"د",1,0],["حمتْ ثغرها عن راشفٍ بلحاظِها","كذاك سيوف الهند تحمي حمى الثغر",10,"ر",1,0],["حمت من مواليكمُ خيرها","ولكنّها للأقاصي صوافي",11,"ف",2,0],["حَمتهُ عَن كُلِّ طَرفٍ فاسِقٍ غَزِلٍ","لَو اِستَطاعَت حَمتهُ الوَهم وَالفِكرا",12,"ر",2,0],["حُمتَ بِخَفّاقَة الجَناح وَقَد","أَمكَنَ وِردٌ فَلا يَطُل حَومُ",13,"م",1,1],["حَمَتهُ لُيوثٌ مِن حَديدٍ تَرَكَّزَت","عَلى عَجَلٍ وَاِستَجمَعَت تَتَرَقَّبُ",14,"ب",1,0],["حَمَتهُ عَلى الأَعداءِ مِن كُلِّ جانِبٍ","سُيوفُ بَني طُغجِ بنِ جُفِّ القَماقِمِ",15,"م",1,0],["حَمَتهُ الدَهاقينُ الرُبى وَتَسافَلَت","بِقُطرُبُّلٍ أَعلاجُهُ وَأَنابِطُه",16,"ط",2,0],["حَمَت قُضُبَ النَبعِ مِن أَن يَكونَ","صِلاءً صَلابَةُ عيدانِها",17,"ن",3,0],["حَمَتهُنَّ أَسيافٌ حِدادٌ ظُباتُها","وَمِن آلِ سَعدٍ دَعوَةٌ لَم تُهَلَّلِ",18,"ل",1,0],["حَمتْنا اللّيالي بعدَ ساكنةِ الحِمى","مشارِبَ يهوى كلُّ طامٍ شَرابَها",19,"ب",3,0],["حَمَتنا الطَيفَ مِن أُمِّ الوَليدِ","خُطوبٌ شَيَّبَت رَأسَ الوَليدِ",20,"د",1,0],["حَمَت وَمَن يَقعُدُ بِهِ جَدُّهُ","فَكُلُّ زِندٍ في يَدَيهِ شَحاح",21,"ح",1,0],["حَمَتِ الشُموسُ جَلالَهُ وَأَعَزَّهُ","مِن آلِ رَمسيسَ المُلوكُ الصيدُ",22,"د",1,0],["حَمَتني صَفِيَّةُالوَصلا","بِنَفسي نارَ الأَسى تَصلى",23,"ل",2,0],["حمَتْهُ القنا كيما يكون حقيقةً","فكان نذيراً من خطوبٍ وأهوالِ",24,"ل",1,0],["حَمتْ رِقَّةَ الجنسِ ربَّاتُهُ","فليس بها حاجةٌ للرجالْ",25,"ل",1,0],["حَمتكِ صدورُها يومَ التَّنادي","ووقَّتكِ الليالي وهي حَرْبُ",26,"ب",1,0],["حمت لنا حزرة لم تبق من خلد","بغير خالدة الأحزان منفعل",27,"ل",1,0],["حمَتْ قُضُبَ المَجدِ من أن تكون","صِلاءً صَلابَةُ عِيدانِهَا",28,"ن",3,0],["حمتهُ بنوا الربداء من آل يامن","بأسيافهم حتى أقر وأوقرا",29,"ر",2,0],["حَمَتِ الدينَ بِالتَلافي وَبِالقَه","رِ وَقَد كانَ عُرضَةً لِلتَلافِ",30,"ف",1,0],["حَمَت دارَها بِالسَّيفِ ضَرباً فَلَم يَرُم","حِماها وَجَلّى القَومَ عَنها ضِرابُها",31,"ب",3,0],["حَمَت ما بَينَ حَرَّةِ فَرعِ قَيسٍ","إِلَى الأًفراطِ إِلاّ الصّائِفِينَا",32,"ن",2,0],["حَمتْ عقربٌ من صدغه وردَ خَده","فيلدغُ من أبْدَى له لحظَ قاطِف",33,"ف",1,0],["حَمَتهُ صَوارِمُ أَلحاظِهِ","فَأَصبَحَ وَالثَغرُ مِن فيهِ ثَغرُ",34,"ر",1,0],["حمته عَن التَوديع زرق اسنة","تَكاد تذيب الصخر وَهو صَليب",35,"ب",1,0],["حَمَت عَقرَبُ الصُدغِ تُفّاحَ وَج","نَتَيهِ فَوا كَبِدي مَن حَماها",36,"ا",3,0],["حَمَتهُ مِن الصادي فَلَيسَ تُنيلُهُ","وَإِن ماتَ ما غَنّى الحَمامُ المُطَوَّقُ",37,"ق",1,0],["حَمُ تَنزيلُ الكِتابِ رِقُّهُ ال","مَنشورُ في طَيِّ الدُجى الَّذي اِنتَشَر",38,"ر",1,0],["حَمَت سِرَّها سُمُرُ الرِماحِ وَحَجَبَت","بِها البيضَ بيضٌ مِن نُمَيرٍ قَواطِعُ",39,"ع",1,0],["حُمَّت بِكَ الناس فَاِستَسقيتها عرق ال","حُمّى وَقُلت شِفاء الداء بِالداءِ",40,"ا",2,0],["حَمَتها بَنو سَعدٍ وَحَدُّ رِماحِهِم","وَأَخلى لَها بِالجِزعِ قُفٌّ وَأَجرَعُ",41,"ع",1,0],["حمت فيه أفنان الأراكة طائراً","يغرد في أغصانها ويهرج",42,"ج",1,0],["حمتها رماح الحرب حتى تهولت","بزاهر نور مثل وشي النمارِق",43,"ق",1,0],["حَمَتْهَا النِّصالُ بأيْدي الرّجالِ","وبيضً الظُّبى والقَنَا الشُرَّعُ",44,"ع",1,0],["حمت الليوثُ عن الشبول وجرجرتْ","دونَ البِكارِ مَصاعبٌ وقُرومُ",45,"م",1,0],["حمتهُ الرماحُ والحصانة أن تُرى","مَصاونه أو أن ترام مَباذلُهْ",46,"ل",2,0],["حمتها أن أزورَ نوىً شَطُونٌ","براكبها ورامحةٌ شَبوبُ",47,"ب",1,0],["حمتهُ فحالت دونهُ قسوريَّةٌ","من العزِّ لا تُعْلى ولا تُتوقَّلُ",48,"ل",1,0],["حمت وردها بالنرجس الغض وانثنت","تدافع عنه كل راء ولاثم",49,"م",1,0],["حمت عليَّ الشعر مذ أعوز","الأجيادُ حاشاك وعزَّ الملاحْ",50,"ح",1,0],["حمتهُمُ بالأَسَلِ","المثقفاتِ المُلْدِ",51,"د",1,0],["حمتُهنَّ الُكماةُ الشُّوسُ حفت","بأظعنهِنَّ والسُّمْرُ اللِّدانُ",52,"ن",1,0],["حمَتْهُ بطَعْناتِ الخواطرِ دونَه","قُدودُ الغَواني والرِّماحُ الخواطِرُ",53,"ر",1,0],["حمَتْهُ سَراةٌ لا تزالُ رُماتُهم","مفوّقةً للحَتفِ هُدْباً وأسهُما",54,"م",2,0],["حَمَتْهُ اللّيالي عَن مُطالَبةِ الرّدى","وَلَم أَدرِ أَنَّ الدّهرَ يَجعلهُ نَهبْا",55,"ب",2,0],["حَمت أَكنافَهُ من كل غِرٍّ","غبيٍّ لم تثقّفهُ العلومُ",56,"م",1,0],["حمتني البراغيثُ طيبَ الكرى","فليس يطوفُ الكرى بالمآقي",57,"ق",2,1],["حَمَتْهُ من الفراتِ حما","تُهُمْ بالبيض والحَجَف",58,"ف",1,0],["حمتْها سادةٌ أُسُدٌ","كرام من بني نصر",59,"ر",1,0],["حمت بردا وبرد لمى عليه","من العفاف أفئد ة قلوب",60,"ب",1,0],["حَمَتْ حُسْنَها عَيْنٌ لها مازِيِنَّةٌ","فَلَمْ تَسْتَبِحْها مقْلَةٌ مِنْ بَني ذُهْلِ",61,"ل",1,0],["حمته الدّموعُ لذيذَ الهُجوع","طوى في الضلوع كنارِ الزَّنادِ",62,"د",1,0],["حمت ورد خديها وخمر رضابها","ببيض من الأجفان حدت وسلت",63,"ت",1,0],["حمت خدرَها يقضى وودَّت بنومها","تردَّ عليها جفنها لا على الكرى",64,"ر",2,0],["حُمَّت على غِرَّةٍ مِنّي وقَد جَلَبَت","يا عاذِلَيَّ حمامي لا تلوماني",65,"ي",1,0],["حمت في المحيَّا الثغرَ وهيَ فواتر","وكم قد شفى من غلةٍ باردُ الثغر",66,"ر",1,0],["حمت لديك حمام الوحش جاثمةً","كيدا لكلّ غويّ القلب مختبِل",67,"ل",1,0],["حمت بيضة الإسلام فيه عصابةً","حداهم له عهد قديم ومألف",68,"ف",1,0],["حَمَتهُ سَراةُ الأزدِ آسادَ غَيلَةٍ","لها البِيضُ أنيَابٌ وسُمرُ القَنَا ظُفرُ",69,"ر",1,0],["حَمَتني عَن حُميّا الكأسِ نَفسٌ","إِلى غَيرِ المَعالي لن تَتوقا",70,"ق",2,0],["حُمَّت لِيَدخُلَ جَنّاتٍ أَبو حَسَنٍ","وَأَوجَبَت بَعدَهُ لِلقاتِلِ النارُ",71,"ر",1,0],["حَمَتْ جَارَه من أن يضام حميّةٌ","أرتنا صروف الدهر كيف تصرع",72,"ع",1,0],["حَمَت بِالحِمى وَلَوَت بِاللَوى","كَعَطفَةِ جارِحِها الكاسِرِ",73,"ر",1,0],["حمت الشَريعة في ظباً هندية","تَسقى بِمنهل النَجيع صقالَها",74,"ل",3,0],["حَمتك عَن العُشاق أَمنع شوكة","مِن الحُسن لا تلوي وَلا تتقصف",75,"ف",1,0],["حُمَّتِ الدنيا من الغيظِ على","ساكنيها فاعتراها النافِضُ",76,"ض",1,0],["حمت ثغره الألمي عقارب صدغه","فيا ويل من يدنو لحامية الثغر",77,"ر",1,0],["حَمَتهُ رِماحُ الحَربِ وَالأَرضُ حَولَهُ","أَماليسُ خِدمات المَراتِعِ سَملَقُ",78,"ق",1,0],["حمت حول الحمى وأنت بمرأى","من سعاد ومسمع لا تخافي",79,"ف",2,0],["حمت السمر فيه والبيض فتكا","بهما سطوة المحامي العزيز",80,"ز",1,0],["حمت في الجو فألفيت الرفاق","جوقة من عندليب وهزار",81,"ر",1,0],["حمته بِأَشفار الصَوارم غلمة","لَهم عِن سوى حفظ الذمار فطام",82,"م",1,0],["حمت ورد خديها عقارب صدغها","على عاشقيها ان يثم ويلثما",83,"م",2,0],["حمتك يد المولى وكنت بها أولى","فيا لك من شيخ حمته يد المولى",84,"ل",2,1],["حَمَتْ جنبَه الأفكارُ عن كلِّ مرقدٍ","فليس ينامُ الليلَ والخَلقُ نائِمُ",85,"م",1,0],["حَمَتهُ العَشاءَ لَيلَةُ ذاتُ قِرَّةٍ","بِوَعساء رَملٍ أَو بِحَزنانَ خالِيا",86,"ي",2,0],["حمت ورد خديها أفاعي جعودها","وما كان إلا عقرب الصدغ من عين",87,"ن",1,0],["حمته بسمر الخط والبيض قومه","بذب كذب النحل من دون شهده",88,"د",2,0],["حمتهُ علينا وهي ناجت حبيبها","حبيبي ما حسني عليك محرما",89,"م",2,0],["حمته اللحاظ البابليات فاغتدى","يجور على العشاق طورا ويصفح",90,"ح",1,0],["حُمَّتِ السُّحبُ مِن زَفيرِ البَرايا","بَينَ حُرٍّ وَحُرَّةٍ وَموالي",91,"ل",2,0],["حَمَتْ مُقْلَتاهُ رِياضَ الخُدودِ","فَما يَجْتَنِي النَّاسُ أَثْمارَهَا",92,"ر",3,0],["حمته جنابتها عن دخُولٍ","لحضرةِ ملكٍ سناها برق",93,"ق",1,0],["حَمَتها رِماحُ الحَربِ وَاِعتَمَّ نُبتُها","وَأَعشَبَ ميثُ الجانِبَينِ الرَوائِسُ",94,"س",1,0],["حَمَتني شيبان والحيّ تغلبٌ","بقبّ المذاكي والسيوف القواضبِ",95,"ب",1,0],["حَمَتني مِنها كُلُّ عَنقاءَ عَيطَلٍ","وَكُلُّ صَفا جَمِّ القِلاتِ كَؤودِ",96,"د",1,0],["حَمَتنَا الحمُيَّا بأَنوارِها","ودارَت عليَنا بِأدوارِها",97,"ر",3,1],["حمت رشفهُ ظبيةٌ كالهِلالِ","جَبيناً ووجهاص وكَالغُصنِ قداَّ",98,"د",2,0],["حَمت وردَ خديها الجفونُ الفواتر","فما هي إلا المُرهفاتُ البَواتر",99,"ر",1,1],["حمت بيضة الاسلام أحضان رفقه","فلم تخش ما دامت باحضانه كسرا",100,"ر",2,0],["حمتني لذتي رتب المعالي","وضني بالمروءة والوقار",101,"ر",1,1],["حمتها أن أوزرَ نوى ً شطونٌ","براكبها ورامحة ٌ شبوبُ",102,"ب",1,0],["حمت الهدى حتى أسال لها القضا","مهجا على أسل القنا العسال",103,"ل",1,0],["حمتنا إلى حمى من غدونا","بهداه بين الورى خير أمه",104,"م",2,0],["حَمَتْ الذُّرى في قلعةِ الآساد","أَجْرَت نَدى بمواردِ الإمداد",105,"د",1,0],["حمتهُ بطعناتِ الخواطرِ دونهُ","قددُ الغوانيْ والرّماحُ الخواطرُ",106,"ر",1,0],["حمّت الأنواء حولي واستبدت","حيثما أجرِ. فتجرِ من ورائي",107,"ا",3,0],["حمتها ولولا خيفة البيض والقنا","عليها لضمتها مكان الضمائر",108,"ر",1,0],["حُمّت سراياك فاشربْ من سرايانا","كأساً جَرَعت بها للذلّ ألوانا",109,"ن",2,1],["حمتْ بالحمى ولوتْ باللِّوى","لعطفة ِ جارحها الكاسرِ",110,"ر",1,0]]}