ينٍ وَهادِيا",0,"ي",2,0],["أَيا عِمدَةَ المُلكِ لا اِستُهدِمَت","ذُراهُ وَأَنتَ لَها اليَومَ باني",1,"ن",2,0],["أَيَا عَقِدات الرَّمْلِ مِنْ أَرْضِ كُوفَنٍ","سَقَاكُنَّ رَجَّافُ العَشِّي هَتونُ",2,"ن",1,1],["أَيا عَلَمَ السَعدِيِّ هَل أَنا راجِعٌ","وَأَنظُرُ في قُطرَيكَ زَهرَ الأَراجِعِ",3,"ع",1,0],["أَيا عِزِّنا لا عِزَّ في الناسِ مِثلُهُ","عَلى عَهدِ ذي القَرنَينِ لَن يَتَهَدَّما",4,"م",2,0],["أيَا عُمَرَ الْعَدْلِ الَّذِي مَطَل الْمَدَى","بِوَعْدِ الْهُدَى حَتَّى وَفَيْتُ بِدَيْنِهِ",5,"ن",2,1],["أَيَا عَبْدَ الْعَزِيزِ يَعِزُّ صَبْرِي","عَلَيْكَ فَإِنَّهُ صَعْبُ الْمَرَامِ",6,"م",1,0],["أيا عابِدَ النّاسوت إنّا عِصابةً","أتَيْنا لتَثْليثِ بَلَى ولتَسْديسِ",7,"س",1,0],["أيا عبْدَ شمْسٍ هلْ لكَ اليوم قُدْرَةٌ","على سَطْوَةِ السّفّاحِ منْ آلِ عبّاسِ",8,"س",1,0],["أَيا عالِماً فاقَ الأَنامَ بِعِلمِهِ","وَأَبدى خَفِيّاتِ الرُموزِ بِفهمِهِ",9,"م",2,1],["أَيا عَزَّ صادي القَلبَ حَتّى يَوَدَّني","فُؤادُكِ أَو رُدّي عَلَيَّ فُؤادِيا",10,"ي",2,0],["أَيا عَزَّ لَو أَشكو الَّذي قَد أَصابَني","إِلى مَيِّتٍ في قَبرِهِ لَبَكى لِيا",10,"ي",2,0],["أَيا عَزَّ لَو أَشكو الَّذي قَد أَصابَني","إِلى راهِبٍ في ديرِهِ لَرَثى لِيا",10,"ي",2,0],["أَيا عَزَّ لَو أَشكو الَّذي قَد أَصابَني","إِلى جَبَلٍ صَعبِ الذُرى لا نحَنى لِيا",10,"ي",2,0],["أَيا عَينَيَّ وَيحَكُما اِستَهِلّا","بِدَمعٍ غَيرِ مَنزورٍ وَعُلّا",11,"ل",2,1],["أَيا عَجَباً مِنهُم يُسَمّونَكَ الرِضا","وَتَلقاكَ مِنهُم كَلحَةٌ وَغُضونُ",12,"ن",1,0],["أيا عِلية الكتاب دعوةَ مُنصفٍ","عليكم بكم في مقطع الحق يستعدي",13,"د",2,1],["أَيا عَجَباً لِأَمرِ بَني قُشَيرٍ","أَراعونا وَقالوا القَومُ قُلُّ",14,"ل",1,1],["أَيا عاتِباً لا أَحمِلُ الدَهرَ عَتبَهُ","عَلَيَّ وَلا عِندي لِأَنعُمِهِ جَحدُ",15,"د",1,1],["أى أعواد منبر لم تطأها","واسع الخطو في عنان خطابك",16,"ك",1,0],["أَيا عَجَباً لِلدَهرِ لا بَل لِرَيبِهِ","تَخَرَّمَ رَيبُ الدَهرِ كُلَّ إِخاءِ",17,"ا",2,0],["أَيا عَجَبَ الدُنيا لِعَينٍ تَعَجَّبَت","وَيا زَهرَةَ الأَيّامِ كَيفَ تَقَلَّبَت",18,"ت",1,1],["أَيا عَينُ كَم حَسَّنتِ لي مِن قَبيحَةٍ","وَما كُلُّ ما تَستَحسِنينَ بِذي حُسنِ",19,"ن",1,0],["أَيا عَجَباً مِن ذَوي الإِعتِبا","رِ ما مِنهُمُ اليَومَ مُستَنبِهُ",20,"ه",1,0],["أَيا عَجَباً لِلناسِ في طولِ ما سَهَوا","وَفي طولِ ما اغتَرّوا وَفي طولِ ما لَهَوا",21,"و",2,1],["أيا عائبي الخرساءِ كفُّوا فلحظُها","هوَ السيفُ لا بلْ كالأسودِ الغوالبِ",22,"ب",1,1],["أيا عَلْو دمعُ العينِ يغني عن الورد","وبحرُ غرامي مالَهُ فيكَ مِنْ حدِّ",23,"د",1,1],["أيا عَلْوَ لي ودٌّ كوجهِكِ في السنا","ولكنَّ حظي مثلُ فاحمِكِ الجعْدِ",23,"د",1,0],["أيا عامَنا لا كنتَ عاماً","فمثلُكَ ما مضى في الدهر عامُ",24,"م",1,0],["أَيا عَمروُ كَم مِن مُهرَةٍ عَرَبِيَّةٍ","مِنَ الناسِ قَد بُليَت بِوَغدٍ يَقودُها",25,"د",3,1],["أَيا عِلَّةَ العَقلِ الحَصيفِ وَصَبوَةَ ال","عَفيفِ وَغَبنَ الناسِكِ المُتَعَبِّدِ",26,"د",1,0],["أَيا عَينِ قَد أَشقَيتِني وَشَقيتِ","أَحَقّاً رَأَيتِ المَوتَ ثُمَّ بَقيتِ",27,"ت",1,1],["أيا عَيْنُ بَكّي تَوْبَةَ بن حُمَيِّرِ","بسَحٍّ كَفَيْضِ الجَدْوَلِ المُتَفَجّرِ",28,"ر",1,1],["أَيا عَبلَ لَو أَنَّ الخَيالَ يَزورُني","عَلى كُلِّ شَهرٍ مَرَّةً لَكَفاني",29,"ن",2,0],["أَيا عَبلَ مُنّي بِطَيفِ الخَيالِ","عَلى المُستَهامِ وَطيبِ الرُقادِ",30,"د",1,0],["أَيا عَبلَ ما كُنتُ لَولا هَواكِ","قَليلَ الصَديقِ كَثيرَ الأَعادي",30,"د",2,0],["أيا عَيْنُ جُودِي ولا تَبْخُلِي","بدمعِكِ حَقّاً ولا تَنزُري",31,"ر",2,1],["أَيا عَبدَ الغنيّ أَنا","بِذِكرِكَ مولعٌ لَهِجُ",32,"ج",1,0],["أَيا عَبدَ الغنيّ اِشفَع غَداً لي","لِيَصفَحَ عَنّي الرَبّ الصَفوحُ",33,"ح",1,0],["أياعين بكي توبة ابن حمير","بسح كفيض الجدول المتفجرِ",34,"ر",1,1],["أيَا عجبَا للدهرِ لاَ بَلْ لريبِهِ","يخرِّمُ رَيْبُ الدَّهْرِ كُلَّ إخَاءِ",35,"ا",2,0],["أيا عناقيد الزجاج.. حسبي","لي تحت تصفيق الرداء.. ضِلْعُ",36,"ع",1,0],["أيا عتب ما يضر","ك أن تطلقي صفادى",37,"د",2,1],["أيا عينُ جودى بالدموعِ السواجمِ","فإن عليكَ الحزنَ ضربةُ لازمِ",38,"م",1,1],["أيا عصبةً قاموا بمسجدِ ربِّهم","فإن شاءَ يؤتيهم نصيبْينِ في غدِ",39,"د",1,0],["أيَا عَينَ السَّلاَمَةِ لاَ تَنَامِى","فَقَد أيقَظتِ نُوَّامَ الأنَامِ",40,"م",1,1],["أيَا عابدَ الرحمنِ لازلتَ تَرتَدِي","ملابسَ غُرِّ كلهن قَشِيُب",41,"ب",1,0],["أيا عاصي النصيحة والوصاة","مقيماً بين هاك وبين هاتِ",42,"ت",1,1],["أيا عضدي في النائبات وساعدي","ومعتمدي فيما عراني ثَقلِهُ",43,"ل",2,0],["أَيا عَمُّ لا تَجزَع فَكُلٌّ إِلى البِلى","يَصيرُ وَلا خُلدٌ لِإِنسٍ وَلا جانِ",44,"ن",1,0],["أيا عمّون قلبي عَمِّديني","وصُبّي سَلْسَبيلَك في يَبابي",45,"ب",2,0],["أَيا عُقلاء الناسِ هل ثمّ عاقلٌ","عَلى أنفسِ الياقوت قد فضّلَ الصخرا",46,"ر",2,0],["أيا عاذلي في العشق ذُقْ مِنهُ جَرْعةً","وعَنِّفني عن حُبِّها وَهُداها",47,"ا",3,0],["أيا عاذلي عز السلو فخلني","أقلب قلبي في هواه على الجمر",48,"ر",1,0],["أَيّا عَضُدَ الدينِ يا مَن غَدا","لِأَرزاقِنا ضامِناً كافِلا",49,"ل",2,1],["أَياعَضُدَ الدينِ شَكوى فَتىً","عَلى دَهرِهِ واجِدٍ عاتِبِ",50,"ب",1,1],["أَيَا عَلَماً مَا إِنْ يُضَامُ نَزِيلُهُ","وَمَا إِنْ يُرَى مِنْ دَهْرِهِ أَبَداً وَشْزَا",51,"ز",2,0],["أيا عربيةَ الغزلانِ أصغي","إِلى عربيِّ فتيانٍ دعاك",52,"ك",1,0],["أيا عجباً من صابرٍ صامت ولم","يفه بكلام قط في ساعةِ الضربِ",53,"ب",1,1],["أَيا عاذِلي ما لي وَللعذلِ فيهمُ","فَهل لكَ في السلمِ الّذي هو أسلمُ",54,"م",1,0],["أَيا عَبدَ الحَليمِ إِلَيكَ بُشرى","بِها طَيرُ السُرورِ غَدا يَحومُ",55,"م",1,1],["أَيا عَجَباً كَيفَ يَعصي الإِلَ","هَ أَم كَيفَ يَجحَدُهُ الجاحِدُ",56,"د",1,1],["أيا عَينَ الكمالِ ولا أُحابي","وقاك اللهُ من عَيْنِ الكَمال",57,"ل",1,0],["أَيُّ اِعتِزازٍ كانَ لِل","تَقوى وَأَيُّ يَدِ اِعتِزامِ",58,"م",1,0],["أيا عالماً فالعلمُ يَبغيكَ عاملاً","فما الفضلُ في علمٍ بدا غير نافع",59,"ع",1,0],["أيا عليا سما سامي العلى واتى","بالنصر مقتفيا آيات ياسينا",60,"ن",2,0],["أيا عليّ السعد صيرتني","بجود فضل عمني أشعر",61,"ر",1,0],["أيا عرفات جمع شملنا","ونحن جماعات بكم ونيات",62,"ت",1,0],["أيا عُرْبُ أليس الغد","رُ في ديِنكُمُ شَيْنا",63,"ن",2,0],["أيا عاطشاً في مصرَعٍ لو شهِدتُهُ","سقيتك فيه من دموعي الذوارفِ",64,"ف",1,0],["أيا عجباً يُهتِّكُ في سلاحي","وقد حطم القَنَا طرفٌ طموحُ",65,"ح",1,0],["أَيا عَينُ جودي وَلا تَسأَمي","وَحُقَّ البُكاءُ عَلى السَيِّدِ",66,"د",1,1],["أيا عُمَرٌ تَمعَّن في الجَوابِ","وحاوِل أن تُجيبَه بالصَّوابِ",67,"ب",1,1],["أَيا عاذِلي فيه لما رآهُ","لئن كنتَ أَعْمَى فإِني 