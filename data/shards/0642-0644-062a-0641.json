{"poems":[[79,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[73,"وساحر الطرف شهي اللمى","https://www.aldiwan.net/poem3871.html","السريع"],[43,"يا روض جيرانكم الباكر","https://www.aldiwan.net/poem42373.html","السريع"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[53,"إني سألت ابن أبي طاهر","https://www.aldiwan.net/poem62937.html","الطويل"],[80,"قلت متى ترحمني","https://www.aldiwan.net/poem13981.html","مجزوء الرجز"],[91,"قلت في تيهي للسماء وقداد","https://www.aldiwan.net/poem44921.html","البسيط"],[91,"قد تنبهت من النوم","https://www.aldiwan.net/poem44961.html","مجزوء الرمل"],[33,"إن أهوى العباد شخصا إلينا","https://www.aldiwan.net/poem41845.html","الخفيف"],[33,"هاج فؤادي موقف","https://www.aldiwan.net/poem42226.html","مجزوء الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[80,"متى ترحمُنِي؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86496&r=&rc=41",""],[203,"قلت للشادن مل لي","https://www.aldiwan.net/poem45169.html","مجزوء الرمل"],[214,"علقته كالغصن ذو لثغة","https://www.aldiwan.net/poem13501.html","السريع"],[215,"شادن قد وفى فأسكر روحا","https://www.aldiwan.net/poem46593.html","الخفيف"],[228,"نحن عدن وهم مكان مريب","https://www.aldiwan.net/poem39718.html","الخفيف"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[228,"سمعتني أقول شعرا شقيا","https://www.aldiwan.net/poem41592.html","الخفيف"],[255,"قلت فاترك فما لي سواه","https://www.aldiwan.net/poem14929.html","الخفيف"],[264,"ربنا إننا لهجنا بذكرك","https://www.aldiwan.net/poem35973.html","الخفيف"],[333,"خلت نفسي يوما إلها عظيما","https://www.aldiwan.net/poem54977.html","الخفيف"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[563,"قالوا غدا نأتي ديار الحمى","https://www.aldiwan.net/poem33856.html","السريع"],[563,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53953","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38160","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38979","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77662","الرجز"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123363","المديد"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56141","الرمل"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101118","الرمل"],[1509,"","https://poetry.dctabudhabi.ae/diwan/poem/73901","السريع"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82654","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79832","المديد"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79930","السريع"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87939","الرجز"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114025","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74991","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95151","الخفيف"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95157","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27423","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27857","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27528","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109428","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47162","الخفيف"],[2400,"","https://poetry.dctabudhabi.ae/diwan/poem/205095","الخفيف"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65980","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94154","الرمل"],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124045","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204502","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205004","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103457","المديد"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103453","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65263","الرمل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104358","السريع"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99383","المنسرح"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112385","الرمل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127053","السريع"],[3685,"","https://poetry.dctabudhabi.ae/diwan/poem/203144","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216821","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44907","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44893","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4242,"","https://poetry.dctabudhabi.ae/diwan/poem/202629","السريع"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136520",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136653",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33498","الخفيف"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119538","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[4767,"حديث مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=124899",""],[4767,"قطة الجار","https://www.poetsgate.com/ViewPoem.aspx?id=180913",""],[4883,"غيرة أطفال","https://www.poetsgate.com/ViewPoem.aspx?id=48396",""],[4987,"ماهى اول غلا","https://www.poetsgate.com/ViewPoem.aspx?id=49570",""],[5061,"نهر دجله","https://www.poetsgate.com/ViewPoem.aspx?id=147167",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5537,"نقاش أمن قومي","https://www.poetsgate.com/ViewPoem.aspx?id=207782",""],[5628,"مغترب يصف حاله","https://www.poetsgate.com/ViewPoem.aspx?id=178540",""],[5725,"احجية الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186471",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5976,"ما عيّنت خير","https://www.poetsgate.com/ViewPoem.aspx?id=30536",""],[463,"حبَّ إليها بالغضا نرتيعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60132&r=&rc=188",""]],"verses":[["قُلْتُ فارقْتُ شَبابي وحْدَهُ","فإذا الدُنْيا ومَا فِيها تبَعْ",0,"ع",1,0],["قُلتُ فَهذا ما اسمُهُ قالَ لي","بَعضُ الَّذي قَد قُلتَهُ يُغني",1,"ن",2,0],["قُلتُ فَإِنّي طالبٌ غِرَّةً","مِنهُ وسَيفي صَارِمٌ باتِرُ",2,"ر",1,0],["قُلتُ فَخُذهُ هِبَةً بِقُبلَه","فَصَدَّ عَنّي وَعَلَتهُ خَجلَه",3,"ه",1,0],["قُلْتُ في ذاك مَوْتُكُنَّ وما المو","تُ بمُستعذب لدى الأحْياءِ",4,"ا",2,0],["قلتُ فإن الشمسَ قد أُوتيتْ","هذا وما تنبح غيرَ القمر",5,"ر",1,0],["قُلتُ فَقَد أيأستَني","مِنَ الحَياةِ قالَ قَدْ",6,"د",1,0],["قلت في تيهي للسماء وقداد","جت اريني نوراً يكون دليلا",7,"ل",2,1],["قلت في نفسيَ هذا","زمن الشعر السعيد",8,"د",1,0],["قُلتُ فيمَ البُكاءُ وَالحُزنُ قالَت","لِلَّتي قَد عَلِقَت دونَ المُصَلّى",9,"ل",2,0],["قُلتُ فَإِنّي هائِمٌ","صَبٌ بِكُم مُكَلَّفُ",10,"ف",1,0],["قلت في خشيةٍ بلى وفؤادي","من شعاع به يكاد يطيرُ",11,"ر",1,0],["قلت في غصةٍ إذن فاصنعا بي","ما تريدانه فإني أسير",11,"ر",1,0],["قلت فليأت البديعيُّ بما","شاءت الفِطْنةُ من لُغْزٍ وشاء",12,"ا",2,0],["قلت في الأرضِ وللأرضِ بهِ","ويحكم أيُّ ازدهارٍ وازدهاء",12,"ا",2,0],["قلتُ: فقد أيْأَسْتني","منن الحياة، قال:قدْ",13,"د",1,0],["قلتُ فابلل من غليلي","قالَ ها ها من يبالي",14,"ل",2,0],["قلت فدتك الروح فاصنع بها","يا بدر ما شئت وما تبغي",15,"غ",2,0],["قلت فيه القصيد فنّا وسحرا","أنا بالشعر أسحر الأقمارا",16,"ر",2,0],["قُلتِ في صَمتِكِ الجَميلِ حَديثٌ","ما رَوى مِثلَهُ فَمٌ مَوهوبُ",17,"ب",1,0],["قُلتِ في مُقلَتَيكِ مِنها خَيالٌ","فَهَواها ما ماتَ بَل هُو نائِم",18,"م",1,0],["قُلتُ في مُقلَتَيكِ خَمر العَذارى","فَهيَ أَكسيرُكِ الَّذي تَحجُبينَه",19,"ه",1,0],["قُلتُ في مُهجَتي فَراغ رَهيب","فَاِعصُري فيهِ فَلذَة شارِبيهِ",19,"ه",1,0],["قُلتُ في ما تُفَكَّرين فَقالَت","في سُكونِ الدُجى وَفي ما يَليهِ",19,"ه",1,0],["قُلتُ في ما تفكِّرين فَقالَت","في يَراعٍ سحرُ الهَوى مِن ذَويه",19,"ه",1,0],["قلت فاترك فما لي سواهُ","قال لي والمقالُ منه صوابُ",20,"ب",1,1],["قُلتَ في ذِكرِكَ القَديمِ اِذكُروني","فَاِمتَثَلنا بِالسَمعِ طَوعاً لِأَمرِك",21,"ك",1,0],["قلتُ فلتَهبِط الشرور إلى الأر","ض ألا وليحي السنا في الظلام",22,"م",1,0],["قُلتُ فَالتَوبَةُ تَمحو زِلَّتي","قالَ لِلأَوبَةِ في الرَجعى تَهَي",23,"ي",1,0],["قُلتُ فَالتَكليفُ ما أَوجَبَه","قالَ تَكليفي أَعلى نِعمَتَي",23,"ي",1,0],["قُلتُ فَالرَحمَةَ يا مَن وَسِعَت","سِعَةُ الرَحمَةِ مِنهُ كُلَّ شَي",23,"ي",1,0],["قلت فما ظنكُّما قالا نرى","أن ندعَ الدارَ لهم قلتُ دعا",24,"ع",2,0],["قلتُ فأغضبت الملوكَ فيكُمُ","وأنتُمُ بي تُغضبون الشُّعَرا",25,"ر",2,0],["قلتُ فضلٌ عَجبٌ من دهرنا","وهو من فاعله غيرُ عجيبِ",26,"ب",1,0],["قلت فلي ذنب فما حيلتي","أخشى بأن يطردني عنهمو",27,"م",2,0],["قلت فالوعد به تسلية","قال يحتاج يفي من وعدا",28,"د",2,0],["قلت فاسمح بخيال في الكرى","قال لي ما لك طرف رقدا",28,"د",2,0],["قلتُ فانعمْ لي بها مُستعجِلاً","قال لي خُذْها هنيئاً دون مَنْ",29,"ن",1,0],["قلتُ في تَأريخي لَه حازَ قُرباً","وَقَبولاً في جنّةٍ وَنَعيمِ",30,"م",1,0],["قُلت فَاِسمَع وَدُمتَ أَرِّخ محبّاً","قَد بَناها محمّدُ الفاخوري",31,"ر",2,0],["قُلتُ فَذي حِكايَةٌ لِلظاهِر","تُتلى عَلَيكَ بِالكَلام الظاهِر",32,"ر",1,0],["قلتُ فالأرفاثُ تَتْبَعها","قال طِيبُ العَيش في الرَّفَثِ",33,"ث",1,0],["قلتُ فيه بيت شعرٍ","من نظيم الدرّ عقدُه",34,"د",2,0],["قلت في الشيب وقاري","زاني اللَه وقارا",35,"ر",2,0],["قُلتُ فَمَنّيني بِتَقبيلَةٍ","قالَت أُمَنّيكَ بِطولِ العَنا",36,"ن",2,0],["قُلتُ فَإِنّي مَيِّتٌ عاجِلاً","قالَت فَمُت ذاكَ لِقَلبي المُنى",36,"ن",2,0],["قلت فيه بضد ما","قيل في أم جندب",37,"ب",1,0],["قلت فوق الكشح ما جال إلاَّ","وأعار الطيرَ قلبي الجناحا",38,"ح",2,0],["قلت فمن خصركِ قلبي اشتكى","ضعفاً فقالت كذِبَ الشاكي",39,"ك",2,0],["قلت فمشغوفُ الحشا مالَهُ","منكِ سوى أن يتمنَّاك",39,"ك",1,0],["قلتُ فويلي أَينَ حَظّي منها","هل من نعيم ناءَ يغني عنها",40,"ه",2,0],["قلت في رِيقك الشفاءُ إذا ما","رَشَفَ العاشِقُ اللّديعُ رُضابَه",41,"ب",2,0],["قلت في الذكر رحمَتي وَسعت","كل عبادي فكان ظني جَميلا",42,"ل",2,0],["قلت فالله تراه عاجزاً","إذ عصاه عبده فيما أمر",43,"ر",1,0],["قلت فعلي لم يكن صنعاً لما","صنعت كفى دونَ المقتدر",43,"ر",1,0],["قلت فالقردُ قبيحٌ لونُهُ","وكذاكَ الكلبُ ذُو اللونِ الوَضِر",43,"ر",1,0],["قُلتُ في مُهجَتي ما شِئتَ فَاِحكُم","وَتَحكَّم فَالحُسنُ قَد أعطاكَ",44,"ك",1,0],["قُلتُ في مُهجتي تَحكَّم وَقَلبي","ولكَ الأمر فَاِقضِ ما أنتَ قاضِ",45,"ض",1,0],["قلتُ فيهم إنهم قد زعموا","أكذبَ الله الذي قد زعما",46,"م",2,0],["قلتُ فمن قيل لنا","من المياه والثرى",47,"ر",2,0],["قلت فما أعرفُ إلا مؤمناً","بما به يجري القضاءُ والقدر",48,"ر",1,0],["قلت فيما أرخت واللَه أني","عن عليٍّ أروي حديث النقابه",49,"ب",2,0],["قُلْت فاق النبيءُ وهو أخيرٌ","كلَّ ذي رتبةٍ سَمَتْ في الأنام",50,"م",1,0],["قلت في طاعة","لربك أبليت ذا النسب",51,"ب",1,0],["قلت في مدحكم وأخلصت ودي","يا رجائي وسادتي واعتصامي",52,"م",2,0],["قلت فدتك النفس أفنيت الصبا","أبليه بالعدو والارفال",53,"ل",1,0],["قلت في التاريخ أنعم","يا لها اضرط لحيه",54,"ي",2,0],["قلت فالموت ويك أيسرُ خطب","عند نفس الكريم دون مناها",55,"ا",3,0],["قلت في البيع استفيد هياماً","هو عندي يفوق كل مفيد",56,"د",1,0],["قلت فاصبغ لي الحذاء بصبغٍ","فيه أغدو مثل الذوات العظام",57,"م",1,0],["قُلتُ في عَينَيهِ أَفئدَةٌ","تَنتَحي ما قصَّ من أثَرِه",58,"ر",2,0],["قلتُ فهاتيه إذاً","قالت نعم في السَحَرِ",59,"ر",1,0],["قُلتُ فيما كنتُ ياذا","قال لي كنتُ أشوُّش",60,"ش",1,0],["قلت فلي ذنب فما حيلتي","بأي وجه أتلقاهم",61,"م",1,0],["قلت فإني أرى بها صدأ","فقال هذه بقية الحبك",62,"ك",1,0],["قلتُ في نفسي وللنومِ صدود","أوَ حَتّى غربةٌ في مضجعي",63,"ي",1,0],["قلت فلي ذنب فما حيلتي","والذنب لم يغفره الا همّ",64,"م",1,0],["قلتُ فَرخُ الطاؤوس أحسنُ ماكا","ن إذا ما علا ع