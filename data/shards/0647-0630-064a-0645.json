ما ذُكِرَتْ","على لسانيَ حباً زادني شرفا",226,"ف",2,0],["هَذيْ مسائلَ في الغرامِ عَرَضْتها","أرْجُوْ الجَوابَ من الأديب الْمُلْهَمِ",227,"م",1,0],["هذي من الصمان لمحة أزاهير ..","يطغى على حوذانها قحوياني ..",228,"ن",2,0],["هذي ملاك أتت للأرض لابسة","جسماً لطيفاً بدا للعقل والنظر",229,"ر",1,0],["هذي مقدمة تأتي أواخرها","كما كرهت كما جاءت أوائلها",230,"ل",3,0],["هذى مآذنُها تُناجى ربَها","والمسكُ من جسدِ الشهيدِ يَفُوحُ",231,"ح",1,0],["هذى مدارسنا تشكو فوارسها","والجهل يضحك والإهمال ينتصُر",232,"ر",1,0],["هذي مُناي تسوح في أفق الردى","وزمان آمالي أباه زماني",233,"ن",2,0],["هذي مزاعمهم كانت تطالعنا","في كل ما زيفوه بئس ما زعموا",234,"م",3,0]]}