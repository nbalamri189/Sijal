oetsgate.com/ViewPoem.aspx?id=200586",""],[5829,"قم لرمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212930",""],[5853,"روحان في فلك المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=175614",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5956,"متغزِّلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182090",""],[5956,"هذي العيون","https://www.poetsgate.com/ViewPoem.aspx?id=182274",""],[5956,"سيارة وسط الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=184691",""],[5956,"مُبدِعون ، ومُجْتَرُّون","https://www.poetsgate.com/ViewPoem.aspx?id=185568",""],[5956,"علامَ تفرح يا قلبي؟","https://www.poetsgate.com/ViewPoem.aspx?id=193517",""],[5956,"طوبَى للمحامية هالة خضر المحمد","https://www.poetsgate.com/ViewPoem.aspx?id=214190",""],[6008,"الواسطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=60803",""],[6031,"يا سَيِّداً عَظُمَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46406",""],[6052,"سلام الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=34888",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6093,"مسائل في الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=176101",""],[6100,"الصمان","https://www.poetsgate.com/ViewPoem.aspx?id=52551",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""],[520,"لم يبق لابن دخان عند خالقه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577626",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[6213,"وهدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80548&r=&rc=80",""],[2638,"تحية العلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87847&r=&rc=11",""]],"verses":[["هذي مناقِبُه في عهدِ دولتِهِ","للشّاهِدِينَ وللأعقابِ أحكيها",0,"ي",3,0],["هَذي مَضاجِعُكُم يا قَومُ فَاِلتَقِطوا","طيبَ الكَرى بِعُيونٍ شابَها السَهَرُ",1,"ر",1,0],["هذي ملاعبهم فجسمك رض بها","وأسلك مسالكهم عداك الذام",2,"م",1,0],["هذي مواطنكم تريد وصالكم","وتئنّ شاكيةً من الهجران",3,"ن",1,0],["هذي مآثرنا العظام خذوا بها","ودعوا إدعاء الحاسد الصَعفوق",4,"ق",1,0],["هذي ملامتكم يا قوم فاستمعوا","منها إلى كَلِم في طيها حِكَم",5,"م",1,0],["هذي مدارسكم شَروَى مزارعكم","فأنبتوا في ثراها ما علا وغلا",6,"ل",2,0],["هَذي مَنازِلُهُم تَهَشُّ لَنا","أَخطَأتَ بَل هَذي مَنازِلُنا",7,"ن",2,0],["هَذي مَنازِلُكَ الأُخرى نُهَنِّئُها","فَمَن يَمُرُّ عَلى الأولى يُسَلّيها",8,"ي",3,0],["هَذي مَخايِلُ بَرقٍ خَلفَهُ مَطَرٌ","جَودٌ وَوَريُ زِنادٍ خَلفَهُ لَهَبُ",9,"ب",1,0],["هَذِي مُنايَ وَحَسبي أَن أَفوزَ بِها","بِنِعمَةِ اللَّهِ قَبلَ الشَّيبِ وَالهَرَمِ",10,"م",1,0],["هَذي مَواقِفُنا في الدَهرِ ناطِقَةٌ","فَاِستَنبِئوها تُريحونا مِنَ التُهَمِ",11,"م",1,0],["هذي مَصارِعُها تجري الدماءُ بها","وتشتكي الهُونَ في أرجائها الرِّممُ",12,"م",1,0],["هذي معالم خرس كل واحدة","منهن قامت خطيباً فاغراً فاه",13,"ا",2,0],["هذي مغذية النفو","س وَتلك مجلبة المعاطب",14,"ب",1,0],["هذي مَدينتُكم وذاك صِراعُها","رمزٌ لكلِّ بُطولةٍ وشعارُ",15,"ر",1,0],["هَذِي مُنَايَ وَحَبَّذَا لَوْ نِلْتُهَا","عَنْ طِيبِ نَفْسٍ فَهْيَ أَكْبَرُ مُقْنِعِ",16,"ع",1,0],["هَذِي مَنَاقِبُهُ وَحَسْبِي ذِكْرُهَا","حَتَّى يُخَيِّلَ أَنَّهُ إِطْرَاءُ",17,"ا",2,0],["هَذِي مَفَاخِرِهُمُ وَلَيْ","سَتْ بِالسَّخَافَاتِ الزَّهِيدَهْ",18,"د",2,0],["هَذِي مَلِيكَاتُ الَّلآلِيءِ أَقْبَلَتْ","تَفْتَرُّ عَنْ قِطَعٍ مِنَ اللأْلاَءِ",19,"ا",2,0],["هَذِي مَوَاكِبُهَا وَتِلْكَ وُفُودَهَا","فِي مُلْتَقَى ذِي رَوْعَةٍ وَجَمَالِ",20,"ل",1,0],["هَذِي مُنَانَا وَفِي تَحْقِيقِهَا لَهُمْ","سَعْدٌ وَفِي تَرْكِهَا خَسْفٌ وَتَفْجِيعُ",21,"ع",1,0],["هُذَيمٌ وَسَعَدٌ يَعذِلانِ عَلى الهَوى","فَماذا لَقينا مِن هُذيمٍ وَمِن سَعدِ",22,"د",1,0],["هذِي مجلَتُنا إليكِ","وكلُّ فَضْلٍ منكِ آت",23,"ت",1,0],["هذي مبادئكم، وتلك حقوقنا","كالشمس؛ لا لبسًا، ولا تعقيدا",24,"د",2,0],["هذي معاجمُهم. هل في معاجمهم","إلا عقيقٌ من الفصحى ومرَجانُ؟",25,"ن",1,0],["هذي منابرُك العليا مهيأةٌ","يا طيرُ، فاصْدَحْ؛ فكل الكون آذان",26,"ن",1,0],["هذي معاقلهم فمن","لك بالبواذخ من شمام؟",27,"م",1,0],["هذي منازل من ولى على أسف","أعني الامام وأعني المفرد العلما",28,"م",2,0],["هذي مدينتكم الدّنيا بها وبصنعكم","وتحدّث الأجيال والأدهار",29,"ر",1,0],["هذي مباهجُ \" بغدادٍ \" ونشوتُها","وجداً عليكِ . فكيف الحزنُ والهلع",30,"ع",1,0],["هذي مصارِعُ مُنجبيكَ ودورُهم","يملأنَ عَرضاً للعراقِ وطُولا",31,"ل",2,0],["هذي مراعيه عطل من بشاشتها","حنّت لشبّابة الراعي مراعيه",32,"ي",2,0],["هَذِى مَغَانٍ غَنِينَا بِالنَّعِيمِ بِهَا","أحَنَت عَلَيها السَّوَافي مُنذُ أزمَانِ",33,"ن",1,0],["هذي مآثره الغراء شاهدة","بأنه خير مَن وشّى ومن كتبا",34,"ب",2,0],["هَذي مَناقِبُكُم فَهَل مِن طامِعٍ","وَصِفاتُ مَجدِكُم فَهَل مِن مَطمَعِ",35,"ع",1,0],["هذي مساومةُ الفحول ومن يبع","ما بعت لم يعلق بصفقته الغبنْ",36,"ن",1,0],["هذي مصارعكم فمن يخشى الردى","يذهب ومن لم يخش ليستأنفا",37,"ف",2,0],["هذى مصارع من يخادع أحمدا","يا من يخادع أحمدا ويماكر",38,"ر",1,0],["هذي ميادينُ القتالِ تعدّدت","وبكلّ ناحيةِ ترى ميدانا",39,"ن",2,0],["هَذي مَشاهِدُنا الَّتي كانَت لَنا","مَعروفَةً وَوَلِيُّنا مَولاكا",40,"ك",2,0],["هذي من الناس تبدو","وهذه كعقوبه",41,"ب",2,0],["هَذي مَصارِعُ شانيكُم يُبَصِّرُها","ذو احنةٍ فيُلاقيكُم بشنان",42,"ن",1,0],["هذي مَقَالَةُ شَيخٍ مِن بَني أسَدٍ","يُهدِي السَّلامَ إلى العَبَّاسِ في الصُّحُفِ",43,"ف",1,0],["هذي مكارمُهم فخذها من فتى","ما كانَ إلا باسلاً وظريفا",44,"ف",2,0],["هَذي مَواهِبُها تُفاضُ على الوَرى","كالغَيْثِ طَبَّق أجْبُلاً وَبِطاحا",45,"ح",2,0],["هذي مَطالعُ نجلِها بل نَجْمِها","تَصفُ السماء وبَدْرهَا الوَضّاحا",46,"ح",2,0],["هذي مدارس جددت يسمو بها","لسما المعارف كل شهم راغب",47,"ب",1,0],["هذي محاسن ذاك الوجه غيرها","بطن الثرى فاستحالت فوقه زهرا",48,"ر",2,0],["هَذي مَآثِركم قَصيدٌ بيتهُ","هرمُ الدهورِ فما له من مهرمِ",49,"م",1,0],["هَذي مَحاسِنُ أَخلاقٍ خَصَّصتَ بِها","فَصِرتُ بَينَ ذَوي الأَفضالِ كَالعِلمِ",50,"م",1,0],["هَذي مَآثِرٌ لَم تَنَلها قَبلَهُ","بِاِبنِ الخَطيبِ وَجُلَّةَ الخُلَفاءِ",51,"ا",2,0],["هذي مفاتيحي وما","تأمرْ به فأنا أبيحه",52,"ح",2,0],["هذي محجتها فأين المهتدي","فيها وأين العالم المتهذب",53,"ب",1,0],["هذي مفاتيحٌ إليها ينتمي","من كان فيها كل يومٍ يرغب",53,"ب",1,0],["هذي مفاخرهم","وليسست بالخافات الزهيده",54,"د",2,0],["هذي مِثالُ الطُّهْرِ والتقوى‘له","في سُلَّمِ الخُلُقِ الرَّفيع صُعُود",55,"د",1,0],["هذي مرقعة علينا رقعت","فالآن ألبسها بلا أشباه",56,"ه",1,0],["هذي مناسك أحمد وصفاته","في حجه ورجوعه ورحيله",57,"ل",2,1],["هذي منازل من أحل فقف بها","إن كنت تسعدني بغير توقف",58,"ف",1,0],["هذي منازلهم وأن","ت بهم معنى مغرم",59,"م",1,1],["هذي معاليه فما نظراؤه","غير النجوم عُلًى ولا أكفاؤه",60,"ا",3,0],["هذي مآثرُ من أَضْحَى لأَخْمَصِهِ","على الأَثيرِ من الأَفلاكِ تأْثيرُ",61,"ر",1,0],["هذي مناظرةٌ نتيجةُ فقهِها","منّي ومنه راكعٌ أو ساجدُ",62,"د",1,0],["هذى مواكبهُ تسير نوافحاً","بحرارةِ الإيمانِ كُلَّ نشيدِ",63,"د",1,0],["هذى مقابرُهم وتلك دماؤُهم","مثلُ النجوم ونوِرها الشَّفافِ",64,"ف",1,0],["هذي مواقفكم فوفّوا حقّها","دمتم ودام العود منها الأحمدي",65,"د",2,0],["هذي مواقفه وما","زالت هنا وهناك توجد",66,"د",1,0],["هذي مقاساة قيس","هذا شواظ لظاها",67,"ا",3,0],["هذي مآثرهم في كل مملكة","لم يعرف الترك لولاهم ولا حسبوا",68,"ب",3,0],["هذي مواقفها وهذي دارها","وبها فؤادي لم يزل مشغولا",69,"ل",2,0],["هذي مناقبك التي أبقيتها","لبنيك قلبا داميا مكلوما",70,"م",2,0],["هذي مشاريعهم راموز نهضتهم","ماء الحياتين من أعماقها نبعا",71,"ع",2,0],["هذي من البيت الحسني درة","ضمت له الشرف المطهر نورا",72,"ر",2,0],["هذي مناجاة عبد رق حاسده","من البلاء الذي أمسى يكابده",73,"د",2,1],["هذي مقدمة يأتي أواخرها","بما كرهت كما جاءت أوائلها",74,"ل",3,0],["هذى مواهبة وبهن قد اهتدى","من في معانيها تأمل ممعنا",75,"ن",2,0],["هذى مناقبك التي لهجت بها","لسنٌ وكانت للعقول رحيقا",76,"ق",2,0],["هذي مناقبنا بها لسن الورى","تشدو كما يشدو الهزار الصادح",77,"ح",1,0],["هذي مفاخرنا بدت وتلألأت","كجواهر صيغت بهن مدائح",77,"ح",1,0],["هذي مناجاة الرئيس لكم فهل","كل لما فال الرئيس فعول",78,"ل",1,0],["هذي مفاخر مفضال إذا ذكرت","أرخت على غيرها أسداك فضيان",79,"ن",1,0],["هذي منابرهُ حنّت عليه شجى","مُذ غاب عنها ومنها الدمع ينسكبُ",80,"ب",1,0],["هذي مقالةُ حقٍّ طاب مَحتِدُها","والهزلُ من جِدِّ برهانٍ لها عَزَبا",81,"ب",2,0],["هذي مظاهر إيمان 