html","السريع"],[477,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[479,"قبر ابن آدم أيا زرته انتدبا","https://www.aldiwan.net/poem36940.html","البسيط"],[479,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[482,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[495,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[514,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[515,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[529,"من دونها يا عمر وخز الرماح","https://www.aldiwan.net/poem37480.html","السريع"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[551,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[551,"من شاء ان يعذلني في الهوى","https://www.aldiwan.net/poem47279.html","السريع"],[551,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[558,"من شدة القرب كان البعد للإنسان","https://www.aldiwan.net/poem33726.html","المواليا"],[558,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[562,"ماذا جلبت لنا يا ليلة العيد","https://www.aldiwan.net/poem52846.html","البسيط"],[567,"من شك في فضل الكميت فبينه","https://www.aldiwan.net/poem69699.html","الكامل"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[575,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[586,"من شاء بعد رضى الأحبة يغضب","https://www.aldiwan.net/poem17412.html","الكامل"],[586,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["مِن شُرَيقيِّ الحِمى يَن","شُدُ نَجداً وَعَقيقَه",0,"ق",2,0],["مَن شافِعي وَذُنوبي عِندَها الكِبَرُ","إِنَّ المَشيبَ لَذَنبٌ لَيسَ يُغتَفَرُ",1,"ر",1,1],["من شذوذ الطفل من زهو الفتى","من أسى الشيخ الفقير العاثر",2,"ر",1,0],["من شكاوى عاشق يمشي على","قلبه نحو الحبيب ... نافر",2,"ر",1,0],["منْ شمْسِ ذاتِكَ قد أمدَّ هِلالَهُ","وبقُطْبِ سيرتِكَ اسْتَقامَ جِدارُهُ",3,"ر",2,0],["مِن شُربِها المُزّاءَ ما اِس","تَبطَنتُ مِن إِشرابِها",4,"ب",3,0],["مِن شَبابٍ تَراهُمُ غَيرَ ميلٍ","وَكُهولاً مَراجِحاً أَحلاما",5,"م",2,0],["مِن شاعِرٍ تَثِبُ النُهى لِقَريضِهِ","وَثبَ النُفوسِ لِرَنَّةِ العيدانِ",6,"ن",1,0],["من شاء فليجر بمضماره","ما زالت في مضماره أولا",7,"ل",2,0],["مُنْشِدٌ لِلْغَرَامِ لَمْ يَشْدُ إِلاَّ","كَانَ إِنْشَادُهُ نُواحاً شَجِيَّا",8,"ي",2,0],["من شاء يعرفُ فخرهم وكمالهم","فليتلُ وحي الله فيهم والسَّيَرْ",9,"ر",1,0],["من شاء منكم أن","يعيش اليوم وهو مُكرَّم",10,"م",1,0],["من شقاء العراق أن ذوي الن","عمة فيه أجانب غرباء",11,"ا",2,0],["منشداُ في النواح شعراً غَرِيز","ياًحزيناً كأنه إنشادي",12,"د",2,0],["مَن شاءَ بايَعتُهُ مالي وَخُلعَتَهُ","ما تُكمِلُ الخُلجُ في ديوانِهُم صَطَرا",13,"ر",2,1],["مِن شِواءٍ لَيسَ مِن عارِضَةٍ","بِيَدَي كُلِّ هَضومٍ ذي نَزَل",14,"ل",1,0],["مَن شاءَ بَعدَكَ فَليَمُت","فَعَلَيكَ كُنتُ أُحاذِرُ",15,"ر",1,0],["من شؤم حظِّي أنَّني عاشق","خائفةً من أهلها نكرَا",16,"ر",2,1],["منش على برّه عظمي ولحمي من","دهرٍ وباني الوَلا من فوق آساسي",17,"ي",1,0],["من شراب يفوق كل شرابٍ","ويدٍ لم تزل حَياً وغِياثا",18,"ث",2,0],["مُنْشَدَ المدحِ تحت أفْياء عُرْفٍ","ناشِد طَالِبيه لا منشودِ",19,"د",1,0],["مُنشيء النيروز ثانية","لا ذَوِي إثم ولا فندِ",20,"د",1,0],["من شمولٍ ذات صِبغٍ قانئٍ","نحلتْها اللونَ أحجار بجاذي",21,"ذ",2,0],["من شعية الكهْلِ خالِ المؤمنينَ على","رَغْمِ ابن شيبةَ أو رَغم الدمشقيِّ",22,"ي",1,0],["مِن شَرابي الشَهد وَالخَمرَة وَالماءُ الزُلال","مِن طَعامي البَقل وَالأَثمار وَاللَحمُ الحَلال",23,"ل",1,0],["مُنشِئٌ رَقَّ لَفظُهُ كَسَجاياهُ","وَرَفَّ الجَمالُ في جَنَباتِه",24,"ت",2,0],["مِن شاعِرٍ كَالرَوضِ أَشعارُهُ","تَسمَعُ هَمسَ الحُبِّ فيهِ الفَتاة",25,"ه",1,0],["مِن شاعِرٍ كَلِفٍ بِكُم وَبِأَرضِكُم","أَبَداً يُوالي فيكُم وَيُعادي",26,"ي",1,0],["مِن شاعِرٍ ما حَرَّكَ الغُصنُ الهَوا","إِلا تَذَكَّرَ وَردَةً وَأَميلا",27,"ل",2,0],["مَنْشورةٌ للنُّورِ والأَنْسامِ","والأُفْقُ يزخَرُ بالأَشعَّةِ والشَّذى",28,"ذ",2,0],["مَن شَكَّ أَنّي هائِمٌ بِكِ مُغرَمٌ","فَعَلى هَواكِ لَهُ عليّ دَلائِلُ",29,"ل",1,0],["من شقاء الإنسان أن المنايا","قاسيت ما إن إليها شفيع",30,"ع",1,0],["من شداد الغموض فيها يحار العقل","والعقل بعض تلك الشداد",31,"د",1,0],["منشبا في قساوة بفؤادي","مخلبا من صروفه اثر مخلب",32,"ب",1,0],["من شاء منكم أن يُعزَّ بلاده","فَلْيَسْعَ سعيَ مُعزّها البارودي",33,"د",2,0],["من شموس تبدو وتخفى وتبدو","في طوال الدهور والآباد",34,"د",1,0],["منشورة أعلامه من أحمر","قان وأبيضَ في الربى لماح",35,"ح",1,0],["مَن شَذَّ ناداهُ إِلَيهِ فَرَدَّهُ","قَدَرٌ كَراعٍ سائِقٍ بِقِطاعِ",36,"ع",1,0],["مَن شَوَّهَ الدُنيا إِلَيكَ فَلَم تَجِد","في المُلكِ غَيرَ مُعَذَّبينَ جِياعِ",36,"ع",1,0],["مِن شاطِئٍ فيهِ الحَياةُ لِشاطِئٍ","هُوَ مُضجَعٌ لِلسابِقينَ وَمِرفَقُ",37,"ق",1,0],["مَن شَكَّ فيهِ فَنَظرَةٌ في صُنعِهِ","تَمحو أَثيمَ الشَكِّ وَالإِنكارِ",38,"ر",1,0],["مَنْ شَاءَ تَشْبيهَ الشّقائِقِ فَلْيَقُلْ","كَنِسَاءِ قَتْلَى قَدْ خَرَجْنَ صَوائحا",39,"ح",2,1],["مِن شَراحيلَ اِبنِ حَلحَلَةٍ","وَهِشامٍ وَأَبي اليَسَعِ",40,"ع",1,0],["مِن شَأنِهِ القَصدُ وَلَكِنَّهُ","إِن يُعطِ في عارِفَةٍ يُسرِفِ",41,"ف",1,0],["مَن شاكِرٌ عَنّي الخَليفَةَ في الَّذي","أَولى مِنَ الإِفضالِ وَالإِحسانِ",42,"ن",1,0],["مَن شاكِرٌ عَنّي الخَليفَةَ في الَّذي","أَولاهُ مِن طَولٍ وَمِن إِحسانِ",43,"ن",1,0],["مَن شَكَّ في الدينِ فَإِنّي مُهتَدِ","يا رَبِّ فَاِجعَل في الجِنانِ مَورِدي",44,"ي",1,0],["مِن شَرَفِ الفَقرِ وَمِن فَضلِهِ","عَلى الغِنى لَو صَحَّ مِنكَ النَظَر",45,"ر",1,1],["مِن شَأنِهِ حَملُ أَعباءِ الهَوى كَمَداً","إِذا هَمَى شَأنُهُ بِالدَمعِ لَم يُلَمِ",46,"م",1,0],["مَن شاهَدَ ظَبياً شارِداً ذا مَرَحٍ","قَد أَشفَقَتِ الأُسودُ مِن خَشيَتِهِ",47,"ه",1,0],["مَن شاهَدَ الكَواكِبَ تَمشي عَلى الثَرى","أَو عايَنَ المَوالي تَسعى إِلى العَبيد",48,"د",1,0],["من شاطئ لشواطئ جدد","يرمي بنا ليل من الأبد",49,"د",1,1],["من شاءَ أنْ تَسْكَرَ راحٌ بِرَاحْ","فليَسْقِها خَمْرَ العيون الم