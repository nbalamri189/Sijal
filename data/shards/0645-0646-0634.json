{"poems":[[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"يا لقيس لما لقينا العاما","https://www.aldiwan.net/poem21985.html","الخفيف"],[86,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[93,"يا متقن الخط ويا ملبساً","https://www.aldiwan.net/poem11079.html","السريع"],[93,"عاش هذا الفتى محبا شقيا","https://www.aldiwan.net/poem11096.html","الخفيف"],[83,"هب النسيم على الرياض مع السحر","https://www.aldiwan.net/poem54309.html","الكامل"],[88,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[88,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"من شاء بايعته مالي وخلعته","https://www.aldiwan.net/poem5747.html","البسيط"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[23,"كنت السواد لناظري","https://www.aldiwan.net/poem21572.html","مجزوء الكامل"],[72,"من شؤم حظي أنني عاشق","https://www.aldiwan.net/poem18964.html","السريع"],[72,"عين حواجبها ترمي بأقواس","https://www.aldiwan.net/poem19019.html","البسيط"],[51,"شرب البيهقي والبين ناء","https://www.aldiwan.net/poem9232.html","الخفيف"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[51,"رب هب لي في أبي الفضل رذاذ","https://www.aldiwan.net/poem61988.html","الرمل"],[51,"يا رب جري شواء مررت به","https://www.aldiwan.net/poem66771.html","البسيط"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[91,"قل للحمائم في ضفاف الوادي","https://www.aldiwan.net/poem8798.html","عموديه"],[91,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[78,"بركت تلوح وفي الفؤاد بلابل","https://www.aldiwan.net/poem14005.html","الكامل"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[89,"من كان في المجد المؤثل راغبا","https://www.aldiwan.net/poem44986.html","الكامل"],[89,"إن في أوسع الفضاء نجوما","https://www.aldiwan.net/poem45105.html","الخفيف"],[85,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[56,"من شاء تشبيه الشقائق فليقل","https://www.aldiwan.net/poem58620.html","الكامل"],[45,"يابن مر قول مرتدع","https://www.aldiwan.net/poem65128.html","المديد"],[45,"لم تبلغ الحق ولم تنصف","https://www.aldiwan.net/poem65144.html","السريع"],[45,"وأمر من عللي تخلى ناظري","https://www.aldiwan.net/poem66681.html","الكامل"],[45,"لبيت فيك الشوق حين دعاني","https://www.aldiwan.net/poem66690.html","الكامل"],[58,"يا شاهد الله علي فاشهد","https://www.aldiwan.net/poem31108.html","الرجز"],[49,"من شرف الفقر ومن فضله","https://www.aldiwan.net/poem64213.html","السريع"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"يا من فضح الغصون في مشيته","https://www.aldiwan.net/poem39626.html","الدوبيت"],[66,"بشراي قد تنبه لي الطالع السعيد","https://www.aldiwan.net/poem39647.html","الدوبيت"],[97,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"الدار ناطقة وليست تنطق","https://www.aldiwan.net/poem30020.html","الكامل"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[44,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[69,"أأضيع سحر جفونه","https://www.aldiwan.net/poem28938.html","مجزوء الكامل"],[105,"خلق العروبة أن تجد وتدأبا","https://www.aldiwan.net/poem42057.html","الكامل"],[81,"أهدى نسيم الصباح","https://www.aldiwan.net/poem61390.html","المجتث"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"قد أغتدي والطير في مثواتها","https://www.aldiwan.net/poem62480.html","الرجز"],[48,"داو يحيى من خماره","https://www.aldiwan.net/poem63269.html","مجزوء الرمل"],[48,"اسقنا إن يومنا يوم رام","https://www.aldiwan.net/poem65093.html","الخفيف"],[48,"استعذ من رمضان","https://www.aldiwan.net/poem65312.html","مجزوء الرمل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1237","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30435","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54743","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54798","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141920","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43847","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117001","السريع"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24769","المنسرح"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[45,"يا بنَ مُرٍّ قوْلَ مُرتَدعِ","https://www.poetsgate.com/ViewPoem.aspx?id=32185",""],[91,"موت العبقري","https://www.poetsgate.com/ViewPoem.aspx?id=52962",""],[51,"يا رُبَّ جَرِّي شَوّاءٍ مررتُ بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30782",""],[51,"ربِّ هبْ لي في أبي الفضل رَذاذ","https://www.poetsgate.com/ViewPoem.aspx?id=28600",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["مِن شُرَيقيِّ الحِمى يَن","شُدُ نَجداً وَعَقيقَه",0,"ق",2,0],["مَن شافِعي وَذُنوبي عِندَها الكِبَرُ","إِنَّ المَشيبَ لَذَنبٌ لَيسَ يُغتَفَرُ",1,"ر",1,1],["منْ شمْسِ ذاتِكَ قد أمدَّ هِلالَهُ","وبقُطْبِ سيرتِكَ اسْتَقامَ جِدارُهُ",2,"ر",2,0],["مِن شُربِها المُزّاءَ ما اِس","تَبطَنتُ مِن إِشرابِها",3,"ب",3,0],["مِن شَبابٍ تَراهُمُ غَيرَ ميلٍ","وَكُهولاً مَراجِحاً أَحلاما",4,"م",2,0],["مِن شاعِرٍ تَثِبُ النُهى لِقَريضِهِ","وَثبَ النُفوسِ لِرَنَّةِ العيدانِ",5,"ن",1,0],["من شاء فليجر بمضماره","ما زالت في مضماره أولا",6,"ل",2,0],["مُنْشِدٌ لِلْغَرَامِ لَمْ يَشْدُ إِلاَّ","كَانَ إِنْشَادُهُ نُواحاً شَجِيَّا",7,"ي",2,0],["من شاء يعرفُ فخرهم وكمالهم","فليتلُ وحي الله فيهم والسَّيَرْ",8,"ر",1,0],["من شاء منكم أن","يعيش اليوم وهو مُكرَّم",9,"م",1,0],["من شقاء العراق أن ذوي الن","عمة فيه أجانب غرباء",10,"ا",2,0],["منشداُ في النواح شعراً غَرِيز","ياًحزيناً كأنه إنشادي",11,"د",2,0],["مَن شاءَ بايَعتُهُ مالي وَخُلعَتَهُ","ما تُكمِلُ الخُلجُ في ديوانِهُم صَطَرا",12,"ر",2,1],["مِن شِواءٍ لَيسَ مِن عارِضَةٍ","بِيَدَي كُلِّ هَضومٍ ذي نَزَل",13,"ل",1,0],["مَن شاءَ بَعدَكَ فَليَمُت","فَعَلَيكَ كُنتُ أُحاذِرُ",14,"ر",1,0],["من شؤم حظِّي أنَّني عاشق","خائفةً من أهلها نكرَا",15,"ر",2,1],["منش على برّه عظمي ولحمي من","دهرٍ وباني الوَلا من فوق آساسي",16,"ي",1,0],["من شراب يفوق كل شرابٍ","ويدٍ لم تزل حَياً وغِياثا",17,"ث",2,0],["مُنْشَدَ المدحِ تحت أفْياء عُرْفٍ","ناشِد طَالِبيه لا منشودِ",18,"د",1,0],["مُنشيء النيروز ثانية","لا ذَوِي إثم ولا فندِ",19,"د",1,0],["من شمولٍ ذات صِبغٍ قانئٍ","نحلتْها اللونَ أحجار بجاذي",20,"ذ",2,0],["من شعية الكهْلِ خالِ المؤمنينَ على","رَغْمِ ابن شيبةَ أو رَغم الدمشقيِّ",21,"ي",1,0],["مِن شَرابي الشَهد وَالخَمرَة وَالماءُ الزُلال","مِن طَعامي البَقل وَالأَثمار وَاللَحمُ الحَلال",22,"ل",1,0],["مُنشِئٌ رَقَّ لَفظُهُ كَسَجاياهُ","وَرَفَّ الجَمالُ في جَنَباتِه",23,"ت",2,0],["مِن شاعِرٍ كَالرَوضِ أَشعارُهُ","تَسمَعُ هَمسَ الحُبِّ فيهِ الفَتاة",24,"ه",1,0],["مِن شاعِرٍ كَلِفٍ بِكُم وَبِأَرضِكُم","أَبَداً يُوالي فيكُم وَيُعادي",25,"ي",1,0],["مِن شاعِرٍ ما حَرَّكَ الغُصنُ الهَوا","إِلا تَذَكَّرَ وَردَةً وَأَميلا",26,"ل",2,0],["مَنْشورةٌ للنُّورِ والأَنْسامِ","والأُفْقُ يزخَرُ بالأَشعَّةِ والشَّذى",27,"ذ",2,0],["مَن شَكَّ أَنّي هائِمٌ بِكِ مُغرَمٌ","فَعَلى هَواكِ لَهُ عليّ دَلائِلُ",28,"ل",1,0],["من شقاء الإنسان أن المنايا","قاسيت ما إن إليها شفيع",29,"ع",1,0],["من شداد الغموض فيها يحار العقل","والعقل بعض تلك الشداد",30,"د",1,0],["منشبا في قساوة بفؤادي","مخلبا من صروفه اثر مخلب",31,"ب",1,0],["من شاء منكم أن يُعزَّ بلاده","فَلْيَسْعَ سعيَ مُعزّها البارودي",32,"د",2,0],["من شموس تبدو وتخفى وتبدو","في طوال الدهور والآباد",33,"د",1,0],["منشورة أعلامه من أحمر","قان وأبيضَ في الربى لماح",34,"ح",1,0],["مَن شَذَّ ناداهُ إِلَيهِ فَرَدَّهُ","قَدَرٌ كَراعٍ سائِقٍ بِقِطاعِ",35,"ع",1,0],["مَن شَوَّهَ الدُنيا إِلَيكَ فَلَم تَجِد","في المُلكِ غَيرَ مُعَذَّبينَ جِياعِ",35,"ع",1,0],["مِن شاطِئٍ فيهِ الحَياةُ لِشاطِئٍ","هُوَ مُضجَعٌ لِلسابِقينَ وَمِرفَقُ",36,"ق",1,0],["مَن شَكَّ فيهِ فَنَظرَةٌ في صُنعِهِ","تَمحو أَثيمَ الشَكِّ وَالإِنكارِ",37,"ر",1,0],["مَنْ شَاءَ تَشْبيهَ الشّقائِقِ فَلْيَقُلْ","كَنِسَاءِ قَتْلَى قَدْ خَرَجْنَ صَوائحا",38,"ح",2,1],["مِن شَراحيلَ اِبنِ حَلحَلَةٍ","وَهِشامٍ وَأَبي اليَسَعِ",39,"ع",1,0],["مِن شَأنِهِ القَصدُ وَلَكِنَّهُ","إِن يُعطِ في عارِفَةٍ يُسرِفِ",40,"ف",1,0],["مَن شاكِرٌ عَنّي الخَليفَةَ في الَّذي","أَولى مِنَ الإِفضالِ وَالإِحسانِ",41,"ن",1,0],["مَن شاكِرٌ عَنّي الخَليفَةَ في الَّذي","أَولاهُ مِن طَولٍ وَمِن إِحسانِ",42,"ن",1,0],["مَن شَكَّ في الدينِ فَإِنّي مُهتَدِ","يا رَبِّ فَاِجعَل في الجِنانِ مَورِدي",43,"ي",1,0],["مِن شَرَفِ الفَقرِ وَمِن فَضلِهِ","عَلى الغِنى لَو صَحَّ مِنكَ النَظَر",44,"ر",1,1],["مِن شَأنِهِ حَملُ أَعباءِ الهَوى كَمَداً","إِذا هَمَى شَأنُهُ بِالدَمعِ لَم يُلَمِ",45,"م",1,0],["مَن شاهَدَ ظَبياً شارِداً ذا مَرَحٍ","قَد أَشفَقَتِ الأُسودُ مِن خَشيَتِهِ",46,"ه",1,0],["مَن شاهَدَ الكَواكِبَ تَمشي عَلى الثَرى","أَو عايَنَ المَوالي تَسعى إِلى العَبيد",47,"د",1,0],["من شاطئ لشواطئ جدد","يرمي بنا ليل من الأبد",48,"د",1,1],["من شاءَ أنْ تَسْكَرَ راحٌ بِرَاحْ","فليَسْقِها خَمْرَ العيون الملاحْ",49,"ح",1,1],["مِن شاعِرٍ وَقَفَ الكَلامُ بِبابِهِ","وَاِكتَنَّ في كَنَفَي ذُراهُ المَنطِقُ",50,"ق",1,0],["مَن شَرَّدَ الإِعدامَ عَن أَوطانِهِ","بِالبَذلِ حَتّى اِستُطرِفَ الإِعدامُ",51,"م",1,0],["مِن شُنُعِ الخِلعَةِ الغَريبَةِ إِنَّ","المَجدَ مَجدُ الرِياشِ في شُنُعِه",52,"ع",2,0],["مِن شَكلِهِ الدُرُّ في رَصفِ النِظامِ وَمِن","صِفاتِهِ الفِتنَتانِ الظَلمُ وَالشَنَبُ",53,"ب",1,0],["منْ شعرتين بخدِّهِ","كلاَّ ولا ألفينِ شعرَهْ",54,"ه",1,0],["من شَاءَ منكم فَلْيكُنْه ولا يَقُلْ","ذهب القديمُ فإِنّه لن يذهبا",55,"ب",2,0],["مِن شادِنٍ لَو تَبَدّى","لِلبَدرِ أَظلَمَ نورُه",56,"ه",1,0],["مِنْ شهيدَيْنِ ليس يُنْسِيَني الطَّف","فُ مُصابَيْهِما وَلا كَرْبَلاءُ",57,"ا",2,0],["مِنْ شاعرٍ صادِقٍ ما شانهُ كَذبٌ",