{"poems":[[72,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[119,"لسراج الأنبيا حامي النزيل","https://www.aldiwan.net/poem41965.html","الرمل"],[182,"هد الجوى ركبي","https://www.aldiwan.net/poem50687.html","المواليا"],[242,"أزف الرحيل فخانني صبري","https://www.aldiwan.net/poem18190.html","الكامل"],[242,"نلنا ولولا الحب ما نلناها","https://www.aldiwan.net/poem19725.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37841","الخفيف"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101441","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121199","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83130","الكامل"],[4831,"في عيد الاستقلال","https://www.poetsgate.com/ViewPoem.aspx?id=208614",""],[5419,"باحس إني باضيع مني","https://www.poetsgate.com/ViewPoem.aspx?id=32491",""],[242,"لي في هوى المحبوب اعظم نشوة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563720",""],[6344,"جنوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87977&r=&rc=17",""]],"verses":[["ها عَبدُكَ واقِفٌ ذَليلٌ","بِالبابِ يَمُدُّ كَفَّ سائِل",0,"ل",1,0],["ها عدوي قد شفى مني الغليل","وبقدحي جهرة أملي السطور",1,"ر",1,0],["ها عتمُ دَيْجوري","راسٍ كما البُنيانْ",2,"ن",1,0],["هَا عَبْدُكَ الْمِسْكِينُ لَاذَ بِكُمْ","يَرْجُو الأَمَانَ بِكُمْ مِنَ الدَّهْرِ",3,"ر",1,0],["هَا عَبْدُكَ الْمُضْطَرٍّ أَمَّ جَنَابَكُمْ","يَرْجُو مِنْ أَسْبَابِ الْهُدَى أَقْوَاهَا",4,"ا",3,0],["هَا عَبْدُكَ الْمَلْهُوفُ لاَذَ بِبَابِكُمْ","يَرْجُو مِنْ أَدْوِيَةِ الضَّنَى أَشْفَاهَا",4,"ا",3,0],["ها عليُّ اِبن الوزيرِ الَّذي قَد","مَلكَ الشَّامَ بِالطَّريقِ القَويمِ",5,"م",1,0],["ها عَجُوزٌ كَبِيرةٌ بَلَغتْ عُمْ","راً طَوِيلاً وتَتَّقيها الرِجالُ",6,"ل",1,1],["ها عرضحالي وهذا منتهى أملي","وقد سطا جيش عسرى اليوم فالمدد",7,"د",1,0],["ها عَلِّموها وَاِفعَلوا ما شِئتمو","فالعلمُ حِصن لا يَكادُ يُرامُ",8,"م",1,0],["ها عيدُ لبنانَ هلَّ زيِّنُوا الدّربا","قدْ جاء يكسو ذُرَى أمجادِه حَسَبا",9,"ب",2,1],["هاعيش عمرى على عهودنا","وأحلامنا وأمانينا",10,"ا",1,0],["ها عَبدُكَ المُضطَرُّ أَمَّ جَنابِكُم","يَرجو مِن أَدوِيَةَ الضَنى أَشفاها",11,"ا",3,0],["ها عَبدُكَ المَلهوفُ لاذَ بِبابِكُم","يَرجو مِن أَسبابِ الهُدى أَقواها",11,"ا",3,0],["هَا عِشْتَ تَمْنَحُكَ الحَقِيقَةُ وَجْهَهَا","لَكِنْ بَقِيتَ لِظَهْرِهَا مَمْنُوحَا",12,"ح",2,0]]}