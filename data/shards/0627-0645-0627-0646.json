.aldiwan.net/poem56294.html","الطويل"],[462,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[462,"تكف بصبر فالسؤال مذلة","https://www.aldiwan.net/poem3528.html","عموديه"],[463,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[463,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[493,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[502,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[538,"أغذو تلادا من الأشعار أصلحها","https://www.aldiwan.net/poem56705.html","البسيط"],[549,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[556,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[556,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[562,"أمن هجر من تهواه قلبك واجد","https://www.aldiwan.net/poem838.html",""],[573,"أمانا فإني من عتابك خائف","https://www.aldiwan.net/poem2762.html","الطويل"]],"verses":[["أَمانِيُّ اِستَرَكَّت كُل","لَ صَبّارٍ عَلى الأَلَمِ",0,"م",1,0],["أَما نَهى الناسَ عَنكُم صَوبُ بارِقَةٍ","يَشكو إِلى اليَومِ ناحيها مِنَ البَلَلِ",1,"ل",1,0],["أُمانِعُ الدَمعَ عَيناً جِدُّ دامِعَةٍ","وَأُلزِمُ اليَدَ قَلباً جِدُّ مُلتاعِ",2,"ع",1,0],["أَما نَهى الأَعداءَ ما جَرَّبوا","مِنكَ بِزَعزاعِ القَنا الشُرَّعِ",3,"ع",1,0],["أَمانيُّ أوضِعُ في غَيِّها","لِريحِ الغُرورِ بِها مُستَطيبا",4,"ب",2,0],["أَمانِيُّ نَفسٍ ما تُناخُ رِكابُها","وَغَيبَةُ حَظٍّ لا يُرَجّى إِيابُها",5,"ب",3,1],["أَمَا نَحْنُ فَرْعَا دَوْحَةٍ غَالِبِيَّةٍ","بِحَيْثُ تُناجِي المَكْرُماتُ المَعالِيا",6,"ل",3,0],["إمّا نطَقْتُ فذِكْرُ عهْدِكَ منْطِقي","وإذا صَمَتّ فأنت في إضْمارِ",7,"ر",1,0],["أَمانِيُّكَ الكُبرى وَهَمُّكَ أَن تَرى","بِأَرجاءِ وادي النيلِ شَعباً مُنَعَّما",8,"م",2,0],["أمانٍ كما تندى الشبيبة نَضْرَةٌ","يمُدُّ له ظلٌّ على الأرض أَوْرَفُ",9,"ف",1,0],["أما نفوس عداك من غيظٍ فقدْ","كادتْ تكون جسومها كلحودها",10,"د",3,0],["أما نوال ابن يحيى فهو صنعته","سرًّا وجهرًا كما قد قيل خرازي",11,"ي",1,0],["أمانةَ الله إنها زنةُ ال","غبراء مبسوطها وخالقها",12,"ق",3,0],["أمانُكِ عندي ما حييت مُؤكَّدٌ","وإن لم تَعُدّي حُرمةً قد أسنَّتِ",13,"ت",1,0],["أَم أَنا عِندَ غُروبِ الشَمسِ غَيري في البُكور","كُلَّما ساءَلتُ نَفسي جاوَبَتني لَستُ أَدري",14,"ي",1,0],["أَما نَحنُ مِن مَصدَرٍ واحِدٍ","أَلَسنا جَميعاً إِلى مَرجِعِ",15,"ع",1,0],["أَم أَنتَ كَالحَقلِ عَلى رَغمِهِ","يَنمو مَعَ الحِنطَةِ فيهِ القَتاد",16,"د",1,0],["ام انت توقن ان الناس ان هلكوا","فسوف يحيون في يوم كما كانوا",17,"ن",3,0],["أما نجيب فهو صادفها فتى","يزهو بحسنٍ للغواني يخدع",18,"ع",1,0],["أم أنت خلقة لجننة شيمية","تهب العقول وتمنح الإدراكا",19,"ك",2,0],["امانا لقلبي من جفونك في الهوى","كفى بالهوى كاسا وراحا وساقيا",20,"ي",2,0],["أَماناً أَماناً لُجَّةَ الرومِ لِلوَرى","لَوَ اَنَّ أَماناً عِندَ دَأماءَ يُطلَبُ",21,"ب",1,0],["أَمِ اِنتَجَعتَ لِلغِنى يَمينَهُ","أَم زُرتَهُ مُكَثِّراً قَطينَهُ",22,"ن",2,0],["أما نغبةٌ من فضلِ كاسِكَ يشتفي","بها من لهُ بين الضُلوعِ وقودُ",23,"د",1,0],["إِمّا نَوالٌ يُدنيكَ مِن مِدَحي","أَوِ اِعتِذارٌ يَكفيكَ تَأنيبي",24,"ب",2,0],["أَمانَةُ صَدرٍ وَاِضطِلاعُ كِفايَةٍ","وَصِحَّةُ عَزمٍ وَاِتِّساعُ ذِراعِ",25,"ع",1,0],["أَما نَحنُ راؤو أَهلِها غَيرَ هَذِهِ","يَدَ الدَهرِ إِلّا أَن يُلِمَّ بِها سَفرُ",26,"ر",1,0],["أَمانَةٌ يُشفِقُ مِن حَملِها","لِفَرطِ ذاكَ الثِقلِ إِنسانُه",27,"ن",2,0],["أما نَشَأتْ منه سُحْبُ النّدى","سواكبَ تهمي وكانت جهاما",28,"م",2,0],["أم أنتِ في الفَتَكاتِ لا تخشَينَ في","قَتلِ العبادِ عُقوبةَ المَعبودِ",29,"د",1,0],["أَمانِياً سَلَبَتهُم نُجحَ هاجِسِها","ظُبى السُيوفِ وَأَطرافُ القَنا السُلُبِ",30,"ب",1,0],["أم أنتِ ماثِلةٌ ؟ مِن ثَمَّ مُطَّرَحٌ","لنا ومنْ ثَمَّ مُرتاحٌ ومُتَّسَد",31,"د",1,0],["أمانةُ ربّنا صِينَتْ لدينا","وكنّا للأمانةِ حافظينا",32,"ن",2,0],["أَمانَةُ آبائِنا الأَوَّلينَ","وَإِرثُ البَنينَ وَذُخرُ العُصُرْ",33,"ر",1,0],["أَماناً حُماةَ السِلمِ لا تَمسَحوا الدُنى","وَلا تَذبَحوا عُمرانَها وَهوَ يولَدُ",34,"د",1,0],["أَماناً مُلوكَ النارِ فَالأَرضُ كُلُّها","تُناشِدُكُم تِلكَ العُهودَ البَوالِيا",35,"ي",2,0],["أَماناً حُماةَ السِلمِ لَو أَنَّنا نَرى","مِنَ المَعشَرِ الغازينَ لِلسِلمِ حامِيا",35,"ي",2,0],["أَمانُ الحُصونِ وَغَوثُ الجُنودِ","وَحِرزُ السَوابِغِ وَالمُرهَفاتِ",36,"ت",1,0],["أَماناً لِعانٍ يَطلُبُ السِلمَ في الهَوى","وَحَسبُكِ ما أَتلَفتِ مِن نَفسِهِ نَصرا",37,"ر",2,0],["أَماناً فَما بَينَنا ثائِرٌ","وَعَفواً فَما بَينَنا مُذنِبُ",38,"ب",1,0],["أما نَفَضَتْكِ من خوفٍ وذُعْرٍ","عَرانينُ المُشَلَّلِ إذ لَواها",39,"ا",3,0],["أمانةُ ربِّ البيتِ لم تُعْطَ خائناً","يُريدُ بها دُنيا ولم تُؤتَ فاجرا",40,"ر",2,0],["أما نَظروه مأخوذاً ببأسٍ","يَهُدُّ البأسَ أخْذاً واستلابا",41,"ب",2,0],["أَمّا نَداهُ فَكَوثَرٌ وَفِناؤُهُ","عَدنٌ وَهَذا الزِيُّ مِن إِستَبرَقِ",42,"ق",1,0],["أَما نَباتُ فَقَد أَضحَت مُخَضَّبَةً","وَالشِعرُ مُفتَرِقٌ بِالبانِ مَغسولُ",43,"ل",1,0],["أَمَ اِنتِ بِجارِهِ رَهَنٌ","سَقى جيرانَهُ الدِيَمُ",44,"م",1,0],["أَمّا نِبالُ المَنايا فَهيَ مُصمِيَةٌ","فَما نِبالُ مَقالٍ لا أُباليها",45,"ي",3,0],["أَمانَةُ اللَهِ وَهيَ أَعظَمُ مِن","هَضبِ شَرَورى وَالرُكنِ مِن خِيَمِ",46,"م",1,0],["أمانيُّ شَتَّى تمثَّلنَ لي","بكلِّ وضيءِ الصِّبا ناعمِ",47,"م",1,0],["أمانة الأول عند الآخر","خزانة الآثار والمفاخر",48,"ر",1,0],["أَمَّا نِقولاَ الأَخُ المُفدَّى","فَآيَةٌ النُّبْلِ فِي الرجَالِ",49,"ل",1,0],["أَمْ أَنْتِ مِنْ تِلْكَ الْجَوَا","لِي فِي الْفصُولِ الأَرْبَعِ",50,"ع",1,0],["أم أنا غيْري وإلاّ مَنْ أنا","أم هو السحْرُ غدا يلعَبُ بي",51,"ب",2,0],["أمانٍ كنَّ أحلامَ الأوالي","فهل يأتي بها الزمنُ الأخير؟",52,"ر",1,0],["أمانٍ تلك؛ إن هيَ أخطأتنا","فلا نصرٌ هناك، بل اندحار",53,"ر",1,0],["أماناً وجِلْبابُ الحياة ِ بَقِيرُ","أعارَهُمُ کفْرَنْسِيسُ تلكَ وَسِيلَة",54,"ه",1,0],["أمان الله والدُّنيا \"هَلوكٌ \"","أبتْ إلَّا التحوُّلَ والخِداعا",55,"ع",2,0],["أم أنتَ لا حِقَبلً تدري ، ولا مِقَةً","ولا اجتواءً ، ولا بُرءاً ، ولا وصَبا",56,"ب",2,0],["أمْ أنَّني سَأَكونُ في تارِيخِنا","مُتآمِراً أَمْ هَادِمَ الأَوْثانِ؟",57,"ن",1,0],["أما نهيتك عن هذا أما وأبى","لأوسعنك تأديباً على الزلل",58,"ل",1,0],["أمَ انتَ شَرارةٌ كُبرى","قُدِحتَ لتُرشِدَ المُضنى",59,"ن",2,0],["أم انت نُزوعُ روحٍ ثائرٍ","عاتٍ أبي السَجنا",59,"ن",2,0],["أم أنتَ في كونٍ سَحيق","لا صدىً منه يُرَدُّ",60,"د",1,0],["أم انتَشَبَت في حَبَّةِ القَلبِ أسهُمٌ","مُرَيَّشَةٌ زُرقٌ مِنَ السُّمرِ رُشَّقُ",61,"ق",1,0],["أماناً يا رشيق القدّ إني","أروم رضاً فجُد لي بالإمانِ",62,"ن",1,0],["أمانىُّ في صدور الوزارةِ بُلغِّتْ","به كُنهَها حتى استحقَّتْ نُذورُها",63,"ر",3,0],["أَمانيُّ قَد أَخلَت لَها طُرُقَ الظُبى","وَلا صَدَرٌ يُحمى عَلَيهِ وَلا وِردُ",64,"د",1,0],["أَمانٌ لمرتاعٍ ورَوْعٌ لآمنٍ","وكهفٌ لمطلوبٍ وحَرْبٌ لغالبِ",65,"ب",1,0],["أَماناً فما لي من يد بلواحظٍ","تحاكي سيوفَ الهند وهي سهامُ",66,"م",1,0],["أمانة ُ الحبِّ أن ْ أهديكِ من أدبي","حرفا ً من اللومِ في كأس ٍ من العتب ِ",67,"ب",1,0],["أَمَ اِنتَ اِمرُؤٌ كَالضَبِّ قَد عَلِقَت بِهِ","حَبائِلُ عَصٍّ حالَفَ الفَقرَ أَرشَما",68,"م",2,0],["أما نومة تحت النخيل يحفّها","من الماء أشحار بأفنانها الصفر",69,"ر",1,0],["أمان أمين وانتصار وعفة","وبسط وعدل شامل ومواهب",70,"ب",1,0],["أَمان لنا يا طيبُ عندك يا ترى","إِليها لنا يوماً يكون وصولُ",71,"ل",1,0],["أم انتشرتْ منكِ الحليُّ لعثرةٍ","وهذا الهلالُ الساقطُ النصفِ خلخالُ",72,"ل",1,0],["أماني الهنا بالحمد وافت وبالشكر","ووجه التهاني قد تهلل بالبشر",73,"ر",1,1],["أمانيّمن قلبي فصاحٌ نواطقٌ","بأنك للميعاد يا روح طائر",74,"ر",1,0],["إمّا نزلت به نزل","ت على البقية من رجاك",75,"ك",1,0],["أماناً لها من داء وجدى فإنني","أخاف عليها أن داء الهوى يعدى",76,"د",2,0],["أم أن من فوق الثرى","لا يسمعون ولا يعون",77,"ن",1,0],["أم أن عهد صداقتي","نفس تردد في الهواء",78,"ا",2,0],["أم أنت ذاك اللؤلؤُ المجتَنَى","من ثغره العذْبِ وتطويقه",79,"ق",2,0],["أَم أَنتَ بَعدَ البَينِ مُضمِرُ سُلوَةٍ","فَتُفيقَ مِن سُكرِ الغَرامِ وَتُقلِعُ",80,"ع",1,0],["أَمْ أَنْتَ عَنْ غَرَضِ الْمَنُونِ بِمَعْزِلٍ","لَمْ تَكْتَرِثْ بِسِهَامِهِ وَبِنَجْشِهِ",81,"ش",2,0],["أمانيك والدنيا ونفسك والهوى","وطبعك والعجب الذي فيك والشقا",82,"ق",2,1],["أمانيُّ الفتى عند المنايا","ودونَ المجدِ أسيافٌ تُسَلُّ",83,"ل",1,0],["أماناً وأمناً فادخُلِ الخلدَ خالداً","وحمداً على حسنِ الهُدى والسلامة",84,"ه",1,0],["أمانيُّ قومي في المنايا وما لهم","خلاصٌ 