179.html","البسيط"],[461,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[461,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[461,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[461,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[467,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[467,"تكف بصبر فالسؤال مذلة","https://www.aldiwan.net/poem3528.html","عموديه"],[468,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[468,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[468,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[498,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[507,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[543,"أغذو تلادا من الأشعار أصلحها","https://www.aldiwan.net/poem56705.html","البسيط"],[554,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[561,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[561,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[567,"أمن هجر من تهواه قلبك واجد","https://www.aldiwan.net/poem838.html",""],[578,"أمانا فإني من عتابك خائف","https://www.aldiwan.net/poem2762.html","الطويل"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21461","الطويل"]],"verses":[["أم أن كل لبيب حزنه أبدٌ","فليس يفنى إلى أن يحدث العدمُ",0,"م",1,0],["أم أنه العقل مجهولٌ إذا قصرت","عنه العقول وحاطت ربه البهم",0,"م",1,0],["أَمانِيُّ اِستَرَكَّت كُل","لَ صَبّارٍ عَلى الأَلَمِ",1,"م",1,0],["أَما نَهى الناسَ عَنكُم صَوبُ بارِقَةٍ","يَشكو إِلى اليَومِ ناحيها مِنَ البَلَلِ",2,"ل",1,0],["أُمانِعُ الدَمعَ عَيناً جِدُّ دامِعَةٍ","وَأُلزِمُ اليَدَ قَلباً جِدُّ مُلتاعِ",3,"ع",1,0],["أَما نَهى الأَعداءَ ما جَرَّبوا","مِنكَ بِزَعزاعِ القَنا الشُرَّعِ",4,"ع",1,0],["أَمانيُّ أوضِعُ في غَيِّها","لِريحِ الغُرورِ بِها مُستَطيبا",5,"ب",2,0],["أَمانِيُّ نَفسٍ ما تُناخُ رِكابُها","وَغَيبَةُ حَظٍّ لا يُرَجّى إِيابُها",6,"ب",3,1],["أَمَا نَحْنُ فَرْعَا دَوْحَةٍ غَالِبِيَّةٍ","بِحَيْثُ تُناجِي المَكْرُماتُ المَعالِيا",7,"ل",3,0],["إمّا نطَقْتُ فذِكْرُ عهْدِكَ منْطِقي","وإذا صَمَتّ فأنت في إضْمارِ",8,"ر",1,0],["أَمانِيُّكَ الكُبرى وَهَمُّكَ أَن تَرى","بِأَرجاءِ وادي النيلِ شَعباً مُنَعَّما",9,"م",2,0],["أمانٍ كما تندى الشبيبة نَضْرَةٌ","يمُدُّ له ظلٌّ على الأرض أَوْرَفُ",10,"ف",1,0],["أما نفوس عداك من غيظٍ فقدْ","كادتْ تكون جسومها كلحودها",11,"د",3,0],["أما نوال ابن يحيى فهو صنعته","سرًّا وجهرًا كما قد قيل خرازي",12,"ز",2,0],["أمانةَ الله إنها زنةُ ال","غبراء مبسوطها وخالقها",13,"ق",3,0],["أمانُكِ عندي ما حييت مُؤكَّدٌ","وإن لم تَعُدّي حُرمةً قد أسنَّتِ",14,"ت",1,0],["أَم أَنا عِندَ غُروبِ الشَمسِ غَيري في البُكور","كُلَّما ساءَلتُ نَفسي جاوَبَتني لَستُ أَدري",15,"ي",1,0],["أَما نَحنُ مِن مَصدَرٍ واحِدٍ","أَلَسنا جَميعاً إِلى مَرجِعِ",16,"ع",1,0],["أَم أَنتَ كَالحَقلِ عَلى رَغمِهِ","يَنمو مَعَ الحِنطَةِ فيهِ القَتاد",17,"د",1,0],["ام انت توقن ان الناس ان هلكوا","فسوف يحيون في يوم كما كانوا",18,"ن",3,0],["أما نجيب فهو صادفها فتى","يزهو بحسنٍ للغواني يخدع",19,"ع",1,0],["أم أنت خلقة لجننة شيمية","تهب العقول وتمنح الإدراكا",20,"ك",2,0],["امانا لقلبي من جفونك في الهوى","كفى بالهوى كاسا وراحا وساقيا",21,"ي",2,0],["أَماناً أَماناً لُجَّةَ الرومِ لِلوَرى","لَوَ اَنَّ أَماناً عِندَ دَأماءَ يُطلَبُ",22,"ب",1,0],["أَمِ اِنتَجَعتَ لِلغِنى يَمينَهُ","أَم زُرتَهُ مُكَثِّراً قَطينَهُ",23,"ن",2,0],["أما نغبةٌ من فضلِ كاسِكَ يشتفي","بها من لهُ بين الضُلوعِ وقودُ",24,"د",1,0],["إِمّا نَوالٌ يُدنيكَ مِن مِدَحي","أَوِ اِعتِذارٌ يَكفيكَ تَأنيبي",25,"ب",2,0],["أَمانَةُ صَدرٍ وَاِضطِلاعُ كِفايَةٍ","وَصِحَّةُ عَزمٍ وَاِتِّساعُ ذِراعِ",26,"ع",1,0],["أَما نَحنُ راؤو أَهلِها غَيرَ هَذِهِ","يَدَ الدَهرِ إِلّا أَن يُلِمَّ بِها سَفرُ",27,"ر",1,0],["أَمانَةٌ يُشفِقُ مِن حَملِها","لِفَرطِ ذاكَ الثِقلِ إِنسانُه",28,"ن",2,0],["أما نَشَأتْ منه سُحْبُ النّدى","سواكبَ تهمي وكانت جهاما",29,"م",2,0],["أم أنتِ في الفَتَكاتِ لا تخشَينَ في","قَتلِ العبادِ عُقوبةَ المَعبودِ",30,"د",1,0],["أَمانِياً سَلَبَتهُم نُجحَ هاجِسِها","ظُبى السُيوفِ وَأَطرافُ القَنا السُلُبِ",31,"ب",1,0],["أم أنتِ ماثِلةٌ ؟ مِن ثَمَّ مُطَّرَحٌ","لنا ومنْ ثَمَّ مُرتاحٌ ومُتَّسَد",32,"د",1,0],["أمانةُ ربّنا صِينَتْ لدينا","وكنّا للأمانةِ حافظينا",33,"ن",2,0],["أَمانَةُ آبائِنا الأَوَّلينَ","وَإِرثُ البَنينَ وَذُخرُ العُصُرْ",34,"ر",1,0],["أَماناً حُماةَ السِلمِ لا تَمسَحوا الدُنى","وَلا تَذبَحوا عُمرانَها وَهوَ يولَدُ",35,"د",1,0],["أَماناً مُلوكَ النارِ فَالأَرضُ كُلُّها","تُناشِدُكُم تِلكَ العُهودَ البَوالِيا",36,"ي",2,0],["أَماناً حُماةَ السِلمِ لَو أَنَّنا نَرى","مِنَ المَعشَرِ الغازينَ لِلسِلمِ حامِيا",36,"ي",2,0],["أَمانُ الحُصونِ وَغَوثُ الجُنودِ","وَحِرزُ السَوابِغِ وَالمُرهَفاتِ",37,"ت",1,0],["أَماناً لِعانٍ يَطلُبُ السِلمَ في الهَوى","وَحَسبُكِ ما أَتلَفتِ مِن نَفسِهِ نَصرا",38,"ر",2,0],["أَماناً فَما بَينَنا ثائِرٌ","وَعَفواً فَما بَينَنا مُذنِبُ",39,"ب",1,0],["أما نَفَضَتْكِ من خوفٍ وذُعْرٍ","عَرانينُ المُشَلَّلِ إذ لَواها",40,"ا",3,0],["أمانةُ ربِّ البيتِ لم تُعْطَ خائناً","يُريدُ بها دُنيا ولم تُؤتَ فاجرا",41,"ر",2,0],["أما نَظروه مأخوذاً ببأسٍ","يَهُدُّ البأسَ أخْذاً واستلابا",42,"ب",2,0],["أَمّا نَداهُ فَكَوثَرٌ وَفِناؤُهُ","عَدنٌ وَهَذا الزِيُّ مِن إِستَبرَقِ",43,"ق",1,0],["أَما نَباتُ فَقَد أَضحَت مُخَضَّبَةً","وَالشِعرُ مُفتَرِقٌ بِالبانِ مَغسولُ",44,"ل",1,0],["أَمَ اِنتِ بِجارِهِ رَهَنٌ","سَقى جيرانَهُ الدِيَمُ",45,"م",1,0],["أَمّا نِبالُ المَنايا فَهيَ مُصمِيَةٌ","فَما نِبالُ مَقالٍ لا أُباليها",46,"ي",3,0],["أَمانَةُ اللَهِ وَهيَ أَعظَمُ مِن","هَضبِ شَرَورى وَالرُكنِ مِن خِيَمِ",47,"م",1,0],["أمانيُّ شَتَّى تمثَّلنَ لي","بكلِّ وضيءِ الصِّبا ناعمِ",48,"م",1,0],["أمانة الأول عند الآخر","خزانة الآثار والمفاخر",49,"ر",1,0],["أَمَّا نِقولاَ الأَخُ المُفدَّى","فَآيَةٌ النُّبْلِ فِي الرجَالِ",50,"ل",1,0],["أَمْ أَنْتِ مِنْ تِلْكَ الْجَوَا","لِي فِي الْفصُولِ الأَرْبَعِ",51,"ع",1,0],["أم أنا غيْري وإلاّ مَنْ أنا","أم هو السحْرُ غدا يلعَبُ بي",52,"ب",2,0],["أمانٍ كنَّ أحلامَ الأوالي","فهل يأتي بها الزمنُ الأخير؟",53,"ر",1,0],["أمانٍ تلك؛ إن هيَ أخطأتنا","فلا نصرٌ هناك، بل اندحار",54,"ر",1,0],["أمان وأوهام وزخرف باطل","سراب بقيعان الفلاة يمور",55,"ر",1,0],["أمانة الله تسطيع الأداء لها","اذا علمت بعون الله ما شرعا",56,"ع",2,0],["أماناً وجِلْبابُ الحياة ِ بَقِيرُ","أعارَهُمُ کفْرَنْسِيسُ تلكَ وَسِيلَة",57,"ه",1,0],["أمان الله والدُّنيا \"هَلوكٌ \"","أبتْ إلَّا التحوُّلَ والخِداعا",58,"ع",2,0],["أم أنتَ لا حِقَبلً تدري ، ولا مِقَةً","ولا اجتواءً ، ولا بُرءاً ، ولا وصَبا",59,"ب",2,0],["أم آن يسترجع التاج أهله","ويسترجع التاج المهابة ثانيا",60,"ي",2,0],["أمْ أنَّني سَأَكونُ في تارِيخِنا","مُتآمِراً أَمْ هَادِمَ الأَوْثانِ؟",61,"ن",1,0],["أما نهيتك عن هذا أما وأبى","لأوسعنك تأديباً على الزلل",62,"ل",1,0],["أمَ انتَ شَرارةٌ كُبرى","قُدِحتَ لتُرشِدَ المُضنى",63,"ن",2,0],["أم انت نُزوعُ روحٍ ثائرٍ","عاتٍ أبي السَجنا",63,"ن",2,0],["أم أنتَ في كونٍ سَحيق","لا صدىً منه يُرَدُّ",64,"د",1,0],["أم انتَشَبَت في حَبَّةِ القَلبِ أسهُمٌ","مُرَيَّشَةٌ زُرقٌ مِنَ السُّمرِ رُشَّقُ",65,"ق",1,0],["أماناً يا رشيق القدّ إني","أروم رضاً فجُد لي بالإمانِ",66,"ن",1,0],["أمانىُّ في صدور الوزارةِ بُلغِّتْ","به كُنهَها حتى استحقَّتْ نُذورُها",67,"ر",3,0],["أَمانيُّ قَد أَخلَت لَها طُرُقَ الظُبى","وَلا صَدَرٌ يُحمى عَلَيهِ وَلا وِردُ",68,"د",1,0],["أَمانٌ لمرتاعٍ ورَوْعٌ لآمنٍ","وكهفٌ لمطلوبٍ وحَرْبٌ لغالبِ",69,"ب",1,0],["أَماناً فما لي من يد بلواحظٍ","تحاكي سيوفَ الهند وهي سهامُ",70,"م",1,0],["أمانة ُ الحبِّ أن ْ أهديكِ من أدبي","حرفا ً من اللومِ في كأس ٍ من العتب ِ",71,"ب",1,0],["أَمَ اِنتَ اِمرُؤٌ كَالضَبِّ قَد عَلِقَت بِهِ","حَبائِلُ عَصٍّ حالَفَ الفَقرَ أَرشَما",72,"م",2,0],["أما نومة تحت النخيل يحفّها","من الماء أشحار بأفنانها الصفر",73,"ر",1,0],["أمان أمين وانتصار وعفة","وبسط وعدل شامل ومواهب",74,"ب",1,0],["أَمان لنا يا طيبُ عندك يا ترى","إِليها لنا يوماً يكون وصولُ",75,"ل",1,0],["أم انتشرتْ منكِ الحليُّ لعثرةٍ","وهذا الهلالُ الساقطُ النصفِ خلخالُ",76,"ل",1,0],["أماني الهنا بالحمد وافت وبالشكر","ووجه التهاني قد تهلل بالبشر",77,"ر",1,1],["أمانيّمن قلبي فصاحٌ نواطقٌ","بأنك للميع