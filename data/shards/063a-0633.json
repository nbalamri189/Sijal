{"poems":[[55,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[88,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[39,"ولولا أمير المؤمنين وذبه","https://www.aldiwan.net/poem7512.html","الطويل"],[87,"هرتي جد أليفه","https://www.aldiwan.net/poem7999.html","مجزوء الرمل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[68,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[48,"غسل المليك بلاده من أهلها","https://www.aldiwan.net/poem22711.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[96,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[96,"جمرة الدنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66291&r=&rc=9",""],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[164,"دعوتك هاديا لك لو أطيق","https://www.aldiwan.net/poem58699.html","الوافر"],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[295,"أسفا لقد طفىء السراج","https://www.aldiwan.net/poem11668.html","مجزوء الكامل"],[369,"أما تحية الطرف الكحيل","https://www.aldiwan.net/poem60801.html","الوافر"],[447,"رضى بما قدر الباري وألزمنا","https://www.aldiwan.net/poem14486.html","البسيط"],[475,"فخرت وانتمت فقلت ذريني","https://www.aldiwan.net/poem4762.html","الخفيف"],[572,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[228,"","https://poetry.dctabudhabi.ae/diwan/poem/88011","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120104","الخفيف"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79988","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80002","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48986","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124721","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114803","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71037","السريع"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71079","الطويل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100113","البسيط"],[2568,"","https://poetry.dctabudhabi.ae/diwan/poem/200320",""],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101606","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138562",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123836","الكامل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33129","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66558","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40146","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125869","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90916","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117241","الكامل"],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138861",""],[4618,"","https://poetry.dctabudhabi.ae/diwan/poem/203979","المتقارب"],[4785,"لبنان مل","https://www.poetsgate.com/ViewPoem.aspx?id=129734",""],[5002,"أهزوجة الليل ،،،","https://www.poetsgate.com/ViewPoem.aspx?id=202975",""],[5092,"قبلةٌ ومن أوّل السطر","https://www.poetsgate.com/ViewPoem.aspx?id=163043",""],[5145,"غسمع هديت وخير القول أنصحه","https://www.poetsgate.com/ViewPoem.aspx?id=108170",""],[5170,"المرثية","https://www.poetsgate.com/ViewPoem.aspx?id=175493",""],[5279,"المصيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=183492",""],[5281,"أخي؛ إلى اللقاء!","https://www.poetsgate.com/ViewPoem.aspx?id=200106",""],[5358,"طيرُ المَجَرّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=48735",""],[5370,"تم قبول النداء","https://www.poetsgate.com/ViewPoem.aspx?id=86517",""],[5376,"كم ليلةٍ بالجوى مرَّتْ على العربِ","https://www.poetsgate.com/ViewPoem.aspx?id=214067",""],[5431,"تُضاء بنا الأكوان حبا ولن نُطفا","https://www.poetsgate.com/ViewPoem.aspx?id=193477",""],[5436,"شوق التراب(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34912",""],[5436,"نصيحة صادقة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35264",""],[5493,"نشيدُ الشجر","https://www.poetsgate.com/ViewPoem.aspx?id=197037",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5574,"غمامة أغدقت فوق الربى","https://www.poetsgate.com/ViewPoem.aspx?id=205991",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5739,"أمواق الغمام ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127362",""],[5943,"قُلْ للصَّبورِ","https://www.poetsgate.com/ViewPoem.aspx?id=11289",""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[5956,"ازحفْ أيا أرتينُ ازحف للعُلا","https://www.poetsgate.com/ViewPoem.aspx?id=205127",""],[5957,"حكاية حب","https://www.poetsgate.com/ViewPoem.aspx?id=177044",""],[6152,"دعي الماضي وذكراه","https://www.poetsgate.com/ViewPoem.aspx?id=203074",""],[5309,"خطرت وورد الروض بين يديها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573535",""],[6189,"خصوصية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83572&r=&rc=39",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6213,"إشراقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79027&r=&rc=69",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""],[6213,"ميناء المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76248&r=&rc=5",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""],[6320,"البَصْرَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84345&r=&rc=42",""],[6336,"ليلة وغدير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73396&r=&rc=2",""],[572,"ما تَرَى في الصبوحِ أيّدَكَ اللّه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9212&r=&rc=69",""]],"verses":[["غَسَلوهُ بِدَمِ الطَعنِ وَما","كَفَّنوهُ غَيرَ بَوغاءِ الثَرى",0,"ا",1,0],["غَسَلَتهُ حَتّى تَخالَ فَريداً","وَجُماناً عَن مَتنِهِ مَحدورا",1,"ر",2,0],["غَسَلَ الدَمعُ عَنكَ حَوبَةَ ماضي","كَ وَوَقّاكَ شَرَّ يَومِ الوَعيدِ",2,"د",1,0],["غسلنا وجوهاً من بجيلة لاصق","به حمم لم ينقها قبله الغسل",3,"ل",1,0],["غَسَلَتهُ وَكَوَتهُ","بِأَساليبَ لَطيفَه",4,"ف",2,0],["غَسَّ كَالحوتِ بِهِ وَاِقتَحَما","بَينَ عِبرَيهِ عُيونَ الحَرَسِ",5,"س",1,0],["غَسَلَ اليَمُّ جِراحاتِ الثَرى","وَمَحا الشِدَّةَ مَن يَمحو الرَخاء",5,"ا",2,0],["غَسَقٌ خِلتُ أَنَّ وَجهَ أَبي الفَت","حِ جَلاهُ بِنورِهِ البَزّاغِ",6,"غ",1,0],["غَسَلَ المَليكُ بِلادَهُ مِن أَهلِها","بِالماءِ إِذ جاؤوا بِسوءِ شَنارِ",7,"ر",1,1],["غَسَلَتهُ إِذ جَرى بِدَمعي","وَكَيفَ أَرقيهِ وَهوَ طاغِ",8,"غ",1,0],["غسلن به احكام سهم واشعر","ودرن مع القرآن حيث يدور",9,"ر",1,0],["غسَلَ البحرُ أخْمَصَيْها ، ورشَّتْ","عبِقاتُ النَّدى جِباهَ الرَّوابي",10,"ب",2,0],["غسل الوجود من الضغائن والهوى","لتحلّ روح الله فيه حلولا",11,"ل",2,0],["غسّان جنّ بها وهام أميّة","وهفا إليها الهاشميّ المعرق",12,"ق",1,0],["غسل الأسى قلبي وحسبك بالأسى","من غاسل حقد القلوب وماحي",13,"ح",2,0],["غسلت يدي منك وقلت ميت","ولكن ما علي له حقوق",14,"ق",1,0],["غَسلوهُ وأَخرجوا منهُ أَمرا","وَحشَوهُ الإيمانَ سرّاً وجهرا",15,"ر",2,0],["غَسَلَت روحُكِ بُؤسي وَشَقايا","وَنَما حُبٌّ جَديدٌ في دَمي",16,"ي",1,0],["غسلت من الكحل لعيون","وعن أناملها الخضاب",17,"ب",1,0],["غسَلْتَ أديمَ تلكَ الأرضِ منهمْ","بغَيْثٍ من دِمائِهم هَطول",18,"ل",1,0],["غسلته بدموع فوقه وكفت","يا ليت أجفانه كانت له جفنا",19,"ن",2,0],["غَسَّلَت خالِيَ المَلائِكَةُ الأَب","رارُ مَيتاً طوبى لَهُ مِن صَريعِ",20,"ع",1,0],["غَسَقٌ راحِلٌ وَدِيْكٌ صَدُوحٌ","فَأَجِبْ دَعْوَةَ المُنادِي الصَّدُوحِ",21,"ح",1,0],["غَسلَ البَدرُ بِالضِياءِ الظَلاما","وَبَكى وَالدُموعُ كانَت هِياما",22,"م",2,1],["غسآتي وأنت في حبس قطب إليه","دين تحت السبا لفي الأغلالِ",23,"ل",1,0],["غسله بالعراق ثم أتى","منزله في تمام ليلته",24,"ت",2,0],["غسلوه والمكرمات تنادي","بينهم لا تغسّلوه بماءِ",25,"ا",2,0],["غسلت سوادَ عيونها بدموعها","فصبغن أردية الكرام الصيد",26,"د",1,0],["غسلَ الحسامُ دمَ البريءِ على الثَّرى","بدمِ الخؤونِ فرُوِّع الثقلان",27,"ن",1,0],["غَسلوا الطهارةَ بالنجاسةِ فاغتدى","ثوبُ السلامِ ملوّنَ الأَردان",27,"ن",1,0],["غسلنه الدما وقلبه وطؤ","العوادي وكفنته البوادي",28,"د",2,0],["غسلوا هذه الدماء الغزارا","جاريات على الثرى تتبارى",29,"ر",2,0],["غسلن جلاده وبقين منه","مكان الفرج رأرأةً وهصرا",30,"ر",2,0],["غسَلت لِمَّتي بصُبحِ مَشِيبٍ","وَمَحت لَيلَةً عَليَّ كريمَة",31,"م",2,0],["غَسَلْتُ عن عِرْضي وعن عِرْضه","بها مَقالَ القائِلِ القابِحِ",32,"ح",1,0],["غَسَلْتُ به عن وجه مَجْدك قُتْمَةً","بُسرْعَةِ اَيّامٍ بها وليالي",33,"ل",2,0],["غسلت من كل محبوب سواك يدي","فكيف ترغب عن بري وإيناسي",34,"س",2,0],["غسلت العار عن جشم بن بكر","بجساس بن مرة ذي التبول",35,"ل",1,0],["غسلت عينه بما سكبتهُ","من ندى الدمع كل أدران نفسه",36,"س",2,0],["غسله جاري الدما قلبه","جري العوادي كفنته الترب",37,"ب",1,0],["غَسلُ اليَدَينِ لَدى الوُضوءِ نَظافَةٌ","أَمرَ النَبيُّ بِها عَلى اِستِحسانِ",38,"ن",1,0],["غَسَلَ النَبيُّ وَصَحبُهُ أَقدامَهُم","لَم يَختلف في غِسلهم رجلان",38,"ن",1,0],["غُسلُ الجَنابَةِ في الرِقابِ أَمانَةٌ","فَأَداءُها مِن أَكمَلِ الإِيمانِ",38,"ن",1,0],["غسلت مياه سيوفها صبغ الدجى","فتشابه الإصباح والإهزاع",39,"ع",1,0],["غَسَلتَ الطِرازَ الأَخضَرَ الرَقمَ مِنهُم","بِصَوتٍ نَجيعٍ أَحمَرَ القَطرِ ساجِمِ",40,"م",1,0],["غَسْلُ الفَوَارِسِ بِالدِّما","ءِ وَفِي بُطونِ الطَّيْرِ تُقْبَرْ",41,"ر",1,0],["غَسلَ العَواصِم أَمس مِن أَدرانِهم","وَاليَومَ ردّ بِهِ السّواحِلَ بَورا",42,"ر",2,0],["غسلته وطيبته الجوراي","وببردٍ كفنه وشعار",43,"ر",1,0],["غسلوه بالدمع وهو سخينٌ","وحشوهُ بعابقِ الأطياب",44,"ب",1,0],["غسلتها دماؤها قلبتها","أرجل الخيل كفنتها الرمال",45,"ل",1,0],["غسق وصبح شعره وجبينه","لذوي الهوى بهما الضلالة والهدى",46,"د",2,0],["غسلوا سواد أديمه بمدامع","تهمى سحائب وبلها وتصوب",47,"ب",1,0],["غسيل بدم النحر روحي فداؤه","عليه خيول الظالمين تجول",48,"ل",1,0],["غسلت بماء القلى شخصه","وكبرت من فوقه أربعا",49,"ع",2,0],["غسل «الدخانُ» من الشحوب جبينَه","وكم اكتسى من ثلجه بقَتام!!",50,"م",1,0],["غسقٌ تدلَّى والعلَا بشِهابِه","كواكبٌ غمزتْ إلى الجوزاء",51,"ا",2,0],["غَسّلتُ الطهرَ من ماء القوافي","وَكَحّلتْ القصائدَ دمعتانِ",52,"ن",1,0],["غسمع هديت وخير القول أنصحه","ولا تكن في استماع النصح ذا شطط",53,"ط",1,1],["غسلتك ودمعي من الحزن دنا","وكفنتك وروحي تعانقك بهيام",54,"م",1,0],["غَسَّلُونَا قَبْلَ مَوْتٍ فِي ثَرَانَا","ثُمَّ أَهْدُوا مَاءَ مَوْتِي لِلْخَبِيرْ",55,"ر",1,0],["غُسِلتْ ذنوبُك، يا أخي، فاستبشرتْ","رُوحٌ تَسَامتْ تَطمَئنُّ إليهِ",56,"ي",2,0],["غسَلَتْ جوانِبَنا الحياةُ بِزَيْفِها","فإذا بنا بكِتابِها لا نُلْصَقُ",57,"ق",1,0],["غسل عذابٍ محطمني وكاميته","ونثر بذور البشاير في بساتيني",58,"ن",2,0],["غسِّلْ يديك فلا ترجُ السناء بهم","ممن أتاك بنهج خانعٍ خَرِبِ",59,"ب",1,0],["غسلنا بنبع الحب رجس فعالهم","فأينع حقل الروح زهرا بنا يحفى",60,"ف",2,0],["غسَلتْ سرَّها بدمعٍ عصيٍٍّ","أوضحَ الدمعُ في العيونِ الكلاما",61,"م",2,0],["غَسَلُوا دِماغي، بَلْ أراهم لَوَّثُوا،","بالقَوْلِ: نَحْتَرِمُ الشُّعوبَ ونُعْتِقُ",62,"ق",1,0],["غسَلَتْ فؤادي بالرذاذ بدايةً","ثم انتشتْ روحي بثلجٍ جُمِّدَا",63,"د",2,0],["غسل الشاطىءَ من أدرانه","ورمى نحوي بأغلى الدُّرَرِ",64,"ر",1,0],["٦- غسَقُ الفؤادِ أناخَ تحت ضيائهِ","والليلُ شدَّ من الوجودِ رحالَهُ",65,"ل",2,0],["غسيلنا في بقاع الأرض مُنْتَشِرٌ","فيه الفضائحُ والإِسرَافُ في اللَّمَمِ",66,"م",1,0],["غسّلوها من خفاف..! وبالسنام.","دهّنوا ذيك الشوارب واللحى.",67,"ح",2,0],["غسلتْ دموعُكَ بالرِّضا أثقالَ حِم","لٍ في الدَّنا بهمومه أضناكا",68,"ك",2,0],["غسلوا بأمطار الجمالِ بصيرتي","وشعرتُ أنَّ الشعر أص