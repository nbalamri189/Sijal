{"poems":[[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[86,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[37,"ولولا أمير المؤمنين وذبه","https://www.aldiwan.net/poem7512.html","الطويل"],[85,"هرتي جد أليفه","https://www.aldiwan.net/poem7999.html","مجزوء الرمل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[66,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[46,"غسل المليك بلاده من أهلها","https://www.aldiwan.net/poem22711.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[94,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[94,"جمرة الدنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66291&r=&rc=9",""],[94,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[160,"دعوتك هاديا لك لو أطيق","https://www.aldiwan.net/poem58699.html","الوافر"],[189,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[223,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[290,"أسفا لقد طفىء السراج","https://www.aldiwan.net/poem11668.html","مجزوء الكامل"],[364,"أما تحية الطرف الكحيل","https://www.aldiwan.net/poem60801.html","الوافر"],[441,"رضى بما قدر الباري وألزمنا","https://www.aldiwan.net/poem14486.html","البسيط"],[470,"فخرت وانتمت فقلت ذريني","https://www.aldiwan.net/poem4762.html","الخفيف"],[567,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"]],"verses":[["غَسَلوهُ بِدَمِ الطَعنِ وَما","كَفَّنوهُ غَيرَ بَوغاءِ الثَرى",0,"ا",1,0],["غَسَلَتهُ حَتّى تَخالَ فَريداً","وَجُماناً عَن مَتنِهِ مَحدورا",1,"ر",2,0],["غَسَلَ الدَمعُ عَنكَ حَوبَةَ ماضي","كَ وَوَقّاكَ شَرَّ يَومِ الوَعيدِ",2,"د",1,0],["غسلنا وجوهاً من بجيلة لاصق","به حمم لم ينقها قبله الغسل",3,"ل",1,0],["غَسَلَتهُ وَكَوَتهُ","بِأَساليبَ لَطيفَه",4,"ف",2,0],["غَسَّ كَالحوتِ بِهِ وَاِقتَحَما","بَينَ عِبرَيهِ عُيونَ الحَرَسِ",5,"س",1,0],["غَسَلَ اليَمُّ جِراحاتِ الثَرى","وَمَحا الشِدَّةَ مَن يَمحو الرَخاء",5,"ا",2,0],["غَسَقٌ خِلتُ أَنَّ وَجهَ أَبي الفَت","حِ جَلاهُ بِنورِهِ البَزّاغِ",6,"غ",1,0],["غَسَلَ المَليكُ بِلادَهُ مِن أَهلِها","بِالماءِ إِذ جاؤوا بِسوءِ شَنارِ",7,"ر",1,1],["غَسَلَتهُ إِذ جَرى بِدَمعي","وَكَيفَ أَرقيهِ وَهوَ طاغِ",8,"غ",1,0],["غسَلَ البحرُ أخْمَصَيْها ، ورشَّتْ","عبِقاتُ النَّدى جِباهَ الرَّوابي",9,"ب",2,0],["غسل الوجود من الضغائن والهوى","لتحلّ روح الله فيه حلولا",10,"ل",2,0],["غسّان جنّ بها وهام أميّة","وهفا إليها الهاشميّ المعرق",11,"ق",1,0],["غسل الأسى قلبي وحسبك بالأسى","من غاسل حقد القلوب وماحي",12,"ح",2,0],["غسلت يدي منك وقلت ميت","ولكن ما علي له حقوق",13,"ق",1,0],["غَسلوهُ وأَخرجوا منهُ أَمرا","وَحشَوهُ الإيمانَ سرّاً وجهرا",14,"ر",2,0],["غَسَلَت روحُكِ بُؤسي وَشَقايا","وَنَما حُبٌّ جَديدٌ في دَمي",15,"ي",1,0],["غسلت من الكحل لعيون","وعن أناملها الخضاب",16,"ب",1,0],["غسَلْتَ أديمَ تلكَ الأرضِ منهمْ","بغَيْثٍ من دِمائِهم هَطول",17,"ل",1,0],["غسلته بدموع فوقه وكفت","يا ليت أجفانه كانت له جفنا",18,"ن",2,0],["غَسَّلَت خالِيَ المَلائِكَةُ الأَب","رارُ مَيتاً طوبى لَهُ مِن صَريعِ",19,"ع",1,0],["غَسَقٌ راحِلٌ وَدِيْكٌ صَدُوحٌ","فَأَجِبْ دَعْوَةَ المُنادِي الصَّدُوحِ",20,"ح",1,0]]}