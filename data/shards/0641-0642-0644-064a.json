{"poems":[[53,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[87,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[58,"احل وامرر معا ولن تارة واخشن","https://www.aldiwan.net/poem58528.html","البسيط"],[47,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[99,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[113,"من لوجدي وحيرتي والتهابي","https://www.aldiwan.net/poem16216.html","الطويل"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[240,"ليهنك أن عيني ما تنام","https://www.aldiwan.net/poem31761.html","الوافر"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[309,"غزال الحمى قلبي بحبك قد ملى","https://www.aldiwan.net/poem16887.html","الطويل"],[325,"أعط ما استطعت للفقير وإن كنت","https://www.aldiwan.net/poem66872.html","الخفيف"],[343,"اسأل العرف إن سألت كريما","https://www.aldiwan.net/poem68662.html","الخفيف"],[396,"رسول الله جئنا زائر ينا","https://www.aldiwan.net/poem54467.html","عموديه"],[396,"إذا شئت الدواء لكل داء","https://www.aldiwan.net/poem54640.html","عموديه"],[463,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[556,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[556,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[567,"مضى من كان أذكى من إياس","https://www.aldiwan.net/poem52674.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122813","الرمل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34402","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79921","الوافر"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144759","الطويل"],[1791,"","https://poetry.dctabudhabi.ae/diwan/poem/113902","الخفيف"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102110","الهزج"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201271","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134000","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88957","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62861","الخفيف"],[3572,"","https://poetry.dctabudhabi.ae/diwan/poem/146234","الطويل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133245","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77121","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133087","الطويل"],[4852,"سؤال الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=214359",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5112,"البدر الراحل","https://www.poetsgate.com/ViewPoem.aspx?id=212708",""],[5240,"بحيي للوصي أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=171242",""],[1680,"أتطلب أن تكون كثير مال","https://www.poetsgate.com/ViewPoem.aspx?id=108878",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5736,"فتات حديث","https://www.poetsgate.com/ViewPoem.aspx?id=211831",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6093,"قليل_ كثير","https://www.poetsgate.com/ViewPoem.aspx?id=206057",""],[6152,"صباح الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=206615",""]],"verses":[["فقليلٌ من جهلكم أن تظنوا","بحليم ظنونكم بمَهينِ",0,"ن",1,0],["فَقُل يا حَكيمَ الدَهرِ حَدِّث عَنِ البِلى","فَأَنتَ عَليمٌ بِالأُمورِ خَبيرُ",1,"ر",1,0],["فقليلٌ منَ الوَرى مَنْ تَراهُ","يُرْتَجَى أَو يَصونُ عِرْضاً بمالِ",2,"ل",1,0],["فَقَليلٌ فيما يُلاقيهِ أَهلُ ال","حُبِّ طولُ المَلامِ وَالتَعنيفِ",3,"ف",1,0],["فقليل من السعادة لا يكمل فيه ولا يطول الهناء","فحنين فلوعة فاحتراق فجحيم وقوده الشهداء",4,"ا",2,0],["فَقَليل إِذا خَلعت عَلَيها","لا بِمنّ روحي وَبَرد شَبابي",5,"ب",2,0],["فقل يا رسول الله أنت نصيرنا","على فتن في وقتنا تتقرع",6,"ع",1,0],["فَقُل يا دَهرُ لِلبُخَلاءِ عَنّي","حَظَرتُ عَلَيَّ ما يَهَبُ اللِئامُ",7,"م",1,0],["فقل يا عبادَ الله جاروا خصومَكم","بتَوسيع ديني أو بتطبيق سنتي",8,"ي",1,0],["فقل يا عباد اللَه من كل مؤمن","تقى منيب خاشع متبتل",9,"ل",1,0],["فَقَليلُ الفَقيرِ مِنهُ كَثيرُ","وَكَثيرُ الغِنى مِنهُ قَليلُ",10,"ل",1,0],["فَقَليلُ الشَريفُ يُكسِبُ مَجداً","وَكَثيرُ الوَضيعِ يُكسِبُ عارا",11,"ر",2,0],["فقل ياسيدي حقا نصرتهم","وفزتم بالمطالب أجمعينا",12,"ن",2,0],["فقل يا رب حنا باخرى","كما فرحتنا في ذي الدناء",13,"ا",2,0],["فقل يأسا يَمتْ أملي فإني","أُحلُّك من دم الأمل الحرامِ",14,"م",1,0],["فقلْ يا صاحبَ الإيوا","نِ لم ينجِك إيوانُ",15,"ن",1,0],["فقليلُهُ وضَحَ الضُّحى مُستكثَرٌ","وكثيرُهُ غَبَشَ الظّلامِ قليلُ",16,"ل",1,0],["فقُلْ يا اُبنَ الكَرامةِ قِرَّ عيناً","لبُطرسَ أرِّخوهُ خِتامُ خَيرِ",17,"ر",1,0],["فَقَليبُ الحَيَّ لا يَروَى بِها","حاتِمٌ إلاَّ بِدَلوٍ وَشَطَن",18,"ن",1,0],["فَقُل يا أَحمد بن عليٍّ اِذهَب","إِلى دارِ النَعيم بِلا شَقاءِ",19,"ا",2,0],["فقل يسمع واشفع تشفع وسلني","أعطك اليوم رتبة التصدير",20,"ر",1,0],["فقل يا بحرُ مدُّك رهن جزرٍ","وقل يا بدرُ تمُّك لانتقاص",21,"ص",1,0],["فقل يا عريض الجاه وأفاك لائذاً","بعلياك من هيضت قوادمه وهنا",22,"ن",2,0],["فقليل مع الوئام كثير","وكثير مع الخلاف حطام",23,"م",1,0],["فقُل يا روحُ تسلم","وتبقى للوصال",24,"ل",1,0],["فَقَليلٌ شِقوَتي في حُبِّها","وَاِحتِمالي كُلَّ غُرمٍ مُثقِلِ",25,"ل",1,0],["فقل يا مدّعين الشعر زوراً","أبتْ دعواكمُ أن تثبتوها",26,"و",3,0],["فقل يا بني الفيوم قد عالكم اب","رحيم وأنتم قبل ذلك ايتام",27,"م",1,0],["فقل يا دولتي زمن التهاني","بحج ثم ملكٍ في اتصال",28,"ل",1,0],["فقليلٌ من الكريمِ كَثيرٌ","وكثيرٌ من اللئيمِ قَلِيلُ",29,"ل",1,0],["فقل يا أمير المؤمنين فإنّما","أتيناك كي تقضي إذا وضح الأمر",30,"ر",1,0],["فَقَليلُ مائِكَ في وُضوئِكَ خَدعَةٌ","لِتَعودَ صِحَّتُهُ إِلى البُطلانِ",31,"ن",1,0],["فقل يا شفيع المذنبين استغاثة","وشكوى أتت من عبد رق لسيد",32,"د",1,0],["فقل يا خير خلق الله عندى","رسالة مرتج حسن ادكار",33,"ر",1,0],["فَقَليلى وَلَو حَرِصتُ سَواءَ","حينَ أَسمو لِعَدَّها وَكَثيري",34,"ر",2,0],["فقل يا فقيه القوم غوثاً ونجدةً","لمن في تريم في المهولات قد بلى",35,"ل",2,0],["فقل يا رجال الله هيا بغارةٍ","ننال بها المطلوب من كل مأملِ",35,"ل",1,0],["فقل يا سهدُ ..-باسم الله- أَقسِمْ ..","أأسري حولَ مَن يسري خلالي؟",36,"ل",2,0],["فقل يا يشوع العصر هل لك قدرةٌ","على الشمس تلوي الشمس باليد ثانيا",37,"ي",2,0],["فَقَلِيلٌ إِنْ قِيلَ شُجَاعٌ","وَيَسِيرٌ يَا لَكَ مَنْ جَسْرِ!",38,"ر",1,0],["فقل يالائمي في حبه هم","روافض إذ هموا حبوا عليا",39,"ي",2,0],["فقل يا حي يا قيوم ألفا","مكملة على عدد الليالي",40,"ل",2,0],["فقل يارب خفّف وطأ ذنبي","وهب لي من لدنك الحسنيين",41,"ن",1,0],["فقليلُ ما تفضي العيونُ لبعضها","هو زادُ روحٍ، حبّذا لو أكثرا",42,"ر",2,0],["فقَليلُ الوفاءِ صارَ قعِيدًا","وَكَثيرُ العَداءِ ، سهلَ المَنالِ",43,"ل",1,0],["فقليلُ الهواءِ يحييْ شُموعاً","وكثيرُ الهواءِ يطفيءُ شَمْعَةْ",44,"ع",2,0],["فقل يا رب زدني منك علما","وتوفيقا, وإحسانا وجُودا",45,"د",2,0]]}