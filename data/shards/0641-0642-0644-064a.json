{"poems":[[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[85,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[56,"احل وامرر معا ولن تارة واخشن","https://www.aldiwan.net/poem58528.html","البسيط"],[45,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[97,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[109,"من لوجدي وحيرتي والتهابي","https://www.aldiwan.net/poem16216.html","الطويل"],[231,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[235,"ليهنك أن عيني ما تنام","https://www.aldiwan.net/poem31761.html","الوافر"],[270,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[304,"غزال الحمى قلبي بحبك قد ملى","https://www.aldiwan.net/poem16887.html","الطويل"],[320,"أعط ما استطعت للفقير وإن كنت","https://www.aldiwan.net/poem66872.html","الخفيف"],[338,"اسأل العرف إن سألت كريما","https://www.aldiwan.net/poem68662.html","الخفيف"],[391,"رسول الله جئنا زائر ينا","https://www.aldiwan.net/poem54467.html","عموديه"],[391,"إذا شئت الدواء لكل داء","https://www.aldiwan.net/poem54640.html","عموديه"],[458,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[551,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[562,"مضى من كان أذكى من إياس","https://www.aldiwan.net/poem52674.html","الوافر"]],"verses":[["فقليلٌ من جهلكم أن تظنوا","بحليم ظنونكم بمَهينِ",0,"ن",1,0],["فَقُل يا حَكيمَ الدَهرِ حَدِّث عَنِ البِلى","فَأَنتَ عَليمٌ بِالأُمورِ خَبيرُ",1,"ر",1,0],["فقليلٌ منَ الوَرى مَنْ تَراهُ","يُرْتَجَى أَو يَصونُ عِرْضاً بمالِ",2,"ل",1,0],["فَقَليلٌ فيما يُلاقيهِ أَهلُ ال","حُبِّ طولُ المَلامِ وَالتَعنيفِ",3,"ف",1,0],["فقليل من السعادة لا يكمل فيه ولا يطول الهناء","فحنين فلوعة فاحتراق فجحيم وقوده الشهداء",4,"ا",2,0],["فَقَليل إِذا خَلعت عَلَيها","لا بِمنّ روحي وَبَرد شَبابي",5,"ي",1,0],["فقل يا رسول الله أنت نصيرنا","على فتن في وقتنا تتقرع",6,"ع",1,0],["فَقُل يا دَهرُ لِلبُخَلاءِ عَنّي","حَظَرتُ عَلَيَّ ما يَهَبُ اللِئامُ",7,"م",1,0],["فقل يا عبادَ الله جاروا خصومَكم","بتَوسيع ديني أو بتطبيق سنتي",8,"ي",1,0],["فقل يا عباد اللَه من كل مؤمن","تقى منيب خاشع متبتل",9,"ل",1,0],["فَقَليلُ الفَقيرِ مِنهُ كَثيرُ","وَكَثيرُ الغِنى مِنهُ قَليلُ",10,"ل",1,0],["فَقَليلُ الشَريفُ يُكسِبُ مَجداً","وَكَثيرُ الوَضيعِ يُكسِبُ عارا",11,"ر",2,0],["فقل ياسيدي حقا نصرتهم","وفزتم بالمطالب أجمعينا",12,"ن",2,0],["فقل يا رب حنا باخرى","كما فرحتنا في ذي الدناء",13,"ا",2,0],["فقل يأسا يَمتْ أملي فإني","أُحلُّك من دم الأمل الحرامِ",14,"م",1,0],["فقلْ يا صاحبَ الإيوا","نِ لم ينجِك إيوانُ",15,"ن",1,0],["فقليلُهُ وضَحَ الضُّحى مُستكثَرٌ","وكثيرُهُ غَبَشَ الظّلامِ قليلُ",16,"ل",1,0],["فقُلْ يا اُبنَ الكَرامةِ قِرَّ عيناً","لبُطرسَ أرِّخوهُ خِتامُ خَيرِ",17,"ر",1,0]]}