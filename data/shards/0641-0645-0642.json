{"poems":[[53,"لك ريحان وراح ومجيدات ملاح","https://www.aldiwan.net/poem9410.html","مجزوء الرمل"],[53,"الحزن منحل ومنعقد","https://www.aldiwan.net/poem61950.html","أحذ الكامل"],[45,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[63,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[68,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[50,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[48,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[132,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[136,"في اجتناب الأتاي للمرء ذام","https://www.aldiwan.net/poem54743.html","الخفيف"],[147,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[154,"رضا الله أعلى ما ارتجته عبيده","https://www.aldiwan.net/poem68493.html","الطويل"],[154,"تبارك رب عمنا بحبائه","https://www.aldiwan.net/poem68601.html","الطويل"],[159,"قل لمريض الحدق","https://www.aldiwan.net/poem55592.html","مجزوء الرجز"],[189,"انظر إلى ما ضمن ال","https://www.aldiwan.net/poem14524.html","مجزوء الكامل"],[280,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[382,"يا لحى الله علة التنكيد","https://www.aldiwan.net/poem59448.html","الخفيف"],[409,"سلام على أهل الحديث فإنني","https://www.aldiwan.net/poem33953.html","الطويل"],[412,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[422,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[463,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53911","البسيط"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44925","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136353","الخفيف"],[1356,"","https://poetry.dctabudhabi.ae/diwan/poem/200253","الكامل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102231","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79999","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69318","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177826","الكامل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34716","الوافر"],[2934,"","https://poetry.dctabudhabi.ae/diwan/poem/205191","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3605,"","https://poetry.dctabudhabi.ae/diwan/poem/130569","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117872","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36760","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36771","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36756","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70041","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58012","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72436","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72433","الطويل"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[5005,"ساحة الظلم..","https://www.poetsgate.com/ViewPoem.aspx?id=189344",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"بك وحيٌ وكلّهم أصنام ....","https://www.poetsgate.com/ViewPoem.aspx?id=202157",""],[5431,"بوح قصيدة ...","https://www.poetsgate.com/ViewPoem.aspx?id=209151",""],[5533,"مَنْزلة الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179262",""],[5956,"تصادُمُ السمُوِّ بالدنُوِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193936",""]],"verses":[["فَمُقَبَّاهُ رَشِيقٌ","ومُخَبَّاهُ رَدَاحُ",0,"ح",1,0],["فَمُقَيِّضٌ تشقى الجفون به","ومُفَتِّتٌ تشقى به الكبدُ",1,"د",1,0],["فَمَقيلُ حُبِّ مُحِبِّهِ فَرِحٌ بِهِ","وَمَقيلُ غَيظِ عَدُوِّهِ مَقروحُ",2,"ح",1,0],["فمُقتَبِسٌ مِنَ المِصباحِ نُوراً","ومُغتَرِفٌ من التَّيَّارِ صَفوا",3,"و",2,0],["فَمُقامُ الصُحاةِ بَينَ السُكارى","كَمُقامِ القُعودِ بَينَ النِيامِ",4,"م",1,0],["فَمُقعَصٌ أُثبِتَ في سَحرِهِ","وَخاضِبٌ مِن دَمِهِ الطينا",5,"ن",2,0],["فَمَقتاً لِما أَورَثوا مِن غِنىً","وَما وَهَبوهُ مِن النائِلِ",6,"ل",1,0],["فمقبض هذا السيف دون ذبابه","ومقبض ذاك السيف دون الحمائل",7,"ل",1,0],["فمقالُهم في كل شيءٍ حِكمةٌ","ومقالُ غيرهم لَغّى وهَباءُ",8,"ا",2,0],["فَمُقِيمٌ أخُو مُقَامٍ بِأرضٍ","لَيسَ فِيها تَنحَطُّ مِنهُ المَقَامُ",9,"م",1,0],["فَمَقيلُهُم بِفَناءِ دَوحٍ لَم يَزَل","عَذباً جَناهُ ظَليلَةً أَفنانُهُ",10,"ن",2,0],["فمقول ذا عالي الخطاب فصيحهُ","وصارم ذي ماضي الغرار حديده",11,"د",2,0],["فِمِقدارُهُ أَعلى وَمرآهُ أَبهَجُ","فَدَيناهُ بالأَرواحِ لَو كانَ يُفتَدى",12,"د",2,0],["فَمُقلَتي أَجْفانُها","مَكْحُولَةٌ بِالأَرَقِ",13,"ق",1,0],["فمُقامُه في البيتِ أن","فعُ فيه من نَمَطٍ وسِتر",14,"ر",1,0],["فَمَقالُهُ أَرْشِدْ بِهِ وَفِعالُهُ","مِمَّا يَزيدُ قُلوبَنا إِيمانا",15,"ن",2,0],["فمقام العفيف في دار نهمٍ","كمقام المسيح بين اليهود",16,"د",1,0],["فمقتدياً في الحق كن لا مقلداً","وخل أخا التقليد في الأسر بالقد",17,"د",1,0],["فَمِقبَضُ سَيفه مَجرى العَطايا","ومضربُ سيفهِ مَجرى النَجيعِ",18,"ع",1,0],["فمقامك المحمودُ فوقَ مقامهم","وعلى الجميع لِواؤك المعقود",19,"د",1,0],["فمقرِّ أَبعَلَ لي إِلى حَرُّ وجَةٍ","فالكردَمِيَّاتِ التي وَكَفَى التى",20,"ت",2,0],["فَمقعَصٌ ناشِزٌ عنهُ حلائِلُهُ","ومُرْضَعٌ ذاهِلٌ عنهُ مَراضِعُهُ",21,"ع",2,0],["فَمقيل جسمي في ذبولِ ربوعهم","كافٍ وشربي من فواضل أدمعي",22,"ع",2,0],["فمقدتياً بالحق كن لا مقلداً","تفز إقتفاء هدى النبي محمد",23,"د",1,0],["فمِقْوَلي قاصرٌ عن وصفه أبداً","ولو غدا عاضدي في وصفه الأدبُ",24,"ب",1,0],["فَمَقتُ كَتَبَهُ سُطوراً","تَنمِقُ الشَوقَ في القُلوب",25,"ب",1,0],["فمقامي في الحب يشهد اني","لذت في حبه بحصن حصين",26,"ن",1,0],["فمقالتي ما إن مللت وإنما","عمري أبى حمل النّجاد ومنكبي",27,"ب",2,0],["فمقامُه بين الملوكِ مقدِّم","وثناؤهُ من بينهم مِعطارُ",28,"ر",1,0],["فمقعداه للتقى والندى","وحاجباه العزُّ والسؤدد",29,"د",1,0],["فَمُقَدَّمٌ في الفَضلِ مِثلُ مُؤَخَّرٍ","وَمُؤَخَّرٌ في الفَضلِ مِثلُ مُقَدَّمِ",30,"م",1,0],["فمقبل طورا وطورا ماسح","أركانها ومردد لتحية",31,"ه",1,0],["فَمَقتولٌ وَمَأسورٌ","إِذا خَرِبَت مَشاعِرُها",32,"ر",3,0],["فمقولي الماضي وثانيه مفصلي","وثالث صدق من وفاء ومن لبّ",33,"ب",1,0],["فمقام ولايته الكبرى","عن أمر الله له صير",34,"ر",1,0],["فمقتضى القانون انه الى","ولد اخيه امثلا فأمثلا",35,"ل",2,0],["فمُقامي بها كيُوسُفِ مِصرٍ","في مُقام السُجون لا في المَقامِ",36,"م",1,0],["فمقلدي من ليس ينطق عن هوى","لأكون يوم الحشر تحت لوائه",37,"ا",3,0],["فَمَقيلِ هاتيكَ الرُبا","فَظِلالُ هاتيكَ السَلَم",38,"م",1,0],["فَمَقيل هاتيكَ الرُبى","فَظِلال هاتيكَ الفَنَن",39,"ن",1,0],["فَمَقاماتُهُ لِذا قَد تَعالَت","عَن شَبيهٍ كَما اِعتَلَت عَن نَظيرِ",40,"ر",1,0],["فَمَقام رَب العَرشِ في ذا أَرخوا","وَمَقام ميخائيل بَينَ شُيوخِهِ",41,"ه",1,0],["فمقام إبراهيم يعلو صارخاً","حزناً عليك وحجر إسماعيلا",42,"ل",2,0],["فمقطِّعٌ للخائفين قلوبَهُمْ","ذَكَرَ الخلودَ إذاً بِلاَ مَحْدُودِ",43,"د",1,0],["فمقلتي تنثر دمعا حكى","نثر عقود الدرِّ من سمطك",44,"ك",1,0],["فمقلته تلك المصيبة إنها","لأم الدواهي والدواهي لمن أضنى",45,"ن",2,0],["فمقعره أوج الجميع وأوجها","لها المركز الحاوي صنائع إتقان",46,"ن",1,0],["فمقالة المظلوم ليست تنتهي","حتى تنال النصر فيه الموقعة",47,"ع",2,0],["فمقتدياً في الدين كمن لا مقلداً","طريق الصواب الحق قد كان قيما",48,"م",2,0],["فمقام الشعر الأغرّ علوٌ","تنزفُ الروحَ عنده الأقلامُ",49,"م",1,0],["فمقاسي على مقاسك شعرا","ومقامي بين الجواهر أغلى",50,"ل",2,0],["فمَقامُهُ جَنَّاتُ عَدْنٍ رِيحُها","مَعْجُونَةٌ بالطِّيب تَدْعو من رَغِبْ",51,"ب",1,0],["فمقدار ما دلَّلْتُه -حسْبَ طيبتي -","يذلِّلني بالجهلِ دون تعقُّلِ",52,"ل",1,0]]}