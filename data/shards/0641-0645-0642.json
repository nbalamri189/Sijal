{"poems":[[51,"لك ريحان وراح ومجيدات ملاح","https://www.aldiwan.net/poem9410.html","مجزوء الرمل"],[51,"الحزن منحل ومنعقد","https://www.aldiwan.net/poem61950.html","أحذ الكامل"],[43,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[61,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[66,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[48,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[46,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[129,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[133,"في اجتناب الأتاي للمرء ذام","https://www.aldiwan.net/poem54743.html","الخفيف"],[144,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[151,"رضا الله أعلى ما ارتجته عبيده","https://www.aldiwan.net/poem68493.html","الطويل"],[151,"تبارك رب عمنا بحبائه","https://www.aldiwan.net/poem68601.html","الطويل"],[156,"قل لمريض الحدق","https://www.aldiwan.net/poem55592.html","مجزوء الرجز"],[186,"انظر إلى ما ضمن ال","https://www.aldiwan.net/poem14524.html","مجزوء الكامل"],[276,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[378,"يا لحى الله علة التنكيد","https://www.aldiwan.net/poem59448.html","الخفيف"],[404,"سلام على أهل الحديث فإنني","https://www.aldiwan.net/poem33953.html","الطويل"],[407,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[417,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"],[433,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[440,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[459,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["فَمُقَبَّاهُ رَشِيقٌ","ومُخَبَّاهُ رَدَاحُ",0,"ح",1,0],["فَمُقَيِّضٌ تشقى الجفون به","ومُفَتِّتٌ تشقى به الكبدُ",1,"د",1,0],["فَمَقيلُ حُبِّ مُحِبِّهِ فَرِحٌ بِهِ","وَمَقيلُ غَيظِ عَدُوِّهِ مَقروحُ",2,"ح",1,0],["فمُقتَبِسٌ مِنَ المِصباحِ نُوراً","ومُغتَرِفٌ من التَّيَّارِ صَفوا",3,"و",2,0],["فَمُقامُ الصُحاةِ بَينَ السُكارى","كَمُقامِ القُعودِ بَينَ النِيامِ",4,"م",1,0],["فَمُقعَصٌ أُثبِتَ في سَحرِهِ","وَخاضِبٌ مِن دَمِهِ الطينا",5,"ن",2,0],["فَمَقتاً لِما أَورَثوا مِن غِنىً","وَما وَهَبوهُ مِن النائِلِ",6,"ل",1,0],["فمقبض هذا السيف دون ذبابه","ومقبض ذاك السيف دون الحمائل",7,"ل",1,0],["فمقالُهم في كل شيءٍ حِكمةٌ","ومقالُ غيرهم لَغّى وهَباءُ",8,"ا",2,0],["فَمُقِيمٌ أخُو مُقَامٍ بِأرضٍ","لَيسَ فِيها تَنحَطُّ مِنهُ المَقَامُ",9,"م",1,0],["فَمَقيلُهُم بِفَناءِ دَوحٍ لَم يَزَل","عَذباً جَناهُ ظَليلَةً أَفنانُهُ",10,"ن",2,0],["فمقول ذا عالي الخطاب فصيحهُ","وصارم ذي ماضي الغرار حديده",11,"د",2,0],["فِمِقدارُهُ أَعلى وَمرآهُ أَبهَجُ","فَدَيناهُ بالأَرواحِ لَو كانَ يُفتَدى",12,"د",2,0],["فَمُقلَتي أَجْفانُها","مَكْحُولَةٌ بِالأَرَقِ",13,"ق",1,0],["فمُقامُه في البيتِ أن","فعُ فيه من نَمَطٍ وسِتر",14,"ر",1,0],["فَمَقالُهُ أَرْشِدْ بِهِ وَفِعالُهُ","مِمَّا يَزيدُ قُلوبَنا إِيمانا",15,"ن",2,0],["فمقام العفيف في دار نهمٍ","كمقام المسيح بين اليهود",16,"د",1,0],["فمقتدياً في الحق كن لا مقلداً","وخل أخا التقليد في الأسر بالقد",17,"د",1,0],["فَمِقبَضُ سَيفه مَجرى العَطايا","ومضربُ سيفهِ مَجرى النَجيعِ",18,"ع",1,0],["فمقامك المحمودُ فوقَ مقامهم","وعلى الجميع لِواؤك المعقود",19,"د",1,0],["فمقرِّ أَبعَلَ لي إِلى حَرُّ وجَةٍ","فالكردَمِيَّاتِ التي وَكَفَى التى",20,"ت",2,0],["فَمقعَصٌ ناشِزٌ عنهُ حلائِلُهُ","ومُرْضَعٌ ذاهِلٌ عنهُ مَراضِعُهُ",21,"ع",2,0],["فَمقيل جسمي في ذبولِ ربوعهم","كافٍ وشربي من فواضل أدمعي",22,"ع",2,0],["فمقدتياً بالحق كن لا مقلداً","تفز إقتفاء هدى النبي محمد",23,"د",1,0]]}