aldiwan.net/poem63931.html","الكامل"],[50,"يا بان ضاق المذهب","https://www.aldiwan.net/poem64810.html","مجزوء الكامل"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[50,"يا صاح دعني فإنني نصب","https://www.aldiwan.net/poem64857.html","المنسرح"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[46,"الحمد لله ما في الأرض وادعة","https://www.aldiwan.net/poem22335.html","البسيط"],[46,"يا صاع لست أريد صاع مكيلة","https://www.aldiwan.net/poem22438.html","الكامل"],[46,"سميت نجلك مسعودا وصادفه","https://www.aldiwan.net/poem22471.html","البسيط"],[46,"أوى ربي إلي فما وقوفي","https://www.aldiwan.net/poem22692.html","الوافر"],[46,"عوى في سواد الليل عاف لعله","https://www.aldiwan.net/poem22994.html","الطويل"],[46,"أوالي هذا المصر في زي واحد","https://www.aldiwan.net/poem23213.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[68,"عوذت حبيبي بربِ الطور","https://www.aldiwan.net/poem1501.html",""],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85648","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140997",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42708","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42590","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54545","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55186","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142008","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1926","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"مداعبة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179527",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[100,"خدعة","https://www.poetsgate.com/ViewPoem.aspx?id=50386",""],[50,"يَا عَبْدَ بَاهِلة َ الذي يَتوعَّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=21776",""],[98,"عودوا إلى تلك القرى","https://www.poetsgate.com/ViewPoem.aspx?id=55335",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"ذات الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=179215",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[45,"قَد فقَدْنا الوَفاءَ فَقدَ الحَميمِ","https://www.poetsgate.com/ViewPoem.aspx?id=32045",""],[45,"شَطَّ مِنْ ساكِنِ الغُوَيْرِ مَزَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31263",""],[91,"العيون السود","https://www.poetsgate.com/ViewPoem.aspx?id=14091",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[0,"لمن الديار غشيتها بسحام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14338&r=&rc=14",""]],"verses":[["عَوائِدُ مِن تَذَكُّرِ آلِ لَيلى","كَأَنَّ لَها عَلى قَلبي دُيونا",0,"ن",2,0],["عَواطِفُ مِن مُقلِقاتِ الغَرا","مِ يَومَ دُموعي بِها أَروِنانُ",1,"ن",1,0],["عَوابِسُ إِن قُلِّقنَ يَوماً لِغايَةٍ","هَتَمنَ بِنا روقَ الرُبى وَالمَخارِمِ",2,"م",1,0],["عَوارٍ لا تَزالُ الدَهرَ حَتّى","تُجَلِّلَها بِرَيطٍ غَيرِ بالي",3,"ي",1,0],["عَوائِدُ مِن ذِكراكِ يَرقُصنَ في الحَشا","وَأَضرَمنَ ما بَينَ الذُؤابَةِ وَالنَعلِ",4,"ل",1,0],["عَواطِفُ الهَمِّ ما تَنفَكُّ تُرجِعُ لي","مِن ذاهِبٍ وَجَديدِ الوَجدِ مِن بالِ",5,"ل",1,0],["عَواصِبُ بِالتيجانِ فَوقَ جَماجِمٍ","وِضاءِ المَجالي واضِحاتِ المَفارِقِ",6,"ق",1,0],["عَوارٍ مِنَ الدُنيا يُهَوِّنُ فَقدَها","تَيَقُّنُنا أَنَّ العَوارِيَ لِلرَدِّ",7,"د",1,0],["عَوائِدُ هَمٍّ لايُحَيَّينَ غِبطَةً","بِهُنَّ وَلا تُلقى لَهُنَّ الوَسائِدُ",8,"د",1,0],["عَواريُّ مِن سَلَبِ الهالِكينَ","يَمُدُّ يَداً نَحوَها السالِبُ",9,"ب",1,0],["عودوا إِلى ذاكَ الغَدي","رِ وَقَلَّ ما غَدَرَ الرُبابُ",10,"ب",1,0],["عَوارِيَ إِلّا مِن دَمٍ فَتَأَت بِهِ","مَعاصِمُ مِن أَسرِ الرَدى وَرِقابُ",11,"ب",1,0],["عُوجاً إِلى رَجْعِ الحُداءِ الجَلْجالْ","لا عِزَّ إلا لرُوَيْعِي أشْوالْ",12,"ل",1,0],["عُونٌ تَكَدَّسَ بالنّفوسِ وعِندَها","في كُلِّ يومٍ مُهجَةٌ عَذْراءُ",13,"ا",2,0],["عَوالِيَ زُرقاً مِن رِماحِ رُدَينَةٍ","هَريرَ الكِلابِ يَتَّقينَ الأَفاعِيا",14,"ي",2,0],["عَوافِيَ لا يَصدُرنَ عَنهُ لِوِجهَةٍ","وَلا هُنَّ مِن بَردِ الحِياضِ دَوانِ",15,"ن",1,0],["عَوِّذْ كَمَالَ مَا اسْتَطَعْتَ فَإِنَّهُ","قَدْ تَنْقُصُ الأَشْيَاءُ مِمَّا تَكْمُلُ",16,"ل",1,0],["عُوِّضَتْ منْ دارِ الخُلودِ بمَنْزِلٍ","للخُلْدِ تَجْري تحْتَهُ أنْهارُهُ",17,"ر",2,0],["عُوجاً تُتيحُ لَها الرّياحُ أعنّةً","والسّاجَ جِسْماً والهِناء جُلودا",18,"د",2,0],["عُوجا علَى طَلَلِ الوُجودِ وبلِّغا","عنّي السّلامَ فلاتَ حينَ مَعاجِ",19,"ج",1,0],["عُوجاً كَأَمْثَالِ القِسِيِّ ضَوَامِراً","أَغْرَاضُهُنَّ الرُّكْنُ وَالْبَطْحَاءُ",20,"ا",2,0],["عَوَّدتَ كِندَةَ عادَةً فَاِصبِر لَها","اِغفِر لِجاهِلِها وَرَوِّ سِجالَها",21,"ل",3,0],["عَواسِلٌ كَرَعيلِ الرَبدِ أَفزَعَها","بِالسَيِّ مِن قانِصٍ شَلٌّ وَتَنفيرُ",22,"ر",1,0],["عوجِلَت مِثلَ أُختِها وَدَهاها","ما دَهاها مِن ذَلِكَ الثَوَرانِ",23,"ن",1,0],["عودي لِما أَصفَيتِنيهِ مِنَ الهَوى","بَدءاً فَلَستُ لِما كَرِهتِ بِعائِدِ",24,"د",1,0],["عُوَيرٌ وَمَن مِثلُ العُوَيرِ وَرَهطِهِ","وَأَسعَدَ في لَيلِ البَلابِلِ صَفوانِ",25,"ن",1,0],["عوجا عَلى الطَلَلِ المَحيلِ لِأَنَن","نَبكي الدِيارَ كَما بَكى اِبنُ خِذامِ",26,"م",1,0],["عَومَ المُعيدِ إِلى الرَجا قَذَفَت بِهِ","في اللُجَّ داوِيَةُ المَكانِ جَمومُ",27,"م",1,0],["عَوى ناشِزَ الحَيزومِ مُضطَمِرَ الحَشا","يُعالِجُ لَيلاً قارِساً مَعَ جوعِ",28,"ع",1,0],["عَوانٌ ضَروسٌ ما يُنادى وَليدُها","تَلَقَّحُ بِالمُرّانِ حَتّى اِستَمَرَّتِ",29,"ت",1,0],["عود إلى ما كنت منه شاكياً","فاسمع وانصفنا من التجار",30,"ر",1,0],["عُودُوا إِلَى البَلَدِ الأَمِينِ وَغَادِرُوا","بَلَداً لِبُعْدِ النَّاسِ غَيْرَ أَمِينِ",31,"ن",1,0],["عُودُوا إِلَى حَيْثُ النَّمَائِمُ وَالأَذَى","وَالعَيْشُ بَيْنَ وَسَاوِسٍ وَظُنُونِ",31,"ن",1,0],["عَوْدُكِ المَحْمُودُ عِيدٌ لِلْحِمَى","وَلأَهْلِيهِ عَلَى مَرِّ السِّنِينْ",32,"ن",1,0],["عُودَا بنا نَعْرِضْ جُهُوداً كَرَّسَتْ","لِلْمَجْدِ صَرْحاً بَاذِخَ البُنْيَانِ",33,"ن",1,0],["عُودِي إِلَى الفِنْجَانِ أَيْنَ شُمُوسُهُ","وَالطَّائِفَاتُ بِهَا مِنَ الأَكْوَانِ",34,"ن",1,0],["عَوَّذْتَ بِاللهِ مِنْ غَرْثَى الْعُيُونِ أَخاً","يَعْدُو الأَنَاقَةَ إِلَى النَّهَمِ",35,"م",1,0],["عُودُوا إِلَى سَيْرِ التَّارِيخِ لا تَجِدُوا","شَعْباً قَضَى غَيْرَ مضنْ ضَلُّوا الْهُدَى وَعَمُوا",36,"م",3,0],["عَواطِفُ يَستَثبِتنَ في مَكنَسِ الضُحى","إِلى الهَجرِ أَفياءً بَطيئاً ضُهولُها",37,"ل",3,0],["عَوى مَرَئيٌّ لي فَعَصَّبتُ رَأسَهُ","عِصابَةَ خِزي لَيسَ يَبلى جَديُدها",38,"د",3,0],["عَواسِفَ الرَملِ يَستَقفي تَوالِيَها","مُستَبشِرٌ بِفِراقِ الحَيِّ غِرّيدُ",39,"د",1,0],["عوائدُ الله قد عُوِّدْتَ أفضلها","لتبلغ الخَلْقُ ما شاءت أمانيها",40,"ي",3,0],["عَوَّدْتَهَا أنْ ليس تقربُ منهلاً","حتى يُخالَطَ بالدم الموْارِ",41,"ر",1,0],["عود ثوى حجر القضيب رعى له","أيام كانا في الرياض مع الشَّجَرْ",42,"ر",1,0],["عوَّذتَني الصنع الجميلَ تَفَضّلاً","لا زلتَ خير مُعَوَّدٍ ومُعَوِّدِ",43,"د",1,0],["عوائد عمّت الدنيا مصائبُها","وإنما أنا في تلك المصيبات",44,"ت",1,0],["عَوَيتَ كَما عَوى لي مِن شَقاهُ","فَذاقوا النارَ وَاِشتَرَكوا العَذابا",45,"ب",2,0],["عَوَيتَ عُواءَ جَفنَةَ مِن بَعيدٍ","ف