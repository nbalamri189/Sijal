{"poems":[[55,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[93,"تركت النجم مثلك مستهاما","https://www.aldiwan.net/poem62741.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[108,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[113,"لك دار يا منيتي ما بين تلك القنى","https://www.aldiwan.net/poem16697.html","البسيط"],[132,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[287,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[287,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[303,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[379,"وصل الموصول كل علا","https://www.aldiwan.net/poem4131.html","المديد"],[449,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[463,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[520,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[572,"يا رب مهد هدية لطفت","https://www.aldiwan.net/poem69550.html","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48755","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48517","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64980","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82578","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93730","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200966","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132786","الرمل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53012","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48324","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99243","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102939","الخفيف"],[4733,"نشيدُ البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=192765",""],[4881,"فنجان قهوتي","https://www.poetsgate.com/ViewPoem.aspx?id=181729",""],[5739,"مصنع عبير..!","https://www.poetsgate.com/ViewPoem.aspx?id=135076",""],[402,"أمنوا بموتك صولة الرئبال","https://www.poetsgate.com/ViewPoem.aspx?id=36074",""],[5908,"أسفر الحي حين زارت نوار","https://www.poetsgate.com/ViewPoem.aspx?id=170973",""],[5956,"بعد فحصي ونجاحي","https://www.poetsgate.com/ViewPoem.aspx?id=181931",""],[6069,"لا تجزعن بقلبك المفتون","https://www.poetsgate.com/ViewPoem.aspx?id=105710",""],[6160,"مَرايا لِعُروَة ابنِ الوَرد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87098&r=&rc=15",""],[5126,"فكرة مُختلطة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87818&r=&rc=33",""]],"verses":[["لَكَ دونَ أَعراضِ الرِجا","لِ حَميَّةُ الرَجُلِ الغَيورِ",0,"ر",1,0],["لَكِدتَ تُعَلِّمُ الطَيرَ القَوافي","وَكِدتَ تُعَلِّمُ اللَيلَ الغَراما",1,"م",2,0],["لَكَ دُونَ مَا تَبْغِي مَضَاءُ مُصمِّم","لاَ يَنْثَنِي وبلاَءُ غَيرِ مُبَالِ أحأ",2,"ح",2,0],["لَكِ دَارَ العُلومِ في كُلِّ نَفْسٍ","أَثَرُ القَيْنِ في صِقَال الْحِرَابِ",3,"ب",1,0],["لك دولة لم ترهفي من أجلها","حدّ الحسام، ولم تقودي عسكرا",4,"ر",2,0],["لَك دار يا مَنيَتي ما بَين تِلكَ القنى","كَم مِن مَدامع جَرَت فيها وَعادَت قنى",5,"ن",2,1],["لك دونَ خلقِ اللهِ حظٌّ وافرٌ","منى ولى منك الكآبةُ والضَّنَا",6,"ن",2,0],["لَكَ دانَت خَوفاً فَراعِنَةُ الشا","مِ فَهَل كانَ فيهِ موسى الكَليمُ",7,"م",1,0],["لَكَ دَولَةٌ دُوَلُ المُلوكِ بِأَسرِها","في كُلِّ مَكرُمَةٍ لَها خُدامُ",8,"م",1,0],["لكدتُ بوحيِ نفسيَ قب","ل معرفةٍ أُناديكِ",9,"ك",1,0],["لك دون المُبتلي حسداً","آخرٌ قد زان أوَّلَه",10,"ل",2,0],["لك دولة ملكت عقول ذوي النهى","فليسم ملكك وليعز جمالك",11,"ك",1,0],["لك دونه شرفُ النهار وحظُّه","من ليله الإظلام والإسدافُ",12,"ف",1,0],["لك دون الأنام عقد ثنائي","فنتقد دره وعقد ولائي",13,"ا",2,0],["لَكِدْتُ مِنْ شِدَّةِ السُّرُورِ بِهِ","آمَنُ أَنَّ المَشِيْبَ يَشْتَعِلُ",14,"ل",1,0],["لك دعوة فوق المنابر منهمُ","سبقت إليك شعائر الحجّاج",15,"ج",1,0],["لك دعوة في الأرض ين","بو عن مضاربها الحسام",16,"م",1,0],["لك دُرُّ أَلفاظٍ ودَرُّ مواهبٍ","مِنْ ذاكَ تُقْرِئُني وذا تَقْربني",17,"ن",2,0],["لَك دوني الذَّنبُ ما كا","نَ فُؤادي في حِبالِك",18,"ك",1,0],["لَكَ دُون الناس مجد رَفيعٌ","ما تَرقى نَحوَهُ الفرقدان",19,"ن",1,0],["لك دَينٌ من الهجاء عليّا","سيؤدي إليك ميتا وحيّا",20,"ي",2,1],["لك دين فيه احكا","م واخلاق سنيه",21,"ي",2,1],["لك درُّ العقد مفرد","كنزُ درٍ فاكتنزه",22,"ه",1,0],["لكَ دولةُ العِزّ التي قد عزَّ مَن","أضْحى مُوالِيهَا وخابَ حَسودُها",23,"د",3,0],["لك داعياً وبنيك بالفتح المبي","ن وبالرقي بسر اشباح العبا",24,"ب",2,0],["لك دينٌ ولناسٍ غيرُهُ","ولبعضِ الناسِ أديانٌ أُخَرْ",25,"ر",1,0],["لك دأب الغنا ولي النوح دأب","أين من نشوة الغناء النواح",26,"ح",1,0],["لكَ دَينٌ في مَاءِ نَهري وزَرعي","لكَ دَينٌ في سَقفِنا والجِدارِ",27,"ر",1,0],["لك درع منك فيها منعة","إن يحاولْها الردى ينهزم",28,"م",1,0],["لك دعوةٍ حول المعاليق تجتاح.","وتُذكَر على مَرّ الزمان وقروني.",29,"ن",2,0],["لك دون ما تبغي مضاء مصمم","لا ينثني وبلاء غير مبال",30,"ل",1,0],["لك دام السرور في ظل مولى","هو للجود في الوجود المنار",31,"ر",1,0],["لك درسٌ يا ملاكي مثلُ درسي","والنجاحُ اليوم يدعونا سويّا",32,"ي",2,1],["لك دان هذا الملك بعد إيابه","وانقاد طوع يديك غير حرون",33,"ن",1,0],["لَكَ دينُكَ المَعبودُ، لي","شَكي، وَلي فِكري وَديني",34,"ن",2,0],["لكدتُ أُنكِره لولا تحققه","فيما أشاهدُ من سرٍ وإعلانِ",35,"ن",1,0]]}