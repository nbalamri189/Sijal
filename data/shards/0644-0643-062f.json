{"poems":[[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[91,"تركت النجم مثلك مستهاما","https://www.aldiwan.net/poem62741.html","عموديه"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[107,"لك دار يا منيتي ما بين تلك القنى","https://www.aldiwan.net/poem16697.html","البسيط"],[126,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[280,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[280,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[296,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[372,"وصل الموصول كل علا","https://www.aldiwan.net/poem4131.html","المديد"],[441,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[456,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[513,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[565,"يا رب مهد هدية لطفت","https://www.aldiwan.net/poem69550.html","المنسرح"]],"verses":[["لَكَ دونَ أَعراضِ الرِجا","لِ حَميَّةُ الرَجُلِ الغَيورِ",0,"ر",1,0],["لَكِدتَ تُعَلِّمُ الطَيرَ القَوافي","وَكِدتَ تُعَلِّمُ اللَيلَ الغَراما",1,"م",2,0],["لَكَ دُونَ مَا تَبْغِي مَضَاءُ مُصمِّم","لاَ يَنْثَنِي وبلاَءُ غَيرِ مُبَالِ أحأ",2,"ح",2,0],["لَكِ دَارَ العُلومِ في كُلِّ نَفْسٍ","أَثَرُ القَيْنِ في صِقَال الْحِرَابِ",3,"ب",1,0],["لك دولة لم ترهفي من أجلها","حدّ الحسام، ولم تقودي عسكرا",4,"ر",2,0],["لَك دار يا مَنيَتي ما بَين تِلكَ القنى","كَم مِن مَدامع جَرَت فيها وَعادَت قنى",5,"ن",2,1],["لك دونَ خلقِ اللهِ حظٌّ وافرٌ","منى ولى منك الكآبةُ والضَّنَا",6,"ن",2,0],["لَكَ دانَت خَوفاً فَراعِنَةُ الشا","مِ فَهَل كانَ فيهِ موسى الكَليمُ",7,"م",1,0],["لَكَ دَولَةٌ دُوَلُ المُلوكِ بِأَسرِها","في كُلِّ مَكرُمَةٍ لَها خُدامُ",8,"م",1,0],["لكدتُ بوحيِ نفسيَ قب","ل معرفةٍ أُناديكِ",9,"ك",1,0],["لك دون المُبتلي حسداً","آخرٌ قد زان أوَّلَه",10,"ل",2,0],["لك دولة ملكت عقول ذوي النهى","فليسم ملكك وليعز جمالك",11,"ك",1,0],["لك دونه شرفُ النهار وحظُّه","من ليله الإظلام والإسدافُ",12,"ف",1,0],["لك دون الأنام عقد ثنائي","فنتقد دره وعقد ولائي",13,"ا",2,0],["لَكِدْتُ مِنْ شِدَّةِ السُّرُورِ بِهِ","آمَنُ أَنَّ المَشِيْبَ يَشْتَعِلُ",14,"ل",1,0]]}