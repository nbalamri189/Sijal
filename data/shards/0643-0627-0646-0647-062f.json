{"poems":[[73,"قد زارني من بني الأتراك مختفياً","https://www.aldiwan.net/poem3966.html","البسيط"],[95,"قضيت عمري لا مستدينا","https://www.aldiwan.net/poem11212.html","مخلع البسيط"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[53,"غيره الكون والفساد","https://www.aldiwan.net/poem61948.html","مخلع البسيط"],[50,"دع الأطلال تسفيها الجنوب","https://www.aldiwan.net/poem10768.html","الوافر"],[50,"لا تبك ربعا عفا بذي سلم","https://www.aldiwan.net/poem65107.html","المنسرح"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[398,"بدت عذارى مدت سرادقها","https://www.aldiwan.net/poem53489.html","المنسرح"],[500,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104023","المنسرح"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93146","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95502","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109395","السريع"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102390","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102995","الطويل"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103286","البسيط"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146751","الطويل"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103136","الرجز"],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5444,"قصيدة غزة الكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=121999",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[4372,"ما أَعجَبَ الحُبَّ في مَذاهِبِه","https://www.poetsgate.com/ViewPoem.aspx?id=86430",""]],"verses":[["كَأَنَّهُ دُرَّةُ الغَوّاصِ كادَ يَرى","مِن قَبلِ رُؤيَتِها في كَفِّهِ التَلَفا",0,"ف",2,0],["كَأَنَّهُ دَوْحَةٌ عَلَى الشَّرْقِ","كُلِّهِ فَرَّعَتْ غُصُونَا",1,"ن",2,0],["كَأَنَّهُ دُملُجٌ مِن فِضَّةٍ نَبَهٌ","في مَلعَبٍ مِن عَذارى الحَيِّ مَفصومُ",2,"م",1,0],["كأنه دمنة أمحَّتْ","فكلُّ آثارها رمادُ",3,"د",1,0],["كَأَنَّ هَديرَها في الدَنِّ يَحكي","قِراةَ القَسِّ قابَلَهُ الصَليبُ",4,"ب",1,0],["كَأَنَّهُ دُرَّةٌ مُحَبَّرَةٌ","عَلَّقَها راهِبٌ عَلى صَنَمِ",5,"م",1,0],["كأن هدير الطبل يقرع سمعه","فلم يُلْفِ رجعاً للجواب فيرجع",6,"ع",1,0],["كَأَنَّهُ دارُنا وَلم يَرَها","ناعِبُها لِلنَوى وَناعِقُها",7,"ق",3,0],["كأن هدير الرعد ضجة ناشز","شكت من وميض البرق ضربة فالق",8,"ق",1,0],["كأنّه داودَ حينَ يُوقِظُه","يقرأُ فيهِ الزّبورَ والسُّورا",9,"ر",2,0],["كأنه درى وليت لا درى","أن المحرم الحرام اقتربا",10,"ب",2,0],["كأنه ديمةٌ جادت فكان لها","في دولة النّبتِ ما أزهى البساتينا",11,"ن",2,0],["كأنه داود في عصره","بالحكمة اختصَّ وفصل الخطاب",12,"ب",1,0],["كأنَّ هديرَ أعْيَسَ في مخاضٍ","وحُولٍ بالمرافضِ من رؤامِ",13,"م",1,0],["كأن هديل الطير في وكناتها","مزامير يتلوها عليك الشمامس",14,"س",1,0],["كأنَّه دمة أمحَّت","فكلُّ آثارها رمادُ",15,"د",1,0],["كأن هدير الموج فوق متونه","هدير قروم هاجهن الشوائل",16,"ل",1,0],["كأنه دمٌ جرى","على طلى بيضٍ وضح",17,"ح",1,0],["كأنه درة تهدى من الملإ ال","أعلى إلى الأرض تزري خالص التؤم",18,"م",1,0],["كأن هديل الساجعات على الربا","به زفرات الشوق وهو أسير",19,"ر",1,0],["كأن هدى الايات بين اكفهم","الى حيث نصر الله في القدس سلم",20,"م",1,0],["كأنَّهُ ديْدَنٌ تحْيا نوائِبَهُ","مُذْ بيْعِ أوْطانِنا منْ آلِ سرْكيسِ !",21,"س",1,0],["كَأَنَّهُ دُميَةٌ مُصَوَّرَةٌ","يَعبُدُها القَسُّ في مَحارِبِه",22,"ب",2,0]]}