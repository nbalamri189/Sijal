,[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107350","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69403","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110270","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77247","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93886","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205853","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67973","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66616","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136480",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72489","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139486",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5131,"ودَّعتُهُ وعلى فؤادي حسرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175584",""],[5183,"معنى الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=186497",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5500,"على سبيل الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=190252",""],[6152,"سفر للشتات","https://www.poetsgate.com/ViewPoem.aspx?id=204710",""],[6160,"في سُقُوطِ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87083&r=&rc=0",""]],"verses":[["وعلى سلوانها","بعد حب حملك",0,"ك",1,0],["وعلى سالفي .. غفا زر ورد","وقميص تفلتت منه عروة",1,"و",2,0],["وعلى سُلَيْمانَ النبيِّ فإنَّه","أغْرَى رِحالَيْهِ على بَلقِيسا",2,"س",2,0],["وَعَلَيَّ سورٌ مانِعٌ","مِن جَورِهِ إِن خِفتُ كَسعا",3,"ع",2,0],["وَعَلى سَلواكِ إِن مَنَّيتِني","فَتَعَيَّلتُ قَريباً مُبعَدا",4,"د",2,0],["وعلى سراب خادع وعلى","متألق اللمحات براق",5,"ق",1,0],["وعلى سماءِ النيلِ من سمَةِ الضُّحى","وضَحٌ من ثغريكما وَضحانِ",6,"ن",1,0],["وعلى سفحك عشنا زمنا","ورعينا غنم الأهل معا",7,"ع",2,0],["وعلى سماءِ النيلِ من سِمَةِ الضُّحى","وَضَحٌ، ومن ثغريكما وَضَحَانِ؟",8,"ن",1,0],["وعلى سيدي أبي حفص الفا","روق والمنتقى شهيد الدار",9,"ر",1,0],["وعلي سادات الملا","وعليه عول مرتجاها",10,"ا",3,0],["وعَلَيَّ سابِغةٌ كأنَ قَتِيرَها","حَدَقُ الجنادبِ ليس فيها مَطْمَعُ",11,"ع",1,0],["وَعَلى سِفاحٍ ما اِلتَقى يَوماً مِنَ ال","أَيّامِ مِن آبائِهِ أَبَوانِ",12,"ن",1,0],["وَعَلى سَلبها الوقارَ فَكَم أه","دَت ثباتاً إلى وقارِ الحليمِ",13,"م",1,1],["وعليَّ سُلطانُ الكَواعبِ في الهَوى","وعَلى العَواذِلِ في الهَوى سُلطاني",14,"ن",2,0],["وعلى سوحك الرحيب سلام","دائم في الآصال والأبكار",15,"ر",1,0],["وعلى سائر البرية فضلاً","سال سيل النوال منهم فطمَّا",16,"م",2,0],["وعلى سِمَاطَيْه لأفنانِ الرُّبى","ظِلُّ يذكّر بالشِفاهِ اللُّعَّسِ",17,"س",1,0],["وعلى سلاحك أو سماحك أُركِزتْ","راياتُها بِفنائها المطلوبِ",18,"ب",1,0],["وعلى سَمَواتِ المَعالي لم يزَلْ","لرِجالِ عُصْبَتِنا الكَريمَةِ منزِلُ",19,"ل",1,0],["وعَلَى سَاقِكِ لا دارَ سِوى","أرقم يَلدغ حيناً بَعدَ حِين",20,"ن",1,0],["وَعَلى سائر الوَرى فَضّلوه","لسخاهُ وَاِستَمسَكوا بعراه",21,"ا",2,0],["وعلى سيادته سلامٌ طيّبٌ","أذْكى من الأزهار غِبّ سحابِ",22,"ب",1,0],["وَعَلى ساعِدي كنانَةُ نَبلٍ","وَكِلابي حَولي وَتَحتي حِصاني",23,"ن",2,0],["وعلى سماء الياسمين كواكب","أبدت ذكاء العجز عن تغييبها",24,"ب",3,0],["وعلى سِراج جبينه الآ","مال تحسبها فراشا",25,"ش",2,0],["وعليّ سدل الرحمة اسدل منعما","ولك الثنا فمن البلايا اسلم",26,"م",1,0],["وَعَلى سَريرِ المُلكِ أَروَعُ ماجِدٌ","تُغَضي لَهُ الأَبصارُ مِن إِعظامِهِ",27,"م",2,0],["وعلى ساعديهما الطفل يسو","ع قد احضراه للاختتان",28,"ن",1,0],["وَعَلى سانِ اِستفانٍ","حَيثُ يَحلو الغَزَلُ",29,"ل",1,0],["وعلى سيف عزمها علوى","وهو في فتكه طويل النجاد",30,"د",1,0],["وعلى سفحه رسا مسجد القل","عة تعلو ذاره مئذنتان",31,"ن",1,0],["وعلى سجع حمامات البطاح","يتثنى الغصن والزهر يصوج",32,"ج",1,0],["وعلى سبيلِ رِضى الأَحبّة فاسْتَقِم","لَوْ عن وصالك أَعْرَضوا وتَجنَّبُوا",33,"ب",3,0],["وَعَلى سِرِّ سِتْرِ عَلْوَةَ بَيْتٌ","ما تَراهُ العُيونُ إلاّ شَزْرَا",34,"ر",2,0],["وعلى سُر من رأى فاحبس","الركب ونحُ في عِراصَ ربع مَحيل",35,"ل",1,0],["وعلى سرير صدراة الملك استوى","فأقام من أركانه ما قد خوى",36,"خ",3,0],["وعلى ساحةً الثرى من نثارٍ","للثريا مبدَّدٍ في الفضاء",37,"ا",2,0],["وعلي سيف النبي بسلع","يوم أهوى بعمرو المشرفيا",38,"ي",2,0],["وعلى سماتي من مسيلِ نجيعهِ","أَثرٌ عن الألم المبرّحِ عبَّرا",39,"ر",2,0],["وعلى سما الزرقا بدور سما","ضاءت بهم واخضرّت الترب",40,"ب",1,0],["وَعَلى سِوَاهُمْ حَقَّ فَرْضُ صَلاَتِهِمْ","فَإذَا أَبَوْا فَالنَّارُ أَضْيَقُ مَدْرَجِ",41,"ج",1,0],["وَعَلَى سَبِيلِ الشّعْرِ بِي وَطَنٌ","لَمَّا يُحطهُ الشِّعْرُ وَالنَّثْرُ",42,"ر",1,0],["وعلى سطورك حيرة وتردد","فإلى متى قلبي إليك يسافر",43,"ر",1,1],["وعلى سبيلِ الخوفِ، قالَتْ غيمةٌ","لِلْبَحْرِ: لا تَبْسُطْ يَديكَ لِلَمسِهِ",44,"س",2,0]]}