om/ViewPoem.aspx?id=25528",""],[105,"ركب الرفاق الظاعنين عجالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55032&r=&rc=202",""]],"verses":[["وَبِكرٌ مِنَ القَطرِ حَتّى كَأَنَّ","ما اِفتَضَّها غَيرُ غَيمٍ جَهامِ",0,"م",1,0],["وَبُكاءٌ عَلى المَنازِلِ أَبلَت","هُنَّ أَيدي الأَيّامِ بَسطاً وَقَبضا",1,"ض",2,0],["وَبَكَيْتُ إِذْ ضَحِكَتْ فَأَشْبهَ ثَغْرَهَا","دَمْعِي وَكُلٌّ لُؤْلؤٌ مَكْنونُ",2,"ن",1,0],["وَبِكَفِّهِ القَدَحُ الرَّوِيُّ وَمِنْهُ ما","أَلْتَذُّهُ وَيَروقُني مِنْ خَمْرِهِ",3,"ر",2,0],["وَبِكُلِّ مَرْمَى نَظْرَةٍ مِنْ وامِقٍ","تَحْكي مَبَاسِمُهُنَّ فيه عُقودُ",4,"د",1,0],["وبكادَ يُريني أوّلُ الفجْرِ غُرَّةً","على أخْرَياتِ الليلِ في وَجْهِ أدْهَما",5,"م",2,0],["وبِكَ استَفاضَ العَدْلُ واعتَجَرَ الوَرى","بالأمْنِ وانتَبَه الزّمانُ الغافِلُ",6,"ل",1,0],["وَبِكُلِّ مُرهَفَةٍ لَها نَفَذٌ","بَينَ الضُلوعِ كَطُرَّةِ الفَدَمِ",7,"م",1,0],["وَبِكُلِّ مَحبوكِ السَراةِ مُقَلِّصٍ","تَنمو مَناسِبُهُ لِذي العُقّالِ",8,"ل",1,0],["وَبِكًلِّ نَادٍ مِنْكَ أَنّةُ نَادِبٍ","وَبِكُلِّ دَارٍ مِنْكَ حُزْنٌ مُثْكِلُ",9,"ل",1,0],["وَبِكُلِّ أَزْرَقَ إِنْ شكَتْ أَلْحَاظُهُ","مَرَهَ الْعُيُونِ فَبِالْعَجَاجَةِ يُكْحَلُ",9,"ل",1,0],["وبَكَتْ حَمامُ البانِ بيْنَ هَديلِها","شجْواً يُهيجُ ورجّعَتْ تغْريدا",10,"د",2,0],["وبكْرٍ تثنّى منْكَ تلْعبُ بالنُّهى","وتَرْفُلُ تِيهاً في غُلالةِ سُنْدُسِ",11,"س",1,0],["وَبَكَت أَفلاذُكُم أَفلاذَنا","بِدُموعٍ رَوَّضَت تِلكَ الحُفَر",12,"ر",1,0],["وَبُكاؤُهُ في يَومِ سَعدٍ زادَني","عِلماً بِأَنَّ اليَومَ يَومُ تَباتِ",13,"ب",3,0],["وَبَكَت فَقدَهُ الشَآمُ وَناءَت","فَوقَ ما نابَها بِهَذا المُصابِ",14,"ب",1,0],["وَبُكاءٍ عَلى عَزيزٍ تَوَلّى","وَرُسومٍ راحَت بِهِنَّ اللَيالي",15,"ي",1,0],["وَبِكَفِّكَ المَيلُ الَّذي يَحكي عَصا","موسى وَكَم عَينٍ بِهِ تَتَفَجَّرُ",16,"ر",1,0],["وَبِكُلِّ أَرضٍ جَنَةٌّ مِن عَدلِهِ ال","ضافي أَسالَ نَداهُ فيها كَوثَرا",17,"ر",2,0],["وَبِكَ الْحِلْمُ وَالسَّمَاحَةُ طَبْعٌ","لَيْسَ فِي آلِ هَاشِمٍ بِعَجِيبِ",18,"ب",1,0],["وَبَكَى دَمْعَ عَيْنَيهِ فِي سُطُورٍ","جعلَتْه عَلَى المَدَى مَبكِيَّا",19,"ي",2,0],["وبكل فتخاء الجناح إذا ارتمت","فكأنها نجم السماء الساري",20,"ر",2,0],["وبك العروبة قد زهت نسبا","يزهى بغبطة كل ذي نسب",21,"ب",1,0],["وبكاه الكتاب ذو الذكر شجواً","وعلوم إلى الكتاب تؤول",22,"ل",1,0],["وبكته آيٌ به محكمات","وبكاه التفسير والتأويل",22,"ل",1,0],["وبكته أرامل ويتامى","جذّ عنها بموته التنويل",22,"ل",1,0],["وَبَكَيتَ لَيلَكَ لا تَنامُ لِطولِهِ","لَيلَ التَمامِ وَقَد يَكونُ قَصيرا",23,"ر",2,0],["وَبَكى الزُبَيرَ بَناتُهُ في مَأتَمٍ","ماذا يَرُدُّ بُكاءُ مَن لا يَسمَعُ",24,"ع",1,0],["وَبَكرٌ قَد رَفَعنا السَيفَ عَنها","وَلَولا ذاكَ لَاِقتُسِموا اِقتِساما",25,"م",2,0],["وَبِكُلِّ ذَلِكَ قَد سَعَيتُ إِلى العُلى","وَالمَرءُ يُحمَدُ سَعيُهُ وَيُلامُ",26,"م",1,0],["وَبَكّي عَظيمَ المَشعَرَينِ وَرَبَّها","عَلى الناسِ مَعروفٌ لَهُ ما تَكَلَّما",27,"م",2,0],["وَبِكُلِّ صافِيَةِ الأَديمِ كَأَنَّها","فَتخاءُ كاسِرَةٌ تَذِفُّ وَتَطمَحِ",28,"ح",1,0],["وبكفِّه القلم المسدَّد سهمه","يوم الندى والعلم في القرطاس",29,"س",1,0],["وبك ازدهى الشرع المنيف مقامه","وأقرّ رائد روضه المستاف",30,"ف",1,0],["وبكفه القلم الذي لا يشتكى","فتق الأمور لفضله لا رتق",31,"ق",1,0],["وبكم علمت من القريض صناعة","ما كنت لولاكم بها أتعلق",32,"ق",1,0],["وبكَيده يَروي القنا","عَلَقاً ويختضبُ اختضابهْ",33,"ب",2,0],["وبكم يَستفتح الرز","ق من استفتح رزقا",34,"ق",2,0],["وبكيدِهم كِيدُوا له لا كيدِهِ","واللَّهُ حيَّنَهُم لذاكَ فأوْشَكا",35,"ك",2,0],["وبكتك أوعيةُ الدموع وتارةً","غيثٌ كعَرفك مُسبلٌ هطَّالُ",36,"ل",1,0],["وبكاك مِنْ بستانِ قصركِ زاهرٌ","لثناك من نفحاتِه أشكالُ",36,"ل",1,0],["وبكت حمائمُه وعاد غناؤها","نوحاً يُهاجُ بمثلِهِ البلبال",36,"ل",1,0],["وبك استيقظوا وقد زاول الغا","درُ قبلَ القتالِ بابَ الختالِ",37,"ل",1,0],["وَبِكرٌ كُلَّما مُسَّت أَصاتَت","تَرَنُّمَ نَغمِ ذي الشَرعِ العَتيقِ",38,"ق",1,0],["وَبِكُلِّ مُبتَهِلٍ عَلَيهِ مُسوحُهُ","دونَ السَماءِ مُسَبِّحٍ جَأَّرِ",39,"ر",1,0],["وَبَكى فَشاعَ الحُزنُ في الأَزهارِ","وَالأَظلالِ وَالأَلوانِ وَالأَضواءِ",40,"ا",2,0],["وَبَكَت فِلسطينُ بِهِ قَيدومَها","إِنَّ الرَزايا بِالكِبارِ كِبارُ",41,"ر",1,0],["وَبَكى الأَحِبَّةُ حَولَكُم وَجُفُنُكُم","تَعصي البُكا حُزنُ الجَبابِرِ أَبكَمُ",42,"م",1,0],["وَبِكُلِّ شَيطانٍ مَريدٍ ماكِرٍ","وَبِكُلِّ تابِعِ مارِدٍ شَيطانِ",43,"ن",1,0],["وَبَكيتُ إِذ رَحَلَ الشَبا","بُ فَآهِ آهِ عَلَيهِ راحِل",44,"ل",1,0],["وبَكَتْكَ هاتيكَ القُلُوبُ","وضمَّكَ القبرُ الصَّغيرْ",45,"ر",1,0],["وبكاه الإخلاص في حب مصر","وبكاه النبوغ والأخلاق",46,"ق",1,0],["وبكاها العراق حزنا عليها","وبنوه ودجلة والفرات",47,"ت",1,0],["وبكت تندب الشبا","ب بدمع قد انفجر",48,"ر",1,0],["وبكى الشيخ للأسى","نادما يسكب العبر",48,"ر",1,0],["وبكأسين من حياة وموت","شرب العالمون من عهد عاد",49,"د",1,0],["وَبَكى شَجواً عَلى شَعبِهِ","شَجوَ ذاتِ الثُكلِ في السِترِ الرَقيقِ",50,"ق",1,0],["وَبِكُلِّ رُكنٍ صورَةٌ","وَبِكُلِّ زاوِيَةٍ رَقين",51,"ن",1,0],["وَبِكُلِّ مُحسِنِ صَنعَةٍ في دَهرِهِ","تَتَعَجَّبُ الأَجيالُ مِن إِتقانِهِ",52,"ن",2,0],["وَبُكاءُ اللَبيبِ بَعدَ ثَلاثٍ","وَثَلاثينَ في البَطالَةِ حوبُ",53,"ب",1,0],["وَبَكَرتَ تَخرَأُ في المَذبَحِ ال","كَبيرِ وَتَلطَخُ تِلكَ الدَرَج",54,"ج",1,0],["وَبَكَت فَاِستَثارَ مِنّي بُكاها","زَفرَةً ما تُطيقُها أَضلاعي",55,"ي",1,0],["وَبَكى النابِغانِ مِن فَرطِ وَجدٍ","ثُمَّ صَنّاجَةُ القَريضِ المَحوكِ",56,"ك",1,0],["وَبُكاءُ الدارِ مِمّا يَرُدُّ ال","شَوقَ ذِكراً وَالحُبَّ نِضواً ضَئيلا",57,"ل",2,0],["وَبَكرٌ وَعَبدُ القَيسِ وَاِبنَةُ وائِلٍ","أَقَرَّت لَهُ بِالفَضلِ صُعراً خُدودُها",58,"د",3,0],["وَبِكْرٍ إذا جَنَّبَتْها الجَنوبُ","حسْبِتَ العِشارَ تؤمُّ العِشارا",59,"ر",2,0],["وَبَكَت لَهُ أَهلُ الثُغورِ وَطالَما","ضَحِكَت لِدَستِ المُلكِ مِنهُ ثُغورُ",60,"ر",1,0],["وَبَكى لِرُزئِكَ صَعبُها وَذَلولُها","وَشَكا لِفَقدِكَ شاتُها وَالذَيبُ",61,"ب",1,0],["وَبِكرٍ خَدَمتُ بِها عاجِلاً","وَسيفُ القَريحَةُ لَم يُصقَلِ",62,"ل",1,0],["وَبِكَ اِستَعذَبَ المُلوكُ كَلامي","وَرَعوا حَقَّ حُرمَتي وَعُهودي",63,"د",2,0],["وَبِكرِ فَلاةٍ لَم تَخَف وَطءَ طامِثٍ","وَلا اِفتَضَّها مِن قَبلِ مُهرِيَ ناكِحُ",64,"ح",1,0],["وَبِكَ اِستَغاثَ الأَنبِياءُ جَميعُهُم","عِندَ الشَدائِدِ رَبَّهُم لِيُعانوا",65,"ن",3,0],["وَبِكَ اِستَغاثَ اللَهَ آدَمُ عِندَما","نُسِبَ الخِلافُ إِلَيهِ وَالعِصيانُ",65,"ن",1,0],["وَبِكَ اِلتَجا نوحٌ وَقَد ماجَت بِهِ","دُسرُ السَفينَةِ إِذ طَغى الطوفانُ",65,"ن",1,0],["وَبِكَ اِغتَدى أَيّوبُ يَسأَلُ رَبَّهُ","كَشفَ البَلاءِ فَزالَتِ الأَحزانُ",65,"ن",1,0],["وَبِكَ الخَليلُ دَعا الإِلَهَ فَلَم يَخَف","نَمرودَ إِذ شُبَّت لَهُ النيرانُ",65,"ن",1,0],["وَبِكَ اِغتَدى في السِجنِ يوسُفُ سائِلاً","رَبَّ العِبادِ وَقَلبُهُ حَيرانُ",65,"ن",1,0],["وَبِكَ الكَليمُ غَداةَ خاطَبَ رَبَّهُ","سَأَلَ القَبولَ فَعَمَّهُ الإِحسانُ",65,"ن",1,0],["وَبِكَ المَسيحُ دَعا فَأَحيا رَبُّهُ","مَيتاً وَقَد بَلِيَت بِهِ الأَكفانُ",65,"ن",1,0],["وَبِكَ اِستَبانَ الحَقُّ بَعدَ خَفائِهِ","حَتّى أَطاعَكَ إِنسُها وَالجانُ",65,"ن",1,0],["وبكيتُ الغرورَ والأملَ الوا","سعَ والسخطَ والرضا والرياءَ",66,"ا",2,0],["وبكيتُ من يأسي عليك فلم أذر","عند المحاجر مدمعاً مبذولا",67,"ل",2,0],["وبكى الرماد الآدمي","يُ على رماد غرامها",68,"م",3,0],["وبكلّ أرضٍ تستنيرُ بذكره","خُطَبٌ منَ الفصحاءِ أو أشعارُ",69,"ر",1,0],["وَبِكُلِّ سَهمٍ واقعٍ لِكنَّهُ","بِثلاثِ أجنِحَةٍ له طَيَّارُ",69,"ر",1,0],["وَبَكَتْ فَالدَّمْعُ في وَجنَتِها","كَجُمانِ الطلِّ في الوردِ النَدي",70,"د",2,0],["وبكم يتمُّ سرورنا","فتفضلوا وتصدقوا",71,"ق",3,0],["وبكم يتمُّ سرورنا","فتصدقوا وتعطفوا",72,"ف",3,0],["وبكمْ يتمُّ سرورنا","فتصدَّقوا وتفضلوا",73,"ل",3,0],["وَبِكِ الهَمُّ إِن مَشَيتُ صَحيحاً","وَسَواري الأَحلامِ وَالأَشعارُ",74,"ر",1,0],["وَبَكَيتُ دِجلَتَهُ يُضاحِكُني بِها","مَرَحاً حَبيبٌ شاقَني وَحَبابُ",75,"ب",1,0],["وَبِكُلِّ نائي الشَوطِ أَشدَقَ أَصدَرٍ","طاوي الحَشى حالي المُقَلَّدِ ضاري",76,"ر",2,0],["وَبِكُلِّ مَرقَبَةٍ مَناخُ غَمامَةٍ","مِثلُ الضَريبِ بِها لِحاحُ لُغامِ",77,"م",1,0],["وَبَكى باكي الغَمامِ بِها","بَينَ مُنهَلٍّ وَمُنسَجِمِ",78,"م",1,0],["وبكيتُ حين مَضُوا إلى أجداثهم","شعباً يُعلَّلُ بالحياةِ ضَلالا",79,"ل",2,0],["وَبِكَراً أَنَّ في بَكرٍ فِعالاً","وأَحلاماً بِها يَتَفاضَلونا",80,"ن",2,0],["وَبِكرٍ فَلاها عَن نَعيمٍ غَريرَةٍ","مُصاحِبَةٍ عَلى الكَراهينَ فارِكِ",81,"ك",1,0],["وَبِكَشفِ الغَمّاءِ بِالرَأيِ ذي العَز","مِ إِذا بَلَّدَت دَواهي الرِجالِ",82,"ل",1,0],["وَبَكَيتُ مِن طَرَبِ الحَمائِمِ غُدوَ