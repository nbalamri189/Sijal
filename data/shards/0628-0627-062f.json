ٌ طِوالٌ وَأَذرُعٌ فُتُلُ",0,"ل",1,0],["بادَرَ الحادِثَ المُعَدَّ إِلَيها","وَرَأى الغُنمَ أَن تَكونَ بِدارا",1,"ر",2,0],["بادونَ في صُوَرِ الجَميعِ وَإِنَّهُم","مُتَفَرِّدونَ تَفَرُّدَ الآحادِ",2,"د",1,0],["بادَ العَتادُ وَفاحَ ري","حُ المِسكِ إِذ هُجِمَت قِبابُه",3,"ب",2,0],["بادوا فَلَمّا أَن تَآدَوا","قَفّى عَلى إِثرِهِم قُدارُ",4,"ر",1,0],["بِأَدماءَ حُرجوجٍ بَرَيتُ سَنامَها","بِسَيري عَلَيها بَعدَما كانَ تامِكا",5,"ك",2,0],["بادَرتُ سَعياً هَل رَأَيتَ الذيبا","هَصَرتُهُ حُلوَ الجَنى رَطيبا",6,"ب",2,0],["بادَرتِني بِالعَزلِ عَن خُطَطِ الرِضى","وَلَقَد مَحضتُ النُصحَ إِذ وَلَّيتِني",7,"ن",2,0],["بِأَدماءَ حُرجوجٍ كَأَنَّ قُتودَه","عَلى أَبلَقِ الكَشحَينِ لَيسَ بِمُغرِبِ",8,"ب",1,0],["بادي الرَبعِ وَالمَعارِفِ مِنها","غَيرَ رَسمٍ كَعُصبَةِ الأَغيالِ",9,"ل",1,0],["بَادِي الهُمُومِ وَلا هُمُومَ وَإِنَّمَا","هُنَّ البَقَايَا مِنْ طِلاً وَمُجُونِ",10,"ن",1,0],["بِأَدعاصِ حَوضى ثُمَّ مَوضِعُ أَهلِها","جَراميزُ يَطفو فَوقَها وَرَقُ السِدرِ",11,"ر",1,0],["بادَرتُ حاجَتَها الدَجاجَ بِسُحرَةٍ","لِأُعَلَّ مِنها حينَ هَبَّ نِيامُها",12,"م",3,0],["بادَرتُ بِالصَقّارِ وَالفَهّادِ","حَتّى سَبَقناهُ إِلى الميعادِ",13,"د",1,0],["بادي السعادة لو بثَّت مناقبه","في الأفق لم يبدُ في الأقمارِ مخسوف",14,"ف",1,0],["بادي الوقار إذا احتبى وحبا الندى","أبصرت سير السيل من نهلان",15,"ن",1,0],["بادر بمعروفك آفاته","فَبِنيةُ الدنيا على القُلعه",16,"ع",2,0],["بادروهُ قبلَ الرويَّةِ بالعَزْ","م وقبل الإسراج بالإلجام",17,"م",1,0],["بادْر غُروسَ يديكَ بالسُّقْيَا","وأغِثْ بريٍّ قبلَ أن يَذْوى",18,"و",2,1],["بادٍ هَواكَ صَبَرتَ أَم لَم تَصبِرا","وَبُكاكَ إِن لَم يَجرِ دَمعُكَ أَو جَرى",19,"ر",2,1],["بادهتُها بالرأي يَنْطُفُ حَّدهُ","عَلَقاً ورأيُك للنوائب قاشعُ",20,"ع",1,0],["بادِرْ بفُرصتكَ الزمانَ ولا","تلبَثْ فإنَّ الفَوْتَ في اللَّبْثِ",21,"ث",1,1],["بادي سَماحٍ غَرَ في وادي النَدى","لَهُمُ فَأَنجَدَ في العَلاءِ المُنجِدِ",22,"د",1,0],["بِأَدهَمَ كَالظَلامِ أَغَرَّ يَحلو","بِغُرَّتِهِ دَياجيرَ الظَلامِ",23,"م",1,0],["بادٍ بِأَنعُمِهِ العافينَ يُزلِفُهُم","عَلى الأَشِقّاءِ فيها وَالقَرابينا",24,"ن",2,0],["بَادون للعِز يَبدو ضَوءُ نارِهمُ","لَيلاً إذا باتَ ضَوءُ البرقِ مَحجوبا",25,"ب",2,0],["بادِر هَواكَ إِذا هَمَمتَ بِصالِحٍ","خَوفَ الغَوالِبِ أَن تَجيءَ وَتُغلَبُ",26,"ب",1,0],["بادِر بِجِدِّكَ قَبلَ أَن","تُقصى وَتُزعَجَ مِن قَرارِك",27,"ك",1,0],["بادوا وَوَفَّتهُمُ الأَهِلَّةُ ما","كانَ لَهُم وَالأَيّامُ وَالجُمَعُ",28,"ع",1,0],["بادٍ بِبَذلِ النَدى قَبلَ السُؤالِ وَمَن","في دَولَةِ التُركِ أَحيا ذِمَّةَ العَرَبِ",29,"ب",1,0],["بادَرتُهُ وَعُقابُ الهَمِّ يَطرُدُني","فَاليَومَ قَد عادَ كَالعَنقاءِ في الهَرَبِ",29,"ب",1,0],["بادَرتُهُ وَقَرَعتُ البابَ واحِدَةً","قَرعاً تَوَسَّمَ مِن إِخفائِهِ الأَدَبا",30,"ب",2,0],["بادي التبسم والهيجاءُ كالحةٌ","لا يتّقي العضّ من أنيابها العصلِ",31,"ل",1,0],["بأدهمَ يَسْقُطُ من ذِمْرِهِ","على عُمْرِ كلّ شجاعٍ أجَل",32,"ل",1,0],["بأدمعٍ بين الجفونِ حُوَّمٍ","وأدمعٍ على الخدود وُقّعِ",33,"ع",1,0],["بادي المُحَيّا لِأَطرافِ الرِماحِ فَما","يُرى بِغَيرِ الدَمِ المَعبوطِ مُلتَثِما",34,"م",2,0],["بادي الصَبابَةِ قَد ذَهَبتِ بِعَقلِهِ","كِلفٍ بِحُبِّكِ يا عُثَيمَ مُتَيَّمِ",35,"م",1,0],["بادِنٌ تَجلو مُفَلَّجَةً","عَذبَةً غُرّاً لَها أُشُرُ",36,"ر",1,0],["باد الأُلى عَمروا الأيّامَ زاهيةً","فما ترى العينُ منهم غيرَ أرماسِ",37,"س",1,0],["بادَت لَهُ صُحُفٌ بيضٌ مُطَهَّرَةٌ","وَاِستُحدِثَت صُحُفٌ قارِيَّةٌ سودُ",38,"د",1,0],["بادي الشراسةِ عادٍ ما يُلائِمُه","في موضعِ الذَّمِّ إلا أسوأُ المَثلِ",39,"ل",1,0],["بادوا بها وتساقَوْا في مصارعِهم","سُوءَ العذابِ ومكروهَ الأذى نَهَلا",40,"ل",2,0],["بادَرَ السَيءَ وَلَم يَنتَظِر","نُبهَ فيقاتِ العُروقِ النِيام",41,"م",1,0],["بِأَدنى مِنَ القَولِ الَّذي بُحتَ مُعلِناً","بِهِ لِاِمرِئٍ بِعَيبِكُم غَيرَ بائِحِ",42,"ح",1,0],["بادَرتُ قُنَّتَها صَحبي وَما كَسِلوا","حَتّى نَمَيتُ إِلَيها بَعدَ إِشراقِ",43,"ق",1,0],["بادِر بِجودِكَ بادِر قَبلَ عائِقَةٍ","فَإِنَّ وَعدَ الفَتى عِندي مِنَ اللَومِ",44,"م",1,0],["بادِرا بِالوِصالِ تَعويقَ دَهرٍ","لَم يَزَل مُجرِماً كَثيرَ الذُنوبِ",45,"ب",1,0],["بادَرتُ مِنهُ مَوعِداً حاضِراً","وَكانَ ذا عِندي مِنَ الداءِ",46,"ا",2,1],["بادِي السكينةِ فِي سُخْطٍ لهُ ورِضاً","فلَمْ يَزَلْ وَهْوَ مَرْهُوبٌ ومَأْمُولُ",47,"ل",1,0],["بادي الرّضا وحَذارِ منه مُعاوِداً","غَضَباً يُريكَ الموتَ بين جُفونِه",48,"ن",2,0],["بادرتُ مَوطِىءَ نَعلِهِ حتى إذا","عَفّرْتُ خدّي في الثرى المتنسِّم",49,"م",1,0],["بادِر فَإِنَّ جِنانَ الكَرخِ مونِقَةٌ","لَم تَلتَقِفها يَدٌ لِلحَربِ عَسراءُ",50,"ا",2,0],["بادِر صَباحَكَ بِالصَبوحِ وَلاتَكُن","كَمُسَوِّفينَ غَدَوا عَلَيكَ شِحاحا",51,"ح",2,0],["بادِرِ الكَأسَ نَهارا","وَاِشرَبِ الراحَ العُقارا",52,"ر",2,1],["بادِر شَبابَكَ قَبلَ الشَيبِ وَالعارِ","وَحَثحِثِ الكَأسَ مِن بِكرٍ لِإِبكارِ",53,"ر",1,1],["بادِر صَبوحَكَ وَاِنعَم أَيُّها الرَجُلُ","وَاِعصِ الَّذينَ بِجَهلٍ في الهَوى عَذَلوا",54,"ل",3,1],["بادرتُ نحو الزجاج أغسلهُ","حتى تنقّى كأنّه البَرَدُ",55,"د",1,0],["بادِنٌ تَجلو إِذا ما اِبتَسَمَت","عَن شَتيتٍ كَأَقاحِ الرَملِ غُر",56,"ر",1,0],["بادِرْ إِلى التَّوبَةِ الخَلصاءِ مُجْتَهِداً","وَالمَوْتُ وَيْحَكَ لم يَمْدُدْ إِليكَ يَدا",57,"د",2,1],["بادَت شعوب لا تريدُ","وإذا أرادَت لا تَبيدُ",58,"د",1,1],["بأدنى ابتسامٍ منك تحيا القرائح","وتقوى من الجسم الضّعيف الجوارح",59,"ح",1,1],["بَادِر الْفُرْصَةَ وَاحْذَرْ فَوْتَهَا","فَبُلُوغُ الْعِزِّ في نَيْلِ الْفُرَصْ",60,"ص",1,1],["بَادٍ بِهَا عَلَمٌ عَلَى","عَلَمٍ أَقَامَ بِهِ عَلَمْ",61,"م",1,0],["بَادٍ مُحَيَّاهَا فَأَيْنَ قِنَاعُهَا","وَعَلاَمَ شَاءَتْ أَنْ يَزُولَ فَزَالاَ",62,"ل",2,0],["بِأَدْنَى المُضَيَّعِ فِي لَهْوِكُمْ","تَقُونَ الْبِلاَدَ أَشَدَّ الْخَطَرْ",63,"ر",1,0],["بَادِيءٍ صَوْغَهُ وَفِيهِ فنونٌ","بَارِعَاتٌ لاَ يَتَّسِقْنَ لِبَادِي",64,"د",2,0],["بَادِي انْتِسَابٍ بِسُمُوِّ الحِجَى","إِلى نَبِيِّ العَرَبِ المُرْسَل",65,"ل",1,0],["بَادِئاً تَجْرِبَةَ البَأْسِ بِمَنْ","هُوَ مِنْ أَهَلِيهِ فِي الأَدْنَيْنَ إِصْرَا",66,"ر",2,0],["بَادٍ صَفَاءُ القَطْرِ فِي قَسِمَاتِهَا","وَتَنَافُسِ الأَلْوَانِ وَالأَضْوَاءِ",67,"ا",2,0],["بَادِيَ البَأْسِ مَا اسْتَثَارَ","د لَيْثِ العَرِينِ شِبْلَ العَرِينِ",68,"ن",1,0],["بِأَدماءَ حُرجوجٍ كَأَنَّ قُتودَها","عَلى أَبلَقِ الكَشحَينِ لَيسَ بِمُغرِبِ",69,"ب",1,0],["بادي الخَنا يَسْفَهُ أو يُباذي","فالجارُ شاكٍ 