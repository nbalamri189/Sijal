{"poems":[[86,"أرأيت رب التاج في","https://www.aldiwan.net/poem68886.html","مجزوء الكامل"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[85,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[66,"في مثل حضرتكم لا يزأر الأسد","https://www.aldiwan.net/poem41370.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[85,"نَبذَ الهوى ، وصَحَا من الأَحلامِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9640&r=&rc=130",""],[170,"قالوا الدبيثي ذو قواف","https://www.aldiwan.net/poem1671.html",""],[200,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[226,"أسست هذا على أس التقى","https://www.aldiwan.net/poem55191.html","الرمل"],[403,"أسسوا لكل كفور","https://www.aldiwan.net/poem46955.html","الخفيف"]],"verses":[["أَسَّستَ مَدرَسَةً تُعي","دُ لَنا بِمُلكِ البَحرِ عَهدا",0,"د",2,0],["أُسِّست والطير باليم","نِ وبالسعد جواري",1,"ر",2,0],["أسستموا وبنى رجال بعدكم","خططا يتمم آخرون بناءها",2,"ا",3,0],["أَسَّستُمو بِالحاسِدينَ جِدارَهُ","وَبَنَيتُمو بِمَعاوِلِ الهَدّامِ",3,"م",1,0],["أُسِّسَت نَهضَةُ البِناءِ بِقَومٍ","وَبِقَومٍ سَما وَطالَ اِرتِفاعُه",4,"ع",2,0],["أُسِّستِ مِن أَحلامِهِم بِقَواعِدٍ","وَرُفِعتِ مِن أَخلاقِهِم بِعِمادِ",5,"د",1,0],["أَسَّستَ بِالدينِ وَالتَقوى قَواعِدَها","فَكانَ عُقباكَ مِنها عيشَةٌ رَغَدُ",6,"د",1,0],["أَسَّسَ الْمَصْرِفَ الْكَبِيرَ فَكَانَ الأَصْلُ","وَامْتَدَّتِ التَّفارِيغُ كُثْرَا",7,"ر",2,0],["أسِّس على الدستور ملكَك، وابنِهِ","تبلغْ به الشُّمَّ الرواسيَ طولا",8,"ل",2,0],["أَسسْتَ سدًّا به كانت معلَّقةً","كرامةُ العُرْب من أَبناءِ عدنانِ",9,"ن",1,0],["أسَّسْتَها؛ ففتحتَ مِصْرَ بفتحها","وسبقْتَ «عَمْرًا» في الفتوح، و«جوهرا»",10,"ر",2,0],["أَسَّسْتُم بالحاسدين جِدارَه","وبينتمو بمعاول الهدَّام",11,"م",1,0],["أَسَّسَها شَرُّ آدَمِيٍّ","بِذاكَ كُلُّ الوَرى عَليمَه",12,"م",2,0],["أسس على الحب لا تُلق القلوب سُدًى","وَضع لكل فؤَاد شكلهُ الثاني",13,"ن",2,0],["أَسَّسَت هذا على أُسِّ التُقى","أُمُّ عبّاسٍ ملاذُ المُعوزين",14,"ن",1,1],["أسَّسُوا لِكُلّ كفورٍ","ظالمٍ لا يَخَافُ يومَ العقابِ",15,"ب",1,1]]}