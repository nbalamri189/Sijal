0695","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53223","الكامل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101818","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126200","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93670","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65979","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94185","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201614","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87380","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67994","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74036","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48310","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138529",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199092","الكامل"],[4114,"","https://poetry.dctabudhabi.ae/diwan/poem/198768","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139743",""],[4797,"حن جنودش ياقطر لاجى الصحيح","https://www.poetsgate.com/ViewPoem.aspx?id=132243",""],[4942,"ولد الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=188837",""],[5080,"مدائن التمر","https://www.poetsgate.com/ViewPoem.aspx?id=184906",""],[5342,"يا طاهر الذات ومن قد علا","https://www.poetsgate.com/ViewPoem.aspx?id=170922",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5401,"تويتر والفيس بوك","https://www.poetsgate.com/ViewPoem.aspx?id=142371",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5956,"مِثْل الفقير يرى القصور بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=182343",""],[5956,"بالشعر أصنع وحدة قلبية ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182949",""],[5956,"التعَوُّد ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183923",""],[5956,"الفخر بالابن فراس","https://www.poetsgate.com/ViewPoem.aspx?id=192387",""],[5956,"ما أروع الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=192496",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""]],"verses":[["أَسَّستَ مَدرَسَةً تُعي","دُ لَنا بِمُلكِ البَحرِ عَهدا",0,"د",2,0],["أُسِّست والطير باليم","نِ وبالسعد جواري",1,"ر",2,0],["أسستموا وبنى رجال بعدكم","خططا يتمم آخرون بناءها",2,"ا",3,0],["أَسَّستُمو بِالحاسِدينَ جِدارَهُ","وَبَنَيتُمو بِمَعاوِلِ الهَدّامِ",3,"م",1,0],["أُسِّسَت نَهضَةُ البِناءِ بِقَومٍ","وَبِقَومٍ سَما وَطالَ اِرتِفاعُه",4,"ع",2,0],["أُسِّستِ مِن أَحلامِهِم بِقَواعِدٍ","وَرُفِعتِ مِن أَخلاقِهِم بِعِمادِ",5,"د",1,0],["أَسَّستَ بِالدينِ وَالتَقوى قَواعِدَها","فَكانَ عُقباكَ مِنها عيشَةٌ رَغَدُ",6,"د",1,0],["أَسَّسَ الْمَصْرِفَ الْكَبِيرَ فَكَانَ الأَصْلُ","وَامْتَدَّتِ التَّفارِيغُ كُثْرَا",7,"ر",2,0],["أسِّس على الدستور ملكَك، وابنِهِ","تبلغْ به الشُّمَّ الرواسيَ طولا",8,"ل",2,0],["أَسسْتَ سدًّا به كانت معلَّقةً","كرامةُ العُرْب من أَبناءِ عدنانِ",9,"ن",1,0],["أسَّسْتَها؛ ففتحتَ مِصْرَ بفتحها","وسبقْتَ «عَمْرًا» في الفتوح، و«جوهرا»",10,"ر",2,0],["أسستم لعلوم الدين مدرسة","كهالة الشمس أنوارا ومنتفعا",11,"ع",2,0],["أَسَّسْتُم بالحاسدين جِدارَه","وبينتمو بمعاول الهدَّام",12,"م",1,0],["أَسَّسَها شَرُّ آدَمِيٍّ","بِذاكَ كُلُّ الوَرى عَليمَه",13,"م",2,0],["أسس على الحب لا تُلق القلوب سُدًى","وَضع لكل فؤَاد شكلهُ الثاني",14,"ن",2,0],["أَسَّسَت هذا على أُسِّ التُقى","أُمُّ عبّاسٍ ملاذُ المُعوزين",15,"ن",1,1],["أسَّسُوا لِكُلّ كفورٍ","ظالمٍ لا يَخَافُ يومَ العقابِ",16,"ب",1,1],["أَسَّسْتَ للمكرمات أَرْوِقَةً","لها على المكرماتِ تأسيسُ",17,"س",1,0],["أَسَّسَهُ المَنصورُ كَهفُ الوَرى","وَمُحمِدُ الهَولِ بِعَضبٍ رَقيق",18,"ق",1,0],["أسس من قبل ولكنه","أسس كي يخدم سلطانه",19,"ن",2,0],["أسَّستَ دولة عدلٍ لا يضامُ بها","فردٌّ وأنت لدى الأَحداثِ لم تغبِ",20,"ب",1,0],["أَسست فينا الخير واِستنهضتنا","لمراتب علوية ومراقِ",21,"ق",1,0],["أسست البلاد وأهليها فما أحد","الا يعدلك والاحسان مأسور",22,"ر",1,0],["أسست بالدين والتقوى علاك وكم","للدين عندك تعظيم وتوقير",22,"ر",1,0],["أسسه على التقى","وفاز فيه بالكرم",23,"م",1,0],["أسّست أمري على الله القوي ومن","بالله تاسيسه كفاه تالله",24,"ل",2,0],["أسسوا المجدَ وهذا فجرُهُم","مثلَ بَدرٍ في نُجُومٍ أشرقَا",25,"ق",2,0],["أَسَّسُوا المجد والسماحة لكن","بمساعيك تمَّ ذاك البناء",26,"ا",2,0],["أسست والأفلاك تحكم أنني","في السعد أثبت وهي في دوران",27,"ن",1,0],["أسَّسَ رُكناً لِلمعارفِ كما","أحيا الفنون بعدَما الغصنُ ذَوى",28,"ا",1,0],["أسس المجد والعلى فاستقامت","واستقلت أركانه والمباني",29,"ن",2,0],["أسَّسَ الحُبَّ فوقَ عُنصُرِ بُغضٍ","أو تُحالُ الأعداءُ بالأولياء",30,"ا",2,0],["أسَّسه لِلجُود أَسلافه","فَهوَ وَرب البَيت بَيت عَتيق",31,"ق",1,0],["أسس الدين جعفر فنهضتم","تستجدون ذَلِكَ التَأسيسا",32,"س",2,0],["أسس هديت لأهل الدين مأثرة","تحيي بها المجد من أسلافك الأول",33,"ل",1,0],["أسسه على التقى فأرخت","ه جامعاً للخير والمبره",34,"ه",1,0],["أسّست مدرسة لجيلٍ قادم","لو تسمح الدنيا بثاني آدم",35,"م",1,1],["أَسستموهُ على العُلى وَالحمد من","قِدَمٍ فذلك في الفخار عَريقُ",36,"ق",1,0],["أَسَّس المجدُ ساسَها فاستقلتْ","بسَنا العزِّ والعُلى قدماها",37,"ا",3,0],["أَسّستَ للإصلاح حز","باً ضمّ خيرَ المُصلحنا",38,"ن",2,0],["أسّسَتْ مُلكَهُ على البرِّ حتّى","أصْعَدَتْهُ وشيّدتْ أرْكانَهْ",39,"ن",2,0],["اسسوا ظلمه عناداً واغروا","لهم الويل كل كلب عقور",40,"ر",1,0],["أسَّسَ المَسجِدَ الشَّرِيفَ وآخَى","بَينَ صَحبٍ فَطَابَ مِنهُم إِخَاءُ",41,"ا",2,0],["أسست قاعدة الإخاء مشيدا","ودا تجسم في الفروع وطالا",42,"ل",2,0],["أسست ملكاً للإخاء فلم يزل","بالعبقرية، فازدهى بكمال",43,"ل",1,0],["أسَّس المجدَ والمفاخَر حتَى","أصبحا فوقَ ما بَنى يَبنيان",44,"ن",1,0],["أسَّستَ أصلاً فروعٌ ما سواه وقد","غدا لمن قصد التأليف عنوانا",45,"ن",2,0],["اسسش جاسم على النهج الصريح","سيف عدل وعز يردع من ظلم",46,"م",1,0],["أسستَ للثوارِ أعظمَ منهجٍ","ما زالَ منهُ ينهلُ الثوارُ",47,"ر",1,0],["اسستُ للقهرِ بيتاً فوقَ خاصرتي","لذا ترى النبضَ عندي لحنَه قهرا",48,"ر",2,0],["أسست مذ أقوى مقام الهدى","وهد منه مارسا واستقام",49,"م",1,0],["أسسوا أركان أبيات الهدى","فبنوا من فوقها سبعا شدادا",50,"د",2,0],["اسس على نبذ القيم خير تأسيس","بمباركات رموزها والقناصل",51,"ل",1,0],["أسَّسنَ من شبقِ التّرحالِ مملكةً","فأنبتتْ في وشاحِ الدهرِ حيتانا",52,"ن",2,0],["أسَّسْتِ عندي ميزة جبارة","ليدومَ عزمي يا رفاه حديدا",53,"د",2,0],["أسس السعادة أن تقوم صداقة","بين الشعوب لينبذوا الشنآنا",54,"ن",2,0],["أسُسُ التعاسة تستحيلُ بناءا","أسُسُ السعادة تستحيلُ هَباءا",55,"ا",3,0],["أسّسْتَ مجداً عصاميّاً يؤمِّننا","ودمتَ أدهشَ مخلوق من الرَّشَدِ",56,"د",1,0],["أسسٌ عليها ينبني الإيمان","وبها لنا الجنات والنيرانُ",57,"ن",1,0],["أسَّسْتَ دكتاتورةً هَدَّامةً","تُدْنِي الجديرَ فما لَهُ تَصْعيدُ",58,"د",1,0],["أسس أحاذر أن","تدين بها البوادي والحواضر",59,"ر",1,0]]}