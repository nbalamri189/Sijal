{"poems":[[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[80,"الأكثرين مسودا ومملكا","https://www.aldiwan.net/poem14192.html","الكامل"],[69,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[108,"خطيب هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179687",""],[80,"الأَكثَرين مُسَوَّدًا وَمُملَّكا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86645&r=&rc=140",""],[276,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[310,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[310,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[463,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122787","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46557","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49968","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48253","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27385","البسيط"],[3390,"","https://poetry.dctabudhabi.ae/diwan/poem/97786","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108384",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45739","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4929,"المروءة(2)","https://www.poetsgate.com/ViewPoem.aspx?id=211965",""],[4987,"ماعاد تستاهل","https://www.poetsgate.com/ViewPoem.aspx?id=49573",""],[5277,"المرثيّة الكاظميّة","https://www.poetsgate.com/ViewPoem.aspx?id=187574",""],[5324,"مكر النساء.","https://www.poetsgate.com/ViewPoem.aspx?id=211248",""],[5455,"الأسرار","https://www.poetsgate.com/ViewPoem.aspx?id=34367",""],[5458,"الغدفة","https://www.poetsgate.com/ViewPoem.aspx?id=113375",""],[5923,"في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=146240",""],[6093,"والطَّلحُ يُمسِكُ ما يفيدُ وما يضُرّْ","https://www.poetsgate.com/ViewPoem.aspx?id=189806",""]],"verses":[["المُكرِهينَ السَمهَرِيِّ بِأَذرُعٍ","كَصَواقِلِ الهِندِيِّ غَيرِ قِصارِ",0,"ر",1,0],["المُكثِرينَ مِنَ البُكاء لِنارهم","لا يُوقِدونَ بِغَيره لِلساري",1,"ر",2,0],["المكْثِرُونَ طَعَامَهُم وَطِعَانُهُمْ","يَوْمَ النَّزالِ وَفي السِّنِينَ المَمْحِلَهْ",2,"ل",2,0],["المكرمين القنا حتى إذا انكسرت","صدورها طعنوا بالأكعب الفُضُل",3,"ل",1,0],["المكانُ الذي سقطت عليه","حرمٌ آمنٌ، وساحُ جهاد",4,"د",1,0],["المُكثِرينَ مِنَ الكِباءِ لِنارهم","لا يُوقِدونَ بِغَيره لِلسّاري",5,"ر",2,0],["المكد شبين سر الصالحين فهم","اهل الهُدى وَالندى وَالمفخر العالي",6,"ل",2,0],["المكدشي الغياث المستغاث به","لحل منعقد أَو فتح أَفقال",6,"ل",1,0],["المكتسي بردَ المحامد سابغاً","وَإِن اِكتسى بالجود برد ملوّمِ",7,"م",1,0],["المُكتَسي بردَ الثناءِ مسهّماً","بِحلاهُ مجرورَ الذيولِ فَخارا",8,"ر",2,0],["المكتفين إذا غابوا بشُهرتهم","عن الشهادة والكافين ما حضَروا",9,"ر",3,0],["المُكرِهُونَ صُدُورَ الخَيلِ وارِدَةً","مِنَ المنيّةِ حَوضاً ما له عَطَنُ",10,"ن",1,0],["المكر وَالخَديعه","مِن نَكد الطبيعه",11,"ه",1,0],["المكرمين المطعمين","المنعمينَ على العشائِرْ",12,"ر",1,0],["المُكْرِمُ المُنْعمُ المفضالُ إِن وخَدَتْ","وَجْناً يُجَشِّمُها بالسيرِ مُنْتجعُ",13,"ع",1,0],["المكر من شيمةِ الموالي","لا تنخدع فيه إن خدعتا",14,"ت",2,0],["المكر يصحبه لو كنتَ تعقله","وليس يحذره إلا كأمثالي",15,"ل",2,0],["ألم كثير لمة ثم شمرت","به جلة يطلبن برقاً معالياً",16,"ي",2,1],["المكرم المحبوب منا اذ غدا","فينا بمنزلة المحب المكرم",17,"م",1,0],["المُكرَمين لِمَن أَتاهُم وافِداً","وَالمنعمين بأَوفر النَعماءِ",18,"ا",2,0],["المكهنى أبا عبيدة حاوى","شرف الهجرتين أعلى علاء",19,"ا",2,0],["المَكْرُمَاتُ مِنَ الخِصَالِ نُجُومُهَا","والأنبياءُ سِراجُِهَا الوَهَّاجُ",20,"ج",1,0],["المكان اللى عرفناه ماعاد المكان","والقلوب أحداث الايام زادت غمّها",21,"م",3,0],["المكرماتُ رداؤُهُ وحِباؤُهُ","طُرُقُ الهدى وعطاؤُهُ كمَياسِمِ",22,"م",1,0],["المكر من شيم النساء ومكرها","إبليس منه منزه وبراء.",23,"ا",2,0],["المكان اللي هنا .. مليان ضحكات ، وأغاني","والكلام اللي بغيت أقول .. يحتاج ل سكينه !",24,"ن",2,0],["المكر مبدؤهم والغدر شيمتهم","والسلم من معجم الألفاظ قد حذفا",25,"ف",2,0],["المُكْث في روض الأحبة آسري","وكذا بعشق الدار شعري ينطقُ",26,"ق",1,0],["المكتباتُ بِهنَّ كلُّ غَريبَةٍ","والغِرُّ يَأخذُ ما يعينُ وما يَغُرّْ",27,"ر",1,1]]}