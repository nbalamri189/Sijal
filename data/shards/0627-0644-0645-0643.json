{"poems":[[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[80,"الأكثرين مسودا ومملكا","https://www.aldiwan.net/poem14192.html","الكامل"],[69,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[108,"خطيب هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179687",""],[80,"الأَكثَرين مُسَوَّدًا وَمُملَّكا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86645&r=&rc=140",""],[274,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[308,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[308,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[460,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/97786","الطويل"]],"verses":[["المُكرِهينَ السَمهَرِيِّ بِأَذرُعٍ","كَصَواقِلِ الهِندِيِّ غَيرِ قِصارِ",0,"ر",1,0],["المُكثِرينَ مِنَ البُكاء لِنارهم","لا يُوقِدونَ بِغَيره لِلساري",1,"ر",2,0],["المكْثِرُونَ طَعَامَهُم وَطِعَانُهُمْ","يَوْمَ النَّزالِ وَفي السِّنِينَ المَمْحِلَهْ",2,"ل",2,0],["المكرمين القنا حتى إذا انكسرت","صدورها طعنوا بالأكعب الفُضُل",3,"ل",1,0],["المكانُ الذي سقطت عليه","حرمٌ آمنٌ، وساحُ جهاد",4,"د",1,0],["المُكثِرينَ مِنَ الكِباءِ لِنارهم","لا يُوقِدونَ بِغَيره لِلسّاري",5,"ر",2,0],["المكد شبين سر الصالحين فهم","اهل الهُدى وَالندى وَالمفخر العالي",6,"ل",2,0],["المكدشي الغياث المستغاث به","لحل منعقد أَو فتح أَفقال",6,"ل",1,0],["المكتسي بردَ المحامد سابغاً","وَإِن اِكتسى بالجود برد ملوّمِ",7,"م",1,0],["المُكتَسي بردَ الثناءِ مسهّماً","بِحلاهُ مجرورَ الذيولِ فَخارا",8,"ر",2,0],["المكتفين إذا غابوا بشُهرتهم","عن الشهادة والكافين ما حضَروا",9,"ر",3,0],["ألم كثير لمة ثم شمرت","به جلة يطلبن برقاً معالياً",10,"ي",2,1]]}