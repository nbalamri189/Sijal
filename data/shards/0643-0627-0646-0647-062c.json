{"poems":[[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[53,"يا رب بصري رصاصي الشمط","https://www.aldiwan.net/poem65015.html","الرجز"],[53,"ما أشبه العرف والإحسان بالحسنِ","https://www.aldiwan.net/poem66441.html","البسيط"],[47,"تفتأ عجبا بالشيء تدكره","https://www.aldiwan.net/poem63626.html","المنسرح"],[63,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[82,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[124,"ما تصنعون بفان مات أكثره","https://www.aldiwan.net/poem47408.html","البسيط"],[132,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[189,"توافق الناس في النسيان واختلفوا","https://www.aldiwan.net/poem14690.html","البسيط"],[266,"أراحمة قلبي وقد شفني الصبر","https://www.aldiwan.net/poem38281.html","الطويل"],[466,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[466,"إذا المرء لم يستخلص الحزم جنة","https://www.aldiwan.net/poem15140.html","الطويل"],[534,"انظر إلى الزهر تراه","https://www.aldiwan.net/poem37522.html","مجزوء الرجز"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31566","المجتث"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140219",""],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115997","البسيط"],[2451,"","https://poetry.dctabudhabi.ae/diwan/poem/103353","المجتث"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74239","البسيط"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20969","البسيط"],[4988,"نزوحي .. نكهة الحاظر وعبق الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=182912",""]],"verses":[["كَأَنَّ هِجانَها مُتَأَبِّضاتٍ","وَفي الأَقرانِ أَصوِرَةُ الرُعامِ",0,"م",1,0],["كأنه جوزةُ هندٍ أخذتْ","فقُشِّرَتْ أطرافها دون الوسطْ",1,"ط",1,0],["كأنه جنةُ الفردوس قد أَمِنَتْ","فيها النفوس من الروعات والحَزن",2,"ن",1,0],["كَأَنَّهُ جاءَ مُنجِزاً عِدَةً","وَبِتُّ في الراقِبينَ أَنتَظِرُه",3,"ر",2,0],["كأنه جَنَّةٌ راحَتْ حدائقُها","من الغَبِيَّينَ في نار وإعصارِ",4,"ر",1,0],["كأنّه جيشٌ لهامٌ حدا","من أُسُدِ الأبْطال جيشاً لهام",5,"م",1,0],["كأنه جثةٌ لم تلف دافنها","أو أنه جدثٌ يمشي وتنكرة",6,"ر",2,0],["كأنه جنةُ الفردوس منزلة","فيها الفواكهُ والخيراتُ والسررُ",7,"ر",1,0],["كأنه جاحد مُذْ قَطِّ وهْو على","حقٍّ ولكنْ بسرٍّ لاح معناه",8,"ا",2,0],["كأن هجير البيد والآل ضمنه","ضمائر ذي حقد يفر بها المكر",9,"ر",1,0],["كأنه جدولٌ والبحر قابضهُ","إذا انتضاه شديد البأس مجدود",10,"د",1,0],["كأنَّ هجيري بالفلاةِ وموردي","عِقابُ مطاعٍ ذي كمالٍ ونائله",11,"ل",2,0],["كَأَنَّهُ جَواهِرٌ","في قُضُبٍ منْ ذَهَبِ",12,"ب",1,0],["كأَنَّهُ جِسْمُ دُرٍّ","عَلَيْهِ دَرْجُ حَبَابِ",13,"ب",1,0],["كأنه جالس اصحابها","وناقش العالم في سفره",14,"ر",2,0],["كأنّهُ جُودُ مولانا ومالكنا","ومَن به يتباهى العُربُ والعجمُ",15,"م",1,0],["كأنّه جِيدُ تِبرٍ","يلوح في طوقِ فضه",16,"ض",2,0],["كَأَنَّهُ جَدول يَفتر عَن درر","مِن بَحر علم فَيلقيها عَلى الأَثَر",17,"ر",1,0],["كَأَنَّهُ جَيأَلٌ عَرفاءُ عارَضَها","كَلبٌ وَوابِلَةٌ دَسماءُ في فيها",18,"ه",2,1],["كانه جهل بالعلم بعطيه تلميح","عزمي جبل والريح تضرب سفوحي",19,"ح",2,0]]}