{"poems":[[53,"رب مستغمز إبائي وفي الناس","https://www.aldiwan.net/poem30176.html","الخفيف"],[63,"هذه دارها على الخلصاء","https://www.aldiwan.net/poem45779.html","الخفيف"],[100,"وحدة الشاعر","https://www.aldiwan.net/poem24839.html","عموديه"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[71,"أفديك من مولىً تملك خلتي","https://www.aldiwan.net/poem3973.html","الكامل"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[93,"عبد العزيز عميد أكرم أسرة","https://www.aldiwan.net/poem11140.html","الكامل"],[27,"قالوا نصيبك من أجر فقلت لهم","https://www.aldiwan.net/poem5959.html","البسيط"],[51,"يا دهر ما سبك غير ذي الخبث","https://www.aldiwan.net/poem9235.html","المنسرح"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[70,"آيات مجدك مالها تبديل","https://www.aldiwan.net/poem42766.html","الكامل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[45,"قد كان طيفك مرة يغرى بي","https://www.aldiwan.net/poem11429.html","الكامل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[61,"هويتها والفراق يهواها","https://www.aldiwan.net/poem51406.html","المنسرح"],[49,"اذكر معادك أفضل الذكر","https://www.aldiwan.net/poem62105.html","الكامل"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[69,"وجدي طويل عريض في محبته","https://www.aldiwan.net/poem28612.html","البسيط"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[48,"حي ربع الغنى وأطلال حسن","https://www.aldiwan.net/poem63392.html","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147608","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42609","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54525","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[100,"أمسية حجرية","https://www.poetsgate.com/ViewPoem.aspx?id=50362",""],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[105,"ولقد عجبت من الغواة وقولهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54944&r=&rc=114",""],[150,"يا خلي العين والأذن","https://www.aldiwan.net/poem68524.html","المديد"],[185,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[199,"يا للهوى والغزل","https://www.aldiwan.net/poem45354.html","مجزوء الرجز"],[225,"شمس المعالي كعقود الجمان","https://www.aldiwan.net/poem55208.html","السريع"],[229,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[229,"وضعيفة الألحاظ ساحرة","https://www.aldiwan.net/poem51042.html","أحذ الكامل"],[229,"جادك الغيث من محلة دار","https://www.aldiwan.net/poem51068.html","الخفيف"],[231,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[235,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[271,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[298,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[304,"يا وجيه إنها هب","https://www.aldiwan.net/poem16885.html","عموديه"],[322,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[349,"لا نلت منكم باللقا آمالي","https://www.aldiwan.net/poem15851.html","الكامل"],[377,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[377,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[380,"جد الضنا ويد الأشواق تلعب بي","https://www.aldiwan.net/poem48785.html","البسيط"],[391,"جاء نصر الله والفتح القريب","https://www.aldiwan.net/poem54614.html","عموديه"],[397,"عبد العزيز عميد أكرم أسرة","https://www.aldiwan.net/poem11013.html","عموديه"],[406,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[429,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[437,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[452,"كم حللت الحبى بشرخ الشباب","https://www.aldiwan.net/poem13629.html","الخفيف"],[452,"يا لعهد مضى وعيش رغيد","https://www.aldiwan.net/poem13711.html","الخفيف"],[458,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[458,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[458,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[461,"آبي الهضيمة شهم من بني مضر","https://www.aldiwan.net/poem15132.html","البسيط"],[477,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[477,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[515,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[538,"قد طال بي شوق إلى لقياكا","https://www.aldiwan.net/poem48000.html","عموديه"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["تَرتَقي جِرَّةَ البُطونِ مِنَ الجَه","دِ إِذا عَزَّ أَجرَدٌ وَقَصيصُ",0,"ص",1,0],["تَرتَوي حينَ يَنشُرُ الصُّبحُ سِقطَيْ","هِ مَساوِيكُهُنَّ مِن صَهباءِ",1,"ا",2,0],["ترتمي الأدهار حولي مثلما","يرتمي موج العباب المآثر",2,"ر",1,0],["تَرتَعي السَفحَ فَالكَثيبَ فَذا قا","رٍ فَرَوضَ القَطا فَذاتَ الرِئالِ",3,"ل",1,0],["تَرتاحُ لِلرّاجي إِلى أَقصى المَدى","كَرماً فَيَصغُرُ عِندَهُ ما يَمتَلِك",4,"ك",1,0],["تَرتَعُ ما رَتَعَت حَتّى إِذا اِدَّكَرَت","فَإِنَّما هِيَ إِقبالٌ وَإِدبارُ",5,"ر",1,0],["تَرْتَاضُ مَصْعَبَةَ الأُمُورِ فَمَا تَنِي","حَتَّى تُجَارِي فِي مَرَامِكَ قُودَهَا",6,"د",3,0],["تَرتَعُ ما نَسِيَت حَتّى إِذا ذَكَرَت","رَدَّت هَماهِمَ حَرّى الجَوفِ مِثكالِ",7,"ل",1,0],["ترتعثُ الأذنُ من مدائحهِ","ما ليس من غيرها بمُرتعَثِ",8,"ث",1,0],["ترْتَجُّ أردافُها والمَتْنُ مُنْدمِجٌ","والكَشْحُ مُضْطمِرٌ والبطنُ طيَّان",9,"ن",1,0],["تَرتَدُّ عَنهُ العاصِفاتُ كَليلَةً","وَيَزُلُّ عَنهُ العارِضُ المِدرارُ",10,"ر",1,0],["تَرتَدُّ عَنّي الحادِثاتُ بِذِكرِها","وَكَأَنَّها دوني قَناً وَنُصولُ",11,"ل",1,0],["تَرتَمي بِهِنَّ حِمىً","لا يَجوزُهُ رَغَبُ",12,"ب",1,0],["تَرتاعُ مِن وَهَلٍ وَتَأنَسُ أَن تَرى","قَمَراً يَنوءُ بِباتِكٍ قَضّابِ",13,"ب",1,0],["تَرتَعي مِنهُ في جَنابٍ مَريعٍ","مونِقِ النَبتِ طَيِّبِ المَورودِ",14,"د",1,0],["تَرتعُ حولَ الظِّباء آنسةً","نظائراً في الجمالِ أَشباها",15,"ا",3,0],["تَرتاحُ مِن عِبَرٍ إِلى سِعَةٍ","وَتَفِرُّ مِن فَقرٍ إِلى فَقرِ",16,"ر",1,0],["تَرَتَّبَتِ الأَحزانُ فيكَ مَراتِباً","بِقَلبي وَرَقمُ الصَبرِ مِن بَينِها صِفرُ",17,"ر",1,0],["ترتمي في مُلَوَّناتِ لُبُودٍ","كرياضٍ نَوّرْنَ فوق إكامِ",18,"م",1,0],["ترتجُّ أردافُهُ مشياً فينشدُها","يا حبَّذا جبلُ الريانِ مِنْ جبلِ",19,"ل",1,0],["تَرتدُّ عن تاجِهِ الأبصارُ خاشعةً","فما تُلاحِظُه إلا على وَجَلِ",20,"ل",1,0],["تَرتَدي بالاكمامِ عَنْهَا حَيَاءً","وهي غِيدٌ يَتْلَعْنَ بالأعْنَاقِ",21,"ق",1,0],["ترْتَبي مرهوبةً تَحْسَبُها","كوكَبَ الليل على الليلِ رصَد",22,"د",1,0],["تَرتَعي عُفرُ شِدَّةَ الحالِ فيها","وَظِبا فاقَةٍ وَظُلمانُ فَقرِ",23,"ر",1,0],["ترتاح في الصيف إلى أشهر ال","قرّ وفي مشتاك للصيف",24,"ف",1,1],["تَرْتَدُّ عَنْهُ قَنَابِلٌ وَجَحَافِلٌ","وَتَكِلُّ عَنْهُ أَسِنَّةٌ وَشِفَارُ",25,"ر",1,0],["تَرْتَدُّ عَيْنُ الشَّمْسِ فِي سَتَرَاتِهَا","وَيَضِلُّ فِي هَبَوَاتِهَا الإِشْرَاقُ",26,"ق",1,0],["تَرْتقِي مَا تَشَاءُ فِي القَوْلِ حَتَّى","يَحْبِسَ الْقَلْبُ نَبْضَهُ أَوْ يَكَادُ",27,"د",1,0],["تَرْتَقِي عَرَشَ سَعْدِهَا وَإلَيْهِ","تَتَخَطَّى مَعَارِجَ العَلْيَاءِ",28,"ا",2,0],["تَرْتَاضُ أَوْ تَرْتَادُ كُلَّ دَغِيلَةٍ","كَمَنَتْ بِهَا الأَنْيَابُ وَالأَظْفَارُ",29,"ر",1,0],["تَرتَجي الرَحْمَنَ في مِحْنَتِهَا","ثُمَّ تَخْشَى في الْمُصابِ الْقَدَرَا",30,"ر",2,0],["ترتجُّ من حزنه قصيدته","ويصطلي في لهيبها ضجره",31,"ر",2,0],["تَرْتَجيِ الْحَصْدَ ثمَّ تقعُدُ في الشَّمْسِ","لك اللّه يا أَخا التُّرَهَاتِ",32,"ت",1,0],["تُرَتِّلُها أَلْسُنٌ مثلما","ترتِّل في الليلِ أورادها",33,"د",3,0],["ترتدي الأنقاض والشوك على","جيدها من أعين الموتى قلاده",34,"د",2,0],["ترتجي أن تصبح الكف وأن","تصبح الأملاك بعض الأنمل",35,"ل",1,0],["ترتاد أسباب النجاة من العدى","فيردنا الأدنى إلينا الأقرب",36,"ب",1,0],["ترتجي فوزاً وهل أحدٌ","نال ما يرجو بلا ثمن",37,"ن",1,0],["تَرْتع في حُلَّةٍ مُصَنْدَلةٍ","والعِطْرُ في الروضِ عِطْرُها يَعْبَق",38,"ق",1,0],["ترتجُّ كالطيرِ غدا","في كفَّةِ المحتبلِ",39,"ل",1,0],["تَرتَعُ مِصرُ العُمرَ من ظِلِّهِ","في نَضرَةِ الرَوضِ وَطيبِ الجِنان",40,"ن",1,0],["تَرْتَحِلُ المُكْرمُاتُ إنْ رَحَلوا","وتَنْزِل الصالحاتُ إنْ نَزَلُوا",41,"ل",3,0],["ترتجّ من ثِقَلِ روادفُها","حتّى تنوءَ بدقّة الخَصْر",42,"ر",1,0],["ترتمي مَجْهَل المهامِه مني","بقليلِ الكَرَى قليلِ الحِذار",43,"ر",1,0],["ترتمي في الفلا لها الشوق حاد","ولها نشرمن تحب دليل",44,"ل",1,0],["تَرتَعُ مِن ظِلِّهِ وَنائِلِهِ ال","عُفاةُ في وارِفٍ وَمَسكوبِ",45,"ب",1,0],["تَرتاده الآمال رمضة ممل","وَتذوقه الاعداء سما علقما",46,"م",2,0],["ترتمي في حضنهِ محمرَّةً","خجلاً كالرودِ في حضنِ خدين",47,"ن",1,0],["ترتجي منه يسكن","نا جنان الخلود",48,"د",1,0],["تَرتَعي نَبتَ عَدابٍ مُونِقٍ","نَورَ مِزبادٍ وَنَوراً لِلكَرِش",49,"ش",1,0],["تَرتاحُ روحي بِالغَداةِ لِنَشرِكُم","وَيَزيدُها قَلَقاً مَعَ الآصالِ",50,"ل",1,0],["ترتد عن محميها أيدي العدا","ويفر عن مثواه ساطانيل",51,"ل",1,0],["ترتدُّ عنها عيونُ الناس خاسئَةً","كأَنَّها رُقِمَت في طِرسِ أَقذاءِ",52,"ا",2,0],["تَرتاح مِن سَهَري ظُلماً وَمِن تَعَبي","فَصارَ عِندي الكَرى ضَرباً مِن الريب",53,"ب",1,0],["ترتجي الرحمن يرحم ضعفنا","ويقينا كل مكروه تعيب",54,"ب",1,0],["ترتاض مصعبة المور فما تني","حتى تجاري في مرامك قودها",55,"د",3,0],["تَرتَقي الدَست وَالمَنابِر وَالخَ","يل فَتَختال كُلَّها بِكَ كِبرا",56,"ر",2,0],["ترتجي العفو حيث لاح سناها","بثناء يا ذا الرضيّ الموالي",57,"ي",1,0],["ترتمي بالفلاة والليل قد م","على الخانقين منه رداء",58,"ا",2,0],["ترتجي منكم الإِجازة في المروي","مَهْراً فتلك أقصى الطلاب",59,"ب",1,0],["ترتجي نظرة القبول وتختا","ل من التيه في حبير البُرُود",60,"د",1,0],["ترتدُّ للسالي صبابتَه","وتعلِّل المشتاقَ أو تُسلي",61,"ل",2,0],["ترتع فيه مرِحاتٍ بُدُناً","كما اشتهت ربيقةً أن تُطلَقا",62,"ق",2,0],["ترتاح للضَّحضاح خائضةً","وتكُدُّ بالمتعمِّقِ الغَمرِ",63,"ر",1,0],["ترتاعُ منكَ العوالي وهي مُشرَعةٌ","وتحسد الجود منك الحُفَّلُ النطفُ",64,"ف",1,0],["ترتمي كالهيَْقِ بي معنِقَةً","فوقَها حِدْنُ سِفارٍ لنْ يَملَّه",65,"ل",2,0],["ترتاعُ للصوتِ واِرهابِه","كأنَّما في ثِنيهِ أرقمُ",66,"م",1,0],["ترتَمي شوقاً فلولا ثِقْلُ ما","في صُدورِ الرّكْبِ طارَتْ في سُراها",67,"ا",3,0],["ترتاد روض الورد لا روض الندى","رفعاً لها عن وبله المترقرق",68,"ق",1,0],["تَرتدُّ عينُ النَّاظِرينَ كَلِيلَةً","يَا شمسُ إن نُظِرَت لنُورُ سَنَاكا",69,"ك",2,0],["ترتعي بالصُّدودِ أَخضرَ عَيْشِي","أَتُراها ظَنَّتْه بَعْضَ العُشْب",70,"ب",1,0]]}