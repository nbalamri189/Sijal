997,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=214294",""],[6045,"همسات السراجي","https://www.poetsgate.com/ViewPoem.aspx?id=135937",""],[161,"أنشودة للصغار / وصف هررة صغار","https://www.poetsgate.com/ViewPoem.aspx?id=164385",""],[6093,"ترتاح نفسي إن نظرت لحسنها","https://www.poetsgate.com/ViewPoem.aspx?id=202896",""],[6097,"فرّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190668",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""],[6323,"واحة العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82170&r=&rc=1",""]],"verses":[["تَرتَقي جِرَّةَ البُطونِ مِنَ الجَه","دِ إِذا عَزَّ أَجرَدٌ وَقَصيصُ",0,"ص",1,0],["تَرتَوي حينَ يَنشُرُ الصُّبحُ سِقطَيْ","هِ مَساوِيكُهُنَّ مِن صَهباءِ",1,"ا",2,0],["ترتمي الأدهار حولي مثلما","يرتمي موج العباب المآثر",2,"ر",1,0],["تَرتَعي السَفحَ فَالكَثيبَ فَذا قا","رٍ فَرَوضَ القَطا فَذاتَ الرِئالِ",3,"ل",1,0],["تَرتاحُ لِلرّاجي إِلى أَقصى المَدى","كَرماً فَيَصغُرُ عِندَهُ ما يَمتَلِك",4,"ك",1,0],["تَرتَعُ ما رَتَعَت حَتّى إِذا اِدَّكَرَت","فَإِنَّما هِيَ إِقبالٌ وَإِدبارُ",5,"ر",1,0],["تَرْتَاضُ مَصْعَبَةَ الأُمُورِ فَمَا تَنِي","حَتَّى تُجَارِي فِي مَرَامِكَ قُودَهَا",6,"د",3,0],["تَرتَعُ ما نَسِيَت حَتّى إِذا ذَكَرَت","رَدَّت هَماهِمَ حَرّى الجَوفِ مِثكالِ",7,"ل",1,0],["ترتعثُ الأذنُ من مدائحهِ","ما ليس من غيرها بمُرتعَثِ",8,"ث",1,0],["ترْتَجُّ أردافُها والمَتْنُ مُنْدمِجٌ","والكَشْحُ مُضْطمِرٌ والبطنُ طيَّان",9,"ن",1,0],["تَرتَدُّ عَنهُ العاصِفاتُ كَليلَةً","وَيَزُلُّ عَنهُ العارِضُ المِدرارُ",10,"ر",1,0],["تَرتَدُّ عَنّي الحادِثاتُ بِذِكرِها","وَكَأَنَّها دوني قَناً 