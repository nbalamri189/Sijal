09","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54525","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[105,"ولقد عجبت من الغواة وقولهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54944&r=&rc=114",""],[148,"يا خلي العين والأذن","https://www.aldiwan.net/poem68524.html","المديد"],[183,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[197,"يا للهوى والغزل","https://www.aldiwan.net/poem45354.html","مجزوء الرجز"],[223,"شمس المعالي كعقود الجمان","https://www.aldiwan.net/poem55208.html","السريع"],[227,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[227,"وضعيفة الألحاظ ساحرة","https://www.aldiwan.net/poem51042.html","أحذ الكامل"],[227,"جادك الغيث من محلة دار","https://www.aldiwan.net/poem51068.html","الخفيف"],[229,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[233,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[269,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[296,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[302,"يا وجيه إنها هب","https://www.aldiwan.net/poem16885.html","عموديه"],[320,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[347,"لا نلت منكم باللقا آمالي","https://www.aldiwan.net/poem15851.html","الكامل"],[374,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[374,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[377,"جد الضنا ويد الأشواق تلعب بي","https://www.aldiwan.net/poem48785.html","البسيط"],[388,"جاء نصر الله والفتح القريب","https://www.aldiwan.net/poem54614.html","عموديه"],[394,"عبد العزيز عميد أكرم أسرة","https://www.aldiwan.net/poem11013.html","عموديه"],[403,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[426,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[434,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[450,"كم حللت الحبى بشرخ الشباب","https://www.aldiwan.net/poem13629.html","الخفيف"],[450,"يا لعهد مضى وعيش رغيد","https://www.aldiwan.net/poem13711.html","الخفيف"],[456,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[456,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[459,"آبي الهضيمة شهم من بني مضر","https://www.aldiwan.net/poem15132.html","البسيط"],[475,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[475,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[513,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[536,"قد طال بي شوق إلى لقياكا","https://www.aldiwan.net/poem48000.html","عموديه"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["تَرتَقي جِرَّةَ البُطونِ مِنَ الجَه","دِ إِذا عَزَّ أَجرَدٌ وَقَصيصُ",0,"ص",1,0],["تَرتَوي حينَ يَنشُرُ الصُّبحُ سِقطَيْ","هِ مَساوِيكُهُنَّ مِن صَهباءِ",1,"ا",2,0],["تَرتَعي السَفحَ فَالكَثيبَ فَذا قا","رٍ فَرَوضَ القَطا فَذاتَ الرِئالِ",2,"ل",1,0],["تَرتاحُ لِلرّاجي إِلى أَقصى المَدى","كَرماً فَيَصغُرُ عِندَهُ ما يَمتَلِك",3,"ك",1,0],["تَرتَعُ ما رَتَعَت حَتّى إِذا اِدَّكَرَت","فَإِنَّما هِيَ إِقبالٌ وَإِدبارُ",4,"ر",1,0],["تَرْتَاضُ مَصْعَبَةَ الأُمُورِ فَمَا تَنِي","حَتَّى تُجَارِي فِي مَرَامِكَ قُودَهَا",5,"د",3,0],["تَرتَعُ ما نَسِيَت حَتّى إِذا ذَكَرَت","رَدَّت هَماهِمَ حَرّى الجَوفِ مِثكالِ",6,"ل",1,0],["ترتعثُ الأذنُ من مدائحهِ","ما ليس من غيرها بمُرتعَثِ",7,"ث",1,0],["ترْتَجُّ أردافُها والمَتْنُ مُنْدمِجٌ","والكَشْحُ مُضْطمِرٌ والبطنُ طيَّان",8,"ن",1,0],["تَرتَدُّ عَنهُ العاصِفاتُ كَليلَةً","وَيَزُلُّ عَنهُ العارِضُ المِدرارُ",9,"ر",1,0],["تَرتَدُّ عَنّي الحادِثاتُ بِذِكرِها","وَكَأَنَّها دوني قَناً وَنُصولُ",10,"ل",1,0],["تَرتَمي بِهِنَّ حِمىً","لا يَجوزُهُ رَغَبُ",11,"ب",1,0],["تَرتاعُ مِن وَهَلٍ وَتَأنَسُ أَن تَرى","قَمَراً يَنوءُ بِباتِكٍ قَضّابِ",12,"ب",1,0],["تَرتَعي مِنهُ في جَنابٍ مَريعٍ","مونِقِ النَبتِ طَيِّبِ المَورودِ",13,"د",1,0],["تَرتعُ حولَ الظِّباء آنسةً","نظائراً في الجمالِ أَشباها",14,"ا",3,0],["تَرتاحُ مِن عِبَرٍ إِلى سِعَةٍ","وَتَفِرُّ مِن فَقرٍ إِلى فَقرِ",15,"ر",1,0],["تَرَتَّبَتِ الأَحزانُ فيكَ مَراتِباً","بِقَلبي وَرَقمُ الصَبرِ مِن بَينِها صِفرُ",16,"ر",1,0],["ترتمي في مُلَوَّناتِ لُبُودٍ","كرياضٍ نَوّرْنَ فوق إكامِ",17,"م",1,0],["ترتجُّ أردافُهُ مشياً فينشدُها","يا حبَّذا جبلُ الريانِ مِنْ جبلِ",18,"ل",1,0],["تَرتدُّ عن تاجِهِ الأبصارُ خاشعةً","فما تُلاحِظُه إلا على وَجَلِ",19,"ل",1,0],["تَرتَدي بالاكمامِ عَنْهَا حَيَاءً","وهي غِيدٌ يَتْلَعْنَ بالأعْنَاقِ",20,"ق",1,0],["ترْتَبي مرهوبةً تَحْسَبُها","كوكَبَ الليل على الليلِ رصَد",21,"د",1,0],["تَرتَعي عُفرُ شِدَّةَ الحالِ فيها","وَظِبا فاقَةٍ وَظُلمانُ فَقرِ",22,"ر",1,0],["ترتاح في الصيف إلى أشهر ال","قرّ وفي مشتاك للصيف",23,"ف",1,1],["تَرْتَدُّ عَنْهُ قَنَابِلٌ وَجَحَافِلٌ","وَتَكِلُّ عَنْهُ أَسِنَّةٌ وَشِفَارُ",24,"ر",1,0],["تَرْتَدُّ عَيْنُ الشَّمْسِ فِي سَتَرَاتِهَا","وَيَضِلُّ فِي هَبَوَاتِهَا الإِشْرَاقُ",25,"ق",1,0],["تَرْتقِي مَا تَشَاءُ فِي القَوْلِ حَتَّى","يَحْبِسَ الْقَلْبُ نَبْضَهُ أَوْ يَكَادُ",26,"د",1,0],["تَرْتَقِي عَرَشَ سَعْدِهَا وَإلَيْهِ","تَتَخَطَّى مَعَارِجَ العَلْيَاءِ",27,"ا",2,0],["تَرْتَاضُ أَوْ تَرْتَادُ كُلَّ دَغِيلَةٍ","كَمَنَتْ بِهَا الأَنْيَابُ وَالأَظْفَارُ",28,"ر",1,0],["تَرتَجي الرَحْمَنَ في مِحْنَتِهَا","ثُمَّ تَخْشَى في الْمُصابِ الْقَدَرَا",29,"ر",2,0],["ترتجُّ من حزنه قصيدته","ويصطلي في لهيبها ضجره",30,"ر",2,0],["تَرْتَجيِ الْحَصْدَ ثمَّ تقعُدُ في الشَّمْسِ","لك اللّه يا أَخا التُّرَهَاتِ",31,"ت",1,0],["تُرَتِّلُها أَلْسُنٌ مثلما","ترتِّل في الليلِ أورادها",32,"د",3,0],["ترتجي أن تصبح الكف وأن","تصبح الأملاك بعض الأنمل",33,"ل",1,0],["ترتاد أسباب النجاة من العدى","فيردنا الأدنى إلينا الأقرب",34,"ب",1,0],["ترتجي فوزاً وهل أحدٌ","نال ما يرجو بلا ثمن",35,"ن",1,0],["تَرْتع في حُلَّةٍ مُصَنْدَلةٍ","والعِطْرُ في الروضِ عِطْرُها يَعْبَق",36,"ق",1,0],["ترتجُّ كالطيرِ غدا","في كفَّةِ المحتبلِ",37,"ل",1,0],["تَرتَعُ مِصرُ العُمرَ من ظِلِّهِ","في نَضرَةِ الرَوضِ وَطيبِ الجِنان",38,"ن",1,0],["تَرْتَحِلُ المُكْرمُاتُ إنْ رَحَلوا","وتَنْزِل الصالحاتُ إنْ نَزَلُوا",39,"ل",3,0],["ترتجّ من ثِقَلِ روادفُها","حتّى تنوءَ بدقّة الخَصْر",40,"ر",1,0],["ترتمي مَجْهَل المهامِه مني","بقليلِ الكَرَى قليلِ الحِذار",41,"ر",1,0],["ترتمي في الفلا لها الشوق حاد","ولها نشرمن تحب دليل",42,"ل",1,0],["تَرتَعُ مِن ظِلِّهِ وَنائِلِهِ ال","عُفاةُ في وارِفٍ وَمَسكوبِ",43,"ب",1,0],["تَرتاده الآمال رمضة ممل","وَتذوقه الاعداء سما علقما",44,"م",2,0],["ترتمي في حضنهِ محمرَّةً","خجلاً كالرودِ في حضنِ خدين",45,"ن",1,0],["ترتجي منه يسكن","نا جنان الخلود",46,"د",1,0],["تَرتَعي نَبتَ عَدابٍ مُونِقٍ","نَورَ مِزبادٍ وَنَوراً لِلكَرِش",47,"ش",1,0],["تَرتاحُ روحي بِالغَداةِ لِنَشرِكُم","وَيَزيدُها قَلَقاً مَعَ الآصالِ",48,"ل",1,0],["ترتد عن محميها أيدي العدا","ويفر عن مثواه ساطانيل",49,"ل",1,0],["ترتدُّ عنها عيونُ الناس خاسئَةً","كأَنَّها رُقِمَت في طِرسِ أَقذاءِ",50,"ا",2,0],["تَرتاح مِن سَهَري ظُلماً وَمِن تَعَبي","فَصارَ عِندي الكَرى ضَرباً مِن الريب",51,"ب",1,0],["ترتجي الرحمن يرحم ضعفنا","ويقينا كل مكروه تعيب",52,"ب",1,0],["ترتاض مصعبة المور فما تني","حتى تجاري في مرامك قودها",53,"د",3,0],["تَرتَقي الدَست وَالمَنابِر وَالخَ","يل فَتَختال كُلَّها بِكَ كِبرا",54,"ر",2,0],["ترتجي العفو حيث لاح سناها","بثناء يا ذا الرضيّ الموالي",55,"ي",1,0],["ترتمي بالفلاة والليل قد م","على الخانقين منه رداء",56,"ا",2,0],["ترتجي منكم الإِجازة في المروي","مَهْراً فتلك أقصى الطلاب",57,"ب",1,0],["ترتجي نظرة القبول وتختا","ل من التيه في حبير البُرُود",58,"د",1,0],["ترتدُّ للسالي صبابتَه","وتعلِّل المشتاقَ أو تُسلي",59,"ل",2,0],["ترتع فيه مرِحاتٍ بُدُناً","كما اشتهت ربيقةً أن تُطلَقا",60,"ق",2,0],["ترتاح للضَّحضاح خائضةً","وتكُدُّ بالمتعمِّقِ الغَمرِ",61,"ر",1,0],["ترتاعُ منكَ العوالي وهي مُشرَعةٌ","وتحسد الجود منك الحُفَّلُ النطفُ",62,"ف",1,0],["ترتمي كالهيَْقِ بي معنِقَةً","فوقَها حِدْنُ سِفارٍ لنْ يَملَّه",63,"ل",2,0],["ترتاعُ للصوتِ واِرهابِه","كأنَّما في ثِنيهِ أرقمُ",64,"م",1,0],["ترتَمي شوقاً فلولا ثِقْلُ ما","في صُدورِ الرّكْبِ طارَتْ في سُراها",65,"ا",3,0],["ترتاد روض الورد لا روض الندى","رفعاً لها عن وبله المترقرق",66,"ق",1,0],["تَرتدُّ عينُ النَّاظِرينَ كَلِيلَةً","يَا شمسُ إن نُظِرَت لنُورُ سَنَاكا",67,"ك",2,0],["ترتعي بالصُّدودِ أَخضرَ عَيْشِي","أَتُراها ظَنَّتْه بَعْضَ العُشْب",68,"ب",1,0]]}