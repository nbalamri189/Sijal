{"poems":[[55,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[55,"أيا شاكيا مني لذنب جنيته","https://www.aldiwan.net/poem30727.html","الطويل"],[65,"جوانح للغرام بها وشوم","https://www.aldiwan.net/poem45778.html","الوافر"],[65,"أقول لنفسي وهي تطوى ضلوعها","https://www.aldiwan.net/poem45940.html","الطويل"],[29,"ألا حي بالبردين دارا ولا أرى","https://www.aldiwan.net/poem6020.html","الطويل"],[53,"كريم كثرت قدما","https://www.aldiwan.net/poem65895.html","الهزج"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[53,"تعرض لي دونه معشر","https://www.aldiwan.net/poem66355.html","المتقارب"],[87,"سألتك بالوداد أبا حسين","https://www.aldiwan.net/poem8058.html","الوافر"],[47,"لئن راح روح هاربا من ضيوفه","https://www.aldiwan.net/poem62712.html","الطويل"],[47,"غروب دمع من الأجفان تنهمل","https://www.aldiwan.net/poem65629.html","الخفيف"],[46,"سأشكر لابني وهب الهبة التي","https://www.aldiwan.net/poem30340.html","الطويل"],[46,"وراءك عن شاك قليل العوائد","https://www.aldiwan.net/poem30605.html","الطويل"],[50,"لئن رحت مبيض الذوائب من شعري","https://www.aldiwan.net/poem63285.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85292","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55189","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/3032","البسيط"],[92,"بين قطرين","https://www.poetsgate.com/ViewPoem.aspx?id=179019",""],[47,"غُروبُ دَمْعِ مِنَ الأَجْفَانِ تَنْهَمِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=31856",""],[272,"لئن رحلت جملي إن لي سعة","https://www.aldiwan.net/poem1148.html",""],[353,"قطائفك التي رقت جسوما","https://www.aldiwan.net/poem19855.html","الوافر"],[369,"بكل يمين للورى وشمال","https://www.aldiwan.net/poem60804.html","الكامل"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[376,"أيترك سر بعد سري لكاتم","https://www.aldiwan.net/poem57133.html","الطويل"],[447,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[447,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[469,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[518,"لئن رقد الواشي سرورا بما رأى","https://www.aldiwan.net/poem67782.html","الطويل"],[567,"ما بال موسى بلا سمع ولا بصر","https://www.aldiwan.net/poem52934.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126733","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53875","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54192","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48568","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1501,"","https://poetry.dctabudhabi.ae/diwan/poem/146657","الوافر"],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142262","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69414","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42461","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53054","البسيط"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110625","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100920","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94241","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3142,"","https://poetry.dctabudhabi.ae/diwan/poem/74137","الطويل"],[3180,"","https://poetry.dctabudhabi.ae/diwan/poem/204515","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89427","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123915","الوافر"],[3517,"","https://poetry.dctabudhabi.ae/diwan/poem/98030","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48329","الطويل"],[3638,"","https://poetry.dctabudhabi.ae/diwan/poem/203036","اللويحاني"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139840",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102946","الطويل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146862","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94396","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94328","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94786","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94386","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94579","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73302","الطويل"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[4984,"هِمَّةُ النَّفْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=201419",""],[5183,"مبعث الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180278",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5198,"نجمة الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=135527",""],[5302,"بلغوا هندا سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=200950",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5409,"ذكراك وهي لها في الدهر تجديد","https://www.poetsgate.com/ViewPoem.aspx?id=155263",""],[5616,"الراحلون","https://www.poetsgate.com/ViewPoem.aspx?id=204853",""],[5628,"رثاء صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178672",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5790,"غرامي إليكم ما عليه مزيد","https://www.poetsgate.com/ViewPoem.aspx?id=111993",""],[6093,"لَئِنْ رَحَلْتَ فَعَنْ سَمْعِيْ وعَنْ بَصري","https://www.poetsgate.com/ViewPoem.aspx?id=178925",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[6152,"صبا نجد","https://www.poetsgate.com/ViewPoem.aspx?id=201750",""],[6213,"هل تحيين بعدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79465&r=&rc=67",""],[5616,"الرّاحلون ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1934&r=&rc=4",""],[6316,"في رثاء الشيخ بن باز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65165&r=&rc=0",""]],"verses":[["لَئِن رامَ قَبضاً مِن بَنانِكَ حادِثٌ","لَقَد عاضَنا مِنكَ اِنبِساطُ جَنانِ",0,"ن",1,0],["لَئِن رابَ مِنّي ما يُريبُ فَإِنَّني","عَلى عُدَواءِ الدَهرِ غَيرُ مُريبِ",1,"ب",1,0],["لَئِنْ رَقَدَتْ ظَلومُ وأَسهَرَتني","فَذلكَ دأَبُها وَهْيَ الظَّلومُ",2,"م",1,0],["لَئِنْ رَمَّ في أَحْوالِهِمْ حَادِثُ الغِنى","فَقَدْ كادَ مِنْ أَفْعالِهِم يَقْطُرُ الفَقرُ",3,"ر",1,0],["لَئِن راهَنَت عَدواً عَلَيكَ مُجاشِعٌ","لَقَد لَقِيَت نَقصاً وَطاشَت حُلومُها",4,"م",3,0],["لئِن رُحتُ وما حَسَّ","ن إحسانُك من حالي",5,"ل",2,0],["لئِنْ راح مقسوماً لهُ الفضلُ إنَّهُ","لأهْلٌ له واللَّه أعدلُ قاسمِ",6,"م",1,0],["لئن رَحِموا الشعرَ من لؤمه","لحقَّ وحقوا بأنْ يرْحموه",7,"م",3,0],["لَئِن رَفَعوكَ مَنزِلَةً فَأَعلى","لَقَد خُلِقَ الأَهِلَّةُ لِلصُعودِ",8,"د",1,0],["لَئِن راحَ رَوحٌ هارِباً مِن ضُيوفِهِ","فَما المَطَرُ الثاني عُمَيرٌ بِرائِحِ",9,"ح",1,1],["لَئِن رُزِقتَ الَّتي ما مِثلُها اِمرَأَةٌ","لَقَد أُتيتَ الَّذي لَم يُؤتَهُ رَجُلُ",10,"ل",1,0],["لَئِن رُمتُ أَمراً غِبتُما عِندَ بِكرِهِ","لَقَد سَرَّني فِعلاكُما في عَوانِهِ",11,"ن",2,0],["لَئِن رَقَدَ النُصّارُ عَمّا أَصابَنا","فَما اللَهُ عَمّا نيلُ مِنّا بِراقِدِ",12,"د",1,0],["لَئِن رَحتُ مُبيَضَّ الذَوائِبِ مِن شَعري","وَأَبدَلَني دَهري غُرابِيَ بِالنِسرِ",13,"ر",1,1],["لئن رجعت أَيام لَيلى كعهدها","شكوت إليها بعض ما فعل الهجرُ",14,"ر",1,1],["لِينُرْ شعَاعُكِ يَا عرُوس النِّيلِ","وَيُسِرْ شِرَاعُكِ فِي أَبَرِّ سَبِيلِ",15,"ل",1,1],["لَئِن رَكَنتُ إِلى الدُنيا وَزينَتَها","لَأَخرُجَنَّ مِنَ الدُنيا بِحَسرَتِيَه",16,"ت",3,0],["لئن راقكم ماءُ الفرات وظلِّلتْ","عليكم من الصَفصاف والنخل أظلال",17,"ل",1,0],["لَئِنْ رُزِيتَ الَّتِي ما مِثْلُها امْرَأَةٌ","لَقَدْ أَتِيتَ الَّذي لَمْ يُؤْتَهُ رَجُلُ",18,"ل",1,0],["لَئِن رَحَلت جملي إِنَّ لي سَعَةً","ما مِثلُها سَعَةٌ عَرضاً وَلا طولا",19,"ل",2,1],["لَئِنْ رَقّتْ لابِسُها وَحَلَّتْ","لِعِظْمِ مَحَلِّها الصَّدْرَ الرَّحِيبَا",20,"ب",2,0],["لئنْ ردَّ أيّامي قِصاراً فإنّني","سَموْتُ بآمالٍ إليهِ طِوال",21,"ل",1,0],["لئن رُفّهَ الصَّمصامُ بالغِمْد مَرّةً","لَمُرتقَبٌ منه وَشيكَ التَّبَرُّج",22,"ج",1,0],["لَئِن رَكضَت خَيلُ الخُطوبِ تُريدُني","فأيدي العَطايا قابِضاتُ الشَّكائِمِ",23,"م",1,0],["لئن رضيت فإني بالرضى قمن","وإن غضبت فيا ويلي من الغضب",24,"ب",1,0],["لئن رضيت ومنك اللظف قابلني","فمن سواك فلا أخشى من الغضب",25,"ب",1,0],["لئن رجعتْ تلك المطيُّ بمن مضى","فيا حبذا أخفافها والمناسم",26,"م",1,0],["لئن رقد الواشي سروراً بما رأى","وهان عليه أن يقر وأنصبا",27,"ب",2,1],["لَئِن رَثَيناهُ عن خُبْرٍ بمَوضِعِهِ","فكم رَثاهُ بعيدُ الدَّارِ عن خَبَرِ",28,"ر",1,0],["لَئِن رحلَ الفقيد وغاب عنّا","لنا في شبله أمل وطيدُ",29,"د",1,0],["لئن رَضيَتْ هجري رضِيتُ بوَصْلها","وطال مَدَى عَتْبي على ذاك وامتدّا",30,"د",2,0],["لَئنْ رأى النّاسُ أنَّ العزْلَ آلمِني","ونَغَّصَ العيش لي أوْ أذْهَبَ الوَسَنَا",31,"ن",2,1],["لئن رقصتم له عجباً فقد رقصوا","تألماً وبكأس الحزن قد سكروا",32,"ر",3,0],["لئن رضيتُ له دمعاً بغير دمٍ","لقد رضيتْ له مني بغير رضا",33,"ض",2,0],["لئن رأَستْ لقد عَظُمَت وزادت","رياسَتُها بصاحبها الرئيس",34,"س",1,0],["لَئِن رَفَعَ الغَنيُّ لِواءَ مالٍ","لَأَنتَ لِواءَ عِلمِكَ قَد رَفَعتا",35,"ت",2,0],["لئن رفع الوزارة منك قدرا","فقد ضعفت من قدر الإماره",36,"ر",2,0],["لئن رد لي ذاك الزمان وأنسه","لأنشر أعلاماً وللصوم أطمع",37,"ع",1,0],["لَئِن رَهِبُوا لَمّا رَأَوكَ لَقَد رَأَوا","بِكَ الهَولَ إِنَّ المَنظَرَ الهَولَ مَرهُوبُ",38,"ب",1,0],["لَئِن رُفِعوا لَقَد نَفَعوا وَلَولا","سُلوكُ العِقدِ ما اِنتَظَمَ الجُمانُ",39,"ن",1,0],["لئنْ رمتَ سلواني عِدمتكَ لاحياً","فلستُ إلى السلوانِ في الحبِّ أنسبُ",40,"ب",1,0],["لئن رضيتُ لفضلي بالخمول ولي","في سائر الأرض ما يدني من الأرب",41,"ب",1,0],["لئن رحت محسود فضلا وسؤددا","أخو الفضل لم يعدم على الفضل حسدا",42,"د",2,0],["لئن رقدت تَحتَ التُّراب فإِنَّما","لها ركَّعٌ عند السؤال جَواث",43,"ث",1,0],["لئن رق طبعاً فقد راق وضعا","وجاء وحيداً بسبع المثان",44,"ن",1,0],["لئن راح يُبدي لي مخاوف صدّه","ومالي من قلب على الصّدّ يقدرُ",45,"ر",1,0],["لئن ردني ربّي اليها بفضله","لأجري لَها نَهراً كَما النيل يدفق",46,"ق",1,0],["لئن رحلت، لقد أبقيت لي حزناً","لم يبق لي معه في لذة وطر",47,"ر",1,0],["لئن رُزق الغمرُ الجهول بحمقه","وفاتتني الآمال أولى وثانيهْ",48,"ه",1,1],["لئن راح بالعليا وذكرهما بقي","فكالمسك يمضي ثم يبقى التضوّع",49,"ع",1,0],["لئن رحت ابن ساقي الحوض عنا","فمن يغدو علينا بالسقاء",50,"ا",2,0],["لَئِن رَجعوا يوماً إلى دارِ عزّهم","لَثَمنا خِفافاً لِلمَطايا وقبّلنا",51,"ن",2,0],["لئِن رَحلوا عنّي صَباحاً وودّعوا","فنارُ الجَوى طيَّ الجوانِحِ أوْدَعوا",52,"ع",3,1],["لئن رويت شتلاتي","ستجبي الماء عن غرسي",53,"س",2,0],["لئن رمى الدهر رأسي بالمشيب فما","أشاب عزمي ولا أقلعت عن غزلي",54,"ل",2,0],["لئن رقدت عينا سواه عن الندى","فليس له عين عن الجود ترقد",55,"د",1,0],["لئن رمقت عين النوى حور عينه","فبنَّ لقد غادرن قلباً معذبا",56,"ب",2,0],["لئِن راحَ مَطوياً بأَذرُعِ خامةٍ","فنَشرُ عُلاهُ لم يَزَل يَتَضوَّعُ",57,"ع",1,0],["لَئِن رام تحريراً فأفضل نابق","وإن جاءَ نظماً صاغ عقد العجائبِ",58,"ب",1,0],["لَئِن رابكم دَهري بما بي من الصفا","فحصنُ صفا ودي على صلدة الصفا",59,"ف",2,1],["لئن رمت تعداداً بمدحي مناقباً","محامدها تسمو عن الحصر والعدِّ",60,"د",1,0],["لئن رمتُ طول المدح عجزي يكفُّني","وهل في الضحى للشمس تَرنو النواظرُ",61,"ر",1,0],["لئن رامَ تنبيقاً فأفضل نابقٍ","يُزين طروساً بالسطور كما العقدِ",62,"د",1,0],["لَئنِ رَجَعَت تِلكَ اللَّيالي الِّتي مَضَت","وعايَنتكُم إِنِّي إِذاً لَسَعيدُ",63,"د",1,0],["لئن رجعت إلى الطاعات من كثبٍ","لتظفرن بحول اللَه من كثب",64,"ب",1,0],["لئن رزأ النيل منها فاصلا","ح نيل يديه لها طاب نيلا",65,"ل",2,0],["لئن رأيت الثناء المبتغى سببا","ودافعا حفز الإنسان فافتتنا",66,"ن",2,0],["لئن رابكن الدهر فالريب شأنه","وما الدهر إلا غاشم أو مطوح",67,"ح",1,0],["لئن رمت بي والهول يطمي عبابه","سويداء قلب الرعب عدت بإمكان",68,"ن",1,0],["لين راسي من الاهوال شاب","وصار ليلي كما الصبح ابلجي",69,"ج",2,0],["لئن رحلت عني فآثارها هنا","بها لحزين القلب ذكرى وموقف",70,"ف",1,0],["لئن رثيتك فاعلم أنني رجلٌ","أرثي الذي هو حر بالثنا قمن",71,"ن",1,0],["لئن رقدت بأحضان البلى حقباً","ففي قوافيك حي أنت موجود",72,"د",1,0],["لَئِنْ رحلَتْ طلائعُهم نهاراً","إلى حيثُ التحفُّزُ والقُفولُ",73,"ل",1,0],["لئِنْ رمتَكَ الليالي مِنْ كنانتها","فقدْ وقعتُ أنا مِنْ قبلما تَقَعُ",74,"ع",1,0],["لين رب الخلق علام الغيوب","خالق الارواح رب الكائنات",75,"ت",1,0],["لئن رجعت تلك الليالي التي مضت","وعاتبتكم إني إذن لسعيد",76,"د",1,0],["لَئِنْ رَحَلْتَ فَعَنْ سَمْعِيْ وعَنْ بَصري","مَثْواكَ في القلبِ لا فِيْ اللَّحْدِ والكَفَنِ",77,"ن",1,1],["لَئِنْ راحَ الزَّمانُ وَ لَمْ تُحاذِرْ","وَقَعتَ عَلَى جَبِينِكَ ؛ فَانكَفَأتَا",78,"ت",2,0],["لئن رجعت أيامنا الغر مرة","وجمعنا في دربكم يومها ود",79,"د",1,0],["لئن رمتِ الهروب من الحكايا","لماذا كان خدك فوق خدي",80,"د",2,0],["لئن رحلتْ طلائعُهم عَياناً","إلى حيثُ التحفُّزُ والقُفولُ",81,"ل",1,0],["لئن رفعوا على الأكتاف نعشا","فقد حملت قلوبهم المصابا",82,"ب",2,0]]}