{"poems":[[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[93,"دبت وقد أرخى الظلام ستارا","https://www.aldiwan.net/poem8861.html","عموديه"],[77,"افتك بهذا السامري الساحر","https://www.aldiwan.net/poem69011.html","الكامل"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[50,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[203,"يا طلعة البدر إذا النجمان","https://www.aldiwan.net/poem45364.html","مجزوء الرجز"],[240,"قالوا أبو الريان صن","https://www.aldiwan.net/poem32087.html","مجزوء الكامل"],[325,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[353,"أنا من أين والعمارة من أي","https://www.aldiwan.net/poem20223.html","الخفيف"],[355,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[396,"ذاوقت يا صاح مما به فؤادي صاح","https://www.aldiwan.net/poem54527.html","عموديه"],[396,"ذاوقت ما فيه شى يعجب","https://www.aldiwan.net/poem54559.html","عموديه"],[556,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[572,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138377",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38284","الخفيف"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16779","الكامل"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206183",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93532","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93618","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102691","المواليا"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84519","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68666","الرمل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113679","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129363","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109981","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117913","الكامل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107045","الرمل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216345",""],[4920,"مكرَّر الحُكْم يا ذا","https://www.poetsgate.com/ViewPoem.aspx?id=1171",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[5612,"ويعود للأقصى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=196750",""],[5747,"تستعبد أحزاني","https://www.poetsgate.com/ViewPoem.aspx?id=61612",""],[6131,"روحي رهينةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189335",""]],"verses":[["ذا وُشومٍ كَأَنَّ جِلدَ شَواهُ","في دَيابيجَ أَو كُسينَ نُمورا",0,"ر",2,0],["ذا ولا تَنْسَني إذا نَشَرَ البُس","تانُ أصنافَ وَشْيهِ وتَراءى",1,"ا",2,0],["ذا وجوهٍ كالمرايا","وقدودٍ كالسواري",2,"ر",2,0],["ذا وَالقَنابِلُ لَم تَزَل مُنهَلَّةً","مِنها تُحاكي الصَيبَ المِدرارا",3,"ر",2,0],["ذا ويحَكُم ماءٌ وَجَمرٌ مُحرِقٌ","فقد احترَقتُ وما تَرَوَّى ناظِرِي",4,"ر",2,0],["ذا ولكن تُبَّعُ الأكَبرُ مِنْ","يَمَنٍ كان لخُلْدٍ لو خَلَد",5,"د",1,0],["ذا وَمُغبَرٍّ مَخارِمُهُ","تَحسِرُ الأَبصارُ عَن قُطُرِه",6,"ر",2,0],["ذا وجهها وذا وذا","فُرطانِ في آذانها",7,"ن",3,0],["ذا وَجهُهُ طَرَقٌ وَوَج","هُ أُسامَةٍ طَلقٌ نَدي",8,"د",2,0],["ذا وَجنَةٍ حَمرا وَقَد أَسمَرَ","يَسبي النُهى بِجَمالِهِ الفَتّانِ",9,"ن",1,0],["ذا وَبَطْرُ النَّشَّارِ أَصلَحكَ اللَّ","هُ فَلا تَنْسَ قِصَّةَ النَّشَّارِ",10,"ر",1,0],["ذا وَفضَةٍ يَسعى بِضاريةٍ","مثلِ القِداح كوالحٍ غُبسِ",11,"س",1,0],["ذاوقت يا صاح مما به فؤادي صاح","خذقول نصاح لا سكران بل هو صاح",12,"ح",1,1],["ذاوقت ما فيه شى يعجب","الأعدم خلطتك بالناس",13,"س",1,1],["ذاوي القضيب له بَنانةُ آسفٍ","يَجري لطولِ عضاضِها منها الدّمُ",14,"م",1,0],["ذَا وَعِنْدِي لِذِي المَوَدَّةِ حِفْظٌ","وَوَفَاءٌ بِالْعَهْدِ وَالْمِيْثَاقِ",15,"ق",1,0],["ذا وليم كالبلبل الصداح في","اعلى منابر غصنه يترنم",16,"م",1,0],["ذا وَمِنهُ العوافِ أَرَّختُ دَبَّت","ماءُ عينٍ بَل عَينُ ماءِ الحياةِ",17,"ه",1,0],["ذاوي العَسيبِ قَصيرُهُ ضافي السَبيبِ","طَويلُهُ صافي الأَديمِ مُحَبَّبِ",18,"ب",1,0],["ذا وصلى الله ما ودقٍ سكب","وزَيّن الآراض بازهار وعَشاب",19,"ب",1,0],["ذا والج في الدار يعلم ما بها","وَسِواه يَنظر مِن شُقوق الباب",20,"ب",1,0],["ذا واحد قَد ثَنا اللَه الوساد لَهُ","وَثلث اللَه فيهِ الشَمس وَالقَمَرا",21,"ر",2,0],["ذا ودمع العين جرّح ناظري","ان قولي آح مما بي مباح",22,"ح",1,0],["ذاوى قَضيب البغى في اعصاره","وَبأمنه جيش الضلال مفذّذ",23,"ذ",1,0],["ذا وصفُهُ أَمَّا القياسُ الأصلي","فسوفَ أَذكُرُ بتاسع فَصلِ",24,"ل",1,0],["ذا وجود نازل في رتب","بأمانات لها أو سرقه",25,"ق",2,0],["ذا ودادي وهل ترى لودادي","حافظاً في الأنام مثل فؤادي",26,"د",2,1],["ذا وابن ملجم حازا من عليهما","والغدر حشوهما كالروح في جسد",27,"د",1,0],["ذاوي الضَلالةِ أَمسى شرَّ مُقتَلَعٍ","وناضرُ الهَدى أَضحى خيرَ منغَرِسٍ",28,"س",1,0],["ذا ورع عدلاً رضاً صواما","يتلو كتاب ربه قواما",29,"م",2,0],["ذاوي الجفون بثغره وبخدّه","درّاً وياقوتاً أرى وزمرّذا",30,"ذ",2,0],["ذا وما أوجس مني","لختام الشيب ومضا",31,"ض",2,0],["ذا وصلى الله عِدَدْ شَرْتا الشِّمال","أو عِدَدْ هَلّ السِّحِبْ غِيثٍ هطول",32,"ل",1,0],["ذاوحِدّة الفهم قد","تخرِق المعمَّى هذا",33,"ذ",2,0],["ذَاوِي الرُّسومِ مِنَ الْبلى فكأنَّهُ","أَثُرُ النّمال مشتْ عليه الأعْصُرُ",34,"ر",1,0],["ذا وَعْدُ ربِّ النّاسِ في قرْءانهِ","أوَ ما علِمْتِ بوعْدِهِ الموْعودِ",35,"د",1,0],["ذا وأنت تدري عن فراقك م/اطيقه","وإني بديتك حلم من نظرة إعجاب",36,"ب",1,0],["ذَاوٍ على جرفِ الأسَى ،","حاشاكَ ماشَلُّوا يمينَكْ",37,"ك",1,0]]}