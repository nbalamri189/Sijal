لي تنفضُ استك مذرويها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10688&r=&rc=42",""],[113,"وعزة الله ما شوقي إلى العلم","https://www.aldiwan.net/poem41774.html","البسيط"],[113,"أنا من تسمع عنه وترى","https://www.aldiwan.net/poem42905.html","الرمل"],[130,"صاحب الرحل والقلوص الرسوما","https://www.aldiwan.net/poem54652.html","الخفيف"],[133,"يجرح القلب بألحاظه","https://www.aldiwan.net/poem49145.html","السريع"],[135,"أحول كالقرد أو كما يرقب","https://www.aldiwan.net/poem67944.html","المنسرح"],[184,"ولي مالك أنا عبد له","https://www.aldiwan.net/poem43183.html","المتقارب"],[184,"أف لهذا الزمان من نكده","https://www.aldiwan.net/poem43886.html","المنسرح"],[196,"لا مثل مجلسنا وقد نظمت به","https://www.aldiwan.net/poem51955.html","الطويل"],[202,"وشادن مر فاتن المنظر","https://www.aldiwan.net/poem53082.html","المنسرح"],[209,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[227,"أشكو إلى الله ما ألاقي","https://www.aldiwan.net/poem50905.html","مخلع البسيط"],[233,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[280,"لست أسلو الشادن الأحوى الأغنا","https://www.aldiwan.net/poem32385.html","الرمل"],[280,"أحورية الحي روحي فداك","https://www.aldiwan.net/poem32683.html","المتقارب"],[280,"عجبا لمملوكي الذي ملكته","https://www.aldiwan.net/poem32858.html","الكامل"],[347,"من لي بوصل ممنع قطعت يدي","https://www.aldiwan.net/poem15928.html","الكامل"],[351,"يا سرورا على القلوب تجلى","https://www.aldiwan.net/poem39588.html","الخفيف"],[355,"أبا بحر سلام الله يترى","https://www.aldiwan.net/poem4180.html","الوافر"],[369,"أحوج ما كنت إلى عقلي","https://www.aldiwan.net/poem57211.html","البسيط"],[429,"أي حبيب في خده شرطه","https://www.aldiwan.net/poem12465.html","المنسرح"],[438,"لا طارف عاد عندي لا ولا تلد","https://www.aldiwan.net/poem14301.html","البسيط"],[450,"يا لعهد مضى وعيش رغيد","https://www.aldiwan.net/poem13711.html","الخفيف"],[451,"أحورية الماء هيا تعالى","https://www.aldiwan.net/poem61660.html","المتقارب"],[456,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[456,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[462,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[475,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[475,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[475,"عفا منزل قد كان للغيد مألفا","https://www.aldiwan.net/poem15244.html","الطويل"],[493,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[512,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[512,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[513,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"]],"verses":[["أَحوَرَها لا يُفيقُ مِن خَجَلٍ","وَيَرتَدي بِالحَياءِ أَغيدُها",0,"د",3,0],["أحوِّلُ منْكِ الشّهْرَ حوْلاً على الوَرى","وأصْبَحَتِ الأيّامُ وهْيَ شُهورُ",1,"ر",1,0],["أَحْوَجَ اليَوْمَ مَا تَكُو","ن إِلَى فِتْيَةِ الفِطَنْ",2,"ن",1,0],["أَحوطُكَ بِالوُدِّ الَّذي أَنتَ حائِطي","وَأَيجَعَ إِشفاقاً لِأَن تَتَوَجَّعا",3,"ع",2,0],["أحوم عليه ما دجا الليل ساهراً","وأصبح دون الورد ظمآن صاديا",4,"ي",2,0],["أحوال معلومي تسو","ء وصاحب لا ينفع",5,"ع",1,0],["أحوجَ ما كان إلى كاسبٍ","يُجدي عليه جاء بالأدبِ",6,"ب",1,0],["احْوَقَ يَقذِي مِشْفَراهُ نَجَسَا","أوْسَعَ من طَوْقِ الرحا وأسلسا",7,"س",2,0],["أحوجَهُ الله إلى مِثله","يوماً لكي يُجزَى بأفعاله",8,"ل",2,0],["أحْوَسُ لا يسبق الرَّويَّةَ بال","عزْم ولا يَنْثَني إذا عَزَما",9,"م",2,0],["أحوم على حسنكم ما أحوم","وأذكركم بطلوع النجوم",10,"م",1,1],["أَحوَذِيٌّ إِذا تَمَهَّلَ في الرَأ","يِ أَراكَ الصَوابَ كَيفَ اِختِيارُه",11,"ر",2,0],["أحوالُ مجدِكَ في العُلُّوِّ سَواءُ","يومٌ أَغَرُّ وشيمَةٌ غَرَّاءُ",12,"ا",2,1],["أَحوى لَهُ خَدٌّ سَقاهُ الحَيا","فَأَورَثَ الأَحداقَ مِنهُ اِتِّقاح",13,"ح",1,0],["أَحوى القَوادِمِ بِالبَياضِ مُلَمَّعٌ","قَلِقُ المَواقِعِ بِالفِراقِ يَصيحُ",14,"ح",1,0],["أحورَ قَد حِرتُ فِي أوصَافِهِ","سَاحِر الطّرف بِعَينَيهِ حَوَر",15,"ر",1,0],["أحوى أغنّ مزنّرٍ ذي رونق","حَسِنِ التشكّلِ من بنّي عمّار",16,"ر",1,0],["أَحوَرَ عَبّى لَنا حَبائِلَهُ","بِالحُسنِ لا بِالرُقى وَلا العُقَدِ",17,"د",1,0],["أَحوى المَدامِعِ زانَ قامَتَهُ","حُلَلُ الدَمِقسِ تَظَلُّ في أَوَدِ",18,"د",1,0],["أَحوبِيَ صاحِبي فَأُعيرَ فَضلاً","عَلَيَّ أَم اِنتُقِصتُ لِأَجلِ حَوبي",19,"ي",1,0],["أَحْوَجَ مَا كُنَّا يَدَاً مُسْعِد","بَيتٌ يَقِي الأُمَّةَ أَنْ تَجْهَلا",20,"ل",2,0],["أحول منك الشهر حولا على الورى","وأصبحت والأيام وهي شهور",21,"ر",1,0],["أحوجَهُ إلى مِثله اللَّ","هُ يوماً لكي يُجزَى بأفعاله",22,"ل",2,0],["أحوى القوادمِ، بالبياضِ ملمعٌ،","قَلِقُ المَوَاقِعِ بِکلفِرَاقِ يَصِيحُ",23,"ح",1,0],["أحوْلي تنفضُ استك مذرويها","لتقتلني فها أنا ذا عُمارا",24,"ر",2,1],["أحواله في كبار الأوليا عرفت","وذاته بين أهل اللَه كالعلم",25,"م",1,0],["أَحوَرٌ أَصبَحتُ فيهِ حائِراً","أَسمَرٌ أَمسَيتُ فيهِ سَمَرا",26,"ر",2,0],["أحوج الناس نكَد الناس عيشا","قد حكى ما درا وأشعب شيما",27,"م",2,0],["أحوى رشيقُ القدِ حلوُ اللمى","قلبي بهِ في كلِ وادٍ يهيمْ",28,"م",1,0],["أَحوَلُ كَالقِردِ أَو كَما يَرقُبُ الس","سارِقُ في حالِكٍ مِنَ الظُلَمِ",29,"م",1,1],["أحول وأبغي معينا على","همومي وصرفي بجدوى يديه",30,"ي",2,0],["أحواله أصبحت مخالفة","لما مضى في القديم من رغده",31,"د",2,0],["أحوى أغَنُّ إذا ذكرتُ جلالهُ","قامتْ عليه من الجمال شواهد",32,"د",1,0],["أحور إن كلَّموه من تَيَهٍ","حار فيا حُسنَ أحورٍ أحوَر",33,"ر",1,0],["أحور العينين معسول الحديث","ولأهوائي وأحلامي بثوث",34,"ث",1,0],["أَحْورَ ذِي غُنّةٍ غَرِيرٍ","يَضنّ بالوصل والتّلاقي",35,"ق",2,0],["أَحومُ مِن حَولِهِ وَبي ظَمَأٌ","إِلى جَنا ريقِهِ وَلا أَرِدُ",36,"د",1,0],["أَحورُ الطَّرفِ بَديعٌ حُسنُهُ","فَهوَ حورِيُّ المَعاني فيهِ حِرنا",37,"ن",2,0],["أَحورِيَّةَ الحَيِّ روحي فداكِ","أَما لِأَسيرِ الهَوى مِن فَكاكِ",38,"ك",1,1],["أَحوى حَوى قَلبي فَصارَ حِواؤُهُ","يَرعى حِماهُ آمِناً ما رُعتُهُ",39,"ت",2,0],["أَحوى حَوى جُمَلَ الجَمال فَباطِنُ ال","حُسنِ الَّذي في الناسِ ظاهِرُ حُسنِهِ",40,"ن",2,0],["أَحور الطَرف قَد حَوى اللطف أَحوى","لَو تَولّى عَلى القُلوب تَولّى",41,"ل",2,0],["أحُومُ عَلَى كَنِّيكَ وَنَأى مَحَلٌّ","فَسِيَانِ انتِزَاحٌ وَاقتِرَابُ",42,"ب",1,0],["أحوجُ ما كنتُ إلى عَقلي","سلبتَهُ بِالكأسِ والرَّطلِ",43,"ل",1,1],["أحورُ أحوى أغرُّ مختصَرُ ال","خَصْرِ يُريك الجمال كالنقطَه",44,"ط",2,0],["أحود كالطير فوق الوكر يرفعه","غيم من البين مسبوقاً به النكد",45,"د",1,0],["أحور الناظرْينِ أحوى يُحيّا","ويفدي بأنفسٍ وجدود",46,"د",1,0],["أَحوريةَ الماءِ هيا تعالِى","تعالى إلى لهفتي وابتهالي",47,"ي",1,1],["أحوَى إذا قام إليه ماسحٌ","قام إلى وجه الوجيه لاطمُ",48,"م",1,0],["أحوِي أراقمَه بفضل تلطُّفي","فيعي وأخدَعُ منه ما لم يُخدَعِ",49,"ع",1,0],["أحواجيبُ ظباء أم قسيٌّ","وجفونٌ تلك أم رشق سهامِ",50,"م",1,0],["أحورُ قد هامَ هوًى","بما حَوَى مقلَّدُه",51,"د",2,0],["أحوكُ بروداً مابدا لي نظيمُها","لدى معشرٍ إلا وخرَّ نظيمُها",52,"م",3,0],["أحوكُ بديعَ الشَّعرِ فيها بمقولٍ","يخجَّلُ غربُ السيفِ عُريانَ مُرْهَقا",53,"ق",2,0],["أحُول حذار الظل رعباً وأحتمي","من الماء إلا أن يرنّق مَوردي",54,"ي",1,0],["أحوى كأنّ مياههُ ريقُ الدُمى","وهَواهُ أنفاسُ الحِسانِ العِينِ",55,"ن",1,0],["أحوى حوى إلْفَ الجآذِر في الفَلا","والشيءُ منجذبٌ إلى نُظرائِهِ",56,"ا",3,0],["أحوجني إلى المديح باخل","سلاسل البخل على سلساله",57,"ل",2,0]]}