https://www.poetsgate.com/ViewPoem.aspx?id=211673",""],[4778,"بنات الحور","https://www.poetsgate.com/ViewPoem.aspx?id=190426",""],[4578,"بغرةٍ تنقضى في حبها حججي","https://www.poetsgate.com/ViewPoem.aspx?id=49370",""],[4852,"خيط شمعة","https://www.poetsgate.com/ViewPoem.aspx?id=214437",""],[4884,"هي الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=202365",""],[4929,"أزمة الأفراح في بلاد الأتراح","https://www.poetsgate.com/ViewPoem.aspx?id=199280",""],[5038,"لبّان الظبا","https://www.poetsgate.com/ViewPoem.aspx?id=189962",""],[5136,"أهواه كالغصن في تثنيه","https://www.poetsgate.com/ViewPoem.aspx?id=121781",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5277,"في عينكِ تاهتْ أشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=200889",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[5652,"فقر وصندقه","https://www.poetsgate.com/ViewPoem.aspx?id=178103",""],[5652,"أحوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=198330",""],[5672,"أحور","https://www.poetsgate.com/ViewPoem.aspx?id=206559",""],[5739,"قصيده تنتظر شاعر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131709",""],[402,"عادت إلى منزلها في العلى","https://www.poetsgate.com/ViewPoem.aspx?id=36181",""],[5956,"الإعجابُ والحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=182655",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""],[520,"الحمد لله على حالة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577560",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""]],"verses":[["أَحوَرَها لا يُفيقُ مِن خَجَلٍ","وَيَرتَدي بِالحَياءِ أَغيدُها",0,"د",3,0],["أحوِّلُ منْكِ الشّهْرَ حوْلاً على الوَرى","وأصْبَحَتِ الأيّامُ وهْيَ شُهورُ",1,"ر",1,0],["أَحْوَجَ اليَوْمَ مَا تَكُو","ن إِلَى فِتْيَةِ الفِطَنْ",2,"ن",1,0],["أَحوطُكَ بِالوُدِّ الَّذي أَنتَ حائِطي","وَأَيجَعَ إِشفاقاً لِأَن تَتَوَجَّعا",3,"ع",2,0],["أحوم عليه ما دجا الليل ساهراً","وأصبح دون الورد ظمآن صاديا",4,"ي",2,0],["أحوال معلومي تسو","ء وصاحب لا ينفع",5,"ع",1,0],["أحوجَ ما كان إلى كاسبٍ","يُجدي عليه جاء بالأدبِ",6,"ب",1,0],["احْوَقَ يَقذِي مِشْفَراهُ نَجَسَا","أوْسَعَ من طَوْقِ الرحا وأسلسا",7,"س",2,0],["أحوجَهُ الله إلى مِثله","يوماً لكي يُجزَى بأفعاله",8,"ل",2,0],["أحْوَسُ لا يسبق الرَّويَّةَ بال","عزْم ولا يَنْثَني إذا عَزَما",9,"م",2,0],["أحوم على حسنكم ما أحوم","وأذكركم بطلوع النجوم",10,"م",1,1],["أَحوَذِيٌّ إِذا تَمَهَّلَ في الرَأ","يِ أَراكَ الصَوابَ كَيفَ اِختِيارُه",11,"ر",2,0],["أحوالُ مجدِكَ في العُلُّوِّ سَواءُ","يومٌ أَغَرُّ وشيمَةٌ غَرَّاءُ",12,"ا",2,1],["أَحوى لَهُ خَدٌّ سَقاهُ الحَيا","فَأَورَثَ الأَحداقَ مِنهُ اِتِّقاح",13,"ح",1,0],["أَحوى القَوادِمِ بِالبَياضِ مُلَمَّعٌ","قَلِقُ المَواقِعِ بِالفِراقِ يَصيحُ",14,"ح",1,0],["أحورَ قَد حِرتُ فِي أوصَافِهِ","سَاحِر الطّرف بِعَينَيهِ حَوَر",15,"ر",1,0],["أحوى أغنّ مزنّرٍ ذي رونق","حَسِنِ التشكّلِ من بنّي عمّار",16,"ر",1,0],["أَحوَرَ عَبّى لَنا حَبائِلَهُ","بِالحُسنِ لا بِالرُقى وَلا العُقَدِ",17,"د",1,0],["أَحوى المَدامِعِ زانَ قامَتَهُ","حُلَلُ الدَمِقسِ تَظَلُّ في أَوَدِ",18,"د",1,0],["أَحوبِيَ صاحِبي فَأُعيرَ فَضلاً","عَلَيَّ أَم اِنتُقِصتُ لِأَجلِ حَوبي",19,"ي",1,0],["أَحْوَجَ مَا كُنَّا يَدَاً مُسْعِد","بَيتٌ يَقِي الأُمَّةَ أَنْ تَجْهَلا",20,"ل",2,0],["أحول منك الشهر حولا على الورى","وأصبحت والأيام وهي شهور",21,"ر",1,0],["أحوجَهُ إلى مِثله اللَّ","هُ يوماً لكي يُجزَى بأفعاله",22,"ل",2,0],["أحوى القوادمِ، بالبياضِ ملمعٌ،","قَلِقُ المَوَاقِعِ بِکلفِرَاقِ يَصِيحُ",23,"ح",1,0],["أحوْلي تنفضُ استك مذرويها","لتقتلني فها أنا ذا عُمارا",24,"ر",2,1],["أحواله في كبار الأوليا عرفت","وذاته بين أهل اللَه كالعلم",25,"م",1,0],["أَحوَرٌ أَصبَحتُ فيهِ حائِراً","أَسمَرٌ أَمسَيتُ فيهِ سَمَرا",26,"ر",2,0],["أحوج الناس نكَد الناس عيشا","قد حكى ما درا وأشعب شيما",27,"م",2,0],["أحوى رشيقُ القدِ حلوُ اللمى","قلبي بهِ في كلِ وادٍ يهيمْ",28,"م",1,0],["أَحوَلُ كَالقِردِ أَو كَما يَرقُبُ الس","سارِقُ في حالِكٍ مِنَ الظُلَمِ",29,"م",1,1],["أحول وأبغي معينا على","همومي وصرفي بجدوى يديه",30,"ي",2,0],["أحواله أصبحت مخالفة","لما مضى في القديم من رغده",31,"د",2,0],["أحوى أغَنُّ إذا ذكرتُ جلالهُ","قامتْ عليه من الجمال شواهد",32,"د",1,0],["أحور إن كلَّموه من تَيَهٍ","حار فيا حُسنَ أحورٍ أحوَر",33,"ر",1,0],["أحور العينين معسول الحديث","ولأهوائي وأحلامي بثوث",34,"ث",1,0],["أَحْورَ ذِي غُنّةٍ غَرِيرٍ","يَضنّ بالوصل والتّلاقي",35,"ق",2,0],["أَحومُ مِن حَولِهِ وَبي ظَمَأٌ","إِلى جَنا ريقِهِ وَلا أَرِدُ",36,"د",1,0],["أَحورُ الطَّرفِ بَديعٌ حُسنُهُ","فَهوَ حورِيُّ المَعاني فيهِ حِرنا",37,"ن",2,0],["أَحورِيَّةَ الحَيِّ روحي فداكِ","أَما لِأَسيرِ الهَوى مِن فَكاكِ",38,"ك",1,1],["أَحوى حَوى قَلبي فَصارَ حِواؤُهُ","يَرعى حِماهُ آمِناً ما رُعتُهُ",39,"ت",2,0],["أَحوى حَوى جُمَلَ الجَمال فَباطِنُ ال","حُسنِ الَّذي في الناسِ ظاهِرُ حُسنِهِ",40,"ن",2,0],["أَحور الطَرف قَد حَوى اللطف أَحوى","لَو تَولّى عَلى القُلوب تَولّى",41,"ل",2,0],["أحُومُ عَلَى كَنِّيكَ وَنَأى مَحَلٌّ","فَسِيَانِ انتِزَاحٌ وَاقتِرَابُ",42,"ب",1,0],["أحوجُ ما كنتُ إلى عَقلي","سلبتَهُ بِالكأسِ والرَّطلِ",43,"ل",1,1],["أحورُ أحوى أغرُّ مختصَرُ ال","خَصْرِ يُريك الجمال كالنقطَه",44,"ط",2,0],["أحود كالطير فوق الوكر يرفعه","غيم من البين مسبوقاً به النكد",45,"د",1,0],["أحور الناظرْينِ أحوى يُحيّا","ويفدي بأنفسٍ وجدود",46,"د",1,0],["أَحوريةَ الماءِ هيا تعالِى","تعالى إلى لهفتي وابتهالي",47,"ل",2,1],["أحوَى إذا قام إليه ماسحٌ","قام إلى وجه الوجيه لاطمُ",48,"م",1,0],["أحوِي أراقمَه بفضل تلطُّفي","فيعي وأخدَعُ منه ما لم يُخدَعِ",49,"ع",1,0],["أحواجيبُ ظباء أم قسيٌّ","وجفونٌ تلك أم رشق سهامِ",50,"م",1,0],["أحورُ قد هامَ هوًى","بما حَوَى مقلَّدُه",51,"د",2,0],["أحوكُ بروداً مابدا لي نظيمُها","لدى معشرٍ إلا وخرَّ نظيمُها",52,"م",3,0],["أحوكُ بديعَ الشَّعرِ فيها بمقولٍ","يخجَّلُ غربُ السيفِ عُريانَ مُرْهَقا",53,"ق",2,0],["أحُول حذار الظل رعباً وأحتمي","من الماء إلا أن يرنّق مَوردي",54,"د",2,0],["أحوى كأنّ مياههُ ريقُ الدُمى","وهَواهُ أنفاسُ الحِسانِ ال