{"poems":[[65,"أما وحبيك هذا منتهى حلفي","https://www.aldiwan.net/poem46124.html","البسيط"],[32,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[74,"إنسان عيني بتعجيل السهاد بلي","https://www.aldiwan.net/poem19471.html","البسيط"],[66,"أجريت فيك دموعي","https://www.aldiwan.net/poem67536.html","المجتث"],[62,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[53,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[64,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[30,"بنات المهاري الصهب كل نجيبة","https://www.aldiwan.net/poem5323.html","الطويل"],[30,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[68,"أهلا وسهلا يا رسول الرضى","https://www.aldiwan.net/poem39682.html","السريع"],[82,"أذابل النرجس في مقلتيك","https://www.aldiwan.net/poem31351.html","السريع"],[42,"لقد أرسلت في السر ليلى تلومني","https://www.aldiwan.net/poem42302.html","الطويل"],[48,"يقال أن سوف يأتي بعدنا عصر","https://www.aldiwan.net/poem23309.html","البسيط"],[108,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[62,"لا تعذليه فإن العذل يولعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67171&r=&rc=0",""],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[164,"والله ما صدق الواشي الذي نقلا","https://www.aldiwan.net/poem58999.html","البسيط"],[190,"أفق أيها القلب الولوع المكلف","https://www.aldiwan.net/poem43621.html","الطويل"],[208,"ذهبت أطلب ألفاظا أخاطبه","https://www.aldiwan.net/poem53288.html","البسيط"],[261,"أخشى على حسبتي العدو وفي","https://www.aldiwan.net/poem48523.html","المنسرح"],[276,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[303,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[308,"متى تصنع المعروف ترق إلى العلا","https://www.aldiwan.net/poem58276.html","الطويل"],[369,"نصرت على الأعداء فليهنك النصر","https://www.aldiwan.net/poem60900.html","الطويل"],[409,"فقلت حسبكما لله دركما","https://www.aldiwan.net/poem33440.html","البسيط"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[463,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[556,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[563,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[580,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83286","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86780","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48568","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71031","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70773","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70734","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120062","السريع"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35388","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109057","الوافر"],[1380,"","https://poetry.dctabudhabi.ae/diwan/poem/21332","الوافر"],[1425,"","https://poetry.dctabudhabi.ae/diwan/poem/124278","البسيط"],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216297",""],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67363","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108790","المجتث"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127950","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127979","البسيط"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199821","المسحوب"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109468","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77219","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10421","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94315","الرجز"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11298","البسيط"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145035","المجتث"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71307","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48436","الطويل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20606","المنسرح"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131975","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91520","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91272","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136835",""],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147295","الوافر"],[4691,"حنينٌ إلى معزوفة الماءِ والنور","https://www.poetsgate.com/ViewPoem.aspx?id=196824",""],[4691,"فديتكِ غادة ً","https://www.poetsgate.com/ViewPoem.aspx?id=209106",""],[4900,"جبينك الشمس في الأضواء والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=181365",""],[4927,"لَغْطُ النَّاْصِحِيْن","https://www.poetsgate.com/ViewPoem.aspx?id=29836",""],[5011,"سر حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197862",""],[585,"خلا المجال وأودى الشاعر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=161942",""],[5081,"أَعْلَنْتُ حُبِّى","https://www.poetsgate.com/ViewPoem.aspx?id=185577",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5431,"الحسين -سبط رسول الله-","https://www.poetsgate.com/ViewPoem.aspx?id=199897",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5845,"عسى منْ خفي اللطفِ سبحانهُ لطفُ","https://www.poetsgate.com/ViewPoem.aspx?id=15452",""],[5973,"مساء عينيك فضة ٌ وعطور","https://www.poetsgate.com/ViewPoem.aspx?id=13276",""]],"verses":[["وإنْ تغرَّبْتُ لمْ أفْزَعْ إِلى وَكَلٍ","ولمْ يكُنْ منْ صَرَى الأمْواءِ مُرْتَشَفي",0,"ف",2,0],["وَأَنتِ غَريمٌ لا أَظُنُّ قَضاءَهُ","وَلا العَنَزيَّ القارِظَ الدَهرَ حابيا",1,"ي",2,0],["وأنتَ غيث على ناءٍ ومقتربٍ","فصانك الله في حلٍّ ومرتحل",2,"ل",1,0],["وَأَنتَ غايَةُ سُؤلي","وَالعَينُ وَسنى عَلَيكَ",3,"ك",1,0],["وَإِن تُغِلُّ أَحَدَاً مِنّا مَنيَّتَهُ","فَما الَّذي بِقَضاءِ اللَهِ يَصنَعُهُ",4,"ع",2,0],["وإن تغنَّي فسلحٌ جاء منبثقاً","في لونِ خلقتِه من سَلحِ سكران",5,"ن",1,0],["وإنْ تغَشَّى سِفلها بالنَّدى","أخصبَ أعلاها ولم يُجدِبِ",6,"ب",1,0],["وَأَنتَ غِياثُ المُمحِلينَ إِذا شَتَوا","وَنورُ هُدىً يا اِبنَ المُلوكِ الغَطارِفِ",7,"ف",1,0],["وَأَنتَ غِياثُ الأَرضِ وَالناسِ كُلِّهِم","بِكَ اللَهُ قَد أَحيا الَّذي كانَ بالِيا",8,"ي",2,0],["وَإِن تَغافَلتَ وَأَغفَلتَها","عَليكَ فيها لا عَلَيَّ المَلام",9,"م",1,0],["وإن تَغَنّيتِ لنا لم نزَلْ","نخلعُ أفواهاً على أخمَصَيك",10,"ك",1,0],["وَإِن تَغفِري مازَلَّ مِنّي وَتَصفَحي","فَقَد هَدَّ عَظمي قَبلَها حُبُّكُم هَدّا",11,"د",2,0],["وَإِن تَغَيَّرَتِ الأَفلاكُ وَاِنعَكَسَت","بِالسَعدِ فَالوَهدُ يُبنى فَوقَهُ الأُطُمُ",12,"م",1,0],["وإن تغنَّتْ به تميمٌ","وسبحتْ باسمه نزار",13,"ر",1,0],["وَإِن تُغِلُّ أَحَدَاً مِنّا مَنيَّتَهُ","لا بُدّ في غَدِه الثّاني سَيَتْبَعَهُ",14,"ع",2,0],["وَأَنتَ غِياثُ المُسلِمينَ فَكُن لَهُم","وإِن نَزَحَت أَوطانُهُم عَنكَ مَوئِلا",15,"ل",2,0],["وإن تغفلته يوما وجاد بها","أفاق مستقضيا في قطع ما وصلا",16,"ل",2,0],["وأنت غريق والمحادث عرّبٌ","عليك وغصن العيش ريان أهيف",17,"ف",1,0],["وأنت غير غَنيٍّ عن أخي ثقةٍ","ولا غَنَاءَ لقَوسٍ تعدم الوَتَرا",18,"ر",2,0],["وإن تغافلت عنه غافصني","واستلب الكرش من يدي وغدا",19,"د",2,0],["وَأَنتَ غياثي عند كل ملمة","وَلَهفي اذا لَم يَبقَ بين الوَرى كهف",20,"ف",1,0],["وَإِنْ تغلغلَ في روضٍ كساه حلى","فمنْ وشاحٍ إلى عِقْدٍ إلى داح",21,"ح",1,0],["وإن تغرس الإحسان تجن الثمار من","مغار سعودٍ لا مغارس عود",22,"د",1,0],["وأنت غَنِيٌّ عنهمُ لو تَأمَّلوا","وما أحَدٌ إلاّ إليكَ به فَقْر",23,"ر",1,0],["وإن تغنت بها الأطيار قلت غدا","إسحق في الدوح والألحان والنغم",24,"م",1,0],["وأنتَ غفرتَ ذنوبَ الزمانِ","إليّ وكفَّرتَ عندي أثامَهْ",25,"م",2,0],["وإن تَغصِبوها تُمسِ في غير حيِّكم","تَشكَّى اضطراراً أو تَكلَّمُ عن عُذرِ",26,"ر",1,0],["وَإِنْ تَغبْ فالّذي به غُصَصٌ","منك بواقٍ يقول لا قَدِما",27,"م",2,0],["وأنت غصن","وهم حمائم",28,"م",1,0],["وإِن تَغنَّى حَلْيُهُ","فهل سَمِعْتَ إِسْحَاقْ",29,"ق",1,0],["وَأَن تُغِبَّ المَنايا في مَوارِدِها","فَرُبَّ تَركٍ يَليهِ أَخذٌ مُقتَدِر",30,"ر",1,0],["وَأَنتَ غَيث بِلا وَعد وَلا ضَرر","يروي نَزيلاً إِلى جَدواه مَدّ يدا",31,"د",2,0],["وإن تغير ماضيكم بحاضركم","فلن تحل بقلبي المخلص الغِيَر",32,"ر",1,0],["وإن تغابت ذرْنى أكايُلها","مُدّاً بمدٍّ والصاعَ بالصاعِ",33,"ع",1,0],["وإنْ تغافلتَ عن مواجهتي","فمنزلي مِنْ خصاصتي نابي",34,"ب",2,0],["وأنت غيثُ العباد إنْ نضبتْ","أنهارُهم أو تعذَّر المطر",35,"ر",1,0],["وإن تغيّرت فلا حيلة","أَحسبك الكاتب والناظرا",36,"ر",2,0],["وَإِن تَغالَيتُ في حُبّي لَكُم فَلَقَد","تَقاصَرَ الحُبُّ عَن غالي هِباتِكَ لي",37,"ل",2,0],["وأنت غضضتَ عني الطرف حتى","يئست وكان من يأسي فجوري",38,"ر",2,0],["وَأَنتَ غَداً تَزيدُ الضّعفَ خَيراً","كَذاكَ تَكونُ سادَةُ عَبدِ شَمسِ",39,"س",1,0],["وإن تغرب ترى منها منازل كم","بذي المنازل من ايام لذات",40,"ت",1,0],["وان تغَّلّب دعي الاعيانِ","عَنّ قاصي لا يحدّونه",41,"ن",2,0],["وإنْ تَغِبْ في جُمادى عن وقائِعَهَا","فَسَوْفَ نَلْقَاكَ في شَعْبَانَ أوْ رَجَبِ",42,"ب",1,0],["وأنت غاية قصدي","وإن تعمدت هتكي",43,"ك",2,0],["وأنت غوث ندافينا وغيث ندى","وصرف عزمك في عدل وتشييد",44,"د",1,0],["وان تغنى به حادى السرى طربا","لأ وصل الركب بالا دلاج ادلاكه",45,"ك",2,0],["وان تغّنى الرّاعبي فوق الشّجر","قلت ما ينلام.. خلّوه معذور",46,"ر",1,0],["وان تغنى معرباً أو سجعا","لحناً يكاد يسمع الصم الدعا",47,"ع",2,0],["وَإِن تَغَنَّت عَلى غُصنٍ مُطَوَّقَةٌ","أَجابَها شَدوُ وَرقاءٍ مِنَ البَشَرِ",48,"ر",1,0],["وإن تَغَلَّق مايةُ النوروزِ","وصارَ درُّ العشرِ يا عزيزي",49,"ي",1,0],["وَإِن تَغدو بِنا غَطَفانُ نُردِف","نِساءَهُمُ وَنَقتُل كُلَّ صَقرِ",50,"ر",1,0],["وإن تغنى لحنه أحيانى","وأعربت عن صفوها أحياني",51,"ي",1,0],["وَإِن تَغَيَّرَ لي عَن وُدِّهِ رَجُلٌ","أُصفى المَوَدَّةَ لي مِن بَعدِهِ رَجُلُ",52,"ل",1,0],["وإن تغص فأفاع","يهابها الحوت ذعرا",53,"ر",2,0],["وَإِنْ تَغَنَّى بِاسْمِكُمْ مُنْشِدٌ","فَإِنَّني أَوَّلُ مَنْ يَطْرَبُ",54,"ب",1,0],["وأن تغْتَدي الشّمْسُ التي عمّ نُورُها","تُقِرُّ بأوْصافٍ لها غيرِ واحِدَهْ",55,"د",2,0],["وَأَنتَ غَمرُ النَدى إِذا هَبَطَ الزُوْ","وارُ أَرضاً تَحُلُّها حَمِدوا",56,"د",3,0],["وأنت غمرتها بالحب طهرا","وهل عيش بلا حب يطيب",57,"ب",1,0],["وَإِن تغير وَجهُ الشَمس من وَجَلٍ","وَالأُفقُ أَمسى بكُحلِ اللَيل يكتحل",58,"ل",1,0],["وَإِن تَغب يا شمس أَو تحتجب","إِن الليالي وَالمُنى يوشع",59,"ع",1,0],["وإن تغب آيهُ العظمى فأعظمها","هو الكتابُ ولم يغب ولم يغمِ",60,"م",1,0],["وأنت غاية مرادي فأقبل أو شيت فأعرض","وأنت وجهي وتوجيهي إذا قمت بافرض",61,"ض",1,0],["وأن تغير الأشياء يقضي","بأن يفنى المقول ومن يقول",62,"ل",1,0],["وأنتِ غدير القلب ِ عيناكِ ملجأ","لصبٍّ لجوجٍ في ودادكِ معذورِ",63,"ر",1,0],["وأنتِ غنيةُ الفتنات روضٌ","بوجهكِ كم رجا قلبي ارتياده",64,"د",2,0],["وأنت غيث الأنام المستغاث به","إذا أغارت على أبنائها الغير",65,"ر",1,0],["وَأَنْتَ غَبِيٌّ تَمْقُتُ الْحُبَّ جَاْهِلٌ","بَلِيْدٌ عَلَىْ دَرْبِ الْغَبَاْءِ تُسَاْفِرُ",66,"ر",1,0],["وان تغيبت علي دورت في شمس الصيوف","لا تعذبني ولاسرت وتركت المكلا لك اذا مافيك معروف",67,"ف",1,0],["وإن تغزل مرَّت للهوى صورٌ","في الشعر محكمة الأطراف ترتسم",68,"م",1,0],["وَإِنْ تَغْضَبْ فَمِنِّى بِتُّ أَغْضَبْ","وَإِنْ تَصْفُو فَلَسْتَ لَدَيَّ أَقْرَبْ !",69,"ب",1,1],["وإن تغزلت يوما لم أجد حرجا","وإن هجوت فما في ثورتي نظر",70,"ر",1,0],["وأنت غلبت السابقين بجهدهم","إلى منتهى العلياء من آل غالب",71,"ب",1,0],["وأنت غمام الله مازلت ماطرا","تفيضُ على روض النفوس لتزهرا",72,"ر",2,0],["وأنتِ غلامي (البِكري)","كذاك وطفلتي الأنجبْ",73,"ب",1,0],["وأنتَ غياثي عندَ كلِّ ملمة ِ","وكهفي إذا لمْ يبقَبينَ الورى كهفُ",74,"ف",1,0],["وإن ْتغزَّلت ُ لم أَحِدْ.. فبِمَن","يكونُ.. إن لم يكن بك ِ الغزلُ؟",75,"ل",1,0]]}