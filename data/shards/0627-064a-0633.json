لي جفناكا","https://www.aldiwan.net/poem46729.html","الخفيف"],[403,"هات عن أهل الحمى ما فعلوا","https://www.aldiwan.net/poem46738.html","الرمل"],[403,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[406,"يا صاعدا في جو طير شامخ","https://www.aldiwan.net/poem49805.html","الكامل"],[410,"قولا لريم في حلة العرب","https://www.aldiwan.net/poem32238.html","المنسرح"],[417,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[433,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[453,"غيري يلذ له الهوى بهوان","https://www.aldiwan.net/poem13931.html","الكامل"],[465,"بجدك أعطاف القنا تتعطف","https://www.aldiwan.net/poem3114.html","عموديه"],[465,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[465,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[465,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[516,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[539,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[587,"حللت بأحشاء لها منك قاتل","https://www.aldiwan.net/poem17640.html","الطويل"]],"verses":[["أيسبقني من الأطيار عشٌ","ونسج للعناكب في المعالي",0,"ل",2,0],["أَيَسنَحُ لي رَوضاً وَأُصبِحُ عازِباً","وَيَعرِضُ لي ماءً وَأُصبِحُ صادِيا",1,"ي",2,0],["أَيَسمَحُ لي هَذا الزَمانُ بِصاحِبٍ","طَويلِ نِجادِ السَيفِ مِن آلِ هاشِمِ",2,"م",1,0],["أَيَسمَحُ جَفني بِالدُموعِ وَأَغتَدي","ضَنيناً بِها إِنّي إِذاً لَلَئيمُ",3,"م",1,0],["أَيُسعِدُ مَن يُدميجَوانِحَهُ النَّوى","حَمامٌ لَدَيهِ الإِلفُ وَالفَرخُ وَالوَكرُ",4,"ر",1,0],["أَيَسُرُّكُم أَنّي هَجَرتُكُمُ","وَمَنَحتُ قَوماً غَيرَكُم وُدّي",5,"ي",1,1],["أَيُسخِطُكُم أَنّي هَوَيتُ وِصالَكُم","فَلا تَغضَبي يا مُنيَتي فَلَكِ العُتبى",6,"ب",2,0],["أيَسوغُ عنْ مَثْواهُ سَيْريَ خائِباً","ومَنابِرُ الدّنْيا بذِكْراكَ تَصْدَحُ",7,"ح",1,0],["أَيَّ سَبيلٍ لِلهُدى لَم يَرِد","وَأَيُّ بابٍ مِنهُ لَم يَقرَعِ",8,"ع",1,0],["أَيْ سُلَيْمَانُ أَيْنَ مِنَّا سُلَيْمَ","انُ وَأَيْنَ المَنْطُوقُ وَالمَفْهُومُ",9,"م",1,0],["أَيْ سُلَيْمَانُ إِنَّنِي لأَسِيفٌ","أَنْ يُقَالَ الفَقِيدُ وَالمَرْحُومُ",9,"م",1,0],["أَيُّ سَعْدٍ لِلرِّيفِ وَهْوَ بِمَرْ","آكَ يَرَى وَجْهَ دَهْرِهِ البَسَّامَا",10,"م",2,0],["أَيَسومُني المَأمونُ خِطَّةَ عاجِزٍ","أَو ما رَأى بِالأَمسِ رَأسَ مُحَمَّدِ",11,"د",1,1],["أيَسعَد محياكم بغير نسائكم","وهل سعِدت أرض بغير سماء",12,"ا",2,0],["أيسرع لي بالمالِ جوداً ولا أرى","بماءِ جفوني جائداً أتسرَّع",13,"ع",1,0],["أيسوؤُني مَنْ لم أكنْ لأسوءَهُ","ويُريبني من لم أكن لأُريبَهُ",14,"ب",2,0],["أيسرقُ البحتريُّ الناسَ شعرَهُمُ","جهراً وأنت نَكالُ اللصِّ ذي الرِّيَبِ",15,"ب",1,0],["أيسيرُ مدحي في الأمير وكلُّهُ","يا للرجال مُؤرَّجٌ بعتابِ",16,"ب",1,1],["أيسكن مسلوبٌ سكينةَ ليله","ويأنس مفجوع بأنس نَهاره",17,"ر",2,0],["أيسفكُ للوشاة دم ثمينٌ","وقيمةُ كل ما يَحكون فَلسُ",18,"س",1,0],["أيسرُ ما يشكرُ القريضُ له","تسهيلهُ قرضَهُ لقرَّاضه",19,"ض",2,0],["أَيِستُ من دهري ومن أهله","فليس فيهم أحدٌ يُرضى",20,"ض",2,1],["أيُّ سماحٍ ضُمَّ في قبرهِ","وماءِ وجهٍ في ثراهُ سُفِك",21,"ك",1,0],["أيُّ سلطانٍ وقد أصبحْتُما","كمسيٍء ومسيءٍ في قَرن",22,"ن",1,0],["أَيَسلُبُ قَومَكُم رُشدَهُم","وَيَدعوهُ قَومِكُم مُحسِنا",23,"ن",2,0],["أَيُسفِرُ وَجهي إِنَّهُ أَوَّلُ القِرى","وَأَبذُلُ مَعروفي لَهُ دونَ مُنكَري",24,"ي",1,0],["أَيَسومُني العُذّالُ عَنهُ تَصَبُّراً","وَحَياتِهِ قَلبي أَرَقُّ وَأَشفَقُ",25,"ق",1,0],["أَيُّ سِحْرٍ دهاكَ هل أَنْتَ مسحورٌ","شقيٌّ أَو ماردٌ يَتَهكَّمْ",26,"م",1,0],["أيسطو على الكُلِّ ليلُ الفناء","ليلهو بها الموتُ خَلْفَ الوجود",27,"د",1,0],["ايّ سحر حوت عصاً","حركت هذه الأكر",28,"ر",1,0],["أَيُسَوّي بِكَ قَومٌ","وَمَواليهم عَبيدُك",29,"ك",1,0],["أَيسَ العاذِلونَ مِن بُرءِ سُكري","إِنَّ سُكرَ الغَرامِ أَقتَلُ سُكرِ",30,"ر",1,0],["أَيَسخَطُها الأَذواءُ مِن سَروِ حِميَرٍ","وَيَرضى بِها أَولادُ سَعدٍ وَنابِلِ",31,"ل",1,0],["أَيَسعى اِبنُ مَسعودٍ وَتِلكَ سَفاهَةٌ","لِيُدرِكَ ما قَد كانَ بِالأَمسِ ضَيَّعا",32,"ع",2,0],["أَيسارُ صِدقٍ ما عَلِمتُهُمُ","عِندَ الشِتاءِ وَقِلَّةِ الأَنواءِ",33,"ا",2,0],["أَيَسومُ إِشراكي بَدينِ هَواكُمُ","مَن لَيسَ في شَرعِ الغَرامِ بِمُؤمِنِ",34,"ن",1,0],["أيُّ سعدٍ لخليلِك","شيَّعَ الروحَ وراءَك",35,"ك",1,0],["أي سرٍّ فيك إني لست أدري","كل ما فيك من الأسرار يغري",36,"ي",1,0],["أَيَسلُبُني ثَراءَ المالِ رَبّي","وَأَطلُبُ ذاكَ مِن كَفٍّ جَمادِ",37,"د",1,1],["أَيسارُ حَربٍ كُلَّما اِشتَجَرَ القَنا","لَم يُعمِلوا إِلّا الرِماحَ قِداحا",38,"ح",2,0],["أَيسمعُ صَيْحَتِي في مِصرَ قومٌ","هُمُ اللَّهبُ المؤجَّجُ والوقودُ",39,"د",1,0],["أيسمعُ النُّصحَ قومٌ أم بهم صَمَمٌ","أم ليس يفهمُ بعضُ القومِ معناهُ",40,"ا",2,0],["أَيَسوسُ رَيبُ الدَهرِ مِنّا أُمَّةً","تَبغي حَياةَ المَجدِ أَم أَنعاما",41,"م",2,0],["أَيُسلِمُ المَجدُ آمالي إِلى قَلَمٍ","تَنهَلُّ لي رَحمَةً في الطِرسِ أَدمُعُهُ",42,"ع",2,0],["أَيسَرُ ما نالَ مُحِبٌّ لَدى","بَينِ حَبيبٍ قَولُهُ عَرِّجِ",43,"ج",1,0],["أيَسُرُّ قوْماً أنّ مكّةَ غُودِرَتْ","بَمجَرِّ جيش الرّومِ قاعاً صَفْصَفا",44,"ف",2,0],["أَيَسُبُّني رَجُلٌ عَلَي","هِ مِنَ الخِزانَةِ أَلفُ شاهِد",45,"د",1,0],["أَيَسجُنُني رَبُّ العُلا مُنصِفٌ","وَإِن تُقنَ راحٌ فَهيَ لا رَيبَ تُبزَلُ",46,"ل",1,1],["أَيَسمَعُ خالِقي مِنّي دُعاءً","فَأُصبِحَ في كَياني مُستَقيلا",47,"ل",2,1],["أيستحيلُ الكونُ هذا الهشيم","والظلمة الجاثمُ فيها الخراب",48,"ب",1,0],["أيستحقُّ الناسُ هذا العقاب","أم حانت الساعةُ من نقمتكْ",48,"ك",1,0],["أيُّ سرٍّ للجاذبيةِ فيه","يأخذُ الأرضَ نَحوَه بانحرافِ",49,"ف",1,0],["أَيَّ سَهْمٍ رَمَيْتُ فِي صَدْرِ وَلهَى","بِكَ كَانَتْ تُرَدُّ عَنْهَا السِّهَامُ",50,"م",1,0],["أَيْ سَاقِيَ الرَّاحِ أَجْرِهَا وَأَدِرْ","عَلَى الرِّفَاقِ الأَقْدَاحَ تَتَّقِدُ",51,"د",1,0],["أَيَسْتَقْبِلُ الغُصْنُ الرَّبِيعَ وَثَوْبُهُ","قَشِيبُ الحِلَى إِلاَّ إِذَا مَا تَجَرَّدَا",52,"د",2,0],["أَيُّ سَعْدٍ لِشَعْبِهِ أنْ يَرَاهُ","طَالِعاً بَيْنَهُ وَمَا مِنْ حِجَابِ",53,"ب",1,0],["أَي سِرٍّ فِي ذَلِكَ الْقَلَمِ الْقَا","طِرِ مَا تَقْطُرُ ابْنَةُ الْعُنْقُودِ",54,"د",1,0],["أَيُّ سَهْمٍ صَائِبٍ فَوَّقَهُ","مَنْ رَمَاهُ فَرَمَاهَا عَنْ كَثَبْ",55,"ب",1,0],["أَيَّ سَطْرٍ فِي المَعَالِي كَتَبَا","بِالزَّكِيِّ الحُرِّ مِنْ تِلكَ الدِّمَاءْ",56,"ا",2,0],["أَيْ سَادَتِي طُرقُ الفلاَحِ كَثِيرَةٌ","فِي وَجْهِ مَنْ يَسْعَى وَهَذا مَهْيَعُ",57,"ع",1,0],["أَيَسلُبُ نَفس الحرّ وهي كَريمَة","وَيَقطَعُ كَفَّ المَجدِ وَهيَ يَمينُ",58,"ن",1,0],["أيسيل صدرك من جراحتهم","وتعطيهم سلاحك",59,"ك",1,0],["أيسكن الدرُّ والمَرجان شاطئَه","أم في قراراته در ومرجان؟",60,"ن",1,0],["أيسيطرون على شعوبٍ حرَّةٍ","وعليهمو شعبُ اليهود تسيْطَرا؟",61,"ر",2,0],["أيسكت، والقلوب لها وَجِيبٌ","وييبَس، والرياض لها اخضلال؟",62,"ل",1,0],["أيسكن والكواكب دائراتٌ","كأنَّ الكون ليس به اختلال؟",62,"ل",1,0],["أيسوغ عن مثواه سيري خائبا","ومنابر الدنيا بذكرك تصدح",63,"ح",1,0],["أي سرٍ عن المغارات يروي؟","قيل: يهذي، وقيل عنه، تهاذى",64,"ذ",2,0],["أيسارا يا ((صنعا)) أمضي","أم أنتهج الدرب الأيمن ؟",65,"ن",1,0],["أيُسْلبُ عنها نعيمُ الهجيرِ","ونفحُ الرمالِ ، وبذْخُ العرا!!",66,"ا",1,0],["أيسْتُ من كلِّ مطلوبٍ أُؤمِّلُهُ","وأصبحَ الموتُ من أغلى مطاليبي",67,"ب",2,0],["أيسامح الله .. شعر أبو الطيّب .. وطيب . أبني أبان","خلّوك لو تدحر عضيمات الغوا .. ماتندحر",68,"ر",1,0],["أيّ سرّ نريد في الكون","والكون معنّى بسرّنا مشغول",69,"ل",1,0],["أيسر الجهد أن تضجّي وتشكي","قد يرجّ الطغيان قال وقيل",69,"ل",1,0],["أيّ سرّ للجاذبيّة فيه","بأخذ الأرض نحوه بانحراف؟",70,"ف",1,0],["أيس العَواذل مِن أفاقة مُغرَم","شرب الهَوى في سُكرِهِ مُتَناهي",71,"ي",1,0],["ايستنا مِن كُل شَيء وَلَكن","ما أَيسنا مِن رَحمة الخلاق",72,"ق",1,0],["أيسمع مثل اليافعي مقاله","من الحق أصنام عبدن وكوكب",73,"ب",1,0],["ايسمع هذا في المهيمن مسلم","ويسكت لا يشجي ولا يتصخب",73,"ب",1,0],["أيسب خالقنا ونحن نصونه","إنّا إذا لعبيد سوء موق",74,"ق",1,0],["أيسب بينكم الإله فتسكتوا","وتذوق أعينكم لذيذ منام",75,"م",1,0],["أَيسرُ الأشياء في شربك أن","تذهبي أو تسلبي حلم الحليم",76,"م",1,0],["أي سحر فيك يا هذا الجمال","يا مليحا من جمال في جمال",77,"ل",1,0],["أيسديك أولى الناس بالطيش حكمةً","فما ترعوي يا نفس سراً وجهرة",78,"ه",1,1],["أيسلو فؤادي أو أكتمُ","وتجمد عيني ولا تسجمُ",79,"م",1,1],["أيسلو صفات البدر من عشق البدرا","وهل كان للمملوك في نفسه أمرا",80,"ر",2,1],["أَيَستَطيعُ الطيبُ في القارورَه","أَن يَغسِلَ الأَوساخَ في القاذورَه",81,"ه",1,0],["أَيُّ سَهمٍ فَوَّقَ البَي","نَ مُصيباً وَرَماني",82,"ن",2,0],["أيْسَرُ مِنْ لَمْحَةٍ بِطَرْفٍ","مَا كَانَ أَيْسَرَ مَا طَلَبْتُمْ",83,"م",1,0],["أيُّ سِرٍّ عنك أخفي","بعدما أعلنتُ ضعفي",84,"ف",2,1],["أَيّ سَنِيٍّ مِن المَسَاعِي","لَيْسَتْ مَساعيهِ مِنْهُ أَسْنَى",85,"ن",2,0],["أَيَسوغُ عَذلٌ في قَضيب مائِسٍ","فَوقَ الكَثيبِ بِبَدرِ تَمٍّ أَبلَجِ",86,"ج",1,0],["أَيَسُرُّها أنّي أموتُ بدائي","من بعد ما علمتْ مكانَ دوائي",87,"ي",1,1],["أيّ سرٍّ تطوى خفاياهُ عنّي","حينما ألتقيك في الأحلام",88,"م",1,0],["أيسرّك البوح وهل","في بوح سرّك تفرحين",89,"ن",1,0],["أَيَسُرُّني أَنّي أُسَمّى طائِعاً","وَأَنا الشَهيدُ عَلَيَّ بِالعِصيانِ",90,"ن",1,1],["أَيَسطو عَلى بابوج مِثليَ سارق","وَلَم يَخشَ إِغراقاً بِتَيّارِ يَمِّهِ",91,"م",2,0],["أيَّ سبْقٍ سبقُوا نحو العُلا","واقتفى آثارَهم أيَّ اقتفاء",92,"ا",2,0],["أَيَسكُتُ عَن شَكوى الهَوى بِكَ مَنطِقٌ","وَتُعدَى جُفوني بِالسُّكوتِ وَتُحصَرُ",93,"ر",1,0],["أيَّ سرور جنيت منه","لم تعتكر بعده هموم",94,"م",1,0],["أيسَرُ ما في أمرنا أنَّنا","لمَّا حَفِظنا عَهدكُم ضِعنا",95,"ن",2,0],["آيست وَقَد بانوا مِن العَيش بَعدَهُم","يَقيناً وَفي غَير النَوى بِحُسن الرَجا",96,"ج",2,0],["أَيست مِن اللُقا فَاِرتحت لَكن","بِقَلبي مِن تذكرهِ نَصول",97,"ل",1,0],["ايست وَقدا ودوا من العز وَالعُلى","وَلليأس مِن بَعض الأُمور مُريح",98,"ح",1,0],["آيست في الحُب مِن سُروري","كَما تَسَليت عَن هُجوعي",99,"ع",2,0],["أيّ سيفٍ نضتْهُ لي جفناكَا","أي رُمحٍ هزّتْهُ لي عِطفاكَا",100,"ك",2,1],["أَيُّ سرٍّ في فؤادي لَهمُ","غير مأمونٍ عليه الرسلُ",101,"ل",1,0],["أيُّ سعدٍ وافى وأيةُ بشرى","بِلسان الهنا على الدَّهر تُملَى",102,"ل",2,0],["آيَسْتَني وأرَحْتَني وكَفيْتَني","واليَأْسُ خَيرٌ مِنْ مَنوعٍ باخِلِ",103,"ل",1,0],["أيسترقُّ الكريمَ ذَا النّسبِ ال","واضِحِ عبدٌ مُستعجِمُ النّسَبِ",104,"ب",1,0],["أيسمو الجاهلون بغير علمٍ","ويروى من هزَوْتُ به وأَظما",105,"م",2,0],["أيُّ سكونٍ لَشِجٌ قلبُه","هفت به قادِمتا طائرِ",106,"ر",1,0],["أيساقُ لي كأس الصدود فاختشي","لمظنهٍ في نْيلِ بيضِ أماني",107,"ن",2,0],["أيسكن أوطان النبيين عصبة