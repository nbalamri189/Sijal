{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"عطون بأعناق الظباء وأشرقت","https://www.aldiwan.net/poem29798.html","الطويل"],[63,"على التلعات الحو من أيمن الحمى","https://www.aldiwan.net/poem45721.html","الطويل"],[55,"أيسركم أني هجرتكم","https://www.aldiwan.net/poem26411.html","الكامل"],[55,"أيا معرضا عني ولم أجترم ذنبا","https://www.aldiwan.net/poem26517.html","الطويل"],[77,"عن باب والدك الرضى لا أبرح","https://www.aldiwan.net/poem36634.html","الكامل"],[86,"أبكي وعين الشرق تبكي معي","https://www.aldiwan.net/poem10376.html","السريع"],[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[54,"أيسومني المأمون خطة عاجز","https://www.aldiwan.net/poem27601.html","الطويل"],[88,"ألا ما لأهل الشرق في برحاء","https://www.aldiwan.net/poem44973.html","الطويل"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[51,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"أيسير مدحي في الأمير وكله","https://www.aldiwan.net/poem8515.html","الكامل"],[51,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[51,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"أيست من دهري ومن أهله","https://www.aldiwan.net/poem64994.html","البسيط"],[51,"يا يوم إسحاق بن عبد الملك","https://www.aldiwan.net/poem65782.html","السريع"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[14,"سلي الطارق المعتر يا أم مالك","https://www.aldiwan.net/poem38298.html","الطويل"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[45,"يا ابن حمدون بن إسما","https://www.aldiwan.net/poem63471.html","مجزوء الرمل"],[45,"غال صبري إما سألت بصبري","https://www.aldiwan.net/poem63641.html","الخفيف"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[28,"فسيرا فلا شيخين أحمق منكما","https://www.aldiwan.net/poem5283.html","الطويل"],[2,"ولقد نهيتكم وقلت لكم","https://www.aldiwan.net/poem25043.html","الكامل"],[66,"إني ليطربني العذول فأنثني","https://www.aldiwan.net/poem41355.html","الكامل"],[97,"لا تقل عند رحيلك أسعد اللهُ مساءك","https://www.aldiwan.net/poem24410.html","مجزوء الرمل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[44,"أيسلبني ثراء المال ربي","https://www.aldiwan.net/poem30557.html","الوافر"],[74,"ركضوا الجياد إلى الجلاد صباحا","https://www.aldiwan.net/poem12884.html","الكامل"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[105,"دعوا الشهيد لشعب ليس ينساه","https://www.aldiwan.net/poem42130.html","البسيط"],[105,"صبوا المداد وحطموا الأقلاما","https://www.aldiwan.net/poem43383.html","الكامل"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[40,"عوجي علينا ربة الهودج","https://www.aldiwan.net/poem42341.html","السريع"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[48,"الحمد لله العلي","https://www.aldiwan.net/poem63245.html","مجزوء الكامل"],[46,"أيسجنني رب العلا منصف","https://www.aldiwan.net/poem23125.html","الطويل"],[46,"أيسمع خالقي مني دعاء","https://www.aldiwan.net/poem23171.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43759","الطويل"],[95,"ياشعب","https://www.poetsgate.com/ViewPoem.aspx?id=25625",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"عن باب والدك الرضا لا أبرح","https://www.poetsgate.com/ViewPoem.aspx?id=33552",""],[100,"الهارب.. إلى صوته","https://www.poetsgate.com/ViewPoem.aspx?id=183582",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""]],"verses":[["أَيَسنَحُ لي رَوضاً وَأُصبِحُ عازِباً","وَيَعرِضُ لي ماءً وَأُصبِحُ صادِيا",0,"ي",2,0],["أَيَسمَحُ لي هَذا الزَمانُ بِصاحِبٍ","طَويلِ نِجادِ السَيفِ مِن آلِ هاشِمِ",1,"م",1,0],["أَيَسمَحُ جَفني بِالدُموعِ وَأَغتَدي","ضَنيناً بِها إِنّي إِذاً لَلَئيمُ",2,"م",1,0],["أَيُسعِدُ مَن يُدميجَوانِحَهُ النَّوى","حَمامٌ لَدَيهِ الإِلفُ وَالفَرخُ وَالوَكرُ",3,"ر",1,0],["أَيَسُرُّكُم أَنّي هَجَرتُكُمُ","وَمَنَحتُ قَوماً غَيرَكُم وُدّي",4,"ي",1,1],["أَيُسخِطُكُم أَنّي هَوَيتُ وِصالَكُم","فَلا تَغضَبي يا مُنيَتي فَلَكِ العُتبى",5,"ب",2,0],["أيَسوغُ عنْ مَثْواهُ سَيْريَ خائِباً","ومَنابِرُ الدّنْيا بذِكْراكَ تَصْدَحُ",6,"ح",1,0],["أَيَّ سَبيلٍ لِلهُدى لَم يَرِد","وَأَيُّ بابٍ مِنهُ لَم يَقرَعِ",7,"ع",1,0],["أَيْ سُلَيْمَانُ أَيْنَ مِنَّا سُلَيْمَ","انُ وَأَيْنَ المَنْطُوقُ وَالمَفْهُومُ",8,"م",1,0],["أَيْ سُلَيْمَانُ إِنَّنِي لأَسِيفٌ","أَنْ يُقَالَ الفَقِيدُ وَالمَرْحُومُ",8,"م",1,0],["أَيُّ سَعْدٍ لِلرِّيفِ وَهْوَ بِمَرْ","آكَ يَرَى وَجْهَ دَهْرِهِ البَسَّامَا",9,"م",2,0],["أَيَسومُني المَأمونُ خِطَّةَ عاجِزٍ","أَو ما رَأى بِالأَمسِ رَأسَ مُحَمَّدِ",10,"د",1,1],["أيَسعَد محياكم بغير نسائكم","وهل سعِدت أرض بغير سماء",11,"ا",2,0],["أيسرع لي بالمالِ جوداً ولا أرى","بماءِ جفوني جائداً أتسرَّع",12,"ع",1,0],["أيسوؤُني مَنْ لم أكنْ لأسوءَهُ","ويُريبني من لم أكن لأُريبَهُ",13,"ب",2,0],["أيسرقُ البحتريُّ الناسَ شعرَهُمُ","جهراً وأنت نَكالُ اللصِّ ذي الرِّيَبِ",14,"ب",1,0],["أيسيرُ مدحي في الأمير وكلُّهُ","يا للرجال مُؤرَّجٌ بعتابِ",15,"ب",1,1],["أيسكن مسلوبٌ سكينةَ ليله","ويأنس مفجوع بأنس نَهاره",16,"ر",2,0],["أيسفكُ للوشاة دم ثمينٌ","وقيمةُ كل ما يَحكون فَلسُ",17,"س",1,0],["أيسرُ ما يشكرُ القريضُ له","تسهيلهُ قرضَهُ لقرَّاضه",18,"ض",2,0],["أَيِستُ من دهري ومن أهله","فليس فيهم أحدٌ يُرضى",19,"ض",2,1],["أيُّ سماحٍ ضُمَّ في قبرهِ","وماءِ وجهٍ في ثراهُ سُفِك",20,"ك",1,0],["أيُّ سلطانٍ وقد أصبحْتُما","كمسيٍء ومسيءٍ في قَرن",21,"ن",1,0],["أَيَسلُبُ قَومَكُم رُشدَهُم","وَيَدعوهُ قَومِكُم مُحسِنا",22,"ن",2,0],["أَيُسفِرُ وَجهي إِنَّهُ أَوَّلُ القِرى","وَأَبذُلُ مَعروفي لَهُ دونَ مُنكَري",23,"ي",1,0],["أَيَسومُني العُذّالُ عَنهُ تَصَبُّراً","وَحَياتِهِ قَلبي أَرَقُّ وَأَشفَقُ",24,"ق",1,0],["أَيُّ سِحْرٍ دهاكَ هل أَنْتَ مسحورٌ","شقيٌّ أَو ماردٌ يَتَهكَّمْ",25,"م",1,0],["أيسطو على الكُلِّ ليلُ الفناء","ليلهو بها الموتُ خَلْفَ الوجود",26,"د",1,0],["ايّ سحر حوت عصاً","حركت هذه الأكر",27,"ر",1,0],["أَيُسَوّي بِكَ قَومٌ","وَمَواليهم عَبيدُك",28,"ك",1,0],["أَيسَ العاذِلونَ مِن بُرءِ سُكري","إِنَّ سُكرَ الغَرامِ أَقتَلُ سُكرِ",29,"ر",1,0],["أَيَسخَطُها الأَذواءُ مِن سَروِ حِميَرٍ","وَيَرضى بِها أَولادُ سَعدٍ وَنابِلِ",30,"ل",1,0],["أَيَسعى اِبنُ مَسعودٍ وَتِلكَ سَفاهَةٌ","لِيُدرِكَ ما قَد كانَ بِالأَمسِ ضَيَّعا",31,"ع",2,0],["أَيسارُ صِدقٍ ما عَلِمتُهُمُ","عِندَ الشِتاءِ وَقِلَّةِ الأَنواءِ",32,"ا",2,0],["أَيَسومُ إِشراكي بَدينِ هَواكُمُ","مَن لَيسَ في شَرعِ الغَرامِ بِمُؤمِنِ",33,"ن",1,0],["أيُّ سعدٍ لخليلِك","شيَّعَ الروحَ وراءَك",34,"ك",1,0],["أي سرٍّ فيك إني لست أدري","كل ما فيك من الأسرار يغري",35,"ي",1,0],["أَيَسلُبُني ثَراءَ المالِ رَبّي","وَأَطلُبُ ذاكَ مِن كَفٍّ جَمادِ",36,"د",1,1],["أَيسارُ حَربٍ كُلَّما اِشتَجَرَ القَنا","لَم يُعمِلوا إِلّا الرِماحَ قِداحا",37,"ح",2,0],["أَيسمعُ صَيْحَتِي في مِصرَ قومٌ","هُمُ اللَّهبُ المؤجَّجُ والوقودُ",38,"د",1,0],["أيسمعُ النُّصحَ قومٌ أم بهم صَمَمٌ","أم ليس يفهمُ بعضُ القومِ معناهُ",39,"ا",2,0],["أَيَسوسُ رَيبُ الدَهرِ مِنّا أُمَّةً","تَبغي حَياةَ المَجدِ أَم أَنعاما",40,"م",2,0],["أَيُسلِمُ المَجدُ آمالي إِلى قَلَمٍ","تَنهَلُّ لي رَحمَةً في الطِرسِ أَدمُعُهُ",41,"ع",2,0],["أَيسَرُ ما نالَ مُحِبٌّ لَدى","بَينِ حَبيبٍ قَولُهُ عَرِّجِ",42,"ج",1,0],["أيَسُرُّ قوْماً أنّ مكّةَ غُودِرَتْ","بَمجَرِّ جيش الرّومِ قاعاً صَفْصَفا",43,"ف",2,0],["أَيَسُبُّني رَجُلٌ عَلَي","هِ مِنَ الخِزانَةِ أَلفُ شاهِد",44,"د",1,0],["أَيَسجُنُني رَبُّ العُلا مُنصِفٌ","وَإِن تُقنَ راحٌ فَهيَ لا رَيبَ تُبزَلُ",45,"ل",1,1],["أَيَسمَعُ خالِقي مِنّي دُعاءً","فَأُصبِحَ في كَياني مُستَقيلا",46,"ل",2,1],["أيستحيلُ الكونُ هذا الهشيم","والظلمة الجاثمُ فيها الخراب",47,"ب",1,0],["أيستحقُّ الناسُ هذا العقاب","أم حانت الساعةُ من نقمتكْ",47,"ك",1,0],["أيُّ سرٍّ للجاذبيةِ فيه","يأخذُ الأرضَ نَحوَه بانحرافِ",48,"ف",1,0],["أَيَّ سَهْمٍ رَمَيْتُ فِي صَدْرِ وَلهَى","بِكَ كَانَتْ تُرَدُّ عَنْهَا السِّهَامُ",49,"م",1,0],["أَيْ سَاقِيَ الرَّاحِ أَجْرِهَا وَأَدِرْ","عَلَى الرِّفَاقِ الأَقْدَاحَ تَتَّقِدُ",50,"د",1,0],["أَيَسْتَقْبِلُ الغُصْنُ الرَّبِيعَ وَثَوْبُهُ","قَشِيبُ الحِلَى إِلاَّ إِذَا مَا تَجَرَّدَا",51,"د",2,0],["أَيُّ سَعْدٍ لِشَعْبِهِ أنْ يَرَاهُ","طَالِعاً بَيْنَهُ وَمَا مِنْ حِجَابِ",52,"ب",1,0],["أَي سِرٍّ فِي ذَلِكَ الْقَلَمِ الْقَا","طِرِ مَا تَقْطُرُ ابْنَةُ الْعُنْقُودِ",53,"د",1,0],["أَيُّ سَهْمٍ صَائِبٍ فَوَّقَهُ","مَنْ رَمَاهُ فَرَمَاهَا عَنْ كَثَبْ",54,"ب",1,0],["أَيَّ سَطْرٍ فِي المَعَالِي كَتَبَا","بِالزَّكِيِّ الحُرِّ مِنْ تِلكَ الدِّمَاءْ",55,"ا",2,0],["أَيْ سَادَتِي طُرقُ الفلاَحِ كَثِيرَةٌ","فِي وَجْهِ مَنْ يَسْعَى وَهَذا مَهْيَعُ",56,"ع",1,0],["أَيَسلُبُ نَفس الحرّ وهي كَريمَة","وَيَقطَعُ كَفَّ المَجدِ وَهيَ يَمينُ",57,"ن",1,0],["أيسيل صدرك من جراحتهم","وتعطيهم سلاحك",58,"ك",1,0],["أيسكن الدرُّ والمَرجان شاطئَه","أم في قراراته در ومرجان؟",59,"ن",1,0],["أيسيطرون على شعوبٍ حرَّةٍ","وعليهمو شعبُ اليهود تسيْطَرا؟",60,"ر",2,0],["أيسكت، والقلوب لها وَجِيبٌ","وييبَس، والرياض لها اخضلال؟",61,"ل",1,0],["أيسكن والكواكب دائراتٌ","كأنَّ الكون ليس به اختلال؟",61,"ل",1,0],["أيسوغ عن مثواه سيري خائبا","ومنابر الدنيا بذكرك تصدح",62,"ح",1,0],["أي سرٍ عن المغارات يروي؟","قيل: يهذي، وقيل عنه، تهاذى",63,"ذ",2,0],["أيُسْلبُ عنها نعيمُ الهجيرِ","ونفحُ الرمالِ ، وبذْخُ العرا!!",64,"ا",1,0],["أيسْتُ من كلِّ مطلوبٍ أُؤمِّلُهُ","وأصبحَ الموتُ من أغلى مطاليبي",65,"ب",2,0]]}