{"poems":[[55,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[95,"ماذا يريد الشعر مني","https://www.aldiwan.net/poem11203.html","مجزوء الكامل"],[53,"أتاني مقال من أخ فاغتفرته","https://www.aldiwan.net/poem8311.html","الطويل"],[53,"رأيت حمالا مبين العمى","https://www.aldiwan.net/poem61861.html","البسيط"],[63,"أبا الفتح رحت بوجه وقاح","https://www.aldiwan.net/poem51374.html","المتقارب"],[83,"لي صاحب ترك النساء تظرفا","https://www.aldiwan.net/poem61474.html","الكامل"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"أهاشم خذ مني رضاك وإن أتى","https://www.aldiwan.net/poem65270.html","الطويل"],[48,"سمتك أمك دينارا وقد كذبت","https://www.aldiwan.net/poem22830.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/141831","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[92,"المازني وداغر","https://www.poetsgate.com/ViewPoem.aspx?id=179154",""],[33,"مَنْ لِعَيْنِ تُذْري مِنَ الدَّمْعِ غَرْبَا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18760&r=&rc=23",""],[113,"أمولاي من دون الأنام وسيدي","https://www.aldiwan.net/poem16328.html","الطويل"],[147,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[164,"رثت لنحولي في هواها وذلتي","https://www.aldiwan.net/poem59010.html","الطويل"],[226,"أتستقبل الدهر مستبشرا","https://www.aldiwan.net/poem55293.html","المتقارب"],[228,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[234,"هجرت شرب الراح في فتيه","https://www.aldiwan.net/poem51052.html","السريع"],[242,"إلى ما فؤادي يذوب زفيرا","https://www.aldiwan.net/poem18193.html","المتقارب"],[264,"يلومون في خلع العذار أخا الهوى","https://www.aldiwan.net/poem35516.html","الطويل"],[285,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[285,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[343,"إذا أعطى القليل فتى شريف","https://www.aldiwan.net/poem68682.html","الوافر"],[347,"يا شعاع الصباح","https://www.aldiwan.net/poem55362.html","مجزوء الخفيف"],[354,"دور الوجود لعيني","https://www.aldiwan.net/poem15855.html","المجتث"],[358,"انظر مناقب فرقدي فلك التقى","https://www.aldiwan.net/poem39765.html","الكامل"],[358,"قضى تذكار أبكار الليالي","https://www.aldiwan.net/poem40000.html","الوافر"],[358,"طريفا كان مجدك أم تليدا","https://www.aldiwan.net/poem40396.html","الوافر"],[369,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[463,"رضيت وما من طاعة كل من رضي","https://www.aldiwan.net/poem56148.html","الطويل"],[519,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76571","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86677","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37736","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202071","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64667","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112885","الرمل"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98205","السريع"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137849",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79819","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80010","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87850","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114756","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104769","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109361","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27157","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104685","السريع"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74300","الهزج"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74273","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97983","المتقارب"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26119","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74070","الكامل"],[3506,"","https://poetry.dctabudhabi.ae/diwan/poem/107336","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48453","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119636","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127245","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127125","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123509","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94764","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94648","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94517","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135087","الطويل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147294","المتقارب"],[4709,"قصير هو العمر","https://www.poetsgate.com/ViewPoem.aspx?id=214867",""],[4767,"طفل الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=88355",""],[4862,"سئمت من التخاصم والخصام","https://www.poetsgate.com/ViewPoem.aspx?id=55618",""],[4942,"لولاك","https://www.poetsgate.com/ViewPoem.aspx?id=188297",""],[4980,"أحلى الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=196793",""],[5126,"تحياتي إليك مع السماح","https://www.poetsgate.com/ViewPoem.aspx?id=206091",""],[5136,"نفس على برحى الشوق أطويها","https://www.poetsgate.com/ViewPoem.aspx?id=121778",""],[5174,"حوار مع شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187134",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5271,"ومنْ نورِ وجهُكِ صُبحي انفَلَقْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=59741",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5411,"دُروب السَّالِكين","https://www.poetsgate.com/ViewPoem.aspx?id=185377",""],[5411,"دروب السالكين","https://www.poetsgate.com/ViewPoem.aspx?id=187258",""],[5595,"العظيم له احتراما","https://www.poetsgate.com/ViewPoem.aspx?id=144522",""],[5720,"مناجي","https://www.poetsgate.com/ViewPoem.aspx?id=206474",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5725,"تداعى علينا القوم","https://www.poetsgate.com/ViewPoem.aspx?id=177466",""],[5736,"شكواي","https://www.poetsgate.com/ViewPoem.aspx?id=208435",""],[402,"ماذا يريد الشعر منني","https://www.poetsgate.com/ViewPoem.aspx?id=36534",""],[5809,"هدهدي","https://www.poetsgate.com/ViewPoem.aspx?id=205095",""],[5829,"وقلب العاشقين هنا يذوب","https://www.poetsgate.com/ViewPoem.aspx?id=210213",""],[5939,"خان الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=178583",""],[6143,"عذرا رسول الله...","https://www.poetsgate.com/ViewPoem.aspx?id=175095",""],[242,"إلى م فؤادي يذوب زفيرا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563700",""],[2220,"قفْ بالطّولِ الدارساتِ بلعلعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19281&r=&rc=823",""]],"verses":[["فَعُذراً لِأَعدائي إِذا كانَ أَقرَبي","يُشَذِبُّ مِن عودي وَيَعرُقُ مِن نَحضي",0,"ض",2,0],["فَعُذْراً وَإِغْضَاءً وَلاَ تَنْسَ صَارِخاً","بعِزِّك يَرْجُو أَنْ يُجيبَ مُجِيبُ",1,"ب",1,0],["فَعَذِيرُهُ خَوْفُ التَّشْبِيهِ","بِالرَّحَى مِنْ غَيْرِ طِحْنِ",2,"ن",1,0],["فعذرُك مبسوطٌ لدينا مُقدَّمٌ","ووُدُّك مقبولٌ بأهلٍ ومرحبِ",3,"ب",1,0],["فَعُذْتُ من أمْثال أحْوالِهِ","باللّه والحُرِّ أبي سَعْدِ",4,"د",1,0],["فعذبت صحبك حتى المساء","وعذبت عرسك حتى الصباح",5,"ح",1,0],["فَعَذَلتُهُ يَوماً وَقَد أَبصَرتُهُ","يُعنى بِقَودِ فُلانَةٍ لِفُلانِ",6,"ن",1,0],["فَعَذَرَ العِنّينَ يَومَ السابِعِ","إِلى عَروسٍ ذاتِ حَظٍّ ضائِعِ",7,"ع",1,0],["فَعُذتُ بِحَقوَي هاشِمٍ فَأَجارَني","كَريمٌ أَراهُ فَوقَ كُلِّ كَريمِ",8,"م",1,0],["فَعُذ بِرَبِّكَ مِن وَسواسِ مُشبِهَةٍ","خَنساءَ تَرميكَ مِن جِنٍّ بِخُنّاسِ",9,"س",1,0],["فعذرك في أني أجبتك واثقاً","بفضلك فالإنسان يسهو ويذهل",10,"ل",1,0],["فَعَذَرْتُ خَفَّتَهَا لِشِعْرٍ زَادَهَا","بِجَمَالِهِ البَاقِي جَمالَ بَقَاءِ",11,"ا",2,0],["فعذراً إن وصلتُكِ بعد هجرٍ","وما هَجَر الذي حفِظ الذِمَامَا",12,"م",2,0],["فعُذراً فما أنا إذ أتّقي","رجالَ السياسة بالمائن",13,"ن",1,0],["فَکعْذِريني إنْ كُنْتُ صَاحِبَ عُذْرٍ","واغفري لي إن كنتُ أذنبتُ ذنبا",14,"ب",2,0],["فَعُذراً أَخا العَلياء قَلَّت عَزائِمي","وَقَد كُنتُ كَالسَيف الصَقيل المُجَرَد",15,"د",1,0],["فَعَذَلتُ قَلبِيَ إِذ أَطاعَ غَرامَهُ","وَعَصى التَسَلِّيَ بَعدَها وَاللُوَّما",16,"م",2,0],["فعذرهم أبدا من الشمس في الضحى","وأظهر لا يخفى على ذي بصيرة",17,"ه",1,0],["فعذراً لمثلي إذا قصرا","فمثلي جدير بأن يعذرا",18,"ر",2,0],["فَعَذابُ الساعاتِ كانَت خُلوداً","أَبديّاً وَلم تَكُن أَحلاما",19,"م",2,0],["فعُذْتُ من قصدِ فريدِ العُلا","بَمعقِلٍ لا زال لي ذُخرا",20,"ر",2,0],["فَعُذْراً لِمَنْ خَانَهُ دَهْرُهُ","وَأَخْنَى الزَّمانُ علَيْهِ مُغِيرَا",21,"ر",2,0],["فَعُذراً لعذّالي على خمر حبّها","وما شربوا كأسي وقد جهلوا أمري",22,"ر",2,0],["فَعُذْراً إِنْ عَجَزْتُ لِطُولِ هَمِّي","عَنِ الإِسْهابِ وَالنَّفَس الطَّوِيلِ",23,"ل",1,0],["فَعُذْ بِنَهارِيِّ الْعَدَاوَةِ أَوْحَدٍ","مِنَ الْقَوْمِ لَيْلِيِّ النَّدَى وَالرَّغَائِبِ",24,"ب",1,0],["فَعُذ بِاللَهِ وَالجا إِلَيهِ إِمّا","بَدَت لَكَ حاجَةٌ أَو كانَ كَونُ",25,"ن",1,0],["فعذابي حنين","وحنيني عذاب",26,"ب",1,0],["فَعُذرُ كُلِّ مُضيعٍ","لِحافِظٍ لَيسَ يُقبَل",27,"ل",1,0],["فَعذار ذاكَ وَذا يُبشّر بِالهَنا","أنَّ الرَبيع أَتى وَطابَ زَمانهُ",28,"ن",2,0],["فَعُذراً أَن حَملتِ لَهُ جَوابي","ألا يا نسمَةً تهدي الجَوى لي",29,"ل",2,0],["فَعذراً إنّ عجزي غَير خاف","وَإِن أَمدح عُلاك فَلَن تَزيدا",30,"د",2,0],["فعُذْراً إنْ تَغيَّر عَهْدُ شِعْري","وقد يُغْضي عَنِ الزَّلَلِ الحَليم",31,"م",1,0],["فعذراً وفوزاً بانبساطي فإنه","عزيزٌ على ما اعتاد فرطُ تقبّضي",32,"ض",2,0],["فعُذْراً لِما يَجنِيهِ فيكُم فكَمْ وكَمْ","لهُ عِندَكُم من قبلُ فادحةٌ وِتْرُ",33,"ر",1,0],["فَعذلُكَ لَستُ أَرى مَخلَداً","إِلَيهِ وَلَو كُنتُ أُعطى الخُلُودا",34,"د",2,0],["فَعذره واضح حَيث اِشتَمَلَت عَلى","مَناقب دُونَها في الضُوءِ شَمس ضُحى",35,"ح",2,0],["فَعِذارُهُ المِسكِيّ يَنفُحُ عَنبراً","وجَبينهُ كالنّجمِ فيهِ يُهْتَدى",36,"د",2,0],["فعذّب إن شئت فهو عندي","والله من أعظم الأيادي",37,"د",2,0],["فَعِذيري إن لم أطِقْ مَدْح قوم","ذا لديوانِ مَدْحهم تشْبيبُ",38,"ب",1,0],["فَعُذْتُ مِنْ ضلَّتي فيها بِمَبْسِمِها ال","هادي وعَوَّذْتُها مِنْ غاسِقٍ وَقَبا",39,"ب",2,0],["فعذولي قد رماني","في فؤادي بسنان",40,"ن",1,0],["فعُذْتُ أن أُضبرِعَ خدّي لمن","ماءُ الحَيا قد غاض من خدِّهِ",41,"د",2,0],["فعذرتهم وعذرت نفسي اننا","لا نستطيع الى السماك صعودا",42,"د",2,0],["فعُذراً فإنِّي باقل إن أقل بكم","مديحاً له قس الفصاحة باقل",43,"ل",1,0],["فعذراً إذاً إن تشتك اليتمَ بعده","فقد فقدتْ منه أباً لم يزل برَّا",44,"ر",2,0],["فَعُذراً أَميرَ الشِعرِ إِن ضاقَ خاطِري","بِمَدحِكَ وَاِستَولى الجُمودُ عَلى رُشدي",45,"د",2,0],["فَعذابهُ عذبٌ لعاشِقهِ","وقبيحُه في عينهِ حسَنُ",46,"ن",1,0],["فَعَذبٌ ذلِكَ التَّعذِيب عِندِى","فَزِيدُوا مِنهُ فالتَّعذِيبُ طَابا",47,"ب",2,0],["فعذرتها ولعل عذري واضح","ولقد عهدتك تقبل الأعذار",48,"ر",1,0],["فَعَذَرتُها لَمّا سَمِعتُ كَلامَها","تَشكو كَما أَشكو بِقَلبٍ موجَعِ",49,"ع",1,0],["فعذ به من كل ما تشتكي","ولا تحد عن بابه تهمل",50,"ل",1,0],["فَعذرك لَيسَ بالمَقبول","فَصه يا بارد العُذر",51,"ر",1,0],["فَعُذراً وَإِن قصرت مَدحاً فَإِنَّني","بليت بِأَيام خَلعت بِها عذري",52,"ر",2,0],["فعذر الحبيب كهجر الرقيب","وظرف الزمان كلطف القدر",53,"ر",1,0],["فَعُذتُم بِأَحواءِ الرِبابِ وَأَنتُمُ","كَفَقعِ التَناهي اِستَدرَجتُهُ السَنابِكُ",54,"ك",1,0],["فَعَذَّبتُها بِالنَوى إِذ جَنَت","وَحَقَّ العَذابُ عَلى الجانيَه",55,"ي",2,0],["فَعَذابها عذب لمن ثبتوا","دون الحمى ولمن به قحموا",56,"م",3,0],["فَعُذراً لِصَبٍّ أَحرَقَ الوَجدُ قَلبَهُ","وَباتَ لَدى جَمرِ الغِرامِ عَلى سَقَر",57,"ر",1,0],["فعُذْنا بطولِ الذّكرِ لو كان مُجْدياً","ولُذْنا بحسْنِ الصّبْرِ لوْ كان مُقْنِعا",58,"ع",2,0],["فعذري لن يروق لعي","نه إن ألتمس عذرا",59,"ر",2,0],["فعذراً أيها المولى لصب","فلم يك سامعٌ مثل المُ