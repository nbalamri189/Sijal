ww.poetsgate.com/ViewPoem.aspx?id=156526",""],[5277,"جوريّة قيسية","https://www.poetsgate.com/ViewPoem.aspx?id=200587",""],[307,"جاهدتُ دهري للحروف وصولا","https://www.poetsgate.com/ViewPoem.aspx?id=213776",""],[5327,"وَصَماتُ الغَدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=144598",""],[5376,"للدمعِ في صرفِ الزمانِ شؤونُ","https://www.poetsgate.com/ViewPoem.aspx?id=202170",""],[5431,"لاأنبسُ...","https://www.poetsgate.com/ViewPoem.aspx?id=190718",""],[5506,"إن جِئتَ بَدراً فَطِب وَاِنزِل بِذي سَلَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=115770",""],[5508,"أفي البانِ أنْ الخليط مُخَبرُ","https://www.poetsgate.com/ViewPoem.aspx?id=110826",""],[482,"خلا مِنَ القومِ مصطاف ومرتبعُ","https://www.poetsgate.com/ViewPoem.aspx?id=111303",""],[5704,"لا تسألوني ...","https://www.poetsgate.com/ViewPoem.aspx?id=198795",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[6144,"عزرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=21837",""],[2220,"حكمُ الطبيعة ِ في الأجسامِ معتبرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11387&r=&rc=261",""]],"verses":[["في الناسِ غَيرُ مُطَهَّرٍ","وَالحُرُّ مَعدومُ النَظيرِ",0,"ر",1,0],["فَيا لَنِزارٍ دعْوَةً مُضَريَّةً","بحيثُ الرُّدَيْنِيّاتُ بالدّمِ تَرْعُفُ",1,"ف",1,0],["في الناسِ مِثلُكِ لو أَرَدتُ وَجَدتُهُ","لَو يُبتَغى مِثلي لَكُم لَم يُوجَدِ",2,"د",1,0],["في النَقلِ وَالتَصنيفِ أَربى عَلى","مَدى اِبنِ بَحرٍ وَمَدى الأَصمَعي",3,"ع",2,0],["فِي النَّقْشِ مِنْهُ لأَهْلِ الذِّكْرِ قَدْ كُتِبَتْ","آيَاتٌ ذِكْرٍ بِإِحْكَامٍ وَتِبْيَانِ",4,"ن",1,0],["فِي النَّابِهِ المُوفِي عَلَى أعْلامِهَا","وَالنَّابِغِ السَّبَّاقِ لِلأَفْرَانِ",5,"ن",1,0],["فِي النَّثْرِ أَوْ فِي النَّظْمِ صَوْغُكَ مُحْكَمٌ","فَوْقَ الظنُونِ فَلا مَزِيدَ لِمُحْكِمِ",6,"م",1,0],["فِي النَّاسِ لاَ يَقْلاَكَ إلاَّ مَنْ بَلاَ","فَتَكَاتِ بَأْسِكَ حِينَ مِصْرُ تُضَامُ",7,"م",1,0],["في الناسِ إِن فَتَّشتَهُم","مَن لا يُعِزُّكَ أَو تُذِلُّه",8,"ه",1,1],["في الندى حاتمٌ وفي الرأي عمرٌو","والتقاضي قيسٌ وفي البأس حمزه",9,"ز",2,0],["في الناس من يمشي على رجلين في","نظمٍ ومن يمشي على أخلاف",10,"ف",1,0],["فيا لنعيم جسمٍ قد حواه","وقد أهدى إلى قلبي الوبالا",11,"ل",2,0],["في النَّاسِ قومٌ يُريهِمْ إفكُ ظَنِّهِمُ","شمسَ النهارِ تُباري قطرها الرَّكم",12,"م",1,0],["في النَفسِ مِنها ما بِها مِن دَهرِها","أَزكى السَلامِ عَلَيكِ أَرضَ المَوعِدِ",13,"د",1,0],["في النفس منك جميع ما احسسته","من سيء سمج ومن اعلاق",14,"ق",1,1],["في النَجمِ وَالقَمَرَينِ مَظهَرُها إِذا","طَلَعَت عَلى الدُنيا وَساعَةَ تَخفُقُ",15,"ق",1,0],["في الناسِ أَمثِلَةٌ تَدورُ حَياتُها","كَمَماتِها وَمَماتُها كَحَياتِها",16,"ت",3,0],["في الناسِ لِلناسِ أَندادٌ وَلَيسَ لَهُ","فيهِم شَبيهٌ وَلا عَدلٌ وَلا نِدَدُ",17,"د",1,0],["في النَفرِ أَو في لَيلَةِ ال","تَحصيبِ عِندَ حِصابِها",18,"ب",3,0],["في الناسِ أَبدالٌ وَلي مَزحَلٌ","عَن مَنزِلٍ ناءٍ وَمَرعىً وَخام",19,"م",1,0],["في النَفسِ شُغُلٌ عَنِ الغادي لِطَيَّتِهِ","وَفي الثَوابِ رِضىً مِن صاحِبِ رادِ",20,"د",1,0],["في الناسِ عائِلَةٌ عَلَي","كِ وَبَعضُ أَهلِكِ يُثرِبُ",21,"ب",1,0],["في الناسِ مَن فَقرُهُ عُزٌّ لِجارَتِهِ","وَجارُهُ وَغِناهُ كُلَّهُ ذَلِلُ",22,"ل",1,0],["في الناسِ ذو حِلمٍ يُسَفِّهُ نَفسَهُ","كَيما يُهابَ وَجاهِلٌ يَتَحَلَّمُ",23,"م",1,0],["فَيا لنَعيمِ عَيْشٍ قَدْ تَوَلَّى","ويا لِغليلِ حُزْنٍ مُسْتَفادِ",24,"د",1,0],["في النكص من حذرالردى","ذام يعيبك أَي ذام",25,"م",1,0],["فِي النَّطْفَةِ الْحَمْراَء مِنْ نَضْحِها","وقْدٌ كَوقْدِ الحَوْمةِ المُسْعَرِ",26,"ر",1,0],["فِي النُّوبِ وَالسُّودَانِ قَوْمٌ رُزِئُوا","أَكْفى نَصِيرٍ وَأَبَرُّ هَادٍ",27,"د",1,0],["فِي النَّظْمِ أَوْ فِي النَّثْرِ مِنْ طَاقَاتِهَا","لُطْفُ البَيَانِ وَرَوْنَقُ الإِخْفَاءِ",28,"ا",2,0],["في الناس من ينقُدُ الأصيل، فإِن","حثَّ الخُطا نحو مَيدان السباق حبا",29,"ب",2,0],["في النُّور لمَّاح السَّنا","متأَلِّقًا في فجره",30,"ر",2,0],["في النّاسِ مَنْ تَسهُلُ المَطالبُ أحْ","ياناً عَلَيهِ، ورُبّما صَعُبَتْ",31,"ت",1,0],["في الناس أنذال وأوغد أمّه","من ولّت الأنذال والأوغادا",32,"د",2,0],["في الناس من أرزاقه الآلاف أو","أعلى وقومٌ مالهم أرزاقُ",33,"ق",1,0],["في الناس جَهلٌ وبهم شِرَّة","لأجل ذَيْنَ صغَّروا شاَنهُ",34,"ن",2,0],["في النفس حاجات وفيك فطانة","تدرى بما في النفس من حاجات",35,"ت",1,0],["في الناسِ أحياءٌ كأمواتِ الوغى","وخز الأسنةِ فيهم لا يؤلمُ",36,"م",1,0],["في النفس شيء كثير","لكنه لا يقال",37,"ل",1,0],["في النَثر إِن لم تَعُد بِالفَخرِ قافيةٌ","على امرىء صاغها سلوى لِمُفتَخر",38,"ر",1,0],["في النَّعمِ ضلَّت فما دَرَت","أيّاً على البؤسِ تصطَحِب",39,"ب",1,0],["في النَعتِ والصِفاتِ","والحالِ والهيئاتِ",40,"ت",1,0],["في النجمِ والحُجراتِ الجمّ من مدحٍ","وَالحجرُ للّه فيها عمره قسمُ",41,"م",1,0],["في الناسِ مَن لو أُمّنوا تبعاتها","لاِستَقذَروها عفّةً وتورّعوا",42,"ع",3,0],["في الناسِ لَم يَبقَ إِلّا","رَبِّ الصَداقَةِ فودُهُ",43,"د",2,0],["في النَفس مِن خطرات الغَمّ عَن أَسَف","ما لَيسَ تَحمله نَفس وَلا بَدَنُ",44,"ن",1,0],["في الناسِ مَن لا يُرتَجى نَفَعٌ لَهُ","إِلّا بِضُرٍّ مِن يَدَيكَ يُصيبُهُ",45,"ه",1,0],["في النفسِ عتبٌ لو قد نطقتُ به","لقيل إني جاوَزتُ مِقداري",46,"ر",2,0],["في النعيم الخَرق","مع يسوع الخِرق",47,"ق",1,0],["في النظم واسلك سبيل العلم نهج النجاه","عليك بالعلم واعمل به تنل ماتشاه",48,"ا",2,0],["في النحو والفقه والأصول وفي ال","منطق يشفي العليل من سقمه",49,"م",2,0],["في النحل قدَّمَني ربي وأخرني","في الرعد قصد الترقي آه لو علموا",50,"م",3,0],["في النَّاسِ من تَجنيسِهِ تَنجيسُ","أبَداً كما تَدريسُهُ تَدليسُ",51,"س",1,1],["في النظم تصفو له اهل القريض وكم","قلائد من لألي النثر وشأها",52,"ا",3,0],["في النطق فاق العَرَبا","وفي العلوّ المُزَني",53,"ي",1,0],["فيا لِنهارٍ لا يغيضُ ظلامُهُ","ويا لِظلامٍ لا يُغيضُ نهارَكِ",54,"ك",1,0],["في النسج فاقوا غيرهم","فتخال صوفهم حرائر",55,"ر",1,0],["في النور في العطر رنحتنا","أنفاسك العذبة الحسان",56,"ن",1,0],["في الناسِ من يَرضَى بجُبن يمينه","إن عُدّ يومَ الرَّوْع غيرَ جبانِ",57,"ن",1,0],["في الناس من يُعطيك من لسانه","شعشعةَ الآل اطّباك لامعا",58,"ع",2,0],["في الناس مَنْ معروفُهُ في عُنُقي","غُلُّ وفيهم مَن جَداه عِقدُ",59,"د",1,0],["في النقد بالزنبور قد","قتل الكسائي سيبويه",60,"ي",2,0],["في الناس ذكرك خالد","حاشا جميلك أن يضيع",61,"ع",1,0],["في النُورِ لاحَ عُلاهُ لا نَظيرَ لَهُ","نُورُ القُرآن قُرآناً مِن لَدُن حَكَمِ",62,"م",1,0],["في النَومِ رُؤيا أَنَّني سُقيتُ","سُقيتُ ماءَ المُزنِ أَو سُقيتُ",63,"ت",1,0],["في الناسِ من يَقِفُ القريضُ ببابِهِ","خَجِلاً ومن يَلقَى القريضَ مُسلِّما",64,"م",2,0],["في الناس جُودٌ ولكن جُودُ راحتِه","أَرْبَى عليهم وليس البَحْرُ كالنَّهَرِ",65,"ر",1,0],["في النور والظلماء جاء محجبا","في سورة الأنوار والنيران",66,"ن",1,0],["في الناسِ كَم عاَينت مِن دَجّالِ","مِن النِساءِ وَمِن الرِجالِ",67,"ل",1,1],["في الناس مَن تسعده الأَقدار","وَفعله جَميعه إِدبارُ",68,"ر",1,0],["في النَط وَالرَقص وَنَوم العزبه","وَنَومة العَروس فَوقَ المَرتَبَه",69,"ه",1,0],["في الناس كَم شوهد عِندَ التَجربه","مِن جاهِلٍ لَم يَدرِ حَق الأَجوِبَه",70,"ه",1,0],["في النار والريح وفي الترابِ","ومائة العامر للخرابِ",71,"ب",1,0],["في الناس صرتَ كبغلٍ عاقه دَبَرٌ","أو مثل نَغْلٍ على الخُرطوم موْسوم",72,"م",1,0],["في الناس أخلاق السباع فذَا على","هذا بظلم يستطيل وباطلِ",73,"ل",1,0],["فِي الناسِ أَبْقَى مِنْ لِسانٍ مِجْزَرِ","بَلْ إِنْ رَآنِي هادِرٌ لَمْ يَهْدِرِ",74,"ر",1,0],["في النفس في إعطائها هواها","مذاهب ثلاثة تراها",75,"ه",2,0],["في الناس أوباش بلا مسكة","كأنهم أوعية فارغه",76,"ه",1,1],["في النسب العد الصميم العالي","والحسب العريق في الجلال",77,"ل",1,0],["في النيل مِن دِمائهم","وَلج في أَفنائهم",78,"م",1,0],["في النابه الخَطير","لا الخامل الحَقير",79,"ر",1,0],["في النرد أَيضاً حكمة عَظيمة","تدركها الخَواطر السليمة",80,"ه",1,0],["في الناس مَن لا يُصلِحه","إِلا عقاب يَجرحه",81,"ه",1,0],["في الناسِ مَنْ لا يُرْتَجى نَفْعُهُ","إِلاَّ إِذا مُسَّ بِأَضْرارِ",82,"ر",1,1],["في الناس أَقضي","بالكاف وَالنون",83,"ن",1,0],["في النار أم في النور خالك أم","في مارجٍ من حمرة الخد",84,"د",1,0],["في الناس لا تل