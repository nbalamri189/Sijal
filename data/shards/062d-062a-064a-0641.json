{"poems":[[47,"يا يوم عرج بل وراءك يا غد","https://www.aldiwan.net/poem63475.html","الكامل"],[41,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[139,"ريب المنون وصرف الدهر أعياني","https://www.aldiwan.net/poem49155.html","البسيط"],[164,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[266,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[445,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[556,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77537","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96731","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46647",""],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124300","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49977","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108863","الكامل"],[2620,"","https://poetry.dctabudhabi.ae/diwan/poem/34983","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204461","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128913","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97063","البسيط"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127927","الرجز"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138771",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204226","الكامل"],[4750,"خشيم الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=180417",""],[4767,"نار الأسَى","https://www.poetsgate.com/ViewPoem.aspx?id=187546",""],[5118,"السدرة والريح","https://www.poetsgate.com/ViewPoem.aspx?id=129801",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5593,"لهجت يمينك بالندى، فبنانها","https://www.poetsgate.com/ViewPoem.aspx?id=181042",""],[5939,"لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=185500",""],[5956,"أوحى له جبريل","https://www.poetsgate.com/ViewPoem.aspx?id=192632",""],[6093,"حتَّى فَنَاجِيل المُلوكِ تَميَّزتْ","https://www.poetsgate.com/ViewPoem.aspx?id=206051",""],[6102,"رَسولُ الهَوى...","https://www.poetsgate.com/ViewPoem.aspx?id=182740",""],[6102,"شاخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184417",""],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["حَتّى فَنينَ وَما البَقاءُ لِواقِفٍ","وَالدَهرُ في أَطرافِهِ يَتَرَدَّدُ",0,"د",1,0],["حَتّى فَجِئنَ بِهِ فَأَجفَلَ مِن مَدىً","كَثَبٍ وَهُنَّ دَوامِجُ الإِحضارِ",1,"ر",1,0],["حتى فتكت بمن عزّت مصيبته","على النفوس وساءت كلَّ إنسانِ",2,"ن",1,0],["حتى فرغت من الصلاة مسلماً","متحللاً من ذلك الإِحرامِ",3,"م",1,0],["حتى فتنت به وللأسنان","بالحسن افتنان",4,"ن",1,0],["حَتَّى فرايتك اللاتي سَمَوْتَ لَهَا","قَدْ حازَها مِثْلَما قَدْ حُزْتَها نَسَقا",5,"ق",2,0],["حتّى فككتُ ذِمامَ المَجدِ مِن عُنُقي","فيهِ وَبرّأَني مِن عهدةِ الكرمِ",6,"م",1,0],["حَتّى فَشت أَفعاله","وَظَهَرَت للعُذَّل",7,"ل",1,0],["حتّى فتحتَ به شمّ المجادل من","وادي بني خالد من بعد عصيانِ",8,"ن",1,0],["حتى فُجعتُ بها ولم","أسطِع لذاهبها ارتجاعا",9,"ع",2,0],["حتى فككت السربقا","عن كل عان موثق",10,"ق",1,0],["حتى فَضضتُ عن الدنان ختامَها","وشربت مثل الأرجوان عُقارَها",11,"ا",1,0],["حتى فتى التحقيق أحمد قائلٌ","لا يأثم الطرف المريض إذا رمى",12,"م",2,0],["حَتّى فَنوا وَرَأى الرائي رُؤوسَهُمُ","تَغدو بِها قُلُصٌ مَهرِيَّةٌ نُجُبُ",13,"ب",1,0],["حتى فسيح الجوّ ليس بواسعٍ","روحي فها هو بالسما محدود",14,"د",1,0],["حتى فؤادي المستهام","سبحان من خلق الانام",15,"م",1,0],["حتى فضضت لكم على روض المنى","دنّ الكرامة بعد دنّ وبال",16,"ل",1,0],["حتى فدى الخلق حرصاً في نجاتهم","بالنفس والأهل والأبناء والصحب",17,"ب",1,0],["حتى فني من كثرة انتظاري","الى الجواب معظم اصطباري",18,"ي",1,0],["حتى فرت من جسم جدك مهجة","بصفاحها الله كيف تصافح",19,"ح",1,0],["حتى فصدت وما بجسمك حاجةٌ","كيما تسبب للطبيب حباءَ",20,"ا",2,0],["حتى فروعه وشعبانه وشجّوره","ما عاد تعرف حيوده من قواطيه",21,"ي",2,0],["حتى فقدناهم بفقدِك ليلةً","بالنعي صاح بدارك النعَّاق",22,"ق",1,0],["حتى \" فمان الله \" يوم انها كاف","__________ شقوها في وجه إحتراءة / شغافي",23,"ف",2,0],["حتى فقأتَ عيونهمْ وتبيّنوا","أنَّ الحقيقةَ في غروركَ تظهرُ",24,"ر",1,0],["حتى فصدت، وما بجسمك علة","كيما تسبب للطبيب حباء",25,"ا",2,0],["حتى في يومٍ أَلفاني","أجتاحُ بساتينَكِ قطفا!",26,"ف",2,0],["حتى فشا الإسلام سرّاً بينهم","وتكاثروا وتتابع الإعطاءُ",27,"ا",2,0],["حتَّى فَنَاجِيل المُلوكِ تَميَّزتْ","ليستْ وما عِنْدَالعَوامِ سَوَاسِيَا",28,"ي",2,0],["حَتَّى فَقَدتُ بِهَذا التِّيهِ بُوصَلَتِي","وَهِمتُ وَحدِيَ مَصعُوقًا وَلا طُورُ",29,"ر",1,0],["حَتَّى فَسَاتِينِي - الَّتِي خَبَّأتُها","لَكَ - تَرْتَجِي - يَا مُهْلِكِي - أَنْ تَدْفَعَكْ !",30,"ك",1,0],["حتى فقدنا طعم كل حقيقة","أمن اليسير اليوم أن ننساكا؟؟",31,"ك",2,0]]}