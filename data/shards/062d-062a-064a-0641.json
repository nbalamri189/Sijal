{"poems":[[45,"يا يوم عرج بل وراءك يا غد","https://www.aldiwan.net/poem63475.html","الكامل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[136,"ريب المنون وصرف الدهر أعياني","https://www.aldiwan.net/poem49155.html","البسيط"],[161,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[262,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[440,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[552,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"]],"verses":[["حَتّى فَنينَ وَما البَقاءُ لِواقِفٍ","وَالدَهرُ في أَطرافِهِ يَتَرَدَّدُ",0,"د",1,0],["حَتّى فَجِئنَ بِهِ فَأَجفَلَ مِن مَدىً","كَثَبٍ وَهُنَّ دَوامِجُ الإِحضارِ",1,"ر",1,0],["حتى فتكت بمن عزّت مصيبته","على النفوس وساءت كلَّ إنسانِ",2,"ن",1,0],["حتى فرغت من الصلاة مسلماً","متحللاً من ذلك الإِحرامِ",3,"م",1,0],["حتى فتنت به وللأسنان","بالحسن افتنان",4,"ن",1,0],["حَتَّى فرايتك اللاتي سَمَوْتَ لَهَا","قَدْ حازَها مِثْلَما قَدْ حُزْتَها نَسَقا",5,"ق",2,0],["حتّى فككتُ ذِمامَ المَجدِ مِن عُنُقي","فيهِ وَبرّأَني مِن عهدةِ الكرمِ",6,"م",1,0]]}