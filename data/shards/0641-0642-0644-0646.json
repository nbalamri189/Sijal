n/poem/117213","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33749","الهزج"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72973","المتقارب"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136434",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120549","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4755,"ضَحِكْنَا وجُرحٌ ما بأَعماقِنا بَكَى","https://www.poetsgate.com/ViewPoem.aspx?id=190326",""],[4780,"رأيت الشيخ بالمصباح يسعى","https://www.poetsgate.com/ViewPoem.aspx?id=13170",""],[4984,"التباري1","https://www.poetsgate.com/ViewPoem.aspx?id=186524",""],[5131,"أخذت المبادئ عن عصبةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=42206",""],[5143,"ولما أبوا إلا المضيَّ وقد رأوا","https://www.poetsgate.com/ViewPoem.aspx?id=186627",""],[5183,"مبعث الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180278",""],[5219,"المتهمة البريئة","https://www.poetsgate.com/ViewPoem.aspx?id=194914",""],[5725,"عشرون مرّت","https://www.poetsgate.com/ViewPoem.aspx?id=195080",""]],"verses":[["فَقُلْنَ لَهَا مِنْ أَينَ أَوْضَحَ ذا الفَتى","وَمَنْشَؤُهُ غَوْرا تِهامَةَ أَوْ نَجْدُ",0,"د",1,0],["فقُلْنَ إذ أبْصَرْنَني باسِماً","حينَ زَوى الأوْجُهَ تَقْطيبُ",1,"ب",1,0],["فقُلْنا هَواءُ الشّامِ غالَ نُفوسَنا","فهَلْ لكَ في شيءٍ يُنَفِّسُ تَنْفِيسا",2,"س",2,0],["فقُلْنا دعِ الإنْكارَ إنّا عِصابَةٌ","يُطيعُونَ فيما تشْتَهي النّفْسُ إبْلِيسا",2,"س",2,0],["فقُلْنا ظَفِرْنا اليوْمَ منْ أجْلِ أحْمَدٍ","بِهَذي ونرْجو تلْكَ منْ أجْلِ جَدِّهِ",3,"د",2,0],["فقُلْنا إنْ يَكُنْ بَشَراً سَوِيّاً","فَفيهِ غَريزَةٌ منْ عَنْكَبوتِ",4,"ت",1,0],["فَقُلنا رَكَضتُم وَلَم تُرمِلوا","وَأَصدَرتُمُ قَبلَ أَن تُورِدوا",5,"د",3,0],["فَقُلنا لَهُ هَذِهِ هاتِها","بِأَدماءَ في حَبلِ مُقتادِها",6,"د",3,0],["فَقُلنا عَلى الهوجِ المَراسيلِ وَاِرتَمَت","بِهِنَّ الصَحارى وَالصِمادُ الصَحاصِحُ",7,"ح",1,0],["فَقُلنا أَلا قَد كانَ صَيدٌ لِقانِصٍ","فَخِبّوا عَلَينا كُلَّ بَيتٍ مُزَوَّقِ",8,"ق",1,0],["فقلنا وهي تخطر في وقار","مليك الحسن يخطر في البلاط",9,"ط",1,0],["فقلنا لهم إنا أحقّ بمُلكها","فقالوا ولكن زند قُوّتنا أورى",10,"ر",2,0],["فَقُلنا لَهُ إِذ قالَ ما قالَ مَرحَباً","أَمَرتَ بِمَعروفٍ وَأَوصَيتَ كافِيا",11,"ي",2,0],["فَقُلنا لَهُ جِدُّ اِبنُ قَيسٍ عَلى الَذي","نُبَخِّلُهُ فينا وَإِن نالَ سُؤدَدا",12,"د",2,0],["فَقُلنا أَلا قَد كانَ صَيدٌ لِقانِصٍ","فَخَبّوا عَلَينا فَضلَ بُردٍ مُطَنَّبِ",13,"ب",1,0],["فَقُل ناشِداً بَيتاً وَمَن ذاقَ مِثلَهُ","لَدى جيرَةٍ لَم يَدرِ كَيفَ اِحتِيالُهُ",14,"ل",2,0],["فَقُلنا لَهُم إِن تَمنَعونا بِلادَكُم","نَجِد مَذهَباً في سائِرِ الأَرضِ واسِعا",15,"ع",2,0],["فَقُلنا ما قَضَيتَ بِهِ رَضينا","وَأَنتَ بِما قَضَيتَ بِهِ كَفيلُ",16,"ل",1,0],["فَقُلنا سُلَيمانُ لَو لَم يَمُت","وَفِرعَونُ لَو حَمَلَتهُ الشُهُب",17,"ب",1,0],["فَقُلنا الشَمسُ فيها أَم نُضارُ","وَياقوتٌ وَمُرجانٌ وَدُرُّ",18,"ر",1,0],["فَقُلنا يا أَبا السَحماءِ إِنّا","وَجَدنا الأَزدَ أَبعَدَ مِن نِزارِ",19,"ر",1,0],["فَقُلنا لَهُ لا تُشمِتَنَّ عَدُوَّنا","وَلا تَنسَ مِن أَصحابِنا مَن نُواصِلُه",20,"ل",2,0],["فَقُلنَ لَهُ نُواعِدُهُ الثُرَيّا","وَذاكَ عَلَيهِ مُرتَفِعُ الزِحامِ",21,"م",1,0],["فَقُلنا يالَ أَشجَعَ لَن تَفوتوا","بِنَهبِكُمُ وَمِرجَلُنا يَفورُ",22,"ر",1,0],["فَقُلنَ عِديهِ دُلجَةَ الرَكبِ إِنَّهُ","سَيَستُرُنا مِن عَينِ أَرضٍ ظَلامُها",23,"م",3,0],["فَقُلنَ أَتَبكي عَينُ مَن لَيسَ موجَعاً","كَئيباً وَمَن هُوَ ساهِرُ اللَيلِ يَأرَقُ",24,"ق",1,0],["فَقُلنَ شَهِدنا أَنَّ ذا لَيسَ كاذِباً","وَلَكِنَّهُ فيما يَقولُ مُصَدَّقُ",24,"ق",1,0],["فَقُلنَ اِسكُتي عَنّا فَغَيرُ مَطاعَةٍ","لَهُ بِكِ مِنّا فَاِعلَمي ذاكَ أَرفَقُ",24,"ق",1,0],["فَقُلنَ لَها لَولا اِرتِقابُ صَحابَةٍ","لَنا خَلفَنا عُجنا وَلَم نَتَوَرَّعِ",25,"ع",1,0],["فَقُلنَ لَها لا شَبَّ قَرنُكِ فَاِفتَحي","لَنا بابَةً تَخفى مِنَ الأَمرِ نَسمَعِ",25,"ع",1,0],["فَقُلنَ حَذارِ العَينَ لَمّا رَأَينَني","لَها إِنَّ هَذا الأَمرُ أَمرٌ سَيُشنَعُ",26,"ع",1,0],["فَقُلنَ لَها لا بَل تَمَنَّيتِ مُنيَةً","خَلَوتِ بِها عِندَ الهَوى وَالتَذَكُّرِ",27,"ر",1,0],["فَقُلنَ لَقَد بَكَيتَ فَقُلتُ كَلّا","وَهَل يَبكي مِنَ الطَرَبِ الجَليدُ",28,"د",1,0],["فَقُلنَ فَما لِدَمعِهِما سَواءٌ","أَكِلتا مُقلَتَيكَ أَصابَ عودُ",28,"د",1,0],["فَقُلنا أَرِحنا هاتِ إِن كُنتَ بائِعاً","فَإِنَّ الدُجى عَن مُلكِهِ سَيَغيبُ",29,"ب",1,0],["فقلنا لها: هاتِيهِ، ما إن لمِثْلِنا","فديناك بالأهْلينَ عن مثل ذا صَبرُ",30,"ر",1,0],["فَقُلنا لِسايِسِهِ ما تَرى","فَأَطلَقَهُ سَلِسَ العُقلَه",31,"ه",1,0],["فَقُلنا عَلى دينِ المَسيحِ بنِ مَريَمٍ","فَأَعرَضَ مُزوَرّاً وَقالَ لَنا هُجرا",32,"ر",2,0],["فَقُلنا لَهُ ما الإِسمُ قالَ سَمَوأَلٌ","عَلى أَنَّني أُكنى بِعَمرٍ وَلا عَمرا",32,"ر",2,0],["فَقُلنا لَهُ عُجباً بِظَرفِ لِسانِهِ","أَجَدتَ أَبا عَمرٍ فَجَوِّد لَنا الخَمرا",32,"ر",2,0],["فَقُلنا لَهُ إِنَّ المُدامَ غِذاؤنا","وَإِنّا أُلو عَقلٍ وَأَهلُ بَصائِرِ",33,"ر",1,0],["فَقُلنا أَنُسقاها عَلى وَجهِ أَهيَفٍ","لَهُ تيهُ مَعشوقٍ وَشَخرَةُ شاطِرِ",33,"ر",1,0],["فَقُلنَ بَكَيتَ قُلتُ لَهُنَّ كَلّا","وَقَد يَبكي مِنَ الشَوقِ الجَليدُ",34,"د",1,0],["فَقُلنا وَكَيفَ أَتاهُ الحِمامُ","عاجَلَهُ بَغتَةً أَم صَبَر",35,"ر",1,0],["فَقُلنا لِهِزبَرِ أَأَنتَ لَيثٌ","فَشَكَّ وَقالَ عَلَيَّ أَو كَأَنّي",36,"ن",2,0],["فَقُلنا لَهُم خَلُّوا طَريقَ نِسائِنا","فَقالُوا لَنا كَلاَّ فَقُلنا لَهُم بَلى",37,"ل",2,0],["فَقُلْنَا سَحَابٌ يَا سَقَى اللَّهُ أَرْضَنَا","بِهِ وَرَوَانَا فَهْوَ بِالنَّاسِ أَرْأَفُ",38,"ف",1,0],["فقلنا أبِنْ رُحْماكَ طارتْ عُقُولُنا","فلم نستَمِعْ من فِيكَ غَيْرَ نَعِيب",39,"ب",1,0],["فقلنا لها ابلغى أمرنا","فقالت مقابركم بابها",40,"ب",3,0],["فقلنا لشخص الى جنبها","فديتك هل أنت بوابها",40,"ب",3,0],["فقلنا ظفرنا اليوم من أجل أحمد","بهذه ونرجو تلك من أجل جده",41,"د",2,0],["فقلنا له أمنا فإنا عصابة","أتينا لتثليث وإن شئت تسديسا",42,"س",2,0],["فَقُلنَا: ألا قَد كانَ صَيْدٌ لِقَانِصٍ،","فخَبّوا عَلَينا كُلَّ ثَوْبٍ مُزَوَّقِ",43,"ق",1,0],["فَقُلْنَ: عِدِيهِ دُلْجَة َ الرَّكْبِ، إنَّهُ","سيسترنا عن عينِ أرضٍ ظلامها",44,"م",3,0],["فَقُلْنَ حِذَاره العَيْنَ لَمَّا رَأَيْنَني","لها، إنّ هذا الأمرَ أمرٌ مشنعُ",45,"ع",1,0],["فَقُلْنَ لَها: لَوْلا کرْتِقَابُ صَحَابَة ٍ","لنا خلفنا، عجنا ولم نتورع",46,"ع",1,0],["فَقُلْنَ لَها: لا شَبَّ قَرْنُكِ فکفْتَحي","لَنا بَابَة ً تَخْفَي مِنَ الأَمْرِ نَسْمَعِ",46,"ع",1,0],["فَقُلْنَ: کسْكُتي عَنَّا، فَغَيْرُ مُطاعَة ٍ","لهوْ بكِ منا، فاعلمي ذاك، أرفق",47,"ق",1,0],["فقلنا يا كبير الفكر مهلا","انجهل من عرفناه صغيرا",48,"ر",2,0],["فَقُلنَ لَها أُمنيَّةٌ أَو مَزَحَةٌ","أَرَدتَ بِها عَيبَ الحَديثِ المُرَجَّمِ",49,"م",1,0],["فَقُلنَ لَها هَذا عِشاءٌ وَأَهلُنا","قَريبٌ أَلَمّا تَسأَمي مَركَبَ البَغلِ",50,"ل",1,0],["فَقُلنَا لاَ تَلمنَا إنَّنَا في","جِوَارِكُم ألَستَ لَهُ بِحَامِ",51,"م",1,0],["فَقُلنَا قَد صَدَقتَ ومَادَرَى مَا","أرَدنَا فَهوَ مِن حُمُرِ المَوَامِى",51,"م",2,0],["فَقُلنا غَمامٌ طَبَّقَ الأَرضَ سَيلُهُ","وَقالَ العِدى لَو كانَ غَيماً تَقَشَّعا",52,"ع",2,0],["فقلنا كذبتم ليس من بعد أحمد","فتى يأخذ الأحكام عن ربنا جلا",53,"ل",2,0],["فقلنا له اخسأ ليس ربك ربنا","ولا ربنا الرب الذي تتنخب",54,"ب",1,0],["فقلنا اخسئوا لا وحي بعد محمد","فيرقبه من بعده المترقب",54,"ب",1,0],["فقلنا لهم فالله عن أن تصدقوا","بآياته أغنى وعن أن تكذبوا",54,"ب",3,0],["فقلنا منصفين سلوا بهذا","رجال العلم تنتقدوا كلامه",55,"م",2,0],["فقلنا إلى أنْ يرجعَ الماء عائداً","ويُنبتَ شَطّاهُ تموتُ ضفادعه",56,"ه",1,0],["فَقُلنا جَميعاً نَحنُ أَصبَرُ مِنكُمُ","وَأَكرَمُ في يَومِ الوَغى وَالتَمارُسِ",57,"س",1,0],["فَقُلنا أَسلِموا إِنّا أَخوكُم","وَقَد بَرَأَت مِنَ الإِحَنِ الصُدورُ",58,"ر",1,0],["فقلنا لها هاتي بها وتَعجَّلي","ولا يك فيما قلتِ خُلْفٌ ولا كِذْب",59,"ب",1,0],["فقلنا لهم بل نجل سيفا محمد","سلسل على الليث والليث كالشبل",60,"ل",1,0],["فقلنَ نراكَ ذا لطفٍ وظرفٍ","فلستَ إذاً غريباً في البلاد",61,"د",1,0],["فقل نسيم الصبا أضحى لقامته","ثانٍ وليس لها في لينها ثانِ",62,"ن",1,0],["فَقُلنا لَها يا نار كوني عَلَيهم","لَظىً وَسَعيراً لا سلامٌ وَلا بَردُ",63,"د",1,0],["فقلن أقيلونا فقلن بنعمةٍ","لدى كل حذرٍ ذي ثقوب مزين",64,"ن",1,0],["فَقُلنَا إِذن لاَ نَنكُلُ الدَّهرَ عنكُمُ","بِصُمِّ القَنَا اللاَّئِي الدِّمَاءَ تُميرُها",65,"ر",3,0],["فقلنا غداةَ استبشر النَّاس كلُّهم","عسى هذه الأَحوال أنْ تتبدَّلا",66,"ل",2,0],["فقلنا قبح المرس","ل من بكم",67,"م",1,0],["فقلنا بل جهلت الاس","م هذي مجمع الشمل",68,"ل",1,0],["فَقُلنا وَلَم نَكذِب بِما قَد بَدا لَنا","وَمَن ذا يَرُدُّ الحَقَّ مِن قَولِ عاذِلِ",69,"ل",1,0],["فقلنا القول مردود","وليس الحق إكراما",70,"م",2,0],["فقلنا الحق سوانا","سنشفي منه أسقاما",70,"م",2,0],["فقلنا وبرهان العناية ظاهرٌ","وسيلتنا للمصطفى صاحب اليد",71,"د",1,0],["فقلنا لهم إبليس أزعج آدماً","وأدمى عليا ذو الصنان ابن ملجم",72,"م",1,0],["فقُلنا سنبقَى هنا صَائِمين","إلى أن يحينَ أوانُ الذهَاب",73,"ب",1,0],["فقُلن وقد أنكرن ما بِيَ مِن ضَنىً","ألا ما ترى ما بين تلك الوسائدِ",74,"د",1,0],["فَقُلنَ لَها صَدَقتِ فَهَل عَطَفتُم","عَلى رَجُلٍ يَهيمُ بِكُم كَئيبِ",75,"ب",1,0],["فقلنا لهم ما رأى المصطفى","رأيناه فلينزجر من يلومْ",76,"م",1,0],["فَقُلْنا لهُ مَنْ يبتغي سكرة بِما","تَبيعُونها مِنه فَقالَ لنَا يشْرِي",77,"ر",2,0],["فَقُلنا لهُ خُذْ إِلَيْكَ وأسْقِنَا","فَمَنْ لام أو يَلْحَى ففي جَانب الصَبرِ",77,"ر",1,0],["فَقُلنَ قَد أَقصَرَ أَو قَد عَوَّدا","عَن وَصلِنا العَجّاجُ أَو تَجَلَّدا",78,"د",2,0],["فقلنا له هذا سلالة ماجد","ونسل ملوكٍ لا تخاف وترهب",79,"ب",1,0],["فَقُلنا عَلَيكُم بِالسُيوفِ فإِنَّها","لِأَفصَحُ مِن أَقلامِنا بِرَنينِها",80,"ن",3,0],["فقلنا والمؤرخ جآءَ يُبدِي","تَدُومُ بحفظِ مضولاكَ الكريمُ",81,"م",1,0],["فقلنا والمؤَرخُ يوماً","تَعيشُ بأَمنِ ربّك يا أَمينُ",82,"ن",1,0],["فقُلنَا والمؤرخ قام يشدو","تُرَافِقك السَّلامةُ يازهيَّه",83,"ه",1,0],["فَقُلَنا وَنَورُ البِشرِ أَزهَرَ بَينَنَا","عَلَى الرَّحبِ وَالإقبَالِ مَشكُورَةَ اَلَيدِ",84,"د",1,0],["فقلنا له من أين جئت مبشرا","سألناك هل يوماً مررت على رَضوى",85,"و",2,0],["فقلنا نُقلّدُ آبَاءَنَا","إذا مَا بَكوا فلها يَنظرونْ",86,"ن",1,0],["فَقُلنَ أَراكَ اللَه إِن كُنتَ كاذِباً","بَنانَكَ مِن يُمنى ذِراعَيكَ أَقطَعا",87,"ع",2,0],["فقلنَ لها اركبي لا تحبسينا","أبت خَفَراً وخالَطَت انبِهارا",88,"ر",2,0],["فقلن إذ أبصرنني بأسما","حين ذوي الأوجه تقطيب",89,"ب",1,0],["فَقُلنا لِلنساء مَقال صدق","تَعالين اِفتخرن عَلى الرجال",90,"ل",1,0],["فقلنَ ارح لا تحبس القوم إنهم","ثووا اشهرا قد طال ما قد ثوى السفرُ",91,"ر",1,0],["فقلنا على النَّشَّاش منا عصابةٌ","كراماً وسمناها الهوانَ فذلَّتِ",92,"ت",1,0],["فقُلنا لهُ أهلاً وسَهلاً ومرحَباً","بخَيرِ كتابٍ جاء من خيرِ كاتِبِ",93,"ب",1,0],["فقلنا للحواضر والبوادي","شهادتكم له باليمن صحت",94,"ت",1,0],["فقلنا رام ذاك بنو نزار","فما كانوا عليه قادرينا",95,"ن",2,0],["فقلنا له خيراً فظن بأنَّنا","نقول له خبزاً فمات من الخوفِ",96,"ف",1,0],["فَقُلنَا عِندَ فَتْحِ الله فَتحٌ","وَقُلنَا السَّعْدُ عِندَ أبي سَعِيدِ",97,"د",1,0],["فَقُلنا بَنو عَمِّ الشَّريفِ مُحَمَّدٍ","سِمامِ العِدى ضَرّاب كُلِّ جَرانِ",98,"ن",1,0],["فَقُلنَ لَها قومي فَديناكِ فاركَبي","فَقالَت أَلا لا غَيرَ أَمّا تَكَلّما",99,"م",2,0],["فَقُلنا أَلا عوجي بِنا أُمَّ طارِقٍ","تُناجي وَنَجواها شَفاءٌ لأَهيَما",99,"م",2,0],["فَقُلنا أَقيموا إِنَّهُ يَومَ مَأقِطٍ","قِسِيٌّ تَبُذُّ المُقرِفينَ مُعَضَّلِ",100,"ل",1,0],["فقلنا وإن تبعد مناسب بيتنا","فإخوة ذي ود، وقربى مواهب",101,"ب",1,0],["فَقلنَ اذ هِمنَ مِمّا قد شُغِفنَ بِهِ","ماذا الفَتى بشراً سبحان مُنشيهِ",102,"ي",2,0],["فقلنا له خفِّضْ سؤالك والتمس","نجاتك من هول البحار الطوامس",103,"س",1,0],["فقلنا روِّقيه لنا","بكلِّ القوت في المحل",104,"ل",1,0],["فَقُلنا هِيَ النُهبى وَحَلَّ حَرامُها","وَكانَت حِمى ما قَبلَنا فَنُبيحُها",105,"ح",3,0],["فقلنا له كيف السبيل وقد غدا","رفيقك قيسياً وأنت يماني",106,"ي",1,0],["فَقُلنا أَدر صَرفَ الغَبوقِ فَإِننا","ثَمِلنا فما الإبرام ندري وَلا النَقضا",107,"ض",2,0],["فقلنا بأوجار الضباع فاكرمت","على البعد مثوانا ولم تتقدم",108,"م",1,0],["فقلن لداتها يا هند غفراً","أمثلك تجهلين له مقاما",109,"م",2,0],["فقلنا وبتنا وذا دأبنا","ولا ثم واش ولا منكر",110,"ر",1,0],["فقلنا في مودتكم أتينا","ولو ترك القطا لغفى وناما",111,"م",2,0],["فقلنا وأفنينا وما كلَّ ما نرى","بكفِّ المذري تأكل الرحيان",112,"ن",1,0],["فَقُلنا لَهُم تِلكُم إِذا بَعد كَرَّة","تُغادِرُ صَرعى نوؤها مُتَخاذِلُ",113,"ل",1,1],["فقلنَ لها أترابُها مُذ رأينَ ما","دهاني منها كي يحُطن بها خُبرا",114,"ر",2,0],["فقلنَ لها ما إن لِداء مُتيَّمٍ","سوى الوصل قالت سوف نسأله العذرا",114,"ر",2,0],["فقلنا أسلموا أو قد طعنا","إليكم فاجهدوا عقد الحبال",115,"ل",1,0],["فَقُلنا يا زِيادُ دَعِ الهوينا","وَشَمِّر لا أَبا لَكَ لِلقِتالِ",116,"ل",1,0],["فَقُلنَ لِلطُيورِ بِالتياعِ","شَن