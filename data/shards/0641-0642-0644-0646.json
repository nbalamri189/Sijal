5",""],[115,"وذي كبر عفناه صغيرا","https://www.aldiwan.net/poem41076.html","عموديه"],[115,"ألا يا لقومي للهوى المتقسم","https://www.aldiwan.net/poem41825.html","الطويل"],[115,"جرى ناصح بالود بيني وبينها","https://www.aldiwan.net/poem42020.html","الطويل"],[132,"بدار محمد أنجاي أنخنا","https://www.aldiwan.net/poem54735.html","الوافر"],[143,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[160,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[160,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[185,"وقالوا يعود الماءُ للنهر بعد ما","https://www.aldiwan.net/poem14752.html","الطويل"],[203,"ولما لقيناهم بهندف جمعهم","https://www.aldiwan.net/poem68160.html","الطويل"],[207,"ألا من مبلغ غيلان عني","https://www.aldiwan.net/poem27961.html","الوافر"],[229,"ولى صاحب لا يمرض العقل جهله","https://www.aldiwan.net/poem51253.html","الطويل"],[261,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[270,"مررن وقد مررن على فؤادي","https://www.aldiwan.net/poem35263.html","الوافر"],[303,"إن كنت تلغز في شيء فإن لمن","https://www.aldiwan.net/poem57871.html","البسيط"],[353,"أيا صبح أفراح الملا عمك السعد","https://www.aldiwan.net/poem40397.html","الطويل"],[396,"أبينت رسم الدار أم لم تُبينِ","https://www.aldiwan.net/poem621.html",""],[412,"عاود عيني نصبها وغروره","https://www.aldiwan.net/poem39.html","الطويل"],[416,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[443,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[443,"جرت في ذلك السهل","https://www.aldiwan.net/poem56029.html","عموديه"],[470,"وما الشعر إلا خطبة من مؤلف","https://www.aldiwan.net/poem4802.html","الطويل"],[479,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[500,"يقولون فيمن تقتدون بنهجكم","https://www.aldiwan.net/poem37648.html","الطويل"],[500,"يقولون قد آذى لئيم مبرءا","https://www.aldiwan.net/poem37651.html","الطويل"],[538,"حججنا لعمري ابتغاء الثواب","https://www.aldiwan.net/poem48287.html","عموديه"],[551,"ومنتقبات بالجمال أتيننا","https://www.aldiwan.net/poem47839.html","الطويل"],[553,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[558,"تقول الأجانب عن علمنا","https://www.aldiwan.net/poem34083.html","المتقارب"],[559,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[561,"ما للغواني معرضات صددا","https://www.aldiwan.net/poem27850.html","الرجز"],[587,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["فَقُلْنَ لَهَا مِنْ أَينَ أَوْضَحَ ذا الفَتى","وَمَنْشَؤُهُ غَوْرا تِهامَةَ أَوْ نَجْدُ",0,"د",1,0],["فقُلْنَ إذ أبْصَرْنَني باسِماً","حينَ زَوى الأوْجُهَ تَقْطيبُ",1,"ب",1,0],["فقُلْنا هَواءُ الشّامِ غالَ نُفوسَنا","فهَلْ لكَ في شيءٍ يُنَفِّسُ تَنْفِيسا",2,"س",2,0],["فقُلْنا دعِ الإنْكارَ إنّا عِصابَةٌ","يُطيعُونَ فيما تشْتَهي النّفْسُ إبْلِيسا",2,"س",2,0],["فقُلْنا ظَفِرْنا اليوْمَ منْ أجْلِ أحْمَدٍ","بِهَذي ونرْجو تلْكَ منْ أجْلِ جَدِّهِ",3,"د",2,0],["فقُلْنا إنْ يَكُنْ بَشَراً سَوِيّاً","فَفيهِ غَريزَةٌ منْ عَنْكَبوتِ",4,"ت",1,0],["فَقُلنا رَكَضتُم وَلَم تُرمِلوا","وَأَصدَرتُمُ قَبلَ أَن تُورِدوا",5,"د",3,0],["فَقُلنا لَهُ هَذِهِ هاتِها","بِأَدماءَ في حَبلِ مُقتادِها",6,"د",3,0],["فَقُلنا عَلى الهوجِ المَراسيلِ وَاِرتَمَت","بِهِنَّ الصَحارى وَالصِمادُ الصَحاصِحُ",7,"ح",1,0],["فَقُلنا أَلا قَد كانَ صَيدٌ لِقانِصٍ","فَخِبّوا عَلَينا كُلَّ بَيتٍ مُزَوَّقِ",8,"ق",1,0],["فقلنا وهي تخطر في وقار","مليك الحسن يخطر في البلاط",9,"ط",1,0],["فقلنا لهم إنا أحقّ بمُلكها","فقالوا ولكن زند قُوّتنا أورى",10,"ر",2,0],["فَقُلنا لَهُ إِذ قالَ ما قالَ مَرحَباً","أَمَرتَ بِمَعروفٍ وَأَوصَيتَ كافِيا",11,"ي",2,0],["فَقُلنا لَهُ جِدُّ اِبنُ قَيسٍ عَلى الَذي","نُبَخِّلُهُ فينا وَإِن نالَ سُؤدَدا",12,"د",2,0],["فَقُلنا أَلا قَد كانَ صَيدٌ لِقانِصٍ","فَخَبّوا عَلَينا فَضلَ بُردٍ مُطَنَّبِ",13,"ب",1,0],["فَقُل ناشِداً بَيتاً وَمَن ذاقَ مِثلَهُ","لَدى جيرَةٍ لَم يَدرِ كَيفَ اِحتِيالُهُ",14,"ل",2,0],["فَقُلنا لَهُم إِن تَمنَعونا بِلادَكُم","نَجِد مَذهَباً في سائِرِ الأَرضِ واسِعا",15,"ع",2,0],["فَقُلنا ما قَضَيتَ بِهِ رَضينا","وَأَنتَ بِما قَضَيتَ بِهِ كَفيلُ",16,"ل",1,0],["فَقُلنا سُلَيمانُ لَو لَم يَمُت","وَفِرعَونُ لَو حَمَلَتهُ الشُهُب",17,"ب",1,0],["فَقُلنا الشَمسُ فيها أَم نُضارُ","وَياقوتٌ وَمُرجانٌ وَدُرُّ",18,"ر",1,0],["فَقُلنا يا أَبا السَحماءِ إِنّا","وَجَدنا الأَزدَ أَبعَدَ مِن نِزارِ",19,"ر",1,0],["فَقُلنا لَهُ لا تُشمِتَنَّ عَدُوَّنا","وَلا تَنسَ مِن أَصحابِنا مَن نُواصِلُه",20,"ل",2,0],["فَقُلنَ لَهُ نُواعِدُهُ الثُرَيّا","وَذاكَ عَلَيهِ مُرتَفِعُ الزِحامِ",21,"م",1,0],["فَقُلنا يالَ أَشجَعَ لَن تَفوتوا","بِنَهبِكُمُ وَمِرجَلُنا يَفورُ",22,"ر",1,0],["فَقُلنَ عِديهِ دُلجَةَ الرَكبِ إِنَّهُ","سَيَستُرُنا مِن عَينِ أَرضٍ ظَلامُها",23,"م",3,0],["فَقُلنَ أَتَبكي عَينُ مَن لَيسَ موجَعاً","كَئيباً وَمَن هُوَ ساهِرُ اللَيلِ يَأرَقُ",24,"ق",1,0],["فَقُلنَ شَهِدنا أَنَّ ذا لَيسَ كاذِباً","وَلَكِنَّهُ فيما يَقولُ مُصَدَّقُ",24,"ق",1,0],["فَقُلنَ اِسكُتي عَنّا فَغَيرُ مَطاعَةٍ","لَهُ بِكِ مِنّا فَاِعلَمي ذاكَ أَرفَقُ",24,"ق",1,0],["فَقُلنَ لَها لَولا اِرتِقابُ صَحابَةٍ","لَنا خَلفَنا عُجنا وَلَم نَتَوَرَّعِ",25,"ع",1,0],["فَقُلنَ لَها لا شَبَّ قَرنُكِ فَاِفتَحي","لَنا بابَةً تَخفى مِنَ الأَمرِ نَسمَعِ",25,"ع",1,0],["فَقُلنَ حَذارِ العَينَ لَمّا رَأَينَني","لَها إِنَّ هَذا الأَمرُ أَمرٌ سَيُشنَعُ",26,"ع",1,0],["فَقُلنَ لَها لا بَل تَمَنَّيتِ مُنيَةً","خَلَوتِ بِها عِندَ الهَوى وَالتَذَكُّرِ",27,"ر",1,0],["فَقُلنَ لَقَد بَكَيتَ فَقُلتُ كَلّا","وَهَل يَبكي مِنَ الطَرَبِ الجَليدُ",28,"د",1,0],["فَقُلنَ فَما لِدَمعِهِما سَواءٌ","أَكِلتا مُقلَتَيكَ أَصابَ عودُ",28,"د",1,0],["فَقُلنا أَرِحنا هاتِ إِن كُنتَ بائِعاً","فَإِنَّ الدُجى عَن مُلكِهِ سَيَغيبُ",29,"ب",1,0],["فقلنا لها: هاتِيهِ، ما إن لمِثْلِنا","فديناك بالأهْلينَ عن مثل ذا صَبرُ",30,"ر",1,0],["فَقُلنا لِسايِسِهِ ما تَرى","فَأَطلَقَهُ سَلِسَ العُقلَه",31,"ه",1,0],["فَقُلنا عَلى دينِ المَسيحِ بنِ مَريَمٍ","فَأَعرَضَ مُزوَرّاً وَقالَ لَنا هُجرا",32,"ر",2,0],["فَقُلنا لَهُ ما الإِسمُ قالَ سَمَوأَلٌ","عَلى أَنَّني أُكنى بِعَمرٍ وَلا عَمرا",32,"ر",2,0],["فَقُلنا لَهُ عُجباً بِظَرفِ لِسانِهِ","أَجَدتَ أَبا عَمرٍ فَجَوِّد لَنا الخَمرا",32,"ر",2,0],["فَقُلنا لَهُ إِنَّ المُدامَ غِذاؤنا","وَإِنّا أُلو عَقلٍ وَأَهلُ بَصائِرِ",33,"ر",1,0],["فَقُلنا أَنُسقاها عَلى وَجهِ أَهيَفٍ","لَهُ تيهُ مَعشوقٍ وَشَخرَةُ شاطِرِ",33,"ر",1,0],["فَقُلنَ بَكَيتَ قُلتُ لَهُنَّ كَلّا","وَقَد يَبكي مِنَ الشَوقِ الجَليدُ",34,"د",1,0],["فَقُلنا وَكَيفَ أَتاهُ الحِمامُ","عاجَلَهُ بَغتَةً أَم صَبَر",35,"ر",1,0],["فَقُلنا لِهِزبَرِ أَأَنتَ لَيثٌ","فَشَكَّ وَقالَ عَلَيَّ أَو كَأَنّي",36,"ي",1,0],["فَقُلنا لَهُم خَلُّوا طَريقَ نِسائِنا","فَقالُوا لَنا كَلاَّ فَقُلنا لَهُم بَلى",37,"ل",2,0],["فَقُلْنَا سَحَابٌ يَا سَقَى اللَّهُ أَرْضَنَا","بِهِ وَرَوَانَا فَهْوَ بِالنَّاسِ أَرْأَفُ",38,"ف",1,0],["فقلنا أبِنْ رُحْماكَ طارتْ عُقُولُنا","فلم نستَمِعْ من فِيكَ غَيْرَ نَعِيب",39,"ب",1,0],["فقلنا ظفرنا اليوم من أجل أحمد","بهذه ونرجو تلك من أجل جده",40,"د",2,0],["فقلنا له أمنا فإنا عصابة","أتينا لتثليث وإن شئت تسديسا",41,"س",2,0],["فَقُلنَا: ألا قَد كانَ صَيْدٌ لِقَانِصٍ،","فخَبّوا عَلَينا كُلَّ ثَوْبٍ مُزَوَّقِ",42,"ق",1,0],["فَقُلْنَ: عِدِيهِ دُلْجَة َ الرَّكْبِ، إنَّهُ","سيسترنا عن عينِ أرضٍ ظلامها",43,"م",3,0],["فَقُلْنَ حِذَاره العَيْنَ لَمَّا رَأَيْنَني","لها، إنّ هذا الأمرَ أمرٌ مشنعُ",44,"ع",1,0],["فَقُلْنَ لَها: لَوْلا کرْتِقَابُ صَحَابَة ٍ","لنا خلفنا، عجنا ولم نتورع",45,"ع",1,0],["فَقُلْنَ لَها: لا شَبَّ قَرْنُكِ فکفْتَحي","لَنا بَابَة ً تَخْفَي مِنَ الأَمْرِ نَسْمَعِ",45,"ع",1,0],["فَقُلْنَ: کسْكُتي عَنَّا، فَغَيْرُ مُطاعَة ٍ","لهوْ بكِ منا، فاعلمي ذاك، أرفق",46,"ق",1,0],["فقلنا يا كبير الفكر مهلا","انجهل من عرفناه صغيرا",47,"ر",2,0],["فَقُلنَ لَها أُمنيَّةٌ أَو مَزَحَةٌ","أَرَدتَ بِها عَيبَ الحَديثِ المُرَجَّمِ",48,"م",1,0],["فَقُلنَ لَها هَذا عِشاءٌ وَأَهلُنا","قَريبٌ أَلَمّا تَسأَمي مَركَبَ البَغلِ",49,"ل",1,0],["فَقُلنَا لاَ تَلمنَا إنَّنَا في","جِوَارِكُم ألَستَ لَهُ بِحَامِ",50,"م",1,0],["فَقُلنَا قَد صَدَقتَ ومَادَرَى مَا","أرَدنَا فَهوَ مِن حُمُرِ المَوَامِى",50,"م",2,0],["فَقُلنا غَمامٌ طَبَّقَ الأَرضَ سَيلُهُ","وَقالَ العِدى لَو كانَ غَيماً تَقَشَّعا",51,"ع",2,0],["فقلنا كذبتم ليس من بعد أحمد","فتى يأخذ الأحكام عن ربنا جلا",52,"ل",2,0],["فقلنا له اخسأ ليس ربك ربنا","ولا ربنا الرب الذي تتنخب",53,"ب",1,0],["فقلنا اخسئوا لا وحي بعد محمد","فيرقبه من بعده المترقب",53,"ب",1,0],["فقلنا لهم فالله عن أن تصدقوا","بآياته أغنى وعن أن تكذبوا",53,"ب",3,0],["فقلنا منصفين سلوا بهذا","رجال العلم تنتقدوا كلامه",54,"م",2,0],["فقلنا إلى أنْ يرجعَ الماء عائداً","ويُنبتَ شَطّاهُ تموتُ ضفادعه",55,"ه",1,0],["فَقُلنا جَميعاً نَحنُ أَصبَرُ مِنكُمُ","وَأَكرَمُ في يَومِ الوَغى وَالتَمارُسِ",56,"س",1,0],["فَقُلنا أَسلِموا إِنّا أَخوكُم","وَقَد بَرَأَت مِنَ الإِحَنِ الصُدورُ",57,"ر",1,0],["فقلنا لها هاتي بها وتَعجَّلي","ولا يك فيما قلتِ خُلْفٌ ولا كِذْب",58,"ب",1,0],["فقلنا لهم بل نجل سيفا محمد","سلسل على الليث والليث كالشبل",59,"ل",1,0],["فقلنَ نراكَ ذا لطفٍ وظرفٍ","فلستَ إذاً غريباً في البلاد",60,"د",1,0],["فقل نسيم الصبا أضحى لقامته","ثانٍ وليس لها في لينها ثانِ",61,"ن",1,0],["فَقُلنا لَها يا نار كوني عَلَيهم","لَظىً وَسَعيراً لا سلامٌ وَلا بَردُ",62,"د",1,0],["فقلن أقيلونا فقلن بنعمةٍ","لدى كل حذرٍ ذي ثقوب مزين",63,"ن",1,0],["فَقُلنَا إِذن لاَ نَنكُلُ الدَّهرَ عنكُمُ","بِصُمِّ القَنَا اللاَّئِي الدِّمَاءَ تُميرُها",64,"ر",3,0],["فقلنا غداةَ استبشر النَّاس كلُّهم","عسى هذه الأَحوال أنْ تتبدَّلا",65,"ل",2,0],["فقلنا قبح المرس","ل من بكم",66,"م",1,0],["فقلنا بل جهلت الاس","م هذي مجمع الشمل",67,"ل",1,0],["فَقُلنا وَلَم نَكذِب بِما قَد بَدا لَنا","وَمَن ذا يَرُدُّ الحَقَّ مِن قَولِ عاذِلِ",68,"ل",1,0],["فقلنا القول مردود","وليس الحق إكراما",69,"م",2,0],["فقلنا الحق سوانا","سنشفي منه أسقاما",69,"م",2,0],["فقلنا وبرهان العناية ظاهرٌ","وسيلتنا للمصطفى صاحب اليد",70,"د",1,0],["فقلنا لهم إبليس أزعج آدماً","وأدمى عليا ذو الصنان ابن ملجم",71,"م",1,0],["فقُلنا سنبقَى هنا صَائِمين","إلى أن يحينَ أوانُ الذهَاب",72,"ب",1,0],["فقُلن وقد أنكرن ما بِيَ مِن ضَنىً","ألا ما ترى ما بين تلك الوسائدِ",73,"د",1,0],["فَقُلنَ لَها صَدَقتِ فَهَل عَطَفتُم","عَلى رَجُلٍ يَهيمُ بِكُم كَئيبِ",74,"ب",1,0],["فقلنا لهم ما رأى المصطفى","رأيناه فلينزجر من يلومْ",75,"م",1,0],["فَقُلْنا لهُ مَنْ يبتغي سكرة بِما","تَبيعُونها مِنه فَقالَ لنَا يشْرِي",76,"ر",2,0],["فَقُلنا لهُ خُذْ إِلَيْكَ وأسْقِنَا","فَمَنْ لام أو يَلْحَى ففي جَانب الصَبرِ",76,"ر",1,0],["فَقُلنَ قَد أَقصَرَ أَو قَد عَوَّدا","عَن وَصلِنا العَجّاجُ أَو تَجَلَّدا",77,"د",2,0],["فقلنا له هذا سلالة ماجد","ونسل ملوكٍ لا تخاف وترهب",78,"ب",1,0]]}