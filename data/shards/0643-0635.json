{"poems":[[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[10,"بكت عيني وعاودت السهودا","https://www.aldiwan.net/poem21069.html","الوافر"],[10,"ألا أيها الديك المنادي بسحرة","https://www.aldiwan.net/poem21142.html","الطويل"],[27,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[27,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[51,"ألم تر أنني قبل الأهاجي","https://www.aldiwan.net/poem8528.html","الوافر"],[51,"لأبي بكر كلام واحد لا يتعدى","https://www.aldiwan.net/poem11466.html","مجزوء الرمل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[56,"أساكن حفرة وقرار لحد","https://www.aldiwan.net/poem58603.html","الطويل"],[43,"كفي أراني ويك لومك ألوما","https://www.aldiwan.net/poem10530.html","الكامل"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[46,"ما لي غدوت كقاف رؤبة قيدت","https://www.aldiwan.net/poem22007.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21006","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54947","الوافر"],[115,"سلوك طريق الرجال الأدب","https://www.aldiwan.net/poem41739.html","المتقارب"],[127,"تطاول همه ببراق سعر","https://www.aldiwan.net/poem24272.html","الوافر"],[142,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[143,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[150,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[155,"طالعتني كطلوع البدر","https://www.aldiwan.net/poem55735.html","مجزوء الرمل"],[157,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[160,"إليك فلو أدركت مغنى الهوى مغنا","https://www.aldiwan.net/poem59014.html","الطويل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[270,"هزئتم بنفس تجهلون خلالها","https://www.aldiwan.net/poem35616.html","الطويل"],[305,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[364,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[377,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[416,"أقول لصاحبي ورضيع كأسي","https://www.aldiwan.net/poem54079.html","الوافر"],[439,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[453,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[458,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[458,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[458,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[461,"نوال أمير المؤمنين وسيبه","https://www.aldiwan.net/poem16117.html","الطويل"],[461,"ليهن الرعايا والمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[464,"هذا العقيق تلك أعلام الحمى","https://www.aldiwan.net/poem3211.html","عموديه"],[464,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[464,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[464,"رحلوا فشموسهم تجب","https://www.aldiwan.net/poem3622.html","عموديه"],[495,"كصدغه إذ تعقرب","https://www.aldiwan.net/poem9772.html","المجتث"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"]],"verses":[["كَصَدعِ الزُجاجَةِ ما تَستَطي","عُ كَفُّ الصَناعِ لَها أَن تُحيرا",0,"ر",2,0],["كَصَدعِ الزُجاجَةِ ما يَستَطي","عُ مَن كانَ يَشعَبُ تَجبارَها",1,"ر",3,0],["كَصَدرِ السَيفِ أَخلَصَهُ صِقالٌ","إِذا ما هُزَّ مَشهوراً حُساما",2,"م",2,0],["كَصَخرٍ أَو مُعاوِيَةَ بنِ عَمروٍ","إِذا كانَت وُجوهُ القَومِ سودا",3,"د",2,0],["كَصَخرِ اِبنِ عَمرٍ خَيرِ مَن قَد عَلِمتُهُ","وَكَيفَ أُرَجّي العَيشَ ضَلَّ ضَلالِيا",4,"ي",2,0],["كَصاحِبِ المَوجِ إِذ مالَت سَفينَتُهُ","يَدعو إِلى اللَهِ إِسراراً وَإِعلانا",5,"ن",2,0],["كَصادٍ ظَلَّ مُحتَمّاً لِشُربٍ","فَلابَ عَلى شَرائِعِهِ وَحاما",6,"م",2,0],["كصاعقةٍ أتتْ في إثر غيثٍ","وضِحْكِ البيضِ تُتْبِعُهُ نحيبا",7,"ب",2,0],["كصبيِّ السوء يَلقَى","منه من قاساه جَهْدا",8,"د",2,0],["كصاحب البذر لا يريد به","شيئاً سوى رَيْعه إذا بَذَره",9,"ر",2,0],["كَصَيّادِ الطُّيورِ لهُ انْتِحابٌ","عليها وهوَ يَذْبَحُها بِحَد",10,"د",1,0],["كَصِفاتِ أَوحَدِنا أَبي الفَضلِ الَّتي","بَهَرَت فَأَنطَقَ واصِفيهِ وَأَفحَما",11,"م",2,0],["كَصغارِ الهاءاتِ شُقّتْ فأَبدتْ","شكلها من صُفوفِ جيشٍ سطورُ",12,"ر",1,0],["كَصَادِرِ رَكبٍ عَنكَ لاَقَاهُ وَارِدٌ","فَرَغَّبَ فِيكَ الآخِرِينَ الأَوَائِلُ",13,"ل",1,0],["كَصِياحِ نوتِيٍّ يَظَلُّ عَلى ذُرى","قَيدومِ قَرواءِ السَراةِ يُنَدِّدُ",14,"د",1,0],["كَصَحيحَةِ الأَوزانِ زادَتها القُوى","حَرفاً فَبانَ لِسامِعٍ نَكراؤُها",15,"ا",3,0],["كَصَانِعَةِ القَزِّ الَّتي كُلَّما ارتَدَت","بِصنعَتِها كانَت إلَى اللَّبثِ أَقرَبُ",16,"ب",1,0],["كصَفْوِ النَّفْسِ بَعْدَ الخطْبِ","أَعْقَبَ حُزْنُهَا الذِّكْرى",17,"ر",2,0],["كصاعد سطح بلا سلم","وطالب علم بقطع الحطب",18,"ب",1,0],["كَصَخرٍ لِلسَرِيَّةِ غادَروهُ","بِذَروةَ أَو مُعاوِيَةَ بنِ عَمرِو",19,"ر",2,0],["كصَفاةِ المسيلِ لا ترهَبُ اللي","ثَّ ولا ترحم الغزالَ الأغنَّا",20,"ن",2,0],["كَصَوبِ حَياً عَمَّ البِلادَ بِغَيثِهِ","فَفازَت بِأَقصى رَيِّها وَهوَ مُمطِرُ",21,"ر",1,0],["كَصَيِّبِ مُزنٍ أَخضَلَ الأَرضَ وَدقُهُ","فَلا مِقَولٌ يَشكو وَلا مُقلَةٌ تَبكي",22,"ي",1,0],["كَصَباحٍ تَحْتَ لَيْلٍ","وَدَعَتْني لاصْطِباحِ",23,"ح",1,0],["كَصَوْمِ دَهْرٍ كَامِلٍ","زَكَاةُ نَفْسٍ طُهِّرَتْ",24,"ت",1,0],["كصاحب نعمان ملكت بلاده","وأبدلته بالسيف من حصنه سجنا",25,"ن",2,0],["كَصَحيفَةٍ دَرَسَ الَّذي قَد أودعت","مِن جورِها ضَربٌ مِنَ الدّيدانِ",26,"ن",1,0],["كصاعقةٍ نَفسي فخافوا انقِضاضَها","وقُولوا بيأسٍ ما أعزَّ منالها",27,"ل",3,0],["كَصيانةِ الأعراضِ عمّا شانَ وال","ألباب والأنساب والأبدانِ",28,"ن",1,0],["كصَعْدةٍ في حَشا الظَّلْمَاءِ طاعنةٍ","تَسْقى أسافِلَها رِيّاً أعاليها",29,"ي",3,0],["كصواعقٍ تنقض ترجم نفسَه","حتى يعود ممزَّقاً بشقائه",30,"ا",3,0],["كصبغ الشيب ينصلُ بعد يومٍ","ولم يَبْعُدْ مداه عن الظهور",31,"ر",1,0],["كَصَوْبِ خوافِقِهِ فِي الحَبيكِ","وصَوتِ مَغافِرِهِ فِي الدُّروعِ",32,"ع",1,0],["كصغير نازح عن أمه","ليس ينسيه سواها دنفه",33,"ف",2,0],["كصلِّ الحَمَاطة يطوي الحِما","مَ صعبا ويُعطيك باللمس هُونا",34,"ن",2,0],["كصبح حين صبَّح أمسِ عيني","أراني كيف أغتبقُ العويلا",35,"ل",2,0],["كصاحب البلدة القَواء أخو","ه الذئب فيها وجارهُ السَّبُعُ",36,"ع",1,0],["كصوب حَياً ألقى بَعاعاً بحُرَّةٍ","فطاب ثَرىً زاكٍ وطابَ غَمامُ",37,"م",1,0],["كصوب الحَيا السَّحَّاح سيَّان عنده","سِباخٌ وحُرٌّ فهو للكُلِّ ماطِرُ",38,"ر",1,0],["كصفات سعد الدين في قصاده","والوفد جاد كعاده وتبسما",39,"م",2,0],["كصفح الحسام العضب ينهلُّ ماؤهُ","وفي شفرتيه للمضاءِ ضرامُ",40,"م",1,0],["كصفات الملك المؤيّد يهمي","باسمَ الوجه في وجوه الوفد",41,"د",1,0],["كصلاح الدين الناصر يو","سف جاد فليس له نشب",42,"ب",1,0],["كصدغه إذ تعقرب","وقده إذ تنصب",43,"ب",1,1],["كصادٍ يطلبُ الماءَ ببيدٍ","بها الماءُ بجوفِ الأرْضِ غائِرْ",44,"ر",1,0],["كَصلالِ الرِّمالِ أَو كَذئابِ ال","قاعِ رُقشاً هَبَبْنَ بعد رُكودِ",45,"د",1,0]]}