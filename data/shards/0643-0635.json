{"poems":[[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[10,"بكت عيني وعاودت السهودا","https://www.aldiwan.net/poem21069.html","الوافر"],[10,"ألا أيها الديك المنادي بسحرة","https://www.aldiwan.net/poem21142.html","الطويل"],[27,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[27,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[51,"ألم تر أنني قبل الأهاجي","https://www.aldiwan.net/poem8528.html","الوافر"],[51,"لأبي بكر كلام واحد لا يتعدى","https://www.aldiwan.net/poem11466.html","مجزوء الرمل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[56,"أساكن حفرة وقرار لحد","https://www.aldiwan.net/poem58603.html","الطويل"],[43,"كفي أراني ويك لومك ألوما","https://www.aldiwan.net/poem10530.html","الكامل"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[46,"ما لي غدوت كقاف رؤبة قيدت","https://www.aldiwan.net/poem22007.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21006","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54947","الوافر"]],"verses":[["كَصَدعِ الزُجاجَةِ ما تَستَطي","عُ كَفُّ الصَناعِ لَها أَن تُحيرا",0,"ر",2,0],["كَصَدعِ الزُجاجَةِ ما يَستَطي","عُ مَن كانَ يَشعَبُ تَجبارَها",1,"ر",3,0],["كَصَدرِ السَيفِ أَخلَصَهُ صِقالٌ","إِذا ما هُزَّ مَشهوراً حُساما",2,"م",2,0],["كَصَخرٍ أَو مُعاوِيَةَ بنِ عَمروٍ","إِذا كانَت وُجوهُ القَومِ سودا",3,"د",2,0],["كَصَخرِ اِبنِ عَمرٍ خَيرِ مَن قَد عَلِمتُهُ","وَكَيفَ أُرَجّي العَيشَ ضَلَّ ضَلالِيا",4,"ي",2,0],["كَصاحِبِ المَوجِ إِذ مالَت سَفينَتُهُ","يَدعو إِلى اللَهِ إِسراراً وَإِعلانا",5,"ن",2,0],["كَصادٍ ظَلَّ مُحتَمّاً لِشُربٍ","فَلابَ عَلى شَرائِعِهِ وَحاما",6,"م",2,0],["كصاعقةٍ أتتْ في إثر غيثٍ","وضِحْكِ البيضِ تُتْبِعُهُ نحيبا",7,"ب",2,0],["كصبيِّ السوء يَلقَى","منه من قاساه جَهْدا",8,"د",2,0],["كصاحب البذر لا يريد به","شيئاً سوى رَيْعه إذا بَذَره",9,"ر",2,0],["كَصَيّادِ الطُّيورِ لهُ انْتِحابٌ","عليها وهوَ يَذْبَحُها بِحَد",10,"د",1,0],["كَصِفاتِ أَوحَدِنا أَبي الفَضلِ الَّتي","بَهَرَت فَأَنطَقَ واصِفيهِ وَأَفحَما",11,"م",2,0],["كَصغارِ الهاءاتِ شُقّتْ فأَبدتْ","شكلها من صُفوفِ جيشٍ سطورُ",12,"ر",1,0],["كَصَادِرِ رَكبٍ عَنكَ لاَقَاهُ وَارِدٌ","فَرَغَّبَ فِيكَ الآخِرِينَ الأَوَائِلُ",13,"ل",1,0],["كَصِياحِ نوتِيٍّ يَظَلُّ عَلى ذُرى","قَيدومِ قَرواءِ السَراةِ يُنَدِّدُ",14,"د",1,0],["كَصَحيحَةِ الأَوزانِ زادَتها القُوى","حَرفاً فَبانَ لِسامِعٍ نَكراؤُها",15,"ا",3,0],["كَصَانِعَةِ القَزِّ الَّتي كُلَّما ارتَدَت","بِصنعَتِها كانَت إلَى اللَّبثِ أَقرَبُ",16,"ب",1,0],["كصَفْوِ النَّفْسِ بَعْدَ الخطْبِ","أَعْقَبَ حُزْنُهَا الذِّكْرى",17,"ر",2,0]]}