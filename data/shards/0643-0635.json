abudhabi.ae/diwan/poem/141235","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77054","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45039","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28661","الطويل"],[4755,"عَلى الرِّيحِ.. لا أَدري إلى أَينَ","https://www.poetsgate.com/ViewPoem.aspx?id=183532",""],[4940,"سهام الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=210455",""],[5038,"الارض دامية","https://www.poetsgate.com/ViewPoem.aspx?id=189937",""],[5111,"سَفَرُ الْهَزِيعِ","https://www.poetsgate.com/ViewPoem.aspx?id=212112",""],[500,"كصدغة إذا تعقرب","https://www.poetsgate.com/ViewPoem.aspx?id=4183",""],[5186,"حسبك الجهد بذله لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=156491",""],[5268,"أميم","https://www.poetsgate.com/ViewPoem.aspx?id=207019",""],[5273,"اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=178281",""],[5277,"الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=184871",""],[5281,"احتراقُ الفَراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199734",""],[5409,"طر في جناحك وحده","https://www.poetsgate.com/ViewPoem.aspx?id=155426",""],[5431,"لتعدمه الشفاه بلا رصاص...","https://www.poetsgate.com/ViewPoem.aspx?id=201132",""],[5561,"رحيلُ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=192742",""],[5720,"خيرُ خلقِ اللهﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=201895",""],[5725,"وليل يكيل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=179909",""],[5736,"بلا عناق","https://www.poetsgate.com/ViewPoem.aspx?id=208856",""],[5937,"الأوركيديّة","https://www.poetsgate.com/ViewPoem.aspx?id=211800",""],[5943,"كصبح العيد ياأدباء إنَّا","https://www.poetsgate.com/ViewPoem.aspx?id=37258",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[5977,"تساؤلات","https://www.poetsgate.com/ViewPoem.aspx?id=212742",""],[6134,"أفديه لا أفدي سواه جميلاً","https://www.poetsgate.com/ViewPoem.aspx?id=169522",""],[6330,"كلماتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64211&r=&rc=19",""]],"verses":[["كصحراهم من الخيرات خِلوٌ","غلاظٌ كالصخور من الجبال",0,"ل",1,0],["كَصَدعِ الزُجاجَةِ ما تَستَطي","عُ كَفُّ الصَناعِ لَها أَن تُحيرا",1,"ر",2,0],["كَصَدعِ الزُجاجَةِ ما يَستَطي","عُ مَن كانَ يَشعَبُ تَجبارَها",2,"ر",3,0],["كَصَدرِ السَيفِ أَخلَصَهُ صِقالٌ","إِذا ما هُزَّ مَشهوراً حُساما",3,"م",2,0],["كَصَخرٍ أَو مُعاوِيَةَ بنِ عَمروٍ","إِذا كانَت وُجوهُ القَومِ سودا",4,"د",2,0],["كَصَخرِ اِبنِ عَمرٍ خَيرِ مَن قَد عَلِمتُهُ","وَكَيفَ أُرَجّي العَيشَ ضَلَّ ضَلالِيا",5,"ي",2,0],["كَصاحِبِ المَوجِ إِذ مالَت سَفينَتُهُ","يَدعو إِلى اللَهِ إِسراراً وَإِعلانا",6,"ن",2,0],["كَصادٍ ظَلَّ مُحتَمّاً لِشُربٍ","فَلابَ عَلى شَرائِعِهِ وَحاما",7,"م",2,0],["كصاعقةٍ أتتْ في إثر غيثٍ","وضِحْكِ البيضِ تُتْبِعُهُ نحيبا",8,"ب",2,0],["كصبيِّ السوء يَلقَى","منه من قاساه جَهْدا",9,"د",2,0],["كصاحب البذر لا يريد به","شيئاً سوى رَيْعه إذا بَذَره",10,"ر",2,0],["كَصَيّادِ الطُّيورِ لهُ انْتِحابٌ","عليها وهوَ يَذْبَحُها بِحَد",11,"د",1,0],["كَصِفاتِ أَوحَدِنا أَبي الفَضلِ الَّتي","بَهَرَت فَأَنطَقَ واصِفيهِ وَأَفحَما",12,"م",2,0],["كَصغارِ الهاءاتِ شُقّتْ فأَبدتْ","شكلها من صُفوفِ جيشٍ سطورُ",13,"ر",1,0],["كَصَادِرِ رَكبٍ عَنكَ لاَقَاهُ وَارِدٌ","فَرَغَّبَ فِيكَ الآخِرِينَ الأَوَائِلُ",14,"ل",1,0],["كَصِياحِ نوتِيٍّ يَظَلُّ عَلى ذُرى","قَيدومِ قَرواءِ السَراةِ يُنَدِّدُ",15,"د",1,0],["كَصَحيحَةِ الأَوزانِ زادَتها القُوى","حَرفاً فَبانَ لِسامِعٍ نَكراؤُها",16,"ا",3,0],["كَصَانِعَةِ القَزِّ الَّتي كُلَّما ارتَدَت","بِصنعَتِها كانَت إلَى اللَّبثِ أَقرَبُ",17,"ب",1,0],["كصَفْوِ النَّفْسِ بَعْدَ الخطْبِ","أَعْقَبَ حُزْنُهَا الذِّكْرى",18,"ر",2,0],["كصاعد سطح بلا سلم","وطالب علم بقطع الحطب",19,"ب",1,0],["كَصَخرٍ لِلسَرِيَّةِ غادَروهُ","بِذَروةَ أَو مُعاوِيَةَ بنِ عَمرِو",20,"ر",2,0],["كصَفاةِ المسيلِ لا ترهَبُ اللي","ثَّ ولا ترحم الغزالَ الأغنَّا",21,"ن",2,0],["كَصَوبِ حَياً عَمَّ البِلادَ بِغَيثِهِ","فَفازَت بِأَقصى رَيِّها وَهوَ مُمطِرُ",22,"ر",1,0],["كَصَيِّبِ مُزنٍ أَخضَلَ الأَرضَ وَدقُهُ","فَلا مِقَولٌ يَشكو وَلا مُقلَةٌ تَبكي",23,"ي",1,0],["كَصَباحٍ تَحْتَ لَيْلٍ","وَدَعَتْني لاصْطِباحِ",24,"ح",1,0],["كَصَوْمِ دَهْرٍ كَامِلٍ","زَكَاةُ نَفْسٍ طُهِّرَتْ",25,"ت",1,0],["كصاحب نعمان ملكت بلاده","وأبدلته بالسيف من حصنه سجنا",26,"ن",2,0],["كَصَحيفَةٍ دَرَسَ الَّذي قَد أودعت","مِن جورِها ضَربٌ مِنَ الدّيدانِ",27,"ن",1,0],["كصاعقةٍ نَفسي فخافوا انقِضاضَها","وقُولوا بيأسٍ ما أعزَّ منالها",28,"ل",3,0],["كَصيانةِ الأعراضِ عمّا شانَ وال","ألباب والأنساب والأبدانِ",29,"ن",1,0],["كصَعْدةٍ في حَشا الظَّلْمَاءِ طاعنةٍ","تَسْقى أسافِلَها رِيّاً أعاليها",30,"ي",3,0],["كصواعقٍ تنقض ترجم نفسَه","حتى يعود ممزَّقاً بشقائه",31,"ا",3,0],["كصبغ الشيب ينصلُ بعد يومٍ","ولم يَبْعُدْ مداه عن الظهور",32,"ر",1,0],["كَصَوْبِ خوافِقِهِ فِي الحَبيكِ","وصَوتِ مَغافِرِهِ فِي الدُّروعِ",33,"ع",1,0],["كصغير نازح عن أمه","ليس ينسيه سواها دنفه",34,"ف",2,0],["كصلِّ الحَمَاطة يطوي الحِما","مَ صعبا ويُعطيك باللمس هُونا",35,"ن",2,0],["كصبح حين صبَّح أمسِ عيني","أراني كيف أغتبقُ العويلا",36,"ل",2,0],["كصاحب البلدة القَواء أخو","ه الذئب فيها وجارهُ السَّبُعُ",37,"ع",1,0],["كصوب حَياً ألقى بَعاعاً بحُرَّةٍ","فطاب ثَرىً زاكٍ وطابَ غَمامُ",38,"م",1,0],["كصوب الحَيا السَّحَّاح سيَّان عنده","سِباخٌ وحُرٌّ فهو للكُلِّ ماطِرُ",39,"ر",1,0],["كصفات سعد الدين في قصاده","والوفد جاد كعاده وتبسما",40,"م",2,0],["كصفح الحسام العضب ينهلُّ ماؤهُ","وفي شفرتيه للمضاءِ ضرامُ",41,"م",1,0],["كصفات الملك المؤيّد يهمي","باسمَ الوجه في وجوه الوفد",42,"د",1,0],["كصلاح الدين الناصر يو","سف جاد فليس له نشب",43,"ب",1,0],["كصدغه إذ تعقرب","وقده إذ تنصب",44,"ب",1,1],["كصادٍ يطلبُ الماءَ ببيدٍ","بها الماءُ بجوفِ الأرْضِ غائِرْ",45,"ر",1,0],["كَصلالِ الرِّمالِ أَو كَذئابِ ال","قاعِ رُقشاً هَبَبْنَ بعد رُكودِ",46,"د",1,0],["كصدر القنا كالنصل كالغصن في النقا","كزهر الرُبَى كالبدر كالرَشَإِ الأَحوَى",47,"و",2,0],["كَصَولَجانِ لُجَينٍ في يَدَي مَلِكٍ","أَدناهُ مِن كُرَةٍ صِيغَت مِنَ الذَهَبِ",48,"ب",1,0],["كَصَحنٍ مِنَ الياقوتِ خُطَّت مِنَ البها","بِوَسطِ حَواشيهِ مِنَ المسكِ لامُهُ",49,"م",2,0],["كَصَحنٍ مِنَ الياقوتِ قَد خِلت وجهه","وَفيهِ لَقد دارَ العذارُ الزّبَرجَدي",50,"ي",1,1],["كَصَفْحَةِ فِضَّةٍ في كَفّ سَاقٍ","تَجَلَّى فَوْقَهَا لِلتِّبْرِ كَاسُ",51,"س",1,0],["كصَعدَةِ مُرّانٍ جرى فوق متنِها","خليجٌ أَمرّتهُ البحورُ الزغارِفُ",52,"ف",1,0],["كَصلَبِ الفيلِ عُراضاً قَسبا","أَصْهَبَ يَمْطُو مَرِساتٍ صُهْبا",53,"ب",2,0],["كصائمة الجوانح في ورود","فما ابتلت بغير سراب ماء",54,"ا",2,0],["كصاد في المعنى غدا راح قعد","تحوّل استحال حار عاد رد",55,"د",1,0],["كصعدةٍ من فضةٍ","لها سنانٌ من ذهب",56,"ب",1,0],["كصفاءٍ شأنه بوفاءِ","في إخاءِ ذانك السّيدانِ",57,"ن",1,0],["كصولته ولافيحُ الجوابي","تشابه ما لديه من الجفان",58,"ن",1,0],["كصبح يقتضي ليلاً يهيماً","كليل يقتضي صبحاً مبينا",59,"ن",2,0],["كصيفي بن ساعد وابن قيس","وعبد اللَه رأس الخزرجينا",60,"ن",2,0],["كصفحةِ السَّيْفِ ولكنَّها","يَجْرِي الهوى فيها مع الصَّقْل",61,"ل",1,0],["كصالح الليث الهزبر الذي له","على أم رأس الفضل مسرى ومذهب",62,"ب",1,0],["كصارمٍ أسلمه القراب","وقد جرى من فمك اللعاب",63,"ب",1,0],["كصحبة عبد القادر الأمجد الذي","تعشق أبكار العلا حينما شبا",64,"ب",2,0],["كَصِيَانَةٍ الأتبَاعِ عَن شتمِ المُعَطِّ","لِ للمُشَبِّهِ هَكَذَا الإرثَانِ",65,"ن",1,0],["كصوب الحيا إن ظل يسمع وهو إن","غدا سامعاً مثل المصيخ إلى الشكر",66,"ر",1,0],["كصِلٍّ إِن دَنا أَحَدٌ","يُشيرُ إِلَيهِ بِالنَقفِ",67,"ف",1,0],["كصلال الرمل تنفض ثوباً","يا حذاري من أخ الرمل حذارا",68,"ر",2,0],["كصاحبة الرُّمَّان لمَّا تصدّقت","جَرت مثلاً للخائِن المتصدِّقِ",69,"ق",1,0],["كَصَوْلَجَانِ المَرَايَا حُطِّمَت يَدُهُ","عَلَى نَسِيْجِ تِلاوَاتِيْ وِمنْ عَبَقِيْ",70,"ق",2,0],["كصاحب الطير لا ينفك يسجنه","سجنين من قفص مضن وأطواق",71,"ق",1,0],["كصَيخَدَةِ البِطاح أباثَ عنها","وأَبرزَها أخو زَبَدٍ جَرُوفُ",72,"ف",1,0],["كَصَدْرِ الذابلِ الخطّيّ أَهدَى","اليهِ المَجْدُ شُكْري وامتدَاحِي",73,"ح",2,0],["كصُدورِ الرماحِ تَخفِقُ في الجَ","وِّ عليها الراياتُ والأَعْلاَمُ",74,"م",1,0],["كصادٍ يرى ماء الطوي بعينه","وليس إليه من سبيل بسبب",75,"ب",1,0],["كصيحتِهِ يومَ اللِّوى حينَ أشرفَتْ","بأسفلِ ذي بَيضٍ نعاجُ الصَّرائمِ",76,"م",1,0],["كصوت إبليس لولا","ما فيه من فرط صدق",77,"ق",1,0],["كصدرِ الصَب جاش بما يلاقي","فلجَّ الطرفُ منه بالبكاءِ",78,"ا",2,0],["كَصَانِعٍ صَنَمًا يَومًا عَلَى يدِهِ","وَبَعدَ ذلِكَ يَرجُوهُ وَيَخشَاهُ",79,"ه",1,0],["كَصاعِقَةِ زَفسُ مِن عِندِهِ","عَلى الأَرضِ يَدفَعُ مِن زَندِهِ",80,"ه",1,0],["كصخرٍ بصخرٍ قد اتصلا","بحائط دارٍ سمت للعلى",81,"ل",2,0],["كَصَيِّبِ الثَلجِ تَنهالُ الغُيومُ بِهِ","والنَوءُ هَبَّ فَتَهمي تَحتَ هَبَّتِهِ",82,"ه",1,0],["كصافةٍ بالثغر ليست تبالي","برياحٍ وموجةس مائيه",83,"ه",1,0],["كَصَنيعِ الوَزيرِ داود ذي الحَزمِ","أَبي يوسف المَليكِ المُفَدّى",84,"د",2,0],["كَصاحبهِ عَذبِ الخَلائِقِ مُصطَفى","وَإِن أَخَذَ الإِقدامَ وَالبأسَ عَن عَمرو",85,"ر",2,0],["كَصَديقي أَبي عَلِيَّ وَحاشا","لِصَديقي مِن مِثلِ شِقوَة جَدّي",86,"د",2,0],["كَصَنعاءَ.. لا أَدري إِلى أَيِّ عالَمٍ","رَحِيلِي، ولا أَدري متى سَوفَ أَرجعُ",87,"ع",1,0],["كصلصلةٍ تدق الغار فينا","يدثرنا الهوى سعيا إلينا",88,"ن",2,0],["كَصَنْعاءَ الّتي هُدمَتْ","لَنا مِنْ أمْرِها عجَبُ",89,"ب",1,0],["كَصُوفِيَةِ الْهوَى صَمْتًا وَنُذْرَا","تَجَلَّى الْوَحْيُ فِيْهَا فِيْ مَدَاهَا",90,"ا",3,0],["كصدغة إذا تعقرب","وقده إذا تنصب",91,"ب",1,1],["كصريع الكحول يصرخ","والخمرة تفري حشاه: هل من مزيد؟",92,"د",1,0],["كَصمتينِ كانَ الهمسُ والليلُ سَاكنٌ","وخَدُّكِ إنْ حَلَّ المساءُ وَسائِدُ",93,"د",1,0],["كصبحِ شتاءٍ كساهُ ضَبابٌ","وكسَّرَ بالبَردِ صوتَ العنادلْ",94,"ل",1,0],["كَصُبْحٍ يُهامِسُ طَيْفَ الهَوَى","فَما أنْبَل الطَّيْف.....ما أنْبَلا",95,"ل",2,0],["كَصورةِ وردةٍ فَقَدتْ شَذاها","فَلا عَبَقٌ هُناكَ ولا رَحيقُ",96,"ق",1,0],["كصدى الديار ضجيجهم","فاصبر عليه فليس يبقى",97,"ق",2,0],["كصوفي وطيفك باصطجابٍ","توحدَ في المقام وفي القصاص",98,"ص",1,0],["كصحوةِ فجرٍ بظلمة ليلٍ","وشهقةِ صبحٍ بغيرِ زفير",99,"ر",1,0],["كصبحِها يومَ أنْ أهدتْ أشعَّتها","علىٰ الرسولِ الذي أهدىٰ لنا النعما",100,"م",2,0],["كصبٍّ يحاكيني يولول بي اسى","فأرّق بي جرحا دفينا اكابدهْ",101,"د",2,0],["كصوتِ ربابةٍ بُحّتْ وعودٍ","بلا وترٍ يتوق إلى الرفاقِ",102,"ق",1,0],["كصنعاء حين علتْ عن سواها","علتْ أنْ أشبهها بالنساءْ",103,"ا",2,0],["كصبحِ العيدِ ياأدباءُ إنَّا","بهذا اليومِ يحضرُنا السرورُ",104,"ر",1,1],["كصهيونيّةٍ أو طائفيّةْ","كماسونيّةٍ أو أيِّ فِرْيةْ",105,"ي",2,0],["كصخرةَ إذ تَساءل عن حصينٍ","أسائل عنك سكّان الفضاء",106,"ا",2,0],["كصفات ذي المجد المشير جميل من","بالجود أضحى للغمام عديلا",107,"ل",2,0],["كصبيٍّ يجمع أعقاب السيجارات","ليطلق متعته في ركنٍ مهجورٍ",108,"ر",1,1]]}