{"poems":[[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[108,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[186,"غريغوريوس ذو المجد بطركنا ابتنى","https://www.aldiwan.net/poem66958.html","الطويل"],[240,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[443,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[445,"اسعد كما سعدت بك الأيام","https://www.aldiwan.net/poem34855.html","الكامل"],[463,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[466,"تميس جياد الخيل حتى كأنما","https://www.aldiwan.net/poem15410.html","الطويل"],[541,"عرفت دياراً بالحمى فشرائث","https://www.aldiwan.net/poem23857.html","الطويل"],[568,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203785","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108579","الكامل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131594",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100290","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201123","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46024","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117971","السريع"],[3959,"","https://poetry.dctabudhabi.ae/diwan/poem/73862","البسيط"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81928","الكامل"],[4984,"حيَّ على الصبح *","https://www.poetsgate.com/ViewPoem.aspx?id=175747",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[592,"يا راكباً جلعداً وجناء عيهلة","https://www.poetsgate.com/ViewPoem.aspx?id=128816",""],[4442,"بشرى العراق بعيد فطره","https://www.poetsgate.com/ViewPoem.aspx?id=171006",""]],"verses":[["فَكَأَنَّ سَفّودَينِ لَمّا يُقتَرا","عَجِلا لَهُ بِشَواءِ شَربٍ يُنزَعُ",0,"ع",1,0],["فكأَنَّ سَاجنَكَ السجي","نُ، وأنتَ منطلقُ السَّراح",1,"ح",1,0],["فَكانَ سَماءاً لِلهُدى قَد أَضاءَها","سَنىً أَرِّخوا مِن كَوكَب الشَرقِ ظاهِرُ",2,"ر",1,0],["فَكَأَنَّ سائِلَهُ يُخا","طِبُ مِن لَوى تَيماءَ مَعهَد",3,"د",1,0],["فَكَأَنَّ سَيْفَ اللهِِ عِنْ","دَ الشَّامِ قَدْ شَامَ الْمُهَنَّدْ",4,"د",1,0],["فكان سيفك يا موسى العصاولة","من هامهم جملة الاحجار لا الحجر",5,"ر",1,0],["فكأَنَّ سيفَكَ فِي يمينكَ شادَهُ","حَتَّى التقى فِيهِ ندىً وضِرامُ",6,"م",1,0],["فكأنّ سافلةَ النبيط بها","عُليا تميمٍ أو بنى ذُهلِ",7,"ل",1,0],["فكان سحاباً بَرْقة بِشرُ وجهه","وصوبُ حياهُ جودهُ في القبائل",8,"ل",1,0],["فَكانَ سِراجاً لِلإِلهِ وَرَحمَةً","يُخَلَّدُ في تِلكَ الجِنانِ المَواكِثِ",9,"ث",1,0],["فَكانَ سَواءً عَذبُهُ وَعَذابُهُ","عَلَيهِ فَما اِستَعفاهُ قَطُّ وَلا أَعفا",10,"ف",2,0],["فكان سواءً يوم نعيك معجبٌ","موالٍ، وخصم لا تكل عقاربه",11,"ب",2,0],["فكأن سلك البرق في صمصامه","للنار يقذف كل راس طاحا",12,"ح",2,0],["فكان سلام الوصول في الناحيه","منه سلام السلامه والوداع",13,"ع",1,0],["فكأنَّ سافرة اليفاع خرائد","عقدت تمائم يافع الأزهارِ",14,"ر",1,0],["فكان سبحي لأنجو من وحولهم","شعراً يفوح بذّياك الشذا العطر",15,"ر",1,0],["فَكَأَنَّ سِرَّ الوَحيِ كانَ نَجِيَّه","أَو كانَ في نَجوى الخَفاءِ رَقيبا",16,"ب",2,0],["فكان سوء الحظ لي صاحباً","كأن ما أملت حال محال",17,"ل",1,0],["فَكانَ سَيفُكَ نَقّاداً لَهُ بَصَرٌ","نَفَى الزُّيوفَ وَأَبقَى خالِصَ الذَّهَبِ",18,"ب",1,0],["فَكَأَنَّ سُنَّةُ مُحَلِّفٍ حَلَفا","فَالدَمعُ يَسبِقُهُ وَتَقرَعُهُ",19,"ع",2,0],["فَكَأَنَّ سُندُسَةً لَها كَنَفٌ","جيبَت بِحَيثُ الرَوقُ يَرفَعُهُ",19,"ع",2,0],["فكأنَّ ساقيها يدير كوؤسها","قمر السماء سرت إليه كواكب",20,"ب",1,0],["فكان سرابا ووهما فضيعا","مضي بتوالي الليالي مُضيا",21,"ي",2,0],["فكان سيفك نوراً في الظلام لها","وأين قبلك سيفٌ يخلف الشهبا",22,"ب",2,0],["فكان سعيهمو فيما يقربهم","إلى المليك العظيم الرب ذي النعم",23,"م",1,0],["فكأن سر الله فيه","مودع فأعجب لسره",24,"ر",2,0]]}