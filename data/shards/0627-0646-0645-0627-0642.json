//www.aldiwan.net/poem54069.html","الرمل"],[422,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[534,"الجواب الذي أراه صوابا","https://www.aldiwan.net/poem37448.html","الخفيف"],[548,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[563,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[563,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[563,"إن هذا زمن الأمر العسير","https://www.aldiwan.net/poem34490.html","الرمل"],[563,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[572,"زعموا أن من أحب عليا","https://www.aldiwan.net/poem69797.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48556","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38124","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90577","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70903","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109253","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109278","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27740","الرمل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28517","الرمل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70350","الرمل"],[3070,"","https://poetry.dctabudhabi.ae/diwan/poem/142707","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32698","الخفيف"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121279","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139479",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139721",""],[4767,"حديث مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=124899",""],[4929,"مرثية الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=204918",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5333,"ما رأينا من غايةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=8880",""],[5409,"نال فيك الغرب يا علم المراما","https://www.poetsgate.com/ViewPoem.aspx?id=155311",""],[5956,"يا مخلوق","https://www.poetsgate.com/ViewPoem.aspx?id=192597",""],[572,"زَعَمُوا أنَّ مَنْ أَحَبَّ عليّاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9163&r=&rc=20",""]],"verses":[["إِنَّما قَصَّرَ مِن آجالِنا","أَنَّنا نَأنَفُ مِن مَوتِ الهَرَم",0,"م",1,0],["إِنَّما قُمتُ فيهِ وَالنَفسُ نَشوى","مِن كُؤوسِ الهُمومِ وَالقَلبُ دامي",1,"م",2,0],["اِنَّما قَد رَمَيتَ في شَخصِ سَعدٍ","أُمَّةً حُرَّةً فَشُلَّت يَداكا",2,"ك",2,0],["إِنَّما قُلتُ إِنَّهُ حَسَنُ الظَنِّ","حَليمٌ كَأَنَّهُ اِبنُ نِفايَه",3,"ه",1,0],["إِنَّما قَصرُ كُلِّ شَي","ءٍ إِذا طارَ أَن يَقَع",4,"ع",1,0],["إن ما قلتَه من القول هُجر","مُنكَر لا تقوله الأحرار",5,"ر",1,0],["إنما قد ذكرت بعض مزايا","ك وإلاّ فشرحهن يطول",6,"ل",1,0],["إنما قيلَ جوهريٌّ لعبدٍ","نكحوهُ فلُقِّبَ الجَوْحَريا",7,"ي",2,0],["إنما قد سلكت من غير هاد","سبلا في الحياة غير فجاج",8,"ج",1,0],["انما قد اصاب شاكلة الامة","لما اصابك المقدور",9,"ر",1,0],["انما قالة القريض كثير","وقليل من بينها النبغاء",9,"ا",2,0],["ان ما قد قصصته من حروب","سوف يبقى تأثيره في القلوب",10,"ب",1,0],["إِنَّ ما قُلتُ وَالَّذي عِبتُ مِنها","لَم يَزِدها في العَينِ إِلّا جَلالا",11,"ل",2,0],["إِنَّما قَصرُنا وَإِن حَسَّرَ السَي","رُ بَعيراً أَن نَستَفيدَ بَعيرا",12,"ر",2,0],["إِنَّما قُرَّةُ عَيني هَواها","فَدَعِ اللَومَ وَكِلني لِما بي",13,"ب",2,0],["إن ما قالوه ترهيب","لناس بسطاء",14,"ا",2,0],["إنما قد سألتما عن أمورٍ","هي ليست تغني وليست تضير",15,"ر",1,0],["إنمَّا قد قَدَّمَت مَسعاتُنا","نعَماً تَرفَعُ منَّا مَن عَثرَ",16,"ر",1,0],["إنَّ ما قُلْتَ وَکلَّذي عِبْتَ مِنْها،","لم يزدها في العينِ إلا جلالا",17,"ل",2,0],["إنَّما قَصْرُنا وإنْ حَسَّرَ السَّيْ","بعيراً، أن نستجدّ بعيرا",18,"ر",2,0],["إِنما قارونُ من أجلِ الغنى","ساخَ في الأرضين مما قد عَمَلْ",19,"ل",1,0],["إن ما قد لقيت من عطفها الحلو","درسه من جهلها أستفيد",20,"د",1,0],["إِنَّما قَبلَ المَماتِ","ذَكِّر الصَبَّ بميّ",21,"ي",1,0],["إنما قبَّلْتُ يا سؤْ","لي دمائي فوق خدّك",22,"ك",1,0],["ان ما قد فات مات","فانتظر ما هو آت",23,"ت",1,0],["إنَّما قرّبَتهم عن نظرٍ","ما له في هذه النَّاس نظير",24,"ر",1,0],["إنّما قَيَّدتني في نِعمة","أطلَقَتْ في شكرها اليومَ لساني",25,"ن",2,0],["إنما قلَّلَ من أموالكم","فرطُ ما تُعطون والمعطِي مُقِلّْ",26,"ل",1,0],["إنَّما قَطَّعَ الْقُلوبَ بِعادٌ","قَطَّعَ اللهُ قَلْبَ هذا الْبِعادِ",27,"د",1,0],["إِنَّما قَحطانُ فينا حَطَبٌ","وَنِزارٌ في بَني قَحطانَ نارُ",28,"ر",1,0],["إنما قال ذاك عن ملكوت","قد أراه الإله للتنبيه",29,"ي",2,0],["إنما قلدوا بحفظ كلام","وادعاء له بغير حصول",30,"ل",1,0],["إنما قد أمروا أن يعبدوا","مخلصين الدين في قول القدير",31,"ر",1,0],["إنما قولنا بذلك قول ال","لَهِ في محكم الكتاب الجواد",32,"د",1,0],["إنما قولُهُ ارفضوا عنكُمُ الدُّنْ","يَا إذا كنتُمُ لنا أحْبَابَا",33,"ب",2,0],["إنما قومك الشباب وقومي ال","شيب صف يخيف كل الصفوف",34,"ف",1,0],["إِنّ ما قَد أُصِبتَ فيهِ عَظيمٌ","وَهوَ أَمرٌ حُكمُ القَضا فيه جاري",35,"ر",2,0],["إنّما قلت ما نظمتُ من الشع","ر ولوعا ورغبةً في الكمالِ",36,"ل",1,0],["إنما قلبُ سُبْيتٍ","شركٌ يحوِى القصائدْ",37,"د",1,1],["إن ماقد مضى وما سوف يأتي","لخصت فيه آية الأزمان",38,"ن",1,0],["انما قدر الفتى ما يبتني","من فخار العلم بين البشر",39,"ر",1,0],["إنما قلتَ لشيءٍ كن فكان","بكلامِ الحقِّ لا قولِ فلانِ",40,"ن",1,1],["إِنَّما قَومُكَ إِن رُمتَهُمُ","فَقعَةٌ تَسكُن وَعثاً قَرقَرا",41,"ر",2,0],["إنما قصدي رضاكم","قد حلا لي قد حلا لي",42,"ل",2,0],["إنَّما قد وقفتما في خُلُوٍّ","لفراق الأحباب تشْتَوِران",43,"ن",1,0],["إنما قد قِيلَ في دارِ الخُلود","سوفَ نلقى ربّنا يومَ المَعاد",44,"د",1,0],["إِن ما قَد جَرى جَرى يَقظة لا","في مَنام رَأى العَدوّ تَأوّل",45,"ل",1,0],["إِنَّما قَد تَقول جهد مقلٍّ","وَهوَ عَرض يَمده الإلتجاء",46,"ا",2,0],["إن ما قل منك يكثر عندي","وكثير من المحب القليل",47,"ل",1,1],["إنما قصّتي كوازِرَةٍ كلّ","فها جورُ ظالمٍ وزر أخرى",48,"ر",2,0],["إنَّ ما قد سمَّطتَ سمط لئالِ","قُلدت فيه كاعبٌ عطلاء",49,"ا",2,0],["إنَّ ما قد سمَّطتَه عقدُ درٍ","فوق حسناء ذات دلٍّ معلَّق",50,"ق",1,0],["إنِّما قول وفعل بِهدى","سوف يجدينا وليس العتب",51,"ب",1,0],["إنما قاتلوك نابتْ يَداهم","عن يدٍ أُزْهِقَتْ بها الأنبياءُ",52,"ا",2,0],["إِنَّمَا قَلْبِي يُرَاعِي","أَنْ أَرَى الأَيَّامَ سَطْرَا",53,"ر",2,0],["إنما قال إنه","علمٌ بل هم الهدى",54,"د",2,0],["إنما قد ساورتني ريبةٌ","جعلتني أنظر الماء ضراما",55,"م",2,0],["إنما قدْرك عندي","قدْر ما راحُك تُجْدي",56,"ي",1,1],["إنَّما قالَ فارفضُوا عنكمُ الدّنْ","يَا إذا كُنْتُمْ لَنَا أَحْبَابَا",57,"ب",2,0]]}