{"poems":[[55,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[55,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[55,"ناديته بالرمل والأمر ذكر","https://www.aldiwan.net/poem30419.html","الرجز"],[68,"انظر إلى بركة الجسرين حين بدا","https://www.aldiwan.net/poem40663.html","البسيط"],[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[68,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[68,"لا يمتطي المجد من لم يركب الخطرا","https://www.aldiwan.net/poem41548.html","البسيط"],[68,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[46,"وعاذل عذلته في عذله","https://www.aldiwan.net/poem29687.html","الرجز"],[71,"ومغن إن شداكم منشدا","https://www.aldiwan.net/poem28103.html","الرمل"],[83,"رحب بضيف الأنس قد أقبلا","https://www.aldiwan.net/poem61405.html","الطويل"],[83,"شفق وشته خضرة في حمرة","https://www.aldiwan.net/poem61465.html","البسيط"],[83,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42653","الكامل"],[164,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[189,"قد تقد به القلوب إذا انثنى","https://www.aldiwan.net/poem14682.html","الكامل"],[199,"لمن المنازل أقفرت بغباء","https://www.aldiwan.net/poem54412.html","الكامل"],[199,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[369,"لو كنت أجهل ما علمت لسرني","https://www.aldiwan.net/poem60637.html","الكامل"],[369,"صدر الرعاء وما سقيت ظمائي","https://www.aldiwan.net/poem61016.html","الكامل"],[408,"يا صفي الإسلام دعوة عبد","https://www.aldiwan.net/poem46937.html","الخفيف"],[543,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[556,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[572,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138245",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96983","الكامل"],[684,"","https://poetry.dctabudhabi.ae/diwan/poem/101256","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39076","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104605","المجتث"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100149","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138068",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115830","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79987","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26530","السريع"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103250","البسيط"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89705","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69424","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28518","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93539","الرجز"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2638,"","https://poetry.dctabudhabi.ae/diwan/poem/142151","الخفيف"],[561,"","https://poetry.dctabudhabi.ae/diwan/poem/145195","المتدارك"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115770","السريع"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46773","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74036","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126954","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111503","الكامل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105573","الكامل"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147249","الكامل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121283","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136392",""],[4684,"حلاوة الإيثار","https://www.poetsgate.com/ViewPoem.aspx?id=201034",""],[4755,"لا شَأنَ لِي","https://www.poetsgate.com/ViewPoem.aspx?id=204158",""],[5277,"ولّادةُ المنافي","https://www.poetsgate.com/ViewPoem.aspx?id=187743",""],[5431,"ماضلتِ الصحفُ..","https://www.poetsgate.com/ViewPoem.aspx?id=187578",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6093,"الصِّفرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205915",""]],"verses":[["كَالصُقورِ الغُلبِ أَلحاظُهُمُ","كَالجُذى يَلمَعنَ مِن خَلفِ اللُثَم",0,"م",1,0],["كَالصَخرِ إِن حَلُموا وَالنارِ إِن غَضِبوا","وَالأُسدِ إِن رَكِبوا وَالوَبلِ إِن بَذَلوا",1,"ل",3,0],["كَالصِلِّ إِن جَرَّ ذُباباهُ زَفَر","أَوِ الغَريريِّ إِذا عَجَّ هَدَر",2,"ر",1,0],["كَالصَرحِ حَفَّ بِهِ سِكرانِ مِن سَبَجٍ","وَسالَ في وَسطِهِ نَهرٌ مِنَ الذَهَبِ",3,"ب",1,0],["كَالصارِمِ المَصقولِ في بَريقِهِ","لَو أَنَّهُ يُسكِنُ مِن خُفوقِهِ",4,"ه",1,0],["كَالصَقرِ في الطَيَرانِ وَالطاووسِ في ال","خَطَرانِ وَالخَطّافِ في الرَوغانِ",5,"ن",1,0],["كَالصالِحِ المَلِكِ المَرهوبِ سَطوَتُهُ","فَلَو تَوَعَّدَ قَلبَ الدَهرِ لَاِنفَطَرا",6,"ر",2,0],["كَالصِلِّ يُظهِرُ ليناً عِندَ مَلمَسِهِ","حَتّى يُصادِفَ في الأَعضاءِ تَمكينا",7,"ن",2,0],["كَالصابِ مَن يَذُقهُ لا يَستَحلِهِ","إِلّا بِأَن يَسكُنَ تَحتَ ظِلِّهِ",8,"ل",2,0],["كالصَّبا هبَّتْ بأغصانِ الصِّبا","تطربُ الحيَّ وتحيي الطربَا",9,"ب",2,0],["كَالصَخرَةِ الصَمّاءِ لَكِن يَسيل","ريقاً كَريقِ النَحلِ عَذبِ الجَنى",10,"ن",2,0],["كَالصَبِّ حينَ رَأى عِذارَ حَبيبِهِ","لَمّا بَدا فَسَلا وَوَلّى مُعرِضا",11,"ض",2,0],["كَالصَائِمينَ عَشِيَّةَ الإِفطارَ قَد","مَدّوا العُيونَ إِلى الهِلالِ تَرَقُّبا",12,"ب",2,0],["كَالصَّارِمِ الْبَتَّارِ في إِفْرِنْدِهِ","وَصِقَالِهِ وَالْمَارِنِ الْهَزْهَازِ",13,"ز",1,0],["كالصوم ما كن مختاراً لنقلته","وإنما الفلكَ الدوار ينقلُهُ",14,"ل",2,0],["كالصَّعْدةِ السمراء قد أَوْفَى بها","من لحظِ مُقْلِته الضعيفِ سِنان",15,"ن",1,0],["كَالصَقرِ يَعلمُ أَنَّ آخِرَ عُمرِهِ","رَهنٌ لَهُ بِإِقامَةٍ وَثَواءِ",16,"ا",2,0],["كَالصَهابِيَةِ النَحوصِ تَلاها","واضِحُ الكاذِنينَ فيهِ اِنتِحاءُ",17,"ا",2,0],["كَالصابِ طَعماً في مَذاقِ العِدى","وَفي فَمِ العَلياءِ قَنديدُ",18,"د",1,0],["كالصبح فرقاً والغزالة طلعة","والبدر وجهاً والثريا مبسما",19,"م",2,0],["كالصَّعْوِ يَرتَعُ في الرِّياضِ وإنّما","حُبسَ الهَزارُ لأنّه يتَرنَّم",20,"م",1,0],["كالصّوتِ في ظُلَلِ الجبالِ إذا علا","للسّمْع هاجَ تجاوبَ الأصداء",21,"ا",2,0],["كالصبَا رِقّةً وكالروضِ نَشْراً","وكأَخلاقك الشرّيفةِ لُطْفَا",22,"ف",2,0],["كالصُّبح في إِثرِ الدُّجَى","يَزِينُه سَنَاه",23,"ا",2,0],["كالصّلِّ إذْ همَّ مَضى","واللّيث إنْ ضَمَّ عَذَمْ",24,"م",1,0],["كَالصَّبِّ هَمَّ بِقُبْلَةٍ حَتَّى إِذَا","لَحَظَتْهُ عَيْنُ رَقِيْبِهِ لَمْ يَفْعَلِ",25,"ل",1,0],["كالصادق الإيمان ذي العرفان من","أضحى إلى كل المراشد مرشدا",26,"د",2,0],["كالصوت لولا بعد سامعه","ما طال بل ما في النداء علا",27,"ل",2,0],["كالصوت في قلل الجبال إذا علا","للسمع هاج تجاةب الأصداء",28,"ا",2,0],["كالصَّبِّ يُخفِي شَجْوَهُ حَتَّى إذا","جَنَّ الظَّلامُ تنفَّسَ الصُّعداءَ",29,"ا",2,0],["كالصُّبحِ والصُّبحُ بادٍ","واللَّيلِ واللَّيلُ دامِس",30,"س",1,0],["كالصالح الفعل الذي بال","فضل خص وبالندى عم",31,"م",1,0],["كالصب يبكى في الوصا","ل مخافة الهجر الوجيع",32,"ع",1,0],["كَالصُبْح أَجْلَى وَالسِرَاجَ باهِرا","أَنْتَ امْرُؤٌ تَعْمُرُ مَجْداً عامِرا",33,"ر",2,0],["كالصلح خير والجميل أولى","ومقصدي خير وأنت مولى",34,"ل",2,0],["كالصلح خير جملة إسميه","وتاب زيد جملة فعليه",34,"ه",1,0],["كالصَّعدة السَّمراءِ أسمرُ لحظِهِ","يحكى سِنانَ الصَّعدَةِ السّمراءِ",35,"ا",2,0],["كالصلِّ لكن لا يصيبُ","لديغها رقاءها",36,"ا",3,0],["كَالصَيدِ في الإِحلالِ لا يَرتَمي","وَهوَ كَثيرٌ وَقتَ إِحرامِ",37,"م",1,0],["كالصيد يحرَمه الرامي المجيد وقد","يرمي ويرزقه من ليس بالرامي",38,"م",2,0],["كَالصَيدِ يَحرمه الرامي المجيد وَقد","يَرمي فَيَرزُقُهُ من لَيسَ بِالرامي",39,"م",2,0],["كَالصُبحِ فاضَ فَغَشى كُلَّ ناحِيَةٍ","فَلَيسَ يَعرِفُ فِيها نَفسَهُ الغَسَقُ",40,"ق",1,0],["كَالصَّارِمِ الهِندِيِّ إِلّا أَنَّهُ","أَمضى شَباً مِنهُ وَأَكرَمُ جَوهَرا",41,"ر",2,0],["كَالصعدة السمرا إِذا ما خَطرت","مَوصولة الصَدر إِلى كُعوبِها",42,"ب",3,0],["كالصَّقرِ أَصبحَ باليَفاعِ وَلَفَّهُ","يَومٌ أَجادَ مِن الرَبيعِ مُغيمُ",43,"م",1,0],["كالصباح الجميل كالماء في الصخرة","يجري على الغصون انحدارا",44,"ر",2,0],["كالصبح توشح رونقه","كالطور بنور الله كسي",45,"س",2,0],["كَالصَعدَةِ الجَرداءِ آمَن خَوفَها","لَطَفُ الدَواءِ وَأَكرَمُ الأَعراقِ",46,"ق",1,0],["كالصبح وجها والدجى طرّة","والبدر حسنا والثريا بنان",47,"ن",1,0],["كالصَّعْدَة السّمراء لكن فُضّلت","عِوَضَ السّنان بمُقْلةٍ كحلاءِ",48,"ا",2,0],["كالصلّ نضنضَ كامناً","في بردهِ الزاهي كمونا",49,"ن",2,0],["كالصبا رقت بطبع","وبجسم كالزجاجه",50,"ج",2,0],["كالصور خلف السور ينفخه العدى","تحت الحصار تبينوا الصوت الجلي",51,"ل",2,0],["كالصل أطرق راعشاً ولعابه","كالشهد ممزوجاً بطعم العلقم",52,"م",1,0],["كالصيدِ إذ خدعته رقةُ صائدٍ","لتكون أطواقَ النجاةِ شباكَ",53,"ك",1,0],["كالصاحب الصدر الكبير العالمِ ال","متعفّفِ البر الأجلِ الأمجد",54,"د",1,0],["كالصبح وكالرمح قامة ومحيا","كالخمور وكالجمر ريق فيه وخدان",55,"ن",1,0],["كالصاحب الجّواد يقتله الظما","وهب الرفاق شرابه واستمطرا",56,"ر",2,0],["كالصِّفرِ.. لَيسَ لَهُ مَكَانٌ آمِنٌ","إِن لَم يَكُن في خَانَةِ المليونِ",57,"ن",1,0],["كالصبحِ يغريه الشروقُ بشمسهِ","فيشعُّ بين عذوبة الأنفاسِ",58,"س",1,0],["كالصقر حرٌ وفي حريتي شرفي","أعلو لمجديْ وبالأخلاق ألتحفُ",59,"ف",1,0],["كالصَّوم إذا ذاب فيه كبدُ جائعه","وزاد فرط لهيبٍ قلبُ ظاميهِ",60,"ي",2,0],["كَالصُّبحِ يَمحُو كُلَّ خَافيةٍ","كاَلفَرْحِ عَمَّ النَّاسَ بِالبَسَمِ",61,"م",1,0],["كالصِّفرِ يُحْقَرُ إنْ أتى مُتأخِّراً","ويكونُ ذا خَطَرٍ إذا ما قُدِّمَا",62,"م",2,0],["كالصِّفْرِ يُلغي كُلَّ ما هُوَ دُوْنَهُ","ولذا أرادَ عَذولُهُ أنْ يُهْضَمَا",62,"م",2,0]]}