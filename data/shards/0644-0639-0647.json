{"poems":[[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[107,"لعمري لئن خاس الرئيس بعهده","https://www.aldiwan.net/poem43056.html","الطويل"],[315,"أبى الطيف أن يعتاد إلا توهما","https://www.aldiwan.net/poem59514.html","الطويل"],[543,"ولي لعهد كبدر منير","https://www.aldiwan.net/poem48156.html","عموديه"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62484","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6768","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89552","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33849","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27972","البسيط"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99082","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48315","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48329","الطويل"],[4679,"غدا ذا المعبد السامي علاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=142788",""],[4578,"بعيني غزال ألبان هاروت ماكث","https://www.poetsgate.com/ViewPoem.aspx?id=49366",""],[5358,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=21890",""],[5861,"سلام على المصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=188059",""],[5906,"أوتار حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188311",""]],"verses":[["لعهدي بها يوماً وقد بصُرت به","فقالت تعالى مالكُ الخلق والأمر",0,"ر",1,0],["لَعهدي به جَمُّ التقلّبِ ماله","سِوى الغدرِ إن جدَّ الوُفاةُ سبيلُ",1,"ل",1,0],["لعهدي بها تدني الظباء أو انسا","وتطلع في آفاقها الغيد أنجما",2,"م",2,0],["لِعَهد مَليكٍ إذا ما تجَلَّى","إليه قُلوبٌ تَكادُ تَطير",3,"ر",1,0],["لعهد المعيصي تنتمي اليوم ريشة","لها الوحش والطير العتاق مصائدُ",4,"د",1,0],["لَعَهدي بِها مُبيَضَّةَ اللَيلِ فَاغتَدَت","وَأَيّامُها قَد سَوَّدَتها النَوائِبُ",5,"ب",1,0],["لِعَهدي بِها بيضٌ أَوانِسُ كَالدُمى","غَرائِرُ عَمّا لا يحلُّ صَوادِفُ",6,"ف",1,0],["لَعَهدي بِأَيري ما يُذَمَّ اِختِبارُهُ","إِذا اِستَنجَدوهُ لِلعَظيمِ مِنَ الخَطبِ",7,"ب",1,1],["لعهده فجرينا نبتغي عِوضا","على التساوي مع الأسماء في طلق",8,"ق",1,0],["لعهدي فيه شيوخ لنا","غلاظ الرقاب عراض اللحى",9,"ا",1,0],["لعَهْدي بها والحيُّ في عَرَصاتِها","يُحَيّا بما يُهْدي جنىً وتأرُّجا",10,"ج",2,0],["لعَهدِ الصِّحابِ الأكْرَمينَ مُجَدّدا","فمَن ذا يُضاهي منْكَ ذاتاً ومَحْتِدا",11,"د",2,0],["لعهد الحبر غفريل المفدَّى","أقاموه بذا الربع الفسيحِ",12,"ح",1,0],["لعهدي أمسى ناكثاً بدلالة","وأيُّ مليحٍ لا يرى وهو ناكثُ",13,"ث",1,0],["لعهدِكِ عودي مَنْ سقاكِ بغدرِهِ","ومَنْ حالَ فيما بيننا ويحولُ ؟",14,"ل",1,0],["لعهدٍ منَ اللهِ وقد قالها لنا","بحبّ الحبيب المصطفى سوف يرضيني",15,"ن",2,0],["لَعَهدتُ النَّفْسَ لأِغنِيَةٍ","كَيْ أَسْلو بُعْدِكِ في سَفَريْ",16,"ر",2,0]]}