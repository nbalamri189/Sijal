{"poems":[[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[97,"في موسم الورد","https://www.aldiwan.net/poem60149.html","عموديه"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[107,"يقول أبو سفيان أودى محمد","https://www.aldiwan.net/poem44208.html","الطويل"],[54,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[139,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[199,"ألا رب لهو آنس ولذاذة","https://www.aldiwan.net/poem54397.html","الطويل"],[275,"هزئتم بنفس تجهلون خلالها","https://www.aldiwan.net/poem35616.html","الطويل"],[308,"بأسياف الجفون قتلت نفسا","https://www.aldiwan.net/poem57984.html","الوافر"],[308,"زدوا مهجتي ضرا على الضر في الهوى","https://www.aldiwan.net/poem58294.html","الطويل"],[354,"شرعة وجدي ما لها نسخ","https://www.aldiwan.net/poem15566.html","السريع"],[382,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[422,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[518,"ولما وقفنا للوداع وبيننا","https://www.aldiwan.net/poem67764.html","الطويل"],[563,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122690","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137826",""],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137587",""],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115361","البسيط"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93107","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66266","المتقارب"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125456","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89561","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28023","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102502","الوافر"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199893","الطويل"],[3042,"","https://poetry.dctabudhabi.ae/diwan/poem/199482","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145183","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216469","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117921","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33609","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139529",""],[5535,"معاملة الأحباب بالوصل والوفا","https://www.poetsgate.com/ViewPoem.aspx?id=201500",""],[5550,"رجوع حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=215208",""],[5730,"شوق","https://www.poetsgate.com/ViewPoem.aspx?id=210353",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""]],"verses":[["فَما أَقولُ اِرعَوى إِلّا تَهَيَّضَهُ","حَظٌّ لَهُ مِن خَبالِ الشَوقِ مَقسومُ",0,"م",1,0],["فما أقصرَه حُبَّا","تلاشى وهو في المَهْدِ",1,"د",1,0],["فما أقلعتْ إلا وفي كلِ ترعةٍ","بها مِنْبرُ الدينِ الحنيفيِّ منصوبُ",2,"ب",1,0],["فما أقبلوا حتّى انبرت أُمُّ أيمنٍ","وقد جاوزَ الغيظُ الحشا والتراقيا",3,"ي",2,0],["فَما أَقولُ لِدَهرٍ شَتَّتَت يَدُهُ","شَملي وَأَخلى مِنَ الأَحبابِ أَوطاني",4,"ن",2,0],["فما أقساك ظبياً ليس يرثي","لمشغول المحاجر واللسانِ",5,"ن",1,0],["فَما أَقلَعَت تَرتادُ حَتّى بَدا لَها","قَضيبٌ مِنَ الزَيتونِ يَهتَزُّ أَخضَرُ",6,"ر",1,0],["فما أقتلَ التذكارَ في نفسِ عاشقٍ","تحاول من كلِّ الأمورِ عضالها",7,"ل",3,0],["فما أقوى جفونك وهي مرضى","وأقدرها على قتل البريه",8,"ه",1,0],["فما أقدر الأجفان فيكم على البكا","وأصبر أحشائي على حرق النار",9,"ر",1,0],["فَما اِقتَنى الجَوهَرُ مِن فَضلِهِ","مَن فيهِ بِالأَعراضِ لا يَسخو",10,"خ",2,0],["فما أقبحَ الأيامَ والخبثُ طبعُها","وما أحسن المحمودَ فيها عواقبه",11,"ب",2,0],["فما اقتَحم الأَهوال إلاَّ خطيرةً","تجلّ وما يلقى الجليلَ جليل",12,"ل",1,0],["فما أقلعت حتى بكت فتضاحكت","رياض الربى فأخضر بالعشب عودها",13,"د",3,0],["فما اقتدوا بقوله","ولا رأوه حسنا",14,"ن",2,0],["فَما أقُولُ وَما أثني عَليَكَ بِهِ","وَحُسنُ وَصفِكَ شَيٌ لَيس يُنتَفَقُ",15,"ق",1,0],["فما أقبح الإنسان يعمى عن المنى","ويسلك في أعماله كضرير",16,"ر",1,0],["فما أقرب الموت منك أيا من","له جسد كان من قبل طينه",17,"ن",2,0],["فما اقتراب الهوى من عاشق دنفٍ","الذّ من ماء شِعرٍ جال في كَرَمِ",18,"م",1,0],["فما أقول إذا ما قال قائلهم","محب آل الهدى مأواه في سقر",19,"ر",1,0],["فما أقلعت دون قتل الحسين","فيا ليتها الدهرَ لا تقلع",20,"ع",1,0],["فما اقسى الغرامَ على فؤادي","إذا كان التجنِّي من نصيبي",21,"ب",2,0],["فَما أَقرَبَ الآتي وَأَبعدَ ما مَضى","وَهذا غُرابُ البَينِ في الدارِ يَنعَبُ",22,"ب",1,0],["فما أقاموا على حالٍ وما جمعوا","عليه في علمهم فيه وما درجوا",23,"ج",3,0],["فما أقبح مقالاً لم يؤيد","بعدل شاهد حسن الفعال",24,"ل",1,0],["فما أقصر اسم الحب يا ويح ذي الحب","وأعظم بلواه على العاشق الصب",25,"ب",1,1],["فما أقبلَت للسِّلم حتى تمرَّست","بها السرة الحصداء والعدَدُ الدثر",26,"ر",1,0],["فما أَقْصرَ الأوقاتَ والشهرَ عندنا","إذَا أَسْفر الفَجرانِ باغتَنا العصر",27,"ر",1,0],["فما أقبح التقصير والجهل بالفتى","إذا عاصف التثريب في الوجه ينفض",28,"ض",1,0],["فما أقصر الدنيا التي طوَّل الضنى","أصائله فيها وأشقى لياليه",29,"ي",2,0],["فما أقبح استكبار عبد بكفّه","نهاراً وليلاً يغسل البول والخرا",30,"ر",2,0],["فَما أقلعَت مُقلَتي","عن الدَّمعِ حتى عَلَن",31,"ن",1,0],["فما أقول بمن في أفضليَّتهِ","قرَّت جميع الورى بل جملة الكتبِ",32,"ب",1,1],["فما أقبح الإعراض عمن تحبه","وما أحسن الإقبال منه وألطفا",33,"ف",2,0],["فما أقْبحَ البعْدَ بعد التداني","وما أَجْملَ القربَ بعد التنائي",34,"ا",2,0],["فما أقسى حبيبي!!!!، إيْ وربّي","تَرقُّ ليَ الجبالُ ولا يَرقُّ",35,"ق",1,0],["فما أقربَ الأشباح منّي، تلفنّي","بوعدٍ... أما أفرغتُ كأسَ وعودها؟",36,"د",3,0]]}