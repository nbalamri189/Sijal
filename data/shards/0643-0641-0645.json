{"poems":[[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[82,"من لي بطيب الوصل من غادة","https://www.aldiwan.net/poem31570.html","السريع"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39466","الخفيف"],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[500,"كفم الحبيب كطرفه","https://www.aldiwan.net/poem9866.html","مجزوء الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67029","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53197","الرجز"],[2398,"","https://poetry.dctabudhabi.ae/diwan/poem/178019","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88923","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48384","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216716",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111424","الخفيف"],[4229,"","https://poetry.dctabudhabi.ae/diwan/poem/203926","السريع"],[4908,"دمعة حزن على جراح الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=207338",""],[3271,"ويعيش أحرار العقول بظلها غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=104120",""],[5277,"زهرةٌ لا تذبلها الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=196558",""]],"verses":[["كفَّ من سورة ابن بسطامَ عنِّي","وهْي مشبوبةٌ كحرِّ الضّرام",0,"م",1,0],["كفٌّ من الكافور هذي التي","أرى من المسك عليها خضاب",1,"ب",1,0],["كفِّ مَن لا يهزُّ عِطفيهِ يوماً","لمديحٍ ولا يُبالي بذمِّ",2,"م",1,0],["كفَم الحِبِّ في الحلاوة ِ بل أح","لى وإن لا يناغي بحرف",3,"ف",1,0],["كفم الحبيب كطرفه","كقويم قامته كظهري",4,"ي",1,1],["كف من الفضة البيضاء ساعدها","زبرجد حملت كأسا من الذهب",5,"ب",1,0],["كف مليك كفت الخلق الأذى","وكفت الخطب الذي كان غشم",6,"م",1,0],["كفٌ متى بسطَتْ كفّ الزمانِ بها","فأوجدت وُجدةً أو أعدمت عدما",7,"م",2,0],["كفم ببشرى العيد أقبل داعياً","بثواب صوم من أبي الإقبال",8,"ل",1,0],["كفُّ مَوْلاي سحابُ المعْتَفي","فأنا نجْمُ هُدىً للمُقْتَفي",9,"ي",1,1],["كف من الثلج إن جرت","في جاحم النار تبتردْ",10,"د",1,0],["كف مقدسة المساعي في العلى","طافت بها رشفات كلّ مقبل",11,"ل",1,0],["كَفُّ مَولاهُمُ وزَحفَ سِواهُ","أَثقَلاهُم بكُلِّ حُزنٍ ثَقيلِ",12,"ل",1,0],["كف من الفضة مبسوطة","في وسطها كاس من العسجد",13,"د",1,1],["كَفٌ مِنْ الأوجاعِ تصفع خَدَّهَا","دُونَ السَّلام حرابةٌ وخرَابُ",14,"ب",1,0],["كفٌّ مطهرةٌ تصافح أختها","فيقال آثمةٌ منَ الأجحاف",15,"ف",1,0],["كفٌّ من الريحِ ارْتمتْ..في راحهِ","سكرى الحروفِ.. يشوقُها الإملاءُ",16,"ا",2,0]]}