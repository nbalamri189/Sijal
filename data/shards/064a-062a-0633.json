"ل وربّ الأقلال والمَثْراة",5,"ه",1,0],["يتسلّقُ الأشجارَ لا ضَجَرا","يُحسُّ ولا وَنَى",6,"ن",2,0],["يتساءلون عن العنا","ية كيف منّت بالظهور",7,"ر",1,0],["يَتَساءَلونَ عَنِ الحَريقِ وَهَولِهِ","وَأَرى الفَرائِسَ بِالتَساؤُلِ أَجدَرا",8,"ر",2,0],["يَتَساءَلونَ أَبِالسُلالِ قَضَيتَ أَم","بِالقَلبِ أَم هَل مُتَّ بِالسَرطانِ",9,"ن",1,0],["يَتَساءَلونَ بِأَيِّ قَلبٍ تُرتَقى","بَعدَ المَنابِرِ أَم بِأَيِّ لِسانِ",9,"ن",1,0],["يَتَسَرَّعونَ إِلى الحُتوفِ كَأَنَّها","وَفرٌ بِأَرضِ عَدُوِّهِم يُتَنَهَّبُ",10,"ب",1,0],["يَتَسَربَلونَ أَسِنَّةً وَصَفائِحاً","وَالمَوتُ بَينَ صَفيحَةٍ وَسِنانِ",11,"ن",1,0],["يَتَساقَونَ في الوَغى كَأسَ مَوتٍ","وَهيَ مَوصولَةٌ بِكَأسِ رَحيقِ",12,"ق",1,0],["يتساقطون مُهذَّبا فُمهذَّباً","غضَّ الشّبابِ جَبينُهُ وَضّاحُ",13,"ح",1,0],["يَتَسابَقونَ إِلى مَنازِلِها العُلى","يَتَفَيَّأونَ الخَيرَ وَالإِنعاما",14,"م",2,0],["يَتَسَوَّكنَ قَبلَ كُلِّ طَعامٍ","وَاسِعاتُ الجُيوبِ وَالأَكمامِ",15,"م",1,0],["يَتَساقَينَ بِالمَضاحِكِ كَالشَه","دِ مَشوباً بِماءِ مُزنٍ نَميرِ",16,"ر",1,0],["يتسمّعنَ للخرير المناجي","ويرتّلنَ للرُّبى تحنانَه",17,"ن",2,0],["يتساءَلان متى الإِيابُ ويومُهُ","يومُ الرحيل ولات حين مقامِ",18,"م",1,0],["يَتَساءَلونَ وَأَنتَ أَطهَرُ هَيكَلٍ","بِالروحِ أَم بِالهَيكَلِ الإِسراءُ",19,"ا",2,0],["يَتَساقَوْنَ بِالْكُؤُوسِ مُداماً","هِي كَالشَّمْسِ فِي قَمِيصِ إِيَاةِ",20,"ه",1,0],["يَتَسَلْسَلُونَ وَلِلنجُومِ نِظَامُهُمْ","فِي السَّيْرِ لَكِنْ قُيِّدَتْ بِسُلُوكِ",21,"ك",1,0],["يتساءلون وقد رأوا","قيس الملوح في شحوبي",22,"ب",2,0],["يتساءلون: من الفتى ال","عربي في الزي الغريب",22,"ب",1,0],["يتساءل الأصحاب : أين متيم","با لفوز ؟..أين حصانه الوثاب",23,"ب",1,0],["يتساءلون علام جر","دْنا السيوفَ من الغمود؟",24,"د",1,0],["يتسابقون إلى البيان، كأنهم","جُرْدٌ مذاكٍ ضمَّها مضمار",25,"ر",1,0],["يتسابقون إلى اللقاء، كأنما","هُوَ نزهةٌ بين الرياض أصيلا",26,"ل",2,0],["يتساءل الأقوام: هل","«نيرونُ» بعد الموت قام؟",27,"م",1,0],["يتساقط المغرور في لهواتها","تفريه بالانياب والاظفار",28,"ر",1,0],["يتساءلون بأي عُذرٍ نختفي؟","عن شعبنا وبأيِ وجهٍ نَطلُع",29,"ع",1,0],["يتساوى غروبُهم وركودُ النفس","منهم وفجرهُم والهبُوب",30,"ب",1,0],["يتساءلونَ أينزِلونَ بلادَهم ؟","أمْ يقطعونَ فدافِداً وسباسبا؟",31,"ب",2,0],["يتساءلان متى الإياب ؟ ويومه","يو مارّحيل ، ولات حين مقام",32,"م",1,0],["يَتَسارَعون إِلى العُلى","بِالمُرهَفات عَلى الخُيول",33,"ل",1,0],["يتساءلون وقد عرَتهم سكرة","عما عراك وما همو بسكارى",34,"ر",2,0],["يتسابقون إلى المنون فكلُّهم","يغَشى الردَى ما عُدّ في الوِلدانِ",35,"ن",1,0],["يتسابقون إلى حياض الموت كالمت","سابقين الى ورود المشرع",36,"ع",1,0],["يتسلل الماء الفرا","ت مفضضاً كالسلسبيل",37,"ل",1,0],["يَتَساقَونَ سَمَّها في دُروعٍ","سابِغاتٍ مِنَ الحَديدِ ثِقالِ",38,"ل",1,0],["يتسلى به الكئيب ويوفيء","كل وعد ويعطف الغضبان",39,"ن",1,0],["يتسابقون إلى الرقابِ كأنها","قصبٌ وللمتقدِّمِ الإحراز",40,"ز",1,0],["يَتَساهَمونَ السَهمَ مِن أَلحاظِهِ","وأُحِسُّهُ مُتَغَلغِلاً في مَقتَلي",41,"ي",1,0],["يتساهَدانِ وما سُها","دُهما لأمرٍ واحدِ",42,"د",1,0],["يتسلسلون لغايةٍ","حتى أتى فيها مسيحه",43,"ح",2,0],["يَتَساقونَ بِأَطرافِ القَنا","مِن نَجيعِ المَوتِ كَأساً دَهقا",44,"ق",2,0],["يتسابقون على انتهاك كرامتي","ويقلِّبون حرامها وحلالها",45,"ل",3,0],["يتسابقان و( للمقاطِ ) و( للرِّشا )","أثرٌ عميق فيهما قدْ بانا",46,"ن",2,0],["يَتَسنَّمون مِنَ المَعالي مُرتَقىً","عَنه تَزِل مَواطىءَ الأَقدامِ",47,"م",1,0],["يتَساقَون أَفاويق الكَرى","ويعَانون السُّرى ميلاً فميلا",48,"ل",2,0],["يتساءلان عن الجنا","ية عليهما مر السنين",49,"ن",1,0],["يتسع المجال في وشاحه","لا يزول الضيق من خلخاله",50,"ل",2,0],["يتسامى بالذكر والفكر قصداً","وهو ناء وعنه شط المزار",51,"ر",1,0],["يتسابقون إليه لا اربٌ لهم","الا الشفاء من السقام تمكنا",52,"ن",2,0],["يتسابقون مهنئين كأنهم","يتساجلون وأي فخر سجلوا",53,"ل",3,0],["يتسابقون الى الفضول وما دروا","ان المحبَّة قُدّرَت منذ الازل",54,"ل",1,0],["يتساءلون عن اليقين يريحهم","وأمامك الفئتان تحتكمان",55,"ن",1,0],["يتسابقون إلى مآربهم على","شلو القتيل ودارس الأطلال",56,"ل",1,0],["يتسابقون إذا دعوا لكريهة","فكأن قرع البيض صوت منغم",57,"م",1,0],["يتساوى المجدود أما اجتداه","في اتساع الأرزاق والمحدود",58,"د",1,0],["يَتَس