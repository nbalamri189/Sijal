"منال المنى بالعجز غير يسير","https://www.aldiwan.net/poem38319.html","الطويل"],[297,"إلام تطيل نوحك يا حمام","https://www.aldiwan.net/poem33161.html","الوافر"],[305,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[328,"نسميه مجنونا فنحصب رأسه","https://www.aldiwan.net/poem55058.html","الطويل"],[338,"وما صاحب السبعين والعشر بعدها","https://www.aldiwan.net/poem68708.html","الطويل"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[353,"أرى الدهر بالإقبال جادت يمينه","https://www.aldiwan.net/poem39768.html","الطويل"],[353,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[364,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[366,"نعي زاد فيه الدهر ميما","https://www.aldiwan.net/poem17278.html","الوافر"],[371,"تبيت أحاديث الهوى لك تفتري","https://www.aldiwan.net/poem57453.html","الطويل"],[400,"قمر الهدى","https://www.aldiwan.net/poem6776.html","عموديه"],[406,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[416,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[416,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[432,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[432,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[439,"بسعدك لا بسعد أو سعاد","https://www.aldiwan.net/poem34782.html","الوافر"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[443,"نعم ذاك وجد الصب لا وجد دونه","https://www.aldiwan.net/poem55946.html","عموديه"],[458,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[458,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[458,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[464,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[464,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[464,"إذا هز بانات العذيب جنوبها","https://www.aldiwan.net/poem3620.html","عموديه"],[477,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[505,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[551,"ألا لله ما صنع الحمام","https://www.aldiwan.net/poem47251.html","الوافر"],[558,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[558,"وجود وأشيا ما لهن وجود","https://www.aldiwan.net/poem34627.html","الطويل"],[558,"فديتك يا من قد خفيت فلاحا","https://www.aldiwan.net/poem34672.html","الطويل"],[562,"كثير العمر في الدنيا قليل","https://www.aldiwan.net/poem52877.html","الكامل"],[587,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَما صِدقُ وَعدِكَ إِلّا حُلى","مُكَرَّمَةٍ جيدُها عاطِلُ",0,"ل",1,0],["وَما صافَحَت يَوماً يَدي يَدَ غادِرٍ","وَلا ضاقَ خُلقي عَن مُقامِ نَزيلِ",1,"ل",1,0],["وَما صَحبُكَ الأَدنَونَ إِلّا أَباعِدٌ","إِذا قَلَّ مالٌ أَو نَبَت بِكَ حالُ",2,"ل",1,0],["وَما صَرَعوهُ بِاللِحاظِ وَإِنَّما","لِأَرواحِهِم في مُقلَتَيهِ مَصارِعُ",3,"ع",1,0],["وَما صَبري وَقَد جاشَت هُمومي","إِلى أَمرٍ وَعَبِّ لَهُ عُبابي",4,"ي",1,0],["وَما صُنتُ شِعري عَنكَ زُهداً وَإِنَّما","هُوَ الدُرُّ لا يَمري بِغَيرِ الحَوالِبِ",5,"ب",1,0],["وَماصَعَهُم حَتّى تَحَطَّمَ سَيفُهُ","وَمَجَّتْ نَجيعاً في المَكَرِّ ذوائِبُهْ",6,"ب",2,0],["وَما صَبرُنا أَلّا نَبوحَ فَنَشتَكي","سَرائِرَ ما يُخفي الضَميرُ وَيُضمِرُ",7,"ر",1,0],["وَما صَدَّ عَمداً وَلَكِنَّهُ","طَريدُ مَلالَةِ أَحبابِهِ",8,"ه",1,0],["وَما صَدَّ عَن فِعلِ الأَذى قَولُ مُرسَلٍ","وَما راعَ مَفتونَ الحَياةِ نَذيرُ",9,"ر",1,0],["وَما صَنَعتَ بِآمالٍ لَنا طُوِيَت","يا قَبرُ فيكَ وَعَفّى رَسمَها القِدَمُ",10,"م",1,0],["وَما صَرَمَت إِذ لَم تَكُن مُستَثيبَةً","بِعاقِبَةٍ حَبلَ اِمرِئٍ مِن حِبالِها",11,"ل",3,0],["وَما صُحبَتي عَبدَ العَزيزِ وَمِدحَتي","بِعارِيَةٍ يَرتَدُّها مَن يُعيرُها",12,"ر",3,0],["وَمَا صَحَابَتُهُ إِلاَّ شُيُوخُ نُهًى","إِنْ سُوهِمُوا فِي مَجَالاتِ الْعُلَى سَهَمُوا",13,"م",3,0],["وما صاحب البيت الحقير بناؤها","بأفزع من ربّ البّلاط الممرَّد",14,"د",1,0],["وَما صَبري عَنِ الذَلفاءِ إِلّا","كَصَبرِ الحوتِ عَن ماءِ الفُراتِ",15,"ت",1,0],["وَما صَدَّ عَنّي خالِدٌ مِن بَقِيَّةٍ","وَلَكِن أَتَت دوني الأُسودُ الهَواصِرُ",16,"ر",1,1],["وما صامتٌ يمضي ويرجع حائراً","ويقضي على أوصاله الوصلُ والصدُّ",17,"د",1,1],["وماصَ عِرضي فردّهُ يققاً","كالثوب أنقتهُ كفُّ رحّاضه",18,"ض",2,0],["وما صلُحَ الرأسُ الذي أنت حامِلٌ","أبا حسنٍ إلا لقفد قَذالِ",19,"ل",1,0],["وما صانَ كِنٌّ قطُّ وجْهاً أذالَهُ","سؤالُ مصونِ المالِ عندَ المغارمِ",20,"م",1,0],["وَما صُوَرُ الأَشياءِ بَعدَكَ غَيرَها","وَلَكِنَّما قَد شَوَّهَتها يَدُ الحُزنِ",21,"ن",1,0],["وَما صَدَّ عَن أَمرٍ مُريبٍ وَإِنَّما","رَآني قَتيلاً في الدُجى فَتَهَيَّبا",22,"ب",2,0],["وَما صَرَمتُكِ حَتّى قُلتِ مُعلَنَةً","لا ناقَةٌ لِيَ في هَذا وَلا جَمَلُ",23,"ل",1,0],["وَما صائِبٌ مِن نابِلٍ قَذَفَت بِهِ","يَدٌ وَمُمِرُّ العُقدَتَينِ وَثيقُ",24,"ق",1,1],["وَما صادِياتٌ حُمنَ يَوماً وَلَيلَةً","عَلى الماءِ يُغشَينَ العِصِيَّ حَواني",25,"ي",1,0],["وما صنوف الرعايا حافلين به","إلا كبيت برب البيت محتفل",26,"ل",1,0],["وَما صَغُرَ الأُردُنُّ وَالساحِلُ الَّذي","حُبيتَ بِهِ إِلّا إِلى جَنبِ قَدرِكا",27,"ك",2,0],["وَما صَبابَةُ مُشتاقٍ عَلى أَمَلٍ","مِنَ اللِقاءِ كَمُشتاقٍ بِلا أَمَلِ",28,"ل",1,0],["وَما صَحِبتُكَ عَن خَوفٍ وَلا طَمَعِ","بَلِ الشَمائِلُ وَالأَخلاقُ تَصطَحِبُ",29,"ب",1,0],["وَما صارَعَتني الكَأسُ حَتّى أَعانَها","عَلَيَّ بِعَينَيهِ الغَداةَ مُديرُها",30,"ر",3,0],["وَما صاحِبي إِلّا الحُسامُ وَبَزُّهُ","وَإِلّا العَلَنداةُ الأَمونُ وَكورُها",30,"ر",3,0],["وَما صَليبُ بنِ آشوطٍ بِأَمنَعَ مِن","صَليبِ بُرجانَ إِذ خَلّوهُ وَاِنجَفَلوا",31,"ل",3,0],["وَما صِرتُ حَربَ الدَهرِ حَتّى أَضاءَ لَي","تَحامُلُهُ الأَوفى عَلى مَن يُسالِمُه",32,"م",2,0],["وَما صَحَّ إِلّا شاهِدٌ صَحَّ غَيبُهُ","وَما تُنبِتُ الأَغصانَ إِلّا عُروقُها",33,"ق",3,0],["وَما صَحَّ فَرعٌ أَصلُهُ الدَهرَ فاسِدٌ","وَلَكِن يَصِحُّ الفَرعُ ما صَحَّ أَصلُهُ",34,"ل",2,0],["وما صابني إلا مريجٌ بضربةٍ","تكون سؤالاً للرّضى وجوابا",35,"ب",2,0],["وَما صارَ في ذا اليَومِ عَذلُكَ كُلُّهُ","عَدُوِّيَ حَتّى صارَ جَهلُكَ صاحِبي",36,"ب",2,0],["وَما صَدَّتِ الحَسناءُ عَنكَ زَهادَةً","وَلَكِن زَهاها أَنَّها تُتَعَشَّقُ",37,"ق",1,0],["وَما صَبَرَت عَن ذِكرِكِ النَفسُ ساعَةً","وَإِن كُنتُ أَحياناً كَثيراً أَلومُها",38,"م",3,0],["وَما صَولَةُ الحِقِّ الضَئيلُ وَخَطرُهُ","إِذا خَطَرتَ يَوماً قَساورُ بُزَّلُ",39,"ل",1,0],["وَما صَهباءُ في حافاتِ جَونٍ","بِعانَةَ مِن خَراطيمِ السُلافِ",40,"ف",1,0],["وما صلّى وصامَ بطورسينا","أشعيا عند مفترقِ الصديق",41,"ق",1,0],["وَما صَدَقَت رُؤيايَ يَحفُفنَ مَركَباً","وَفي المَركَبِ المَحفوفِ بَدرٌ مُتَوَّجُ",42,"ج",1,0],["وَما صَحَّ لِلمَرءِ المُحَصِّلِ أَنَّهُ","بِكُفوانَ قَبرٌ لِلإِمامِ يُزارُ",43,"ر",1,0],["وَما صَحَّ عِندي أَنَّ ذاتَ خَلاخِلٍ","تُقفى مِنَ الجِنِّ الغُواةِ بِتابِعِ",44,"ع",1,0],["وَما صَحَّ إِلّا اِمرُؤٌ","تَصَرَّفَ ثُمَّ اِنجَدَل",45,"ل",1,0],["وَما صَحَّ وُدُّ الخِلِّ فيها وَإِنَّما","تَغُرُّ بِوِدٍّ في الحَياةِ سَقيمِ",46,"م",1,0],["وما صُغْتَ قولاً أو هتفتَ بآيةٍ","خَلا مَنطقي من لفظها وقصيدي",47,"ي",1,0],["وما صَدَأٌ يعْتادُها غيرَ خُضْرَةٍ","تُجَلّلُ عِطْفَيْها من العَرْمَضِ البالي",48,"ل",2,0],["وَمَا صُدَّ عَنْ إسْعَادِهِ بَاسِطٌ يَداً","وَلاَ رُدَّ عَنْ جَدْوَاهُ طَارِقُ بَاب",49,"ب",1,0],["وما صامَ من خَصْرٍ لهنّ مُخَفَّفٍ","وأفَطرَ من رِدْفٍ لهنّ مُثقّلِ",50,"ل",1,0],["وما صنعتَ بفكرٍ","ماضي الشَباةِ وذِهْن",51,"ن",1,0],["وَما صَليبُ ابنِ آشُوط بأمنَعَ مِنْ","صَليبِ بَرْجانَ، إذْ خَلّوْهُ، وانجَفلوا",52,"ل",3,0],["وَ ما صَحِبتُكَ من خوْفٍ ولا طَمَعٍ،","بلِ الشّمائلُ، والأخلاقُ تُصْطَحَبُ",53,"ب",1,0],["وَما صَرَعَتْني الكأسُ حتى أعانَها","عَليّ، بعَيْنَيْهِ الغَداةَ، مُديرُهَا",54,"ر",3,0],["وما صحّ للمرءِ المحصِّلِ أنّهُ","بكُوفانَ قَبرٌ، للإمامِ، يُزار",55,"ر",1,0],["وما صرعوا عدوّهم بنعمى","ولكنّ الوفاء هو الصريع",56,"ع",1,0],["وما صاحب الآمال قط بصاحب","على انه اثر الحوادث يقتفي",57,"ي",1,0],["وما صَدَّ عن مرآك إلا شقيُّها","وما حلَّ في علياكَ إلا سَعيدُها",58,"د",3,0],["وما صبرُ من أفنى الزمانُ حماتهُ","وجرعَهُ من فقدِ أنصارِهِ صبرا",59,"ر",2,0],["وما صيغ لولا معصماهُ سِوارُها","ولا صين لولا مَنكِباه حريرُها",60,"ر",3,0],["وما صبرت رضىً مني بفرقته","لكن رضىً بقضاءِ الله والقدر",61,"ر",1,0],["وَماصَحَّ عَنهُ مِن حَديثٍ فَدِنِ بِهِ","وَزُر مِنهُ أَهدى مُرشِدٍ وَمُنَبِّهِ",62,"ه",1,0],["وَماصَحَّ لي في قَصدِ يَثرِبَ وَأَيُّها","فَها أَنا لا أَنفَكُّ ما عاقَ لأيُها",63,"ه",2,0],["وما صدّني عن هز أغصان جوده","تهجمث حامٍ أو رقيبٌ يصونها",64,"ن",3,0],["وما صغر الأشياء في عين أحمد","وقد عظمت الا التفكر في العقبا",65,"ب",2,0],["وما صدق المرحوم حتى جرت له","قضايا أصاب وهي من أصدق النذر",66,"ر",1,0],["وما صَبَغَت صِبغَ الخدود مدامةٌ","بها صُبِغَت قبل الخدود الأناملُ",67,"ل",1,0],["وما صَدُوقٌ بلا نُطْقٍ ولا فَهَمٍ","بَرٌّ أَمينٌ مُبينٌ صامِتٌ حَكَمُ",68,"م",1,0],["وما صاحبُ العرشِ المُدِلِّ بتاجِه","بأعرقَ مَجداً مِنكَ في مَوقِف الفَخر",69,"ر",1,0],["وما صباح المنى قد لاح حيث شدا","ليل الخطوب له فجرٌ من الفرج",70,"ج",1,0],["وما صهوات الخيل إلا مكائد","ولا حلقات الزغف إلا حبائل",71,"ل",1,0],["وما صحب الإنسان أنقى من التقى","وأبقى له من ناصر وظهير",72,"ر",1,0],["وما صدَعَت لك البُرحاء قَلباً","وَلا أَودى بمهجتكَ الهُيامُ",73,"م",1,0],["وَما صورَةُ الإنسانِ إلّا نموذجٌ","عَلى العالم الكلّيّ تُحذى حُدودها",74,"د",3,0],["وما صين إلا للبلى يستطيبه","فيا ويحهم كانوا عن العقل في عقل",75,"ل",1,0],["وَما صاحِبُ السَبعينَ وَالعَشرِ بَعدَها","بِأَقرَبَ مِمَّن حَنَّكَتهُ القَوابِلُ",76,"ل",1,1],["وَما صَدَّني عَن صَوتِ داعيهِ الصَدى","وَلم يُؤَخِّر قَدَمي عَنهُ الخَوَر",77,"ر",1,0],["وَما صادح الأَفراح غَنّى فَأَطرَبَت","أَغاريدُهُ صَباً تَوالَت شُجونهُ",78,"ن",2,0],["وَما صادح الأَفراح في دَوحة الهَنا","تَغنّى وَأَطيارُ القُلوب تجاوبُه",79,"ب",2,0],["وما صادياتٌ ماطلَ السّيرُ وِردها","فأكبادها شوقاً إليه تذوب",80,"ب",1,0],["وَما صَدَقَ النَذيرُ بِهِ لِأَنّي","رَأَيتُ الشَمسَ تَطلُعُ وَالنُجوما",81,"م",2,0],["وما صارَ منها أشهبُ اللونِ أدهماً","من النَّقع حتى صارَ بالدم أشقَرا",82,"ر",2,0],["وما صدقوا، فقد كَذَبُوا علينا","وصاغوا من روايتهم فصولا",83,"ل",2,0],["وَما صَبرُ مَحزونٍ جناح فؤادِهِ","يُرَفرِفُ ما بَينَ التَرائِبِ وَالنَحرِ",84,"ر",1,0],["وما صَبَرَتْ عنك النفوس وإنَّما","يصبِّرها تعليلُ عاقبة الصبر",85,"ر",1,0],["وما صَعَّرْتُ للأيام خدِّي","ولم أخفِضْ لنائبةٍ جناحي",86,"ح",2,0],["وما صابَتْ سماءُ الحربِ إلا","سقى أبطالَها شرْياً وصابا",87,"ب",2,0],["وما صدّني عن ترك حبّكَ فتنةً","بخدٍّ كروضٍ أو رضابٍ كسلسَلِ",88,"ل",1,0],["وما صُوِّرْتَ إلا من حديدٍ","ولا استعْمِلتَ إلا للجِلادِ",89,"د",1,0],["وَمَا صَرعَ القتلى كَعَيْنَيْهِ صارِعٌ","ولا كَلَمَ الجرْحى كَصُدْغَيْهِ كالِمُ",90,"م",1,0],["وما صيف لبنان خفي عليكم","ولا بعد سوق الغرب ما تقصدونه",91,"ن",2,0],["وما صبت للحج نفسٌ واجتبت","ركنَ الصفا يجاورُ الحُجُونا",92,"ن",2,0],["وما صُرِفوا عن مقام الصلاةِ","ولا عُنِّفوا في بُنَى المسجِدِ",93,"د",1,0],["وما صاحبي قلبٌ بظنٍّ مُرَجَّمٍ","إلى غيركم في العالمين مُقلِّبي",94,"ي",1,0],["وما صوّح النبتُ القشيبُ لكبرةِ","سوى أنَّ عزمي جذوةٌ تتضرَّم",95,"م",1,0],["وما صانها داراً تحلُّ وأختها","ولكنهُ صانَ الحطيمَ وزمزما",96,"م",2,0],["وما صافحت تلك الغصون خيانةً","ولكنني في هصرها استنيبها",97,"ب",3,0],["وما صارمٌ يَفْري الضرائبَ باتكٌ","مَخُوفُ سُطا الحدَّينِ يُعزى إلى الهندِ",98,"د",1,0],["وما صدَّقَ فرعونُ","فدام الظلمُ إنسانا",99,"ن",2,0],["وما صابتْ سهامُ الموت خلقاً","إذا طاشتْ له عنك السّهامُ",100,"م",1,0],["وما صدق الراوي لها وهو كافر","وأخبار أهل الكفر باطلة الخُبْر",101,"ر",1,0],["وما صور الأسماء أجمعها سوى","تفاصيل أفلاك وهن رصود",102,"د",1,0],["وما صبغة الأشياء إلا شؤونه","بها يتجلّى للأنام كفاحا",103,"ح",2,0],["وما صِغَرُ الجُسومِ يَضُرُّ شيئاً","إذا كَبُرتْ بجانِبهِ العُقولُ",104,"ل",1,0],["وما صح هذا الوصف من نفس فعله","ولا أمره فافهم وراجعه ترشد",105,"د",1,0]]}