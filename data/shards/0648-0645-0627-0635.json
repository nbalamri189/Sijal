{"poems":[[53,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[53,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[53,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[63,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[55,"كتمت ومن أهوى هوانا فلم نبح","https://www.aldiwan.net/poem26308.html","الطويل"],[55,"أقل الزيارة لما بدا","https://www.aldiwan.net/poem26467.html","المتقارب"],[86,"رثاك أمير الشعر في الشرق وانبرى","https://www.aldiwan.net/poem10489.html","الطويل"],[86,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[35,"ألا يا لقومي للنوى وانفتالها","https://www.aldiwan.net/poem39092.html","الطويل"],[35,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[27,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[4,"وما صد عني خالد من بقية","https://www.aldiwan.net/poem21223.html","الطويل"],[72,"وما صامت يمضي ويرجع حائرا","https://www.aldiwan.net/poem18579.html","الطويل"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[70,"رسول الرضا أهلا وسهلا ومرحبا","https://www.aldiwan.net/poem43022.html","الطويل"],[38,"قالت سليمى أتنوي اليوم أم تغل","https://www.aldiwan.net/poem7736.html","البسيط"],[32,"وما صائب من نابل قذفت به","https://www.aldiwan.net/poem27777.html","الطويل"],[32,"أرى كل معشوقين غيري وغيرها","https://www.aldiwan.net/poem27811.html","الطويل"],[85,"بين الملامة فيكم والهوى الجلل","https://www.aldiwan.net/poem6819.html","البسيط"],[43,"تهنا بصور أم نهنئها بك","https://www.aldiwan.net/poem9751.html","الطويل"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[45,"نحن الفداء فمأخوذ ومرتقب","https://www.aldiwan.net/poem10890.html","البسيط"],[45,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[45,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[49,"ألا رب أحزان شجاني طروقها","https://www.aldiwan.net/poem62196.html","الطويل"],[49,"سل القصر أودى أهله أين أهله","https://www.aldiwan.net/poem63097.html","الطويل"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[44,"على مثلها من أربع وملاعب","https://www.aldiwan.net/poem30579.html","الطويل"],[74,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[33,"ألا حبذا يوم يقر به الصبا","https://www.aldiwan.net/poem25810.html","الطويل"],[21,"غذوتك مولودا وعلتك يافعا","https://www.aldiwan.net/poem36184.html","الكامل"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[48,"بمعودية الدين العتيقِ","https://www.aldiwan.net/poem66571.html","الوافر"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[46,"عقولكم في كل حال بكية","https://www.aldiwan.net/poem22532.html","الطويل"],[46,"ما لي رأيتك لا تلم بمسجد","https://www.aldiwan.net/poem22966.html","الكامل"],[46,"أمل حبيب أدل","https://www.aldiwan.net/poem23279.html","مجزوء المتقارب"],[46,"إذا لم تكن دنياك دار إقامة","https://www.aldiwan.net/poem23371.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43881","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[45,"لا دِمنَةٌ بلِوَى خَبتٍ، وَلا طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32200",""],[45,"نحنُ الفِداءُ، فمَأخُوذٌ وَمُرْتَقَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31563",""],[45,"مَغَاني سُلَيْمَى بالعَقيقِ، وَدُورُها","https://www.poetsgate.com/ViewPoem.aspx?id=31289",""],[46,"عقولُكُم، في كلّ حالٍ، بكِيّةٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=20080",""]],"verses":[["وَما صِدقُ وَعدِكَ إِلّا حُلى","مُكَرَّمَةٍ جيدُها عاطِلُ",0,"ل",1,0],["وَما صافَحَت يَوماً يَدي يَدَ غادِرٍ","وَلا ضاقَ خُلقي عَن مُقامِ نَزيلِ",1,"ل",1,0],["وَما صَحبُكَ الأَدنَونَ إِلّا أَباعِدٌ","إِذا قَلَّ مالٌ أَو نَبَت بِكَ حالُ",2,"ل",1,0],["وَما صَرَعوهُ بِاللِحاظِ وَإِنَّما","لِأَرواحِهِم في مُقلَتَيهِ مَصارِعُ",3,"ع",1,0],["وَما صَبري وَقَد جاشَت هُمومي","إِلى أَمرٍ وَعَبِّ لَهُ عُبابي",4,"ي",1,0],["وَما صُنتُ شِعري عَنكَ زُهداً وَإِنَّما","هُوَ الدُرُّ لا يَمري بِغَيرِ الحَوالِبِ",5,"ب",1,0],["وَماصَعَهُم حَتّى تَحَطَّمَ سَيفُهُ","وَمَجَّتْ نَجيعاً في المَكَرِّ ذوائِبُهْ",6,"ب",2,0],["وَما صَبرُنا أَلّا نَبوحَ فَنَشتَكي","سَرائِرَ ما يُخفي الضَميرُ وَيُضمِرُ",7,"ر",1,0],["وَما صَدَّ عَمداً وَلَكِنَّهُ","طَريدُ مَلالَةِ أَحبابِهِ",8,"ه",1,0],["وَما صَدَّ عَن فِعلِ الأَذى قَولُ مُرسَلٍ","وَما راعَ مَفتونَ الحَياةِ نَذيرُ",9,"ر",1,0],["وَما صَنَعتَ بِآمالٍ لَنا طُوِيَت","يا قَبرُ فيكَ وَعَفّى رَسمَها القِدَمُ",10,"م",1,0],["وَما صَرَمَت إِذ لَم تَكُن مُستَثيبَةً","بِعاقِبَةٍ حَبلَ اِمرِئٍ مِن حِبالِها",11,"ل",3,0],["وَما صُحبَتي عَبدَ العَزيزِ وَمِدحَتي","بِعارِيَةٍ يَرتَدُّها مَن يُعيرُها",12,"ر",3,0],["وَمَا صَحَابَتُهُ إِلاَّ شُيُوخُ نُهًى","إِنْ سُوهِمُوا فِي مَجَالاتِ الْعُلَى سَهَمُوا",13,"م",3,0],["وما صاحب البيت الحقير بناؤها","بأفزع من ربّ البّلاط الممرَّد",14,"د",1,0],["وَما صَبري عَنِ الذَلفاءِ إِلّا","كَصَبرِ الحوتِ عَن ماءِ الفُراتِ",15,"ت",1,0],["وَما صَدَّ عَنّي خالِدٌ مِن بَقِيَّةٍ","وَلَكِن أَتَت دوني الأُسودُ الهَواصِرُ",16,"ر",1,1],["وما صامتٌ يمضي ويرجع حائراً","ويقضي على أوصاله الوصلُ والصدُّ",17,"د",1,1],["وماصَ عِرضي فردّهُ يققاً","كالثوب أنقتهُ كفُّ رحّاضه",18,"ض",2,0],["وما صلُحَ الرأسُ الذي أنت حامِلٌ","أبا حسنٍ إلا لقفد قَذالِ",19,"ل",1,0],["وما صانَ كِنٌّ قطُّ وجْهاً أذالَهُ","سؤالُ مصونِ المالِ عندَ المغارمِ",20,"م",1,0],["وَما صُوَرُ الأَشياءِ بَعدَكَ غَيرَها","وَلَكِنَّما قَد شَوَّهَتها يَدُ الحُزنِ",21,"ن",1,0],["وَما صَدَّ عَن أَمرٍ مُريبٍ وَإِنَّما","رَآني قَتيلاً في الدُجى فَتَهَيَّبا",22,"ب",2,0],["وَما صَرَمتُكِ حَتّى قُلتِ مُعلَنَةً","لا ناقَةٌ لِيَ في هَذا وَلا جَمَلُ",23,"ل",1,0],["وَما صائِبٌ مِن نابِلٍ قَذَفَت بِهِ","يَدٌ وَمُمِرُّ العُقدَتَينِ وَثيقُ",24,"ق",1,1],["وَما صادِياتٌ حُمنَ يَوماً وَلَيلَةً","عَلى الماءِ يُغشَينَ العِصِيَّ حَواني",25,"ي",1,0],["وما صنوف الرعايا حافلين به","إلا كبيت برب البيت محتفل",26,"ل",1,0],["وَما صَغُرَ الأُردُنُّ وَالساحِلُ الَّذي","حُبيتَ بِهِ إِلّا إِلى جَنبِ قَدرِكا",27,"ك",2,0],["وَما صَبابَةُ مُشتاقٍ عَلى أَمَلٍ","مِنَ اللِقاءِ كَمُشتاقٍ بِلا أَمَلِ",28,"ل",1,0],["وَما صَحِبتُكَ عَن خَوفٍ وَلا طَمَعِ","بَلِ الشَمائِلُ وَالأَخلاقُ تَصطَحِبُ",29,"ب",1,0],["وَما صارَعَتني الكَأسُ حَتّى أَعانَها","عَلَيَّ بِعَينَيهِ الغَداةَ مُديرُها",30,"ر",3,0],["وَما صاحِبي إِلّا الحُسامُ وَبَزُّهُ","وَإِلّا العَلَنداةُ الأَمونُ وَكورُها",30,"ر",3,0],["وَما صَليبُ بنِ آشوطٍ بِأَمنَعَ مِن","صَليبِ بُرجانَ إِذ خَلّوهُ وَاِنجَفَلوا",31,"ل",3,0],["وَما صِرتُ حَربَ الدَهرِ حَتّى أَضاءَ لَي","تَحامُلُهُ الأَوفى عَلى مَن يُسالِمُه",32,"م",2,0],["وَما صَحَّ إِلّا شاهِدٌ صَحَّ غَيبُهُ","وَما تُنبِتُ الأَغصانَ إِلّا عُروقُها",33,"ق",3,0],["وَما صَحَّ فَرعٌ أَصلُهُ الدَهرَ فاسِدٌ","وَلَكِن يَصِحُّ الفَرعُ ما صَحَّ أَصلُهُ",34,"ل",2,0],["وما صابني إلا مريجٌ بضربةٍ","تكون سؤالاً للرّضى وجوابا",35,"ب",2,0],["وَما صارَ في ذا اليَومِ عَذلُكَ كُلُّهُ","عَدُوِّيَ حَتّى صارَ جَهلُكَ صاحِبي",36,"ب",2,0],["وَما صَدَّتِ الحَسناءُ عَنكَ زَهادَةً","وَلَكِن زَهاها أَنَّها تُتَعَشَّقُ",37,"ق",1,0],["وَما صَبَرَت عَن ذِكرِكِ النَفسُ ساعَةً","وَإِن كُنتُ أَحياناً كَثيراً أَلومُها",38,"م",3,0],["وَما صَولَةُ الحِقِّ الضَئيلُ وَخَطرُهُ","إِذا خَطَرتَ يَوماً قَساورُ بُزَّلُ",39,"ل",1,0],["وَما صَهباءُ في حافاتِ جَونٍ","بِعانَةَ مِن خَراطيمِ السُلافِ",40,"ف",1,0],["وما صلّى وصامَ بطورسينا","أشعيا عند مفترقِ الصديق",41,"ق",1,0],["وَما صَدَقَت رُؤيايَ يَحفُفنَ مَركَباً","وَفي المَركَبِ المَحفوفِ بَدرٌ مُتَوَّجُ",42,"ج",1,0],["وَما صَحَّ لِلمَرءِ المُحَصِّلِ أَنَّهُ","بِكُفوانَ قَبرٌ لِلإِمامِ يُزارُ",43,"ر",1,0],["وَما صَحَّ عِندي أَنَّ ذاتَ خَلاخِلٍ","تُقفى مِنَ الجِنِّ الغُواةِ بِتابِعِ",44,"ع",1,0],["وَما صَحَّ إِلّا اِمرُؤٌ","تَصَرَّفَ ثُمَّ اِنجَدَل",45,"ل",1,0],["وَما صَحَّ وُدُّ الخِلِّ فيها وَإِنَّما","تَغُرُّ بِوِدٍّ في الحَياةِ سَقيمِ",46,"م",1,0],["وما صُغْتَ قولاً أو هتفتَ بآيةٍ","خَلا مَنطقي من لفظها وقصيدي",47,"ي",1,0],["وما صَدَأٌ يعْتادُها غيرَ خُضْرَةٍ","تُجَلّلُ عِطْفَيْها من العَرْمَضِ البالي",48,"ل",2,0],["وَمَا صُدَّ عَنْ إسْعَادِهِ بَاسِطٌ يَداً","وَلاَ رُدَّ عَنْ جَدْوَاهُ طَارِقُ بَاب",49,"ب",1,0],["وما صامَ من خَصْرٍ لهنّ مُخَفَّفٍ","وأفَطرَ من رِدْفٍ لهنّ مُثقّلِ",50,"ل",1,0],["وما صنعتَ بفكرٍ","ماضي الشَباةِ وذِهْن",51,"ن",1,0],["وَما صَليبُ ابنِ آشُوط بأمنَعَ مِنْ","صَليبِ بَرْجانَ، إذْ خَلّوْهُ، وانجَفلوا",52,"ل",3,0],["وَ ما صَحِبتُكَ من خوْفٍ ولا طَمَعٍ،","بلِ الشّمائلُ، والأخلاقُ تُصْطَحَبُ",53,"ب",1,0],["وَما صَرَعَتْني الكأسُ حتى أعانَها","عَليّ، بعَيْنَيْهِ الغَداةَ، مُديرُهَا",54,"ر",3,0],["وما صحّ للمرءِ المحصِّلِ أنّهُ","بكُوفانَ قَبرٌ، للإمامِ، يُزار",55,"ر",1,0]]}