4279","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[77,"كما شيكم من أجله انكمش السعد","https://www.poetsgate.com/ViewPoem.aspx?id=33925",""],[49,"ألاَ للهِ أَنْتَ مَتَى تَتُوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16962",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"أول العهد","https://www.poetsgate.com/ViewPoem.aspx?id=179151",""],[90,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[99,"قطرة الندى","https://www.poetsgate.com/ViewPoem.aspx?id=570",""],[101,"سارِي الْهَواءِ مَلَكْتَ أيَّ جَناحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62448&r=&rc=40",""]],"verses":[["وَتُصبينا دِيارُ الحَي","يِ إِن ساروا وَإِن حَلّوا",0,"ل",3,0],["وَتُصبِحُ لا تَني عَجَباً وَقولاً","أَهَذا الحَدُّ أَطلَقَ مِن ذُبابي",1,"ي",1,0],["وَتَصقُلُ أَنجُمَهُ العاصِفاتُ","إِذا صَدِيَت مِن غُمودِ السَحابِ",2,"ب",1,0],["وَتُصغي لَنا فارِياتُ الخُطو","بِ قَواضِبَ ما آجَنَت بِالصَدا",3,"ا",1,0],["وَتَصبو إِلى لَيلى وَقَد شَطَّتِ النَّوَى","وَمِن أَجلِها حَنَّتْ وَرَنَّتْ وَأَنَّتِ",4,"ت",1,0],["وَتَصْحَبُني سَمْراءُ ظَمْأَى لَدى الوَغَى","وَأُعْرِضُ عَنْ بَيضاءَ رَيّا المَعاصِمِ",5,"م",1,0],["وتصَفّحِ الكَلِمَ التي وَصَلَتْ بها","مِرَرَ البلاغَةِ شِدّةٌ ولَيانُ",6,"ن",1,0],["وتُصْغي الأرحَبيَّةُ في ذَراهُ","إِلى قُبٍّ أياطِلُهُنَّ جُرْدِ",7,"د",1,0],["وتَصْبو إِلى ذاكَ الزّمانِ فقَد مَضى","حَميداً وذُمَّتْ بعْدَ رامَةَ أزمانُ",8,"ن",1,0],["وتَصَرَّمَتْ تِلكَ السِّنونَ وشاغَبَتْ","نُوَبٌ تَفُلُّ السَّيفَ وهْوَ ذَليقُ",9,"ق",1,0],["وتَصُدُرُ عَنْ لَبَّاتِهِنَّ نَواهِلاً","صُدورُ العَوالي وهْيَ مُزْوَرَّةٌ تَقْطو",10,"ط",2,0],["وتُصيبُ شاكِلَةَ الرَّمِيِّ إذا بَدَتْ","رِيَبٌ تُهيبُ بِمُقْلَةٍ شَوْساءِ",11,"ا",2,0],["وَتَصهَلُ خَوفاً وَالرِماحُ قَواصِدٌ","إِلَيها وَتَنسَلُّ اِنسِلالَ الأَراقِمِ",12,"م",1,0],["وَتَصْدُقُ وَعْدَكَ الصَّدَقَاتُ تُعْلِي","مَقَامَكَ فِي الْمَقَامَاتِ الْكِرَامِ",13,"م",1,0],["وَتُصْمِي رَمَايَا الْغَائِبَاتِ بَفِكْرَةٍ","يُسَدِّدُهَا التَّقْوَى وَيُنْجِدُهَا الْعِلْمُ",14,"م",1,0],["وتَصْريفُهُ المَشْؤومُ فَلْتَتَذكّروا","وما قُلْتُ إلا بالذي علِمَتْ سعْدُ",15,"د",1,0],["وتصْبو الى عهْدٍ هُنالِكَ سالِفٍ","فتُبْدي منَ الشّوْقِ المبرِّحِ ما تُبْدي",16,"د",2,0],["وَتُصبِحُ عَن غَبِّ السُرى وَكَأَنَّها","إِذا ضُرِبَ الأَقصى مِنَ الرَّكبِ تُضرَبُ",17,"ب",1,0],["وَتَصيرُ بَعدَ عَمارَةٍ","يَوماً لِأَمرِ خَرابِها",18,"ب",3,0],["وَتُصبِحُ مِن غِبِّ السُرى وَكَأَنَّما","أَلَمَّ بِها مِن طائِفِ الجِنِّ أَولَقُ",19,"ق",1,0],["وَتَصونُ مَعنى رَبِّهِ","صَونَ اللَآلِئِ في المَحارِ",20,"ر",1,0],["وَتَصقُلُ اللَفظَ في عَيني فَأَحسَبُني","أَرى فِرِندَ سُيوفَ الهِندِ في الكُتُبِ",21,"ب",1,0],["وَتَصدُر شَتّى مِن مَصَبٍّ وَمُصعِدٍ","إِذا ما خَلَت مِمَّن يَحُلُّ المَنازِلُ",22,"ل",1,0],["وَتَصِفُ النَّاسَ عَلَى خِبْرَةٍ","حَتَّى تَرَاهُمْ صُوَراً مَاثِلَهْ",23,"ل",2,0],["وَتَصِفُ الأَحْوَالَ مَشْهُودَةً","كَأَنَّهَا المِرْسَمَةُ النَّاقِلَهْ",23,"ل",2,0],["وتصرّفوا في أمرها بمهارة","وذروا السيوف فأنهنّ جوامد",24,"د",1,0],["وتصوّر المعنى الدقيق فردّه","كالصبح منفلقاً أوان ظهوره",25,"ر",2,0],["وَتُصبِحُ يَومَ الخِمسِ وَهيَ شِمِلَّةٌ","مَروحاً تُقالي الصَحصَحانَ العَمَرَّدا",26,"د",2,0],["وَتَصُكُّ المَروَ لَمّا هَجَّرَت","بِنَكيبٍ مَعِرٍ دامي الأَظَلّ",27,"ل",1,0],["وَتَصَيَّفا بَعدَ الرَبيعِ وَأَحنَقا","وَعَلاهُما مَوقودُهُ المَسمومُ",28,"م",1,0],["وَتَصَرُّفُ الأَيّامِ حَت","تى ما يَرى شَيئاً يَسُرُّه",29,"ر",2,0],["وتصبح الشرب صرعى دونَ مجلسِها","وهي الحياةُ كأنَّ الشربَ أموات",30,"ت",1,0],["وتصرفون لأقوام عنايتكم","عنَّا وما قصرت عنكم مساعينا",31,"ن",2,0],["وتصيدُ لَحمَتها عُقا","بُ الموتِ يومَ تَرى عقابهْ",32,"ب",2,0],["وتصفَّحْ وجوهَ قولي وقلِّبْ","جانبيهِ وأنعِمِ التقليبا",33,"ب",2,0],["وتَصْطَادُ لي جدواه ما كنتُ صائداً","بشرخ الشباب الغَضِّ بل هي أصْيدُ",34,"د",1,0],["وتصرفُ أحياناً عن الشمس وجهَهُ","وجوهٌ تضاهي الشمس بل لا تجانس",35,"س",1,0],["وتصيبُ بَعضَهمُ المصيبةُ مرَّةً","فتنوب نوبتُها أخاه فَيَأتسي",36,"س",2,0],["وتصدّى للنيك في زينة الدُّن","يا وما تُشتَهى ولا تُسْتَهشُّ",37,"ش",1,0],["وتصريفُ ما فيه إذا ما اعتبرتَه","مثالٌ لتصريفِ القنا والقنابِلِ",38,"ل",1,0],["وَتُصبِحُ عَن غِبِّ السُرى وَكَأَنَّها","مُوَلَّعَةً تَخشى القَنيصَ شَبوبُ",39,"ب",1,0],["وَتَصُدُّني عَنكَ النَوى","وَأَصُدُّ عَن هَذا الصُدود",40,"د",1,0],["وَتَصلُحُ أَن يُطافَ بِها مَساءً","وَتَحسُنُ أَن تَكونَ شَرابَ طُهرِ",41,"ر",1,0],["وَتَصعَدُ النَفسُ مِنِّيَ لِلسَماءِ وَلا","حِبالُ نورٍ تَدَلَّت مِن دَراريها",42,"ي",3,0],["وَتَصدُرُ عَنهُ أَفعالٌ قِباحٌ","فَصَدِّق كُلَّ شَيءٍ قيلَ عَنهُ",43,"ه",1,0],["وَتَصعُبُ عِندي حالَةٌ ما أَلِفتُها","عَلى أَنَّ بُعدي عَن جَنابِكَ أَصعَبُ",44,"ب",1,0],["وتَصَادُمَ الأَهواءِ بالأَهواءِ","في كلِّ الأُمورْ",45,"ر",1,0],["وتَصبِحُ أَحلامَها يقْظةً","موَشَّحةً بغموضِ السَّحَرْ",46,"ر",1,0],["وتصوري فيها بشكل حمامة","وقعي على الجدران ثَمَّةَ واسجعي",47,"ي",1,0],["وتصلى لِلّه في اليوم خمساً","ويك ماذا تريد بالصلوات",48,"ت",1,0],["وتصدّق فهو حصن للغنى","وسلام النفس في دنيا ودين",49,"ن",1,0],["وتصيّد الآساد بال","آجام تسلبها الحراك",50,"ك",1,0],["وَتَصعَدُ مِن غَيرِ ما سُلَّمٍ","فَيا لِلمُصَوِّرِ هَذا الصُعود",51,"د",1,0],["وَتُصبِحُ تَلقاهُم وَتُمسي تَصُدُّهُم","وَتَظهَرُ في جِدِّ القِتالِ وَتَلعَبُ",52,"ب",1,0],["وَتَصالَحَت ثَمَرُ السِياطِ وَخَيلُهُ","وَأَوَت إِلَيها سوقُها وَالأَذرُعُ",53,"ع",1,0],["وتصعيدهم غير تصعيدنا","وتقطيرهم غير تقطيرنا",54,"ن",2,0],["وتصدم منكبَ الأيامِ عني","بعَطفةِ منعمٍ حِدبٍ محامي",55,"م",2,0],["وتصبُو إليه المكْرُماتُ عواطِلاً","تُزحْزَحُ عن أجيادِهنَّ القلائدُ",56,"د",1,0],["وتصطاد قلوب الشر","ب أجفان لها وسنى",57,"ن",2,0],["وَتُصبي الحَليمَ بِالحَديثِ يَلَذُّهُ","وَأَصواتِ حَليٍ أَو تَحَرُّكِ دُملُجِ",58,"ج",1,0],["وَتُصبِحُ صاحِكاً ظَهراً لِبَطنٍ","وَتَذكُر ما اِجتَرَمتَ فَلا تَذوبُ",59,"ب",1,0],["وَتَصريفُ هَذا الخَلقِ لِلَّهِ وَحدَهُ","وَكُلٌّ إِلَيهِ لا مَحالَةَ راجِعُ",60,"ع",1,0],["وتصطخبُ العواصف ساخرات","وتطعنني بأطراف الحرابِ",61,"ب",1,0],["وتصدَّى قمرٌ را","حَ على الأرض وجاء",62,"ا",2,0],["وتصدُرُ عن ندى يده الأماني","إذا وردتهُ هِيماً غير هيمِ",63,"م",1,0],["وَتَصَرُّفُ الإِخوانِ إِن كَشَّفتَهُم","يُنسيكَ طولَ تَصَرُّفِ الأَيّامِ",64,"م",1,0],["وَتُصبِحُ أَحزاني عَلَيهِ كَثيرَةً","وَيُصبِحُ سَعدي مِن مَوَدَّتِهِ نَحسا",65,"س",2,0],["وتصحيفُهُ يا أيها العدلُ جارحٌ","فإياكَ منهُ فَهْوَ كالوخزِ بالإبرْ",66,"ر",1,0],["وتصدِّيكَ للعظائمِ صعبٌ","وَهْوَ أشفى لغلِّ صدرِ الحقودِ",67,"د",1,0],["وَتَصفَحُ لا عَن ذِلَّةٍ صَفحَ رَحمَةٍ","فَتُرسِلُ دونَ الذَنبِ سَترَ غَفورِ",68,"ر",1,0],["وَتَصاهَلَت جُردٌ تَطيرُ إِلى الوَغى","وَكَأَنَّما طارَت بِهِنَّ رِياحُ",69,"ح",1,0],["وتصدُّ معرضةً تضنُّ بنفسِها","ولو اَنّ مَضجَعَها ذُرَى الأفلاكِ",70,"ك",1,0],["وَتُصَحَّحُ الآراءُ وَالراياتُ قَد","نَكَصَت عَلى الأَعقابِ واهِيَةَ العُرى",71,"ر",2,0],["وَتُصبِحُ دونَ الماءِ مِن يَومِ خِمسِها","عَصائِبُ حَسرى مِن رَذايا وَطُلَّحِ",72,"ح",1,0],["وَتَصهَلُ الخَيلُ عَلى أَبوابِها","وَيَكثُرُ الناسُ عَلى حُجّابِها",73,"ه",2,0],["وَتَصدُقُكَ الأَنباءُ إِن كُنتَ سائِلاً","وَحَسبُكَ مِمّا لا تَرى بِسَماعِ",74,"ع",1,0],["وتَصْحبُهُ دارُ المقامة حيثما","أناخَ وشَمْلُ المسلمينَ المجمَّع",75,"ع",1,0],["وَتُصبِحُ لا تَدري أَيَأتيكَ خافِضاً","نَصيبُكَ أَم تَغدو لَهُ فَتَرودُ",76,"د",1,0],["وَتُصاغُ لِلبيضِ الأَساوِرُ مِن","لُبسِ الأَساوِرِ سابِغَ الزَرَدِ",77,"د",1,0],["وَتَصطَفِقُ المَزاهِرُ مُخبِراتٍ","زَواهِرَ في المَآثِمِ بِاِصطِفاقِ",78,"ق",1,0],["وَتَصونُ حَبَّةُ خَردَلٍ قَدَمَ الفَتى","عَن زِلَّةٍ وَاليَومُ حِلفُ زَلازِلِ",79,"ل",1,0],["وَتُصغي إِلى المَينِ أَسماعُنا","وَنَصبو إِلى زُخرُفِ القائِلِ",80,"ل",1,0],["وَتُصبِحُ الذَرَّةُ الصُغرى لَهُ أَمَةً","وَالشَمسُ وَالبَدرُ مَعدودَينِ في الخَدَمِ",81,"م",1,0],["وَتَصُدُّ عَنكَ مَخيلَةَ الرَجُلِ ال","عِرّيضِ مو