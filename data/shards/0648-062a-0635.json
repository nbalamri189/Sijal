et/poem47006.html","الوافر"],[404,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[404,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[404,"زارت وقد ولى الهوى العذري","https://www.aldiwan.net/poem33903.html","الكامل"],[404,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[407,"بكرت عواذله تعاتبه","https://www.aldiwan.net/poem50158.html","أحذ الكامل"],[407,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[410,"أفكر في فرية ما تلاقي","https://www.aldiwan.net/poem31950.html","الوافر"],[417,"عفت أرسم من دار مي وأطلال","https://www.aldiwan.net/poem53921.html","الطويل"],[417,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[417,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[417,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[430,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[440,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[454,"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[454,"صفية في حنانك لي عزاء","https://www.aldiwan.net/poem61585.html","الوافر"],[459,"سألت غزالا شف قلبي عن اسمه","https://www.aldiwan.net/poem55817.html","الطويل"],[459,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[462,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[462,"تحاذره شهم النزال وصيده","https://www.aldiwan.net/poem15603.html","الطويل"],[465,"ولقد تركت الشعر مع علم به","https://www.aldiwan.net/poem3151.html","عموديه"],[480,"ذمم تباع وتشترى","https://www.aldiwan.net/poem37604.html","مجزوء الكامل"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[487,"يلومونني في اشتراء النخيل","https://www.aldiwan.net/poem466.html",""],[501,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[506,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[516,"هم الزمان بها فمنذ كفلتها","https://www.aldiwan.net/poem12234.html","الكامل"],[530,"وافت إلي من المقام الأشرف","https://www.aldiwan.net/poem37320.html","الكامل"],[530,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[539,"بعودتك الحمراء تم لها القصد","https://www.aldiwan.net/poem48240.html","عموديه"],[552,"إنا نعلل كلنا بمحال","https://www.aldiwan.net/poem47297.html","الكامل"],[552,"إني مررت على جنادل","https://www.aldiwan.net/poem47747.html","مجزوء الكامل"],[552,"ألا حبذا زمن الحاجر","https://www.aldiwan.net/poem47796.html","المتقارب"],[552,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[559,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[559,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[559,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[576,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَتُصبينا دِيارُ الحَي","يِ إِن ساروا وَإِن حَلّوا",0,"ل",3,0],["وَتُصبِحُ لا تَني عَجَباً وَقولاً","أَهَذا الحَدُّ أَطلَقَ مِن ذُبابي",1,"ب",2,0],["وَتَصقُلُ أَنجُمَهُ العاصِفاتُ","إِذا صَدِيَت مِن غُمودِ السَحابِ",2,"ب",1,0],["وَتُصغي لَنا فارِياتُ الخُطو","بِ قَواضِبَ ما آجَنَت بِالصَدا",3,"ا",1,0],["وَتَصبو إِلى لَيلى وَقَد شَطَّتِ النَّوَى","وَمِن أَجلِها حَنَّتْ وَرَنَّتْ وَأَنَّتِ",4,"ت",1,0],["وَتَصْحَبُني سَمْراءُ ظَمْأَى لَدى الوَغَى","وَأُعْرِضُ عَنْ بَيضاءَ رَيّا المَعاصِمِ",5,"م",1,0],["وتصَفّحِ الكَلِمَ التي وَصَلَتْ بها","مِرَرَ البلاغَةِ شِدّةٌ ولَيانُ",6,"ن",1,0],["وتُصْغي الأرحَبيَّةُ في ذَراهُ","إِلى قُبٍّ أياطِلُهُنَّ جُرْدِ",7,"د",1,0],["وتَصْبو إِلى ذاكَ الزّمانِ فقَد مَضى","حَميداً وذُمَّتْ بعْدَ رامَةَ أزمانُ",8,"ن",1,0],["وتَصَرَّمَتْ تِلكَ السِّنونَ وشاغَبَتْ","نُوَبٌ تَفُلُّ السَّيفَ وهْوَ ذَليقُ",9,"ق",1,0],["وتَصُدُرُ عَنْ لَبَّاتِهِنَّ نَواهِلاً","صُدورُ العَوالي وهْيَ مُزْوَرَّةٌ تَقْطو",10,"ط",2,0],["وتُصيبُ شاكِلَةَ الرَّمِيِّ إذا بَدَتْ","رِيَبٌ تُهيبُ بِمُقْلَةٍ شَوْساءِ",11,"ا",2,0],["وَتَصهَلُ خَوفاً وَالرِماحُ قَواصِدٌ","إِلَيها وَتَنسَلُّ اِنسِلالَ الأَراقِمِ",12,"م",1,0],["وَتَصْدُقُ وَعْدَكَ الصَّدَقَاتُ تُعْلِي","مَقَامَكَ فِي الْمَقَامَاتِ الْكِرَامِ",13,"م",1,0],["وَتُصْمِي رَمَايَا الْغَائِبَاتِ بَفِكْرَةٍ","يُسَدِّدُهَا التَّقْوَى وَيُنْجِدُهَا الْعِلْمُ",14,"م",1,0],["وتَصْريفُهُ المَشْؤومُ فَلْتَتَذكّروا","وما قُلْتُ إلا بالذي علِمَتْ سعْدُ",15,"د",1,0],["وتصْبو الى عهْدٍ هُنالِكَ سالِفٍ","فتُبْدي منَ الشّوْقِ المبرِّحِ ما تُبْدي",16,"د",2,0],["وَتُصبِحُ عَن غَبِّ السُرى وَكَأَنَّها","إِذا ضُرِبَ الأَقصى مِنَ الرَّكبِ تُضرَبُ",17,"ب",1,0],["وَتَصيرُ بَعدَ عَمارَةٍ","يَوماً لِأَمرِ خَرابِها",18,"ب",3,0],["وَتُصبِحُ مِن غِبِّ السُرى وَكَأَنَّما","أَلَمَّ بِها مِن طائِفِ الجِنِّ أَولَقُ",19,"ق",1,0],["وَتَصونُ مَعنى رَبِّهِ","صَونَ اللَآلِئِ في المَحارِ",20,"ر",1,0],["وَتَصقُلُ اللَفظَ في عَيني فَأَحسَبُني","أَرى فِرِندَ سُيوفَ الهِندِ في الكُتُبِ",21,"ب",1,0],["وَتَصدُر شَتّى مِن مَصَبٍّ وَمُصعِدٍ","إِذا ما خَلَت مِمَّن يَحُلُّ المَنازِلُ",22,"ل",1,0],["وَتَصِفُ النَّاسَ عَلَى خِبْرَةٍ","حَتَّى تَرَاهُمْ صُوَراً مَاثِلَهْ",23,"ل",2,0],["وَتَصِفُ الأَحْوَالَ مَشْهُودَةً","كَأَنَّهَا المِرْسَمَةُ النَّاقِلَهْ",23,"ل",2,0],["وتصرّفوا في أمرها بمهارة","وذروا السيوف فأنهنّ جوامد",24,"د",1,0],["وتصوّر المعنى الدقيق فردّه","كالصبح منفلقاً أوان ظهوره",25,"ر",2,0],["وَتُصبِحُ يَومَ الخِمسِ وَهيَ شِمِلَّةٌ","مَروحاً تُقالي الصَحصَحانَ العَمَرَّدا",26,"د",2,0],["وَتَصُكُّ المَروَ لَمّا هَجَّرَت","بِنَكيبٍ مَعِرٍ دامي الأَظَلّ",27,"ل",1,0],["وَتَصَيَّفا بَعدَ الرَبيعِ وَأَحنَقا","وَعَلاهُما مَوقودُهُ المَسمومُ",28,"م",1,0],["وَتَصَرُّفُ الأَيّامِ حَت","تى ما يَرى شَيئاً يَسُرُّه",29,"ر",2,0],["وتصبح الشرب صرعى دونَ مجلسِها","وهي الحياةُ كأنَّ الشربَ أموات",30,"ت",1,0],["وتصرفون لأقوام عنايتكم","عنَّا وما قصرت عنكم مساعينا",31,"ن",2,0],["وتصيدُ لَحمَتها عُقا","بُ الموتِ يومَ تَرى عقابهْ",32,"ب",2,0],["وتصفَّحْ وجوهَ قولي وقلِّبْ","جانبيهِ وأنعِمِ التقليبا",33,"ب",2,0],["وتَصْطَادُ لي جدواه ما كنتُ صائداً","بشرخ الشباب الغَضِّ بل هي أصْيدُ",34,"د",1,0],["وتصرفُ أحياناً عن الشمس وجهَهُ","وجوهٌ تضاهي الشمس بل لا تجانس",35,"س",1,0],["وتصيبُ بَعضَهمُ المصيبةُ مرَّةً","فتنوب نوبتُها أخاه فَيَأتسي",36,"س",2,0],["وتصدّى للنيك في زينة الدُّن","يا وما تُشتَهى ولا تُسْتَهشُّ",37,"ش",1,0],["وتصريفُ ما فيه إذا ما اعتبرتَه","مثالٌ لتصريفِ القنا والقنابِلِ",38,"ل",1,0],["وَتُصبِحُ عَن غِبِّ السُرى وَكَأَنَّها","مُوَلَّعَةً تَخشى القَنيصَ شَبوبُ",39,"ب",1,0],["وَتَصُدُّني عَنكَ النَوى","وَأَصُدُّ عَن هَذا الصُدود",40,"د",1,0],["وَتَصلُحُ أَن يُطافَ بِها مَساءً","وَتَحسُنُ أَن تَكونَ شَرابَ طُهرِ",41,"ر",1,0],["وَتَصعَدُ النَفسُ مِنِّيَ لِلسَماءِ وَلا","حِبالُ نورٍ تَدَلَّت مِن دَراريها",42,"ي",3,0],["وَتَصدُرُ عَنهُ أَفعالٌ قِباحٌ","فَصَدِّق كُلَّ شَيءٍ قيلَ عَنهُ",43,"ه",1,0],["وَتَصعُبُ عِندي حالَةٌ ما أَلِفتُها","عَلى أَنَّ بُعدي عَن جَنابِكَ أَصعَبُ",44,"ب",1,0],["وتَصَادُمَ الأَهواءِ بالأَهواءِ","في كلِّ الأُمورْ",45,"ر",1,0],["وتَصبِحُ أَحلامَها يقْظةً","موَشَّحةً بغموضِ السَّحَرْ",46,"ر",1,0],["وتصوري فيها بشكل حمامة","وقعي على الجدران ثَمَّةَ واسجعي",47,"ع",2,0],["وتصلى لِلّه في اليوم خمساً","ويك ماذا تريد بالصلوات",48,"ت",1,0],["وتصدّق فهو حصن للغنى","وسلام النفس في دنيا ودين",49,"ن",1,0],["وتصيّد الآساد بال","آجام تسلبها الحراك",50,"ك",1,0],["وَتَصعَدُ مِن غَيرِ ما سُلَّمٍ","فَيا لِلمُصَوِّرِ هَذا الصُعود",51,"د",1,0],["وَتُصبِحُ تَلقاهُم وَتُمسي تَصُدُّهُم","وَتَظهَرُ في جِدِّ القِتالِ وَتَلعَبُ",52,"ب",1,0],["وَتَصالَحَت ثَمَرُ السِياطِ وَخَيلُهُ","وَأَوَت إِلَيها سوقُها وَالأَذرُعُ",53,"ع",1,0],["وتصعيدهم غير تصعيدنا","وتقطيرهم غير تقطيرنا",54,"ن",2,0],["وتصدم منكبَ الأيامِ عني","بعَطفةِ منعمٍ حِدبٍ محامي",55,"م",2,0],["وتصبُو إليه المكْرُماتُ عواطِلاً","تُزحْزَحُ عن أجيادِهنَّ القلائدُ",56,"د",1,0],["وتصطاد قلوب الشر","ب أجفان لها وسنى",57,"ن",2,0],["وَتُصبي الحَليمَ بِالحَديثِ يَلَذُّهُ","وَأَصواتِ حَليٍ أَو تَحَرُّكِ دُملُجِ",58,"ج",1,0],["وَتُصبِحُ صاحِكاً ظَهراً لِبَطنٍ","وَتَذكُر ما اِجتَرَمتَ فَلا تَذوبُ",59,"ب",1,0],["وَتَصريفُ هَذا الخَلقِ لِلَّهِ وَحدَهُ","وَكُلٌّ إِلَيهِ لا مَحالَةَ راجِعُ",60,"ع",1,0],["وتصطخبُ العواصف ساخرات","وتطعنني بأطراف الحرابِ",61,"ب",1,0],["وتصدَّى قمرٌ را","حَ على الأرض وجاء",62,"ا",2,0],["وتصدُرُ عن ندى يده الأماني","إذا وردتهُ هِيماً غير هيمِ",63,"م",1,0],["وَتَصَرُّفُ الإِخوانِ إِن كَشَّفتَهُم","يُنسيكَ طولَ تَصَرُّفِ الأَيّامِ",64,"م",1,0],["وَتُصبِحُ أَحزاني عَلَيهِ كَثيرَةً","وَيُصبِحُ سَعدي مِن مَوَدَّتِهِ نَحسا",65,"س",2,0],["وتصحيفُهُ يا أيها العدلُ جارحٌ","فإياكَ منهُ فَهْوَ كالوخزِ بالإبرْ",66,"ر",1,0],["وتصدِّيكَ للعظائمِ صعبٌ","وَهْوَ أشفى لغلِّ صدرِ الحقودِ",67,"د",1,0],["وَتَصفَحُ لا عَن ذِلَّةٍ صَفحَ رَحمَةٍ","فَتُرسِلُ دونَ الذَنبِ سَترَ غَفورِ",68,"ر",1,0],["وَتَصاهَلَت جُردٌ تَطيرُ إِلى الوَغى","وَكَأَنَّما طارَت بِهِنَّ رِياحُ",69,"ح",1,0],["وتصدُّ معرضةً تضنُّ بنفسِها","ولو اَنّ مَضجَعَها ذُرَى الأفلاكِ",70,"ك",1,0],["وَتُصَحَّحُ الآراءُ وَالراياتُ قَد","نَكَصَت عَلى الأَعقابِ واهِيَةَ العُرى",71,"ر",2,0],["وَتُصبِحُ دونَ الماءِ مِن يَومِ خِمسِها","عَصائِبُ حَسرى مِن رَذايا وَطُلَّحِ",72,"ح",1,0],["وَتَصهَلُ الخَيلُ عَلى أَبوابِها","وَيَكثُرُ الناسُ عَلى حُجّابِها",73,"ه",2,0],["وَتَصدُقُكَ الأَنباءُ إِن كُنتَ سائِلاً","وَحَسبُكَ مِمّا لا تَرى بِسَماعِ",74,"ع",1,0],["وتَصْحبُهُ دارُ المقامة حيثما","أناخَ وشَمْلُ المسلمينَ المجمَّع",75,"ع",1,0],["وَتُصبِحُ لا تَدري أَيَأتيكَ خافِضاً","نَصيبُكَ أَم تَغدو لَهُ فَتَرودُ",76,"د",1,0],["وَتُصاغُ لِلبيضِ الأَساوِرُ مِن","لُبسِ الأَساوِرِ سابِغَ الزَرَدِ",77,"د",1,0],["وَتَصطَفِقُ المَزاهِرُ مُخبِراتٍ","زَواهِرَ في المَآثِمِ بِاِصطِفاقِ",78,"ق",1,0],["وَتَصونُ حَبَّةُ خَردَلٍ قَدَمَ الفَتى","عَن زِلَّةٍ وَاليَومُ حِلفُ زَلازِلِ",79,"ل",1,0],["وَتُصغي إِلى المَينِ أَسماعُنا","وَنَصبو إِلى زُخرُفِ القائِلِ",80,"ل",1,0],["وَتُصبِحُ الذَرَّةُ الصُغرى لَهُ أَمَةً","وَالشَمسُ وَالبَدرُ مَعدودَينِ في الخَدَمِ",81,"م",1,0],["وَتَصُدُّ عَنكَ مَخيلَةَ الرَجُلِ ال","عِرّيضِ موضِحَةٌ عَنِ العَظمِ",82,"م",1,0],["وَتُصبِحُ الجونُ حَسرى في مَناهِلِها","وَالكُدرُ قَد قَصُرَت عَن وِردِها الوُقُطُ",83,"ط",1,0],["وَتَصفَحُ عَن ذي جَهلِها وَتَحوطُها","وَتَقمَعُ عَنها نَخوَةَ المُتَهَدِّدِ",84,"د",1,0],["وتصَدَّتْ فأشرقَ الصبحُ مِنها","بينَ تلكَ الجيوبِ والأطواقِ",85,"ق",1,0],["وَتصعدت فَتقلدت","من أنجم الجوزاء عقدا",86,"د",2,0],["وَتُصرِخُ مَن دَعاكَ إِلى المَعالي","بِيا عَبدَ الحَميدِ وَيا بَجيلا",87,"ل",2,0],["وتُصْبِحْ بمَوْماةٍ كأنَّ صَرِيفَهَا","صَريفُ خَطاطِيفِ الصَّرى في المَحاوِرِ",88,"ر",1,0],["وتَصْرِفُ أطفالَ السّيوفِ كأنها","أخو السّنّ لم تقْبَلْ حُكومَةَ أطفال",89,"ل",1,0],["وتُصْغي وتُرْني كلَّ خَلْقٍ لعَلّها","تَنِقّ ضَفَادِيها ويَلْعَبُ نُونها",90,"ن",3,0],["وَتَصُوغُ ذَاك اللَّفْظَ","مُنْفَرِداً بِصِيغَتِهِ انْفِرَادَكْ",91,"ك",1,0],["وَتُصْفِيهِ مَوَدَّتَهَا","علَى ما سَرَّ أَوْ مَضَّا",92,"ض",2,0],["وَتُصِيبُ القُلُوبُ وَهِيَ غِرَاثُ","مِنْ ثِمَارِ العُقُولِ مَا يَشْتَهِينَا",93,"ن",2,0],["وَتَصَرَّفْتِ فِيهِ نَظْماً وَنَثْراً","بِاقْتِدَارٍ تَصَرُّفَ المُلْهَمِينَا",93,"ن",2,0],["وَتُصِيبُ أَطْرَافٌ نَأَتْ مِنْ قِسْطِهِ","مَا لمْ تُصِبْ أَطْرَافُ مُلكٍ شَاسِعِ",94,"ع",1,0],["وتصَالحَ القَوْمَانِ فِي","عرْسٍ صَفتْ فِيهِ السَّرَائِرْ",95,"ر",1,0],["وتصافحا فتعانقا فهما","روحان خافقتان في جسد",96,"د",1,0],["وَتَصبو إِلى رَندِ الحِمى وَعَرارِهِ","وَمِن أَينَ تَدري ما العَرارُ مِنَ الرَندِ",97,"د",1,0],["وَتَصُدُّ كُلَّ كَتِيبَةٍ مَوَّارَةٍ","خَضْرَاءَ تَقْذِفُ بِالْكُماةِ رَدَاحِ",98,"ح",1,0],["وتَصْويرِ طَبٍ صنَاع اليَدَيْن","حَبَتْه الطَّبيعةُ أَسرارها",99,"ر",3,0],["وتُصْغي فلا يَجْتازُ سَمْعَكَ نَغْمَةٌ","سِوَى أَنَّةٍ يُلْهِي بها الْحُزْنَ قاهِرُه",100,"ر",2,0],["وتصاوير للحوادثِ تبدو","في شَتيتِ الألوانِ والأشكال",101,"ل",1,0],["وتَصْحُو لَه الأَزْهَارُ مِنْ وسَنَاتِهَا","تُضَاحِكه وَالطَّلُّ لَ