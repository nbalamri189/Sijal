{"poems":[[93,"سلام على السيد المجتبى","https://www.aldiwan.net/poem8758.html","عموديه"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[189,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[240,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[445,"تصدت لوشك البين من جفوة الصد","https://www.aldiwan.net/poem34776.html","الطويل"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[445,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[445,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[445,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[473,"ألا رب محتال عذل غدا","https://www.aldiwan.net/poem59891.html","المتقارب"],[473,"أخ لي أمسى في عطاياه أخطر","https://www.aldiwan.net/poem60090.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86615","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39070","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39214","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75733","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47445","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79936","الخفيف"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105232","الرمل"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119207","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53041","الكامل"],[2213,"","https://poetry.dctabudhabi.ae/diwan/poem/198213",""],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67258","الرمل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103447","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35558","الكامل"],[4125,"","https://poetry.dctabudhabi.ae/diwan/poem/203228","الكامل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105114","الكامل"],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5674,"لست مغرورة","https://www.poetsgate.com/ViewPoem.aspx?id=190971",""],[5690,"مليك الورى أهدى إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=172240",""],[5001,"رحلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80711&r=&rc=1",""]],"verses":[["فَوَشّى الرِياض وَحَلّى الحُقولَ","وَزانَ الوِهاد وَزانَ الرُبى",0,"ب",2,0],["فوشيُ خُدودٍ بالجَمالِ مُنمنَمٌ","ومسكُ شعورٍ بالشباب مضمَّخُ",1,"خ",1,0],["فوَشتْ بيَ العَبَراتُ والزَّفَراتُ لل","واشي ودائِمُ لفظىَ اللَّجْلاج",2,"ج",1,0],["فَوَشى بِها عَبقٌ وَطي","بٌ لِلوُشاةِ بِها اِرتِيابُ",3,"ب",1,0],["فَوِشاحُها قَلِقٌ وَشَبَّ سُموطَها","نَحرٌ عَلَيهِ سُموطُها وَنِظامُها",4,"م",3,0],["فوشكانَ مَا لَفَّتْ قضيباً بقاضِبٍ","وأدْنَتْ نِجادَ السَّيْفِ من مَسْلَكِ العِقْدِ",5,"د",1,0],["فَوَشْكاً مَا هَوى بِهِمُ هواءٌ","تأَلَّفَهُمْ بأَفئِدَةٍ هَوَاءِ",6,"ا",2,0],["فَوَشْكَانَ مَا شدَّدتُ حيزومَ حازِمٍ","عَلَى كِبدٍ للبينِ بائِنَةِ الصَّدْعِ",7,"ع",1,0],["فَوَشْكانَ يَا مَنْصُورُ مَا نُصِرَ الأَسى","بِرَدِّ أَقاصي الأَرْضِ نَحْوَكَ سُبْلَها",8,"ل",3,0],["فَوَشْكَانَ مَا عادَتْ من اللهِ نِعْمَةٌ","تَجَلَّتْ بِهَا فِي تاجِها وشُنُوفِها",9,"ف",3,0],["فَوَشَحتُ بِالدَلوِ آذانَهُ","وَقَطَّعتُ أَخدَعَهُ بِالخُدَع",10,"ع",1,0],["فَوَشيُ الغِنى مِنهُ عَلَيَّ مُفَوَّفٌ","وَعَصبٌ الثَنا مِنّي عَلَيهِ مُحَبَّرُ",11,"ر",1,0],["فَوشى بي لَدى جَنابك واشٍ","رام خَفضي كَيما يَنال المآرب",12,"ب",1,0],["فَوَشى ثِيابَ الرَّوضِ مِنْ أوراقِهِ","وَشْياً تَنوَّعَ صِبْغُهُ وتَنَسَّبا",13,"ب",2,0],["فَوشَى بِها مِنْ وَجْهِها وحُلِيِّها","بَدرُ الدُّجى وكواكبُ الجَوْزاءِ",14,"ا",2,0],["فَوشى دعاك زروعها بحليّها","قل لي أَوشيك أَخضر أَو أَكهَب",15,"ب",1,0],["فَوَشْيٌ بِلا رَقْمٍ وَنَسْجٌ بِلا يَدٍ","وَدَمْعٌ بِلا عَيْنٍ وَضِحْكٌ بِلا ثَغْرِ",16,"ر",1,0],["فوشوقي ومَوقع الودّ منِّي","قسماً لا أراه إلاَّ عظيما",17,"م",2,0],["فوشوقي ان قلبي قد أقام","في أثيلات النقى بين الندمى",18,"م",2,0],["فوشى بلا رقم ونقش بلا يد","ودمع بلا عين وضحك بلا ثغر",19,"ر",1,0],["فوشى بِتِلْكَ الهيج حاسده","لما استمر بجهده الصخب",20,"ب",1,0],["فوشى واش فغيّره","وعليه كان يحسدني",21,"ن",2,0],["فوشى ما بيننا كفُّ الخضيب","لصباحٍ فإذا هو قد سعى",22,"ع",2,0],["فوَشيٌ بلا رقمٍ ورقمٌ بلا يَدٍ","ودمعٌ بلا عَينٍ وضِحكٌ بلا ثَغرِ",23,"ر",1,0],["فَوَشى بِهِ دَمعي وَلَم أَرَ واشيا","كَالدَّمعِ يعرب عَن لِسانٍ أَخرَسِ",24,"س",1,0],["فوشت به عيني ولم أك عالماً","من قبلها أن الوشاة عيون",25,"ن",1,0],["فوشى الوشاح إلى الوشاة بمشيها","وشي الخلاخل والوشاة رقود",26,"د",1,0],["فوشّمَ القحْطُ أسْواري ودحرجَها","وعيْنُ قلبي يُناغي دمعَها الظلّ",27,"ل",1,0],["فٓوشْوشاتٌ بِنبْضِ القلبِ ساجدةٌ ..","وتٓمْتٓماتُ الهوى في الصَدر ِمٓقبورةْ",28,"ر",2,0],["فوشحهُ بالصفح الشديد وقل لهُ","إلا إيهِ عني بالحسود إلى... إلى",29,"ل",2,0],["فوشوشتُ عنكِ نسيمَ الصباحِ","وفرّقتُ شِعري على كل حَي",30,"ي",1,0]]}