نَبَت بِهِ الكاسُ كانَ مُستَحِلا",7,"ل",2,0],["تَختالُ أَلواناً إِذا ما صُفِّقَت","في الكَأسِ تُخرِسُ مِن لِسانِ الناطِقِ",8,"ق",1,0],["تَختَرِقُ البيدَ وَالفَيافِيَ إِذ","لاحَ سُهَيلٌ كَأَنَّهُ قَبَلُ",9,"ل",1,0],["تَخْتالُ في لِينِ المجا","سِدِ بَينَ حارِسَةٍ وحارِسْ",10,"س",1,0],["تختال بالنيل في مفوّفة","يكاد يخضّل فوقها زهره",11,"ر",2,0],["تَخْتالُ في يومٍ تَرَقَّبتِ العُلا","مِيلادَه ورَنتْ إِليه الأَعْصُرُ",12,"ر",1,0],["تختلف الآرام في رياضها","والعين لم تنظر بها الاه",13,"ا",2,0],["تختالُ بين حَدائقٍ وعِراصِ","أعَرَفتَ يا قلبي عَروسَ العاصي",14,"ي",1,0],["تَختَالُ في نَسجِ صَنعَاء المُصَوَّرِ في","أرجَائِهِ وتَذُمُّ البَرقَ مُبتَسِمَه",15,"م",2,0],["تختال تيهاً في سطورِ طروسه","غررُ الفنون يزينها التحقيقُ",16,"ق",1,0],["تختال في حَبِرَات الوشى تائهةً","على متون العوالى والقواضيبِ",17,"ب",1,0],["تَختالُ تَحتَهُمُ الجِيادُ إِذا","رَكِبُوا فَيَسمُو الطّرفُ كَالصَقرِ",18,"ر",1,0],["تختال بين الطروس خردها","فتطرب اللحظ في تسهُّده",19,"د",2,0],["تَختالُ تيهاً عَلى الجَوزاءِ شُرفَتُها","وَغَيرُ بِدعٍ أَن اِختالَت بِكُم تيها",20,"ي",3,0],["تَختَلِفُ الأَيّامُ في أَهلِها","مِثلَ اِختِلافِ المَدِّ وَالجَزرِ",21,"ر",1,0],["تَختالُ في أَفوافِها أَعوامُهُ","وَتَميسُ في حِبَراتِها أَعيادُهُ",22,"د",2,0],["تختالُ في حُلَل التبيانِ رافلةً","حمدتُ من ببيانِ الفكر أنشاكِ",23,"ك",1,0],["تختصكم مني تحيةَ شيِّق","لولا اختصارِي لامتَحت بدموعي",24,"ع",2,0],["تختال في حلل السيادة رافلا","برياض أنس زاهرات كل عيد",25,"د",1,0],["تَختال بين لِداتِها فتخالها","بَدراً بدا بين الجواري الكُنَّسِ",26,"س",1,0],["تَختالُ من مَرح الشَبيبةِ والصِبا","فَتُعيدُ فَودَ أَخي الشَبيبةِ شائِبا",27,"ب",2,0],["تختالُ من زهوِ الصبا في ميْعةٍ","ومن الشبابِ وَحسنِه في ريّق",28,"ق",1,0],["تختال في بُردِ اختيارٍ مع نهىً","بين المعالم والطلول الخُضَّع",29,"ع",1,0],["تختال بين ملائكٍ","كالشمس تعلو الكوكبا",30,"ب",2,0],["تختم بإيمان","لي والأهل والإخوان",31,"ن",1,0],["تُختصرُ الأرضُ على راحتي","باقة وردِ ناضرٍ مورقِ",32,"ق",1,0],["تختار لذَّات الكمال على الهوى","تلك المشقَّة قلَّ مَنْ يختارها",33,"ر",3,0],["تخ