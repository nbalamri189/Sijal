 فلم يكن","https://www.aldiwan.net/poem61321.html","الكامل"],[454,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[459,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[459,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[459,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[462,"كل شيء تدبيره مستحيل","https://www.aldiwan.net/poem16349.html","الخفيف"],[465,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[478,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[501,"بين الكتائب والكثبان جلجلة","https://www.aldiwan.net/poem37780.html","البسيط"],[501,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[515,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[515,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[539,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[545,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[545,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[559,"إنما الإيمان نور","https://www.aldiwan.net/poem33785.html","مجزوء الرمل"],[559,"إني أنا المعني القديم","https://www.aldiwan.net/poem34081.html","مجزوء الكامل"],[559,"إن جسمي هنا وقلبي هناكا","https://www.aldiwan.net/poem34259.html","الخفيف"],[559,"صدق الكتاب لمن به يتمسك","https://www.aldiwan.net/poem34273.html","الكامل"],[559,"كل مصنوع بمن قد صنعه","https://www.aldiwan.net/poem34365.html","الرمل"],[561,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[563,"ضاق الرثاء بنا من فرط ما اتسعا","https://www.aldiwan.net/poem52762.html","البسيط"],[565,"عن حبكم صح قلبي","https://www.aldiwan.net/poem887.html",""],[567,"هل للفتى من بنات الدهر من واق","https://www.aldiwan.net/poem1928.html","البسيط"],[568,"وملعب للخيل في قرواح","https://www.aldiwan.net/poem69751.html","الرجز"],[576,"أشكر الله للمصاب عز","https://www.aldiwan.net/poem2770.html","الخفيف"],[576,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[587,"ما شئت من عبء الغرام وحمله","https://www.aldiwan.net/poem17688.html","الكامل"],[587,"وافى وأرواح العذيب نواسم","https://www.aldiwan.net/poem17701.html","الكامل"]],"verses":[["هَوِّن عَليكَ فَقَد يَكو","نُ الصَعبُ عِندَكَ غَيرَ صَعبِ",0,"ب",1,0],["هَوِّنْ عَلَيْكَ فَمَا الشَّكْوَى بِنَافِعَةٍ","وَكُلُّ صَعْبٍ إِذَا هَوَّنْتَهُ هَانَا",1,"ن",2,0],["هوِّنْ على النّفْسِ النّفيسَةِ أمْرَها","وإذا سلِمْتَ فلا تُرَعْ لفَقيدِ",2,"د",1,1],["هُوَ نارٌ وَوَقودٌ فَإِذا","غَفَلَ الموقِدُ فَالنارُ حَمَم",3,"م",1,0],["هَوِّن عَلَيكَ تَماسَك","إِنّي سَمِعتُ أَنينا",4,"ن",2,0],["هَوَّنَ وَجدي أَنَّ مَن سَرَّهُ","مَصرَعَهُ لاحِقُهُ لا تُمار",5,"ر",1,0],["هَوَّنَ مِنْ دَمعِي عَزِيزاً أَجَلْ","وَعِزَّةِ الخَطْبِ الَّذِي هَوَّنَهْ",6,"ن",2,0],["هو نور يضيء في أوجه الحبّ","ويهدي نفوسهم للغرام",7,"م",1,0],["هوِّن عليك فربَّ خطبٍ هائل","دُفِعت قواه بدافعٍ لم تدرِه",8,"ر",2,0],["هَوِّنْ عليك فإن رِجلكَ شُعبةٌ","من أربعٍ تكفيكَهُنَّ ثلاثُ",9,"ث",1,0],["هَوِّنْ عليك التي مُنيتَ بها","فإنها فَقحةٌ قَضت تَفَثا",10,"ث",2,0],["هَوِّنْ عليك فإنَّ مَدْحَكَ مُسْعِدِي","عَفْواً ولم أكدحْ بفكريَ مَكْدحا",11,"ح",2,0],["هوِّن عليك فإنها","خِلعٌ أعارَكها مُعيرُ",12,"ر",1,0],["هوِّن عليكَ فإنَّ الأمر وافقَها","وكان منها اعتناقٌ فيه تقبيلُ",13,"ل",1,0],["هوِّن عليك المُقطَعاتِ ولا تكن","بنصيحةٍ من مخلص مُتهاونا",14,"ن",2,0],["هُوَ نَفحَةٌ قُدسِيَّةٌ هَبَطَت إِلى","هَذا الثَرى مِن عالَمِ اللَألاءِ",15,"ا",2,0],["هوِّنْ على قلبك المعنَّى","إنْ كُنْتَ لا تُبْصِرُ النُّجُومْ",16,"م",1,0],["هوني يا نفسي فعلك تسطي","عين عن هوة الردى ان تحيدي",17,"د",2,0],["هَوِّن عَلَيكَ فَلا شَماتَ بِمَيّتٍ","إِنَّ المَنِيَّةَ غايَةُ الإِنسانِ",18,"ن",1,0],["هَوِّن عَلى بَصَرٍ ما شَقَّ مَنظَرُهُ","فَإِنَّما يَقَظاتُ العَينِ كَالحُلُمِ",19,"م",1,0],["هَوِّن عَلَيكَ فَما يَقومُ لِصَرفِهِ","إِلّا فَتىً فيهِ كَريمُ المَغرَسِ",20,"س",1,0],["هَوِّنِ الأَمرَ تَعِش في راحَةٍ","كُلَّ ما هَوَّنَت إِلّا سَيَهونُ",21,"ن",1,1],["هَوِّن عَلَيكَ مَضايِقَ الد","ُنيا تَعُد سُبُلاً فِجاجا",22,"ج",2,0],["هَوِّن عَلَيكَ فَلَيسَ كُل","لُ الناسِ يُعطى ما يَوَدُّ",23,"د",1,0],["هَوَّن عَلَيكَ الأُمورَ وَاِعلَم","أَنَّ لَها مَورِداً وَمَصدَر",24,"ر",1,0],["هَوَّنتَ عَسفَ اللَيالي","هَوَّنتَ ما لا يَهونُ",25,"ن",1,0],["هَوِّن عَلَيكَ العَيشَ صَفحاً يَهُن","لَقَلَّما سَكَّنتَ إِلّا سَكَن",26,"ن",1,1],["هَوَّنَ بِها اللُهى فَلَو نَطَقَت","يَوماً لَقالَت أَعَزَّكَ اللَهُ",27,"ه",1,0],["هو نايٌ مُرجِّعٌ","لشجيٍّ وما كتم",28,"م",1,0],["هُوَ نَوءُ يُمنٍ فيهِمُ وَسَعادَةٍ","وَسِراجُ لَيلٍ فيهِمُ وَنَهارُ",29,"ر",1,0],["هَوِّنْ عَلَيْكَ فَكُلُّ شَيءٍ ذَاهِبٌ","وَالدَّهْرُ مَصْدَرُ عِزَّةٍ وَهَوَانِ",30,"ن",1,0],["هوِّنْ عليكَ فروحي","جاءَتْ تُقاد بشَعْرَهْ",31,"ه",1,0],["هُوَ نُورُه وسَبيلُه ما مِثلُه","نُورٌ يُرامُ ولا سَبيلٌ يُؤثَرُ",32,"ر",1,0],["هَوَّنْتَ من وَجدِ النُّفوسِ بِقَولةٍ","رَدّتْ عليها بالعَشِيِّ قَرارَها",33,"ر",3,0],["هو نُورٌ من السّماواتِ قُدْسِي","يٌ يُفيضُ الهُدَى ويمحو الضَّلالا",34,"ل",2,0],["هَوِّن عَلَيكَ فَفي البِلادِ مَدارِهٌ","تُدلي بِحُجَّتِها الَّتي لا تُدفَعُ",35,"ع",1,0],["هَوِّن عَلَيكَ فَما الدُنيا بِدائِمَةٍ","وَإِنَّما أَنتَ مِثلُ الناسِ مَغرورُ",36,"ر",1,0],["هَوِّن عَلَيكَ أَنِلتَ نَصراً في الوَغى","أَم قالَ جَدُّكَ صادِقاً لا تُنصَرِ",37,"ر",1,0],["هَوِّن عَلَيكَ وَلا تُبالِ بِحادِثٍ","يُشجيكَ فَالأَيّامُ سائِرَةٌ بِنا",38,"ن",2,1],["هَوِّن عَلَيكَ فَما الدُنيا بِدائِمَةٍ","وَلَيسَ عاطِلُها إِلّا كَحاليها",39,"ي",3,0],["هو نوم نعم نعم هو نوم","هو نوم لكن بلا أحلام",40,"م",1,0],["هُوَ نَوْحُ سَاقِيَةٍ شَكَتْ","لا َقَدْرُ مَا يَحْوِي القَلِيبُ",41,"ب",1,0],["هُوَ نِعْمَة اللهِ الَّذِي آدابُهُ","وَعُلُومُهُ شَهِدَتْ بِهَا الأَسْفارُ",42,"ر",1,0],["هُوَ نَادٍ بِه مُجَانَسَةُ الأخْلاَقِ","تُنَمِّي فِيْنَا قِوَى الإِتِّحَاد",43,"د",1,0],["هو ناصبُ الأسلاكِ إن وصل الهوى","بين القلوب ومرسل التيار",44,"ر",1,0],["هوِّنْ عليك؛ فكم في البرِّ من سمك","يلوح في صورةِ الدُولات والأُمم!",45,"م",1,0],["هوِّنْ عليك، وجفِّفْ دمعك الغالي","لا يجمعُ الله بين الشعر والمالِ!",46,"ل",1,1],["هوِّن فما قام هدّامٌ بمعوله","إّلا وقام عليه ألْفُ بنّاء",47,"ا",2,0],["هوّنْ عليكَ فكلُّ ذلكَ فِريةُُ","تَفْنى . ويَبْقى السعي والإِقْدام",48,"م",1,0],["هوَّن الحبَّ على اهل الهَوى","أن تَركَ الحبِّ خطبٌ لا يهون",49,"ن",1,0],["هو نور من السماوات قدسي","يفيض الهدى ويمحو الضلالا",50,"ل",2,0],["هوّن عليك ففي النّفوس بقيّة","من رحمة ومروءة وسماح",51,"ح",1,0],["هُو نُور إِيمان يَلوح لِمُبصر","وَظَلام قَلب حَسودِهِ أَشراكَ",52,"ك",1,0],["هُوَ نَجل شاهين الَّذي بيَهوى العُلا","وَيَهشُّ لِلمَعروف بِاستلذاذ",53,"ذ",1,0],["هون عليك فللبداية غاية","ان اخلص الساري بها او اغرضا",54,"ض",2,0],["هو نجم دين بالشريعة ثاقب","طويت بذيل ضيائه الاقمار",55,"ر",1,0],["هون عليك ففجر خد","ك آن تمحوه الدياجر",56,"ر",1,0],["هون عليك فان مأسور الهوى","غيري ومجدي قاهر لمرادي",57,"د",2,0],["هون عليك فان الفضل ارث ابي","والماء ماء ابى والبئر بئر ابي",58,"ب",2,0],["هُو نَسْلُ سلطان الإمامِ المرتضى","ربُ البراعةِ طاهرُ الأذْهانِ",59,"ن",1,0],["هو نسلُ سيفٍ نجلُ ما","لكه الفتى البطلِ الشجاعِ",60,"ع",1,0],["هو نسلُ سلطانَ الإما","مِ اليعربيِّ الواهبِ",61,"ب",1,0],["هُونُوا إِنَّ فِيهِ لَكُم سَدَاداً","وقَد كُنتُم بِهِ مُتَعَلِّمينَا",62,"ن",2,0],["هوّن عليكَ فما البكاءَ براجعٍ","شيئاً وهل يجدي السقيمَ تألّمُ",63,"م",1,0],["هَوَّنَ وِجدانُهُم نَداكَ لَهُم","عَوناً عَلى الدَهرِ فَقدَ مَن فَقَدوا",64,"د",3,0],["هوّن إذا هولت واعلم إنما","تقوى على التهويل بالتهوين",65,"ن",1,0],["هوّن عليك فسوف تنسى في غدٍ","ما قد سلبت بما وراه تسلبَ",66,"ب",1,0],["هوّن عليكَ فما عدوً ظافرٌ","لكنَّها آجالُ قومٍ تحضرُ",67,"ر",1,0],["هوّنتَ عني شرَّهم فأذاهُمُ","كأذى التراب أثارَ منه الحافرُ",68,"ر",1,0],["هَوِّن فَقَومُكَ يا عَلِيُّ حَياتُها","كَمَماتِها وَمَماتُها كَحَياتِها",69,"ت",3,0],["هوّن عليك فلا حزمٌ ولا حذر","واقيك إن بتّ من خوف على وجل",70,"ل",1,0],["هوّن عليك وإلا هان عن كره","ما ليس في كونه بد من القدر",71,"ر",1,1],["هوَ نورُ الأنوارِ أصلُ البرايا","حينَ لا آدمٌ ولا حوّاءُ",72,"ا",2,0],["هو نسرٌ لهُ جناحا إِلهٍ","طائِرٌ في مَدينَةِ التعساءِ",73,"ا",2,0],["هو نور وما الخطيئة إلا","ظلمة أو حليفة الظلماء",74,"ا",2,0],["هَوِّنْ عَلَيْكَ فَمَا حُبِسَتْ لِرِيبَةٍ","إِنَّ الُّليُوثَ مَقَرُّهَا آجَامُهَا",75,"م",3,0],["هُوَ ناظرٌ هَجر الهجوعَ لعلمه","أنَّ المعالي لم تُنَل بهجُوعِ",76,"ع",1,0],["هَوِّن عَلَيكَ فَهذا لا بَقاءَ لَهُ","أَما تَرى العُشبَ يَفني بَعدَما نَبَتا",77,"ت",2,0],["هوَّنتِ ذاكَ عليهِ ثم خَدعتِهِ","بدموعِ غدرٍ قد جَرَت غُدرانا",78,"ن",2,0],["هو ناظم الأَبيات يُزري نظمُها","بلآلئ الجيد البهيِّ جُمانُها",79,"ن",3,0],["هون عليك نائب الدهر","يهن عليك كل ما يجري",80,"ر",2,1],["هَوِّن عَلَيكَ وَخَيرُ القَولِ أَنفَعُهُ","مَحَضتَني النُصحَ لَكِن لَستُ أَسمَعُهُ",81,"ه",1,0],["هوّنى ما استطعت من ثورة البح","ر وردّى أمواجه العاويات",82,"ت",1,0],["هو ناي حرمَ الشد","وَ فماتت أغنياته",83,"ه",1,1],["هَوِّنْ عليك فإنّ الدّهْرَ ذو غِيَرٍ","وكُلُّ مُجتَمعٍ يَوماً لِمُفْتَرَق",84,"ق",1,0],["هَوِّنِ الأمرَ واستَعنْ بمُعينِ الدْ","دينِ يَقتَصُّ منهُ أَيَّ اقْتِصاص",85,"ص",1,0],["هوِّني عصفورتي ماعاد","ذو يأسٍ بكسب",86,"ب",1,0],["هوَّنْ عليك أبي فكم خَبَرٍ سرى","بين الوسائلِ وهو ضَرْبُ كلامِ",87,"م",1,0],["هوَنْ قليلاً على أهل الغَرام فقَدْ","أركبتَهم طَبَقاً في الأرضِ عَنْ طَبق",88,"ق",1,0],["هوَ نهبة للمعتفين فإِن بَدا","لك ماله وَأَطقت نَهباً فانهَبِ",89,"ب",1,0],["هَوِّنْ عليك فإنَّ أرباب الهوى","لا زال تشكو قسوة من لين",90,"ن",1,0],["هوّنْ عليكَ وكنْ للخطبِ مُصْطَبِرا","فذو النُهى لنزولِ الخطبِ يصطبرُ",91,"ر",1,1],["هوِّن عليك فَأَنتَ حر مبتلي","بسمائح تأتيك غير سوامح",92,"ح",1,0],["هون عليك فهذي حرة نزلت","بمنزل في جوار اللَه ممتنع",93,"ع",1,0],["هوّن شكواي الهوىعنده","ذلّ المحبين وعز الجمال",94,"ل",1,0],["هو نعمان عصره فارس الحَلْ","بة في المشكلات عند الجواب",95,"ب",1,0],["هو نجلُ قدريِّ المبجل من له","من دَوْحِة الحسَبِ الأثيلِ صُراحُها",96,"ح",3,0],["هون عليك فإني غير متهم","قد بعتها دون من من أعاديها",97,"ي",3,0],["هوّن عليك فكل ما هو كائن","ويكون ماضيه مدار الآتي",98,"ت",2,0],["هَون عليكَ فكُّل أر","ضٍ أو سماءٍ من نَصيبي",99,"ب",2,0],["هوَّن