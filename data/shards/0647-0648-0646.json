ُ الشعور بربه","للروح كلّ الروح فيك تدفّقُ",272,"ق",1,0],["هون عليك فكل حي هالك","لا آمر يبقى ولا مأمور",273,"ر",1,0],["هوْنًا أسيرُ على السنينِ وكلَّما","جاوزتُ عامًا قامَ حتى أحملَه",274,"ل",2,0],["هو نظرتي عندَ الصباحِ إلى أبي","مع قبلةِ الحبِّ التي تُنسي المِحنْ",275,"ن",1,0],["هُوَ نفحةٌ سَكْرى وحينًا غيمةٌ","تبكي ..و حينًا صوتُ إعصارِ ..",276,"ر",1,0],["هَوِّنْ عَلَيْكَ فَمَا احْتِضَارُكَ بِدْعَةٌ","وَاصْبِرْ فَصَبْرُكَ ناَطِقٌ قَدْ اسْمَعَا",277,"ع",2,0],["هون عليك فؤادي لست منهزما","حتى أراك أمام الحزن هيابا",278,"ب",2,0],["هون عليك فؤادي واتخذ سببا","إلى التفاؤل ،واترك عنك ما رابا",278,"ب",2,0],["هوّن عليك فما تنفك مورقةً","تلك الحروف وفيها سرّ أسراري",279,"ر",2,0],["هوّنْ عليك ولا تنصتْ لجعْجعةٍ","وإن ربَا حَولها منْ ناصرٍ عَددُ",280,"د",1,0],["هُوَ نَاصِرُ المَظْلُومِ عَبْرَ عُهُوْدِهِ","كَمْ مَدّ جَيْشاً ضَارِياً عِمْلَاقَا",281,"ق",2,0],["هُوَ نَبْضُنَا يَنْسَابُ مِنْ أَقْلَامِنَا","فَنَرَاهُ أَعطَىٰ الشِّعرَ وَصفَاً ضَافِيَا",282,"ف",3,0],["هوّنْتها هانت تجاملني","كحزينةٍ لا تظهر الشكوى",283,"و",2,0],["هون عليك فما لي في الهوى ولع ٌ","بات التقى والندى والعلم مطلوبي",284,"ب",2,0],["هو نجمٌ واعتلى سقفَ الليالي","نورُهُ الساطعُ قلبي يحتويهْ",285,"ي",2,0],["هُوَ نُصفُ عامٍ ظَلَّ يَفصلُ طبعَنا","منذُ التقى يوليو ببردِ ينايرِ!",286,"ر",1,0],["هوِّنْ عليك سفاهةَ البعضِ التي","بنحورهم ستظلُّ خنجرَ ثأرِ",287,"ر",1,1],["هوِّنْ عليكَ فإنَّ العمْرَ محدودُ","فنلْ به رفقةً في أهلِها الصِّيدُ",288,"د",1,1],["هوّنْ عليْكَ إذا الْتفَتَّ فلا أَحَدْ","لا ماءَ لا زيتونَ لا مِلْحَ البَلَدْ",289,"د",1,1],["هوّن عليك ولا تقلْ إلّا كما","قال التَّقِيُّ إذا اخْتَلَى أحدٌ أحدْ",289,"د",1,0],["هوّن عليك فما الوفاء صفاتهم","مهما يرَوْكَ إلى الوفاءِ إماما",290,"م",2,0],["هو نفسهُ المحتاج، والدُهم قضى","وكأنهم فقراءُ حتى للكلا",291,"ل",2,0],["هو نور الله في الكون سعى","يزرع الحبّ زهورا ً وندى",292,"د",2,0],["\" هوّن عليكَ فما انتقدتُ وإنني","متأخِّرٌ لا يدركُ المتقدّما \"",293,"م",2,0],["هوَّن سلامك عليّه وخفَّف جروحي","يا ليت قلبك يلين ويكشف وضوحك",294,"ك",1,0],["هو نفسه فرحي أرى 