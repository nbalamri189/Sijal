06995",""],[5358,"كم حلوةٍ تلهو","https://www.poetsgate.com/ViewPoem.aspx?id=187054",""],[5365,"أشواق","https://www.poetsgate.com/ViewPoem.aspx?id=191264",""],[5376,"ونصْبَ عينيَّ فيها رَسْمُ معقودِ","https://www.poetsgate.com/ViewPoem.aspx?id=188343",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5410,"حُبُّنا مَوئلٌ للسَلام","https://www.poetsgate.com/ViewPoem.aspx?id=151392",""],[5431,"أحتاج عمرا كي أرى دمعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=191667",""],[5431,"والله يبسط في المحبة أمنه","https://www.poetsgate.com/ViewPoem.aspx?id=191997",""],[5431,"الحدْس.....","https://www.poetsgate.com/ViewPoem.aspx?id=198676",""],[3294,"أين الوفاء وللوفاء دلايل","https://www.poetsgate.com/ViewPoem.aspx?id=173271",""],[5447,"خطوة","https://www.poetsgate.com/ViewPoem.aspx?id=208305",""],[5457,"ما معنى الوطن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213236",""],[5459,"إنذار","https://www.poetsgate.com/ViewPoem.aspx?id=202224",""],[5528,"قلب على مسرح الاحتضار","https://www.poetsgate.com/ViewPoem.aspx?id=201290",""],[5542,"تألقي يا حروف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=10060",""],[5616,"غار","https://www.poetsgate.com/ViewPoem.aspx?id=203336",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5720,"الْرَوْنَةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199382",""],[5720,"الكِتَابَة","https://www.poetsgate.com/ViewPoem.aspx?id=200244",""],[5725,"كن في غيابة قلب من تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=212011",""],[5742,"نفح العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=206890",""],[5861,"إغلقِ الباب وغادر","https://www.poetsgate.com/ViewPoem.aspx?id=191351",""],[5939,"منذ التقى يوليو ببرد يناير","https://www.poetsgate.com/ViewPoem.aspx?id=179997",""],[5943,"هوِّنْ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=34686",""],[5943,"هوِّنْ عليك فإنَّ العمرَ محدودُ","https://www.poetsgate.com/ViewPoem.aspx?id=60866",""],[1920,"أشباه","https://www.poetsgate.com/ViewPoem.aspx?id=215662",""],[5956,"قدَرٌ عليك بأن تُخان دواما","https://www.poetsgate.com/ViewPoem.aspx?id=193214",""],[5956,"إني لَأجثو فوق قبرك شاكراً","https://www.poetsgate.com/ViewPoem.aspx?id=193484",""],[5957,"خطفوا الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=204706",""],[5975,"الوفاء لمن أحب","https://www.poetsgate.com/ViewPoem.aspx?id=52984",""],[6001,"بلغت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=377",""],[6019,"شيٌ من الحرمان","https://www.poetsgate.com/ViewPoem.aspx?id=204932",""],[6068,"أعواذلي كفِّي اللوائم واعدلي -28-","https://www.poetsgate.com/ViewPoem.aspx?id=175792",""],[6093,"محمد سيد السادات","https://www.poetsgate.com/ViewPoem.aspx?id=193786",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""],[6189,"مسافرٌ بلا بوصلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83586&r=&rc=53",""],[6235,"تراتيل الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77691&r=&rc=6",""],[463,"هوَّنَ باللَّيلِ عليها الغررا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60075&r=&rc=131",""],[463,"صدتْ بنعمانَ على طول الصدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60044&r=&rc=100",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["هَوِّن عَليكَ فَقَد يَكو","نُ الصَعبُ عِندَكَ غَيرَ صَعبِ",0,"ب",1,0],["هَوِّنْ عَلَيْكَ فَمَا الشَّكْوَى بِنَافِعَةٍ","وَكُلُّ صَعْبٍ إِذَا هَوَّنْتَهُ هَانَا",1,"ن",2,0],["هوِّنْ على النّفْسِ النّفيسَةِ أمْرَها","وإذا سلِمْتَ فلا تُرَعْ لفَقيدِ",2,"د",1,1],["هُوَ نارٌ وَوَقودٌ فَإِذا","غَفَلَ الموقِدُ فَالنارُ حَمَم",3,"م",1,0],["هَوِّن عَلَيكَ تَماسَك","إِنّي سَمِعتُ أَنينا",4,"ن",2,0],["هَوَّنَ وَجدي أَنَّ مَن سَرَّهُ","مَصرَعَهُ لاحِقُهُ لا تُمار",5,"ر",1,0],["هَوَّنَ مِنْ دَمعِي عَزِيزاً أَجَلْ","وَعِزَّةِ الخَطْبِ الَّذِي هَوَّنَهْ",6,"ن",2,0],["هو نور يضيء في أوجه الحبّ","ويهدي نفوسهم للغرام",7,"م",1,0],["هوِّن عليك فربَّ خطبٍ هائل","دُفِعت قواه بدافعٍ لم تدرِه",8,"ر",2,0],["هَوِّنْ عليك فإن رِجلكَ شُعبةٌ","من أربعٍ تكفيكَهُنَّ ثلاثُ",9,"ث",1,0],["هَوِّنْ عليك التي مُنيتَ بها","فإنها فَقحةٌ قَضت تَفَثا",10,"ث",2,0],["هَوِّنْ عليك فإنَّ مَدْحَكَ مُسْعِدِي","عَفْواً ولم أكدحْ بفكريَ مَكْدحا",11,"ح",2,0],["هوِّن عليك فإنها","خِلعٌ أعارَكها مُعيرُ",12,"ر",1,0],["هوِّن عليكَ فإنَّ الأمر وافقَها","وكان منها اعتناقٌ فيه تقبيلُ",13,"ل",1,0],["هوِّن عليك المُقطَعاتِ ولا تكن","بنصيحةٍ من مخلص مُتهاونا",14,"ن",2,0],["هُوَ نَفحَةٌ قُدسِيَّةٌ هَبَطَت إِلى","هَذا الثَرى مِن عالَمِ اللَألاءِ",15,"ا",2,0],["هوِّنْ على قلبك المعنَّى","إنْ كُنْتَ لا تُبْصِرُ النُّجُومْ",16,"م",1,0],["هوني يا نفسي فعلك تسطي","عين عن هوة الردى ان تحيدي",17,"د",2,0],["هَوِّن عَلَيكَ فَلا شَماتَ بِمَيّتٍ","إِنَّ المَنِيَّةَ غايَةُ الإِنسانِ",18,"ن",1,0],["هَوِّن عَلى بَصَرٍ ما شَقَّ مَنظَرُهُ","فَإِنَّما يَقَظاتُ العَينِ كَالحُلُمِ",19,"م",1,0],["هَوِّن عَلَيكَ فَما يَقومُ لِصَرفِهِ","إِلّا فَتىً فيهِ كَريمُ المَغرَسِ",20,"س",1,0],["هَوِّنِ الأَمرَ تَعِش في راحَةٍ","كُلَّ ما هَوَّنَت إِلّا سَيَهونُ",21,"ن",1,1],["هَوِّن عَلَيكَ مَضايِقَ الد","ُنيا تَعُد سُبُلاً فِجاجا",22,"ج",2,0],["هَوِّن عَلَيكَ فَلَيسَ كُل","لُ الناسِ يُعطى ما يَوَدُّ",23,"د",1,0],["هَوَّن عَلَيكَ الأُمورَ وَاِعلَم","أَنَّ لَها مَورِداً وَمَصدَر",24,"ر",1,0],["هَوَّنتَ عَسفَ اللَيالي","هَوَّنتَ ما لا يَهونُ",25,"ن",1,0],["هَوِّن عَلَيكَ العَيشَ صَفحاً يَهُن","لَقَلَّما سَكَّنتَ إِلّا سَكَن",26,"ن",1,1],["هَوَّنَ بِها اللُهى فَلَو نَطَقَت","يَوماً لَقالَت أَعَزَّكَ اللَهُ",27,"ه",1,0],["هو نايٌ مُرجِّعٌ","لشجيٍّ وما كتم",28,"م",1,0],["هُوَ نَوءُ يُمنٍ فيهِمُ وَسَعادَةٍ","وَسِراجُ لَيلٍ فيهِمُ وَنَهارُ",29,"ر",1,0],["هَوِّنْ عَلَيْكَ فَكُلُّ شَيءٍ ذَاهِبٌ","وَالدَّهْرُ مَصْدَرُ عِزَّةٍ وَهَوَانِ",30,"ن",1,0],["هوِّنْ عليكَ فروحي","جاءَتْ تُقاد بشَعْرَهْ",31,"ه",1,0],["هُوَ نُورُه وسَبيلُه ما مِثلُه","نُورٌ يُرامُ ولا سَبيلٌ يُؤثَرُ",32,"ر",1,0],["هَوَّنْتَ من وَجدِ النُّفوسِ بِقَولةٍ","رَدّتْ عليها بالعَشِيِّ قَرارَها",33,"ر",3,0],["هو نُورٌ من السّماواتِ قُدْسِي","يٌ يُفيضُ الهُدَى ويمحو الضَّلالا",34,"ل",2,0],["هَوِّن عَلَيكَ فَفي البِلادِ مَدارِهٌ","تُدلي بِحُجَّتِها الَّتي لا تُدفَعُ",35,"ع",1,0],["هَوِّن عَلَيكَ فَما الدُنيا بِدائِمَةٍ","وَإِنَّما أَنتَ مِثلُ الناسِ مَغرورُ",36,"ر",1,0],["هَوِّن عَلَيكَ أَنِلتَ نَصراً في الوَغى","أَم قالَ جَدُّكَ صادِقاً لا تُنصَرِ",37,"ر",1,0],["هَوِّن عَلَيكَ وَلا تُبالِ بِحادِثٍ","يُشجيكَ فَالأَيّامُ سائِرَةٌ بِنا",38,"ن",2,1],["هَوِّن عَلَيكَ فَما الدُنيا بِدائِمَةٍ","وَلَيسَ عاطِلُها إِلّا كَحاليها",39,"ي",3,0],["هو نوم نعم نعم هو نوم","هو نوم لكن بلا أحلام",40,"م",1,0],["هُوَ نَوْحُ سَاقِيَةٍ شَكَتْ","لا َقَدْرُ مَا يَحْوِي القَلِيبُ",41,"ب",1,0],["هُوَ نِعْمَة اللهِ الَّذِي آدابُهُ","وَعُلُومُهُ شَهِدَتْ بِهَا الأَسْفارُ",42,"ر",1,0],["هُوَ نَادٍ بِه مُجَانَسَةُ الأخْلاَقِ","تُنَمِّي فِيْنَا قِوَى الإِتِّحَاد",43,"د",1,0],["هو ناصبُ الأسلاكِ إن وصل الهوى","بين القلوب ومرسل التيار",44,"ر",1,0],["هوِّنْ عليك؛ فكم في البرِّ من سمك","يلوح في صورةِ الدُولات والأُمم!",45,"م",1,0],["هوِّنْ عليك، وجفِّفْ دمعك الغالي","لا يجمعُ الله بين الشعر والمالِ!",46,"ل",1,1],["هوِّن فما قام هدّامٌ بمعوله","إّلا وقام عليه ألْفُ بنّاء",47,"ا",2,0],["هوّنْ عليكَ فكلُّ ذلكَ فِريةُُ","تَفْنى . ويَبْقى السعي والإِقْدام",48,"م",1,0],["هوَّن الحبَّ على اهل الهَوى","أن تَركَ الحبِّ خطبٌ لا يهون",49,"ن",1,0],["هو نور من السماوات قدسي","يفيض الهدى ويمحو الضلالا",50,"ل",2,0],["هوّن عليك ففي النّفوس بقيّة","من رحمة ومروءة وسماح",51,"ح",1,0],["هُو نُور إِيمان يَلوح لِمُبصر","وَظَلام قَلب حَسودِهِ أَشراكَ",52,"ك",1,0],["هُوَ نَجل شاهين الَّذي بيَهوى العُلا","وَيَهشُّ لِلمَعروف بِاستلذاذ",53,"ذ",1,0],["هون عليك فللبداية غاية","ان اخلص الساري بها او اغرضا",54,"ض",2,0],["هو نجم دين بالشريعة ثاقب","طويت بذيل ضيائه الاقمار",55,"ر",1,0],["هون عليك ففجر خد","ك آن تمحوه الدياجر",56,"ر",1,0],["هون عليك فان مأسور الهوى","غيري ومجدي قاهر لمرادي",57,"د",2,0],["هون عليك فان الفضل ارث ابي","والماء ماء ابى والبئر بئر ابي",58,"ب",2,0],["هُو نَسْلُ سلطان الإمامِ المرتضى","ربُ البراعةِ طاهرُ الأذْهانِ",59,"ن",1,0],["هو نسلُ سيفٍ نجلُ ما","لكه الفتى البطلِ الشجاعِ",60,"ع",1,0],["هو نسلُ سلطانَ الإما","مِ اليعربيِّ الواهبِ",61,"ب",1,0],["هُونُوا إِنَّ فِيهِ لَكُم سَدَاداً","وقَد كُنتُم بِهِ مُتَعَلِّمينَا",62,"ن",2,0],["هوّن عليكَ فما البكاءَ براجعٍ","شيئاً وهل يجدي السقيمَ تألّمُ",63,"م",1,0],["هَوَّنَ وِجدانُهُم نَداكَ لَهُم","عَوناً عَلى الدَهرِ فَقدَ مَن فَقَدوا",64,"د",3,0],["هوّن إذا هولت واعلم إنما","تقوى على التهويل بالتهوين",65,"ن",1,0],["هوّن عليك فسوف تنسى في غدٍ","ما قد سلبت بما وراه تسلبَ",66,"ب",1,0],["هوّن عليكَ فما عدوً ظافرٌ","لكنَّها آجالُ قومٍ تحضرُ",67,"ر",1,0],["هوّنتَ عني شرَّهم فأذاهُمُ","كأذى التراب أثارَ منه الحافرُ",68,"ر",1,0],["هَوِّن فَقَومُكَ يا عَلِيُّ حَياتُها","كَمَماتِها وَمَماتُها كَحَياتِها",69,"ت",3,0],["هوّن عليك فلا حزمٌ ولا حذر","واقيك إن بتّ من خوف على وجل",70,"ل",1,0],["هوّن عليك وإلا هان عن كره","ما ليس في كونه بد من القدر",71,"ر",1,1],["هوَ نورُ الأنوارِ أصلُ البرايا","حينَ لا آدمٌ ولا حوّاءُ",72,"ا",2,0],["هو نسرٌ لهُ جناحا إِلهٍ","طائِرٌ في مَدينَةِ التعساءِ",73,"ا",2,0],["هو نور وما الخطيئة إلا","ظلمة أو حليفة الظلماء",74,"ا",2,0],["هَوِّنْ عَلَيْكَ فَمَا حُبِسَتْ لِرِيبَةٍ","إِنَّ الُّليُوثَ مَقَرُّهَا آجَامُهَا",75,"م",3,0],["هُوَ ناظرٌ هَجر الهجوعَ لعلمه","أنَّ المعالي لم تُنَل بهجُوعِ",76,"ع",1,0],["هَوِّن عَلَيكَ فَهذا لا بَقاءَ لَهُ","أَما تَرى العُشبَ يَفني بَعدَما نَبَتا",77,"ت",2,0],["هوَّنتِ ذاكَ عليهِ ثم خَدعتِهِ","بدموعِ غدرٍ قد جَرَت غُدرانا",78,"ن",2,0],["هو ناظم الأَبيات يُزري نظمُها","بلآلئ الجيد البهيِّ جُمانُها",79,"ن",3,0],["هون عليك نائب الدهر","يهن عليك كل ما يجري",80,"ر",2,1],["هَوِّن عَلَيكَ وَخَيرُ القَولِ أَنفَعُهُ","مَحَضتَني النُصحَ لَكِن لَستُ أَسمَعُهُ",81,"ه",1,0],["هوّنى ما استطعت من ثورة البح","ر وردّى أمواجه العاويات",82,"ت",1,0],["هو ناي حرمَ الشد","وَ فماتت أغنياته",83,"ه",1,1],["هَوِّنْ عليك فإنّ الدّهْرَ ذو غِيَرٍ","وكُلُّ مُجتَمعٍ يَوماً لِمُفْتَرَق",84,"ق",1,0],["هَوِّنِ الأمرَ واستَعنْ بمُعينِ الدْ","دينِ يَقتَصُّ منهُ أَيَّ اقْتِصاص",85,"ص",1,0],["هوِّني عصفورتي ماعاد","ذو يأسٍ بكسب",86,"ب",1,0],["هوَّنْ عليك أبي فكم خَبَرٍ سرى","بين الوسائلِ وهو ضَرْبُ كلامِ",87,"م",1,0],[