{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[70,"لي حبيب لايسمى","https://www.aldiwan.net/poem42910.html","مجزوء الرمل"],[69,"ما يقول المفتون في المفتون","https://www.aldiwan.net/poem28371.html","الخفيف"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[223,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[235,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[416,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[558,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[558,"إن الوجود الواحد ال","https://www.aldiwan.net/poem33875.html","مجزوء الكامل"],[558,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[558,"إن الوجود الحق شيء واحد","https://www.aldiwan.net/poem34654.html","الكامل"]],"verses":[["هُوَ ظَهرٌ يَنقادُ طَوعاً عَلى اللَي","نِ وَيَأبى القِيادَ إِن قيدَ عَسفا",0,"ف",2,0],["هُوَ ظَبيٌ فَإِذا ما","سُمتُهُ الوَصلَ تَنَمَّر",1,"ر",1,0],["هوَ ظَبْيٌ وإنْ رنا فَهْوَ ليثٌ","فلهذا كناسُهُ كالعرين",2,"ن",1,0],["هُوَ ظِلٌّ فَإِن دَجا وَجهُ خَطبٍ","عادَ شَمساً بِضَوئِها يُستَنارُ",3,"ر",1,0],["هو ظلُّ الحياة، نأوي إليهِ","واحةً في صحرائها الصَّهيود",4,"د",1,0],["هُو ظَبيٌ يَتَثَنّى باسِماً","بَينَ زَهرٍ باسِمٍ لِلطَلَلِ",5,"ل",1,0],["هُوَ ظِلُّ اللَهِ في الأَرضِ عَلى","أَهلِها وَالروحُ في جُثمانِها",6,"ن",3,0],["هو ظلُّ الله في الأرض وقد","مَدَّ بالأَمن على النَّاس ظلالا",7,"ل",2,0],["هو ظاهر لعيونهم وقلوبهم","بمباسملُعْسٍ ولين قوائم",8,"م",1,0],["هو ظاهر بصفاته","لي من شبابيك العدمْ",9,"م",1,0],["هو ظاهر وإن اختفى بالشمس أو","بالبدر أوغصن الأراكة كيف شا",10,"ش",2,0],["هو ظاهر في كل شيء باطن","أبداً إليه كل شيء ساجد",11,"د",1,0]]}