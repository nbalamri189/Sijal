{"poems":[[55,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[72,"لي حبيب لايسمى","https://www.aldiwan.net/poem42910.html","مجزوء الرمل"],[71,"ما يقول المفتون في المفتون","https://www.aldiwan.net/poem28371.html","الخفيف"],[83,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[228,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[422,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[563,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[563,"إن الوجود الواحد ال","https://www.aldiwan.net/poem33875.html","مجزوء الكامل"],[563,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[563,"إن الوجود الحق شيء واحد","https://www.aldiwan.net/poem34654.html","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27399","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129851","الخفيف"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93458","الكامل"],[3249,"","https://poetry.dctabudhabi.ae/diwan/poem/198804","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36790","الرمل"],[4862,"مابال قومي","https://www.poetsgate.com/ViewPoem.aspx?id=131270",""],[5090,"وطني تحول مقبرة","https://www.poetsgate.com/ViewPoem.aspx?id=184636",""],[5122,"نصيحة في عجالة","https://www.poetsgate.com/ViewPoem.aspx?id=31515",""],[5362,"طرف ما استهل مهنده","https://www.poetsgate.com/ViewPoem.aspx?id=170383",""],[6093,"محمد سيد السادات","https://www.poetsgate.com/ViewPoem.aspx?id=193786",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""]],"verses":[["هُوَ ظَهرٌ يَنقادُ طَوعاً عَلى اللَي","نِ وَيَأبى القِيادَ إِن قيدَ عَسفا",0,"ف",2,0],["هُوَ ظَبيٌ فَإِذا ما","سُمتُهُ الوَصلَ تَنَمَّر",1,"ر",1,0],["هوَ ظَبْيٌ وإنْ رنا فَهْوَ ليثٌ","فلهذا كناسُهُ كالعرين",2,"ن",1,0],["هُوَ ظِلٌّ فَإِن دَجا وَجهُ خَطبٍ","عادَ شَمساً بِضَوئِها يُستَنارُ",3,"ر",1,0],["هو ظلُّ الحياة، نأوي إليهِ","واحةً في صحرائها الصَّهيود",4,"د",1,0],["هُو ظَبيٌ يَتَثَنّى باسِماً","بَينَ زَهرٍ باسِمٍ لِلطَلَلِ",5,"ل",1,0],["هُوَ ظِلُّ اللَهِ في الأَرضِ عَلى","أَهلِها وَالروحُ في جُثمانِها",6,"ن",3,0],["هو ظلُّ الله في الأرض وقد","مَدَّ بالأَمن على النَّاس ظلالا",7,"ل",2,0],["هو ظاهر لعيونهم وقلوبهم","بمباسملُعْسٍ ولين قوائم",8,"م",1,0],["هو ظاهر بصفاته","لي من شبابيك العدمْ",9,"م",1,0],["هو ظاهر وإن اختفى بالشمس أو","بالبدر أوغصن الأراكة كيف شا",10,"ش",2,0],["هو ظاهر في كل شيء باطن","أبداً إليه كل شيء ساجد",11,"د",1,0],["هو ظل به استظلت بلا","د الله من كل موبق يخشاها",12,"ا",3,0],["هو ظل للذي تعرفه","ولهذا حكمه حكم الظلال",13,"ل",1,0],["هو ظبي فليسَ يحتاج طيبا","قد كفاه عرف من المسك فائح",14,"ح",1,0],["هُوَ ظالِمي لَكن أرِقُّ عَلَيهِ","مِن أَن أُجيلَ اللَّحظَ في خَدَّيهِ",15,"ي",2,1],["هو ظلها في حرها وإذا دجت","ليلاتها هو بدرها وشهابها",16,"ب",3,0],["هُوَ ظالِم فيما أَتا","هُ وَكاذِب فيما اِدّعى",17,"ع",2,0],["هُوَ ظِلُّ الظِلِّ وَالظلُّ كَما","قيلَ عَينُ الشَمسِ إِن كُنتَ سَميعا",18,"ع",2,0],["هو ظامئ قد جاء منكم يستقي","شعراً جميلاً معشر الشعراء",19,"ا",2,0],["هو ظالمٌ متجبرٌ","هو قاتلٌ ما أحقره !",20,"ر",2,0],["هو ظل عبده لالجا في ظلاله","نهار مابه ظل يكون ظله",21,"ل",2,0],["هو ظبي حين تعانيه","وعليّ يكون تأسده",22,"د",2,0],["هُوَ ظَافِرُ الآراءِ والنَّدَوَا","تِ والطَّلَعَاتِ والغَارَاتِ والغَزَوَاتِ",23,"ت",1,0],["هو ظلُّك فانسربي فيهِ","وليُكرَمْ بينكما الإنسانْ",24,"ن",1,0]]}