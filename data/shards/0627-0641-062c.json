{"poems":[[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[47,"إن الحكيم له مقال سائر","https://www.aldiwan.net/poem65137.html","الكامل"],[469,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122678","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108649","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109351","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111484","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70076","الكامل"],[4208,"","https://poetry.dctabudhabi.ae/diwan/poem/110722","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139499",""],[4797,"تقرير في صورة مثايل","https://www.poetsgate.com/ViewPoem.aspx?id=178138",""],[5101,"أنثى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=199686",""],[5246,"ما للحياة أراها تُبعِد الفُضَلا","https://www.poetsgate.com/ViewPoem.aspx?id=187093",""],[5246,"المرء لابد عن دنياه منتقلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187092",""],[6127,"خوفُ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=198260",""],[6355,"اللسان المترجم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66674&r=&rc=134",""]],"verses":[["افجع الحادثات في الغرب والشر","ق على النابه الاديب تدور",0,"ر",1,0],["أَفَجِئتَني بَرّاً وَتَرجِعُ مُغضَباً","مِن قَولِ عَبدٍ أَو غُلامٍ تابِعِ",1,"ع",1,0],["أفجار على التطوُّل في عر","ض مديحي أم آمري بالحضور",2,"ر",1,0],["أفَجُّ طَريقي وَردةٌ وَشَوابَةٌ","وَنَهجُ سَبيلي صَعدَةٌ وعَلافُ",3,"ف",1,0],["أفجنةٌ محفوفةٌ بمكارهٍ","هذا الوزير العالم النحرير",4,"ر",1,0],["افجعتَنا بهمام بيننا علم","كأن سهمك لا يدري بمن فتكا",5,"ك",2,0],["أفجَاءَ أنَّ الله بَاعِثُهُ لَنَا","فِي القَبرِ قَبلَ قِيَامَةِ الأبدَانِ",6,"ن",1,0],["أَفَجِئتَ تَسلُبُ َأم بَغى بِكَ هَكطُرٌ","عَيناً لِمَوقِفِنا اُسيرَ لِيَرقُبا",7,"ب",2,0],["أفجعتنا يا ابن الكِرامِ تحسُّراً","فجرت عُيونٌ مِن عُيونٍ عَندَما",8,"م",2,1],["أفجعتني بفراق من بهم","كنا نلوذ إذا وهى أمر",9,"ر",1,0],["أفجعته وهناً صروف الليالي","والليالي في طيها الأرزاء",10,"ا",2,0],["افجح الساقين له قحفن مظلل","للعشا في وجهه وعينه دلايل",11,"ل",1,0],["أفجّر دمعَ المآقي بهجري","وأبري بكفّي جوى المدنفين",12,"ن",1,0],["أفجعتنا بمصاب قد بكت سمد","لفقده وجميعُ الناس من عقلا",13,"ل",2,0],["أفجَعتَنا بمصاب قد بكت سمد","لفقده وانطوى من فعلك الأمل",14,"ل",1,0],["أفْجَعْتَنا بِمُضِيفِنا وبمَنْ به","كلُّ الضيافةِ، والعطا لا ينضُبُ",15,"ب",1,0],["أفَجْرٌ تلألأ حلوُ السَّنى؟","على قدميْكِ يَهُزُّ الشُّعورْ",16,"ر",1,1]]}