خلوة","https://www.aldiwan.net/poem38539.html","السريع"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"وأغن مسكي الإهاب ووجهه","https://www.aldiwan.net/poem39216.html","الكامل"],[66,"أنظر إلى المجد كيف ينهدم","https://www.aldiwan.net/poem40298.html","المنسرح"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[66,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[66,"لا يمتطي المجد من لم يركب الخطرا","https://www.aldiwan.net/poem41548.html","البسيط"],[97,"دينٌ وهذا اليومُ يومُ وفاءِ","https://www.aldiwan.net/poem24752.html","الكامل"],[97,"أصبحت يوم الجمعه","https://www.aldiwan.net/poem24876.html","مجزوء الرجز"],[80,"أبكاه شيب الرأس لما ابتسم","https://www.aldiwan.net/poem31286.html","السريع"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[44,"رقت حواشي الدهر فهي تمرمر","https://www.aldiwan.net/poem30510.html","الكامل"],[52,"لا تملا حثنا واسقيانا","https://www.aldiwan.net/poem26608.html","المديد"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[48,"يا لاعبا بحياتي","https://www.aldiwan.net/poem62469.html","المجتث"],[48,"قد أغتدي بزرق صبيح","https://www.aldiwan.net/poem62543.html","الرجز"],[48,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[48,"بكر صبوحك بابنة الكرم","https://www.aldiwan.net/poem65106.html","الكامل"],[50,"من فتاة صب الجمال عليها","https://www.aldiwan.net/poem24540.html","الخفيف"],[46,"أعوز الشث والسلم","https://www.aldiwan.net/poem23436.html","مجزوء الخفيف"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[69,"","https://poetry.dctabudhabi.ae/diwan/poem/57143","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55047","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54835","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[66,"لا يمتطي المجدَ من لم يركبِ الخطرا","https://www.poetsgate.com/ViewPoem.aspx?id=24254",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[45,"من فحش أمر الدنيا ومن عجبه","https://www.poetsgate.com/ViewPoem.aspx?id=31542",""],[45,"أنزاعا في الحب بعد نزوع","https://www.poetsgate.com/ViewPoem.aspx?id=2812",""],[88,"برزت تميس كخطرة النشوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19539&r=&rc=42",""]],"verses":[["مُنفَلِتَ الأُظفورِ مِن شَقِّ الجَلَم","أَقسَمتُ بِالبَيتِ الحَرامِ وَالحُرُم",0,"م",1,0],["مِن فارِسٍ يَحمِلُ أُسدَ الشَرى","لِمُلتَقى يَومِ رَدىً أَيوَمِ",1,"م",1,0],["مَن فاعِلٌ مِن بَعدِهِ كَفِعالِهِ","أَو قائِلٌ مِن بَعدِهِ ما قالا",2,"ل",2,0],["منْ فَرعِ عدْنانَ في أزكى أرومَتِها","كالبَحْرِ يدفَعُ أمواجاً بأمْواجِ",3,"ج",1,0],["مُنَفَّجَةُ الدَفَّينِ طُيِّنَ لَحمُها","كَما طُيِّنَ بِالضاحي مِنَ اللَبَنِ مِجدَلُ",4,"ل",1,0],["مِن فُنونٍ أَعجَزَت أَطواقَنا","وَعُلومٍ عِندَها الفِكرُ وَجَم",5,"م",1,0],["مُنَفَّرُ النَومِ سَبّاقٌ لِغايَتِهِ","آثارُهُ عَمَمٌ آمالُهُ أَمَمُ",6,"م",1,0],["مَن فيهِ لِلمُجتَلي وَالمُبتَلي نَسَقاً","جَمالُ مَرأَىءً عَليهِ سَروُ مُختَبَرِ",7,"ر",1,0],["مَنْ فِيهِمْ نَدُّ الْجَمِيلِ إِنْ","تَرَسَّلَ أَوْ خَطَبْ",8,"ب",1,0],["مِنْ فَحَمَاتِ اللَّيْلِ تَجْلُو الضُّحَى","وَظُلُمَاتِ الرَّيْبِ تَجْلُو اليَقِينْ",9,"ن",1,0],["مَنْ فَرَّقَ الأَخَوَيْنِ يَسْتَبِقَانِ مِنْ","طُرُقٍ لِرِفْعَتِهَا أَلَيْسَ بِمُجْرِمِ",10,"م",1,0],["من فصل منطقها ورائق رسمها","مستمتعُ الأسماع والأبصارِ",11,"ر",1,0],["من فتحك الأسنى عن الجيش الذي","بثباته أهل الوغى تتمثّلُ",12,"ل",1,0],["من فاته غرّ المساعي فاته","بعد الممات بغيرها الأنشار",13,"ر",1,0],["من فخر أزماننا في العلم أنّهما","علاّمتا هذه الأزمان والحقب",14,"ب",1,0],["مِن فَقدِ مَولىً تَصورُ الحَيَّ جَفنَتُهُ","أَو رُزءُ مالٍ وَرُزءُ المالِ يُجتَبَرُ",15,"ر",1,0],["من فوقه أنت بمقدار ما","تطيفك الأبصار من تحته",16,"ت",2,0],["من فيضِ جودك جادَ الفائضون ندى","كأنَّك البحرُ يُروَى عنه بالخلج",17,"ج",1,0],["منفرد الحسن لا نظير له","صيرني في الغرام منفردا",18,"د",2,0],["من فوق خضراء سقى روضها","غيثُ أياديك التي تهمع",19,"ع",1,0],["منفذٌ في هواه حاصل دمعي","وله سالف يريد الباقي",20,"ق",2,0],["من فعلك أشتقّ المقال فمن يقل","هذا تصدُّق قيل إذ هذا صدق",21,"ق",1,0],["من فضل جدواه أرجوها فيغْرقني","بحرٌ لديه بحار الأرض كالوشل",22,"ل",1,0],["من فوق خدّكَ خالٌ مثل غالية","بعت السلوّ على أمثاله غالي",23,"ي",1,0],["منفرد بالحبِّ في دار الهنا","مثاله الدار وزيد وأنا",24,"ن",2,0],["من فتيةٍ مثلِ أسودِ الشّرى","وصبيةٍ تحسبُهُمْ ربربا",25,"ب",2,0],["من فتىً لو رَأيتَهُ لرأتْ عيْ","ناك عِلماً وحِكمةً في ثيابِ",26,"ب",1,0],["منفردٌ بالكمال مُغتربٌ","فيه حرىً أن يطول مُغتربُهْ",27,"ب",2,0],["من فضله عند الحِجَاج بأنه","زهر ونَوْر وهو نبت واحدُ",28,"د",1,0],["من فتَى كلما بلوتَ من الفت","يانِ غُسَّاً ألْفيتَه غير غسِّ",29,"س",1,0],["من فتَىً لو رضيتُ بالناس قَيْضاً","منه كنتُ الغبينَ عند القِياض",30,"ض",1,0],["من فقحةٍ حَقَّ اتِّساعُ حِتارها","إذ لا تُفارقُ دهرها مِسواطا",31,"ط",2,0],["من فتاةٍ تحلُّ كلَّ ربيعٍ","بمغانٍ من المها مِحْلالِ",32,"ل",1,0],["من فتىً أسْمنَ المكارمَ حتى","هزَّلتْه وحبذا من هُزالِ",32,"ل",1,0],["من فَتىً للذَّكاءِ كلُّ حراكٍ","حلَّ فيه وللوقاء سكونُه",33,"ن",2,0],["مِن فَوقِها اِنتَشَرَ الضِياءُ مَلاءَةً","مِن فَوقِهِ جَوٌّ صَفا وَتَبَلوَرا",34,"ر",2,0],["من فتية راضوا الصعاب بحكمة","سلت سخيمة كل قلب ناز",35,"ز",1,0],["مَن في النُهى مِثلِيَ حَتّى الوَرى","أَصبَحتُ فيهِم مَثَلاً يُضرَبُ",36,"ب",1,0],["مَن في البَرِيَّةِ كَالفاروقِ مَعدَلَةً","وَكَاِبنِ عَبدِ العَزيزِ الخاشِعِ الحَشِمِ",37,"م",1,0],["مَن فاتَهُ ظِلُّ الشَبي","بَةِ عاشَ غَيرَ مُظَلَّلِ",38,"ل",1,0],["مِن فَتىً حَلَّ مِنَ الجَوِّ بِهِم","فَتَلَقّوهُ عَلى هامٍ وَراح",39,"ح",1,0],["مِن فَتحِ هاشِمَ أَو أُمَيَّةَ لَم يُضِع","آساسَها تَتَرٌ وَلا أَعجامُ",40,"م",1,0],["مِن فَلِّ جَيشٍ وَمِن أَنقاضِ مَملَكَةٍ","وَمِن بَقِيَّةِ قَومٍ جِئتَ بِالعَجَبِ",41,"ب",1,0],["مَن في الأَنامِ مِنَ الكِرامِ وَلا تَقُل","مَن فيكِ شَأمُ سِوى شُجاعٍ يُقصَدُ",42,"د",1,0],["مُنفَرِدَ المُهرِ عَنِ الرِعالِ","مِن عِظَمِ الهِمَّةِ لا المَلالِ",43,"ل",1,0],["مِن فُحشِ أَمرِ الدُنيا وَمِن عَجَبِه","أَن يُنخَسَ الهَوهَرِيُّ في ذَنَبِه",44,"ه",1,1],["مِن فَتىً يَفتَدي فَيُكثِر تَبدي","دَ العَطايا مِن وَفرِهِ المَجموعِ",45,"ع",1,0],["مِن فَوقِ مُرتَقِبٍ باتَت شَآمِيَةٌ","تَلُفُّهُ وَسَماءٌ تَنضَحُ الدِرَرا",46,"ر",2,0],["مَن فارَقَ القَصدَ لَم يَأمَن عَلَيهِ هَوىً","يَدعو إِلى البَغيِ وَالعُدوانِ وَالسَرَفِ",47,"ف",1,0],["مُنفَرِداً بِالفِكرِ عَن صَحبِهِ","مُستَوحِشاً بِالإِنسِ مِن أُنسِهِ",48,"س",2,0],["مِن فِتيَةِ الكُردِ الَّذينَ لِجَدَّهُم","شَرَفٌ مُنافٍ أَهلَ عَبدِ مَنافِ",49,"ف",1,0],["مِن فَوقِ يَعبوبٍ لَهُ يَومَ الوَغى","سَبقُ القَطا وَتَقَلَّبُ الخَطّافِ",49,"ف",1,0],["مِن فَرطِ إِحداقِ العُيونِ بِحُسنِهِ","خَلَعَت عَلوهِ سَوادَها الأَحداق",50,"ق",1,0],["مِن فِتيَةٍ أَرخَصوا نُفوسَهُمُ","كَأَنَّهُم لِلحَياةِ قَد سَئِموا",51,"م",3,0],["مِن فَمٍ ما رَشَفتُ قَبلَ ثَنايا","هُ جُماناً مُنَضَّداً في لِثاتِ",52,"ت",1,0],["مِن فِتيَةٍ راضَ الوَقارُ نُفوسَها","فَبَدا سُكونُ الحِلمِ في حَرَكاتِها",53,"ت",3,0],["مِن فِتيَةٍ بِحُمَيّا الشُكرِ قَد سَكِرَت","لِفَرطِ ما اِغتَبَقَت بِالمَدحِ وَاِصطَبَحَت",54,"ت",1,0],["مِن فِتيَةٍ كَسَروا غُمودَ سُيوفِهِم","وَاِستَبدَلوا قُلَلَ الرُؤوسِ غُمودا",55,"د"