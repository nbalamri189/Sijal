ttps://www.aldiwan.net/poem41412.html","المتدارك"],[432,"يرق بدا ام ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[435,"طوبى لمن ترك اللذات وازدجرا","https://www.aldiwan.net/poem12464.html","البسيط"],[442,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[444,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[455,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[455,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[455,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[460,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[460,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[460,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[463,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[463,"أمر مطاع أتاني","https://www.aldiwan.net/poem15329.html","المجتث"],[466,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[467,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[479,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[479,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[479,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[479,"دعني أكابد أشجاني وأوصابي","https://www.aldiwan.net/poem15233.html","البسيط"],[479,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[484,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[502,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[502,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[516,"من فوق صادين عينيك الدعج نونان","https://www.aldiwan.net/poem20916.html","المواليا"],[517,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[517,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[517,"الدمع يهمل والفؤاد عليل","https://www.aldiwan.net/poem12226.html","الكامل"],[531,"مولاي ذا الكرامه","https://www.aldiwan.net/poem37163.html","منهوك المنسرح"],[540,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[540,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[553,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[553,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[553,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[553,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[555,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[560,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[560,"بنغمة العود لاح لي أثر","https://www.aldiwan.net/poem34531.html","المنسرح"],[560,"خالق الكل واحد","https://www.aldiwan.net/poem34618.html","مجزوء الخفيف"],[563,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[564,"حنا سلامة بالسلامة قد مضى","https://www.aldiwan.net/poem52545.html","الكامل"],[564,"لا تجزعوا يا بني العوراء واصطبروا","https://www.aldiwan.net/poem52575.html","البسيط"],[564,"قبر سقاه الله غيث كرامة","https://www.aldiwan.net/poem52701.html","الكامل"],[564,"قبر لانطون ابن أرقش من قضى","https://www.aldiwan.net/poem52703.html","الكامل"],[564,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[564,"أليوم مات التقى والجود والكرم","https://www.aldiwan.net/poem52783.html","البسيط"],[577,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[577,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[588,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[589,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[792,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17740","الطويل"],[1093,"","https://poetry.dctabudhabi.ae/diwan/poem/75832","البسيط"],[1180,"","https://poetry.dctabudhabi.ae/diwan/poem/31515","البسيط"]],"verses":[["مُنفَلِتَ الأُظفورِ مِن شَقِّ الجَلَم","أَقسَمتُ بِالبَيتِ الحَرامِ وَالحُرُم",0,"م",1,0],["مِن فارِسٍ يَحمِلُ أُسدَ الشَرى","لِمُلتَقى يَومِ رَدىً أَيوَمِ",1,"م",1,0],["مَن فاعِلٌ مِن بَعدِهِ كَفِعالِهِ","أَو قائِلٌ مِن بَعدِهِ ما قالا",2,"ل",2,0],["منْ فَرعِ عدْنانَ في أزكى أرومَتِها","كالبَحْرِ يدفَعُ أمواجاً بأمْواجِ",3,"ج",1,0],["مُنَفَّجَةُ الدَفَّينِ طُيِّنَ لَحمُها","كَما طُيِّنَ بِالضاحي مِنَ اللَبَنِ مِجدَلُ",4,"ل",1,0],["مِن فُنونٍ أَعجَزَت أَطواقَنا","وَعُلومٍ عِندَها الفِكرُ وَجَم",5,"م",1,0],["مُنَفَّرُ النَومِ سَبّاقٌ لِغايَتِهِ","آثارُهُ عَمَمٌ آمالُهُ أَمَمُ",6,"م",1,0],["مَن فيهِ لِلمُجتَلي وَالمُبتَلي نَسَقاً","جَمالُ مَرأَىءً عَليهِ سَروُ مُختَبَرِ",7,"ر",1,0],["مَنْ فِيهِمْ نَدُّ الْجَمِيلِ إِنْ","تَرَسَّلَ أَوْ خَطَبْ",8,"ب",1,0],["مِنْ فَحَمَاتِ اللَّيْلِ تَجْلُو الضُّحَى","وَظُلُمَاتِ الرَّيْبِ تَجْلُو اليَقِينْ",9,"ن",1,0],["مَنْ فَرَّقَ الأَخَوَيْنِ يَسْتَبِقَانِ مِنْ","طُرُقٍ لِرِفْعَتِهَا أَلَيْسَ بِمُجْرِمِ",10,"م",1,0],["من فصل منطقها ورائق رسمها","مستمتعُ الأسماع والأبصارِ",11,"ر",1,0],["من فتحك الأسنى عن الجيش الذي","بثباته أهل الوغى تتمثّلُ",12,"ل",1,0],["من فاته غرّ المساعي فاته","بعد الممات بغيرها الأنشار",13,"ر",1,0],["من فخر أزماننا في العلم أنّهما","علاّمتا هذه الأزمان والحقب",14,"ب",1,0],["مِن فَقدِ مَولىً تَصورُ الحَيَّ جَفنَتُهُ","أَو رُزءُ مالٍ وَرُزءُ المالِ يُجتَبَرُ",15,"ر",1,0],["من فوقه أنت بمقدار ما","تطيفك الأبصار من تحته",16,"ت",2,0],["من فيضِ جودك جادَ الفائضون ندى","كأنَّك البحرُ يُروَى عنه بالخلج",17,"ج",1,0],["منفرد الحسن لا نظير له","صيرني في الغرام منفردا",18,"د",2,0],["من فوق خضراء سقى روضها","غيثُ أياديك التي تهمع",19,"ع",1,0],["منفذٌ في هواه حاصل دمعي","وله سالف يريد الباقي",20,"ق",2,0],["من فعلك أشتقّ المقال فمن يقل","هذا تصدُّق قيل إذ هذا صدق",21,"ق",1,0],["من فضل جدواه أرجوها فيغْرقني","بحرٌ لديه بحار الأرض كالوشل",22,"ل",1,0],["من فوق خدّكَ خالٌ مثل غالية","بعت السلوّ على أمثاله غالي",23,"ل",2,0],["منفرد بالحبِّ في دار الهنا","مثاله الدار وزيد وأنا",24,"ن",2,0],["من فتيةٍ مثلِ أسودِ الشّرى","وصبيةٍ تحسبُهُمْ ربربا",25,"ب",2,0],["من فتىً لو رَأيتَهُ لرأتْ عيْ","ناك عِلماً وحِكمةً في ثيابِ",26,"ب",1,0],["منفردٌ بالكمال مُغتربٌ","فيه حرىً أن يطول مُغتربُهْ",27,"ب",2,0],["من فضله عند الحِجَاج بأنه","زهر ونَوْر وهو نبت واحدُ",28,"د",1,0],["من فتَى كلما بلوتَ من الفت","يانِ غُسَّاً ألْفيتَه غير غسِّ",29,"س",1,0],["من فتَىً لو رضيتُ بالناس قَيْضاً","منه كنتُ الغبينَ عند القِياض",30,"ض",1,0],["من فقحةٍ حَقَّ اتِّساعُ حِتارها","إذ لا تُفارقُ دهرها مِسواطا",31,"ط",2,0],["من فتاةٍ تحلُّ كلَّ ربيعٍ","بمغانٍ من المها مِحْلالِ",32,"ل",1,0],["من فتىً أسْمنَ المكارمَ حتى","هزَّلتْه وحبذا من هُزالِ",32,"ل",1,0],["من فَتىً للذَّكاءِ كلُّ حراكٍ","حلَّ فيه وللوقاء سكونُه",33,"ن",2,0],["مِن فَوقِها اِنتَشَرَ الضِياءُ مَلاءَةً","مِن فَوقِهِ جَوٌّ صَفا وَتَبَلوَرا",34,"ر",2,0],["من فتية راضوا الصعاب بحكمة","سلت سخيمة كل قلب ناز",35,"ز",1,0],["مَن في النُهى مِثلِيَ حَتّى الوَرى","أَصبَحتُ فيهِم مَثَلاً يُضرَبُ",36,"ب",1,0],["مَن في البَرِيَّةِ كَالفاروقِ مَعدَلَةً","وَكَاِبنِ عَبدِ العَزيزِ الخاشِعِ الحَشِمِ",37,"م",1,0],["مَن فاتَهُ ظِلُّ الشَبي","بَةِ عاشَ غَيرَ مُظَلَّلِ",38,"ل",1,0],["مِن فَتىً حَلَّ مِنَ الجَوِّ بِهِم","فَتَلَقّوهُ عَلى هامٍ وَراح",39,"ح",1,0],["مِن فَتحِ هاشِمَ أَو أُمَيَّةَ لَم يُضِع","آساسَها تَتَرٌ وَلا أَعجامُ",40,"م",1,0],["مِن فَلِّ جَيشٍ وَمِن أَنقاضِ مَملَكَةٍ","وَمِن بَقِيَّةِ قَومٍ جِئتَ بِالعَجَبِ",41,"ب",1,0],["مَن في الأَنامِ مِنَ الكِرامِ وَلا تَقُل","مَن فيكِ شَأمُ سِوى شُجاعٍ يُقصَدُ",42,"د",1,0],["مُنفَرِدَ المُهرِ عَنِ الرِعالِ","مِن عِظَمِ الهِمَّةِ لا المَلالِ",43,"ل",1,0],["مِن فُحشِ أَمرِ الدُنيا وَمِن عَجَبِه","أَن يُنخَسَ الهَوهَرِيُّ في ذَنَبِه",44,"ه",1,1],["مِن فَتىً يَفتَدي فَيُكثِر تَبدي","دَ العَطايا مِن وَفرِهِ المَجموعِ",45,"ع",1,0],["مِن فَوقِ مُرتَقِبٍ باتَت شَآمِيَةٌ","تَلُفُّهُ وَسَماءٌ تَنضَحُ الدِرَرا",46,"ر",2,0],["مَن فارَقَ القَصدَ لَم يَأمَن عَلَيهِ هَوىً","يَدعو إِلى البَغيِ وَالعُدوانِ وَالسَرَفِ",47,"ف",1,0],["مُنفَرِداً بِالفِكرِ عَن صَحبِهِ","مُستَوحِشاً بِالإِنسِ مِن أُنسِهِ",48,"س",2,0],["مِن فِتيَةِ الكُردِ الَّذينَ لِجَدَّهُم","شَرَفٌ مُنافٍ أَهلَ عَبدِ مَنافِ",49,"ف",1,0],["مِن فَوقِ يَعبوبٍ لَهُ يَومَ الوَغى","سَبقُ القَطا وَتَقَلَّبُ الخَطّافِ",49,"ف",1,0],["مِن فَرطِ إِحداقِ العُيونِ بِحُسنِهِ","خَلَعَت عَلوهِ سَوادَها الأَحداق",50,"ق",1,0],["مِن فِتيَةٍ أَرخَصوا نُفوسَهُمُ","كَأَنَّهُم لِلحَياةِ قَد سَئِموا",51,"م",3,0],["مِن فَمٍ ما رَشَفتُ قَبلَ ثَنايا","هُ جُماناً مُنَضَّداً في لِثاتِ",52,"ت",1,0],["مِن فِتيَةٍ راضَ الوَقارُ نُفوسَها","فَبَدا سُكونُ الحِلمِ في حَرَكاتِها",53,"ت",3,0],["مِن فِتيَةٍ بِحُمَيّا الشُكرِ قَد سَكِرَت","لِفَرطِ ما اِغتَبَقَت بِالمَدحِ وَاِصطَبَحَت",54,"ت",1,0],["مِن فِتيَةٍ كَسَروا غُمودَ سُيوفِهِم","وَاِستَبدَلوا قُلَلَ الرُؤوسِ غُمودا",55,"د",2,0],["مَن فاتَهُ العِزُّ بِالأَقلامِ أَدرَكَهُ","بِالبَيضِ يَقدَحُ مِن أَعطافِها الشَرَرا",56,"ر",2,0],["من فنّ زينبها ومن علامها","زين الشباب وقدوةِ النبغاءِ",57,"ا",2,0],["منفرداً لا خلَّ لي","وأين مَن قلبي معه",58,"ع",2,0],["مُنفّذُ الأمرِ كريمٌ إذا","قالَ نعم فابْشِرْ بنيلِ النّعم",59,"م",1,0],["منفردٌ بالبأس في نفسه","سكونُهُ فيه حَرَاكُ اعتزام",60,"م",1,0],["مِن فاقِعٍ غَضِّ النَباتِ كَأَنَّهُ","دُرُّ يُشَقَّقُ قَبلُ ثُمَّ يُزَعفَرُ",61,"ر",1,0],["مِن فَمٍ قَد غُرِسَ الدُرُّ فيهِ","ناصِحِ الريقِ إِذا الريقُ خانا",62,"ن",2,0],["مَنَّ فَضْلاً عَلَى هَوَازِنَ إذْ كا","نَ له قبلَ ذَاكَ فيهِمِ رِبَاءُ",63,"ا",2,0],["من فوْقِ أدهَمَ لا يَجتازُ غايَتَهُ","نجمٌ من الأفُقِ الشمسيِّ منخرط",64,"ط",1,0],["مِن فَوقِ خَدٍّ أَسيلٍ","يُضيءُ في الظُلُماتِ",65,"ت",1,0],["مِن فَلَتاتِ صَلَتاتٍ شيحِ","تُرجِلُهُ الريحُ بِكَفِّ الريحِ",66,"ح",1,0],["مُنفَرِدٌ في الفَلاةِ توسِعُهُ","رَيّاً وَما يَختَليهِ مِن عَلَفِ",67,"ف",1,0],["مَنفِيَّةِ الأَقذاءِ صَفَّقَها","كَرُّ اللَيالي البيضِ وَالسُحمِ",68,"م",1,0],["مِن فَتاةٍ صُبَّ الجَمالُ عَلَيها","في حَديثٍ كَلَذَّةِ النَشوانِ",69,"ن",1,1],["مِن فَتىً يَعرِفُ الهِلا","لَ غُلاماً قَدِ اِحتَلَم",70,"م",1,0],["مِن فيِه والألحاظُ سُكْرِي بل أرى","في كلّ جارحَة به نَبّاذا",71,"ذ",2,0],["من فتية خاضوا عجا","جتها عَلى الشقر السوابح",72,"ح",1,0],["مَنْ فاقَ ظبياً ومها","أوضحَ عذري ومهدْ",73,"د",1,0],["مِنْ فَرْعِ شَوْحَطَةٍ بِضَاحِي هَضْبَةٍ","لَقِحَتْ بِهَا لقْحاً خِلاَف حِيَال",74,"ل",1,0],["منفتلات قدودهُنَّ كما","ينفتل الغصنُ آده الثمرُ",75,"ر",1,0],["من فتح بلبيس لعين شمس","لا يصبح الضيغم حيث يمسي",76,"ي",1,0],["مِنْ فِتْنَةٍ قد أُسْبِلَتْ","ظُلُماتُها بيَدِ المَظَالِمْ",77,"م",1,0],["مَنْ فِي الشعُوبِ كَفَارُوقَ وَأُسْرَتِهِ","لِيَرْفَعَ الشَّعْبِ مِنْ حَالٍ إِلى حَالِ",78,"ل",1,0],["مَنْ فَاتَهُ نَظَرٌ إِلَيْهِ لَمْ يَزَلْ","مُتَلَفِّتاً بِفُؤادهِ المُتَشَوِّقِ",79,"ق",1,0],["مِنْ فَتَيَاتٍ زَاهِيَاتٍ الْحُلَى","فِي كُلِّ نَادٍ بِالنُّهَى زَاهِرْ",80,"ر",1,0],["مِنْ فَتىً عاش وَهْوَ فِي كُلِّ حَالٍ","كافِلٌ حَاجَةَ الفقِيرِ وكَافِ",81,"ف",1,0],["مِنْ فِتْيَةِ الزَّمَنِ الَّذِينَ سَمَا بِهِمْ","مَوْفُورُ آدَابٍ وَيُمْنُ نَقَائِبِ",82,"ب",1,0],["مِنْ فِعْلِ زُلْفَى عَلَى الْ","قُطْرِ جَرَّتِ الأَرْزَاءَ",83,"ا",2,0],["منفرد في الأزمان","كأحمد في الأعيان",84,"ن",1,0],["مَن فارقَتْهُ يداه في ساح الوغى","أنى يصفِّق للسلام طروبا؟",85,"ب",2,0],["من فاته العز بالأقلام أدركه","بالبيض يقدحُ من أطرفها الشررا",86,"ر",2,0],["من فلَذٍ القلب وأنياطه","حقٌ لتمثالكَ أن يُنصبا",87,"ب",2,0],["من فاجرينَ بكل قارعةٍ","حلّوا تحدَّث عنهم العُهْر",88,"ر",1,0],["من فحش أمر الدنيا ومن عجبه","أن ينخس الجوهري في ذنبه",89,"ه",1,1],["مِنْ فتًى، يَبتَدي، فيَكثُرُ تَبدي","دُ العَطايا في وَفْرِهِ المَجْمُوعِ",90,"ع",1,0],["من فوقه دُرر على تيجان","من فوقه درٌ على تيجان",91,"ن",1,0],["مِن فَضلِهِ بِالمُغربين وَذِكرهُ","بِالمُشرِقين سَرى مَع الرُكبان",92,"ن",1,0],["مَنْ في جميع الخلق يشبه خلقه","في الحالتين النقضِ والإبرامِ",93,"م",1,0],["من في البسيطة مثل الأنبابيّ من","أقطار مغربها لأقصى الصين",94,"ن",1,0],["مَن فيهمُ شأوي ومَن","يحمِل إن حُمِّلَ أوساقى",95,"ق",2,0],["مِنْ فَتاةٍ ي