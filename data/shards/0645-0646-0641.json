م ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[429,"طوبى لمن ترك اللذات وازدجرا","https://www.aldiwan.net/poem12464.html","البسيط"],[436,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[438,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[451,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[451,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[451,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[456,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[456,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[459,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[459,"أمر مطاع أتاني","https://www.aldiwan.net/poem15329.html","المجتث"],[462,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[475,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[475,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[475,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[475,"دعني أكابد أشجاني وأوصابي","https://www.aldiwan.net/poem15233.html","البسيط"],[475,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[480,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[498,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[498,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[512,"من فوق صادين عينيك الدعج نونان","https://www.aldiwan.net/poem20916.html","المواليا"],[513,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[513,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[513,"الدمع يهمل والفؤاد عليل","https://www.aldiwan.net/poem12226.html","الكامل"],[527,"مولاي ذا الكرامه","https://www.aldiwan.net/poem37163.html","منهوك المنسرح"],[536,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[536,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[549,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[549,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[549,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[549,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[551,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[556,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[556,"بنغمة العود لاح لي أثر","https://www.aldiwan.net/poem34531.html","المنسرح"],[556,"خالق الكل واحد","https://www.aldiwan.net/poem34618.html","مجزوء الخفيف"],[559,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[560,"حنا سلامة بالسلامة قد مضى","https://www.aldiwan.net/poem52545.html","الكامل"],[560,"لا تجزعوا يا بني العوراء واصطبروا","https://www.aldiwan.net/poem52575.html","البسيط"],[560,"قبر سقاه الله غيث كرامة","https://www.aldiwan.net/poem52701.html","الكامل"],[560,"قبر لانطون ابن أرقش من قضى","https://www.aldiwan.net/poem52703.html","الكامل"],[560,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[560,"أليوم مات التقى والجود والكرم","https://www.aldiwan.net/poem52783.html","البسيط"],[573,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[573,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[584,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[585,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["مُنفَلِتَ الأُظفورِ مِن شَقِّ الجَلَم","أَقسَمتُ بِالبَيتِ الحَرامِ وَالحُرُم",0,"م",1,0],["مِن فارِسٍ يَحمِلُ أُسدَ الشَرى","لِمُلتَقى يَومِ رَدىً أَيوَمِ",1,"م",1,0],["مَن فاعِلٌ مِن بَعدِهِ كَفِعالِهِ","أَو قائِلٌ مِن بَعدِهِ ما قالا",2,"ل",2,0],["منْ فَرعِ عدْنانَ في أزكى أرومَتِها","كالبَحْرِ يدفَعُ أمواجاً بأمْواجِ",3,"ج",1,0],["مُنَفَّجَةُ الدَفَّينِ طُيِّنَ لَحمُها","كَما طُيِّنَ بِالضاحي مِنَ اللَبَنِ مِجدَلُ",4,"ل",1,0],["مِن فُنونٍ أَعجَزَت أَطواقَنا","وَعُلومٍ عِندَها الفِكرُ وَجَم",5,"م",1,0],["مُنَفَّرُ النَومِ سَبّاقٌ لِغايَتِهِ","آثارُهُ عَمَمٌ آمالُهُ أَمَمُ",6,"م",1,0],["مَن فيهِ لِلمُجتَلي وَالمُبتَلي نَسَقاً","جَمالُ مَرأَىءً عَليهِ سَروُ مُختَبَرِ",7,"ر",1,0],["مَنْ فِيهِمْ نَدُّ الْجَمِيلِ إِنْ","تَرَسَّلَ أَوْ خَطَبْ",8,"ب",1,0],["مِنْ فَحَمَاتِ اللَّيْلِ تَجْلُو الضُّحَى","وَظُلُمَاتِ الرَّيْبِ تَجْلُو اليَقِينْ",9,"ن",1,0],["مَنْ فَرَّقَ الأَخَوَيْنِ يَسْتَبِقَانِ مِنْ","طُرُقٍ لِرِفْعَتِهَا أَلَيْسَ بِمُجْرِمِ",10,"م",1,0],["من فصل منطقها ورائق رسمها","مستمتعُ الأسماع والأبصارِ",11,"ر",1,0],["من فتحك الأسنى عن الجيش الذي","بثباته أهل الوغى تتمثّلُ",12,"ل",1,0],["من فاته غرّ المساعي فاته","بعد الممات بغيرها الأنشار",13,"ر",1,0],["من فخر أزماننا في العلم أنّهما","علاّمتا هذه الأزمان والحقب",14,"ب",1,0],["مِن فَقدِ مَولىً تَصورُ الحَيَّ جَفنَتُهُ","أَو رُزءُ مالٍ وَرُزءُ المالِ يُجتَبَرُ",15,"ر",1,0],["من فوقه أنت بمقدار ما","تطيفك الأبصار من تحته",16,"ت",2,0],["من فيضِ جودك جادَ الفائضون ندى","كأنَّك البحرُ يُروَى عنه بالخلج",17,"ج",1,0],["منفرد الحسن لا نظير له","صيرني في الغرام منفردا",18,"د",2,0],["من فوق خضراء سقى روضها","غيثُ أياديك التي تهمع",19,"ع",1,0],["منفذٌ في هواه حاصل دمعي","وله سالف يريد الباقي",20,"ق",2,0],["من فعلك أشتقّ المقال فمن يقل","هذا تصدُّق قيل إذ هذا صدق",21,"ق",1,0],["من فضل جدواه أرجوها فيغْرقني","بحرٌ لديه بحار الأرض كالوشل",22,"ل",1,0],["من فوق خدّكَ خالٌ مثل غالية","بعت السلوّ على أمثاله غالي",23,"ي",1,0],["منفرد بالحبِّ في دار الهنا","مثاله الدار وزيد وأنا",24,"ن",2,0],["من فتيةٍ مثلِ أسودِ الشّرى","وصبيةٍ تحسبُهُمْ ربربا",25,"ب",2,0],["من فتىً لو رَأيتَهُ لرأتْ عيْ","ناك عِلماً وحِكمةً في ثيابِ",26,"ب",1,0],["منفردٌ بالكمال مُغتربٌ","فيه حرىً أن يطول مُغتربُهْ",27,"ب",2,0],["من فضله عند الحِجَاج بأنه","زهر ونَوْر وهو نبت واحدُ",28,"د",1,0],["من فتَى كلما بلوتَ من الفت","يانِ غُسَّاً ألْفيتَه غير غسِّ",29,"س",1,0],["من فتَىً لو رضيتُ بالناس قَيْضاً","منه كنتُ الغبينَ عند القِياض",30,"ض",1,0],["من فقحةٍ حَقَّ اتِّساعُ حِتارها","إذ لا تُفارقُ دهرها مِسواطا",31,"ط",2,0],["من فتاةٍ تحلُّ كلَّ ربيعٍ","بمغانٍ من المها مِحْلالِ",32,"ل",1,0],["من فتىً أسْمنَ المكارمَ حتى","هزَّلتْه وحبذا من هُزالِ",32,"ل",1,0],["من فَتىً للذَّكاءِ كلُّ حراكٍ","حلَّ فيه وللوقاء سكونُه",33,"ن",2,0],["مِن فَوقِها اِنتَشَرَ الضِياءُ مَلاءَةً","مِن فَوقِهِ جَوٌّ صَفا وَتَبَلوَرا",34,"ر",2,0],["من فتية راضوا الصعاب بحكمة","سلت سخيمة كل قلب ناز",35,"ز",1,0],["مَن في النُهى مِثلِيَ حَتّى الوَرى","أَصبَحتُ فيهِم مَثَلاً يُضرَبُ",36,"ب",1,0],["مَن في البَرِيَّةِ كَالفاروقِ مَعدَلَةً","وَكَاِبنِ عَبدِ العَزيزِ الخاشِعِ الحَشِمِ",37,"م",1,0],["مَن فاتَهُ ظِلُّ الشَبي","بَةِ عاشَ غَيرَ مُظَلَّلِ",38,"ل",1,0],["مِن فَتىً حَلَّ مِنَ الجَوِّ بِهِم","فَتَلَقّوهُ عَلى هامٍ وَراح",39,"ح",1,0],["مِن فَتحِ هاشِمَ أَو أُمَيَّةَ لَم يُضِع","آساسَها تَتَرٌ وَلا أَعجامُ",40,"م",1,0],["مِن فَلِّ جَيشٍ وَمِن أَنقاضِ مَملَكَةٍ","وَمِن بَقِيَّةِ قَومٍ جِئتَ بِالعَجَبِ",41,"ب",1,0],["مَن في الأَنامِ مِنَ الكِرامِ وَلا تَقُل","مَن فيكِ شَأمُ سِوى شُجاعٍ يُقصَدُ",42,"د",1,0],["مُنفَرِدَ المُهرِ عَنِ الرِعالِ","مِن عِظَمِ الهِمَّةِ لا المَلالِ",43,"ل",1,0],["مِن فُحشِ أَمرِ الدُنيا وَمِن عَجَبِه","أَن يُنخَسَ الهَوهَرِيُّ في ذَنَبِه",44,"ه",1,1],["مِن فَتىً يَفتَدي فَيُكثِر تَبدي","دَ العَطايا مِن وَفرِهِ المَجموعِ",45,"ع",1,0],["مِن فَوقِ مُرتَقِبٍ باتَت شَآمِيَةٌ","تَلُفُّهُ وَسَماءٌ تَنضَحُ الدِرَرا",46,"ر",2,0],["مَن فارَقَ القَصدَ لَم يَأمَن عَلَيهِ هَوىً","يَدعو إِلى البَغيِ وَالعُدوانِ وَالسَرَفِ",47,"ف",1,0],["مُنفَرِداً بِالفِكرِ عَن صَحبِهِ","مُستَوحِشاً بِالإِنسِ مِن أُنسِهِ",48,"س",2,0],["مِن فِتيَةِ الكُردِ الَّذينَ لِجَدَّهُم","شَرَفٌ مُنافٍ أَهلَ عَبدِ مَنافِ",49,"ف",1,0],["مِن فَوقِ يَعبوبٍ لَهُ يَومَ الوَغى","سَبقُ القَطا وَ