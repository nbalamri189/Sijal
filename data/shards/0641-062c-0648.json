://poetry.dctabudhabi.ae/diwan/poem/139475",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139581",""],[4767,"أعينيني","https://www.poetsgate.com/ViewPoem.aspx?id=87493",""],[4929,"في طلب دعم صفحة الفيس","https://www.poetsgate.com/ViewPoem.aspx?id=201205",""],[5092,"مسائي","https://www.poetsgate.com/ViewPoem.aspx?id=177001",""],[5112,"فما الجوعين","https://www.poetsgate.com/ViewPoem.aspx?id=212832",""],[5135,"رِحْلَة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=201963",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5277,"صبا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=186418",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5369,"ستشرق شمس","https://www.poetsgate.com/ViewPoem.aspx?id=177450",""],[5431,"إن الفؤاد لمن يهواه قد شفعا...","https://www.poetsgate.com/ViewPoem.aspx?id=190514",""],[5431,"تُنار بنا الأكوان تُجلى الغياهب","https://www.poetsgate.com/ViewPoem.aspx?id=194570",""],[5431,"باريس ...","https://www.poetsgate.com/ViewPoem.aspx?id=208588",""],[5459,"اضمحلال","https://www.poetsgate.com/ViewPoem.aspx?id=190891",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5690,"أما ينقضي هذا التدلل والصدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=172154",""],[5736,"أنين قلب","https://www.poetsgate.com/ViewPoem.aspx?id=208863",""],[5943,"أبا رامي حماك الله فاسلم","https://www.poetsgate.com/ViewPoem.aspx?id=37261",""],[5953,"وباكي يبكي على ربه","https://www.poetsgate.com/ViewPoem.aspx?id=93796",""],[5957,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=27046",""],[5977,"إليك شددت المطايا","https://www.poetsgate.com/ViewPoem.aspx?id=213069",""],[161,"ضاع ترتيب الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=180916",""],[6093,"ربابٌ ( الوافر)","https://www.poetsgate.com/ViewPoem.aspx?id=176208",""],[6134,"أسرت فؤادي في عواك بأسره","https://www.poetsgate.com/ViewPoem.aspx?id=169568",""],[6134,"طول البعاد مزق صبري يا غائبين","https://www.poetsgate.com/ViewPoem.aspx?id=169589",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""],[463,"على أيّ لائمة ٍ أربعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60121&r=&rc=177",""],[6277,"والعلم في عمان أزياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64489&r=&rc=52",""]],"verses":[["فَجوبي المَلا أَو جاوِري بي رَبيعَةً","وَأُسرَةَ عَيلانِ الطِوالِ الغَطارِفِ",0,"ف",1,0],["فجِوارُهُ حَرَمٌ وأنتَ حَمامةٌ","ورْقاءُ والأغْصانُ عودُ المِنْبَرِ",1,"ر",1,0],["فجَوارِحُ الإسْلامِ أنْتَ حَياتُها","حقّاً وصدْرُ الدّين أنتَ صِدارُهُ",2,"ر",2,0],["فَجودي عَلَيهِ بِالدُموعِ وَأَعوِلي","لِفَقدِ الَذي لا مِثلُهُ الدَهرُ يوجَدُ",3,"د",1,0],["فجودُ بنانِهِ بحرٌ فراتٌ","وجودُ بنان أقوامٍ فصيخ",4,"خ",1,0],["فجوابي هناكَ للْمجتديهِ","كجواب امرئٍ أخي تفويه",5,"ي",2,0],["فَجودي بِما يَشفي السَقيمَ وَخَلِّصي","أَسيراً بِلا جُرمٍ أَطَلتِ لَهُ الكَبلا",6,"ل",2,0],["فَجوعٌ لِأَهلِ الصالِحينَ مَزَلَّةٌ","مَخوفٌ رَداها أَن تُصيبُكَ فَاِحذَرِ",7,"ر",1,0],["فَجودُ كَفَّيهِ لَم تُقلِع سَحائِبُهُ","عَنِ العِبادِ وَجودُ السُحبِ لَم يُقِمِ",8,"م",1,0],["فَجوازي باضطِرارٍ عِندَها","كجوازِ الفتح في الحرفِ الدخيلِ",9,"ل",1,0],["فَجَوارِحي مَجروحَةٌ","مِنها بِسَيفٍ مُضمَرِ",10,"ر",1,0],["فَجودُ راحَتِهِ رَيٌّ بِلا شَرَقٍ","وَضَوءُ سيرَتِهِ نورٌ بِلا ظُلَمِ",11,"م",1,0],["فَجَوَّزَها عَنّي عُقاراً تَرى لَها","إِلى الشَرَفِ الأَعلى شُعاعاً مُطَنَّبا",12,"ب",2,0],["فَجودي بِالوِصالِ لِمُستَهامٍ","بِذِكرِكِ في المَساءِ وَفي الصَباحِ",13,"ح",1,0],["فَجوروا وَاِطلُبوا قَتلي وَظُلمي","وَتَعذيبي فَإِنّي لا أَمَلُّ",14,"ل",1,0],["فجوهرُ ثغرِكِ الفتَانِ فَرْدٌ","تأبَّى أَنْ يرىَ فيه انقساما",15,"م",2,0],["فجوابي هناكَ لِلْمجتديهِ","كجواب امرىء أخي تفويه",16,"ي",2,0],["فَجُوعٍ بها لِلصَّالِحِينَ مَزِلَّة ٍ","مخوف رداها أن تصيبك فاحذر",17,"ر",1,0],["فجول اللَه حولي","ومن الرحمن سؤلي",18,"ل",2,0],["فجودك عم الكل بالأرض والسما","وباب حماك الحصن للإنس والجن",19,"ن",1,0],["فجود دمعى أسى وشوقا","كجود سلطان صار طبعا",20,"ع",2,0],["فجودُ عميد الدولة العُشبُ والحيا","ومقتَرَحُ الراجى وازادُ المسافرِ",21,"ر",1,0],["فَجودٌ أَنالَ جَميعَ المُنى","وَجودٌ بِبالِ المُنى ما خَطَر",22,"ر",1,0],["فجودوا بفضل واسعفوني بما ذكر","ت من فيضكم واعطوا معي كل آمل",23,"ل",1,0],["فجوزي جزاء المخلصين صنيعُهم","مع العلم أَن الصنع فيه سِقام",24,"م",1,0],["فَجُودا بِلا مَنٍّ وَجُودَا بِلا أَذىً","فَما ماتَ مَومُوقٌ وَلا عاشَ وَامِقُ",25,"ق",1,0],["فجودٌ عَميمٌ يُنبِت العزّ والغنى","وعزمٌ له هامُ الكُماةِ حَصيد",26,"د",1,0],["فجودُك مثبوث وعدلُك شامل","وحلمك موفور وبأسُكَ رائع",27,"ع",1,0],["فجودهُ قد زرى بالسُحب منحدراً","والخَلْقُ في دارِه للبَذْلِ تَعْتَكِفُ",28,"ف",1,0],["فَجُودُك سَجْلٌ للمُطِيعين وابلٌ","وسَيْفُك في العاصِين قاضٍ وحاكمُ",29,"م",1,0],["فَجوزيتُم لِبُغضِكُمُ عَلِيّاً","عَذابَ الخُلدِ في الدَرَكِ القَصِيِّ",30,"ي",1,0],["فجوفها قربةٌ وفي حرها","خندق بول وبظرها سور",31,"ر",1,0],["فَجَوهَرُها من الأعراضِ يَبدو","لأهلِ الحقّ سِرّاً أو جَهارا",32,"ر",2,0],["فَجود وابو صل فالزَمان مفرق","وأكثر عمر العاشقين قَصير",33,"ر",1,0],["فَجودك يا ذا الكبرياء مؤمل","وَحبلك للراجين بالخير يوصل",34,"ل",1,0],["فَجودوا بِكُتبٍ إِنَّ في الكُتبِ راحَةً","وَحاشاكُم أَن تَقطَعوا الكُتبَ حاشاكُم",35,"م",1,0],["فَجودُكَ عَمَّ العالَمينَ وَخَصَّهُم","وَلَم نَرَ جوداً قَبلَهُ مَلأَ الدَّهرا",36,"ر",2,0],["فَجوابي شِعرٌ وشعرُكَ سِرٌّ","حار في دَركه أُولو الأَلبابِ",37,"ب",1,0],["فَجودك لا يثني بذنبٍ عن امرئٍ","وَكيف غثاءُ السيلِ يمنعه الذعبا",38,"ب",2,0],["فَجُوزيَ خَيراً من زمَانٍ مَضَى بِهِ","أخٌ لِوِصَالِ الغَانِيَاتِ شَقِيقُ",39,"ق",1,0],["فجُودُه نَثْرُ شآبيبِ الحَيا","ورأْيُه حَدُّ الحُسامِ المُرْهَف",40,"ف",1,0],["فجودوا علينا بالدعاء تفضلاً","وقولوا أسير الشوق في حفظ مولاه",41,"ا",2,0],["فَجودُ سواك رَمَيةُ غَير رامٍ","وَجودك رَمية من كَفِّ رامِ",42,"م",1,0],["فجُودُه السّكبُ إن أكْدَتْ مخَايِلُهُ","يَوماً فكم سَحَّ بالنُّعمى وكم سَفَحَا",43,"ح",2,0],["فجوزيت يا مولاي خيراً فقد غدت","أياديك عندي في الجميل رغابا",44,"ب",2,0],["فجوزاء أُفقٍ بالدَّراري تمنْطَقَتْ","مخدّمة تَستخدم البيض والسُّمرا",45,"ر",2,0],["فجود لسانه درٌّ ثمينٌ","وجود بنانه كرم ورفد",46,"د",1,0],["فجوابه وثوابه","قد أعجبا أخذاً وردَّا",47,"د",2,0],["فجودهُ دائم التسكاب متّصل","والغيث جيأته في عامنا دفعُ",48,"ع",1,0],["فجوزيتَ عن سعيِ البِلادِ بأَنْعُمٍ","ذخائِرُها فَوْزٌ وعاجِلُها فَتْحُ",49,"ح",1,0],["فجودُكَ بالعذرِ والعُرفِ لي","سماحان هذا وذا يُوسِعُ",50,"ع",1,0],["فجودي قبل رحلته وعودي","فقاطنه سريع الانتقال",51,"ل",1,0],["فجوابهم قد كان بلى","في الأصل لمعنى ممتزج",52,"ج",1,0],["فجوز الغصب لمن قد اغتصب","وأوجب الأمر لكل من غلب",53,"ب",1,0],["فَجوزِيتَ عنِّي خَيْر الجزاءِ","وأَعطاكَ مَنْ بيَديْهِ العطاءُ",54,"ا",2,0],["فَجَوارحي عظَّمْن قَلْبي إِذ غَدا","مَثْواه والأَوْطانُ بالقُطَّانِ",55,"ن",1,0],["فجود كفِّكَ ذُخْرٌ في يَدِي ويدي","وحُبُّ بيتكِ إِرْثِي عن أَبِي فَأَبِي",56,"ب",2,0],["فجوائز العَلم المليء بمعجز ال","ألفاظِ غَيرِ جوائزِ الشَّحاذِ",57,"ذ",1,0],["فجوايَ متّصلُ الظلامِ بضوئِهِ","الليلُ عندي والنهارُ سواء",58,"ا",2,0],["فَجَوهَرُ الحُسنِ مِنها كانَ مَنشأُهُ","وَلَم يَكُ الحسنُ فيها غَيرَ مُكتَمِلِ",59,"ل",1,0],["فَجودُهم جودُ هَذا البحرِ ناسِخهُ","كَنَسخِ شِرعةِ طهَ شَرع كُلِّ نَبي",60,"ب",2,0],["فَجَوهَرُ النورِ فيه يا مُؤرّخه","يَقومُ وَالمِسكُ أَمسى هالةَ القمَرِ",61,"ر",1,0],["فَجودي أيا عيني وبَكيّ عهودَها","ففي مثلها تهمي الدموع فتُعذر",62,"ر",1,0],["فَجوزِيتَ يا ابنَ العَمِّ عَنِّي بِصَالحٍ","ولا زِلتَ تبنِي مَجدَنا ثُمَّ لا زِلنا",63,"ن",2,0],["فجوهر لفظه زُفَرٌ صغير","وعين معينه زُفَرٌ مديدُ",64,"د",1,0],["فجودك جود متلاف وهوب","وعودك حين تفخر خير عودِ",65,"د",1,0],["فجوده رائح وغاد","يسري إلى رائح وغادِ",66,"د",1,0],["فجودوا عليها بالتقبل منكم","نودي وإخلاصي بذاك ضمينُ",67,"ن",1,0],["فجوده الهطال بازدياد","بادٍ لكل حاضر وباد",68,"د",1,0],["فجودُكَ مُستَنٌ على مُهَجِ النَّدَى","وإِنْ كَلَحْتْ حَرْبٌ فسِنُّكَ مُفْترُّ",69,"ر",1,0],["فجودكم غير مخصوص به أحد","كالغيث فيه سواء سائر البشر",70,"ر",1,0],["فجودوا بوصل فالزمان مفرق","ورقوا لعبد حار فهو ضرير",71,"ر",1,0],["فَجودُه عَمَّ كُلَّ الناسِ قَاطِبَة","دُنيا وَأُخرى وَمِنهُ القَصد مَبذولُ",72,"ل",1,0],["فجوانحي كادت تمزقها النوى","ومدامعي كالعارض الهتان",73,"ن",1,0],["فجودُ بني نبهان عندي وفَضلُهم","على فضل أبناء العتيك دَليلُ",74,"ل",1,0],["فجودي بعطفٍ عليَّ تسودي","وعودي عن الظلم فالعود احمد",75,"د",1,0],["فجودك شامل كل النواحي","أتاه الناس أو مرؤ ظمى",76,"م",2,0],["فجود طه عميم يرتجى أبدا","كصيّب القطر لا ينفك منحدر",77,"ر",1,0],["فجوزٌ سَرى في النَفسِ وَهيَ تَقِيَّةٌ","فَكانَ سَواداً في خَلائِقي الغُرِّ",78,"ر",1,0],["فجود يميني عادة عرفت بها","وكل يمين لم تجد كشمالك",79,"ك",1,0],["فجوهر اللفظ منظوماً ومنتشراً","بغير مدحك يا ذا الفضل لم يَلِق",80,"ق",1,0],["فجودوا معي بالدمع سحّاً فما له","يزيد به نار الضلوع توقدا",81,"د",2,0],["فجوركم أجرى دموعي وقد","كنتم على جيرون جيرانا",82,"ن",2,0],["فجوامعُ الكلم التي أسماؤها","في آدمِ هي للمقرَّبِ أحمدا",83,"د",2,0],["فجولوا بميدان أسمائنا","فميدان أسمائنا ملعب",84,"ب",1,0],["فجوارُ الإله خيرُ جوارٍ","تعلموه يومَ الورودِ يقينا",85,"ن",2,0],["فجودُك الغيثُ أما إنّه","في لّ أرضٍ مُطْلَقاً يَنْزِلُ",86,"ل",1,0],["فَجَوَابُنَا الثَّانِي امتَنَاعُ النفيِ فِي","مَا تَدَّعُونَ لُزُومَهُ بِبَيَانِ",87,"ن",1,0],["فَجوبوا الفَيافي لِلمَعارِفِ إِنَّها","لِمَنثورِ عِقدِ الصالِحاتِ نِظامُ",88,"م",1,0],["فجوهر النفس غال قدر قيمته","عند الكريم رخيص عند كل دني",89,"ن",2,0],["فجوّزه في الأولى وحرّمه في الأصح","على هذه الصبيان من مصمت زد",90,"د",1,0],["فجوده طوق الأَعناقا","وعلمه حلية الآذان",91,"ن",1,0],["فَجودا لِلَيلى بِالكَرامَةِ مِنكُما","وَما شِئتُما أَن تَمنَعا بَعدُ فَاِمنَعا",92,"ع",2,0],["فَجُودك مثل البَحر باق بِحاله","وَكُل الوَرى مِنهُ تَعبُّ وَتَغرف",93,"ف",1,0],["فجوزيتَ ما جوزي اللَعينُ ابن ملجمٍ","وفي غضَبِ الرحمنِ تُمسى وتُصبِحُ",94,"ح",1,0],["فَجَوِّد لَهَا التَّقمينَ لا تَكُ غافلا","عَن البرِّ والمجرى وللمَد حَاذِر",95,"ر",1,0],["فجوِّد لَهَا التَّقمينَ ثُمَّ قياسَهَا","ولا تَرقُدِ الليلَ الطويلَ وسَاهِر",95,"ر",1,0],["فجودوا بوصل فالزمان مفرقٌ","له صدماتٌ شأنهن نكير",96,"ر",1,0],["فجودوا بتشريفي فاني لفضلكم","مقيم على حفظ الوداد أمين",97,"ن",1,0],["فجودوا بتشريفي لحظي وحظوتي","ف