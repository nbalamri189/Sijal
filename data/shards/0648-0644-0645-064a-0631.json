tsgate.com/ViewPoem.aspx?id=190143",""],[5081,"لَكِ اللهُ يَا حَلَب","https://www.poetsgate.com/ViewPoem.aspx?id=190531",""],[3591,"تقرب كل للكريم أخي الجدا","https://www.poetsgate.com/ViewPoem.aspx?id=149402",""],[5163,"إذا الشمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=33951",""],[5186,"رفعت إلى أوج العلى راية الهند","https://www.poetsgate.com/ViewPoem.aspx?id=156480",""],[5277,"خاتمةُ المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=199869",""],[5302,"تطاول ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=201153",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[592,"أهاجك أزماة تسامى بها الخلف","https://www.poetsgate.com/ViewPoem.aspx?id=128857",""],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5442,"أرحها فقد مل الظلام سراها","https://www.poetsgate.com/ViewPoem.aspx?id=114763",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5464,"ليالينا عقيمات ... ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=27774",""],[5582,"لِمَنْ مَرْبَعٌ للبُقْعِ فِيهِ نَعِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186672",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[5616,"كمل النصاب","https://www.poetsgate.com/ViewPoem.aspx?id=203468",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5956,"أ تأتي الإمارات يا صالح؟","https://www.poetsgate.com/ViewPoem.aspx?id=194595",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[520,"العلم مذ كان محتاج الى العلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577651",""]],"verses":[["وَلَم يَرفَعوا بَينَ الغُوَيرِ وَحاجِرٍ","قِبابَهُمُ ما دامَ لِلبُدنِ ناحِرُ",0,"ر",1,0],["ولمْ يرْضَ منْ بعْدُ بالأهْلِ أهْلاً","ولمْ يرْضَ منْ بعْدُ بالدّارِ دارا",1,"ر",2,0],["وَلَم يَرَنا كالِئٌ كاشِحٌ","وَلَم يَفشُ مِنّا لَدى البَيتِ سِر",2,"ر",1,0],["ولم يُرضِه سرج الهلال مُفضْضاً","فأعرض عنها للأهلة ناعلُ",3,"ل",1,0],["وَلَم يَرتَغِب في العَيشِ عيسى اِبنُ مُصعِبٍ","وَلا خَفَّ خَوفَ الحَربِ قَلبُ حَبيبِ",4,"ب",1,0],["وَلَم يُرجَ إِلّا كُلُّ أَروَعَ ماجِدٍ","شَديدِ القُوى ذي عِزَّةٍ وَتَكَرُّمِ",5,"م",1,0],["ولم يركم أمرٌ طلبتُمْ صلاحه","تَكأَّدَكم ما دونه من كَئُودِهِ",6,"د",2,0],["ولمْ يرَ الزْناةُ فيها مَلْبسا","كَذَاكَ تَلقَى الحُوَّل المُجرَّسا",7,"س",2,0],["ولم ير ضيفٌ قرى قبله","مضيفاً ولا كان فيما سُمع",8,"ع",1,0],["ولم يرَهُ الراؤون من قبل موتها","بحيث بدا لا المُعْرِبون ولا العَجَمْ",9,"م",1,0],["وَلَم يَرُعني إِلّا قَولُ عاذِلَةٍ","ما بالُ أَحمَدَ لَم يَحلُم وَلَم يَقِرِ",10,"ر",1,0],["وَلَم يَرضَ مِن جُرزانَ حِرزاً يُجيرُهُ","وَلا في جِبالِ الرومِ رَيداً يُجاوِرُه",11,"ر",2,0],["وَلَم يُرَ يَوماً قادِراً غَيرَ صافِحٍ","وَلا صافِحاً عَن زَلَّةٍ غَيرَ قادِرِ",12,"ر",1,0],["ولَم يرحَمِ الأَرحامَ منها أقارِبٌ","تروّي سيوفاً من نجيع أقارِبِ",13,"ب",1,0],["وَلَم يَرضَ قَبضَتَهُ لِلحُسامِ","وَلا حَملَ عاتِقِهِ لِلرِداءِ",14,"ا",2,0],["وَلَم يُرَ مِنّا قاتِلٌ مِثلُ عامِرٍ","وَلا مِثلُ سَلمى مُشتَرىً وَمَبيعُ",15,"ع",1,0],["وَلَم يُربِني وَقَد أُرى فِطِناً","أَعقِلُ ما مِثلَهُ الفَتى عَقَلا",16,"ل",2,0],["وَلَم يَرعَها راعٍ رَبيبٌ وَلَم تَزَل","هِيَ العُروَةُ الوُثقى لِمَن يَستَجيرُها",17,"ر",3,0],["وَلَم يُرِحهُ قَلَقٌ","حَتّى غَدا ذا قَلَقِ",18,"ق",1,0],["وَلَم يُرَ في الهَوى مِثلي وَفِيٌّ","إِذا اللاحي عَلى حُبٍّ لَحاني",19,"ن",2,0],["وَلَم يَرعَ تَعالى اللَ","هُ رَبّي حُرمَةَ الشَهرِ",20,"ر",1,0],["وَلَم يُرضِهِم شُربُ المُدامَةِ أَذهَبَت","حِجى النَفسِ إِلّا أَن يُمازِجَها الدَمُ",21,"م",1,0],["وَلَم يَرضَيا إِلّا بِنَفسي مِنَ القِرى","وَلَو صُنتُهُ عَن طارِقَي لِأَحزاني",22,"ن",2,0],["وَلَم يَرضَوا لِما سَكَنوهُ شيداً","إِلى أَن فَضَّضوهُ وَأَذهَبوهُ",23,"ب",3,0],["ولَمْ يَرِدِ الماءَ السِّدامَ إذا بَدا","سَنا الصُّبْح في بادِي الجَواشي مُوَّرِ",24,"ر",1,0],["وَلَمْ يُرَفَّهْ عَنْهُ عَنَاءٌ","بَيْنَ اصْطِبَاحٍ أَوِ اغْتِبَاقِ",25,"ق",1,0],["ولم يَرِدِ المَاء السِّدامَ إذا بَدَا","سنا الصبح في بادي الحواشي منورِ",26,"ر",1,0],["ولم يرْهبُ الموْتُ شُبَّانَها","ولم يُعتق الموتُ كُهَّالَها",27,"ل",3,0],["ولم يرْهبُ الموْتُ أسْدَ الشَّرَى","فغال الأسودَ وأشبالَها",27,"ل",3,0],["ولم يرحمِ الموتُ ذاتَ سُوارٍ","قضتْ وهْيَ تحضنُ أطفالَها",27,"ل",3,0],["ولم يُرَ ذا بَطْشٍ شَديدٍ وغِلظَةٍ","على بَلَدٍ إلا البعيدُ المُجنَّب",28,"ب",1,0],["ولم يرحم الأرحامَ منهم أقاربٌ","تروي سيوفاً من نجيع أقارب",29,"ب",1,0],["ولمْ يرتغبْ في العيشِ\"عيسى بنُ مصعبِ\"","وَلا خَفّ خوْفَ الحرْبِ قلبُ حبيبِ",30,"ب",1,0],["ولم يرع الخؤن له ذماما","وهل يرعى لدى الخب الذمام",31,"م",1,0],["ولَم يَركَب وقد أخَذَتهُ كفي","عَدوي مَركَباً ِإلاَّ الأُرَانَا",32,"ن",2,0],["ولَم يَرحَلُوا منا بِزَادٍ فَكُلُّهُم","يُجِيبُ الرَّدَى عَجلاَنَ لَن يَتَعَرَّضا",33,"ض",2,0],["ولَمىً رضابُ النحل يش","هد أنَّ ريقتَه شِهادُ",34,"د",1,0],["وَلَم يُرضِهِ أَن فاقَ في البَأسِ عامِراً","وَعَمراً إِلى أَن فاقَ في الحِلمِ أَحنَفا",35,"ف",2,0],["وَلَم يُرضِها وَخدُ المَهارى تَعاطِياً","عَلَيها فَأَستَنَّ النَعامَ المُصَلَّما",36,"م",2,0],["ولم يرضى إلا العدل في الناس شيمة","بدنيا يوفِّيها ودين يفيده",37,"د",2,0],["ولم يرض لمكا فيه بالعسف أصبحت","رعيته تشكو كما يشتكى العدى",38,"د",2,0],["ولم ير في قتلي مواضيه ثائراً","ولا في دم بالسيف أجراه واديا",39,"ي",2,0],["ولم يره في قبره منهم امرؤ","ولا حادثوه وهو فيه مغيب",40,"ب",1,0],["ولم ير بالطوفان إغراق قومه","ورد على من قال رد المناكر",41,"ر",1,0],["وَلَم يرعَ ما قَد كانَ مِن خُلفِ دَهمَشٍ","وَقالَ الوَفا في مِثلِها غَيرُ واجِبِ",42,"ب",1,0],["وَلم يَرعَ مِن ثاجٍ إِلى الرَملِ مُصرِمٌ","عَلى عَهدِهِ إِلّا اِستُبيحَت حَلائِبُهْ",43,"ب",2,0],["وَلَم يَرزَ مَنصُوراً فَتيلاً لِمُلكِهِ","عَلَيهِ وَلا أَولاهُ إِلّا فَواضِلا",44,"ل",2,0],["وَلَم يُر في الأوثان في كلّ بلدةٍ","بِها عُبِدت ما حازَ من شرّه العشرا",45,"ر",2,0],["ولم ير أن البدر في وسطِ خلقِه","سواد ولكن عقلِه",46,"ل",2,0],["ولم يرفى الدنيا من الناس ربّه","بعينيه إلا الهاشمي المشّفع",47,"ع",1,0],["وَلَمْ يَرْكَنْ إِلَى أَصْلٍ وَفَرْعٍ","وَعِزَّةِ وَالِدَيْنِ وَجَاهِ وُلْدِ",48,"د",1,0],["ولم يَرضَ يوماً للمسئ إذا أسا","مقابلةً لكنه يرتضى الجبرَا",49,"ر",2,0],["ولم يرض للمرء الإهانة خطة","على حالة إلا الدناءة في الأصل",50,"ل",1,0],["ولم يرنَّ دعاءٌ منكَ في أُذُنِ","ولم يدُرِ لكَ ذكرٌ طيِّبٌ بفَم",51,"م",1,0],["وَلَمْ يُرَ يَوْماً راجِياً غَيْرَ سَيْفِهِ","وَلَمْ يُرَ يَوْماً خائِفاً غَيْرَ رَبِّهِ",52,"ب",2,0],["ولم يرد بعد عيني السحب تبكي","ولم أر بعد فيه البرق يضحك",53,"ك",1,0],["ولم يرضهم من بعد عيني سحائبٌ","ولم يصبهم من بعد ثغرك بارقُ",54,"ق",1,0],["وَلَم يُرِدِ الإِلَهَ بِهِ وَلَكِن","أَرادَ بِهِ الطَريقَ إِلى الخِيانَه",55,"ن",2,0],["وَلَمْ يُرَ في مَجلِسٍ شَاعِرانِ","ولا ثَالِثاً ضَمَّهُمْ مَوْضِعُ",56,"ع",1,1],["وَلَم يَرُح مُتَلمِذاً","حَتّى غَذا مُتَلمَذا",57,"ذ",2,0],["وَلَم يَرُح مُتَّعِظاً بِالهَوى","مَن عَن هَواكُم صَدَّهُ وَعَظُ",58,"ظ",1,0],["ولم يُرَ كالعبّاسِ قِدْماً وهاشمٍ","شَبيهانِ مَجْداً في مُلوك بني النّضر",59,"ر",1,0],["ولم يُرَ قبلي غائصٌ رَدَّ دُرَّه","على بَحْرِه خُلْقٌ لَه مُتعَوّد",60,"د",1,0],["ولم يُرَ مَعشرٌ في الناس مُردٌ","سمعتُ بهم ولا صُهبُ السِّبالِ",61,"ل",1,1],["وَلَم يَرُدَّ جَواباً","وَماذَا عَلَيهِ لَو أَجابَ المُتَيَّما",62,"م",2,0],["ولم يرد بابك الأعلى ليخدمه","إِلا وقد رفض الأدنى وأهمله",63,"ل",2,0],["ولم يرجُ بعد النفي والطرد عودةً","وناهيك من نارٍ دهت ذلك المنفي",64,"ف",2,0],["وَلم يُرِد من عَبدِهِ عِنادَه","وَلم يُحِبَّ نيةً فَسادَه",65,"ه",1,0],["وَلم يُرِد في حالَةٍ اِغواءَه","بَل جَلَبَ الاِنسانُ ما قَد ساءَه",65,"ه",1,0],["ولم يُرْجعوا ميراثَ بنتِ محمَّدٍ","وقد يُرجعُ المغضوبَ مَنْ هُو غاصبُهْ",66,"ب",2,0],["ولم يُرَ محزوناً عليه كأنما","دفنتم عدواً فقده غير ضائر",67,"ر",1,0],["ولم يُروِّ سِنانَ السمهرِيِّ دَمُ","ما شُبتُ حُسنَ ظُنوني فيكَ بالتُّهَمِ",68,"م",1,0],["ولم يُرَ مَنْ يُسَدُّ به خِلالٌ","إذا ما أَعْوَزَ الأَمر السدادا",69,"د",2,0],["ولم يرْوِ إلاَّ عنه دام علاؤه","رواية مجد باذخٍ وعلاء",70,"ا",2,0],["ولم يربه ركوب البحر من خطر","لما تنقل بلداناً فبلدانا",71,"ن",2,0],["ولم يُرِحْ نَفْسَهُ سوى يَقِظٍ","أَتعب فيماً يُرِيحُها جَسَده",72,"د",2,0],["ولم يُرَ قبلَهُ بحرٌ خضمٌّ","أفاضَ على معاطِفِه سَرابا",73,"ب",2,0],["ولم يُرسِلْ شفارَ ظُباه إلا","غدَتْ قُلَلُ الملوكِ لها جوابا",73,"ب",2,0],["ولم يرتفع بالناس بل مبدعاً لهم","عوالمَ من خير وحب واحسان",74,"ن",1,0],["ولم يُرشَفْ لنازله","وراءَ المأزمين لمَى",75,"م",2,0],["ولم يُرَ أنوأَ من قبلها","مواطرُ أسماؤها أنملُ",76,"ل",1,0],["ولم يَرْضَ بالعَدْلِ العَميمِ فَزادَهُ","نَوافِلَ منْ معْروفِهِ والفَواضِلِ",77,"ل",1,0],["ولم ير في المطالب من عداء","ولا من موجب للانتقام",78,"م",1,0],["ولم يرُعني طرف البيد مطّرفاً","ولا ثناني طرف الليل منطبقا",79,"ق",2,0],["ولم يُرْضِنا في الحُبِّ شقُّ جُيوبِنا","إذا نحنُ لم تنشَقَّ منّا المَرائِرُ",80,"ر",1,0],["ولم يرض لي معروفه دون جاهه","فسير كتباً كالكتائب في أمري",81,"ر",2,0],["ولم يرفُق بها في الصَّرفِ لكن","عَدوُّ الدِّينِ رِفقُه مُستحيلُ",82,"ل",1,0],["ولم يُرَ قبلك مستخرجاً","من الغِيلِ والأسدُ فيه الشُّبولا",83,"ل",2,0],["ولم يَرُعْنِي وقد راعت صواعقُهُ","وسْط العرينِة أحشاءَ العنابيسِ",84,"س",1,0],["ولم يُرَ فيهمْ والمخاوفُ جمّةٌ","مُوَلٍّ إلى أمنٍ ولا من معرّدِ",85,"د",1,0],["وَلَم يَرتووا إلّا بِما سال بالقنا","كما يرتوي بالماءِ من عطشٍ صَدِ",85,"د",1,0],["وَلَم يُرَ إلّا الهَزْلُ يَنفُقُ عندهمْ","فمن يشتري منِّي إذا بعتُه جِدّي",86,"د",2,0],["ولم يَرْضَوْا سوى التّجري","ر للأذيالِ والسّحبِ",87,"ب",1,0],["ولم يرضَ سهلَ الأمرِ يرطب مسُّه","وَلَم تلْقَهُ إلّا على مركبٍ صَعْبِ",88,"ب",1,0],["ولم يرد بذاك فضل الكلب","لكنه أراد فيما ينبي",89,"ي",1,0],["ولم يروا للجهل ما قد وقعوا","فيه من الأمر الذي قد فزعوا",89,"ع",3,0],["ولم ير الأعداءُ منهم أمرا","يرون في الظاهر فيه ن