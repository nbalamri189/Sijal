ونيَّاتُ نظراتِ الأغنام","https://www.poetsgate.com/ViewPoem.aspx?id=183490",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"تحيا الطفولة والجنون ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183937",""],[5956,"أوقات الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=186120",""],[5956,"طباعي لم تُرض طباع أبي رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=192148",""],[5956,"حتى المَكيف قد أقام حِدادا","https://www.poetsgate.com/ViewPoem.aspx?id=192400",""],[5956,"مَلَكُ الأمانِ شقيقتي (عطّوفُ)","https://www.poetsgate.com/ViewPoem.aspx?id=192471",""],[5956,"رثاء الحماة","https://www.poetsgate.com/ViewPoem.aspx?id=192522",""],[5956,"كل يوم موتُ محبوبٍ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192794",""],[5956,"ما حِلْتُ دون فراقهم برضائي","https://www.poetsgate.com/ViewPoem.aspx?id=193511",""],[5956,"ما عادل بتاتاً","https://www.poetsgate.com/ViewPoem.aspx?id=193523",""],[5956,"قرُبَ الوداعُ","https://www.poetsgate.com/ViewPoem.aspx?id=193570",""],[5956,"الأعوام والإنعامُ","https://www.poetsgate.com/ViewPoem.aspx?id=193812",""],[5956,"أختارُ ماذا أيا غالي سليمانُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=194707",""],[5956,"حارَ حناني","https://www.poetsgate.com/ViewPoem.aspx?id=195020",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[5997,"لَبَّيْكَ حَبِيْبِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214238",""],[4442,"مآذن النجف اهتزت أعاليها","https://www.poetsgate.com/ViewPoem.aspx?id=171229",""],[6102,"كَأَنَّ يَومَ الهَوَانِ عِيدُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=184855",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["بِالرَأيِ تَقبَلُهُ العُقولُ ضَرورَةً","عِندَ النَوائِبِ لا بِكَيفَ وَلالِمِ",0,"م",1,0],["بِالراقِصاتِ عَلى الكَلالِ عَشِيَّةً","تَغشى مَنابِتَ عَرمَضِ الظَهرانِ",1,"ن",1,0],["بالرأي فل السيف واجتمع الهدى","والفضل والإحسان في القرطاس",2,"س",1,0],["بالرّعب طوراً والقواضبِ تارةً","تزْوَرُّ منه نواظرُ الزَّوراء",3,"ا",2,0],["بالرُّغم منَّا مراثٍ بعد مدحك لا","تُسلَى ونحنُ مع الأيَّامِ في صخب",4,"ب",1,0],["بالرُّوح أفدِي سيِّداً خائفاً","عليَّ في قربي وإبعادي",5,"د",2,0],["بالرّغم أن أنشدَ الألفاظ عاطلةً","من حلي مدحك أثناءَ الأناشيد",6,"د",1,0],["بالرعب ينصر قبل السيف مطلعاً","فاعجب لذلك أيضاً سيف مقدور",7,"ر",1,0],["بالرّغم إن قامت مآتم بعده","عندي وفاز سوايَ بالأعراس",8,"س",1,0],["بالرّغم أن يجفو ترابك مبسمي","لكنه غدر الزمان الجافي",9,"ف",2,0],["بالرغم إن باتَ بدر الأفق معتلياً","وبات بدريَ مدفوناً على الطرق",10,"ق",1,0],["بالرغم إن لم أقل يا أصل حرقته","ليهنك اليوم إنَّ القلب مرعاك",11,"ك",1,0],["بالرفا والبنين في خدر بدر","عن قريب يجلو عليك الأهله",12,"ل",2,0],["بالرغم أن يصغى لشكوى اليوم من","حظ تقول به الهموم وتفعل",13,"ل",1,0],["بالروح أفدي وجنتي مالكٍ","كأنَّه من حور رضوان",14,"ن",1,0],["بالروحِ أفدِي أغيداً قد بدا","يخطُّ فوق الخدِّ ريحانه",15,"ن",2,0],["بالرغم مني أن أعدّ هدية","أتقاصها شيء وليس تعدني",16,"ي",1,0],["بالرَّمْلِ بالصَّخْرِ المحطَّمِ","بالجداول بالغديرْ",17,"ر",1,0],["بالرئيس الهمام بالمنقد الأكبر","للشعب في الزمان الوبيل",18,"ل",1,0],["بالرافدين من الشباب عصابة","قد صارعت آلامها آمالها",19,"ل",3,0],["بالرافعي علم الهدى","في جو جامعة العلوم",20,"م",1,0],["بالرغم منى ما تعا","لج في النحاس المقفل",21,"ل",1,0],["بالرِفقِ أبلُغُ ما أهواهُ من أَرَبٍ","وصاحبُ الخُرْقِ محمولٌ على خَطَرِ",22,"ر",1,0],["بِالرَحبَةِ الخَضراءِ ذاتِ المَنهَلِ ال","عَذبِ المَشارِبِ وَالجَنابِ المُعشِبِ",23,"ب",1,0],["بِالرِضى كانَ مِنكَ صَدُّكَ وَالبُع","دُ فَكانَ الفِراقُ بِالرُغمِ مِنّا",24,"ن",2,0],["بالروح باكيةً تق","بلني وقد قَرُبَ التنائي",25,"ي",1,1],["بِالراقِصاتِ كَأَنَّها رَسَلُ القَطا","وَالمُقرَباتِ بِهِنَّ مِثلُ الأَفكَلِ",26,"ل",1,0],["بالرُوح رُدِّي عليها إنّها صِلةٌ","بينَ المحِبينَ ناذا ينفعُ الجَسد",27,"د",1,0],["بالرسولِ الهادي وبالصفوةِ الأم","جادِ يَقضون حقَّه الموفورا",28,"ر",2,0],["بِالراحِ فِي فِيهِ وَالرَّيحانُ عَأرِضُهُ","وَنَرجَسُ اللَّحظِ يَحكِي وَردَةَ ال