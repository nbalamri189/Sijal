"د",3,0],["وَقَد قَلَينا لَكَ سَنبوسَجا","نورِدُ مِنهُ مُضعَفَ الوَردِ",196,"د",1,0],["وَقَد قُلتُ لَما سِيلَ عَمَّا أَنَلتَنِي","لِيَزدادَ رغماً مَن يُحبُّ لِيَ الرَّدَى",197,"د",2,0],["وَقَد قُلتُ مَهلاً آلَ حَزمِ بنِ فَرتَنى","فَفي ظُلمِنا صابٌ مُمِرٌّ وَحَنظَلُ",198,"ل",1,0],["وَقَد قادَت فُؤادِي في هَواها","وَطاعَ لَها الفُؤَادُ وَما عَصاها",199,"ه",2,1],["وقد قام في شأن الحقيقة مرشداً","يعلَّمُ طور المصطفى كلَّ مرشد",200,"د",1,0],["وقد قالَ الرَّسولُ ائْمَنْ جَناباً","فمن بضَمانِ أَحمدَ في ضَمَانِي",201,"ي",1,0],["وَقد قابَلَتنا مِن سَجاياه نفحَة","أنَمُّ مِنَ المِسكِ الفَتيقِ وأَطيَبُ",202,"ب",1,0],["وقد قذفت نفسي أجل حظوظها","لديك وفقد الحظ جزء من الفقد",203,"د",1,0],["وقد قسم الرحمن بينهما البلا","بما فعلا والله أعدل قاسم",204,"م",1,0],["وَقد قَرَعت في ام عمرو لي العَصا","قَديماً كَما كانَت لِذي الحُلم تقرَع",205,"ع",1,0],["وقَدْ قَدَّرَ النَّحْوِيْ وذلِكَ فَنُّهُ","وأَمَّا فُنُوني فَهْيَ عَنْ مِثْلِهِ تَلْوِي",206,"و",2,0],["وقَدْ قالَ سَعْدُ الدِّينِ في الضَّعْفِ إنَّهُ","بِمَنْعٍ لَهُ قالَ الجَماهيرُ في النَّحْوِ",206,"و",1,0],["وَقَدْ قالَ في العافِينَ في قوله ألاَ","تُحِبُّونَ فافْهَمْ سِرَّ هَذا الذي تَتْلو",207,"ل",2,0],["وقد قَصَدتُ قبرَ خَيرِ واسِطَه","بيني وبينكَ وخيرِ رابِطَه",208,"ه",1,0],["وَقد قَضى اللَّهُ أن يزيل لنا","نعمةَ من ليس يشكر النِّعما",209,"م",2,0],["وقد قَطَر الجفاءُ فأوْسَعوه","فَسالَ عليَّ بعد القَطْر سيلا",210,"ل",2,0],["وقد قَلَصَتْ عنّي ذيولُ شبيبتي","وفي الرّأس شيبٌ كالثَّغامةِ شاملُ",211,"ل",1,0],["وَقَد قبستُ جميلاً دونَهم بيَدي","وأيُّ خيرٍ لفضلٍ غير مقبوسِ",212,"س",1,0],["وقد قضيتُ بذاك العذل مَأْرَبَةً","لو كان سمعِيَ عنه غيرَ مسدودِ",213,"د",1,0],["وقد قلتُ لمّا ضقتُ ذَرعاً بخُطّةٍ","شَموسِ القَرَا أين الوزير أبو سعدِ",214,"د",1,0],["وقد قلّدوا الأعناقَ منَّا وأترعوا","بطون الّليالي من لُهاً وأيادِ",215,"د",1,0],["وقد قلّصتْ خَطْوِي الليالي وشمّرتْ","برَوْحاتها من جيئتِي وذهابي",216,"ي",1,0],["وَقَد قَصَدتُ نَدى مَن لا يُوافِقُني","فَكانَ سَهمِيَ عَنهُ الطائِشَ الطافي",217,"ف",2,0],["وَقَد قالَت لِبيضٍ آنِساتٍ","يَصِدن