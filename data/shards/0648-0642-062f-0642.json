عموديه"],[462,"درت أنها شمس الضحى فتجلت","https://www.aldiwan.net/poem3592.html","عموديه"],[462,"غصون الحمى شف المعنى قدودها","https://www.aldiwan.net/poem3618.html","عموديه"],[466,"اليوم يا ذا الفخر والمجد","https://www.aldiwan.net/poem60223.html","السريع"],[468,"وإني لأهواها وأهوى لقاءها","https://www.aldiwan.net/poem4658.html","الطويل"],[468,"لعمري لقد أجرى ابن حزم بن فرتنى","https://www.aldiwan.net/poem4782.html","الطويل"],[468,"وقد قادت فؤادي في هواها","https://www.aldiwan.net/poem4843.html","الوافر"],[498,"يقولون فيمن تقتدون بنهجكم","https://www.aldiwan.net/poem37648.html","الطويل"],[498,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[504,"ويوم تضوع الشمس حليا بحسنه","https://www.aldiwan.net/poem2471.html","الطويل"],[511,"أأيام هذا الدهر كم تعنفين بي","https://www.aldiwan.net/poem67760.html","الطويل"],[513,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[514,"فيا لك من ليل تمتعت طوله","https://www.aldiwan.net/poem48663.html","الطويل"],[527,"نظام يحاكي الدر أهدته نحونا","https://www.aldiwan.net/poem37082.html","الطويل"],[527,"أعد نظرا في محكم الذكر إنه","https://www.aldiwan.net/poem37227.html","الطويل"],[536,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[549,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[549,"ألا يا أحسن الثقلين عبلا","https://www.aldiwan.net/poem47313.html","الوافر"],[549,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[549,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[549,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[549,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[549,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[549,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[551,"أهل الصفاء نأيتم بعد قربكم","https://www.aldiwan.net/poem68285.html","البسيط"],[551,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[556,"إذا كان كلي دائما يشبه البرقا","https://www.aldiwan.net/poem34320.html","الطويل"],[556,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[556,"وجود الشيء شاء يشيء شيئا","https://www.aldiwan.net/poem34603.html","الوافر"],[556,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[560,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[565,"سجاياك من طيب أعراقها","https://www.aldiwan.net/poem69568.html","المتقارب"],[565,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[573,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[573,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[573,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[583,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[585,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[585,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[585,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"]],"verses":[["وَقَد قَطَعَ المَعروفَ بِاللُؤمِ قاطِعٌ","وَباعَ الثَناءَ الحُرَّ بِالذَمِّ بائِعُ",0,"ع",1,0],["وَقَدْ قَايَضَتْهُمْ إِذْ أُتِيحَ بَوارُها","بِشِرْذِمَةٍ يَنْميهمُ شَرُّ والِدِ",1,"د",1,0],["وَقَدْ قَنِعْتُ فَجَأْشِي لا يُقَلْقِلُهُ","بَيْضاءُ كِسْرَى وَلا صَفْراءُ قارونِ",2,"ن",1,0],["وَقَد قُلتُ إِنّي قَد سَلَوتُ عَنِ الهَوى","وَمَن كانَ مِثلي لا يَقولُ وَيَكذِبُ",3,"ب",1,0],["وَقَد قالَ لي أَهلي كَما قالَ أَهلُها","لَها غَيرَ أَنّي لَم أُطِع في الهَوى أَهلي",4,"ي",1,0],["وَقَد قَشَعَت عَني ظَلومُ بِصَدِّها","سَحابَ نَوالٍ بَعدَما كَانَ أَمطَرا",5,"ر",2,0],["وَقَد قَلَبَ الزَمانُ عَلَيَّ يُمناً","وَكانَ إِلى شَفاعَتِها عِمادي",6,"د",2,0],["وَقَد قالَ لي ناسٌ تَحمَّل دَلالَها","فَكُلُّ صَديقٍ سَوفَ يَرضى وَيَغضَبُ",7,"ب",1,0],["وقد قادَ يوْمُ الغيْمِ سُحْباً كأنّها","رِفاقٌ أتتْ تمشي الهُوَيْنى على رِفقِ",8,"ق",1,0],["وقد قلَبَ السّوسانُ فيه رِداءَهُ","كأنّ النُعامَى أبرزَتْهُ ليَسْتَسْقي",8,"ق",2,0],["وَقَد قالَت قُتَيلَةُ إِذ رَأَتني","وَقَد لا تَعدَمُ الحَسناءُ ذاما",9,"م",2,0],["وَقَد قُلنَ بِالبَردِيِّ أَوَّلُ مَشرَبٍ","أَجَلَّ جَيرٍ إِن كانَت سَقَتهُ بَوارِقُهُ",10,"ق",2,0],["وَقَد قابَلَت مِنها ثَرىً مُستَجيزَةً","مَباضِعَ في وَجهِ الضُحى فَثُعالَها",11,"ل",3,0],["وَقَد قَرَعَ الواشونَ فيها لَكَ العَصا","وَإِنَّ العَصا كانَت لِذي الحِلمِ تُقرَعُ",12,"ع",1,0],["وَقَد قَتَلَت نَفسًا بِغيرِ جَريرَةٍ","وَليسَ لها عَقلٌ وَلا مَن يُقيدُها",13,"د",3,0],["وَقَد قَطَعَ الواشونَ ما كانَ بَينَنا","وَنَحنُ إِلى أَن يوصَلَ الحَبلُ أَحوَجُ",14,"ج",1,1],["وَقَد قيلَ ما قَولَةٌ قالَها","فَقُلتُ لَهُم رَوثَةُ راثَها",15,"ث",3,0],["وَقَد قابَلَتهُ عَوكَلاتٌ عَوانِكٌ","رُكامٌ نَفَينَ النَبتَ غَيرَ المآزِرِ",16,"ر",1,0],["وقد قُدْ من بُرد العشيّ جِلالُه","وفي ذيله صبغ من الليل حائلُ",17,"ل",1,0],["وقد قام من حول السرادق موكب","عظيم به اصطفّت أُلوف من الجند",18,"د",1,0],["وقد قيل إن الروح تبقى فهل لها","عروج إلى الأعلى إلى الأنجم الزهر",19,"ر",1,0],["وقد قال بعض القوم إن حياتنا","كليلٍ وإن الفجر مطلعه القبر",20,"ر",1,0],["وَقَد قَطَعَ الحَديدَ فَلا تَماروا","فَرِندٌ لا يُفَلُّ وَلا يَذوبُ",21,"ب",1,0],["وَقَد قَعِسَت ظُهورُهُمُ بِخَيلٍ","تُجاذِبُهُم أَعِنَّتَها جِذابا",22,"ب",2,0],["وَقَد قُرِنوا حينَ جَدَّ الرِهانُ","بِسامٍ إِلى الأَمَدِ الأَبعَدِ",23,"د",1,0],["وَقَد قَوَّسَت أُمُّ البَعيثِ وَأُكرِهَت","عَلى الزِفرِ حَتّى شَنَّجَتها الأَخادِعُ",24,"ع",1,0],["وَقَد قالَ الوُشاةُ فَأَفزَعونا","بِبَعضِ القَولِ نَكرَهُ أَن يُقالا",25,"ل",2,0],["وَقَد قَتَلَ الجَحّافُ أَولادَ نِسوَةٍ","يَسوقُ اِبنُ خَلّاسٍ بِهِنَّ وَعَزهَلُ",26,"ل",1,0],["وَقَد قَلَّصَت عَن مَنزِلٍ غادَرَت بِهِ","مِنَ اللَيلِ جَوناً لَم تُفَرَّج غَياطِلُه",27,"ل",2,0],["وَقَد قَلَّدتُ مِن خِزيِ القَوافي","بَني سَهمٍ عَلى رَغمِ الرِغامِ",28,"م",1,0],["وقد قيل كم من رِشدة في كريهةٍ","ومن غَيّةٍ تُلقَى عليها الشراشر",29,"ر",1,0],["وقد قصدتك كالصادي أُليح له","في مهمهٍ ماءُ مزنٍ صانه رصف",30,"ف",1,0],["وقد قاموا ولا يهجَ","ع من ذاق الذي ذاقوا",31,"ق",3,0],["وقد قلت للأعداءِ لمَّا تظاهروا","عليّ وقد أوعدتهم بصيالكا",32,"ك",2,0],["وقد قُرعت من ذي أناملك العصا","وإن راب ريبٌ بعدها سُلَّ معولُ",33,"ل",1,0],["وقد قصَّرتُ لا عمداً ولكن","بُهرتُ وعزَّني ملك همامُ",34,"م",1,0],["وَقَد قَلِقَت قِلادَةُ كُلِّ غَوجٍ","يُطِفنَ بِهِ كَما قَلِقَ السِوارُ",35,"ر",1,0],["وَقَد قالَت مُدِلَّةُ إِذ قَلَتني","أَراكَ كَبِرتَ وَالصُدغَينِ شابا",36,"ب",2,0],["وَقَد قَسَموا مالي وَأَضحَت حَلائِلي","قَدِ اِستَبدَلَت غَيري بِبَهجَتِها بَعلا",37,"ل",2,0],["وَقَد قَرَّبَ اللَهُ المَسافَةَ بَينَنا","فَها أَنا يَحويني وَإِيّاهُ إيوانُ",38,"ن",1,0],["وَقَد قيلَ إِنَّ الطَيفَ في النَومِ زائِرٌ","فَأَينَ لَطَرفي نَومَةٌ يَستَعيرُها",39,"ر",3,0],["وَقَد قادَني الجيرانُ حيناً وَقُدتُهُم","وَفارَقتُ حَتّى ما تَحِنُّ جِمالِيا",40,"ي",2,0],["وَقَد قِلتُ في حُبّي لَكُم وَصَبابَتي","مَحاسِنَ شِعرٍ ذِكرُهُنَّ يَطولُ",41,"ل",1,0],["وقد قضت الأيام بالبعد بيننا","فطال على الأيام فيما قضت عتبي",42,"ب",2,0],["وقد قلنا بهِ ونفاه بعض","وإن لنا مع النافي جدالا",43,"ل",2,0],["وَقَد قَصَدتُكَ وَالتَرحالُ مُقتَرِبٌ","وَالدارُ شاسِعَةٌ وَالزادُ قَد نَفِدا",44,"د",2,0],["وَقَد قَتَلَ الأَقرانَ حَتّى قَتَلتَهُ","بِأَضعَفِ قِرنٍ في أَذَلِّ مَكانِ",45,"ن",1,0],["وقد قصُرْت أيدي المكارمِ بعدَكُمْ","وكنتمْ لها بُوعاً طِوالاً وأذرُعَا",46,"ع",2,0],["وقد قُرِضَتْ منها جِعادُ لِمَامها","وقامتْ صفوفاً مثلما قُوِّمَ السَّطْرُ",47,"ر",1,0],["وَقَد قالَ داعي الحُبِّ هَل مِن مُجاوِبِ","فَأَقبَلتُ أَسعى قَبلَ كُلِّ مُجاوِبِ",48,"ب",1,0],["وَقَد قَطَعَت عَرضَ الأُرُندِ إِلَيهِمِ","كَتائِبُ تُزجى فَيلَقاً بَعدَ فَيلَقِ",49,"ق",1,0],["وَقَد قُلتُ لِلمُعلي إِلى المَجدِ طَرفَهُ","دَعِ المَجدَ فَالفَتحُ بنُ خاقانَ شاغِلُه",50,"ل",2,0],["وقد قَرِحَتْ على الجُودِ المآقي","وقد شُقَّتْ على الشِّعْرِ الجُيوبُ",51,"ب",1,0],["وَقَد قُلتُما إِن نُدرِكِ السِلمَ واسِعاً","بِمالٍ وَمَعروفٍ مِنَ الأَمرِ نَسلَمِ",52,"م",1,0],["وَقَد قَنِعَت نَفسي بِما قَد رُزِقتُهُ","فَشَأنُكِ يا دُنيا وَأَهلُ الغَوايلِ",53,"ل",1,0],["وقد قِسْتُ أعوامي الَّتي سَلفَت فما","وَفَيْنَ بِيَومٍ مِن لِقائِكَ واحِدِ",54,"د",1,0],["وَقَد قالَ إِمّا أَن أُغادَرَ بَعدَها","عَظيماً وَإِمّا أَن أُغادَرَ أَعظُما",55,"م",2,0],["وَقَد قَرَّبَ المَرمى البَعيدَ رَجاؤُهُ","وَسَهَّلَتِ الأَرضَ العَزازَ كَتائِبُه",56,"ب",2,0],["وَقَد قالَت لِتِربَيها","وَرَجعُ القَولِ يَعنينا",57,"ن",2,0],["وَقَد قُرِعَت في وَصلِ هِندٍ لَكَ العَصا","قَديماً كَما كانَت لِذى الحِلمِ تُقرَعُ",58,"ع",1,0],["وَقَد قُطِعَت أَعناقُهُنَّ صَبابَةً","فَأَنفُسَنا مِمّا يُلاقينَ شُخصُ",59,"ص",1,0],["وَقَد قَلَّدَ النُوّارُ جيداً لِرَبوَةٍ","هُناكَ وَنحراً لِلفَضاءِ رَحيبا",60,"ب",2,0],["وَقَد قيلَ نَصرانِيَّةٌ أُمُّ مالِك","فَقُلتُ ذَروني كُلُّ نَفسٍ وَدينُها",61,"ن",3,0],["وَقَد قَذِيَت عَيني بِلَيلى وَأَتبَعَت","قَذاها وَقَد يَأتي عَلى العَينِ شومُها",62,"م",3,0],["وَقَد قالَت أُمامَةُ هَل تَعَزّى","فَقُلتُ أُمامَ قَد غُلِبَ العَزاءُ",63,"ا",2,0],["وَقَدُّ قائِمَةٍ مِنهُ مُرَكَّبَةٍ","في مَفصَلٍ ضامِرِ الأَعصابِ ظَمآنِ",64,"ن",1,0],["وَقَد قَيَّدوا غَيرَ الفَقيهِ بِأَمرِهِ","وَمَن يَلقَ ما لاقى مِنَ الناسِ يَعلَمِ",65,"م",1,0],["وَقَد قَدَّرَ أَن يَصرُ","خَ لَكِن ما بِهِ طَرقُ",66,"ق",1,0],["وَقد قيلَ كتابُ النَّصارَى مَناسِرٌ","فما مِثْلُ كتَّابِ المَحَلَّةِ مَنْسَرُ",67,"ر",1,0],["وقد قلتُ للعارض المكفَهِرِّ","أفي السِّلم ذا البرقُ أم في الوغى",68,"ا",1,0],["وَقَد قاسَيتُ مِن حُبَّي","هِ أَمراً لَيسَ بِاللَعبِ",69,"ب",1,0],["وَقَد قَرَأتُ كِتاباً مِن صَحائِفِكُم","لا يَرحَمُ اللَهُ إِلّا راحِمَ الناسِ",70,"س",1,0],["وَقَد قُلتُ ما قَوّى الرَجاءَ سَماعُهُ","وَآمَنَ باغي النُجحِ مِن خَيبَةِ المُكدي",71,"ي",1,0],["وَقَد قُلتُ لَها جودي","بِوَعدٍ مِنكِ أَو نَظرَه",72,"ر",2,0],["وَقَد قُلتُ تَأديباً لَهُ وَصَبابَةً","إِلَيها وَمِن دونِ اللِقاءِ وَعيدُ",73,"د",1,0],["وَقَد قالَت لَنا جارِ","يَةٌ تَعرِفُ في الصَوتِ",74,"ت",1,0],["وَقَد قامَت وَليدَتُها تُغَنّي","عَشِيَّةَ جاءَها أَنّي اِشتَكَيتُ",75,"ت",1,0],["وَقَد قَرَعتُ القَرينا إِذ قَرَعتُ لَهُ","بِالعَنكَبوتِ وَكانَ الحوبُ بِالحوبِ",76,"ب",1,0],["وَقَد قُلتُ لَها سِرّاً","وَإِعلاناً لَدى صَحبي",77,"ي",1,0],["وَقَد قامَت عَلى أُمٍ وَأُختٍ","شُهودٌ حينَ لَقّاها الزِناءُ",78,"ا",2,0],["وَقَد قر حتى قلت قد جمد الدُجى","وَخلت بياض الصبح لَيسَ يَسيل",79,"ل",1,0],["وقد قرَّبتْ فمَها من فمي","كشِقَّينِ من قبَسٍ مُسْتَعِرْ",80,"ر",1,0],["وَقَدْ قَشَعَتْ أَعْدَاؤُهُمْ عَنْ دِيَارِهِمْ","ورَدَّتْ إِلى الأَحْرَارِ فِي الْوَطَنِ الْحُرِّ",81,"ر",1,0],["وَقَد قاسَ قَومٌ جُودَ يُمناهُ بِالحَيا","وَقَد غَلِطوا يُمناهُ أَسخى وَأَسمَحُ",82,"ح",1,0],["وقد قال لي: ماذا تُعدُّ لما ترى","فقيهٌ إذا ما قال غيرُ مُفنَّد",83,"د",1,0],["وقد قال ابنُ إدريس مقالاً","صحيح النقل في حكم لطيفَه",84,"ف",2,0],["وقد قَدِمَتُ وما قدَّمْتُ لي عَمَلاً","إلاَّ غَرَامِي وأَشْوَاقي وإقدامي",85,"ي",1,0],["وقد قاد يوم الغيم سحبا كأنها","رقاق أتت تمشي الهوينا على رفق",86,"ق",1,0],["وقد قلب السوسان فيها رداءه","كأن النعامى أبرزته ليستسق",86,"ق",1,0],["وقد قعد المختار في الحفل منصتا","له وحبا كعبا عليه وحسانا",87,"ن",2,0],["وقد قالت أمامة ُ هل تعزّى","فقلتُ أُمَيْمُ قد غُلِبَ العَزاء",88,"ا",2,0],["وقد قمتْ على التشريعِ سوقٌ","بها احتشدتْ عبيدٌ أو إماء",89,"ا",2,0],["وَقَدْ قُلْتُمَا إِنْ نُدْرِكِ السِّلْمَ وَاسِعاً","بِمَالٍ وَمَعْرُوفٍ مِنَ القَوْلِ نَسْلَمِ",90,"م",1,0],["وقد قَذِيَتْ عَيْنِي بِلَيْلَى وأتْبَعَتْ","قذاعاًوقد يأتي على العين شومها",91,"م",3,0],["وقد قطعت حتى الرسائل بيننا","ولم تقطع الاحزان واصل لهفتي",92,"ي",1,0],["وقد قطعوا الأيام للَه بالصفا","فما استطولوا عاماً ولا استقصروا شهرا",93,"ر",2,0],["وقد قوبلت من رهط الأعادي","وأهل الحق بالعجب العجيب",94,"ب",1,0],["وقد قصدناه وهو الغوث للدنف ال","مسكين والغي إن تظمأ نواحينا",95,"ن",2,0],["وقد قضى اللّه في صنعا بأقضية","يقضي العجائب منها كلّ مكياس",96,"س",1,0],["وقدَّ قُوَى صدرِي بقامةِ قدِّه","وأردفَ أكبادي برمح نُهودِه",97,"د",2,0],["وقد قاربتَ حَدَّ الفصلِ","بينَ العَوجِ والمَثنى",98,"ن",2,0],["وَقَد قَتَلتُ بِهِ عَبساً وَإِخوَتَها","حَتّى شُفيتُ وَهَل قَلبي بِهِ شافي",99,"ي",1,0],["وقد قيض الله حَبرَا لَهُ","يُدَافِع عن هَفوِه إِن هَفَا",100,"ف",2,0],["وقَد قَادَ لِلصَّبرِ إِسلاَمُنَا","وقَاد لِنهجِ الرِّضَا بِالقَضَا",101,"ض",2,0],["وقد قَضَت باتِّبَاعِ الجَاهِلينَ لِمَن","يَدرُونَ في دِينِ طَه سيِّدِ البَشَرِ",102,"ر",1,0],["وقد قدَّرتْ كفُّ الصَّناعِ التئامَها","كتقدير دوادَ المساميرَ في السَّردِ",103,"د",1,0],["وقد قلتما لي ليس في الأرض جَنّةٌ","أما هذه فوق الركائب حُورُها",104,"ر",3,0],["وَقَد قَرَنتَ بِها بِالأَمسِ لُؤلُؤَةً","بِحارُها مُقفِراتُ البيدِ وَالحِلَلُ",105,"ل",1,0],["وَقَد قابَلَ البَحرَ سَيفُ الإِمامِ","بِبَحرِ رَدىً مَوجُهُ مُرتَطِم",106,"م",1,0],["وَقَد قَلَّدَتهُ الأَمرَ في الدينِ وَالدُنا","وَكانَ أَميناً بِالمَغيبِ عَلَيهِما",107,"م",2,0],["وَقَد قالَتِ السَبعونَ لِلَهوِ وَالهَوى","دَعا لي أَسيري وَاِذهَبا حَيثُ شِئتُما",108,"م",2,0],["وقد قيل يبقى الود ما العتب باقياً","فللّه ما أحلى مقال ذوي اللب",109,"ب",1,0],["وقد قيل لا يأبى الكرامة غير من","له عرق لؤم لم يزل في الخنا يسري",110,"ر",2,0],["وقد قدمت ماسرها من صنيعها","وقد أخرت ماسرني من ثنائها",111,"ا",3,0],["وقد قرأوا الا يؤول ظاهر","من الكفر بل يقضي به ويتوب",112,"ب",1,0],["وقد قلاه المسلمون كلهم","وكلهم ناءٍ عن اقترابه",113,"ب",2,0],["وَقَد قَرَّبُوا لِلبَينِ كُلَّ هَمَرجَلٍ","أَمُونِ القَرى ضَخمِ العَثانين تامِكِ",114,"ك",1,0],["وَقَد قَلِقَت مِنّي الحَشا وَتَتابَعَت","ظَواهِرُ أَنفاسٍ وَأُخرى دَواخِلُ",115,"ل",1,0],["وقَدْ قَتَلَتْهُ الْعِدا غرَّةً","وَما صادَفَتْ مِنْهُ عَبَداً عَتِيداً",116,"د",2,0],["وَقَد قُلتُ يَوماً لاِبنِ عَمروٍ وَقَد عَلَت","فُوَيقَ التَّراقِى أَنفُسٌ وقُلُوبُ",117,"ب",1,0],["وقد قَصدتُك والدنيا ومَن جَمَعتْ","كلٌّ يُسدِّد رأيي بل يُصوِّبه",118,"ب",2,0],["وقد قابلتْ وردا جَنِيا كأنه","مَطَارفُ خَزٍّ فيه قانٍ ووارِس",119,"س",1,0],["وقد قال فيما مضى شاعر","رأى الحق في الحزم فاستعمله",120,"ل",2,0],["وقد قل الوفا في النا","س فالآداب مسقوطه",121,"ط",2,0],["وقد قال قوم هوّن الأمر ربما","لقد هان ما قد كان ب