{"poems":[[53,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[63,"سقى الله رملي كوفن صيب الحيا","https://www.aldiwan.net/poem45877.html","الطويل"],[63,"شفافة من غنى في الأمن مجزية","https://www.aldiwan.net/poem46109.html","البسيط"],[3,"سلا القلب عما كان يهوى","https://www.aldiwan.net/poem128.html",""],[55,"يقولون لي واصل سواها لعلها","https://www.aldiwan.net/poem26186.html","الطويل"],[55,"لعمري لئن أقررتم العين بالذي","https://www.aldiwan.net/poem26342.html","الطويل"],[55,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[55,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[24,"نفى شعر الرأس القديم حوالقه","https://www.aldiwan.net/poem21873.html","الطويل"],[35,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[35,"إلى الله أشكو لا إلى الناس حبها","https://www.aldiwan.net/poem39136.html","الطويل"],[35,"لقد هجرت سعدى وطال صدودها","https://www.aldiwan.net/poem39162.html","الطويل"],[54,"وقد قطع الواشون ما كان بيننا","https://www.aldiwan.net/poem27356.html","الطويل"],[54,"أتيت ابن عمرو فصادفته","https://www.aldiwan.net/poem27410.html","المتقارب"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[88,"لقد بت مطروف النواظر بالسهد","https://www.aldiwan.net/poem45057.html","الطويل"],[88,"متى تطلق الأيام حرية الفكر","https://www.aldiwan.net/poem45065.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[27,"أتطرب حين لاح بك المشيب","https://www.aldiwan.net/poem5666.html","الوافر"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[27,"زار الفرزدق أهل الحجاز","https://www.aldiwan.net/poem5718.html","المتقارب"],[27,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[27,"أجد اليوم جيرتك ارتحالا","https://www.aldiwan.net/poem5947.html","الوافر"],[27,"أجدك لا يصحو الفؤاد المعلل","https://www.aldiwan.net/poem5970.html","الطويل"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[23,"لقد علمت بنو النجار أني","https://www.aldiwan.net/poem21525.html","الوافر"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[51,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[51,"إلى الزهاد في الدنيا","https://www.aldiwan.net/poem65507.html","الهزج"],[51,"أعوذ بحقويك العزيزين أن أرى","https://www.aldiwan.net/poem65771.html","الطويل"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[29,"أعاذل ما عليك بأن تريني","https://www.aldiwan.net/poem6049.html","الوافر"],[29,"ألم تعرض فتسأل آل لهو","https://www.aldiwan.net/poem6055.html","الوافر"],[29,"أعاذلتي اليوم ويحكما مهلا","https://www.aldiwan.net/poem6068.html","الطويل"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[38,"ظعنت وودعت الخليط اليمانيا","https://www.aldiwan.net/poem7822.html","الطويل"],[32,"ألا هل إلى إلمامة أن ألمها","https://www.aldiwan.net/poem27810.html","الطويل"],[89,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[89,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[43,"محمد بن زريق ما نرى أحدا","https://www.aldiwan.net/poem9537.html","البسيط"],[43,"عدوك مذموم بكل لسان","https://www.aldiwan.net/poem10593.html","الطويل"],[62,"أتاني والأخبار سقم وصحة","https://www.aldiwan.net/poem52355.html","الطويل"],[62,"وحول ميادين الرياض تراصفت","https://www.aldiwan.net/poem52396.html","الطويل"],[45,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem11438.html","الطويل"],[45,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[45,"هب الدار ردت رجع ما أنت قائله","https://www.aldiwan.net/poem65535.html","الطويل"],[61,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[58,"لقد خاب من غرته دنيا دنية","https://www.aldiwan.net/poem30889.html","الطويل"],[80,"ومنغمس في صبغة الليل يمتطي","https://www.aldiwan.net/poem31488.html","الطويل"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[44,"أهن عوادي يوسف وصواحبه","https://www.aldiwan.net/poem30578.html","الطويل"],[31,"ألا حي التي قامت","https://www.aldiwan.net/poem41300.html","الهزج"],[31,"يا قلب أخبرني وفي النأي راحة","https://www.aldiwan.net/poem42246.html","الطويل"],[31,"خليلي ما بال المطايا كأنما","https://www.aldiwan.net/poem42474.html","الطويل"],[74,"تخيرته من رهط أعوج سابحا","https://www.aldiwan.net/poem12845.html","الطويل"],[33,"يقولون ليلى بالمغيب أمينة","https://www.aldiwan.net/poem25785.html","الطويل"],[33,"أيا جبلي نعمان بالله خليا","https://www.aldiwan.net/poem25811.html","الطويل"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[52,"ألا تسألون الله برء متيم","https://www.aldiwan.net/poem26700.html","الطويل"],[52,"أيا من مات من شوق","https://www.aldiwan.net/poem26802.html","الهزج"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"لقد أصبحت ذا كرب","https://www.aldiwan.net/poem10810.html","الهزج"],[48,"إني عشقت وهل في العشق من باس","https://www.aldiwan.net/poem63440.html","البسيط"],[48,"أبا جعفر لازلت مشترك الرفد","https://www.aldiwan.net/poem63482.html","الوافر"],[50,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[50,"يعيش بجد عاجز وجليد","https://www.aldiwan.net/poem63956.html","الطويل"],[50,"ألا ياكاهن المصر","https://www.aldiwan.net/poem64746.html","الهزج"],[50,"أعاذل قد نهيت فما انتهيت","https://www.aldiwan.net/poem64749.html","الوافر"],[50,"يا صاح لا تجر في لومي وتأنيبي","https://www.aldiwan.net/poem64829.html","البسيط"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[50,"أفرخ الزنج طال بك البلاء","https://www.aldiwan.net/poem64886.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54888","الطويل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/178136","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117011","الوافر"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[77,"نديمي عللني بمشمولة واسق","https://www.poetsgate.com/ViewPoem.aspx?id=34194",""],[77,"أمولاي إن الشعر ديوان حكمة","https://www.poetsgate.com/ViewPoem.aspx?id=34161",""],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","https://www.poetsgate.com/ViewPoem.aspx?id=18932",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""],[33,"أيا جبلى نعمان بالله خليا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14171&r=&rc=105",""]],"verses":[["وَقَد قَطَعَ المَعروفَ بِاللُؤمِ قاطِعٌ","وَباعَ الثَناءَ الحُرَّ بِالذَمِّ بائِعُ",0,"ع",1,0],["وَقَدْ قَايَضَتْهُمْ إِذْ أُتِيحَ بَوارُها","بِشِرْذِمَةٍ يَنْميهمُ شَرُّ والِدِ",1,"د",1,0],["وَقَدْ قَنِعْتُ فَجَأْشِي لا يُقَلْقِلُهُ","بَيْضاءُ كِسْرَى وَلا صَفْراءُ قارونِ",2,"ن",1,0],["وَقَد قُلتُ إِنّي قَد سَلَوتُ عَنِ الهَوى","وَمَن كانَ مِثلي لا يَقولُ وَيَكذِبُ",3,"ب",1,0],["وَقَد قالَ لي أَهلي كَما قالَ أَهلُها","لَها غَيرَ أَنّي لَم أُطِع في الهَوى أَهلي",4,"ي",1,0],["وَقَد قَشَعَت عَني ظَلومُ بِصَدِّها","سَحابَ نَوالٍ بَعدَما كَانَ أَمطَرا",5,"ر",2,0],["وَقَد قَلَبَ الزَمانُ عَلَيَّ يُمناً","وَكانَ إِلى شَفاعَتِها عِمادي",6,"د",2,0],["وَقَد قالَ لي ناسٌ تَحمَّل دَلالَها","فَكُلُّ صَديقٍ سَوفَ يَرضى وَيَغضَبُ",7,"ب",1,0],["وقد قادَ يوْمُ الغيْمِ سُحْباً كأنّها","رِفاقٌ أتتْ تمشي الهُوَيْنى على رِفقِ",8,"ق",1,0],["وقد قلَبَ السّوسانُ فيه رِداءَهُ","كأنّ النُعامَى أبرزَتْهُ ليَسْتَسْقي",8,"ق",2,0],["وَقَد قالَت قُتَيلَةُ إِذ رَأَتني","وَقَد لا تَعدَمُ الحَسناءُ ذاما",9,"م",2,0],["وَقَد قُلنَ بِالبَردِيِّ أَوَّلُ مَشرَبٍ","أَجَلَّ جَيرٍ إِن كانَت سَقَتهُ بَوارِقُهُ",10,"ق",2,0],["وَقَد قابَلَت مِنها ثَرىً مُستَجيزَةً","مَباضِعَ في وَجهِ الضُحى فَثُعالَها",11,"ل",3,0],["وَقَد قَرَعَ الواشونَ فيها لَكَ العَصا","وَإِنَّ العَصا كانَت لِذي الحِلمِ تُقرَعُ",12,"ع",1,0],["وَقَد قَتَلَت نَفسًا بِغيرِ جَريرَةٍ","وَليسَ لها عَقلٌ وَلا مَن يُقيدُها",13,"د",3,0],["وَقَد قَطَعَ الواشونَ ما كانَ بَينَنا","وَنَحنُ إِلى أَن يوصَلَ الحَبلُ أَحوَجُ",14,"ج",1,1],["وَقَد قيلَ ما قَولَةٌ قالَها","فَقُلتُ لَهُم رَوثَةُ راثَها",15,"ث",3,0],["وَقَد قابَلَتهُ عَوكَلاتٌ عَوانِكٌ","رُكامٌ نَفَينَ النَبتَ غَيرَ المآزِرِ",16,"ر",1,0],["وقد قُدْ من بُرد العشيّ جِلالُه","وفي ذيله صبغ من الليل حائلُ",17,"ل",1,0],["وقد قام من حول السرادق موكب","عظيم به اصطفّت أُلوف من الجند",18,"د",1,0],["وقد قيل إن الروح تبقى فهل لها","عروج إلى الأعلى إلى الأنجم الزهر",19,"ر",1,0],["وقد قال بعض القوم إن حياتنا","كليلٍ وإن الفجر مطلعه القبر",20,"ر",1,0],["وَقَد قَطَعَ الحَديدَ فَلا تَماروا","فَرِندٌ لا يُفَلُّ وَلا يَذوبُ",21,"ب",1,0],["وَقَد قَعِسَت ظُهورُهُمُ بِخَيلٍ","تُجاذِبُهُم أَعِنَّتَها جِذابا",22,"ب",2,0],["وَقَد قُرِنوا حينَ جَدَّ الرِهانُ","بِسامٍ إِلى الأَمَدِ الأَبعَدِ",23,"د",1,0],["وَقَد قَوَّسَت أُمُّ البَعيثِ وَأُكرِهَت","عَلى الزِفرِ حَتّى شَنَّجَتها الأَخادِعُ",24,"ع",1,0],["وَقَد قالَ الوُشاةُ فَأَفزَعونا","بِبَعضِ القَولِ نَكرَهُ أَن يُقالا",25,"ل",2,0],["وَقَد قَتَلَ الجَحّافُ أَولادَ نِسوَةٍ","يَسوقُ اِبنُ خَلّاسٍ بِهِنَّ وَعَزهَلُ",26,"ل",1,0],["وَقَد قَلَّصَت عَن مَنزِلٍ غادَرَت بِهِ","مِنَ اللَيلِ جَوناً لَم تُفَرَّج غَياطِلُه",27,"ل",2,0],["وَقَد قَلَّدتُ مِن خِزيِ القَوافي","بَني سَهمٍ عَلى رَغمِ الرِغامِ",28,"م",1,0],["وقد قيل كم من رِشدة في كريهةٍ","ومن غَيّةٍ تُلقَى عليها الشراشر",29,"ر",1,0],["وقد قصدتك كالصادي أُليح له","في مهمهٍ ماءُ مزنٍ صانه رصف",30,"ف",1,0],["وقد قاموا ولا يهجَ","ع من ذاق الذي ذاقوا",31,"ق",3,0],["وقد قلت للأعداءِ لمَّا تظاهروا","عليّ وقد أوعدتهم بصيالكا",32,"ك",2,0],["وقد قُرعت من ذي أناملك العصا","وإن راب ريبٌ بعدها سُلَّ معولُ",33,"ل",1,0],["وقد قصَّرتُ لا عمداً ولكن","بُهرتُ وعزَّني ملك همامُ",34,"م",1,0],["وَقَد قَلِقَت قِلادَةُ كُلِّ غَوجٍ","يُطِفنَ بِهِ كَما قَلِقَ السِوارُ",35,"ر",1,0],["وَقَد قالَت مُدِلَّةُ إِذ قَلَتني","أَراكَ كَبِرتَ وَالصُدغَينِ شابا",36,"ب",2,0],["وَقَد قَسَموا مالي وَأَضحَت حَلائِلي","قَدِ اِستَبدَلَت غَيري بِبَهجَتِها بَعلا",37,"ل",2,0],["وَقَد قَرَّبَ اللَهُ المَسافَةَ بَينَنا","فَها أَنا يَحويني وَإِيّاهُ إيوانُ",38,"ن",1,0],["وَقَد قيلَ إِنَّ الطَيفَ في النَومِ زائِرٌ","فَأَينَ لَطَرفي نَومَةٌ يَستَعيرُها",39,"ر",3,0],["وَقَد قادَني الجيرانُ حيناً وَقُدتُهُم","وَفارَقتُ حَتّى ما تَحِنُّ جِمالِيا",40,"ي",2,0],["وَقَد قِلتُ في حُبّي لَكُم وَصَبابَتي","مَحاسِنَ شِعرٍ ذِكرُهُنَّ يَطولُ",41,"ل",1,0],["وقد قضت الأيام بالبعد بيننا","فطال على الأيام فيما قضت عتبي",42,"ب",2,0],["وقد قلنا بهِ ونفاه بعض","وإن لنا مع النافي جدالا",43,"ل",2,0],["وَقَد قَصَدتُكَ وَالتَرحالُ مُقتَرِبٌ","وَالدارُ شاسِعَةٌ وَالزادُ قَد نَفِدا",44,"د",2,0],["وَقَد قَتَلَ الأَقرانَ حَتّى قَتَلتَهُ","بِأَضعَفِ قِرنٍ في أَذَلِّ مَكانِ",45,"ن",1,0],["وقد قصُرْت أيدي المكارمِ بعدَكُمْ","وكنتمْ لها بُوعاً طِوالاً وأذرُعَا",46,"ع",2,0],["وقد قُرِضَتْ منها جِعادُ لِمَامها","وقامتْ صفوفاً مثلما قُوِّمَ السَّطْرُ",47,"ر",1,0],["وَقَد قالَ داعي الحُبِّ هَل مِن مُجاوِبِ","فَأَقبَلتُ أَسعى قَبلَ كُلِّ مُجاوِبِ",48,"ب",1,0],["وَقَد قَطَعَت عَرضَ الأُرُندِ إِلَيهِمِ","كَتائِبُ تُزجى فَيلَقاً بَعدَ فَيلَقِ",49,"ق",1,0],["وَقَد قُلتُ لِلمُعلي إِلى المَجدِ طَرفَهُ","دَعِ المَجدَ فَالفَتحُ بنُ خاقانَ شاغِلُه",50,"ل",2,0],["وقد قَرِحَتْ على الجُودِ المآقي","وقد شُقَّتْ على الشِّعْرِ الجُيوبُ",51,"ب",1,0],["وَقَد قُلتُما إِن نُدرِكِ السِلمَ واسِعاً","بِمالٍ وَمَعروفٍ مِنَ الأَمرِ نَسلَمِ",52,"م",1,0],["وَقَد قَنِعَت نَفسي بِما قَد رُزِقتُهُ","فَشَأنُكِ يا دُنيا وَأَهلُ الغَوايلِ",53,"ل",1,0],["وقد قِسْتُ أعوامي الَّتي سَلفَت فما","وَفَيْنَ بِيَومٍ مِن لِقائِكَ واحِدِ",54,"د",1,0],["وَقَد قالَ إِمّا أَن أُغادَرَ بَعدَها","عَظيماً وَإِمّا أَن أُغادَرَ أَعظُما",55,"م",2,0],["وَقَد قَرَّبَ المَرمى البَعيدَ رَجاؤُهُ","وَسَهَّلَتِ الأَرضَ العَزازَ كَتائِبُه",56,"ب",2,0],["وَقَد قالَت لِتِربَيها","وَرَجعُ القَولِ يَعنينا",57,"ن",2,0],["وَقَد قُرِعَت في وَصلِ هِندٍ لَكَ العَصا","قَديماً كَما كانَت لِذى الحِلمِ تُقرَعُ",58,"ع",1,0],["وَقَد قُطِعَت أَعناقُهُنَّ صَبابَةً","فَأَنفُسَنا مِمّا يُلاقينَ شُخصُ",59,"ص",1,0],["وَقَد قَلَّدَ النُوّارُ جيداً لِرَبوَةٍ","هُناكَ وَنحراً لِلفَضاءِ رَحيبا",60,"ب",2,0],["وَقَد قيلَ نَصرانِيَّةٌ أُمُّ مالِك","فَقُلتُ ذَروني كُلُّ نَفسٍ وَدينُها",61,"ن",3,0],["وَقَد قَذِيَت عَيني بِلَيلى وَأَتبَعَت","قَذاها وَقَد يَأتي عَلى العَينِ شومُها",62,"م",3,0],["وَقَد قالَت أُمامَةُ هَل تَعَزّى","فَقُلتُ أُمامَ قَد غُلِبَ العَزاءُ",63,"ا",2,0],["وَقَدُّ قائِمَةٍ مِنهُ مُرَكَّبَةٍ","في مَفصَلٍ ضامِرِ الأَعصابِ ظَمآنِ",64,"ن",1,0],["وَقَد قَيَّدوا غَيرَ الفَقيهِ بِأَمرِهِ","وَمَن يَلقَ ما لاقى مِنَ الناسِ يَعلَمِ",65,"م",1,0],["وَقَد قَدَّرَ أَن يَصرُ","خَ لَكِن ما بِهِ طَرقُ",66,"ق",1,0],["وَقد قيلَ كتابُ النَّصارَى مَناسِرٌ","فما مِثْلُ كتَّابِ المَحَلَّةِ مَنْسَرُ",67,"ر",1,0],["وقد قلتُ للعارض المكفَهِرِّ","أفي السِّلم ذا البرقُ أم في الوغى",68,"ا",1,0],["وَقَد قاسَيتُ مِن حُبَّي","هِ أَمراً لَيسَ بِاللَعبِ",69,"ب",1,0],["وَقَد قَرَأتُ كِتاباً مِن صَحائِفِكُم","لا يَرحَمُ اللَهُ إِلّا راحِمَ الناسِ",70,"س",1,0],["وَقَد قُلتُ ما قَوّى الرَجاءَ سَماعُهُ","وَآمَنَ باغي النُجحِ مِن خَيبَةِ المُكدي",71,"ي",1,0],["وَقَد قُلتُ لَها جودي","بِوَعدٍ مِنكِ أَو نَظرَه",72,"ر",2,0],["وَقَد قُلتُ تَأديباً لَهُ وَصَبابَةً","إِلَيها وَمِن دونِ اللِقاءِ وَعيدُ",73,"د",1,0],["وَقَد قالَت لَنا جارِ","يَةٌ تَعرِفُ في الصَوتِ",74,"ت",1,0],["وَقَد قامَت وَليدَتُها تُغَنّي","عَشِيَّةَ جاءَها أَنّي اِشتَكَيتُ",75,"ت",1,0],["وَقَد قَرَعتُ القَرينا إِذ قَرَعتُ لَهُ","بِالعَنكَبوتِ وَكانَ الحوبُ بِالحوبِ",76,"ب",1,0],["وَقَد قُلتُ لَها سِرّاً","وَإِعلاناً لَدى صَحبي",77,"ي",1,0],["وَقَد قامَت عَلى أُمٍ وَأُختٍ","شُهودٌ حينَ لَقّاها الزِناءُ",78,"ا",2,0],["وَقَد قر حتى قلت قد جمد الدُجى","وَخلت بياض الصبح لَيسَ يَسيل",79,"ل",1,0],["وقد قرَّبتْ فمَها من فمي","كشِقَّينِ من قبَسٍ مُسْتَعِرْ",80,"ر",1,0],["وَقَدْ قَشَعَتْ أَعْدَاؤُهُمْ عَنْ دِيَارِهِمْ","ورَدَّتْ إِلى الأَحْرَارِ فِي الْوَطَنِ الْحُرِّ",81,"ر",1,0],["وَقَد قاسَ قَومٌ جُودَ يُمناهُ بِالحَيا","وَقَد غَلِطوا يُمناهُ أَسخى وَأَسمَحُ",82,"ح",1,0],["وقد قال لي: ماذا تُعدُّ لما ترى","فقيهٌ إذا ما قال غيرُ مُفنَّد",83,"د",1,0],["وقد قال ابنُ إدريس مقالاً","صحيح النقل في حكم لطيفَه",84,"ف",2,0],["وقد قَدِمَتُ وما قدَّمْتُ لي عَمَلاً","إلاَّ غَرَامِي وأَشْوَاقي وإقدامي",85,"ي",1,0],["وقد قاد يوم الغيم سحبا كأنها","رقاق أتت تمشي الهوينا على رفق",86,"ق",1,0],["وقد قلب السوسان فيها رداءه","كأن النعامى أبرزته ليستسق",86,"ق",1,0],["وقد قعد المختار في الحفل منصتا","له وحبا كعبا عليه وحسانا",87,"ن",2,0],["وقد قالت أمامة ُ هل تعزّى","فقلتُ أُمَيْمُ قد غُلِبَ العَزاء",88,"ا",2,0],["وقد قمتْ على التشريعِ سوقٌ","بها احتشدتْ عبيدٌ أو إماء",89,"ا",2,0],["وَقَدْ قُلْتُمَا إِنْ نُدْرِكِ السِّلْمَ وَاسِعاً","بِمَالٍ وَمَعْرُوفٍ مِنَ القَوْلِ نَسْلَمِ",90,"م",1,0],["وقد قَذِيَتْ عَيْنِي بِلَيْلَى وأتْبَعَتْ","قذاعاًوقد يأتي على العين شومها",91,"م",3,0]]}