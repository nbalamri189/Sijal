,0],["وقد قرن المحمود اسم محمد","مع اسمه والذكر فاعزز برفعة",147,"ه",1,0],["وقد قعدت بي الناهضات من القوى","ومن غيرها فاسمع لك الخير ما أبدى",148,"د",2,0],["وقد قيل في هذا وخط كتابه","بيان شفاء للنفوس السقيمة",149,"ه",1,0],["وقد قال قوم من اولى العلم لارضاً","بفعل المعاصي والذنوب الكبيرة",149,"ه",1,0],["وَقَد قُلتُ لِلنَفسِ اللَجوجِ نَصيحَةً","مَقالَ شَفيقٍ لَو تَعيهِ ضَميرُها",150,"ر",3,0],["وَقَد قِيلَ سَعْدُ الدّينِ وَافَقَ مَوتَهُ","فَقلْتُ وَسَعْدٌ كُلُّها والقَبائِلُ",151,"ل",1,0],["وقد قادَهُ اللهُ قَوْدَ الحِصانِ","إلى مَلِكٍ مُلْكُه ذو عِظَم",152,"م",1,0],["وقد قُلتُ لمّا عارضَتْ عُقَدَ الِلّوَى","وهَبّتْ معَ الحادي بغَوْريِّ سِقْطها",153,"ط",3,0],["وَقَد قَسَمَ اللَهُ القِطارَ عَلى الثَرى","وَما لِثَراها قَطُّ قِسمٌ مِنَ القَطرِ",154,"ر",1,0],["وقَد قَضَت وطَراً منا المنونُ فَهَل","يُقضى لَنا مِن تَباريحِ الجَوى وَطَرُ",155,"ر",1,0],["وقد قامَ النبيُّ بهم خطيباً","فدلَّ المؤمنينَ على الأميرِ",156,"ر",1,0],["وقد قدَّس الأمواهَ يومَ وروده","فصار بها للناس أحسنُ مورد",157,"د",1,0],["وقد قال ماني جسمه كان ظاهراً","خيالاً وما قد ذاق طعم المنية",158,"ه",1,0],["وَقَد قَتلوا بِهِ مِنّا غُلاماً","كَريماً لَم تُؤَشِّبهُ العُروقُ",159,"ق",1,0],["وقد قال حداد القلوب يحثنا","على العلم فاسمع قول بيت من الشعر",160,"ر",1,0],["وقد قال يوصينا عليكم بسنتي","وسنة من يأتي من الخلفاء بعدي",161,"د",2,0],["وقد قاموا شعثاً وغبراً ليكرموا","فإن انكسار القلب يعقب سلوانا",162,"ن",2,0],["وقد قصرت عنه العبارات إنما","يقال كهذا أو كذا أو لعلما",163,"م",2,0],["وقد قتل المختار فيها بنفسه","أُبيا بأحد حين أردى به الكفر",164,"ر",1,0],["وقد قال خير المرسلين نهيت عن","فما باله لم ينته الرجل النجدي",165,"ي",1,0],["وقد قلت في المختار أجمع كل من","حوى عصره من تابعي وذي الرشد",165,"د",1,0],["وقد قلت في الأبيات ما أنت عارف","له من دليل في الذي قلته عندي",166,"ي",1,0],["وقد قال هذا قبلهم كل مشرك","فهل قد حوى هذي العقيدة من رند",167,"د",1,0],["وقد قال سبحانه للعباد","سلوني فإني سميع مجيب",168,"ب",1,0],["وقَد قِيلَ في اليأسِ الشّفاءُ مِن الهوى","ودَائي الّذي أَقضي بهِ اليأسُ من نَجدِ",169,"د",1,0],["