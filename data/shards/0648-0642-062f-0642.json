"ن",2,0],["وَقَد قالَت لِأَترابٍ","لَها زُهرٍ تَلاقَينا",188,"ن",2,0],["وقد قلَبتُ الناسَ في حالاتهم","فما وجدتُ راضيا عن الزمنْ",189,"ن",1,0],["وقد قسمَ النَّصفَ حرُّ اليمي","ن في كلّ مَظلَمةٍ يعدِلُ",190,"ل",1,0],["وقد قعدتْ بي نُصرةُ اليدِ أختَها","وقُلِّصَ عني الظلُّ وهو مديدُ",191,"د",1,0],["وقد قَنِط الثرى وخوتْ أصولُ ال","عِضاهِ وصَوَّحَ العُشبُ الرطيبُ",192,"ب",1,0],["وقد قلتُ إنَّ الشوقَ ليس بجذوةٍ","فما بالهُ يذكو إذا هبَّتِ الريح",193,"ح",1,0],["وقد قيل أن الورق ربَّات مأتمٍ","فلم رقصت فيها قدودٌ من القضب",194,"ب",1,0],["وقد قلتُ إن الليل ليس بقاتل","وإن الثريا سوف يُنجدها الفجر",195,"ر",1,0],["وقد قبل الصبح الدجى وضلاله","رجاء جفوني عزل حيٍّ بمّيت",196,"ت",1,0],["وقد قيل إنَّ البانَ ليسَ بمثمرٍ","وهاهي بانٌ والثمارُ نهودها",197,"د",3,0],["وَقَد قَلَينا لَكَ سَنبوسَجا","نورِدُ مِنهُ مُضعَفَ الوَردِ",198,"د",1,0],["وَقَد قُلتُ لَما سِيلَ عَمَّا أَنَلتَنِي","لِيَزدادَ رغماً مَن يُحبُّ لِيَ الرَّدَى",199,"د",2,0],["وَقَد قُلتُ مَهلاً آلَ حَزمِ بنِ فَرتَنى","فَفي ظُلمِنا صابٌ مُمِرٌّ وَحَنظَلُ",200,"ل",1,0],["وَقَد قادَت فُؤادِي في هَواها","وَطاعَ لَها الفُؤَادُ وَما عَصاها",201,"ه",2,1],["وقد قام في شأن الحقيقة مرشداً","يعلَّمُ طور المصطفى كلَّ مرشد",202,"د",1,0],["وقد قالَ الرَّسولُ ائْمَنْ جَناباً","فمن بضَمانِ أَحمدَ في ضَمَانِي",203,"ن",2,0],["وَقد قابَلَتنا مِن سَجاياه نفحَة","أنَمُّ مِنَ المِسكِ الفَتيقِ وأَطيَبُ",204,"ب",1,0],["وقد قذفت نفسي أجل حظوظها","لديك وفقد الحظ جزء من الفقد",205,"د",1,0],["وقد قسم الرحمن بينهما البلا","بما فعلا والله أعدل قاسم",206,"م",1,0],["وَقد قَرَعت في ام عمرو لي العَصا","قَديماً كَما كانَت لِذي الحُلم تقرَع",207,"ع",1,0],["وقَدْ قَدَّرَ النَّحْوِيْ وذلِكَ فَنُّهُ","وأَمَّا فُنُوني فَهْيَ عَنْ مِثْلِهِ تَلْوِي",208,"و",2,0],["وقَدْ قالَ سَعْدُ الدِّينِ في الضَّعْفِ إنَّهُ","بِمَنْعٍ لَهُ قالَ الجَماهيرُ في النَّحْوِ",208,"و",1,0],["وَقَدْ قالَ في العافِينَ في قوله ألاَ","تُحِبُّونَ فافْهَمْ سِرَّ هَذا الذي تَتْلو",209,"ل",2,0],["وقد قَصَدتُ قبرَ خَيرِ واسِطَه","بيني وبينكَ وخيرِ رابِطَه",210,"ه",1,0],["وَقد قَضى اللَّهُ أن يزيل لنا","نعمةَ من ليس يشكر النِّعما",211,"م",2,0],["وقد قَطَر الجفاءُ فأوْسَعوه","فَسالَ عليَّ بعد القَطْر سيلا",212,"ل",2,0],["وقد قَلَصَتْ عنّي ذيولُ شبيبتي","وفي الرّأس شيبٌ كالثَّغامةِ شاملُ",213,"ل",1,0],["وَقَد قبستُ جميلاً دونَهم بيَدي","وأيُّ خيرٍ لفضلٍ غير مقبوسِ",214,"س",1,0],["وقد قضيتُ بذاك العذل مَأْرَبَةً","لو كان سمعِيَ عنه غيرَ مسدودِ",215,"د",1,0],["وقد قلتُ لمّا ضقتُ ذَرعاً بخُطّةٍ","شَموسِ القَرَا أين الوزير أبو سعدِ",216,"د",1,0],["وقد قلّدوا الأعناقَ منَّا وأترعوا","بطون الّليالي من لُهاً وأيادِ",217,"د",1,0],["وقد قلّصتْ خَطْوِي الليالي وشمّرتْ","برَوْحاتها من جيئتِي وذهابي",218,"ب",2,0],["وَقَد قَصَدتُ نَدى مَن لا يُوافِقُني","فَكانَ سَهمِيَ عَنهُ الطائِشَ الطافي",219,"ف",2,0],["وَقَد قالَت لِبيضٍ آنِساتٍ","يَصِدنَ قُلوبَ شُبّانٍ وَشيبِ",220,"ب",1,0],["وقد قصرت عنها تراكيب فعلها","وإطلاقها يستوجب الفتق والرتقا",221,"ق",2,0],["وقد قال أطواراً لنا هو خالق","مرتبة طوراً فطوراً يطوَّر",222,"ر",1,0],["وقد قسموا الوجود إلى قديم","يجلُّ وحادث هو للنفود",223,"د",1,0],["وقد قاله عبد الغني بربه","تبارك لا بالنفس تلك الفقيرة",224,"ه",1,0],["وقد قَطَرَتْ إذ حَظَّتِ السِّحرَ عينُهُ","منَ الحِبرِ فيهِ نُقطةٌ اسمُها الخالُ",225,"ل",1,0],["وَقَدْ قَامَتِ السُّوقُ بِالْمُسْمِعَاتِ","وَبِالْمُسْمِعِيْنَ عَلَى سَاقِهَا",226,"ق",3,0],["وَقَدْ قَدَحَ الوَجْدُ مِنّي بِهِ","على القلْبِ من نارِهِ ما قَدَحْ",227,"ح",1,0],["وقد قضى في امرأة تزوجت","ثم بنى الزوج بها فولدت",228,"ت",1,0],["وقد قيلَ إِنَّ الشُّهْبَ ينفُذُ حكمُهَا","عَلَى ذَا الوَرَى بالخفضِ منْهَا وبالنَّصْب",229,"ب",1,0],["وقد قابلتُ تقليل","ك من عشقي بتكثيرْ",230,"ر",1,0],["وقد قَضى تأخيرُهم","ما شئتَ من تَقْديمِ",231,"م",1,0],["وقد قِيلَ أَحْكامُ النجومِ على الوَرى","وأَنت على أَحكَامِهَا تَتَحكَّم",232,"م",1,0],["وقد قُتِل الخِصْبُ في تُربِها","فمحمرُّه بالدِّماءِ اخْتَضَبْ",233,"ب",1,0],["وقد قالت سُعودك عن قريبٍ","إِليك أَسوقهم سَوْق الجَنيب",234,"ب",1,0],["وقد قصروا أعني الصحابة دون ما","يقدره من فرسخ بالتعدد",235,"د",1,0],["وقد قال هذا ما تفرد عنهمو","به الشسيخ هذا رسم خط لناقل",236,"ل",1,0],["وقد قيل هذا في أناس تخلفت","مناقبهم عما استفاد وأوفدا",237,"د",2,0],["وَقَد قُلتُ لِلقَومِ الَّذينَ تَرَوَّحوا","عَلى الجُردِ في أَفواهِهِنَّ الشَكائِمُ",238,"م",1,0],["وقد قتلناكُمُ في كلِّ مُعْتَرَك","حتى أوَيْتُم ولا يأوِي لكمْ أحد",239,"د",1,0],["وَقَد قالَت نُوَيرَةُ لَيسَ حَيٌّ","عَلى الجُلّى يَكونُ لَنا خَفيرا",240,"ر",2,0],["وَقَد قُمتُ إِذ قامَت وَقالَت وَأَعرَضَت","تَجُرُّ قَشِيباً مِن حَريرٍ وَمُجسَدا",241,"د",2,0],["وَقَد قَراهُنَّ مَعروفاً رَحَلنَ لَهُ","سَمَيدَعٌ مِن بَني الخَطّابِ مَحمودُ",242,"د",1,0],["وَقَد قَطَعَت تُماضِرُ بَطنَ قَوٍّ","يَمانِيَةِ التَهَجُّرِ وَالرَواحِ",243,"ح",1,0]]}