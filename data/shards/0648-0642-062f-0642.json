oem47847.html","الطويل"],[554,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[556,"أهل الصفاء نأيتم بعد قربكم","https://www.aldiwan.net/poem68285.html","البسيط"],[556,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[561,"إذا كان كلي دائما يشبه البرقا","https://www.aldiwan.net/poem34320.html","الطويل"],[561,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[561,"وجود الشيء شاء يشيء شيئا","https://www.aldiwan.net/poem34603.html","الوافر"],[561,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[565,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[570,"سجاياك من طيب أعراقها","https://www.aldiwan.net/poem69568.html","المتقارب"],[570,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[578,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[578,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[578,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[578,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[588,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[590,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[590,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[590,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"],[741,"","https://poetry.dctabudhabi.ae/diwan/poem/26616","الطويل"],[512,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/22571","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28067","الطويل"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/17735","البسيط"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"]],"verses":[["وَقَد قَطَعَ المَعروفَ بِاللُؤمِ قاطِعٌ","وَباعَ الثَناءَ الحُرَّ بِالذَمِّ بائِعُ",0,"ع",1,0],["وَقَدْ قَايَضَتْهُمْ إِذْ أُتِيحَ بَوارُها","بِشِرْذِمَةٍ يَنْميهمُ شَرُّ والِدِ",1,"د",1,0],["وَقَدْ قَنِعْتُ فَجَأْشِي لا يُقَلْقِلُهُ","بَيْضاءُ كِسْرَى وَلا صَفْراءُ قارونِ",2,"ن",1,0],["وَقَد قُلتُ إِنّي قَد سَلَوتُ عَنِ الهَوى","وَمَن كانَ مِثلي لا يَقولُ وَيَكذِبُ",3,"ب",1,0],["وَقَد قالَ لي أَهلي كَما قالَ أَهلُها","لَها غَيرَ أَنّي لَم أُطِع في الهَوى أَهلي",4,"ل",2,0],["وَقَد قَشَعَت عَني ظَلومُ بِصَدِّها","سَحابَ نَوالٍ بَعدَما كَانَ أَمطَرا",5,"ر",2,0],["وَقَد قَلَبَ الزَمانُ عَلَيَّ يُمناً","وَكانَ إِلى شَفاعَتِها عِمادي",6,"د",2,0],["وَقَد قالَ لي ناسٌ تَحمَّل دَلالَها","فَكُلُّ صَديقٍ سَوفَ يَرضى وَيَغضَبُ",7,"ب",1,0],["وقد قادَ يوْمُ الغيْمِ سُحْباً كأنّها","رِفاقٌ أتتْ تمشي الهُوَيْنى على رِفقِ",8,"ق",1,0],["وقد قلَبَ السّوسانُ فيه رِداءَهُ","كأنّ النُعامَى أبرزَتْهُ ليَسْتَسْقي",8,"ق",2,0],["وَقَد قالَت قُتَيلَةُ إِذ رَأَتني","وَقَد لا تَعدَمُ الحَسناءُ ذاما",9,"م",2,0],["وَقَد قُلنَ بِالبَردِيِّ أَوَّلُ مَشرَبٍ","أَجَلَّ جَيرٍ إِن كانَت سَقَتهُ بَوارِقُهُ",10,"ق",2,0],["وَقَد قابَلَت مِنها ثَرىً مُستَجيزَةً","مَباضِعَ في وَجهِ الضُحى فَثُعالَها",11,"ل",3,0],["وَقَد قَرَعَ الواشونَ فيها لَكَ العَصا","وَإِنَّ العَصا كانَت لِذي الحِلمِ تُقرَعُ",12,"ع",1,0],["وَقَد قَتَلَت نَفسًا بِغيرِ جَريرَةٍ","وَليسَ لها عَقلٌ وَلا مَن يُقيدُها",13,"د",3,0],["وَقَد قَطَعَ الواشونَ ما كانَ بَينَنا","وَنَحنُ إِلى أَن يوصَلَ الحَبلُ أَحوَجُ",14,"ج",1,1],["وَقَد قيلَ ما قَولَةٌ قالَها","فَقُلتُ لَهُم رَوثَةُ راثَها",15,"ث",3,0],["وَقَد قابَلَتهُ عَوكَلاتٌ عَوانِكٌ","رُكامٌ نَفَينَ النَبتَ غَيرَ المآزِرِ",16,"ر",1,0],["وقد قُدْ من بُرد العشيّ جِلالُه","وفي ذيله صبغ من الليل حائلُ",17,"ل",1,0],["وقد قام من حول السرادق موكب","عظيم به اصطفّت أُلوف من الجند",18,"د",1,0],["وقد قيل إن الروح تبقى فهل لها","عروج إلى الأعلى إلى الأنجم الزهر",19,"ر",1,0],["وقد قال بعض القوم إن حياتنا","كليلٍ وإن الفجر مطلعه القبر",20,"ر",1,0],["وَقَد قَطَعَ الحَديدَ فَلا تَماروا","فَرِندٌ لا يُفَلُّ وَلا يَذوبُ",21,"ب",1,0],["وَقَد قَعِسَت ظُهورُهُمُ بِخَيلٍ","تُجاذِبُهُم أَعِنَّتَها جِذابا",22,"ب",2,0],["وَقَد قُرِنوا حينَ جَدَّ الرِهانُ","بِسامٍ إِلى الأَمَدِ الأَبعَدِ",23,"د",1,0],["وَقَد قَوَّسَت أُمُّ البَعيثِ وَأُكرِهَت","عَلى الزِفرِ حَتّى شَنَّجَتها الأَخادِعُ",24,"ع",1,0],["وَقَد قالَ الوُشاةُ فَأَفزَعونا","بِبَعضِ القَولِ نَكرَهُ أَن يُقالا",25,"ل",2,0],["وَقَد قَتَلَ الجَحّافُ أَولادَ نِسوَةٍ","يَسوقُ اِبنُ خَلّاسٍ بِهِنَّ وَعَزهَلُ",26,"ل",1,0],["وَقَد قَلَّصَت عَن مَنزِلٍ غادَرَت بِهِ","مِنَ اللَيلِ جَوناً لَم تُفَرَّج غَياطِلُه",27,"ل",2,0],["وَقَد قَلَّدتُ مِن خِزيِ القَوافي","بَني سَهمٍ عَلى رَغمِ الرِغامِ",28,"م",1,0],["وقد قيل كم من رِشدة في كريهةٍ","ومن غَيّةٍ تُلقَى عليها الشراشر",29,"ر",1,0],["وقد قصدتك كالصادي أُليح له","في مهمهٍ ماءُ مزنٍ صانه رصف",30,"ف",1,0],["وقد قاموا ولا يهجَ","ع من ذاق الذي ذاقوا",31,"ق",3,0],["وقد قلت للأعداءِ لمَّا تظاهروا","عليّ وقد أوعدتهم بصيالكا",32,"ك",2,0],["وقد قُرعت من ذي أناملك العصا","وإن راب ريبٌ بعدها سُلَّ معولُ",33,"ل",1,0],["وقد قصَّرتُ لا عمداً ولكن","بُهرتُ وعزَّني ملك همامُ",34,"م",1,0],["وَقَد قَلِقَت قِلادَةُ كُلِّ غَوجٍ","يُطِفنَ بِهِ كَما قَلِقَ السِوارُ",35,"ر",1,0],["وَقَد قالَت مُدِلَّةُ إِذ قَلَتني","أَراكَ كَبِرتَ وَالصُدغَينِ شابا",36,"ب",2,0],["وَقَد قَسَموا مالي وَأَضحَت حَلائِلي","قَدِ اِستَبدَلَت غَيري بِبَهجَتِها بَعلا",37,"ل",2,0],["وَقَد قَرَّبَ اللَهُ المَسافَةَ بَينَنا","فَها أَنا يَحويني وَإِيّاهُ إيوانُ",38,"ن",1,0],["وَقَد قيلَ إِنَّ الطَيفَ في النَومِ زائِرٌ","فَأَينَ لَطَرفي نَومَةٌ يَستَعيرُها",39,"ر",3,0],["وَقَد قادَني الجيرانُ حيناً وَقُدتُهُم","وَفارَقتُ حَتّى ما تَحِنُّ جِمالِيا",40,"ي",2,0],["وَقَد قِلتُ في حُبّي لَكُم وَصَبابَتي","مَحاسِنَ شِعرٍ ذِكرُهُنَّ يَطولُ",41,"ل",1,0],["وقد قضت الأيام بالبعد بيننا","فطال على الأيام فيما قضت عتبي",42,"ب",2,0],["وقد قلنا بهِ ونفاه بعض","وإن لنا مع النافي جدالا",43,"ل",2,0],["وَقَد قَصَدتُكَ وَالتَرحالُ مُقتَرِبٌ","وَالدارُ شاسِعَةٌ وَالزادُ قَد نَفِدا",44,"د",2,0],["وَقَد قَتَلَ الأَقرانَ حَتّى قَتَلتَهُ","بِأَضعَفِ قِرنٍ في أَذَلِّ مَكانِ",45,"ن",1,0],["وقد قصُرْت أيدي المكارمِ بعدَكُمْ","وكنتمْ لها بُوعاً طِوالاً وأذرُعَا",46,"ع",2,0],["وقد قُرِضَتْ منها جِعادُ لِمَامها","وقامتْ صفوفاً مثلما قُوِّمَ السَّطْرُ",47,"ر",1,0],["وَقَد قالَ داعي الحُبِّ هَل مِن مُجاوِبِ","فَأَقبَلتُ أَسعى قَبلَ كُلِّ مُجاوِبِ",48,"ب",1,0],["وَقَد قَطَعَت عَرضَ الأُرُندِ إِلَيهِمِ","كَتائِبُ تُزجى فَيلَقاً بَعدَ فَيلَقِ",49,"ق",1,0],["وَقَد قُلتُ لِلمُعلي إِلى المَجدِ طَرفَهُ","دَعِ المَجدَ فَالفَتحُ بنُ خاقانَ شاغِلُه",50,"ل",2,0],["وقد قَرِحَتْ على الجُودِ المآقي","وقد شُقَّتْ على الشِّعْرِ الجُيوبُ",51,"ب",1,0],["وَقَد قُلتُما إِن نُدرِكِ السِلمَ واسِعاً","بِمالٍ وَمَعروفٍ مِنَ الأَمرِ نَسلَمِ",52,"م",1,0],["وَقَد قَنِعَت نَفسي بِما قَد رُزِقتُهُ","فَشَأنُكِ يا دُنيا وَأَهلُ الغَوايلِ",53,"ل",1,0],["وَقَد قُلتُ وَلَم أَعدِل","كَلاماً مِن بَني ذُهلِ",54,"ل",1,0],["وقد قِسْتُ أعوامي الَّتي سَلفَت فما","وَفَيْنَ بِيَومٍ مِن لِقائِكَ واحِدِ",55,"د",1,0],["وَقَد قالَ إِمّا أَن أُغادَرَ بَعدَها","عَظيماً وَإِمّا أَن أُغادَرَ أَعظُما",56,"م",2,0],["وَقَد قَرَّبَ المَرمى البَعيدَ رَجاؤُهُ","وَسَهَّلَتِ الأَرضَ العَزازَ كَتائِبُه",57,"ب",2,0],["وَقَد قالَت لِتِربَيها","وَرَجعُ القَولِ يَعنينا",58,"ن",2,0],["وَقَد قُرِعَت في وَصلِ هِندٍ لَكَ العَصا","قَديماً كَما كانَت لِذى الحِلمِ تُقرَعُ",59,"ع",1,0],["وَقَد قُطِعَت أَعناقُهُنَّ صَبابَةً","فَأَنفُسَنا مِمّا يُلاقينَ شُخصُ",60,"ص",1,0],["وَقَد قَلَّدَ النُوّارُ جيداً لِرَبوَةٍ","هُناكَ وَنحراً لِلفَضاءِ رَحيبا",61,"ب",2,0],["وَقَد قيلَ نَصرانِيَّةٌ أُمُّ مالِك","فَقُلتُ ذَروني كُلُّ نَفسٍ وَدينُها",62,"ن",3,0],["وَقَد قَذِيَت عَيني بِلَيلى وَأَتبَعَت","قَذاها وَقَد يَأتي عَلى العَينِ شومُها",63,"م",3,0],["وَقَد قالَت أُمامَةُ هَل تَعَزّى","فَقُلتُ أُمامَ قَد غُلِبَ العَزاءُ",64,"ا",2,0],["وَقَدُّ قائِمَةٍ مِنهُ مُرَكَّبَةٍ","في مَفصَلٍ ضامِرِ الأَعصابِ ظَمآنِ",65,"ن",1,0],["وَقَد قَيَّدوا غَيرَ الفَقيهِ بِأَمرِهِ","وَمَن يَلقَ ما لاقى مِنَ الناسِ يَعلَمِ",66,"م",1,0],["وَقَد قَدَّرَ أَن يَصرُ","خَ لَكِن ما بِهِ طَرقُ",67,"ق",1,0],["وَقد قيلَ كتابُ النَّصارَى مَناسِرٌ","فما مِثْلُ كتَّابِ المَحَلَّةِ مَنْسَرُ",68,"ر",1,0],["وقد قلتُ للعارض المكفَهِرِّ","أفي السِّلم ذا البرقُ أم في الوغى",69,"ا",1,0],["وَقَد قاسَيتُ مِن حُبَّي","هِ أَمراً لَيسَ بِاللَعبِ",70,"ب",1,0],["وَقَد قَرَأتُ كِتاباً مِن صَحائِفِكُم","لا يَرحَمُ اللَهُ إِلّا راحِمَ الناسِ",71,"س",1,0],["وَقَد قُلتُ ما قَوّى الرَجاءَ سَماعُهُ","وَآمَنَ باغي النُجحِ مِن خَيبَةِ المُكدي",72,"د",2,0],["وَقَد قُلتُ لَها جودي","بِوَعدٍ مِنكِ أَو نَظرَه",73,"ر",2,0],["وَقَد قُلتُ تَأديباً لَهُ وَصَبابَةً","إِلَيها وَمِن دونِ اللِقاءِ وَعيدُ",74,"د",1,0],["وَقَد قالَت لَنا جارِ","يَةٌ تَعرِفُ في الصَوتِ",75,"ت",1,0],["وَقَد قامَت وَليدَتُها تُغَنّي","عَشِيَّةَ جاءَها أَنّي اِشتَكَيتُ",76,"ت",1,0],["وَقَد قَرَعتُ القَرينا إِذ قَرَعتُ لَهُ","بِالعَنكَبوتِ وَكانَ الحوبُ بِالحوبِ",77,"ب",1,0],["وَقَد قُلتُ لَها سِرّاً","وَإِعلاناً لَدى صَحبي",78,"ب",2,0],["وَقَد قامَت عَلى أُمٍ وَأُختٍ","شُهودٌ حينَ لَقّاها الزِناءُ",79,"ا",2,0],["وَقَد قر حتى قلت قد جمد الدُجى","وَخلت بياض الصبح لَيسَ يَسيل",80,"ل",1,0],["وقَدْ قُلْتُ مِنْ فَرْطِ الأَسَى إِذْ رَأَيْتُهُ","وأَسْبَلَ دَمْعِي مُسْتَهْلاً أَوَائِلُهْ",81,"ل",2,0],["وقد قرَّبتْ فمَها من فمي","كشِقَّينِ من قبَسٍ مُسْتَعِرْ",82,"ر",1,0],["وَقَدْ قَشَعَتْ أَعْدَاؤُهُمْ عَنْ دِيَارِهِمْ","ورَدَّتْ إِلى الأَحْرَارِ فِي الْوَطَنِ الْحُرِّ",83,"ر",1,0],["وَقَد قاسَ قَومٌ جُودَ يُمناهُ بِالحَيا","وَقَد غَلِطوا يُمناهُ أَسخى وَأَسمَحُ",84,"ح",1,0],["وقد قال لي: ماذا تُعدُّ لما ترى","فقيهٌ إذا ما قال غيرُ مُفنَّد",85,"د",1,0],["وقد قال ابنُ إدريس مقالاً","صحيح النقل في حكم لطيفَه",86,"ف",2,0],["وقد قَدِمَتُ وما قدَّمْتُ لي عَمَلاً","إلاَّ غَرَامِي وأَشْوَاقي وإقدامي",87,"م",2,0],["وقد قلت ما فيهم نفاق ولا بهم","جحود وهذا الحكم منك شهير",88,"ر",1,0],["وقد قاد يوم الغيم سحبا كأنها","رقاق أتت تمشي الهوينا على رفق",89,"ق",1,0],["وقد قلب السوسان فيها رداءه","كأن النعامى أبرزته ليستسق",89,"ق",1,0],["وقد قعد المختار في الحفل منصتا","له وحبا كعبا عليه وحسانا",90,"ن",2,0],["وقد قالت أمامة ُ هل تعزّى","فقلتُ أُمَيْمُ قد غُلِبَ العَزاء",91,"ا",2,0],["وقد قمتْ على التشريعِ سوقٌ","بها احتشدتْ عبيدٌ أو إماء",92,"ا",2,0],["وَقَدْ قُلْتُمَا إِنْ نُدْرِكِ السِّلْمَ وَاسِعاً","بِمَالٍ وَمَعْرُوفٍ مِنَ القَوْلِ نَسْلَمِ",93,"م",1,0],["وقد قَذِيَتْ عَيْنِي بِلَيْلَى وأتْبَعَتْ","قذاعاًوقد يأتي على العين شومها",94,"م",3,0],["وقد قطعت حتى الرسائل بيننا","ولم تقطع الاحزان واصل لهفتي",95,"ي",1,0],["وقد قطعوا الأيام للَه بالصفا","فما استطولوا عاماً ولا استقصروا شهرا",96,"ر",2,0],["وقد قوبلت من رهط الأعادي","وأهل الحق بالعجب العجيب",97,"ب",1,0],["وقد قصدناه وهو الغوث للدنف ال","مسكين والغي إن تظمأ نواحينا",98,"ن",2,0],["وقد قضى اللّه في صنعا بأقضية","يقضي العجائب منها كلّ مكياس",99,"س",1,0],["وقدَّ قُوَى صدرِي بقامةِ قدِّه","وأردفَ أكبادي برمح نُهودِه",100,"د",2,0],["وقد قاربتَ حَدَّ الفصلِ","بينَ العَوجِ والمَثنى",101,"ن",2,0],["وَقَد قَتَلتُ بِهِ عَبساً وَإِخوَتَها","حَتّى شُفيتُ وَهَل قَلبي بِهِ شافي",102,"ف",2,0],["وقد قيض الله حَبرَا لَهُ","يُدَافِع عن هَفوِه إِن هَفَا",103,"ف",2,0],["وقَد قَادَ لِلصَّبرِ إِسلاَمُنَا","وقَاد لِنهجِ الرِّضَا بِالقَضَا",104,"ض",2,0],["وقد قَضَت باتِّبَاعِ الجَاهِلينَ لِمَن","يَدرُونَ في دِينِ طَه سيِّدِ البَشَرِ",105,"ر",1,0],["وقد قدَّرتْ كفُّ الصَّناعِ التئامَها","كتقدير دوادَ المساميرَ في السَّردِ",106,"د",1,0],["وقد قلتما لي ليس في الأرض جَنّةٌ","أما هذه فوق الركائب حُورُها",107,"ر",3,0],["وَقَد قَرَنتَ بِها بِالأَمسِ لُؤلُؤَةً","بِحارُها مُقفِراتُ البيدِ وَالحِلَلُ",108,"ل",1,0],["وَقَد قابَلَ البَحرَ سَيفُ الإِمامِ","بِبَحرِ رَدىً مَوجُهُ مُرتَطِم",109,"م",1,0],["وَقَد قَلَّدَتهُ الأَمرَ في الدينِ وَالدُنا","وَكانَ أَميناً بِالمَغيبِ عَلَيهِما",110,"م",2,0],["وَقَد قالَتِ السَبعونَ لِلَهوِ وَالهَوى","دَعا لي أَسيري وَاِذهَبا حَيثُ شِئتُما",111,"م",2,0],["وقد قيل يبقى الود ما العتب باقياً","فللّه ما أحلى مقال ذوي اللب",112,"ب",1,0],["وقد قيل لا يأبى الكرامة غير من","له عرق لؤم لم يزل في الخنا يسري",113,"ر",2,0],["وقد قدمت ماسرها من صنيعها","وقد أخرت ماسرني من ثنائها",114,"ا",3,0],["وقد قرأوا الا يؤول ظاهر","من الكفر بل يقضي به ويتوب",115,"ب",1,0],["وقد قلاه المسلمون كلهم","وكلهم ناءٍ عن اقترابه",116,"ب",2,0],["وَقَد قَرَّبُوا لِلبَينِ كُلَّ هَمَرجَلٍ","أَمُونِ القَرى ضَخمِ العَثانين تامِكِ",117,"ك",1,0],["وَقَد قَلِقَت مِنّي الحَشا وَتَتابَعَت","ظَواهِرُ أَنفاسٍ وَأُخرى دَواخِلُ",118,"ل",1,0],["وقَدْ قَتَلَتْهُ الْعِدا غرَّةً","وَما صادَفَتْ مِنْهُ عَبَداً عَتِيداً",119,"د",2,0],["وَقَد قُلتُ يَوماً لاِبنِ عَمروٍ وَقَد عَلَت","فُوَيقَ التَّراقِى أَنفُسٌ وقُلُوبُ",120,"ب",1,0],["وقد قَصدتُك والدنيا ومَن جَمَعتْ","كلٌّ يُسدِّد رأيي بل يُصوِّبه",121,"ب",2,0],["وقد قابلتْ وردا جَنِيا كأنه","مَطَارفُ خَزٍّ فيه قانٍ ووارِس",122,"س",1,0],["وقد قال فيما مضى شاعر","رأى الحق في الحزم فاستعمله",123,"ل",2,0],["وقد قل الوفا في النا","س فالآداب مسقوطه",124,"ط",2,0],["وقد قال قوم هوّن الأمر ربما","لقد هان ما قد كان بالأمس يحمد",125,"د",1,0],["وقد قمنا بتصفيق","وتعديد إلى النهد",126,"د",1,0],["وَقَد قالَ إنّي مُرسلٌ مِن إِلهكم","فَصدّقه لمّا أتاحَ له النصرا",127,"ر",2,0],["وَقَد قَطعوا ما بينَهم من علائقٍ","وَبينَ رَهابين بها اِستَعبَدوا الحُرّا",127,"ر",2,0],["وَقَد قَطعوا في حبّهِ الحَزنَ وَالسهلا","وَقَد لبِسوا العرفانَ إِذ خَلعوا الجَهلا",128,"ل",2,0],["وَقَد قُلتُ إِنَّ الريحَ طَيِّبَةٌ لَكُم","وَعَزَّ المَقامُ غَيرَ شَكٍّ لِذي فَهَم",129,"م",1,0],["وقد قيل في حفظ اللسان وخزنه","مسائل من كل الفضائل أكمَلُ",130,"ل",1,0],["وقد قيل يُبلي الثوبَ من قبل حِينه","مُقاساتُه قبل التدنُّسِ بالغسلِ",131,"ل",1,0],["وقد قد تفرد بالتثني","وقد جمع الرشاقة والنضاره",132,"ر",2,0],["وَقدِّ قلبي وَاِنثَنى مُعجبا","وَقال لي كيف تَرى قَدّى",133,"د",2,0],["وقد قابلكَ البدر","فأخمدْت سنا البدرِ",134,"ر",1,0],["وقد قبضتْ كفُّ المنون نفوسَهم","وقد محقتْ منهم أُناساً ومعشرا",135,"ر",2,0],["وقد قَرُبَ الوقتُ فَلْيَأْذَنوا","بوَشْكِ الزَّوال وسوءِ القضا",136,"ا",1,0],["وَقَد قَلَّ في أَهلِهِ المُنعِمونَ","وَقَد كَثُرَ البائِسُ المُرمِلُ",137,"ل",1,0],["وقد قرنوا جنباً لجنب ثلاثة","ينوؤون بالأغلال والوجه مقطب",138,"ب",1,0],["وقد قامت الحرباء ترقبها ومن","جيادتها بالحرب جاء نذيرها",139,"ر",3,0],["وقد قا