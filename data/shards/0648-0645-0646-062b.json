{"poems":[[228,"لمن يا ترى أشكو بمدمعي الهمل","https://www.aldiwan.net/poem41906.html","الطويل"],[287,"شكوت فلم يرق لضعف حالي","https://www.aldiwan.net/poem32662.html","الوافر"],[376,"متى صارت الجرد المذاكي سفائنا","https://www.aldiwan.net/poem57079.html","الكامل"],[409,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[422,"أما والهوى بالوجوه الملاح","https://www.aldiwan.net/poem53979.html","الرمل"],[572,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[572,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[591,"نعم هي الدار من يناديها","https://www.aldiwan.net/poem17965.html","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87007","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86863","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54049","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137641",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48828","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38216","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38053","المجتث"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138717",""],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107208","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78026","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42402","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89533","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53088","البسيط"],[2528,"","https://poetry.dctabudhabi.ae/diwan/poem/199541","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58437","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114232","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111453","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111434","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94561","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94474","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104533","الرجز"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4755,"مأساة سُهَيل اليَمَاني ( 3 )","https://www.poetsgate.com/ViewPoem.aspx?id=210756",""],[4763,"الموجة","https://www.poetsgate.com/ViewPoem.aspx?id=187404",""],[4778,"بالعزم تُدرَك المنى","https://www.poetsgate.com/ViewPoem.aspx?id=188214",""],[4829,"ملحمة الطلاسم للألفية الدمويّة","https://www.poetsgate.com/ViewPoem.aspx?id=34257",""],[4859,"ولا عز إلا بخلع الظلام.","https://www.poetsgate.com/ViewPoem.aspx?id=207404",""],[5038,"عناقيد الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=190094",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5131,"مكانَكِ يا نفسُ لا تنطقي","https://www.poetsgate.com/ViewPoem.aspx?id=53814",""],[5246,"تقلب الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=187046",""],[5277,"عناكبُ الوجدِ","https://www.poetsgate.com/ViewPoem.aspx?id=206366",""],[5431,"خيمة بؤسٍ...وقصعةِ بردِ","https://www.poetsgate.com/ViewPoem.aspx?id=183414",""],[5431,"سورة الماء...","https://www.poetsgate.com/ViewPoem.aspx?id=203214",""],[5464,"سيدة النساء","https://www.poetsgate.com/ViewPoem.aspx?id=53584",""],[5518,"توسلت بالمختار أرجى الوسائل","https://www.poetsgate.com/ViewPoem.aspx?id=190036",""],[5937,"موجزٌ عربي","https://www.poetsgate.com/ViewPoem.aspx?id=211884",""],[6056,"منثور الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=130519",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""],[572,"شَمْسُ الضّحَى في الغَمَامِ مُسْتَتِرَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9290&r=&rc=147",""],[572,"أَلاَ أَبْلِغْ أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9291&r=&rc=148",""]],"verses":[["وَمن ثَغرِها نورُ المساواةِ مشرقٌ","يفسِّر أَنَّ الملك في خلقِهِ مثلي",0,"ل",2,0],["وَمَنثوراً أَنامِلُهُ رِخاصٌ","بِهِنَّ جَواهِرُ الحُسنِ الغَوالي",1,"ل",2,0],["ومِن ثقةِ الرُّومي بالماءِ مَركباً","يَفوتُ عَليه الخيلَ وافاكَ آمِنا",2,"ن",2,0],["ومن ثقلت منه الموازين حسبه","ويا حبذا من سالم وهو غانم",3,"م",1,0],["ومن ثَمَّ رُحْتُ وقول العذول","يمرُّ بمسمعي مرور الرِّياح",4,"ح",1,0],["وَمَنْثُورُ لَفْظٍ كَمَعْروفِكَ ال","جَمِيْلِ الَّذِي لَمْ يُكَدَّرْ بِمَنْ",5,"ن",1,0],["وَمَنْثُورٍ كَأَلْفَاظِ","كَ فِي النَّظْمِ وَفِي النَّثْرِ",6,"ر",1,0],["وَمِنْ ثُغورٍ دَمْعي الطّليقُ بِهَا","شَقيقُ ما افْتَرَّ مِنْ أَقاحيها",7,"ي",3,0],["وَمِن ثَناءٍ مجازيٍّ حَقيقتُه","تَهكُّمٌ عِند تَفصيل وَإِجمال",8,"ل",1,0],["وَمَن ثَناءُ الوَرى في كُل حادثة","عَلَيهِ في كتب الأَخبار مَسطور",9,"ر",1,0],["ومن ثراءٍ على افتقار","ومن شفاءٍ على شكاة",10,"ه",1,0],["ومن ثقل الضغط قد قطع الش","شريط كما لو تقد الخيوط",11,"ط",1,0],["ومن ثقلت ضرائبه عليه","فأنت له الكفيل بأن تهونا",12,"ن",2,0],["وَمِن ثَنائي غَدا يُثني عَلَيكَ مَعي","عِندَ الثَّناءِ لِسانُ الحَمدِ وَالمَدْحِ",13,"ح",1,0],["وَمِن ثَقيلِ غَرامي","حَمَلتُ في الحبِّ كلّا",14,"ل",2,0],["ومن ثم ترقى هيكل المشترى الذي","بأبدع أنواع النقوش مقنّع",15,"ع",1,0],["ومَنثُورِ دُرٍّ مِن حَديثِكِ زَانَهُ","عَلى حُسنِهِ دَلٌّ هُناكَ عَجِيبُ",16,"ب",1,0],["وَمِنْ ثَقِيفٍ لَكَ خَيْرُ الجَوْهَرِ","تَمَّ إِلَى عادِيِّ عِزٍّ بَهْزَرِ",17,"ر",1,0],["ومن ثلاثة من الشعر إلى","تسعة أبيات لنظم تجتلى",18,"ل",2,0],["وَمِن ثُمَ يَوم الفَتح سَبعون سَيداً","سَقاها كُؤوس الحَتف بَين الجَحافل",19,"ل",1,0],["ومِن ثم لم تدرَ بما اللّهُ صانعٌ","بعبدِ لهُ الشيطانُ في حبِّها أغوى",20,"و",2,0],["وَمَن ثاوَرَ الأُسَدَ الضَواري جَعَلنَهُ","لِأَشبالِها تَحتَ الأَظافِرِ مَطعَما",21,"م",2,0],["ومن ثنى غصن بانٍ في كثيب نقاً","أقل بدر دجى في صدر أُملود",22,"د",1,0],["ومن ثوب قوهي وثوب غلالة","ولا بأس إن اتبعت ذاك بخامس",23,"س",1,0],["ومنثورُ الصفاصِفِ مثلُ دُرٍّ","بسِلكِ السيرِ تنظِمُهُ العَوالي",24,"ل",2,0],["ومن ثلاثِ مايةٍ في الشِّمالِ","للتِّيرَمَا ثمَّ تُقِفُّ ليالي",25,"ي",1,0],["وَمَنْ ثنى فَيْشَتَهُ","وبالَ سالَ بولُهُ إلى وَرا",26,"ا",1,0],["وَمَنثُورُهَا الزَّاهِي كَمَنثُورِكَ الَّذِي","تَنَزَّهَ عَن نَفثِ المُرَفَّعِ مِن سِحرِ",27,"ر",1,0],["وَمِن ثَمَّ مَسَّهُما بِعَصاهُ","وَأَولاهُما قُوَّةَ مِن قُواهُ",28,"ه",1,0],["وَمِن ثَمَّ هَمّض وفيهِم تَصَدَّر","وَفي إِثرِهِ زُعَماءُ المُعَسكَر",28,"ر",1,0],["وَمِن ثَمَّ فِيبُوسٌ إِلى آرسَ انثَنى","يَحُثُّ خُطاه لِلوَغى وَيُثَرِّبُ",29,"ب",1,0],["ومِن ثَمَّ عَن كِتفَي ذِيُومِيذَ لأمَةً","حَباهُ بِها هِيفستُ وَهيًَ تُظِلُّهُ",30,"ه",1,0],["ومِن ثَمَّ امتَطى والذِّبحَ أَلقى","بِمَركبِهِ وعادَ إِلى القُصُورِ",31,"ر",1,0],["ومن ثم انبرت تعدو","بغير هدىً ونسوتها",32,"ه",2,0],["ومن ثمة اجتره بالسنان","عن العرش بالرمح يلصق لصقا",33,"ق",2,0],["ومن ثم أتبعه بقرومٍ","على بعضهم بعضهم قد ثوى",33,"ث",3,0],["ومن ثم أخمد أنفاسه","وأغمض عينيه ستر المنون",33,"ن",1,0],["ومن ثم عنه الإلاه توارى","وكالبرق بين الجيوش سرى",33,"ر",2,0],["ومن ثمة انقض فوق القتيل","كليثٍ بقلب الحظائر صال",33,"ل",1,0],["ومن ثم أسبل ظل الظلام","عليه ستار الردى فطفا",33,"ف",2,0],["ومن ثم هاج عليه وماج","ودمدم يدوي بذاك الفجاج",34,"ج",1,0],["ومن ثم تحت السلاح تلملم","بقلبٍ لحرب ابن فيلا تضرم",34,"م",1,0],["ومن ثم حلت عرشها ولفيفهم","تألم من زفسٍ وزفس مخيفهم",35,"م",1,0],["ومن ثغرها ضاءَت زواهي زواهرٍ","ونضَّت لدى الترحاب دُرّاً منضَّدا",36,"د",2,0],["ومن ثغرها الدريِّ تحلو مباسمٌ","تذيق سلافاً فاق في طعمهِ الشهدا",37,"د",2,0],["ومن ثراه اكتحلت أجفانها","فانفلتت تهزأ بالجآذر",38,"ر",1,0],["وَمِن ثمَّ كانَت عادَةُ اللَهِ في الَّذي","يَؤُمُّ سِواهُ دائِماً نَيل خَيبَةِ",39,"ه",1,0],["وَمِن ثمَّ كانَت نَشأَةُ الخَلقِ أَوَّلاً","تَهدُّ وَنَشأ العَرض نَفخَةُ بَعثَةِ",39,"ه",1,0],["ومِن ثُمَالَةِ أَشعَارٍ تَقُولُ: أَفِق","فَإِنَّ (عَبدَ يَغُوثٍ) ماتَ سَكرانا",40,"ن",2,0],["وَمِنْ ثَمَّ يَأْتِي خَرِيفٌ جَدِيدْ","وَتَلْقَيْنَنِي عِنْدَهَا أستَجِيبْ",41,"ب",1,0],["ومن ثم للبحرين رحلي توجهت","مدير لتحليل المواد خبير",42,"ر",1,0],["ومن ثمّ تموج الارض هرج ومرج من مسعور","موجن لج يرجها رج شعوبن لانظاميه",43,"ي",2,0],["ومن ثغرِ صمتِ المدى نجتني","لذيذَ الأطايبِ..عذبَ السلام",44,"م",1,0],["ومِنْ ثغْرِها والْخالِ والصّدْرِ خمْرَةً","بِكأْسٍ أَلا فاسْقي عَطاشى الْمَجانينِ",45,"ن",1,0],["وَمَنْ ثَابَ حُرّاً واسْتَزَادَ مَحَاسِناً","تَجَلَّى بِبُسْتَانٍ وَعَاشَ لِيَرْتَعَا",46,"ع",2,0],["ومن ثروةٍ يحتسي نفعها","مسبِّبُ واقعنا المملق",47,"ق",1,0],["ومن ثَمَرِ الأشجار يسقطُ يانعاً","يفوز به الغادي كمُلتقِطِ الدر",48,"ر",1,0],["ومنْ ثمالتِها..ما زلتُ أشربُها","بقيةً..لم تفِ قلبي فترويهِ",49,"ي",2,0],["ومن ثمَّ تُبدي اندهاشاً عجيباً","إذا ما تأججَ غلّي وحقدي",50,"د",2,0],["ومن ثمّ غبّ النهرُ مهرا وخلّه","إلى أين؟؟....لاندري ! وماثمَّ مشكلة!",51,"ل",2,0],["ومن ثرى (كوفتِنا) أشرقتْ","شمسٌ ولا كنورها الفرقدانْ (4)",52,"ن",1,0],["ومن ثم يوم الفتح سبعين سيدا","سقاهم كؤوس الحتف بين الحجافل",53,"ل",1,0],["ومن ثغر الإذاعة ألف صوت","يزمجر للرصاصة كالنُباحِ",54,"ح",1,0],["ومنثور الشعر يسبح جديله واصل ٍ الساق","ورمش العين إلاسلهم جرح قلبي بطعناته",55,"ت",2,0],["ومن ثقةٍ في الله أرجو دوامها","الى حين يطويني على نورها الرمسُ",56,"س",1,0],["ومن ثقل الذنوب بنا صغار","وخوف من حسابكم شديد",57,"د",1,0],["ومن ثمارٍ على التّرائِبِ في","صحيحة ِ الصَّدْرِ غيرِمُنكسِرَهْ",58,"ر",2,0],["ومنثُورٍ كألفاظِ","كَ في نَظمٍ وفي نَثْرِ",59,"ر",1,0]]}