{"poems":[[221,"لمن يا ترى أشكو بمدمعي الهمل","https://www.aldiwan.net/poem41906.html","الطويل"],[280,"شكوت فلم يرق لضعف حالي","https://www.aldiwan.net/poem32662.html","الوافر"],[369,"متى صارت الجرد المذاكي سفائنا","https://www.aldiwan.net/poem57079.html","الكامل"],[400,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[413,"أما والهوى بالوجوه الملاح","https://www.aldiwan.net/poem53979.html","الرمل"],[565,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[565,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[584,"نعم هي الدار من يناديها","https://www.aldiwan.net/poem17965.html","المنسرح"]],"verses":[["وَمن ثَغرِها نورُ المساواةِ مشرقٌ","يفسِّر أَنَّ الملك في خلقِهِ مثلي",0,"ل",2,0],["وَمَنثوراً أَنامِلُهُ رِخاصٌ","بِهِنَّ جَواهِرُ الحُسنِ الغَوالي",1,"ي",1,0],["ومِن ثقةِ الرُّومي بالماءِ مَركباً","يَفوتُ عَليه الخيلَ وافاكَ آمِنا",2,"ن",2,0],["ومن ثقلت منه الموازين حسبه","ويا حبذا من سالم وهو غانم",3,"م",1,0],["ومن ثَمَّ رُحْتُ وقول العذول","يمرُّ بمسمعي مرور الرِّياح",4,"ح",1,0],["وَمَنْثُورُ لَفْظٍ كَمَعْروفِكَ ال","جَمِيْلِ الَّذِي لَمْ يُكَدَّرْ بِمَنْ",5,"ن",1,0],["وَمَنْثُورٍ كَأَلْفَاظِ","كَ فِي النَّظْمِ وَفِي النَّثْرِ",6,"ر",1,0],["وَمِنْ ثُغورٍ دَمْعي الطّليقُ بِهَا","شَقيقُ ما افْتَرَّ مِنْ أَقاحيها",7,"ي",3,0]]}