"https://www.poetsgate.com/ViewPoem.aspx?id=177863",""],[5781,"طُيوفكَ المنى ...وحبق","https://www.poetsgate.com/ViewPoem.aspx?id=208930",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[5790,"تذكار أيام الشبيبة يطرب","https://www.poetsgate.com/ViewPoem.aspx?id=111978",""],[5851,"عزف على بقايا جرح","https://www.poetsgate.com/ViewPoem.aspx?id=175294",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5943,"نزعنا السَّرجَ","https://www.poetsgate.com/ViewPoem.aspx?id=11091",""],[5956,"تعالي ننظف ما بنفسينا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182190",""],[5956,"الجمال الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=184945",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"فطرة الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=205168",""],[5957,"أحتاج أن تكون لي الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=183295",""],[5975,"رفقاً بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=58779",""],[6003,"كفن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=188914",""],[6006,"مكناس","https://www.poetsgate.com/ViewPoem.aspx?id=214149",""],[6052,"ميراث الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=35378",""],[6078,"ودارتِ الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=202775",""],[6113,"السرقه والحكم","https://www.poetsgate.com/ViewPoem.aspx?id=12916",""],[6113,"اعطوني السبحه","https://www.poetsgate.com/ViewPoem.aspx?id=117935",""],[6147,"ترشف ..من دموعي..","https://www.poetsgate.com/ViewPoem.aspx?id=151494",""],[6199,"حديث الرجل الأول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79698&r=&rc=19",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[5616,"أحوال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1927&r=&rc=2",""],[6273,"سهاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78506&r=&rc=4",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""]],"verses":[["ونملأ الأرض تبليغاً لمذهبهم","مجالساً صَفدّت فيها الشياطينا",0,"ن",2,0],["وَنَمى إِلَيَّ مِنَ العَجائِبِ أَنَّهُ","لَعِبَت بِعَقلِكَ حيلَةُ الخَوّانِ",1,"ن",1,1],["وَنِمتُ عَنِ الأَضغانِ حَتّى تَلاحَمَت","جَوائِفُ هاتيكَ النُدوبِ القَدائِمِ",2,"م",1,0],["وَنَم مُستَودَعاً صَوناً وَأَمناً","فَقَد أَسلَفتَها جَزَعاً وَذُلّا",3,"ل",2,0],["وَنَملِكُ أَعناقَ أَحداثِهِ","فَنُلبِسُها مِسحَلاً أَو عِذارا",4,"ر",2,0],["وَنُمسي بِآمالٍ طِوالٍ كَأَنَّنا","أَمِنّا بَياتَ الخَطبِ دونَ المَطالِبِ",5,"ب",1,0],["وَنِمتُ مُلقىً على سقطِ اللِّوى لِمَمي","وَنَفحَةُ المِسكِ تَسري في نواحيها",6,"ي",3,0],["وَنَمَّ ما تُظْهِرُهُ أَعْيُنٌ","مِنَّا بِما تُضْمِرُهُ أَضْلُعُ",7,"ع",1,0],["ونَماهُ أرْوَعُ عُودُهُ مِنْ نَبْعَةٍ","رَفّتْ على أعْراقِها الأفْنانُ",8,"ن",1,0],["وَنِمتِ خَلِيَّةً وَفَقَدتُ نَومي","أَما اِستَحيا رُقادُكِ مِن سُهادي",9,"د",2,0],["ونَمْزُجُ كأسَ الرّاحِ تُتْرَعُ بيْنَنا","شَمولاً بمَعْسولٍ من الرّيقِ بارِدِ",10,"د",1,0],["ونَمٍّ ظَنونٍ مُستَظَنٍّ مُلَعَّنٍ","لُحومُ الصَديقِ لَهوُهُ وَمآكِلُه",11,"ل",2,0],["وَنَمَت رَأيَهُ التَجارِبُ حَتّى","باتَ أَمضى مِن نافِذاتِ النِبالِ",12,"ل",1,0],["ونمضع في اليهاج الموت دون ال","علا مضغ الأوانس للعلوك",13,"ك",1,0],["ونَمنَعُ بالأَسِنَّةِ ما سَخِطنَا","مُكَابَرَةً ونَأخُذُ ما هَوِينَا",14,"ن",2,0],["وَنُمسِكُ عَن بَعضِ الأُمورِ مَهابَةً","فَيَعلَمُ مايُخفي الضَميرُ وَيَفهَمُ",15,"م",1,0],["ونمدح معتاد المديح وإنما","لكل امرئٍ من دهره ما تعودا",16,"د",2,0],["وَنَميمَةً مِن قانِصٍ مُتَلَبِّبٍ","في كَفِّهِ جَشءٌ أَجَشُّ وَأَقطُعُ",17,"ع",1,0],["وَنَمُدُّ أَيدِيَنا فَتَرجِعُ لَم تُصبِ","وَتَعودَ فَوقَ قُلوبِنا أَيدينا",18,"ن",2,0],["وَنَمدَحُ المَرءَ مِن خَزِّ مَلابِسِهِ","وَذَلِكَ الخَزُّ لَم تَنسُجُهُ كَفّاهُ",19,"ا",2,0],["وَنَمشي حُفاةً في ثَراها تَأَدُّباً","نَرى أَنَّنا نَمشي بِوادٍ مُقَدَّسِ",20,"س",1,0],["ونمرُّ مَا بَيْنَ المُروجِ الخُضْرِ","في سكر الشُّعورْ",21,"ر",1,0],["ونموت ثم نعود في","ادوارها بتسلسل",22,"ل",1,0],["وَنَموذَجٌ تَحذو عَلَيهِ وَلَم يَزَل","بِسَراتِهِم يَتَشَبَّهُ الأَقوامُ",23,"م",1,0],["ونَمْدَحُ أَقْواماً سِواكَ وإِنّما","إليكَ نُسَدِّيهِ وفيكَ نُزَخْرِفُهْ",24,"ه",1,1],["وَنَمتَحِنُ النُشّابَ في كُلِّ وابِلٍ","دَوِيُّ القِسِيِّ الفارِسِيَّةِ رَعدُهُ",25,"د",2,0],["وَنَمَتكَ مِن غَطَفانَ مُنجِبَةٌ","شَمسُ النَهارِ لِكامِلِ البَدرِ",26,"ر",1,0],["وَنَمنَعُ النَصفَ ذا الأَنفِ الأَشَمِّ إِذا","كانَ التَهَضُّمُ فيهِ العِزُّ وَالأَنَفُ",27,"ف",1,0],["ونَمنمةً تُضئُ له وتَخبُو","كما طَيَّرْتَ عن زَندٍ شَرارا",28,"ر",2,0],["وَنَمَت فُروعُ الدَوحِ حَتّى صافَحَت","كَفَلَ الكَثيبِ ذَوائِبُ الأَغصانِ",29,"ن",1,0],["وَنَمَّت بِأَسرارِ الرِياضِ خَميلَةٌ","لَها النَورُ ثَغرٌ وَالنَسيمُ لِسانُ",30,"ن",1,0],["ونْمِتَ عن الحوادثِ وهي يقظى","تُنازِعُنا المضاجعَ والثّيابا",31,"ب",2,0],["وَنَمَّت عَلَيكَ العَينُ في عَرَصاتِها","سَرائِرَ لَم يَنطِق بِهِنَّ عَريبُ",32,"ب",1,0],["وَنُمسِكُ بَعدَهُ بِذِنابِ عَيشٍ","أَجَبِّ الظَهرِ لَيسَ لَهُ سَنامُ",33,"م",1,0],["وَنَملُها إِن تَدِبَّ في جَسَدٍ","أَضَرُّ لِلنَفسِ مِن عَقارِها",34,"ه",2,0],["ونَمّ بِطَيْفِها السّاري جَوَادٌ","فجَنّبَنَا الزّيارَةَ والوِصَالا",35,"ل",2,0],["ونم الغداة وحسب روحك أن ثرى","من نور مجدك هذه الأوضاحا",36,"ح",2,0],["ونمدُّ للأيام كفَّ مصافحٍ","يجزي المسيءَ إليه بالإحسانِ",37,"ن",1,0],["ونمى ببيتكَ في المكارم والعُلا","يا ابن الكرام فروعُ مجدٍ تزهرُ",38,"ر",1,0],["وَنَمَّتْ بِهِ خَجْلَةٌ","تَدُلُّ عَلَى مَا اقْتَرَفْ",39,"ف",1,0],["ونمشي إن دعتْ صَفَاً فصفَاً","نصافحُ تحتَ رايتِها الوِئاما",40,"م",2,0],["ونما لنا شعبًا من ال","بدو الجفاة منظِّما",41,"م",2,0],["ونمزح كأس الراح تترع بيننا","شمولا بمعسول من الريق بارد",42,"د",1,0],["ونمطل بالعزم الزمان سفاهة","فيوم إلى يوم وشهر إلى شهر",43,"ر",1,0],["ونمْسَحُ أعطافَ الزَّمانِ لَعَلَّه","يعُودُ إلى عُتْباه من بعد عَتْبِه",44,"ب",2,0],["ونمشي كطفلين لم نكترث","بما أصلح الدهر الدهر أو أفسدا",45,"د",2,0],["ونمزجُ من ماء الفراتينِ جَرعة","بذكراهُ مما عبَّ من صفوه جرْعا",46,"ع",2,0],["ونما رفيعاً في ظلالٍ خلائفٍ","في ظلِّهمْ عاش القريضُ رفيعا",47,"ع",2,0],["ونمدّ أيدينا فترجع لم تصب","وتعود فوق قوبنا أيدينا",48,"ن",2,0],["ونملُها إن تدِبّ في جسدٍ،","أضرُّ للنّفس من عقارِبها",49,"ب",3,0],["ونمير منهله المرقرق نوعه","بعد الصفاء وورده مطروق",50,"ق",1,0],["ونم بالامن فالمولى","له في احمد سر",51,"ر",1,0],["ونما فضله فعم البرايا","بأيادي ندا يديه الطوال",52,"ل",1,0],["وَنَمنَعُ الضَيمَ مَن يَبغِي مَضامَتَنا","بِكُلِّ مُطَّرِدٍ في الكَفِّ مَسنونِ",53,"ن",1,0],["وَنَمدَحُهُ وَالقَلبُ طَوعُ اِرتياحِهِ","دوامُ المُنى في ذِكرِهِ واِمتِداحِهِ",54,"ه",1,0],["ونمهل مختارين لا نمهل امرءاً","تعدى ولا يفجا القنا أخذنا غبطا",55,"ط",2,0],["ونمتِ ليلُكِ مَكّ الطّرفِ عن دَنِفٍ","باكٍ بطرفٍ غزيرٍ الدمعِ غير بكي",56,"ك",2,0],["ونميمة النذل الوضي","عِ وفريةِ الوغد الزنيم",57,"م",1,0],["وَنَمَوْا أبا الفضل الذي بيمينه","فضلٌ على صَوْبِ الغمامِ المُرْهِم",58,"م",1,0],["ونمّت دموعي عن هيامى وأفصحت","أفي كل يوم في حياتي نمائم",59,"م",1,0],["ونمت بالحيا الغصون ولم","ينضر الدمع ذابل القد",60,"د",1,0],["ونملكهُ وما الأحياء إلا","أجيري هذه الدنيا عبيدا",61,"د",2,0],["ونمت به من ذي العلا بركاته","وزكت به صلواته وتكررت",62,"ت",1,0],["وَنَمَّقْتُ أَسْطَاراً عَلى ظَهْرِ مُهْرَقٍ","كَمَا رَاقَ تَطْرِيزٌ بِثَوْبٍ مُحَبَّرِ",63,"ر",1,0],["وَنَمَّقَ بالتَّرْقِيشِ صَفْحَةَ مَتْنِهِ","كَما نَمَّقَ القِرْطَاسَ حَبْرٌ مِنَ الحِْبْرِ",64,"ر",1,0],["ونمطره سحب الكاين كلما","يد البيض لاحت كالبروق الخوالب",65,"ب",1,0],["ونمزجهُ سخيناً حينَ كنّا","نُقَرِّبُ للتلائم وَجنَتينا",66,"ن",2,0],["ونمسي والنصر المبين يحفنا","فنجمع شملا شتته يد الوغد",67,"د",1,0],["وَنَماه عَمرٌو لِلعُلى وَمَهلهلٌ","لَبِمنزِلٍ ما نالَهُ مُتَناوِلُ",68,"ل",1,0],["ونم في أمانٍ بالحبيب ولا تخف","لقائط واشٍ من لقاء طواشي",69,"ي",1,0],["ونمضى كما جئنا نجر عفافنا","نلقن طهرَ الحبّ للزهر والعشب",70,"ب",1,0],["ونمضي ويمضي بنا مسرعاً","هوانا فندرج في الهاوية",71,"ي",2,0],["وَنَما فَأَوشك أَن يَمور تَخاسفا","وَأحقّ مِنهُ بأهله أَن يخفسا",72,"س",2,0],["ونَمَّ بسرِّ الهَوى أدمُعي","وما الدّمعُ إلاّ لسانُ الكَتوم",73,"م",1,0],["ونَمْنَم كافوراً بمِسْكٍ فَطِيبُه","إلى اليومِ باقٍ في يَدِي ليس يَنْفَد",74,"د",1,0],["وَنَمضي لَيالينا وَوَجهُكَ بَدرُها","فَهُنَّ المَواضي وَالبُدورُ تُقيمُ",75,"م",1,0],["وَنَما نورُها إِلى كُلِّ صُقعٍ","وَطَوَت ذيلَ سَجفِها الظَلماءُ",76,"ا",2,0],["ونمسي بها نمشي على خير ملة","على ملة المختار بالقلب والجسم",77,"م",1,0],["ونمسي بها في خير حال وعيشة","على الشكر للصحة والامن والخصب",78,"ب",1,0],["ونمسك يا ابن يحيى بالتُّقَى","إن ترد تظفر بالأمر الربيح",79,"ح",1,0],["ونمَّتْ على وَجدي دموعٌ أَرقتها","ولم يُبْقِ هذا الدَّمع سرًّا مكتما",80,"م",2,0],["ونمت أزاهير الرياض سحيرةً","فأحيى فوادي من حدائقها نشر",81,"ر",1,0],["ونما الضباب على الهضاب مغمما","قمم الجبال كأنه اكليل",82,"ل",1,0],["ونمّ عنك الدُجى لما استَتَرْتَ به","وعادةُ الليل ألا يَستُرَ القمرا",83,"ر",2,0],["ونمتُ عن عاذلي فولّى","عن نائمٍ في هواهُ ساهرْ",84,"ر",1,0],["ونمّ عليك الكاشحونَ وقبلَهُم","عليك الهوى قد نمّ لو نفع النَمُّ",85,"م",1,0],["ونمّقَ اليُمْن لي بُرود عُلا","تمنعني أن أحاولَ اليَمَنا",86,"ن",2,0],["ونَمَتْكَ من أَملاكِ يَعْرُبَ نَبْعَةٌ","تَلْوِي الكواكِبَ فِي ذُرى أَدْوَاحِها",87,"ح",3,0],["ونمى منكُمُ إِلَى المُلْكِ سيفٌ","نافذُ الحكمِ فِي رقابِ الأَعادِي",88,"د",2,0],["ونَماه مُلْكٌ لا يُضَعْضَعُ تاجُهُ","ووَقاهُ عِزٌّ لا يُخافُ خُمُولُهُ",89,"ل",2,0],["ونمارق مصفوفةٌ وزرابئ","مبثوثةٌ ومصوراً هلهالها",90,"ل",3,0],["وَنمَّت عن الفجر الجديد لشاعر","وَنمت عن الخلاَّق خلفَ المظاهرِ",91,"ر",1,0],["ونَمتْ من فرعها جوهرةٌ","أظهرَ الدهرُ بها مكنونَها",92,"ن",3,0],["ونمَّت قلوبٌ كاتماتٌ بسرّها","وطالعَ داءٌ في الضلوع دفينُ",93,"ن",1,0],["ونَمى على أعراقِ دوحتِهِ","ورَقٌ يرفّ ومجتنىً يحلي",94,"ل",2,0],["ونَمْ فقد حرَّمَها هذا الحمى","وضمَّها وهي دُخَان شاردُ",95,"د",1,0],["ونَمشِي على روضِ الحِمَى ثم نلتقي","فيبلُغني منها الغداةَ هبوبُ",96,"ب",1,0],["ونَمْ مُطْمَئناً إِنْ ظَفِرْتَ بِوِدِّهِ","فجارُ الثُّرَيَّا لا يُرَوَّعُ بالنَّبْلِ",97,"ل",1,0],["ونم إلينا دنها بضيائها","فكان كقلبٍ ضاق عن خطراته",98,"ت",2,0],["ونمْ أَميناً فإنَّ السَّعدَ خادِمُنا","وقد رَقَمْنا بوجهِ السَّعدِ إشْراقَا",99,"ق",2,0],["ونَمَّ عليَّ الدَّمعُ من صوتِ مَوْجِهِ","وعَرَّفَني بالعِشقِ وارِدُ خاطفي",100,"ف",2,0],["ونمت عليه زاكيات أصوله","كما نم بالإصباح معترض الفجر",101,"ر",1,0],["ونَمْ إذا شئتَ فإنّ الّذي","يرعاك فيها ليس بالنّائمِ",102,"م",1,0],["ونَمَتْنا من قريشٍ بُدورٌ","طالعاتٌ لا تُخاف مُحاقا",103,"ق",2,0],["ونمْ فإنّ جفوناً لِي مُسهّدةٌ","عُمْر اللّيالِي ولكنْ أيُّ تسهيدِ",104,"د",1,0],["وَنَمَتْهُمُ العَلْيَاءُ مِنْ","عَدْنَانَ وَالشَّرَفُ المُطِلُّ",105,"ل",1,0],["وَنمْ خَلِيّا وَقُلْ كَذا وَكذا","مِنْ كلّ ما أَطْلعَتْ تِلمسانُ",106,"ن",1,0],["ونمشي معاً للعلم لا غير كلنا","أكف رجال في أكف نساء",107,"ا",2,0],["ونمنمَ روضَهُ وكسا ثراهُ","بدَوحٍ تحتُهُ ظلٌّ مقيمُ",108,"م",1,0],["وَنمت بِها برَكاتُ أَوقافٍ رَوَت","مَصراً وَقَد فاضَت عَلى الحرمين",109,"ن",1,0],["وَنمسٌ أَشعثٌ قذرٌ كريهٌ","لَهُ مِن هَيبة اللَيث اضطراب",110,"ب",1,0],["وَنَما بهمته صَفاهْ","في عَصره بَيت القَصيدْ",111,"د",1,0],["وَنما حُبّ الرَعيهْ","في لَيال داوريهْ",112,"ه",1,0],["وَنَملأ أَرض اللَه في كُل جَلسة","صَلاحاً وَعَدلاً باجتهاد وَإِمعان",113,"ن",1,0],["وَنَما بِعنقي آخر في لَونه","وَصِفاته كَجَواهر الأَلماس",114,"س",1,0],["وَنما عز مَصره حينَ أَضحى","جَيشه في الصُفوف شاكي السِلاح",115,"ح",1,0],["ونمت قرير العين في خير عُصبة","كرام يهبون النفوس النفائسا",116,"س",2,0],["وَنَمَّ بِخَدّهِ الوَرْدِيّ صُدْغٌ","فَذَكَّرَنَا مَقَامَات الحَرِيرِي",117,"ر",2,0],["ونمت غصون الشوق في روض الحشا","وحنت على كبدي حنو المرضع",118,"ع",1,0],["ونمنم صدغ الأس خد شقيقه","فيا حسن ما أهدى الطراز المنمنم",119,"م",1,0],["ونم بأخبار الرياض عبيره","لذلك قد جاء الصبا يتبسم",119,"م",1,0],["وَنَمَّ بِرَوْضِ وَجْنَتِهِ عِذَارٌ","أرَى الرَّيْحَانَ في الوَرْدِ الجَنِيِّ",120,"ي",1,0],["وَنَمَّتْ بِأسْرَارِ الرُّبَى ألْسُنُ الشذَى","فَأدْمَتْ خُدُودَ الوَرْدِ أيْدِي النّسائمِ",121,"م",1,0],["وَنَما إِليهِ المجدُ من","بينِ البريّةِ وَاِنتَسب",122,"ب",1,0],["وَنمير الماءِ فيه السمّ قد","يَختفي والجمرُ يخفى في الرمادِ",123,"د",1,0],["ونمت بنا في الليل أنوار وجهه","فمد علينا من ذوائبه سترا",124,"ر",2,0],["ونماك بيت للنبوَّة باذخٌ","تتمرغُ الأحداقُ في عَتباتهِ",125,"ت",2,0],["ونمت على خطايا سالفات","ومثلي من تذكر ثم ناحا",126,"ح",2,0],["ونمو السر في طيبته","فاقصدنها من لسعى يستطيع",127,"ع",1,0],["وَنِمْتُ سُكْراً ونامَتْ لي مُعانِقَةً","فَلا تَسَلْ عَنْ عِناقِ الظَّبْي والذِّيبِ",128,"ب",1,0],["ونمى الحديث بأنهم نذروا دمي","أو لي دم يوم الفراق يراق",129,"ق",1,0],["ونم طرفي بأسراري فلا عجب","صبابة الحب قد جارت به فجري",130,"ر",2,0],["وَنمت سُكراً وَالعَجوز قائله","لا تَرقُدن قُلت اسكتي يا جاهله",131,"ه",1,0],["ونما الود لم ينل منه بعدٌ","غير ما نال ناطحُ الأحجار",132,"ر",1,0],["ونَما في العلاء غصنُ صِباه","وهو من ريّق المحاسنِ نَضر",133,"ر",1,0],["ونمنحهنَّ حقوق الحياةِ","فإن الرُّقيَّ بهنَّ يقومْ",134,"م",1,0],["ونمَتهُ آباءُ أُمٍّ حصانٍ","هيَ بيتُ القصيدِ في النسوانِ",135,"ن",1,0],["ونمَّت عليه من مديحك فَوحَةٌ","كما مَسَحت فوق الرياضِ جَنوب",136,"ب",1,0],["وَنمت وأجفان المحبة لم تنم","وأبعد ما حاولت نوم سليم",137,"م",1,0],["وَنَما فأَثمر في القلوب","فواكها وَتخلقا",138,"ق",2,0],["ونمنع جارنا مما منعنا","ذوات الدل منه والبنينا",139,"ن",2,0],["ونمت عليهم في السرى حيث يمموا","نوافح عن أنفاس دارين أغنتنا",140,"ن",2,0],["ونمارق وطنافس وأسرة","بمنازه الأمراء والأعيان",141,"ن",1,0],["وَنَمَى لنا المنصورُ فهوَ سَلِيلُهُ","وإمَامُ أمَّتِه فنِعمَ مُسِيمُهَا",142,"م",3,0],["وَنَمَّقنَ أعلى الوَجهِ نَقشاً كَأنَّهُ","شَظَايا فَتِيلِ اللَّيلِ في غُرَّةِ الصُّبحِ",143,"ح",1,0],["وَنِمنا على مَسرى الخُطوبِ وربَّما","تَوقَّت سَوامٌ رُتَّعٌ بَعضَ ما تَخشى",144,"ش",2,0],["وَنَمَّ إِلَينا دَنُّها بِضِيائِه","فَكانَ كَقَلبٍ ضاقَ عَن خَطَراتِهِ",145,"ت",2,0],["وَنِمْرَانَ قَد قَضَّيْتَ مِنْهُ حَزازَةً","عَلى حَنَقٍ يَوْمَ التِفَافِ القَبائِلِ",146,"ل",1,0],["ونما الى رومانيا من وصفها","ما هاجَ ساكن غيظها فتحدما",147,"م",2,0],["ونميم الصَّبا السقيم من الضع","ف خطاه عند الهبوب بطيّه",148,"ي",2,0],["ونمتُ وما نامت جفوني غدية","وتهتُ بلا تيهٍ عن الجن والإنسِ",149,"س",1,0],["ونما رجائي في شفاعته التي","يمحى بها ما جل من أوزاري",150,"ر",2,0],["وَنَم في بيوتِهِم وادِعاً","فَما لَكَ إِلّا عَناء مُعَن",151,"ن",1,0],["وَنِمتَ كَنَومِ الفَهدِ عَن ذي حَفيظَةٍ","أَكلتَ طَعاماً دونَهُ وَهوَ جائِعُ",152,"ع",1,0],["ونمَّ عليكَ احمرارُ الخدود","وما تحتويه ابتسامةُ ثغر",153,"ر",1,0],["ونم على صدرك لي ساعة","إني امرؤ أنكح جلاسي",154,"ي",1,0],["وَنَمَّ طَرَفي بِدَخيلِ الهَوى","فَصارَ ما أَسرَرتُ إِعلانا",155,"ن",2,0],["وَنَمنَعُ ما أَرادوا لا يُعانى","مُقيمٌ في المَحَلَّةِ وَسطَ قَسرِ",156,"ر",1,0],["ونمت فخال النوم انى ناظر","اليه وادنى داره دونها بصرا",157,"ر",2,0],["ونمت بينكم وبين بني مص","ر صلات الأحباب والجيران",158,"ن",1,0],["ونمشي مسيرتنا إن أردت","وإن عدت سجنا وعدت النزيلا",159,"ل",2,0],["ونماهما للمجد خير أبٍ له","قد دالت الدنيا بست جهاتها",160,"ت",3,0],["ونم كنوم الفهد او عبود عن","عيب الورى والظن لا تحقق",161,"ق",1,0],["ونَمَى خلفَهُ بَنِينَ كِراماً","ما قَضَى مَن نَمَى البَنِينَ الكِرامَا",162,"م",2,0],["ونمعن في التخاصم والنضال","ونفني العمر في قيل وقال",163,"ل",1,0],["ونمَّت على حالي دموع تساقطت","من الجفن حتى خُدَّ فيض لها خدي",164,"د",2,0],["وَنمَّ لَكَ النَّمام سراً مكتماً","عَن الجلنار الرَطب لَيسَ لَهُ نَشر",165,"ر",1,0],["ونَمَّ به جلدي وعظمي ومَفصِلي","وعبدي وبِرذَوني ونَضرَةُ حالي",166,"ل",2,0],["ونمدح المؤسسين الفطنا","كمدحنا من علمونا الفطنا",167,"ن",2,0],["ونما الشَّوق في فؤادي فضاقت","فيك عن وصف ما بي الأوراقُ",168,"ق",1,0],["ونملا برك ذاك العريض","بسارية الجيش والغاديه",169,"ي",2,0],["وَنَمتهُ لِلجودِ آباءُ صِدقٍ","وَجُدودٌ ما مِثلهم جُدودِ",170,"د",1,0],["وَنَمنَحُ مِنهُم مَعشَراً يَحسدونَنا","هَنِيَّ عَطاءٍ لَيسَ فيهِ تَنَدُّمُ",171,"م",1,0],["ونمَى فنمَّ لنا بأسرار الهوى","من حيث منزلةُ الظباءِ الغِيدِ",172,"د",1,0],["ونمرت حسنه الأغصان مثمرة","من نازع قرطا اولابس شنفا",173,"ف",2,0],["ونمسٌ ويربوعٌ وضب وقنفدٌ","وكلبٌ وخنزيرٌ وضبعٌ وسرحان",174,"ن",1,0],["ونُمنّي النفس في فاقتها","أن سَيملا الدهر كفّيها غناءَ",175,"ا",2,0],["وَنَموت من دون العلى","وَالمَجد أَو نَحيا مَعا",176,"ع",2,0],["ونمّ على ما قد تقدم قبلنا","فأفضل فعل العاملين خواتمه",177,"م",2,0],["ونِمْتِّمْ في المخافة عن رجالٍ","سُباتهم اذا أَمنوا غِرَارُ",178,"ر",1,0],["ونمى إليّ من العجائبِ أنّهُ","شَظّى كتائبَ جَمعِهِ المُتعاضِلِ",179,"ل",1,0],["ونمتك أَطهارٌ مطهرةٌ","وخلائفٌ آباؤُها الرسُلُ",180,"ل",1,0],["ونمته شيم غرٌّ إلى","آل ياسين الأُولى ه