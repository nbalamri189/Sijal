65,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[367,"زمانك يا مولى الكرام كريم","https://www.aldiwan.net/poem17277.html","الطويل"],[378,"بزغت في بروجها الأضواء","https://www.aldiwan.net/poem66989.html","الخفيف"],[392,"إلى الله أشكو ما بقلبي من الهم","https://www.aldiwan.net/poem54490.html","عموديه"],[392,"عسى نفحة الرحمن تأت من الرب","https://www.aldiwan.net/poem54626.html","عموديه"],[404,"فاروعني يا صفي الدين ما","https://www.aldiwan.net/poem33983.html","الرمل"],[417,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[430,"تجلت لدينا في محاسنها مصر","https://www.aldiwan.net/poem40262.html","الطويل"],[430,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[433,"وشى بسرك عرف الريح حين سرى","https://www.aldiwan.net/poem12442.html","البسيط"],[433,"طرفي في طاهر وكفي","https://www.aldiwan.net/poem12613.html","مخلع البسيط"],[433,"كتمت الهوى حتى أضر بك الكتم","https://www.aldiwan.net/poem12721.html","الطويل"],[433,"هبهم رضوا غير قلبه وطنا","https://www.aldiwan.net/poem12755.html","المنسرح"],[440,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[440,"بشر الخيل يوم كر الطراد","https://www.aldiwan.net/poem34856.html","الخفيف"],[440,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[442,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[454,"أخي وجمال الشعر ما أنت ناثر","https://www.aldiwan.net/poem61748.html","الطويل"],[459,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[459,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[459,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[459,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[459,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[462,"تأففت بالأيام ثم حمدتها","https://www.aldiwan.net/poem16250.html","الطويل"],[494,"صفحت لهذا الدهر عن سيئاته","https://www.aldiwan.net/poem67407.html","الطويل"],[501,"روق كؤوسك هذا الوقت قد راق","https://www.aldiwan.net/poem37939.html","البسيط"],[501,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[516,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[552,"لا تخش من غائلة فوضت","https://www.aldiwan.net/poem47195.html","السريع"],[552,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[552,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[568,"بي إن عززت علي ذل","https://www.aldiwan.net/poem69530.html","الكامل"],[587,"حتام حظي لديك حرمان","https://www.aldiwan.net/poem17778.html","المنسرح"]],"verses":[["ونملأ الأرض تبليغاً لمذهبهم","مجالساً صَفدّت فيها الشياطينا",0,"ن",2,0],["وَنَمى إِلَيَّ مِنَ العَجائِبِ أَنَّهُ","لَعِبَت بِعَقلِكَ حيلَةُ الخَوّانِ",1,"ن",1,1],["وَنِمتُ عَنِ الأَضغانِ حَتّى تَلاحَمَت","جَوائِفُ هاتيكَ النُدوبِ القَدائِمِ",2,"م",1,0],["وَنَم مُستَودَعاً صَوناً وَأَمناً","فَقَد أَسلَفتَها جَزَعاً وَذُلّا",3,"ل",2,0],["وَنَملِكُ أَعناقَ أَحداثِهِ","فَنُلبِسُها مِسحَلاً أَو عِذارا",4,"ر",2,0],["وَنُمسي بِآمالٍ طِوالٍ كَأَنَّنا","أَمِنّا بَياتَ الخَطبِ دونَ المَطالِبِ",5,"ب",1,0],["وَنِمتُ مُلقىً على سقطِ اللِّوى لِمَمي","وَنَفحَةُ المِسكِ تَسري في نواحيها",6,"ي",3,0],["وَنَمَّ ما تُظْهِرُهُ أَعْيُنٌ","مِنَّا بِما تُضْمِرُهُ أَضْلُعُ",7,"ع",1,0],["ونَماهُ أرْوَعُ عُودُهُ مِنْ نَبْعَةٍ","رَفّتْ على أعْراقِها الأفْنانُ",8,"ن",1,0],["وَنِمتِ خَلِيَّةً وَفَقَدتُ نَومي","أَما اِستَحيا رُقادُكِ مِن سُهادي",9,"د",2,0],["ونَمْزُجُ كأسَ الرّاحِ تُتْرَعُ بيْنَنا","شَمولاً بمَعْسولٍ من الرّيقِ بارِدِ",10,"د",1,0],["ونَمٍّ ظَنونٍ مُستَظَنٍّ مُلَعَّنٍ","لُحومُ الصَديقِ لَهوُهُ وَمآكِلُه",11,"ل",2,0],["وَنَمَت رَأيَهُ التَجارِبُ حَتّى","باتَ أَمضى مِن نافِذاتِ النِبالِ",12,"ل",1,0],["ونمضع في اليهاج الموت دون ال","علا مضغ الأوانس للعلوك",13,"ك",1,0],["ونَمنَعُ بالأَسِنَّةِ ما سَخِطنَا","مُكَابَرَةً ونَأخُذُ ما هَوِينَا",14,"ن",2,0],["وَنُمسِكُ عَن بَعضِ الأُمورِ مَهابَةً","فَيَعلَمُ مايُخفي الضَميرُ وَيَفهَمُ",15,"م",1,0],["ونمدح معتاد المديح وإنما","لكل امرئٍ من دهره ما تعودا",16,"د",2,0],["وَنَميمَةً مِن قانِصٍ مُتَلَبِّبٍ","في كَفِّهِ جَشءٌ أَجَشُّ وَأَقطُعُ",17,"ع",1,0],["وَنَمُدُّ أَيدِيَنا فَتَرجِعُ لَم تُصبِ","وَتَعودَ فَوقَ قُلوبِنا أَيدينا",18,"ن",2,0],["وَنَمدَحُ المَرءَ مِن خَزِّ مَلابِسِهِ","وَذَلِكَ الخَزُّ لَم تَنسُجُهُ كَفّاهُ",19,"ا",2,0],["وَنَمشي حُفاةً في ثَراها تَأَدُّباً","نَرى أَنَّنا نَمشي بِوادٍ مُقَدَّسِ",20,"س",1,0],["ونمرُّ مَا بَيْنَ المُروجِ الخُضْرِ","في سكر الشُّعورْ",21,"ر",1,0],["ونموت ثم نعود في","ادوارها بتسلسل",22,"ل",1,0],["وَنَموذَجٌ تَحذو عَلَيهِ وَلَم يَزَل","بِسَراتِهِم يَتَشَبَّهُ الأَقوامُ",23,"م",1,0],["ونَمْدَحُ أَقْواماً سِواكَ وإِنّما","إليكَ نُسَدِّيهِ وفيكَ نُزَخْرِفُهْ",24,"ه",1,1],["وَنَمتَحِنُ النُشّابَ في كُلِّ وابِلٍ","دَوِيُّ القِسِيِّ الفارِسِيَّةِ رَعدُهُ",25,"د",2,0],["وَنَمَتكَ مِن غَطَفانَ مُنجِبَةٌ","شَمسُ النَهارِ لِكامِلِ البَدرِ",26,"ر",1,0],["وَنَمنَعُ النَصفَ ذا الأَنفِ الأَشَمِّ إِذا","كانَ التَهَضُّمُ فيهِ العِزُّ وَالأَنَفُ",27,"ف",1,0],["ونَمنمةً تُضئُ له وتَخبُو","كما طَيَّرْتَ عن زَندٍ شَرارا",28,"ر",2,0],["وَنَمَت فُروعُ الدَوحِ حَتّى صافَحَت","كَفَلَ الكَثيبِ ذَوائِبُ الأَغصانِ",29,"ن",1,0],["وَنَمَّت بِأَسرارِ الرِياضِ خَميلَةٌ","لَها النَورُ ثَغرٌ وَالنَسيمُ لِسانُ",30,"ن",1,0],["ونْمِتَ عن الحوادثِ وهي يقظى","تُنازِعُنا المضاجعَ والثّيابا",31,"ب",2,0],["وَنَمَّت عَلَيكَ العَينُ في عَرَصاتِها","سَرائِرَ لَم يَنطِق بِهِنَّ عَريبُ",32,"ب",1,0],["وَنُمسِكُ بَعدَهُ بِذِنابِ عَيشٍ","أَجَبِّ الظَهرِ لَيسَ لَهُ سَنامُ",33,"م",1,0],["وَنَملُها إِن تَدِبَّ في جَسَدٍ","أَضَرُّ لِلنَفسِ مِن عَقارِها",34,"ه",2,0],["ونَمّ بِطَيْفِها السّاري جَوَادٌ","فجَنّبَنَا الزّيارَةَ والوِصَالا",35,"ل",2,0],["ونم الغداة وحسب روحك أن ثرى","من نور مجدك هذه الأوضاحا",36,"ح",2,0],["ونمدُّ للأيام كفَّ مصافحٍ","يجزي المسيءَ إليه بالإحسانِ",37,"ن",1,0],["ونمى ببيتكَ في المكارم والعُلا","يا ابن الكرام فروعُ مجدٍ تزهرُ",38,"ر",1,0],["وَنَمَّتْ بِهِ خَجْلَةٌ","تَدُلُّ عَلَى مَا اقْتَرَفْ",39,"ف",1,0],["ونمشي إن دعتْ صَفَاً فصفَاً","نصافحُ تحتَ رايتِها الوِئاما",40,"م",2,0],["ونما لنا شعبًا من ال","بدو الجفاة منظِّما",41,"م",2,0],["ونمزح كأس الراح تترع بيننا","شمولا بمعسول من الريق بارد",42,"د",1,0],["ونمطل بالعزم الزمان سفاهة","فيوم إلى يوم وشهر إلى شهر",43,"ر",1,0],["ونمْسَحُ أعطافَ الزَّمانِ لَعَلَّه","يعُودُ إلى عُتْباه من بعد عَتْبِه",44,"ب",2,0],["ونمشي كطفلين لم نكترث","بما أصلح الدهر الدهر أو أفسدا",45,"د",2,0],["ونمزجُ من ماء الفراتينِ جَرعة","بذكراهُ مما عبَّ من صفوه جرْعا",46,"ع",2,0],["ونما رفيعاً في ظلالٍ خلائفٍ","في ظلِّهمْ عاش القريضُ رفيعا",47,"ع",2,0],["ونمدّ أيدينا فترجع لم تصب","وتعود فوق قوبنا أيدينا",48,"ن",2,0],["ونملُها إن تدِبّ في جسدٍ،","أضرُّ للنّفس من عقارِبها",49,"ب",3,0],["ونمير منهله المرقرق نوعه","بعد الصفاء وورده مطروق",50,"ق",1,0],["ونم بالامن فالمولى","له في احمد سر",51,"ر",1,0],["ونما فضله فعم البرايا","بأيادي ندا يديه الطوال",52,"ل",1,0],["وَنَمنَعُ الضَيمَ مَن يَبغِي مَضامَتَنا","بِكُلِّ مُطَّرِدٍ في الكَفِّ مَسنونِ",53,"ن",1,0],["وَنَمدَحُهُ وَالقَلبُ طَوعُ اِرتياحِهِ","دوامُ المُنى في ذِكرِهِ واِمتِداحِهِ",54,"ه",1,0],["ونمهل مختارين لا نمهل امرءاً","تعدى ولا يفجا القنا أخذنا غبطا",55,"ط",2,0],["ونمتِ ليلُكِ مَكّ الطّرفِ عن دَنِفٍ","باكٍ بطرفٍ غزيرٍ الدمعِ غير بكي",56,"ك",2,0],["ونميمة النذل الوضي","عِ وفريةِ الوغد الزنيم",57,"م",1,0],["وَنَمَوْا أبا الفضل الذي بيمينه","فضلٌ على صَوْبِ الغمامِ المُرْهِم",58,"م",1,0],["ونمّت دموعي عن هيامى وأفصحت","أفي كل يوم في حياتي نمائم",59,"م",1,0],["ونمت بالحيا الغصون ولم","ينضر الدمع ذابل القد",60,"د",1,0],["ونملكهُ وما الأحياء إلا","أجيري هذه الدنيا عبيدا",61,"د",2,0],["ونمت به من ذي العلا بركاته","وزكت به صلواته وتكررت",62,"ت",1,0],["وَنَمَّقْتُ أَسْطَاراً عَلى ظَهْرِ مُهْرَقٍ","كَمَا رَاقَ تَطْرِيزٌ بِثَوْبٍ مُحَبَّرِ",63,"ر",1,0],["وَنَمَّقَ بالتَّرْقِيشِ صَفْحَةَ مَتْنِهِ","كَما نَمَّقَ القِرْطَاسَ حَبْرٌ مِنَ الحِْبْرِ",64,"ر",1,0],["ونمطره سحب الكاين كلما","يد البيض لاحت كالبروق الخوالب",65,"ب",1,0],["ونمزجهُ سخيناً حينَ كنّا","نُقَرِّبُ للتلائم وَجنَتينا",66,"ن",2,0],["ونمسي والنصر المبين يحفنا","فنجمع شملا شتته يد الوغد",67,"د",1,0],["وَنَماه عَمرٌو لِلعُلى وَمَهلهلٌ","لَبِمنزِلٍ ما نالَهُ مُتَناوِلُ",68,"ل",1,0],["ونم في أمانٍ بالحبيب ولا تخف","لقائط واشٍ من لقاء طواشي",69,"ي",1,0],["ونمضى كما جئنا نجر عفافنا","نلقن طهرَ الحبّ للزهر والعشب",70,"ب",1,0],["ونمضي ويمضي بنا مسرعاً","هوانا فندرج في الهاوية",71,"ي",2,0],["وَنَما فَأَوشك أَن يَمور تَخاسفا","وَأحقّ مِنهُ بأهله أَن يخفسا",72,"س",2,0],["ونَمَّ بسرِّ الهَوى أدمُعي","وما الدّمعُ إلاّ لسانُ الكَتوم",73,"م",1,0],["ونَمْنَم كافوراً بمِسْكٍ فَطِيبُه","إلى اليومِ باقٍ في يَدِي ليس يَنْفَد",74,"د",1,0],["وَنَمضي لَيالينا وَوَجهُكَ بَدرُها","فَهُنَّ المَواضي وَالبُدورُ تُقيمُ",75,"م",1,0],["وَنَما نورُها إِلى كُلِّ صُقعٍ","وَطَوَت ذيلَ سَجفِها الظَلماءُ",76,"ا",2,0],["ونمسي بها نمشي على خير ملة","على ملة المختار بالقلب والجسم",77,"م",1,0],["ونمسي بها في خير حال وعيشة","على الشكر للصحة والامن والخصب",78,"ب",1,0],["ونمسك يا ابن يحيى بالتُّقَى","إن ترد تظفر بالأمر الربيح",79,"ح",1,0],["ونمَّتْ على وَجدي دموعٌ أَرقتها","ولم يُبْقِ هذا الدَّمع سرًّا مكتما",80,"م",2,0],["ونمت أزاهير الرياض سحيرةً","فأحيى فوادي من حدائقها نشر",81,"ر",1,0],["ونما الضباب على الهضاب مغمما","قمم الجبال كأنه اكليل",82,"ل",1,0],["ونمّ عنك الدُجى لما استَتَرْتَ به","وعادةُ الليل ألا يَستُرَ القمرا",83,"ر",2,0],["ونمتُ عن عاذلي فولّى","عن نائمٍ في هواهُ ساهرْ",84,"ر",1,0],["ونمّ عليك الكاشحونَ وقبلَهُم","عليك الهوى قد نمّ لو نفع النَمُّ",85,"م",1,0],["ونمّقَ اليُمْن لي بُرود عُلا","تمنعني أن أحاولَ اليَمَنا",86,"ن",2,0],["ونَمَتْكَ من أَملاكِ يَعْرُبَ نَبْعَةٌ","تَلْوِي الكواكِبَ فِي ذُرى أَدْوَاحِها",87,"ح",3,0],["ونمى منكُمُ إِلَى المُلْكِ سيفٌ","نافذُ الحكمِ فِي رقابِ الأَعادِي",88,"د",2,0],["ونَماه مُلْكٌ لا يُضَعْضَعُ تاجُهُ","ووَقاهُ عِزٌّ لا يُخافُ خُمُولُهُ",89,"ل",2,0],["ونمارق مصفوفةٌ وزرابئ","مبثوثةٌ ومصوراً هلهالها",90,"ل",3,0],["وَنمَّت عن الفجر الجديد لشاعر","وَنمت عن الخلاَّق خلفَ المظاهرِ",91,"ر",1,0],["ونَمتْ من فرعها جوهرةٌ","أظهرَ الدهرُ بها مكنونَها",92,"ن",3,0],["ونمَّت قلوبٌ كاتماتٌ بسرّها","وطالعَ داءٌ في الضلوع دفينُ",93,"ن",1,0],["ونَمى على أعراقِ دوحتِهِ","ورَقٌ يرفّ ومجتنىً يحلي",94,"ل",2,0],["ونَمْ فقد حرَّمَها هذا الحمى","وضمَّها وهي دُخَان شاردُ",95,"د",1,0],["ونَمشِي على روضِ الحِمَى ثم نلتقي","فيبلُغني منها الغداةَ هبوبُ",96,"ب",1,0],["ونَمْ مُطْمَئناً إِنْ ظَفِرْتَ بِوِدِّهِ","فجارُ الثُّرَيَّا لا يُرَوَّعُ بالنَّبْلِ",97,"ل",1,0],["ونم إلينا دنها بضيائها","فكان كقلبٍ ضاق عن خطراته",98,"ت",2,0],["ونمْ أَميناً فإنَّ السَّعدَ خادِمُنا","وقد رَقَمْنا بوجهِ السَّعدِ إشْراقَا",99,"ق",2,0],["ونَمَّ عليَّ الدَّمعُ من صوتِ مَوْجِهِ","وعَرَّفَني بالعِشقِ وارِدُ خاطفي",100,"ف",2,0],["ونمت عليه زاكيات أصوله","كما نم بالإصباح معترض الفجر",101,"ر",1,0],["ونَمْ إذا شئتَ فإنّ الّذي","يرعاك فيها ليس بالنّائمِ",102,"م",1,0],["ونَمَتْنا من قريشٍ بُدورٌ","طالعاتٌ لا تُخاف مُحاقا",103,"ق",2,0],["ونمْ فإنّ جفوناً لِي مُسهّدةٌ","عُمْر اللّيالِي ولكنْ أيُّ تسهيدِ",104,"د",1,0],["وَنَمَتْهُمُ العَلْيَاءُ مِنْ","عَدْنَانَ وَالشَّرَفُ المُطِلُّ",105,"ل",1,0],["وَنمْ خَلِيّا وَقُلْ كَذا وَكذا","مِنْ كلّ ما أَطْلعَتْ تِلمسانُ",106,"ن",1,0]]}