{"poems":[[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43843","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122354","الكامل"],[1645,"","https://poetry.dctabudhabi.ae/diwan/poem/203406","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114271","الطويل"],[4791,"حبك سماها","https://www.poetsgate.com/ViewPoem.aspx?id=28418",""],[4802,"تضحك","https://www.poetsgate.com/ViewPoem.aspx?id=32678",""],[5198,"الصعاليك","https://www.poetsgate.com/ViewPoem.aspx?id=143702",""]],"verses":[["طُشتُ من الثكلِ يَومَ أَودى","وَأَصبَحَت ذروَتي بِساطا",0,"ط",2,0],["طشت لغيبتك الشموع واقفرت","تلك الربوع من الظباء الغيد",1,"د",1,0],["طشتمر الساقي سرى ظلمه","إلى بني الريّان لا عن سببْ",2,"ب",1,1],["طَشِيشُهُ كَافٍ مَن يُرِد حَصرَهُ غَدَا","كَبَاسِطِ كَفَّيهِ لِمَائِهِ وَاشتَطَا",3,"ط",2,0],["طش المطر يروي عطش ظامي البيد","وطش الوصل يحي النفوس وغلاها",4,"ا",3,0],["طشن بنات افكارها طشت اعاصير","وجتني ينثر ريح شعري شعرها",5,"ر",3,0],["طشيت غيم الشوق واسقيت اراضيك","طاريك يستسقي سحابة حنيني",6,"ن",2,0]]}