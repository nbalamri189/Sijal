{"poems":[[55,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[56,"أين محل الحي يا وادي","https://www.aldiwan.net/poem27596.html","السريع"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[63,"كبوة الهم بين كاس وكوب","https://www.aldiwan.net/poem51764.html","الخفيف"],[141,"خف من دار جيرتي","https://www.aldiwan.net/poem67982.html","مجزوء الخفيف"],[228,"في ليلة حالكة كالهموم","https://www.aldiwan.net/poem39701.html","السريع"],[333,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[358,"خلياني وصبوتي وشجوني","https://www.aldiwan.net/poem39775.html","الخفيف"],[385,"أسلموني لسهادي","https://www.aldiwan.net/poem48796.html","مجزوء الرمل"],[435,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[466,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[580,"تجنى لواحظه وتستعدي","https://www.aldiwan.net/poem2971.html","أحذ الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63724","الخفيف"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130695","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77396","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93812","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136865",""],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35058","الخفيف"],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""]],"verses":[["بَينَ خِصافَي نَعلِهِ شَوكَةٌ","إِن شَدَّدَ الوَطءَ عَلَيها دَمي",0,"م",2,0],["بَينَ خُدورِ الظُعنِ مَحجوبَةٌ","حَدا بِقَلبي مَعَها الحادي",1,"د",2,0],["بين خلقِ الضئيلة الشَّختةِ الجسْ","مِ وخلق الثقيلة المِبْدان",2,"ن",1,0],["بينَ خيلٍ من المُدامةِ قَرَّبْ","نَ إليَّ السرورَ بالتقريبِ",3,"ب",1,0],["بَينَ خَمسٍ كَواعِبٍ","أَكرَمُ الجِنسِ جِنسُها",4,"س",3,0],["بَينَ خفوقَ القَلبِ وَالتَمتَمَه","وَراءَ في قَلبِ الدُجى والِدَه",5,"ه",1,0],["بين خمر رخيصة وأغان","ساقطاتٍ تجرى على غير لحن",6,"ن",1,0],["بين خذها وهاتِها ولكم يج","مل بؤس الحياة في خذ وهات",7,"ت",1,0],["بَينَ خودٍ لَها الهِلالُ قَرين","لاحَ مِن فَوق حاجب مَقرونِ",8,"ن",1,0],["بَينَ خلّان وَنَدما","ن وَعيدان وَشادي",9,"د",2,0],["بين خطي قامة وحسامٍ","من جفون أربت على الصمصامه",10,"م",2,0],["بين خوّاضِ غِمارٍ باسِلٍ","ومُطاعٍ في نديٍّ مُحْتفِلْ",11,"ل",1,0],["بَيْنٌ خرجتُ عليه من جَلَدِي","ولئن رجعْتُ خرجْتُ عن خَلدِي",12,"د",2,0],["بين خدٍّ مُعَصْفَرٍ","وشرابٍ معصفر",13,"ر",1,0],["بينَ خِلانٍ بهم صَفُو الزَّمَن","عَقَرُوا الهمَّ بِسَيفٍ ذِي فِقار",14,"ر",1,0],["بَينَ خَيلَينِ مَيسِرٌ وَيَسارُ","كُلُّ آمالِ مِصرَ نَقعٌ مُثار",15,"ر",1,1],["بين خيل تسابق الطير لكن","مالها من قوادم أو خوافي",16,"ف",2,0],["بين خد الساقي وورد جناها","من فنون البديع نوع الجناس",17,"س",1,0],["بين خلان ما فيهم خلل وأي خلان","قوم ما بعد واحد منهم أخنا ولا خان",18,"ن",1,0],["بَين خلقٍ نعدّ ذا السعدَ فيه","وَنعدّ المَألوم والمسكينا",19,"ن",2,0],["بين خوف من قادم وهموم","ضاق بالكون رغم كل اتساع",20,"ع",1,0],["بين خضر التلال فوق الخيالِ","حلّ بدراً ما بين أعلا الجبالِ",21,"ل",1,1]]}