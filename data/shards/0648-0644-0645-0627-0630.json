{"poems":[[55,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[55,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[53,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[53,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[53,"أنا واش بسوء حالي إليكا","https://www.aldiwan.net/poem66729.html","البسيط"],[31,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[47,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[102,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[102,"خطرات","https://www.poetsgate.com/ViewPoem.aspx?id=50194",""],[102,"لص تحت الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=50429",""],[102,"في وجه الغزوة الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=50422",""],[102,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[102,"أحزان .. وإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=50332",""],[92,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[53,"أنا واش بسوء حالي إليكا","https://www.poetsgate.com/ViewPoem.aspx?id=30715",""],[190,"أطفأت نار المنى بباسي","https://www.aldiwan.net/poem43722.html","مخلع البسيط"],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[230,"بعض هذا الجفاء والعدوان","https://www.aldiwan.net/poem55111.html","الخفيف"],[231,"الغيرة","https://www.aldiwan.net/poem24242.html","عموديه"],[234,"يا عذبة الوصل والصدود ويا","https://www.aldiwan.net/poem50759.html","المنسرح"],[266,"هل المجد إلا دوحة أنت فرعها","https://www.aldiwan.net/poem38142.html","الطويل"],[303,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[303,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[321,"مالك موفور فما باله","https://www.aldiwan.net/poem69425.html","السريع"],[385,"تورد الدمع من توريد وجنته","https://www.aldiwan.net/poem48819.html","البسيط"],[399,"أجراس سوداء","https://www.aldiwan.net/poem17746.html","عموديه"],[406,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[406,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[406,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[411,"وإذا ضمت الكفاية قوما","https://www.aldiwan.net/poem50089.html","الخفيف"],[435,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[438,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[458,"أيها الشعب لماذا تنتحر","https://www.aldiwan.net/poem61615.html","الرمل"],[458,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[500,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[556,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[556,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[572,"مالك موفور فما باله اكسبك","https://www.aldiwan.net/poem69501.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101506","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38892","الطويل"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142203","الرمل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75796","الخفيف"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132411","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120083","الكامل"],[1462,"","https://poetry.dctabudhabi.ae/diwan/poem/96470","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48952","الخفيف"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36187","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87828","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108462","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77202","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76030","الطويل"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199886","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204578","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138465",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108123","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36733","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44890","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86352","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54480","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94842","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94463","الوافر"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35054","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104528","الرمل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147301","الرمل"],[4755,"التَّمِيمة","https://www.poetsgate.com/ViewPoem.aspx?id=208979",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4929,"العمر بشَعري يحترق","https://www.poetsgate.com/ViewPoem.aspx?id=202408",""],[4994,"قصيدةٌ بلّلها موتاً دم الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=211084",""],[4119,"كيف قلتم ما عند عينيه ثار","https://www.poetsgate.com/ViewPoem.aspx?id=16142",""],[585,"سل عن الكون من يحير جواباً","https://www.poetsgate.com/ViewPoem.aspx?id=161882",""],[5121,"عِرَاقُ الْإِبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=209030",""],[5136,"ما له ذاب لوعة وغراما","https://www.poetsgate.com/ViewPoem.aspx?id=121660",""],[5299,"رسالة من الحدود","https://www.poetsgate.com/ViewPoem.aspx?id=210541",""],[5351,"المتناقض","https://www.poetsgate.com/ViewPoem.aspx?id=202233",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5491,"قهوة العطر","https://www.poetsgate.com/ViewPoem.aspx?id=215173",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5899,"من أجلكِ","https://www.poetsgate.com/ViewPoem.aspx?id=31523",""],[5956,"قصة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=192417",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[5957,"ولماذا اليأس يتناثر؟","https://www.poetsgate.com/ViewPoem.aspx?id=189869",""],[5973,"ولماذا الخصام؟","https://www.poetsgate.com/ViewPoem.aspx?id=15893",""],[6102,"ريما","https://www.poetsgate.com/ViewPoem.aspx?id=184167",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6233,"موكب ... لحرية الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78453&r=&rc=16",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""],[6344,"رجع من شفة الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87978&r=&rc=18",""],[572,"مَالُكَ موفورٌ فما بالُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9465&r=&rc=322",""]],"verses":[["وَلَم أَذمُم طُلوعَكَ بي لِشَيءٍ","سِوى قُربِ الطُلوعِ إِلى شَعوبِ",0,"ب",1,0],["وَلَمّا ذَكَرتُكِ حَنَّ الفُؤا","دُ وَاِعتَلَّ في مُقلَتَيَّ الكَرى",1,"ا",1,0],["ولَمَا ذاك خِيفتي جَنَفَ القا","ضي ولا أنَّني غدوتُ مُريبا",2,"ب",2,0],["وَلَما ذاك للِّئامِ بفَخْرٍ","لا ولا ذاك للكرام بعابِ",3,"ب",1,0],["ولَمَا ذَاكَ أَنَّني الرجلُ الشِّر","رِيرُ منِّي الخَنَا ومنِّي الوُثُوبَ",4,"ب",1,0],["ولماذا يَغُولكُمْ غائل الدهْ","رِ وأنتُمْ عمادهُ من عمادِهْ",5,"د",2,0],["ولماذا تردُّها عن هواها","جثةٌ فَدْمةٌ وعقلٌ نهيك",6,"ك",1,0],["ولما ذاكَ بالعقاب ولكن","بالثواب الذي يُرجَّى ليدكا",7,"ك",2,0],["وَلَمّا ذَرَعنَ الأَرضَ تِسعينَ غَلوَةً","تَمَطَّرَتِ الدَهماءُ بِالصَلَتانِ",8,"ن",1,0],["وَلِماذا المَرءُ لا يَدري مَتى وَقتُ الرَحيل","وَمَتى يَنكَشِفُ السِرُّ فَيَدري لَستُ أَدري",9,"ي",1,0],["وَلِماذا الخِشيَةُ وَالقَلَقُ","وَالخَلقُ أَحَبَّهُمُ الطِفلُ",10,"ل",1,0],["ولماذا لك جا","زى على ما حملك",11,"ك",1,0],["ولماذا بعد ما","لك احيا قتلك",11,"ك",1,0],["وَلِماذا تَتَبَّعُ النَفسُ شَيئاً","جَعَلَ اللَهُ الفِردَوسَ مِنهُ بَواءَ",12,"ا",2,0],["ولماذا لم تسألا عن ضميري","والفتى من يعف منه الضمير",13,"ر",1,0],["ولماذا لم تسألا عن جهادي","في سبيل الحقوق وهو شهير",13,"ر",1,0],["ولماذا لم تسألا عن ذيادي","عن بلادي أيامَ عز النصير",13,"ر",1,0],["ولماذا لم تسألا عن وفائي","ووفائي لمن صحبت كثير",13,"ر",1,0],["ولماذا لم تسألا عن مساعي","يَ لإبطال الشرِّ وهو خطير",13,"ر",1,0],["وَلِمَاذَا نَفْخ المَلاَئِكِ فِي الصُّو","رِ وَفِيمَ التَّسْبِيحُ وَالتَّرْتِيلُ",14,"ل",1,0],["ولِماذا ازدَدتَ إشداقًا وما","زِدتَ أرضًا هَشَّةً تَمتَصُّ طَفْحَك",15,"ك",1,0],["ولماذا لا تَراني زائرًا؟","قالَ بَيَّاعُ الهَدايا: ما أَشَحَّك",15,"ك",1,0],["ولماذا نجني المنايا ... بأيدينا º","ونرمي الحياة في الترب تربا ؟",16,"ب",2,0],["ولماذا أحمد من يبدو","فرحا من عيشته ممتن؟",17,"ن",1,0],["ولماذا لا تبلع الصوت ؟.. عفوا","من توقّى إرهابهم ، زاد رهبه",18,"ب",2,0],["ولماذا أخاف؟ أصبحَ منهم","زوج أختي وعمتي وشقيقي",19,"ق",2,0],["ولماذا ينطفي أحبابنا","قبل أن يستنفد الزيت الذبال ؟",20,"ل",1,0],["ولماذا تُهيِّجِين من الشاعِر","أغفى إحساسُهُ ، بركانه",21,"ن",2,0],["ولما ذاكَ بالعقاب ولكن","بالثواب الذي يُرجَّى لديكا",22,"ك",2,0],["ولم أذم البخيل لمّا","شحّ فألوى ولم يُواس",23,"س",1,0],["وَلِماذا إِن يجِئ ذكرُ العقيق","لَستُ أُجريهِ بدمعٍ كالغمام",24,"م",1,0],["وَلِماذا تَمَخَّضَ السِلمُ عَن حَر","بٍ لَظاها يَشوي الوجوهَ عَوانِ",25,"ن",1,0],["ولماذا الوقار والصمت يضفي","بعدما كنت لي مراحا ووثباً ؟",26,"ب",2,0],["ولم أَذُقْه ولا سَمِعتُ بمَنْ","ذاقَ ولكِنّه كذا ظَنِّي",27,"ن",2,0],["ولم اذكر البقيا بها ولياليا","تقضت عسى يلتام بالذكر صدعها",28,"ع",3,0],["وَلما ذَرَّ قرنُ الشمسِ أَنشا","يطالبها بإِنجازِ الوعود",29,"د",1,0],["ولم أذنبْ وَما قارفتُ إثْماً","سوى أني وَصلتُ بكُمْ حِبالي",30,"ل",2,0],["ولم إذا جئت نهضنا وان","جئتا تطاولت ولم تتمم",31,"م",1,0],["وَلَم أَذُقهُ وَلَو قَد ذُقتَهُ لَشفي","قَلبي المَعنى بِهِ مِن حَر غَلتِهِ",32,"ت",2,0],["ولماذا نبقى هنا؟ أوَلم نش","بعْ ونضجرْ ونروَ دونَ انتهاءِ؟",33,"ا",2,0],["ولماذا نبقى هنا؟ أسمعُ المو","تَ ينادي بنا فلمْ لا نُجيبُ؟",33,"ب",1,0],["ولماذا يا فؤادي تشتكي","ولماذا يا دموعي تَذرفين؟",34,"ن",1,0],["ولماذا يا حروفَ الشعر عن","سرِّ آلام فؤادي تكشفين",34,"ن",1,0],["ولماذا لا يدفعون المناي","حين تأتي، ويكشفون الحجابا؟!",35,"ب",2,0],["ولماذا لا يصمُدون، إذا م","حرَّك البحرُ موجَه الصَّخَّابا؟!",35,"ب",2,0],["ولماذا لا تَتْبَعين رسول","مَلأَ الأرضَ حكمةً وصوابا؟",35,"ب",2,0],["ولماذا أضلَّها الوَهْمُ حتّى","أسلمتْها يداه للإِخفاقِ؟",36,"ق",1,0],["ولماذا أُخِّرتُ من غَيِرِ نقص","عن أُناسٍ هُمُ عِيَابُ العُيُوبِ",37,"ب",1,0],["ولما ذاق خمر التيه عجبا","فنادانا هلموا للسرورِ",38,"ر",1,0],["ولماذا أَخَفْتَنِي بالقِلَى وَهْ","وَ لِنَفْسِي أَحبّه دُونَ إِلفى",39,"ف",2,0],["ولماذا أنت تلهو بالخطر","بَدَل الحزم لإحرازِ الوطر",40,"ر",1,0],["ولماذا فجأةً قد انتهت","فتساوت في ابتداءٍ وانتهاء",41,"ا",2,0],["ولما ذاقها والطعم مر","وقوس الظهر ظاهرة الوضوم",42,"م",1,0],["ولمّا ذكرتُ الموتَ يوماً وهَوْلَهُ","تقاصرَ خَطْوِي واِقشعرّ جميعي",43,"ع",2,0],["ولماذا أسمو بنفسي إِذا ما","راعها في زماننا ما يروعُ",44,"ع",1,0],["وَلِمَ إِذَا جِئْتَ نَهَضْنَا وَإِنْ","جِئْنَا تَطَاوَلْتَ وَلَمْ تُتْمِمِ",45,"م",1,0],["ولم أذكر سوى نزر فباقي","مآثرهن ملء مجلدات",46,"ت",1,0],["ولماذا للقظة هي حقٌّ","لا كأفعى قد خادعَت حواءَ",47,"ا",2,0],["وَلَمّا ذَكَت نارُ الغَرامِ بِمُهجَتي","فَفي شررٍ منها عيونيَ تقدحُ",48,"ح",1,1],["ولماذا لا تجاري فرحا","حالت الأيام ما بيني وبينه",49,"ن",2,0],["وَلماذا ناشدتك اللَه تبدي","خطلا للَّذي أَراد اِع