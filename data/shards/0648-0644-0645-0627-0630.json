{"poems":[[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[53,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"أنا واش بسوء حالي إليكا","https://www.aldiwan.net/poem66729.html","البسيط"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[45,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[51,"أنا واش بسوء حالي إليكا","https://www.poetsgate.com/ViewPoem.aspx?id=30715",""],[184,"أطفأت نار المنى بباسي","https://www.aldiwan.net/poem43722.html","مخلع البسيط"],[187,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[223,"بعض هذا الجفاء والعدوان","https://www.aldiwan.net/poem55111.html","الخفيف"],[224,"الغيرة","https://www.aldiwan.net/poem24242.html","عموديه"],[227,"يا عذبة الوصل والصدود ويا","https://www.aldiwan.net/poem50759.html","المنسرح"],[259,"هل المجد إلا دوحة أنت فرعها","https://www.aldiwan.net/poem38142.html","الطويل"],[296,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[296,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[314,"مالك موفور فما باله","https://www.aldiwan.net/poem69425.html","السريع"],[377,"تورد الدمع من توريد وجنته","https://www.aldiwan.net/poem48819.html","البسيط"],[391,"أجراس سوداء","https://www.aldiwan.net/poem17746.html","عموديه"],[397,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[397,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[397,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[402,"وإذا ضمت الكفاية قوما","https://www.aldiwan.net/poem50089.html","الخفيف"],[426,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[429,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[451,"أيها الشعب لماذا تنتحر","https://www.aldiwan.net/poem61615.html","الرمل"],[451,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[493,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[549,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[549,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[565,"مالك موفور فما باله اكسبك","https://www.aldiwan.net/poem69501.html","السريع"]],"verses":[["وَلَم أَذمُم طُلوعَكَ بي لِشَيءٍ","سِوى قُربِ الطُلوعِ إِلى شَعوبِ",0,"ب",1,0],["وَلَمّا ذَكَرتُكِ حَنَّ الفُؤا","دُ وَاِعتَلَّ في مُقلَتَيَّ الكَرى",1,"ا",1,0],["ولَمَا ذاك خِيفتي جَنَفَ القا","ضي ولا أنَّني غدوتُ مُريبا",2,"ب",2,0],["وَلَما ذاك للِّئامِ بفَخْرٍ","لا ولا ذاك للكرام بعابِ",3,"ب",1,0],["ولَمَا ذَاكَ أَنَّني الرجلُ الشِّر","رِيرُ منِّي الخَنَا ومنِّي الوُثُوبَ",4,"ب",1,0],["ولماذا يَغُولكُمْ غائل الدهْ","رِ وأنتُمْ عمادهُ من عمادِهْ",5,"د",2,0],["ولماذا تردُّها عن هواها","جثةٌ فَدْمةٌ وعقلٌ نهيك",6,"ك",1,0],["ولما ذاكَ بالعقاب ولكن","بالثواب الذي يُرجَّى ليدكا",7,"ك",2,0],["وَلَمّا ذَرَعنَ الأَرضَ تِسعينَ غَلوَةً","تَمَطَّرَتِ الدَهماءُ بِالصَلَتانِ",8,"ن",1,0],["وَلِماذا المَرءُ لا يَدري مَتى وَقتُ الرَحيل","وَمَتى يَنكَشِفُ السِرُّ فَيَدري لَستُ أَدري",9,"ي",1,0],["وَلِماذا الخِشيَةُ وَالقَلَقُ","وَالخَلقُ أَحَبَّهُمُ الطِفلُ",10,"ل",1,0],["ولماذا لك جا","زى على ما حملك",11,"ك",1,0],["ولماذا بعد ما","لك احيا قتلك",11,"ك",1,0],["وَلِماذا تَتَبَّعُ النَفسُ شَيئاً","جَعَلَ اللَهُ الفِردَوسَ مِنهُ بَواءَ",12,"ا",2,0],["ولماذا لم تسألا عن ضميري","والفتى من يعف منه الضمير",13,"ر",1,0],["ولماذا لم تسألا عن جهادي","في سبيل الحقوق وهو شهير",13,"ر",1,0],["ولماذا لم تسألا عن ذيادي","عن بلادي أيامَ عز النصير",13,"ر",1,0],["ولماذا لم تسألا عن وفائي","ووفائي لمن صحبت كثير",13,"ر",1,0],["ولماذا لم تسألا عن مساعي","يَ لإبطال الشرِّ وهو خطير",13,"ر",1,0],["وَلِمَاذَا نَفْخ المَلاَئِكِ فِي الصُّو","رِ وَفِيمَ التَّسْبِيحُ وَالتَّرْتِيلُ",14,"ل",1,0],["ولِماذا ازدَدتَ إشداقًا وما","زِدتَ أرضًا هَشَّةً تَمتَصُّ طَفْحَك",15,"ك",1,0],["ولماذا لا تَراني زائرًا؟","قالَ بَيَّاعُ الهَدايا: ما أَشَحَّك",15,"ك",1,0],["ولماذا أخاف؟ أصبحَ منهم","زوج أختي وعمتي وشقيقي",16,"ق",2,0],["ولماذا تُهيِّجِين من الشاعِر","أغفى إحساسُهُ ، بركانه",17,"ن",2,0],["ولما ذاكَ بالعقاب ولكن","بالثواب الذي يُرجَّى لديكا",18,"ك",2,0],["ولم أذم البخيل لمّا","شحّ فألوى ولم يُواس",19,"س",1,0],["وَلِماذا إِن يجِئ ذكرُ العقيق","لَستُ أُجريهِ بدمعٍ كالغمام",20,"م",1,0],["وَلِماذا تَمَخَّضَ السِلمُ عَن حَر","بٍ لَظاها يَشوي الوجوهَ عَوانِ",21,"ن",1,0],["ولماذا الوقار والصمت يضفي","بعدما كنت لي مراحا ووثباً ؟",22,"ب",2,0],["ولم أَذُقْه ولا سَمِعتُ بمَنْ","ذاقَ ولكِنّه كذا ظَنِّي",23,"ي",1,0],["ولم اذكر البقيا بها ولياليا","تقضت عسى يلتام بالذكر صدعها",24,"ع",3,0],["وَلما ذَرَّ قرنُ الشمسِ أَنشا","يطالبها بإِنجازِ الوعود",25,"د",1,0],["ولم أذنبْ وَما قارفتُ إثْماً","سوى أني وَصلتُ بكُمْ حِبالي",26,"ل",2,0],["ولم إذا جئت نهضنا وان","جئتا تطاولت ولم تتمم",27,"م",1,0],["وَلَم أَذُقهُ وَلَو قَد ذُقتَهُ لَشفي","قَلبي المَعنى بِهِ مِن حَر غَلتِهِ",28,"ت",2,0],["ولماذا نبقى هنا؟ أوَلم نش","بعْ ونضجرْ ونروَ دونَ انتهاءِ؟",29,"ا",2,0],["ولماذا نبقى هنا؟ أسمعُ المو","تَ ينادي بنا فلمْ لا نُجيبُ؟",29,"ب",1,0],["ولماذا يا فؤادي تشتكي","ولماذا يا دموعي تَذرفين؟",30,"ن",1,0],["ولماذا يا حروفَ الشعر عن","سرِّ آلام فؤادي تكشفين",30,"ن",1,0],["ولماذا لا يدفعون المناي","حين تأتي، ويكشفون الحجابا؟!",31,"ب",2,0],["ولماذا لا يصمُدون، إذا م","حرَّك البحرُ موجَه الصَّخَّابا؟!",31,"ب",2,0],["ولماذا لا تَتْبَعين رسول","مَلأَ الأرضَ حكمةً وصوابا؟",31,"ب",2,0],["ولماذا أضلَّها الوَهْمُ حتّى","أسلمتْها يداه للإِخفاقِ؟",32,"ق",1,0],["ولماذا أُخِّرتُ من غَيِرِ نقص","عن أُناسٍ هُمُ عِيَابُ العُيُوبِ",33,"ب",1,0],["ولما ذاق خمر التيه عجبا","فنادانا هلموا للسرورِ",34,"ر",1,0],["ولماذا أَخَفْتَنِي بالقِلَى وَهْ","وَ لِنَفْسِي أَحبّه دُونَ إِلفى",35,"ف",2,0],["ولماذا أنت تلهو بالخطر","بَدَل الحزم لإحرازِ الوطر",36,"ر",1,0],["ولماذا فجأةً قد انتهت","فتساوت في ابتداءٍ وانتهاء",37,"ا",2,0],["ولما ذاقها والطعم مر","وقوس الظهر ظاهرة الوضوم",38,"م",1,0],["ولمّا ذكرتُ الموتَ يوماً وهَوْلَهُ","تقاصرَ خَطْوِي واِقشعرّ جميعي",39,"ي",1,0],["ولماذا أسمو بنفسي إِذا ما","راعها في زماننا ما يروعُ",40,"ع",1,0],["وَلِمَ إِذَا جِئْتَ نَهَضْنَا وَإِنْ","جِئْنَا تَطَاوَلْتَ وَلَمْ تُتْمِمِ",41,"م",1,0]]}