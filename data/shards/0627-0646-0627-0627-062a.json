{"poems":[[29,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[30,"ولو لقيت الذي تكنى بكنيته","https://www.aldiwan.net/poem5222.html","البسيط"],[46,"لامته لام عشيرها وحميمها","https://www.aldiwan.net/poem30348.html","الكامل"],[92,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[107,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[107,"إنا أتينا بالثناء نسوقه","https://www.aldiwan.net/poem43402.html","الكامل"],[128,"ليلاي ليلاي إن الدهر أشقانا","https://www.aldiwan.net/poem23775.html","البسيط"],[228,"أطفىء ضياك وأظلم مثل إظلامي","https://www.aldiwan.net/poem41594.html","البسيط"],[290,"قصر البخاري هل يممت يا صاح","https://www.aldiwan.net/poem39370.html","البسيط"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44802","السريع"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124323",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27271","الرمل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47151","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67276","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74069","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111469","الطويل"],[4764,"قهرت الغير","https://www.poetsgate.com/ViewPoem.aspx?id=29790",""],[4802,"مجتمع كان","https://www.poetsgate.com/ViewPoem.aspx?id=34319",""],[4852,"عزٌ شقي","https://www.poetsgate.com/ViewPoem.aspx?id=214394",""],[4852,"السلام على أقوالهم","https://www.poetsgate.com/ViewPoem.aspx?id=214610",""],[4858,"سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=34882",""],[4961,"خمس دقائق قبل وصول العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=33331",""],[5138,"تعودنا","https://www.poetsgate.com/ViewPoem.aspx?id=195374",""],[5848,"على كيفك","https://www.poetsgate.com/ViewPoem.aspx?id=53158",""],[514,"إِلَّا إِلَيكَ تَسَابَقنَا إِلَى الغَرَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=155918",""],[5956,"إذا لم تنادي حبيبي تعال","https://www.poetsgate.com/ViewPoem.aspx?id=182201",""],[5956,"أمامَ جمالك","https://www.poetsgate.com/ViewPoem.aspx?id=182649",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[5997,"حوار شعري","https://www.poetsgate.com/ViewPoem.aspx?id=214369",""],[6115,"الناس ذا الوقت ياحاقد ويا حاسد","https://www.poetsgate.com/ViewPoem.aspx?id=180502",""]],"verses":[["إِنّا أَتَيناكَ نَرجو مِنكَ نافِلَةً","مِن رَملِ يَبرينَ إِنَّ الخَيرَ مَطلوبُ",0,"ب",1,0],["إِنّا أَتَيناكَ إِذ حَلَّت بِساحَتِنا","مِنَ السِنينَ عَضوضٌ تَفلِقُ الحَجَرا",1,"ر",2,0],["إِنّا أَتَيناكُم نَصونُ مَآرِباً","يَستَصغِرُ الحَدَثَ العَظيمَ عَظيمُها",2,"م",3,0],["إنا أتيناكِ من أرضٍ ملائكُها","بالعُهِر تُرجم أو تُرضي الشياطينا",3,"ن",2,0],["إنّا اتّبعنا فيك آثارَ الأُلى","جعلوا كتابَكَ سُنّةً ومنارا",4,"ر",2,0],["إِنّا أَتَينا بِالثَناءِ نَسوقُهُ","جَلَلاً يَهُزُّ دَوِيُّهُ الأَقطارا",5,"ر",2,1],["إنا أَتيناك من بدو ومن حضر","نسعى إليك وقد كلت مطايانا",6,"ن",2,0],["إِنّا أَتَّحَدنا لِيَومٍ واحِدٍ وَغَداً","يَأتي فَيخلفني قَومٌ بِحُبِّهِمِ",7,"م",1,0],["إنا أتيناه والحزب الجليل به","قد صف ليلاً ولكن الهوا صاح",8,"ح",1,0],["أَنا أَتانيَ وَلَم أَرضَ أَن","أَرى عَلى قَلبِكِ غَيري مَليكْ",9,"ك",1,0],["إنا أتيناك خوفاً أن تُرى غَرِقاً","يا من بك الفقر كاد اليوم يفتقر",10,"ر",1,0],["أنا أتلو من تسامتْ","ذاتُه عنِ العيانِ",11,"ن",1,0],["إنّا أتيناك في ظُلْمٍ لأنفسنا","مستغفرين من الأثقال في وَجَلِ",12,"ل",1,0],["إنّا اتخذناكَ مقداماً لنا وسند","أقبلْ وعجَّل قد اخضرّ الجنابُ وقد",13,"د",1,0],["إِنّا اِتخذنا ديننا اِستقلالنا","وَلَقَد عبدنا اللَه لا أَصناما",14,"م",2,0],["أَنا أَتنَقَّاهُم فَفِينِكسُ قائِدٌ","لَهُم مَعَهُ يَمضي أياسُ الفَتى البَطَل",15,"ل",1,0],["انا اتعبني الواقع ،، ومني الحلم مسحوبي","ولكن بوصله وادحر ، سرابٍ كان يمنعني",16,"ن",2,0],["أنا اتنفس وحدتي بعض الأحيان","القى بها الحلم الصغير المثالي",17,"ل",2,0],["إنّا اتفقنا ذات وصل ..إنني ..","لن أبتغي سعدا إذا ما أوجعك",18,"ك",1,0],["إنْ أأتيَ الفعلَ، لا أأتيهِ من وجَلٍ","ولا أُباليَ .. ماذا الخلقُ ظانينا",19,"ن",2,1],["إنا أتينا مطرقينَ رؤوسنا","مما عليه القومُ من غلواءِ",20,"ا",2,0],["إنَّا اتَّحدنا بالسَّماء ِ فنصفُنا","غيثٌ وآخرُنا نباتٌ عاطرُ",21,"ر",1,0],["انا اتحدى جميع الناس واتحدى انا عنتر","اذا حبوا كما حبي ولا يصبروا صبري",22,"ر",2,0],["انا اتذكّر .... الى من قلت.... اب اشوفك .... جوابك طل","واذا تضايقت.... قلتي لي .... بكيفي !! ... والبلا .... كيفك",23,"ك",1,0],["إِنَّا اتَّخِذنَاكَ دَربَاً مُشرِقَ الأُفُق","ِفِي غَيرِ مَعنَاكَ لَا نَسعَى وَلَمْ نَثِق",24,"ق",1,1],["ِإِنَّا اتَّخِذنَاكَ شَمسَاً لِلهُدَى انْبَثَقَت","ْمِنْ فَجرِ لُقيَاكَ، أَسكَنتُ الهُدى حَدَقِي",24,"ق",2,0],["‏أنا أتوقع منكِ الأماني","‏ ‏ لأن فؤادكِ للشعر مالا",25,"ل",2,0],["‏أنا أتهاوى أمام الجمال","‏ ‏ وأسبح في كل فجٍّ عميقْ",26,"ق",1,0],["أنا أتنفس سعداً وحباً","لبيتِ تراثٍ لأنه خالُ",27,"ل",1,0],["أنا اتخذتك أستاذا يثقفنى","بما يثير هوى التعليم فى هممي",28,"م",2,0],["انا اتحدى تلاقي بالميه واحد","طيب ولو تجتهد بالبحث بتطول",29,"ل",1,0]]}