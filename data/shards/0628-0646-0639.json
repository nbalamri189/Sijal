{"poems":[[31,"بنو أسد رجلان رجل تذبذبت","https://www.aldiwan.net/poem6071.html","الطويل"],[87,"بنعمة فتحي قد ظفرتم بفندلى","https://www.aldiwan.net/poem7286.html","الطويل"],[47,"فداؤك نفسي دون رهطي ومعشري","https://www.aldiwan.net/poem63567.html","الطويل"],[47,"أبى الليل إلا أن يعود بطوله","https://www.aldiwan.net/poem65540.html","الطويل"],[47,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[35,"ألا حبذا يوم يقر به الصبا","https://www.aldiwan.net/poem25810.html","الطويل"],[107,"أهاب الحق فاستبقوا كراما","https://www.aldiwan.net/poem41938.html","الوافر"],[42,"ألا أيها الربع الذي خف أهله","https://www.aldiwan.net/poem42340.html","الطويل"],[113,"بنعتمك العظمى التي جل قدرها","https://www.aldiwan.net/poem16735.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[280,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[309,"أحبتنا بنجد والصفيح","https://www.aldiwan.net/poem16826.html","الوافر"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120064","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56183","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108791","الرجز"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128748","الطويل"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107033","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126201","الخفيف"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84847","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100295","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100255","الكامل"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126538","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135741","الرجز"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105266","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4578,"غرامي بالعذارى البيض أسمى","https://www.poetsgate.com/ViewPoem.aspx?id=49520",""],[5652,"بشار عاث وعاثت ذنوب بشار","https://www.poetsgate.com/ViewPoem.aspx?id=164684",""],[5701,"وساعات هذا الدهر سفن حوادث","https://www.poetsgate.com/ViewPoem.aspx?id=164635",""],[5996,"وما ذاك إلا عارض من طماعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181339",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِنَعّارَةٍ يَنفي المَسابيرَ أَريُها","عَلَيها مِنَ الزُرقِ العُيونِ العَساكِرِ",0,"ر",1,0],["بنعمة فتحي قد ظفرتم بفندلى","وأصبحت لا رحلي أحث ولا نعلي",1,"ي",1,1],["بِنِعمَتِكُم يا آلَ سَهلٍ تَسَهَّلَت","عَلَيَّ نَواحي دَهرِيَ المُتَوَعِّرِ",2,"ر",1,0],["بِنُعمى أَميرِ المُؤمِنينَ وَفَضلِهِ","غَدا العَيشُ غَضّاً بَعدَطولِ ذُبولِهِ",3,"ل",2,0],["بِنُعمى اللَهِ عِندَكَ غَيرَ شَكٍّ","وَريحِكَ أَقصَدَتهُ يَدُ المَنونِ",4,"ن",1,0],["بِنَعمانَ إِذ أَهلي بِنَعمانَ جيرَةٌ","لَيالِيَ لا تُرضى بِلادٌ نُقيمُها",5,"م",3,0],["بِنعمةِ ربّكم قُمتُمْ عليهِ","وقام رَسولُه فيكم إماما",6,"م",2,0],["بِنَعفِ اللِوى قَد غَيَّرَ القَطرُ عَهدَهُ","مَعَ المُورِ أَو نَسجُ الصَبا وَالشَمائِلِ",7,"ل",1,0],["بِنعتمك العَظمى الَّتي جَلَّ قَدرُها","أَعذني مِن نَفسي أَجرنيَ مِن نَفسي",8,"ي",1,1],["بِنعمةِ ربّي إنّني مُتحدّثٌ","وَما قَصَدت نَفسي بها الفخرَ وَالكِبرا",9,"ر",2,0],["بِنِعْمَتِها اعتِزازِي واعْتِزائِي","وَخِدْمَتُها اعْتِلائِي واعْتِلاقِي",10,"ق",2,0],["بنعمان الأراك وأي أخذ","فقل لي عنه بالقول الفصيح",11,"ح",1,0],["بنعماهُ أضحت جلّقٌ لي جنّةً","فلم تسمها بغدادُ لولا إمامها",12,"م",3,0],["بِنعمانَ ثمَّ الشَّافِعيِّ بِمالكٍ","بِأَحمد مَنْ حازوا القَبول بِلا جحدِ",13,"د",1,0],["بنعماك مجد الدين يا أكرم الورى","علت همي عن باخل وأنجلى همّي",14,"م",2,0],["بنعم الفرع عبد الله قلبي","وثيقٌ لم يخب في مرتجاهُ",15,"ا",2,0],["بنعمة اللَه جرى ال","عدل بمجراه الزكي",16,"ك",2,0],["بنعلك دس هام الدراري مباهياً","فأنت لجيد الفضل عقد منظم",17,"م",1,0],["بنعمة وهي أتم نعمه","منا على الناس به الأئمه",18,"ه",1,0],["بنعمة الامرة ولولايه","أقام للدين الحنيف رايه",18,"ه",1,0],["بِن عن الحاضرِينَ عند نُفوسٍ","حاضِرِ الشَّرِّ جاهِلِ الخيرِ غائِبُ",19,"ب",1,0],["بِنعمة أَشرَقَت شَمت التهاني","سَعادتها البَهية في وَجودك",20,"ك",1,1],["بنعت فضيلة كرمت نجارا","يلف لها بغيض المجد نجرا",21,"ر",2,0],["بنعيم وصلكَ داوني","عذّبتني بأليم صدك",22,"ك",1,0],["بنعوت ختم الرسل كان شموخها","مذ طال بالوالي النصيح بذوخها",23,"ا",1,0],["بنعمة الله علينا أنعما","هداية الله لنا فأكرما",24,"م",2,0],["بنعيك أمسى الخلق في حيرة فلا","ترى أحداً يسطيع أن يتكلما",25,"م",2,0],["بنعيك شمل الدين شتت شمله","وقد كان قبل النعي عقداً منظما",25,"م",2,0],["بنعشك رضوى أم بنعشك يذيل","وما شأن ذين عز شأنك شانا",26,"ن",2,0],["بنعمته للعفاةِ الحُبورُ","بسطوتهِ للعُداةِ الثبُورُ",27,"ر",1,0],["بنعمان الخدود يرى نعيماً","حليف صبابة بجمال نعمي",28,"م",2,0],["بنعيش حق وحقنا ياهل الدار","الشام تبقى غصب والشك زايل",29,"ل",1,0],["بنعمي وبؤسي أقبلت من مغيبها","فتلقى إلينا أو علينا حمولها",30,"ل",3,0],["بنعمان والأيام فينا حميدة","ووادي الهوى للنازلين مريع",31,"ع",1,0],["بنعمة اللّه الكريم السابغه","بثمن برهان الصفات البازغه",32,"ه",1,0]]}