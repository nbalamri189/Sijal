{"poems":[[55,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[16,"ذهبت من الهجران في غير مذهب","https://www.aldiwan.net/poem27693.html","الطويل"],[40,"وما مزنة جادت فأسبل ودقها","https://www.aldiwan.net/poem7709.html","الطويل"],[45,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[45,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[50,"إذا عبا أبو الهيجاء","https://www.aldiwan.net/poem65307.html","الهزج"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142072","الطويل"],[101,"ورقة إلى القارىء","https://www.poetsgate.com/ViewPoem.aspx?id=17760",""],[55,"أيَا لِلَّهِ! أيُّ هَوًى أضَاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9805&r=&rc=2",""],[124,"سل الخلصاء ما صنعوا بعهدي","https://www.aldiwan.net/poem49370.html","الوافر"],[482,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130717","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122743","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46579",""],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102312","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[2416,"","https://poetry.dctabudhabi.ae/diwan/poem/105098","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94314","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62745","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120458","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120448","الوافر"],[4679,"إليك هدية يا نور عيني","https://www.poetsgate.com/ViewPoem.aspx?id=142742",""],[4755,"لِأَنَّكَ لا تُبَاعُ ولا تَبِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=204388",""],[4767,"سيف البعد","https://www.poetsgate.com/ViewPoem.aspx?id=178909",""],[557,"في عينيك عنواني","https://www.poetsgate.com/ViewPoem.aspx?id=7677",""],[5135,"سيأْتي اللَّهُ بالْفَرَجِ","https://www.poetsgate.com/ViewPoem.aspx?id=201878",""],[5410,"مُباح اللهو في يدنا بناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=152242",""],[6042,"إِذا مَا ضَاقَ صَدْرِي لم أجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=189800",""]],"verses":[["إِذا ما ضَرَبَ النَقعُ","عَلى الحَربِ رِواقَينا",0,"ن",2,0],["إِذا ما ضَلَّ نابُ اللَي","ثِ هَرَّتهُ أَظافِرُه",1,"ر",2,0],["إذا ما ضاءت بالشّعاع تخالها","على عِظَمِ الأجرام منها لآليا",2,"ي",2,0],["إِذا ما ضَرَبتُ الدَفَّ أَو صُلتُ صَولَةً","تَرَقَّبُ مِنّي غَيرَ أَدنى تَرَقُّبِ",3,"ب",1,0],["إِذا ما ضَمِنّا لِاِبنِ عَمٍّ خِفارَةً","نَجيءُ بِها مِن قَبلِ أَن يَتَشَدَّدا",4,"د",2,0],["إِذا ما ضَرَبتَ بِهِ هامَةً","بَراها وَغَنّاكَ في الكاهِلِ",5,"ل",1,0],["إِذا ما ضَرَبتَ القِرنَ ثُمَّ أَجَزتَني","فَكِل ذَهَباً لي مَرَّةً مِنهُ بِالكَلمِ",6,"م",1,0],["إِذا ما ضَرَبوا الطَبلَ","ضَرَبنا نَحنُ عيدانا",7,"ن",2,0],["إذا ما ضاقَ بي يوماً مَكان","فإن مسالكي عنه رحاب",8,"ب",1,0],["إذا ما ضربت الكلب يعوي، ورُبَّما","تقَحَّمَ مُؤْذ به وعضَّ بنابه",9,"ه",1,1],["إذا ما ضَمَمْتَ حُرُوفي غَدَا ..","عذابَ الحروفِ .. لكي توجَدا ..",10,"ا",1,0],["إذا مَا ضِيمَ نَمّرَ صَفْحَتَيْهِ","وقام على براثنه اباءَ",11,"ا",2,0],["إذا ما ضن بالتسليم قومٍ","فإن الجود بالتوديع ردى",12,"د",2,0],["اِذا ما ضللتُ عنِ القصدِ فيه","هداني سِماكُ الدُّجى الرامحُ",13,"ح",1,0],["إذا ما ضاقَ متسعُ المجالِ","وكشف الضر أقرب للمحال",14,"ل",1,1],["إذا ما ضَحِكنَ بَكَت تَحتَها","سَحائِبُ للرَّعدِ فيها زَجَل",15,"ل",1,0],["إذا ما ضعتُ عند بني جَهيرٍ","وعندَ مَع سماحِتكَ انتهيتُ",16,"ت",1,0],["إذا ما ضللنا في غياهب شعرها","هدانا إلى صبح الغرام ابتسامها",17,"م",3,0],["إِذا ما ضَجَّ ثَجَّ الماءُ حَتّى","تَدَبَّجَ بِالرِياضِ الصَحصَحانُ",18,"ن",1,0],["إذا ما ضل عن مغناك يوماً","أخو شغف تداركهم شذاك",19,"ك",1,0],["إذا ما ضل في ظلم","بنوركم السنى هدى",20,"د",2,0],["إِذا ما ضَمَّها بِالسَمنِ جاشَت","بِهِ جَيشَ المعَرمَضَةِ الدَحولِ",21,"ل",1,0],["إذا ما ضربْنا بالمَناسم حَسَّها","فقلْ للمَعالي أيُّ سيفيكَ قاطِعُ",22,"ع",1,0],["إذا ما ضربْنا البَيضَ والبَيضُ مُطبَقٌ","على الهامِ أدركْنَ الفِراخَ اللَّواطيا",23,"ي",2,0],["إذا ما ضحكا يومًا","على غش وبهتانِ",24,"ن",1,0],["اذا ما ضن ذو وسع بفضل","فمثلك ليس بوصف بالشحيح",25,"ح",1,0],["اذا ما ضلل الشعراء حسن","انارتهم خلائقه الحسان",26,"ن",1,0],["اذا ما ضاق صدري من كروب","ذكرت حلاه يصبح وهو فاض",27,"ض",1,0],["إذا ما ضاء فيها الشمع ليلاً","وباتَ يَهلَّ مدمعها السكوبُ",28,"ب",1,0],["إِذا ما ضاقَ عَيشُكَ فهو إِمَّا","عِقَابٌ لِاتِّساعِكَ أَو شَفِيعُ",29,"ع",1,0],["إذا ما ضاق دربٌ في حياتي","أراكِ العونَ يا خير الدليل",30,"ل",1,0],["اذا ما ضعت في درب","ففي عينيك..عنواني",31,"ن",2,0],["إذاما ضاقتِ السُّبلُ","وكانَ الْأمْرُ في حَرَجِ",32,"ج",1,1],["إذا ما ضاقت الدنيا تراني","ألوذ بما يُرى فيه الصفاءُ",33,"ا",2,0],["إِذا مَا ضَاقَ صَدْرِي لم أجد لي","مقرّ عبَادَة إِلَّا القرافه",34,"ه",1,1]]}