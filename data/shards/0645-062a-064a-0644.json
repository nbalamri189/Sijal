{"poems":[[55,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[57,"ظلوم هبي لي سوء ظنك واعلمي","https://www.aldiwan.net/poem26164.html","الطويل"],[44,"إذا كنت تبغي للأمانة حاملا","https://www.aldiwan.net/poem50360.html","الطويل"],[49,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[53,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[53,"أنلني أو ادللني على من ينيلني","https://www.aldiwan.net/poem65764.html","الطويل"],[45,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[47,"متى لاح برق أو بدا طلل قفر","https://www.aldiwan.net/poem63556.html","الطويل"],[47,"شهي إلى الأيام تقليلها وفري","https://www.aldiwan.net/poem63634.html","الطويل"],[47,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[48,"تراب جسومنا وهي التراب","https://www.aldiwan.net/poem22093.html","الوافر"],[48,"إذا عشت مفتكرا في الأنام","https://www.aldiwan.net/poem23266.html","المتقارب"],[48,"أنافق الناس إني قد بليت بهم","https://www.aldiwan.net/poem23518.html","البسيط"],[47,"عَزَمْتُ عَلى المَنَازِلِ أنْ تَبينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31886",""],[47,"متى لاح برق أو بدى طلل قفر","https://www.poetsgate.com/ViewPoem.aspx?id=31245",""],[173,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[190,"وإني وإن أصبحت في دار غربة","https://www.aldiwan.net/poem43827.html","الطويل"],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[234,"دعاني فليس الرأي ما تريان","https://www.aldiwan.net/poem50739.html","الطويل"],[234,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[237,"متى لا ح لي من أبرق الجزع بارق","https://www.aldiwan.net/poem14849.html","الطويل"],[242,"أعدت نبالا للحشا وهي ألحاظ","https://www.aldiwan.net/poem18845.html","الطويل"],[242,"سلام عليكم والحوادث ألوان","https://www.aldiwan.net/poem19283.html","الطويل"],[255,"سرى في دجى من شعره فحكا البدرا","https://www.aldiwan.net/poem14966.html","الطويل"],[354,"متى للحق حققتا","https://www.aldiwan.net/poem15538.html","الهزج"],[366,"ألا ان ديني فاعلموه هو الهوى","https://www.aldiwan.net/poem68139.html","الطويل"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[396,"أتسألني ولست لذاك أهلا","https://www.aldiwan.net/poem54616.html","عموديه"],[422,"متى لاح رسم الدار من طلل قفر","https://www.aldiwan.net/poem54144.html","الطويل"],[430,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[469,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[469,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[482,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[562,"متى لا مني فيها فإني فعلتها","https://www.aldiwan.net/poem1742.html","الطويل"],[580,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122581","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48699","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48700","المجتث"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107226","الوافر"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202105","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202090","المتقارب"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202077","المتقارب"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46437","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47197","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129887","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107169","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100398","الطويل"],[562,"","https://poetry.dctabudhabi.ae/diwan/poem/31550","الطويل"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96120","الطويل"],[354,"","https://poetry.dctabudhabi.ae/diwan/poem/44093","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90808","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117311","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58089","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204285","الطويل"],[308,"مَتى لَاق بالعشاق عز وسطوة","https://www.poetsgate.com/ViewPoem.aspx?id=189018",""],[5397,"بدا نجم سعد ما عهدناه غاربا","https://www.poetsgate.com/ViewPoem.aspx?id=157959",""],[5397,"هلال دجى وشمس ضحى وفرقد","https://www.poetsgate.com/ViewPoem.aspx?id=157966",""],[5545,"نسيج الحب","https://www.poetsgate.com/ViewPoem.aspx?id=184849",""],[402,"إني اقمت على التعلة","https://www.poetsgate.com/ViewPoem.aspx?id=36824",""],[6023,"متى لمست كفُّه مُعدماً","https://www.poetsgate.com/ViewPoem.aspx?id=123893",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["مَتى لَم يُطِعِ الجودُ","سَخَونا أَو تَساخَينا",0,"ن",2,0],["مَتى لَيتَ شِعري نَلتَقي وَإِلى مَتى","تُؤَدّي رِسالاتي إِلَيكِ الأَنامِلُ",1,"ل",1,0],["مَتى لا يُصادِفها غُدُوّاً فَإِنَّهُ","سَيُفلَسُ عَنها أَو سَتَكسُدُ سوقُها",2,"ق",3,0],["مَتى لَم تُصِب مِنّا اللَيالي اِبنَ هَمَّةٍ","يُجَشِّمُها صَرفُ الرَدى فَتَجَشَّمُ",3,"م",1,0],["متى لاحَ أني حين أحرمُ جازعٌ","فقد بانَ أني حين أكرمُ غامطُ",4,"ط",1,0],["متى ليْتَ شعري أنت واجدُ واحدٍ","تُنيلُ يداهُ بعد منعِ يديكا",5,"ك",2,0],["مَتى لَحَظَت بَياضَ الشَيبِ عَيني","فَقَد وَجَدَتهُ مِنها في السَوادِ",6,"د",1,0],["مَتى لاحَ بَرقٌ أَو بَدا طَلَلٌ قَفرُ","جَرى مُستَهِلٌّ لا بَكِيٌّ وَلا نَزرُ",7,"ر",1,1],["مَتى لا تَسُدّوا خَلَّتي لا تُصِبكُمُ","شَذاتي وَلا يَسلُك سِوى نَهجِهِ شِعري",8,"ر",2,0],["مَتى لَم يَزكُ في العَرَبِ اِرتِيادي","حَطَتُ إِلى رِباعِ الأَعجَمينا",9,"ن",2,0],["مَتى لَم يَضطَرِب مِن عَلوَ جَدٌّ","فَلَيسَ بِنافِعٍ مِنكَ اِضطِرابُ",10,"ب",1,0],["مَتى لُمتُماني عَلى زَلَّةٍ","رَجَعتُ عَلى أُمِّيَ الهابِلِ",11,"ل",1,0],["مَتى لَحِقتُ بِتُربي زَلَّ عَن جَدَثي","مَدحي وَذَمِّيَ مِن مَثنى وَوُحدانِ",12,"ن",1,0],["متى لم يَزْكُ في العَرَبِ ارْتِيادي،","حَطَطْتُ إلى رِباعِ الأعجَمينَا",13,"ن",2,0],["متى لاح برق أو بدى طلل قفر","جرى مستهل لا بكيء ولا نزر",14,"ر",1,1],["مَتى لَم تَرُعها بِتَّ مِنها مُرَوَّعاً","وَتَأمَنُ مِن مَكروهِها إِذ تَروعُها",15,"ع",3,0],["مَتَى لَم أَضِق ذَرعاً بِأَرضٍ فَإِنَّني","لَدى الهَمِّ جَوّابُ المَوامي ذَرُوعُها",15,"ع",3,0],["متى لم يكن كل السماح فبعضه","ولست كراء والبصائر عور",16,"ر",1,0],["متى لان في أكل الحرام بغاثها","فأسلمهم ذعّارها في أناتها",17,"ت",3,0],["متى لم تكونوا دُونَنا وتَسابقوا","لِصالحِنا في كلّ يومِ رِهان",18,"ن",1,0],["متى لبِسْنا لك الوفاءَ فلم","أُصبِحْ ولي وافرُ النّصيبين",19,"ن",1,0],["مَتى لا حَ لي مِن أَبرقِ الجزعِ بارِقٌ","وَلَم تَهمُ أَجفاني فَما أَنا عاشِقُ",20,"ق",1,1],["مَتَى لاَحَ بَرْقُ الشَّوْقِ فِي سُدَفِ الْحَشَا","أُتِيحَ لِأَجْفَانِ التَّوَلُّهِ إِيقَاظُ",21,"ظ",1,0],["مَتىَ لاَحَ مِنْ نَجْدٍ بَرِيقٌ يُرَاقُ مِنْ","مَحَاجِرِهِ مُزْنٌ مِنَ الدَّمْعِ هَتَّانُ",22,"ن",1,0],["متى لُمتُهُ أغراهُ لَومي بِعفلِهِ","وتُتشدُ آمالي لعل له عُذرا",23,"ر",2,0],["مَتى لِلحَقِّ حَقَّقَتا","عَنِ الخَلقِ بِهِ بِنتا",24,"ت",2,1],["مَتى لاحَ وَجد قالَ يَأتى اِتالَه","وَيَكفي الهَوى جَلدا بِغَير تَأهب",25,"ب",1,0],["متى لنا ولكم تُقصَى الفَوائتُ من","قولٍ وفعلٍ يَروقُ السَّمْعَ والبَصَرا",26,"ر",2,0],["متى لازمت ذكر الله تصلح","بذكر الله يا صاح القلوب",27,"ب",1,0],["متى لاحَ رسمُ الدَّار من طلل قَفْرِ","فلي زفرةٌ تذكو ولي عَبْرةٌ تَجري",28,"ر",2,1],["مَتَى لَمْ تُحِطْ خُبْراً بِما صَنَعَ الْهَوى","بِمَنْ فارَقَ الأَحْبَابَ فَالدَّمْعُ يُخْبِرُكْ",29,"ك",1,0],["متى لمتني في الغوزال الأغنِ","فلا أنا منكَ ولا أنتَ مني",30,"ن",2,1],["متى لاح برقٌ فاضَ دمعي صبابةً","فلولا الهوى ما كنت أبكي لباسمِ",31,"م",1,0],["متى لم تفز عيناي منها بنظرة","فلا شام برقَ المشرفيَّة شائم",32,"م",1,0],["متى لاحَ برقٌ أو ترنَّمَ طائرٌ","تكنَّفني التَّذكارُ مِن كلَّ جانبِ",33,"ب",1,0],["مَتى لا مَني فيها فَإِنّي فَعَلتُه","وَلَم آتِها مِن ذي جَبانٍ وَلا سِترِ",34,"ر",1,1],["متى لاحَ فيها صبحها فهو وجهه","وإِن فَاح مِنْها روضُها فهوُ ذِكْرُه",35,"ر",2,0],["مَتَى لَم يور أهلُ الفضلِ زندا","وأصلدَ قادحٌ أورَيتَ زندا",36,"د",2,0],["متيلدُ يا بنتَ عمّي","حزني عظيمٌ وغمّي",37,"م",2,1],["مِتيْلْدُ أنت عروسُ","تغار منها الشموسُ",38,"س",1,1],["متيلد أنت نعيم","تهفو إليه النفوس",38,"س",1,0],["مَتى لاحَت لِجَيشِ الهَمِّ وَلّى","إِلَى الأَعقابِ يَهتِفُ بِالنَّكالِ",39,"ل",1,0],["متى ليت شعري أشتفى بلقائهم","وأشكو إليهم ما لقيت مصاعبا",40,"ب",2,0],["متى ليت شعري تُدْرِكُ النفسُ سُؤلها","وقد قاد من مصر إليه الركائبا",40,"ب",2,0],["متى ليت شعري يكون الظهور","فيكشف مولى الورى كلَّ مِحْنَه",41,"ن",2,0],["متى ليْتَ شِعْري إليْك الوصول","فألقَي إلى طَلَباتي وُصُولا",42,"ل",2,0],["مَتى لَم يَكُن عَقلُ الفَتى هادياً لَهُ","تَضق في مَساعيهِ عَلَيهِ المَذاهب",43,"ب",1,0],["متى لَمَسَتْ كفُّ الغُوَاةِ سماءَه","فلم تَرْمِهِمْ من حُرَّسِ الشُهب صاعقَة",44,"ق",2,0],["متى لحتَ صحّ البين وانقطعَ الرجا","كأنّك من وشك الفراقِ على وعدِ",45,"د",1,0],["متَى لثَمَت أَقدامُنا تُربَ دارِهِم","أَيا هِمَّتي زِيدِي وَيا هَمُّ أَقلعِ",46,"ع",1,0],["متى لاح لي من جانب الغور بارقٌ","يذكرني البرق اللموع ابتسامها",47,"م",3,0],["مَتى لا مَني فيها فَإِنّي فَعَلتُها","وَلَم آتِها مِن ذي جَبانٍ وَلا سِترِ",48,"ر",1,1],["متى لا تجده تنصرف لطياتها","من الأرض أو تعمد لالف فتربعِ",49,"ع",1,0],["مَتى لَم تُنسِني ذِكراكَ نَفسي","بِغَيبي فيكَ عَن عَقلي وَحِسّي",50,"س",2,1],["متى لعرائس الآمال نجلوا","وعقد الشمل نجعله حليا",51,"ي",2,0],["متى للمعالى وبدر الكمال","على ضعف حالي سأهدى السبيلا",52,"ل",2,0],["متى لاحَ بَرْقٌ أو ترنَّمَ طائرٌ","ويَمَّمَّ ركبٌ للبقَيعِ بإِيجافِ",53,"ف",1,0],["متى لم يكن ترياق جاهك ضامناً","نجاتي إذا دبت إلى الحال عقربُ",54,"ب",1,0],["مَتى لَاق بالعشاق عز وسطوة","كأَنك من ذل الْمحبَّة فِي شكّ",55,"ك",1,1],["متى لمست عفوا له أنمل الردى","تطلع صلا في المغارة واثبا",56,"ب",2,0],["متى للشك أسدف جنح ليل","سناك على اليقين به توقد",57,"د",1,0],["متى ؟ لاتسلني منذُ عمرٍ صبابتي","تتوقُ لشمّ الوصل في دوحِ حيّنا",58,"ن",2,0],["متى لفين وذاك","شرط للحياة المستقله",59,"ل",2,0],["متى لمست كفُّه مُعدماً","أصاب الغِنى وانثنى مُسعفاً",60,"ف",2,1],["متى لبيك ربي سارركبي","إلى أم القرى ضمن الوفود",61,"د",1,0]]}