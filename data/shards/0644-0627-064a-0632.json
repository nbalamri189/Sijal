812","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132127","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135623","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126340","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83188","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83185","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83194","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66128","الخفيف"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105188","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120485","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120193","الكامل"],[4767,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=87998",""],[4929,"على أبواب الشتاء","https://www.poetsgate.com/ViewPoem.aspx?id=199264",""],[2365,"أيها الطالب أجمل واقتصد","https://www.poetsgate.com/ViewPoem.aspx?id=200664",""],[5358,"ذهب الدهرُ بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21475",""],[5512,"قاضي الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=204154",""],[5512,"لا يزهر القلب من غير الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=205392",""],[5561,"نجمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=193221",""],[5573,"ياكوكب الزهره معاك امنياتي","https://www.poetsgate.com/ViewPoem.aspx?id=204559",""],[5574,"أغلقْ فماً","https://www.poetsgate.com/ViewPoem.aspx?id=206046",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[4442,"فتح الله للحقيقة بابا","https://www.poetsgate.com/ViewPoem.aspx?id=170992",""],[5190,"للأرض وجهٌ آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78324&r=&rc=37",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""]],"verses":[["لايزالُ المَلامُ عنْهُ بحالٍ","حالَةَ الشّيْخ وابْنِهِ والحِمارِ",0,"ر",1,0],["لِأَيِّ زَمانٍ يَخبَأُ المَرءُ نَفعَهُ","غَداً فَغَداً وَالدَهرُ غادٍ وَرائِحُ",1,"ح",1,1],["لا يَزَل مِن حاسِديهِ مُكثِرٌ","أَو مُقِلٌّ سَبَقَ السَيفُ العَذَل",2,"ل",1,0],["لا يَزَلِ الشرُّ عنك مندفعاً","وسيل خير إليك يندفع",3,"ع",1,0],["لا يَزمَهِرُّ غَداةَ الدَجنِ حاجِبُهُم","وَلا أَضِنّاءُ بِالمِقرى وَإِن ثُمِدوا",4,"د",3,0],["لا يَزالُ الإيمانُ نَوعاً مِنَ","الرَهبَةِ وَالحُسنُ لِلغُرورِ خَدينا",5,"ن",2,0],["لا يَزالُ الغَنِيُّ يَختالُ في الأَر","ضِ وَإِن كانَ جاهِلاً مَأفونا",5,"ن",2,0],["لا يَزالُ الحُبُّ في شَلّالِها","وَبَواديها حَديثاً وَاِنتِباها",6,"ا",3,0],["لا يزيد البحر الخضم جلالا","فوقه المنشآت كالأعلام",7,"م",1,0],["لا يزعج المرء ضوضاء الحياة به","ولا يجور على الانسان انسان",8,"ن",1,0],["لا يُزهِدَنَّكَ في المعروفِ تُودِعُه","مثلي ومن أينَ مثلي سُحْقُ أطمارِ",9,"ر",1,1],["لا يزهدنَّكَ في الجميلِ مقابِلٌ","حُسْنَ الصنيعةِ منك بالكُفْرِ",10,"ر",1,1],["لا يَزورُ الوَفاءَ غِبّاً وَلا يَعشَ","قُ غَدرَ الفَعالِ عِشقَ الكَعابِ",11,"ب",1,0],["لا يَزَل يُفتَدى بِأَنفُسِ قَومٍ","نَقِيَت مِن عُيوبِهِم أَثوابُه",12,"ب",2,0],["لا يَزَل يُفتَدى بِقَومٍ أَراهُم","غاضَ مَعروفُهُم وَأُترِعَ رِفدُه",13,"د",2,0],["لايَزَل رائِدُ الحَوادِثِ مُلغىً","عَنكَ يَعدوكَ رَيبُهُ وَعِثارُه",14,"ر",2,0],["لا يَزالُ المَرءُ ما عاشَ لَهُ","حاجَةٌ في الصَدرِ دَأباً تَعتَلِج",15,"ج",1,0],["لا يَزجُرُ البارِحَ في اِعتِراضِهِ","وَلا غُرابَ البَينِ في تَنعابِهِ",16,"ب",2,0],["لا يَزالُ الخَلخالُ فَوقَ الحَشايا","مِثلَ أَثناءِ حَيَّةٍ مَقتولِ",17,"ل",1,0],["لا يَزجُرُ الطَيرَ إِن مَرَّت بِهِ سُنُحاً","وَلا يُفيضُ عَلى قَسمٍ بِأَزلامِ",18,"م",1,0],["لا يَزالوا في غَبطَةٍ وَسُرورِ","وَبَقاءٍ مِن مُلكِهِ وَدَوامِ",19,"م",1,0],["لا يُزْهَ إنسانٌ بآدابه","أو يفتخر بالسلف البائد",20,"د",1,0],["لا يَزَالُ المَرْءُ ما عاشَ لَهُ","حاجَة ٌ فِي الصَّدْرِ مِنْهُ تختلِجْ",21,"ج",1,0],["لأيِّ زمانٍ يخبأ المءُ نفعهُ","غداً فغَداً والدَّهْرُ غادٍ ورائحُ",22,"ح",1,1],["لا يزدهي حلمه الجهول ولا","يلغى لدى الخير مِمَّن يَألفِ الكسلا",23,"ل",2,0],["لا يزور الرقادُ عينا إذا سِر","تَ ولا يسكن الفؤادُ الصدرا",24,"ر",2,0],["لا يزعجنّك فقد من","أمسيت يزعجك افتقاده",25,"د",2,0],["لا يزهر القلب إلا يوم يحرسه","روح جميل لأجراح الجوى آسى",26,"س",2,0],["لا يَزالُ الزَهرُ بَسّاماً لَنا","شاهِداً عَدلاً عَلى تِلك اليَمين",27,"ن",1,0],["لا يَزَلْ بَدْراً وَبَحْرَ نَدىً","بَيْنَ تَنْوِيرٍ وَتَنْوِيلِ",28,"ل",1,0],["لا يزور الخليل عندي خليلا","يوم أخذ الدواء إلا ثقيلا",29,"ل",2,1],["لا يَزدهيهِ وَلا يطيش بلبّهِ","مَرحٌ عَلى أعطافها يتدفّعُ",30,"ع",1,0],["لا يَزْدهي بمديحٍ فيكَ يُبدِعُه","وإن أَدَلَّ فبالوُدِّ الّذي مَحَضا",31,"ض",2,0],["لا يَزلْ جوُدك يَجلوك لنا","في سوارٍ صيغَ من حُسْنِ الثّناء",32,"ا",2,0],["لا يزالان يعديا","ن على كلِّ قاصدِ",33,"د",1,0],["لا يَزالُ الحَياء يُلهبها حَتّى","تَراها لِصَبغِهِ كَالدَوامي",34,"م",2,0],["لا يزدهِيه خوفُ الحِمامِ ولا","عَهِدْتُهُ في مُلِمَّةٍ خَفَقَا",35,"ق",2,0],["لا يزال الدهر يعلو جدّه","مرتقيها في المعالي رتبا",36,"ب",2,0],["لا يزال العيد الَّذي أنتَ فيه","عائداً بالسُّرور حَوْلاً فَحَوْلا",37,"ل",2,0],["لا يزالون يرفعون بيوتاً","للمعالي لا تقبل الدهر هدما",38,"م",2,0],["لا يزاحمن ذا كُراعٍ ولا يُض","رَبْنَ حول الحياض ساعةَ كرعِ",39,"ع",1,0],["لا يَزالُ المرْءُ ما عَا","شَ لَهُ في الدَّهْرِ حاجُ",40,"ج",1,0],["لاَ يَزالُ الذي يُراعِي البَرايَا","ويُرْجِّي رِضَاهُمُ في عَنَاءِ",41,"ا",2,1],["لأيِّ زَمانٍ يَخبأُ المَرءُ نَفعَهُ","غَداً بَل غَداً لِلمَوتِ غادٍ وَرائِحُ",42,"ح",1,0],["لا يزال الكمال يقطر منه","نوره في سمائه غير خاف",43,"ف",1,0],["لا يَزَالُ الغَرِيْرُ يَقْتَادُ من فض","لِ عناني قَوْدي لِتِلْكَ الجُنُودِ",44,"د",1,0],["لا يَزدَهيهِ لغيرِ الحقّ منطقُهُ","ولا تناجيه إلاّ بالتقى الفكرُ",45,"ر",1,0],["لا يزال الخلخال فوق الحشايا","مثل أثناء حيَّةٍ مفتولِ",46,"ل",1,0],["لا يَزال العلا يُناديه أَرِّخ","للخديوي في مصر عيد إِمام",47,"م",1,0],["لا يزالون يحلمون بما فا","ت كما بات يحلم المحموم",48,"م",1,0],["لا يَزالُ الزّمانَ مَحمودَ فِعلٍ","وَيرى الخَيرَ خَلفَه وَأَمامَه",49,"م",2,0],["لا يزال الله يرعى خلقه","ما أطاعوه فإن ضلوا انتقمْ",50,"م",1,0],["لا يزال الحق فينا مذهباً","رضي الخصم علينا أم أبى",51,"ب",2,1],["لا يزال ذا فسحةٍ في العمر طيبةٍ","ولم يزالا كذا في عيشة الرغَدِ",