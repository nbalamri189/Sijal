{"poems":[[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[24,"لأي زمان يخبأ المرء نفعه","https://www.aldiwan.net/poem21892.html","الطويل"],[73,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[91,"سألتني وقد رجعت إليها","https://www.aldiwan.net/poem62790.html","عموديه"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[89,"قد قلت حقا فلم تقبله أذهان","https://www.aldiwan.net/poem44873.html","البسيط"],[62,"لا يزهدنك في المعروف تودعه","https://www.aldiwan.net/poem52385.html","البسيط"],[62,"لا يزهدنك في الجميل مقابل","https://www.aldiwan.net/poem52421.html","الكامل"],[45,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[45,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[45,"غلس الشيب أو تعجل ورده","https://www.aldiwan.net/poem62743.html","الخفيف"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[49,"ذهب الحرص بأصحاب الدلج","https://www.aldiwan.net/poem62023.html","الرمل"],[66,"أبد سنا وجهك من حجابه","https://www.aldiwan.net/poem41551.html","الرجز"],[31,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[22,"هل تعرف الدار مذ عامين أو عاما","https://www.aldiwan.net/poem21648.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[49,"ذَهبَ الحرصُ بأصحابِ الدَّلجْ","https://www.poetsgate.com/ViewPoem.aspx?id=16976",""],[24,"لأيِّ زمانٍ يخبأ المءُ نفعهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10891&r=&rc=32",""],[132,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[142,"لست أقضى إذا رأيتك نذرا","https://www.aldiwan.net/poem58427.html","الخفيف"],[186,"حظ الفتى مما أتاه","https://www.aldiwan.net/poem43955.html","مجزوء الكامل"],[211,"ما عبقر بقدير أن يصوغ هوى","https://www.aldiwan.net/poem46581.html","البسيط"],[223,"جثم الليل بأحضان التلال","https://www.aldiwan.net/poem41896.html","الرمل"],[275,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[281,"لا يزور الخليل عندي خليلا","https://www.aldiwan.net/poem1381.html",""],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[364,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[364,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[371,"طال شغل القصائد","https://www.aldiwan.net/poem57495.html","مجزوء الخفيف"],[380,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[409,"قلبي وصبري إلفان مذ خلقا","https://www.aldiwan.net/poem32173.html","المنسرح"],[416,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[416,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[416,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[458,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[529,"هل لذا الهم انفراج","https://www.aldiwan.net/poem37484.html","مجزوء الرمل"],[529,"لا يزال الذي يراعي البرايا","https://www.aldiwan.net/poem37546.html","الخفيف"],[540,"وللموت سورات بها تنقض القوى","https://www.aldiwan.net/poem56633.html","الطويل"],[558,"صحن صحناء واسع الأطراف","https://www.aldiwan.net/poem34340.html","الخفيف"],[567,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"]],"verses":[["لايزالُ المَلامُ عنْهُ بحالٍ","حالَةَ الشّيْخ وابْنِهِ والحِمارِ",0,"ر",1,0],["لِأَيِّ زَمانٍ يَخبَأُ المَرءُ نَفعَهُ","غَداً فَغَداً وَالدَهرُ غادٍ وَرائِحُ",1,"ح",1,1],["لا يَزَل مِن حاسِديهِ مُكثِرٌ","أَو مُقِلٌّ سَبَقَ السَيفُ العَذَل",2,"ل",1,0],["لا يَزَلِ الشرُّ عنك مندفعاً","وسيل خير إليك يندفع",3,"ع",1,0],["لا يَزمَهِرُّ غَداةَ الدَجنِ حاجِبُهُم","وَلا أَضِنّاءُ بِالمِقرى وَإِن ثُمِدوا",4,"د",3,0],["لا يَزالُ الإيمانُ نَوعاً مِنَ","الرَهبَةِ وَالحُسنُ لِلغُرورِ خَدينا",5,"ن",2,0],["لا يَزالُ الغَنِيُّ يَختالُ في الأَر","ضِ وَإِن كانَ جاهِلاً مَأفونا",5,"ن",2,0],["لا يَزالُ الحُبُّ في شَلّالِها","وَبَواديها حَديثاً وَاِنتِباها",6,"ا",3,0],["لا يزيد البحر الخضم جلالا","فوقه المنشآت كالأعلام",7,"م",1,0],["لا يزعج المرء ضوضاء الحياة به","ولا يجور على الانسان انسان",8,"ن",1,0],["لا يُزهِدَنَّكَ في المعروفِ تُودِعُه","مثلي ومن أينَ مثلي سُحْقُ أطمارِ",9,"ر",1,1],["لا يزهدنَّكَ في الجميلِ مقابِلٌ","حُسْنَ الصنيعةِ منك بالكُفْرِ",10,"ر",1,1],["لا يَزورُ الوَفاءَ غِبّاً وَلا يَعشَ","قُ غَدرَ الفَعالِ عِشقَ الكَعابِ",11,"ب",1,0],["لا يَزَل يُفتَدى بِأَنفُسِ قَومٍ","نَقِيَت مِن عُيوبِهِم أَثوابُه",12,"ب",2,0],["لا يَزَل يُفتَدى بِقَومٍ أَراهُم","غاضَ مَعروفُهُم وَأُترِعَ رِفدُه",13,"د",2,0],["لايَزَل رائِدُ الحَوادِثِ مُلغىً","عَنكَ يَعدوكَ رَيبُهُ وَعِثارُه",14,"ر",2,0],["لا يَزالُ المَرءُ ما عاشَ لَهُ","حاجَةٌ في الصَدرِ دَأباً تَعتَلِج",15,"ج",1,0],["لا يَزجُرُ البارِحَ في اِعتِراضِهِ","وَلا غُرابَ البَينِ في تَنعابِهِ",16,"ب",2,0],["لا يَزالُ الخَلخالُ فَوقَ الحَشايا","مِثلَ أَثناءِ حَيَّةٍ مَقتولِ",17,"ل",1,0],["لا يَزجُرُ الطَيرَ إِن مَرَّت بِهِ سُنُحاً","وَلا يُفيضُ عَلى قَسمٍ بِأَزلامِ",18,"م",1,0],["لا يَزالوا في غَبطَةٍ وَسُرورِ","وَبَقاءٍ مِن مُلكِهِ وَدَوامِ",19,"م",1,0],["لا يُزْهَ إنسانٌ بآدابه","أو يفتخر بالسلف البائد",20,"د",1,0],["لا يَزَالُ المَرْءُ ما عاشَ لَهُ","حاجَة ٌ فِي الصَّدْرِ مِنْهُ تختلِجْ",21,"ج",1,0],["لأيِّ زمانٍ يخبأ المءُ نفعهُ","غداً فغَداً والدَّهْرُ غادٍ ورائحُ",22,"ح",1,1],["لا يزدهي حلمه الجهول ولا","يلغى لدى الخير مِمَّن يَألفِ الكسلا",23,"ل",2,0],["لا يزور الرقادُ عينا إذا سِر","تَ ولا يسكن الفؤادُ الصدرا",24,"ر",2,0],["لا يزعجنّك فقد من","أمسيت يزعجك افتقاده",25,"د",2,0],["لا يزهر القلب إلا يوم يحرسه","روح جميل لأجراح الجوى آسى",26,"س",2,0],["لا يَزالُ الزَهرُ بَسّاماً لَنا","شاهِداً عَدلاً عَلى تِلك اليَمين",27,"ن",1,0],["لا يَزَلْ بَدْراً وَبَحْرَ نَدىً","بَيْنَ تَنْوِيرٍ وَتَنْوِيلِ",28,"ل",1,0],["لا يزور الخليل عندي خليلا","يوم أخذ الدواء إلا ثقيلا",29,"ل",2,1],["لا يَزدهيهِ وَلا يطيش بلبّهِ","مَرحٌ عَلى أعطافها يتدفّعُ",30,"ع",1,0],["لا يَزْدهي بمديحٍ فيكَ يُبدِعُه","وإن أَدَلَّ فبالوُدِّ الّذي مَحَضا",31,"ض",2,0],["لا يَزلْ جوُدك يَجلوك لنا","في سوارٍ صيغَ من حُسْنِ الثّناء",32,"ا",2,0],["لا يزالان يعديا","ن على كلِّ قاصدِ",33,"د",1,0],["لا يَزالُ الحَياء يُلهبها حَتّى","تَراها لِصَبغِهِ كَالدَوامي",34,"م",2,0],["لا يزدهِيه خوفُ الحِمامِ ولا","عَهِدْتُهُ في مُلِمَّةٍ خَفَقَا",35,"ق",2,0],["لا يزال الدهر يعلو جدّه","مرتقيها في المعالي رتبا",36,"ب",2,0],["لا يزال العيد الَّذي أنتَ فيه","عائداً بالسُّرور حَوْلاً فَحَوْلا",37,"ل",2,0],["لا يزالون يرفعون بيوتاً","للمعالي لا تقبل الدهر هدما",38,"م",2,0],["لا يزاحمن ذا كُراعٍ ولا يُض","رَبْنَ حول الحياض ساعةَ كرعِ",39,"ع",1,0],["لا يَزالُ المرْءُ ما عَا","شَ لَهُ في الدَّهْرِ حاجُ",40,"ج",1,0],["لاَ يَزالُ الذي يُراعِي البَرايَا","ويُرْجِّي رِضَاهُمُ في عَنَاءِ",41,"ا",2,1],["لأيِّ زَمانٍ يَخبأُ المَرءُ نَفعَهُ","غَداً بَل غَداً لِلمَوتِ غادٍ وَرائِحُ",42,"ح",1,0],["لا يزال الكمال يقطر منه","نوره في سمائه غير خاف",43,"ف",1,0],["لا يَزَالُ الغَرِيْرُ يَقْتَادُ من فض","لِ عناني قَوْدي لِتِلْكَ الجُنُودِ",44,"د",1,0]]}