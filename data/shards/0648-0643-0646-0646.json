{"poems":[[79,"أمولاي دمت الدهر منصور أعلام","https://www.aldiwan.net/poem36104.html","الطويل"],[53,"من الحيف تخسيس النوال ومطله","https://www.aldiwan.net/poem62948.html","الطويل"],[53,"من الحيف تخسيسُ النوال ومطْلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29073",""],[146,"يا ماء لينة لو نقعت أوامى","https://www.aldiwan.net/poem58373.html","الكامل"],[234,"ويلي من الرشأ الذي","https://www.aldiwan.net/poem50749.html","السريع"],[309,"حويدي المطايا كم تقيم مع الصد","https://www.aldiwan.net/poem16864.html","الطويل"],[382,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[396,"عن الناس لا تسأل ولا عن فعالهم","https://www.aldiwan.net/poem54512.html","عموديه"],[447,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[466,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[563,"هوى قد أذاب الروح والنفس والجسما","https://www.aldiwan.net/poem34192.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70965","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95580","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85229","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85231","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75697","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83451","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83193","الرجز"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5365,"أشواق","https://www.poetsgate.com/ViewPoem.aspx?id=191264",""],[5567,"وكن روحي لتفنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69067&r=&rc=6",""]],"verses":[["وَكُنْ نَحْوَ نُورِ الْحَقِّ تَعْشُو فكُلُّ مَا","سِوَاهُ فَحُجْبٌ مِنْ ظِلاَلٍ وَأَوْهَامِ",0,"م",1,0],["وكن نخلة تُلوِي وتُسني عطاءها","وإلّا فكن عَصْفاً أقلَّ وأيسرا",1,"ر",2,0],["وكن نخلة تُلوِي وتُسني عطاءها","وإلاّ فكن عَصْفاً أقلَّ ويسرا",2,"ر",2,0],["وكنَنَّ في الأيدى خضابا ناميا","ونظيره في القلب حبٌّ نامِ",3,"م",1,0],["وكنَنْتُها في عينِه","خوفَ الرَّقيبِ بلَحْظِ عَيني",4,"ن",2,0],["وكن نائباً عني باهداً تحية","معنبرة كالمسك في العرف والند",5,"د",1,0],["وكن نظير الرُسل","بوعظك المختلب",6,"ب",1,0],["وكن نائبا عن خاتم الرسل إنه","أمر نحن بالتبليغ عنه فحصل",7,"ل",1,0],["وكن نائباً عنا إذا ناب نائب","وكن حاملاً عنا ثقيل المغارم",8,"م",1,0],["وكنْ ناصري في بلوغٍ العُلى","فقد أنْفدَ الصَّبر لَيَّانُها",9,"ن",3,0],["وكن ناظراً آثارها بعيونها","وإلا فعن آثارها لم تزل أعمى",10,"م",2,0],["وكنْ ناقشا شوكَ الشكوكِ فإنما","يقينُك يبقى والشكوكُ تشوك",11,"ك",1,0],["وكن نقيا واضحا","لا تعتكر أو تضطرب",12,"ب",1,0],["وَكُنَّ نَواهِضَ الأَعناقِ غُلباً","فَعُدنَ وَهُنَّ قُضبانُ الثُمامِ",13,"م",1,0],["وكن نديم الفرقدين تنج من","منقّص ومن طرو الرنق",14,"ق",1,0],["وكن ناظري فضلا بعين عناية","تيسّرُ لي ما من أمور أريدها",15,"د",3,0],["وَكُن ناصِحاً لِلمُصطَفى بِاِتِّباعِهِ","وَنُصرَتِهِ مَعَ حُبِّ أَهلِ وَلائِهِ",16,"ا",3,0],["وَكُن ناصِحاً لِلمُسلِمينَ جَميعَهُم","بِإِرشادِهِم لَلحَقِّ عِندَ خَفائِهِ",17,"ا",3,1],["وَكُن ناسياً إِلّا إِشارَة طرفها","اليك وَلَم تنطق فخامرك الجَوى",18,"و",2,0],["وَكن نَصيري إِذا صار المَصار غداً","وَأَظلم اللَيلُ غابَت فيه أَنجمهُ",19,"م",2,0],["وَكُن نَصوح الجَيبِ","وَكُن أَمين الغَيبِ",20,"ب",1,0],["وَكُن ناظِراً في القَلبِ صورَةَ حُسنِهِ","عَلى هَيئَةِ المَنقوشِ يَظهَرُ طابِعُ",21,"ع",1,0],["وكن ناصراً من كان للحق ناصراً","بجودك إحساناً وفضلاً تكرما",22,"م",2,0],["وكن ْ نسيماً مع النّسرينِ موعِده","إذا أتاها ارتمى في خدّها سَعِدَا",23,"د",2,0],["وكن نفسي لتعرفَني تماما","وكن روحي لتفنى كي أراكَ",24,"ك",1,0]]}