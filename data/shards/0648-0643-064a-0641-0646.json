{"poems":[[55,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[55,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[55,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[65,"كتمنا الهوى وكففنا الحنينا","https://www.aldiwan.net/poem46144.html","المتقارب"],[57,"إني لقاسي القلب إن كنت صابرا","https://www.aldiwan.net/poem26318.html","الطويل"],[79,"ياصاح لا تبك عهدا للوصال مضى","https://www.aldiwan.net/poem36074.html","البسيط"],[90,"علام حرمنا منذ حين تلاقيا","https://www.aldiwan.net/poem44994.html","الطويل"],[29,"لعل فراق الحي للبين عامدي","https://www.aldiwan.net/poem5733.html","الطويل"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[87,"يمد الدجى في لوعتي ويزيد","https://www.aldiwan.net/poem63672.html","الطويل"],[47,"غروب دمع من الأجفان تنهمل","https://www.aldiwan.net/poem65629.html","الخفيف"],[101,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[63,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[68,"اليوم زعزع ركن المجد وانهدما","https://www.aldiwan.net/poem40121.html","البسيط"],[99,"جمالك الهادئ الرزين","https://www.aldiwan.net/poem24582.html","مخلع البسيط"],[107,"يا منذر السوء غض الصوت إن لنا","https://www.aldiwan.net/poem43124.html","البسيط"],[107,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[48,"نراقب ضوء الفجر والليل دامس","https://www.aldiwan.net/poem22783.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[108,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[111,"بصائرنا في القضا خامدة","https://www.poetsgate.com/ViewPoem.aspx?id=522",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[147,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[147,"عداكم هوى مذ شفنا ما تعدانا","https://www.aldiwan.net/poem11834.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[227,"يسوم منا العداة ودا","https://www.aldiwan.net/poem55421.html","مخلع البسيط"],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[369,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[422,"إن جئت آل سلمى أو مغانيها","https://www.aldiwan.net/poem54145.html","البسيط"],[463,"بكرت عليه ضلة تعذلينه","https://www.aldiwan.net/poem55848.html","الطويل"],[463,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[470,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[482,"انا لتتحفنا بالأنس كتبكم","https://www.aldiwan.net/poem15366.html","البسيط"],[511,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[519,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[556,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138331",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138372",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96992","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38707","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77639","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59426","الوافر"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138166",""],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133831","الوافر"],[1194,"","https://poetry.dctabudhabi.ae/diwan/poem/206180","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65004","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109054","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49577","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100471","الوافر"],[2244,"","https://poetry.dctabudhabi.ae/diwan/poem/202677","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77307","البسيط"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98163","المنسرح"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205878","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127398","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129384","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103013","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127125","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198210","السريع"],[4693,"إذا كان بالحب يأتي الخجل","https://www.poetsgate.com/ViewPoem.aspx?id=29929",""],[4734,"فجر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=50227",""],[4740,"لا نامت أعين الجبناء","https://www.poetsgate.com/ViewPoem.aspx?id=206374",""],[4755,"مُجتَمَعُ العَناكِب","https://www.poetsgate.com/ViewPoem.aspx?id=205179",""],[4771,"وَكيف نَرجو السحابَ الجَودَ مِن رَجُلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=106548",""],[4831,"كُنّا وصرنا","https://www.poetsgate.com/ViewPoem.aspx?id=208617",""],[4858,"حنين إلى الأهل والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=138206",""],[5038,"هذي بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=189564",""],[5072,"رهو ٌ هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=51900",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5358,"ناصية الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=21905",""],[5413,"ديغول عادَ","https://www.poetsgate.com/ViewPoem.aspx?id=208605",""],[5464,"يا جبل الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=6672",""],[5616,"إليك يا قمري المسجى","https://www.poetsgate.com/ViewPoem.aspx?id=204868",""],[5616,"إلى من كان صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=205215",""],[5691,"أطواق منضدة","https://www.poetsgate.com/ViewPoem.aspx?id=206439",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""],[5879,"عفا الله","https://www.poetsgate.com/ViewPoem.aspx?id=215437",""],[6189,"عيبان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83602&r=&rc=69",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""],[5616,"إلى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1928&r=&rc=3",""],[6355,"في العشر الأواخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66599&r=&rc=59",""]],"verses":[["وَكَيفَ نَومُ المَرءِ مِن تَحتِهِ","دونَ الكَرى مُضطَرَبُ الأَرقَمِ",0,"م",1,0],["وَكَيفَ نَعذُلُ مَن يَبكي لِمَيِّتِهِ","وَنَحنُ نَبكي عَلى أَيّامِنا الأُوَلِ",1,"ل",1,0],["وَكَيفَ نَأمُلُ أَن تَبقى الحَياةُ لَنا","وَغَيرُ راجِعَةٍ أَيّامُنا الأُوَلُ",2,"ل",1,0],["وكيف نُحاوِلُ كِتْمانَهُ","وقد أخْضَلَ العَبَراتُ الجُفونا",3,"ن",2,0],["وَكَيفَ نَوَوا بَيناً وَأَنتِ أَميرَةٌ","عَلى كُلِّ بَينٍ ما عَلَيكِ أَميرُ",4,"ر",1,0],["وَكَيْفَ نَرْهَبُ مِنْ خَطْبٍ أَلَمَّ بِنَا","يُوْماً ويُوسُفُ بَعْدَ اللَّهِ مَوْلاَنَا",5,"ن",2,0],["وكيف نرى للكهرباء ظواهراً","إذا هي في الأثبات لم تلق نافيا",6,"ي",2,0],["وَكَيفَ نَجاةٌ لِلفَرَزدَقِ بَعدَما","ضَغا وَهوَ في أَشداقِ أَغلَبَ حارِدِ",7,"د",1,0],["وكيف نُبكِّي فائزاً عند ربه","له في جنان الخلد عيشٌ مُخَرْفجُ",8,"ج",1,0],["وَكَيفَ نَأَت وَالأَمسُ آخرُ عَهدِها","لَأَمسُ كَباقي الغابِراتِ عَهيدُ",9,"د",1,0],["وَكَيفَ نَرجو خُلوداً لَم يُخَصَّ بِهِ","مِن قَبلِنا أَنبِياءُ اللَهِ وَالرُسُلُ",10,"ل",1,0],["وكيف نكتب والأقفال في فمنا؟","وكل ثانيةٍ يأتيك سفاح؟",11,"ح",1,0],["وكيفَ نَسَكْتَ بعدَ مَقالِ قَوْمٍ","إذا نَسَكَ المُخَّنثُ ماتَ جُوعا",12,"ع",2,0],["وَكَيفَ نَبكِيَ أَمراً كانَ الإِلَهُ لَهُ","في المالِ وَالآلِ وَالخَيراتِ قَد خَتَما",13,"م",2,0],["وكيف نلقاك في سرور","وكيف نلقاه خاشعين",14,"ن",1,0],["وَكَيفَ نَخشى مِنَ الأَحداثِ غائِلَةً","وَمُحكَمُ الذِكرِ يُتلى بَينَ أَيدينا",15,"ن",2,0],["وَكَيفَ نُطيعُ العاذِلينَ وَتَرتَقي","إِلَينا وِشاياتُ العِدى وَالنَمائِمُ",16,"م",1,0],["وَكَيفَ نَجاةُ المَرءِ أَو فَلَتاتُهُ","عَلى أَسهُمٍ قَد ناسَبَتها مَقاتِلُه",17,"ل",2,0],["وَكَيفَ نُرَجِّيَ لِلثِمادِ بَقاءَها","إِذا نَضَبَت عَنّا البُحورُ القَلامِسُ",18,"س",1,0],["وَكَيْفَ نَرْجُو مِنَ الأَيَّامِ عَافِيَةً","وَصِحَّةُ الْمَرْءِ مَقْرُونٌ بِهَا السَّقَطُ",19,"ط",1,0],["وكيف نأمَنُه والسُّمُّ في فمه","وليس يزحفُ إلا وَهْوَ فاغره؟",20,"ر",2,0],["وكيف نأمن قومًا لا أمان لهم؟","إني أرى كيدَهم تبْدُو بوادره",20,"ر",2,0],["وكيف نضن بأرواحنا","وتلك غنيمته البارده",21,"د",2,0],["وكيف نصرف عنه لحظ طالبه","أني ونائم هذا الدهر يقظان",22,"ن",1,0],["وَكَيفَ نُدرِكُ بِالأَشعارِ وَصفَ عُلىً","نَعُدُّ إِغراقَنا في وَصفِها حَصَرا",23,"ر",2,0],["وَكَيفَ نُغَطّي وَهوَ دانٍ غَرامَنا","وَنَكتُمُ ما نَلقى فَقَد بانَ مُذ بانا",24,"ن",2,0],["وَكيفَ نؤدّيهِ بشكر حقوقهِ","وَنعمتهُ بالشكرِ تَستوجبُ الشُكرا",25,"ر",2,0],["وكيف نجاتي كيف هيهات فالذي","سقيتم به روحي سيسرع في هدّى",26,"د",2,0],["وكيف نرعى ذمام قوم","ليس لهم في الزمام دين",27,"ن",1,0],["وَكيفَ نَخشى جَورَ أَيّامِنا","في عَصرِهِ وَالجَورُ مَفقودُ",28,"د",1,0],["وكيف نَلَذُّ أَعماراً قِصاراً","وقد أُودِعْنَ أَفكاراً طِوالا",29,"ل",2,0],["وكيف نأتي لها يوماً بثانية","وأنتَ يا واحد الآحاد منشيها",30,"ي",3,0],["وكيفَ نُزَنُّ بالغباوةِ فيكُمُ","فنجزِيَكم صعبَ الزمان ولينَه",31,"ن",2,0],["وكيف نرجِّي ودَّ يوم وليلةٍ","يزيدان مما يُعديان بنقصنا",32,"ن",2,0],["وكيفَ نُمسِكُ بالميزان ِ نَرفَعُهُ","إنْ لم نَكُنْ بِنِقابِ الحَقِّ نَنتَقِبُ؟",33,"ب",1,0],["وكيف نضجرُ منها وهي مُذْهِبَةٌ","مِن وحشةِ البينِ لوعاتٍ نُعانيها",34,"ي",3,0],["وكيفَ نمنُ على من بِه","نُؤَمِل للسّيئات اغتِفارا",35,"ر",2,0],["وكيفَ نُرجّي أنّ لليلِ آخِراً","وفي ظُلُماتِ الأرضِ قد دُفِنَ الفَجْرُ",36,"ر",1,0],["وَكيفَ نسيتِ الّذي كان فيكِ","من العزّ والكرم الأرحبِ",37,"ب",1,0],["وكيف ننكر ما ابديت يا بطلا","بالفضل والنبل والانصاف متصفا",38,"ف",2,0],["وَكيف نمقت سلطانا كأب","يسعى لخير بنيه باذلَ الهمم",39,"م",1,0],["وكيف نغادي أو نراوح معشراً","يميل بنا عنهم ولا كم ويصرف",40,"ف",1,0],["وَكَيفَ نَرى ما فيهِ فَخرٌ سُبَّةً","إِذا ما رَأتهُ عامِرٌ وَسَلولُ",41,"ل",1,0],["وَكَيفَ نَأبى أَمره المَنشورا","وَبَطشه فينا غَدا مَشهورا",42,"ر",2,0],["وكيف نعمه أوصاف شاد","وفضل الله خصذصه بصادي",43,"د",2,0],["وكيف نمت أوطاره وتعددت","وقد كان لا همُّ له ولا قصد",44,"د",1,0],["وكيف نطيق دفع الضيم أما","يهم بنا ونحن على حدود",45,"د",1,0],["وكيف نمى حتى استتم كماله","وكيف ذوي إذ صار كالثوب باليا",46,"ي",2,0],["وكيفَ نَرْجو ثَباتَ فانٍ","لو كان يَبْقَى لما بَقينا",47,"ن",2,0],["وكيفَ نَعْصي وقد عَلِمْنا","أَنَّا إِلى اللهِ راجعونا",47,"ن",2,0],["وكيف نطيق عيشاً مع قنوط","تعذر بعده العيش الرغيد",48,"د",1,0],["وكيْفَ نسْلوا بلَهْو أَوْ يَحقّْ لنا","تجَنَّبُ اللَّهْو عنْ حِلْمٍ وتجْريبِ",49,"ب",1,0],["وكيف نجدُّ في استسقاءِ غَيْثِ","لقبرٍ ضُمّنَ الغيثَ الهَطُولا",50,"ل",2,0],["وكيف نرى الثناء على عليم","عليه المجد دون الناس أثنى",51,"ن",2,0],["وكيف نسخت المدح بالذم قبل أن","تبث لي الشكوى وتدلي بما تدلي",52,"ل",2,0],["وَكَيفَ نَرضى لَهُنَّ الجَهل مَنزِلَةً","وَهُنَّ حَولَ حِمى الأَوطانِ أَسوارُ",53,"ر",1,0],["وكيف ننفك عن هواك وقد","كنت لنا عدة من العدد",54,"د",1,0],["وكيف ننسى وهذا صوتها غرد","يرن في مسمع الدنيا ويشجيها",55,"ي",3,0],["وكيف ننسى فتى حاكت عزيمته","حد المهند وهو الصارم الذكر",56,"ر",1,0],["وكيف نعد البيض بيضا وفي الوغى","مواضيه قد عادت وألوانها حمر",57,"ر",1,0],["وكيف نعود عنك بغير ريّ","وأنت البحر ذو المدد العظيم",58,"م",1,0],["وكيف نخشى صولة الأعادي","وعندنا الشجاع ذوا الأيادي",59,"ي",1,0],["وكيف نخشى سربهم وإن دنا","ورجلٌ من الكرام عندنا",59,"ن",2,0],["وكيف نهنيكم بعيد وأنتم","بعقد البها قلدتم جيد ذا العصر",60,"ر",1,0],["وكيفَ نُؤتي اليأْسَ دُونَ المُنى","و((زائِدٌ)) فيه المُنى والمرَامْ",61,"م",1,0],["وكيف نعيش حياة الغرام","وكيف نفسر حب الاول",62,"ل",1,0],["وكيف نزيل هموم الزمان","ونسعى إلى جرحها يندمل",62,"ل",1,0],["وكيفَ ننامُ إنَّ الذئبَ ذئبٌ","وإنْ أخفى عن الأنظار نابا",63,"ب",2,0],["وَكَيْفَ نَفْخَرُ ... وَالتَّارِيخُ ... يَلْعَنُنَا","وَمَا 