نجود","https://www.poetsgate.com/ViewPoem.aspx?id=201738",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5442,"سل الركب هل مروا بجرعاء مالك","https://www.poetsgate.com/ViewPoem.aspx?id=114770",""],[5503,"أجزت لَهُم مَا يسْأَلُون بِشَرْطِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194722",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[243,"حب وشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=19624",""],[5668,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=178829",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[5781,"لم يْشفِهِ الطبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=210379",""],[402,"صدق النعي ورددد الهرمان","https://www.poetsgate.com/ViewPoem.aspx?id=36491",""],[402,"يا وزير الشباب أنت خليق","https://www.poetsgate.com/ViewPoem.aspx?id=35095",""],[5956,"كل يوم نحن في حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=182078",""],[5956,"معزوفة حب","https://www.poetsgate.com/ViewPoem.aspx?id=182082",""],[5956,"شمسٌ وظلال","https://www.poetsgate.com/ViewPoem.aspx?id=192981",""],[5956,"يا مُحِبَّ الشرِّ","https://www.poetsgate.com/ViewPoem.aspx?id=194891",""],[5956,"ذكرى وفاة زهرة الشمعة","https://www.poetsgate.com/ViewPoem.aspx?id=215786",""],[6152,"وفقنا يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=213155",""],[520,"دانت لأمرك طاعة الأقدار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577511",""],[242,"ألا قل لمن يبغي الى العز منفذا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563806",""],[463,"أفاقَ بها منْ طولِ سكرته الدَّهرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60097&r=&rc=153",""],[1408,"يا نسيم الجنوب بالله بلغ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84831&r=&rc=83",""],[572,"أخي لا تُروِّعني فأصبو إلى أخٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9343&r=&rc=200",""]],"verses":[["وَوَفدُ هُمومٍ ما أَقَمتُ بِبَلدَةٍ","وَهُنَّ مَعي إِلّا وَضاقَت رِحابُها",0,"ب",3,0],["ووفت بحق القبة العليا التي","نادت بها عجلاً فقالت هاك",1,"ك",1,0],["وَوَفاءٌ إِذا أَجَرتَ فَما غُر","رَت حِبالٌ وَصَلتَها بِحِبالِ",2,"ل",1,0],["وَوَفَّقتَ بَينَ الدينِ وَالعِلمِ وَالحِجا","فَأَطلَعتَ نوراً مِن ثَلاثِ جِهاتِ",3,"ت",1,0],["وَوُفِّيَ الفَوزَ بِها وَالرِضى","وَوُقِّيَ الأَسواءَ وَالأَبؤُسا",4,"س",2,0],["وَوَفَى لِمِصْرَ بِرَدِّةِ مِنْ حَقِّهَا","مَا كَادَ يَسْتَعْصِي عَلَى الإِمْكَانِ",5,"ن",1,0],["ووفيتني حقّ الجوار يكاد أن","يكون من الحظّ الحرون مجيرا",6,"ر",2,0],["ووفى بفيَّاض النوال فما على","عافيهِ أن يرِدَ النمير بلا رشا",7,"ش",2,0],["ووفّر سعي البيض في حومة الوغى","فنام إذاً في جفنه كلّ مخدَم",8,"م",1,0],["ووفى الملك ما شرطت عليه","تكاليف الكفالة والزّعامهْ",9,"م",2,0],["ووفت بموعِدها يدٌ نفَّاحةٌ","من حقّها الإفضالُ والتقبيلُ",10,"ل",1,0],["ووفودُ السلامِ والشكرِ يغدو","ن قياماً إليه بعدَ قيام",11,"م",1,0],["وَوَفد ثناءٍ أناخوا به","عفاةً لمعروفه آملينا",12,"ن",2,0],["وَوَفاءٌ نَبَتَّ فيهِ وَلَكِن","لَم يَزَل لِلوَفاءِ أَهلُكَ أَهلا",13,"ل",2,0],["ووفِّر عليهِ كلَّ مَا مَدَّ عينَهُ","إليهِ ولا تمدُدْ إِلى ما رأى يدَا",14,"د",2,0],["وَوَفراءَ لَم تُخرَز بِسَيرٍ وَكيعَةٍ","غَدَوتُ بِها طَيّاً يَدي في رِشائِها",15,"ا",3,0],["وَوَفِّر عَلى الجِسمِ الدِماءَ فَإِنَّها","لِقِوَّةِ جِسمِ المَرءِ خَيرُ الدَعائِمِ",16,"م",1,0],["وَوَفّاكَ مَن لَم تَنسَ في الدَهرِ ذِكرَه","شَفاعَتَهُ وَالناسُ في الحَشرِ كَاللُكنِ",17,"ن",1,0],["وَوَفَيتُ إِنَّ مِنَ الوَفاءِ تِجارَةً","وَشَكَرتُ إِنَّ الشُكرَ حَرثٌ مُطعِمُ",18,"م",1,0],["وَوُفودُ النَجمِ واقِفَةٌ","لا تَرى في الغَربِ أَبوابا",19,"ب",2,0],["وَوَفَى قدرُ بَيْضَةٍ مِنْ نُضَارٍ","دَيْنَ سَلْمَانَ حِينَ حانَ الوفاءُ",20,"ا",2,0],["وَوفّى منهُ سَلْمانٌ دُيُوناً","عليه ما يُوفِّيها جَرِيبُ",21,"ب",1,0],["ووفَوْا فلم يدَعوا الوفاءَ لجارهم","حتى تشتّتَ شملُهُمْ وتخرّبا",22,"ب",2,0],["وَوَفاءٍ بِما أَقَرّوا عَلى الأَن","فُسِ وَأياً في العِسرِ وَالتَيسيرِ",23,"ر",1,0],["وَوَفْقَ السَّمَاعِيِّ الْحَبِيبِ شُذُوذُهُ","وفَوْقَ الْقِيَاسِيِّ الَّذي الْعُرْفُ يُؤْثِرُ",24,"ر",1,0],["وَوفَاءٍ لِلآلِ وَالصَّحْبِ وَالأوْ","طَانِ في حِينِ عَزَّ أَهْلُ الوَفَاءِ",25,"ا",2,0],["وَوَفَتْ قَوَافِيهَا بِمَا أَمْلَى عَلَى","قَلَمِي خُلُوصُ تَجِلَّتِي وَإِخَائِي",25,"ا",2,0],["ووفينا وحاصدُ الجوعِ يُردي","من حقول النفوس حقلا فحقلا",26,"ل",2,0],["ووفينا حتى تركنا وفاء الناس","هزءاً وصادقَ احب هزلا",26,"ل",2,0],["وَوَفَيْتُمُو لبلادكم بالعهد في","زمنٍ يقلُّ به الأمينُ الوافي",27,"ف",2,0],["ووفق له التوفيق في كل حالةٍ","وسلكه في سبل الشريعة بالأمر",28,"ر",1,0],["ووِفاقُ كُلٍّ أن تقابل بالذي","يرضيك منه وفاعلٌ ذي قلّما",29,"م",2,0],["ووفاء الدهر بالذي أرتجيه","وبأفراحهِ الحسان حباني",30,"ي",1,0],["ووفا السرور وجاء إبانُ الصفا","فاليومُ يفرحُ قلبَ كل حزينِ",31,"ن",1,0],["وَوَفى لِاِسمِهِ وَكُنيَتِهِ العَز","مُ فَقاما مَعاً مَقامَ الفالِ",32,"ل",1,0],["وَوَفِّر بِقَسطونَ قِسطَ النُزولِ","بِصَحرائِها فَالمُسيؤونَ هُم",33,"م",1,0],["وَوَفَّرتُ قِسمي مِن صَفاءٍ مَوَدَّةٍ","مَكاني بِها الأَعلى وَحَظّي بِها الأَسنا",34,"ن",2,0],["وَوَفّهمَا ولَستَ تطيقُ برّا","بما منحاك في كلّ المناح",35,"ح",1,0],["ووفد من الشرى تحطَ وخلفهم","من النصر والفتح المبين وفودُ",36,"د",1,0],["وَوَفاءَ مَيمُونِ النَقِيبَةِ حارِثٍ","وَحَمِيَّةَ المَلِكِ المُعَظَّمِ هاني",37,"ن",2,0],["ووفيتَ لي لما صَحِبتُك في الوَغَى","فإذا التمسْتُك بالسلوِّ تَخُون",38,"ن",1,0],["وَوَفى اللَّه وعدهُ وله الحم","دُ وَحتّى المعاد هذا الوفاءُ",39,"ا",2,0],["ووفيتها ما فوق فوق حقوقا","فلا بدع ان تختال في حلل الفخر",40,"ر",1,0],["ووفنى حق قريضى فما","مثلي يشوب الجد بالهزل",41,"ل",1,0],["وَوَفَّقتَ بين الشَرعِ وَالعَقلِ بَعدَما","قد اعتَقَد الإِلفانِ أَلّا تَلاقيا",42,"ي",2,0],["وَوَفيٌّ مِن سَجايا","ه تَعَلَّمنا الوَفاءا",43,"ا",3,0],["وَوُفودٌ عَلى وُفودٍ أَبادَت","عيسَهُم في رَجائِكَ البَيداءُ",44,"ا",2,0],["وَوَفِّرْ ماءَ وَجْهِكَ لاَ تُرِقْهُ","تَرِدْ ماءَ الْمَحَامِدِ ذَا انْتِضَاخِ",45,"خ",1,0],["وَوَفِّرْ بِبَذْلِ الْوَفْرِ عِرْضَكَ مِنْ أَذىً","وَذُدْ بِالسَّخَاءِ الذَّمَّ عَنْكَ وَأَشْقِذَا",46,"ذ",2,0],["وَوَفِّقِ اللَّهُ بِطَانَتَهُ","وَسَدِّدَنْ يَا رَبَّنَا رَأْيَهْ",47,"ي",2,0],["ووفاءٌ تثبَتَ الحبُّ به","وثباتُ الحبِّ في الناسِ الوفاء",48,"ا",2,0],["وَوَفْدِ ثَناءٍ بَعَثْنا إِلَيْ","كَ يَشْتاقُ أَهْلُ النُّهى مَقْدَمَهْ",49,"م",2,0],["وَوفت بمَوعِدها وَباتَ وشاتُها","للوجد بين عَمٍ وآخر أَخرسِ",50,"س",1,0],["وَوَفِّق وَسَدِّد وَأَصلِحِ الكُلَّ وَاِهدِنا","لِسُنَّةِ خَيرِ الخَلقِ وَالسَيِّدُ الحُسنِ",51,"ن",1,0],["ووفقهم للخير ثم أثابهم","برضوانه عنهم وبالوطن العلى",52,"ل",2,0],["وَوفورُ حزمٍ على حسن ظنٍّ","وَنفاذُ عزمٍ على اِطمئنانِ",53,"ن",1,0],["وَوفورُ خبرٍ في مداراة الورى","وَبصيرةٌ بِزمانهِ وتضلّعُ",54,"ع",1,0],["وَوَفاهُ البَشيرُ وَقالَ أَرخِ","يَعيشُ مُحَمَّدٌ وَتَراهُ يَربَحُ",55,"ح",1,0],["وَوَفَاءُ النِيل مُذْجَا","رَيْتَهُ لا يُجحَدُ",56,"د",1,0],["وَوِفقاً غَدا قَلبي لَجامِعُ حُسنِها","فَأَضحى لَها مَنّي تَفاصيلُ جُملَتي",57,"ي",1,0],["ووِفادَتي في كُلِّ عامٍ زائراً","وإفادتي شَرفاً رفيعَ المطْلَع",58,"ع",1,0],["ووفَى لها نَجْدٌ وقد","غَدِرَتْ بها للغَوْرِ غُدر",59,"ر",1,0],["ووفقنا لشكرك مابقينا","وعبرنا على الخوف آمنينا",60,"ن",2,0],["ووفق الكل للشكر لهذا النعيم","واختم تخير إذا حان الأجل ياعليم",61,"م",1,0],["ووفق وسدد واصلح الكل واهدناه","وأختم لنا بالخير عند المنية",62,"ه",1,0],["ووف الشرط منها","وأركانا وهيآت",63,"ت",1,0],["ووفقني لما يرضيك عني","وألهمني لشركالاك دوبي",64,"ب",2,0],["ووفقني وقومني على سنة","المختار خير الأنبياء",65,"ا",2,0],["ووفاد الحجيج لكم ضيوف","وأنتم صفوة الآل الكرام",66,"م",1,0],["ووفاؤه طبع وكل فتى","فوفاؤه إن كان بالكسب",67,"ب",1,0],["ووفَا لها منه هِزَبْرٌ خَلْفَه","طُلْسُ الذِّئابِ مع الذَّوابِلِ تَعْسِلُ",68,"ل",1,0],["ووُفِّيتَ أَجْرَ الصابِرينَ مُضاعَفاً","من الدينِ والدُّنيا لَكَ المَنُّ والمَنْحُ",69,"ح",1,0],["وَوَفَتْ بعهدِ العِلْمِ ذِمَّتُهُ","إِذ لَمْ يُضَيِّعْ مثلُهُ مِثْلِي",70,"ل",2,0],["ووفَيْتَ للدُّنيا بعهدِ مكارِمٍ","سَقَتِ البلادَ عِهادُها المتعاهِدَهْ",71,"د",2,0],["ووفق اللَه لي سعياً على عج