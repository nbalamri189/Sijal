{"poems":[[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[50,"لا تبك رسما بجانب السند","https://www.aldiwan.net/poem62559.html","المنسرح"],[52,"يا أبا الفضل لا تنم","https://www.aldiwan.net/poem62225.html","مجزوء الخفيف"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/14439","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[108,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[463,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64909","المنسرح"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119208","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132523","الخفيف"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71302","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111427","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93297","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33265","الوافر"],[669,"لعمرك ما من مسجد بعد مسجد","https://www.poetsgate.com/ViewPoem.aspx?id=18401",""],[4119,"بين فتور المقلتين والكحل","https://www.poetsgate.com/ViewPoem.aspx?id=16221",""],[5183,"سمراء النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185681",""],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5431,"ياعراق....","https://www.poetsgate.com/ViewPoem.aspx?id=207993",""],[5433,"عين تشربك شوف","https://www.poetsgate.com/ViewPoem.aspx?id=36228",""]],"verses":[["بين فرقيه برزخ مثل رضوى","عفق البثق فانتهى معفوقا",0,"ق",2,0],["بَينَ فَسيلٍ يَحُفُّها خَضِلٍ","وَبَينَ آسٍ بِالرَيِّ مُنفَرِدِ",1,"د",1,0],["بَينَ فَخذَيهِ حَربَةٌ","في غِلافٍ مِنَ الأَدَم",2,"م",1,0],["بَينَ فُرشٍ مَبثوثَةٍ وَزَرابِي","يٍ رِياضٍ وَعَبقَرِيٍّ حِسانِ",3,"ن",1,0],["بَيْنَ فَرْعٍ وَبَيْنَ أَصْلٍ زكِيٍ","هَلْ يَتِمُّ النَّمَاءُ مِنْ غَيْرِ إِصْرِ",4,"ر",1,0],["بَينَ فكّي غِرارٌ مُحسِنٌ","ضَربَ ما قصَّر مِنهُ أَو حَلَق",5,"ق",1,0],["بين فكِّي ولساني صُنتُه","لم يَلُك إثمًا، ولم يَمضغُ حراما",6,"م",2,0],["بين فؤادي فيهم وبين فمي","شواجرٌ في الحِفاظ تختصمُ",7,"م",1,0],["بينَ فُؤادي وبَيْنَ راحتِهِ","ما بَينَ عَيْني وبَيْنَ مرآكِ",8,"ك",1,0],["بين فرضين من جهاد وشهر","أنت في الناس مثله في الشهور",9,"ر",1,0],["بين فضلك الجلي ولكن","لا ترى الشمس مقلة عمياء",10,"ا",2,0],["بَينَ فُؤَادِي وخَدِّهِ نَسَبُ","كِلاَهُمَا بِالجَحِيمِ يَلْتَهِبُ",11,"ب",1,1],["بَينَ فارِيسَ ذا الخِصامُ وبيني","قد دَهَاكم بفاجِعاتِ الزَّمانِ",12,"ن",1,0],["بين فيه ما خفي على العرب","ونال فيه كل سام من رُتَب",13,"ب",1,0],["بين فتور المُقلتيْن والكَحَلْ","هوىً له من كلّ قلبٍ ما انتحلْ",14,"ل",1,1],["بينَ فتيانٍ كرامٍ","من بني النعمةِ صيدِ",15,"د",1,0],["بين فضلا من مصلى مبارك","بكوفان رحب ذي أراس ومحصب",16,"ب",1,0],["بين فتور المقلتين والكحل","هوى له من كل قلب مل انتحل",17,"ل",1,1],["بين فل ونرجس ورياح","ين كثغر ومقلة وعذار",18,"ر",1,0],["بين فني وبين فنك بون","بات بينا ما بيننا ونزاعا",19,"ع",2,0],["بين فخديك ماؤنا الدفاق","فاتخذني حبيبة ياعراق",20,"ق",1,1],["بين فرحة لقاك وهم فرقاك","لاتذكرت جرح ولا نسيتك",21,"ك",1,1]]}