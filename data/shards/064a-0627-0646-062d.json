{"poems":[[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[48,"يا نحل إن شار شهدا مكتسب","https://www.aldiwan.net/poem22624.html","البسيط"],[48,"يا نحلُ، إن شارَ شُهداً منك مكتسِبٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=20192",""],[170,"يا نحس يا كيوان فعلك كله","https://www.aldiwan.net/poem47113.html","الكامل"],[563,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[563,"لي في الإله عقيدة غراء","https://www.aldiwan.net/poem35090.html","الكامل"],[1324,"","https://poetry.dctabudhabi.ae/diwan/poem/99306","الكامل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101427","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109780","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40085","الخفيف"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127773","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199120","الرمل"],[5187,"درس في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29792",""],[5335,"اكحل عينها","https://www.poetsgate.com/ViewPoem.aspx?id=36041",""],[5431,"ماضلتِ الصحفُ..","https://www.poetsgate.com/ViewPoem.aspx?id=187578",""],[5956,"أرتين \"وَوِيل تْشير\" جدِّهِ العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=205425",""]],"verses":[["يا نحلةَ الشهد التي أيأست","منه وإن غرت فلم تُؤيس",0,"س",1,0],["يا نَحلُ إِن شارَ شُهداً مُكتَسِبٌ","فَحَسبُهُ أَنَّ بَعدَ المَوتِ إِنشارا",1,"ر",2,1],["يا نحلُ، إن شارَ شُهداً منك مكتسِبٌ","، فحَسبُهُ أنّ، بعدَ الموتِ، إنشارا",2,"ر",2,1],["يا نحسُ يا كيوانُ فعلُكَ كلُّه","سمجٌ لديَّ فما لَكَ استملحتَهُ",3,"ت",2,1],["يا نحلُ أَوحى إليك الرب فاتخذي","من الجبال بيوتاً واسلكي ذُلَلا",4,"ل",2,0],["يا نحل قد أوحى إليك إلهنا","ومن الجبال بيوتك الأفياء",5,"ا",2,0],["يا نحل أنت غريبة مثلي","في الغرب نائية عن الأصل",6,"ل",1,1],["يَا نَحِيفَ القَوامِ من غيرِ ضَعْفٍ","وَسَقِيمَ الجُفُونِ من غَيرِ عِلَّه",7,"ل",2,0],["يا نحاً عيني برؤية خطه","ما فات اذني من سماع كلامه",8,"م",2,0],["يا نُحاة اِلزَموا الشكَك","ثُمَّ حلُّوا عنِ التّككْ",9,"ك",1,1],["يا نحلةً لم أَذُق من طعم عسلَتِكِ","كفي عن اللَّسعِ لا لَسعٌ ولا عسلُ",10,"ل",1,0],["يا نحاة الوقت هل فيكم مجيب","لسؤال فيه يحتار اللبيب",11,"ب",1,1],["يا نحلتي.. لا تيئسي وغداً","تتعشقينَ حلاوةَ العسلِ",12,"ل",1,0],["يانحيل العود ياعزي لحالك من شطونك","سيرتك في دفتر الاشعار ماني منتسيها",13,"ي",3,0],["يانحلة الروح هل شمعتِ قصتنا","فالحب عسّلها والشهد مغْترَفُ",14,"ف",1,0],["يا نحس من يمضي إلى تقبيلهِ","تلقاه صار مبخّراً تبخيرا",15,"ر",2,0]]}