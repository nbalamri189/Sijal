{"poems":[[47,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[435,"لاح في مهد المعالي والسنا","https://www.aldiwan.net/poem40715.html","الرمل"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[543,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105010","الخفيف"],[2339,"","https://poetry.dctabudhabi.ae/diwan/poem/31389","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67993","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126968","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138518",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138563",""],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111313","الرمل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45974","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97070","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83519","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83134","الرمل"],[4988,"ذكرياتي الأوليّة","https://www.poetsgate.com/ViewPoem.aspx?id=208808",""],[5307,"يا هِبوب الوَرد والفِلّي","https://www.poetsgate.com/ViewPoem.aspx?id=10535",""],[5484,"روع الكون وادلهم السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206305",""],[5956,"منطقُ الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=192220",""],[5993,"تميم ماقصرت وابوك رباك","https://www.poetsgate.com/ViewPoem.aspx?id=189008",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""]],"verses":[["يا لِخُضرٍ يَنُحنَ في القُضُبِ الخُض","رِ عَلى كُلِّ صاحِبٍ مَفقودِ",0,"د",1,0],["يا لخطب العلم في أبنائهِ","إنهُ منهم بداءٍ معضِلِ",1,"ل",1,0],["يا لخودٍ ترتعي القلب الكريم","وأذلت بالهوى كل كريم",2,"م",1,0],["يا لخالٍ من مكاني قلبُه","بعد ودِّي كيف بالرأي أخلّْ",3,"ل",1,0],["يا لَخطيبٌ قد سكَن","مِنبَرهُ فكُلّ مَن",4,"ن",1,0],["يا لخطب دهى الرشاد فجلاَّ","رحل الزهد والتقى حين حلاَّ",5,"ل",2,0],["يا لِخَولانَ بنَ عَمرٍو أَنصَفوا","قَبلَ نَنفيكُم مِن أَوطانِ البَلَد",6,"د",1,0],["يَا لَخَطْبٍ بالمعالي قَدْ دَهَى","لدَهاه لَمْ تذق عيني الوَسَن",7,"ن",1,0],["يا لخطب جل في الطف عظيم","وقعه كان على الدين جسيم",8,"م",1,0],["يا لخطب حول الكون بكا","لم تجد من حادث إلا بكاه",9,"ا",2,0],["يالخدر بالظبا يحمى غدا","مغنما للقوم ثقلاً ومتاعا",10,"ع",2,0],["يالخد جمع الضدين","ماء ماج نارا",11,"ر",2,0],["يا لِخَطبٍ أَناخَ فينا عَظيمٌ","فُقِدَ الصَبرُ عِندَهُ وَالعَزاءُ",12,"ا",2,0],["يا لخطب جرى على علة الكون","وغيث الدنيا وغوث العباد",13,"د",1,0],["يا لِخَطب الزَمانِ في محرقاته","يا لِخَطب الزَمان في خانِقاته",14,"ت",2,0],["يا لخفّاقٍ إِذا ما","قَرَّ هَزَّتهُ شُجونُه",15,"ن",2,0],["‏يالخوي هالحال من يدرك مداها","والليالي عقٌب خلّي جرهدية",16,"ي",2,1],["يالخِويْ كانِك تِبيَ اَلْخِلّيَ","جَرِّب البَنّايْ للجَاري",17,"ر",2,0],["يالخطب من دونه كل خطب","ومصاب قد عز فيه العزاء",18,"ا",2,0],["يا لخبثِ الكونِ هل صار العَمَا","بدل الشمس بأيدي من صَبا؟*",19,"ب",2,0],["يالخاين المكار كشفت نواياك","بوجيهنا فاره .. وبظهورنا ذيب",20,"ب",1,0],["يَا لَخَلخالُ رِجلِكِ- اليَومَ- أَمسَى","بِالثَّناءِ الجَمِيلِ وَالشُّكرِ يَلهَجْ",21,"ج",1,0]]}