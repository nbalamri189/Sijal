{"poems":[[74,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[53,"عاقب الله كل من قال إني مخنث","https://www.aldiwan.net/poem9227.html","مجزوء الخفيف"],[53,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[63,"لنا قهوة في الدن تمت شهورها","https://www.aldiwan.net/poem51644.html","مجزوء الطويل"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[276,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[422,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[466,"يا فارس الهولين عم رداهما","https://www.aldiwan.net/poem15443.html","الكامل"],[466,"هنئت بالعيد وأمثاله","https://www.aldiwan.net/poem16425.html","السريع"],[591,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198857","الطويل"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123709","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62769","الكامل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103931","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48285","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85018","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114249","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[5096,"عقبة بن نافع الفهري رضي الله عنه","https://www.poetsgate.com/ViewPoem.aspx?id=209070",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5386,"ياسمين بريحةٍ من نار","https://www.poetsgate.com/ViewPoem.aspx?id=34998",""]],"verses":[["بمباحث قد ناضلت بنواقدٍ","وفوائد قد غازلت بعيون",0,"ن",1,0],["بمَبيتي معَ اُمِّهِ","ليلةً لا تُثلَّثُ",1,"ث",1,0],["بمبان كالرَّواسي","وصِحانٍ كالصَّحاري",2,"ر",2,0],["بمُبيَضَّةِ الأحشاءِ سودٍ ظُهُورُها","مُزَنَّرةِ الأذنابِ حُمْرٍ نُحورُها",3,"ر",3,0],["بمبسوط كفِّ الجودِ للرّزقِ قاسِمٍ","ومسلولِ سيْفِ النصرِ للدين شامل",4,"ل",1,0],["بِمُبَارِكٍ فِي مَعْشَرٍ","كَالجَيْشِ مِنْ نَسْلٍ كَرَمْ",5,"م",1,0],["بمبارك الوجه الَّذي نفحاته","في المحل تحكى الزاخر المتلطما",6,"م",2,0],["بمبعثه إِنجيلُ عيسى مبشِّرٌ","وَتَوراةُ موسى والزبورُ مُترجمُ",7,"م",1,0],["بِمَباحِثٍ للحقِّ في ميدانها","إحجامُ كلّ سميدع مقدام",8,"م",1,0],["بمبدعَيْن في الذي جاءا به","وإنما تقفَّيا تلك السُّبُلْ",9,"ل",1,0],["بمبادريْنِ إِلى الطِّعانِ مُهَمْلجٍ","فوق الطُّروس وطامرٍ مُتمطِّرِ",10,"ر",1,0],["بمُبْرمِ الحَزْمِ مَريرِ القُوى","جَلْدٍ على عَسْفِ العُلى صابِرِ",11,"ر",1,0],["بِمُبَخّلٍ في عِرْضِهِ وَذِمَامِهِ","سَمْحِ اليَدَين بِجَاهِهِ وَبِمَالِهِ",12,"ل",2,0],["بمبعثه كلّ النبيين بشرت","ولا مُرسلٌ إلا له كان يطنب",13,"ب",1,0],["بمبدئه له صنو عزيز","ففرّق بينهم بالاختلاس",14,"س",1,0],["بمُبَخّلِ الأنواءِ لولا جُودُهُ","عزَّ الترابُ لكثرةِ الطُّلابِ",15,"ب",1,0],["بمبتني المجد مذ خلت تمائمه","بحيث لا نوب الدنيا تضعضعه",16,"ع",2,0],["بمُبدّدٍ في الحرْبِ كُلَّ مُبدّلٍ","ومحرِّمٍ إبْقاءَ كُلِّ مُحرّفِ",17,"ف",1,0],["بِمُبتَداً أَخبَرتَ في الحُسنِ مُذ","أَطلَقتَ إِذ قيدَت فيكَ العِنانِ",18,"ن",1,0],["بِمَبسَمِهِ الضَّحَّاكِ عَذَّبَ مُهجَتِي","وَحُسنِ بَلالٍ قَد عَلاَ خَدَّهُ الزُّهرِي",19,"ي",1,1],["بِمِبرَدِ النُحاسِ جُبنَ السَخلِ","وَتَقتُلُ المَزيجَ خَيرَ قَتلِ",20,"ل",1,0],["بمبرك الناقة ياما نظروا","من العجايب التي لا تحصر",21,"ر",1,0],["بمبادئٍ غَزَتِ الدِّيارَ، بدعْوةٍ","في كُنْهِهَا صِدْقٌ يُحاكي الهُدْهدَا",22,"د",2,0],["بمبعث جريس ثلاثا بسره","بدعوته أن يستجيب إذا يسمى",23,"م",2,0],["بُمْبيْ محطتنا والناس تزحمها","من كلِّ دربٍ وصوبٍ من عباديدِ",24,"د",1,0],["بمباديك وكلامٍ ....... يذكرونه عاشقينك","من دروبٍ ما تضيّع ... غير من يمشي وراك",25,"ك",1,0]]}