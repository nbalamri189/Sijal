{"poems":[[692,"","https://poetry.dctabudhabi.ae/diwan/poem/203769","الرجز"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87333","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87313","الرجز"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121328","الرجز"]],"verses":[["وهقعة شولتها منهزمه","وصرفة بفرغها مقدمه",0,"ه",1,0],["وهقلةٌ ترتاع من ظلّها","لها عرارٌ ولها زمرُ",1,"ر",1,0],["وَهَقعَةٌ في صُورةِ الجوزاءِ","فسوفَ أذكُرها لعينِ الرائي",2,"ي",1,0],["وَهَقعَةٌ مِن بَعدِها والهَنعَه","ذراعُ والنَّثرَةُ والطَّرفُ مَعَه",3,"ه",1,0],["وهقعةُ الجوِّ كفس","طاطِ عمودٍ منتصب",4,"ب",1,0]]}