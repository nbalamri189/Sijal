{"poems":[[95,"يا من رعيت النيل رعي موفر","https://www.aldiwan.net/poem11162.html","الكامل"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[47,"قد كان طيفك مرة يغرى بي","https://www.aldiwan.net/poem11429.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141980","الخفيف"],[37,"سيأتي أميرَ المؤمنينَ ودونَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=22169",""],[53,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[132,"أنا مذ نشأت بسيبكم مغمور","https://www.aldiwan.net/poem50604.html","الكامل"],[234,"أفحمتني بلطيف البر منك فما","https://www.aldiwan.net/poem50889.html","البسيط"],[302,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[385,"من لولهان كئيب","https://www.aldiwan.net/poem49235.html","مجزوء الرمل"],[398,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[402,"يا من رعيت النيل رعي موفر","https://www.aldiwan.net/poem11037.html","عموديه"],[409,"حتى م ذا الدهر بالتشتيت يرمينا","https://www.aldiwan.net/poem33381.html","الرمل"],[415,"يا أوحد العصر علا وعنصرا","https://www.aldiwan.net/poem31701.html","عموديه"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[469,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[484,"طال السبات فشأننا استلقاء","https://www.aldiwan.net/poem37618.html","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133823","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79942","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77879","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128070","الكامل"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110707","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120639","الرمل"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45357","الطويل"],[2744,"","https://poetry.dctabudhabi.ae/diwan/poem/130300","البسيط"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99464","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74251","الكامل"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13264","السريع"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82828","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66485","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101375","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102738","الخفيف"],[4260,"","https://poetry.dctabudhabi.ae/diwan/poem/200369","الخفيف"],[4935,"خل عنك الهزل خلي والكسل","https://www.poetsgate.com/ViewPoem.aspx?id=129317",""],[5538,"هب النسيم على محب ناءي","https://www.poetsgate.com/ViewPoem.aspx?id=142626",""],[6093,"يذكر النَّاس ُ كلَّ مَيْتٍ بخيرٍ ( الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=176024",""]],"verses":[["أَفْحَمْتَ دُونَ مَنْ لَمْ تُرْضِهِمْ","لَمَّا جَعَلْتَ الحُكْمَ لِلْمِيزَانِ",0,"ن",1,0],["أفحشُ القذف والهجاء لبورا","نَ طهورٌ كالرجمِ للمرجوم",1,"م",1,0],["أَفحَمتُ عَنكُم بَني النَجّارِ قَد عَلِمَت","عُليا مَعَدٍّ وَكانوا طالَما هَدَروا",2,"ر",3,0],["أَفَحَظُّ نَفسي ظَلتُ أُنقِصُ أَم عَلى","نَفسي غَداتَئِذٍ غَدَوتُ أُحابي",3,"ب",2,0],["أفحتم على ارسال دمعي","كلما لاح بارق في محيّا",4,"ي",2,0],["أُفحِّمُ فيها آلَ مروانَ إنَّهم","إذا عَمَّ خوفٌ عبدَ شمسٍ حُصونها",5,"ن",3,0],["أفحش القذف والهجاء لبورا","رانَ طهورٌ كالرجمِ للمرجوم",6,"م",1,0],["أَفْحَمْتنى حتى تحيَّر خاطِرى","وأنا الفصيح بما يُقالُ بصيرُ",7,"ر",1,0],["أَفْحَمْتَني بِلطيفِ البِرِّ منك فما","أَدْرِي بأيِّ مكافأةٍ أُكافِيكا",8,"ك",2,1],["أَفَحَقّاً لا تَمَلّون الجَفا","وَعذولي فيكم ملَّ المَلاما",9,"م",2,0],["أَفحَتّى الطَيف لا بِر","فق بِالصَب الكَئيب",10,"ب",1,0],["أَفَحكاهُ عَنهُم جِبرئيلُ لأَحمدٍ","اِسنادُ مجدٍ لَيسَ فيهِ سِنادُ",11,"د",1,0],["أفحمت دون الحقمن لم ترضهم","لما جعلت الحكم للميزان",12,"ن",1,0],["أفحمت عن كل شيء غير ذكركم","ونفر النوم دمع من أماقينا",13,"ن",2,0],["أفحمني شكرك عن أن أشكرا","نثرت من ذكري علي جوهرا",14,"ر",2,0],["أفحمتها نعماك وهي فصاحٌ","فيك فاطربْ للمفحماتِ الفصاح",15,"ح",1,0],["أفحمت بالإحسان كلّ مفوَّهٍ","منَّا وأنطقت الجماد الالكنا",16,"ن",2,0],["افحص عن الأزهار في أكمامها","إن هو إلا الروضة الفيحاء",17,"ا",2,0],["أفحقاً قد انتهى كل شيء","وتمادت في ليلها الظلماء",18,"ا",2,0],["أُفحِمَ المُطرِي فكنَّى مُغرِبا","إذ رأى ذكرَ اسمه لم يُطَقِ",19,"ق",1,0],["أفحمتني وأنا المُفوَّه","وأرقُّ من أثنى ونوَّه",20,"و",2,1],["أَفَحلٌ أَنتَ يا مَغرور أَم لا","فَكُن إِن لَم تكن في الآن فحلا",21,"ل",2,1],["أفحمتهم بالحق بل ألجمتهم","ووطئت مذ خضعوا على الاعناق",22,"ق",1,0],["أفحمت كل بليغ في فصاحته","حتى كأنك بالإعجاز قرآن",23,"ن",1,0],["أفحمتني فجناتي طائش","ولساني بين عيّ وبَكَم",24,"م",1,0],["أَفُحشاً وَخِبّاً وَاِختِناءً عَلى النَدى","كَأَنَّكَ أَفعى كَدِيَّةٍ فَرَّ مُحجَوي",25,"و",2,0],["أفحمت كل بليغ بالكتاب كما","جادلت بالسيف أهل الجد والجدل",26,"ل",1,0],["أفحين نام الأير منك وصلتنا","تبغي النكاح بغير أيرٍ ناهض",27,"ض",1,0],["أَفحَمتَني عَن عد كُل فَضيلة","فَطَفرت عَنها طَفرة النظام",28,"م",1,0],["أَفحَمَني النَظمُ البَديعُ الَّذي","فاقَت عَلى الدُرِّ مَعانيهِ",29,"ي",2,1],["أَفحَمت نَطقي وَأَفصَحُ ما","في رِجال النُطقِ أَفحَمُها",30,"م",3,0],["أَفحَمتَ خَصمك مُحتَجّاً عَلَيه بِلا","إِكراهَ في الدينِ حَتّى قالَ آمنا",31,"ن",2,0],["أفحمت شعلة الذكا بمعان","فضحت بالمعقول والمنقول",32,"ل",1,0],["افحص فؤادي يا دهري تجد حجراً","صلداً ولكنه بالخطب منقور",33,"ر",1,0],["إفحامَ من باحَثَه في محتِدِ","في كل علم وبكلِّ فَنَّ",34,"ن",1,0],["افحم اللسن مذاتي بكتاب","غاية في نهاية الإعجاز",35,"ز",1,0],["أفحل الخيل كلهن جواد","من جياد عتيقة الأنساب",36,"ب",1,0],["أفحص التاريخ فحصاً متقناً","وأقصدن بالفحص أخبار الدول",37,"ل",1,0],["أفحمت مغترس الظلال ببعده","عن شرعة الأنصاف بالأهواء",38,"ا",2,0],["أفْحشَ النَّاسُ في المَنايا مَقَالاً","رَجَوَا الهُجْرَ أن يخيفَ الحِمَامَا",39,"م",2,0]]}