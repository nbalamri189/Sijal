{"poems":[[55,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[85,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[93,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[68,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[82,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[46,"قل للأمير الأريحي الذي","https://www.aldiwan.net/poem30521.html","السريع"],[89,"ما لي وللدار من ليلى أحييها","https://www.aldiwan.net/poem8204.html","مجزوء البسيط"],[89,"أسل الديار عن الحبيب وفي الحشا","https://www.aldiwan.net/poem8290.html","الكامل"],[19,"حتى إذا رقد تنكب عنهما","https://www.aldiwan.net/poem372.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72239","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[79,"النصر نصك والحسام دليله","https://www.poetsgate.com/ViewPoem.aspx?id=34198",""],[92,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[93,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[128,"هل تذكرين وأنت من غزلانه","https://www.aldiwan.net/poem23738.html","الكامل"],[164,"ردي جفونك عن حشاي قليلا","https://www.aldiwan.net/poem58771.html","الكامل"],[199,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[234,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[295,"يا نجم هلا إن شكوت","https://www.aldiwan.net/poem11705.html","مجزوء الكامل"],[302,"ماست فأزرت بالغصون الميس","https://www.aldiwan.net/poem33241.html","الكامل"],[303,"قالت شهدت القوم ذا","https://www.aldiwan.net/poem36796.html","عموديه"],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[376,"دون اعتدالك حكم غير معتدل","https://www.aldiwan.net/poem57199.html","البسيط"],[382,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[415,"أعجب لمحتجب عن كل ذي نظر","https://www.aldiwan.net/poem32240.html","البسيط"],[438,"عزت ضمائره على كتمانه","https://www.aldiwan.net/poem12747.html","الكامل"],[475,"يبكي لما قلب الزمان جديده","https://www.aldiwan.net/poem4780.html","الكامل"],[511,"بشراي أبصرتك خير إمام","https://www.aldiwan.net/poem2462.html","الكامل"],[549,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64074","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77580","الرجز"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130625","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56582","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108554","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101022","الكامل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144760","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105844","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76654","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71033","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77414","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77204","الكامل"],[2959,"","https://poetry.dctabudhabi.ae/diwan/poem/99063","المنسرح"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65112","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87452","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68020","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91482","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91390","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91343","الكامل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105149","الكامل"],[4125,"","https://poetry.dctabudhabi.ae/diwan/poem/203234","البسيط"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4366,"","https://poetry.dctabudhabi.ae/diwan/poem/31514","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28620","الكامل"],[4691,"(( قل للصغيرة إياها وإيانا))","https://www.poetsgate.com/ViewPoem.aspx?id=61562",""],[4767,"إباء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179960",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[4980,"يَا نُورُ مَا تَأمُرِينَ القَلبَ","https://www.poetsgate.com/ViewPoem.aspx?id=191159",""],[4984,"مرَّ قطار صحبك","https://www.poetsgate.com/ViewPoem.aspx?id=175538",""],[5100,"قلب وثانية....","https://www.poetsgate.com/ViewPoem.aspx?id=207713",""],[5431,"لو...لو ...لو","https://www.poetsgate.com/ViewPoem.aspx?id=199908",""],[5952,"وَعَزَفْتُ","https://www.poetsgate.com/ViewPoem.aspx?id=196720",""],[6093,"ما للهوى أعذارُ","https://www.poetsgate.com/ViewPoem.aspx?id=178349",""],[6130,"شرفةُ حلمٍ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199248",""]],"verses":[["حَتّى إِذا رَكِبوا الرُؤوسَ مِنَ الكَرى","وَتَصَوَّبَ العَيّوقُ بَعدَ تَصَعُّدِ",0,"د",1,0],["حَتَّى إِذَا رَفَّتْ عَلَيْكَ ظِلاَلُهُ","وَسَرَتْ بِأَرْوَاحِ الْقَبُولِ قُيُولُهُ",1,"ل",2,0],["حَتَّى إِذَا رَسَمَا الكَلامَ جَرَى كَمَا","اتَّفَقَا عَلَى قَلَمَيْهِمَا لَفْظَانِ",2,"ن",1,0],["حتى إذا روت الحديث مسلسلاً","بيضُ الصوارم والرماحُ العُسَّلُ",3,"ل",1,0],["حَتّى إِذا رَأَتِ المُرادَ وَما رَأَت","إِلّا خَيالاً عَلِقَت بِهِ المَقتولا",4,"ل",2,0],["حَتّى إِذا ريحُ الجِلادِ حَدَثَ لَها","مَطَرَت فَكانَ الوَبِلُ نَبلاً صائِبا",5,"ب",2,0],["حتى إذا ردّ حُدا عدوّهِمْ","من كان في وادي الرّقادِ قد سرَح",6,"ح",1,0],["حَتّى إِذا رَوضي تَغَنّى بِهِ","ذِبّانُهُ في مونِقٍ زاهِرِ",7,"ر",1,0],["حَتَّى إِذَا رَفَّ خَيْطُ الْفَجْرِ وَابْتَدَرَتْ","حَمَائِمُ الأَيْكِ تَشْدُو فِي أَغَانِيهَا",8,"ي",3,0],["حَتَّى إِذَا رَقَدَتْ وَقَرَّ قرَارُهَا","سَلِسَتْ فَلَيْسَ لِذَوْقِهَا إِيلامُ",9,"م",1,0],["حَتّى إِذا رَقدٌ تَنَكَّبَ عَنهُما","رَجَعَت وَقَد كادَ الخِلاجُ يَلينُ",10,"ن",1,1],["حتى إذا رانَ الكرى بجفونها","ألقت إليكِ بسمعها إصغاءَ",11,"ا",2,0],["حتّى إذا رَفَعَ اللّواءَ رَأَيْتَهُ","تَحْتَ اللّواءِ على الخميسِ زَعيما",12,"م",2,0],["حَتَّى إِذا رَدَّ الفَيَافِيَ جَنَّةً","فِيمَا عَلاَ وَدَنَا مِنَ الأَرْجَاءِ",13,"ا",2,0],["حَتى إِذَا رَمَقَتْهُ عَيْنُ مَلِيكِهِ","لِشَمَائِلَ اكْتَمَلتْ بِهِ وَخَلاَئِقِ",14,"ق",1,0],["حَتَّى إِذَا رَجَعُوا بَدَا","بِجِبَاهِهِمْ أَثَرُ السجُودِ",15,"د",1,0],["حتى إذا رفت عليك ظلاله","وسرت بأرواح القبول قبوله",16,"ل",2,0],["حتى اذا رَمَتِ الويلاتُ نِعَمَتَهُ","ونَغَّصّتْها بتقويضٍ وتخريب",17,"ب",1,0],["حتى إذا رأيت المراد وما رأت","إلا خيالا واقفا مجهولا",18,"ل",2,0],["حتى إذا روحي ترنح عطفها","من لحظك المخمور في أجفانه",19,"ن",2,0],["حتى إِذا راحت ولان قيادها","ليد النوى تطرق إِلي وصولا",20,"ل",2,0],["حَتّى إِذا رَمَتِ الهَواجِرُ في الثَرى","وَالنَبتِ بَعدَ بَلولَةٍ وَتَرَبُّلِ",21,"ل",1,0],["حتى إذا رقّ قميصُ الدّجى","وابتسم الصبحُ وَراءَ الإزار",22,"ر",1,0],["حتى إذا راش الهوى","سهماً تغلغل في جناني",23,"ي",1,0],["حتّى إِذا رقَّ النَسيمُ وأَخفقت","من أفق مجلِسنا نجومُ الأكؤسِ",24,"س",1,0],["حتى إذا رقَّ الحدي","ثُ عن المنى وَعن الشجون",25,"ن",1,0],["حتّى إذا رفَضَ العِذارُ سوادَه","منّي وأصبحَ بالبياضِ مُروِّعى",26,"ع",2,0],["حتَّى إِذا رَزَحَت حالي وغيَّرها","ما طالَ من ولَهي عَنها ومِن شُغلي",27,"ل",2,0],["حتى إذا رأستك بثت سمها","والسم يعقبه هلاكٌ مُتعس",28,"س",1,0],["حتى إذا رابَنِي قَابلتُه فَقَضَى","حَياؤهُ وإِبائِي أن أفَارِقَهُ",29,"ه",1,0],["حتى إذا ركِبَ الغرامُ مطيّةً","تحدو بها الزفراتُ من أشجانِه",30,"ن",2,0],["حَتّى إِذا رَجَعَ اليَقينُ مَطامِعي","يَأساً وَأَخلَفَني الَّذينَ أُؤَمِّلُ",31,"ل",1,0],["حتَّى إِذا رُفِعَ الحِجابُ بَدا لنَا","مَلِكٌ وقُل إن شِئتَ بَدرَ تَمامِ",32,"م",1,0],["حتَّى إذا رَتَّبَ الدنيا كخاطرةٍ","عُليا، ووَزَّعَ في أفكارِها المُدُنَا",33,"ن",2,0],["حتى إذا رام الذهابَ مولياً","وجد الرحيبَ من المذاهب ضيّقا",34,"ق",2,0],["حَتّى إِذا رَأَيتهن عَمري","لَم آتهنَّ أَبَداً بِضُرِّ",35,"ر",1,0],["حتى اذا ركزوا اللوا في نينوي","والى النوى حنوا حنين متيم",36,"م",1,0],["حتى إذا رجعت للمُلك نضرتهُ","أبدت لنا مصرُ ما أبدتهُ أمصارُ",37,"ر",1,0],["حتى إذا رأيتَ الاحمرارَ في","جميعِهِ انزلهُ منها واكتفي",38,"ي",1,0],["حتى إذا رتعت بأكناف الحمى","ورتعت بين سواعد الغادات",39,"ت",1,0],["حتى إذا رقد الأسى بجفونها","وهفا النعاس برأسها فأمالها",40,"ل",3,0],["حتى إذا ركضت جحافل فجره","وتبسمت علياه غب قطوب",41,"ب",1,0],["حتى اذا راضها سَفيراً","حدَّت بوجهٍ من الحياءِ",42,"ا",2,0],["حَتّى إِذا رَكِبَهُ إِلياسُ","غابَ فَلَم يَظهَر عَلَيهِ الناسُ",43,"س",1,0],["حتى اذا رفض الاخاء رفضته","واعتضت عنه بطيب الميلاد",44,"د",1,0],["حتَّى إِذا رامَ إِدراكاً لُمبْدِعِه","بالوْهم أَظلَم عنه ذلك النورُ",45,"ر",1,0],["حَتَّى إذَا رُدَّت إلَيهِ نَالَهُ","مِن رَدِّهَا خِزيٌ وَسُوءُ هَوَانِ",46,"ن",1,0],["حتى إذا رأى الرجال أتاكم","فاسمع لما يوصي بلا برهان",46,"ن",1,0],["حَتّى إِذا رَسَخَت دَعائِمُ خَلقِهِ","وَغَدا كَلَيثِ الغابِ عَبلَ الساعِدِ",47,"د",1,0],["حَتّى إِذا رَفَعَ الظَلامُ سُتورَهُ","عَنّا وَلاحَ مِنَ الصَباحِ نَذيرُ",48,"ر",1,0],["حتى إذا رمت عطف بعلٍ على","عرس عكست المنى وطلّقتُ",49,"ت",1,0],["حتّى إذا رُمتم تسلّم حقّكم","في الملك سلّمهُ بغير إرادة",50,"ه",1,0],["حتىّ اذا رَويتَ بِهِ سَبحت ولم","تَسطِع تفارِقُ طيبَةُ وَهَناهُ",51,"ا",2,0],["حَتَّى إذَا رَمَقت بالبعد عن شَزَر","والخفُّ بالسير يُدمِي صفحة الكَتِف",52,"ف",1,0],["حتى اذا رفعَ الحجابُ ستورَه","شقتْ مهابتُه على الأَبصَارِ",53,"ر",1,0],["حَتّى إِذا رشفَ الطِّلا وَتناعست","جفناهُ من سُكرِ الخلاعة وَالكَرى",54,"ر",2,0],["حتى إذا رقَّ لي راق الزمانُ به","وقلت يا ليلتي عاشت مواليك",55,"ك",1,0],["حَتّى إِذا راقَ الرَحيقُ وَطابَت ال","أَوقاتُ وانصدع الظَلامُ نَهارا",56,"ر",2,0],["حتى إذا رق النسيم وأخفقت","من فوق مجلسنا نجوم الأكؤس",57,"س",1,0],["حتى إذا رقّ جلبابُ الدجى وسرتْ","من تحت أذياله مسكيّة النفس",58,"س",1,1],["حتى إذا روضت أعلامه وذكا","منه شذا عبق الآفاق عاطره",59,"ر",2,0],["حَتّى إِذا رَجَبٌ تَخَلّى وَاِنقَضى","وَجُمادَيانِ وَجاءَ شَهرٌ مُقبِلُ",60,"ل",1,0],["حَتّى إِذا رزى النِّساءُ نِساءَهُ","لَمّا اُستبيحَ حَريمُهُ وَرَزينَهُ",61,"ن",2,0],["حتى إذا رحلوا في شأنهم ذهبوا","نأوي إلى مجلس ٍ قد فاح ريحانا",62,"ن",2,0],["حتى إذا رأتِ الضياءَ لِوهلةٍ","يَمتد في آفاقها تستنكر",63,"ر",1,0],["حَتَّىْ إِذَاْ رَكِبَتْ حَرَقْتُ مَرَاْكِبِيْ","وَتَرَكْتُ وَاْحِدَةً لَهَاْ مُلْتَاْحَا",64,"ح",2,0],["حَتَّى إذَا رَامَ شَوقًا بالهَوَى شَخصٌ","قَامَ الهَوَى يُقرِضُ الأشوَاقَ جُعبَتَهُ",65,"ت",2,0],["حتى إذا ركب الجميع ونشّطت","صفارة الإنذار من هو فاتر",66,"ر",1,0],["حتى إذا رامَ التمنّعَ، أقبَلَتْ","تلكَ الملاكُ وحَرَّضَتْ شيطانَهْ",67,"ن",2,0],["حتى إذا رفع الغرام مزاده","سأزيد في عرض المبيع أُرخّصُ",68,"ص",1,0],["حتى إذا راح المساء يحيطني","طلعت شموسٌ من بريق سناها",69,"ا",3,0],["حتى إذا ركضتْ بِغَالُ فؤادِهِ","في نَهْجِ شِعرٍ والذكا أسفارُ",70,"ر",1,0],["حتى إذا رقصَ الصباحُ بنورهِ","ك(السندرلّا) كلّ شيء غابا",71,"ب",2,0]]}