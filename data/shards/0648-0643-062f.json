ة","https://www.aldiwan.net/poem37426.html","الطويل"],[556,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[556,"من كلفي أنني مررت به","https://www.aldiwan.net/poem47393.html","المنسرح"],[556,"ما ضر من للنوى زمت ركائبه","https://www.aldiwan.net/poem47766.html","البسيط"],[702,"","https://poetry.dctabudhabi.ae/diwan/poem/202243","الوافر"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112441","المجتث"],[743,"","https://poetry.dctabudhabi.ae/diwan/poem/45273","الطويل"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/98007","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63753","المنسرح"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104471","البسيط"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59784","الطويل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145633","البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67844","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67829","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61118","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64562","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44812","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100968","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118349","الخفيف"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100449","الوافر"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111732","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45730","الوافر"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22598","الكامل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21628","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109857","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200875",""],[2944,