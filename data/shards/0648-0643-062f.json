{"poems":[[86,"أتيت سوق عكاظ","https://www.aldiwan.net/poem68903.html","المجتث"],[35,"أتاني ودوني بطن غول ودونه","https://www.aldiwan.net/poem39167.html","الطويل"],[23,"تطاول بالخمان ليلي فلم تكد","https://www.aldiwan.net/poem21259.html","الطويل"],[72,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[51,"طلابك للحظوظ من العناء","https://www.aldiwan.net/poem8146.html","الوافر"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[91,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[70,"لئن بحت بالشكوى إليك محبة","https://www.aldiwan.net/poem42972.html","الطويل"],[45,"لو أسعدت سعدى بتنويلها","https://www.aldiwan.net/poem65586.html","السريع"],[61,"شيخ لنا من شيوخ بغداد","https://www.aldiwan.net/poem51688.html","المنسرح"],[66,"شكوت إليك الجوى","https://www.aldiwan.net/poem39645.html","مجزوء المتقارب"],[69,"لقد غفلت صروف الدهر عني","https://www.aldiwan.net/poem29296.html","الوافر"],[46,"أبيدة قالت للوعول مسرة","https://www.aldiwan.net/poem22328.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[106,"صفاء النفس!","https://www.poetsgate.com/ViewPoem.aspx?id=179324",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[91,"شاعر الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=53070",""],[23,"تطاولَ بالجمانِ ليلي فلمْ تكنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12800&r=&rc=4",""]],"verses":[["وَكِدتُ أُصرَعُ غَمّاً","لِحَظِّها المَعكوسِ",0,"س",1,0],["وَكِدتُ وَقَد سالَت مِنَ العينِ عَبرَةٌ","سَها عانِدٌ مِنها وَأَسبَلَ عانِدُ",1,"د",1,0],["وَكُدتُ غَداةَ البَينِ يَغلِبُني الهَوى","أُعالِجُ نَفسي أَن أَقومَ فَأَركَبا",2,"ب",2,0],["وكدت لعرفان المكارم لم ترم","بحمد وما حمد السحاب على السفح",3,"ح",1,0],["وكِدْ دُنْياكَ ما بُقِّيتَ فيها","بصافيةٍ أرقَّ من الهواءِ",4,"ا",2,0],["وكددتَ فيه بالبكاء مدامعاً","وجهدتَ فيه بالزفير ضلوعا",5,"ع",2,0],["وَكَدُميَةِ المَثّالِ حُسنٌ رائِعٌ","مِلءُ العُيون وَلَيسَ ثَمَّ شُعورُ",6,"ر",1,0],["وَكُدتَ تُحيِ المَوتى البَوالي","وَتُنبِتُ العُشبَ في الصُخورِ",7,"ر",1,0],["وَكِدتُ بِكِتماني أَصيرُ مُفرِّطاً","فَأَبكي عَلى ما فاتَني وَأَنوحُ",8,"ح",1,0],["وَكدُ بَني الفَيّاضِ في حَشدِهِم","عَلى مَعاليهِم وَتَأثيلِها",9,"ل",3,0],["وكَدَّةً من صَباحِ قُطْرُبُّلٍ","وجُؤذُراً من مِلاحِ كَلْوَاذِ",10,"ذ",1,0],["وَكَدَّرتِني بِالجَفا","فَحاوَلتُ مِنكَ الصَفا",11,"ف",2,0],["وكدتُ أنالُ في الشرفِ الثريا","وها أنا في الترابِ كما تراني",12,"ي",1,0],["وَكَدُرَيَّةٍ أَودَت وَغودِرَ مُدهُنٌ","وَبَيدانَةٍ مِنها المَراتِعَ بيدُ",13,"د",1,0],["وكِدْتُ لفَضْلِ القَوْلِ أَبْلُغُ ساكِتاً","وإِن ساءَ حُسّادِي مدى كُلِّ قائِلِ",14,"ل",1,0],["وَكِدْتُ أَحِبُّ السُّهْدَ مِمَّا أَلِفْتُهُ","وَكَادَ لِطولِ الصبْرِ يَحْلُو لِيَ الصَّبْرُ",15,"ر",1,0],["وكدتِ تُحَلِّقين مع الثُّريَّا","وتَتَّخِذِين بُرْجًا في السَّدِيم",16,"م",1,0],["وكِدْتُ أُطاحُ بإِغرائِها","فأحْدو ركائبَ مَنْ طُوِّحوا",17,"ح",3,0],["وكدت تحيي الموتى البوالي","وتنبت العشب في الصخور",18,"ر",1,0],["وكِدتُ غَداة َ البعينِ يَغْلِبُني الهوَى ،","أُعَالِجُ نَفْسي أنْ أقُومَ فأرْكَبَا",19,"ب",2,0]]}