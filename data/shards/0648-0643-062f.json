{"poems":[[86,"أتيت سوق عكاظ","https://www.aldiwan.net/poem68903.html","المجتث"],[35,"أتاني ودوني بطن غول ودونه","https://www.aldiwan.net/poem39167.html","الطويل"],[23,"تطاول بالخمان ليلي فلم تكد","https://www.aldiwan.net/poem21259.html","الطويل"],[72,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[51,"طلابك للحظوظ من العناء","https://www.aldiwan.net/poem8146.html","الوافر"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[91,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[70,"لئن بحت بالشكوى إليك محبة","https://www.aldiwan.net/poem42972.html","الطويل"],[45,"لو أسعدت سعدى بتنويلها","https://www.aldiwan.net/poem65586.html","السريع"],[61,"شيخ لنا من شيوخ بغداد","https://www.aldiwan.net/poem51688.html","المنسرح"],[66,"شكوت إليك الجوى","https://www.aldiwan.net/poem39645.html","مجزوء المتقارب"],[69,"لقد غفلت صروف الدهر عني","https://www.aldiwan.net/poem29296.html","الوافر"],[46,"أبيدة قالت للوعول مسرة","https://www.aldiwan.net/poem22328.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[106,"صفاء النفس!","https://www.poetsgate.com/ViewPoem.aspx?id=179324",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[91,"شاعر الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=53070",""],[94,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[23,"تطاولَ بالجمانِ ليلي فلمْ تكنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12800&r=&rc=4",""],[109,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[109,"سألتك ودا خالصا وترفقا","https://www.aldiwan.net/poem16684.html","الطويل"],[128,"يا ذا النوال الغادر","https://www.aldiwan.net/poem50618.html","مجزوء الكامل"],[132,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[160,"حلفت يقظان مروج العنان","https://www.aldiwan.net/poem58767.html","السريع"],[166,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[199,"أدرت عيونك في كل وجه","https://www.aldiwan.net/poem45182.html","المتقارب"],[271,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[298,"أَسيغوا البث واحتبسوا الزفيرا","https://www.aldiwan.net/poem36267.html","عموديه"],[298,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[304,"حييت يا مربع الأحباب","https://www.aldiwan.net/poem16795.html","المديد"],[305,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[405,"تعرض للكتابة يدعيها","https://www.aldiwan.net/poem49746.html","الوافر"],[409,"أحبابنا من لي لو","https://www.aldiwan.net/poem32430.html","مجزوء الهزج"],[416,"شفيت بطرد صالح كل صدر","https://www.aldiwan.net/poem53900.html","الوافر"],[416,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[432,"خليلي اتركا ما تعدلاني","https://www.aldiwan.net/poem12479.html","الوافر"],[432,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[437,"حيا بكاس السرى سا في الأغاريد","https://www.aldiwan.net/poem2596.html","البسيط"],[443,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[453,"يا ابن الخصاصة حين تحسب عزة","https://www.aldiwan.net/poem61389.html","الكامل"],[458,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[477,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[477,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[515,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[516,"ذكرت مقامي ليلة الباب قابضا","https://www.aldiwan.net/poem48670.html","الطويل"],[516,"أتصبر عن سعدى وأنت صبور","https://www.aldiwan.net/poem48677.html","الطويل"],[516,"طلعن علينا بين مروة والصفا","https://www.aldiwan.net/poem48716.html","الطويل"],[529,"على البر نجل البر مني تحية","https://www.aldiwan.net/poem37426.html","الطويل"],[551,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[551,"من كلفي أنني مررت به","https://www.aldiwan.net/poem47393.html","المنسرح"],[551,"ما ضر من للنوى زمت ركائبه","https://www.aldiwan.net/poem47766.html","البسيط"]],"verses":[["وَكِدتُ أُصرَعُ غَمّاً","لِحَظِّها المَعكوسِ",0,"س",1,0],["وَكِدتُ وَقَد سالَت مِنَ العينِ عَبرَةٌ","سَها عانِدٌ مِنها وَأَسبَلَ عانِدُ",1,"د",1,0],["وَكُدتُ غَداةَ البَينِ يَغلِبُني الهَوى","أُعالِجُ نَفسي أَن أَقومَ فَأَركَبا",2,"ب",2,0],["وكدت لعرفان المكارم لم ترم","بحمد وما حمد السحاب على السفح",3,"ح",1,0],["وكِدْ دُنْياكَ ما بُقِّيتَ فيها","بصافيةٍ أرقَّ من الهواءِ",4,"ا",2,0],["وكددتَ فيه بالبكاء مدامعاً","وجهدتَ فيه بالزفير ضلوعا",5,"ع",2,0],["وَكَدُميَةِ المَثّالِ حُسنٌ رائِعٌ","مِلءُ العُيون وَلَيسَ ثَمَّ شُعورُ",6,"ر",1,0],["وَكُدتَ تُحيِ المَوتى البَوالي","وَتُنبِتُ العُشبَ في الصُخورِ",7,"ر",1,0],["وَكِدتُ بِكِتماني أَصيرُ مُفرِّطاً","فَأَبكي عَلى ما فاتَني وَأَنوحُ",8,"ح",1,0],["وَكدُ بَني الفَيّاضِ في حَشدِهِم","عَلى مَعاليهِم وَتَأثيلِها",9,"ل",3,0],["وكَدَّةً من صَباحِ قُطْرُبُّلٍ","وجُؤذُراً من مِلاحِ كَلْوَاذِ",10,"ذ",1,0],["وَكَدَّرتِني بِالجَفا","فَحاوَلتُ مِنكَ الصَفا",11,"ف",2,0],["وكدتُ أنالُ في الشرفِ الثريا","وها أنا في الترابِ كما تراني",12,"ي",1,0],["وَكَدُرَيَّةٍ أَودَت وَغودِرَ مُدهُنٌ","وَبَيدانَةٍ مِنها المَراتِعَ بيدُ",13,"د",1,0],["وكِدْتُ لفَضْلِ القَوْلِ أَبْلُغُ ساكِتاً","وإِن ساءَ حُسّادِي مدى كُلِّ قائِلِ",14,"ل",1,0],["وَكِدْتُ أَحِبُّ السُّهْدَ مِمَّا أَلِفْتُهُ","وَكَادَ لِطولِ الصبْرِ يَحْلُو لِيَ الصَّبْرُ",15,"ر",1,0],["وكدتِ تُحَلِّقين مع الثُّريَّا","وتَتَّخِذِين بُرْجًا في السَّدِيم",16,"م",1,0],["وكِدْتُ أُطاحُ بإِغرائِها","فأحْدو ركائبَ مَنْ طُوِّحوا",17,"ح",3,0],["وكدت تحيي الموتى البوالي","وتنبت العشب في الصخور",18,"ر",1,0],["وكدت وسحره سحر خفيّ","أرى فيه المحبّب من صباها",19,"ا",3,0],["وكِدتُ غَداة َ البعينِ يَغْلِبُني الهوَى ،","أُعَالِجُ نَفْسي أنْ أقُومَ فأرْكَبَا",20,"ب",2,0],["وَكِدنا مِن الأَشواق نَقضي وَفي الحَشا","جِراح تَحامتها الأَساة وَنار",21,"ر",1,0],["وَكَدرت كَأسي في هَواك بِأَدمُعي","فَهلاً شَرِبناها سَلافاً مروَّقا",22,"ق",2,0],["وكداكَ سائر خاطِرى","يُنْبِيكَ عنها ظاهِرى",23,"ر",2,0],["وكدرت صحبة الاجلاف عيشتنا","ولم نعج بدواء للذي نجد",24,"د",1,0],["وكدت أن أرضع ورام العدى","أن يفطم في منه رأى العيان",25,"ن",1,0],["وكدّ تفاوتُ الحطّينِ قَلبي","وخاطَ علي أثوابَ الخَبالِ",26,"ل",1,0],["وكدتَ تشكُّ بهنَّ القلوب","وتلحمُ أسيافهنَّ الصدورا",27,"ر",2,0],["وَكدت أَخفي الهوى وَدَمعي","من شدة الوجد ترجمان",28,"ن",1,0],["وَكدنا ندفنُ الآمالَ حتى","أَهَبْتَ بنا فكنتَ لها نُشورا",29,"ر",2,0],["وَكدت أرى الحنانَ عل","يَّ يهبط من لدن ربك",30,"ك",1,0],["وكدروا صفو نادينا","بالحرص والشح والطغيان",31,"ن",1,0],["وَكدتُ لهولِ وَجبته أراني","هَدمتُ بهِ بناءً مشمخرّا",32,"ر",2,0],["وكدْتُ أقولُ في الدِّيوان يَوماً","أتحجُمُني فقالَ لي الحجامَهْ",33,"ه",1,0],["وكدّرَت مِن عَيشَنا","ما كانَ طابَ وصَفَا",34,"ف",2,0],["وكدَّرَ كلّ من يهواك منَّا","وكنَّا قبلُ كالماء النَّمير",35,"ر",1,0],["وكدرت المشارب بعد صفو","وما يجديك رفق من ثماد",36,"د",1,0],["وكدتُ أذوبُ من وجدي عليه","ويرحمُني لذلك من رآني",37,"ي",1,0],["وكدَّر نُدْماني جَذيمةُ بعدَما","أقاما زماناً يشربانِ التّصافيا",38,"ي",2,0],["وكدت أورد من بعد الفراق له","في منهل حياض الموتِ مورودِ",39,"د",1,0],["وكدنيانا بها خلق بشر","وهل القوم بها قد علموا",40,"م",3,0],["وكدحت طفلا في الحقول وبعدها","في الليل تكدح دارسا صبارا",41,"ر",2,0],["وكُدِّرتْ تلك الرَّكايا على","دَلوي فما أشربُ غيرَ الوخيمْ",42,"م",1,0],["وكُدَّ رَوِرْدُ القربِ بعدَ صفائهِ","وعهدي بهِ عذبُ المواردِ مُفعَمُ",43,"م",1,0],["وكدَّرتُم صفَو الوصالِ فهل تُرى","تعودُ كما كانتْ عِذاباً مناهلُه",44,"ل",2,0],["وكدت أمحو لعساً","في شفتيه بالقبل",45,"ل",1,0],["وَكِدت وَلَم املِك اِلَيكَ صَبابَه","اِطيرُ وَفاضَ الدَمعُ مِنّي عَلى النَحر",46,"ر",1,0],["وَكِدت وَلَم اخلِق من الطَيرِ ان بَدا","سَنا بارِق نَحو الحِجازِ أَطير",47,"ر",1,0],["وَكِدنَ لعمر اللَهِ يحدِثن فتنَة","لِمَخشَع من خشيَة اللَهِ تايِب",48,"ب",1,0],["وكَدّرَ مِنْ صَفْوِ الموارِدِ واردٌ","يُصَاوِلُه مِنْ حَيْثُ يَدْرِي ولا يَدْرِي",49,"ر",2,0],["وكدْتَ وما شعرتَ بذاك منِّي","تَدُلُّ الطّالبين على مكاني",50,"ي",1,0],["وكدتُ لَمّا رأيتُ غِلظَتَهُ","أُنْجِعُ جسمي بمهجتي أَسَفا",51,"ف",2,0],["وَكِدتُ أَقضي غداةَ البين من جَزَعٍ","لو لم يكن لك قلبٌ صيغَ من حجرِ",52,"ر",1,0]]}