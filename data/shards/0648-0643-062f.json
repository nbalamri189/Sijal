],[4852,"بعض السلام","https://www.poetsgate.com/ViewPoem.aspx?id=214406",""],[4927,"سلي القلب","https://www.poetsgate.com/ViewPoem.aspx?id=29656",""],[4927,"سِفرُ الْغَرَاْم","https://www.poetsgate.com/ViewPoem.aspx?id=29829",""],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[5413,"ألبوم الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=200536",""],[5430,"أضاع الحق وااا أسفي ؟؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=1459",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[470,"قلبي عليك","https://www.poetsgate.com/ViewPoem.aspx?id=178009",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5582,"نَفْسُ المُتَيَّمِ دِينُ الحُبِّ مَذْهَبُها","https://www.poetsgate.com/ViewPoem.aspx?id=186667",""],[243,"وحي النيروز","https://www.poetsgate.com/ViewPoem.aspx?id=20962",""],[5943,"هديل الخير","https://www.poetsgate.com/ViewPoem.aspx?id=53803",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6069,"يا شاعراً أودعت أنامله","https://www.poetsgate.com/ViewPoem.aspx?id=105720",""],[6069,"أهلاً بطيف خيال زارني سحراً","https://www.poetsgate.com/ViewPoem.aspx?id=105648",""],[6097,"إذا ضاقَتْ...","https://www.poetsgate.com/ViewPoem.aspx?id=197428",""],[313,"صبر ينفذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66511&r=&rc=33",""]],"verses":[["وَكِدتُ أُصرَعُ غَمّاً","لِحَظِّها المَعكوسِ",0,"س",1,0],["وَكِدتُ وَقَد سالَت مِنَ العينِ عَبرَةٌ","سَها عانِدٌ مِنها وَأَسبَلَ عانِدُ",1,"د",1,0],["وَكُدتُ غَداةَ البَينِ يَغلِبُني الهَوى","أُعالِجُ نَفسي أَن أَقومَ فَأَركَبا",2,"ب",2,0],["وكدت لعرفان المكارم لم ترم","بحمد وما حمد السحاب على السفح",3,"ح",1,0],["وكِدْ دُنْياكَ ما بُقِّيتَ فيها","بصافيةٍ أرقَّ من الهواءِ",4,"ا",2,0],["وكددتَ فيه بالبكاء مدامعاً","وجهدتَ فيه بالزفير ضلوعا",5,"ع",2,0],["وَكَدُميَةِ المَثّالِ حُسنٌ رائِعٌ","مِلءُ العُيون وَلَيسَ ثَمَّ شُعورُ",6,"ر",1,0],["وَكُدتَ تُحيِ المَوتى البَوالي","وَتُنبِتُ العُشبَ في الصُخورِ",7,"ر",1,0],["وَكِدتُ بِكِتماني أَصيرُ مُفرِّطاً","فَأَبكي عَلى ما فاتَني وَأَنوحُ",8,"ح",1,0],["وَكدُ بَني الفَيّاضِ في حَشدِهِم","عَلى مَعاليهِم وَتَأثيلِها",9,"ل",3,0],["وكَدَّةً من صَباحِ قُطْرُبُّلٍ","وجُؤذُراً من مِلاحِ كَلْوَاذِ",10,"ذ",1,0],["وَكَدَّرتِني بِالجَفا","فَحاوَلتُ مِنكَ الصَفا",11,"ف",2,0],["وكدتُ أنالُ في الشرفِ الثريا","وها أنا في الترابِ كما تراني",12,"ي",1,0],["وَكَدُرَيَّةٍ أَودَت وَغودِرَ مُدهُنٌ","وَبَيدانَةٍ مِنها المَراتِعَ بيدُ",13,"د",1,0],["وكِدْتُ لفَضْلِ القَوْلِ أَبْلُغُ ساكِتاً","وإِن ساءَ حُسّادِي مدى كُلِّ قائِلِ",14,"ل",1,0],["وَكِدْتُ أَحِبُّ السُّهْدَ مِمَّا أَلِفْتُهُ","وَكَادَ لِطولِ الصبْرِ يَحْلُو لِيَ الصَّبْرُ",15,"ر",1,0],["وكدتِ تُحَلِّقين مع الثُّريَّا","وتَتَّخِذِين بُرْجًا في السَّدِيم",16,"م",1,0],["وكِدْتُ أُطاحُ بإِغرائِها","فأحْدو ركائبَ مَنْ طُوِّحوا",17,"ح",3,0],["وكدت تحيي الموتى البوالي","وتنبت العشب في الصخور",18,"ر",1,0],["وكدت وسحره سحر خفيّ","أرى فيه المحبّب من صباها",19,"ا",3,0],["وكِدتُ غَداة َ البعينِ يَغْلِبُني الهوَى ،","أُعَالِجُ نَفْسي أنْ أقُومَ فأرْكَبَا",20,"ب",2,0],["وَكِدنا مِن الأَشواق نَقضي وَفي الحَشا","جِراح تَحامتها الأَساة وَنار",21,"ر",1,0],["وَكَدرت كَأسي في هَواك بِأَدمُعي","فَهلاً شَرِبناها سَلافاً مروَّقا",22,"ق",2,0],["وكداكَ سائر خاطِرى","يُنْبِيكَ عنها ظاهِرى",23,"ر",2,0],["وكدرت صحبة الاجلاف عيشتنا","ولم نعج بدواء للذي نجد",24,"د",1,0],["وكدت أن أرضع ورام العدى","أن يفطم في منه رأى العيان",25,"ن",1,0],["وكدّ تفاوتُ الحطّينِ قَلبي","وخاطَ علي أثوابَ الخَبالِ",26,"ل",1,0],["وكدتَ تشكُّ بهنَّ القلوب","وتلحمُ أسيافهنَّ الصدورا",27,"ر",2,0],["وَكدت أَخفي الهوى وَدَمعي","من شدة الوجد ترجمان",28,"ن",1,0],["وَكدنا ندفنُ الآمالَ حتى","أَهَبْتَ بنا فكنتَ لها نُشورا",29,"ر",2,0],["وَكدت أرى الحنانَ عل","يَّ يهبط من لدن ربك",30,"ك",1,0],["وكدروا صفو نادينا","بالحرص والشح والطغيان",31,"ن",1,0],["وَكدتُ لهولِ وَجبته أراني","هَدمتُ بهِ بناءً مشمخرّا",32,"ر",2,0],["وكدْتُ أقولُ في الدِّيوان يَوماً","أتحجُمُني فقالَ لي الحجامَهْ",33,"ه",1,0],["وكدّرَت مِن عَيشَنا","ما كانَ طابَ وصَفَا",34,"ف",2,0],["وكدَّرَ كلّ من يهواك منَّا","وكنَّا قبلُ كالماء النَّمير",35,"ر",1,0],["وكدرت المشارب بعد صفو","وما يجديك رفق من ثماد",36,"د",1,0],["وكدتُ أذوبُ من وجدي عليه","ويرحمُني لذلك من رآني",37,"ن",2,0],["وكدَّر نُدْماني جَذيمةُ بعدَما","أقاما زماناً يشربانِ التّصافيا",38,"ي",2,0],["وكدت أورد من بعد الفراق له","في منهل حياض الموتِ مورودِ",39,"د",1,0],["وكدنيانا بها خلق بشر","وهل القوم بها قد علموا",40,"م",3,0],["وكدحت طفلا في الحقول وبعدها","في الليل تكدح دارسا صبارا",41,"ر",2,0],["وكُدِّرتْ تلك الرَّكايا على","دَلوي فما أشربُ غيرَ الوخيمْ",42,"م",1,0],["وكُدَّ رَوِرْدُ القربِ بعدَ صفائهِ","وعهدي بهِ عذبُ المواردِ مُفعَمُ",43,"م",1,0],["وكدَّرتُم صفَو الوصالِ فهل تُرى","تعودُ كما كانتْ عِذاباً مناهلُه",44,"ل",2,0],["وكدت أمحو لعساً","في شفتيه بالقبل",45,"ل",1,0],["وَكِدت وَلَم املِك اِلَيكَ صَبابَه","اِطيرُ وَفاضَ الدَمعُ مِنّي عَلى النَحر",46,"ر",1,0],["وَكِدت وَلَم اخلِق من الطَيرِ ان بَدا","سَنا بارِق نَحو الحِجازِ أَطير",47,"ر",1,0],["وَكِدنَ لعمر اللَهِ يحدِثن فتنَة","لِمَخشَع من خشيَة اللَهِ تايِب",48,"ب",1,0],["وكَدّرَ مِنْ صَفْوِ الموارِدِ واردٌ","يُصَاوِلُه مِنْ حَيْثُ يَدْرِي ولا يَدْرِي",49,"ر",2,0],["وكدْتَ وما شعرتَ بذاك منِّي","تَدُلُّ الطّالبين على مكاني",50,"ن",2,0],["وكدتُ لَمّا رأيتُ غِلظَتَهُ","أُنْجِعُ جسمي بمهجتي أَسَفا",51,"ف",2,0],["وَكِدتُ أَقضي غداةَ البين من جَزَعٍ","لو لم يكن لك قلبٌ صيغَ من حجرِ",52,"ر",1,0],["وكدت أنال في الشرف الثريا","ولكن لا سبيل إلى الخلود",53,"د",1,0],["وكدت مما اعاني","من النوى إن أجنا",54,"ن",2,0],["وكدت جرح قلباً","مني وقرح جفنا",54,"ن",2,0],["وَكِدتُ اِشتِياقا نَحوَها وَصَبابَةً","تَقطَّعُ نَفسي إِثرَها حَسَراتِ",55,"ت",1,0],["وكُدِّرَ الودُّ القديمُ الذي","قد كان قِدْماً صافياً كالرحيق",56,"ق",1,0],["وكدتُ أَنْ أُظهرَ الغرامَ ولا","بدَّ لهذا الغرامَ أَنْ يَظْهَر",57,"ر",1,0],["وكدرت صفو عيش العسكري به","والأمر لِلَه في مخلوقه جاري",58,"ر",2,0],["وكدر الدهر سريع إن صفا","وهل رأيت الدهر يوما أنصفا",59,"ف",2,0],["وكدرتَ لي عيشي وأسهرت مُقلتي","فلا العيش يصفو لي ولا العين تهجع",60,"ع",1,0],["وَكِدْتُ لولا بَقَايَا الصَّبْرِ تَمنَعُنِي","وَفُسْحَةُ العُمْرِ أَنْ أَقْضِي له نَحْبَا",61,"ب",2,0],["وَكَدَّرَ مِنْ وِرْدِ الْمَحَبَّةِ مَا صَفا","وَمَاذَا عَلَيْهِ لَوْ عَلَيَّ تَعَطَّفَا",62,"ف",2,0],["وَكَدَّرْتُمُ بِالْبُعْدِ صَافيَ مَشْرَبي","طَمِعْتُ بِطَيْفٍ مِنْ خَيَالٍ يَلُمُّ بي",63,"ي",1,0],["وكدية الصخر أوهاها بضربته","والبيئر من يبس أجرى به الشيما",64,"م",2,0],["وَكدت أَطير مِن شَوق إلَيكُم","وَمِن وَجد لِبينكم دَخيل",65,"ل",1,0],["وكد من رماني يا ودود بكيده","فكيدك للأعداء لا زال اقتلا",66,"ل",2,0],["وَكِدت أَجُرُّ أَذيَالِي نَشَاطاً","وَلَكِن خِلتُ قَولَهُمُ نِصَابا",67,"ب",2,0],["وكدنا نرى أم اللغى قبل عاطفٍ","فريسة عاثٍ بالمعارف عاتي",68,"ت",2,0],["وكدا قال لبلقيس التي","أوتيت من كل شيءٍ مُدخر",69,"ر",1,0],["وكداها وقاعها وصواها","وحصاها وما حوى من غبار",70,"ر",1,0],["وكدت بما اصطفاك اللَه فيه","حسوداً أو جحوداً أو حقودا",71,"د",2,0],["وكِدتُ بلا وَجدٍ أموتُ من الهوى","وهام عليَّ القلبُ بالخفقانِ",72,"ن",1,0],["وَكدت أَظُنُّ فيهِ مِن سُهادي","بِأَن اللَه لَم يَخلق نَهارا",73,"ر",2,0],["وَكَدُميَةِ المِحرابِ ماثِلَةٌ","وَالفَرعُ جَثلُ النَّبتِ كَالحُمَمِ",74,"م",1,0],["وَكِدتَ تَموتُ أَن صاحَ اِبنُ آوى","وَمِثلُكَ ماتَ مِن صَوتِ السباعِ",75,"ع",1,0],["وكدت من حر وجدي","اراه عنك بديلا",76,"ل",2,0],["وكدت من نشوتي بسيري","أسيل بشراً مع الطريق",77,"ق",1,0],["وكدتُ بموج الإشتياق أضمُّه","لأُشركَه في زفرتي ووجيبي",78,"ب",2,0],["وكدت أكتم إبداعي مخافة أن","يُشيع في الشعراء اليأس إبداعي",79,"ي",1,0],["وكدت من فرط حنوي على","قلب يريد الإلف أن أقطعه",80,"ع",2,0],["وكدت من الحر أن أشتوي","ومن شدة الضيق أن أخنقا",81,"ق",2,0],["وكدرّ صفو الورد عَن صَدري فَلَم","يعرني سِوى صدّ لِصَدري يحرّق",82,"ق",1,0],["وكدت تجلو ضميري","لو كان يجلى الضمير",83,"ر",1,0],["وكدرتم ظن الحسود بنعمتي","وأشهى من الإنعام تكديرُ حُسَّدي",84,"د",2,0],["وكدّرَ نطفةَ الأنعامِ عندي","عُلوُّ يدِ المُعينِ على المُعانِ",85,"ن",1,0],["وكِدْتَ تُشبهُ سَيفَ النّصرِ منْصَلِتاً","لكنّ أينَ مَضاءُ الحدِّ والشُّطَبُ",86,"ب",1,0],["وكدر عيشهم حرب فجادت","لهم عقباه في عيش رغيد",87,"د",1,0],["وكدنا أن نعيش بغير داء","ولن تلقى بتربتنا عليلا",88,"ل",2,0],["وَكدّر الصَفوَ ظلمُ القَومِ أَنفسَهم","فَكُلُّ قَلب بِهِ داءٌ قد انتهكه",89,"ك",2,0],["وكد الأعداء وارددهم حس","ارى أسارى عمدا أو هودوا",90,"د",3,0],["وكِدتُ من بكراء مكتومة","املؤ كفيَّ برغم الوشاه",91,"ا",2,0],["وكدت أقرع سني بعدهم ندماً","لو كان ينفع قرع السنّ من ندم",92,"م",1,0],["وكد أتريذ يفوز بالمنى ل","كن ذكت غيرة فيبوس هنا",93,"ن",2,0],["وَكُدتُ أولي وَلَدي أَكتورا","وَمُليناً بِعامِلي الثُبورا",94,"ر",2,0],["وكدت جهلا تبتغين سبله","فالامر ذاك ما عسى يدنوله",95,"ه",1,0],["وكدت أعجبُ في نفسي وقد مَلَكتْ","شهادةً من خبيرٍ ناقدٍ فَطِن",96,"ن",1,0],["وكدر عيش الصفاء ينسي","فأن تكونوا قد جهلتم نفسي",97,"ي",1,0],["وكدر الود منكم","وكان بالصفو يعهد",98,"د",1,0],["وَكِدتُ أَطيرُ مِن شَوقٍ إِلَيهِم","فَكَيفَ يَطيرُ مَقصوصُ الجَناحِ",99,"ح",1,1],["وكدنا نرى رسم الديار وإنما","لكثر البكى صدقته عنا المدامع",100,"ع",1,0],["وكدت باخمصي اطاء الثريا","على مأمول رحمتك اعتمادي",101,"ي",1,0],["وكدنا المطايا بالفلاة تلمنا","نزلنا بها ثم انثنينا بركبنا",102,"ن",2,0],["وَكِدنَ بِذي الرُبا يَدعونَ بِاِسمي","وَلا أَرضٌ لَدَيَّ وَلا سَماءُ",103,"ا",2,0],["وَكُديَةُ الرَشيدِ ما أَكدَى بِهَا","مِن قَنَصِ الأُنسِ الشَريدِ مَن سَمَا",104,"ا",1,0],["وكدت من لينه ونعمته","أفك من زنده إلى العضد",105,"د",1,0],["وكدتَ( توقِنُ من شكٍّ ومن عَجَبِ","هذي الملايين ليست أمةُ العربِ)",106,"ب",1,1],["وكدتُ أسمعُ في أفْقي مُسَلَّمَةً ..","عَتَتْ أيادٍ وإنْ لم تحمل السَّيفا",107,"ف",2,1],["وَكِدْتُ أُنادِيْ بِالْمُحبينَ: إِنَّنِيْ","أَسِيْرٌº وَدَمْعِيْ بَعْدَ عَفْرَاْءَ مُطْلَقُ",108,"ق",1,0],["وَكِدْتُ أُوَلْوِلُ يَوْمَ الْوَدَاْعِ","عَلَيْهَاْ نَهَاْراًº مَسَاْءًº بُكُوْرَاْ",109,"ر",2,0],["وَ كِدْ لِكُلِّ ظَالِمٍ مُسْتَكْبِرٍ","مِنْ غَيْرِ حَقٍّ سَيْفَهُ يَمْتَشِقُ",110,"ق",1,0],["وكدتُ لفرطِ الحسن أسقطُ ساجدًا","سجودَ السُّكَارى عند رؤية مريما",111,"م",2,0],["وكدت أتيه في دربٍ","بلا سيف ولا علم",112,"م",1,0],["وكدنا نسألُ الجيرانَ لولا","ح