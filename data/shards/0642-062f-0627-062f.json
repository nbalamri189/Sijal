{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[55,"دع الذميل إلى الغايات والرتكا","https://www.aldiwan.net/poem29920.html","البسيط"],[79,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[74,"قاضي قضاة الدين دم في على","https://www.aldiwan.net/poem19209.html","السريع"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[47,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[52,"قد أدرك الحاجة ممنوعة","https://www.aldiwan.net/poem62284.html","الوافر"],[48,"قلمت ظفري تارات وما جسدي","https://www.aldiwan.net/poem22292.html","البسيط"],[48,"أما الحسام فما أدناك من أجل","https://www.aldiwan.net/poem22791.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[9,"","https://poetry.dctabudhabi.ae/diwan/poem/199525","البسيط"],[79,"قلدت من نصر الإله حساما","https://www.poetsgate.com/ViewPoem.aspx?id=34200",""],[136,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[147,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[201,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[237,"استعمل العصف بعد الدبغ مقلوبا","https://www.aldiwan.net/poem14936.html","البسيط"],[264,"موقع النجم في الحمى الشرقي","https://www.aldiwan.net/poem35936.html","الخفيف"],[287,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[371,"كفيت في البدر انتكاس الهلال","https://www.aldiwan.net/poem17071.html","السريع"],[382,"يا من رضيت الذل عني عاريا","https://www.aldiwan.net/poem59377.html","الكامل"],[458,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[466,"وفي حشية دست المجد ذو طرب","https://www.aldiwan.net/poem16145.html","البسيط"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[567,"قد أدركت نجم فواز قرينته","https://www.aldiwan.net/poem52690.html","البسيط"],[567,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[567,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"يا ساكناً بين جنات وأنهار","https://www.aldiwan.net/poem2784.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138402",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138420",""],[699,"","https://poetry.dctabudhabi.ae/diwan/poem/104491","السريع"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34432","البسيط"],[762,"","https://poetry.dctabudhabi.ae/diwan/poem/103648","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56661","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145107","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108778","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69400","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93533","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137120",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137282",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67970","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89315","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89109","المتدارك"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109890","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91289","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131038",""],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81687","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133154","البسيط"],[4650,"","https://poetry.dctabudhabi.ae/diwan/poem/76555","الخفيف"],[4727,"إما البطالة أو كد بلا عطل","https://www.poetsgate.com/ViewPoem.aspx?id=208799",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5136,"زارني طيفه فأهلا وسهلا","https://www.poetsgate.com/ViewPoem.aspx?id=121785",""],[5191,"رملٌ على صخرٍ ذرتْهُ الرّيحُ","https://www.poetsgate.com/ViewPoem.aspx?id=212084",""],[5277,"فطرةُ القدس","https://www.poetsgate.com/ViewPoem.aspx?id=195025",""],[5376,"أبحَرْتُ في عيْنَيْكِ موجاً هائجا","https://www.poetsgate.com/ViewPoem.aspx?id=205067",""],[5443,"جنَّة الدُّنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185139",""],[5533,"حِقْدُ المَجُوس","https://www.poetsgate.com/ViewPoem.aspx?id=176589",""],[5596,"اليحمدي","https://www.poetsgate.com/ViewPoem.aspx?id=206710",""],[5691,"أطواق منضدة","https://www.poetsgate.com/ViewPoem.aspx?id=206439",""],[5851,"هينمات من ظلال البدايات","https://www.poetsgate.com/ViewPoem.aspx?id=175277",""],[5956,"أولادي والحمد لله وعقبال أولاد الجميع وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=192025",""],[5956,"الداشرة صاحبةُ اليوم الأسود المتوقَّع","https://www.poetsgate.com/ViewPoem.aspx?id=204358",""],[6093,"مُشَرَّدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=198050",""],[5724,"ما رفرفت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""]],"verses":[["قَد أَدمَجَ الهَمُّ في عُنقي حَبائِلَهُ","وَلَزَّةُ الهَمِّ تُنسي لَزَّةَ القَرَنِ",0,"ن",1,0],["قَد أُدهِشَ المُلكُ قَبلَ اليَومِ مِن حَذَرٍ","وَإِنَّما اليَومَ أَذرى دَمعَهُ وَبَكى",1,"ك",2,0],["قَدْ أَدْهَشَ الذُّعْرُ الْمُخِيفُ قُلُوبَهُمْ","وَدَهَا الْعُقُولَ وَزَلْزَلَ الأَقْدَامَا",2,"م",2,0],["قَد أَدرَكَ الواشونَ ما حاوَلوا","فَالحَبلُ مِن شَعثاءَ رَثُّ الرِمام",3,"م",1,0],["قد أدبرَ الصوم ولي مقلة","ما نظرت قط سوى دمعها",4,"ع",3,0],["قد أُدميتْ لَبَّاتها","مِسْكاً كما يُدمَى العَتيرُ",5,"ر",1,0],["قَد أَدبَرَ العُرُّ عَنها وَهيَ شامِلُها","مِن ناصِعِ القَطِرانِ الصِرفِ تَدسيمُ",6,"م",1,0],["قَد أَدرَكَ الحُلمُ الَّذي أَبدى لَنا","عَن حِلمِهِ وَوَقارِهِ وَسَدادِهِ",7,"د",2,0],["قد أدبر الليل عنا فا حدُ بالإبل","وإن كفاها صرير البيض والأسل",8,"ل",1,1],["قَد أُدرِكُ الحاجَةَ مَمنوعَةً","وَتولَعُ النَفسُ بِما لا تَنال",9,"ل",1,1],["قَد اِدَّعَيتُم فَقُلنا أَينَ شاهِدُكُم","فَجاءَ مَن باتَ عِندَ اللُبِّ مَجروحا",10,"ح",2,0],["قَد اِدَّعى النُسكُ أَقوامٌ بِزَعمِهُمُ","وَكَيفَ نُسكُ غَّويٍّ رُمحُهُ وَرِسُ",11,"س",1,0],["قد أدرك الشعر في ظل","لهم مراداً وإربا",12,"ب",2,0],["قد آدَهُ الدهرُ بما يحملُ","فجاءَ عن آلامِهِ ينطقُ",13,"ق",1,0],["قد ادّخرت لقلبي عند كبرته","ما صانه كادح للشّيب واجتهدا",14,"د",2,0],["قد ادعوا والداً ما مَسَّ أمَهمُ","قد يَعلمون ولكنْ ذلك الفَرَق",15,"ق",1,0],["قد أدهش الذعر المخيف قلوبهم","ودهى العقول وزلزل الأقداما",16,"م",2,0],["قد ادَّعَى العلمَ مورُوثا فقلت له","ما هكذا تفعلُ الأكياسُ والنُّبَلا",17,"ل",2,0],["قَد أَدرَكَ الإِسلامُ فيكَ مُرادَهُ","فَليَهنِكَ الفَرعُ الَّذي لَن يُفرَعا",18,"ع",2,0],["قد أُدخلت ليلا علي","ه فكان ليلا سرمدا",19,"د",2,0],["قد أدَّبتكَ نواريزُ مفَرَّقةُ","حتى لقد صرتَ لا تحتاج تأديبا",20,"ب",2,0],["قد أدارت خمور دنّ التداني","في سما كأس شمس أنسٍ سنيّ",21,"ي",1,0],["قَدِ اِدَّعى الشِّعرَ أَقوامٌ وَلَيسَ لَهُم","يَوماً عَلى ما اِدَّعوهُ فيهِ بُرهانُ",22,"ن",1,0],["قَد اِدَّعى لِلسُقمِ مِن بَعدِ ما","قَد صَحَّ عَن عِلمي وَماذا حَلال",23,"ل",1,0],["قد أدرجتك لفائفاً فَقرِيةً","والكونُ إن يُدْرِجْهُ أمرُك مارسا",24,"س",2,0],["قد أدرك الخلق حين الغيثُ جانبهم","وبَّر بي حين اصفى الأهل جافاني",25,"ن",2,0],["قد أدَّبَتْهُ لكُمُ جَهْلاَتُهُ","فيكم وأَنْ جَرّبَ قوماً أُخَرا",26,"ر",2,0],["قد أدرك الغاية القصوى وأحرزها","فكلُّ قاصٍ على إِحضاره صَقِب",27,"ب",1,0],["قد أدبتها سجاياه وكثرة ما","رأت وماسمعت عنه من الأدب",28,"ب",1,0],["قد أدركوا شرف الحياة وشيدوا","مجداً فأما مثل مجدك ذا فلا",29,"ل",2,0],["قد أدركت نَجمَ فوَّازٍ قرينتُهُ","ذاتُ التُّقَى كاترينا بالتُّقَى رُحِمَتْ",30,"ت",1,1],["قد أدركَ الحَقَّ يَمشي في الضِّياءِ بهِ","والقومُ في باطلٍ يَمشُونَ في الظُّلَمِ",31,"م",1,0],["قد أدَّبَتْ كُلَّ نفسٍ في جَوانِبها","حَتَّى تأدَّبَ فيها الصَقْرُ والوَعِلُ",32,"ل",1,0],["قد ادعوا محمدا ونقض ما","قد ادعوا بأنه قد أبرما",33,"م",2,0],["قد أَدركَ الثأْرَ منهُم مَن يُعَاندهم","بالبَغْي والخَلْقُ نُوّامٌ عَنِ الثَارِ",34,"ر",1,0],["قد ادركوا ثم فاقوا من حضارتهم","بعلمهم بلغوها منذ ازمان",35,"ن",1,0],["قد أدهش الأيام منك جلائل","ملأت سنى ماضيك وهو مجيد",36,"د",1,0],["قد ادهش العلماء بنيان رسا","في اليم عُد عجيبة الازمان",37,"ن",1,0],["قد أدركت بالعلم غايتها","وأشحذت فيه جميع الرقاب",38,"ب",1,0],["قَد اِدَّعى الصَبُّ أَن راحَه","كَريقه العذب فاِنتَحل",39,"ل",1,0],["قد ادّرعن في مسير سَمد","ليلا كلون الطيلسان الجرد",40,"د",1,0],["قد أدمعت هذي الجفون بنوحها","وجفونها جفت فليست تدمع",41,"ع",1,0],["قد أدبرت وارتاعت","كتائب الطغيان",42,"ن",1,0],["قد أدرك السيل الزبى ونبت ظُبى","همّي وأدركني البلاء المطبق",43,"ق",1,0],["قَد أَدمَنُوا لُبسَ الدُرُوعِ كَأَنَّما","يَجِدُونَ في عَدَمِ الحَياةِ خُلُودا",44,"د",2,0],["قَد أَدرَكوا في قَتلِهم","ثار الوَليد وَيَوم عَتبه",45,"ب",2,0],["قد ادركت بك غاية لا ترتقي","وسمت فجاوزت البدور كمالا",46,"ل",2,0],["قد ادركت فيك جوزفين بغيتها","وباقترانك فيها حظك اكتملا",47,"ل",2,0],["قد أدارتْ يدُ التهاني علينا","خَمرةً تَغْبَقُ السَّما والكواكب",48,"ب",1,0],["قد ادعى بيتين قيلاً أولا","فأحدثا في وجهه وبالا",49,"ل",2,0],["قد أدهش عن موسى قصص","هو عبرة عين التعبير",50,"ر",1,0],["قد ادركت شأوَ الكَمالِ فأَجمَعُوا","ذي غايةٌ ما ليسَ يُدرَك شاؤُها",51,"ا",3,0],["قد أَدركت كسرى فَلا","تَزداد إِلا في ضرام",52,"م",1,0],["قد ادعى أنه حامى حقيقتها","وذاك والله إيهام وتزيين",53,"ن",1,0],["قد أدباني الليل والنهار","أذنيت واعترفت والاقرار",54,"ر",1,0],["قد أدب الحق تلك اللذات فهو على","ما قاله في أعالي ذروة الأدب",55,"ب",1,0],["قد ادَّعي رِقَّ القُلوبِ لحظُهُ","وشَهِدَ السحرُ له فيما ادَّعى",56,"ا",1,0],["قد ادَّرعوا فوق الدروع قلوبهم","وصبرَهُمُ والصبرُ نعمَ المصاحبُ",57,"ب",1,0],["قد أدوا الفرض والمندوب مكتملاً","وطهروا السر عن عيبٍ وعن قذر",58,"ر",1,0],["قَد أَدارَ الكُؤوسَ لَفظاً وَلَحظاً","وَسُلافاً مِن بِنتِ دَنٍّ قَديمِ",59,"م",1,0],["قدْ أدْركَ المَجْدَ من قد باتَ ليلتَهُ","قد نالَ ما شاْء مِنْ لِبْسِ ومنْ أُكُلِ",60,"ل",1,0],["قَدْ أُدَاوِي فَيْضَ رَعْشِي","إِنْ بَكَيْتُ الآنَ جَهْرَا",61,"ر",2,0],["قد أدار الجوز كسحاً بعطفيه","وصاغ الهلال في الساق حجلا",62,"ل",2,0],["قد أدخلَ الصبَّ المتيّمَ خلُّهُ","نارَ الغرامِ، وليسَ عنه سميحُ",63,"ح",1,0],["قد أدمنتْ دمعةُ العشاقِ رقّتها","تحنو على فيئها من قائظِ الشمسِ",64,"س",1,0],["قد أدخلوا شرْكا إلينا حسْبُهُمْ","خرجوا على ما كنْتَ فيه والِجا",65,"ج",2,0],["قد أُدخِلوا ( جنَّة الدُّنيا ) فوا لهفي","مِمَّن يُقاسي لظى الحِرمانِ مغلولا",66,"ل",2,0],["قَدْ أُدْمِيَتْ عَيْنِي وأَنْتِ صَرِيعَةٌ","في قَبْضَةِ الباغِي بأَقْبَحِ مَشْهدِ",67,"د",1,0],["قد أدمنت قرع أبواب القلوب هوىً","في حبها رغباً بالفضل ملتَزما",68,"م",2,0],["قدِ ادَّعَوْا أنَّهُ للشِّعْرِ تجربَةٌ","بصيغَةِ النَّثْرِ مصْبوغاً بتَغْريبِ",69,"ب",1,0],["قد أدبر القمر الغرّيد مبتسما","بنبل من أخمدت دمعا بتعقيل",70,"ل",1,0],["قد أدمنا حباً لنا لم يشعرا","وقت النوى عنا بغير سهاد",71,"د",1,0],["قد أدمنت مهن التكسب بالخنا","ما همُّها إلا اكتسابُ نفيسِ",72,"س",1,0],["قَدْ أدْمَنَ الجُوعَ حتَّى الأكْل أنْكَرَهُ","لمَّا أتيتُ بِهِ في هَيْأةِ الصَّدَقَةْ",73,"ق",2,0],["قد ادعيتم بأن السلم غايتكم","هاتوا دليلا على ما قلتم هاتوا",74,"ت",3,0]]}