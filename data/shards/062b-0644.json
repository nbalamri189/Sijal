تين وقد مضى","https://www.aldiwan.net/poem42330.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[75,"ثلاث خصال سدت بها عشيرتي","https://www.aldiwan.net/poem69012.html","الطويل"],[48,"لله ما تصنع الأجياد والمقل","https://www.aldiwan.net/poem65573.html","البسيط"],[50,"أيا طلحة قد كنت","https://www.aldiwan.net/poem63798.html","الهزج"],[46,"ثلاثة أيام لأهل تنافر","https://www.aldiwan.net/poem22381.html","الطويل"],[46,"ثلاث مآرب عنس وكور","https://www.aldiwan.net/poem22557.html","الوافر"],[46,"ثلاث مراتب ملك رفيع","https://www.aldiwan.net/poem22836.html","الوافر"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[8,"لبست أناسا فأفنيتهم","https://www.aldiwan.net/poem21797.html","المتقارب"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6815","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21010","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43633","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43898","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116987","المتقارب"],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[45,"للهِ ما تَصْنَعُ الأَجْيادُ والمُقَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32071",""],[28,"ألا استهزأت مني هنيدة أن رأت","https://www.poetsgate.com/ViewPoem.aspx?id=22078",""],[51,"ثلاثة ُ أشياءٍ في اثنين منهما","https://www.poetsgate.com/ViewPoem.aspx?id=30545",""],[91,"تحيّة الدستور العثماني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67927&r=&rc=206",""]],"verses":[["ثَلَمَّتَها كَيداً وَكَم شابَكَت","أَيدي المَقاديرِ وَلَم تُثلَمِ",0,"م",1,0],["ثَلاثٌ هُنَّ مُهلِكَةُ الأَنامِ","وَداعِيَةُ الصَحيحِ إِلى السِقامِ",1,"م",1,1],["ثَلاثاً وَشَهراً ثُمَّ صارَت رَذِيَّةً","طَليحَ سِفارٍ كَالسِلاحِ المُفَرَّدِ",2,"د",1,0],["ثلاثٌ غَريراتُ الكَلامِ وَناشِصٌ","عَلى البَعلِ لا يَخلو وَلا هِيَ عاشِقُهُ",3,"ق",2,0],["ثَلاثَةٌ مِن سُراةِ النيلِ قَد حَبَسوا","عَلى مَدارِسِنا سَبعينَ فَدّانا",4,"ن",2,1],["ثَلاثَةٌ لَم تَعرُ عَن عِفَّةٍ","لِسانُهُ وَالذَيلُ وَالمِئزَرُ",5,"ر",1,0],["ثَلاثونَ عاماً بَل ثَلاثونَ دُرَّةً","بِجيدِ اللَيالي ساطِعاتٍ زَواهِيا",6,"ي",2,0],["ثَلاثَةُ آسادٍ يُجانِبُها الرَدى","وَإِن هِيَ لاقاها الرَدى لا تُجانِبُه",7,"ب",2,0],["ثَلِجَت صُدورُهُمُ وَقَرَّ قَرارُهُم","لَمّا حَلَفتَ بِأَوثَقِ الأَيمانِ",8,"ن",1,0],["ثَلاثَةٌ أَحرُفُهُ","وَواحِدٌ جَميعُهُ",9,"ه",1,1],["ثَلاثَةُ أَثلاثٍ فَأَثمانُ خَيلِن","وَأَقواتُنا وَما نَسوقُ إِلى القَتلِ",10,"ل",1,0],["ثلاثةٌ إن ضمهم قصرهم","ففضلهم بأهل رحب البلد",11,"د",1,0],["ثَلاثَةُ أَعبُدٍ لِأَبٍ وَأُمٍّ","تَمَيَّزُ عَن ثَلاثَتِهِم أَرومُ",12,"م",1,0],["ثَلاثُ مُرِبّاتٍ إِذا هِجنَ هَيجَةً","قَذَفنَ الحَصى قَذفَ الأَكُفِّ الرَواجِمِ",13,"م",1,0],["ثَلاثَةَ أَحوالٍ وَحولاً وَسِتَّةً","كَما جَرَت الرَيطَ العَذارى المَوارِحُ",14,"ح",1,0],["ثلاثين حولاً بعد خمس تعوّدت","يدافع عنها كلَّ خطب ويحميها",15,"ي",3,0],["ثلاثون متراً في جدار يحيطها","بسمكٍ زهاءِ العشر في الجو مُصعِد",16,"د",1,0],["ثَلاثُ عَجائِزٍ لَهُمُ وَكَلبٌ","وَأَشياخٌ عَلى ثُلَلٍ قُعودُ",17,"د",1,0],["ثَلاثَةُ أَعوامٍ يُكابِدُ مَحلَها","أَشَمُّ طَويلُ الساعِدَينِ عُراعِرُ",18,"ر",1,0],["ثَلاثَةَ أَيّامٍ مِنَ الدَهرِ لَم يَكُن","لَهُنَّ بِتَصديقِ الَّذي قالَ رائِدُ",19,"د",1,0],["ثَلاثَةٌ بَرَّزوا بِسَبقِهُم","نَضَّرَهُم رَبُّهُم إِذا نُشِروا",20,"ر",3,1],["ثلاث مآذنٍ في الحسن زادت","فرابعها لأجل العين جاثي",21,"ي",1,1],["ثلاثة تعطف الدنيا عليَّ بها","أوطان أنسي وأحبابي وأعيادي",22,"ي",1,0],["ثَلاثَةُ أَحرُفٍ لا عُجمَ فيها","وَمَعجومانِ وَاِنقَطَعَ الكَلامُ",23,"م",1,1],["ثَلَطَتْ في نديِّنَا فاستحقت","أن يُكَافَى بصفعةٍ أَخدَعاها",24,"ا",3,0],["ثلاثةٌ تُشرقُ أنوارُها","لا بُدِّلتْ من مَشرقٍ مَغربا",25,"ب",2,0],["ثلاثةُ أعيادٍ فللفطر واحدٌ","وللعُرف ثانيه وللَّهو ثالثُهْ",26,"ث",2,0],["ثلاثةُ أيامٍ فَقَطَّ عُددتها","به ساهراً في ليله غيرَ راقدِ",27,"د",1,0],["ثلاثة أصواتٍ تغنت مُجيدةً","بهن لعمرو وهو أفرد من وتر",28,"ر",1,0],["ثَلطٌ على ثلط وضعت به","ووضعت بعد هدائل القصعه",29,"ع",2,0],["ثلاثة أشياء بها الهم يكشفُ","تميل إليها النفس مني وتصرفُ",30,"ف",1,1],["ثلاثةُ أظبٍ نَجْرُها غيرُ واحدٍ","لذي اللهو فيها كلها مُتنعَّمُ",31,"م",1,0],["ثلاثةُ أشكال نُظمن وربما","أتاح مُتيحٌ للفرائد ناظما",32,"م",2,0],["ثلاثةٌ يُعرفُ السَّخاءُ بها","فقوِّموها ورتِّبوا القِيما",33,"م",2,0],["ثلاثةُ أشياءٍ ففي اثنين منهما","رِضائي وسُخطي في المُثَلَّث منهما",34,"م",2,1],["ثَلاثا فَلَمّا اِستُجيلَ الجَها","مُ وَاِستَجمَعَ الطِفلُ مِنهُ رُشوحا",35,"ح",2,0],["ثَلاثَةَ أَعوامٍ فَلَمّا تَجَرَّمَت","عَلَينا بِهونٍ وَاِستَحارَ شَبابُها",36,"ب",3,0],["ثَلاثَ لَيالٍ ثُمَّ صَبَّحنَ رَيَّةً","وَخُضراً مِنَ الوادي رِواءً أَسافِلُه",37,"ل",2,0],["ثَلاثٍ حِسانٍ مِن نِزارٍ وَغَيرِهِم","تَجَمَّعنَ مِن شَتّى فَعولينَ في قَصرِ",38,"ر",1,0],["ثَلاثَةَ أَيّامٍ فَلَمّا تَنَبَّهَت","حُشاشاتُ أَنفاسٍ أَتَتنا تَرَدَّدُ",39,"د",1,0],["ثَلاثَةٌ لِلسُرورِ ما رَقَدوا","أَنا وَأُختُ المَهاة وَالقَمَرُ",40,"ر",1,0],["ثَلاثونَ عاماً وَالنَوائِبُ فَوقَنا","مُخَيِّمَةٌ مِثلُ الغُيومِ القَواتِمِ",41,"م",1,0],["ثَلاثَةٌ تَشابَهَت","خَطّي مِدادي وَرَقي",42,"ي",1,0],["ثَلاثَةَ أَعوامٍ أَقَمتَ وَأَشهُراً","تُجاهِدُ فيهِم لا بِزَيدٍ وَلا عَمرِو",43,"ر",2,0],["ثَلاثاً عَلى الأَقدامِ حَتّى سَما بِنا","عَلى العَوصِ شَعشاعً مِنَ القَومِ مِحرَبُ",44,"ب",1,0],["ثَلاثَةُ أَصحابٍ فُؤادٌ مُشَيَّعٌ","وَأَبيَضُ إِصليتٌ وَصَفراءُ عَيطَلُ",45,"ل",1,0],["ثَلاثٍ صَلَينَ النارَ شَهراً وَأَرزَمَت","عَلَيهِنَّ رَجزاءُ القِيامِ هَدوجُ",46,"ج",1,0],["ثَلاثَةٌ مَنَعَتها عَن زيارَتِنا","خَوفُ الرَقيبِ وَخَوفُ الحاسِد الحَنِقِ",47,"ق",1,1],["ثَلاثَةُ أَبياتٍ فَبَيت أُحِبُّهُ","وَبَيتانِ لَيسا مِن هَوايَ وَلا شَكلي",48,"ي",1,0],["ثلة منهم العيون تريني","ما تكن الصدور من احقاد",49,"د",1,0],["ثلاثة أسباب لأُنسى ولذتي","يبارك فيها مانِحِى ويديم",50,"م",1,0],["ثلاثة نال نعمى الخلد مدركها","الله والعلم والتاريخ فاغتنموا",51,"م",3,0],["ثُلثاهُ مِنقارٌ وَرَأ","سٌ وَالأَظافِرُ ما بَقي",52,"ي",1,0],["ثَلاثُ عَقائِدَ في حُفرَةٍ","تَدُكُّ الجِبالَ وَتوهي الحَديد",53,"د",1,0],["ثَلاثَةٌ تُسرِعُ النُجحَ المَكيثَ إِذا","تَسانَدوا فيهِ أَعواناً وَرُفّادا",54,"د",2,0],["ثَلَثتَ فُراتَيها بِجودِ سَجِيَّةٍ","وَجَدناكَ أَولى بِالتَدَفُّقِ مِنهُما",55,"م",2,0],["ثَلاثَةُ أَسلافٍ فَجِئني بِمِثلِهِم","فَكُلٌّ لَهُ يا اِبنَ المَراغَةِ أَوَّلُ",56,"ل",1,0],["ثَلاثينَ عاماً لا أَرى مِن عَمايَةٍ","إِذا بَرَقَت إِلّا شَدَدتُ لَها رَحلي",57,"ل",2,0],["ثلاثةٌ منه تجلو كلَّ داجيةٍ","جبينُه وغِرارُ السَّيفِ والحَسَبُ",58,"ب",1,0],["ثَلاثٌ كَأَقواسِ السَراءِ وَمِسحَلٌ","قَدِ اِخضَرَّ مِن لَسِّ الغَميرِ جَحافِلُه",59,"ل",2,0],["ثلاثة في العود محمودة","وتلك في العنبر لا تحمد",60,"د",1,1],["ثَلَجَت عَلى حِفظِ الوَدادِ قُلوبُنا","وَلَظى الهَوى بِضِيائِها يَتَأَرَّثُ",61,"ث",1,0],["ثَلبَ الوَرى عِرضي المَصونَ وَحَبَّذا","لَو صَحَّ ما قالَ العِدى وَتَحَدَّثوا",61,"ث",3,0],["ثَلَمَ الهَوى حَدّي وَكُنتُ مُهَنَّداً","ماضي الغِرارِ بِغِمدِهِ لا يَمكُثُ",61,"ث",1,0],["ثلاث سنين أم ثلاث ليال","هي البرق أم مرَّت كلمح خيال",62,"ل",1,1],["ثلاثةُ أفلاكٍ عن العين مُضمرهْ","تدور إذا حرّكتها في حشَا كُرَه",63,"ر",2,1],["ثَلاثَةُ أَركانٍ وَما اِنهَدَّ سُؤدُدٌ","إِذا ثَبَتَت فيهِ ثَلاثُ دَعائِمِ",64,"م",1,0],["ثَلِمتَهُم بِالمَشرَفِيِّ وَقَلَّما","تَثَلَّمَ عِزُّ القَومِ إِلّا تَهَدَّما",65,"م",2,0],["ثلاثُ حفْراتٍ تملَّتْ بهِ","يا شرفَ المسكنِ بالساكنِ",66,"ن",1,0],["ثلجٌ بآذارَ أمِ الكافورُ في","مزاجِهِ ولونِهِ والمطعمِ",67,"م",1,1],["ثلاثةٌ كنْ حذراً خائفاً","منها ولوْ ظاهرُها أعجبَكْ",68,"ك",1,1],["ثَلاثَ حَماماتٍ وُقوعٍ إِذا دَعا","رَدَدنَ إِلَيهِ الحُزنَ إِذ هَيَّجَ الهَدرا",69,"ر",2,0],["ثَلاثَةِ أَحجارٍ وَخَطٍّ خَطَطتِهِ","لَنا بِطَريقِ الغَورِ بِالمُتَنَجَّدِ",70,"د",1,1],["ثلاثةُ أقطابٍ صَرَفتَ قُلوبَهُم","إلى اللَّهِ تُحْييهِم وترجو المصائرا",71,"ر",2,0],["ثَلمةٌ هدَّت من الكفرِ حِمىً","زعم الكفّارُ أن لن يُفْرَعا",72,"ع",2,0],["ثَلاثَةَ أَحوالٍ يُحاوِلُ فُرصَةً","مِنَ السُوقِ لا يَدري مَتى السُوقُ نازِعُ",73,"ع",1,0],["ثَلاثَةٌ لِلمُلكِ كَالأَثافي","قَوادِمٌ لَيسَت مِنَ الخَوافي",74,"ي",1,0],["ثلاثُ خِصَال سُدتُ بها عَشيرَتي","وَمن لم تَكُن فيه فَليسَ بِسَيِّدِ",75,"د",1,1],["ثَلاثَةٌ جِلَّةٌ إِن شُوِّروا نَصَحوا","أَوِ اِستُعينوا كَفَوا أَو سُلِّطوا عَدَلوا",76,"ل",3,0],["ثَلاثينَ وَسِتّينَ","وَعَشراً غَيرَ تَمصيرِ",77,"ر",1,0],["ثَلاثَةُ أَيّامٍ لِأَهلِ تَنافُرٍ","وَلَكِنَّ قَولَ المُسلِمينَ هُوَ الثَبتُ",78,"ت",1,1],["ثَلاثُِ مَآرِبٍ عَنسٌ وَكورٌ","وَنَهجٌ قَد أَبانَ فَهَل بُكورُ",79,"ر",1,1],["ثَلاثُ مَراتِبٍ مَلَكٌ رَفيعٌ","وَإِنسانٌ وَجيلٌ غَيرُ إِنسِ",80,"س",1,1],["ثلاثةُ أيّامٍ هيَ الدّهرُ كلّه","وما هُنّ غيرَ الأمسِ واليومِ والغَدِ",81,"د",1,0],["ثَلاثَةُ أَبرادٍ جِيادٍ وَجُرجَةٌ","وَأَدكَنُ مِن أَريِ الدَبورِ مُعَسَّلُ",82,"ل",1,0],["ثَلاَثَةَ أَهِلينَ أَفنَيتُهُم","وَكانَ الإِلهُ هُوَ المُستآسا",83,"س",2,0],["ثَلاثَةُ أَثلاثٍ فَأَثمانُ خَيلِنا","وَأَقواتُنا وَما نَسوقُ إِلى القَتلِ",84,"ل",1,0],["ثلاثةٌ تُدعى بالابتداءِ","والفَصلِ والغايةِ في الأَجزاءِ",85,"ا",2,0],["ثلاثةٌ قالتْ عليها العربُ","واثنانِ صدُّوا عنهما ونَكبوا",85,"ب",3,0],["ثَلاَثَةَ أَحوالٍ وشَهراً مُحَرَّماً","تُضيءُ كَعَينِ العُترُفَانِ المُحارِبِ",86,"ب",1,1],["ثَلاثَةُ أَصْنَافٍ تَقِيهنَّ ساقَةٌ","صِيَالَ الْعِدَا إِنْ صاحَ بِالشَّرِّ صَائِحُ",87,"ح",1,0],["ثَلاَثَةٌ فِي نَسَقٍ قَلَّمَا","بِمِثْلِهِ دَهْرٌ عَلَى مِصْرَ جَادْ",88,"د",1,0],["ثَلاثَةُ أَقْيَالٍ تَمَثَّلَ فِيهِم","أَبُوهُمْ وَلَمْ يَأْلُوهُ حُبّاً وَلا بِرّاً",89,"ر",2,0],["ثُلَّ عَرْشُ الْجُمُودِ فِي مَعْقِلِ الحرْ","صِ عَلَيْهِ وَفُلَّ جَيْشُ الْجُمُودِ",90,"د",1,0],["ثلاثةُ آلافٍ وَنَحْنُ نَصِيَّةٌ","ثَلاَثُ مِئينٍ إنْ كَثُرْنَا وأَرْبعُ",91,"ع",1,0],["ثلاثة ما عشت عاشت للعلى","ألحب ثم الشعر ثم المنبر",92,"ر",1,0],["ثَلاثُ يَواقيتٍ عَلى صَحنِ فِضَّةٍ","نُظِمنَ وَفي خَدَّيَّ نَثرُ جُمانِ",93,"ن",1,0],["ثَلاثٌ سَلَبنَ القَلبَ حُسنَ عَزائِهِ","وَأَلبَسنَني ثَوبي خَليعٍ وَناكِثِ",94,"ث",1,0],["ثَلمتُ صَفا صَبري فأورَثَني الضَنى","فَوَيح غَريبٍ لِلضَّنى مِنك وارِثِ",94,"ث",1,0],["ثلاثةٌ لا خِلافَ أَنَّهمُ","خَيرٌ من الفَرْقَدَيْن والزُّهَره",95,"ر",2,0],["ثَلاثَةٌ قَد أُصيبَ فيهِم","وَوَعدي الحَقُّ في اِنبِعاثِ",96,"ث",1,0],["ثلاثين أخرى على قدرها","تباركت يا أحسن الخالقينا",97,"ن",2,0],["ثلاثَ عَشْرَةَ مَّرتْ لم تَدَعْ حجرًا","إلا تناوله نقْص وبنيان",98,"ن",1,0],["ثلاثَ عشرةَ ما شاب الشبابُ بها","ولا تجاوز سِنَّ الرشْد غلمان",98,"ن",1,0],["ثلاثونَ رُحْنا عليها معاً","نعذَّبُ حِيناً ونستنعِم",99,"م",1,0],["ثَلاَثَةٌ جِلَّةٌ أِن شُووِرُوا نَصَحْوا،","أَوِ اسْتُعِينُوا كَفَوا ،أَو سُلِّطُوا عدَلُوا",100,"ل",3,0],["ثَلاثِينَ عاماً ما أرَى مِنْ عَمَايَةٍ،","إذا بَرَقَتْ، إلاّ شَدَدْتُ لها رَحْلي",101,"ل",2,0],["ثلاثة ُ أشياءٍ في اثنين منهما","رِضائي وسُخطي في المُثَلَّث منهما",102,"م",2,1],["ثلاثون عاما والنّوائب فوقنا","مخيمة مثل الغيوم القوائم",103,"م",1,0]]}