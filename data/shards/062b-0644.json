"https://www.aldiwan.net/poem40717.html","الخفيف"],[426,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[429,"كأنما الرعد والسحاب وقد","https://www.aldiwan.net/poem12582.html","المنسرح"],[429,"أيجور الزمان يا ثقة المل","https://www.aldiwan.net/poem12784.html","الخفيف"],[434,"ثلاثة لم يرها ناظر","https://www.aldiwan.net/poem2518.html","السريع"],[436,"وفي سر من را من محلي مقاصر","https://www.aldiwan.net/poem34758.html","الطويل"],[436,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[438,"ألا إن كتب الأنبياء عليهم","https://www.aldiwan.net/poem14406.html","الطويل"],[438,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[438,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[450,"ثلاثين قاض عد من بعد أربع","https://www.aldiwan.net/poem13645.html","الطويل"],[450,"ما اسم ثلاثي وفعل معا","https://www.aldiwan.net/poem13784.html","السريع"],[451,"قالوا لنا فرحات سوف يتركنا","https://www.aldiwan.net/poem61254.html","البسيط"],[452,"أكلت شبابي فأفنيته","https://www.aldiwan.net/poem711.html",""],[456,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[456,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[494,"شام يا ذا السيف","https://www.aldiwan.net/poem55807.html","عموديه"],[512,"أوائل أسماء الذين ارتجيتهم","https://www.aldiwan.net/poem20854.html","الطويل"],[527,"ثلاثة قل أن تراها","https://www.aldiwan.net/poem37089.html","مجزوء الكامل"],[536,"ثلاث سنين مكثت بها","https://www.aldiwan.net/poem47456.html","عموديه"],[536,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[549,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[549,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[556,"ثمرات على غصون الحوادث","https://www.aldiwan.net/poem33556.html","الخفيف"],[556,"نحن قوم متنا به وفنينا","https://www.aldiwan.net/poem33804.html","الخفيف"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[556,"ثلاث عليها يدور","https://www.aldiwan.net/poem34506.html","مجزوء المتقارب"],[559,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[565,"باكر فهذي صبيحة قره","https://www.aldiwan.net/poem69696.html","المنسرح"],[567,"ثلاثة املاك ربوا في حجورنا","https://www.aldiwan.net/poem52038.html","الطويل"],[573,"سلني بالله عن فلان","https://www.aldiwan.net/poem2845.html","مخلع البسيط"],[581,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""]],"verses":[["ثَلَمَّتَها كَيداً وَكَم شابَكَت","أَيدي المَقاديرِ وَلَم تُثلَمِ",0,"م",1,0],["ثَلاثٌ هُنَّ مُهلِكَةُ الأَنامِ","وَداعِيَةُ الصَحيحِ إِلى السِقامِ",1,"م",1,1],["ثَلاثاً وَشَهراً ثُمَّ صارَت رَذِيَّةً","طَليحَ سِفارٍ كَالسِلاحِ المُفَرَّدِ",2,"د",1,0],["ثلاثٌ غَريراتُ الكَلامِ وَناشِصٌ","عَلى البَعلِ لا يَخلو وَلا هِيَ عاشِقُهُ",3,"ق",2,0],["ثَلاثَةٌ مِن سُراةِ النيلِ قَد حَبَسوا","عَلى مَدارِسِنا سَبعينَ فَدّانا",4,"ن",2,1],["ثَلاثَةٌ لَم تَعرُ عَن عِفَّةٍ","لِسانُهُ وَالذَيلُ وَالمِئزَرُ",5,"ر",1,0],["ثَلاثونَ عاماً بَل ثَلاثونَ دُرَّةً","بِجيدِ اللَيالي ساطِعاتٍ زَواهِيا",6,"ي",2,0],["ثَلاثَةُ آسادٍ يُجانِبُها الرَدى","وَإِن هِيَ لاقاها الرَدى لا تُجانِبُه",7,"ب",2,0],["ثَلِجَت صُدورُهُمُ وَقَرَّ قَرارُهُم","لَمّا حَلَفتَ بِأَوثَقِ الأَيمانِ",8,"ن",1,0],["ثَلاثَةٌ أَحرُفُهُ","وَواحِدٌ جَميعُهُ",9,"ه",1,1],["ثَلاثَةُ أَثلاثٍ فَأَثمانُ خَيلِن","وَأَقواتُنا وَما نَسوقُ إِلى القَتلِ",10,"ل",1,0],["ثلاثةٌ إن ضمهم قصرهم","ففضلهم بأهل رحب البلد",11,"د",1,0],["ثَلاثَةُ أَعبُدٍ لِأَبٍ وَأُمٍّ","تَمَيَّزُ عَن ثَلاثَتِهِم أَرومُ",12,"م",1,0],["ثَلاثُ مُرِبّاتٍ إِذا هِجنَ هَيجَةً","قَذَفنَ الحَصى قَذفَ الأَكُفِّ الرَواجِمِ",13,"م",1,0],["ثَلاثَةَ أَحوالٍ وَحولاً وَسِتَّةً","كَما جَرَت الرَيطَ العَذارى المَوارِحُ",14,"ح",1,0],["ثلاثين حولاً بعد خمس تعوّدت","يدافع عنها كلَّ خطب ويحميها",15,"ي",3,0],["ثلاثون متراً في جدار يحيطها","بسمكٍ زهاءِ العشر في الجو مُصعِد",16,"د",1,0],["ثَلاثُ عَجائِزٍ لَهُمُ وَكَلبٌ","وَأَشياخٌ عَلى ثُلَلٍ قُعودُ",17,"د",1,0],["ثَلاثَةُ أَعوامٍ يُكابِدُ مَحلَها","أَشَمُّ طَويلُ الساعِدَينِ عُراعِرُ",18,"ر",1,0],["ثَلاثَةَ أَيّامٍ مِنَ الدَهرِ لَم يَكُن","لَهُنَّ بِتَصديقِ الَّذي قالَ رائِدُ",19,"د",1,0],["ثَلاثَةٌ بَرَّزوا بِسَبقِهُم","نَضَّرَهُم رَبُّهُم إِذا نُشِروا",20,"ر",3,1],["ثلاث مآذنٍ في الحسن زادت","فرابعها لأجل العين جاثي",21,"ي",1,1],["ثلاثة تعطف الدنيا عليَّ بها","أوطان أنسي وأحبابي وأعيادي",22,"ي",1,0],["ثَلاثَةُ أَحرُفٍ لا عُجمَ فيها","وَمَعجومانِ وَاِنقَطَعَ الكَلامُ",23,"م",1,1],["ثَلَطَتْ في نديِّنَا فاستحقت","أن يُكَافَى بصفعةٍ أَخدَعاها",24,"ا",3,0],["ثلاثةٌ تُشرقُ أنوارُها","لا بُدِّلتْ من مَشرقٍ مَغربا",25,"ب",2,0],["ثلاثةُ أعيادٍ فللفطر واحدٌ","وللعُرف ثانيه وللَّهو ثالثُهْ",26,"ث",2,0],["ثلاثةُ أيامٍ فَقَطَّ عُددتها","به ساهراً في ليله غيرَ راقدِ",27,"د",1,0],["ثلاثة أصواتٍ تغنت مُجيدةً","بهن لعمرو وهو أفرد من وتر",28,"ر",1,0],["ثَلطٌ على ثلط وضعت به","ووضعت بعد هدائل القصعه",29,"ع",2,0],["ثلاثة أشياء بها الهم يكشفُ","تميل إليها النفس مني وتصرفُ",30,"ف",1,1],["ثلاثةُ أظبٍ نَجْرُها غيرُ واحدٍ","لذي اللهو فيها كلها مُتنعَّمُ",31,"م",1,0],["ثلاثةُ أشكال نُظمن وربما","أتاح مُتيحٌ للفرائد ناظما",32,"م",2,0],["ثلاثةٌ يُعرفُ السَّخاءُ بها","فقوِّموها ورتِّبوا القِيما",33,"م",2,0],["ثلاثةُ أشياءٍ ففي اثنين منهما","رِضائي وسُخطي في المُثَلَّث منهما",34,"م",2,1],["ثَلاثا فَلَمّا اِستُجيلَ الجَها","مُ وَاِستَجمَعَ الطِفلُ مِنهُ رُشوحا",35,"ح",2,0],["ثَلاثَةَ أَعوامٍ فَلَمّا تَجَرَّمَت","عَلَينا بِهونٍ وَاِستَحارَ شَبابُها",36,"ب",3,0],["ثَلاثَ لَيالٍ ثُمَّ صَبَّحنَ رَيَّةً","وَخُضراً مِنَ الوادي رِواءً أَسافِلُه",37,"ل",2,0],["ثَلاثٍ حِسانٍ مِن نِزارٍ وَغَيرِهِم","تَجَمَّعنَ مِن شَتّى فَعولينَ في قَصرِ",38,"ر",1,0],["ثَلاثَةَ أَيّامٍ فَلَمّا تَنَبَّهَت","حُشاشاتُ أَنفاسٍ أَتَتنا تَرَدَّدُ",39,"د",1,0],["ثَلاثَةٌ لِلسُرورِ ما رَقَدوا","أَنا وَأُختُ المَهاة وَالقَمَرُ",40,"ر",1,0],["ثَلاثونَ عاماً وَالنَوائِبُ فَوقَنا","مُخَيِّمَةٌ مِثلُ الغُيومِ القَواتِمِ",41,"م",1,0],["ثَلاثَةٌ تَشابَهَت","خَطّي مِدادي وَرَقي",42,"ي",1,0],["ثَلاثَةَ أَعوامٍ أَقَمتَ وَأَشهُراً","تُجاهِدُ فيهِم لا بِزَيدٍ وَلا عَمرِو",43,"ر",2,0],["ثَلاثاً عَلى الأَقدامِ حَتّى سَما بِنا","عَلى العَوصِ شَعشاعً مِنَ القَومِ مِحرَبُ",44,"ب",1,0],["ثَلاثَةُ أَصحابٍ فُؤادٌ مُشَيَّعٌ","وَأَبيَضُ إِصليتٌ وَصَفراءُ عَيطَلُ",45,"ل",1,0],["ثَلاثٍ صَلَينَ النارَ شَهراً وَأَرزَمَت","عَلَيهِنَّ رَجزاءُ القِيامِ هَدوجُ",46,"ج",1,0],["ثَلاثَةٌ مَنَعَتها عَن زيارَتِنا","خَوفُ الرَقيبِ وَخَوفُ الحاسِد الحَنِقِ",47,"ق",1,1],["ثَلاثَةُ أَبياتٍ فَبَيت أُحِبُّهُ","وَبَيتانِ لَيسا مِن هَوايَ وَلا شَكلي",48,"ي",1,0],["ثلة منهم العيون تريني","ما تكن الصدور من احقاد",49,"د",1,0],["ثلاثة أسباب لأُنسى ولذتي","يبارك فيها مانِحِى ويديم",50,"م",1,0],["ثلاثة نال نعمى الخلد مدركها","الله والعلم والتاريخ فاغتنموا",51,"م",3,0],["ثُلثاهُ مِنقارٌ وَرَأ","سٌ وَالأَظافِرُ ما بَقي",52,"ي",1,0],["ثَلاثُ عَقائِدَ في حُفرَةٍ","تَدُكُّ الجِبالَ وَتوهي الحَديد",53,"د",1,0],["ثَلاثَةٌ تُسرِعُ النُجحَ المَكيثَ إِذا","تَسانَدوا فيهِ أَعواناً وَرُفّادا",54,"د",2,0],["ثَلَثتَ فُراتَيها بِجودِ سَجِيَّةٍ","وَجَدناكَ أَولى بِالتَدَفُّقِ مِنهُما",55,"م",2,0],["ثَلاثَةُ أَسلافٍ فَجِئني بِمِثلِهِم","فَكُلٌّ لَهُ يا اِبنَ المَراغَةِ أَوَّلُ",56,"ل",1,0],["ثَلاثينَ عاماً لا أَرى مِن عَمايَةٍ","إِذا بَرَقَت إِلّا شَدَدتُ لَها رَحلي",57,"ل",2,0],["ثلاثةٌ منه تجلو كلَّ داجيةٍ","جبينُه وغِرارُ السَّيفِ والحَسَبُ",58,"ب",1,0],["ثَلاثٌ كَأَقواسِ السَراءِ وَمِسحَلٌ","قَدِ اِخضَرَّ مِن لَسِّ الغَميرِ جَحافِلُه",59,"ل",2,0],["ثلاثة في العود محمودة","وتلك في العنبر لا تحمد",60,"د",1,1],["ثَلَجَت عَلى حِفظِ الوَدادِ قُلوبُنا","وَلَظى الهَوى بِضِيائِها يَتَأَرَّثُ",61,"ث",1,0],["ثَلبَ الوَرى عِرضي المَصونَ وَحَبَّذا","لَو صَحَّ ما قالَ العِدى وَتَحَدَّثوا",61,"ث",3,0],["ثَلَمَ الهَوى حَدّي وَكُنتُ مُهَنَّداً","ماضي الغِرارِ بِغِمدِهِ لا يَمكُثُ",61,"ث",1,0],["ثلاث سنين أم ثلاث ليال","هي البرق أم مرَّت كلمح خيال",62,"ل",1,1],["ثلاثةُ أفلاكٍ عن العين مُضمرهْ","تدور إذا حرّكتها في حشَا كُرَه",63,"ر",2,1],["ثَلاثَةُ أَركانٍ وَما اِنهَدَّ سُؤدُدٌ","إِذا ثَبَتَت فيهِ ثَلاثُ دَعائِمِ",64,"م",1,0],["ثَلِمتَهُم بِالمَشرَفِيِّ وَقَلَّما","تَثَلَّمَ عِزُّ القَومِ إِلّا تَهَدَّما",65,"م",2,0],["ثلاثُ حفْراتٍ تملَّتْ بهِ","يا شرفَ المسكنِ بالساكنِ",66,"ن",1,0],["ثلجٌ بآذارَ أمِ الكافورُ في","مزاجِهِ ولونِهِ والمطعمِ",67,"م",1,1],["ثلاثةٌ كنْ حذراً خائفاً","منها ولوْ ظاهرُها أعجبَكْ",68,"ك",1,1],["ثَلاثَ حَماماتٍ وُقوعٍ إِذا دَعا","رَدَدنَ إِلَيهِ الحُزنَ إِذ هَيَّجَ الهَدرا",69,"ر",2,0],["ثَلاثَةِ أَحجارٍ وَخَطٍّ خَطَطتِهِ","لَنا بِطَريقِ الغَورِ بِالمُتَنَجَّدِ",70,"د",1,1],["ثلاثةُ أقطابٍ صَرَفتَ قُلوبَهُم","إلى اللَّهِ تُحْييهِم وترجو المصائرا",71,"ر",2,0],["ثَلمةٌ هدَّت من الكفرِ حِمىً","زعم الكفّارُ أن لن يُفْرَعا",72,"ع",2,0],["ثَلاثَةَ أَحوالٍ يُحاوِلُ فُرصَةً","مِنَ السُوقِ لا يَدري مَتى السُوقُ نازِعُ",73,"ع",1,0],["ثَلاثَةٌ لِلمُلكِ كَالأَثافي","قَوادِمٌ لَيسَت مِنَ الخَوافي",74,"ي",1,0],["ثلاثُ خِصَال سُدتُ بها عَشيرَتي","وَمن لم تَكُن فيه فَليسَ بِسَيِّدِ",75,"د",1,1],["ثَلاثَةٌ جِلَّةٌ إِن شُوِّروا نَصَحوا","أَوِ اِستُعينوا كَفَوا أَو سُلِّطوا عَدَلوا",76,"ل",3,0],["ثَلاثينَ وَسِتّينَ","وَعَشراً غَيرَ تَمصيرِ",77,"ر",1,0],["ثَلاثَةُ أَيّامٍ لِأَهلِ تَنافُرٍ","وَلَكِنَّ قَولَ المُسلِمينَ هُوَ الثَبتُ",78,"ت",1,1],["ثَلاثُِ مَآرِبٍ عَنسٌ وَكورٌ","وَنَهجٌ قَد أَبانَ فَهَل بُكورُ",79,"ر",1,1],["ثَلاثُ مَراتِبٍ مَلَكٌ رَفيعٌ","وَإِنسانٌ وَجيلٌ غَيرُ إِنسِ",80,"س",1,1],["ثلاثةُ أيّامٍ هيَ الدّهرُ كلّه","وما هُنّ غيرَ الأمسِ واليومِ والغَدِ",81,"د",1,0],["ثَلاثَةُ أَبرادٍ جِيادٍ وَجُرجَةٌ","وَأَدكَنُ مِن أَريِ الدَبورِ مُعَسَّلُ",82,"ل",1,0],["ثَلاَثَةَ أَهِلينَ أَفنَيتُهُم","وَكانَ الإِلهُ هُوَ المُستآسا",83,"س",2,0],["ثَلاثَةُ أَثلاثٍ فَأَثمانُ خَيلِنا","وَأَقواتُنا وَما نَسوقُ إِلى القَتلِ",84,"ل",1,0],["ثلاثةٌ تُدعى بالابتداءِ","والفَصلِ والغايةِ في الأَجزاءِ",85,"ا",2,0],["ثلاثةٌ قالتْ عليها العربُ","واثنانِ صدُّوا عنهما ونَكبوا",85,"ب",3,0],["ثَلاَثَةَ أَحوالٍ وشَهراً مُحَرَّماً","تُضيءُ كَعَينِ العُترُفَانِ المُحارِبِ",86,"ب",1,1],["ثَلاثَةُ أَصْنَافٍ تَقِيهنَّ ساقَةٌ","صِيَالَ ال