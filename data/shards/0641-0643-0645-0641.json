=180079",""],[5804,"تعليل","https://www.poetsgate.com/ViewPoem.aspx?id=184468",""],[5939,"تعريف من معجم العشق","https://www.poetsgate.com/ViewPoem.aspx?id=180328",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[6102,"رب القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=184158",""],[6147,"ترشف ..من دموعي..","https://www.poetsgate.com/ViewPoem.aspx?id=151494",""],[572,"لهُ شُغُلٌ عنْ سؤالِ الطّلَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9447&r=&rc=304",""]],"verses":[["فَكَم فيهِمُ مِن واعِدٍ غَيرِ مُنجِزٍ","وَكَم فيهِمُ مِن قائِلٍ غَيرِ صادِقِ",0,"ق",1,0],["فَكَم فُرِّجَت مِن بَعدِ ما أُغلِقَت لَنا","مَغالِقُها وَاِستَبهَمَت حَلَقائُها",1,"ه",2,0],["فَكَم فَلَّ مِنّي ساعِداً بَعدَ ساعِدٍ","وَكَم جَبَّ مِنّي غارِباً بَعدَ غارِبِ",2,"ب",1,0],["فَكَمْ فُتَّ مِنْ خَطْبٍ وَجَاوَزْتَ مِنْ رَدىً","تَذُوبُ لِمَجْرَاهُ الْمُلَمْلَمَةُ الصُّمُّ",3,"م",1,0],["فكمْ في مَجاني وَرْدِها منْ علاقَةٍ","إذا ما اسْتُثيرَتْ أرْضُها أنْبَتَتْ وجْدا",4,"د",2,0],["فَكَم فيهِمُ مِن سَيِّدٍ مُتَوَسِّعٍ","وَمِن فاعِلٍ لِلخَيرِ إِن هَمَّ أَو عَزَم",5,"م",1,0],["فَكَم في طَريقِ الشَرِّ خَيرٌ وَنِعمَةٌ","وَكَم في طَريقِ الطَيِّباتِ شُرورُ",6,"ر",1,0],["فكمْ فيه للأبصار من مُتَنَزَّهٍ","تجدُّ به نفس الحليم الأمانيا",7,"ي",2,0],["فكم في قباب الحيِّ من شَمْسِ كِلَّةٍ","وفي فلك الأزرار من قمر سعدِ",8,"د",1,0],["فكم فيه من صرح ترى لدهر متلعا","يمدّ إلى ادراك شرفته العنقا",9,"ق",2,0],["فَكَم فيهِمُ مِن سَوأَةٍ ذاتِ أَفرُخٍ","تُعَدُّ وَأُخرى قَد أُتِمَّت شُهورُها",10,"ر",3,0],["فَكَم فَرَّجوا مِن كُربَةٍ وَتَغَوَّلَت","مَشاهِدُهُم مِن طَخيَةٍ وَضَبابِها",11,"ب",3,0],["فَكَم في الدُجى مِن فَرحَةٍ بِلِقائِها","وَمِن تَرحَةٍ بِالبَينِ مِنها لَدى الفَجرِ",12,"ر",1,0],["فَكَم فِتنَةٍ أَخرَجتَنا مِن ظَلامِها","وَخَطبٍ تَجَلّى عَن حِسامِكَ هائِلُه",13,"ل",2,0],["فَكَم فيهِمِ مِن مُنعِمٍ مُتَطَوِّلٍ","بِآلائِهِ أَو مُشرِفٍ مُتَطاوِلِ",14,"ل",1,0],["فَكَم فيهِمُ مِن سَيِّدٍ وَاِبنِ سَيِّدٍ","وَمِن ضارِبٍ بِالسَيفِ رَأسَ المُتَوَّجِ",15,"ج",1,0],["فكم في الحيِّ من قلبٍ أصمّ","تَنَكَّرَ أو تَجَاهَلَ أو تعامى",16,"م",2,0],["فكم فيه من خُلُقٍ طاهرٍ","ومن همّةٍ في العُلى ساميَه",17,"ي",2,0],["فَكَمْ فِي الأَرْضِ مِنْ مَجْرَى غَدِيرٍ","وَكَمْ فِي الْجَوِّ مِنْ مَسْرَى غَمَامَهْ",18,"م",2,0],["فَكَم فيهِمُ مِن سَيِّدٍ قَد رُزِئتُهُ","وَذي شَيبَةٍ كَالبَدرِ أَروَعَ أَزهَرا",19,"ر",2,0],["فَكَم فِضَّةٍ فَضَّها في سُرورِ","يَومٍ وَكَم ذَهَبٍ قَد ذَهَب",20,"ب",1,0],["فكم فِيهِمِ من ذي غِرارَينِ قد نَبَا","ومِدْرَهِ قَومٍ قد تَلَجْلَجَ منطِقُه",21,"ق",2,0],["فَكَم في الصَحنِ مِن قَلبٍ","كَليمِ الجُرحِ مَخلوسِ",22,"س",1,0],["فكم فريسةِ ضِرْغامٍ ظفِرْتَ بها","فحُزْتَها وهْيَ بيْنَ النّابِ والظُّفُرِ",23,"ر",1,0],["فكم في مصر أجسام مراض","بأرواح كأشباح الطلول",24,"ل",1,0],["فكم فارس عَوّضته من جواده","بأثمن إلا أنه غير صاهل",25,"ل",1,0],["فكم فيه من قلب لبعدك خافق","ومن لوعة تذكي ومن عبرة تجري",26,"ر",2,0],["فكَمْ في الشَّرقِ من بَلدٍ جريحٍ","تشَكِّى لا الجروحَ بَلِ الضِّمادا!",27,"د",2,0],["فَكَمْ فِيهِمُ مِنْ سَيِّدٍ قَدْ رُزِئْتُهُ","وذي شَيْبَة ٍ كَکلْبَدْرِ أَرْوَعَ أَزْهَرا",28,"ر",2,0],["فَكَم فَلَّ ذا حَدٍّ وَذَلَّقَ نابِياً","وَآمَنَ مُرتاعاً وَرَوَّعَ أَروَعا",29,"ع",2,0],["فكم فرج على قرب تأَتّى","وكانَ عَلى قياسكِ فيه بعدُ",30,"د",1,0],["فَكَم فارقَ الأَوطانَ مِن ذي ضَراعَةٍ","فَأَصبَحَ في كُلِّ النَواحي مُحَسَّدا",31,"د",2,0],["فَكَم فَكَم تَيَمَّنِي","غُزَيِّلٌ عَقَيقَلي",32,"ل",2,0],["فَكَمْ فَتْكَةٍ لِي فِي ذُرَى عَرَصَاتِها","أَرُوحُ عَلى سُكْرٍ وأَغْدُو عَلَى سُكْرٍ",33,"ر",1,0],["فكم فرجوا عن كلِّ نفسٍ حزينةٍ","فما غبسَ المحزونُ حتى تبسما",34,"م",2,0],["فكم في عراص المعركات لخيله","صريع بأطراف الرماح دحيض",35,"ض",1,0],["فَكَم فيما أَغرَت عَلَيَّ مِنهُ","لَحاكَ اللَهُ مِن وَجهٍ صَبيحِ",36,"ح",1,0],["فكم فتحت حسناءُ ثغراً وذبَّلت","جفوناً لتُغريني فما افترَّ لي ثغر",37,"ر",1,0],["فكم فَتَحتَ لهم جنّاتِ عَدنٍ","وكم شهرت لهم حرباً ضروسا",38,"س",2,0],["فكم فتحتِ قلوباً","باللّينِ منّي تَلين",39,"ن",1,0],["فكم في ليالي الأمنِ باتَت سَميرتي","نرى حولنا الجنّاتِ والهضَبات",40,"ت",1,0],["فكم في القنوطِ لهُ صَيحةً","صَداها تكرَّر تحتَ الظَّلام",41,"م",1,0],["فكم فاضلٍ عزّت عليهِ رغيفُهُ","وأحمقَ يَبغي أو يقامرُ أو يسكر",42,"ر",1,0],["فكم في بقاياهُ شؤُوناً وكم لها","شجوناً وفي نورِ الهوى بانَ ما استتَرْ",43,"ر",1,0],["فكَم فيكَ أياماً تولّت سريعةً","وكم فيكَ أصواتاً ورنات أعواد",44,"د",1,0],["فكم فنٍّ من البلوى عَراني","لِعْشق الوصفِ منك بكلِّ فنِّ",45,"ن",1,0],["فَكَم فيهنَّ من بَيضاءَ رؤدٍ","ضياءُ جَبينها بالصُبح هازي",46,"ز",2,0],["فَكَم فَرجٍ أَنالك بَعدَ ضيقٍ","وَكَم يُسرٍ أَفادك بَعد عُسرِ",47,"ر",1,0],["فَكَم في بَني عجل فَتىً قَد صحبته","إِلى أَن بَدا لي أَنَّهُ مِن بَني كَلبِ",48,"ب",1,0],["فَكَم في حَواشيكَ مِن طائِرٍ","تُمِضُّ بِهِ قَلبِيَ الطائِرا",49,"ر",2,0],["فكم في النحو قد أوضحت بحثاً","تنحى عنه أذكى من عصام",50,"م",1,0],["فكمْ فتىً راقِ مِنهُ ظاهِرٌ حَسَنٌ","وكان باطِنُهُ ضِدَّ الَّذي ظَهَرا",51,"ر",2,0],["فكَمْ فيهِ من لَفْظٍ أنيقٍ مُذَهَّبٍ","وكَم فيهِ مِن معنىً عًريقٍ مُهَذَّبِ",52,"ب",1,0],["فكم في الحبِّ من لاح لصبٍّ","يفيد بزعمه ما لا يفيد",53,"د",1,0],["فكم فغَر الدهرُ بالمعضلات","وجودُك منتقذٌ ناشلُ",54,"ل",1,0],["فكم في بيوت العامريّات من هوىً","يُناط كما نيطت بها خالفاتُها",55,"ت",3,0],["فكم فصمت من عقد وفر بنانه","وكم سد من ثغر وكم شد من عقد",56,"د",1,0],["فكم في سواه للمحبين عاذل","لجوجٌ وكم لي في عذاريه من عذر",57,"ر",1,0],["فَكَم فيهِمُ مِن مُستَبيحٍ حِمى العِدى","سَبوقٍ إِلى الغاياتِ غَيرِ عَذَوَّرِ",58,"ر",1,0],["فكم فتكَتْ بنا تلكَ النَّواحِي","بعيْنِ غَزالَةٍ وبجِيدِ رِيمِ",59,"م",1,0],["فكم فيهم ترى قمَراً تجلّى","وشمسَ ضُحىً توارَتْ في حِجابِ",60,"ب",1,0],["فكم في خطِّه من بِنتِ فكرٍ","لها نسجَتْ محابرُه خِمارا",61,"ر",2,0],["فكم في البُكا ينثُرنَ ياقوتَ أدمُعي","ثُغورٌ تُحاكي الدُرَّ وهو نَضيدُ",62,"د",1,0],["فكم في الثّرى مَن كان عِبئاً به الثّرى","وكم في التّرابِ من مليكٍ حُلاحِلِ",63,"ل",1,0],["فكم فرجتْ ألفاظُك الغُرُّ ضيّقاً","وما فرجوه بالقنا والمناصلِ",63,"ل",1,0],["فكمْ فيكَ لباغي نَفَ","لِ الأحبابِ من إِرْبِ",64,"ب",1,0],["فَكَمْ فِيْهِمُ مِنْ دَائِمِ الأَمْنِ لَمْ يُرَعْ","بِحَرْبٍ وَلَمْ يَنْهَدْ لِقِرْنٍ مُصَمِّمِ",65,"م",1,0],