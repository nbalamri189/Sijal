{"poems":[[24,"ما برح الرسم الذي بين حنجر","https://www.aldiwan.net/poem21860.html","الطويل"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[93,"يا نفس لو كنت ترين الشؤون","https://www.aldiwan.net/poem8972.html","عموديه"],[47,"لابس من شبيبة أم ناض","https://www.aldiwan.net/poem64634.html","الخفيف"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[50,"طفلة خود رداح","https://www.aldiwan.net/poem66180.html","مجزوء الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[124,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[193,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[208,"سيدي دعني أداري","https://www.aldiwan.net/poem53305.html","مجزوء الرمل"],[214,"يا بريقاً بالحمى قد لمعا","https://www.aldiwan.net/poem13314.html","الرمل"],[240,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[264,"منية الأرواح وافانا","https://www.aldiwan.net/poem35490.html","المديد"],[310,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[376,"أبا الحسين الفضل في أهله","https://www.aldiwan.net/poem57175.html","السريع"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[435,"لا والمحيا وصباح الجبين","https://www.aldiwan.net/poem40242.html","السريع"],[463,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[463,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[463,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[473,"ما في أبى إسحاق يكفيه","https://www.aldiwan.net/poem59530.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122810","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63852","الخفيف"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105440","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111818","المنسرح"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66286","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53173","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53137","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53121","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53122","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93588","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112627","الرجز"],[3348,"","https://poetry.dctabudhabi.ae/diwan/poem/81325","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74032","السريع"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66529","الخفيف"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132110","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40141","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127131","البسيط"],[4116,"","https://poetry.dctabudhabi.ae/diwan/poem/177939","السريع"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93759","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136675",""],[4955,"ما برجك هيَّا أخبرني","https://www.poetsgate.com/ViewPoem.aspx?id=188783",""],[4987,"ويش استفيد","https://www.poetsgate.com/ViewPoem.aspx?id=49581",""],[5125,"إعادة حساب","https://www.poetsgate.com/ViewPoem.aspx?id=190397",""],[5564,"يالله يا فكّاك حبل المناشيب","https://www.poetsgate.com/ViewPoem.aspx?id=186843",""],[5665,"ما بردُ جسمك إلا غُلَّة العَدم","https://www.poetsgate.com/ViewPoem.aspx?id=190432",""],[5781,"أحلامٌ مُفكَّكةٌ ووِسادةٌ خالية","https://www.poetsgate.com/ViewPoem.aspx?id=202844",""],[5956,"مِن وعيٍ صاحٍ لوعيٍ غافل","https://www.poetsgate.com/ViewPoem.aspx?id=192421",""],[5984,"لهف نفسي على الغزال الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=200379",""],[463,"بطرفِّكَ والمسحورُ يقسمُ بالسَّحرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60085&r=&rc=141",""],[6328,"في رحاب الضاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82139&r=&rc=14",""]],"verses":[["ما بَرَّحَ الرَسمُ الَّذي بَينَ حَنجَرٍ","وَذَلفَةٍ حَتّى قيلَ هَل هُوَ نازِحُ",0,"ح",1,1],["ما برزت للخنا ولا استترت","من عجر شانَها ولا بجرِ",1,"ر",1,0],["ما بَرِحَ الناسُ كَما تَعلَمين","وَلَم أَزَل فَرداً مِنَ الناسِ",2,"س",1,0],["مابَرِحنا نَرجو عُلُوَّ عَلِيٍّ","لِإِجتِبارِ المُطَلَّحِ المُنهاضِ",3,"ض",1,0],["ما برَّ يوماً في الحديثِ ولا ارتضَى","إلا أَلِيّةَ فاجِرٍ مُحتالِ",4,"ل",1,0],["ما بَراها اللَهُ إِلّا","فِتنَةً حينَ بَراها",5,"ا",3,0],["ما برجُ ايفَ حين يسلَمُ مانعٌ","هَمْساً يطِنُّ غداً بأذْنِ بنيك",6,"ك",1,0],["ما برحنا نرجو قدومك حتى","قد مللنا خلف الرجاء وملا",7,"ل",2,0],["ما بَرا مثلكَ الإلهُ زَعيما","يا رَؤوفاً بِالمُؤمنينَ رَحيما",8,"م",2,0],["ما براك اللَه في ذا ال","وصف إلا لاعتباري",9,"ر",2,0],["ما برود الروض وشاها الندى","ولها الحسن بنبت وشعا",10,"ع",2,0],["ما بَرِحَ الوَجدُ وَلَ","كِنَّ الخَفاءَ قَد بَرَح",11,"ح",1,0],["ما برا الرحمن خالقه","مثله في الكون إنسانا",12,"ن",2,0],["ما بريبِ المنونِ خلفٌ ولكن","قَولُنا والفعالُ مختلفانِ",13,"ن",1,0],["ما بَرِحَتْ تَتْرى على حالةٍ","في اليَسْرِ والعُسْر عَطاياه",14,"ا",2,0],["ما بَرِحَت عَنِّي تَباريحُهُ","حتَّى تَسوَّقتُ منَ الرَّحلِ",15,"ل",1,0],["ما برحتُم مُذْ خُلِقتُم سادةً","تكشِفون الغيَّ عنَّا والضَّلالا",16,"ل",2,0],["ما برحت عيناه سكرانةً","فتاكةً في مهج الناظرين",17,"ن",1,0],["ما برِحتْ مظلمةً دنياكُمُ","حتى أضاء كوكبٌ في هاشمِ",18,"م",1,0],["ما برِحت تَنبُل حت","تى لم تجد لي مقتلا",19,"ل",2,0],["ما برِحت يبعثها استعلاؤها","على عِضاهِ المجدِ واشتهارُها",20,"ر",3,0],["ما برِحتْ تبعثُه همّتُه","في طلب الجسائم الكبائرِ",21,"ر",1,0],["ما برِحتْ لا نَظَرتْ","تمنعنا حتى النظَرْ",22,"ر",1,0],["ما براك اللّهُ إلا آيةً","فَتن الناسَ بها غَيَّاً ورُشْدا",23,"د",2,0],["ما بَرَحَ المِروَدَ في عَينِهِ","قَطٌّ وَلا المِسواكُ مِن فيهِ",24,"ي",2,0],["ما بَرِحَت تُلفِتُ مِن اَعناقِها","إلَيهِ أَو تَصُورُ مِن عُيُونِها",25,"ن",3,0],["ما بُرَيْهِمُ من حميري على الصَّحْ","وِ ولكنَّهُ حمارُ السكارى",26,"ر",2,0],["ما برحنا في الأمن من حرف الد","دهر جميعاً حتى دهاه القضاء",27,"ا",2,0],["ما براه اللهُ إلاَّ عيلما","لبني الآمالِ عذبَ المَشرعِ",28,"ع",1,0],["ما برَحت نفسنا عَلَى ولهٍ","تغالبُ الشوقَ فيكَ بالصبرِ",29,"ر",1,0],["ما برَّحت بك غير ذكرى كربلا","فإذا قضيت بها فذاك يقين",30,"ن",1,0],["ما براها في غابر الكون إلاّ","وجميع الأشياء قد أولاها",31,"ا",3,0],["ما برى الله ذرة لم يحطها","علمها غير ذرة ما براها",31,"ا",3,0],["ما برحت تغرب في إبداعها","بديهة من جوده تعطي الجُمَل",32,"ل",1,0],["ما برقه بخُلَّب ولا حيا","نوء ندى كفيه بالمحتبس",33,"س",1,0],["ما برحت تخبط في ليل المنى","حتى هداها منك ضوء القمر",34,"ر",1,0],["ما برحت للطارقين عندهم","توقد بالمندل نيران القِرى",35,"ر",2,0],["ما برَّد الماء يَوم الطف غلته","وَقت الهَجير فَلَيت الماء لا بَردا",36,"د",2,0],["ما بَرَحوا يَستَسمنونَ ذا ورَم","جهلاً وينفُخونَ في غيرِ ضَرَم",37,"م",1,0],["ما برحوا في الأرض بين خلقه","أقطابها الأنجاب أو إبدالها",38,"ل",3,0],["ما برحَت قرطاً بإذن العلى","وَلَم يَزَل تَشطيرها شنفا",39,"ف",2,0],["ما براه إلاَّ انبرى ثائراً في","صفحة الطرس لؤلؤاً وأفاحا",40,"ح",2,0],["ما بُرجُ إيفَلَ ذَرَّةٌ إِن قِستَ مِن","أَهرامِ مِصرٍ وَالعيانُ شَهيدُ",41,"د",1,0],["ما بردُ لطفك إلا دونه بردى","ونيل كفّك إلا دونه النيل",42,"ل",1,0],["ما بَرِقَت بيضُكَ في غَمامِها","إِلّا وَغَيْث الدّينِ لاِبتِسامِها",43,"م",3,1],["ما بردة الروض حاكتها يد المطر","وطرزتها بنواع من الزهر",44,"ر",1,1],["ما برحتْ يوم وداعي لها","تضمُّني ضمَّةَ مستأنسِ",45,"س",1,1],["ما بُروق الغَيث إِلا صُحف","لَكَ فيها مِن سَنا الحَمد كِتاب",46,"ب",1,0],["ما براكَ الآله الاّ ليَبرى","فيكَ سقماً حارت به الأفكار",47,"ر",1,0],["ما برجُكَ هيَّا أخبرني","سرطانٌ دلوٌ أم عقربْ",48,"ب",1,1],["مابرى الجرح الاول كيف يبرى الجديد","شوف حالي نزيف جروحها سلها",49,"ل",3,0],["ما برحتُ بعينيها أبا لهبٍ","في دَرْكِ عشقي سعير الشوق تحتطبُ",50,"ب",1,0],["ما برح إلا غافها والمحاضيب","في جارح الوادي وباقي ترابه",51,"ب",2,0],["ما بردُ جسمك إلا غُلَّة العَدم","ولا اعتلالُكَ إلا علَّة الكرَم",52,"م",1,1],["ما بَرَّ بِالعَهْدِ مَنْ مِنِّي أَطايِبُهُ","ثَغْرٌ يَخُبُّ وَفاءً شاقَهُ الكَرَمُ",53,"م",1,0],["ما بَرّ يوماً بالوعود ولا وَفَى","وكأنه سيفٌ لصونِ الباطلْ",54,"ل",1,0],["ما برى الله مثله بشرا","سبحان خلّاقه العليم القدير",55,"ر",1,0],["ما برحتْ أبياتكمْ في ابتنائهِ","دعائمَ للخطِّيِّ والقضبِ البترِ",56,"ر",1,0],["ما بَرَّ قومٌ أمَّهمْ ولسانَهمْ","إلا وحازُوا السَّبقَ في المَيدان ِ",57,"ن",1,0]]}