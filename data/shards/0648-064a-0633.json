.poetsgate.com/ViewPoem.aspx?id=179129",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[45,"يا بَرْقُ أفرِطْ في اعْتِلائِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=32832",""],[45,"تعست، فما لي من وفاء ولا عهد","https://www.poetsgate.com/ViewPoem.aspx?id=31384",""],[45,"يَزْدادُ في غَيّ الصّبا وَلَعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31128",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["وَيَسُرُّني أَن لا يَراني دائِلٌ","وَمُعَظِّمٌ يَوماً وَأَنتَ تَراني",0,"ي",1,0],["وَيَسلَمُ البَطَلُ الموفي بِسابِحَةٍ","مَشياً عَلى البيضِ وَالأَشلاءِ وَالقُلَلِ",1,"ل",1,0],["وَيَستَهزِمُ الجُردَ الجِيادَ تَخالُها","بِحافِلَةِ الأَبطالِ سِرباً مُذَعذَعا",2,"ع",2,0],["وَيَستَنُّ فيها البَرقُ حَتّى تَخالَهُ","يَفيضُ بِفَيضِ القَطرِ في كُلِّ حاجِرِ",3,"ر",1,0],["وَيَسلَمُ مَن تُسقى الأَسِنَّةُ حَولَهُ","بِأَيدي الكُماةِ المُعلِمينَ عَلى الجُردِ",4,"د",1,0],["وَيُسلِسُ في أَكُفُّكُمُ زِمامي","وَيَعسو عِندَ غَيرِكُمُ قَضيبي",5,"ب",2,0],["وَيَستَقبِحونَ القَتلَ وَالقَتلُ راحَةٌ","وَأَتعَبُ مَيتٍ مَن يَموتُ بِداءِ",6,"ا",2,0],["وَيُسلِمُهُ مَن كانَ يُصفي لَهُ الهَوى","مِنَ الحَيِّ حَتَّى أَنتَ يا سَعدُ عاذِلُهْ",7,"ل",2,0],["وَيَسْكُنُ جارُهُ وَالأُفْقُ كابٍ","بِحَيْثُ يَحُلُّ حَبْوَتَهُ الرَّبيعُ",8,"ع",1,0],["ويَستَجيشُ إذا ما خُطّةٌ عَرَضَتْ","رأياً يَشيعُ بأسْرارِ التّجاريبِ",9,"ب",1,0],["ويَسْحبُ الفارِسُ ذَيْلَ القَسْطالْ","صامَتْ حَوالَيهِ بَناتُ العَقّالْ",10,"ل",1,0],["ويَسْمو إِلى أعْدائِهِ منْ كُماتِهِ","وآرائِهِ في مِقْنَبٍ بَعْدَ مِقْنَبِ",11,"ب",1,0],["ويَسْتَمْطِرُ العافونَ منهُ أنامِلاً","أبى الجُودُ أن يَستَمطِروا بعْدَها سُحْبا",12,"ب",2,0],["ويَسْتَرْجِعُ القَلْبُ أفْاحَهُ","بهِ ويُصافِحُ جَفْني كَراهْ",13,"ا",2,0],["ويَسلُبُها السَّيْرُ الحَثيثُ مِراحَها","إِلى أنْ يَعودَ الخَطْوُ أقْصَرَ منْ شِبْرِ",14,"ر",1,0],["ويُسمَعُ للكُماةِ بها ألِيلٌ","إذا خَضَبَتْ ترائِبُهُمْ إلالا",15,"ل",2,0],["ويسخو سخاء المصيف","على الطير والضّفدع",16,"ع",1,0],["ويَسْكُنُ قلْبٌ منْ بِعادِكِ خافِقٌ","ويَرْفأ جَفْنٌ منْ فِراقِكِ دامِعُ",17,"ع",1,0],["وَيُسْلِمُنِي الصَّبْرُ الْجَمِيلُ إِلَى الْجَوَى","فَتَعْرُونِي الْبُؤَسَى وَيَكْسُونِي السُّقْمُ",18,"م",1,0],["وَيُسْمِعُ يَوْمَ الْخَطْبِ خُطْبَةَ فَيْصَلٍ","وَمِنْ ضَرْبِهِ نَثْرٌ وَمِنْ طَعْنِهِ نَظْمُ",18,"م",1,0],["ويَسْتَعْبِدُ الأحْرارَ جُودُ يَمينِهِ","ويُخْجِلُ وجْهُ الشّمْسِ غُرَّتَهُ الغَرّا",19,"ر",2,0],["ويُسِّرَ للتّوْفيقِ والسّعْدِ مرْكَبي","وذُلِّلَ للوَصْلِ الهَنيِّ قِيادي",20,"ي",1,0],["ويَسْتَودِعُ الرِّيحَ الشَّمَالَ شَمَائِلاً","مِنَ الْحُبِّ لَمْ يَعْلَم بِهنَّ رَقِيبُ",21,"ب",1,0],["ويستفهِمُ الكَفَّ الخَصيبَ ودَمعه","غَراما بِحِنَّاء النَجيع خَضِيبُ",21,"ب",1,0],["وَيُسْرَاكَ اغْتَنِمْ فَالْقَوْسُ تَرْمِى","وَلاَ تَدْرِي أَرشْقَتُهَا قَرِيبَهْ",22,"ب",2,0],["وَيَسَّرْتَنِي قَبْلَ ابْتِدَائِي وَنَشْأَتِي","لِشِقْوَةِ بُعْدِي أَوْ سَعَادةِ إدنَائي",23,"ي",1,0],["ويُسِّرْتُ لليُسْرى ويُسِّرَ مُرْسَلي","وسُدِّدَ سَهْمي واسْتَقامَ قِياسي",24,"ي",1,0],["وَيَسَّرَ سَهماً ذا غِرارٍ يَسوقُهُ","أَمينُ القُوى في صُلبَةِ المُتَرَنِّمِ",25,"م",1,0],["وَيَستَرِدُّ جَلالاً","لَهُ وَرِفعَةَ شانِ",26,"ن",1,0],["وَيَسَّرتَهُ حَتّى اِستَطاعَ رُكوبَهُ","أَخو الفَقرِ لا يَطويهِ جوعٌ وَلا ظَما",27,"م",2,0],["وَيَسلُبُ أَصدافَ البِحارِ بَناتَها","بِنَفثَةِ سِحرٍ أَو بِخَطرَةِ أَفكارِ",28,"ر",1,0],["وَيَسقي إِذا الأَنواءُ في العامِ أَخلَفَت","فَهَل مِثلُ آبائي تُعَدُّ مَناقِبُه",29,"ب",2,0],["وَيَسُرُّ سارِيَةَ السَحابِ قِياسُها","بِسَماحِهِ وَبِسَيبِهِ المَبجوسِ",30,"س",1,0],["وَيَسأَلُ الربعَ عَن سُكّانِهِ سَفَهاً","وَقَد مَحَت آيَه الأَرواحُ تعتَقبُ",31,"ب",1,0],["وَيَسْتَدِرُّ الأَدْمُعَ السَّخِينَهْ","كَانَتْ برنتي أُسْرَةً مِسْكِينَهْ",32,"ن",2,0],["وَيَسْلَمَ العَالَمُ مِنْ فِتْنَةٍ","تَشُبُّهَا أَلْحَاظُكِ السَّاحِرَهْ",33,"ه",1,0],["وَيَسْتَزِيدُ النَّدَى مِنْ فَضْلِ رازِقِهِ","وَيَسْتَعِينُ عَلَى الْعِلاّتِ وَالأُزُمِ",34,"م",1,0],["وَيَسْتَوْفِي بِهِ مَا قَدَّمَتْهُ","نُهَى البُلَغَاءِ مِنْ عَرَبِ وَرُومِ",35,"م",1,0],["وَيَسَّرتَ أَمري وَاِعتَنَيتَ بِحاجَتي","وَأَخَّرتَ لا عَنّي وَقَدَّمتَ لي نَعَم",36,"م",1,0],["ويسرّني أني أشاهد موطني","قد نال من بركاته بعض المنى",37,"ن",2,0],["ويسكن أحياناً فاشجى وإنما","تحرّك شجوي ناشيٌ من سكونه",38,"ن",2,0],["ويستلذّون من قوم سبابهم","كما استلذّ بحكّ الجلد ذو جرب",39,"ب",1,0],["وَيَسأَلُ المَوتى فُضولَ الأَكفان","شاعَ الحَديثُ يا فَتاةَ الفِتيان",40,"ن",1,0],["وَيَسجُدُ لِلصَليبِ مَعَ النَصارى","وَأَفلَجَ سَهمُنا فَلَنا الخِيارُ",41,"ر",1,0],["وَيَسعى التَغلِبيُّ أَذا اِجتَبَينا","بِجِزيَتِهِ وَيَنتَظِرُ الهِلالا",42,"ل",2,0],["وَيَسودُ سَيِّدُنا جَحاجِحَ سادَةً","وَيُصيبُ قائِلُنا سَواءَ المَفصِلِ",43,"ل",1,0],["وَيَسمو إِلَيها حينَ تَطلُعُ غَدوَةً","فَيَلمَحَها في بُرجِها حينَ تَظهَرُ",44,"ر",1,0],["وَيُسرى يَدَيكَ إِذا أَعسَرَت","كَيُمنى يَدَيهِ فَلا تَمتَري",45,"ر",2,0],["ويسفرُ وجه العيشِ عندَ قدومِه","ويفترُّ حتَّى مبسم الزَّهر في الرُّبا",46,"ب",2,0],["ويسمى سعيداً دهرُه ومباركاً","فصحَّ لنا أنَّ الدُّهورَ عبيده",47,"د",2,0],["ويسهرني ومضُ البريق كأنما","تبسم في لُعس السحائب عن ثغر",48,"ر",1,0],["ويسر من رزقي بيمن بنانه","فيمَّن ما شاءت يداه ويسرا",49,"ر",2,0],["ويسكر عقلي خدّه بمدامةٍ","سقاها لغيثي من إنا عسجديه",50,"ي",2,0],["ويسمع المدحَ فيه","ولا يُخَسِّسُ رفْدَهْ",51,"د",2,0],["ويُسألُ للعَظْم الذي كان هاضَه","جُبوراً بِرِفْدٍ والمرجِّيكَ يُرْفدُ",52,"د",1,0],["ويسيرٌ على الفتى الشيبُ ما لم","يقضِه حَتفَهُ المؤجَّل قاضي",53,"ض",2,0],["ويسكت مدّاحهم أنهم","يجودونهم من نجاء همِع",54,"ع",1,0],["ويسقيني شفاءَ النَّفسِ ثغرٌ","ويسقيني شِفاء الوجْدِ جامُ",55,"م",1,0],["ويُسمعني رقاة الهمِّ شدْواً","تغادر كل يومٍ وهو رامُ",55,"م",1,0],["ويسترط المرو الركودَ كأنما","يراه طعاماً قد أعِدَّ له لُقَمْ",56,"م",1,0],["ويسطو بخُرطوم يثنِّيه طوعَهُ","ومشتبهاتٍ ما أصابَ بها غنمْ",56,"م",1,0],["وَيَسيلُ ماءً إِنحَواهُ فَدفَدٌ","وَإِذا طَواهُ اللَيلُ شَعَّ شَهابا",57,"ب",2,0],["وَيَسيرُ في الرَوضِ الأَغَنِّ فَلا تَرى","عَيناهُ غَيرَ الشَوكِ في أَرجائِهِ",58,"ه",1,0],["وَيَسيرُ الطَرفُ مِن أَرباضِها","في مَغانٍ حالِياتٍ نَضِرَه",59,"ر",2,0],["وَيُسائِلُ عَن كَأسِ الخَمرِ","وَيُسائِلُهُ عَنها الناسُ",60,"س",1,0],["وَيَستَكثِرُ العُذّالَ دَمعاً أَرَقتُهُ","وَفي حَقِّكُم ذاكَ الكَثيرُ قَليلُ",61,"ل",1,0],["ويَسْتَمْنِحونَ مزاميرهم","فتمنحُهُمْ كُلَّ لحنٍ عجيبْ",62,"ب",1,0],["ويستهدى السماء حيا","لسائله فتسجُمه",63,"م",2,0],["وَيَستَمسِكُ الدَمُ في راحَتَيكَ","وَفَوقَهُما لا يَقَرُّ الذَهَب",64,"ب",1,0],["وَيُسمِعُ ثَمَّ بِوادي المُلوكِ","مُلوكَ الدِيارِ وَأَقيالَها",65,"ل",3,0],["وَيُسفِكُ الدَمُ في أَرضٍ مُقَدَّسَةٍ","وَتُستَباحُ بِها الأَعراضُ وَالحُرَمُ",66,"م",1,0],["وَيَستَغفِرُ الشَعبُ الفَخورُ لِرَبِّهِ","وَيَجمَعُ مِن ذَيلِ المَخيلَةِ ساحِبُه",67,"ب",2,0],["وَيُسأَلُ في الحَوادِثِ ذو صَوابٍ","فَهَل تَرَكَ الجَمالُ لَهُ صَوابا",68,"ب",2,0],["وَيَسومونَهُ الرِضا بِأُمورٍ","لَيسَ يَرضى أَقَلَّهُنَّ الرَضاءُ",69,"ا",2,0],["ويَسْتَوْلي تَزَفُّرُهُ","على الجُلاَّسِ بالحُرَقِ",70,"ق",1,0],["وَيَستَنصِرانِ الَّذي يَعبُدانِ","وَعِندَهُما أَنَّهُ قَد صُلِب",71,"ب",1,0],["وَيَستَكبِرونَ الدَهرَ وَالدَهرُ دونَهُ","وَيَستَعظِمونَ المَوتَ وَالمَوتُ خادِمُه",72,"م",2,0],["ويستَخدمُ البيضَ الكواعِبَ كالدُمى","ورومَ العِبِدَّى والغطارِفَة الغُرّا",73,"ر",2,0],["ويسحق بعده بالماء دهراً","فتخرج منه منفعة العبادِ",74,"د",1,0],["ويسوؤُني أن لا أُلا","مَ وكنتُ أكرهُ أن أُلامَا",75,"م",2,0],["ويُسفرُ عن غِبِّ السُّرى وكأنَّهُ","بقيَّةُ نصلٍ من عِتاقِ الصوارمِ",76,"م",1,0],["ويستأنفُ الغصنُ الصليبُ نَضَارةً","فيورقُ ما لم يعتوِرْهُ ذُبُولُ",77,"ل",1,0],["وَيَسوؤُني تَركُ اِعتِما","دِكَ وَالتَأَخُّرُ عَن لِقائِك",78,"ك",1,0],["وَيَسلونَ عَن ذِكري وَلا يَحسَبونَني","صَديقاً وَيولوني الجَفاءَ عَلى عَمدِ",79,"د",1,0],["وَيَسُرُّني أَن لَيسَ يَكرُمُ شيمَةً","مِن مَعشِرٍ مَن لَيسَ يَكرَمُ والِدا",80,"د",2,0],["وَيُسارِقنَ وَالرَقيبُ قَريبٌ","لَحَظاتٍ يُعلِنَّ سِرَّ الضَميرِ",81,"ر",1,0],["وَيَسيرٌ طِلابُ إِنصافِ مَن لا","ضَعفُهُ مُعوِزٌ وَلا إِمصاصُه",82,"ص",2,0],["وَيَسيرٌ عِندَ القَتولِ إِذا ما","أَثِمَت فِيَّ أَن تَبوءَ بِإِثمي",83,"ي",1,0],["وَيَسأَلُكُم أَن لا يَكونَ نَصيبُهُ","مِنَ الرَدَّ إِلّا رَدَّ أَجوِبَةِ الكُتبِ",84,"ب",1,0],["وَيُسعِفُنا بِالقُربِ مِنكَ فَتَغتَدي","وَدونَكَ أَستارُ التَحَجُّبِ تُسبَلُ",85,"ل",1,0],["وَيَستَخِفُّ القَناةَ يَحمِلُها","كَأَنَّها في يَمينِهِ قَلَمُ",86,"م",1,0],["وَيُسعِدُني شَرخُ الشَبيبَةِ وَالغِنى","إِذا شانَها إِقتارُها وَقَتيرُها",87,"ر",3,0],["ويسلمَ في الإنعام من قول قائلٍ","تكرّم لما خامرتْهُ ابنةُ الكرْمِ",88,"م",1,0],["وَيَسطو بِمَحجوبِ الظباتِ إذا بدا","جَلا ما جَلا الإِصباحُ من ظلمةِ الظلمِ",89,"م",1,0],["ويستطعمون السّمر والبيضَ إنّها","نيوبٌ وأظفار بها الأُسْد تَطْعَمُ",90,"م",1,0],["ويسرٌ حَسَمْتَ العُسْرَ عنهم بصنعه","كما حَسَمَ الإسلامُ ما صَنَعَ الكفرُ",91,"ر",1,0],["ويسمحُ زنده بِجُذىً تَلَظّى","إذا زندٌ خبا وَوَهَى العفارُ",92,"ر",1,0],["وَيسدّ الثغرَ وسيرتُهُ","تَجري في المُلكِ على سَدَدِ",93,"د",1,0],["ويسلّ ظُبَاهُ بِكُلّ وغىً","ويسيلُ نداهُ بِكُلِّ يَدِ",93,"د",1,0],["ويسومُ ضيماً كلَّ أعصمَ شاهقٍ","ريبُ المنون وكلَّ حيَّةِ وادِ",94,"د",1,0],["ويسقي بكائيَ ربع الصبا","فما زالَ في المحل يسقي البكاءَ",95,"ا",2,0],["وَيُسيءُ بِالإِحسانِ ظَنّاً لا كَمَن","هُوَ بِاِبنِهِ وَبِشِعرِهِ مَفتونُ",96,"ن",1,0],["وَيَسقي ذا مَذانِبَ كُلِّ عِرقٍ","وَيُترِعُ ذا قَرارَةَ كُلِّ وادِ",97,"د",1,0],["وَيَسْلُبُ أَنْفُسَ الأَبْطَالِ سَيْفِي","وَتَسْلُبُ مُهْجَتِي حَدَقُ الْحِسَانِ",98,"ن",1,0],["ويسمحُ بالمالِ الحرامِ لسمعةٍ","ودلَّتْ على فعلِ الزناءِ دلائلُهْ",99,"ل",2,0],["وَيَسَّرَها لَنا المَيمونُ حَتّى","لَقَيناها بِبَطنِ مِنىً تَسيرُ",100,"ر",1,0],["وَيَسحَبُ أَذيالَ الرَبابِ عَلى الرُبى","فَيَلقَطُ مِن دُرِّ النَدى مايُبَدَّدُ",101,"د",1,0],["وَيَستَصحِبُ الذِكرَ الجَميلَ فَيَرتَدي","بِأَحسَنَ مِن وَشيِ الرَبيعِ وَأَعبَقِ",102,"ق",1,0],["ويَسوسُ الأمرَ من دُنيا ودينْ","في نظامٍ من سَلامٍ وإخاءْ",103,"ا",2,0],["وَيَسأَلُهُ اللَهُ أَدنى القُروضِ","فَيَأبى وَيَبخَلُ بِالدِرهَمِ",104,"م",1,0],["وَيَسْلُو كلُّ ذِي شَجَنٍ وَوَجْدٍ","وأنتَ على مُصَابِكَ غير سالِ",105,"ل",1,0],["ويسطعُ في جوانِبها سُطوعا","إلى غطفانَ إنّهُمُ استعدُّوا",106,"د",3,0],["ويستأنس بالصبحِ","لِمَا يرويه عن فيك",107,"ك",1,0],["وَيسرني أَني نَجَوتُ مِن الأَذى","وَيلي كَأَني إِن نَجَوت مخلد",108,"د",1,0],["وَيَسوقونَ باقِراً يَطرُدُ السَهلَ","مَهازيلَ خَشيَةً أَن يَبوراً",109,"ر",2,0],["وَيَستَنُّ ثَوباها عَلى ظَهرِ بَيضَةٍ","تَكَعكَعَ مَمطوراً عَلَيها ظَليمُها",110,"م",3,0],["وَيَسبِقُ وَفدَ الريحِ مِن حَيثُ يَنتَحي","بِمُنخَرِقٍ مِن شَدِّهِ المُتَدارِكِ",111,"ك",1,0],["وَيَسعى لِلسِياسَةِ مُردُ لَأيٍ","فَتُدرِكُها وَما وَصَلَت لِحاها",112,"ا",3,0],["وَيَسخُنُ الشَرابُ وَالمِزاجُ","وَيَكثُرُ الخِلافُ وَالضُجاجُ",113,"ج",1,0],["وَيُسراهُ مُقَرطَقَةٌ بِكوزٍ","وَيُمناهُ مُتَوَّجَةٌ بِكاسِ",114,"س",1,0],["وَيَستُرُ مِن خَجَلٍ وَجهَهُ","وَيَمشي فَيَعثُرُ في الرُزَّه",115,"ز",2,0],["وَيَسيرُ لَحظي وَالصَدي","قَ وَلَيسَ ذا بَعَداتِ",116,"ت",1,0],["وَيَسخو بِما قَد حَوَت كَفُّهُ","وَلا يُتبِعُ المَنَّ ما قَد وَهَب",117,"ب",1,0],["وَيَستَعظِمُ الظلمَ الحقيرَ فلو بَدا","كمِثْلِ القَذا في العَيْنِ أَوْ هُوَ أَحْقَرُ",118,"ر",1,0],["وَيُسَرُّ بالغُفرانِ قلبٌ لَمْ يَزَل","حِيناً بِطُولِ إساءَتي مَشكولا",119,"ل",2,0],["وَيُسِرُّ فيهِ المُجرِمُونَ نَدَامَةً","حيناً وحيناً يُظْهِرُونَ عَوِيلا",119,"ل",2,0],["ويسمو إلى المجدِ قبلَ الفِطامِ","فكيْفَ يكونُ إذا ما فُطِم",120,"م",1,0],["ويَسحَبُ أذيالَ الخِلافَةِ رادِعاً","به المسكُ من نَشرِ الهُدى يَتضَوّع",121,"ع",1,0],["ويُسْلِمُ أرمِينِيّةً وذَواتِها","صَليبٌ لنُصْحِ الأرمنيّينَ منصوب",122,"ب",1,0],["وَيَسمَجُ مَن سِواكَ الشَيءُ عِندي","فَتَفعَلُهُ فَيَحسُنُ مِنكَ ذاكا",123,"ك",2,0],["وَيَسبِقُ إِنجازهُ وَعدَهُ","وَلَيسَ يُحيلُ عَلى باطِلِ",124,"ل",1,1],["وَيَسُرُّني سَبقُ الجَوادِ إِلى النَدى","قَبلَ السُؤالِ فَإِنَّ ذاكَ سُرورُ",125,"ر",1,0],["وَيَسارُ الفَتى يَمينٌ وَإِن كا","نَ أَشَلّاً سامَ الأُمورَ بِيُسرِ",126,"ر",1,0],["وَيَسمَعُ أَقوالَ الرِجالِ تُعيبُهُ","وَأَهوَنُ مِنها في مَواقِعِها النَبلُ",127,"ل",1,0],["وَيَسعى في المَعاشِ الخَلقُ حَتّى","مِنَ الشِبثانِ نَسجٌ وَاِغتِزالُ",128,"ل",1,0],["وَيَستَرِدُّ مِنَ النَفسِ الَّتي شَرُفَت","ما كانَ في سالِفِ الأَيّامِ خَوَّلَها",129,"ل",3,0],["ويَسكْني شهيدُ المَرْءِ غيرِكَ هَيْبَةً","وبُقْيا وإنْ يُسألْ شهيدُكَ لا يكني",130,"ن",2,0],["ويَسْلُكُ رُمْحُه في كلّ باغٍ","كما سَلَكَ المَضِيقَ الأُفْعُوانُ",131,"ن",1,0],["ويسيل من بعد الدموع إذا جرت","بعد الدموع من العيون نَجيع",132,"ع",1,0],["ويسهل منه للسماءِ رُقيها","وتطوي مسافات ويدنو بعيدها",133,"د",3,0],["ويسعد نفسي أن ترى العدل حاضراً","فإن غاب عنها غاب عنها سعودها",134,"د",3,0],["ويستوي جاهلٌ لديها","وعالمٌ فاهمٌ أريبُ",135,"ب",1,0],["ويستثيرُ البردُ في لفحهِ","ناراً تَلظَّى من فمٍ ناضبِ",136,"ب",1,0],["ويُسائلون بِكَ العَشيَّ كدأبهم","هذا النديُّ فأين صدرُ النَّادي",137,"ي",1,0],["ويستفيض خيالي","بالذكريات الخوالي",138,"ي",1,0],["ويسكبن في أذنيكِ الدعاءَ","وفي قلبكِ الغضِّ نورَ الرَّجاءْ",139,"ا",2,0],["ويُسْقَى بكأسٍ إلهيةٍ","مُرَنقةٍ بالهوى والأثامْ",140,"م",1,0],["ويسألني قلبي وقد لاح موكبٌ","من الأحمر اللجيِّ أشرقَ داني",141,"ي",1,0],["ويسائلونَ بِكَ البروقَ لوامعاً","والموجَ في الإزبادِ والإِرغاءِ",142,"ا",2,0],["ويُسْتَبْطَأُ المِرّيخُ وهوَ كأنهُ","إلى الغَوْرِ نارُ القابِسِ المُتَسرِّع",143,"ع",1,0],["ويسوع دمعا والبشير مثانيا","وتنوَّر الوادى ربىً ومثانيا",144,"ي",2,0],["وَيَسْمُو دُخَانُ المَنْدَلِ الرَّطْبِ فَوْقَهُ","كَما احْتَمَلَتْ رِيحٌ مُتُون عُثَانِ",145,"ن",1,0],["ويَسِيرُ في يَبَسِ الثَّرى","وكأَنَّهُ في البحْرِ عائِمْ",146,"م",1,0],["ويُسْمعُ للجنَّانِ في جنَباتِهَا","بسِيطٌ كَتَرْجِيعِ الصَّدَى ونَشِيدُ",147,"د",1,0],["وَيُسْتَقْبَلُ الْبَدْرُ الَّذِي بِكَ يُجْتَلَى","وَتَلْبَسُ فِي اسْتِقْبَالهِ الزَّمَنَ الوَرْدَا",148,"د",2,0],["وَيَسِيرُ سَيرَ الغَرْبِ فِي تَمْجِيدِهِمْ","فَيُكَافِيءَ الأَعْمَالِ بِالأَعْمَالِ",149,"ل",1,0],["وَيَسِيرُ فِي ذَلِكَ الحُزْنِ مَا يَنْقُصُ","مِنٌ بُرْحِهِ اقْتِسَامُ الرِّفَاقِ",150,"ق",1,0],["وَيُسَلْسِلُ الأَعْقَابَ فِي","نَسْل كَمَاءِ المُزْنِ طَاهِرْ",151,"ر",1,0],["ويُسَيِّجُونَكِ فِي المَسِيرِ كرَامَةً","وَتَجِلَّةً لكِ بِالْقنا الْخَطّارِ",152,"ر",1,0],["وَيَسْتَعِيرُ لأَبْقَى الْ","فَخَارِ مِنْهُ رِدَاءَ",153,"ا",2,0],["ويسليني غناء البلبل","أحمل الأثمار يجنيها بنو",154,"و",1,0],["ويسكُبُ السحر يستهوي النفوس به","في ثغرِ زهرتِها أو حلقِ شاديها",155,"ي",3,0],["ويسير في نور الحياة وقلبه","ينساب بين ضلالة والتيه",156,"ي",2,0],["ويسوقُ الأشعارَ في نَبَراتٍ","ظنّها ابنُ الهَديلِ من نَبراته",157,"ت",2,0],["وَيَسعى إلى أنْ يُذْهِلَ النَّجْمَ سَعْيُه","ويَبذُلُ حَتى يُدْهِشَ الْجُودَ وَالْجَدا",158,"د",2,0],["ويُسَوِّي جَماجمَ الناسِ أَبْرا","جا ليبغي إلى السماءِ صُعودا",159,"د",2,0],["ويُسِرُّ الأمرَ إسرارًا؛ فلا","يعرفُ الكهَّانُ سرًّا قد نواهْ",160,"ا",2,0],["ويسير السحاب في ركبها المح","فوف بالنصر آخذًا بالعنان",161,"ن",1,0],["ويُسارعون إلى الحِمامِ، كأنهم","يجدون مُرَّ مذاقِهِ معسولا",162,"ل",2,0],["ويستعبد الأحرار جود يمينه","وتخجل وجه الشمس غرته الغرا",163,"ر",2,0],["ويسكن قلب من بعادك خافق","ويرقأ جفن من فراقك دامع",164,"ع",1,0],["ويستفهمُ الكفَّ الخضيبَ ودمعُهُ","غراما بحنّاء النَّجيع خضيبُ",165,"ب",1,0],["ويسَّرتني قبل ابتدائي ونشأَتي","لِشِقوة بعدي أو سعادة ِ إذ نائيء",166,"ا",1,0],["ويسمي الغبار: أطفال بؤسٍ","زادهم، عاصف المتاه انشحاذا",167,"ذ",2,0],["ويستزيد جوابا هل هنا سكن ؟","أظن بيت فلان أهله انصرفوا",168,"ف",3,0],["ويسمى فترةٌ ضيف الحمى","فترةٌ يدعى: الخبير الاقتصادي",169,"د",2,0],["ويُسَائِلُونَ بك البُروقَ لوامعاً","والموجَ في الإزْبادِ والإِغْراءِ",170,"ا",2,0],["ويستنهض الارواحَ غُفلاً مؤثِّلاً","قوادِمَه من شعره والخوافيا",171,"ي",2,0],["ويُسقطُ من شِفاهِهُمُ سَواداً","ويمحُو من مَعاجِمهم رَعاعا",172,"ع",2,0],["ويسكت عن حق ويعزى بباطل","وتغضي على هضم الأبي جُفونه",173,"ن",2,0],["ويُسْفِرُ نَصُّها المُسوَدّ خِزياً","ومَظلمةً عن الغِيد المِلاح",174,"ح",1,0],["ويستنزلُ الشِعَر عذبَ الرُّواءِ","كصوبِ الغمامةِ إذْ ينحدِر",175,"ر",1,0],["ويسلبونَك بغداداً وجلقةً","ويتركونِك لا لحماً ولا وضما",176,"م",2,0],["وَيَسُوءُني تَرْكُ اعْتِمَا","دِكَ، وَالتّأخّرُ عَنْ لِقائِكْ",177,"ك",1,0],["ويسلون عن ذكري ويحسبونني","صديقاً، ويولوني الجفاء على عمد",178,"د",1,0],["وَيَسيرُ مُتّبِعُ الرّجَالِ إلى","قَمَرٍ، كَثِيرٍ مِنْهُمُ تَبَعُهْ",17