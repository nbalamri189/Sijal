{"poems":[[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[65,"سرت وظلام الليل ستر على الساري","https://www.aldiwan.net/poem46202.html","الطويل"],[3,"ريح الحجاز بحق من أنشاك","https://www.aldiwan.net/poem182.html",""],[37,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[37,"تشوف من صوت الصدى كلما دعا","https://www.aldiwan.net/poem39611.html","الطويل"],[23,"أظن عيينة إذ زارها","https://www.aldiwan.net/poem21327.html","المتقارب"],[53,"يا ابن الوزير الذي تمت وزارته","https://www.aldiwan.net/poem62960.html","البسيط"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[31,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[30,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[30,"أعرفت بين رويتين وحنبل","https://www.aldiwan.net/poem5251.html","الكامل"],[63,"فلقد حدا برق الغليل","https://www.aldiwan.net/poem51762.html","مجزوء الكامل"],[71,"سلام على نفسك الزاكيه","https://www.aldiwan.net/poem29245.html","المتقارب"],[33,"حي ربعا أقوى ورسما محيلا","https://www.aldiwan.net/poem41837.html","الخفيف"],[76,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[21,"وبفرعون إذا تشاق له","https://www.aldiwan.net/poem36209.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[50,"اكسر بمائك سورة الصهباء","https://www.aldiwan.net/poem10405.html","الكامل"],[50,"ما من يد في الناس واحدة","https://www.aldiwan.net/poem66194.html","الكامل"],[48,"أيسجنني رب العلا منصف","https://www.aldiwan.net/poem23125.html","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72182","الطويل"],[37,"تَشَوَّفَ من صوتِ الصَّدَى كُلَّما دَعَا","https://www.poetsgate.com/ViewPoem.aspx?id=21921",""],[69,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[136,"إن للبين صولة وهجوما","https://www.aldiwan.net/poem54650.html","الخفيف"],[137,"لمن الخيول كأنهن سيول","https://www.aldiwan.net/poem4221.html","الكامل"],[173,"ألم يأن أن تنسى عسى ولعلما","https://www.aldiwan.net/poem1665.html",""],[181,"متى تكشفا عني القميص تبينا","https://www.aldiwan.net/poem4499.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[246,"أأهنأ بالدنيا ومولاي واجد","https://www.aldiwan.net/poem45770.html","البسيط"],[254,"فعفوت عنهم عفو غير مثرب","https://www.aldiwan.net/poem2085.html","الكامل"],[266,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[266,"هو المجد ما يقظانه مثل نائم","https://www.aldiwan.net/poem38191.html","الطويل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[369,"لم يدر ناعيك من إلي نعى","https://www.aldiwan.net/poem60847.html","المنسرح"],[396,"رسول الله جئنا زائر ينا","https://www.aldiwan.net/poem54467.html","عموديه"],[396,"ألا يا صاحبي قد ضاق صدري","https://www.aldiwan.net/poem54565.html","عموديه"],[412,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[445,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[447,"أذاب فؤادي ذكر ليلى ومن لها","https://www.aldiwan.net/poem14324.html","الطويل"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[466,"يهب الطلاقة والنوال معا","https://www.aldiwan.net/poem16419.html","أحذ الكامل"],[510,"الحظّ","https://www.aldiwan.net/poem42462.html","الطويل"],[556,"أنتم علي وإن لم","https://www.aldiwan.net/poem47175.html","المجتث"],[556,"ليت أنا لا نعرف القوم فيهم","https://www.aldiwan.net/poem47808.html","الخفيف"],[580,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[580,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[592,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53921","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77523","الرمل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99986","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96669","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72332","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124026","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95491","المتقارب"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111797","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108622","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49593","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69414","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101697","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93530","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137035",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100724","الطويل"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138787",""],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127910","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91992","الرمل"],[3732,"","https://poetry.dctabudhabi.ae/diwan/poem/131936","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133243","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77026","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199054","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123956","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67636","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28620","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133147","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58119","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"],[4927,"سِفرُ الْغَرَاْم","https://www.poetsgate.com/ViewPoem.aspx?id=29829",""],[4984,"رَجْع الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=175527",""],[5136,"نعم أنا لا أرجو إذا ألوت اللوى","https://www.poetsgate.com/ViewPoem.aspx?id=121784",""],[5186,"وتقدمت تبغي بلامي الثغر من","https://www.poetsgate.com/ViewPoem.aspx?id=156518",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5442,"قد براها جذب البرى والأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5628,"الى الملاك نرجس","https://www.poetsgate.com/ViewPoem.aspx?id=178458",""],[5628,"طيش وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=191436",""],[5718,"\"إلهى\"","https://www.poetsgate.com/ViewPoem.aspx?id=213785",""],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""],[5986,"شكرتك أيها المولى قديما","https://www.poetsgate.com/ViewPoem.aspx?id=162960",""],[6139,"نفحة محمدية","https://www.poetsgate.com/ViewPoem.aspx?id=212348",""],[6142,"إلهي من لهذا العبد عونٌ","https://www.poetsgate.com/ViewPoem.aspx?id=155679",""]],"verses":[["فَعُفاتُهُ حَيثُ الغِنى يَسَعُ المُنى","وعُداتُهُ حَيثُ القَنا يتكَسّرُ",0,"ر",1,0],["فعِفَّتيَ اليَقظَى سَجِيَّةُ ماجِدٍ","وضَمَّتُهُ الوَسْنَى خَديعةُ غَدَّارِ",1,"ر",1,0],["فَعَفَوتُ عَن أَموالِهِم وَحَريمِهِم","وَحَمَيتُ رَبعَ القَومِ مِثلِ حِماكِ",2,"ك",1,0],["فَعَفّت عَنِ الأَموالِ نَفسُكَ رَغبَةً","وَأَكرِم بِنَفسٍ عِندَ ذاكَ تَصونُها",3,"ن",3,0],["فَعَفوًا أَميرَ المُؤمِنينَ وَحِسبَةً","فَما تَتَسِب مِن صالِحٍ لَكَ يُكتَبِ",4,"ب",1,0],["فَعِفتَ المَدينَةَ إِذ جِئتَها","وَأَلفَيتَ لِلأُسدِ فيها زَئيرا",5,"ر",2,0],["فعفوكم عن مسيءٍ غير معتمدٍ","كان الإله لكم من سُخطه جارا",6,"ر",2,0],["فعفَّ عن كل ما يشينهما","وكفَّ أحكامه عن الجنف",7,"ف",1,0],["فَعَفَّرَ الضارِياتِ اللاحِقاتِ بِهِ","عَفرَ الغَريبِ قِداحاً بَينَ أَيسارِ",8,"ر",1,0],["فَعَفواً أَميرَ المُؤمِنينَ لِأُمَّةٍ","دَعَت قادِراً مازالَ في العَفوِ يَرغَبُ",9,"ب",1,0],["فَعَفوُكَ يا اِبنَ يوسُفَ خَيرُ عَفوٍ","وَأَنتَ أَشَدُّ مُنتَقِمٍ عِقابا",10,"ب",2,0],["فَعَفَت مَعالِمَها وَغَيَّرَ رَسمَها","ريحٌ تَرَوَّحَ بِالحَصى مِبكارُ",11,"ر",1,0],["فعُفاتُه في مَرتَعٍ","من سَيْبِ راحتِه خَصيبِ",12,"ب",1,0],["فعفواً وصفحاً ولا تنتقدْ","ويا بحرُ مالكَ والساقيَهْ",13,"ي",2,0],["فَعَفا الدَهرُ وَالزَمانُ عَلَيها","وَأَجالَت بِها الرِياحُ ذُيولا",14,"ل",2,0],["فَعِفتُ غُراباً يَصدَعُ الشَملَ أَبيَضاً","وَكانَ عَلى عَهدِ الشَبيبَةِ أَسحَما",15,"م",2,0],["فَعَفاها عَلَيهِم غادياتٌ","وَتَرى مُزنَهُم خَلايا وَخورا",16,"ر",2,0],["فعَفا عَفْوَ قَادرٍ لم يُنَغِّصْ","هُ عليهم بما مضى إغراءُ",17,"ا",2,0],["فَعَفَّ كلُّ ابنِ أُنْثَى عَنْ خِيانتهِ","فَلَمْ يَخُنْ نفسَهُ أُنْثَى وَلا ذكرُ",18,"ر",1,0],["فَعَفَوتُ عَنهُ وَفي الفُؤادِ مِنَ الهَوى","كَتَلَهُّبِ النيرانِ في الحُلَفاءِ",19,"ا",2,0],["فَعَفَوتُ عَنّي عَفوَ مُقتَدِرٍ","حَلَّت لَهُ نِقَمٌ فَأَلغاها",20,"ا",3,0],["فَعُفّوا وَصَلّوا وَاِصمُتوا عَن تَناظُرٍ","فَكُلُّ أَميرٍ بِالحَوادِثِ يُعزَلُ",21,"ل",1,0],["فَعُفاتُهُ لَهْفى يَطُوفُونَ حَوْلَهُ","كما انْقَضَّ عَرْشُ البِئْرِ والورِدُ عاصِبُ",22,"ب",1,0],["فعَفْواً أميرَ المؤمنينَ وحِسْبة","ً فما تكتسبْ من صالح لكَ يُكتَبِ",23,"ب",1,0],["فعفَّرَتِ الشبانُ والشيبُ أوجهاً","بهِ والعَذارَى حُسَّرٌ والقَواعِدُ",24,"د",1,0],["فعفا الحمى ممن أعز","وغادر الأسد العرين",25,"ن",1,0],["فعفت وأمَّحَت معالمُها إل","لا الأواريُّ والنُّؤيُ المثلوما",26,"م",2,0],["فعفوت عفو القادرين تكرماً","عنهم وعفو القادرين جميلُ",27,"ل",1,0],["فَعِفنا سَنِيّاتِ العَطايا حَمِيَّةً","عَلَيكُم وَدُسنا الشَرَّ حَتّى تَشَرَّما",28,"م",2,0],["فَعَفْراءُ أَرْجي النّاسِ عندي مَوَدَّةً","وعفراءُ عَنّي المُعْرِضُ المُتَوَاني",29,"ن",2,0],["فَعفوُكَ إكسيرٌ إذا ذُرّ ذرّة","عَليها اِستحالت نارُها جنّةً خضرا",30,"ر",2,0],["فَعَفا عَنهم فَباؤوا بِسلمٍ","وَاِستَحالت حاءٌ وراءٌ وباءُ",31,"ا",2,0],["فعفواً رعاكَ اللَه للمذنبِ الذي","دعا قادراً ما زالَ في العفوِ يَرغَبُ",32,"ب",1,0],["فَعَفَوتُ عَنهُم عَفوَ غَيرِ مُثَرِّبٍ","وَتَرَكتُهُم لِعِقابِ يَومٍ سَرمَدِ",33,"د",1,1],["فعفت قوي الدنيا وقد","عجفت محاسنها السمان",34,"ن",1,0],["فعفواً إذا قصرت فالعذر واضح","ومن لي بأحصاء الحيا المتراكم",35,"م",1,0],["فعف عنها كما عف الكرام وعف","موارداً سمُّها في شربها قرفا",36,"ف",2,0],["فعَفَّرَتْهُ العِدا وصاحبُه","يَنظرُ ما بينَهم ولا دَفَعا",37,"ع",2,0],["فعفوا سيدي منكم وصفحا","فحلمكم يعم الجاهلينا",38,"ن",2,0],["فعفوا ثم عفوا ثم عفوا","وإحسانا وصفحا عن مقر",39,"ر",1,0],["فَعَفَفتُ ثَمَّ وَلَو هَمَمت بِضَمِّها","منعت مِن استقصائِهِ بنهودِها",40,"د",3,0],["فَعَفّتْ رسومَ الغَدْرِ من ظاهرِ الثرى","وخَطَّتْ وفاءَ العهدِ فِي صَفْحَةِ الشَّمسِ",41,"س",1,0],["فَعَفْوٌ لَهُمْ جَهْدِي وحُلْوٌ لَهُمْ مُرِّي","وصَفْوٌ لَهُمْ طِرْفي ويُسْرٌ لَهُمْ عُسْرِي",42,"ر",2,0],["فعفواً وإحساناً ولطفاً ورحمةً","وستراً لزلات عبيدك زلها",43,"ل",3,0],["فعفوه ليلٌ ندٍ","وبطشُه يومٌ صعِقْ",44,"ق",1,0],["فعفتُ أحبابيَ واس","تضعفت نصرَ شِيَعي",45,"ع",2,0],["فَعُفاتُهُ وادٍ ونائلُهُ","كالسَّيْلِ لا يُثْنى عنِ القَعْرِ",46,"ر",1,0],["فعفواً ورفقاً سيّدي الحظّ لا تبِنْ","فإنّي على جهالةِ الأمسِ نادمُ",47,"م",1,0],["فعفتُمُ وأَبيتم","شُحّاً عليَّ وَجُبْنا",48,"ن",2,0],["فعفاءٌ على وداد أُناسٍ","هو ما بينهمْ غبارٌ مُثارُ",49,"ر",1,0],["فعفى معْهدي وخَفَّ قطيني","وذَوَتْ أَثْلَتي وصَوَّحَ زَرْعي",50,"ع",2,0],["فعفا اللَّهْوُ حِين عَفَّ المُ