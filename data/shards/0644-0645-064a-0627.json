{"poems":[[77,"هون على النفس النفيسة أمرها","https://www.aldiwan.net/poem36598.html","الكامل"],[77,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[54,"إن ابن طوق وبني تغلب","https://www.aldiwan.net/poem27547.html","السريع"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"أخفي الأسى ولسان دمعي يعلن","https://www.aldiwan.net/poem20150.html","الكامل"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[78,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[85,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[45,"شرخ الشباب أخو الصبا وأليفه","https://www.aldiwan.net/poem65161.html","الخفيف"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[66,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[97,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[97,"حان حرماني وناداني النذير","https://www.aldiwan.net/poem24787.html","الرمل"],[80,"أبكاه شيب الرأس لما ابتسم","https://www.aldiwan.net/poem31286.html","السريع"],[80,"أظلوم منك تعلمت ظلمي","https://www.aldiwan.net/poem31314.html","أحذ الكامل"],[80,"بأبي منطقة القوام مشت","https://www.aldiwan.net/poem31471.html","أحذ الكامل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[31,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[102,"عهد الجدود سقاك صوب عهاد","https://www.aldiwan.net/poem33003.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[77,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[113,"قلب تألم من فراق أحبة","https://www.aldiwan.net/poem41703.html","البسيط"],[122,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[130,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[130,"يا عجبا لقادر","https://www.aldiwan.net/poem54833.html","مجزوء الرجز"],[148,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[164,"كم راكب لم يترجل ماشيا","https://www.aldiwan.net/poem46826.html","الرجز"],[187,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[197,"لم يأل صبرا عليك حين هجرته","https://www.aldiwan.net/poem45590.html","الكامل"],[221,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[223,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[227,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[280,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[280,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[280,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[296,"سقيا لمن أضرمت من حبها كبدي","https://www.aldiwan.net/poem36322.html","عموديه"],[303,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[351,"تحت الغلائل بانة تترنح","https://www.aldiwan.net/poem40408.html","الكامل"],[362,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[400,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[426,"يا دارة الانس التي قد زفها","https://www.aldiwan.net/poem41061.html","الكامل"],[429,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[456,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[456,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[456,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[456,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[456,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[462,"ما بالها لم تجرني في بالها","https://www.aldiwan.net/poem3414.html","عموديه"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[527,"أقول بعد حمد من","https://www.aldiwan.net/poem37084.html","مجزوء الهزج"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[549,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[551,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[560,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[573,"يا من بدا من فيه لي","https://www.aldiwan.net/poem2888.html","مجزوء الرجز"],[573,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[573,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"]],"verses":[["لمْ يأتِ صرْفُ الدّهْرِ بِدْعاً مُحْدَثاً","كمْ منْ يَزيدٍ قد مضى ويَزيدِ",0,"د",1,0],["لَمْ يَأْمَنُوا مَكْرَ الإِلاَهِ وَإِنَّمَا","إِمْهَالُهُمْ عَنْ وِرْدِهِ إِمْلاَءُ",1,"ا",2,0],["لَم يَأتِ مِن بابِ لِصَيدِ دَهائِهِ","إِلّا نَجا بِدَهائِهِ مِن بابِ",2,"ب",1,0],["لَم يَأخُذوا مِن دِيَةٍ دِرهَماً","يَوماً وَلا مِن أَرشِهِم بَعرَه",3,"ر",2,0],["لَميآءَ في شَفَتَيها حُوَّةٌ لَعَسٌ","كَالشَمسِ لَمّا بَدَت أَو تُشبِهُ القَمَرا",4,"ر",2,0],["لَمياءُ في شَفَتَيها حُوَّةٌ لَعَسٌ","وَفي اللِثاتِ وَفي أَنيابِها شَنَبُ",5,"ب",1,0],["لَم يَأخُذوا الأمرَ مِن مَجَاهَلَةٍ","ولا انتِحَالاً من حَيثُ يُجتَلبُ",6,"ب",1,0],["لمياء لي دينٌ على ميعادها","مع أنَّ قلبي عندها مسترهن",7,"ن",1,0],["لم يأذنِ الرأيُ في الشكوى فأشكُوَكُمْ","وقد شكاكم لنا ما تفعلون بنا",8,"ن",2,0],["لَم يَأشَروا فيهِ إِذ كانوا مَوالِيَهُ","وَلَو يَكونُ لِقَومٍ غَيرِهِم أَشِروا",9,"ر",3,0],["لَم يأت عبدُك دَنبا يَستَحِقُ به","عُتبى وَها هُوَ ناداكَ يَعتَذِرُ",10,"ر",1,0],["لَم يَألُ صاحِبَ الحِمار مَطلَبا","في السَهلِ وَالوَعر وَسَيراً وَسُرى",11,"ا",1,0],["لَم يَأخُذِ المُتَقَدِّمو","نَ بِهِ وَلا المُتَأَخِّرون",12,"ن",1,0],["لَم يَألُهُ صَبراً وَلَم يَنِ هِمَّةً","حَتّى اِنثَنى بِكُنوزِهِ وَرِغابِهِ",13,"ب",2,0],["لَم يَأتِ سَيفُكَ فَحشاءً وَلا هَتَكَت","قَناكَ مِن حُرمَةِ الرُهبانِ وَالصُلُبِ",14,"ب",1,0],["لَم يَأتِ جودُكَ سابِقاً في سُؤدُدٍ","إِلّا وَجاهُكَ لِلعُفاةِ رَديفُهُ",15,"ف",2,0],["لَمياءُ تَبسِمُ عَن شَتيتٍ واضِحٍ","كَالأَريِ يَروي غُلَّةَ الصَديانِ",16,"ن",1,0],["لَمياءُ جادَت لَنا بِالوَصلِ إِذ عَلِمَت","أَنَّ التَرَحُّلَ قَد زُمَّت بِهِ إِبلي",17,"ل",2,0],["لِمَ يا أليفَ خواطري","غفت العيون ونحن لَم",18,"م",1,0],["لِمَ يا هاجرُ أصبحتَ رحيما","والحنان الجمّ والرقة فيما",19,"م",2,0],["لمياءُ تبدي الدّر من أشْنَبٍ","يحرق بالأنوار جُنْحَ الظُّلَم",20,"م",1,0],["لمياءُ تبسمُ عن مُؤشَّرَةٍ","تجلو الظلامَ ببارِقِ الظَّلمِ",21,"م",1,0],["لَمياءُ تَنطِقُ عَن مُؤشَّرَةٍ","خُتِمَ العَقيقُ بها على الدُّرَرِ",22,"ر",1,0],["لمياءُ تَضَاحَكُ عن دُرَرٍ","وبروقِ حياً وحَصَى بَرَدِ",23,"د",1,0],["لَم يَألُكُم مالِكٌ صَفحاً وَمَغفِرَةً","لَو كانَ يَنفُخُ قَينُ الحَيِّ في فَحَمِ",24,"م",1,0],["لَم يَأتِني لَكُمُ بِخَطٍّ واحِدٍ","يَشفي غَليلَ فُؤادِيَ المُتَقَسِّمِ",25,"م",1,0],["لمَ يا دعاة السوء يطمس فضل من","أضحى غداة الظلم أول فادي",26,"د",2,0],["لَمْ يَأْتِ فيهِ مُفْرِطٌ ومُفَرِّطٌ","بالحَقِّ تَجرِيحاً وَلا تَعدِيلا",27,"ل",2,0],["لِمَ يا حياةُ وقد أحلَّكِ قلبَهُ","لَمْ تؤثريهِ هوى المحبِّ الشاكرِ",28,"ر",1,0],["لَمْ يَأْلُها مَدَداً لحُسْنِ مَصيرِهَا","وَالوَقْتُ للأَقْوَامِ وَقْتُ مَصَايرِ",29,"ر",1,0],["لم يأته استقلالهُ عفوًا، ولا","جادتْ به يدُ محسنٍ مسْماح",30,"ح",1,0],["لم يأمنوا مَكْرَ إلالهِ وإنما","إمهالُهم عن وردِهِ إملاءُ",31,"ا",2,0],["لم يأتِ للجَبَلْينِ العاطفَيْنِ على","واديكِ أبهى وأنقى منهُ مولود",32,"د",1,0],["لم يألف الدنيا وإن علقت به","إذا لا دوام لدورها وديارها",33,"ه",2,0],["لم يا نداماي الذين","حسبتهم سناً وناب",34,"ب",1,0],["لم يأتمر في شقاق الاصل منه بما","في الذكر في سورة الاسراءِ قد نَزَلا",35,"ل",2,0],["لَم يَأبَ عَن تَبجِيلِهِم","غَيرُ غوي غَادِرِ",36,"ر",1,0],["لم يأت في الإِبداع فناً واحداً","إلاَّ أتى من بعده بفنون",37,"ن",1,0],["لم يأتني حديثُها قَبلُ فهل","أتاكَ يا صاحِ حديثُ الغاشيَهْ",38,"ش",3,0],["لَم يأتِ ذاكَ غَريباً في القياس نعم","هَذا اليمانيُّ قَد وافى بأغربهِ",39,"ب",2,0],["لم يألُ صبراً عليكَ حينَ هجرتهُ","لو كانَ ينفعُ صبرهُ لسلاكا",40,"ك",2,1],["لِم يا تُرى حَدَّدتُم","ثَمناً لِرَبِّكُم القَدير",41,"ر",1,0],["لم يَأخُذِ اللَيلُ منها وَالنَهارُ سِوى","ما يَأخُذُ النَملُ من أَركانِ نَهلانِ",42,"ن",1,0],["لم يألف الدينُ غيرهم نفَراً","له ولم يرض غيرهم زُمَرا",43,"ر",2,0],["لَم يَأتِ مِن زَمَنٍ حَميدٍ غابِرٍ","إِلّا وَقَد أَربى عَلَيهِ زَمانُهُ",44,"ن",2,0],["لَمَياءُ في فيها لِراشِفِ ثَغرِها","حَبُّ الغَمامِ مُنَظَّماً وَمُدامُ",45,"م",1,0],["لَم يَألُ مُشتَرِيَ الثَناءِ بِمالِهِ","حُسناً فَنِعمَ المُشتَرى وَالمُشتَري",46,"ر",2,0],["(لمياء) لو أنَّ روحي طوع مقدرتي","إنْ تطلبيها عَلى وَجدٍ بها أَجُد",47,"د",1,0],["لَم يألُ حفظاً للحديثِ درايةً","تَحريرهُ وَروايةً تخريجه",48,"ج",2,0],["لَمياء ياقوت الشِفاه شَرابه","لِفُؤاد مضناها العَليل مفرّحُ",49,"ح",1,0],["لم يأكلِ النّسْرُ قَتْلاهم مُشاكلَةً","لمّا علا شِلْوَهم مَن ريشُهُ اشتَكَرا",50,"ر",2,0],["لم يأت في مستقبل","وكذاك في ماض وحال",51,"ل",1,0],["لمياء ذات مشارق بسمت لنا","ثغرا حلا متدفق الامواه",52,"ه",1,0],["لمياءُ تبدو في رقّةِ الحضَرِ ال","لِّطافِ حيناً وفطنةِ العرَبِ",53,"ب",1,0],["لم يَأْنِ أَنْ يَعْلَقَ البِيضَ الحِسانَ وَقَدْ","أَضْحى فؤادُ العُلا صَبّاً بِهِ عَلِقا",54,"ق",2,0],["لمياءُ ما للخمر خالطَها","مسكٌ بغير رُضابها معنى",55,"ن",2,0],["لمياء تعطيك فماً أشدقَ لا","يغبُّه الدهرَ لسانٌ لاثمُ",56,"م",1,0],["لمياء يُلفَى الظبيُ من أوصافه","صِفراً إذا ردّ الذي منها سرَقْ",57,"ق",1,0],["لم يأخذ السودَدَ حظّاً غلطاً","ولا العلا مغتصباً أو مقتسرْ",58,"ر",1,0],["لم يألُ ناظمُ عِقدِها","نَصحاً ولا خَمَّارُها",59,"ر",3,0],["لمياءُ لا أقبحُ من عائبها","عندي ولا أحسن من إدلالها",60,"ل",3,0],["لُم يا عَذَولي وَشاهِد حُسنَهُم فَإِذا","شاهَدتهُ وَاِستَطَعت اللوم بَعد لُمِ",61,"م",1,0],["لَمْ يَأْتِ في الرَّمْزِ لَنا","عَلَى مُرُورِ الزَّمَنِ",62,"ن",1,0],["لم يأخذوا لنفوسهمْ","إلّا مُناها أوْ رداها",63,"ا",3,0],["لم يأتِ إلّا في دُجىً","وصبحُه ما أمِنَهْ",64,"ن",2,0],["لَم يَأْلَفِ الملكُ إلّا في بيوتِكمُ","حَلَلْتُمُ دارَه والنّاسُ جِيرانُ",65,"ن",1,0],["لَم يَأتِ أَمراً وَلَم يَظهُر عَلى حَدَثٍ","إِلّا أُعينَ بِتَوفيقٍ وَتَسديدِ",66,"د",1,0],["لمْياءُ مَحجوبةٌ عن مُرسِلٍ بَصَرَاً","دامت على حَجْبها حتَّى على النَّسَمِ",67,"م",1,0],["لم يأتها قَبْلُ إلاّ شاكرٌ عَجَباً","وجئتُ بعدُ فأهدتني قوافيها",68,"ي",3,0],["لم يأْت من قُطْرُبُّلٍ","وهي شراب العسل",69,"ل",1,0],["لَمْياءُ مبسمها كصب","ح قَدْ أُحيط بِيَوْمِ دَجْنِ",70,"ن",1,0],["لميَاءُ فاضَ بطَرْفها كَحَلٌ","ورأى مراشفها فقبلها",71,"ل",3,0]]}