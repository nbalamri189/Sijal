 الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=194461",""],[5956,"قلبي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[5964,"ما شأن دارك يا ليلى نناجيها","https://www.poetsgate.com/ViewPoem.aspx?id=181304",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[6093,"الدِّبْسُ مَهْمَا حَلَا لَنْ يَبْلُغَ العَسَلا","https://www.poetsgate.com/ViewPoem.aspx?id=191372",""],[6093,"محمد سيد السادات","https://www.poetsgate.com/ViewPoem.aspx?id=193786",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[463,"أيقظني للبرقِ وهو نائمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60187&r=&rc=243",""],[6318,"لغتي الجميلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66157&r=&rc=7",""],[5126,"قولا لذات اللّمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87803&r=&rc=18",""]],"verses":[["لمْ يأتِ صرْفُ الدّهْرِ بِدْعاً مُحْدَثاً","كمْ منْ يَزيدٍ قد مضى ويَزيدِ",0,"د",1,0],["لَمْ يَأْمَنُوا مَكْرَ الإِلاَهِ وَإِنَّمَا","إِمْهَالُهُمْ عَنْ وِرْدِهِ إِمْلاَءُ",1,"ا",2,0],["لَم يَأتِ مِن بابِ لِصَيدِ دَهائِهِ","إِلّا نَجا بِدَهائِهِ مِن بابِ",2,"ب",1,0],["لَم يَأخُذوا مِن دِيَةٍ دِرهَماً","يَوماً وَلا مِن أَرشِهِم بَعرَه",3,"ر",2,0],["لَميآءَ في شَفَتَيها حُوَّةٌ لَعَسٌ","كَالشَمسِ لَمّا بَدَت أَو تُشبِهُ القَمَرا",4,"ر",2,0],["لَمياءُ في شَفَتَيها حُوَّةٌ لَعَسٌ","وَفي اللِثاتِ وَفي أَنيابِها شَنَبُ",5,"ب",1,0],["لَم يَأخُذوا الأمرَ مِن مَجَاهَلَةٍ","ولا انتِحَالاً من حَيثُ يُجتَلبُ",6,"ب",1,0],["لمياء لي دينٌ على ميعادها","مع أنَّ قلبي عندها مسترهن",7,"ن",1,0],["لم يأذنِ الرأيُ في الشكوى فأشكُوَكُمْ","وقد شكاكم لنا ما تفعلون بنا",8,"ن",2,0],["لَم يَأشَروا فيهِ إِذ كانوا مَوالِيَهُ","وَلَو يَكونُ لِقَومٍ غَيرِهِم أَشِروا",9,"ر",3,0],["لَم يأت عبدُك دَنبا يَستَحِقُ به","عُتبى وَها هُوَ ناداكَ يَعتَذِرُ",10,"ر",1,0],["لَم يَألُ صاحِبَ الحِمار مَطلَبا","في السَهلِ وَالوَعر وَسَيراً وَسُرى",11,"ا",1,0],["لَم يَأخُذِ المُتَقَدِّمو","نَ بِهِ وَلا المُتَأَخِّرون",12,"ن",1,0],["لَم يَألُهُ صَبراً وَلَم يَنِ هِمَّةً","حَتّى اِنثَنى بِكُنوزِهِ وَرِغابِهِ",13,"ب",2,0],["لَم يَأتِ سَيفُكَ فَحشاءً وَلا هَتَكَت","قَناكَ مِن حُرمَةِ الرُهبانِ وَالصُلُبِ",14,"ب",1,0],["لَم يَأتِ جودُكَ سابِقاً في سُؤدُدٍ","إِلّا وَجاهُكَ لِلعُفاةِ رَديفُهُ",15,"ف",2,0],["لَمياءُ تَبسِمُ عَن شَتيتٍ واضِحٍ","كَالأَريِ يَروي غُلَّةَ الصَديانِ",16,"ن",1,0],["لَمياءُ جادَت لَنا بِالوَصلِ إِذ عَلِمَت","أَنَّ التَرَحُّلَ قَد زُمَّت بِهِ إِبلي",17,"ل",2,0],["لِمَ يا أليفَ خواطري","غفت العيون ونحن لَم",18,"م",1,0],["لِمَ يا هاجرُ أصبحتَ رحيما","والحنان الجمّ والرقة فيما",19,"م",2,0],["لمياءُ تبدي الدّر من أشْنَبٍ","يحرق بالأنوار جُنْحَ الظُّلَم",20,"م",1,0],["لمياءُ تبسمُ عن مُؤشَّرَةٍ","تجلو الظلامَ ببارِقِ الظَّلمِ",21,"م",1,0],["لَمياءُ تَنطِقُ عَن مُؤشَّرَةٍ","خُتِمَ العَقيقُ بها على الدُّرَرِ",22,"ر",1,0],["لمياءُ تَضَاحَكُ عن دُرَرٍ","وبروقِ حياً وحَصَى بَرَدِ",23,"د",1,0],["لَم يَألُكُم مالِكٌ صَفحاً وَمَغفِرَةً","لَو كانَ يَنفُخُ قَينُ الحَيِّ في فَحَمِ",24,"م",1,0],["لَم يَأتِني لَكُمُ بِخَطٍّ واحِدٍ","يَشفي غَليلَ فُؤادِيَ المُتَقَسِّمِ",25,"م",1,0],["لمَ يا دعاة السوء يطمس فضل من","أضحى غداة الظلم أول فادي",26,"د",2,0],["لَمْ يَأْتِ فيهِ مُفْرِطٌ ومُفَرِّطٌ","بالحَقِّ تَجرِيحاً وَلا تَعدِيلا",27,"ل",2,0],["لِمَ يا حياةُ وقد أحلَّكِ قلبَهُ","لَمْ تؤثريهِ هوى المحبِّ الشاكرِ",28,"ر",1,0],["لَمْ يَأْلُها مَدَداً لحُسْنِ مَصيرِهَا","وَالوَقْتُ للأَقْوَامِ وَقْتُ مَصَايرِ",29,"ر",1,0],["لم يأته استقلالهُ عفوًا، ولا","جادتْ به يدُ محسنٍ مسْماح",30,"ح",1,0],["لم يأمنوا مَكْرَ إلالهِ وإنما","إمهالُهم عن وردِهِ إملاءُ",31,"ا",2,0],["لم يأتِ للجَبَلْينِ العاطفَيْنِ على","واديكِ أبهى وأنقى منهُ مولود",32,"د",1,0],["لَم يأت عبدُك ذنبًا يَستَحِقُ به","عُتبًا، وَها هُوَ قد ناداكَ يَعتَذِرُ",33,"ر",1,0],["لم يألف الدنيا وإن علقت به","إذا لا دوام لدورها وديارها",34,"ه",2,0],["لم يا نداماي الذين","حسبتهم سناً وناب",35,"ب",1,0],["لم يأتمر في شقاق الاصل منه بما","في الذكر في سورة الاسراءِ قد نَزَلا",36,"ل",2,0],["لَم يَأبَ عَن تَبجِيلِهِم","غَيرُ غوي غَادِرِ",37,"ر",1,0],["لم يأت في الإِبداع فناً واحداً","إلاَّ أتى من بعده بفنون",38,"ن",1,0],["لم يأتني حديثُها قَبلُ فهل","أتاكَ يا صاحِ حديثُ الغاشيَهْ",39,"ش",3,0],["لَم يأتِ ذاكَ غَريباً في القياس نعم","هَذا اليمانيُّ قَد وافى بأغربهِ",40,"ب",2,0],["لم يألُ صبراً عليكَ حينَ هجرتهُ","لو كانَ ينفعُ صبرهُ لسلاكا",41,"ك",2,1],["لِم يا تُرى حَدَّدتُم","ثَمناً لِرَبِّكُم القَدير",42,"ر",1,0],["لم يَأخُذِ اللَيلُ منها وَالنَهارُ سِوى","ما يَأخُذُ النَملُ من أَركانِ نَهلانِ",43,"ن",1,0],["لم يألف الدينُ غيرهم نفَراً","له ولم يرض غيرهم زُمَرا",44,"ر",2,0],["لَم يَأتِ مِن زَمَنٍ حَميدٍ غابِرٍ","إِلّا وَقَد أَربى عَلَيهِ زَمانُهُ",45,"ن",2,0],["لَمَياءُ في فيها لِراشِفِ ثَغرِها","حَبُّ الغَمامِ مُنَظَّماً وَمُدامُ",46,"م",1,0],["لَم يَألُ مُشتَرِيَ الثَناءِ بِمالِهِ","حُسناً فَنِعمَ المُشتَرى وَالمُشتَري",47,"ر",2,0],["(لمياء) لو أنَّ روحي طوع مقدرتي","إنْ تطلبيها عَلى وَجدٍ بها أَجُد",48,"د",1,0],["لَم يألُ حفظاً للحديثِ درايةً","تَحريرهُ وَروايةً تخريجه",49,"ج",2,0],["لَمياء ياقوت الشِفاه شَرابه","لِفُؤاد مضناها العَليل مفرّحُ",50,"ح",1,0],["لم يأكلِ النّسْرُ قَتْلاهم مُشاكلَةً","لمّا علا شِلْوَهم مَن ريشُهُ اشتَكَرا",51,"ر",2,0],["لم يأت في مستقبل","وكذاك في ماض وحال",52,"ل",1,0],["لمياء ذات مشارق بسمت لنا","ثغرا حلا متدفق الامواه",53,"ه",1,0],["لمياءُ تبدو في رقّةِ الحضَرِ ال","لِّطافِ حيناً وفطنةِ العرَبِ",54,"ب",1,0],["لم يَأْنِ أَنْ يَعْلَقَ البِيضَ الحِسانَ وَقَدْ","أَضْحى فؤادُ العُلا صَبّاً بِهِ عَلِقا",55,"ق",2,0],["لمياءُ ما للخمر خالطَها","مسكٌ بغير رُضابها معنى",56,"ن",2,0],["لمياء تعطيك فماً أشدقَ لا","يغبُّه الدهرَ لسانٌ لاثمُ",57,"م",1,0],["لمياء يُلفَى الظبيُ من أوصافه","صِفراً إذا ردّ الذي منها سرَقْ",58,"ق",1,0],["لم يأخذ السودَدَ حظّاً غلطاً","ولا العلا مغتصباً أو مقتسرْ",59,"ر",1,0],["لم يألُ ناظمُ عِقدِها","نَصحاً ولا خَمَّارُها",60,"ر",3,0],["لمياءُ لا أقبحُ من عائبها","عندي ولا أحسن من إدلالها",61,"ل",3,0],["لُم يا عَذَولي وَشاهِد حُسنَهُم فَإِذا","شاهَدتهُ وَاِستَطَعت اللوم بَعد لُمِ",62,"م",1,0],["لَمْ يَأْتِ في ال