رك"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[31,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[102,"عهد الجدود سقاك صوب عهاد","https://www.aldiwan.net/poem33003.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[77,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[78,"سَكِّن فُؤادكَ لا تَذهَب بِكَ الفِكَرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86482&r=&rc=27",""],[116,"قلب تألم من فراق أحبة","https://www.aldiwan.net/poem41703.html","البسيط"],[125,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[133,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[133,"يا عجبا لقادر","https://www.aldiwan.net/poem54833.html","مجزوء الرجز"],[151,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[167,"كم راكب لم يترجل ماشيا","https://www.aldiwan.net/poem46826.html","الرجز"],[190,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[200,"لم يأل صبرا عليك حين هجرته","https://www.aldiwan.net/poem45590.html","الكامل"],[224,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[226,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[230,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[283,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[283,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[283,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[299,"سقيا لمن أضرمت من حبها كبدي","https://www.aldiwan.net/poem36322.html","عموديه"],[306,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[354,"تحت الغلائل بانة تترنح","https://www.aldiwan.net/poem40408.html","الكامل"],[365,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[404,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[430,"يا دارة الانس التي قد زفها","https://www.aldiwan.net/poem41061.html","الكامل"],[433,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[440,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[459,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[459,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[459,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[459,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[459,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[465,"ما بالها لم تجرني في بالها","https://www.aldiwan.net/poem3414.html","عموديه"],[525,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[530,"أقول بعد حمد من","https://www.aldiwan.net/poem37084.html","مجزوء الهزج"],[552,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[552,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[552,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[563,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[576,"يا من بدا من فيه لي","https://www.aldiwan.net/poem2888.html","مجزوء الرجز"],[576,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[576,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"]],"verses":[["لمْ يأتِ صرْفُ الدّهْرِ بِدْعاً مُحْدَثاً","كمْ منْ يَزيدٍ قد مضى ويَزيدِ",0,"د",1,0],["لَمْ يَأْمَنُوا مَكْرَ الإِلاَهِ وَإِنَّمَا","إِمْهَالُهُمْ عَنْ وِرْدِهِ إِمْلاَءُ",1,"ا",2,0],["لَم يَأتِ مِن بابِ لِصَيدِ دَهائِهِ","إِلّا نَجا بِدَهائِهِ مِن بابِ",2,"ب",1,0],["لَم يَأخُذوا مِن دِيَةٍ دِرهَماً","يَوماً وَلا مِن أَرشِهِم بَعرَه",3,"ر",2,0],["لَميآءَ في شَفَتَيها حُوَّةٌ لَعَسٌ","كَالشَمسِ لَمّا بَدَت أَو تُشبِهُ القَمَرا",4,"ر",2,0],["لَمياءُ في شَفَتَيها حُوَّةٌ لَعَسٌ","وَفي اللِثاتِ وَفي أَنيابِها شَنَبُ",5,"ب",1,0],["لَم يَأخُذوا الأمرَ مِن مَجَاهَلَةٍ","ولا انتِحَالاً من حَيثُ يُجتَلبُ",6,"ب",1,0],["لمياء لي دينٌ على ميعادها","مع أنَّ قلبي عندها مسترهن",7,"ن",1,0],["لم يأذنِ الرأيُ في الشكوى فأشكُوَكُمْ","وقد شكاكم لنا ما تفعلون بنا",8,"ن",2,0],["لَم يَأشَروا فيهِ إِذ كانوا مَوالِيَهُ","وَلَو يَكونُ لِقَومٍ غَيرِهِم أَشِروا",9,"ر",3,0],["لَم يأت عبدُك دَنبا يَستَحِقُ به","عُتبى وَها هُوَ ناداكَ يَعتَذِرُ",10,"ر",1,0],["لَم يَألُ صاحِبَ الحِمار مَطلَبا","في السَهلِ وَالوَعر وَسَيراً وَسُرى",11,"ا",1,0],["لَم يَأخُذِ المُتَقَدِّمو","نَ بِهِ وَلا المُتَأَخِّرون",12,"ن",1,0],["لَم يَألُهُ صَبراً وَلَم يَنِ هِمَّةً","حَتّى اِنثَنى بِكُنوزِهِ وَرِغابِهِ",13,"ب",2,0],["لَم يَأتِ سَيفُكَ فَحشاءً وَلا هَتَكَت","قَناكَ مِن حُرمَةِ الرُهبانِ وَالصُلُبِ",14,"ب",1,0],["لَم يَأتِ جودُكَ سابِقاً في سُؤدُدٍ","إِلّا وَجاهُكَ لِلعُفاةِ رَديفُهُ",15,"ف",2,0],["لَمياءُ تَبسِمُ عَن شَتيتٍ واضِحٍ","كَالأَريِ يَروي غُلَّةَ الصَديانِ",16,"ن",1,0],["لَمياءُ جادَت لَنا بِالوَصلِ إِذ عَلِمَت","أَنَّ التَرَحُّلَ قَد زُمَّت بِهِ إِبلي",17,"ل",2,0],["لِمَ يا أليفَ خواطري","غفت العيون ونحن لَم",18,"م",1,0],["لِمَ يا هاجرُ أصبحتَ رحيما","والحنان الجمّ والرقة فيما",19,"م",2,0],["لمياءُ تبدي الدّر من أشْنَبٍ","يحرق بالأنوار جُنْحَ الظُّلَم",20,"م",1,0],["لمياءُ تبسمُ عن مُؤشَّرَةٍ","تجلو الظلامَ ببارِقِ الظَّلمِ",21,"م",1,0],["لَمياءُ تَنطِقُ عَن مُؤشَّرَةٍ","خُتِمَ العَقيقُ بها على الدُّرَرِ",22,"ر",1,0],["لمياءُ تَضَاحَكُ عن دُرَرٍ","وبروقِ حياً وحَصَى بَرَدِ",23,"د",1,0],["لَم يَألُكُم مالِكٌ صَفحاً وَمَغفِرَةً","لَو كانَ يَنفُخُ قَينُ الحَيِّ في فَحَمِ",24,"م",1,0],["لَم يَأتِني لَكُمُ بِخَطٍّ واحِدٍ","يَشفي غَليلَ فُؤادِيَ المُتَقَسِّمِ",25,"م",1,0],["لمَ يا دعاة السوء يطمس فضل من","أضحى غداة الظلم أول فادي",26,"د",2,0],["لَمْ يَأْتِ فيهِ مُفْرِطٌ ومُفَرِّطٌ","بالحَقِّ تَجرِيحاً وَلا تَعدِيلا",27,"ل",2,0],["لِمَ يا حياةُ وقد أحلَّكِ قلبَهُ","لَمْ تؤثريهِ هوى المحبِّ الشاكرِ",28,"ر",1,0],["لَمْ يَأْلُها مَدَداً لحُسْنِ مَصيرِهَا","وَالوَقْتُ للأَقْوَامِ وَقْتُ مَصَايرِ",29,"ر",1,0],["لم يأته استقلالهُ عفوًا، ولا","جادتْ به يدُ محسنٍ مسْماح",30,"ح",1,0],["لم يأمنوا مَكْرَ إلالهِ وإنما","إمهالُهم عن وردِهِ إملاءُ",31,"ا",2,0],["لم يأتِ للجَبَلْينِ العاطفَيْنِ على","واديكِ أبهى وأنقى منهُ مولود",32,"د",1,0],["لَم يأت عبدُك ذنبًا يَستَحِقُ به","عُتبًا، وَها هُوَ قد ناداكَ يَعتَذِرُ",33,"ر",1,0],["لم يألف الدنيا وإن علقت به","إذا لا دوام لدورها وديارها",34,"ه",2,0],["لم يا نداماي الذين","حسبتهم سناً وناب",35,"ب",1,0],["لم يأتمر في شقاق الاصل منه بما","في الذكر في سورة الاسراءِ قد نَزَلا",36,"ل",2,0],["لَم يَأبَ عَن تَبجِيلِهِم","غَيرُ غوي غَادِرِ",37,"ر",1,0],["لم يأت في الإِبداع فناً واحداً","إلاَّ أتى من بعده بفنون",38,"ن",1,0],["لم يأتني حديثُها قَبلُ فهل","أتاكَ يا صاحِ حديثُ الغاشيَهْ",39,"ش",3,0],["لَم يأتِ ذاكَ غَريباً في القياس نعم","هَذا اليمانيُّ قَد وافى بأغربهِ",40,"ب",2,0],["لم يألُ صبراً عليكَ حينَ هجرتهُ","لو كانَ ينفعُ صبرهُ لسلاكا",41,"ك",2,1],["لِم يا تُرى حَدَّدتُم","ثَمناً لِرَبِّكُم القَدير",42,"ر",1,0],["لم يَأخُذِ اللَيلُ منها وَالنَهارُ سِوى","ما يَأخُذُ النَملُ من أَركانِ نَهلانِ",43,"ن",1,0],["لم يألف الدينُ غيرهم نفَراً","له ولم يرض غيرهم زُمَرا",44,"ر",2,0],["لَم يَأتِ مِن زَمَنٍ حَميدٍ غابِرٍ","إِلّا وَقَد أَربى عَلَيهِ زَمانُهُ",45,"ن",2,0],["لَمَياءُ في فيها لِراشِفِ ثَغرِها","حَبُّ الغَمامِ مُنَظَّماً وَمُدامُ",46,"م",1,0],["لَم يَألُ مُشتَرِيَ الثَناءِ بِمالِهِ","حُسناً فَنِعمَ المُشتَرى وَالمُشتَري",47,"ر",2,0],["(لمياء) لو أنَّ روحي طوع مقدرتي","إنْ تطلبيها عَلى وَجدٍ بها أَجُد",48,"د",1,0],["لَم يألُ حفظاً للحديثِ درايةً","تَحريرهُ وَروايةً تخريجه",49,"ج",2,0],["لَمياء ياقوت الشِفاه شَرابه","لِفُؤاد مضناها العَليل مفرّحُ",50,"ح",1,0],["لم يأكلِ النّسْرُ قَتْلاهم مُشاكلَةً","لمّا علا شِلْوَهم مَن ريشُهُ اشتَكَرا",51,"ر",2,0],["لم يأت في مستقبل","وكذاك في ماض وحال",52,"ل",1,0],["لمياء ذات مشارق بسمت لنا","ثغرا حلا متدفق الامواه",53,"ه",1,0],["لمياءُ تبدو في رقّةِ الحضَرِ ال","لِّطافِ حيناً وفطنةِ العرَبِ",54,"ب",1,0],["لم يَأْنِ أَنْ يَعْلَقَ البِيضَ الحِسانَ وَقَدْ","أَضْحى فؤادُ العُلا صَبّاً بِهِ عَلِقا",55,"ق",2,0],["لمياءُ ما للخمر خالطَها","مسكٌ بغير رُضابها معنى",56,"ن",2,0],["لمياء تعطيك فماً أشدقَ لا","يغبُّه الدهرَ لسانٌ لاثمُ",57,"م",1,0],["لمياء يُلفَى الظبيُ من أوصافه","صِفراً إذا ردّ الذي منها سرَقْ",58,"ق",1,0],["لم يأخذ السودَدَ حظّاً غلطاً","ولا العلا مغتصباً أو مقتسرْ",59,"ر",1,0],["لم يألُ ناظمُ عِقدِها","نَصحاً ولا خَمَّارُها",60,"ر",3,0],["لمياءُ لا أقبحُ من عائبها","عندي ولا أحسن من إدلالها",61,"ل",3,0],["لُم يا عَذَولي وَشاهِد حُسنَهُم فَإِذا","شاهَدتهُ وَاِستَطَعت اللوم بَعد لُمِ",62,"م",1,0],["لَمْ يَأْتِ في الرَّمْزِ لَنا","عَلَى مُرُورِ الزَّمَنِ",63,"ن",1,0],["لم يأخذوا لنفوسهمْ","إلّا مُناها أوْ رداها",64,"ا",3,0],["لم يأتِ إلّا في دُجىً","وصبحُه ما أمِنَهْ",65,"ن",2,0],["لَم يَأْلَفِ الملكُ إلّا في بيوتِكمُ","حَلَلْتُمُ دارَه والنّاسُ جِيرانُ",66,"ن",1,0],["لَم يَأتِ أَمراً وَلَم يَظهُر عَلى حَدَثٍ","إِلّا أُعينَ بِتَوفيقٍ وَتَسديدِ",67,"د",1,0],["لمْياءُ مَحجوبةٌ عن مُرسِلٍ بَصَرَاً","دامت على حَجْبها حتَّى على النَّسَمِ",68,"م",1,0],["لم يأتها قَبْلُ إلاّ شاكرٌ عَجَباً","وجئتُ بعدُ فأهدتني قوافيها",69,"ي",3,0],["لم يأْت من قُطْرُبُّلٍ","وهي شراب العسل",70,"ل",1,0],["لَمْياءُ مبسمها كصب","ح قَدْ أُحيط بِيَوْمِ دَجْنِ",71,"ن",1,0],["لميَاءُ فاضَ بطَرْفها كَحَلٌ","ورأى مراشفها فقبلها",72,"ل",3,0]]}