18",""],[5759,"سجى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213405",""],[402,"لبيكم يا رفقة النادي","https://www.poetsgate.com/ViewPoem.aspx?id=35474",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5815,"كَفَاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=190008",""],[5829,"صدع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=177716",""],[5839,"السهاد","https://www.poetsgate.com/ViewPoem.aspx?id=62050",""],[5851,"قبس في منتصف الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=175274",""],[5861,"رثاء حب","https://www.poetsgate.com/ViewPoem.aspx?id=188027",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5906,"هدية عيد","https://www.poetsgate.com/ViewPoem.aspx?id=188518",""],[5994,"بوغاز","https://www.poetsgate.com/ViewPoem.aspx?id=184585",""],[6070,"سُبحانَ ربِّ الكَونِ والتكوينِ","https://www.poetsgate.com/ViewPoem.aspx?id=187747",""],[6125,"من ذا لأمةِ أحمدٍ فوق الثرى","https://www.poetsgate.com/ViewPoem.aspx?id=210969",""],[6152,"حبكِ الأغلى","https://www.poetsgate.com/ViewPoem.aspx?id=205390",""],[6184,"أأضحكُ عِنْدَما يَبْكي الجليلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78613&r=&rc=5",""],[6300,"أنا يا أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81626&r=&rc=3",""],[6323,"لغة الشعور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82174&r=&rc=5",""],[5190,"أين الوفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85064&r=&rc=139",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""]],"verses":[["فَوَجدناكَ بِحَمدِ اللَ","هِ بِالودِّ شَحيحا",0,"ح",2,0],["فَوُجُوهُهُمْ بَسَنَا الأَهِلَّةِ تَزْدَرِي","وَأَكُفَّهُمْ جَوْنَ السَّحَائِبِ تُخْجِلُ",1,"ل",1,0],["فَوَجَدناكَ مِن جَميعِ نَواحي","كَ عَظيماً مُوَفَّقاً غَلّابا",2,"ب",2,0],["فَوُجوهُ اللَفظِ شَتّى","وَالمَعاذيرُ فُنونُ",3,"ن",1,0],["فوجئت فيك بأنكر الأنباء","وفجعت فيك بأكبر الأرزاء",4,"ا",2,1],["فُوجِئْتَ حَتْفاً وَهَذَا","أَوْلَى بِعِزِّ الضَّيَاغِمْ",5,"م",1,0],["فوجدتُه قد طلَّه صوب الندى","بسحائب تنهلُّ من يُمناكا",6,"ك",2,0],["فَوَجِّه وجه عزمك نحو آت","ولا تَلفِت إلى الماضين جيدا",7,"د",2,0],["فَوَجهُكَ مَضروبٌ وَأُمَّكَ ثاكِلٌ","وَسِبطُكَ مَأسورٌ وَعِرسُكَ أَيِّمُ",8,"م",1,0],["فوجهك عن بشر وكفك عن عطا","وخلقك عن سعدٍ ورأيك عن سعد",9,"د",1,0],["فوجدت للنعماء ملء مآربي","ووجدت للأوصاف ملء لساني",10,"ن",2,0],["فوجدنا فُضولكم صفواتٍ","ووجدْنا فضول قومٍ فضالا",11,"ل",2,0],["فوجهُهُ يأخذُ من رأسهِ","أخذَ نهارِ الصيفِ من ليلهِ",12,"ل",2,0],["فَوَجَدتُكُم لِقَحاً حُبِسنَ بِخُلَّةٍ","وَحُبِسنَ إِذ صُرّينَ غَيرَ غِزارِ",13,"ر",1,0],["فَوَجهٌ وَلا بِشرٌ وَمالٌ وَلا نَدىً","لَقَد خابَ لا حُسناً حَواهُ وَلا حُسنى",14,"ن",2,0],["فَوَجَدْتُ أَعراسَ الوُجُود مآتِماً","ووجدْتُ فِرْدَوْسَ الزَّمانِ جَحِيما",15,"م",2,0],["فوجئت مصر بالنعي فكادت","أرضها من هول المصاب تمور",16,"ر",1,0],["فوجدت الصواب في الرأى أنى","أهجر الشعر والقوافي مليا",17,"ي",2,0],["فَوَجد الدار خلت وَاِستَهدَفَت","بِمَوت كافور الَّذي كانَ وَقى",18,"ا",1,0],["فُوجِئَ وَالجُيوشُ في الأَطرافِ","بِنَهضة الدَهماءِ وَالأَشرافِ",19,"ف",1,0],["فَوُجوهُهُنَّ وَماؤُها","سِترٌ عَلى المُتَجَمِّلاتِ",20,"ت",1,0],["فوَجهٌ من الفتيانِ يمسَحُ وَجهَه","وصَدْرٌ من الأقوامِ يُسكِنُهُ صَدْرا",21,"ر",2,0],["فَوَجَدتُ أُنساً عِندَ ذِكرِكِ كامِلاً","في مَوقِفٍ يَخشى الفَتى مِن ظِلِّهِ",22,"ه",1,0],["فَوَجهُ الضُحى غَدواً لَهُنَّ مُضاحِكٌ","وَجَنبُ النَدى لَيلاً لَهُنَّ مُضاجِعُ",23,"ع",1,0],["فَوَجْهُكَ مَنْحُوسٌ وَكَعْبُكَ سَافِلٌ","وَقَلْبُكَ مَدْغُولٌ وَعَقْلُكَ مُخْتَلُّ",24,"ل",1,0],["فوجنتي قائلتي","عوَّتي غاسلتي",25,"ي",1,0],["فوجهُكَ إنْ قابلتُهُ أو رأيتُهُ","يكونُ لقلبي بالمقابلةِ الجبرُ",26,"ر",1,0],["فَوَجَدناكَ إِذ خَبَرنا مَلولاً","طَرِفاً لَم تَكُن كَما كُنتَ قُلتا",27,"ت",2,0],["فَوَجَدتُ فيهِ حُرَّةً قَد زُيِّنَت","بِالحَليِ تَحسَبُهُ بِها جَمرَ الغَضا",28,"ا",1,0],["فَوَجَدنا خِلفَهُ دِع","صاً مِنَ الثَلجِ نَقِيّا",29,"ي",2,0],["فوُجِدْنَ أمْضى من سِهامِ التُّرك إذ","نُفِضَتْ وأنْفَدَ مِن حِرابِ الدّيْلمِ",30,"م",1,0],["فَوَجدي بِسَلمى مِثلُ وَجدِ مُرَقِّشٍ","بِأَسماءَ إِذ لا تَستَفيقُ عَواذِلُه",31,"ل",2,0],["فَوَجَدتُها في هِمَّتي وَرَأَيتُها","في مَطلَبي وَعَرَفتُها في مالي",32,"ل",2,0],["فَوَجدْنَهُ رَجُلاً مَلِيحاً","خَلْقُهُ حَسَنَ الظَّوَاهِرْ",33,"ر",1,0],["فَوَجَدْتُ تَعْزِيَةً وَبَشَّرَنِي","أَمَلٌ بِعَصْرٍ فَجْرُهُ بَادِي",34,"د",2,0],["فَوَجهُ الصَبرِ لِلثَكلى","سَميرٌ وَهَوَ لي سَمجُ",35,"ج",1,0],["فوجهُك ذابلٌ والصمتُ هَمْسٌ","ومشيُك واهنُ الْخطَواتِ دَأْل",36,"ل",1,0],["فوجدتُني أدْنى إلى ضَجَر","لكليهما وأحبَّ للوَصَب",37,"ب",1,0],["فوجدتُ رَيْعان الجمالِ ولم أسَأ","أني أضعت من الصبا ريعانا",38,"ن",2,0],["فوجدناكَ في الجميع رضيّاً","وحميداً مصَّبحاً ومُمَسَّى",39,"س",2,0],["فوجه أديم الشام طلق منوّر","ووجه بحيرات السماء قسيم",40,"م",1,0],["فوجدها خفي","وشأنها جلي",41,"ي",1,0],["فوجهك روض حسن فيه ورد","بعيد الروح للمضنى نسيمه",42,"م",2,0],["فوجدنا بك السرور كما يف","رح بالزاد ناظر المسكين",43,"ن",1,0],["فوجدت رهط الهبر","قد بز الأَماثل أريحية",44,"ي",2,0],["فوُجِدنا من بعد ما قد عُدمِنا","وعُدمنا من بعدِ ما قد وُجدنا",45,"ن",2,0],["فَوَجَدتُهُم يَتَبايَنونَ وَإِن غَدَوا","في خَلقِهِم وَفَنائِهِم أَنظارا",46,"ر",2,0],["فَوَجَدتَ عَينَ الدَولَةِ العَضبَ الَّذي","ضَرَبَ الأَنامُ بِجَدِّهِ الأَمثالا",47,"ل",2,0],["فوجه الإله لمن أمّه","مبين منير فما يشتبه",48,"ب",2,0],["فوجدته مستهدفا","لي قد أمنت من احتجابه",49,"ب",2,0],["فوجهك مُعلَمٌ بطراز شكلٍ","وجسمك مُرتَدٍ برداء لينِ",50,"ن",1,0],["فَوَجْهُ الهدَى رَيَّانُ أَبْيَضُ ناصِعٌ","كما بِكَ وَجْهُ الشِّرْكِ أَسْودُ حالكُ",51,"ك",1,0],["فوجَّهتْ بالدرّ لي ثغرَها","وأرسلتْ لي وجهَها في المِرَاه",52,"ا",2,0],["فَوَجيبُ الفُؤادِ مُذ","نَفَرَ الحَيُّ ما سَكَن",53,"ن",1,0],["فَوَجهُ الأَرضِ بَعدَكِ مُقشَعِرُّ ال","ثَرى وَالمُزنُ مُخلِفَةٌ جَهامُ",54,"م",1,0],["فَوُجوهُهُم عُوَدٌ عَلى أَموالِهِم","وَأكُفُّهُم مِن دونِها أَقفالُ",55,"ل",1,0],["فَوَجَدتُ ظَهرَ اليَأسِ حي","نَ يَئِستُ أَوطَأَ مَركَبا",56,"ب",2,0],["فوجه هذا للسيف وحشته","ووجه ذاك المليح للقبل",57,"ل",1,0],["فوجدت كل الصيد في جوف الفرا","وَلَقيت كل الناس في انسان",58,"ن",1,0],["فَوَجدي كَثيرٌ مِثلُ أَيّامِ بُعدِهِ","وَصَبري كَأَيّامِ الدُّنُوِّ قَليلُ",59,"ل",1,0],["فوجدته تيهاً أضلّ به","كسفينة من غير ملامح",60,"ح",1,0],["فوجدتني ملآن من مرحٍ بها","والعجبُ والخيلاءُ ملءَ إهابي",61,"ب",2,0],["فوجه حيث شئت فأنت مما","له وجهت فاختر للمليح",62,"ح",1,0],["فَوَجَّهَها قَوارِبَ فَاِتلَأَبَّت","لَهُ مِثلُ القَنا المُتَأَوِّداتِ",63,"ت",1,0],["فَوَجِهِي علَى وَجْهٍ لَها كُلَّ لَيْلةٍ","وَيَومٍ إذا جوا إنَّ ذا نَافِعِي غَدا",64,"د",2,0],["فَوجدِي بِهِ كاسمِي عَلِيٌّ زَفِيرُه","وَجَدِّيَ مِن نَعتِ الفُؤَادِ حَرِيقُ",65,"ق",1,0],["فوَجْهُكَ يُعطي البِلادِ السّناءَ","ورأيُك يَكفي العِبادَ السِّنينا",66,"ن",2,0],["فوَجْهِيَ شمسٌ والفراقُ ظَهيرةٌ","وخَدُّك أرضٌ والدُّموعُ سَراب",67,"ب",1,0],["فوَجدي بها بَعد النَّوى كانَ مثلَها","يُشاكلُ هذا الوَجهُ ذاكَ بعَينِهِ",68,"ه",1,0],["فوجدت الخُبره","بالعنا والتعب",69,"ب",1,0],["فوجدت فيه الحق أبلج واضحاً","للمهتدي ورأيت أقوم قيلا",70,"ل",2,0],["فوجدت منه ريح من أحببته","فطمعت في عدل الحبيب الجائر",71,"ر",1,0],["فوجُهكَ حين ألحظُهُ بطَرْفي","يُريني البِشْرَ في وَجهِ الزَّمانِ",72,"ن",1,0],["فوجْديَ أنِّيَ فارَقتُه","ولم أَبْلُ ما يزعُمونَ اختِبَارَا",73,"ر",2,0],["فوجوهُهمْ دريّةٌ يهدى بها","باغي النوالِ ولفظُهُمْ دُريُّ",74,"ي",1,0],["فوجدتُه أوفاهُمُ بندىً","كفًّاً وأغضَى عن أذىً جفنا",75,"ن",2,0],["فوجهك وضاحٌ وكفُّك هاطلٌ","وبأسك مرهوبٌ وصدرك واسعُ",76,"ع",1,0],["فوجئتَ بالمعهود إلا أنني","عاينتُ وجداً ليس بالمعهودِ",77,"د",1,0],["فوجه الصبح ليس له سفور","وطرف الليل بعدهم كحيل",78,"ل",1,0],["فوجههُ الطلقُ عندي عابسٌ تربٌ","ونيله العذب مثل الآجنِ الأسن",79,"ن",1,0],["فوجههُ قد كفيت فيهِ","بما علاهُ من السواد",80,"د",1,0],["فوجدي وسلواني مقيم وظاعن","وحزني ولهوي جائد وبخيل",81,"ل",1,0],["فَوَجهُ يَومِكَ فيهِ","مِنَ المَلاحَةِ ماءُ",82,"ا",2,0],["فوجده في ضلال","وشيبه في خضاب",83,"ب",1,0],["فوجدنا أخلاق سيدنا الزهْ","رذَكاءً تُربى عَلى الأَزهارِ",84,"ر",1,0],["فَوَجَدْتُ ما أخْشاهُ مِنْها فَوْقَ مَا","أَرْجُو فَطَاحَتْ عِنْدَ ذَا آمَالي",85,"ل",2,0],["فوجودي الذي ترون له لا","هو لي قد أعارنيه إلهي",86,"ي",1,0],["فوجودنا هو صورة لوجوده","لا أنه ذاك الوجود علا وجلّْ",87,"ل",1,0],["فوجهها من خلف أثوابكم","وشمسها تشرق في بدرها",88,"ر",3,0],["فوجود الكون قول ال","له كن هم كلمات",89,"ت",1,0],["فوجودي هو الوجود الحقيقي","والتصاوير فيه كانت خضابا",90,"ب",2,0],["فَوَجَّهَ في طَلَبي حِميَراً","فَوَلَّوا غَداةَ التَقَينا الظُهورا",91,"ر",2,0],["فَوَجَّهَها غَربِيَّةً عَن بِلادِنا","وَوَدَّ الَّذينَ حَولَنا لَو تُشَرِّقُ",92,"ق",1,0],["فوجبت طاعته من بعده","على جميع الناس يوم عقده",93,"ه",1,0],["فوجه النبي بالصديق","فأخذ الكتاب من عتيق",93,"ق",1,0],["فوجدوا الضيف عليها قد جمع","وكان مقطوع اليمين فقطع",93,"ع",1,0],["فَوَجَدنا الَّذي رَجَونا وَكانوا","خَلَفِيِّينَ طَيِّبي الحُجُزاتِ",94,"ت",1,0],["فوجود سعد حولنا قد فاق ما","ملكت يد بل كل كنز يقتنى",95,"ن",2,0],["فوجدت مثلى لا يلذ له سوى","بر يقوم به بسر او علن",96,"ن",1,0],["فوجهك فيه والشموس طوالع","وبدر الدجى شمس الضحى وهلاله",97,"ل",2,0],["فوجهي روض نسرين","بماء الحسن مرشوش",98,"ش",1,0],["فَوَجِّهَا نَحْوَهُمُ إنَّهُمْ","وإنْ بَغَوْا قِبْلَةُ بُغْياتي",99,"ت",2,0],["فوجئت يوم نعيت فيك بشاغل","عن كل مكروه وكل مصاب",100,"ب",1,0],["فوجدت قومي كلهم في شاغل","عن دائب مثلي بهم مشغول",101,"ل",1,0],["فوجهُها قمرٌ أوفى على غُصُن","يهتزُّ فوقَ نقاً مِن كُثبِ يبرينِ",102,"ن",1,0],["فوجديَ بالوَصْلِ الذي هُوَ مُسْعِفي","بحظّيَ منه مثلُ وجديَ بالهجر",103,"ر",1,0],["فَوَجنَتُهُ قرارُ الوَرْدِ أضْحَتْ","فَبي أَفْدي لِذيّاكَ القَرارِ",104,"ر",1,0],["فَوَجنَتُهُ رَوضٌ وَأَمّا عِذارُهُ","فَآسٌ لهُ الشّاماتُ في الحسنِ حبّاتُ",105,"ت",1,0],["فَوَجَّهَهُ نَحوَ الثَوِيَّةِ سائِراً","إِلى اِبنِ زِيادٍ في الجُموعِ الكَباكِبِ",106,"ب",1,0],["فَوَجد الطارِقَ طارِقين","مِن أَجلِهِ بِالباب وَاقِفينِ",107,"ن",1,0],["فَوجدته في أَذل عيشه","وَخَفَّ حَتّى صارَ وَزن الريشَه",108,"ه",1,0],["فَوجّه مِنهُ أَرسال النَصارى","إِلى المَولى لِيُسعِفَه الطلابا",109,"ب",2,0],["فوجدي بطيّا وجد أشمط راعه","بواحده داى المنايا ألمّت",110,"ت",1,0],["فوجهك طلق والغيوث عوابس","وجودك عذب والبحار موالح",111,"ح",1,0],["فوجهه مثل القمر","وكفه بحر زخر",112,"ر",1,0],["فوجدا هارون أحم