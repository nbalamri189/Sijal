{"poems":[[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[215,"كل لفظ من حسين","https://www.aldiwan.net/poem46600.html","مجزوء الرمل"],[295,"ويح قلبي الشجي كم ذا يعاني","https://www.aldiwan.net/poem11690.html","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44733","الرمل"],[4829,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=36754",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""]],"verses":[["قاهِرٌ أَلقى بِهِ في صَخرَةٍ","دَفَعَ النَسرَ إِلَيها فَأَواها",0,"ا",3,0],["قاهِرَ الخَصمِ وَالجَحافِلِ مَهما","جَدَّ هَولُ الوَغى وَجَدَّ اللِقاءُ",1,"ا",2,0],["قاهِرُ العَصرِ وَالمَمالِكِ نابِل","يونُ وَلَّت قُوّادُهُ الكُبَراءُ",1,"ا",2,0],["قَأَهْنَأْ بِمَنْصِبِهَا الرَّفِيعِ وَإِنْ تَكُنْ","أَعْبَاؤُهَا مِنْ أَفْدَحِ الأَعْبَاءِ",2,"ا",2,0],["قاهريٌّ أخجلتْ ألحانُه","رنَّة العُودِ وشَدْوَ القَصَبِ",3,"ب",1,0],["قاهريّ الروح لو شاء الصعيد","قال هذا الروح من نور الصعيد",4,"د",1,0],["قاهرُ الفاتحين والأمراء الصيد","من كل أمةٍ ولسان",5,"ن",1,0],["قاهراتٍ للبغاة الليما","ظافراتٍ في العداة الخنسِ",6,"س",1,0],["قاهراتٌ يد البلى ومحالٌ","أن يكيلَ الأذى لها العابثانِ",7,"ن",1,0],["قاهرٌ قادرٌ على كلِّ شيءٍ","واسعُ العفو لم يُعَجِّل بجانِ",7,"ن",1,0],["قاهرُ الخَلقِ قَوِيٌّ","يُبرمُ الأَمرَ في رمشِ",8,"ش",1,0],["قاهره ساحره مُتعَبه مُتعِبه","لك يذل كل اميرن عزيز ومَلِكْ",9,"ك",1,0],["قاهري آمري بإيفاء عهدي","حين أخذي كالذر في الشاهدينا",10,"ن",2,0]]}