{"poems":[[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[211,"كل لفظ من حسين","https://www.aldiwan.net/poem46600.html","مجزوء الرمل"],[290,"ويح قلبي الشجي كم ذا يعاني","https://www.aldiwan.net/poem11690.html","الخفيف"]],"verses":[["قاهِرٌ أَلقى بِهِ في صَخرَةٍ","دَفَعَ النَسرَ إِلَيها فَأَواها",0,"ا",3,0],["قاهِرَ الخَصمِ وَالجَحافِلِ مَهما","جَدَّ هَولُ الوَغى وَجَدَّ اللِقاءُ",1,"ا",2,0],["قاهِرُ العَصرِ وَالمَمالِكِ نابِل","يونُ وَلَّت قُوّادُهُ الكُبَراءُ",1,"ا",2,0],["قَأَهْنَأْ بِمَنْصِبِهَا الرَّفِيعِ وَإِنْ تَكُنْ","أَعْبَاؤُهَا مِنْ أَفْدَحِ الأَعْبَاءِ",2,"ا",2,0],["قاهريٌّ أخجلتْ ألحانُه","رنَّة العُودِ وشَدْوَ القَصَبِ",3,"ب",1,0],["قاهريّ الروح لو شاء الصعيد","قال هذا الروح من نور الصعيد",4,"د",1,0],["قاهرُ الفاتحين والأمراء الصيد","من كل أمةٍ ولسان",5,"ن",1,0]]}