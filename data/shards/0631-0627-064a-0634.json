{"poems":[[75,"أفاض سماحك بحر الندى","https://www.aldiwan.net/poem11956.html","المتقارب"],[46,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[107,"هنا يا سراة الأزد حطوا رحالكم","https://www.aldiwan.net/poem44006.html","الطويل"],[107,"تقدم فهذا مطلع الحق والهدى","https://www.aldiwan.net/poem44054.html","الطويل"],[22,"وطاوي ثلاث عاصب البطن مرمل","https://www.aldiwan.net/poem22073.html","الطويل"],[48,"عجبت لشارب بزجاج راح","https://www.aldiwan.net/poem22480.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[22,"وَطاوي ثَلاثٍ عاصِبِ البَطنِ مُرمِلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=67743",""],[92,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[463,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[463,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133849","البسيط"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74996","الطويل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29559","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75879","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34648","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119683","الوافر"],[4070,"","https://poetry.dctabudhabi.ae/diwan/poem/80133","الوافر"],[5409,"هب النسيم على الشاطي وحين بدا","https://www.poetsgate.com/ViewPoem.aspx?id=155504",""]],"verses":[["رَأى شيمَتَيكَ لِما تَستَحِقُّ","وَقَفّى فَأَظفَرَ إِذ أَيَّدا",0,"د",2,0],["رَأى شَرَفاً مِمَّن يُريدُ اِختِلاسَهُ","بَعيدَ المَدى فيهِ عَلى أَهلِهِ قُربُ",1,"ب",1,0],["رأى شَكَرٌ من خطبِهم وبلائِكُمْ","مشاهِدَ هَزَّتْهُ فحيَّا وسَلّما",2,"م",2,0],["رَأى شَرَّهُمْ فاحتالَ يَحفظُ ماله","عليهِ ويَأْبَى أن يُغادِرَهُ سُدَى",3,"د",2,0],["رَأى شَبَحاً وَسطَ الظَلامِ فَراعَهُ","فَلَمّا بَدا ضَيفاً تَسَوَّرَ وَاِهتَمّا",4,"م",2,0],["رَأى شَمسَ المُدامِ تَغورُ فيهِ","وَتَطلُعُ في ذُرى قَدَحٍ جَديدِ",5,"د",1,0],["رأى شبحاً في قربِ نارٍ كأنما","يودِّعُ طيفاً غابَ عن نظراتِهِ",6,"ه",1,0],["رَأَى شَبَاباً وَضِيئاً","عَمَّ الْقُرَى وَالرحَابا",7,"ب",2,0],["رَأى شَبَحاً وَسطَ الظَلامِ فَراعَهُ","فَلَمّا بَدا ضَيفاً تَشمَّرَ وَاِهتَمّا",8,"م",2,0],["رأى شعبه مُلكاً مُشاعاً لخيره","فأصبح مُلكاً للبلاد مشاعا",9,"ع",2,0],["رأى شُعبةً ليَ من بينهم","مشعَّبةَ المجدِ في بيتِ رُومِ",10,"م",1,0],["رأى شَهرَ بُعدِي مَحاقاً له","فلم يُغنه العَشرُ والأربعُ",11,"ع",1,0],["رائشي من أَتاهمُ مستريشاً","وَيُرى مستريشهم مستراشا",12,"ش",2,0],["رأى شقائي فريع وهو","المريع والحاصد الرهيب",13,"ب",1,0],["رأى شَبيبة التَوحيد كَيفَ تخضبت","بأسمر كالبلسام ظلما وَعدوانا",14,"ن",2,0],["رَأى شَخصَ مَسعودِ بنَ سَعدٍ بِكَفِّهِ","حَديدٌ حَديثٌ بِالوَقيعَةِ مُعتَدُ",15,"د",1,0],["رَأَى شَبَحي نِضواً وَنُطقي خافِتاً","وَدَمعيَ هَتّاناً وَحِسّي قَد سَجا",16,"ج",2,0],["رأى شيمَ الجودِ محمودةً","وما شيمُ الجُودِ إلا قسم",17,"م",1,0],["رأى شبحاً ففرّ إليه لمّا","رأى جِيداً تلألأ في وشاح",18,"ح",1,0],["رأى شخْصاً على بلدٍ بعيد","فكَبَّر حين أبْصره وقاما",19,"م",2,0],["رأى شمائل قد أزرت برقته","فارتد عنها حياءً وانتحى طرفا",20,"ف",2,0]]}