{"poems":[[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[81,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42547","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[158,"قلب على جمر الغضا يتقلب","https://www.aldiwan.net/poem58807.html","الكامل"],[221,"في ذمة الماضي انطوت","https://www.aldiwan.net/poem41918.html","مجزوء الكامل"],[221,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[296,"طيف للمياء ما ينفك يبعث لي","https://www.aldiwan.net/poem36813.html","عموديه"],[549,"إذا شئتما أن تبكياني صبابة","https://www.aldiwan.net/poem47230.html","الطويل"]],"verses":[["تَرْثِي فَقِيدَهُمُ رِثَاءُ فَقِيدِهَا","وَيَشِفُّ عَمَّا تُضْمِرُ الإِعْلانُ",0,"ن",1,0],["تَرِثُّ لِمَن رامَ الوَفاءَ حِبالُهُ","وَتُغرى بِمَن رامَ الخَلاصَ حَبائِلُه",1,"ل",2,0],["تَرِثُّ عَلَى قُرْبِ الوِدادِ عُهُودُهُمْ","وَكَيْفَ يَدُومُ الشَّيءُ وَهْوَ رَثِيثُ",2,"ث",1,0],["تَرْثي العُرُوبَةُ مَنْ رَثى لِشَقَائِهَا","وَعَنَاهُ ضَمُّ نظامِهَا المُتَنَاثرِ",3,"ر",1,0],["تَرْثِي فَرِيداً وَالنُّزُو","عُ إِلَيْهِ مُقْتَدِحٌ زِنَادَكْ",4,"ك",1,0],["تُرْثِي صُرُوحُ الْخَيْرِ بَانِيَهَا الذي","لَمْ يَدَّخِرْ فِيهَا لَهُ مَجْهُودُ",5,"د",1,0],["ترْثِي الحَصَافَةُ وَالثَّقَافَةُ وَالتقَى","مَنْ عَاشَ لاَ ذَمٌ وَلاَ تَفْنِيدُ",5,"د",1,0],["ترثي لهم أعداؤهم يا ويحَ من","لهم رثى الأعداء مما عذّبوا",6,"ب",3,0],["تَرثي الحَياةَ كَأَنَّها","مِن نِصفِ شَهرٍ أَرمَلَه",7,"ه",1,0],["تَرثي اِبنها بِمَدامِعٍ","حرّى مِنَ القَلبِ الكَسير",8,"ر",1,0],["ترثي لشكواي إذ أرثي لشكوتِها","والنجمُ من فوقنا يرثي لشكوانا",9,"ن",2,0],["ترثّ اللّيالي كلَّ شيءٍ وإنّما","يزيد عليها جِدَّةً وتصرّما",10,"م",2,0]]}