{"poems":[[95,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42547","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[164,"قلب على جمر الغضا يتقلب","https://www.aldiwan.net/poem58807.html","الكامل"],[228,"في ذمة الماضي انطوت","https://www.aldiwan.net/poem41918.html","مجزوء الكامل"],[228,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[303,"طيف للمياء ما ينفك يبعث لي","https://www.aldiwan.net/poem36813.html","عموديه"],[556,"إذا شئتما أن تبكياني صبابة","https://www.aldiwan.net/poem47230.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48727","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141319","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47210","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87385","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89600","البسيط"],[585,"يا رافع الصوت ينعى المفرد العلما","https://www.poetsgate.com/ViewPoem.aspx?id=161938",""],[5690,"ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[5791,"وشم ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208559",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5842,"حلب 2013 / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137040",""],[5956,"يا رحمة المولى على أنقى امرِئ","https://www.poetsgate.com/ViewPoem.aspx?id=183551",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""]],"verses":[["تَرْثِي فَقِيدَهُمُ رِثَاءُ فَقِيدِهَا","وَيَشِفُّ عَمَّا تُضْمِرُ الإِعْلانُ",0,"ن",1,0],["تَرِثُّ لِمَن رامَ الوَفاءَ حِبالُهُ","وَتُغرى بِمَن رامَ الخَلاصَ حَبائِلُه",1,"ل",2,0],["تَرِثُّ عَلَى قُرْبِ الوِدادِ عُهُودُهُمْ","وَكَيْفَ يَدُومُ الشَّيءُ وَهْوَ رَثِيثُ",2,"ث",1,0],["تَرْثي العُرُوبَةُ مَنْ رَثى لِشَقَائِهَا","وَعَنَاهُ ضَمُّ نظامِهَا المُتَنَاثرِ",3,"ر",1,0],["تَرْثِي فَرِيداً وَالنُّزُو","عُ إِلَيْهِ مُقْتَدِحٌ زِنَادَكْ",4,"ك",1,0],["تُرْثِي صُرُوحُ الْخَيْرِ بَانِيَهَا الذي","لَمْ يَدَّخِرْ فِيهَا لَهُ مَجْهُودُ",5,"د",1,0],["ترْثِي الحَصَافَةُ وَالثَّقَافَةُ وَالتقَى","مَنْ عَاشَ لاَ ذَمٌ وَلاَ تَفْنِيدُ",5,"د",1,0],["ترثي لهم أعداؤهم يا ويحَ من","لهم رثى الأعداء مما عذّبوا",6,"ب",3,0],["تَرثي الحَياةَ كَأَنَّها","مِن نِصفِ شَهرٍ أَرمَلَه",7,"ه",1,0],["تَرثي اِبنها بِمَدامِعٍ","حرّى مِنَ القَلبِ الكَسير",8,"ر",1,0],["ترثي لشكواي إذ أرثي لشكوتِها","والنجمُ من فوقنا يرثي لشكوانا",9,"ن",2,0],["ترثّ اللّيالي كلَّ شيءٍ وإنّما","يزيد عليها جِدَّةً وتصرّما",10,"م",2,0],["ترثيك تقوى ما رأت ورعاً قضى","عمراً وجل الوقت منه سجود",11,"د",1,0],["ترثيك أشياخ وشبان كما","ترثي عفافك نسوة وعذارى",12,"ر",2,0],["ترثي الذّي كان يولي النّاس عن سعةٍ","جوداً وكان لعين الحيّ إنسانا",13,"ن",2,0],["ترثي أخا الحزم والإقدام والخلل ال","حسناء من كان بالألطاف مزدانا",13,"ن",2,0],["تَرِثُ منه العلمَ والأسرارا","والحِكْمَةَ العَلْيَاءَ والأنوارا",14,"ر",2,0],["ترثيك اقلامٌ يَكون صَريرُها","نوحاً عليك من الاسى وعويلا",15,"ل",2,0],["تَرثيكُمُ عُذرَةٌ يا أَهلَ أَندَلُسٍ","يا أَهلَ أَندَلُسٍ تَرثيكُمُ ثُعلُ",16,"ل",1,0],["ترثي الكريم الذي لم ينس ما احتملت","تبكي الزعيم الذي لم يقطع الرحما",17,"م",2,0],["ترثيك أيضاً علومٌ قد عرفت بها","جلَّت مقاديرها عن حصرها بفمِ",18,"م",1,0],["ترثوه فوضاهُ منذ اختارَ قتْلتَهُ","رجماً بقافيةٍ حمراءَ .. تنظمُك",19,"ك",1,0],["تَرْثِي صَلاحاً وَ كَانَ السَّيْفُ يَحْفَظُهَا","فَخَلَّفَ الخَيْرُ أَشْرَاراً مِنَ النِّقَمِ",20,"م",1,0],["ترثي الأمانَ وتبكي عِزّ قَلعَتِها","تَنعِي المَوَاسِمَ والألحانَ والطَرَبَا",21,"ب",2,0],["ترثي جَهابِذة أثروا حضارتها","تبكي المصانِعَ والأقلامَ والكُتُبا",21,"ب",2,0],["ترثيه كلُّ محاجري وجوارحي","وجميعُ ما عندي من الأوزانِ",22,"ن",1,0],["ترثيه كل فقيرةٍ ومعذبٍ","لمكارمٍ في طبعهِ وحنانِ..",22,"ن",1,0],["ترثة سباع ما يهابوا من العِدا","يَوم القَنا يرعف مشطر سنونها",23,"ن",3,0]]}