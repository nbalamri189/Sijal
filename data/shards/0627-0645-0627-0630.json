{"poems":[[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[57,"يا من شقيت بحبه","https://www.aldiwan.net/poem26464.html","مجزوء الكامل"],[74,"يا جفن أمزج أدمعي بدمائي","https://www.aldiwan.net/poem18200.html","الكامل"],[45,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[82,"رعى من أخي الوجد طيف ذماما","https://www.aldiwan.net/poem31291.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[164,"عندي لوالد أحمد ولأحمد","https://www.aldiwan.net/poem58984.html","الكامل"],[406,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[463,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[767,"","https://poetry.dctabudhabi.ae/diwan/poem/205351","البسيط"],[1302,"","https://poetry.dctabudhabi.ae/diwan/poem/131395","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77851","الهزج"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101022","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101038","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28598","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60857","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87314","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68098","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131026",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4129,"","https://poetry.dctabudhabi.ae/diwan/poem/205348","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133168","الطويل"],[5121,"بُلْبُلٌ وَلَكِنْ","https://www.poetsgate.com/ViewPoem.aspx?id=33586",""],[5183,"الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=180193",""],[5629,"البارحه","https://www.poetsgate.com/ViewPoem.aspx?id=184615",""],[5690,"ماذا الشفيع وماذا ينفع الحذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172157",""],[5956,"حول الأوزان والحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=186235",""],[463,"أصبْ برأيي أصابًَ الحظُّ أو غلطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60116&r=&rc=172",""]],"verses":[["أَما ذُعِرَت بِنا بَقَرُ الخُدورِ","وَغِزلانُ المَنازِلِ وَالقُصورِ",0,"ر",1,1],["إِمّا ذَهَبتِ وَكُلُّ إِل","فٍ قَد يَصيرُ إِلى الذَهابِ",1,"ب",1,0],["أما ذبيحا مقلتي ومدامعي","لهما فما وفيا بفيض دماء",2,"ا",2,0],["أَم أُذنُهُ في يَدِ النَخّاسِ دامِيَةً","أَم قَدرُهُ وَهوَ بِالفَلسَينِ مَردودُ",3,"د",1,0],["أما ذِكْرُهُ ذِكْرُ من يُتّقى","يداً ويكون كلامٌ كِلاما",4,"م",2,0],["أما ذقتَها قبلَ هذا المساءِ","وعربدْتَ نشوانَ من سُكْرِها",5,"ر",3,0],["أما ذوال فما أشك بإنها","هلكت وإن هي لم تكن فكان قد",6,"د",1,0],["أم أذكر ( الشِّعبَ الخصيب ) ولوزَهُ","والتينَ والزَّيتونَ والرُّمَّانا",7,"ن",2,0],["أم أذكر (الكُرَّ) الصغير و(قفَّهُ)","و( الغَرْبَ ) يصعدُ مفعما ملآنا",7,"ن",2,0],["أم أذكر (المَحَّالَ) و( الدَّرَّاج ) في","نغميْهِما صوتُ المَدَى نادانا",7,"ن",2,0],["إما ذُنابَى فلا تحفلْ بمنقصةٍ","أو قمةَ الرأس واحذرْ أن تقعْ وسَطا",8,"ط",2,0],["أما ذكاء فلم تصفر إذ جنحت","إلا لفرقة هذا المنظر الحسن",9,"ن",1,1],["أما ذمام الرد مني لكم","فهو من المحتوم فيما سبق",10,"ق",1,0],["أَما ذا ديرنا الطور","أَما خمارنا النور",11,"ر",1,0],["أم إذا نجل العواتك للعلا","فالملك يحمد والعلا أنجالها",12,"ل",3,0],["أم إذا درج الوليد بحجرها","فالدين يرعى والبيان يعول",13,"ل",1,0],["أَمّا ذَوائِبُها فَجُنحُ دُجُنَّةٍ","وَجَبينُها فَلَقُ الصَباحِ المُسفِرِ",14,"ر",1,0],["أَما ذا البَرقُ بَيضُ بَني عَدِيٍّ","فَكَيفَ رَمى فُؤادَكَ بِالهُمومِ",15,"م",1,0],["أمّاَ ذُوال فإنها في حالة","من صَاحب الديوان لا تتكيف",16,"ف",1,1],["أَمَّا ذوو الأزياج والحِسَابِ","عندهمُ النيروز بالصوابِ",17,"ب",1,0],["أما ذاق كأس الموت فيها محمد","وما حملت أنثى بمثل محمد",18,"د",1,0],["أما ذوو العز تَحْتَ الأمرِ مُطرِقَة","بعصرِ فيصلَ شمسُ الفضلِ مُشرقة",19,"ه",1,0],["أما ذقت طعم الحب يوما ألم يكن","فؤادك من تأثيره يتكهرب",20,"ب",1,0],["أَمّا ذِيُوِميذُ فَجاشَ وَاِنثَنى","قالَ وَما غَرَّكَ يا وَجهَ الخَنا",21,"ن",2,0],["أما ذكاء فلم تصفرّ إذ جنحت","إلا لفرقة ذاك المنظر الحسن",22,"ن",1,1],["أما ذا التصابي في المشيب حماقةً","وقد صار للفرع الحقيقي فروع",23,"ع",1,0],["أَمَا ذُقْتَ نَبْعِي وَالْهَوَى مِنْ نَسَائِمِي ؟","فَكَيْفَ اسْتَوَى طَيْرٌ يُنَاجِي بِلاَ حِسِّ ؟!",24,"س",1,0],["أم أذابته كالرصاص فلما","أفرغته رأته سر هواها",25,"ا",3,0],["أما ذبحوني أو ذبحت المناعير..","ولا عطوني من بغى القلب وده",26,"د",2,0],["أما ذووا الفضل من قد فل ناصرهم","أعني به المال لا سمع ولا بصرُ",27,"ر",1,0],["أما ذاك خيرٌ من عذابٍ مُجَدَّدٍ","بساعاتِ بحثٍ عن قوافٍ لألحَما ؟",28,"م",2,0],["إما ذنابى فلا تحفلْ بمنقصة ٍ","أو قمَّة َ الرأسِ فاحذرْ أنْ تقعْ وسطا",29,"ط",2,0]]}