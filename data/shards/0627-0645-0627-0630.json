{"poems":[[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[55,"يا من شقيت بحبه","https://www.aldiwan.net/poem26464.html","مجزوء الكامل"],[72,"يا جفن أمزج أدمعي بدمائي","https://www.aldiwan.net/poem18200.html","الكامل"],[43,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[80,"رعى من أخي الوجد طيف ذماما","https://www.aldiwan.net/poem31291.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[161,"عندي لوالد أحمد ولأحمد","https://www.aldiwan.net/poem58984.html","الكامل"],[401,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[459,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"]],"verses":[["أَما ذُعِرَت بِنا بَقَرُ الخُدورِ","وَغِزلانُ المَنازِلِ وَالقُصورِ",0,"ر",1,1],["إِمّا ذَهَبتِ وَكُلُّ إِل","فٍ قَد يَصيرُ إِلى الذَهابِ",1,"ب",1,0],["أما ذبيحا مقلتي ومدامعي","لهما فما وفيا بفيض دماء",2,"ا",2,0],["أَم أُذنُهُ في يَدِ النَخّاسِ دامِيَةً","أَم قَدرُهُ وَهوَ بِالفَلسَينِ مَردودُ",3,"د",1,0],["أما ذِكْرُهُ ذِكْرُ من يُتّقى","يداً ويكون كلامٌ كِلاما",4,"م",2,0],["أما ذقتَها قبلَ هذا المساءِ","وعربدْتَ نشوانَ من سُكْرِها",5,"ر",3,0],["أما ذوال فما أشك بإنها","هلكت وإن هي لم تكن فكان قد",6,"د",1,0],["أم أذكر ( الشِّعبَ الخصيب ) ولوزَهُ","والتينَ والزَّيتونَ والرُّمَّانا",7,"ن",2,0],["أم أذكر (الكُرَّ) الصغير و(قفَّهُ)","و( الغَرْبَ ) يصعدُ مفعما ملآنا",7,"ن",2,0],["أم أذكر (المَحَّالَ) و( الدَّرَّاج ) في","نغميْهِما صوتُ المَدَى نادانا",7,"ن",2,0],["إما ذُنابَى فلا تحفلْ بمنقصةٍ","أو قمةَ الرأس واحذرْ أن تقعْ وسَطا",8,"ط",2,0]]}