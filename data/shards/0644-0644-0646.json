?id=188488",""],[5002,"عاد الرّبيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=202636",""],[5002,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=209156",""],[5009,"قوة","https://www.poetsgate.com/ViewPoem.aspx?id=67997",""],[5009,"إليك يابن الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=68819",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[5151,"مطرٌ وشباكٌ ولوح زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=184920",""],[5219,"المشهد العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=194500",""],[307,"كم فيك يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=213636",""],[307,"كورونا سيف الردى","https://www.poetsgate.com/ViewPoem.aspx?id=214922",""],[5341,"أقرب لتلويحة قصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185352",""],[5376,"يا دارَ أهلي رغم هجري فانعمي","https://www.poetsgate.com/ViewPoem.aspx?id=188285",""],[5376,"مال الغبيط من الأهواء في المهج","https://www.poetsgate.com/ViewPoem.aspx?id=188318",""],[5376,"إياك نعبدُ ما في القلبِ الاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=188352",""],[5376,"يا ليتني قد طوتني البيضُ والسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=196892",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5376,"الحبُّ نفحٌ للاله بخلقه","https://www.poetsgate.com/ViewPoem.aspx?id=202174",""],[5376,"للنفسِ جّهْدٌ سعيُها حسراتُ","https://www.poetsgate.com/ViewPoem.aspx?id=202187",""],[5376,"أتاك قلبي ببعضِ الصمتِ يختصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214061",""],[5409,"للنفس ذاكرةٌ لا تعرف الكبرا","https://www.poetsgate.com/ViewPoem.aspx?id=155409",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5410,"زفرة","https://www.poetsgate.com/ViewPoem.aspx?id=133059",""],[5413,"أرجو بها بردةً أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=200583",""],[5431,"للنَّاسِ عِيدٌ ولِي عِيدي...","https://www.poetsgate.com/ViewPoem.aspx?id=212822",""],[5574,"علمُ النبض","https://www.poetsgate.com/ViewPoem.aspx?id=206016",""],[5609,"عتاب الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=215570",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5720,"يَوْمُ البِلاد","https://www.poetsgate.com/ViewPoem.aspx?id=206834",""],[5723,"ينابيع للشهادة والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=190280",""],[5751,"للماءِ يُتْمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=214783",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5906,"أمّي","https://www.poetsgate.com/ViewPoem.aspx?id=188015",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5952,"زفرة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=201945",""],[5976,"قصّة غَرَق .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30528",""],[161,"الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=157684",""],[6056,"القناعة كنز بايد","https://www.poetsgate.com/ViewPoem.aspx?id=130344",""],[6093,"ذات موصدة","https://www.poetsgate.com/ViewPoem.aspx?id=204990",""],[6108,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192747",""],[6229,"الغصن الذاوي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65173&r=&rc=5",""],[463,"للنقص من أعمارنا ما يكملُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60181&r=&rc=237",""],[433,"نومة الراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87053&r=&rc=6",""],[5567,"يانفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81771&r=&rc=39",""],[572,"شَمْسُ الضّحَى في الغَمَامِ مُسْتَتِرَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9290&r=&rc=147",""]],"verses":[["لِلنَإِباتِ مِنَ الرِجالِ جَريئُها","يَومَ اللِقاءِ وَلِلعَظيمِ عَظيمُها",0,"م",3,0],["لِلنَفسِ أَن تَبعَثَ العَزائِمَ وَال","رَأيَ وَكُلُّ الفِعالِ لِلجَسَدِ",1,"د",1,0],["لِلناسِ في الشَهرِ هِلالٌ وَلي","في وَجهِها كُلَّ صَباحٍ هِلال",2,"ل",1,0],["لِلنيلِ مَجدٌ في الزَمانِ مُؤَثَّلٌ","مِن عَهدِ آمونٍ وَعَهدِ فَتاحِ",3,"ح",1,0],["لِلنَّدَى مَوْقِعُ النَّدَى فَإِذَا لَمْ","تَصْلُحِ الأَرْضُ فَالْجَنيَ لا يُرَامُ",4,"م",1,0],["لِلنَّبِيِّينَ مَعْشَرٌ كَفَلُوهَمْ","وَالنَّبِيُّونَ قُصَّرٌ أَيْتَامُ",4,"م",1,0],["لِلنَّفْسِ مِنْهَا نَشْوَةٌ غيْرُ الَّتي","فِي الحِسِّ يُحْدِثُهَا طِلاً وَنَدِيمُ",5,"م",1,0],["للنار فيك حسيس كنت أحسبه","صحكاً على مَن بسوء الرأي أبكانا",6,"ن",2,0],["للنرجس المطلول ترنو أعين","فيها وتبسم للأقاح ثغور",7,"ر",1,0],["للنسوة العاملات والصبية ال","مزمن عنهم ما كان يكتسب",8,"ب",1,1],["لِلناسِ حَجٌّ وَلي حَجٌّ إلى سَكَني","تُهدي الأَضاحي وَأُهدي مُهجَتي وَدَمي",9,"م",2,0],["للناس عِيدٌ وَلي عِيدانِ في العِيدِ","إذا رأيْتُكَ يا ابن السَّادَةِ الصِّيدِ",10,"د",1,1],["للنرجس الفضلُ المبينُ وإن أبى","آبٍ وحاد عن الطريقة حائدُ",11,"د",1,0],["لَلْنجم أقربُ منهمُ","من كف ملتمسٍ ولمسه",12,"س",2,0],["للناس فيلٌ إمامُ الناس مالكُهُ","وأنت يا عمرو فيل الله لا الناس",13,"س",1,0],["للندى والردى مواطنُ كُرهٍ","لا يُصاليه حرَّهنَّ مُصالِ",14,"ل",1,0],["للناس فيما يكْلَفُونَ مغارمٌ","عند الكرامِ لها قضاءُ ذِمامِ",15,"م",1,1],["للناس في كل سر من أسِرَّتها","وادٍ ترفُّ على أرجائه النِّعم",16,"م",1,0],["للنَّرْجس الفضلُ برغْم من رغَمْ","على صُنوف الوَرْد والفضْلُ قِسَمْ",17,"م",1,1],["للنَّسيمِ الَّذي يضمِّخُ أَحلا","مي بعِطْرِ الأَقاحِ واللَّيمونِ",18,"ن",1,0],["للناس من شعر تركت جمال","تشدو به من بعدك الأجيال",19,"ل",1,1],["للناس في أمثالهم","حِكم لحافظها مفيده",20,"ه",1,1],["لِلناسِ مِن أَسرارِهِ ما عُلِّموا","وَلِشُعبَةِ الكَهَنوتِ ما هُوَ أَعمَقُ",21,"ق",1,0],["لِلناسِ في كُلِّ يَومٍ مِن عَجائِبِهِ","ما لَم يَكُن لِاِمرِئٍ في خاطِرٍ يَقَعُ",22,"ع",1,0],["للنّقَا رِدْفُهُ وللخُوطِ ما حُمِّ","لَ لِيناً وجِيدُهُ للغَزَالِ",23,"ل",1,0],["لِلنَدى الغَلبُ إِنَّهُ فاضَ وَالشِع","رُ عِمادي وَاِبنُ العَميدِ عِمادُه",24,"د",2,0],["لِلناظِرينَ إِلى إِقبالِهِ فَرَحٌ","يُزيلُ ما بِجِباهِ القَومِ مِن غَضَنِ",25,"ن",1,0],["لِلنَدى عاشِقٍ وَبِالمَجدِ صَبٍّ","مُستَهامٍ وَلِلسَماحِ خَليلِ",26,"ل",1,0],["لِلنَدى الأَوَّلِ الأَخيرِ الَّذي بَرَّ","زَ وَالسُؤدُدِ الحَديثِ المُقيمِ",27,"م",1,0],["لِلنّاسِ حِرصٌ عَلى الدُنيا بِتَدبيرِ","وَصَفوُها لَكَ مَمزوجٌ بَتَكديرِ",28,"ر",1,1],["لِلناسِ في السَبقِ بَعدَ اليَومِ مِضمارُ","وَالمُنتَهى جَنَّةٌ لا بُدَّ أَو نارُ",29,"ر",1,1],["لِلناسِ فَضلُكِ في حُسنِ الصَفاءِ وَفي","صِدقِ الحَديثِ وَشَرُّ الخُلَّةِ الكَذِبُ",30,"ب",1,0],["لِلناسِ فيهِ مِنَ الكَلامِ شَواهِدٌ","وَبِمَضرَبِ السَيفِ الجُرازِ فُلولُ",31,"ل",1,0],["للناهِضَاتِ الذاَّئِداتِ عنِ الحِمَى","الحامِلاتِ فَوادِحَ الأثقالِ",32,"ل",1,0],["لِلنَفعِ وَالضُرِّ عِندَهُ شِيَمٌ","أَمَرَّ فيها لِطاعِمٍ وَحَلا",33,"ل",2,0],["لِلناسِ إِن رَكِبوا نَهجَ الفَخارِ بُنَيّ","اتِ الطَريقِ وَلِاِبنِ الجَدِّ مَهيَعُهُ",34,"ع",2,0],["لِلنَتفِ فيهِ أَثَرٌ","كَأَثَرِ التَخريزِ",35,"ز",1,0],["للناسِ فيها وابلٌ وصواعقٌ","نَفْسٌ بها تَحْيا ونَفسٌ تَعْطَبُ",36,"ب",1,0],["للنّاس إجماعٌ على تفْضِيلهِ","حتى استَوَى اللُّؤماءُ والكُرَماء",37,"ا",2,0],["لِلناسِ عيدٌ عَمَّهُم واحِدٌ","وَصارَ لي عيدانِ في عيدِ",38,"د",1,0],["لِلناسِ حاجاتٌ وَمِنّي الهَوى","يُذكيهِ شَيءٌ بَعدَ أَشياءِ",39,"ا",2,0],["للناس أَرواح تحس وإنما","لَيسَت سوى أَجسادها الأرواح",40,"ح",1,1],["للناس في العفو موت","وَفي القصاص حياةُ",41,"ه",1,0],["للنّبي ّ الإشراق من حسنها","السمح وأرضى منه الخفيّ الدقيقا",42,"ق",2,0],["لِلنَّصْرِ فِيهَا طَلعَةٌ مِنْ طَلْعتٍ","شَهِدَتْ عَوَاقِبُهَا بِصِدْقِ الفَالِ",43,"ل",1,0],["لِلنَّفْسِ فِي غَابَاتِهَا","مَسْرىً يُسَامِي الغَيْبَ بعْدَا",44,"د",2,0],["لِلنصْرِ في أَعْلاَمِهِمْ","صِلَةٌ بِأَبْنَاءِ الْغُمُود",45,"د",1,0],["للنيل شاد بشعره ما لم يشدْ","فرعونُ والهرمان من بنيانه",46,"ن",2,0],["للنَّقع فوقَ جَبينه","مِسْكٌ يُضَمِّخُ كلَّ ظافرْ",47,"ر",1,0],["للناسِ ناحيةٌ تلُمُّ شَتاتَهم","والعبقريُّ له الوجودُ نواحي",48,"ح",2,0],["للناس في الفلك والطاووس موعظة","كلاهما خيرُ ما فيه ذُناباه",49,"ا",2,0],["للنصر جيشٌ في الحروبِ مُزَوَّدٌ","من عزمه الماضي بجيش آخرا",50,"ر",2,0],["للنيل شادَ بشعره لم يَثِد","فرعونُ والهرمان من بُنيانه",51,"ن",2,0],["للنَّاس حاجاتٌ ومنِّي الهوى","......شيءٌ بعد أشياء",52,"ا",2,0],["للنَصرِ فوقَك أقواسٌ نوافذُها","ترمي سويداءَ حُسادٍ وأعداء",53,"ا",2,0],["للنفس حالاتٌ يَلَذُّ لها الأسى","وترى البكاءَ