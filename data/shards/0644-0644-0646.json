{"poems":[[53,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[53,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[55,"تمت وتم الحسن في وجهها","https://www.aldiwan.net/poem26145.html","السريع"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[88,"ناح الحمام وغرد الشحرور","https://www.aldiwan.net/poem44442.html","الكامل"],[37,"للنسوة العاملات والصبية","https://www.aldiwan.net/poem6481.html","المنسرح"],[64,"إن الحبيب الذي يرضيه سفك دمي","https://www.aldiwan.net/poem67547.html","البسيط"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[51,"خجلت خدود الورد من تفضيله","https://www.aldiwan.net/poem10876.html","الكامل"],[51,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[51,"يا عمرو فخرا فقد أعطيت منزلة","https://www.aldiwan.net/poem64656.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"للناس فيما يكلفون مغارم","https://www.aldiwan.net/poem66333.html","الكامل"],[51,"إني أراك بعين لا يراك بها","https://www.aldiwan.net/poem66345.html","البسيط"],[51,"للنرجس الفضل برغم من رغم","https://www.aldiwan.net/poem66369.html","الطويل"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"للناس من شعر تركت جمال","https://www.aldiwan.net/poem44610.html","الكامل"],[85,"للناس في أمثالهم","https://www.aldiwan.net/poem7285.html","مجزوء الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"أقدم فليس على الإقدام ممتنع","https://www.aldiwan.net/poem63762.html","البسيط"],[56,"وغرير يقضي بحكين في الراح","https://www.aldiwan.net/poem58529.html","الخفيف"],[43,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[43,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[45,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[58,"للناس حرص على الدنيا بتدبير","https://www.aldiwan.net/poem31056.html","البسيط"],[49,"للناس في السبق بعد اليوم مضمار","https://www.aldiwan.net/poem62090.html","البسيط"],[31,"أمسى صديقك مما قلت قد غضبوا","https://www.aldiwan.net/poem42630.html","البسيط"],[74,"والشمس شاحبة الجبين مريضة","https://www.aldiwan.net/poem13218.html","الكامل"],[105,"لمن الجلال يفوق كل جلال","https://www.aldiwan.net/poem41929.html","الكامل"],[81,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"بليت بعد شيبه","https://www.aldiwan.net/poem26932.html","مجزوء الرجز"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"يا فرحة جاءت مع العيد","https://www.aldiwan.net/poem62583.html","السريع"],[50,"قد لعب الدهر على هامتي","https://www.aldiwan.net/poem64882.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85770","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85716","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"عرش ينوح","https://www.poetsgate.com/ViewPoem.aspx?id=179684",""],[50,"قَدْ لَعب الدَّهْرُ علَى هامَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=15956",""],[90,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[45,"للنَّاسِ بَدْرانِ لا يَخْفَى طُلُوعُهُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=33083",""],[45,"أَيُّمَا خُلَّةٍ وَوَصْلُ قَدِيمِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31880",""],[51,"للناس عيدٌ ولي عيدانِ في العيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27703",""],[31,"هَاجَ الفُؤَادَ ظَعَائِنٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19108&r=&rc=370",""],[113,"للنبي صاحب البراق نحا","https://www.aldiwan.net/poem42007.html","المديد"],[115,"الشعر","https://www.aldiwan.net/poem24070.html","السريع"],[122,"بالنفس يا شيخ من تقواك أشياء","https://www.aldiwan.net/poem23734.html","البسيط"],[141,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[158,"المشتري الحمد بالإفعال يصلحها","https://www.aldiwan.net/poem59003.html","البسيط"],[158,"سيعيصني في الحب من ولهي به","https://www.aldiwan.net/poem59099.html","الكامل"],[184,"للناس عيد وما لي مثل عيدهم","https://www.aldiwan.net/poem43539.html","البسيط"],[209,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[219,"أدامك الله أيها الطلل","https://www.aldiwan.net/poem55283.html","المنسرح"],[221,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[279,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[347,"بنطق سمعي جرى لساني","https://www.aldiwan.net/poem15963.html","مخلع البسيط"],[362,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[364,"إن كنت تلحاني فلست بحاني","https://www.aldiwan.net/poem17136.html","الكامل"],[369,"لو كان في أن يزور وزر","https://www.aldiwan.net/poem57440.html","مخلع البسيط"],[388,"ياكريم الوجه ضاقت وأنت بالعالم عليم","https://www.aldiwan.net/poem54488.html","عموديه"],[400,"أشغلت بالورقا عن الأوراق","https://www.aldiwan.net/poem33625.html","الكامل"],[402,"إذا توسلت إلى حاجة","https://www.aldiwan.net/poem49614.html","السريع"],[402,"للناس فيما يطلبون وسائل","https://www.aldiwan.net/poem50017.html","الكامل"],[403,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[406,"كل يوم فتح مبين ونصر","https://www.aldiwan.net/poem32222.html","الخفيف"],[429,"يا سيدا لا زلت دا","https://www.aldiwan.net/poem12693.html","مجزوء الكامل"],[429,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[438,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[450,"سعدت مطالعنا بأكرم وافد","https://www.aldiwan.net/poem13710.html","الكامل"],[456,"للنقص من أعمارنا ما يكمل","https://www.aldiwan.net/poem56077.html","الكامل"],[466,"للنشو ألحان لها","https://www.aldiwan.net/poem60500.html","مجزوء الكامل"],[477,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[477,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[513,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[513,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[549,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[560,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[560,"ماذا الوقوف على رسوم المنزل","https://www.aldiwan.net/poem52907.html","الكامل"],[560,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[565,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[565,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"]],"verses":[["لِلنَإِباتِ مِنَ الرِجالِ جَريئُها","يَومَ اللِقاءِ وَلِلعَظيمِ عَظيمُها",0,"م",3,0],["لِلنَفسِ أَن تَبعَثَ العَزائِمَ وَال","رَأيَ وَكُلُّ الفِعالِ لِلجَسَدِ",1,"د",1,0],["لِلناسِ في الشَهرِ هِلالٌ وَلي","في وَجهِها كُلَّ صَباحٍ هِلال",2,"ل",1,0],["لِلنيلِ مَجدٌ في الزَمانِ مُؤَثَّلٌ","مِن عَهدِ آمونٍ وَعَهدِ فَتاحِ",3,"ح",1,0],["لِلنَّدَى مَوْقِعُ النَّدَى فَإِذَا لَمْ","تَصْلُحِ الأَرْضُ فَالْجَنيَ لا يُرَامُ",4,"م",1,0],["لِلنَّبِيِّينَ مَعْشَرٌ كَفَلُوهَمْ","وَالنَّبِيُّونَ قُصَّرٌ أَيْتَامُ",4,"م",1,0],["لِلنَّفْسِ مِنْهَا نَشْوَةٌ غيْرُ الَّتي","فِي الحِسِّ يُحْدِثُهَا طِلاً وَنَدِيمُ",5,"م",1,0],["للنار فيك حسيس كنت أحسبه","صحكاً على مَن بسوء الرأي أبكانا",6,"ن",2,0],["للنرجس المطلول ترنو أعين","فيها وتبسم للأقاح ثغور",7,"ر",1,0],["للنسوة العاملات والصبية ال","مزمن عنهم ما كان يكتسب",8,"ب",1,1],["لِلناسِ حَجٌّ وَلي حَجٌّ إلى سَكَني","تُهدي الأَضاحي وَأُهدي مُهجَتي وَدَمي",9,"ي",1,0],["للناس عِيدٌ وَلي عِيدانِ في العِيدِ","إذا رأيْتُكَ يا ابن السَّادَةِ الصِّيدِ",10,"د",1,1],["للنرجس الفضلُ المبينُ وإن أبى","آبٍ وحاد عن الطريقة حائدُ",11,"د",1,0],["لَلْنجم أقربُ منهمُ","من كف ملتمسٍ ولمسه",12,"س",2,0],["للناس فيلٌ إمامُ الناس مالكُهُ","وأنت يا عمرو فيل الله لا الناس",13,"س",1,0],["للندى والردى مواطنُ كُرهٍ","لا يُصاليه حرَّهنَّ مُصالِ",14,"ل",1,0],["للناس فيما يكْلَفُونَ مغارمٌ","عند الكرامِ لها قضاءُ ذِمامِ",15,"م",1,1],["للناس في كل سر من أسِرَّتها","وادٍ ترفُّ على أرجائه النِّعم",16,"م",1,0],["للنَّرْجس الفضلُ برغْم من رغَمْ","على صُنوف الوَرْد والفضْلُ قِسَمْ",17,"م",1,1],["للنَّسيمِ الَّذي يضمِّخُ أَحلا","مي بعِطْرِ الأَقاحِ واللَّيمونِ",18,"ن",1,0],["للناس من شعر تركت جمال","تشدو به من بعدك الأجيال",19,"ل",1,1],["للناس في أمثالهم","حِكم لحافظها مفيده",20,"ه",1,1],["لِلناسِ مِن أَسرارِهِ ما عُلِّموا","وَلِشُعبَةِ الكَهَنوتِ ما هُوَ أَعمَقُ",21,"ق",1,0],["لِلناسِ في كُلِّ يَومٍ مِن عَجائِبِهِ","ما لَم يَكُن لِاِمرِئٍ في خاطِرٍ يَقَعُ",22,"ع",1,0],["للنّقَا رِدْفُهُ وللخُوطِ ما حُمِّ","لَ لِيناً وجِيدُهُ للغَزَالِ",23,"ل",1,0],["لِلنَدى الغَلبُ إِنَّهُ فاضَ وَالشِع","رُ عِمادي وَاِبنُ العَميدِ عِمادُه",24,"د",2,0],["لِلناظِرينَ إِلى إِقبالِهِ فَرَحٌ","يُزيلُ ما بِجِباهِ القَومِ مِن غَضَنِ",25,"ن",1,0],["لِلنَدى عاشِقٍ وَبِالمَجدِ صَبٍّ","مُستَهامٍ وَلِلسَماحِ خَليلِ",26,"ل",1,0],["لِلنَدى الأَوَّلِ الأَخيرِ الَّذي بَرَّ","زَ وَالسُؤدُدِ الحَديثِ المُقيمِ",27,"م",1,0],["لِلنّاسِ حِرصٌ عَلى الدُنيا بِتَدبيرِ","وَصَفوُها لَكَ مَمزوجٌ بَتَكديرِ",28,"ر",1,1],["لِلناسِ في السَبقِ بَعدَ اليَومِ مِضمارُ","وَالمُنتَهى جَنَّةٌ لا بُدَّ أَو نارُ",29,"ر",1,1],["لِلناسِ فَضلُكِ في حُسنِ الصَفاءِ وَفي","صِدقِ الحَديثِ وَشَرُّ الخُلَّةِ الكَذِبُ",30,"ب",1,0],["لِلناسِ فيهِ مِنَ الكَلامِ شَواهِدٌ","وَبِمَضرَبِ السَيفِ الجُرازِ فُلولُ",31,"ل",1,0],["للناهِضَاتِ الذاَّئِداتِ عنِ الحِمَى","الحامِلاتِ فَوادِحَ الأثقالِ",32,"ل",1,0],["لِلنَفعِ وَالضُرِّ عِندَهُ شِيَمٌ","أَمَرَّ فيها لِطاعِمٍ وَحَلا",33,"ل",2,0],["لِلناسِ إِن رَكِبوا نَهجَ الفَخارِ بُنَيّ","اتِ الطَريقِ وَلِاِبنِ الجَدِّ مَهيَعُهُ",34,"ع",2,0],["لِلنَتفِ فيهِ أَثَرٌ","كَأَثَرِ التَخريزِ",35,"ز",1,0],["للناسِ فيها وابلٌ وصواعقٌ","نَفْسٌ بها تَحْيا ونَفسٌ تَعْطَبُ",36,"ب",1,0],["للنّاس إجماعٌ على تفْضِيلهِ","حتى استَوَى اللُّؤماءُ والكُرَماء",37,"ا",2,0],["لِلناسِ عيدٌ عَمَّهُم واحِدٌ","وَصارَ لي عيدانِ في عيدِ",38,"د",1,0],["لِلناسِ حاجاتٌ وَمِنّي الهَوى","يُذكيهِ شَيءٌ بَعدَ أَشياءِ",39,"ا",2,0],["للناس أَرواح تحس وإنما","لَيسَت سوى أَجسادها الأرواح",40,"ح",1,1],["للناس في العفو موت","وَفي القصاص حياةُ",41,"ه",1,0],["لِلنَّصْرِ فِيهَا طَلعَةٌ مِنْ طَلْعتٍ","شَهِدَتْ عَوَاقِبُهَا بِصِدْقِ الفَالِ",42,"ل",1,0],["لِلنَّفْسِ فِي غَابَاتِهَا","مَسْرىً يُسَامِي الغَيْبَ بعْدَا",43,"د",2,0],["لِلنصْرِ في أَعْلاَمِهِمْ","صِلَةٌ بِأَبْنَاءِ الْغُمُود",44,"د",1,0],["للنيل شاد بشعره ما لم يشدْ","فرعونُ والهرمان من بنيانه",45,"ن",2,0],["للنَّقع فوقَ جَبينه","مِسْكٌ يُضَمِّخُ كلَّ ظافرْ",46,"ر",1,0],["للناسِ ناحيةٌ تلُمُّ شَتاتَهم","والعبقريُّ له الوجودُ نواحي",47,"ح",2,0],["للناس في الفلك والطاووس موعظة","كلاهما خيرُ ما فيه ذُناباه",48,"ا",2,0],["للنصر جيشٌ في الحروبِ مُزَوَّدٌ","من عزمه الماضي بجيش آخرا",49,"ر",2,0],["للنيل شادَ بشعره لم يَثِد","فرعونُ والهرمان من بُنيانه",50,"ن",2,0],["للنَّاس حاجاتٌ ومنِّي الهوى","......شيءٌ بعد أشياء",51,"ا",2,0],["للنَصرِ فوقَك أقواسٌ نوافذُها","ترمي سويداءَ حُسادٍ وأعداء",52,"ا",2,0],["للنفس حالاتٌ يَلَذُّ لها الأسى","وترى البكاءَ كواجبٍ مشروع",53,"ع",1,0],["للناس بعد اليَومِ مِيلادُ الفَتى","ومَماتُه ، ورَضاعةٌ وفِطام",54,"م",1,0],["للناس كان .. وإن أبت لبنان","\" فأمين \" ليس لها ولا \" جبران \"",55,"ن",1,0],["للنَّاسِ بَدْرانِ لا يَخْفَى طُلُوعُهُمَا","بدْرُ السَّماءِ،وبَدْرُ الأَرْضِ إِسْحَاقُ",56,"ق",1,1],["للنّدَى الأوّلِ الأخيرِ الذي بَرّز","َ وَالسُّؤْدُدِ الحَديثِ القَدِيمِ",57,"م",1,0],["للناس عيدٌ ولي عيدانِ في العيدِ","إذا رأيتُكَ يابن السَّادَة ِ الصَّيدِ",58,"د",1,1],["لُ لَنَا هَوًى أُخْرَى المَنُونِ","نِ وَمَا يَمُرُّ مِنْ السِّنِينِ",59,"ن",1,0],["للنبي صاحب البراق نحا","ركب فكر قام بالأمل",60,"ل",1,1],["للنّاسِ والعالَمِ شَطْرُ الجَوَى","ولي، أنا وحدي إذًا شَطْرُهُ",61,"ر",2,0],["للناس بالكاس آراء فوا عجبا","أليس للكأس بالأنسان آراء",62,"ا",2,0],["لِلناصِرِ بنِ الناصِرِ الشَرَفُ الَّذي","ما شَمسُهُ مَحجوبَةٌ بِضَبابِ",63,"ب",1,0],["للناس في الناس إخوان تكثرهم","يا فوز من يك دون الناس قد كثرا",64,"ر",2,0],["للنجح في سعيي إليه إمارة","انى أرى يومي به يومي به",65,"ب",2,0],["للناس عيدٌ وما لي مثل عيدهم","وأيّ عيد لشيخ أحنف خلق",66,"ق",1,1],["للناس عيد ولى عيد وأعياد","إني متى شئت للأعياد صيّاد",67,"د",1,0],["للنهى والصلاح فيك وللجو","د وللعز تلتقي سبل",68,"ل",1,0],["لِلنّورِ في كُلِّ مَجرىً مِنهُ مِصقَلَةٌ","وَكُلِّ مُنعَطَفٍ لِلحُبِّ ثَديانِ",69,"ن",1,0],["للناس من دهرهم انجاز موعدهم","ووعده في انتظام الشمل ممطول",70,"ل",1,0],["لِلناسِ عَن مَشهَدي مَغيبٌ","أَضَلَّهُم عَن هُدى بَياني",71,"ن",2,0],["للنّاظِرِين إلى عَليائه وإلى","عُلْيا بني الدّهرِ إكبارٌ وإصغار",72,"ر",1,0],["لِلناسِ أَغصانٌ وَقَد يَجنونَها","وَعَلِقتُ غُصناً دونَها وَجَناني",73,"ي",1,0],["للناسِ في طَرفِه وقَلبي","تعجُّبٌ دائمٌ وفِكرُ",74,"ر",1,0],["للنبي الهادي الكريم ولك الحمد الهي","عد ماطش الرذيم",75,"م",1,0],["للناس خلف في سيادة غيره","وعلى سيادته أذعنوا بوفاق",76,"ق",1,0],["لِلنَّاسِ في أخراهُمُ جَنَّةٌ","وجَنَّةُ الدُّنْيا سَمَرْقَنْدُ",77,"د",1,0],["للنَّاس فيما يَطلبونَ وَسائلٌ","شتَّى فُمكْدٍ مِنهُمُ أو مُنجِحُ",78,"ح",1,1],["لِلنَّقعِ فيهِ وَلِلجوارِحِ فَوقَهُ","سِترانِ أَدكَن ذا وَذاكَ مُحَبَّرُ",79,"ر",1,0],["للنّدى مالكُ المباحُ وما ما","لُكَ إلاّ جُرْدٌ وبِيضٌ وسُمْرُ",80,"ر",1,0],["للناس شرع في الهدا","يا قد أردتُ سلوكه",81,"ك",2,0],["للناسِ في كلّ قطرٍ لم تحُلّ به","عيدٌ وللناسِ في ذا القطرِ عيدان",82,"ن",1,0],["للنفخة الأخرى التي قامت بها","من رمسها أمواتها غفالها",83,"ل",3,0],["للنفس تخلية ويعقب بعدها","للّه تحلية بأنفس عائد",84,"د",1,0],["للنقص من أعمارنا ما يَكملُ","والدهر يؤيسُنا ونحن نؤمِّلُ",85,"ل",1,1],["لِلنَشوِ أَلحانٌ لَها","ثِقَلٌ عَلى قَلبِ الغِناءِ",86,"ا",2,1],["للناس فيه سعود","ومهبط وصعود",87,"د",1,0],["للنحل أوحى والقريض كشهده","للفحل في الشعرا شفاء غليله",88,"ل",2,0],["للناصر بن الصالح الشرف الذي","فاقت به مصر على الآفاق",89,"ق",1,0],["للناصر بن الصالح الشرف الذي","طالت ذوائبه السماك الأعزلا",90,"ل",2,0],["للنّازلين محلُّ القاطنين به","والأقربون لأضيافِ القِرى خَدَمُ",91,"م",1,0],["للنَّاسِ منهُ كلَّ يومٍ بَهجةٌ","في المَكرُماتِ فكلَّ يومٍ عيدُ",92,"د",1,0],["للناسِ أيامٌ تَمُرُّ كأنَّها","خَيلُ البَريدِ مُغيرةً في الهَوجَلِ",93,"ل",1,0],["للنَّاس في ما يعشَقُونَ مذاهبٌ","يَذهبْنَ بينَ ميَامِنٍ وميَاسِرِ",94,"ر",1,0],["لِلنَّبْتِ تَحْتَ النَّدَى اضْطِجَاعٌ","وَلِلنَّدَى فَوْقَهُ اضْطِجَاعُ",95,"ع",1,0],["لِلنَّاسِ فِيْهِمْ مَنَافِعٌ وَلَهُمْ","مَنَافِعٌ فِي الأَنَامِ مُشْتَهَرَهْ",96,"ر",2,0],["للناس بد منه في الدهور","قيل له فأنت بالأمور",97,"ر",1,0],["للنقض والتكذيب من جهات","لم نر من يحكي من الروات",97,"ت",1,0],["للناس أَشغالٌ ولكنكم","وحقِّكم دونَ الأَنامِ شُغْلي",98,"ي",1,0]]}