{"poems":[[55,"في كل يوم مودات مطلقة","https://www.aldiwan.net/poem30416.html","البسيط"],[88,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[53,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[53,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[68,"يا قضيبا ذوى وكان نضيرا","https://www.aldiwan.net/poem40295.html","الخفيف"],[107,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[104,"عبس الخطب فابتسم","https://www.aldiwan.net/poem32984.html","مجزوء الخفيف"],[50,"قد كاد هذا الفخ أن يعقرا","https://www.aldiwan.net/poem63416.html","السريع"],[50,"هل لديار حييتها درس","https://www.aldiwan.net/poem64333.html","المنسرح"],[52,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[52,"غيب جيرانه بذي حمد","https://www.aldiwan.net/poem63926.html","الطويل"],[48,"ليس اغتنام الصديق شأني","https://www.aldiwan.net/poem23400.html","مجزوء البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20991","السريع"],[22,"مَاذَا تقول لأِفْراخٍ بذي مَرَخٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19752",""],[96,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=15628",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[119,"يا قبر أيوب الذي نوره","https://www.aldiwan.net/poem41088.html","عموديه"],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[139,"أكذا آخر الحياة يكون","https://www.aldiwan.net/poem49161.html","الخفيف"],[190,"عاتبوني على انفرادي والوحدة","https://www.aldiwan.net/poem44155.html","الخفيف"],[231,"الانتظار الخالد","https://www.aldiwan.net/poem24230.html","عموديه"],[264,"أسعفي يا ذات ربي بالمنى","https://www.aldiwan.net/poem35956.html","الرمل"],[333,"ابن عمي مات فامضوا","https://www.aldiwan.net/poem54961.html","مجزوء الرمل"],[354,"أمرتني بستر كشف غطائي","https://www.aldiwan.net/poem15499.html","الخفيف"],[453,"غيبوا في الترب عني شخصها","https://www.aldiwan.net/poem53734.html","الكامل"],[520,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[520,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[563,"غيم الحوادث حال دون البازغ","https://www.aldiwan.net/poem33541.html","الكامل"],[563,"إني أنا المعني القديم","https://www.aldiwan.net/poem34081.html","مجزوء الكامل"],[563,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[563,"إن الغني إلى المولى من افتقرا","https://www.aldiwan.net/poem34492.html","البسيط"],[563,"ونحن أهل الصفا لا نقبل الكدرا","https://www.aldiwan.net/poem34494.html","البسيط"],[563,"قد صرت كلي قلوبا فيه تحتار","https://www.aldiwan.net/poem34523.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2445","الخفيف"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53832","البسيط"],[1583,"","https://poetry.dctabudhabi.ae/diwan/poem/142521","الرجز"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107029","الرجز"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139317",""],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42425","المواليا"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42477","المواليا"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110651","الخفيف"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45576","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137041",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58360","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204967","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114584","البسيط"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139404",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90962","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73120","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147301","الرمل"],[4555,"","https://poetry.dctabudhabi.ae/diwan/poem/105554","الخفيف"],[4690,"أنا لا أراك","https://www.poetsgate.com/ViewPoem.aspx?id=120303",""],[4723,"رثاء المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=61753",""],[4797,"غالي وبخيل","https://www.poetsgate.com/ViewPoem.aspx?id=50248",""],[4924,"غيبوبتي طالت","https://www.poetsgate.com/ViewPoem.aspx?id=19696",""],[4929,"ليت ناعيك","https://www.poetsgate.com/ViewPoem.aspx?id=207549",""],[5041,"إنَّما العارُ أنْ يَهونَ السِّلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=24394",""],[5061,"محمد بن الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=147169",""],[5064,"في تُربة القلق","https://www.poetsgate.com/ViewPoem.aspx?id=199151",""],[5074,"الشراع التائه","https://www.poetsgate.com/ViewPoem.aspx?id=157884",""],[5111,"امْرَأةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212644",""],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""],[4045,"غيبة لم تطل عليّ وماذا","https://www.poetsgate.com/ViewPoem.aspx?id=200270",""],[5259,"يا نازح الدار لم يجعل من نزحت","https://www.poetsgate.com/ViewPoem.aspx?id=186802",""],[5449,"عيناكِ تشرين الكآبة","https://www.poetsgate.com/ViewPoem.aspx?id=189122",""],[5525,"عقد وسوار","https://www.poetsgate.com/ViewPoem.aspx?id=965",""],[2110,"غاض صبري والهوى قد بلغا","https://www.poetsgate.com/ViewPoem.aspx?id=156281",""],[5652,"المجامل بالمدايح لي رياء","https://www.poetsgate.com/ViewPoem.aspx?id=198329",""],[5691,"حكومة الوفاق...!","https://www.poetsgate.com/ViewPoem.aspx?id=206342",""],[5691,"سراب المصالحة","https://www.poetsgate.com/ViewPoem.aspx?id=206735",""],[5732,"يافيصل اودعك توديع من غاب","https://www.poetsgate.com/ViewPoem.aspx?id=177857",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5848,"ثروة وثورة","https://www.poetsgate.com/ViewPoem.aspx?id=53369",""],[5848,"قولو لها تدخل شظايا","https://www.poetsgate.com/ViewPoem.aspx?id=52022",""],[5848,"تلعثم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=53100",""],[5848,"كيف اكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=53095",""],[5848,"أحد ينام وحط راسه","https://www.poetsgate.com/ViewPoem.aspx?id=48835",""],[5956,"خالٍ من الحاجات","https://www.poetsgate.com/ViewPoem.aspx?id=184466",""],[6068,"عيناك من عين المها -13-","https://www.poetsgate.com/ViewPoem.aspx?id=175846",""],[6075,"أجمل الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=210327",""],[6152,"أبي الغالي رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=204709",""],[6152,"غيبي كما شئتِ","https://www.poetsgate.com/ViewPoem.aspx?id=205869",""],[6345,"ياليته ما كان ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78669&r=&rc=40",""]],"verses":[["غَيبُ الرِجالِ ظُنونٌ قَبلَ مَبحَثِهِ","فَما طِلابُكَ أَن تَلقاهُ مَوفورا",0,"ر",2,0],["غَيَّبتَ شُكري وَهوَ نابِهُ عَصرِهِ","وَأَصَبتَ إِبراهيمَ وَهوَ إِمامُ",1,"م",1,0],["غَيْبتُهُ سَرْمَدٌ وخيبتُهُ","لا تنقضي أو يَغوله عطبُهْ",2,"ب",2,0],["غيب عن عينه مُغافصةٌ","أفضلُ ما اعتدَّه لفاتقها",3,"ق",3,0],["غَيَّبَت باريسُ ذُخراً وَمَضى","تُربُها القَيِّمُ بِالحِرزِ الحَصين",4,"ن",1,0],["غَيَّبَتهُ الأَرضونَ عَنّا وَما خِل","تُ أَديمَ التُرابِ يَحوي البُدورا",5,"ر",2,0],["غُيِّبوا في حُفرَةٍ مَسجورةٍ","تَخمدُ الدنيا وتَزدادُ اتّقادا",6,"د",2,0],["غيَّبتْهُ أم القُننْ","لا تقلْ أين جسمهُ",7,"ه",1,0],["غَيَّبتُ بِالتُربِ عَلَيهِ لَهُ","بِالمُستَوى خَشيَةَ أَن يَنفِرا",8,"ر",2,0],["غُيِّبَ عَنهُنَّ سَكنُهُنَّ فَما","بِهِنَّ مِن جِنَّةٍ وَلا أَنَسِ",9,"س",1,0],["غَيَّبَت وُدّاً فَلَمّا غُيِّبَت","أَسَرَت نَومي وَأَبقَت سُهُدا",10,"د",2,0],["غَيَّبَ جيرانُهُ بِذي حَمَدِ","عَن لَيلِ مَن لَم يَنَم وَلَم يَكَدِ",11,"د",1,1],["غُيِّبَ مَيتٌ فَما رَأَتهُ","عَينٌ سِوى رُؤيَةِ المَنامِ",12,"م",1,0],["غُيِّبتَ عَنِّي عَبدُ في ساعَةِ الشَّ","رِّ وجُنِّبتَ ذَواتَ العَويص",13,"ص",1,0],["غَيَّبْتَ كَاسِبَهُمْ في قَعْرِ مُظْلِمَة","ٍ فاغْفِرْ عَلَيْكَ سلامُ اللّه ياعُمَرُ",14,"ر",1,0],["غيب لحبّك من نعمى اليقين به","كأنّني كاشف عن سرّه الحجبا",15,"ب",2,0],["غيّب الدّهر من سيوف نعدّ","مشرفيّا حمى وزان معدّا",16,"د",2,0],["غيبت عن عيني وطول المدى","عن عين قلبي فغير مستور",17,"ر",1,0],["غيَّبتِ رأسك كالنَّعام","في رمل قلبي تَحفرين",18,"ن",1,0],["غيّبتْ في التراب شمس المعالي","فاعترى الأفقَ لوعةٌ وشجونُ",19,"ن",1,0],["غيب الموت من أحب وأهوى","من ذوي المكرمات تحت التراب",20,"ب",1,0],["غيبي إذن أو فاحضري","أنا قانع في كل حال !",21,"ل",1,0],["غيّبيني في تجلّي الذات كي","لا أرى أنّي وأدري من أنا",22,"ن",2,0],["غيّبَ الترب سناه","وهو في أعيننا",23,"ن",2,0],["غَيَّبَتني مِن بَعدِما أَشهَدَتني","وَأَعادَت شَهادَتي بِنَداءِ",24,"ا",2,0],["غيّبوا في الترب عنّي شخصها","فدموعى رسل عينى فى ثراها",25,"ا",3,1],["غيبوا شخصها فغاب صوابي","وبهائي ومهجتي وجناني",26,"ن",2,0],["غيبوه عن ناظري وضميري","هو فيه مصور للعيان",27,"ن",1,0],["غيب الغيوب تنزلت أسراره","فشجت قلوب بلابلٍ ولغالغ",28,"غ",1,0],["غيب الغيوب تنزهت","عما القلوب به تهيم",29,"م",1,0],["غيب من الغيب يستبين بنا","ونحن في روضه شحاريره",30,"ر",2,0],["غيب الغيوب بأسرار القلوب له","معاملات توالت تتبع القدرا",31,"ر",2,0],["غيب عن العقل حق والسوى عدم","فحقق الأمر واترك كل ما خطرا",32,"ر",2,0],["غيب تحجب في الأكوان فهو بها","نور ونار ولا نور ولا نار",33,"ر",1,0],["غُيِّبوا عَن مَواطِنٍ مُفظِعاتٍ","لَيسَ فيها إِلا السُيوفَ رَخاءُ",34,"ا",2,0],["غيَّبت عنها فلم تعرف لها خبرا","لهفي عليك وويلي يا أبا سلمهْ",35,"م",2,0],["غيبي، فلا أَحفل بعد اليوم","أَو أَصطبر",36,"ر",1,0],["غيب الغيوب سر سر ذاته","وعالم الاسماء من صفاته",37,"ه",1,0],["غيبوا في الصعيد حزماً وعزماً","ولزازَ الخَصم الألدِّ العنيد",38,"د",1,0],["غيَّبْ أنانيك في يمِّ الغِنى والفقر","واطرحْ دعاويكَ في تيارِ ذاكَ البحر",39,"ر",1,1],["غيبتني فيكَ حتى صار كُلي محو","والعمرُ مني مضى ما بين سكرٍ وصَحو",40,"و",1,1],["غيب اللحد منك طلعة بدر","منه شمس الضحى استمدت سناها",41,"ا",3,0],["غَيَبنَ عَنها خِتلة أَخواتِها","عِندَ النَشيد فَما لَها أَخوات",42,"ت",1,0],["غيبته دار السعادة عنا","ولنا الحظ بالسرور اعاده",43,"د",2,0],["غَيّبتني عَلَيَّ ما أطمَعَتني","فأنا اليومَ مُفْكِرٌ في انتظاري",44,"ر",2,0],["غيبة لحظة وتهمي سماء","حفلت وأبلا وزادت عطاءا",45,"ا",3,0],["غيّبوا طلعة شمس","عدُموا منها المثيلا",46,"ل",2,0],["غيَّب الماء شخصه وسقاه","كاس موت فماله من مجيرْ",47,"ر",1,0],["غيب بفضلكَ كُلَّ الخلقِ عن نظَري","حتّضى أراكَ ولا أراهُمُ شَيا",48,"ي",2,0],["غيب الأناةِ وإن سرت عواقبها","أن لا خلودَ وأن ليس الفتى حجرا",49,"ر",2,1],["غيبت ذلك المحيا الذي كا","ن بمجلي جماله بستضاء",50,"ا",2,0],["غيَّبوا في هوادجِ العيسِ بدراً","كالحُميَّا ريقاً وخداً وجفنا",51,"ن",2,0],["غيب الصمت عن الصمت فضلت","غمغماتٌ في متاهات الهجير",52,"ر",1,0],["غيب النيران حين توارى","نورها بالثرى وعز الضياء",53,"ا",2,0],["غِيبِي فَحَرْفِي صَارِمٌ","وَ الشِّعْرُ يَحْرِقُ إِنْ هَجَاكِ",54,"ك",1,0],["غيّبتَ يا موتُ أحبابي فواحَزَني!","والدمعُ مِن ْ مُقلةِ الأيام ِ قدْ هطلا",55,"ل",2,0],["غيبتك لوهي دقيقة تعتبر صده","الوقت من دونك سجن وغيابك اسياجه",56,"ج",2,1],["غيبوبتي طالت وحلم العمر طاف","وهمّ التعاسة في مكاني رماني",57,"ن",2,1],["غيَّب الموت للمكارم نهراً","فيك جمَّ العطاء والجريان",58,"ن",1,0],["غَيَّبَ اللهُ أُمَّةً لم يَرُعْها","كَفُّ طِفلٍ يُسَنُّ فيها السِّلاحُ!",59,"ح",1,0],["غيبته ماهي شي عادي وننساه","غيبته طعنه داخل الصدر تاذيه",60,"ي",2,0],["غيبُوبَةٌ حُبُّ مَنْ أهوَى فمُذْ غَرِقَتْ","رُوحِي بأنحائِهَا والكَونُ لَمْ يُفقِ",61,"ق",1,0],["غِيْبِيْ فَمَا أَجْمَلَ الآفَاقَ شِاحِبَةً","وَ الدَّارَ عَنْهَا إِذَا سُكَّانها ظَعَنُوا",62,"ن",3,0],["غِيْبِيْ فَبَعْدَكِ لَا رَوْضٌ لَهُ أَلَقٌ","وَ لَا سَقَى الوَرْدَ ذَاكَ العَارِضُ الهَتِنُ",62,"ن",1,0],["غَيْبُوبَةٌ فِيِ دَمِيْ تَنْمُو عَلَى جَسِدِيْ","مِنْ حَرِّهَا عَقَرُ الأيَّامِ يُسْقِيْنِيْ",63,"ن",2,0],["غَيِّب وُجودَكَ في شُهودِ وُجودِهِ","تلقاكَ من عِزِّ العَزيزِ فرَادِسُ",64,"س",1,0],["غيبة لم تطل عليّ وماذا","خير قرب المطرمذ الملاذ",65,"ذ",1,0],["غيبت شخصك عن عيني فما ألفيت","من بعد مرآك غير الدمع والسهر",66,"ر",1,0],["غِيبي بغيِّك وازدري بقصائدي","وحدي أتاكِ وبالقصيدِ رسائلا",67,"ل",2,0],["غيبي وشيبي وإتركي كل ما صار","يبقى جمالك في قصيدي طرايف",68,"ف",1,0],["غيب الوجد صوابي ويحه","ما الذي حاول مني وابتغى",69,"غ",2,0],["غِيبة اهروجٍ سمت ف الأغبياء","ماعرفنا .. منّهمْ .. واحد ..