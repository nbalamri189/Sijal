{"poems":[[53,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[47,"مَنْ قَائلٌ للزّمَانِ ما أرَبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31692",""],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199599","المسحوب"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216544",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129409","الطويل"]],"verses":[["تاح ابنُ بوران لي الوغدُ الأركْ","بؤساً له في أيِّما فتكٍ فتكْ",0,"ك",1,0],["تَاحَتْ لِمِصْرٍ أُخْتُهَا قَبْلَهَا","بِأَيِّ أُخْتٍ بَعْدَهَا تَظْفَرُ",1,"ر",1,0],["تَاحَ لَهَا وَادِعاً، تَمَهُّلُهُ،","في مُرْهِقِ الأمْرِ، وَاسعاً لَبَبُهْ",2,"ب",2,0],["تاحوا عليج اقفايه","لي يزرقون ارماح",3,"ح",1,0],["تاح الحلل كِلّها وْلِبَسْ بَس","جِلْبابْ تِخْضَعْ لِهْ الجلابيب",4,"ب",1,0],["تاحى مكارم محمود فتحسبه","أعطى عليها عهوداً بعد أن حلفا",5,"ف",2,0]]}