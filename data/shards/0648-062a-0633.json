وَهِمَّةً","وَيَهوي هُويُّ الأَرضِ وَهوَ ذَليلُ",0,"ل",1,0],["وَتَسلُبُني أَيدي النَوائِبِ ثَروَتي","وَلي مِن عَفافي وَالتَقَنُّعِ مالُ",1,"ل",1,0],["وَتَسَلَّموها غَضَةً فَمَضى بِها","الأَبرارُ ناشِزَةً عَنِ الأَرجاسِ",2,"س",1,0],["وَتَسوفُ أَفواهُ المُلوكِ أَكُفَّهُم","سَوفَ السَوامِ رَبيعَ رَوضٍ باكِرِ",3,"ر",1,0],["وَتَستَرعِفُ الأَفاقُ لَمعَ صَفائِها","بِمُغبَرَّةٍ تَمحو سُطورَ الهَواجِرِ",4,"ر",1,0],["وَتَستَنيرُ لَكَ الأَيّامُ مُلهِيَةً","يُنمى بِها كُلُّ إِصباحٍ إِلى عيدِ",5,"د",1,0],["وَتَسمَعُ بي وَقَد أَعلَنتُ أَمري","فَتَعلَمُ أَنَّ دَأبَكَ غَيرُ دابي",6,"ي",1,0],["وَتُسفِرُ أَحسابُنا بَينَنا","فَنُلقي طَوائِلَنا أَو نَهَب",7,"ب",1,0],["وَتَسَلَّ عَن سَيفٍ طَبَعتَ غِرارَهُ","وَأَعرتَ شَفرَتَهُ سَناً وَمَضاءَ",8,"ا",2,0],["وَتَستَريحُ المَطايا مِن تَوَقُّصِها","إِذا فَلَتْ لِمَمَ الحَوذانِ بِالثَفَنِ",9,"ن",1,0],["وتُسْحِبُني ذَيلَ الخَصاصةِ والعُلا","تُحَمِّلُني عِبْءَ السّيادةِ مُعْدِما",10,"م",2,0],["وتَسْمو إِلى شأوٍ ثَنى كُلَّ طالِبٍ","على ظَلَعٍ يَمْشي وقد كان مِرْجَما",10,"م",2,0],["وتَسطو كما يعْتَنُّ في جَرَيانِهِ","أتيٌّ إذا ما رُدَّ رَيْعانُهُ طَغى",11,"غ",2,0],["وتَسْبِقُ خُوصاً لَو مَرَرْنَ على القَطا","لمَا رِيعَ بالتَّسْهيد وهْوَ مُهَوِّمُ",12,"م",1,0],["وتُسري في ضَميرِ اللَّيلِ سِرّاً","وتَخْطِرُ في جَواشِنهِ خَيالا",13,"ل",2,0],["وتَستَرجِعُ الأَيّامُ ما وَهَبَتكُمُ","وَمِن عادَةِ الأَيّامِ تَستَرجِعُ القَرضا",14,"ض",2,0],["وتُسْتَعْمَلُ الأمْثالُ في الدّهْرِ منْكُما","بخَيْرِ مَزورٍ أو بأغْبَطِ زائِرِ",15,"ر",1,0],["وتسرْبَلَ الرَّيْحانُ حُلّة سُنْدُسٍ","رقَمتْ جَنوبَ جُيوبِها أزْهارُهُ",16,"ر",2,0],["وَتَسيرُ نَفسٌ فَوقَ لِح","يَتِها وَلَيسَ لَها إِحارَه",17,"ر",2,0],["وَتَسخُنُ لَيلَةَ لا يَستَطيعُ","نُباحاً بِها الكَلبُ إِلّا هَريرا",18,"ر",2,0],["وَتَستَيقِنوا أَنّا أَخوكُم وَأَنَّنا","إِذا سَنَحَت شَهباءُ تَخشَونَ فالَها",19,"ل",3,0],["وَتُسمَعُ فيها هَبي وَاِقدَمي","وَمَرسونُ خَيلٍ وَأَعطالُها",20,"ل",3,0],["وَتَسابَقَت فيهِ النُعاةُ فَطائِرٌ","بِالكَهرَباءِ وَطائِرٌ بِبُخارِ",21,"ر",1,0],["وَتُسِفُّ آوِنَةً وَآ","وِنَةً يَحيدُ بِها اِزوِرار",22,"ر",1,0],["وَتَسَلَّقَ الأَجواءَ مُم","تَطِياً عَواصِفَها وَسار",22,"ر",1,0],["وَتَسوقُ البِحارُ رَدّاً عَلَيها","جَيشَ مَوجٍ نائي الجَناحَينِ داني",23,"ن",2,0],["وَتَسَمَّعتُ عَلَّني أُطفِئُ الشَو","قَ وَأَروي مِنَ الفُؤادِ الأَواما",24,"م",2,0],["وَتَسابَقوا لِلباقِياتِ وَأَظهِروا","لِلعالَمينَ دَفائِنَ الأَذهانِ",25,"ن",1,0],["وَتَسري الصَبا في جانِبَيهِ عَليلَةً","كَما فُتِقَت مِن حَضرَمِيٍّ عِيابُهُ",26,"ب",2,0],["وَتَستَفرِغانِ الدَمعَ أَو تَذرِيانِهِ","عَلى ذي النَدى وَالجودِ وَالسَيِّدِ الغَمرِ",27,"ر",1,0],["وَتَسعى حينَ تَشتَجِرُ العَوالي","بِكَأسِ المَوتِ ساعَةَ مُصطَلاها",28,"ا",3,0],["وَتُسَمَّى عُلَيَّةٌ","حَبَّذَا الاسْمُ وَاللَّقَبْ",29,"ب",1,0],["وَتُسْعِدُنِي السَّوَانِحُ فِي وَفَائِي","لإِخْوَانِي الكِرَامِ وَذَاكَ شَانِي",30,"ي",1,0],["وَتُسِيلُ الأَنْهَارُ فِيهَا بِعَذْبٍ","مِنْ لِطَافِ النِّطَافِ أَوْ بِحَمِيمِ",31,"م",1,0],["وَتَسِيرُ فِي إرْشَادِهِ سَيْرَ الهُدَى","وَبِرَأْيِهَا يَتَصَرَّفُ الحُكَّامُ",32,"م",1,0],["وَتَسْمَعُ لِلسَّلاسَةِ فِيهِ جَرْساً","كَغُنَّةِ صَوتِهِ السَّلِسِ الرَّخِيمِ",33,"م",1,0],["وَتَسْتَدْنِي الجِنَانَ مُنوَّراتٍ","تَفُوحُ بِهِنَّ أعْرَافُ النَّعِيمِ",33,"م",1,0],["وتسنَّموا رُتَبَ العلاء بحقها","ما بين جدٍّ في الخلافة وابنمِ",34,"م",1,0],["وتسمّعوا الأخبار باستفتاحها","والخُبْرُ قد أغنى عن الأخبارِ",35,"ر",1,0],["وتسأل الأزهار عمّا إذا","مرّ فقيد الورد من سمتها",36,"ه",2,0],["وتسلسلت في الروض منه جداول","بين الزهور كأنهنّ سطور",37,"ر",1,0],["وتسمو للمكارم باتِّساق","كما اتّسقت أنابيب القناة",38,"ه",1,0],["وتستعلي الحياة بهم فتُمسي","من العيش الرغيد على يَفاع",39,"ع",1,0],["وتسمع أصوات الفراعل حوله","يعاوين أولادَ الذئاب الهقالسا",40,"س",2,1],["وَتُسعِدُني غُبرُ البَوادي لِأَجلِها","وَإِن رَغِمَت بَينَ البُيوتِ الحَواضِرُ",41,"ر",1,0],["وتسعدني الورقاء منها نواحها","بغصنٍ ومن أجفان عيني هموعها",42,"ع",3,0],["وتُسْلينيَ الأيامُ لا أنَّ لوعتي","ولا حَزَني كالشيء يُنْسى فَيَعْزُبُ",43,"ب",1,1],["وتَسربل ثوب عيشٍ","ليس بالثوب المُعار",44,"ر",1,0],["وتُسعِط النائكَ من إبطها","بسعطةٍ يا نتنَها سَعْطَهْ",45,"ط",2,0],["وتساجلت عيناك في آنائه","ويداك صوباً لا يزال هُمُوعا",46,"ع",2,0],["وتسمو إلى العلياء حتى تنالها","وتستنبئُ الغيب الخفي من العمق",47,"ق",1,0],["وتَسقيكَ الذي يشفي ويُدوِي","ففي الأحشاء بردٌ واضطرامُ",48,"م",1,0],["وتُسعِدُني نفسٌ على ذاك سَمْحةٌ","بما نثر الشجوُ الدخيلُ وما نظمْ",49,"م",1,0],["وتسمَّى بغير حقٍّ إماماً","لا هدى اللَّهُ سعيَه من إمام",50,"م",1,0],["وتستلينُ الدَّهْر ذا خُشنةٍ","فظّاً وتستخشن من لانا",51,"ن",2,0],["وَتَستَبينَ لِأَقوامٍ ضَلالَتُهُم","وَيَستَقيمَ الَّذي في خَدِّهِ صَعَرُ",52,"ر",1,0],["وَتَساقَطَت في الخَدِّ أَدمُعُها","كَالقَطرِ فَوقَ نَواضِرِ الزَهرِ",53,"ر",1,0],["وَتُسَرُّ إِن رَأَتِ الثُغورَ كَأَنَّها","المَقرورُ أَبصَرَ بَعدَ جُهدٍ نارا",54,"ر",2,0],["وَتَسَعَّرَت عِندَ الوَداعِ أَضالِعي","ناراً خَشيتُ بِحَرّها أَن أَحرَقا",55,"ق",2,0],["وَتَسعى سَعيَ مُشتاقٍ","بِلا قَلبٍ وَلا عَقلِ",56,"ل",1,0],["وَتَستَوي الحالاتُ في حالَةٍ","لا حَيفَ فيها لا أَذى لا اِنتِقام",57,"م",1,0],["وَتَسقيكُمُ الخَمرَ حُرٌ حِسانٌ","كَما يَشتَهينَ كَما تَشتَهون",58,"ن",1,0],["وَتَسَربَلَت بَغدادُ ثَوبَ مَهابَةٍ","لَيسَت تَراهُ أَو تَراهُ ثانِيَه",59,"ي",2,0],["وَتُسلَبَ السَرحَةُ أَوراقَها","وَلَم تَزَل أَعرافُها في التُراب",60,"ب",1,0],["وتُسْكِتُ في النَّفسِ صوتَ الحَيَاةِ","القويَّ إِذا مَا تغنَّى صَدَاهْ",61,"ا",2,0],["وتُسْمِعُني هاتِهِ الكائِناتُ","رقيقَ الأَغاني وحُلْوَ النَّشيدْ",62,"د",1,0],["وتَسَلُّقِ الجبلِ المُكَلَّلِ","بالصّنَوْبَرِ والصُّخورْ",63,"ر",1,0],["وتَسيرُ في عَدَواتِ وَادِيها","بنَفْسٍ حَالمهْ",64,"ه",1,0],["وتسير البواخر الشم فيها","ما خرات لها ذميل ووخد",65,"د",1,0],["وتسعى الجدران منها عناكب","تُجِدّ لها فيما تداعى مبانيا",66,"ي",2,0],["وتستوى صحف الصباح عنده","وصحفٌ ظهرن من عام مضى",67,"ا",1,0],["وتسبق سهمه منا سهام","لها بالحق رام لا يرامى",68,"م",2,0],["وتساءلوا ماذا يكون فعالها","فأجبتهم فاشودة وتزول",69,"ل",1,0],["وَتَسَمَّح وَتَوَسَّع في الزَكاه","إِنَّها مَحبوبَةٌ عِندَ الإِلَه",70,"ه",1,0],["وَتَسبِقُ الشَمسَ في الأَمصارِ حِكمَتُهُ","إِلى كَهولٍ وَشُبّانٍ وَأَطفالِ",71,"ل",1,0],["وَتَسعى لِذا الناسِ مَهم