0],["وَتَسيرُ عَن أَترابِها لِتُرابِها","جُملٌ وَيورَثُ دُملُجٌ وَسِوارُ",119,"ر",1,0],["وَتَسمو لِطارِفِها عَينُهُ","وَخَيرٌ لِناظِرِها لَو طُرِف",120,"ف",1,0],["وَتُسقاها لِدُنياكَ","وَتِلكَ المومِسُ الفارِك",121,"ك",1,0],["وَتَسمَعَ فيهِ ما يُصِمُّ ذَوي النُهى","فَلا رَوحَ إِلّا بِالحِمامِ المُصَمَّمِ",122,"م",1,0],["وَتُسأَلُ عَن بَقاءٍ أُعطيتَهُ","غَداً في أَيِّ شَيءٍ أَنفَقتَهُ",123,"ت",2,0],["وَتَساقى القَومُ كَأساً مُرَّةً","وَعَلا الخَيلَ دِماءٌ كَالشَقِر",124,"ر",1,0],["وَتَستلِبُ الدُهمَ التّي كانَ رَبُّها","ضَنيناً بِها وَالحَربُ فيها الحَرائِبُ",125,"ب",1,0],["وَتَسُوؤُهُ الأَيّامُ حَتّى","ما يَرى شَيئاً يَسُرُّهُ",126,"ر",2,0],["وتُسمِعُهُم أُمُّ المَنِيَّةِ وسْطَها","غناءَ صَليلِ البيضِ تحتَ المناصلِ",127,"ل",1,0],["وتَسويفٌ يَكِلُّ الصَّبر عَنْهُ","وَمَطْلٌ مَا يَقُومُ لَهُ حِسَابُ",128,"ب",1,0],["وتساوى أشرافهم والأداني","وتساوى غنيُّهم والفقير",129,"ر",1,0],["وتسلي من اللهيب فلا يب","قى متى شبَّ منه إلا النور",129,"ر",1,0],["وَتَسارَعوا في خوض غمرتها","وَبَدا لهم وَهْيٌ فما رأَبوا",130,"ب",3,0],["وَتسجع من حزن على فقد إلفها","نديمٍ كَما أنَّ الحَمامة تسجع",131,"ع",1,0],["وتسقط عانيةً للجبينِ","كقمريّةٍ وقَعَتْ في الحبالْ",132,"ل",1,0],["وتسمعتُ للغدير ينادي","ما الذي عاق طيره وحيامَه",133,"م",2,0],["وتَسمَّعتُ لها في كلِّ فجرِ","وهي تنهَلُ بإلهامي الوضيِّ",134,"ي",1,0],["وتساق أقداح المسرة معهما","فلكم ملأت بدمعك الأقداحا",135,"ح",2,0],["وتسمَّعتْ صوتاً فكان هتافُهُ","يا للحبيبِ من المحبِّ البائحِ",136,"ح",1,0],["وتسمّعي لحنَ الخيالِ وأفردي","لي فوق مائكِ صخرةً بيضاءَ",137,"ا",2,0],["وتستعرضُ الدنيا غريبَ فنونها","وتعرِبُ عن نجواكَ شتَّى لغاتِها",138,"ت",3,0],["وتَسوفُ رائحةُ الخُزامى أيْنُقي","فتَقُودُها ذُلُلاً بِغيرِ خَزائم",139,"م",1,0],["وَتَسهَرُ لي أَعيُنُ الحاسِدينَ","وَتَرقُدُ أَعيُنُ أَهلِ الوِدادِ",140,"د",1,0],["وَتَسَمَّعِي وُسْوَاسَ مَا بِكِ مِنْ حَلىً","فِي النَّفْسِ يُرْجِعُهُ صَدى أَشْعَارِي",141,"ر",2,0],["وَتَسكتُ إِلاَّ مَا تَقُولُ فِعَالُهَا","فَإِنْ نَبَسَتْ أَرْوَتْ بِأَعْذَبِ مَنْبِسِ",142,"س",1,0],["وَتَسَاقَوْا عَتِيقَةً ب