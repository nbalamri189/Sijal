{"poems":[[302,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[409,"العلم في قول لا إله إلا الله","https://www.aldiwan.net/poem33366.html","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79795","المتقارب"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114717","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133303","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136939",""],[4674,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=207032",""],[4755,"تَمَثَّلْتَ جَيشًا في حِمى الشّعبِ رابِضا","https://www.poetsgate.com/ViewPoem.aspx?id=184213",""],[5616,"رزان","https://www.poetsgate.com/ViewPoem.aspx?id=203503",""],[5674,"شموخ صمتك هزته القوارير","https://www.poetsgate.com/ViewPoem.aspx?id=207901",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[6229,"القبّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65189&r=&rc=15",""]],"verses":[["ولقَّنهُ إِيّاهُ بعدُ مُنَجَّماً","نُجوماً تُضيءُ الأفق كالأَنجُم الزُهرِ",0,"ر",1,0],["ولقنوا من إلى الممات غدا","مرتحلاً لا إله إلا اللّه",1,"ل",2,0],["ولقني في الحشر من شفاعته","مزدلفاً رضاك منتهاه",2,"ه",1,0],["ولقَّنه القول مستأجرٌ","عن القصدِ في أمرِه جائر",3,"ر",1,0],["ولقّنُوا زُرزورَكم","شُكركمُ لِيَلقَنا",4,"ن",2,0],["ولقنتنا الليالي من تصرفها","ما شان من حالة الدنيا وما زانا",5,"ن",2,0],["ولقَّني القوم ما من امة شطرت","حزبين الا عنت في الحادثات الحزب",6,"ب",1,0],["ولقّنتُ بعض الطير آخر أحرفي","لتشدو وداعًا في حروف سلامِ",7,"م",1,0],["ولَقَّنْتَ مَن باعُوا بلادًا بحَفنةٍ","لِأسيادِهِم.. دَرسًا مَريرًا وحامِضا",8,"ض",2,0],["ولقّنتِ العدوَّ الفظ درساً","جهادياً...وفاز بك الرهان",9,"ن",1,0],["ولَقِّنيهِ دُروساً في التواضُعِ.. قدْ","يسْتَوعِبُ الدَّرْسَ.. أو تُجدي التفاسيرُ",10,"ر",1,0],["ولقنّ منه معاني الحياة","وأدركن من دائه ماهيه",11,"ي",2,0],["ولَقنّتِنا سِرَّ الجمالِ ولم نكنْ","لندركَ - لولاكِ - الوجودَ جميلا",12,"ل",2,0]]}