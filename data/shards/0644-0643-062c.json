{"poems":[[49,"وقفتني على الأسى والنحيب","https://www.aldiwan.net/poem25356.html","الخفيف"],[74,"والذي زاد مقليك اقتدارا","https://www.aldiwan.net/poem18699.html","الخفيف"],[74,"سلبت محاسنك الغزال صفاته","https://www.aldiwan.net/poem19460.html","الكامل"],[53,"يا غيورا أن يهتك المستور","https://www.aldiwan.net/poem62847.html","الخفيف"],[53,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[87,"قصر الأعزة ما أعز حماكا","https://www.aldiwan.net/poem7925.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[53,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[132,"يا أيها الملك المرجى فضله","https://www.aldiwan.net/poem50601.html","الكامل"],[422,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[556,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126873","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63861","الخفيف"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82325","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125384","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53234","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53180","المديد"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104970","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67198","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74324","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86460","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73162","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136676",""],[5072,"يا قطتي","https://www.poetsgate.com/ViewPoem.aspx?id=51799",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[3294,"لي شوق لم أستطع لك بثه","https://www.poetsgate.com/ViewPoem.aspx?id=173262",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""]],"verses":[["لَكَ جِسمُ الهَوى وَثَغرُ الأَقاحي","وَنَسيمُ الصِبا وَقَدُّ القَضيبِ",0,"ب",1,0],["لك جيدٌ ومقلةٌ تركا الظ","بي لفرط الحياءِ يأوي القفارا",1,"ر",2,0],["لك جيده ولحاظه ونفاره","وغداً تصير قرونه لأبيكا",2,"ك",2,0],["لك جودٌ ورأفةٌ وحِفاظٌ","وإليك الميسور لا المعسورُ",3,"ر",1,0],["لك جارٍ كلما قلتُ جرى","فتشوقتُ له قيل انقطع",4,"ع",1,0],["لك جهلٌ في غير ما خفَّة الجَهْ","لِ وحلمٌ في غير ما إدهان",5,"ن",1,0],["لك جسم يكاد ينصبُّ لطفا","وفؤاد أقسى من الجلمود",6,"د",1,0],["لَكَ جَنَّةُ الدُنيا وَكَوثَرُها الَّذي","يَجري بِهِ في المُلكِ شَرطُ غِناكا",7,"ك",2,0],["لَكَ جَوُّكَ الرَّحْبُ الَّذِي تَخْلُو بِهِ","مُتَفَرِّداً وَالنَّاسُ في أَجْوَاءِ",8,"ا",2,0],["لك جهلٌ في غير ما خفية الجَهْ","لِ وحلمٌ في غير ماإدهان",9,"ن",1,0],["لك جودُ كفٍّ يفضح الأمطارَا","وضياءُ وجهٍ يخجلُ الأقمارَا",10,"ر",2,0],["لك جدُّ الكلام والكلم الطيّ","ب يؤتي كل امرئٍ ما يلائم",11,"م",1,0],["لكِ جَنَّةٌ مأهولةٌ فاِستبشري","بِدخلولها فلآخرين جهنَّمُ",12,"م",1,0],["لك جمّ آيات وجمّ فضائلٍ","كالمسكِ تنشر إن يهبّ نسيمُ",13,"م",1,0],["لك جسمٌ ما إنه تستشفُّ ال","عينُ خزَّ الجمالِ منه وقَزَّه",14,"ز",2,0],["لَك جارٌ بِالمصرِ لَم يَجعَلِ الل","هُ لَهُ مِنكَ حُرمَةَ الجيرانِ",15,"ن",1,0],["لك جيدٌ ومقلةٌ تركا النَّا","سَ سُكارى وما هُمُو بسكارى",16,"ر",2,0],["لك جوّ من الندى ليس يضحي","دام سُكْرِي به فماليَ صحوه",17,"و",2,0],["لك جود في مسالكه","عن بني الآمال لم يمل",18,"ل",1,0],["لك جسم على الرمال ورأس","رفعوه على رؤوس الرماح",19,"ح",1,0],["لكَ جمُّ أسرارٍ أبتْ","تُجلى بجنسٍ أو بفصل",20,"ل",1,0],["لك جدان جد حظ وجد","هو بين الورى مليك الأناس",21,"س",1,0],["لك جدان جد حظ تعالى","عن نظير في عزة وجلال",22,"ل",1,0],["لَكَ جاه لَدى الإله جَليل","وَفخار عَلى الوجود طَويل",23,"ل",1,1],["لَكَ جِبرِيلُ خادِمٌ وَرَسولٌ","وَرَقَت تَحتَ ذَيلِكَ الخُدَماءُ",24,"ا",2,0],["لك جثة لو أن موسى زارها","ما أم من واديه طوراً أيمنا",25,"ن",2,0],["لكَ جفنٌ عَجبتُ إِذ فازَ بالنَّص","رِ على ضَعفه وفيهِ انكسارُ",26,"ر",1,0],["لك جدٌ تهابُه الأرض مُهما","شدَّ للحَرب زَلزلت زِلزالا",27,"ل",2,0],["لك ِ جوف َ روحي شهقة ٌ وأنا بها","لا أستفيق ُ - وقد عجزت ُ - سرائرا",28,"ر",2,0],["لك جاؤوا جحافلا لاقتتالي","سفكوا (الدون) من إمام وقسِّ!!",29,"س",1,0],["لك جد قد ورث العلم والحل","م وبالجد أنت قد حزت إرثه",30,"ث",2,0],["لك جاه في موقف الحشر قد أضحى","عريضاً عند الإله طويلا",31,"ل",2,0]]}