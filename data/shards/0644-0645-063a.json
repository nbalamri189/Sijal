{"poems":[[92,"ارشد العمري","https://www.poetsgate.com/ViewPoem.aspx?id=179214",""],[202,"لمغناك سح المزن أدمع باك","https://www.aldiwan.net/poem51909.html","الطويل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[354,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[466,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[471,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114001","الخفيف"],[1924,"","https://poetry.dctabudhabi.ae/diwan/poem/102027","الرمل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96032","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132318","الوافر"],[4012,"","https://poetry.dctabudhabi.ae/diwan/poem/145252","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[5121,"نَوْمَةُ مَلاَك","https://www.poetsgate.com/ViewPoem.aspx?id=174100",""]],"verses":[["لمغفّلٍ عمّا به","حُمْقاً فكيفَ لما بهنَّه",0,"ن",2,0],["لمغناك سحَّ المزنُ أدمعَ باكٍ","ورجّعتِ الورقاءُ أنّةَ شاكِ",1,"ك",1,1],["لمغنى قباها والكئيب ورامة","وأحد وسلع والنقل والمآثر",2,"ر",1,0],["لِمَغيبِ قَلبي في هَواكُم مَشهَدُ","كُلُّ البَرِيَّةِ مُطلَقٌ وَمُقَيَّدُ",3,"د",1,1],["لِم غابَت الخيلانُ عَن","بيضِ الوُجوهِ وَلم تُعاوِد",4,"د",1,0],["لمغارٍ تَحسَبُ الصُّبْحَ به","جُنْحَ ليلٍ من مُثارِ النَّقْعِ جَنْ",5,"ن",1,0],["لِمُغتَصِبٍ قَد عَزَّهُ القَومُ أَمرَهُ","يُسِرُّ حَياءً عَبرَةً أَن تَطَلَّعا",6,"ع",2,0],["لِمَغانٍ عرَفتُ منها رسوماً","بينَ هضبِ القلاتِ فادرّمانِ",7,"ن",1,0],["لم غادرت مغاني ال","وصل بالهجران محلا",8,"ل",2,0],["لمغسلين بما تفيض نحورهم","لمكفنين مدارعا ان تلحما",9,"م",2,0],["لمغناطيسهِ الأرواح طارت","فأوصلها لحضرةِ الامتزاجِ",10,"ج",1,0],["لمغفل غر أسير واله","قد خيمت محن الزمان ببابه",11,"ب",2,0],["لمغنىً فيه للرضوان مأوىً","وفيه للرضا أسمى بناء",12,"ا",2,0],["لمغنىً من ثراه الجود أجدى","ثراءاً واغتنت كفُّ الغناء",12,"ا",2,0],["لمغنى تلثم الشمس اعتماداً","ثراه في الصباح وفي المساء",12,"ا",2,0],["لمغنى فيه غفراناً شهدنا","وعفواً للإله بلا امتراء",12,"ا",2,0],["لمغرس حكمةٍ ورياض علمٍ","ومنبت عصمة وحمى ولاء",12,"ا",2,0],["لِمَ غَطَّتْ مُلَاءَةُ الْمَوْتِ وَجْهاً","قَبْلَ فَجْرٍ قَدْ يَرْتَدِيِهِ الشِّفاءُ؟!!",13,"ا",2,0]]}