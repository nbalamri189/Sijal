{"poems":[[72,"أتتك ولم تبعد على عاشق مصر","https://www.aldiwan.net/poem42920.html","الكامل"],[47,"ضَمَانٌ عَلَى عَيْنَيْكِ أنّيَ لا أسْلُو","https://www.poetsgate.com/ViewPoem.aspx?id=32201",""],[53,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[119,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[146,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[154,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[214,"لعلياك في أفق الكمال مطالع","https://www.aldiwan.net/poem13464.html","الطويل"],[276,"سلام حواشيه كدر منضد","https://www.aldiwan.net/poem52051.html","الطويل"],[276,"سقاك الحيا الوسمى ربعا تأيدا","https://www.aldiwan.net/poem52098.html","الطويل"],[276,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[276,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[276,"حروف معان أو عقود جواهر","https://www.aldiwan.net/poem52109.html","الطويل"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[276,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[364,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[376,"أبى الليل مثلي مثل ما أنا منكم","https://www.aldiwan.net/poem57341.html","الطويل"],[447,"بنفسي رسوم بين نفعي وغرب","https://www.aldiwan.net/poem14331.html","الطويل"],[447,"تخص شهادة الشهرات سبعا","https://www.aldiwan.net/poem14412.html","الوافر"],[620,"","https://poetry.dctabudhabi.ae/diwan/poem/146476","الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54067","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64755","الوافر"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44845","السريع"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128714","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80006","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104791","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199817","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27839","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121033","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62852","الطويل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141889","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66559","الوافر"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18704","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58136","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57989","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76705","الطويل"],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5845,"أيرجعُلي قربُ الحبيبِ المعاهدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198432",""],[6142,"يا أقرب الصحب للزهرا مصاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=155744",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[276,"إليهِ بهِ سبحانهُ أتوسلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59268&r=&rc=7",""]],"verses":[["تُخَصُّ بِهِ مِصرٌ وَأَكنافُ قَصرِها","فَيا حَبَّذا مِصرٌ وَيا حَبَّذا القَصرُ",0,"ر",1,0],["تَخُصُّهُمُ البِيضُ الرّقاقُ، وَضُمّرٌ","عِتَاقٌ، وأحسابٌ بها يُدرَكُ التَّبْلُ",1,"ل",1,0],["تَخْصَلُّ منهنَّ عينٌ فهي باكية ٌ","ويستحِرُّ فؤاد وهو هيمان",2,"ن",1,0],["تخصب الارض فلم امور بها","حين القى ساقى الاصل فتاها",3,"ا",3,0],["تخصُّك بالماخضاتِ العشارِ","وغير رباكَ لهنَّ الجَهامُ",4,"م",1,0],["تُخَصِّصُهُ بِالحُبِّ في المَلإِ الأَعلى","لِمَن كانَ في الدُنيا وَفي الدينِ سَيِّداً",5,"د",2,0],["تخصك بالمدح الذي انت اهله","وتثني على الجود الذي انت صانع",6,"ع",1,0],["تخص خضم العحلو القطوف من","نى ثمرات الخير منبسط اليد",7,"د",1,0],["تخصك يا فرد الجلال وَيَنثَني","سَناها عَلى الصحب الكِرام مرددا",8,"د",2,0],["تخصك يا مَولاي حيا وَميتا","وَتشمل في تَعميمها الآل وَالصحبا",9,"ب",2,0],["تخصك يا فرد الوجود وَتنثني","عموما عَلى الصحب الكِرام الموالد",10,"د",1,0],["تخصك يا فرد الوجود وَتنثني","عَلى آلك الغر الكِرام العَناصِر",11,"ر",1,0],["تخص ارواح قوم هاجَروا معه","وَالتابعين ومن آوى ومن نصرا",12,"ر",2,0],["تخص حَبيب الزائين وَتثنى","عَلى آله اذهمأَعز وَأَفضل",13,"ل",1,0],["تخصُّك بالتمجيد والشكر والثنا","فأنت لذا أهلٌ وأتمِم لها مَهرا",14,"ر",2,0],["تخصّ العُيون الساهراتِ بِطوله","فيفضلُ بعضُ القَوم فيها على بَعضِ",15,"ض",1,0],["تخصك بل عمت ضجيعيك بالثنا","وآلك ما خبت قلاص بسبسب",16,"ب",1,0],["تخص شهادة الشهرات سبعا","من الأَحكام عن أهل الوفاق",17,"ق",1,1],["تخصب الأرض فلا أقربها","رائداً إلا إذا عز حماها",18,"ا",3,0],["تخصيصه بوداده من جهله","بادٍ ويهرب من سواه وينفر",19,"ر",1,0],["تَخصُّكَ دونَ أَملاكِ الْبَرايا","بِما تُثْني الرِّياضُ عَلى الغَوادي",20,"د",2,0],["تَخُصُّهُ مِنِّي وَلا تَنثَنِي","عَن أَهلِهِ الصِيدِ السَراةِ الكِرَام",21,"م",1,0],["تخصّك بالتحية ما أقا","م الحطيم وسار معتمر بركب",22,"ب",1,0],["تخصب الأرض في نداه إذا الجد","بُ أديمُ الصعيد فيه اقشعرَّا",23,"ر",2,0],["تَخُصُّكَ يا مَولاَىَ أَيضاً وَتَنَثَنى","لآلٍ وَأصحَابٍ مَدَا الدَّهرِ سَرمَدَا",24,"د",2,0],["تَخَصَّصَ مِن بَينِ الأَنامِ بِرِفعَةٍ","وَهِمَّتُهُ تَعلُو علضى كُلِّ هِمَّةِ",25,"ه",1,0],["تخص أم الشّيوخ اللّي نشير","لها بالشّان والقدر الوقور",26,"ر",1,0],["تخص إذا خصتْ نفوسَ شريفة","منزهة الأوصاف بالصورة الشوهى",27,"ه",2,0],["تَخُصُّ قَبركَ يا خيرَ السلاطينِ","تَحيةٌ كالصِّبا مَرَّت بدارينِ",28,"ن",1,1],["تَخُصُّ السيوفُ المرهفاتُ جِبَاهَهَا","ويأخذُ منها الطَّعْنُ كلَّ مكَانِ",29,"ن",1,0],["تخصّصت باّلذي لوردت إذ حسدت","وجدّ مستحسن في نعمةٍ حسد",30,"د",1,0],["تُخصُّ بِمائِها فِي الْحِينِ أَرْضاً","وَمالُكَ لِلْفَقيرِ وَلِلْغَنيِّ",31,"ي",1,0],["تُخَصِّصُ جَبّاراً عَلَيَّ وَرَهطَهُ","وَما صِرمَتي فيهِم لَأَوَّلِ مَن سَعى",32,"ا",1,0],["تخصكَ شيخَ المنذريِّين ثم مَنْ","حَوَتْ بلدٌ يوماً وطابَ مقَامُ",33,"م",1,0],["تخصُّ خميساً والأهل كلَّهم","من الآل والجيران من كل عصبةِ",34,"ه",1,0],["تخصصت أحياناً بلخم ويعرب","وظاهرت أحياناً بغسان والأزد",35,"د",1,0],["تخصم أعدانا وحدنا","ومكرهم لا إله إلا الله",36,"ل",2,0],["تخصف النعل في يديك وكانت","لك تجبى بأمرك الأفياء",37,"ا",2,0],["تخصكَيا فردَالوجودِ وتثني","عموماً على الصحبِ الكرامِالموالدِ",38,"د",1,0],["تخصهم منك بالمعروف أجمعه","علما بأنهم أولى ذوي القرب",39,"ب",1,0],["تخصصت أنبياء الله في شرف الت","تطهير والمرتضى فيه مباريها",40,"ي",3,0],["تخصُّ حبيبَ الزائرينَ وتنثني","على آلهِ إذْ همْ أعزُّ وأفضلُ",41,"ل",1,0]]}