{"poems":[[53,"يا ظالمي والقلب ناصره","https://www.aldiwan.net/poem29730.html","الكامل"],[53,"يا ظبية البان ترعى في خمائله","https://www.aldiwan.net/poem29919.html","البسيط"],[55,"لا تلمني فما علي ملام","https://www.aldiwan.net/poem26116.html","الخفيف"],[71,"يا ظالماً جعل القطيعة مذهبا","https://www.aldiwan.net/poem4020.html","الكامل"],[73,"يا ظبية لطفت مني منازلها","https://www.aldiwan.net/poem11854.html","البسيط"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[47,"الورد في وجنتيه","https://www.aldiwan.net/poem24812.html","المجتث"],[47,"علي من عيني عينان","https://www.aldiwan.net/poem25116.html","السريع"],[72,"كل الجوانح قلب فيك مشغوف","https://www.aldiwan.net/poem19260.html","البسيط"],[72,"يا فاتكا خده لي شامتا بدمي","https://www.aldiwan.net/poem19988.html","البسيط"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[51,"ذكر الأخفش القديم فقلنا","https://www.aldiwan.net/poem65885.html","الخفيف"],[78,"بركت تلوح وفي الفؤاد بلابل","https://www.aldiwan.net/poem14005.html","الكامل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[45,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[45,"لك في المجد أول وأخير","https://www.aldiwan.net/poem63574.html","الخفيف"],[45,"مني وصل ومنك هجر","https://www.aldiwan.net/poem63631.html","مجزوء البسيط"],[28,"يا ظمي ويحك إني ذو محافظة","https://www.aldiwan.net/poem5495.html","البسيط"],[66,"يا ظبية قنص الأسود جمالها","https://www.aldiwan.net/poem39936.html","الكامل"],[97,"إن عدت أو أخلفت لم تعد","https://www.aldiwan.net/poem24792.html","أحذ الكامل"],[80,"هن الحسان وحربها الهجر","https://www.aldiwan.net/poem31452.html","أحذ الكامل"],[44,"نسج المشيب له لفاعا مغدفا","https://www.aldiwan.net/poem29716.html","الكامل"],[87,"ذنبي إليك غرامي","https://www.aldiwan.net/poem8275.html","المجتث"],[81,"بأبي جفون معذبي وجفوني","https://www.aldiwan.net/poem61470.html","الكامل"],[52,"يا ظبية الميدان واحربا","https://www.aldiwan.net/poem26884.html","الكامل"],[52,"يا ظالم الفعل ومظلوم النظر","https://www.aldiwan.net/poem27042.html","الرجز"],[48,"سجد الجمال لحسن وجهك","https://www.aldiwan.net/poem65001.html","مجزوء الكامل"],[48,"يا ظبي يا ابن سيار","https://www.aldiwan.net/poem65316.html","المجتث"],[46,"يا ظالما عقد اليدين مصليا","https://www.aldiwan.net/poem22585.html","الكامل"],[46,"أما الحسام فما أدناك من أجل","https://www.aldiwan.net/poem22791.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/143298","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30441","الرمل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42683","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142067","الخفيف"],[88,"يا ساكناً وهو مشنوق على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=25554",""],[90,"النفثة!","https://www.poetsgate.com/ViewPoem.aspx?id=179076",""],[94,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""]],"verses":[["يا ظالِمي وَالقَلبُ ناصِرُهُ","يَجني عَلَيَّ لَهُ كَما يَجني",0,"ي",1,1],["يا ظَبيَةَ البانِ تَرعى في خَمائِلِهِ","لِيَهنَكِ اليَومَ أَنَّ القَلبَ مَرعاكِ",1,"ك",1,1],["يا ظَلومُ الظَلومُ هَل يَستَحِلُّ ال","قَتلَ مَن كانَ دينَهُ الإِسلامُ",2,"م",1,0],["يا ظالِماً جَعل القَطيعَةَ مَذهَبا","ظُلماً وَلَم أَرَ عَن هَواهُ مَذهَبا",3,"ب",2,1],["يا ظَبيَةً لَطُفَت مِنّي مَنازِلُها","فَالقَلبُ مِنهُنَّ وَالأَحداقُ وَالكَبِدُ",4,"د",1,1],["يا ظبيةٌ سنحت بأكناف الحمى","سُقي الحمى صوبَ الغمام المسجم",5,"م",1,0],["ياظالِماً لَستُ أَدري","أَدعو لَهُ أَم عَلَيهِ",6,"ي",2,0],["يا ظالِمي لِلشَربِ سُكرٌ وَلي","مِن غُنجِ أَلحاظِكَ سُكرانِ",7,"ن",1,0],["يا ظبية من ظباء الحيّ نافرة","حتَّامَ هجرك شيء منك مألوف",8,"ف",1,0],["يا ظاهر القول والأفعال علَّمه","بالخير من علّم الإنسان بالقلم",9,"م",1,0],["يا ظبيةً من ظباءٍ كان مَكْنسُها","في ظلِّ ذي ثمرٍ مني وذي هَدَبِ",10,"ب",1,0],["يا ظبيةً من ظباءٍ كان مسكنُها","في ظلِّ غُصني إذا ظلُّ الضحى الْتَهبا",11,"ب",2,0],["يا ظِماءً إلى الصواب رِدُوه","يَسْقِكم بالصواب عَلّاً ونهلا",12,"ل",2,0],["يا ظَبيَةً سَلَبَت فُؤادَ مُحَمدٍ","أَوَ لَم يُرَوّعكِ الهَزبرُ الباسِلُ",13,"ل",1,0],["يا ظَبيَةَ الرَملِ وُقيتِ الهَوى","وَإِن سَمِعَت عَيناكِ في جَلبِهِ",14,"ب",2,0],["يا ظِبيَةَ الخَيماتِ مِن ذاتِ الغَضا","صَدَقَ الوَعيدُ فَأَينَ صِدقُ مَواعِدِ",15,"د",1,0],["يا ظَهيرَ النَدى وَنِعمَ الظَهيرُ","وَنَصيرَ العُلا وَنِعمَ النَصيرُ",16,"ر",1,0],["يا ظالِماً لي بِغَيرِ جُرمٍ","إِلَيكَ مِن ظُلمِكَ المَفَرُّ",17,"ر",1,0],["يا ظَميَ وَيحَكِ إِنّي ذو مُحافَظَةٍ","أَنمي إِلى مَعشَرٍ شُمُّ الخَراطيمِ",18,"م",1,1],["يا ظَبيَةً قَنَصَ الأُسودَ جَمالُها","وَنَرى الظِباءَ يَصيدُها القَنّاصُ",19,"ص",1,1],["يا ظالمي عيناك كم وعدت","قلبي إذا شفتاك لَم تعدِ",20,"د",1,0],["يا ظبيةً إنْ مَرّضَتْ نظراً","فَلِكُلِّ قَسْوَرَةٍ به قَسرُ",21,"ر",1,0],["يا ظَبيَةَ الجِزعِ الَّذي بِمُحَجَّرٍ","تَرعى الكِباثَ مُصيفَةً وَالعُلَّفا",22,"ف",2,0],["يَاظَالِمِي فِي هَوَاهُ","هَلَّا رَعَيْتَ ذِمَامِي",23,"م",2,0],["يا ظَبيَةً تَلوي دُيوني في الهَوى","كَيفَ السَبيلُ إِلى اِقتِضاءِ دُيوني",24,"ي",1,0],["يا ظَبيَةَ المَيدانِ واحَرَبا","مِن سِحرِ أَجفانٍ تُمَرِّضُها",25,"ض",3,1],["يا ظالِمَ الفِعلِ وَمَظلومَ النَظر","وَيا كَئيباً وَقَضيباً وَقَمَر",26,"ر",1,1],["يا ظالِمي لَيسَ المُحِب","بُ وَإِن تَجَلَّدَ مِن رِجالِك",27,"ك",1,0],["يا ظَبيُ يا اِبنَ سِيارٍ","وَزَينَ صَفِّ القِيانِ",28,"ن",1,1],["يا ظالِماً عَقَدَ اليَدَينِ مُصَلِيّاً","مِن دونِ ظُلمِكَ يُعقَدُ الزُنّارُ",29,"ر",1,1],["يا ظَبيُّ ما أَنتَ وَالضُرغامُ تُؤَنِّسُهُ","إِنَّ الضَراغِمَ مِن أَخلاقِها الشَرَسُ",30,"س",1,0],["يا ظلم ان طالَت يد لَك برهة","فالعَدل لَيسَ ذراعه بِقَصير",31,"ر",1,0],["يا ظبية علقتني في تصيدها","أشراكها وهي لم تعلق بأشراكي",32,"ك",2,1],["يا ظُبَا لَحظِي خُذِي لي رأْسَهُ","فَهْوَ لا شَكَّ مِن أهلِ الرِّيبِ",33,"ب",1,0],["يا ظلامَ الحياةِ يا رَوْعة الحُزْ","نِ ويا مِعْزَفَ التَّعيسِ الغَريبِ",34,"ب",1,0],["يَا ظَبْيَةَ الْمِقْيَاسِ هَذَا مَدْمَعِي","فَرِدِي وَهَذَا رَوْضُ قَلْبِي فَارْتَعِي",35,"ي",1,0],["يا ظُلْمةً في خاطري مثْلُها","للهِ ما أكثف هذا الجناح",36,"ح",1,0],["يا ظالم الشعبِ مظلوماً بفعلته","عليك ام منك يبكي الشعب منتحبا",37,"ب",2,0],["يا ظلمةً قد طبقّتْ موطني","دومي : فشعبي لا يُريد الصّباح",38,"ح",1,0],["يا ظباءَ الأمويينَ اضحكي","تضحكُ الدنيا ويغمرها الصفاء",39,"ا",2,0]]}