et/poem37557.html","المجتث"],[501,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[501,"قل لغزلان بقيعان النقا","https://www.aldiwan.net/poem37937.html","الرمل"],[507,"الآن قد أيقن ابن رشد","https://www.aldiwan.net/poem2416.html","مخلع البسيط"],[516,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[516,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[539,"يا ظبية مازلت أتبع ظلها","https://www.aldiwan.net/poem47911.html","عموديه"],[559,"في الدال بالإهمال إعمال بدا","https://www.aldiwan.net/poem34609.html","الكامل"],[563,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[563,"لمن الخيام ومن هنالك نازل","https://www.aldiwan.net/poem52901.html","الكامل"],[568,"قد جاد طيفك لي بوعدك","https://www.aldiwan.net/poem69734.html","مجزوء الكامل"],[576,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[587,"حييت يا ربع الحمى بزرود","https://www.aldiwan.net/poem17493.html","الكامل"]],"verses":[["يا ظالِمي وَالقَلبُ ناصِرُهُ","يَجني عَلَيَّ لَهُ كَما يَجني",0,"ن",2,1],["يا ظَبيَةَ البانِ تَرعى في خَمائِلِهِ","لِيَهنَكِ اليَومَ أَنَّ القَلبَ مَرعاكِ",1,"ك",1,1],["يا ظَلومُ الظَلومُ هَل يَستَحِلُّ ال","قَتلَ مَن كانَ دينَهُ الإِسلامُ",2,"م",1,0],["يا ظالِماً جَعل القَطيعَةَ مَذهَبا","ظُلماً وَلَم أَرَ عَن هَواهُ مَذهَبا",3,"ب",2,1],["يا ظَبيَةً لَطُفَت مِنّي مَنازِلُها","فَالقَلبُ مِنهُنَّ وَالأَحداقُ وَالكَبِدُ",4,"د",1,1],["يا ظبيةٌ سنحت بأكناف الحمى","سُقي الحمى صوبَ الغمام المسجم",5,"م",1,0],["ياظالِماً لَستُ أَدري","أَدعو لَهُ أَم عَلَيهِ",6,"ي",2,0],["يا ظالِمي لِلشَربِ سُكرٌ وَلي","مِن غُنجِ أَلحاظِكَ سُكرانِ",7,"ن",1,0],["يا ظبية من ظباء الحيّ نافرة","حتَّامَ هجرك شيء منك مألوف",8,"ف",1,0],["يا ظاهر القول والأفعال علَّمه","بالخير من علّم الإنسان بالقلم",9,"م",1,0],["يا ظبيةً من ظباءٍ كان مَكْنسُها","في ظلِّ ذي ثمرٍ مني وذي هَدَبِ",10,"ب",1,0],["يا ظبيةً من ظباءٍ كان مسكنُها","في ظلِّ غُصني إذا ظلُّ الضحى الْتَهبا",11,"ب",2,0],["يا ظِماءً إلى الصواب رِدُوه","يَسْقِكم بالصواب عَلّاً ونهلا",12,"ل",2,0],["يا ظَبيَةً سَلَبَت فُؤادَ مُحَمدٍ","أَوَ لَم يُرَوّعكِ الهَزبرُ الباسِلُ",13,"ل",1,0],["يا ظَبيَةَ الرَملِ وُقيتِ الهَوى","وَإِن سَمِعَت عَيناكِ في جَلبِهِ",14,"ب",2,0],["يا ظِبيَةَ الخَيماتِ مِن ذاتِ الغَضا","صَدَقَ الوَعيدُ فَأَينَ صِدقُ مَواعِدِ",15,"د",1,0],["يا ظَهيرَ النَدى وَنِعمَ الظَهيرُ","وَنَصيرَ العُلا وَنِعمَ النَصيرُ",16,"ر",1,0],["يا ظالِماً لي بِغَيرِ جُرمٍ","إِلَيكَ مِن ظُلمِكَ المَفَرُّ",17,"ر",1,0],["يا ظَميَ وَيحَكِ إِنّي ذو مُحافَظَةٍ","أَنمي إِلى مَعشَرٍ شُمُّ الخَراطيمِ",18,"م",1,1],["يا ظَبيَةً قَنَصَ الأُسودَ جَمالُها","وَنَرى الظِباءَ يَصيدُها القَنّاصُ",19,"ص",1,1],["يا ظالمي عيناك كم وعدت","قلبي إذا شفتاك لَم تعدِ",20,"د",1,0],["يا ظبيةً إنْ مَرّضَتْ نظراً","فَلِكُلِّ قَسْوَرَةٍ به قَسرُ",21,"ر",1,0],["يا ظَبيَةَ الجِزعِ الَّذي بِمُحَجَّرٍ","تَرعى الكِباثَ مُصيفَةً وَالعُلَّفا",22,"ف",2,0],["يَاظَالِمِي فِي هَوَاهُ","هَلَّا رَعَيْتَ ذِمَامِي",23,"م",2,0],["يا ظَبيَةً تَلوي دُيوني في الهَوى","كَيفَ السَبيلُ إِلى اِقتِضاءِ دُيوني",24,"ن",2,0],["يا ظَبيَةَ المَيدانِ واحَرَبا","مِن سِحرِ أَجفانٍ تُمَرِّضُها",25,"ض",3,1],["يا ظالِمَ الفِعلِ وَمَظلومَ النَظر","وَيا كَئيباً وَقَضيباً وَقَمَر",26,"ر",1,1],["يا ظالِمي لَيسَ المُحِب","بُ وَإِن تَجَلَّدَ مِن رِجالِك",27,"ك",1,0],["يا ظَبيُ يا اِبنَ سِيارٍ","وَزَينَ صَفِّ القِيانِ",28,"ن",1,1],["يا ظالِماً عَقَدَ اليَدَينِ مُصَلِيّاً","مِن دونِ ظُلمِكَ يُعقَدُ الزُنّارُ",29,"ر",1,1],["يا ظَبيُّ ما أَنتَ وَالضُرغامُ تُؤَنِّسُهُ","إِنَّ الضَراغِمَ مِن أَخلاقِها الشَرَسُ",30,"س",1,0],["يا ظلم ان طالَت يد لَك برهة","فالعَدل لَيسَ ذراعه بِقَصير",31,"ر",1,0],["يا ظبية علقتني في تصيدها","أشراكها وهي لم تعلق بأشراكي",32,"ك",2,1],["يا ظُبَا لَحظِي خُذِي لي رأْسَهُ","فَهْوَ لا شَكَّ مِن أهلِ الرِّيبِ",33,"ب",1,0],["يا ظلامَ الحياةِ يا رَوْعة الحُزْ","نِ ويا مِعْزَفَ التَّعيسِ الغَريبِ",34,"ب",1,0],["يَا ظَبْيَةَ الْمِقْيَاسِ هَذَا مَدْمَعِي","فَرِدِي وَهَذَا رَوْضُ قَلْبِي فَارْتَعِي",35,"ع",2,0],["يا ظُلْمةً في خاطري مثْلُها","للهِ ما أكثف هذا الجناح",36,"ح",1,0],["يا ظالم الحياة ما أعدل القبر","تساوى فيه الوجود جميعه !",37,"ع",2,0],["يا ظالم الشعبِ مظلوماً بفعلته","عليك ام منك يبكي الشعب منتحبا",38,"ب",2,0],["يا ظلمةً قد طبقّتْ موطني","دومي : فشعبي لا يُريد الصّباح",39,"ح",1,0],["ياظامي أنا أظما .. ومتشبع حروق","واذاك ظامي للمواصل أنا هلك",40,"ك",1,0],["يا ظباءَ الأمويينَ اضحكي","تضحكُ الدنيا ويغمرها الصفاء",41,"ا",2,0],["يا ظالم التّفاح في وجناتها","لو ذقت بعض شمائل التفّاح",42,"ح",1,0],["يا ظباء الرياض باللَه عطفاً","لمحب أورثتموه انذهالا",43,"ل",2,0],["يا ظريف الطباع قربت بعدت","لعمري الضدان لا يجمعان",44,"ن",1,0],["يا ظالماً حسنه رويدك ما","أرخص حسناً تجنه الظلم",45,"م",1,0],["يا ظبية الوادي ولا واد إذا","ما كنت فيه ولا هناك حزون",46,"ن",1,0],["يا ظبية الوادي وما الوادي إذا","لم تؤنسيه ومن أنا لولاك",47,"ك",1,0],["يا ظامئاً والدِماءُ تَجري","منه لِيَروي بها سواه",48,"ه",1,0],["يَا ظَلاَمَ الزَّوَالِ قَد خِلتَ ظُلمِى","هَيِّناً لاَ أَرُدُّ عني الظَّلُومَا",49,"م",2,0],["ياظبي هل من لفتةٍ يا غصنُ هل","ما عطفةٍ فالنفس زاد ضناها",50,"ا",3,0],["يا ظالِماً في كُلِّ أَفْعالِهِ","مَا شِئْتَ فَاصْنَعْ فَلَنا مَوْقِفُ",51,"ف",1,1],["يا ظالما جار فيمن لا نظير له","إلا المهيمن لا تغتر بالمهل",52,"ل",1,0],["يا ظَبيَ سِنجار أما ترثى لمن","قد صار من أجلك في كفِّ الأَجَل",53,"ل",1,1],["يا ظَبيَةً أَشبَه شَيءٍ بِالمَها","تَرعى الخُزامى بَينَ أَشجارِ النَقا",54,"ا",1,1],["يا ظبيتي إني أتيتك لاجئا","فسلي الطفيلة سوفَ تُنْبيكِ الخَبر",55,"ر",1,0],["يا ظبية الحيّ التي أمّت به","جلل الخطوب مهامها ريدا",56,"د",2,0],["يا ظبية الغورِ لا نهوى النجادَ ولا","نبغي من العيش في أطلالكم حِوَلا",57,"ل",2,0],["يا ظلة الموج يطغى البحر منتفضاً","بها كأن جبل في البحر يقتلع",58,"ع",1,1],["يا ظلاماً أحبّ من كلِّ نُورِ","ليس فِعلُ الهتُوكِ فِعلَ السُّتُورِ",59,"ر",1,1],["يا ظبية البان يا غصن النقا النضر","استغفر اللّه بل يا طلعة القمر",60,"ر",1,1],["يا ظبية مذ أقبلت تعطو","صارت عليَّ كشر رئبال",61,"ل",1,0],["يا ظَبيَةً من ظِباءِ الأُنسِ راتِعةً","بَينَ القُصورِ تعالى اللَهُ باريكِ",62,"ك",1,1],["يا ظالِماً حَكَّمتُه فاِعتَدى","اليكَ أَشكو مِنكَ يا ظالِمي",63,"م",2,0],["يا ظبيةً ترعى ربيع حشاشتي","ما ضرّ لو طرفي غدا يرعاك",64,"ك",1,0],["يا ظبا الشهباء والظب","ي عزيز الاقتناص",65,"ص",1,0],["يا ظبيةً بيضاءَ نافرةً","إن كنتِ خائفةً فنحميك",66,"ك",1,0],["يا ظامىء القصد دع ورد الثماد ورد","بحر الشهاب ابن فخر الدين معدانا",67,"ن",2,0],["يا ظامىء الآمال في طلب الغنى","قف حيث تلقى الطالِع المَسعودا",68,"د",2,0],["يا ظلمى القصد زرنيل النوالا وَلا","يسد عينك عنه لامع الآل",69,"ل",1,0],["يا ظاعنين بِقَلبي اينما ظعنوا","وَنازلين بِقَلبي اينَما نَزَلوا",70,"ل",3,0],["يا ظبيةً بالسَفح راتعةً","تَشتو الغضا وتربَّعُ الحزَنا",71,"ن",2,0],["يا ظبيةً بالكثيب الفرد راتعةً","أَوحشتِ عيني وفي الأَحشاءِ مَثواكِ",72,"ك",1,0],["يا ظالماً حل في ضميري","وألزم القلب أن تحول",73,"ل",1,1],["يا ظبي عيديد المبارك عودة","يحيا بها دنف أخو تذكار",74,"ر",1,0],["يا ظبي عيد ما في الحسن لك ثاني","هل من سبيل إلى لقياك يا غاني",75,"ن",2,1],["يا ظالم في الهوى أما تنصفني","وحدتك في العشق فلم تشرك بي",76,"ي",1,0],["يا ظبية البان ما رددت ذكراك","الا تنسمت برقاً من ثناياكِ",77,"ك",1,1],["يا ظَبي أنسٍ قاهِري بِالنَوى","وَهوَ عَلى هَتكي بِهِ حاجري",78,"ي",1,1],["يا ظالماً ينكر الحق الصراح به","لو ذقته ما نَكَرتَ الحق كالسَفَل",79,"ل",1,0],["يا ظلال الدَوحَتين","في رِياض النيربين",80,"ن",1,0],["يا ظَبيَةَ القاعِ بَينَ الضال وَالسَمرِ","من كانَ أَغراكِ بالإِعراضِ وَالخَفَرِ",81,"ر",1,1],["يا ظالماً أبداً يُرَوِّ","عُني بإعراضٍ وعَتبِ",82,"ب",1,1],["يا ظَلُوماً كلَّمَا اسْتَع","طَفْتُهُ صَدَّ وتَاهَا",83,"ا",3,0],["يا ظَلوماَ كلّمَا استع","طَفْتُه تَاهَ وصَدّا",84,"د",2,0],["يا ظالماً أفْنَى اصْطِبَارِي هجرُه","وابتَزَّ ثَوبَ تَماسُكِي وتَجالُدِي",85,"د",2,0],["يا ظباءَ المنحنى أنْقِذْنَه","من هواكنَّ وإلاّ هلكا",86,"ك",2,0],["يا ظبيُ كم صَرَعت عي","ونُك قبلَنا في الدهر أُسْدا",87,"د",2,0],["يا ظبيةً ألقى هواها إلى","قلبي ولم تدر به جلّ نار",88,"ر",1,1],["يا ظبيةً سلبت بدو","ر التم بالوجه المنيرِ",89,"ر",1,0],["يا ظبية البان بين الرند والخزم","ترعى الحشاشة كفي العتب لا تلمي",90,"م",2,1],["يا ظلوما أترى","من بقتلي بتلك",91,"ك",1,0],["يا ظاعنين وقلبي نحوهم أبداً","يحدى من الشوق فيما بين أظعان",92,"ن",1,0],["يا ظبيُ لو بتَّ فيه عدتَ وقد","عَنَّ ظباءٌ ببابلٍ غيدُ",93,"د",1,0],["يا ظباءَ الصّريم ما كنت بالخائف","من تلكم العهود انصراما",94,"م",2,0],["يا ظبيةَ الوادي نداءَ مولَّهٍ","ناداكِ مِنْ ألمِ التفرُّقِ شاكيا",95,"ي",2,0],["يا ظبي صل يا دهر صل","يا عين سل بدري جائر",96,"ر",1,0],["يا ظبية الوحش إني","صريع ظبية انس",97,"س",1,0],["يا ظلمة الزور كفي","فوق دجاكي البصائر",98,"ر",1,1],["يا ظبيَةً غنَّاءَ تعبَثُ بالنُّهى","فتكاً وتقْتَنِصُ الهِزَبْرَ إذا اقْتَحَمْ",99,"م",1,0],["يا ظِباءَ الحَيِّ قد طال بِكُمْ","وجدُ قلبي فارْحَموا لي الأَرَقَا",100,"ق",2,0],["يا ظالماً نفسَه تأمل","هل تجد اليوم من يوالف",101,"ف",1,0],["يا ظبية الرمل التي","أونسها وتنفر",102,"ر",1,1],["يا ظامئ الآمال إنك نازل","بغدير ذاك العارض المدرار",103,"ر",1,0],["يَا ظبيةً مازلتُ أتبعُ ظِلَّها","حَتى ظفِرتُ بِهَا وجادَ زَمَاني",104,"ن",2,1],["يا ظاهراً في كل ما هو ظاهرٌ","يا باطناً نفسي لأنفسك الفدا",105,"د",2,0],["يا ظَبيةً في الحيِّ حولَ كناسِها","سُمْرٌ حَفَفْنَ بصَعْدةٍ سَمْراءِ",106,"ا",2,0],["يا ظالمَ الأشرافِ إذ قاسَمْتَهُم","فأخذتَ كُلَّ سجيَّةٍ غَرَّاءِ",106,"ا",2,0],["يا ظَبيةً في الحَيِّ نَبغي صَيدَها","فَتصيدُنا عُنْفاً وليس تُخاتِلُ",107,"ل",1,0],["يا ظالِمي مُتَجَنِّياً","ماذا أرَدْتَ بِظُلْمِ عَبْدِكْ",108,"ك",1,0],["يا ظاعِنين لقَدْ قَصَّرتُمُ أَمَلاً","يا غائِبينَ لقد طوَّلْتُمُ الأَمَدَا",109,"د",2,0],["يا ظَبْيةَ الوَعْسَاءِ ما ضَرَّ الهَوَى","لَوْ كُنْتِ مِنْ قَنْصِي وبَعْضِ صُيُودِي",110,"د",2,0]]}