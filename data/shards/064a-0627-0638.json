https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6029,"تتوارى الشّمسُ مُرْغمة","https://www.poetsgate.com/ViewPoem.aspx?id=188804",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[6124,"ظلال الموت","https://www.poetsgate.com/ViewPoem.aspx?id=159598",""],[6127,"يا نونُ ... يا قلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188718",""],[520,"دانت لأمرك طاعة الأقدار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577511",""],[6185,"حاولت ريّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86944&r=&rc=4",""],[5075,"سأظلُ أملأ بالهنَا أقدَاحِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82755&r=&rc=1",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[463,"أنت على حالتيك محمودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60016&r=&rc=72",""]],"verses":[["يا ظالِمي وَالقَلبُ ناصِرُهُ","يَجني عَلَيَّ لَهُ كَما يَجني",0,"ن",2,1],["يا ظَبيَةَ البانِ تَرعى في خَمائِلِهِ","لِيَهنَكِ اليَومَ أَنَّ القَلبَ مَرعاكِ",1,"ك",1,1],["يا ظَلومُ الظَلومُ هَل يَستَحِلُّ ال","قَتلَ مَن كانَ دينَهُ الإِسلامُ",2,"م",1,0],["يا ظالِماً جَعل القَطيعَةَ مَذهَبا","ظُلماً وَلَم أَرَ عَن هَواهُ مَذهَبا",3,"ب",2,1],["يا ظَبيَةً لَطُفَت مِنّي مَنازِلُها","فَالقَلبُ مِنهُنَّ وَالأَحداقُ وَالكَبِدُ",4,"د",1,1],["يا ظبيةٌ سنحت بأكناف الحمى","سُقي الحمى صوبَ الغمام المسجم",5,"م",1,0],["ياظالِماً لَستُ أَدري","أَدعو لَهُ أَم عَلَيهِ",6,"ي",2,0],["يا ظالِمي لِلشَربِ سُكرٌ وَلي","مِن غُنجِ أَلحاظِكَ سُكرانِ",7,"ن",1,0],["يا ظبية من ظباء الحيّ نافرة","حتَّامَ هجرك شيء منك مألوف",8,"ف",1,0],["يا ظاهر القول والأفعال علَّمه","بالخير من علّم الإنسان بالقلم",9,"م",1,0],["يا ظبيةً من ظباءٍ كان مَكْنسُها","في ظلِّ ذي ثمرٍ مني وذي هَدَبِ",10,"ب",1,0],["يا ظبيةً من ظباءٍ كان مسكنُها","في ظلِّ غُصني إذا ظلُّ الضحى الْتَهبا",11,"ب",2,0],["يا ظِماءً إلى الصواب رِدُوه","يَسْقِكم بالصواب عَلّاً ونهلا",12,"ل",2,0],["يا ظَبيَةً سَلَبَت فُؤادَ مُحَمدٍ","أَوَ لَم يُرَوّعكِ الهَزبرُ الباسِلُ",13,"ل",1,0],["يا ظَبيَةَ الرَملِ وُقيتِ الهَوى","وَإِن سَمِعَت عَيناكِ في جَلبِهِ",14,"ب",2,0],["يا ظِبيَةَ الخَيماتِ مِن ذاتِ الغَضا","صَدَقَ الوَعيدُ فَأَينَ صِدقُ مَواعِدِ",15,"د",1,0],["يا ظَهيرَ النَدى وَنِعمَ الظَهيرُ","وَنَصيرَ العُلا وَنِعمَ النَصيرُ",16,"ر",1,0],["يا ظالِماً لي بِغَيرِ جُرمٍ","إِلَيكَ مِن ظُلمِكَ المَفَرُّ",17,"ر",1,0],["يا ظَميَ وَيحَكِ إِنّي ذو مُحافَظَةٍ","أَنمي إِلى مَعشَرٍ شُمُّ الخَراطيمِ",18,"م",1,1],["يا ظَبيَةً قَنَصَ الأُسودَ جَمالُها","وَنَرى الظِباءَ يَصيدُها القَنّاصُ",19,"ص",1,1],["يا ظالمي عيناك كم وعدت","قلبي إذا شفتاك لَم تعدِ",20,"د",1,0],["يا ظبيةً إنْ مَرّضَتْ نظراً","فَلِكُلِّ قَسْوَرَةٍ به قَسرُ",21,"ر",1,0],["يا ظَبيَةَ الجِزعِ الَّذي بِمُحَجَّرٍ","تَرعى الكِباثَ مُصيفَةً وَالعُلَّفا",22,"ف",2,0],["يَاظَالِمِي فِي هَوَاهُ","هَلَّا رَعَيْتَ ذِمَامِي",23,"م",2,0],["يا ظَبيَةً تَلوي دُيوني في الهَوى","كَيفَ السَبيلُ إِلى اِقتِضاءِ دُيوني",24,"ن",2,0],["يا ظَبيَةَ المَيدانِ واحَرَبا","مِن سِحرِ أَجفانٍ تُمَرِّضُها",25,"ض",3,1],["يا ظالِمَ الفِعلِ وَمَظلومَ النَظر","وَيا كَئيباً وَقَضيباً وَقَمَر",26,"ر",1,1],["يا ظالِمي لَيسَ المُحِب","بُ وَإِن تَجَلَّدَ مِن رِجالِك",27,"ك",1,0],["يا ظَبيُ يا اِبنَ سِيارٍ","وَزَينَ صَفِّ القِيانِ",28,"ن",1,1],["يا ظالِماً عَقَدَ اليَدَينِ مُصَلِيّاً","مِن دونِ ظُلمِكَ يُعقَدُ الزُنّارُ",29,"ر",1,1],["يا ظَبيُّ ما أَنتَ وَالضُرغامُ تُؤَنِّسُهُ","إِنَّ الضَراغِمَ مِن أَخلاقِها الشَرَسُ",30,"س",1,0],["يا ظلم ان طالَت يد لَك برهة","فالعَدل لَيسَ ذراعه بِقَصير",31,"ر",1,0],["يا ظبية علقتني في تصيدها","أشراكها وهي لم تعلق بأشراكي",32,"ك",2,1],["يا ظُبَا لَحظِي خُذِي لي رأْسَهُ","فَهْوَ لا شَكَّ مِن أهلِ الرِّيبِ",33,"ب",1,0],["يا ظلامَ الحياةِ يا رَوْعة الحُزْ","نِ ويا مِعْزَفَ التَّعيسِ الغَريبِ",34,"ب",1,0],["يَا ظَبْيَةَ الْمِقْيَاسِ هَذَا مَدْمَعِي","فَرِدِي وَهَذَا رَوْضُ قَلْبِي فَارْتَعِي",35,"ع",2,0],["يا ظُلْمةً في خاطري مثْلُها","للهِ ما أكثف هذا الجناح",36,"ح",1,0],["يا ظاهرا بكمالات الظهور على","كل الظواهر في سُلطان مقتهر",37,"ر",1,0],["يا ظالم الحياة ما أعدل القبر","تساوى فيه الوجود جميعه !",38,"ع",2,0],["يا ظالم الشعبِ مظلوماً بفعلته","عليك ام منك يبكي الشعب منتحبا",39,"ب",2,0],["يا ظلمةً قد طبقّتْ موطني","دومي : فشعبي لا يُريد الصّباح",40,"ح",1,0],["ياظامي أنا أظما .. ومتشبع حروق","واذاك ظامي للمواصل أنا هلك",41,"ك",1,0],["يا ظباءَ الأمويينَ اضحكي","تضحكُ الدنيا ويغمرها الصفاء",42,"ا",2,0],["يا ظالم التّفاح في وجناتها","لو ذقت بعض شمائل التفّاح",43,"ح",1,0],["يا ظباء الرياض باللَه عطفاً","لمحب أورثتموه انذهالا",44,"ل",2,0],["يا ظريف الطباع قربت بعدت","لعمري الضدان لا يجمعان",45,"ن",1,0],["يا ظالماً حسنه رويدك ما","أرخص حسناً تجنه الظلم",46,"م",1,0],["يا ظبية الوادي ولا واد إذا","ما كنت فيه ولا هناك حزون",47,"ن",1,0],["يا ظبية الوادي وما الوادي إذا","لم تؤنسيه ومن أنا لولاك",48,"ك",1,0],["يا ظامئاً والدِماءُ تَجري","منه لِيَروي بها سواه",49,"ه",1,0],["يَا ظَلاَمَ الزَّوَالِ قَد خِلتَ ظُلمِى","هَيِّناً لاَ أَرُدُّ عني الظَّلُومَا",50,"م",2,0],["ياظبي هل من لفتةٍ يا غصنُ هل","ما عطفةٍ فالنفس زاد ضناها",51,"ا",3,0],["يا ظالِماً في كُلِّ أَفْعالِهِ","مَا شِئْتَ فَاصْنَعْ فَلَنا مَوْقِفُ",52,"ف",1,1],["يا ظالما جار فيمن لا نظير له","إلا المهيمن لا تغتر بالمهل",53,"ل",1,0],["يا ظَبيَ سِنجار أما ترثى لمن","قد صار من أجلك في كفِّ الأَجَل",54,"ل",1,1],["يا ظَبيَةً أَشبَه شَيءٍ بِالمَها","تَرعى الخُزامى بَينَ أَشجارِ النَقا",55,"ا",1,1],["يا ظبيتي إني أتيتك لاجئا","فسلي الطفيلة سوفَ تُنْبيكِ الخَبر",56,"ر",1,0],["يا ظبية الحيّ التي أمّت به","جلل الخطوب مهامها ريدا",57,"د",2,0],["يا ظبية الغورِ لا نهوى النجادَ ولا","نبغي من العيش في أطلالكم حِوَلا",58,"ل",2,0],["يا ظلة الموج يطغى البحر منتفضاً","بها كأن جبل في البحر يقتلع",59,"ع",1,1],["يا ظلاماً أحبّ من كلِّ نُورِ","ليس فِعلُ الهتُوكِ فِعلَ السُّتُورِ",60,"ر",1,1],["يا ظبية البان يا غصن النقا النضر","استغفر اللّه بل يا طلعة القمر",61,"ر",1,1],["يا ظبية مذ أقبلت تعطو","صارت عليَّ كشر رئبال",62,"ل",1,0],["يا ظَبيَةً من ظِباءِ الأُنسِ راتِعةً","بَينَ القُصورِ تعالى اللَهُ باريكِ",63,"ك",1,1],["يا ظالِماً حَكَّمتُه فاِعتَدى","اليكَ أَشكو مِنكَ يا ظالِمي",64,"م",2,0],["يا ظبيةً ترعى ربيع حشاشتي","م