{"poems":[[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[53,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[55,"يا طول همي بما لا يعلم الناس","https://www.aldiwan.net/poem26276.html","البسيط"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"قعدت شعوب الشرق","https://www.aldiwan.net/poem10860.html","مجزوء الكامل"],[86,"كم ذا يكابد عاشق ويلاقي","https://www.aldiwan.net/poem10915.html","الكامل"],[71,"قل للنجيب ولا تعبأ بلحيته","https://www.aldiwan.net/poem3773.html","البسيط"],[71,"كم ذا التبظرم زائدا عن حده","https://www.aldiwan.net/poem3822.html","الكامل"],[73,"كم ذا أريد ولا أراد","https://www.aldiwan.net/poem11863.html","مجزوء الكامل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[93,"ألشعر من مبدأ الخلق","https://www.aldiwan.net/poem11098.html","المجتث"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[72,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"حرمان ذي أدب وحظوة جاهل","https://www.aldiwan.net/poem64099.html","الكامل"],[51,"بلاغة ابن فراس","https://www.aldiwan.net/poem64938.html","المجتث"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[91,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[91,"وتينة غضة الأفنان باسقة","https://www.aldiwan.net/poem8825.html","عموديه"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[91,"تلك المازل كيف حال مقيمها","https://www.aldiwan.net/poem62713.html","عموديه"],[91,"ما عز من لم يصحب الخذما","https://www.aldiwan.net/poem62738.html","عموديه"],[70,"كم ذا التجنب والتجني","https://www.aldiwan.net/poem42446.html","مجزوء الكامل"],[70,"كم ذا التصاغر والتصابي","https://www.aldiwan.net/poem43006.html","مجزوء الكامل"],[85,"أما العتاب فبالأحبة أخلق","https://www.aldiwan.net/poem61200.html","عموديه"],[62,"سعدت بطول بقائك الحقب","https://www.aldiwan.net/poem52479.html","أحذ الكامل"],[80,"شوقي إليك مجدد","https://www.aldiwan.net/poem31468.html","مجزوء الكامل"],[80,"فارقتكم وفراقكم صعب","https://www.aldiwan.net/poem31571.html","أحذ الكامل"],[44,"عنت فأعرض عن تعريضها أربي","https://www.aldiwan.net/poem29680.html","البسيط"],[69,"قل للألى حسدوا علاي وشهرتي","https://www.aldiwan.net/poem28401.html","الكامل"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[69,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[81,"أهدى نسيم الصباح","https://www.aldiwan.net/poem61390.html","المجتث"],[52,"أنظر إلى الجزر الذي","https://www.aldiwan.net/poem26791.html","مجزوء الكامل"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[106,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[91,"الفيلسوف المجنح","https://www.poetsgate.com/ViewPoem.aspx?id=53013",""],[91,"الى الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=53275",""]],"verses":[["كَم ذابِلٍ قادَ الجِيا","دَ القُبَّ يَعلُكُنَ الشَكيما",0,"م",2,0],["كَم ذاهِبٍ أَبكى النَواظِرَ مُدَّةً","وَمَضى وَطابَ لِمُقلَةٍ تَهويمُها",1,"م",3,0],["كَم ذَلَّلَ العُدمُ العَزيزَ وَعَظَّمَت","نَفَحاتُ هَذا المالِ غَيرَ عُظامِ",2,"م",1,0],["كَم ذَميلٍ إِلَيكُمُ وَوَجيفِ","وَصُدودٍ عَنّا لَكُم وَصُدوفِ",3,"ف",1,1],["كَم ذا الأَمانُ وَلِلنا","ئِباتِ سَلبٌ وَجَذبُ",4,"ب",1,0],["كَم ذي هَوىً لَيسَ إِلّا اللَهُ يَعلَمُهُ","قَد ماتَ شَوقاً وَلَم يَعلَم بِهِ الناسُ",5,"س",1,0],["كَم ذاتِ خِدرٍ يَومَ طافَ بِكَ الرَدى","هَتَكَت عَلَيكَ حَرائِرَ الأَستارِ",6,"ر",1,0],["كَم ذا نُحيلُ عَلى غَدٍ","وَغَدٌ مَصيرَ اليَومِ صائِر",7,"ر",1,0],["كَم ذا يُكابِدُ عاشِقٌ وَيُلاقي","في حُبِّ مِصرَ كَثيرَةِ العُشّاقِ",8,"ق",1,1],["كَم ذا التَبَظرُمِ جُزت الحَدَّ صَفعَنَةً","ما أَنتَ إِلّا قَليلَ العَقلِ ذَقنُ حرا",9,"ر",2,0],["كَم ذا التَّبَظرُمُ زائِداً عَن حَدِّهِ","ما كانَ قَبلكَ هَكَذا الحُدبانُ",10,"ن",1,1],["كَم ذا أُريدُ وَلا أُرادُ","يا سوءَ ما لَقِيَ الفُؤادُ",11,"د",1,1],["كَم ذا التَجَلُّدُ لَن يُساعِفَكَ الهَوى","بِالوَصلِ إِلّا أَن يَطولَ نِجادُ",12,"د",1,0],["كَمْ ذَاتِ تاجٍ أَجَادَتْ","عَرُوضَهُ وَالرَّوِيَّا",13,"ي",2,0],["كم ذا أُعَلِّل بالحديث وبالمنى","قلباً كما شاء الغرام عليلا",14,"ل",2,0],["كم ذا التعلُّلُ والأيّام تمطلُني","كأنَّها لم تجِدُ عن ذاك مُنْتَذَحا",15,"ح",2,0],["كم ذا عليك القلب تلهبُ ناره","هذا وذكرك للقلوبِ خليل",16,"ل",1,0],["كم ذاد عنك من الهجاء غريبةً","لا يستطيع ذِيادها الذُّوَّادُ",17,"د",1,0],["كم ذا التفكر في الزمان وإنما","تزداد فيه عمىً إذا تتفكر",18,"ر",1,0],["كم ذاتِ طرفٍ ربوخٍ","وذاتِ ساق رقوص",19,"ص",1,0],["كَم ذا الجُحودِ وَمالُكُم رَهنُ البَلا","وَبِمَ الغُرورُ وَكُلُّكُم لِفَناءِ",20,"ا",2,0],["كَم ذا نُفَتِّشُ في السُفوح وَفي الذُرى","وَنقاءُ أَقرَبُ مِنهُ لِلمُتَصَيِّدِ",21,"د",1,0],["كَم ذا أُكَلِّفُ نَفسي فَوقَ طاقَتِها","وَلَيسَ لي بَل لِغَيري الفَيء وَالثَمَرُ",22,"ر",1,0],["كَم ذا الصُدود وَلا ذَنبٌ جَنَتهُ يَدي","أَرِو بِكَ الصَفوَ لا أَرجو بِكَ الكَدَرا",23,"ر",2,0],["كَم ذا تَشُعُّ وَلا تُضيءُ عُلومُها","سُرُجُ الظَلامِ إِذَن جَليلُ عُلومِها",24,"م",3,0],["كَم ذا تُنادِهِم وَقَد هَجَعوا","أَحَسِبتَ أَنَّكَ تُسمِعُ الرِمَما",25,"م",2,0],["كَم ذا التَجَنُّبُ وَالتَجَنّي","ما كانَ هَذا فيكَ ظَنّي",26,"ن",2,1],["كَم ذا التَصاغُرُ وَالتَصابي","غالَطتِ نَفسَكِ في الحِسابِ",27,"ب",1,1],["كَم ذُبتَ مِن حُرَقِ الجَوى وَاليَومَ مِن","أَسَفٍ عَلَيهِ وَحَسرَةٍ تَتَحَرَّقُ",28,"ق",1,0],["كم ذمةٍ لك غيرُ مُخْفَرَةٍ","قد شُدَّ فوق عِنَاجِها الكَرَبُ",29,"ب",1,0],["كَم ذا يُغَيِّرُني هوا","ك بِخَلقك المُتَغَيِّرِ",30,"ر",1,0],["كم ذا يزورُ البحرَ بحرُ أسى","في العين منك جُمانُهُ رطبُ",31,"ب",1,0],["كَم ذُقتُ في الدَهرِ مِن عُسرٍ وَمِن يُسُرٍ","وَفي بَني الدَهرِ مِن رَأسٍ وَمِن ذَنَبِ",32,"ب",1,0],["كم ذا أجدُّ وتلعبونَ ألم تروا","أني امرؤٌ دأبُ العلومِ ودابي",33,"ي",1,0],["كم ذا أُسوِّفُ بالمتابِ توانيا","حقٌّ لدمعي بالدما أن يُمْزَجا",34,"ج",2,0],["كمْ ذا أصاحبُ ذا جهلٍ أُساءُ بهِ","ترى السلامةَ منهُ خيرُ مكتسَبِ",35,"ب",1,0],["كَم ذا تَكَتَّمَ وَجدا","أَذابَ قَلبي زَفيرُه",36,"ه",1,0],["كَمِذَبَّةٍ مِن سُندُسٍ","وَبِها نِصابٌ مِن عَقيقِ",37,"ق",1,0],["كَم ذَمَّهُم جَهلاً وَأَنكَرَ حالَهُم","قَوْمٌ يَلُونَ الحُكْمَ والتَّدرِيسا",38,"س",2,0],["كَم ذا أُبَكِّتُكُم وَلَمْ تَستَنكِفُوا","أنْ تَسْمَعُوا التَّبْكِيتَ والتَّخجِيلا",39,"ل",2,0],["كم ذكرياتٍ في الحياةِ عزيزةٍ","مَرَّت عليَّ فكنتِ أغلاهُنَّ",40,"ن",1,0],["كَمْ ذُدْتَ عَنْ حَقٍ وَكَمْ سَدَّدْتَ مِنْ","رَأْيٍ وَكَمْ بدَّدْتَ شَمْلَ ضَلاَلِ",41,"ل",1,0],["كم ذاتِ دَل تشتهي","ما فوق خدِّك من ورود",42,"د",1,0],["كم ذرةٍ في فضاء الله سابحة","فيها: عوالمُ لا تُحْصَى، وأكوان!",43,"ن",1,0],["كم ذاتِ جفنٍ فاترٍ","صالت بعزمٍ غيرِ فاتر",44,"ر",1,0],["كم ذا تُلحُّون ان تَستَوقِدوا قَبَساً","من الرَمادِ ومِمَّن ماتَ مُرتَجَعا",45,"ع",2,0],["كم ذا يسرُّك أن تفوتَك ساعةٌ","طالت أأنت إلى الممات عجول",46,"ل",1,0],["كم ذا يصعّرُ أقوام خدودَهم","كفاهم عِبرةٌ في خدك التَّرِب",47,"ب",1,0],["كم ذا تفتّش في السفوح وفي الذّرى","عنقاء أقرب منه للمتصيّد",48,"د",1,0],["كم ذا تناديهم وقد هجعوا","أحسبت أنّك تسمع الرّمما",49,"م",2,0]]}