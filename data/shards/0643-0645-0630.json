rses":[["كَم ذابِلٍ قادَ الجِيا","دَ القُبَّ يَعلُكُنَ الشَكيما",0,"م",2,0],["كَم ذاهِبٍ أَبكى النَواظِرَ مُدَّةً","وَمَضى وَطابَ لِمُقلَةٍ تَهويمُها",1,"م",3,0],["كَم ذَلَّلَ العُدمُ العَزيزَ وَعَظَّمَت","نَفَحاتُ هَذا المالِ غَيرَ عُظامِ",2,"م",1,0],["كَم ذَميلٍ إِلَيكُمُ وَوَجيفِ","وَصُدودٍ عَنّا لَكُم وَصُدوفِ",3,"ف",1,1],["كَم ذا الأَمانُ وَلِلنا","ئِباتِ سَلبٌ وَجَذبُ",4,"ب",1,0],["كَم ذي هَوىً لَيسَ إِلّا اللَهُ يَعلَمُهُ","قَد ماتَ شَوقاً وَلَم يَعلَم بِهِ الناسُ",5,"س",1,0],["كَم ذاتِ خِدرٍ يَومَ طافَ بِكَ الرَدى","هَتَكَت عَلَيكَ حَرائِرَ الأَستارِ",6,"ر",1,0],["كَم ذا نُحيلُ عَلى غَدٍ","وَغَدٌ مَصيرَ اليَومِ صائِر",7,"ر",1,0],["كَم ذا يُكابِدُ عاشِقٌ وَيُلاقي","في حُبِّ مِصرَ كَثيرَةِ العُشّاقِ",8,"ق",1,1],["كَم ذا التَبَظرُمِ جُزت الحَدَّ صَفعَنَةً","ما أَنتَ إِلّا قَليلَ العَقلِ ذَقنُ حرا",9,"ر",2,0],["كَم ذا التَّبَظرُمُ زائِداً عَن حَدِّهِ","ما كانَ قَبلكَ هَكَذا الحُدبانُ",10,"ن",1,1],["كَم ذا أُريدُ وَلا أُرادُ","يا سوءَ ما لَقِيَ الفُؤادُ",11,"د",1,1],["كَم ذا التَجَلُّدُ لَن يُساعِفَكَ الهَوى","بِالوَصلِ إِلّا أَن يَطولَ نِجادُ",12,"د",1,0],["كَمْ ذَاتِ تاجٍ أَجَادَتْ","عَرُوضَهُ وَالرَّوِيَّا",13,"ي",2,0],["كم ذا أُعَلِّل بالحديث وبالمنى","قلباً كما شاء الغرام عليلا",14,"ل",2,0],["كم ذا التعلُّلُ والأيّام تمطلُني","كأنَّها لم تجِدُ عن ذاك مُنْتَذَحا",15,"ح",2,0],["كم ذا عليك القلب تلهبُ ناره","هذا وذكرك للقلوبِ خليل",16,"ل",1,0],["كم ذاد عنك من الهجاء غريبةً","لا يستطيع ذِيادها الذُّوَّادُ",17,"د",1,0],["كم ذا التفكر في الزمان وإنما","تزداد فيه عمىً إذا تتفكر",18,"ر",1,0],["كم ذاتِ طرفٍ ربوخٍ","وذاتِ ساق رقوص",19,"ص",1,0],["كَم ذا الجُحودِ وَمالُكُم رَهنُ البَلا","وَبِمَ الغُرورُ وَكُلُّكُم لِفَناءِ",20,"ا",2,0],["كَم ذا نُفَتِّشُ في السُفوح وَفي الذُرى","وَنقاءُ أَقرَبُ مِنهُ لِلمُتَصَيِّدِ",21,"د",1,0],["كَم ذا أُكَلِّفُ نَفسي فَوقَ طاقَتِها","وَلَيسَ لي بَل لِغَيري الفَيء وَالثَمَرُ",22,"ر",1,0],["كَم ذا الصُدود وَلا ذَنبٌ جَنَتهُ يَدي","أَرِو بِكَ الصَفوَ لا أَرجو بِكَ الكَدَرا",23,"ر",2,0],["كَم ذا تَشُعُّ وَلا تُضيءُ عُلومُها","سُرُجُ الظَلامِ إِذَن جَليلُ عُلومِها",24,"م",3,0],["كَم ذا تُنادِهِم وَقَد هَجَعوا","أَحَسِبتَ أَنَّكَ تُسمِعُ الرِمَما",25,"م",2,0],["كَم ذا التَجَنُّبُ وَالتَجَنّي","ما كانَ هَذا فيكَ ظَنّي",26,"ن",2,1],["كَم ذا التَصاغُرُ وَالتَصابي","غالَطتِ نَفسَكِ في الحِسابِ",27,"ب",1,1],["كَم ذُبتَ مِن حُرَقِ الجَوى وَاليَومَ مِن","أَسَفٍ عَلَيهِ وَحَسرَةٍ تَتَحَرَّقُ",28,"ق",1,0],["كم ذمةٍ لك غيرُ مُخْفَرَةٍ","قد شُدَّ فوق عِنَاجِها الكَرَبُ",29,"ب",1,0],["كَم ذا يُغَيِّرُني هوا","ك بِخَلقك المُتَغَيِّرِ",30,"ر",1,0],["كم ذا يزورُ البحرَ بحرُ أسى","في العين منك جُمانُهُ رطبُ",31,"ب",1,0],["كَم ذُقتُ في الدَهرِ مِن عُسرٍ وَمِن يُسُرٍ","وَفي بَني الدَهرِ مِن رَأسٍ وَمِن ذَنَبِ",32,"ب",1,0],["كم ذا أجدُّ وتلعبونَ ألم تروا","أني امرؤٌ دأبُ العلومِ ودابي",33,"ب",2,0],["كم ذا أُسوِّفُ بالمتابِ توانيا","حقٌّ لدمعي بالدما أن يُمْزَجا",34,"ج",2,0],["كمْ ذا أصاحبُ ذا جهلٍ أُساءُ بهِ","ترى السلامةَ منهُ خيرُ مكتسَبِ",35,"ب",1,0],["كَم ذا تَكَتَّمَ وَجدا","أَذابَ قَلبي زَفيرُه",36,"ه",1,0],["كَمِذَبَّةٍ مِن سُندُسٍ","وَبِها نِصابٌ مِن عَقيقِ",37,"ق",1,0],["كَم ذَمَّهُم جَهلاً وَأَنكَرَ حالَهُم","قَوْمٌ يَلُونَ الحُكْمَ والتَّدرِيسا",38,"س",2,0],["كَم ذا أُبَكِّتُكُم وَلَمْ تَستَنكِفُوا","أنْ تَسْمَعُوا التَّبْكِيتَ والتَّخجِيلا",39,"ل",2,0],["كم ذكرياتٍ في الحياةِ عزيزةٍ","مَرَّت عليَّ فكنتِ أغلاهُنَّ",40,"ن",1,0],["كَمْ ذُدْتَ عَنْ حَقٍ وَكَمْ سَدَّدْتَ مِنْ","رَأْيٍ وَكَمْ بدَّدْتَ شَمْلَ ضَلاَلِ",41,"ل",1,0],["كم ذاتِ دَل تشتهي","ما فوق خدِّك من ورود",42,"د",1,0],["كم ذرةٍ في فضاء الله سابحة","فيها: عوالمُ لا تُحْصَى، وأكوان!",43,"ن",1,0],["كم ذاتِ جفنٍ فاترٍ","صالت بعزمٍ غيرِ فاتر",44,"ر",1,0],["كم ذا توالى عليها الدهر تولية","نصب الأئمة عقدا زان منتظما",45,"م",2,0],["كم ذا يناغيكم مبير خادع","أطرق كرى ان النعام في القرى",46,"ا",1,0],["كم ذا تُلحُّون ان تَستَوقِدوا قَبَساً","من الرَمادِ ومِمَّن ماتَ مُرتَجَعا",47,"ع",2,0],["كم ذا يسرُّك أن تفوتَك ساعةٌ","طالت أأنت إلى الممات عجول",48,"ل",1,0],["كم ذا يصعّرُ أقوام خدودَهم","كفاهم عِبرةٌ في خدك التَّرِب",49,"ب",1,0],["كم ذا تفتّش في السفوح وفي الذّرى","عنقاء أقرب منه للمتصيّد",50,"د",1,0],["كم ذا تناديهم وقد هجعوا","أحسبت أنّك تسمع الرّمما",51,"م",2,0],["كم ذا الصّدود ، ولا ذنب جنته يدي","أرجو بك الصّفو لا أرجو بك الكدرا",52,"ر",2,0],["كم ذا اقول وجدا","والقلب غير سالي",53,"ل",2,0],["كم ذا اداري في هواك عواذلي","والموت دون شماتة العذال",54,"ل",1,0],["كم ذا ينوح على الأعتاب من شجن","وكم يصيح على الأبواب من ألم",55,"م",1,0],["كم ذاقَ كأسَ الهَجْرِ؟ لَكِنَّه؛","أَوجعَهُ مِنْ حِبِّهِ غَدْرُهُ",56,"ر",2,0],["كم ذا تفتِّشُ عن مُواسٍ أو مُعين","هيهاتَ إِنَّ الناس مثلُك أجمعين",57,"ن",1,0],["كم ذى حُلِىٍّ وقد أزرَى به عَطَلٌ","وعاطل ليس يدرى أنه حالِ",58,"ل",1,0],["كم ذا على التعليل تحيا مهجةٌ","بمُديتَىْ بينٍ وهجرٍ تُعتَرقْ",59,"ق",1,0],["كَم ذَلَّلَت صَعباً وَرَدَّت ذاهِباً","وَحَمَت أَذَلَّ وَذَلَّلَت جَبّارا",60,"ر",2,0],["كَم ذاهِبٍ عَمَرَت لَهُ أَخبارُهُ","لَمّا تَقَضّى عُمرُهُ أَعمارا",60,"ر",2,0],["كمذْهَبِ النونِ من الكتابِ","في لازَوَرْدِيٍّ عَلَى محرابِ",61,"ب",1,0],["كم ذا أؤنبه وفي تأنبيه","تقريض خالفة من الأنباء",62,"ا",2,1],["كَم ذا المُقامُ عَلى ذُلٍّ وَمَنقَصَةٍ","وَكَم أُجَرَّعُ كَأسَ الضَيمِ مَلآنا",63,"ن",2,0],["كَم ذا التَغافُلُ عَمّا قَد مُنِيتُ بِهِ","وَكَم أَهُزُّكُمُ مَثنى وَوُحدانا",63,"ن",2,0],["كم ذا التهاونُ في هُون الخُمول فقُم","واقْصِد مثالَ المعالي غيرَ مُفتصِد",64,"د",1,0],["كم ذممنا قوما فلمّا بلونا","غيرهم عاد فيهم التفضيل",65,"ل",1,0],["كم ذا الوقوف بباب الدار مستترا","أقصر فإنك مرموق ومرصود",66,"د",1,0],["كَم ذا ظُلمتُ وكَم أتيتُ مظالِما","بِحياتهِ اِرحم ظالِماً مَظلوما",67,"م",2,0],["كم ذوّبت فيها كبو","دٌ واكتوت فيها أضالع",68,"ع",1,0],["كَم ذا أَراك تَميلُ عَن","مُضناك يا غصنَ الأَراك",69,"ك",1,0],["كَم ذا تَحِنَّ لها وَحظُّك عندها","دلٌّ يُقابِل بِالمِطال هَواكا",70,"ك",2,0],["كم ذا التجنِّي عليَّ ظالمةً","وكم على حَتْفِ مهجتي أَجْني",71,"ن",2,0],["كم ذا التمادي دعى التعليل وابتدرى","إلى الحمى فعنائي في تماديكي",72,"ك",2,0],["كَم ذَبَّ عَنهُ مُصالِتاً كَيدَ العِدى","بِذُبابِ ما ضي الشَفرَتَينِ صَنيعِ",73,"ع",1,0],["كَمْ ذَا تُقَرْطِسُنِي بِسُمْرِ نِبَالِهَا","سُودُ الْخُط