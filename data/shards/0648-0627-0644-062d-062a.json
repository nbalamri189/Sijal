{"poems":[[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[73,"ظننت سليمانا جوادا يهزه","https://www.aldiwan.net/poem3738.html","الطويل"],[85,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[48,"بين الغريزة والرشاد نفار","https://www.aldiwan.net/poem22580.html","الكامل"],[48,"أعرض عن الثور مصبوغا أطايبه","https://www.aldiwan.net/poem22915.html","البسيط"],[48,"حيران أنت فأي الناس تتبع","https://www.aldiwan.net/poem22940.html","البسيط"],[48,"الموت ربع فناء لم يضع قدما","https://www.aldiwan.net/poem23085.html","البسيط"],[519,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90974","الكامل"],[4440,"","https://poetry.dctabudhabi.ae/diwan/poem/145995","الكامل"],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""]],"verses":[["والحَتْفُ غَايَةُ مَنْ يَرُوحُ وَيَغْتَدي","فَإِذَا فَرَرْتَ إِلَيْهِ مِنْهُ الْمَهْرَبُ",0,"ب",1,0],["وَأَلَحتُ حَتّى صَرَّحَ الشِعرُ قائِلاً","أَرِحني فَما تَرجو بِميتٍ تُخاطِبُه",1,"ب",2,0],["وألحت يا شمس الهداية كوكباً","يعشْي سناه كلَّ من يتأمّلُ",2,"ل",1,0],["وَالحَتفُ أَنصَفَ بَينَهُم لَم تَمتَنِع","مِنهُ الرِئالُ وَلا نَجا الأَغفارُ",3,"ر",1,0],["وَالحَتفُ مِثلُ غَمامٍ جادَ وابِلُهُ","وَالناسُ يُدعَونَ لَو أَغنى الدُعاءُ قَطِ",4,"ط",1,0],["وَالحَتفُ كَالثائِرِ العادي يُصَرِّعُنا","وَالأَرضُ تَأكُلُ هَلّا تَكتَفي الضَبُعُ",5,"ع",1,0],["وَالحَتفُ أَيسَرُ وَالأَرواحُ ناظِرَةٌ","طَلاقَها مِن حَليلٍ طالَما فُرِكا",6,"ك",2,0],["والحتفُ يترعُ كاساتِ النّجيعِ به","والرُمْحُ يهتزّ نَشواناً بخَمرِتهِ",7,"ت",2,0],["والحتم في رجب ينادي ارخوا","نعم المصير لجنة ومراحم",8,"م",1,0],["وألحت الأيام في استغفارها","لذنوبها حتى التقت بغفورها",9,"ر",3,0],["والحتفُ يغشى كل من وطِئ الثرى","ومن اعْتلى فوق الذرى يتصيّدُ",10,"د",1,0]]}