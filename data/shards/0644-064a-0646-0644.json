{"poems":[[55,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[55,"لكم حرم الله المعظم لا لنا","https://www.aldiwan.net/poem29813.html","الطويل"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[65,"نظرت خلال الركب والمزن هطال","https://www.aldiwan.net/poem46217.html","الطويل"],[75,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[90,"قضى والليل معتكر بهيم","https://www.aldiwan.net/poem45034.html","الوافر"],[90,"أبو غازي قضى فاقيم غازي","https://www.aldiwan.net/poem45037.html","الوافر"],[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[49,"هي الدار من سلمى وهاتي المرابع","https://www.aldiwan.net/poem25232.html","الطويل"],[74,"وعيشك لولا سقم جسمي والبكى","https://www.aldiwan.net/poem19216.html","الطويل"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[53,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[45,"ألا لا أرى الأحداث حمدا ولا ذما","https://www.aldiwan.net/poem10543.html","الطويل"],[47,"جدد بكاء لبين جديد","https://www.aldiwan.net/poem63514.html","المتقارب"],[47,"جعلت فداك لي خبر طريف","https://www.aldiwan.net/poem64530.html","الوافر"],[47,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[68,"لئن لم يمض لي حد فكم قد","https://www.aldiwan.net/poem40666.html","الوافر"],[68,"لئن لم أبرقع بالحيا وجه عفتي","https://www.aldiwan.net/poem41571.html","الطويل"],[46,"أنضيت في هذا الأنام تجاربي","https://www.aldiwan.net/poem30064.html","الكامل"],[107,"بني مصر ما للطامعين وما لكم","https://www.aldiwan.net/poem43152.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140896",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54688","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54628","الوافر"],[10,"","https://poetry.dctabudhabi.ae/diwan/poem/2126","الوافر"],[53,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[90,"قضى والليلُ مُعتكر بهيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19508&r=&rc=11",""],[154,"لأهل الهوى في الدمع والسهد لذة","https://www.aldiwan.net/poem68549.html","الطويل"],[186,"حياة أسر العيش فيها مذمم","https://www.aldiwan.net/poem67033.html","الطويل"],[186,"إليك على البعاد مثال صب","https://www.aldiwan.net/poem67036.html","الوافر"],[203,"أراك الحمى هل قبلتك ثغورها","https://www.aldiwan.net/poem45651.html","الطويل"],[215,"مصائب أشتات ينلن من الحشا","https://www.aldiwan.net/poem46638.html","الطويل"],[215,"مصائب أشتات ينلن من الحشا منال","https://www.aldiwan.net/poem46809.html","الطويل"],[234,"معانيك أمضى من شبا قضب الهند","https://www.aldiwan.net/poem51165.html","الطويل"],[235,"لئن لزمت خمولي يا أبا حسن","https://www.aldiwan.net/poem4060.html","البسيط"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[366,"لقد شاقني هذا القوام المهفهف","https://www.aldiwan.net/poem68090.html","الطويل"],[422,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[438,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[447,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[447,"أرى بدرا فصار به هلالا","https://www.aldiwan.net/poem14472.html","الوافر"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[466,"حلفت بما شادت تميم من العلى","https://www.aldiwan.net/poem15122.html","الطويل"],[482,"هي العيس دعها بي إلى حاجر تحدى","https://www.aldiwan.net/poem15248.html","الطويل"],[482,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[521,"ألا حي قبل البين أم حبيب","https://www.aldiwan.net/poem48718.html","الطويل"],[541,"أمن طيف سلمى بالبطاح الدمائث","https://www.aldiwan.net/poem23872.html","الطويل"],[567,"رأى قصب السباق بنو الزمان","https://www.aldiwan.net/poem52896.html","الوافر"],[567,"تقول لقلبي ربة الأعين النجل","https://www.aldiwan.net/poem52902.html","الطويل"],[567,"أتعلم ما هاجت بقلبي من الشغل","https://www.aldiwan.net/poem52926.html","الطويل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83290","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53772","الكامل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53746","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59817","الطويل"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145616","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120052","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120097","الوافر"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31560","الطويل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198171","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109195","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50042","المتقارب"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44821","الطويل"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131412","الطويل"],[2288,"","https://poetry.dctabudhabi.ae/diwan/poem/144278","الهزج"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76025","الطويل"],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132222","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100401","البسيط"],[2886,"","https://poetry.dctabudhabi.ae/diwan/poem/147791","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109844","المتقارب"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103499","المتقارب"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140233",""],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127910","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74047","الهزج"],[3479,"","https://poetry.dctabudhabi.ae/diwan/poem/101959","الطويل"],[3498,"","https://poetry.dctabudhabi.ae/diwan/poem/157805","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63012","المجتث"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45760","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85252","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131285",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54457","الوافر"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141173","الوافر"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146760","المتقارب"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130602","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33308","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120528","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139629",""],[5132,"عصيت الْهوى واطعت الْعُدُول","https://www.poetsgate.com/ViewPoem.aspx?id=189686",""],[5232,"تأمُّلات","https://www.poetsgate.com/ViewPoem.aspx?id=212284",""],[5362,"أأحمد يابن خير الخلق طرا","https://www.poetsgate.com/ViewPoem.aspx?id=170335",""],[5480,"الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=9889",""],[402,"عيون الحلى تلك المناقب والعلى","https://www.poetsgate.com/ViewPoem.aspx?id=35412",""],[402,"وداعا أيها الخدن الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=35114",""],[5784,"ما نفع نصح","https://www.poetsgate.com/ViewPoem.aspx?id=190163",""],[5809,"حديث الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=205630",""],[6033,"تَصَبَّرْ!","https://www.poetsgate.com/ViewPoem.aspx?id=215799",""],[6042,"إِذا مَا ضَاقَ صَدْرِي لم أجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=189800",""],[4222,"أظنهم وقد عزموا ارتحالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52863&r=&rc=155",""]],"verses":[["لَئِن لَم تَجِد طائِعاً بِالنَوالِ","لَقَد جادَ عَنكَ الخَيالُ المُلِم",0,"م",1,0],["لَئِن لَم تُصَبِّحكُم بِها مُستَغيرَةٌ","كَصَكَّةِ أَنفِ المَرءِ يَتبَعُها الدَمُ",1,"م",1,0],["لَئِن لَم نُطِل لَدمَ التَرائِبِ لَوعَةً","فَإِنَّ لَنا لَدماً وَراءَ التَرائِبِ",2,"ب",1,0],["لَئِنْ لوَّحَتْنا الشّمسُ والبُرْدُ مُنْهِجٌ","فَقَد يَبلُغُ المَجْدَ الفَتى وهْوَ أسْمالُ",3,"ل",1,0],["لَئِن لَبِسَ المُلكَ رَحبَ المُلا","إِ فَاِختالَ مِنهُ بِذَيلٍ رَفَل",4,"ل",1,0],["لئن لم تبك من أسف عليه","سفاهتنا فقد بكت الحلوم",5,"م",1,0],["لئن لبسوا الحداد عليك حزناً","فقد ألبستهم ثوب اعتزاز",6,"ز",1,0],["لَئِن ليمَت بَنو جُشَمَ بنِ بَكرٍ","بِعاجِنَةِ الرَحوبِ فَقَد أَلاموا",7,"م",3,0],["لَئِن لَم أُخَلِّ العيسَ وَهيَ لَواغِبٌ","حَدابيرَ مِن طولِ السَرى وَظَوالِعُ",8,"ع",1,0],["لئن لم يسر في بحر شعري فقد سرى","بأشعار سقمي في بحورِ مدامعي",9,"ي",1,0],["لئن لم تكن بالهاشميين عاهةٌ","لما شَكْلُكُم تالله إلا المُعلْهجُ",10,"ج",1,0],["لئن لزَّك الجهلُ في عُقدةٍ","من الشرِّ تأبى على الناشط",11,"ط",1,0],["ليِّنٌ للمُلاينين أبِيٌّ","إن رأى منهمُ غموط اللِّيان",12,"ن",1,0],["لَئِن لَذَّ يَومُ الشامِتينَ بِيَومِها","فَقَد وَلَدَت مِنّي لِأَنفِهِمُ رَغما",13,"م",2,0],["لَئِن لَم تَكُن سَلوَةٌ فَالحِما","مُ يَكونُ قِصارَ المُحِبِّ العَميدِ",14,"د",1,0],["لَئِن لَم تَفدِهِ تَفديكَ نَفسي","بِذَبحٍ فَهوَ في غَدِهِ نَحيرُ",15,"ر",1,0],["لَئِن لَم تَمُت نَهبَ السُيوفِ وَلَم تُقِم","بَواكيكَ أَطرافُ الوَشيجِ المُقَوَّمِ",16,"م",1,0],["لَئِن لَم يَمضِ لي حَدٌّ فَكَم قَد","فَلَلتُ الحَدَّ في الحَربِ العَوانِ",17,"ن",1,1],["لَئِن لَم أَبَرقِع بِالحَيا وَجهَ عِفَّتي","فَلا أَشبَهَتهُ راحَتي في التَكَرُّمِ",18,"م",1,1],["لِيَنَل عَدُوٌّ مِن عَدُوٍّ إِنَّما","يَعفو وَيَصفَحُ صاحِبٌ عَن صاحِبِ",19,"ب",1,0],["لَئِن لَم تَهَبّوا هَبَّةَ اللَيثِ زائِراً","لَتَمسُنَّ مِن زورِ الحَديثِ المُرَجَّمِ",20,"م",1,0],["لئن لذ يوم الشامتين بموتها","فقد ولدت مني لآنفهم رغما",21,"م",2,0],["لَئِنْ لَمْ يُتَحْ لِي أَنْ أَرَاكَ مُهنِّئاً","لَقَدْ يُمْنَعُ المَأمُولُ ثُمَّ يُتَاحُ",22,"ح",1,0],["لَئِنْ لَمْ تَجْزَ فِي دَنْيَاكَ خَيْراً","لَرَبُّكَ فِي السَّمَاءِ هُوَ المُثِيبُ",23,"ب",1,0],["لَئِن لَم أُؤتَ مِن نَفسي نَصيباً","لَقَد أَودى الزَمانُ إِذاً بِصَخرِ",24,"ر",1,0],["لينٌ للمُلاينين أبيْ","يٌ إن رأى منهم غموط اللِّيان",25,"ن",1,0],["لئن لم تبك من أسف عليه","سفاهتنا بكت الحلوم",26,"م",1,0],["لَئن لم أنَل منك المُنى فَلِعِلَّةٍ","وإن نِلتُها يَوماً فَلَستُ لهَا أهلا",27,"ل",2,0],["لَئن لَم تُصِب عَينِي ثَراهُ فَإِنَّ لي","هُنالك قَلباً مِنهُ قَد قَطر الدَّمُ",28,"م",1,0],["لَئِن لَم تَلقَ مِنهُ سِوى خَيالٍ","فَإِنِّي صِرتُ بَعدَكُمُ خَيالا",29,"ل",2,0],["لئِن لم يكُن للظبيِ سِحرُ عيونها","فما شيمةُ الغزلانِ إلا نُفورها",30,"ر",3,0],["لئن لم بين طوعا عن النيل غاصبٌ","نرى لبثه فينا اضر من الكفر",31,"ر",1,0],["لئن لم يبن طوعاً عن النيل غاصب","نرى لبثهُ فينا أضر من الكفر",32,"ر",1,0],["لئن لَؤُمتْ فيك الليالي لقد بدا","لها منك ماضي العزم والحزم والجِدّ",33,"د",1,0],["لِئنْ لِزمْتُ خُمُولي يا أبا حَسنٍ","فلمْ ُيِزلْني عنْ مَجْدِي وعلْيَاِئي",34,"ي",1,1],["لئن لم أتابع زهده وتقاءه","فإني له في صحة العقد اتبع",35,"ع",1,0],["لَئِن لامَني في صَبوَتي فيهِ لائِم","فَما هُوَ اِلّا حاسِد أَو مُخَوّف",36,"ف",1,0],["لئن لَعِبت فيه السوافي وبرّحت","فقد كانَ قبل اليوم للسِّرْب مَلْعبا",37,"ب",2,0],["لئن لزّنى الدهرُ في حلبةٍ","غريتُ بأحمرِها أحمري",38,"ر",2,0],["لئن لم ترجعوا يا أَهل نزوى","عن الحال الَّذي فيكم أَراها",39,"ا",3,0],["لئن لم تفكروا فيما عناكم","وان تدعوا النزال ولا نزالا",40,"ل",2,0],["لئن لم يَنل من عمره غيرَ ذكره","فإنَّ أَجلَّ العمرِ ما شَعَّ بالذِّكر",41,"ر",1,0],["لئن لم تلُذْ بالود من بعد نَبْذهِ","ملاذَ الأراوى بالجبالِ الفوارع",42,"ع",1,0],["لئن لم أجدْ في حبَّ جُملٍ على الهوى","جميلاً ولم تُسْعِفْ باِسعادِها سُعدى",43,"د",2,0],["لئن لا مني العُذّالُ فيها فما لهم","ضلوعي التي مِن جمرِ الغَضا تُحنى",44,"ن",2,0],["لَئِن لَم تَكُن حُبّيك حبا صدقته","فَما احد عِندي اِذن بِحَبيب",45,"ب",1,0],["لَئِن لَم يُفيقوا عاجِلاً مِن ضَلالِهِم","وَلَستُ إِذا آلَيتُ قَولاً بِحانِثِ",46,"ث",1,0],["لَئِنْ لم يَشرَبوا بِدِنانِ قومٍ","فقد يُرْوى الظَما رَشْحُ الدِّنانِ",47,"ن",1,0],["لئنْ لَم يصِبْ ذاك الثَّناءُ فحبَّذا","تكلُّفُ مثلِ الشَّيخِ ذلكَ من أجلي",48,"ل",2,0],["لئن لم يكُ الفاروقُ أخلَفَ غيرَهُ","منَ النَسلِ أغنَى القومَ عن كثرةِ النسلِ",49,"ل",1,0],["لئن لم يكن هدى النبي محمد","وليس عليه أمره فله أردد",50,"د",1,0],["لئن لم يكن هذا بنص مقرر","ولا فعل أصحاب النبي محمد",50,"د",1,0],["لَئِن 