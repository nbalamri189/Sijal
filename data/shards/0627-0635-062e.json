{"poems":[[75,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[75,"أصخ لمقالتي واسمع","https://www.aldiwan.net/poem11966.html","مجزوء الوافر"],[31,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[45,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[99,"يا أيها العالي الغفور الصفوح","https://www.aldiwan.net/poem24918.html","السريع"],[46,"أأحمد إن الحاسدين حشود","https://www.aldiwan.net/poem30555.html","الطويل"],[76,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141014",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39549","الطويل"],[92,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[139,"لعمرك ما الخدود ولا السوالف","https://www.aldiwan.net/poem49051.html","الوافر"],[147,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[154,"أصخ فلخير العالمين مناقب","https://www.aldiwan.net/poem68460.html","الطويل"],[228,"أيا جرسا في هوة الدمع ناحبا","https://www.aldiwan.net/poem41638.html","الطويل"],[240,"أثقل ظهري بالمنن","https://www.aldiwan.net/poem31740.html","مجزوء الرجز"],[285,"ألا من مبلغ عني عليا","https://www.aldiwan.net/poem60781.html","الوافر"],[287,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[287,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[287,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[287,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[304,"أصخر بن عبد الله خذها نصيحةً","https://www.aldiwan.net/poem425.html",""],[408,"أصخ لشكيتي وارفق","https://www.aldiwan.net/poem46718.html","مجزوء الوافر"],[409,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[445,"أصخ نحوي لدعوة مستقل","https://www.aldiwan.net/poem34755.html","الوافر"],[458,"أهذا هو الفنان نسمعه فنا","https://www.aldiwan.net/poem61703.html","الطويل"],[463,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[466,"وراءك أقوال الوشاة الفواجر","https://www.aldiwan.net/poem15085.html","الطويل"],[484,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[534,"أصخ لمقال فهو ردء الرباق وحلها","https://www.aldiwan.net/poem37460.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54099","البسيط"],[804,"","https://poetry.dctabudhabi.ae/diwan/poem/73829","الطويل"],[842,"","https://poetry.dctabudhabi.ae/diwan/poem/138065","الطويل"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/120172","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70836","الوافر"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67735","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117775","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11899","الطويل"],[1618,"","https://poetry.dctabudhabi.ae/diwan/poem/202611","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49582","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49583","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46437","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53220","المتقارب"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111071","الطويل"],[2269,"","https://poetry.dctabudhabi.ae/diwan/poem/144605","البسيط"],[2398,"","https://poetry.dctabudhabi.ae/diwan/poem/178020","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100296","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201403","الطويل"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203629","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74060","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74039","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129482","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202338","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135436","الخفيف"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103544","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103550","الطويل"],[4488,"","https://poetry.dctabudhabi.ae/diwan/poem/131003","الرجز"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35077","الوافر"],[4755,"وطن على السرير","https://www.poetsgate.com/ViewPoem.aspx?id=204338",""],[5190,"الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=68760",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5459,"أنسام الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=190890",""],[6183,"شموخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79825&r=&rc=15",""]],"verses":[["أَصِخ لِهَمسِ عِتابٍ تَحتَهُ مِقَةٌ","وَكَلِّفِ النَفسَ مِنها فَوقَ ما تَسَعُ",0,"ع",1,0],["أَصِخ لِمَقالَتي وَاِسمَع","وَخُذ فيما تَرى أَو دَع",1,"ع",1,1],["أَصِخ يا اِبنَ ثَفرِ الكَلبِ عَن آلِ دارِمٍ","فَإِنَّكَ لَن تَسطيعَ تِلكَ الرَوابِيا",2,"ي",2,0],["أَصَخرَةٌ أَنا مالي لا تُحَرِّكُني","هَذي المُدامُ وَلا هَذي الأَغاريدُ",3,"د",1,0],["أصِخ لهذي الأرضِ واسمع لما","تشكو لمن غَيرك يوماً تبوح",4,"ح",1,0],["أَصِخ تَستَمِع حُرَّ القَوافي فَإِنَّها","كَواكِبُ إِلّا أَنَّهُنَّ سُعودُ",5,"د",1,0],["أَصَختُ إِلَيهِ وَهوَ أَخرَسُ صامِتٌ","فَحَدَّثَني لَيلُ السُرى بِالعَجائِبِ",6,"ب",1,0],["أصخرةٌ أنا ؟ ما لي لا تغيّرني","هذي المدام ولا هذي الأغاريد",7,"د",1,0],["أصِخْ أيها الوادي أما منك صرخةٌ","يدوِّي صداها في عميق السرائرِ",8,"ر",1,0],["أصِخْ لتلحينِ روحي وهي ناقمةٌ","فما يهزُّك لحنُ الروحِ إن تَطِب",9,"ب",1,0],["أصخْ سمعاً فإن القوم ضلوا","وجاروا في غوايتهم طوائفْ",10,"ف",1,0],["أَصَختَ إِلى داعي الوَغى وَتَصامُموا","وَصَدَّقتَ آمالَ العُفاةِ وَكَذَّبوا",11,"ب",3,0],["أَصِخ إِلى الدَهرِ تَسمَع قَولَهُ طَرَباً","هَذا وَلِيُّ عَلِيٍّ صَفوَةُ بنُ عَلي",12,"ل",2,0],["أصخ فلخير العالمين مناقب","تدل على التمكين والشرف الأسرى",13,"ر",2,1],["أَصخ عِندَما الحَفّارُ بَعد تَهَدُّمي","يُعيد بَقايا العفر مِنِّيَ لِلعَفرِ",14,"ر",1,0],["أَصِخ لَها مَدائِحاً","قَد حَكَمَت لي بِاللَسَن",15,"ن",1,0],["أَصِخْ لِيَبُثَّكَ الإِسْلامُ شَكْوى","تُلِينُ لَهُ الْقُلُوبَ الْقاسِياتِ",16,"ت",1,0],["أَصِخ مُحَمَّدُ إِنّي جِدُّ مُعتَذِرٍ","إِنَّ المُقَصِّرَ فيما قالَ يَعتَذِرُ",17,"ر",1,0],["أَصِخ تَستَمِع ناصِحاً يا أَخا ال","صَفاءِ وَدَع قَرعَ سِنِّ النَدَم",18,"م",1,0],["أَصِخ لاستِماعِ القَصيدِ الَّتي","تُعَبِّرُ عَن سُؤدَدِ القائِلِ",19,"ل",1,0],["أَصِخ لِقَريضٍ بَديعِ النِظامِ","أَصفى مِن الدُرِّ وَصفاً وَأَنقى",20,"ق",2,0],["أَصخَرُ بنَ عَبدِ اللَهِ خُذها نَصيحَةً","وَمَوعِظَةً للمَرءِ غَيرِ المُتَيَّمِ",21,"م",1,1],["أَصَخرُ بنَ عَبدَ اللَهِ قَد طالَ ما تَرى","وَإِلّا تَدَع بَيعا لِعِرضِكَ يُكلَمُ",21,"م",1,0],["أَصَخرُ بنَ عَبدِ اللَهِ إِن تَكُ شاعِراً","فَإِنَّك لا تُهدي القَريضَ لِمُفحَمِ",21,"م",1,0],["أَصَخرُ بنَ عَبدِ اللَهِ قَد طالَ ما تَرى","وَمِن لَم يَكرِم نَفسَهُ لَم يَكَرِّمِ",21,"م",1,0],["أَصَخرُ بنَ عَبدِ اللَهِ يَغوِ سادِراً","يُقَل غَيرَ شَكٍّ لِليَدَينِ وَلِلفَمِ",21,"م",1,0],["أَصَخرُ بنَ عَبدَ اللَهِ هَل يَنفَعَنَّني","إِلَيكَ اِرتِجاعي أَفنُدي وَتَسَلُّمي",21,"م",2,0],["أصخْ لِشكيّتي وارفقْ","بجسْمٍ فيكَ قَد نحلا",22,"ل",2,1],["أصخ لي سمعاً هنا وقف","إن شأني كله عجب",23,"ب",1,0],["أَصِخْ نحوِي لدعوةِ مُستقلِّ","يُنادي من غَياباتِ الخُمُولِ",24,"ل",1,1],["أصخنا جميعاً لا نضيعُ لحظةً","كأنا شككنا بعدها أن نَرى أمنا",25,"ن",2,0],["أصخرةٌ قلبُك أم أنت عصاً","لا تنثني أم بك وَقْرٌ من صَمَمْ",26,"م",1,0],["أصختِ ولو أرعيت وجدي مسْمعاً","لَرُدَّ على أعقابه كلُّ فاجرِ",27,"ر",1,0],["أصخ بسمعك تلقاء الهتاف تجد","بحرا خضا من الأصوات يلتطم",28,"م",1,0],["أَصِخْ لِمقالٍ فَهْوَ رُدْءُ الرِّباقِ وحَلِّها","وَدَعْ مَنْ غَدا مُتْشفّعاً أو تَزَيّدا",29,"د",2,1],["أصِخْ لذكرِ محبٍّ لم يَزَلْ أبداً","يَرعى لكَ الحُبَّ رعياً غيرَ مُلْتَبِسِ",30,"س",1,1],["أَصِخ لِلَّذي لَم يَأتِ دَهرٌ بِمِثلِهِ","لَعَمري وَلَم يَسمَعُ بِهِ قَطُّ سامِعُ",31,"ع",1,1],["أصخ واستمع يا طالب الرشد ما الذي","به المصطفى قد خص والمرتضى علي",32,"ل",2,1],["اصخ لي أيها الملك الهمام","عليك صلاة ربك والسلام",33,"م",1,1],["أصخْ لي وامتثِلْ أمري","وخلِّ القيلَ والقالا",34,"ل",2,0],["أَصَخْرُ بنَ حربٍ لا نَعدّكَ سيّداً","فَسُدْ غَيْرَنا إنْ كنت لَسْتَ بسَيّدِ",35,"د",1,1],["أصخنا إلى تشبيبهم وغنائهم","فنحن سكوتٌ والهوى يتكلمُ",36,"م",1,0],["أَصِخ أَيُّها المَولى إِلَيّا وَلا تَقُل","مَضى ذَلِكَ الفَضلُ الَّذي كانَ يُعهَدُ",37,"د",1,0],["أصخ أذنا وانظر بعينك هل ترى","من الناس الا من عقامة يردف",38,"ف",1,0],["أصِخْ غيرَ مأمورٍ لإمرارِ لَوْعَةٍ","إذا مارَ دَمْعِي فارَ مِرْجَلُهَا يَغلي",39,"ل",2,0],["أصِخْ لِلهُدى من مسْعِدٍ وخُذِ المُنَى","على نسقٍ وانظرْ إلى النّجْمِ من عَلُ",40,"ل",1,0],["أَصخ لِشهودي ثُمَ ان كانَ مدفعٌ","لَدَيكَ فَغالَبَني فَإِني مَغالِب",41,"ب",1,0],["أصخ لصريح المديح الذي","يخوض من الفضل في كل فن",42,"ن",1,0],["أصخ هل تعي منهم إذا ما دعاهم","لمعضلة داع لهم من مجاوب",43,"ب",1,0],["أصِخْ مُصيخاً إليّ واسمعْ","دَعوايَ صِدقاً على غُلام:",44,"م",1,0],["أصخْتِ لأقوالِ الوُشاةِ فبِعتِني","وبائعُ مثلي يا لُميّاءُ خاسرُ",45,"ر",1,0],["أصخ بقيت لداع عز مورده","دعاك ساعة أعيى الورد والصدرُ",46,"ر",1,0],["أصختُ الى سجع الحمام صبيحةً","وقد أكلتْ قلبي الهموم النواهش",47,"ش",1,1],["أصخ إنما مدح الفتى وهجاؤه","لدى الطبن النقريس ذا توءم لذا",48,"ا",1,1],["أَصخ إِليّ تصخ مني وَمن قَلَمي","إِلى شكور لربّ الفَضل حمّادِ",49,"د",1,0],["أَصخ إِلى القبّة العَلياء عَن كثب","هناك تلقَ المَعالي كَيفَ تبتَكرُ",50,"ر",1,0],["أصخ لقول فنى يروي مواهبه","ودع مقالة من يروي عن الطائي",51,"ا",2,0],["أصخت الى قول العذول لعله","يطول فيجري ذكره في غصونه",52,"ن",2,0],["أصخِ للعاشقين فالعاشقون","لهم الأمن مع وهم مهتدون",53,"ن",1,1],["أصخ نحو حر الشعر من عبد أنعم","بدائعه ما زال منك يفيدها",54,"د",3,0],["أصخ لمناجاة الزمان فأنه","سيغينك عن جهر المقال سراره",55,"ر",2,0],["أصخ له سمعا وخذ بنصحه","في كل مسعاك تفز بنجحه",56,"ه",1,0],["أَصِخ لي كَيفَ شِئتَ فَإِنَّ أُنساً","لِنَفسِيَ أَن تُبَلِّغَكَ الخِطابا",57,"ب",2,0],["أصِخْ لِحَيٍّ فيكَ يَدرِي بما","تُرِيدُهُ، لكنَّهُ استَغربا",58,"ب",2,0],["أَصَختُ لَهَا سَمعاً، وفي العين عَبرَةٌ","وقلبي لَهَا مُصغٍ، ونَبضِي خَفُوقُ",59,"ق",1,0],["أصخر بن حرب عد في الناس مسلما","وقد فاه خوف السيف في قول كاذب",60,"ب",1,0],["أَصِخْ لِبَدْرٍ تُنِيرُ العُمْرَ بَسْمَتُهُ","أَتَرْتَضِي بَدَلاً عَنْ نُورِهِ زُحَلاَ..?!",61,"ل",2,0],["أَصِخْ أُذُنَيكَ، تَطَلَّعْ إِلَيَّ، تجدْ مُغرَقاً فِي هُمُومٍ ثِقالْ","يَلوبُ، يُجَدِّفُ فِي أبْحُرِ الوَهْمِ، يَبْحَثُ عَنْ مَرْفأٍ لا يُنالْ",62,"ل",1,0]]}