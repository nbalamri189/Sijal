{"poems":[[79,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[9,"لميثاء دار قد تعفت طلولها","https://www.aldiwan.net/poem21963.html","الطويل"],[87,"صغار في الذهاب وفي الإياب","https://www.aldiwan.net/poem7585.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[108,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[197,"أبا بشر ذهبت بكل أنس","https://www.aldiwan.net/poem13014.html","الوافر"],[214,"أوميض برق بالحمى يتوهم","https://www.aldiwan.net/poem13505.html","الطويل"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[358,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[408,"وبي معذر خد ورد وجنته","https://www.aldiwan.net/poem46748.html","البسيط"],[510,"التوبة","https://www.aldiwan.net/poem27892.html","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49974","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48929","المتقارب"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95393","البسيط"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113735","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137188",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94306","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93995","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94269","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94241","المتقارب"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122481","البسيط"],[3221,"","https://poetry.dctabudhabi.ae/diwan/poem/198685","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87385","الكامل"],[3287,"","https://poetry.dctabudhabi.ae/diwan/poem/116822","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86285","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17666","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35535","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69913","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107518","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95024","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141601","البسيط"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[4929,"القدس في آجامها أُسْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=199469",""],[5064,"لخَمرَةِ الرُّوحِ تارِيخٌ مِنَ الألَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=199169",""],[5189,"الحب نهرا","https://www.poetsgate.com/ViewPoem.aspx?id=213319",""],[5431,"وإذْ ترضى فهل يرضاه نبضٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190708",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""],[6218,"زمن أم عمرو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65904&r=&rc=57",""]],"verses":[["وآذَتْكَ في اللهِ العشيرةُ جُهْدَها","فجادَلْتَها بالحقِّ ألسِنَةً لُدّا",0,"د",2,0],["وَإِذ تَحسِبُ الحُبَّ الدَخيلَ لَجاجَةً","مِنَ الدَهرِ لا تُمنى بِشَيءٍ يُزيلُها",1,"ل",3,0],["وإذ تُقنى المعالي بالتمنى","وإذ يغزَى الأعادي بالسباب",2,"ب",1,0],["وإذ تعطَى الأريكة في النوادي","وتعطَى التاج في هزل الخطاب",2,"ب",1,0],["وَإِذْ تَسْتَبِينَا كُلُّ ذَاتِ مَلاَحَةٍ","لَهَا فِتْنَةٌ بِاللاَّعِبينَ لَعُوبُ",3,"ب",1,0],["وَإِذْ تَتَلَقَّانَا الصُّرُوفُ بِرَحْمَةٍ","وَيَنْحَازُ عَنَّا السَّهْمُ وَهْوَ مُصِيبُ",3,"ب",1,0],["وإذْ تتبارى في القريض ونَظْمِهِ","ونفتَنُّ فيه بنْيَةً، ومعانيا",4,"ي",2,0],["وَإِذ تَشدو لَنا بِرَقيقِ لَحنٍ","تقاصرُ عِندَهُ ألحانُ مَعبد",5,"د",1,0],["واذ تفوّه بالنوال فلفظه","كالدر في اسلاكه يتنظم",6,"م",1,0],["وإذ تستخِفُّ الأريحيّةُ رَبَّها","يَرى الموتَ سكراً والمرارةَ سُكّرا",7,"ر",2,0],["وَآذت قُريشٌ خَير جار وَسَيِّدٍ","وَلَولا مُراعاة الجِوار لَعُذِّبوا",8,"ب",3,0],["وإذ تنشَقْتُ من ريحان عارضِه","نشراً تعطّر منه كل مُنْتشِقِ",9,"ق",1,0],["وإذْ تحضرُ القلبَ فيغبرُ فرحُهُ","فقد بتَّ للنّزْرِ من الفرح ناعيهْ",10,"ي",2,0],["وإذ تحُلك آرامُ كوانسُ من","ظباء وَجْرة لا عُطْلٌ ولا نُفُرُ",11,"ر",1,0],["وإذ تكبرينَ غداً تعلمين","متاعبَ أيامك الماضيهْ",12,"ي",2,0],["وإذ تهيأت الأشكال وانفرشت","على المدارج من حلو ومن زفر",13,"ر",1,0],["وإِذ تمَّ منك الإذنُ هاجت بلابِلي","وثارت حُشاشاتي لكُم والشراشرُ",14,"ر",1,0],["واذ تربعت في عرش الجمال فان","اقصيتهم فامنحيهم ربطة الساق",15,"ق",1,0],["وإذ توفى وافته مبشرة","بالبشر من كل وجه أينما ولى",16,"ل",2,0],["وإذ تضوّع مسكاً ترب بقعته","وعن ندا أهله نار القرى تنبي",17,"ب",2,0],["وإذ تصدر للتدريس عن عظم","أرخته آمناً ختامه مسك",18,"ك",1,0],["وإذ تباهى الجيد بالعقد العظيم","نادى بأن أرخ بها الدر النظيم",19,"م",1,0],["وإذ تم حيث انتهى قلت أرخ","تمام نهاية روح البيان",20,"ن",1,0],["وإِذ تراءَت جُيُوشُ العيدِ زاحِفَةً","تَقهقَرَ النَّومُ والإمسَاكُ والنُّسُكُ",21,"ك",1,0],["وإذ تنْثني حولي غصون معاطف","تُأَطَّر من حَلْي بورْق سواجع",22,"ع",1,1],["واذ تذكَّرنا حديثَك فالطِلا","تَسبي قُلوباً للملا وَعقولا",23,"ل",2,0],["وإذ تسعى على قيس أَجِيراً","أبوك وأنتَ في ظلِّ الأجيرِ",24,"ر",1,0],["وَاِذ تَبَدّى بِجَنّات مُخَلَّدَة","مِن كُل فاكِهَة فيهِنَّ زَوجان",25,"ن",1,0],["وَاِذ تَعَوَّذتُ مِن تِلكَ السِهامِ بِهِ","فَقالَ يا ما تُقاسي في الهَوى وَتَرى",26,"ا",1,0],["وَاِذ تَمادَت بِذيّاكَ الدَلالِ فَكَم","قَد اِورَثَت في الهَوى عشاقَها نَصبا",26,"ا",1,0],["وَإِذ تَعطِفُ الأَرحامُ وَالوُدُّ بَينَنا","فَنَعفو عَنِ الذَنبِ العَظيمِ وَنَغفِرُ",27,"ر",1,0],["وَإِذ تسُدّ مسدَّ السَيفِ مُنفَرِداً","وَلا يَصُدّك لا جُبنٌ وَلا خورُ",28,"ر",1,0],["وَإِذ تَجَرَّعَ كاس الحزن مصطبراً","وَما بَدا مِنهُ في أَوصابِهِ ضجرُ",29,"ر",1,0],["وأَذ تقعُ الخطوبُ فنتَّقيها","وكلُّ سلاحنا أَدبٌ وفقرُ",30,"ر",1,0],["وإذ تكتب الأَنداء في شجراتهِ","وأَوراقها إملاءَ وُرقِ طيورِهِ",31,"ر",2,0],["وإذ توارى فبات الكون في كمدٍ","هذا كئيبٌ وذا بالخطب حيرانُ",32,"ن",1,0],["وإذ تبين نعشا للجنازة لم","يمرر به مع أليم النخس في الكتد",33,"د",1,0],["وَ إِذْ (تُوصِيكَ) يوماً : (رُدَّ حَقَّاً)","ألمْ تُخْبِرْكَ أنَّ (التِسْت) ك (العِرْ..) ؟",34,"ر",1,0],["وإذ تََكشَّفَ للأعيان . أمركُم","ومُيّزَ الغيُّ للرائينَ والرشدُ",35,"د",1,0],["وإِذْ تهادَيْتِ فِي ليلِي كأُغنِيَةٍ","قَدْ شظَّتِ الذَّاتَ نجمَاتٍ مِنَ النَّغَمِ",36,"م",1,0],["وإذ تمشينَ تهتزينَ رقصًا","تفتَّقَ تحتكِ الينبوعُ عطرَا",37,"ر",2,0],["وإذْ ترضى فهل يرضاه نبضٌ؟","إذا كان الغرام به عتيا؟!",38,"ي",2,1],["وإذ تتشابَكُ مِنَا ال","أصابعُ أو تُعتَصَرْ",39,"ر",1,0],["وإذ تربو غلال الحقد فينا","حقول الحب موئلها تبورُ",40,"ر",1,0]]}