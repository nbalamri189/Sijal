{"poems":[[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[9,"لميثاء دار قد تعفت طلولها","https://www.aldiwan.net/poem21963.html","الطويل"],[85,"صغار في الذهاب وفي الإياب","https://www.aldiwan.net/poem7585.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[194,"أبا بشر ذهبت بكل أنس","https://www.aldiwan.net/poem13014.html","الوافر"],[211,"أوميض برق بالحمى يتوهم","https://www.aldiwan.net/poem13505.html","الطويل"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[354,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[403,"وبي معذر خد ورد وجنته","https://www.aldiwan.net/poem46748.html","البسيط"],[506,"التوبة","https://www.aldiwan.net/poem27892.html","الطويل"]],"verses":[["وآذَتْكَ في اللهِ العشيرةُ جُهْدَها","فجادَلْتَها بالحقِّ ألسِنَةً لُدّا",0,"د",2,0],["وَإِذ تَحسِبُ الحُبَّ الدَخيلَ لَجاجَةً","مِنَ الدَهرِ لا تُمنى بِشَيءٍ يُزيلُها",1,"ل",3,0],["وإذ تُقنى المعالي بالتمنى","وإذ يغزَى الأعادي بالسباب",2,"ب",1,0],["وإذ تعطَى الأريكة في النوادي","وتعطَى التاج في هزل الخطاب",2,"ب",1,0],["وَإِذْ تَسْتَبِينَا كُلُّ ذَاتِ مَلاَحَةٍ","لَهَا فِتْنَةٌ بِاللاَّعِبينَ لَعُوبُ",3,"ب",1,0],["وَإِذْ تَتَلَقَّانَا الصُّرُوفُ بِرَحْمَةٍ","وَيَنْحَازُ عَنَّا السَّهْمُ وَهْوَ مُصِيبُ",3,"ب",1,0],["وإذْ تتبارى في القريض ونَظْمِهِ","ونفتَنُّ فيه بنْيَةً، ومعانيا",4,"ي",2,0],["وَإِذ تَشدو لَنا بِرَقيقِ لَحنٍ","تقاصرُ عِندَهُ ألحانُ مَعبد",5,"د",1,0],["واذ تفوّه بالنوال فلفظه","كالدر في اسلاكه يتنظم",6,"م",1,0],["وإذ تستخِفُّ الأريحيّةُ رَبَّها","يَرى الموتَ سكراً والمرارةَ سُكّرا",7,"ر",2,0],["وَآذت قُريشٌ خَير جار وَسَيِّدٍ","وَلَولا مُراعاة الجِوار لَعُذِّبوا",8,"ب",3,0],["وإذ تنشَقْتُ من ريحان عارضِه","نشراً تعطّر منه كل مُنْتشِقِ",9,"ق",1,0],["وإذْ تحضرُ القلبَ فيغبرُ فرحُهُ","فقد بتَّ للنّزْرِ من الفرح ناعيهْ",10,"ي",2,0]]}