{"poems":[[88,"لاح منها حاجب للناظرين","https://www.aldiwan.net/poem68836.html","الرمل"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[87,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[83,"هي طلعة السعد الأغر فمرحبا","https://www.aldiwan.net/poem61549.html","الكامل"],[48,"هي طرق فمن ظهور وأرحا","https://www.aldiwan.net/poem22729.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54761","الكامل"],[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[275,"مرت فحيتني وقد حييتها","https://www.aldiwan.net/poem35418.html","الكامل"],[333,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[563,"كفة الغيب كفة الحسنات","https://www.aldiwan.net/poem34721.html","الخفيف"],[572,"شئت في حالتي سرور وحزن","https://www.aldiwan.net/poem69586.html","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109266","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79980","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93620","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101598","الخفيف"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45780","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85188","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125877","الخفيف"],[4755,"عَرَبيٌّ في الجِيتُو","https://www.poetsgate.com/ViewPoem.aspx?id=215951",""],[4858,"من وحي اول زيارة لولدي الاسير","https://www.poetsgate.com/ViewPoem.aspx?id=138041",""],[4987,"قلوب الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=49574",""],[585,"حياك منهمرُ الغوادي الجون","https://www.poetsgate.com/ViewPoem.aspx?id=161937",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5277,"دروبُ الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=215844",""],[5628,"البحث عن بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=191332",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5954,"عهد التميمي","https://www.poetsgate.com/ViewPoem.aspx?id=195112",""],[5956,"بالشعر ألغي بعض موتي","https://www.poetsgate.com/ViewPoem.aspx?id=202515",""],[5956,"هدَّ انعطافي للرَّفاه قوايا","https://www.poetsgate.com/ViewPoem.aspx?id=210311",""],[5956,"عزرائيل هو إسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=215497",""],[6160,"‏حُبٌّ مَقْصُوصٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87415&r=&rc=33",""],[6198,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79295&r=&rc=69",""],[6300,"نرجسيّة قلمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82865&r=&rc=36",""]],"verses":[["هِيَ طَلعُ الرَوضِ نَوراً وَجَنىً","هِيَ نَشرُ الوَردِ طيبُ الياسَمين",0,"ن",1,0],["هي طيفُ الخيالِ يطرقُ أهل ال","أرض من بين ظاعنٍ ومقيم",1,"م",1,0],["هِيَ طاووسٌ وَهَل أَح","سَنُهُ إِلّا الذُنابى",2,"ب",2,0],["هِيَ طَلعَةُ السَعدِ الأَغَرِّ فَمَرحَبا","وَسَنا الرِئاسَةِ قَد أَضاءَ فَلا خَبا",3,"ب",2,1],["هِيَ طُرقٌ فَمِن ظُهورٍ وَأَرحا","مٍ وَدُنيا أَتَت بِظُلمٍ وَقَمرِ",4,"ر",1,1],["هِيَ طَاقَاتٌ مِنَ الزَّهْرِ لَهَا","فِي الْيَدِ البَيْضَاءِ آيَاتٌ تَرُوعْ",5,"ع",1,0],["هِيَ طَلْعَةٌ لَكَ فِي الحَيَاةِ وَغَيْبَةٌ","كَالظِّلِّ إِذْ يَبْدُو وَإِذْ يَتَبَدَّد",6,"د",1,0],["هيَ طيبةٌ حوتِ النبيّ الطيّبا","فَسَمت وكانت قبلُ تُدعى يثربا",7,"ب",2,0],["هي طفلةٌ بكرٌ ألذُّ من الكَرى","فلكم رأيتُ السَّعدَ منذُ رأيتُها",8,"ت",3,0],["هي طير مجنّح في السماوا","ت يغنّى الوجود لحن الغرام",9,"م",1,0],["هي طوراً به تلوح وطوراً","هو يبدو بها لأهل النجاة",10,"ه",1,0],["هِيَ طِيْبٌ وَالطَّيْبُ وَالْبَيْنُ شَيْبٌ","مُعْجِلٌ لِلْمُلُوكِ وَالْعُشَّاقِ",11,"ق",1,0],["هي طل الندى الجميل فلما","سقط الطل صار في الترب وحلا",12,"ل",2,0],["هي طوراً تكونُ رشداً لقومٍ","ولقومٍ تكونُ طوراً رجوما",13,"م",2,0],["هِيَ طاقَة الرَيحان شرف قَدرها","هادي الأَنام بَشيرها وَنَذيرها",14,"ر",3,0],["هي طير من الجماد كأن ال","جن في صدرها تحثّ خيولا",15,"ل",2,0],["هِيَ طَلعة النَجل السَعيد نَجابة","لَما تَبَدّت لاحَ صُبح مُزهِرا",16,"ر",2,0],["هي طلعة علوية نبوية","من نسل طه المصطفى المختار",17,"ر",1,0],["هي طوبى فلاسفِ الفكرِ في الشعرِ","ولكن أتى بها الإمكان",18,"ن",1,0],["هي طَعنَةٌ في الظَّهرِ غادِرةٌ","وسِوَاكَ لن يَأسَى، ولن يَأسُو",19,"س",2,0],["هي طلعةٌ رقصت لها الأشواق في الحلُم الجميلْ","وجهٌ توضّأ من عبير الذّكر، فاتّضح الدّليلْ",20,"ل",1,0],["هى طرتلى قديم الذكريات ولمحت","زول والا الحكايه كلبوها خيال",21,"ل",1,0],["هي طعنةٌ نفذت فكانت صرخةً","في العرب من ألم وبرح شجون",22,"ن",1,0],["هي طور من الوجود تحرى","هيكل الجسم معبراً وسبيلا",23,"ل",2,0],["هي طيبةٌ طابتْ مراضعُ جدِّها","عندَ الحجونِ وزمزَمِ الآلاءِ",24,"ا",2,0],["هيَ طينة ٌ للأرضِ مرجعها","أحببتها فسما بها الفكرُ",25,"ر",1,0],["هيَ طائِرُ الفينيقِ تخْرُجُ منْ","تَحْتِ الرَّمادِ بروْنَقِ الرّوبي !",26,"ب",2,0],["هي طفلةٌ لكنها شاخت فيا","أحلامَ عهدٍ في السما أقمارها",27,"ر",3,0],["هي طغمةٌ تبني جداراً ضدها","ما فاق أحلام الأعادي حُلْما",28,"م",2,0],["هي طفلة بقيت بكل نقائها","مِن دون أي شوائب وخفايا",29,"ا",3,0],["هي طعنة في صدر كل سعادةٍ","هي مَن تشيع الشر لو بذويها",30,"ي",3,0],["‏هِيَ طفْلَةٌ في الحبِّ لَكِنَّ الهَوَى","صَعْبٌ ... ورُوحُ العَاشقِينَ رخيصَهْ",31,"ص",2,0],["هي طائر.. قد أشرعوا في سجنه","باباً... فمدّ جناحهُ المغلولا",32,"ل",2,0],["هِيَ طفلة عَصَفَ الزمانُ بها","فتساقطتْ أوراقُها علنا",33,"ن",2,0]]}