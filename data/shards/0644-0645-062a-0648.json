{"poems":[[55,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[88,"رحم الله صاحب النظرات","https://www.aldiwan.net/poem10351.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[108,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[203,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[396,"حسين إعلم أن الشيطنه قد لها ناس","https://www.aldiwan.net/poem54560.html","عموديه"],[415,"أيا غائبا يدنيه شوقي على النوى","https://www.aldiwan.net/poem32328.html","الطويل"],[453,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[543,"قالوا المعري كافر","https://www.aldiwan.net/poem47481.html","عموديه"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63871","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50045","البسيط"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26428","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124719","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120634","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100345","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67994","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62947","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110091","السريع"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83176","الكامل"],[4789,"من أقاصي فراغ النشيد","https://www.poetsgate.com/ViewPoem.aspx?id=215709",""],[4929,"القدس بوابة العبور إلى المجد","https://www.poetsgate.com/ViewPoem.aspx?id=199179",""],[5013,"لي عزم كمرهف الحد ماض","https://www.poetsgate.com/ViewPoem.aspx?id=170968",""],[5038,"تبا لكم","https://www.poetsgate.com/ViewPoem.aspx?id=189960",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[6142,"لا تسل ما جرى بميلاده الأز","https://www.poetsgate.com/ViewPoem.aspx?id=155704",""]],"verses":[["لَم تُوَفِّ العِشرينَ سِنّي وَإِنَّ ال","حِلمَ مِنّي عَلى الجِبالِ لَموفي",0,"ف",2,0],["لَم تُؤَثِّل مِما كَسَبتَ وَلَم تَح","سِب عَلى ما أَرى حِسابَ المَماتِ",1,"ت",1,0],["لَمْ تُولِهِ الْمُفْنِيَاتُ السُّودُ أَجْمَعُهَا","رِقَابَ بِضْعَةِ شُجْعَانٍ بِهِمْ جَلَدُ",2,"د",1,0],["لم تُؤْتَ شعرًا مثل شع","ر أبي العلاءِ، أو الوليد",3,"د",1,0],["لم توف حق الشكر حتى استرجعت","صبرا بفقد الصابر الشكار",4,"ر",1,0],["لَم تؤثِّر فيهمُ بيضُ النقول","أَتُرى يَردَعُهم منّي الملام",5,"م",1,0],["لم تؤثر في قلبهِ نظراتٌ","ربما أثرتْ بجسمِ الجمادِ",6,"د",1,0],["لم تواتي علي المرتضى خيرة الناس","في زمانه ووقته ذاق منها تمراس",7,"س",1,0],["لَمُتُّ ومَا موتِي عَجيبُ وقد نأَت","بيَ الدّارُ عنه بل بَقَائِيَ أعْجَبُ",8,"ب",1,0],["لم توف أشواقي ولا لوعاتي","حق الهوى لكم ولا عبراتي",9,"ت",2,1],["لم تُؤَّلف احداثُها أو تُدوَّن","في القراطيس أو على الأحجارِ",10,"ر",1,0],["لم تُؤمِنوا إلا لِتا","بِع دينِكم إِن تُؤمِنوا",11,"ن",3,0],["لَم توطَ في حَوضٍ وَلَكِن خُلِّيَت","حَتّى جَرى مِنها السُلافُ فَسالا",12,"ل",2,0],["لم تؤلفنا المقاد","ير أمام الغالبينا",13,"ن",2,0],["لم تُواسِ الأطيارُ لم تُسْعِدِ الأو","تارُ إلا لِمُسْعِدٍ أو مُواس",14,"س",1,0],["لم تُولني منناً إلاّ وقابلها","رَطبٌ بحسن ثناءٍ ليس ينقطع",15,"ع",1,0],["لم توكل فرغان إلا بتفري","غ دناني وصبها في الجفان",16,"ن",1,0],["لَم تولِ أَيّامَ الإِمامِ حَفيظَةً","تُنجيكَ مِن غَمَراتِها يا أَحمَدُ",17,"د",1,0],["لم تؤت مما قبلها أو بعدها","شيئاً فكن ذا خبرةٍ وبيان",18,"ن",1,0],["لم توفِّ حَقَّ ما أوليتمُ","من يدٍ عُظمى يَداها ثَرّتان",19,"ن",1,0],["لم توَّفى نصاب سنّك حتى","غبت بدراً على الاهلَّة موفي",20,"ف",2,0],["لم تول تقطع المَسالك بَغْياً","كم نفوسٍ تسعى أراقت دماها",21,"ا",3,0],["لم تُواخذهم وصُنتَ عن اللو","مِ أَذاهم والمنطقِ اللذَّاعِ",22,"ع",1,0],["لم تُؤلَفِ التقوَى بربِّ الهَوَى","بينهما بَونٌ كضَبٍّ ونُون",23,"ن",1,0],["لم تؤخِّر ولم تُقدّم منايا","حكمة اللهِ سَوْرَة الأحزانِ",24,"ن",1,0],["لم توقر شيوخه لمشيبٍ","وليتم لم ترحم الأطفال",25,"ل",1,0],["لَم تُوهِ مِن أَخلاقِهِ أَسقامُه","وَلَو انَّها في شامِخٍ لتَصدَّعا",26,"ع",2,0],["لمْ توقظي قبل يوم البيْنِ قافيتي","لاشيء يقلقٌ في أحضانك القلما",27,"م",2,0],["لم تُوهِنِ الأرزاءُ عُودَكِ شدةً","أو نالَ شِأْوَ البينِ منكِ غرابُ *",28,"ب",1,0],["لم توف خمسا وعشرين سني","وإلي الزمان ألقى الزماما",29,"م",2,0],["لمْ تُؤمِنوا قَطُّ لا لَنْ تُؤمِنوا أبَداً","سِوى النّفاقِ بِهِ التّكْفيرُ يَقْتَرِنُ",30,"ن",1,0],["لم تؤذ أقواما كرام النفس في","سير الحياة الدائم الهيجان",31,"ن",1,0],["لمْ تُوَجّهْني يميناً أو يساراً","رغم أني لستُ إلَا كَمَقُودِ",32,"د",1,0],["لم توفق إلا حليمةُ سعد","ذات ثديين حافل وجمود",33,"د",1,0]]}