diwan/poem/83668","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198225","الخفيف"],[4888,"متشاعرون","https://www.poetsgate.com/ViewPoem.aspx?id=207680",""],[5054,"لا يا خليلي","https://www.poetsgate.com/ViewPoem.aspx?id=215692",""],[5131,"شرف الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=55359",""],[5213,"ما هز عطف الصب صبوه","https://www.poetsgate.com/ViewPoem.aspx?id=170568",""],[5431,"قطوف عشقٍ دانيه!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200580",""],[5449,"عيناكِ تشرين الكآبة","https://www.poetsgate.com/ViewPoem.aspx?id=189122",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5549,"هو بغية المتعلمين ومن بغى","https://www.poetsgate.com/ViewPoem.aspx?id=181312",""],[5672,"يا غيم","https://www.poetsgate.com/ViewPoem.aspx?id=206504",""],[5879,"الوجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=215458",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[6190,"حمَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87010&r=&rc=16",""],[463,"أنذرتني أمُّ سعدٍ أنَّ سعدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60043&r=&rc=99",""]],"verses":[["فَإِذا هُما اِتَفَقا تَكَسَّرَتِ القَنا","إِن غالَبا وَتَضَعضَعَ الجُلمودُ",0,"د",1,0],["فَإِذا هَبَطتِ إِلى بِلادٍ لَم تَزَل","تَجري كَواكَبُ أَهلِها بِالأَسعُدِ",1,"د",1,0],["فَإِذَا هَمَمْتَ بَلَغْتَ أَقْصَى غَايَةٍ","وَإِذَا رَأَيْتَ الْرَّأْيَ كَانَ لِزَامَا",2,"م",2,0],["فَإذَا هَمَمْتَ بَلَغْتَ كُلَّ مُمَنَّعٍ","وَإذَا رَأَيْتَ الرَّأَيَ لَيْسَ يَفيِلُ",3,"ل",1,0],["فَإِذَا هُمُ رَامُواْ لِمَجْدِكَ غَايَةُ","كَانَ الْقُصُورُ لَدَيْهِمُ إِدْرَاكَا",4,"ك",2,0],["فإذا هفَتْ هوجُ الخُطوبِ عَواصِفاً","وافَيْتُ رُكْناً منْ حِماكَ شَديدا",5,"د",2,0],["فَإِذَا هَمَمْتَ بَلَغْتَ كُلَّ مُمَنَّعٍ","وَإِذَا رَأَيْتَ الرَّأْيَ فَهْوَ صَوَابُ",6,"ب",1,0],["فَإذَا هِيَ اسْتَبْقَتْكَ بَيْنَ عُيُونِهَا","فَمِثَالُكَ المَشْهُودُ عَينُ مِثَالِهَا",7,"ل",3,0],["فإذا هوى من جوّه ثم استوى","أبصرتَ طيراً حول صورة آدم",8,"م",1,0],["فإذا هتفت بحمده وبشكره","ردّ الصدى بنيانها لهتافي",9,"ف",2,0],["فَإِذا هَزَزتُ قَطَعتُ كُلَّ ضَريبَةٍ","وَمَضَيتُ لا طَبِعاً وَلا مَبهورا",10,"ر",2,0],["فإذا همُ قد عاقبوه وقد عفوا","عنه لقد فعلوا الجميل وزادوا",11,"د",3,0],["فَإِذا هَفا بَرقُ المُنى وَهَفا لَهُ","هاجَت دَفائِنُهُ عَلَيهِ رُعودا",12,"د",2,0],["فَإِذا هُما مُتَحَيِّرانِ كِلاهُما","في عاشِقٍ مُتَحَيِّرٍ مُتَضَعضِعِ",13,"ع",1,0],["فَإِذا هَبَّ نَسيمٌ طَيِّبٌ","أَنا ذاكَ الوَقتَ سَلَّمتُ عَلَيك",14,"ك",1,0],["فَإِذا هِيَ اِجتَمَعَت لِمُلكِ جَبهَةً","كانَت حُصونَ مَناعَةٍ وَنِطاحِ",15,"ح",1,0],["فَإِذا هُما اِجتَمَعا لِنَفسٍ مِرَّةٍ","بَلَغَت مِنَ العَلياءِ كُلَّ مَكانِ",16,"ن",1,0],["فإذا هما اتحدا نظرت إلى","جسد صحيح الوزن معتدلِ",17,"ل",1,0],["فَإِذا هُمُ اِفتَخَروا بِهِ لَم يَبجَحوا","بِقَديمِ ما وَرِثوا مِنَ العَلياءِ",18,"ا",2,0],["فَإِذا هَمَّ بِالرُجوعِ إِلَيها","خاصَمَتهُ وَساوِسُ الأَحزانِ",19,"ن",1,0],["فإذا هما اصطحَبا على كَفِّ الفَتى","ضَرَّاه أو مَنحَاه نَفعاً عاجلاً",20,"ل",2,0],["فَإِذا هَزَزتَ الرُمحَ نَكَّسَ رَأسَهُ","وَأَجابَ ها إِنّي كَما عَوَّدتَني",21,"ن",2,0],["فَإِذا هُلهِلَ النَوالُ أَتَتنا","ذاتَ نَيرَينِ مُطبِقاتُ الأَيادي",22,"د",2,0],["فَإِذا هُما ذَهَبا تَهَدَّمَ حَوضُهُ","وَأَقامَ رَهنَ مَذَلَّةٍ وَصَغارِ",23,"ر",1,0],["فإذا هُمو جَهِلُوا فليس لدائِهم","طِبٌّ وليس لمثلِهم أن يَحْكُموا",24,"م",3,0],["فَإذَا هِلاَلُ الأفقِ قاَبَلَ وَجهَهُ","أبصَرتَهُ كَالشَّكلِ فِي مِرآتِهِ",25,"ت",2,0],["فَإِذا هُمُ رَأوا الرَغيفَ تَطَرَّبوا","طَرَبَ الصِيامِ إِلى أَذانِ المَغرِبِ",26,"ب",1,0],["فَإِذا هَمَمتَ وَلا هَمَمتَ بِهِ","فَبِشَعرَةٍ وَاِكتُب مِنَ البَحرِ",27,"ر",1,0],["فَإِذا هُنَّ قَد نَفَرنَ مِنَ الشَي","بِ وَأَوقَدنَ لِلوِداعِ وَقودا",28,"د",2,0],["فإذا هلكت وكل شيء هالك","فإليك أهدي يا بثين سلامي",29,"م",2,0],["فإِذا هَمَمْتَ بِزَجْرِهِ وَلَّى وَلا","يَثْنِيهِ عَمَّا قد تَعَوَّدَهُ طِلاب",30,"ب",1,0],["فَإِذَا هَوَتْ فَهِيَ الفِدَى لِبَقِيَّةٍ","شَتَّى الحِلَى مِنْ مَصْدَرٍ مُتَوَافِقِ",31,"ق",1,0],["فإِذا هُم ضَحِكوا إِلَيْكِ وَأَبْرَقَتْ","فِيهِمْ أَسَارِيرٌ لِلاسْتِبْشارِ",32,"ر",1,0],["فإذا هم مواثل نفضوا الأرماس","عنهم ومزقوا الأدهارا",33,"ر",2,0],["فإذا هموا راموا لمجدك غاية","كان القصور لديهم إدراكا",34,"ك",2,0],["فإذا هُمُ عادوا لماضي عهدهم","فغِرارُ سيفِكَ للعُصاة جزاءُ",35,"ا",2,0],["فإذا هُنَّ قدْ نفرْن مِن الشَّيْبِ","يب وأوقدن للوداع وقودا",36,"د",2,0],["فَإذا هُمُ افْتَخَرُوا بِهِ لمْ يبَجحوا","بِقَديمِ مَا ودِثُوا منَ العَلْياءِ",37,"ا",2,0],["فإذا هدّها الصراع اطمأنّت","ونجت في خيالها المصفود",38,"د",1,0],["فإذا هجته ترنّحت الأعلام","وازّيّنت لفتح جديد",39,"د",1,0],["فَإِذا هُمُ حَكَموا بِما يَهوَونَهُ","أَمَّت قَضاياكَ الكِتابَ المُنزَلا",40,"ل",2,0],["فإذا هممتَ بفتحِ مصرٍ واحدٍ","كشف الغطا وتفتّحت أَمصارُ",41,"ر",1,0],["فإذا هممت بمستحيل لم يكن","من كونه بد ولا أعذار",42,"ر",1,0],["فإذا هززت به رمت","بعقارب وخنافس",43,"س",1,0],["فإذاه آنا يعتذر","عنا وآناً يستتر !",44,"ر",1,0],["فَإِذا هَمَمتُ بِنَهضَةٍ أُعلي بِها","قَدري وَأَنشُرُ في البِلادِ فَضائِلي",45,"ل",2,0],["فإذا هما اجتمعا لِشَعبٍ صالحٍ","ما عادَ غيرَ مؤَمَّرٍ ومظفَّر",46,"ر",1,0],["فإِذا هممتُ به ترا","جَعَ ضاحكاً منّي وندّا",47,"د",2,0],["فَإِذا هِجتُها وَخافَت قَطيعاً","خَلَطَت مَشيَها بِعَدوٍ نِقالِ",48,"ل",1,0],["فإذاه حال الثائرين","وليس حال الشاكرين",49,"ن",1,0],["فإذا هم يشرون أيامه البيض","بأيام جدبه الحالكات",50,"ت",1,0],["فاذا هم تذكروا","قتله في البلاقع",51,"ع",1,0],["فَإِذا هِجناهُ يَوماً بادِناً","فَحِضَارٌ كَالضِّرامِ المُستَعِرْ",52,"ر",1,0],["فإذا هممتَ بأن تفُلَّ كتيبةً","لاقيتها فتسمَّ فيها واكتنِ",53,"ن",1,0],["فإذا هبَّتْ صَبَا أرضكمُ","حَملتْ تُربَ الغضا باناً ورَندا",54,"د",2,0],["فإذا هُمُ أصْغوا إلى أخبارهِ","عدل الظَّلومُ وجادَ كلُّ مُبخَّلِ",55,"ل",1,0],["فإذا هِجتَني فقد وَدّ من قب","لك مَن ودّ أنّه لم يَهِجْني",56,"ن",2,0],["فإذا هُم حلموا حلمتُ وفي","يومِ اِنتقامٍ جهلُهمْ جهلي",57,"ل",2,0],["فَإِذا هُمُ قِيسوا إليك فمثلُ مَنْ","قاسَ الذّراعَ طويلةً بالأذرُعِ",58,"ع",1,0],["فإذا هبَّت النفوس اشتياقا","وتشهَّى الخليل قربَ الخليلِ",59,"ل",1,0],["فإذا هَفَت من فوقها تحكي لنا","قمراً يُغيبُ بالظلامِ ويكسفُ",60,"ف",1,0],["فإذا هُمُ رَضِيَ الضعيفُ المشتكي","عنهم فقد غضب القوي الهاجم",61,"م",1,0],["فإذا هبَّ عاد فيه عماه","فبكى حسرةً من الحرمان",62,"ن",1,0],["فإذا همُ قَمَصُوا انتظارَ تأيَّةٍ","لم ينجهمْ بعضَ النجاءِ قِماص",63,"ص",1,0],["فإذا هبت به ريح الصبا","خلت في أعلاه وشيا أو زرد",64,"د",1,0],["فإذا هاله فظيع فخار","يتوارى بفضل ذيل الغمام",65,"م",1,0],["فإذا هاجت دعتهم وَلَداً","يا لَها والدة تدعو الوَلَدْ",66,"د",1,0],["فَإِذا هَمَّ بِأَمرٍ نالَهُ","فَسَواءٌ جَدَّ فيهِ وَمَزَح",67,"ح",1,0],["فَإِذا هَمَمنا لِلسَلام بِلَفظَةٍ قال","الوَداع لَنا أُريدُ قَصيدا",68,"د",2,0],["فاذا هوت دلوى تريد قليبها","جاءت بجندلها معا وترابها",69,"ب",3,0],["فإذا هي انحّطتْ فنشءٌ خاملٌ","وإذا ارتقتْ بشِّرْ بنشءٍ راقي",70,"ق",2,0],["فإذا هم اعتنقوا هناك وأرخيت","من دونهم حجب لهم وقباب",71,"ب",1,0],["فإذا هما اقترنا بأسعد ليلة","نشرا سعودهما على الآفاق",72,"ق",1,0],["فإذا هَوَى فِي جِدهِ ثُمَّ استَوَى","عَايَنْتَ طَيراً حَلَّ صُورَةَ آدَمِ",73,"م",1,0],["فإذا هي ثلاثاً طلقت","نفسها كان لها فيما اعتقد",74,"د",1,0],["فاذ اهم نظروا البغات استنسرت","واذا هم لحظوا اويس استأسدا",75,"د",2,0],["فَإِذا هُمُ اِعتَقَلُوا الرِماحَ رَأَيتَهُم","مِثلَ الرِماحِ سِواعِداً وَقُدُودا",76,"د",2,0],["فإذا هَمَمْتَ بهِمَّةٍ فاقرنْ بها","عَزَمات ماضٍ في المُلِم الناجِم",77,"م",1,0],["فاذا هم شهدوا الكريهة ابرزوا","غلباً تجعجع بالفريق ضواري",78,"ر",2,0],["فأذاها وقف على ساكنيها","والليالي لمصطفيها متون",79,"ن",1,0],["فإذا هَويت سَفلاً","فبروجُ السَّرَيانِ",80,"ن",1,0],["فَإذَا هُمَا خُلِقَا ليومِ مَعَادِنَا","فَهُمَا عَلى الأوقَاتِ فَانِيَتَانِ",81,"ن",1,0],["فَإِذَا هُمَا اجتَمَعَا لِقَلبٍ صَادِقٍ","شُدَّت رَكَائبُهُ إل الرَّحمنِ",81,"ن",1,0],["فَإِذَا هُمَا فُقِدَا فَمَا مَسلُوبُهَا","بِإلَه حَقٍّ وَهُوَ ذُو بُطلاَنِ",81,"ن",1,0],["فَإذَا هُمُ فَعَلُوهُ رَامُوا نَقلَهُ","لِمُرَكَّبٍ قَد حُفَّ بِالتِّبيَانِ",81,"ن",1,0],["فَإذَا هُمُ غَرَسُوا العَدَاوَة وَاظَبُوا","سَقيَ الغِرَاسِ كَفِعلِ ذِي البُستَانِ",81,"ن",1,0],["فَإذَا هُمُ احتَجُّوا عَلَيكَ فَقَل لَهُم","هَذَا مَجَازٌ وَهوَ وَضعٌ ثَانِ",81,"ن",1,0],["فَإذَا هِيَ اجتَمَعَت لِنَفسٍ حُرَّةٍ","بَلَغَت مِنَ العَليَاءِ كُلَّ مَكَانِ",81,"ن",1,0],["فإذا هما اجتمعا لصب وامق","بلغت به اللذات كل مكان",81,"ن",1,0],["فاذا هم رجعوا الى أهليهم","بمواهب حصلت من الرحمن",81,"ن",1,0],["فاذا هم سألوه مستندا له","قال اسمعوا ما قاله الرجلان",81,"ن",1,0],["فإذا هجرتَ يعودُ لي سقمي","وإذا وصلتُ برأتُ من سقمي",82,"ي",1,1],["فإذا هما يتناظران وهذه","شمس المساءِ تميل ف الميزان",83,"ن",1,0],["فإذا همُ وزنوكَ يوماً والضّحَى","رجحت بنورك كفةُ المِيزان",84,"ن",1,0],["فَإِذا هُمُ حَلُّوا الشُعورَ تَغَطَّت","صَفَحاتُ البُدورِ بِالدَّيجورِ",85,"ر",1,0],["فَإِذا هِيَ اِنزَلَجَت وَخالَجَها الهَوى","أَلفَيتَ وَازِعَها مِنَ الأَحشاءِ",86,"ا",2,0],["فإذا هي جماعة من بنات ال","ريح تطوي الفضاء عبر البحار",87,"ر",1,0],["فإذا همُ بعلومهمْ يوماً مشْوا","فبخُلقهم يتقهرون دهورا",88,"ر",2,0],["فَإِذا هَبّ نَسيمٌ","لَم تَجئ مَعهُ السُّموم",89,"م",1,0],["فإذا هللكت فرب خصم قائل","للّه درك من مثال سام",90,"م",1,0],["فإذا هَبّت رِياحٌ وَهمى","مَطَرٌ وَانتَشَرَت فَوقي الغُيوم",91,"م",1,0],["فَإِذا هَمو خلقوا القصور لراشدٍ","جَعَلوا عليه حرابهم قواما",92,"م",2,0],["فَإِذا همُ نَسَجوا عَلى","منواله عَزّوا وَجَلّوا",93,"ل",3,0],["فَإِذا هُمُ نَظَروا إلَيك فَأَعينٌ","حَسرى وَأَفئدةٌ تَقوم وَتَقعدُ",94,"د",1,0],["فَإِذا هُم اِقتَتَلوا وَشَذوا أَصلَحوا","ما بَينَهُم خَير مِن الإِجحاف",95,"ف",1,0],["فإذا هُمُ حرموا المَقاصدَ أَتعبوا","وَإذا هُمُ نالوا فظلٌّ وانتقل",96,"ل",1,0],["فإذا هم كفروا اياديكم فما","في هذه الدنيا الغرور وفاء",97,"ا",2,0],["فإذا هي انفصلت فليس يضير كم","أن تستطير بشرها الأخبار",98,"ر",1,0],["فإذا همَّ للمنا","مِ فقُوما وخفِّفا",99,"ف",2,0],["فأذا هبت شمال","فكأنا فى كنيف",100,"ف",1,0],["فَإِذا هَيَكَلٌ يَلوحُ عَلى الأُف","قِ عَلَيهِ مِنَ المَنايا شُحوبُ",101,"ب",1,1],["فإذا هزرت هزت منه أراكة","وإذا سألت سألت منه جمادا",102,"د",2,0],["فإذا هما والدين بينهما","لم يبق من امل ولم يذر",103,"ر",1,0],["فَإِذا هَفت بِكَ أَن نعم مِن جانب","الفَردوس أَسمعها تَحية شاعر",104,"ر",1,0],["فإذا هجرت فكل يوم نكبةٌ","وإذا وصلت فكل يوم عيدُ",105,"د",1,0],["فَ