َ غاياتِهِ الفِكْرُ",3,"ر",1,0],["وَفَضَّلتُ البِعادَ عَلى التَداني","وَأَخفَيتُ الهَوى وَكَتَمتُ سِرّي",4,"ر",2,0],["وَفَضلُ أَبي بَكرٍ إِذا ما ذَكَرتُهُ","رُميتُ بِنَصبِ عِندَ ذِكري لِلفَضلِ",5,"ل",1,0],["وفَضّ فَتيتَ المِسْكِ في جَنَباتِها","فأرْعَفَ آنافَ الشّقائِقِ والوَرْدِ",6,"د",1,0],["وَفَضَائِلُ الْفُضَلاَءِ يَذْهَبُ رَسْمُهَا","مَا لَمْ تُشَدْ بَصَحَائِفِ الْكُتَّابِ",7,"ب",1,0],["وَفَضِيحَةَ الْخَوَّانِ لَمَّا أَلْفِيَتْ","أَسْبَابُ مَنْ يَبْغِيهِ تَحْتَ ثيَابِهِ",8,"ب",2,0],["وَفَضيلَةٌ أَعيَت سِواكَ فَلَم","تَمدُد إِلَيهِ يَداً وَلَم يَصِلِ",9,"ل",1,0],["وَفَضَّلَ مِرداساً عَلى الناسِ حِلمُهُ","وَأَن كُلُّ هَمٍّ هَمَّهُ فَهوَ فاعِلُه",10,"ل",2,0],["وفضل ذاك الثبات يأتي","على الصعوبات أن يخونا",11,"ن",2,0],["وَفَضْلُ ذَاكَ الثَّبَاتِ يَأْبَى","عَلَى الصُّعُوبَاتِ أَنْ يَخُونَا",12,"ن",2,0],["وَفَضاءُ يَرجِعُ الطَرفُ بِهِ","قَبلَ أَن يَبلُغُ مَرماهُ البَصَرِ",13,"ر",1,1],["وَفَضلُ اِبنِ مَروانٍ سَيَثلِمُ ثُلمَةً","يَظَلُّ لَها الاِسلامُ لَيسَ لَهُ شِعبُ",14,"ب",1,0],["وَفَضلُ الناسِ في الأَنفُ","سِ لَيسَ الفَضلُ في الحالِ",15,"ل",1,0],["وَفَضلي تَعجِزُ الفُضَلاءُ عَنهُ","لِأَنَّكَ أَصلُهُ وَالمَجدُ تِربُ",16,"ب",1,0],["وفضائلاً كالرَّوض غنى ذكرُها","يا حبَّذا من روضةٍ غناء",17,"ا",2,0],["وفضائلٍ وأبيكَ ما ترَكت","للرّوض غير موَارثِ الأَبّ",18,"ب",1,0],["وفضائلاً فخرت على كأس الطلا","في الذوق فهي خليقة أن تنبذا",19,"ذ",2,0],["وفضائل مثل العرائس تجتلى","فلذاك في أفكاره تتخطَّر",20,"ر",1,0],["وفضله يقتضينا أن نقول فما","نعني سواه إذا فهْنا بأشعار",21,"ر",1,0],["وفضائل ما قد سمعت وإنها","لسامعِ الأشراف كالأشناف",22,"ف",1,0],["وفضل نظمٍ له من بيته شرفٌ","فهو الرضيّ وباقي النظم مشروف",23,"ف",1,0],["وفضلت الجوزا على البدرِ وجهه","وقالَ السهى للشمسِ لونك حائل",24,"ل",1,0],["وفضائل وضحت وحلت رتبة","فهي الكواكب في سناً ومنال",25,"ل",1,0],["وفضلٌ به الألفاظ للعجز أخرست","وعزٌ به قلب الحسود تكلما",26,"م",2,0],["وفضائل لذّت وعزّ مرامها","فكأنها شهدٌ يذاق وعلقم",27,"م",1,0],["وفضائل في الروض أودع نشرها","فترى النسيم لسائل نماما",28,"م",2,0],["وفضلُ جَداك بعدُ على جداهُ","مُبينٌ لا يُقابَلُ بارتيابِ",29,"ب",1,0],["وفضولُ الكلام أنفالُ أمثا","لي وأنفالك اللهى والسُّيُوبُ",30,"ب",1,0],["وفضائلٌ أُخَرٌ سواها لا تُرى","في تابع أبداً ولا متبوع",31,"ع",1,0],["وفَضلةٍ من عصيدةٍ خمختْ","وبائعُ الزينِ مُشتري الشين",32,"ن",1,0],["وَفَضلَةِ سَمنَةٍ ذَهَبَت إِلَيهِ","وَأَكثَرُ حَقِّهِ ما لا يَفوتُ",33,"ت",1,0],["وَفَضَضتُهُ وَكَأَنَّهُ","مِن حُسنِهِ دُرٌّ نَظيمُ",34,"م",1,0],["وَفَضَحتُ أَزهارَ الرِيا","ضِ بِحُسنِ أَزهارِ البَديعِ",35,"ع",1,0],["وَفَضلُكَ في تَركِ المَلامِ فَإِنَّهُ","وَحَقِّكَ في قَلبي ظُبّى وَحِرابُ",36,"ب",1,0],["وفضل أبيك على كاهلي","وعن بر جدّك بي لا تسل",37,"ل",1,0],["وفضل منك أن ترعى ودادا","وليس لمن تودّ عليك فضل",38,"ل",1,0],["وَفَضَّلَ في الكِتابَةِ آلَ وَهبٍ","وَقَدَّمَ بَينَهُم بِالضَرطِ وَهبا",39,"ب",2,0],["وَفَضلاً بِالخَلائِفِ باتَ يُعزى","إِلى فَضلِ الخَلائِفِ بِالرَسولِ",40,"ل",1,0],["وَفَضيلَةٌ لَكَ أَن مُنيتَ بِمِثلِها","فَنَجَوتَ مُتَّئِداً وَقَلبُكَ جامِعُ",41,"ع",1,0],["وَفَضَّلَ آلَ ضَبَّةَ كُلَّ يَومٍ","وَقائِعُ بِالمُجَرَّدَةِ العَواري",42,"ر",2,0],["وَفَضلاهُما مِمّا يُعَدُّ كِلاهُما","عَلى الناسِ مِن يَومَيهِما كانَ أَوسَعا",43,"ع",2,0],["وَفُضَّ بِسَيفِ اللَهِ عَنهُ وَدَفعِهِ","كَتايِبُ كانَت مِن وَراءِ الخَنادِقِ",44,"ق",1,0],["وَفَضلُ أَبي الأَشبالِ عِندي كَوابِلٌ","عَلى أَثَرِ الوَسمِيِّ لِلأَرضِ مُغدِقِ",45,"ق",1,0],["وفضل في الشعر آمرأً غير فاضل","فقلت له أمسك نطقت عن الهوى",46,"و",2,0],["وفَضْلُ الهامِ من بُغْضِ الذُّنابى","وعِزُّ التَّاجِ من ذُلِّ الخِصافِ",47,"ف",1,0],["وفِضْتَ على عدوِّهمُ فقُلنا","أفاضَ البحرُ أم سحَّ القُطارُ",48,"ر",1,0],["وَفَضَضنا خِتامَها عَن أَناها","فَرَأَينا مِزاجَها تَسنيما",49,"م",2,0],["وَفَضيلَةٌ شَهِدَ الأَنامُ بِحَقِّها","لا يَستَطيعُ جُحودَها إِنسانُ",50,"ن",1,0],["وفضفاضَةٍ خضراءَ ذاتِ حبائكٍ","إذا لُبِسَتْ فاضَتْ على بَطَلٍ كفوِ",51,"و",1,1],["وَفُضول نَيلٍ بَلَّ وَكلُ سَمائِهِ","وَعُبابُ بَحرِكَ دائِمُ التَيّارِ",52,"ر",1,0],["وَفَضَحوها عِندَ مَن يَعرِفُها","وَصَدَّقوا العَشيقَ كَي يَقرِفَها",53,"ه",2,0],["وَفَضَّ خاتَمَهُ عَن رَأسِ مُدَّخِرٍ","مِنَ الدِنانِ قَديمِ العَهدِ مَوروثِ",54,"ث",1,0],["وَفَضلُهُ عِندَ أَهلِ الظُرفِ كُلِّهُمُ","فَضلُ البَرامِكِ أَن عَلّاهُمُ الجودُ",55,"د",1,0],["وَفَضَّلوهُ وَلا تَزكو فَضائِلُهُم","إِلّا بِتَفضيلِ أَقوامٍ بِهِم فَضَلوا",56,"ل",3,0],["وَفَضلُكَ لا يُحَدُّ وَلا يُجارى","وَلا تَحوي حِيازَتُهُ الظُنونُ",57,"ن",1,0],["وفضضته وقرأته فإذا","أحلى كتاب في الورى يقرا",58,"ر",2,0],["وفَضيلةُ النّوْمِ الخرُوجُ بأهْلِهِ","عن عالَمٍ هوَ بالأذى مَجْبول",59,"ل",1,0],["وَفَضَائِلُ الأُسْرَاتِ فِي أَقْوَالِهَا","أَبَداً تُؤْثِّرُ ذلِك التَّأْثِيرَا",60,"ر",2,0],["وَفَضْلُكَ فِينَا لِلفَضَائِلِ مَنْبِتٌ","مَشَارِقُ مِصْرٍ رَوْضُهُ وَالمَغَارِبُ",61,"ب",1,0],["وَفَضلَةٍ ذَكَّرَتني ريقَ تارِكِها","في الكَأسِ مَمزوجَةٍ مِنهُ بِطيبِ فَمِ",62,"م",1,1],["وفضلُه احتاج إلى شُرَّاح","لازلتَ، يا صقرُ، رحيبَ السَّاحْ",63,"ح",1,0],["وفضَّلتَ عيشاً بين تلك وهذه","به كنتَ ، بل لولاهُ ، ما كنتَ شاعرا",64,"ر",2,0],["وفَضَّت لطائمَهُنَّ الرياحُ","عليه كما فاح مسك فتيق",65,"ق",1,0],["وفضلُ بن مروانُ * سيثلم ثلمة","َ يظلُّ لها الاسلام ليس له شعبُ",66,"ب",1,0],["وَفضائل قَد أَينَعَت ثَمَراتِها","فَعَطا إِلَيها كَف كُل قُطوف",67,"ف",1,0],["وَفضائل لَم يُحصِها عَدد وَلَم","يُدرك غُبار جِيادِها إِدراكُ",68,"ك",1,0],["وَفض ستام قَلبي وَهُوَ غُرٌّ","وَلَولاهُ لَما فَضَ الخِتام",69,"م",1,0],["وفضلك ممدود اليه وانني","الى فضلك الطامي النوال عديم",70,"م",1,0],["وفضاء تلمع فضته","ويشوق العيز زمرده",71,"د",2,0],["وفضلٌ وإنذارٌ لمن كان غافلا","وبُشْرَى وتَذْكارٌ لِمَنْ هو يهتدِى",72,"د",2,0],["وفضائل عَييَ الحسو","د بها وأعيا الحاسب",73,"ب",1,0],["وَفُضِّلَ بِالسَبقِ الفَريقُ المُبَدأُ","أُولو البِرِّ وَالتَقوى وَأَهلُ الفَضائِلِ",74,"ل",1,0],["وفضلت الجسوم ظباً وسمر","فتلك تخيط ما الاخرى تقد",75,"د",1,0],["وَفَضيلَةُ الأَدَبِ الَّذي فاقَ الوَرى","لي دونَهُم وَالشَمسُ ما لا يُجحَدُ",76,"د",1,0],["وَفَضيلَةُ الإِسلامِ فيهم إِذ عَلوا","فيهِ إِلى الحَقِّ الطَريقَ الأَرشَدا",77,"د",2,0],["وَفَضلُ آخِرنا عَن فَضلِ أَوَّلِنا","يُغني ولَكِنَّ بَحراً هاجَ فاِلتَطَما",78,"م",2,0],["وَفُضَّ فَمي إِن لَم أُسَيِّر غَرائِباً","تُمَ