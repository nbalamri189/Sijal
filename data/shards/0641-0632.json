ل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[49,"أذَلَّ الحِرْصُ والطَّمَعُ الرِّقابَا","https://www.poetsgate.com/ViewPoem.aspx?id=16960",""],[96,"إلي أبناء الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=15720",""],[13,"أَلاَ تِلْكُمَا عِرْسِي مَنِيعَةُ ضُمِّنَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180795",""],[90,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[45,"أَتَتْنِي أَنْبَاءُ مَا قَالهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32150",""],[45,"ليالينا بين اللوى فزرود","https://www.poetsgate.com/ViewPoem.aspx?id=31334",""],[51,"أرى ابنَ حريثٍ لا يُبالي عضيهتي","https://www.poetsgate.com/ViewPoem.aspx?id=30764",""],[51,"قدمتَ قدوم البدر بيتَ سُعُودهِ","https://www.poetsgate.com/ViewPoem.aspx?id=27697",""],[2,"بانَ الخَليطُ وَلم يَأوُوا لمَنْ تَرَكُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19480&r=&rc=6",""]],"verses":[["فَزُل كَزِيالِ الشَبابِ الرَطي","بِ خانَكَ يَومَ لِقاءِ الغَواتي",0,"ي",1,0],["فَزَفيرٌ وَنَشيجٌ","وَعَجيجٌ وَبُغامُ",1,"م",1,0],["فَزِعتُ إِلى الأَبدالِ بَعدَ فِراقِهِم","فَأَعوَزَني يا عَمروُ مَن أَتَبَدَّلُ",2,"ل",1,0],["فَزِعتُ إِلى فَضلِ الرِداءِ مُبادِراً","تَلَقِّيَ دَمعي أَن يَنُمَّ عَلى سِرّي",3,"ر",2,0],["فَزيدوا فَإِنّي بَعدَها غَيرُ ناقِصٍ","وَجِدّوا فَإِنّي بَعدَها غَيرُ عابِثِ",4,"ث",1,0],["فَزِعتُ إِلى الشُحوبِ وَكُنتُ طَلقاً","كَما فَزِعَ المَشيبُ إِلى الخِضابِ",5,"ب",1,0],["فزُرْتُ عِمادَ الدّينِ معتَصِماً بهِ","أسورُ سُؤُورَ الليْثِ في وَثَباتِهِ",6,"ت",2,0],["فزارَهُ زَوْرَةً تَعيى الأُسودُ بِها","أغَرُّ زُرَّتْ على خِشْفٍ مَدارِعُهُ",7,"ع",2,0],["فزَجَرْتُها والوِرْدُ يَضْمَنُ رِيَّها","ولَها على الظّمأِ ازْوِرارُ عَيوفِ",8,"ف",1,0],["فزادَهُ المُقْتَدي باللهِ تَكْرِمَةً","كَسَتْهُ بُرْدَ الشّبابِ الناضِرِ الخَضِلِ",9,"ل",1,0],["فَزِعْنا إليه نَمْتَري من يَمينِهِ","سَحائِبَ يَسْحَبْنَ الضُّروعَ منَ الغُزْرِ",10,"ر",1,0],["فَزُرْنَ بِنا البَيتَ الحَرامَ وخُلِّيَتْ","تَرودُ بمُسْتَنِّ الحَطيمِ وزَمزَمِ",11,"م",1,0],["فزُرْتُ وحاشا المَجْدِ جُؤْذَرَ رَمْلَةٍ","حَبا دونَهُ رَطْبُ الغِرارَيْنِ مِخْذَمُ",12,"م",1,0],["فزَجَرْتُ مَن جَلَبَ الجِيادَ إِلى مَدًى","يَعْنو لِحاسِرِ أهْلِهِ المُسْتَلئِمُ",13,"م",1,0],["فَزَجَرتُهُ أَلّا يُفَرِّخَ عُشُّهُ","أَبَداً وَيُصبِحَ واحِداً يَتَفَجَّعُ",14,"ع",1,0],["فَزَجَرتُها عَن نِسوَةٍ مِن عامِرٍ","أَفخاذُهُنَّ كَأَنَّهُنَّ الخَروَعُ",14,"ع",1,0],["فُزتِ يا فَوزُ إِن أَقَمتِ وَإِن سِر","تِ فَوَيلي إِنَّ البَلاء فُنونُ",15,"ن",1,0],["فَزادَ كَما زِدنا فَأَصبَحَ نامِيا","فَلَيسَ وَإِن مُتنا بِمُنفَصِمِ العَهدِ",16,"د",1,0],["فَزِعتُ إِلى وَجناءَ حَرفٍ كَأَنَّها","بِأَقَرابِها قارٌ إِذا جِلدُها اِستَحَم",17,"م",1,0],["فَزُرِ السُها وَالفَرقَدَي","نِ إِذا أُتيحَ لَكَ المَزار",18,"ر",1,0],["فَزَيِّنا المَجدَ بِنورِ النُهى","وَجَمِّلا الجاهَ بِأَن تَكمُلا",19,"ل",2,0],["فَزِن تاجَ الرِئاسَةِ بَعدَ سامي","كَما زانَت فَرائِدُهُ الجَبينا",20,"ن",2,0],["فَزانٍ ما عَلَيهِ مِن جُناحٍ","وَقَوّادٌ بِتَوقيعِ الخَليفَه",21,"ه",1,0],["فَزَرهُ تَزُر أَكنافَ غَنّاءَ طَلَّةٍ","أَرَبَّت بِها لِلمَكرُماتِ رَبابُ",22,"ب",1,0],["فُز بِالنَجاحِ وَأَحرِزِ الإِقبالا","وَحُز المُنى وَتَنجِّزِ الآمالا",23,"ل",2,1],["فَزَلَّ وَقَد أَمطَيتَهُ ثَبَجَ السُها","وَضَلَّ وَقَد لَقَّيتَهُ قَبَسَ الهُدى",24,"د",2,0],["فزدته ما شئت من زينةٍ","بمثلها الأعين لم تكحل",25,"ل",1,0],["فُزْ بِالَّتِي وَاتَتْكَ مِنْ أُمْنِيَّةٍ","وَاعْتَدَّ مَا تَعْتَدُّ لاسْتِكْمَالِهَا",26,"ل",3,0],["فَزِدْ مَصَائِبَنَا حَتَّى تُنَبِّهَنَا","تَكُنْ حَيَاةً لَنَا مِنْ حَيْثُ تُرْدِينَا",27,"ن",2,0],["فَزِعَتْ أُمَّةٌ إِلَيْكِ فَنُبَ عَنْ","هَا وَقَرِّبْ لَهَا بَعِيدَ الأَمَانِي",28,"ن",2,0],["فُزْ بِالنَّعِيمِ جَزَاءَ مَا قَدَّمْتَهُ","وَتَمَلَّهُ فِي زَهِرَاتِ جِنَانِ",29,"ن",1,0],["فُزْ بِالرِّضَى فِي جِوَارِ اللهِ وَارِثِ لَنَا","فَنَحْنُ نَشْقَى وَأَنْتَ النَّاعِمُ الهَانِي",30,"ن",2,0],["فزال كل فساد كان منتشراً","من عندكم بين إغراء وإيعاز",31,"ز",1,0],["فَزَحلِفها بِأَزفُلِها إِلَيهِ","أَميرَ المُؤمِنينَ إِذا تَشاءُ",32,"ا",2,0],["فَزادَ اللَهُ مُلكَكُمُ تَماماً","مِنَ اللَهِ الكَرامَةُ وَالمَزيدُ",33,"د",1,0],["فَزِد خالِداً مِثلَ الَّذي في يَمينِهِ","تَجِدهُ عَنِ الإِسلامِ أَكرَمَ ذائِدِ",34,"د",1,0],["فزعتم لنا في كل شرق ومغرب","بنا ولنا أظفاركم وعُلُوبُها",35,"ب",3,0],["فزمانهم يقضي بعيش أبيض","وجيوشهم تسري بموت أحمر",36,"ر",1,0],["فَزِدنيَ فوق الذي استحق","قُ ما تستحقُّ بحقِّ الأديبِ",37,"ب",1,0],["فزلَّ من تلك المراقي زَلّةً","أصبح منها مُشفياً على العَطَبْ",38,"ب",1,0],["فَزِعْتَ إلى الخضاب فلم تُجَدِّدْ","به خَلَقاً ولا أحييتَ مَيتا",39,"ت",2,1],["فُزْ فَوْزَهُ واسْعَدْ بمثل نجاته","ووقاك شانِئُكَ البوارَ المِجْوَحَا",40,"ح",2,0],["فزاد مُصَلِّينا بكم في رُكُوعه","زاد مصلينا بكم في سجودِهِ",41,"د",2,0],["فَزفْرةٌ لا تزال في صَعدٍ","وعبرةٌ وُكّلت بمنحدرِ",42,"ر",1,0],["فزت بالحسن يا كنيزة طرّاً","أنت بلقيس لو أعانك عرشُ",43,"ش",1,0],["فزُوِّج بعد فقر منه نعمى","أراني الله صُبحتها الطلاقا",44,"ق",2,0],["فُزتَ بقدرٍ طيِّبٍ طعمُها","وكعثبٍ زينَ بتشويك",45,"ك",1,0],["فزِدني منك تقريباً وبِشراً","فإن الجنسَ تتبعُهُ الفصولُ",46,"ل",1,0],["فزاده الله تشريفاً وأصْحبه","رُشْداً يُثَبِّتُ منه وطْأةَ القدم",47,"م",1,0],["فزوالها عن كيدِها ونكيرِها","فلم يرَ إلا التُّرَّهاتِ اللواهيا",48,"ي",2,0],["فَزابِر بِجِدٍّ عَلى نَيلِها","فَلَيسَ يَخيبُ الَّذي يَعمَلُ",49,"ل",1,0],["فَزَهِدتُ في هَذا وَذا","فَقُلِ السَلامُ عَلى الجَميعِ",50,"ع",1,0],["فزَمَانُ الغابِ طفلٌ لاعبٌ","عَذْبٌ جميلْ",51,"ل",1,0],["فَزَفرَتي في صَعَدٍ","وَعَبرَتي في صَبَبْ",52,"ب",1,0],["فزرنا عاجلاً يا موت زرنا","فإن لنا بزورتك احتفالا",53,"ل",2,0],["فزأرتم زأرة أقعى لها","وأجال اللحظ فيهم يستبين",54,"ن",1,0],["فزادها طيبا على طيبها","وزادهم يسرا فأهلا به",55,"ب",2,0],["فز بها واحيَى إلى أمثالها","عدد الساعات منها حقبا",56,"ب",2,0],["فزهوة الطاووس","تأخذ بالنفوس",57,"س",1,0],["فَزُهدُكَ لَم يُنكِرهُ في الأَرضِ عارِفٌ","وَلا مُتَعالٍ في السَماءِ كَ