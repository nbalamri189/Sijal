{"poems":[[65,"علوت فدونك السبع الشداد","https://www.aldiwan.net/poem46157.html","الوافر"],[75,"تنشق من عرف الصبا ما تنشقا","https://www.aldiwan.net/poem11855.html","الطويل"],[95,"مصر تناديكم فمن يحجم","https://www.aldiwan.net/poem11320.html","السريع"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[49,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[53,"تركنا لكم دنياكم وتخاضعت","https://www.aldiwan.net/poem61913.html","الطويل"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[47,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9935","الوافر"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[136,"صبغت بدمع عاشقك الخدودا","https://www.aldiwan.net/poem54860.html","الوافر"],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[231,"على أطلال الحب","https://www.aldiwan.net/poem24227.html","عموديه"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[242,"مات الحفيظ فمن يحفظ من عاشا","https://www.aldiwan.net/poem19724.html","البسيط"],[289,"برزت من المنازل القباب","https://www.aldiwan.net/poem44319.html","الوافر"],[409,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[520,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77562","الرجز"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72261","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64862","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48912","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77982","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49579","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47213","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87733","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93429","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100309","الطويل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127400","الوافر"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132015","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136903",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133115","المجتث"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143602","الوافر"],[289,"وابطك قابض الارواح يرمي","https://www.poetsgate.com/ViewPoem.aspx?id=37282",""],[5261,"عدلا رجاءً","https://www.poetsgate.com/ViewPoem.aspx?id=213852",""],[5362,"أهنيك بالعيد أم بالظفر","https://www.poetsgate.com/ViewPoem.aspx?id=170387",""],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[5848,"حبيبة قلبي البارح","https://www.poetsgate.com/ViewPoem.aspx?id=53161",""],[5897,"رمضان يستعيد الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=156849",""],[520,"فتوح لها في كل يوم مسرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577510",""]],"verses":[["وأبْطالٍ كآسادٍ تمَطّتْ","كذُؤبانِ الرِّداهِ بهِمْ جِيادُ",0,"د",1,0],["وَأَبطَأُ سارٍ كَوكَبٌ باتَ يُكلَأُ","أَقُرطُبَةُ الغَرّاءَ هَل فيكِ مَطمَعُ",1,"ع",1,0],["وَأُبْطِلَ السِّحْرُ وَتَضْلِيلُهُ","وَعُطِّلَ الإِيهَامُ وَالمُوهِمُ",2,"م",1,0],["وأبطَحَ ذِي المَجَازِ وحَيثُ تَلقَي","رجضال عكاظ لِلمُتَنَبِّئِينَا",3,"ن",2,0],["وَأَبطَأَ عَنّي وَالمَنايا سَريعَةٌ","وَلِلمَوتِ ظُفرٌ قَد أَطَلَّ وَنابُ",4,"ب",1,0],["وإبطال ما كان الخليفة جعْفَرٌ","تخيَّرَهُ زِيّا لكلِّ مُعاندِ",5,"د",1,0],["وأبطركم أكل الحرام فأمهلوا","لكل أكول هوعةٌ سيهوعها",6,"ع",3,0],["وَأَبطالِ هَيجٍ في اِصفِرارِ بُنودِها","ضُروبُ المَنايا وَاِبيِضاضُ حِرابِها",7,"ب",3,0],["وَأَبطِشُ بِالكَمِيِّ وَلا أُبالي","وَأَعلو لِلسِماكِ بِكُلِّ فَخرِ",8,"ر",1,0],["وأبطال خيل الله تحكي أهلة","من الظفر الميمون منها المباسم",9,"م",1,0],["وأبطَشَها وأقصَدَها رَمِيًّا","وأعدَلَها وأنجَزَها وُعُودَا",10,"د",2,0],["وَأَبطَلَ عَقرَ العَودِ فيهِم مُبيحُهُ","لِمَن يَعتَفيهِ وَهوَ بِالدَبرِ موقَرُ",11,"ر",1,0],["وَأَبطَلَ أَمراً كانَ يُرجى وُقوعُهُ","وَجاءَ بِأَمرٍ لَم يَكُن مُتَوَقَّعا",12,"ع",2,0],["وَأَبطَلوا الصَلواتِ الخَمس وَاِنتَهَكُوا","شَهرَ الصِيامِ وَنَصُّوا مِنهُمُ صَنَما",13,"م",2,0],["وَأَبطالُهم لو حارَبوا أسدَ السَما","لفرّ وَخلّاها ومِن برجهِ خَرّا",14,"ر",2,0],["وأبطل كل ساحرة","وأسكت نغمة الشعر",15,"ر",1,0],["وأبطال بدر فضلهم غير منكر","بأفخر ثوب في الجهاد تدرّعوا",16,"ع",3,0],["وَأَبْطَشَتْ بِالنُّهَى أَيْدِي النَّوَى بُتِكَتْ","إِنَّ النَّوَى كَانَ بِالأَلْبَابِ بَطَّاشَا",17,"ش",2,0],["وابِطُكَ قابِضِ الأَرواحِ يَرمي","بِسَهمِ المَوتِ مِن تَحتِ الثِيابِ",18,"ب",1,0],["وأبطل ما فيه وصير نوره","ضلالاً وجهلاً بحر كل ظلام",19,"م",1,0],["وأبطلت كيد الخارجي بن يوسف","وأنت كفيل لابن يوسف ناصر",20,"ر",1,0],["وَأَبطَلوا مِن بَعد هَذا الكَدّا","وَتَرَكوا الهَمَّ وَعافوا النَكدا",21,"د",2,0],["وأبطال حرب من كتامة دوخوا","بلاد الأعادي بالمسومة القِّب",22,"ب",1,0],["وأَبْطِنْ صالحاً يَظْهَرْ ثَناءً","فلِلنَّيّاتِ أَسرارٌ مُذَاعَهْ",23,"ع",2,0],["وآب طائرُ قلبي من سياحته","لبيتِ حكمته العالي على القِممَ",24,"م",1,0],["وأبطالٌ ذكور أم إناث","مغازلهن مرسلة تميد",25,"د",1,0],["وأُبْطِلَ سحرُ الأعينِ النُّجلِ بعدما","مَضَتْ برهةٌ والسحرُ ما دونه بطل",26,"ل",1,0],["وإبطال عدم للقديم وسادس","لزوم مزيد في المحلّ لجنسه",27,"س",2,0],["وإبطال تجويز التسلسل سابع","فَزَاحِمْ بحفظ العلم وَاعْنَ بدرسه",27,"س",2,0],["وَأَبطاله فَوقَ الثَنايا طَوالِعا","عَلى ضامِرات قَد أَغرن نَوازِعا",28,"ع",2,0],["وَأَبطأَ عَنهُ الصُّبحُ حَتَّى كَأَنَّهُ","رَأى مِن سَوادِ اللَّيل ما لا يُقاوِمُه",29,"م",2,0],["وأبطح فياح المهابط نافح","أغارت به الحواذن نافحة الغارِ",30,"ر",1,0],["وأبطال الرواية من بنيها","ومخرجها المدير إلى النهايه",31,"ا",3,0],["وأبطالا إذا ركبوا المطايا","أثاروا السحب وانتقعوا الظلاما",32,"م",2,0],["وابطأت الشمس في سيرها","فخلت كأن النهار الأبد",33,"د",1,0],["وأبطال حتوف","لقوم زاغوا وضلوا",34,"ل",3,0],["وأبطالٌ إذا شَرعوا العَوالي","فليس وُرودَها إلاّ الوريد",35,"د",1,0],["وإبطكَ قابضُ الأرواحِ يرمي","بسمِ الموتِ من تحتِ الثيابِ",36,"ب",1,1],["وأبطال البلاد بكل ثغر","إذا حمى الوطيس فلا هروب",37,"ب",1,0],["وأبطلت ما أحدثته اليهود","من السحر بالمعجزات الغرر",38,"ر",1,0],["وابطال ( النقابة ) كيف باتوا","يذوقون المذلة والعذابا",39,"ب",2,0],["وابطرد شيٍ اسمه ( حب ) من قلبي بدون سلوم","بلا حب وبلا هم وقريباً ب اعلن اعدامه",40,"م",2,0],["وأبطال تخاف الأرض منهم","فإذْ همْ في زواياها بديدُ",41,"د",1,0],["وأبطلت كيد الخارجي بين يوسفٍ","وأنت كفيل لابن يوسف ناصر",42,"ر",1,0]]}