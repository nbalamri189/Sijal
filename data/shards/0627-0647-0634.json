{"poems":[[47,"أمير المؤمنين لقد سكنا","https://www.aldiwan.net/poem66797.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19310","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202645","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54976","الطويل"],[201,"من لروحي فلا الرحيق رحيق","https://www.aldiwan.net/poem39808.html","الخفيف"],[266,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[327,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53940","الطويل"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143829","الطويل"],[5431,"ولكم خشعت..","https://www.poetsgate.com/ViewPoem.aspx?id=185262",""],[5829,"خطاب لم يصل","https://www.poetsgate.com/ViewPoem.aspx?id=152684",""],[5956,"أحلى كلامك","https://www.poetsgate.com/ViewPoem.aspx?id=192139",""]],"verses":[["أَهَشَّهُمُ إِلى غَيرِ المَعالي","وَأَضحَكَهُم إِلى غَيرِ الخِوانِ",0,"ن",1,0],["أَهُشُّ في المَرعى بِها وَأَتَّكي","وَلا أَرُدُّ الناسَ عَن تَبَرُّكِ",1,"ك",1,0],["اه شبكت قلبي يا عيني","شوفي بقى من يحل له",2,"ه",1,1],["أَهَشُّ إِلَيْهِمْ مَا أَهَشُّ تَلَطُّفاً","إِذَا لَمْ أُطِقْ صَبْراً فَأَطْلَقْتُ أَنْفَاسِي",3,"س",2,0],["آه شف الحنين روحي واضنى ال","وجد قلبي وأنه لخليق",4,"ق",1,0],["اهش عليه للمنايا وان غدت","كوالح فيوجه الكمى حوالكا",5,"ك",2,0],["أَهَشُّ لِحَمدِ قَومي كُلَّ يَومٍ","وَلَستُ إِلى مَلامَتِهِم بِهَشِّ",6,"ش",1,0],["أَهِشّ إلى تذكراه كلًّ ساعةٍ","فيا ليته بيدي التفاتاً إلى هَشّي",7,"ش",2,0],["أَهَشُّ إِذا ما زارَني مُتَفَضِّلا","وَإِن غابَ عَنّي عيلَ في بُعده صَبري",8,"ر",2,0],["أهش لأنواء الربيع إذا انبرت","وأكره أبواء الربيع وأنكر",9,"ر",1,1],["آهٍ شفاه البدر آهٍ حرقتي","قد صيّرتني قطرة بنداه",10,"ا",2,0],["آهٍ شقيقي , ما حَسَبْتُ لمثلها","يوماً حساباً , إن بدا لي يُقْنِع",11,"ع",1,0],["أهَشُّ إليكِ هشيش الفراخِ","إلى أكلها كي تسدّ النَّهمْ",12,"م",1,0]]}