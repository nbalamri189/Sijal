{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[30,"ألا من لشوق أنت بالليل ذاكره","https://www.aldiwan.net/poem5077.html","الطويل"],[30,"وبالمسجد الأقصى الإمام الذي اهتدى","https://www.aldiwan.net/poem5384.html","الطويل"],[54,"أيا ويحه ما ذنبه إن تذكرا","https://www.aldiwan.net/poem27049.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9878","الطويل"],[164,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[199,"بانت حسينة وائتمت بمن بانا","https://www.aldiwan.net/poem54410.html","البسيط"],[255,"يروحي نسيم هب من أرض طيبة","https://www.aldiwan.net/poem15055.html","الطويل"],[280,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[287,"خليلي بالحمى عرج وسل ما","https://www.aldiwan.net/poem32414.html","الوافر"],[396,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[408,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[466,"وجيش كأعناق السيول غثاؤه","https://www.aldiwan.net/poem15084.html","الطويل"],[466,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[519,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[534,"خود رداح ربحله","https://www.aldiwan.net/poem37219.html","مجزوء الرجز"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[580,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54163","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67845","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67841","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67837","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67829","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136351","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71071","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104778","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104766","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104726","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104791","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48210","الخفيف"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144752","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137449",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48416","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138453",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85195","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85271","السريع"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59482","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135742","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125878","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93253","المتقارب"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77693","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72898","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139579",""],[4767,"دوحة الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=194943",""],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[4884,"همس الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=210385",""],[5219,"الرحمة المزجاة","https://www.poetsgate.com/ViewPoem.aspx?id=194855",""],[5302,"ولي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=200125",""],[5431,"تراود منك الروح حتى تُسلّما","https://www.poetsgate.com/ViewPoem.aspx?id=196983",""],[5720,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=210881",""],[5748,"تعلَّقْتُهُ من بني الأكرمينَ","https://www.poetsgate.com/ViewPoem.aspx?id=26032",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""],[5943,"اعتقْ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=92975",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""]],"verses":[["بِهِ كُلُّ هَفّافِ القَميصِ شَمَردَلٍ","تَفَرَّجَ عَن وَجهٍ نَقِيِّ المَقادِمِ",0,"م",1,0],["بِهِ كُلُّ طَعّانٍ يَلوثُ بِرَأسِهِ","عَنيقَ المَذاكي ما يُثيرُ مِنَ النَقا",1,"ق",2,0],["بِهِ كُلُّ ذَيّالِ العَشِيِّ كَأَنَّهُ","هِجانٌ دَعَتهُ لِلجُفورِ فَوادِرُه",2,"ر",2,0],["بِهِ كَشَفَ اللَهُ البَلاءَ وَأَشرَقَت","لَهُ الأَرضُ وَالآفاقُ نَحسٌ هِلالُها",3,"ل",3,0],["بِهِ كُلُّ مَوشيَّ القَوائِمِ ناشِطٌ","وَعَينٌ تُراعي فاتِرَ اللَحظِ أَحوَرا",4,"ر",2,0],["بِهِ كُنتُ أَسطو حينَما جَدَّتِ العِدا","غَداةَ اللَقا نَحوي بِكُلِّ يَماني",5,"ن",2,0],["به كل ضرغام بحلة آرقم","تحاكي غدير الماء وهي حديد",6,"د",1,0],["بِهِ كُلومُ صَوافيرٍ مُذَكَّرَةٍ","تَرُنُّ مِنهُ ضَواحي الصَخرَ إِرنانا",7,"ن",2,0],["به كلُّ مُشتاق يَهيمُ صبابةً","فما هبَّ إلا شوَّقَ الهائمَ الصّبا",8,"ب",2,0],["بِهِ كَرُم الدِّينُ الذِي سَادَ وَاعْتَلَى","فَما تبْصِرُ الدّهمَاءَ فيهِ وَلا الحَشْوَا",9,"و",2,0],["بِهِ كانَ الشَبابُ لَنا شَفيعاً","وَلَونُ الشَعرِ أَسوَدَ مُدلَهِمّا",10,"م",2,0],["به كل السر وروكل خير","به تحفظ من آفات الأغيار",11,"ر",1,0],["به كلُّ بدرٍ زاهر الأوجِ يَهْتدي","وكلُّ خِضَمٍّ زاخر الموْجِ يقتدي",12,"د",2,0],["به كل هفافِ القميصِ مُقارعٍ","على كل محبوكٍ السِّراةِ ضبُارمِ",13,"م",1,0],["به كلُّ مِقْلاقِ العِنانِ طِمرَّةٍ","تجولُ بجيَّاش الحقودِ شمرْدَل",14,"ل",1,0],["بهِ كلَّ يومٍ وغى كائنٌ","عدوُّ يصدُّ وثغرٌ يسدُّ",15,"د",1,0],["به كلُّ شَهمٍ من سُلالةِ هاشمٍ","منَ الحَيدرِيّينَ الغطارِفَةِ الغُرِّ",16,"ر",1,0],["بَهْكَنَةٌ مَمْكُوره","مَمْشُوقَةٌ مَخْصُورَه",17,"ه",1,0],["به كلَّ يومٍ من قريشٍ وغيرها","جهيرٌ مُلَبٍّ أو سريعٌ مطوِّفُ",18,"ف",1,0],["به كدتُ أُنْقَل عن شِيمتي","وقد يَقهرُ الشيمةَ النَّاقِلُ",19,"ل",1,0],["به كلُّ وَثَّابٍ إِلى الموتِ باسلٍ","ومَنْ ذا يرد الأُسْدَ عن عَادَةِ الوَثْبِ",20,"ب",1,0],["به كل عين للإله قريرة","وأبصاره بالنور فيه بصيرة",21,"ه",1,0],["به كل شيء في غيابه عقله","ففي كل معدوم عليم بجهله",21,"ه",1,0],["به كلُّ فتاك الحمام به الطلى","تقد إذا ما أحكم الضرب ساعدُ",22,"د",1,0],["بِهِ كَمْ فَهِمْنَا مِنْ عُلُومٍ وَحِكْمَةٍ","لآيَاتِهِ قَدْ أَذْعَنَتْ كُلُّ أُمَّةٍ",23,"ه",1,0],["بِهِ كَمْ نَجَا عَاصٍ وَآمَنَ خَائِفُ","وَإنِّي مُطِيعٌ أَمْرَهُ لاَ أُخَالِفُ",24,"ف",1,0],["بِهِ كُلُّ عَاصٍ مِنْ ضَلاَلٍ وَطَائِعِ","رَسُولٌ لَهُ التَّأْدِيبُ وَالنَّصْرُ فِي الأَزَلْ",25,"ل",1,0],["بِهِ كَعَرُوسٍ زَانَهَا التَّاجُ وَالْقُرْطُ","دَعَانَا فَجِبْنَاهُ مُلَبَّينَ سُرْعَةً",26,"ه",1,0],["به كان ماقد كان مما شهدته","وابصرته في ذلك المنظر الحسن",27,"ن",1,0],["به كل هَفَّاف القميص سَمَيْدَعٌ","يُصافِحُ منه بالوريد الصفائِحُ",28,"ح",1,0],["بهِ كُلُّ الثِّمارِ مُنَوَّعاتٌ","وَمِنهُ شَدَّةٌ فالبَيتُ بادِى",29,"د",2,0],["بهِ كَشَفَ الرَّحمنُ ستراً لَقَد عَلاَ","وَأظهَرَ ما فِى السِّترِ مِن غامِضِ السِّرِّ",30,"ر",1,0],["بهِ كَم فَقِيرٍ صَارَ مِن بَعدِ فَقرِهِ","غَنِيًّا وَكَم طاغٍ بهِ مُتَضَيِّمُ",31,"م",1,0],["بِهِ كُلُّ عاص فِى القِيامةِ لاَئِذٌ","وَكُلُّ مُحِبٍّ فائِزٌ وَمُكلَّمُ",31,"م",1,0],["بهِ كَم فَقِيرٍ صارَ مشن بَعدِ فَقرِهِ","غَنِيّاً وَكَم طَاغٍ بِهِ مُتَضَيِّمُ",32,"م",1,0],["بَهْكَناتٌ مهما وصلْنَكَ أبدتْ","ظلماتِ الصريمِ منها الثغورُ",33,"ر",1,0],["به كلُّ أوصافِ الجمالِ تجمَّعتْ","فمِن أجْلِه في الحبِّ صرتُ له رَهْنَا",34,"ن",2,0],["به كان حل المشكلات فمن لنا","إذن للوا الايضاح في العلم يعقد",35,"د",1,0],["بهِ كلُّ محْمودِ الخِلالِ ممجّدٍ","يُبَخِّلُ في بَذل النّدى كفَّ حاتِمِ",36,"م",1,0],["به كان ختم الرسل والبدء والهدى","هداه فطه أول وهو آخر",37,"ر",1,0],["به كلامي بالصلاة يختم","كذا سلامي للترقي سلم",38,"م",1,0],["بهكنة تحوي صنوف البها","كأنها في الحسن بدر التمام",39,"م",1,0],["بَهكناتُ فاتنات نُهَّد","بدويات مغاوير عُشُقْ",40,"ق",1,0],["بِه كلُّ شحَّاجٍ إلى كلَّ سمْحجٍ","تُعالجُه أنَّى أنبرى وتمِاطلهْ",41,"ل",2,0],["به كما قلتَ الذي دعاكا","تعطيه ما أراد نِعْمَ ذاكا",42,"ك",2,0],["بهكطورٍ على نغم الن","نشيد نفرج الكدرا",43,"ر",2,0],["بهكطورهم جمحت جرده","فألقته عنهم بعيد المدى",44,"د",2,0],["به كمْ بيوتٍ في البلاد عوامرِ","ومنه بأنحاءِ البلادِ صنائع",45,"ع",1,0],["به كل نَشوانةٍ لحظُها","يطرق بين يَديْ عربَدَهْ",46,"د",2,0],["بِهِ كانَت الدُنيا تُؤخّر مُدبِراً","مِنَ الناسِ حَتماً أَو تُقدّم مُقبِلا",47,"ل",2,0],["به كم جرى حكم على خيرِ منهج","وكم فيه لما زاره سر محزونُ",48,"ن",1,0],["به كم صدَّعوا أطوادَ غىٍّ","كما صمُّ الصفا صدع الزجاجا",49,"ج",2,0],["به كان الوَدادُ عليك ثوباً","تُوشِّيهِ الخيوطُ مِن الوقار",50,"ر",1,0],["به كنتَ الوفاءَ لكل خِلٍّ","له أبديتَ مِن كلِّ اعتبار",50,"ر",1,0],["بهِ كبد العلياء قطرها الأسى","وما عادها عيدٌ كعادات صائم",51,"م",1,0],["به كلُّ عصفورٍ مع الفجرِ قد شدا","إذا النّطقُ منه قد تغنّت حدائقُهْ",52,"ق",2,0],["به كل أمر - من مليك - منزل","طريق نجاة من ضلال وباب",53,"ب",1,0],["به كنت أحيا طيب العيش قانعا","بما حزت من شرب ومن يانع دان",54,"ن",1,0],["به كلّما ذابت قلوبٌ تبدّلتْ","لتهذي بأنّ الفجرَ كانَ توهّما",55,"م",2,0],["به كلُّ آياتِ الشهامةِ قد سَمَتْ","فطابتْ به الدنيا .. وظلَّتْ ترفرفُ",56,"ف",1,0],["به كرم وبه عفة","فيجمع بين الحيا والحياءِ",57,"ا",2,0],["به كساد وبه فساد وبه طموح وبه مطامع","به بطالة به سفالة به مخادع ومخدوع",58,"ع",1,0],["به كاءابة به سحابة غيثها دم ومدامع","به مهانة واستكانة به مذلة به خضوع",58,"ع",1,0],["به كتبتُ قصيدَ العشقِ من زمنٍ","إلاكَ يا مبدعي لم تهوَ أقلامي",59,"م",2,0],["بهِ كلُّ مَسْجُورِ العَزِيمةِ مُظْهِرٌ","على حَشَيةِ الجَبَّارِ هَيْبَةَ جَبَّارِ",60,"ر",1,0]]}