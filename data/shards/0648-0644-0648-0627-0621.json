{"poems":[[79,"عبد العزيز خليفة الله الذي","https://www.aldiwan.net/poem36624.html","الكامل"],[409,"ثم قل من يسقي الخلق إذا","https://www.aldiwan.net/poem33352.html","الرمل"],[543,"ضنت بهذا اليوم قبل عصور","https://www.aldiwan.net/poem48154.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83318","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126751","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48514","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1789,"","https://poetry.dctabudhabi.ae/diwan/poem/122403","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69375","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[3049,"","https://poetry.dctabudhabi.ae/diwan/poem/102041","الكامل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67585","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138501",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83520","الخفيف"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5897,"قم يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=156690",""]],"verses":[["ولِواءُ نَصْرِكَ يسْتَهلُّ غَمامةً","تَذَرُ الفُتوحَ جُثىً بقُضْبِ رِماحِهِ",0,"ح",2,0],["ولواء الحمد من يحمله","غيره أكرم به فخراً عليا",1,"ي",2,0],["ولواءُ نَصرِكَ فوقَ قَصرِك خافِقٌ","والنَّجمُ منه لِلعَلاءِ يُشيرُ",2,"ر",1,0],["وَلِواءُ يوسُفَ تاشَفينَ بِمَغرِبِ","خَرَّت لَهُ الأَعداءَ لِلأَذقانِ",3,"ن",1,0],["ولواءُ الإسلام يخفق بالن","نصر تحيي الحماة والأنصارا",4,"ر",2,0],["ولواء تنشر الأمن به","وارف الظل شديد الخفقان",5,"ن",1,0],["ولواء أهل الشرك نكس إذ علا","علم الهدى بين اللوا والأجدع",6,"ع",1,0],["ولواءُ النبيِّ يخفقُ في كف","ف عليٍّ نصيرهُ جبريلُ",7,"ل",1,0],["وَلِواءٌ حَكى الهَدِيَّ عَلَيها ال","وَشيُ قَد أَقبَلَت إِلى البَعلِ تُجلى",8,"ل",2,0],["وَلِواء أَحمَد في النُبوة ما عُقد","وَلأجل حَيدر عالم الدُنيا وُجد",9,"د",1,0],["ولواء هذا الدين لا","زلنا عليك نرى انعقاده",10,"د",2,0],["ولواءُ المُوشجِير أفضى إلينا","وبلالٌ رَوِينَ بيضٌ وسُمرُ",11,"ر",1,0],["ولواء الحمد لا يحمله","غيره والخلق من خلفٍ زمر",12,"ر",1,0],["وَلِواءً لِيَنضَوي الكُلُّ مِنّا","تحتَ هذا اللِّواء في عرفاتِه",13,"ت",2,0],["ولواء النصر في قبضته","ظلل الدهر بتلك الخفقات",14,"ت",1,0],["ولواء الحمد يسرة تحته","أنبياء الله فذا وتؤاما",15,"م",2,0],["ولواءِ فخر خافق شرفاً","أنواره في الساح والحرمِ",16,"م",1,0]]}