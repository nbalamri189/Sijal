te.com/ViewPoem.aspx?id=160385",""],[5127,"وقفتْ ومدمعُها على اﻷجفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=177316",""],[5145,"سربٌ يسامي الفرقدين بناؤه","https://www.poetsgate.com/ViewPoem.aspx?id=108207",""],[5273,"الهروب من الصقيع","https://www.poetsgate.com/ViewPoem.aspx?id=144498",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5388,"ارحل","https://www.poetsgate.com/ViewPoem.aspx?id=208766",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[5425,"لَمْ تُدرِكِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=199167",""],[5431,"سادن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209045",""],[5431,"من فيهما احترقا؟!","https://www.poetsgate.com/ViewPoem.aspx?id=214127",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[5573,"أنتِ التي علمتِني هذا الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=213732",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5672,"من حديث العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=214661",""],[5691,"أمام المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=206736",""],[5730,"غضبت لأني لم أُجبْها عندما","https://www.poetsgate.com/ViewPoem.aspx?id=212834",""],[5781,"وارفةُ العشقِ...أنا","https://www.poetsgate.com/ViewPoem.aspx?id=190949",""],[5829,"في دائرة الخطر","https://www.poetsgate.com/ViewPoem.aspx?id=211095",""],[5894,"لولا الهوى ما التوى سقم على رجل","https://www.poetsgate.com/ViewPoem.aspx?id=131432",""],[5952,"ستائر من خجل","https://www.poetsgate.com/ViewPoem.aspx?id=200247",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"زادٌ وجوادٌ وبلادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183588",""],[5956,"نُواح الكون على محمد عبده يماني","https://www.poetsgate.com/ViewPoem.aspx?id=194549",""],[6070,"العنيد","https://www.poetsgate.com/ViewPoem.aspx?id=187816",""],[6070,"مالي اراكَ على الذنوبِ مُقيما","https://www.poetsgate.com/ViewPoem.aspx?id=189545",""],[6082,"الحب الافتراضي","https://www.poetsgate.com/ViewPoem.aspx?id=59115",""],[6142,"إمارة القول أعطته الحليَّ وأع","https://www.poetsgate.com/ViewPoem.aspx?id=155723",""],[5377,"حراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79568&r=&rc=24",""],[6213,"بعد المدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76304&r=&rc=52",""],[5080,"تعب الحياة على جبينك ينضح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88133&r=&rc=3",""],[5190,"حكايتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78304&r=&rc=17",""]],"verses":[["لَم تَدَع فيكَ نائِباتُ اللَيالي","أَثَراً لِلهَوى سِوى مَغناكا",0,"ك",2,0],["لَمْ تَدْفَعِ الأَحْبَابُ عَنْهُمْ غَيْرَ أَنْ","بَكَوْا عَلَى فِراقِهِمْ وَأَعْوَلُوا",1,"ل",3,0],["لمْ تَدَعْ لي منَ السِّلاحِ سوَى مِغْ","فَرِ شَيْبٍ أهْوِنْ بهِ منْ سِلاحِ",2,"ح",1,0],["لَمْ تَدْرِ سِرّاً لِلحَيَاةِ وَلا","لِخُصُومَتَيْهَا البُرْءِ وَالسَّقَمِ",3,"م",1,0],["لَمْ تَدَّخِرْ لِرُقيِّ قَوْمِكَ هِمَّةً","وَذَرِيعَتَاكَ العِلْمُ وَالتَّعْلِيمُ",4,"م",1,0],["لَم تَدرِ أُمُّكَ ما الحُكمُ الَّذي حَكَمَت","إِذ مَسَّها سَكَرٌ مِن دَنِّها الضاري",5,"ر",2,0],["لم تدعْ قَفْدَهُ يدُ الدهر حتى","قَمَعَتْ فيه طُولَهُ وشبابَهْ",6,"ب",2,0],["لم تدعني حبائل الشادن الأك","حل حتى نشبت فيها نشوقا",7,"ق",2,0],["لم تدركوا قطُّ بالحسابِ بل ال","أحساب علماً لكم ولا عملا",8,"ل",2,0],["لَم تَدَع فِيَّ اللَيالي غَرَضاً","وَالضَنى لَم يُبقِ مِنّي غَيرَ فَي",9,"ي",1,0],["لَم تَدرِ هَل نَطَقَت بِها الأَ","فواهُ أَم جَرَتِ المَآقي",10,"ق",2,0],["لَم تَدرِ مافَعَلَ البُكا","ءُ عَلَيكَ بِالجَفنِ القَريحِ",11,"ح",1,0],["لمْ تُدَنِّسْ عِطرها الطَّاهرِ","أَنفاسَ الذِّئابْ",12,"ب",1,0],["لم تدر أن عنترا","توعد ابنى ضمضم",13,"م",1,0],["لَم تَدرِ نَفسُكَ ما الغُرورُ وَطالَما","دَخَلَ الغُرورُ عَلى الكِبارِ فَصَغَّرا",14,"ر",2,0],["لَم تَدَعكَ المَها الَّتي شَغَلَت جَي","شَكَ بِالسَوقِ أَن تَسوقَ الشاءَ",15,"ا",2,0],["لَم تَدرِ ما بي وَما قَد كانَ بَعدَكَ مَن","نَفاسَتي لَكَ في عَبدونَ أَو حَسَدي",16,"د",2,0],["لَم تَدَع فيهِ مُبلِياتُ اللَيالي","غَيرَ نُؤيٍ تَسفي عَلَيهِ السَوافي",17,"ف",2,0],["لَم تَدَعِ الأُبنَةُ في عِرضِهِ","بَقِيَّةً تُرجى وَلا دينِهِ",18,"ن",2,0],["لَم تُدنَ مِن نارٍ وَلَم","يَعلَق بِها وَضَرُ القُدورِ",19,"ر",1,0],["لَم تُدَنَّس بِمَزجِ ماءٍ وَلَكِن","رُبَّما أُتبِعَت بِماءِ فُراتِ",20,"ت",1,0],["لم تَدَع للقلب من طو","ل التباريح وسيله",21,"ل",2,0],["لم تدع للقلب ما يش","في من الوجد غليله",21,"ل",2,0],["لم تدع إلا رفيفاً","من نسيمٍ في خميله",21,"ل",2,0],["لَم تَدُر عَينُهُ عَنِ الحُمسِ حَتّى","ضَعضَعَت رُكنَ حِميَرَ الأَربابِ",22,"ب",1,0],["لَم تَدرِ كَم مِن لَيلَةٍ قَد خاضَها","لَيلاءَ وَهيَ تَنامُها وَتُنيمُها",23,"م",3,0],["لَمْ تَدَعْ لَوْعَةُ الصَّبَابَةِ مِنِّي","غَيْرَ نَفْسٍ غِذَاؤُهَا الآلامُ",24,"م",1,0],["لَم تَدَع لِلنِساءِ عِندي نَصيباً","غَيرَ ما قُلتُ مازِحاً بِلِساني",25,"ن",2,0],["لَم تَدرِ وَليَغفِر لَها رَبُّها","ما جَشَّمَتنا أَمَةُ الواحِدِ",26,"د",1,1],["لَم تَدرِ أَلحاظُهُ كُحلاً سِوى كَحَلٍ","فيها وَلا جيدُهُ حَلياً سِوى الغَيَدِ",27,"د",1,0],["لَم تَدَعني عَيناكَ أَنجو صَحيحاً","مِنكَ حَتّى حُسِبتُ فيمَن قَتَلتا",28,"ت",2,0],["لم تَدْرِ ما حَرُّ الوَداعِ ولا شجَتْ","صَبّاً بمُنْعَرَجِ اللوى أظعانها",29,"ن",3,0],["لم تَدْرِ ما أصْمَى المليكَ أنَزْعُها","بسديدِ ذاك الرّمْي أو حُسبانها",29,"ن",3,0],["لم تَدْعُ فيه العُصْمَ إلاّ دَعْوَةً","حتى أتَتْكَ منَ الذُّرَى تتنزَّل",30,"ل",1,0],["لم تُدْنِني أرضٌ إليكَ وإنّما","جِئْتُ السماءَ ففُتّحَتْ أبوابا",31,"ب",2,0],["لَم تَدرِ جارَتُنا وَلا تَدري","أَنَّ المَلامَةَ إِنَّما تُغري",32,"ر",2,1],["لَم تَدنُ مِنها يَدٌ مُذ يَومِ قَطفَتِها","وَلَم تُعَذَّب بِتَدخينٍ وَنيرانِ",33,"ن",1,0],["لَم تَدَع لي عِندَ المَلا","ئِحِ وَاللَهِ مَوعِدا",34,"د",2,0],["لَم تَدرِ ما حُبّي وَعَذَّبتَني","وَالشَوقُ قَد كادَ بِروحي يَفوت",35,"ت",1,0],["لَم تَدرِ ناقَةُ صالِحٍ لَمّا غَدَت","أَنَّ الرَواحَ يُحَمُّ فيهِ قُدارُ",36,"ر",1,0],["لم تدر في أَي المسا","لك إن مشت تَلقى هداها",37,"ا",3,0],["لم تَدْرِ ما نالَ الرَّئي","سُ أزاد صوتاً أم كرَنْتْ",38,"ت",1,0],["لم تدر فيها الريح أين قرارُها","والشمس أين شروقها وغروبها",39,"ب",3,0],["لَمْ تَدَعْ مِنِّيَ الصَّبَابَةُ إِلَّا","شَبَحاً شَفَّهُ السَّقَامُ فَدَقَّا",40,"ق",2,0],["لَم تَدَعْ صَوْلَةُ الحَوَادِثِ مِنِّي","غَيْرَ أَشْلاءِ هِمَّةٍ فِي ثِيَابِ",41,"ب",1,0],["لَمْ تَدعَا زَيْناً وَلَمْ تُزْمِعَا","شَيْئاً وَلَمْ تَنْتَجِعَا رِجْسَا",42,"س",2,0],["لَمْ تَدَّخِرْ نُصْحاً وَلاَ عَزِيمَةً","فِي سُبُلِ المَعَاشِ وَالمَعَادِ",43,"د",1,0],["لَم تَدنُ نَفسكَ لِلدَّناءَةِ في الصِبا","وَسِواكَ أَهوى النَفسَ بِالأَهواءِ",44,"ا",2,0],["لَم تدّغم فيهِم كَأَنَّكَ مُطبِقٌ","وَكَأَنَّ كلاً مِنهُم مَهموسُ",45,"س",1,0],["لم تَدُرْ كأسُه على واغلٍ فَدْ","مٍ ولا واكلٍ عن المجدِ وانِي",46,"ن",2,0],["لم تدفَع الريحُ الهَبُوبُ قِلاعَها","بل أقلَعَتْ بالوحي والإلهام",47,"م",1,0],["لم تَدْرِ -منْ تَرَف- حُدَا","ءَ النُّوقِ، أو وَخْدَ الجمال",48,"ل",1,0],["لم تدعهم على بساط المخازي","بل دحضت الدعوى برأي حصيف",49,"ف",1,0],["لم تدمْ أتراحُها فيها ولا","أبداً يبقى لنَا فيها الجَذَلْ",50,"ل",1,0],["لم تدرِ أنك في كِساء","قد حِيك من ماءٍ وطِين",51,"ن",1,0],["لَم تَدفَعِ الغَمَراتِ عَن سُكّانِهِ","حَتّى لَقيتَ أَذىً وَخُضتَ غِمارا",52,"ر",2,0],["لَم تَدَع لِلعُلى أَكُفُّ المَنايا","مَن بِهِ يَعتَلي وَلا يَستَطيلُ",53,"ل",1,0],["لَم تَدرِ ما دنس المَعاصي في الوَرى","يَوماً وَوَعدُكَ أَن يَفوزَ نَظيرُها",54,"ر",3,0],["لَم تَدرِ ما سَيِّئَ الأَخلاقِ مُذ بُرِئَت","خودُ يُوَرِّعُها الراعي إِذا زَجَرا",55,"ر",2,0],["لم تدر فيما ذا ابيت من الهوى","وعلى سواك دموعه لم تذرف",56,"ف",1,0],["لم تدع غضبتي عليك رجاء","في بكاءٍ أو زفرة أو أنين",57,"ن",1,0],["لم تدع منهم بِيضُ السيوف سوى","من قد حماها اللمَى والدَلُّ والخَفَر",58,"ر",1,0],["لم تدخل الإسلام أنت لرهبة","أو رغبة بل عن جلاءِ يقين",59,"ن",1,0],["لم تدر أي أبي قوم قدته","قسراً وهضب علا وليث قسور",60,"ر",1,0],["لَم تَدْرِ أَنِّيَ في جوَارِ خَليفَةٍ","بِيَمينِهِ الآجالُ والأرْزاقُ",61,"ق",1,0],["لَم تَدَعْ يَوْماً أعادِيَها","دونَ تَعْقِيرٍ وَتَعقيلِ",62,"ل",1,0],["لم تَدرِ حين توافيها أَصبغتها","تَلوحُ أَم وجن