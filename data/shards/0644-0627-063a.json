{"poems":[[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[53,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[55,"لا غرني بعدك إنسان","https://www.aldiwan.net/poem26060.html","السريع"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[86,"لا غرو إن أشرق في منزلي","https://www.aldiwan.net/poem68840.html","السريع"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[71,"لا غرو أن نال اللئيم بهجوه","https://www.aldiwan.net/poem3757.html","الكامل"],[71,"لا غرو أن أصبح المؤيد","https://www.aldiwan.net/poem3768.html","المنسرح"],[71,"لا غرو أن ضاعت الأعياد بينكم","https://www.aldiwan.net/poem3815.html","البسيط"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[73,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[47,"لاغرو إن فتنتك بال","https://www.aldiwan.net/poem25118.html","مجزوء الكامل"],[72,"أرسلت نجلي واثقا بمكارم","https://www.aldiwan.net/poem18262.html","الكامل"],[72,"لا غرو إن جئت النسيب بمدحة","https://www.aldiwan.net/poem18377.html","الكامل"],[72,"يا سيدي هنئت عيدا أتى","https://www.aldiwan.net/poem18442.html","السريع"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"هل بعد وجهك للرجاء نجاح","https://www.aldiwan.net/poem18487.html","الكامل"],[72,"حمدت دموعي إذ وفت بوعودها","https://www.aldiwan.net/poem18562.html","الكامل"],[72,"اسكنت قلبي لحدك","https://www.aldiwan.net/poem18565.html","المنسرح"],[72,"هن الوجوه الناضره","https://www.aldiwan.net/poem18696.html","مجزوء الكامل"],[72,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[72,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[72,"يا صاحبا صحبت معارفه الورى","https://www.aldiwan.net/poem18790.html","الكامل"],[72,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[72,"ودف أشجار سمعنا به","https://www.aldiwan.net/poem19337.html","السريع"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[72,"بأبي غزالا جال في وجناته","https://www.aldiwan.net/poem20095.html","الكامل"],[51,"لا غرني يا صاحب الدستيجه","https://www.aldiwan.net/poem9245.html","الرجز"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[91,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[91,"لا لهفة النفس على غابة","https://www.aldiwan.net/poem62811.html","عموديه"],[78,"يا ليت حربا ذاق الأعادي","https://www.aldiwan.net/poem14077.html","مخلع البسيط"],[89,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[89,"يا روح هذه الدنى","https://www.aldiwan.net/poem44928.html","مجزوء الرجز"],[89,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[89,"أي قدس يضم هذا البناء","https://www.aldiwan.net/poem44981.html","الخفيف"],[85,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[56,"قالوا السلام عليك يا أطلال","https://www.aldiwan.net/poem58537.html","الكامل"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[62,"قد كذب الظن صادق الخبر","https://www.aldiwan.net/poem52383.html","المنسرح"],[28,"وإذا الرجال رأوا يزيد رأيتهم","https://www.aldiwan.net/poem5177.html","الكامل"],[61,"إن عاده بعد السلو غرامه","https://www.aldiwan.net/poem51427.html","الكامل"],[61,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[66,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[66,"لا غرو أن يصلى الفؤاد لبعدكم","https://www.aldiwan.net/poem40325.html","الكامل"],[66,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[66,"لا غرو إن قص جناحي الردى","https://www.aldiwan.net/poem41565.html","السريع"],[80,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[44,"أي القلوب عليكم ليس ينصدع","https://www.aldiwan.net/poem30310.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[74,"قالت وقد حطت العنوان جوهرة","https://www.aldiwan.net/poem13232.html","البسيط"],[81,"غيري يميل إلى كلام اللاحي","https://www.aldiwan.net/poem61541.html","الكامل"],[52,"لا غرو إن أصبحت خيلان وجنته","https://www.aldiwan.net/poem26963.html","البسيط"],[67,"يا رب صل على المختار من مضر","https://www.aldiwan.net/poem18126.html","البسيط"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[48,"اسقنا إن يومنا يوم رام","https://www.aldiwan.net/poem65093.html","الخفيف"],[48,"عف ضميري هازل","https://www.aldiwan.net/poem65263.html","مجزوء الكامل"],[48,"حي الديار إذ الزمان زمان","https://www.aldiwan.net/poem66132.html","الكامل"],[50,"يا ليلتي لم أنم شوقا وتسهادا","https://www.aldiwan.net/poem63896.html","البسيط"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[50,"عامت سليمى ومسها سغب","https://www.aldiwan.net/poem64838.html","المنسرح"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[76,"لا غرو إن نال منك السقم ما سألا","https://www.aldiwan.net/poem39238.html","الطويل"],[76,"لا غرو إن نال منك السقم والضرر","https://www.aldiwan.net/poem39315.html","البسيط"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1312","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42492","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55191","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54816","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23651","البسيط"],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[77,"نبِّهْ نديمك للصَّبوح وهاتِها","https://www.poetsgate.com/ViewPoem.aspx?id=33816",""],[90,"النفثة!","https://www.poetsgate.com/ViewPoem.aspx?id=179076",""],[91,"فلسفة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=53232",""]],"verses":[["لا غُرَّ قَومُكَ كَم نَومٍ عَلى ضَمَدٍ","سُقماً وَلَو بَطريرِ الغَربِ مَسنونِ",0,"ن",1,0],["لِأَغَرُّ تُعشي الشَمسَ غُرَّتُهُ","وَيَشُقُّ جَيبَ اللَيلِ مُشرِقُهُ",1,"ق",2,0],["لَأَغنَتكَ عَن وَصلي الهُمومُ القَواطِعُ","وَعَن مَشرَعِ الذُلِّ الرِماحُ الشَوارِعُ",2,"ع",1,1],["لا غَرَّني بَعدَكِ إِنسانُ","فَقَد بَدَت لي مِنكِ أَلوانُ",3,"ن",1,1],["لا غَرْوَ أنْ طلَعَتْ فَعالُكَ أنْجُماً","إنّ الهُدى فلَكٌ عليْكَ مَدارُهُ",4,"ر",2,0],["لاَ غَرْوَ أَنَّ الرُّعْبَ خَامَرَ قَلْبَهَا","فَالأُسْدُ تُخَشَى وَهْيَ فِي أَجَمَاتِهَا",5,"ت",3,0],["لا غَروَ إِن قَصَّرتُ فيكَ فَقَد","جَلَّ المُصابُ وَجاوَزَ الوُسعا",6,"ع",2,0],["لا غَروَ إِن غَنّى بِمَدحِكَ صائِحٌ","أَو مُسجِحٌ في حَلبَةِ المُدّاحِ",7,"ح",1,0],["لا غَروَ إِن أَشرَقَ في مَنزِلي","في لَيلَةِ القَدرِ مُحَيّا الوَزير",8,"ر",1,1],["لا غَروَ إِن عَمَّروا في الأَرضِ وَاِبتَكَروا","فيها أَفانينَ إِصلاحٍ وَعُمرانِ",9,"ن",1,0],["لا غَروَ أَن نالَ اللَئيمُ بِهَجوِهِ","مِنّي مَنالاً لَم تَنَلهُ كِرامُ",10,"م",1,1],["لا غَروَ أَن أَصبَحَ المُؤَيَّدُ بَي","نَ الناسِ صَبّاً مُوَلَّهاً بِعُمَر",11,"ر",1,1],["لا غَروَ أَن ضاعَتِ الأَعيادُ بَينَكُمُ","رِفقاً كَأَنّي بِكُم قَد ضاعَتِ الجُمَعُ",12,"ع",1,1],["لا غَروَ في أَن ذَكَرنا الحُزنَ حينَ نَهَت","عَنهُ النُهى وَتَرَكنا الصَبرَ ناسينا",13,"ن",2,0],["لا غُروَ أُمُّ المَجدِ في بَكرِ الحِجى","مِن أَن يُضافَ إِلَيكَ صِنوٌ أَعقَمُ",14,"م",1,0],["لا غَرْوَ أَنْ شُقَّتْ جُيُوبٌ بَعْدَكُمْ","فِي المَشْرِقَيْنِ وَنُكِّسَتْ أَعْلامُ",15,"م",1,0],["لا غَيرَ أَنّا كَأَنّا مِن تَذَكُّرِها","وَطولِ ما قَد نَأَتنا نُزَّعٌ هيمُ",16,"م",1,0],["لا غروَ أنْ فُقْتَ الملوكَ سيادةً","إِذْ كان جَدُّكَ سيِّدَ الأنصارِ",17,"ر",1,0],["لاغَروَ إِن فَتَنَتكَ بِال","لَحَظاتِ فاتِرَةُ الجُفونِ",18,"ن",1,1],["لا غرْوَ إن أعربت عن أحسابِهم","فأبو البقاءِ أحقُّ بالإعراب",19,"ب",1,0],["لا غروَ إن جئتُ النسيب بمدحةٍ","من غيرِ ما غَزَلٍ وغير نسيب",20,"ب",1,1],["لا غروَ إن أحييتني بالنَّدى","إنَّ النَّدى والشمس محيي النبات",21,"ت",1,0],["لا غرْ وإن نشأت منشأ الرياض وفي","يمناك كلّ نمير الوَدق دلاّح",22,"ح",1,0],["لا غَرْوَ أن تذري الدموع أجاجها","ونداكَ عذبٌ في الأكُّفِ قراح",23,"ح",1,0],["لا غَرْوَ إن نفحت مدائحُ ناظمٍ","والخضرُ سارٍ في خلال نشيدها",24,"د",3,0],["لا غَرْوَ إن باتَ دمعي","بالرَّيِّ ينجز وعدَك",25,"ك",1,0],["لا غروَ إن سلَّيتُ عن","بلدي حشايَ الذَّاكره",26,"ر",2,0],["لا غرْوَ إن عمرَ البيوتَ معانياً","عافٍ عمرت له البيوتَ ذخائرا",27,"ر",2,0],["لا غَرْوَ إن حجزت محل الحجاز لهاً","بنقط أيسرها المعمور معمور",28,"ر",1,0],["لا غَرْو حين نراك لابس خلعة","فالشمس تحت الغيم أمكن ما ترى",29,"ر",2,0],["لا غَرْوَ إن تسكر شمسية","لموعةٌ تصدر عن ألمع",30,"ع",1,0],["لا غَرْوَ إن شبب نظم الورى","فيها فقد غنَّت على الدفِّ",31,"ف",1,0],["لا غَرْوَ إن بدَّلت من عمها بدلاً","وقد أغاث حماها نجل إبدال",32,"ل",1,0],["لا غَرْوَ أن أهوى بوجنته إلى","زهر الشقيق فطالما حنّ لدم",33,"م",1,0],["لا غرَّني يا صاحبَ الدَّسْتيجَهْ","بهجةُ تلك الصورة البهيجَهْ",34,"ه",1,1],["لا غرو أن حُيِّنَ بي حتى هلكْ","إن البغاثَ للصُّقور والشبكْ",35,"ك",1,0],["لَأُغَلغِلَنَّ إِلى كَريمٍ مِدحَةً","وَلَأُثنِيَنَّ بِنائِلٍ وَفَعالِ",36,"ل",1,0],["لا غُراباً يُطارِدُ الدودَ في الأَر","ضِ وَبوماً في اللَيلِ يَبكي الطُلولا",37,"ل",2,0],["لا غابَتي اليَومَ كَعَهدي بِها","وَلا الَّتي أَحبَبتُها فيها",38,"ي",3,0],["لا غرو إِن حَمّ منك جِسمٌ","فَعادَة الأسد أَن تُحمّا",39,"م",2,0],["لا غرو عند نزوحكم عن دجلة","ان شيعتكم بالقلوب رجالها",40,"ل",3,0],["لا غرو امّا عبد الا","نسان فيك الوثنا",41,"ن",2,0],["لاغتراف الثراء من فيض مصر","كل يوم يأتي إلى مصر وفد",42,"د",1,0],["لا غذاء في جَوفهم لا كساء","لا غطاء من فوقهم لا ِوطاء",43,"ا",2,0],["لا غبن بالحق إن ذهبتم","فان للفكرة البقاء",44,"ا",2,0],["لأُغادِيَنَّ الرَّاحَ وهيَ زُلالُ","وَلأَطْرُقَنَّ البَيْتَ فيهِ غَزَالُ",45,"ل",1,0],["لا غايتي تُبْغَى ولا في حَلبتي","جارٍ ولا في قوسِ فضلِيَ نازعُ",46,"ع",1,0],["لا غروَ إِنْ حُزْتَ المروءةَ والتُقَى","والدينَ والدنيا ولم تتصَدَّعِ",47,"ع",1,0],["لا غروَ إِن أشرقتْ مضاجعُهُ","فإِنها من منازلِ القمرِ",48,"ر",1,0],["لَأَغَرَّ يَنجابُ الظَلامُ لِوَجهِهِ","وَبِهِ النُفوسَ يَقَعنَ كُلَّ قَرارِ",49,"ر",1,0],["لا غَرْوَ إنْ غَرِيَ العَذولُ بِلَوْمِه","طَالَتْ صَبابَتُهُ فطالَ مَلامُه",50,"م",2,0],["لأغلبَ عامُه في السِّلْمِ يَومٌ","ولكنْ يَومُه في الحَربِ عامُ",51,"م",1,0],["لِأَغزَرِ المُنعِمينَ طولَ نَدىً","وَأَرفَعِ العالِمينَ طورَ عُلى",52,"ل",2,0],["لا غَروَ أَن يَصلى الفُؤادُ لِبُعدِكُم","ناراً تُؤَجِّجُها يَدُ التِذكارِ",53,"ر",1,1],["لا غَروَ إِن أَمسى مَشيداً وَقَد","أُسِّسَ بِالمَعروفِ بُنيانُه",54,"ن",2,0],["لا غَروَ إِن جُدتَ لِلوُفّادِ قاصِدَةً","إِلَيكَ تَطوي الفَلا طَيَّ الطَواميرِ",55,"ر",1,0],["لا غَروَ إِن قَصَّ جَناحي الرَدى","فَعُذرُهُ في فِعلِهِ واضِحُ",56,"ح",1,1],["لا غُشَّ جُبْنٍ فيهمُ فَكأنَّهم","سُبكوا بِنِيرانِ الحُروبِ وسُجِّروا",57,"ر",3,0],["لا غَروَ إِن قُتِلوا صَبراً وَلا عَجَبٌ","فَالقَتلُ لِلصَبرِ في حُكمِ القَنا تَبَعُ",58,"ع",1,0],["لا غَروَ إِن نِلتُ ما أَمَّلتُ مِنهُ فَقَد","أَنزَلتُ مُعظَمَ آمالي بِذي كَرَمِ",59,"م",1,0],["لاغرْوَ إنْ حدتْ بنوهُ مناقبي","كلٌّ على مَجْرى أبيهِ جارِ",60,"ر",1,0],["لاغَروَ إِن صِرتُ تَحتَ الخَتمِ واقِعَةً","إِنَّ الجَواهِرَ تَحتَ الخَتمِ تُحتَمَلُ",61,"ل",1,0],["لا غَروَ أَن قامَت عَلَيهِ أَسطُراً","لَمّا رَأَتهُ مُدَرَّعاً لِكِفاحِ",62,"ح",1,0],["لا غَروَ إِن أَصبَحَت خَيلانُ وَجنَتِهِ","جَمراً فَقَد مَسَّها مِن خَدِّهِ نارُ",63,"ر",1,1],["لا غايَةً وَانتِهَاءً يَا عَظِيمُ لَها","ولا لَهُم أمَدٌ يُقْضَى وَيُنْتَظَرُ",64,"ر",1,0],["لا غَرْوَ أنْ حَمَّلَ أيّامُهُ","ودهْرُهُ وَسْقاً على وَسْق",65,"ق",1,0],["لا غَليظٌ تَنبو الطَبيعَةُ عَنهُ","نَبوَةَ السَمعِ عَن شَنيعِ الكَلامِ",66,"م",1,0],["لا غايَتي مِنهُ هَوىً","تُلفى مَغَبَّتُهُ نَدامَه",67,"م",2,0],["لِأَغَرَّ يَنفَرِجُ الدُجى عَن وَجهِهِ","عَدلُ السِياسَةِ حُبُّهُ إيمانُ",68,"ن",1,0],["لا غَروَ إِلّا لِحَمّادٍ أَبي عُمَرٍ","يَظَلُّ فَهداً وَيسري اللَيلَ فَهّادا",69,"د",2,0],["لا غَروَ إِلّا دَرسُها","بَينَ الأَمَقِّ إِلى كُداكِد",70,"د",1,0],["لا غَروَ إِلّا فَتى العَشيرَةِ عا","فَتهُ المَنايا وَدونَهُ أَشَبُ",71,"ب",1,0],["لا غَروَ إِلّا حَمامٌ في مَساكِنِهِم","تَدعو هَديلاً فَيَستَغري بِهِ الطَرَبُ",72,"ب",1,0],["لاغَروَ إِلاّدارُ سُكّانِنا","تُمسي بِها الرُبدُ مَعَ الرَبرَبِ",73,"ب",1,0],["لا غروَ إنْ نالَ منْكَ السُّقمُ ما سألا","قد يُكسَف البدرُ أَحياناً إذا كَمُلا",74,"ل",2,1],["لا غَرْوَ إِنْ نالَ مِنْكَ السُّقْمُ والضَّررُ","قَدْ تُكْسَفُ الشَّمْسُ لا بَلْ يُخْسَفُ القَمَرُ",75,"ر",1,1],["لا غَرْوَ أنْ تَخذَ العِذَارَ حمائلا","إذْ ظَلّ فتّاكاً به وقّاذا",76,"ذ",2,0],["لا غَرْوَ إن شَحّتْ بغُمْضِ جُفُونها","عيني وسَحّتْ بالدّموعِ الذّرّفِ",77,"ف",1,0],["لا غرو إن فرّ حرٌّ خوف محنته","فكل ذي رهب يأوي إلى هرب",78,"ب",1,0],["لا غَروَ إِن فَنَنانِ مِن عيدانِهِ","لَقِيا حِماماً لِلبَرِيَّةِ آكِلا",79,"ل",2,0],["لا غَرْوَ أَنْ أَصْبَحْتُ تَحْتَ قِيَادِهِ","فَالْحُبُّ أَغْلَبُ لِلنُّفُوسِ وَأَقْهَرُ",80,"ر",1,0],["لا غَرْوَ أَنْ أَبْصَرْتَ في صَفَحَاتِهَا","صُوَرَ الْحَوَادِثِ فَهْيَ مِرْآةُ الْغَدِ",81,"د",1,0],["لا غَرْوَ أَنْ هِمْتُ مِنْ وَجْدٍ بِصُورَتِهَا","فَالْحُسْنُ مَشْغَلَةٌ لِلْعَقْلِ وَالْبَصَرِ",82,"ر",1,0],["لا غَرْوَ أَنْ جَمَعَ المَحَامِدَ يافِعاً","وَسَمَا بِهِمَّتِهِ عَلَى نُظَرائِهِ",83,"ا",3,0],["لاَ غَرْوَ أَنَّ مَلِيكَ وَادِي النِّيلِ","أَهْدَى إِلَيْكَ وِسَامَ اسمَعِيلِ",84,"ل",1,1],["لاَ غَرْوَ أَنْ بَدَتِ الصَّبَا","بَةُ وَهيَ فِي عَيْنَيْكَ سَكْرَى",85,"ر",2,0],["لا غَرْوَ أَنْ سُرَّتْ أَمَا","رِيكَا بِزَوْرَتِكَ الفَرِيدَهْ",86,"د",2,0],["لاَ غَرْوَ أَنَّ المَاسَ أَكْرَمُ جَوْهَرٍ","خَبَأَتْهُ أَرْضٌ مِنْ كُنُوزِ سَمَاءِ",87,"ا",2,0],["لا غَرْوَ أَنْ يهْوَى الأَمِيرَ اَلْمُفْتَدَى","شَعْبٌ رَأَى فِيهِ الكَمَالَ مُصَوَّرَا",88,"ر",2,0],["لا غرو أن يضعَ المهديُّ هاديَهُ","حالاً ليرفعه حالاً إذا ثارا",89,"ر",2,0],["لا غَزْوَ؛ هذا منزلٌ مُسْتَأْصِلٌ","في المجد، بُرْجُ الشمس منه يَغَار",90,"ر",1,0],["لا غارقًا في الدمع، أو مُتَخَضِّبًا","بدم الحروب يَرُوعُ لونُ خِضَابه",91,"ب",2,0],["لا غرو إن أقض حق عشرتها","عشرتُها لي طويلة الأمد",92,"د",1,0],["لا غَرو أنّ الرّومَ خامَرَ قلْبَها","فالأُسْدُ تُخْشى وهي في أجماتِها",93,"ت",3,0],["لا غرو أنْ سال قصيدي دماً","فانَّ قلبيْ مثخنٌ بالجِراح",94,"ح",1,0],["لا غرابا يطارد الدّود في الأرض","ويوما في اللّيل يبكي الطّلولا",95,"ل",2,0]]}