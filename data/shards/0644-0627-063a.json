an.net/poem59035.html","عموديه"],[473,"لا ينسإ الله منا معشراً شهدوا","https://www.aldiwan.net/poem1821.html","البسيط"],[477,"شاهدته يوم الدفاع","https://www.aldiwan.net/poem36888.html","مجزوء الكامل"],[477,"ما للقريض تعاصى","https://www.aldiwan.net/poem36906.html","المجتث"],[477,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[477,"وجه غادتي القمر","https://www.aldiwan.net/poem37069.html","المقتضب"],[491,"لا غيث نعماه في الورى خلب","https://www.aldiwan.net/poem67342.html","المنسرح"],[493,"يا نفس صبرا وإلا فاهلكي جزعا","https://www.aldiwan.net/poem10236.html","البسيط"],[512,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[513,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[536,"يا طيب الإسم والأفعال والشيم","https://www.aldiwan.net/poem47937.html","عموديه"],[538,"يا دار سعدى بالجزع من ملل","https://www.aldiwan.net/poem56706.html","المنسرح"],[549,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[556,"يا أيها البارق الذي برقا","https://www.aldiwan.net/poem34294.html","المنسرح"],[556,"إني أنا المكتوب في الطرس","https://www.aldiwan.net/poem34445.html","السريع"],[556,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[560,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[560,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[562,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[565,"بأبي أقيك من الحوادث والردى","https://www.aldiwan.net/poem69492.html","الكامل"],[573,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[573,"لا غرو لما غاب شمس الضحى","https://www.aldiwan.net/poem2855.html","السريع"],[573,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[584,"لا غرو إن هز عطفي نحوك الطرب","https://www.aldiwan.net/poem17413.html","البسيط"]],"verses":[["لا غُرَّ قَومُكَ كَم نَومٍ عَلى ضَمَدٍ","سُقماً وَلَو بَطريرِ الغَربِ مَسنونِ",0,"ن",1,0],["لِأَغَرُّ تُعشي الشَمسَ غُرَّتُهُ","وَيَشُقُّ جَيبَ اللَيلِ مُشرِقُهُ",1,"ق",2,0],["لَأَغنَتكَ عَن وَصلي الهُمومُ القَواطِعُ","وَعَن مَشرَعِ الذُلِّ الرِماحُ الشَوارِعُ",2,"ع",1,1],["لا غَرَّني بَعدَكِ إِنسانُ","فَقَد بَدَت لي مِنكِ أَلوانُ",3,"ن",1,1],["لا غَرْوَ أنْ طلَعَتْ فَعالُكَ أنْجُماً","إنّ الهُدى فلَكٌ عليْكَ مَدارُهُ",4,"ر",2,0],["لاَ غَرْوَ أَنَّ الرُّعْبَ خَامَرَ قَلْبَهَا","فَالأُسْدُ تُخَشَى وَهْيَ فِي أَجَمَاتِهَا",5,"ت",3,0],["لا غَروَ إِن قَصَّرتُ فيكَ فَقَد","جَلَّ المُصابُ وَجاوَزَ الوُسعا",6,"ع",2,0],["لا غَروَ إِن غَنّى بِمَدحِكَ صائِحٌ","أَو مُسجِحٌ في حَلبَةِ المُدّاحِ",7,"ح",1,0],["لا غَروَ إِن أَشرَقَ في مَنزِلي","في لَيلَةِ القَدرِ مُحَيّا الوَزير",8,"ر",1,1],["لا غَروَ إِن عَمَّروا في الأَرضِ وَاِبتَكَروا","فيها أَفانينَ إِصلاحٍ وَعُمرانِ",9,"ن",1,0],["لا غَروَ أَن نالَ اللَئيمُ بِهَجوِهِ","مِنّي مَنالاً لَم تَنَلهُ كِرامُ",10,"م",1,1],["لا غَروَ أَن أَصبَحَ المُؤَيَّدُ بَي","نَ الناسِ صَبّاً مُوَلَّهاً بِعُمَر",11,"ر",1,1],["لا غَروَ أَن ضاعَتِ الأَعيادُ بَينَكُمُ","رِفقاً كَأَنّي بِكُم قَد ضاعَتِ الجُمَعُ",12,"ع",1,1],["لا غَروَ في أَن ذَكَرنا الحُزنَ حينَ نَهَت","عَنهُ النُهى وَتَرَكنا الصَبرَ ناسينا",13,"ن",2,0],["لا غُروَ أُمُّ المَجدِ في بَكرِ الحِجى","مِن أَن يُضافَ إِلَيكَ صِنوٌ أَعقَمُ",14,"م",1,0],["لا غَرْوَ أَنْ شُقَّتْ جُيُوبٌ بَعْدَكُمْ","فِي المَشْرِقَيْنِ وَنُكِّسَتْ أَعْلامُ",15,"م",1,0],["لا غَيرَ أَنّا كَأَنّا مِن تَذَكُّرِها","وَطولِ ما قَد نَأَتنا نُزَّعٌ هيمُ",16,"م",1,0],["لا غروَ أنْ فُقْتَ الملوكَ سيادةً","إِذْ كان جَدُّكَ سيِّدَ الأنصارِ",17,"ر",1,0],["لاغَروَ إِن فَتَنَتكَ بِال","لَحَظاتِ فاتِرَةُ الجُفونِ",18,"ن",1,1],["لا غرْوَ إن أعربت عن أحسابِهم","فأبو البقاءِ أحقُّ بالإعراب",19,"ب",1,0],["لا غروَ إن جئتُ النسيب بمدحةٍ","من غيرِ ما غَزَلٍ وغير نسيب",20,"ب",1,1],["لا غروَ إن أحييتني بالنَّدى","إنَّ النَّدى والشمس محيي النبات",21,"ت",1,0],["لا غرْ وإن نشأت منشأ الرياض وفي","يمناك كلّ نمير الوَدق دلاّح",22,"ح",1,0],["لا غَرْوَ أن تذري الدموع أجاجها","ونداكَ عذبٌ في الأكُّفِ قراح",23,"ح",1,0],["لا غَرْوَ إن نفحت مدائحُ ناظمٍ","والخضرُ سارٍ في خلال نشيدها",24,"د",3,0],["لا غَرْوَ إن باتَ دمعي","بالرَّيِّ ينجز وعدَك",25,"ك",1,0],["لا غروَ إن سلَّيتُ عن","بلدي حشايَ الذَّاكره",26,"ر",2,0],["لا غرْوَ إن عمرَ البيوتَ معانياً","عافٍ عمرت له البيوتَ ذخائرا",27,"ر",2,0],["لا غَرْوَ إن حجزت محل الحجاز لهاً","بنقط أيسرها المعمور معمور",28,"ر",1,0],["لا غَرْو حين نراك لابس خلعة","فالشمس تحت الغيم أمكن ما ترى",29,"ر",2,0],["لا غَرْوَ إن تسكر شمسية","لموعةٌ تصدر عن ألمع",30,"ع",1,0],["لا غَرْوَ إن شبب نظم الورى","فيها فقد غنَّت على الدفِّ",31,"ف",1,0],["لا غَرْوَ إن بدَّلت من عمها بدلاً","وقد أغاث حماها نجل إبدال",32,"ل",1,0],["لا غَرْوَ أن أهوى بوجنته إلى","زهر الشقيق فطالما حنّ لدم",33,"م",1,0],["لا غرَّني يا صاحبَ الدَّسْتيجَهْ","بهجةُ تلك الصورة البهيجَهْ",34,"ه",1,1],["لا غرو أن حُيِّنَ بي حتى هلكْ","إن البغاثَ للصُّقور والشبكْ",35,"ك",1,0],["لَأُغَلغِلَنَّ إِلى كَريمٍ مِدحَةً","وَلَأُثنِيَنَّ بِنائِلٍ وَفَعالِ",36,"ل",1,0],["لا غُراباً يُطارِدُ الدودَ في الأَر","ضِ وَبوماً في اللَيلِ يَبكي الطُلولا",37,"ل",2,0],["لا غابَتي اليَومَ كَعَهدي بِها","وَلا الَّتي أَحبَبتُها فيها",38,"ي",3,0],["لا غرو إِن حَمّ منك جِسمٌ","فَعادَة الأسد أَن تُحمّا",39,"م",2,0],["لا غرو عند نزوحكم عن دجلة","ان شيعتكم بالقلوب رجالها",40,"ل",3,0],["لا غرو امّا عبد الا","نسان فيك الوثنا",41,"ن",2,0],["لاغتراف الثراء من فيض مصر","كل يوم يأتي إلى مصر وفد",42,"د",1,0],["لا غذاء في جَوفهم لا كساء","لا غطاء من فوقهم لا ِوطاء",43,"ا",2,0],["لا غبن بالحق إن ذهبتم","فان للفكرة البقاء",44,"ا",2,0],["لأُغادِيَنَّ الرَّاحَ وهيَ زُلالُ","وَلأَطْرُقَنَّ البَيْتَ فيهِ غَزَالُ",45,"ل",1,0],["لا غايتي تُبْغَى ولا في حَلبتي","جارٍ ولا في قوسِ فضلِيَ نازعُ",46,"ع",1,0],["لا غروَ إِنْ حُزْتَ المروءةَ والتُقَى","والدينَ والدنيا ولم تتصَدَّعِ",47,"ع",1,0],["لا غروَ إِن أشرقتْ مضاجعُهُ","فإِنها من منازلِ القمرِ",48,"ر",1,0],["لَأَغَرَّ يَنجابُ الظَلامُ لِوَجهِهِ","وَبِهِ النُفوسَ يَقَعنَ كُلَّ قَرارِ",49,"ر",1,0],["لا غَرْوَ إنْ غَرِيَ العَذولُ بِلَوْمِه","طَالَتْ صَبابَتُهُ فطالَ مَلامُه",50,"م",2,0],["لأغلبَ عامُه في السِّلْمِ يَومٌ","ولكنْ يَومُه في الحَربِ عامُ",51,"م",1,0],["لِأَغزَرِ المُنعِمينَ طولَ نَدىً","وَأَرفَعِ العالِمينَ طورَ عُلى",52,"ل",2,0],["لا غَروَ أَن يَصلى الفُؤادُ لِبُعدِكُم","ناراً تُؤَجِّجُها يَدُ التِذكارِ",53,"ر",1,1],["لا غَروَ إِن أَمسى مَشيداً وَقَد","أُسِّسَ بِالمَعروفِ بُنيانُه",54,"ن",2,0],["لا غَروَ إِن جُدتَ لِلوُفّادِ قاصِدَةً","إِلَيكَ تَطوي الفَلا طَيَّ الطَواميرِ",55,"ر",1,0],["لا غَروَ إِن قَصَّ جَناحي الرَدى","فَعُذرُهُ في فِعلِهِ واضِحُ",56,"ح",1,1],["لا غُشَّ جُبْنٍ فيهمُ فَكأنَّهم","سُبكوا بِنِيرانِ الحُروبِ وسُجِّروا",57,"ر",3,0],["لا غَروَ إِن قُتِلوا صَبراً وَلا عَجَبٌ","فَالقَتلُ لِلصَبرِ في حُكمِ القَنا تَبَعُ",58,"ع",1,0],["لا غَروَ إِن نِلتُ ما أَمَّلتُ مِنهُ فَقَد","أَنزَلتُ مُعظَمَ آمالي بِذي كَرَمِ",59,"م",1,0],["لاغرْوَ إنْ حدتْ بنوهُ مناقبي","كلٌّ على مَجْرى أبيهِ جارِ",60,"ر",1,0],["لاغَروَ إِن صِرتُ تَحتَ الخَتمِ واقِعَةً","إِنَّ الجَواهِرَ تَحتَ الخَتمِ تُحتَمَلُ",61,"ل",1,0],["لا غَروَ أَن قامَت عَلَيهِ أَسطُراً","لَمّا رَأَتهُ مُدَرَّعاً لِكِفاحِ",62,"ح",1,0],["لا غَروَ إِن أَصبَحَت خَيلانُ وَجنَتِهِ","جَمراً فَقَد مَسَّها مِن خَدِّهِ نارُ",63,"ر",1,1],["لا غايَةً وَانتِهَاءً يَا عَظِيمُ لَها","ولا لَهُم أمَدٌ يُقْضَى وَيُنْتَظَرُ",64,"ر",1,0],["لا غَرْوَ أنْ حَمَّلَ أيّامُهُ","ودهْرُهُ وَسْقاً على وَسْق",65,"ق",1,0],["لا غَليظٌ تَنبو الطَبيعَةُ عَنهُ","نَبوَةَ السَمعِ عَن شَنيعِ الكَلامِ",66,"م",1,0],["لا غايَتي مِنهُ هَوىً","تُلفى مَغَبَّتُهُ نَدامَه",67,"م",2,0],["لِأَغَرَّ يَنفَرِجُ الدُجى عَن وَجهِهِ","عَدلُ السِياسَةِ حُبُّهُ إيمانُ",68,"ن",1,0],["لا غَروَ إِلّا لِحَمّادٍ أَبي عُمَرٍ","يَظَلُّ فَهداً وَيسري اللَيلَ فَهّادا",69,"د",2,0],["لا غَروَ إِلّا دَرسُها","بَينَ الأَمَقِّ إِلى كُداكِد",70,"د",1,0],["لا غَروَ إِلّا فَتى العَشيرَةِ عا","فَتهُ المَنايا وَدونَهُ أَشَبُ",71,"ب",1,0],["لا غَروَ إِلّا حَمامٌ في مَساكِنِهِم","تَدعو هَديلاً فَيَستَغري بِهِ الطَرَبُ",72,"ب",1,0],["لاغَروَ إِلاّدارُ سُكّانِنا","تُمسي بِها الرُبدُ مَعَ الرَبرَبِ",73,"ب",1,0],["لا غروَ إنْ نالَ منْكَ السُّقمُ ما سألا","قد يُكسَف البدرُ أَحياناً إذا كَمُلا",74,"ل",2,1],["لا غَرْوَ إِنْ نالَ مِنْكَ السُّقْمُ والضَّررُ","قَدْ تُكْسَفُ الشَّمْسُ لا بَلْ يُخْسَفُ القَمَرُ",75,"ر",1,1],["لا غَرْوَ أنْ تَخذَ العِذَارَ حمائلا","إذْ ظَلّ فتّاكاً به وقّاذا",76,"ذ",2,0],["لا غَرْوَ إن شَحّتْ بغُمْضِ جُفُونها","عيني وسَحّتْ بالدّموعِ الذّرّفِ",77,"ف",1,0],["لا غرو إن فرّ حرٌّ خوف محنته","فكل ذي رهب يأوي إلى هرب",78,"ب",1,0],["لا غَروَ إِن فَنَنانِ مِن عيدانِهِ","لَقِيا حِماماً لِلبَرِيَّةِ آكِلا",79,"ل",2,0],["لا غَرْوَ أَنْ أَصْبَحْتُ تَحْتَ قِيَادِهِ","فَالْحُبُّ أَغْلَبُ لِلنُّفُوسِ وَأَقْهَرُ",80,"ر",1,0],["لا غَرْوَ أَنْ أَبْصَرْتَ في صَفَحَاتِهَا","صُوَرَ الْحَوَادِثِ فَهْيَ مِرْآةُ الْغَدِ",81,"د",1,0],["لا غَرْوَ أَنْ هِمْتُ مِنْ وَجْدٍ بِصُورَتِهَا","فَالْحُسْنُ مَشْغَلَةٌ لِلْعَقْلِ وَالْبَصَرِ",82,"ر",1,0],["لا غَرْوَ أَنْ جَمَعَ المَحَامِدَ يافِعاً","وَسَمَا بِهِمَّتِهِ عَلَى نُظَرائِهِ",83,"ا",3,0],["لاَ غَرْوَ أَنَّ مَلِيكَ وَادِي النِّيلِ","أَهْدَى إِلَيْكَ وِسَامَ اسمَعِيلِ",84,"ل",1,1],["لاَ غَرْوَ أَنْ بَدَتِ الصَّبَا","بَةُ وَهيَ فِي عَيْنَيْكَ سَكْرَى",85,"ر",2,0],["لا غَرْوَ أَنْ سُرَّتْ أَمَا","رِيكَا بِزَوْرَتِكَ الفَرِيدَهْ",86,"د",2,0],["لاَ غَرْوَ أَنَّ المَاسَ أَكْرَمُ جَوْهَرٍ","خَبَأَتْهُ أَرْضٌ مِنْ كُنُوزِ سَمَاءِ",87,"ا",2,0],["لا غَرْوَ أَنْ يهْوَى الأَمِيرَ اَلْمُفْتَدَى","شَعْبٌ رَأَى فِيهِ الكَمَالَ مُصَوَّرَا",88,"ر",2,0],["لا غرو أن يضعَ المهديُّ هاديَهُ","حالاً ليرفعه حالاً إذا ثارا",89,"ر",2,0],["لا غَزْوَ؛ هذا منزلٌ مُسْتَأْصِلٌ","في المجد، بُرْجُ الشمس منه يَغَار",90,"ر",1,0],["لا غارقًا في الدمع، أو مُتَخَضِّبًا","بدم الحروب يَرُوعُ لونُ خِضَابه",91,"ب",2,0],["لا غرو إن أقض حق عشرتها","عشرتُها لي طويلة الأمد",92,"د",1,0],["لا غَرو أنّ الرّومَ خامَرَ قلْبَها","فالأُسْدُ تُخْشى وهي في أجماتِها",93,"ت",3,0],["لا غرو أنْ سال قصيدي دماً","فانَّ قلبيْ مثخنٌ بالجِراح",94,"ح",1,0],["لا غرابا يطارد الدّود في الأرض","ويوما في اللّيل يبكي الطّلولا",95,"ل",2,0],["لاغُرو إِن عادَ لي قَلب تحل بِهِ","روَضاً فَكُلُ مَكان مِنكَ بُستانُ",96,"ن",1,0],["لاغراضه يرضى ويغضب جاهلا","بحاليه مفتون الخيال مدى المدا",97,"د",2,0],["لا غرو ان جهل الغبي مقامه","فالعمى ظهر اليوم في ظلمات",98,"ت",1,0],["لا غرو فهو ابنه من آل فاطمه","بل من أجل بني الإشراف كلهم",99,"م",1,0],["لا غرق الساعات في قبلة","من خده الواضح الثغر",100,"ر",1,0],["لا غياةٌ لي أتعزى بها","حيناً ولا أقنع بالذكر",100,"ر",1,0],["لا غرو أولى القبلتين","ان اصطفيت لها خدين",101,"ن",1,0],["لا غروَ إنْ باعَ المتيمُ نفسهُ","إن كان يا ليلاىَ يلْثم فاك",102,"ك",1,0],["لا غاب راجيك من جوادٍ","إن جاءَ قصداً إليك يسْعَى",103,"ع",2,0],["لا غروَ إن دان الزمانَ وأنتمُ","أبطالُه ولَيوثه وحُماتُه",104,"ت",2,0],["لا غرَّ ذا المالَ الكثير بربحه","أمسى فقيراً خانَهُ الإثْرَاءُ",105,"ا",2,0],["لا غرو إن لم يُر لي بعد رؤيتها","في القلب صادٌ ولا باءٌ ولا راءُ",106,"ا",2,0],["لا غرو إِن رَسخت فيه جِبلَّتُهُ","طبعُ الألِبَّاءِ في ذي اللُّبَِّ رَسَّاخُ",107,"خ",1,0],["لاَ غَرو إِن حُزتَ فَهماً","عَن جُملَةِ الحَلَقَاتِ",108,"ت",1,0],["لا غرو أن يتسمى غيرهُ ملكاً","فليس يلتبسُ المنكورُ بالعلمِ",109,"م",1,0],["لا غروَ أن كنتَ الأخيرَ زمانُهُ","فالفضلُ للآصالِ والأسحارِ",110,"ر",1,0],["لا غرو إن عشق المعالي يافعاً","فالفرع يتبع أصله في السؤددِ",111,"د",1,0],["لا غرو إن يممت كل الأنام له","وورد مغناه أضحى وهو مورودُ",112,"د",1,0],["لا غرو فالشبلُ مثل الليث في صفة","والدوحُ كالروضِ في زهرٍ وأفنانِ",113,"ن",1,0],["لا غاية تنجلي لناظرهم","منه ولا ينقضي لهم أرب",114,"ب",1,0],["لَأَغنى كَما أَغنى عَنِ الصُبحِ حِندِسٌ","دَجالا كَما أَغنى عَنِ البَدرِ كَوكَبُ",115,"ب",1,0],["لا غاضَ ذا المُلكُ العَقيمُ فَإِنَّهُ","بَحرٌ وَأَملاكُ الدُنا خُلجانُهُ",116,"ن",2,0],["لا غرو إن أحببتكم من قبل ما","شاهدتكم أنتم جمال العالم",117,"م",1,0],["لإغبابِ مَرآكَ الفُؤادُ مُدَلَّهٌ","فآونَةً يُضحي وآونَةً يُصلى",118,"ل",2,0],["لاَ غَرْوَ إِنْ قَتَلَتْ عُيُونُكِ مُغْرَماً","فَلَكَمْ صَرَعْتِ بِها مِنَ الآسَادِ",119,"د",1,0],["لا غرو إن جزعوا من هول حادثةٍ","كادت لها منهم الأصلاب تنقصفُ",120,"ف",1,0],["لا غر وإن نلت السما بصنايع","هذا يتممها وذاك المبتدى",121,"د",2,0],["لا غَروَ أَن لجَّ زَمانٌ جائِرٌ","فَاِعتَرَقَ العَظمَ المُمِخَّ وَاِنتَقى",122,"ا",1,0],["لا غَرو لوْ أحرقَتْ نارُ الهوى كَبِدي","والنارُ حَقٌّ على مَن يَعبُدُ الوثَنا",123,"ن",2,0],["لأُغضي عَلى بَغضائِهِ وَاِزوِرارِهِ","وَأَعجَبُ مِن حُرٍّ كَريمٍ يُعاتِبُهْ",124,"ب",2,0],["لا غالَهُم صَرفُ الزَمانِ فَكَم لَهُم","في الدَهرِ مِن يَومٍ أَغَرَّ مُحَجَّلِ",125,"ل",1,0],["لا غرْمَ إن نقضوا الصّلاة وأسْرفوا","لا بدّ ثمّةَ نُسَّكٌ عُبّادُ",126,"د",1,0],["لا غروَ إنْ جاوَزت حَدَّ المدى ألَقًا","واسْتَوْطَنَتْ بَرْزَخًا تَشْتاقُهُ البَشَرُ",127,"ر",1,0],["لا غروَ أَن نَزَلَت مَلائكةُ العُلى","تَغشاهُ بالرِّضوانِ وَالتَسليمِ",128,"م",1,0],["لأَغناطِيُوسْ نُهدي التَهاني بِمنحةٍ","حَباهُ بِها رَبُّ العُلى وَالفَواضلِ",129,"ل",1,1],["لا غَرْوَ أنْ رَحَل الشبابُ وبانا","ما كان أولَ من صَحِبتُ فخانا",130,"ن",2,1],["لا غرّني من ذوي النامون سسمتهم","والشر يظهره في الأعين الحدق",131,"ق",1,0],["لا غَنيٌّ منَ الخلائقِ عَنكا","مِن رضاهُ حباكَ مَولاك ملكا",132,"ك",2,0],["لا غروَ أَن صارَ ناراً بالجحودِ فقد","تُغيّر الوصفَ في الشيء اِستحالاتُ",133,"ت",1,0],["لا غنيّاً من الخلائقِ عنه","وهوَ عن كلّهم له اِستغناءُ",134,"ا",2,0],["لا غرو إن راح النسيم بسره","فإليه من يهوى اصطفته رسولا",135,"ل",2,0],["لا غروَ فالطلابُ قد عَشِقوا بكُم","صِدقَ الوفا وطهارةَ الوجدانِ",136,"ن",1,0],["لا غَرْوَ أنك قد نشأتَ خلالَهُمْ","قد ينبتُ النُّوَّار بين قَتاد",137,"د",1,0],["لا غَرْوَ أنْ راحتْ نَشاوى واغتدت","فلقد شَرِبْنَ دمَ الفوارسِ راحا",138,"ح",2,0],["لا غرو أن كان كلُّ الناس حامده","من لم يزل محسناً لازال محمودا",139,"د",2,0],["لا غاب عن عيني انسانها","كلا ولا منها الحشى اوحشا",140,"ش",2,0],["لا غرو هذا قد أتى خير الورى","لم تمنع الأموال عنه ولا الدول",141,"ل",1,0],["لا غيرَ أنَّي مانعٌ شَرَفي","ومُبينُ فَضْلِ عُلايَ في الأُمم",142,"م",1,0],["لا غَروَ إِن كانَ الجَوادُ بِكُلّما","تَحوي يَداهُ فَهوَ نَجلُ جَوادِ",143,"د",1,0],["لا غَروَ إِن أَمسى يضلُّ بشعره","كَم قَد أَضَلَّ مِنَ الأَنامِ المُندِسُ",144,"س",1,0],["لا غَروَ إِن لَعِبَت بِهِ الأَشواقُ","هِيَ رامَةٌ وَنَسيمُها الخَفّاقُ",145,"ق",1,1],["لَأَغتَفِرَنَّ ما أَبقَتهُ عِندي","إِساءَتُهُنَّ وَالحَسَناتُ تَمحو",146,"ح",2,0],["لاَغَرْوَ فيِ أَنْ ذَمَّهُ مَنْ لَمْ يَجِدْ","شِعْراً بِمَيْنِ هِجَائِهِ الْمَكْسُورِ",147,"ر",1,0],["لاَ غَرْوَ أنَّا وَقَدْ قَلَّدْتَنَا مِنَناً","نُدْلِي إِلَى شًكْرِهَا قَسْراً بِتَقْصِيرِ",148,"ر",1,0],["لاَ غَرْوَ إِنَّا قَطَعْنَا","إِلَيْهِ شُمَّخَ بِيدِ",149,"د",1,0],["لا غروَ أن رَقَصَت بذاكَ قلوبُهم","وأدارُ كاساتِ السرورِ الحاسي",150,"س",2,0],["لا غرو أن أصبحتَ تأمُرُ بال","صَّبرِ الجميلِ فأنت يعقوب",151,"ب",1,0],["لا غَروَ أن يُروى ثَرَاهُ وقبرهُ","باقٍ ليوم العَرضِ تحت العارضِ",152,"ض",1,0],["لا غَروَ إِن جَرحَ القُلوبَ بلحظه","أَنَّ الحُسامَ كَذاكَ يَفعَلُ حَدُّهُ",153,"د",2,0],["لا غرو وان امسيت ذخراً للورى","وملاذها بالفضل والأنعام",154,"م",1,0],["لأغنية الرّاعي تُليّنُ قلبَها","فرقّي لهذا الشاعرِ المتغزِّل",155,"ل",1,0],["لا غرو ان جَعَلوني من تفضلهم","سلمان بينهم من بعد سلمان",156,"ن",1,0],["لا غَرْوَ أنْ حَسُنَ الوُجودُ فإنَّهُ","لَمَّا أَطاعَ لَها وَخَفَّ ازْدَانا",157,"ن",2,0],["لا غَرْوَ أن تُلْقِيَ الدُّنيا مَقادَتَها","إليكَ فالفَلَك الدّوّار مُنْقادُ",158,"د",1,0],["لا غَرْوَ أن كَمُلَت أدِلّةُ فَضْله","لمّا بدا فَضْلُ الكَمالِ وَلاحا",159,"ح",2,0],["لا غَرْو أن يُعْزى الظهور لملة","لَمْ يَبْرحُوا دُون الوَرى ظُهَراءها",160,"ا",3,0],["لأَغْرَيَنَّ بِذَمِّ الْبَيْنِ بَعْدَكمُ","وَكَيْفَ تَحْمَدُ نَفْسُ التَّالِفِ التَّلَفا",161,"ف",2,0],["لا غَروَ أَن أَحكي بِمَدحيكَ يا","مُحَمَّدُ المُحسِنُ حَسّانا",162,"ن",2,0],["لا غَروَ إِن راحَ وَمَلبوسُهُ","كَأَنَّما أَصدَرَهُ عَن دَمي",163,"م",2,0],["لا غرو ان ملك التجلد واكتسى","ثوب الرضا فالعلم فيه أصيل",164,"ل",1,0],["لا غروَ إِذ كانوا بسوحكَ في غنىً","عَن مربعٍ نَضِرٍ وعن مُصطافِ",165,"ف",1,0],["لا غرو إِن سقط الجوادُ لعثرةٍ","عثرت لَها قدمُ النَدى والباسِ",166,"س",1,0],["لا غَروَ إِن فتنَت قَلبي نَواظره","كَم فِتنَةٍ دونَ ذاك الناظِر الغَنِجِ",167,"ج",1,0],["لا غرو إمّا لقوا عقبى تخاذلِهمْ","فكلُّ شعبٍ رهينٌ بالذي اجترحا",168,"ح",2,0],["لا غرو إن ملكتْ فؤادي خدعة","إنَّ الكريمَ متى يخادع يخدع",169,"ع",1,0],["لا غرو أن عقدت لسان أولى النهى","عن مثلها بالسحر من كلماتها",170,"ت",3,0],["لا غرو أن لاحت عليه طلاوةٌ","شعبان كل حلاوةٍ في نصفه",171,"ه",1,0],["لا غروَ إِن حَمَد الورى مسراهمُ","بِصباحِ نصحٍ في اللّيالي الجونِ",172,"ن",1,0],["لا غروَ إِن أَضحى قريرَ العينِ في","جنّاتهِ الأنهارُ مِنها دافِقَه",173,"ق",2,0],["لا غروَ قَد شَمَخت ديارُ الغرب في","يَومِ الفخارِ عَلى سِواها معطسا",174,"س",2,0],["لا غروَ أن أصبحتَ صاحبَ ختمهِ","وَغدا بصدرك يودعُ الأسرارا",175,"ر",2,0],["لا غَرو وَالأهواءُ تَستهدي النهى","أن يستفزّ منَ السرورِ وقورُ",176,"ر",1,0],["لا غروَ إِن صرتَ بدراً بين زهرهم","تَحوي الكمالَ بسعيٍ منك محمودِ",177,"د",1,0],["لا غروَ أَن يَحظى بكلِّ كَرامةٍ","في عيشةٍ مرضيّةٍ رُهجوجه",178,"ج",2,0],["لا غروَ في قلبِ الحقائق منك إذ","سَبخيّ سنخكَ قَد يحيلُ الواجبا",179,"ب",2,0],["لا غَروَ أَن مَنَحوهُ بِالرُتَبِ السَنِي","يَةِ وَاِرتَقى لِمَناصِبِ الإِجلالِ",180,"ل",1,0],["لا غَروَ إِن رَقَصَ القَنالَ وَأَهلَهُ","فَرَحاً بِهِ مِن حَيثُ نالوا ذا المَنالِ",181,"ل",1,0],["لا غَروَ إِن سَمَّيتَها دُرِّيَه","حَيثُ الثُرَيا أُختُها البَكرِيَّه",182,"ي",2,0],["لا غَرْوَ أَنْ صَغُرَتْ عَن قَدْرِكَ الرُّتَبُ","وَقَبْلَها قَصرَتْ عَن شَأْوِكَ الشُّهُبُ",183,"ب",1,1],["لا غَيرَ مَن لا غَيرُهُ لي إِلَه","إِذ ما لِمَوجودٍ وَجودٌ سِواه",184,"ه",1,1],["لا غروَ فَالحسن يُروى عَن أَبي حَسَن","وَالعَين تَقنع مِنهُ إِذ تَرى أَثَرا",185,"ر",2,0],["لا غروَ في فعلها بالعهد إن صدقَت","وإن وَفَت فزمانُ الوصل مغتنما",186,"م",2,0],["لا غرْوَ إنْ وَسَمَتْ أَيدي الجيادِ له","مناكبَ الأرضِ من قاصٍ إلى دان",187,"ن",1,0],["لأَغرَّ من عُلْيا بَجيلةَ ماجدٍ","بادي المَهابةِ في النُّفوسِ مُبَجَّل",188,"ل",1,0],["لا غَرْوَ إن صدَقَتْ ظُنوني بَعدَما","عَلِقَتْ يدي بالفاضلِ المُتفَضَّل",188,"ل",1,0],["لا غَرْو إذا رأيتَنا نَفتَرِقُ","الصَبْحُ معَ الظّلامِ لا يَتّفِقُ",189,"ق",1,0],["لأغرَّ يَعتذِرُ الزّمانُ بوَجْهِه","عمّا جناهُ من الذُّنوبِ فيُعْذَر",190,"ر",1,0],["لا غْروَ لم تَزَلِ الوِزارةُ قَبلَهُ","تَستَنُّ بينَ مُقَصِّرٍ أو مُقْصِر",191,"ر",1,0],["لاْغلَيتَ قِدْماً سِع