x?id=199910",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[4948,"ولما نأت عني العشيرة كلها","https://www.poetsgate.com/ViewPoem.aspx?id=81275",""],[5038,"المربد العجب","https://www.poetsgate.com/ViewPoem.aspx?id=190219",""],[585,"يا نازح الدار هل أحسست بالدار","https://www.poetsgate.com/ViewPoem.aspx?id=161940",""],[585,"سلوه وقد مال السرير المطنب","https://www.poetsgate.com/ViewPoem.aspx?id=161851",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[5131,"أَيضحكُ مأسورٌ نعمْ ويكبّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=55360",""],[5239,"ومقشعر الجلد مزوَرُّ الحدق","https://www.poetsgate.com/ViewPoem.aspx?id=190936",""],[5302,"ولكنه حظ الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=204916",""],[5351,"يمانيون يا طه تنادت","https://www.poetsgate.com/ViewPoem.aspx?id=202647",""],[5376,"كرامةٌ تلامسُ السماء","https://www.poetsgate.com/ViewPoem.aspx?id=188265",""],[5376,"مسلمو بورما لا بواكي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=188478",""],[5436,"صبح بغداد ( بدر عمر المطيري )","https://www.poetsgate.com/ViewPoem.aspx?id=53718",""],[5616,"اسمنت","https://www.poetsgate.com/ViewPoem.aspx?id=203432",""],[5616,"وثن","https://www.poetsgate.com/ViewPoem.aspx?id=203456",""],[5751,"امتحانُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=214724",""],[5770,"قم حي غزة","https://www.poetsgate.com/ViewPoem.aspx?id=178369",""],[402,"أتاجرة النفائس والغوالي","https://www.poetsgate.com/ViewPoem.aspx?id=35541",""],[5809,"سلوا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=205565",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5939,"تعريف من معجم العشق","https://www.poetsgate.com/ViewPoem.aspx?id=180328",""],[5956,"لقبُ المظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=183733",""],[5956,"أ تأتي الإمارات يا صالح؟","https://www.poetsgate.com/ViewPoem.aspx?id=194595",""],[5970,"يقولون في الصبر الجميل تعلة","https://www.poetsgate.com/ViewPoem.aspx?id=130657",""],[6004,"أيُّ ربيعٍ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=109515",""],[6093,"عودتنا اللطف يا ألله في القدر","https://www.poetsgate.com/ViewPoem.aspx?id=211355",""],[6102,"مرثية كل يوم","https://www.poetsgate.com/ViewPoem.aspx?id=185050",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[5536,"سيف دولتنا عليا !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76355&r=&rc=33",""]],"verses":[["فَما اِستَحضَروا العِلّاتِ وَهيَ كَريمَةٌ","وَلا أَطرَقوا مِن رَوعَةٍ وَوُجومِ",0,"م",1,0],["فَما اِستَخَفَّكَ مِن حَملِ النُهى خَرَقٌ","وَلا اِستَكَفَّكَ عَن طَعنِ العِدى خَفَرُ",1,"ر",1,0],["فَما اِستَيقَظوا حَتّى تَداعى صَهيلُها","وَقَد سَبَقَت أَلحاظَهُم عَبَراتُها",2,"ت",3,0],["فَما أَسْنَدَتْني كَفُّ أَرْوَعَ مَاجِدٍ","إِلى نَحرِ رَوْعاءِ الفُؤَادِ حَصانِ",3,"ن",1,0],["فَما اسْطَعْتُ قَبْضاً للعِنانِ فإنّهُ","أحَقُّ السّجايا بالعَلاءِ وبالمَجْدِ",4,"د",1,0],["فَما اِسطَعتِ أَن تَستَمرِئي مُرَّ طَعمِهِ","وَما اِسطَعتُ بَينَ القَومِ أَن أَتَقَدَّما",5,"م",2,0],["فَما اِستَعَضنا خَليلاً مِنكِ يَحبِسُنا","وَلا اِستَفَدنا حَبيباً عَنكِ يَثنينا",6,"ن",2,0],["فَما اِستَسقَيتُ مِن غَيمٍ جَهامٍ","وَلا اِستَورَيتُ مِن زَندٍ شَحاحِ",7,"ح",1,0],["فَما اسْتَرْعَاهُ إلاَّ صَوْتُ عَانٍ","بِجَانِبِهِ يُصَارِعُهُ الْحِمَامُ",8,"م",1,0],["فَما اِستَوَينا كُلُّنا حَتّى وَقَف","غُلَيِّمٌ كانَ قَريباً مِن شَرَف",9,"ف",1,0],["فما أسرى معالي المدح دُرًّا","أنظّمه على تاج السرَاةِ",10,"ه",1,0],["فما أسدٌ جهم المحيا شتيمه","قُصاقصةٌ ورد السِّبال غضنفر",11,"ر",1,0],["فَما أَسعَدَ الإِنسانَ في ساعَةِ المُنى","وَما أَجمَلَ الأَحلامَ في أَوَّلِ العُمرِ",12,"ر",1,0],["فَما اِستَتَرَت كَيما يُضِلُّ مُسافِرٌ","وَلا بَزَغَت كَي يَستَنيرَ الَّذي ضَلّا",13,"ل",2,0],["فَما اِستَشعَرَ المُصغي إِلَيكَ مَلالَةً","وَلا قُلتَ إِلّا قالَ مِن طرَبٍ زِدني",14,"ن",2,0],["فَما اِستَحيَيتَ إِذ نَظَرَتكَ عَيني","وَلا خَفَّضتَ إِذ سَمِعَتكَ أُذني",15,"ن",2,0],["فَما اِستَثقَلَت فُرسانَها إِن تَلاحَقَت","وَما اِستَبعَدَت غاياتِها حينَ مُدَّتِ",16,"ت",1,0],["فَماأُسِرا إِنَّ المَذاهِبَ لَم تَكُن","مُحيطاً بِكَيدِ الآسِرينَ مَجالُها",17,"ل",3,0],["فَما اِستُجديتَ إِلّا جِئتَ عَفواً","كَفَيضِ البَحرِ أَو صَوبِ الغَمامِ",18,"م",1,0],["فَما أُسائِلُ عَن قَومٍ صَحِبتُهُمُ","ذَوي مَحاسِنَ إِلّا قيلَ قَد بادوا",19,"د",3,0],["فَما اِستَقَرَّ بِهِ حَتّى تَبَوَّأَهُ","مِنَ الحَمائِمِ زَوجٌ بارِعُ الرَّنَمِ",20,"م",1,0],["فَما اِستَطاعَت قُرَيشٌ نَيلَ ما طَلَبَت","وَهَل تَنالُ الثُّرَيّا كَفُّ مُستَلِمِ",20,"م",1,0],["فَما اِستَجمَلَت نَفسي حَديثاً لِغَيرِها","وَإِن كانَ لَحناً ما تُحَدِّثُنا خَلفا",21,"ف",2,0],["فَما أَستَسيغُ الماءَ يَعذُبُ ظامِئاً","وَلا أَستَطيبُ الظِلَّ يَبرُدُ ضاحِيا",22,"ي",2,0],["فَما أَسوَدٌ أَلمى المَحاجِرِ مُطفِلٌ","بِأَحسَنَ مِنها مُقلَتَينِ تُديرُها",23,"ر",3,0],["فما اسْطاعوا لِحُكمِ اللّيثِ رَدّاً","ولا وَجدوا لهم من ناصرينا",24,"ن",2,0],["فَما اِستَفحَلَ الشَرُّ إِلّا اِرعَوى","وَلا اِضطَرَب الأَمرُ إِلّا اِستَتَبْ",25,"ب",1,0],["فما اسطعتَ فاجعل مِن يقينك جُنَّةً","كفى بيقينِ المرءِ للمرءِ واقيا",26,"ي",2,0],["فَما اِستَطاعَت غَيرَ أَن أَومَأَت","نَحوي بِعَيني شادِنٍ أَدعَجِ",27,"ج",1,0],["فما اسْوَدَّ مِنْ لَيْلٍ غَدَا وَهو أبيَضٌ","وَما ابيضَّ مِنْ صُبْحٍ غَدا وَهْوَ مُسْوَدُّ",28,"د",1,0],["فما استَمَدّوا بسيْفٍ غيرِ مُنصَلِتٍ","ولا استَبَدّوا بعَزْمٍ غيرِ مَأتيّ",29,"ي",1,0],["فما أسْرَجُوا حتى تَعَثّرْتُ بالقَنَا","ولا ألجَموا حتى مَرَقْتُ من الخِيَم",30,"م",1,0],["فَما اِستَرَقَّكَ فيما عِندَها طَمَعٌ","إِلّا اِستَعَزَّكَ فيما عِندَها الناسُ",31,"س",1,0],["فَما اِستَحسَنَت هَذي البَهائِمُ فِعلَكُم","مِنَ الغَيِّ في الأُمّاتِ وَالحَمَواتِ",32,"ت",1,0],["فما أستَقي باللَّدْنِ أسْوَدَ فارِسٍ","ولا أرْتَقي في هَضْبَةٍ أُمِّ أوْعال",33,"ل",1,0],["فَمَا أَسِفْتُ لِبُؤْسٍ بَعْدَ مَقْدرَةٍ","وَلا فَرِحْتُ بِوَفْرٍ بَعْدَ إِقْلالِ",34,"ل",1,0],["فَمَا أَسِيتُ لِشَيءٍ كُنْتُ أَمْلِكُهُ","فِي فَقْدِ أَوْجُهِهِمْ عَنْ ثَرْوَتِي عِوَضُ",35,"ض",1,0],["فَمَا اسْتَجْليْتُ إِلاَّ","أَوْجُهاً لِلصَّفْوَةِ الْغُرِّ",36,"ر",1,0],["فَمَا اسْتَرْعَى سَمَاعَكِ عَنْ تَعَالٍ","صَدَى تِلْكَ الوَسَاوِسِ فِي الصُّدُورِ",37,"ر",1,0],["فَما أَستَجيرُ بِغَيرِ العِدا","وَلا أَستَريحُ لِغَيرِ البُكا",38,"ك",2,0],["فما استفاق ضمير في جوانحنا","مخدر في ضفاف الزيف محجوب",39,"ب",1,0],["فما استنزفت من دماء القلو","ب كما استنزفت من أسى الواجده",40,"د",2,0],["فما أسوأ العيش من بعده","وما أصغر النوب الوافده",40,"د",2,0],["فما استيقظوا إلا لصكة بابهم","فأدهش رهبانا وخوف قسيسا",41,"س",2,0],["فما اسطعتَم فاسترجعوا الحكمَ منهم","فانَّهُمُ صيدٌ عليكُمْ مُحلَّل",42,"ل",1,0],["فما اسطعتَ فاجعلْ دأبَ نفسِكَ خَيرَها","ولا تُدخِلَنَّ الناسَ فيما تحاول",43,"ل",1,0],["فما استَنْهضتْ منه الرزايا عزائماً","ولا أحْكَمَ التجريبُ منهُ طباعا",44,"ع",2,0],["فَما اسم رُباعي إِذا بِأَن صَدرُهُ","غَدَوت بِهِ ذا لَوعة وَتَرنم",45,"م",1,0],["فَما اِسمي في الوُجود وَما اِعتِباري","وَما قَدري يَكون وَما مَحلي",46,"ي",1,1],["فَمَا اسمٌ تَحَلَّى بِانصِرَافٍ وَضِدِّهِ","ولَم يَكُ يَعلُو عَن ثَلاثَةِ أحرُفِ",47,"ف",1,0],["فما استحفظوا إلا ذؤيْبا مُغاورا","وما استودعوا إلا لُصَيْصا مغالطا",48,"ط",2,0],["فَما اِستَعمَلوا الغَدرَ إِلّا وَفى","وَلا أَعمَلوا الفِكرَ إِلّا اِرتَجَل",49,"ل",1,0],["فما استوعبت حفظا أياديك صحفه","أياديك لا تحصى بعد ولا حصر",50,"ر",1,0],["فما استرم الحل فيه عنده","لكن أبو حنيفة يمره",51,"ر",2,0],["فما أسا أحد أصلا إساءتكم","إلى النبي مقالا ليس بالكذب",52,"ب",1,0],["فما استحسنته إلا حباني","ولا استنهضته لصلاح شاني",53,"ن",2,0],["فما استصحبتْ إلاَّ الرجاءَ أقاربٌ","ولا استنجدتْ إلا المدامعَ عُوَّد",54,"د",1,0],["فما آسَى من الحَدَثان إلاّ","على عُمْر مُنِحناه قصيرا",55,"ر",2,0],["فما استنبَطتُ منه سوى محال","يُحَال بِه على زَيدٍ وعَمرِو",56,"ر",2,0],["فَما أَسلو هَواكَ لِنَهي ناهٍ","وَلا أَهوى سِواكَ لِلحي لاحِ",57,"ح",1,0],["فَما أَسبَلتِ إِذ أَعرضت من ستورها","بأَمنع مِمّا أَرسلَتها جُفونُها",58,"ن",3,0],["فما استجارت بعمرو مظلمةٌ","بل حين جاءتك أنت يا عمر",59,"ر",1,1],["فَما اِستَمالَتهُم الدُّنيا بِزُخرُفِها","وَلا اِزدَهَتهُم بِتَفصيلٍ وَلا جُمَلِ",60,"ل",1,0],["فما استطاعوا وأين مني","الميل عنك وعن حماك",61,"ك",1,0],["فَما اِستَغرَبَت في مَوطِنِ الحُبِّ غُربَتي","فَهَذا الدُجى في صُبحِها قَد تَغَرَّبا",62,"ب",2,0],["فما أسعد الإنسان إن ظن حُسنَها","قبيحاً وأشقاه إذا كان لا يدري",63,"ر",2,0],["فما استعذبتُ غير ندى يديه","وما استعذبته مما عداها",64,"ا",3,0],["فما اسمٌ ثلاثي شرود موانس","تركَّبَ من عشرٍ ويلفي ثمانيا",65,"ي",2,0],["فما استعذبوا طعم الثناء ولا رأوا","مفارقةً بين السماحة والبخلِ",66,"ل",1,0],["فما أسفتُ لشيءٍ فائتٍ أسفي","من أن أعيشَ وجيرانُ الغضا غَيَبُ",67,"ب",1,0],["فما اسودَّتْ جوانحُ من عجاجٍ","ولا احمرَّتْ خدودٌ من صفاح",68,"ح",1,0],["فما استطاعوا نزالا","مع كثرة المنجنيق",69,"ق",1,0],["فما استوى الخط والخطي في رهج","ولا الكتائب يوم الروع كالكتب",70,"ب",1,0],["فما استنشقت ريح الصباح خياشم","من القوم إلا والقنا في الخياشم",71,"م",1,0],["فما اسطَعتُ توديعاً لهُ بِسوى البُكا","وذلك جهدُ المُستهامِ المُعذَّبِ",72,"ب",1,0],["فَما اِستَطاعوا لفضلٍ","آتاك ربُّك جَحْدا",73,"د",2,0],["فما استحل الناس ما استحلوا","من دم عثمان الذي أطلوا",74,"ل",3,0],["فَما اِستَقَلَّت شَمسُ النَهارِ عَلى ال","جودِيِّ حَتّى إِذا هُمُ حِزَقُ",75,"ق",1,0],["فما استَجرتُ بغيرِ الله منه ولا اس","تَغفَرتُ للذَّنبِ مِنه غَيرَ غَفّار",76,"ر",1,0],["فما أسهُوا ولَو أسهَمت حَظا","خَسيساً مِنه لَم أردِ الخسيسا",77,"س",2,0],["فما أسالُ الحاجاتِ إلاّ كأنّما","حيائي على وجهي حُسامٌ بمفرقي",78,"ي",1,0],["فما آسى لجفوةِ مَنْ جفاني","مذ استمرأتُ روضَتَهُ المَريعَه",79,"ع",2,0],["فما أسلو بغادينَ","ولا أملُّ بأصفرا",80,"ر",2,0],["فما أسامة مطروراً براثنه","ضخم الجزارة يحمي جيش أشبال",81,"ل",1,0],["فما استطاع التنائي أن يغيرني","ولم يبدل شعور الوجد وجدان",82,"ن",1,0],["فَمَا أَسْنَدُوا قَوْلاً إلَي ذِي تَمَاسُكٍ","ولاَ شَيَّدُوا زُورَ الْمَقَالِ عَلَى إِصِ",83,"ص",1,0],["فما استحر البأس إلا وله","منه لأمر الدين مشخوذ الظبا",84,"ب",2,0],["فما أسعد الانسان إن بات خالياً","خلياً من الأخدان والمال والأهل",85,"ل",1,0],["فما أسلمت وجهاً ولا أخلصت دعا","عبوديتي إلا لوجهك صافيا",86,"ي",2,0],["فمَا استطاعوا لفضلٍ ما اسْتَطَاعَ ولم","يُؤتوا من الفضلِ والعلياءِ ما أُ