{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39557","الخفيف"],[98,"الفنّ الجميل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66346&r=&rc=22",""],[119,"من لدمع طغى وقلب مهيم","https://www.aldiwan.net/poem40590.html","عموديه"],[168,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[264,"إن مدحي لخالد بن الوليد","https://www.aldiwan.net/poem35963.html","الخفيف"],[266,"ربع أسماء لا عداك عنان","https://www.aldiwan.net/poem38168.html","الخفيف"],[308,"قالوا أبوه الأصل فيه البغا","https://www.aldiwan.net/poem57632.html","السريع"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[438,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[520,"قل لمن يرتجي طنين الرباب","https://www.aldiwan.net/poem12023.html","الخفيف"],[563,"صح قولي إن السماع دواء","https://www.aldiwan.net/poem33528.html","الخفيف"],[563,"إنني غير من أحب وإني","https://www.aldiwan.net/poem33562.html","الخفيف"],[563,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[563,"يا نديمي إن غابت الناس عني","https://www.aldiwan.net/poem33759.html","الخفيف"],[563,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[563,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[567,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87116","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38209","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17075","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1386,"","https://poetry.dctabudhabi.ae/diwan/poem/104204","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48966","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111864","الخفيف"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131508",""],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130677","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53076","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67193","الرجز"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130007","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94312","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114280","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76444","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54402","الرمل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"]],"verses":[["وهو قيثارةُ الخلود عليها","يعزفُ الطيرُ في الرُّبى ألحانَه",0,"ن",2,0],["وهو قيثارة الخلود عليها","يعزف الطّير الرّبى ألحانه",1,"ن",2,0],["وهو قد خانه الحليب وحقا","من يكن عيبه الحليب سيندم",2,"م",1,0],["وَهوَ قُطبُ الأَزدِ أَنّى اِستَدارَت","شاءَ أَن يَعدِلَ أَو أَن يَحيفا",3,"ف",2,0],["وهو قرم الوغى السميذع صمصما","م حمى المجد ذو الفرند الفريد",4,"د",1,0],["وهو قبر ماشٍ يشكل رمزا","رسمه التبر زانه اللمعان",5,"ن",1,0],["وهو قياسٌ ظاهرٌ كل من","قال به حجته قاطعه",6,"ع",2,0],["وهو قلب خالد الأشواق","محموم الجراح",7,"ح",1,0],["وَهْوَ قَدْ جَدَّ واسْتَجَدَّ على شَرْ","طِ أَبُوَّاتِهِ وقال وماتا",8,"ت",2,0],["وهو قول عدلت فيه عن الغي","ر ولم أرتكب معمى الخطاب",9,"ب",1,0],["وهو قلب للعارفين صحيح","صقلته عنايةٌ واهتداء",10,"ا",2,0],["وهو قول الإله كن فيكون ال","شيء أي ما يشاؤه في البريه",11,"ي",2,0],["وهو قاض لنا ونحن شهود","عندنا الشرع لم يزل ترجمانه",12,"ن",2,0],["وهو قولي لأنه هو مثلي","وهو فاني ونور وجهك يغني",13,"ن",2,0],["وهو قرآننا بليلة قدر","قد تلوناه ساعةً وتلانا",14,"ن",2,0],["وهو قول توهمته عقولٌ","عقلت أمرها خلاف المراد",15,"د",1,0],["وهوَ قاضٍ يقومُ بالقِسطِ بين الن","ناس قد أحكمَ الخِطابَ وفَصْلَهْ",16,"ل",2,0],["وَهوَ قَلبٌ للنجم إِن بانَ مِنهُ ال","بعض فافهم إشارتي يا همام",17,"م",1,0],["وَهوَ قَلبي مِن لَظى الخدِّ اِحتَرق","لاذَ فيهِ شاكِياً نارَ الصّدودْ",18,"د",1,0],["وَهُوَ قِدماً لِلضَيفِ جوعٌ وَقَرُّ","وَلِمَولاهُ ذِلَّةٌ وَمَهانَه",19,"ن",2,0],["وهو قبيح فتنح عنه","وقد يزيد قبحة ومنه",20,"ه",1,0],["وهو قد أبدع ما نعقله","من عقول ونفوس وصور",21,"ر",1,0],["وهو قد راشه فرفَّ بجنحيه","اشتياقاً ونحو علياه طارا",22,"ر",2,0],["وهوقلبي الطفلُ الصغيرُ السجينُ","العاشقُ الهائمُ القتيلُ غَراما",23,"م",2,0],["وهوَ قولٌ ادنى الى الفهم لكن","عين هذا الدنوِّ اوضح ذامِ",24,"م",1,0],["وهو قريب أما قتيل أو هربان","وإلا أسير يحسب حلق زنجيره",25,"ر",2,0],["وهو قدر اجتهادنا وكثير","من نضير نظم وحسن نثار",26,"ر",1,0],["وهو قلب شاعر لا غرو أن","هام من وَجْدٍ بكم في كل واد",27,"د",1,1],["وهو قَسيمُ النارِ والخُلد فقل","إليه أمر النَشأتين فُوِّضا",28,"ض",2,0],["وهو قد امتدّ والمباني","عليه في خدمَةٍ قيامُ",29,"م",1,0],["وهو قطب الزمان غوث البرايا","من دعاه فقد دعى مستجيبا",30,"ب",2,0],["وهو قريبٌ من ضريح والده","وشرب الأعذب من موارده",31,"ه",1,0],["وهو قريب من ابي النمير","وكان شيخا مظهرا للخير",31,"ر",1,0],["وهو قريب الطرد والعزلان","به تبدّت مصر كالمجازِ",32,"ز",1,0],["وَهوَ قَلِيلٌ فِى فَعُلتَ وَفَعِل","غَيرُ مُعَدَّى بَل قِيَاسُهُ فَعِل",33,"ل",1,0],["وَهوَ قَولُ الله فِي الذِّكرِ","تَوَفَّاهُم مَلاَئِك",34,"ك",1,0],["وَهُوَ قَد اعطاه اياها وَفي","مثله تَسعى الفَتاة الغانية",35,"ه",1,0],["وهو قلبُ القلبِ أَبغى قلبه","فأنا من أَجل ذا في هَوَسهْ",36,"س",2,0],["وَهو قَد يَسمو فَيخطو","بَينَ جَوزاءَ ومنكِب",37,"ب",1,0],["وَهو قلّ في قديمٍ","كالرّقاع الثوبَ تَرأَب",37,"ب",1,0]]}