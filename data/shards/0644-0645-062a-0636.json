{"poems":[[53,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[53,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[53,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[47,"أنزاعا في الحب بعد نزوع","https://www.aldiwan.net/poem64684.html","الخفيف"],[83,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[53,"للحُريثيِّ أبي بكرٍ غَبَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=27034",""],[228,"لا تنوحي على ذهاب العميد","https://www.aldiwan.net/poem41884.html","الخفيف"],[280,"ما العيد بعدك بالأماني عائد","https://www.aldiwan.net/poem25592.html","الكامل"],[463,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[500,"وابأبي أنت وذاك الشنب","https://www.aldiwan.net/poem9769.html","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120065","الرمل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111148","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201647","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133987","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62829","الخفيف"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117165","المنسرح"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86462","الكامل"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22797","الرمل"],[4767,"المقام العالي","https://www.poetsgate.com/ViewPoem.aspx?id=179947",""],[5563,"كَلَّ منِّي الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=212143",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5913,"في غاية الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177074",""],[6189,"وصية حرام بن ملحان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83557&r=&rc=24",""],[572,"حَسْبِي مِنَ اللهوِ وآلاَتِ الطَّرَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9168&r=&rc=25",""]],"verses":[["لم تضِح قطُّ له نسبتُهُ","كيف والأعراقُ فيه لم تَطِبْ",0,"ب",1,0],["لم تَضِرْ قَطُّ وجهها وهْو ماءٌ","وتُذيبُ القلوبَ وهْيَ حديدُ",1,"د",1,0],["لم تضَع للتي تَكدَّس بالأب","طال بل للحصاد والتكديس",2,"س",1,0],["لم تَضَعْنِي إلا بِوَضْعك من نف","سِك فافهم جليَّةً مفهومه",3,"م",2,0],["لَم تُضِعني لَمّا أَضاعَني الدَه","رُ وَلَيسَ المُضاعُ إِلّا مُضيعي",4,"ع",2,0],["لَم تُضجَعي في لَحدِكِ الزاكي الثَرى","إِلّا وَهُنَّ لِلاِنتِظارِ قِيامُ",5,"م",1,0],["لَم تَضِق أَذرُعُنا في خَلَّةٍ","وعَلاَ ذُو الَخصمِ مشنَّا وظَهَر",6,"ر",1,0],["لم تَضِخ قطُّ له نسبتُهُ","كيف والأعراقُ فيه لم تَطِبْ",7,"ب",1,0],["لَم تُضاهِ الأَعمى الإِلهِيَّ إِلّا","وَرماكَ الأَعمى بِعَينِ الحَسودِ",8,"د",1,0],["لم تَضمَنِ البقيا لأنسي وَحشَتي","فإذا الذي أهْوَى لأنْسيَ بائِد",9,"د",1,0],["لم تضرِبا أعناقَها وسُوقَها","حرصاً لإدلاجٍ ولا معرَّسِ",10,"س",1,0],["لم تَضْنَ ألحاظك هذا الضنى","إلا ومنهن لِحَيْني سبب",11,"ب",1,0],["لم تضق أربعه الفيح على","معدم أَترب في أعطانها",12,"ن",3,0],["لم تضرب الملة البيضاء قبتها","إلا وكان علي ذو العلى عمدا",13,"د",2,0],["لم تضع تلكم العوينات لكن","ضاع مني عقلي وأُذني وعيني",14,"ي",1,0],["لم تضارعه في التقدم ارض","لا ولم يمض فيه عهد قديم",15,"م",1,0],["لم تضع سَوْرَةُ العَظائمِ عنهُ","نَظَراً في المحقراتِ الدِّقاقِ",16,"ق",1,0],["لم تَضِقِ السبلُ والفجاجُ على","حرٍّ كريمٍ بالصبرِ معتصمِ",17,"م",1,0],["لم تضف أبراد الصبا فنزعتها","ولبست وشي صفائح ولحود",18,"د",1,0],["لم تضق ذرعاً بهم إذ أقبلوا","لم ترق دمعاًعليهم ذاهبين",19,"ن",1,0],["لَم تُضَمَّن بَلدَةٌ ما ضُمّنَت","مِن جَمالَ في قُرَيشٍ وَأَسَد",20,"د",1,0],["لَم تضع ما أولدَت إلا ضَروساً","تبعث البشرى لَها جرحى وقتلى",21,"ل",2,0],["لمْ تضقْ إلا بما تخشى على","قلبِها لو زاغ في لهوٍ وتِيهْ",22,"ي",2,0],["لم تُضعْضِعْهُ قسوة ُالسجن ِلا بلْ","عَرَكَتْهُ صلابَة ًفوق مابِهْ",23,"ب",2,0],["لم تضرب العُرب أمثالاً بمنكشفٍ","لكنهم بجميل الستر قد ضربوا",24,"ب",3,0],["لم تضقْ بي عيناك كانت مداراً","شاعرياً وعالم النَّاس ضيقُ",25,"ق",1,0],["لمْ تضحَكِ الأوراقُ حتَّى تنتَحِبْ","تَرمي بها يُمنَايَ أغراضَ الكتبْ",26,"ب",1,0]]}