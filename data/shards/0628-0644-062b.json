{"poems":[[107,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[186,"قد توارى النجيب في ظل لحد","https://www.aldiwan.net/poem61063.html","الخفيف"],[580,"لأسرفت يا حماه في شدة الوقد","https://www.aldiwan.net/poem2968.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87281","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56408","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55964","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55933","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66287","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132619","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110023","الكامل"],[2110,"بعثت رسالات الدموع السواكب","https://www.poetsgate.com/ViewPoem.aspx?id=156264",""],[5741,"لقد قال لي إذ رحت من خمر ريقه","https://www.poetsgate.com/ViewPoem.aspx?id=187463",""],[5956,"خذني لعَطفك","https://www.poetsgate.com/ViewPoem.aspx?id=193808",""]],"verses":[["بِلَثْمٍ زَانَ وَجْهَكَ وَاعْتناقٍ","شَفَاكَ فما بجارحةٍ أذاةُ",0,"ه",1,0],["بَل ثَوى فيهِ لِلبَلاغةِ بَحرٌ","باتَ يُسقى بِصيِّباتِ الغَوادي",1,"د",2,0],["بلثمٍ يُعِيدُ المرْشَفَين بِلا لَمىً","وضَمٍّ يعود الصَّدرُ مِنْه بِلا نَهْدِ",2,"د",1,0],["بلثم رصيفه الدرّي","فعش لِلملك وَالجُندِ",3,"د",1,0],["بل ثقل قيدٍ فيه باتت أرجلي","مغلولة ووثاقها مستحكما",4,"م",2,0],["بلثمي راحة المولى المفدَّى","عليّ الشان كم طبت انشراحا",5,"ح",2,1],["بلثم أنامل المولى المرجى","علي الشان قد طبت انشراحاً",6,"ح",2,1],["بل ثاني السبطين فرد","ماله في الفضل ثان",7,"ن",1,0],["بلثم السيف يرتاح","كلثم الخد ذي الطره",8,"ر",2,0],["بل ثِق بمَن هُوَ عارفٌ","بالناسكينَ مَعَ المَناسِك",9,"ك",1,0],["بلثم يد الهادي بلغت كرامة","غدت جوهرا فردا بسلك المناقب",10,"ب",1,0],["بلثم شفاهي بعد رشف سلافها","تنقل فلذات الهوى في التنقل",11,"ل",1,0],["بل ثرثراتُ فتىً يسمِّى شاعِراً","كمعوِّضٍ عن حسِّهِ المذبوحِ",12,"ح",1,0]]}