{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"يا سيدا يهب الأقدار مقتدرا","https://www.aldiwan.net/poem66303.html","البسيط"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[49,"خير الرجال رفيقها","https://www.aldiwan.net/poem62197.html","مجزوء الكامل"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[166,"ارغب بسمعك عن مقال اللاحى","https://www.aldiwan.net/poem47103.html","الكامل"],[197,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[364,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[364,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[406,"قسما بوصلك إن بعد مرامه","https://www.aldiwan.net/poem50114.html","الكامل"],[416,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[434,"أرغبتم عني بأنسكم","https://www.aldiwan.net/poem25708.html","أحذ الكامل"],[437,"شمل العلا في ذراك مجتمع","https://www.aldiwan.net/poem2549.html","المنسرح"]],"verses":[["أَرغَت مَعَدٌّ وَأَثغى مَن يُناضِلُها","وَمَن يُقايِسُ بَينَ الشاءِ وَالنَعَمِ",0,"م",1,0],["أرْغَبَتْهُمْ عن القَنَا قَصَبَاتٌ","مُغْنِيَاتٌ عن كل جيشٍ مَقُودِ",1,"د",1,0],["أرْغِمْهُ فيَّ فقد أضحى يُراغِمُني","وزِدْهُ رغماً على رغم إذا رغَما",2,"م",2,0],["ارغموها على الزوا","ج بشيخ به اشر",3,"ر",1,0],["أَرغُنٌ هامَ بِهِ وِجدانُها","وَأَذانٌ عَشِقَتهُ أُذُناها",4,"ا",3,0],["إِرغَب فَأَنتَ أَسيرُها","وَازهَد فَأَنتَ طَليقُها",5,"ق",3,0],["أَرَغِبْتُمْ إذ أقبلَ الوفد في الدن","يا وكنتم من قبله زُهّادا",6,"د",2,0],["أرْغَمَ الهادي أُنُوفَ الأَعادي","بِرِضاهم وأَذَلَّ الرِّقابا",7,"ب",2,0],["أَرَغتُهُما خَتلاً فَلَم أَستَطِعهُما","فَفَرّا وَشيكاً بَعدَ ما قَتَلاني",8,"ن",2,0],["ارغبْ بسمعكًَ عن مقالِ اللاحى","واقدحْ زِنادَ الهمِّ بالأقداح",9,"ح",1,1],["أرغماها على الزواج بشيخ","ذي ثراء من أجل ذا أرغماها",10,"ا",3,0],["أرغمتني على التخلف عنها","إي وربّي وخلّفتني وراها",10,"ا",3,0],["أرْغَمْتَ آنُفَ حاسدِيكَ بسَفْرةٍ","سفَرتْ فأبدَتْ وجْهَ جَدٍّ مُقْبِلِ",11,"ل",1,1],["أرغِمْ حسوداً فيكَ يُصبحُ بالقِلَي","عُمرَ الزمانِ إناؤه رَشَاحا",12,"ح",2,0],["أَرغَب بِعَبدِك أَن يُدنس لفظهِ","بِشكاة صرف زَمانه وَخِصامِهِ",13,"م",2,0],["أَرغم الله أعاديك بما","يجدع الأَنف به جدعاً ويرغم",14,"م",1,0],["أَرَغِبْتُمُ عَنِّي بِأُنْسِكُمُ","وَحَرَمْتُموني طِيبَ أَمْسِكُمُ",15,"م",1,1],["أرغمت بالجود حاسدي فما","لي عن ذراك المنيف مندفع",16,"ع",1,0]]}