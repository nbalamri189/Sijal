{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"يا سيدا يهب الأقدار مقتدرا","https://www.aldiwan.net/poem66303.html","البسيط"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[51,"خير الرجال رفيقها","https://www.aldiwan.net/poem62197.html","مجزوء الكامل"],[107,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[69,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[170,"ارغب بسمعك عن مقال اللاحى","https://www.aldiwan.net/poem47103.html","الكامل"],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[369,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[412,"قسما بوصلك إن بعد مرامه","https://www.aldiwan.net/poem50114.html","الكامل"],[422,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[440,"أرغبتم عني بأنسكم","https://www.aldiwan.net/poem25708.html","أحذ الكامل"],[443,"شمل العلا في ذراك مجتمع","https://www.aldiwan.net/poem2549.html","المنسرح"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100149","الكامل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177903","الرجز"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80244","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61254","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46531","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80009","البسيط"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131335","الرجز"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216395",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[2823,"","https://poetry.dctabudhabi.ae/diwan/poem/146728","السريع"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113873","الخفيف"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112381","المجتث"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129475","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109887","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66535","المتقارب"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111048","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199063","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127242","الرمل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111114","الرجز"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93739","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83198","الرجز"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141102","الخفيف"],[4684,"الكشّاش","https://www.poetsgate.com/ViewPoem.aspx?id=201152",""],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5550,"لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=212683",""],[5690,"أرغمت أنف الضد إذ عاملتهُ","https://www.poetsgate.com/ViewPoem.aspx?id=172200",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[6124,"لست سحارا","https://www.poetsgate.com/ViewPoem.aspx?id=174658",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6323,"نفثة عاشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82171&r=&rc=2",""]],"verses":[["أَرغَت مَعَدٌّ وَأَثغى مَن يُناضِلُها","وَمَن يُقايِسُ بَينَ الشاءِ وَالنَعَمِ",0,"م",1,0],["أرْغَبَتْهُمْ عن القَنَا قَصَبَاتٌ","مُغْنِيَاتٌ عن كل جيشٍ مَقُودِ",1,"د",1,0],["أرْغِمْهُ فيَّ فقد أضحى يُراغِمُني","وزِدْهُ رغماً على رغم إذا رغَما",2,"م",2,0],["ارغموها على الزوا","ج بشيخ به اشر",3,"ر",1,0],["أَرغُنٌ هامَ بِهِ وِجدانُها","وَأَذانٌ عَشِقَتهُ أُذُناها",4,"ا",3,0],["إِرغَب فَأَنتَ أَسيرُها","وَازهَد فَأَنتَ طَليقُها",5,"ق",3,0],["أَرَغِبْتُمْ إذ أقبلَ الوفد في الدن","يا وكنتم من قبله زُهّادا",6,"د",2,0],["أرْغَمَ الهادي أُنُوفَ الأَعادي","بِرِضاهم وأَذَلَّ الرِّقابا",7,"ب",2,0],["أَرَغتُهُما خَتلاً فَلَم أَستَطِعهُما","فَفَرّا وَشيكاً بَعدَ ما قَتَلاني",8,"ن",2,0],["ارغبْ بسمعكًَ عن مقالِ اللاحى","واقدحْ زِنادَ الهمِّ بالأقداح",9,"ح",1,1],["أرغماها على الزواج بشيخ","ذي ثراء من أجل ذا أرغماها",10,"ا",3,0],["أرغمتني على التخلف عنها","إي وربّي وخلّفتني وراها",10,"ا",3,0],["أرْغَمْتَ آنُفَ حاسدِيكَ بسَفْرةٍ","سفَرتْ فأبدَتْ وجْهَ جَدٍّ مُقْبِلِ",11,"ل",1,1],["أرغِمْ حسوداً فيكَ يُصبحُ بالقِلَي","عُمرَ الزمانِ إناؤه رَشَاحا",12,"ح",2,0],["أَرغَب بِعَبدِك أَن يُدنس لفظهِ","بِشكاة صرف زَمانه وَخِصامِهِ",13,"م",2,0],["أَرغم الله أعاديك بما","يجدع الأَنف به جدعاً ويرغم",14,"م",1,0],["أَرَغِبْتُمُ عَنِّي بِأُنْسِكُمُ","وَحَرَمْتُموني طِيبَ أَمْسِكُمُ",15,"م",1,1],["أرغمت بالجود حاسدي فما","لي عن ذراك المنيف مندفع",16,"ع",1,0],["أرغمت آنافاً بغيرك","لم تكن تاللَه ترغم",17,"م",1,0],["أرغب وهو زاهد وهو المنى","أختاره من لي به فأشتفي",18,"ف",2,0],["اَرغَبتَ أَرض الانكليز لِأَنَّها","أَرض المَلائكِ في مَرابِعِها الهَنا",19,"ن",2,0],["ارغَب إِلى الرَّحمن يا مَن رَأى","خطي أَن يَعفو عَن كاتبه",20,"ه",1,1],["أَرغب فَما بِالرَّهبه","تَصفو لَكَ المَحبه",21,"ه",1,0],["أرغمتِ منها أنوفاً كلُّها شممٌ","ما أرغمت بين أطراف القنا السمرِ",22,"ر",1,0],["أرغفةٌ تٌعْمَلُ أسيوطِيَّهْ","بِسُكّرٍ وفستقٍ مَحْشِيَّهْ",23,"ه",1,0],["أرْغَد لْقاحه والفطيم","والطِعْم ما حَدٍّ شَراه",24,"ا",2,0],["أرغمت في شرخ الصبا نفسي له","ارغام عبد مخلص النيات",25,"ت",1,0],["أرغمتموا الحساد لما رمتموا","قصد الامام العادل القمقام",26,"م",1,0],["ارغب في العلم ولا أدعي","أني إلى غايته أهتدي",27,"ي",1,1],["أرغد العيش في الحجاز ولكن","دونه الفتك من عيون الغواني",28,"ن",2,0],["أرغم أني قاصد بيت الترف","أعني قديم المجد في ذاك الطرف",29,"ف",1,0],["أرغَى المَشيبُ وأزبَد","وابيَضّ ما كانَ أسوَد",30,"د",1,1],["أرغمت حظي والزمان كلاهما","والناس من طلق ومن جباه",31,"ه",1,0],["أَرغَمتُ أَعدائي فكُلٌ ناظِرٌ","شَزراً إليَّ بمقلةٍ شوصاءِ",32,"ا",2,0],["أَرْغَمْتَ يا مَوْتُ أُنوفَ القَنا","وَدُسْتَ أَعْناقَ السُّيوفِ الحِدادْ",33,"د",1,0],["أرغمت أنف الحاسدين بطلعة","أمست لها شهب السما حسادها",34,"د",3,0],["أرغمت بالعلم أعداء بهم حنق","سود القلوب لهم بالإفك أخبار",35,"ر",1,0],["أرغمت كرتها أنف المجوس","إذ تجلى الماء في أزهارها",36,"ه",2,0],["أرغم الأعداء طرا حيث قد","كان تبرا وهم كانوا الرغام",37,"م",1,0],["أرغم فيها جاحداً وحاسدا","لم تر إلا شاكراً وحامدا",38,"د",2,0],["أَرغى بنوء الياسمين عبابها","فتموجت بالفضة البيضاء",39,"ا",2,0],["أَرِغْم بفضلكَ ضدَّ مَنْقَبتي","لا زالَ فضلُكَ مُرِغمَ الضّدِ",40,"د",1,0],["أَرغَبَ عَن جِدالِ","أَكَفَّ عَن قِتالِ",41,"ل",1,0],["أرغمن هذه القيود الثّقال","ربّ ودّ مصيره للتّغالي",42,"ل",2,1],["أرغى , تنحنح , فخّم الصوت, ثغا","ثم الجواب إذا تلاه تلعثما",43,"م",2,0],["أرغم الأنف من بنياتك السو","د فباتت مذعورة تّتقيه",44,"ي",2,0],["أرغموني أنْ أُجاري بالهوى","مَن نَكا جُرحي وأدمي رِقَّتي",45,"ت",2,0],["أَرْغمتْه الأحزانُ في عيشه أنْ","يقضيَ الليل ساهرا كالنجوم",46,"م",1,0],["أرغمت أنف الضد إذ عاملتهُ","والعفو شأنك رحمةً بخطيئةِ",47,"ه",1,1],["أرْغٓتْ قلوصي على سقْبٍ بذي سٓلٓمِ","ظل الطريق وضرعي زبْدها رابي",48,"ب",2,0],["أرغمتْني أنْ أفكَّ السحرَ عنْها","رغم أنِّي لستُ سحَّارًا شقيَّا",49,"ي",2,1],["أَرْغَى أَزْبَدَ هَدَّدَ أَوْعَدَ","وَأَخِيراً: يُقْبَضُ كالفار",50,"ر",1,0],["أَرغم اللَه بِالرَشاد وَأَنكى","أَنف شرك لوهنه قد تلكا",51,"ك",2,0],["أَرغَمتُ أَنفَ عَوَاطِفِي فَإِذا بهَا","تَبتزُّني بمِلامِحِ الأَحقَادِ",52,"د",1,0]]}