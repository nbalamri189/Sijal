[4755,"صُبِّي عَلَيَّ غَمَامَةً","https://www.poetsgate.com/ViewPoem.aspx?id=183573",""],[4888,"الشاطئان مصر والإمارات","https://www.poetsgate.com/ViewPoem.aspx?id=207744",""],[4908,"ماذا يخبئ....","https://www.poetsgate.com/ViewPoem.aspx?id=207536",""],[4929,"قُلْ للذي أبْكَتْ يداهُ زماني","https://www.poetsgate.com/ViewPoem.aspx?id=199282",""],[4984,"إِنِّي هُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=206075",""],[4119,"لو كان سرك للوشاة معرضا","https://www.poetsgate.com/ViewPoem.aspx?id=16177",""],[5092,"تلفاز قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177003",""],[5092,"حبلٌ من الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=178350",""],[5150,"العاشقه ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204341",""],[5277,"رَبْح..أم الخير","https://www.poetsgate.com/ViewPoem.aspx?id=191819",""],[5356,"كيفَ لا أشتاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=212097",""],[5431,"((أني معك!))","https://www.poetsgate.com/ViewPoem.aspx?id=198345",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5431,"كليّ معك ...","https://www.poetsgate.com/ViewPoem.aspx?id=199533",""],[5447,"محمد الصغير .. أنا والبيت الأول، والأخير","https://www.poetsgate.com/ViewPoem.aspx?id=208332",""],[5493,"نشيدُ الشجر","https://www.poetsgate.com/ViewPoem.aspx?id=197037",""],[5533,"جاءَ البَشير","https://www.poetsgate.com/ViewPoem.aspx?id=186841",""],[5660,"إِنَّ البُكاءَ لَدى التَّفَرُّقِ أَجمَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=24647",""],[5720,"هذا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=199913",""],[5720,"إنّي هويتُ الصادقين","https://www.poetsgate.com/ViewPoem.aspx?id=206230",""],[3856,"مَعنًى يُجَاهِدُ فِي شِفاهِ الأبكَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=215913",""],[5873,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=215307",""],[5909,"إني هجرت الجبَّ بعد تولِّهم","https://www.poetsgate.com/ViewPoem.aspx?id=210604",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[6082,"لطفا كفى","https://www.poetsgate.com/ViewPoem.aspx?id=60250",""],[6170,"دمشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86030&r=&rc=1",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""]],"verses":[["إِنّي هَزَزتُكَ لا آلوكَ مُجتَهِداً","لَو كُنتَ سَيفاً وَلَكِنّي هَزَزتُ عَصا",0,"ص",2,0],["أنَّى هجوتَ بني ثوابَهْ","يا صاحبَ العينِ المُصابَهْ",1,"ب",2,1],["إن يُهدِ مُنفِسة إليك وليُّها","فلقد أتيح لها الكفِيّ المنْفِسُ",2,"س",1,0],["إني هتفت بكل يوم بسالة","للترك لم يؤثر من الآساد",3,"د",1,0],["إن يهذروا فلقد تركت قلوبهم","تشكو صوادع جمة وكلوما",4,"م",2,0],["إِنّي هَجَرتُكَ إِذ هَجَرتُكَ وَحشَةً","لا العَودُ يُذهِبُها وَلا الإِبداءُ",5,"ا",2,0],["إِنّي هَتَفتُ بِخالِدٍ وَلَقَد دَنَت","نَفسي لِثُغرَةِ نَحرِها لِحِظارِ",6,"ر",1,0],["إني هُديتُ لنعمةٍ مكنونةٍ","فأثَرتُها من تُربةٍ وصَفاةِ",7,"ه",1,1],["إِنّي هَويتُ حَبيباً لَستُ أَذكُرُهُ","إِلّا تَبادَرَ ماءُ العَينِ يَنسَكِبُ",8,"ب",1,0],["إِنّي هَويتُ غَزالاً","مُساعِداً لي بِسولي",9,"ل",2,0],["إِن يُهلِكِ التابِعُ التَبيعَ فَقَد","يَمقُلُهُ في الغِنى إِذا مَقَلَه",10,"ل",2,0],["أنّى هجَرتَ لِهجْرِ واشٍ بي كمَنْ","في لَوْمِهِ لُؤْمٌ حكَاهُ فهاذَا",11,"ذ",2,0],["إني هززتك في البلاء فلم أجد","عزماً يفل ولا إباء يغضب",12,"ب",1,0],["أنّى هجَرتَ لِهُجْرِ واشٍ بي، كَمَن","في لَومِهِ لُؤمٌ حَكَاهُ، فَهاذَى",13,"ذ",2,0],["إنْ يهمزوك بإرجافٍ فقد بُليتْ","كلُّ الشعوبِ بهمّازٍ ومشّاء",14,"ا",2,0],["أني هززتُكَ بالقوافي قاصداً","بكَ خدمةَ التاريخِ والآداب",15,"ب",1,0],["إِن يَهدُمَ الصَدُّ مِن جِسمي مَعالِفَه","فَإِنَّ قَلبي بَقَت الوَجدِ مَعمور",16,"ر",1,1],["إني هجرت الدار","دار الجوى والنار",17,"ر",1,0],["أَنِيَّةُ الغَداةِ أَمِ اِنتِقالُ","لِمُنصَرِفِ الظَعائِنِ أَم دَلالُ",18,"ل",1,1],["إِنِّي هَجَرْتُ الْعالَمِينَ إِلى الَّذِي","هَجَرَ الْغَبِيَّ إِلى الأَبِيِّ صَفاؤُهُ",19,"ا",3,0],["أنّي هجرتُك لا كظنْ","نِكَ طائعاً لكنْ برَغمِي",20,"م",2,0],["إِنْ يَهَبُوا يُجْزِلُوا أَوْ يقطعُوا يَصِلُوا","أَوْ يعقِدُوا عَقْدَ مَحْرُومِ الوفاءِ يَفُوا",21,"ف",3,0],["أنْ يَهتَدوا لِمَسارِالنُّورِ سِرتَ بهِ","وكُلُّهُم بِشُعاع ٍ منكَ مُنجَذِبُ..!",22,"ب",1,0],["أن يهجروا القيام مثل هجر","دهرا طويلا كان كل من ذكر",23,"ر",1,0],["انيَّ هويت من العلى وثويت في","جدثٍ ولست سوى الرقي تروم",24,"م",1,0],["إني هويت من الملاح رشيقة","زادت محاسنها المعارفُ والأدب",25,"ب",1,1],["إن يُهدِهِ الأُوَلُ العذارى رغبةً","فيه فقد أهديته الأبطالا",26,"ل",2,0],["آنية مِن الحَديد الصيني","قالَت إِلى آنية مِن طين",27,"ن",1,1],["إني هجرت الغانيات جميعاً","ونزعت عن كلفي بهن نزوعاً",28,"ع",2,1],["إِنّي هَززت الآن منك مهنّداً","لا ينثني دونَ المرامِ مضاؤهُ",29,"ا",3,0],["آنيه في ظلم الملاح","مجانباً طرق الصلاح",30,"ح",1,0],["إِنْ يَهُنْ وَهْناً فَفِيهِ","حِيلَتا سُكْنَى وَقُوتِ",31,"ت",1,0],["إني هممت بأن أقول قصيدة","بكراً فأعياني وجود المطلع",32,"ع",1,0],["إِنّي هَزِئَتٌّ مِن أُمِّ الغَمرِ إِذ هَزِئَت","بِشَيبِ رَأسي وَما بِالشَيبِ مِن عارِ",33,"ر",1,1],["إن يَهِمْ نحوكَ القريضُ فقد نَفَّقْتَ","منه ولاتَ حينَ نَفَاق",34,"ق",1,0],["إن يهنه أني أضعت لحبه","قلبي وذاعت عنده اسراره",35,"ر",2,0],["أني هم والخيل ينثر وقعها","نقعاً تظن به السما كديدا",36,"د",2,0],["إني هَلَكتُ وأنتَ عني مُعرْض","وَتركتَ حسن تفقدي وتعهدي",37,"د",2,0],["إن يهو من أفق الخلافة نير","يهدي السبيل فقد تلاه نير",38,"ر",1,0],["ان يهد لبنان لبرنابا الوسام","وصدر برنابا له مستودع",39,"ع",1,0],["أن يهدموا بيتا فتلك سجيّةٌ","لهمو فقد هدموا الديانة والتُّقى",40,"ا",1,0],["إن يهب النسيم فيها عليلا","هاج فيها سحائباً من غبار",41,"ر",1,0],["أن يهد كبلته أو هاج كبلني","وهكذا نحن في حرب بلا سأم",42,"م",1,0],["أَن يهتَدي لسواء القصد سائرُنا","سيان أَوَّلُنا فيها وآخرُنا",43,"ن",2,0],["إن يهب النسيم فهو عليل","كمنام يلذ للوسنان",44,"ن",1,0],["إني هنا وحذارِ أَن تدني إِلى","صدري فإِنّ بجوفِهِ نيرانا",45,"ن",2,1],["إِن يَهج فَهوَ كالفَنيق إِذا ها","ج من العُقل يخبط العَشواءَ",46,"ا",2,0],["إني هجوتك كرها غير مختار","علما بهجوك قد دنست أشعاري",47,"ر",2,1],["إني هويتكِ والأرزاء تعصف بي","وللنوائبِ حولي هولُ إعصارِ",48,"ر",1,0],["إنّي هممتُ وَلم أَفعَل فعائِلَهُ","فَهَمَّ أَمرُ القَضا بي دون أن ياتي",49,"ت",2,0],["أن يهبَ الرحمنُ لي مَوْتَةً","ببادراتِ السُّمْر وبالنصال",50,"ل",1,0],["إنّي هُنا غَجَريّة مَجْنونَةٌ","كَمْ جَرّحَ العُشّاقَ نَصْلُ جُنوني",51,"ي",1,0],["اني هنا ثالث الأحزان في وطنٍ","تجرع السّمّ من ابنائه فعتا",52,"ت",2,0],["اني هنا عاشق صب وليس معي","إلا جراحي وقلبي وانكسار دمي",53,"م",2,0],["إِني هَرَبتُ إِلَيكِ مُكتَفِيًا","مِنِّي, ومِن آهاتِ مُجتَمَعِي",54,"ع",2,0],["إنّي هنا يا مُنى الأشواقِ في وطنٍ","ثانٍ وكلُّ بلادِ العُربِ أوطانُ",55,"ن",1,0],["إنِّي هنا في رياضِ الحُزْنِ أغْنِيَة","يلهو بها الآه دون الأهلِ والسسكنِ",56,"ن",1,0],["إني هنا وهناك كنتُ ولم تكنْ","شيئا يُصَنفُ أنه ذو شان",57,"ن",1,0],["إني هنا أتوارى خلف نافذة","من حولها سُحبٌ في الأفْقِ تَحْجُبُهُ",58,"ب",2,1],["إن يهجع الوزراء لم ير عزمه","في الملك إلا ناهضا أو منهضا",59,"ض",2,0],["إني هجرتُ الليلَ في صبحِ الجوى","وأنا بليلكِ يا عيوني المُخْلِدِ",60,"د",1,0],["إني هويتُ بعينِ ليلتنا","والنجمُ في عينيكِ مرفوعُ",61,"ع",1,0],["إنْ يهفو يوما لحبيبٍ","أو يصبو لبناءِ علاقهْ",62,"ق",2,0],["اني هويتُ وما في الحبِّ من خطلٍ","إذْ طالما حفّهُ الإسفافُ والخطلُ",63,"ل",1,0],["إني هنا ألفٌ ومن أحزانها","يائي هناكَ بصبرها تحتارُ",64,"ر",1,0],["إني هنا متولّهٌ","نجمٌ يُنيرُ توضّعك",65,"ك",1,0],["إني هممتُ لكي أرى","طعم الأيادي الناصعة",66,"ع",2,0],["إني هنا ..كلّي معك","مخفيّةٌ كي أتبعك",67,"ك",1,1],["إني هنالكَ قد تركتُ محمَّدًا","طفلًا، وجئتُ إلى المدينةِ أهرُمُ",68,"م",1,0],["إني هنا ما زلتُ أحكي قصّتي","وأعلم الأخلاق من سفر الفدا",69,"د",2,0],["أَنْ يَهْدَأَ الرَّوْعُ الذي في خَلْدِهِ","هذي الحَياةُ كَثِيرةٌ أَعْبَاؤُها",70,"ا",3,0],["إِنّي هُنا أَرثي صَداقَتَنا لَكُم","فَلَكَم سَعِدتُ بِكُم فَأَنتُم أَفضَلُ",71,"ل",1,0],["إنِّي هنا من موطنٍ في أرضه","سارَ الهدى .. وأقامَ خيرُ مُعلِمِ",72,"م",1,0],["إنِّي هنا من خيرِ أرضٍ أُوْجِدَتْ","الدينُ فيها .. قبلةُ المتيممِ",72,"م",1,0],["إنِّي هنا من منجمِ الأبطالِ مِنْ","أرضِ الجزيرةِ حيثُ فوجِ الأنجمِ",72,"م",1,0],["إنّي هويتُ الصادقينَ لصدقهمْ","وجعلتهمْ بين الأنامِ سمائيهْ",73,"ي",2,0],["آنِيَّةٌ في ذاتِه اضطرَبَت، فَلَم","يُبصِرْ حقيقَتَهُ بغيرِ تَوَهُّمِ!",74,"م",1,0],["إنّي هويت من الغواني غادةً","في الحسن ما رأتِ العيون مثالَها",75,"ل",3,0],["إني هجرت الجبَّ بعد تولِّهم","وبلغت نجماً واعتليت سفينا",76,"ن",2,1],["أن يهنأ الغرب في دنيا ممتعة","فقد بقيتم بلا دنيا ولا دين",77,"ن",1,0],["انّي هجرت معابدا لا ارتجي","فيها طقوسا للقيام وأصحُفا",78,"ف",2,0],["إنّي هنا فأتِمِّي الحُبَّ .. آيَتُهُ","منكِ التَّمامُ ورَبُّ الحُبِّ يَختمُهُ!",79,"م",2,0],["إني هنا العشق الذي لا ينتهي","ويظل أروعَ ما يُشادُ ويُنظم",80,"م",1,0],["إني هنالك لا هنا","متهيبا ومؤبنا",81,"ن",2,0],["إني هنالك لا هنا","حتى يعاودني الفنا",81,"ن",2,0]]}