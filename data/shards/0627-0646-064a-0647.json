{"poems":[[54,"أبا نصير تحلحل عن مجالسنا","https://www.aldiwan.net/poem27538.html","البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"يا أيها الملك السعيد المعرس","https://www.aldiwan.net/poem64580.html","الكامل"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"شر البلية أن يكون زعيما","https://www.aldiwan.net/poem7255.html","الكامل"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[28,"يا ليت شعري هل أسيب ضمرا","https://www.aldiwan.net/poem5133.html","الكامل"],[61,"إني هديت لنعمة مكنونة","https://www.aldiwan.net/poem51755.html","الكامل"],[48,"الجسم مني سقيم شفه النصب","https://www.aldiwan.net/poem10808.html","البسيط"],[48,"أيا سعيد ابن وهب","https://www.aldiwan.net/poem65051.html","المجتث"],[46,"العدل صعب وكلما عدل ال","https://www.aldiwan.net/poem23185.html","المنسرح"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141958","الكامل"],[68,"صدُّ حمى ظمئي لماكَ لماذا","https://www.poetsgate.com/ViewPoem.aspx?id=3093",""],[90,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[193,"إن يهدم الصد من جسمي معالفه","https://www.aldiwan.net/poem27468.html","البسيط"],[212,"عن الوطن الغالي أهاجر مرغما","https://www.aldiwan.net/poem46627.html","الطويل"],[250,"أنية الغداة أم انتقال","https://www.aldiwan.net/poem2099.html","الوافر"],[281,"يا حسنه قمرا وأنت سماؤه","https://www.aldiwan.net/poem60576.html","الكامل"],[410,"من مبلغ عني فلان","https://www.aldiwan.net/poem31953.html","مجزوء الكامل"],[440,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[466,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِنّي هَزَزتُكَ لا آلوكَ مُجتَهِداً","لَو كُنتَ سَيفاً وَلَكِنّي هَزَزتُ عَصا",0,"ص",2,0],["أنَّى هجوتَ بني ثوابَهْ","يا صاحبَ العينِ المُصابَهْ",1,"ب",2,1],["إن يُهدِ مُنفِسة إليك وليُّها","فلقد أتيح لها الكفِيّ المنْفِسُ",2,"س",1,0],["إني هتفت بكل يوم بسالة","للترك لم يؤثر من الآساد",3,"د",1,0],["إن يهذروا فلقد تركت قلوبهم","تشكو صوادع جمة وكلوما",4,"م",2,0],["إِنّي هَجَرتُكَ إِذ هَجَرتُكَ وَحشَةً","لا العَودُ يُذهِبُها وَلا الإِبداءُ",5,"ا",2,0],["إِنّي هَتَفتُ بِخالِدٍ وَلَقَد دَنَت","نَفسي لِثُغرَةِ نَحرِها لِحِظارِ",6,"ر",1,0],["إني هُديتُ لنعمةٍ مكنونةٍ","فأثَرتُها من تُربةٍ وصَفاةِ",7,"ه",1,1],["إِنّي هَويتُ حَبيباً لَستُ أَذكُرُهُ","إِلّا تَبادَرَ ماءُ العَينِ يَنسَكِبُ",8,"ب",1,0],["إِنّي هَويتُ غَزالاً","مُساعِداً لي بِسولي",9,"ل",2,0],["إِن يُهلِكِ التابِعُ التَبيعَ فَقَد","يَمقُلُهُ في الغِنى إِذا مَقَلَه",10,"ل",2,0],["أنّى هجَرتَ لِهجْرِ واشٍ بي كمَنْ","في لَوْمِهِ لُؤْمٌ حكَاهُ فهاذَا",11,"ذ",2,0],["إني هززتك في البلاء فلم أجد","عزماً يفل ولا إباء يغضب",12,"ب",1,0],["أنّى هجَرتَ لِهُجْرِ واشٍ بي، كَمَن","في لَومِهِ لُؤمٌ حَكَاهُ، فَهاذَى",13,"ذ",2,0],["إنْ يهمزوك بإرجافٍ فقد بُليتْ","كلُّ الشعوبِ بهمّازٍ ومشّاء",14,"ا",2,0],["أني هززتُكَ بالقوافي قاصداً","بكَ خدمةَ التاريخِ والآداب",15,"ب",1,0],["إِن يَهدُمَ الصَدُّ مِن جِسمي مَعالِفَه","فَإِنَّ قَلبي بَقَت الوَجدِ مَعمور",16,"ر",1,1],["إني هجرت الدار","دار الجوى والنار",17,"ر",1,0],["أَنِيَّةُ الغَداةِ أَمِ اِنتِقالُ","لِمُنصَرِفِ الظَعائِنِ أَم دَلالُ",18,"ل",1,1],["إِنِّي هَجَرْتُ الْعالَمِينَ إِلى الَّذِي","هَجَرَ الْغَبِيَّ إِلى الأَبِيِّ صَفاؤُهُ",19,"ا",3,0],["أنّي هجرتُك لا كظنْ","نِكَ طائعاً لكنْ برَغمِي",20,"م",2,0],["إِنْ يَهَبُوا يُجْزِلُوا أَوْ يقطعُوا يَصِلُوا","أَوْ يعقِدُوا عَقْدَ مَحْرُومِ الوفاءِ يَفُوا",21,"ف",3,0],["أنْ يَهتَدوا لِمَسارِالنُّورِ سِرتَ بهِ","وكُلُّهُم بِشُعاع ٍ منكَ مُنجَذِبُ..!",22,"ب",1,0],["أن يهجروا القيام مثل هجر","دهرا طويلا كان كل من ذكر",23,"ر",1,0]]}