","https://www.poetsgate.com/ViewPoem.aspx?id=169630",""],[5183,"بَْينَ الْشَّهْدِ وَالْشَّهَادَة","https://www.poetsgate.com/ViewPoem.aspx?id=186463",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5183,"لن تراني","https://www.poetsgate.com/ViewPoem.aspx?id=180161",""],[5189,"لا تقل قولاً قبيحًا","https://www.poetsgate.com/ViewPoem.aspx?id=197543",""],[5227,"لما رَأَيْت الزَّمَان نكساً","https://www.poetsgate.com/ViewPoem.aspx?id=187508",""],[5277,"بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200588",""],[5302,"في فؤادي ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=201267",""],[1021,"كم شب في القلب نارا","https://www.poetsgate.com/ViewPoem.aspx?id=47802",""],[5353,"مخاض من الغيظ","https://www.poetsgate.com/ViewPoem.aspx?id=214898",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5486,"امرأة من حجر","https://www.poetsgate.com/ViewPoem.aspx?id=211189",""],[5497,"علل النفس بما يسعدها","https://www.poetsgate.com/ViewPoem.aspx?id=206747",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5639,"لما رأيت الزمان نكسا","https://www.poetsgate.com/ViewPoem.aspx?id=89885",""],[5691,"تناقضات","https://www.poetsgate.com/ViewPoem.aspx?id=206156",""],[5720,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=199926",""],[5725,"الى نينوى","https://www.poetsgate.com/ViewPoem.aspx?id=203639",""],[5790,"قد رأيناك والغزالة تسنح","https://www.poetsgate.com/ViewPoem.aspx?id=111949",""],[5829,"يا هدأة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=151390",""],[5829,"نفحات السحر","https://www.poetsgate.com/ViewPoem.aspx?id=152736",""],[5846,"نداءُ شاعرة..","https://www.poetsgate.com/ViewPoem.aspx?id=123432",""],[5953,"قال لي في المنام أبو شفيق","https://www.poetsgate.com/ViewPoem.aspx?id=93866",""],[6023,"يا صاحب الإنشاء ما","https://www.poetsgate.com/ViewPoem.aspx?id=123879",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[4442,"أرني في العلا نجوم سمائك","https://www.poetsgate.com/ViewPoem.aspx?id=170993",""],[6102,"رِديني","https://www.poetsgate.com/ViewPoem.aspx?id=182763",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[5075,"سأظلُ أملأ بالهنَا أقدَاحِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82755&r=&rc=1",""],[6260,"أنشودة التحرير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68349&r=&rc=41",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""]],"verses":[["وَاِجتاحَ ذاكَ البَحرَ يَطفَحُ مَوجُهُ","وَطَوى غَوارِبَ ذَلِكَ التَيّارِ",0,"ر",1,0],["واجْتَنِبِ الشّكَّ إذا جِئْتَهُ","جنَّبَكَ الرّحْمانُ ما تَكْرَهْ",1,"ه",1,0],["وَاِجتالَ يَومَ الحَربِ قُد","ماً وَاِحتَبى يَومَ الحِباءِ",2,"ا",2,0],["وَأَجْتَلِي قَلْبَهَا مَا بَيْنَ أَنْجُمِهِ","يَهْتَزُّ تِيهاً وَ سَعْدٌ فِيهِ مُرْتَسِمُ",3,"م",1,0],["وَاجْتَازَ فِي الأدَبِ الكَبِيرِ","مَدَى المُجِيدِينَ الفُحُولِ",4,"ل",1,0],["واجتنب قَسرها على ما أبَتْه","أن قسر الطباع أكبر ظلم",5,"م",1,0],["وأجتلي كأسها والشمس ما جُليت","ولا ترشف منها الشرق في جام",6,"م",1,0],["واجْتل البكر من ثنائيَ لا تحتا","ج من واصفٍ إلى تزيين",7,"ن",1,0],["واجْتَثَثْتَ الذَكَاءَ وال","خير من خيرِ مَنْبتِ",8,"ت",1,0],["واجْتَلَيْنا على الندى والتَّدَانِي","بِكْر دنٍّ برأْسِهَا الشَّيْبُ لاحا",9,"ح",2,0],["واجتَثَّهُ الخالق من خلْقِه","فإنه في خلقه زائدَهْ",10,"د",2,0],["واجتماعاتهن في كل قيد","وافتراقاتهن عن كل قِيس",11,"س",1,0],["واجتماعُ الرّفدينَ فهْو محالٌ","عند قومٍ ولن تراهُ محالا",12,"ل",2,0],["واجتبى الناس إلا أنه رجل","لا يعرفُ الخاء بين الباء واللامِ",13,"م",1,0],["وَاِجتاحَ مُجتاحُ العُروشِ مُلوكَها","فَكَأَنَّهُم أَعجازُ نَخلٍ خاوِيَه",14,"ي",2,0],["وَاِجتازَ لِلعُدوَةِ القُصوى وَقَد لَحِقَت","غُضفٌ تَكَشَّفُ عَنها بُلجَةُ السَحَرِ",15,"ر",1,0],["وَإِجتِهادٌ مِنَ الوَدُوِّ وَدَهري","طالِبٌ في السِلاحِ أَو مَطلوبُ",16,"ب",1,0],["وَاِجتِماعُ الأَضدادِ فيما تُوالي","مِن أَيادٍ فينا ثِقالٍ خِفافِ",17,"ف",1,0],["وأَجتَني مُستَطيباً ما حَواهُ فمٌ","مِن ماءِ ظَلْمٍ بَرُودٍ يُطفِئُ الحَرَقا",18,"ق",2,0],["واجتلائي منَ الشموشِ عروساً","نَقّطَتْ خَدّها بزُهْرِ الدراري",19,"ر",2,0],["وَاجْتَنِبْ مَنْ لا تُشَاكِلُهُ","تَنْجُ مِنْ غَدْرٍ وَمِنْ غَبَنِ",20,"ن",1,0],["وَاِجتِنابي بَيتَ الحَبيبِ وَما الخُل","دُ بِأَشهى إِلَيَّ مِن أَن أَراهُ",21,"ا",2,0],["وَاِجتَنِبني وَاِعلَم بِأَن سَوفَ تُعصى","وَلَخَيرٌ لَكَ بَعضُ اِجتِنابي",22,"ب",2,0],["واجتماعٌ منكم يَرُدُّ علينا","غابرَ المجدِ من فتوح أُميَّهْ",23,"ي",2,0],["وأجتلي أشباحَ عهدِ الصَّفا","راقصةً فتَّانةً ساحرهْ",24,"ه",1,0],["وَاِجتَبنَ حاصِبَهُ وَوَلّى يَقتَري","فَيحانَ يُسجِحُ مَرَّةً وَيُعَرِّدُ",25,"د",1,0],["وَاِجتَمَعنا بَعدَ التَنائي وَلَكِن","لا يُري العالَمينَ عَينَ الرَخاءِ",26,"ا",2,0],["وَأَجتَني الطيبَ مِن أَطايِبِها","وَأُمكِنُ النَفسَ مِن أَمانيها",27,"ي",3,0],["واجتمعتْ إِليه أَخلاطُ الكُوَرْ","وغابَ ذو التَّحصيلِ عنهُ والنَّظرْ",28,"ر",1,0],["واجتماعِ الشّملِ في جَمعٍ وما","مَرّ في مَرٍّ بأفياء الأُشَي",29,"ي",1,0],["واِجتنب الناس فان","نَ أَكثر الناس عدى",30,"د",2,0],["وأجتلي لَمَحَاتِ العبقرِيّةِ في","عينينِ حَدَّثتا عن رُوحِ فنَّانِ",31,"ن",1,0],["واجتزتَ جِسْرَ العمر بين عواصف","هُوجٍ وموجٍ مُزْبدٍ مترامي",32,"م",2,0],["واجتمعت حول الهدى لواءَ","يحارب الضلال والأهواءَ",33,"ا",2,0],["وَاجْتَنِبْ كُلَّ غَبِيِّ مَائِقٍ","فَهْوَ كَالْعَيْرِ إِذَا جَدَّ قَمَصْ",34,"ص",1,0],["واجتَلِها عَذراءَ لم تأْتِ بها","غادَةُ نَهَّابٍ تَعَدَّى وظَلَمْ",35,"م",1,0],["واجتاز بحر الرُّوم في","قرن وجاب القُلزُما",36,"م",2,0],["وأجترّ ميلاد تاريخنا","وأنتشق المهد والمولدا",37,"د",2,0],["واجتلاب المخططين صنوفا","كي تضيع البلاد في كل قارة",38,"ر",2,0],["واجتلينا شعرَ الطبيعة في شعرك","تَفْتَّر عن ثُغورٍ بواسِم",39,"م",1,0],["واجتَزتُ رغمَ الليالي بابَ ساحرةٍ","مرَّ الشبابُ عليه وهو مسدود",40,"د",1,0],["واجتاحَ صادقَ مُلكهِمْ لما طَغوا","بدعيِّ مُلكٍ كاذبٍ مَنحوله",41,"ل",2,0],["واجتهاد من العدو ودهري","طالب في السلاح أو مطلوب",42,"ب",1,0],["واجتلائي من الشموس عروساً","نَقّطَتْ خَدّها بزُهْرِ الدراري",43,"ر",2,0],["وأجتني مستطيباً ما حواهُ فمٌ","من ماء ظَلْمٍ بَرُودٍ يُطفىء الحرقا",44,"ق",2,0],["واجتماع القوم الأكارم في الغا","ر وتفريق جمعة الأسرار",45,"ر",1,0],["وأجتلي نفسه في الماء حف به","على الجوانب ريحانٌ وحوذان",46,"ن",1,0],["واجترامى لا يُضاهَى باجترامِ","عفوك الله يا ربَّ الأنام",47,"م",1,0],["واجتَنِ الأثمارَ مهما أمكنتْ","فرصة منهم ودعْ عنك الفشلْ",48,"ل",1,0],["واجتنابَ الضلال والطرقاتِ ال","مُحدثاتِ المُغَيَّرَاتِ اجتنابَا",49,"ب",2,0],["واجتهدوا في فك أوصالهم","وما خلا مجتهد من نصيب",50,"ب",1,0],["وَاِجتابَ مِن خِلَعِ الخِلافَةِ كُلَّ ما","تُقذي سَناهُ نَواظِرَ النُظَراءِ",51,"ا",2,0],["واجتمع الناسُ في صعيدٍ","والنَّهيُ نهي والأمر أمر",52,"ر",1,0],["وأجتلبُ الشجونَ وأينَ صَبري","وأَحتلبُ الشؤونَ وكيفَ حالي",53,"ل",2,0],["وَأَجتابُ مِن ظِلِّ الخِلافَةِ وارِفاً","يَقي الضُرَّ فَيناناً وَحَرَّ السَمائِمِ",54,"م",1,0],["وَأَجْتَلِي الْخَمْر فِي غِلائِلِها","حَتَّى يُفْرِّي غِلاَلَةَ الفَجْرِ",55,"ر",1,0],["وَاِجتَمعنا بِسرورٍ وهنا","عندَ جمعٍ وعرَفنا عرَفات",56,"ت",1,0],["وَاِجتاحَ سائرَ غيّهم في فتحهِ","أمَّ القُرى قهراً بعنوةِ صلحهِ",57,"ه",1,0],["وَاِجتِنابٌ لِما يُعابُ مِنَ الأَم","رِ وَعَرضٌ مِنَ الدَناءِ صَقيلُ",58,"ل",1,0],["واجتوى الذل كيف لا وهو حرّ","أيطيق الأحرار عيش الهوان",59,"ن",1,0],["وَاجتَلَيناهُ طَودَ مجدٍ وَسوراً","دارَ منهُ حولَ البِلادِ بِناءُ",60,"ا",2,0],["وَاِجتِماعٍ سَمَحَ الوَص","لُ بِهِ مِنكَ وَخَلوَه",61,"و",2,0],["وَأَجتَنِبُ الذَبائِحَ لا بِحُكمِ ال","ضَرورَةِ بَل بِحُكمِ الإِلتِزامِ",62,"م",1,0],["وَأَجتَني وَردَ خَدٍّ","يَعودُ بِالقَطفِ غَضّا",63,"ض",2,0],["وَاِجتَلِّها قَبلَ اِنجِلا","ءِ غُرَّةِ الصَباحِ",64,"ح",1,0],["وَاجْتَنِ الْعِلْمَ مِنْ حَدَائِقِ دَرْسٍ","وَلْتُنَافِسْ أَسْنَى الذِينَ اجْتَنَوْهُ",65,"و",2,0],["وَاجْتَبِ المُجْتَبىَ لَدَى الشَّرْعِ وَاعْلَمْ","إِنَّمَا يَجْتَبِى الذِينَ اجْتَبَوْهُ",65,"و",2,0],["وَاجْتَنِبْ خَلْقَ كُلِّ مَا لَيْسَ تَفْرِي","فَالرِّجَالُ مَا يَخْلُقُونَ فَرَوْهُ",65,"و",2,0],["وَاجْتَوِ الْبَغْيَ وَانْتَبِذْ مِنْ ذَوِيهِ","مَا أَجَلَّ قَدْرَ الذِينَ اجْتَوَوْهُ",65,"و",2,0],["واِجتَمِعوا في الحركَه","واِرتفَعوا بالش