{"poems":[[55,"أظن الليالي بعدكم ستريع","https://www.aldiwan.net/poem30150.html","الطويل"],[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[57,"ألا ليت ذات الخال تلقى من الهوى","https://www.aldiwan.net/poem26540.html","الطويل"],[88,"رحم الله صاحب النظرات","https://www.aldiwan.net/poem10351.html","الخفيف"],[32,"ألا يا دار مية بالوحيد","https://www.aldiwan.net/poem29597.html","الوافر"],[53,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[93,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[87,"قف حي شبان الحمى","https://www.aldiwan.net/poem8085.html","مجزوء الكامل"],[30,"طرقت أمية في المنام تزورنا","https://www.aldiwan.net/poem5168.html","الكامل"],[89,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[119,"سكنتم سويد القلب في برزخ الصدر","https://www.aldiwan.net/poem41661.html","الطويل"],[208,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[422,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[592,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66663","الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53950","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63754","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77490","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62559","المجتث"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111167","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21662","المديد"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116551","الخفيف"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101734","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60819","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202763","الطويل"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138925",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132793","المتدارك"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140159",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86249","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206167","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107498","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111198","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"],[585,"يا صاحب التاج عن حقٍّ وإرث أب","https://www.poetsgate.com/ViewPoem.aspx?id=161895",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5232,"لغزُ العيون","https://www.poetsgate.com/ViewPoem.aspx?id=213023",""],[5237,"رويدكم فما سمعي بقابل","https://www.poetsgate.com/ViewPoem.aspx?id=113117",""],[5431,"كربُ الشام","https://www.poetsgate.com/ViewPoem.aspx?id=183134",""],[5431,"وماالنصر إلا من قلوبٍ جسورة","https://www.poetsgate.com/ViewPoem.aspx?id=187798",""],[5447,"ناثر متناثر","https://www.poetsgate.com/ViewPoem.aspx?id=208302",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5809,"رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=205283",""],[5829,"انت والسحاب وما تعداني","https://www.poetsgate.com/ViewPoem.aspx?id=189840",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[6152,"باقية بقلبي للأبد","https://www.poetsgate.com/ViewPoem.aspx?id=204658",""]],"verses":[["فَهَجراً لِدارِ الحَيِّ بَعدَ رَحيلِكُم","وَما كُلُّ أَظعانٍ لَهُنَّ رُجوعُ",0,"ع",1,0],["فهَجْوُهُ صِدْقٌ وفي مَدْحِهِ","تَكْبو بمُطْريهِ الأكاذيبُ",1,"ب",1,0],["فَهَجري لَكُم عَتبٌ وَوَصلي لَكُم أَذىً","فَلا هَجرُكُم هَجرٌ وَلا حُبُّكُم حُبُّ",2,"ب",1,0],["فَهَجَرتَ الشِعرَ السَرِيَّ إِلى النَث","رِ فَجِئتَ الكُتّابَ بِالمُعجِزاتِ",3,"ت",1,0],["فَهِجتِ صَبابَتي وَلِكُلِّ إِلفٍ","تَهيجُ الشَوقَ مَعرِفَةُ العُهودِ",4,"د",1,0],["فهجَوْكم بأنكم منذ قُمتم","أُثِّلَ الملك واقتنَى السُّبْروتُ",5,"ت",1,0],["فَهَجَرتُ العُمرانَ تَنفُضُ كَفّي","عَن رِدائي غُبارَهُ وَإِهابي",6,"ب",2,0],["فَهَجَرتُمو الوَطَنَ العَزي","زَ إِلى البِلادِ القاصِيَه",7,"ي",2,0],["فَهَجَعتُ أَرجو أَن تَعودَ لِمِثلِها","سَلمى وَمِثلُ طِلابِ ذاكَ عَسيرُ",8,"ر",1,0],["فَهِجْنَ جَمِيعاً هَيْجَةً فُزِّعَتْ لَهَا","كِلابُ الْقُرَى مَا بَيْنَ سَهْلٍ وَأَجْبَالِ",9,"ل",1,0],["فهجته حرى ومن ظرف دارها","رمت شرراً يحكي عن الحال القصر",10,"ر",1,0],["فهجرناكمُ وسبحان مَن يَع","لَمُ ما تحت ذلك الهجرانِ",11,"ن",1,0],["فهجرتُه هجرَ الخليلِ خَليلَه","من بعد ما قد حَلَّني وجَفاني",12,"ن",2,0],["فهجران من أصفى المودة لم تشب","بشائبة يوماً حنانيكمو ظلما",13,"م",2,0],["فهجوناهُ ومن نهجو","يُصَبْ بالزًَّفراتِ",14,"ت",1,0],["فهَجْرُهُمْ واجبٌ عَلَيَّ مفترضُ","والحقَّ إن يَلتَقُوا يَلْقَوْا بإعراضِ",15,"ض",1,0],["فهجرُ يومٍ منكَ أو ساعةٍ","مُقَلِّبٌ قلبي على الجمر",16,"ر",1,0],["فَهجم الصَقر عَلَيها في الشرك","فَضَمّه بِجنبها وَما اِحتَرَك",17,"ك",1,0],["فهجرهم طال هلاَّ","حدُّوا على الهجر حدا",18,"د",2,0],["فهجره لا يكاد ينسى","ووصله لا يكاد يذكر",19,"ر",1,0],["فَهَجَمنا المَوتَ فَوقَهُمُ","بِالطَواغِي ظاهِرَ الأَكَمَة",20,"م",2,0],["فهجرنا القنا وَزُرنا القناني","واشتغلنا عن الظُّبا بالظِّباءِ",21,"ا",2,1],["فَهَجرُ رَبعي لِذاكَ الرَّبعِ مُغتَنَمي","وَنَثرُ جَمعي لِذاكَ الجَمعِ مُعتَصَمي",22,"م",2,0],["فَهَجِ الأعمالَ اذا رَكَدَت","فاذا ما هَجَّت إذاً تَهَجِ",23,"ج",1,0],["فهجرنا مرّ المدامة فيه","بحديث مستعذب مضمونه",24,"ن",2,0],["فهُجْنَ له شوقاً حمائمُ هُتّفٍ","كَشفْن دفينَ الوجدِ حتى تكشّفا",25,"ف",2,0],["فهجوي مهما طال عنك مقصرٌ","وفوق الذي قدّرت عنه وقدرت",26,"ت",1,0],["فهجوا منه كل حرف هجاء","ونفوا لفظه عن السنخيه",27,"ي",2,0],["فهجمت بشرك ذي الشرر","فملأت عوالمها شجنا",28,"ن",2,0],["فهجموا غرة ولكن","قد فرّج الله في قريب",29,"ب",1,0],["فَهَجري لَدَيها بِالملال معجل","وَوَصلي لَدَيها بِالدَلالِ مُسَوَّف",30,"ف",1,0],["فهجرًا فهذا القيد قد طال عهده","أليس لقلبي غير حبك مذهب",31,"ب",1,0],["فهجرك الحسد من غمٍّ خلاصْ","ومجلسَ السوء من اللوم ملاصْ",32,"ص",1,0],["فهجاءُ مثلك ليسَ فيهِ تكلفٌ","وأَرى مديحك كلفةً وعناءَ",33,"ا",2,0],["فهجرننا حتى ظننا لم تصل","ووصلننا حتى كأن لم تصرم",34,"م",1,0],["فَهِجنا بِهِ عانَةً في الغُطاطِ","خِماصَ البُطونِ صِحاحَ العُجى",35,"ا",1,0],["فهجت تخلب لبي نغمةٌ حملت","إلي أروع قولٍ فيك منتخب",36,"ب",1,0],["فهجرت حتى قيل ليس بقائل","وبيت حتى قيل ليس بنائم",37,"م",1,0],["فهجرتُ أعشاشَ الطيور ِ","رحلتُ عنْ عرسِ الهنا",38,"ن",2,0],["فهجيراي ذكر الله جهرا","وسرا بالغدو وبالأصائل",39,"ل",1,0],["فهُجّرنا ..وقُطْعَنا..ولكن","لطاغية فلن نرضى امتثالا",40,"ل",2,0],["فهجّر أهلونا من الأرض عنوة","غراب غريب الأصل يسعى لمقسم",41,"م",1,0],["فهجرت نثري وانزويتُ برقعةٍ","في جانب الشعر القصي الداني",42,"ن",2,0],["فَهَجْرُها وَنَواها لِي إِذا بَعُدَتْ","نارٌ وَلِي وَصْلُها رَوْحٌ وَرَيْحانُ",43,"ن",1,0],["فهجرُك بعد الوصلِ قلبٌ وجرحُهُ","ووصلُك بعد الهجر ِجرحٌ وبلسمُ",44,"م",1,0],["فهجر جميل اذا ما افترقنا","وذكرى تقال بما يعسرُ",45,"ر",1,0],["فهِجْ أنت يا بحر وَارْوِ الحنينْ","ولا تُشعِلنِّي مزيدَ اشتعالْ",46,"ل",1,0],["فهجركِ سيدتي مستحيل","ونيسان فضلكِ ظلم مبين",47,"ن",1,0]]}