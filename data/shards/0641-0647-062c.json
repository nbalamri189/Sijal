{"poems":[[53,"أظن الليالي بعدكم ستريع","https://www.aldiwan.net/poem30150.html","الطويل"],[63,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[55,"ألا ليت ذات الخال تلقى من الهوى","https://www.aldiwan.net/poem26540.html","الطويل"],[86,"رحم الله صاحب النظرات","https://www.aldiwan.net/poem10351.html","الخفيف"],[30,"ألا يا دار مية بالوحيد","https://www.aldiwan.net/poem29597.html","الوافر"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[91,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[85,"قف حي شبان الحمى","https://www.aldiwan.net/poem8085.html","مجزوء الكامل"],[28,"طرقت أمية في المنام تزورنا","https://www.aldiwan.net/poem5168.html","الكامل"],[87,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[115,"سكنتم سويد القلب في برزخ الصدر","https://www.aldiwan.net/poem41661.html","الطويل"],[204,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[416,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[587,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"]],"verses":[["فَهَجراً لِدارِ الحَيِّ بَعدَ رَحيلِكُم","وَما كُلُّ أَظعانٍ لَهُنَّ رُجوعُ",0,"ع",1,0],["فهَجْوُهُ صِدْقٌ وفي مَدْحِهِ","تَكْبو بمُطْريهِ الأكاذيبُ",1,"ب",1,0],["فَهَجري لَكُم عَتبٌ وَوَصلي لَكُم أَذىً","فَلا هَجرُكُم هَجرٌ وَلا حُبُّكُم حُبُّ",2,"ب",1,0],["فَهَجَرتَ الشِعرَ السَرِيَّ إِلى النَث","رِ فَجِئتَ الكُتّابَ بِالمُعجِزاتِ",3,"ت",1,0],["فَهِجتِ صَبابَتي وَلِكُلِّ إِلفٍ","تَهيجُ الشَوقَ مَعرِفَةُ العُهودِ",4,"د",1,0],["فهجَوْكم بأنكم منذ قُمتم","أُثِّلَ الملك واقتنَى السُّبْروتُ",5,"ت",1,0],["فَهَجَرتُ العُمرانَ تَنفُضُ كَفّي","عَن رِدائي غُبارَهُ وَإِهابي",6,"ي",1,0],["فَهَجَرتُمو الوَطَنَ العَزي","زَ إِلى البِلادِ القاصِيَه",7,"ي",2,0],["فَهَجَعتُ أَرجو أَن تَعودَ لِمِثلِها","سَلمى وَمِثلُ طِلابِ ذاكَ عَسيرُ",8,"ر",1,0],["فَهِجْنَ جَمِيعاً هَيْجَةً فُزِّعَتْ لَهَا","كِلابُ الْقُرَى مَا بَيْنَ سَهْلٍ وَأَجْبَالِ",9,"ل",1,0],["فهجته حرى ومن ظرف دارها","رمت شرراً يحكي عن الحال القصر",10,"ر",1,0],["فهجرناكمُ وسبحان مَن يَع","لَمُ ما تحت ذلك الهجرانِ",11,"ن",1,0],["فهجرتُه هجرَ الخليلِ خَليلَه","من بعد ما قد حَلَّني وجَفاني",12,"ن",2,0],["فهجران من أصفى المودة لم تشب","بشائبة يوماً حنانيكمو ظلما",13,"م",2,0]]}