{"poems":[[55,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[55,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[75,"عذيري من خليل يستطيل","https://www.aldiwan.net/poem11907.html","الوافر"],[90,"يا ساكناً وهو مشنوق على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=25554",""],[93,"دموع وتنهّدات","https://www.poetsgate.com/ViewPoem.aspx?id=53396",""],[164,"ما لي ارى الغاب عن وجه الهزبر خلا","https://www.aldiwan.net/poem59005.html","البسيط"],[164,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[173,"صبا شوقاً فحن إلى الديار","https://www.aldiwan.net/poem1627.html",""],[302,"لك الخير إن جزت اللوى والمطاليا","https://www.aldiwan.net/poem33081.html","الطويل"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72309","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2518,"","https://poetry.dctabudhabi.ae/diwan/poem/146562","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102502","الوافر"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48060","الكامل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200421","الوافر"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103589","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85089","الكامل"],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""]],"verses":[["وَلو أَجدى البُكاءُ عَلى نَوارٍ","لَأَعيا الدَمعُ عَينَ أَبي فِراسِ",0,"س",1,0],["وَلَو أَجَبتُ الشَوقَ لَمّا دَعا","جاءَكَ بي مِن قَبلِ أَن تَسري",1,"ر",2,0],["وَلَوْ أَجْلَبَتْ لِلْحَرْبِ عَادٌ وَجُرْهُمُ","وَلَبّتْ جَدِيساً إِذْ دَعَتْ أُخْتُهَا طَسْمُ",2,"م",1,0],["وَلَو أَجِدُ السَبيلَ لَطِرتُ وَجداً","وَلَكِن ما إِلى هَذا سَبيلُ",3,"ل",1,0],["ولو اجبت الى ما انت طالبه","لاصبح الشرع يدعو الويل والحربا",4,"ب",2,0],["ولو أجنبي لاتّقينا سهامه","ولكنّما الإخوان صاروا أعاديا",5,"ي",2,0],["ولو أجبنا لقلنا قتل أنفسنا","عليك هين ولكنا نسى عملا",6,"ل",2,0],["ولو أجمعوا أيام أحمد ما بقى","لأعداء دين الله خضراء لم تذوى",7,"و",2,0],["وَلَو أَجرضتُ مِنكَ بِغَيرِ ريقي","لَكانَ بِأَعذَبِ الماءِ اِعتِصاري",8,"ر",2,0],["وَلَو أَجدَت الشَكوى شكوتُ وإنَّما","رأَيتُ صروفَ الدهر لم تشك شاكيا",9,"ي",2,0],["ولو أجريتَه حَولاً صَبورٌ","ولو أوقَرتَه طَوداً قَويّ",10,"ي",1,0],["ولو أجاز نكوصا أو محاجزة","في ساعة الزحف للرعديدة الوكل",11,"ل",1,0],["ولو اجتاز مغضبا ببحار","لغدا غربها عليه اصطلاء",12,"ا",2,0],["ولو اجتاز وقومٌ فرقوا","فإذا العدة ولت قيل عد",13,"د",1,0],["ولو أجاب عن المكتوب محتسباً","لانجاب عني ظلام الريب والتهم",14,"م",1,0],["ولو أجلى الحضور مراة قلبي","لما بالغير لذّ لي اتصالي",15,"ل",2,0],["ولَوِ اجتلى فِي زيِّ قِرْنِكَ مُعلَماً","لتركْتَهُ تَحْتَ العجاجِ مُعفَّرا",16,"ر",2,0],["وَلَوِ اِجتَهَدتَ لِدَفعِ ما يُؤتيكَهُ","آتاكَهُ إِتيانَ مُزجىً مُجبَرِ",17,"ر",1,0],["ولو أجداه نصحي قلت حسبي","بأني إن خسرت فقد نفعت",18,"ت",1,0],["ولوا جميعاً بما في الدهر من حسن","لا عيب في القوم الا انهم بادوا",19,"د",3,0],["ولو اجتلاه لا نزوي","يثني إليه عنانه",20,"ن",2,0],["ولو اجدى التكبر ذات يوم","لألفيت الحياة بلا ارتقاء",21,"ا",2,0]]}