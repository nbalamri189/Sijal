{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[63,"وخيل كالذئاب على مطاها","https://www.aldiwan.net/poem45950.html","الوافر"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[88,"متى نرجو لغمتنا انكسافا","https://www.aldiwan.net/poem44828.html","الوافر"],[88,"تفكرت في كنه الحياة فلم أكن","https://www.aldiwan.net/poem45056.html","الطويل"],[43,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[77,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[45,"تَظُنُّ شُجُونيَ لَمْ تَعْتَلِجْ","https://www.poetsgate.com/ViewPoem.aspx?id=33100",""],[180,"تنبهوا واستفيقوا أيها العرب","https://www.aldiwan.net/poem67087.html","البسيط"],[208,"إن يكن الخنجر ريحانكم","https://www.aldiwan.net/poem13549.html","السريع"],[235,"يا من ألح علي في الإنشاد","https://www.aldiwan.net/poem18166.html","الكامل"],[273,"ونت من دون غايتك العقول","https://www.aldiwan.net/poem25542.html","الوافر"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[565,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"]],"verses":[["وَنُتبِعُ بِالدُموعِ وَأَيُّ دَمعٍ","يُجيرُ وَلَو أَقامَ عَلى السُجومِ",0,"م",1,0],["وَنَتْرُكُ في النَّجيعِ الوِرْدَ صَرعَى","كَشَرْبِ الخَمْرِ غَالَهُمُ الكُؤوسُ",1,"س",1,0],["وَنَتِيجَةٌ قَدَّمْتُ عِنْدَ قِيَاسِهَا","مَا يُوجِبُ الإِحْسَانَ لاَ مَا يَسْلُبُ",2,"ب",1,0],["ونتّهم الحكومة باعتسافٍ","ونحن أشدّ ظلماً واعتسافا",3,"ف",2,0],["ونتدب في ملحوده المجد والعلا","ونسقيه غيث الدمع من كل محجر",4,"ر",1,0],["وَنَترُكُ الماءَ لا يَنفَكُّ مِن سَفَرٍ","ما سارَ في الغَيمِ مِنهُ سارَ في الأَدَمِ",5,"م",1,0],["وَنتفت الأهداب منها وحلَّقت","حواجبَ زجاً راق منهن منظر",6,"ر",1,0],["ونتاجٍ من نُهىً جبَّارةٍ","وتراثٍ من حَضاراتٍ ضخامِ",7,"م",1,0],["وَنَتَائِجِ العَزْمِ الصَّحِيحِ","تَرُوضُهُ الفِكَرُ الشَّدِيدَهْ",8,"د",2,0],["ونَتِجَة ٌ قَدَّمْتُ عند قِياسها","ما يوجب الإحسانَ لا ما يَسْلُبُ",9,"ب",1,0],["ون...ت عجوزك حتى ترد","في رحمها داخلاً ما خرج",10,"ج",1,0],["وَنَترُكَنَّ عُلوجَ التُّركِ تَندُبُ ما","قَد قَدَّمَتهُ أَياديها وَتَنتَحبُ",11,"ب",1,0],["ونترك الاعداء سكرى الدما","تميل لا سكرى من الكاس",12,"س",1,0],["ونُتِجْتِ بدْرَ مَحَاسِنٍ أَضْوَاؤُهُ","مُزْرِيَةٌ بِالْكَوْكَبِ الْوَقَّادِ",13,"د",1,0],["وَنَتْ مِنْ دون غَايَتِكَ العُقولُ","وعَيَّ بِفِعْلِ راحَتِكَ المَقولُ",14,"ل",1,1],["وَنَتيجةُ الآمالِ إِفراغُ القوى","لِصنائعٍ ومهائنٍ تستبدعُ",15,"ع",1,0],["وَنِتَاجُ مَعْنَاهُ يُتَمِّمُهُ","وَنِتَاجُ مَعْنَى غَيْرَهُ سِقْطُ",16,"ط",1,0]]}