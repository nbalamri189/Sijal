{"poems":[[55,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[65,"وخيل كالذئاب على مطاها","https://www.aldiwan.net/poem45950.html","الوافر"],[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[90,"متى نرجو لغمتنا انكسافا","https://www.aldiwan.net/poem44828.html","الوافر"],[90,"تفكرت في كنه الحياة فلم أكن","https://www.aldiwan.net/poem45056.html","الطويل"],[45,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[79,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[47,"تَظُنُّ شُجُونيَ لَمْ تَعْتَلِجْ","https://www.poetsgate.com/ViewPoem.aspx?id=33100",""],[186,"تنبهوا واستفيقوا أيها العرب","https://www.aldiwan.net/poem67087.html","البسيط"],[214,"إن يكن الخنجر ريحانكم","https://www.aldiwan.net/poem13549.html","السريع"],[242,"يا من ألح علي في الإنشاد","https://www.aldiwan.net/poem18166.html","الكامل"],[280,"ونت من دون غايتك العقول","https://www.aldiwan.net/poem25542.html","الوافر"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[572,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216442",""],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216440",""],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16795","الهزج"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216678",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56634","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93091","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49965","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21669","الطويل"],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216298",""],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216297",""],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216296",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48937","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108855","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49604","الوافر"],[514,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69392","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53190","المتقارب"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216450",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216549",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139977","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108121","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110023","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91130","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91110","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94537","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58044","الطويل"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107133","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104903","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139759",""],[4767,"فداك الكون","https://www.poetsgate.com/ViewPoem.aspx?id=178772",""],[4796,"صباحي","https://www.poetsgate.com/ViewPoem.aspx?id=180991",""],[5032,"رسالة إلى من يهمه الامر","https://www.poetsgate.com/ViewPoem.aspx?id=190484",""],[5163,"عراق","https://www.poetsgate.com/ViewPoem.aspx?id=34064",""],[592,"أهاجك أزماة تسامى بها الخلف","https://www.poetsgate.com/ViewPoem.aspx?id=128857",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5409,"حياةُ الربيع وعصر الباب","https://www.poetsgate.com/ViewPoem.aspx?id=155499",""],[5499,"ماعندي الا حلالك","https://www.poetsgate.com/ViewPoem.aspx?id=177666",""],[5616,"أغرِّد بالقصيدة كلَّ يومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205220",""],[5720,"الْهِنْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=205305",""],[5747,"الجرح العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=61671",""],[6142,"قالوا تحب أبا بكر فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=155739",""],[242,"يا من الح علي في الإنشاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563733",""],[6213,"نداء العجوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76265&r=&rc=22",""],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""]],"verses":[["وَنُتبِعُ بِالدُموعِ وَأَيُّ دَمعٍ","يُجيرُ وَلَو أَقامَ عَلى السُجومِ",0,"م",1,0],["وَنَتْرُكُ في النَّجيعِ الوِرْدَ صَرعَى","كَشَرْبِ الخَمْرِ غَالَهُمُ الكُؤوسُ",1,"س",1,0],["وَنَتِيجَةٌ قَدَّمْتُ عِنْدَ قِيَاسِهَا","مَا يُوجِبُ الإِحْسَانَ لاَ مَا يَسْلُبُ",2,"ب",1,0],["ونتّهم الحكومة باعتسافٍ","ونحن أشدّ ظلماً واعتسافا",3,"ف",2,0],["ونتدب في ملحوده المجد والعلا","ونسقيه غيث الدمع من كل محجر",4,"ر",1,0],["وَنَترُكُ الماءَ لا يَنفَكُّ مِن سَفَرٍ","ما سارَ في الغَيمِ مِنهُ سارَ في الأَدَمِ",5,"م",1,0],["وَنتفت الأهداب منها وحلَّقت","حواجبَ زجاً راق منهن منظر",6,"ر",1,0],["ونتاجٍ من نُهىً جبَّارةٍ","وتراثٍ من حَضاراتٍ ضخامِ",7,"م",1,0],["وَنَتَائِجِ العَزْمِ الصَّحِيحِ","تَرُوضُهُ الفِكَرُ الشَّدِيدَهْ",8,"د",2,0],["ونَتِجَة ٌ قَدَّمْتُ عند قِياسها","ما يوجب الإحسانَ لا ما يَسْلُبُ",9,"ب",1,0],["ون...ت عجوزك حتى ترد","في رحمها داخلاً ما خرج",10,"ج",1,0],["وَنَترُكَنَّ عُلوجَ التُّركِ تَندُبُ ما","قَد قَدَّمَتهُ أَياديها وَتَنتَحبُ",11,"ب",1,0],["ونترك الاعداء سكرى الدما","تميل لا سكرى من الكاس",12,"س",1,0],["ونُتِجْتِ بدْرَ مَحَاسِنٍ أَضْوَاؤُهُ","مُزْرِيَةٌ بِالْكَوْكَبِ الْوَقَّادِ",13,"د",1,0],["وَنَتْ مِنْ دون غَايَتِكَ العُقولُ","وعَيَّ بِفِعْلِ راحَتِكَ المَقولُ",14,"ل",1,1],["وَنَتيجةُ الآمالِ إِفراغُ القوى","لِصنائعٍ ومهائنٍ تستبدعُ",15,"ع",1,0],["وَنِتَاجُ مَعْنَاهُ يُتَمِّمُهُ","وَنِتَاجُ مَعْنَى غَيْرَهُ سِقْطُ",16,"ط",1,0],["ونترك ذى الديار كما أتينا","عراة حين تدركنا المنايا",17,"ا",3,0],["وَنّتي وَنّات مكسورهْ","أمْرحَتْ ما تلحق المالي",18,"ل",2,1],["ونّتي ونّات مِن ماله","طبَّعه في غِبّةٍ زَرقا",19,"ق",2,0],["ونتّجت من هون النساء عليهم","تحمل جور الساسة الغرباء",20,"ا",2,0],["وَنَتلو ذِكرَ مَن نَهوى","عَلى نَردٍ وَشُطرَنجِ",21,"ج",1,0],["وَنَتَقَ الهَيْفُ السَفا فَاسْتَنْتَقا","مالاثَ مِن ناصِلِهِ وَحَزَقا",22,"ق",2,0],["ونتِكَلَّف ونْتِعَذَّب.. ونتِجَلَّد","وانْته بْوادٍ عن حْروف النشيده",23,"د",2,0],["ونْتِوَسّل ونْتِرَجّى ونْتِوَدّد","للذي مالك زمام القلب بيده",23,"د",2,0],["ونتبعك الثناء بكل أرض","يقوم إذا نزلت بها خطيباً",24,"ب",2,0],["وَنَتَفوا ريشي وَألقوني وَقَد","لَقيت ما لَم يَلقه قَبلي أحَد",25,"د",1,0],["وَنَتف الطاووس حَتّى سَمطه","مَحَبةً لِريشِهِ وَخرطه",26,"ه",1,0],["ونتحتمل الأذى من كل رجسٍ","ويحكم في أبي الشبال كلب",27,"ب",1,0],["ونتجع الوفَّادُ أَنواءَ الوفاد أنواءَ كفّه","إذا أختلفتها البارقات الرّواعدُ",28,"د",1,0],["وَنُتبِعُ أَخراها كَتائِبَ مُصدِقٍ","تَزيفُ بِأُولاها حُماةُ البَوازِمِ",29,"م",1,0],["ونّتي ونّات معتلِّ","ونّة اللّي سارقٍ عوقَه",30,"ق",2,1],["وَنّتي ونّات تَعبانِ","متلفٍ وأهله يصيحونه",31,"ن",2,1],["ونّتي وَنّات ملتَدّه","لي بداها مظلم هيافِ",32,"ف",1,1],["ونتّخِذّنْ لنا وطناً جديداً","توفَر عيشةً وصَفَا شَرابا",33,"ب",2,0],["ونترك ما كان فيما مضى","ونرجع يا منيتي مثلما",34,"م",2,0],["وَنَتْ فيها الرِّياحُ الهوجُ حتَّى","كأنَّ ظهورَها العُليا بُطُون",35,"ن",1,0],["ونتركَ الأرضَ بالتَّامورِ ناجِعةً","منكُمْ سُيُولاً فلا يَذْهَبْ لها قَوَد",36,"د",1,0],["وَنَترُكُها مَعضُوضَةَ الوَجهِ بُرهَةً","مِنَ الدَهرِ لا سَمّاً بِفِيها وَلا شَهدا",37,"د",2,0],["ونت في مدارج سقط اللوى","كأني شكوت إليها غراما",38,"م",2,0],["وَنّتي ونّة عِليل","لي مَرَض ما به شفاه",39,"ا",2,0],["وَنّتي تَلْكِمْ يَرح قَلْبي","حتى آه مَا اقدر أَوِنّ بْها",40,"ب",3,1],["ونتركَ فيه الشغلَ إلا بطاعة","وما ليسَ فيه من ملامٍ للائم",41,"م",1,0],["ونتبعَ فيه الصالحين فإنهم","هدونا بأنوارِ الوجوه الوسائم",41,"م",1,0],["ونتركها حينا ونرجع بعده","إليها ولم تترك ديار فتون",42,"ن",1,0],["ونتيجةُ الأَحكامَ أَن","لا تَقضِيَنَّ على قياسك",43,"ك",1,0],["ونتائجُ الأَيَّامِ لم تَنقَد على","نَهجِ القِياسِ وقد تجيءُ بعكسِهِ",44,"س",2,0],["وَنتركه يَمشي الهوينا وَطالما","جَرى قَبلها الخيلاء بالتيه وَالكبر",45,"ر",1,0],["وَنترك منهلاً يَحلو لَدينا","إِلى مرّ وَلا نَأبى أَجاجه",46,"ج",2,0],["ونُتِجت تُنتَج نوق الحيّ","نتجها أربابها من طيّ",47,"ي",1,0],["ونتاج الحب ذياك الفتى","رمح آياسٍ حشاه اخترما",48,"م",2,0],["ونتلو أرخو برجاءِ خيرٍ","سلام اللَه وافى بالبشيرِ",49,"ر",1,0],["ونَتْفُكَ شعرَ الأنفِ دعْهُ مجانباً","ولا تغْسلنَّ الرأس بالطين والمدَرْ",50,"ر",1,0],["ونتيجة الأفعال في آثارها","وجلالة الأخطار في البينان",51,"ن",1,0],["ونتيجة الهم الطويل","هما لها صغرى وكبرى",52,"ر",2,0],["ونتركنَّ من المسعى مهالكَهُ","ومركباً نتوقى من طواغيه",53,"ي",2,0],["ونتخم غيرنا تهماً","إذا ما كان يتصل",54,"ل",1,0],["ونترع من معانينا كؤوسا","نعاقر صفوخمرتها القراحِ",55,"ح",1,0],["ونَتْركَ هذهِ المُدُنَ ال","دُّخانَ ونَتْرُكَ الهَلَعا",56,"ع",2,0],["ونتوء اخيلة الطغاة ضحىً","شماعة المتفلسفِ اللبقِ",57,"ق",1,0],["ونترك نصاً جاء في الهدى ذكره","وما فيه ذكر للنسا ولا وصف",58,"ف",1,0],["ونتلو من الأشواق والوجد والأسى","على فقد من نهوى ومن شطط البعد",59,"د",1,0],["ونترك النفس أحلامها","تعيش بها العيشة الراضيه",60,"ه",1,0],["ونتعب على رد الجمايل بشرواك","هالخير وجهك ، والكرم راس مالك",61,"ك",1,0],["ونتلو الآيَ إثرَ الآيِ حتَّى","يشِفَّ الروحُ عن ألَقٍ صُراحِ",62,"ح",1,0],["ونتاجُ أرضكِ .. كمْ أطالَ وقوفَنا !","حتىٰ نرىٰ ذاكَ النعيمَ الوافِرا",63,"ر",2,0],["ونتي منزالها وسط الصميم","مايترجم حزنها من يسمعه",64,"ع",2,0],["ون تفضيله وهو الحري به","فاه الكتاب به والنص فيه جلي",65,"ل",2,0],["وَنُتِجتِ بَدرِ مَحاسِنٍ أَضواؤُهُ","مُزرِيَةٌ بِالكَواكِبِ الوَقّادِ",66,"د",1,0],["ونترك طفلنا من غير دفء","بيوم ليس يعجبنا العناء",67,"ا",2,0],["ونتظموا المجدَ نبيَّاً صادعاً","بالمعجزاتِ وإماماً صدقا",68,"ق",2,0]]}