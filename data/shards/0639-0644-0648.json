ي","https://www.aldiwan.net/poem54047.html","الوافر"],[420,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[420,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[420,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[420,"رمى ولم يرم عن قوس ولا وتر","https://www.aldiwan.net/poem54110.html","البسيط"],[420,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[420,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[433,"هنيت يا شرف العلى وشريفها","https://www.aldiwan.net/poem39822.html","الكامل"],[436,"ألم به طيف الخيال مسلما","https://www.aldiwan.net/poem12475.html","الطويل"],[441,"عقت دارها إلا ثلاثا بها سحما","https://www.aldiwan.net/poem2592.html","الطويل"],[461,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[461,"أإن تحدث عصفور على فننِ","https://www.aldiwan.net/poem55829.html","البسيط"],[461,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[461,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[461,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[464,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[464,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[473,"لمن ربع بذات","https://www.aldiwan.net/poem4758.html","مجزوء الوافر"],[482,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[507,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[517,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[517,"ذو المعالي الباهرات علي","https://www.aldiwan.net/poem20848.html","المديد"],[518,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[523,"لسعد قدومكم هبّ النسيم","https://www.aldiwan.net/poem815.html",""],[527,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[532,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[554,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[554,"متى يبدي الكثيب لنا غزاله","https://www.aldiwan.net/poem47314.html","الوافر"],[554,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[554,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[554,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[561,"إن الغني إلى المولى من افتقرا","https://www.aldiwan.net/poem34492.html","البسيط"],[565,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[567,"فؤادي قد أغواه من بعد رشده","https://www.aldiwan.net/poem901.html",""],[569,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[570,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[578,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[590,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10451","الوافر"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75829","الوافر"],[1094,"سَأَلتُ فَلَم تكلِّمُني الرُسومُ","https://www.poetsgate.com/ViewPoem.aspx?id=8293",""]],"verses":[["عَلونا إِلى أَثباجِها وَلِغَيرِنا","عَنِ المَنكِبِ العالي إِذا رامَ ناكِبُ",0,"ب",1,0],["عَلَوتَ عَلَيهِمُ في كُلِّ أَمرٍ","بِطولِ الباعِ وَالصَدرِ الرَحيبِ",1,"ب",1,0],["عَلَوْتَ فَفُقْتَ النَّجْمَ حتّى تَخاوَصَتْ","إِليكَ عُيونُ الشُّهْبِ وَهْي جَواحِظُ",2,"ظ",1,0],["عَلَوْنا ذُراها كالبُدورِ تألّقَتْ","فجَلّى دَياجِيرَ الظّلامِ ضِياؤُها",3,"ا",3,0],["عَلَوْتَ فدُونَكَ السّبْعُ الشِّدادُ","وأنتَ لكُلِّ مَكْرُمَةٍ عِمادُ",4,"د",1,1],["علَوْت على بحْرِ السّماحِ حَبابةً","ولا غَرْوَ أنْ يعلو الحَبابُ على البحْرِ",5,"ر",1,0],["عَلَوتُكُمُ وَالشَيبُ لَم يَعلُ مَفرِقي","وَهادَيتُموني الشِعرَ كَهلاً مُجَرَّبا",6,"ب",2,0],["عَلونَ بِأَنماطٍ عِتاقٍ وَعَقمَةٍ","جَوانِبُها لَونانِ وَردٌ وَمُشرَبُ",7,"ب",1,0],["عَلَوتَ النَجمَ إِذ مَلَّ المُساعي","وَحُزتَ الخَصلَ إِذ كَلَّ الرَسيلُ",8,"ل",1,0],["عَلَونَ بِأَنطاكِيَّةٍ فَوقَ عَقمَةٍ","كَجِرمَةِ نَخلٍ أَو كَجَنَّةِ يَثرِبِ",9,"ب",1,0],["عَلَوْنا وكنتم سافلين فلم نكن","لنُبدي إليكم جَفوة المتهكِّم",10,"م",1,0],["عَلَوتُ عَلَيكُم بِالفُروعِ وَتَستَقي","دِلائِيَ مِن حَومِ البِحارِ الخَضارِمِ",11,"م",1,0],["عَلَوتُ عَلَيكَ ذِروَةَ خِندِفِيٍّ","تَرى مِن دونِها رُتَباً صِعابا",12,"ب",2,0],["عَلَوتَ مِنَ الأَعياصِ في مُتَمَنِّعٍ","مُقايَسَةً طالَت مِدادَ المُذارِعِ",13,"ع",1,0],["عَلَونا كَما تَعلو النُجومُ عَلَيهِمُ","وَقَصَّرَ حَتّى ما لِكَفَّيهِ مَدفَعُ",14,"ع",1,0],["عَلَوتُم كُلَّ رابِيَةٍ وَفَرعٍ","وَغَيرُكُمُ المَذانِبُ وَالهُجولُ",15,"ل",1,0],["عَلَوا شُعَب الرِّحَالِ عَلَى المَطَايَا","بِأسمَالِ المِلاَءِ مُعَصَّبِينَا",16,"ن",2,0],["عُلوجَ بَني كَعبٍ بِأَيِّ مَشيئَةٍ","تَرومونَ ياحُمرَ الأُنوفِ مَرامي",17,"م",2,1],["عَلَونا جَوشَناً بِأَشَدَّ مِنهُ","وَأَثبَتَ عِندَ مُشتَجَرِ الرِماحِ",18,"ح",1,1],["عَلَويَّةٌ أوصافها عُلْوِيَّةٌ","قد بذّت الإيجاز والإسهابا",19,"ب",2,0],["علومك يا دوح للمجتني","وذكرك يا روض للناشق",20,"ق",1,0],["علوتَ فأدركتَ النجوم فصغتها","كلاماً ففقت القائلين بذاكا",21,"ك",2,0],["علوم بآفاق المدارس تنتقى","وسجع بأفنان الدواوين تنقل",22,"ل",1,0],["علوتَ إلى أن جئتَ بالشهب منطقاً","يضيءُ به سارٍ وينهلّ شائم",23,"م",1,0],["علوتم به يا آل يحيى بشامخ","إلى أن نظرتم للسها من عليّه",24,"ي",2,0],["علوت اسماً ومقداراً ومعنى","فيا لله من حسن حليّ",25,"ي",1,1],["عَلوتم عُلوَّ نجومِ السماء","فَنُوؤوا علينا كأنَوائِها",26,"ه",2,0],["علوا فسقوا كل من تحتهم","فكم من غليل بهم قد نقع",27,"ع",1,0],["علوتَ علواً لم تكن قطُّ أهلَه","وأنت جديرٌ بعده بسَفالِ",28,"ل",1,0],["علومُ نجومٍ في قلوب كأنها","نجومٌ أُجنَّتْ في نجومٍ نواجمِ",29,"م",1,0],["عَلَوناهُمُ بِالمَشرَفِيِّ وَعُرِّيَت","نِصالُ السُيوفِ تَعتَلي بِالأَماثِلِ",30,"ل",1,0],["عَلَوتَ بَني الأَيّامِ إِذ كُنتَ فيهِمُ","إِذا ذُكِروا أَسمى وَأَسنى وَأَرأُسا",31,"س",2,0],["عُلوِيَّةً تَجِدُ المَسامِعُ طَيِّها","وَتُحِسُّ رَيّاها العُقولُ وَتَنشَقُ",32,"ق",1,0],["عَلَوا فَوقَ عَلياءِ العَدُوِّ وَدونَهُ","مَضيقٌ كَحَلقِ اللَيثِ أَو هُوَ أَصعَبُ",33,"ب",1,0],["عُلوجٌ وَأَعرابٌ يُرَجّونَ حائِناً","أَضاعَ الحِجى حَتّى طَغى وَتَمَرَّدا",34,"د",2,0],["عَلَوتَ عَلى خَمسَةٍ أَمجَدينَ","كِرامَ الفِعالِ كِرامِ الجُدودِ",35,"د",1,0],["عَلَوتَ عَلَيهِم عَلى أَنَّهُم","صَناديدُ مِن حَيِّ نَبهانَ صيدِ",35,"د",1,0],["عَلَوتَهُمُ بِجَمعِكَ ما أَشَتّوا","مِنَ العَليا وَحِفظِكَ ما أَضاعوا",36,"ع",3,0],["عَلوَ ياقُرَّةَ عَيني","وَمُنى نَفسي وَهَمّي",37,"م",2,0],["عُلُوُّ هِمَّتِهِ عَن ذاكَ يَرفَعُهُ","وَفَضلُ ثَروَتِهِ عَن ذاكَ يُغنيهِ",38,"ي",2,0],["عَلَونَ بِأَنماطٍ عِتاقٍ وَكِلَّةٍ","وِرادٍ حَواشيها مُشاكِهَةِ الدَمِ",39,"م",1,0],["علوجٌ قُمْصُ حَرْبهمُ حَدِيدٌ","يُعبِّرُ عنهمُ سَهَكُ النَّسيمِ",40,"م",1,0],["علوجٌ حَشَوْا في الكفر بالغيظ أعيناً","وقد ملؤوا منها قلوباً سخائما",41,"م",2,0],["عَلَوا بِجُنوبٍ موجِداتٍ كَأَنَّها","جُنوبُ فُيولٍ ما لَهُنَّ مَضاجِعُ",42,"ع",1,0],["عَلَوتَ مِن مَجدِ قَيسٍ في الوَرى عَلَماً","أَعيا الوَرى وَعَلا مَجداً بِكَ العَلَمُ",43,"م",1,0],["عَلَوْنَا مَطَاهُ وَهْوَ سَاجٍ فَمَا انْبَرَتْ","لَه الرِّيحُ حَتَّى ظَلَّ يَهْفُو وَيَرْفُلُ",44,"ل",1,0],["عَلَوتُ بِرَيدِها طَفَلاً كَأَنّي","حِوالَ اللُطفِ مَكسورُ الشَمالِ",45,"ل",1,0],["عَلَونا إِلى خَيرِ الظُهورِ وَحَطَّنا","لِوَقتٍ إِلى خَيرِ البُطونِ نُزولُ",46,"ل",1,0],["عُلومُ غَيْبٍ فلا الأرصادُ حاكِمةٌ","وَلا التقاوِيمُ فيها وَالتَّحاوِيلُ",47,"ل",1,0],["علوتَ فلولا التاجُ فوقك شكَّكتْ","تميمُ بنُ مُرٍّ فيكَ أنّك دارم",48,"م",1,0],["عَلَوتَ مَعَدّاً نائِلاً وَنِكايَةً","فَأَنتَ لِغَيثِ الحَمدِ أَوَّلُ رائِدِ",49,"د",1,0],["علُوْتُمُ فتواضَعْتُمْ على ثِقَةٍ","لمّا تَوَاضَعَ أقْوامٌ على غَرَرِ",50,"ر",1,0],["علوُّ زائد بأبي علي","أتاك بفضله الله العليّ",51,"ي",1,0],["عَلَوتُ بِصارِمي وَسِنانِ رُمحي","عَلى أُفقِ السُها وَالفَرقَدَينِ",52,"ن",1,0],["عَلَوْتُهُمُ بِطَبْعٍ لَيْسَ يَجْرِي","مَعِ الأَهْوَاءِ مِنْ وَكْرِ لِوَكْرِ",53,"ر",1,0],["عَلَوِيُّ العزم إنْ رام العلا","لم يضِقْ ذَرْعاً ولم يمَسْه أيْنْ",54,"ن",1,0],["عَلَوْتَ فَازْدَدْتَ بَيْنَ النَّاسِ مَعْرِفَةً","وَالنَّجْمُ يَعْلو فَيبْدُو شِبْهَ مَفْقُودِ",55,"د",1,0],["علوتُ طودَ الزمان حتَّى","رأيتُ من فوقه الوجودا",56,"د",2,0],["عَلَوْتَ مَطَاهُ وَهْوَ للأَرْض مَشْرَعٌ","وأَنْتَ لآمالِ الرَّعِيَّةِ مَشْرَع",57,"ع",1,0],["عَلويّ محمدي عليه","من سنا النسبتين سيما السداد",58,"د",1,0],["علوت على موجه بعدما","تحداك عارم تياره",59,"ر",2,0],["علوا فَسَقَوْا كلَّ من تحتهم","فكم من عليلٍ بهم قد نُقع",60,"ع",1,0],["علونكمُ والشّيبُ لمْ يعلُ مفرقي،","وَهادَيتُمُوني الشِّعر كَهْلاً مُجَرَّبَا",61,"ب",2,0],["علوا وهما وعن سفه وطيش","رأوا شتم الكرام لهم معاشا",62,"ش",2,0],["علوا بدين واخلاق مورثة","لا كالذين علاهم سرقة الذهب",63,"ب",1,0],["علوا قمة المجد الاسم","وقد عطر واشرق الورى والمغاربا",64,"ب",2,0],["عَلَوا أعصَارَ ذِى الأرضِينَ طُرًّا","كَمَا عَلَتِ الصُّوَى شُمُّ الجِبَالِ",65,"ل",1,0],["عَلَوتَ بِحُكمٍ لا يُقارِنُهُ هَوىً","وَمَحضِ وَفاءٍ لا يُقارِبُهُ خَترُ",66,"ر",1,0],["عَلَوتَ بِهِ الأَجوادَ طُرّاً مَكارِماً","وَفُتَّ بِهِ الأَمجادَ قاطِبَةً سَبقا",67,"ق",2,0],["عَلَوتَهُمُ بَناناً في العَطايا","وَفُتَّهُمُ ثَباتاً في النِضالِ",68,"ل",1,0],["عَلَوا جُدوداً وَأَجداداً فَفَخرُهُمُ ال","مُذاعُ مُتَّصِلٌ طَوراً وَمُنفَصِلُ",69,"ل",1,0],["عَلَوتَ يَفاعَهُ يَفَعاً وَيَأبى","إِباؤُكَ أَن تُدانى فيهِ كَهلا",70,"ل",2,0],["عَلَوتَهُمُ خَلقاً وَخُلقاً وَهِمَّةً","وَأَينَ وِهادُ الأَرضِ مِن صَهوَةِ السَما",71,"م",2,0],["عُلومُ الوَرى في لَفظَةٍ مِن كَلامِهِ","وَلا عَجَبٌ أَن يُعدَلَ الفَردُ بِالجَمعِ",72,"ع",1,0],["عُلوَّ حَبيبٍ حَرَّكَتهُ عِنايَةٌ","لِيُبصِرَ ما قَد كانَ يَعلَمُ بِالسَمعِ",72,"ع",1,0],["عَلَوْتَ في المَجْدِ كلَّ مَكْرُمَةٍ","كُنْتَ بِها ثالِثَ السِّماكَيْنِ",73,"ن",1,0],["عَلَوِيٌّ مِنْ أَهْلِ بَيْتٍ تَعالَوا","دُونَ أَقدارِهِمْ عَلَى الأَقْدارِ",74,"ر",1,0],["علَونا قَنَونى بالخَميسِ كَأَنَّنا","أَتيٌّ سَرى من آخرِ اللَيلِ يَقصِفُ",75,"ف",1,0],["عَلوا بالخَيلِ نَخلَةَ فاِستقلَّت","إِلى الأَعداء بالمَوت الذُباحِ",76,"ح",1,0],["عَلَوتُ عَلى أَكتادِ كُلّ مُلِمَّةٍ","تَرَدّى بِأَعطافِ الخُطوبِ الكَوارِثِ",