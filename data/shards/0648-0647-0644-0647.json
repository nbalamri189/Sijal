{"poems":[[55,"لهان الغمد ما بقي الحسام","https://www.aldiwan.net/poem29818.html","الوافر"],[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[88,"يا صاحب الروضة الغناء هجت بنا","https://www.aldiwan.net/poem68930.html","البسيط"],[32,"خليلي عوجا عوجة ناقتيكما","https://www.aldiwan.net/poem29543.html","الطويل"],[90,"هو الدهر لم يترك مشن غواره","https://www.aldiwan.net/poem45014.html","الطويل"],[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[47,"أبالمنحنى أم بالعقيق أم الجرف","https://www.aldiwan.net/poem65157.html","الكامل"],[47,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[76,"أبشرك أم ماء يسح وبستان","https://www.aldiwan.net/poem13268.html","الطويل"],[54,"أيا سدرة الوادي على المشرع العذب","https://www.aldiwan.net/poem27289.html","الطويل"],[48,"لقد جاءنا هذا الشتاء وتحته","https://www.aldiwan.net/poem22239.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85482","المجتث"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8238","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[106,"سيدة الاقمار","https://www.poetsgate.com/ViewPoem.aspx?id=16826",""],[108,"القُبلة","https://www.poetsgate.com/ViewPoem.aspx?id=179478",""],[92,"منى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=178934",""],[119,"عذري اليك غرام لا اكيفه","https://www.aldiwan.net/poem40885.html","عموديه"],[137,"لك النصر حزب والمقادير أعوان","https://www.aldiwan.net/poem4207.html","الطويل"],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[154,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[164,"أقمن على قلبي رقيبا من الحب","https://www.aldiwan.net/poem58937.html","الطويل"],[173,"ظننت حسودي حين غالت غوائله","https://www.aldiwan.net/poem1644.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[214,"قتيل هواك ليس يروم ثاره","https://www.aldiwan.net/poem13365.html","الوافر"],[280,"نموت على الدنيا فنحيا بلا دين","https://www.aldiwan.net/poem25496.html","الطويل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[302,"أفي كل يوم للأماني تكذيب","https://www.aldiwan.net/poem33335.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[358,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[369,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[369,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[463,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[463,"لها بعد خطو لات حين مراح","https://www.aldiwan.net/poem56257.html","الطويل"],[473,"وذي حلة من نسيج الزمان","https://www.aldiwan.net/poem60014.html","الكامل"],[569,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122711","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48785","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59731","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59727","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59776","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59697","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107212","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107192","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59431","الطويل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177918","السريع"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131923",""],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133838","الطويل"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104416","الطويل"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113644","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49915","الطويل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107300","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11933","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49600","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69373","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109334","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60958","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93648","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87730","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137351",""],[2719,"","https://poetry.dctabudhabi.ae/diwan/poem/144539","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93366","الوافر"],[2836,"","https://poetry.dctabudhabi.ae/diwan/poem/203442","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100295","الوافر"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122481","البسيط"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34742","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204646","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204647","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204464","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112558","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46794","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89004","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62763","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48286","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48274","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48323","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48275","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108340",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66324","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91153","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91783","الطويل"],[3705,"","https://poetry.dctabudhabi.ae/diwan/poem/145358","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117881","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128892","المجتث"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35655","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[5070,"الفردوس المفقود","https://www.poetsgate.com/ViewPoem.aspx?id=99368",""],[5147,"تغالطنا أصول الانتخاب","https://www.poetsgate.com/ViewPoem.aspx?id=166692",""],[5147,"يا شعب شرق العراق قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=166756",""],[5989,"ليت أنك قد ذقتا","https://www.poetsgate.com/ViewPoem.aspx?id=181497",""],[6093,"بطريق ( الطويل )","https://www.poetsgate.com/ViewPoem.aspx?id=176005",""]],"verses":[["وَهَل هُوَ غَيرُ فَذٍّ أَخلَفَتهُ","لَكَ العَلياءُ وَالنِعَمُ التُؤامُ",0,"م",1,0],["وهلْ هوَ إلا مَظْهَرٌ أنْتَ سِرُّهُ","ليمْتازَ في الخَلْقِ المُكِبُّ منَ الأهْدى",1,"د",2,0],["وَهَل هُما في سَماءِ الشِعرِ قَد بَلَغا","شَأوَ النَواسِيِّ في صَوغٍ وَإِتقانِ",2,"ن",1,0],["وَهَل هَمَلانُ العَينِ راجِعُ ما مَضى","مِنَ الوَجدِ أَو مُدنيكِ يا مَيُّ مِنَ أَهلي",3,"ل",2,0],["وهل هو في هذا الفضاء مسافر","له غاية مقصودة من سِفاره",4,"ر",2,0],["وهل هم مثلنا خُلقًا وخَلقًا","هناك فيأكلون ويشربونا؟",5,"ن",2,0],["وهل هم في الديانة من خلاف","نصارى أو يهود ومسلمونا؟",5,"ن",2,0],["وَهَل هُوَ إِلّا ما اِبتَنى في حَياتِهِ","إِذا قَذَفوا فَوقَ الضَريحِ الجَنادِلا",6,"ل",2,0],["وَهَل هَضَباتُ اِبنَي شَمامٍ بَوارِحٌ","إِذا عَصَفَت هوجُ الجَنائِبِ بِالعَصفِ",7,"ف",1,0],["وَهَل هِيَ إِلّا لَوعَةٌ مُستَسِرَّةٌ","يُذيبُ الحَشا وَالقَلبَ وَجداً غَليلُها",8,"ل",3,0],["وَهَل هِيَ إِلّا جُملَةٌ مِن مَحاسِنٍ","تَغايَرُ أَبصارٌ عَلَيها وَآذانُ",9,"ن",1,0],["وَهَل هِيَ إِلّا حاجَةٌ قُضِيَت لَنا","وَلَومٌ تَحَمَّلناهُ في طاعَةِ الحُبِّ",10,"ب",1,0],["وَهَل هُوَ إِلّا رائِدٌ لِعَشيرَةٍ","يُلاحِظُ بَرقاً في الدُجى يَتَبَوَّجُ",11,"ج",1,0],["وَهَل هناك خفاء","وَهَل هناك ظهور",12,"ر",1,0],["وَهَل هناك سماء","فيها النجوم تدور",12,"ر",1,0],["وَهَل هنالك بدر","كَما يقال منير",12,"ر",1,0],["وَهَل هَكَذا يَلقى المُحِبّونَ مِثلَ ما","لَقيتُ بِها أَم لَم يَجِد أَحَدٌ وَجدي",13,"د",2,0],["وهل هانَتْ عَزائِمُهُ ولانَتْ","فقد كانَت عرائِكُها شِدادا",14,"د",2,0],["وَهَلْ هُوَ غَيْرُ أَفْعَالٍ مَوَاضٍ","تَذِيعُ وَفَضْلُهَا أَلاَّ تَذِيعَا",15,"ع",2,0],["وَهَل هِي غَيرُ دارِ أَذىً","إِذا دَخَلوا بِها خَرَجوا",16,"ج",3,0],["وهل همستِ\"حبيبي!\"أم سَمعتُ صدى من عالم الجنِّ .. لم يهمس به أحدُ؟","أظنّ ما كان من تأليف راويةٍ تحكي وتنسى .. فباقي الفصلِ مُفتقدُ!",17,"د",1,0],["وهل هو صبٍّ أم فقيهٌ مشرع","يحلُلُ في شرع الهوى ويحرِّم؟",18,"م",1,0],["وهل هذه الدنيا سبيل لعابر","أم الأرض مهواة الغواة الهوالك",19,"ك",1,0],["وهل هممت على همي غدرت اذا","وكل هم فان الله يصرفه",20,"ف",2,0],["وهل هوَ إلا من أناسٍ تهافتوا","فراشاً على أسيافكم وهي نيرانُ",21,"ن",1,0],["وَهَل هُوَ إِلّا الريحُ عِندَ هُبوبِها","تَبيتُ رُخاءً ثُمَّ تُصبِحُ زَعزَعا",22,"ع",2,0],["وَهَل هُوَ إِلّا مُزنَةٌ فَوقَ جَنَّةٍ","فَمِن نَهَرٍ عَذبٍ وَمِن ثَمَرٍ حُلوِ",23,"و",1,0],["وهل هجروني يوم أرخوا ستورهم","بذنب فأرجو عطفهم أو بلا ذنب",24,"ب",1,0],["وَهَل هَمَّت المَوتى بِإشعاءِ غارَةٍ","يُثارُ بِها مِن كُلِّ جَوٍّ قَساطِلُه",25,"ل",2,0],["وَهَل هُوَ إِلّا المَوتُ وَالمَوتُ فَاِعلَمُوا","يَهُونُ وَلا تَحكِيمُها وَاِصطِلامُها",26,"م",3,0],["وهل هاتيك لو تدري وهذي","وتلك وذي سوى اسما اشاره",27,"ر",2,0],["وَهَلْ هِيَ إِلا لِلْمَساكِينِ وَيْحَنا","مَسَاكِينَ فيهَا يَرْتَعُونَ إلَى حينِ",28,"ن",1,0],["وَهَل هيمنَت ريحُ الصبا بشِعابها","سُحَيراً وَراحَت بالشَذا تَتَنسَّمُ",29,"م",1,0],["وَهَل هو الّا دَوحةٌ قد تفرَّعت","فُكُنتُ لها غُصناً نَمَته الأَنابيبُ",30,"ب",1,0],["وهل هاجري وجداً بغيري بالغ","رضاي لصب طالب دار هجرة",31,"ه",1,0],["وَهَل هَصرت بِهِ غُصن المُنى فَغَدا","داني الجنى سكّريّ العَصف مثمرهُ",32,"ر",2,0],["وهل هو إلاّ فائتٌ قد قَضَيْتُه","فلستُ بنارِ العَتْبِ أَهْلاً لأَنْ أُصْلَى",33,"ل",2,0],["وهل هي إلا مُهجةٌ يَطْلُبونَها","فإن أرضَتِ الأحبابَ فَهْي لهم فِدى",34,"د",2,0],["وهل هارِبٌ يَنْجو إذا أنت للِعدا","أبا طالبٍ أبدَيْتَ صفْحةَ طالب",35,"ب",1,0],["وهل هباتك يبغيها مغالبةً","من أنت واهبُه أو أنت بائعُهُ",36,"ع",2,0],["وهل هيفاء إن غدرت وجارت","سوى غُصْنٍ من الأرواح يَجري",37,"ر",2,0],["وهل هي إلا رقدةٌ فاسمحا بها","وحسبكما أن توقَظا لسماحِ",38,"ح",1,0],["وَهَل هُوَ إِلّا العَروسُ الَّتي","تَقَلَّدَتِ الحَلى وَالجَوهَرا",39,"ر",2,0],["وهل هذه هجر أم الخلد زخرفت","فما كان فيها بالنعيم لنا خبر",40,"ر",1,0],["وَهَل هُنَّ غَضّاتٌ كَأنَّ فُروعَها","فُرُوعُ العَذارَى ظِلُّهُنَّ ظَليلُ",41,"ل",1,0],["وهل هو بين أيدي الرهط ملهىً","كما يلهو بدميته الصغير",42,"ر",1,0],["وهل هي إلا همة يوسفيةُ","محملة فوقَ الذي تستطيعه",43,"ع",2,0],["وهل هي إلا النفس منحة منعم","وربيَ يعطي ما يشاء ويمنع",44,"ع",1,0],["وهل هذه الأسماء إلا إشارة","لمستفهم في شأنها يحسن الفهما",45,"م",2,0],["وهل هي إلا لمحة في غياهب","تعبدنا وصفاً وتسعفنا وهما",45,"م",2,0],["وهل هي إلا الشمسُ حسناً وَمنصباً","ولكنها أنأى وأبهى وأبهر",46,"ر",1,0],["وهل هيَ إلا الخيلُ تختال نزَّعاً","فتردي غوياً في الضلال رجيماً",47,"م",2,0],["وَهل هِمنا بِجَنّاتٍ أُعِدَّت","بِغَيرِ الوَصفِ فأخُذهُ مِثالا",48,"ل",2,0],["وَهَل هُوَ مِثلِي كُلَّما هاجَهُ الأَسَى","يُساجِلُ وُرقاً بِالحِمَى وَيُناوِحُ",49,"ح",1,0],["وَهَل هُوَ إِلا في رِياضٍ نَسِيمُها","لأَكمَامِ أَزهارِ المَسَرّاتِ فاتِحُ",49,"ح",1,0],["وهل هو إلا نور عيني ومهجتي","وسر وجودي والمعد لمرمسي",50,"س",2,0],["وهل هواءٌ مُخْبِرٌ عن هوىً","يُقْصَر، فالوجد به ذو امتداد",51,"د",1,0],["وهل هي إلا بنتُ شِعْرٍ عزيزةٌ","تُزاحم أركانَ السهى بالمناكب",52,"ب",1,0],["وهل هوت الاستار وانجاب مظلم","مداه المدى وانفكّ عقد ثوان",53,"ن",1,0],["وهل هو في مشقوقة اللحد سامع","وقد أن مفجوع عليه أنينه",54,"ن",2,0],["وهل هاجعات البان نبَّه خوطها","هبوب نسيمٍ هبَّ وهو عطيرُ",55,"ر",1,0],["وهل هيَ إلا زَفرة القلب تغتلي","بحر الهَوى أو عبْرة العين تُسكبُ",56,"ب",1,0],["وَهَل هو يَرعَى سِرَّنا في مَغِيبِهِ","كَما أننا في بُعدِهِ قد رَعَينَاهُ",57,"ا",2,0],["وَهَل هَمَّ يَوماً شيركوهُ بِجِلَّقٍ","إِلى الصَيدِ إِلّا اِرتاعَ في مِصرَ شاوَرُ",58,"ر",1,1],["وهل هو إلا شجىً لم تُسِغْهُ","فلاحَ بأَجْيادِها وَاسْتَبانا",59,"ن",2,0],["وَهَل هُوَ إِلّا الغَيثُ حَلَّت رِهامُهُ","مَكاناً وَمالَت عَن مَكانٍ رِهامُهُ",60,"م",2,0],["وهل هو إِلا ظرفُ بَوْلٍ وغائِطٍ","وإِنْ يُطْلَ من طِيبٍ بكل طِلاء",61,"ا",2,0],["وهل هكذا يفعل الحاكمو","ن ام الظلم ذلك لم يسبق",62,"ق",1,0],["وهل هو إلاّ لونّها صَبَغت به","ذوائبَ رأسي والفؤداُ يذوب",63,"ب",1,0],["وَهلهلة المُوحد إِن وَعاها","اِنثَنى طَرَباً فَتحسبه خَليعا",64,"ع",2,0],["وَهَل هُم عالِمُون بِما نُلاقي","مِن الآلام أَم لا يَعلَمونا",65,"ن",2,0],["وهل هلال السبق في الشرق فاكتسى","جلابيب أفراح منضدة الدّر",66,"ر",1,0],["وهل هي إلاَّ في تراثٍ جمعتَهُ","فهلاّ غَدَت في بذل عُرف ونائلِ",67,"ل",1,0],["وَهَل هُم غَيرُ عُشَّاقٍ أُصيبوا","بِفَقدِ حَبائِبٍ وَمُنوا بِهَجرِ",68,"ر",1,0],["وهل هي إلاّ الدرّ في سلك نظمها","وأنت الخضم البحر تقذف بالدُّرّ",69,"ر",1,0],["وهل هزَّت صباً بالغور مهدا","لطفل حواضن النوروز غيري",70,"ر",2,0],["وهَلهَلَ الحَبرُ يُلقِي مِن مواعِظِهِ","فاستغرَقُوا فِي البُكا لله وانهَمَكُوا",71,"ك",3,0],["وَهَل هِيَ إلا مِثلُ عِرسٍ تَبَدَّلَت","على رَغمِها مِن هاشمٍ في مُحَاربِ",72,"ب",1,0],["وهل هي في النهار تنام رغدا","وتسهر في الدجى بالقرب مني",73,"ن",2,0],["وهل هو عاشق فتنته يوما","لحاظ هريرة كحلاء جفن",74,"ن",1,0],["وهل هو يقصيني غدا أو يضمني","له ذاك سر مبهم ما فهمته",75,"ت",2,0],["وهلهلت شعري في استثارة أمتي","وكم صحت في قومي إلى المجد أقدموا",76,"م",3,0],["وَهَلْ هِيَ إلا الصّالِحاتُ بِأَسرِها","فَعُجْ بي عَلَيْها أستجدَّ بها عُجبي",77,"ب",2,0],["وهل هي إلا رَحْمة اللّهِ يُسّرَتْ","لِمَوْهِبة الحُسْنَى وَمَغْفِرَة الذّنبِ",77,"ب",1,0],["وهل هي إلا رتبة كان مسكها","لديك ختاماً من علاك وطيبا",78,"ب",2,0],["وهلْ هو إلا الموتُ يا جلبَ العَصا","أُنافِسُ في مكروههِ وأُزاحِمُ",79,"م",1,0],["وهل هي إلا دولةٌ يوسُفيّةٌ","خِلافَتُها سرُّ العُلَى ولُبابُها",80,"ب",3,0],["وهل هي إلا آيةٌ ناصريّةٌ","تطلّعَ في أفْقِ الجَلالِ شِهابُها",80,"ب",3,0],["وهل هي إلا همّةٌ خزْرجيةٌ","تُصافحُ عُلْويَّ النجومِ هِضابُها",80,"ب",3,0],["وهل هُوَ إلا السيفُ جُرِّدَ للعِدَى","فلمّا تمادَى سَلْمُها رُدَّ في غِمْدِ",81,"د",1,0],["وهل هُو إلا الرُّمْحُ أُشْرِعَ نصْلُهُ","فقصَّدَهُ دهْرٌ ثناهُ عن القَصْدِ",81,"د",1,0],["وهلْ هُو إلا الطّرفُ أُرْسِلَ سابقًا","إلى أمدِ العَلياءِ فارْتاحَ للرّدِ",81,"د",1,0],["وهل هوَ إلا الغيثُ أقلعَ إذ سَقى","معاهِدَنا من أفْقِه واكِفُ العَهْدِ",81,"د",1,0],["وهل هُوَ إلا الروضُ باكرهُ الحَيا","فأوْدَعَ ريّاهُ صَباهُ وشَمْألَهْ",82,"ل",2,0],["وهل هيَ إلا همّةٌ خزْرَجيّةٌ","تلوحُ علَى شُهْبِ السّماءِ سِماتُها",83,"ت",3,0],["وهل هيَ إلا عَزْمةٌ غالبيّةٌ","إذا خفّتِ الأعْلامُ راعَ ثَباتُها",83,"ت",3,0],["وهل هيَ إلا قُدْرةٌ ناصريّةٌ","ثَنى البَطشَ منها حِلْمُها وأناتُها",83,"ت",3,0],["وهل هيَ إلا شيمَةٌ يوسفيّةٌ","قَضى صَفْحُها أن أُغْمِدتْ صَفحاتُها",83,"ت",3,0],["وهل هذه الأفكارُ إلا ظَعائِنٌ","حَدَتْها منَ الأمْداحِ فيكَ حُداتُها",83,"ت",3,0],["وهل هو إلا الصّنعُ أهْداكَ آيةً","فكانتْ على نَيْلِ المنى آيةً كبْرى",84,"ر",2,0],["وهل هذي الحياة بلا وصال","بقطع وريدها يمضي الدوام",85,"م",1,0],["وهل هو قاضٍ باللقا بعد بيننا","فقد طال فيما بيننا ذا التباعدُ",86,"د",1,0],["وَهَل هِيَ إِلّا البَدر عُمراً وَبَهجة","وَبَعد الَّذي أَمل كَراجي التناول",87,"ل",1,0],["وَهل هيَ إِلا منزلٌ في طريقنا","تناوب فيهِ أُمّة بعد أُمة",88,"ه",1,0],["وهل هو إلا نار وجدي وكلما","تنفست عم الجو ضوء شراره",89,"ر",2,0],["وهل هو إلا الفائق الفائق الذي","يزحزح عن خود المعاني دجى الحجب",90,"ب",1,0],["وهل هناك أناس","منهم سهارى ونوم",91,"م",1,0],["وَهَل هِيَ إِلّا دار كلِّ مُلمَّةٍ","أَمض لِأَحشاءِ الكِرامِ مِنَ الطَّعنِ",92,"ن",1,0],["وهل هي الا في الافاضة فوّضت","محاجرها في الحجر فيض دماها",93,"ا",3,0],["وهل هي طابت فاستطابت سوى السرى","الى طابة الفيحاء موطن طه",93,"ه",1,0],["وهل هو ان أهوى إلى مشط رجلها","كأيم ففي قلبي له دائما نشط",94,"ط",1,0],["وهَلْهلَ الشعرَ، زفزافاً مقَاطِعُهُ","وفجّرَ الروضَ: أطيافاً وألحانا",95,"ن",2,0],["وهل هي حول حق الشعب إلا","شفار ظباً سللن على الرقاب",96,"ب",1,0],["وهل هم غازلوا المغاني","وناشدوا بينهن لبنى",97,"ن",2,0],["وهل هال منك القلبَ يوماً مشاعرٌ","وهل بالبكا من شوق قلبك أجهشتا",98,"ت",2,0],["وهَلَّ هِلالٌ للَوقَارِ بِفَودِهَا","فصادفَ منها الحَالُ شوقيَ صائما",99,"م",2,0]]}