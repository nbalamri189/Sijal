6","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108639","الكامل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102069","الوافر"],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142262","الطويل"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123675","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28587","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60901","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93695","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93794","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93824","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93792","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203486","الوافر"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11243","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53012","الرمل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123928","الخفيف"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35067","الكامل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138914",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133216","الوافر"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120186","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136515",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136388",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120469","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139744",""],[4984,"نازفة الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=175562",""],[5038,"موطن الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=190108",""],[5211,"عِشْ خَلفَ وجْهِك","https://www.poetsgate.com/ViewPoem.aspx?id=176158",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"بكتاب عشقي اودعتْ كي أفتحه !!","https://www.poetsgate.com/ViewPoem.aspx?id=197671",""],[5436,"لي فيك شكوى / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177539",""],[5574,"تائية أبي ريما","https://www.poetsgate.com/ViewPoem.aspx?id=206045",""],[5720,"درعُ الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=199874",""],[6069,"بكت الخطوب وثغر مجدك ضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=105696",""]],"verses":[["فَنَدِمتُ بَعدَ الحُبِّ كَيفَ أُطيعُهُ","وَعَصَيتُ عَزماتي وَهُنَّ أَوامِرُ",0,"ر",1,0],["فَنَديمُنا ثَمِلُ القَوا","مِ أَغَنُّ ساجي الطَرفِ ناعِم",1,"م",1,0],["فُنِّدتِ حينَ طَمِعتِ في سُلوانِهِ","هَيهاتَ لا ظَفَرٌ هُناكَ لِطامِعِ",2,"ع",1,0],["فَنَدَاكَ يَجْرِي فِي اليَرَاعَةِ نَافِثاً","مِنْ سِحْرِهِ وَسَدَاكِ يَنْطُقُ فِي الفَمِ",3,"م",1,0],["فَنُدرِكُ بِالإِقدامِ بُغيَتَنا الَّتي","نُطالِبُها لا بِالمَكيدَةِ وَالمَكرِ",4,"ر",1,0],["فَنَدُ العَواذِلِ في السَماحِ يَزيدُهُ","جوداً وَيُرجِفُهُم بِرُغمِ أُنوفِ",5,"ف",1,0],["فَنداهُمُ قَبلَ السُؤالِ وُجودُهُم","قَبلَ النَدى وَكَذَلِكَ الكُرَماءُ",6,"ا",2,0],["فَنداهُ البَحرُ والبَحرُ مَتى","تعصفِ الرّيحُ عليه يُزْبدِ",7,"د",1,0],["فنداك مثل الغيث يهجر مرة","ويزور مرات فننسى المرة",8,"ه",1,0],["فَنَداك مُنتجعي وبابُكَ مقصَدي","وهواكَ راحلتي ومدحُك زادي",9,"د",2,0],["فَنَدى العزيزِ وجُودُه عُوْنٌ على","ما نَتَّقِيه من فساد الأعصر",10,"ر",1,0],["فَنَّدَني وَما دَرى","بِأَنه حَرَّضَني",11,"ن",2,0],["فَنَدعوكَ في الهَيجاءِ ياقاتِلِ العِدى","وَنَدعوكَ في اللَأواءِ يا قاتِلِ المَحلِ",12,"ل",1,0],["فَنَدعوكَ يَومَ السِلمِ ياواهِبَ اللُهى","وَيَومَ الوَغى ياقائِدَ الضُمَّرِ القودِ",13,"د",1,0],["فندِمَ الأَديبُ","وَساءَه التَكذيبُ",14,"ب",1,0],["فندمت لكن بعد ما","غربت شموسك تتقح",15,"ح",1,0],["فندعو بها سبعاً وعشراً يومنا","وليلتنا فيما فرضت وأدينا",16,"ن",2,0],["فنَداك ممنوحُ الحَيا","ومداكَ ممنوعُ الجوانِب",17,"ب",1,0],["فندى بني نبهان مغن ساتر","عن فضل غيرهم بهجو فاضح",18,"ح",1,0],["فندت ظُبا الأقلام يخدُمها الظّبا","ويقادُ ألفُ متوَّج بمعمَّمِ",19,"م",1,0],["فنَداهُ سَحٌّ في الأكُ","فِّ وضرْبُهُ في الهامِ هَبْرُ",20,"ر",1,0],["فنُدركُ بالذّحولِ بَني أميٍّ","وفي ذاك الذحولِ لهم فناءُ",21,"ا",2,0],["فَنَّدْتَ ما كان يدَّعيه","علامةُ العالم الجديد",22,"د",1,0],["فندمانهم عاد البكاء تندما","وأزمانهم بالنوح قد عدن مأتما",23,"م",2,0],["فنَدَبتُ صحبي للسُرى فأجابني","ماضي العزيمة ليس بالهيّابِ",24,"ب",1,0],["فنداك مبذولٌ لكل مؤملٍ","كاسٍ بأثواب الحجى أو عار",25,"ر",1,0],["فندعوه ونسأله","سؤالا معه ايقانا",26,"ن",2,0],["فندعوك يا رباه يا من قد اعتلى","على عرشه والأمر أمرك تسمع",27,"ع",1,0],["فنداك المأمول في كل ضيق","ومرجي بشدّة ورخاء",28,"ا",2,0],["فَنَدى فَحَسبُكَ إِنَّ مِثلي شاكِرٌ","وَغِنىً فَحَسبي إِنَّ مِثلَكَ مُنعِمُ",29,"م",1,0],["فنّدتْ من لا يستطيع تصبراً","وعذلتَ من لا يسمعُ التعذالا",30,"ل",2,0],["فَنَدى يَمينك قَد سَقى أَهلى الحِمى","عَذباً يبل مِن الصُدور أَوامَها",31,"م",3,0],["فندا الغمامة فيض ماء قاطر","ونداه فيض جواهر ودراهم",32,"م",1,0],["فندا السحائب بالبكا","وندا يديه بالابتسام",33,"م",1,0],["فندا السحابة قطرة من مائها","وندا يديك جواهر ودراهم",34,"م",1,0],["فندخلهم لنا بالرغم عنهم","وتطفئ نارنا بمساجلات",35,"ت",1,0],["فَنَدِمتُ أَن لا كُنتُ قَد","تَرَكتُها بِغَطائِها",36,"ا",3,0],["فنديمُ الأنس صَافي","لك بالراح سُلافا",37,"ف",2,0],["فندوني على هواك","وأولى لي الفند",38,"د",1,0],["فَنَدورُ نَحنُ وَهُم وَفيما بَينَنا","كَأسُ المنونِ تَقولُ هَل مِن شارِبِ",39,"ب",1,0],["فنداك قام لك الفخار به","إن الفخار دعامه الكرم",40,"م",1,0],["فندم الأديب","رسائه التكذيب",41,"ب",1,0],["فندّ بمهجتي في كل واد","فما أحسنت من ضعفي قياده",42,"د",2,0],["فنداهم غيث لدى","راج بساحتهم هما",43,"م",2,0],["فنداه عذبٌ فراتٌ وما ساغَ","سواه لغلة الظَمآن",44,"ن",1,0],["فندمتُ من قولي","وربَّ ندامةٍ يمحو الذنُوبا",45,"ب",2,0],["فنداك ناداني وقيدني","يا حبذا صفد به اليسر",46,"ر",1,0],["فندعو الله ما عشنا وقلنا","بان يبقى لنا غوثا وصمدا",47,"د",2,0],["فنداه لعلاه جُنَّةٌ","والأيادي للمعالي جنن",48,"ن",1,0],["فندى الليالي للشعار خصوبة","وبسمسم صخر يفيق على انزياح",49,"ح",1,0],["فنداوةُ القرْبى إذا سُجِرَتْ","كحَلاوةِ الْحُسْنى بلا مِنَنِ",50,"ن",1,0],["فَنُدُوبُ وَجْهِك تَسْتَخِفُّ بِمَا تَرَى","فَمَضَتْ أمَامَ العَابِثينَ صِيَامَا",51,"م",2,0],["فندبت للعلياء دون منافس","وعلوت رغم غوائل الخوان",52,"ن",1,0],["فندعوه في كشف الملمات إن عرت","لتفريج كرب قد أضر وألما",53,"م",2,0],["فنديم يمّك مورقٌ متبرعمٌ","وخرير مائك قاصدٌ أن ينضحه",54,"ح",2,0],["فنّدت فيك وفي هواك عواذلا","مابال حاسدنا اداركٓ مقنعا",55,"ع",2,0],["١٨- فندبْتُ حظّي باكياً: يا ليْتني","لم أصْحُ، عَلِّي أسْتقي لَذّاتِها",56,"ت",3,0],["فندفعُ عنه الضيمَ . . في كلِّ موقعٍ","ونرفعُ صوتَ الحقِ . . للهِ شاهدا",57,"د",2,0],["فنداك مبذولٌ ومدحك سائر","وحماك ممنوعٌ وطيبك صائك",58,"ك",1,0]]}