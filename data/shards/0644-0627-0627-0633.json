wPoem.aspx?id=194604",""],[5956,"شعبان ورمضان والإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=194654",""],[5956,"حارَ حناني","https://www.poetsgate.com/ViewPoem.aspx?id=195020",""],[5956,"أنهكتَ أمك لست تأكل جيدا","https://www.poetsgate.com/ViewPoem.aspx?id=205428",""],[5956,"الشاكر لقرينته","https://www.poetsgate.com/ViewPoem.aspx?id=207167",""],[5956,"أحسِنْ إلى الفقراء وابعدْ عنهمو","https://www.poetsgate.com/ViewPoem.aspx?id=207268",""],[5956,"لبيكِ يا خطيبتي ثم قرينتي رفاه","https://www.poetsgate.com/ViewPoem.aspx?id=208836",""],[5956,"هل يستطيب الفتى إيهابُ فُرقتنا","https://www.poetsgate.com/ViewPoem.aspx?id=210301",""],[5956,"وخْزٌ في زَند ابنتي آن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213372",""],[5956,"القدِّيسة النقية تقية","https://www.poetsgate.com/ViewPoem.aspx?id=215548",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6056,"وردتين ٍ على تل","https://www.poetsgate.com/ViewPoem.aspx?id=130333",""],[6093,"أما المعلم كان خطا أحمرا","https://www.poetsgate.com/ViewPoem.aspx?id=201760",""],[549,"توبة في محراب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=203000",""],[5309,"لم يبق لي امل سواك فإن يفت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573773",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""],[147,"بكَ اقتضى الدينُ ديناً كانَ قدْ وجبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27445&r=&rc=12",""]],"verses":[["لا أسْتَنيمُ إِلى الهَوانِ ولا يُرى","أمْري إِلى الوَكَلِ الجَبانِ مُفوّضا",0,"ض",2,0],["لا أَستَطيعُ عَلى السُكوتِ تَصَبُّراً","وَنَهَيتِني فَأَخافُ أَن أَتَكَلَّما",1,"م",2,1],["لا أَستَريحُ وَلا أَنساكُمُ أَبَداً","وَلا أَرى كَربَ هَذا الحُبِّ مُنكَشِفا",2,"ف",2,0],["لا أَستَزيدُ اللَهَ نُعمى","فيكَ لا بَل أَستَديم",3,"م",1,0],["لا أَستَقيدُ لِمَن دَعا لِصِب","قَسراً وَلا أَصطادُ بِالخَتلِ",4,"ل",1,0],["لا أَسرِقُ الشُعَراءَ ما نَطَقوا","بَل لا يُوافِقُ شِعرَهُم شِعري",5,"ر",2,0],["لا أسأل الله إلاَّ أن يدوم لنا","لا أن تزاد معانيهِ فقد كملت",6,"ت",1,0],["لا أسأل الله في جُهمانَ مسألةً","على الذي بيَ من مَقْتٍ له وقِلى",7,"ا",1,1],["لا أستحِلُّ الثوابَ من رجلٍ","يظلُّ يحتالُه ويجتلبُهْ",8,"ب",2,0],["لا أسْتَزِيدُكَ غيرَ إذْنِكَ أن تَرَى","مَدْحِي عَليْكَ مُحَبَّراً ومُسَيَّحَا",9,"ح",2,0],["لا أسأل الله حسن مصطبر","فإنه عنك لؤمُ مصطبرِ",10,"ر",1,0],["لا أسميه باسمه قد كفاني","أنه وحده بغيض العراق",11,"ق",1,0],["لا أسرق الشعرَ وغيري قالَهُ","يكفيني ارتجالُهُ انتحالَهُ",12,"ه",1,1],["لا أُسميه عَساهُ","لا يُرائِي بفعالِهْ",13,"ل",2,0],["لا أستثيبُ على قبولِ صيامِهِ","حسبي تصرُّمه ثوابَ قبولهِ",14,"ل",2,0],["لا استسهلت علَّةٌ بع","دَها طريقُ اللّمامِ",15,"م",1,0],["لا أَستَفِزُّكُم لِمِثلِ فُتوحِهِم","لَكِن إِلى حِفظِ البَقايا الباقِيَه",16,"ي",2,0],["لا أساويك في الخطى عند سيري","إنني ظالع وأنت ضليع",17,"ع",1,0],["لا أَستَزيدُكَ فيما فيكَ مِن كَرَمٍ","أَنا الَّذي نامَ إِن نَبَّهتُ يَقظانا",18,"ن",2,0],["لا أسميه .. وإن كان اسمه","نقرة العود .. وبوح المزرعة",19,"ع",2,0],["لا أستريحُ إلى زُورٍ ولا كَذِبٍ","يُهدَى إليه وشرُّ القولِ كاذبُه",20,"ب",2,0],["لا أَستَقِرُّ بِها إِلّا عَلى قَلَقٍ","وَلا أَلَذُّ بِها إِلّا عَلَى أَلَمِ",21,"م",1,0],["لا أَستَطيعُ نُزوعاً عَن مَوَدَّتِها","وَيَصنَعُ الحُبُّ بي فَوقَ الَّذي صَنَعا",22,"ع",2,0],["لا أَسْتَطِيعُ جُحُودَها وشُهُودُها","عِنْدِي بما أَوْلَتْ يَداه مُعَدَّلَهْ",23,"ل",2,0],["لا أَستَزيدُ حَبيبي مِن مُواتاتي","وَإِن عَنُفتُ عَلَيهِ في الشِكاياتِ",24,"ت",1,1],["لا أَستَطيعُ فِراراً","مِن بَرقِهِ وَرُعودِه",25,"د",2,0],["لا أَسعَدُ القَلبَ في هَواهُ وَلا","يَطمَعُ في عِزَّتي وَلا خَوَري",26,"ر",2,0],["لا أَستَفيقُ صَلاةً","وَلا أَفتَرُّ دَرسا",27,"س",2,0],["لا أَستَهِشُّ إِلى الصِبا","إِذ لَيسَ تَتبَعُني النَدامَه",28,"م",2,0],["لا أَستَطيعُ الهَوى وَهِجرَتَها","قَلبي ضَعيفٌ وَقَلبُها حَجَرُ",29,"ر",1,0],["لا أَستَطيعُ اِحتِمالَ الحُبِّ مُهتَجَراً","قَد كُنتُ أَضعَفَ مِنهُ غَيرَ مُهتَجَرِ",30,"ر",1,0],["لا أَستَطيعُ جَوابَكُم","وَلِغَيرِكُم قَولي عَتيدُ",31,"د",1,0],["لا أَسُرُّ الحُسّادَ فيها وَتُمسي","نَدبَةً في مَسَرَّةِ الحُسّادِ",32,"د",1,0],["لا أَسمَعُ الصَوتَ إِلّا صَوتَ جارِيَةٍ","تَدعو إِلى أَسَدٍ مِن حُبِّها شاحِ",33,"ح",1,0],["لا أَستَقيلُ زَمانِيَ عَثرَةً أَبَداً","ماشاءَ فَلَيَأتِ إِنَّ الشَهدَ كَالصابِ",34,"ب",1,0],["لا أَسأَلُ المَرءَ قَرضاً مِن شَهادَتِهِ","وَلا أَروحُ عَلى شَيبي بِمِقراضِ",35,"ض",1,1],["لا أسألُ الأيام عن","أعمالها مُعَقِّبا",36,"ب",2,0],["لا أسمِّيك صخرةَ الملتقى لكن","أُسميكِ صخرةَ المأساةِ",37,"ه",1,0],["لا أَسْتَرِيحُ إِلَى السُّلُوِّ وَلَوْ جَنَى","خِلِّي عَلَيَّ وَلا أَشِينُ وَلائِي",38,"ا",2,0],["لا أَسْتَطِيعُ بَرَاحاً إِنْ هَمَمْتُ وَلا","أَقْوَى عَلَى دَفْعِ مَا بِالنَّفْسِ مِنْ حِوَجِ",39,"ج",1,0],["لا أَستَقيدُ لِمَن دَعا لِصِباً","قَسراً وَلا أَصطادُ بِالخَتلِ",40,"ل",1,0],["لا استراح الجبان لا نام جفناه","ولا أدركت خطاه الفلاحا",41,"ح",2,0],["لا أستَغِلُّ فأنتَ لي عظةٌ","فيما أتيتَ ، وأنتَ لي زجْر",42,"ر",1,0],["لا أستطيع نزوعاً عن مودتها","أو يصنع الحب بي فوق الذي صنعا",43,"ع",2,0],["لا استريح ولا انساكم ابدا ولا كرب هذا الحب منكشفا","ما ذقت بعدكم عيشا سرت به ولا رأيت لكم عدلا ولا خلفا",44,"ف",2,0],["لا أُسميه عَساهُ","لا يُراءى بفعاله",45,"ل",2,0],["لا أُسمِّيه باسمه قد كفاني","نه وحدَه بغيضُ العراقِ",46,"ق",1,0],["لا استَظِلُّ بِجثمَانِ الرَّفيقِ إذَا","ما جَاءَ يَوماً من الأيَامِ مُحتَمَدُ",47,"د",1,0],["لا أَسألُ اللَهَ تَغييراً لِما صَنَعَت","نامَت وَقَد أَسهَرَت عَينَيَّ عَيناها",48,"ه",2,1],["لا أَستَزيدُكَ نُعمى بَعدَ وَصفِكَ لي","حَسبي اِنتِهائي إِلى هَذا المَدى حَسَبَ",49,"ب",1,0],["لا أَسأَلُ الرَحمَنَ حَظّاً فَوقَ ما","أَعطى فَقَد أَولى الجَميلَ وَأَنعَما",50,"م",2,0],["لا استحقَ به عليك إِجازةً","الشعرُ فيك يهزّني إِن قيلا",51,"ل",2,0],["لا استبيح الشعر إلا فيكم","وبه لغيرك لا يفوه لساني",52,"ن",2,0],["لا أسعدَ اللهُ مسعودا فَصَنْعَتُه","كوجِهه كلُّ قُبْحٍ منه مُخْتَصَرُ",53,"ر",1,1],["لا أستميحُ الوصلَ منك لأنه","لو ناله غيرِي لكنتُ الثاني",54,"ن",2,0],["لا أستطيع من الضنَّى شكوى الضَّنى","ويكاد ما بي أن يرقَّ لِما بي",55,"ب",2,1],["لا أَستكين من الزمان ضراعةً","كلاّ ولا أَشكو وغاه تَوَجُّعا",56,"ع",2,0],["لا استوحشت لكَ أرْبعٌ وقصورُ","وأقام ملكُكَ ما أَقام ثَبِيرُ",57,"ر",1,1],["لَا أَسْتَطِيعُ لًهُ دِفَاعاً","إِلاَّ بِمَقْدُرَةِ الْقَدِيرِ",58,"ر",1,0],["لَا أَسْتَطِيعُ غِلاَبَ لَيْثٍ","ضَارٍ لَهُ وَثْبَةُ النُّمُورِ",58,"ر",1,0],["لا أَستَميحُ الدَهرَ سَيبَ عَطائِهِ","كرماً وَلا أَمتارُ وَبلَ سَحابِهِ",59,"ب",2,0],["لا أَسْتَريحُ بِغَيْرِ لَيْلٍ أَلْيَلٍ","أَشْكُو تَطَاوُلَهُ ويَوْمٍ أيْوَمِ",60,"م",1,0],["لا أَسْمَعَ النّاعِي فَأَيْسَرُ ما جَنى","صَدْعُ الْفُؤادِ بِهِ وَوَقْرُ الْمَسْمَعِ",61,"ع",1,0],["لا أَستَريبُ بعينِ الحقِّ أَدفعُه","ولا أُرابُ بغَين الشَكِّ والريبِ",62,"ب",1,0],["لا أستريح ولا يداني","قلبي السرور مع البعادِ",63,"د",1,0],["لا أَستَجيزُ لأهلِ الفضل منقصةً","وَلا أُجازيهم سوءاً وإن ظلموا",64,"م",3,0],["لا أُستطيعُ نَشْرَهُ مَخَافَةً","عَليهِ مِن غائِلةِ الهَوَاءِ",65,"ا",2,0],["لا أَستَطيع سلوّا في الهَوى أَبَدا","وَكَيفَ يَسلوك صبّ فيك مفتتن",66,"ن",1,0],["لا أستطيعُ تَسلُّلاً من أرضِها","حتّى كأنّي في لسانِك قولُ لا",67,"ل",2,0],["لا أستطيعُ أرَى المَعالي بينكم","مَحمولةً وأرى المكارِم تقبرُ",68,"ر",1,0],["لا أستطيع أردُّه","عن ذلك القلب المصدَّد",69,"د",1,0],["لا أَستَزيد الدَهر بَعدَ لِقائِهِ","حَبي بِرؤيَتِهِ البَهيَّة سولا",70,"ل",2,0],["لا أستكين ولا ألين وقد بلا","فيما مضى صبري على الحدثان",71,"ن",1,0],["لا أستَفِيقُ من هوىً إلاّ إلى","هَوىً ولا أسلُو وإن طالَ المَدَى",72,"د",2,0],["لا أَسأَلُ الأَيّامَ تعويضاً بِكُم","لِأَنَها بِمِثلِكُم لا تَسمَحُ",73,"ح",1,0],["لا أستفيقُ من الخمار وكيفَ لي","بالصَّحْو منه وثغرك الخمَّار",74,"ر",1,0],["لا أَسأَلُ اللَّه إِلاَّ أَنْ تدومَ لنا","وقد أجابَ الدعاءَ الواحِدُ العالي",75,"ل",2,0],["لا أسألُ الأجوادَ ما عندهم","وأجتدى منكم ندى الباخلِ",76,"ل",1,0],["لا استوطأَتْ منّي مكانَكِ خُلَّةٌ","كلُّ الفؤاد نصيبُ ذاتِ الكِلّةِ",77,"ه",1,0],["لا اسْتَفْرشَتْه خفاف العيس مرقلةً","وسال سيل النَّقا في مزلقٍ عَجلِ",78,"ل",1,0],["لا أَستَطيعُ نُزوعاً عَن مَحَبَّتِها","أَو يَصنَع الحُبُّ بي فَوقَ الَّذي صَنَعا",79,"ع",2,0],["لا أَستَطيعُ الصَبرَ عَنها إِنَّها","مِن مُهجَتي نَزَلَت بِكُلِّ مَكانِ",80,"ن",1,0],["لا أستكينُ إذا ما الخَطْبُ فاجأَني","ولا ألينُ إذا مكروهُهُ صَدَعا",81,"ع",2,0],["لا أستطيع أثير قومي إنما","لي من ورا إيقاظهم آمال",82,"ل",1,0],["لا أَستَكينُ مِن المَخافَةِ فيهِمُ","وَإِذا هُمُ شَرِبوا دُعيتُ لِأَشرَبا",83,"ب",2,0],["لا أستجيز حديثها","إلا بحكم الاضطرار",84,"ر",1,0],["لا أستجيز هجاءه","أين الهجاء من الحمار",85,"ر",1,0],["لا اِستَقلّتْ من بعد فقدِكِ وَرْقا","ءٌ تُبكِّي الدّجى على الأغصانِ",86,"ن",1,0],["لا أَستطيعُ لها الشكايةَ خِيفةً","والهمُّ لا يُشكى لقلبك أَجْرحُ",87,"ح",1,0],["لا أَستَطيعُ فِراقهمْ ولربّما","فارقتُ مَن بفراقهمْ لا أسمحُ",87,"ح",1,0],["لا أستحي أن قُلتُ قَلَّ نظيرُهُ","بينَ الرِّجالِ فلستُ غيرَ مُصِيبِ",88,"ب",1,0],["لاَ أَسْتَلِذُّ العَيْشَ لَم أَدْأَبْ لَهُ","طَلَبَاً وَسَعْيَاً فِي الهَوَاجِرِ والغَلَسْ",89,"س",1,0],["لا أَسْتزيدُك فيما قد مُنِيتُ به","ولا أَسومُكَ أَمراً فيه تَغْرِيمُ",90,"م",1,0],["لا أَسمع العَذْل إِني عنه في شُغُل","عَذْلُ العواذل أَعلى رُتبةِ الهوسِ",91,"س",1,0],["لا أَسْهَرَ اللَّهُ طِرْفاً نَامَ عَنْ سَهَرِي","وَعَذَّب القَلْبَ بالأَشْجَانِ وَالفِكَرِ",92,"ر",1,1],["لا أَسْتَلِذُّ كؤُوسَ الخَمْرِ دائرةً","حَتّى أَرى كَأْسَ خَمْرِ الهَجْرِ لَمْ يَدُرِ",93,"ر",1,0],["لا أَسمَعُ الصَوتَ حَتّى أَستَديرَ لَهُ","وَحالَ بِالسَمعِ دوني المَنظَرُ العَسِرُ",94,"ر",1,0],["لا أستطيعُ بأن أعدّ فضائلا","إن رمت أحصيها فليس بممكنِ",95,"ن",1,0],["لا أسألُ اللهَ إلا حُسنَ خِدمَتِكُم","فإنَّ أخلاقَكُم لِلدّينِ أخلاقُ",96,"ق",1,0],["لا أستَكِفُّ فَقيرَ القَومِ عن جِدَتي","ولا أسُومُ غَنيَّ القَومِ إقراضي",97,"ض",2,0],["لا أستزيدُكَ يا أبا المنصُورِ مِِن","كَرَمٍ ومَدحُكَ طارفي وتَليدي",98,"د",2,0],["لا استحثك في حق عليك لها","انا الذي نام ان تيهت يقظانا",99,"ن",2,0],["لا اسفاً على ذوات اسطر","كأنها مراود الاحقاد",100,"د",1,0],["لا استردّ الإلهُ منك الذي أع","طى ولا ذُقْت بعد أمنِك عزلا",101,"ل",2,0],["لا أُسَمِّيك خَيفَةً بلْ أَعدِّي","عنك 