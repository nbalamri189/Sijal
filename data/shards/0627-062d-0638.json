{"poems":[[53,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[187,"احظر على نفسك ما تشتهي","https://www.aldiwan.net/poem43707.html","البسيط"],[271,"قوامك من رماح أبي فراس","https://www.aldiwan.net/poem35021.html","الوافر"],[454,"الحب والحسن والأمان","https://www.aldiwan.net/poem61245.html","مخلع البسيط"]],"verses":[["أَحظى المُلوكِ مِنَ الأَيّامِ وَالدُوَلِ","مَن لا يُنادِمُ غَيرَ البيضِ وَالأَسَلِ",0,"ل",1,1],["أَحظِّي كانَ سِلسِلَةً وقَيداً","وغُلاٍّ والبَيانُ لَدَى الطَّبيبِ",1,"ب",1,0],["احظُر على نفسك ما تشتهي","وعش عظيمَ القدر في الناس",2,"س",1,1],["أَحظُّ بني أميَّةَ منهُ حظِّي","وقلبي في الهوى صَعبُ المِراس",3,"س",1,0],["أحظيَ اليوم أن أراها","تعود أم فاتها الأوان",4,"ن",1,0]]}