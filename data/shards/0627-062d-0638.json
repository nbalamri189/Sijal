{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[190,"احظر على نفسك ما تشتهي","https://www.aldiwan.net/poem43707.html","البسيط"],[275,"قوامك من رماح أبي فراس","https://www.aldiwan.net/poem35021.html","الوافر"],[458,"الحب والحسن والأمان","https://www.aldiwan.net/poem61245.html","مخلع البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61124","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64907","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64892","المنسرح"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132068","الطويل"],[4729,"الحُشُّ والبَرَمُالكثيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=109451",""],[4968,"حسبي وحسبك","https://www.poetsgate.com/ViewPoem.aspx?id=206759",""],[5376,"لكل نفس ٍ اذا جادت مآثرها","https://www.poetsgate.com/ViewPoem.aspx?id=188531",""],[773,"مبنى أغر وليلة غراء","https://www.poetsgate.com/ViewPoem.aspx?id=134917",""]],"verses":[["أَحظى المُلوكِ مِنَ الأَيّامِ وَالدُوَلِ","مَن لا يُنادِمُ غَيرَ البيضِ وَالأَسَلِ",0,"ل",1,1],["أَحظِّي كانَ سِلسِلَةً وقَيداً","وغُلاٍّ والبَيانُ لَدَى الطَّبيبِ",1,"ب",1,0],["احظُر على نفسك ما تشتهي","وعش عظيمَ القدر في الناس",2,"س",1,1],["أَحظُّ بني أميَّةَ منهُ حظِّي","وقلبي في الهوى صَعبُ المِراس",3,"س",1,0],["أحظيَ اليوم أن أراها","تعود أم فاتها الأوان",4,"ن",1,0],["أَحظى بِلُقياه يَوما","في خلوة واِنفِراد",5,"د",1,0],["أَحْظاكَ مِنْه بَمَنْصِبٍ","سَوَّاكَ فيهَ وعَدَلَكْ",6,"ك",1,0],["أَحْظاهُ بالمُلْكِ ضَرْبُ أبيضَ لا","يَفرقُ بَيْنَ المُلوكِ والسَّوَقِ",7,"ق",1,0],["أَحظى بِهن وَلا رَقيب يودني","لِلّه دَهرك وَالضلال يَقودني",8,"ي",1,0],["أحظي هذا أم كذا كل عاشق","يضام فلا يعفى ويظمى فلا يسقى",9,"ق",2,0],["أَحظِي لدي من الأباعرِ","والحُدَاةُ بها تَسيرُ",10,"ر",1,0],["أحْظَى بمَعْسُولِ الرُّضَابِ مُعَتَّقََا","يُنْشِي الحَشَا مِن بَعْدِ إِعْطَاءِ الدَّوَا",11,"و",2,0],["أحظى شفاعته في نيل مغفرة","ورؤية الله بالاحسان مفضول",12,"ل",1,0],["أحظى النبيئين الكرام مكانة","وأجل من طلعت عليه ذكاء",13,"ا",2,0]]}