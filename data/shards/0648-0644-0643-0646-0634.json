{"poems":[[55,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[107,"كذلك يشقى الجامح المتعسف","https://www.aldiwan.net/poem44190.html","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10206","الوافر"],[108,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[111,"سقى الله سوحا منبتي من جنابها","https://www.poetsgate.com/ViewPoem.aspx?id=518",""],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[113,"اليلتنا هذي حكيت لياليا","https://www.aldiwan.net/poem16623.html","الطويل"],[147,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[164,"سهام مقاها فاحذروها صوائب","https://www.aldiwan.net/poem59016.html","البسيط"],[227,"طرابلس الغرب لي وطن","https://www.aldiwan.net/poem55465.html","المتقارب"],[242,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[275,"أهذا الشعر يصلح للبقاء","https://www.aldiwan.net/poem35074.html","الوافر"],[369,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[415,"قتلنا بقتلانا من القوم مثلهم","https://www.aldiwan.net/poem32194.html","الطويل"],[466,"هنيئا لأيام المواسم والتقى","https://www.aldiwan.net/poem16027.html","الطويل"],[505,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[520,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54085","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133838","الطويل"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105518","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64523","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48919","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77957","الوافر"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77975","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100969","الوافر"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131580",""],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105005","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28534","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65981","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202576","الطويل"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138779",""],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127021","الطويل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117157","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85261","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111432","الطويل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111119","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90817","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141671","الهزج"],[4613,"","https://poetry.dctabudhabi.ae/diwan/poem/101946","الطويل"],[4830,"حديثُ الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=206159",""],[1901,"أما في الناس من رجلِ رشيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=160409",""],[5136,"لعمرك ما غربتي في الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=121764",""],[5156,"خليلي لو أن هم النفو","https://www.poetsgate.com/ViewPoem.aspx?id=99173",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5939,"حبيبتي تغارُ من نفسها!","https://www.poetsgate.com/ViewPoem.aspx?id=178581",""],[5956,"النِّيلُ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=184947",""],[5956,"لقاءُ القلوبِ الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=207912",""],[5355,"أما آن الرجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87208&r=&rc=33",""]],"verses":[["وَلَكِن شَريكُ الوَحشِ في كُلِّ مَهمَهٍ","وَرِدفُ اللَيالي في الرُبى وَالأَبارِقِ",0,"ق",1,0],["ولكنْ شفائي أن يطول بقاؤه","بحيث يراني ذا ثَراءٍ وذا وفر",1,"ر",1,0],["ولكن شاعر الإسلام أعلى","وأوقع في نفوس المسلمينا",2,"ن",2,0],["ولكنّ شيخَ السُّوءِ أهلكَ نَفْسَهُ","وذُو الجهلِ يُرمَى من يَدَيْهِ ويُقْذَفُ",3,"ف",1,0],["وَلَكِن شَفعُ واحِدَةٍ بِأُخرى","يَدُلُّ عَلى فَسادِ المَنصِبَينِ",4,"ن",1,0],["ولكن شكت بعده مصرُ داءً","عُضالاً وجُرحًا عميقَ الأثر",5,"ر",1,0],["ولكن شكوى الحب للحب بثه","مزيد تباريح الجوى في عذابها",6,"ب",3,0],["ولكن شجاني معهد بان أهله","فبان الهدى في أثرهم والمكارم",7,"م",1,0],["وَلَكن شَوقي غَير شَوقي الَّذي أَرى","فَطَرفي يَقظانٌ وَقَلبيَ هاجِعُ",8,"ع",1,0],["وَلَكِنَّ شِعري لِاِرتِياحِكَ عاشِقٌ","وَما بَعُدَت يَوماً عَلى عاشِقٍ مِصرُ",9,"ر",1,0],["ولكن شقا ساقهم لمصارع","كتبن ولا ماح لما الله كاتب",10,"ب",1,0],["ولكن شرقيها شاقني","وما شاقني فيه غير ظبي",11,"ي",1,0],["وَلَكِنْ شَمَّرَتْ لأَِجْلِ ذُخْرٍ","تَحُوزُ بِهِ الْمَدَى عَنْ سَاقِ جِدِّ",12,"د",1,0],["ولكن شعرهم قد جاءَ جَزلاً","متيناً مثلَ مرصوصِ البناء",13,"ا",2,0],["ولكنّ شوقاً طارقاً حينَ ضافَنِي","إلى نازعٍ والليّلُ قد بَثَّ جُنْده",14,"د",2,0],["ولكن شَفَينا النّفس من لاعجِ الأسَى","بقتلهمُ إن كان منه شِفاءُ",15,"ا",2,0],["ولكنَّ شكري كّلَّ عن غاية المدى","وكيف يُجاري العارماتِ حسيرها",16,"ر",3,0],["ولكنْ شُجاعُ القومِ يفعَلُ نَصْلُهُ","إذاً فيه كانَ السِّرُّ لا السِّرُّ في النَّصْلِ",17,"ل",1,0],["ولكن شددتم أزره بوزارة","غدا لفظها يشتق من شدة الوزر",18,"ر",1,0],["ولكن شجا نفسي وأمرض مهجتي","وصيرني في الناس أذهل مهمومِ",19,"م",1,0],["ولكن شوق العين يترك حسرة","فينحب مكرّوب ويدمع حان",20,"ن",1,0],["ولكن شجاني ذكر رزء ابن فاطم","غداة شفى فيه ضغائنه الكفر",21,"ر",1,0],["ولكن شكر اللّه عبداً يسوقه","إلى شكر مولاه لدى كل نعمة",22,"ه",1,0],["ولكنَّ شعري نباتُ جناني","وليس لزهر جناني ذبولْ",23,"ل",1,0],["وَلكن شد من أَهواه أزري","وَقوى همتي وأمد عَقلي",24,"ل",2,0],["وَلكن شكاً في النفوس مكتم","وَعقلاً لِتكرار المآثم مظلم",25,"م",1,0],["ولكن شيبة الحمد بن عمرو","إذا استبقوا المكارم لا يسامى",26,"م",2,0],["ولكن شر ما ينتاب قوماً","مفارقة الأئمة والهداة",27,"ه",1,0],["ولكن شعري الفرد الذي صار","بمدح المهدي احجار الجواهر",28,"ر",1,0],["ولكن شجاني أن شملاً جمعته","مَعاذاَ له قد كاد أن يتبدّدا",29,"د",2,0],["وَلَكِن شَجاني أَنَّ وُدَّكَ ضاعَ مِن","يَدي وَقَد أَنفَقتُ في كَسبِهِ عُمري",30,"ر",2,0],["ولكن شماريخ الاكاليل كفرت","محياك فاجلي بعض هذي الاكالل",31,"ل",1,0],["ولكن شعري الحيَّ يطلب قارئاً","أخاف متى ما أدْعُهُ لا يلبّيني",32,"ن",2,0],["ولكن شجاني وفَتَّ الحشا","أعاجيبُ دَهرٍ بنا يَلعبُ",33,"ب",1,0],["ولكن شجاني ما جرى يوم كربلا","ولو مت من وجد به لقليل",34,"ل",1,0],["ولكن شهابٌ فإن ترمِ به","مهِمّا تجد كوكبي مستنيرا",35,"ر",2,0],["ولكن شر ما آوي","ت في لؤم وعصيانِ",36,"ن",1,0],["ولكن شهيد الحرب حي منعمٌ","فتنعيمه للروح والجسم يحصل",37,"ل",1,0],["وَلكِن شَقِيقَيَّ الوَدُودَينِ لا أَرَى","هُما كَستُرُ الرَّوَّاضُ إِن شُقَّ مِضمارُ",38,"ر",1,0],["ولكن شجتني صروف الزمان","بأهل الرشاد ولاة الزمن",39,"ن",1,0],["ولكن شأنك الأغضاء عمن","إلى دارين سافر بالزند",40,"د",1,0],["ولكن شأنهن دوام طمث","لكل أربعون من القرين",41,"ن",1,0],["ولكن شجاني ما شجاني وشفني","مصاب له في الخافقين زلازل",42,"ل",1,0],["ولكنَّ شعري كنَبضِ الفؤادِ","وحاشا لنبضِهِ أن يَكذُبا",43,"ب",2,0],["ولكن شِقوة كتبت عليهمُ","وكم غلبَ الشقاءُ على الجدودِ",44,"د",1,0],["ولكن شمائلنا ما استوت","وهل يستوي قبيح وحسن",45,"ن",1,0],["ولكن شيئاً يسمى السرور","قديماً سمعنا به ما فعل",46,"ل",1,0],["ولكن شعبي ليس يعلم ما اشتكي","وما يشتكي هذا الشديد لأجله",47,"ل",2,0],["ولكنْ شكُّها شوكٌ يُمزّقُ مهجتي غَدْرا","تظنُّ السوءَ بي دوما ولا تَتلمّسُ العُذرا",48,"ر",2,0],["ولكنَّ شأني في احتياجي كطائرٍ","يفارق أهليه لحقلٍ يسارعُ",49,"ع",1,0],["ولكنّ شِعري ركيكٌ يُحاو","لُ أن يغتدي كمرايا الضياءِ",50,"ا",2,0],["ولكن شهقة العشاق ريح","وزفرتهم كما جيش أغارا",51,"ر",2,0]]}