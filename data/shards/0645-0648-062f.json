try.dctabudhabi.ae/diwan/poem/109315","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93787","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94269","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199953","السريع"],[2949,"","https://poetry.dctabudhabi.ae/diwan/poem/145215","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109975","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45979","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83198","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[4978,"تشعير قطعة لأخناتون","https://www.poetsgate.com/ViewPoem.aspx?id=183244",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[2365,"ألم تسألا بجنوب السلام","https://www.poetsgate.com/ViewPoem.aspx?id=200657",""],[5397,"هلال دجى وشمس ضحى وفرقد","https://www.poetsgate.com/ViewPoem.aspx?id=157966",""],[5596,"مكة روحي","https://www.poetsgate.com/ViewPoem.aspx?id=206716",""],[6082,"الحب الافتراضي","https://www.poetsgate.com/ViewPoem.aspx?id=59115",""],[572,"حَسْبي مِنَ البزاة ِ والزدادِق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9407&r=&rc=264",""]],"verses":[["مَوَدَّةٌ كَالخَمرِ إِن عُتِّقَت","جادَت وَفَضلٌ باسِمُ المَشرَعِ",0,"ع",1,0],["مودّةُ نفسٍ شُبتُها بنصيحةٍ","وأنت حقيقٌ أن تُوَدَّ وتُنْصحا",1,"ح",2,0],["مودّةُ إخوانِ النبيذِ سُلافةٌ","يبولونها عند انقضاء المجالسِ",2,"س",1,1],["مَوَدَّةٌ وَعَطاءٌ مِنكَ نِلتُهُما","وَرُبَّ مُعطي نَوالٍ غَيرُ مَودودِ",3,"د",1,0],["مُؤَدٍّ إِلى السُلطانِ جُهدَ كِفايَةٍ","يَعُدُّ بِها فَرضاً عَلَيهِ مُقَدَّما",4,"م",2,0],["مؤدبا بأحسن الأداب","مختضب الأطراف بالعناب",5,"ب",1,0],["مُؤدبةٌ يُرتَضي فعلُها","ولم نزَ ليثاً سِواها أديبا",6,"ب",2,0],["مَوَدَّةٌ ذَهَبَت أَثمارُها شُبَهٌ","وَهِمَّةٌ جَوهَرٌ مَعروفُها عَرَضُ",7,"ض",1,0],["مُؤَدَّبُونَ بِآدَابِ الْمُلُوكِ فَلا","تَلْقَى بِهِمْ غَيْرَ عَالِي الْقَدْرِ مُحْتَشِمِ",8,"م",1,0],["مودعتي قفي زمناً يسيراً","فللتوديعِ للعشاقِ سَبْيُ",9,"ي",1,1],["مودعتي قفي زمناً يسيراً","ففي التوديعِ للعشاقِ سَبْيُ",10,"ي",1,1],["مُؤَدَّباً لَو كانَ مُستَعبَداً","لَم يَعبُدِ اللَهَ عَلى حَرفِ",11,"ف",1,0],["مُؤَدَّبٌ يُسرِعُ إِن دَعَيتَ","لا عَيبَ فيهِ غَيرُ عِشقِ المَوتِ",12,"ت",1,0],["مُؤَدَّبٍ ما يُصطَلى بِنارِهِ","كَالوَتَرِ المُخضَرِّ في إِمرارِهِ",13,"ر",2,0],["مُؤدَّبِ النفْسِ أكّالٍ على سَغَبٍ","لَحْمَ النّوائبِ شَرّابٍ بأنْقاعِ",14,"ع",1,0],["مَوَدّةٌ، وَعَطَاءٌ مِنْكَ نِلْتُهُما،","وَرُبّ مُعْطَى نَوَالٍ غَيرِ مَوْرُودِ",15,"د",1,0],["مودتهم فرض عظيم وحبهم","تطيب به الأخرى وتحلو به الدنيا",16,"ي",2,0],["مودة أهل البيت فرض كما يدري","وحبهم حبل السلامة في الأخرى",17,"ر",2,1],["مودِعاً في كلّ لحنٍ دامعٍ","من نشيدي أنّةَ القلبِ الرفيق",18,"ق",1,0],["مودةٌ لك لم أظفر بزينتها","تقطّع القلب في آثارها قطعا",19,"ع",2,1],["مودّةُ العين لا يزكو الوفاءُ بها","والودُّ بالقلب ليس الودُّ بالنظر",20,"ر",1,0],["مودتي لك طبع غير منتقل","وطاعتي لك طول غير مختصَر",20,"ر",1,0],["مودِعٌ في سَوادِ كُلِّ فُؤادٍ","بِتَصانيفِهِ بَياضَ وَلاءِ",21,"ا",2,0],["مَودودُ ما زلتَ مَودودَ المَآثِرِ في ال","أَنامِ لَم تَألُ بِالعَلياءِ مُضطَلِعا",22,"ع",2,0],["مَودَّةُ البَخيلِ","جهلٌ بلا تأويلِ",23,"ل",1,0],["مودَّتُهم أَجرُ النبوَّة في الورى","وَحبُّهم فرضٌ علينا محتَّمُ",24,"م",1,0],["مُوَدِّعي قَمَرٌ تَسبي إِشارَتُهُ","إِذا رَنا ساطِعُ الأَنوارِ في البَلَدِ",25,"د",1,0],["مؤدّب الأَطفال أَهدى اِمرئ","قَد أَجمَع الناس عَلى فضلِهِ",26,"ه",1,1],["مَوَدَّتُهُ تَدومُ لكلِّ هَوْلٍ","وهل كُلٌّ مَودَّتُه تَدوم",27,"م",1,0],["مُودِعينَ السُّجوفَ بِيضاً وسُمْراً","لهمُ والأكُفَّ بِيضاً وسُمرا",28,"ر",2,0],["موداته تحكيه صفواً وخبرها","كمشربه من حوبه وذنوبه",29,"ه",1,0],["موداتنا في ذا الزمان كأنها","تراها تضاهي في الخدود خلوقا",30,"ق",2,0],["مؤدبكم إلى التلف","ووالدكم فليس يفي",31,"ي",1,0],["مودةٌ ووفاءٌ منصفا وندىً","سكباً ورأياً بشافيّ السلاح عني",32,"ن",2,0],["مَوَدَّتُهُ عهْدٌ وصوْبُ بَنانِهِ","إذا صرَّحَ المحْلُ الشَّنيعُ عِهادُ",33,"د",1,1],["مَوَدَّة ذِي وُدٍّ تعرَّض دُونَه","تَشائِي نَوىً لا تُستَطاعُ طحورُ",34,"ر",1,0],["مودَّتُهمْ على مَضَضٍ وقسرٍ","وقد كَرِهوا مقاومتي دِهانُ",35,"ن",1,0],["مؤدبة الأعطاف من طول ما رأت","وما سمعت من حلمه وأناته",36,"ت",2,0],["مَوَدَّةُ المَرْءِ في الدُّنيا لحاجتِهِ","لا للصَّديقِ ولو دامَتْ إلى حينِ",37,"ن",1,0],["مَوَدَّةٌ بَيننا بالأمسِ قد غُرِسَت","واليومَ طالَبتُ ذاكَ الغَرْسَ بالثَّمَرِ",38,"ر",1,0],["مَوَدَّتُهُ تُخَامِرُ كُلَّ قَلْبٍ","فَقَدْ كَانَ الأَبَ الْبَرَّ الْحَنُونَا",39,"ن",2,0],["موَدَّتُه إثمٌ ومنظرُه أذىً","ومنزِله جَدْبٌ وراحَتُه قَحْطُ",40,"ط",1,0],["مؤدبةٌ فلم تحتجْ","لنهَّاءِ وأَمَّار",41,"ر",1,0],["مودة الناس لكم قريبة","مالم يصبكم داء أو مصيبة",42,"ه",1,0],["مؤدب الصبيان في مدرستي","وحامل الأثقال من غطرستي",43,"ي",1,0],["مَوَدة الصديق","تظهر في المَضيق",44,"ق",1,0],["مودَّةٌ لا يشينُها ملقٌ","ونيَّةٌ لا يشوبُها دَخَلُ",45,"ل",1,0],["مُؤَدٍّ في الرُكوعِ زَكاةَ مالٍ","حَوَتْهُ حِرابُه يَوْمَ الحِرابِ",46,"ب",1,0],["مَوَدَّتُكُم تُمَحِّصُ كُلَّ ذَنبٍ","وَتُقرَنُ بِالصَلاةِ وَبِالصِيامِ",47,"م",1,0],["مودعات طباؤها ومهاها","بالمغاني غزلانها والفرارا",48,"ر",2,0],["مُؤَدَّبُ الأَعضاءِ مُستَحسَنٌ","ماشِينَ بِالبُهرِ وَلا بِالجِماح",49,"ح",1,0],["مودعاً جنة قد أشبهت ارما","ذات العماد وفاقتها مقاصيرا",50,"ر",2,0],["مودتهم فرض علينا وحبهم","يقام به ما كان من ديننا أعوجا",51,"ج",2,0],["مؤديا لحق فرض الخدمه","لصاحب العليا ولي النعمه",52,"ه",1,0],["مودِّع أنا ومستقبل","والضيف والقادم والراحلُ",53,"ل",1,0],["مؤدب يشبه طولاً مئذنا","قد جاءنا يسلبنا تلميذنا",54,"ن",2,1],["مُؤَدِّباً طَرَفَيهِ بالقُنوتِ فلم","يَنكَر عليهِ جميلَ الصَونِ ناكرُهُ",55,"ر",2,0],["مودة النجيل","جهل بلا تأويل",56,"ل",1,0],["مودع في كرائم من كرام","عن سفاح تنزهوا وخناء",57,"ا",2,0],["مَوَدَّتُهُم قُربى وَحُبُّهِم تُقى","وَرُؤيَتُهُم رَوضٌ بِهِ العَينُ قَرَّتِ",58,"ت",1,0],["مُؤدِّبٌ لا يُصغِرُك","وَمُحسِنٌ لا يَحقِرك",59,"ك",1,0],["مودَّة ناصر الدين المفدَّى","صفت لك وهو أهلٌ للصفاء",60,"ا",2,0],["مودعَ النطفة أصلاب الرجالِ","رازقَا في الرحْمِ معدوم المِحالِ",61,"ل",1,1],["مودعات على أميرهم غلا","ففي الروع وزنهم مرجوح",62,"ح",1,0],["مودته أجره فيهم","على الوحي فرضا بحكم الحكم",63,"م",1,0],["مودته بآي الذكر أجر","ومن لم يرض فيها فهو مرتد",64,"د",1,0],["مودّعاً وكأني لم أزُرْ أبداً","كأنما العين تغريني بتلويح",65,"ح",1,0],["مودي يا مجدي مكتئبٌ","قل كيف سينجو بمُديار",66,"ر",1,0],["مؤدبٍ مدرّب الخلائِقِ","أصيَدُ من معشوقة ٍ لعاشِقِ",67,"ق",1,0]]}