https://www.poetsgate.com/ViewPoem.aspx?id=182276",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5956,"العين بالعين..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183739",""],[5956,"صورة من رضاء الأبوين","https://www.poetsgate.com/ViewPoem.aspx?id=192575",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[5956,"لبتر أسباب الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=194895",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[6003,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200570",""],[6070,"أَضَفْتَ إلى سنينَ العمر ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=188673",""],[6115,"شعر النظم أحساس شاعر وفكره","https://www.poetsgate.com/ViewPoem.aspx?id=196452",""],[6115,"سامحوا والله مسامح وسامحكم","https://www.poetsgate.com/ViewPoem.aspx?id=196474",""],[6144,"جهل فقر مرض","https://www.poetsgate.com/ViewPoem.aspx?id=152334",""],[6225,"عَولَمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80968&r=&rc=237",""],[6225,"عَوْلمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81105&r=&rc=299",""],[6225,"القطار المُحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80899&r=&rc=168",""],[463,"أروم الوفاءَ الصعبَ بالمطلبِ السهلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60203&r=&rc=259",""],[463,"فكاكك أيها القلبُ الأسيرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60055&r=&rc=111",""],[454,"يزهو القريض به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82684&r=&rc=48",""],[6300,"حياتي كذبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82859&r=&rc=30",""],[4222,"قد أضاء الزمان بالمستضيء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52712&r=&rc=4",""]],"verses":[["وَأَحلَمُ خَلقِ اللَهِ حَتّى إِذا دَنا","إِلَيها الأَذى طارَت بِها جَهَلاتُها",0,"ت",3,0],["وَأَحلُمُ ثُمَّ يُدرِكُني إِبائي","وَكَم يَبقى القَرينُ عَلى الجِذابِ",1,"ب",1,0],["وأحلم ، حيث الرؤى ترتمي","على غابة ، من لهاث النباح",2,"ح",1,0],["وأحْلَلْتَني للأمانِ حِمىً","رَمَيْتُ بِها منْ فؤادي الجِمارا",3,"ر",2,0],["وأحَلّني منْ دَيْرِهِ في هَضْبَةٍ","تنْحَطُّ عَنْها الشُّهْبُ في الأبْراجِ",4,"ج",1,0],["وَأَحْلَى مِنَ الْعُتْبَى وَأَشْهَى مِنَ الرِّضَى","إِذَا جَاءَ مِنْ بَعْدِ الْقَطِيِعَةِ وَالْعَتْبِ",5,"ب",1,0],["وَأَحلَمُ مِن قَيسٍ وَأَجرَأُ مُقدَماً","لَدى الرَوعِ مِن لَيثٍ إِذا راحَ حارِدا",6,"د",2,0],["وَاِحلَم وَإِن سَفِهَ الجَليسُ وَقُل لَهُ","حُسنَ المَقالِ إِذا أَتاكَ بِهُجرِهِ",7,"ر",2,0],["وأحلف ما في الدهر مثل عليه","ويحلف أهل العصر ما أنا حانث",8,"ث",1,0],["وأحلتَ في بيت وما","زِلتَ البعيد من الإصابهْ",9,"ب",2,0],["وَأَحلى مِنَ السَقفِ المُزَخرَفِ بِالدُمى","فَضاءٌ تَشِعُّ الشُهبُ فيهِ رَحيبُ",10,"ب",1,0],["وَأَحلِبُ الثَرَّةَ الصَفِيَّ وَلا","أَجهَدُ أَخلافَ غَيرَها حَلَبا",11,"ب",2,0],["واحْلُمْ بفجرِ اللَّيالي فَفَجْ","رُهَا في هُجُوعِكْ",12,"ك",1,0],["وَأَحلى الهَوى ما شَكَّ في الوَصلِ رَبُّهُ","وَفي الهَجرِ فَهوَ الدَهرَ يُرجو وَيُتَّقي",13,"ق",2,0],["وَأَحلُمُ عَن خِلّي وَأَعلَمُ أَنَّهُ","مَتى أَجزِهِ حِلماً عَلى الجَهلِ يَندَمِ",14,"م",1,0],["وأحلك الشعر الحضيض","وكنت في أعلى محل",15,"ل",1,0],["وأَحلَّه الشرفُ الرفيعُ هِلالَه","فغَدا وراحَ به هِلالاً مَاثِلا",16,"ل",2,0],["وأحلَّني جَدواه ذُروَةَ شاهِقٍ","مُتَمَنِّعٍ صَعْبِ المَرامِ مُنيفِ",17,"ف",1,0],["وأحلَّها من قلبِ عاشِقِها الهوى","من وعدِها الممطولِ لَمْعَ سَرابِ",18,"ب",1,0],["وأَحلَّني عِزُّ الأميرِ مَحلَّةً","لو رامَني فيها الزَّمانُ تهيَّبا",19,"ب",2,0],["وَاِحلُل عُرى نَومِكَ عَن مُقلَةٍ","تُقِلُّ أَلحاظاً مِراضاً صِحاحِ",20,"ح",1,0],["واحللْ عُرَى نومكَ عن مُقلَةٍ","تَمْقُلُ أحداقاً مِراضاً صحاح",21,"ح",1,0],["وَاحلُل رِحالَكَ وَانزِل نَحوَ سُدَّتِهِ","فَإِنَّها عصمَةٌ مِن أَوثَقِ العِصمِ",22,"م",1,0],["وَاحْلُمْ كَأَنَّكَ جَاهِلٌ وَاذْكُرْ كَأنْ","نَكَ ذَاهِلٌ وَافْطُنْ كَأَنَّكَ غَافِلُ",23,"ل",1,0],["واحلوا ومروا سادتي","فالصبرُ قاصٍ قاصرُ",24,"ر",1,0],["وَأَحَلّوا مِن مَراكِزِهِم","وَاِستَطارَت خَيلُهُم بِهِمِ",25,"م",1,0],["وَأَحلامٌ إِذا طُلِبَت إِلَيهِم","وَلَيسوا يُعجِلونَ بِها إِناها",26,"ا",3,0],["وَأَحلى مِنَ التَمرِ الجَنِيِّ وَعِندَهُ","بَسالَةُ نَفسٍ إِن أُريدَ بَسالُها",27,"ل",3,0],["وأَحَلَّهُ الشَّرَفَ الرَّفِيعَ ذَكاؤُهُ","فرَأَيْتُ منهُ عطارِداً في السُّنْبُلَهْ",28,"ل",2,0],["وَاحلُم إِذا نَطَقَ السَفي","هُ فَمَن يَرِد شَرّاً فَرِده",29,"د",2,0],["وَأَحلِفُ ما الإِنسانُ إِلّا مُذَمَّمٌ","أَخو الفَقرِ مِنّا وَالمَليكُ المُحَجَّبُ",30,"ب",1,0],["وَأَحلِفُ ما ضَرَّ الكَريمَ ظُهورَهُ","مَعَ الرَهطِ يَمشي في القَميصِ الشَبارِقِ",31,"ق",1,0],["وَأَحلِفُ ما الدُنيا بِدارِ كَرامَةٍ","وَلا عَمَرَت مِن أَهلِها بِكَريمِ",32,"م",1,0],["واحْلُلْ وشاحَ الكَعابِ رِفقاً","واحذَرْ على خَضرِها الرَّقيقِ",33,"ق",1,0],["وأحلَمُ من يمشي مع الناس صافحٌ","إذا سبه الجهال قال سلاما",34,"م",2,0],["واحلُمِي بالحياة من نغمِ الخلْ","دِ وخمْرِ الهوى وزهرِ الشبابِ",35,"ب",1,0],["وأحلامُ دنيا وأشواقُها","لروحين بعد الضَّنى والرَّهَقْ",36,"ق",1,0],["وأحلف لا عانقتها ولقد غدا","لها أثرٌ ما بين كفي ومعصمي",37,"م",2,0],["وأحلف ما حطت مكانك غربة","ولا سودت علياك أثوابك السحم",38,"م",1,0],["وَأَحَلَّ البَيَانَ وَالعِلْمَ في الأَوْجِ","الَّذِي حَلَّهُ مِنَ العلْيَاءِ",39,"ا",2,0],["وَأَحَلَّ الوَقَارُ أَدْنَى مَعَانِي","هَا مَحَلَّ السَّمَاءِ فَوْقَ الظُّنُونِ",40,"ن",1,0],["وأحلى من العُتبى وأشهى من الرِّضا","إذا جاءَ من بعدِ القطيعَة ِ والعتْب",41,"ب",1,0],["وأحللتني للأمان حمى","ورميت بها من فؤادي الجمارا",42,"ر",2,0],["وأحْلَلْناه وهو ضريحُ شعبٍ","محلَّ الوَحْيِ جاءَ من الضُّراح",43,"ح",1,0],["وأحلامنا منها صحيح وكاذب","وأيامنا منهن معط ومانع",44,"ع",1,0],["وَأَحلي جيد الزَمان بعقد","نَظمتهُ يد القَريحة مَدحا",45,"ح",2,0],["وأحل مقال الشيخ","إِن أفتى بحرمتها عليه",46,"ي",2,0],["وأحلامي وآمالي","وأيام الهوى العذبة",47,"ب",2,0],["وأحلّنا في دار عزٍّ دائمِ","وانتاشنا مِنْ نارلِ الحدثان",48,"ن",1,0],["وأحْلَى من الشهد المشوب بسَلْسَلٍ","وأعذب من ريقِ الحبيبِ وأطيبُ",49,"ب",1,0],["وأحلتمُ قلبي على أخلاقكم","فإذا السُّلافة والزلالُ الباردُ",50,"د",1,0],["وأحلف أيماناً أؤكد بعضها","ببعض لينفي عن مقالتي الوشبُ",51,"ب",1,0],["واحلُبْ مآقِيَ عَيْنٍ طالما قَصَرَتْ","حُمْرَ الدُّموعِ على البيضِ المَقاصيرِ",52,"ر",1,0],["وَأَحلَمُ مِن قَيسٍ إِذا الحِلمُ لَم يُشِن","عُلاهُ وَلَم يُغرِ العِدا بِجنابِهِ",53,"ب",2,0],["وَأَحَلَمُ مِن قَيسٍ إِذا الحِلمُ لَم يَرُح","يُطَوِّقُ عاراً أَو يُمَوِّقُ جاهِلا",54,"ل",2,0],["وأحلامي إذا ما عَربَدَت","كأسي تُغَنّيها",55,"ي",3,0],["وأحلى الحبِّ ما كانَ","ولم يعلم بهِ الناسُ",56,"س",1,0],["وأحلى من أولئكَ في عيوني","بأرياف القرى نظرُ القطيعِ",57,"ع",1,0],["وأحلى المنى عممان الهوى","إذا ما اختُلسنَ خلال البُهم",58,"م",1,0],["وأحلى الهوى ما ليسَ يُدْرَكُ وَصْلُه","وخيرُ حبيبٍ بالوعودِ مَطُولُ",59,"ل",1,0],["وَأحِلّيهِ حيث تفتقِد البَد","رَ عيونُ السُراةِ في الظُلماء",60,"ا",2,0],["وأحلها زمر الملائك خضعاً","لجلاله من ساجد ومناجي",61,"ج",2,0],["وَأَحَلَّها البَينُ المُشِتُّ مَحَلَّةً","بَعِدَت مَراميها وَعَزَّ مَرامُها",62,"م",3,0],["وَاِحلُل عُقودَ الدَمعِ بي","نَ مَلاعِبِ الحَيِّ الحُلولِ",63,"ل",1,0],["وَأَحَلَّني في وارِفٍ","مِن ظِلِّ دَولَتِهِ ظَليلِ",63,"ل",1,0],["وَأَحلامٌ إِذا الأَطوادُ طاشَت","رَسَت وَلَها السَكينَةُ وَالوَقارُ",64,"ر",1,0],["وَاحْلُلْ بِهَا وَخَلاَكَ ذَمٌّ","مَبَانِياً لِلْهُدَى مَرْصُوصَهْ",65,"ص",2,0],["وَاحْلُلْ بِهَا عَقْدَ الأَسَى","وَافْلُلْ بِهَا حَدَّ الأَسَفْ",66,"ف",1,0],["وأَحِلَّها المهدَ الوثيرَ ودَاوِها","مِمّا بها فَلأنتَ أحكمُ آسِ",67,"س",1,0],["واحلم الا في امور يسيرة","يرى العقل فيها الحلم ضربا من الجهل",68,"ل",1,0],["وأحلها بمواكب طلعت بها","خرصان عثيرها فهن كواكب",69,"ب",1,0],["وَأَحلى الهَوى ان مت في اسر حبكم","فَكَم من أَسير في للصبابة لا يفدى",70,"د",2,0],["وَأَحْلى ما ظَفِرْتَ بهِ وِصالٌ","إِذا هُوَ لَمْ يَشِنْهُ الانْتِظارُ",71,"ر",1,0],["واِحلَم عن الخُدّام","في الفِعل والكَلام",72,"م",1,0],["وَأَحلو لَهُ الإِدارَةَ لِمّا","في نُمُوِّ رَأَوا هُناكَ هِلالَه",73,"ل",2,0],["وَأَحلُمُ في شِعري فَلا أَنطِقُ الخَنا","وَيَدرَأُ عَنّي شِعرَ ذي الحِرَّةِ العِضِّ",74,"ض",1,0],["وأحلامَ الصبا","المحروم أطويها وتطويني",75,"ي",1,0],["وَأَحَلَّني بِعُلُوِّ هِمَّتِهِ","فَوقَ الَّذي تَسمو لَهُ هِمَمي",76,"م",2,0],["واحْلُلْ مَهبَّ الريحِ من أصداغهِ","يَستَغْنِ قَومُك أن يَؤُمُّوا تُبَّتا",77,"ت",2,0],["وأحلمُ ذي بُرْدٍ لدى عَقْدِ حُبْوةٍ","وأكرَمُ ذي رِفْدٍ غَداةَ حِباء",78,"ا",2,0],["وَأَحلامُكُم لَو ناسَبَ النَيلُ فَضلَها","لَما كانَ مِنها وَزنَ حَبَّةِ خَردَلِ",79,"ل",1,0],["وَأَحلت دَمعي أَحمَراً","يَجري عَلى متورس",80,"س",1,0],["واحلق وطف للإفاضة بعده السعي تال","وغير وقفتك فافعل عمرتك في المثال",81,"ل",1,0],["واحلموا بالطيور في ظلل الأغ","صان بين التحليق والتغريد",82,"د",1,0],["وأحلّني دارَ المقامةِ خالداً","في ظلّ ملك دائمٍ وأمانِ",83,"ن",1,0],["وأحللتم ما حرم اللّه جهرة","وشر ذنوب الخلق ذَنب المجاهر",84,"ر",1,0],["وأحَلّ بالإفرنجِ في","بَرٍّ وفي بحرٍ نَكالاَ",85,"ل",2,0],["وأحلاهمُ في وابل الجود صيّباً","وأعلاهمُ في قُلَّة المجد منصبا",86,"ب",2,0],["وَاِحلَم إِذا جَهَلَت عَلَيكَ غُواتُها","حَتّى تَرُدَّ بِفَضلِ حِلمِكَ جَهلَها",87,"ل",3,0],["واحلل عزالي أدمعِ","تستضحك الزهر المندّا",88,"د",2,0],["واحلل ببحر نوال طاب موردهُ","وظل عدل على الأيام ممدود",89,"د",1,0],["واحلل عرى دمعك المقصود في دمق","قد أقفرت بعد بين الخرّد العرُبِ",90,"ب",1,0],["وأحلى الهوى ما رحت فيه مغازلاً","أرى غير ما أهوى لنيل الذي أهوى",91,"و",2,0],["وأحلى ما لقيت من الليالي","عشية بي لكم لقي العصي",92,"ي",1,0],["وأحلت للهوا فيه المسير","وبه عين لها شرح يطول",93,"ل",1,0],["وأحلت بلقعها اليباب حدائق","بكرومها ونخيلها تتأنق",94,"ق",1,0],["وأحل هزائمنا لنصر كاذب","يرضي هنالك سذج الأذواق",95,"ق",1,0],["وأحلُمُ إشفاقا وللبين أنّةٌ","يبينُ عليها الطائشُ المتحلِّمُ",96,"م",1,0],["وأحلوا ولي بين الضلوع مرارةٌ","لصماءَ منكم لا تُمِرُّ ولا تُحلي",97,"ل",2,0],["وأحلفُ أنَّى شُعشعتْ لي بكفِّه","سلوتُ سوى همٍّ لقلبي محالفِ",98,"ف",1,0],["وأحلُمُ والمطايا يقتضيها","دُوَينَ حنينها الحادِي الطَّروبُ",99,"ب",1,0],["وأحلَّ منك دنيَّةُ ذا منْطقٍ","فصلٍ إذا ما قال غير مجمجمِ",100,"م",1,0],["واحلم فإن الحلم من ذي قُدرة","رأسُ العُل وثناء كل مُفضَّلِ",101,"ل",1,0],["وأحْلاف مجدٍ موجفينَ إِلى العُلى","لهم من قُصيٍّ انتسبوا رهطُ",102,"ط",1,1],["واحْلَوْلكَ اليومُ المُضيئة شمسهُ","فالظُّهْرُ جُنْحٌ غيرُ ما مُنْجابِ",103,"ب",1,0],["وأحْلامهمْ في المُجْلِباتِ رزينةٌ","وسُحْبهم في المكْرماتِ سِجام