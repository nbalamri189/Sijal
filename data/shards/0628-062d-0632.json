{"poems":[[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[47,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[151,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87281","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63981","المتقارب"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80201","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46518","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35756","الهزج"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28875","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129463","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129384","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92014","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86535","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86529","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133258","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44727","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54414","الطويل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89585","الطويل"],[4984,"وقع الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=180120",""],[4119,"نزلنا على القصب السكري","https://www.poetsgate.com/ViewPoem.aspx?id=16082",""],[5266,"لُبُّ الأَسَى","https://www.poetsgate.com/ViewPoem.aspx?id=210745",""],[5411,"عَوَّدْتُ عَيْني","https://www.poetsgate.com/ViewPoem.aspx?id=200581",""],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[5851,"ضوء قراح","https://www.poetsgate.com/ViewPoem.aspx?id=175304",""]],"verses":[["بحزم ليس من قال وقيل","وعز ليس بالرجل العليل",0,"ل",1,0],["بِحَزمٍ يُجَلّي الدُجى وَالعَمى","وَعَزمٍ يُقيمُ الصَغا وَالصَعَر",1,"ر",1,0],["بحزنٍ وتلحين تجاوبتا بما","تذوب له الأكباد والجلمد الصخر",2,"ر",1,0],["بِحَزم ثابت الأَصلِ","وَعزمٍ جابر الكسرِ",3,"ر",1,0],["بحزِّ قواف تحزُّ القفا","وَشرْطٍ يتابعُهُ الشَّارط",4,"ط",1,0],["بِحَزمكَ تَمنَحُ الأَنام حِلماً أَرقُّ","مِن النَسيم عَلى الغُصونِ",5,"ن",1,0],["بحزمة عَظيمة مِن العَلف","يأكلها وَقالَ ثق وَلا تَخف",6,"ف",1,0],["بحزر لا إله إلا اللّه","وحرز أسمائك عجل المدد",7,"د",1,0],["بِحَزمٍ يَلِدُ العَزمَ","وَبَعضُ الجِسمِ مِن بَعضِ",8,"ض",1,0],["بِحَزمِ الأَنعَمَيْنِ لَهُنَّ حادٍ","مُعَرٍّ ساقَهُ غَردٌ نَسولُ",9,"ل",1,1],["بحزمك اذ رمت المعالي ولم يكن","يروم المعالي قاعداً غير قاسم",10,"م",1,0],["بحزم اذا ما قارع الدهر غربه","مضى حده وانقاد طوعا له الدهر",11,"ر",1,0],["بحزني على الشهم السعيد بن عودةِ","سَعيدٌ نَعَمْ نِعْمَ السعيدُ بجنة",12,"ه",1,0],["بحزمك لم تؤخذ عليك سياسةً","بأمرٍ ولم يطعن عليك مقال",13,"ل",1,0],["بحزب الائتلاف الحر أمسى","محيا الملك وضاح الجبين",14,"ن",1,0],["بحزم وعزم ثابت الجاش راجح","وصدق يقين راسخ لا يزايله",15,"ل",2,0],["بِحَزمٍ بِه فَجرٌ وَمَجدٌ تَأَصَّلا","فَمُختَرعٌ نَحو السَحابِ تَوَصَّلا",16,"ل",2,0],["بحزمٍ لأَسرارِ المقاديرِ مُقتض","وعزمٍ لأبكارِ الحوادثِ مُفْتضِّ",17,"ض",1,0],["بِحَزمي وَعَزمي نِلتُ مَجداً أَسما السَما","بِصَبري وَجِدّي لي هِباتُ الجَلائِلُ",18,"ل",1,0],["بحزن عميق أو ببهجة خاطر","بها شبه مما بمكنونه نعت",19,"ت",1,0],["بحز كحز رقاب العدى","ومص كمص شفاه الأحبه",20,"ه",1,0],["بِحُزْنٍ لِديكِ الْجِنّ أَرْخَى سُدُولَهُ","عَلى قَلْبِيَ الْمَأْسُورِ بَيْنَ الْمَوَاجِعِ",21,"ع",1,0],["بحُزْمَةٍ مِنْ بَقايا الوَرْدِ أمْ باقَهْ","عَلَّقْتَ لي بِ \" فُنون الشِّعْر عِمْلاقَهْ \"",22,"ق",2,1],["بحزم ولطم فيه تقطيع الارقاب","وعزم جلاميد الصخر منه ذايب",23,"ب",1,0],["بحزن قلبي بأنّاتي بأمنيتي","بليل صمتي بتغريبي أخاطبهُ",24,"ب",2,0]]}