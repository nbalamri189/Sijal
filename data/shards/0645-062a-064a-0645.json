px?id=200506",""],[5277,"معارضة قصيدة عبدالرزاق عبدالواحد","https://www.poetsgate.com/ViewPoem.aspx?id=205147",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[5358,"حبات الزجاج","https://www.poetsgate.com/ViewPoem.aspx?id=21760",""],[5368,"أنين الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=184141",""],[475,"مَتَى مَا أَقُلْ فِي آخِرِ الدَّهْرِ مِدْحَة ً","https://www.poetsgate.com/ViewPoem.aspx?id=20662",""],[5431,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=186521",""],[5563,"دعوها فإنَّها مأمورة","https://www.poetsgate.com/ViewPoem.aspx?id=214572",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5785,"متى متى يا قرة النواظر","https://www.poetsgate.com/ViewPoem.aspx?id=131564",""],[5791,"غزلٌ فتيّ ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208173",""],[5873,"عيش الفخار","https://www.poetsgate.com/ViewPoem.aspx?id=215435",""],[5901,"حب أسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=204534",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5948,"متى ما تسمعي بقتيلِ عشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=100606",""],[5952,"غنائي ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=205982",""],[5956,"هلال ونجمة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182427",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5956,"يُنَغّصُ عيشي","https://www.poetsgate.com/ViewPoem.aspx?id=183740",""],[5956,"لقد عاد الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=183971",""],[5956,"يهلّ الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=192922",""],[5956,"إذا ضعفُ عينيَّ لم يستبِنْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=194206",""],[5956,"إن كان لا يُعطيك شعري بعضُهم","https://www.poetsgate.com/ViewPoem.aspx?id=194702",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[6031,"أَلاَ هَلْ تجاوَزْتَ الخِباءَ المحجَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=46274",""],[6056,"طري العود","https://www.poetsgate.com/ViewPoem.aspx?id=130346",""],[6056,"بنت رسلان","https://www.poetsgate.com/ViewPoem.aspx?id=130379",""],[6056,"أطرش الزفة","https://www.poetsgate.com/ViewPoem.aspx?id=130513",""],[6068,"رَأَيْتُ الْشَّوْق يأكُلُ مِن عِقَاليِ -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175789",""],[6068,"خليليّ ما خافٍ عليّ هواكما","https://www.poetsgate.com/ViewPoem.aspx?id=180640",""],[186,"أحبابنا هل لذاك العهد تذكار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55768&r=&rc=31",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[4035,"أغارَ الحُسنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1522&r=&rc=5",""],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""]],"verses":[["مُتَيَّمٌ بِالعُلى وَالمَجدُ يَألَفُهُ","وَما مَشى في نَواحي خَدِّهِ الشَعرُ",0,"ر",1,0],["مَتى ما أزُرْها ألْقَ عِندَ خِبائِها","أُشَيْعِثَ يَحمي بالقَنا حَوزَةَ الدّارِ",1,"ر",1,0],["مَتى ما تَلقَني فَردَينِ تَرجُف","رَوانِفُ أَليَتَيكَ وَتُستَطارا",2,"ر",2,0],["مَتَى مَا تَرَّقَ الْعَيْنُ فِيهِ تَسَهَّلَتْ","فَمِنْ أَسَدٍ حَامٍ وَمِنْ عَمَدٍ سَامِي",3,"م",2,0],["مَتى ما تُناخي عِندَ بابِ اِبنِ هاشِمٍ","تُريحي وَتَلقَي مِن فَواضِلِهِ يَدا",4,"د",2,0],["مَتى ما تَشَأ تَسمَع إِذا ما هَبَطتَهُ","تَراطُنَ سِربٍ مَغرِبَ الشَمسِ نازِلِ",5,"ل",1,0],["مَتى ما أَقُل في آخِرِ الدَهرِ مِدحَةً","فَما هِيَ إِلّا لِاِبنِ لَيلى المُكَرَّمِ",6,"م",1,0],["مَتى ما تَنالا بِيَ الأولى يَقصِبونَها","إِلَيَّ وَلا يُشتَم لَدَيَّ حَميمُها",7,"م",3,0],["مَتى ما تُوازِن ماجِداً يُعتَدَل بِهِ","كَما عَدَّلَ الميزانَ بِالكَفِّ راطِلُه",8,"ل",2,0],["مَتى ما تُذَوِّقهُ التَجارِبُ صاحِباً","مِنَ الناسِ تَردُدهُ إِلَيكَ التَجارِبُ",9,"ب",1,0],["مَتى ما يُواكِفها اِبنُ أُنثى رَمَت بِهِ","مَعَ الجَيشِ يَبغيها المَغانِمَ تُثكَلِ",10,"ل",1,0],["مَتى ما اِلتَوى بِالظاعِنينَ نَزيعُ","فَلِلعَينِ غَربٌ وَالفُؤادِ صُدوعُ",11,"ع",1,1],["مَتى ما تَنجَلِ الغَمَراتُ يَعلَم","هُرَيمٌ وَاِبنُ أَحوَزَ ما أُلاما",12,"م",2,0],["مَتى ما أَشَأ أَسمَع عِراراً بِقَفرَةٍ","تُجيبُ زِماراً كَاليَراعِ المُثَقَّبِ",13,"ب",1,0],["مَتى مايَدنُ مِن أَجَلٍ كِتابي","أَمُت بَينَ الأَعِنَّةِ وَالأَسِنَّه",14,"ن",2,0],["مَتى ما تَزِنّا مِن مَعَدٍّ بِعُصبَةٍ","وَغَسّانَ نَمنَع حَوضَنا أَن يُهَدَّما",15,"م",2,0],["مَتى ما نَسِم لا يُنكِرِ الناسُ وَسمَنا","وَنَعرِف بِهِ المَجهولَ مِمَّن نُكايِدُ",16,"د",1,0],["مَتى ما يَقُل لا يَكذِبُ القَولَ فِعلُهُ","سَريعٍ إِلى الخَيراتِ غَيرَ قَطوبِ",17,"ب",1,0],["مَتى ما دَعَت سَفَهاً وَيحَها","بِعَولَتِها وَالمَنايا تَجي",18,"ج",2,0],["متيَّماً نصلت فوداً شبيبته","وقلبه من حدادِ الحزن ما نصلا",19,"ل",2,0],["متيَّمة بالعلى نفسهُ","وعين السهى تحتها ساهيه",20,"ي",2,0],["مُتيمِّمات سَمْتَ وجهٍ واحد","ولها مطالع جمَّةٌ ومَجاري",21,"ر",2,0],["متى ما يَجُد يوماً سواك فإنه","بخيلٌ عصته من يديه عواصي",22,"ص",2,0],["متيماً بالعلا أخا شعفٍ","يخطبُ أبكارها ويفترع",23,"ع",1,0],["متى ما انشامَ في غيبٍ صوابٌ","نعاه ابن الحسين فلا انشيامُ",24,"م",1,0],["مَتى ما تَشَأ أَحمِلكَ وَالرأسُ مائِلٌ","عَلى صَعبَةٍ حَرفٍ وَشيكٍ طُمورُها",25,"ر",3,0],["مَتى ما يَلقَني وَمَعي سِلاحي","يَخِرَّ عَلى القَفا وَلَهُ نَخيرُ",26,"ر",1,0],["مَتى ما يُجدِ نائِلَهُ عَلَينا","فَلا بُخلاً تَخافُ وَلا اِعتَذارا",27,"ر",2,0],["مَتى مَلَكتُم أَلسُنَ الأَربابِ","قَد كانَ هَذا قَبلَ فَتحِ البابِ",28,"ب",1,0],["مَتى ما اِزدَدتُ مِن بَعدِ التَناهي","فَقَد وَقَعَ اِنتِقاصي في اِزدِيادي",29,"د",2,0],["مَتى ما يُشِر نَحوَ السَماءِ بِوَجهِهِ","تَخِرَّ لَهُ الشِعرى وَيَنخَسِفِ البَدرُ",30,"ر",1,0],["متى ما تَلْقَ دهْرَكَ وهو حربٌ","فإِن أخاك درعُكَ والحُسَامُ",31,"م",1,0],["متى ما نَبَا دهرٌ نَبَوا وتصَّرفُوا","على حالتَيْه جَيْئَةً وذَهابَا",32,"ب",2,0],["مَتى ما يَشِد مَجداً يَشِدهُ بِهِمَّةٍ","تَقَيَّلَ فيها ماجِداً بَعدَ ماجِدِ",33,"د",1,0],["مَتى ما أُسَيِّر في البِلادِ رَكائِبي","أَجِد سائِقي يَهوي إِلَيكَ وَقائِدي",33,"د",2,0],["مَتى ما أَصِف أَخلاقَكَ الغُرَّ تَعتَرِض","غَرائِبُ أَفعالٍ تَزيدُ عَلى الوَصفِ",34,"ف",1,0],["مَتى ماثَنَوا أَعناقَهُم نَحوَ فِتنَةٍ","يَكُن بِالسُيوفِ الماضِياتِ اِعتِدالُها",35,"ل",3,0],["مَتى ما أَعِد نَفسي عَلَيهِ رَغيبَةً","أَكُن آمِناً مِن لِيِّهِ وَاِعتِلالِهِ",36,"ل",2,0],["مَتى ما أَرادوا أَن يَقولوا حَدا بِها","مِنَ الشِعرِ لَم يَقدِر عَلَيهِ مُريدُها",37,"د",3,0],["مَتى ما يَمُت عانيكِ يا لَيلِ تَعلَمي","مُصابَةَ ما يُسدي لِعانيكِ نائِرُه",38,"ر",2,0],["مَتى ما تَرِد يَوماً سَفارِ تَجِد بِها","أُدَيهِمَ يَرمي المُستَجيزَ المُعَوَّرا",39,"ر",2,0],["مَتى ما تُكَلِّفها مَآبَةَ مَنهَلٍ","فَتُستَعفَ أَو تُنهَك إِلَيهِ فَتَجهَدِ",40,"د",1,0],["مَتى ما يُرِد ذو العَرشِ أَمراً بِعَبدِهِ","يُصِبهُ وَما لِلعَبدِ ما يَتَخَيَّرُ",41,"ر",1,0],["مُتَيَّمٌ لا تَهتَدي عُوّادُهُ","إِلّا بِما تَسمَعُ مِن أَنينِهِ",42,"ن",2,0],["مُتَيَّمٌ لَيسَ لَهُ ناصِرٌ","أَوَّلُ مَن عاداهُ سُلوانُه",43,"ن",2,0],["مَتى ما تَستَمحِها السَيرَ تُترِع","لَنا سَجلَ الذَميلِ إِلى العَراقي",44,"ق",2,0],["متى ما عدلْتَ إلى راجعٍ","عنِ البكرِ ندَّمَكَ السامعُ",45,"ع",1,1],["مَتى ما اِنتَضَلنا بِالسِهامِ نَضَلتُهُ","وَإِن نَرمِ رَشقاً عِندَها فَهوَ ناضِلي",46,"ل",2,0],["مَتّى ما أَدعُ في بَكرٍ يُجِبَني","قَبائِلُها بِأَكثَرِ ناصِرينا",47,"ن",2,0],["مَتى ما تُرِدها لا تَنَلها وَدونَها","دُروءٌ تَرُدُّ العِفرَ وَهوَ رَجيعُ",48,"ع",1,0],["مَتى ما يَسُؤ ظَنُّ اِمرِئٍ بِصَديقِهِ","وَلِلظَنِّ أَسبابٌ عِراضُ المَسارِحِ",49,"ح",1,0],["مَتى ما أَقُل يَوماً لِطالِبِ حاجَةٍ","نَعَم أَقضِها حَتماً وَذَلِكَ مِن شَكلي",50,"ل",2,0],["مُتَيَّمُ القَلبِ مُعَنّاهُ","جادَت بِماءِ الشَوقِ عَيناهُ",51,"ا",2,1],["مَتى ما شَحَبتَ لِوَجهِ المَليكِ","كُسيتَ جَمالاً بِأَن تَشحَبا",52,"ب",2,0],["مَتّى ماكَشَفتُم عَن حَقائِقِ دينِكُم","تَكَشَّفتُم عَن مُخزَياتِ الفَضائِحِ",53,"ح",1,0],["مَتى ما يَأتِني أَجَلي بِأَرضي","فَنادِ عَلى الجَنازَةِ لِلغَريبِ",54,"ب",1,0],["مَتى ما تُطَلِّق تُعطِ مَهراً وَإِن تَزِد","فَنَفسُكَ بَعدَ الدَينِ وَالراحَةِ المَهرُ",55,"ر",1,0],["مَتى مافَعَلتَ الخَيرَ ثُمَّ كَفَرتَهُ","فَلا تَأسَفَن إِنَّ المُهَيمِنَ آجِرُ",56,"ر",1,0],["مَتى مَلَأَت كَفَّيكَ دُنياكَ أَرسَلَت","مُلِمّاً يُعيدُ الكَفَّ مِن جودِها صِفرا",57,"ر",2,0],["مَتّى ما تُحاوِل فارِساً مِن فَراسَةٍ","فَإِنّي مِن زَيدٍ وَبِسطامَ أَفرَسُ",58,"س",1,0],["مَتّى ما تُصِب يَوماً طَعاماً لِظالِمٍ","فَقُم عَنهُ وَاِفغَر بَعدَهُ فَمَ قالِسِ",59,"س",1,0],["مَتّى مُتُّ لَم أَحفِل تَحِيَّةَ واقِفٍ","عَلَيَّ وَلَم أَعلَم بِإِحدى المَآلِكِ",60,"ك",1,0],["مَتى ما شِئتَ مَوعِظَةً فَعَرِّج","بِيَثرِبَ سائِلاً عَن آلِ قَيلَه",61,"ه",1,1],["مَتى ما تَبِت خوصُ المَطايا مَوالِياً","بِنا في اِبتِغاءِ العِزِّ فَهيَ مَوالِ",62,"ل",1,0],["مَتَى ما تُشاهِد نِعمَةً كَنعامَةٍ","مُطَرَّدَةٍ تَرتَع بِأَلفِ ظَليمِ",63,"م",1,1],["مَتى ما تَجِد مُستَرفِدَ الجودِ شاتِماً","فَفي البُخلِ لِلوَجهِ الَّذي ذينَ ذائِنُ",64,"ن",1,0],["مَتّى ما تُخالِط عالَمَ الإِنسِ لا يَزَل","بِسَمعِكَ وَقرٌ مِن مَقالِ سَفيهِ",65,"ف",3,1],["متَى ما تَرَى الإبْريقَ لِلْكأسِ راكِعاً","تُصلِّي لَهُ مِنْ غَيْرِ طُهْرٍ وَتَسجُدِ",66,"د",1,0],["متى ما مسَّ حرَّ الوجه سيفٌ","رأَيت مكانه منه خضيبا",67,"ب",2,0],["متى ما أَجئ مصر الفتاة فإنني","سآوي إِلى ركن هناك شَديد",68,"د",1,0],["مَتى ما اطمأن القلب بالنفع في الحيا","فَقَد لا يَروع الليل والرعد والبرق",69,"ق",1,0],["متى ما ازددت من بعد التناهي","فقد وقع انتقاصي في ازدياد",70,"د",1,0],["مَتى ما تَهبِطوا تَركَب عَلَيكُم","عَناجيجٌ تَعَضُّ عَلى الشَكيمِ",71,"م",1,0],["مَتَى ما تُحَذّرْهُ التَّجارِبُ صاحِباً","من الناسِ ترددهُ إليكَ التجاربُ",72,"ب",1,0],["متى ما يشأ يوماً يقده لحتفه","ومن يك في حبل المنية ينقد",73,"د",1,0],["متَى مَا يَمُتْ عَانِيكِ، يالَيْلَ، ثعْليمي","مُصَابةٍ مَا يُسْيدي لِعَانيكِ نَائِرُه",74,"ر",2,0],["متَى ما يسؤظنُّ امريءٍ بصديقهِ","ولِلظَّنِّ أَسْبَابٌ عِرَاضُ المَسَارِحِ",75,"ح",1,0],["مَتى مَا تُنَافي عندَ بابِ ابنِ هاشِمٍ","تريحي ويليقي منْ فواصلهِ يدا",76,"د",2,0],["متى منك تمضين عجلى إليك ؟","ترين اخضرار الحياة النّظيفه",77,"ف",2,0],["مَتى ما تَدعُ قَومَكَ أَدعُ قَومي","وَحَولي مِن بَني جُشَمٍ فِئامُ",78,"م",1,1],["مَتى ما تَأتِ نادينا تَجِدنا","جَحاجِحَةً خَضارِمَةً كُهولا",79,"ل",2,0],["مَتى ما تَمنَعوا شَيئاً فَلَيسَت","حَبائِلُ أَخذِهِ غَيرَ السُؤالِ",80,"ل",1,0],["متى ما تَجِدْ 