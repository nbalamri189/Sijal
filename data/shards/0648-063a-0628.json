budhabi.ae/diwan/poem/87337","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204735","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200197","الخفيف"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138922",""],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71312","المنسرح"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28326","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138518",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109994","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17779","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127095","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83122","الخفيف"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138821",""],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33379","الوافر"],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145386","الطويل"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139851",""],[4691,"يبتزّني الخدّ فما أفلحُ","https://www.poetsgate.com/ViewPoem.aspx?id=211311",""],[4935,"وقائلة أرك مع العذارا","https://www.poetsgate.com/ViewPoem.aspx?id=129279",""],[585,"نظر المشيب إليك قبل أوان","https://www.poetsgate.com/ViewPoem.aspx?id=161877",""],[5409,"صدق الهوى ما كل ود صادق","https://www.poetsgate.com/ViewPoem.aspx?id=155297",""],[5431,"لتخلصه ....","https://www.poetsgate.com/ViewPoem.aspx?id=210627",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5628,"ذكرى غروب قمر","https://www.poetsgate.com/ViewPoem.aspx?id=178485",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[161,"لكل سؤال جواب وحل","https://www.poetsgate.com/ViewPoem.aspx?id=169334",""],[6104,"بعدَ الرِّيّ","https://www.poetsgate.com/ViewPoem.aspx?id=24195",""]],"verses":[["وَغَبَطتُ نَفسي إِذ رَأَيتُكِ مَرَّةً","مَن لا يَراكِ فَإِنَّهُ مَحرومُ",0,"م",1,0],["وَغِبْطَةً تُوهِمُ الْمُقَامَ مَعِي","وَكَيْفَ لِي بَعْدَهَا بِإِمْهَالِ",1,"ل",1,0],["وغِبْنا فلَمْ ندْرِ منْ أمْرِنا","سوى أنّنا قدْ غُلِبْنا اضْطِرارا",2,"ر",2,0],["وَغَبراءَ يَقتاتُ الأَحاديثَ رَكبُها","وَتَشفي ذَواتِ الضِغنِ مِن طائِفِ الجَهلِ",3,"ل",1,0],["وَغَبراءَ يَحمي دونَها ما وَراءَها","وَلا يَختَطيها الدَهرَ إِلا مُخاطِرُ",4,"ر",1,0],["وَغِبتُ في الوَجدِ حَتّى","أَفنَيتَني بِكَ عَنّي",5,"ن",2,0],["وَغَبراءَ مَخشِيَ رَداها مَخوفَةٍ","أَخوها بِأَسبابِ المَنايا مُغَرَّرُ",6,"ر",1,0],["وغبطيَ الطير آتيه أصيح به","ليت الكريم الذي أعطاك أعطاني",7,"ن",2,0],["وَغَبطِيَ الطَيرَ أَلقاهُ أَصيحُ بِهِ","لَيتَ الكَريمَ الَّذي أَعطاكِ أَعطاني",8,"ن",2,0],["وغُبارُ أحداثِ الخُطوبِ بلمتِي","وسهامُها في جُنَّتِي وجَناني",9,"ن",2,0],["وَغَبي الأَقوامِ مَن باتَ يَرجو","فَضلَ مَن لا يَجودُ بِالإِنصافِ",10,"ف",1,0],["وَغَبراءَ عَنكُم قَد جَلَونا كَما جَلا","صَدى حِليَةِ المَأثورِ عَنهُ تِلامُها",11,"م",3,0],["وَغِبْ إذا شِئْتَ حَتَّى لا تُرى أبَداً","فما لِفقْدِكَ في الأَحْشاءِ إقْلاقُ",12,"ق",1,0],["وَغُبْرَةً يَكْرَهُ الْفَ","نُّ أَنْ تَكُونَ نَقَاءَ",13,"ا",2,0],["وغبيّ سلم لكلّ عدوّ","وهو حرب على أخيه المسالم",14,"م",1,0],["وغبراءَ يقتاتُ الأحاديثُ ركبُها","وتشفي ذواتِ الضَّعنِ من طائفِ الجهلِ",15,"ل",1,0],["وغبنا فلمْ تشهدْ ببطحاء مكة ٍ","رجالَ بني كعبٍ تحزُّ رقابها",16,"ب",3,1],["وَغَبيٌّ يَظن إِن حاز كُتُبَاً","أَنَّها الفَضل حامِلاً أَسفارا",17,"ر",2,0],["وغبت فيهم عن الدنيا وساكنها","وعن وجودي وعن طوري وعن سكني",18,"ن",2,0],["وغبت بها عن كل بادٍ وحاضر","فلا هند في قلب هناك ولا سلمى",19,"م",2,0],["وغب بسكر الذات","عن جملة اللذات",20,"ت",1,0],["وغبي الأنام من ظن أن الز","رع يركو في التربة المظماء",21,"ا",2,0],["وغبتم يا اسوداً عن حماكم","فيا للّه ما للأسد غابوا",22,"ب",3,0],["وَغُبارُها يَشفي السّقامَ وَرَبعُها","مَأوى الهُدى وَمَعونَةُ اللَهفانِ",23,"ن",1,0],["وغب إن تراءت ربّة الخدر تنجلي","ومجلى لها قد نار قدماً بإشراق",24,"ق",1,0],["وغبت عن الأشخاص مذ كنتمُ معي","وإن رمت لقياكم نظرت إلى قلبي",25,"ي",1,0],["وغب به عنك واخرج عن وجودك واس","تجلي شهودَك وانزع حلية الصلف",26,"ف",1,0],["وغب واحضر بربّك في شهودٍ","فربّك باطنٌ فيهم وظاهر",27,"ر",1,0],["وغبت عن كل شيء","مما بدا وتجلّى",28,"ل",2,0],["وغُبْرٌ من بني الغَبْراءِ مَلأى","فلا يَجْري بها إلاّ جَريّ",29,"ي",1,0],["وغبيٍّ بظنِّه مات وَهناً","قد درى الآن أنه الكذّاب",30,"ب",1,0],["وَغِبتُ عَن الأَبصار حَتّى كَأَنَّني","تَردد رَأي حال في وَهم حَيران",31,"ن",1,0],["وَغبت عَني مِن الأَوصاب وَالأَلَم","وَعَن تَذكر مِن أَهواهُ لَم أَغب",32,"ب",1,0],["وغبت بها عني وصرت وراء ما","يشاهد من حسن بكل كليتي",33,"ي",1,0],["وغبنا به عن كل بادٍ وطامسٍ","وفيه لنا سرٌّ مع الصدق حاضر",34,"ر",1,0],["وغِبْتُ إذاً عَنِّي وتُهْتُ بِمَشْهَدي","فَسَبْرِيَ في طَيِّ الإشاراتِ ضِمْنِيُّ",35,"ي",1,0],["وغِبْنا بكُمْ عن كلِّ عالٍ وخامِلٍ","وصُنَّا هواكُمْ في الضَّميرِ وما بُحْنا",36,"ن",2,0],["وغِبْ عن سِوانا حاضِراً بشُهودِنا","لنَلْقاكَ في كلِّ الشُّؤُنِ وتَلْقَانَا",37,"ن",2,0],["وغِبْ عن جَميعِ الحادِثاتِ لرَبِّها","ولا تتَّخذْ فيها سِوى شُغلِهِ شُغْلاَ",38,"ل",2,0],["وغِبنا عن مُلامَسَةِ الدَّعاوَى","بلا حقٍّ وعن عُلَقِ الدَّواعِي",39,"ع",2,0],["وغِبْنا به عنَّا فلم ندرِ شأْنَنا","له أَبداً في أَمرِنا الحلُّ والعَقْدُ",40,"د",1,0],["وغِبْنا بكم عنَّا فأنتمْ حياتُنا","ومضمونُ ما نبغي وكلُّ المآرِبِ",41,"ب",1,0],["وغِبْتُ في جُبِّ أَحزاني ولي أملٌ","بواحدٍ أَحدٍ تُمْحى به النُّوَبُ",42,"ب",1,0],["وغبيٌّ يَخال وهو ورائي","أنّه من فضيلةٍ مِن أمامي",43,"م",2,0],["وغبينٌ مَن هاج منِّي لساناً","مثلَ حدِّ الحسامِ يومَ المِصاعِ",44,"ع",1,0],["وغبينٌ مَن ليس يعلم شيئاً","بعيانٍ يُرى ولا بسَماعِ",44,"ع",1,0],["وغبراءٍ كظهرِ التُّرْ","سِ أكّالةِ أزوادِ",45,"د",1,0],["وغَبوقِي دمعُ عيني","يَ هَتوناً والصَّبوحُ",46,"ح",1,0],["وَغِبْطَةٍ لمّا اِستَوتْ للفتى","وَنالَ منها سُؤْلَهُ ولّتِ",47,"ت",1,0],["وَغَبراءَ لا يُسقي عَلى الخِمسِ رَكبُها","قَطَعتُ وَريقُ الشَمسِ يَغلي بِهِ السَجلُ",48,"ل",1,0],["وغبطة في التقى رشدٌ مرابطةٌ","شجاعة ثم تحقيق وإمعان",49,"ن",1,0],["وغب عنك وامحو نقطة الغين ثابتاً","وغص في بحار الجمع تبد الجواهر",50,"ر",1,0],["وَغَبراً قُتماً فَيجتابُ الغُبَر","في بِئرِ لا حُورٍ سَرى وَما شَعَر",51,"ر",1,0],["وغبنا بها في الغيب عن كل كائن","وكنا بحيث الكون في نشرنا يطوى",52,"و",2,0],["وغبار مسجده الذي برحابه","لمعامل الرحمن أي نفاق",53,"ق",1,0],["وغب عن النفس تعظيماً لهيبتهم","كما تغيب لدى تذكارهم طربا",54,"ب",2,0],["وغبيهم نفخوه بالتع","ظيم حتى صاردنا",55,"ن",2,0],["وَغِب عَنكَ ما تَحيا وتُبْ وَتَخلَّصا","وَعَمّن سِوى مَولاكَ وَاِعبُدهُ مُخلِصا",56,"ص",2,0],["وَغبّ أَن أَدّيته التّعظيما","رَأَيت منهُ درَّه النّظيما",57,"م",2,0],["وَغب تَقبيلي بِفي التّعظيمِ","وَمَبسم التّبجيلِ وَالتفخيمِ",58,"م",1,0],["وَغِبَّ تَقبيلِ الأكُفِّ وَالقدَمْ","مِنَ المَشوقِ المكتَسي ثَوبَ العَدم",59,"م",1,0],["وَغَبَرتُ مالي مِن تَذَكُّرِهِ","إِلّا الأَسى وَحَرارَةُ الصَّدرِ",60,"ر",1,0],["وَغَبَرتُ أُعوِلُهُ وَقَد أَسلَمتُهُ","لشَبا الأَماعِزِ وَالصَّفيحِ المُسنَدِ",61,"د",1,0],["وغب عنك تشهدوا بفضل منك تتصل","ومت فيك تجبى واطرح النفس ترأس",62,"س",1,0],["وغبت هل تدري","ما أنت لي فادري",63,"ي",1,0],["وغبّ ما إن تفي إيفاء ملتزم","كن كيف ما شيت إن الله ذو كرم",64,"م",1,0],["وَغَبَرتُ بَعدَهُمُ وَلَستُ بِخالِدٍ","مِثلَ الوَقيعَةِ تَحذَرُ النَجّاشا",65,"ش",2,0],["وغبراء من حثو التراب قد احتبى","بقاتمها حزنُ الفلا وسهولها",66,"ل",3,0],["وغبطتُهُ برقيِّها وصفائِها","لا في صفاءِ الماءِ والعُنقود",67,"د",1,0],["وغبراء مغطي بها الال لا يرى","لها من تنائي المنهلين طريق",68,"ق",1,0],["وغب تعقب لو كان منه","فرند السيف ما قبل الصقالا",69,"ل",2,0],["وَغُبرُ النَعامِ الرُبدِ يَرقُصنَ كُلَّما","تَوَجَّسنَ في الظَلماءِ لِلرَكبِ أَزمَلا",70,"ل",2,0],["وَغِبَّ غَمامٍ مَزَّقَت عَن سَمائِهِ","شَآمِيَّةٌ حَصاءُ جونَ السَحائِبِ",71,"ب",1,1],["وغِب عن الكونِ بالأسماء يا سندي","حتى تغيب عن الأسماء بالذات",72,"ت",1,0],["وغبت وما غابت مكارمك التي","على شكرها الرب العظيم يعين",73,"ن",1,0],["وغبا تدهّن واكتحل موترا نصب","على كل عين في القوى بإثمد",74,"د",1,1],["وغِبتُم عن العينِ مُذ مُدّةٍ","فمُنّوا افتقادا بأن تحضروا",75,"ر",3,1],["وغبُّ ظَفَارِ مَطلَعُ البارِ ثُمَّ سِر","إلى أن تراهُم في الثريَّا وطاير",76,"ر",1,0],["وغبت سنيناً ولما رجعت","وكان من الدر بحري زخر",77,"ر",1,0],["وغبيّ سميتُه أستاذاً","وهو في جهله من الأفذاذ",78,"ذ",1,1],["وغبرة جرت عبير جيشها","ترمح كل وردة بالشجر",79,"ر",1,0],["وغب النزول في السهل في يمن ربعها","لقد راق مغناها بربع أفاضل",80,"ل",1,0],["وَغِبْ حَنَانَيْكَ فِي حُضَورِهِمُ","عَنْكَ فَمنْ غَابَ عَنْهُ لَمْ يَغِبِ",81,"ب",1,0],["وَغِبتُ فَلَم أَشهَد وَلَو كُنتُ شاهِداً","لَخَفَّفَ عَنّي مِن أَجيجِ فُؤادِيا",82,"ي",2,1],["وغبار الحزن مما ناله","لم تجد من مسلم إلا علاه",83,"ا",2,0],["وغِبَّ انتِها تدبيرِ امر خلاصنا","وابدالهِ في موتهِ ضَرَّنا نفعا",84,"ع",2,0],["وغُبنِ في المبيع غبنا ظاهرا","وغبَنا غبن رأيا قاصرا",85,"ر",2,0],["وَغَبراءَ القَتامِ جَلَوتُ عَنّي","بِعَجلى الطَرفِ سالِمَةِ المَآقِ",86,"ق",1,0],["وغبث التهاني من سما السعد قد هما","فأضحى به روض السرور مديحا",87,"ح",2,0],["وَغَبيٍّ يَحيا سَعيداً وَيَعزُو","نَ إِلَيهِ مِن كُلِّ فن لُبابَه",88,"ب",2,0],["وغبتَ يا فرقداً ما زلتُ أرصده","هل غاب أم لم يغب فالفكر حيران",89,"ن",1,0],["وَغِب عَن شُهودِ الذاتِ مِنكَ وَوَصفِها","وَصِلّ عَلى كُلٍّ تَنَل كُلَّ رِفعَةِ",90,"ه",1,0],["وَغبتَ ولم تَغِب عنهُ الدُّموعُ","ولم يلمِم بِمُقلتهِ الهُجوعُ",91,"ع",1,1],["وغبر منهن التراب ترائباً","وخدد منهن الهجير خدودا",92,"د",2,0],["وغبت مغيباً غاب للغيب غيبه","فلاح ظهور غيبه غير مفقد",93,"د",1,0],["وغبتُ من ساقينِ تسعى لها","جداولي وملعبي الأفيحُ",94,"ح",1,0],["وغبت عن السوى حساً ومعنى","وفي طور المنى آنست نارا",95,"ر",2,0],["وغبرت تهلع أن ينالك في غدٍ","في القبر بعد الموت موت ثان",96,"ن",1,0],["وغبي قومٍ راح يحسب أنهم","لا ينظرون وراء ما هو ناطق",97,"ق",1,0],["وغبار أوراقٍ بركن هاجعٍ","خلف السرير على الرفوف منصصة",98,"ص",2,0],["وغبارُ الطريقِ خلفي وفي القَلْ","بِ هديرٌ كأنَّهُ الزلزالُ",99,"ل",1,0],["وغبتَ وأنت َ ظلٌّ فيه ِ رَوْح ٌ","وريحان ٌ بهِ الشرقُ استظلّا",100,"ل",2,0],["وَ غِبَ بِالوَعْيُ فِي سَعْي وَ لَهْثٍ","لِنَيْلِ الصِّدْقِ لَنْ تَجِدَ المُرَادَا",101,"د",2,0],["11-وَغِبْتُ بِعَتْمِ العَمَى، مَا أرَى","وحِينًا يُلَامِسُ رُوحِي الكلل",102,"ل",1,0],["وغبتُ عن الصَّرفِ عند النُّحاةِ","فلا خبرٌ لي ولا مُبتدا",103,"د",2,0]]}