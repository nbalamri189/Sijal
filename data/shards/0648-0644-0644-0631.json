{"poems":[[55,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[55,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[65,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[65,"أردد الظن بين اليأس والأمل","https://www.aldiwan.net/poem46141.html","الطويل"],[65,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[65,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[3,"حولي تنفض اِستُكَ مذرويه","https://www.aldiwan.net/poem95.html",""],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[64,"نجومنا سبعة في الكتب قد وضعت","https://www.aldiwan.net/poem52171.html","البسيط"],[82,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[46,"لعمرك لليأس غير المري","https://www.aldiwan.net/poem29986.html","المتقارب"],[76,"تشفع بعلق للشباب خطير","https://www.aldiwan.net/poem12959.html","الطويل"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85601","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85409","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[108,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[164,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[164,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[203,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[214,"ثبوت حسنك لي فيه شهادات","https://www.aldiwan.net/poem13336.html","البسيط"],[216,"وادعج وضاح الجبين يزورني","https://www.aldiwan.net/poem37867.html","الطويل"],[226,"سجيالليل والجو أمسى عباب","https://www.aldiwan.net/poem55260.html","المتقارب"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[228,"حلمت بدنيا ليتها لا تبدد","https://www.aldiwan.net/poem41601.html","الطويل"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[234,"كل سيوف الموت عضب حسام","https://www.aldiwan.net/poem50782.html","السريع"],[266,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[275,"حلمت بأني في الرياض أسير","https://www.aldiwan.net/poem35397.html","الطويل"],[287,"تألق البرق له عشيا","https://www.aldiwan.net/poem32299.html","الرجز"],[353,"إليك بالإذن صار الناس والجود","https://www.aldiwan.net/poem20780.html","البسيط"],[376,"على طرفك برهان","https://www.aldiwan.net/poem57032.html","الهزج"],[396,"جزى الله المصائب كل خير","https://www.aldiwan.net/poem54603.html","عموديه"],[422,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[463,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[469,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[469,"وقفنا بباب المنقذي عشية","https://www.aldiwan.net/poem3299.html","عموديه"],[520,"يا رب هيئ لنا من أمرنا رشداً","https://www.aldiwan.net/poem12090.html","البسيط"],[543,"دام بقاؤك لنا","https://www.aldiwan.net/poem47918.html","عموديه"],[556,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[556,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[572,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66809","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86691","البسيط"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129529","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59680","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1019,"","https://poetry.dctabudhabi.ae/diwan/poem/123317","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59438","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59125","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46521","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79507","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11915","البسيط"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101889","الرجز"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132282","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52036","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118313","الطويل"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143796","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48249","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48230","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48219","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53153","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77290","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77293","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124780","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124777","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124782","الطويل"],[2394,"","https://poetry.dctabudhabi.ae/diwan/poem/146277","السريع"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130014","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100422","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109805","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79721","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132703","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132672","البسيط"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105091","المتقارب"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86309","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91077","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91779","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216737","المتقارب"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40100","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86370","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91029","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90951","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66153","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57981","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72843","الطويل"],[4966,"أتوق إليك...","https://www.poetsgate.com/ViewPoem.aspx?id=196714",""],[5055,"مصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=105167",""],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5431,"قارورة عطر...","https://www.poetsgate.com/ViewPoem.aspx?id=202545",""],[5459,"هذي الحشاشة تذوي","https://www.poetsgate.com/ViewPoem.aspx?id=190947",""],[5582,"قُمْ يا نَدِيمِي أَدِرْ ما فِي القَوارِيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63506",""],[5596,"نغزى وسحرا","https://www.poetsgate.com/ViewPoem.aspx?id=206186",""],[5616,"عواصم","https://www.poetsgate.com/ViewPoem.aspx?id=203338",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[5853,"أما آن","https://www.poetsgate.com/ViewPoem.aspx?id=175690",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[5977,"ودعتهم","https://www.poetsgate.com/ViewPoem.aspx?id=212715",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""]],"verses":[["وَلِلرَحلِ لَحيانِ في دَفِّهِ","إِذا اِجلَوَّذَ اللَيلُ لاكَ السَناما",0,"م",2,0],["وَلِلرِجالِ أَحاديثٌ فَأَحسَنُها","ما نَمَّقَ الجودُ لا ما نَمَّقَ البَخَلُ",1,"ل",1,0],["وللرّشيدِ سَجايا منكَ نُعْرِفُها","فَضْلٌ يُرجّى ورأيٌ تِلْوُهُ القَدَرُ",2,"ر",1,0],["وللرُّدَيْنيّ اهْتِزازُ مَعْشَري","لمنْ دَعا إِلى الوَغى أوِ اعْتَفى",3,"ا",1,0],["وللرّقيبِ خُشوعٌ في لَواحِظِهِ","يُعيرُها نَظراتِ الشّارِبِ الثّمِلِ",4,"ل",1,0],["وللرّكائِبِ إرْزامٌ تُرَجِّعُهُ","إذا أقَمْنا ولمْ تَشْرَقْ بِها البيدُ",5,"د",1,0],["ولِلرَّعْدِ إعْوالٌ ولِلرّيحِ ضَجّةٌ","وللدَّوْحِ تَصْفيقٌ وللوُرْقِ إرْنانُ",6,"ن",1,0],["وَلِلرُعيانِ في لُقُحٍ ثَمانٍ","تُحادِثُهُنَّ صَرّاً أَو غِرارا",7,"ر",2,0],["وللرأي هبَّات من النومِ يجتلي","أخو الرأي فيها ما تَغُمُّ الغمائمُ",8,"م",1,0],["وللرصاص فذا ذكر","سعد منير له نقض وإبرامُ",9,"م",1,0],["وَلِلرُّدَينِيِّ يَوْمَ الطّعنِ عالِيَةٌ","تَلوكُ بَينَ حَشا الضِّرغامَةِ الكَبِدا",10,"د",2,0],["وَلَلرَيثُ تَحفِزُهُ بِالنَجا","حِ خَيرٌ مِنَ الأَمَلِ الخائِبِ",11,"ب",1,0],["وَلِلرَوضِ سِرٌّ شافَهَتنا بِهِ الصَبا","سُحَيراً فَأَلهى مِن حَديثِ خَبيرِ",12,"ر",1,0],["وَلِلرَّباعِ العَوَالِي الارْتِفاعِ بِناً","وَلِلْبَساتِينِ تُنْشَأُ وَالدَّكاكِينِ",13,"ن",1,0],["وَللريح ألقاها بوجهي عذوبة","وَللماء أحسوه على كبدي برد",14,"د",1,0],["وَللرصاص أزيزٌ","وَللرجال هُوِيّ",15,"ي",1,0],["وللرِّيحِ حولهما زَفَّةٌ","كما صَدَحَ المِزْهَرُ الساحرُ",16,"ر",1,0],["وللربيع خمورٌ؛ لا كرومَ لها","ولا كئوسٌ، ولا دَنٌّ، ولا حان",17,"ن",1,0],["وللرياحين على اختلافها","ملابس تختال فيها فخرا",18,"ر",2,0],["وللرياحين والأزهار إذ نثرت","لون الزبرجد والياقوت والورق",19,"ق",1,0],["وللروح عيش من وجوه تحيطها","فوجه يرى بؤساً ووجه يرى رغدا",20,"د",2,0],["وللربيع خيام قد فرشن بها","من المطارف بسط سندسيات",21,"ت",1,0],["وَللرَّبع أزهارٌ لِطيبِ حديثِهِ","ويَخْضَرُّ فيه الآس والأثل والخمط",22,"ط",1,0],["وللرعد صوت تكاد الجبا","ل تندك من هوله والهضاب",23,"ب",1,0],["وللرباعي المزيد فيه","أبنية ثلاثة تحويه",24,"ه",1,0],["وَلِلرّيحِ في الغاباتِ زعق كَأَنَّهُ","صَدى الجِنّ في وادي الجَحيم يزغردُ",25,"د",1,0],["وللرِّزقِ مَفاتيحٌ","وللرّحمان قُربْانُ",26,"ن",1,0],["وللرّدَى داعٍ إذا ما دعا","جَدَّ ولَم يَرعَ لخَلْقٍ ذِمام",27,"م",1,0],["وللربيع عسكر قد حلوا","بعسجد فرسانه والرجل",28,"ل",1,0],["وللريحِ في الأوراقِ أنغامُ شاعرٍ","لهُ فوقَ أنّاتِ الرّبابِ زفير",29,"ر",1,0],["وَلِلرَبيعِ كيمياءَ أَبرَزَ ال","إبريزَ مِن أَكمامِهِ نَقِيّا",30,"ي",2,0],["وَلِلرَّبِيعِ لِسانٌ ظَلَّ يُنشِدُنا","النَّبتُ أَغيَدُ والسُّلطانُ مَحمودُ",31,"د",1,0],["ولِلرحمنِ في يَومِ","حِسابِ النَّاسِ غُفرانُ",32,"ن",1,0],["وللراضي بها أجر عظيم","وبشر صابرا بالصلوات",33,"ت",1,0],["وللركب المناخ بها حنينٌ","حنينَ الفاقدين على الفقيد",34,"د",1,0],["وللرمح فات الرمحُ بعدك أن يرى","شمائلَ عطّافٍ مع الطعن مياّلِ",35,"ل",1,0],["وللراكبيها القِرَى والحمى","ورِفدٌ يطيبُ كما يَكثُرُ",36,"ر",1,0],["وللركب تحت سيوف الوميض","جفون أبت أن تذوق الهجودا",37,"د",2,0],["وللريح فينا زمهريرٌ كأنهُ","معانيهِ حالي فكرهِ وارتجاله",38,"ل",2,0],["وللرجاء ثواب أنت تعلمه","فاجعل ثوابي دوام الستر لي أبدا",39,"د",2,0],["ولِلرَّدَى واحَسرَتي","يَقودُ مِنِّي الرَّسَنَا",40,"ن",2,0],["وللرّجالِ يحلّون الحُبا وَلَهاً","من أنّهمْ علموا في ذاك ما علموا",41,"م",3,0],["وللرّيحِ بها أنٌّ","حكى غَمغَمَةَ الشادِي",42,"د",2,0],["وَلِلرَّدَى هِمَّةٌ يَغُولُ بِهَا","كُلَّ نَفِيْسٍ وَكُلَّ ذِي هِمَمِ",43,"م",1,0],["وللرشيد الرابعِ المُرتضى","مُفْتَرَضٌ من حقِّهِ اللازمِ",44,"م",1,0],["وَللرياسة عش في مصر مُبتهجاً","بِها فَأَنتَ بما تَرجوه مَوعود",45,"د",1,0],["وللريح بالطير فوق الغصون","بها عبث يستخف الوقورا",46,"ر",2,0],["وللرأي والرايات جُهدُ جهادنا","ليهلك كفار وينصر مُسلم",47,"م",1,0],["وَلِلرَّوضِ غِبَّ القَطرِ أَخلاقُهُم فَما","يُلاقونَ إِلا بِالطَّلاقَةِ وَالبِشرِ",48,"ر",1,0],["وللروح اطراق لأجل جلاله","وإجلاله إن الحياء لذو حصر",49,"ر",1,0],["وللرمح كف بالنجيع مخضب","وللسيف ثغر بالدماء ملثم",50,"م",1,0],["وَلِلرُّمْحِ أمْرٌ فِي الكَتَائِبِ عَادِلٌ","وَللِسَّيْفِ حُكْمٌ في المَقَاسِمِ جَائِرُ",51,"ر",1,0],["وَلِلرِجال فَاعلمن مَكايد","وَخدع منكرة شَدائد",52,"د",1,0],["وللرجا عسى حرى واخلولقا","عسى فشى بأن وذان استرفقا",53,"ق",2,0],["وللرياضِ أزاهيرٌ مُشَوَّقةٌ","تحكين لفظَ ابنِ مشكانٍ وأخلاقَهْ",54,"ه",1,0],["وَلِلرَبيعِ رُبوعٌ كُلَّما ضَحِكَت","بَكى عَلى نَشَواتِ الخَمرِ مَخمورُ",55,"ر",1,0],["وللرضاع قلمي قد انبرى","إذعمت البلوى به بين الورى",56,"ر",2,0],["وللريم منك الجيد والعين والحشا","وليس لها منك الروادف والفم",57,"م",1,0],["وَلِلرَّبَابِ زهوٌ وحُقَّ لَهُ","والعُودُ هَمهَمَ كَالغَضبَانِ ذي الأدَبِ",58,"ب",1,0],["وللراح في ابريقها من مذاقه","اذا بغريض المزن شجت نصيب",59,"ب",1,0],["وللرأي زلاتٌ يظل بها الفتى","مركبةً فوق الثنايا أنامله",60,"ه",1,1],["وللرياضِ أريجٌ ساطعٌ شَبِمٌ","فالمسكُ من شمِّه المحسوسِ محسوسُ",61,"س",1,0],["وللرياح مزاميرٌ إِذا خطرتْ","للروضِ ترقصُ أغصانٌ وقُضْبانُ",62,"ن",1,0],["وللريح خَطٌّ في صحيفةِ نهرِها","وللغيم مِن آماقِهِ أبداً نَقْطُ",63,"ط",1,0],["وللرياض في الغياض عبقة","لا يعبق المسك الذكيّ ناشقا",64,"ق",2,0],["وَلِلروحِ مَعنىً في النَسيمِ مُخَبَّأ","إِذا مَسَّ مَيتاً قامَ يَسعى وَيَدأَب",65,"ب",1,0],["وَلِلرَوضِ نَفحٌ بِالعَبيرِ وَمَنظَرٌ","يَروقُ مَن اِستَجلى وَيَشفي مَن اِستَشفى",66,"ف",2,0],["وللرصغ كم المصطفى فإن ارتخى","تناهى إلى أقصى أصابعه قد",67,"د",1,0],["وللرجل احظر لبس أنثى وعكسه","للعن عليه واكرهته بأبعد",67,"د",1,0],["وللرفث اهجر والفسوق وهكذا ال","جدال واقلل من كلامك تحمد",68,"د",1,0],["وللرجل اكره عرض زيق بنصّه","ولا يكره الكتان في المتأطّد",69,"د",1,0],["وللرّزايا وثبةٌ ما لها","إلاّ الذي تذخر من عدّتك",70,"ك",1,0],["وللرواقصِ والقينات مقتعَدٌ","في ساحةٍ لكَ لا تخلو من الخدَمِ",71,"م",1,0],["وللرياض اريج في خمائلها","وللنسيم انتشاق في حواشيها",72,"ي",3,0],["وللريح حوليه حفيف كأنه","حفيف جناح الصقر حن الى الوكر",73,"ر",1,0],["وللراح في الرأس أحكامها","وللرأس في المرء أي احتكام",74,"م",1,0],["وللراجي به غيث الايادي","وللاجى به حرم النزيل",75,"ل",1,0],["وللردى شرك بثت حبائله","على الأنام وكل فيه معتلق",76,"ق",1,0],["وللرع لاطمة في السحاب","ذكى الحزن في قلبها فاحترق",77,"ق",1,0],["وللروح أكبر العقول تنزل","وباكبر العقول صارت كبيرة",78,"ه",1,0],["وللروح قوة على حمل سره","من بين نفوس الخلق فازت بقوة",78,"ه",1,0],["وَلِلرّيح حوليه حَفيفٌ كَأَنَّهُ","زَوابِعُ قفرٍ لِلتُّرابِ غَدَت تذري",79,"ر",2,0],["وَللربيع عَلى تلك الربوع يدٌ","قد زينتها بوشيٍ زاهرٍ بهج",80,"ج",1,0],["وَللراح شمسٌ برجُها كفُّ من سَقى","مَتى أَشرقت غالَ الهمومَ غُروب",81,"ب",1,0],["وللروض زهر به طائح","تقلب في الأرض كالمحتضر",82,"ر",1,0],["ولِلرايةِ العُظمى وَقد ذَهبا بِها","مَلابس ذُلّ فَوقَها وجَلابيبُ",83,"ب",1,0],["ولِلرّياضِ اِخْتِيالٌ في مَلابِسِها","مَثلَ القَصائِدِ مَمدودٌ وَمَقصورُ",84,"ر",1,0],["وللريح من خيله مركض","وللبرق من سيفه مؤتلق",85,"ق",1,0],["وللروح والريحان ثم مؤرخا","مضى كوكب الإحسان بالمجد والعلم",86,"م",1,0],["وللرعاية منكم حولها حدق","ذوت وجفت كان لم يكسها ورق",87,"ق",1,0],["وللربيعِ حَولَهُم مَجامِرٌ","تَعَطَّرَ الجَوُّ بِهِنَّ واكتَبَى",88,"ا",1,0],["وَلَلَرَّأْيُ في كُلِّ المَواطِنِ سَيِّدٌ","لَهُ رايَةُ التَّوْفِيقِ في كلِّ مَوْكِب",89,"ب",1,0],["وللرعد تسبيح وللوبل هدة","وادٍ له في الجانبين قشيب",90,"ب",1,0],["وللروض أن يهواك ان جبينَهُ","إذا ظنّت الأنواءُ جوداً هو الخالُ",91,"ل",1,0],["وللرحمن ذكَّارا","وللقرآن حمَّالا",92,"ل",2,0],["وللرجال السيف مع هد السفافه","يتعب الصياد سرج الناشريه",93,"ي",2,0],["وللريان ِ أهل ٌ عند ربي","فكُن ْ منهم وللإحسان ِ هاجر ْ",94,"ر",1,0],["وللراقصاتِ الواقصاتِ تخاوصٌ","وإيقاعها همْسٌ رأى وطبولُ",95,"ل",1,0],["وللركب شبت بطي الضلوع","عشية بانوا لظى حاظمه",96,"م",2,0],["وللروح أبواب الأحاسيس خمسة","على أنّ باب الشمّ أخطرُ مااتفق!",97,"ق",1,0],["وَ لِلرَّحِيمِ أَمُدُّ الكَفَّ أَسْأَلُهُ","عَفْوًا وَ مَغْفِرَةً إِنْ ضَاقَتِ السُّبُلُ..",98,"ل",1,0],["[ وَلِلرِّياحِ اخْتِلافاتٌ وَرائِقُ ما","فِي الرَّوْضِ ما بَيْنَ مَقْبُولٍ وَمَدْبُورِ ]",99,"ر",1,0],["وللرياض ابتسام","وجهاً وخدّاً وثغرا",100,"ر",2,0],["وللرياض هدير في منابرها","فألف شكر لمن قد صاح أو زأرا!!",101,"ر",2,0],["وَ للرِّقِّ تَسْتَبْقي مُلُوْكَاً وَ حَسْبُهُمْ","مِنَ الْعِزِّ أنْ صّاْروا عَبِيْدَ عَبِيْدكِ",102,"ك",1,0],["وللرؤيا حقيقتها","وللسّكينِ من يأرقْ",103,"ق",1,0],["وللروح أن تجتديْ بلسماً","عبير اً بذاك المدى أطلقا",104,"ق",2,0],["وللروح أرضٌ إذا لم نصلها","فكل المدى غربةٌ وانقسامْ",105,"م",1,0],["وللرفيق الذي ما كان أصبره","وكان في هذه الدنيا لنا نهرُ",106,"ر",1,0],["وللرماح اصطكاك في أسنتها","وللسهام اختلاف في مراميها",107,"ي",3,0],["وللرؤوس انتثار عن كواهلها","وللصدور انتظام في محانيها",107,"ي",3,0],["وللرسالة منه مذ تحملها","باعان رحبان تقديم وتفضيل",108,"ل",1,0]]}