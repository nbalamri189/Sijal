502",""],[4958,"على قدر التعلق","https://www.poetsgate.com/ViewPoem.aspx?id=59099",""],[2177,"شجاني منهم ربع خلاء","https://www.poetsgate.com/ViewPoem.aspx?id=127080",""],[5135,"لِقاءُ الْأحِبَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=201841",""],[5174,"اللغةُ الخالدة","https://www.poetsgate.com/ViewPoem.aspx?id=199658",""],[5324,"كفى للعنف .","https://www.poetsgate.com/ViewPoem.aspx?id=207662",""],[5324,"كفى للعنف.","https://www.poetsgate.com/ViewPoem.aspx?id=211387",""],[5324,"بكم أكبر.","https://www.poetsgate.com/ViewPoem.aspx?id=215946",""],[5365,"وطن المعجزات","https://www.poetsgate.com/ViewPoem.aspx?id=191266",""],[5465,"أنتم يا بني علي ذوو الحق","https://www.poetsgate.com/ViewPoem.aspx?id=98442",""],[5528,"في هيئة العلماء زاد","https://www.poetsgate.com/ViewPoem.aspx?id=201133",""],[5720,"مَاذَا يُرِيْدُ الحَاقِدُونَ ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=200254",""],[5720,"هُنا القوزُ","https://www.poetsgate.com/ViewPoem.aspx?id=214031",""],[5770,"صحبة النشء","https://www.poetsgate.com/ViewPoem.aspx?id=178679",""],[5790,"تثنى كما هز الرديني حامله","https://www.poetsgate.com/ViewPoem.aspx?id=111888",""],[5842,"إلى جيش الغطاريف .. الجيش السوري","https://www.poetsgate.com/ViewPoem.aspx?id=68315",""],[5848,"ابعد نافذة","https://www.poetsgate.com/ViewPoem.aspx?id=53450",""],[5912,"مغرم","https://www.poetsgate.com/ViewPoem.aspx?id=202271",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[5943,"سلام الله يلقيه السرورُ","https://www.poetsgate.com/ViewPoem.aspx?id=37262",""],[5956,"بخطابك السامي","https://www.poetsgate.com/ViewPoem.aspx?id=193955",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[5991,"بكماله ما في الوجو مظاهر","https://www.poetsgate.com/ViewPoem.aspx?id=116384",""],[6003,"مركز التكوين","https://www.poetsgate.com/ViewPoem.aspx?id=201022",""],[6084,"بك ميت الزمان والفقر يحيى","https://www.poetsgate.com/ViewPoem.aspx?id=170843",""],[6093,"فكل ساع له في سعيه وطر","https://www.poetsgate.com/ViewPoem.aspx?id=207056",""],[6147,"جنوني ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""],[6174,"الشِّعر في عُرس النجومِ الخُضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86185&r=&rc=2",""],[463,"بطرفِّكَ والمسحورُ يقسمُ بالسَّحرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60085&r=&rc=141",""],[454,"يزهو القريض به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82684&r=&rc=48",""]],"verses":[["بِكُم في الشِعرِ فَخري لا بِشِعري","وَعَنكُم طالَ باعي في الخِطابِ",0,"ب",1,0],["بِكَ مَا بِي فَقُلْتُ مَوْلاَيَ عَافَا","كَ الْمُعَافِي مِنْ عَبْرَتِي وَنُحُولِي",1,"ل",2,0],["بِكُمَيتٍ عَرفاءَ مُجمَرَةِ الخُف","فِ غَذَتها عَوانَةٌ وَفِتاقُ",2,"ق",1,0],["بِكُم باهَتِ الأَرضُ السَماءَ فَأوجُهٌ","شُموسٌ وَأَيدٍ في المُحولِ سَحابُ",3,"ب",1,0],["بكم طرب الفرات وقال جهراً","لوادي النيل إنك من لداتي",4,"ي",1,0],["بكم آلَ أيوبٍ غنينا عن الورى","فلم نجدِ الأمداحَ فيهم ولم يجدوا",5,"د",3,0],["بكم غنيتْ حالي عن الناس وازدهى","نظامُ كلامي فيكمو وفريده",6,"د",2,0],["بكم آل فضل الله طافت مقاصدِي","وتمَّ على نجح الرجا بكمُ نسكي",7,"ك",2,0],["بِكُمْ عَمَرَتْ أوْطَانُ كُلِّ مُرُوءةٍ","وقد جَعَلت تلك المغاني تَأبَّدُ",8,"د",1,0],["بِكم نَعشَ اللَه الخلافةَ بعدما","هوى جَدُّها من حالق وهو تاعس",9,"س",1,0],["بكم حِيصَ فُتقُ الملك بعد اتساعه","ولولاكُمُ أعيا على كل حائص",10,"ص",1,0],["بكمُ تغيم سماؤنا في جَدْبنا","وتقشَّعُ الشبهاتُ حين تغيمُ",11,"م",1,0],["بِكُم أَدرَكَ اللَهُ البَرِيَّةَ بَعدَ ما","سَعى لِصُّها فيها وَهَبَّ غَشومُها",12,"م",3,0],["بِكُم وَبِالراقينَ أَمثالِكُم","يَفتَخِرُ العالِمُ وَالعامِلُ",13,"ل",1,0],["بِكُما أُصيبَ المُسلِمونَ وَفيكُما","دُفِنَ اليَراعُ وَغُيِّبَ الصَمصامُ",14,"م",1,0],["بِكُما بِتُّ عائِذاً فيكُما مِن","هُ وَمِن كَيدِ كُلِّ باغٍ وَعادِ",15,"د",1,0],["بِكُم يُحسَمُ الداءُ العَياءُ وَيُتَّقى","بِكُم قادِماً مَخشِيَّةُ الدَرِّ باهِلِ",16,"ل",1,0],["بِكُم تَبَلَّجَ وَجهُ الحَقِّ يا مَلِكاً","بِهِ تَشَرَّفَ هامُ المُلكِ وَالرُتَبِ",17,"ب",1,0],["بِكَ مِن حادِثِ الزَمانِ نَعوذُ","وَبِأَبوابِكَ الشِرافِ نَلوذُ",18,"ذ",1,1],["بِكُم بِأَهلِ المُصطَفى أَم بِهِمُ","فَرَدَّ العُداةَ بِأَوصابِها",19,"ب",3,0],["بِكُمُ باهَلَ النَبِيُّ وَلَم يُل","فِ لَكُم خامِساً سِواهُ يُزادُ",20,"د",1,0],["بِكُم يَهتَدي يا نَبِيَّ الهُدى","وَلِيٌّ إِلى حُبِّكُم يَنتَسِب",21,"ب",1,1],["بكم والصفوةِ الواعين تاهت","بأجمل واحة قفراء بيدُ",22,"د",1,0],["بكم تحمِي الخلافةُ جانِبَيْها","وتدفعُ غارة المُتحفِّزينا",23,"ن",2,0],["بِك ملك الأَرض طراً بَدَلا","ديننا حُبك يا هَذا الوَطَن",24,"ن",1,0],["بكم يُتأسَّى في العُلا وإليكُمُ","يُشَارُ وعنكُم يُؤخَذُ العَزمُ والحَزمُ",25,"م",1,0],["بِكُمْ عَزّ ما بَينَ البَقيعِ ويَثرِبٍ","ونُسِّك ما بَينَ الحَطيمِ وزمزم",26,"م",1,0],["بكما انقادَ لنا الدَّهْرُ على","بُعْدِ عَهدِ الدهرِ منّا بانقياد",27,"د",1,0],["بِكَمالِ صورَتِكِ الَّتي في مِثلِها","يَتَحَيَّرُ التَشبيهُ وَالتَمثيلُ",28,"ل",1,0],["بِكَ ما تَرى فيما يُجي","زُ مَجازَ حاجاتٍ لِوافِد",29,"د",1,0],["بِكُمْ قُوَّةٌ مَذْخُورةٌ إِنْ رَشُدْتُمُ","بِتَصْرِيفِهَا حَوَّلْتُمُ غِيَرَ الدهْرِ",30,"ر",1,0],["بكمال طبع صحائف نبوية","شرعية لهدى النفوس موارد",31,"د",1,0],["بكمالها طبعا وكون كمالها","فيه لغايات الكمال معاقد",31,"د",1,0],["بكم وبالرّاقين أمثالكم","يفتخر العالم والعمل",32,"ل",1,0],["بكم يا آل خير المرسلين","توسلنا لرب العالمين",33,"ن",1,1],["بكم في القحط نستسقي الغوادي","ويوم الخوف نغدو آمنين",33,"ن",1,0],["بكم من ربنا نعطى المرجى","وندخل في صنوف الصالحين",33,"ن",1,0],["بكم نعشت أجزاء ذات وطلمست","بنشأتها عن غيركم مدة العمر",34,"ر",1,0],["بكم استقام الملكُ واعتدلَ القَضَا","وغدت بكم منشورةً راياتُه",35,"ت",2,0],["بكم استنارَ الدينُ بعد طُموسه","لولاكمُ ما أُوضحت آياتُه",35,"ت",2,0],["بِكُم حَصَرٌ عِندَ السَبابِ فَإِن جَرَت","مُفاخَرَةُ الأَمجادِ أُلفيتُمُ لُدّا",36,"د",2,0],["بكم تفخرُ العليا ولولا سيوفُهم","لما كانتِ العلياءُ ولا الفخر يعرفُ",37,"ف",1,0],["بكم عرفت وفيكم نشأتي ولكم","بقيتي وعليكم بت متكلا",38,"ل",2,0],["بِكُم بَلَغَت مِنّي الأَعادي وَمِنكُمُ","لَقِيتُ البَلايا السُودَ فَذّاً وَتَوأَما",39,"م",2,0],["بِكُم يُؤمِنُ اللَهُ البِلادَ وَيُصلِحُ ال","عِبادَ وَيَعفُو عَن ثِقالِ الجَرائِمِ",40,"م",1,0],["بِكُمُ سَرى بَرٌّ سَما بِعُلَى سَنىً","تَسمَت بِهِنَّ لَنا سِوافِرُ سُولِ",41,"ل",1,0],["بِكُم وَبِسَعيِكُم تُبنى المَعالي","وَينمي رَوضها الزَّاهي النَضيرُ",42,"ر",1,0],["بِكم آلَ وَحْيِ اللهِ يفتخرُ المجدُ","وفيكم يَسوغ المدحُ والشكر والحمدُ",43,"د",1,1],["بكم تسعدُ الدنيا ويسعد أهلها","يا خيرَ حيٍّ من سُلالة رُسْلِها",44,"ل",3,0],["بكم غفلةٌ عمّا بنا من هواكُمُ","فيا عَجباً من قاتلٍ وهو غافِلُ",45,"ل",1,1],["بك من بِعادك أستجِير","يا أيها الصمد الأمير",46,"ر",1,1],["بكمْ أم بهمْ جاء القُرآنُ مبشّراً","بكمْ أم بهمْ دين الآله يشاد",47,"د",1,0],["بِكُم أَيَّدَ اللَهُ المَمالِكَ فَاِغتَدَت","مَوَطَّدَةَ الأَكنافِ مَجموعَةَ الشَملِ",48,"ل",1,0],["بك مزن الجود ماطرة","وَبحار الخير زاخرة",49,"ه",1,0],["بِكُم قَلبي عَليلٌ ما يُبِلُّ","بِهِ مِنكُم غَليلٌ ما يُبَلُّ",50,"ل",1,1],["بِكُم عَرَفتُ الحُبَّ","ما عَرَفتُكُم بِالحُبِّ",51,"ب",1,0],["بِكُم يا خَير أُمّة خَير مُرسل","ألوذُ بِكُم وَلي بِاللَه مَأمل",52,"ل",1,0],["بِكُم حازَها قِدْماً وفيكُم يَصوغُها","إذَنْ فهي النُّعمَى لكم وهي الشُّكر",53,"ر",1,0],["بكم حَوى الفخْرَ دَهْرٌ ضمَّ شملَكمُ","ما قيمةُ السِّلْكِ إن لم تُغْلِهِ الدُّرَر",54,"ر",1,0],["بِكُمْ قديماً رسولُ اللّهِ بَشَّرنا","كما بِه بشّرتْنا سالفُ النُّذُر",55,"ر",1,0],["بِكمُ آل عبّاسٍ يُعاذ ومنكمُ","يُعادُ لنا جَزْلُ العطاء كما يُبْدا",56,"د",2,0],["بكُمُ يا آل عبّاسٍ يُرى","من صُروفِ الدّهر ما عشتُ احتمائي",57,"ا",2,0],["بكم تم أمر اللَه في كل حُجَّةٍ","يراها وليس ما ترون بمانع",58,"ع",1,0],["بكم وبوالدي نور المعالي","ومن في كل مكرمة إمام",59,"م",1,0],["بكم بَلَغَت كَعبٌ مَناها وَرَبُّها","يَتِمُّ لَها نُعماؤُها وَيَزيدَها",60,"د",3,0],["بِكَ مِن فَضلِ بَأسِهِ يُعرَفُ البَأ","سُ كَما مِن نَداهُ نَداكا",61,"ك",2,0],["بكم يُستغاث إذا ما الخطوب","أهالت على الخلق أهوالها",62,"ل",3,0],["بكم يرزق الله العباد وفيكم","تنزَّل من رب السماء كتاب",63,"ب",1,0],["بكم عاد وجه الأرض من بعد جدبه","خصيبا بروض من أياديك موفق",64,"ق",1,0],