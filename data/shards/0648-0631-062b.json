,"https://www.aldiwan.net/poem66225.html","الوافر"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[19,"ورثنا المجد عن آباء صدق","https://www.aldiwan.net/poem348.html",""],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[88,"الدهرُ بيَّن في كتابِ شهادة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19562&r=&rc=65",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["وَرِثنا رَسولَ اللَهِ عُلويَّ مَجدِهِ","وَمُعظَمُ ما ضَمَّ الصَفا وَالمُعَرَّفُ",0,"ف",1,0],["وَرِثوا المَعالي بِالجُدودِ وَبَعدَها","بِضَرابِ مُرهَفَةٍ وَطَعنِ رِماحِ",1,"ح",1,0],["وَرِثتَ عَنِ الأَبَينِ قَناً وَبَأساً","فَأَنفَقتَ اللَهاذِمَ وَالزِجاجا",2,"ج",2,0],["وَرِثْنا العُلا وَهْيَ الَّتي خُلِقَتْ لَنا","وَنَحْنُ خُلِقْنا لِلْعُلا وَالمَحامِدِ",3,"د",1,0],["ورِثْتَ عُبَيْدَ اللهِ عمَّكَ جودَهُ","وأشْبَهْتَ عبدَ اللهِ جَدَّك سُؤْدَدا",4,"د",2,0],["ورِثَ الإمامَةَ كابِراً عن كابِرٍ","مُتَوكِّليٌّ بالعَلاءِ خَليقُ",5,"ق",1,0],["وَرِثَ الْجَلاَلَةَ عَنْ أَبِيهِ وَجَدِّهِ","فَكَأَنَّهُمْ مَا غَابَ مِنْهُمْ هَالِكُ",6,"ك",1,0],["ورثا عنِ النّدْبِ الكريمِ أبيهِما","محْضَ الوَفاءِ ورِفْعَة المِقْدارِ",7,"ر",1,0],["وَرِثَ السُؤدَدَ عَن آبائِهِ","وَغَزا فيهِم غُلاماً ما نَكَح",8,"ح",1,0],["وَرِثوا السِيادَةَ كابِراً عَن كابِرٍ","إِنَّ الكِرامَ هُمُ بَنو الأَخيارِ",9,"ر",1,0],["وَرِثَ المَجدَ وَالمَكارِمَ وَالحِل","مَ وَطيبَ الأَعراقِ جَداً فَجَدّا",10,"د",2,0],["وَرَثَّت عَلى مَرِّ اللَيالي رُسومُهُ","وَكَم رَقَّ فيهِ بِالعَشِيِّ نَسيمُهُ",11,"ه",1,0],["وَرِثِ الأَعداءَ أَعما","رَهُمُ وَالأَولِياءَ",12,"ا",2,0],["وَرِثنا المَجدَ قَد عَلِمَت مَعَدٌّ","نُطاعِنُ دونَهُ حَتّى يَبينا",13,"ن",2,0],["وَرِثنا مَجدَ عَلقَمَةَ بنِ سَيفٍ","أَبَاحَ لَنا حُصونَ المَجدِ دينا",13,"ن",2,0],["وَرِثتُ مُهَلهِلاً وَالخَيرَ مِنهُ","زُهَيراً نِعمَ ذُخرُ الذاخِرينا",13,"ن",2,0],["وَرِثناهُنَّ عَن آباءِ صِدقٍ","وَنُورِثُها إِذا مُتنا بَنينا",13,"ن",2,0],["ورِثَ السماحة عن أبيه وجَدّهِ","فالأَكرمُ ابنُ الأكرم ابنِ الأكرمِ",14,"م",1,0],["وُرَّثتَ هذا الفخرَ يا ملك الهدى","من كلِّ من آوى النَّبِيَّ ومن نَصَرْ",15,"ر",1,0],["ورثته بألسن من معالي","ه حداد تفلّ حدّ الحسام",16,"م",1,0],["وَرِثَ الأَعِنَّةَ وَالأَسِنَّةَ وَاِنتَمى","في بَيتِ مَكرُمَةٍ رَفيعِ السُلَّمِ",17,"م",1,0],["وَرِثنا ذُرى عِزٍّ وَتَلقى طَريقَنا","إِلى المَجدِ عادِيَّ المَوارِدِ مَعلَما",18,"م",2,0],["وَرِثنا مَساكِنَهُم بَعدَهُم","وَكُنّا مُلوكاً بِها لَم نَرِم",19,"م",1,0],["وَرِثتُ الفَعالَ وَبَذلَ التِلا","دِ وَالمَجدَ عَن كابِرٍ كابِرِ",20,"ر",1,0],["وَرِثنا مِنَ المَجدِ أُكرومَةً","أَحَلَّ بِها الآخِرَ الأَوَّلُ",21,"ل",1,0],["وَرِثنا سَناءً مِنهُ يَعلو وَمَحتِداً","مُنيفَ الذُرى سامي الأَرومَةِ يُذكَرُ",22,"ر",1,0],["وَرِثنا سَناءً مِنهُ بَرزاً وَمَحتِداً","مُنيفَ الذَرى فَخمَ الأَرومَةِ يُذكَرُ",23,"ر",1,0],["وَرِثنا مِنَ البُهلولِ عَمروُ بنِ عامِرٍ","وَحارِثَةَ الغِطريفِ مَجداً مُؤَثَّلا",24,"ل",2,1],["ورثتُ اللفظ عن سلفِي وا كرم","بآل نباتة الغرّ السرَاة",25,"ه",1,1],["ورثوا الشجاعة والعلى يروونها","قرشيةً عن غالبٍ ومجمَّع",26,"ع",1,0],["ورثتَهُمُ ثم أحيَيْتَهُمْ","وكم خَلَفٍ وارثٍ باعثِ",27,"ث",1,0],["ورثتَ عباسَك الوسامة وال","رأي فما ينكر امرؤ سَدَدَكْ",28,"ك",1,0],["ورثْتم بيوت النار والنور كلّها","ذوي العلم قِدماً والشؤونِ الأعاظمِ",29,"م",1,0],["وَرَثوا اِقتِحامَ البَحرِ عَن فينيقيا","أُمِّ الثَقافَةِ مَصدَرِ التَمدينِ",30,"ن",1,0],["ورثاؤك الإرشاد والعظة التي","تُلقى على العظماء والأفراد",31,"د",1,0],["ورِث الناس نعيما باطلا","وورثتم وحى ربي المنزلا",32,"ل",2,0],["ورثت الحلم عن فحل كريم","ففيك الحلم عند الصفع عادة",33,"ه",1,1],["وَرِثوا الكِتابَةَ وَالفُروسَةَ وَالحِجى","عَن كُلِّ أَبيَضَ مِنهُمُ وَضّاحِ",34,"ح",1,0],["وَرِثوا الكِتابَةَ وَالفُروسَةَ قَبلَها","عَن كُلِّ أَبيَضَ مِنهُمُ وَضّاحِ",35,"ح",1,0],["وَرِثَ النَبِيَّ سَجِيَّةً مَرضِيَّةً","وَطَريقَةً قَصَداً وَقَولاً فَيصَلا",36,"ل",2,0],["وَرِثتُ سُيوفَهُم وَمَضوا كِراماً","وَما نَفعُ السُيوفِ بِلا رِجالِ",37,"ل",1,0],["وَرِثوا السَماحَ فَأَورَثوهُ فَما تَرى","في غَيرِهِم لِلجودِ مِن مُتَلَوَّمِ",38,"م",1,0],["وَرَثتَ إِلى أَخلاقِهِ عاجِلَ القِرى","وَضَربَ عَراقيبِ المَتالي شَبوبُها",39,"ب",3,0],["وَرِثتَ اِبنَ حَربٍ وَاِبنَ مَروانَ وَالَّذي","بِهِ نَصَرَ اللَهُ النَبِيَّ مُحَمَّدا",40,"د",2,0],["وَرِثنا كِتابَ اللَهِ وَالكَعبَةَ الَّتي","بِمَكَّةَ مَحجوباً عَلَيها سُتورُها",41,"ر",3,0],["وَرِثنا عَن خَليلِ اللَهِ بَيتاً","يُطَيَّبُ لِلصَلاةِ وَلِلطَهورِ",42,"ر",1,0],["وَرِثوا الطِعانَ عَنِ المُهَلَّبِ وَالقِرى","وَخَلائِقاً كَتَدَفُّقِ الأَنهارِ",43,"ر",1,0],["وَرِثَ الخِلافَةَ سَبعَةً آباءَهُ","عَمِروا وَكُلُّهُمُ لِأَعلى المِنبَرِ",44,"ر",1,1],["وَرِثوا مَشورَتَها لِعُثمانَ الَّتي","كانَت تُراثَ نَبِيِّنا المُتَخَيَّرِ",44,"ر",1,0],["وَرِثَ المَكارِمَ كابِراً عَن كابِرٍ","ضَخمِ الدَسيعَةِ يَومَ كُلِّ فَخارِ",45,"ر",1,0],["وَرَثَيتَها وَفَضَحتَها في قَبرِها","ما مِثلَ ذَلِكَ تَفعَلُ الأَخيارُ",46,"ر",1,0],["وَرِثتَ أَبا سُفيانَ وَاِبنَيهِ وَالَّذي","بِهِ الحَربُ شالَت عَن لِقاحٍ حِيالُها",47,"ل",3,1],["وَرِثتُم عَنِ الجارودِ قِدراً وَجَفنَةً","كَثيراً إِذا اِحمَرَّ الشِتاءُ عِيالُها",48,"ل",3,0],["وَرِثتَ أَباكَ المُلكَ تَجري بِسَمتِهِ","كَذَلِكَ خوطُ النَبعِ يَنبُتُ في الأَصلِ",49,"ل",1,0],["وَرِثتُم خَليلَ اللَهِ كُلَّ خِزانَةً","وَكُلَّ كِتابٍ بِالنُبُوَّةِ قائِمِ",50,"م",1,0],["وَرِثوا تُراثَ مُحَمَّدٍ كانوا بِهِ","أَولى وَكانَ لَهُم مِنَ الأَقسامِ",51,"م",1,0],["وَرِثتُم قَناةَ المُلكِ غَيرَ كَلالَةٍ","عَنِ اِبنِ مَنافٍ عَبدِ شَمسٍ وَهاشِمِ",52,"م",1,0],["وَرِثتَ فَلَم تُضَيِّع مَأثُراتٍ","وَقَصَّرَ عَن بِنائِكَ كُلُّ بانِ",53,"ن",1,0],["وَرَّثتَهُم فَتَفَرَّوا عَنكَ إِذ وَرِثوا","وَما وَرَثتُكَ غَيرَ الهَمِّ وَالحَزَنِ",54,"ن",1,0],["وَرَثتَ عُلاهُم وَاِقتَدَيتَ بِفَضلِهِم","فَأَنتَ إِذاً نِدَّ الكِرامِ لَهُم نِدُّ",55,"د",1,0],["ورثائي وما يفيد رثائي","لأمانٍ شقيةٍ تتبدّد",56,"د",1,0],["ورثتمْ تراثَ المجدِ من كلّ سيّدٍ","على منكبيه من حقوقِ العلا ثقلُ",57,"ل",1,0],["ورثَ العزّ من أبيه كشبلٍ","أخذَ الفتكَ عن أبيه الأبيِّ",58,"ي",1,0],["وَرِثَ الممالِكَ مِن أَبيهِ فَحازَهَا","وتُراثَ مجدٍ في الصميم مُؤثَّلِ",59,"ل",1,0],["وَرِثوا الأُبُوَّةَ وَالحُظوظَ فَأَصبَحوا","جَمَعوا جُدوداً في العُلى وَجُدودا",60,"د",2,0],["وَرِثَتْ مَناقِبُه مَناقبَ بَيْتهِ","فَبِأيِّ مَنْقَبةٍ أرادَ ازْدَانا",61,"ن",2,0],["ورثوا الكُماةَ المُعلِمينَ فما تَرى","بديارهم إلا الكمَّي المُعْلَما",62,"م",2,0],["ورثَ المالكينَ والرُّسلَ الها","دين بالحق أولاً وأخيرا",63,"ر",2,0],["وَرِثنا المَجدَ عَن كُبرا نِزارٍ","فَأَورَثنا مَآثِرَنا البَنينا",64,"ن",2,0],["وَرِثَت عَجائزها العَفاف وَما","قَدَّمنَ مِن خَيرٍ لَهُ ذِكر",65,"ر",1,0],["وَرِثتَ الخِلافَةَ عَن والِدٍ","فَأَحرَزتَ ميراثَهُ عَن كَثَب",66,"ب",1,0],["ورِثَ النُّبُوَّة فَلْيَقُم كَقِيامِهِ","مَنْ حَاوَلَ الميراثَ أَوْ فَلْيَقْعُدِ",67,"د",1,0],["وَرِثُوا الأرضَ مثلَ ما كَتَبَ الل","هُ تعالَى في الذِّكْرِ بعد الزَّبورِ",68,"ر",1,0],["وَرَثى بَعْضُهُمْ لِبَعْضٍ وَقَدْ با","نَ لَكَ الآنَ شِدَّةُ الأهوالِ",69,"ل",1,0],["وَرِثَتْ مَكارِمُهُ بَنُوهُ فَحَبَّذا","كَرمُ السَّجايا مِنْ تُراثِ كِرامِ",70,"م",1,0],["وَرِثَ المُقيمَ بيثرِبٍ فالمِنبرُ ال","أعْلى له والتُّرعَةُ العَلياء",71,"ا",2,0],["وَرِثَ الخِلافَةَ خَمسَةً","وَبِخَيرِ سادِسِهِم سَدَس",72,"س",1,0],["ورثنا المجدَ من آباءِ صدقٍ","أسأنا في ديارهمُ الصنيعا",73,"ع",2,1],["وَرِثتَ عَلِيّاً شيمَةً أَريَحِيَّةً","وَصُنتَ اِبنَ عَبّاس وَأُيِّدتَ بِالشُكرِ",74,"ر",1,0],["وَرِثتُم رَسولَ اللَهِ بَيتَ خِلافَةٍ","وَعِزّاً عَلى رَغمِ العَدُوِّ وَسُؤدَدا",75,"د",2,0],["وَرِثَ الأُبُوَّةَ كابِراً عَن كابِرٍ","تَلِدُ الضِراءَ فَهُنَّ مِن أَكسابِهِ",76,"ب",2,0],["وَرِثتَ هُدى التَذكارِ مِن قَبلَ جُرهُمٍ","أَوانَ تَرَقَّت في السَماءِ النَعائِمُ",77,"م",1,0],["وَرِثوا السُؤدُدَ عَن آبائِهِم","ثُمَّ سادوا سُؤدُداً غَيرَ زَمِر",78,"ر",1,0],["وَرِثنا المَجدَ عَن آباءِ صِدقٍ","أَسَأنا في دِيارِهِمُ الصَنيعا",79,"ع",2,1],["وَرَّثتَني وُدَّ أَقوامٍ وَخُلَّتَهُم","وَذَكرَةٌ مِنكَ تَغشاني بِإِجلالِ",80,"ل",1,0],["ورِثتُ هواها فرُمت الحياةَ","وحبَّب لي العالم المبْغَضا",81,"ض",2,0],["وَرِثَاءٌ لوْ كَان يَسْمَعُهُ المَيْتُ","لأَحْيَا بِسِحْرِهِ جُثْمَانَه",82,"ن",2,0],["وَرِثَاءُ الْبَيَانِ جُهْدُ مُقِلٍ","لِلَّذِي خَلَّدَ الزَّمَانُ بَيَانَه",82,"ن",2,0],["ورث المكارم عن أبيه ولم يزَل","يسمو بصارم عزمه المرهوب",83,"ب",1,0],["ورثتِ صفاتِ المصطفى وعلومهُ","فَفضْلُكُمَا لولاَ النُّبُوَّة ُ وَاحِدُ",84,"د",1,0]]}