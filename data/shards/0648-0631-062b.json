2063.html","الكامل"],[518,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[518,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[518,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[518,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[518,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[554,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[554,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[561,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[561,"ترنمت المثاني والمثالث","https://www.aldiwan.net/poem34697.html","الوافر"],[565,"غاب الأمير فما تمادى المرجع","https://www.aldiwan.net/poem52842.html","الكامل"],[565,"أعرفت رسم الدار أم لم تعرف","https://www.aldiwan.net/poem52886.html","الكامل"],[565,"قف بالديار وحي القوم عن كثب","https://www.aldiwan.net/poem52914.html","البسيط"],[567,"سلاماً وأهلاً أيها السيد الشهم","https://www.aldiwan.net/poem891.html",""],[570,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[578,"جرى دمعه من مسيل الأسيل","https://www.aldiwan.net/poem2885.html","المتقارب"],[578,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[578,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[578,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[889,"","https://poetry.dctabudhabi.ae/diwan/poem/105719","الكامل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10421","الوافر"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21412","الكامل"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/18993","الطويل"],[1173,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"]],"verses":[["وَرِثنا رَسولَ اللَهِ عُلويَّ مَجدِهِ","وَمُعظَمُ ما ضَمَّ الصَفا وَالمُعَرَّفُ",0,"ف",1,0],["وَرِثوا المَعالي بِالجُدودِ وَبَعدَها","بِضَرابِ مُرهَفَةٍ وَطَعنِ رِماحِ",1,"ح",1,0],["وَرِثتَ عَنِ الأَبَينِ قَناً وَبَأساً","فَأَنفَقتَ اللَهاذِمَ وَالزِجاجا",2,"ج",2,0],["وَرِثْنا العُلا وَهْيَ الَّتي خُلِقَتْ لَنا","وَنَحْنُ خُلِقْنا لِلْعُلا وَالمَحامِدِ",3,"د",1,0],["ورِثْتَ عُبَيْدَ اللهِ عمَّكَ جودَهُ","وأشْبَهْتَ عبدَ اللهِ جَدَّك سُؤْدَدا",4,"د",2,0],["ورِثَ الإمامَةَ كابِراً عن كابِرٍ","مُتَوكِّليٌّ بالعَلاءِ خَليقُ",5,"ق",1,0],["وَرِثَ الْجَلاَلَةَ عَنْ أَبِيهِ وَجَدِّهِ","فَكَأَنَّهُمْ مَا غَابَ مِنْهُمْ هَالِكُ",6,"ك",1,0],["ورثا عنِ النّدْبِ الكريمِ أبيهِما","محْضَ الوَفاءِ ورِفْعَة المِقْدارِ",7,"ر",1,0],["وَرِثَ السُؤدَدَ عَن آبائِهِ","وَغَزا فيهِم غُلاماً ما نَكَح",8,"ح",1,0],["وَرِثوا السِيادَةَ كابِراً عَن كابِرٍ","إِنَّ الكِرامَ هُمُ بَنو الأَخيارِ",9,"ر",1,0],["وَرِثَ المَجدَ وَالمَكارِمَ وَالحِل","مَ وَطيبَ الأَعراقِ جَداً فَجَدّا",10,"د",2,0],["وَرَثَّت عَلى مَرِّ اللَيالي رُسومُهُ","وَكَم رَقَّ فيهِ بِالعَشِيِّ نَسيمُهُ",11,"ه",1,0],["وَرِثِ الأَعداءَ أَعما","رَهُمُ وَالأَولِياءَ",12,"ا",2,0],["وَرِثنا المَجدَ قَد عَلِمَت مَعَدٌّ","نُطاعِنُ دونَهُ حَتّى يَبينا",13,"ن",2,0],["وَرِثنا مَجدَ عَلقَمَةَ بنِ سَيفٍ","أَبَاحَ لَنا حُصونَ المَجدِ دينا",13,"ن",2,0],["وَرِثتُ مُهَلهِلاً وَالخَيرَ مِنهُ","زُهَيراً نِعمَ ذُخرُ الذاخِرينا",13,"ن",2,0],["وَرِثناهُنَّ عَن آباءِ صِدقٍ","وَنُورِثُها إِذا مُتنا بَنينا",13,"ن",2,0],["ورِثَ السماحة عن أبيه وجَدّهِ","فالأَكرمُ ابنُ الأكرم ابنِ الأكرمِ",14,"م",1,0],["وُرَّثتَ هذا الفخرَ يا ملك الهدى","من كلِّ من آوى النَّبِيَّ ومن نَصَرْ",15,"ر",1,0],["ورثته بألسن من معالي","ه حداد تفلّ حدّ الحسام",16,"م",1,0],["وَرِثَ الأَعِنَّةَ وَالأَسِنَّةَ وَاِنتَمى","في بَيتِ مَكرُمَةٍ رَفيعِ السُلَّمِ",17,"م",1,0],["وَرِثنا ذُرى عِزٍّ وَتَلقى طَريقَنا","إِلى المَجدِ عادِيَّ المَوارِدِ مَعلَما",18,"م",2,0],["وَرِثنا مَساكِنَهُم بَعدَهُم","وَكُنّا مُلوكاً بِها لَم نَرِم",19,"م",1,0],["وَرِثتُ الفَعالَ وَبَذلَ التِلا","دِ وَالمَجدَ عَن كابِرٍ كابِرِ",20,"ر",1,0],["وَرِثنا مِنَ المَجدِ أُكرومَةً","أَحَلَّ بِها الآخِرَ الأَوَّلُ",21,"ل",1,0],["وَرِثنا سَناءً مِنهُ يَعلو وَمَحتِداً","مُنيفَ الذُرى سامي الأَرومَةِ يُذكَرُ",22,"ر",1,0],["وَرِثنا سَناءً مِنهُ بَرزاً وَمَحتِداً","مُنيفَ الذَرى فَخمَ الأَرومَةِ يُذكَرُ",23,"ر",1,0],["وَرِثنا مِنَ البُهلولِ عَمروُ بنِ عامِرٍ","وَحارِثَةَ الغِطريفِ مَجداً مُؤَثَّلا",24,"ل",2,1],["ورثتُ اللفظ عن سلفِي وا كرم","بآل نباتة الغرّ السرَاة",25,"ه",1,1],["ورثوا الشجاعة والعلى يروونها","قرشيةً عن غالبٍ ومجمَّع",26,"ع",1,0],["ورثتَهُمُ ثم أحيَيْتَهُمْ","وكم خَلَفٍ وارثٍ باعثِ",27,"ث",1,0],["ورثتَ عباسَك الوسامة وال","رأي فما ينكر امرؤ سَدَدَكْ",28,"ك",1,0],["ورثْتم بيوت النار والنور كلّها","ذوي العلم قِدماً والشؤونِ الأعاظمِ",29,"م",1,0],["وَرَثوا اِقتِحامَ البَحرِ عَن فينيقيا","أُمِّ الثَقافَةِ مَصدَرِ التَمدينِ",30,"ن",1,0],["ورثاؤك الإرشاد والعظة التي","تُلقى على العظماء والأفراد",31,"د",1,0],["ورِث الناس نعيما باطلا","وورثتم وحى ربي المنزلا",32,"ل",2,0],["ورثت الحلم عن فحل كريم","ففيك الحلم عند الصفع عادة",33,"ه",1,1],["وَرِثوا الكِتابَةَ وَالفُروسَةَ وَالحِجى","عَن كُلِّ أَبيَضَ مِنهُمُ وَضّاحِ",34,"ح",1,0],["وَرِثوا الكِتابَةَ وَالفُروسَةَ قَبلَها","عَن كُلِّ أَبيَضَ مِنهُمُ وَضّاحِ",35,"ح",1,0],["وَرِثَ النَبِيَّ سَجِيَّةً مَرضِيَّةً","وَطَريقَةً قَصَداً وَقَولاً فَيصَلا",36,"ل",2,0],["وَرِثتُ سُيوفَهُم وَمَضوا كِراماً","وَما نَفعُ السُيوفِ بِلا رِجالِ",37,"ل",1,0],["وَرِثوا السَماحَ فَأَورَثوهُ فَما تَرى","في غَيرِهِم لِلجودِ مِن مُتَلَوَّمِ",38,"م",1,0],["وَرَثتَ إِلى أَخلاقِهِ عاجِلَ القِرى","وَضَربَ عَراقيبِ المَتالي شَبوبُها",39,"ب",3,0],["وَرِثتَ اِبنَ حَربٍ وَاِبنَ مَروانَ وَالَّذي","بِهِ نَصَرَ اللَهُ النَبِيَّ مُحَمَّدا",40,"د",2,0],["وَرِثنا كِتابَ اللَهِ وَالكَعبَةَ الَّتي","بِمَكَّةَ مَحجوباً عَلَيها سُتورُها",41,"ر",3,0],["وَرِثنا عَن خَليلِ اللَهِ بَيتاً","يُطَيَّبُ لِلصَلاةِ وَلِلطَهورِ",42,"ر",1,0],["وَرِثوا الطِعانَ عَنِ المُهَلَّبِ وَالقِرى","وَخَلائِقاً كَتَدَفُّقِ الأَنهارِ",43,"ر",1,0],["وَرِثَ الخِلافَةَ سَبعَةً آباءَهُ","عَمِروا وَكُلُّهُمُ لِأَعلى المِنبَرِ",44,"ر",1,1],["وَرِثوا مَشورَتَها لِعُثمانَ الَّتي","كانَت تُراثَ نَبِيِّنا المُتَخَيَّرِ",44,"ر",