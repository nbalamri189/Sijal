رمل"],[4764,"كبوة جواد","https://www.poetsgate.com/ViewPoem.aspx?id=34021",""],[4767,"إلى شيخ مصر الشهيد حسن شحاتة","https://www.poetsgate.com/ViewPoem.aspx?id=147142",""],[5028,"الفصول الأربعه","https://www.poetsgate.com/ViewPoem.aspx?id=27714",""],[5106,"مِهْرَجَانُ الشَّمْس .","https://www.poetsgate.com/ViewPoem.aspx?id=153972",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[5484,"روع الكون وادلهم السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206305",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5694,"الآماره","https://www.poetsgate.com/ViewPoem.aspx?id=129910",""],[5950,"سكّر","https://www.poetsgate.com/ViewPoem.aspx?id=128151",""],[4442,"ذهب الورق وانطوى سلطانه","https://www.poetsgate.com/ViewPoem.aspx?id=170989",""],[6301,"مبارك هذا النجاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80679&r=&rc=43",""]],"verses":[["مُوَقَّرُ الشيمَةِ إِن جاذَبَت","مَقالَهُ يَومَ الجِدالِ الخُصوم",0,"م",1,0],["موقَراً يَحبِسُني عَن غايَتي","لا المَدى يُطوى وَلا العِبءُ يُحَطّ",1,"ط",1,0],["مَوقِفاً يَجمَعُ فِتيا","نَ الهَوى وَالفَتَياتِ",2,"ت",1,0],["مُوَقَّرونَ وَأَيدي الحِلمِ طائِشَةٌ","وَالجِدُّ يُنقِصُ مِن أَطرافِهِ اللَعِبُ",3,"ب",1,0],["مَوقِفٌ مُيِّزَ لِلرَكبِ","بَرِيّاً مِن مُريبِ",4,"ب",1,0],["موقِدٍ ناراً أَضاءَت","فَوقَ فودَيَّ عُيوبي",4,"ب",2,0],["مَوقِفُهُ في الفَتكِ لا يُشتَهى","وَنارُهُ في الحَربِ لا تُصطَلى",5,"ل",2,0],["مُوقِناً أَنَّ عِيشَةَ الذَّ","لِّ لا تَفْضُلُ الْعَدَمْ",6,"م",1,0],["مُوَقّاةٌ إِذا تُرمى صَيودٌ","مُلَقّاةٌ إِذا تَرمي الكِراما",7,"م",2,0],["مُوَقَّفَةُ القَوادِمِ وَالذُنابى","كَأَنَّ سَراتَها اللَبَنُ الحَليبُ",8,"ب",1,0],["مُوَقَّعَةُ الصَفقَينِ حَدباءَ شارِفٌ","تُقَيَّدُ أَحياناً لَدَيهِم وَتُرحَلُ",9,"ل",1,0],["موقف فيه ادمع القوم صرعى","دمها فوق ارضه مطلول",10,"ل",1,0],["موقف تنطق العواطف فيه","بتباريحها وتعيا العقول",10,"ل",1,0],["موقعي عند لا أعلمه","آه لو يعلم عندي موقعك",11,"ك",1,0],["مَوقِفُ التاريخِ مِن فَوقِ الهَوى","وَمَقامُ المَوتِ مِن فَوقِ الهَذَر",12,"ر",1,0],["مَوقِعي عِندَكَ لا أَعلَمُه","آهِ لَو تَعلَمُ عِندي مَوقِعَك",13,"ك",1,0],["مَوقِفَ العاجِزِ مِن حِلفِ الوَغى","يَحرُسُ الأَحمالَ أَو يَسقي مُصابا",14,"ب",2,0],["مَوقِعُهُ في فِراشِ هامِهِمُ","وَريحُهُ في مَناخِرِ السيدِ",15,"د",1,0],["مَوقِعُ الخَيلِ مِن نَداكَ طَفيفُ","وَلَوَ أَنَّ الجِيادَ فيها أُلوفُ",16,"ف",1,1],["مُوَقَّعَةٍ بِبَياضِ الرُكو","بِ كَهودِ اليَدَينِ مَعَ المُكهِدِ",17,"د",1,0],["مُوَقَّعَةٌ أَكتافُها مِن رُكوبِهِ","وَتُعرَفُ بِالكاذاتِ مِنها مَنازِلُه",18,"ل",2,0],["مَوقِفٌ لو لم يكن ناراً إذاً","لم تكُنْ زُرْقُ عَواليهِ شرَر",19,"ر",1,0],["مَوْقِفٌ لو أطَلَّ كِسْرى عليه","لانْثَنّى كاسِفاً وفيه انْكِسارُ",20,"ر",1,0],["موقفٌ حانَ فاغتنم","وتخير من الكلم",21,"م",1,1],["موقداً للغريب نار ضلوعي","فعسى للغريب فيها اهتداء",22,"ا",2,0],["مُوَقَّرُونَ كِرَامٌ لا يَخِفُّ بِهِمْ","طَيْشٌ وَلَمْ يَجْرِ فِي أَخْلاقِهِمْ سَفَهُ",23,"ه",1,0],["مَوقوفةَ السَّعي ما يَمشي الزّمانُ بها","كأنّ آمالَها شُدَّتْ بِأَمْراسِ",24,"س",1,0],["مُوقَرَاتٍ أقبلتْ في جُزُرٍ","تَطردُ العُسْرَ بِيُسْرٍ وَرَغَدْ",25,"د",1,0],["مُوَقَّراً بِمائِهِ","قَد أَتَمَّ حِيَلا",26,"ل",2,0],["موقف جد للفراق كلانا","عنده كان الباكي المبكيا",27,"ي",2,0],["موقف لِلغَرام في كل صوب","جامع للفتيان والفتيات",28,"ت",1,0],["مُوقَراتٌ منَ اللُّحُوم وفيهَا","لُطُفٌ في البنَانِ والأَوساطِ",29,"ط",1,0],["مَوْقِفٌ عُدَّتِ الوِزَارَةُ وِزْراً","فِيهِ وَالمُنْذِرَاتُ سُحْبٌُ رُكَامُ",30,"م",1,0],["مُوْقِدَةً فِي كُلِّ قَلْبٍ فَجْرَا","وَفِي غَدٍ شَمْسٌ سَنَاهَا شُهْدُ",31,"د",1,0],["موقفي تعرفينه .. فتواري","عن طريقي يا من أضعتي الطريقا",32,"ق",2,0],["مُوَقّىً في الخَطيرِ وَذي المَعالي","نَوائِبَ ما تَرَكتَ لَها اِحتِكاما",33,"م",2,0],["موقفاً مدهشاً تكافح في نز","عات نفس تشب كالنيران",34,"ن",1,0],["موقف جلّ عن الشعر فهل","يكمل التاريخ بدء الشعراء ؟",35,"ا",2,0],["موقف جار فيه حكُم التصابي","وأصاب الأسَى العزاءَ فبزه",36,"ز",2,0],["مَوقِعُها مِن فَضلِهِ مَوقِعُ ال","قَطرَةِ يُلقيها إِلى بَحرِ",37,"ر",1,0],["موقناً أن لا سواهُ","كاشفٌ ضرّاً وضنكا",38,"ك",2,0],["موقعة بنار بعدٍ موصدَهْ","عن حضرة الرحمن باتت مبعدَهْ",39,"ه",1,0],["موقعُ النجم في الحمى الشرقيّ","قد تراءى في المركز الغربيّ",40,"ي",1,1],["مَوْقِفٌ للنّصْرِ يَنْعي النّصارى","فاضِحٌ للنّوحِ مِلء النّواحي",41,"ح",2,0],["مَوقِفٌ ما أَمَرَهُ","آهٍ ما كانَ أَفظَعُ",42,"ع",1,0],["مَوقِفٌ ضَمَ شائقاً ومَشوقاً","لفِراقٍ وجازِعاً وجَليدا",43,"د",2,0],["مَوقِفٌ مُرُّ المَذاقِ فَإِن","حَدَّثوا عَنهُ فَكَالعَسَلِ",44,"ل",1,0],["مَوقِفُ البَينِ كالسَّما تَرى في","هِ عُيُوناً مُنهلَّةً كالغَمامِ",45,"م",1,0],["مَوقف بِالنهار غَير مُريبٍ","وَاِجتِماعٌ بِاللَيلِ عِندَ المَساجِد",46,"د",1,0],["مَوقَّف أَنصاف اليَدَين كَأَنَّهُ","إِذا راحَ يَجري بِالصَريمَة رامحُ",47,"ح",1,0],["مَوقفُ تَوديعٍ ترى البيضَ به","شُهباً وهَابي النّقعِ ليلاً أسودَا",48,"د",2,0],["موقف التوديع كم أجْرَيْتَ لي","عبراتٍ رخصت وهي غوالي",49,"ل",2,0],["موقراتٍ بما حملن من الماء","رواءً إلى الديار الصوادي",50,"د",2,0],["موقفٌ أنت أخوه وابنه","غلبَ الناسُ عليه بالجهالَهْ",51,"ل",2,0],["موقظٌ تربَكِ من غير ضرارٍ","ممرِضٌ ريحَك من غير اعتلالِ",52,"ل",1,0],["موقَّر المجلس إما هو في ال","دست احتبى أو ركن ثهلان رسا",53,"س",2,0],["موقَّراً متَّعظاً شبابهُ","كأنما كان مَشيباً أَسْودا",54,"د",2,0],["موقَّرُ ما أقلَّ السرجُ ثَبْتٌ","إذا مالت من الرَّهَج اللُّبودُ",55,"د",1,0],["مُوَقَّر النادي ضحوك الندَى","يلقاك بالمُرغِب والمُرهِب",56,"ب",1,0],["موقَّرٌ وحُبى الأقوامِ طائشةٌ","للخطب يحسدهُ الشُّمُّ الشناخيب",57,"ب",1,0],["مُوَقَّرَةٌ يَقتادُ ثِني زِمامِها","بَصيرٌ بِأَدواءِ الكَريهَةِ وَالحَربِ",58,"ب",1,0],["موقّى العِرضِ في سَنَنِ السّجايا","مُبيدُ المالِ في سَبْقِ النّوالِ",59,"ل",1,0],["مُوَقَّفِ المَتنِ لا تَمضي السَبيلَ بِهِ","إِلّا التَخَلُّلَ رَيثاً بَعدَ تَجهيدِ",60,"د",1,0],["مَوقِفٌ هائلٌ وسيفٌ كليلٌ","وكِلا الجانبينِ داعي القُصورِ",61,"ر",1,0],["مَوقِفٌ تَخَشَّعَ النَواظِرَ فيهِ","وَتُسَوّى الرُؤوسُ وَالأَقدامِ",62,"م",1,0],["موقف للرقيب لا أنساه","لست أختاره ولا آباهُ",63,"ه",1,1],["مُوقِظُ طَرْف الرأي في حيث لا","يَسطيعُ أهلُ الرأي إِيقاظَه",64,"ظ",2,0],["مُوقّعُ ديوانِ الخَليفَةِ شاهِنا","وما كلُّ توقيعٍ كَتَوقيعِ راغِبِ",65,"ب",1,0],["موقفٌ يترك اجنة شيبا","ومَقام يُذَهِّل الألبابا",66,"ب",2,0],["موقدُ النّار يَسكِنُ","لا تُعِقْ مجمَرَ اللظى",67,"ظ",2,0],["مُوَقّىً صُروفَ النَّائِباتِ نَزيلُهُ","ولا عِزَّ في الدُّنيا لِمْن ذَلَّ صاحِبُهْ",68,"ب",2,0],["موقف فيه كم لطيف دنو","ومحل تضيق فيه المجالي",69,"ل",2,0],["موقف الحساب ولا أحس","به جنة ولا أنسابه",70,"ب",2,0],["موقرا حضرته دائما","ملازما للصمت أو فكره",71,"ر",2,0],["موقداً ناره على نشز الأر","ض إذا الناس لبسوها القفاعا",72,"ع",2,0],["موقف يستوى لديه كبير","وصغير ويستبين الخفيَّا",73,"ي",2,0],["موقَّرُ المجلسِ ذو ركانةٍ","حبوتُه على شمامٍ تُعقَد",74,"د",1,0],["موقف الليث أغضبته عوادٍ","من جنود الردى أحاطت بشبل",75,"ل",1,0],["موقفَ التوديع لا كنت وَلا","كان طيرٌ بنواها تعبا",76,"ب",2,0],["موقف تقصر عن غاياته","نجب المدح وإن كانت كراما",77,"م",2,0],["مَوقِعُها مِن كُلِّ ذي بِدعَةٍ","مَوقِعُ وَسمِ النارِ أَو أَكثَرُ",78,"ر",1,0],["موقفٍ مَرّ وعبر خلّه يروح","عادتك تعبر مساحات الجهل",79,"ل",1,0],["موقف البين آية العاشقين","ما جرى العين فيه إلا حزينا",80,"ن",2,1],["موقٌ حاشدٌ وحشرٌ مهيبٌ","قد أحاطته ألسُنُ النيرانِ",81,"ن",1,0],["موقفٌ يورثُ الذهولَ عسيرٌ","ملأَ الرعبُ فيه كل مكانِ",81,"ن",1,0],["موقٌف للحسابِ لا ريبَ فيه","لم يغيب عن حشدهِ أصغرانِ",81,"ن",1,0],["موقفٌ حاشدٌ وحشرٌ رهيبٌ","وقيامٌ أهوالُهُ فَزعاء",82,"ا",2,0],["موقنا ان غيره لم يهل","ولا يقي في رغب ورهب",83,"ب",1,0],["موقف ينفطر القلب له","ويلذ الموت في مزدحم",84,"م",1,0],["موقف الذل وهل يرضى به","من سرت فيه دماء الشرفا",85,"ف",2,0],["موقفاً أقضي به حقّ الهوى","معرباً في بث أشواقي التلادِ",86,"د",1,0],["موقف أحيت به للمصطفى","شرعة من بعدما البغي محاها",87,"ا",3,0],["موقفي فوقهن ناش وطفلا","قد غذتني بدرها ثديدها",88,"ا",1,0],["مَوقف مِنهُ رُجَّت الأَرض رَجّاً","وَالجِبال اضطربنَ فَهِيَ تَميد",89,"د",1,0],["موقناً أَن البهارَ المرتضى","بَهرَ الاملاكَ حالاً وحُلا",90,"ل",2,0],["موقف للنهى ولا سيما من","بغوالي ذكراه سار الركاب",91,"ب",1,0],["موقف لا يمثل الفكر أبهى","منه في نومه وفي يقظاتِه",92,"ت",2,0],["موقف للجمال فيه مزايا","ولكم للجمال فيه مزيه",93,"ي",2,0],["موقف كم أتى له من امام","عالما بالذى له قد دعاكا",94,"ك",2,0],["موقعها من تحت وصف الرامي","بالقرب من كواكب النعام",95,"م",1,0],["موقِفٌ هولُهُ مخوفٌ عَظيمٌ","كَم يُرى فيهِ مِن خطوبٍ جِسامِ",96,"م",1,0],["مَوقِفٌ يأخذ الهَوى منه ما شا","ء وَيعطي من الهَوى ما شاءا",97,"ا",2,1],["موقف لم يدع لذي الروح روحا","يوم حزوى ولا لذي العقل عقلا",98,"ل",2,0],["موقّر الشيمةِ إِن جاذَبَت","يَوماً يَد الخَفة عِطف الوَقار",99,"ر",1,1],["مَوقفٌ يَعجزُ البواسلُ فيهِ","وَيردُّ الرِجالَ مَثنى وَموحدْ",100,"د",1,0],["مَوقِفٌ لِلفِراقِ ما نِلتُ مِنهُ","غَيرَ طَيفٍ قَد زارَ وَهنا وَوَلّى",101,"ل",2,0],["مَوقف لِلعُقول فيهِ التِفاتا","ت وَلِلقَلب وَثبة مِن مَكانه",102,"ن",2,0],["مَوقف حفت المَلائك جَنبيه","وَصَفت صُفوفَها لِأزدِيانه",102,"ن",2,0],["موقد الغرب أج في الشرق حتى","سطعت ناره وثار دخانه",103,"ن",2,0],["موقف البين مأتم العاشقينا","لا ترى العين فيه الا حزينا",104,"ن",2,1],["مُوَقَّرَةٍ بِالطَعنِ في ثُغُراتِها","يَجُلنَ وَيَحطِمنَ الحَصى بِالسَنابِكِ",105,"ك",1,0],["موقفٌ ليس بسهلٍ لفتاتْ","لم تَجُزْ في العمر عشرينَ ربيعْ",106,"ع",1,0],["موقفي بعد الجسارة انقلب موقف حياد","والعمر من زود شيله ضاق ما عاد احتمل",107,"ل",1,0],["موقفُ المسؤول هذا","فيه تجسيد الخيانة",108,"ن",2,0],["موقعك من قلبي تدلّه بس حدّد موقعي","وبعدين خذ قلبي وفي دنيا غرامك ضيّعه",109,"ع",2,0],["مُوْقَداً فِيْ حَرَمِ النُّورِ كُهْنَاً","لِنُرَىْ فِيْ خِصْيَتيْهِ مَنِيَّا",110,"ي",2,0],["موقد الناربات يجمره الق","ين بنفخٍ يطير منه الشرارا",111,"ر",2,0],["موقفي لاما يوصَّف ما يشبه","ما يعرفه غير من سوا مثيله",112,"ل",2,0],["موقف زهدني في","هذه الدنيا الدنيه",113,"ي",2,0],["موقفٌ يعجز الألباء عنه","ما استطاعوا بلاغةً وبيانا",114,"ن",2,0],["موقف للحسين جل عن الوصف","ولم ترو مثله الامناء",115,"ا",2,0],["موقِدا ً قِنديلَه ُ منها","متى شد َّ رحيلهْ",116,"ل",2,0],["موقف الرجال يعرف غني ولا فقير","الغنى والله غنى العقل كان الله عطاه",117,"ا",2,0],["مو قبلك الناس سمّوا (صقر )ما وكّر","و(صلاح) .. ولا إستعدنا القدس وأمجاده !",118,"د",2,0],["موقد الغرب أج في الشرق حتى","سطعت ناره ونار دخانه",119,"ن",2,0],["مُؤَقٌ أُسِفَّتْ لحْظُها بالإثْمِدِ","رمداءُ من رهَق وإن لم ترَْمدِ",120,"د",1,1]]}