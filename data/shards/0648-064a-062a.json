{"poems":[[100,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[57,"رأيت العلم صاحبه كريم","https://www.aldiwan.net/poem24641.html","الوافر"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[71,"سرى والليل مزور الجنوب","https://www.aldiwan.net/poem3944.html","الوافر"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[10,"يا عين بكي على صخر لأشجان","https://www.aldiwan.net/poem20943.html","عموديه"],[88,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[47,"ماكنت مذ كنت إلا طوع خلاني","https://www.aldiwan.net/poem25115.html","البسيط"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[23,"أمسى الخلابيس قد عزوا وقد كثروا","https://www.aldiwan.net/poem21404.html","البسيط"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[51,"ويتيمة من كرمها ومديمها","https://www.aldiwan.net/poem66037.html","الكامل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[62,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[49,"هل الدهر إلا ليلة ثم يومها","https://www.aldiwan.net/poem64200.html","الطويل"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[44,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[105,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[105,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[102,"أرأيت مملكة الربي","https://www.aldiwan.net/poem32947.html","مجزوء الكامل"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[52,"أهاجك أم لا بالدويرة منزل","https://www.aldiwan.net/poem26757.html","الطويل"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54759","المنسرح"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5788","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199493","المتقارب"],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[100,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[100,"إلى قارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50126",""],[129,"بنينا بأرض الله لله مسجدا","https://www.aldiwan.net/poem50632.html","الطويل"],[135,"ألا هل أتى بحرينا صنع ربنا","https://www.aldiwan.net/poem20995.html","الطويل"],[161,"الدين دين ربنا والملك","https://www.aldiwan.net/poem59186.html","الرجز"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[187,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[187,"أحب بنيتي ووددت أني","https://www.aldiwan.net/poem43904.html","الوافر"],[187,"إذا فتح امرؤ للوصل بابا","https://www.aldiwan.net/poem44144.html","الوافر"],[188,"يا عين بكي لمسعود بن شداد","https://www.aldiwan.net/poem2248.html","البسيط"],[226,"وهبتك يا دهر من تطلب","https://www.aldiwan.net/poem55095.html","المتقارب"],[230,"يا من حوى الفضل وحاز الفخرا","https://www.aldiwan.net/poem51069.html","الرجز"],[305,"ما طاب قلبي ولا فؤادي","https://www.aldiwan.net/poem16779.html","مخلع البسيط"],[305,"الناس في ضيق وفي حرج","https://www.aldiwan.net/poem16866.html","الكامل"],[305,"يا من هواهم أقام","https://www.aldiwan.net/poem16886.html","المجتث"],[329,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[329,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[349,"إبعث بذى قرنين من لي به","https://www.aldiwan.net/poem20729.html","السريع"],[365,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[365,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[365,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[378,"اليوم تخفق دون أرباب الهدى","https://www.aldiwan.net/poem59150.html","الكامل"],[378,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[392,"فاز المخفون في اليوم العظيم الطويل","https://www.aldiwan.net/poem54542.html","عموديه"],[392,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[401,"أيها القانون","https://www.aldiwan.net/poem6781.html","عموديه"],[403,"كنانة عز فوقت للعدى نصلا","https://www.aldiwan.net/poem46921.html","الطويل"],[404,"ولأهل هذي الهجرتين من الأذى","https://www.aldiwan.net/poem33397.html","الكامل"],[404,"سؤال فهل مفت عليه يحرر","https://www.aldiwan.net/poem33932.html","الطويل"],[404,"وأقبح من كل ابتداع سمعته","https://www.aldiwan.net/poem33954.html","الطويل"],[433,"ينافر إيقاعه صوته","https://www.aldiwan.net/poem12359.html","المتقارب"],[435,"خليلي هل أعطيتما اللحظ حقه","https://www.aldiwan.net/poem25307.html","الطويل"],[440,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[450,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[459,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[459,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[459,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[462,"الشعر ما علم العلياء واكتسبت","https://www.aldiwan.net/poem15439.html","البسيط"],[462,"يجلي العظيمة من غير فخر","https://www.aldiwan.net/poem15580.html","المتقارب"],[462,"حلفت بالواضحات الغر مسفرة","https://www.aldiwan.net/poem15907.html","البسيط"],[483,"أرجو الذي سجدت له الأكوان كر","https://www.aldiwan.net/poem24489.html","عموديه"],[501,"متى يشتفى القلب المقرح يا سعد","https://www.aldiwan.net/poem37664.html","الطويل"],[525,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[539,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[559,"ثلاث عليها يدور","https://www.aldiwan.net/poem34506.html","مجزوء المتقارب"],[568,"يا حبذا الصرة أهدى لنا","https://www.aldiwan.net/poem69727.html","السريع"]],"verses":[["ويتيماً فتبنته السما","وتبنى عطفه كل اليتامى",0,"م",2,0],["وَيَتَّبِعونَهُ في كُلِّ حالٍ","كَراعي الضَأنِ تَتبَعُهُ السَوامُ",1,"م",1,0],["ويتبعُ آثَارَ الْمَطِيّ مُشَيِّعاً","وَقَدْ زَمْزَمَ الْحَادِي وَحَنَّ نَجيبُ",2,"ب",1,0],["وَيُتحِفُ مِصرَ آناً بَعدَ آنٍ","بِمَجلودٍ وَمَقتولٍ شَهيدِ",3,"د",1,0],["وَيَتلو أَرنَبَ الجَبّارِ كَلبٌ","تَراهُ قَد تَهَيَّأَ لِلوُثوبِ",4,"ب",1,0],["وَيَتيمٍ رَأى لَهُ مِن أَيادي","كَ أَباً مُشفِقاً وَأُماً وَمَهدا",5,"د",2,0],["ويَتْرُكُ القِرْنَ مُصْفَرّاً أنامِلُهُ","كَأنّ في رَيْطَتَيْهِ نَضْحَ أُرْقانِ",6,"ن",1,0],["ويترك الناس في دهياءَ مظلمة","يَرتدُّ منها بياض الشمس حُلبوبا",7,"ب",2,0],["وَيُتبِعُ الذَنبَ ذَنباً حينَ يَعرِفُني","عَمداً وَأُتبِعُ غُفراناً بِغُفرانِ",8,"ن",1,0],["وَيَتَّقي الحَيَّ مِن جاءٍ وَغادِيَةٍ","كَيفَ الوُصولُ إِذا مانامَ سامِرُهُ",9,"ر",2,0],["وَيَترُكوا اللاتَ وَالعِزّى بِمَعزِلَةٍ","وَيَسجُدوا كُلُّهُم لِلخالِقِ الصَمَدِ",10,"د",1,0],["ويتيم من لؤلؤِ الثغر حلوٌ","راح في مثله الرشيد غويّا",11,"ي",2,0],["ويتيمةٍ من كَرمها ومُدِيمِها","لم يُبْقِ منها الدهرُ غيرَ صَميمِها",12,"م",3,1],["ويتخذ التَّنُّومَ والشرْيَ مرتعاً","فيخذم مِنْ هذا وهذاك ما خَذَمْ",13,"م",1,0],["وَيَتَوارى في نَهارِيَ السَنا","أَو وَتَبَدّى حانِقَ الشَمسِ",14,"س",1,0],["ويتفق منه الذي","ما كان بالمتفق",15,"ق",1,0],["وَيَترُكنَ أَزواجَ الغَيورِ لِغَيرِهِ","وَيَقسِمنَ ما بَقّى الشَحيحُ مِنَ الوَفرِ",16,"ر",1,0],["ويَترُكونَ إِذا جَيشَا الوَغى انتَظَما","سَلخاً كَساه حديداً حَيّةٌ ذَكرُ",17,"ر",1,0],["وَيُتبِعُ نِعمَتي بِكَ عَينَ ضِغنٍ","كَما نَظَرَ اليَتيمُ إِلى الوَصِيِّ",18,"ي",1,0],["ويتلو عليهم في محاريبهِ العُلَى","كتاباً من الإِقدامِ والبأسِ مُحكَما",19,"م",2,0],["وَيترُكُ بأسَهُمْ ضَعْفاً وعَجْزا","فَمَنْ للقومِ إن وَقَعَ الصّدامُ",20,"م",1,0],["ويتركُ كلَّ مُمتنعٍ مَهيلا","لِمَنْ يَرِثُ الممالكَ لا سِواهُ",21,"ه",1,0],["ويُتَوَّجُ الراعي بها","ملِكاً رعيَّتُه القطيع",22,"ع",1,0],["وَيُترَكُ أَمثالي عَلى أَنَّ سَعيَنا","سَنا الأَصلِ عِندَ المُضلِعاتِ رَفوعُ",23,"ع",1,0],["وَيَتَّبِعُ الآمالَ مَوقِعَ لَحظِهِ","فَلَيسَ لَهُ ما عاشَ في الناسِ مَنزِلُ",24,"ل",1,0],["وَيَتَّقي الصارِمَ العَض","بَ أَن يُباشِرَ غَربَه",25,"ب",2,0],["وَيَترُكنَ الرَشيدَ بِغَيرِ لُبٍّ","أَتَينَ لِهَديَه مُتَعَلِّماتِ",26,"ت",1,0],["ويتلون الروح التي أمس قد نأت","فواتح يهدى في تلاوتها الأجر",27,"ر",1,0],["وَيَتْرُكُ اللَّوْمَ حَائِراً وَجِلاً","مُنْعَقِداً فِي لِسَانِ مُنْتقد",28,"د",1,0],["وَيَتعَبُ مَن يَلومُ وَلَيسَ يَدري","حَديثي في مَحَبَّتِهِ طَويلُ",29,"ل",1,0],["ويتيمات فنون جمة","حسبت من معجزات الأول",30,"ل",1,0],["ويتلو عليك .. عيون القصيد","ويرقب عينيك .. يرجو الصدى",31,"د",2,0],["ويتيمةٍ خلَّفتَها وكأنها","«ليلى» تُردِّد: «ليت للبَرَّاق»!",32,"ق",1,0],["ويتعب في دنياه من دقَّ حسُّهُ","وأُوتِي ذِهْنًا للحوادث واعيا",33,"ي",2,0],["ويتوبون يستعذبون بالله","لأن الإناث نبع المفاسد",34,"د",1,0],["ويتّقد الشوق في مقلتيه","ويظمأ في شفتيه العتاب",35,"ب",1,0],["ويُتْلَى كتابُ الله فيك تبرعاً","وتذكرُ بالخيراتِ في كلِّ مَشهدِ",36,"د",1,0],["وَيُترَكَ حَرّاثٌ يُقَلِّبُ أَمرَهُ","أَيُتهِمُ فيها عِندَ ذاكَ وَيُنجِدُ",37,"د",1,0],["ويتركوا مقالة ابن عربي","لقول من يقوله التبرك",38,"ك",1,0],["ويترك ما جاءت به الرسل من هدى","لأقوال هذا الفيلسوف المغادر",39,"ر",1,0],["ويتّقون ذهاب الشمس محرقةً","بهرام في السر إذا أفضت إلى زحل",40,"ل",1,0],["ويتبع ذاك في بأمّ صدق","فتؤنس بنتها وأعيش وحدي",41,"د",2,0],["ويتلو ذلك العتب اعتذار","ويبلغ ذلك العذر ارتياب",42,"ب",1,0],["ويتركُ القِرْنَ مُصْفَرّاً أناملُه","كأنَّ أثوابَه مُجَّتْ بفُرصادِ",43,"د",1,0],["وَيَتعَبُ بِالزادِ فيها الفِقير","وَأهلُ الغنى بِالغِنى أتعَبُ",44,"ب",1,0],["ويتبِع المعروفَ منه العُذْرا","ويبذل المال ويَشْري الشُكْرا",45,"ر",2,0],["ويترك الكل في هواكم","ولا يبالي بمن يحادي",46,"د",2,0],["ويتركونا كالبهائم والأ","نعام لا تصغي إلى الحجج",47,"ج",1,0],["ويتقي ذا الجلال","فيه الشهيد الرقيب",48,"ب",1,0],["ويتمّ الهدى ويعلو صداه","ويعمّ الإسلام كلّ الرحاب",49,"ب",1,0],["ويتوَّج رأسي بما ضفّرته","يده من أزاهر وطيوب",50,"ب",1,0],["وَيَتبَعُ الجَزَّارُ حُكمي فَلا","يَلقانيَ الدَّهرَ بِعِصْيانِ",51,"ن",1,0],["ويَتْبَعُه كرامُ النّاسِ طُرّاً","كما تَبعَ السِّنانَ السَّمْهَريّ",52,"ي",1,0],["ويَتركُ الحِلْمُ منّا لُدَّ ألسِنةٍ","وهُنّ كاللُّجمِ في الأفواهِ تَنعلِك",53,"ك",1,0],["وَيُتابعَ الأعيادَ نَحوك يَنْثَنِي","عِيدٌ ويُقْبِلُ بالمَيامِن عِيد",54,"د",1,0],["ويتوب حقّاً عن خطايا شعبه","ويَقَرُّ في كرسي أبيه ويجلس",55,"س",1,0],["ويتوب لكن يا لتوبة هالكٍ","ما تاب يوم خَطائه وزِنائه",56,"ا",3,0],["ويترك الإثم كله جله والدقيل","هذا له الفوز بالجنة وظل ظليل",57,"ل",1,0],["ويتهاون بها أو","يجى بعض الخطيات",58,"ت",1,0],["ويُتيحونَ مجالاً لدَعَاوى","تجرف النَّاس إلى دربِ الضَّلالِ",59,"ل",1,0],["ويتبعُه في القولِ والفِعْل مثلما","حكَى قبلَهُ من جدّه القولَ والفِعلاَ",60,"ل",2,0],["ويتابع الآباء في أديانهم","هذي مقالة عابدي الأوثان",61,"ن",1,0],["ويتركنا من قول زيد وعمره","ولكن كتاب أو حديث محرَّرُ",62,"ر",1,0],["ويتبع أقوال النبي محمد","وهل غيره باللّه في الشرعي من يهدي",63,"د",2,0],["ويتبعه زامرٌ مثلُهُ","تَليعٌ له نَفَسٌ أَوْقَصُ",64,"ص",1,0],["ويتركها مرُّ القبول كما انثنت","معاطفُ ثوبي راقصٍ قد تكسرا",65,"ر",2,0],["ويَتْركَ المَلِكَ الجَبَّارَ مُخْتَلَعاً","عنهُ رِداء العُلا والعِزِّ مُسْتَلَبا",66,"ب",2,0],["ويترجم الحب الجميل قصائد","تروى وكم للحب من آثار",67,"ر",1,0],["ويتَّقي ما تتَّقي برُسغِهِ","وهي على بطونها الأراقمُ",68,"م",1,0],["ويُتمُّ كلَّ نقيصةٍِ بكماله","كالرمح متموماً بباعٍ عاشرِ",69,"ر",1,0],["ويتركها وسواءَ الطريق","تساقُ إلى غايتيها وتُجرَى",70,"ر",2,0],["ويُتْبعُ الحلم اِحْساناً يُظاهرهُ","ففي المساندِ منه البحرُ والجبلُ",71,"ل",1,0],["ويَتَّخِذُ الحمدَ فرْضاً عليه","اذا ما رآهُ بنو المجْدِ وضنَّه",72,"ه",1,0],["ويترك القِرن شِلواً لا حَراك به","