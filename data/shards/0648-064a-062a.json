{"poems":[[100,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[57,"رأيت العلم صاحبه كريم","https://www.aldiwan.net/poem24641.html","الوافر"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[71,"سرى والليل مزور الجنوب","https://www.aldiwan.net/poem3944.html","الوافر"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[10,"يا عين بكي على صخر لأشجان","https://www.aldiwan.net/poem20943.html","عموديه"],[88,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[47,"ماكنت مذ كنت إلا طوع خلاني","https://www.aldiwan.net/poem25115.html","البسيط"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[23,"أمسى الخلابيس قد عزوا وقد كثروا","https://www.aldiwan.net/poem21404.html","البسيط"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[51,"ويتيمة من كرمها ومديمها","https://www.aldiwan.net/poem66037.html","الكامل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[62,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[49,"هل الدهر إلا ليلة ثم يومها","https://www.aldiwan.net/poem64200.html","الطويل"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[44,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[105,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[105,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[102,"أرأيت مملكة الربي","https://www.aldiwan.net/poem32947.html","مجزوء الكامل"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[52,"أهاجك أم لا بالدويرة منزل","https://www.aldiwan.net/poem26757.html","الطويل"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54759","المنسرح"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5788","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199493","المتقارب"],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[100,"ياقارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50457",""]],"verses":[["ويتيماً فتبنته السما","وتبنى عطفه كل اليتامى",0,"م",2,0],["وَيَتَّبِعونَهُ في كُلِّ حالٍ","كَراعي الضَأنِ تَتبَعُهُ السَوامُ",1,"م",1,0],["ويتبعُ آثَارَ الْمَطِيّ مُشَيِّعاً","وَقَدْ زَمْزَمَ الْحَادِي وَحَنَّ نَجيبُ",2,"ب",1,0],["وَيُتحِفُ مِصرَ آناً بَعدَ آنٍ","بِمَجلودٍ وَمَقتولٍ شَهيدِ",3,"د",1,0],["وَيَتلو أَرنَبَ الجَبّارِ كَلبٌ","تَراهُ قَد تَهَيَّأَ لِلوُثوبِ",4,"ب",1,0],["وَيَتيمٍ رَأى لَهُ مِن أَيادي","كَ أَباً مُشفِقاً وَأُماً وَمَهدا",5,"د",2,0],["ويَتْرُكُ القِرْنَ مُصْفَرّاً أنامِلُهُ","كَأنّ في رَيْطَتَيْهِ نَضْحَ أُرْقانِ",6,"ن",1,0],["ويترك الناس في دهياءَ مظلمة","يَرتدُّ منها بياض الشمس حُلبوبا",7,"ب",2,0],["وَيُتبِعُ الذَنبَ ذَنباً حينَ يَعرِفُني","عَمداً وَأُتبِعُ غُفراناً بِغُفرانِ",8,"ن",1,0],["وَيَتَّقي الحَيَّ مِن جاءٍ وَغادِيَةٍ","كَيفَ الوُصولُ إِذا مانامَ سامِرُهُ",9,"ر",2,0],["وَيَترُكوا اللاتَ وَالعِزّى بِمَعزِلَةٍ","وَيَسجُدوا كُلُّهُم لِلخالِقِ الصَمَدِ",10,"د",1,0],["ويتيم من لؤلؤِ الثغر حلوٌ","راح في مثله الرشيد غويّا",11,"ي",2,0],["ويتيمةٍ من كَرمها ومُدِيمِها","لم يُبْقِ منها الدهرُ غيرَ صَميمِها",12,"م",3,1],["ويتخذ التَّنُّومَ والشرْيَ مرتعاً","فيخذم مِنْ هذا وهذاك ما خَذَمْ",13,"م",1,0],["وَيَتَوارى في نَهارِيَ السَنا","أَو وَتَبَدّى حانِقَ الشَمسِ",14,"س",1,0],["ويتفق منه الذي","ما كان بالمتفق",15,"ق",1,0],["وَيَترُكنَ أَزواجَ الغَيورِ لِغَيرِهِ","وَيَقسِمنَ ما بَقّى الشَحيحُ مِنَ الوَفرِ",16,"ر",1,0],["ويَترُكونَ إِذا جَيشَا الوَغى انتَظَما","سَلخاً كَساه حديداً حَيّةٌ ذَكرُ",17,"ر",1,0],["وَيُتبِعُ نِعمَتي بِكَ عَينَ ضِغنٍ","كَما نَظَرَ اليَتيمُ إِلى الوَصِيِّ",18,"ي",1,0],["ويتلو عليهم في محاريبهِ العُلَى","كتاباً من الإِقدامِ والبأسِ مُحكَما",19,"م",2,0],["وَيترُكُ بأسَهُمْ ضَعْفاً وعَجْزا","فَمَنْ للقومِ إن وَقَعَ الصّدامُ",20,"م",1,0],["ويتركُ كلَّ مُمتنعٍ مَهيلا","لِمَنْ يَرِثُ الممالكَ لا سِواهُ",21,"ه",1,0],["ويُتَوَّجُ الراعي بها","ملِكاً رعيَّتُه القطيع",22,"ع",1,0],["وَيُترَكُ أَمثالي عَلى أَنَّ سَعيَنا","سَنا الأَصلِ عِندَ المُضلِعاتِ رَفوعُ",23,"ع",1,0],["وَيَتَّبِعُ الآمالَ مَوقِعَ لَحظِهِ","فَلَيسَ لَهُ ما عاشَ في الناسِ مَنزِلُ",24,"ل",1,0],["وَيَتَّقي الصارِمَ العَض","بَ أَن يُباشِرَ غَربَه",25,"ب",2,0],["وَيَترُكنَ الرَشيدَ بِغَيرِ لُبٍّ","أَتَينَ لِهَديَه مُتَعَلِّماتِ",26,"ت",1,0],["ويتلون الروح التي أمس قد نأت","فواتح يهدى في تلاوتها الأجر",27,"ر",1,0],["وَيَتْرُكُ اللَّوْمَ حَائِراً وَجِلاً","مُنْعَقِداً فِي لِسَانِ مُنْتقد",28,"د",1,0],["وَيَتعَبُ مَن يَلومُ وَلَيسَ يَدري","حَديثي في مَحَبَّتِهِ طَويلُ",29,"ل",1,0],["ويتيمات فنون جمة","حسبت من معجزات الأول",30,"ل",1,0],["ويتلو عليك .. عيون القصيد","ويرقب عينيك .. يرجو الصدى",31,"د",2,0],["ويتيمةٍ خلَّفتَها وكأنها","«ليلى» تُردِّد: «ليت للبَرَّاق»!",32,"ق",1,0],["ويتعب في دنياه من دقَّ حسُّهُ","وأُوتِي ذِهْنًا للحوادث واعيا",33,"ي",2,0],["ويتّقد الشوق في مقلتيه","ويظمأ في شفتيه العتاب",34,"ب",1,0]]}