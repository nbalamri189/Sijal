[5237,"زيارة أرباب التقى مرهم يبري","https://www.poetsgate.com/ViewPoem.aspx?id=113107",""],[5246,"تقلب الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=187046",""],[5273,"وساوس شعرية","https://www.poetsgate.com/ViewPoem.aspx?id=180052",""],[5284,"واقع","https://www.poetsgate.com/ViewPoem.aspx?id=188634",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5376,"أناختْ على هجرِ المطايا نجائبي........يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=188567",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5431,"فيرميه الصباح على سريري","https://www.poetsgate.com/ViewPoem.aspx?id=198702",""],[5561,"أُحُبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197377",""],[470,"سلاماً يا أعزَّ النّاس","https://www.poetsgate.com/ViewPoem.aspx?id=178033",""],[5628,"الى صاحب برج العذراء في ليلة زفافه","https://www.poetsgate.com/ViewPoem.aspx?id=178467",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5694,"الآماره","https://www.poetsgate.com/ViewPoem.aspx?id=129910",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5861,"بنت البنفسج","https://www.poetsgate.com/ViewPoem.aspx?id=188041",""],[1920,"الابتسامة تليق بك","https://www.poetsgate.com/ViewPoem.aspx?id=194250",""],[5956,"الشامُ فيها العشقُ والتَّرحامُ","https://www.poetsgate.com/ViewPoem.aspx?id=184921",""],[5956,"في سبيل التوفير للتعمير","https://www.poetsgate.com/ViewPoem.aspx?id=194203",""],[5956,"وتعاونوا على البِرِّ والتقوَى","https://www.poetsgate.com/ViewPoem.aspx?id=194825",""],[5956,"قصائدي عفوية","https://www.poetsgate.com/ViewPoem.aspx?id=201542",""],[5957,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=180143",""],[5975,"وداعاً","https://www.poetsgate.com/ViewPoem.aspx?id=52976",""],[6003,"ثورة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=188985",""],[6093,"إذا ما أمْرضَتْ نفسي المعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=176267",""],[6093,"معاتب نية","https://www.poetsgate.com/ViewPoem.aspx?id=212899",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6102,"ثغر","https://www.poetsgate.com/ViewPoem.aspx?id=183322",""],[6115,"بيض الله وجه بعض الشدايد والضروف","https://www.poetsgate.com/ViewPoem.aspx?id=180470",""],[6142,"مادت الأرض انقلاباً والسما","https://www.poetsgate.com/ViewPoem.aspx?id=155750",""],[6152,"في الله الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=205854",""],[5309,"سمعت نسيم الصبح يتلو رواية","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573691",""],[6171,"عُرسُ الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86324&r=&rc=7",""],[463,"اللَّيلُ بعدَ اليأسِ أطمعَ ناظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60083&r=&rc=139",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""],[454,"يئس الصغار من الكبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82661&r=&rc=25",""],[6290,"فِرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85171&r=&rc=0",""],[6339,"أبواب الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87890&r=&rc=2",""],[5190,"بلادي لم تزل للنور نبعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85060&r=&rc=135",""],[5190,"شرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85062&r=&rc=137",""]],"verses":[["ويتيماً فتبنته السما","وتبنى عطفه كل اليتامى",0,"م",2,0],["وَيَتَّبِعونَهُ في كُلِّ حالٍ","كَراعي الضَأنِ تَتبَعُهُ السَوامُ",1,"م",1,0],["ويتبعُ آثَارَ الْمَطِيّ مُشَيِّعاً","وَقَدْ زَمْزَمَ الْحَادِي وَحَنَّ نَجيبُ",2,"ب",1,0],["وَيُتحِفُ مِصرَ آناً بَعدَ آنٍ","بِمَجلودٍ وَمَقتولٍ شَهيدِ",3,"د",1,0],["وَيَتلو أَرنَبَ الجَبّارِ كَلبٌ","تَراهُ قَد تَهَيَّأَ لِلوُثوبِ",4,"ب",1,0],["وَيَتيمٍ رَأى لَهُ مِن أَيادي","كَ أَباً مُشفِقاً وَأُماً وَمَهدا",5,"د",2,0],["ويَتْرُكُ القِرْنَ مُصْفَرّاً أنامِلُهُ","كَأنّ في رَيْطَتَيْهِ نَضْحَ أُرْقانِ",6,"ن",1,0],["ويترك الناس في دهياءَ مظلمة","يَرتدُّ منها بياض الشمس حُلبوبا",7,"ب",2,0],["وَيُتبِعُ الذَنبَ ذَنباً حينَ يَعرِفُني","عَمداً وَأُتبِعُ غُفراناً بِغُفرانِ",8,"ن",1,0],["وَيَتَّقي الحَيَّ مِن جاءٍ وَغادِيَةٍ","كَيفَ الوُصولُ إِذا مانامَ سامِرُهُ",9,"ر",2,0],["وَيَترُكوا اللاتَ وَالعِزّى بِمَعزِلَةٍ","وَيَسجُدوا كُلُّهُم لِلخالِقِ الصَمَدِ",10,"د",1,0],["ويتيم من لؤلؤِ الثغر حلوٌ","راح في مثله الرشيد غويّا",11,"ي",2,0],["ويتيمةٍ من كَرمها ومُدِيمِها","لم يُبْقِ منها الدهرُ غيرَ صَميمِها",12,"م",3,1],["ويتخذ التَّنُّومَ والشرْيَ مرتعاً","فيخذم مِنْ هذا وهذاك ما خَذَمْ",13,"م",1,0],["وَيَتَوارى في نَهارِيَ السَنا","أَو وَتَبَدّى حانِقَ الشَمسِ",14,"س",1,0],["ويتفق منه الذي","ما كان بالمتفق",15,"ق",1,0],["وَيَترُكنَ أَزواجَ الغَيورِ لِغَيرِهِ","وَيَقسِمنَ ما بَقّى الشَحيحُ مِنَ الوَفرِ",16,"ر",1,0],["ويَترُكونَ إِذا جَيشَا الوَغى انتَظَما","سَلخاً كَساه حديداً حَيّةٌ ذَكرُ",17,"ر",1,0],["وَيُتبِعُ نِعمَتي بِكَ عَينَ ضِغنٍ","كَما نَظَرَ اليَتيمُ إِلى الوَصِيِّ",18,"ي",1,0],["ويتلو عليهم في محاريبهِ العُلَى","كتاباً من الإِقدامِ والبأسِ مُحكَما",19,"م",2,0],["وَيترُكُ بأسَهُمْ ضَعْفاً وعَجْزا","فَمَنْ للقومِ إن وَقَعَ الصّدامُ",20,"م",1,0],["ويتركُ كلَّ مُمتنعٍ مَهيلا","لِمَنْ يَرِثُ الممالكَ لا سِواهُ",21,"ه",1,0],["ويُتَوَّجُ الراعي بها","ملِكاً رعيَّتُه القطيع",22,"ع",1,0],["وَيُترَكُ أَمثالي عَلى أَنَّ سَعيَنا","سَنا الأَصلِ عِندَ المُضلِعاتِ رَفوعُ",23,"ع",1,0],["وَيَتَّبِعُ الآمالَ مَوقِعَ لَحظِهِ","فَلَيسَ لَهُ ما عاشَ في الناسِ مَنزِلُ",24,"ل",1,0],["وَيَتَّقي الصارِمَ العَض","بَ أَن يُباشِرَ غَربَه",25,"ب",2,0],["وَيَترُكنَ الرَشيدَ بِغَيرِ لُبٍّ","أَتَينَ لِهَديَه مُتَعَلِّماتِ",26,"ت",1,0],["ويتلون الروح التي أمس قد نأت","فواتح يهدى في تلاوتها الأجر",27,"ر",1,0],["وَيَتْرُكُ اللَّوْمَ حَائِراً وَجِلاً","مُنْعَقِداً فِي لِسَانِ مُنْتقد",28,"د",1,0],["وَيَتعَبُ مَن يَلومُ وَلَيسَ يَدري","حَديثي في مَحَبَّتِهِ طَويلُ",29,"ل",1,0],["ويتيمات فنون جمة","حسبت من معجزات الأول",30,"ل",1,0],["ويتلو عليك .. عيون القصيد","ويرقب عينيك .. يرجو الصدى",31,"د",2,0],["ويتيمةٍ خلَّفتَها وكأنها","«ليلى» تُردِّد: «ليت للبَرَّاق»!",32,"ق",1,0],["ويتعب في دنياه من دقَّ حسُّهُ","وأُوتِي ذِهْنًا للحوادث واعيا",33,"ي",2,0],["ويتوبون يستعذبون بالله","لأن الإناث نبع المفاسد",34,"د",1,0],["ويتّقد الشوق في مقلتيه","ويظمأ في شفتيه العتاب",35,"ب",1,0],["ويُتْلَى كتابُ الله فيك تبرعاً","وتذكرُ بالخيراتِ في كلِّ مَشهدِ",36,"د",1,0],["وَيُترَكَ حَرّاثٌ يُقَلِّبُ أَمرَهُ","أَيُتهِمُ فيها عِندَ ذاكَ وَيُنجِدُ",37,"د",1,0],["ويتركوا مقالة ابن عربي","لقول من يقوله التبرك",38,"ك",1,0],["ويترك ما جاءت به الرسل من هدى","لأقوال هذا الفيلسوف المغادر",39,"ر",1,0],["ويتّقون ذهاب الشمس محرقةً","بهرام في السر إذا أفضت إلى زحل",40,"ل",1,0],["ويتبع ذاك في بأمّ صدق","فتؤنس بنتها وأعيش وحدي",41,"د",2,0],["ويتلو ذلك العتب اعتذار","ويبلغ ذلك العذر ارتياب",42,"ب",1,0],["ويتركُ القِرْنَ مُصْفَرّاً أناملُه","كأنَّ أثوابَه مُجَّتْ بفُرصادِ",43,"د",1,0],["وَيَتعَبُ بِالزادِ فيها الفِقير","وَأهلُ الغنى بِالغِنى أتعَبُ",44,"ب",1,0],["ويتبِع المعروفَ منه العُذْرا","ويبذل المال ويَشْري الشُكْرا",45,"ر",2,0],["ويترك الكل في هواكم","ولا يبالي بمن يحادي",46,"د",2,0],["ويتركونا كالبهائم والأ","نعام لا تصغي إلى الحجج",47,"ج",1,0],["ويتقي ذا الجلال","فيه الشهيد الرقيب",48,"ب",1,0],["ويتمّ الهدى ويعلو صداه","ويعمّ الإسلام كلّ الرحاب",49,"ب",1,0],["ويتوَّج رأسي بما ضفّرته","يده من أزاهر وطيوب",50,"ب",1,0],["وَيَتبَعُ الجَزَّارُ حُكمي فَلا","يَلقانيَ الدَّهرَ بِعِصْيانِ",51,"ن",1,0],["ويَتْبَعُه كرامُ النّاسِ طُرّاً","كما تَبعَ السِّنانَ السَّمْهَريّ",52,"ي",1,0],["ويَتركُ الحِلْمُ منّا لُدَّ ألسِنةٍ","وهُنّ كاللُّجمِ في الأفواهِ تَنعلِك",53,"ك",1,0],["وَيُتابعَ الأعيادَ نَحوك يَنْثَنِي","عِيدٌ ويُقْبِلُ بالمَيامِن عِيد",54,"د",1,0],["ويتوب حقّاً عن خطايا شعبه","ويَقَرُّ في كرسي أبيه ويجلس",55,"س",1,0],["ويتوب لكن يا لتوبة هالكٍ","ما تاب يوم خَطائه وزِنائه",56,"ا",3,0],["ويترك الإثم كله جله والدقيل","هذا