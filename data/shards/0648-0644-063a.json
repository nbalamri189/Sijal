{"poems":[[72,"بروحي طرس جاءني متضمنا","https://www.aldiwan.net/poem18488.html","الطويل"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[31,"صرمتْ حبلكَ البغومُ، وصدتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18740&r=&rc=3",""],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[259,"كف العتاب فما يمل العاتب","https://www.aldiwan.net/poem38371.html","الكامل"],[269,"كم ذا أراها نحو طيبة ترتمي","https://www.aldiwan.net/poem52047.html","الكامل"],[302,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[302,"شغف المحب بحب ظبية عامر","https://www.aldiwan.net/poem16891.html","الكامل"],[326,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[347,"لما مررت بتربة مرت بها","https://www.aldiwan.net/poem15881.html","الكامل"],[369,"إن كان أطلق دمعه المحبوسا","https://www.aldiwan.net/poem57367.html","الكامل"],[450,"يا أديباً يبدي من الأدب الغض","https://www.aldiwan.net/poem13684.html","الخفيف"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[556,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[556,"يا خبرا عني إذا","https://www.aldiwan.net/poem34498.html","مجزوء الرجز"],[565,"حسبي من اللهو وآلات الطرب","https://www.aldiwan.net/poem69818.html","الرجز"]],"verses":[["ولغزٌ هداني نحو معناه أنَّه","أتى وبهِ عرفٌ من الروضِ ينفح",0,"ح",1,0],["ولغاوٍ سفاهَهُ وصِباهُ","وللاهٍ سماعهُ وشَمُولهْ",1,"ل",2,0],["ولغاته لا للمنا","بر قد خلقن ولا المحابر",2,"ر",1,0],["وَلِغالِبٍ مِنْ حَمْدِهِ وَبَهَائِهِ","مَلأَ الأَعادِي ذِلَّةً وخُمولا",3,"ل",2,0],["ولغيري لم تكنْ تخطرُ في هذا الرواءِ","لا ولم تروِ كهذا اللحنِ في هذا الصّفاءِ",4,"ا",2,0],["وَلِغَضْبَةِ الآمَالِ كَمْ","ظُفُرٌ تَصُولُ بِهِ وَنَابَ",5,"ب",1,0],["وَلِغَيْرِ خَمْسٍ مَا رَأَيْتِ","عَلَى مُحَيَّاهَا الهِلالاَ",6,"ل",2,0],["وَلِغيْرِ الفَخْرِ حَلاَّهَا النَّدَى","وَلِغَيْرِ الذِّكْرِ فاَحَتْ عَنْبَرَا",7,"ر",2,0],["وَلِغُرَّةِ الجَوِّ الرَقيقِ أَسِرَّةٌ","يَلمَعنَ مِن قِطَعِ السَحابِ الغادي",8,"ي",1,0],["وَلَغوا بِوَقعِ حَوافِرٍ في مَأزِقٍ","مَلَأوا بِهِنَّ مَسامِعَ الأَصلادِ",8,"د",1,0],["ولغزُ الموت ما استعصى عليكم","فَفَخْرُكموُ بعلمكمُ اغترار",9,"ر",1,0],["وَلِغالِبٍ مِنْ حَمْدِهِ وَبَهَائِهِ","وَهَزَزْتَ فيهمْ صارماً مَسْلولا",10,"ل",2,0],["وَکلْغَواني إذا رأَيْنَكَ كَهْلاً","كانَ فيهنّ عن هواكَ التواء",11,"ا",2,0],["وَلَغت في نجيعِهم ثمّ صدّت","راوياتٍ كأنّه صدّاءُ",12,"ا",2,0],["ولغير سلوان بعدت وليس لي","أن ارتضى بحصول ما أنا غائب",13,"ب",1,0],["وَلغالب غلب الرقاب خواضع","هُوَ باسم قال النضر أَوّل من سمى",14,"م",2,0],["ولغير اللَه ما قصدوا","ومع القرن في قرن",15,"ن",1,0],["ولغيرنا من أهل قبلتنا التي","صلى إليها كل عبد ذاكر",16,"ر",1,0],["ولغيري من الأناسي أن ين","شرَ في الأرض مذهب الحرباء",17,"ا",2,0],["وَلِغَيبَتي بي عَن عَيانِ شَهيدَتي","أَشكو النَوى وَلَها الفُؤادُ مَقامُ",18,"م",1,0],["ولغُصنِ بانٍ لستُ أدري من نقاً","أم من حشاً عاينتُه مَغروسا",19,"س",2,0],["ولغضّ الريحان مع يانع الور","د ازدواج في قوة الامِتزاج",20,"ج",1,0],["ولغامضٍ خافٍ رفعتَ قِوامه","وفتحتَ منه في الجواب المقفَلِ",21,"ل",1,0],["ولغيرهم معنى الجلال مظاهر ال","شهوات تعشقها نفوس بهائم",22,"م",1,0],["ولغو على أهل المجاهدة احتوى","ولا إثم فيه لكن القلب جازع",23,"ع",1,0],["ولغة للعَرَب ال","عَرْبا لسانُ من غبر",24,"ر",1,0],["ولغةً تجمع ألفاظَ العربْ","وفقراً كالوعد في قلب المُحِبْ",25,"ب",1,0]]}