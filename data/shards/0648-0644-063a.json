{"poems":[[74,"بروحي طرس جاءني متضمنا","https://www.aldiwan.net/poem18488.html","الطويل"],[53,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[87,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[69,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[69,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[33,"صرمتْ حبلكَ البغومُ، وصدتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18740&r=&rc=3",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[266,"كف العتاب فما يمل العاتب","https://www.aldiwan.net/poem38371.html","الكامل"],[276,"كم ذا أراها نحو طيبة ترتمي","https://www.aldiwan.net/poem52047.html","الكامل"],[309,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[309,"شغف المحب بحب ظبية عامر","https://www.aldiwan.net/poem16891.html","الكامل"],[333,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[354,"لما مررت بتربة مرت بها","https://www.aldiwan.net/poem15881.html","الكامل"],[376,"إن كان أطلق دمعه المحبوسا","https://www.aldiwan.net/poem57367.html","الكامل"],[457,"يا أديباً يبدي من الأدب الغض","https://www.aldiwan.net/poem13684.html","الخفيف"],[463,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[563,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[563,"يا خبرا عني إذا","https://www.aldiwan.net/poem34498.html","مجزوء الرجز"],[572,"حسبي من اللهو وآلات الطرب","https://www.aldiwan.net/poem69818.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86970","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48811","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48858","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56334","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55942","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145158","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137866",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80019","الكامل"],[1933,"","https://poetry.dctabudhabi.ae/diwan/poem/144319","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137938",""],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28545","الكامل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131704",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94050","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93842","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133958","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100758","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121618","الخفيف"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106691","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100172","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125929","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205596","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216831","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117963","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133296","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75712","الرمل"],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22588","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120462","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139499",""],[4755,"قَلَقُ السّفِينة","https://www.poetsgate.com/ViewPoem.aspx?id=184355",""],[4755,"صَمَتُوا وكُنتَ بِحُزنِهِم تَتَحَدَّثُ","https://www.poetsgate.com/ViewPoem.aspx?id=187241",""],[4755,"صَيَّادُ البُرُوق","https://www.poetsgate.com/ViewPoem.aspx?id=199741",""],[4927,"أَحْلاْمُ الْعِشْق","https://www.poetsgate.com/ViewPoem.aspx?id=29948",""],[5085,"ياقاتلي باللحظ","https://www.poetsgate.com/ViewPoem.aspx?id=188439",""],[5121,"قَلَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33498",""],[5193,"فَرَّقَ الموتُ يدَيْنا يا صديقُ","https://www.poetsgate.com/ViewPoem.aspx?id=213573",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5408,"لو مرة حاولت","https://www.poetsgate.com/ViewPoem.aspx?id=190757",""],[5431,"فضل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=183020",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[3155,"في حرم الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72292&r=&rc=4",""],[572,"حَسْبِي مِنَ اللهوِ وآلاَتِ الطَّرَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9168&r=&rc=25",""]],"verses":[["ولغزٌ هداني نحو معناه أنَّه","أتى وبهِ عرفٌ من الروضِ ينفح",0,"ح",1,0],["ولغاوٍ سفاهَهُ وصِباهُ","وللاهٍ سماعهُ وشَمُولهْ",1,"ل",2,0],["ولغاته لا للمنا","بر قد خلقن ولا المحابر",2,"ر",1,0],["وَلِغالِبٍ مِنْ حَمْدِهِ وَبَهَائِهِ","مَلأَ الأَعادِي ذِلَّةً وخُمولا",3,"ل",2,0],["ولغيري لم تكنْ تخطرُ في هذا الرواءِ","لا ولم تروِ كهذا اللحنِ في هذا الصّفاءِ",4,"ا",2,0],["وَلِغَضْبَةِ الآمَالِ كَمْ","ظُفُرٌ تَصُولُ بِهِ وَنَابَ",5,"ب",1,0],["وَلِغَيْرِ خَمْسٍ مَا رَأَيْتِ","عَلَى مُحَيَّاهَا الهِلالاَ",6,"ل",2,0],["وَلِغيْرِ الفَخْرِ حَلاَّهَا النَّدَى","وَلِغَيْرِ الذِّكْرِ فاَحَتْ عَنْبَرَا",7,"ر",2,0],["وَلِغُرَّةِ الجَوِّ الرَقيقِ أَسِرَّةٌ","يَلمَعنَ مِن قِطَعِ السَحابِ الغادي",8,"د",2,0],["وَلَغوا بِوَقعِ حَوافِرٍ في مَأزِقٍ","مَلَأوا بِهِنَّ مَسامِعَ الأَصلادِ",8,"د",1,0],["ولغزُ الموت ما استعصى عليكم","فَفَخْرُكموُ بعلمكمُ اغترار",9,"ر",1,0],["وَلِغالِبٍ مِنْ حَمْدِهِ وَبَهَائِهِ","وَهَزَزْتَ فيهمْ صارماً مَسْلولا",10,"ل",2,0],["وَکلْغَواني إذا رأَيْنَكَ كَهْلاً","كانَ فيهنّ عن هواكَ التواء",11,"ا",2,0],["وَلَغت في نجيعِهم ثمّ صدّت","راوياتٍ كأنّه صدّاءُ",12,"ا",2,0],["ولغير سلوان بعدت وليس لي","أن ارتضى بحصول ما أنا غائب",13,"ب",1,0],["وَلغالب غلب الرقاب خواضع","هُوَ باسم قال النضر أَوّل من سمى",14,"م",2,0],["ولغير اللَه ما قصدوا","ومع القرن في قرن",15,"ن",1,0],["ولغيرنا من أهل قبلتنا التي","صلى إليها كل عبد ذاكر",16,"ر",1,0],["ولغيري من الأناسي أن ين","شرَ في الأرض مذهب الحرباء",17,"ا",2,0],["وَلِغَيبَتي بي عَن عَيانِ شَهيدَتي","أَشكو النَوى وَلَها الفُؤادُ مَقامُ",18,"م",1,0],["ولغُصنِ بانٍ لستُ أدري من نقاً","أم من حشاً عاينتُه مَغروسا",19,"س",2,0],["ولغضّ الريحان مع يانع الور","د ازدواج في قوة الامِتزاج",20,"ج",1,0],["ولغامضٍ خافٍ رفعتَ قِوامه","وفتحتَ منه في الجواب المقفَلِ",21,"ل",1,0],["ولغيرهم معنى الجلال مظاهر ال","شهوات تعشقها نفوس بهائم",22,"م",1,0],["ولغو على أهل المجاهدة احتوى","ولا إثم فيه لكن القلب جازع",23,"ع",1,0],["ولغة للعَرَب ال","عَرْبا لسانُ من غبر",24,"ر",1,0],["ولغةً تجمع ألفاظَ العربْ","وفقراً كالوعد في قلب المُحِبْ",25,"ب",1,0],["وَلِغَيره في عَصره","بِبَديع صُنع يُسعف",26,"ف",1,0],["ولغرمٍ تخوضها وخسارٍ","أم لغنمٍ تخوضها واكتساب",27,"ب",1,0],["ولغيري إذا تقاضيت حقاً","ولغيري إذا تلمَّستُ عدلا",28,"ل",2,0],["ولغير بابك قط لا أنحو مدى","عمرى ولست على سواك معوّلا",29,"ل",2,0],["ولغاية الامال أنطون الفدا","ندبٌ رعاه الواحد الجوادُ",30,"د",1,0],["ولغة العرب لسان ممتحنْ","إن لم يذُد أبناؤه عنه، فمنْ",31,"ن",1,0],["ولغة تأتي كزيد قد شكر","عمرا على إرساله له شكر",32,"ر",1,0],["ولغز ترى دروين مع ترجمانه","مع الجهد فيما قدرا لم يحلاه",33,"ا",2,0],["ولغيَّمت بالنقعِ دونك هاشمٌ","حتَّى تسدَّ مطالع الآفاقِ",34,"ق",1,0],["ولغيث السحاب سحقاً فباقي","كاسنا قد أبان فيك الزهاده",35,"د",2,0],["ولغوثها جمعوا الصفوف وعبأوا","جيشاً لصدّ الهاجمين عرمرما",36,"م",2,0],["وَلِغافِل وَلَه بِكُلِّ ثَنِيَّةٍ","مُلقى لَهُ بَطن الصَّفائِحِ مَضجَعُ",37,"ع",1,0],["ولغمست عين فكري فهي في فلك الأح","شاء تسطع لا عين ولا أثر",38,"ر",1,0],["ولغسل الكفين ثن وثلث","وكذا كل ما يلي من فعال",39,"ل",1,0],["ولغت موانع صرفها","واهتز عطف الأريحيه",40,"ي",2,0],["ولغة والخط والبيان","كذلك العروض والمعاني",41,"ي",1,0],["ولغيرهم القاب علم أصبحت","تعلو وتهبط مثل قدح الياسر",42,"ر",1,0],["ولِغَيْظٍ على سُراقةَ عَضَّتْ","سُوقَ نَهْدٍ من تحتِه الدَّهْناءُ",43,"ا",2,0],["ولِغَيرِهِ يَروِي الحديثَ مُعَنعَناً","ذِكرَى فيُصبِحُ في سِياقِ مُسَلسَلِ",44,"ل",1,0],["ولغير البيض من آرامه","أبداً ما مال قلب وصبا",45,"ب",2,0],["ولغيظِ أَربدَ وجهُه كأَظلّةٍ","تَرميكَ مقلتُه بطَرفِ أَخْزَرِ",46,"ر",1,0],["ولغادة الشعر التي","وهبته ملكا أكبرا",47,"ر",2,0],["ولغا «البطريق» فيها لغوه","وهو من قطب جنوبي بعيدْ",48,"د",1,0],["ولغالب الموت امرؤ لم يكترث","مجد الحياة ولا السنين شدادا",49,"د",2,0],["ولغير ما شرعت جدودهما من ال","إقدام ان حمي الوغى لن يفعلا",50,"ل",2,0],["ولغيث غوثهم استمد","فالقرب للقربى ظفر",51,"ر",1,0],["وَلغريان نماه من نما","فاِكتَسَت بالفخر أَبهى ملبس",52,"س",1,0],["وَلَغَت دِماءَ بَني النَبِيِّ فَأَصبَحَت","خَضَبَت بِها الأَشداق وَالأَظفارا",53,"ر",2,0],["ولغيره طورا تمن","والف طور تمنع",54,"ع",1,0],["ولغمٍّ جسم الممالك إذ عن","نأى الروح قد عراه فناء",55,"ا",2,0],["وَلَغُوا بأوحَالِ النِّفَاقِ فَأوْرَقَت","لَهُمُ الحَيَاةُ, وأنتَ لا تَتَلَوَّثُ",56,"ث",1,0],["وَلَغُوا بأَوحَالِ الحَيَاةِ فَأوْرَقَت","لَهُمُ الحَيَاةُ, وأَنتَ لا تَتَلَوَّثُ",57,"ث",1,0],["ولِغَيرِ خُضرٍ سَافَرَت أَيَّامُنا","يا مَن رَحَلتَ فأَجدَبَ المِضمارُ",58,"ر",1,0],["وَلُغْزُ هَوَاْهَاْ لاْ يُحَلُّº وَإِنَّمَاْ","سَيَبْقَىْ عَصِياًّº فَالْهَوَىْ لَيْسَ يُشْرَحُ",59,"ح",1,0],["وَلَغَادةٌ بِالغِيْدِ أرْوَعُ مَنْظَرٍ","ظَبْيٌ بِهِ الصَيَّادُ قَلبي مَا لَحَقْ",60,"ق",1,0],["وَلِغَافِلٍ عَنْ مُفْرَدَاتِ جُدُودِنَا","سَأَقُولُ : إِنَّ جُذُورَنَا هِي وَائِلِي",61,"ل",2,0],["ولُغى تفتَرُّ عن ثغر ٍ ضحوكٍ","ناضح ٍ بالشعر ِ يعلوهُ البَريقُ",62,"ق",1,0],["ولغابةِ الزيتون ِقافلة ٌ","تأتي إلى عينيكِ تعبدُكِ",63,"ك",1,0],["ولغيْرِ روحِكَ ما هَفَتْ روحُ النّدى","وعُيونُ نهْرِ الأرْجوانِ تُعَطّرُكْ",64,"ك",1,0],[".ولغزُ الكون منسجمٌ عميقٌ",".تهابُ الله أفئدةٌ تُنيبُ",65,"ب",1,0],["ولَغاضَتْ ( أرونُ ) مَعْنىً وحِسّاً","لوْ رأى فرْط َحُسنِها ( مارينو )",66,"ن",2,0],["وَلِغَايتِهم عَدلٌ أعمى","إنصَافٌ قد نجّى الأجرمْ!",67,"م",1,0],["ولِغيرِ دِينِ اللهِ لمْ تَغضبْ ومَن","يزعمْ سوى هذا فحِلمُكَ ألجَمَهْ",68,"م",2,0],["ولغير مِطْرقة العذاب ،","ونارها .. لِمَ لا تلينُ ؟!",69,"ن",1,0],["ولغة ً تَجْمَعُ ألفَاظَ العَرَبْ","وَفِكَراً كالوَعْدِ في قلبِ المُحِبْ",70,"ب",1,0]]}