{"poems":[[72,"بروحي طرس جاءني متضمنا","https://www.aldiwan.net/poem18488.html","الطويل"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[31,"صرمتْ حبلكَ البغومُ، وصدتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18740&r=&rc=3",""]],"verses":[["ولغزٌ هداني نحو معناه أنَّه","أتى وبهِ عرفٌ من الروضِ ينفح",0,"ح",1,0],["ولغاوٍ سفاهَهُ وصِباهُ","وللاهٍ سماعهُ وشَمُولهْ",1,"ل",2,0],["ولغاته لا للمنا","بر قد خلقن ولا المحابر",2,"ر",1,0],["وَلِغالِبٍ مِنْ حَمْدِهِ وَبَهَائِهِ","مَلأَ الأَعادِي ذِلَّةً وخُمولا",3,"ل",2,0],["ولغيري لم تكنْ تخطرُ في هذا الرواءِ","لا ولم تروِ كهذا اللحنِ في هذا الصّفاءِ",4,"ا",2,0],["وَلِغَضْبَةِ الآمَالِ كَمْ","ظُفُرٌ تَصُولُ بِهِ وَنَابَ",5,"ب",1,0],["وَلِغَيْرِ خَمْسٍ مَا رَأَيْتِ","عَلَى مُحَيَّاهَا الهِلالاَ",6,"ل",2,0],["وَلِغيْرِ الفَخْرِ حَلاَّهَا النَّدَى","وَلِغَيْرِ الذِّكْرِ فاَحَتْ عَنْبَرَا",7,"ر",2,0],["وَلِغُرَّةِ الجَوِّ الرَقيقِ أَسِرَّةٌ","يَلمَعنَ مِن قِطَعِ السَحابِ الغادي",8,"ي",1,0],["وَلَغوا بِوَقعِ حَوافِرٍ في مَأزِقٍ","مَلَأوا بِهِنَّ مَسامِعَ الأَصلادِ",8,"د",1,0],["ولغزُ الموت ما استعصى عليكم","فَفَخْرُكموُ بعلمكمُ اغترار",9,"ر",1,0],["وَلِغالِبٍ مِنْ حَمْدِهِ وَبَهَائِهِ","وَهَزَزْتَ فيهمْ صارماً مَسْلولا",10,"ل",2,0],["وَکلْغَواني إذا رأَيْنَكَ كَهْلاً","كانَ فيهنّ عن هواكَ التواء",11,"ا",2,0]]}