{"poems":[[53,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[55,"أهاجك صوت قمري ينوح","https://www.aldiwan.net/poem26434.html","الوافر"],[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[35,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[35,"حبال سجيفة أمست رثاثا","https://www.aldiwan.net/poem39175.html","المتقارب"],[10,"مرهت عيني فعيني","https://www.aldiwan.net/poem21115.html","مجزوء الرمل"],[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[72,"رب صديق كلغز سيدنا","https://www.aldiwan.net/poem19545.html","المنسرح"],[72,"قل لخليلي الذي رجوت به","https://www.aldiwan.net/poem19652.html","المنسرح"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"لم تكن مثل نعمة الله في العب","https://www.aldiwan.net/poem62993.html","الطويل"],[51,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[51,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[70,"لو تراني وحبيبي عندما","https://www.aldiwan.net/poem42388.html","الرمل"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[85,"يا لورد كم من معان في سياستكم","https://www.aldiwan.net/poem7297.html","البسيط"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[43,"كدعواك كل يدعي صحة العقل","https://www.aldiwan.net/poem10137.html","الطويل"],[45,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[45,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[45,"كدت أقضي إذا غاب عني الحبيب","https://www.aldiwan.net/poem11482.html","الخفيف"],[28,"أتصرف أجمال النوى شاجنية","https://www.aldiwan.net/poem5245.html","الطويل"],[28,"يسقين بالموماة زغبا نواهضا","https://www.aldiwan.net/poem5464.html","الطويل"],[58,"كد كد العبد إن أحبيت","https://www.aldiwan.net/poem31040.html","مجزوء الرمل"],[49,"الله أكرم من يناجى","https://www.aldiwan.net/poem62026.html","مجزوء الكامل"],[66,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[97,"لمن العيون الفاترات ذبولا","https://www.aldiwan.net/poem24801.html","الكامل"],[44,"نكست رأسي بين جلاسي","https://www.aldiwan.net/poem30032.html","الكامل"],[44,"يا ابن تلك التي بحران لما","https://www.aldiwan.net/poem30055.html","الخفيف"],[31,"رث حبل الوصل وانصرما","https://www.aldiwan.net/poem41318.html","المديد"],[31,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[105,"أبا الفضل أقبل وارفع الصوت شاكرا","https://www.aldiwan.net/poem44043.html","الطويل"],[40,"أقول غداة استقل الجمي","https://www.aldiwan.net/poem42301.html","المتقارب"],[22,"كدحت بأظفاري وأعملت معولي","https://www.aldiwan.net/poem22067.html","الطويل"],[52,"قد أغتدي على الجياد الضمر","https://www.aldiwan.net/poem26975.html","الرجز"],[52,"قيدني الحب وخلاها","https://www.aldiwan.net/poem27315.html","السريع"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"وفتية نازعوا والليل معتكر","https://www.aldiwan.net/poem62503.html","البسيط"],[48,"أنعت ديكا من ديوك الهند أحسن","https://www.aldiwan.net/poem63253.html","الرجز"],[48,"كدر العيش أنني محبوس","https://www.aldiwan.net/poem63422.html","الخفيف"],[48,"قل لمن يبكي على رسم درس","https://www.aldiwan.net/poem63427.html","السريع"],[48,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[50,"يا بنت صقر بن قعقاع على كبدي","https://www.aldiwan.net/poem63874.html","البسيط"],[50,"أرسلت خلتي من الدمع غربا","https://www.aldiwan.net/poem64795.html","الخفيف"],[46,"أهاتفة الأيك خلي الأنام","https://www.aldiwan.net/poem22299.html","المتقارب"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142054","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1912","الطويل"],[45,"أمِنْكَ تأوُّبُ الطّيفِ الطّرُوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31688",""],[45,"كدت أقضي إذ غاب عني حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=31403",""],[31,"رَثَّ حَبْلُ الوَصْلِ، وَکنْصَرَما،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19085&r=&rc=347",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""]],"verses":[["كَدَأبِها يَومَ يَمٍّ وَالقَنا شَرَعٌ","وَالضَربُ يُبعِدُ بَينَ العُنقِ وَالكَفَلِ",0,"ل",1,0],["كَدافِعٍ في صَدرِ سَي","لِ الطَودِ وَهوَ سائِلُ",1,"ل",1,0],["كَدَأبِكُمُ مِنهُ غَداةَ حَداكُمُ","تُشاغِلُهُ الأَذانُ عَن طَرَبِ الحُدا",2,"د",2,0],["كَدُميَةِ بيعَةٍ بِالرومِ أَضحَت","يُعَظَّمُ عِندَ رُؤيَتِها المَسيحُ",3,"ح",1,0],["كدَحْتَ الى رَبّ الجَمال مُلاقِياً","فَيا أيُّها الإنسانُ إنك كادِحُ",4,"ح",1,0],["كَدُميَةٍ صُوِّرَ مِحرابُها","بِمُذهَبٍ في مَرمَرٍ مائِرِ",5,"ر",1,0],["كَدَمِ الذَبيحِ غَريبَةً","مِمّا يُعَتِّقُ أَهلُ بابِل",6,"ل",1,0],["كَدَأبِكَ مِن أُمِّ الحُوَيرِثِ قَبلَه","وَجارَتِها أُمِّ الرَبابِ بِمَأسَلِ",7,"ل",1,0],["كَدَحتَ لَها كَدحَ اِمرِىٍ مُتَحَرِّجٍ","قَد أَيقَنَ أَنَّ اللَهَ سَوفَ يَدينُها",8,"ن",3,0],["كَدُهمِ الرِّكابِ بأثقالِها","غَدَت مِن سَماهِيجَ أَو مِن جُواثا",9,"ث",2,0],["كَدَبورٍ وَشَمالٍ","في حِياضٍ لَقِفَه",10,"ف",2,0],["كدى أنسى بها العراق وأن أب","قى ندوباً بمهجتي فندوبا",11,"ب",2,0],["كدّرت عيشي الحوادثُ حتى","لا أرى الصفو غير وقت الرقاد",12,"د",1,0],["كدرهم وجهه يشفّ عن النق","دِ خلاصاً وقلبه زغل",13,"ل",1,0],["كدَّر لي دهري الحياة ومذ","رجوتُ منه الصفاءَ صفا لي",14,"ي",1,0],["كدأْب عَليٍّ في المواطن قبله","أبي حسنٍ والغصن من حيث يخرجُ",15,"ج",1,0],["كدّر الدهرُ صفوها بعبيد ال","لَه وجهِ الحمار والخنزير",16,"ر",1,0],["كدرتَ قبل استقاء آملك ال","خائب قبحاً للوجه والخبر",17,"ر",1,0],["كدجلةَ يجري ماؤُها في سبيله","فلا ينتحي عن قصده للمعادلِ",18,"ل",1,0],["كدتَ أعداءَهم بكيدٍ عظيم","دبَّ للقومِ في شخاصٍ ضِئالِ",19,"ل",1,0],["كدأْبِ من لم يرثْ أوائِلُه","سابقةً في العلا ولا قَدما",20,"م",2,0],["كدأبِ النَّحلِ أرْيٌ أو حُماتٌ","ودأبِ النخلِ شَوْك أو جُرامُ",21,"م",1,0],["كدُّك حُرّاً بغَير منفعة","رأيٌ يراه الرجال مأفونا",22,"ن",2,0],["كدتُ أَن أَخرُجَ عَن طَورِ النُهى","رُبَّ سُكرٍ لَم يَكُن مِن قَدَحِ",23,"ح",1,0],["كِدتُ بَينَ الناسِ أَن أَلثِمَهُ","آهِ لَو أَفعَلُ ماكانَ عَليَّ",24,"ي",1,0],["كَدُخانِ مُرتَجِلٍ بِأَعلى تَلعَةٍ","غَرثانَ ضَرَّمَ عَرفَجاً مَبلولا",25,"ل",2,0],["كدنشواى وتعيين أردت به","قتل الحمام وإحياء الزغاليل",26,"ل",1,0],["كِدتَ مِن قَتلِ المَنايا خِبرَةً","تَعلَمُ الآجالَ أَيّانَ تَحين",27,"ن",1,0],["كَدَعواكِ كُلٌّ يَدَّعي صِحَّةَ العَقلِ","وَمَن ذا الَّذي يَدري بِما فيهِ مِن جَهلِ",28,"ل",1,1],["كَدَأبِ بَني المُعَمِّرِ حينَ زاروا","بَني عَمروٍ بِمُصمِيَةٍ شَعوبِ",29,"ب",1,0],["كِدنَ يَنهَبنَهُ العُيونِ سِراعاً","فيهِ لَو أَمكَنَ العُيونَ اِنتِهابُه",30,"ب",2,0],["كِدتُ أَقضي إِذا غابَ عَنّي الحَبيبُ","وَسَواءٌ حُضورُهُ وَالمَغيبُ",31,"ب",1,1],["كَدُرَّةِ غَوّاصٍ رَمى في مَهيبَةٍ","بِأَجرامِهِ وَالنَفسُ يَخشى ضَميرُها",32,"ر",3,0],["كَداوُدَ إِذ وَلّى سُلَيمانَ بَعدَهُ","خِلافَتَهُ نِحلاً مِنَ اللَهِ ذي الفَضلِ",33,"ل",1,0],["كُدَّ كَدَّ العَبدِ إِن أَح","بَيتَ أَن تُصبِحَ حُرّاً",34,"ر",2,1],["كَدَرُ الصَفاءِ مِنَ الصَدي","قِ فَما تَرى إِلّا مِزاجا",35,"ج",2,0],["كِدتِ المُحِبَّ فَما أَنتِ بِطالِبَةٍ","فَنا مُحِبُّكِ مَع إِشماتِ أَعداكِ",36,"ك",1,0],["كِدتُ أَنجو مِنَ القُدودِ وَلَكِن","أَدرَكَتني فيها بِطَعنٍ دِراكِ",37,"ك",1,0],["كد على كدٍّ ولست ببالغ","إلا ضنى متتابعاً ونحولا",38,"ل",2,0],["كِدتُ وَأَخطَأتُ بِذِكراكَ أَن","أُقتَلَ بَينَ الوَردِ وَالآسِ",39,"س",1,0],["كِدتَ تُدعى لَو أَنَّ خَلفَكَ قُدّا","مَكَ في الحَربِ يا حُدَيّا الرِياحِ",40,"ح",1,0],["كِدتُ أَقضي إِذ رَأَيتُ لَهُ","مَنزِلاً بِالخَيفِ قَد طَسَما",41,"م",2,0],["كِدتُ يَومَ الرَحيلِ أَقضي حَياتي","لَيتَني مِتُّ قَبلَ يَومَ الرَحيلِ",42,"ل",1,1],["كَدَأْبِكَ إذ قالوا أًصيبَ مُحَمَّدٌ","وقد جاءَهم بالزُّورِ مَن كان سَاخِرا",43,"ر",2,0],["كَدَفعِ دَوالِجَ مِن أُكرَةٍ","مَواهِبَ جَمٌّ لَها المَنضَحُ",44,"ح",1,0],["كَدَحتُ بِأَظفاري وَأَعمَلتُ مِعوَلي","فَصادَفتُ جُلموداً مِنَ الصَخرِ أَملَسا",45,"س",2,1],["كَدَمعَةٍ جارِيَةٍ في مَحجِرِ","تُسقى عُقاراً كَالسِراجِ الأَزهَرِ",46,"ر",1,0],["كِدتُ أَقولُ البَدرُ شِبهٌ لَها","أَجعَلُها كَالبَدرِ حاشاها",47,"ه",2,0],["كدَأبِكَ ابنَ نَبيِّ اللّهِ لم يَزَلِ","قتلُ الملوكِ ونقلُ المُلكِ والدُّوَلِ",48,"ل",1,1],["كِدنا عَلى عِلمِنا لِلشَكِّ نَسأَلُهُ","أَراحُنا نارُنا أَم نارُنا الراحُ",49,"ح",1,0],["كَدّا لَهُ بِالخَطرِ أَيُّ كَدِّ","كَما يُسَدّي الحائِكُ المُسَدِّ",50,"د",1,0],["كَدَّرَ العَيشَ أَنَّني مَحبوسُ","وَاِقشَعَرَّت عَنِ المُدامِ الكُؤوسُ",51,"س",1,1],["كَدَمِ الجَوفِ إِذا ما ذاقَها","شارِبٌ قَطَّبَ مِنها وَعَبَس",52,"س",1,0],["كِدتُ مِن غَيظٍ عَلَيهِ","إِذ لَحاني أَتَفَقّا",53,"ق",2,0],["كَدَّرتِ شُربَ الغَواني لا صَفَوتِ لَنا","وَقَد صَفا لَكِ وُدّي مَورِداً فَرِدي",54,"د",2,0],["كَدُعاءِ المَكروبِ في لُجَّةِ البَح","رِ يُنادي الرَحمَنَ رَغباً وَرَهبا",55,"ب",2,0],["كَدَحنا لِفانِيَةٍ حُلوَةٍ","فَكَيفَ نَلومُكَ إِن تَكدَحي",56,"ح",2,0],["كدِرْعِ أُحَيْحَة الأوْسيّ طالتْ","عليه فهْيَ تُسْحَبُ في الرَّغامِ",57,"م",1,0],["كدَعْوَى مُسْلِمٍ ليَزيدَ حَمْل السْ","سَوابغِ في التّغاوُرِ والسلامِ",57,"م",1,0],["كدودةِ الأرضِ نورُ الشمس يقتلها","وكم بها قُتِلتْ في الروضِ أزهارُ",58,"ر",1,0],["كدُفْعَةِ مَوْجٍ من سَرابٍ تَدَفّعَتْ","به وتَرامَتْ خالِياتٌ بَسابِس",59,"س",1,0],["كدويِّ الأمواج إذ تَتَدَفّع","بعيدةَ الأغوار",60,"ر",1,0],["كدتُ أخشى عليكمُ تلفَ النفْ","سِ ببان اللِّوى وظبْي الصرائم",61,"م",1,0],["كَدَأبِكَ مِن أُمِّ الحُوَيرِثِ قَبلَها","وَجارَتِها أُمِّ الرَبابِ بِمَأسَلِ",62,"ل",1,0],["كَدَأبِ بَني المُعَمِّرِ، حينَ زَارُوا","بَني عُمَرٍ، بُمُصْمِيَةٍ شَعُوبِ",63,"ب",1,0],["كدت أقضي إذ غاب عني حبيب","وسواء حضوره والمغيب",64,"ب",1,1],["كِدْتُ أَقْضي، إذْ رَأَيْتُ لَهُ","مَنْزِلاً بِکلخَيْفِ قَدْ طَسَما",65,"م",2,0],["كَدُمى العاجِ في المَحاريبِ أَو كَال","بَيضِ في الرَوضِ زَهرُهُ مُستَنيرُ",66,"ر",1,0],["كدت أنسى بها العراقَ وإن أن","قى ندوبا بمهجتي فندوبا",67,"ب",2,0]]}