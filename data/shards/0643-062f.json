n.net/poem57342.html","الكامل"],[392,"كدود كدود القزينسج دائما","https://www.aldiwan.net/poem54440.html","عموديه"],[403,"وبديع الحسن ألمى","https://www.aldiwan.net/poem46706.html","مجزوء الرمل"],[404,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[407,"خليلي مرا بالعقيق فسلما","https://www.aldiwan.net/poem50106.html","الطويل"],[433,"نثرن عليه من صدف الخيام","https://www.aldiwan.net/poem12735.html","الوافر"],[469,"يا من وفيت وما وفى","https://www.aldiwan.net/poem59854.html","الكامل"],[469,"كدر الزمان فليس فيه صفا","https://www.aldiwan.net/poem59869.html","أحذ الكامل"],[469,"كدر ما راق بإسرافه","https://www.aldiwan.net/poem59872.html","السريع"],[469,"كدر عيشي بالقلى شادن","https://www.aldiwan.net/poem60051.html","السريع"],[478,"عليل الوجد عندك لا يعاد","https://www.aldiwan.net/poem15313.html","الوافر"],[480,"كدت أخلو بالحبيب إنما","https://www.aldiwan.net/poem37003.html","الرمل"],[539,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[539,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[539,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"],[552,"عج بوادي البشام علك أن تق","https://www.aldiwan.net/poem47214.html","الخفيف"],[552,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[559,"إن الوجود حقيقة لا تدرك","https://www.aldiwan.net/poem34285.html","الكامل"],[559,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[559,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[563,"لا يلزم القمر المنير المشرقا","https://www.aldiwan.net/poem52951.html","الكامل"],[568,"بأبي أنت تباغضت","https://www.aldiwan.net/poem69622.html","مجزوء الرمل"],[576,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["كَدَأبِها يَومَ يَمٍّ وَالقَنا شَرَعٌ","وَالضَربُ يُبعِدُ بَينَ العُنقِ وَالكَفَلِ",0,"ل",1,0],["كَدافِعٍ في صَدرِ سَي","لِ الطَودِ وَهوَ سائِلُ",1,"ل",1,0],["كَدَأبِكُمُ مِنهُ غَداةَ حَداكُمُ","تُشاغِلُهُ الأَذانُ عَن طَرَبِ الحُدا",2,"د",2,0],["كَدُميَةِ بيعَةٍ بِالرومِ أَضحَت","يُعَظَّمُ عِندَ رُؤيَتِها المَسيحُ",3,"ح",1,0],["كدَحْتَ الى رَبّ الجَمال مُلاقِياً","فَيا أيُّها الإنسانُ إنك كادِحُ",4,"ح",1,0],["كَدُميَةٍ صُوِّرَ مِحرابُها","بِمُذهَبٍ في مَرمَرٍ مائِرِ",5,"ر",1,0],["كَدَمِ الذَبيحِ غَريبَةً","مِمّا يُعَتِّقُ أَهلُ بابِل",6,"ل",1,0],["كَدَأبِكَ مِن أُمِّ الحُوَيرِثِ قَبلَه","وَجارَتِها أُمِّ الرَبابِ بِمَأسَلِ",7,"ل",1,0],["كَدَحتَ لَها كَدحَ اِمرِىٍ مُتَحَرِّجٍ","قَد أَيقَنَ أَنَّ اللَهَ سَوفَ يَدينُها",8,"ن",3,0],["كَدُهمِ الرِّكابِ بأثقالِها","غَدَت مِن سَماهِيجَ أَو مِن جُواثا",9,"ث",2,0],["كَدَبورٍ وَشَمالٍ","في حِياضٍ لَقِفَه",10,"ف",2,0],["كدى أنسى بها العراق وأن أب","قى ندوباً بمهجتي فندوبا",11,"ب",2,0],["كدّرت عيشي الحوادثُ حتى","لا أرى الصفو غير وقت الرقاد",12,"د",1,0],["كدرهم وجهه يشفّ عن النق","دِ خلاصاً وقلبه زغل",13,"ل",1,0],["كدَّر لي دهري الحياة ومذ","رجوتُ منه الصفاءَ صفا لي",14,"ي",1,0],["كدأْب عَليٍّ في المواطن قبله","أبي حسنٍ والغصن من حيث يخرجُ",15,"ج",1,0],["كدّر الدهرُ صفوها بعبيد ال","لَه وجهِ الحمار والخنزير",16,"ر",1,0],["كدرتَ قبل استقاء آملك ال","خائب قبحاً للوجه والخبر",17,"ر",1,0],["كدجلةَ يجري ماؤُها في سبيله","فلا ينتحي عن قصده للمعادلِ",18,"ل",1,0],["كدتَ أعداءَهم بكيدٍ عظيم","دبَّ للقومِ في شخاصٍ ضِئالِ",19,"ل",1,0],["كدأْبِ من لم يرثْ أوائِلُه","سابقةً في العلا ولا قَدما",20,"م",2,0],["كدأبِ النَّحلِ أرْيٌ أو حُماتٌ","ودأبِ النخلِ شَوْك أو جُرامُ",21,"م",1,0],["كدُّك حُرّاً بغَير منفعة","رأيٌ يراه الرجال مأفونا",22,"ن",2,0],["كدتُ أَن أَخرُجَ عَن طَورِ النُهى","رُبَّ سُكرٍ لَم يَكُن مِن قَدَحِ",23,"ح",1,0],["كِدتُ بَينَ الناسِ أَن أَلثِمَهُ","آهِ لَو أَفعَلُ ماكانَ عَليَّ",24,"ي",1,0],["كَدُخانِ مُرتَجِلٍ بِأَعلى تَلعَةٍ","غَرثانَ ضَرَّمَ عَرفَجاً مَبلولا",25,"ل",2,0],["كدنشواى وتعيين أردت به","قتل الحمام وإحياء الزغاليل",26,"ل",1,0],["كِدتَ مِن قَتلِ المَنايا خِبرَةً","تَعلَمُ الآجالَ أَيّانَ تَحين",27,"ن",1,0],["كَدَعواكِ كُلٌّ يَدَّعي صِحَّةَ العَقلِ","وَمَن ذا الَّذي يَدري بِما فيهِ مِن جَهلِ",28,"ل",1,1],["كَدَأبِ بَني المُعَمِّرِ حينَ زاروا","بَني عَمروٍ بِمُصمِيَةٍ شَعوبِ",29,"ب",1,0],["كِدنَ يَنهَبنَهُ العُيونِ سِراعاً","فيهِ لَو أَمكَنَ العُيونَ اِنتِهابُه",30,"ب",2,0],["كِدتُ أَقضي إِذا غابَ عَنّي الحَبيبُ","وَسَواءٌ حُضورُهُ وَالمَغيبُ",31,"ب",1,1],["كَدُرَّةِ غَوّاصٍ رَمى في مَهيبَةٍ","بِأَجرامِهِ وَالنَفسُ يَخشى ضَميرُها",32,"ر",3,0],["كَداوُدَ إِذ وَلّى سُلَيمانَ بَعدَهُ","خِلافَتَهُ نِحلاً مِنَ اللَهِ ذي الفَضلِ",33,"ل",1,0],["كُدَّ كَدَّ العَبدِ إِن أَح","بَيتَ أَن تُصبِحَ حُرّاً",34,"ر",2,1],["كَدَرُ الصَفاءِ مِنَ الصَدي","قِ فَما تَرى إِلّا مِزاجا",35,"ج",2,0],["كِدتِ المُحِبَّ فَما أَنتِ بِطالِبَةٍ","فَنا مُحِبُّكِ مَع إِشماتِ أَعداكِ",36,"ك",1,0],["كِدتُ أَنجو مِنَ القُدودِ وَلَكِن","أَدرَكَتني فيها بِطَعنٍ دِراكِ",37,"ك",1,0],["كد على كدٍّ ولست ببالغ","إلا ضنى متتابعاً ونحولا",38,"ل",2,0],["كِدتُ وَأَخطَأتُ بِذِكراكَ أَن","أُقتَلَ بَينَ الوَردِ وَالآسِ",39,"س",1,0],["كِدتَ تُدعى لَو أَنَّ خَلفَكَ قُدّا","مَكَ في الحَربِ يا حُدَيّا الرِياحِ",40,"ح",1,0],["كِدتُ أَقضي إِذ رَأَيتُ لَهُ","مَنزِلاً بِالخَيفِ قَد طَسَما",41,"م",2,0],["كِدتُ يَومَ الرَحيلِ أَقضي حَياتي","لَيتَني مِتُّ قَبلَ يَومَ الرَحيلِ",42,"ل",1,1],["كَدَأْبِكَ إذ قالوا أًصيبَ مُحَمَّدٌ","وقد جاءَهم بالزُّورِ مَن كان سَاخِرا",43,"ر",2,0],["كَدَفعِ دَوالِجَ مِن أُكرَةٍ","مَواهِبَ جَمٌّ لَها المَنضَحُ",44,"ح",1,0],["كَدَحتُ بِأَظفاري وَأَعمَلتُ مِعوَلي","فَصادَفتُ جُلموداً مِنَ الصَخرِ أَملَسا",45,"س",2,1],["كَدَمعَةٍ جارِيَةٍ في مَحجِرِ","تُسقى عُقاراً كَالسِراجِ الأَزهَرِ",46,"ر",1,0],["كِدتُ أَقولُ البَدرُ شِبهٌ لَها","أَجعَلُها كَالبَدرِ حاشاها",47,"ه",2,0],["كدَأبِكَ ابنَ نَبيِّ اللّهِ لم يَزَلِ","قتلُ الملوكِ ونقلُ المُلكِ والدُّوَلِ",48,"ل",1,1],["كِدنا عَلى عِلمِنا لِلشَكِّ نَسأَلُهُ","أَراحُنا نارُنا أَم نارُنا الراحُ",49,"ح",1,0],["كَدّا لَهُ بِالخَطرِ أَيُّ كَدِّ","كَما يُسَدّي الحائِكُ المُسَدِّ",50,"د",1,0],["كَدَّرَ العَيشَ أَنَّني مَحبوسُ","وَاِقشَعَرَّت عَنِ المُدامِ الكُؤوسُ",51,"س",1,1],["كَدَمِ الجَوفِ إِذا ما ذاقَها","شارِبٌ قَطَّبَ مِنها وَعَبَس",52,"س",1,0],["كِدتُ مِن غَيظٍ عَلَيهِ","إِذ لَحاني أَتَفَقّا",53,"ق",2,0],["كَدَّرتِ شُربَ الغَواني لا صَفَوتِ لَنا","وَقَد صَفا لَكِ وُدّي مَورِداً فَرِدي",54,"د",2,0],["كَدُعاءِ المَكروبِ في لُجَّةِ البَح","رِ يُنادي الرَحمَنَ رَغباً وَرَهبا",55,"ب",2,0],["كَدَحنا لِفانِيَةٍ حُلوَةٍ","فَكَيفَ نَلومُكَ إِن تَكدَحي",56,"ح",2,0],["كدِرْعِ أُحَيْحَة الأوْسيّ طالتْ","عليه فهْيَ تُسْحَبُ في الرَّغامِ",57,"م",1,0],["كدَعْوَى مُسْلِمٍ ليَزيدَ حَمْل السْ","سَوابغِ في التّغاوُرِ والسلامِ",57,"م",1,0],["كدودةِ الأرضِ نورُ الشمس يقتلها","وكم بها قُتِلتْ في الروضِ أزهارُ",58,"ر",1,0],["كدُفْعَةِ مَوْجٍ من سَرابٍ تَدَفّعَتْ","به وتَرامَتْ خالِياتٌ بَسابِس",59,"س",1,0],["كدويِّ الأمواج إذ تَتَدَفّع","بعيدةَ الأغوار",60,"ر",1,0],["كدتُ أخشى عليكمُ تلفَ النفْ","سِ ببان اللِّوى وظبْي الصرائم",61,"م",1,0],["كَدَأبِكَ مِن أُمِّ الحُوَيرِثِ قَبلَها","وَجارَتِها أُمِّ الرَبابِ بِمَأسَلِ",62,"ل",1,0],["كَدَأبِ بَني المُعَمِّرِ، حينَ زَارُوا","بَني عُمَرٍ، بُمُصْمِيَةٍ شَعُوبِ",63,"ب",1,0],["كدت أقضي إذ غاب عني حبيب","وسواء حضوره والمغيب",64,"ب",1,1],["كِدْتُ أَقْضي، إذْ رَأَيْتُ لَهُ","مَنْزِلاً بِکلخَيْفِ قَدْ طَسَما",65,"م",2,0],["كَدُمى العاجِ في المَحاريبِ أَو كَال","بَيضِ في الرَوضِ زَهرُهُ مُستَنيرُ",66,"ر",1,0],["كدت أنسى بها العراقَ وإن أن","قى ندوبا بمهجتي فندوبا",67,"ب",2,0],["كَدَأبِ رَبيعٍ وَالعُمورِ وَلَفِّها","وَمَن حَلَّ أَرفاغاً بِتِلكَ المَرامِثِ",68,"ث",1,0],["كدرهمٍ حُطَّ فوقَ سُنْدُسةٍ","أَدقَّ فيه النَّقَّاش ما زَوَّق",69,"ق",1,0],["كدر كليل دامس","والعيش أبغضه المكدّر",70,"ر",1,0],["كدنا نُجَنُّ وقد تأهبَ أهلُها","وجننتُ لما ودَّعوا أو كادوا",71,"د",3,0],["كدت أنسى أن الغرام ضلال","كدت أنسى أن الغرام فسوق",72,"ق",1,0],["كدتُ أشكو إليه شوقي إليه","فتعوذتُ بالحميد المجيد",73,"د",1,0],["كدت أنسى هواي يوم هواه","إن خمر الجمال ينسى العقارا",74,"ر",2,0],["كدت باللوعة والوجد أبوح","فأداوى ما بروحي من جروح",75,"ح",1,0],["كدت أهوى على سناها بقلب","سادرٍ في ضلاله مجنون",76,"ن",1,0],["كدأبكم وقد مرنت نهاكم","على سرت الخيانة بالخلاب",77,"ب",1,0],["كدت لا أعرف من هذا الغزال","غير أنوارٍ لطاف وظلال",78,"ل",1,0],["كدرّة في أذْن أحوى أحور","وافترقت بيضُ النجوم السُّمَّرِ",79,"ر",1,0],["كدَّر الموتُ صفوَ عيشي وهل في الْ","أَرْضِ عيشٌ ما شابَهُ تكدير",80,"ر",1,0],["كَدَمِ الغَزالِ إِذا بَكى","راوُوقُها خِلناهُ راعِف",81,"ف",1,0],["كدت أنسى تلك العهودَ ولكن","ذكرتني وما نسيتُ عُهودي",82,"د",2,0],["كداود لما ورث العلم ابنه","سليمان بث الحكم في كل جانب",83,"ب",1,0],["كديكٍ يحيِّي الشّمسَ حيَّيتُ بسمةً","تنيرُ بها ليلَ النّوى شفتاك",84,"ك",1,0],["كَدَأْبِكَ أَيَّامَ الْحَوَادِثُ نُوَّمٌ","وَجَدُّكَ يَقْظَانٌ وَحَدُّكَ مِقْصَلُ",85,"ل",1,0],["كَدَمِ الرُعافِ عَلى مَآزِرِها","وَكَأَنَّهُنَّ ضَوامِراً إِجلُ",86,"ل",1,0],["كدُرَرِ البُحور","على نحور الحورِ",87,"ر",1,0],["كديت منه الوصل ثم انطفت","في ظلمةِ العارض مشكاتي",88,"ي",1,1],["كدت أن أحسد المجدد عهداً","كل وقت لبيت ربي الحرام",89,"م",1,0],["كدت من وصله أقارب يأساً","لامتداد المدى وطول الحبال",90,"ل",1,0],["كدت أرتاح للحديث عن القرد","أبا أوّلا وأنكر آدم",91,"م",1,0],["كِدتُ أفنى روحي وعقلي وجسمي","باحثاً عن مظَنّةٍ من حقيقه",91,"ه",1,0],["كِدْنَا وَقَدْ رَقَّ العِتَابُ بَيننا","نَحُلُّ مِن عَزْمِ الفِراقِ ما انْعَقَدْ",92,"د",1,0],["كديش كان ذا صَبرٍ إِذا ما","رَماهُ الجوع بِالأَمر العَسيرِ",93,"ر",1,0],["كدَرَتْ فليس يَبينُ آخرُ أمرها","وظُهورُ قَعْرِ الماء عند صَفائه",94,"ا",3,0],["كدُجُنّةٍ صَقلَتْ دَرارِيَ جَمّةً","ومُحِدَّةٍ كشفَتْ مَحاسِرَ نُصَّلا",95,"ل",2,0],["كدأب أصحابِ الجُفون الَّتي","توازَرَت فاحتَملَت وِزري",96,"ر",2,0],["كدَّ النَّدى يدَه فأمرضَ ما لَها","مَرضاً شُفيتُ به مِن الأمراضِ",97,"ض",1,0],["كدود كدود القزينسج دائما","ويهلك غما بطن ماهو ناسجه",98,"ه",1,1],["كِدتُ أن أهلكَ فيه","غير أن الله سَلّمْ",99,"م",1,0],["كدعواك في أن الصحابة أجمعوا","على قتلهم والسبي والنهب والطرد",100,"د",1,0],["كَدأبك من أَسماء يَوم تَرَحَّلت","تريك خِلال السِجف كَفّاً وَمعصِما",101,"م",2,0],["كدَدْتُ بهزهم فكري فأنحتْ","على عضُدي ممارسة الكَهامِ",102,"م",1,0],["كَدَرٌ تُغَصِّصُهُ بِهِ","إِلّ