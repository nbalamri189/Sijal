,[5145,"آه للمكرمات والآداب","https://www.poetsgate.com/ViewPoem.aspx?id=108242",""],[5186,"أبدا تعن عليكم الأرباح","https://www.poetsgate.com/ViewPoem.aspx?id=156526",""],[5268,"سيمرُّ في دَمِنا الرَصاصُ","https://www.poetsgate.com/ViewPoem.aspx?id=207018",""],[5277,"جمعة مباركة","https://www.poetsgate.com/ViewPoem.aspx?id=189749",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[5431,"قبلة الأمس...","https://www.poetsgate.com/ViewPoem.aspx?id=210259",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5458,"رحم الله أم ديبو","https://www.poetsgate.com/ViewPoem.aspx?id=72164",""],[5531,"أذكريني يامنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=128418",""],[5582,"ما لِي أَصَبُّ إِلَى الحَياةِ وَما لِي","https://www.poetsgate.com/ViewPoem.aspx?id=187226",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5690,"ضاءت الأكوان والدهر ابتسمْ","https://www.poetsgate.com/ViewPoem.aspx?id=172184",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5725,"أقات الموت","https://www.poetsgate.com/ViewPoem.aspx?id=208791",""],[5736,"رواج","https://www.poetsgate.com/ViewPoem.aspx?id=203865",""],[5753,"كتابي مثقلٌ..","https://www.poetsgate.com/ViewPoem.aspx?id=198538",""],[5781,"خَمائِلهُ بِلَونِ دمي","https://www.poetsgate.com/ViewPoem.aspx?id=208990",""],[6069,"ألآل ضواحكٌ أم ثغور","https://www.poetsgate.com/ViewPoem.aspx?id=105665",""],[6079,"ألا ليت القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=207373",""],[6102,"ظهيرة تحت رحمة الكهرباء","https://www.poetsgate.com/ViewPoem.aspx?id=184444",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[6189,"الريحانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83581&r=&rc=48",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["كَدَأبِها يَومَ يَمٍّ وَالقَنا شَرَعٌ","وَالضَربُ يُبعِدُ بَينَ العُنقِ وَالكَفَلِ",0,"ل",1,0],["كَدافِعٍ في صَدرِ سَي","لِ الطَودِ وَهوَ سائِلُ",1,"ل",1,0],["كَدَأبِكُمُ مِنهُ غَداةَ حَداكُمُ","تُشاغِلُهُ الأَذانُ عَن طَرَبِ الحُدا",2,"د",2,0],["كَدُميَةِ بيعَةٍ بِالرومِ أَضحَت","يُعَظَّمُ عِندَ رُؤيَتِها المَسيحُ",3,"ح",1,0],["كدَحْتَ الى رَبّ الجَمال مُلاقِياً","فَيا أيُّها الإنسانُ إنك كادِحُ",4,"ح",1,0],["كَدُميَةٍ صُوِّرَ مِحرابُها","بِمُذهَبٍ في مَرمَرٍ مائِرِ",5,"ر",1,0],["كَدَمِ الذَبيحِ غَريبَةً","مِمّا يُعَتِّقُ أَهلُ بابِل",6,"ل",1,0],["كَدَأبِكَ مِن أُمِّ الحُوَيرِثِ قَبلَه","وَجارَتِها أُمِّ الرَبابِ بِمَأسَلِ",7,"ل",1,0],["كَدَحتَ لَها كَدحَ اِمرِىٍ مُتَحَرِّجٍ","قَد أَيقَنَ أَنَّ اللَهَ سَوفَ يَدينُها",8,"ن",3,0],["كَدُهمِ الرِّكابِ بأثقالِها","غَدَت مِن سَماهِيجَ أَو مِن جُواثا",9,"ث",2,0],["كَدَبورٍ وَشَمالٍ","في حِياضٍ لَقِفَه",10,"ف",2,0],["كدى أنسى بها العراق وأن أب","قى ندوباً بمهجتي فندوبا",11,"ب",2,0],["كدّرت عيشي الحوادثُ حتى","لا أرى الصفو غير وقت الرقاد",12,"د",1,0],["كدرهم وجهه يشفّ عن النق","دِ خلاصاً وقلبه زغل",13,"ل",1,0],["كدَّر لي دهري الحياة ومذ","رجوتُ منه الصفاءَ صفا لي",14,"ي",1,0],["كدأْب عَليٍّ في المواطن قبله","أبي حسنٍ والغصن من حيث يخرجُ",15,"ج",1,0],["كدّر الدهرُ صفوها بعبيد ال","لَه وجهِ الحمار والخنزير",16,"ر",1,0],["كدرتَ قبل استقاء آملك ال","خائب قبحاً للوجه والخبر",17,"ر",1,0],["كدجلةَ يجري ماؤُها في سبيله","فلا ينتحي عن قصده للمعادلِ",18,"ل",1,0],["كدتَ أعداءَهم بكيدٍ عظيم","دبَّ للقومِ في شخاصٍ ضِئالِ",19,"ل",1,0],["كدأْبِ من لم يرثْ أوائِلُه","سابقةً في العلا ولا قَدما",20,"م",2,0],["كدأبِ النَّحلِ أرْيٌ أو حُماتٌ","ودأبِ النخلِ شَوْك أو جُرامُ",21,"م",1,0],["كدُّك حُرّاً بغَير منفعة","رأيٌ يراه الرجال مأفونا",22,"ن",2,0],["كدتُ أَن أَخرُجَ عَن طَورِ النُهى","رُبَّ سُكرٍ لَم يَكُن مِن قَدَحِ",23,"ح",1,0],["كِدتُ بَينَ الناسِ أَن أَلثِمَهُ","آهِ لَو أَفعَلُ ماكانَ عَليَّ",24,"ي",1,0],["كَدُخانِ مُرتَجِلٍ بِأَعلى تَلعَةٍ","غَرثانَ ضَرَّمَ عَرفَجاً مَبلولا",25,"ل",2,0],["كدنشواى وتعيين أردت به","قتل الحمام وإحياء الزغاليل",26,"ل",1,0],["كِدتَ مِن قَتلِ المَنايا خِبرَةً","تَعلَمُ الآجالَ أَيّانَ تَحين",27,"ن",1,0],["كَدَعواكِ كُلٌّ يَدَّعي صِحَّةَ العَقلِ","وَمَن ذا الَّذي يَدري بِما فيهِ مِن جَهلِ",28,"ل",1,1],["كَدَأبِ بَني المُعَمِّرِ حينَ زاروا","بَني عَمروٍ بِمُصمِيَةٍ شَعوبِ",29,"ب",1,0],["كِدنَ يَنهَبنَهُ العُيونِ سِراعاً","فيهِ لَو أَمكَنَ العُيونَ اِنتِهابُه",30,"ب",2,0],["كِدتُ أَقضي إِذا غابَ عَنّي الحَبيبُ","وَسَواءٌ حُضورُهُ وَالمَغيبُ",31,"ب",1,1],["كَدُرَّةِ غَوّاصٍ رَمى في مَهيبَةٍ","بِأَجرامِهِ وَالنَفسُ يَخشى ضَميرُها",32,"ر",3,0],["كَداوُدَ إِذ وَلّى سُلَيمانَ بَعدَهُ","خِلافَتَهُ نِحلاً مِنَ اللَهِ ذي الفَضلِ",33,"ل",1,0],["كُدَّ كَدَّ العَبدِ إِن أَح","بَيتَ أَن تُصبِحَ حُرّاً",34,"ر",2,1],["كَدَرُ الصَفاءِ مِنَ الصَدي","قِ فَما تَرى إِلّا مِزاجا",35,"ج",2,0],["كِدتِ المُحِبَّ فَما أَنتِ بِطالِبَةٍ","فَنا مُحِبُّكِ مَع إِشماتِ أَعداكِ",36,"ك",1,0],["كِدتُ أَنجو مِنَ القُدودِ وَلَكِن","أَدرَكَتني فيها بِطَعنٍ دِراكِ",37,"ك",1,0],["كد على كدٍّ ولست ببالغ","إلا ضنى متتابعاً ونحولا",38,"ل",2,0],["كِدتُ وَأَخطَأتُ بِذِكراكَ أَن","أُقتَلَ بَينَ الوَردِ وَالآسِ",39,"س",1,0],["كِدتَ تُدعى لَو أَنَّ خَلفَكَ قُدّا","مَكَ في الحَربِ يا حُدَيّا الرِياحِ",40,"ح",1,0],["كِدتُ أَقضي إِذ رَأَيتُ لَهُ","مَنزِلاً بِالخَيفِ قَد طَسَما",41,"م",2,0],["كِدتُ يَومَ الرَحيلِ أَقضي حَياتي","لَيتَني مِتُّ قَبلَ يَومَ الرَحيلِ",42,"ل",1,1],["كَدَأْبِكَ إذ قالوا أًصيبَ مُحَمَّدٌ","وقد جاءَهم بالزُّورِ مَن كان سَاخِرا",43,"ر",2,0],["كَدَفعِ دَوالِجَ مِن أُكرَةٍ","مَواهِبَ جَمٌّ لَها المَنضَحُ",44,"ح",1,0],["كَدَحتُ بِأَظفاري وَأَعمَلتُ مِعوَلي","فَصادَفتُ جُلموداً مِنَ الصَخرِ أَملَسا",45,"س",2,1],["كَدَمعَةٍ جارِيَةٍ في مَحجِرِ","تُسقى عُقاراً كَالسِراجِ الأَزهَرِ",46,"ر",1,0],["كِدتُ أَقولُ البَدرُ شِبهٌ لَها","أَجعَلُها كَالبَدرِ حاشاها",47,"ه",2,0],["كدَأبِكَ ابنَ نَبيِّ اللّهِ لم يَزَلِ","قتلُ الملوكِ ونقلُ المُلكِ والدُّوَلِ",48,"ل",1,1],["كِدنا عَلى عِلمِنا لِلشَكِّ نَسأَلُهُ","أَراحُنا نارُنا أَم نارُنا الراحُ",49,"ح",1,0],["كَدّا لَهُ بِالخَطرِ أَيُّ كَدِّ","كَما يُسَدّي الحائِكُ المُسَدِّ",50,"د",1,0],["كَدَّرَ العَيشَ أَنَّني مَحبوسُ","وَاِقشَعَرَّت عَنِ المُدامِ الكُؤوسُ",51,"س",1,1],["كَدَمِ الجَوفِ إِذا ما ذاقَها","شارِبٌ قَطَّبَ مِنها وَعَبَس",52,"س",1,0],["كِدتُ مِن غَيظٍ عَلَيهِ","إِذ لَحاني أَتَفَقّا",53,"ق",2,0],["كَدَّرتِ شُربَ الغَواني لا صَفَوتِ لَنا","وَقَد صَفا لَكِ وُدّي مَورِداً فَرِدي",54,"د",2,0],["كَدُعاءِ المَكروبِ في لُجَّةِ البَح","رِ يُنادي الرَحمَنَ رَغباً وَرَهبا",55,"ب",2,0],["كَدَحنا لِفانِيَةٍ حُلوَةٍ","فَكَيفَ نَلومُكَ إِن تَكدَحي",56,"ح",2,0],["كدِرْعِ أُحَيْحَة الأوْسيّ طالتْ","عليه فهْيَ تُسْحَبُ في الرَّغامِ",57,"م",1,0],["كدَعْوَى مُسْلِمٍ ليَزيدَ حَمْل السْ","سَوابغِ في التّغاوُرِ والسلامِ",57,"م",1,0],["كدودةِ الأرضِ نورُ الشمس يقتلها","وكم بها قُتِلتْ في الروضِ أزهارُ",58,"ر",1,0],["كدُفْعَةِ مَوْجٍ من سَرابٍ تَدَفّعَتْ","به وتَرامَتْ خالِياتٌ بَسابِس",59,"س",1,0],["كدويِّ الأمواج إذ تَتَدَفّع","بعيدةَ الأغوار",60,"ر",1,0],["كدتُ أخشى عليكمُ تلفَ النفْ","سِ ببان اللِّوى وظبْي الصرائم",61,"م",1,0],["كَدَأبِكَ مِن أُمِّ الحُوَيرِثِ قَبلَها","وَجارَتِها أُمِّ الرَبابِ بِمَأسَلِ",62,"ل",1,0],["كَدَأبِ بَني المُعَمِّرِ، حينَ زَارُوا","بَني عُمَرٍ، بُمُصْمِيَةٍ شَعُوبِ",63,"ب",1,0],["كدت أقضي إذ غاب عني حبيب","وسواء حضوره والمغيب",64,"ب",1,1],["كِدْتُ أَقْضي، إذْ رَأَيْتُ لَهُ","مَنْزِلاً بِکلخَيْفِ قَدْ طَسَما",65,"م",2,0],["كَدُمى العاجِ في المَحاريبِ أَو كَال","بَيضِ في الرَوضِ زَهرُهُ مُستَنيرُ",66,"ر",1,0],["كدت أنسى بها العراقَ وإن أن","قى ندوبا بمهجتي فندوبا",67,"ب",2,0],["كَدَأبِ رَبيعٍ وَالعُمورِ وَلَفِّها","وَمَن حَلَّ أَرفاغاً بِتِلكَ المَرامِثِ",68,"ث",1,0],["كدرهمٍ حُطَّ فوقَ سُنْدُسةٍ","أَدقَّ فيه النَّقَّاش ما زَوَّق",69,"ق",1,0],["كدر كليل دامس","والعيش أبغضه المكدّر",70,"ر",1,0],["كدنا نُجَنُّ وقد تأهبَ أهلُها","وجننتُ لما ودَّعوا أو كادوا",71,"د",3,0],["كدت أنسى أن الغرام ضلال","كدت أنسى أن الغرام فسوق",72,"ق",1,0],["كدتُ أشكو إليه شوقي إليه","فتعوذتُ بالحميد المجيد",73,"د",1,0],["كدت أنسى هواي يوم هواه","إن خمر الجمال ينسى العقارا",74,"ر",2,0],["كدت باللوعة والوجد أبوح","فأداوى ما بروحي من جروح",75,"ح",1,0],["كدت أهوى على سناها بقلب","سادرٍ في ضلاله مجنون",76,"ن",1,0],["كدأبكم وقد مرنت نهاكم","على سرت الخيانة بالخلاب",77,"ب",1,0],["كدت لا أعرف من هذا الغزال","غير أنوارٍ لطاف وظلال",78,"ل",1,0],["كدرّة في أذْن أحوى أحور","وافترقت بيضُ النجوم السُّمَّرِ",79,"ر",1,0],["كدَّر الموتُ صفوَ عيشي وهل في الْ","أَرْضِ عيشٌ ما شابَهُ تكدير",80,"ر",1,0],["كَدَمِ الغَزالِ إِذا بَكى","راوُوقُها خِلناهُ راعِف",81,"ف",1,0],["كدت أنسى تلك العهودَ ولكن","ذكرتني وما نسيتُ عُهودي",82,"د",2,0],["كداود لما ورث العلم ابنه","سليمان بث الحكم في كل جانب",83,"ب",1,0],["كديكٍ يحيِّي الشّمسَ حيَّيتُ بسمةً","تنيرُ بها ليلَ النّوى شفتاك",84,"ك",1,0],["كَدَأْبِكَ أَيَّامَ الْحَوَادِثُ نُوَّمٌ","وَجَدُّكَ يَقْظَانٌ وَحَدُّكَ مِقْصَلُ",85,"ل",1,0],["كَدَمِ الرُعافِ عَلى مَآزِرِها","وَكَأَنَّهُنَّ ضَوامِراً إِجلُ",86,"ل",1,0],["كدُرَرِ البُحور","على نحور الحورِ",87,"ر",1,0],["كديت منه الوصل ثم انطفت","في ظلمةِ العارض مشكاتي",88,"ي",1,1],["كدت أن أحسد المجدد عهداً","كل وقت لبيت ربي الحرام",89,"م",1,0],["كدت من وصله أقارب يأساً","لامتداد المدى وطول الحبال",90,"ل",1,0],["كدت أرتاح للحديث عن القرد","أبا أوّلا وأنكر آدم",91,"م",1,0],["كِدتُ أفنى روحي وعقلي وجسمي","باحثاً عن مظَنّةٍ من حقيقه",91,"ه",1,0],["كِدْنَا وَقَدْ رَقَّ العِتَابُ بَيننا","نَحُلُّ مِن عَزْمِ الفِراقِ ما انْعَقَدْ",92,"د",1,0],["كديش كان ذا صَبرٍ إِذا ما","رَماهُ الجوع بِالأَمر العَسيرِ",93,"ر",1,0],["كدَرَتْ فليس يَبينُ آخرُ أمرها","وظُهورُ قَعْرِ الماء عند صَفائه",94,"ا",3,0],["كدُجُنّةٍ صَقلَتْ دَرارِيَ جَمّةً","ومُحِدَّةٍ كشفَتْ مَحاسِرَ نُصَّلا",95,"ل",2,0],["كدأب أصحابِ الجُفون الَّتي","توازَرَت فاحتَملَت وِزري",96,"ر",2,0],["كدَّ النَّدى يدَه فأمر