//www.poetsgate.com/ViewPoem.aspx?id=111968",""],[5845,"أرياحُ نجدٍ تممي إلهابا","https://www.poetsgate.com/ViewPoem.aspx?id=16703",""],[5855,"ومضروب يئن لغير ضرب","https://www.poetsgate.com/ViewPoem.aspx?id=186556",""],[5881,"تنثر أعذاراً وتختلق","https://www.poetsgate.com/ViewPoem.aspx?id=183796",""],[5956,"لم ألقَ حسناءً عليّ تجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=182620",""],[5956,"العمق","https://www.poetsgate.com/ViewPoem.aspx?id=183933",""],[5956,"أنا وهوليودُ","https://www.poetsgate.com/ViewPoem.aspx?id=192241",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[5956,"الذين رأينا الخير والفخر وأنت منهم","https://www.poetsgate.com/ViewPoem.aspx?id=193435",""],[5956,"ما قلتَ لي كلاّ أيا خير المَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193507",""],[5956,"جبال خلف جبال","https://www.poetsgate.com/ViewPoem.aspx?id=193585",""],[5956,"ما جاء لي من أي ضَوءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193825",""],[5956,"خير أمة وخير إقامةِ","https://www.poetsgate.com/ViewPoem.aspx?id=194182",""],[5956,"أرثي لمنآنا","https://www.poetsgate.com/ViewPoem.aspx?id=194495",""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[5956,"يا ربُّ يا مَن لا تضيع ودائعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=200541",""],[5956,"الله بوَّأ فريد الأطرش وأختَهُ رتبةً أُولى","https://www.poetsgate.com/ViewPoem.aspx?id=203554",""],[5956,"أرجو إله الناس يجمعني به","https://www.poetsgate.com/ViewPoem.aspx?id=207523",""],[5956,"هي سامِيا العظمى محمدُ سالكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215550",""],[5970,"منفي الأنام حياتهم","https://www.poetsgate.com/ViewPoem.aspx?id=130628",""],[6019,"تتأملُ حُلْما","https://www.poetsgate.com/ViewPoem.aspx?id=177789",""],[161,"ضاع ترتيب الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=180916",""],[6089,"نهر البصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=212970",""],[6093,"سكون مسكون","https://www.poetsgate.com/ViewPoem.aspx?id=193402",""],[6104,"بعدَ الرِّيّ","https://www.poetsgate.com/ViewPoem.aspx?id=24195",""],[6127,"لَمُّ الجراحِ","https://www.poetsgate.com/ViewPoem.aspx?id=202685",""],[6152,"أنتِ جنتي وسكينتي وشفائي","https://www.poetsgate.com/ViewPoem.aspx?id=203775",""],[6160,"صَقيعٌ لنبوءةٍ عارِية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87101&r=&rc=18",""],[6355,"من أنا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66590&r=&rc=50",""]],"verses":[["لَم آلُ جُهداً في الثَناءِ وَإِنَّما","غَطّى بِعَرضِ نَداهُ طولَ لِساني",0,"ن",2,0],["لَمّا لَحَظتَ الدَهرَ زايَلَهُ","إِظلامُهُ وَاِفتَرَّ ضَيُّقُهُ",1,"ق",2,0],["لَم أَلقَ قَبلَ ابنَةِ السَّعديِّ لي سَكَناً","يَكادُ يَلفِظُ روحي بَعدَهُ البَدَنُ",2,"ن",1,0],["لَم أَلقَ ذا صِفَةٍ لِلحُبِّ يَنعَتُهُ","إِلّا وَجَدتُ الَّذي بي فَوقَ ما وَصَفا",3,"ف",2,0],["لم أَلقَ ذا شَجَنٍ يَبوحُ بِحُبِّهِ","إِلا ظَنَنتُكِ ذَلِكَ المَحبوبا",4,"ب",2,1],["لَمْ أُلْفِ إِلاَّ عَاقِلاً مُتَأَدِّباً","فِيهِمْ وَإِلاَّ سَاعِياً مِقْدَامَا",5,"م",2,0],["لَمْ أُلْفِهِ فِي العَيْشِ إِلاَّ نَابِهاً","يَرْنُو إِلَى الدُّنْيَا بِطَرْفٍ سَامِ",6,"م",1,0],["لَمْ أُلْفِ حَيّاً والزمانُ مُذَمَّم","يَعْدُوهُ فِيهِ كَمَا عَدَاكَ الذَّامُ",7,"م",1,0],["لَمّا لَقيتَ فَوارِساً مِن عامِرٍ","سَلّوا سُيوفَهُمُ مِنَ الأَجفانِ",8,"ن",1,0],["لَمّا لَحِقنا بِظُعنِ الحَيِّ نَحسِبُها","نَخلاً تَراءَت لَنا البيضُ الرَعابيبُ",9,"ب",1,0],["لم ألْقَ في غمراتِ قومٍ مَشْرَباً","ووجدتُ في ضَحْضَاحِهِ لِي مَسْبَحَا",10,"ح",2,0],["لم ألقَ كالشعراءِ أكثر حارِضاً","وأشدَّ معْتبةً على الحُرَّاض",11,"ض",1,0],["لما لؤم المُبَشِّر يومَ نادى","أقرَّ اللَّهُ عيْنَك بالغُلامِ",12,"م",1,0],["لَمّا لَحِقنَ بِهِ أَنحى بِمِغوَلِهِ","يَملَأ فَرائِصَها مِن طَعنِهِ العَلَقُ",13,"ق",1,0],["لَم أَلقَ لي صاحِباً في اللَهِ أَصحَبُهُ","وَقَد رَأَيتُ وَقَد جَرَّبتُ أَجناسا",14,"س",2,0],["لَم أَلتَمِس عَرضَ الحَياةِ وَإِنَّما","أَقرَضتُهُ في اللَهِ وَالمُختارِ",15,"ر",1,0],["لَمّا لَمَحتُكُما سَكَبتُ مَدامِعي","فَرَحاً وَطالَ تَشَوُّفٌ وَقِيامُ",16,"م",1,0],["لُمِ اللَيالي الَّتي أَخنَت عَلى جِدَتي","بِرِقَّةِ الحالِ وَاِعذُرني وَلا تَلُمِ",17,"م",1,0],["لَم أَلقَ شَفعاً كَالسُلُّوِ وَكَالهَوى","أَنَأى وَأَبعَدَ مَصدَراً مِن مَورِدِ",18,"د",1,0],["لَم أَلقِ مَقدوراً عَلى اِستِحقاقِهِ","في الحَظِّ إِمّا ناقِصاً أَو زائِدا",19,"د",2,0],["لَم أَلقَهُ حَتّى لَقيتُ عَطاءَهُ","جَزلاً وَعَرَّفَني الغِنى مَعروفُهُ",20,"ف",2,0],["لَمّا لَقيتُ بِكَ الزَمانَ تَصَدَّعَت","عَن ساحَتي أَحداثُهُ وَصُروفُهُ",20,"ف",2,0],["لم أَلْقَ رَيحانةً ولا رَاحا","إلا ثَنَتْني إليكَ مُرتاحا",21,"ح",2,1],["لَم آلُ فيكَ تَعَسُّفاً وَتَعَجرُفاً","وَتَأَلُّقاً وَتَلَطُّفاً وَتَظَرُّفا",22,"ف",2,0],["لَمّا لَقوكَ تَواكَلوكَ وَأَعذَروا","هَرَباً فَلَم يَنفَعهُمُ الإِعذارُ",23,"ر",1,0],["لَم أَلتَزِم نَظمَ حَبّاتِ البَديعِ بِها","إِذ كانَ صَوغُ المَعانِي الغُرِّ مُلتَزمِي",24,"م",2,0],["لَمْ أَلْقَ بَعْدَكَ يَوْماً أَسْتَبِينُ بِهِ","وَجْهَ الْمَسَرَّةِ إِلَّا ظَلَّ يُبْكِينِي",25,"ن",2,0],["لم أُلفِ أحفلَ منها وهي مُوحشةٌ","بالمؤنسات ولا أزهى ميادينا",26,"ن",2,0],["لم ألْقَ بيْن لياليَّ التي سَلَفَتْ","كلَيْلةٍ بِتُّها في دْير قدِّيسِ",27,"س",1,1],["لَم أَلقَ أَهلَكِ بَعدَ عامَ لَقِيتُهُم","يا لَيتَ أَنَّ لِقاءَهُم لَم يَقدُرِ",28,"ر",1,0],["لم ألقَ في الناسِ مُجهولَ البصيرَةِ أو","مُسَوِّفاً نفسَه قولاً بلا عمَل",29,"ل",1,0],["لم ألقَ شيئاً بعدَكم حسَناً ولا","مَلِكاً سوى هذا الأغرّ لُبابا",30,"ب",2,0],["لَما لاقى جَميلٌ عُش","رَ ما لاقَيتُ مِن وَجدي",31,"د",2,0],["لَم أُلفَ كَالثَقَفيِّ بَل عِرسي هِيَ السَ","وداءُ ما جَهَّزتُها بِطَلاقِ",32,"ق",1,0],["لم ألقَ بعدكَ ما يشوقُ نواظري","عند الرياضِ فليسَ ما يصبيني",33,"ن",2,0],["لَمْ أَلْقَ مِنْ بَعْدِكُمْ يَوْماً أُسَرُّ بِهِ","كَأَنَّ كُلَّ سُرُورٍ بَعْدَكُمْ حَزَنُ",34,"ن",1,0],["لمَّ إلالهُ به شعثاً ورَمَّ به","أمورَ أُمَّتِهِ والأمرُ مُنْتشِرُ",35,"ر",1,1],["لَم أَلهُ بِالحَسناءِ مُذ","أَودى وَلَم تَلتَهِ بي",36,"ي",1,0],["لم ألقَ في مصر فنَّانًا يزاوله","إلا تلقَّى على «حسني» مباديه",37,"ي",2,0],["لم ألقَ مثلكما: فنًّا وصاحبَهُ","يفني شبابك فنَّاء وتحييه",37,"ي",2,0],["لم أَلْقَ حيًّا مثلَهُ","أحياؤُه لا يُرْزَقون",38,"ن",1,0],["لم ألق في غير الكويت «خواجة»","يَدَعُ الخمورَ، ويشربُ الخرّوبا",39,"ب",2,0],["لم التفاني في براض آسن","لا يرتجى من نبضه بل الصدى",40,"ا",1,0],["لم التحجي بعدهم في شرف","عند رفات القوم في الأرض حجا",40,"ا",1,0],["لما لا يموت الموت كالناس؟ ما الذي","سيعمل إن باد الورى وهو خالد؟",41,"د",1,0],["لم ألقَ كالشعراءِ أكثر حارِضاً","وأشدَّ معْتية ً على الحُرَّاض",42,"ض",1,0],["لَمّا کلْتَقَيْنَا رَحَّبَتْ تِرْبُها","هِنْدٌ وَقَالَتْ: قُلَّباً حُوَّلا",43,"ل",2,0],["لمال اليها الجذع حتى بحجرها","جنته ولكن كل شيء له سبب",44,"ب",1,0],["لم ألقَ فيما عشتهُ عالماً","يقال فيه حاز كل الوسام",45,"م",1,0],["لما لقينا من تُجاهِك عصبةً","نضحَتْ بشكواها ذَفَارَى العِيرِ",46,"ر",1,0],["لما لبست إلاَّ بحسنك حسنها","ولا بد للحسناء من نفحة العطر",47,"ر",1,0],["لم ألق في الجند منهم مشربا","ومنه في الشط لقيت مسبحا",48,"ح",2,0],["لُمِ الغَيثَ وَاِعذِر مَن لِقاؤُكَ عِندَهُ","يُعادِلُ نَيلَ الخُلدِ بَل هُوَ أَكبَرُ",49,"ر",1,0],["لِمالٍ أَو لِعِزٍّ أَو لِعلمٍ","تُعاني وَيبَ غَيرِكَ ما تُعاني",50,"ن",2,0],["لَم أَلُمهُ أَنِ اِتَقّى بِحجابٍ","رَدّني واله الفُؤادِ لِما بي",51,"ب",2,0],["لم ألقَ ممن نظروا وجههُ","الا فتىً يعشقُ أويدعي",52,"ع",2,0],["لم الق قبل محياه وطرته","صبحا اضا في دجا ليل من الشعر",53,"ر",1,0],["لما لساقو كشف من رام اعطافي","عزيز طاهر حسن اشرف على التلاقي",54,"ي",1,1],["لم ألق بعدك منهمو","إلا الجفاء أو العقوق",55,"ق",1,0],["لم آل جهداً في اختلاسِ فؤادِها","حتى أطاعت بعدَ طولِ مِرَاسِ",56,"س",1,0],["لم أَلقَ في ذا الدهر من أَشكُو له","رَيب الزمان إذ تَعَدَّى واجتَرا",57,"ر",2,0],["لَم ألف غيرك من أَلوذُ به اذا","مكر الزَمان وَقطع الاسبابا",58,"ب",2,0],["لَمْ آلُ مَدْحاً له وَخِلالِهِ","لَكِنْ عَجَزْتُ رَوِيةً وَبَدِيها",59,"ي",3,0],["لَمَّا لَثَمْتُ يَمِينَه ورَأيْتُه","لَمْ أَلْتَفِتْ لحَياً ولا لِهِلالِ",60,"ل",1,0],["لَم أَلقَ مِن أَحَدٍ إِلّا وَأَنشَدَني","ما بالُ عَينِكَ مِنها الماءُ يَنسَكِبُ",61,"ب",1,0],["لم ألق في كرم الطباع كمقلتي","في حب من نظرت له متباهيه",62,"ه",1,1],["لم ألق لي في ضميره مقةً","ولم أصادف لي عنده مقتا",63,"ت",2,0],["لَمالُ المَرءِ يُصلِحُهُ فَيُغني","مَفاقِرَهُ أَعَفُّ مِنَ القُنوعِ",64,"ع",1,0],["لَم أَلبِسِ الباطِلَِ بِالحَقِّ كَمَن","يُستاكُ بِالطيبِ وَفيهِ بَخَر",65,"ر",1,0],["لَم أُلفَ غَيرَ حَليفٍ لِلغَرامِ بِهِ","وَلَم أَبِت مِن هَواهُ غَيرَ سَكرانِ",66,"ن",1,0],["لَم أَلقَ أَطيَب مِن شَذا أَراجها","إِلّا إِذا مَدح الأَمين همامها",67,"م",3,0],["لمّا لَحِقْتُ بأُولَى العِيسِ سائرةً","عَلِقْتُ فضْلَ زِمامِ الرّاكبِ العَجِل",68,"ل",1,0],["لِمالِهِ مُشاطِرُ مُرتادُهُ","إِذا عَفا وَقَولُهُ عُد أَعُدِ",69,"د",1,0],["لَم أَلقَ دَهري بِأَحمى مِن عِنايَتِهِ","وَلا بِأَحنى عَلى المَجفُوِّ مِن أَدَبِ",70,"ب",1,0],["لم ألم هذا أولاذا كلهم في حل مني","إنني عبد فقير وصفى النقص وفني",71,"ن",2,0],["لم ألقَهُ منذ تَصَاحَبْنَا فحينَ بدَا","لِنَاظريَّ افترقْنَا فُرقَةَ الأَبدِ",72,"د",1,0],["لم ألْقَ أغْزَرَ نائلاً من كفِّهِ","وأُرَقَّ قلباً بالضعيف وأرحما",73,"م",2,0],["لم ألقَ بين الناس أكرمَ ماجد","لوفوده ولضدّه من قاهر",74,"ر",1,0],["لم ألقَ بين الناس قطّ مماثلاً","لجنابه العالي ولا بمناظر",74,"ر",1,0],["لم ألقَ إِلاّ شقوةً","من بعده وضنىً مذيبي",75,"ب",2,0],["لم ألق إِلاّ شِقوة","من بعده وضنىً وكدّا",76,"د",2,0],["لم ألق غيرك موهوبا ليرفعها","لمصر حين وفاء النيل ناجاني",77,"ن",2,0],["لم ألقَ فيها ظلالاً","أو رَحمةً من هُداةِ",78,"ه",1,0],["لم ألقِ أطماري ولي","فيها مكانُ مَرقَعِ",79,"ع",1,0],["لمالِكَ بالكسْب الحميد وبالنَّدى","مَدى الدَّهْرِ والأيَّامِ بانٍ وهادم",80,"م",1,0],["لم ألْقَ مُستكْبراً إِلاَّ تحولَّ لي","عند اللِّقاءِ لهُ الكِبْرُ الذي فيه",81,"ه",1,1],["لماله عنه أسفار بنائله","وحوله لوجوه المدح إسفار",82,"ر",1,0],["لما لمقلتهِ الحوراءِ من وسنٍ","ما بالنواظر من دمعٍ ومن سهر",83,"ر",1,0],["لم ألقَ لمّا أن وقفتُ بربعِها","جمَّ الكآبِة غيرَ أورقَ هابِ",84,"ب",1,0],["لم ألق أهلا سواه فاستهل بنا","بدر القريض وحيعلنا على الأدب",85,"ب",1,0],["لم ألْقَ قبلَ العِشْقِ ناراً أحرَقَتْ","بَشَراً وحُبُّ المُصْطفى بجَنانهِ",86,"ن",2,0],["لم ألقَ أطيبَ بهجةً من نَشرِها","إلّا البشارةَ في إيابِ الحَيدَري",87,"ر",2,0],["لما لماضي الحسن جدَّد عذاره رسم","أراد خدّهِ ب