{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[63,"يا عبرتي هذه الأطلال والدمن","https://www.aldiwan.net/poem45695.html","البسيط"],[55,"يا دار فوز لقد أورثتني دنفا","https://www.aldiwan.net/poem26242.html","البسيط"],[55,"لم ألق ذا شجن يبوح بحبه","https://www.aldiwan.net/poem26512.html","الكامل"],[93,"يا جنة أهدت إلي سلاما","https://www.aldiwan.net/poem11299.html","الكامل"],[93,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[93,"أين المجاز فيهبط الإلهام","https://www.aldiwan.net/poem11414.html","الكامل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[51,"ألا يا زينة الدنيا جميعا","https://www.aldiwan.net/poem66039.html","الوافر"],[29,"يا مي هلا يجازي بعض ودكم","https://www.aldiwan.net/poem6157.html","البسيط"],[70,"قل الثقات فلا تركن إلى أحد","https://www.aldiwan.net/poem42854.html","الطويل"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[85,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[43,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[45,"ما يستفيق دد لقلبك من دد","https://www.aldiwan.net/poem63490.html","البسيط"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"شرخ الشباب أخو الصبا وأليفه","https://www.aldiwan.net/poem65161.html","الخفيف"],[61,"لم ألق ريحانة ولا راحا","https://www.aldiwan.net/poem51740.html","المنسرح"],[44,"نسج المشيب له لفاعا مغدفا","https://www.aldiwan.net/poem29716.html","الكامل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[87,"يا راحلاً غاب صبري بعد فرقته","https://www.aldiwan.net/poem8224.html","البسيط"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[102,"لم ألق بين ليالي التي سلفت","https://www.aldiwan.net/poem33107.html","البسيط"],[40,"يا دار عاتكة التي بالأزهر","https://www.aldiwan.net/poem42273.html","الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[48,"أيا من أخلف الوعد","https://www.aldiwan.net/poem62592.html","الهزج"],[46,"أما الحقيقة فهي أني ذاهب","https://www.aldiwan.net/poem23058.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39542","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67305","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43664","الرجز"],[106,"ذكرى فنان!","https://www.poetsgate.com/ViewPoem.aspx?id=179489",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"كأس من الخروب","https://www.poetsgate.com/ViewPoem.aspx?id=179306",""],[51,"ومن العجائبِ يا أبا الفيَّاض","https://www.poetsgate.com/ViewPoem.aspx?id=29393",""],[31,"أرسلتُ لما عيلَ صبري إلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19013&r=&rc=276",""],[113,"توكل على الرحمن الامر كله","https://www.aldiwan.net/poem41223.html","عموديه"],[133,"كما عاذل في عادل القد لام","https://www.aldiwan.net/poem49130.html","السريع"],[140,"بتنا على الزوراء نهدم ما","https://www.aldiwan.net/poem58386.html","الكامل"],[148,"بأوجد مني مذ نأيت وإنما","https://www.aldiwan.net/poem68468.html","الطويل"],[158,"أبشر ببشرى بابها قد فتحا","https://www.aldiwan.net/poem58772.html","الرجز"],[162,"مناويك في بذل النوال وإنه","https://www.aldiwan.net/poem67826.html","الطويل"],[167,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[191,"وغزال منحته خالص الود","https://www.aldiwan.net/poem12980.html","الخفيف"],[197,"أنت غرست الحب في اضلعي","https://www.aldiwan.net/poem45581.html","السريع"],[208,"بناظريك بقد عامل نظر","https://www.aldiwan.net/poem13378.html","البسيط"],[208,"لما لساقو كشف من رام اعطافي","https://www.aldiwan.net/poem13436.html","المواليا"],[209,"أنت الذي علمتني","https://www.aldiwan.net/poem46342.html","مجزوء الكامل"],[239,"يا أخت غصن البانة المياس","https://www.aldiwan.net/poem45768.html","الكامل"],[248,"سر الفؤاد طيفه لما سرى","https://www.aldiwan.net/poem14960.html","الرجز"],[269,"أرياح نجد تممي الهابا","https://www.aldiwan.net/poem52113.html","الكامل"],[273,"تلك الجزيرة أقبلت تنويها","https://www.aldiwan.net/poem25414.html","الكامل"],[273,"بشراي هذا مبدأ الإقبال","https://www.aldiwan.net/poem25535.html","الكامل"],[280,"قلبي إليكم من الأشواق يضطرب","https://www.aldiwan.net/poem32870.html","البسيط"],[301,"لم ألق في كرم الطباع كمقلتي","https://www.aldiwan.net/poem58165.html","الكامل"],[301,"من لم يعاين من باطني سمة","https://www.aldiwan.net/poem58266.html","المنسرح"],[335,"أعائش ما لأهلك لا أراهم","https://www.aldiwan.net/poem45426.html","الوافر"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[347,"ما أومض البرق بين الطلع والبان","https://www.aldiwan.net/poem15981.html","البسيط"],[351,"أظباء رامة بالظبى آرامها","https://www.aldiwan.net/poem39962.html","الكامل"],[362,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[362,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[364,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[388,"سامحوني واعذروني من رأى حالي عذرني","https://www.aldiwan.net/poem54461.html","عموديه"],[406,"وصاحب لا تمل الدهر صحبته","https://www.aldiwan.net/poem32244.html","الطويل"],[413,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[413,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[450,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13633.html","مجزوء الكامل"],[450,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13751.html","مجزوء الكامل"],[451,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[451,"هاتى ثلوجك هاتي","https://www.aldiwan.net/poem61589.html","المجتث"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[459,"بقيت أبا الفضل الذي شاهد له","https://www.aldiwan.net/poem16223.html","الطويل"],[459,"لم ألق مستكبرا إلا تحول لي","https://www.aldiwan.net/poem16448.html","البسيط"],[462,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[462,"وقد أخضب الدمع فاكفف رائد النظر","https://www.aldiwan.net/poem3578.html","عموديه"],[475,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[477,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[512,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[512,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[512,"لما لماضي الحسن جدد عذاره رسم","https://www.aldiwan.net/poem20924.html","المواليا"],[538,"لم الديار بحائل والأنبط","https://www.aldiwan.net/poem56800.html","الكامل"],[542,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[560,"لم يبق شكرك في فؤادي موضعا","https://www.aldiwan.net/poem52760.html","الكامل"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"]],"verses":[["لَم آلُ جُهداً في الثَناءِ وَإِنَّما","غَطّى بِعَرضِ نَداهُ طولَ لِساني",0,"ي",1,0],["لَمّا لَحَظتَ الدَهرَ زايَلَهُ","إِظلامُهُ وَاِفتَرَّ ضَيُّقُهُ",1,"ق",2,0],["لَم أَلقَ قَبلَ ابنَةِ السَّعديِّ لي سَكَناً","يَكادُ يَلفِظُ روحي بَعدَهُ البَدَنُ",2,"ن",1,0],["لَم أَلقَ ذا صِفَةٍ لِلحُبِّ يَنعَتُهُ","إِلّا وَجَدتُ الَّذي بي فَوقَ ما وَصَفا",3,"ف",2,0],["لم أَلقَ ذا شَجَنٍ يَبوحُ بِحُبِّهِ","إِلا ظَنَنتُكِ ذَلِكَ المَحبوبا",4,"ب",2,1],["لَمْ أُلْفِ إِلاَّ عَاقِلاً مُتَأَدِّباً","فِيهِمْ وَإِلاَّ سَاعِياً مِقْدَامَا",5,"م",2,0],["لَمْ أُلْفِهِ فِي العَيْشِ إِلاَّ نَابِهاً","يَرْنُو إِلَى الدُّنْيَا بِطَرْفٍ سَامِ",6,"م",1,0],["لَمْ أُلْفِ حَيّاً والزمانُ مُذَمَّم","يَعْدُوهُ فِيهِ كَمَا عَدَاكَ الذَّامُ",7,"م",1,0],["لَمّا لَقيتَ فَوارِساً مِن عامِرٍ","سَلّوا سُيوفَهُمُ مِنَ الأَجفانِ",8,"ن",1,0],["لَمّا لَحِقنا بِظُعنِ الحَيِّ نَحسِبُها","نَخلاً تَراءَت لَنا البيضُ الرَعابيبُ",9,"ب",1,0],["لم ألْقَ في غمراتِ قومٍ مَشْرَباً","ووجدتُ في ضَحْضَاحِهِ لِي مَسْبَحَا",10,"ح",2,0],["لم ألقَ كالشعراءِ أكثر حارِضاً","وأشدَّ معْتبةً على الحُرَّاض",11,"ض",1,0],["لما لؤم المُبَشِّر يومَ نادى","أقرَّ اللَّهُ عيْنَك بالغُلامِ",12,"م",1,0],["لَمّا لَحِقنَ بِهِ أَنحى بِمِغوَلِهِ","يَملَأ فَرائِصَها مِن طَعنِهِ العَلَقُ",13,"ق",1,0],["لَم أَلقَ لي صاحِباً في اللَهِ أَصحَبُهُ","وَقَد رَأَيتُ وَقَد جَرَّبتُ أَجناسا",14,"س",2,0],["لَم أَلتَمِس عَرضَ الحَياةِ وَإِنَّما","أَقرَضتُهُ في اللَهِ وَالمُختارِ",15,"ر",1,0],["لَمّا لَمَحتُكُما سَكَبتُ مَدامِعي","فَرَحاً وَطالَ تَشَوُّفٌ وَقِيامُ",16,"م",1,0],["لُمِ اللَيالي الَّتي أَخنَت عَلى جِدَتي","بِرِقَّةِ الحالِ وَاِعذُرني وَلا تَلُمِ",17,"م",1,0],["لَم أَلقَ شَفعاً كَالسُلُّوِ وَكَالهَوى","أَنَأى وَأَبعَدَ مَصدَراً مِن مَورِدِ",18,"د",1,0],["لَم أَلقِ مَقدوراً عَلى اِستِحقاقِهِ","في الحَظِّ إِمّا ناقِصاً أَو زائِدا",19,"د",2,0],["لَم أَلقَهُ حَتّى لَقيتُ عَطاءَهُ","جَزلاً وَعَرَّفَني الغِنى مَعروفُهُ",20,"ف",2,0],["لَمّا لَقيتُ بِكَ الزَمانَ تَصَدَّعَت","عَن ساحَتي أَحداثُهُ وَصُروفُهُ",20,"ف",2,0],["لم أَلْقَ رَيحانةً ولا رَاحا","إلا ثَنَتْني إليكَ مُرتاحا",21,"ح",2,1],["لَم آلُ فيكَ تَعَسُّفاً وَتَعَجرُفاً","وَتَأَلُّقاً وَتَلَطُّفاً وَتَظَرُّفا",22,"ف",2,0],["لَمّا لَقوكَ تَواكَلوكَ وَأَعذَروا","هَرَباً فَلَم يَنفَعهُمُ الإِعذارُ",23,"ر",1,0],["لَم أَلتَزِم نَظمَ حَبّاتِ البَديعِ بِها","إِذ كانَ صَوغُ المَعانِي الغُرِّ مُلتَزمِي",24,"م",2,0],["لَمْ أَلْقَ بَعْدَكَ يَوْماً أَسْتَبِينُ بِهِ","وَجْهَ الْمَسَرَّةِ إِلَّا ظَلَّ يُبْكِينِي",25,"ن",2,0],["لم أُلفِ أحفلَ منها وهي مُوحشةٌ","بالمؤنسات ولا أزهى ميادينا",26,"ن",2,0],["لم ألْقَ بيْن لياليَّ التي سَلَفَتْ","كلَيْلةٍ بِتُّها في دْير قدِّيسِ",27,"س",1,1],["لَم أَلقَ أَهلَكِ بَعدَ عامَ لَقِيتُهُم","يا لَيتَ أَنَّ لِقاءَهُم لَم يَقدُرِ",28,"ر",1,0],["لم ألقَ في الناسِ مُجهولَ البصيرَةِ أو","مُسَوِّفاً نفسَه قولاً بلا عمَل",29,"ل",1,0],["لم ألقَ شيئاً بعدَكم حسَناً ولا","مَلِكاً سوى هذا الأغرّ لُبابا",30,"ب",2,0],["لَما لاقى جَميلٌ عُش","رَ ما لاقَيتُ مِن وَجدي",31,"ي",1,0],["لَم أُلفَ كَالثَقَفيِّ بَل عِرسي هِيَ السَ","وداءُ ما جَهَّزتُها بِطَلاقِ",32,"ق",1,0],["لم ألقَ بعدكَ ما يشوقُ نواظري","عند الرياضِ فليسَ ما يصبيني",33,"ي",1,0],["لَمْ أَلْقَ مِنْ بَعْدِكُمْ يَوْماً أُسَرُّ بِهِ","كَأَنَّ كُلَّ سُرُورٍ بَعْدَكُمْ حَزَنُ",34,"ن",1,0],["لمَّ إلالهُ به شعثاً ورَمَّ به","أمورَ أُمَّتِهِ والأمرُ مُنْتشِرُ",35,"ر",1,1],["لَم أَلهُ بِالحَسناءِ مُذ","أَودى وَلَم تَلتَهِ بي",36,"ي",1,0],["لم ألقَ في مصر فنَّانًا يزاوله","إلا تلقَّى على «حسني» مباديه",37,"ي",2,0],["لم ألقَ مثلكما: فنًّا وصاحبَهُ","يفني شبابك فنَّاء وتحييه",37,"ي",2,0],["لم أَلْقَ حيًّا مثلَهُ","أحياؤُه لا يُرْزَقون",38,"ن",1,0],["لم ألق في غير الكويت «خواجة»","يَدَعُ الخمورَ، ويشربُ الخرّوبا",39,"ب",2,0],["لم ألقَ كالشعراءِ أكثر حارِضاً","وأشدَّ معْتية ً على الحُرَّاض",40,"ض",1,0],["لَمّا کلْتَقَيْنَا رَحَّبَتْ تِرْبُها","هِنْدٌ وَقَالَتْ: قُلَّباً حُوَّلا",41,"ل",2,0],["لمال اليها الجذع حتى بحجرها","جنته ولكن كل شيء له سبب",42,"ب",1,0],["لم ألقَ فيما عشتهُ عالماً","يقال فيه حاز كل الوسام",43,"م",1,0],["لما لقينا من تُجاهِك عصبةً","نضحَتْ بشكواها ذَفَارَى العِيرِ",44,"ر",1,0],["لما لبست إلاَّ بحسنك حسنها","ولا بد للحسناء من نفحة العطر",45,"ر",1,0],["لم ألق في الجند منهم مشربا","ومنه في الشط لقيت مسبحا",46,"ح",2,0],["لُمِ الغَيثَ وَاِعذِر مَن لِقاؤُكَ عِندَهُ","يُعادِلُ نَيلَ الخُلدِ بَل هُوَ أَكبَرُ",47,"ر",1,0],["لِمالٍ أَو لِعِزٍّ أَو لِعلمٍ","تُعاني وَيبَ غَيرِكَ ما تُعاني",48,"ن",2,0],["لَم أَلُمهُ أَنِ اِتَقّى بِحجابٍ","رَدّني واله الفُؤادِ لِما بي",49,"ي",1,0],["لم ألقَ ممن نظروا وجههُ","الا فتىً يعشقُ أويدعي",50,"ي",1,0],["لم الق قبل محياه وطرته","صبحا اضا في دجا ليل من الشعر",51,"ر",1,0],["لما لساقو كشف من رام اعطافي","عزيز طاهر حسن اشرف على التلاقي",52,"ي",1,1],["لم ألق بعدك منهمو","إلا الجفاء أو العقوق",53,"ق",1,0],["لم آل جهداً في اختلاسِ فؤادِها","حتى أطاعت بعدَ طولِ مِرَاسِ",54,"س",1,0],["لم أَلقَ في ذا الدهر من أَشكُو له","رَيب الزمان إذ تَعَدَّى واجتَرا",55,"ر",2,0],["لَم ألف غيرك من أَلوذُ به اذا","مكر الزَمان وَقطع الاسبابا",56,"ب",2,0],["لَمْ آلُ مَدْحاً له وَخِلالِهِ","لَكِنْ عَجَزْتُ رَوِيةً وَبَدِيها",57,"ي",3,0],["لَمَّا لَثَمْتُ يَمِينَه ورَأيْتُه","لَمْ أَلْتَفِتْ لحَياً ولا لِهِلالِ",58,"ل",1,0],["لَم أَلقَ مِن أَحَدٍ إِلّا وَأَنشَدَني","ما بالُ عَينِكَ مِنها الماءُ يَنسَكِبُ",59,"ب",1,0],["لم ألق في كرم الطباع كمقلتي","في حب من نظرت له متباهيه",60,"ه",1,1],["لم ألق لي في ضميره مقةً","ولم أصادف لي عنده مقتا",61,"ت",2,0],["لَمالُ المَرءِ يُصلِحُهُ فَيُغني","مَفاقِرَهُ أَعَفُّ مِنَ القُنوعِ",62,"ع",1,0],["لَم أَلبِسِ الباطِلَِ بِالحَقِّ كَمَن","يُستاكُ بِالطيبِ وَفيهِ بَخَر",63,"ر",1,0],["لَم أُلفَ غَيرَ حَليفٍ لِلغَرامِ بِهِ","وَلَم أَبِت مِن هَواهُ غَيرَ سَكرانِ",64,"ن",1,0],["لَم أَلقَ أَطيَب مِن شَذا أَراجها","إِلّا إِذا مَدح الأَمين همامها",65,"م",3,0],["لمّا لَحِقْتُ بأُولَى العِيسِ سائرةً","عَلِقْتُ فضْلَ زِمامِ الرّاكبِ العَجِل",66,"ل",1,0],["لِمالِهِ مُشاطِرُ مُرتادُهُ","إِذا عَفا وَقَولُهُ عُد أَعُدِ",67,"د",1,0],["لَم أَلقَ دَهري بِأَحمى مِن عِنايَتِهِ","وَلا بِأَحنى عَلى المَجفُوِّ مِن أَدَبِ",68,"ب",1,0],["لم ألم هذا أولاذا كلهم في حل مني","إنني عبد فقير وصفى النقص وفني",69,"ن",2,0],["لم ألقَهُ منذ تَصَاحَبْنَا فحينَ بدَا","لِنَاظريَّ افترقْنَا فُرقَةَ الأَبدِ",70,"د",1,0],["لم ألْقَ أغْزَرَ نائلاً من كفِّهِ","وأُرَقَّ قلباً بالضعيف وأرحما",71,"م",2,0],["لم ألقَ بين الناس أكرمَ ماجد","لوفوده ولضدّه من قاهر",72,"ر",1,0],["لم ألقَ بين الناس قطّ مماثلاً","لجنابه العالي ولا بمناظر",72,"ر",1,0],["لم ألقَ إِلاّ شقوةً","من بعده وضنىً مذيبي",73,"ي",1,0],["لم ألق إِلاّ شِقوة","من بعده وضنىً وكدّا",74,"د",2,0],["لم ألق غيرك موهوبا ليرفعها","لمصر حين وفاء النيل ناجاني",75,"ي",1,0],["لم ألقَ فيها ظلالاً","أو رَحمةً من هُداةِ",76,"ه",1,0],["لم ألقِ أطماري ولي","فيها مكانُ مَرقَعِ",77,"ع",1,0],["لمالِكَ بالكسْب الحميد وبالنَّدى","مَدى الدَّهْرِ والأيَّامِ بانٍ وهادم",78,"م",1,0],["لم ألْقَ مُستكْبراً إِلاَّ تحولَّ لي","عند اللِّقاءِ لهُ الكِبْرُ الذي فيه",79,"ه",1,1],["لماله عنه أسفار بنائله","وحوله لوجوه المدح إسفار",80,"ر",1,0],["لما لمقلتهِ الحوراءِ من وسنٍ","ما بالنواظر من دمعٍ ومن سهر",81,"ر",1,0],["لم ألقَ لمّا أن وقفتُ بربعِها","جمَّ الكآبِة غيرَ أورقَ هابِ",82,"ب",1,0],["لم ألق أهلا سواه فاستهل بنا","بدر القريض وحيعلنا على الأدب",83,"ب",1,0],["لم ألْقَ قبلَ العِشْقِ ناراً أحرَقَتْ","بَشَراً وحُبُّ المُصْطفى بجَنانهِ",84,"ن",2,0],["لم ألقَ أطيبَ بهجةً من نَشرِها","إلّا البشارةَ في إيابِ الحَيدَري",85,"ر",2,0],["لما لماضي الحسن جدَّد عذاره رسم","أراد خدّهِ بديوان الملاحة رسم",86,"م",1,1],["لِمَ الدِيارُ بحائِلٍ وَالأنبَطِ","آياتُها كَوثائِقِ المُستَشرِطِ",87,"ط",1,1],["لم ألقَ وجهَكَ في مرآةِ لحظتِهِ..","رَأًيْتُهُ في مرايا أَمْسِهِ سُجِنَا!",88,"ن",2,0],["لم ألقْ فيهِ حَبَّةً مِن جِرْمِهِ","إلاّ وجدتُ مِن المحبَّةِ أربَعا",89,"ع",2,0],["لم ألقَ كُفْواً لها مِمَّنْ رَفَعتُ يدي","قبلاً إليه فلم أهتمَّ تنزيها",90,"ي",3,0]]}