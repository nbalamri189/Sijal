{"poems":[[53,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[77,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[193,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[193,"يا حبيب الإله يا سيد الرس","https://www.aldiwan.net/poem35140.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[438,"خبراني بهول يوم الفراق","https://www.aldiwan.net/poem12469.html","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96617","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136195","الخفيف"],[1510,"","https://poetry.dctabudhabi.ae/diwan/poem/147560","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53238","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130821",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204450","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133943","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132642","المنسرح"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83520","الخفيف"],[4691,"كلّما أبصر الجميلة سبّحتُ","https://www.poetsgate.com/ViewPoem.aspx?id=215988",""],[5136,"زارني طيفه فأهلا وسهلا","https://www.poetsgate.com/ViewPoem.aspx?id=121785",""],[5219,"وذات خال ...","https://www.poetsgate.com/ViewPoem.aspx?id=198233",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6198,"المهاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79235&r=&rc=9",""]],"verses":[["أنت أصلُ الأصول في الفضل والخي","رِ إذا حُصِّلا وفرعُ الفروع",0,"ع",1,0],["أنْتَ أصْفَيْتَهُنَّ حُبَّ سُليما","نَ قديماً للصّافناتِ العِتاقِ",1,"ق",1,0],["أَنت أصلُ الوجودِ ما لكَ مثل","ما لِخلقٍ من دونِ فضلكَ فضلُ",2,"ل",1,0],["أنتَ أَصلٌ والعالمون فروعُ","نوركَ البدرُ والجميعُ زروع",2,"ع",1,0],["أنتَ أَصلٌ لكلِّ خيرٍ منَ اللَ","هِ يصل العالمين سرّاً وجهرا",3,"ر",2,0],["أَنتَ أصلُ الجنانِ يا سابق الكل","لِ إليها يهنيك منك الهناءُ",4,"ا",2,0],["أنت أصبحتَ عاشقاً للمعالي","وأراها قليلة العُشاقِ",5,"ق",1,0],["أَنت اِصطفتك اِختباراً وحلّت","جَميع الورى جفوة واِجتنابا",6,"ب",2,0],["أنت اصل وروح علمك فصل","والجليل العظيم منك حقير",7,"ر",1,0],["أنت أصل الفساد والذنب للخي","ياط عند التفصيل لا للمقص",8,"ص",1,1],["أنت أصفيت عيشتي بعد أن كان","ت إلى الحياة غير شهيّه",9,"ي",2,0],["أنت اصل ومنشأ للبلايا","كم بعمرٍ بدأت حتى تصرم",10,"م",1,0],["أنت أصلي وما الحياة سوى فر","ع ولكن فرعٌ بلا أثمار",11,"ر",1,0],["أنت أصل الجود في كل البرايا","فكرام الخلق قطر من نداكا",12,"ك",2,0],["أنت أصح الرجال معرفة","أعيذها أن تقارب المرضا",13,"ض",2,0],["أَنتَ أَصلٌ لكلّ أَصلٍ شَريفٍ","مُذ أَطلَّ الوُجودُ من شُرُفاتِه",14,"ت",2,0],["أنتِ أصلُ السنا وكلّ ظلامٍ","لو تمادى إلى سناكِ المفرُّ",15,"ر",1,0],["أنت اصليت مهجتي لهب الشوق","ومن فارق الحبيب سيصلى",16,"ل",2,0],["أنت اصطبارٌ لروحٍ ليس يُبرِئها","إلا وصال التي .. تختال في غنجِ",17,"ج",1,0],["أنت أصلُ الورد والشَّهدِ جميعاً","وَمَعاني الخِصْبِ والطَلْع النَّضِيدِ",18,"د",1,0],["أنت أصفى من نطفة المزن نفسا","أتراه من ماء طبعك سائل؟",19,"ل",1,0],["أنتَ أصبحتَ بعدما كنتَ سلوي","أدمعاً في العيون... أو تسهيدا",20,"د",2,0]]}