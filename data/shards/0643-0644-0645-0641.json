{"poems":[[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[53,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108972","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93574","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""]],"verses":[["كلِّم فتى طَيِّئٍ فينا وسيّدَها","تكليمَ راضٍ مُليحٍ صفحةَ الغضبِ",0,"ب",1,0],["كلِّم فتى طيْءٍ فينا وسيدَها","تكليمَ راضٍ مُليحٍ صفحة َ الغضبِ",1,"ب",1,0],["كل مفضول غليظ لامني","فيه نطعٌ صلفٌ قط عميّ",2,"ي",1,0],["كل مفهومها إذا قام قوم","لم يحز ارثها سوى ابناها",3,"ا",3,0],["كُل مَفتول ذِراع قَدّه","يحوج السَيف إِلى طُول نجاد",4,"د",1,0],["كَلْمٌ فِراقُهُم ولومُكَ لي","في حُبِّهم كَلْمٌ على كَلْمِ",5,"م",1,0],["كل مفهوم لديها في العُلا","مقلقٌ متّجهٌ للمنحنى",6,"ن",2,0]]}