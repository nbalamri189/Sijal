{"poems":[[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[256,"ثار القريض","https://www.aldiwan.net/poem39737.html","عموديه"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[354,"قالوا الجماعة قلت آل محمد","https://www.aldiwan.net/poem15842.html","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72326","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108848","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108502","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122231","الكامل"],[4119,"هي جنة المأوى فهل من خاطب","https://www.poetsgate.com/ViewPoem.aspx?id=16089",""]],"verses":[["أفغَيرَ ما عاينتُ أبْغي آيَةً","من بَعِدهَا إني إذاً لَمُضَلَّل",0,"ل",1,0],["أفغيرُ عَصركَ يُرتَجَى أم غيرُ نَيْ","لِكَ يُجْتَدى أم غيرُ كفِّك يُسأل",0,"ل",1,0],["(أفغان)تبكي دماء من مدامعها","وجرحها لم يجد حرا يواسيه",1,"ي",2,0],["أَفَغَرَّكُمْ أَنَّ الزَّمانَ أَجَرَّكُمْ","طِوَلاً بِغَيِّكُمُ الْوَخِيمِ الْمَرْتَعِ",2,"ع",1,0],["أَفَغَيرِهِم أَبغي السَبيلَ إِلى الهُدى","وَهُمُ الَّذينَ بِهِم أَبانَ سَبيلَهُ",3,"ل",2,0],["أفغيره منهم يقول كقوله","إن كان يسمع من له أذنان",4,"ن",1,0],["أفغيره ساد الورى بصنائعٍ","لو أنها صيغت لصارت أنجما",5,"م",2,0],["أفغير هذا الصد عندك حيلةٌ","تستأصل السراء بالضراء",6,"ا",2,0],["افغير طه شافع","في هول يوم الموعد",7,"د",1,0],["أفغركم والثأر رهن دمائكم","ما كان من إطراق لحظ الطالب",8,"ب",1,0]]}