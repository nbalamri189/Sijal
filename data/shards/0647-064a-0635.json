{"poems":[[55,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[87,"هي صفعة لهج الأنام بذكرها","https://www.aldiwan.net/poem7547.html","الكامل"],[87,"هي صفعة سر الصحافة وقعها","https://www.aldiwan.net/poem7548.html","الكامل"],[99,"هي صفحة طويت وحان ختام","https://www.aldiwan.net/poem24984.html","الكامل"],[107,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[107,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[92,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[147,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[303,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[382,"قم بنا يا أخا المودة صبحا","https://www.aldiwan.net/poem66889.html","الخفيف"],[422,"ناشداها عن فؤادي وسلاها","https://www.aldiwan.net/poem53959.html","الطويل"],[438,"هجر الحب وإن أصبح جارا","https://www.aldiwan.net/poem12474.html","الرمل"],[469,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[549,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[563,"غنى لنا داعي السرور وغردا","https://www.aldiwan.net/poem34573.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122665","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95500","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77407","الرمل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104980","الكامل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127393","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110003","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66550","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86502","الكامل"],[4717,"أخت القمر","https://www.poetsgate.com/ViewPoem.aspx?id=199655",""],[4755,"الشاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=183567",""],[4862,"زاد الحنين فهيج الأشجانا","https://www.poetsgate.com/ViewPoem.aspx?id=55513",""],[4869,"حب الشرف","https://www.poetsgate.com/ViewPoem.aspx?id=151682",""],[4898,"يوم عاصف .","https://www.poetsgate.com/ViewPoem.aspx?id=35812",""],[4984,"عِيدُ مِيلَاد","https://www.poetsgate.com/ViewPoem.aspx?id=200981",""],[5038,"بنت الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=189983",""],[5046,"صفقة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=200611",""],[5121,"حَيَّرَتْنِي","https://www.poetsgate.com/ViewPoem.aspx?id=214885",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[5365,"ياشام","https://www.poetsgate.com/ViewPoem.aspx?id=190818",""],[5431,"الحبيبة -الام-البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=199601",""],[5596,"فقيد البِرِّ والسخاء","https://www.poetsgate.com/ViewPoem.aspx?id=206382",""],[5626,"عرس نينوى","https://www.poetsgate.com/ViewPoem.aspx?id=189509",""],[5720,"أُمِّيْ","https://www.poetsgate.com/ViewPoem.aspx?id=199988",""],[5848,"يافؤادي لا تسلني","https://www.poetsgate.com/ViewPoem.aspx?id=51956",""],[5861,"لكم الحسنى آل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=191772",""],[5952,"مرّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=213001",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6204,"إلى صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69140&r=&rc=12",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["هِيَ صَفوَةُ اللَهِ الَّتي أَوحى لَها","وَقَضى أَوامِرَهُ إِلى أَمجادِها",0,"د",3,0],["هي صفعة لهج الأنام بذكرها","ودرى البعيد بها ومن لم يعلم",1,"م",1,1],["هي صفعة سر الصحافة وقعها","ورجا بيان مثلها وبديع",2,"ع",1,1],["هي صفحة طويت وحان ختام","آسي الأساة على ثراك سلامُ",3,"م",1,1],["هِيَ صِبغَةُ الباري وَلَستَ تَرى لِما","صَبَغَ الَّذي بَرَأَ النُفوسَ نُصولا",4,"ل",2,0],["هِيَ صَرعَةٌ مِن رازِحينَ تَقاسَموا","أَلّا يُفيقوا أَو يُجيبوا الداعِيا",5,"ي",2,0],["هي صورةٌ لكَ والمساءُ مقاربٌ","والرُّوحُ ركبٌ والمنيةُ حادي",6,"د",2,0],["هي صيحةُ الوطن الجريح وأمةٍ","هانت على سيفِ المغير الطامحِ",7,"ح",1,0],["هِيَ صيحةٌ لم يَرْمِها مِنْ قَبلهِ","بَطلٌ بوجه السادةِ الأحلافِ",8,"ف",1,0],["هي صُورة حمراءُ من شَجني","تُدمي اليَراع وتُرعب الوَرَقا",9,"ق",2,0],["هي صورة لله عزّ وجلّ جلاله","عزّت نظائرها على الألواح",10,"ح",1,0],["هِيَ صَبوَةٌ كَثُرَ العِتابُ لِأَجلِها","أَوفى الهَوى ما كَثَّرَ اللُوّاما",11,"م",2,0],["هي صفوةٌ ظهراءُ من بشريّةٍ","تصفو بها وصفاؤها لا يكدر",12,"ر",1,0],["هي صفوةُ اللهِ البديع بأرضه","فإِذا صبوتُ لها فكيف أُلام",13,"م",1,0],["هي صلح السماء والأرض حقّاً","ما وجدنا من قبل مريم صلحا",14,"ح",2,0],["هي صَدَّتْ ريبة عن صبِّها","فشكَتْه يوم صدَّتْ وشكاها",15,"ا",3,0],["هي صدرٌ هو صدرٌ حبّذا","بحرُ علمٍ فرعَتْ منه بحارا",16,"ر",2,0],["هي صفقةٌ وقع التفرُّق بعدها","ويسفُّ بالعلياءِ أن تتخيرا",17,"ر",2,0],["هي صرخةُ النور استفاق سعيرها","في جانحيك فثارت الألحان",18,"ن",1,0],["هي صبغة الله التي جاءت لنا","في الذكر نعرفها على رغم العدا",19,"د",2,0],["هيَ صَيحَةٌ عَميَ النَّدَى عَيناً بِها","في الخافِقَينِ وصُمَّ مِنها مَسمَعا",20,"ع",2,0],["هى صفوةُ الأعمارُ للش","شَعبِ الكريم المهتدى",21,"د",2,0],["هِيَ صُبحٌ ثُمَّ ظُهرٌ ثُمَّ عَصرٌ","ثُمَّ شَفَع قَبلَها المَغرِبُ وترُ",22,"ر",1,0],["هي صرح بلقيس وزجرك مذ غدا","علم الكتاب علمت أنك آصف",23,"ف",1,0],["هي صخرة وللصخور كلام","من قبيل الإلهام والإيحاء",24,"ا",2,0],["هي صرح حين تبدو وإذا","ما جرت يحسبها ليثاً مهابا",25,"ب",2,0],["هيَ صبغةُ الإِبنِ الوحيدِ بروحهِ ال","قُدُسيّ والنارِ التي لا تنطفي",26,"ف",2,0],["هيَ صُفوةُ الكونَينِ إذ","سبقت بآزال اصطِفائِك",27,"ك",1,0],["هِيَ صَفْوَةُ الكَرْمِ الْكَريمِ فَما سَرَتْ","سَرَّاؤُها فِي باخِلٍ إِلاَّ سَمَحْ",28,"ح",1,0],["هَيَ صَولَةُ الأَيّامِ لا تَقوى لَها","بِتَجَلُّدٍ مِنّا وَلا بِجَلادِ",29,"د",1,0],["هِىَ صُورَةٌَ قَدْ غَلَّفَتْ بَدْرَ الدُّجَى","فَكَأَنَّهَا نَبْضُ الْقَصَائِدِ وَالصُّوَرْ",30,"ر",1,0],["هِيَ صُدفةٌ, ومِن المَوَاجعِ ما","يَدَعُ الخَلِيَّ لِطَيفِها هَدَفا",31,"ف",2,0],["هي صحوة أضفت علي ظلالها","والصدق أنطق أخرساً صوانا",32,"ن",2,0],["هي صوت ابو نوره وريشة عبادي","يطرب له الخافق ومنها تفيا",33,"ي",2,0],["هِيَ صَرْحُ (بَلقِيْسَ) المُمَرَّ","دُ في مَمَالِكِ مَنْ مَرَدْ*",34,"د",1,0],["هي صفحة البحر استوت لا تحتوي","ها غير همسة أنجم تتبلور",35,"ر",1,0],["هِيَ صَيْحَةٌ هَزَّتْ عُروشَ نَعاثِلٍ","مَنْ مِثْلُها يَرْقى إِلى الْعَلْياءِ",36,"ا",2,0],["هي صفقةُ الشيطان خاب مريدُها","ستظل حبرًا في الجرائد سائرا",37,"ر",2,0],["هِيَ صَيْفٌ أَمْ شُعْلَةٌ فِي فُؤَادٍ","وَالْحَنَايَا لَمْ تَرْتَوِي مِنْ نَدَاهَا",38,"ا",3,0],["هِىَ صَحوَةُ العَزمِ الدفِينِ إذا ارتَقَتْ","فَوقَ الهَوَى أن يَستَبِدَّ ويَفجُرا",39,"ر",2,0],["هي َ صهلَةُ الخيلِ المُحَمحِمِ في دمي","تلقَى الحمامَ على فمي وهَديلَهْ",40,"ل",2,0],["هي صدرٌ وثغره في اشتهاء","من عقودٍ مريرة في الجفاف",41,"ف",1,0],["هي صدمةٌ تُصمي وكم","ذهِلت لوقعتها العقول",42,"ل",1,0],["هيَ صَرخَةٌ يمشي الرِّجالُ وَراءَها","بلْ هَزّةٌ ثَورِيَّةٌ طوفانُ",43,"ن",1,0],["هيَ صُبحُ عُمْرٍ باسمٍ متنعِّمٍ","فإذا انقضَىٰ عَنِِّي .. فذلك غَمِّيْ!",44,"م",2,0],["هي صحيح تغيب لكن ( ههنا ) محفورة","والغياب إن قالها ربي يفض السيرة",45,"ر",2,0],["هي صيحةُ الحقِ المبينِ وقالَها","بصبيحةِ الطفِ الشؤومِ يناشدُ",46,"د",1,0],["هي صورة للحسن ما أبصرتها","إلا وددتُ بأن أكون إطارا",47,"ر",2,0],["هي صورة دمَوية لقليلِ ما","يجري بأوطاني دماً وعذابا",48,"ب",2,0],["هِيَ صَرْخَةُ الْأَشْوَاقِ تَنْطِقُ فِي دَمِي","إِنَّي بِرَغْمِ الْبُعْدِ لَنْ أَنْسَاكِ",49,"ك",1,0],["هي صحوة الآتي يحن لغابر","من فيضه تشفى النفوس الحائره",50,"ر",2,0],["هي صحوة البذل الجزيل وعزَّة","للمجد ملهمة الشباب القادره",50,"ر",2,0],["هي صحوة العلم الرفيع ... بنوره","تزهو العقول النيرات الزاهره",50,"ر",2,0],["هي صبوةٌ .. والرِّيحُ ظمأى .. والمَدى","غاوٍ .. وغلواءُ الحروبِ هَجُولُ!!",51,"ل",1,0],["هي صيحة لك في حنين حطمت","جيش الضلال وخلدت دعواكا",52,"ك",2,0]]}