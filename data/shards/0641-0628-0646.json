gate.com/ViewPoem.aspx?id=207745",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5111,"شَاعرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212326",""],[5121,"قَلَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33498",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5147,"يا حياة الأفراد مهما تعاليت","https://www.poetsgate.com/ViewPoem.aspx?id=166729",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5436,"للكرامات دربنا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177708",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[5561,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=193375",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5660,"وَ الوَجدُ يَربَحُ وَ النَّوى تَقتاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=35775",""],[5725,"للكرامات دربنا","https://www.poetsgate.com/ViewPoem.aspx?id=177692",""],[5803,"لو لا العراق لما ترنم خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=101216",""],[5906,"في الحكمة / البخل ..... البخل طبع","https://www.poetsgate.com/ViewPoem.aspx?id=193746",""],[5910,"حيِّ قبرًا بجانبِ الآكامِ","https://www.poetsgate.com/ViewPoem.aspx?id=207124",""],[6070,"خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=188063",""],[6097,"التّيه","https://www.poetsgate.com/ViewPoem.aspx?id=197427",""],[6127,"خوفُ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=198260",""],[520,"ردا احاديث المنى وأعيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577496",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[2220,"فبيني إنْ نظرتُ وبين ربي تعالى جدُّ ربي عن وجودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11319&r=&rc=193",""],[3874,"إنّي إذا انْتَتَرَت أصِرّة ُ أُمّكُمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14447&r=&rc=1",""],[556,"سلامٌ وهل يغني السّلام على الذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24267&r=&rc=6",""]],"verses":[["فبَنانُ بَني مزْنَى مُزَنٌ","تنْهَلُّ بلُطْفِ مُصرِّفِها",0,"ف",3,0],["فبِنبْلِ هَذَا الرَّأْيِ وَهْوَ مُوَفَّق","وَبِفَضْلِ ذَاكَ العَزْمِ وَهْوَ جُسَامُ",1,"م",1,0],["فبنو العروبة أصبحوا في حالة","منها العروبة لا أبا لك تأنف",2,"ف",1,0],["فَبَنى لَنا بَيتاً رَفيعاً سَمكُهُ","فَسَما إِلَيهِ كَهلُها وَغُلامُها",3,"م",3,0],["فَبَنو كِلابٍ وَهيَ قُلٌّ أُغضِبَت","فَدَهَت قَبائِلُ مُسهِرِ بنِ قَنانِ",4,"ن",1,0],["فَبَنو زِيادٍ لَم تَلِدكَ فُحولُهُم","وَبَنو صَلاءَةَ فَحلُهُم مَشغولُ",5,"ل",1,0],["فَبَناتي بَعدَ أَن كُن","نَ بَناتي أَخَواتي",6,"ت",2,0],["فَبَنو النورِ يَعبَدونَ النورا","وَبَنو الطينِ يَعبُدونَ الطينا",7,"ن",2,0],["فبنورِ تلك أضاءتِ الدنيا إِذا","ضاءتْ به الدنيا وعزَّ الدينُ",8,"ن",1,0],["فَبَنو حَنيفَةَ يَمنَعونَ نِسائَهُم","بِسُيوفِ مُهتَضِمِ العُداةِ كِرامِ",9,"م",1,0],["فبنو الحارثِ فيهم وَزَرٌ","حينَ لا يُنجي من الدَّهرِ وَزَر",10,"ر",1,0],["فَبِنورِ وَجهِكَ يا إِلَهَ مُحَمَّدٍ","زَحزِح إِلَيكَ عَنِ السَعيرِ مَكاني",11,"ن",2,0],["فَبِنارِ الأسى يُحَرَّقُ قَلْبٌ","وبماءِ الهوى يُغرَّقُ مدمَع",12,"ع",1,0],["فَبَنَاهُ مِنَ الصُّخُورِ اللَّوَاتِي","جَلَبَتْهَا الْقُيُونُ مِنْ أُسْوَانِ",13,"ن",1,0],["فبناتُ نعشٍ أنجمٌ وكمالُها","بالنعشِ فاطلبْ مثلَهُ لجواري",14,"ر",2,0],["فَبَنو عَمِّهمِ إِذا حَضَرَ","البَأسُ عَلَيهِم أَكبادُهُم وَجِعَه",15,"ع",2,0],["فَبَنى عَلَيها النِيُّ فَهيَ جُلالَةٌ","ما إِن يُحيطُ بِجَوزِها التَصديرُ",16,"ر",1,0],["فَبِنا الأمواجُ والصخرُ وما","بَرِحَ العاصفُ في أعماقنا",17,"ن",2,0],["فَبَنو أُمَيَّةٍ الفَرَزدَقُ صِنوُهُم","نَسَباً وَكانَ وِدادُهُم في الأَخطَلِ",18,"ل",1,0],["فبنو الأَيَّامِ في الدُّنيا","كما شاءَ الإِلهْ",19,"ا",3,0],["فَبِنُورِهِ فِي كُلِّ جُنْحٍ نَهْتَدِي","وبِهَدْيِهِ فِي كُلِّ خَطْبٍ نَقْتَدِي",20,"د",2,0],["فَبِنَظْرَةٍ في الأمْرِ وَهْوَ مْعَقدٌ","تجْلُوهُ لاَ لُبْسا وَلاَ تَأوِيلاَ",21,"ل",2,0],["فَبَنَاتُ البِحَارِ يَبْلَيْنَ يَوماً","وَبَنَاتِ الأَفْكَارِ غَيْرَ يُوَالِي",22,"ل",2,0],["فَبِنْتَ وَلَمَّا يُرْهِقِ النَّاس دَهْرُهُمْ","بِنَكْبَاءَ لاَ يُحْصِي أَذَاهَا التَّصَوُّرُ",23,"ر",1,0],["فبنى أمّة وشدتم عروشا","خائنات تبارك القتالا",24,"ل",2,0],["فبناتي بَعْدَ أنْ ك","ن بناتي أخواتي",25,"ت",2,0],["فَبَنُو حَنِيفَةَ يَمْتعُونَ نِسَاءَهُمْ","بِسُيُوفِ مُهْتَضِمِ العُداةِ كِرَامِ",26,"م",1,0],["فبنورهِ فى كلِّ جنحٍ نهتدى","وبِهَدْيِهِ في كُلِّ خَطْبٍ نَفْتَدِي",27,"د",2,0],["فبنفحه أن تنظروه بعطفكم","يحيى ويسرى ذاك منه لآله",28,"ل",2,0],["فبنك منصور أبى أن ينصرا","وما اختشى بحرمتي أن يكفرا",29,"ر",2,0],["فَبَنى لَنا ضلاً وَظَلَّ لَنا رَنا","لَهَبٌ أُعينَ بِحاطِبٍ مُستَعجِلِ",30,"ل",1,0],["فبنوها الغذا وتلكَ عروقُ ال","جسمِ تجري بهِ إلى الأوصالِ",31,"ل",1,0],["فَبنان الرقاد تسكبُ سِحراً","وَتُذيبُ الأَحلامَ في أَجفانِه",32,"ن",2,0],["فبنور وجهك ينجلي عني صدا","قلبي ويحيا باللقاء رميمه",33,"م",2,0],["فَبَنَى عَزَائِمَهُ على تَقْويضِها","وَثَنَى رَكَائِبَهُ عن الإرقَالِ",34,"ل",1,0],["فَبَنَت عَلَيهِ مَعَ الظَلامِ خِباءَها","كَالأَحمَسِيَّةِ في النَصيفِ الحاسِرِ",35,"ر",1,0],["فَبَنو الآمالِ مِن بَعدِكَ لا","تَشتَكي إِبلُهُمُ مَرَّ الكَلالِ",36,"ل",1,0],["فَبِنَظمِهِ وَبِنَثرِهِ الشُعَراءُ وَال","كُتّابُ تَبرُزُ في ثِيابِ لُصوصِ",37,"ص",1,0],["فَبَنو أَبي بَكرٍ مُلوكُ الشامِ وَالد","دُنيا بِأَجمَعِها وَبَيتِ المَقدِسِ",38,"س",1,0],["فَبَنوكَ كَالأَسباطِ كُلٌّ مِنهُمُ","في المُلكِ يَبلُغُ عُمرَ سَبعَةِ أَنسُرِ",39,"ر",1,0],["فبنداوٌ مباركة فاما","بها أو في سواها من قريب",40,"ب",1,0],["فَبنفس معَ الملائكِ ترقى","وَبِجسم ترعى مع الحيوانِ",41,"ن",1,0],["فَبنو شَيبان خلصانٌ لهُ","أَهلُ نصحٍ وَصفاءٍ مُشتَهر",42,"ر",1,0],["فبنو الأرض في الحقوق سواء","الرءوس الشمّاءُ كالأذناب",43,"ب",1,0],["فبنى النوم فوقهم","قنن دونها القنن",44,"ن",1,0],["فبنَيْتَ من نَقْعٍ سماءً مِلْؤها","شُهُبُ الأسنّةِ كالذُّبالِ المُوقَد",45,"د