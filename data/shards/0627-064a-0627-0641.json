{"poems":[[57,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[44,"من ذا الذي بإخائه وبوده","https://www.aldiwan.net/poem50302.html","الكامل"],[53,"أيا فضلا غدا فضلا","https://www.aldiwan.net/poem7986.html","الهزج"],[53,"أيا فضل إنك فضل أصا","https://www.aldiwan.net/poem8176.html","المتقارب"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[101,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[83,"هو البين حتى لم تزدك النوى بعدا","https://www.aldiwan.net/poem61535.html","الطويل"],[54,"أيا فتنة ما كنت منتظرا لها","https://www.aldiwan.net/poem27182.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[154,"أولى الأمور بستر","https://www.aldiwan.net/poem68175.html","المجتث"],[173,"تجاف عن العتبى فما الذنب واحد","https://www.aldiwan.net/poem1614.html",""],[173,"ظننت حسودي حين غالت غوائله","https://www.aldiwan.net/poem1644.html",""],[192,"إلا أنت","https://www.aldiwan.net/poem35679.html","عموديه"],[308,"أيا فاضلا أقلامه في طروسه","https://www.aldiwan.net/poem57730.html","الطويل"],[308,"أيا فاضلا ترنو الأفاضل نحوه","https://www.aldiwan.net/poem57749.html","الطويل"],[333,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[382,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[385,"أيا فردا بلا مثل","https://www.aldiwan.net/poem49230.html","مجزوء الوافر"],[435,"أيا فاضلا حاكت معاني صفاته","https://www.aldiwan.net/poem40040.html","الطويل"],[457,"أيا فاضلا يبدي الصفاء تكرما","https://www.aldiwan.net/poem13740.html","الطويل"],[543,"بكم شعري على غيري فخور","https://www.aldiwan.net/poem48179.html","عموديه"],[727,"","https://poetry.dctabudhabi.ae/diwan/poem/204996","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59542","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62533","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126156","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49584","المتقارب"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17557","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76661","المتقارب"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202146","الرمل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123651","الكامل"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199853","الطويل"],[2652,"","https://poetry.dctabudhabi.ae/diwan/poem/198380","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107176","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205030","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100763","المتقارب"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130613","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109898","البسيط"],[3693,"","https://poetry.dctabudhabi.ae/diwan/poem/145911","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45946","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94529","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34760","الهزج"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139545",""],[4679,"ألا أيها الصرح الذي تاه من فخر","https://www.poetsgate.com/ViewPoem.aspx?id=142722",""],[4830,"فَلَكُ الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=194200",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5127,"أعِرْنِي فؤاداً تراني وطنْ","https://www.poetsgate.com/ViewPoem.aspx?id=177325",""],[5145,"أتنكر أني بكم مغرم","https://www.poetsgate.com/ViewPoem.aspx?id=108229",""],[5221,"إلى الحبيبة -القدس-","https://www.poetsgate.com/ViewPoem.aspx?id=188994",""],[5330,"أحببتك أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=15589",""],[5376,"ما زال قلبي من الهجران يلتاعُ","https://www.poetsgate.com/ViewPoem.aspx?id=188291",""],[5431,"توضأ بالدماء","https://www.poetsgate.com/ViewPoem.aspx?id=183045",""],[5431,"أيا أمة العُرْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=185259",""],[444,"صباح مُحلّى حُبّا","https://www.poetsgate.com/ViewPoem.aspx?id=184403",""],[5697,"لحن الصباحات","https://www.poetsgate.com/ViewPoem.aspx?id=178328",""],[5768,"وَقَانَا اللهُ أَوْبِئَةً !","https://www.poetsgate.com/ViewPoem.aspx?id=215420",""],[5781,"بحرٌ بما يكفي لحُبٍّ وعاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=202850",""],[5878,"على شاطئ الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=188298",""],[5956,"أيا فرحُ الحمادةُ","https://www.poetsgate.com/ViewPoem.aspx?id=204716",""],[5956,"ندق الباب مرَّاتٍ عليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=206930",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[5393,"لماذا أتيتَ بهذا الزمانْ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85467&r=&rc=34",""]],"verses":[["أَيا فَوزُ لَو أَبصَرتِني ما عَرَفتِني","لِطولِ شُجوني بَعدَكُم وَشُحوبي",0,"ب",2,0],["أَيّاً فَعَلتَ فَلا تَزالُ مُقيمَةً","في الصَدرِ مِنكَ مُوَدَّةٌ لا تَبرَحُ",1,"ح",1,0],["أيا فَضلاً غدا فضلاً","عن الخلق وفي الزَّمْنَى",2,"ن",2,1],["أيا فَضْلُ إنك فضلٌ أصا","ب شيخكَ من حيثُ لم يكتسبْ",3,"ب",1,1],["أيا فيل بغداذ إذا عاج خطمُهُ","وخنزير كلواذى إذا عتّ في الجَعْر",4,"ر",1,0],["أيا فلسطين.. من يهديك زنبقةً؟","ومن يعيد لك البيت الذي خربا؟",5,"ب",2,0],["أَيا فِتنَةً في صورَةِ الإِنسِ صوِّرَت","وَيا مُفرَداً في الحُسنِ غادَرتَني فَردا",6,"د",2,0],["أَيا فِتنَةً ما كُنتُ مُنتَظِراً لَها","أَما لِقَتيلِ الهَجرِ بِالوَصلِ مِن بَعثِ",7,"ث",1,1],["أيُّ أفقٍ من عالم الأرض هذا","شاحبُ اللون باهتُ الأكنافِ",8,"ف",1,0],["أيا فلان فأحسن","ببذله لفلان",9,"ن",1,0],["أَيا فَضلُ قَد طالَ اِنتِظاري وَلَم يَقُم","شِتاءً وَقَيظاً عِندَ مِثلِكَ وافِدُ",10,"د",1,0],["أَيا فَضلُ لا زالت لِنُعماكَ تَلتَقي","بِمَغناكَ ساداتُ المَلا وَعَباهِلُه",11,"ل",2,0],["أيا فالقَ الإصباحِ والحَبِّ والنَّوى","ويا سابقاً للعفو تُخْشَى نَوازِلُهْ",12,"ل",2,0],["أيا فاضلاً أقلامه في طروسه","غدت في رداءٍ بالفضائل معلم",13,"م",1,1],["أيا فاضلاً ترنو الأفاضلُ نحوهُ","وتشكر في جمع المناقب تصريفه",14,"ه",1,1],["أي أفق من الأمانيّ ضاح","أجتليه في يقظتي ومنامي",15,"م",2,0],["أَيا فَتى أَسفِر فَقالَت أَلا","نَجمٌ وَإِنّا بَعدُ فِتيانُ",16,"ن",1,0],["أيا فرع يسَّى صرتِ أصلاً لفوزه","ولا تعجبوا للشمس دون الكواكب",17,"ب",1,0],["أَيا فَرداً بِلا مَثَل","وَيا غُصناً بِلا ظَلِ",18,"ل",1,1],["أيا فاضلاً حاكت معاني صفاته","عيون المها بين الرصافة والجسر",19,"ر",1,1],["أيا فاضلاً يبدي الصفاء تكرماً","فيذكو له منّا الثناء ويُحمدُ",20,"د",1,1],["أيا فخرَ المزَاوِرِ من شُبولٍ","حَوالي خَيسهِم أسَدٌ هَصُورُ",21,"ر",1,0],["أيا فاضلاً ساد الورى بفضائلٍ","تناهت فما أضحى لهنَّ عديل",22,"ل",1,1],["أيا فئة الأنصار للغارة اركبي","وبَثي السَّرايا من جواد ومَركب",23,"ب",1,1],["أيا فلكاً جرى بالخير هذا","زمانك فاجرِ قد صادفت مَجْرى",24,"ر",2,0],["أيا فاضلاً من دونه كل فاضل","وياكو كباً حقاً هو الكوكب الدري",25,"ر",2,0],["أيا فارسَ الخيلِ والبأسُ ظَنٌّ","يُرَجَّمُ أو ظِنَّةُ تُنْتَحل",26,"ل",1,0],["أَيا فَرَجاً مِن عِندِ ربٍّ مُفَرِّجٍ","أَمَا لَكَ فِي الدُّنيا عَلَيَّ طَرِيقُ",27,"ق",1,1],["أيا فارس الخيل يا زيدها","حميت الحمى وأبحت العيالا",28,"ل",2,0],["أي أفك ومداد من دم","ويراع من سيوف الغالبين",29,"ن",1,0],["أي افتقارك خشى من كله","وغناك يا ذا الفضل واكف ويله",30,"ه",1,0],["أيا فاعلاً خل التطبب واتئد","فكم تقتل المرضى المساكين بالجهل",31,"ل",1,1],["أيا فارط الحي الذي قد حشالكم","من المجد أنهاء ملاء الخوابيا",32,"ي",2,0],["أَيَا فاضِلاً فَضلُهُ بينَ الأَنامِ جَلِي","كَنارِ لَيلٍ عَلى عالٍ مِنَ الجَبَلِ",33,"ل",1,1],["أيا فيلا يمدّ بكل يوم","على الأكوان خرطوم الغروب",34,"ب",1,0],["أيا فلك الشهب حتى متى","تدور أما يعتريك الدوار",35,"ر",1,0],["أيا فرقد المجد والمحتد","ويا كوكب السعد والسؤدد",36,"د",1,1],["أيُّ افتِخارٍ بَعدَ فَخرِ نَب","وَةِ النُّبُوءَةِ وأيُّ انشِرَاح",37,"ح",1,0],["أيا فلكاً شمس العلى منه أشرقت","كما ازدهرت فيه دراري الكواكب",38,"ب",1,0],["أَيَا فَجارِ إلى كم تَعبَثينَ بنا","أَيَا وَقاحَ المحيَّا قَدكِ فاتَّئِبي",39,"ب",2,0],["أيا فاضلاً في العلا سؤله","له العلم والحلم سارا معا",40,"ع",2,1],["أيا فاسد الباس قل لي لمن","تعد اشتداد البؤس الشداد",41,"د",1,0],["أَيا فَخرَ النُحاةِ عُلاً وَيا مَن","يُضيءُ سَناهُ في الظُلَمِ الحَوالِكِ",42,"ك",1,1],["أَيا فضلُ يا آدابُ يا حزمُ يا نهى","هلموا إلى كَيسانِ عصرٍ نُحاربُه",43,"ب",2,0],["أيا فاتني في غنج طرفٍ يُرى سحرا","رويداً بقلبٍ كان في حبكم أحرى",44,"ر",2,1],["أيا فهمُ يا إزكانُ يا عقلُ يا نُهى","أيا لبُّ يا عرفان حيّوا لنصرتي",45,"ي",1,0],["أَيا فَهدَةُ ماذا الجَزَ","عُ الظاهِرُ يا فَهدَه",46,"د",2,1],["أيا فرع مجدس طاب من دوحةٍ زكت","وقد عرَّقت فيه كرامٌ أطائب",47,"ب",1,0],["أيا فرع دوح المجد والمفرد الذي","مناقبه الغراء جلت عن الحصرِ",48,"ر",1,0],["أيافلَكَ الحضارةِ حيث أسدى","لأرجاء الورى أُذُناً وعيْنا",49,"ن",2,0],["أيا فاقصد مثواه أمل ولاتمل","وأكثر ولا تقصر وطنب وخيما",50,"م",2,0],["أيا فاتكَ اللحظِ مِن مهجتي","عليكَ اﻹلهُ أﻻ فاشهدنْ",51,"ن",1,0],["أيا فخر دين الهدى زفّها","إليك عروساً أتت تجشم",52,"م",1,0],["أيا فلسطين مالي غير قافية","والروح تشهد أني هاهنا أقف",53,"ف",1,0],["أَيُّ أُفْقٍ غَيْرَ هَذَا ٱلأُفْقِ فِي ٱلدُّنْيَا مُعَطَّرْ","كُلَّمَا دَافَعْتُ عَنْ أَرْضِكِ عُودُ ٱلعُمْرِ يَخْضَرْ",54,"ر",1,0],["أيا فلسطين هل في القدس أبخرةٌ","من طيب ذكرك للفرسان يبتاعُ",55,"ع",1,0],["أيا فرعون هذا العصر فاسمع",".مصير الظلم يوما لإنقشاعِ",56,"ع",1,0],["أيا فارسا للحقِ شكرا صنيعكم","إلى الخُلد محفوظٌ بوشمٍ مُذَهبِ",57,"ب",1,0],["أيا فرحة الحب التي أنت سرّها","إذا لاح من عينيك غنّى وأمطرا",58,"ر",2,0],["أيا فضاء به تختال قافيتي","وفيه تزجل أشعاري وتزدهرِ",59,"ر",1,0],["أَيَا فَيْرُوسَ كُورُونَا","مَحَاكَ اللهُ مِنْ دَهْرِي",60,"ر",2,0],["أَيا فاتِرَ الأَجْفانِ تَسْفَحُ عَبْرَتي","تُطَرِّزُ وَجْناتي بِقُبْلةِ والِهِ",61,"ل",2,0],["أَيَا فَالِقَ الإِصبَاحِ يَسِّر لِعَاشِقٍ","لِقَاءَ الَّذِي أَضنَاهُ أَو دُونَهُ القَبرُ",62,"ر",1,0],["أيا فرحُ الحمادةُ منك يأتي","لنا الفرحُ الحميدُ بكلّ وقتِ",63,"ت",1,1],["أيا فرحُ الحمادة أفرِحينا","عسى المولى يُضاعفُ فرحتيكِ",64,"ك",1,0],["أيا فرحُ الحمادةُ أنتِ غيثٌ","فريدٌ زارعٌ فردوسَ أيكِ..",64,"ك",1,0],["أيا فعّالُ ياأمل السرايا","أغثنا لايضرِّسنا الرّسوبُ",65,"ب",1,0],["أيا فارساً خانه سيفه..","فأشهر عزاً.. بعز الطعانْ..",66,"ن",1,0],["أيا فارساً مشهراً \"غزةً\"..!","بوجه الهوان.. بعصر الهوانْ..",66,"ن",1,0]]}