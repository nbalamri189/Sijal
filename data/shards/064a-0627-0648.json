9487","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43789","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117004","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"عرش ينوح","https://www.poetsgate.com/ViewPoem.aspx?id=179684",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[77,"نفحت فشبت لافح التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=34093",""],[77,"يا واحدَ الدّهرِ في خَلْقِ وفي خُلُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=33563",""],[77,"يا والي العمرِ وألقابُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=33276",""],[77,"يا طلعَة َ الشُّوم التي مهما بدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=33203",""],[93,"هَذِي رُؤُوسُ الْقِمَمِ الشِّمَّاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31925",""],[96,"سمر","https://www.poetsgate.com/ViewPoem.aspx?id=17489",""],[73,"هَلْ تذكُرونَ غريباً عادَهُ شَجَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=201341",""],[45,"يا وَاحِدَ الخُلَفَاءِ، غيرَ مُدافَعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31116",""],[91,"تلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=53242",""],[91,"العيون السود","https://www.poetsgate.com/ViewPoem.aspx?id=14091",""],[64,"التلبية","https://www.poetsgate.com/ViewPoem.aspx?id=3094",""],[51,"هبّتْ لوهبٍ ريحُ سوءٍ عاصفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29390",""],[51,"أصبحتَ عاديتَ للصبا رشدكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30012",""],[97,"أَصوات الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=12761",""]],"verses":[["يا وَيحَ لي مِن شَجَني","أَما مَلَلتُ الشَجَنا",0,"ن",2,0],["يا وَقفَةً بِوَراءِ اللَيلِ أَعهَدُها","كانَت نَتيجَةَ صَبرٍ عاقِرِ الوَطَرِ",1,"ر",1,0],["يا وُقوفاً ما وَقَفنَ","في ظِلالِ السَلَماتِ",2,"ت",1,0],["يَأوي حُسامُكَ إِن صاحَ الضِرابُ بِهِ","إِلى لِواءٍ مِنَ العَلياءِ مَنصوبِ",3,"ب",1,0],["يا واهِبَ الأعْمارِ بعدَ اللُّها","وَرَتْ زِنادي بكَ قَبْلَ اقْتِداحْ",4,"ح",1,0],["يأْوونَ منهُ إِلى سَهْلٍ مَباءَتُهُ","يَرمي صَفاةَ العِدا عَنْ جانِبٍ خَشِنِ",5,"ن",1,0],["يا وَيحَ مَن عَلِقَ الأَحِبَّةَ قَلبُهُ","حَتّى إِذا ظَفِروا بِهِ قَتَلوهُ",6,"و",2,1],["يا وَحشَتا ما بُليتُ مِن قَمَرٍ","فَرَّقَ شَملي وَكانَ مُؤتَلِفا",7,"ف",2,1],["يا وَيحَ هَذا الفِراقِ ما صَنَعا","بَدَّدَ شَملي وَكانَ مُجتَمِعا",8,"ع",2,1],["يا وَيحَ مَعشوقَينِ ماتا وَلَم","يُداوِيا عِشقَهُما بِاِجتِماع",9,"ع",1,1],["يا واعِظَ الناسِ عَمّا أَنتَ فاعِلُهُ","يا مَن يُعَدُّ عَلَيهِ العُمرُ بِالنَفَسِ",10,"س",1,1],["يا واحِدَ العُلْيا بلا إلْباسِ","ابعَثْ بسَهْمٍ من أبِي العبّاسِ",11,"س",1,1],["يا واحِداً مهْما جرَى في حلْبَةٍ","جَلّى بغُرّةِ سابِقِ السّبّاقِ",12,"ق",1,0],["يا وَليَّ الإلاهِ أنتَ جَوادٌ","وقَصدنا الى حِماكَ المَنيعِ",13,"ع",1,1],["يَا وَاحِدَ الآحَادِ وَالْعَلَمُ الَّذِي","خَفَقَتْ بِعِزَّةِ نَصْرِهِ الأَعْلاَمُ",14,"م",1,0],["يا واصِلاً للجَشاءِ ناشيَةَ الْ","لَيْلِ ورَبَّ الضُّراطِ في السّحَرِ",15,"ر",1,0],["يا ولَدَ السَّحْقِ غيرَ مكْتَتَمٍ","حَديثُهُ يا ابْنَ فاسِدِ الدُّبُرِ",15,"ر",1,0],["يا واحِدَ الدّهْرِ في عِلْمٍ وفي عمَلِ","وعُمْدَةَ المُلْكِ في وِرْدٍ وفي صَدَرِ",16,"ر",1,1],["يا وارِثَ المَهْديّ في الجبلِ الذي","فضَلَ الجِبالَ فكانَ مطْلَعَ بدْرِهِ",17,"ر",2,1],["يا وافِدَيْ بَرٍّ وبَحْرٍ لُذْتُما","بمَريع مرْتَبَعٍ وعِزِّ جِوارِ",18,"ر",1,0],["يا واحِدَ المَجْدِ الذي آثارُهُ","تَرْوي حِساناً في الزّمانِ صِحاحا",19,"ح",2,0],["يا وَاحِدَ الدّهْرِ في خَلْقٍ وفي خُلُقِ","يا مَنْ لهُ الفَضْلُ في الماضِي وفي الآتِي",20,"ت",2,1],["يَا وَالِيَ الْعُمْرِ وَأَلْقَابُهُ","لَهَا إِلَى التَّضْييعِ فَرْطُ انْتِسَابْ",21,"ب",1,1],["يَا وَقْفَةَ النَّاعِيِ بِمَقْتَل وَاحِدٍ","أَذْكَى عَلَى الأَحْشَاءِ حَرَّ مُصَابِهِ",22,"ب",2,0],["يَا وَقفةَ الَطُّلاَّبِ فِي بَابِ امْرِئٍ","تُخْزَى سِبَالُهُمْ لَدَى بَوَّابِهِ",22,"ب",2,0],["يا وَيحَها خُلَّةً لَو أَنَّها صَدَقَت","ما وَعَدَت أَو لَو أَنَّ النُصحَ مَقبولُ",23,"ل",1,0],["يا وَيحَ لِلقَبرِ قَد أَخفى سَنا قَمَرٍ","مُقَسَّمِ الوَجهِ مَحسودِ التَجاليدِ",24,"د",1,0],["يا وَيحَهُ حَلَّ فيهِ ذو قَريحَتُهُ","لَها بِخِدرِ المَعالي أَلفُ مَولودِ",24,"د",1,0],["يا وَقفَةً في جِبالِ الأَرزِ أَنشُدُها","بَينَ الصَنَوبَرِ وَالشَربينِ وَالبانِ",25,"ن",1,0],["يا واعِظَ الناسِ ما تَنفَكُّ مِن تَعبٍ","مُعَذَّباً بَينَ إِنعاظٍ وَإِفلاسِ",26,"س",1,1],["يَا وَزِيرَ الشَّبَابِ أَنْتَ خَلِيقٌ","بِثَنَاءِ الشِّيُوخِ قَبْلَ الشَّبَابِ",27,"ب",1,1],["يا ويحها لما رجعت إزداد من","لجب اللقاء شجى الوداع الآخر",28,"ر",1,0],["يَا وَلَدَيَّ اللَّذِيْنَ غَابَا","عَنِّي وَكَانَا ضِيَاءَ عَيْنِي",29,"ي",1,1],["يَا وَيْحَهَا مِنْ مَغَانٍ لا غَنَاءَ بِهَا","كَيْفَ العَرُوسُ عَلَى مُنْقَضِّ أَرْكَانِ",30,"ن",1,0],["يَا وَاصِفُ النَّجْلِ النَّجِيبِ المُرْتَجَى","لِلْجَاهِ بَعْدَ أَبِيهِ وَالتَّمْكِينِ",31,"ن",1,0],["يَا وَيْحَ لِلنُّبْلِ وَالشَّمَائِلِ وَالآدَابِ","إِنْ دُكَّ ذَلِكَ العَلَمُ",32,"م",1,0],["يَا وَزِيرَاً لَوْ صَوَّرَ الأدَبُ","الرَّائِعُ فِي مَعْنَيَيهِ كَانَ المِثَالاَ",33,"ل",2,1],["يا واقِفاً يَبكي الطُلولَ وَيُنشِدُ","بِاللَهِ تِهتَ وَغابَ عَنكَ المُرشِدُ",34,"د",1,1],["يُأَوِّبنَ تَأَويباَ قَليلاً غِرارُهُ","وَيَجتَبنَ أَثناءَ الحَنادِسِ وَالقَمرِ",35,"ر",1,0],["يا وارثاً عنها مآثرها التي","قد شيَّدَتْ للفخر أشرف معلم",36,"م",1,0],["يا وارثاً نسب النبوة جامعاً","في العلم والأخلاق والأعراقِ",37,"ق",1,0],["يا ويحَ نفس توانَت عن مراشدِها","وطرفها في عنان الغَيِّ قد جَمَحَا",38,"ح",2,0],["يا وارثاً عنها مناقبها التي","تسمو مراقيها على الجوزاءِ",39,"ا",2,0],["يا وارث الأنصار وهي مَزِيَّةٌ","بفخارها أثنى الكتابُ المنزلُ",40,"ل",1,1],["يا وافدين وفي مسيرهم امتطَوْا","بطن الجَوائب لا ظهور النُوق",41,"ق",1,0],["يَأوي إِلَيكَ فَلا مَنٌّ وَلا جَحَدٌ","مَن ساقَهُ السِنَّةُ الحَصّاءُ وَالذَيبُ",42,"ب",1,0],["يا واهِبَ المالِ الجَزيلِ مِن سَعَه","سُيوفُ حَقٍّ وَجِفانٌ مُترَعَه",43,"ع",2,0],["ياواقِفانِ مَعي عَلى الدارِ اِطلُبا","غَيري لَها إِن كُنتُما تَقِفانِ",44,"ن",1,0],["ياواسِعَ الدارِ كَيفَ توسِعُها","وَنَحنُ في صَخرَةٍ نُزَلزِلُها",45,"ل",3,0],["ياوَحشَةَ الدارِ الَّتي رَبُّها","أَصبَحَ في أَثوابِ مَربوبِ",46,"ب",1,0],["يا وَيلَ أُمِّكُمُ وَوَيلَ أَبيكُمُ","وَيلاً تَرَدَّدَ فيكُمُ وَعَويلُ",47,"ل",1,0],["يا وَيحَ أَنصارِ النَبِيِّ وَرَهطِهِ","بَعدَ المُغَيَّبِ في سَواءِ المُلحَدِ",48,"د",1,0],["يا واحدَ المدحِ والثناءِ","وموجبَ الأجرِ والدُّعاءِ",49,"ا",2,1],["يا واعظَ الشام والثناء له","في سائر الأَرض سائر الأرج",50,"ج",1,1],["يا وزيراً يهدي الثناءَ سناه","ولهاه إلى المقاصدِ تهدى",51,"د",2,0],["يأوي إلى بيت قلبٍ فيه مختربٍ","فأعْجب لمخرِبِ بيتٍ وهو عامره",52,"ر",2,0],["يا واصف الخيل بالكميت وبال","نهد أرحنِي من طول وسواسي",53,"ي",1,1],["يا وزير المصرَين كلاًّ كفاه","في مهماته الكبار وحاطه",54,"ط",2,1],["يا وارث الأنصار فضل سيادةٍ","أخذت على عهد المعالي موتقا",55,"ق",2,0],["يا وزيراً قد عامل الله في الخل","ق وما خابَ طالب الخلاَّق",56,"ق",1,0],["يا ويحَ من أصبح محت","اجاً لنوع الصَدَقَهْ",57,"ه",1,1],["يا وزيراً أقلامنا ركَّعٌ في","مدح تجتلي محياه قبله",58,"ل",2,0],["يا واحداً في المعالي","تهوى المعالي جماله",59,"ل",2,1],["يا واثق الظن في علياه عش أبداً","وأنت معتضدٌ بالسعد معتصم",60,"م",1,0],["يا واحد العصر إنْ علماً وإنْ كرماً","هنئت بالدهرِ إنْ شهراً وإنْ عاما",61,"م",2,0],["يا وليًّا رجوته لوَلاه","عند دار الدنا ودار السلام",62,"م",1,1],["يا وارث الأنصار عودة وفده","نصراً على الأعداء والإعدام",63,"م",1,0],["يا وزيراً إلى حماه لجأنا","فلجأنا من الخطوب بحصنِ",64,"ن",1,0],["يا واعداً من بُعدِه بالردى","يكفي من الواعد هجرانه",65,"ن",2,0],["يا وزيراً شملَ الآفا","ق بالنعمى الحفيّه",66,"ي",2,1],["يا وزير العليا دعاء محبّ","راحَ للعشرِ إذ أشرت إليه",67,"ه",1,1],["يا واصفاً أوصاف ذيَّاك الصّبا","تمَّ الكلام عنده فلينصبا",68,"ب",2,0],["يا وَيحَ روحي وَمِن روحي فَوا أَسفي","عَلَيَّ مِنّي فَإِنّي أَصِلُ بَلوائي",69,"ا",3,0],["يا وَيْحَ هذا الطبِيبِ وَيْحاهُ","لقد تعدَّى بما تَجنَّاهُ",70,"ه",1,1],["يا واقباً بالأمس في بيتهِ","ما وقبَ المِخراقُ يا واقبُ",71,"ب",1,0],["ياوجهَ من أهوى لقد أعْتَبتني","لو أن نائلَهُ الممنَّع أعتبا",72,"ب",2,0],["يا واحد الناس الذي لم أجد","شَرواهُ في الأرض التي طُفْتُها",73,"ت",3,0],["يا وهبُ يا صاحبَ البريدِ ألا","تكتبُ بالحادثِ الذي حدثَا",74,"ث",2,1],["ياوجنتيهِ اللَّتينِ من بَهَجِ","في صُدُغيه اللذين من دَعَجِ",75,"ج",1,1],["يا ويحَ من أصبح في غُمَّةٍ","ليس له من كربها مخرَجُ",76,"ج",1,1],["يا وهبُ أُقْسِمُ بالمَقَا","م وبالحطيم إذا مُسِحْ",77,"ح",1,0],["يا وهبُ لا تكترث للعائبيك بها","فإنما أنت غيثٌ ربما رَعَدا",78,"د",2,0],["يا واضح الثغر كم تُدلُّ على ال","صَبِّ كأنْ قد أذقتَه بردَكْ",79,"ك",1,0],["يا وهبُ ذو الضرطةِ لا تبتئس","فإن للأستاه أنفاسا",80,"س",2,0],["يا واهب التاج الذي لم يزل","من زينة اللابس والمُلْبِس",81,"س",1,0],["يا ويحَهُ من فتىً وحسرتَهُ","إن قُبضتْ رُوحُهُ وما قَبضا",82,"ض",2,0],["يا وهبُ إن تكُ قد ولدتَ صبيَّةً","فبحمْلهم شُقراً عليك سِباطا",83,"ط",2,0],["يا وهبُ ويحكَ قد علمتَ بوَهيها","أفلا دعوت لرَتقِها خيَّاطا",83,"ط",2,0],["يأوي إليه نُسَيَّاتٌ له مُجُنٌ","سَلينَ بالفسق همَّ العريِ والجوعِ",84,"ع",1,0],["يا وجه ذي كرم حالت بشاشته","لن تحسن الشمس إلا ذات إشراق",85,"ق",1,0],["يا واسعَ العفْوِ والمذاهبِ في ال","إفضالِ أين الرحيبُ من عطنك",86,"ك",1,0],["يا وجه طوطٍ رأى قُمُدَّاً","فسال طولاً وقال قحِّمْ",87,"م",1,0],["يا ويحَ حسَّادي ويا ويلهُم","من ذا أراهم قسْمَهُمْ قَسْمي",88,"م",2,0],["يا واحدَ الناس في الآلاءِ والمننِ","والمستجارُ به من نَوْبِة الزمنِ",89,"ن",1,1],["يا واحدِ الناس في الآلاء والمننِ","والمستجارَ به من حادثِ الزمنِ",90,"ن",1,1],["يا وارث الصبَّاح ربوةَ مجدِه","أصبحت نعم مؤثِّل البنيان",91,"ن",1,0],["يا واحدَ الكرمِ الذي","ما إنْ له في الحسْنِ ثاني",92,"ي",1,0],["يا وارداً حوضاً سوى حَوْضِهِ","عَدّ عن الغِبِّ إلى رِفْهِه",93,"ه",2,0],["يَأوي إِلى خُرَّقٍ زُعرٍ قَوادِمُها","كَأَنَّهُنَّ إِذا بَرَّكنَ جُرثومُ",94,"م",1,0],["يا وَيحَ نَفسي كَم تُطارِدُني النَوى","وَتَهُدُّ مِنّي القَلب وَالأَعصابا",95,"ب",2,0],["يا وَيحَ قَلبي إِنَّهُ في جانِبي","وَأَظُنُّهُ نائي المَزارِ بَعيدا",96,"د",2,0],["يَأوي إِذا اِشتَدَّ الهَجيرُ إِلَيهِما","الناسِكانِ الظَبي وَالعُصفورُ",97,"ر",1,0],["يَأوي إِلى الأَدغالِ في نَهارِهِ","كَأَنَّهُ جُزءٌ مِنَ الأَدغالِ",98,"ل",1,0],["يا واحِداً مِنها يُحَمِّلُ نَفسَهُ","آلامَ عانيها وَلَيلَ سَليمِها",99,"م",3,0],["يَأوي إِلَيها البومُ غَيرَ مُرَوَّعٍ","مِن كُلِّ نَعّابٍ أَحَمِّ الذافِيَه",100,"ي",2,0],["يا وَيحَ هَذا الشَرقِ بَعدَكَ إِنَّهُ","لِلضَعفِ باتَ عَلى شَفيرِ الهاوِيَه",100,"ي",2,0],["يا وَيلَتاهُ لِمَن يُخا","طِبُ أَو لِمَن يَشكو الحَزينُ",101,"ن",1,0],["يا واسِعَ الهِمَّةِ لا","عَدِمَت تِلكَ الهِمَّه",102,"م",2,0],["يا واحِداً ما كانَ لي غَيرُهُ","بَعدَكَ وا قِلَّةَ أَنصاري",103,"ي",1,1],["يا وجْنَةَ الوردِ الأنيق","ألمْ تشوِّهْكِ النُّدوبْ",104,"ب",1,0],["يا واردي حوض المنية قبلنا","ما أعذب الحوض الذي تردونا",105,"ن",2,0],["يا واهب الشعر لنا","لأنت خير من وهب",106,"ب",1,0],["يا ويلها بالمال منهم ما نجت","هذا لعمر أبي هو الخسران",107,"ن",1,0],["يا والي السوء لا تكذب بموعدة","فالكذب ليس بمحمود وإن زينا",108,"ن",2,0],["يا واحد الفن في أزجى معازفه","هذا أوان الثناء العدل قد آنا",109,"ن",2,0],["يا وَيلَتاهُ لِنَفسي راعَها وَدَها","مُسوَدَّةُ الصُحفِ في مُبيَضَّةِ اللَمَمِ",110,"م",1,0],["يا واضِعَ الدُستورِ أَمسِ كَخُلقِهِ","ما فيهِ مِن عِوَجٍ وَلا هُوَ ضَيِّقُ",111,"ق",1,0],["يا وَحيداً كَأَمسِ في كِسرِ بَيتٍ","ضَيِّقٍ بِالنَزيلِ رَحبٍ ذِراعُه",112,"ع",2,0],["يا وارِثَ الحَسَبِ الصَمي","مِ وَكاسِبَ الأَدَبِ اللُبابِ",113,"ب",1,0],["يا وَيحَهُم نَصَبوا مَناراً مِن دَمٍ","توحي إِلى جيلِ الغَدِ البَغضاءَ",114,"ا",2,0],["يا وَيحَ وَجهِ الأَرضِ أَصبَحَ مَأتَماً","بَعدَ الفَوارِسِ مِن بَني حَوّاءِ",115,"ا",2,0],["يا وَيحَ أَهلِيَ أَبلى بَينَ أَعيُنِهِم","وَيَدرُجُ المَوتُ في جِسمي وَأَعضائي",116,"ي",1,1],["يا وَيحَ قَلبِيَ مَهما اِنتابَ أَرسُمَهُم","سَرى بِهِ الهَمُّ أَو عادَتهُ أَشجانُ",117,"ن",1,0],["يا وَقى اللَهُ ما أُصَبِّحُ مِنهُ","وَسَقى صَفوَةَ الحَيا ما أُمَسّي",118,"س",2,0],["يا واحِدَ الإِسلامِ غَيرَ مُدافِعٍ","أَنا في زَمانِكَ واحِدُ الأَشعارِ",119,"ر",1,0],["يا واصِفَ الدَمِ يَجري هَهُنا وَهُنا","قُمِ اُنظُرِ الدَمَ فَهوَ اليَومَ دَأماءُ",120,"ا",2,0],["يا وَجهَ داهِيَةَ الَّذي لَولاكَ ما","أَكَلَ الضَنى جَسَدي وَرَضَّ الأَعظُما",121,"م",2,0],["يا وارداً سؤْرَ عيشٍ كلُّه كَدَرٌ","أنفقتَ عُمرَكَ في أيامِكَ الأُوَلِ",122,"ل",1,0],["يا وقفةً إثْرَ الأُلَى رحلُوا","حيث التقَى بالأبطحِ الشِّعْبُ",123,"ب",1,0],["يا واحِدَ الأَملاكِ مِن هاشِمٍ","وَسَيِّدَ الأَشرافِ مِن فِهرِ",124,"ر",1,0],["يا وَهبُ هَب لِأَخيكَ وَقفَةَ مُسعِدٍ","يُعطي الأَسى مِن دَمعِهِ المَبذولِ",125,"ل",1,0],["يا واحِدَ الكَرَمِ الَّذي ضَمِنَت لَهُ","أَفعالُهُ دَرَكَ المَكارِمِ وَالعُلا",126,"ل",2,0],["يا واحِدَ الخُلَفاءِ غَيرَ مُدافَعٍ","كَرَماً وَأَحسَنَهُم نَداً وَصَنيعا",127,"ع",2,1],["يا وَقعَ هَلّا سَأَلتِ القَومَ ما حَسَبي","إِذا تَلاقَت عُرى ضَفرٍ وَأَحقابِ",128,"ب",1,1],["يا وَيحَ صِبيَتي الَّذينَ تَرَكتُهُم","لا يُنضِجونَ مِنَ الهُزالِ كُراعا",129,"ع",2,1],["يا وَيحَ أُختِ بَني كِنانَةَ إِنَّها","لَبَخيلَةٌ بِشِفاءِ مَن لَم يُجرِمِ",130,"م",1,0],["يا واعِظَ الناسِ قَد أَصبَحتَ مُهتَمّاً","إِذ عِبتَ مِنهُم أُموراً أَنتَ تاتيها",131,"ي",3,1],["يا وَيحَ نَفسي لَوَ أَنَّهُ أَقصَر","ما كانَ عَيشي كَما أَرى أَكدَر",132,"ر",1,1],["يا وَيحَ قَومٍ أَغضَبوكَ بِجَهلِهِم","وَرَأوا قَريبَ الفَتحِ مِنكَ بَعيدا",133,"د",2,0],["يا وارِداً سُؤرَ عَيشٍ صَفوُهُ كَدَرٌ","وَشَرُّ ما يَكسَبُ الإِنسانُ ما يَصِمُ",134,"م",1,0],["يا ويح هاتيكَ الثواني لم تقف","حتى نُسيغَ هناءةً ذقناهَا",135,"ا",3,0],["يا ويحَ ما ضيَّعتُ في","هِ من قليلٍ مخجلِ",136,"ل",1,0],["يا ويلها من صرخة مجنونة","ضجت لها الآفاق من شفتيك",137,"ك",1,0],["يا وحدتي جئت كي أنسَى وها أنذا","ما زلت أسمع أصداءً وأصواتا",138,"ت",2,1],["يا ويحه كيف قد أطاق","شكوى البرايا على السنين",139,"ن",1,0],["يا وجدي كيف وجدت به","روحي وغدوت له بَدنا",140,"ن",2,0],["يا واحدَ الجود والبأس الذي اتفقتْ","بلا اختلافٍ على تفضيله الأممُ",141,"م",1,0],["يا وَيْحَ طارِقِ لَيلٍ يَستَقِلُّ بِهِ","سامي التليلِ براهُ الأيْنُ والضُّمُرُ",142,"ر",1,0],["يا واحِداً جُمِعَتْ فيهِ الكرامُ ومَنْ","بِسَيفه مِلَّةٌ التَّوحيدِ تَنتَصِرُ",142,"ر",1,0],["يا وَجْهَ جوهرةَ المحجوبَ عن بَصَري","من ذا يقيكَ كسوفاً قد علا قَمَرَك",143,"ك",1,0],["يَأوي إِلى عِزَّةٍ قَعْساءَ مُرْغِمَةً","أَنْفَ الزَّمانِ على ما فيه من أشَرِ",144,"ر",1,0],["يأوي إلى شَرَفٍ تَقَادَمَ بيتُهُ","أَزمانَ عادٍ في العلى وثَمودِ",145,"د",1,0],["يا وَيْحَ قتلى العاشقين وإنْ هُمُ","شهدوا حروباً ما لهنّ جراحُ",146,"ح",1,0],["يا وَهُوبَ العيدِ في بَعضِ النّدى","والغنى والجودِ والكُومِ اللّقاح",147,"ح",1,0],["يا واحِداً مُنفَرِداً بِعَدلِهِ","أَلبَستَهُ الغِنى فَلا تُمَلِّهِ",148,"ل",2,0],["يا وارِداً لَجَّت بِهِ هَفَواتُهُ","ما كُنتَ أَوَّلَ وارِدٍ لَم يَصدُرِ",149,"ر",1,0],["يا وَقعَةً ما كانَ أَعتَقَ يَومَها","إِذ بَعضُ أَيّامِ الزَمانِ هَجينُ",150,"ن",1,0],["يا واهِبَ العيسِ الهَموسِ بِرَحلِها","وَالأَعوَجِيِّ بِسَرجِهِ وَلِجامِهِ",151,"م",2,0],["يا وارِثَ المُلكِ إِنَّ المُلكَ مُحتَبَسُ","وَقفٌ عَلَيكَ إِلى أَن تُنشَرَ الصُوَرُ",152,"ر",1,1],["يا ويحَ برٍّ مِنْ أذى فاجرٍ","إذا تولى الفاجرُ البرَّا",153,"ر",2,0],["يا وافياً سكنَ الجنانَ إلى متى","قلبي لفقدِكَ في جحيمٍ تلذعُ",154,"ع",1,0],["يا ويحَ مَنْ عاندوا أو كذَّبوا سفهاً","ولم يروكَ بفكرٍ صادقِ الخبرِ",155,"ر",1,0],["يا واصفَ السيلِ وصفاً هالَ سامعَهُ","فالقلبُ والخوفُ مِنْ أوصافِهِ يجبُ",156,"ب",1,0],["يا وَهبَ إِن يَكُ قَد شَطَّ البِعادُ بِكُم","وَفَرَّقَ الشَملَ مِنّا صَرفَ ذا الزَمَنِ",157,"ن",1,0],["يا وَيْلَتا لِلقَومِ إن هَلَكوا","هَلْ يَملِكوَن لأمرِهمْ حِوَلا",158,"ل",2,0],["يا وَيْحَهُمْ أفما رَأَوْا من حولِهم","شعباً أعزَّ من اليهودِ وأكرَما",159,"م",2,0],["يأوِي إلى النَّفَرِ الضّعافِ وإنّه","لأشدُّ منهم في النِّضالِ وأوثقُ",160,"ق",1,0],["يا وَيْحَ للشرقِ هل قامت به أُممٌ","تَستنفِدُ العدَّ أم قامتْ تماثيلُ",161,"ل",1,0],["يا وارثَ البطحاءِ عن عدنانها","وسليلَ كلِّ مُغامرٍ مِقدامِ",162,"م",1,0],["يا وُفودَ النّيلِ ترتجُّ القُرى","وتَموجُ المُدْنُ منها بالمِئينْ",163,"ن",1,1],["يا وَيحَ مِصرَ أَما تَنفَكُّ ثائِرَةً","لِحادِثٍ جَلَلٍ أَو نَكبَةٍ عَمَمِ",164,"م",1,0],["يا وَيحَ مِصرَ لِخُلفٍ لا رُكودَ لَهُ","إِلّا لِيَعصِفَ بِالأَقطارِ وَالأُمَمِ",164,"م",1,0],["يا واهِبَ الأَمنِ النُفوسَ وَلَم تَكُن","لِتُصيبَ أَمناً أَو تَطيقَ قَرارا",165,"ر",2,0],["يا وَيْلَكُم إن رَضِيْتُمْ جَوْفَ مُظلِمَةٍ","مَسْجُورةٍ ذاتِ أطواءٍ وأعماقِ",166,"ق",1,0],["يا ويلَ من ظنَّ أن اللَّهَ يَخذُلُه","وأنّهُ من يمينِ اللهِ يُخْتَطَفُ",167,"ف",1,0],["يا وَيْلَهُ إذ تُرِيه النَّجمَ في يدِهِ","نَفْسٌ مُضلَّلةٌ هاجتْ له طَمَعا",168,"ع",2,0],["يا وَيْحَ للعبّاسِ يَغلبُ حِلْمَهُ","أنْ كان دُونَ مَراتبِ الرُؤساءِ",169,"ا",2,0],["يا وَيلتَا لابنِ الربيعِ يغيظُه","هذا المقامُ الصَّعبُ كيف يُيَسَّرُ",170,"ر",1,0],["يا ويلهم إذ يقذفون نبيَّهم","بحجارةٍ تهوِي هُوِيَّ سهامِهِ",171,"م",2,0],["يا ويلكم حين ترتجّ الحصونُ بكم","ترجو الأمانَ وتُبدي الخوفَ والوَجلا",172,"ل",2,0],["يا ويحَ لِلأممِ الضِّعافِ اتَنْقَضِي","دُنيا الشُّعوبِ وما انْقَضتْ بلواها",173,"ا",3,0],["يأوِي لِعَليَاهُ مَحمِيٌّ ومُضطَهَدٌ","كَالماء فِيهِ وُرُودُ اللَّيثِ والحَمَلِ",174,"ل",1,0],["يا واحِداً في الفَضلِ حالَفَني نَدى","يَدِهِ مُحالَفَةَ النَدى لِمُحَلِّقِ",175,"ق",1,1],["يَأوي لِظِلِّكَ مَحمِيٌّ وَمُطَّرَدٌ","كَالرَوضِ يَرتادُهُ ظَبيٌ وَسِرحانُ",176,"ن",1,0],["يَأوي إِلى حَسَبٍ مِثلِ السُها شَرَفاً","لَكِنَّ ذاكَ خَفِيٌّ وَهوَ مَشهورُ",177,"ر",1,1],["يا وَجدُ شَأنَكَ وَالفُؤادَ وَخَلَّني","ما المَرءُ مَأخوذاً بِزَلَّةِ جارِهِ",178,"ر",2,0],["يا وردةً ترسلُ أنوارَها","فيْضاً على الكونْ من الرابيهْ",179,"ي",2,0],["يا وردتي وربَّ سَهْلٍ بدا","طريقُه يُهلِك مَنْ يسلُكُ",180,"ك",1,0],["يا وَيحَ هَذا الطَرفِ ما غَمَّضا","بِضَوءِ بَرقٍ لائِحٍ أَومَضا",181,"ض",2,1],["يَاوي إِلى أَدماءَ مِن حُبِّهِ","تَحنُو عَلَيهِ رائِمٌ عَوهَجِ",182,"ج",1,0],["يا وَيحَ رَيحانٍ نُحَيِّيهِ بِهِ","وَالوَيلُ لِلكَأسِ الَّتي نَسقيهِ",183,"ه",1,0],["يا وَيلَهُ مِن وُثوبِ مُفتَرِسٍ","رُبَّ سُكونٍ مِن تَحتِهِ عَمَلُ",184,"ل",1,0],["يا وَجهَ شُرَّةَ يا أَخا البَدرِ","أُرضَيتَ بِالإِعراضِ وَالهَجرِ",185,"ر",1,1],["يا وَيحَ قَلبِيَ مِن ريمٍ بُليتُ بِهِ","بِالصُبحِ مُنتَقِبٍ بِاللَيلِ مُعتَجِرِ",186,"ر",1,0],["يا وارثاً بالفَرْضِ عِلْمَ نَبِيِّهِ","شَرَفاً وبالتَّعْصِيبِ غيرَ مُفَنَّدِ",187,"د",1,0],["يا وَيْلَتَا منّي عليّ أمُخْرِسي","إحسانُها أو مُغرِقي طُوفانها",188,"ن",3,0],["يا وَيلكُمْ أفما لكم من صارخٍ","إلاّ بثَغْرٍ ضاعَ أو دينٍ عَفا",189,"ف",2,0],["يا وَيحَ أَهلِيَ أَبلى بَينَ أَعيُنِهِم","عَلى الفِراشِ وَما يَدرونَ ما دائي",190,"ا",3,0],["يا واحِدي مِن جَميعِ الناسِ كُلِّهِمُ","ماذا أَرَدتَ إِلى سَبّي وَتَأنيبي",191,"ي",1,0],["يا وَيلَتا أَيُّ شَيءٍ","بَينَ الحَشا وَاللَهاةِ",192,"ه",1,0],["يا واضِعاً بَيضَ القَطا","تَحتَ الزَمامِجِ لِلفِراخِ",193,"خ",1,1],["يا وَيحَ مَن لا يُبالي عَينَ مُبصِرِهِ","لا تَرى مَعَهُ شَمساً وَلا قَمَرا",194,"ر",2,0],["يا وَحشَتا بَعدَكَ ماذا بِنا","أَحَلَّ مِن ضَنكٍ صُروفَ الدُهور",195,"ر",1,0],["يا وَيلَتي مِن جَسَدي كُلِّهِ","رُضِّضَ مِنّي مَفصِلاً مَفصِلا",196,"ل",2,0],["يا واصِفَ الغِلمانِ في شِعرِهِ","أَنتَ وَرَبّي مِنهُمُ الأَوَّلُ",197,"ل",1,1],["يا وَزَّةً تَنقُصُ أَمثالُها","وَقَد تَلاها اللَحِمُ الأَحفَلُ",197,"ل",1,0],["يا وَردَةً أَعجَلَها قاطِفٌ","مَرَّ بِها مِن بابِ عُثمانِ",198,"ن",1,0],["يا وَردَةً مِن بَهارٍ","يا زَهرَةَ الزَعفَرانِ",199,"ن",1,0],["يا واحِدَ العَرَبِ الَّذي","أَمسى وَليَسَ لَهُ نَظير",200,"ر",1,1],["يا وَيحَ نَفسي أَراها كُلَّما اِنبَعَثَت","أَلقى عَليها صُباباتِ الكَرى القَدَرُ",201,"ر",1,0],["يا وَيحَها خُلَّةً كانَت مَواعِدُها","كَاللَيلِ غَرَّت بِهِ الأَحلامُ رُقّادا",202,"د",2,0],["يا وَيحَها طِفلَةً خَلَوتُ بِها","لَيسَ دُنُوّي فيها مِنَ العُدَدِ",203,"د",1,0],["يا وَيحَها طِفلَةً خَلَوتُ بِها","لَيسَت ذُنوبي فيها مِنَ العَدَدِ",204,"د",1,0],["يا وَيحَ نَفسي أَما لَنا أَبَداً","مِن حُبِّها سَلوَةٌ وَلا فَرَجُ",205,"ج",1,0],["يا وَيحَ فاطِمَةَ الَّتي فُجِعَت بِهِ","وَتَشَقَّقَت مِنها عَلَيهِ جُيوبُ",206,"ب",1,0],["يا وَيحَ حَمّادٍ أَمِن نَظرَةٍ","راحَ أَسيراً غَيرَ مَجنوبِ",207,"ب",1,1],["يا وَيلَتى أَحرَزَها واهِبٌ","لا نالَ خَيراً بَعدَها واهِبُ",208,"ب",1,0],["يا واعِظي بِالصَمتِ ما لَكَ لا","تُلقي إِلَيَّ حَديثَكَ اللَذا",209,"ذ",2,1],["يا والِيَ المِصرِ وَالإِقليمِ هَل حُفِظَت","صَنائِعٌ لَكَ أَم كُلُّ اِمرِئٍ ناسي",210,"س",2,0],["يا وجهَ مُعتذرٍ ومُقلةَ ظالمِ","كم من دَمٍ ظُلماً سَفكتَ بلا دَمِ",211,"م",1,1],["يا وَيلتا مِنْ مَوْقفٍ ما بهِ","أَخْوفُ مِنْ أَنْ يعدِلَ الحاكمُ",212,"م",1,1],["يا ومَيضَ البَرقِ بينَ الغَمامْ","لا عليها بل عليكَ السَّلامْ",213,"م",1,1],["يا والِدَ الصِّدِّيقِ خُذْهَا نِعمةً","سِيقَتْ إليكَ من النبيِّ مُحمَّدِ",214,"د",1,0],["يا وَيلتا إن أتعابي ذهبن سدى","لا كنتُ من شاعر لما أَهين شدا",215,"د",2,0],["يا وجه لَيلى كنت وضا","ءً فما هَذا الشحوب",216,"ب",1,0],["يا وَيلتا سأموت بعد قَليلِ","وأُفارِقُ الدنيا وكل جَميلِ",217,"ل",1,1],["يا ويلتا من عمري الباقي","هذا سواد تحت أحداقي",218,"ي",1,0],["يا وجه داهية الذي لولاك ما","أكل الضنا جسدي ورض الأعظما",219,"م",2,0],["يا ويحهم ما عرفوا مَوئِلا","من قسوةِ الدهرِ وجورِ القضاء",220,"ا",2,0],["يا وحيَ شعري أينَ أنتْ","في أيِّ زاويةٍ ركَنْتْ",221,"ت",1,1],["يا وحيُ كم من غارةٍ","شعواءَ فيها قد شَننْتْ",221,"ت",1,0],["يا وحيَ شعري ما سكو","تك في الخطوب ألا حزنْتْ",221,"ت",1,0],["يا وحيَ شعري مُذْ نَأَيْ","تَ وهَى بياني أو وهنْتْ",221,"ت",1,0],["يا وحي شعري هل أُسِرْ","تَ وأنت تهجم أم طُعِنْتْ",221,"ت",1,0],["يا واهبَ الثورة الكبرى يَفَاعَتَهُ","حين الشبابُ رُؤى غيدٍ وألحانِ",222,"ن",1,0],["يا وَيحه لا يَحير نُطقا","فكيف تُلقي له انتباها",223,"ه",2,0],["يا واهِبَ الآلافِ كَم","طَوَّقتَ بِالمِنَنِ الرِقاب",224,"ب",1,0],["يأوى إلى سُبُحاته هذا وذا","وتطيف أصناف المحامد لّوذا",225,"ذ",2,0],["يا وَيْلَنَا إِنْ تَنَكَّبَتْنَا","رَحْمَةُ مَن بَطْشُهُ شَدِيدُ",226,"د",1,0],["يَا وَيْحَ نَفْسِي مِنْ هَوَى شَادِنٍ","غَازَلَ قَلْبِي لَحْظُهُ فَانْهَتَكْ",227,"ك",1,1],["يا وارِدَاً لا يَمَلُّ مَوْرِدَهُ","حَذارِ مِنْ أَنْ يُصِيبَكَ الشَّرَبُ",228,"ب",1,0],["يَا وَيْحَ لِلأَعْمَامِ لَوْ شَاهَدْتَهُمْ","وَهُمُ حَنَايَا سُعِّرَتْ وَأَضَالِعُ",229,"ع",1,0],["يَا وَلديَّ أُغْنَمَا حَيَاةً","لاَ يُعْتَرَى سَعْدُها بِنَجِسِ",230,"س",1,0],["يَا وَصِيفَاتِي بَنَاتِ النُّورِ","وَالقَطْرِ فِي الفَجْرِ",231,"ر",1,0],["يَا وَقْفَةَ الْعِيدِ مَاذَا","أَرَيْتِنَا فِي وَقْفَهْ",232,"ف",2,0],["يَا وَافِدِينَ لِيَشْهَدُوا تَأْبِينَهُ","مِنْ أَوْليَاءَ وَأَصْفِيَاءَ أَصَادِقِ",233,"ق",1,0],["يَا وَيْلَهَا تَبْكِي كَمَنْ","تَأْسَى وَتَضْحَكُ كَالجُذَالَى",234,"ل",2,0],["يَا وَيْحَ لِلشَّرْقِ كَيْفَ يُفْنِي","قُوَاهُ فِي بُؤْرَةِ الشِّقَاقِ",235,"ق",1,0],["يَا وَزِيرَ الأَوْقَافِ منْ كَانَ أَوْلَى","أَنْ يُولَّى وِزَارةَ الأَوْقَافِ",236,"ف",1,0],["يَا وَزِيراً أَهْدَى إِلى الضَّاد مَا شَا","ءَ لَهَا البَعْثُ مِنْ مَآثِرَ غُرِّ",237,"ر",1,0],["يَا وَلَداً يَا وَلَدَا","يَا وَلَدَا يَا وَلَدَا",238,"د",2,0],["يَا وَيْحَ فَاقِدَةٍ عَزِيزاً لاَ يَرَى","سَالِيهِ بَيْنَ أَبَاعِدٍ وَأَقَارِبِ",239,"ب",1,1],["يَا وَزيراً لَهُ مِنَ الْفَضْلِ مَا يُغْنِيهِ","عَنْ كُلِّ مَدْحَةٍ وَثَنَاءِ",240,"ا",2,0],["يَا وَزِيراً إِلْمَامُهُ الْيَوْمَ فَضلٌ","يَمْلأُ النَّفْسَ غِبْطَةً وَسُرُورَا",241,"ر",2,1],["يَا وَيْحَهَا لَمَّا أَدَالَ البَيْن مِنْ","طِيبِ اللِّقَاءِ شَجَى الوَدَاعِ الآخِرِ",242,"ر",1,0],["يَا وَزِيراً لَيْسَ الطَّبِيبُ لأَفْرَادٍ","وَلَكِنَّهُ طَبِيبُ البِلاَدِ",243,"د",1,1],["يَا وَفْدَ لُبْنَان إِلى","رَحَبَاتِهِ حُيِّيْتَ وَفْدَا",244,"د",2,0],["يَا وَزِيرَ العِلْمِ لازُلْ","تَ لأَهْلِيهِ عَمِيدا",245,"د",2,0],["يَأْوي إلى ظِلِّ اللّواءِ كأَنَّهُ","في صَعْدَةِ الخَطّيّ فَيْءُ عُقابِ",246,"ب",1,0],["ياوَيحَ خالِكَ بَل ياوَيحَ كُلِّ فَتىً","أَكُلَّ هَذا تَخَطّى نَحوَكَ الأَجَلُ",247,"ل",1,0],["يا وردة طابت وطبنا بها","أيام نسقيها بماء العيون",248,"ن",1,1],["ياوردة القلب! حيتك الورود .. وما","للورد نفح عبير منك أنشقه",249,"ق",2,0],["يا واحِداً حَلّ مِثلَ الأَلفِ مِن مضَر","حَتّى تَقول العِدا حَسبي بِهِ وَكَفى",250,"ف",2,1],["يا وَيلَتا مِنَ النَوى","لَقَد أَطالَت سَفَرَك",251,"ك",1,0],["يا واحِدَ العرَبِ الذي ما إن لهُم","من معدِلٍ عنهُ ولا من مقصِر",252,"ر",1,0],["يا ويح قومي كم أشاهد بينهم","من شاعرٍ هو شاعرٌ بهوانه",253,"ن",2,0],["يا وردةً بين الرمالِ نضيرةً","تُزْهَى بها الأغصانُ والأكمام",254,"م",1,0],["يا وافيًا بعهوده لبلادِهِ","ولكلِّ مَن عرفوه من خُلَطَائه",255,"ا",3,0],["يا واصلَ الآجال -بعد اللهِ- في","دنيا الفناء، وواصل الأرزاق",256,"ق",1,0],["يا وارثين بني أُمَّيةَ، زنتمو","مجدَ الجدود، وزدتموه رَوْنَقَا",257,"ق",2,0],["يا وَاقِفين على السَّلام جُهُودَهُم","قُودُوا الصُّفوفَ بِعَزْم هانيِبَال",258,"ل",1,0],["يا ويحَ قومي! كما أشاهدُ بينهم","من شاعرٍ هو شاعرٌ بهوانه!",259,"ن",2,0],["يا وفودَ الأحرار من كلّ قطرٍ","عزَّ كالنجم في السماء مكانا",260,"ن",2,0],["يا وَاحةً قد خطَّها ال","رَّحمنُ في وَسَط التِّلال",261,"ل",1,0],["يا وافدي بر وبحر لذتما","بمربع مرتبع وعز جوار",262,"ر",1,0],["يا واحدَ الدّهرِ في خَلْقِ وفي خُلُقِ","يا من له الفضْلُ في الماضي وفي الآت",263,"ت",1,1],["يا والي العمرِ وألقابُهُ","لها إلى التَّضبيع فَرْطُ انِتساب",264,"ب",1,1],["يا وقْفة َ الطُّلاب في باب امرىء ٍ","تُخزى سبالُهُم لدى بوابه",265,"ب",2,0],["يَا وَطَناً نَفْدِيهِ بِالدِّمَاءِ","وَالأَنْفُسِ الصَّادِقَةِ الْوَلاَءِ",266,"ا",2,0],["يا وحي كم من غارة","شعواء فيها شننت",267,"ت",1,0],["يا وَيلَتاهُ ، أيبْقَى في جوانِحِه","فؤادُه وهُو بالأطْلالِ مُرْتَهَنُ ؟",268,"ن",1,0],["يا وَاحِدَ الخُلَفَاءِ، غيرَ مُدافَعٍ","كَرَماً، وأحسَنَهُمْ ندىً صَنِيعَا",269,"ع",2,1],["يا واحد منها يحمّل نفسه","آلام عانيها وليل سليمها",270,"م",3,0],["يا ويح قلبي إنه في جانبي","وأضنه نائي المزار بعيدا",271,"د",2,0],["يا ويحَ روحي من روحي فوا أسفي","عليَّ منّي فإنّي اصل بلوائي",272,"ا",3,0],["يا وهبُ ويحكَ قد علمتَ بوَهيها","أفلا دعوت لرتقتِها خيَّاطا",273,"ط",2,0],["يا واضح الثغر كم تُدِلُّ على الصب","ب كأن قد أذقته بردك",274,"ك",1,0],["يا وحدتي جئت كي أنسَى وهائنذا","ما زلتُ أسمعُ أصداءً وأصواتا",275,"ت",2,1]]}