واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5268,"شروق","https://www.poetsgate.com/ViewPoem.aspx?id=207006",""],[5300,"سائلة لي ما أشجع","https://www.poetsgate.com/ViewPoem.aspx?id=200451",""],[5307,"حبك ملك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=10542",""],[5320,"الموظف","https://www.poetsgate.com/ViewPoem.aspx?id=40423",""],[5401,"مهند وطوني","https://www.poetsgate.com/ViewPoem.aspx?id=85371",""],[5431,"والكلّ هالك ...","https://www.poetsgate.com/ViewPoem.aspx?id=198915",""],[5431,"لروح البريهي...","https://www.poetsgate.com/ViewPoem.aspx?id=210255",""],[5431,"سينتقم الجبار ربي ..وأربحُ","https://www.poetsgate.com/ViewPoem.aspx?id=211934",""],[5561,"كما تشائين","https://www.poetsgate.com/ViewPoem.aspx?id=201390",""],[5648,"يبقا سلام الله لو الجرح ماطاب","https://www.poetsgate.com/ViewPoem.aspx?id=155217",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""]],"verses":[["شَروى أَبي الصَقرِ الَّذي مَدَّت لَهُ","شَيبانُ في الحَسَناتِ أَبعَدَها مَدى",0,"د",2,0],["شَرَوا بِرِضا اللَهِ دُنياهُمُ","وَقَد عَلِموا أَنَّها بائِدَه",1,"د",2,0],["شَرَوْهُ فباعوا بالرّدى فيه أنفساً","أرِبحٌ لهم في ذلك البيع أم خُسْرُ",2,"ر",1,0],["شُرورُ الدَهرِ أَكثَرُ مِن بَنيهِ","فَقَبلُ سَطَت عَلى أُمَمٍ وَبَعدُ",3,"د",1,0],["شَرُوا الضَّلالَةَ بِالْهُدَى وَاغْتَرَّهُمْ","لِينُ الْحَيَاةِ وَمَاؤُهَا الرَّقرَاقُ",4,"ق",1,0],["شَروبٌ إِذا ما أَصبَحَ الحَمدُ قَهوَةً","طَروبٌ إِذا كانَ الصَليلُ تَرَنُّما",5,"م",2,0],["شَرودٍ تَلَمَّعُ بِالخافِقَينِ","إِذا أُنشِدَت قيلَ مَن قالَها",6,"ل",3,0],["شَرودٌ نَفورٌ وَقَلبي عَنِ ال","مَلامَةِ فيهِ شَرودٌ نَفورُ",7,"ر",1,0],["شُروقُ الضُحى مِنّي إِلَيكِ تَحِيَّةً","وَنَشرُ الصِبا مِنّي إِلَيكِ رَسولُ",8,"ل",1,0],["شرَوا بتلك النفوس يوما","يُغلِي به بائعُ الجِنانِ",9,"ن",1,0],["شُروقُ بغربِيِّ اللِّوا لألأَتْ لنا","فشِمْنا رَبيعاً بالرَّشَاشِ مُنَمْنَما",10,"م",2,1],["شَروْا حلماً لو استفتيتَ فيهِ","الشياطينَ لقالتْ ذاك شرُّ",11,"ر",1,0],["شروْا أمساً على خدّيهِ ظلّت","معالمُ كفِّ أمسِهمُ الأغرُّ",11,"ر",1,0],["شروى خلف ما ريت مثله حدّي","لي بالكرم ماله قياس وحدّي",12,"ي",1,0],["شروات من يتبع بروقٍ دونها","صيفٍ ولا منها يضول ضويل",13,"ل",1,0],["شرود فيما يدني المنامُ خياله","وهيهات أن تُبقي الملامَ بلابله",14,"ل",2,0],["شَرُودٌ يَرى قَوْلَ النَّصُوحِ إِسَاءَةً","خَفِ اللهَ فِي قَتْلِ الْمُحِبِّينَ يَا رَشَا",15,"ش",2,0],["شروحهن انشراح للصدور وفي","متونهن جلاء الشك والريب",16,"ب",1,0],["شَرَوْا بِأروَاحهم فِي اللَّهِ جَنَّتَهُ","فَاسْتَوْجَبُوا ربحَ اخلاص بِإغْلاَءِ",17,"ا",2,0],["شروا بأنفسهم في الله جنته","فاستوجبوا الفوز لما إن رضوا التلفا",18,"ف",2,0],["شرٌّ وآخره دنيا موَلِّيَةٌ","لبئس ما منعوا لو أنهم علموا",19,"م",3,0],["شروا من ليس ذا جد وجد","وباعوا من له عضد وباع",20,"ع",1,0],["شَروب بماضي الشفرتين دمَ العِدى","وأجسامَهم بالسمهريَّة آكل",21,"ل",1,0],["شروات رمّايٍ مدرّب","حرّيف فِيْ التصويب حسْاس",22,"س",1,0],["شَروبٌ لِماءِ اللَحمِ في كُلِّ صَيفَةٍ","وَإِن لَم تَجِد مَن يُنزَلُ الدَرَّ تَحلُبِ",23,"ب",1,0],["شُرُوداً لا يَليقُ بِها مَكانٌ","كَما شَرَد الأَقَبُّ الأَخدَرِيُّ",24,"ي",1,0],["شَرَوهُ فَاِبتاعَهُ مِن بَعدِ ما اِرتَعَدَت","عَنهُ التِجارُ لِطولِ السَومِ وَالثَمَنِ",25,"ن",1,0],["شروات لون الشَنّ خِلِّيت","لي عَقّه البادي بالآمراح",26,"ح",1,0],["شروى المها زوله تهاييت","ظبي الفلا لي وَسط الآبطاح",26,"ح",1,0],["شرودٌ كلّما أدنوا إليه","تباعدَ مثلَ نومِ المُستهام",27,"م",1,0],["شروى الزَمان يَضيء صبح مُسفر","فيهِ فَيشفعه ظَلام اَسفَع",28,"ع",1,0],["شرورٌ يحار العقل في كيف انها","أتت مدنيات من الغرب لا أدري",29,"ر",2,0],["شروط الاقتداء في الصلاة","بمن يؤم الناس كالولاة",30,"ه",1,0],["شَرَوْا سفهاً بالثعلب الليثَ، واشتَرَوْا","بصَرْصَرة البازي صَريرَ الجناديب",31,"ب",1,0],["شروان منها نقجوان يحدها","جبل على بلقيس والكرخية",32,"ه",1,0],["شروب الغديات وقت الضحى","طروب العشيات نشوانها",33,"ن",3,0],["شروط العلم أربعة","فأولها التفرغ له",34,"ل",2,0],["شَروا بِالنَدى وَالجود مَجداً مُخلداً","فَما تَرَكوا شَرطاً وَلا وَجَدوا غبنا",35,"ن",2,0],["شرودة عَن بقاع الماء مائلة","عَن الكلاء فَلا يلغى لَها دار",36,"ر",1,0],["شروب لما يجري على الارض من دم","وآخر من لحم الكماة أكول",37,"ل",1,0],["شَرْوى نِسايِمْ يبل «لِبْنان»","يا اللّي هَل الدنيا هذوا به",38,"ب",2,0],["شروقُ جبين المصطفى أوضح الهدى","فمالكَ يا بطَّال غشاك ما غشا",39,"ش",2,0],["شروعاً هداكَ اللّهُ في زورةٍ إلى","نبيّك إن العمرَ عنك قد انفشا",39,"ش",2,0],["شرودُك عن أهليك في اللّه هجرة","وإن عتاق الطير لا تألف العُشا",39,"ش",2,0],["شروراً فاستحالتْ لي سرورا","همُ شَبّوا الحروبَ عليّ ظلماً",40,"ا",1,0],["شروا بحدود البيض في سوق كربلا","ملابس عز لن نبيد ومفخرا",41,"ر",2,0],["شَروَانُ او جَفَّالُ كُلٌّ منهما","بالبأسِ ليثُ الغاب واللِين الحَمَل",42,"ل",1,0],["شَرَوى شَبيهَينِ مَكروباً كُعوبُهُما","في الجَنبَتَينِ وَغى الأَطرافِ تَأسيلُ",43,"ل",1,0],["شروط الوفى ترعى لدينا وعهدنا","وثيق كلانا لا يخون ولا يرشى",44,"ش",2,0],["شروني على علم بأبخس قيمة","وللحبّ نقد للمحبين باخِس",45,"س",1,0],["شروا بذاك الفدا أمنا لأنفسهم","والأمن طورا ببذل المال يكتسب",46,"ب",1,0],["شرود القوافي لم تطع كف لامس","فما برحت خلف الحجاب حصانا",47,"ن",2,0],["شروا الضلالة بالرشاد وذاك من","فقد البصائر لأعمى الأبصار",48,"ر",1,0],["شروا الضلالة بالهدى عمدا ومن","غالي الشريعة أرخصوا الأسعارا",49,"ر",2,0],["شرواك يا غوث البرية قابل","جهد المقلّ إذا به لم يبخل",50,"ل",1,0],["شروى شبيب التبعي واليتومي","كنّه نقل هوياه في بطن تومي",51,"ي",1,0],["شُرُودٌ إلى اللَّا شَيء.. جَفنٌ مُقَيَّدٌ","فؤادٌ على الأشلاءِ يَطفُو ويُوطَأُ",52,"ا",1,0],["شَرٌّ وأعمَلَ في بلادي نابَهُ","قتلاَ وتفجيراَ وأحلامي ذَبَح",53,"ح",1,0],["شرواك يانايف كما السيف ينسل","في وجه من صحبة رفيقه نكرها",54,"ر",3,0],["شُرورٌ تَوارتْ بأرضِ انْدثارٍ","وللخيرِ حظٌ بكونٍ فَسوحِ",55,"ح",1,0],["شرور نفسك باعدها تصب رشدا","فمن يطع ربه والمصطفى رشدا",56,"د",2,0],["شُروقُكِ فيَّ يُرجِعُني جَنينا","فمن أيِّ المشارقِ تَشرُقينا",57,"ن",2,1],["شرود الوداد على قربه","يفرق منه الذي أجمع",58,"ع",1,0],["شروى القمر فوق الكواكب تعليت","كل شهد في حكمة الخالق وقدراته",59,"ت",2,0],["شُرودٌ بُرودٌ كَفِيف الْخُطىَ","ذبول وعرى وخفض الجبين",60,"ن",1,0],["شرواك يالنايف زبون الونيات","وجبال صمى والحصون الحصوووني",61,"ن",2,0],["شروقٌ وغيمات القلوب سواكبٌ","وأزهار إحسانٍ أيادٍ شوابكُ",62,"ك",1,0],["شروقٌ وافر الأضوا","ء لا غمٌ ولا بُهمة",63,"م",2,0],["شروقا يشعُ القلب لله شاكرا","وعند غروب الشمس حمدا يُسبّحُ",64,"ح",1,0],["شروا ضمائرَهُم واستسلموا زُمرا","مدّوا يدَ الذلِّ للعدوانِ والهربا",65,"ب",2,0],["شرواك وامثالك نخلي عقدها","فرصه ونبغاها بعد قفلة الباب",66,"ب",1,0],["شُرُورُ فَرَنْسَا لَا تُفَارِقُنَا الْمَدَى","وَ قَدْ صَوَّرَ التّارِيخُ أَقْسَى الْمَشَاهِدِ",67,"د",1,0]]}