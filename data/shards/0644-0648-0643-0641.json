{"poems":[[45,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[63,"أ أقحوانا أرته أم بردا","https://www.aldiwan.net/poem51719.html","المنسرح"],[33,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54924","الكامل"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56324","السريع"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77090","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52194","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52146","الكامل"]],"verses":[["لَو كَفَرَ العالَمونَ نِعمَتُهُ","لَما عَدَت نَفسُهُ سَجاياها",0,"ا",3,0],["لو كَفَّ يومَ الفِراقِ أمعَنا الصَ","بْرُ كُفِينا المَلامَ والفَنَدا",1,"د",2,0],["لَو كَفِّيَ اليُمنى سَأَتكِ قَطَعتُها","وَلَذُقتُ بَعدَ رِضاكِ عَيشَ الأَجذَمِ",2,"م",1,0],["لَوْ كَفَّ هَذَا الدَّهْرُ عَنِّي غَرْبَهُ","وَرَثَى لِحَالِ العَاشِقِ المَهْجُورِ",3,"ر",1,0],["لو كفّنوه بأحلام الربيع غدت","أكفانه في هيام الظامىء الصادي",4,"ي",1,0],["لو كفّ عن فتكِ كايب شكا","لكنت طول الدهر مملوكهُ",5,"ه",1,0],["لَو كَفَّ كَفَّ المَزنُ تَل","قى كَفَّهُ طَبعاً يَجود",6,"د",1,0],["لو كفَّنوك بها غُنيت بِطيبها","عن رائعاتِ الطّيب في الأكفانِ",7,"ن",1,0],["لو كفًّنوك بها غَنِتَ بطِيبها","عن راتعات الطيب في الأكفانِ",8,"ن",1,0]]}