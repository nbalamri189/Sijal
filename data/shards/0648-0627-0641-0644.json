{"poems":[[55,"وأفلتهن أبو عامر","https://www.aldiwan.net/poem30212.html","المتقارب"],[9,"فدى لبني ذهل ابن شيبان ناقتي","https://www.aldiwan.net/poem21917.html","الطويل"],[0,"ألا يا لهف هند إثر قوم","https://www.aldiwan.net/poem72.html","الوافر"],[23,"لقد ورث الضلالة عن أبيه","https://www.aldiwan.net/poem21319.html","الوافر"],[23,"قتلنا أميا يوم بدر عنوة","https://www.aldiwan.net/poem21502.html","الطويل"],[23,"فدى لبني النجار أمي وخالتي","https://www.aldiwan.net/poem21509.html","الطويل"],[74,"مضى بالصبا إيري الذي كنت داعيا","https://www.aldiwan.net/poem18295.html","الطويل"],[31,"ألم تشكر لنا كلب بأنا","https://www.aldiwan.net/poem6185.html","الوافر"],[87,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[47,"لدن هجرته زحزحته عن الصبر","https://www.aldiwan.net/poem63642.html","الطويل"],[47,"أبالمنحنى أم بالعقيق أم الجرف","https://www.aldiwan.net/poem65157.html","الكامل"],[30,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[30,"وأفلت دجال النفاق وما نجا","https://www.aldiwan.net/poem5107.html","الطويل"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[52,"لعمري لئن أصبحت فوق مشذب","https://www.aldiwan.net/poem62379.html","الطويل"],[52,"تخليت من صفراء لا بل تخلت","https://www.aldiwan.net/poem64748.html","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1934","الوافر"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[133,"تفتحت أعين الدراري","https://www.aldiwan.net/poem67442.html","مخلع البسيط"],[169,"ألا سائل النعمان إن كنت سائلا","https://www.aldiwan.net/poem725.html",""],[254,"وأفلت حاجب فوت العوالي","https://www.aldiwan.net/poem2086.html","الوافر"],[254,"تغيرت المنازل بالكثيب","https://www.aldiwan.net/poem2130.html","الوافر"],[275,"أعيناك حينا ترنوان إلى الزهر","https://www.aldiwan.net/poem35619.html","الطويل"],[303,"أبى رق الحياة فمات حرا","https://www.aldiwan.net/poem36809.html","عموديه"],[305,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[324,"وافلتهن المسحلان وقد رأى","https://www.aldiwan.net/poem23898.html","الطويل"],[395,"ألم تر أن جيرتنا استقلوا","https://www.aldiwan.net/poem1927.html","الرمل"],[418,"ألا أبلغ بني العجلان عني","https://www.aldiwan.net/poem40.html","الوافر"],[445,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[463,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[541,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[563,"لنا طالع الغيب المقدس يا سعد","https://www.aldiwan.net/poem34624.html","الطويل"],[580,"جلست ببستان الجليس وداره","https://www.aldiwan.net/poem2724.html","الطويل"],[580,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59126","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203795","البسيط"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117697","الطويل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20582","الخفيف"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144585","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67362","الطويل"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109569","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93659","البسيط"],[2612,"","https://poetry.dctabudhabi.ae/diwan/poem/31523","الطويل"],[2637,"","https://poetry.dctabudhabi.ae/diwan/poem/22608","الطويل"],[2637,"","https://poetry.dctabudhabi.ae/diwan/poem/22609","الطويل"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101948","الطويل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9617","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26145","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66488","الوافر"],[3681,"","https://poetry.dctabudhabi.ae/diwan/poem/80151","الوافر"],[3711,"","https://poetry.dctabudhabi.ae/diwan/poem/31525","الوافر"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2565","الوافر"],[4161,"","https://poetry.dctabudhabi.ae/diwan/poem/198371","الوافر"],[4422,"","https://poetry.dctabudhabi.ae/diwan/poem/116629","الوافر"],[4767,"خير الناس","https://www.poetsgate.com/ViewPoem.aspx?id=179651",""],[4778,"بلغ الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=196620",""],[4927,"أَحْلاْمُ الْعِشْق","https://www.poetsgate.com/ViewPoem.aspx?id=29948",""],[5282,"أخلاق العصافير","https://www.poetsgate.com/ViewPoem.aspx?id=215125",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5829,"وإن طاوعتني في الحبِّ أبشر","https://www.poetsgate.com/ViewPoem.aspx?id=178392",""],[6031,"أَمَوْلَى الوَرَى إنِّي جَعلْتُكَ في الذِي","https://www.poetsgate.com/ViewPoem.aspx?id=46412",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["وَأَفلَتَهُنَّ أَبو عامِرٍ","يُقَبِّلُ ناصِيَةَ الأَشقَرِ",0,"ر",1,1],["وَأَفلَتَهُم قَيسٌ فَقُلتُ لَعَلَّهُ","يَبِلُّ لَئِن كانَت بِهِ النَعلُ زَلَّتِ",1,"ت",1,0],["وَأَفلَتَهُنَّ عِلباءٌ جَريض","وَلَو أَدرَكنَهُ صَفِرَ الوِطابُ",2,"ب",1,0],["وَأَفلَتَ حارِثٌ لِما شُغِلنا","بِأَسرِ القَومِ أُسرَتِهِ قَليلُ",3,"ل",1,0],["وَأَفلَتَ مِنّا بَعدَما طالَ يَومُهُ","أُبَيٌّ عَلى مَوّارَةِ الضَبعِ جَلعَدِ",4,"د",1,0],["وَأَفلَتَ يَومَ الرَوعِ أَوسُ بنُ خالِدٍ","يَمَجُّ دَماً كَالرَعثِ مُختَضِبَ النَحرِ",5,"ر",1,0],["وأفلستُ مع هذا المصابِ فيا لها","رزيةُ مالٍ أو فراقُ حبيب",6,"ب",1,0],["وَأَفلَتَ حاتِمٌ بِفُلولِ قَيسٍ","إِلى القاطولِ وَاِنتَهَكَ الفِرارا",7,"ر",2,0],["وافٍ لِجارَةِ بَيتِهِ يَرعى لَها","عَهدَ السَمَوأَلِ عُروَةٌ وَحِبالا",8,"ل",2,0],["وَأَفلَتَ مِنّا عامِرٌ كَبشُ عامِرٍ","كَحَبَّةِ بُرٍّ مِن دُقاقِ رَحى البُرِّ",9,"ر",1,0],["وَأَفلَجَ بَرّاقٍ يَروحُ رُضابُهُ","حَراماً عَلى التَقبيلِ بَسلاً عَلى الرَشفِ",10,"ف",1,0],["وَأَفلَتَ رَوّاضُ البِغالِ وَلَم تَدَع","لَهُ الخَيلِ مِن إِخراجِ زَوجَيهِ مَعشَرا",11,"ر",2,0],["وَأَفلَتَ دَجّالُ النِفاقِ وَما نَجا","عَطِيَّةُ إِلّا أَنَّهُ كانَ أَمهَرا",12,"ر",2,1],["وَأَفلَتَ حَوّاكُ اليَمانينَ بَعدَما","رَأى الخَيلَ تَردي مِن كُميتٍ وَأَشقَرا",12,"ر",2,0],["وَأَفلَجَهُم في كُلِّ يَومِ كَريهَةٍ","كِرامُ الفُحولِ وَاِعتِيامُ الحَواصِنِ",13,"ن",1,0],["وَأَفلَتَّ مِن ضيقِ التُرابِ وَغَمِّهِ","وَلَم تَفقُدِ الدُنيا فَهَل لَكَ مِن شُكرِ",14,"ر",1,0],["وَأَفلَتَ يَمري ذاتَ عَقبٍ كَأَنَّها","حُذارِيَّةٌ مِن رَأسِ نيقٍ تَدَلَّتِ",15,"ت",1,0],["وَأَفلَتَهُنَّ عِلباءٌ جَريضاً","وَلَو أَدرَكنَهُ صَفِرَ الوِطابُ",16,"ب",1,0],["وأفلح بالتوفيق قوم نصيبهم","من العلم في رأي العيون حقير",17,"ر",1,0],["وأَفلَتَ الحُلمُ من عِقالٍ","فَطارَ يَسعى إلى الجَمالِ",18,"ل",1,0],["وأفلت عبد الله مني بذعرة","وعروة من بعد ابن جعدة شاهدي",19,"د",2,0],["وَأَفلَتَ حاجِبٌ فَوتَ العَوالي","عَلى شَقّاءَ تَلمَعُ في السَرابِ",20,"ب",1,1],["وَأَفلَتَ حاجِبٌ تَحتَ العَوالي","عَلى مِثلِ المُوَلَّعَةِ الطَلوبِ",21,"ب",1,0],["وأفلاذُ قلبي والدّموعُ تناثرت","كريشات عصفورٍ على مَدخلِ الوكر",22,"ر",1,0],["وأُفٍ للأولى ظلموا وجاروا","وآلوا أن يسودوا الناسَ قهرا",23,"ر",2,0],["وَأَفلَتُّ مِن أُخرى تَقاصَرَ طَيرُها","عَشِيَّةَ أَدعو بِالسَتّارِ المُجَبِّرا",24,"ر",2,0],["وَافلتهُنَّ المُسحَلانِ وَقَد رَأى","بِعَينَيهِ نَقعاً ساطِعاً قَد تَكَوثَرا",25,"ر",2,1],["وَأَفلَتَنا اِبنُ قُرّانٍ جَريضاً","تَمُرُّ بِهِ مُساعِفَةٌ حَروقُ",26,"ق",1,0],["وأفلَتَنَا بَنُو شَكَلٍ رِجَال","حُفاةً يَربَؤُونَ عَلَى سُمَيرِ",27,"ر",1,0],["وأَفلاذُ الفؤادِ أَمَضُّ قَرْحاً","إِذَا رَمَتِ العيونَ بما تُساءُ",28,"ا",2,0],["وأفلاؤها ومساقيطُها","تَقامَصُ فيها قَلُوصاً وبَكْرا",29,"ر",2,0],["وأفلاك أدوار الدوائر لم تزل","عليه فصول الحوليات مراعيه",30,"ي",2,0],["وَأَفلَحَ مَن قَد كانَ لِلَّهِ طائِعاً","فَخَفَّ إِلى أَمرِ الإِلهِ وَشَمَّرا",31,"ر",2,0],["وأفلاكنا دارت على حكم ربنا","بما يقتضيه الحظ والعيشة الرغد",32,"د",1,0],["وأفلس طرفي حين أنفق دمعه","فأجرى فَمِي دَمْعاً يُسَمُّونَه شِعْرا",33,"ر",2,0],["وأَفْلُو كما شاء السُّرى لممَ الفلا","بأَدهم ريَّانٍ من الزُّهْرِ ملآنِ",34,"ن",1,0],["وَأفْلِ بِأيْدِي العِيس نَاصِيَةَ الفَلاَ","فَقَدْ صَارَ مِنْ خَطْوٍ لأرْجُلِها مشطُ",35,"ط",1,0],["وأفلت القيد من أقدامنا وهوى","على جماجمهم ناراً وقطرانا",36,"ن",2,0],["وأفلاكُ لذاتي تعطلَ سيرُها","وهل فلكٌ يسري إذ عدمَ القطبُ",37,"ب",1,0],["وَأَفلَتنا مِنهُمُ رِجالٌ فَأَسرَعوا","فَلَيتَهُمُ عاجوا وَلَم نَتَعَجَّل",38,"ل",1,0],["وأفلاذُ أكبادٍ من الفضل فُتِّشَتْ","فُدلَّ على تفتيتها زَفَراتُها",39,"ت",3,0],["وَأفْلَتَنَا تَحْتَ الأسِنَّةِ مَرْثَدٌ","وَكَانَ قَدِيمَاً فِي الفِرَارِ مُجَرِّبَا",40,"ب",2,0],["وأفلتَ السيف منهم كل ذي أسف","على الحمام حماه آجل الأجل",41,"ل",1,0],["وأفلست من نقد اصطباري وقد غدا","فقير اشتياقي يرتجي منكم عطا",42,"ط",2,0],["وَأفلحت أَنيقٌ أمَّ الحداة بِها","أَبا سَعيد لتستسقي الحَيا النطفا",43,"ف",2,0],["وَأَفلَتَ مِنهُ سالِمٌ بَعدَ كُربَةٍ","وَفي ثَوبِ حَقوَيهِ دَمٌ يَتَصَبَّبُ",44,"ب",1,0],["وَأَفلَتنا تَحتَ الحَجاجَةِ جابِرٌ","وَفيهِ سِنانٌ لَهذَمِيُّ عَلى نَهدِ",45,"د",1,0],["وَأَفلَتنا تَحتَ العَجاجَةِ جابِرٌ","وَعَمرٌو أَخوهُ رَهنُ غَلٍ عَقيلِ",46,"ل",1,0],["وأفلاكها فيك استدارت بروجها","وسارت بها شمس وسار بها بدر",47,"ر",1,0],["وَأَفلَتَ مِنّا الحَوفَزانُ كَأَنَّهُ","بِرَهوَةَ قَرنٌ أَفلَتَ الخَيلَ أَعضَبُ",48,"ب",1,0],["وَأَفلَتَنا أَبو لَيلى طُفَيلٌ","صَحيحَ الجلدِ مِن أَثَرِ السِلاحِ",49,"ح",1,0],["وأفلتَ منها الحَوفَزانُ برجلهِ","شِكال أُمِرَّ الفتك منه على شَزْرِ",50,"ر",1,0],["وأفلتَ نَقْفورٌ يُرَقِّعُ جِلْدَه","وفيهِ لآثارِ السِّلاحِ خُروقُ",51,"ق",1,0],["وأفلق فيه هامة كل كبشٍ","ولا أخشى الملامة في البلايا",52,"ا",3,0],["وأفَلتنَا هَجينُ بني سُلَيْمٍ","يفَدِّى المُهْرَ من حُبِّ الأِيابِ",53,"ب",1,0],["وَأَفلَتَ سالِمٌ مِنهُ جَريضاً","وَقَد كَلَمَ الذُؤابَةَ وَالذِراعا",54,"ع",2,0],["وَأَفلَتَنا عَلى الحَومانِ قَيسٌ","وَأَسلَمَ عِرسَهُ ثُمَّ اِستَقاما",55,"م",2,0],["وأفلتنا أبو ليل طفيل","صحيح الجلد من أثر السلاح",56,"ح",1,0],["وأفلَتَنَا بَنُو شَكَلٍ رِجَالاً","حُفاةً يَربَؤُونَ عَلَى سُمَيرِ",57,"ر",1,0],["وأفلاكُ السَّما شعَّتْ ضِياءً","تقولُ اسْتقبِلوا بدرَ البدورِ",58,"ر",1,0],["وأفلح كل من يَقْفُ خطاه","ينال شفاعةً ويلٌ تقيه",59,"ي",2,0],["وَأُفْلِحُ فِيْ حِفْظِ الْمَوَدَّةِº وَالْوَفَاْ","وَتَنْعُمُ بِالْحُبِّ الْعَفِيْفِº وَتُفْلِحُ",60,"ح",1,0],["وَافٍ لخلٍ مُخْلِصٍ في حُبِّهِ","هَل تَسْتَقِيمُ حَياتُنا مِنْ غَيرِ صَاحْ",61,"ح",1,0],["وأفلس العُربُ في ميزانِ عالمِنا","مُذْ فرّقوا صوتَهم كِبراً وأضغانا",62,"ن",2,0],["وافلاك الثريا مذ رأتها","تخَّفت. لم تعد في الليل تقمر",63,"ر",1,0],["وأَفْلاذُ أكْبَادٍ تَذُوبُ عَليهِمُ","ورَاءَ دُمُوعِي قِطْعةٌ من فُؤَادِيَا",64,"ي",2,0],["وَأَفلَسَت بَعدَ إِقبالٍ جَهَنَّمُهُم","وَلَم تَجِد حَطَباً في الأَشهُرِ الحُرُمِ",65,"م",1,0]]}