{"poems":[[87,"يا عزيزا يسعى لعز الرعايا","https://www.aldiwan.net/poem7363.html","الخفيف"],[107,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[107,"ربنا إنا اهتدينا","https://www.aldiwan.net/poem42083.html","مجزوء الرمل"],[69,"نم هنيئا محمد بن علي","https://www.aldiwan.net/poem18147.html","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[101,"النساء والمسافات","https://www.poetsgate.com/ViewPoem.aspx?id=36380",""],[101,"قطرة الندى","https://www.poetsgate.com/ViewPoem.aspx?id=570",""],[101,"إمرأة مِنْ دُخَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68837&r=&rc=389",""],[159,"كن بعيدا إن شئت أو كن قريبا","https://www.aldiwan.net/poem55765.html","الخفيف"],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[285,"أنت للمسلمين حصن وحرز","https://www.aldiwan.net/poem60691.html","الخفيف"],[580,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120073","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119981","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204984","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204450","الخفيف"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130442","الرمل"],[4691,"~ حَدِّثِينِي عَن ِ الْهَوَى فِي الْمَسَاْءِ ~","https://www.poetsgate.com/ViewPoem.aspx?id=61998",""],[5232,"إلى شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=213608",""],[5411,"عَوَّدْتُ عَيْني","https://www.poetsgate.com/ViewPoem.aspx?id=200581",""],[5721,"لم أعد حتى بنفسي مؤمنا","https://www.poetsgate.com/ViewPoem.aspx?id=214510",""],[5818,"اعلمي","https://www.poetsgate.com/ViewPoem.aspx?id=182814",""],[5956,"وجهك المنحوس","https://www.poetsgate.com/ViewPoem.aspx?id=193525",""],[5977,"إلى فلذة الكبد","https://www.poetsgate.com/ViewPoem.aspx?id=213284",""],[6102,"حسب الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=183652",""]],"verses":[["أنت أحييتها وشاهد صدق","بالنوايا الحسان هذا الأساس",0,"س",1,0],["أنتَ احتملتَ الأمرَ تَنصدِعُ القُوى","ممّا يَشُقُّ على النُّفوسِ وتَصعَقُ",1,"ق",1,0],["أَنتَ أَحْسَنْتَ إلينا","بالرّجالِ المُحسِنينْ",2,"ن",1,0],["أَنْتَ أَحْسَنْتَ في الحَياةِ إلَيْنَا","أَحْسَنَ اللهُ في المَمَاتِ إلَيْكا",3,"ك",2,0],["أنت أحييته تراثاً على الده","ر فعش في تراثه الأبديّ",4,"ي",1,0],["أنت أحلى - تأكدي أنت أحلى","حين في عالم الرؤى ألتقيك",5,"ك",1,0],["أنت أحلى خرافه في حياتي","والذي يتبع الخرافات يتعب",6,"ب",1,0],["أنت أحلى ممنوعةَ الطيفَ ، خجلى","يتمنَّى مُرُوركِ .. الياسمينُ",7,"ن",1,0],["أَنتَ أَحببتَ أَن أَكونَ سقيماً","فلحبّيكَ صارَ عندي حبيبا",8,"ب",2,0],["أَنتَ أَحيَيتَ رِمَّةَ العَدلِ وَالجو","دِ وَأَنشَرتَها مِنَ الأَرماسِ",9,"س",1,0],["أَنْتَ أَحْمَيْتَ مَشْرَبِي وَهْوَ مَطْرُو","قٌ وَأَغْزَرْتَ مَطْلَبِي وَهْوَ نَزُّ",10,"ز",1,0],["أَنت أَحيَيْتَه وقد كان مَيْتاً","ثم أَعتقتَه وقد كان قِنَّا",11,"ن",2,0],["أنت أحسنت في خصوصك فامتد","دَ وعاد الخصوص وهو عموم",12,"م",1,0],["أنت إحيا من نرى وج","ها وأندى بطن راح",13,"ح",1,0],["أنت أحسَبتَني بسيب عطاء","منك ما كان بعضه في حسابي",14,"ب",2,0],["أنت أحييت سيرة الاولياء","بالفدا تقتدين بالأنبياء",15,"ا",2,1],["أنت أحلى من الحياة ولكن","شوهتك الحياة للنظار",16,"ر",1,0],["أنت أحلى في فؤادي","من دنو بعد بعد",17,"د",1,0],["أنت أحلامي السابحات بقلبي","داعبيني وأسرفي في اعتنائي",18,"ا",3,0],["أنتِ إحساسٌ،وقلبٌ خافقٌ","وصفاءٌ لستُ أدري ما مداهْ",19,"ا",2,0],["أنْتَ احْتَضَرْتَ مِنَ المَنْفَى فَكيْفَ أنا !!","وَكَيْف كَيْفَ سَيَرْوي الحبُّ إخْفاقَهْ",20,"ق",2,0],["أَنْتِ أَحْبَبْتِ قَصِيداً نَاضِجاً","لَمْ تُحِبِّي الشَّاعِرَ المُفْتَتِنَا",21,"ن",2,0],["أنتِ أحلى البلادِ عيناكِ حبٌّ","يعرفُ الحب َّ مَنْ أضاعَ بلادَهْ",22,"د",2,0],["أنت احتللتَ مكانهُ","هو واقفٌ يا مُقعَدُ",23,"د",1,0],["أنت إحساسٌ جميلٌ أنت لي","يشفي فؤادي المتعبا",24,"ب",2,0],["أَنتِ احْتِلَالُ الرُّوحِ - عُمْقَ حَشَاشَتِي -","وَ الغَدْرُ مِنْكِ شَرِيعَةٌ وَ الطَّعْنُ سُنَّهْ",25,"ن",2,0]]}