{"poems":[[77,"ما ثم إلا ما رأيت","https://www.aldiwan.net/poem36090.html","مجزوء الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[124,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[135,"الصبر ليس على فراقك يحسن","https://www.aldiwan.net/poem49163.html","الكامل"],[427,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"]],"verses":[["هَلْ ثَمَّ شَكٌّ فِي الْمَعَا","دِ الْحَقِّ أَوْ يَوْمِ الْقِيَامَهْ",0,"م",2,0],["هل ثار فيه من الثوابت مبرك","أم عىَّ سيَّار به سراء",1,"ا",2,0],["هل ثَمَّ معتصم ثانٍ نُهيبُ بهِ؟","نادُوه، يا أهل يافَا، جَهْرةً، نادوا",2,"د",3,0],["هل ثغر ليماسول أقرب","عندهم منه الحجون",3,"ن",1,0],["هل ثَمَّ عينٌ لم تجد بدموعها","لهفاً عليك ومقلةٌ لا تحزن",4,"ن",1,0],["هل ثار حين رأى قيدا يكبله","على الثرى فتمشت فيه نيران",5,"ن",1,0],["هَل ثَمَنُ الأَرضِ بِالطَعامِ مُمتَنِعٌ","أَم لا أَمن هُوَ في العُلومِ قَد مَهَرا",6,"ر",2,0]]}