{"poems":[[79,"ما ثم إلا ما رأيت","https://www.aldiwan.net/poem36090.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[139,"الصبر ليس على فراقك يحسن","https://www.aldiwan.net/poem49163.html","الكامل"],[433,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56582","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112934","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93450","الكامل"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126513","البسيط"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120184","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83370","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139658",""],[4755,"ماذا عَنِ الحُبِّ –قالت مُهْرَةٌ- ودَنَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=184816",""],[4836,"أمى","https://www.poetsgate.com/ViewPoem.aspx?id=203611",""],[4929,"مليكة اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=201110",""],[5431,"متكوران كمنحنٍ في منحنى!...","https://www.poetsgate.com/ViewPoem.aspx?id=200315",""],[5431,"ماكان أعجلها لتتركه!في برزخٍ والحلم يبطئه","https://www.poetsgate.com/ViewPoem.aspx?id=201659",""],[5431,"ثورة السودان (3)","https://www.poetsgate.com/ViewPoem.aspx?id=202088",""],[5431,"تبارك الله أحسن الخالقين...","https://www.poetsgate.com/ViewPoem.aspx?id=203151",""],[5776,"سُتّون كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=199824",""],[5881,"تلقاء مدين","https://www.poetsgate.com/ViewPoem.aspx?id=184317",""],[6251,"مجرات النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76487&r=&rc=27",""]],"verses":[["هَلْ ثَمَّ شَكٌّ فِي الْمَعَا","دِ الْحَقِّ أَوْ يَوْمِ الْقِيَامَهْ",0,"م",2,0],["هل ثار فيه من الثوابت مبرك","أم عىَّ سيَّار به سراء",1,"ا",2,0],["هل ثَمَّ معتصم ثانٍ نُهيبُ بهِ؟","نادُوه، يا أهل يافَا، جَهْرةً، نادوا",2,"د",3,0],["هل ثغر ليماسول أقرب","عندهم منه الحجون",3,"ن",1,0],["هل ثَمَّ عينٌ لم تجد بدموعها","لهفاً عليك ومقلةٌ لا تحزن",4,"ن",1,0],["هل ثار حين رأى قيدا يكبله","على الثرى فتمشت فيه نيران",5,"ن",1,0],["هَل ثَمَنُ الأَرضِ بِالطَعامِ مُمتَنِعٌ","أَم لا أَمن هُوَ في العُلومِ قَد مَهَرا",6,"ر",2,0],["هل ثامر الغصن يستصبي وزاهرهُ","إن لم تعش بك أثمار وأزهار",7,"ر",1,0],["هل ثم باب للنبي سواكم","أنتم بنوه واهله وبطانته",8,"ت",2,0],["هَل ثَمَّ شَيءٌ غَيرَ رَأيٍ أو كَلاَ","مٍ بَاطِلٍ أو مَنطِقِ اليُونَانِ",9,"ن",1,0],["هل ثم شيء غير ذا فيكون أف","ضل منه نسأله من المنان",9,"ن",1,0],["هَل ثمَّ إِلا المَوتُ فر","داً لا تَكونُ مَنيَّتانِ",10,"ن",1,0],["هل ثم غير السنا بانت مظاهره","ما ثم الا الثنا للحق اذ شرطا",11,"ط",2,0],["هل ثم غير أبى الوفاء لكشف ما","قد حل بى من جوره ودهانى",12,"ن",2,0],["هَل ثمَّ مهما تذكري نِعمَةً","كَنِعمَة الإيمانِ يا ذاكِره",13,"ر",2,0],["هل ثالثٌ للنيرين وثالثٌ","للفرقدين مدى المدى وابوده",14,"د",2,0],["هَل ثَمَّ لِلحُبِّ مِن بابٍ لِأطرُقَهُ؟","الحُبُّ ما زالَ حُلْمًا دَربُهُ وَعِرُ",15,"ر",1,0],["هل ثمَّ أعجب من مقالة غافل","سيَّان قلبٌ يكتوى ومُجَوَّفُ",16,"ف",1,0],["هل ثَمَّ غيرُك للصَّدارةِ موضعٌ","بين اللغاتِ أو المقامُ السامي !!",17,"م",2,0],["هل ثغرك الولهان يعزف للهوى","أم ثغري الهيمان يرشفُ دمعنا ؟!!",18,"ن",2,0],["هل ثمَّ للعشاق معجزة","من نفحةٍ نشوى تبرّئُه !!",19,"ا",2,0],["هل ثمّ لومٌ باقتراحك","علقما في كأس راح؟",20,"ح",1,0],["هل ثمّ فعلٌ ماجنٌ","في جزّ أعناقٍ صحاح؟؟",20,"ح",1,0],["هل ثمّ في التخزين ذاكرةٌ","للماء للبشرى وللخُضرة؟!!",21,"ر",2,0],["هل ثمّ قلبٌ لا يراهم صُرّعوا","بيدِ المنايا ثمّ لن يتأثرا",22,"ر",2,0],["هل ثم ضوء ٌ لا يجانس بقعتي","ذاك السؤال يلوذ بالتأجيل",23,"ل",1,0],["هَلْ ثَمَّ سِرٌّ وَرَاءَ الغَيْبِ يَأْسِرُنَا","فِيْ فِتْنَةٍ مِلءَ هَذَا الكَوْنِ تُسْكِرُنَا؟",24,"ن",2,0]]}