],[498,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[504,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[513,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[527,"متى أرى الحق يصفو من تكدره","https://www.aldiwan.net/poem37242.html","البسيط"],[534,"تولى الجود وانقرض الكرام","https://www.aldiwan.net/poem23847.html","الوافر"],[534,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[542,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[551,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[551,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[556,"كتاب الله جامع كل شيء","https://www.aldiwan.net/poem34669.html","الوافر"],[556,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[565,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[585,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَسِناني بِالدارِعينِ خَبيرٌ","فَاِسأَليهِ عَمّا تَكونُ القُلوبُ",0,"ب",1,0],["وَسُنَّةُ إِبْرَاهِيمَ فِي الْفَخْرِ قَدْ أَتَتْ","بِكُلِّ صَحِيحٍ عَنْ عَلِيٍّ وَعُثْمَانِ",1,"ن",1,0],["وَسَنَّ قَومُ الطَيشِ مِن جَهلِهِم","كِذبَةَ إِبريلَ لِأُكتوبَرِ",2,"ر",1,0],["وَسَنَّ لَكُم حُرِّيَّةَ القَولِ عِندَما","رَأى القَولَ في أَسرِ السُكوتِ مُقَيَّدا",3,"د",2,0],["وَسَنا جَبينٍ يَستَطيرُ شُعاعُهُ","يُغني عَنِ القَمَرَينِ مَن يَتَوَسَّمُ",4,"م",1,0],["وَسِنٍّ كَسُنَّيقٍ سَناءً وَسُنَّم","ذَعَرتُ بِمِدلاجِ الهَجيرِ نَهوضِ",5,"ض",1,0],["وسنان ينشدُ سحرُ مقلتهِ","أجفانَ عاشقهِ ألا هُبّي",6,"ب",2,0],["وسنة لكَ في التَّحليق عالية","وما لمثلك في العلياءِ تقصير",7,"ر",1,0],["وسَنُعْفِي بوفاء صادقٍ","ولنا الحُظوةُ فيه والرَّشَدْ",8,"د",1,0],["وسُنَّةُ مجدِك أن تُستقى","سجالُ نداكَ بأشْطانِكا",9,"ك",2,0],["وسنزدادُ في الحِفاظِ وفي الودْ","دِ إذا ازددتَ في القطيعةِ مَحْكا",10,"ك",2,0],["وَسَنَلتَقي وَإِنِ اِفتَرَقنا في غَدٍ","في حُبِّ لُبنانٍ وَحُبِّ الشامِ",11,"م",1,0],["وَسَنّوا العَدلَ إيماناً وَتَقوىً","فَكانَ لَهُ بِهِم صَرحٌ مَشيدُ",12,"د",1,0],["وسنردى واذا جاء الردى","لا يحيينا من الشمس السنى",13,"ن",2,0],["وسنجري بلا ونى","وسنسعى بلا سأم",14,"م",1,0],["وسنبقى مثلما ك","نا قديماً صاحبين",15,"ن",1,0],["وَسنانَ يَفتَرُّ عَن سِمطَينِ مِن بَرَدٍ","صافٍ وَفي الصَدرِ تُفّاحٌ مِنَ العاجِ",16,"ج",1,0],["وَسِنِّ سُمَيرَةَ نَعتِ الفَتاةِ","تَبسِمُ عَن ظَلمِ أَسنانِها",17,"ن",3,0],["وَسَنامَ مَفخَرِهِ وَشَمسَةَ تاجِهِ","وَنِظامَهُ وَمَكانَ قُطبِ رَحاهُ",18,"ا",2,0],["وَسَنانَ نامَ فَأَيقَظَتهُ أُمُّهُ","لِفُواقِ راعِيَةٍ بِعَهدٍ مُقفِرِ",19,"ر",1,0],["وسنان الغروب تغزوه حمرا","وسنان العذاب تطعن زرقا",20,"ق",2,0],["وَسِنان مشرعٌ في صَعْدَةٍ","كَلِسانٍ في فَمِ الأَيمِ الصَدي",21,"د",2,0],["وَسنانُ في مُقلَتَيهِ","نَومٌ وَما ثَمَّ نَومُ",22,"م",1,0],["وَسنانَ يُدرِكُ كُلَّ قَلبٍ طالِباً","وَيَفوتُ كُلَّ مُتَيَّمٍ مَطلوبا",23,"ب",2,0],["وسننتَ للمُتعسِّفينَ سبيلَهم","مُتبلِّجاً سمحاً يُضِيءُ ويُشرِقُ",24,"ق",1,0],["وسنُّوا للخلائفِ ما عَلِمنا","فَصِينَ الدِّينُ والدُّنيا وزِينا",25,"ن",2,0],["وسنَّةٌ لبني الإسلامِ يَشرعُها","والخيرُ أجمعُ شرعٌ من سجاياهُ",26,"ا",2,0],["وسُنَّةُ المختارِ من ربِّهِ","والمصطفى من خلقهِ المُرسَلِ",27,"ل",1,0],["وَسنانُ مِن خَدعِ النِعاسِ جُفونَهُ","يَحكي بِمُقلَتِهِ ذُبولِ النَرجِسِ",28,"س",1,0],["وَسِنانٌ كُلَّما","هُزَّ في الرَوعِ ذَبَح",29,"ح",1,0],["وَسْنانَ من وَسَنِ المَلاحةِ طرفُه","وجفونُه سكرانَ من خمر الصّبا",30,"ب",2,0],["وَسنانُ في فَمِهِ سِمطانِ مِن بَرَدٍ","عَذبٍ وَفي خَدِّهِ تُفّاحَتا عاجِ",31,"ج",1,0],["وَسَناً يُضيءُ وَبَعدَهُ غَسَقٌ","فَاِنظُر أَجِدٌّ ذاكَ أَم هَزلُ",32,"ل",1,0],["وَسنين اطمأننت فيها وأخرى","صرتُ أَلقى في جنبها الأهوالا",33,"ل",2,0],["وسنطوي الأبدَ المجهولَ طيَّا","جُدَدَ الأطياف شتَّى الصُّوَرِ",34,"ر",1,0],["وَسْنانُ ناوَلَني مُدَامَةَ طَرْفِهِ","فشَرِبْتُها وسَمِعْتُ مِن طُنْبُورِه",35,"ر",2,0],["وَسِناناً إِذا تَعَسَّفتُ في اللَي","لِ هَداني وَرَدَّني عَن ضَلالي",36,"ي",1,0],["وسِنُوها قَصُرْنَ أَوْ طُلْن همُّ","وَأحِدٌ فِي الْقِصارِ أَوْ فِي الطوالِ",37,"ل",1,0],["وَسَنى بَين بِهَا وَسَنَاءُ","شَفَّ عَنْهُ الْجَمَالُ كَالمِرْآةِ",38,"ه",1,0],["وَسِنٍّ كَسُنَّيقٍ سَناءً وَسُنَّما","ذَعَرتُ بِمِدلاجِ الهَجيرِ نَهوضِ",39,"ض",1,0],["وَسْنَى بِأخْبِيَةِ الصَّحْرَاءِ يُوقِظهَا","وَحْيٌ مِنَ الشَّمْسِ أَوْ همْسٌ مِنَ الشهبِ",40,"ب",1,0],["وسنا الشَّمس حين مجَّتْ لُعاباً","ارسلته من نورها الكسروي",41,"ي",1,0],["وسَنَا غُرَّةٍ بَدَتْ تطفئ الشمسَ","وذكرٌ يشيِّبُ الأطفالاَ",42,"ل",2,0],["وسناه أصبح ساطعاً وسعوده","متتابعاً والحال أفصح ناطقِ",43,"ق",1,0],["وَسَنَنتِ لي أَن لا يَبوحَ مُحَدِّثاً","أَأَمِنتِ أَن يُملي الصُدودُ فَيَكتُبا",44,"ب",2,0],["وَسَنَنتَ لي طُرُقَ الثَناءِ بِأَنعُمٍ","واصَلنَ بِالغَدَواتِ وَالآصالِ",45,"ل",1,0],["وسَنَنتَ بِراً حاد عن","ه أحبُّةٌ وأقارب",46,"ب",1,0],["وَسَنُّوا النَدى وَالعَدلَ لِلناسِ فَاِقتَدى","بِهِم مَن بَغي في ذِروةِ المَجدِ مَفرعا",47,"ع",2,0],["وَسنَّتهُ تِربٌ له وهيَ شرحهُ","وَمَن جاءَ بِالقرآنِ فهوَ به أدرى",48,"ر",2,0],["وَسُنّتهُ جاءَت بكلِّ فَضيلةٍ","منَ الوحيِ لم يُعمل بأَحكامِها فكرا",49,"ر",2,0],["وَسنانُ أَقصَدَهُ النُعاسُ فَرَنَّقَت","في عَينِهِ سِنَةٌ وَلَيسَ بِنائِمِ",50,"م",1,0],["وَسنانُ مَكحُولُ المَدامِعِ كاحِلٌ","جَفنَ المُحبِّ المُستَهامِ بِسُهدِهِ",51,"د",2,0],["وَسَنَنت في بَذل النَوال بدائِعا","حتى اجتَنَينا العَدلَ من جَدواكا",52,"ك",2,0],["وَسَنىً تَأَلَّقَ بَينَ مُنفَرِجِ اللوى","فَتَساكَبَت بِدُموعِها الآماقُ",53,"ق",1,0],["وَسَنَاكُمُ يُهْدِي إلَِى","دُرَرِ الْمَفَاخِرِ كَيْفَ تُنْظَمْ",54,"م",1,0],["وسنا الإقبال له وردا","فاخلع نعليك بطور هدى",55,"د",2,0],["وسناه في الأحشاء سطعْ","ناديت بأشواقٍ وولعْ",55,"ع",1,0],["وسنّةٌ قرّرته","عن سيّد المرسلينا",56,"ن",2,0],["وسنّتُه الغرّاء قبلة نهجنا","وقدوتنا وهو الوسيلة للقصد",57,"د",1,0],["وسناوجه حيي ان تضى","معه الشمس فبالوجه الافاح",58,"ح",1,0],["وَسَنى الإمارَة ما تطَلّع في الدُّجى","مِنْ قبْل إسْفارِ الصّباح صبَاحا",59,"ح",2,0],["وَسُنوهُ بَلَغَت سَبعاً وَسَبعاً","فَهوَ كَالبَدرِ سنىً يَسمو وَسِنّا",60,"ن",2,0],["وَسِنانُ تُركِيٌّ فَكَم مُتَضَرِّجِ","بِدِمائِهِ مِن خَدِّهِ المُتَضَرِّجِ",61,"ج",1,0],["وسنَّةُ المعتلِّ","إِيذانُ كلِّ خلِّ",62,"ل",1,0],["وَسَنى المجرَّة في السَماءِ كأَنَّه","نهرٌ تدفَّق في حديقَةِ نَرجسِ",63,"س",1,0],["وَسَنى المجرَّة في الدُجى","كالنَهر ما بَينَ الزَهورِ",64,"ر",1,0],["وَسَناكَ مَسْرَجَةٌ لِبا","بِكَ والمَهابَةُ تُلْجِمُه",65,"م",2,0],["وَسِنَّتي في العِشقِ بَلَخِيَّةٌ","يَرفُضُها مَن دارَهُ الكَرخُ",66,"خ",1,0],["وَسَناهُ لَو لَم يَغشَ أَنوارَ السَما","واتِ العُلى لَم يَبدُ فيها نورُها",67,"ر",3,0],["وَسُنَّتي فيهِ لِأَهلِ التُقى","يَرفُضُها مِن جَهلِهِ الفاجِرُ",68,"ر",1,0],["وَسنان يَفترّ عَن بَرق فَأنشدهُ","يا ساهر البَرق أَيقظ راقد السَمرِ",69,"ر",1,0],["وَسَناءُ وَجهٍ بِالبَشاشَة لَو بَدا","لَكَ في الدجا عاينت صبحا مُسفِرا",70,"ر",2,0],["وسنة طه شرحها جاء واضحا","باحيا علوم الدين من غير ما جحد",71,"د",1,0],["وسَنَنْتمُ من ظُلم أَهْلٍ سنّةً","بكمُ اقْتَدى في فِعْلها الفُسَّاق",72,"ق",1,0],["وسنته هي النور الذي لا","سواه به النجاة من الظلام",73,"م",1,0],["وسنة أحمد مهما رواها","جهابذة الأئمة والصحاب",74,"ب",1,0],["وسُنَّهُ أحْسَنَ في بَثِّها","فهذه عشر أتت لا سوى",75,"ا",1,0],["وسنتي بالحب أن لم يزل","قلبي لدى من بتّ أهوى رهين",76,"ن",1,0],["وسنيّ زاكي الأصول عليّ","في مقام يسمو على كل عال",77,"ل",1,0],["وسنانُ ضاع اللُبُّ في لحَظاتِه","ضيعانُ طبُّ وصالِه في هجرِه",78,"ر",2,0],["وسنانةُ الأجفانِ قد خُرِطَتْ","منها ظُبيَّ بقلوبِنا تسْطو",79,"ط",2,0],["وسنانَ ما حالَتْ قِداحُ جمالِه","إلا ثَنى قلبي من الأعشارِ",80,"ر",1,0],["وسَنِيِّها وعَلِيِّها وزَكيِّها","وحليمِها وكريمِها وجوادِها",81,"د",3,0],["وسَناً كإِصْباحِ المُغارِ مُرَوِّعٌ","ودُجىً كإِظلامِ البياتِ بَهِيمُ",82,"م",1,0],["وسنبل وافى على سوقه","غِبّ الحيا في زُرْقَة لا تُحَدّ",83,"د",1,1],["وسنا البهاء وكم يداوي شعره","مرضى النفوس العانيات بسله",84,"ل",2,0],["وسَنُّوا محرمي الأبدا","ن عَقْرَ حلائِل البُدُنِ",85,"ن",1,0],["وسنان عن حقّي إذا نبّهتُه","قالت خلائقُه الجعادُ له نمِ",86,"م",1,0],["وسنَّةً تدفع المخالفَ عن","دعوتهم مذ همُ بك ادّرعوا",87,"ع",3,0],["وسُنّةٌ في المجد قد قُوّضتْ","أقمتَ من أطنابها والعمادْ",88,"د",1,0],["وسنة طه فاتبعها فانها","هي الحق لا تتبع سواها فتدحرا",89,"ر",2,0],["وسنانُ أسقمَ جسمي سقم ناظرهِ","السّاجي وأسهرَ عيني ذلك العين",90,"ن",1,0],["وسنان ساجي المقلتين ضعيفُ عقد ال","خصر أعدى الجسم فرط نحوله",91,"ل",2,0],["وسنانُ يحسن في العيون وما له","حسنى ويعذب في القلوب معذّبا",92,"ب",2,0],["وسنانُ إن رمقتْ لوا","حظهُ فما تبقي رمقْ",93,"ق",1,0],["وسنانُ أغيدُ كالغزال جفونه","شركٌ يصيد به كماة الصيد",94,"د",1,0],["وسنان أسهرني بفتر جفونه","وأطال ليلي فيه طولُ وقوفه",95,"ف",2,0],["وسنانُ ساجي الطرف صدَّ مسّهدا","فكأنّهُ متكحّلٌ برقاده",96,"د",2,0],["وسنان كلُّ شوى يلاحظُ مقتلُ","إذ كل جفن منه سهمُ قضاءِ",97,"ا",2,0],["وسنانُ أشقى بعطفيه وريقته","فآقتي عاسلٌ منهُ ومعسول",98,"ل",1,0],["وسُنَّةُ الطُّهْرِ ديني","ومنهَجُ الصَّحْبِ دَرْبي",99,"ي",1,0],["وسنّته اضاعوها امتهاناً","فما لهم بواجبها اهتمام",100,"م",1,0],["وسنان ذاب السحر في آماقه","وأذاب ماء الروح في آماقي",101,"ي",1,0],["وسُنَّةَ الْمُصطَفَى المخْتارِ قاهِرَةً","لِكُلِّ ذِي بِدْعَةٍ بالرَّفْضِ صَوّالِ",102,"ل",1,0],["وَسَنَّ لَنا مِنَ الإِسلامَ نَهجاً","صَلاةَ الخَمسِ يَتبَعُها الصِيامُ",103,"م",1,0],["وَسَنَّ الصِيامَ لَنا وَالقِيامَ","مُوَلّى إِلى اللَهِ لا تَجهَلوا",104,"ل",3,0],["وسنكنس التاريخ ممّا اسندت","فيه الذئاب وما رواه الثعلب",105,"ب",1,0],["وَسِنٍ إِذا غَدَتِ الوُفودُ كَأَنَّما","كَلَأَ الكَواكِبَ لَيلُهُ لَم يَرقُدِ",106,"د",1,0],["وَسنى وَلا كَوَسنى","تُميتُ مَن تُريدُ",107,"د",1,0],["وسنة أحمد المختار قوم","بها هم في ظلام وهي صبح",108,"ح",1,0],["وسنة المصطفى روتها","رواتها بي أيان شاءوا",109,"ا",1,0],["وَسَنْبُوسَجَةٍ مَقْلُوَّ","ةِ فِي إِثْرِ طَرْذِيْنَهْ",110,"ن",2,0],["وسنّة الله على المستقبل","كما مضى في ذاك لم تبدل",111,"ل",1,0],["وسنة الصلاة كانت تجري","عن النبي ليل كل شهر",111,"ر",1,0],["وسنة النبي والمأثور","من حكمه المستعمل المشهور",111,"ر",1,0],["وسنة جمع الظهر والعصر يا فتى","كذا معه بين العشائين فاشهد",112,"د",1,0]]}