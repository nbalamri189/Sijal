 تَكونُ القُلوبُ",0,"ب",1,0],["وَسُنَّةُ إِبْرَاهِيمَ فِي الْفَخْرِ قَدْ أَتَتْ","بِكُلِّ صَحِيحٍ عَنْ عَلِيٍّ وَعُثْمَانِ",1,"ن",1,0],["وَسَنَّ قَومُ الطَيشِ مِن جَهلِهِم","كِذبَةَ إِبريلَ لِأُكتوبَرِ",2,"ر",1,0],["وَسَنَّ لَكُم حُرِّيَّةَ القَولِ عِندَما","رَأى القَولَ في أَسرِ السُكوتِ مُقَيَّدا",3,"د",2,0],["وَسَنا جَبينٍ يَستَطيرُ شُعاعُهُ","يُغني عَنِ القَمَرَينِ مَن يَتَوَسَّمُ",4,"م",1,0],["وَسِنٍّ كَسُنَّيقٍ سَناءً وَسُنَّم","ذَعَرتُ بِمِدلاجِ الهَجيرِ نَهوضِ",5,"ض",1,0],["وسنان ينشدُ سحرُ مقلتهِ","أجفانَ عاشقهِ ألا هُبّي",6,"ب",2,0],["وسنة لكَ في التَّحليق عالية","وما لمثلك في العلياءِ تقصير",7,"ر",1,0],["وسَنُعْفِي بوفاء صادقٍ","ولنا الحُظوةُ فيه والرَّشَدْ",8,"د",1,0],["وسُنَّةُ مجدِك أن تُستقى","سجالُ نداكَ بأشْطانِكا",9,"ك",2,0],["وسنزدادُ في الحِفاظِ وفي الودْ","دِ إذا ازددتَ في القطيعةِ مَحْكا",10,"ك",2,0],["وَسَنَلتَقي وَإِنِ اِفتَرَقنا في غَدٍ","في حُبِّ لُبنانٍ وَحُبِّ الشامِ",11,"م",1,0],["وَسَنّوا العَدلَ إيماناً وَتَقوىً","فَكانَ لَهُ بِهِم صَرحٌ مَشيدُ",12,"د",1,0],["وسنردى واذا جاء الردى","لا يحيينا من الشمس السنى",13,"ن",2,0],["وسنجري بلا ونى","وسنسعى بلا سأم",14,"م",1,0],["وسنبقى مثلما ك","نا قديماً صاحبين",15,"ن",1,0],["وَسنانَ يَفتَرُّ عَن سِمطَينِ مِن بَرَدٍ","صافٍ وَفي الصَدرِ تُفّاحٌ مِنَ العاجِ",16,"ج",1,0],["وَسِنِّ سُمَيرَةَ نَعتِ الفَتاةِ","تَبسِمُ عَن ظَلمِ أَسنانِها",17,"ن",3,0],["وَسَنامَ مَفخَرِهِ وَشَمسَةَ تاجِهِ","وَنِظامَهُ وَمَكانَ قُطبِ رَحاهُ",18,"ا",2,0],["وَسَنانَ نامَ فَأَيقَظَتهُ أُمُّهُ","لِفُواقِ راعِيَةٍ بِعَهدٍ مُقفِرِ",19,"ر",1,0],["وسنان الغروب تغزوه حمرا","وسنان العذاب تطعن زرقا",20,"ق",2,0],["وَسُنَّةُ اللهِ في الأحبَابِ أَنَّ لَهُم","وَجْهَاً يَزِيدُ وُضُوحَاً كُلَّمَا اْبْتَعَدَا",21,"د",2,0],["وَسِنان مشرعٌ في صَعْدَةٍ","كَلِسانٍ في فَمِ الأَيمِ الصَدي",22,"د",2,0],["وَسنانُ في مُقلَتَيهِ","نَومٌ وَما ثَمَّ نَومُ",23,"م",1,0],["وَسنانَ يُدرِكُ كُلَّ قَلبٍ طالِباً","وَيَفوتُ كُلَّ مُتَيَّمٍ مَطلوبا",24,"ب",2,0],["وسننتَ للمُتعسِّفينَ سبيلَهم","مُتبلِّجاً سمحاً يُضِيءُ ويُشرِقُ",25,"ق",1,0],["وسنُّوا للخلائفِ ما عَلِمنا","فَصِينَ الدِّينُ والدُّنيا وزِينا",26,"ن",2,0],["وسنَّةٌ لبني الإسلامِ يَشرعُها","والخيرُ أجمعُ شرعٌ من سجاياهُ",27,"ا",2,0],["وسُنَّةُ المختارِ من ربِّهِ","والمصطفى من خلقهِ المُرسَلِ",28,"ل",1,0],["وَسنانُ مِن خَدعِ النِعاسِ جُفونَهُ","يَحكي بِمُقلَتِهِ ذُبولِ النَرجِسِ",29,"س",1,0],["وَسِنانٌ كُلَّما","هُزَّ في الرَوعِ ذَبَح",30,"ح",1,0],["وَسْنانَ من وَسَنِ المَلاحةِ طرفُه","وجفونُه سكرانَ من خمر الصّبا",31,"ب",2,0],["وَسنانُ في فَمِهِ سِمطانِ مِن بَرَدٍ","عَذبٍ وَفي خَدِّهِ تُفّاحَتا عاجِ",32,"ج",1,0],["وَسَناً يُضيءُ وَبَعدَهُ غَسَقٌ","فَاِنظُر أَجِدٌّ ذاكَ أَم هَزلُ",33,"ل",1,0],["وَسنين اطمأننت فيها وأخرى","صرتُ أَلقى في جنبها الأهوالا",34,"ل",2,0],["وسنطوي الأبدَ المجهولَ طيَّا","جُدَدَ الأطياف شتَّى الصُّوَرِ",35,"ر",1,0],["وَسْنانُ ناوَلَني مُدَامَةَ طَرْفِهِ","فشَرِبْتُها وسَمِعْتُ مِن طُنْبُورِه",36,"ر",2,0],["وَسِناناً إِذا تَعَسَّفتُ في اللَي","لِ هَداني وَرَدَّني عَن ضَلالي",37,"ل",2,0],["وسِنُوها قَصُرْنَ أَوْ طُلْن همُّ","وَأحِدٌ فِي الْقِصارِ أَوْ فِي الطوالِ",38,"ل",1,0],["وَسَنى بَين بِهَا وَسَنَاءُ","شَفَّ عَنْهُ الْجَمَالُ كَالمِرْآةِ",39,"ه",1,0],["وَسِنٍّ كَسُنَّيقٍ سَناءً وَسُنَّما","ذَعَرتُ بِمِدلاجِ الهَجيرِ نَهوضِ",40,"ض",1,0],["وَسْنَى بِأخْبِيَةِ الصَّحْرَاءِ يُوقِظهَا","وَحْيٌ مِنَ الشَّمْسِ أَوْ همْسٌ مِنَ الشهبِ",41,"ب",1,0],["وسنا البصائر مدرك إن مده","من بحر نور الله نور واقد",42,"د",1,0],["وسنا الشَّمس حين مجَّتْ لُعاباً","ارسلته من نورها الكسروي",43,"ي",1,0],["وسَنَا غُرَّةٍ بَدَتْ تطفئ الشمسَ","وذكرٌ يشيِّبُ الأطفالاَ",44,"ل",2,0],["وسناه أصبح ساطعاً وسعوده","متتابعاً والحال أفصح ناطقِ",45,"ق",1,0],["وَسَنَنتِ لي أَن لا يَبوحَ مُحَدِّثاً","أَأَمِنتِ أَن يُملي الصُدودُ فَيَكتُبا",46,"ب",2,0],["وَسَنَنتَ لي طُرُقَ الثَناءِ بِأَنعُمٍ","واصَلنَ بِالغَدَواتِ وَالآصالِ",47,"ل",1,0],["وسَنَنتَ بِراً حاد عن","ه أحبُّةٌ وأقارب",48,"ب",1,0],["وَسَنُّوا النَدى وَالعَدلَ لِلناسِ فَاِقتَدى","بِهِم مَن بَغي في ذِروةِ المَجدِ مَفرعا",49,"ع",2,0],["وَسنَّتهُ تِربٌ له وهيَ شرحهُ","وَمَن جاءَ بِالقرآنِ فهوَ به أدرى",50,"ر",2,0],["وَسُنّتهُ جاءَت بكلِّ فَضيلةٍ","منَ الوحيِ لم يُعمل بأَحكامِها فكرا",51,"ر",2,0],["وَسنانُ أَقصَدَهُ النُعاسُ فَرَنَّقَت","في عَينِهِ سِنَةٌ وَلَيسَ بِنائِمِ",52,"م",1,0],["وَسنانُ مَكحُولُ المَدامِعِ كاحِلٌ","جَفنَ المُحبِّ المُستَهامِ بِسُهدِهِ",53,"د",2,0],["وَسَنَنت في بَذل النَوال بدائِعا","حتى اجتَنَينا العَدلَ من جَدواكا",54,"ك",2,0],["وَسَنىً تَأَلَّقَ بَينَ مُنفَرِجِ اللوى","فَتَساكَبَت بِدُموعِها الآماقُ",55,"ق",1,0],["وَسَنَاكُمُ يُهْدِي إلَِى","دُرَرِ الْمَفَاخِرِ كَيْفَ تُنْظَمْ",56,"م",1,0],["وسنا الإقبال له وردا","فاخلع نعليك بطور هدى",57,"د",2,0],["وسناه في الأحشاء سطعْ","ناديت بأشواقٍ وولعْ",57,"ع",1,0],["وسنّةٌ قرّرته","عن سيّد المرسلينا",58,"ن",2,0],["وسنّتُه الغرّاء قبلة نهجنا","وقدوتنا وهو الوسيلة للقصد",59,"د",1,0],["وسناوجه حيي ان تضى","معه الشمس فبالوجه الافاح",60,"ح",1,0],["وَسَنى الإمارَة ما تطَلّع في الدُّجى","مِنْ قبْل إسْفارِ الصّباح صبَاحا",61,"ح",2,0],["وَسُنوهُ بَلَغَت سَبعاً وَسَبعاً","فَهوَ كَالبَدرِ سنىً يَسمو وَسِنّا",62,"ن",2,0],["وَسِنانُ تُركِيٌّ فَكَم مُتَضَرِّجِ","بِدِمائِهِ مِن خَدِّهِ المُتَضَرِّجِ",63,"ج",1,0],["وسنَّةُ المعتلِّ","إِيذانُ كلِّ خلِّ",64,"ل",1,0],["وَسَنى المجرَّة في السَماءِ كأَنَّه","نهرٌ تدفَّق في حديقَةِ نَرجسِ",65,"س",1,0],["وَسَنى المجرَّة في الدُجى","كالنَهر ما بَينَ الزَهورِ",66,"ر",1,0],["وَسَناكَ مَسْرَجَةٌ لِبا","بِكَ والمَهابَةُ تُلْجِمُه",67,"م",2,0],["وَسِنَّتي في العِشقِ بَلَخِيَّةٌ","يَرفُضُها مَن دارَهُ الكَرخُ",68,"خ",1,0],["وَسَناهُ لَو لَم يَغشَ أَنوارَ السَما","واتِ العُلى لَم يَبدُ فيها نورُها",69,"ر",3,0],["وَسُنَّتي فيهِ لِأَهلِ التُقى","يَرفُضُها مِن جَهلِهِ الفاجِرُ",70,"ر",1,0],["وَسنان يَفترّ عَن بَرق فَأنشدهُ","يا ساهر البَرق أَيقظ راقد السَمرِ",71,"ر",1,0],["وَسَناءُ وَجهٍ بِالبَشاشَة لَو بَدا","لَكَ في الدجا عاينت صبحا مُسفِرا",72,"ر",2,0],["وسنة طه شرحها جاء واضحا","باحيا علوم الدين من غير ما جحد",73,"د",1,0],["وسَنَنْتمُ من ظُلم أَهْلٍ سنّةً","بكمُ اقْتَدى في فِعْلها الفُسَّاق",74,"ق",1,0],["وسنته هي النور الذي لا","سواه به النجاة من الظلام",75,"م",1,0],["وسنة أحمد مهما رواها"