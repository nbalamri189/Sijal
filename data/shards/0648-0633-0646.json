وافر"],[404,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[404,"يجري لمن قد حل في لحده","https://www.aldiwan.net/poem34166.html","السريع"],[430,"لا والمحيا وصباح الجبين","https://www.aldiwan.net/poem40242.html","السريع"],[430,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[433,"سفحت عيون الغيث أدمع قطره","https://www.aldiwan.net/poem12612.html","الكامل"],[433,"سارت مطيهم بهم تمطو","https://www.aldiwan.net/poem12799.html","أحذ الكامل"],[433,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[440,"طاعت لك الأحرار باستعبادها","https://www.aldiwan.net/poem34804.html","الكامل"],[440,"طير الفؤاد على لماك تحوم","https://www.aldiwan.net/poem34823.html","الكامل"],[453,"وسنبل وافى على سوقه","https://www.aldiwan.net/poem13738.html","السريع"],[454,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[459,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[459,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[459,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[459,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[465,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[465,"طربي إلى ماء الحمى ونزيله","https://www.aldiwan.net/poem3443.html","عموديه"],[465,"أعجبت من خد صفا وتلهبا","https://www.aldiwan.net/poem3445.html","عموديه"],[465,"طال السهاد مع القلق","https://www.aldiwan.net/poem3469.html","عموديه"],[465,"ولقد بدا والصولجان بكفّه","https://www.aldiwan.net/poem3522.html","عموديه"],[465,"ما عند مهضوم الوشاح ضعيفه","https://www.aldiwan.net/poem3583.html","عموديه"],[465,"هل هز بالأعطاف سمر صعاده","https://www.aldiwan.net/poem3623.html","عموديه"],[465,"اصمى بسهم المقلة النجلاء","https://www.aldiwan.net/poem3631.html","عموديه"],[465,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[501,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[507,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[516,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[530,"متى أرى الحق يصفو من تكدره","https://www.aldiwan.net/poem37242.html","البسيط"],[537,"تولى الجود وانقرض الكرام","https://www.aldiwan.net/poem23847.html","الوافر"],[537,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[545,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[554,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[559,"كتاب الله جامع كل شيء","https://www.aldiwan.net/poem34669.html","الوافر"],[559,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[568,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَسِناني بِالدارِعينِ خَبيرٌ","فَاِسأَليهِ عَمّا تَكونُ القُلوبُ",0,"ب",1,0],["وَسُنَّةُ إِبْرَاهِيمَ فِي الْفَخْرِ قَدْ أَتَتْ","بِكُلِّ صَحِيحٍ عَنْ عَلِيٍّ وَعُثْمَانِ",1,"ن",1,0],["وَسَنَّ قَومُ الطَيشِ مِن جَهلِهِم","كِذبَةَ إِبريلَ لِأُكتوبَرِ",2,"ر",1,0],["وَسَنَّ لَكُم حُرِّيَّةَ القَولِ عِندَما","رَأى القَولَ في أَسرِ السُكوتِ مُقَيَّدا",3,"د",2,0],["وَسَنا جَبينٍ يَستَطيرُ شُعاعُهُ","يُغني عَنِ القَمَرَينِ مَن يَتَوَسَّمُ",4,"م",1,0],["وَسِنٍّ كَسُنَّيقٍ سَناءً وَسُنَّم","ذَعَرتُ بِمِدلاجِ الهَجيرِ نَهوضِ",5,"ض",1,0],["وسنان ينشدُ سحرُ مقلتهِ","أجفانَ عاشقهِ ألا هُبّي",6,"ب",2,0],["وسنة لكَ في التَّحليق عالية","وما لمثلك في العلياءِ تقصير",7,"ر",1,0],["وسَنُعْفِي بوفاء صادقٍ","ولنا الحُظوةُ فيه والرَّشَدْ",8,"د",1,0],["وسُنَّةُ مجدِك أن تُستقى","سجالُ نداكَ بأشْطانِكا",9,"ك",2,0],["وسنزدادُ في الحِفاظِ وفي الودْ","دِ إذا ازددتَ في القطيعةِ مَحْكا",10,"ك",2,0],["وَسَنَلتَقي وَإِنِ اِفتَرَقنا في غَدٍ","في حُبِّ لُبنانٍ وَحُبِّ الشامِ",11,"م",1,0],["وَسَنّوا العَدلَ إيماناً وَتَقوىً","فَكانَ لَهُ بِهِم صَرحٌ مَشيدُ",12,"د",1,0],["وسنردى واذا جاء الردى","لا يحيينا من الشمس السنى",13,"ن",2,0],["وسنجري بلا ونى","وسنسعى بلا سأم",14,"م",1,0],["وسنبقى مثلما ك","نا قديماً صاحبين",15,"ن",1,0],["وَسنانَ يَفتَرُّ عَن سِمطَينِ مِن بَرَدٍ","صافٍ وَفي الصَدرِ تُفّاحٌ مِنَ العاجِ",16,"ج",1,0],["وَسِنِّ سُمَيرَةَ نَعتِ الفَتاةِ","تَبسِمُ عَن ظَلمِ أَسنانِها",17,"ن",3,0],["وَسَنامَ مَفخَرِهِ وَشَمسَةَ تاجِهِ","وَنِظامَهُ وَمَكانَ قُطبِ رَحاهُ",18,"ا",2,0],["وَسَنانَ نامَ فَأَيقَظَتهُ أُمُّهُ","لِفُواقِ راعِيَةٍ بِعَهدٍ مُقفِرِ",19,"ر",1,0],["وسنان الغروب تغزوه حمرا","وسنان العذاب تطعن زرقا",20,"ق",2,0],["وَسُنَّةُ اللهِ في الأحبَابِ أَنَّ لَهُم","وَجْهَاً يَزِيدُ وُضُوحَاً كُلَّمَا اْبْتَعَدَا",21,"د",2,0],["وَسِنان مشرعٌ في صَعْدَةٍ","كَلِسانٍ في فَمِ الأَيمِ الصَدي",22,"د",2,0],["وَسنانُ في مُقلَتَيهِ","نَومٌ وَما ثَمَّ نَومُ",23,"م",1,0],["وَسنانَ يُدرِكُ كُلَّ قَلبٍ طالِباً","وَيَفوتُ كُلَّ مُتَيَّمٍ مَطلوبا",24,"ب",2,0],["وسننتَ للمُتعسِّفينَ سبيلَهم","مُتبلِّجاً سمحاً يُضِيءُ ويُشرِقُ",25,"ق",1,0],["وسنُّوا للخلائفِ ما عَلِمنا","فَصِينَ الدِّينُ والدُّنيا وزِينا",26,"ن",2,0],["وسنَّةٌ لبني الإسلامِ يَشرعُها","والخيرُ أجمعُ شرعٌ من سجاياهُ",27,"ا",2,0],["وسُنَّةُ المختارِ من ربِّهِ","والمصطفى من خلقهِ المُرسَلِ",28,"ل",1,0],["وَسنانُ مِن خَدعِ النِعاسِ جُفونَهُ","يَحكي بِمُقلَتِهِ ذُبولِ النَرجِسِ",29,"س",1,0],["وَسِنانٌ كُلَّما","هُزَّ في الرَوعِ ذَبَح",30,"ح",1,0],["وَسْنانَ من وَسَنِ المَلاحةِ طرفُه","وجفونُه سكرانَ من خمر الصّبا",31,"ب",2,0],["وَسنانُ في فَمِهِ سِمطانِ مِن بَرَدٍ","عَذبٍ وَفي خَدِّهِ تُفّاحَتا عاجِ",32,"ج",1,0],["وَسَناً يُضيءُ وَبَعدَهُ غَسَقٌ","فَاِنظُر أَجِدٌّ ذاكَ أَم هَزلُ",33,"ل",1,0],["وَسنين اطمأننت فيها وأخرى","صرتُ أَلقى في جنبها الأهوالا",34,"ل",2,0],["وسنطوي الأبدَ المجهولَ طيَّا","جُدَدَ الأطياف شتَّى الصُّوَرِ",35,"ر",1,0],["وَسْنانُ ناوَلَني مُدَامَةَ طَرْفِهِ","فشَرِبْتُها وسَمِعْتُ مِن طُنْبُورِه",36,"ر",2,0],["وَسِناناً إِذا تَعَسَّفتُ في اللَي","لِ هَداني وَرَدَّني عَن ضَلالي",37,"ل",2,0],["وسِنُوها قَصُرْنَ أَوْ طُلْن همُّ","وَأحِدٌ فِي الْقِصارِ أَوْ فِي الطوالِ",38,"ل",1,0],["وَسَنى بَين بِهَا وَسَنَاءُ","شَفَّ عَنْهُ الْجَمَالُ كَالمِرْآةِ",39,"ه",1,0],["وَسِنٍّ كَسُنَّيقٍ سَناءً وَسُنَّما","ذَعَرتُ بِمِدلاجِ الهَجيرِ نَهوضِ",40,"ض",1,0],["وَسْنَى بِأخْبِيَةِ الصَّحْرَاءِ يُوقِظهَا","وَحْيٌ مِنَ الشَّمْسِ أَوْ همْسٌ مِنَ الشهبِ",41,"ب",1,0],["وسنا الشَّمس حين مجَّتْ لُعاباً","ارسلته من نورها الكسروي",42,"ي",1,0],["وسَنَا غُرَّةٍ بَدَتْ تطفئ الشمسَ","وذكرٌ يشيِّبُ الأطفالاَ",43,"ل",2,0],["وسناه أصبح ساطعاً وسعوده","متتابعاً والحال أفصح ناطقِ",44,"ق",1,0],["وَسَنَنتِ لي أَن لا يَبوحَ مُحَدِّثاً","أَأَمِنتِ أَن يُملي الصُدودُ فَيَكتُبا",45,"ب",2,0],["وَسَنَنتَ لي طُرُقَ الثَناءِ بِأَنعُمٍ","واصَلنَ بِالغَدَواتِ وَالآصالِ",46,"ل",1,0],["وسَنَنتَ بِراً حاد عن","ه أحبُّةٌ وأقارب",47,"ب",1,0],["وَسَنُّوا النَدى وَالعَدلَ لِلناسِ فَاِقتَدى","بِهِم مَن بَغي في ذِروةِ المَجدِ مَفرعا",48,"ع",2,0],["وَسنَّتهُ تِربٌ له وهيَ شرحهُ","وَمَن جاءَ بِالقرآنِ فهوَ به أدرى",49,"ر",2,0],["وَسُنّتهُ جاءَت بكلِّ فَضيلةٍ","منَ الوحيِ لم يُعمل بأَحكامِها فكرا",50,"ر",2,0],["وَسنانُ أَقصَدَهُ النُعاسُ فَرَنَّقَت","في عَينِهِ سِنَةٌ وَلَيسَ بِنائِمِ",51,"م",1,0],["وَسنانُ مَكحُولُ المَدامِعِ كاحِلٌ","جَفنَ المُحبِّ المُستَهامِ بِسُهدِهِ",52,"د",2,0],["وَسَنَنت في بَذل النَوال بدائِعا","حتى اجتَنَينا العَدلَ من جَدواكا",53,"ك",2,0],["وَسَنىً تَأَلَّقَ بَينَ مُنفَرِجِ اللوى","فَتَساكَبَت بِدُموعِها الآماقُ",54,"ق",1,0],["وَسَنَاكُمُ يُهْدِي إلَِى","دُرَرِ الْمَفَاخِرِ كَيْفَ تُنْظَمْ",55,"م",1,0],["وسنا الإقبال له وردا","فاخلع نعليك بطور هدى",56,"د",2,0],["وسناه في الأحشاء سطعْ","ناديت بأشواقٍ وولعْ",56,"ع",1,0],["وسنّةٌ قرّرته","عن سيّد المرسلينا",57,"ن",2,0],["وسنّتُه الغرّاء قبلة نهجنا","وقدوتنا وهو الوسيلة للقصد",58,"د",1,0],["وسناوجه حيي ان تضى","معه الشمس فبالوجه الافاح",59,"ح",1,0],["وَسَنى الإمارَة ما تطَلّع في الدُّجى","مِنْ قبْل إسْفارِ الصّباح صبَاحا",60,"ح",2,0],["وَسُنوهُ بَلَغَت سَبعاً وَسَبعاً","فَهوَ كَالبَدرِ سنىً يَسمو وَسِنّا",61,"ن",2,0],["وَسِنانُ تُركِيٌّ فَكَم مُتَضَرِّجِ","بِدِمائِهِ مِن خَدِّهِ المُتَضَرِّجِ",62,"ج",1,0],["وسنَّةُ المعتلِّ","إِيذانُ كلِّ خلِّ",63,"ل",1,0],["وَسَنى المجرَّة في السَماءِ كأَنَّه","نهرٌ تدفَّق في حديقَةِ نَرجسِ",64,"س",1,0],["وَسَنى المجرَّة في الدُجى","كالنَهر ما بَينَ الزَهورِ",65,"ر",1,0],["وَسَناكَ مَسْرَجَةٌ لِبا","بِكَ والمَهابَةُ تُلْجِمُه",66,"م",2,0],["وَسِنَّتي في العِشقِ بَلَخِيَّةٌ","يَرفُضُها مَن دارَهُ الكَرخُ",67,"خ",1,0],["وَسَناهُ لَو لَم يَغشَ أَنوارَ السَما","واتِ العُلى لَم يَبدُ فيها نورُها",68,"ر",3,0],["وَسُنَّتي فيهِ لِأَهلِ التُقى","يَرفُضُها مِن جَهلِهِ الفاجِرُ",69,"ر",1,0],["وَسنان يَفترّ عَن بَرق فَأنشدهُ","يا ساهر البَرق أَيقظ راقد السَمرِ",70,"ر",1,0],["وَسَناءُ وَجهٍ بِالبَشاشَة لَو بَدا","لَكَ في الدجا عاينت صبحا مُسفِرا",71,"ر",2,0],["وسنة طه شرحها جاء واضحا","باحيا علوم الدين من غير ما جحد",72,"د",1,0],["وسَنَنْتمُ من ظُلم أَهْلٍ سنّةً","بكمُ اقْتَدى في فِعْلها الفُسَّاق",73,"ق",1,0],["وسنته هي النور الذي لا","سواه به النجاة من الظلام",74,"م",1,0],["وسنة أحمد مهما رواها","جهابذة الأئمة والصحاب",75,"ب",1,0],["وسُنَّهُ أحْسَنَ في بَثِّها","فهذه عشر أتت لا سوى",76,"ا",1,0],["وسنتي بالحب أن لم يزل","قلبي لدى من بتّ أهوى رهين",77,"ن",1,0],["وسنيّ زاكي الأصول عليّ","في مقام يسمو على كل عال",78,"ل",1,0],["وسنانُ ضاع اللُبُّ في لحَظاتِه","ضيعانُ طبُّ وصالِه في هجرِه",79,"ر",2,0],["وسنانةُ الأجفانِ قد خُرِطَتْ","منها ظُبيَّ بقلوبِنا تسْطو",80,"ط",2,0],["وسنانَ ما حالَتْ قِداحُ جمالِه","إلا ثَنى قلبي من الأعشارِ",81,"ر",1,0],["وسَنِيِّها وعَلِيِّها وزَكيِّها","وحليمِها وكريمِها وجوادِها",82,"د",3,0],["وسَناً كإِصْباحِ المُغارِ مُرَوِّعٌ","ودُجىً كإِظلامِ البياتِ بَهِيمُ",83,"م",1,0],["وسنبل وافى على سوقه","غِبّ الحيا في زُرْقَة لا تُحَدّ",84,"د",1,1],["وسنا البهاء وكم يداوي شعره","مرضى النفوس العانيات بسله",85,"ل",2,0],["وسَنُّوا محرمي الأبدا","ن عَقْرَ حلائِل البُدُنِ",86,"ن",1,0],["وسنان عن حقّي إذا نبّهتُه","قالت خلائقُه الجعادُ له نمِ",87,"م",1,0],["وسنَّةً تدفع المخالفَ عن","دعوتهم مذ همُ بك ادّرعوا",88,"ع",3,0],["وسُنّةٌ في المجد قد قُوّضتْ","أقمتَ من أطنابها والعمادْ",89,"د",1,0],["وسنة طه فاتبعها فانها","هي الحق لا تتبع سواها فتدحرا",90,"ر",2,0],["وسنانُ أسقمَ جسمي سقم ناظرهِ","السّاجي وأسهرَ عيني ذلك العين",91,"ن",1,0],["وسنان ساجي المقلتين ضعيفُ عقد ال","خصر أعدى الجسم فرط نحوله",92,"ل",2,0],["وسنانُ يحسن في العيون وما له","حسنى ويعذب في القلوب معذّبا",93,"ب",2,0],["وسنانُ إن رمقتْ لوا","حظهُ فما تبقي رمقْ",94,"ق",1,0],["وسنانُ أغيدُ كالغزال جفونه","شركٌ يصيد به كماة الصيد",95,"د",1,0],["وسنان أسهرني بفتر جفونه","وأطال ليلي فيه طولُ وقوفه",96,"ف",2,0],["وسنانُ ساجي الطرف صدَّ مسّهدا","فكأنّهُ متكحّلٌ برقاده",97,"د",2,0],["وسنان كلُّ شوى يلاحظُ مقتلُ","إذ كل جفن منه سهمُ قضاءِ",98,"ا",2,0],["وسنانُ أشقى بعطفيه وريقته","فآقتي عاسلٌ منهُ ومعسول",99,"ل",1,0],["وسُنَّةُ الطُّهْرِ ديني","ومنهَجُ الصَّحْبِ دَرْبي",100,"ب",2,0],["وسنّته اضاعوها امتهاناً","فما لهم بواجبها اهتمام",101,"م",1,0],["وسنان ذاب السحر في آماقه","وأذاب ماء الروح في آماقي",102,"ق",2,0],["وسُنَّةَ الْمُصطَفَى المخْتارِ قاهِرَةً","لِكُلِّ ذِي بِدْعَةٍ بالرَّفْضِ صَوّالِ",103,"ل",1,0],["وَسَنَّ لَنا مِنَ الإِسلامَ نَهجاً","صَلاةَ الخَمسِ يَتبَعُها الصِيامُ",104,"م",1,0],["وَسَنَّ الصِيامَ لَنا وَالقِيامَ","مُوَلّى إِلى اللَهِ لا تَجهَلوا",105,"ل",3,0],["وسنكنس التاريخ ممّا اسندت","فيه الذئاب وما رواه الثعلب",106,"ب",1,0],["وَسِنٍ إِذا غَدَتِ الوُفودُ كَأَنَّما","كَلَأَ الكَواكِبَ لَيلُهُ لَم يَرقُدِ",107,"د",1,0],["وَسنى وَلا كَوَسنى","تُميتُ مَن تُريدُ",108,"د",1,0],["وسنة أحمد المختار قوم","بها هم في ظلام وهي صبح",109,"ح",1,0],["وسنة المصطفى روتها","رواتها بي أيان شاءوا",110,"ا",1,0],["وَسَنْبُوسَجَةٍ مَقْلُوَّ","ةِ فِي إِثْرِ طَرْذِيْنَهْ",111,"ن",2,0],["وسنّة الله على المستقبل","كما مضى في ذاك لم تبدل",112,"ل",1,0],["وسنة الصلاة كانت تجري","عن النبي ليل كل شهر",112,"ر",1,0],["وسنة النبي والمأثور","من حكمه المستعمل المشهور",112,"ر",1,0],["وسنة جمع الظهر والعصر يا فتى","كذا معه بين العشائين فاشهد",113,"د",1,0]]}