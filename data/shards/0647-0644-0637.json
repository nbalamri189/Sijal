{"poems":[[107,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[108,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[228,"وترامى الصباح فوق الهضاب","https://www.aldiwan.net/poem41603.html","الخفيف"],[308,"قلت لصحب زارهم شادن","https://www.aldiwan.net/poem57796.html","السريع"],[347,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[369,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[558,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138322",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87940","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100401","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129413","الخفيف"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114673","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125909","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94808","البسيط"],[182,"صنو روحي","https://www.poetsgate.com/ViewPoem.aspx?id=72810",""],[5106,"لا تَقُلْ لِيْ قَدْ تَعِبْنَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150039",""],[5120,"لَيْلَةٌ فِي اَلْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=179956",""],[5185,"من مشاهد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=71714",""],[5302,"اسم الذي أهواه","https://www.poetsgate.com/ViewPoem.aspx?id=200945",""],[307,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=215237",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5376,"عيش ذل يا قدسنا ما استطابا","https://www.poetsgate.com/ViewPoem.aspx?id=190450",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5853,"مولد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=175678",""],[5997,"جنتي وعذابي","https://www.poetsgate.com/ViewPoem.aspx?id=214235",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""]],"verses":[["هل طَواكَ الموتُ عنّا أم طوى","بأسُك العاصفُ منه الهِمَما",0,"م",2,0],["هَل طَوى الدَهرُ مِن اِبنِيَ إِلّا","سابقَ النَدِّ وَزين النَديِّ",1,"ي",1,0],["هل طاب عيشك بيننا، يا ابن الشرى","ورضيت بالقفص الحديد عرينا؟",2,"ن",2,0],["هَل طَواها الَّذي طَوى مَن أَحَبَّت","أَم تُراها عادَت لِذاكَ التَصابي",3,"ب",2,0],["هل طاف بالكأس فقالوا نعم","وكاس لما شرب الكاسا",4,"س",2,0],["هل طار في الجو","ام سال في الماء",5,"ا",2,0],["هل طالعاتٌ بالطُويْلعِ غُدوةً","تلك الشّموس الغارباتُ بِغُرَّب",6,"ب",1,0],["هَل طَيِّئُ الأَجبالِ شاكِرَةُ اِمرِئٍ","ذادَ القَوافي عَن حِماها الأَقعَسِ",7,"س",1,0],["هل طلعة اليمن في أفق المنى طلعت","ومن مطالعها الانوا وقد سطعت",8,"ت",1,1],["هل طال عنك غيابه فلحقته","ومللت عيش الاربع الادراس",9,"س",1,0],["هل طابت النفس في مضمار عاجلة","ضحك بكاءٌ بها الأَفراح أَحزانُ",10,"ن",1,0],["هل طالعتك على الريَّان اظعان","ام قابلتك بريا البان غزلانُ",11,"ن",1,1],["هل طريق الى اللقا يابن ودّي","ويقين الى اللقا لا طريق",12,"ق",1,0],["هل طالب ثار من قد أهدرت دمه","بيض عليهن نذر قتل من عشقا",13,"ق",2,1],["هل طالع الناس منك سعد","يرمي إلى ذروة الكمال",14,"ل",1,0],["هل طالبٌ خبزةً يعطونهُ حجراً","أم راغبٌ خزَّةً يحبونهُ صوفا",15,"ف",2,0],["هلّ طيف حفّ روحي كالرؤى","هَفْهَفٌ(10 ) جاد بسحر زارني",16,"ن",2,0],["هَلْ طَرَحْنَاْ مِنْ نَدَاْنَاْ فَرْضَ دَمْعٍ أَوْ نِفَالْ","نَحْنُ مَاْ بَعْدُ احْتَنَفْنَاْ واحْتَرَفْنَاْهُ نِضَالْ",17,"ل",1,0],["هَلْ طَالَ لَيْلُكَ،أَمْ أَفْلاَكُهُ رَحَلَتْ؟","غَابَ اَلسُّهَا،وَ أَمَاتَ اَلْمُشْتَرِي اَلْقَمَرَا",18,"ر",2,0],["هَلْ طَالَ لَيْلُكَ يَا لَيْلِي أَمِ اِنْفَطَرَتْ","رُوحٌ تَرَاكَ جُنُوناً مَاجِناً خَطِرَا؟!",18,"ر",2,0],["هل طال في فصل الشتاء نهار ؟","أم جاء بعد روية آذار ؟",19,"ر",1,1],["هل طرفه الأكحل أم خده","أم قده فالجسم رعبوب",20,"ب",1,0],["هل طابَ ليلك والأحلامُ مُنجزة","أم أنّ حلمك عند الفجرِ أخبارُ",21,"ر",1,0],["هل طال قانون البلاد مفرّطاً","أم آل سلطان القضا لخناسِ",22,"س",1,0],["هل طواني في حب قدسٍ بعادٌ","أم بها العشق سلوة فأذابا",23,"ب",2,0],["هل طي عرفك لي يا نسمة السحر","عن نازلي الكعبة الغراء من خبر؟",24,"ر",1,1],["هل طال ليلكِ ذي جفونكِ تحرسُهْ","ترجو الصباح نسيمه تتنفسُهْ",25,"س",2,1],["هل طابت الْأيَّامُ بعْد غيابي","يا من هواْها جنّتيْ وعذابي",26,"ب",2,1],["هل طفلةٌ عمرُها شهرٌ وإخوتُها","ما فوقَهُ ، أحدثوا في أرضكم أَثَرا ؟",27,"ر",2,0]]}