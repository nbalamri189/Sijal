{"poems":[[105,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[106,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[223,"وترامى الصباح فوق الهضاب","https://www.aldiwan.net/poem41603.html","الخفيف"],[303,"قلت لصحب زارهم شادن","https://www.aldiwan.net/poem57796.html","السريع"],[342,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[364,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[553,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"]],"verses":[["هل طَواكَ الموتُ عنّا أم طوى","بأسُك العاصفُ منه الهِمَما",0,"م",2,0],["هَل طَوى الدَهرُ مِن اِبنِيَ إِلّا","سابقَ النَدِّ وَزين النَديِّ",1,"ي",1,0],["هل طاب عيشك بيننا، يا ابن الشرى","ورضيت بالقفص الحديد عرينا؟",2,"ن",2,0],["هَل طَواها الَّذي طَوى مَن أَحَبَّت","أَم تُراها عادَت لِذاكَ التَصابي",3,"ب",2,0],["هل طاف بالكأس فقالوا نعم","وكاس لما شرب الكاسا",4,"س",2,0],["هل طار في الجو","ام سال في الماء",5,"ا",2,0],["هل طالعاتٌ بالطُويْلعِ غُدوةً","تلك الشّموس الغارباتُ بِغُرَّب",6,"ب",1,0],["هَل طَيِّئُ الأَجبالِ شاكِرَةُ اِمرِئٍ","ذادَ القَوافي عَن حِماها الأَقعَسِ",7,"س",1,0]]}