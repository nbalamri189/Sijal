{"poems":[[55,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[48,"يا روح شخصي منزل أو طنته","https://www.aldiwan.net/poem23425.html","الكامل"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[47,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[280,"أحسنوا العطف عليها مهجا","https://www.aldiwan.net/poem25608.html","الرمل"],[287,"من مجيري من جور حلو المعاني","https://www.aldiwan.net/poem32329.html","الخفيف"],[520,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[543,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[563,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75792","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120030","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59172","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56335","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78120","الرمل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107306","الرمل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48208","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48267","الخفيف"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107009","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100898","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100884","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101874","الرمل"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13018","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138472",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91531","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85069","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85008","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131253",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133300","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76439","الرمل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75713","الرمل"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131666",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72369","الخفيف"],[5277,"سيدي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=201721",""],[5449,"عن القصيدة الفاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=188871",""],[6113,"منال .........!!!","https://www.poetsgate.com/ViewPoem.aspx?id=26380",""]],"verses":[["أَنتَ ثاني جِماحِها يَومَ لا يَم","لِكُ كَفٌّ لِجامِحِ الخَطبِ كَفّا",0,"ف",2,0],["إن تُثب جسمَك النعيم فبالإتْ","عابِ في حالِ راحة الأبدان",1,"ن",1,0],["إِن تَثوِ في دارِ الجِنانِ فَإِنَّما","فارَقتَ مِن دُنياكَ ناراً تَحتَدِم",2,"م",1,0],["إنْ تَثَنّتْ فَقَضِيبٌ في نَقاً","مُثْمِرٌ بَدْرَ دُجى فَرْعِ ظُمَي",3,"ي",1,0],["إنْ تَثنِ إسحاقَ بنِ كِنداجيقَ بي","أرْضٌ فكُلُّ الصّيْدِ في جَوْفِ الفَرَا",4,"ر",2,0],["إنْ تَثَنَّت فَقَضيباً أمْلَداً","أو تَجَلّت فَصَبَاحاً أبْلَجا",5,"ج",2,0],["إِن تَثَنّى عَلى الحِصانِ تَمَنّى","لَثمَهُ كُلُّ مُحصِنٍ وَحَصانِ",6,"ن",1,0],["أنت ثبتها برغم المداجي","في بداياتها ورغم المعادي",7,"د",2,0],["إن تَثَنَّت غُصناً تَغنَّت هَزَارا","فَوقَه بِغِنَائِهِ يُشجِينَا",8,"ن",2,0],["إن تثنَّى فغصنُ بانٍ رطيبٍ","قابضٍ كلَّ مهجة باليمين",9,"ن",1,0],["ان تَثنى أَو تَجَنّى جذلا","ما تَثنى السهم أَو طيّ العنم",10,"م",1,0],["أنت ثبير ما احتبى جالسا","وأيد في الروع فخم جهير",11,"ر",1,0],["إنْ تَثَنَّى هَزَّ رمحًا قدُّهُ","أوْ رَنَا سَلَّ من اللحظ ظُبَى",12,"ب",2,0],["إن تثنّت ميداً تزرّي الأَسلْ","أو رنت أنستك ضرب المرهفِ",13,"ف",1,0],["أَن تَثنى بَينَ أَرباب الغَرام","قَده يَزري الغُصون المايلات",14,"ت",1,0],["إن تَثنَّى هزَّ غُصناً","أَو رَنا سَلَّ حُساما",15,"م",2,0],["إن تثني الغصن تيها بالضحى","كَم من الغصن الهَوى يَوما قتل",16,"ل",1,0],["إِن تَثَنَّى بابتسامٍ خلتَهُ","غصنَ بان رُصّعتْ فيه الدررْ",17,"ر",1,0],["إِن تثنَّتْ وسلَّمتْ ببنانٍ","شِمْتَ شمساً تهتزُّ في غُصْنِ بانِ",18,"ن",1,0],["ان تثنيت خلتني غصن بان","أو تغنيت خلتني قمريه",19,"ي",2,0],["إن تثمرِى وتظلى لا مردَّ لنَا","على جَناكِ وتحتَ الظلِّ نزدَحِم",20,"م",1,0],["إن تُثرها أثرت قاطعة النا","ب وهيَّجت مرَّةَ الأسنان",21,"ن",1,0],["إن تثنى بين بانات اللوى","أو تهادى ثاني العطفين",22,"ن",1,0],["أن تثني هزّ من أعطافه","صعدة تهزء بالسمر الصعاد",23,"د",1,0],["أَنتَ ثَقَّفتَ قَناةَ ال","مُلكِ مِن بَعدِ اِعوِجاجِ",24,"ج",1,0],["أنت ثاني الآباء في منتهى الدو","ر وهاديهم لما جهلوه",25,"و",2,0],["إِن تَثنّى قُلتُ بانٌ بانَ لي","أَو رَنا لي وَهوَ رامٍ قُلتُ ريم",26,"م",1,0],["أن تثني فاق أغصان النقا","أو تجلى فأق بدر الحندس",27,"س",1,0],["أَن تَثني نادَيتُهُ غُصنَ بانٍ","أَو تَغني نادَيتُهُ يا حَمامَه",28,"م",2,0],["أنت ثبت الجنان تقتحم الحر","ب جريئاً دمت عنها بعيدا",29,"د",2,0],["إن تثقفوهم يولوكم ظهورهم","ويرجعون إلى التاميز سياحا",30,"ح",2,0],["أَنت ثقل فوقنا لما يخف","أَنت فوق الصاعقات الماحقات",31,"ت",1,0],["إِن تثنى أَو بَدا مُبتَسِماً","فضح البدر وأزري بالغصون",32,"ن",1,0],["إن تثنى قلت سارت ذرة","أو من النامس محبوب وصل",33,"ل",1,0],["أنت ثاني الآباء في منتهى الدو","رو آباؤه تعدَّ بنوه",34,"و",2,0],["أنتَ ثوبُ العشقِ يا خيطَ الصبا","أنتَ بوحُ الشمسِ في أدنى السحرْ",35,"ر",1,0],["إِنْ تَثْمَلِ الرُّوحُ مِنْ حَرْفٍ لَهُ شَرِبتْ","فالقلبُ گرْمٌ وفيهِ الحرفُ يُعْتَصَرُ",36,"ر",1,0],["انتثرحزني وصارالحال حال","واختلف لوني واحس اني انتهيت",37,"ت",1,0]]}