{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[46,"يا روح شخصي منزل أو طنته","https://www.aldiwan.net/poem23425.html","الكامل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[45,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[275,"أحسنوا العطف عليها مهجا","https://www.aldiwan.net/poem25608.html","الرمل"],[282,"من مجيري من جور حلو المعاني","https://www.aldiwan.net/poem32329.html","الخفيف"],[515,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[538,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[558,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"]],"verses":[["أَنتَ ثاني جِماحِها يَومَ لا يَم","لِكُ كَفٌّ لِجامِحِ الخَطبِ كَفّا",0,"ف",2,0],["إن تُثب جسمَك النعيم فبالإتْ","عابِ في حالِ راحة الأبدان",1,"ن",1,0],["إِن تَثوِ في دارِ الجِنانِ فَإِنَّما","فارَقتَ مِن دُنياكَ ناراً تَحتَدِم",2,"م",1,0],["إنْ تَثَنّتْ فَقَضِيبٌ في نَقاً","مُثْمِرٌ بَدْرَ دُجى فَرْعِ ظُمَي",3,"ي",1,0],["إنْ تَثنِ إسحاقَ بنِ كِنداجيقَ بي","أرْضٌ فكُلُّ الصّيْدِ في جَوْفِ الفَرَا",4,"ر",2,0],["إنْ تَثَنَّت فَقَضيباً أمْلَداً","أو تَجَلّت فَصَبَاحاً أبْلَجا",5,"ج",2,0],["إِن تَثَنّى عَلى الحِصانِ تَمَنّى","لَثمَهُ كُلُّ مُحصِنٍ وَحَصانِ",6,"ن",1,0],["أنت ثبتها برغم المداجي","في بداياتها ورغم المعادي",7,"ي",1,0],["إن تَثَنَّت غُصناً تَغنَّت هَزَارا","فَوقَه بِغِنَائِهِ يُشجِينَا",8,"ن",2,0],["إن تثنَّى فغصنُ بانٍ رطيبٍ","قابضٍ كلَّ مهجة باليمين",9,"ن",1,0]]}