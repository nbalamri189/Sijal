{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[53,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[55,"وما طبت نفسا عنك لما هجرتني","https://www.aldiwan.net/poem26314.html","الطويل"],[42,"وما طلب المعيشة بالتمني","https://www.aldiwan.net/poem50345.html","الوافر"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[54,"أفيقي من ملامك يا ظعينا","https://www.aldiwan.net/poem27460.html","الوافر"],[88,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[14,"أعيرتموني أن أمي تريعة","https://www.aldiwan.net/poem38291.html","الطويل"],[14,"إذا المرء لم يطلب معاشا لنفسه","https://www.aldiwan.net/poem38299.html","الطويل"],[70,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[43,"لكل امرئ من دهره ما تعودا","https://www.aldiwan.net/poem9529.html","الطويل"],[62,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[62,"ألم تر أن الصبر للشكر توأم","https://www.aldiwan.net/poem52422.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[45,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[45,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[28,"إني لأستحيي وإني لفاخر","https://www.aldiwan.net/poem1258.html",""],[28,"ولما دعا الداعون وانشقت العصا","https://www.aldiwan.net/poem5324.html","الطويل"],[28,"ترى كل منشق القميص كأنما","https://www.aldiwan.net/poem5398.html","الطويل"],[28,"ليبك ابن ليلى كل سار لنائل","https://www.aldiwan.net/poem5436.html","الوافر"],[28,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[66,"لدوا للموت وابنوا للخراب","https://www.aldiwan.net/poem40118.html","الوافر"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[105,"عيينة أمسكت العجوز تريدها","https://www.aldiwan.net/poem44035.html","الطويل"],[52,"ما صائدات ليس بارهات","https://www.aldiwan.net/poem27190.html","الرجز"],[48,"سقاني أبو بشر من الراح شربة","https://www.aldiwan.net/poem10779.html","الطويل"],[46,"سقينا بفضل الله والأرض منزل","https://www.aldiwan.net/poem23035.html","الطويل"],[46,"أمالي الزمان على بنيه","https://www.aldiwan.net/poem23236.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10807","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[45,"أقَصْرَ حُمَيدٍ! لا عَزَاءَ لمَغْرَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31730",""],[28,"إن الذي أعطى الرجال حظوظهم","https://www.poetsgate.com/ViewPoem.aspx?id=20005",""],[58,"وما طلب المعيشة بالتمني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15478&r=&rc=6",""]],"verses":[["وَما طالَ لَيلي غَيرَ أَنَّ عَلاقَةً","بِقَلبِيَ تَستَقري بِعَيني الدَرارِيا",0,"ي",2,0],["وَماطَلَ قَلباً بِإِبلالِهِ","مِطالُ الغَريمِ وَلَيّانُهُ",1,"ن",2,0],["وَما طابَت غَوادي المُزنِ إِلّا","أَطَبنَ وَقائِعَ الماءِ الزُلالِ",2,"ل",1,0],["وَما طَلَبُ البَذلِ مِن باخِلٍ","بِمَيسورِهِ غَيرُ داءِ عُضالِ",3,"ل",1,0],["وَما طِبتُ نَفساً عَنكِ لَمّا هَجَرتِني","وَلَيسَ سُكوتي عَن سُلُوٍّ وَلا صَبرِ",4,"ر",1,1],["وَما طَلَبُ المَعيشَةِ بِالتَمَنّي","وَلَكِن أَلقِ دَلوَكَ في الدِلاءِ",5,"ا",2,1],["وَما طِلابُكَ شَيئاً لَستَ مُدرِكَهُ","إِن كانَ عَنكَ غُرابُ الجَهلِ قَد وَقَعا",6,"ع",2,0],["وَما طَلَبُ الكُميتِ طِلابُ وِترٍ","وَلَكِنّا لِنُصرَتِنا هُجينا",7,"ن",2,0],["وما طلعت كي تَهدي القومَ شمسُه","ولكن لتُصليهم جحيم الودائق",8,"ق",1,0],["وَمَا طَلَبُوا إلَيهِ دماً ولَكِن","أَثَاثَ المجدِ والحَسَبَ المَصُونَا",9,"ن",2,0],["وما طلبُ الرِّفْد الهَنيء ببدعةٍ","ولا عجبُ المُسترفدِيهِ بعاجبِ",10,"ب",1,0],["وما طَعِمتْ جفوني الغمضَ حتى","حللتُ عِراصَ دور بني حبيبِ",11,"ب",1,0],["وماطلَ فوقها نَزْواً مريضاً","كنزوِ مُسَخَّرٍ لا يَشْتَهيكا",12,"ك",2,0],["وما طولُ عمر لا أبا لك ينقضي","وما خيرُ عيشٍ قصرُ وجدانه العدمْ",13,"م",1,0],["وَما طالِبُ الأَوتارِ إِلّا اِبنُ حُرَّةٍ","طَويلُ نَجادِ السَيفِ عاري الأَشاجِعِ",14,"ع",1,0],["وَما طالِبُ الحاجاتِ مِن كُلِّ وِجهَةٍ","مِنَ الناسِ إِلّا مَن أَجَدَّ وَشَمَّرا",15,"ر",2,0],["وَما طابَ ماءُ النيلِ إِلّا لِأَنَّهُ","يَحُلُّ مَحَلَّ الريقِ مِن ذَلِكَ الثَغرِ",16,"ر",1,0],["وَما طَرَبي لَمّا رَأَيتُكَ بِدعَةً","لَقَد كُنتُ أَرجو أَن أَراكَ فَأَطرَبُ",17,"ب",1,0],["وَما طَلَبَت زُرقُ الأَسِنَّةِ غَيرَهُ","وَلَكِنَّ قُسطَنطينَ كانَ لَهُ الفِدا",18,"د",2,0],["وما طردَ الأحرارَ مثلُ مهانةٍ","تُذالُ بها أعراضُهم وتُضَامُ",19,"م",1,0],["وما طابَ نشرُ الروض إلّا لأنّهُ","شكورٌ لما أسدَتْ إليه يَدُ القَطْرِ",20,"ر",1,0],["وما طابَ نَشْرُ الريحِ إلا وعندَها","أخابِيرُ من نَجْدٍ ومن ساكِني نَجْدِ",21,"د",1,0],["وَما طَرَفا زَمانِ المَرءِ إِلّا","مُقامٌ يَرتَضيهِ أَو رَحيلُ",22,"ل",1,0],["وَما طَعَنوا إِلّا بِرُمحٍ مُوَصَّلٍ","وَما ضَرَبوا إِلّا بِسَيفٍ مُثَلَّمِ",23,"م",1,0],["وَما طَيِّءٌ إِلّا قَبائِلُ أُنزِلَت","إِلى أَهلِ عَينِ التَمرِ مِن كُلِّ جانِبِ",24,"ب",1,0],["وَما طَعِمَت مِن مَشرَبٍ مُذ سَقَيتَها","بِتَدمُرَ إِلّا مَرَّةً بِالشَفائِفِ",25,"ف",1,0],["وَما طَمِعَت بِالأَرضِ رائِحَةً بِنا","إِلى الغَدِ حَتّى يَنقُلَ الظِلَّ ناقِلُه",26,"ل",2,0],["وَما طَرَقَ السُؤالُ مِثلَ اِبنِ غالِبٍ","لِأَمرَينِ جَلّا مِن عِقابٍ وَنائِلِ",27,"ل",1,0],["وَما طَيِّئٌ وَاللُؤمُ فَوقَ رِقابِهِم","وَلَم تَرِمِ الأَحمالُ عَنها بِرائِمِ",28,"م",1,0],["وَما طيبُ الحَياةِ بِغَيرِ بِشرٍ","وَلا حُسنُ السَماءِ بِلا شِهابِ",29,"ب",1,0],["وما طابَ عَرْفٌ من سُرَاها وإنّما","تَطَيّبُ في جنح الدّجى بِسُرَى هِندِ",30,"د",1,0],["وما طَمَعُ الإنسانِ فيما يفوته","إذا ما دَعَا الدّاعِي فَوَلَّى وأدبرا",31,"ر",2,0],["وَما طَعامٌ ظَلَّ بِالفَلاةِ","يُقَرِّبُ المَوتَ مِنَ الحَياةِ",32,"ه",1,0],["وَما طَبَخوها غَيرَ أَنَّ غُلامَهُم","مَشى في نَواحي كَرمِها بِشِهابِ",33,"ب",1,0],["وَما طَهَّرَت بِالعُشرِ خَمسَةَ أَوسُقٍ","نُفوسٌ أَقَلَّت مِن مَآثِمِها وِسقا",34,"ق",2,0],["وَما طَيرُ اليَمينِ بِمُبهِجاتي","فَأَخشى الهَمَّ مِن طَيرِ الشِمالِ",35,"ل",1,0],["وَما طلب الوالي نَديماً وَما له","لعمرك في شأن الحكومة أُصبُع",36,"ع",1,0],["وما طابَ في هَذِي البَرِيَّةِ آخرٌ","إِذا هُو لم يُنْجَدْ بطِيبِ الأَوائِلِ",37,"ل",1,0],["وَما طَلَعَت شَمسٌ لَدى كُلِّ شارِقٍ","وَما هَطَلَت عَينٌ عَلى واضِحِ النَحرِ",38,"ر",1,0],["وما طَلَبي سُؤالاً بعدَ خُبرٍ","نَمَاهُ الُموضِعونَ إلى الشَّعوبِ",39,"ب",1,0],["وَمَا طِيَّتِي غَيْرَ أَنِّي وَقَفْ","تُ بآثَارِ فَنٍّ عَدَاهَا الفَنَاءْ",40,"ا",2,0],["وَما طَمَعي أَن يَعرِفَ القَومُ قيمَتي","وَسيّانَ فَضلٌ عِندَهُم وَفُضولُ",41,"ل",1,0],["وَما طَلَعَت شَمسٌ وَحانَ غُروبُها","وَبِاللَيلِ أَبكيهِم وَبِالغَدَواتِ",42,"ت",1,0],["وما طَنُّ الذبابِ سوى نُواحٍ","وقد حصدته أيدي العلم حصدا",43,"د",2,0],["وما طيبَ عيشٌ ليس يَشْعُرُ أهلُهُ","بلذَّتِه إلا إذا صار ماضيا؟",44,"ي",2,0],["وما طال عهدٌ من رسالة أحَمدٍ","وما زالَ عودُ الملك رّيانَ اخضَرا",45,"ر",2,0],["وما طال عصر الظلم إلا لحكمة","تنبيء أن لابد تدنو المصارع",46,"ع",1,0],["وَمَا طَعَنُوا إلا ّ برُمْحٍ عَمْرٍ مُوَصَّلٍ،","ومَا ضَرَبُوا إلاّ بسَيْفٍ مُثَلَّمِ",47,"م",1,0],["وَما طَيّءٌ، واللّؤمُ فَوْقَ رِقَابِهِمْ،","وَلمْ تَرِمِ الأحْبَالُ عَنْهَا بِرَائِمِ",48,"م",1,0],["وما طلب المعيشة بالتمني","وَلَكِنْ أَلْقِ دَلْوَكَ مع الدِّلاَءِ",49,"ا",2,1]]}