{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[53,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[55,"وما طبت نفسا عنك لما هجرتني","https://www.aldiwan.net/poem26314.html","الطويل"],[42,"وما طلب المعيشة بالتمني","https://www.aldiwan.net/poem50345.html","الوافر"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[54,"أفيقي من ملامك يا ظعينا","https://www.aldiwan.net/poem27460.html","الوافر"],[88,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[14,"أعيرتموني أن أمي تريعة","https://www.aldiwan.net/poem38291.html","الطويل"],[14,"إذا المرء لم يطلب معاشا لنفسه","https://www.aldiwan.net/poem38299.html","الطويل"],[70,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[43,"لكل امرئ من دهره ما تعودا","https://www.aldiwan.net/poem9529.html","الطويل"],[62,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[62,"ألم تر أن الصبر للشكر توأم","https://www.aldiwan.net/poem52422.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[45,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[45,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[28,"إني لأستحيي وإني لفاخر","https://www.aldiwan.net/poem1258.html",""],[28,"ولما دعا الداعون وانشقت العصا","https://www.aldiwan.net/poem5324.html","الطويل"],[28,"ترى كل منشق القميص كأنما","https://www.aldiwan.net/poem5398.html","الطويل"],[28,"ليبك ابن ليلى كل سار لنائل","https://www.aldiwan.net/poem5436.html","الوافر"],[28,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[66,"لدوا للموت وابنوا للخراب","https://www.aldiwan.net/poem40118.html","الوافر"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[105,"عيينة أمسكت العجوز تريدها","https://www.aldiwan.net/poem44035.html","الطويل"],[52,"ما صائدات ليس بارهات","https://www.aldiwan.net/poem27190.html","الرجز"],[48,"سقاني أبو بشر من الراح شربة","https://www.aldiwan.net/poem10779.html","الطويل"],[46,"سقينا بفضل الله والأرض منزل","https://www.aldiwan.net/poem23035.html","الطويل"],[46,"أمالي الزمان على بنيه","https://www.aldiwan.net/poem23236.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10807","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[45,"أقَصْرَ حُمَيدٍ! لا عَزَاءَ لمَغْرَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31730",""],[28,"إن الذي أعطى الرجال حظوظهم","https://www.poetsgate.com/ViewPoem.aspx?id=20005",""],[58,"وما طلب المعيشة بالتمني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15478&r=&rc=6",""],[121,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[121,"لهان علي أن ألقى حمامي","https://www.aldiwan.net/poem49367.html","الوافر"],[144,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[144,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[161,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[170,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[170,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[186,"عتبت ولكنني لم أع","https://www.aldiwan.net/poem14581.html","المتقارب"],[186,"يجل اشتياقي أن أقول له وصفا","https://www.aldiwan.net/poem14599.html","الطويل"],[187,"وما طابت الدنيا بأكل ونعمة","https://www.aldiwan.net/poem43720.html","الطويل"],[211,"بعيشك دع ما قد مضى يا ابن يوسفا","https://www.aldiwan.net/poem13486.html","الطويل"],[212,"ألفت النوح بعدك والسهودا","https://www.aldiwan.net/poem46565.html","الوافر"],[262,"لكل من الدنيا مرام يحده","https://www.aldiwan.net/poem38188.html","الطويل"],[262,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[263,"سقاني أبو بشر من الراح شربة","https://www.aldiwan.net/poem68180.html","الطويل"],[276,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[281,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[281,"متى أنا طاعن قلب الفجاج","https://www.aldiwan.net/poem60722.html","الوافر"],[283,"وبين نهيري الشاغور قوم","https://www.aldiwan.net/poem32719.html","الوافر"],[323,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[354,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[365,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[365,"طربت لإلمام الخيال المعاود","https://www.aldiwan.net/poem60962.html","الطويل"],[403,"زمان على الأحرار قد جار في الحكم","https://www.aldiwan.net/poem46420.html","الطويل"],[407,"أرى الشعب فانظر دونه هل هو الشعب","https://www.aldiwan.net/poem50205.html","الطويل"],[410,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[417,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[454,"يا آبد البط سباحا بلا وجل","https://www.aldiwan.net/poem61314.html","البسيط"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[462,"ترفعت عن مدح الرجال وقادني","https://www.aldiwan.net/poem15117.html","الطويل"],[462,"رعاك ضمان الله ما أظلم الدجى","https://www.aldiwan.net/poem15657.html","الطويل"],[462,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[465,"جلت عزماتك الفتح المبينا","https://www.aldiwan.net/poem3115.html","عموديه"],[465,"أهذا ثناء من كلامك أم سحر","https://www.aldiwan.net/poem3297.html","عموديه"],[471,"أيا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem4800.html","الطويل"],[501,"مر حبيبي ووقف","https://www.aldiwan.net/poem37955.html","مجزوء الرجز"],[539,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[552,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[563,"أخاف إذا أشار براحتيه","https://www.aldiwan.net/poem52973.html","الوافر"],[563,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[568,"تولى الله من رقدا","https://www.aldiwan.net/poem69723.html","مجزوء الوافر"],[570,"أخاك أخاك إن من لا أخا له","https://www.aldiwan.net/poem52034.html","الطويل"],[576,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[576,"عسى أن يسر السائرين إياب","https://www.aldiwan.net/poem3102.html","الطويل"],[577,"خليلي إما مت يوما وزحزحت","https://www.aldiwan.net/poem1781.html","الطويل"]],"verses":[["وَما طالَ لَيلي غَيرَ أَنَّ عَلاقَةً","بِقَلبِيَ تَستَقري بِعَيني الدَرارِيا",0,"ي",2,0],["وَماطَلَ قَلباً بِإِبلالِهِ","مِطالُ الغَريمِ وَلَيّانُهُ",1,"ن",2,0],["وَما طابَت غَوادي المُزنِ إِلّا","أَطَبنَ وَقائِعَ الماءِ الزُلالِ",2,"ل",1,0],["وَما طَلَبُ البَذلِ مِن باخِلٍ","بِمَيسورِهِ غَيرُ داءِ عُضالِ",3,"ل",1,0],["وَما طِبتُ نَفساً عَنكِ لَمّا هَجَرتِني","وَلَيسَ سُكوتي عَن سُلُوٍّ وَلا صَبرِ",4,"ر",1,1],["وَما طَلَبُ المَعيشَةِ بِالتَمَنّي","وَلَكِن أَلقِ دَلوَكَ في الدِلاءِ",5,"ا",2,1],["وَما طِلابُكَ شَيئاً لَستَ مُدرِكَهُ","إِن كانَ عَنكَ غُرابُ الجَهلِ قَد وَقَعا",6,"ع",2,0],["وَما طَلَبُ الكُميتِ طِلابُ وِترٍ","وَلَكِنّا لِنُصرَتِنا هُجينا",7,"ن",2,0],["وما طلعت كي تَهدي القومَ شمسُه","ولكن لتُصليهم جحيم الودائق",8,"ق",1,0],["وَمَا طَلَبُوا إلَيهِ دماً ولَكِن","أَثَاثَ المجدِ والحَسَبَ المَصُونَا",9,"ن",2,0],["وما طلبُ الرِّفْد الهَنيء ببدعةٍ","ولا عجبُ المُسترفدِيهِ بعاجبِ",10,"ب",1,0],["وما طَعِمتْ جفوني الغمضَ حتى","حللتُ عِراصَ دور بني حبيبِ",11,"ب",1,0],["وماطلَ فوقها نَزْواً مريضاً","كنزوِ مُسَخَّرٍ لا يَشْتَهيكا",12,"ك",2,0],["وما طولُ عمر لا أبا لك ينقضي","وما خيرُ عيشٍ قصرُ وجدانه العدمْ",13,"م",1,0],["وَما طالِبُ الأَوتارِ إِلّا اِبنُ حُرَّةٍ","طَويلُ نَجادِ السَيفِ عاري الأَشاجِعِ",14,"ع",1,0],["وَما طالِبُ الحاجاتِ مِن كُلِّ وِجهَةٍ","مِنَ الناسِ إِلّا مَن أَجَدَّ وَشَمَّرا",15,"ر",2,0],["وَما طابَ ماءُ النيلِ إِلّا لِأَنَّهُ","يَحُلُّ مَحَلَّ الريقِ مِن ذَلِكَ الثَغرِ",16,"ر",1,0],["وَما طَرَبي لَمّا رَأَيتُكَ بِدعَةً","لَقَد كُنتُ أَرجو أَن أَراكَ فَأَطرَبُ",17,"ب",1,0],["وَما طَلَبَت زُرقُ الأَسِنَّةِ غَيرَهُ","وَلَكِنَّ قُسطَنطينَ كانَ لَهُ الفِدا",18,"د",2,0],["وما طردَ الأحرارَ مثلُ مهانةٍ","تُذالُ بها أعراضُهم وتُضَامُ",19,"م",1,0],["وما طابَ نشرُ الروض إلّا لأنّهُ","شكورٌ لما أسدَتْ إليه يَدُ القَطْرِ",20,"ر",1,0],["وما طابَ نَشْرُ الريحِ إلا وعندَها","أخابِيرُ من نَجْدٍ ومن ساكِني نَجْدِ",21,"د",1,0],["وَما طَرَفا زَمانِ المَرءِ إِلّا","مُقامٌ يَرتَضيهِ أَو رَحيلُ",22,"ل",1,0],["وَما طَعَنوا إِلّا بِرُمحٍ مُوَصَّلٍ","وَما ضَرَبوا إِلّا بِسَيفٍ مُثَلَّمِ",23,"م",1,0],["وَما طَيِّءٌ إِلّا قَبائِلُ أُنزِلَت","إِلى أَهلِ عَينِ التَمرِ مِن كُلِّ جانِبِ",24,"ب",1,0],["وَما طَعِمَت مِن مَشرَبٍ مُذ سَقَيتَها","بِتَدمُرَ إِلّا مَرَّةً بِالشَفائِفِ",25,"ف",1,0],["وَما طَمِعَت بِالأَرضِ رائِحَةً بِنا","إِلى الغَدِ حَتّى يَنقُلَ الظِلَّ ناقِلُه",26,"ل",2,0],["وَما طَرَقَ السُؤالُ مِثلَ اِبنِ غالِبٍ","لِأَمرَينِ جَلّا مِن عِقابٍ وَنائِلِ",27,"ل",1,0],["وَما طَيِّئٌ وَاللُؤمُ فَوقَ رِقابِهِم","وَلَم تَرِمِ الأَحمالُ عَنها بِرائِمِ",28,"م",1,0],["وَما طيبُ الحَياةِ بِغَيرِ بِشرٍ","وَلا حُسنُ السَماءِ بِلا شِهابِ",29,"ب",1,0],["وما طابَ عَرْفٌ من سُرَاها وإنّما","تَطَيّبُ في جنح الدّجى بِسُرَى هِندِ",30,"د",1,0],["وما طَمَعُ الإنسانِ فيما يفوته","إذا ما دَعَا الدّاعِي فَوَلَّى وأدبرا",31,"ر",2,0],["وَما طَعامٌ ظَلَّ بِالفَلاةِ","يُقَرِّبُ المَوتَ مِنَ الحَياةِ",32,"ه",1,0],["وَما طَبَخوها غَيرَ أَنَّ غُلامَهُم","مَشى في نَواحي كَرمِها بِشِهابِ",33,"ب",1,0],["وَما طَهَّرَت بِالعُشرِ خَمسَةَ أَوسُقٍ","نُفوسٌ أَقَلَّت مِن مَآثِمِها وِسقا",34,"ق",2,0],["وَما طَيرُ اليَمينِ بِمُبهِجاتي","فَأَخشى الهَمَّ مِن طَيرِ الشِمالِ",35,"ل",1,0],["وَما طلب الوالي نَديماً وَما له","لعمرك في شأن الحكومة أُصبُع",36,"ع",1,0],["وما طابَ في هَذِي البَرِيَّةِ آخرٌ","إِذا هُو لم يُنْجَدْ بطِيبِ الأَوائِلِ",37,"ل",1,0],["وَما طَلَعَت شَمسٌ لَدى كُلِّ شارِقٍ","وَما هَطَلَت عَينٌ عَلى واضِحِ النَحرِ",38,"ر",1,0],["وما طَلَبي سُؤالاً بعدَ خُبرٍ","نَمَاهُ الُموضِعونَ إلى الشَّعوبِ",39,"ب",1,0],["وَمَا طِيَّتِي غَيْرَ أَنِّي وَقَفْ","تُ بآثَارِ فَنٍّ عَدَاهَا الفَنَاءْ",40,"ا",2,0],["وَما طَمَعي أَن يَعرِفَ القَومُ قيمَتي","وَسيّانَ فَضلٌ عِندَهُم وَفُضولُ",41,"ل",1,0],["وَما طَلَعَت شَمسٌ وَحانَ غُروبُها","وَبِاللَيلِ أَبكيهِم وَبِالغَدَواتِ",42,"ت",1,0],["وما طَنُّ الذبابِ سوى نُواحٍ","وقد حصدته أيدي العلم حصدا",43,"د",2,0],["وما طيبَ عيشٌ ليس يَشْعُرُ أهلُهُ","بلذَّتِه إلا إذا صار ماضيا؟",44,"ي",2,0],["وما طال عهدٌ من رسالة أحَمدٍ","وما زالَ عودُ الملك رّيانَ اخضَرا",45,"ر",2,0],["وما طال عصر الظلم إلا لحكمة","تنبيء أن لابد تدنو المصارع",46,"ع",1,0],["وَمَا طَعَنُوا إلا ّ برُمْحٍ عَمْرٍ مُوَصَّلٍ،","ومَا ضَرَبُوا إلاّ بسَيْفٍ مُثَلَّمِ",47,"م",1,0],["وَما طَيّءٌ، واللّؤمُ فَوْقَ رِقَابِهِمْ،","وَلمْ تَرِمِ الأحْبَالُ عَنْهَا بِرَائِمِ",48,"م",1,0],["وما طلب المعيشة بالتمني","وَلَكِنْ أَلْقِ دَلْوَكَ مع الدِّلاَءِ",49,"ا",2,1],["وما طال عمري غير أن لواعجاً","أطلن عناني فاجتويت مفاميا",50,"ي",2,0],["وما طاف الكرى بالعين إلّا","ليفتحها على الكرب العظام",51,"م",1,0],["وَما طالِبُ الدُرِّ مِن بَحرِهِ","كَمَن ظَلَّ يَطلُبُهُ مِن نَهَر",52,"ر",1,0],["وَما طَلَبتُ الغِنى حَتّى عَمَمتَ بِهِ","وَكانَ مِثلُكَ هَيناً عِندَهُ العَدَمُ",53,"م",1,0],["وما طولكم ممن تؤدى فروضه","وهل شكر من ربي مجاز لمن ربا",54,"ب",2,0],["وَما طَلَبي سِوى لِقيانِ مَلكٍ","يَلوحُ ضِياءُ غُرَّتِهِ اِتِّقادا",55,"د",2,0],["وَما طَلَبي العَلياءَ إِرثُ كَلالَةٍ","فَيَقصُرُ خَطوي دُونَها فَأَسُوعُها",56,"ع",3,0],["وما طَلبي منه إلا الحديث","اقول له هاتِ أو فاسْمَع",57,"ع",1,0],["وما طائرٌ قَصَّ الزمانُ جناحَه","وأَعْدَمَه وَكْرا وأَفْقَده إِلْفا",58,"ف",2,0],["وما طابت الدنيا بأكل ونعمة","وشرب وتتريف ولبس جليس",59,"س",1,1],["وما طال ذاك البعد الا لشقوتي","وحاشاك من هذا التباعد والجفا",60,"ف",2,0],["وما طمع المعذّب أن يراكم","وقد ضنّ الخيال بأن يعودا",61,"د",2,0],["وما طمعي اني أدوم مخلداً","ولا هذه الدنيا بدار دوام",62,"م",1,0],["وما طال إلا ليل من طال همه","ولا زاد الاهم من زاده فكرا",63,"ر",2,0],["وما طبخوها غير أن غلامهم","سعى في نواحي كرمها بشهاب",64,"ب",1,0],["وَمَا طِيبُ الأَرُومَةِ مِنْهُ بِدْعاً","زَكَاةُ الفَرْعِ لِلأَصْلِ الزَّكِيِّ",65,"ي",1,0],["وَما طالَ الْمَدى فَيَسُوعَ عُذْرٌ","بِأَنْ يَكْبُوا الْجَوادُ وَاَنْ يَخُورا",66,"ر",2,0],["وَما طَرَقَ الرَّجاءَ الْفِكْرُ إِلاّ","وَعِزُّ الدِّينِ غايَةُ كُلِّ راجِ",67,"ج",1,0],["وَما طَبَخَت قُدورُهُم حَلالاً","فَلَيتَهُم بِها طَبَخوا مَصوصا",68,"ص",2,0],["وَما طِلابُكَ شَيئاً لَستَ نائِلَهُ","وَسَبُّكَ الناسَ ظُلماً غَيرَ تَعذيبِ",69,"ب",1,0],["وَما طَوى السِجِلَّ بِالنَظرَةِ في اللَ","يلِ البَهيمِ مِن كِتابٍ مُنتَشِر",70,"ر",1,0],["وَما طرَّ عَقلي في هَواها وَغَرَّني","بِها قطّ إِلّا طرّةٌ تَحتَها غرَّه",71,"ر",2,0],["وما طلَبي إلاّ برؤْياكَ رَقْيةً","إلى هَضْبةٍ للعزِّ لم تُتَسنَّم",72,"م",1,0],["وما طَلَبي إلا القبولُ وإنما","أُريد عليه واضحاتِ شَواهد",73,"د",1,0],["وما طَلَبَتْ وتراً لديّ صروفُها","وما كانَ لي غير الفضائل من جُرْمِ",74,"م",1,0],["وَما طيىء الأَجيال إِلّا صَواعِقٌ","لِذا الفلك الدَوار وَهوَ لَها قُطبُ",75,"ب",1,0],["وما طُمانُ بأولى من أُسَامَةَ بال","وفاءِ لكنْ جرى بالكائِن القَلمُ",76,"م",1,0],["وما طمع النُّفوس سوى تلاقٍ","وقد أطْعَمْتُ نفسي في نوالك",77,"ك",1,0],["وما طلبت لها مالا ولا عوضا","ولا ثناء ولا ذكرى تناجيها",78,"ي",3,0],["وماطلات ديونَ الحبّ تلزمها","لَيَّاً وهنّ مليَّاتٌ مياسيرُ",79,"ر",1,0],["وما طوى الدهرُ من آثاركم فعفا","فإنه بالحُسَيْنِيِّينَ منشورُ",79,"ر",1,0],["وما طوَّفت في الآفاق إلا","وجدتُك أنتَ أينَ طلبتُ حُرّا",80,"ر",2,0],["وما طابَ قلبي فيك يا كامل النُّهى","لمكرمةٍ إلا وعرضك أطيبُ",81,"ب",1,0],["وما طاب ذكرُ المحسنين وما جرى ال","نَّسيمُ بأرجاءِ المُروتِ البلاقعِ",82,"ع",1,0],["وما طافَ ببَيْتِ اللَّهِ","حافِيهِ وناعِلُهُ",83,"ل",2,0],["وما طبرية إلا هدي","ترفع عن أكف اللامسينا",84,"ن",2,0],["وما طرسهُ غير الصباح ونقشهُ","الظلامُ وتلك الأحرف الأنجمُ الزُّهر",85,"ر",1,0],["وَما طَمِعَ الحَزميُّ في الجاهِ قَبلَها","إِلى أَحَدٍ مِن آلِ مَروانَ عادِلِ",86,"ل",1,0],["وما طَوَتْهُ مُهْجَتي","وحالِفٍ وما حَلَفْ",87,"ف",1,0],["وما طِلبِتي إلا التِّهامِي تُديمُهُ","وتُبقِيه لي ما دام جُودُكَ باقِيَا",88,"ي",2,0],["وماطِلٍ ما اِقتضيناهُ مَواعدَنا","إلّا وفي سمعه عن قولنا صَمَمُ",89,"م",1,0],["وما طُفنا البلادَ ولا رأَينا","مَقامَ المجدِ والدُّنيا لديهِ",90,"ي",2,0],["وما طيبُ الصَباءِ فدَتْكَ نفسي","وإن يَكُ لا يفي هذا الفِداءُ",91,"ا",2,0],["وماطَلَنِي بموعِدِهِ","وأخْلَفَني الذي وَعَدَا",92,"د",2,0],["وَما طالبُ الحاجات إِلّا معذياً","وَما نال شيئاً طالب لنجاح",93,"ح",1,0],["وما طالَ دِرع الذِّمْر تَحصُّناً","ولكن ليغدو طرفه مِنه في جلِّ",94,"ل",1,0],["وما طَلبي إِلا قَبولٌ وقُبْلةٌ","وما أَرَبي إِلاَّ رِضاً ورُضَابُ",95,"ب",1,0],["وَمَأطورَةٌ شَدَّ العَسيفانِ أَطرَها","إِساراً وَأَطراً فَاِستَوى الأَطرُ وَالأَسرُ",96,"ر",1,0]]}