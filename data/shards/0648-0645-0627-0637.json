[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"فالق الشعر ...","https://www.poetsgate.com/ViewPoem.aspx?id=202794",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5431,"لغتنا والمسا كين","https://www.poetsgate.com/ViewPoem.aspx?id=208525",""],[5431,"غمامٌ حاتميٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=214181",""],[5582,"أَبَرْقَ الأَبْرَقَيْنِ أَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63574",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[5730,"أمنية","https://www.poetsgate.com/ViewPoem.aspx?id=210342",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""],[6031,"أَلاَ قُولُوا لِسيدِنَا رَضِيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=46398",""],[6068,"يعذبني التذكار رائعة البسم -14-","https://www.poetsgate.com/ViewPoem.aspx?id=177649",""],[6152,"تقبل الله منكِ الصوم غاليتي","https://www.poetsgate.com/ViewPoem.aspx?id=203315",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["وَما طالَ لَيلي غَيرَ أَنَّ عَلاقَةً","بِقَلبِيَ تَستَقري بِعَيني الدَرارِيا",0,"ي",2,0],["وَماطَلَ قَلباً بِإِبلالِهِ","مِطالُ الغَريمِ وَلَيّانُهُ",1,"ن",2,0],["وَما طابَت غَوادي المُزنِ إِلّا","أَطَبنَ وَقائِعَ الماءِ الزُلالِ",2,"ل",1,0],["وَما طَلَبُ البَذلِ مِن باخِلٍ","بِمَيسورِهِ غَيرُ داءِ عُضالِ",3,"ل",1,0],["وَما طِبتُ نَفساً عَنكِ لَمّا هَجَرتِني","وَلَيسَ سُكوتي عَن سُلُوٍّ وَلا صَبرِ",4,"ر",1,1],["وَما طَلَبُ المَعيشَةِ بِالتَمَنّي","وَلَكِن أَلقِ دَلوَكَ في الدِلاءِ",5,"ا",2,1],["وَما طِلابُكَ شَيئاً لَستَ مُدرِكَهُ","إِن كانَ عَنكَ غُرابُ الجَهلِ قَد وَقَعا",6,"ع",2,0],["وَما طَلَبُ الكُميتِ طِلابُ وِترٍ","وَلَكِنّا لِنُصرَتِنا هُجينا",7,"ن",2,0],["وما طلعت كي تَهدي القومَ شمسُه","ولكن لتُصليهم جحيم الودائق",8,"ق",1,0],["وَمَا طَلَبُوا إلَيهِ دماً ولَكِن","أَثَاثَ المجدِ والحَسَبَ المَصُونَا",9,"ن",2,0],["وما طلبُ الرِّفْد الهَنيء ببدعةٍ","ولا عجبُ المُسترفدِيهِ بعاجبِ",10,"ب",1,0],["وما طَعِمتْ جفوني الغمضَ حتى","حللتُ عِراصَ دور بني حبيبِ",11,"ب",1,0],["وماطلَ فوقها نَزْواً مريضاً","كنزوِ مُسَخَّرٍ لا يَشْتَهيكا",12,"ك",2,0],["وما طولُ عمر لا أبا لك ينقضي","وما خيرُ عيشٍ قصرُ وجدانه العدمْ",13,"م",1,0],["وَما طالِبُ الأَوتارِ إِلّا اِبنُ حُرَّةٍ","طَويلُ نَجادِ السَيفِ عاري الأَشاجِعِ",14,"ع",1,0],["وَما طالِبُ الحاجاتِ مِن كُلِّ وِجهَةٍ","مِنَ الناسِ إِلّا مَن أَجَدَّ وَشَمَّرا",15,"ر",2,0],["وَما طابَ ماءُ النيلِ إِلّا لِأَنَّهُ","يَحُلُّ مَحَلَّ الريقِ مِن ذَلِكَ الثَغرِ",16,"ر",1,0],["وَما طَرَبي لَمّا رَأَيتُكَ بِدعَةً","لَقَد كُنتُ أَرجو أَن أَراكَ فَأَطرَبُ",17,"ب",1,0],["وَما طَلَبَت زُرقُ الأَسِنَّةِ غَيرَهُ","وَلَكِنَّ قُسطَنطينَ كانَ لَهُ الفِدا",18,"د",2,0],["وما طردَ الأحرارَ مثلُ مهانةٍ","تُذالُ بها أعراضُهم وتُضَامُ",19,"م",1,0],["وما طابَ نشرُ الروض إلّا لأنّهُ","شكورٌ لما أسدَتْ إليه يَدُ القَطْرِ",20,"ر",1,0],["وما طابَ نَشْرُ الريحِ إلا وعندَها","أخابِيرُ من نَجْدٍ ومن ساكِني نَجْدِ",21,"د",1,0],["وَما طَرَفا زَمانِ المَرءِ إِلّا","مُقامٌ يَرتَضيهِ أَو رَحيلُ",22,"ل",1,0],["وَما طَعَنوا إِلّا بِرُمحٍ مُوَصَّلٍ","وَما ضَرَبوا إِلّا بِسَيفٍ مُثَلَّمِ",23,"م",1,0],["وَما طَيِّءٌ إِلّا قَبائِلُ أُنزِلَت","إِلى أَهلِ عَينِ التَمرِ مِن كُلِّ جانِبِ",24,"ب",1,0],["وَما طَعِمَت مِن مَشرَبٍ مُذ سَقَيتَها","بِتَدمُرَ إِلّا مَرَّةً بِالشَفائِفِ",25,"ف",1,0],["وَما طَمِعَت بِالأَرضِ رائِحَةً بِنا","إِلى الغَدِ حَتّى يَنقُلَ الظِلَّ ناقِلُه",26,"ل",2,0],["وَما طَرَقَ السُؤالُ مِثلَ اِبنِ غالِبٍ","لِأَمرَينِ جَلّا مِن عِقابٍ وَنائِلِ",27,"ل",1,0],["وَما طَيِّئٌ وَاللُؤمُ فَوقَ رِقابِهِم","وَلَم تَرِمِ الأَحمالُ عَنها بِرائِمِ",28,"م",1,0],["وَما طيبُ الحَياةِ بِغَيرِ بِشرٍ","وَلا حُسنُ السَماءِ بِلا شِهابِ",29,"ب",1,0],["وما طابَ عَرْفٌ من سُرَاها وإنّما","تَطَيّبُ في جنح الدّجى بِسُرَى هِندِ",30,"د",1,0],["وما طَمَعُ الإنسانِ فيما يفوته","إذا ما دَعَا الدّاعِي فَوَلَّى وأدبرا",31,"ر",2,0],["وَما طَعامٌ ظَلَّ بِالفَلاةِ","يُقَرِّبُ المَوتَ مِنَ الحَياةِ",32,"ه",1,0],["وَما طَبَخوها غَيرَ أَنَّ غُلامَهُم","مَشى في نَواحي كَرمِها بِشِهابِ",33,"ب",1,0],["وَما طَهَّرَت بِالعُشرِ خَمسَةَ أَوسُقٍ","نُفوسٌ أَقَلَّت مِن مَآثِمِها وِسقا",34,"ق",2,0],["وَما طَيرُ اليَمينِ بِمُبهِجاتي","فَأَخشى الهَمَّ مِن طَيرِ الشِمالِ",35,"ل",1,0],["وَما طلب الوالي نَديماً وَما له","لعمرك في شأن الحكومة أُصبُع",36,"ع",1,0],["وما طابَ في هَذِي البَرِيَّةِ آخرٌ","إِذا هُو لم يُنْجَدْ بطِيبِ الأَوائِلِ",37,"ل",1,0],["وَما طَلَعَت شَمسٌ لَدى كُلِّ شارِقٍ","وَما هَطَلَت عَينٌ عَلى واضِحِ النَحرِ",38,"ر",1,0],["وما طَلَبي سُؤالاً بعدَ خُبرٍ","نَمَاهُ الُموضِعونَ إلى الشَّعوبِ",39,"ب",1,0],["وَمَا طِيَّتِي غَيْرَ أَنِّي وَقَفْ","تُ بآثَارِ فَنٍّ عَدَاهَا الفَنَاءْ",40,"ا",2,0],["وَما طَمَعي أَن يَعرِفَ القَومُ قيمَتي","وَسيّانَ فَضلٌ عِندَهُم وَفُضولُ",41,"ل",1,0],["وَما طَلَعَت شَمسٌ وَحانَ غُروبُها","وَبِاللَيلِ أَبكيهِم وَبِالغَدَواتِ",42,"ت",1,0],["وما طَنُّ الذبابِ سوى نُواحٍ","وقد حصدته أيدي العلم حصدا",43,"د",2,0],["وما طيبَ عيشٌ ليس يَشْعُرُ أهلُهُ","بلذَّتِه إلا إذا صار ماضيا؟",44,"ي",2,0],["وما طال عهدٌ من رسالة أحَمدٍ","وما زالَ عودُ الملك رّيانَ اخضَرا",45,"ر",2,0],["وما طال عصر الظلم إلا لحكمة","تنبيء أن لابد تدنو المصارع",46,"ع",1,0],["وَمَا طَعَنُوا إلا ّ برُمْحٍ عَمْرٍ مُوَصَّلٍ،","ومَا ضَرَبُوا إلاّ بسَيْفٍ مُثَلَّمِ",47,"م",1,0],["وَما طَيّءٌ، واللّؤمُ فَوْقَ رِقَابِهِمْ،","وَلمْ تَرِمِ الأحْبَالُ عَنْهَا بِرَائِمِ",48,"م",1,0],["وما طلب المعيشة بالتمني","وَلَكِنْ أَلْقِ دَلْوَكَ مع الدِّلاَءِ",49,"ا",2,1],["وما طال عمري غير أن لواعجاً","أطلن عناني فاجتويت مفاميا",50,"ي",2,0],["وما طاف الكرى بالعين إلّا","ليفتحها على الكرب العظام",51,"م",1,0],["وَما طالِبُ الدُرِّ مِن بَحرِهِ","كَمَن ظَلَّ يَطلُبُهُ مِن نَهَر",52,"ر",1,0],["وَما طَلَبتُ الغِنى حَتّى عَمَمتَ بِهِ","وَكانَ مِثلُكَ هَيناً عِندَهُ العَدَمُ",53,"م",1,0],["وما طولكم ممن تؤدى فروضه","وهل شكر من ربي مجاز لمن ربا",54,"ب",2,0],["وَما طَلَبي سِوى لِقيانِ مَلكٍ","يَلوحُ ضِياءُ غُرَّتِهِ اِتِّقادا",55,"د",2,0],["وَما طَلَبي العَلياءَ إِرثُ كَلالَةٍ","فَيَقصُرُ خَطوي دُونَها فَأَسُوعُها",56,"ع",3,0],["وما طَلبي منه إلا الحديث","اقول له هاتِ أو فاسْمَع",57,"ع",1,0],["وما طائرٌ قَصَّ الزمانُ جناحَه","وأَعْدَمَه وَكْرا وأَفْقَده إِلْفا",58,"ف",2,0],["وما طابت الدنيا بأكل ونعمة","وشرب وتتريف ولبس جليس",59,"س",1,1],["وما طال ذاك البعد الا لشقوتي","وحاشاك من هذا التباعد والجفا",60,"ف",2,0],["وما طمع المعذّب أن يراكم","وقد ضنّ الخيال بأن يعودا",61,"د",2,0],["وما طمعي اني أدوم مخلداً","ولا هذه الدنيا بدار دوام",62,"م",1,0],["وما طال إلا ليل من طال همه","ولا زاد الاهم من زاده فكرا",63,"ر",2,0],["وما طبخوها غير أن غلامهم","سعى في نواحي كرمها بشهاب",64,"ب",1,0],["وَمَا طِيبُ الأَرُومَةِ مِنْهُ بِدْعاً","زَكَاةُ الفَرْعِ لِلأَصْلِ الزَّكِيِّ",65,"ي",1,0],["وَما طالَ الْمَدى فَيَسُوعَ عُذْرٌ","بِأَنْ يَكْبُوا الْجَوادُ وَاَنْ يَخُورا",66,"ر",2,0],["وَما طَرَقَ الرَّجاءَ الْفِكْرُ إِلاّ","وَعِزُّ الدِّينِ غايَةُ كُلِّ راجِ",67,"ج",1,0],["وَما طَبَخَت قُدورُهُم حَلالاً","فَلَيتَهُم بِها طَبَخوا مَصوصا",68,"ص",2,0],["وَما طِلابُكَ شَيئاً لَستَ نائِلَهُ","وَسَبُّكَ الناسَ ظُلماً غَيرَ تَعذيبِ",69,"ب",1,0],["وَما طَوى السِجِلَّ بِالنَظرَةِ في اللَ","يلِ البَهيمِ مِن كِتابٍ مُنتَشِر",70,"ر",1,0],["وَما طرَّ عَقلي في هَواها وَغَرَّني","بِها قطّ إِلّا طرّةٌ تَحتَها غرَّه",71,"ر",2,0],["وما طلَبي إلاّ برؤْياكَ رَقْيةً","إلى هَضْبةٍ للعزِّ لم تُتَسنَّم",72,"م",1,0],["وما طَلَبي إلا القبولُ وإنما","أُريد عليه واضحاتِ شَواهد",73,"د",1,0],["وما طَلَبَتْ وتراً لديّ صروفُها","وما كانَ لي غير الفضائل من جُرْمِ",74,"م",1,0],["وَما طيىء الأَجيال إِلّا صَواعِقٌ","لِذا الفلك الدَوار وَهوَ لَها قُطبُ",75,"ب",1,0],["وما طُمانُ بأولى من أُسَامَةَ بال","وفاءِ لكنْ جرى بالكائِن القَلمُ",76,"م",1,0],["وما طمع النُّفوس سوى تلاقٍ","وقد أطْعَمْتُ نفسي في نوالك",77,"ك",1,0],["وما طلبت لها مالا ولا عوضا","ولا ثناء ولا ذكرى تناجيها",78,"ي",3,0],["وماطلات ديونَ الحبّ تلزمها","لَيَّاً وهنّ مليَّاتٌ مياسيرُ",79,"ر",1,0],["وما طوى الدهرُ من آثاركم فعفا","فإنه بالحُسَيْنِيِّينَ منشورُ",79,"ر",1,0],["وما طوَّفت في الآفاق إلا","وجدتُك أنتَ أينَ طلبتُ حُرّا",80,"ر",2,0],["وما طابَ قلبي فيك يا كامل النُّهى","لمكرمةٍ إلا وعرضك أطيبُ",81,"ب",1,0],["وما طاب ذكرُ المحسنين وما جرى ال","نَّسيمُ بأرجاءِ المُروتِ البلاقعِ",82,"ع",1,0],["وما طافَ ببَيْتِ اللَّهِ","حافِيهِ وناعِلُهُ",83,"ل",2,0],["وما طبرية إلا هدي","ترفع عن أكف اللامسينا",84,"ن",2,0],["وما طرسهُ غير الصباح ونقشهُ","الظلامُ وتلك الأحرف الأنجمُ الزُّهر",85,"ر",1,0],["وَما طَمِعَ الحَزميُّ في الجاهِ قَبلَها","إِلى أَحَدٍ مِن آلِ مَروانَ عادِلِ",86,"ل",1,0],["وما طَوَتْهُ مُهْجَتي","وحالِفٍ وما حَلَفْ",87,"ف",1,0],["وما طِلبِتي إلا التِّهامِي تُديمُهُ","وتُبقِيه لي ما دام جُودُكَ باقِيَا",88,"ي",2,0],["وماطِلٍ ما اِقتضيناهُ مَواعدَنا","إلّا وفي سمعه عن قولنا صَمَمُ",89,"م",1,0],["وما طُفنا البلادَ ولا رأَينا","مَقامَ المجدِ والدُّنيا لديهِ",90,"ي",2,0],["وما طيبُ الصَباءِ فدَتْكَ نفسي","وإن يَكُ لا يفي هذا الفِداءُ",91,"ا",2,0],["وماطَلَنِي بموعِدِهِ","وأخْلَفَني الذي وَعَدَا",92,"د",2,0],["وَما طالبُ الحاجات إِلّا معذياً","وَما نال شيئاً طالب لنجاح",93,"ح",1,0],["وما طالَ دِرع الذِّمْر تَحصُّناً","ولكن ليغدو طرفه مِنه في جلِّ",94,"ل",1,0],["وما طَلبي إِلا قَبولٌ وقُبْلةٌ","وما أَرَبي إِلاَّ رِضاً ورُضَابُ",95,"ب",1,0],["وَمَأطورَةٌ شَدَّ العَسيفانِ أَطرَها","إِساراً وَأَطراً فَاِستَوى الأَطرُ وَالأَسرُ",96,"ر",1,0],["وَما طالَ نَومُ السَيفِ إِلّا تَنَبَّهَت","عُيونُ الدَواهي مِنهُعَن جَفنِ نائِمِ",97,"م",1,0],["وَما طاب مَدح في مَعاليه وَاِزدَهى","بِأَوصافه دِيوان كُل مجيد",98,"د",1,0],["وَما طافَ بِالبَيت العَتيق وَزَمزم","عَبيدٌ وَأَحرارٌ وَكَهل وَشائب",99,"ب",1,0],["وما طلبوا الحكم باسم الجها","د إلا لدنياهم الفانيه",100,"ي",2,0],["وما طاب يوم بعدها لبني الهدى","ولا ساغ شرب للكرام ومطعم",101,"م",1,0],["وَما طابَ في التّمداحِ شعرُ خِتامِهِ","بِنَظمِ اِبنِ فَتحِ اللَّهِ مِسكٌ وعَنبرُ",102,"ر",1,0],["وما طابت الجرداء إلا بنَشركم","تعطّر منها رَندُها وخُزامُها",103,"م",3,0],["وما طُولُ عمري أن يطولَ به المدى","ولكنهُ طولُ المسرةِ والخفضِ",104,"ض",1,0],["وما طالع منه لي طالعا","بِعُرْفِ ولكنه الدهر نُكْرَ",105,"ر",1,0],["وَما طُويت أَرضٌ لَنا مِن كَرامة","وَلَكِنَّنا طرنا بِأَجنِحة الحُب",106,"ب",1,0],["وما طرباً صغنا القريض وانما","جلا النور مرآة القرائح مرآها",107,"ا",3,0],["وَما طولُ سجني عائبٌ لي فَإِنَّه","مِسَنٌّ لأَلبابٍ صدئن بِلا سِنِّ",108,"ن",1,0],["وما طلبتُ امامَ الناسِ من طلَبٍ","ناءٍ ولا كنتُ ممن يلعبُ اللعِبا",109,"ب",2,0],["وما طاعتي من عليك وإنما","لذاتك ربي كل مجد ومنة",110,"ه",1,0],["وما طمع الأملاك والرسل مطلقاً","بأن يبلغوا مقداره مع نسبة",111,"ه",1,0],["وما طلبي للورد الا لانه","الى ورد خديه يقربني زلفى",112,"ف",2,1],["وما طويتُ على يأسٍ عليه طَوت","حتَّى مللتُ وملّت من تشكِّيها",113,"ي",3,0],["وماطيشته رتبة أو رياسة","ولا أطعمته نفسه قط في الرفد",114,"د",1,0],["وما طرى منع على الأصلين","ولا أصيبا بنوى وبين",115,"ن",1,0],["وما طن الذباب فراع ليثاً","وهل تتخوف الأسد الطنينا",116,"ن",2,0],["وما طاب المذاق عليذ كلا","وما طاب السكوت والا الكلام",117,"م",1,0],["وما طعمةُ الأفكارِ إلا تغصص","إذا هي لم تبلغ لديه أناها",118,"ا",3,0],["وما طلعت شمس ولا ذر شارق","وما لاح ضحاك المنابع بالرعد",119,"د",1,0],["وما طرسُها إلاّ الفؤاد يُخطه","يُد الشوق عني بالدموع السواجِم",120,"م",1,0],["وَما طَعنت فيكُم سِوى ألسن القَنا","وَلَولا القنا لَم تُلفَ فيكم مَطاعن",121,"ن",1,0],["وَما طلت رَبي بِالصَلاة وَلَم يَزَل","يُساهلني رَبي لِحُسنِ قَضائي",122,"ي",1,1],["وما طلبي إليك العفو عنه","وقد قعد الوشاة به وقاموا",123,"م",3,0],["وَما طَلَعَت وَغابَت في الدَياجي","نُجومُ الجَوِّ أَو عَصَفَت رُخاءُ",124,"ا",2,0],["وما طالب الحاجات في كل وجهةٍ","من الناس إلا من أجد وشمرا",125,"ر",2,0],["وما طلبت نفسي من العيش غاية","ولا حلَّ من قلبي الهناءُ المعدّدُ",126,"د",1,0],["وما طال منها من حديث فإنني","به طالب منكم على قدره حرفا",127,"ف",2,0],["وما طابتِ الأيامُ لي مذعرفتُها","فياليتني أصبحت عنها مُغفَّلا",128,"ل",2,0],["وما طِرْنَ يَشرينَ هامَ الرجا","لِ من ضوءِ نارِكَ إلا شَرارا",129,"ر",2,0],["وما طلكَ البغْضَاءَ حتى سئمتَها","طليعةُ آجالٍ من السُم مِتْأَقُ",130,"ق",1,0],["وما طالعاتُ الشيبِ إلا أسنّةٌ","لهنّ بهاماتِ الرِّجالِ بَريقُ",131,"ق",1,0],["وما طلب الكلام الحرّ الا","أتى بين انفراد وازدواج",132,"ج",1,0],["وما طابَ عَرْفُ الزّهْرِ إلا لأنّهُ","تُمازِجُهُ منْ ذِكْرِهنّ نوافِحُ",133,"ح",1,0],["وما طاهِرٌ إلّا سفاةٌ تحرَّكَت","برائحَةِ الفضلِ بن سهلٍ فمَرّت",134,"ت",1,1],["وَما طاشَ سَهمي عَنكَ يَومَ تَبَرَّأَت","لُكيزُ بنُ أَفصى مِنكَ وَالجُندُ حاشِدُ",135,"د",1,0],["وما طلع العباس حتى رنت له","نواظرنا من كل صوب توسما",136,"م",2,0],["وَما طول أَحزان الفَتى بَعد فائت","إِذا لَم تَكُن تُجدي مِن الحُزن أَدمع",137,"ع",1,0],["وَما طارَ في الآفاق بدعاً مَديحَهُم","وَلكنه نَشر زَكيٌّ تَضَوعا",138,"ع",2,0],["وما طويت سجلّ الودّ إلاَّ","لنشر المَلْق من ملأٍ سفيه",139,"ي",2,0],["وَما طالَ أَمر للزمان بِأَهله","يُهمُّك أَو يلهيك إِلا قضيتَهُ",140,"ت",2,0],["وَما طالعُ السعدين إِلا نضارةٌ","تَخوّفَ عقباها العشاشُ الطَوالغ",141,"غ",1,0],["وَما طامعٌ في العَيش بِالهَمِّ وَالأَسى","سِوى مَن عَلى عَينيهِ للغيِّ طامغ",141,"غ",1,0],["وَما طَرَقَ الأَسماعَ مِن عَهدِ آدَمَ","كَمَلحَمَةِ التَلِّ الَّتي تَلَتِ العِدا",142,"د",2,0],["وما طيبات الفعل إلا لأهلها","وأنت بحمد اللَه طيب الأطايب",143,"ب",1,0],["وما طيب عيش لا يدوم نعيمه","مقامك بعد الظاعنين قصير",144,"ر",1,0],["وما طلبي الا السرير وانما","سريت اليكم ابتغي بكم النصرا",145,"ر",2,0],["وما طاف حول الشمع إلا ليغتدي","لشمعك يا خير البرية قربانا",146,"ن",2,0],["وَما طُفَيْلٌ بِوَقَّافٍ إذَا افْتَرَسَتْ","زُرقُ الأسِنَّةِ هَيَّابٍ إذَا رَكِبَا",147,"ب",2,0],["وماطلني دين الوصال ولم تزل","وعود ظباء الخيف ان وعدت تلوى",148,"و",2,0],["وما طابَ عَرف الريح إلا لأَنه","أَصابَ عَبيراً منك عند عبورِهِ",149,"ر",2,0],["وما طَمِعَ العَذُولُ بأن يراني","مُصيخاً فيكمُ للعَذلِ أُذنا",150,"ن",2,0],["وما طلبت نفسي سوى المجد والعلى","وقد شهد الأعداء إنيّ بها أولى",151,"ل",2,0],["وما طاحَ منْ هامٍ وما سالَ مِنْ دَمٍ","وما ذَلَّ منْ مَلْكٍ ومِنْ سَرَواتِ",152,"ت",1,0],["وما طافَ حولَ البيتِ للهِ طائفٌ","ورنَّحَ أغصانَ الغَضَا كلُّ هَفْهَافِ",153,"ف",1,0],["وما طاف حولَ البيت لله طائفٌ","وحَوْقل داعٍ للإلهِ وكَبَّرا",154,"ر",2,0],["وما طلبي للوصل حرص على البقا","ولكنه أجر إليك أسوقه",155,"ه",1,0],["وما طرَباً صُغنا القريضَ وإنّما","جَلا اليومَ مِرآةَ القرائح مَرآها",156,"ا",3,0],["وما طال عمر قط إلاّ تطاولت","بصاحبه روعات ما يتوقع",157,"ع",1,0],["وما طابت لذي خِلٍّ حياة","بيومٍ لا يرى أنسَ الخليل",158,"ل",1,0],["وما طابقت أفكارنا فعلك الذي","تسامى طباق النظم في الشعر المنثر",159,"ر",1,0],["وما طول اللقاءِ دليل حبٍّ","وليس البين ينذرُ بالفراقِ",160,"ق",1,0],["وما طلبُ العلمِ إلا ربيعٌ","ألا منه نحو المصيف انتقلنا",161,"ن",2,0],["وما طول الزمان بمرِّ وقت","وأيام إذا عُدّت كثيرة",162,"ر",2,0],["وما طعم الحياة إذا تَوارت","بغيرِ صَبابةٍ فيها أغُورُ",163,"ر",1,0],["وما طامع في علانا لها","إلى أن تجرعه الأكؤسا",164,"س",2,0],["وما طاب لي التنجيم حتى رصدتها","أراقب فيها السعد والسعداء",165,"ا",2,0],["وما طمعت بدنيا شمسها اقتربت","من الأفول نعاها الشيب والهرم",166,"م",1,0],["وما طَمَعُ القَنا باللِّينِ فينا","ولكن هِزَّةُ اللَّدْنِ النَحيلِ",167,"ل",1,0],["وما طلبتْ إلا فِنَاءَ محمدٍ","وهل دونه للركبِ من متلوّم",168,"م",1,0],["وما طلب التنوّر غير طوب","به تُبنى من العزّ القلاعا",169,"ع",2,0],["وماطَرِبتُ إلى هيفاءَ فاتِنةٍ","إنَّ الكريمَ لمُشْتاقٌ إلى الشِّيَمِ",170,"م",1,0],["وما طالبُ الحاجاتِ منْ حيثُ تبتغى","من الناسِ إلا منْ أجدَّ وشمرا",171,"ر",2,0],["وما طاب مني العيش لما فقدتهم","وإني على فقدِ الحبيبِ عليلُ",172,"ل",1,0],["وما طلعت شمس وما جن غاسق","وما لاح في الآفاق من كوكب يبد",173,"د",1,0],["وما طلعت شمس وأظلم غاسق","وما انهل صوب المدجنات المواطر",174,"ر",1,0],["وما طلعت شمس وما جن غاسق","وما ابنعثت ورقا تبكي على فند",175,"د",1,0],["وما طلعت شمس وما هب ناسم","وما انهل ودق المدجنات وما انهمل",176,"ل",1,0],["وما طعنوا في الأشعري أمامكم","ولكن بأتباعٍ له كسروا كسرى",177,"ر",2,0],["وما طلعت شمس وما حن راعد","وما أم بيت الله حل وأحرما",178,"م",2,0],["وما طرقتُ بسيفِ الحبّ معضلةً","إلا فكَكْتُ به للحقّ أغلالا",179,"ل",2,0],["وما طلبوا بذا ملكاً عتيداً","ولا رغبوا لجيناً أو نضاراً",180,"ر",2,0],["وماطفرةُ الأقلام إلا تصاعدٌ","إذا شُبّعت بالزخم منها الطوابقُ",181,"ق",1,0],["وماطوق الثراء سوى غرور","ولا تنجو الخليقة من مَعاد",182,"د",1,0],["وما طلب التنوّر غير طوب","به نبني من العزّ القلاعا",183,"ع",2,0],["وماطبعُ الأصيل بغدرٍ صحبٍ","ولكنْ إنْ طغوا : فله احتدامُ",184,"م",1,0],["وَما طالَ المَدَى إِلاَّ","تَجَدَّدَ لِي وَما قَدُما",185,"م",2,0],["وما طابَ شايٌ عُدَّ في البَرِّ كالذي","على حَطَبٍ أَجٍّ بمجْمَرِهِ وارِ !",186,"ر",1,0],["وما طلبتُ من الرحمن أمنيةً","إلا قد اتخَذَتْ مضمون رؤياك ِ",187,"ك",1,0],["وما طول ليلي عن هوى مثل غيرهِ","فأحمد فيه طولَ ليلى ولا جمل",188,"ل",1,0],["وما طلعت كي تختبره وإنما","رأت ذاتها بالعلم في عالم العقل",189,"ل",1,0],["وما طَرَحَ المزَادةَ حينَ ألْقَى","بِها إلاّ عَلَى السَّيْلِ الأتِيِّ",190,"ي",1,0],["وما طاب لي في القرب غير عجاجة","أفيد بها عيني لفراكة الضم",191,"م",1,0],["وما طعمت لذيذا بعد قُبلتكم","ولا أرتضيتُ هبات الغيد إكراما",192,"م",2,0],["وَما طولوا حَتّى لَفوا سرطوننا","عَلى العَسكرية سفروا الجهال",193,"ل",1,0]]}