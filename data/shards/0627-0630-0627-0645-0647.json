{"poems":[[90,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64003","الوافر"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29556","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65937","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58466","البسيط"],[3718,"","https://poetry.dctabudhabi.ae/diwan/poem/198806","الطويل"]],"verses":[["إذ أمة الطليان قد أصبحت","أكبر من خان ومن قد غدر",0,"ر",1,0],["إذا مُهدي المديحةِ لم يكافأ","عليها فالمديحةُ كالوقيعه",1,"ع",2,0],["إِذا مُهِرَت صُلباً قَليلاً عُراقُهُ","تَقولُ أَلا أًرضَيتَني فَتَقَرَّبِ",2,"ب",1,0],["إِذا مهدت بالبيض مادت وزلزلت","مناكب أرض اللّه من كل جانب",3,"ب",1,0],["إذ أُمُّهْ لم تَجِد قوتاً ولا امتلأت","بطناً لدى شيء قط غير بعض مني",4,"ن",2,0],["إذا مهجة الإنسان حان رحيلها","توالت مآسيه الجسام الفواجع",5,"ع",1,0]]}