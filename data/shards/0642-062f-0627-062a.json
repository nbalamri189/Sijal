"هداء لناسك \"","https://www.poetsgate.com/ViewPoem.aspx?id=158296",""],[4767,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=178897",""],[4767,"دوحة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=179253",""],[585,"سل الدار هل في الدار من كنت تألف","https://www.poetsgate.com/ViewPoem.aspx?id=161868",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5092,"لا موعدٌ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=178713",""],[5092,"دنيا","https://www.poetsgate.com/ViewPoem.aspx?id=179344",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5124,"قل لمن زانه عفاف وَدين","https://www.poetsgate.com/ViewPoem.aspx?id=189793",""],[5213,"لا تفعل الخمر على سكرها","https://www.poetsgate.com/ViewPoem.aspx?id=170501",""],[5216,"ذكرى فتح مِصْر","https://www.poetsgate.com/ViewPoem.aspx?id=186887",""],[5219,"تشطير أبيات الأخطل الصغير ... قد أتاك يعتذر","https://www.poetsgate.com/ViewPoem.aspx?id=197681",""],[5302,"ما الذي سوف نلقى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200122",""],[5358,"لا تجرحي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183416",""],[5376,"دُسْ عليها واهْرسِ الجسْمَ النحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=188451",""],[5376,"جاد بسْمُ العرْبِ يسري في فمي","https://www.poetsgate.com/ViewPoem.aspx?id=188477",""],[5376,"عيش ذل يا قدسنا ما استطابا","https://www.poetsgate.com/ViewPoem.aspx?id=190450",""],[5376,"علي الأذربيجاني ونينو الجورجية","https://www.poetsgate.com/ViewPoem.aspx?id=202463",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5431,"سيقودني للغيم تحشيشُ....","https://www.poetsgate.com/ViewPoem.aspx?id=200263",""],[5431,"ربّيَ الله فاطرٌ كلّ حيّ...","https://www.poetsgate.com/ViewPoem.aspx?id=201068",""],[5436,"ياساهر الليل / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=178429",""],[5465,"ظهر الحق واستبان مضيا","https://www.poetsgate.com/ViewPoem.aspx?id=98443",""],[5533,"حِقْدُ المَجُوس","https://www.poetsgate.com/ViewPoem.aspx?id=176589",""],[5533,"قَدْ أَتَيْتُ أَعْتَذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=176647",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5804,"القصيدة القمرية","https://www.poetsgate.com/ViewPoem.aspx?id=184052",""],[5851,"ويهتفون بحياة الرداءة","https://www.poetsgate.com/ViewPoem.aspx?id=175276",""],[5906,"بِترا","https://www.poetsgate.com/ViewPoem.aspx?id=188068",""],[5956,"الرَّفْضُ السَّلْبِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=183335",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[243,"يا ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68157&r=&rc=149",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[6300,"يوميات مكلوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82841&r=&rc=12",""]],"verses":[["قَدِ اِتُّهِمنا وَلَمّا نَطَّلِب جَلَلاً","إِنَّ الضَعيفَ عَلى الحالَينِ مُتَّهَمُ",0,"م",1,0],["قَد أَتلَفَت أَنفُسَ البَرايا","بِأَسهُمِ الغَدرِ وَالعُقوق",1,"ق",1,0],["قَد أَتاكَ الجَوابُ لا شَكَّ فيهِ","فَاتَّخذني لِلمُشكِلاتِ إِماما",2,"م",2,0],["قَد اِتَّفَقوا رَأياً وَعَزماً وَهِمَّةً","وَديناً وَإِن كانوا قَد اِختَلَفوا لُسنا",3,"ن",2,0],["قَد أَتَتنا الطَيرُ تَشدو","بَعضَ أَبياتِ الأَغاني",4,"ن",2,0],["قَد أَتَتهُ الوَحشُ وارِدَةً","فَتَنَحّى النَزعُ في يَسَرِه",5,"ر",2,0],["قد اتخذوا الحُسام لهم لسناً","فقالوا البُطل واختلقوا الفريا",6,"ر",3,0],["قد اتسع الفضاءُ لك اتساعًا","فهل أبعاده بك ينتهينا؟",7,"ن",2,0],["قَد أَتانَ مِن قَتلِهِم ما كَفانا","فَبِحُزنٍ نَبيتُ غَيرَ سُرورِ",8,"ر",1,0],["قد أتعبَ السيفَ من طولِ القراعِ به","فالسيفُ في راحةٍ منه وفي تعب",9,"ب",1,0],["قد أتَى عن نبيِّنا حبُّه الفأْ","لَ مضيئاً بذلك البرهان",10,"ن",1,0],["قد أتعبونا بحوكِ مدحِهمُ","وبالتقاضي وما يريحونا",11,"ن",2,0],["قَدِ اِتَّخَذَت مَرآتَها مُرشِداً لَها","إِذا عَنَّ أَمرٌ أَو تَعَرَّضَ مُشكِلُ",12,"ل",1,0],["قَد أَتى العيدُ وَما عِن","دي لَهُ ما يَقتَضيهِ",13,"ي",2,1],["قَد أَتعَسَ اللَهُ عَيناً صِرتَ توحِشُها","وَأَسعَدَ اللَهُ قَلباً صِرتَ تَأويهِ",14,"ي",2,0],["قَد أَتانا الطَبَقُ المَل","آنُ بِالوَردِ النَضيدِ",15,"د",1,0],["قَد أَتاني مِنَ الحَبيبِ رَسولٌ","وَرَسولُ الحَبيبِ عِندي حَبيبُ",16,"ب",1,1],["قد أتاني نعيه باغتا فان","تَفضت في جثماني الأعصاب",17,"ب",1,0],["قد أتعب الأعداء من داراهم","فأقم عدوّك بالليان وأقعد",18,"د",1,0],["قَد أَتَتنا الأَنباءُ عَنكَ وَعَن مَن","بِجَ حينَ المَحَلُّ فيها جَديبُ",19,"ب",1,0],["قَد أَتاني عَنهُ وَما خِلتُ حَقّاً","وَضعُهُ مِن كُثَيِّرٍ وَجَميلِ",20,"ل",1,0],["قَد أَتانا البَشيرُ عَن خَبَرِ الخا","بورِ بِالصِدقِ ظاهِراً وَالبَيانِ",21,"ن",1,0],["قد أتتنا طرف من","ك على الظرف تزيد",22,"د",1,0],["قد أتانا منه ما زا","دَ على شُكْرِ شُكورِكْ",23,"ك",1,0],["قَد أَتاكَ الهُدى مِنَ اللَهِ نُصحاً","وَبِهِ جاءَكَ البَشيرُ النَذيرُ",24,"ر",1,0],["قَد أَتى تائِباً لِتَصفَحَ إِن شِئ","تَ وَإِلّا فَبَدِّلِ الحاءَ عَينا",25,"ن",2,0],["قَد أُترِعَت مِنهُ الجَوانِحُ رَهبَةً","بَطَلَت لَدَيها سَورَةُ الأَبطالِ",26,"ل",1,0],["قَد أَتانا ما تَمَنَّينا وَقَد","غُيِّبَ الأَبرامُ عَنّا وَالقَذَر",27,"ر",1,0],["قَد أَتاني عَنكَ اِنصِرافُكِ عَنّي","وَهَناتٌ كَأَنَّهُنَّ السِهامُ",28,"م",1,0],["قد أتاكَ الرّبيعُ يَفعلُ ما تأ","مُرُهُ فِعْلَ عبدكَ المأمورِ",29,"ر",1,0],["قَد أَترُكُ القِرنَ مُصفَرّاً أَنامِلُهُ","كَأَنَّ أَثوابَهُ مُجَّت بِفِرصادِ",30,"د",1,0],["قَد أَتاني طيفُ لَيلى لَيلَةً","بعد صدٍّ وَالدُجى معتكرُ",31,"ر",1,1],["قد أتَتْني هَدِيّةٌ منكَ بالأمْ","سِ فقابَلْتُها بحُسْنِ القَبول",32,"ل",1,0],["قدْ اتَّبَعْنَ الهُدَى حِصَافاً","وَلَمْ يُبَالَيْنَ بِالعَوَادِي",33,"د",2,0],["قد أتاك يعتذرُ","لا تَسَلْهُ ما الخبرُ",34,"ر",1,1],["قد أتعبوا كل مرقال مذكرة","وجناء تنثر من أشداقها الزبدا",35,"د",2,0],["قد أتيت الحياة بالرغم منّي","وسأمضي عنها إلى القبر مرغم",36,"م",1,0],["قد أتانا الرسولُ بالأبياتِ،","في كتابٍ قد خُطّ بالتُّرَّهاتِ",37,"ت",1,1],["قَد أَتاهُ مِن غَير وَعد وَوافى","لاثِماً لِلقُبول تُرب نِعالِهِ",38,"ل",2,0],["قَد أَتَتني مِنهُ عَروس نِظام","آنستني ي وَحشَتي وَاغتِرابي",39,"ب",2,0],["قد اتعبثهم معاليهم وكم فطن","حطته في الدهر اخلاق عليات",40,"ت",1,0],["قد أتَتْك الجموعُ خاضعة طو","عاً وقد سلّمتْ إليك القيادا",41,"د",2,0],["قَد أَتاكُم مِنَ المَليكِ رَسولٌ","فَاِقبَلوهُ بِصالِحِ الأَعمالِ",42,"ل",1,0],["قد أتى يومنا وحمَّ الحمامُ","فعلى هذه الحياة السلامُ",43,"م",1,1],["قَد اِتَّخَذَ الصَلاحَ لَهُ رَفيقاً","إِلى أَن حَلَّ في دارِ السَلامِ",44,"م",1,0],["قَد أَتى المُصطفى نبيّاً رسولاً","طِبقَ ما بشّرت به الأنبياءُ",45,"ا",2,0],["قَد أتتهُ الضبابُ تشهدُ بالصد","قِ وَزكّت بالحقّ تلك الظباءُ",45,"ا",2,0],["قَد أَتاني مِن صَديقٍ كَلامٌ","كَلآلٍ زانَهُنَّ نِظامُ",46,"م",1,1],["قد أتعبَ الهمُ قلبي","وشرّدَ الحزنُ نومي",47,"م",2,1],["قد اتزرا بالمجدِ وارْتَديا به","وصارا ليَ في الدهرِ كفاً وساعدا",48,"د",2,0],["قَد أَتَتكَ العَذراءُ ما","مَسَّ أَثوابَها دَرَن",49,"ن",1,0],["قَد أَتَتنا الأَطباقُ تُنمى إِلى سو","دَدِ آبائِكَ المُلوكِ الكِرامِ",50,"م",1,0],["قد أتاني منه لطيفُ كتابٍ","قد طواه الصفا لنشر انتعاش",51,"ش",1,0],["قد أتاني كتابه كربيعٍ","زهرُه بالوفاء كان وداده",52,"د",2,0],["قد أتاني كتابه ببهاءٍ","لاح كالنور في خلال السطور",53,"ر",1,0],["قد اتّخذَت لبنانَ في الشامِ عرشَها","وعَزَّ بها في مِصرَ سفحُ المقطَّم",54,"م",1,0],["قَدْ أَتاكَ الْهَناءُ يَرْفُلُ فِي ثَوْ","بِ ثَناءٍ باقٍ عَلى الآثارِ",55,"ر",1,0],["قَد أَتاكَ العامُ بِالحَقِّ وَبِال","جدِّ يَعلو صَهوَةَ السَبتِ المُبين",56,"ن",1,0],["قَد أَتاني أنّ الغوادي أدرّت","في حِماها أخلاف وُطفٍ حوانِ",57,"ن",1,0],["قَد اِتَّخَذنا لَهُ مِن شَخصِهِ مَثَلاً","يَبدو عَلَيهِ مِنَ الإِجلالِ بُرهانِ",58,"ن",1,0],["قَد أَتعب الدَهر قوى هِمَّتي","بِما يُقاسي الحرُّ مِن دَهرِهِ",59,"ه",1,1],["قد أتَتْ بَغتةً وولّتْ سِراعاً","كطُّروقِ الخيالِ مُذْ زارَ وَهنا",60,"ن",2,0],["قد أَتانا مُصَبِّحاً وغُرابُ الْ","لَيلِ فيلَونه من الصُّبْحِ بُقْعه",61,"ع",2,0],["قد أتْعبتْ لكنّها لمّا أتَتْ","وَفْق المُنى فكأنها لم تُتْعِب",62,"ب",1,0],["قد أتَى عنكَ ما تَكادُ مَعانِي","هِ بِه قبلَ أن تُغَنَّى تُغنِّي",63,"ن",2,0],["قد اتفقا ولكن في فسادٍ","كعقربَ راكباً للشرِّ أفعى",64,"ع",2,0],["قَد أَتى قبلَهُ النبيّون طُرّاً","ولكلٍّ إِشارةٌ وَنَباءُ",65,"ا",2,0],["قَد أَتَتني عَن حَبيبي بِخَبَر","وَأسرَّته لِقَلبي فَاِستَعر",66,"ر",1,0],["قد أتيانك إلهي خشعا","خضعا نطلب رفدا من نداك",67,"ك",1,0],["قَدْ أتاكمْ من المديحِ بعقْدٍ","حسنه مثل وَصفِكم ليس يَخْفَى",68,"ف",2,0],["قد أتوا في الفعال كل قبيح","واستباحوا بجهلهم كل حرمه",69,"م",2,0],["قد اتفقا في صومه لثلاثة","من الشهر لكن جاء غير مفصل",70,"ل",1,0],["قد أتاني منه نظم كله","رائق في مدحه والغزل",71,"ل",1,0],["قد أتيتم بسؤال مشكل","لا أرى إشكاله بالمنجل",72,"ل",1,1],["قد أتى فيه كل ما قبَّح العق","ل ونَصُّ الكتابِ والآثار",73,"ر",1,0],["قد أتانا نظامك العذب يشكو","من ناء عن قربنا وبعاد",74,"د",1,0],["قد أتى لفظُكَ البَديعُ الّذي خر","رَتْ سجُوداً لُحسنِهِ الألفاظُ",75,"ظ",1,0],["قد أتَاكَ الزّمانُ بالعُذرِ والإع","تابِ ممّا جَناهُ إذ هُو غِرُّ",76,"ر",1,0],["قد أتينا بثوب جدّك نسعى","وأتيناك سيّدي وفّادا",77,"د",2,0],["قد أتى بالبديع تحت قوافٍ","حصنتها من البلاغة لامه",78,"م",2,0],["قد أتاني منه كتاب فاشفى","من فؤادي غليله وأوامه",78,"م",2,0],["قد أتى التاريخ يزهو","قارن الزهرة بدر",79,"ر",1,0],["قد اتته عرائس منك كانت","تتهادى بكسوة عربيه",80,"ي",2,0],["قد أتينا عبر المحيط لنلقاك فكان","البلاء ما قد رأينا",81,"ن",2,0],["قد أتتني فتطرَّبتُ لها","فعلةٌ منك قليلٌ من أتاها",82,"ا",3,0],["قد أتتني فتبسَّمتُ لها","وقليلا أنِستْ بالضِّحك سِنِّي",83,"ن",2,0],["قد اِتّخذوا للفتكِ والطّعنِ آلةً","قُدودَ العذارى والوشيجَ المقوَّما",84,"م",2,0],["قد أتتني تلك اليد البيضاء","والأماني مصونة والرجاء",85,"ا",2,1],["قَدْ أَتاني نِظامُكَ الدُّرُّ يا بَدء","رُ فأَحْيَا رَبْعَ الإخا والْوِدادِ",86,"د",1,0],["قَدْ أَتْعَبَ 