?id=101216",""],[5956,"عامُ الفجائع","https://www.poetsgate.com/ViewPoem.aspx?id=193099",""],[5956,"أرجو إله الناس يجمعني به","https://www.poetsgate.com/ViewPoem.aspx?id=207523",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""]],"verses":[["وَبِجِسمي ضَنىً بِخَصرِ سُلَيمى","مِثلُهُ فهوَ لا يَزالُ نَجيلا",0,"ل",2,0],["وَبِجَنْبِ الدَّارِ قَبْرٌ خَصِيبٌ","مِنْهُ يَسْتَسْقِي الْمَكَانُ الْجَديِبُ",1,"ب",1,0],["وَبِجيدِ مُغزِلَةٍ إِلى","وَجهٍ تُزَيِّنُهُ النَضارَه",2,"ر",2,0],["وَبِجيدِ مُغزِلَةٍ تَرودُ بِوَجرَةٍ","بَجَلاتِ طَلعٍ قَد خُرِفنَ وَضالِ",3,"ل",1,0],["وبجفنية من جلال أمانيه","طيوف علوية الإسراء",4,"ا",2,0],["وبجيدٍ كأنما نيطَ فيه","من نجوم السماءِ عقدٌ وسمط",5,"ط",1,0],["وبجدْواك علينا","تلقَح الأرضُ العَقامُ",6,"م",1,0],["وَبِجانِبِ الفُسطاطِ لي","قَمَرٌ يَعِزُّ لَهُ فِراقي",7,"ق",2,0],["وبجانبِي واهٍ كأَن خُفوقَه","لَما تلفَّتَ جَهْشَةُ المُتباكي",8,"ك",2,0],["وبجدِّهِ يوري الزنادَ وكدِّهِ","يُكبي إِذا ما كان غيرَ مُعانِ",9,"ن",1,0],["وبِجَوْرِه ما صارَ مُورِقُه","حظِّي وحظُّ سوايَ مُثمِرُه",10,"ر",2,0],["وبجلسة طابت لدىّ بغرفة","حملت عبير الغائب المتوسّم",11,"م",1,0],["وَبِجيدٍ أَغيَدٍ زَيَّنَهُ","خالِصُ الدُرِّ وَياقوتٌ بَهي",12,"ي",1,0],["وَبِجيدٍ جيدِ ريمٍ","يَرتَعي حُرَّ النَباتِ",13,"ت",1,0],["وبجزع ذَياك الحِمي ظَبيُ حَمَي","بِظُبَي اللواحِظِ إذ أحاذ إخاذا",14,"ذ",2,0],["وَبِجَدِّي شَيْخٌ مِنْ الدَّوْحِ صُلْبٌ","هُوِ ثَرْثَارَةٌ عَبُوسٌ كَجَدِّي",15,"د",2,0],["وَبِجَانِبِ الفُسْطَاطِ حَيٌّ مُوْحِشٌ","هُوَ مَوْطِنُ المَوْتَى مِنَ الأَحْيَاءِ",16,"ا",2,0],["وبجيد مغزلة ٍ ترودُ بوجرة","ٍ بَجَلاَتِ طَلْحٍ قد خُرِفن وَضالِ",17,"ل",1,0],["وبجميع أهل اللَه بالقطب الذي","رجع الزمان لرأيه ومقاله",18,"ل",2,0],["وبجرف هبت أنبع المولى له ال","ماء الزلال وفاض للوراد",19,"د",1,0],["وبجبر الهوية المحض لل","كل أنين وجحفل الليل ساري",20,"ر",2,0],["وبجدكم روح ال","برية عينها مجلى هداها",21,"ا",3,0],["وبجاهكم منوا عسى","تنحل من عقدي عراها",21,"ا",3,0],["وبجودهم عموا الوجود ومجدهم","كشف الدجا بمحجة بيضاء",22,"ا",2,0],["وبجيدِ