{"poems":[[63,"أيها الحي إن بكرتم رحيلا","https://www.aldiwan.net/poem45703.html","الخفيف"],[77,"صحت بالربع فلم يستجيبوا","https://www.aldiwan.net/poem36717.html","المديد"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[35,"إربع فحي معارف الأطلال","https://www.aldiwan.net/poem39096.html","الكامل"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[70,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[85,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[97,"إني لأقنع من ظلال أحبتي","https://www.aldiwan.net/poem24858.html","الكامل"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[35,"إرْبَعْ فَحَيِّ مَعَارِفَ الأطْلاَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=22143",""],[113,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[113,"لمعت بوارق دولة الإرشاد","https://www.aldiwan.net/poem41762.html","الكامل"],[113,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[113,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[113,"عج بالركائب ساحة الجرعاء","https://www.aldiwan.net/poem42181.html","الكامل"],[126,"جار الحبيب على الكئيب ببعده","https://www.aldiwan.net/poem50638.html","الكامل"],[142,"أبدا إليك تولع الأحباب","https://www.aldiwan.net/poem4461.html","الكامل"],[148,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[167,"كم أرجع الزفرات في أحشائي","https://www.aldiwan.net/poem1594.html",""],[167,"عذل المشوق يهيج في برحائه","https://www.aldiwan.net/poem1595.html",""],[167,"ما شئتما يا صاحبي فقولا","https://www.aldiwan.net/poem1656.html",""],[219,"أمل قطع حبل الأمل","https://www.aldiwan.net/poem55299.html","الرمل"],[221,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[229,"لمن المطايا في رباها تنفخ","https://www.aldiwan.net/poem44593.html","الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[230,"قلب رسيس هواك في سودائه","https://www.aldiwan.net/poem14725.html","الكامل"],[233,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[233,"شكري لسيب نوالك الغمر","https://www.aldiwan.net/poem31998.html","الكامل"],[257,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[259,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[269,"أتحب مسئلة بغير جواب","https://www.aldiwan.net/poem52114.html","الكامل"],[269,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[301,"قسما بناضر قدك اللدن القويم","https://www.aldiwan.net/poem57540.html","الكامل"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[318,"الدهر باغ معتدي","https://www.aldiwan.net/poem61623.html","مجزوء الكامل"],[326,"أكبرت عيدك هجرة المختار","https://www.aldiwan.net/poem54964.html","الكامل"],[359,"إن العواذل قد كووا","https://www.aldiwan.net/poem67582.html","مجزوء الكامل"],[400,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[400,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[426,"بخضاب قد زين الكف كفي","https://www.aldiwan.net/poem41028.html","الخفيف"],[426,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[429,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[436,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[436,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[441,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[451,"عزاء بهذا الموت يا من فدى مصرا","https://www.aldiwan.net/poem61244.html","الطويل"],[456,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[477,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[498,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[498,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[536,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[549,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[549,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[556,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[556,"كل وقت جمال وجهك بادي","https://www.aldiwan.net/poem34633.html","الخفيف"],[556,"بوجودي فغذني يا قوتي","https://www.aldiwan.net/poem34717.html","الخفيف"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[560,"قف بالديار وإن شجاك الموقف","https://www.aldiwan.net/poem52939.html","الكامل"]],"verses":[["وَبِجِسمي ضَنىً بِخَصرِ سُلَيمى","مِثلُهُ فهوَ لا يَزالُ نَجيلا",0,"ل",2,0],["وَبِجَنْبِ الدَّارِ قَبْرٌ خَصِيبٌ","مِنْهُ يَسْتَسْقِي الْمَكَانُ الْجَديِبُ",1,"ب",1,0],["وَبِجيدِ مُغزِلَةٍ إِلى","وَجهٍ تُزَيِّنُهُ النَضارَه",2,"ر",2,0],["وَبِجيدِ مُغزِلَةٍ تَرودُ بِوَجرَةٍ","بَجَلاتِ طَلعٍ قَد خُرِفنَ وَضالِ",3,"ل",1,0],["وبجفنية من جلال أمانيه","طيوف علوية الإسراء",4,"ا",2,0],["وبجيدٍ كأنما نيطَ فيه","من نجوم السماءِ عقدٌ وسمط",5,"ط",1,0],["وبجدْواك علينا","تلقَح الأرضُ العَقامُ",6,"م",1,0],["وَبِجانِبِ الفُسطاطِ لي","قَمَرٌ يَعِزُّ لَهُ فِراقي",7,"ي",1,0],["وبجانبِي واهٍ كأَن خُفوقَه","لَما تلفَّتَ جَهْشَةُ المُتباكي",8,"ك",2,0],["وبجدِّهِ يوري الزنادَ وكدِّهِ","يُكبي إِذا ما كان غيرَ مُعانِ",9,"ن",1,0],["وبِجَوْرِه ما صارَ مُورِقُه","حظِّي وحظُّ سوايَ مُثمِرُه",10,"ر",2,0],["وبجلسة طابت لدىّ بغرفة","حملت عبير الغائب المتوسّم",11,"م",1,0],["وَبِجيدٍ أَغيَدٍ زَيَّنَهُ","خالِصُ الدُرِّ وَياقوتٌ بَهي",12,"ي",1,0],["وَبِجيدٍ جيدِ ريمٍ","يَرتَعي حُرَّ النَباتِ",13,"ت",1,0],["وبجزع ذَياك الحِمي ظَبيُ حَمَي","بِظُبَي اللواحِظِ إذ أحاذ إخاذا",14,"ذ",2,0],["وَبِجَدِّي شَيْخٌ مِنْ الدَّوْحِ صُلْبٌ","هُوِ ثَرْثَارَةٌ عَبُوسٌ كَجَدِّي",15,"د",2,0],["وَبِجَانِبِ الفُسْطَاطِ حَيٌّ مُوْحِشٌ","هُوَ مَوْطِنُ المَوْتَى مِنَ الأَحْيَاءِ",16,"ا",2,0],["وبجيد مغزلة ٍ ترودُ بوجرة","ٍ بَجَلاَتِ طَلْحٍ قد خُرِفن وَضالِ",17,"ل",1,0],["وبجميع أهل اللَه بالقطب الذي","رجع الزمان لرأيه ومقاله",18,"ل",2,0],["وبجرف هبت أنبع المولى له ال","ماء الزلال وفاض للوراد",19,"د",1,0],["وبجبر الهوية المحض لل","كل أنين وجحفل الليل ساري",20,"ر",2,0],["وبجدكم روح ال","برية عينها مجلى هداها",21,"ا",3,0],["وبجاهكم منوا عسى","تنحل من عقدي عراها",21,"ا",3,0],["وبجودهم عموا الوجود ومجدهم","كشف الدجا بمحجة بيضاء",22,"ا",2,0],["وبجيدِه وبحُسْنه وبطرْفه","وبخاله وبفَوْدِه وبجُنده",23,"د",2,0],["وبجنة الخلد المنا حازوه والزلفى","وحسن الشرب في الأكواب",24,"ب",1,0],["وبجيدها في السلم منك وفي الوغى","سلكان من جود ومن إقدام",25,"م",1,0],["وَبِجانِبِ الزَوراءِ لي مُستَوطَنٌ","إِن شِئتُ أَو بِالمَوصِلِ الحَدباءِ",26,"ا",2,0],["وَبِجانِبِ المَولى المُعَظَّمِ شَأنُهُ","ما اِعتادَهُ مِن بَأسِهِ وَسَخائِهِ",27,"ا",3,0],["وَبِجامِعٍ نَدَّ الجَوامِعِ كُلَّها","حُسناً وَعَرضاً في البِناءِ وَطُولا",28,"ل",2,0],["وبجسمي من سهادي علة","تركت ظلي كظل المغزل",29,"ل",1,0],["وَبِجُنحِ الدُجى أَفاقَ المَو","تِ بَكيّاً وَالدَمع كان هِياما",30,"م",2,0],["وبجاهك الجاه المديد على المدى","ولك المقامات التي لا تبذخ",31,"خ",1,0],["وَبِجَبهَةِ الزَهراءِ حَوّا أَشرَقَت","لِلحَملِ بِالمَبعوثِ بِالفُرقانِ",32,"ن",1,0],["وَبِجِدِّهِ اِستَسقى الغَمائِمَ جَدُّهُ","فَتَبَجَّسَت بِالوابِلِ الهَتّانِ",32,"ن",1,0],["وَبِجانِبِ العَلَمين يُمنَةِ لَعلَعٍ","مَعنىً يَضوعُ المِسكُ مِن أَرجائِهِ",33,"ا",3,0],["وَبِجَرعاءِ الحِمى جارِيَةٌ","تَملِكُ الحُسنَ عَلى أَقرانِها",34,"ن",3,0],["وَبِجودِ شَمسِ الدينِ أَسفَرَ لي","حَظّي وَعادَ مُسالِمي دَهري",35,"ر",2,0],["وبجملة رسلك مَن بُعثوا","لنظام الأمر المنحرف",36,"ف",1,0],["وبجامع أسرار التحقي","ق بجامع قربك معتكف",36,"ف",1,0],["وبجانبيه صواهل","وهواجل حمر وجون",37,"ن",1,0],["وَبجامع النيابَتين صو يحب","واهى القوى متقطع الاسباب",38,"ب",1,0],["وَبجيم نحدته وَفاء وَفائه","فلسر سيرته وَسين سنائه",39,"ه",1,0],["وبجفني الدامي القريح الهامع ال","هامي الملث الهاطل الهتان",40,"ن",1,0],["وبجل اذا خاطبت من تجهل اسمه","لما أوجب التكليم في شبه اخوان",41,"ن",1,0],["وَبِجَنَّتَينِ خَصَّهُ","لِمَخافَةٍ وَتَزهَدِ",42,"د",1,0],["وبجنبه الصديق ملءُ فؤاده","حبّ النيّ وخشية الجبّار",43,"ر",1,0],["وَبجاهكم آل النَبِيّ","تَمَسكت كلتا يَدي",44,"ي",1,0],["وبجاه المصطفى من هاشم","أعظم العالم عند اللّه جاها",45,"ا",3,0],["وبجزمه عللتموه وليس في ال","منقول جزم يقتضي التعليلا",46,"ل",2,0],["وبجيدي حسن الحلي قد تفنن","واذا منكر اصرّ واعلن",47,"ن",1,0],["وبجمعة في ثالث منه أتى","ثلج يطوف على البطاح مهول",48,"ل",1,0],["وبجلق لما اناخ ركابه","ملئت صحاريها به وتلول",48,"ل",1,0],["وبجفنيك غِرارٌ","من كرًى وهْو غُرارُ",49,"ر",1,0],["وبجودِكَ اتَّصَلَتْ أَمانِيُّ الورى","بالنُّجْحِ وانْفَصَمَتْ عُرى الإِعدامِ",50,"م",1,0],["وبِجانِب الغَرْبيِّ إِذْ أَقْدَمتَها","شَعثاءَ بُشِّرَ بالفُتُوحِ شهيدُها",51,"د",3,0],["وبجمعنا هذا وما ترضاه من","نثر ونظم فائق التهذيب",52,"ب",1,0],["وبجّلتني حتى كأنّك تابعي","ولست الذي صالت مواهبه دهرا",53,"ر",2,0],["وبجرعاء الحمى قلبي فعجْ","بالحمى فاقرأ على قلبي السلاما",54,"م",2,0],["وبجاه أحمد سوف تر","فُل في النعيم وترتع",55,"ع",1,0],["وبجوف البحر كم قد أنقذت","غارقاً في لجَّةِ غوثتنا",56,"ن",2,0],["وبِجانِبِ المِيلَيْنِ أَعني الأَخْضَرَيْ","نِ بَوارِقٌ تَلوي الأَعارِبَ والعَجَمْ",57,"م",1,0],["وبجَمعِ إخوانٍ تبسَّمَ عنهُمُ","شِعرِي كِوردِ الروضِ غِبَّ عِهَاد",58,"د",1,0],["وبجَدّنا وبصنْوِه دُحِيَتْ عن ال","بيت الحرامِ وزُعزعتْ أصنامُهُ",59,"م",2,0],["وبجَدٍّ منه أروح وأحرا","رُ المعانِي وإنْ غَمِضْنَ عبيدِي",60,"د",2,0],["وبجماد وبنبات","وبأناس وحيوان",61,"ن",1,0],["وبجسمي أودى السقام وقلبي","زائل الصبر زائد الإيقاد",62,"د",1,0],["وبجهل أراك تبني نفوساً","وجسوماً بناية العنكبوت",63,"ت",1,0],["وَبَجَّ كُلَّ عانِدٍ نَعورِ","أَجوَفَ ذي ثَوّارَةٍ ثَؤورِ",64,"ر",1,0],["وبجانبِ الجَرْعاءِ قومٌ عِندَهم","ذِمَمٌ لَنا مَحفوظةٌ لا تُخْلَفُ",65,"ف",1,0]]}