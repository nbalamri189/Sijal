{"poems":[[63,"أيها الحي إن بكرتم رحيلا","https://www.aldiwan.net/poem45703.html","الخفيف"],[77,"صحت بالربع فلم يستجيبوا","https://www.aldiwan.net/poem36717.html","المديد"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[35,"إربع فحي معارف الأطلال","https://www.aldiwan.net/poem39096.html","الكامل"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[70,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[85,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[97,"إني لأقنع من ظلال أحبتي","https://www.aldiwan.net/poem24858.html","الكامل"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[35,"إرْبَعْ فَحَيِّ مَعَارِفَ الأطْلاَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=22143",""]],"verses":[["وَبِجِسمي ضَنىً بِخَصرِ سُلَيمى","مِثلُهُ فهوَ لا يَزالُ نَجيلا",0,"ل",2,0],["وَبِجَنْبِ الدَّارِ قَبْرٌ خَصِيبٌ","مِنْهُ يَسْتَسْقِي الْمَكَانُ الْجَديِبُ",1,"ب",1,0],["وَبِجيدِ مُغزِلَةٍ إِلى","وَجهٍ تُزَيِّنُهُ النَضارَه",2,"ر",2,0],["وَبِجيدِ مُغزِلَةٍ تَرودُ بِوَجرَةٍ","بَجَلاتِ طَلعٍ قَد خُرِفنَ وَضالِ",3,"ل",1,0],["وبجفنية من جلال أمانيه","طيوف علوية الإسراء",4,"ا",2,0],["وبجيدٍ كأنما نيطَ فيه","من نجوم السماءِ عقدٌ وسمط",5,"ط",1,0],["وبجدْواك علينا","تلقَح الأرضُ العَقامُ",6,"م",1,0],["وَبِجانِبِ الفُسطاطِ لي","قَمَرٌ يَعِزُّ لَهُ فِراقي",7,"ي",1,0],["وبجانبِي واهٍ كأَن خُفوقَه","لَما تلفَّتَ جَهْشَةُ المُتباكي",8,"ك",2,0],["وبجدِّهِ يوري الزنادَ وكدِّهِ","يُكبي إِذا ما كان غيرَ مُعانِ",9,"ن",1,0],["وبِجَوْرِه ما صارَ مُورِقُه","حظِّي وحظُّ سوايَ مُثمِرُه",10,"ر",2,0],["وبجلسة طابت لدىّ بغرفة","حملت عبير الغائب المتوسّم",11,"م",1,0],["وَبِجيدٍ أَغيَدٍ زَيَّنَهُ","خالِصُ الدُرِّ وَياقوتٌ بَهي",12,"ي",1,0],["وَبِجيدٍ جيدِ ريمٍ","يَرتَعي حُرَّ النَباتِ",13,"ت",1,0],["وبجزع ذَياك الحِمي ظَبيُ حَمَي","بِظُبَي اللواحِظِ إذ أحاذ إخاذا",14,"ذ",2,0],["وَبِجَدِّي شَيْخٌ مِنْ الدَّوْحِ صُلْبٌ","هُوِ ثَرْثَارَةٌ عَبُوسٌ كَجَدِّي",15,"د",2,0],["وَبِجَانِبِ الفُسْطَاطِ حَيٌّ مُوْحِشٌ","هُوَ مَوْطِنُ المَوْتَى مِنَ الأَحْيَاءِ",16,"ا",2,0],["وبجيد مغزلة ٍ ترودُ بوجرة","ٍ بَجَلاَتِ طَلْحٍ قد خُرِفن وَضالِ",17,"ل",1,0]]}