ر بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[493,"كذا من شام بارقة العذاب","https://www.aldiwan.net/poem9765.html","الوافر"],[498,"كتبت غيبا على ما قام في الأزل","https://www.aldiwan.net/poem37814.html","البسيط"],[536,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[538,"أرقتني تلومني أم بكر","https://www.aldiwan.net/poem56642.html","الخفيف"],[541,"أيا تملك يا تمل","https://www.aldiwan.net/poem1760.html","الهزج"],[549,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[549,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[549,"حذرتكم وكم لله عندي","https://www.aldiwan.net/poem47774.html","الوافر"],[549,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[551,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[561,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[562,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[562,"عيون من السحر المبين تبين","https://www.aldiwan.net/poem899.html",""],[565,"ولقد كتمت هواك أوثق صاحب","https://www.aldiwan.net/poem69474.html","الكامل"],[565,"مقلة بالدمع منبجسه","https://www.aldiwan.net/poem69641.html","المديد"],[568,"إن تك حرب فلم أجنها","https://www.aldiwan.net/poem59474.html","المتقارب"],[571,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[571,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[573,"حذار سيوف الهند من أعين الترك","https://www.aldiwan.net/poem2903.html","الطويل"]],"verses":[["حَذارِ بَني العَنقاءِ مِن مُتَطاوِلٍ","إِلى الحَربِ لا يَخشى جِنايَةَ جانِ",0,"ن",1,0],["حَذارِكَ مِن لَيثٍ تَرى حَولَ غيلِهِ","سَواقِطَ أَيدٍ لِلرِجالِ وَهامِ",1,"م",1,0],["حَذارِكُمُ بَني الضَحّالِ أَنّي","إِلى الأَمرِ الَّذي تومونَ أومي",2,"م",2,0],["حَذارِ لَهُ فَبَعدَ اليَومِ يَومٌ","لَهُ شَرَرٌ وَبَعدَ العامِ عامُ",3,"م",1,0],["حَذارِ فَإِنَّ عَلى الجَلهَتَينِ","هَموسَ الدُجى مُرصِداً لِلرِعالِ",4,"ل",1,0],["حَذَفتُ فُضولَ العَيشِ حَتّى رَدَدتُها","إِلى دونِ ما يَرضى بِهِ المُتَعَفِّفُ",5,"ف",1,0],["حَذارِ فَإِنَّ اللَيثَ قَد فَرَّ نابُهُ","وَقَد أَوتَرَ الرامي المُصيبُ وَأَنبَضا",6,"ض",2,1],["حِذارَكَ أَن تُغالِبَني غِلاباً","فَإِنّي لا أَدُرُّ عَلى الغِضابِ",7,"ب",1,0],["حَذارِ بَني الضَغائِنِ مِن جَريٍّ","إِذا ما الرَيبُ بادَهَهُ أَرابا",8,"ب",2,0],["حَذارِ إِذا تَلَفَّعَ ثَوبَ نَقعٍ","حَذارِ إِذا تَعَمَّمَ بِاللِواءِ",9,"ا",2,0],["حَذارِ مِنِ اِبنِ غَيطَلَةٍ مُدِلٍّ","يَسُدُّ مَطالِعَ البيدِ القَواءِ",9,"ا",2,0],["حَذارِ فدونَ ما تَسْمو إليهِ","أسامَةُ وَهْوَ مُفتَرِشُ اللَّبانِ",10,"ن",1,0],["حَذَرَ الخَونِ وَالتَعَدّي وَهَل يَن","قُضُ ما في المَهارِقِ الأَهواءُ",11,"ا",2,0],["حَذَراً عَلَيكِ فَإِنَّني بِكِ واثِقٌ","أَن لا يَنالَ سِوايَ مِنكِ نَصيبا",12,"ب",2,0],["حَذَراً عَلَيها أَن تُرى","أَو أَن يُطافَ بِبابِها",13,"ب",3,0],["حَذِراً يَرهَبُ الظَلامَ وَيَخشى","خَطرَةَ الريحِ أَو بُكاءَ الوَليدِ",14,"د",1,0],["حَذارِ حَذارِ فَإِنَّ الكَريمَ","إِذا سيمَ خَسفاً أَبى فَاِمتَعَض",15,"ض",1,0],["حِذارَكَ إِذ تَبغي عَلَيهِ مِنَ الرَدى","وَدونَكَ فَاِستَوفِ المُنى حينَ تُنصِفُ",16,"ف",1,0],["حِذارَكَ مِن أَن يُعقِبَ الرُزءُ فِتنَةً","يَضيقُ لَها عَن مِثلِ إيمانِكَ العُذرُ",17,"ر",1,0],["حِذارَكَ مِن أَن يُعقِبَ الرِزءُ فِتنَةً","يَضيقُ لَها عَن مِثلِ أَخلاقِكَ العُذرُ",18,"ر",1,0],["حِذارَكَ أَن تَغتَرَّ مِنهُ بِجانِبٍ","فَفي كُلِّ وادٍ مِن نَوائِبِهِ سَعدُ",19,"د",1,0],["حِذارَ اِجتِذامِ البَينِ أَقرانَ طِيَّةٍ","مُصيبٍ لِوَقراتِ الفُؤادِ اِنجِذامُها",20,"م",3,0],["حِذاراً عَلى وَسنانَ يَصرَعُهُ الكَرى","بِكُلِّ مَقيلٍ عَن ضِعافٍ فَواتِرِ",21,"ر",1,0],["حِذارَ المَنايا رَهبَةً أَن يَفُتنَها","بِهِ وَهيَ إِلّا ذاكَ أَضعَفُ ناصِرِ",21,"ر",1,0],["حذارَك من سقم الجفون فإنه","سيُعدي بما يعيي الطبيب المداويا",22,"ي",2,0],["حَذارِ حذار من جَشَع فإني","رأيت الناس أجْشعها اللئام",23,"م",1,0],["حذار عوادي القتل من سيف طرفه","فما كسر الأجفان إلا ليقتلا",24,"ل",2,0],["حَذَارِ الحلْمَ إنَّ الحلْ","مَ ذو أسْوٍ وذُو جَرْحِ",25,"ح",1,0],["حَذارِ فإن الليث قد فرّ نابَهُ","وقد أوترَ الرامي المصيبُ فأنبضا",26,"ض",2,1],["حذارِ سهامي المُصميات ولم تكن","لتُشويَ إن نصَّلتها بنصالكا",27,"ك",2,0],["حذارِ من غضبٍ إذا مسَّ بتكْ","لم يتعمدْ مثله فكٌّ وفكّْ",28,"ك",1,0],["حذارِ عُرامي أو نظارِ فإنما","يُظلكُمُ قَطعٌ من الرّجز مُرسلُ",29,"ل",1,1],["حذِرَتْ سِهامَ العينِ حُمْرتُها","فغدتْ من التَّسويدِ في عِصَمِ",30,"م",1,0],["حذَّرتني الناسَ فقد أصبحتْ","نفسيَ لا تألف إنسانا",31,"ن",2,0],["حَذَتْهُ معانقةُ الدراعين","معانقةَ القَاصرات الحسان",32,"ن",1,0],["حَذاها بِنا روحٌ زَواجِلُ وَاِنتَحَت","بِأَجوازِها أَيدٍ تَمُدُّ وَتَنزَحُ",33,"ح",1,0],["حِذا إِبِلٍ إِن تَتبَعِ الريحَ مَرَّةً","يَدَعها وَيُخفِ الصَوتَ حَتّى تَرَيَّعا",34,"ع",2,0],["حَذارِ فَتَحْتَ الرَّمادِ اللَّهيبُ","ومَنْ يبذُرِ الشَّوكَ يَجْنِ الجراحْ",35,"ح",1,0],["حذار فان الدهر منك بمرصد","اذا هو الفى غرة يتهجم",36,"م",1,0],["حَذَوتَ حَربَ الصَلاحِيّينَ في زَمَنٍ","فيهِ القِتالُ بِلا شَرعٍ وَلا أَدَبِ",37,"ب",1,0],["حذراً عليه وليس يدري أَنه","بالهجر أَول من سعى في قتلهِ",38,"ل",2,0],["حِذارَ فَتىً إِذا لَم يَرضَ عَنهُم","فَلَيسَ بِنافِعٍ لَهُمُ الحِذارُ",39,"ر",1,0],["حَذَراً عَلَيهِ قَبلَ يَومِ فِراقِهِ","حَتّى لَكِدتُ بِماءِ جَفنِيَ أَشرَقُ",40,"ق",1,0],["حَذِرتِ عَلَينا المَوتَ وَالخَيلُ تَلتَقي","وَلَم تَعلَمي عَن أَيِّ عاقِبَةٍ تُجلَي",41,"ل",2,0],["حِذاراً لِمُعرَوري الجِيادِ فَجاءَةً","إِلى الطَعنِ قُبلاً ما لَهُنَّ لِجامُ",42,"م",1,0],["حذفَ الزمانُ فضولَ عيشٍ شاغلٍ","عنهُ وخلَّدَ مجدَهُ وفَعالَهُ",43,"ل",2,0],["حَذا حذوَهمْ ضافي العطاء مؤَيَّدٌ","من اللّهِ ميمونُ النقيبةِ أبلخُ",44,"خ",1,0],["حَذَارِ لهم من سَخْطةِ اللّه إنها","يُشاهُ بها حُرُّ الوجوه ويُمْسَخُ",44,"خ",1,0],["حَذَّرتُكَ المَلِكَ الَّذي اِجتَمَعَت لَهُ","أَيدي المُلوكِ قَبائِلاً وَشُعوبا",45,"ب",2,0],["حَذارِ فَإِنَّ البَغيَ حَوضُ مَنِيَّةٍ","مَصادِرُهُ مَذمومَةٌ وَمَهامِدُه",46,"د",2,0],["حَذِرتُ الحُبَّ لَو أَغنى حِذاري","وَرُمتُ الفَرَّ لَو نَجّى فِراري",47,"ر",2,1],["حَذَفَت مِن فُضولِهِ صِحوَةُ العِت","قِ فَأَدَّتهُ كَالجَديلِ المُمَرِّ",48,"ر",1,0],["حَذَوا جِلدَها أَخفافَهُنَّ الَّتي لَها",