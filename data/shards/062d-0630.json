45,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[28,"لعمري لقد أوفى وزاد وفاؤه","https://www.aldiwan.net/poem1239.html",""],[2,"صحا القلب عن سلمى وأقصر باطله","https://www.aldiwan.net/poem25063.html","الطويل"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[31,"نزلت بمكة من قبائل نوفل","https://www.aldiwan.net/poem41827.html","الكامل"],[31,"نعم الفؤاد مزارها محظور","https://www.aldiwan.net/poem42536.html","الكامل"],[105,"أرى الأرض ترجف بالعالمين","https://www.aldiwan.net/poem43143.html","المتقارب"],[105,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[105,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[102,"القلب متصل الوجي","https://www.aldiwan.net/poem33128.html","مجزوء الكامل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[40,"أقول غداة استقل الجمي","https://www.aldiwan.net/poem42301.html","المتقارب"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[52,"ليت يومي بنهر فروخ عادا","https://www.aldiwan.net/poem27119.html","الخفيف"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"حي الديار إذ الزمان زمان","https://www.aldiwan.net/poem66132.html","الكامل"],[48,"لا تفرغ النفس من شغل بدنياها","https://www.aldiwan.net/poem66198.html","البسيط"],[50,"حذا خالد في فعله حذو برمك","https://www.aldiwan.net/poem62291.html","الطويل"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[7,"كتمتك ليلاً بالجمومين ساهرا","https://www.aldiwan.net/poem1994.html","الطويل"],[7,"حذار مدبرة سكاء مقبلة","https://www.aldiwan.net/poem2009.html","البسيط"],[46,"عليك بتقوى الله في كل مشهد","https://www.aldiwan.net/poem23034.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/147230","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141027",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140815",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72190","البسيط"],[37,"","https://poetry.dctabudhabi.ae/diwan/poem/51532","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9921","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54987","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54600","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54706","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[106,"سمر الأدباء","https://www.poetsgate.com/ViewPoem.aspx?id=179454",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"إلى روح العلامة الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=179049",""],[45,"دَنَا السّرْبُ، إلاّ أنّ هَجراً يُباعِدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32954",""],[38,"أفي أثرِ الأظعانِ عينكَ تلمحُ","https://www.poetsgate.com/ViewPoem.aspx?id=21141",""],[51,"كسته القنا حُلَّة من دم","https://www.poetsgate.com/ViewPoem.aspx?id=30665",""],[31,"نَزَلَتْ بِمَكَّة َ مِنْ قَبَائِلِ نَوْفَلِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19042&r=&rc=305",""]],"verses":[["حَذارِ بَني العَنقاءِ مِن مُتَطاوِلٍ","إِلى الحَربِ لا يَخشى جِنايَةَ جانِ",0,"ن",1,0],["حَذارِكَ مِن لَيثٍ تَرى حَولَ غيلِهِ","سَواقِطَ أَيدٍ لِلرِجالِ وَهامِ",1,"م",1,0],["حَذارِكُمُ بَني الضَحّالِ أَنّي","إِلى الأَمرِ الَّذي تومونَ أومي",2,"م",2,0],["حَذارِ لَهُ فَبَعدَ اليَومِ يَومٌ","لَهُ شَرَرٌ وَبَعدَ العامِ عامُ",3,"م",1,0],["حَذارِ فَإِنَّ عَلى الجَلهَتَينِ","هَموسَ الدُجى مُرصِداً لِلرِعالِ",4,"ل",1,0],["حَذَفتُ فُضولَ العَيشِ حَتّى رَدَدتُها","إِلى دونِ ما يَرضى بِهِ المُتَعَفِّفُ",5,"ف",1,0],["حَذارِ فَإِنَّ اللَيثَ قَد فَرَّ نابُهُ","وَقَد أَوتَرَ الرامي المُصيبُ وَأَنبَضا",6,"ض",2,1],["حِذارَكَ أَن تُغالِبَني غِلاباً","فَإِنّي لا أَدُرُّ عَلى الغِضابِ",7,"ب",1,0],["حَذارِ بَني الضَغائِنِ مِن جَريٍّ","إِذا ما الرَيبُ بادَهَهُ أَرابا",8,"ب",2,0],["حَذارِ إِذا تَلَفَّعَ ثَوبَ نَقعٍ","حَذارِ إِذا تَعَمَّمَ بِاللِواءِ",9,"ا",2,0],["حَذارِ مِنِ اِبنِ غَيطَلَةٍ مُدِلٍّ","يَسُدُّ مَطالِعَ البيدِ القَواءِ",9,"ا",2,0],["حَذارِ فدونَ ما تَسْمو إليهِ","أسامَةُ وَهْوَ مُفتَرِشُ اللَّبانِ",10,"ن",1,0],["حَذَرَ الخَونِ وَالتَعَدّي وَهَل يَن","قُضُ ما في المَهارِقِ الأَهواءُ",11,"ا",2,0],["حَذَراً عَلَيكِ فَإِنَّني بِكِ واثِقٌ","أَن لا يَنالَ سِوايَ مِنكِ نَصيبا",12,"ب",2,0],["حَذَراً عَلَيها أَن تُرى","أَو أَن يُطافَ بِبابِها",13,"ب",3,0],["حَذِراً يَرهَبُ الظَلامَ وَيَخشى","خَطرَةَ الريحِ أَو بُكاءَ الوَليدِ",14,"د",1,0],["حَذارِ حَذارِ فَإِنَّ الكَريمَ","إِذا سيمَ خَسفاً أَبى فَاِمتَعَض",15,"ض",1,0],["حِذارَكَ إِذ تَبغي عَلَيهِ مِنَ الرَدى","وَدونَكَ فَاِستَوفِ المُنى حينَ تُنصِفُ",16,"ف",1,0],["حِذارَكَ مِن أَن يُعقِبَ الرُزءُ فِتنَةً","يَضيقُ لَها عَن مِثلِ إيمانِكَ العُذرُ",17,"ر",1,0],["حِذارَكَ مِن أَن يُعقِبَ الرِزءُ فِتنَةً","يَضيقُ لَها عَن مِثلِ أَخلاقِكَ العُذرُ",18,"ر",1,0],["حِذارَكَ أَن تَغتَرَّ مِنهُ بِجانِبٍ","فَفي كُلِّ وادٍ مِن نَوائِبِهِ سَعدُ",19,"د",1,0],["حِذارَ اِجتِذامِ البَينِ أَقرانَ طِيَّةٍ","مُصيبٍ لِوَقراتِ الفُؤادِ اِنجِذامُها",20,"م",3,0],["حِذاراً عَلى وَسنانَ يَصرَعُهُ الكَرى","بِكُلِّ مَقيلٍ عَن ضِعافٍ فَواتِرِ",21,"ر",1,0],["حِذارَ المَنايا رَهبَةً أَن يَفُتنَها","بِهِ وَهيَ إِلّا ذاكَ أَضعَفُ ناصِرِ",21,"ر",1,0],["حذارَك من سقم الجفون فإنه","سيُعدي بما يعيي الطبيب المداويا",22,"ي",2,0],["حَذارِ حذار من جَشَع فإني","رأيت الناس أجْشعها اللئام",23,"م",1,0],["حذار عوادي القتل من سيف طرفه","فما كسر الأجفان إلا ليقتلا",24,"ل",2,0],["حَذَارِ الحلْمَ إنَّ الحلْ","مَ ذو أسْوٍ وذُو جَرْحِ",25,"ح",1,0],["حَذارِ فإن الليث قد فرّ نابَهُ","وقد أوترَ الرامي المصيبُ فأنبضا",26,"ض",2,1],["حذارِ سهامي المُصميات ولم تكن","لتُشويَ إن نصَّلتها بنصالكا",27,"ك",2,0],["حذارِ من غضبٍ إذا مسَّ بتكْ","لم يتعمدْ مثله فكٌّ وفكّْ",28,"ك",1,0],["حذارِ عُرامي أو نظارِ فإنما","يُظلكُمُ قَطعٌ من الرّجز مُرسلُ",29,"ل",1,1],["حذِرَتْ سِهامَ العينِ حُمْرتُها","فغدتْ من التَّسويدِ في عِصَمِ",30,"م",1,0],["حذَّرتني الناسَ فقد أصبحتْ","نفسيَ لا تألف إنسانا",31,"ن",2,0],["حَذَتْهُ معانقةُ الدراعين","معانقةَ القَاصرات الحسان",32,"ن",1,0],["حَذاها بِنا روحٌ زَواجِلُ وَاِنتَحَت","بِأَجوازِها أَيدٍ تَمُدُّ وَتَنزَحُ",33,"ح",1,0],["حِذا إِبِلٍ إِن تَتبَعِ الريحَ مَرَّةً","يَدَعها وَيُخفِ الصَوتَ حَتّى تَرَيَّعا",34,"ع",2,0],["حَذارِ فَتَحْتَ الرَّمادِ اللَّهيبُ","ومَنْ يبذُرِ الشَّوكَ يَجْنِ الجراحْ",35,"ح",1,0],["حذار فان الدهر منك بمرصد","اذا هو الفى غرة يتهجم",36,"م",1,0],["حَذَوتَ حَربَ الصَلاحِيّينَ في زَمَنٍ","فيهِ القِتالُ بِلا شَرعٍ وَلا أَدَبِ",37,"ب",1,0],["حذراً عليه وليس يدري أَنه","بالهجر أَول من سعى في قتلهِ",38,"ل",2,0],["حِذارَ فَتىً إِذا لَم يَرضَ عَنهُم","فَلَيسَ بِنافِعٍ لَهُمُ الحِذارُ",39,"ر",1,0],["حَذَراً عَلَيهِ قَبلَ يَومِ فِراقِهِ","حَتّى لَكِدتُ بِماءِ جَفنِيَ أَشرَقُ",40,"ق",1,0],["حَذِرتِ عَلَينا المَوتَ وَالخَيلُ تَلتَقي","وَلَم تَعلَمي عَن أَيِّ عاقِبَةٍ تُجلَي",41,"ل",2,0],["حِذاراً لِمُعرَوري الجِيادِ فَجاءَةً","إِلى الطَعنِ قُبلاً ما لَهُنَّ لِجامُ",42,"م",1,0],["حذفَ الزمانُ فضولَ عيشٍ شاغلٍ","عنهُ وخلَّدَ مجدَهُ وفَعالَهُ",43,"ل",2,0],["حَذا حذوَهمْ ضافي العطاء مؤَيَّدٌ","من اللّهِ ميمونُ النقيبةِ أبلخُ",44,"خ",1,0],["حَذَارِ لهم من سَخْطةِ اللّه إنها","يُشاهُ بها حُرُّ الوجوه ويُمْسَخُ",44,"خ",1,0],["حَذَّرتُكَ المَلِكَ الَّذي اِجتَمَعَت لَهُ","أَيدي المُلوكِ قَبائِلاً وَشُعوبا",45,"ب",2,0],["حَذارِ فَإِنَّ البَغيَ حَوضُ مَنِيَّةٍ","مَصادِرُهُ مَذمومَةٌ وَمَهامِدُه",46,"د",2,0],["حَذِرتُ الحُبَّ لَو أَغنى حِذاري","وَرُمتُ الفَرَّ لَو نَجّى فِراري",47,"ر",2,1],["حَذَفَت مِن فُضولِهِ صِحوَةُ العِت","قِ فَأَدَّتهُ كَالجَديلِ المُمَرِّ",48,"ر",1,0],["حَذَوا جِلدَها أَخفافَهُنَّ الَّتي لَها","بَصائِرُ مِن مَخروقِها المُتَقَوِّبِ",49,"ب",1,0],["حُذَيفَةُ يُنميهِ وَبَدرٌ كِلاهُما","إِلى باذِخٍ يَعلو عَلى مَن يُطاوِلُه",50,"ل",2,0],["حَذَفَ المُنى عَنهُ المُشَمِّرُ في الهُدى","وَأَرى مُناكَ طَويلَةَ الأَذيالِ",51,"ل",1,0],["حَذراً عَلَيكَ مِنَ الفَعالِ الجافي","أُدنيكَ مُجتَهِداً إِلى الإِنصافِ",52,"ف",1,1],["حَذِرَت عُيونَ العاشِقينَ فَصَيَّرَت","بُرجَ الهِلالِ تَمائِماً وَعُقودا",53,"د",2,0],["حذارِ حساماً حدُّهُ لحظةٌ فما","يُسَمّى غِشاءُ العينِ جفناً لباطِلِ",54,"ل",1,0],["حُذِيَت حِذاءَ الحَضرَمِيَّةِ أُرهِفَت","وَأَجادَها التَخصيرُ وَالتَلسينُ",55,"ن",1,0],["حَذَوناها الوَجى وَالأَينَ حَتّى","تَجاوَزَتِ الرُكوعَ إِلى السُجودِ",56,"د",1,0],["حَذّاءُ تَملَأُ كُلَّ أُذنٍ حِكمَةً","وَبَلاغَةً وَتُدَرُّ كُلَّ وَريدِ",57,"د",1,0],["حذاري بني الخليج فثمَّ وحشٌ","حديدُ الناب مفترسٌ حقود",58,"د",1,0],["حِذَراً عَلَيها مِن مَقالَةِ كاشِحٍ","ذَرِبِ اللِسانِ يَقولُ ما لَم تَفعَلِ",59,"ل",1,0],["حَذِرٌ قَليلُ النَومِ ذو قاذورَةٍ","فَطِنٌ بِأَلبابِ الرِجالِ بَصيرُ",60,"ر",1,0],["حَذارِ بَني مِصرَ مِن وَقعِها","صَواعِقَ تَعصِفُ بِالأَنجُمِ",61,"م",1,0],["حذار فَما ثُمامةُ غير عَضْبٍ","لكم في حَدِّهِ الموتُ الزُّؤامُ",62,"م",1,0],["حذار بني قريظة من عليٍّ","ولا يغرركمُ الأُطُمُ الطويلُ",63,"ل",1,0],["حَذرته حُباً عَوا","قبه اللواعج وَالدَمار",64,"ر",1,0],["حَذَراً وَالسِربُ أَكنافَها","مُستَظِلُّ في أُصولِ السَلام",65,"م",1,0],["حِذارَ نَوى وَليِهم أَن نَأوا","وَمَن سَكَنُوا وَليَهُم أَنزَحُ",66,"ح",1,0],["حَذَراً أَيُّها الحَسودُ فَلا تَغ","فِر لِلَحمي فَإِنَّ لَحمي وَبِيُّ",67,"ي",1,0],["حَذِّقوا لَذَّةَ الحَياةِ وَأَغرى","جَودُهُم دَهرَهُم فَصارا جَوادا",68,"د",2,0],["حذار من أن ترى فوارسها","مقنعات على صواهلها",69,"ل",3,0],["حِذارَ فَتىً يَلْقَى الغَيورَ بحتْفِهِ","ويَمْرُقُ تحتَ الليلِ من جِلد أرقَم",70,"م",1,0],["حَذَرَ اِمرِئٍ نُصِرَت يَداهُ عَلى العِدى","كَالدَهرِ فيهِ شَراسَةٌ وَلَيانُ",71,"ن",1,0],["حَذَّرتُكَ الكِبرَ لا يَعلَقكَ ميصَمُهُ","فَإِنَّهُ مَلبَسٌ نازَعتُهُ اللَهَ",72,"ه",1,0],["حَذا خالِدٌ في فِعلِهِ حَذوَ بَرمَكٍ","فَمَجدٌ لَهُ مُستَطرَفٌ وَأَصيلُ",73,"ل",1,1],["حَذَرَ العَينِ فَإِنّا","لَم نَكُن أَهلَ مَعابِ",74,"ب",1,0],["حَذاها وَجهَهُ نَعلاً","فَلَم تَمشِ عَلى التُربِ",75,"ب",1,0],["حِذاراً عَلى أَن لا تُنالَ مَقادَتي","وَلا نِسوَتي حَتّى يَمُتنَ حَرائِرا",76,"ر",2,0],["حَذّارُ مُدبِرَةٌ سَكّاءُ مُقبِلَةٌ","لِلماءِ في النَحرِ مِنها نَوطَةٌ عَجَبُ",77,"ب",1,1],["حَذِرنا فَصادَتنا الخُلوبُ كَغَيرِنا","وَأَيُّ غُرابٍ ما أَجادَت لَهُ طَبَقا",78,"ق",2,0],["حذار من العباب فلا تخضه","مخافة أَن يطوحك العباب",79,"ب",1,0],["حذارِ بني الخليج فثمَّ وحشٌ","حديدُ الناب مفترسٌ حقود",80,"د",1,0],["حذرت علينا الموت والخيل تدّعي","ولم تعلمي عن أيّ عاقبةٍ تجلي",81,"ل",2,0],["حذاراً عليه قبل يوم فراقه","حتى لكدت بماء جفني أشرق",82,"ق",1,0],["حَذِقَتْ عِلمَ الأوالي ووعتْ","قصصَ الحبِّ ومأثورَ لغاها",83,"ا",3,0],["حَذَّاءُ مُدْبِرةً سَكَّاءُ مقبلةً","للماء في النحر منها نَوْطةٌ عَجَبُ",84,"ب",1,1],["حِذَارَ مَنِيَّةٍ لا بُدَّ مِنهَا","وَهَل دُونَ المَنِيَّةِ مِن طرِيقِ",85,"ق",1,0],["حَذِرتُ مِنَ البَينِ المُفَرِّقِ بَينَنا","وَقَد كانَ ظَنّي لا أُفارِقُكُم جَهدي",86,"ي",1,0],["حَذَّرْتُمونِي عِقَابا إِنْ","لَمْ أُطِعْ وَأَعِشْا",87,"ش",2,0],["حَذارِ مِنَ الفقْرِ المُنِيخِ بِكَلكَلٍ","فَمَا مِنْ مُذلٍّ لِلأَعِزَّاءِ كَالفَقْرِ",88,"ر",1,0],["حَذَرَ المَهَانَاتِ الَّتي","مُتَقَدِّمُوهُ بِهَا أُصِيْبُوا",89,"ب",3,0],["حَذَارِ لِقَلْبِكَ مِنْ لَحْظِهَا","فَما فِيهِ مِنْ رَحْمَةٍ لِلْمُحِبِّ",90,"ب",1,1],["حَذِّرْهُمُ مَا فِي الطَّرِيقِ","مِنْ بَلاَءٍ وَخَطَرْ",91,"ر",1,0],["حَذَّرُوهُ شَرَّ مَا يُعْقِبُهُ","بَغْيُهُ إِنْ لَمْ يَخَفْ لَوْماً وشُرَّا",92,"ر",2,0],["حَذَا حَذْوَهُ مِيشِيلُ بَلْ زَادَ هِمَّةً","وَمَنْ لأَبِيهِ بِالشَّبَابِ المُجَدِّدِ",93,"د",1,0],["حَذَقوا الطِبَّ والزمانُ عُلاَمٌ","والثقافاتُ رُضَّعٌ في المُهُودِ",94,"د",1,0],["حذقوا البيانَ: قديمَه وحديثه","ولكل عصر بينهم أنصار",95,"ر",1,0],["حذر الجور والتعدي وهل ين","قض ما في المهارق الأهواء",96,"ا",2,0],["حذِرتُ وماذا يُفيد الحذرْ","وفوقَ يميني يمينُ القَدَرْ",97,"ر",1,1],["حِذار، فإنّ البَغيَ خَوْضُ مَنيّةٍ،","مَصَادِرُهُ مَذْمُومَةٌ، وَمحَامِدهُ",98,"د",2,0],["حذاها بنا روحٌ زواحلُ وانتحتْ","بِأجْوَازِهَا أيْدٍ تَمُدُّ وتَنْزَحُ",99,"ح",1,0],["حَذَتْهُ معانقة ُ الذراعي","ن معانقة َ القَاصرات الحسان",100,"ن",1,0],["حذراً عليها من مقالة كاشحٍ،","ذربِ اللسان، يقول ما لم نفعل",101,"ل",1,0]]}