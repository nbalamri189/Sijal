://poetry.dctabudhabi.ae/diwan/poem/102754","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90840","الوافر"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45013","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94594","الطويل"],[4251,"","https://poetry.dctabudhabi.ae/diwan/poem/97861","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72835","المنسرح"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4691,"تاج الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175320",""],[4755,"لِأَنَّ الحُرَّ يَأبَى مَن يَجُورُ","https://www.poetsgate.com/ViewPoem.aspx?id=202738",""],[182,"","https://www.poetsgate.com/ViewPoem.aspx?id=72802",""],[4984,"عاد رفاق الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=190247",""],[4984,"الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=196950",""],[5005,"سوسن..","https://www.poetsgate.com/ViewPoem.aspx?id=189350",""],[5061,"قصيدة المواد","https://www.poetsgate.com/ViewPoem.aspx?id=147164",""],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5170,"المرثية","https://www.poetsgate.com/ViewPoem.aspx?id=175493",""],[5186,"رفعت إلى أوج العلى راية الهند","https://www.poetsgate.com/ViewPoem.aspx?id=156480",""],[5277,"تخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=204948",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5689,"باتت تناجيك خلف اليم في الغمم","https://www.poetsgate.com/ViewPoem.aspx?id=143421",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5848,"أغنيه","https://www.poetsgate.com/ViewPoem.aspx?id=48808",""],[5956,"أنانياتها","https://www.poetsgate.com/ViewPoem.aspx?id=182455",""],[5956,"أليمٌ أن أخَسِّرهُ حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=193200",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[6093,"عاجن","https://www.poetsgate.com/ViewPoem.aspx?id=203761",""],[2220,"إذا أنا بالقرعِ الشديد لبابهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11201&r=&rc=75",""],[5190,"أُحمِّلك السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78312&r=&rc=25",""]],"verses":[["وَيَأخُذُني لِذِكرُكُمُ اِرتِياحٌ","كَما نَشَطَ الأَسيرُ مِنَ العِقالِ",0,"ل",1,0],["وَيا خَيلُ فَاِبكي فارِساً كانَ يَلتَقي","صُدورَ المَنايا في غُبارِ المَعامِعِ",1,"ع",1,0],["ويا خصره من دون ردفيهِ إنما","على البعد ترمي دونه الثقلان",2,"ن",1,0],["وَيا خَجَلي إِذا قالوا مُحِبٌّ","وَلَم أَنفَعكَ في خَطبٍ أَتاكا",3,"ك",2,0],["وَيَأخُذُ المَجدَ عَن مِصرٍ وَصاحِبِها","عَنِ السَراةِ الأَعالي مِن مَواليها",4,"ي",3,0],["وَيَأخُذُ مِن قوتِ الفَقيرِ وَكَسبِهِ","وَيُؤوي جُيوشاً كَالحَصى وَيَميرُ",5,"ر",1,0],["ويا خبيراً على الأسرار مُطّلِعاً","اصْمُتْ ففي الصَّمْتِ مَنْجاةٌ من الزَّلَلِ",6,"ل",1,0],["وَيا خَبيراً عَلى الأَسرارِ مُطَّلِعاً","فيكَ الخِصامُ وَأَنتَ الخَصمُ وَالحَكَمُ",7,"م",1,0],["وَيَأخُذُ مِن أَيديكُما وَهَواكُما","فَلا عَجَبٌ أَن تَأخُذا مِن لِسانِهِ",8,"ن",2,0],["وَيَأخُذَكَ الوَسواسُ مِن لاعِجِ الهَوى","وَتَخرَسُ حَتّى لا تُجيبُ المُنادِيا",9,"ي",2,0],["وَيَأخُذُهُ الهِداجُ إِذا هَداهُ","وَليدُ الحَيِّ في يَدِهِ الرِداءُ",10,"ا",2,0],["وَيَأخُذونَ ما لَهُم صُراحا","وَيَخضِبونَ مِنهُمُ السِلاحا",11,"ح",2,0],["وَيَأخُذُ لَحظَ العَينِ مِمَّن أُحِبُّهُ","شِفاءً وَأَلقى زائِراً وَمُسَلِّما",12,"م",2,0],["وَيَأخُذُ شِرَّةَ إِخوانِهِ","مُفيداً كَما يَأخُذُ الأَبعَدُ",13,"د",1,0],["وَيا خَليلي دَرَني زائِدٌ","فَأَقصِني في الأَرضِ أَو دارِني",14,"ن",2,0],["ويأخذُني الشكُّ في قَوْلها","فتُقنعني بأساريرها",15,"ه",2,0],["ويا خلة الباكي عليه تصنعاً","ألم تك قبل اليوم ممن يغايره؟",16,"ر",2,0],["ويا خطوب الدّهر لا تهوّلي","روّضك الحبّ فلن تخيفي",17,"ف",2,0],["ويا خيبة الطاغي يدلّ بنصره","ومن سيفه لا روحه انبثق النّصر",18,"ر",1,0],["ويا خالدي الشان يا شبل أحمد","أغثني وارد كنى وكن مسعفي دهرا",19,"ر",2,0],["ويا خجلي من بارئي يوم محشري","وعرضي على مولاي كيف أخاطبه",20,"ب",2,0],["ويا خيرَ مسئولٍ دعوناك فاستجبْ","وأكرمَ مأمولٍ به وثق الكُلُّ",21,"ل",1,0],["ويأخذ من أموالهم أخذَ مالِكٍ","ويَففونُه إن راحَ يَوماً أو اغتَدَى",22,"د",2,0],["ويأخذُ من أموالهم أخذَ مالِكٍ","ويَقفَونُه إِن رَاحَ يَوماً أو اغتَدَى",22,"د",2,0],["ويَأخُذُ مِن رَوحِلِهِم وَيأتِى","بِهَأ كُوماً كَمِثلِ الأكمِ قُودَا",23,"د",2,0],["ويأخذ من ف يالبر والبحر إن غدا","ويدرك من فات الصوارم في الكف",24,"ف",1,0],["ويأَخذُ للضعيفِ إذا تعدّى","عليه من القوي الجَلد ثارا",25,"ر",2,0],["ويأخذ أسلاب العقول به الرنا","كما أخذت أسلاب شاربها الخمر",26,"ر",1,0],["ويأخذها عجب وتيه فتزدرى","سواك وتوليك الثنا فتطيل",27,"ل",1,0],["ويا خليفته المرضى خليقته","راج رضى الله عنه حين يرضيها",28,"ي",3,0],["ويأخذ منه جذرا عن كلام","يزخرفه كمعترض السراب",29,"ب",1,0],["وَيا خيبةَ الأحزابِ حينَ تَشتّتوا","وَكانَ عَليهم ريحُ نُصرتهِ صِرّا",30,"ر",2,0],["ويا خيرَ مولًى انت ارحمُ رحمةً","واكرمُ من تجزي مكارمهُ عبدا",31,"د",2,0],["ويا خمر ريقٍ فوقه ورد وجنةٍ","فمَن لي بذا رشفاً ومن لي بذا قطفا",32,"ف",2,0],["ويأخذ بالالباب سحر كلامها","فهل اخذت عن بابل صنعة السحر",33,"ر",1,0],["وَيَأخذُ البِرَّ وَآيَ الوَفا","عن الكتاب الطيِّبِ المَشرَعِ",34,"ع",1,0],["وَيا خَيرَ مَن يُدعى لِيَومِ كَريهَةٍ","وَأَكرَمَ مَن يُرجى لِيَومِ رَخاءِ",35,"ا",2,0],["ويا خير من في الروع أفرغ لامة","تفيض على أعطافه والمناكب",36,"ب",1,0],["ويا خدوداً كرَوضٍ","يَسقيهِ ماءٌ معين",37,"ن",1,0],["ويا خُصوراً رِقاقاً","مِنها يرقُّ السَّمينِ",37,"ن",1,0],["ويأخذُ للعزائم والمواضي","مضاءً من حسامٍ خالدي",38,"ي",1,0],["وَيا خَرَسَ الفُصْحِ الذي سَنَّهُ لَهُم","وغَادَرَ فيهِ القُسُّ يَعْرضُ مَا قَصَّا",39,"ص",2,0],["وَيا خَيْرَ مَنْ وَلَدَ الْمُنْجِبُونَ","وَأَكْرَمَهُمْ شائِداً بَعْدَ بانِ",40,"ن",1,0],["وَيا خَيالَ الحَبيبِ عُدني","أَو لا فَعِدني لَيلاً لِمامَك",41,"ك",1,0],["ويأخذه كالسكر طيباً ونشوة","إذا ذكروا والراح ذكر وتذكار",42,"ر",1,0],["وَيا خالقَ الأدواءِ عافِ قلوبنا","وَأَجسامَنا أَن تَشتكي الضرّ والسقما",43,"م",2,0],["وَيا خلّاً بِهِ يَسمو مَقامي","أجلُّ مَقام فَضلك عَن مَقالي",44,"ل",2,0],["وَيا خَليليَّ صَفحاً عَن ملامكما","وَخلّيا عَتب هَذا الدَهر وَاِنشَرحا",45,"ح",2,0],["ويأخُذُ أَخْذَ المُريبِ العُهودَ","بكَتْمِ العقيدةِ إذ تُبتلَى",46,"ا",1,0],["ويأخذ بالمنقول منهم عقارهم","ويعرض عما قد تلى في التكاثر",47,"ر",1,0],["ويا خليلا على الأشواق مطلعا","كيف انثنيت لسهو ما عهدناه",48,"ا",2,0],["ويا خِزْيَ العدى لما استَتَمَّا","إِلَيْهِمْ بالكتائِبِ قائِدَيْنِ",49,"ن",1,0],["ويا خَلَّتي إِنْ سَوَّفَ الغَوْثُ بالمُنى","ويا غُلَّتِي إِنْ أَبْطَأَ الغَيْثُ بالسُّقْيا",50,"ي",2,0],["ويا خُلَّة التَّسويفِ قُومي فأغدِقي","قناعَكِ من دُوني وشُدِّي إِزارَكِ",51,"ك",1,0],["ويأخذ تفسير الثقاة وغيرهم","كطفل ومن طرس ومن صابئٍ صبا",52,"ب",2,0],["ويأخذ منَّا وتُعطوننا","ويجلُب فينا فتُستَنجَدونا",53,"ن",2,0],["ويأخذ الدهر بناصيتها","سَوْقاً فيأتيك بها معتذرا",54,"ر",2,0],["ويأخذُ منّي الحاضرون ببخلهم","فواضلَ ما يُعطى السماحُ المغيَّبُ",55,"ب",1,0],["ويأخُذُني نَجْدي له أينما انْتَحى","إذا ما استفَزَّ القومَ في أمرِهِمْ نَجْدُ",56,"د",1,0],["ويا خليفةَ (نوحٍ) في سفينتِهِ","حيث الأمانةُ لاَقَتْ أشرفَ الأُمَنَا",57,"ن",2,0],["وَيا خالِداً في جِنانِ النّعيمِ","لَنا خالدٌ في جِنانِ الدُّنا",58,"ا",1,0],["ويا خافض اخفض قدر من رام لي أذىً","ويا رافع ارفعني على الضد راقيا",59,"ي",2,0],["ويا خالق الخلق يا من له","أيادٍ علينا تفيضُ الحكم",60,"م",1,0],["ويا خَاطِري كلُّ التَّغَزُّل في الهوى","نفيسٌ ولكن مدحُ يوسفَ أَنْفَسُ",61,"س",1,0],["وَيا خَجْلةَ الشَّمْسِ لمّا بَدتْ","ألم ترَ فيها احْمِرارَ الخَجلْ",62,"ل",1,0],["وَيَأخذ بَينَ الصُفوف مَكان","الأَلى طحنتهم تُروس الرحى",63,"ا",1,0],["ويا خليلّي إني","قد عاودتني همومي",64,"ي",1,0],["وَيَأخذهم مِن كُلِّ فَجّ بَنادقٌ","وَبيض وسُمر في أَكُف جُنود",65,"د",1,0],["وَيا خَير مَن فاق الأَنام بحكمة","وَصدق وَعرفان وَرأي مسدد",66,"د",1,0],["وَيا خَصب أَوطان لَها أَنتَ سَيدٌ","لَقَد عَمَّها مِن راحتيك المَواهب",67,"ب",1,0],["وَيا خوطَ بانِ الحُسنِ رَنَّحهُ الصَّبا","ويا مَنْ بِأَحداقِ المَهاةِ تَصولُ",68,"ل",1,0],["ويا خيرَ خلق إلَه العبادِ","وأزكى وأهداهمُ أجمعينا",69,"ن",2,0],["ويا خيرَ مَنْ آتى الزكاةً ومَنْ دعا ال","إله وصام الواجباتِ ومَنْ صَلَّى",70,"ل",2,0],["وَيا خَيرَ أَصحابِي وَصارِمِيَ الَّذي","أَفُلُّ بِهِ هامَ الأَعادِي وَأَضرِبُ",71,"ب",1,0],["ويا خالق الإنسان من فيض نطفة","ومبدعه في ظلمة الرحم الأحم",72,"م",1,0],["ويا خالق الاصباح يا مسبل الدجى","ويا مرشد الأعمى ويا مفهم الأصم",72,"م",1,0],["ويا خافض يا رافع يا محلل","ويا مرغما بالحل أنف المحارم",73,"م",1,0],["ويا خائض النقع المثار إذا طمى","بغر كرام فوق غر كرائم",73,"م",1,0],["ويا خير مبعوث إلى خير أمّة","بآيات صدق نافعات تمائم",73,"م",1,0],["ويا خير مبعوث إلى خير أمة","بآي كتاب صادق القول صادع",74,"ع",1,0],["ويا خميراوات والمشقر","هيهات ما أطول هذا العمرا",75,"ر",2,0],["ويا خجلي اذا قالوا محب","ولم انقذك من خطب دهاك",76,"ك",1,1],["ويا خوفي ويا وجلي","مضى عمري وجا أجلي",77,"ل",2,0],["ويا خليل المعالي وابن بجدتها","دانت إلى مجدك الأعراب والعجم",78,"م",1,0],["ويا خجلة الأحلام من شاعر الهوى","يفضل أصداف الشقاء على الدر",79,"ر",1,0],["ويا خازن النور أين الضياءُ","ويا جبل النار أينَ الحمم",80,"م",1,0],["ويا خافض الكفار خفضاً مقدراً","باشقائهم في سابق الأزلية",81,"ه",1,1],["ويا خافضاً بالبعد من شاء بعده","كما أن في تقريبه كل رفعة",81,"ه",1,0],["ويا خافضاً بالجهل والجهل منبع","لكل بلاء وانحطاط وخسة",81,"ه",1,0],["ويا خافضاً بالفقر من كان فقره","يسفله في دينه بالدنية",81,"ه",1,0],["ويا خافضاً بالذل من كان ذله","لغيرك حباً أو لقهر وخيفة",81,"ه",1,0],["ويا خافض الجبار بالقهر نقمة","وخافض أهل العلم بالطمعية",81,"ه",1,0],["ويا خالق الخلق المقدر كونهم","نظاماً قويماً كل ذات لصورة",82,"ه",1,1],["ويا خالقي نور جناني وقالبي","ويا خالقي أوجد رغائب طلبتي",82,"ي",1,0],["ويأخذ منّي كل ما عزَّ نيلُهُ","ويبدو بجهلي منه في الأَخذِ محتف",83,"ف",1,0],["وَيَا خَيْرَ مَنْ قَادَ الجِيَادَ إِلَى الوغَى","وَأَرْعَدَ فِي جَوِّ الأَعَادِي وَأَبْرَقَا",84,"ق",2,0],["وَيَا خَيْرَ مَرْجُوٍّ وَخَيْرَ مُؤَمَّلٍ","بِأَكْرَمِ أَخْلاَقِ الكِرَامِ تَخَلَّقَا",84,"ق",2,0],["وَيَا خُسْرَ عَاصٍ مَرَّ عَنْكَ مُغَاضِباً","وَيَا فَوْزَ مَطْرُودٍ إِلَى بَابِكَ انْطَوَى",85,"و",2,0],["ويا خلية قلب من هوى وجوى","شغلت بالي بل هيجت بلبالي",86,"ل",2,0],["ويا خير مبعوث إلى خير أمة","بخير كتاب شرعه لا يحاول",87,"ل",1,0],["ويا خير من يرتاده آمل الورى","فمنظره في روضةٍ منه يحبر",88,"ر",1,0],["ويا خدَّه أعطني وردةً","فأَنتَ شقيق لها أكبر",89,"ر",1,0],["ويا خليلاً نأى عن ربعِهِ زمنا","فشادَ عزّاً تمنَّى مِثلهُ الهَرَم",90,"م",1,0],["وَيَا خَافِضُ اخفِضْ قَدْرَ كُلِّ مُنَافِقٍ","وَيَا رَافِعُ ارفَعْنِي بِرَوْحِكَ أَسْأَلاَ",91,"ل",2,0],["ويا خير كل المرسلين كذا الورى","ويا خير مخلوقات مولانا واحد",92,"د",1,0],["ويا خجل الغصون إذا تثنى","ويا ألم القلوب إذا أصابا",93,"ب",2,0],["ويأخذ من الطيور أربع","نظافة الحمام لا تضيع",94,"ع",1,0],["ويأخذ ارض الكسر بعد قصاصه","ويقتص منه حيثما كان مفصل",95,"ل",1,0],["ويأخذ ثلثي أرشه بعد قتله","بقتل ذوي الإسلام ليس يمهل",95,"ل",1,0],["وياخير رب عنده عبده ارب","فنجى واحظاه على الوشك بالار",96,"ر",1,0],["وَيا خاطِري لَجِّج إِلى الدُرِ إِنَّني","أَرى البَحرَ لا يُستَودَعُ الدُرَّ ساحِلُه",97,"ل",2,0],["وَيا خَيرَ مَن نُصَّت إِلَيهِ رَكائِبٌ","وَجينَ إِلى أَن جِينَ حَسرى وَضُلَّعا",98,"ع",2,0],["وَيا خيرَ مَقصودٍ أَناخَ بِبابهِ","رَذايا سِفارٍ دامِياتِ المَناسمِ",99,"م",1,0],["ويا خير من أم المروعات ركنة","فامتها مناً وراع المروعا",100,"ع",2,0],["ويا خير من أمته غرثى سواغباً","فاطعمها عذب النوال فاشبعا",100,"ع",2,0],["ويا خير من جاءته ظمئاً نواهلا","فاصدرها ري القلوب فانقعا",100,"ع",2,0],["ويا خير من يرجو المسيئون عفوه","فاولى به الصفح الجميل وأوسعا",100,"ع",2,0],["ويأخذ الفكرُ الصحيحُ منبها","على منزلٍ لا أمنَ فيمن ثوى به",101,"ه",1,0],["ويا خجلاه من قبح اكتسابي","إذا ما أبدت الصحف العيوبا",102,"ب",2,0],["وَيا خَليلَيَّ املِكا طَرفَيكُما","لا تَنظُرانِ الحَيَّ حينَ غَلَّسا",103,"س",2,0],["ويأخذ باللب حتى يكاد","الفؤادُ بحكم الهوى أن يطيرا",104,"ر",2,0],["ويا خير من حجت اليه من الورى","بنو آمل القت اليه رحالها",105,"ل",3,0],["ويا خير مأوى للنزيل وملتجى","اذا ازمة ابدى الزمان عضالها",105,"ل",3,0],["وَيَأخذُ حالهُ زُوراً فَيَرمي","عِمامَتَه وَيَهربُ في الرِمالِ",106,"ل",1,0],["ويا خيل السباق سقيتِ سمّاً","مُذاباً في المياهِ الجاريات",107,"ت",1,0],["ويا خائفاً ما