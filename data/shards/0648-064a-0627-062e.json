,"وسحت له بالجود كف وبالجدوى",132,"و",2,0],["ويا خير الورى نسبا تسامى","بأفضل من مشى فوق الصعيد",133,"د",1,0],["وَيا خَيرَ مِن أم العَصاةُ جَنابَهُ","فَقابَلَهُم بِالعَفو وَالصفح وَالبشر",134,"ر",1,0],["ويأخذها العجّاج ضمّاً لصدرهِ","يعانقها شوقاً كلقيا الحبيبةِ",135,"ه",1,0],["وَيأخُذك الوسواسُ مِن لوعةِ الهَوى","وَتخرسَ حتّى لا تجيبَ المُناديا",136,"ي",2,0],["ويا خدودَ الوردِ فافتتحي","ويا اصفرار البهار فارتهبي",137,"ب",2,0],["وَيا خَفَقانَ القَلبِ زِدني كَآبَةً","وَيا نارَ أَحشايَ حَنينَ الأَضالِعُ",138,"ع",1,0],["ويأخذنُي ظلُّ النَّخيلِ تَوَدُّداً","فيشربُ من دمعي غديراً فيثمرُ",139,"ر",1,0],["ويا خَجَلَ \"السِّتارَةِ\" قُل لِصَنعا","مَتى بِالعارِ تَطفَحُ أَو تَغُورُ!",140,"ر",1,0],["وَيّْ أخَيّاتي جلُّنا محضُ وهمٍ","إن فينا ضعفاً وعجزاً جليّا",141,"ي",2,0],["ويأخذ الظن بنا مأخذا","لمَّا يكنْ في عرفنا مذهبا",142,"ب",2,0],["ويأخذني رجا أمل","أعيد بإثره الكرة",143,"ر",2,0],["ويأخذني إلى أرض يباب","بها الأحباب قد آلوا يبابا",144,"ب",2,0],["ويأخذ الحصه وحصه من بعدها","وقبل لا يطلع روتينه يحش فينا",145,"ن",2,0],["ويا خير من زفت بنات خواطري","إليه ومن انطوى إليه الفدافدُ",146,"د",1,0],["ويا خالق الأكوان يا باري الورى","لعبدك كون ما يشاء ويهواه",147,"ا",2,0],["ويا خافض اخفض لي جناح معاندي","ويا رافع ارفع جانبي اعل مرقاه",147,"ا",2,0],["وياخالتي كفي من الدمع لنا","ما يحيي الي ضايق اللحد ما قام",148,"م",1,0],["ويا خجلة الشورى وقد أسلمت بهم","إلى رأي ذا المجنون في الحل والعقد",149,"د",1,0],["وياخذني الحنين إليه سعياً","كسعي الجائعين الى الخوانِ",150,"ن",1,0],["ويأخذها أخذاً شديد معاجلا","ويحصدها حصداً ويمحقها محقا",151,"ق",2,0],["ويا خيمةً وسع حلم الحليم","تُعاصي من الكبر شيّالها",152,"ل",3,0],["ويا خلود فلا تتركن من فرج","تمتد منها لذكراهم يد العدم",153,"م",1,0],["ويأخذ منها ما يشاء لما يشا","لوسع مجال الوحي في كل آيتي",154,"ت",2,0],["وياخذني حديثك للبعيد , الأصدق , الأقرب","واحس ان الزمان يعيد نفسه , أو يكررني !",155,"ن",2,1],["ويأخذها الضَّمير إلى \"ضُمَيْرٍ\"","لتضمر لي الأذى طول البقاءِ",156,"ا",2,0],["ويأخذ أمَّه صيناً وهنداً","ومن أقصى الشمالِ إلى الجنوبِ..",157,"ب",1,0],["ويأخذني عابدٌ بيديهِ","إلى الرقص حيث الغنا والجمالُ",158,"ل",1,0],["ويأخذُ في اكتهالِ العمرِ شكلاً","كدالٍ حينَ يقبلُ أو يَحومُ",159,"م",1,0],["ويأخذُه الفكرُ الصحيحُ منبهاً","على منزلٍ لا أمنَ فيمن ثوى به",160,"ب",2,0],["ويأخذني حنيني واشتياقي","لنرجِسِها ورائحةِ البخورِ",161,"ر",1,0]]}