www.poetsgate.com/ViewPoem.aspx?id=64804",""],[4830,"كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=207295",""],[4926,"يا دليل الرَّكب إلى نجدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=171110",""],[5082,"قَبسٌ من ثنيّاتِ الضّياء","https://www.poetsgate.com/ViewPoem.aspx?id=213052",""],[5092,"هذا ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=180064",""],[5136,"يا رسول الله غوثاً إنني","https://www.poetsgate.com/ViewPoem.aspx?id=121598",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5197,"يا عظيم الأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=131027",""],[5212,"مولِدُ التأريخ","https://www.poetsgate.com/ViewPoem.aspx?id=212078",""],[5376,"يا نبيُّ اللهِ يا نورُ السما","https://www.poetsgate.com/ViewPoem.aspx?id=188536",""],[5376,"يا رسولَ اللهِ ما طيرٌ شدا","https://www.poetsgate.com/ViewPoem.aspx?id=193785",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5442,"يا رسول الإله ضاق بأمري","https://www.poetsgate.com/ViewPoem.aspx?id=114750",""],[5518,"يا حبيب الله","https://www.poetsgate.com/ViewPoem.aspx?id=188939",""],[5558,"يا رسولَ اللهِ يا خَيْرَ البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=212413",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[5606,"الثقه متبادله بين الثقات","https://www.poetsgate.com/ViewPoem.aspx?id=196664",""],[5720,"رسول الهدىٰﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200594",""],[5725,"يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=211258",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5848,"لا تسلم لي عليه","https://www.poetsgate.com/ViewPoem.aspx?id=53183",""],[5893,"رسول الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=141494",""],[5957,"خطفوا الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=204706",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[6355,"مناجاة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66603&r=&rc=63",""]],"verses":[["يا رَسولَ اللَهِ لَو عايَنتَهُم","وَهُمُ ما بَينَ قَتلى وَسِبا",0,"ا",1,0],["يا رَسولَ اللَهِ يا فاطِمَةٌ","يا أَميرَ المُؤمِنينَ المُرتَضى",0,"ا",1,0],["يا رسول الحق خلدت الهدى","وتركت الظلم والبغي حطاما",1,"م",2,0],["يا رسول الوحدة الكبرى ويا","ثورة وسدت الظلم الرغاما",1,"م",2,0],["يا رَسولَ الصَّبا فدَيْتُكَ بَلِّغْ","فرْطَ شوْقي إنِ اسْتَطَعْتَ ووَجْدي",2,"د",2,1],["يا رسولي لصبي","مائس مثلَ صبيه",3,"ه",1,1],["يا رَسولي قَبِّلِ الأَر","ضَ إِذا جِئتَ إِلَيهِ",4,"ي",2,1],["يا رَسولَ الحَبيبِ أَهلاً وَسَهلاً","بِكَ يا مُهدِيَ السُرورِ إِلَينا",5,"ن",2,1],["يا رسمُ من أعطَى الهوى","مفتاح قلبي المقفلِ",6,"ل",1,0],["يا رسمُ كم مِن ليلةٍ","أبكي وأستبكيك لي",6,"ل",2,0],["يا رسم كم معنى","حملتَ لناظرِ المتأملِ",6,"ل",1,0],["يا رسولي الذي يُحدّثُ سمعي","بحديثين من شفائي وسقمي",7,"م",2,1],["يا رَسَولَ اللَهِ يَمشي حَولَهُ","مَلَأُ الرُسلِ وَوَفدُ الأَنبِياء",8,"ا",2,0],["يا رسولَ اللّهِ بُشْرَى إنّها","نِعمةٌ تُزجَى وخيرٌ يُوفَدُ",9,"د",1,0],["يا رسولَ اللهِ صبراً إنّها","في ذِمامِ اللَّهِ رَبِّ العالَمِينْ",10,"ن",1,0],["يا رسولَ اللَّهِ هل تأذنُ لي","إنّ بيتي بِمُصابي لَقمينْ",10,"ن",1,0],["يا رسول الصدق ماذا جمعوا","لذوي البأسِ وأهلِ المصدقِ",11,"ق",1,0],["يا رسولَ اللّهِ لا كان امرؤٌ","لم يَكُنْ دِينُكَ من آدابِهِ",11,"ه",1,0],["يا رسولَ اللهِ هذا حمزةٌ","أترى عيناك منه المصرعا",12,"ع",2,0],["يا رسولَ اللهِ هُمْ في شأنهم","غَمرةٌ تَطغَى وبلوى تَتمادى",13,"د",2,0],["يا رسولَ الحبيبِ من حيثُ لم تد","رِ لقد جئْتني بما أتمنَّى",14,"ن",2,0],["يا رسولَ اللَّهِ عُذْرَاً إذَا هِبْ","تُ مَقَامَاً حَقُّه أنْ يُهابا",15,"ب",2,0],["يا رُستم بن خُداهى","يا ظبيةَ الديوانِ",16,"ن",1,1],["يا رسولَ السلامِ في كل حين","فقدتْ مصرُ وحيَه وأمينه",17,"ن",2,0],["يا رسول الأدب العالي","سلام الشعر عنّا",18,"ن",2,0],["يا رسول الرضى بفضلك دارك","عبد رق يلوذ في ظل دارك",19,"ك",1,1],["يا رسول اللَه دارك كرما","يا أجل المرسلين الكرما",20,"م",2,1],["يا رَسولَ الحَبيبِ هَل لِحَبيبي","بَعدَ طولِ النَوى سِواكَ رَسولُ",21,"ل",1,0],["يا رَسولَ الحَبيبِ كَيفَ حَبيبي","أَصَحيحٌ ما يَدّعيهِ العَذولُ",21,"ل",1,0],["يا رَسولَ الحَبيبِ قُل لِحَبيبي","إِنَّني مِثلُه سَجينٌ عَليلُ",21,"ل",1,0],["يا رَسولَ الحَبيبِ يا أَسعَدَ الخَل","قِ تَمَهَّل فَأَنتَ مِنهُ قَليلُ",21,"ل",1,0],["يا رَسولَ الحَبيبِ إِذ يَهبِطُ اللَي","لُ وَتَنحَلُّ في الهِضابِ الكُحولُ",21,"ل",1,0],["يا رَسولَ الحَبيبِ لا لا تخَبِّر","هُ فَيَكفيهِ حُزنُهُ المَوصولُ",21,"ل",1,0],["يا رَسولَ الفِكرِ الجَديد سَلامٌ","كَم هَديتَ العُلى بِفِكرٍ جَديدِ",22,"د",1,0],["يا رسولَ الحبيب باللضه عَرِّض","بحديثي إِن أمكنَ التَّعريضُ",23,"ض",1,0],["يا رَسولَ الإِلَهِ سَلهُ فَتُعطى","لَكَ جاهٌ لَدى عُلاهُ وَحُرمَه",24,"م",2,0],["يا رَسولَ الإلَهِ حاشاكَ أَن تَغ","فَلَ عَن مِصرَ إِذ لَها مِنكَ ذِمَّه",24,"م",2,0],["يا رَسولَ الرِضا إِلَيكَ رَفَعنا","أَمرَ دينٍ فَاِرفَع لِما قَد أَهَمَّه",24,"م",2,0],["يا رَسولَ الإِلَهِ عَوناً عَلى دَه","رٍ رَماني بِرُمحِهِ السَمهَرِيِّ",25,"ي",1,0],["يا رَسول اللَه ياذ الفضل يا","بهجة المحشر جاها وَمقاما",26,"م",2,0],["يا رَسولَ اللَه يا أَكرمَ مَن","أَغدقت سحبُ أَياديه الأناما",27,"م",2,0],["يا رَسولَ اللَه يا مَن لم يَزَل","للوَرى من فَضلِهِ كسبٌ وربحُ",28,"ح",1,0],["يا رسولَ اللهِ شكوى","ذي شجونٍ، وظلامه",29,"م",2,0],["يا رسول اللَه يا أهل الوفا","يا عظيم الخلق يا بحر الصفا",30,"ف",2,1],["يا رسول اللَه يا شمس الهدى","كل ضر بكم قد كشفا",30,"ف",2,0],["يا رسول اللَه يا بحر الندى","كل جودٍ منكم قد عرفا",30,"ف",2,0],["يا رسول اللَه إن الجدب وال","قحط والباساء في الأرض ضفا",30,"ف",2,0],["يا رسول اللَه قد أودى الغلا","بالمساكين العفاة الضعفا",30,"ف",2,0],["يا رسول اللَه غنا ضعفا","ومساكين وقد خفنا القلى",31,"ل",2,0],["يا رسولا منه يستوحى الزمن","كل لحن من أناشيد السلام",32,"م",1,0],["يا رسول السلام والعدل هذي","صيحة من المجنونه",33,"ن",2,0],["يا رَسولُ اللَهِ اِنّي مُذنب","وَمن الجود قبول المُذنب",34,"ب",1,0],["يا رسول اللّه كن عضداً","لغريب الدار مبتعده",35,"د",2,0],["يا رسومَ الديارِ علّ شفاءً","لفؤادٍ لم يبْقَ منهُ رُسوم",36,"م",1,0],["يا رسول اللَه هذي أجملي","عقلت عند حماك المعقل",37,"ل",1,1],["يا رسول اللَه كم كلفتها","لك تطوي مجهلاً في مجهل",37,"ل",1,0],["يا رسول اللَه كم أودعتها","وهي سر قلب ليلٍ أليل",37,"ل",1,0],["يا رسول اللَه كم صيرتها","سفناً تجري ببحر العسقل",37,"ل",1,0],["يا رسول اللَه كم أوردتها","منهلاً مراً لعذب المنهل",37,"ل",1,0],["يا رسول اللَه كم قد واصلت","غدواتٍ وضحى بالأصل",37,"ل",1,0],["يا رسول اللَه كانت لدنة","فغدت مثل الشنان الفحل",37,"ل",1,0],["يا رسول اللَه لما سمعت","فيك مدحي مرحت محرت بي تعتلي",37,"ل",2,0],["يا رسول اللَه لما بركت","بعد أينٍ لك حسبي تجتلي",37,"ل",2,0],["يا رسول اللَه سارت مرحاً","ووأنيخت وهي خوص المقل",37,"ل",1,0],["يا رسول اللَه حبي قائدي","لك والسائق حسن الأمل",37,"ل",1,0],["يا رسول اللَه يا مزمل","حبذا من مصطفى مزمل",37,"ل",1,0],["يا رسول اللَه يا مولى الورى","خير حاف كان أو منتعل",37,"ل",1,0],["يا رسول اللَه لولاك لما","كون الكونين مولانا العلي",37,"ل",2,0],["يا رسول اللَه لولاك لما","محي الشرق ولا الآي تلي",37,"ل",2,0],["يا رسول اللَه لولاك لما","جنة كانت لأواهٍ ولي",37,"ل",2,0],["يا رسول اللَه لولاك لما","أمهل العاصي وبالنار صلي",37,"ل",2,0],["يا رسول اللَه لولاك فما","من نبيٍّ ورسول مرسل",37,"ل",1,0],["يا رسول اللَه لولاك على ال","أنبياء الكتب لما تنزل",37,"ل",1,0],["يا رسول اللَه أنت الآخر ال","أول أكرم بالأخير الأول",37,"ل",1,0],["يا رسول اللَه يا من فضله","سابق وهو ختام الرسل",37,"ل",1,0],["يا رسول اللَه يا من كفه","سبحت فيه صلاد الجندل",37,"ل",1,0],["يا رسول اللَه يا من قد جرى","بيديه الماء جري الجددول",37,"ل",1,0],["يا رسول اللَه يا من جاءه","ناطقاً في الحال فحل الإبل",37,"ل",1,0],["يا رسول اللَه يا من يده","عمت السهل و