[4830,"حيثما شاءَ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214573",""],[1901,"رَبٍّ إني طغى عليَّ مَشيبي","https://www.poetsgate.com/ViewPoem.aspx?id=160419",""],[5041,"إنَّما العارُ أنْ يَهونَ السِّلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=24394",""],[5174,"لغة الضاد - عبدالله بن علي الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=186429",""],[5183,"قلت","https://www.poetsgate.com/ViewPoem.aspx?id=186482",""],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5198,"نسّاي","https://www.poetsgate.com/ViewPoem.aspx?id=136100",""],[5376,"لستُ عنه من أنسِه ببعيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=191853",""],[5461,"أجاذبك الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=30030",""],[5691,"جلد النمر","https://www.poetsgate.com/ViewPoem.aspx?id=206665",""],[5696,"بين الرياء والحياء","https://www.poetsgate.com/ViewPoem.aspx?id=151407",""],[5790,"بأبي وبي طيفٌ طرق","https://www.poetsgate.com/ViewPoem.aspx?id=111872",""],[5897,"بشائر على أبواب المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=157555",""],[6093,"كالحق ينزل في ضيافة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=205866",""],[6130,"شرفةُ حلمٍ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199248",""],[6167,"الربان الجسور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85570&r=&rc=53",""],[5190,"الببغاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78301&r=&rc=14",""]],"verses":[["وأشأمَ منْ جيرانِنا إذْ تَزَيّلوا","فَريقٌ وأعْرَقْنا ونحنُ فَريقُ",0,"ق",1,0],["وَأَشاحَت بِوَجهِها","وَاِدَّعَت أَنَّني رَدي",1,"د",2,0],["وَأَشارَ عَن بَعضِ الحَدي","ثِ وَحَبَّذا تِلكَ الإِشارَه",2,"ر",2,0],["وَأَشارَ أَن يَلِيَ السَفينَةَ قائِدٌ","مِنهُم يَكونُ مِنَ النُهى بِمَكانِ",3,"ن",1,0],["واش اتيحَ له يرى تفريقَه","بين الأحبةِ من زيادة فضلهِ",4,"ل",2,0],["وَأَشارَت بِما أَبَيتَ رِجالٌ","كُنتَ أَهدى مِنها إِلى الإِرشادِ",5,"د",1,0],["وأشاروا بأنْ تعودَ وسَادِي","فأبَتْ وهيَ تشتَهِي أنْ تعودَا",6,"د",2,0],["وَأَشارَت إِلى الغِناءِ بِأَلحا","ظٍ مِراضٍ مِنَ التَصابي صِحاحِ",7,"ح",1,0],["وأشارتْ بالرّضى رُبّ رضىً","عنك يبدو في شهادات الرسولِ",8,"ل",1,0],["وإشارة باللحظ يخدم أمْرَهَا","زمنٌ له سلم به وكفاحُ",9,"ح",1,0],["وَأَشارَت إِلى نِساءٍ لَدَيها","لا تَرى دونَهُنَّ لِلسِرِّ سِترا",10,"ر",2,0],["وأشار نحو أثالة بجفونه","سترى المروءة أننا كفؤان",11,"ن",1,0],["وأشاع في عرش المعز فتوَّةً","حتى دجا ما أبيض من شعراته",12,"ت",2,0],["وأشار مصباح فانكر وجه","ويديه في ايمائه الخطاف",13,"ف",1,0],["وأشاعَ شجواً في الضفاف ورقَّةً","إيقاظُ نُوتيًّ بها لزميله",14,"ل",2,0],["وأشارت إلى اللعوبَيْن بالألباب","منا بوردةٍ مُزدانه",15,"ن",2,0],["وأشارات دولة السر وال","بأس الإلهي بصولة الإظهار",16,"ر",1,0],["وأشارة الرحموت في الملكوت وال","ملك العظيم ونقطة الأبداء",17,"ا",2,0],["وَأَشارَ النبيُّ للسحبِ كفّي","حَيِيَت أَرضُنا فماذا البكاءُ",18,"ا",2,0],["واشاهد الحرم الشريف وبقعة","ضمت لاكرم شافع ومشفع",19,"ع",1,0],["وأشار لي بعد التحي","ة بالتحدث والجلوس",20,"س",1,0],["وَأُشاوِرُ شَوقي بل أدبي","هل أَقصِرُ أَم أَتَصَيَّده",21,"د",2,0],["وأشار مبتسِماً إليّ بوجهه","فحسبتُه وجهَ الصباح الأبْلجِ",22,"ج",1,0],["وَأَشاحَ مُمتَطِياً إِلَيها عَزمَةً","عَنها تُقَصِّرُ عَزمَةُ الإِسكَندَرِ",23,"ر",1,0],["وَأَشارَ البَشيرُ أَن أَرخوهُ","صَموئيلُ لَبّى لِخَيرِ مُرادي",24,"د",2,0],["واشار للأخرى وقال وهذه","تدعى كذلك ربة الشكران",25,"ن",1,0],["وأشارت نحو جمرٍ لاعبٍ","باللَّظى في الموقدِ الجمّ الذَكاء",26,"ا",2,0],["وأُشارك النُّوَّاحَ فيك بأنّني","أرثيك فالتأبين نَوحُ الشاعرِ",27,"ر",1,0],["وأشاعوا أني جننت بليلى","ونعمْ عاشقٌ بليلاه جنَّا",28,"ن",2,0],["وإشاراتٍ بسِيناءِ الهُدى","كشفَتْ بالنُّورِ عنَّا الظُّلَمَا",29,"م",2,0],["وَأَشابوا ذُؤابَتي ببُجَيرٍ","قَتَلوهُ ظُلماً بِغَيرِ قِتالِ",30,"ل",1,0],["وأشارت إلى الطواف بوجه","يفضح البدر بالسنا والتلالي",31,"ل",2,0],["وأشاعوه في اعتقاد رجال","ربهم عندهم لبالمرصاد",32,"د",1,0],["وأشاط بسطام بن قيسٍ عاصمٌ","وثوى بأسر أبي عُميلة معبد",33,"د",1,0],["وَإِشارات بِمَدحِ","لِمعاليه الفَريدهْ",34,"ه",1,0],["وأشاهد الأبراج وهي منيفة","وتدافع الأمواج ملتمسات",35,"ت",1,0],["وأشارَ لي أرِّخْ عِذاري طالعاً","فَأَجبتُه أرّختُه أرّختُهُ",36,"ه",1,0],["وَإِشاراتِها إِلى مَن رَآها","بِخُضوعِ وَذِلَّةٍ وَاِنكِسارِ",37,"ر",1,0],["وأشار في تاريخ تعمير لجا","معها الرفيع به الثنا يزداد",38,"د",1,0],["وا شارِيَ البَرْقِ مِنْ عَلْيَاءِ وَادِينا","رِفْقًا بِناءٍ غَدَا في الطُّورِ مِنْ سينَا",39,"ن",2,1],["وا شارِيَ البَرْقِ لَمْعُ البَرْقُ يُحْيينا","أسعدتَ آنَسْتَ رَغْمَ الحُزْنِ تُشْجِينا",39,"ن",2,0],["وا شاريَ البَرْقِ أهلُ الشَّرقِ هل عَلِموا","أنَّ المَدامِعَ تَجْرِي مِنْ قَوافِينا",39,"ن",2,0],["وأشاهد القبر الذي في طيه","نشرت حلى أزكى سميع أو كليم",40,"م",1,0],["وأشار يوم الفتح للأصنام أن","زولي فزالت للقصاء المنزل",41,"ل",1,0],["وأشاح بعضُهمُ يتم","تم قابعاً في زاويةْ",42,"ي",2,0],["وأشاد قيسارية تأريخها","حاط الأمان بها فبيعوا واشتروا",43,"ر",3,0],["وَأشادَ المجدَ طِفلاً","فلهُ أَضحَى غُلاما",44,"م",2,0],["وأشار للبدر المنير فشقّ في","كبد السماء وعاد كالعرجون",45,"ن",1,0],["واشابهُ خوفاً لذاكَ نجومهُ","هجرتهُ طالبةً سواهُ خليلا",46,"ل",2,0],["وَأَشاروا سيدي إن لنا","إن علينا إِنَّنا إِن بنا",47,"ن",2,0],["وأشارت جفونه قائلات","صار يا صاحِ شاكراً مشكورا",48,"ر",2,0],["وإشارةٍ لك في المكارم زاحمتْ","ضَيْقَ الهمومِ بِفُرْجَةِ الإيناس",49,"س",1,0],["وَأَشاحَ عِبئاً عَلَيهِم ثَقيلاً","وَهُمُ المُثقِلونَ مِن أَعبائِه",50,"ا",3,0],["وأشادت عمادها في المعالي","وأماطت في المرتبات أذاها",51,"ا",3,0],["وأشار للأُخرى إلى الأرضِ اهبطي","كي تُظهِرِينَ مَحاسِنَ الإنسانِ",52,"ن",1,0],["وَأُشاهِدُ النُّورَ الَّذِى فِى طَيبَةٍ","وَلِوجهِهِ الضَّاوى أَشُومُ وأعشَقُ",53,"ق",1,0],["وأشاح وهو يكاد يجمح عاتبا","وأكاد أفنى في لذيذ عتابه",54,"ب",2,0],["واشاوساً عزت فلم","تك تستكين لأي نير",55,"ر",1,0],["وأشاعت ضياءها فهو يهدي","من أراد الحياة رزقا حلالا",56,"ل",2,0],["وأشابَ فوْدَيَّ الصدودُ وقبله","قد كدتُ في ماء الشبيبة أشرق",57,"ق",1,0],["وأشارت لجدها والرزايا","أسدلت دون نطقها إسدالا",58,"ل",2,0],["وأشاهدك من بعد كل طاسه","حتى أرى حبل النصاف بلحم",59,"م",1,0],["وأشار للسحب الثقال فامطرت","وجرت ينابيع المياه بحكمة",60,"ه",1,0],["وأشار للأصنام قال تنكسي","فتنكست وتكسرت في لحظة",61,"ه",1,0],