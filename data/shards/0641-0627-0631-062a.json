s://www.poetsgate.com/ViewPoem.aspx?id=188523",""],[5939,"قهوة عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=195307",""],[5956,"تركيبة معظم حكامنا","https://www.poetsgate.com/ViewPoem.aspx?id=192217",""],[5956,"مجاهد في سبيل الله","https://www.poetsgate.com/ViewPoem.aspx?id=192254",""],[5980,"جئت والوقوف بالمكارم أظلم","https://www.poetsgate.com/ViewPoem.aspx?id=146262",""],[6031,"يا مَنْ نَأَى فجَعَلتُ بعدَ فِرَاقِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46326",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[4442,"لك من أبيك تحية وسلام","https://www.poetsgate.com/ViewPoem.aspx?id=171200",""],[6102,"مراهقة ..","https://www.poetsgate.com/ViewPoem.aspx?id=185048",""],[6124,"علمتني كيف أجفو","https://www.poetsgate.com/ViewPoem.aspx?id=125190",""],[6124,"حيثما وليت وجها","https://www.poetsgate.com/ViewPoem.aspx?id=174990",""],[6142,"لم يكن همه بدنياه إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155695",""],[6142,"لا تسل ما جرى بميلاده الأز","https://www.poetsgate.com/ViewPoem.aspx?id=155704",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[6257,"الأسامي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87194&r=&rc=19",""],[5190,"غيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78340&r=&rc=53",""],[6344,"تَجاعيدُ المَرايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87963&r=&rc=3",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["فَاِرتَشَفنا ريقَ سارِيَةٍ","حَيثُ كُلَّ الأَرضِ غُدرانُ",0,"ن",1,0],["فاِرْتَدْ لَنا مَنزِلاً يا سَعدُ نَثْوِ بِهِ","فَلَيسَ لي بِالحمى مِن صاحِبٍ وَأَخٍ",1,"خ",1,0],["فارتعش يا وتر الشعر وذب","في كؤوس العبقريات مداما",2,"م",2,0],["فَارتَقِبْ يَا مُمَحَّدُ الحَمْدَ نَصْراً","بَعْدَهَا ظَاهِراً وَفَتْحاً مُبِينَا",3,"ن",2,0],["فَارْتَاحَ دِينُ اللهِ فِي رَيْعَانِهِ","وَاُعِيدَ مُقْتَبَلَ الشَّبِيبَةِ جِيلُهُ",4,"ل",2,0],["فَارْتَاحَ دَوْحُ المُلْكِ عَنْ فَزْعِ الْعُلَى","وَازْدَادَ فِي أُفُقِ الجَلاَلِ شِهَابُ",5,"ب",1,0],["فارتاع ناقوس لخلع لسانه","وبكى الصليب لذلة الكفار",6,"ر",1,0],["فارتاعت الأنجم مذ غيّما","واحتجبت فيه عن الأعين",7,"ن",1,0],["فأرتنا من الجبين صباحاً","ومن الخدّ كوكباً مشبوبا",8,"ب",2,0],["فَاِرتَثَّ كَلماهُم عَشِيَّةَ هَزمِهِم","حَيٌّ بِمُنعَرَجِ المَسيلِ مُقيمُ",9,"م",1,0],["فارتوتِ الماء من جوانبها","فزانها ربّنا ونضّرها",10,"ر",3,0],["فارتدت عيباً يكون واقية","فلم أجده أليةً حلفا",11,"ف",2,0],["فارتقتَهُ ولزمتُهُ","فأنا الشقيق الصادقُ",12,"ق",1,0],["فارتَهنْ خِدمتي بإجراءِ جارٍ","أرتضيهِ كفايةً واتصالا",13,"ل",2,0],["فَاِرتَدَّ يَعثُرُ بِالدُمو","عِ تَعَثُّرَ الشَيخِ الضريرِ",14,"ر",1,0],["فَاِرتَخى مَفصِلُها مِن","هَيبَةِ الطَودِ المُعَظَّم",15,"م",1,0],["فَأَرَتني الهَوى وَقالَت خَشينا","وَالهَوى شُعبَةٌ مِنَ الإِشفاقِ",16,"ق",1,0],["فَاِرتَبِطها فَإِنَّ قَلباً نَماها","مَربَطٌ تَسبِقُ الجِيادَ جِيادُه",17,"د",2,0],["فارتاع منهم أهلها فتحصنوا","منهم بهنّ وأحكم الإغلاق",18,"ق",1,0],["فَاِرتَحِل عَن جِوارِ كِسرى فَما أَن","تَ كَريمٌ وَلا لِبَيتِكَ أُسُّ",19,"س",1,0],["فَاِرتَكِب أَجمَلَ الذُنوبِ لِنَفعٍ","وَاِعتَقِد في اِرتِكابِهِ التَحريما",20,"م",2,0],["فَاِرتَضَينا بِذا الرِهانِ وَصَيَّر","تُ إِلَيهِ الخِيارَ في الحِليَتَينِ",21,"ن",1,0],["فَاِرتَدَّ مِنّي اِرتِدادَ ال","أَسيرِ عايَنَ قَدّا",22,"د",2,0],["فَأَرَتهُ وارِدَ النَب","تِ وَمُنتَصّاً تَليعا",23,"ع",2,0],["فَأَرَتني مُسفِراً حَسَناً","خِلتُهُ إِذ أَسفَرَت قَمَرا",24,"ر",2,0],["فارتَنَّوَرُهُ وَجاشَ بِماءٍ","طَمَّ فَوقَ الجِبالِ حَتّى عَلاها",25,"ا",1,0],["فَأَرَتني ثُمَّ شَطَّت شَطَّةً","تَرَكَت قَلبي إِلَيها يَضطَرِب",26,"ب",1,0],["فَاِرتاعَ مِن صَوتِ كَلّابٍ فَباتَ لَهُ","طَوعَ الشَوامِتِ مِن خَوفٍ وَمِن صَرَدِ",27,"د",1,0],["فَاِرتاعَ يَوماً وَيَوماً ثُمَّ ثالِثَةً","وَمالَ بَعدُ إِلى أُخرى يُواخيها",28,"ي",3,0],["فارْتَحَلَ النّضْرُ لرَبْعٍ سِوَى","رَبْعي فِراراً مِن أبيه شُمَيْل",29,"ل",1,0],["فارْتَدَّ بَهْجةَ مُلْكِهِمْ","كَرُّ الخُبَعْثِنةِ الضُّبَارِمُ",30,"م",1,0],["فَأَرَتَنَا السَّفِينَ تنْقَادُ جَوّاً","وَأَرَتْناَ السَّفِينَ تَرتَادُ بَحْرَا",31,"ر",2,0],["فأرتنا إذ غابتِ الشمسُ شمسً","كيف أنسى",32,"ا",1,0],["فارتَدّ يلمُسُ جنبيهِ أأنصلُها","أهوَت عليهِ أم انقضّت ضواريها",33,"ي",3,0],["فارْتَمى بين جَناحٍ هائضٍ","وَجناحٍ خافقٍ مضطرب",34,"ب",1,0],["فَارْتَحِل بَارِدَ الْفُؤَادِ قَريراً","مُرْوِياً مِنْ دَمِ الْعِبَادِ الْغَلِيلاَ",35,"ل",2,0],["فارتاح دين الله في ريعانه","وأعيد مقتبل الشبيبة خيله",36,"ل",2,0],["فارتاح دوْحُ المُلْك عنْ فرْع العُلا","وازداد في أفُق الجلال شهابُ",37,"ب",1,0],["فارتعشنا ، وانجلت دهشتنا","ثم أومأنا اليها ، بالسّبح",38,"ح",1,0],["فارتمى في اللّظى الأفيال","حمر الرؤوس جرحى القوائم",39,"م",1,0],["فارتعش يا وتر الشعر وذب","في كئوس العبقريّات مداما",40,"م",2,0],["فارتقى ((هاشم)) و((مروان)) ولى","وهي ملغية الحساب هجيره",41,"ر",2,0],["فأرتقب ذريَّةٌ ميمونةً","قبل أن تستلطف العرس الحدادي",42,"د",2,0],["فأرتْ عينيَ منه الصَّادَ شِينا","وجنوبٌ وشمالٌ جعلا",43,"ل",2,0],["فأرتنا من الجين صباحا","فعجيبا من رقصها فعجيبا",44,"ب",2,0],["فارتعي في القلب يا ربتّه","واسكنيه إنه المأوى الأمين",45,"ن",1,0],["فَأرَتني لاَلئاً ونُضَاراً","في لالٍ أنِيقةٍ ونُضَارِ",46,"ر",1,0],["فارتعدوا لصوتِه عند الثنا","رعدتهم للرعد عند المطرِ",47,"ر",1,0],["فَارتَاحُ أَحياناً وَحِيناً كأَنَّمَا","عَلَى كَبِدِى ماضِى الشَّباةِ ذَرِيبُ",48,"ب",1,0],["فارتاع ثم تأبّى أن يساعدني","هيهات يسعدني في الليل رعديد",49,"د",1,0],["فارتدت ثوبَ أخيها وهو نائم","وأتت تحرسُها والجوّ غائم",50,"م",1,0],["فارتاع مما قد رآه ماثلا","ملك تجنح نوره وقاد",51,"د",1,0],["فارتد لا يثنى على آثاره","طرفاًولا تلوي امونا عرمسا",52,"س",2,0],["فارتد نافذ كل سهم طائشا","عنهم وسهمهم اصاب وفرطسا",52,"س",2,0],["فارتدت أثوابها وبَدَت","دُمي