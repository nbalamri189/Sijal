{"poems":[[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[55,"من كل سارية كأن رشاشها","https://www.aldiwan.net/poem30496.html","الكامل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[29,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[74,"إنسان عيني ساهر بك سافح","https://www.aldiwan.net/poem18483.html","الكامل"],[74,"ربع لعزة صامت لا يفهم","https://www.aldiwan.net/poem19680.html","الكامل"],[53,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[47,"إن الظباء غداة سفح محجر","https://www.aldiwan.net/poem63628.html","البسيط"],[30,"خليفة الله منهم في رعيته","https://www.aldiwan.net/poem5100.html","البسيط"],[30,"نام الخلي وما أغمض ساعة","https://www.aldiwan.net/poem5624.html","الكامل"],[63,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[68,"وليلة في طول يوم العرض","https://www.aldiwan.net/poem40689.html","الرجز"],[46,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[107,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[78,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[108,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[119,"البرق حاجر ام لبرق الشام","https://www.aldiwan.net/poem40593.html","عموديه"],[159,"لمن الرسوم برامتين بلينا","https://www.aldiwan.net/poem55540.html","الكامل"],[186,"جاد الحيا كل روض في طرابلس","https://www.aldiwan.net/poem67053.html","البسيط"],[214,"لعبت بقلبي والحشا اهواه","https://www.aldiwan.net/poem13386.html","الكامل"],[240,"لو أنصفت ذات النصيف","https://www.aldiwan.net/poem31817.html","مجزوء الكامل"],[240,"دار الهوى بين اللوى وشراف","https://www.aldiwan.net/poem31818.html","الكامل"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[369,"صدر الرعاء وما سقيت ظمائي","https://www.aldiwan.net/poem61016.html","الكامل"],[416,"هاجت هواك بواكر الأظعان","https://www.aldiwan.net/poem67466.html","الكامل"],[438,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[438,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[445,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[458,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[463,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[469,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[469,"أهدى الضنا تذكارها","https://www.aldiwan.net/poem3495.html","عموديه"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[556,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[556,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[558,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138404",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122334","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59802","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35372","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65010","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64970","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137849",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49968","الكامل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20566","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11987","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108639","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49607","البسيط"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69470","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53168","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77360","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121391","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99318","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103590","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206170","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216604","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36801","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36715","المنسرح"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[3885,"","https://poetry.dctabudhabi.ae/diwan/poem/200372","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93262","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90803","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90816","الكامل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123957","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81266","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73125","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28725","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204205","البسيط"],[4679,"من لي بإحصاء لآلي البحار","https://www.poetsgate.com/ViewPoem.aspx?id=142758",""],[463,"طرقتْ على خطر السرى المركوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=25003",""],[4119,"كم بالكنائس من مبتلة","https://www.poetsgate.com/ViewPoem.aspx?id=16146",""],[5213,"بلغت بك الروحاء في ذملانها","https://www.poetsgate.com/ViewPoem.aspx?id=170567",""],[5482,"يَا دَار وَادي الشط من أَعلَى الْقرى","https://www.poetsgate.com/ViewPoem.aspx?id=189032",""],[5581,"أنذار","https://www.poetsgate.com/ViewPoem.aspx?id=22501",""],[6106,"واحتنا الغراء","https://www.poetsgate.com/ViewPoem.aspx?id=6311",""]],"verses":[["مِن كُلِّ سَوّارٍ إِذا رامَ العُلى","حازَ عُقابَ الجَوِّ أَو مَلاعَها",0,"ع",3,0],["مِن كُلِّ سارِيَةٍ كَأَنَّ رَشاشَها","إِبرٌ تُخَيِّطُ لِلرِياضِ بُرودا",1,"د",2,1],["مِن كُلِّ سابِحَةٍ وَأَجرَدَ سابِحٍ","تَردي بِأُسدِ خَفِيَّةٍ وَصِعادِ",2,"د",1,0],["مِن كُلِّ ساجي الطَرفِ أَعصَلَ نابُهُ","في كُلِّ قائِمَةٍ لَهُ ظِلفانِ",3,"ن",1,0],["مِن كُلِّ سارِيَةٍ وَغادٍ مُدجِنٍ","وَعَشيَّةٍ مُتَجاوِبٍ إِرزامُها",4,"م",3,0],["من كلِّ ساجعة السطور كأنما","همزاتها وُرْقٌ هناك صوادح",5,"ح",1,0],["من كلّ ساجعة السطور كأنما","همزاتها وُرْقٌ بها تترنم",6,"م",1,0],["من كل سائرةٍ بذمِّك يَرْتمي","بِركابها الأغْوار والأنجادُ",7,"د",1,0],["مِن كُلِّ ساجي الطَرفِ أَغيَدَ أَجيَدٍ","وَمُهَفهَفِ الكَشحَينِ أَحوى أَحوَرِ",8,"ر",1,0],["مِن كُلِّ سَلهَبَةٍ تَدمى دَوابِرُها","مِنَ الوَجا وَفُحولٍ تَنفُضُ العُذَرا",9,"ر",2,0],["مِن كُلِّ سابِحَةٍ وَأَجرَدَ سابِحٍ","كَالسيدِ يَومَ تَغَيُّمٍ وَدُخانِ",10,"ن",1,0],["من كلِّ سكرَى اللَّحظِ أثمرَ غصنُها","نوعين من وردٍ ومن عُنَّابِ",11,"ب",1,0],["مِن كُلِّ سِربٍ شارِدٍ مُنغَضِّ","بِأَرقَطِ الظَهرِ صَقيلٍ بَضِّ",12,"ض",1,0],["مِن كُلِّ سابِغَةِ الشَبابِ إِذا بَدَت","تَرَكَت عَميدَ القَريَتَينِ عَميدا",13,"د",2,0],["مِن كلّ سَمْحٍ في الغِمارِ بنفسهِ","جَمِّ الضَّنانةِ بالذّمارِ بَخيلِ",14,"ل",1,0],["من كلِّ سامي الأَخْدعَينِ كأنَّما","نِيطتْ شكائمُهُ بجذعِ الساجِ",15,"ج",1,0],["مِن كلّ سابِغَةِ الذّيولِ كأنّها","نِهْيٌ تُصَفِّقُهُ الرّياحُ بِقاعِها",16,"ع",3,0],["من كل سيفٍ سلّه المختار","ماضٍ فرنده الصّبا بتّار",17,"ر",1,0],["مِن كُلِّ سلْهَبةٍ تَطِيرُ بأَرْبعٍ","يُنْسِيك مُؤْخَرُهَا الْتِماح لَبانِهَا",18,"ن",3,0],["من كل ساحرة العينين، ضامرةٍ","الخَصْرُ في ظَمَإٍ، والرِّدفُ ربَّان",19,"ن",1,0],["من كل سيف فاطمي ابيض","رحب المقلد ثابت الاقدام",20,"م",1,0],["مِنْ كُلِّ سَافِرَةِ الطِّرازِ كأنَّها","تَصِفُ المَكارِمَ كَيْفَ شِئْتَ وَشِينا",21,"ن",2,0],["مِن كُلِّ ساهرِ لِيلٍ جُلّ بُغيتِهِ","في كُنَّسِ النَجمِ لا الآرامَ في الكنسِ",22,"س",1,0],["من كل سافرة اللثام كأنها","بدر الدجا ونطاقها الجوزاء",23,"ا",2,0],["مِن كُلِّ سَكرى القَدِّ ما","لَ بِها الصَبى مَيلَ النَزيفِ",24,"ف",1,0],["مِن كُلِّ سَبّاقٍ إِلى الغاياتِ كَرّارٍ","عَلى أَقرانِها عَطّافِ",25,"ف",1,0],["مِن كُلِّ ساقٍ عِندَ كُلِّ ساقِيَه","يَجعَلُ مِن صافٍ مِزاجَ صافِيَه",26,"ه",1,0],["من كُلِّ سَهْمٍ وشَهْمٍ طائرٍ بهما","من مُستعارٍ ومَمْلوكٍ جناحان",27,"ن",1,0],["من كُلِّ سائرةٍ بأفواه الورى","تَحدو مطايا الرّكبِ أَيَّ حُداء",28,"ا",2,0],["مِن كُلِّ سَلهَبَةٍ يَبينُ بِنَحرِها","وَقعُ القَنا وَأَقَبَّ كَالسَرحانِ",29,"ن",1,0],["من كل سَوْدَاءَ مِثْلِ الخالِ يَحْمِلُها","بِوَجْنَةٍ منه فيها للضُّحى خَفَرُ",30,"ر",1,0],["من كلِّ سافكةٍ بسيفِ فُتورِها","عمداً وما لِقَتيلها من ثارِ",31,"ر",1,0],["من كُلِّ سامي الطَّرْفِ يَحْدُو وُلَّهاً","قَدْ غادَرَتْ أُمَّ الضلالِ عقيما",32,"م",2,0],["من كل ساحِرةٍ كَأَنَّ روِيَّها","فِي أَلسُنِ الرَّاوينَ رِيقةُ كاعبِ",33,"ب",1,0],["من كل سيف قد تثلم مجده","في الموبقات ويستعز بفعلها",34,"ل",3,0],["من كلّ سيّارٍ بكم","ركّاضُهُ أو معنِقُهْ",35,"ق",2,0],["من كلِّ ساريةٍ بذكرك صيتُها","في الأرض بين فدافدٍ وسُهوبِ",36,"ب",1,0],["من كلِّ ساريةٍ مرتها كفّهُ","مشكورةٍ بلسانِ كلِّ صعيد",37,"د",1,0],["من كلِّ ساريةٍ صفتْ","جمّاتها وغمارها",38,"ر",3,0],["من كل ساجي المقلتين لم يزل","أشفاره إذا رنا شفاره",39,"ر",2,0],["من كلّ سيّارٍ إلى الذّكرِ وإنْ","شتّتَ ذاك الذّكرُ شملاً أو قُبَلْ",40,"ل",1,0],["من كلّ سوداءِ الأديمِ كأنّها","شَغْواءُ تنجو في الرّياحِ الأربعِ",41,"ع",1,0],["مِن كُلِّ سامِيَةِ القَذالِ طِمِرَّةٍ","عَجلٍ تَرَوُّحُها وَإِن لَم تُطرَدِ",42,"د",1,0],["من كل سن رأيت القوم محتشدا","فمن كهول ومن شيب وفتيان",43,"ن",1,0],["من كل سطر للضغينة قاطع","فكأنه منشار عمر عداته",44,"ت",2,0],["من كل سائرة الآفاق شاردة","تخبُّ لا كسلاً تشكو ولا ثبطا",45,"ط",2,0],["مِن كُلِّ سامِيَةِ العِمادِ فَتاجُها","بِسَنا النُجومِ مُكَلَّلٌ وَمُرَصَّعُ",46,"ع",1,1],["مِنْ كلِّ سَيَّارةٍ مُنَقَّحَةٍ","مُشْتَقَةِ اللَّفْظِ مِنْ مَعانيهِ",47,"ي",2,0],["مِنْ كلِّ ساجِيَةِ اللِّحاظِ رَشيقَةٍ","تُضْنيكَ في حَرَكاتِها وسُكونِها",48,"ن",3,0],["من كل سكرى من سلافة قنوها","اضحت تهز مع الحسان قدودا",49,"د",2,0],["من كلّ سامٍ ذي قَسامٍ","وابتسام غير باسِرْ",50,"ر",1,0],["مِن كُلِّ سَلهَبَةٍ وَأَجرَدَ سَلهَبٍ","كَالسيدِ بادَر غَفلَةَ الرُقابِ",51,"ب",1,0],["مِن كُلِّ سَحّاحِ اليَدَينِ سَمَيذَعٍ","وَأَغَرَّ وَضّاحِ الجَبينِ شَمَردَلِ",52,"ل",1,0],["من كل سابحةٍ كأن جبينها","من فضةٍ وأديهما من نار",53,"ر",1,0],["من كلِّ ساع أمامَ الريح يَقْدُمُها","منهُ مهاةٌ وإن شاءتْ فسرحان",54,"ن",1,0],["من كل سفر حجة بفنونه","ما فيه فن قد يراك دخيلا",55,"ل",2,0],["مِن كُلِّ سَمحِ الخُطا أَو كُلِّ يَعمَلَةٍ","خُرطومُها باللُغامِ الجَعدِ مُلتَقَعُ",56,"ع",1,0],["من كل سهم رَكِبَتْ","سودُ الجفون نَصْلَه",57,"ل",2,0],["مِن كُلِّ ساهِرَةِ الجُفونِ كَأَنَّما","تُزري بِحَقِّ المَجدِ إِن لَم تَسهَرِ",58,"ر",1,0],["من كل سام بعينيه يؤمّلني","تأميلَ ضرَّارِ أعداء ونفّاع",59,"ع",1,0],["من كل سافرة عن مشرق خجلا","فيه طرازان من ماء ومن لهب",60,"ب",1,0],["من كل سابحة طارت بفارسها","كأنها لقوة في عطفها أسد",61,"د",1,0],["من كل ساهٍ ليس يذكر أمسَه إ","لا ليذكر أسوأ الأوزار",62,"ر",1,0],["من كل سار في الظلام كأنهُ","بعض الظلام تضله العينان",63,"ن",1,0],["مِن كُلِّ ساحِرَةِ اللِّحاظِ إِذا رَنَت","سَلَّت عَلَيكَ مِنَ الجُفون قَواضِبا",64,"ب",2,0],["مِن كُلِّ سَيّارَةٍ غَدَت مَثلا","حَدّثَ عَنها المُهَذَّبُ البارِع",65,"ع",1,0],["من كلَّ سلهبةٍ وأسوق سلَهب","أو كلَّ ذِعلبة وذعلبَ أعوج",66,"ج",1,0],["من كل سارية وغادٍ مدجن","حنق البوارق 