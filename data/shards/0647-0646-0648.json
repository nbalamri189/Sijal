{"poems":[[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56094","البسيط"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205474","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108797","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67192","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83207","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70146","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136379",""],[4829,"الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=34267",""],[4968,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=208077",""],[5061,"صدفه عابره","https://www.poetsgate.com/ViewPoem.aspx?id=158858",""]],"verses":[["هنوا با القاسم المفضال فيه بوفي","عرس به السعد لا ينفك محتفلا",0,"ل",2,0],["هن وكلن بي الهناء وبؤسا","ففؤادي مروع مسرور",1,"ر",1,0],["هنوا البلاد وأرخوا","فضياء سوريا وصل",2,"ل",1,0],["هنوَ ماجدٌ تَسمو السماءُ بمجدِه","والله يعلمُ والملائكُ تَشهد",3,"د",1,0],["هَنُؤتَ بِما قد نِلتَ عِزَّاً وصِحَّةً","وَلا زالَتِ الأَفنانُ في الساقِ تَخضَرُّ",4,"ر",1,0],["هنوا بِهِ بَرّ الشآم وَبَشروا","بُشرى السلام بِما يُسرُّ وَيُحمَدُ",5,"د",1,0],["هنو الآية الكبرى لدى كل عارف","هو النعمة العظمى لدى كل من بدري",6,"ر",2,0],["هنوفتن لاخاير ولا بايرن","لطوفتن لب الحسن به جمدن",7,"ن",1,0],["هنودٌ وتركٌ وفرسٌ تآخوا","بنور الهدايةِ لاَ بالحُسَام",8,"م",1,0],["هنوفً حبها شقّر وسط قَلبي ولف ودار","وبيبان الخروج مقفله من كل وجهاته",9,"ت",2,0]]}