{"poems":[[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[72,"نزحت لبين النازحين مدامعي","https://www.aldiwan.net/poem18385.html","الطويل"],[45,"رددت بعيسى الروم من حيث أقبلت","https://www.aldiwan.net/poem62750.html","الطويل"],[45,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[49,"أيا عجب الدنيا لعين تعجبت","https://www.aldiwan.net/poem10847.html","الطويل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[233,"ما سمحت والله يا سادتي","https://www.aldiwan.net/poem31919.html","السريع"],[280,"بريق بالأبيرق لاح وهنا","https://www.aldiwan.net/poem32325.html","الوافر"],[346,"لي من أبيك سقاه الغيث ماطره","https://www.aldiwan.net/poem20167.html","البسيط"],[351,"حمدا لمن جعل التاريخ عقد حلى","https://www.aldiwan.net/poem39584.html","البسيط"],[362,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[364,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[400,"ما آن للعاذل أن يغلقا","https://www.aldiwan.net/poem33627.html","السريع"],[429,"قد كنت أمنع بيع الشعر في زمن","https://www.aldiwan.net/poem12508.html","البسيط"],[451,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[456,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[560,"دع النسيب وجانب جانب الغزل","https://www.aldiwan.net/poem52825.html","البسيط"],[565,"أصبحت لا مال لي سوى الأمل","https://www.aldiwan.net/poem69539.html","المنسرح"]],"verses":[["وَلي غَرَضٌ أَن لا تَزالَ قَصيدَةٌ","تُجَمجِمُ يَوماً عَن مُنايَ وَسولي",0,"ل",2,0],["وَلِيَغدُ كُلُّ مُغرِضٍ مِن بَعدِهِ","مُغرىً بِحَلِّ مَعاقِدِ الأَكوارِ",1,"ر",1,0],["وليّ غمامٍ أو وليّ عبادةٍ","ترجِّيه للإحسان والحسنات",2,"ت",1,0],["وَلي غَيرُ حَقٍّ واجِبٍ إِن رَعَيتَهُ","فَمِثلُكَ يَرعى مِثلَهُ وَيُؤَيِّدُ",3,"د",1,0],["وَلي غَرسُ وُدٍّ في ذَراكَ تَتابَعَت","لَهُ حِجَجٌ خُضرٌ فَأَثَّ وَأَينَعا",4,"ع",2,0],["وَلي غايَةٌ يَجري إِلَيها تَنَفُّسي","إِذا ما انقَضَت تَنفيسَةٌ لي تَقَرَّبَت",5,"ت",1,0],["وليَغْزُوَنّهُمُ الأحَقُّ بغزوهم","واللّه عنْهُ بما يَشاءُ وكيل",6,"ل",1,0],["وَلْيغْنَمَا العَيْشَ صَفْواً","ممَّا يَشُوبُ وَرَغْدَا",7,"د",2,0],["وَلي غُلامٌ وَجهُهُ طَيرَةٌ","في غايَةِ الإِدبارِ وَالعَجزِ",8,"ز",1,0],["وَلي غَزَلٌ غَريبٌ في غَزالٍ","غَريبٍ صِرتُ فيهِ قَيسَ لُبنى",9,"ن",2,0],["وَلي غَريِمٌ غَدا كالذِّئْبِ يَخْتُلُني","وَمَا دَرَى أَنَّ خَلْفِي سَطْوَةَ الأسدِ",10,"د",1,0],["وَلي غَدا الرَمز لِلبارود إِذ ظَهَرت","حَوادث مِنهُ تأوي السَهل وَالجَبَلا",11,"ل",2,0],["ولي غُلّةٌ كمَنَتْ في الحشا","فليس لدَمْعٍ إليها طَريق",12,"ق",1,0],["وَلي غَيَّةٌ فيكُم تَضِلُّ وَلا تعي","وَلي لَوعَةٌ فيكُم تَخُبُّ وَلا تَخبو",13,"ب",2,0],["وليغترف من بحر إحسانه","فالكل منه قد سقى واستقى",14,"ق",2,0],["ولي غرائبُ فيه لو يقومُ بها","أخو الشباب شفيعاً فيه لم يَشِب",15,"ب",1,0],["وليغنّوا نقيض ما هم عليه","فبحسبي أني أقول وأعني",16,"ي",1,0],["وليغشَ منك النيروزُ أكرمَ مَن","حطَّ إليه الوفودُ أو رفعوا",17,"ع",3,0],["وليَغْتَنمَ رَبْعُكِ المسعودُ حينَ مَشى","عليهِ من قَدَمَيهِ فُرصةَ القُبَلِ",18,"ل",1,0],["وَلِي غَرِيْمٌ مُوَاصِلٌ خَتِلٌ","أَعْجَزَ فَضْلُ احْتِيَالِهِ حِيَلِي",19,"ي",1,0]]}