{"poems":[[55,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[55,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[74,"نزحت لبين النازحين مدامعي","https://www.aldiwan.net/poem18385.html","الطويل"],[47,"رددت بعيسى الروم من حيث أقبلت","https://www.aldiwan.net/poem62750.html","الطويل"],[47,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[51,"أيا عجب الدنيا لعين تعجبت","https://www.aldiwan.net/poem10847.html","الطويل"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[240,"ما سمحت والله يا سادتي","https://www.aldiwan.net/poem31919.html","السريع"],[287,"بريق بالأبيرق لاح وهنا","https://www.aldiwan.net/poem32325.html","الوافر"],[353,"لي من أبيك سقاه الغيث ماطره","https://www.aldiwan.net/poem20167.html","البسيط"],[358,"حمدا لمن جعل التاريخ عقد حلى","https://www.aldiwan.net/poem39584.html","البسيط"],[369,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[371,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[409,"ما آن للعاذل أن يغلقا","https://www.aldiwan.net/poem33627.html","السريع"],[438,"قد كنت أمنع بيع الشعر في زمن","https://www.aldiwan.net/poem12508.html","البسيط"],[458,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[463,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[567,"دع النسيب وجانب جانب الغزل","https://www.aldiwan.net/poem52825.html","البسيط"],[572,"أصبحت لا مال لي سوى الأمل","https://www.aldiwan.net/poem69539.html","المنسرح"],[878,"","https://poetry.dctabudhabi.ae/diwan/poem/140216",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16765","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48257","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113817","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105002","البسيط"],[2452,"","https://poetry.dctabudhabi.ae/diwan/poem/141056","السريع"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144203","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74042","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129430","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107509","الكامل"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130604","الكامل"],[4755,"يا مَهْدَ مَن كَسَتِ الجِبالَ بُيُوتُهُم","https://www.poetsgate.com/ViewPoem.aspx?id=214531",""],[5358,"عسى ألا غيابَ","https://www.poetsgate.com/ViewPoem.aspx?id=27544",""],[5751,"امتحانُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=214724",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""]],"verses":[["وَلي غَرَضٌ أَن لا تَزالَ قَصيدَةٌ","تُجَمجِمُ يَوماً عَن مُنايَ وَسولي",0,"ل",2,0],["وَلِيَغدُ كُلُّ مُغرِضٍ مِن بَعدِهِ","مُغرىً بِحَلِّ مَعاقِدِ الأَكوارِ",1,"ر",1,0],["وليّ غمامٍ أو وليّ عبادةٍ","ترجِّيه للإحسان والحسنات",2,"ت",1,0],["وَلي غَيرُ حَقٍّ واجِبٍ إِن رَعَيتَهُ","فَمِثلُكَ يَرعى مِثلَهُ وَيُؤَيِّدُ",3,"د",1,0],["وَلي غَرسُ وُدٍّ في ذَراكَ تَتابَعَت","لَهُ حِجَجٌ خُضرٌ فَأَثَّ وَأَينَعا",4,"ع",2,0],["وَلي غايَةٌ يَجري إِلَيها تَنَفُّسي","إِذا ما انقَضَت تَنفيسَةٌ لي تَقَرَّبَت",5,"ت",1,0],["وليَغْزُوَنّهُمُ الأحَقُّ بغزوهم","واللّه عنْهُ بما يَشاءُ وكيل",6,"ل",1,0],["وَلْيغْنَمَا العَيْشَ صَفْواً","ممَّا يَشُوبُ وَرَغْدَا",7,"د",2,0],["ولي غفوة في كلّ ظلّ لقيته","ووقفة سقيا عند كلّ قليب",8,"ب",1,0],["وَلي غُلامٌ وَجهُهُ طَيرَةٌ","في غايَةِ الإِدبارِ وَالعَجزِ",9,"ز",1,0],["وَلي غَزَلٌ غَريبٌ في غَزالٍ","غَريبٍ صِرتُ فيهِ قَيسَ لُبنى",10,"ن",2,0],["وَلي غَريِمٌ غَدا كالذِّئْبِ يَخْتُلُني","وَمَا دَرَى أَنَّ خَلْفِي سَطْوَةَ الأسدِ",11,"د",1,0],["وَلي غَدا الرَمز لِلبارود إِذ ظَهَرت","حَوادث مِنهُ تأوي السَهل وَالجَبَلا",12,"ل",2,0],["ولي غُلّةٌ كمَنَتْ في الحشا","فليس لدَمْعٍ إليها طَريق",13,"ق",1,0],["وَلي غَيَّةٌ فيكُم تَضِلُّ وَلا تعي","وَلي لَوعَةٌ فيكُم تَخُبُّ وَلا تَخبو",14,"ب",2,0],["وليغترف من بحر إحسانه","فالكل منه قد سقى واستقى",15,"ق",2,0],["ولي غرائبُ فيه لو يقومُ بها","أخو الشباب شفيعاً فيه لم يَشِب",16,"ب",1,0],["وليغنّوا نقيض ما هم عليه","فبحسبي أني أقول وأعني",17,"ن",2,0],["وليغشَ منك النيروزُ أكرمَ مَن","حطَّ إليه الوفودُ أو رفعوا",18,"ع",3,0],["وليَغْتَنمَ رَبْعُكِ المسعودُ حينَ مَشى","عليهِ من قَدَمَيهِ فُرصةَ القُبَلِ",19,"ل",1,0],["وَلِي غَرِيْمٌ مُوَاصِلٌ خَتِلٌ","أَعْجَزَ فَضْلُ احْتِيَالِهِ حِيَلِي",20,"ل",2,0],["ولي غير وجه قد عرفت طريقه","ولكن بلا قلب إلى أين أذهب",21,"ب",1,0],["وليغن حسان بالتأييد أنّ له","ما ليس يعلوه تغيير وتبديل",22,"ل",1,0],["وَلِيَغدُ في تَعَبٍ يَرُح في راحَةٍ","إِنَّ الأُمورَ مُريحُها في المُتعِبِ",23,"ب",1,0],["وَلي غنْيَةٌ من خمرِ ريقٍ تُديرُهُ","مع اللَّثْمِ عن تَرْشَافِ خمرِ الأبَارِقِ",24,"ق",1,0],["وليَغتنِم طاعاتهِ تَبِعاً فمَن","يُطِعِ الرسولَ فقَد أطاعَ اللَهَ",25,"ه",1,0],["وليغن عن ديمة مثواك تمطره","فمن أكفك فيه قد ثوت ديم",26,"م",1,0],["ولي غلام طال في دقّةٍ","كخطّ إقليدس لا عرض له",27,"ه",1,1],["وليغنَمِ الإمكانَ ندْبٌ عالمٌ","أفضت إليه بسرّها المكنونِ",28,"ن",1,0],["ولي غرفة كالقبر لم تحو أرضها","سواي أثاثاً كالهباء قديما",29,"م",2,0],["وَليغدُ مثلك مَن يَرم نيل العلى","أَو لا فَنيل المكرمات بعيدُ",30,"د",1,0],["ولي غصن بان لا ينال محبه","مراما ولم تملك هواه عواذله",31,"ل",2,1],["وليغدُ اسماعيلُ عهدُكَ بيننا","بمشيئة الرحمن عهد سلامِ",32,"م",1,0],["وليغتبط بلقاء من هو جاره","موسى بن جعفر والجواد محمد",33,"د",1,0],["وَلَّى غُزَاةُ الأَمسِ، لا أَموَالُهُم","نَفعَت، ولا الإِدبارُ والإِقبالُ",34,"ل",1,0],["ولي غصنٌ وريقٌ مثْلُ قلبي","ولي أيكٌ هناكَ ولي الظِلالُ",35,"ل",1,0],["ولي غيومي ولي أنواءُ مَحْبَرَتِي","فكلَّما أمْطرتْ شِعراً فذا مَطَري",36,"ر",2,0],["وليغلقوا دوني المعابر كلها","أنا لن أموت ورزقه ممنوحُ",37,"ح",1,0]]}