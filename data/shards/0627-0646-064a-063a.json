{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[24,"يقول حياي من عوف ومن جشم","https://www.aldiwan.net/poem21881.html","البسيط"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[54,"يا بؤس للفضل لو لم يأت ما عابه","https://www.aldiwan.net/poem27634.html","البسيط"],[88,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[4,"ما إن تعري المنون من أحد","https://www.aldiwan.net/poem21157.html","المنسرح"],[72,"مسلسل الدمع أسير الفؤاد","https://www.aldiwan.net/poem18550.html","السريع"],[72,"قال العذول فزاد قلبا شيقا","https://www.aldiwan.net/poem19352.html","الكامل"],[72,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[78,"أنباء أسرك قد طبقن آفاقا","https://www.aldiwan.net/poem14223.html","البسيط"],[78,"لله در الحب ماذا يصنع","https://www.aldiwan.net/poem14250.html","الكامل"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[85,"شر البلية أن يكون زعيما","https://www.aldiwan.net/poem7255.html","الكامل"],[62,"قالت وقد سمعت أني نسبت بها","https://www.aldiwan.net/poem52491.html","البسيط"],[28,"طرقت أمية في المنام تزورنا","https://www.aldiwan.net/poem5168.html","الكامل"],[28,"نظر الدلهمس نظرة ما ردها","https://www.aldiwan.net/poem5252.html","الكامل"],[97,"يا قاسي البعد كيف تبتعد","https://www.aldiwan.net/poem24916.html","المنسرح"],[52,"إني غريب بدار لا كرام بها","https://www.aldiwan.net/poem26874.html","البسيط"],[52,"بان الخليط ولم يطق صبرا","https://www.aldiwan.net/poem27038.html","الكامل"],[46,"لا علم لي بم يختم العمر","https://www.aldiwan.net/poem22588.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[46,"لا علمَ لي بِمَ يُخْتَمُ العُمْرُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=20136",""],[105,"أترى الكنانة كيف تعبث بالدم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54977&r=&rc=147",""],[132,"إن لم تكن قد أحست البين من سلمه","https://www.aldiwan.net/poem54753.html","البسيط"],[211,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[229,"إني غريم والغريم مطالب","https://www.aldiwan.net/poem51018.html","الكامل"],[270,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[275,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[290,"يا جارتا رحماك في دنف","https://www.aldiwan.net/poem11659.html","أحذ الكامل"],[305,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[368,"هل بالديار أن تجيب صمم","https://www.aldiwan.net/poem1879.html","السريع"],[377,"قد أومضت حكمة الإنجيل عن رسل","https://www.aldiwan.net/poem59236.html","البسيط"],[400,"حينما يصبح البارود طيبا","https://www.aldiwan.net/poem6786.html","عموديه"],[403,"قد قلت إذ قال قومي أنت مخبرنا","https://www.aldiwan.net/poem33407.html","البسيط"],[453,"هاتى ثلوجك هاتي","https://www.aldiwan.net/poem61589.html","المجتث"],[500,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[515,"إني غنيت بعز الدين عن نفر","https://www.aldiwan.net/poem12307.html","البسيط"],[540,"من ذا رسول ناصح فمبلغ","https://www.aldiwan.net/poem56889.html","البسيط"],[551,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"]],"verses":[["إِنّي غُرِرتُ مِنَ الهَوى فَشَرِبتُهُ","لَم أَدرِ أَنَّ عَقيبَ شُربِيَ حَنظَلُ",0,"ل",1,0],["إِن يَغدُ في شيعَةٍ لَم يَثنِهِ نَهَرٌ","وَإِن غَدا واحِداً لا يَتَّقي الظَلِما",1,"م",2,0],["إِنْ يَغْدُ رَبَّهُمُ الأَعْلَى فَلا عَجَبٌ","هَلْ مِنْ نِظَامٍ بِلا شَمْسٍ لأَكْوَانِ",2,"ن",1,0],["إِن يَغدُرَنَّ فَإِنَّ الغَدرَ أَلبَسَهُ","مِنَ الأُبُوَّةِ وَالأَجدادِ جِلبابَه",3,"ب",2,0],["إن يغمِطوني لأني جئت أنهضهم","فأيّ مستنهض ذي نجدة غَمَطوا",4,"ط",3,0],["إِن يُغبَطوا يُهبَطوا وَإِن أَمِروا","يَوماً يَصيروا لِلهُلكِ وَالنَكَدِ",5,"د",1,0],["إن يغدُ رأسي أشهباً بعد ما","باد الصبى فالعذر كالصبح باد",6,"د",1,0],["إن يغن جفنيَّ البكاء فقد قلى","عدمُ الكرى فيها وأن يتفرَّقا",7,"ق",2,0],["أن يغد مدحِي عن ثناك مقصراً","فلقد يرى فوق النجوم محلّقا",7,"ق",2,0],["إن يغدُو روضاً فقد أرسى بجانبه","غيث الدُّموع وقد جادت غمائمه",8,"م",2,0],["إنْ يغبْ وجهُك المبارك عنَّا","أوْ يَعُقْ عنهُ حِجْبَةٌ أو ركوبُ",9,"ب",1,0],["إِن يَغضَبوا مِمّا أَقولُ فَطالَما","كَرِهَ الأَديبَ جَماعَةُ الغَوغاءِ",10,"ا",2,0],["أَنَّى غُلبتَ وَكُنتَ الدهر ذا غَلبٍ","لِلغالِبين وَلِلسباق سَبّاقا",11,"ق",2,0],["إِن يغرِ بِالهِجرانِ مالِكُ مُهجَتي","أُقبِل إِلَيهِ بِحالَتي أَتَضَرَّعُ",12,"ع",1,0],["إني غير مختار وفارق مضطرا","ولم يك لما عاش في نفسه حرا",13,"ر",2,1],["إن يغضبوا فلقد رضيت وحسبهم","أن يقذفوا بي في الجحيم ذميما",14,"م",2,0],["إنْ يغلُبِ الصبرُ فالعقبَى لمصطبِرٍ","أو يغلُبِ الوجدُ فالدنيا لمن غَلَبَا",15,"ب",2,0],["إِنّي غَداةَ غَدَت بِحاجَةِ ذي الهَوى","مِنّي وَلَم أَقضِ الحَياةَ صَبورُ",16,"ر",1,0],["إِنّي غَمَمتُكَ بِالهِجاءِ وَبِالحَصى","وَمَكارِمٍ لِفِعالِهِنَّ مَنارُ",17,"ر",1,0],["إني غريبٌ تعال يا سَكَني","فليس لي في زحامهم أحد",18,"د",1,0],["إِنّي غَريبٌ بِدارٍ لا كِرامَ بِها","كَغُربَةِ الشَعرَةِ السَوداءِ في الشَمَطِ",19,"ط",1,1],["أَن يَغفَلوا يُسرِع لِحاجَتِهِ","وَإِذا رَأوهُ أَحسَنَ العُذرا",20,"ر",2,0],["إِن يَغمِروكَ بِنائِلٍ وَنَدىً","مِنهُم فَما بِصُدورِهِم غِمرُ",21,"ر",1,0],["إِن يَغتَبِط بِكِ لا يُشِع لَكِ قَومُهُ","حَقَّ الحَفيِّ وَلا يَدَ المُتَكَرِّمِ",22,"م",1,0],["إني غَدوْت -بفضل بسمة ثغره-","ألقى الوزيرَ ولا يدقُّ فؤادي",23,"د",2,0],["إن يَغمُروكَ بنائِلٍ وندًى","منهمْ فما بصدروهِمْ غِمْر",24,"ر",1,0],["إن يغتبط بك لا يضع لك قومه","حق الحفي ولا يد المتكرم",25,"م",1,0],["إني غَدَرتُ وشيخي مِن شَمَائلِهِ","غَدرٌ وإني لأقفُو دَائماً شِيَمَه",26,"م",2,0],["إن يغلبوك على قلبي فما جهلوا","إيحاءك الشعر في يوم الثلاثاء",27,"ا",2,0],["إني غريمٌ والغريمُ مطالِبٌ","كان المُداينُ موسِراً أو معسِرا",28,"ر",2,1],["إني غفَرتُ لكِ الذّنوبَ جميعَها","كيما يطيبُ وصالُنا ولقانا",29,"ن",2,0],["إن يغْتِم الدُّوَلَ العَزيزَة بأسُه","فَلأنْ يُوالي جُودُه إعطاءَها",30,"ا",3,0],["إني غريب الدار في وطني","رغم الصحاب وكثرة الأهل",31,"ل",1,0],["إِن يغدُ وَعدٌ مِن كريم خلّبا","لَم يعدُ برقُ أبي الفدا إمطارا",32,"ر",2,0],["إنْ يَغْضَبوا يَغْضَبْ لِذاكَ كما","يَنْسَلُّ مِن خِرْشائِهِ الأَرْقَمْ",33,"م",1,0],["إني غدوتُ مسيحيّاً بفضلهمِ","من دونهم كنتُ ضُلّاً أعبدُ الجِنّا",34,"ن",2,0],["إن يَغِبْ جِسْمُكَ عنا فلدين","ذكرك الطيِّبُ يَأبى أنْ يغيبا",35,"ب",2,0],["أن يغفر اللّه لي ذنبي ويكرمني","ناديت يا ليت قومي يعلمون بما",36,"م",2,0],["إنِّي غريبٌ بجسمي","فلم يكن هو ذاتي",37,"ي",1,0],["إنِّي غَريبٌ في مُرَقَّعِ خِرْقَتي","الشَّيْبُ ناجاني وقد مَسَّ الكِبَرْ",38,"ر",1,0],["إني غنيت بعز الدين عن نفر","خطى المديح إليهم من خطاياه",39,"ي",3,1],["إِنّي غَرَضتُ إِلى تَناصُفِ وَجهِها","غَرَضَ المُحِبِّ إِلى الحَبيبِ الغائِبِ",40,"ب",1,0],["إِنْ يغتفرْ لا ينتقمْ أو ينتقمْ","لا يَصطلمْ أو يصطلمْ لا يَنكُلِ",41,"ل",1,0]]}