2,"","https://poetry.dctabudhabi.ae/diwan/poem/36673","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121274","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58109","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35463","البسيط"],[4549,"","https://poetry.dctabudhabi.ae/diwan/poem/203558","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4717,"أخت القمر","https://www.poetsgate.com/ViewPoem.aspx?id=199655",""],[4789,"الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=215288",""],[5057,"من صفات الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=197193",""],[5106,"هَٰذَا الحَبِيْبُ مِنَ العِرَاق","https://www.poetsgate.com/ViewPoem.aspx?id=150031",""],[5106,"مِنْ أَيْنَ أَبْدَأُ يَاْ أُمَيُّ خِطَابِيْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=156841",""],[5121,"مُنَاجَاةٌ وِجْدَانِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=33502",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5168,"انته ابتسم","https://www.poetsgate.com/ViewPoem.aspx?id=33674",""],[5232,"يا لا ذقيةُ","https://www.poetsgate.com/ViewPoem.aspx?id=212949",""],[5232,"صرخةُ الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=213092",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5376,"بانتْ بليلى امةٌ وديارُ","https://www.poetsgate.com/ViewPoem.aspx?id=197712",""],[5493,". أشتاق للبحر .","https://www.poetsgate.com/ViewPoem.aspx?id=197413",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5784,"كنت أظن الحب تسلية.....","https://www.poetsgate.com/ViewPoem.aspx?id=190616",""],[5842,"وصاحب الوجد مفتونٌ بشقوتِهِ / محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=141401",""],[5873,"الجمال الأخاذ","https://www.poetsgate.com/ViewPoem.aspx?id=215304",""],[5956,"إني غفرت لمومِس","https://www.poetsgate.com/ViewPoem.aspx?id=182699",""],[6084,"زارني ليلا وقد نام الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=170819",""],[1583,"جحود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73060&r=&rc=17",""],[5164,"ذُلُّ الهَوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75663&r=&rc=17",""],[147,"لاَ زِلْتَ تَعْلُو وَإِنْ حُسَّادُكَ اكْتَأَبُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27443&r=&rc=10",""]],"verses":[["إِنّي غُرِرتُ مِنَ الهَوى فَشَرِبتُهُ","لَم أَدرِ أَنَّ عَقيبَ شُربِيَ حَنظَلُ",0,"ل",1,0],["إِن يَغدُ في شيعَةٍ لَم يَثنِهِ نَهَرٌ","وَإِن غَدا واحِداً لا يَتَّقي الظَلِما",1,"م",2,0],["إِنْ يَغْدُ رَبَّهُمُ الأَعْلَى فَلا عَجَبٌ","هَلْ مِنْ نِظَامٍ بِلا شَمْسٍ لأَكْوَانِ",2,"ن",1,0],["إِن يَغدُرَنَّ فَإِنَّ الغَدرَ أَلبَسَهُ","مِنَ الأُبُوَّةِ وَالأَجدادِ جِلبابَه",3,"ب",2,0],["إن يغمِطوني لأني جئت أنهضهم","فأيّ مستنهض ذي نجدة غَمَطوا",4,"ط",3,0],["إِن يُغبَطوا يُهبَطوا وَإِن أَمِروا","يَوماً يَصيروا لِلهُلكِ وَالنَكَدِ",5,"د",1,0],["إن يغدُ رأسي أشهباً بعد ما","باد الصبى فالعذر كالصبح باد",6,"د",1,0],["إن يغن جفنيَّ البكاء فقد قلى","عدمُ الكرى فيها وأن يتفرَّقا",7,"ق",2,0],["أن يغد مدحِي عن ثناك مقصراً","فلقد يرى فوق النجوم محلّقا",7,"ق",2,0],["إن يغدُو روضاً فقد أرسى بجانبه","غيث الدُّموع وقد جادت غمائمه",8,"م",2,0],["إنْ يغبْ وجهُك المبارك عنَّا","أوْ يَعُقْ عنهُ حِجْبَةٌ أو ركوبُ",9,"ب",1,0],["إِن يَغضَبوا مِمّا أَقولُ فَطالَما","كَرِهَ الأَديبَ جَماعَةُ الغَوغاءِ",10,"ا",2,0],["أَنَّى غُلبتَ وَكُنتَ الدهر ذا غَلبٍ","لِلغالِبين وَلِلسباق سَبّاقا",11,"ق",2,0],["إِن يغرِ بِالهِجرانِ مالِكُ مُهجَتي","أُقبِل إِلَيهِ بِحالَتي أَتَضَرَّعُ",12,"ع",1,0],["إني غير مختار وفارق مضطرا","ولم يك لما عاش في نفسه حرا",13,"ر",2,1],["إن يغضبوا فلقد رضيت وحسبهم","أن يقذفوا بي في الجحيم ذميما",14,"م",2,0],["إنْ يغلُبِ الصبرُ فالعقبَى لمصطبِرٍ","أو يغلُبِ الوجدُ فالدنيا لمن غَلَبَا",15,"ب",2,0],["إِنّي غَداةَ غَدَت بِحاجَةِ ذي الهَوى","مِنّي وَلَم أَقضِ الحَياةَ صَبورُ",16,"ر",1,0],["إِنّي غَمَمتُكَ بِالهِجاءِ وَبِالحَصى","وَمَكارِمٍ لِفِعالِهِنَّ مَنارُ",17,"ر",1,0],["إني غريبٌ تعال يا سَكَني","فليس لي في زحامهم أحد",18,"د",1,0],["إِنّي غَريبٌ بِدارٍ لا كِرامَ بِها","كَغُربَةِ الشَعرَةِ السَوداءِ في الشَمَطِ",19,"ط",1,1],["أَن يَغفَلوا يُسرِع لِحاجَتِهِ","وَإِذا رَأوهُ أَحسَنَ العُذرا",20,"ر",2,0],["إِن يَغمِروكَ بِنائِلٍ وَنَدىً","مِنهُم فَما بِصُدورِهِم غِمرُ",21,"ر",1,0],["إِن يَغتَبِط بِكِ لا يُشِع لَكِ قَومُهُ","حَقَّ الحَفيِّ وَلا يَدَ المُتَكَرِّمِ",22,"م",1,0],["إني غَدوْت -بفضل بسمة ثغره-","ألقى الوزيرَ ولا يدقُّ فؤادي",23,"د",2,0],["إن يَغمُروكَ بنائِلٍ وندًى","منهمْ فما بصدروهِمْ غِمْر",24,"ر",1,0],["إن يغتبط بك لا يضع لك قومه","حق الحفي ولا يد المتكرم",25,"م",1,0],["إني غَدَرتُ وشيخي مِن شَمَائلِهِ","غَدرٌ وإني لأقفُو دَائماً شِيَمَه",26,"م",2,0],["إن يغلبوك على قلبي فما جهلوا","إيحاءك الشعر في يوم الثلاثاء",27,"ا",2,0],["إني غريمٌ والغريمُ مطالِبٌ","كان المُداينُ موسِراً أو معسِرا",28,"ر",2,1],["إني غفَرتُ لكِ الذّنوبَ جميعَها","كيما يطيبُ وصالُنا ولقانا",29,"ن",2,0],["إن يغْتِم الدُّوَلَ العَزيزَة بأسُه","فَلأنْ يُوالي جُودُه إعطاءَها",30,"ا",3,0],["إني غريب الدار في وطني","رغم الصحاب وكثرة الأهل",31,"ل",1,0],["إِن يغدُ وَعدٌ مِن كريم خلّبا","لَم يعدُ برقُ أبي الفدا إمطارا",32,"ر",2,0],["إنْ يَغْضَبوا يَغْضَبْ لِذاكَ كما","يَنْسَلُّ مِن خِرْشائِهِ الأَرْقَمْ",33,"م",1,0],["إني غدوتُ مسيحيّاً بفضلهمِ","من دونهم كنتُ ضُلّاً أعبدُ الجِنّا",34,"ن",2,0],["إن يَغِبْ جِسْمُكَ عنا فلدين","ذكرك الطيِّبُ يَأبى أنْ يغيبا",35,"ب",2,0],["أن يغفر اللّه لي ذنبي ويكرمني","ناديت يا ليت قومي يعلمون بما",36,"م",2,0],["إنِّي غريبٌ بجسمي","فلم يكن هو ذاتي",37,"ت",2,0],["إنِّي غَريبٌ في مُرَقَّعِ خِرْقَتي","الشَّيْبُ ناجاني وقد مَسَّ الكِبَرْ",38,"ر",1,0],["إني غنيت بعز الدين عن نفر","خطى المديح إليهم من خطاياه",39,"ي",3,1],["إِنّي غَرَضتُ إِلى تَناصُفِ وَجهِها","غَرَضَ المُحِبِّ إِلى الحَبيبِ الغائِبِ",40,"ب",1,0],["إِنْ يغتفرْ لا ينتقمْ أو ينتقمْ","لا يَصطلمْ أو يصطلمْ لا يَنكُلِ",41,"ل",1,0],["إِنّي غَفَرتُ لِظالِمي ظُلمي","وَتَرَكتُ ذاكَ عَلى عِلمي",42,"ي",1,1],["إني غفلت عن الساقي فصيَّرني","كما تراني سليب العقل والدينِ",43,"ن",1,0],["إن يغضب الشعبُ على صالحٍ","فصالح إصلاحهُ ما خفي",44,"ي",1,1],["إن يَغْلَطِ الدهرُ فما الدّ","هرُ بمأمونِ الغَلَط",45,"ط",1,0],["إِن يَغْدُ دمعيَ في صِبْغِ العقيق فَقُلْ","هذا العقيقُ عليه صِبْغَهُ نَفَضا",46,"ض",2,0],["إني غضضت الطرف خو","فاً أن يؤثر فيه وهما",47,"م",2,0],["اني غريب واني مذ خلقت لقى","أكابد الفقر قسراً كلما قسرا",48,"ر",2,0],["أَنْ يَغْلِبَ النَفْسَ الَّتِي أُنَاجِي","وَالحِفْظَ مِنْ وَصِيَّةِ العَجّاجِ",49,"ج",1,0],["إني غبي في الأمور مغفل","لا أستطيع لما طلبت مباشرة",50,"ه",1,0],["أن يغظ الدهر ولائي لكم","فلا شفى من غيظة ولا اشتفى",51,"ا",1,0],["إن يغرِك الحاسدُ فيها فلقد","أغراك في مجدِك من فرط الحسد",52,"د",1,0],["إِني غزالُك جئت ربعَك سائلاً","ماذا أقول غداً لفتيان الغد",53,"د",1,0],["إني غفرت لظالمي ظلمي","وتركت ذاك له على علمي",54,"ي",1,1],["إني غلطت بقولي إنها بسواك","والحق عند الذي صلى بغير سواك",55,"ك",1,0],["إني غدوتُ يراني الصبحُ منفرداً","حتى يراني ظلام الليل معتزلا",56,"ل",2,0],["إنْ يُغْضِبُوك فذوِ حلمٍ وتغطيَةٍ","أو يقصدوكِ ففي أمْنٍ وفي رغد",57,"د",1,0],["إن يَغتصبكَ الردى منا فقد غصبت","بالأمس أمك صافي إرثها فدكا",58,"ك",2,0],["إٍني غداً أبلى بهول معظم","فإن نكلت في غد عن مقدم",59,"م",1,0],["إني غلام قد بعثت نقمة","على عصاة الحق أو تبيد",60,"د",1,0],["إن يغب ذاك فذا أحمد من","أحرز السر وأرضى ربه",61,"ب",2,0],["إنْ يغب عنك معشر عبدوا في","ك قديما جمالك الفتانا",62,"ن",2,0],["إني غنيُّ الذوق لكن خلّتي","لجواره تدعو وروحي تمقت",63,"ت",1,0],["أني غررت من الوصال بليلة","مرت على صفو وأعقبت الكدر",64,"ر",1,0],["إن يغفر الذّنب في هواهُ فما","لديث ذنب السّلوّ مُغتفرُ",65,"ر",1,0],["ان يغمدوه فقد هزوا لنا مهجا","أمضى من السمر والهندية القضب",66,"ب",1,0],["إني غدوت غريبا","لما فقدت الأحبّة",67,"ه",1,1],["إني غَرضتُ عن المُقام بأرضِكم","صِفرَ اليدينِ وحُقَّ لي أن أغرضا",68,"ض",2,0],["إنّي غَبطتكِ في المماتِ فلَيتني","كنتُ التي سارت بها الأقوامُ",69,"م",1,0],["إني غنى بفقري","ما دمت لي من غناك",70,"ك",1,0],["إنّي غنيٌّ بنفسي يا بَني مَطَرٍ","عنكُم وأنتم على الأعداءِ أنصاري",71,"ر",2,0],["إني غررت بقوم قد عرفت بهم","كيف الدموع سدى بالرسم تنسجم",72,"م",1,0],["إني غدوت من الليالي آمنا","لما التجأت لشاهق سامي الذرى",73,"ر",2,0],["أني غدوت الآنَ مضَّجِعَ الثَرَى","فمتى يكونُ بهِ مهبُّ رُقادي",74,"د",2,0],["إِني غَفرتُ ذُنوب دَهرٍ قَد مَضى","إِذ رامَ قربَك شافعاً مذ أَجرما",75,"م",2,0],["أني غرضتُ إلى اللقيا كما غرضت","من فقدها لنمير الماء نفس صدى",76,"د",2,0],["إني غريب قد دعوتك سيدي","حاشا ترد لدعوة اللهفان",77,"ن",1,0],["إن يغص المظلومُ في حومةِ الجو","رِ بداءٍ بينَ الحشات واللهاةِ",78,"ه",1,0],["إِن يَغشَكَ بارِقٌ فَذا مِن نَفَسي","أَو صابَكَ مزنةٌ فَمِن أَجفاني",79,"ي",1,0],["إني غريب لست تعرفني","قبلاً وأن كنت عرفت فني",80,"ي",1,0],["أن يغلب السلطان قدراً وعُلى","ويأخذ البلاد حتى المَوصلا",81,"ل",2,0],["إنْ يَغرُسِ الحُكَّامُ حولَ بلادهم","جُدُراً ليركَبَ شُمَّها الخُفراءُ",82,"ا",2,0],["إن يغفرِ اللَهُ لي من جرأةٍ سلَفَت","فما على الخلقِ يا بُشرايَ من باسِ",83,"س",1,0],["أن يغفرنَّ جميعَ ما قَّدْمتُهُ","من كلِّ إصْرٍ آدَ ظهْرِي مُثْقِل",84,"ل",1,0],["إِنّي غَريبٌ مِنَ المَساكِن","وَأَنتَ لي الأَهلُ وَالسَكَن",85,"ن",1,0],["أني غذيتُ بأرض لا تشبُ بها","نارُ المجوس ولا تبنى بها البيع",86,"ع",1,0],["ان يغربوا عن مقلتي فانهم","ذهبت ورآهم تغذ مسيرا",87,"ر",2,0],["ان يغف ظل فواده مستيقظا","لجلاء مكرمة وامن مروع",88,"ع",1,0],["إنِّى غَرَسْتُكِ فِى فُؤَادِي زَهْرَة ً","كَىْ تَرْتَوِى مِنْ شَوْقِ قَلْبِى الْمُعَتَصرْ",89,"ر",1,0],["أنَّى غرسنا في المحالِ رحالَنا","هزَّ المنازلَ في المحالِ نواحُك",90,"ك",1,0],["إنّي غريبٌ ها هُنا في موطِني","ثاوٍ أُحِسّ بحُزنِ ألفِ مُهاجِرِ",91,"ر",1,0],["إِنِّيْ غَرِيْرُكَ يَا صَبَاحُ تَشُمُّهَا","وتَضَمُّ إِحْسَانَاً غَفَىْ يَوْمَاً لَدَيَّا",92,"ي",2,0],["إنِّي غَرِيْرُكَ يا حَبِيبُ تَغُضُّ طَرْ","فَكَ عَنْ عِتَابِيْ فَالعِتَابُ شَقَا بِيْ",93,"ب",2,0],["إِنِّي غَرِيِبٌ فِي دِيَارِي شَارِدٌ","لاَحَفْتُ هَمِّي جَاهْلاً بَلْ غَائِمَا",94,"م",2,0],["إني غليك لشيق أنا لم ازل","من طول بعدك مكمداً محسورا",95,"ر",2,0],["آني غربه ودنيه ظلمه","ودرب بيه تعثر جدم",96,"م",1,0],["إن يغزل ِالشعرَ ماجَ الموجُ في خفرٍ","أو هاجَ بالشعر، بركانٌ قد ِانفجرا",97,"ر",2,0],["إنِّي غَرَسْتُ غراسَ أفكاري بكمْ","وَعيا ًعسى أغصانهُا تَتفرَّعُ",98,"ع",1,0],["إني غدوتُ قتيلَ الظاعنين ضنىً","أنا القتيل فيا بؤسىي لمن وغلا",99,"ل",2,0],["أني غشيتُ بلوعةٍ تنتابني","والعذْرُ وصلُك فالفؤادُ جِمَارُ",100,"ر",1,0],["إنِّي غمَسْتُ اشْتيَاقِي بالمرارِ فلا","يَحْلُو المذاقُ لمنْ ضاقتْ بهِ طُرُقِي",101,"ق",2,0],["إن يغد ربهم العلى فلا عجب","هل من نظام بلا شمس لأكوان",102,"ن",1,0],["إني غرقت ببحر ضاع شاطئه","وزورقي فاقد الألواح منكسر",103,"ر",1,0],["إني غدوت بلطف الله ملتجئاً","والقلب يلتحف الآمال منكسرا",104,"ر",2,0],["إنّي غريقٌ في بحار غرامكم","في غير وصلك لا أرى إنقاذا",105,"ذ",2,0],["إني غفرت لمومسٍ أخطاءها","ورضِيت أقرو وُدَّها وبهاءَها",106,"ه",2,1],["ان يغب يا سعد عنى ساعة","بت ليلي ساهرا أرعى الرقيب",107,"ب",1,0],["إِني غزوت الحبّ من صِغري","وغَنِمتُ ما لم يغنم البعضُ",108,"ض",1,0],["إني غويتُ.. هيام العشق خَدَّرَني","وهِمْتُ في حبها.. أَنّى أُلاقيني!",109,"ن",2,0],["إني غذا شئتُ أنْ يرتاحَ ذو كرمٍ","أَدَرْتُ رَاحاً أَبُوهَا الْفِكْرُ لاَ الْعِنَبُ",110,"ب",1,0]]}