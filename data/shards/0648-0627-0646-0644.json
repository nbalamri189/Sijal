poetsgate.com/ViewPoem.aspx?id=53230",""],[35,"صَحَا قَلْبُهُ يا عَزَّ أوْ كَادَ يَذْهَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=22128",""],[28,"بني نهشل أبقوا عليكم ولم تروا","https://www.poetsgate.com/ViewPoem.aspx?id=17005",""],[51,"رواغي رواغُ الخائف القلبِ لا السالي","https://www.poetsgate.com/ViewPoem.aspx?id=30286",""],[31,"أرقتُ ولم آرق لسقمٍ أصابني،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19019&r=&rc=282",""],[31,"أقولُ لأسماءَ اشتكاءً، ولا أرى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18936&r=&rc=199",""],[88,"اليك ما شاهدت عيني من العجب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19564&r=&rc=67",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""]],"verses":[["وَإِنَّ لِساني لَكُم وَالثَناءَ","وَإِنَّ وُلوعي بِكُم وَالغَراما",0,"م",2,0],["وَإِنَّ لي عادَةً في كُلِّ نازِلَةٍ","أَن لا تَذِلَّ لَها عُنقي مِنَ الضَرَعِ",1,"ع",1,0],["وَإِنَّ لَنا بَضَّ تِلكَ العُروقِ","إِذا عُدنَ يَنبِضنَ كَيّاً مُعِدّا",2,"د",2,0],["وَإِنِّ لَأَحفَظُ غَيبَ الخَليلِ","إِن ضاعَ وَاِستَلتَبَتهُ اللَواحي",3,"ح",2,0],["وَإِنَّ لَنا النارَ القَديمَةَ لِلقِرى","تُؤَرَّثُ مِن أولى الزَمانِ وَتورَثُ",4,"ث",1,1],["وَأَن لا أُجافي التُربَ عَنكَ بِراحَةٍ","وَلَو نازَعَتنيها الرَقاقُ الفَوارِثُ",5,"ث",1,0],["وَإِن لَبِستَ لِلبِلى جِلبابا","أَرى البُكاءَ سَفَهاً وَعابا",6,"ب",2,0],["وَإِن لَم يُجِنَّ المَشرَفيَّ قِرابُهُ","غَدا في الطلى أَو في الجَماجِمِ مغمدا",7,"د",2,0],["وَإِنْ لَمْ تُطِقْها فَاعْتَصِمْ بِابْنِ حُرَّةٍ","لِهِمَّتِهِ فَوْقَ السِّماكِ مَقيلُ",8,"ل",1,0],["وَإِنْ لَبِسَ العَجاجَةَ ضَلَّ فِيها","ضَلالَ المِشْطِ في الشَّعْرِ الأَثِيثِ",9,"ث",1,0],["وَإِنَّ لِقَاءً جَلَّ عَنْ ضَرْبِ مَوْعِدٍ","لأَكْرَمُ مَا يُهْدِي الأَرِيبَ أرِيبُ",10,"ب",1,0],["وَإنْ لَمْ يُصِبُ مِنْهُ السِّلاَحُ فَإِنَّمَا","أُصِيبَ بِسَهْمٍ مِنْ دُعَائكَ صَائِبٍ",11,"ب",1,0],["وَإِنَّ لَنا دُرنى فَكُلَّ عَشِيَّةٍ","يُحَطُّ إِلَينا خَمرُها وَخَميلُها",12,"ل",3,0],["وَإِن لَم يُدرِكِ الدُستورُ مِصراً","فَما لِحَياتِها أَبَداً قِوامُ",13,"م",1,0],["وَإِن لَم يَقُم إِلّا نِيازي وَأَنوَرٌ","فَقَد مَلَأَ الدُنيا نِيازي وَأَنوَرُ",14,"ر",1,0],["وَإِن لَم تَكُن بَلَغَت أَوجَها","كَذا كُلُّ شَيءٍ إِذا ما اِبتَدا",15,"ا",1,0],["وَإِنَّ لي بِنِظامِ الدينِ تَعزِيَةً","عَنهُ وَفي النَجبِ مِن أَبنائِهِ بَدَلُ",16,"ل",1,0],["وَإِن لُمتُ نَفسي كَيفَ أَنّي هَجَرتُها","وَرُمتُ صُدوداً ظَلَّت العَينُ تَدمَعُ",17,"ع",1,0],["وَإِنْ لَمْ يَرَ النَّصْرَ العَزيزَ فَرُوحُهُ","مِنَ المَوْطِنِ الأَعْلَى بِهِ اليَوْمَ جَذْلانُ",18,"ن",1,0],["وَإِنَّ لَهُ لَطَبّاخاً وَخُبزاً","وَأَنواعَ الفَواكِهِ وَالشَرابِ",19,"ب",1,1],["وَإِن لَبِسوا دُكنَ الخُزوزِ وَخُضرَها","وَراحوا فَقَد راحَت عَلَيكَ المَشاجِبُ",20,"ب",1,0],["وَإِن لَم تَكُن إِلّا رُسوماً مُحيلَةً","وَرُمكاً عَلى وُرقٍ مَطايا مَراجِلِ",21,"ل",1,0],["وَأَن لا يَني يا مَيُّ مِن دونِ صُحبَتي","لَكِ الدَهرَ مِن أُحدوثَةِ النَفسِ ذاكِرُ",22,"ر",1,0],["وَأَن لا يَنالَ الرَكبُ تَهويمَ وَقعَةٍ","مِنَ اللَيلِ إِلا اِعتادَني مِنكِ زائِرُ",22,"ر",1,0],["وَأَن لَم يَزَل يَستَسمِعُ العامَ حَولَهُ","نَدى صَوتِ مَقروعٍ عَنِ العَذفِ عاذِبِ",23,"ب",1,0],["وإن لم تقوِّمْها سهاماً مريشةً","فإن سهام الله عنك تناضلُ",24,"ل",1,0],["وإن لم تَرَوْني كفأَهُنَّ ترفعاً","وصدَّكُمُ من دون خِطْبتها خَطْبُ",25,"ب",1,0],["وأن ليث الشرى ما صيغ مفترساً","لكن أحالته فرّاساً يد السغب",26,"ب",1,0],["وأن لا تعاني غير نشر حقائق","وتنوير أفكار وانهاض قاعد",27,"د",1,0],["وأن للعلم في العلا فَلَكاً","كل المعالي تدور في قُطُبه",28,"ب",2,0],["وأن لساسة الدنيا لقلباً","قَسياً في السياسة مرمريّا",29,"ر",3,0],["وإن لأهل العلم فيه نوادياً","وإن لأهل الفضل فيها دساكرا",30,"ر",2,0],["وإن لم يكن هذا إلى المجد سُلَّماً","فأيّ ارتقاءٍ بعدُ أم أيّ سلّم",31,"م",1,0],["وإن لامني قوم عليك فإنني","لملتمس للقوم من جهلهم عذرا",32,"ر",2,0],["وأن لهاشم في الدهر مجداً","بناه لها الذي هشم الثريدا",33,"د",2,0],["وإن للموت أسباباً يسببّها","من سدّ كلِّ طريق عنه للهرب",34,"ب",1,0],["وإن لريحانيِّنا شاعرّيةً","من الشعر فيها أن يقال هي الشعر",35,"ر",1,0],["وإن لم يكن شعري من الشعر لم يكن","لعمرُ النهى للشعر عند النهى قدر",35,"ر",1,0],["وَإِنَّ لِيَربوعٍ مِنَ العِزِّ باذِخاً","بَعيدَ السَواقي خِندَفِيَّ المَخارِمِ",36,"م",1,0],["وَإِنَّ لَنا نَجداً وَغَورَ تِهامَةٍ","نَسوقُ جِبالَ العِزِّ شُمّاً هِضابُها",37,"ب",3,0],["وَإِن لَم يَكُن إِلّا القِتالُ فَإِنَّنا","نُقاتِلُ مَن بَينَ العَروضِ وَخَثعَما",38,"م",2,0],["وَإِن لَم أَجِد لِنَزيلي قِرىً","قَطَعتُ لَهُ بَعضَ أَطرافِيَه",39,"ه",1,0],["وإن لكم للفضل فضلاً مبرِّزاً","يقصِّرُ عنكم بالسُعاة لغوبها",40,"ب",3,0],["وإن لم يكن إلا الأسنة مركب","فلا رأي للمحول إلا ركوبها",40,"ب",3,0],["وإِنَّ لَنَا بِمَكَّة أَبطَحَيهَا","وَمَا بَينَ الأَخَاشِبِ والحُجُونَا",41,"ن",2,0],["وَإِنَّ لِسَيفِ الدَولَةِ القَرمِ عادَةً","تَرومُ عُلوقُ المُعجِزاتِ فَتَرأَمُ",42,"م",1,0],["وَإِنَّ لِقائَها لَيَهونُ عِندي","إِذا كانَ الوُصولُ إِلى نَجاحِ",43,"ح",1,0],["وَأَن لَيسَ لِلأَعداءِ عِندي غَميزَةٌ","وَلا طافَ لي مِنهُم بِوَحشِيَ صائِدُ",44,"د",1,0],["وَأَن لَم يَزَل لي مُنذُ أَدرَكتُ كاشِحٌ","عَدُوٌّ أُقاسيهِ وَآخَرُ حاسِدُ",44,"د",1,0],["وَإِنَّ لي حاجَةً يا زَيدُ أَذكُرُها","لَم أَقضِ مِنها إِلى ما قَومِنا وَطَرا",45,"ر",2,0],["وَإِن لَم تَقُل سِرّاً لِنَفسِكَ إِنَّني","أَصَبتُ كَريماً ثُمَّ أَصبَحتَ نادِما",46,"م",2,0],["وإن لم يكن إلاَّ أبو المسكِ أوهموا","فإنكَ أشهى في الفؤادِ وأعذب",47,"ب",1,0],["وأن لراحتيك على الغوادي","فخاراً ما عليه من جناح",48,"ح",1,0],["وإن لم تواصل غادة السفح مقلتي","فلا عادها عيشٌ بمغناه أخضر",49,"ر",1,0],["وإن لم يكن في وقفةٍ جمعيّة","فها نحن فيكم بالهنا نتجمّع",50,"ع",1,0],["وإن لم تكن موسى فإنَّ محمداً","كثير الأيادِي البيض في الظلم الحلك",51,"ك",1,0],["وإن لقاضي المسلمين عوارفاً","بها كم أقمنا للثنا شاهداً عدلا",52,"ل",2,0],["وَإِن لا مَني النا","سُ فَفي وَجهِكَ لي عُذرُ",53,"ر",1,0],["وإن لا تكن لي سيداً في إقالتي","فلي من أبي العباس أكرمُ سَيِّدِ",54,"د",1,0],["وإن لم أقرّظْ منك إلا مُقرَّظاً","وإن لم أشِدْ إلا بذكر ذَكير",55,"ر",1,0],["وإن لإبراهيم يوماً لَطفرةً","إلى الزنج ما ينفك فيها يفكر",56,"ر",1,0],["وإنّ له من فضله لمُحرِّكاً","على أنها الأخلاق قد تتنكر",57,"ر",1,0],["وإن لم يُنَوِّه ربه باسم نفسه","فأنت له من أجل ذلك حاقر",58,"ر",1,0],["وإن لاقيتَهم في يوم روعٍ","لقيت الجن في أشباح إنس",59,"س",1,0],["وإن لكم فيمن وسمتُ لعبرة","تُحنِّكُ من غِراتكم وتُجرِّس",60,"س",1,0],["وأنْ ليس حظي ساقطاً عند مِثلهِ","ولا حَظُّه عن حمدِ مثليَ ساقِطُ",61,"ط",1,0],["وإن لا أُجِد في مدحه فلأنني","وثقت به حتى اختصرت الذرائعا",62,"ع",2,0],["وأن لست ممنوع أمنيَّةٍ","وأن لست للخير بالمانع",63,"ع",1,0],["وأن لست كلّاً على ناظر","وأن لست وقراً على سامع",63,"ع",1,0],["وإن لم تهو إلا السير فيه","فإنك لن تصادفه مخيفا",64,"ف",2,0],["وإن لم أصم بعدها مدتي","من الكشك ما دام في الناس جافي",65,"ي",1,0],["وأنلني يا من رأيت سؤالي","ه سواء في نيله والعفافا",66,"ف",2,0],["وإن لهوتَ بنضحِ الماء آونةً","فما أراه عن المعروفِ ألهاكا",67,"ك",2,0],["وإن لم يبتهل جهراً لساني","عليك فنيّتي لك بابتهالِ",68,"ل",1,0],["وإن لم تردني فانصرافي إذن غداً","يوافق ما تهوى فيَسكُنُ بلبالي",69,"ل",2,0],["وأنْ ليس للداءِ داءِ الفقي","رِ غيرُكُمُ الدهرَ من حاسمِ",70,"م",1,0],["وَأَن لا غَوثَ إِلّا مُرهَفاتٌ","مُسالاتٌ وَذو رُبَدٍ خَشيبُ",71,"ب",1,0],["وَإِنَّ لَها يَومَينِ يَومَ إِقامَةٍ","وَيَوماً تَشَكّى القَضَّ مِن حَذَرِ الدَربِ",72,"ب",1,0],["وَإِنَّ لَنا بَرَّ العِراقِ وَبَحرَهُ","وَحَيثُ تَرى القُرقورَ في الماءِ يَسبَحُ",73,"ح",1,0],["وَأَنَّ لَهُ الدُنيا الَّتي هُوَ بَعضُها","وَأَنَّ لَهُ الأُخرى إِذا صامَ أَو صَلّى",74,"ل",2,0],["وَإِن لَم أَكُن كَالرَوضِ وَالنَجمِ وَالحَيا","فَحَسبِيَ اِعتِقادي أَنَّ شُطَّتُها المُثلى",74,"ل",2,0],["وَإِنَّ لَكُم بِسِواها غِنىً","وَلَيسَ لَنا بِسِواها غِنى",75,"ن",2,0],["وَإِن لاحَ بَرقٌ فَهوَ نارُ صَبابَتي","وَإِن راحَ سَيلٌ فَهوَ ماءُ دُموعي",76,"ي",1,0],["وَأَنَّ ليَ القَلبَ الَّذي لَيسَ خاليا","مِنَ الوَجدِ وَالجَفن الَّذي لَيسَ يَهجَعُ",77,"ع",1,0],["وَأَن لَم تَبِت مِثلي تَطيرُ قُلوبُها","إِذا اهتَزَّ بابُ السجنِ أَو صلصلَ القفلُ",78,"ل",1,0],["وان لاقلام عن الحق ذادة","لضربا كما للمشرفية من ضرب",79,"ب",1,0],["وان لئيم القوم ان سار ضاربا","الى غاية شر الطريقين يسلك",80,"ك",1,0],["وان لابناء العراق تأهباً","ولا تكذب الآمال في المتأهب",81,"ب",1,0],["وإنّ لنا إذا متنا حياةً","ننالُ إلى السماء بها انتقالا",82,"ل",2,0],["وإن لنا بالدين في الناس سؤددا","وإن لنا بالدين بين الورى فخرا",83,"ر",2,0],["وإن لم تأتك الدنيا بظل","فجاوزها إلى دنيا تظل",84,"ل",1,0],["وَإِنَّ لَيالِياً أَمسَكتَ فيها","لَسودٌ لِليَراعِ وَلِلدَواةِ",85,"ه",1,0],["وَإِن لَقيتُ اِبنَ أُنثى لي عَلَيهِ يَدٌ","جَحَدتُ في جَنبِ فَضلِ اللَهِ أَفضالي",86,"ي",1,0],["وَأَن لا يَخُصُّ الفَقدُ شَيئاً فَإِنَّني","فَقَدتُ فَلَم أَفقِد دُموعي وَلا وَجدي",87,"د",2,0],["وَأَنَّ لَها شَرَفاً باذِخاً","وَأَنَّ الخِيامَ بِها تَخجَلُ",88,"ل",1,0],["وَأَن لا أُلاقي روحَكِ الطَيِّبَ الَّذي","كَأَنَّ ذَكِيَّ المِسكِ كانَ لَهُ جِسما",89,"م",2,0],["وإِن لم تواسُوا بالمقام فساعدوا","بتعريجةٍ بين اللوى والأناعمِ",90,"م",1,0],["وإِن لم تملكِ الدنيا جميعاً","كما تختارُ فاتركْهَا جميعَا",91,"ع",2,0],["وإن لم تَجِدْ في السُّحْبِ إلّا صواعقاً","فلا جادتِ الدنيا الغُيوثُ الهوامعُ",92,"ع",1,0],["وإنْ لم يكنْ بيني وبينَ لِقائِكمْ","سِوى عُمْرِ يومٍ إنَّه لَبعيدُ",93,"د",1,0],["وإنَّ للعقلِ لو أبصرتَ معتَبراً","بغَرفةٍ فَرْدةٍ من نهرِ طَالُوتِ",94,"ت",1,0],["وَإِن لَجلَجتَ عَن غَصَصٍ","دَعَونا الوَيلَ وَالحَرَبا",95,"ب",2,0],["وَإِن لَم يَكُن في عاجِلِ الدَهرِ مِنهُمُ","نَوالٌ وَغَيبٌ مِن زَمانِكَ آجِلُه",96,"ل",2,0],["وَأَنَّ لَهُ عَطفاً عَلَيها وَرَأفَةً","وَفَضلَ أَيادِ بِالنَوالِ جِسامِ",97,"م",1,0],["وَإِنَّ لَنا شَهباءَ يَبرُقُ بَيضُها","إِذا خَفَقَت يَوماً عَلَينا عُقابُها",98,"ب",3,0],["وَأَنَّ لَنا بَني عَمروٍ عَلَيهِم","لَنا عَدَدٌ مِنَ الأَثَرَينِ ثابا",99,"ب",2,0],["وَإِنَّ لَهُ نارَينِ كِلتاهُما لَها","قِرىً دائِمٌ قُدّامَ بَيتَيهِ توقَدُ",100,"د",1,0],["وَأَن لَو رَكِبتَ الريحِ ثُمَّ طَلَبتَني","لَكُنتُ كَشَيءٍ أَدرَكَتهُ مَقادِرُه",101,"ر",2,0],["وَإِنَّ لَها بَينَ المِقَرَّينِ ذائِداً","وَسَيفَ عِقالٍ في يَدَي غَيرِ جَيدَرِ",102,"ر",1,0],["وَإِن لَم تَكُن لي في الَّذي قُلتُ مِرَّةٌ","فَدُلّيتُ في غَبراءَ يَنهالُ جولُها",103,"ل",3,0],["وَإِنَّ لَكُم عيصاً أَلَفَّ غُصونُهُ","لَهُ ظِلُّ بَيتي عَبدِ شَمسٍ وَهاشِمِ",104,"م",1,0],["وَإِنَّ لَها أَعمامَ صِدقٍ وَإِخوَةٍ","وَشَيخاً إِذا شِئتُم تَنَمَّرَ دونَها",105,"ن",3,0],["وإنْ لَجَّ في إضرارِهِ الدَّهْرُ أَصبحَتْ","خَلائِقُهُ فيها أَضَرَّ وأَنفَعا",106,"ع",2,0],["وإنْ لم يكن عهدُ الشبابِ براجعٍ","لَدَيْهِ ولا عصرُ الصِّبا بمُعادِ",107,"د",1,0],["وَأَنَّ لَهُ فيكُم مِنَ اللَهِ ناصِراً","وَلَيسَ نَبِيٌّ صاحِبَ اللَهِ أَوحَدا",108,"د",2,0],["وَإِنَّ لِكُلِّ تَلخيصٍ لَوَجهاً","وَإِنَّ لِكُلِّ مَسأَلَةٍ جَوابا",109,"ب",2,0],["وَإِنَّ لِكُلِّ حادِثَةٍ لَوَقتاً","وَإِنَّ لِكُلِّ ذي عَمَلٍ حِسابا",109,"ب",2,0],["وَإِنَّ لِكُلِّ مُطَّلَعٍ لَحَدّاً","وَإِنَّ لِكُلِّ ذي عَمَلٍ حِسابا",109,"ب",2,0],["وَإِنَّ لِلدَهرِ لَو يُحصى تَقَلُّبُهُ","في كُلِّ طَرفَةِ عَينٍ مِنكَ تَقليبَه",110,"ب",2,0],["وَإِنَّ لَهُ لَمَنّا لَيسَ يُحصى","وَإِنَّ عَطائَهُ لَهُوَ الجَزيلُ",111,"ل",1,0],["وَإِن لَم يَكُن عَقلٌ يَصونُ أَمانَتي","وَعِرضي وَديني ما حَيِيتُ فَما فَضلي",112,"ي",1,0],["وَإِنَّ لَنا مِن بَعدِهِ مِن سَليلِهِ","مَليكاً بِهِ عَن فَقدِهِ يَحسُنُ الصَبرُ",113,"ر",1,0],["وَإِن لَم يَكُن غايَةً في الجَمالِ","وَبَدرُ مَعانيهِ لَم يَكمَلِ",114,"ل",1,0],["وإنْ لمْ أُبارِ المُزْنَ قطراً بأدمعٍ","عليكَ فلا سُقّيتُ منها الغواديا",115,"ي",2,0],["وإنّ لديها متاعاً قليلاً","فكنْ زاهدَ النفس فيما لديها",116,"ي",3,0],["وَإِن لم تَفُزْ فوزَ المُحِبِّينَ بِالهَوى","فقد نِلْتَ من بَرْحِ الصّبابةِ ما نالوا",117,"ل",3,0],["وإن لم أعاقرْكَ المدامَ فإنّني","حَقَنْتُ دمَ الزِّقّ الذي أنت سافِكُه",118,"ك",2,0],["وَإِنَّ لَدَيَّ لِلحَسَنِ بنِ وَهبٍ","حِباءً مِثلَ شُؤبوبِ الحَبِيِّ",119,"ي",1,0],["وَإِنَّ لَهُم لَإِحساناً وَلَكِن","جَرى الوادي فَطَمَّ عَلى القَرِيِّ",119,"ي",1,0],["وَإِن لَم يَجِد في قِسمَةِ العُمرِ حيلَةً","وَجازَ لَهُ الإِعطاءُ مِن حَسَناتِهِ",120,"ت",2,0],["وإنَّ لهُ ضداً هوَ الخلدُ فاعجبوا","لخلْدٍ لهُ عينانِ فَهْوَ منَ العبَرْ",121,"ر",1,0],["وإنْ لاحَ في القرطاسِ أسودُ خطِّهِ","يقولُ الدجى يا صبحُ لونُكَ حائلُ",122,"ل",1,0],["وإنَّ لهُ في تركِهِ الحكمَ راحةً","ولكنْ قلوبُ الناسِ واللهِ تَتْعَبُ",123,"ب",1,0],["وَأَن لا تَزالَ النَفسُ مِنكِ مَضيقَةً","عَلَيَّ وَتُبدي إِن هَلَكتُ عَويلا",124,"ل",2,0],["وَأَن لَم نَزَل مُنذُ اِهتَجَرنا كَأَنَّني","مُعادٍ فِراشي ما أُلايِمُ مَضجَعا",125,"ع",2,0],["وَإِنَّ لَها دونَ النِساءِ لَصُحبَتي","وَحِفظِيَ وَالأَشعارِ حينَ أُشَبَّبُ",126,"ب",1,0],["وَإِنَّ لي طَرفاً بِهِ ساهِداً","وَجداً وَدَمعاً هامِراً هامِلا",127,"ل",2,0],["وإنّ لها عِندَ المُغيرةِ هِمّةً","تَبيتُ لها الكُفّارُ صَرْعَى من الهَمِّ",128,"م",1,0],["وإنّ له بعد النبيِّ لَمشهداً","يَهونُ به عادٍ من الخطبِ فادحُ",129,"ح",1,0],["وإن لم تكن أظفارُهم جُنَّةً لهم","تقلَّب في أحشائِهم كلُّ ذِي ظُفُرْ",130,"ر",1,0],["وإنّ لِصحبِكَ في الباذلين","مَناقِبَ نُدمِنُ إجلالَهَا",131,"ل",3,0],["وَأَنَّ لِكُلِّ نَفْسٍ مُنْتَهاها","وإنْ طَمِعَ المضلَّلُ في المُحالِ",132,"ل",1,0],["وإنّ له لمنقلباً وبيلا","ألم يَمنُنْ عليه إذ الأُسارى",133,"ر",2,0],["وإنّ لجندهِ البطشَ المهولا","سيوفُ محمدٍ أمضى السيوفِ",133,"ف",1,0],["وَإِن لَم يَكُن إِلّا الأَماليسَ أَصبَحَت","لَها حُلُّقٌ ضَرّاتُها شَكِراتِ",134,"ت",1,0],["وأن لا إمامٌ غيرُ ذي التاجِ تلتقي","عليه هَوادي مجدِه والحَوارك",135,"ك",1,0],["وإنْ لم يكُنْ إلاّ الدّيارُ ورُعْتَهُمْ","فتلكَ نَواويسٌ لهم ولُحُود",136,"د",1,0],["وَإِنَّ لِلَّهِ سَيفاً فَوقَ هامِهِمُ","بِكَفِّ أَبلَجَ لا ضَرعٍ وَلا وانِ",137,"ن",1,0],["وإن لاح لي صيدٌ وثبتُ بنهضةٍ","على ردفهِ في السر كالذئب جائعا",138,"ع",2,0],["وَإِن لاقَيتُها كانَت","لَنا كَالسُكرِ أَو سُكرا",139,"ر",2,0],["وَأَنَّ لِبَعضِها لَفظاً وَفيها","حَواسِدُ مِثلَنا وَمُحَسَّداتُ",140,"ت",1,0],["وَإِن لَم تُطِق هِجرانَ رَهطِكَ دائِماً","فَمِن أَدَبِ النَفسِ الزِيارَةُ عَن غِبِّ",141,"ب",1,0],["وَإِنَّ لِأَجسامِ الأَنامِ غَرائِزاً","إِذا حَرَّكَت لِلشَرِّ طالِبَهُ لَجّا",142,"ج",2,0],["وَإِن لَحِقَ الإِسلامَ خَطبٌ يُغَضُّهُ","فَما وَجَدَت مَثَلاً لَهُ نَفسُ واجِدِ",143,"د",1,0],["وَإِن لَم تَرَ الصَقرَ الحَمامَةُ دَهرَها","فَمِن شِيَمِ الوُرقِ الحِذارُ مِنَ الصَقرِ",144,"ر",1,0],["وَإِن لَم يَكُن لُبُّ الفَتى مَعَ شَخصِهِ","وَليداً فَما يَفري لِنَفعٍ وَلا يُفري",145,"ر",2,0],["وَإِن لَذَّ القَبيحَ غُواةُ قَومٍ","فَإِنَّ الفَضلَ يُعرَفُ لِلأَعَفِّ",146,"ف",1,0],["وَإِن لَم يَعقُلِ الأَقدامَ عَّيبٌ","حَمَلنَ الثِقلَ مِن فَدَعٍ وَحَنفِ",147,"ف",1,0],["وَإِن لَم تُهيلا إِلى مُعدِمٍ","طَعاماً فَيَكفيهِ ما تَحثُوانِ",148,"ن",1,0],["وإنْ لم يَكُنْ للفَضْلِ ثَمّ مَزِيّةٌ","على النّقص فالوَيلُ الطويلُ من الغَبنِ",149,"ن",1,0],["وَإِنَّ لِسانَ المَرءِ ما لَم تَكُن لَهُ","حَصاةٌ عَلى عَوراتِهِ لَدَليلُ",150,"ل",1,0],["وأن لا أغضب الأمجا","د والغر الميامينا",151,"ن",2,0],["وإن له جروحاً مبقيات","إذا التأمت بصاحبها ندوبا",152,"ب",2,0],["وإِنَّ لي لرواحاً","مَع الهَوى وَغُدوّا",153,"و",2,0],["وإنَّ لي في هواها","دون الملاح غلوّا",153,"و",2,0],["وأن له في البر جيشاً عرمرماً","يماثله في البحر جيش عرمرمُ",154,"م",1,0],["وإن لم تكن للشعب أذن سميعة","فَماذا عسى أَن ينفع القائل النطق",155,"ق",1,0],["وأنلتَهُمْ شرَفَ المثولِ فقرَّبوا","مُهَجاً يحوطُكَ حُبُّها ويُطوِّقُ",156,"ق",1,0],["وإنّ لَدَيْنا في الكَنائِنِ صِيغَةً","كرِجلِ الدَّبَى حَبَّ القُلوبِ تُغادي",157,"د",2,0],["وَإِنَّ لِهَذَيْنِ العَشِيقَيْنِ حَادِثاً","غَرِيباً بِوُدِّي أَنْ أَرْى كَيْفَ يكْمُل",158,"ل",1,0],["وَإِنَّ لَهَا خِلاَلاً قَدْ تُنَافِي","صِفَاتِ الغِيدِ مِنْ خَيْرٍ وَخَيْرِ",159,"ر",1,0],["وإن لسانِي حين ينطق صارِمٌ","حسامٌ لهامات المُباين فالقُ",160,"ق",1,0],["وأنْ لا إلهٌ غيرُ ربي هو الذي","يُميتُ ويُحيي يومَ بعثٍ ومَوعدِ",161,"د",1,0],["وآن لِلْعِقْبَانِ أَنْ تَكْتَفي","وآنَ لِلْحِيتَأن أنْ تَشْبَعَا",162,"ع",2,0],["وإنّ لكُلّ مُطّلَعٍ لَحَدّاً،","وإنّ لكُلّ ذي أجَلٍ كِتابَا",163,"ب",2,0],["وإن لم يكن إلا الصحاصح روَّحت","مُحَلِّقَة ٌ ضَرَّاتُها شَكِرات",164,"ت",1,0],["وأنَّ للعبقريّ الفذِّ واحدةً","إمَّا الخُلودَ وإمَّا المالَ والنَّشبا",165,"ب",2,0],["وأنْ ليس في الكون من رحمةٍ","يواسي بها معشراً آخرونا",166,"ن",2,0],["وإن لاحَ صبحٌ لكمْ فاذكُروا","بأنَّا بليلِ العمى خابطونا",166,"ن",2,0],["وأنْ ليسَ ذلكَ مِنْ دَيْدَنٍ","لِمَنْ هَمّهُ عالَمٌ أصْلَح",167,"ح",1,0],["وأنْ ليس في الشرِّ من مغنم","يُعادِلُ ما فيه مِن مَثْلَب",168,"ب",1,0],["وإنْ لَمْ يَكُنْ في عاجِلِ الدّهرِ منهُمُ","نَوَالٌ، وَغَيْثٌ من زَمَانِكَ آجِلُهْ",169,"ل",2,0],["وَإنّ لِقَاءَهَا لَيَهُونُ عِنْدي،","إذَا كَانَ الوُصُولُ إلى نَجَاحِ",170,"ح",1,0],["وإن لم أكن كالروض والنجم والحيا","فحسبي اعتقادي أنّ خطّتها المثلى",171,"ل",2,0],["وإنّ لمنقادٌ لها اليومَ بالرّضى","وَمُعْتَذِرٌ مِنْ سُخْطِها مُتنصِّلُ",172,"ل",1,0],["وَإنّ لهَا بَينَ المِقَزَّينِ ذائِداً،","وَسَيْفَ عِقالٍ في يَدَيْ غيرِ جَيْدَرِ",173,"ر",1,0],["وإن لم تردني فانصرافي إذا غدا","يوافق ما تهوى يسكن بلبالي",174,"ل",2,0],["وَأَنْ لا تَزَالَ النَّفْسُ مِنْكِ مضيفَة ً","عَلَيَّ، وَتُبْدي، إنْ هَلَكْتُ، عَويلا",175,"ل",2,0],["وَأَنْ لَمْ نَزَلْ مُنْذُ کهْتَجَرْنا كَأَنَّني","معادٍ فراشي، ما ألايمُ مضجعا؟",176,"ع",2,0],["وان ليث البرايا الشرى ما صيغ مفترساً","لكن احالته فرَّاساً يد السغب",177,"ب",1,0],["وان لم تفعلوا فخذوا ردائي","به سدوا الجروح اذا دمينا",178,"ا",1,0]]}