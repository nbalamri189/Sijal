{"poems":[[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[336,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[466,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"]],"verses":[["وَأجحَرنضا أَسَاوِدَ كُلِّ حيٍّ","وأَسكَتنَا نَوَابِحَِ مُؤسِدِينَا",0,"ن",2,0],["وَأَجْحَرَ الكَلْبَ مُبْيَضُّ الصَّقِيعِ بِهِ","وَضَمّت الحيَّ مِنْ صُرّادِهِ الحُجَرُ",1,"ر",1,0],["وأجحمتُ نار الحرب في جنباته","فأضحت به هام الكُماة صواليا",2,"ي",2,0],["وأجحفنا بضبة يوم صلنا","فصاروا من أقل الخندفينا",3,"ن",2,0],["وَاِجحَدوا حَقَّنا شِقاقاً وَبَغياً","لَن تَغُضّوا مِن حَقِّنا بِالجُحودِ",4,"د",1,0]]}