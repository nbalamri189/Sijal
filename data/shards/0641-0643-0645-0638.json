{"poems":[[90,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[53,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[93,"يا جنة قبلما حلت بها قدمي","https://www.aldiwan.net/poem62814.html","عموديه"],[151,"يا عاذرا لامرئ قد هام في الحضر","https://www.aldiwan.net/poem47689.html","البسيط"],[287,"كفى حزنا أني عن الحي سآل","https://www.aldiwan.net/poem32671.html","الطويل"],[422,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124494",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137419",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138559",""],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104530","الطويل"],[5121,"الأخيل","https://www.poetsgate.com/ViewPoem.aspx?id=34713",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[5704,"القدس لنا","https://www.poetsgate.com/ViewPoem.aspx?id=194471",""],[4442,"هي الذكوات البيض من جانب الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=171009",""],[6164,"تنفيس .. وتقديس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66067&r=&rc=76",""],[406,"إلى أين يا قومي ؟؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63654&r=&rc=84",""]],"verses":[["فكم ظهرت للعلم فيك معاجز","بها آمن السيف الذي كذّب الكتبا",0,"ب",2,0],["فكم ظاعن منهن مزمع رحلةٍ","قصرنا نواه دون ما كان أزمعا",1,"ع",2,0],["فَكَم ظَمِئتُ وَفي روحي جَداوِلُها","وَكَم رُويتُ وَغَيري في سَواقيها",2,"ي",3,0],["فكم ظلمنا ظليما في نعامته","وإن يكن طائراً في الجو كالصقر",3,"ر",1,0],["فَكَم ظَبيَةٍ أَلحاظُها في اِصطِيادِها ال","أُسودَ نِشاطٌ وَهيَ في الخِدرِ مِكسالُ",4,"ل",1,0],["فكم ظبيٍ هنالك في كناسٍ","ينوب بفتكه عن ليث غاب",5,"ب",1,0],["فكم ظللت به جذلانة فرحا","يسدي صنائع فيها كل أكروما",6,"م",2,0],["فكم ظمئت إلى رؤياك شوقا","فكان لها بمنظرك ارتواء",7,"ا",2,0],["فكم ظهرت للرأس في الرمح آيةٌ","متى كان عالي الرمح للوعظ منبرا",8,"ر",2,0],["فكم ظللتها دولة عربية","لها المجد عرش والحفاظ لها جند",9,"د",1,0],["فَكَمْ ظَلَّ فِي الْقَارُورَةِ الْعِطْرُ نَائِماً","وَكَمْ ظَلَّ بَابٌ لِلْخَزَائِنِ مُغْلَقَا",10,"ق",2,0],["فكم ظلم جلي وكم فتن وقى","وكم فادح من معضلات النوازل",11,"ل",1,0],["فكم ظننت زعيمًا سوف ينصرنا","وكم حسبت غيورا يشحذ الهمما",12,"م",2,0],["فكم ظالمها دولة عربية","لها المجد عرش والحفاظ لها جند",13,"د",1,0],["فكَم ظَبْيَةٍ ضاء منها الفُؤادُ","وضاء الكِناسُ بِسِحْرِ الصُّداحْ!",14,"ح",1,0],["فكم ظالم يمشي إلى كل رغبة","وكم من برئ جاثم خلف قضبانِ",15,"ن",1,0]]}