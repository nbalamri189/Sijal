{"poems":[[72,"لكتموني رخيصا","https://www.aldiwan.net/poem42390.html","المجتث"],[119,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[189,"أقسمت لو كاتبتكم","https://www.aldiwan.net/poem14506.html","مجزوء الكامل"],[275,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[469,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[563,"إنما الإيمان نور","https://www.aldiwan.net/poem33785.html","مجزوء الرمل"],[563,"إن هذا الصبا وهذا الصباحا","https://www.aldiwan.net/poem34664.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48684","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216694",""],[2086,"","https://poetry.dctabudhabi.ae/diwan/poem/205171","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67197","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132550","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135922","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135918","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4120,"","https://poetry.dctabudhabi.ae/diwan/poem/198741","الخفيف"],[4225,"","https://poetry.dctabudhabi.ae/diwan/poem/143360","الرمل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105510","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52137","الخفيف"],[4680,"طلعة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=185087",""],[4691,"أميرة الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=155935",""],[4888,"حلب الشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=207762",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[5225,"السحابة","https://www.poetsgate.com/ViewPoem.aspx?id=30819",""],[5447,"جيش المرسى القديم","https://www.poetsgate.com/ViewPoem.aspx?id=208357",""],[5525,"أجمل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=854",""],[5842,"عصفورة الأمل \\محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=150624",""],[6001,"كلمه ومعناها","https://www.poetsgate.com/ViewPoem.aspx?id=411",""]],"verses":[["لَكتُموني رَخيصاً","فَاِنحَطَّ قَدري لَدَيكُم",0,"م",1,1],["لك تهدي من طريق الغيب في","عالم العلم بطرز كرما",1,"م",2,0],["لَكتبتُ في خدي لكم","بسواد عيني أو فؤادي",2,"د",2,0],["لكَ تصويرٌ وتلحينٌ ولي","نغَمٌ فالفنُّ إحدى نسبَتي",3,"ي",1,0],["لكتمنا سرَّ الغرامِ عن الوا","شين حتى أضاءت الأسرارا",4,"ر",2,0],["لكتاب الله والسن","نة عن طه الأمين",5,"ن",1,0],["لك تبدو به وما هي شيء","فتراها الأجسام والأرواحا",6,"ح",2,0],["لك تاج مصر وعرشها ولواؤها","تعنو لأمرك أرضها وسماؤها",7,"ا",3,1],["لك تهاني القلب منّي بالزّمر","منهله من منبع الخافق نمير",8,"ر",1,0],["لكتبت لي عمرو بن عثمان ولم","تتبعه في العنوان حرف دعاء",9,"ا",2,0],["لكَ تنتمي أقمارُ عزٍ قوَّموا","دينَ النبي وحلَّلوا ما حلَلا",10,"ل",2,0],["لك تاريخ مفخر يتجلى","ما تجلت نجومها النيران",11,"ن",1,0],["لك تنحو في وخدها ربع جود","هو خصب الجناب رحب الفناء",12,"ا",2,0],["لَكَ تَنحَنِي الأَعناقُ منك يؤَمَّلُ ال","إِعناقُ من سِجِّينِ خَصمٍ قد عَتا",13,"ا",1,0],["لك تَعبُدُ الآفاقُ بل تَتَعبَّدُ ال","أَعماقُ كُلٌّ تحتَ رِفعتِكَ انحنَى",13,"ا",1,0],["لك تخضعُ الأَفلاكُ صاغرةً ونَحوَكَ","تَسجُدُ الأَملاكُ أَسفَلَ والعُلَى",13,"ا",1,0],["لك تَحمَدُ الأَكوانُ بل يعنو لكَ ال","مَلَوانِ مِمَّن شاءَ طوعاً أو أَبَى",13,"ا",1,0],["لك توسَّلْتُ بقدرةٍ لكا","عليَّ أرجو رحمةً وفضلكا",14,"ك",2,0],["لك توسَّلتُ برحمة النبي","أريد رحمةً منك ومطلبي",14,"ي",1,0],["لك توسَّلْت بحقِّ القرآنْ","أريد مغفرة ذنبي في الزمانْ",14,"ن",1,0],["لك توسَّلْتُ بأشياخٍ ليا","سلسلةٍ سَمَتْ إلى رسوليا",15,"ي",2,0],["لك توسّلت به وبالكرمْ","وباسمك العظيم ذاك الأعظمْ",16,"م",1,0],["لكتاب الحياة يكتب يوما ً","بعد يوم لكي يكون سجلا",17,"ل",2,0],["لك ترجو منازلاً ومُقاماً","في جِنانٍ تطوفُ فيهنّ عِينُ",18,"ن",1,0],["لكَ تدريسٌ ولكنْ","راءُ تدريسِكَ لامُ",19,"م",1,1],["لكتاب ألفته محكم الذكر","هدىً للأنام فيه وذكرى",20,"ر",2,0],["لك تجثو الكواكبُ الزهراءُ","ولهذا البَها يَدين البهاءُ",21,"ا",2,0],["لكِ تشدو حدائقٌ وطيورٌ","صدَحَتْ بالغناء والتغريدِ",22,"د",1,0],["لك تعتزي الصحراءُ أنتِ قبيلُها","وإلى رمالِك كم يلوذُ صريخُ",23,"خ",1,0],["لكتبتُ فيكَ من الهجاءِ قصائدًا","ولَكنتُ وحدي في هجائِكَ شاعرَهْ",24,"ر",2,0],["لك تاحت نبوّة وأبونا","آدم عند ذاك طينٌ وماء",25,"ا",2,0],["لك تغني لى يزينها الخضاب","ويعلك السالم ْعلى طول المدى",26,"د",2,0],["لكتيبةِ المرسى الأخيرةِ ينحني","شعبُ المراسي في احتفالِ الجالية!",27,"ي",2,0],["لكتب الشمس شعرٍ في سناك","وامحي إمن السما...عج وكتام",28,"م",1,0],["لكتها ارتعدَتْ، وراحت تنثني","عن كلّ ما قدَّمت كي أرعاها",29,"ا",3,0],["لك تحياتي وازكاها","لك ودادي والغلا كله",30,"ل",2,0]]}