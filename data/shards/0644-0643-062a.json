{"poems":[[70,"لكتموني رخيصا","https://www.aldiwan.net/poem42390.html","المجتث"],[116,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[186,"أقسمت لو كاتبتكم","https://www.aldiwan.net/poem14506.html","مجزوء الكامل"],[271,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[465,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[559,"إنما الإيمان نور","https://www.aldiwan.net/poem33785.html","مجزوء الرمل"],[559,"إن هذا الصبا وهذا الصباحا","https://www.aldiwan.net/poem34664.html","الخفيف"]],"verses":[["لَكتُموني رَخيصاً","فَاِنحَطَّ قَدري لَدَيكُم",0,"م",1,1],["لك تهدي من طريق الغيب في","عالم العلم بطرز كرما",1,"م",2,0],["لَكتبتُ في خدي لكم","بسواد عيني أو فؤادي",2,"د",2,0],["لكَ تصويرٌ وتلحينٌ ولي","نغَمٌ فالفنُّ إحدى نسبَتي",3,"ي",1,0],["لكتمنا سرَّ الغرامِ عن الوا","شين حتى أضاءت الأسرارا",4,"ر",2,0],["لكتاب الله والسن","نة عن طه الأمين",5,"ن",1,0],["لك تبدو به وما هي شيء","فتراها الأجسام والأرواحا",6,"ح",2,0]]}