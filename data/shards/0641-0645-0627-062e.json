{"poems":[[110,"خليلي","https://www.shoaraa.com/p11134",""],[55,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[55,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[57,"ما زلت أحذر هذا العتاب","https://www.aldiwan.net/poem26454.html","المتقارب"],[24,"ألا بكرت عرسي توائم من لحى","https://www.aldiwan.net/poem21856.html","الطويل"],[84,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[90,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[90,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[90,"أحب صراحتى قولا وفعلا","https://www.aldiwan.net/poem45064.html","الوافر"],[29,"أخالد عاد وعدكم خلابا","https://www.aldiwan.net/poem5685.html","الوافر"],[94,"على ساحل البحر أنى يضج","https://www.aldiwan.net/poem38936.html","المتقارب"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"نجدد ذكرى عهدكم ونعيد","https://www.aldiwan.net/poem8088.html","الطويل"],[45,"مبيتي من دمشق على فراش","https://www.aldiwan.net/poem9714.html","الوافر"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[47,"رأيت البحبحاني استقلت","https://www.aldiwan.net/poem66636.html","البسيط"],[30,"لقد تدلق الغارات يوم لقائها","https://www.aldiwan.net/poem5013.html","الطويل"],[30,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[46,"ومنفرد بالحسن خلو من الهوى","https://www.aldiwan.net/poem30290.html","الطويل"],[76,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[77,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[48,"ألا إنما الدنيا نحوس لأهلها","https://www.aldiwan.net/poem22324.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140940",""],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10815","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54864","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[135,"ألما بي على الربع القديم","https://www.aldiwan.net/poem54742.html","الوافر"],[145,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[146,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[153,"دع القول في يوم بدارة جلجل","https://www.aldiwan.net/poem68591.html","الطويل"],[172,"ترى حيث أعلام العيون تراها","https://www.aldiwan.net/poem1689.html",""],[189,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[191,"إلا أنت","https://www.aldiwan.net/poem35679.html","عموديه"],[202,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[238,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[238,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[238,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[273,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[274,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[316,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[323,"له فطنة فوق العقول مكانة","https://www.aldiwan.net/poem67150.html","الطويل"],[331,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[341,"يا من ترفع للدنيا وزينتها","https://www.aldiwan.net/poem68606.html","البسيط"],[356,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[367,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[367,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[367,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[367,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[372,"بحمد الله وافتنا التهاني","https://www.aldiwan.net/poem4312.html","الوافر"],[380,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[405,"وغيداء لا تنفك تمل عيونها","https://www.aldiwan.net/poem46421.html","الطويل"],[405,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[419,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[419,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[440,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[442,"لتهنئ سلامتك المسلمينا","https://www.aldiwan.net/poem34797.html","المتقارب"],[442,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[460,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[460,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[460,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[466,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[466,"لقد أصبحت في سلطان ملك","https://www.aldiwan.net/poem3452.html","عموديه"],[470,"من الحزم ألا يرد الفتى","https://www.aldiwan.net/poem59937.html","المتقارب"],[479,"قف بي على منزل بالربع قد دثرا","https://www.aldiwan.net/poem15341.html","البسيط"],[502,"تبوأ إذا ضاق الخناق ظلالنا","https://www.aldiwan.net/poem37644.html","الطويل"],[502,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[531,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[540,"وفي كبد المفجوع ما الله عالم","https://www.aldiwan.net/poem47577.html","عموديه"],[550,"بكى صُرد لما رأى الحي أعرضت","https://www.aldiwan.net/poem1171.html",""],[553,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[571,"ألا أيها الغائر المستشي","https://www.aldiwan.net/poem52010.html","المتقارب"],[792,"","https://poetry.dctabudhabi.ae/diwan/poem/29559","الطويل"]],"verses":[["فما خصص التعميم لفظ بنصه","ولا قيّد الإطلاق فيه بمنزل",0,"ل",1,0],["فَما خَلِبَ النَوائِبُ مِنكَ بَرقاً","يَدُلُّ عَلى الوَفاءِ إِذا بَدا لي",1,"ل",2,0],["فَما خَدَعَتها رَوضَةٌ عَن مَسيرِها","وَلا لَمعُ مَعسولٍ تَطَلَّعَ مِن وِردِ",2,"د",1,0],["فَما خُلِقَ الحُبُّ لِلعالَمي","نَ إِلا شَقاءً وَإِلا عَذابا",3,"ب",2,0],["فَما خِلتُكُم يا قَومُ كُنتُم أَذِلَّةً","وَما خِلتَكُم كُنتُم لِمُختَلِسٍ جَنى",4,"ا",1,0],["فما خلت انصداع الفجر إلا","قرابا ينتضى منها حسام",5,"م",1,0],["فما خفقت عند الهياج قلوبهم","ولا أخذت أعصابهم رجفة الرُعب",6,"ب",1,0],["فما خفقان النجمِ إلاّ لأجلها","وما الشهب إلاّ أدمع النجم ترتمي",7,"م",2,0],["فما خادعت من أحدٍ بأمرٍ","ولا أضمرت حَسواً في ارتغاء",8,"ا",2,0],["فَما خَفِيَت هُضَيبَةُ حينَ جُرَّت","وَلا إِطعامُ سَخلَتِها الكِلابا",9,"ب",2,0],["فمَا خَفَّفَ النَّهْرُ مِنْ عَدْوِهِ","ولا سَكَتَ النَّهْرُ عن شَدْوِهِ",10,"ه",1,0],["فَما خلت دَولَته مِن ثائِرٍ","قَد قَطَع الطرقَ وَعاثَ في الحِمى",11,"ا",1,0],["فَما خَلفَ ما كابَدتَ في الحَقِّ غايَةٌ","وَلا فَوقَ ما قاسَيتَ فيهِ مَزيدُ",12,"د",1,0],["فَما خاشيكَ لِلتَكذيبِ راجٍ","وَلا راجيكَ لِلتَخيّبِ خاشي",13,"ش",2,0],["فَما خَلَونا مُذ رَأَيناهُ مِن","فَتحٍ جَديدٍ وَزَمانٍ أَنيق",14,"ق",1,0],["فَما خُرقُ السَفيهِ وَإِن تَعَدّى","بِأَبلَغَ فيكَ مِن حِقدِ الحَليمِ",15,"م",1,0],["فَما خُلِقَت إِلّا لِقَومٍ عَطاؤُها","يَكونُ إِلى أَيدي بَجيلَةَ جودُها",16,"د",3,0],["فَما خَمَدَت حَتّى أَضاءَ وَقودُها","أَخا قَفرَةٍ يُزجي المَطِيَّةَ حافِيا",17,"ي",2,0],["فَما خَطَرَت لي نَظرَةٌ نَحوَ غَيرِهِ","مِنَ الناسِ إِلّا قالَ أَنتَ عَلى ذَنبِ",18,"ب",1,0],["فَما خَفقُ أَيكي غَيرَ رَجفَةِ أَضلُعٍ","وَلا نَوحُ وُرقي غَيرَ صَرخَةِ نادِبِ",19,"ب",1,0],["فما خدعوا الخليفةَ بالأماني","ولكن غرّهم في الخادعينا",20,"ن",2,0],["فَما خَمرُهُ إِلّا دِماءُ عُداتِهِ","وَلا طَرَبٌ حَتّى تُغَنّي مَناصِلُه",21,"ل",2,0],["فما خطبهُ شاهَتْ وجوه دُعاتهِ","وجُدّعَ من مأفون رأيٍ وقُبّحا",22,"ح",2,0],["فَما خَشِيَت في السَيرِ زَلَّةَ عاثِرٍ","وَلَكِن تَساوى مَهبِطٌ وَصُعودُ",23,"د",1,0],["فما خاشيك للتكذيب راجٍ","ولا راجيك للتخييب خاش",24,"ش",1,0],["فَما خَيرُ عِشقٍ لَيسَ يَقتُلُ أَهلَهُ","كَما قَتَلَ العُشّاقَ في سالِفِ الدَهرِ",25,"ر",1,0],["فَما خاسَ مِنْهُمْ أَوْ تَرَدَّدَ ذائِدٌ","وَمَا فَضَلَ المَأْمُورَ فِيهِمْ مُؤَمَّرُ",26,"ر",1,0],["فَمَا خَطَا خُطْوَةً حَتَّى كَبَا فَإِذَا","بَيْنَ الرُّكَامِ الدَّوَامِي تَاجُهُ قِدَدُ",27,"د",1,0],["فَمَا خَامُوا ومَا جَبُنَوا ولَكِن","فَرَوا مَحبُوكَهَا فَرىَ الأدِيمِ",28,"م",1,0],["فما خَطَت الجُودِى حتى تراجفتْ","إليهنّ آكام العراقِ وقُورُها",29,"ر",3,0],["فَما خَلا عَرَبِيٌّ مِن مُفاخَرَةٍ","بِذي المَعالي وَإِن خُصَّت بِها العَجَمُ",30,"م",1,0],["فَما خامَرَت أَجفانَهُ سِنَةُ الغَمضِ","مَلأتُ بِهِ قَلبي وَعَيني وَمَسمَعي",31,"ي",1,0],["فَما خُلِقَت مِن طَبعِ حَيني خِفافُها","وَلا مِن ذُرى هُضبِ السَراةِ ذُراها",32,"ا",3,0],["فما خير دار لا يدوم نعيمها","فإن دام كان الموت من حسراتها",33,"ت",3,0],["فما خابت الأيامُ من سوء فعلها","وقدخاب حُسْنُ الظَّن خابَ تفاؤلُه",34,"ل",2,0],["فما خلقتَ كمثل البغض في امرأَةٍ","ينالها رجلٌ يوماً بطغيان",35,"ن",1,0],["فَما خَدَعَتنا عَن حَوالٍ أَوانِسٍ","بِنافِرَةٍ مِن وَحشِ وَجرَةَ مِعطالِ",36,"ل",1,0],["فَما خَلا مِنكَ قَلبٌ","وَخاطِرٌ وَضَميرُ",37,"ر",1,0],["فَما خابَ مَن كانَت وَسائِلَهُ الظُبا","إِلى الحَظِّ وَالقودُ المُطَهَّمَةُ القُبُّ",38,"ب",1,0],["فما خوضُكم في لجةٍ بأشدَّ من","تعَسُّفِكم في مهمهٍ وتنوفة",39,"ه",1,0],["فَما خسر أمرؤ يَرجوك نجما","لمطلبه وَيحسن فيك ظنا",40,"ن",2,0],["فما خص نوع لا يتم سواه من","مراكز أفلاك وأوضاع هيئة",41,"ه",1,0],["فَما خابَ في رَأيٍ وَلا ضَلَّ في نُهى","كَأَنَّ لَهُ في عالَمِ الغَيبِ مَشهَدا",42,"د",2,0],["فما خنقته دموع الأسى","ولا طوّقته معاني الحِداد",43,"د",1,0],["فَما خَطَبتُ إِلى الدُنيا مَطالِبَها","وَلا بَذَلتُ لَها عِرضي وَلا ديني",44,"ن",2,0],["فَما خلق الرَحمن في الخَلق طيّبا","مِن الخَلق إِلّا حَظُّهُ مِنهُ أَطيَبُ",45,"ب",1,0],["فما خَلتْ ليلةً مُذْ لم أُلاقِكُمُ","عَيْنايَ من عارضٍ للدّمع هَتّان",46,"ن",1,0],["فما خُلِقَ الورَى إلاّ مُحولاً","ولا خُلِقوا همُ إلاّ غَماما",47,"م",2,0],["فما خُلِقَ الفتَى إلاّ حُساماً","وما خُلِقَ السُّرَى إلاّ صِقالا",48,"ل",2,0],["فما خصَ وخْطُ الشّيبِ رأسي وإنما","بشَعري وشعرِي قد ألمَّ مشيبُ",49,"ب",1,0],["فما خَلق توخَى المجدَ إِلا","تَعلَّمَ من سجاياك الحِسان",50,"ن",1,0],["فما خافوا الأبالس في دَهاها","إذا قرعوا نواقيس الليالي",51,"ل",2,0],["فما خدعتني رقّةٌ من كلامها","ولا دلّ قلبي نحوها مَلَقُ الدلِّ",52,"ل",1,0],["فما خَطَرتْ يوماً ببالي بَلاَبِلٌ","ولاَ بتّ مِنها ربُّ طرفٍ مُسَهَّدِ",53,"د",1,0],["فما خاب في تلك المكارم آملٌ","ولا سُرَّ في نعمائه قطُّ حاسد",54,"د",1,0],["فما خابت ظنون أخي مرامٍ","أصارك في مطالبه مآلا",55,"ل",2,0],["فما خلا الدهر من يومي ندى وروىً","جود يسيل لديه أو دمٌ هدَرُ",56,"ر",1,0],["فما خَيَّبَ اللهُ فيكَ الرجاءَ","وَلا كذَّبَ الله فيك الظُّنونا",57,"ن",2,0],["فما خابَ فِي يومِ النَّدَى من يَنُوؤُهُ","ولا فازَ فِي يوم الوَغى مَنْ يُحاكِمُهْ",58,"م",2,0],["فما خُدِعتُ عن لحاظ قدها","بما رنا إليَّ من غزلانِها",59,"ن",3,0],["فما خضعتُ ولكن خانني زمني","ولا ذللتُ ولكن غاب أنصاري",60,"ر",2,0],["فما خُطِبَتْ بأبلغَ منه خاءٌ","ولا نُطِقَتْ بأفصحَ منه ضادُ",61,"د",1,0],["فما خاب ما أحييتُ من عمر الدجى","وما طلَّ فيها للكرى من دمٍ هدر",62,"ر",1,0],["فما خيلٌ تقيم ولسن خيلا","بناسٍ في الحقيقة غير ناسِ",63,"س",1,0],["فَما خُلطَةُ اللَهوِ مَحمودَةٌ","إِذا اِختَلَطَ العاجُ بِالآبَنوسِ",64,"س",1,0],["فما خَبا البرقُ إلا مِن زِنادِ هوًى","ما بين جنبَّي أبدى نُورَه وورى",65,"ر",2,0],["فما خامرت دنيا البريات لبَّنا","ولا بلبلت هذي الوجودات بالنا",66,"ن",2,0],["فما خَيَّبَ اللهُ من زارنا","بصدقٍ ولا رَدَّ من أمَّنا",67,"ن",2,0],["فَما خَرَجَتْ إلا بِسوءِ صَنيعِهِ","وأَنْتَ بِذا يا بنَ الأكارِمِ تَعْلَمُ",68,"م",1,0],["فما خُلِقَ الدمعُ السخىُّ على الثَّرَى","لنا عبثا فالدمع للحزن يدفع",69,"ع",1,0],["فَما خَيرُ مَن لا يَرتَجي خَيرَ أَوبَةٍ","وَيَخشى عَلَيهِ مِريَةٌ وَحُروبُ",70,"ب",1,0],["فما خفقتْ إِلّا كذاك جوانحٌ","ولا نبضتْ إلّا كذاك عروقُ",71,"ق",1,0],["فَما خير عرس إِذا خفتها","وَما خير بيت اذا لَم يزر",72,"ر",1,0],["فَما خادِرٌ مِن أُسدِ حَليَةَ جَنَّةُ","وَأَشبُلَهُ ضافٍ مِنَ الغيلِ أَحصَدُ",73,"د",1,0]]}