,"https://poetry.dctabudhabi.ae/diwan/poem/138826",""],[4525,"","https://poetry.dctabudhabi.ae/diwan/poem/124052","الطويل"],[4565,"","https://poetry.dctabudhabi.ae/diwan/poem/73932","المتقارب"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136387",""],[4674,"يتيم أنا","https://www.poetsgate.com/ViewPoem.aspx?id=210590",""],[4675,"وصية لفتاة","https://www.poetsgate.com/ViewPoem.aspx?id=192257",""],[4767,"الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=90448",""],[4830,"رثاء أخوي الشهيدين","https://www.poetsgate.com/ViewPoem.aspx?id=194883",""],[4886,"لله كم من هضبةٍ وجبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=170308",""],[4984,"يا خالق الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=190543",""],[3591,"أظلّ أقول الشعر فيك توهّما","https://www.poetsgate.com/ViewPoem.aspx?id=149464",""],[5190,"النيل يتحدث عن نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=61840",""],[5219,"أشجان عربي","https://www.poetsgate.com/ViewPoem.aspx?id=194935",""],[592,"ألا ليت شعري هل لماضي زماننا","https://www.poetsgate.com/ViewPoem.aspx?id=128855",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[1149,"ألاَ يا عمرو ، عمرو قبيلِ سهمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22302",""],[5464,"ليالينا عقيمات ... ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=27774",""],[5545,"أغارُ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=184793",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5596,"هجران شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=206190",""],[5628,"صباح الخير يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=181649",""],[243,"على الرابية","https://www.poetsgate.com/ViewPoem.aspx?id=50495",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5690,"أمير المؤمنين سعى إليكم","https://www.poetsgate.com/ViewPoem.aspx?id=170623",""],[2546,"لطغيان خفّ مذ ثلاثون حجّة","https://www.poetsgate.com/ViewPoem.aspx?id=201430",""],[5870,"بِطَاقَةُ تَقدير","https://www.poetsgate.com/ViewPoem.aspx?id=60863",""],[5906,"قصدتك يا كريم","https://www.poetsgate.com/ViewPoem.aspx?id=188230",""],[5943,"بإيمانٍ فلاحُ المسلمينا","https://www.poetsgate.com/ViewPoem.aspx?id=37270",""],[5309,"إذا رحت ترعى عهود الولاء","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573788",""],[463,"تعجبُ من صبري على ألوانها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60266&r=&rc=322",""]],"verses":[["فما خصص التعميم لفظ بنصه","ولا قيّد الإطلاق فيه بمنزل",0,"ل",1,0],["فَما خَلِبَ النَوائِبُ مِنكَ بَرقاً","يَدُلُّ عَلى الوَفاءِ إِذا بَدا لي",1,"ل",2,0],["فَما خَدَعَتها رَوضَةٌ عَن مَسيرِها","وَلا لَمعُ مَعسولٍ تَطَلَّعَ مِن وِردِ",2,"د",1,0],["فَما خُلِقَ الحُبُّ لِلعالَمي","نَ إِلا شَقاءً وَإِلا عَذابا",3,"ب",2,0],["فَما خِلتُكُم يا قَومُ كُنتُم أَذِلَّةً","وَما خِلتَكُم كُنتُم لِمُختَلِسٍ جَنى",4,"ا",1,0],["فما خلت انصداع الفجر إلا","قرابا ينتضى منها حسام",5,"م",1,0],["فما خفقت عند الهياج قلوبهم","ولا أخذت أعصابهم رجفة الرُعب",6,"ب",1,0],["فما خفقان النجمِ إلاّ لأجلها","وما الشهب إلاّ أدمع النجم ترتمي",7,"م",2,0],["فما خادعت من أحدٍ بأمرٍ","ولا أضمرت حَسواً في ارتغاء",8,"ا",2,0],["فَما خَفِيَت هُضَيبَةُ حينَ جُرَّت","وَلا إِطعامُ سَخلَتِها الكِلابا",9,"ب",2,0],["فمَا خَفَّفَ النَّهْرُ مِنْ عَدْوِهِ","ولا سَكَتَ النَّهْرُ عن شَدْوِهِ",10,"ه",1,0],["فَما خلت دَولَته مِن ثائِرٍ","قَد قَطَع الطرقَ وَعاثَ في الحِمى",11,"ا",1,0],["فَما خَلفَ ما كابَدتَ في الحَقِّ غايَةٌ","وَلا فَوقَ ما قاسَيتَ فيهِ مَزيدُ",12,"د",1,0],["فَما خاشيكَ لِلتَكذيبِ راجٍ","وَلا راجيكَ لِلتَخيّبِ خاشي",13,"ش",2,0],["فَما خَلَونا مُذ رَأَيناهُ مِن","فَتحٍ جَديدٍ وَزَمانٍ أَنيق",14,"ق",1,0],["فَما خُرقُ السَفيهِ وَإِن تَعَدّى","بِأَبلَغَ فيكَ مِن حِقدِ الحَليمِ",15,"م",1,0],["فَما خُلِقَت إِلّا لِقَومٍ عَطاؤُها","يَكونُ إِلى أَيدي بَجيلَةَ جودُها",16,"د",3,0],["فَما خَمَدَت حَتّى أَضاءَ وَقودُها","أَخا قَفرَةٍ يُزجي المَطِيَّةَ حافِيا",17,"ي",2,0],["فَما خَطَرَت لي نَظرَةٌ نَحوَ غَيرِهِ","مِنَ الناسِ إِلّا قالَ أَنتَ عَلى ذَنبِ",18,"ب",1,0],["فَما خَفقُ أَيكي غَيرَ رَجفَةِ أَضلُعٍ","وَلا نَوحُ وُرقي غَيرَ صَرخَةِ نادِبِ",19,"ب",1,0],["فما خدعوا الخليفةَ بالأماني","ولكن غرّهم في الخادعينا",20,"ن",2,0],["فَما خَمرُهُ إِلّا دِماءُ عُداتِهِ","وَلا طَرَبٌ حَتّى تُغَنّي مَناصِلُه",21,"ل",2,0],["فما خطبهُ شاهَتْ وجوه دُعاتهِ","وجُدّعَ من مأفون رأيٍ وقُبّحا",22,"ح",2,0],["فَما خَشِيَت في السَيرِ زَلَّةَ عاثِرٍ","وَلَكِن تَساوى مَهبِطٌ وَصُعودُ",23,"د",1,0],["فما خاشيك للتكذيب راجٍ","ولا راجيك للتخييب خاش",24,"ش",1,0],["فَما خَيرُ عِشقٍ لَيسَ يَقتُلُ أَهلَهُ","كَما قَتَلَ العُشّاقَ في سالِفِ الدَهرِ",25,"ر",1,0],["فَما خاسَ مِنْهُمْ أَوْ تَرَدَّدَ ذائِدٌ","وَمَا فَضَلَ المَأْمُورَ فِيهِمْ مُؤَمَّرُ",26,"ر",1,0],["فَمَا خَطَا خُطْوَةً حَتَّى كَبَا فَإِذَا","بَيْنَ الرُّكَامِ الدَّوَامِي تَاجُهُ قِدَدُ",27,"د",1,0],["فما خام عنها غير نكس منافق","كما قام فيها أروع النفس حازم",28,"م",1,0],["فَمَا خَامُوا ومَا جَبُنَوا ولَكِن","فَرَوا مَحبُوكَهَا فَرىَ الأدِيمِ",29,"م",1,0],["فما خَطَت الجُودِى حتى تراجفتْ","إليهنّ آكام العراقِ وقُورُها",30,"ر",3,0],["فَما خَلا عَرَبِيٌّ مِن مُفاخَرَةٍ","بِذي المَعالي وَإِن خُصَّت بِها العَجَمُ",31,"م",1,0],["فَما خامَرَت أَجفانَهُ سِنَةُ الغَمضِ","مَلأتُ بِهِ قَلبي وَعَيني وَمَسمَعي",32,"ي",1,0],["فَما خُلِقَت مِن طَبعِ حَيني خِفافُها","وَلا مِن ذُرى هُضبِ السَراةِ ذُراها",33,"ا",3,0],["فما خير دار لا يدوم نعيمها","فإن دام كان الموت من حسراتها",34,"ت",3,0],["فما خابت الأيامُ من سوء فعلها","وقدخاب حُسْنُ الظَّن خابَ تفاؤلُه",35,"ل",2,0],["فما خلقتَ كمثل البغض في امرأَةٍ","ينالها رجلٌ يوماً بطغيان",36,"ن",1,0],["فَما خَدَعَتنا عَن حَوالٍ أَوانِسٍ","بِنافِرَةٍ مِن وَحشِ وَجرَةَ مِعطالِ",37,"ل",1,0],["فَما خَلا مِنكَ قَلبٌ","وَخاطِرٌ وَضَميرُ",38,"ر",1,0],["فَما خابَ مَن كانَت وَسائِلَهُ الظُبا","إِلى الحَظِّ وَالقودُ المُطَهَّمَةُ القُبُّ",39,"ب",1,0],["فما خوضُكم في لجةٍ بأشدَّ من","تعَسُّفِكم في مهمهٍ وتنوفة",40,"ه",1,0],["فَما خسر أمرؤ يَرجوك نجما","لمطلبه وَيحسن فيك ظنا",41,"ن",2,0],["فما خص نوع لا يتم سواه من","مراكز أفلاك وأوضاع هيئة",42,"ه",1,0],["فَما خابَ في رَأيٍ وَلا ضَلَّ في نُهى","كَأَنَّ لَهُ في عالَمِ الغَيبِ مَشهَدا",43,"د",2,0],["فما خنقته دموع الأسى","ولا طوّقته معاني الحِداد",44,"د",1,0],["فَما خَطَبتُ إِلى الدُنيا مَطالِبَها","وَلا بَذَلتُ لَها عِرضي وَلا ديني",45,"ن",2,0],["فَما خلق الرَحمن في الخَلق طيّبا","مِن الخَلق إِلّا حَظُّهُ مِنهُ أَطيَبُ",46,"ب",1,0],["فما خَلتْ ليلةً مُذْ لم أُلاقِكُمُ","عَيْنايَ من عارضٍ للدّمع هَتّان",47,"ن",1,0],["فما خُلِقَ الورَى إلاّ مُحولاً","ولا خُلِقوا همُ إلاّ غَماما",48,"م",2,0],["فما خُلِقَ الفتَى إلاّ حُساماً","وما خُلِقَ السُّرَى إلاّ صِقالا",49,"ل",2,0],["فما خصَ وخْطُ الشّيبِ رأسي وإنما","بشَعري وشعرِي قد ألمَّ مشيبُ",50,"ب",1,0],["فما خَلق توخَى المجدَ إِلا","تَعلَّمَ من سجاياك الحِسان",51,"ن",1,0],["فما خافوا الأبالس في دَهاها","إذا قرعوا نواقيس الليالي",52,"ل",2,0],["فما خدعتني رقّةٌ من كلامها","ولا دلّ قلبي نحوها مَلَقُ الدلِّ",53,"ل",1,0],["فما خَطَرتْ يوماً ببالي بَلاَبِلٌ","ولاَ بتّ مِنها ربُّ طرفٍ مُسَهَّدِ",54,"د",1,0],["فما خاب في تلك المكارم آملٌ","ولا سُرَّ في نعمائه قطُّ حاسد",55,"د",1,0],["فما خابت ظنون أخي مرامٍ","أصارك في مطالبه مآلا",56,"ل",2,0],["فما خلا الدهر من يومي ندى وروىً","جود يسيل لديه أو دمٌ هدَرُ",57,"ر",1,0],["فما خَيَّبَ اللهُ فيكَ الرجاءَ","وَلا كذَّبَ الله فيك الظُّنونا",58,"ن",2,0],["فما خابَ فِي يومِ النَّدَى من يَنُوؤُهُ","ولا فازَ فِي يوم الوَغى مَنْ يُحاكِمُهْ",59,"م",2,0],["فما خُدِعتُ عن لحاظ قدها","بما رنا إليَّ من غزلانِها",60,"ن",3,0],["فما خضعتُ ولكن خانني زمني","ولا ذللتُ ولكن غاب أنصاري",61,"ر",2,0],["فما خُطِبَتْ بأبلغَ منه خاءٌ","ولا نُطِقَتْ بأفصحَ منه ضادُ",62,"د",1,0],["فما خاب ما أحييتُ من عمر الدجى","وما طلَّ فيها للكرى من دمٍ هدر",63,"ر",1,0],["فما خيلٌ تقيم ولسن خيلا","بناسٍ في الحقيقة غير ناسِ",64,"س",1,0],["فَما خُلطَةُ اللَهوِ مَحمودَةٌ","إِذا اِختَلَطَ العاجُ بِالآبَنوسِ",65,"س",1,0],["فما خَبا البرقُ إلا مِن زِنادِ هوًى","ما بين جنبَّي أبدى نُورَه وورى",66,"ر",2,0],["فما خامرت دنيا البريات لبَّنا","ولا بلبلت هذي الوجودات بالنا",67,"ن",2,0],["فما خَيَّبَ اللهُ من زارنا","بصدقٍ ولا رَدَّ من أمَّنا",68,"ن",2,0],["فَما خَرَجَتْ إلا بِسوءِ صَنيعِهِ","وأَنْتَ بِذا يا بنَ الأكارِمِ تَعْلَمُ",69,"م",1,0],["فما خُلِقَ الدمعُ السخىُّ على الثَّرَى","لنا عبثا فالدمع للحزن يدفع",70,"ع",1,0],["فَما خَيرُ مَن لا يَرتَجي خَيرَ أَوبَةٍ","وَيَخشى عَلَيهِ مِريَةٌ وَحُروبُ",71,"ب",1,0],["فما خفقتْ إِلّا كذاك جوانحٌ","ولا نبضتْ إلّا كذاك عروقُ",72,"ق",1,0],["فَما خير عرس إِذا خفتها","وَما خير بيت اذا لَم يزر",73,"ر",1,0],["فَما خابَ مَن فيه تمسّك واِلتجا","إليهِ ففي الرضوان يَحضى ويسعدُ",74,"د",1,0],["فما خيفَتي في القُربِ إلا مِنَ النَّوى","ولا رَوعَتي في اليَومِ إلاَّ مِنَ الغَدِ",75,"د",1,0],["فَما خَلدَ الفَواطِمُ فِيهِ قدماً","ولا سَكَنَت سُكَينَةُ والرَّبابُ",76,"ب",1,0],["فَما خضت بحر الحتف إِلّا وقد طَغى","بهام الأَعادي موجه المتدفع",77,"ع",1,0],["فَما خُطباءُ العُرْبِ أفصحُ واعِظاً","مِنَ الطَّيرِ يَشْدو لَوْ فَهمتَ المَعانِيا",78,"ي",2,0],["فما خاب من وافى لظل جنابه","لكشف كروب أو لدفع ملمة",79,"ه",1,0],["فما خاب محتاجٌ رجاكَ بحاجةٍ","وما باتَ موتورٌ دعاك إلى وِتْر",80,"ر",1,0],["فَما خِصالُ سِواهُ عِندَما حَسُنت","إِلّا لَدَى بِعضِ ما يَحويهِ شَنعاءُ",81,"ا",2,0],["فَما خابَ حقّاً مَن عَليهِ تَوكَّلا","أَلا كُلُّ مَقدورٍ يَكونُ بِعِلمِهِ",82,"ه",1,0],["فما خاب من كان الإله نصيره","على قُربِه أو مُوحِش من بعاده",83,"د",2,0],["فما خلد الملك كسرى ولا","تمنع سابور أو تبع",84,"ع",1,0],["فما خصكم ذا الرزء حيث أصابكم","ولكنه لم يخط منا موحدا",85,"د",2,0],["فما خلفت للأطلال دمعا","يعيد البين في أخلاف جفني",86,"ن",2,0],["فَما خابَ سَعيٌ في رِضاهُ لِخادِمٍ","وَلا اِنقَطَعَت لِلواطِئينَ عَلائِقُ",87,"ق",1,0],["فما خاصَمْتُ مِثْلَكَ من خصِيمٍ","ولا حالوتَ مِثْلَكَ مِنْ حَويلِ",88,"ل",1,0],["فما خسر العمر النفيس وفاته","به ربحه الا الغبي المقصر",89,"ر",1,0],["فَما خَبَتْ نارُنا ولا وَقَفَتْ","خُيولُ لَهْوٍ جَرَتْ بِنا خَبَبا",90,"ب",2,0