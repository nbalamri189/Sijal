{"poems":[[108,"بأيكما أبكي","https://www.shoaraa.com/p12758",""],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"لقد جثمت تعبيسة في المضاحك","https://www.aldiwan.net/poem29921.html","الطويل"],[63,"نأى بجانبه والصبح مبتسم","https://www.aldiwan.net/poem46133.html","البسيط"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[86,"إن صح ما قالوا وما أرجفوا","https://www.aldiwan.net/poem10356.html","السريع"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[54,"شكرنا الخليفة إجرائه","https://www.aldiwan.net/poem27492.html","المتقارب"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[88,"هم يعدون بالمئات ذكورا","https://www.aldiwan.net/poem44829.html","الخفيف"],[23,"فكف يديه ثم أغلق بابه","https://www.aldiwan.net/poem21614.html","الطويل"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[72,"عاش وصلا وغيره مات صدا","https://www.aldiwan.net/poem18558.html","الطويل"],[72,"جرى دمعي إلى والدي وأهلي","https://www.aldiwan.net/poem18602.html","الوافر"],[51,"أقصر وعور","https://www.aldiwan.net/poem61923.html","مجزوء الرجز"],[51,"تخذت عرضك منديلا أمش به","https://www.aldiwan.net/poem65824.html","البسيط"],[51,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[51,"رأت عيني لمنكرة قواما","https://www.aldiwan.net/poem66359.html","الوافر"],[85,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[62,"عليك أقمت أرسال الكلام","https://www.aldiwan.net/poem52266.html","الوافر"],[45,"أصبا الأصائل إن برقة منشد","https://www.aldiwan.net/poem63446.html","الكامل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[61,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[49,"الدهر يوعد فرقة وزوالا","https://www.aldiwan.net/poem63071.html","الكامل"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[105,"يا قوم إن كان مجد النيل مطلبكم","https://www.aldiwan.net/poem42128.html","البسيط"],[105,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[40,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[48,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67348","الكامل"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[54,"شكرنا الخليفة َ إجراءهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14477",""],[45,"أصَبَا الأصَائِلِ إنّ بُرْقَةَ مُنْشِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32956",""],[116,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[130,"يا أخي يا اخي المصاعب شتى","https://www.aldiwan.net/poem67454.html","الخفيف"],[132,"سليم بن منصور ألما تخبروا","https://www.aldiwan.net/poem24008.html","الطويل"],[133,"واسكب مدمع العينين وأذر","https://www.aldiwan.net/poem54820.html","الوافر"],[144,"كن بعيدا إن شئت أو كن قريبا","https://www.aldiwan.net/poem11727.html","الخفيف"],[161,"ما كنت يا بحر المكارم أحسب","https://www.aldiwan.net/poem59102.html","الكامل"],[170,"غداً نغتدي للبين أو نتروح","https://www.aldiwan.net/poem1612.html",""],[186,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[187,"أرى قوما شجيت بهم رذالا","https://www.aldiwan.net/poem43473.html","الوافر"],[211,"بالروح افدي صاحبا لم يزل","https://www.aldiwan.net/poem13443.html","السريع"],[212,"مصائب أشتات ينلن من الحشا","https://www.aldiwan.net/poem46638.html","الطويل"],[230,"دعاني فليس الرأي ما تريان","https://www.aldiwan.net/poem50739.html","الطويل"],[236,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[236,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[276,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[280,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[283,"دع النسيب وقول اللهو والغزل","https://www.aldiwan.net/poem32673.html","البسيط"],[283,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[286,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[299,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[321,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[326,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[365,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[365,"قل لأمين الملك عن عبده","https://www.aldiwan.net/poem60799.html","السريع"],[365,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[365,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[365,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[372,"كتبت جفونك فوق خدك أسطرا","https://www.aldiwan.net/poem57467.html","الكامل"],[372,"طرفان طرف مساعد","https://www.aldiwan.net/poem57475.html","مجزوء الكامل"],[381,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[381,"قفوا بالناجيات على زرود","https://www.aldiwan.net/poem49202.html","الوافر"],[394,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[403,"أصخ لشكيتي وارفق","https://www.aldiwan.net/poem46718.html","مجزوء الوافر"],[404,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[404,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[410,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[417,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[433,"وافيت منفردا عن الأنظار","https://www.aldiwan.net/poem12633.html","الكامل"],[433,"ما لمن في الهوى من خلاق","https://www.aldiwan.net/poem12686.html","الخفيف"],[440,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[442,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[451,"أيزيد حاربت الملوك ولم يكن","https://www.aldiwan.net/poem707.html",""],[462,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[506,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[542,"لعمري لستُ أترك آل قومي","https://www.aldiwan.net/poem672.html",""],[552,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[559,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فكف نداها الجود والضرب بالوغى","وبأس بطبع فيه رقّت مخالد",0,"د",1,0],["فَكَفكِف عِنانَ الوَجدِ إِمّا تَعَزِّياً","وَإِمّا طِلاباً أَن يُقالَ حَمولُ",1,"ل",1,0],["فَكَفكَف صُدورَ السَمهَرِيِّ بِعَزمَةٍ","عَلى كُلِّ مَلآنٍ مِنَ الضِغنِ فاتِكِ",2,"ك",1,0],["فكَفَّ منْ غَرْبِها لمّا اسْتَقامَ بهِ","زَيْغُ الخُطوبِ وأجْلى العارِضُ الهَزِمُ",3,"م",1,0],["فَكَفى العَضاريطُ الرِكابَ فَبُدِّدَت","مِنهُ لِأَمرِ مُؤَمَّلٍ فَأَجالَها",4,"ل",3,0],["فَكُفرُ طَهَ عِندَ دَيّانِهِ","أَحَبُّ مِن إِسلامِ عَبدِ الحَميد",5,"د",1,0],["فَكَفكِفي مِن دُموعٍ","تَفري حُشاشَةَ فاني",6,"ي",1,0],["فَكَفَّ أَذاهُ عَنِ المُسلِمينَ","وَصَيَّرَ في بَيتِهِ أَكلَهُ",7,"ل",2,0],["فَكَفَّ مِن غَربِهِ وَالغُضفُ يَسمَعُها","خَلفَ السَبيبِ مِنَ الإِجهادِ تَنتَحِبُ",8,"ب",1,0],["فكَفَيْنا أصهارهم مؤنة العي","ش فكانوا ضِغثاً على إبّاله",9,"ل",2,0],["فَكَفَّ يَدَيهِ ثُمَّ أَغلَقَ بابَهُ","وَأَيقَنَ أَنَّ اللَهَ لَيسَ بِغافِلِ",10,"ل",1,1],["فكفى من وضوحِ حاليَ أنِّي","في زماني هذا من الأدباء",11,"ا",2,0],["فكفى الجانبين مصراً وشاماً","وأفاض العينينِ عدلاً ورِفدا",12,"د",2,0],["فكفّ دموع عينك عن بلادي","وإلاّ كن فتًى يمضي بلاده",13,"د",2,0],["فكفَّ منه بصراً","مثل السراج الواقدِ",14,"د",1,0],["فكفّيَ الدهرَ لا تنقى أناملها","من لحمك الغثِّ أو من عرضك الودِكِ",15,"ك",1,0],["فكفُّهُ كفُّ تقبيلٍ يُفازُ به","ووجهُه وجهُ إجلالٍ وإكرامِ",16,"م",1,0],["فكُفّا بالذي أبلى وعافى","عن المشغُولِ بالحُبِّ المَلاما",17,"م",2,0],["فَكُفِّنَ بِالصَوارِمِ وَالعَوالي","وَغُيِّبَ حَيثُ جالَ وَحَيثُ صالا",18,"ل",2,0],["فَكَفَت كَونَ فَرحَةٍ تورِثُ الغَم","مَ وَخِلٍّ يُغادِرُ الوَجدَ خِلّا",19,"ل",2,0],["فكفكفَ غربَهُ غَصّاتُ دهرٍ","تُديرُ عليه كاسات السِّمامِ",20,"م",1,0],["فَكَفاهُمُ فِسقَ المُوَحِّدِ أَن سَعى","فيهِم بِإِصلاحٍ وَشِركَ المُلحِدِ",21,"د",1,0],["فَكَفَت مِنهُمُ بُطونُ سِباعٍ","قُبِروا جَوفَها بُطونَ لُحودِ",22,"د",1,0],["فَكَفاكَ مِن شَرَفِ الرِياسَةِ أَنَّهُ","يَثني الأَعِنَّةَ كُلَّهُنَّ بِإِصبَعِ",23,"ع",1,0],["فكَفاه أن يَصِفَ الصبَّابةَ ناطقاً","دَمعٌ إذا وصفَ الصبَّابةَ أطنَبا",24,"ب",2,0],["فَكَفى بِمُلتَمِسِ التَواضُعِ رِفعَةً","وَكَفى بِمُلتَمِسِ العُلُوِّ سِفالا",25,"ل",2,0],["فكفَّ عزم كفاة صدقُ بأسِهِمُ","مستأصلٌ نِعَمَ الأعداءِ بالنقمِ",26,"م",1,0],["فَكَفَّ عَنهُ رَسولُ اللَّهِ وَهوَ بِهِ","أَدرى وَكَم نِقَمٍ تفتَرُّ عَن نِعَمِ",27,"م",1,0],["فَكفِّروا بانتخابِ الصّالحين لها","عمّا جنَى قومُنا بالأمس واقترفوا",28,"ف",3,0],["فَكَفُّوا غَيْرَ بَادِرَةِ لِبِشْرٍ","مَضَتْ قَدَراً لِرَبِّكَ أو قَضاءَ",29,"ا",2,0],["فَكَفَيتَ أَيِّمَهُم مُناها بِالغِنى","وَالناكِحينَ مُؤونَةَ الإِصهارِ",30,"ر",1,0],["فَكَفى بِهِ هَجراً لَنا وَلَكُم","أَنّي وَذَلِكَ فَاِعلَمي الهَجرُ",31,"ر",1,0],["فَكَفاكَها سَمحُ اليَدَي","نِ بِصالِحِ الأَخلاقِ ماهِر",32,"ر",1,0],["فَكَفَّرَ الناسُ سِواهُم عِندَهُ","فَلَعنَةُ اللَهِ عَلَيهِ وَحدَهُ",33,"ه",1,0],["فكفاكَ وَشكُ رَحيلِهِ عن أرْضِهِ","عن أن يكون العامَ منك رحيل",34,"ل",1,0],["فَكَفكَفَ مُنتَصِبَ المَنكِبَينِ","لِفَرطِ الشَهامَةِ وَالنَجدَه",35,"د",2,0],["فَكَفاني بُخلُ مَن يَخ","نُقُ حَلقَ الكيسِ خَنقا",36,"ق",2,0],["فَكَفكَفتُ مِني عَبرَةً فَرَدَدتُها","عَلى النَحرِ مِنها مُستَهِلٌّ وَدامِعُ",37,"ع",1,0],["فَكفَّ أُولي شُقرٍ جياداً ضَوامِرا","فَزَحزَحَها عَن مِثِلها أَن تَصَدَّرا",38,"ر",2,0],["فكفاه أن جاء ميتا فأحيا","وكفى مصر ذلك الإحياء",39,"ا",2,0],["فَكَفَى بِنَا فَضْلاً عَلَى مَنْ غَيْرِنَا","حُبُّ النَّبيِّ مُحَمَّدٍ إِيَّانَا",40,"ن",2,1],["فكُفِينا شرَّ انفصامٍ وبيلٍ","أيُّ داءٍ كالانقسام عُضال؟",41,"ل",1,0],["فكفاكها سمحُ اليد","نِ بِصَالحِ الأخْلاقِ ماهِرْ",42,"ر",1,0],["فكفَّ أذاهُ عنِ المسلمينَ","، وصَيَّر في بيتِهِ وأَكْلَهُ",43,"ل",2,0],["فكَفَاهُمُ فِسْقَ المُوَحِّدِ أنْ سَعى","فيهِمْ بإلإصلاح، وَشِرْكِ المُلحِدِ",44,"د",1,0],["فكفها عنه توحيدا لخالقها","فازداد فقها وما للغير لاهوت",45,"ت",1,0],["فكفانا أنَّا ابتدأنا وأنَّا","إن عَجَزنا فقد بدأنا نشاهد",46,"د",1,0],["فَكُفّوا خُفاقاً عَن سَفاهَةِ رَأيِهِ","وَصاحِبَهُ العَبّاسَ قَبلَ الدَهارِسِ",47,"س",1,0],["فَكُفَّ اللَّومَ إني حِبُّ خُودٍ","أهِيمُ بِهَا على صَحوي وسُكرِى",48,"ر",2,0],["فَكَفاني مَؤونَةَ الشَوقِ عَزمٌ","لا يَمَلُّ التَقويضَ وَالتَطنيبا",49,"ب",2,0],["فكفى بذاك عقوبة عن زلتي","الحلم أوسع والمراحم أقرب",50,"ب",1,0],["فَكُفَّ شُؤونَ الدَمعِ حَتّى تَحُثُّها","غَداً ثُمَّ تَهمي كَيفَ شاءَت وَتَسفَحُ",51,"ح",1,0],["فكَفَّ كَفَّ عوادِيها وأَمَّنَنى","منها وصَيَّرَ لي في ظله شانا",52,"ن",2,0],["فكفي قد خلت من كل مال","سوى قعي ومحبرتي وفالي",53,"ل",2,0],["فكفه كالماء في جوده","وقلبه كالماء