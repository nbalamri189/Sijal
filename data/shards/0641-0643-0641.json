4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136737",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33718","المتقارب"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31277","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120500","الكامل"],[2052,"على هذه الدنيا بملكك رونق","https://www.poetsgate.com/ViewPoem.aspx?id=189617",""],[4767,"لبستِ الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=210860",""],[4848,"أعاذل مَا على مثلي عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=190943",""],[4859,"حنين شوقك!","https://www.poetsgate.com/ViewPoem.aspx?id=201076",""],[4984,"عِيدُ مِيلَاد","https://www.poetsgate.com/ViewPoem.aspx?id=200981",""],[5043,"وعد العرس الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=203387",""],[5081,"إِلَى الْقَاتِلَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=190409",""],[5100,"انقلاب","https://www.poetsgate.com/ViewPoem.aspx?id=207702",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5121,"سَكِر الكَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=33596",""],[5121,"خميلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33597",""],[5121,"وأنا هنا","https://www.poetsgate.com/ViewPoem.aspx?id=215051",""],[5121,"كَفَاكُم","https://www.poetsgate.com/ViewPoem.aspx?id=215948",""],[5136,"خليلي كفا طالما آلمتمانيا","https://www.poetsgate.com/ViewPoem.aspx?id=121790",""],[5185,"الأغلال","https://www.poetsgate.com/ViewPoem.aspx?id=203211",""],[5191,"طفلٌ في ثيابِ شيخ","https://www.poetsgate.com/ViewPoem.aspx?id=212281",""],[1043,"قيدان","https://www.poetsgate.com/ViewPoem.aspx?id=94027",""],[5277,"هلمّوا..إنّها القدسُ","https://www.poetsgate.com/ViewPoem.aspx?id=188133",""],[5281,"يمانيون بلا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=203068",""],[5299,"لا تلعبي في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=210539",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"هو الله معبود الورى فله الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=128841",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5397,"جلى صباح الهدى للخطب جنح دجى","https://www.poetsgate.com/ViewPoem.aspx?id=157955",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5459,"سلوا عيني..","https://www.poetsgate.com/ViewPoem.aspx?id=197133",""],[5508,"لنا صديقٌ به انقباض","https://www.poetsgate.com/ViewPoem.aspx?id=110825",""],[5563,"تعاطيت القصائد مسكراتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=211844",""],[5691,"سراب المصالحة","https://www.poetsgate.com/ViewPoem.aspx?id=206735",""],[5725,"حرفي تجرأ","https://www.poetsgate.com/ViewPoem.aspx?id=193960",""],[3856,"أثخَنتَ ذِكْرَ رَحِيلِهِم تَأوِيلَا","https://www.poetsgate.com/ViewPoem.aspx?id=215965",""],[5781,"جنونٌ على مراشِفِ الضَّوء","https://www.poetsgate.com/ViewPoem.aspx?id=198553",""],[5861,"جدال الروح","https://www.poetsgate.com/ViewPoem.aspx?id=190862",""],[5906,"عَدالة","https://www.poetsgate.com/ViewPoem.aspx?id=188215",""],[5906,"سُكَّر","https://www.poetsgate.com/ViewPoem.aspx?id=188224",""],[5906,"يا من بنظرة معجب","https://www.poetsgate.com/ViewPoem.aspx?id=188860",""],[5937,"مأوى العطور","https://www.poetsgate.com/ViewPoem.aspx?id=211811",""],[5956,"شكراً دعوتِ لطفلتي أن تشتفي","https://www.poetsgate.com/ViewPoem.aspx?id=202659",""],[5956,"يسري النسيمُ العذب في الصحراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205124",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6046,"الظمأ الرهيب","https://www.poetsgate.com/ViewPoem.aspx?id=35226",""],[6052,"ثمار الخير","https://www.poetsgate.com/ViewPoem.aspx?id=35377",""],[6152,"مجنون بهواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203733",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""],[6345,"محمد الدرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78674&r=&rc=45",""],[5567,"المجد بابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82078&r=&rc=131",""]],"verses":[["فكف نداها الجود والضرب بالوغى","وبأس بطبع فيه رقّت مخالد",0,"د",1,0],["فَكَفكِف عِنانَ الوَجدِ إِمّا تَعَزِّياً","وَإِمّا طِلاباً أَن يُقالَ حَمولُ",1,"ل",1,0],["فَكَفكَف صُدورَ السَمهَرِيِّ بِعَزمَةٍ","عَلى كُلِّ مَلآنٍ مِنَ الضِغنِ فاتِكِ",2,"ك",1,0],["فكَفَّ منْ غَرْبِها لمّا اسْتَقامَ بهِ","زَيْغُ الخُطوبِ وأجْلى العارِضُ الهَزِمُ",3,"م",1,0],["فَكَفى العَضاريطُ الرِكابَ فَبُدِّدَت","مِنهُ لِأَمرِ مُؤَمَّلٍ فَأَجالَها",4,"ل",3,0],["فَكُفرُ طَهَ عِندَ دَيّانِهِ","أَحَبُّ مِن إِسلامِ عَبدِ الحَميد",5,"د",1,0],["فَكَفكِفي مِن دُموعٍ","تَفري حُشاشَةَ فاني",6,"ي",1,0],["فَكَفَّ أَذاهُ عَنِ المُسلِمينَ","وَصَيَّرَ في بَيتِهِ أَكلَهُ",7,"ل",2,0],["فَكَفَّ مِن غَربِهِ وَالغُضفُ يَسمَعُها","خَلفَ السَبيبِ مِنَ الإِجهادِ تَنتَحِبُ",8,"ب",1,0],["فكَفَيْنا أصهارهم مؤنة العي","ش فكانوا ضِغثاً على إبّاله",9,"ل",2,0],["فَكَفَّ يَدَيهِ ثُمَّ أَغلَقَ بابَهُ","وَأَيقَنَ أَنَّ اللَهَ لَيسَ بِغافِلِ",10,"ل",1,1],["فكفى من وضوحِ حاليَ أنِّي","في زماني هذا من الأدباء",11,"ا",2,0],["فكفى الجانبين مصراً وشاماً","وأفاض العينينِ عدلاً ورِفدا",12,"د",2,0],["فكفّ دموع عينك عن بلادي","وإلاّ كن فتًى يمضي بلاده",13,"د",2,0],["فكفَّ منه بصراً","مثل السراج الواقدِ",14,"د",1,0],["فكفّيَ الدهرَ لا تنقى أناملها","من لحمك الغثِّ أو من عرضك الودِكِ",15,"ك",1,0],["فكفُّهُ كفُّ تقبيلٍ يُفازُ به","ووجهُه وجهُ إجلالٍ وإكرامِ",16,"م",1,0],["فكُفّا بالذي أبلى وعافى","عن المشغُولِ بالحُبِّ المَلاما",17,"م",2,0],["فَكُفِّنَ بِالصَوارِمِ وَالعَوالي","وَغُيِّبَ حَيثُ جالَ وَحَيثُ صالا",18,"ل",2,0],["فَكَفَت كَونَ فَرحَةٍ تورِثُ الغَم","مَ وَخِلٍّ يُغادِرُ الوَجدَ خِلّا",19,"ل",2,0],["فكفكفَ غربَهُ غَصّاتُ دهرٍ","تُديرُ عليه كاسات السِّمامِ",20,"م",1,0],["فَكَفاهُمُ فِسقَ المُوَحِّدِ أَن سَعى","فيهِم بِإِصلاحٍ وَشِركَ المُلحِدِ",21,"د",1,0],["فَكَفَت مِنهُمُ بُطونُ سِباعٍ","قُبِروا جَوفَها بُطونَ لُحودِ",22,"د",1,0],["فَكَفاكَ مِن شَرَفِ الرِياسَةِ أَنَّهُ","يَثني الأَعِنَّةَ كُلَّهُنَّ بِإِصبَعِ",23,"ع",1,0],["فكَفاه أن يَصِفَ الصبَّابةَ ناطقاً","دَمعٌ إذا وصفَ الصبَّابةَ أطنَبا",24,"ب",2,0],["فَكَفى بِمُلتَمِسِ التَواضُعِ رِفعَةً","وَكَفى بِمُلتَمِسِ العُلُوِّ سِفالا",25,"ل",2,0],["فكفَّ عزم كفاة صدقُ بأسِهِمُ","مستأصلٌ نِعَمَ الأعداءِ بالنقمِ",26,"م",1,0],["فَكَفَّ عَنهُ رَسولُ اللَّهِ وَهوَ بِهِ","أَدرى وَكَم نِقَمٍ تفتَرُّ عَن نِعَمِ",27,"م",1,0],["فَكفِّروا بانتخابِ الصّالحين لها","عمّا جنَى قومُنا بالأمس واقترفوا",28,"ف",3,0],["فَكَفُّوا غَيْرَ بَادِرَةِ لِبِشْرٍ","مَضَتْ قَدَراً لِرَبِّكَ أو قَضاءَ",29,"ا",2,0],["فَكَفَيتَ أَيِّمَهُم مُناها بِالغِنى","وَالناكِحينَ مُؤونَةَ الإِصهارِ",30,"ر",1,0],["فَكَفى بِهِ هَجراً لَنا وَلَكُم","أَنّي وَذَلِكَ فَاِعلَمي الهَجرُ",31,"ر",1,0],["فَكَفاكَها سَمحُ اليَدَي","نِ بِصالِحِ الأَخلاقِ ماهِر",32,"ر",1,0],["فَكَفَّرَ الناسُ سِواهُم عِندَهُ","فَلَعنَةُ اللَهِ عَلَيهِ وَحدَهُ",33,"ه",1,0],["فكفاكَ وَشكُ رَحيلِهِ عن أرْضِهِ","عن أن يكون العامَ منك رحيل",34,"ل",1,0],["فَكَفكَفَ مُنتَصِبَ المَنكِبَينِ","لِفَرطِ الشَهامَةِ وَالنَجدَه",35,"د",2,0],["فَكَفاني بُخلُ مَن يَخ","نُقُ حَلقَ الكيسِ خَنقا",36,"ق",2,0],["فَكَفكَفتُ مِني عَبرَةً فَرَدَدتُها","عَلى النَحرِ مِنها مُستَهِلٌّ وَدامِعُ",37,"ع",1,0],["فَكفَّ أُولي شُقرٍ جياداً ضَوامِرا","فَزَحزَحَها عَن مِثِلها أَن تَصَدَّرا",38,"ر",2,0],["فكفاه أن جاء ميتا فأحيا","وكفى مصر ذلك الإحياء",39,"ا",2,0],["فَكَفَى بِنَا فَضْلاً عَلَى مَنْ غَيْرِنَا","حُبُّ النَّبيِّ مُحَمَّدٍ إِيَّانَا",40,"ن",2,1],["فكُفِينا شرَّ انفصامٍ وبيلٍ","أيُّ داءٍ كالانقسام عُضال؟",41,"ل",1,0],["فكفكف دموع العين واجعل مياهها","طهوراً لذنب في الصحيفة يرقم",42,"م",1,0],["فكفاكها سمحُ اليد","نِ بِصَالحِ الأخْلاقِ ماهِرْ",43,"ر",1,0],["فكفَّ أذاهُ عنِ المسلمينَ","، وصَيَّر في بيتِهِ وأَكْلَهُ",44,"ل",2,0],["فكَفَاهُمُ فِسْقَ المُوَحِّدِ أنْ سَعى","فيهِمْ بإلإصلاح، وَشِرْكِ المُلحِدِ",45,"د",1,0],["فكفها عنه توحيدا لخالقها","فازداد فقها وما للغير لاهوت",46,"ت",1,0],["فكفانا أنَّا ابتدأنا وأنَّا","إن عَجَزنا فقد بدأنا نشاهد",47,"د",1,0],["فَكُفّوا خُفاقاً عَن سَفاهَةِ رَأيِهِ","وَصاحِبَهُ العَبّاسَ قَبلَ الدَهارِسِ",48,"س",1,0],["فَكُفَّ اللَّومَ إني حِبُّ خُودٍ","أهِيمُ بِهَا على صَحوي وسُكرِى",49,"ر",2,0],["فَكَفاني مَؤونَةَ الشَوقِ عَزمٌ","لا يَمَلُّ التَقويضَ وَالتَطنيبا",50,"ب",2,0],["فكفى بذاك عقوبة عن زلتي","الحلم أوسع والمراحم أقرب",51,"ب",1,0],["فَكُفَّ شُؤونَ الدَمعِ حَتّى تَحُثُّها","غَداً ثُمَّ تَهمي كَيفَ شاءَت وَتَسفَحُ",52,"ح",1,0],["فكَفَّ كَفَّ عوادِيها وأَمَّنَنى","منها وصَيَّرَ لي في ظله شانا",53,"ن",2,0],["فكفي قد خلت من كل مال","سوى قعي ومحبرتي وفالي",54,"ل",2,0],["فكفه كالماء في جوده","وقلبه كالماء في صفوه",55,"ه",1,0],["فكفّوا بنى التاميز عن نهب أنفس","تحاول أن تحيا مع الأنجم الزهرِ",56,"ر",1,0],["فكفّوا بني العبّاس عنا جِماحَكْم","فقد آن أن نغزو بكلّ مكان",57,"ن",1,0],["فَكَفُّ العَوارِفُ مَقبوضَةُ البَنانِ","وَوَجهُ النَدى أَربَدُ",58,"د",1,0],["فَكَفى الخِلافَةَ أَنَّكُم أَعضاؤُها","وَالمُلكَ فَخراً أَنَّكُم أَمجادُهُ",59,"د",2,0],["فَكَفَتْ وَكفَ الجُفون دَماً","حالَ تَسْبيحٍ وَتَسْبيلِ",60,"ل",1,0],["فكفَّ الكفرَ أَن يَطْغى بمَكْرٍ","يُحَيِّرُ كلَّ ذي فكرٍ وذهن",61,"ن",1,0],["فَكَفُّهُ البَحرُ فيهِ جَدوَلٌ وَبِهِ","نارٌ تَوَقَّدُ في الهَيجاءِ بِالشُّعَلِ",62,"ل",1,0],["فَكَفّاهُ كَفّا نائِبات نُيوبِهِ","وَلليُمنِ يُمناهُ وَلِليُسُرِ اليُسرى",63,"ر",2,0],["فكف ودع هذا التظاهر وارتدع","فما لك أبطال تسرك أو تفدي",64,"د",2,0],["فكفكفي يا ميُّ من","مدمعهِ المنسكب",65,"ب",1,0],["فَكَفَّهُ مَنهَلٌ يَروي العِطاشَ وَلَو","جازَ القِياسَ لَقُلنا البَحرَ نِسبَتُهُ",66,"ت",2,0],["فكفرك يا هذا كم اكلته","وتعذيب نار مثل جرعة غصة",67,"ه",1,0],["فكفاكَ عاديةَ العَدوِّ المُعْتدي","ووَقاكَ طارقةَ الخُطوبِ النُّزَّل",68,"ل",1,0],["فكَفُّه مشغولةٌ بالنَّدى","تُبيحُ ما تَملِكُ سُؤّالها",69,"ل",3,0],["فكفاكَ فَخْراً أن تُسَمِّيَه أباً","وكفاهُ فَخْراً أن تُعَدَّ سَليلا",70,"ل",2,0],["فكَفَّ كُلَّ يدٍ بالظّلمِ باسطةٍ","وقَرَّ كُلَّ حشاً للخَوفِ مُرتجِف",71,"ف",1,0],["فكِفايةُ اللهِ التي عُوِّدْتَها","تُفْنِي العَدُوَّ بها وإن لم تَقْصِد",72,"د",1,0],["فكفَتهُ أن يعتدَّ أبيضَ صارماً","ومثقَّفاً يوم الكريهةِ أسمَرا",73,"ر",2,0],["فكفيتُ منها ما كفَي","تُ لصَرفها عن حاسِدي",74,"د",2,0],["فَكففت لَما لَم أَجد","مِن يَستقيم عَلى وَتيره",75,"ر",2,0],["فَكَفوا الزَجر عَن عيس تَفانَت","وَخَروا كَالسُجود عَلى الصَعيد",76,"د",1,0],["فَكَفَفتُهُم دهراً وَقد نَفَّقتُهُم","إِلّا أَراذِلَ من ذَوي الأَذناب",77,"ب",1,0],["فكفّ النّبل مِنْ عينيكَ","يكفي بعضُ ما فَعَلاَ",78,"ل",2,0],["فكفر اعتقاد حكمه السفك للدما","وسبي الذراري وانتهاب ذوي الجحد",79,"د",1,0],["فكفى إلهي شرهم","فله الثنا ما عشت يُهْدَى",80,"د",2,0],["فكفُّه البحرُ لكن موجُهُ بِدَرٌ","وجودُه الغيثُ لكنْ وبْلُه نِعَمُ",81,"م",1,0],["فكفكفْتُ من عيني بوادر عبرة","وما خِلْتُها لولاه أنْ تتحدَّرا",82,"ر",2,0],["فكفيتَ يا عزَّ الكُفاةِ عوارضاً","حكمتْ بشيبِ عوارضٍ وعِذارِ",83,"ر",1,0],["فكَفى كلّ عاشقٍ مستهامِ","بصدودِ الحبيبِ والأشواقِ",84,"ق",1,0],["فَكَفْكَفْتَ الرَّدى عنِّي بِكَفٍّ","تُثيرُ الغيثَ فِي الغَيْمِ الجَهامِ",85,"م",1,0],["فكفى به شرفاً بأن المرتضى","جبريل خادمه وفي طاعاته",86,"ت",2,0],["فكفرت نعمتهم عليك وانما","بلد العبيد المقرفون عبيدا",87,"د",2,0],["فكفوا رياضته وذلل صعبه","ومضى بهامته الرسول بريدا",87,"د",2,0],["فكفيتَهم بمكيدةٍ ورويَّةٍ","جعلتْ ديارهُمُ تُرابَ القسْطلِ",88,"ل",1,0],["فكَفْكِفِ الدّمعَ يا منْ صارَ في الموْتى","أهلوهُ أو صحبُهُ أو حُلْمُهُ البحْتُ",89,"ت",1,0],["فكفَفْتُ عنها عفّةً وتورّعاً","عن وصمةٍ منها لعرضيَ تلحَقُ",90,"ق",1,0],["فَكُفَّ الكَفَّ عَن قَومي وَذَرهُم","فَسَوفَ يَرى فِعالَهُمُ الضَريرُ",91,"ر",1,0],["فكفكَفْتَ منها قبل حين طلوعها","وروّأتَ فيها قبلَ وَشْكِ اِنهجامِها",92,"م",3,0],["فكفّاك في تصريفها كعِنانِها","ورِجْلاك في إمساكِها كحِزامها",92,"م",3,0],["فكفر والخطا مع خوف كفر","وكذْب ثم سب في هوان",93,"ن",1,0],["فكفروا إذ 