3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59508","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35518","المنسرح"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102000","الرمل"],[4767,"عودة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=94471",""],[4816,"افلاطون","https://www.poetsgate.com/ViewPoem.aspx?id=8487",""],[4929,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=199526",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5219,"شمس الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=194905",""],[5284,"غيث الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=191798",""],[5447,"لا تقترب","https://www.poetsgate.com/ViewPoem.aspx?id=208298",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5652,"وتبقى لك العزوه عدود وعشاير","https://www.poetsgate.com/ViewPoem.aspx?id=190144",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5725,"شدوا الركائب","https://www.poetsgate.com/ViewPoem.aspx?id=201720",""],[5855,"ربما عارض القوافي رجال","https://www.poetsgate.com/ViewPoem.aspx?id=186857",""],[5956,"مع خيالها","https://www.poetsgate.com/ViewPoem.aspx?id=182067",""],[6056,"اقول معصي","https://www.poetsgate.com/ViewPoem.aspx?id=130136",""]],"verses":[["طاوَلوا الدَهرَ وَلَم يَبقَوا وَمَن","يَأمَنُ اللَيلَ عَلَيهِ وَالنَهارا",0,"ر",2,0],["طاوَعْتُ قَلْبي حينَ لجَّ لَجاجُهُ","في حُبِّهِمْ ولَوِ انْتَهى لنَهَيْتُهُ",1,"ت",2,0],["طَاوِلي كُلَّ رَايَةٍ وَأَعِزِّي","قَوْمَنَا سَرْمَداً عَلَى الأَقْوَامِ",2,"م",1,0],["طاوي الحَشا قَصَرَت عَنهُ مُحَرَّجَةٌ","مُستَوفَضٌ مِن بَناتِ القَفرِ مَشهومُ",3,"م",1,0],["طاولتَ عُلويَّ النجوم بهمةٍ","لا فاقداً عزماً ولا مكسالِ",4,"ل",1,0],["طاوَعتُمُ فيهِ العَدُوَّ وَكُنتُمُ","لَو شِئتُمُ في مَعزِلٍ وَقَرارِ",5,"ر",1,0],["طاوي الفؤاد ناشر الأظافر","يا عجباً منه لطاوٍ ناشرِ",6,"ر",1,0],["طاولتَ من لا أراك مُنْتصفاً","باعُك من شبره إذا شَبره",7,"ر",2,0],["طاوي المِعى لاحَهُ التَعداءُ صَيفَتَهُ","كَأَنَّما هُوَ في آثارِها سيدُ",8,"د",1,0],["طاوٍ أَزَلُّ كَسِرحانِ الفَلاةِ إِذا","لَم تُؤنِسِ الوَحشُ مِنهُ نَبأَةً خَتَلا",9,"ل",2,0],["طاوٍ كَأَنَّ دُخانَ الرِمثِ خالَطَهُ","بادي السَغابِ طَويلِ الفَقرِ مُكتَئِبِ",10,"ب",1,0],["طاوَعتُهُ بَعدَ ما طالَ النَجِيُّ بِهِ","وَظَنَّ أَنّي عَلَيهِ غَيرُ مُنعاجِ",11,"ج",1,0],["طاوَعَ مِن صَدرِها","أَيَّ قَوِيٍّ حَكَم",12,"م",1,0],["طاوَعَتني جَواهِرُ المَدحِ فيهِ","فَأَتَت في النِظامِ كَالأَسماطِ",13,"ط",1,0],["طاوَعتُ فيكَ تَفَرُّسي وَتَوَسُّمي","وَعَصَيتَ فيكَ مَلامَةَ العُذّالِ",14,"ل",1,0],["طاوَعتُ فيها واشِياً فَكأَنَّني","في صَرمِ ذاتِ الخالِ كُنتُ مُغَمِّضا",15,"ض",2,0],["طاولت فِرعونَ في سُلطانِه","وابتنت في تاجهِ المُلكَ الجُساما",16,"م",2,0],["طاوِل بِجَدِّكَ فَالأَقدارُ عُنوانُ","وَاِحكُم فَما لِصُروفِ الدَهرِ عِصيانُ",17,"ن",1,1],["طاوَلْتُهُ مِن عَزْمتي بمُضَمَّرٍ","أثْبَتُّ هَمِّي في قَرارَةِ كورِه",18,"ر",2,0],["طَاولَ النَّجْمَ عِزُّهُ وَعَلَى قَرْ","يَتِهِ كلُّ أَمِرِه مَقْصورُ",19,"ر",1,0],["طَاوِلْ فَمَا فَيْئُكَ إِلاَّ أُمَّةٌ","مِلءُ البِلاَدِ قَادَةً وَجُنْدا",20,"د",2,0],["طاوٍ مِنَ الماءِ خَميصُ الحَشى","قَد طَمَّعَ الناسَ وَلَم يَطمَعِ",21,"ع",1,0],["طاوعتُ في نجلائِهنّ صَبابتي","وعصَيتُ ما تَهْذي به نُصَّاحي",22,"ح",2,0],["طاوع الخنجر الأصمّ يديه","حين كادت يمينه لا تطيعه",23,"ع",2,0],["طَاوَعتُمُوهُ فَأصبَحتُم لَهُ رُسلاً","تَعصُونَ لِمَأمُورَاتِهِ الرُّسلا",24,"ل",2,0],["طاوِل بِهِمَّتِكَ الزَمانَ وَحيدا","فَأَرى مَداكَ عَلى الأَنامِ بَعيدا",25,"د",2,1],["طاوِل بِقَدرِكَ مَن عَلا مِقدارُهُ","فَأَرى العُلا فَلَكاً عَلَيكَ مَدارُهُ",26,"ر",2,1],["طاوَع شيطانَه فَتيًّا","وحارَب اللهَ حين شابا",27,"ب",2,0],["طاووس حُسنٍ بل أتمُّ محاسناً","صنم الملاحة بل أجلُّ وألطفُ",28,"ف",1,0],["طاوعت فيه صبوتي وصبابتي","وعصيت فيه واشيا ومراقبا",29,"ب",2,0],["طاوٍ بِرَملَةِ أَورالٍ تَضَيَّفَهُ","إِلى الكِناسِ عَشِيٌّ بارِدٌ صَرِدُ",30,"د",1,0],["طاول التوبة مغرورا بما","يترجّى أتراه يرجأ",31,"ا",1,0],["طاوي المَصِيرِ على العَزّاءِ مُنْجَرِدٌ","بِالقَوْمِ لَيْلَةَ لا ماءٌ ولا شَجَرُ",32,"ر",1,0],["طاوَعت دُموعي وَهُنّ فيكَ وُشاة","وَاِنقَدت اِلى الحُبّ وَهو أَعظَم فَتان",33,"ن",1,0],["طاولَتْ مُدةُ الصِّيامِ شَكاتي","وعَراني من بَرْحِها ما عَراني",34,"ن",2,0],["طاوِعاني أَسكُبْ دُموعيَ سَكْباً","في رُباهُمْ فالصَّبْرُ مِمّا يُعاصي",35,"ص",2,0],["طاوع العاذل فيما رامه","وعلينا قد غدا عيناً وأذنا",36,"ن",2,0],["طاول الشمّ الرواسي في العلى","وجديرٌ في علاه أن يطولا",37,"ل",2,0],["طاول الأَيدي فطالت يده","ما على أيدي للعالم من يد",38,"د",1,0],["طاوَلَتْ هذه السماء بأيدٍ","قصّرت دونها يدا كل ظالم",39,"م",1,0],["طَاوَلْتُمُ في المَكْرُمَاتِ بِرَاحَةٍ","شَرُفَتْ فَلَمْ أَعْتَدَّ فيها خِنْصَرا",40,"ر",2,0],["طاوِعْ على القَصْفِ والعَزْ","ف كُلَّ حاسٍ وحاسِنْ",41,"ن",1,0],["طاويةٌ ما أبصرتْ وسمِعتْ","فالأرضُ بين عينِها والأذُنِ",42,"ن",1,0],["طاوياً كشحَ مَهيضٍ","ناشراً أنفاسَ شاكي",43,"ك",2,0],["طاوعَتْه الأَيَّامُ خوفاً فَلو حا","ول نقضاً لحوَّل البَعْدَ قَبْلا",44,"ل",2,0],["طاوَلتَ شَخصاً كريماً لا مثيل له","بالخلق والخلق والآداب والسيرِ",45,"ر",1,0],["طاول بِمِثل مُحَمَّدٍ وافخَر وَلا","تَفخَر بِعَظمٍ في التُّرابِ رَميمِ",46,"م",1,0],["طاوَعَتْ أَمرَهُ المَعاني فَلَم يَن","تَقِ مِنها سِوى البَديع الظّريفِ",47,"ف",1,0],["طاوِل بقومِك خيرَ قومٍ واِختبر","إنّ الجوادَ معقّب لحزونهِ",48,"ن",2,0],["طاول الرمحُ سيفَهُ","فانثنى الرمح وانهزم",49,"م",1,1],["طاوياً كشحاً على نُوَبٍ","سبحات لَسْنَ من وَطَرِهْ",50,"ر",2,0],["طاوَعْتُكُمْ فَعَصَيْتُمُ أَمْري","وحَفِظْتُكمْ فَأَضَعْتُمُ عُمْري",51,"ر",2,1],["طاوعَكَ الدَّهرُ فلا قُدْرَةٌ","للطير فيها أَنْ تُعاصِينا",52,"ن",2,0],["طاوِيَةً جَنبَيْ فُراعَ عَثجَلِ","يُخَبِّطُ الذائِدُ إِن لَم يَزحَلِ",53,"ل",1,0],["طاوَعت فيكَ الهَوى حَتّى عَصيت بِهِ","وَما رَكَنت إِلى عَم وَلا خالِ",54