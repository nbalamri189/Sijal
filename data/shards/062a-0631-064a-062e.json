{"poems":[[88,"كأني أرى في الليل نصلاً مجردا","https://www.aldiwan.net/poem10948.html","الطويل"],[90,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[53,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[30,"حوارية بين الفراتين دارها","https://www.aldiwan.net/poem5078.html","الطويل"],[30,"أرى ابن سليم يعصم الله دينه","https://www.aldiwan.net/poem5123.html","الطويل"],[30,"أتنسى بنو سعد جدود التي بها","https://www.aldiwan.net/poem5491.html","الطويل"],[82,"وذي أربع كخوافي العقاب","https://www.aldiwan.net/poem31532.html","المتقارب"],[30,"أتنسى بنو سعد جدود التي بها","https://www.poetsgate.com/ViewPoem.aspx?id=22083",""],[234,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[463,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[473,"ومما شجاني أن دهري أذلني","https://www.aldiwan.net/poem59785.html","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137590",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64787","الطويل"],[2081,"","https://poetry.dctabudhabi.ae/diwan/poem/146928","الطويل"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116653","الطويل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69448","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93671","الطويل"],[2908,"","https://poetry.dctabudhabi.ae/diwan/poem/145232","الطويل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107028","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65169","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65121","الطويل"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136890","البسيط"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130610","الطويل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99240","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116038","الطويل"],[4764,"حَضرة معاليك","https://www.poetsgate.com/ViewPoem.aspx?id=29533",""],[6111,"إني لأستحيي لتيم من التي","https://www.poetsgate.com/ViewPoem.aspx?id=186663",""],[463,"عسى معرضٌ وجههُ مقبلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60250&r=&rc=306",""],[6336,"من بعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73556&r=&rc=17",""]],"verses":[["تُرى خَدَعَتني العَينُ أَم كُنتُ مُبصِراً","وَهَذا دَمٌ أَم في شَباتِكَ نارُ",0,"ر",1,0],["ترى خُدوشاً على مُقَلَّدها","كأنها في صفيحة شُطَب",1,"ب",1,0],["ترى خيلُهُ علكَ الشكائم في الوغى","أجمَّ لها من رعيها في الفصافص",2,"ص",1,0],["ترى خرزاتِ المُلْكِ فوق جبينِهِ","تلوح عليه من فُرادَى ومن تُؤمْ",3,"م",1,0],["تَرَي خَطَأً مِمّا اِئتَمَرتِ وَتَضمَني","جَريرَةُ مَولى لا يُغَمِّضُ ثائِرُه",4,"ر",2,0],["تَرى خَيلَهُ غِبَّ الوَقيعَةِ أَصبَحَت","مُكَلَّمَةً أَعناقَها وَنُحورُها",5,"ر",3,0],["تَرى خَرَزاتِ المُلكِ فَوقَ جَبينِهِ","صَأولٌ شَبا أَنيابِهِ لَم يُفَلَّلِ",6,"ل",1,0],["ترى خضرَةَ الماء مشبوبَةً","بها حمرةُ النّار في صفحته",7,"ت",2,0],["تَرَى خَرَزَاتِ المُلْكِ فَوْقَ جَبينِهِ،","صَؤولٌ، شَبَا أنْيَابِهِ لمْ يُفَلَّلِ",8,"ل",1,0],["تَرَى خَجَل الخَدِّ مِثل المدام","إذا أظهر الحسنُ إخجالَها",9,"ل",3,0],["ترى خرزاتِ الملكِ فوق جبينه","كواكبَ نورٍ ضوءُها يملأ الفلا",10,"ل",2,0],["ترى خرزَ الملك من فوقها","مياسهم والناسُ قد أُغفلوا",11,"ل",3,0],["تَرى خَدَّهُ تَحتَ العِذارِ كَأَنَّهُ","كِتابٌ مِنَ الكافورِ عُنوِنَ بِالمِسكِ",12,"ك",1,0],["تَرى خَوارقَ في اِستنباطه عجباً","يردّها العقل لَولا شاهِدُ البصرِ",13,"ر",1,0],["ترى خير ما وضعته العقول","وأنشأت اليد صنعا ضخاما",14,"م",2,0],["تُرَى خيلُهُ دُهْماً وشُقْراً إِذا غَزا","مِن الدَّمِ حتى تُجْهَلَ الدُّهْمُ والشُقْرُ",15,"ر",1,0],["ترى خطباء القوم يوم ارتحاله","كأنهم الكروان أبصرن أجدلا",16,"ل",2,0],["ترى خَيلَهُم مَربُوطَةً بِقبَابِهِم","وَفشي كُلِّ قَلبٍ مِن سَنابِكِها وَقعُ",17,"ع",1,1],["تَرى خَلَفاً مِن كُلِّ نَيلٍ وَثَروَةٍ","سَماعَ قيانٍ عُودُهُنَّ قَريبُ",18,"ب",1,0],["تَرى خَلفه للأَدمُع الحُمر صبغة","كَأَن بِتلك الأَرض وَرد الشَقائق",19,"ق",1,0],["ترى خطباء الطير يدعون في الدجى","أناساً بهم وجد إلى اللهو والدد",20,"د",1,0],["ترى خباها أحرقته العدى","وثقلها صار لهم مغنما",21,"م",2,0],["ترى خلف معسول اللمى حية لها","تلوّ تُميت الصبّ من ألم اللسع",22,"ع",1,0],["ترى خلفهُ الأعلام والطبلُ ضاربٌ","على خفقها رعدٌ وبرقٌ على الإثر",23,"ر",1,0],["ترى خوافقه مثل النسور لها","من فوقهم زجل كالرعد في السحب",24,"ب",1,0],["ترى خدها بالارجوان مذهبا","ومبسمها بالاقحوان مفضضا",25,"ض",2,0],["ترى خَصْرَها يَعْيَا بحمل وشاحها","ويحملُ من كُثْبَانِ يَبْرِينَ أعْفَرَا",26,"ر",2,0],["ترى خلفَه من قادةِ النَّاسِ عسكراً","وقُدَّامَه من صادِق البأسِ عسكرا",27,"ر",2,0],["ترى خفوقي ينقصك لو تزيده","ويذل إحساسك ورِفعة معاليك",28,"ك",1,0],["ترى خربا ضخماً طويلاً وإنما","عصا خروع بين العمامة والنعل",29,"ل",1,0],["ترى خرزَ الملك من فوقها","مياسمَ والناسُ قد أغفلوا",30,"ل",3,0],["ترى خطرتْ مني ببالك خطرة","وقد شحطت بي أزمن وبقاع",31,"ع",1,0]]}