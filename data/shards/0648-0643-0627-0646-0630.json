{"poems":[[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[23,"إن أباك الرذل كان لصغرة","https://www.aldiwan.net/poem21405.html","الطويل"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"كان العزير زمانا","https://www.aldiwan.net/poem64057.html","المجتث"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[29,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[78,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[85,"قرد رأى الفيل على الطريق","https://www.aldiwan.net/poem8040.html","الرجز"],[28,"طرقت نوار ودون مطرقها","https://www.aldiwan.net/poem5126.html","الكامل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[52,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[50,"حذا خالد في فعله حذو برمك","https://www.aldiwan.net/poem62291.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55003","الكامل"],[88,"وصاحب قد دعانا ان نلمّ به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19574&r=&rc=77",""],[135,"عرضت على ذات الدلال صبابتي","https://www.aldiwan.net/poem49193.html","الطويل"],[185,"ميزت ساقط ما سرحت من شمطي","https://www.aldiwan.net/poem14712.html","البسيط"],[229,"بك أستزين إذا فخرت فاسبق","https://www.aldiwan.net/poem50924.html","الكامل"],[270,"هلا ثناك إلي قلب راض","https://www.aldiwan.net/poem35207.html","الكامل"],[303,"وكأن ذاك الخال راهب بيعة","https://www.aldiwan.net/poem57947.html","الطويل"],[348,"لا غرو أن صغرت عن قدرك الرتب","https://www.aldiwan.net/poem19862.html","البسيط"],[366,"أهذه سير في المجد أم سور","https://www.aldiwan.net/poem17202.html","البسيط"],[393,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[432,"سفحت عيون الغيث أدمع قطره","https://www.aldiwan.net/poem12612.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[575,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[587,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"]],"verses":[["وكأنّ ذاكَ الحِبْرَ منْ غسَقِ الدُجى","وكأنّ زُهْرَ نُجومِهِ أعْشارُهُ",0,"ر",2,0],["وَكانَ ذَليلاً مِن طَريدٍ مُلَعَّنٍ","فَسَمَّوهُ مِن بَعدِ الذَليلِ عَزيزا",1,"ز",2,0],["وكأنَّ ذاك الذكْر أسودُ يعْتري","منه سويداء الفؤاد سَوادُ",2,"د",1,0],["وكان ذاك لأني","لم أهدِ للشيخ أيري",3,"ي",1,0],["وكأن ذمّتك التي هي عِصمةٌ","ذِمَم الورى وكأنَّ حبلكَ أحبلُ",4,"ل",1,0],["وَكانَ ذَلِكَ مَقسوماً لِأَوَّلِهِم","وِراثَةً وَرِثوها عَن أَبٍ فَأَبِ",5,"ب",1,0],["وَكانَ ذَوو الهُدى ما بَينَ ثاوٍ","قَتيلٍ أَو فَقيدِ العَقلِ فانِ",6,"ن",1,0],["وكأن ذاك المجد مختفياً","عن الانظار سر",7,"ر",1,0],["وَكانَ ذاكَ القِردُ نِصفَ أَعمى","يُريدُ يُحصي كُلَّ شَيءٍ عِلما",8,"م",2,0],["وَكَأَنَّ ذُرَّعَها بِأَرحُلِنا","يُرقِلنَ مِثلَ نَعائِمٍ زُعرِ",9,"ر",1,0],["وكأنّ ذا سمعٌ وذا بصرٌ له","حَسَدتْهُما الأسْماعُ والأبصارُ",10,"ر",1,0],["وَكانَ ذا رَمَدٍ فَاِرتَدَّ ذا بَصَرٍ","بِنَفثَةٍ أَبرَأَت عَينَيهِ مِن وَرَمِ",11,"م",1,0],["وَكَأَنَّ ذا القَرنَينِ عوجِلَ سَدُّهُ","وَأَرادَ رَبُّكَ أَن يَحولَ فَحالا",12,"ل",2,0],["وَكَأَنَّ ذِفراها مُعَلَّقَةٌ","أَو لَبَّةٌ رُوِيَت مِنَ الدُهنِ",13,"ن",1,0],["وَكانَ ذَوو الآمالِ يُدعَونَ قَبلَهُ","بِلَفظٍ عَلى الإِعدامِ فيهِ دَليلُ",14,"ل",1,0],["وَكَأَنَّ ذَاكَ الرُّزْءَ قَبْلَ وُقُوعهِ","مِمَّا شَجَاهَا لَمْ يَكُنْ مُتَوَقَّعَا",15,"ع",2,0],["وكان ذلك في دار يَضيق بها","صدرُ الأغار يدمن ضيق ومن صِغر",16,"ر",1,0],["وكان ذووهم يبعثون لهم بما","يموّنهم في كل شهرين أو شهرِ",17,"ر",1,0],["وكان ذلك أَوْفَى ما وُعِظتُ به","لو كنت أرجع عن غىٍّ غلط",18,"ط",1,0],["وكأنّ ذا ياقوتُ عِقدٍ أحمرٍ","وكأنّ ذا ياقوتُ عِقدٍ أَزرقُ",19,"ق",1,0],["وكأن ذكرَك في بقيةِ مُهجتي","زهرُ الخريفِ على ذبولِ رياض",20,"ض",1,0],["وكأن ذاك الخال راهب بيعةٍ","في مسحه قطع الدجا متهجدا",21,"د",2,1],["وَكانَ ذاكَ لأَسبابٍ يَمُتُّ بها","لا خَيْرَ في رَفْعِ قَدْرٍ مَالَهُ سَبَبُ",22,"ب",1,0],["وَكانَ ذِكرُ اِسمِهِ فيهِ الحَياةُ لَنا","وَالذُخرُ إِنَّ الشُجاعَ الحَيَّةَ الذَكَرُ",23,"ر",1,0],["وَكانَ ذا كُلٍّ وَبَعضٍ ظاهِرِ","وَكانَ ذا حدٍّ من المَقادِرِ",24,"ر",1,0],["وكأنّ ذا الرعَثات يندُبُ إثْرَها","شجواً أثارَ البينَ سالفُ ذكرِه",25,"ر",2,0],["وكان ذاك بينهم أمرا عقد","فقصدا إليه ممن قد شهد",26,"د",1,0],["وكان ذاك الشيء في يدي أحد","ما كنت تقضي بيننا إذا جحد",26,"د",1,0],["وكان ذاك من ولي النعمة","حياطة لدينه ورحمة",26,"ه",1,0],["وكان ذا رزق ونيرنجات","وذا مخاريق وذا شبهات",26,"ت",1,0],["وكان ذا لاقى بِحَدَّيْ صَريمة","رآنيَ سَيْفاً في الرقاب مُجرَّبَا",27,"ب",2,0],["وكانَ ذاك الثَّغْر معْ أَهْلِه","وقبلَ أَن يَحْضُره في احتِضَارْ",28,"ر",1,0],["وكان ذا عفة عن كل مظلمة","وكل فاحشة تدعو لآثام",29,"م",1,0]]}