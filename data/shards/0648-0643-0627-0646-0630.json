{"poems":[[79,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[23,"إن أباك الرذل كان لصغرة","https://www.aldiwan.net/poem21405.html","الطويل"],[53,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[53,"كان العزير زمانا","https://www.aldiwan.net/poem64057.html","المجتث"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[31,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[80,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[91,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[87,"قرد رأى الفيل على الطريق","https://www.aldiwan.net/poem8040.html","الرجز"],[30,"طرقت نوار ودون مطرقها","https://www.aldiwan.net/poem5126.html","الكامل"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[54,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[52,"حذا خالد في فعله حذو برمك","https://www.aldiwan.net/poem62291.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55003","الكامل"],[90,"وصاحب قد دعانا ان نلمّ به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19574&r=&rc=77",""],[139,"عرضت على ذات الدلال صبابتي","https://www.aldiwan.net/poem49193.html","الطويل"],[189,"ميزت ساقط ما سرحت من شمطي","https://www.aldiwan.net/poem14712.html","البسيط"],[234,"بك أستزين إذا فخرت فاسبق","https://www.aldiwan.net/poem50924.html","الكامل"],[275,"هلا ثناك إلي قلب راض","https://www.aldiwan.net/poem35207.html","الكامل"],[308,"وكأن ذاك الخال راهب بيعة","https://www.aldiwan.net/poem57947.html","الطويل"],[353,"لا غرو أن صغرت عن قدرك الرتب","https://www.aldiwan.net/poem19862.html","البسيط"],[371,"أهذه سير في المجد أم سور","https://www.aldiwan.net/poem17202.html","البسيط"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[438,"سفحت عيون الغيث أدمع قطره","https://www.aldiwan.net/poem12612.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[580,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[592,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82804","البسيط"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138980",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66751","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104546","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37874","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77587","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77625","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77509","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77646","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77622","الرجز"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145615","البسيط"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126568","البسيط"],[1213,"","https://poetry.dctabudhabi.ae/diwan/poem/147777","المجتث"],[1335,"","https://poetry.dctabudhabi.ae/diwan/poem/198660",""],[1471,"","https://poetry.dctabudhabi.ae/diwan/poem/18372","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123088","البسيط"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131322","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27964","السريع"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126195","الرجز"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137150",""],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110835","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87501","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112691","الرجز"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203551","الرجز"],[3705,"","https://poetry.dctabudhabi.ae/diwan/poem/145361","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131023",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86502","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70171","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125838","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81710","البسيط"],[703,"","https://poetry.dctabudhabi.ae/diwan/poem/122947","البسيط"],[5038,"النحر الخضيب","https://www.poetsgate.com/ViewPoem.aspx?id=196698",""],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5213,"تأن ناعيه على القوم قد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=170422",""],[5409,"غنت وتابعت الغناء بجسها","https://www.poetsgate.com/ViewPoem.aspx?id=155517",""],[5444,"أمة الخيرية","https://www.poetsgate.com/ViewPoem.aspx?id=185388",""],[5997,"السماء","https://www.poetsgate.com/ViewPoem.aspx?id=214213",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["وكأنّ ذاكَ الحِبْرَ منْ غسَقِ الدُجى","وكأنّ زُهْرَ نُجومِهِ أعْشارُهُ",0,"ر",2,0],["وَكانَ ذَليلاً مِن طَريدٍ مُلَعَّنٍ","فَسَمَّوهُ مِن بَعدِ الذَليلِ عَزيزا",1,"ز",2,0],["وكأنَّ ذاك الذكْر أسودُ يعْتري","منه سويداء الفؤاد سَوادُ",2,"د",1,0],["وكان ذاك لأني","لم أهدِ للشيخ أيري",3,"ر",2,0],["وكأن ذمّتك التي هي عِصمةٌ","ذِمَم الورى وكأنَّ حبلكَ أحبلُ",4,"ل",1,0],["وَكانَ ذَلِكَ مَقسوماً لِأَوَّلِهِم","وِراثَةً وَرِثوها عَن أَبٍ فَأَبِ",5,"ب",1,0],["وَكانَ ذَوو الهُدى ما بَينَ ثاوٍ","قَتيلٍ أَو فَقيدِ العَقلِ فانِ",6,"ن",1,0],["وكأن ذاك المجد مختفياً","عن الانظار سر",7,"ر",1,0],["وَكانَ ذاكَ القِردُ نِصفَ أَعمى","يُريدُ يُحصي كُلَّ شَيءٍ عِلما",8,"م",2,0],["وَكَأَنَّ ذُرَّعَها بِأَرحُلِنا","يُرقِلنَ مِثلَ نَعائِمٍ زُعرِ",9,"ر",1,0],["وكأنّ ذا سمعٌ وذا بصرٌ له","حَسَدتْهُما الأسْماعُ والأبصارُ",10,"ر",1,0],["وَكانَ ذا رَمَدٍ فَاِرتَدَّ ذا بَصَرٍ","بِنَفثَةٍ أَبرَأَت عَينَيهِ مِن وَرَمِ",11,"م",1,0],["وَكَأَنَّ ذا القَرنَينِ عوجِلَ سَدُّهُ","وَأَرادَ رَبُّكَ أَن يَحولَ فَحالا",12,"ل",2,0],["وَكَأَنَّ ذِفراها مُعَلَّقَةٌ","أَو لَبَّةٌ رُوِيَت مِنَ الدُهنِ",13,"ن",1,0],["وَكانَ ذَوو الآمالِ يُدعَونَ قَبلَهُ","بِلَفظٍ عَلى الإِعدامِ فيهِ دَليلُ",14,"ل",1,0],["وَكَأَنَّ ذَاكَ الرُّزْءَ قَبْلَ وُقُوعهِ","مِمَّا شَجَاهَا لَمْ يَكُنْ مُتَوَقَّعَا",15,"ع",2,0],["وكان ذلك في دار يَضيق بها","صدرُ الأغار يدمن ضيق ومن صِغر",16,"ر",1,0],["وكان ذووهم يبعثون لهم بما","يموّنهم في كل شهرين أو شهرِ",17,"ر",1,0],["وكان ذلك أَوْفَى ما وُعِظتُ به","لو كنت أرجع عن غىٍّ غلط",18,"ط",1,0],["وكأنّ ذا ياقوتُ عِقدٍ أحمرٍ","وكأنّ ذا ياقوتُ عِقدٍ أَزرقُ",19,"ق",1,0],["وكأن ذكرَك في بقيةِ مُهجتي","زهرُ الخريفِ على ذبولِ رياض",20,"ض",1,0],["وكأن ذاك الخال راهب بيعةٍ","في مسحه قطع الدجا متهجدا",21,"د",2,1],["وَكانَ ذاكَ لأَسبابٍ يَمُتُّ بها","لا خَيْرَ في رَفْعِ قَدْرٍ مَالَهُ سَبَبُ",22,"ب",1,0],["وَكانَ ذِكرُ اِسمِهِ فيهِ الحَياةُ لَنا","وَالذُخرُ إِنَّ الشُجاعَ الحَيَّةَ الذَكَرُ",23,"ر",1,0],["وَكانَ ذا كُلٍّ وَبَعضٍ ظاهِرِ","وَكانَ ذا حدٍّ من المَقادِرِ",24,"ر",1,0],["وكأنّ ذا الرعَثات يندُبُ إثْرَها","شجواً أثارَ البينَ سالفُ ذكرِه",25,"ر",2,0],["وكان ذاك بينهم أمرا عقد","فقصدا إليه ممن قد شهد",26,"د",1,0],["وكان ذاك الشيء في يدي أحد","ما كنت تقضي بيننا إذا جحد",26,"د",1,0],["وكان ذاك من ولي النعمة","حياطة لدينه ورحمة",26,"ه",1,0],["وكان ذا رزق ونيرنجات","وذا مخاريق وذا شبهات",26,"ت",1,0],["وكان ذا لاقى بِحَدَّيْ صَريمة","رآنيَ سَيْفاً في الرقاب مُجرَّبَا",27,"ب",2,0],["وكانَ ذاك الثَّغْر معْ أَهْلِه","وقبلَ أَن يَحْضُره في احتِضَارْ",28,"ر",1,0],["وكان ذا عفة عن كل مظلمة","وكل فاحشة تدعو لآثام",29,"م",1,0],["وَكانَ ذا المحجر المَشنوء تَسكنه","دَعجاء مرسلة الأَهداب حَوراء",30,"ا",2,0],["وكأن ذاك النهر فيه معصم","بيد النسيم منقش ومكتب",31,"ب",1,0],["وكان ذا في إمارات الإمامِ وما","يَزالُ يجمَعُها فيه مشرِّفُهُ",32,"ه",1,0],["وكانَ ذِكرُكَ نُصبي لا يُزايلُني","مستقبلُ الحظِّ مِن نجواهُ كالماضي",33,"ض",2,0],["وَكان ذو المالِ يا ذا اللُّبِّ يفضلُهُ","وَلَو غَدا كافِراً بِالكفرِ مَبهولا",34,"ل",2,0],["وَكانَ ذاكَ في غِيابِ الأَرنَبِ","مُذ راحَ يَرجو أَكلةً مِن عنب",35,"ب",1,0],["وَكانَ ذا في مَولد لِلسَيِّدِ","قُطب الرِجال البَدويِّ الأَحمَدي",36,"ي",1,0],["وَكانَ ذا في ساعة الزَوال","وَالشَمس في غاية الاشتعال",37,"ل",1,0],["وَكانَ ذا في لَيلَةٍ ذات قَمر","لا غَيمَ في سَمائِها وَلا مَطَر",38,"ر",1,0],["وَكانَ ذا مِن شدة اِحتِراسهم","وَحَصرهم لِمُخِّهم في راسهم",38,"م",1,0],["وَكانَ ذا البَوابُ كَلباً جارِحا","حينَ رَآه الذئب وَلى رامحا",39,"ح",2,0],["وكان ذا وعدا علىّ جاري","لو كان هذا الامر باختياري",40,"ي",1,0],["وكان ذا الدهر قد كساني","برد صباً ماؤه نمير",41,"ر",1,0],["وكان ذلك منه أصل سلوته","والعزم في الأمر مما يعقب الضفرا",42,"ر",2,0],["وكان ذلك عندي","يفوق كل الأماني",43,"ن",2,0],["وكأن ذا وعد وذا إنجازه","وكأنني من بينهم مطل",44,"ل",1,0],["وَكانَ ذا خُلُقٍ لا دينَ يَخلِطُهُ","فَأَصبَحَ اليَومَ لا دينٌ وَلا خُلُقُ",45,"ق",1,0],["وكان ذا أسعد الأيام يا أملي","وكيف لا وبه جاءت سعادات",46,"ت",1,0],["وكان ذاكَ الشّخْصُ في أَمانِ","ما دامَ ذاكَ الثَّوْبُ في الزَّمانِ",47,"ن",1,0],["وكان ذا رأي وذا فطنةٍ","فعل اللبيب الحذر الحازم",48,"م",1,0],["وكان ذا سَمت وزُهد وتُقَى","كذا تَجَمّل وصَمت ونَقى",49,"ق",2,0],["وكان ذا عبادة مذكوره","وصورةٍ صالحةٍ مشكوره",50,"ه",1,0],["وكان ذا سياسة وعقل","وفطنة كاملة وفضل",50,"ل",1,0],["وكأن ذكرك وهو فواح الشذا","في كل قطر روضة ميناف",51,"ف",1,0],["وَكان ذا مِن هِمَّة الوَزير","صاحِب عَزم كامِل غَفيرِ",52,"ر",1,0],["وكان ذخيرتي فيها وكنزي","وكان هدايتي عند الضلالِ",53,"ل",1,0],["وَكأَنَّ ذا كأسٌ مبرَّدةٌ لَهُ","بعد العنا وَالسير منهُ والسُرى",54,"ر",2,0],["وكان ذاك السم سما مردي","أرسله لذلك ابن هند",55,"د",1,0],["وكان ذا جذب وكشف خارق","قد شاع في الغرب وفي المشارق",56,"ق",1,0],["وكان ذا كشف صحيح خارق","مع تصرف بعزم صادق",56,"ق",1,0],["وكان ذا زهد وعلمٍ وعملْ","صحيتُه عشرين عاماً في مَهَل",57,"ل",1,0],["وكأنَّ ذاك السُّورَ مقعدُ نزهةٍ","وكأنه متشوفٌ من طاقِ",58,"ق",1,0],["وكان ذا علم وذا أناة","مقتدياً بآله الهداة",59,"ه",1,0],["وكان ذا بأس وذا دهاء","وبسطة في العلم والذكاء",60,"ا",2,0],["وكان ذا غزو وذا حروب","في الروم لا يبقي على الدروب",60,"ب",1,0],["وكان ذا حسن وذا جمال","بين شباب راق واكتمال",60,"ل",1,0],["وكان ذووه قد رأوا من فتاته","مظاهر لطف انزلتها على الرحب",61,"ب",1,0],["وَكَأَنَّ ذاكَ اليَومَ أَصبَحَ ذابِلاً","بانَ النَقا جَزعاً وَضالَ الوادي",62,"د",2,0],["وَكانَ ذا غيرَةٍ غراء ما نتئَت","الفاظه مثل حدِّ الصارم الذكرِ",63,"ر",1,0],["وكأَن ذُرِّياتِهِ","في البحر قد ذهبت سدى",64,"د",2,0],["وكان ذاك عقب الزيادة","من دجلةٍ على خلاف العادة",65,"ه",1,0],["وكان ذا النور مكنوزا وليس يرى","قبل الظهور ولم يعرف مسماه",66,"ا",2,0],["وكانَ ذو الحلم قد أوصى مُنَبِّهه","فكان للرُّشد يَهديه إذا فزعا",67,"ع",2,0],["وكان ذاك ورد اللَه حاسدنا","بغيظه لم ينل مأموله فينا",68,"ن",2,0],["وَكَأَنَّ ذِكْرَكَ في الْخُلودِ خَريدَةٌ","إِنْ زاحَمَتْ فيهِ الْعُصورَ عُصورُ",69,"ر",1,0],["وكأن ذرتك التي استخدمتها","جل القضاء , هي القضا المقدور",70,"ر",1,0],["وكان ذكرك في النادي يزان به","ويملأ الفم منه أينما ذهبوا",71,"ب",3,0],["وكأن ذاك الصوت موج بحيرةٍ","تعلو وتهبط من على ضفتيها",72,"ي",3,0],["وكأن ذاكَ الليل أحلك ليلة","فيها الرصاصُ يفيض بالظلماء",73,"ا",2,0],["وَكَأَنَّ ذَاكَ النُّورَ بحُرٌ حَاطَهَا","في مَشْهَدٍ أَوْحَى وَذَاتِيَ سَطَّرتْ",74,"ت",1,0],["وكان ذكرك في التاريخ ذا ألقٍ","كالشمس ما حملت أضواءه الكتب",75,"ب",1,0]]}