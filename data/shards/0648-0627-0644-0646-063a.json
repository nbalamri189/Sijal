{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54715","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133814","السريع"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98111","المجتث"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[5150,"رجل برسم الحب ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203782",""],[5277,"ما عُدْتُ أقولُ: متى غدُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=200888",""]],"verses":[["والنَغمُ الفرحان","يلهو بقيثاره",0,"ه",1,0],["وَالنَّغَمُ الحُلُو فِي نِظَامٍ","كُلُّ رَوِيٍّ مِنْهُ نَشِيدُ",1,"د",1,0],["والنغم الخالد ما تنشده","والمثل الشارد ما تبتكر",2,"ر",1,0],["والنغمَ الهاربَ إذ ينجلي","والنسمَ المعتزِمَ الغاديا",3,"ي",2,0],["والنَّغلُ أَفطَنُ شيءٍ","إِلى حروف المعاني",4,"ي",1,0],["وَالنِغضُ مِثلَ الأَجرَبِ المُدَجَّلِ","حَدائِقَ الأَرضِ الَّتي لَم تُحلَلِ",5,"ل",1,0],["والنغمُ الراقصُ في لحني","يؤْرقُ حزني دونَ السلوى",6,"و",2,0],["والنّغمةُ في أُذُني جذْلى","وظلامُ الليلِ تُبَدِّدُهُ",7,"د",2,0]]}