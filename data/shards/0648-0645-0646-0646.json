,1,0],["وَمَن نَهَشَت أَسِنَّةُ آلِ كَعبٍ","فَلا دِرياقَ لِلرَجُلِ النَهيشِ",3,"ش",1,0],["وَمِنُ نَكَدِ الأيّامِ أَنْ يَبْلُغَ المُنَى","أَخُو اللُّؤمِ فِيها وَالكَرِيمُ يَخيبُ",4,"ب",1,0],["ومَنْ ناوَل الإخوانَ حبلاً مَشى البِلى","إِلى طَرَفَيْهِ هَمَّ أن يتقَطَّعا",5,"ع",2,0],["ومَن نُرجّيهِ للدُنيا ونَمدَحُهُ","فأنتَ تُمدَحُ للدُّنْيا وللدينِ",6,"ن",1,0],["وَمَن نَزَلَت بِساحَتِهِ المَنايا","فَلا أَرضٌ تَقيهِ وَلا سَماءُ",7,"ا",2,0],["ومِنْ نظْرَةٍ دلّتْ على جَفْنِيَ البُكا","ومِنْ خطْرَةٍ قادَتْ الى قلْبِيَ الخَبْلا",8,"ل",2,0],["ومن نِسْوَةٍ أضحَتْ أيامَى حَواسِراً","تُعايِنُ في أعْوانِها الوَهْنَ والضَّعْفا",9,"ف",2,0],["وَمَنْ نُورِكَ الْوَضَّاحِ فِي الْعَالَمِ اهْتَدَى","غَدَاةَ اقْتَدَى صَدِيقُهُ وَحَكِيمُهُ",10,"م",2,0],["وَمِن نَسجِ داوُودَ مَوضونَةً","تُساقُ مَعَ الحَيِّ عيراً فَعيرا",11,"ر",2,0],["وَمِن نَشرِها ما حُمِّلَت مِن أَمانَةٍ","وَمِن وَأيِها بِالوَعدِ ثُمَّ اِنتِقالِها",12,"ل",3,0],["ومن نقص ظل الشمس تزداد رفعةً","إلى أن تُرى والظل في الشرق مائلُ",13,"ل",1,0],["ومن نَسَبَ الفتح المبين ولادة","إليه بغير الفخر لم يتأسَّسِ",14,"س",1,0],["ومن نام في ليل الشباب ضلالةً","سيوقظه صبحُ المشيب إلى الرشدِ",15,"د",1,0],["ومن نسيم طيّ هبّاته","تسمع أذني للهوى نجوى",16,"ج",3,0],["ومن نظر الدنيا وجرّب أهلها","رأى الغدر من أشداقّها يتحلّب",17,"ب",1,0],["ومن نظر الدنيا بعين اعتباره","تساوت مُهود عنده ونعوش",18,"ش",1,0],["ومن نفحات الشعر ترجيع مطرب","تعاور مَجرى صوته الخفض والنبر",19,"ر",1,0],["ومن ناله صبحُ المشيبِ ولم يفقْ","إلى طلب الأخرى فما وهب من كرى",20,"ر",2,0],["ومِنْ نكبةٍ لاقيتُها بعد نكبةٍ","رَهِبتُ اعتساف الأرضِ ذاتِ المناكبِ",21,"ب",1,0],["ومَن نشرها مِسْكٌ وألحاظها سحرُ","ومَبسِمُها درٌّ وريقتها خمر",22,"ر",1,0],["ومن ندى كفيك جاد الشرى","شؤبوب ذاك الراعد البارق",23,"ق",1,0],["ومن نَبلك المرسلات التي","صوائبها في الرمايا نسق",24,"ق",1,0],["ومن نكد الدنيا إذا ما تنكرتْ","أمورٌ وإن عُدَّت صغاراً عظائمُ",25,"م",1,1],["وَمَن نالَ مِنهُ السَيف وَهوَ مُجَرَّدٌ","تَهَيَّبَ أَن يَرنو إِلى السَيفِ مُغمَدا",26,"د",2,0],["ومن ناشج يبكي وآخر جازع","وآخر مغتاظ على الدهر حارد",27,"د",1,0],["وَمِن نَباتٍ عاشَ كَالبَبَّغا","وَهوَ عَلى الحائِطِ غَضٌّ نَدي",28,"د",2,0],["وَمَن نَسِيَ الفَضلَ لِلسابِقينَ","فَما عَرَفَ الفَضلَ فيما عَرَف",29,"ف",1,0],["وَمِن نَكَدِ الدُنيا عَلى الحُرِّ أَن يَرى","عَدُوّاً لَهُ ما مِن صَداقَتِهِ بُدُّ",30,"د",1,0],["ومن نسليهما صبغ","بطول السحق والهدمِ",31,"م",1,0],["ومن نسجِ الربيعِ محبَّراتٌ","تأنَّقَ في حواشيها الغَمامُ",32,"م",1,0],["ومن نشوةِ الكَرَمِ المُقْتَنى","لديك يُجَدَّدُ عهدُ الشبابْ",33,"ب",1,0],["وَمِن نائِلٍ ما تَدَّعي مِثلَ صَوبِهِ","إِذا جادَ أَكبادُ الغَمامِ الصَوائِبِ",34,"ب",1,0],["وَمَن نَفَرٍ فَوقَ الجُذوعِ كَأَنَّهُم","إِذا الشَمسُ لاحَتهُم حَرابِيُّ تَنضُبِ",35,"ب",1,0],["وَمِن نِعَمِ اللَهِ لا شَكَّ فيهِ","بَقاءُ البَنينَ وَمَوتُ البَناتِ",36,"ت",1,0],["وَمَن نَسِيَ البُقيا فَلَستَ لِفَضلِها","بِناسٍ وَلا مِن مُرتَجيها بِنازِحِ",37,"ح",1,0],["وَمِن نَعماءَ يَحسُدُني عَلَيها","أَداني أُسرَتي وَذَوُو وِدادي",38,"ي",1,0],["وَمِن نَكَدِ الأَيّامِ إيباءُ حِلَّةٍ","عَذاةِ النَواحي بَينَ كوثى وَصَرصَرِ",39,"ر",1,0],["وَمِن نِعمَةٍ في مَعشَرٍ لَو دَفَعتَها","عَلى جَبَلٍ لَاِنهَدَّ مِن فادِحِ الثِقلِ",40,"ل",1,0],["وَمَن نَجّى مِنَ الغَمَراتِ نوحاً","وَأَرسى في مَواضِعِها الجِبالا",41,"ل",2,0],["وَمَن نَطَقَت تَوراةُ موسى بِفَضلِهِ","وَجاءَ بِهِ إِنجيلُها وَزَبورُها",42,"ر",3,0],["وَمِن نَظرَةٍ بَينَ السُجوفِ عَليلَةٍ","وَمُحتَضَنٍ شَختٍ وَمُبتَسَمٍ بَردِ",43,"د",1,0],["وَمَنْ نَظَرَ الدنيا بما هي أهلُهُ","أرتْهُ الرضى كالسخطِ والسخطَ كالرضى",44,"ض",2,0],["ومَنْ نشأَ بين الحمير والجلبْ","كيفَ يكونُ قاضياً على حلبْ",45,"ب",1,0],["ومِنْ \"ناثراتٍ\" عليكَ المساءَ","والصُّبْحَ بالشَّعْرِ والأدْمُعِ",46,"ع",1,0],["وَمِن نَكَدِ الدَهرِ أَن يَستَعينَ","بِكَيدِ العِظاتِ وَظُلمِ العِبَرْ",47,"ر",1,0],["وَمِن نَسلِهِ السامي أَبوالفَضلِ يوسُفُ ال","لَذي أَشبَعَ الأَسباطَ قَمحَ السَنابِلِ",48,"ل",1,0],["وَمِن نُفوذِ الفِكرِ في القُلوبِ","وَمِن رُجوعِ لَحظَةِ المُريبِ",49,"ب",1,0],["وَمِن نَعتِ الدِيارِ وَوَصفِ رَبعٍ","تَلوحُ بِهِ عَلى القِدَمِ الرُسومُ",50,"م",1,0],["ومن نفثِ الحروب وطعن رمح","وصبر عند تجريد الحسام",51,"م",1,0],["وَمِن نَكَدِ الأَيّامِ عَلَّقَني الهَوى","بِذاتِ الثَناءِ الغَمرِ وَالنائِلِ الحَفدِ",52,"د",1,0],["وَمِن نَكَدِ الأَيّامِ سيقَت لِعانِسٍ","مِنَ اللُؤمِ لا يَندى وَلا يَتَبَلَّجُ",53,"ج",1,0],["وَمن نتائجها أن خاب موقدها","وأن تحررت الأقوام والأمم",54,"م",1,0],["وَمن نَسيم الصبا أن لا يصافحني","ومن أريج الحمى أن لا يُحييني",55,"ي",1,0],["وَمِنْ نَاظِمٍ لِلمُلْكِ تاَجَ فَرَائِدٍ","مِنَ المَدْحِ تِيجَانُ المُلوكِ لَهُ فِدَى",56,"د",2,0],["ومنَ نَكَد الأيام: أن يحسب امرؤٌ","أبرَّ بني مصرٍ على مصرَ جانيا",57,"ي",2,0],["ومن نسوة أضحت أيامى حواسرا","يعاين في أعيانها الوهن والضعفا",58,"ف",2,0],["ومن نظرة دلت على جفني البكا","ومن خطرة نادت إلى قلبي الخبلا",59,"ل",2,0],["ومن نسمات الصبح روحٌ جديدة","بعثتم بها لي قبل منَبلجِ الصبح",60,"ح",1,0],["ومن ندي البتول سقي حليبا","تيقن طول سؤدده فطالا",61,"ل",2,0],["ومن نصَرَ الدين القويمَ بسيفِه","وزانَتْ به الدنيا وأورق عودُها",62,"د",3,0],["ومن نظر المحاسن من قطامِ","تخرق بالصبابة والغرام",63,"م",1,0],["ومِن نِظام المُلك لي جُنَّةٌ","حصينةٌ ما مثلُها واقِ",64,"ق",1,0],["وَمِن نَفائِسِ ما قَد كانَ مُمتَطِياً","جُردٌ يَعِزُّ عَلَيها الغَزوُ وَالقَفَلُ",65,"ل",1,0],["وَمَن نَبَذتَ إِلَيهِ ذِكرَ مَوجِدَةٍ","فَقَد جَعَلتَ إِلَيهِ لِلرَدى لَقَما",66,"م",2,0],["ومن نطقت بفطرته","يقيناً هذه الفطر",67,"ر",1,0],["ومن نعم المولى علينا خليفةً","تَيَسَّر منها لاحقا إِثر سابق",68,"ق",1,0],["ومن نام منهم قام يمسح عنقه","يقول أراني الحرّ فيها مناميا",69,"ي",2,0],["وَمِن نَسلِ عَبدٍ فِتيَةٌ أَيُّ فِتيَةٍ","يُجِلُّ المُعادي بَأسها فَيهابُها",70,"ب",3,0],["وَمِن نَسلِ جَدَّيكَ العَلِيَّينِ غِلمَةٌ","نَشَت وَبِأَبكارِ المَعالي غَرامُها",71,"م",3,0],["ومن نَكَدِ الأيامِ فرقةُ موطنٍ","نَأَى فنأى عنه الصديقُ المُطاوع",72,"ع",1,0],["وَمِن نحوِ عامٍ جاءَني فنصحتهُ","كَما تنصحُ الثعبانَ أو تنصحُ الفأرا",73,"ر",2,0],["وَمِن نورهِ كلُّ العوالمِ أَشرقت","وَلَو شاءَ لَم تُشرق ولا فجَرَ الفجرا",74,"ر",2,0],["وَمِن نورهِ كانَ الوجودُ بأسرهِ","وَلولاهُ ما بانَت حقيقة سرّهِ",75,"ه",1,0],["ومن نظرةٍ ترتدُ من وجهِ نظرةٍ","كما