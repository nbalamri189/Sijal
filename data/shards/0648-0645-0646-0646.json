{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"لتبد اليوم نسوة آل كعب","https://www.aldiwan.net/poem30180.html","الوافر"],[63,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[63,"أهذه خطرات الربرب العين","https://www.aldiwan.net/poem46216.html","البسيط"],[57,"دع الأيام تفعل ما تشاء","https://www.aldiwan.net/poem24737.html","الوافر"],[77,"تذكرت عهدا للشباب الذي ولى","https://www.aldiwan.net/poem35727.html","الطويل"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[35,"ألا يا لقومي للنوى وانفتالها","https://www.aldiwan.net/poem39092.html","الطويل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[83,"أدرها ثلاثا من لحاظك واحبس","https://www.aldiwan.net/poem54280.html","الطويل"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[88,"إلى كم تصب الدمع عيني وتسكب","https://www.aldiwan.net/poem44399.html","الطويل"],[88,"أرى عيشنا تأبى المنون امتداده","https://www.aldiwan.net/poem45059.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[72,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"أحباءنا ما كان لي عنكم صبر","https://www.aldiwan.net/poem64074.html","الطويل"],[51,"قد كان من رأب الصدوع التي","https://www.aldiwan.net/poem65512.html","السريع"],[51,"علاك قناع المشيب اليقق","https://www.aldiwan.net/poem65702.html","المتقارب"],[51,"ومن نكد الدنيا إذا ما تنكرت","https://www.aldiwan.net/poem66018.html","الطويل"],[91,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[85,"كنيسة صارت إلى مسجد","https://www.aldiwan.net/poem63722.html","السريع"],[85,"لكل زمان مضى آية","https://www.aldiwan.net/poem63760.html","المتقارب"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[62,"جمعنا العلم في بيتين","https://www.aldiwan.net/poem52200.html","الهزج"],[62,"فديتك قد تنبهنا لدهر","https://www.aldiwan.net/poem52281.html","الوافر"],[62,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"بنا أنت من مفجوة لم تعتب","https://www.aldiwan.net/poem10896.html","الطويل"],[45,"أبا حسن إن حسن العزاء","https://www.aldiwan.net/poem62653.html","المتقارب"],[45,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[45,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[45,"أراني متى أبغ الصبابة أقدر","https://www.aldiwan.net/poem63635.html","الطويل"],[45,"أقم علها أن ترجع القول أو علي","https://www.aldiwan.net/poem65594.html","الطويل"],[28,"إذا رفعوا سمعت لهم عجيجا","https://www.aldiwan.net/poem5382.html","الوافر"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[69,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[69,"يا قومنا إن الفساد قد غلب","https://www.aldiwan.net/poem29153.html","الرجز"],[90,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[105,"تغلغل في القلب حتى وقر","https://www.aldiwan.net/poem43073.html","المتقارب"],[17,"ألا أيها الضيفُ الذي عاب سادتي","https://www.aldiwan.net/poem1202.html",""],[52,"قد أغتدي والصبح كالمشيب","https://www.aldiwan.net/poem27238.html","الرجز"],[48,"أحب إلي من وخد المطايا","https://www.aldiwan.net/poem65105.html","الوافر"],[48,"سأركب ما استطعت من الحرام","https://www.aldiwan.net/poem66280.html","الوافر"],[50,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem63925.html","الطويل"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85406","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85455","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[77,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[77,"تذكرت عهدا للشباب الذي ولى","https://www.poetsgate.com/ViewPoem.aspx?id=34196",""],[90,"أعيذكم من كذبتين","https://www.poetsgate.com/ViewPoem.aspx?id=178981",""]],"verses":[["وَمِن نَفَرٍ لا يَعرِفُ الضَيفَ كَلبُهُم","وَيَسغَبُ حَتّى يَقطَعَ اللَيلَ عاوِيا",0,"ي",2,0],["وَمِن نَجائِيَ يَومَ الدارِ حينَ هَوى","غَيري وَلَم أَخلُ مِن حَزمٍ يُنَجّيني",1,"ي",1,0],["وَمَن نَظَرَ الدُنيا بِعَينِ حَقيقَةٍ","دَرى أَنَّ ظِلّاً لَم يَزُل سَيَزولُ",2,"ل",1,0],["وَمَن نَهَشَت أَسِنَّةُ آلِ كَعبٍ","فَلا دِرياقَ لِلرَجُلِ النَهيشِ",3,"ش",1,0],["وَمِنُ نَكَدِ الأيّامِ أَنْ يَبْلُغَ المُنَى","أَخُو اللُّؤمِ فِيها وَالكَرِيمُ يَخيبُ",4,"ب",1,0],["ومَنْ ناوَل الإخوانَ حبلاً مَشى البِلى","إِلى طَرَفَيْهِ هَمَّ أن يتقَطَّعا",5,"ع",2,0],["ومَن نُرجّيهِ للدُنيا ونَمدَحُهُ","فأنتَ تُمدَحُ للدُّنْيا وللدينِ",6,"ن",1,0],["وَمَن نَزَلَت بِساحَتِهِ المَنايا","فَلا أَرضٌ تَقيهِ وَلا سَماءُ",7,"ا",2,0],["ومِنْ نظْرَةٍ دلّتْ على جَفْنِيَ البُكا","ومِنْ خطْرَةٍ قادَتْ الى قلْبِيَ الخَبْلا",8,"ل",2,0],["ومن نِسْوَةٍ أضحَتْ أيامَى حَواسِراً","تُعايِنُ في أعْوانِها الوَهْنَ والضَّعْفا",9,"ف",2,0],["وَمَنْ نُورِكَ الْوَضَّاحِ فِي الْعَالَمِ اهْتَدَى","غَدَاةَ اقْتَدَى صَدِيقُهُ وَحَكِيمُهُ",10,"م",2,0],["وَمِن نَسجِ داوُودَ مَوضونَةً","تُساقُ مَعَ الحَيِّ عيراً فَعيرا",11,"ر",2,0],["وَمِن نَشرِها ما حُمِّلَت مِن أَمانَةٍ","وَمِن وَأيِها بِالوَعدِ ثُمَّ اِنتِقالِها",12,"ل",3,0],["ومن نقص ظل الشمس تزداد رفعةً","إلى أن تُرى والظل في الشرق مائلُ",13,"ل",1,0],["ومن نَسَبَ الفتح المبين ولادة","إليه بغير الفخر لم يتأسَّسِ",14,"س",1,0],["ومن نام في ليل الشباب ضلالةً","سيوقظه صبحُ المشيب إلى الرشدِ",15,"د",1,0],["ومن نسيم طيّ هبّاته","تسمع أذني للهوى نجوى",16,"ج",3,0],["ومن نظر الدنيا وجرّب أهلها","رأى الغدر من أشداقّها يتحلّب",17,"ب",1,0],["ومن نظر الدنيا بعين اعتباره","تساوت مُهود عنده ونعوش",18,"ش",1,0],["ومن نفحات الشعر ترجيع مطرب","تعاور مَجرى صوته الخفض والنبر",19,"ر",1,0],["ومن ناله صبحُ المشيبِ ولم يفقْ","إلى طلب الأخرى فما وهب من كرى",20,"ر",2,0],["ومِنْ نكبةٍ لاقيتُها بعد نكبةٍ","رَهِبتُ اعتساف الأرضِ ذاتِ المناكبِ",21,"ب",1,0],["ومَن نشرها مِسْكٌ وألحاظها سحرُ","ومَبسِمُها درٌّ وريقتها خمر",22,"ر",1,0],["ومن ندى كفيك جاد الشرى","شؤبوب ذاك الراعد البارق",23,"ق",1,0],["ومن نَبلك المرسلات التي","صوائبها في الرمايا نسق",24,"ق",1,0],["ومن نكد الدنيا إذا ما تنكرتْ","أمورٌ وإن عُدَّت صغاراً عظائمُ",25,"م",1,1],["وَمَن نالَ مِنهُ السَيف وَهوَ مُجَرَّدٌ","تَهَيَّبَ أَن يَرنو إِلى السَيفِ مُغمَدا",26,"د",2,0],["ومن ناشج يبكي وآخر جازع","وآخر مغتاظ على الدهر حارد",27,"د",1,0],["وَمِن نَباتٍ عاشَ كَالبَبَّغا","وَهوَ عَلى الحائِطِ غَضٌّ نَدي",28,"د",2,0],["وَمَن نَسِيَ الفَضلَ لِلسابِقينَ","فَما عَرَفَ الفَضلَ فيما عَرَف",29,"ف",1,0],["وَمِن نَكَدِ الدُنيا عَلى الحُرِّ أَن يَرى","عَدُوّاً لَهُ ما مِن صَداقَتِهِ بُدُّ",30,"د",1,0],["ومن نسليهما صبغ","بطول السحق والهدمِ",31,"م",1,0],["ومن نسجِ الربيعِ محبَّراتٌ","تأنَّقَ في حواشيها الغَمامُ",32,"م",1,0],["ومن نشوةِ الكَرَمِ المُقْتَنى","لديك يُجَدَّدُ عهدُ الشبابْ",33,"ب",1,0],["وَمِن نائِلٍ ما تَدَّعي مِثلَ صَوبِهِ","إِذا جادَ أَكبادُ الغَمامِ الصَوائِبِ",34,"ب",1,0],["وَمَن نَفَرٍ فَوقَ الجُذوعِ كَأَنَّهُم","إِذا الشَمسُ لاحَتهُم حَرابِيُّ تَنضُبِ",35,"ب",1,0],["وَمِن نِعَمِ اللَهِ لا شَكَّ فيهِ","بَقاءُ البَنينَ وَمَوتُ البَناتِ",36,"ت",1,0],["وَمَن نَسِيَ البُقيا فَلَستَ لِفَضلِها","بِناسٍ وَلا مِن مُرتَجيها بِنازِحِ",37,"ح",1,0],["وَمِن نَعماءَ يَحسُدُني عَلَيها","أَداني أُسرَتي وَذَوُو وِدادي",38,"ي",1,0],["وَمِن نَكَدِ الأَيّامِ إيباءُ حِلَّةٍ","عَذاةِ النَواحي بَينَ كوثى وَصَرصَرِ",39,"ر",1,0],["وَمِن نِعمَةٍ في مَعشَرٍ لَو دَفَعتَها","عَلى جَبَلٍ لَاِنهَدَّ مِن فادِحِ الثِقلِ",40,"ل",1,0],["وَمَن نَجّى مِنَ الغَمَراتِ نوحاً","وَأَرسى في مَواضِعِها الجِبالا",41,"ل",2,0],["وَمَن نَطَقَت تَوراةُ موسى بِفَضلِهِ","وَجاءَ بِهِ إِنجيلُها وَزَبورُها",42,"ر",3,0],["وَمِن نَظرَةٍ بَينَ السُجوفِ عَليلَةٍ","وَمُحتَضَنٍ شَختٍ وَمُبتَسَمٍ بَردِ",43,"د",1,0],["وَمَنْ نَظَرَ الدنيا بما هي أهلُهُ","أرتْهُ الرضى كالسخطِ والسخطَ كالرضى",44,"ض",2,0],["ومَنْ نشأَ بين الحمير والجلبْ","كيفَ يكونُ قاضياً على حلبْ",45,"ب",1,0],["ومِنْ \"ناثراتٍ\" عليكَ المساءَ","والصُّبْحَ بالشَّعْرِ والأدْمُعِ",46,"ع",1,0],["وَمِن نَكَدِ الدَهرِ أَن يَستَعينَ","بِكَيدِ العِظاتِ وَظُلمِ العِبَرْ",47,"ر",1,0],["وَمِن نَسلِهِ السامي أَبوالفَضلِ يوسُفُ ال","لَذي أَشبَعَ الأَسباطَ قَمحَ السَنابِلِ",48,"ل",1,0],["وَمِن نُفوذِ الفِكرِ في القُلوبِ","وَمِن رُجوعِ لَحظَةِ المُريبِ",49,"ب",1,0],["وَمِن نَعتِ الدِيارِ وَوَصفِ رَبعٍ","تَلوحُ بِهِ عَلى القِدَمِ الرُسومُ",50,"م",1,0],["ومن نفثِ الحروب وطعن رمح","وصبر عند تجريد الحسام",51,"م",1,0],["وَمِن نَكَدِ الأَيّامِ عَلَّقَني الهَوى","بِذاتِ الثَناءِ الغَمرِ وَالنائِلِ الحَفدِ",52,"د",1,0],["وَمِن نَكَدِ الأَيّامِ سيقَت لِعانِسٍ","مِنَ اللُؤمِ لا يَندى وَلا يَتَبَلَّجُ",53,"ج",1,0],["وَمن نتائجها أن خاب موقدها","وأن تحررت الأقوام والأمم",54,"م",1,0],["وَمن نَسيم الصبا أن لا يصافحني","ومن أريج الحمى أن لا يُحييني",55,"ي",1,0],["وَمِنْ نَاظِمٍ لِلمُلْكِ تاَجَ فَرَائِدٍ","مِنَ المَدْحِ تِيجَانُ المُلوكِ لَهُ فِدَى",56,"د",2,0],["ومنَ نَكَد الأيام: أن يحسب امرؤٌ","أبرَّ بني مصرٍ على مصرَ جانيا",57,"ي",2,0],["ومن نسوة أضحت أيامى حواسرا","يعاين في أعيانها الوهن والضعفا",58,"ف",2,0],["ومن نظرة دلت على جفني البكا","ومن خطرة نادت إلى قلبي الخبلا",59,"ل",2,0],["ومن نسمات الصبح روحٌ جديدة","بعثتم بها لي قبل منَبلجِ الصبح",60,"ح",1,0]]}