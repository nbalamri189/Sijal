 الشُّجُونْ",5,"ن",1,0],["نُحوسٌ كُنَّ في عُقبي سعودٍ","كَذاكَ تَدورُ أَقدارُ القَديرِ",6,"ر",1,0],["نَحوي بِسُؤدُدِهِ الحُظوظَ فَتارَةً","جودٌ يَطوعُ لَنا وَطَوراً جاهُ",7,"ا",2,0],["نُحولٌ وَصَبرٌ قاطِنٌ وَمُقَوَّضٌ","وَدَمعٌ وَقَلبٌ مُطلَقٌ وَرَهينُ",8,"ن",1,0],["نَحَوْتُ عَلَيها كُلَّ حَرْفٍ بَعامِلٍ","مِنَ العَزْمِ مَخصوصٌ بِهِ الخفضُ والرّفعُ",9,"ع",1,0],["نحوَهُ يا بضاعة الفكرِ سيري","سوفَ نحظى منه بخيرِ زبونِ",10,"ن",1,0],["نحويُّكمْ مِنْ شَعْرِهِ","وجبينِهِ أمسى وأضحى",11,"ح",2,1],["نَحوَ عَبد الكَريم","الأَمير الهَمام",12,"م",1,0],["نُحولٌ وحُزْنٌ في فَناءٍ ووحْدَةٍ","وتسْهِيدُ عينٍ واصْفرِارٌ وأدمُعُ",13,"ع",1,0],["نَحوَ إِبراهيمَ حَتّى","نَزَلَت في العَدوِ وَفقا",14,"ق",2,0],["نحو حرب ليس يُخشى","عندها كلمُ الجراح",15,"ح",1,0],["نَحوَ قُرصٍ يَومَ جالَت حَولَهُ ال","خَيلُ قُبّاً عَن يَمينٍ وَشِمالِ",16,"ل",1,0],["نحوّلُ عنها كل يوم رزية","فَتبقي دماراً ثم لا يتحول",17,"ل",1,0],["نحوٌ يصُكُّ الكِسائي","ويزدرِي بابن جِنّي",18,"ن",2,0],["نحوا نحو باب للعلا فعلا بهم","على السنن المرضي والعدل يعطف",19,"ف",1,0],["نَحوَ بُلدَانِنَا فَيَا نِعمَ مَا قَد","قَذَفَ الشَّرقُ مِن بِلاَدِ الحِيَاضِ",20,"ض",1,0],["نَحَوا فَحينَ أَحَسّوا بِاللِقاءِ نَجَوا","يا قُربَ هَذا الرِضى مِن ذَلِكَ الغَضَبِ",21,"ب",1,0],["نحولٌ وإطراق وفكر ولوعة","وهل بعد هذا للسقام مزيد",22,"د",1,0],["نحو يمناك قد جعلت التفاتي","لا لزيد ولا لعمرو لعمري",23,"ر",2,0],["نحو بغداد يؤرِّقه","دُلَجُ التَّرْحال والبُكَر",24,"ر",1,0],["نَحوَ النَبِيِّ فَرَدَّها وَدَعا لَها","الجَفلى وَكانَت أَكلَة الجوعانِ",25,"ن",1,0],["نُحولٌ وَذُلٌّ وَاِشتِياقٌ وَغُربَةٌ","وَوَجدٌ وَأَشجانٌ وَصَدٌّ وَأَدمُعُ",26,"ع",1,0],["نحو أحلامٍ تَبَدَّتْ","لم تكنْ إلا نذيرا",27,"ر",2,0],["نحو أهدافٍ تلاشتْ","حينما رُمْنا فراقا",28,"ق",2,0],["نحوت لإعراب الثنا مذ رأيتها","لها سحر أجفان خلي عن الذمّ",29,"م",1,0],["نحو الخمّار أبي السرج","واكرع راحاً للصفو حوى",30,"ح",3,0],["نحوية لكنها لضرورة","حكمت بمد الهمز للمقصور",31,"ر",1,0],["نَحْوَ الحُسْنَى مُتَشَوّفُه","وَمِن التّقْوى مُتزَوّدُهُ",32,"د",2,0],["نحول وحزن واصفرار ولوعة","وسهد طويل والأنام رقود",33,"د",1,0],["نَحوُ عَبدِ العَزيزِ ما تَطعَمُ النَو","مَ وَمِنها بَعدَ الرَواحِ البُكورُ",34,"ر",1,0],["نَحوَ ماءٍ بِالعِرقِ حَتّى إِذا ما","نَقَعَت أَنفُساً بِعَذبٍ زُلالِ",35,"ل",1,0],["نحولُ خصركَ يا مَولايَ أنحلني","وَطالَما قَد أَطَلت الهَجر فَاِختصرِ",36,"ر",1,0],["نحوَ ارْتحالٍ قد تَحَوْ","ولَ لي إلى نَوْعِ ارتِحال",37,"ل",1,0],["نحو بكرٍ لها الكمال جمالٌ","وبتولٍ تريك فعلاً جميلا",38,"ل",2,0],["نحو الضريح نرى بصهوة ظهرِه","مَلَكاً يشير لنا بذاك الموقف",39,"ف",1,0],["نحوي العواذل سدَّدوا","سهماً فأخطُوا المأربا",40,"ب",2,0],["نحو الحبيب الحلو سلّاب القُوى","فهو القويُّ المالكُ الإقواء",41,"ا",2,0],["نحوي هلمي يا عروسة من ذرى","لبنان كي تحظَيْ بمجد زَهائي",41,"ي",1,0],["نحوَ الدِيارِ دِيارِ عَقدِ أليَّتي","بِهِمِ وَحلَّ مآزِري وحِبائي",42,"ي",1,0],["نحوَ البتول الطُهرِ مِنهاج الورى","مَن خُصِّصَت بالنَجمَةِ الغرّاءِ",42,"ا",2,0],["نَحو عَلِيِّ الطاهِر المُطَهَّرِ","وَالحُسنِ المُحسِنِ نجلِ حَيدَرِ",43,"ر",1,0],["نحوي قد وجهتها كتائباً","مملوءة ألفاظها مقانبا",44,"ب",2,1],["نحو الضيا صدرت أسطره","وإلى رفيع جنابه كتبي",45,"ب",2,0],["نَحوَ امرىءٍ ما زالَ مُرتَقى العُلى","حَتّى سما وَعَلا عَلى بُهرامِ",46,"م",1,0],["نَحوَ الهُمام القائِد القرم الَّذي","قرن الإِلَه بِعَزمِهِ التَوفيقا",47,"ق",2,0],["نحولي ما بخصرك من نحولٍ","وسقمي ما بطرفك من سقام",48,"م",1,0],["نحوط بها الكماة على عتاقٍ","مضمرةٍ يسابقن الخيالا",49,"ل",2,0],["نحولُ ركابٍ ضامها السيرُ فوقه","نحولُ جسوم في نحولِ ربوعِ",50,"ع",1,0],["نحولٌ عَرَضْتُ له بالسِّمانِ","وصُغرَى تجنَّبتُ منها كِبارا",51,"ر",2,0],["نحولي الذي عاينتَ من هجر ليلةٍ","فما ظنُّها بالجسم لو هَجرَتْ عشرا",52,"ر",2,0],["نحوا من غياث الدين عزاً ونعمةً","فجيدوا بهطَّالٍ وأقعسَ باسِل",53,"ل",1,0],["نحو الحياة التي لن تنتهي أبداً","من رامها يستقم في نهج إرشادي",54,"د",2,0],["نحوتي العربيه","كلكم عارفوها",55,"ه",2,0],["نَحْوُ التَّشَوُّقِ نَحْوَ صَنْعَا","تَنْظُرْ إلى طَالِعُ ونازِلْ",56,"ل",1,0],["نحو سُلطانِ البِلاد","ولِباشاها الهُمام",57,"م",1,0],["نحو شار تلق بحراً من الدما","بساحله السرحان قد ألف النسرا",58,"ر",2,0],["نَحْو وَشِعْرٌ وَخَبَرْ","وَمُسْنَدٌ مِنَ الأَثَرْ",59,"ر",1,0],["نحو امرئ قال الصلاة أربع","في اليوم واللية ماذا يصنع",60,"ع",1,0],["نحوهم فيمن أراد الآخرة","من عصبة الأنصار والمهاجرة",60,"ه",1,0],["نُحُولُ الْجِسْمِ بَعْدَكَ قَدْ عَرَاهُمْ","وَطَرْفٌ ذَابِلٌ تَعِبٌ كَلِيلُ",61,"ل",1,0],["نُحُولي عَن لِساني تُرجُمانُ","وَحَسبُكَ مِن سُؤالِكَ يا فُلانُ",62,"ن",1,1],["نحو المعالي قدتنا وبحكمة","أرسيت كل قواعد البنيان",63,"ن",1,0],["نَحوي نِهابَهُم وَالخَيلُ مُشعَلَةٌ","وَسَطَ الدِيارِ وَمِنها حَولَهُ عُصُبُ",64,"ب",1,0],["نُحولٌ ودمعٌ واصْفرارٌ وزَفْرَةٌ","شَواهِدُ صِدْقٍ للعدالةِ تَنْتَمِي",65,"م",2,0],["نَحوي اِلتَفِتْ يا حَبيبي","أَدِمْ إِليَّ اِلتِفاتَكْ",66,"ك",1,1],["نحوط أنفسنا ما قُلِّدت يدُنا","لاكنها في هواها غير محتاطه",67,"ط",2,0],["نُحول جُسوم في توَقُّد عزْمةٍ","كأسيافه يَفري الدروع ضئيلها",68,"ل",3,0],["نحو ما تبدي العلا","من حُلانا قد نحا",69,"ح",2,0],["نحوت لناديه بمنظومي الذي","لنادي أياديه تدانى مقبلا",70,"ل",2,0],["نحول وعين جرح الدمع خدها","فكم دمعة في الخد من ذاك سايله",71,"ل",2,0],["نَحْوَ رَبْعٍ من المَكا","رِمِ والمَجْدِ آَهِلِ",72,"ل",1,0],["نحو دنانير مسمّى فالسبب","في منعه بباء تصغير ذهب",73,"ب",1,0],["نحو استوى الماء وباب الدار","وبعد ما وكيف بالإضمار",73,"ر",1,0],["نحو عنا إذا جمعت مع علا","وبعده نحو الربا مع الحلى",74,"ل",2,0],["نحو دراكِ كالذي قد افرِدا","ونحو شكٍّ مددها كالبابدا",75,"د",2,0],["نحو المنى وأعر لحاظك كلما","يحوي محلا في الصدور مبجلا",76,"ل",2,0],["نحو الحَبيب مواصلاً","غدواته روحاته",77,"ت",2,0],["نَحوَ عيش في العلا فازَ به","من تعالى عَن أُناس هَلَكوا",78,"ك",3,0],["نحو الحَبيب فأَدنى منه مهجته","فمج مجة حب في سمر ساري",79,"ر",2,0],["نحولي والسهادُ ونارُ وجدي","إذا طال النَّوى ساقَت حمامي",80,"م",2,0],["نَحوَكَ لَم يَشكُ الضَرَر","وَأَنتَ أَولى مَن عَذَر",81,"ر",1,0],["نُحُولٌ بِجِسمى أنتض تَدرِى دَوَاءَهُ","وَلَولاَكَ ما خَطَّت دُمُوعِىَ أَسطُرَا",82,"ر",2,0],["نحو مصرٍ ذهبتَ تحمل داءً","ما وجدنا له دواءً مفيدا",83,"د",2,0],["نحو الشَّرابِ قد تَعالى شَوْقي","واسأل بِه أَهل الذَّكا والذَّوْقِ",84,"ق",1,0],["نحو 