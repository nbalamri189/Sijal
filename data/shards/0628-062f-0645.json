{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[65,"عذلت هذيما حين صد عن الحمى","https://www.aldiwan.net/poem45796.html","الطويل"],[10,"أيا عيني ويحكما استهلا","https://www.aldiwan.net/poem21121.html","الوافر"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[64,"بدموعنا غسلت بقايا ذنبنا","https://www.aldiwan.net/poem52179.html","الكامل"],[68,"رعى الله من لم يرع لي حق صحبة","https://www.aldiwan.net/poem40109.html","الطويل"],[82,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[33,"هيج القلب مغان وصير","https://www.aldiwan.net/poem42520.html","الرمل"],[107,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[108,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[146,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[228,"لا يحملون وأحمل","https://www.aldiwan.net/poem41441.html","مجزوء الكامل"],[275,"ليالي النوى حتام ترخين برقعا","https://www.aldiwan.net/poem35627.html","الطويل"],[308,"إن عيني مذ غاب شخصك عنها","https://www.aldiwan.net/poem58168.html","الخفيف"],[371,"تبا لدنيا ساحره","https://www.aldiwan.net/poem17762.html","مجزوء الرجز"],[382,"بدمشق أبصرت النموم محيرا","https://www.aldiwan.net/poem59398.html","الكامل"],[445,"شوق شديد ووصل من حبيبين","https://www.aldiwan.net/poem34830.html","البسيط"],[447,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[466,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[470,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[510,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[541,"عين جودي فإن ذاك شفائي","https://www.aldiwan.net/poem23865.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54035","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54060","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64994","الوافر"],[1337,"","https://poetry.dctabudhabi.ae/diwan/poem/124144","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108942","الوافر"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105433","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125470","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108452","الرمل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108453","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104959","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67258","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200028","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112293","الرمل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101226","الرمل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36760","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111451","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125872","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117296","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33393","الوافر"],[4677,"تجدبد","https://www.poetsgate.com/ViewPoem.aspx?id=204578",""],[4768,"وشوم","https://www.poetsgate.com/ViewPoem.aspx?id=213042",""],[4802,"الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=34300",""],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[4830,"يوم السيادة","https://www.poetsgate.com/ViewPoem.aspx?id=208801",""],[4858,"طلع الفجرُ أخيراً","https://www.poetsgate.com/ViewPoem.aspx?id=138072",""],[4858,"عرسُ الشّهادة في مدينة جنين","https://www.poetsgate.com/ViewPoem.aspx?id=159593",""],[4858,"وما النصر إلا من عند الله","https://www.poetsgate.com/ViewPoem.aspx?id=175067",""],[4896,"نضال لا ينتهي","https://www.poetsgate.com/ViewPoem.aspx?id=180869",""],[4929,"الموت القادم من الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=199561",""],[4955,"يا ذا الجلال وأرحم الرحماء","https://www.poetsgate.com/ViewPoem.aspx?id=207625",""],[5038,"أيّها الشّهداء","https://www.poetsgate.com/ViewPoem.aspx?id=190077",""],[5121,"مُسْكِرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=33588",""],[5121,"مَلاَذ","https://www.poetsgate.com/ViewPoem.aspx?id=94051",""],[5151,"سميتها وضحاً","https://www.poetsgate.com/ViewPoem.aspx?id=184797",""],[5268,"ما يقتلُ العصفور","https://www.poetsgate.com/ViewPoem.aspx?id=207014",""],[5273,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=180311",""],[5285,"لكِ الله يهدي سواء السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=204396",""],[5376,"يا غزة هاشم قد جئنا","https://www.poetsgate.com/ViewPoem.aspx?id=198235",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5398,"عيناك ترنو للبقاء","https://www.poetsgate.com/ViewPoem.aspx?id=37218",""],[5413,"سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=200567",""],[5431,"رقص سوريالي!!","https://www.poetsgate.com/ViewPoem.aspx?id=200445",""],[5561,"الثائرون","https://www.poetsgate.com/ViewPoem.aspx?id=207881",""],[5561,"يوم ذي قار","https://www.poetsgate.com/ViewPoem.aspx?id=208542",""],[5596,"يا نساء الخليل أحيين ليلا","https://www.poetsgate.com/ViewPoem.aspx?id=206785",""],[5638,"رثاء البطل عمر أبو ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=203607",""],[5770,"رثاء الشهيد فيصل الحسيني","https://www.poetsgate.com/ViewPoem.aspx?id=178701",""],[5851,"ظنون","https://www.poetsgate.com/ViewPoem.aspx?id=175301",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[5956,"أقسى حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=182403",""],[5956,"بدمع الذل","https://www.poetsgate.com/ViewPoem.aspx?id=185265",""],[5957,"ما زلت أذكر لوعتي وعذابي","https://www.poetsgate.com/ViewPoem.aspx?id=30136",""],[5997,"ريع الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214208",""],[6345,"مايد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78663&r=&rc=34",""]],"verses":[["بِدُموعٍ رَوائِحاً","وَدِماءٍ غَوادِيا",0,"ي",2,0],["بِدَمعٍ طَريفٍ جَدَّ في هَمَلانِهِ","وَوَجدٍ تَليدٍ بالجَوانِحِ عابِثِ",1,"ث",1,0],["بِدَمعٍ غَيرِ دَمعِكُما وَجودا","فَقَد أورِثتُما حُزناً وَذُلّا",2,"ل",2,0],["بِدَمٍ عاتِكٌ وَكانَ حِفاظاً","أَن يُقيموا إِنَّ الكَريمَ كَريمُ",3,"م",1,0],["بدموعنا غسلت بقايا ذنبنا","والنار تأكل ظلها وظلامها",4,"م",3,1],["بِدَمعٍ يُحاكي لَفظَهُ في اِنتِثارِهِ","وَعَتبٍ يُحاكي ثَغرَهُ في اِنتِظامِهِ",5,"م",2,0],["بدمع يمدّ البحرُ في السَّيْفِ نحوه","إذا الحزن منه واصل السَكبَ بالسَكبِ",6,"ب",1,0],["بِدِماثٍ سَهلَةٍ زَيَّنَها","يَومُ غَيمٍ لَم يُخالِطهُ قَتَر",7,"ر",1,0],["بِدَمي وَكُلِّ دَمٍ إِلَيَّ مُحَبَّبٍ","دَمُكِ الزَكِيُّ إِذا أَصابَكَ مُفجِعُ",8,"ع",1,0],["بدم الشَّهادة خضَّبوهُ، فضاع من","أرجائه أرَجُ العُباب الدامي",9,"م",2,0],["بدم المحبِّ يباع وصلُهمُ","فمن الذي يَبتاع بالسعرِ",10,"ر",1,0],["بِدَمي بِأَعراقي بِروحي","بِالشَبابِ الممرعِ",11,"ع",1,0],["بدمعِ النّدى هَل تذكرينَ مواقفي","هنالك أرعى بَدرَكِ المتطلعا",12,"ع",2,0],["بدموع كأنهنَّ العوادي","لا تسل ما جرى على الخد منها",13,"ه",2,0],["بِدَمعَةٍ في خَدِّها","وَبِخُشوعٍ عائِرَه",14,"ر",2,0],["بدمشق أبصرت النمومَ مُحَيَّراً","يشكو الورى يوماً ويوماً يشكرُ",15,"ر",1,1],["بدمعِ عينٍ أَبى مَا فِي الضميرِ لَهُ","حَتَّى يُصَيِّرَهُ دمعاً بلا عَيْنِ",16,"ن",1,0],["بدمعي عليه من حفاظ غسلته","فيا ليت قلبي قبره ليس يبعد",17,"د",1,0],["بدمعٍ إذا ما كفكف الحِلمث غرْبه","مَراهُ الأسى واستحدرتهُ البلابلُ",18,"ل",1,0],["بِدِماءِ الأشاوِس ِ الأبطال ِ","بالضَّحايا .. بِأدمُع ِ الأطفال ِ",19,"ل",1,0],["بدمعٍ دون أجفانٍ ونبْضٍ","بلا قلبٍ وخطوٍ دون سائرْ",20,"ر",1,0],["بِدُموعٍ غَزيرَةٍ مِنكِ حَتّى","يَقضِيَ اللَهُ فيكِ حَتمَ القَضاءِ",21,"ا",2,0],["بدُموعٍ غدتْ تَصُوبُ دماءً","وقلوبٍ أضْحتْ تَذوبُ انصداعَا",22,"ع",2,0],["بدمي منعمة كعابٌ ذاتُ دل","هيفاء تزري بالقضيب إذا اعتل",23,"ل",1,1],["بدمعِ كانَ خوفَ الهجرِ دُرّاً","فصيَّرَهُ عقيقاً بالتَّجنِّي",24,"ن",2,0],["بدموع غزيرة منك حتى","قضي الله فيك خير القضاء",25,"ا",2,0],["بدمياطيةٍ تمشي الهوينا","فيعرب ردفها عن ربوتين",26,"ن",1,0],["بدموع في الخدود إطردت","وغليل في الفؤاد ارتكضا",27,"ض",2,0],["بدم لو وهى بها في كفاح","لَعفى مهلك العدى إيماها",28,"ا",3,0],["بِدَمِ القلوبِ تَخَضَّبَت","يا سيفُ متنك والنصال",29,"ل",1,0],["بدمي أفدي وزيراً حازماً","رأيه في كل مشروع مصيب",30,"ب",1,0],["بدمي تفدى كما يفدى الاولى","يزرعون الفضل في كل مكان",31,"ن",1,0],["بِدِماءٍ مُهراقَةٍ وَدُموعٍ","مِن رِجال وَمِن عَذارى وَغيدِ",32,"د",1,0],["بدم النحر قد كتبت سطوراً","أرشدتهم لكل فرض وسُنَّه",33,"ن",2,0],["بدماهُم وردُ خدّيكِ زَها","فهو محمّرٌ كدمعي الهتنِ",34,"ن",1,0],["بِدمائِها نَهلت وَمِنها علها","حفت بِها تِلكَ الظَعائن وَلها",35,"ه",2,0],["بدموع حكت سحايب مزن","وفؤاد متيم مستهام",36,"م",1,0],["بدمعك إن الدمع فيه وسيلة","إلى الحسن القاضي إلى ذي التوحد",37,"د",1,0],["بدمع الغواني في الهوى ليس يوثقُ","فمن يشجه دمع الغواني فأحمق",38,"ق",1,1],["بدموعٍ ما لها الدّهرَ جمُود","كَدموعي خُلِقَت لِلانحِدار",39,"ر",1,0],["بدمي خضب راحا","وسبى قلبي وراحا",40,"ح",2,1],["بِدِماهُم رَكاردو رَصَّعَ التّا","ج غداةَ التَّتويجِ لا بِاللآلي",41,"ل",2,0],["بِدِمَشقَ بَينَ رُبوعِها","فَرَبيعها الأَحوى الأَجَم",42,"م",1,0],["بِدَمٍ نَقِيٍّ بَل عَصِيرٍ رائِقٍ","بِعُرُوقِ أًربابِ العِبادِ تَسَلسَلا",43,"ل",2,0],["بدمعةٍ في تراب الخطِّ ساريةٍ","تَسقْي رُفاتَ عظيمِ القدرِ مشهور",44,"ر",1,0],["بدما الجفون خدودَهُم قد خددوا","وتوسلوا فيما جنوا بالمصطفى",45,"ف",2,0],["بِدَمعٍ واكفٍ من بَي","نِ مُفترِقٍ ومُجتمِعِ",46,"ع",1,0],["بدمي القصيدةُ نبضها التجديدُ","وحروفها في أصغريَّ نشيدُ",47,"د",1,1],["بدمي غسلتُ الروحَ من آثارها","لأظلَّ في فلكِ العذابِ وصيّا",48,"ي",2,0],["بدموعي اسقي بالمسا ياسمينه","والصبح واللي يفعله قلت له منت",49,"ت",1,0],["بدم الخالدي ذكر المعارك","وفي دمه كثر شفط القوارس",50,"س",1,0],["بدمائِكُمْ سقطَتْ جميعُ الأقنِعَهْ","و