","https://www.poetsgate.com/ViewPoem.aspx?id=184218",""],[4755,"لِأَنَّكَ لا تُبَاعُ ولا تَبِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=204388",""],[4935,"سلام الله يا ابن الأكرمينا","https://www.poetsgate.com/ViewPoem.aspx?id=129306",""],[5050,"تجلد أخي وخل الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=38207",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[178,"أيا نفس كونى بعد علمك والفحص","https://www.poetsgate.com/ViewPoem.aspx?id=201004",""],[5873,"عهد الكفاح","https://www.poetsgate.com/ViewPoem.aspx?id=215311",""],[5939,"مشاغبة","https://www.poetsgate.com/ViewPoem.aspx?id=180018",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""]],"verses":[["وَلا تُطيعَنَّ فيهِ قَولَ حاسِدِهِ","إِنَّ العَليلَ لَيَرمي الناسَ بِالعِلَلِ",0,"ل",1,0],["وَلا تَطلُبا ثارَ الرِماحِ وَإِنَّما","دِماءُ المَعالي في رِقابِ الجرائِرِ",1,"ر",1,0],["وَلا تَطلُبوها سِمعَةً في مَعَرَّةٍ","تُحَدِّثُ عَنكُم كُلَّ غادٍ وَرايحِ",2,"ح",1,0],["وَلا تُطمِعِي فِيَّ الأَعاديَ واِسأَلي","بيَ ابنيَ نِزارٍ أَو بِعَمِّي وَخالِيا",3,"ي",2,0],["ولا تُطْلِقوا في الحِسِّ ثِنْيَ عِنانِها","وشِيموا بِها للحَقِّ لمْحَةَ إشْراقِ",4,"ق",1,0],["ولا تطلُبا دمْعي بتَجْريحِ مُقْلَتي","فدَمعيَ مقْبولٌ على القلْبِ ما أدّى",5,"د",2,0],["ولا تُطِعْ بَرْدَكَ في مِثلِها","إلا لعَبْدٍ لكَ أو عِلْجِ",6,"ج",1,0],["وَلا تَطمَعَن في مالِ جارٍ لِقُربِهِ","فَكُلُّ قَريبٍ لا يُنالُ بَعيدُ",7,"د",1,0],["وَلا تَطِعِ الَّتي تُغوي","كَ فَهِيَ لِغِيِّهِم أَطوَع",8,"ع",1,0],["وَلا تَطلُبا يا اِبنَي قُفَيرَةَ سابِقاً","يَدُقُّ جِماحاً كُلَّ فَأسٍ وَمِسحَلِ",9,"ل",1,0],["ولا تطمعوا فيها يداً مستكفةً","لغيركم لو تستطيعُ انتشالَها",10,"ه",2,1],["ولا تطعْ في السرى والسيرِ ذا عذلٍ","واسجدْ بذاك الثَرى الملثوم واقترب",11,"ب",1,0],["ولا تُطِل الفتورَ عن اصطناعي","وأنت لكل مكرُمةٍ نشيط",12,"ط",1,0],["وَلا تَطمَح إِلى طَلَبِ المُحالِ","وَلا تَقنَع إِلى هَجرِ المَعالي",13,"ي",1,0],["وَلا تَطْمَعَنْ من حاسِدٍ في مَوَدّةٍ","وَإنْ كُنْتَ تُبْديهَا لَهُ وَتُنيلُ",14,"ل",1,0],["وَلا تَطلُبِ العِلّاتِ فيهِ وَتَرتَقي","إِلى حِيَلٍ فيها لِمُعتَذِرٍ عُذرُ",15,"ر",1,0],["ولا تطلبوا ما بيدي الأنام","تصيروا بذلك أعداهم",16,"م",1,1],["وَلا تُطِع في اِطِّراحِ الراحِ ذا مَلَقٍ","عِندَ الحَفيظَةِ إِن ذو لَوثَةٍ لانا",17,"ن",2,0],["وَلا تَطغَ في حَثِّ الكُؤوسِ لِأَنَّنا","شَرِبنا لِنَحيا وَما حَيَينا لِنَشرَبا",18,"ب",2,0],["وَلا تَطاوَلَتِ الأَعناقُ مِن شِمَمٍ","إِلّا عَلَتها يَدُ الجَلّادِ تَلويها",19,"ي",3,0],["وَلا تَطلُبِ الرِزقَ مِن طالِبي","هِ وَاِطلُبهُ مِمَّن بِهِ قَد كَفِل",20,"ل",1,0],["وَلا تُطِعْ منهما خَصْماً وَلا حَكَماً","فأَنْتَ تَعْرِفُ كَيْدَ الخَصْمِ والحَكَمِ",21,"م",1,0],["وَلا تَطلُبا فَضلَ اِمرِئٍ في اِستِهِ حِرٌ","إِذا كانَ فيما بَينَ أَخفَيكُما قِصَر",22,"ر",1,0],["وَلا تُطيعَنَّ قَوماً ما دِيانَتَهُم","إِلّا اِحتِيالٌ عَلى أَخذِ الإِتاواتِ",23,"ت",1,0],["وَلا تُطفِئوا نورَ المَليكِ فَإِنَّهُ","مُمَتِّعُ كُلٍّ مِن حِجىً بِسِراجِ",24,"ج",1,0],["وَلا تَطلُبَنَّ اللُبابَ الصَريحَ","فَقَد سيطَ عالَمُنا وَاِمتَزَج",25,"ج",1,0],["وَلا تَطلُباها مِن سِنانٍ وَصارِمٍ","بِيَومِ ضِرابٍ أَو بِيَومِ طِعانِ",26,"ن",1,0],["ولا تَطْمَحِ العَيْنانِ مِنكَ إلى امْرئٍ","لَهُ سَطَواتٌ بِاللِّسانِ وباليَدِ",27,"د",1,0],["وَلا تُطِلْ فِكْرَةَ التَّمَنِّي","فَإِنَّهُ الْحُكْمُ وَالْقَضَاءُ",28,"ا",2,0],["وَلاَ تَطْلُبَا فَضْلَ امْرِىء ٍ في اسْتِهِ حِرٌ","إذا كان فيما بين اخفيكما قصرْ",29,"ر",1,0],["ولا تَطِّبِيه دعوة من مُخاتِل","ولا ناسخ القول الذي قال ناسخُ",30,"خ",1,0],["ولا تطلبنْ إلا من اللّه حاجةً","ولا شك أن اللّهَ معْ كل طالِبِ",31,"ب",1,0],["وَلاَ تَطوِهَا ِإلاَّ عَلَى أحسَنِ اللُّغَى","وأحسَنِ مَعنًى وَأنوِ لِلمَرءِ مَا نَوَى",32,"و",2,0],["ولا تطعْ كل همّازٍ يغركمُ","بزوره حاسداً للخلق ما عَقلا",33,"ل",2,0],["ولا تطمعوا في الصبر من بعد هذه","فأول قتلى هذه الوقعة الصبر",34,"ر",1,0],["وَلا تَطعَمَن ما يُطعِمونَكَ إِنَّما","أَتَوكَ عَلى قُربانِهِم بِالمُثَمَّلِ",35,"ل",1,0],["ولا تطيلوا ملامي","فما بهذا أثمت",36,"ت",1,0],["ولا تطلبوا منى جزاء لدينكم","كفى ما أخذتم من بياني ومن ردني",37,"ي",1,0],["ولا تطلبوا ندّاً لها في جمالها","فما لجمال الشمس في الكوم من ندّ",38,"د",1,0],["ولا تُطِعْ في الصَّبا لَوْماً ولا عَذَلاً","لا باركَ الله في العُذّالِ والعَذَلِ",39,"ل",1,0],["ولا تطِع في نَشْوةٍ لائماً","إنّ قبول الّلوم في السُّكر عار",40,"ر",1,0],["ولا تطلبوا رتبتي إنني","ملأت السماء بتكثيرها",41,"ر",3,0],["وَلا تُطيلوا مَعي فَلَستُ وَلَو","دَفَعتُموني بِالراحِ أَندَفِعُ",42,"ع",1,0],["ولا تطمعنّ من الصديق مودّةً","لو جاء من عهد الوفا بوثيقِ",43,"ق",1,1],["ولا تطع واشيك في نصحه","فالعدل لا يؤخذ من جائر",44,"ر",1,0],["ولا تطلبوا الإعفاءَ من غيرِ مانعٍ","لكم شرفٌ بالخدمةِ العسكرية",45,"ه",1,0],["وَلا تَطيعوا نفوسا","شيطانهن مريد",46,"د",1,0],["وَلا تطرد المسكين مع حسن ظنه","فَحاشا علاكم ان يرجى ويطرد",47,"د",1,0],["وَلا تَطلُبَنَّ الجاهَ يا صاحِ إِنَّهُ","شَهى وَفيهِ السُمّ مِن حَيثُ لا تَدري",48,"ر",2,0],["وَلا تُطِع مُستَهاماً في الهَوى نَهَما","وَتابِعِ الدينَ وَالدِيانِ وَاِرضِها",49,"ه",2,0],["وَلا تطمع الآمال في الودّ إِنَّهُ","إِذا ما أَمضَّ الداءُ أَعيا المُداويا",50,"ي",2,0],["وَلا تَطرب بِغَير غِناء شادٍ","يَشيد بِناء كُلّ علىً وَفَخرِ",51,"ر",1,0],["وَلا تُطع الهَوى غيّاً فَتردى","كَما أَردى الهَوى حَملَ بن بَدرِ",51,"ر",1,0],["ولا تطلب إلا الله في كل مطلب","تنل فوق مطلوبك وهمك ينجلي",52,"ل",2,0],["ولا تطع نفس أمارة بسوء الخلال","واعلم بأن صلاح القلب عند الرجال",53,"ل",1,0],["ولا تُطلِعْ لَنَا خَدَّاك","وردَ رِياضِها الخَضِلاَ",54,"ل",2,0],["ولا تطلبا إِن هُمْ دَنَوْا أَوْ هُمُ نَأَوْا","بأَخبارِهِمْ إِلاَّ جُفوناً وأَضْلُعا",55,"ع",2,0],["ولا تطر شيا من أحاديث عالج","وإن كان لا يخفى بناظرك الطروي",56,"و",2,0],["ولا تطعم الدنيا بنيها سوى الذي","تشيرون من حُلوٍ إليه ومن مرِّ",57,"ر",1,0],["ولا تَطْرُدِ البُرْهانَ وهو مُشَرِّقٌ","كَمَنْ رامَ بالكَفِّيْنِ سَتْرَ ذُكاءِ",58,"ا",2,0],["ولا تطلبا ثأري فطرفي بلحظة","رمى غيرها يوم العذيب فأصماها",59,"ا",3,0],["وَلا تَطلُبَن مِنّي مِنَ الصَبرِ ذَرَّةً","فَلَستُ أَرى بِالصَبرِ ما ذَرَّ شارِقُ",60,"ق",1,0],["ولا تَطلبي منّي الفِرارَ على الرّدى","فإنّك إنْ رُمتِيهِ لم تجِدِيهِ",61,"ي",2,0],["ولا تطلب الدّنيا فإنّ نعيمها","سرابٌ تراءى في البسيطة زائلُ",62,"ل",1,0],["ولا تطلبي عندي الصَّبابةَ بعدها","سَفاهاً فإنّي للصَّبابةِ ناسِ",63,"س",1,0],["وَلا تَطلُبي شَرخَ الشّبابِ وَقَد مَضى","فذلكَ شَيءٌ ما أَراه يثوبُ",64,"ب",1,0],["وَلا تَطلُبي شَيئاً يَكونُ طِلابهُ","وَقَد ضَلَّ عنهُ رائِدوهُ عناءا",65,"ا",3,0],["ولا تُطِعِ النُّهاةَ ولو تَمادى","وأسهَبَ في مَلامِكَ مَن تَمادى",66,"د",2,0],["ولا تطل التأيم بعد وانكح","فتاةً تسلب الغصن اعتداله",67,"ل",2,0],["ولا تطل دموع العين في طلل","أقوى وأقفر من ترحال عادات",68,"ت",1,0],["وَلا تُطِع نَفسك أَو نَفس أَحد","في فعلة يحدث بَعدها نَكَد",69,"د",1,0],["ولا تُطالبْ غنيّاً حاجةً أبداً","ولا الولاةَ ولا الساداتِ والكُبَرا",70,"ر",2,0],["ولا تطع لعاذل قد وشى","واعلم بأنى قد طويت الاحشا",71,"ش",2,0],["ولا تطلبنّ النصر من غير قادر","عليه ولكن فادع من كان ينفعُ",72,"ع",1,0],["ولا تطلبا صوني إذا ما تغنتا","تسرُّ وفوزٌ جادتا لي الأغانيا",73,"ي",2,0],["ولا تطع فيهما اطغاءَ خناس","فمن توقاهما في عمره احتكما",74,"م",2,0],["ولا تَطْلُبَنَّ كريماً بَعْدَ رُؤْيتِهِ","ولا تُبالِ بِشِعْرٍ بَعْدَ شاعِرِهِ",75,"ر",2,0],["ولا تَطْمَعَنَّ بسُلْوانِهِ","فما يَتْرُكُ الشَّيخُ أَخْلاقَهُ",76,"ق",2,0],["ولا تُطعِ الواشي فليس بمُصْلِحٍ","ولكنّه للتِّسعةِ الرَّهْطِ عاشِرُ",77,"ر",1,0],["وَلا تطيعي الغَضَبا","وَلا تسيئي الأدبا",78,"ب",2,0],["ولا تطع أمر لاح في هوى رشإ","وكاس راحٍ فما اللاحي بأمار",79,"ر",1,0],["ولا تطمعن القلب في ميل صاحب","اليك فان الدهر ان مال الواه",80,"ا",2,0],["ولا تطمعوا من باسم ساعة اللقا","فان الوفا بالقلب لا بالمباسم",81,"م",1,0],["وَلاَ تَطْمَعُوا فِي الرَّدِّ فَالنَّاسُ كُلُّهُمْ","رَأَوْا أَنَّ مَوْلاَنَا لَهُ القَلَمُ المَاضِي",82,"ي",1,0],["ولا تطمعي بالحِلى والغوالي","وأَما بحسن الثنا فاْطمعي",83,"ع",2,0],["ولا تطعَمَنَّ سوى مطعَمٍ","كمَطعَم عنتَرَةَ الفاخرِ",84,"ر",1,0],["ولا تطمَعَنَّ ولا تكذِبَنَّ","فما حِلفُ ذينكَ بالخائِرِ",84,"ر",1,0],["وَلا تطيعوا العدو إِن به","لكم عَلى حب ربكم حسدا",85,"د",2,0],["ولا تطيب بغير الطيب من فمها","روح الكئيب حليف الوجد والسهر",86,"ر"