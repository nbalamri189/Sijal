{"poems":[[86,"دك ما بين ضحوة وعشي","https://www.aldiwan.net/poem10480.html","الخفيف"],[85,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[66,"دمع مزائد قطره لا تجمد","https://www.aldiwan.net/poem38494.html","الكامل"],[102,"أهلا برب المهرجان","https://www.aldiwan.net/poem33112.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"]],"verses":[["دُكَّ ما بَينَ ضَحوَةٍ وَعَشِيِّ","شامِخٌ مِن صُروحِ آلِ عَلِيِّ",0,"ي",1,1],["دككنا حصنهم حرقا وكسرا","وأفنيناهم قتلا وأسرا",1,"ا",1,0],["دَكَّت حُصونَ القَومِ إِلّا مَعقِلاً","مِن نَخوَةٍ وَحَمِيَّةٍ وَفُتوكِ",2,"ك",1,0],["دُكَّت بِكَ الأَرضونَ حينَ حَلَلتَها","فَعَليكَ تَغبِطُها السَماءُ وَتَحمِدُ",3,"د",1,0],["دُكَّت صُروحٌ ما بنى","أْمثاَلها في المجدِ بانِ",4,"ن",1,0],["دَكْنَاءُ مُثْقَلَةُ الْجَوَانِبِ رَهْبَةً","مَكْظُومَةُ النِّيرَانِ فِي الأَحْشَاءِ",5,"ا",2,0]]}