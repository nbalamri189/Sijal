{"poems":[[86,"دك ما بين ضحوة وعشي","https://www.aldiwan.net/poem10480.html","الخفيف"],[85,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[66,"دمع مزائد قطره لا تجمد","https://www.aldiwan.net/poem38494.html","الكامل"],[102,"أهلا برب المهرجان","https://www.aldiwan.net/poem33112.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[209,"فقدت وما فقدت سوى صديق","https://www.aldiwan.net/poem46306.html","الوافر"],[295,"لو أبانت حجابها أسماء","https://www.aldiwan.net/poem33339.html","الخفيف"],[426,"الخيل عزوفي صهواتها الشرف","https://www.aldiwan.net/poem40706.html","البسيط"],[512,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[556,"دب سر الوجود بالمفقود","https://www.aldiwan.net/poem33552.html","الخفيف"]],"verses":[["دُكَّ ما بَينَ ضَحوَةٍ وَعَشِيِّ","شامِخٌ مِن صُروحِ آلِ عَلِيِّ",0,"ي",1,1],["دككنا حصنهم حرقا وكسرا","وأفنيناهم قتلا وأسرا",1,"ا",1,0],["دَكَّت حُصونَ القَومِ إِلّا مَعقِلاً","مِن نَخوَةٍ وَحَمِيَّةٍ وَفُتوكِ",2,"ك",1,0],["دُكَّت بِكَ الأَرضونَ حينَ حَلَلتَها","فَعَليكَ تَغبِطُها السَماءُ وَتَحمِدُ",3,"د",1,0],["دُكَّت صُروحٌ ما بنى","أْمثاَلها في المجدِ بانِ",4,"ن",1,0],["دَكْنَاءُ مُثْقَلَةُ الْجَوَانِبِ رَهْبَةً","مَكْظُومَةُ النِّيرَانِ فِي الأَحْشَاءِ",5,"ا",2,0],["دكتور يا دكتور دكتور يا دكتور","اسمع ندائي فهذا وحي أشجاني",6,"ي",1,0],["دُكدِكت دونَها جِبالٌ فأَضحَت","وَهيَ مِن نورها المَضيء هَباءُ",7,"ا",2,0],["دكت حوافره والحصباءَ حيث غدا","كان صمّ الصفا من وطئه خزفُ",8,"ف",1,0],["دكَّ طورَ العَزاءِ نُورُ التجلّي","منكُمُ للوَداعِ يومَ الفِراقِ",9,"ق",1,0],["دك طوري بنوره المتجلي","فتجاوزت في الهوى عن حدود",10,"د",1,0]]}