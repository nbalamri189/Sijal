{"poems":[[88,"دك ما بين ضحوة وعشي","https://www.aldiwan.net/poem10480.html","الخفيف"],[87,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[87,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[68,"دمع مزائد قطره لا تجمد","https://www.aldiwan.net/poem38494.html","الكامل"],[104,"أهلا برب المهرجان","https://www.aldiwan.net/poem33112.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[102,"صبوة","https://www.poetsgate.com/ViewPoem.aspx?id=50402",""],[215,"فقدت وما فقدت سوى صديق","https://www.aldiwan.net/poem46306.html","الوافر"],[302,"لو أبانت حجابها أسماء","https://www.aldiwan.net/poem33339.html","الخفيف"],[435,"الخيل عزوفي صهواتها الشرف","https://www.aldiwan.net/poem40706.html","البسيط"],[519,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[563,"دب سر الوجود بالمفقود","https://www.aldiwan.net/poem33552.html","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35354","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79804","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109008","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108892","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108832","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108757","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48244","الكامل"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33089","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137928",""],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88652","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93533","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204592","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118799","المديد"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106696","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82834","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123941","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86280","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91200","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117910","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[4533,"","https://poetry.dctabudhabi.ae/diwan/poem/134273","الخفيف"],[4691,"\" أمّ الحَمَام \"","https://www.poetsgate.com/ViewPoem.aspx?id=158307",""],[4767,"عودة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=94471",""],[4859,"عطش القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=186710",""],[4859,"كلما شعّ لليماني أنسٌ!","https://www.poetsgate.com/ViewPoem.aspx?id=197031",""],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[5129,"مقام الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=120509",""],[5160,"نسْوان الدّنا","https://www.poetsgate.com/ViewPoem.aspx?id=183329",""],[5307,"حيّ ابجوابٍ ياني","https://www.poetsgate.com/ViewPoem.aspx?id=10380",""],[5496,"أرسلت روحى","https://www.poetsgate.com/ViewPoem.aspx?id=212781",""],[5573,"ياعين مالك بالسهر زود راحه","https://www.poetsgate.com/ViewPoem.aspx?id=200080",""],[5573,"ياسابح الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=200177",""],[5606,"ردعلى مرثية الشاعرمصلح بن بطحان السحيمي","https://www.poetsgate.com/ViewPoem.aspx?id=199035",""],[5694,"اخويي","https://www.poetsgate.com/ViewPoem.aspx?id=129913",""],[5720,"عَهدُ سَلمانَ","https://www.poetsgate.com/ViewPoem.aspx?id=201141",""],[5764,"دكتور !","https://www.poetsgate.com/ViewPoem.aspx?id=137055",""],[5829,"ليلة العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=210434",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[5956,"دكتورنا الهادي مفيدُ الضادِ","https://www.poetsgate.com/ViewPoem.aspx?id=192985",""],[5956,"إذا قال الشَّمالي صدِّقوهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210307",""],[6066,"حَفْلُ تَخَرُّجِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=12666",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة ( ميسون","https://www.poetsgate.com/ViewPoem.aspx?id=13879",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة (ميسون)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74364&r=&rc=2",""]],"verses":[["دُكَّ ما بَينَ ضَحوَةٍ وَعَشِيِّ","شامِخٌ مِن صُروحِ آلِ عَلِيِّ",0,"ي",1,1],["دككنا حصنهم حرقا وكسرا","وأفنيناهم قتلا وأسرا",1,"ا",1,0],["دَكَّت حُصونَ القَومِ إِلّا مَعقِلاً","مِن نَخوَةٍ وَحَمِيَّةٍ وَفُتوكِ",2,"ك",1,0],["دُكَّت بِكَ الأَرضونَ حينَ حَلَلتَها","فَعَليكَ تَغبِطُها السَماءُ وَتَحمِدُ",3,"د",1,0],["دُكَّت صُروحٌ ما بنى","أْمثاَلها في المجدِ بانِ",4,"ن",1,0],["دَكْنَاءُ مُثْقَلَةُ الْجَوَانِبِ رَهْبَةً","مَكْظُومَةُ النِّيرَانِ فِي الأَحْشَاءِ",5,"ا",2,0],["دكتورة الأطفال إني هنا","من يوم ميلادي بلا مرضعة",6,"ع",2,1],["دكتورة الأطفال لا تبعدي","عني وعن مأساتي الموجعة",6,"ع",2,0],["دكتور يا دكتور دكتور يا دكتور","اسمع ندائي فهذا وحي أشجاني",7,"ي",1,0],["دُكدِكت دونَها جِبالٌ فأَضحَت","وَهيَ مِن نورها المَضيء هَباءُ",8,"ا",2,0],["دكت حوافره والحصباءَ حيث غدا","كان صمّ الصفا من وطئه خزفُ",9,"ف",1,0],["دكَّ طورَ العَزاءِ نُورُ التجلّي","منكُمُ للوَداعِ يومَ الفِراقِ",10,"ق",1,0],["دك طوري بنوره المتجلي","فتجاوزت في الهوى عن حدود",11,"د",1,0],["دُكَّت لِمَوتِكَ أَطوادُ العُلى صَعَقاً","وَاِرتَجَّ مِن نَعيِكَ السَبعُ السَماواتُ",12,"ت",1,0],["دكّ السريع طيه والكف","وذبحه طي وردف وقف",13,"ف",1,0],["دكُّوا رُباها ثم قالوا لها","وقد جَثوا نحنُ مكان الرُبا",14,"ب",2,0],["دكت منيته أسوار مصطبري","وسوَّرتني بأسوارٍ من الكمد",15,"د",1,0],["دك التباعدُ إعزازي وأثبت بي","ذلّاً لو اكتنف البحرين ما التطما",16,"م",2,0],["دكت فواجرها داري ولا عجبٌ","قد دكَّ قومُ يزيدَ الركنَ والحرما",17,"م",2,0],["دك الفساد وشاد العدل عامله","وحرق الجور لما غرَّق البدعا",18,"ع",2,0],["دَكَّتِ الأرضَ والجبالَ وهَدَّت","كلَّ طَودٍ مُريعَةٌ بَطشاء",19,"ا",2,0],["دكّاكُ أفدان العِدَى بقنابلٍ","وجحافلٍ تَفْري رؤوس الجَلْمدِ",20,"د",1,0],["دُكنَ الجِبابِ تَدَرَّعَت أَبدانُها","صُعلَ الرُؤوسِ طَويلَةَ الأَذنابِ",21,"ب",1,0],["دككن حصونه الاولى فباتت","على عبريه للرائين اثرا",22,"ر",2,0],["دك طود الحجى ودكدكت","الارض وَكادَت جبالها ان تزولا",23,"ل",2,0],["دكَّرَتني برزية","هِيَ لَم تَزَل لِلحَشر نَكبه",24,"ب",2,0],["دككنا عروش المستبدين فيكم","فلم ترتضوا والرق يستعذب الظلما",25,"م",2,0],["دكَّ طوري عندما طلعت","شمسكم يا بهجة السدفِ",26,"ف",1,0],["دُكنٍ لَهُنَّ من الأسِنَّةِ أعيُنٌ","وَمِن مَثارِ النّقعِ ثَوبٌ أسحَمُ",27,"م",1,0],["دكدكت أركان الهدى","وثلمت في الإسلام ثلمه",28,"م",2,0],["دِكتورُ لَو أُعطيكَ ما مَلكت يَدي","بَل لَو بَذلتُ الروحَ لَم أَفِ بِالغَرض",29,"ض",1,1],["دكانه بشارع المراكشي","فاذهب إليه علَّه أن يختشي",30,"ي",1,0],["دكدكتم أمس عروض قيصر","وطاق كسرى وصروح بابل",31,"ل",1,0],["دك طور الفخار منك قريش","فقد موسى أخي اليد البيضاء",32,"ا",2,0],["دَككت طودَ العلى اذ خَنت خير فَتى","من آل تَقلا فَماد الكَون وَاِرتَجفا",33,"ف",2,0],["دكدَكتَها بِفوارسٍ تلقى القَضا","فرحاً بقلبٍ بعدها لا يندم",34,"م",1,0],["دكت معاقل بغيهم وضلالهم","بالطوب تغشاهم قواصف رعده",35,"د",2,0],["دَكَّ مِنهُ الرَّدى وَطافَ بِهِ المَو","تُ قَوياً كَالزَعزَعِ النَكباءِ",36,"ا",2,0],["دك صرح الحشى هواه ولم ير","ث يوما من الزمان لحالي",37,"ل",2,0],["دكاكِينُها والمَقَاهِي الَّتي","أهلَّ بها الشايُ كي نسمُرا",38,"ر",2,0],["دكَّت حجارتُه الحصون بخيبرٍ","حتى هوت والظلم غير مخلد",39,"د",1,0],["دكَّتْ بقسوتِها النفوسَ ولمْ تزل","تسقي قلوبَ العاشقينَ سِقَامَا",40,"م",2,0],["دَكَّتِ الحربُ عزمَهُ بعد أمسٍ","كان فيهِ بجنّتيهِ أميرا",41,"ر",2,0],["دُكتْ قواعدُ حصننا وتصدَّعتْ","أركانُنا آهٍ وخرَّتْ أسقفُ",42,"ف",1,0],["دَكُّوا حُصُونَ الصَّمْتِ يَهْدرُ موجُهمْ","ليَسُوْقَ في مَجْرى الجُمُوعِ فُلُولا",43,"ل",2,0],["دكتورُ جئتكَ طالبًا يدَهَا المَصُونة","راجيًا مِنكَ الرِّضَا كالمُحْسنينْ",44,"ن",1,0],["دكتورنا ما ايواني","عن إهدفه ما حاد",45,"د",1,0],["دكت الأشواق حصنا بعد حصن","لم أطق بعدا لمَ لم تأت حينه",46,"ن",2,0],["دك الهجوس وكاتم السد باحه","يدعيه هم وخانق الضيق ذبّاح",47,"ح",1,0],["دكتور ينفع واشتكي منك واشكيك","واشرح لك اللي بالهواجيس حاصل",48,"ل",1,0],["دكوا الحوثي بقصف الطائرات","عاقبة عفاش واتباعه وبال",49,"ل",1,0],["دك في صدري هواجيس مجنونه","ياوجودي يوم هبت هبايبها",50,"ب",3,0],["دَكَّ بالحقِّ جُيُوشاً ظَلَمَتْ","فمحاها بالرهيفِ العَطِبِ",51,"ب",1,0],["دكتور صح أبوي مافيه حاجه ؟!","قلّي بإنه طيب وحاله بخير",52,"ر",1,1],["دكتور تكفى لايطوّل علاجه","هدّ التعب حالي ونا عزمي كبير",52,"ر",1,0],["دكت صياصي البغي والليلُ احترق","وجرت خيول النصر والفجر انبثق",53,"ق",1,1],["دَكَّاً تخِرُ شغافُ القلبِ من عَجَبٍ","إنْ لم تخر _وربي _ ذا هو العجبُ",54,"ب",1,0],["دكتورنا الهادي عميدُ الضادِ","فخرُ النحاة وأكملُ الرُّوادِ",55,"د",1,1],["دكَّ الحصارَ بقفزةٍ نوعيةٍ","منه ومن رأس البطولة جابرا",56,"ر",2,0],["دكتورة علم في النحو طالبها","يحب طلعتها ويقتدي فيها",57,"ي",3,0],["دَكدِك الظالم مزق جيشه أدفن الباغي وقطع من جحد","كن كميناً كن جحيماً كن لظى كن عذاباً من زُؤامٍ ورصد",58,"د",1,1],["دكدك الظالم ومّزق جيشه","ادفن الباغي وقطّع من جحد",59,"د",1,0]]}