{"poems":[[55,"أيا راكبا ترمي به الليل جسرة","https://www.aldiwan.net/poem29913.html","الطويل"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[93,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[12,"ومن يك مثلي يلقه الموت خالياً","https://www.aldiwan.net/poem1210.html",""],[63,"قليل لها أن يتبع الدمع غيرها","https://www.aldiwan.net/poem51683.html","الطويل"],[99,"ثغر كما يعشق الفنان بسام","https://www.aldiwan.net/poem24346.html","البسيط"],[50,"خليلي أقعد للصبوح ولا تقل","https://www.aldiwan.net/poem66601.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16657","الطويل"],[124,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[564,"شهدت حقيتي عظيم شاني","https://www.aldiwan.net/poem69263.html","الوافر"],[572,"جنبك الله عارض العلل","https://www.aldiwan.net/poem69535.html","المنسرح"],[572,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83285","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53744","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122769","الوافر"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39177","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64001","البسيط"],[931,"","https://poetry.dctabudhabi.ae/diwan/poem/97842","الطويل"],[1148,"","https://poetry.dctabudhabi.ae/diwan/poem/146296","الطويل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20567","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77990","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27747","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137213",""],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21633","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112480","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62763","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66331","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85264","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85262","البسيط"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93753","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135132","المجتث"],[4856,"رحيلٌ مؤقت","https://www.poetsgate.com/ViewPoem.aspx?id=36269",""],[5628,"دليل الحب","https://www.poetsgate.com/ViewPoem.aspx?id=178671",""],[572,"جَنّبكَ الهُ عارضَ العِلَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9438&r=&rc=295",""]],"verses":[["فَإِن تُطفِئوها اليَومَ فَهيَ شَرارَةٌ","وَغَدواً أُوارٌ وَالأُوارُ هَلاكُ",0,"ك",1,0],["فإن تطاوَحَ فيه طرفُها صُعُداً","أضحى له ولها في طولها سفر",1,"ر",1,0],["فَإِن تَطلُبوها بِسُمرِ القَنا","نَرُدُّكُم بِطِوالِ القَنا",2,"ن",2,0],["فَإِن تَطعَنوا الشَّيخَ الذي لم تُفَوِّقوا","مَنِيَّتَهُ وَغِبتُ إِذ لَم أُشَهَّدِ",3,"د",1,0],["فإنْ تَطْغَ يوماً عايَنَتْ منه حَتفَها","وإنْ تَستَجِرْ يوماً أضلَّتْ مجيرَها",4,"ر",3,0],["فأنتِ طاهرةٌ والفن أطهرُ ما","يطوفُ حولكِ حاشَا الفنَّ آثام",5,"م",1,0],["فإن تطلبيهِ تقتضيهِ بحانةٍ","كمثل سراج لاحَ في الليل مشعَل",6,"ل",1,0],["فإنْ تُطْلِقِيهِ تَملكي شُكْرَ قوْمِه","وإنْ تَقْتُليهِ تُؤخَذي بقَتِيل",7,"ل",1,0],["فإن تطق فاسل دمعاً شقيت به","إن الشفاء مسيل المدمع الخضل",8,"ل",1,0],["فَأَنتَ طَبعاً وَإِن أَنكَرتَ كُلَّ جَلى","لَولا الهَوى لَم تَرقَ دَمعاً عَلى طَلَلِ",9,"ل",1,0],["فإن تطرح الأسباب هيهات تتقي","فكيف ولا حرصٌ هناك ولا طرح",10,"ح",1,0],["فإن تطيعوا تجتنوها نحلةً","بيضاءَ طاب مجتناها وحلا",11,"ل",2,0],["فإن تَطْلب تَرى صِفتي مع اسمي","فلا تَنْظُر بطَرفِك نحْو جِسمي",12,"ي",1,0],["فَإِنْ تَطَوَّلْتَ فِي القَبُولِ لَهُ","فَهَذِهِ نِعْمَةٌ تُجَرَّدُ لِي",13,"ل",2,0],["فَأَنْتَ طَوْدُ العُلاَ الذِي قَدْ","رَسَا فَمَا إِنْ لَهُ انْقِلاَعُ",14,"ع",1,0],["فَإِن تَطوِهِ أَيدي المَنونِ فَما طَوى","كُرورُ اللَيالي ذِكرُهُ المُتَضَوِّعا",15,"ع",2,0],["فإنْ تطوِهِ الأيامُ لا تَطو بَعْدَهُ","صنائعَ مِنْهُ لا تبيدُ على النّشرِ",16,"ر",1,0],["فإن تَطلُب بِوَهاسٍ بَديلاً","فَإنَّكَ مُشتَرٍ سَهَراً بِنَومِ",17,"م",1,0],["فإنْ تُطِقْ تَجمع الضِّدَّيْنِ في نَسَقٍ","فَرُبَّما قَد تَرى خِلّاً يُواتِيكا",18,"ك",2,0],["فأنت طَوْدُ العلى الذي قد","رسا فما إِنْ له انقلاع",19,"ع",1,0],["فَإِن تَطرحنّي أَو تقول فتيّة","يضرّ بِها برحُ الهوى فتعودُ",20,"د",1,0],["فإن تطردوني تطردوني وقد جرى","بي الور يوماً في دماء الأراقم",21,"م",1,0],["فَإِن تُطَلِقوني تُطَلِقوا ذا قَرابَةٍ","وَمُثنٍ عَلَيكُم صادِقاً غَيرَ كاذِبِ",22,"ب",1,0],["فإن تطعم فجائعك المعنى","وإن تسقي فظامئك الحزينا",23,"ن",2,0],["فإن تطرد حزت الكثيؤر ولم تمل","إلى أوكس الأجزاء فالوكس أوضعُ",24,"ع",1,0],["فإنْ تطلبْ على ما قلت فيه","إذا أنصفتني فيه وجدتا",25,"ت",2,0],["فان تطلب لذاك وذا مثيلاً","تكن كمماثل بالارض يوحا",26,"ح",2,0],["فَإِن تَطرُقي بابَ الإِمامِ فَإِنَّني","لِكُلِّ كَريمٍ ماجِدٍ لَطَروقُ",27,"ق",1,0],["فإن تطلبت عيشى مت من كمد","وإن تطلبت حينى يبعد الأجل",28,"ل",1,0],["فإنْ تَطُلِ الأيامُ اغضبْ بغارَةٍ","تخرُّ بها بَعدَ الأنوفِ الحَلاقِمُ",29,"م",1,0],["فأنت طود رسى حلماً ومخلصكم","يسره أن تُرى منكم على الراسي",30,"ي",1,0],["فإن تطلب له في العصر مثلاً","فقد حاولت إدراك المحالي",31,"ل",2,0],["فأنت طالع سعد حين ما طلعت","نجومه زدتنا حظاً وإقبالا",32,"ل",2,0],["فَإِن تطمَح بجدك لارتقاء","غَدا لَكَ بِالعُلا خَير اتصال",33,"ل",1,0],["فأنت طود بيان","على البرية عالي",34,"ل",2,0],["فأَنتَ طبيبي وأنتَ الجريحْ","ونحنُ أَنينُ جِراحٍ تُمَزَّقْ",35,"ق",1,0],["فإنْ تطلبي مطلبا كالذي","طلبتِ فمقدوره في يدي",36,"ي",1,0],["فإنْ تَطَوَّلْتَ بالقبولِ لهُ","فهذه نعمة ٌ تُجَدَّدُ لي",37,"ل",2,0]]}