{"poems":[[54,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[108,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[275,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[505,"جاس الحمى خصم بصولة وهمه","https://www.aldiwan.net/poem37792.html","الكامل"],[505,"جاس العدو خلال دار عويجز","https://www.aldiwan.net/poem37793.html","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93095","الكامل"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/141693","البسيط"],[561,"","https://poetry.dctabudhabi.ae/diwan/poem/145195","المتدارك"],[3490,"","https://poetry.dctabudhabi.ae/diwan/poem/199138","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125864","الكامل"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31264","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72451","المنسرح"],[4858,"عودة المغول","https://www.poetsgate.com/ViewPoem.aspx?id=29943",""],[5152,"من أجل من","https://www.poetsgate.com/ViewPoem.aspx?id=184525",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[5376,"ولد الحبيب فنوره وضَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=188484",""],[5376,"يا قدسُ لو متْنا جميعاً كلَّنا","https://www.poetsgate.com/ViewPoem.aspx?id=189514",""],[5691,"نِعلين تقاوم الجدار","https://www.poetsgate.com/ViewPoem.aspx?id=206393",""]],"verses":[["جاسَ فيها الشَكُّ حينَ رَأَت","بِجُنوبِ الحَزنِ أَسرابا",0,"ب",2,0],["جاسوا المنازل مفسدين وأوقدوا","نارَ الإساءَة أيما إيقاد",1,"د",1,0],["جاسَتْ خِلالَ مغانينا، ولو لَمحَتْ","طيفَ الحديد وطيفَ النار لم تَجُسِ",2,"س",1,0],["جاس البلاد بالبلاء طاميا","فبز حتى بلغ السيل الزبى",3,"ا",1,0],["جاسوا خِلالَ ديارِكم وتوغَّلوا","إذ خَلخلتكُم شرَّةٌ وعَرام",4,"م",1,0],["جاسَ الحِمى خَصْمٌ بِصَوْلَةِ وَهْمهِ","كَذَبَتْ عليهِ ظُنونُهُ أينَ الحِمى",5,"م",2,1],["جاسَ العَدُوُّ خِلالَ دارِ عُوَيْجِزٍ","لأبي العَواجِزِ أحمدِ القومِ انْتَمى",6,"م",2,1],["جاس المصاب خلالها","لتزول وانتسف الهضابا",7,"ب",2,0],["جاسوا ديار الأعادي وهي حافلة","فأصبحت مثل ربع دارس خربِ",8,"ب",1,0],["جاست جنبات الكفر فلم","تترك لهمو ما لم تجس",9,"س",1,0],["جاسوا خلال ديارهم فلهم بها","في كل يوم غارة شعواء",10,"ا",2,0],["جاس العدوُّ خلالها بمجازر","لله أشلاء هناك تمزّق",11,"ق",1,0],["جاسَت كَتائِبُها الدِيار وَأَوجَفَت","بِالأمنِ فيها خَيلِها وَرِكابُها",12,"ب",3,0],["جاست خلال ديارهم فئة","أحسنها في الخلال أقبحها",13,"ح",3,0],["جاسوا خلال ديارنا بجنونهم","غذاه حقد أسْودٌ مشهودُ",14,"د",1,0],["جاست بروضتها الكلابُ وأسرفت","وغدت تعربِد في العراق وتلعبُ",15,"ب",1,0],["جَاسُوا خِلالَ دِيَارِهِ بِرِضَائِهِ","هَذِي قَواعِدُهُمْ وَفِي البَحْرِ السُّفُنْ(٢١)",16,"ن",1,0],["جاس بن جرجيس بغياً من شقارته","خلال سنة خير الناس بالأحن",17,"ن",1,1],["جاسوا الديار خلالها بتعنتٍٍ","عاثوا فسادا أنهم جبناء",18,"ا",2,0],["جاسوا الديار فبتُّ فيها مكرهً","ومضيْتُ في الأنواءِ أرعى رحلَنا",19,"ن",2,0],["جاسَ الدِّيارَ مُشَرِّداً أصْحابَها","متَجَبِّراً بطْشاً بهمْ وعَفاءَ",20,"ا",2,0]]}