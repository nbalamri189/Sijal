لحسب الباقي في عقب الدهر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577546",""],[119,"إلهي مسني كرب عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55614&r=&rc=11",""],[6344,"فلسفة الضّياع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87975&r=&rc=15",""]],"verses":[["وَأَيدٍ تُجيلُ قِداحَ الرِماحِ","وَباعُ المُعَرِّدِ عَنها بَرَم",0,"م",1,0],["وَأَيدٍ سِجاحٍ كِرامٍ مَعاً","بِمَجدٍ مَصونٍ وَمالٍ مُذالِ",1,"ل",1,0],["وَأَيدٍ جُفوفٍ لا تَلينُ وَإِنَّها","وَلو مَطَرَت فيها الغُيومُ جَمادُ",2,"د",1,0],["وَأَيدٍ تُصافِحُ أَيدي الكِرامِ","وَإِن نَفَرَت مِن أَكَفَّ الشِحاحِ",3,"ح",1,0],["وَأَيدٍ عَلى بُسطِ السَماحِ رَقائِقٌ","وَهُنَّ عَلى قَبضِ الرِماحِ شَرائِثُ",4,"ث",1,0],["وأيْدٍ تَبُزُّ التاجَ قمّةَ أبْلَجٍ","وتَكْسو قِناعَ النّقْعِ لِمَّةَ أبْلَخِ",5,"خ",1,0],["وأيْدٍ كَما حَلَّ الغَمامُ نِطاقَهُ","تُدِرُّ أفاويقَ الغِنى نَفَحاتُها",6,"ت",3,0],["وَأَيَّدْتَنِي وَالدَّهْرُ قِرْنٌ مُنَاجِزٌ","فَأَيَّدَكَ الرَّحْمَانُ جَلَّ جَلاَلُهُ",7,"ل",2,0],["وَأيّدَ ذَاكَ اللَّحْظُ مِنْكَ بِحَاجِبِ","وَيَقْبُحُ أَنْ يُعْصَى أَمِيرٌ وَحَاجِبُ",8,"ب",1,0],["وَأَيِّد مِصرَ وَالسودانَ وَاِغنَم","ثَناءَ القَومِ مِن بيضٍ وَسودِ",9,"د",1,0],["وأيّدَ الله من أحيا جهادهُمُ","وواصل الفخرُ أُخراهُ وأُولاهُ",10,"ا",2,0],["وأيدّ مولانا ابنَ نصر فإنه","لأَشرفُ من يُنمَى لمُلكٍ وسلطانِ",11,"ن",1,0],["وأيَّدَ اللهُ مولانا بعصمته","بأيِّ باب إلى العلياء قد فُتِحا",12,"ح",2,0],["وأيّدها اللّه من صوتها","بأكبر عون وأقوى سبب",13,"ب",1,0],["وأيِّدْ أيادِي ابن الخليفة إنَّها","إذا زهدَت فينا الكِرام رغاب",14,"ب",1,0],["وأُيِّدَ بابنٍ مثلهِ في غَنائه","إذا كَثُرت من رَيب دهرٍ كوارثُهْ",15,"ث",2,0],["وأيد لا تكاد تصيب خبزا","وايد لا تُسل من الرقاق",16,"ق",1,0],["وأيِّدا داعيا يؤرّخه","في نعم الخلد مصطفى عاكف",17,"ف",1,0],["وأيدٍ إذا سَلَّت صوالجَ فِضةٍ","على الوَحشِ يوماً أذهَبتْ بدِمائِها",18,"ا",3,0],["وأيدٍ بنت في القفر منها صوامعاً","وكانت لها بالمرهفات هوادما",19,"م",2,0],["وأيّدهُ بآياتٍ وضاءِ","ألم تخبره تَرجمةُ الرغاءِ",20,"ا",2,0],["وأَيديك إن طالَت فَلا تغترر بها","فإن يد الأيام منهن أَطول",21,"ل",1,0],["وأي دين بسوى السيف انتشر","كم أيّدت بالسيف أديان البشرْ",22,"ر",1,0],["وأَيَّدُوا بِالسَّرايَا الْغُرِّ جَارَتَهُمْ","فَكَانَ خَيْرَ مُجِيرٍ ذَلِكَ المَدَدُ",23,"د",1,0],["وأيد عن الدنيا قصار قواصر","وفوق أعاديهم طوال قواصم",24,"م",1,0],["وأيد وأجيادٌ تُمَدّ وتلتوي","ومنهن حال بالدموع ومعطال",25,"ل",1,0],["وأيدنا المولى بتأييد حاله","فطبنا به اسماً وطبنا به ذكرا",26,"ر",2,0],["وأيد العدل حتى قال قائل من","في الكون هذا رسول العدل حاكمه",27,"م",2,0],["وأيده بالأملاك وانصر جنوده","على فرقة الشيطان واحفظه بالسر",28,"ر",1,0],["وأيدِي أعادِيه مقهورةٌ","بزُرْقٍ العوالي وحَدّ الحُسَام",29,"م",1,0],["وايْدَ بالقُرانِ تعليماً له","إن في القرآن تفسيرَ الجُملْ",30,"ل",1,0],["وأيَّدَهُ وعَمَّرَهُ مَطَاعاً","وأبقَاهُ المُسَوَّدَ لاَ المَسيدَا",31,"د",2,0],["وأيِّد السلم في هذي الديار ولا","تذرَ جميع بني الدنيا مجانينا",32,"ن",2,0],["وَأَيَّدَ اللَهُ بِالمَيمونَ طائِرُهُ","هَذا الإِمامَ فَقَد دانَت لَهُ الأُمَمُ",33,"م",1,0],["وأيديهم مبسوطة لك بالدعا","وخيراتكم تثنى وجبرانكم تترى",34,"ر",2,0],["وَأَيَّدَهُ بِمِثلِ اللَهبِ تَأبى","عَلى الأَيّامِ صُفَّتُهُ اِنهِدادا",35,"د",2,0],["وَأَيدِ الأَعادِى مُشرَعاتٌ فَطَرفُنا","إِلَى طَرفِهِم نَرمِى بِهِ فَنُصِيبُ",36,"ب",1,0],["وَأيّدَ أعداءَ البلاد بسعيهِ","وَأَوهمَ أَهلَ الجهلِ أَنّ بهِم خَيرا",37,"ر",2,0],["وَأيّد بهِ الإسلامَ واِلطف بأهلهِ","وَمِن بعدِ هذا العسرِ يسّر لهم يسرا",37,"ر",2,0],["وايدك الرحمن منه بنصرةٍ","وانت يحمد الله للضدّ فاطر",38,"ر",1,0],["وايدي سبا احزابهم قد تفرقت","وليس لهم الا القيامة تجمع",39,"ع",1,0],["وأيده الله المهيمن بالصبا","ورعب له في الدار عين أصيص",40,"ص",1,0],["وَأَيُّ دارٍ لَكِ بِالجودِ وَال","إِكرامِ لِلعافينَ لَم تُفرَشِ",41,"ش",1,0],["وأيدي الفكر تلقطه سحيراً","من البحر الّذي بالفيض وافر",42,"ر",1,0],["واي درس ميت لم يُعد","حياته من دارس دائر",43,"ر",1,0],["وأيد بحرف الكاف وَالنون حِجَتي","لِيَسبق لي من كل صالحة حرف",44,"ف",1,0],["وأيد قول الأشعري بسنةٍ","فكانت عليه من أدل الدلائل",45,"ل",1,0],["وَأَيَّدَكَ اللهُ الْعِليُّ ثَناؤُهُ","بَعاجِلِ نَصْرٍ خالِدِ الْعِزِّ قاهِرِ",46,"ر",1,0],["وَأَيده بِالوَح وَالنَصر وَالصِبا","وَأَملاكُهُ وَالمُؤمِنين وِبِالرُعب",47,"ب",1,0],["وأيد بالآيات من كل معجزٍ","وبرهان صدقٍ قاطعٍ للمعاذر",48,"ر",1,0],["وأَيديهمْ جَفَّتْ وإنَّ تَعجّبي","لأَظفارها مَعْ لُبسِها كيفَ تَنبُتُ",49,"ت",1,0],["وَأيّدَ اللَهُ سُلطان الوَرى لِنَرى","بِهِ لعزمة هذا الدين تَأييدُ",50,"د",1,0],["وأيَّدتَ ذا ديناً خفيّاً مموَّهاً","ببعض خُرافاتٍ بها أنت تستكفي",51,"ف",2,0],["وأيّدتَه بالعدلِ والبذل والتُّقَى","وضربِ الطّلى والصالحاتُ دَعائِمُ",52,"م",1,0],["وأيدياً أوْجَبتْ شكري لأنعمها","فاليوم أقضي لكم بالمدح ما وجبا",53,"ب",2,0],["وأيدي الصبا تهدي بساحته المنى","وقد فاض جوداً بالصفاءِ غديرهُ",54,"ه",1,0],["وأيّد هَذَا المُلْكَ والدِّينَ مِنْهُما","بأَيمَنِ يُمْنى ساعَدَتْ خَيْرَ سَاعِدِ",55,"د",1,0],["وأيدٍ مدمّاةٌ عليَّ بعضِّها","كما عَضَّ في إثر البياع غَبينُ",56,"ن",1,0],["وأيدٍ سِباطٍ وهي بالمنع جَعدةٌ","تلاطمني منها اللواتي أصافحُ",57,"ح",1,0],["وأيدٍ تخفُّ إلى الأعطياتِ","إذا حُسِبَ الفقرُ لا تُحسَبُ",58,"ب",1,0],["وأي درع في الرُّوع أنت فلو","سلَّك في الحادثات أو نثلك",59,"ك",1,0],["وأيدي السنا هلال السما","وابدى الجلال هلال العلم",60,"م",1,0],["وأيّده التفاف القوم نحوي","لتهنئتي فبتّ مع الفخام",61,"م",1,0],["وأيد قلوبا واستأصل أنسها فذا","مرام عبيد إن أنسك أغناني",62,"ن",2,0],["وايَّد ربُّك الفعال موسى","ولا بيضٌ لديه ولا رماحُ",63,"ح",1,0],["وأيَّدَني سِرٌّ من الله ناصرٌ","ووطَّدَ قلبي فيه بُشرى الهَواتِفِ",64,"ف",1,0],["وأَيَّدَ اللهُ رغمَ الكُلِّ مظهَرَهُ","بلى وصَمْصامُهُ في الكونِ مشْهُورُ",65,"ر",1,0],["وأَيَّدكم بالرُّعبِ حتَّى تبدَّدَتْ لديكم","من الأَعداءِ دُهْمُ العَصائِبِ",66,"ب",1,0],["وأيّدك العارُ بقومٍ كبيرُهم","رعاهُ الفجورُ والنفاقُ صبيّا",67,"ي",2,0],["وأيدك الرحمن بالكامل الذي","عمرت به الأيام بعد خراب",68,"ب",1,0],["وأيد الله دين الحق منك بذي","يد لها في الوغى التأييد والغلب",69,"ب",1,0],["وأيدني قلب وعزم كأنما","يقدان من حد المهند والصخر",70,"ر",1,0],["وأيديكم بالبأس كاسرة العدى","ولكنها بالجود جابرة الكسر",71,"ر",1,0],["وأيد ملكه بأبي شجاع","وذلك من تمام الاهتمام",72,"م",1,0],["وأيْدِي جَميعِ الخارِجينَ بسُوءٍ ما","يُدَبِّرُهُ صارَتْ تَجِلُّ وتَعْظُمُ",73,"م",1,0],["وأيدي المطايا إذ وقفن عشيّةً","على عرفاتٍ بعد طيّ المنازلِ",74,"ل",1,0],["وَأَيديهمُ تجري إِذا جَمَدَ الحَيا","على المُعتفين بالعطايا وتَهمعُ",75,"ع",1,0],["وأيدي المطايا يبتدرْن مغَمِّساً","وهنّ خميصاتُ البطون خوامِسُ",76,"س",1,0],["وأيد الله النبيّ إذ جرى","ذاك عليه بجنود لا ترى",77,"ر",2,0],["وأيّده الرحمنُ منه بقوّةٍ","بِها قد غدا باباً لخيبر يقلعُ",78,"ع",1,0],["وأيّد جُيوشَ المسلمين وكلّ من","لهم في ميادين الكفاح يشجّعُ",78,"ع",1,0],["وَأيَّدَ حِرفَةَ الأدَبِ اشتِغالي","عَنِ الأضحَى بِعيدِ المَهرَجانِ",79,"ن",1,0],["وَأَيد فيها مُلكه وَهو تالد","بِعَزم كَسيف باتر وسنان",80,"ن",1,0],["وَأَيّده بِالفَتح وَالنَصر ما بَدا","هِلالٌ وَما قَد لاحَ بَدر تَمام",81,"م",1,0],["وَأَيد الأَوطان بِالتمدّن","في عَصره رَأي لَهُ سَديد",82,"د",1,0],["وَأَيده بِالنَصر المُبين وَهب لَهُ","مِن الفَتح ما لَم يَنحَصر بِحُدود",83,"د",1,0],["وَأَيَّد الحَق فيها مِن فَضائله","بِحِكَمٍ وَدِراياتٍ وَبُرهان",84,"ن",1,0],["وَأَيد الملك وَالدين القَويمَ بِهِ","في دَولة ذات تَمكين وَتَوثيق",85,"ق",1,0],["وَأَيده بِنصرك حَيث أَحيا","رُسومي رَأيُ دَولتِهِ الحَصيف",86,"ف",1,0],["وَأَيدك الرَحمن بِالنَصر ما صَفَت","لِعلياك بِالإِخلاص مِنا سَرائر",87,"ر",1,0],["وَأَيد ملك الصادق الوعد بِالَّذي","كَساه وَقاراً رَغم أَنف عَنيد",88,"د",1,0],["وَأَيدت المَعارف بِاجتهادٍ","سَبقت بخيله شَيخاً وَكَهلا",89,"ل",2,0],["وَأَيدها مِنهُ بِحَزم وَهمة","وَعَزم كميّ في المَواقف سامي",90,"م",2,0],["وأيدتمانا بائتلافكما الذي","به صرتما للدين كفاً ومعصما",91,"م",2,0],["وأيدك الأحرار من كل جانب","بعزم الأولى شابوا وعزم الأولى شبّوا",92,"ب",3,0],["وأيِّد أميرَ المؤمنينَ وسيفَهُ","بنصرٍ كما عوَّدتَ يا خالقَ النصر",93,"ر",1,0],["وأيَّدْتَ المكارمَ والمعالي","بوفرٍ في سبيلهما حبيس",94,"س",1,0],["وايد عليه وايد","ياما تبعت ارضاك",95,"ك",1,0],["وأيِّدنْ أعوانَهُ","مِنَ الأَميرِ وَالوَزيرْ",96,"ر",1,0],["وَأَيَّد ركنَ الحقّ ربّ وَشادهُ","وَعادَ عَلى رُكنِ الضّلالةِ بِالهدِّ",97,"د",1,0],["وَأَيِّده يا ربَّ السّماءِ ومدَّه","بِجندٍ مِنَ 