{"poems":[[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[42,"آليت لا أمشي إلى رب لقحة","https://www.aldiwan.net/poem50387.html","الطويل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[71,"آليت لا آتي بخارى بعدها","https://www.aldiwan.net/poem3780.html","الكامل"],[35,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[37,"إلى توائم أصغى من أجنتها","https://www.aldiwan.net/poem6459.html","البسيط"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[23,"آليت حلفة بر غير ذي دخل","https://www.aldiwan.net/poem21398.html","البسيط"],[23,"سائل قريشا وأحلافها","https://www.aldiwan.net/poem21470.html","المتقارب"],[51,"آليت أهجو كريما عند نبوته","https://www.aldiwan.net/poem66339.html","البسيط"],[51,"يا من قسا لما شكوت","https://www.aldiwan.net/poem66509.html","مجزوء الكامل"],[91,"خبروني ماذا رأيتم أأطفالا","https://www.aldiwan.net/poem62818.html","عموديه"],[32,"صدت بثينة عني أن سعى ساع","https://www.aldiwan.net/poem27806.html","البسيط"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[85,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[62,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[45,"قلب مشوق عناه البث والكمد","https://www.aldiwan.net/poem62734.html","البسيط"],[45,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[45,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[45,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[45,"أكثر هذي الخطوب أشكال","https://www.aldiwan.net/poem65601.html","المنسرح"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[87,"ما لي بودك بعد اليوم إلمام","https://www.aldiwan.net/poem8263.html","البسيط"],[74,"آليت إلا أن تسير مع الفضل","https://www.aldiwan.net/poem13226.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[50,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[50,"عامت سليمى ومسها سغب","https://www.aldiwan.net/poem64838.html","المنسرح"],[50,"بأبي وأمي من يقاربني","https://www.aldiwan.net/poem64843.html","الكامل"],[46,"أطعت في الأيام سداجي","https://www.aldiwan.net/poem22269.html","السريع"],[46,"آليت ما مثري الزمان وإن طغى","https://www.aldiwan.net/poem22416.html","الكامل"],[46,"أصبحت غير مميز من عالم","https://www.aldiwan.net/poem22562.html","الكامل"],[46,"دنياك تشبه ناضحا متردا","https://www.aldiwan.net/poem22575.html","الكامل"],[46,"لا علم لي بم يختم العمر","https://www.aldiwan.net/poem22588.html","الكامل"],[46,"ما للبصائر لا تخلو من السدر","https://www.aldiwan.net/poem22660.html","البسيط"],[46,"أصحاب ليكة أهلكوا بظهيرة","https://www.aldiwan.net/poem22698.html","الكامل"],[46,"يا نفس آه لمتجر متنزر","https://www.aldiwan.net/poem22699.html","الكامل"],[46,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[46,"إن هللت أفواهكم فقلوبكم","https://www.aldiwan.net/poem23175.html","الكامل"],[46,"آليت أرغب في قميص مموه","https://www.aldiwan.net/poem23249.html","الكامل"],[46,"يا بدوي اتق المدامة إن ال","https://www.aldiwan.net/poem23539.html","المنسرح"],[76,"هلا ابتكرت لبين أنت مبتكر","https://www.aldiwan.net/poem39317.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[90,"سيصدني وأصده","https://www.poetsgate.com/ViewPoem.aspx?id=179085",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[45,"أرَيْتُكَ الآنَ ألَمْعُ البُرُوقْ","https://www.poetsgate.com/ViewPoem.aspx?id=32839",""],[46,"أصحابُ لَيْكَةَ أُهلِكوا بظَهيرَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20273",""],[46,"آلَيتُ ما مُثري الزّمانِ، وإن طَغا،","https://www.poetsgate.com/ViewPoem.aspx?id=18519",""],[118,"مسافة الشمس دون أقربه","https://www.aldiwan.net/poem49373.html","المنسرح"],[167,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[191,"قد كان من زهرات العيش لي غصن","https://www.aldiwan.net/poem13160.html","البسيط"],[193,"علاني الشيب واشتعل اشتعالا","https://www.aldiwan.net/poem54419.html","الوافر"],[195,"بما أودعته فيها","https://www.aldiwan.net/poem39940.html","مجزوء الوافر"],[227,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[233,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[233,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[239,"مباسم الثغر ما أحلى حمياك","https://www.aldiwan.net/poem45769.html","البسيط"],[278,"يا سيد الحكام هل من وقفة","https://www.aldiwan.net/poem60786.html","الكامل"],[279,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[280,"ما فتكات البيض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[296,"آليت في حبك رعي العهد","https://www.aldiwan.net/poem36315.html","عموديه"],[303,"إحسان مثلك محفوظ عن الكلف","https://www.aldiwan.net/poem56475.html","البسيط"],[320,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[362,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[367,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[369,"ملتمسا صلح الليالي ومن","https://www.aldiwan.net/poem57510.html","السريع"],[374,"ما لي بأوطان أخص صفاتها","https://www.aldiwan.net/poem59260.html","الكامل"],[377,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[399,"أضعت العمر في إصلاح حالك","https://www.aldiwan.net/poem47007.html","الوافر"],[403,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[403,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[426,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[444,"أكثرت قتل بني بكر بربهم","https://www.aldiwan.net/poem23957.html","البسيط"],[450,"سقى الله أياما بغوطة جلق","https://www.aldiwan.net/poem13687.html","الطويل"],[456,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[456,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[456,"الآن إذ برد السلو ظمائي","https://www.aldiwan.net/poem56313.html","الكامل"],[462,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[475,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[475,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[475,"دم أريق بأسياف الهوى هدر","https://www.aldiwan.net/poem15236.html","البسيط"],[475,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[477,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[498,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[534,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"],[560,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[565,"من يبك من وجد على هالك","https://www.aldiwan.net/poem69768.html","السريع"],[574,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"]],"verses":[["آلَيتُ لا أَحفِلُ في نَصِّها","إِن مَرَجَ الغَرضُ وَرَثَّ الخِطام",0,"م",1,0],["آلَيتُ أَن أَحدو بِأَعراضِكُم","حَدوَ أَبي عُروَةَ بِالجامِلِ",1,"ل",1,0],["آلَيتُ لا أَمشي إِلى رَبِّ لِقحَةٍ","أُساوِمُهُ حَتّى يَؤوبَ المُثَلَّمُ",2,"م",1,1],["آلَيتُ لا نُعطيهِ مِن أَبنائِنا","رُهناً فَيُفسِدَهُم كَمَن قَد أَفسَدا",3,"د",2,0],["آلَيتُ لا آتي بُخارى بَعدَها","وَلَو انَّها في الأَرضِ دارُ خُلودِ",4,"د",1,1],["إِلى تَلَعاتِ الخُرجِ غَيَّرَ رَسمَها","هَمائِمُ هَطّالٍ مِنَ الدَلوِ مُدجِنِ",5,"ن",1,0],["إلى توائم أصغى من أجنتها","وساوسَ عنها قابت القُوَبُ",6,"ب",1,1],["الى تَوأمٍ كأنَّها قَرَدَ العِهنِ","بِبَيدَاءَ لأُمِّها الزَّغَبُ",7,"ب",1,0],["آلَيتُ حَلفَةَ بَرٍّ غَيرِ ذي دَخَلٍ","مِنّي أَلِيَّةَ بَرٍّ غَيرِ إِفنادِ",8,"د",1,1],["إِلى تَغلِبٍ إِنَّهُم شَرُّ جيلٍ","فَلَيسَ لَكُم غَيرَهُم مَذهَبُ",9,"ب",1,0],["آليتُ أهجو كريماً عند نبوته","ولا لئيماً وإنْ أكدى وإنْ شتما",10,"م",2,1],["آليتُ لا أهجو طِوا","لَ الدهر إلا من هجاني",11,"ن",2,0],["اليَتيمُ الَّذي يَلوحُ زَرِيّاً","لَيسَ شَيئاً لَو تَعلَمونَ زَرِيّا",12,"ي",2,0],["آلَيتُ لا أَصطَفي بِالحُبِّ غَيرَكُمُ","حَتّى أُغَيَّبَ تَحتَ الرَمسِ بِالقاعِ",13,"ع",1,0],["إلى تراوح العشب","إلى رشاقة القضب",14,"ب",1,0],["اليَتامى نُوَّحٌ ناحِيَةً","وَالمَساكينُ يَمُدّونَ الرَنين",15,"ن",1,0],["آليتَ ألّا يحطَّ النومُ أرحُلَه","حتى تنالَ على رُغمٍ أقاصيكا",16,"ك",2,0],["آلَيتُ لا أَجعَلُ الإِعدامَ حادِثَةً","تُخشى وَعيسى بنُ إِبراهيمَ لي سَنَدُ",17,"د",1,0],["اَلَيتُ لا يَثنينَ جَدّاً صاعِداً","في مَطلَبٍ حَتّى يُنِخنَ بِصاعِدِ",18,"د",1,0],["آلَيتُ لا أَجهَدُ الطائِيَّ مُلتَمِساً","جَدوى وَلا أَسأَلُ الطائِيَّ إِلحافا",19,"ف",2,0],["آلَيتُ لا أَشرَبُ مَمزوجَةً","إِن لَم تَكُن مَزجَةَ ريقٍ بِريق",20,"ق",1,0],["آلَيتُ لا يَستَفِزُّني الطَمَعُ","المُغري وَلا يَستَغِرُّني الآلُ",21,"ل",1,0],["آليتُ لا أُهدي كرائمَ مَنْطِقي","إلا إلى المَلِكِ الكريمِ العُنْصُرِ",22,"ر",1,0],["آلَيْتُ أَكْذِبُ نَفْسِي بَعْدَهَا سَفَهَاً","إِنَّ الْمُنَى عِنْدَ صِدْقِ النَّفْسِ أَوْهَامُ",23,"م",1,0],["آلَيتُ إِلّا أَن تَسيرَ مَعَ الفَضلِ","وَأَزمَعتَ إِلّا أَن تَصُمَّ عَنِ العَذلِ",24,"ل",1,1],["إلى تُرْبَةٍ ضَمَّ الأَمانَةَ وَالتُّقَى","بها وَالنَّدَى وَالفضْلَ مِنْ أَحْمَدٍ لَحْدُ",25,"د",1,0],["آليتُ أصدُرُ عن بحارك بعدما","قِستُ البحار بها فكنّ سرابا",26,"ب",2,0],["آلَيتُ أَرضى بِالَّذي سُمتَني","أَو يَبعَثَ المَوتى لَنا باعِثُ",27,"ث",1,0],["آلَيتُ يَأبى الصِبا وَأَتبَعَهُ","هَيهاتَ بَيني وَبَينَهُ نَجَبُ",28,"ب",1,0],["آلَيتُ لا أَسلى مَوَدَّتُهُ","لَو ما تَسَلّى الماءَ شارِبُهُ",29,"ب",2,0],["آلَيتُ ما أَدري وَلا عالَمي","مِن كَوكَبي في الحِندِسِ الداجي",30,"ي",1,0],["آلَيتُ ما مُثري الزَمانِ وَإِن طَغى","مُثرٍ وَلا مَسعودُهُ مَسعودُ",31,"د",1,1],["آلَيتُ لا يَدري بِما هُوَ كائِنٌ","مُتَفائِلٌ بِالأَمرِ أَو مُتَطَيِّرُ",32,"ر",1,0],["آلَيتُ ما الحِبرُ المِدادُ بِكاذِبٍ","بَل تَكذِبُ العُلَماءُ وَالأَحبارُ",33,"ر",1,0],["آلَيتُ ما في جيلِنا أَحَدٌ","يُختارُ لا زَيدٌ وَلا عَمرو",34,"ر",2,0],["آلَيتُ أُثني عَلى قَومٍ بِنُسكِهِمُ","وَقَد تَكَشَّفَ سَهلُ الأَرضِ عَن غَدَرِ",35,"ر",1,0],["آلَيتُ لا يَنفَكُّ جِسمِيَ في أَذاً","حَتّى يَعودَ إِلى قَديمِ العُنصُرِ",36,"ر",1,0],["آلَيتُ لَو رُزِقَ العَديمُ فَطانَةً","لَنَفى الهُمومَ وَباتَ غَيرَ مُحَسَّرِ",37,"ر",1,0],["آلَيتُ ما مَنَعَ الخُوارُ أَوابِداً","في هَضَبِ شابَةَ وَالنَقا الخَوّارِ",38,"ر",1,0],["آلَيتُ ما تَوراتُكُم بِمُنيرَةٍ","إِن أُلفِيَت فيها الكُمَيتُ مَحَلَّلَه",39,"ل",2,0],["آلَيتُ أَرغَبُ في قَميصِ مُمَوِّهٍ","فَأَكونَ شارِبَ حَنظَلٍ مِن حَنضَلِ",40,"ل",1,1],["آلَيتُ ما سَمَّحَت أَخا بَخلٍ","يَوماً وَلا شَجَّعَت أَخا جُبُنِ",41,"ن",1,0],["آلَيتُ ألا أرى شمساً ولا قمراً","حتى أرَاكَ فأنتَ الشمسُ والقمرُ",42,"ر",1,0],["آلَيْتَ بِالحُسْنَى أَلِيَّةَ عَارِفٍ","بعُلُوِّهَا عَنْ شُبْهَةٍ مِنْ كَاذِبِ",43,"ب",1,0],["آليت أقتحم الجحي","م على جواد من ذنوبي",44,"ب",2,0],["آليت لكني ارعوي","ت وقلت يا نفسي اهدئي بي",44,"ب",2,0],["آليت أني حربُ من","ناوى البلاد وضده",45,"د",2,0],["آليتُ أقْتَحمَ الطُغاةَ مُصَرِّحاً","إذ لم أُعَوَّدْ أنْ أكونَ الرّائبا",46,"ب",2,0],["آلَيْتُ لا أشرَبُ مَمْزُوجَةً،","إنْ لمْ يَكُنْ مَزْجةُ رِيقٍ برِيقْ",47,"ق",1,0],["آلَيْتُ لا يَنفَكُّ جسْميَ في أذًى،","حتى يَعودَ إلى قَديمِ العُنصُر",48,"ر",1,0],["آلَيتُ ما مُثري الزّمانِ، وإن طَغا،","مُثرٍ، ولا مسعودُهُ مسعودُ",49,"د",1,1],["آليت لا يستخفني أملٌ","في الغد أو تستغرني حسنه",50,"ن",2,0],["آلَيتُ أَنفَكُّ مِن حِلٍّ وَمُرتَحَلٍ","أَو أَن تَقولَ لِيَ الآمالُ خُذ وَدَعِ",51,"ع",1,0],["آليتُ لا أَقتَني عَلَقاً بِقاسمِه","أَيدي الرَدى قَسَماً يَوماً أُواليهِ",52,"ي",2,0],["أَلَيتُكَ ثُمَّ عُدتُ فَعُد بِخَيرٍ","وَخَيرُ الخَيرِ ما يُجرى عِلالا",53,"ل",2,0],["إلى تلكَ التي في أضلُ","عي قلبي يُناجيها",54,"ي",3,0],["آليتُ لا ذقتُ المنا","مَ ولا اضطجعْتُ على حَشِيّه",55,"ي",2,0],["آلَيتُ لا أَمدُد إِلى أَمدٍ يَدي","إِلّا إِلَيكَ وَلا لَواها مَطمَعُ",56,"ع",1,0],["آلَيتُ لا اِمتَدَّت يَدي إِلّا إِلى","مَن تَملَأُ الأَرضَ الفَضاءَ هِباتُهُ",57,"ت",2,0],["آليتُ لا يأتلى سهماك يعتورا ال","فأصبح الناسُ كل الناس قتلاكِ",58,"ك",1,0],["آلَيْتُ لاَ أَبْغِي نَداكَ بِشَافِعٍ","مَالِي إِلَيْكَ وَسِيلَةٌ إِلاَّكا",59,"ك",2,0],["آليت أبكي فقيداً لست أخلفه","ما عشت والبرّ من قد برَّ إذ حلفا",60,"ف",2,0],["آلَيتُ لا أَسمَعُ فيهِم واشِياً","يُزَخرِفُ القَولَ وَمَن يَسمَع يَخَل",61,"ل",1,0],["آليتُ في حبّكِ رعيَ العهدِ","حتى أبيت هامةً في لحدي",62,"ي",1,1],["آليتَ حلفةَ برٍّ لا تُجشّمني","لكَ النزولَ الّذي يعلو به شرفي",63,"ف",2,0],["آلَيتُ جَهداً وَصادِقٌ قَسَمي","بِرَبِّ عَبدٍ تَجُنُّهُ الكُرُحُ",64,"ح",1,0],["آلَيتُ لا أشْكُوَنْ مَن قد كَلِفْتُ به","ولو تَبدَّلْتُ من وَصْلٍ بهِجْران",65,"ن",1,0],["آليت لا أوليت غيرك مدحةً","شعراً وإن أفعل فمدحةُ مكره",66,"ه",1,0],["آليتُ لا استعديتُ إلا فتىً","أعدى عليهنَّ من الصبحِ",67,"ح",1,0],["آليت أني لا أقيم بأرضها","أبداً ولو أن الكليم كليمها",68,"م",3,0],["إِلى تَمام سنةٍ","تَلوح تَحتَ الطرر",69,"ر",1,0],["إليَّ تَزَيّنينَ لِتَخْدَعيني","فما أَبْصَرتُ أقبحَ مِنْ جمالِكْ",70,"ك",1,0],["آليت أستَسقي الغَمائِم بَعدَها","وَيَمين حَيدرة الغِمامِ الأَكبَرُ",71,"ر",1,0],["آلَيت استَسقي سِوى مَنصِلي","إِن الغَوادي بِمُرادي شحاح",72,"ح",1,0],["اليت لا ادعُ التغزل والهوى","حتى ألاقي ما لقى أشباهي",73,"ا",3,0],["آلَيتُ بِاللَهِ لا أَرضى بِقَتلِهِم","حَتّى أُبَهرِجَ بَكراً أَينَما وُجِدوا",74,"د",3,0],["إِلى تلعات السفح من قاسيونها","مدارج داري الصبا المتأرج",75,"ج",1,0],["آليتُ لا أحملُ فَرضَ العلا","ونفلَها إلا على حاملِ",76,"ل",1,0],["آليتُ لا أصحبُ ذلّاً كارهاً","يوماً ولا آملُ رفداً طائعا",77,"ع",2,0],["آليتُ لا رَقَبَ الكواكبَ ناظري","شوقا ولا مَسَحَ الدموعَ ردائي",78,"ي",1,0],["آليتُ ألفي خاضعاً لممدّحٍ","إلاك إنَّ النّجم دونكَ يخضع",79,"ع",1,0],["آليتُ ما الغيثُ بدًا","مُبرِقُهُ ومُرعِدُه",80,"د",2,0],["آليتُ ما هتفتْ ورقاءُ في فَنَنٍ","ولا تأَلَّقَ برقُ المزنِ أو لَمَعا",81,"ع",2,0],["آليتُ لاحِلتُ عن دينِ الوفاءِ كما","قد كانَ يعهدُ من حالي واِنْ غدروا",82,"ر",3,0],["آليتُ لا حِلْتُ ولا حِلْتُمُ","عن كلَّ ما أعهدُهُ منكمُ",83,"م",1,1],["اليتم واليم في البيتين دمعهما","على المصابين جار في مجاريه",84,"ي",2,0],["أَلِيَّتُهُمْ وَثيقُ العَهْدِ منهُ","على زُهْدٍ فيا نِعْمَ الأَلِيَّهْ",85,"ي",2,0],["إِلى تَوحيدِ خَلّاقِ البَرايا","وَكُفرٍ بِالحِجارَةِ وَاللِخافِ",86,"ف",1,0],["إلى تُرابٍ جُبِلْنا منهُ مَرجِعُنا","نظيرَ ماءٍ إليه يَرجِعُ البرَدُ",87,"د",1,0],["إلى تحِيّاتٍ لِطَافٍ بها","تُسْكِنُ مِنِّي مُهْجةً مُزعَجَهْ",88,"ج",2,0],["آلَيتَ حَبَّ العِراقِ الدَهرَ أَطعَمُهُ","وَالحَبُّ يَأكلُهُ في القَريَةِ السوسُ",89,"س",1,0]]}