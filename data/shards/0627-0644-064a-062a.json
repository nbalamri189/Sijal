{"poems":[[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[55,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[44,"آليت لا أمشي إلى رب لقحة","https://www.aldiwan.net/poem50387.html","الطويل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[73,"آليت لا آتي بخارى بعدها","https://www.aldiwan.net/poem3780.html","الكامل"],[37,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[39,"إلى توائم أصغى من أجنتها","https://www.aldiwan.net/poem6459.html","البسيط"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[23,"آليت حلفة بر غير ذي دخل","https://www.aldiwan.net/poem21398.html","البسيط"],[23,"سائل قريشا وأحلافها","https://www.aldiwan.net/poem21470.html","المتقارب"],[53,"آليت أهجو كريما عند نبوته","https://www.aldiwan.net/poem66339.html","البسيط"],[53,"يا من قسا لما شكوت","https://www.aldiwan.net/poem66509.html","مجزوء الكامل"],[93,"خبروني ماذا رأيتم أأطفالا","https://www.aldiwan.net/poem62818.html","عموديه"],[34,"صدت بثينة عني أن سعى ساع","https://www.aldiwan.net/poem27806.html","البسيط"],[87,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[87,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[64,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[47,"قلب مشوق عناه البث والكمد","https://www.aldiwan.net/poem62734.html","البسيط"],[47,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[47,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[47,"أكثر هذي الخطوب أشكال","https://www.aldiwan.net/poem65601.html","المنسرح"],[63,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[18,"أكثرت قتل بني بكر بربهم","https://www.aldiwan.net/poem23957.html","البسيط"],[89,"ما لي بودك بعد اليوم إلمام","https://www.aldiwan.net/poem8263.html","البسيط"],[76,"آليت إلا أن تسير مع الفضل","https://www.aldiwan.net/poem13226.html","الطويل"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[77,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[52,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[52,"عامت سليمى ومسها سغب","https://www.aldiwan.net/poem64838.html","المنسرح"],[52,"بأبي وأمي من يقاربني","https://www.aldiwan.net/poem64843.html","الكامل"],[48,"أطعت في الأيام سداجي","https://www.aldiwan.net/poem22269.html","السريع"],[48,"آليت ما مثري الزمان وإن طغى","https://www.aldiwan.net/poem22416.html","الكامل"],[48,"أصبحت غير مميز من عالم","https://www.aldiwan.net/poem22562.html","الكامل"],[48,"دنياك تشبه ناضحا متردا","https://www.aldiwan.net/poem22575.html","الكامل"],[48,"لا علم لي بم يختم العمر","https://www.aldiwan.net/poem22588.html","الكامل"],[48,"ما للبصائر لا تخلو من السدر","https://www.aldiwan.net/poem22660.html","البسيط"],[48,"أصحاب ليكة أهلكوا بظهيرة","https://www.aldiwan.net/poem22698.html","الكامل"],[48,"يا نفس آه لمتجر متنزر","https://www.aldiwan.net/poem22699.html","الكامل"],[48,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[48,"إن هللت أفواهكم فقلوبكم","https://www.aldiwan.net/poem23175.html","الكامل"],[48,"آليت أرغب في قميص مموه","https://www.aldiwan.net/poem23249.html","الكامل"],[48,"يا بدوي اتق المدامة إن ال","https://www.aldiwan.net/poem23539.html","المنسرح"],[78,"هلا ابتكرت لبين أنت مبتكر","https://www.aldiwan.net/poem39317.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[92,"سيصدني وأصده","https://www.poetsgate.com/ViewPoem.aspx?id=179085",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[47,"أرَيْتُكَ الآنَ ألَمْعُ البُرُوقْ","https://www.poetsgate.com/ViewPoem.aspx?id=32839",""],[48,"أصحابُ لَيْكَةَ أُهلِكوا بظَهيرَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20273",""],[48,"آلَيتُ ما مُثري الزّمانِ، وإن طَغا،","https://www.poetsgate.com/ViewPoem.aspx?id=18519",""],[111,"تلك ربوع الحي في سفح النقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545619",""],[124,"مسافة الشمس دون أقربه","https://www.aldiwan.net/poem49373.html","المنسرح"],[173,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[197,"قد كان من زهرات العيش لي غصن","https://www.aldiwan.net/poem13160.html","البسيط"],[199,"علاني الشيب واشتعل اشتعالا","https://www.aldiwan.net/poem54419.html","الوافر"],[201,"بما أودعته فيها","https://www.aldiwan.net/poem39940.html","مجزوء الوافر"],[233,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[239,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[239,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[245,"مباسم الثغر ما أحلى حمياك","https://www.aldiwan.net/poem45769.html","البسيط"],[284,"يا سيد الحكام هل من وقفة","https://www.aldiwan.net/poem60786.html","الكامل"],[285,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[286,"ما فتكات البيض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[302,"آليت في حبك رعي العهد","https://www.aldiwan.net/poem36315.html","عموديه"],[309,"إحسان مثلك محفوظ عن الكلف","https://www.aldiwan.net/poem56475.html","البسيط"],[326,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[368,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[373,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[375,"ملتمسا صلح الليالي ومن","https://www.aldiwan.net/poem57510.html","السريع"],[381,"ما لي بأوطان أخص صفاتها","https://www.aldiwan.net/poem59260.html","الكامل"],[384,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[406,"أضعت العمر في إصلاح حالك","https://www.aldiwan.net/poem47007.html","الوافر"],[410,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[410,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[433,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[455,"سقى الله أياما بغوطة جلق","https://www.aldiwan.net/poem13687.html","الطويل"],[461,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[461,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[461,"الآن إذ برد السلو ظمائي","https://www.aldiwan.net/poem56313.html","الكامل"],[467,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[480,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[480,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[480,"دم أريق بأسياف الهوى هدر","https://www.aldiwan.net/poem15236.html","البسيط"],[480,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[482,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[503,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[539,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"],[565,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[570,"من يبك من وجد على هالك","https://www.aldiwan.net/poem69768.html","السريع"],[579,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"],[815,"","https://poetry.dctabudhabi.ae/diwan/poem/123316","الكامل"],[863,"","https://poetry.dctabudhabi.ae/diwan/poem/123624","الكامل"],[940,"","https://poetry.dctabudhabi.ae/diwan/poem/9608","البسيط"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/20669","السريع"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/20661","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/31396","الطويل"]],"verses":[["آلَيتُ لا أَحفِلُ في نَصِّها","إِن مَرَجَ الغَرضُ وَرَثَّ الخِطام",0,"م",1,0],["آلَيتُ أَن أَحدو بِأَعراضِكُم","حَدوَ أَبي عُروَةَ بِالجامِلِ",1,"ل",1,0],["آلَيتُ لا أَمشي إِلى رَبِّ لِقحَةٍ","أُساوِمُهُ حَتّى يَؤوبَ المُثَلَّمُ",2,"م",1,1],["آلَيتُ لا نُعطيهِ مِن أَبنائِنا","رُهناً فَيُفسِدَهُم كَمَن قَد أَفسَدا",3,"د",2,0],["آلَيتُ لا آتي بُخارى بَعدَها","وَلَو انَّها في الأَرضِ دارُ خُلودِ",4,"د",1,1],["إِلى تَلَعاتِ الخُرجِ غَيَّرَ رَسمَها","هَمائِمُ هَطّالٍ مِنَ الدَلوِ مُدجِنِ",5,"ن",1,0],["إلى توائم أصغى من أجنتها","وساوسَ عنها قابت القُوَبُ",6,"ب",1,1],["الى تَوأمٍ كأنَّها قَرَدَ العِهنِ","بِبَيدَاءَ لأُمِّها الزَّغَبُ",7,"ب",1,0],["آلَيتُ حَلفَةَ بَرٍّ غَيرِ ذي دَخَلٍ","مِنّي أَلِيَّةَ بَرٍّ غَيرِ إِفنادِ",8,"د",1,1],["إِلى تَغلِبٍ إِنَّهُم شَرُّ جيلٍ","فَلَيسَ لَكُم غَيرَهُم مَذهَبُ",9,"ب",1,0],["آليتُ أهجو كريماً عند نبوته","ولا لئيماً وإنْ أكدى وإنْ شتما",10,"م",2,1],["آليتُ لا أهجو طِوا","لَ الدهر إلا من هجاني",11,"ن",2,0],["اليَتيمُ الَّذي يَلوحُ زَرِيّاً","لَيسَ شَيئاً لَو تَعلَمونَ زَرِيّا",12,"ي",2,0],["آلَيتُ لا أَصطَفي بِالحُبِّ غَيرَكُمُ","حَتّى أُغَيَّبَ تَحتَ الرَمسِ بِالقاعِ",13,"ع",1,0],["إلى تراوح العشب","إلى رشاقة القضب",14,"ب",1,0],["اليَتامى نُوَّحٌ ناحِيَةً","وَالمَساكينُ يَمُدّونَ الرَنين",15,"ن",1,0],["آليتَ ألّا يحطَّ النومُ أرحُلَه","حتى تنالَ على رُغمٍ أقاصيكا",16,"ك",2,0],["آلَيتُ لا أَجعَلُ الإِعدامَ حادِثَةً","تُخشى وَعيسى بنُ إِبراهيمَ لي سَنَدُ",17,"د",1,0],["اَلَيتُ لا يَثنينَ جَدّاً صاعِداً","في مَطلَبٍ حَتّى يُنِخنَ بِصاعِدِ",18,"د",1,0],["آلَيتُ لا أَجهَدُ الطائِيَّ مُلتَمِساً","جَدوى وَلا أَسأَلُ الطائِيَّ إِلحافا",19,"ف",2,0],["آلَيتُ لا أَشرَبُ مَمزوجَةً","إِن لَم تَكُن مَزجَةَ ريقٍ بِريق",20,"ق",1,0],["آلَيتُ لا يَستَفِزُّني الطَمَعُ","المُغري وَلا يَستَغِرُّني الآلُ",21,"ل",1,0],["آليتُ لا أُهدي كرائمَ مَنْطِقي","إلا إلى المَلِكِ الكريمِ العُنْصُرِ",22,"ر",1,0],["آلَيتُ بِاللَهِ لا أَرضى بِقَتلِهِم","حَتّى أُبَهرِجَ بَكراً أَينَما وُجِدوا",23,"د",3,0],["آلَيْتُ أَكْذِبُ نَفْسِي بَعْدَهَا سَفَهَاً","إِنَّ الْمُنَى عِنْدَ صِدْقِ النَّفْسِ أَوْهَامُ",24,"م",1,0],["آلَيتُ إِلّا أَن تَسيرَ مَعَ الفَضلِ","وَأَزمَعتَ إِلّا أَن تَصُمَّ عَنِ العَذلِ",25,"ل",1,1],["إلى تُرْبَةٍ ضَمَّ الأَمانَةَ وَالتُّقَى","بها وَالنَّدَى وَالفضْلَ مِنْ أَحْمَدٍ لَحْدُ",26,"د",1,0],["آليتُ أصدُرُ عن بحارك بعدما","قِستُ البحار بها فكنّ سرابا",27,"ب",2,0],["آلَيتُ أَرضى بِالَّذي سُمتَني","أَو يَبعَثَ المَوتى لَنا باعِثُ",28,"ث",1,0],["آلَيتُ يَأبى الصِبا وَأَتبَعَهُ","هَيهاتَ بَيني وَبَينَهُ نَجَبُ",29,"ب",1,0],["آلَيتُ لا أَسلى مَوَدَّتُهُ","لَو ما تَسَلّى الماءَ شارِبُهُ",30,"ب",2,0],["آلَيتُ ما أَدري وَلا عالَمي","مِن كَوكَبي في الحِندِسِ الداجي",31,"ج",2,0],["آلَيتُ ما مُثري الزَمانِ وَإِن طَغى","مُثرٍ وَلا مَسعودُهُ مَسعودُ",32,"د",1,1],["آلَيتُ لا يَدري بِما هُوَ كائِنٌ","مُتَفائِلٌ بِالأَمرِ أَو مُتَطَيِّرُ",33,"ر",1,0],["آلَيتُ ما الحِبرُ المِدادُ بِكاذِبٍ","بَل تَكذِبُ العُلَماءُ وَالأَحبارُ",34,"ر",1,0],["آلَيتُ ما في جيلِنا أَحَدٌ","يُختارُ لا زَيدٌ وَلا عَمرو",35,"ر",2,0],["آلَيتُ أُثني عَلى قَومٍ بِنُسكِهِمُ","وَقَد تَكَشَّفَ سَهلُ الأَرضِ عَن غَدَرِ",36,"ر",1,0],["آلَيتُ لا يَنفَكُّ جِسمِيَ في أَذاً","حَتّى يَعودَ إِلى قَديمِ العُنصُرِ",37,"ر",1,0],["آلَيتُ لَو رُزِقَ العَديمُ فَطانَةً","لَنَفى الهُمومَ وَباتَ غَيرَ مُحَسَّرِ",38,"ر",1,0],["آلَيتُ ما مَنَعَ الخُوارُ أَوابِداً","في هَضَبِ شابَةَ وَالنَقا الخَوّارِ",39,"ر",1,0],["آلَيتُ ما تَوراتُكُم بِمُنيرَةٍ","إِن أُلفِيَت فيها الكُمَيتُ مَحَلَّلَه",40,"ل",2,0],["آلَيتُ أَرغَبُ في قَميصِ مُمَوِّهٍ","فَأَكونَ شارِبَ حَنظَلٍ مِن حَنضَلِ",41,"ل",1,1],["آلَيتُ ما سَمَّحَت أَخا بَخلٍ","يَوماً وَلا شَجَّعَت أَخا جُبُنِ",42,"ن",1,0],["آلَيتُ ألا أرى شمساً ولا قمراً","حتى أرَاكَ فأنتَ الشمسُ والقمرُ",43,"ر",1,0],["آلَيْتَ بِالحُسْنَى أَلِيَّةَ عَارِفٍ","بعُلُوِّهَا عَنْ شُبْهَةٍ مِنْ كَاذِبِ",44,"ب",1,0],["آليت أقتحم الجحي","م على جواد من ذنوبي",45,"ب",2,0],["آليت لكني ارعوي","ت وقلت يا نفسي اهدئي بي",45,"ب",2,0],["آليت لا تعلو يدي يد أمرء","يسلفها اللؤم ويطغيها الغنى",46,"ا",1,0],["آليت لا أنفك أندب أثرهم","ما دام تذرف أعين الأحجار",47,"ر",1,0],["آليت أني حربُ من","ناوى البلاد وضده",48,"د",2,0],["آليتُ أقْتَحمَ الطُغاةَ مُصَرِّحاً","إذ لم أُعَوَّدْ أنْ أكونَ الرّائبا",49,"ب",2,0],["آلَيْتُ لا أشرَبُ مَمْزُوجَةً،","إنْ لمْ يَكُنْ مَزْجةُ رِيقٍ برِيقْ",50,"ق",1,0],["آلَيْتُ لا يَنفَكُّ جسْميَ في أذًى،","حتى يَعودَ إلى قَديمِ العُنصُر",51,"ر",1,0],["آلَيتُ ما مُثري الزّمانِ، وإن طَغا،","مُثرٍ، ولا مسعودُهُ مسعودُ",52,"د",1,1],["آليت لا تعلو يدي يد أمرء","يسفلها اللؤم ويطغيها الغنى",53,"ا",1,0],["آليت لا يستخفني أملٌ","في الغد أو تستغرني حسنه",54,"ن",2,0],["آلَيتُ أَنفَكُّ مِن حِلٍّ وَمُرتَحَلٍ","أَو أَن تَقولَ لِيَ الآمالُ خُذ وَدَعِ",55,"ع",1,0],["آليتُ لا أَقتَني عَلَقاً بِقاسمِه","أَيدي الرَدى قَسَماً يَوماً أُواليهِ",56,"ي",2,0],["أَلَيتُكَ ثُمَّ عُدتُ فَعُد بِخَيرٍ","وَخَيرُ الخَيرِ ما يُجرى عِلالا",57,"ل",2,0],["إلى تلكَ التي في أضلُ","عي قلبي يُناجيها",58,"ي",3,0],["آليتُ لا ذقتُ المنا","مَ ولا اضطجعْتُ على حَشِيّه",59,"ي",2,0],["آلَيتُ لا أَمدُد إِلى أَمدٍ يَدي","إِلّا إِلَيكَ وَلا لَواها مَطمَعُ",60,"ع",1,0],["آلَيتُ لا اِمتَدَّت يَدي إِلّا إِلى","مَن تَملَأُ الأَرضَ الفَضاءَ هِباتُهُ",61,"ت",2,0],["آليتُ لا يأتلى سهماك يعتورا ال","فأصبح الناسُ كل الناس قتلاكِ",62,"ك",1,0],["آلَيْتُ لاَ أَبْغِي نَداكَ بِشَافِعٍ","مَالِي إِلَيْكَ وَسِيلَةٌ إِلاَّكا",63,"ك",2,0],["آليت أبكي فقيداً لست أخلفه","ما عشت والبرّ من قد برَّ إذ حلفا",64,"ف",2,0],["آلَيتُ لا أَسمَعُ فيهِم واشِياً","يُزَخرِفُ القَولَ وَمَن يَسمَع يَخَل",65,"ل",1,0],["آليتُ في حبّكِ رعيَ العهدِ","حتى أبيت هامةً في لحدي",66,"ي",1,1],["آليتَ حلفةَ برٍّ لا تُجشّمني","لكَ النزولَ الّذي يعلو به شرفي",67,"ف",2,0],["آلَيتُ جَهداً وَصادِقٌ قَسَمي","بِرَبِّ عَبدٍ تَجُنُّهُ الكُرُحُ",68,"ح",1,0],["آلَيتُ لا أشْكُوَنْ مَن قد كَلِفْتُ به","ولو تَبدَّلْتُ من وَصْلٍ بهِجْران",69,"ن",1,0],["آليت لا أوليت غيرك مدحةً","شعراً وإن أفعل فمدحةُ مكره",70,"ه",1,0],["آليتُ لا استعديتُ إلا فتىً","أعدى عليهنَّ من الصبحِ",71,"ح",1,0],["آليت أني لا أقيم بأرضها","أبداً ولو أن الكليم كليمها",72,"م",3,0],["إِلى تَمام سنةٍ","تَلوح تَحتَ الطرر",73,"ر",1,0],["إليَّ تَزَيّنينَ لِتَخْدَعيني","فما أَبْصَرتُ أقبحَ مِنْ جمالِكْ",74,"ك",1,0],["آليت أستَسقي الغَمائِم بَعدَها","وَيَمين حَيدرة الغِمامِ الأَكبَرُ",75,"ر",1,0],["آلَيت استَسقي سِوى مَنصِلي","إِن الغَوادي بِمُرادي شحاح",76,"ح",1,0],["اليت لا ادعُ التغزل والهوى","حتى ألاقي ما لقى أشباهي",77,"ا",3,0],["إِلى تلعات السفح من قاسيونها","مدارج داري الصبا المتأرج",78,"ج",1,0],["آليتُ لا أحملُ فَرضَ العلا","ونفلَها إلا على حاملِ",79,"ل",1,0],["آليتُ لا أصحبُ ذلّاً كارهاً","يوماً ولا آملُ رفداً طائعا",80,"ع",2,0],["آليتُ لا رَقَبَ الكواكبَ ناظري","شوقا ولا مَسَحَ الدموعَ ردائي",81,"ي",1,0],["آليتُ ألفي خاضعاً لممدّحٍ","إلاك إنَّ النّجم دونكَ يخضع",82,"ع",1,0],["آليتُ ما الغيثُ بدًا","مُبرِقُهُ ومُرعِدُه",83,"د",2,0],["آليتُ ما هتفتْ ورقاءُ في فَنَنٍ","ولا تأَلَّقَ برقُ المزنِ أو لَمَعا",84,"ع",2,0],["آليتُ لاحِلتُ عن دينِ الوفاءِ كما","قد كانَ يعهدُ من حالي واِنْ غدروا",85,"ر",3,0],["آليتُ لا حِلْتُ ولا حِلْتُمُ","عن كلَّ ما أعهدُهُ منكمُ",86,"م",1,1],["اليتم واليم في البيتين دمعهما","على المصابين جار في مجاريه",87,"ي",2,0],["أَلِيَّتُهُمْ وَثيقُ العَهْدِ منهُ","على زُهْدٍ فيا نِعْمَ الأَلِيَّهْ",88,"ي",2,0],["إِلى تَوحيدِ خَلّاقِ البَرايا","وَكُفرٍ بِالحِجارَةِ وَاللِخافِ",89,"ف",1,0],["إلى تُرابٍ جُبِلْنا منهُ مَرجِعُنا","نظيرَ ماءٍ إليه يَرجِعُ البرَدُ",90,"د",1,0],["إلى تحِيّاتٍ لِطَافٍ بها","تُسْكِنُ مِنِّي مُهْجةً مُزعَجَهْ",91,"ج",2,0],["آلَيتَ حَبَّ العِراقِ الدَهرَ أَطعَمُهُ","وَالحَبُّ يَأكلُهُ في القَريَةِ السوسُ",92,"س",1,0],["آلَيتُ أَمدَحُ مقرفاً أبَداً","يَبقى المَديحُ وَيَذهَبُ الرفدُ",93,"د",1,0],["آليت أنسى معشري أبداً","حتى يزول بأهله الهضب",94,"ب",1,0],["إِلى تَميمٍ حُماةِ الثَغرِ نِسبَتُهُم","وَكُلِّ ذي حَسَبٍ في الناسِ مَنسوبِ",95,"ب",1,0],["آَلَيتُ لا أَبكي عَلى هالِكٍ","بَعدَ رَسولِ اللَهِ خَيرُ الأَنامِ",96,"م",1,1],["آَليتُ لِلّه حَجّاً حافياً رَجُلاً","إِن جاوزَ النَخلُ يَمشي وَهُوَ مُندَفِعُ",97,"ع",1,1],["إِلى تَغلِبٍ قُبّاً تَضِبُّ لِثاثُها","وَتُقحِمُها أَجوازَ كُلِّ هُيامِ",98,"م",1,0]]}