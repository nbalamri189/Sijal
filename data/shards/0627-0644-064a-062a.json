tps://www.poetsgate.com/ViewPoem.aspx?id=198550",""],[5277,"نهرٌ وقنطرة","https://www.poetsgate.com/ViewPoem.aspx?id=210830",""],[592,"تبكي على رسم دارٍ دارس بال","https://www.poetsgate.com/ViewPoem.aspx?id=128863",""],[5411,"هذا غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=185524",""],[5411,"أسْعِفْ بنورك","https://www.poetsgate.com/ViewPoem.aspx?id=185785",""],[5431,"لغزة قد خرّ الفؤادُ تألما","https://www.poetsgate.com/ViewPoem.aspx?id=189720",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5573,"تدرين انا محتار ياكثر اساميك","https://www.poetsgate.com/ViewPoem.aspx?id=200072",""],[5573,"نيات قلبك يالوفي مخشوشه","https://www.poetsgate.com/ViewPoem.aspx?id=204548",""],[5596,"عفواً فقد أصمانيٓ الجٓدّ","https://www.poetsgate.com/ViewPoem.aspx?id=205489",""],[5616,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=205028",""],[5652,"نايح الورق","https://www.poetsgate.com/ViewPoem.aspx?id=208685",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5732,"الله كفيل الناس وارضه وسيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177863",""],[5736,"لا ماذا ولا أين","https://www.poetsgate.com/ViewPoem.aspx?id=208212",""],[5790,"أأبا المظفر يوسف بن محمد","https://www.poetsgate.com/ViewPoem.aspx?id=112035",""],[5804,"ذئب","https://www.poetsgate.com/ViewPoem.aspx?id=195160",""],[5848,"الشيخ عبدالعزيز بن جامع","https://www.poetsgate.com/ViewPoem.aspx?id=53333",""],[5894,"أبسحر عينك قد وصلت بكائي","https://www.poetsgate.com/ViewPoem.aspx?id=131410",""],[5937,"صلاةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211799",""],[5944,"كلاسيكية","https://www.poetsgate.com/ViewPoem.aspx?id=214285",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[6102,"خرف أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183985",""],[6205,"أشواق الخوابي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88156&r=&rc=8",""],[6235,"قبور الأمهات..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77690&r=&rc=5",""],[3099,"أبعد خمسينَ أصبو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59189&r=&rc=13",""],[572,"منْ يَبْكِ من وجدٍ على هالِكٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9191&r=&rc=48",""]],"verses":[["آلَيتُ لا أَحفِلُ في نَصِّها","إِن مَرَجَ الغَرضُ وَرَثَّ الخِطام",0,"م",1,0],["آلَيتُ أَن أَحدو بِأَعراضِكُم","حَدوَ أَبي عُروَةَ بِالجامِلِ",1,"ل",1,0],["آلَيتُ لا أَمشي إِلى رَبِّ لِقحَةٍ","أُساوِمُهُ حَتّى يَؤوبَ المُثَلَّمُ",2,"م",1,1],["آلَيتُ لا نُعطيهِ مِن أَبنائِنا","رُهناً فَيُفسِدَهُم كَمَن قَد أَفسَدا",3,"د",2,0],["آلَيتُ لا آتي بُخارى بَعدَها","وَلَو انَّها في الأَرضِ دارُ خُلودِ",4,"د",1,1],["إِلى تَلَعاتِ الخُرجِ غَيَّرَ رَسمَها","هَمائِمُ هَطّالٍ مِنَ الدَلوِ مُدجِنِ",5,"ن",1,0],["إلى توائم أصغى من أجنتها","وساوسَ عنها قابت القُوَبُ",6,"ب",1,1],["الى تَوأمٍ كأنَّها قَرَدَ العِهنِ","بِبَيدَاءَ لأُمِّها الزَّغَبُ",7,"ب",1,0],["آلَيتُ حَلفَةَ بَرٍّ غَيرِ ذي دَخَلٍ","مِنّي أَلِيَّةَ بَرٍّ غَيرِ إِفنادِ",8,"د",1,1],["إِلى تَغلِبٍ إِنَّهُم شَرُّ جيلٍ","فَلَيسَ لَكُم غَيرَهُم مَذهَبُ",9,"ب",1,0],["آليتُ أهجو كريماً عند نبوته","ولا لئيماً وإنْ أكدى وإنْ شتما",10,"م",2,1],["آليتُ لا أهجو طِوا","لَ الدهر إلا من هجاني",11,"ن",2,0],["اليَتيمُ الَّذي يَلوحُ زَرِيّاً","لَيسَ شَيئاً لَو تَعلَمونَ زَرِيّا",12,"ي",2,0],["آلَيتُ لا أَصطَفي بِالحُبِّ غَيرَكُمُ","حَتّى أُغَيَّبَ تَحتَ الرَمسِ بِالقاعِ",13,"ع",1,0],["إلى تراوح العشب","إلى رشاقة القضب",14,"ب",1,0],["اليَتامى نُوَّحٌ ناحِيَةً","وَالمَساكينُ يَمُدّونَ الرَنين",15,"ن",1,0],["آليتَ ألّا يحطَّ النومُ أرحُلَه","حتى تنالَ على رُغمٍ أقاصيكا",16,"ك",2,0],["آلَيتُ لا أَجعَلُ الإِعدامَ حادِثَةً","تُخشى وَعيسى بنُ إِبراهيمَ لي سَنَدُ",17,"د",1,0],["اَلَيتُ لا يَثنينَ جَدّاً صاعِداً","في مَطلَبٍ حَتّى يُنِخنَ بِصاعِدِ",18,"د",1,0],["آلَيتُ لا أَجهَدُ الطائِيَّ مُلتَمِساً","جَدوى وَلا أَسأَلُ الطائِيَّ إِلحافا",19,"ف",2,0],["آلَيتُ لا أَشرَبُ مَمزوجَةً","إِن لَم تَكُن مَزجَةَ ريقٍ بِريق",20,"ق",1,0],["آلَيتُ لا يَستَفِزُّني الطَمَعُ","المُغري وَلا يَستَغِرُّني الآلُ",21,"ل",1,0],["آليتُ لا أُهدي كرائمَ مَنْطِقي","إلا إلى المَلِكِ الكريمِ العُنْصُرِ",22,"ر",1,0],["آلَيتُ بِاللَهِ لا أَرضى بِقَتلِهِم","حَتّى أُبَهرِجَ بَكراً أَينَما وُجِدوا",23,"د",3,0],["آلَيْتُ أَكْذِبُ نَفْسِي بَعْدَهَا سَفَهَاً","إِنَّ الْمُنَى عِنْدَ صِدْقِ النَّفْسِ أَوْهَامُ",24,"م",1,0],["آلَيتُ إِلّا أَن تَسيرَ مَعَ الفَضلِ","وَأَزمَعتَ إِلّا أَن تَصُمَّ عَنِ العَذلِ",25,"ل",1,1],["إلى تُرْبَةٍ ضَمَّ الأَمانَةَ وَالتُّقَى","بها وَالنَّدَى وَالفضْلَ مِنْ أَحْمَدٍ لَحْدُ",26,"د",1,0],["آليتُ أصدُرُ عن بحارك بعدما","قِستُ البحار بها فكنّ سرابا",27,"ب",2,0],["آلَيتُ أَرضى بِالَّذي سُمتَني","أَو يَبعَثَ المَوتى لَنا باعِثُ",28,"ث",1,0],["آلَيتُ يَأبى الصِبا وَأَتبَعَهُ","هَيهاتَ بَيني وَبَينَهُ نَجَبُ",29,"ب",1,0],["آلَيتُ لا أَسلى مَوَدَّتُهُ","لَو ما تَسَلّى الماءَ شارِبُهُ",30,"ب",2,0],["آلَيتُ ما أَدري وَلا عالَمي","مِن كَوكَبي في الحِندِسِ الداجي",31,"ج",2,0],["آلَيتُ ما مُثري الزَمانِ وَإِن طَغى","مُثرٍ وَلا مَسعودُهُ مَسعودُ",32,"د",1,1],["آلَيتُ لا يَدري بِما هُوَ كائِنٌ","مُتَفائِلٌ بِالأَمرِ أَو مُتَطَيِّرُ",33,"ر",1,0],["آلَيتُ ما الحِبرُ المِدادُ بِكاذِبٍ","بَل تَكذِبُ العُلَماءُ وَالأَحبارُ",34,"ر",1,0],["آلَيتُ ما في جيلِنا أَحَدٌ","يُختارُ لا زَيدٌ وَلا عَمرو",35,"ر",2,0],["آلَيتُ أُثني عَلى قَومٍ بِنُسكِهِمُ","وَقَد تَكَشَّفَ سَهلُ الأَرضِ عَن غَدَرِ",36,"ر",1,0],["آلَيتُ لا يَنفَكُّ جِسمِيَ في أَذاً","حَتّى يَعودَ إِلى قَديمِ العُنصُرِ",37,"ر",1,0],["آلَيتُ لَو رُزِقَ العَديمُ فَطانَةً","لَنَفى الهُمومَ وَباتَ غَيرَ مُحَسَّرِ",38,"ر",1,0],["آلَيتُ ما مَنَعَ الخُوارُ أَوابِداً","في هَضَبِ شابَةَ وَالنَقا الخَوّارِ",39,"ر",1,0],["آلَيتُ ما تَوراتُكُم بِمُنيرَةٍ","إِن أُلفِيَت فيها الكُمَيتُ مَحَلَّلَه",40,"ل",2,0],["آلَيتُ أَرغَبُ في قَميصِ مُمَوِّهٍ","فَأَكونَ شارِبَ حَنظَلٍ مِن حَنضَلِ",41,"ل",1,1],["آلَيتُ ما سَمَّحَت أَخا بَخلٍ","يَوماً وَلا شَجَّعَت أَخا جُبُنِ",42,"ن",1,0],["آلَيتُ ألا أرى شمساً ولا قمراً","حتى أرَاكَ فأنتَ الشمسُ والقمرُ",43,"ر",1,0],["آلَيْتَ بِالحُسْنَى أَلِيَّةَ عَارِفٍ","بعُلُوِّهَا عَنْ شُبْهَةٍ مِنْ كَاذِبِ",44,"ب",1,0],["آليت أقتحم الجحي","م على جواد من ذنوبي",45,"ب",2,0],["آليت لكني ارعوي","ت وقلت يا نفسي اهدئي بي",45,"ب",2,0],["آليت لا تعلو يدي يد أمرء","يسلفها اللؤم ويطغيها الغنى",46,"ا",1,0],["آليت لا أنفك أندب أثرهم","ما دام تذرف أعين الأحجار",47,"ر",1,0],["آليت أني حربُ من","ناوى البلاد وضده",48,"د",2,0],["آليتُ أقْتَحمَ الطُغاةَ مُصَرِّحاً","إذ لم أُعَوَّدْ أنْ أكونَ الرّائبا",49,"ب",2,0],["آلَيْتُ لا أشرَبُ مَمْزُوجَةً،","إنْ لمْ يَكُنْ مَزْجةُ رِيقٍ برِيقْ",50,"ق",1,0],["آلَيْتُ لا يَنفَكُّ جسْميَ في أذًى،","حتى يَعودَ إلى قَديمِ العُنصُر",51,"ر",1,0],["آلَيتُ ما مُثري الزّمانِ، وإن طَغا،","مُثرٍ، ولا مسعودُهُ مسعودُ",52,"د",1,1],["آليت لا تعلو يدي يد أمرء","يسفلها اللؤم ويطغيها الغنى",53,"ا",1,0],["آليت لا يستخفني أملٌ","في الغد أو تستغرني حسنه",54,"ن",2,0],["آلَيتُ أَنفَكُّ مِن حِلٍّ وَمُرتَحَلٍ","أَو أَن تَقولَ لِيَ الآمالُ خُذ وَدَعِ",55,"ع",1,0],["آليتُ لا أَقتَني عَلَقاً بِقاسمِه","أَيدي الرَدى قَسَماً يَوماً أُواليهِ",56,"ي",2,0],["أَلَيتُكَ ثُمَّ عُدتُ فَعُد بِخَيرٍ","وَخَيرُ الخَيرِ ما يُجرى عِلالا",57,"ل",2,0],["إلى تلكَ التي في أضلُ","عي قلبي يُناجيها",58,"ي",3,0],["آليتُ لا ذقتُ المنا","مَ ولا اضطجعْتُ على حَشِيّه",59,"ي",2,0],["آلَيتُ لا أَمدُد إِلى أَمدٍ يَدي","إِلّا إِلَيكَ وَلا لَواها مَطمَعُ",60,"ع",1,0],["آلَيتُ لا اِمتَدَّت يَدي إِلّا إِلى","مَن تَملَأُ الأَرضَ الفَضاءَ هِباتُهُ",61,"ت",2,0],["آليتُ لا يأتلى سهماك يعتورا ال","فأصبح الناسُ كل الناس قتلاكِ",62,"ك",1,0],["آلَيْتُ لاَ أَبْغِي نَداكَ بِشَافِعٍ","مَالِي إِلَيْكَ وَسِيلَةٌ إِلاَّكا",63,"ك",2,0],["آليت أبكي فقيداً لست أخلفه","ما عشت والبرّ من قد برَّ إذ حلفا",64,"ف",2,0],["آلَيتُ لا أَسمَعُ فيهِم واشِياً","يُزَخرِفُ القَولَ وَمَن يَسمَع يَخَل",65,"ل",1,0],["آليتُ في حبّكِ رعيَ العهدِ","حتى أبيت هامةً في لحدي",66,"ي",1,1],["آليتَ حلفةَ برٍّ لا تُجشّمني","لكَ النزولَ الّذي يعلو به شرفي",67,"ف",2,0],["آلَيتُ جَهداً وَصادِقٌ قَسَمي","بِرَبِّ عَبدٍ تَجُنُّهُ الكُرُحُ",68,"ح",1,0],["آلَيتُ لا أشْكُوَنْ مَن قد كَلِفْتُ به","ولو تَبدَّلْتُ من وَصْلٍ بهِجْران",69,"ن",1,0],["آليت لا أوليت غيرك مدحةً","شعراً وإن أفعل فمدحةُ مكره",70,"ه",1,0],["آليتُ لا استعديتُ إلا فتىً","أعدى عليهنَّ من الصبحِ",71,"ح",1,0],["آليت أني لا أقيم بأرضها","أبداً ولو أن الكليم كليمها",72,"م",3,0],["إِلى تَمام سنةٍ","تَلوح تَحتَ الطرر",73,"ر",1,0],["إليَّ تَزَيّنينَ لِتَخْدَعيني","فما أَبْصَرتُ أقبحَ مِنْ جمالِكْ",74,"ك",1,0],["آليت أستَسقي الغَمائِم بَعدَها","وَيَمين حَيدرة الغِمامِ الأَكبَرُ",75,"ر",1,0],["آلَيت استَسقي سِوى مَنصِلي","إِن الغَوادي بِمُرادي شحاح",76,"ح",1,0],["اليت لا ادعُ التغزل والهوى","حتى ألاقي ما لقى أشباهي",77,"ا",3,0],["إِلى تلعات السفح من قاسيونها","مدارج داري الصبا المتأرج",78,"ج",1,0],["آليتُ لا أحملُ فَرضَ العلا","ونفلَها إلا على حاملِ",79,"ل",1,0],["آليتُ لا أصحبُ ذلّاً كارهاً","يوماً ولا آملُ رفداً طائعا",80,"ع",2,0],["آليتُ لا رَقَبَ الكواكبَ ناظري","شوقا ولا مَسَحَ الدموعَ ردائي",81,"ي",1,0],["آليتُ ألفي خاضعاً لممدّحٍ","إلاك إنَّ النّجم دونكَ يخضع",82,"ع",1,0],["آليتُ ما الغيثُ بدًا","مُبرِقُهُ ومُرعِدُه",83,"د",2,0],["آليتُ ما هتفتْ ورقاءُ في فَنَنٍ","ولا تأَلَّقَ برقُ المزنِ أو لَمَعا",84,"ع",2,0],["آليتُ لاحِلتُ عن دينِ الوفاءِ كما","قد كانَ يعهدُ من حالي واِنْ غدروا",85,"ر",3,0],["آليتُ لا حِلْتُ ولا حِلْتُمُ","عن كلَّ ما أعهدُهُ منكمُ",86,"م",1,1],["اليتم واليم في البيتين دمعهما","على المصابين جار في مجاريه",87,"ي",2,0],["أَلِيَّتُهُمْ وَثيقُ العَهْدِ منهُ","على زُهْدٍ فيا نِعْمَ الأَلِيَّهْ",88,"ي",2,0],["إِلى تَوحيدِ خَلّاقِ البَرايا","وَكُفرٍ بِالحِجارَةِ وَاللِخافِ",89,"ف",1,0],["إلى تُرابٍ جُبِلْنا منهُ مَرجِعُنا","نظيرَ ماءٍ إليه يَرجِعُ البرَدُ",90,"د",1,0],["إلى تحِيّاتٍ لِطَافٍ بها","تُسْكِنُ مِنِّي مُهْجةً مُزعَجَهْ",91,"ج",2,0],["آلَيتَ حَبَّ العِراقِ الدَهرَ أَطعَمُهُ","وَالحَبُّ يَأكلُهُ في القَريَةِ السوسُ",92,"س",1,0],["آلَيتَ لا أَنفَكُّ عَهدَكَ راعِياً","حَتّى أُغَرَّبَ في التُرابِ مَهيلا",93,"ل",2,0],["آليتُ لا أمدحُ ذا نائلٍ","له سناءٌ وله مَفْخَرُ",94,"ر",1,0],["آليتُ لا أمدحُ ذا نائلٍ","من معشرٍ غير بني هاشمِ",95,"م",1,0],["إلى تربةٍ عادت عبيرا