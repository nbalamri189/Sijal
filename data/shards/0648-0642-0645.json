html","المتقارب"],[456,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[456,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[456,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[456,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[456,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[456,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[456,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[456,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[456,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[459,"غرس الخلافة لا فاتتك مكرمة","https://www.aldiwan.net/poem15396.html","البسيط"],[459,"جزيت نجيب الدين خيرا وانني","https://www.aldiwan.net/poem15911.html","الطويل"],[462,"يا غائباً لم تغب عني مكارمه","https://www.aldiwan.net/poem3315.html","عموديه"],[462,"خليلي ما بال الكؤوس عواطلا","https://www.aldiwan.net/poem3524.html","عموديه"],[464,"يقول خليلي باللوى من حفارة","https://www.aldiwan.net/poem50474.html","الطويل"],[466,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[477,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[484,"ألا هل فؤادي إذ صبا اليوم نازع","https://www.aldiwan.net/poem481.html",""],[498,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[498,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[498,"الحمد لله لي للمصطفى نسب","https://www.aldiwan.net/poem37811.html","البسيط"],[498,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[498,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[498,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[512,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[513,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[513,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[513,"من استعان بغير الله لم يعن","https://www.aldiwan.net/poem12278.html","البسيط"],[527,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[536,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[549,"أيا صاحبي إن لم تكن في شديدتي","https://www.aldiwan.net/poem48062.html","الطويل"],[551,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[556,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[556,"قلوب متى منه خلت فنفوس","https://www.aldiwan.net/poem34450.html","الطويل"],[560,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[565,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[573,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[573,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["وَقُمنا نَجُرُّ ذُيولَ الرَجا","وَتَرعى العُيونُ بُروقَ المُنى",0,"ا",1,0],["وَقُمْتُ فَقَرَّطتُ الأَغَرَّ عِنانَهُ","وَفي اليَدِ مَاضِي الشَّفْرَتَيْنِ يَمانِ",1,"ن",1,0],["وقُمْنا إِلى مُنْحَنى الوادِيَيْنِ","نَجُرُّ على أجْرَعَيْهِ الرِّدا",2,"ا",1,0],["وقُمْنا نَشاوَى عندَما متَعَ الضّحَى","كما نهَضَتْ غُلْبُ الأسودِ منَ الخِيسِ",3,"س",1,0],["وَقَمّاصَةٍ بِالآلِ داوَيتُ غَولَها","مِنَ البُعدِ بِالمُدرَنفِقاتِ الخَوانِفِ",4,"ف",1,0],["وقمت على البلاد مقام عيسى","على مَرضاه من عُميٍ وعُرج",5,"ج",1,0],["وَقُمتُ بِمَوشِيِّ المُتونِ كَأَنَّهُ","شِهابُ غَضاً في كَفِّ ساعٍ مُبادِرِ",6,"ر",1,0],["وَقُمنا نَسحَبُ الرَيطَ","إِلى حانَةِ خَمّارِ",7,"ر",1,0],["وقمتُ أشربُ من فيهِ وخمرتهِ","شرباً تُشَنُّ بهِ في العقلِ غارات",8,"ت",1,0],["وقمت أكسو بنيه من مدائحه","ما يرفل الملكُ في أثوابه الجدَدِ",9,"د",1,0],["وقمت بجاهه أشكو الليالي","كما تشكو الرّعية للأمير",10,"ر",1,0],["وقمتُ أذكره بالظبيِ ملتفتاً","فقالَ لي طرفهُ من غير تشبيه",11,"ي",2,0],["وَقَميصي قَطّعوهُ قطَعاً","وَدَعوا الكُلَّ دَفين زَمَنا",12,"ن",2,0],["وقمَ اللَّه بابن يحيى عن الأمْ","مَة شرّاً قد همَّ باستفحالِ",13,"ل",1,0],["وَقُمتُ فَقُلتُ لَهُ مَرحَباً","وَأَهلاً وَسَهلاً بِهَذا القَمَر",14,"ر",1,0],["وقميءٍ يُطاوِلُ الجَبَلَ العا","لي فللّه مَا أَشَدَّ غَبَاءهْ",15,"ا",2,0],["وقمتُ على النَّهرِ أَهْرقُ دمعاً","تفجَّرَ من فيضِ حُزني الأَليمْ",16,"م",1,0],["وقمت بالعبء عبء الدين تحمله","فما هنالك من نكص ومن خور",17,"ر",1,0],["وقمنا في شِراع الحق نلقى","وندفع عن جوانبه الرياحا",18,"ح",2,0],["وقمت تسطع بالأنوار في أفق","بالمسلمين وبالإسلام مزدان",19,"ن",1,0],["وَقُمتُم دونَها حَتّى خَضَبتُم","هَوادِجَها الشَريفَةَ وَالحِجالا",20,"ل",2,0],["وقُمْ أَنْتَ فاحْثُثْ كَأْسَها غَيْرَ صاغِرٍ","ولا تَسْقِ إِلاَّ خَمْرَها وَعُقَارَهَا",21,"ر",3,0],["وقمْ واجلُها من بناتِ الكُرو","مِ عذراءَ يفتضُّها ابنُ الغمامِ",22,"م",1,0],["وقُمتِ عليَّ بالغالي ولكن","تناولَكِ المنيةُ بالرخيصِ",23,"ص",1,0],["وَقُمتُ فَجَمَّعتُ الحَصى وَاِشتَوَيتُهُ","عَلَيهِ وَلِلرَمضاءِ مِن تَحتِهِ وَقدُ",24,"د",1,0],["وَقُمتَ مُستَسقِياً لِلمُسلِمينَ جَرَت","غُرُّ الغَمامِ وَحَلَّت مِن عَزاليها",25,"ي",3,0],["وَقُمنا إِلى دَهماءَ ضامِنَةِ القِرى","غَضوبٍ إِذا ما اِستَحمَلوها الأَثافِيا",26,"ي",2,0],["وقمنا نعطف الأزر","على العفة إذ قمنا",27,"ن",2,0],["وقمص حجارة نبجت بماء","ويلبسها الغني مع الفقير",28,"ر",1,1],["وقمت مقاما يترك السيف صاعدا","إذا ما التقى الصفان والرمح نازلا",29,"ل",2,0],["وَقُمتُ مَعَ المَقالِ مَقامَ عَتبٍ","تَوَهَّمَهُ الأَنامُ مَجالَ حَربِ",30,"ب",1,0],["وَقُم نَرتاحُ لِشُربِ الراحِ","فَلِلأَقداحِ سَناها زَينِ",31,"ن",1,0],["وَقَميصي دِرعٌ كَأَنَّ عُراها","حُبُكُ النَملِ أَو عُيونُ الجَرادِ",32,"د",1,0],["وقم نقضي الحقوقَ إذا دعينا","أليسَ الشرق يجمعنا حِمَاهُ",33,"ه",1,0],["وقم نسخر من الدنيا","وقم نَلهُ مع اللاهي",34,"ي",1,0],["وقمتُ نهوض العَوْدِ حُلّ عِقالُهُ","فأقعدَني المقدورُ عند قيامي",35,"ي",1,0],["وَقُمنا فَقُلنا بَعدَ أَن أُفرِدَ الثَرى","بِهِ ما يُقالُ في السَحابَةِ تُقلِعُ",36,"ع",1,0],["وَقُميرٌ بَدا اِبنُ خَمسٍ وَعِشري","نَ لَهُ قالَتِ الفَتاتانِ قوما",37,"م",2,0],["وَقُمنَ يُعَفّينَ آثارَنا","بِأَكسِيَةِ الخَزِّ أَن تُقفَرا",38,"ر",2,0],["وَقُمنَ يَقُلنَ لَوَ أَنَّ النَها","رَ مُدَّ لَهُ اللَيلُ فَاِستَأخَرا",38,"ر",2,0],["وَقُمتُ إِلى عَنسٍ تَخَوَّنَ نَيَّها","سُرى اللَيلِ حَتّى لَحمُها مُتَحَسِّرُ",39,"ر",1,0],["وقُمْنَ على الحَقِّ يَنْصُرْنَهُ","وقَامتْ وَراءَ الدُّروعِ الأُزُرْ",40,"ر",1,0],["وَقُمتُ أَجُرُّ أَوصالاً ثِقالاً","تُعاني المَوتَ مِمّا يَعتَريها",41,"ي",3,0],["وَقَمَعَ الجَورَ بِحُكمٍ عادِلِ","وَمَلَأَ الدينَ بِحَقٍّ شامِلِ",42,"ل",1,0],["وَقَمصُ حَديدٍ ضافِياتٌ ذُيولُها","لَها حَدَقٌ خُزرُ العُيونِ صِغارُ",43,"ر",1,0],["وَقُمتُ إِلى الكَومِ الصَفايا بِمُنصِلي","فَصَيَّرتُها مَجداً لِقَومي وَأَحسابا",44,"ب",2,0],["وَقُمرِيَّةِ الأَصواتِ حُمرٍ ثِيابُها","تُهينُ ثِيابَ الوَشيِ جَرّاً وَتَسحابا",44,"ب",2,0],["وَقُمتُ أَسحَبُ ذَيلي","عَن هازِلٍ بِالقُرانِ",45,"ن",1,0],["وقمتُ أسعى إليه مبتدراً","والقلب من سخطهِ على وجَل",46,"ل",1,0],["وَقُمتُ لَم أَقضِ مِنها إِذ خَلَوتُ بِها","إِلّا الحَديثَ وَإِلّا أَن أَمَسَّ يَدا",47,"د",2,0],["وقمنا بمرسوم العزاء لأجلهِ","ثلاثة أيام بها يقرأ الذكر",48,"ر",1,0],["وقمِيصاً يُبْلي الفتى كلَّ عام","وقميصايَ أدْرَكا أرْدَشيرا",49,"ر",2,0],["وقُمْ له يا أَعزَّ النَّاسِ كُلِّهِمُ","شخْصاً عليّ وأَولاهُمْ بتَكْرِيمِ",50,"م",1,0],["وَقُمْنَا وَكُلٌّ بَعْدَ مَا كَانَ لاهِياً","بِأَظْلالِهِ كُرْهَ الرَّحِيلِ مُنَغَّصُ",51,"ص",1,0],["وَقُمْتَ فِيهِمْ خَطيباً","لَهُ عَلَى الْقَوْلِ أَمْرُ",52,"ر",1,0],["وقمتُ أُطِلُّ من شَرَفٍ عليهم","فخانتني الدمُوعُ فما أُطلّ",53,"ل",1,0],["وقم بفن بك استقام فَمَا","ثمَّ لمولاي من يقاومه",54,"م",2,0],["وقمت اي برك هجان اعده","لوجبة حق نازل انا فاعله",55,"ل",2,0],["وَقُمْتُ فجَمّعتُ الحَصَى، فاشتَوَيتُه","عَلَيْهِ، وللرّمضَاءِ من تحته وَقْدُ",56,"د",1,0],["وَقُمْنَ يَقُلْنَ لَوَ انَّ کلنَّها","رَ مُدَّ لَهُ اللَّيْلُ، فَکسْتَأْخَرا",57,"ر",2,0],["وقم في مقام الشكر وانشر لواءهُ","برأس عمودٍ خذه