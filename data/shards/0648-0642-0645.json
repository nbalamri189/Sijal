{"poems":[[53,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[63,"خليلي بئس الرأي ما تريان","https://www.aldiwan.net/poem45933.html","الطويل"],[63,"هي العيس مبتذرات الخطا","https://www.aldiwan.net/poem46132.html","المتقارب"],[77,"عسى خطرة بالركب يا حادي العيس","https://www.aldiwan.net/poem35882.html","الطويل"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[88,"سمي المصطفى لا زلت تعلو","https://www.aldiwan.net/poem44816.html","الوافر"],[11,"صحا القلب من سلمى وعن أم عامر","https://www.aldiwan.net/poem246.html",""],[47,"تواعدنا بآذار","https://www.aldiwan.net/poem25247.html","الهزج"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"نجم تولد بين الشمس والأسد","https://www.aldiwan.net/poem18547.html","البسيط"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"بدا وقامته تختال بالتيه","https://www.aldiwan.net/poem20562.html","البسيط"],[64,"قل لمن يبكي علينا حزنا","https://www.aldiwan.net/poem67542.html","الرمل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[70,"تنصل مما جرى واعتذر","https://www.aldiwan.net/poem42880.html","المتقارب"],[92,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[92,"على ساحل البحر أنى يضج","https://www.aldiwan.net/poem38936.html","المتقارب"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[85,"خطونا في الجهاد خطى فساحا","https://www.aldiwan.net/poem7108.html","الوافر"],[85,"الله في الخلق من صب ومن عانى","https://www.aldiwan.net/poem7881.html","البسيط"],[85,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[56,"بها غير معذول فداو خمارها","https://www.aldiwan.net/poem58589.html","الطويل"],[62,"إذا استيقظت نائبات الزمان","https://www.aldiwan.net/poem52277.html","المتقارب"],[62,"حرمتك إذ رزقتك بعد حرص","https://www.aldiwan.net/poem52370.html","الوافر"],[45,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[45,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[28,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[61,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[61,"وقمص حجارة نبجت بماء","https://www.aldiwan.net/poem51295.html","الوافر"],[61,"كملن فأطلعن البدور كواملا","https://www.aldiwan.net/poem51486.html","الطويل"],[66,"لئن سمح الزمان لنا بقرب","https://www.aldiwan.net/poem38788.html","الوافر"],[66,"أيا ذا الفخر وملك العصر","https://www.aldiwan.net/poem39070.html","الهزج"],[66,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[97,"أهب ببيانك الصافي تدفق","https://www.aldiwan.net/poem24394.html","الوافر"],[97,"قضيت العمر تذكر لي","https://www.aldiwan.net/poem24803.html","مجزوء الوافر"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[44,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[31,"ذكرتني الديار شوقا قديما","https://www.aldiwan.net/poem41805.html","الخفيف"],[31,"ألم تسأل المنزل المقفرا","https://www.aldiwan.net/poem42499.html","المتقارب"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[105,"جمعن المشارق في المؤتمر","https://www.aldiwan.net/poem42051.html","المتقارب"],[105,"أغيثوا مصر واستبقوا بنيها","https://www.aldiwan.net/poem43387.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"شجتك لهند دمنة وديار","https://www.aldiwan.net/poem27053.html","الطويل"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[48,"جالست يوما أبانا","https://www.aldiwan.net/poem66153.html","المجتث"],[48,"رأى بخديه منبتا زغبا","https://www.aldiwan.net/poem66278.html","المنسرح"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30490","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54290","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[72,"يَا فَاضلا قد عني لرتبته","https://www.poetsgate.com/ViewPoem.aspx?id=189425",""],[11,"من الكرم العربي","https://www.poetsgate.com/ViewPoem.aspx?id=48445",""],[45,"سَلامٌ عَلَيْكُمْ، لا وَفَاءٌ وَلاَ عَهْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31425",""],[31,"ألمْ تسألِ المنزلَ المقفرا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18901&r=&rc=164",""],[88,"اعرني لساناً ايها الشعر للشكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19582&r=&rc=85",""],[85,"خَطَوْنا في الجِهادِ خُطاً فِساحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9644&r=&rc=134",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""]],"verses":[["وَقُمنا نَجُرُّ ذُيولَ الرَجا","وَتَرعى العُيونُ بُروقَ المُنى",0,"ا",1,0],["وَقُمْتُ فَقَرَّطتُ الأَغَرَّ عِنانَهُ","وَفي اليَدِ مَاضِي الشَّفْرَتَيْنِ يَمانِ",1,"ن",1,0],["وقُمْنا إِلى مُنْحَنى الوادِيَيْنِ","نَجُرُّ على أجْرَعَيْهِ الرِّدا",2,"ا",1,0],["وقُمْنا نَشاوَى عندَما متَعَ الضّحَى","كما نهَضَتْ غُلْبُ الأسودِ منَ الخِيسِ",3,"س",1,0],["وَقَمّاصَةٍ بِالآلِ داوَيتُ غَولَها","مِنَ البُعدِ بِالمُدرَنفِقاتِ الخَوانِفِ",4,"ف",1,0],["وقمت على البلاد مقام عيسى","على مَرضاه من عُميٍ وعُرج",5,"ج",1,0],["وَقُمتُ بِمَوشِيِّ المُتونِ كَأَنَّهُ","شِهابُ غَضاً في كَفِّ ساعٍ مُبادِرِ",6,"ر",1,0],["وَقُمنا نَسحَبُ الرَيطَ","إِلى حانَةِ خَمّارِ",7,"ر",1,0],["وقمتُ أشربُ من فيهِ وخمرتهِ","شرباً تُشَنُّ بهِ في العقلِ غارات",8,"ت",1,0],["وقمت أكسو بنيه من مدائحه","ما يرفل الملكُ في أثوابه الجدَدِ",9,"د",1,0],["وقمت بجاهه أشكو الليالي","كما تشكو الرّعية للأمير",10,"ر",1,0],["وقمتُ أذكره بالظبيِ ملتفتاً","فقالَ لي طرفهُ من غير تشبيه",11,"ي",2,0],["وَقَميصي قَطّعوهُ قطَعاً","وَدَعوا الكُلَّ دَفين زَمَنا",12,"ن",2,0],["وقمَ اللَّه بابن يحيى عن الأمْ","مَة شرّاً قد همَّ باستفحالِ",13,"ل",1,0],["وَقُمتُ فَقُلتُ لَهُ مَرحَباً","وَأَهلاً وَسَهلاً بِهَذا القَمَر",14,"ر",1,0],["وقميءٍ يُطاوِلُ الجَبَلَ العا","لي فللّه مَا أَشَدَّ غَبَاءهْ",15,"ا",2,0],["وقمتُ على النَّهرِ أَهْرقُ دمعاً","تفجَّرَ من فيضِ حُزني الأَليمْ",16,"م",1,0],["وقمت بالعبء عبء الدين تحمله","فما هنالك من نكص ومن خور",17,"ر",1,0],["وقمنا في شِراع الحق نلقى","وندفع عن جوانبه الرياحا",18,"ح",2,0],["وقمت تسطع بالأنوار في أفق","بالمسلمين وبالإسلام مزدان",19,"ن",1,0],["وَقُمتُم دونَها حَتّى خَضَبتُم","هَوادِجَها الشَريفَةَ وَالحِجالا",20,"ل",2,0],["وقُمْ أَنْتَ فاحْثُثْ كَأْسَها غَيْرَ صاغِرٍ","ولا تَسْقِ إِلاَّ خَمْرَها وَعُقَارَهَا",21,"ر",3,0],["وقمْ واجلُها من بناتِ الكُرو","مِ عذراءَ يفتضُّها ابنُ الغمامِ",22,"م",1,0],["وقُمتِ عليَّ بالغالي ولكن","تناولَكِ المنيةُ بالرخيصِ",23,"ص",1,0],["وَقُمتُ فَجَمَّعتُ الحَصى وَاِشتَوَيتُهُ","عَلَيهِ وَلِلرَمضاءِ مِن تَحتِهِ وَقدُ",24,"د",1,0],["وَقُمتَ مُستَسقِياً لِلمُسلِمينَ جَرَت","غُرُّ الغَمامِ وَحَلَّت مِن عَزاليها",25,"ي",3,0],["وَقُمنا إِلى دَهماءَ ضامِنَةِ القِرى","غَضوبٍ إِذا ما اِستَحمَلوها الأَثافِيا",26,"ي",2,0],["وقمنا نعطف الأزر","على العفة إذ قمنا",27,"ن",2,0],["وقمص حجارة نبجت بماء","ويلبسها الغني مع الفقير",28,"ر",1,1],["وقمت مقاما يترك السيف صاعدا","إذا ما التقى الصفان والرمح نازلا",29,"ل",2,0],["وَقُمتُ مَعَ المَقالِ مَقامَ عَتبٍ","تَوَهَّمَهُ الأَنامُ مَجالَ حَربِ",30,"ب",1,0],["وَقُم نَرتاحُ لِشُربِ الراحِ","فَلِلأَقداحِ سَناها زَينِ",31,"ن",1,0],["وَقَميصي دِرعٌ كَأَنَّ عُراها","حُبُكُ النَملِ أَو عُيونُ الجَرادِ",32,"د",1,0],["وقم نقضي الحقوقَ إذا دعينا","أليسَ الشرق يجمعنا حِمَاهُ",33,"ه",1,0],["وقم نسخر من الدنيا","وقم نَلهُ مع اللاهي",34,"ي",1,0],["وقمتُ نهوض العَوْدِ حُلّ عِقالُهُ","فأقعدَني المقدورُ عند قيامي",35,"ي",1,0],["وَقُمنا فَقُلنا بَعدَ أَن أُفرِدَ الثَرى","بِهِ ما يُقالُ في السَحابَةِ تُقلِعُ",36,"ع",1,0],["وَقُميرٌ بَدا اِبنُ خَمسٍ وَعِشري","نَ لَهُ قالَتِ الفَتاتانِ قوما",37,"م",2,0],["وَقُمنَ يُعَفّينَ آثارَنا","بِأَكسِيَةِ الخَزِّ أَن تُقفَرا",38,"ر",2,0],["وَقُمنَ يَقُلنَ لَوَ أَنَّ النَها","رَ مُدَّ لَهُ اللَيلُ فَاِستَأخَرا",38,"ر",2,0],["وَقُمتُ إِلى عَنسٍ تَخَوَّنَ نَيَّها","سُرى اللَيلِ حَتّى لَحمُها مُتَحَسِّرُ",39,"ر",1,0],["وقُمْنَ على الحَقِّ يَنْصُرْنَهُ","وقَامتْ وَراءَ الدُّروعِ الأُزُرْ",40,"ر",1,0],["وَقُمتُ أَجُرُّ أَوصالاً ثِقالاً","تُعاني المَوتَ مِمّا يَعتَريها",41,"ي",3,0],["وَقَمَعَ الجَورَ بِحُكمٍ عادِلِ","وَمَلَأَ الدينَ بِحَقٍّ شامِلِ",42,"ل",1,0],["وَقَمصُ حَديدٍ ضافِياتٌ ذُيولُها","لَها حَدَقٌ خُزرُ العُيونِ صِغارُ",43,"ر",1,0],["وَقُمتُ إِلى الكَومِ الصَفايا بِمُنصِلي","فَصَيَّرتُها مَجداً لِقَومي وَأَحسابا",44,"ب",2,0],["وَقُمرِيَّةِ الأَصواتِ حُمرٍ ثِيابُها","تُهينُ ثِيابَ الوَشيِ جَرّاً وَتَسحابا",44,"ب",2,0],["وَقُمتُ أَسحَبُ ذَيلي","عَن هازِلٍ بِالقُرانِ",45,"ن",1,0],["وقمتُ أسعى إليه مبتدراً","والقلب من سخطهِ على وجَل",46,"ل",1,0],["وَقُمتُ لَم أَقضِ مِنها إِذ خَلَوتُ بِها","إِلّا الحَديثَ وَإِلّا أَن أَمَسَّ يَدا",47,"د",2,0],["وقمنا بمرسوم العزاء لأجلهِ","ثلاثة أيام بها يقرأ الذكر",48,"ر",1,0],["وقمِيصاً يُبْلي الفتى كلَّ عام","وقميصايَ أدْرَكا أرْدَشيرا",49,"ر",2,0],["وقُمْ له يا أَعزَّ النَّاسِ كُلِّهِمُ","شخْصاً عليّ وأَولاهُمْ بتَكْرِيمِ",50,"م",1,0],["وَقُمْنَا وَكُلٌّ بَعْدَ مَا كَانَ لاهِياً","بِأَظْلالِهِ كُرْهَ الرَّحِيلِ مُنَغَّصُ",51,"ص",1,0],["وَقُمْتَ فِيهِمْ خَطيباً","لَهُ عَلَى الْقَوْلِ أَمْرُ",52,"ر",1,0],["وقمتُ أُطِلُّ من شَرَفٍ عليهم","فخانتني الدمُوعُ فما أُطلّ",53,"ل",1,0],["وقم بفن بك استقام فَمَا","ثمَّ لمولاي من يقاومه",54,"م",2,0],["وقمت اي برك هجان اعده","لوجبة حق نازل انا فاعله",55,"ل",2,0],["وَقُمْتُ فجَمّعتُ الحَصَى، فاشتَوَيتُه","عَلَيْهِ، وللرّمضَاءِ من تحته وَقْدُ",56,"د",1,0],["وَقُمْنَ يَقُلْنَ لَوَ انَّ کلنَّها","رَ مُدَّ لَهُ اللَّيْلُ، فَکسْتَأْخَرا",57,"ر",2,0],["وقم في مقام الشكر وانشر لواءهُ","برأس عمودٍ خذه من غرة الفجر",58,"ر",1,0],["وقمنا في شِراعِ الحق نَلْقَى","وندفع عن جوانيه الرياحا",59,"ح",2,0],["وقُمْ تَجِد القرونَ مرَرْنَ ساعا","مرضتَ فما ألحّ الداءُ إلاَّ",60,"ا",1,0]]}