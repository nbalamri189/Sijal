يا غُلامِي حُطَّ رَحْلَ مَطِيَّتي","وخُذْ ذَابِلي واحْلُلْ عُقُودَ نِجادِي",201,"د",2,0],["وقُمتَ بما أوصَى به اللهُ خَلقَهُ","وجئتَ إلى الأوثانِ أفنَيتَها كَسرا",202,"ر",2,0],["وَقُمْ وَاِكفِنِي إن كنتَ تَسطيع هذِهِ","حلولِيَ مغلوباً بوادِي العجائبِ",203,"ب",1,0],["وَقُمتَ بِالدينِ يَومَ الرَّسِّ فَاِعتَدَلَت","مِنهُ قَوائِمُ قَد أَوفَت عَلى مَيَلِ",204,"ل",1,0],["وقميني لقد زرنا","وشيخاً معه توأمْ",205,"م",1,0],["وقم بأوامر التكليف واترك","بإخلاص له كل المناهي",206,"ي",1,0],["وقمنا به يوماً ونمنا به دجىً","وشامٌ حوت منه الرجالَ وطوس",207,"س",1,0],["وقُمتْمُ في البِلادِ كقوم عادٍ","ولَسْتم في شريعةِ قومِ عادِ",208,"د",1,0],["وَقُمْرِيُّ يُغَنِّيْكَ","لُحُونَاً غَيْرَ مَلْحُونَهْ",209,"ن",2,0],["وقمت أُسْفِر وجه السَّعدِ من سَفري","وأَنقل الذُّلَّ عن عطفيَّ بالنُّقَل",210,"ل",1,0],["وقمتُ أَسأَلُ قلبي عن مَسرَّتِه","بما حواهُ وعندي أَكثرُ الخَبرِ",211,"ر",1,0],["وَقُمْتُ إلى حرْفٍ كَأنَّ قُتُودَهَا","إذا دَقَّ أعْنَاقُ الْمَطِيّ عَلَى فَحْلِ",212,"ل",1,0],["وَقُمنا إِلى خوصٍ كأَنَّ عيونَها","قِلاتٌ تَراخى ماؤُها فهو واضعُ",213,"ع",1,0],["وَقُمنا وَالرِكابُ مُخَيَّساتٌ","إِلى فُتُلٍ مَرافِقُهُنَّ كومُ",214,"م",1,0],["وَقُمتُ إِلى عَيرانَةٍ قَد تَخَدَّدَت","وَقاسَت يَداها كُلَّ خَمسٍ مُذَيَّبِ",215,"ب",1,0],["وَقُمتُ إِلى البَركِ الهَواجِدِ فَاِتَّقَت","مَقاحيدُ كُومٌ كَالمَجادِلِ رُوقُ",216,"ق",1,0],["وَقُمتُ إِلَيهِ بِاللِجامِ مُيَسّراً","هُنالِكَ يَجزيني بِما كُنتُ أَصنَعُ",217,"ع",1,0],["وَقُمتُ إِلى وَجناءَ كَالفَحلِ جَبلَةٍ","تُجاوِبُ شَدِّيَ نِسعَها بِبُغام",218,"م",1,0],["وَقُمنَ كَما قامَ المَها قابلَ المَها","وهَدَّينَ بَيضاوَينِ عَبلٌ شَواهُما",219,"م",2,0]]}