 ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[459,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[459,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[459,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[459,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[459,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[459,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[459,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[459,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[459,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[459,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[462,"غرس الخلافة لا فاتتك مكرمة","https://www.aldiwan.net/poem15396.html","البسيط"],[462,"جزيت نجيب الدين خيرا وانني","https://www.aldiwan.net/poem15911.html","الطويل"],[465,"يا غائباً لم تغب عني مكارمه","https://www.aldiwan.net/poem3315.html","عموديه"],[465,"خليلي ما بال الكؤوس عواطلا","https://www.aldiwan.net/poem3524.html","عموديه"],[467,"يقول خليلي باللوى من حفارة","https://www.aldiwan.net/poem50474.html","الطويل"],[469,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[480,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[487,"ألا هل فؤادي إذ صبا اليوم نازع","https://www.aldiwan.net/poem481.html",""],[501,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[501,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[501,"الحمد لله لي للمصطفى نسب","https://www.aldiwan.net/poem37811.html","البسيط"],[501,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[501,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[501,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[515,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[516,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[516,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[516,"من استعان بغير الله لم يعن","https://www.aldiwan.net/poem12278.html","البسيط"],[530,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[539,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[552,"أيا صاحبي إن لم تكن في شديدتي","https://www.aldiwan.net/poem48062.html","الطويل"],[554,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[559,"قلوب متى منه خلت فنفوس","https://www.aldiwan.net/poem34450.html","الطويل"],[563,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[568,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[576,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[576,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["وقم نجتدي بالله من دار أحمد","منازل ربع كلهن محامد",0,"د",1,0],["وَقُمنا نَجُرُّ ذُيولَ الرَجا","وَتَرعى العُيونُ بُروقَ المُنى",1,"ا",1,0],["وَقُمْتُ فَقَرَّطتُ الأَغَرَّ عِنانَهُ","وَفي اليَدِ مَاضِي الشَّفْرَتَيْنِ يَمانِ",2,"ن",1,0],["وقُمْنا إِلى مُنْحَنى الوادِيَيْنِ","نَجُرُّ على أجْرَعَيْهِ الرِّدا",3,"ا",1,0],["وقُمْنا نَشاوَى عندَما متَعَ الضّحَى","كما نهَضَتْ غُلْبُ الأسودِ منَ الخِيسِ",4,"س",1,0],["وَقَمّاصَةٍ بِالآلِ داوَيتُ غَولَها","مِنَ البُعدِ بِالمُدرَنفِقاتِ الخَوانِفِ",5,"ف",1,0],["وقمت على البلاد مقام عيسى","على مَرضاه من عُميٍ وعُرج",6,"ج",1,0],["وَقُمتُ بِمَوشِيِّ المُتونِ كَأَنَّهُ","شِهابُ غَضاً في كَفِّ ساعٍ مُبادِرِ",7,"ر",1,0],["وَقُمنا نَسحَبُ الرَيطَ","إِلى حانَةِ خَمّارِ",8,"ر",1,0],["وقمتُ أشربُ من فيهِ وخمرتهِ","شرباً تُشَنُّ بهِ في العقلِ غارات",9,"ت",1,0],["وقمت أكسو بنيه من مدائحه","ما يرفل الملكُ في أثوابه الجدَدِ",10,"د",1,0],["وقمت بجاهه أشكو الليالي","كما تشكو الرّعية للأمير",11,"ر",1,0],["وقمتُ أذكره بالظبيِ ملتفتاً","فقالَ لي طرفهُ من غير تشبيه",12,"ي",2,0],["وَقَميصي قَطّعوهُ قطَعاً","وَدَعوا الكُلَّ دَفين زَمَنا",13,"ن",2,0],["وقمَ اللَّه بابن يحيى عن الأمْ","مَة شرّاً قد همَّ باستفحالِ",14,"ل",1,0],["وَقُمتُ فَقُلتُ لَهُ مَرحَباً","وَأَهلاً وَسَهلاً بِهَذا القَمَر",15,"ر",1,0],["وقميءٍ يُطاوِلُ الجَبَلَ العا","لي فللّه مَا أَشَدَّ غَبَاءهْ",16,"ا",2,0],["وقمتُ على النَّهرِ أَهْرقُ دمعاً","تفجَّرَ من فيضِ حُزني الأَليمْ",17,"م",1,0],["وقمت بالعبء عبء الدين تحمله","فما هنالك من نكص ومن خور",18,"ر",1,0],["وقمنا في شِراع الحق نلقى","وندفع عن جوانبه الرياحا",19,"ح",2,0],["وقمت تسطع بالأنوار في أفق","بالمسلمين وبالإسلام مزدان",20,"ن",1,0],["وَقُمتُم دونَها حَتّى خَضَبتُم","هَوادِجَها الشَريفَةَ وَالحِجالا",21,"ل",2,0],["وقُمْ أَنْتَ فاحْثُثْ كَأْسَها غَيْرَ صاغِرٍ","ولا تَسْقِ إِلاَّ خَمْرَها وَعُقَارَهَا",22,"ر",3,0],["وقمْ واجلُها من بناتِ الكُرو","مِ عذراءَ يفتضُّها ابنُ الغمامِ",23,"م",1,0],["وقُمتِ عليَّ بالغالي ولكن","تناولَكِ المنيةُ بالرخيصِ",24,"ص",1,0],["وَقُمتُ فَجَمَّعتُ الحَصى وَاِشتَوَيتُهُ","عَلَيهِ وَلِلرَمضاءِ مِن تَحتِهِ وَقدُ",25,"د",1,0],["وَقُمتَ مُستَسقِياً لِلمُسلِمينَ جَرَت","غُرُّ الغَمامِ وَحَلَّت مِن عَزاليها",26,"ي",3,0],["وَقُمنا إِلى دَهماءَ ضامِنَةِ القِرى","غَضوبٍ إِذا ما اِستَحمَلوها الأَثافِيا",27,"ي",2,0],["وقمنا نعطف الأزر","على العفة إذ قمنا",28,"ن",2,0],["وقمص حجارة نبجت بماء","ويلبسها الغني مع الفقير",29,"ر",1,1],["وقمت مقاما يترك السيف صاعدا","إذا ما التقى الصفان والرمح نازلا",30,"ل",2,0],["وَقُمتُ مَعَ المَقالِ مَقامَ عَتبٍ","تَوَهَّمَهُ الأَنامُ مَجالَ حَربِ",31,"ب",1,0],["وَقُم نَرتاحُ لِشُربِ الراحِ","فَلِلأَقداحِ سَناها زَينِ",32,"ن",1,0],["وَقَميصي دِرعٌ كَأَنَّ عُراها","حُبُكُ النَملِ أَو عُيونُ الجَرادِ",33,"د",1,0],["وقم نقضي الحقوقَ إذا دعينا","أليسَ الشرق يجمعنا حِمَاهُ",34,"ه",1,0],["وقم نسخر من الدنيا","وقم نَلهُ مع اللاهي",35,"ي",1,0],["وقمتُ نهوض العَوْدِ حُلّ عِقالُهُ","فأقعدَني المقدورُ عند قيامي",36,"م",2,0],["وَقُمنا فَقُلنا بَعدَ أَن أُفرِدَ الثَرى","بِهِ ما يُقالُ في السَحابَةِ تُقلِعُ",37,"ع",1,0],["وَقُميرٌ بَدا اِبنُ خَمسٍ وَعِشري","نَ لَهُ قالَتِ الفَتاتانِ قوما",38,"م",2,0],["وَقُمنَ يُعَفّينَ آثارَنا","بِأَكسِيَةِ الخَزِّ أَن تُقفَرا",39,"ر",2,0],["وَقُمنَ يَقُلنَ لَوَ أَنَّ النَها","رَ مُدَّ لَهُ اللَيلُ فَاِستَأخَرا",39,"ر",2,0],["وَقُمتُ إِلى عَنسٍ تَخَوَّنَ نَيَّها","سُرى اللَيلِ حَتّى لَحمُها مُتَحَسِّرُ",40,"ر",1,0],["وقُمْنَ على الحَقِّ يَنْصُرْنَهُ","وقَامتْ وَراءَ الدُّروعِ الأُزُرْ",41,"ر",1,0],["وَقُمتُ أَجُرُّ أَوصالاً ثِقالاً","تُعاني المَوتَ مِمّا يَعتَريها",42,"ي",3,0],["وَقَمَعَ الجَورَ بِحُكمٍ عادِلِ","وَمَلَأَ الدينَ بِحَقٍّ شامِلِ",43,"ل",1,0],["وَقَمصُ حَديدٍ ضافِياتٌ ذُيولُها","لَها حَدَقٌ خُزرُ العُيونِ صِغارُ",44,"ر",1,0],["وَقُمتُ إِلى الكَومِ الصَفايا بِمُنصِلي","فَصَيَّرتُها مَجداً لِقَومي وَأَحسابا",45,"ب",2,0],["وَقُمرِيَّةِ الأَصواتِ حُمرٍ ثِيابُها","تُهينُ ثِيابَ الوَشيِ جَرّاً وَتَسحابا",45,"ب",2,0],["وَقُمتُ أَسحَبُ ذَيلي","عَن هازِلٍ بِالقُرانِ",46,"ن",1,0],["وقمتُ أسعى إليه مبتدراً","والقلب من سخطهِ على وجَل",47,"ل",1,0],["وَقُمتُ لَم أَقضِ مِنها إِذ خَلَوتُ بِها","إِلّا الحَديثَ وَإِلّا أَن أَمَسَّ يَدا",48,"د",2,0],["وقمنا بمرسوم العزاء لأجلهِ","ثلاثة أيام بها يقرأ الذكر",49,"ر",1,0],["وقمِيصاً يُبْلي الفتى كلَّ عام","وقميصايَ أدْرَكا أرْدَشيرا",50,"ر",2,0],["وقُمْ له يا أَعزَّ النَّاسِ كُلِّهِمُ","شخْصاً عليّ وأَولاهُمْ بتَكْرِيمِ",51,"م",1,0],["وَقُمْنَا وَكُلٌّ بَعْدَ مَا كَانَ لاهِياً","بِأَظْلالِهِ كُرْهَ الرَّحِيلِ مُنَغَّصُ",52,"ص",1,0],["وَقُمْتَ فِيهِمْ خَطيباً","لَهُ عَلَى الْقَوْلِ أَمْرُ",53,"ر",1,0],["وقمتُ أُطِلُّ من شَرَفٍ عليهم","فخانتني الدمُوعُ فما أُطلّ",54,"ل",1,0],["وقم بفن بك استقام فَمَا","ثمَّ لمولاي من يقاومه",55,"م",2,0],["وقميص من النّدى ماج فيه","موسم ، نابض الأفانين مائد",56,"د",1,0],["وقمت اي برك هجان اعده","لوجبة حق نازل انا فاعله",57,"ل",2,0],["وَقُمْتُ فجَمّعتُ الحَصَى، فاشتَوَيتُه","عَلَيْهِ، وللرّمضَاءِ من تحته وَقْدُ",58,"د",1,0],["وَقُمْنَ يَقُلْنَ لَوَ انَّ کلنَّها","رَ مُدَّ لَهُ اللَّيْلُ، فَکسْتَأْخَرا",59,"ر",2,0],["وقم في مقام الشكر وانشر لواءهُ","برأس عمودٍ خذه من غرة الفجر",60,"ر",1,0],["وقمنا في شِراعِ الحق نَلْقَى","وندفع عن جوانيه الرياحا",61,"ح",2,0],["وقُمْ تَجِد القرونَ مرَرْنَ ساعا","مرضتَ فما ألحّ الداءُ إلاَّ",62,"ا",1,0],["وقمت في دولة المختار معجزة","له ود ان لهذا الجن والبشر",63,"ر",1,0],["وقمت عصاميا بنفس ابية","وعلم وعرفان جليل المزية",64,"ه",1,0],["وقمت باعباء المعالي بأمة","تكر على العليا بنهشة ذيب",65,"ب",1,0],["وقمت تذكر أخبار الغوير وذي","نجد وأصحاب ذاك المربع الحسن",66,"ن",1,0],["وقم بحب الآل سادوا فالحقوا","بهم وعلوا قدراً وقد رفعوا ذكرا",67,"ر",2,0],["وَقُمنَ إِلَيها كَالدُمى فَاكتَنَفنَها","وَكُلٌّ يُفَدّى بِالمَوَدَّةِ وَالأَهلِ",68,"ل",1,0],["وقم ودع الأرضين عني فإنني","بقيد الردى المحتوم إلّا لسانيا",69,"ي",2,0],["وقمتَ بدين اللهِ حتى تألفت","بِعَدْ لك آرامُ الفلا وأُسودُها",70,"د",3,0],["وقمت بحقها دهراً طويلاً","فنالكما من الله الجزاءُ",71,"ا",2,0],["وَقُمتَ بِفَرضِ جِهادِ العَدُوِّ","فَأَغنى قِيامُكَ مَن لَم يَقُم",72,"م",1,0],["وقم إذا صُبِغَت في الليل دهمتُهُ","وأُسرِجت في دُجَاهُ الأنجمُ الزّهر",73,"ر",1,0],["وقم بغنا بعض عن البعض لا تكل","إلى ابن اباً يوما ولا ابن أخ عما",74,"م",2,0],["وقمت ما بينهما محاسبا","أجيل طرفي وأدير فكري",75,"ر",2,0],["وقمت للجند ترى تذريبهم","فالطعنُ للحرب من التبررِ",76,"ر",1,0],["وقمتَ لله تدعوه وتذكرهُ","ذكر امرىءٍ حبله بالله متصلُ",77,"ل",1,0],["وقمت كما يرضى الإِله مصليا","فيهنيك ما استكثرته من رضى الرب",78,"ب",1,0],["وقمت بأمر أعجز الدهر كونه","قيام مطاع القول متبع الأمر",79,"ر",1,0],["وقمت بأمر الله ترعى عهوده","ومثلك من ترعى بصدق عهوده",80,"د",2,0],["وقمت وحدي أدعو بين أظهركم","فلم يجبني امرؤ منكم ولم يثب",81,"ب",1,0],["وَقُمتَ مَقاماً لَو يُقامُ لِغَيرِهِ","لَقالَ اِرتياحاً أَحسُن البِرِّ عاجِلُه",82,"ل",2,0],["وَقُمتَ بِأَحكامِ الشَريعَةِ فَاِستَوَت","لَدَيكَ ذَوُو الأَجبالِ طَيٌّ وَوائِلُ",83,"ل",1,0],["وقَمِيصَ الدَّهْرِ مِنْ بَعْ","دِكَ قَدْ أَوْدَى وَأَخْلَقْ",84,"ق",1,0],["وقمتُ أنتزِع الأوكار من حَنقٍ","مني وأستلبُ الأغصانَ والورقا",85,"ق",2,0],["وقمت أميل من سكر وشوق","وما أدري شمالي من يميني",86,"ن",2,0],["وقم فادفع به دفعا عنيفا","ليسقط منه في واد عميق",87,"ق",1,0],["وقمت مستدركا فوائتها","ففتّت الفوت بالونى كبدي",88,"د",2,0],["وقم بنا نصطبحُ معتقةً","واسمح بها فالزمانُ قد سمحا",89,"ح",2,0],["وَقُمتُ إِلى سَيفي فَجَرَّدتُ نَصلَهُ","وَعَن أَيِّ نَفسٍ بَعدَ نَفسي أُقاتِلُ",90,"ل",1,0],["وقم ما بين ندمان","بها كالانجم الزهر",91,"ر",1,0],["وقمت في منصب اعلامه رفعت","مجدا لانك فيه المفرد العلم",92,"م",1,0],["وقُمنَا إلى التوديعِ والنِّيْبُ دَمْعُها","عَقِيقٌ ودمعُ المُهرِ زادَ بهِ السَكْبُ",93,"ب",1,0],["وقمتَ خطيباً تورِد الحقَّ وِرْدَه","وتنصر دينَ الله غير مُدَار",94,"ر",1,0],["وقمتَ بثأر الملك من كل غاصب","وأيَّدت أركان الوفاء على الغدر",95,"ر",1,0],["وقمتَ بهم في مِنْبَر المُلك خاطباً","بما لم يَقُمْ مَلْك سواك ويَخْطُب",96,"ب",1,0],["وقمّصه الرحمن ثوب خلافة","بوعد النبي المصطفى ليس يخلع",97,"ع",1,0],["وَقُمتَ بِأَعباءِ الخِلافَةِ ناهِضاً","وَقَد نامَ عَنها العاجِزُ المُتَواني",98,"ن",2,0],["وقمت بتدبير الممالك حازما","وملكك من كبرى الممالك أرحب",99,"ب",1,0],["وقم فديتك بالأسحار حيث سنا ال","أسرار يرفع للأستار والسجف",100,"ف",1,0],["وقم سحراً وناجِ الله واغنم","مراحمه ومنك الطرفُ ساهر",101,"ر",1,0],["وقمت بأعباء الأمور وبعض ما","حملت تدك الراسيات لحمله",102,"ل",2,0],["وَقم بي فاني وابن عمي وكل من","يلينا نرجى جاه وَجهك سيدي",103,"د",2,0],["وَقم يا رَسول اللَه بي وَبصاحبي","وَقل ذا كَهَذا الاخلاف مرتب",104,"ب",1,0],["وَقم بِجَميع اخواني وَصحبي","وَعم أَبا من الانساب وابنا",105,"ن",2,0],["وَقُمتَ فيها بِأَمْرِ اللَّهِ مُنتَصِراً","كَالصَّارِمِ اهتَزَّ أَو كالعارِضِ انبَجَسا",106,"س",2,0],["وَقُمْتَ بِأَعباءِ الإِمارَةِ نَاهِضاً","تُجالِد عَنها مَنْ عَتا وَتُقارِعُ",107,"ع",1,0],["وقُمْتُ للدّين إفْصاحاً بنصْرَتِه","فاسحنْفَرتْ عندها الدُّنيا تُهنّئُهُ",108,"ا",2,0],["وقمت أنضو حساماً من مفاخرها","وفوق رأسي بها تاج وإكليل",109,"ل",1,0],["وَقُم مُست