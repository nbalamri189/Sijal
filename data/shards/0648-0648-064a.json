{"poems":[[49,"أتزعم ياضخم اللغاديد أننا","https://www.aldiwan.net/poem25367.html","الطويل"],[93,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[87,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[45,"عزيز أسى من داؤه الحدق النجل","https://www.aldiwan.net/poem9987.html","الطويل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"وضعت قناعي وارتببت نجادي","https://www.aldiwan.net/poem63903.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[49,"أتَزْعُمُ، يا ضخمَ اللّغَادِيدِ، أنّنَا","https://www.poetsgate.com/ViewPoem.aspx?id=14651",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[164,"رمتني بسهم خلتني منه ناجيا","https://www.aldiwan.net/poem58843.html","الطويل"],[164,"سماط ما أراه أم مناخ","https://www.aldiwan.net/poem58912.html","الوافر"],[203,"أيك العصافير والدنيا علي أسى","https://www.aldiwan.net/poem45344.html","البسيط"],[203,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[259,"طيف","https://www.aldiwan.net/poem36223.html","مجزوء الرمل"],[350,"أمولى بني تيم ألست مؤديا","https://www.aldiwan.net/poem4476.html","الطويل"],[422,"ألا بلغ جناب الشيخ عني","https://www.aldiwan.net/poem54059.html","الوافر"],[445,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[463,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105614","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70944","السريع"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119360","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61246","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136281","البسيط"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6771","السريع"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137866",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109015","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109335","الوافر"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47151","البسيط"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97067","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141135","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133073","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58083","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57993","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4728,"حضرة الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=176995",""],[5045,"شمعة المساء","https://www.poetsgate.com/ViewPoem.aspx?id=184899",""],[3591,"رأيت فقيراً قد أتى يسأل الطعما","https://www.poetsgate.com/ViewPoem.aspx?id=149425",""],[5277,"من يصدقُ يغار","https://www.poetsgate.com/ViewPoem.aspx?id=206846",""],[5376,"لا تسلْ عني فأنِّي عاشقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197711",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5510,"مرايا الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=206318",""],[470,"قلبي عليك","https://www.poetsgate.com/ViewPoem.aspx?id=178009",""],[5689,"باتت تناجيك خلف اليم في الغمم","https://www.poetsgate.com/ViewPoem.aspx?id=143421",""],[5691,"خُلقْنا أُناساً...!","https://www.poetsgate.com/ViewPoem.aspx?id=207459",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""]],"verses":[["وَوَيلَكَ مَن أَدى أَخاكَ بِمَرعَشٍ","وَجَلَّلَ ضَرباً وَجهَ والِدِكَ العَضبا",0,"ب",2,0],["وَوَيلَكَ مَن خَلّى اِبنَ أُختِكَ موثِقاً","وَخَلّاكَ بِاللَقّانِ تَبتَدِرُ الشَعبا",0,"ب",2,0],["وَوَيحَ صَرعى الغَرامِ إِنَّهُمُ","مَوتى وَما كُفِّنوا وَلا قُبِروا",1,"ر",3,0],["وَوَيحَ السَوافي هَل عَرَضنَ عَلى البِلى","جَبينَكَ أَم سَتَّرنَهُ بِحِجابِ",2,"ب",1,0],["وَوَيلٌ لِنَفسٍ حاوَلَت مِنكَ غِرَّةً","وَطوبى لِعَينٍ ساعَةً مِنكَ لا تَخلو",3,"ل",2,0],["وَوَيلُ مَن ماتَ أَبوهُ موسِرا","أَلَيسَ هَذا مُحكَماً مُشَهَّرا",4,"ر",2,0],["وَوَيلُ اَمِّهِ يَرجو لَهُ غَفرَ غافِرٍ","لِما جَرَّهُ مِن عائِدٍ وَمَعادِ",5,"د",1,0],["وَوََى الْبُرُودَ مِنَ الأَزَا","هِرِ وَانْتَقَى لَكَ خَيْرَ بُرْدِ",6,"د",1,0],["وويلكَ º منْ أردى أخاكَ \" بمرعشٍ\"","وَجَلّلَ ضرْباً وَجهَ وَالدِكَ العضْبَا؟",7,"ب",2,0],["وويح الغواني : ما أمنت خطوبها","وقد أمنت بعد المشيب خطوبي",8,"ب",2,0],["وويا حي يا قيوم زدني معارفاً","ويا واجد بالوجد فيك اكفني هجري",9,"ر",2,0],["وويل لأعرابٍ طغامٍ تعوّدوا","من المتصدى والملوك التغاضيا",10,"ي",2,0],["وويل للعدا بك بعد ويل","إذا اضطرم الترامي والرضاخ",11,"خ",1,0],["وويحَ عُذالها ما في جوانبهمْ","قلبي فمن أينَ يحكى شأنهمْ شاني",12,"ن",2,0],["وويلاهُ ما هذهِ الحروبُ ومن أرى","فقِدْماً عهدنا الوحشَ في الوحشِ يطمعُ",13,"ع",1,0],["ووئامٌ بات رَيْباً","منه أشكو أو ألوم",14,"م",1,0],["وَوَيلَمَّها كانَت غَبوقَةَ طارِقٍ","تَرامى بِهِ بيدُ الإِكامِ القَراوِحُ",15,"ح",1,0],["وويحك ما العبادة ضربُ دُفٍّ","ولا في طول هذا الذقن فخرا",16,"ر",2,0],["وويلٌ لهم من وقعةٍ لَكَ خَيَّلَتْ","عَلَيْهِمْ سماءَ اللهِ دانيةَ الوَقْعِ",17,"ع",1,0],["وويل امّها شارةً لو تكو","ن صِبغاً بغير الردى ينصُلُ",18,"ل",1,0],["وويلُ امّ مأمورِهم لو أطاع","لقد باع جنّتَه بالطفيفِ",19,"ف",1,0],["وويلك منه إذ يجرك في غد","وهيهات أن تنفك أو ان تعذرا",20,"ر",2,0],["وَوَيْلَهُمْ إِنْ شآبيبُ القَنَا هَمَأَتْ","وحاقَ باللامِ والأجسام مُنْهَمَأُ",21,"ا",1,0],["وويل عدو الله وابن عدوه","يزيد وذا من كل رجس مجسم",22,"م",1,0],["وويركب الأخطار صبراً على اقْ","تحام أهوال الأمور العظام",23,"م",1,0],["وويح لحر حالف الحر حره","وحقق أن الحر حامي المحاجم",24,"م",1,0],["وويب لمفضال يبيت مزاحماً","ويمسي بذياك المحل المزاحم",24,"م",1,0],["وويس لمسكين يساق سفاهةً","الى سوق فساق حسول أساحم",24,"م",1,0],["وَوَيل لعَبد أَوبقته ذُنوبه","وَكانَ بِما يَأتي عَلى النَّفس لا لَها",25,"ه",2,0],["وويح من كثرت منه الجرايم وال","عصيان والاثيم والتفريط والزلل",26,"ل",1,0],["وَوَيلُ مَن عُمِّرَ دَهراً وَلَم","يُرحَم وَلَم يُعتَق مِنَ النارِ",27,"ر",1,0],["وويلاه كم امسيت تطرب سامعا","اذا صحت عن ضيم بقومك ويلاه",28,"ا",2,0],["وويلاه كيف اليوم ان صاح نائح","غدا نومه دورا على السمع غناه",28,"ا",2,0],["وويلاه كيف اليوم كل من العدا","سريرته ما ليس تظهر نجواه",28,"ا",2,0],["وويلاه كيف اليوم كل من العدى","سريرته ما ليس تظهر نجواه",28,"ا",2,0],["وويلاه من فقد الوفيّ فانه","مضى لديار الغول ينشد عنقاه",28,"ا",2,0],["وويلاه كيف اليوم يستنجد الفتى","خليليه من دهر خليلاه ابناه",28,"ا",2,0],["وويلاه مات الفضل والعدل والوفا","وويلاه مات المستغيث مناداه",28,"ا",2,0],["وويلاه كيف اليوم قد اصبح الحمى","بحكم القضا حكامه فيه اسراه",28,"ا",2,0],["وويلاه قد مات الذي بجنابه","على الدهر يرجى ان يغاث معناه",28,"ا",2,0],["وويلاه مات الحزم والعزم والحجى","بموت الامير اليوم والعز والجاه",28,"ا",2,0],["وويل قائدهم من فاسق دنس","لم يعدُ عنه الخنا والذل والفشل",29,"ل",1,0],["وويل للظلوم ازداد بغيا","عليّ ولم أكن يوماً بغيت",30,"ت",1,0],["وَوَيْلُ مَنْ لم يُقم رأسا به فغدا","من خُسرِه في مهاوي الزَّيْغ والزّلل",31,"ل",1,0],["وويلك ما لبطنك مذ قعدنا","كأن دويه أرزام رعد",32,"د",1,0],["وويا مليك الورى طراً وغيثهم","وغوثهم إن هم لم يأمنوا النوبا",33,"ب",2,0],["ووَيبٌ للبنانٍ ليبكِ مدا المدا","ويهمي غيوث الدمع مزن السحابِ",34,"ب",1,0],["ووَيسٌ للبنانٍ على نحس طالع","وتنويع غربٍ مع شديد المآربِ",34,"ب",1,0],["ووَيلٌ له إذ خُطَّ بين سرارهِ","علائم نحسٍ وهي شُؤم الشواذبِ",34,"ب",1,0],["وويل له ثم ويل له","إذا هو شوّش أحواله",35,"ه",1,0],["وويح قومٍ نسوا الله فأنساهم","شان المصير وجازاهم بما كفروا",36,"ر",3,0],["وويلٌ لعبدٍ غاشمٍ في ضلالِه","وطوبَى لعبدٍ عن هواهُ تَوَرَّعَا",37,"ع",2,0],["وويلٌ لمن آتاه مولاه بسطة","وملكاً فلم يعدل فها ذو الخيانة",38,"ه",1,0],["ووَيْهٍ يِعيد الليل صِبحٍ بِهيجِ","خِدْر النّواظِر مِطفيات السّرايج",39,"ج",1,0],["وويلاه يا ارضٍ محولٍ ضمّت التفاح","أجيه مجروح وأعوّد وأنا مجروح",40,"ح",1,0],["وويله الي ميلك عننا ويل","كأس الخسارة يشربة دون ربحا",41,"ح",2,0],["وويلاه من عنق لقد دق وانضوى","من الجوع حتى أشبه الخيط والسُما",42,"م",2,0],["وويلي إذا اشعلتُ غيرتَها جوىً","فأخشى عليها أنْ تشطَّ فتتعبُ",43,"ب",1,0],["ووئاماً عند وصلٍ بالمنى","هل تمنَّعْتِ شغوفاً ووئاما",44,"م",2,0],["وويلٌ لطاغوتٍ ضحاياه روّعت",": قصاصُ مليكِ الكون في الحشر :أروعُ",45,"ع",1,0],["وويلٌ لأتباع البغاة وقد شَروا","ببخسٍ رخاء العيش فالخلدُ مفزِعُ !!",45,"ع",1,0],["وويح عمريَ تُطوى اليوم رايتُهُ","ويغرف الهم إذ ينأى فأقتربُ",46,"ب",1,0],["ووَيحَ نفسي التي ما فَزَّ هاجسُها","كأنمَّا أيُّ خوفٍ لا يُنازعُها",47,"ع",3,0],["وويح كل أديب حل ساحتها","كم ذا يكابده فيها من الوصم",48,"م",1,0],["وويْلٌ لمَنْ رانَتْ عليْهِ ذُنوبُهُ","ومالَ بهِ الشَّيْطانُ حيْثُ يَميلُ !",49,"ل",1,0],["وويل جابلصا من خواصته","وويل جابلقا منه والغلف",50,"ف",1,0],["وَوَيْحْ نَفْسِي كَمْ مَرَّتْ عَلى نَتِنٍ","مِنَ النُّفُوسِ وكَمْ أَوْفَتْ عَلى جِيَفِ",51,"ف",1,0]]}