,"https://www.poetsgate.com/ViewPoem.aspx?id=197738",""],[5606,"يقول عيسى وعيسى يرفع أقواله","https://www.poetsgate.com/ViewPoem.aspx?id=197970",""],[2110,"قل لي بحقك أيهذا الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=156283",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5790,"ما للجمال بوجنتيك معين","https://www.poetsgate.com/ViewPoem.aspx?id=112147",""],[5830,"وَ حََقّاً إِنَّنِي خَجِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=200773",""],[5837,"عبدالعزيز القنيدي","https://www.poetsgate.com/ViewPoem.aspx?id=181088",""],[6052,"هزة الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=34893",""],[6070,"سائر الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=187902",""],[520,"إن كان عطفك للإعجاب يختال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577610",""],[186,"خاننا فيك حادث الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55800&r=&rc=63",""],[2220,"ما رأينا من عنايته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11300&r=&rc=174",""],[6315,"الفتاة الراهبة .. الفتاة الهاربة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87578&r=&rc=3",""],[6323,"قتامة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82176&r=&rc=7",""]],"verses":[["قارَعتَ دَهرَكَ حَتّى لاحَ مَقتَلُهُ","ما اِستُقبِحَ الرَوعُ حَتّى اِستُحسِنَ الظَفَرُ",0,"ر",1,0],["قارَعتَهُم بِالقَولِ حَتّى أَذعَنوا","وَأَطَلتَ نَومَ الصارِمِ المَغمودِ",1,"د",1,0],["قارَبَتْ أنْ تَسيلَ بالكأْسِ ممّا","شَفّ عنْ جِسْمِها أديمُ الزُّجاجِ",2,"ج",1,0],["قارِضاتِ الكَديدِ مُجتَزِعاتٍ","كُلَّ وادي الجُحوفِ بِالأَثقالِ",3,"ل",1,0],["قَارَبْتُ سُدَّتَهُ العُلْيَا عَلَى وَجَلٍ","وَلَمْ أَخَلْهُ يُنَاجِينِي فَنَاجَانِي",4,"ن",2,0],["قارعت قبلي معاشراً قُرَعاً","فازت فخف أن تخونك القُرَع",5,"ع",1,0],["قارِحُ عامَينِ قَد طارَت نَسيلَتُهُ","سُنبُكُهُ مِن رُضاضِ المَروِ مَفلولُ",6,"ل",1,0],["قارَّبَ اللَهُ لِمَولا","يَ بِها كُلَّ السُعودِ",7,"د",1,0],["قارَعَت رُمحَكَ الرِماحُ وَلَكِن","تَرَكَ الرامِحينَ رُمحَكَ عُزلا",8,"ل",2,0],["قاري سِباعٍ قَد لَغَبنَ حَوائِمٍ","في نَقعِهِ وَمُضيفُ طَيرٍ حُوَّمِ",9,"م",1,0],["قارِضهُ ما شِئتَ يُثمِنكَ الوَفاءَ بِهِ","وَاِحذَرهُ يَنشُدُ أَوتاراً وَأَضغانا",10,"ن",2,0],["قارِن قَرينَكَ وَاِستَعِدَّ لِبَينِهِ","إِنَّ القَرينَ مِنَ القَرينِ مُبايِنُ",11,"ن",1,0],["قارِحٍ زانَهُ خِمارٌ مِنَ العُر","فِ يُفادي بِالسَبحِ وَالتَقريبِ",12,"ب",1,0],["قارَنتُ نُورَ النَّيِّرَينِ بِنُورِهِ","فَرَأَيتُ نُورَ النَّيِّرَيْنِ ضَئيلا",13,"ل",2,0],["قارَبتُ مِن مَبسوطِهِ","بِالعَنتَريسِ العَيسَجورِ",14,"ر",1,0],["قارعت اطوارها حتى خذيت لها","وبي من الصبر مالا يحمل الجبل",15,"ل",1,0],["قارورة يُحفَظ فيها دم","يعرفه الخائنُ والمخلصون",16,"ن",1,0],["قارويُّ النَجار قَد أَصبَحخ الده","ر رِياضاً بِهِ فَأَصبَح وَردا",17,"د",2,0],["قارِي عليه العدِّيَّه","ومحصَّنُه بالطشطوشي",18,"ي",1,0],["قارَعتْكَ الخَطوبُ دَهراً فَما وُلْ","لِيتَ إِلاّ وَغَربَها في اِنثِلامِ",19,"م",1,0],["قارَعتُهُنَّ بِمُحسِنٍ لا تُحسِنُ ال","أَيّامُ أَن تَأتي لَهُ بِقَريعِ",20,"ع",1,0],["قارَعتُ صَرفَ الزَمانِ مِنهُ","بِماجِدٍ مالَهُ قَريعُ",21,"ع",1,0],["قارِئُها يَنظُرُ في رَوضَةٍ","مَوشِيَّةِ الأَقطارِ بِالزَهرِ",22,"ر",1,0],["قاريهِ يا صاحِ لِإِفهامِهِ","وَلَيسَ لِلإِطرابِ بِالصاحي",23,"ح",2,0],["قارِحٍ قَد فُرَّ عَنهُ جانِبٌ","وَرَباعٍ جانِبٌ لَم يَتَّغِرْ",24,"ر",1,0],["قارزقني أعلى مقام في متابعة الرسول","أحمد خير الخلق هاديها",25,"ي",3,0],["قَارعتَ دُونِي الحادثاتِ فَلا","طرقَتْ فناءَكَ ما دَجَا السّدَفُ",26,"ف",1,0],["قارعت أيامي لعمرك جاهداً","حتَّى انتضيت لها حسام الدِّين",27,"ن",1,0],["قارن البدر بالمسرة شمساً","يتسامى بها الزفاف الحميدُ",28,"د",1,1],["قارَضَني وأيّما قِراضِ","فاعْتَضْتُ منه أحسنَ اعْتياضِ",29,"ض",1,0],["قارعْتُه وعلِمْتُ أني ناكحٌ","طَمعاً متى ألقَحْتُه لم يَنتُجِ",30,"ج",1,0],["قاربتِها ملاحة","وفَضَحتْكِ مِلْحا",31,"ح",2,0],["قارٍ إذا شكر المَبيتَ ضُيوفُهُ","في دُهْمَةٍ فعشاره لم تشكر",32,"ر",1,0],["قارعته فتشظى عود صعدته","ضعفاً وهل يتساوى النبع والضال",33,"ل",1,0],["قارعوا عنِّيَ الخطوبَ وسدّوا","يومَ سيلِ المكروهِ عنّي الأَتِيّا",34,"ي",2,0],["قارَعوا عَنِّيَ الخُطوبَ وَقَدْ هَم","مت وكادتْ تجنِي عليَّ الخطوبُ",35,"ب",1,0],["قارنَها الدّمعُ فبِئْسَ القَرِينْ","وربما قُلتُ فنِعْم المعين",36,"ن",1,1],["قارب الدار راجياً فأتى النا","عي إليه فطاش لياً وطارا",37,"ر",2,0],["قارونُ لو حلّ بها","لَمالَه قد أنفقَهْ",38,"ق",2,0],["قارفت في حبك كل محرج","وقحمت في واديك كل مهين",39,"ن",1,0],["قارَبتُهم فَتباعدوا باعدتهم","قَربوا بطبعٍ خادعٍ ختّالِ",40,"ل",1,0],["قَارَبْن أَقْصَى غَوْلِهِ بِالمَتِّ","وَاجْتَبْنَ جَوْناً كَعُصَارِ الزِفْتِ",41,"ت",1,0],["قارئه في الصبح والمساء","ورد مع الحضور والصفاء",42,"ا",2,0],["قارن بدر الهدى بشمس","أبهى قران له وأبهر",43,"ر",1,0],["قارن طريفا تظرف","صاحب شريفاً تشرف",44,"ف",1,0],["قارى الضيوف كفيلها","حامى النزيل إذا انتحاه",45,"ا",2,0],["قارنهُ المدح والثناءُ","قضيت بالعدل واجباتي",46,"ي",1,0],["قارعتهم بالجود عن أحسابكم","فحمى لها بذلُ السماح حَريما",47,"م",2,0],["قارنوا ماءها بِصرف الحُميّا","راحةُ الروح بين ذاك القران",48,"ن",1,0],["قارنه السعد بِميلاده","فَطبق العالمُ مِنهُ السَنا",49,"ن",2,0],["قارح ملجم بِالإِيوان عِندي","مَثل شَيخ إِذا تَعاطى الخَسارة",50,"ه",1,1],["قارنت منها شمس حسن مثلما","بك قارنت بدراً يفوق جمالا",51,"ل",2,0],["قارب فديتُك إِن أَكل","تَ وَإِن شَرِبتَ وَإِن غَشيتا",52,"ت",2,1],["قارَبْتُ أمشي الفَنجَلَى والقعوَلَهْ","وتارَةً أنبُثُ نَبْثَ النَقثَلَةْ",53,"ل",2,0],["قاري الهِداية لا الأَشباه تشبهه","سل الفصول فَما في الفَضل إنكار",54,"ر",1,0],["قارونُ عِندي في الغِنى مُعدَمٌ","وَهِمَّتي ما فَوقَها مَذهَبُ",55,"ب",1,0],["قارعت الأيامُ مني امرءاً","قد أعلق المجدَ بأمراسِهِ",56,"س",2,1],["قاربه في المنظر العظيم","يدعى برأس الغول عند الروم",57,"م",1,0],["قاريِ القاموس مِ الغَطْوِ استفاد","يظهر بْيوتٍ خِشان مغَلْطِسات",58,"ت",1,0],["قارعوهُ على الطَّريفِ من العِزْ","زِ فأودى طريفُهم بالتِّلادِ",59,"د",1,0],["قاربْ أَخاكَ ولا تطع نفراً","منعوكَ أَنْ تتأَلفَ الأَهْلا",60,"ل",2,0],["قاربت لذاتُ أَيام الصبا","للتخلي وَأَظنّ الرشدَ حل",61,"ل",1,0],["قارئا فيه وَفيها انه","غير كفء ناقما مُستَثقِلا",62,"ل",2,0],["قارَعَهُ عَنِّيَ الزَمانُ فَقَد","صِرتُ لَهُ في الأَذى وَفي التَعَبِ",63,"ب",