{"poems":[[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[77,"يا سراج الجمال يا ابن سراج","https://www.aldiwan.net/poem36668.html","الخفيف"],[35,"ما عناك الغداة من أطلال","https://www.aldiwan.net/poem39094.html","الخفيف"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[51,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[29,"بانت سعاد ففي العينين ملمول","https://www.aldiwan.net/poem6024.html","البسيط"],[70,"دمت في أرغد عيش","https://www.aldiwan.net/poem42945.html","مجزوء الرمل"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[45,"بالله يا ربع لما ازددت تبيانا","https://www.aldiwan.net/poem66659.html","البسيط"],[49,"سبق القضاء بكل ما هو كائن","https://www.aldiwan.net/poem63143.html","الكامل"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[109,"هاك طفلا أراكه الله جدا","https://www.aldiwan.net/poem16309.html","الخفيف"],[135,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[182,"خاننا فيك حادث الأيام","https://www.aldiwan.net/poem67031.html","البسيط"],[235,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[235,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[366,"فامتزجت بالماء أجزاؤه","https://www.aldiwan.net/poem17691.html","السريع"],[367,"عجب خولة إذ تنكرني","https://www.aldiwan.net/poem4615.html","الرمل"],[391,"وليس للمرء بعد الموت من شجر","https://www.aldiwan.net/poem54444.html","عموديه"],[409,"لكنني أشكو قوارص من","https://www.aldiwan.net/poem32264.html","أحذ الكامل"],[416,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[429,"قارن البدر بالمسرة شمسا","https://www.aldiwan.net/poem39826.html","الخفيف"],[432,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[432,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[458,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[461,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[515,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[551,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[551,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[575,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"]],"verses":[["قارَعتَ دَهرَكَ حَتّى لاحَ مَقتَلُهُ","ما اِستُقبِحَ الرَوعُ حَتّى اِستُحسِنَ الظَفَرُ",0,"ر",1,0],["قارَعتَهُم بِالقَولِ حَتّى أَذعَنوا","وَأَطَلتَ نَومَ الصارِمِ المَغمودِ",1,"د",1,0],["قارَبَتْ أنْ تَسيلَ بالكأْسِ ممّا","شَفّ عنْ جِسْمِها أديمُ الزُّجاجِ",2,"ج",1,0],["قارِضاتِ الكَديدِ مُجتَزِعاتٍ","كُلَّ وادي الجُحوفِ بِالأَثقالِ",3,"ل",1,0],["قَارَبْتُ سُدَّتَهُ العُلْيَا عَلَى وَجَلٍ","وَلَمْ أَخَلْهُ يُنَاجِينِي فَنَاجَانِي",4,"ن",2,0],["قارعت قبلي معاشراً قُرَعاً","فازت فخف أن تخونك القُرَع",5,"ع",1,0],["قارِحُ عامَينِ قَد طارَت نَسيلَتُهُ","سُنبُكُهُ مِن رُضاضِ المَروِ مَفلولُ",6,"ل",1,0],["قارَّبَ اللَهُ لِمَولا","يَ بِها كُلَّ السُعودِ",7,"د",1,0],["قارَعَت رُمحَكَ الرِماحُ وَلَكِن","تَرَكَ الرامِحينَ رُمحَكَ عُزلا",8,"ل",2,0],["قاري سِباعٍ قَد لَغَبنَ حَوائِمٍ","في نَقعِهِ وَمُضيفُ طَيرٍ حُوَّمِ",9,"م",1,0],["قارِضهُ ما شِئتَ يُثمِنكَ الوَفاءَ بِهِ","وَاِحذَرهُ يَنشُدُ أَوتاراً وَأَضغانا",10,"ن",2,0],["قارِن قَرينَكَ وَاِستَعِدَّ لِبَينِهِ","إِنَّ القَرينَ مِنَ القَرينِ مُبايِنُ",11,"ن",1,0],["قارِحٍ زانَهُ خِمارٌ مِنَ العُر","فِ يُفادي بِالسَبحِ وَالتَقريبِ",12,"ب",1,0],["قارَنتُ نُورَ النَّيِّرَينِ بِنُورِهِ","فَرَأَيتُ نُورَ النَّيِّرَيْنِ ضَئيلا",13,"ل",2,0],["قارَبتُ مِن مَبسوطِهِ","بِالعَنتَريسِ العَيسَجورِ",14,"ر",1,0],["قارورة يُحفَظ فيها دم","يعرفه الخائنُ والمخلصون",15,"ن",1,0],["قارويُّ النَجار قَد أَصبَحخ الده","ر رِياضاً بِهِ فَأَصبَح وَردا",16,"د",2,0],["قارِي عليه العدِّيَّه","ومحصَّنُه بالطشطوشي",17,"ي",1,0],["قارَعتْكَ الخَطوبُ دَهراً فَما وُلْ","لِيتَ إِلاّ وَغَربَها في اِنثِلامِ",18,"م",1,0],["قارَعتُهُنَّ بِمُحسِنٍ لا تُحسِنُ ال","أَيّامُ أَن تَأتي لَهُ بِقَريعِ",19,"ع",1,0],["قارَعتُ صَرفَ الزَمانِ مِنهُ","بِماجِدٍ مالَهُ قَريعُ",20,"ع",1,0],["قارِئُها يَنظُرُ في رَوضَةٍ","مَوشِيَّةِ الأَقطارِ بِالزَهرِ",21,"ر",1,0],["قاريهِ يا صاحِ لِإِفهامِهِ","وَلَيسَ لِلإِطرابِ بِالصاحي",22,"ح",2,0],["قارِحٍ قَد فُرَّ عَنهُ جانِبٌ","وَرَباعٍ جانِبٌ لَم يَتَّغِرْ",23,"ر",1,0],["قارزقني أعلى مقام في متابعة الرسول","أحمد خير الخلق هاديها",24,"ي",3,0],["قَارعتَ دُونِي الحادثاتِ فَلا","طرقَتْ فناءَكَ ما دَجَا السّدَفُ",25,"ف",1,0],["قارعت أيامي لعمرك جاهداً","حتَّى انتضيت لها حسام الدِّين",26,"ن",1,0],["قارن البدر بالمسرة شمساً","يتسامى بها الزفاف الحميدُ",27,"د",1,1],["قارَضَني وأيّما قِراضِ","فاعْتَضْتُ منه أحسنَ اعْتياضِ",28,"ض",1,0],["قارعْتُه وعلِمْتُ أني ناكحٌ","طَمعاً متى ألقَحْتُه لم يَنتُجِ",29,"ج",1,0],["قاربتِها ملاحة","وفَضَحتْكِ مِلْحا",30,"ح",2,0],["قارٍ إذا شكر المَبيتَ ضُيوفُهُ","في دُهْمَةٍ فعشاره لم تشكر",31,"ر",1,0],["قارعته فتشظى عود صعدته","ضعفاً وهل يتساوى النبع والضال",32,"ل",1,0],["قارعوا عنِّيَ الخطوبَ وسدّوا","يومَ سيلِ المكروهِ عنّي الأَتِيّا",33,"ي",2,0],["قارَعوا عَنِّيَ الخُطوبَ وَقَدْ هَم","مت وكادتْ تجنِي عليَّ الخطوبُ",34,"ب",1,0],["قارنَها الدّمعُ فبِئْسَ القَرِينْ","وربما قُلتُ فنِعْم المعين",35,"ن",1,1]]}