201498","المجتث"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100852","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100850","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112691","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71391","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118744","الطويل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124643","الطويل"],[3802,"","https://poetry.dctabudhabi.ae/diwan/poem/141075","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59488","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135622","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119681","البسيط"],[4178,"","https://poetry.dctabudhabi.ae/diwan/poem/146403","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136548",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133074","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83120","المتقارب"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139257","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58005","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136406",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/201301","المتقارب"],[4767,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=194945",""],[5081,"أَنَا الْجِنِّىُّ ذَا شِعْرِي","https://www.poetsgate.com/ViewPoem.aspx?id=191595",""],[5431,"إذا جحدت شفاه الخلّ يوما...","https://www.poetsgate.com/ViewPoem.aspx?id=190705",""],[5431,"أدمعيَ لُجّةٌ والشوقُ موجُ","https://www.poetsgate.com/ViewPoem.aspx?id=191648",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5464,"شبيه الياسمين يدا وخدا","https://www.poetsgate.com/ViewPoem.aspx?id=26637",""],[5582,"أَلا حَدِّثا عَنْ عَهْدِ ناقِضَةِ العَهْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186936",""],[6031,"خَلِيلَيَّ مِنْ علْيَا لُؤيِّ بنِ غَالِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=46401",""],[6152,"هل تنصتين إلى الأطيار شادية","https://www.poetsgate.com/ViewPoem.aspx?id=213228",""],[6167,"تحت العرش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85552&r=&rc=35",""],[2220,"رأيتُ الذي قدْ جاءَ من أرضِ بابلٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11708&r=&rc=578",""],[5126,"أقلّي اللَّوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87797&r=&rc=12",""]],"verses":[["فَلا تَطلُب دَواءَ الحَظ","ظِ قَد أَعيا الطَبيبَينِ",0,"ن",1,0],["فَلا تَطلُبَنَّ لَهُم عَثرَةً","سَتَأتيهِمُ هِيَ مِن ذاتِها",1,"ت",3,0],["فَلا تَطمَعَن يا دَهرُ فيَّ فَإِنَّهُ","مَلاذِيَ مِما راعَني وَوِقائي",2,"ا",2,0],["فلا تُطْعِموها السُّمَّ في الشّهْدِ ضَلّةَ","فذلِكَ سُمٌ لا يُداوِيَ بتَرْياقِ",3,"ق",1,0],["فَلا تَطلُبَن لِلمَرءِ ديناً فَإِنَّهُ","يَصُدُّ عَنِ الأَصلِ الوَثيقِ وَإِنَّما",4,"م",2,0],["فلا تطلبوا بعدها بدعةً","وكونوا كسائر من يتبع",5,"ع",1,0],["فَلا تُطعِمَن لَحمي الأَعادِيَ إِنَّهُ","سَريعٌ إِلَيكُم مَكرُها وَنَميمُها",6,"م",3,0],["فَلا تَطمَعنَ مِن حاسِدٍ في مَوَدَّةٍ","وَإِن كُنتَ تُبديها لَهُ وَتُنيلُ",7,"ل",1,0],["فلا تطمحُ النَّفْسُ فوقَ الكمالِ","وفوقَ الخلودِ لبعضِ المزيدْ",8,"د",1,0],["فلا تطمعوا في بُرْءِ ما بي فإنَّهُ","هو الداءُ قد أعيى الطبيبَ المداويا",9,"ي",2,0],["فَلا تَطيعوهُنَّ يَوماً فَقَد","تَكونُ النَدامَةُ مِنهُ سِنينا",10,"ن",2,0],["فَلا تُطمِعوهُنَّ يَوماً فَقَد","تَكونُ النَدامَةُ مِنهُ سِنينا",11,"ن",2,0],["فلا تُطْلقنْه واجعل الصمتَ قيدَهُ","وصيّرْ إذا قيّدتهُ سجنَهُ الفما",12,"م",2,0],["فَلا تَطلُبوا أَسيافَهُم في جُفونِها","فَقَد أُسكِنَت بَينَ الطُلى وَالجَماجِمِ",13,"م",1,0],["فَلا تَطمَح إِلى فَودي غُلاماً","غَريراً أَو اِغشِني كَهلاً أَريبا",14,"ب",2,0],["فَلا تَطمَعَن في ذاكَ مِنِّيَ سوقَةٌ","وَلا مَلِكُ الدُنيا المُحَجَّبُ في القَصرِ",15,"ر",1,0],["فَلا تَطلُبِ الدُنِيا وَإِن كُنتَ ناشِئاً","فَإِنّيَ عَنها بِالأَخلّاءِ أَربَأُ",16,"ب",2,0],["فلا تُطِعِ الدّوا لِفَ مُرْسَلاتٍ","فكمْ أوْقَعْنَ في أرْضٍ مَجَنّه",17,"ن",2,0],["فلا تَطْلُبَنْ مِن عندِ يوْمٍ وليْلَةٍ","خِلافَ الذي مَرّتْ به السّنَوات",18,"ت",1,0],["فَلا تَطْلُبَنَّ الْحُسْنَ في غَيْرِ أَهْلِهِ","فَأَبْدَعُ ما فِي الأَرْضِ حُسْنُ الأَعارِبِ",19,"ب",1,0],["فَلا تَطْلُبَنْ فِي النَّاسِ مِثْقَالَ ذَرَّةٍ","مِنَ الْوُدِّ أُمُّ الْوُدِّ فِي النَّاسِ هَابِلُ",20,"ل",1,0],["فلا تطولوا علينا في مساجدنا","فإنها جعلت للصحب والكتب",21,"ب",1,0],["فَلا تَطوِيا أَرضاً حَوَتهُ هُديتُما","وَمَهما تَنَل مِن مَوقِفٍ غَيرِ رائِثِ",22,"ث",1,0],["فَلا تَطمَعِ الأَوباشُ فينا فَإِنَّنا","رَحاها وَما الأَوباشُ غَيرُ ثُفالِ",23,"ل",1,0],["فلا تطعْ من يلومُ فيهِ","ولا يغرنكَ ما يغرُّ",24,"ر",1,0],["فلا تطلبن منها وفاء فانها","كثيرة مطل والوفاء بها نزر",25,"ر",1,0],["فلا تطلب الأشياء ما لم تطل بها","فما في سواها للمؤمل طائل",26,"ل",1,0],["فلا تطمعن في رأفة من قلوبهم","وهل امرؤ غير الأمير رؤف",27,"ف",1,0],["فَلا تَطلُبِ الرِزقَ حَتّى تَرى","مِنَ الصَيفِ يَوماً نَقِيَّ الأَديمِ",28,"م",1,0],["فلا تطلبن علوا المراتب واعتبر","بوقع ثمار من شواهق أغصان",29,"ن",1,0],["فَلا تُطِل الملامَ فلستُ أصغي","فَأدري كيفَ تُقصِرُ أَو تُطيلُ",30,"ل",1,0],["فلا تطلبنَّ الماضيات تصرَّمَتْ","فليس بحالٍ أنْ تسُرّك حالا",31,"ل",2,0],["فلا تطق الأفهام تعبير كهنها","ولكنها لاذت بألطافها الحسنى",32,"ن",2,0],["فلا تطلبنْ منه سوى سدِّ خَلَّةِ","فإنْ زاد شيئاً فليكن للمواهبِ",33,"ب",1,0],["فلا تطلبا مني مزيدَ صبابةٍ","فبرحُ اشتياقي ما عليه مزيد",34,"د",1,0],["فَلا تُطِع مِن بَعدِها غِرَّةً","إِن هِيَ دَلَّتكَ عَلى ذِكري",35,"ر",2,0],["فَلا تَطمَعَن مِن عَذبِ قُربى بِشَربَةٍ","فَقُربُكَ لِلظامي إِلَيهِ سَرابُ",36,"ب",1,0],["فلا تطلق جواد الفكر ركضا","فإن العسكرية كاللجام",37,"م",1,0],["فلا تطف نار الشوق بالشوق طالباً","سلواً فإن الجمر يسعر بالجمر",38,"ر",1,0],["فلا تطف نار الحب بالحب طالباً","سلواً فإن الجمر يسعر بالجمر",39,"ر",1,0],["فلا تطلبوا يا حاسِدِيه اِغتيالَه","فتخطفكُم غُولُ الخُطوبِ الغَوائِلِ",40,"ل",1,0],["فلا تطعموا أنْ تظلموني فإنْني","بعيدٌ متى حاولتُمُ عن يد الظلْمِ",41,"م",1,0],["فلا تطلبوا حربي فإنّ غَبِينَةً","طِلابُ اِمرئٍ حربي وفي كفِّهِ سِلْمِي",41,"م",2,0],["فلا تطلبا منّي لقاءَ محاربٍ","فَما أَنا إِلّا في ثيابِ مُسالِمِ",42,"م",1,0],["فَلا تَطلبوا منّي دليلاً على الهوى","كفى بِضنى جسمي عليه دليلا",43,"ل",2,0],["فلا تطعموا في مثلها بعد هذه","فمن عزّ لا بالحقّ عاد ذليلا",43,"ل",2,0],["فلا تطمعوا في مثلهنّ فإنّما","يصلْنَ لطُلّاعِ الثّنايا الغطارفِ",44,"ف",1,0],["فلا تطلعَنْ فوقكنّ النّجوم","فذاك طلوعٌ بلا أسعُدِ",45,"د",1,0],["فَلا تَطلبِي ما ليس عندي تعنّتاً","سيكفيك منِّي لو تأمّلتِ ما عندي",46,"د",2,0],["فلا تطلبا عندي النجاة فإنّنِي","أروحُ وأغدو في إِسارِ عجائِبِهْ",47,"ب",2,0],["فَلا تَطمَعوا مِن ذي حِجىً بِنَظيرها","فَكُلُّ اِمرِئٍ يُدعى إِلى مِثلِها أَبى",48,"ب",2,0],["فَلا تَطلُبوا ما لَم يَحِنْ بَعدُ حينُهُ","فَطالبُ ما لم يَقضِهِ اللّهُ خائبُ",49,"ب",1,0],["فَلا تَطلُب إذا آواكَ حِصنا","هِدادَ ولا بَراشَ ولا ظَفارا",50,"ر",2,0],["فلا تُطمِع الساداتِ فيما وَرثتَه","فَكَم طَمَعٍ في الإرث أسقَطَهُ الحَجب",51,"ب",1,0],["فلا تُطعِم الغِربانَ طَعمة أجدَلٍ","وتُعطي ضِباع الشِّعر حَظِّ الغِضَنفَرِ",52,"ر",1,0],["فلا تطمعن في كشف ستر سريرتي","بأقلام أقوالي ملأت مدوني",53,"ي",1,0],["فَلا تطمعوا في سلوة مِن متيم","لَهُ حَظ مَسعود بِحفظ عُهود",54,"د",1,0],["فَلا تُطع الواشي وَزخرفَ قَوله","فَذَلِكَ بُهتانٌ وَزور كَلام",55,"م",1,0],["فَلا تَطلُبوا غَيرَ الحَبيبِ بِقتلَتي","فَمِن جَفنِهِ سَهماً رَماني مِنَ الهدبِ",56,"ب",1,1],["فلا تطلبنَّ الوُد من متملقٍ","ولا تحسبنَّ الدين ثوباً محرَّضا",57,"ض",2,0],["فلا تَطْمَعا لي في إِفاقةِ سَلْوَةٍ","فسُكْرِيَ قاضٍ أَنّني لا أُفيقُها",58,"ق",3,0],["فلا تطمعوا أن تهضمونا بهذه","فليس لحر في البرية هاضم",59,"م",1,0],["فَلا تَطلُبوا مِن عِندِ والٍ مودّةً","أَلا رُبَّ والٍ قَد تَغَيَّرَ وُدُّهُ",60,"د",2,0],["فلا تطبيه الغادةُ السهلةُ الحَشا","ولا صدرُها الموفي عليه نُهودُهُ",61,"د",2,0],["فلا تطفي الدموع لهيبَ حزني","وغير القبر لا يطفي التهابي",62,"ي",1,0],["فلا تطع في شربها من هجا","واشرب وأمهر بكرها بالحجا",63,"ج",2,0],["فَلا تَطلُبا في مَتجَرِ الحُبِّ مَكسَبا","فَوَالعَصرِ إِن العاشِقينَ لَفي خُسر",64,"ر",1,0],["فَلا تَطلُبَنَّ القُربَ وَالبُعدُ بَعدَها","إِلى غَيرِ نِيّاتٍ وَغَيرِ قُلوبِ",65,"ب",1,0],["فَلا تَطلُب لَها صَوناً فَإِنّي","ضَمِنتُ لَها اِنطِلاقاً لا طَلاقا",66,"ق",2,0],["فَلا تَطمَعِ الآمالُ فيما مَلَكتُمُ","فَما تَتَخَلّى عَن فَرائِسِها الأُسدُ",67,"د",1,0],["فَلا تَطلُبُوا العَفوَ عَن جُرمِكُم","فَأَحسَنُ عَفوِكُمُ المُنصُلُ",68,"ل",1,0],["فلا تطمع الأشعار إن نلن وصفه","حليم به القرآن جاء فما الشعر",69,"ر",1,0],["فَلا تَطمَعَن فِى ذَا وسَمعُكَ قَد صَغى","حَدِيثُ سِوَاها فِى خُرُوقِ المَسامعِ",70,"ع",1,0],["فلا تطمعن من بعد ذا في عطية","وثق بقبيح المنع والدفع والرد",71,"د",1,0],["فلا تطلب من الرحمن عهداً","فيسألك المهيمن عن عهوده",72,"د",2,0],["فلا تطمعَنْ في الحبِّ فهو خديعة","أراك لتمشي في حِبالةِ حابل",73,"ل",1,0],["فلا تطل حبل النوى إنّني","والله أشتاق إلى طلعتك",74,"ك",1,0],["فلا تطمعَا في أن افارق حبّها","واقصر عنها بعدان كنت أهواها",75,"ا",3,0],["فَلا تَطلُب بِعِلمِ اللَّهِ دُنيا","فَفِي هَذا الهَوانُ وكلُّ خُسرِ",76,"ر",1,0],["فلا تطيق صعوداً","ولا أطيق نزولا",77,"ل",2,0],["فلا تطلب الدنيا اذا كنت عاجزاً","عن الدأب مفطوراً على الضيم والذل",78,"ل",1,0],["فلا تطلبوا مني الوداد وانتم","أشد من الأعداءِ عن تنائيا",79,"ي",2,0],["فلا تطالبوا بوتر أحدا","ولا تؤاخذوا برئيا أبدا",80,"د",2,0],["فَلاَ تُطِعِ الإِيجَابَ إِلاَّ تَقِيَّةَ","بِهَا واعْتَمِدْ في سَلْبِ إِيجَابِهَا الهُدَى",81,"د",2,0],["فلا تطمعي مني بودٍّ وجمعهم","غدا مفرداً في أسره بالعنا يسري",82,"ر",2,0],["فلا تَطرَحَنَّا أَن سَقَوكَ عَلَى الظَمَا","مَعَ النَّاسِ يوماً مِن سجالِهمُ سَجلا",83,"ل",2,0],["فلا تطلبوا المجدَ الأثيلَ بأنفسٍ","عزيزٌ عليها أن تجدَّ لتغْنَما",84,"م",2,0],["فلا تطع اللاّحين في السلم إنما","قُصارى انبعاث الحرب قطع المفاصلِ",85,"ل",1,0],["فلا تطع نفسك للشيطانِ","فهو العدوُّ المردي للإنسانِ",86,"ن",1,0],["فلا تُطيلنَّ بالشهباء سفرتكم","قد أسفر البعد عن جَهدٍ وأضرار",87,"ر",1,0],["فلا تطلب لدي لسان صدق","وجاوزني عساك تنال ثمه",88,"ه",1,0],["فلا تطمعن اليومَ في ّ فانني","على الفتَك لولا راسخُ الحب قادر",89,"ر",1,0],["فلا تطلبن الصدق من أهل ذا الزمن","فمطلبهم الدنيا وما يألفونه",90,"ه",1,0],["فَلا تَطلبنَّ وِدادَ الصَديقِ","بِمَدحٍ كَذوبٍ خَسيسِ القِيَم",91,"م",1,0],["فلا تطع الهوى فيهن واعدل","ففي العدل الترضي والسلامه",92,"ه",1,0],["فلا تطلبنْ إلا من الله نصرةً","فما من مُذِلٍّ من له اللهُ مانعُ",93,"ع",1,0],["فلا تطمعن فيه ولا تخضعن له","وذرْهُ كأمثال الصعيد وجلمد",94,"د",1,0],["فلا تطلبوا يا حاسديه لحاقه","فذاك محال والمزايا مواهب",95,"ب",1,0],["فلا تطمعنك تلك الغصون","فإن كثيب نقاها مصون",96,"ن",1,0],["فلا تطيروا بِما قد نلتمُ فرحاً","لأنَّ مِن بعدهِ حزناً سينفجر",97,"ر",1,0],["فَلَا تُطْرُوا عَلَى حَرْفٍ","لِسَارِقِهِ الَّذِي قَدْ رَصْ",98,"ص",1,0],["فلا تطمع فأنت اليوم ظلٌّ","وهل للظلِ أن يلقي لظاه",99,"ا",2,0],["فلا تطمع بوصلٍ أو بحبٍ","له في معبدِ التحنان برجُ",100,"ج",1,0],["فلا تطلبن علو المراتب واعتبر","بوقع ثمار من شواهق أغصان",101,"ن",1,0],["فلا تُطلِقْ سراحي .. إنّ قلبي","يضيعُ غداةَ تُطلِقه ُ السّراحا",102,"ح",2,0],["[ فَلا تَطْمَعُوا أَنْ أَجْتَدِيهِمْ فَإِنَّنِي","لَمُقْتَنِعٌ عَمَّا لَدَيْهِمْ بِما عِنْدِي ]",103,"د",2,0],["فَلاَ تُطِعِ الحُسَّادَ فِيَّ فإنَّمَا","أَتَوكَ بِأقْوَالٍ كَرُمْتَ كَوَاذِب",104,"ب",1,0],["فلا تطيلي إبتعادا عن مدارجنا","فإن بعدكِ عني زادني خطرا",105,"ر",2,0],["فلا تطلبونى إننى تُهتُ في المَدى","أُفَتِّشُ نفسى في فضاءٍ قدِ انتَشَرْ",106,"ر",1,0],["فلا تطعمنْ في الحبِّ فهوَ خديعة ٌ","أراكَ لتمشي في حبالة ِ حابِ",107,"ب",1,0],["فَلاَ تَطْمَعْ إذَا اخْتَلَفَتْ جَهَامٌ","فَقَدْ كَذَبَتْكَ بَارِقَةُ المَخِيلِ",108,"ل",1,0]]}