https://poetry.dctabudhabi.ae/diwan/poem/143985","البسيط"],[4755,"عَينَاكِ يا أُمَّ العيُونِ المِلَاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=184677",""],[4767,"قل للرجال","https://www.poetsgate.com/ViewPoem.aspx?id=175120",""],[4767,"أصابع الخبث","https://www.poetsgate.com/ViewPoem.aspx?id=178566",""],[4767,"عقد زينب","https://www.poetsgate.com/ViewPoem.aspx?id=179946",""],[4767,"لواء العدل","https://www.poetsgate.com/ViewPoem.aspx?id=180688",""],[4767,"صفقة خاسر","https://www.poetsgate.com/ViewPoem.aspx?id=211955",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[4927,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=12986",""],[4927,"رثاء الشهيدين برزان التكريتي وعواد البندر","https://www.poetsgate.com/ViewPoem.aspx?id=12987",""],[5055,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=102729",""],[5072,"أنا بانتظاركِ","https://www.poetsgate.com/ViewPoem.aspx?id=61801",""],[5111,"الإشْرَاق","https://www.poetsgate.com/ViewPoem.aspx?id=212050",""],[5121,"يَا عِيدُ مَرحَى","https://www.poetsgate.com/ViewPoem.aspx?id=33497",""],[5121,"أرجوحة الأحضان","https://www.poetsgate.com/ViewPoem.aspx?id=34651",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5273,"قَبَسٌ من دارِ الأرقَم","https://www.poetsgate.com/ViewPoem.aspx?id=208601",""],[5408,"أقسمت إني لا أخونك","https://www.poetsgate.com/ViewPoem.aspx?id=190872",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[5829,"امنت بالله","https://www.poetsgate.com/ViewPoem.aspx?id=155462",""],[243,"شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68161&r=&rc=153",""],[6237,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77859&r=&rc=1",""]],"verses":[["وَاِستَأثَرَت بِالأَمرِ عَن غُيّابِها","وَقَضَت بِما شاءَت عَلى شُهّادِها",0,"د",3,0],["واسْتَأْنَفَ الفُضَلاءُ في أيامِهِ","عِزّاً فلمْ يتَضاءَلوا لِلهُونِ",1,"ن",1,0],["واسْتأنَفَ الرّوْضُ اقْتِبالَ شَبابِهِ","فأطَلّ منْ بعْدِ المَشيبِ عِذارُهُ",2,"ر",2,0],["واسْتأثَرَ الرّحمانُ جلّ جَلالُه","عنْ خَلْقِهِ بخَفيِّ سِرِّ الرّوحِ",3,"ح",1,0],["واستأذَنَت ومَشَت بالدُّفِّ واندَفَعَت","تُشجي بألحانِها ما شاءَ مُشجيها",4,"ي",3,0],["واستأْذِن الناسَ أنْ تَغشى بُيوتَهُمُ","ولا تُلِمّ بدارٍ أو تَحَيِّيها",4,"ي",3,0],["واستاقت الياقوتَ في منقارها","ومشت على المرجان في استحياءِ",5,"ا",2,0],["واسْتأمنتهُ على أسرارِها دولٌ","قرَّت بها عينها في كلِّ مطلوب",6,"ب",1,0],["واسْتأنف الناسُ للأيامِ طيب ثناً","من بعد ما كثرت فيها الشكايات",7,"ت",1,0],["واستأنس الناس جدوى كفه فرووا","عن مالك خبر العليا وعن أنس",8,"س",1,0],["واستأسرتْ ضعفَى بنيه بعدهُ","فهُمُ لها أسرى بغير إسارِ",9,"ر",1,0],["واسْتُ الفتى سِفْلة فغايتُها","ووكدُها سِفلة يُشاكلُها",10,"ل",3,0],["وَاِستَأنَفَت تِلكَ المَطِيَّةُ ما","قَد كانَ مِن كَر وَمِن فَرِّ",11,"ر",1,0],["وَاِستَأسَدوا لَمّا رَأوا لَيثَ الشَرى","عافَ الزَئير وَقَلَّمَ الأَظفارا",12,"ر",2,0],["واستأنسّ من السقاة برفقة","غر كأمثال النجوم صباح",13,"ح",1,0],["وَاِستَأنِسَنَّ مِنَ السُقاةِ بِرُفقَةٍ","غُرٍّ كَأَمثالِ النُجومِ صِباحِ",14,"ح",1,0],["وَاِستَأنِفِ العُمُرَ الجَديدَ بِبَهجَةِ ال","قَصرِ الجَديدِ وَحُسنِهِ المُتَخَيَّرِ",15,"ر",1,0],["وَاستَأنِفِ العُمرَ جَديداً فَقَد","وَلّى زَمانٌ وَأَتانا زَمان",16,"ن",1,0],["واستامها فلك النحوس وشوّهت","مما يدوّرُ دورة ُ الأقمار",17,"ر",1,0],["واستَأثَرَتْ عَرَبيّاتُ الخيامِ بهِ","ولمْ يُوكَّلْ إلى أيْدي السَّراريّ",18,"ي",1,0],["واستأنَفوا بشِياتِها فجْراً فلو","عقَدوا نواصِيَها أعادوا الغَيْهبا",19,"ب",2,0],["وَاستَأذَنَ الكاتِبُ في خَتمِهِ","وَقَد دَعَوا لِلخَتمِ بِالطينِ",20,"ن",1,0],["وَاِستَأثَرَت بِكَ وَهيَ تَعرِفُ ضَيفَها","عِرفانَ مُحتَفِلٍ بِمِثلِكَ مُكرِمِ",21,"م",1,0],["واسْتامَها مُثْرٍ وآخَرُ مُعْوِزٌ","ومِنَ الرّجَالِ مَعاوِزٌ ومُلوك",22,"ك",1,0],["وَاسْتَأْنَفِ الأَيَّامَ بَعْدَ مَتَابِهَا","فِي نِعمةٍ أَوْفَى وَمَجْداً أَوْفَرَا",23,"ر",2,0],["وَاسْتأْسَرَتْهُ وَإخْوَاناً له سَبَقوا","مَظَاهِرٌ مِنْ رَخاءٍ ما عَرَفْنَاها",24,"ا",3,0],["واستَأنِسوا الأطفال في حَلقَاتِكُم","بِبَراءةٍ كبَراءةِ الأطْفالِ",25,"ل",1,0],["واستأثرت بقلوب حزب محمد","لله فجعة ذاك الاستئثار",26,"ر",1,0],["واستأنف الروض اقتبال شبابه","فأظل من بعد المشيب عذاره",27,"ر",2,0],["واستأثر الرحمن جل جلاله","عن خلقه بخفي سر الروح",28,"ح",1,0],["واستامَني للمرجفين دريئةً","يهدي إليها شامتا او مُغرِضا",29,"ض",2,0],["واستاذ عنايته بحق","مجربة لانقاذ الغريق",30,"ق",1,0],["وأستار آثار بديع جمالها","لسان عنايات يقول عن اللَه",31,"ل",2,0],["واستأنسى ثم اصبري","فالصبر فيه فائِدَهْ",32,"د",2,0],["واستأسَرَ الحُلمُ باختيار","وطار همِّي بلا عِقالِ",33,"ل",1,0],["وَاِستَأنَفَ السَبعَ وَسَبعاً بَعدَها","وَالسبعَ ما بَينَ العِقابِ وَالصُوى",34,"ا",1,0],["واستأذنوا الحجاب يستأذنوا لنا","لنحظى بما ترجو الأماني وبغيتي",35,"ت",2,0],["وَاِستَأنِ حِلمَكَ في أَمورِكَ كُلِّها","وَإِذا عَزَمتَ عَلى الهَوى فَتَوَكَّلِ",36,"ل",1,0],["وَاِستَأنفي مَوصولَ عائدِ أُنسِنا","فَالقُرب عيدي وَالبِعادُ وَعيدي",37,"د",2,0],["وَاِستَأزَرَ الإِسلامُ وَاِبتَهَجَ ال","مُلكُ وَأَوفَت بِنَذرِها الأُمَمُ",38,"م",1,0],["وَاسْتافُ الثُّرى مَذْ حَلَّ فِيهِ","وَأَلْصِقُهُ التَّرائِبَ وَالنُّحُورا",39,"ر",2,0],["وَأسْتافُ حُرَّ الرَّمْلِ شَوْقاً إِلى اللِّوى","وَقَدْ أَوْدَعَتْنِي السُّقْمَ قُضْبانُ كثْبِهِ",40,"ب",2,0],["واِستأنفَ الإِنعاما","عليهِ والإِكراما",41,"م",2,0],["وَاِستَأنِسِ النارَ الَّتي","أَهدَت هُداهُ بِطَلِّهِ",42,"ل",2,0],["وَاِستَأنَسوا بِالدُجى النارَ الَّتي ظَهَرَت","بِطَورِ سيناءَ مِن أَجبالِ فارانِ",43,"ن",1,0],["وَأَستَأنِفي لَثم التُرا","ب لَدَيهِ لا تَستَنكِفي",44,"ف",2,0],["وَاسْتَأْمَنَتْ منّي صروفُ الدَّهْرِ إذْ","نَهَضَتْ جيوشَ نَداكَ في إِنجادي",45,"د",2,0],["واستأذنت على الحيا مجدبةً","أرضِي ولكنّ الحيا ما أذِنا",46,"ن",2,0],["واستامها المفلِسُ لما غدتْ","تباعُ بالفلْس فلا تشتَرَى",47,"ر",2,0],["واستأنفت لك عُونها","ما أسلفَتْ أبكارُها",48,"ر",3,0],["وَاِستَأسَرَت عَقلَهُ حيناً كَما أُسِرَت","في دَنِّها حِقَباً مِن غَيرِ ما سَبَبِ",49,"ب",1,0],["وأستافُ طيبَ الَعْرفِ مِن نفحاتِه","فأغنى بهِ عن نفحتةِ الطيبِ والعِطرِ",50,"ر",1,0],["واستأنفوا السير من بعد الصلاة إلى","حيث المقر الذي يزكو بأهليه",51,"ي",2,0],["واستأثرت بالمجد همتك التي","يأبى نداها قسمة المستأثر",52,"ر",1,0],["واستأصل النهب والإحراق ما تركت","لي الحوادث من مال ومن دار",53,"ر",1,0],["وَاسْتَأْثَرَتْ بِأُصُولٍ لاَ كِفَاءَ لَهَا","مِنَ الجَمَالِ وَأَعْطَتْ غَيْرَهَا الفَضْلَهْ",54,"ل",2,0],["واستأثرت بك رحمة الرحمن كي","تثوي هناك بموضع الاقداس",55,"س",1,0],["واستأنست نفسي بطلعته فمن","أشراقها نور البصيرة والبصر",56,"ر",1,0],["وَاِستَأنَفَ الدَهرُ سَلماً لا يَكدَرُها","فَالدَهرُ قَد يَرتَدي حالاتُ أَضدادِ",57,"د",1,0],["واستَأنَسَت وَأمَدَّت في صَواحِبِها","شَجواً بِشَجوٍ وَإرناناً بإرنانِ",58,"ن",1,0],["واستَأسَدَت عُرجُ الضِّباعِ وأصبَحَت","شُهبُ البُزاةِ تُصادُ بِالغِربانِ",59,"ن",1,0],["واستأصلت ثار بدر في بواطنها","وأظهرت ثار من في الدار قد صرعا",60,"ع",2,0],["واستأصلت نوب الزمان","مفاخر الشرف الأصيل",61,"ل",1,0],["واستأصلوا كل بدر نور غرته","فارسلوه على سعديهم غررا",62,"ر",2,0],["واستأثروا بأمانات الحمى وقضوا","فيه على كل محفوظ ومخزون",63,"ن",1,0],["واستأذنوا ليصافحوكم بينما","أيدي الخطوب بغيركم تترامى",64,"م",2,0],["واستأصلوا حرب في حرب حروبهم","دور الرحى لم تذر طفلاً ولا هرما",65,"م",2,0],["واستأثر الأخرى على الدنيا فأن","فق مالهُ للأجر في الحِسبَانِ",66,"ن",1,0],["وَاسْتَأصَلَتْ طَيْرَ الفُؤَادِ وَقَدْ رَمَتْ","بِسِهَام لَحْظٍ عَنْ قِسِيّ حَوَاجِبِ",67,"ب",1,0],["واستأجر القلم الباغي وألسْنَةً","كانت له في النضال المرّ أعوانا",68,"ن",2,0],["واستاق منا، يرُجّي عفوَهُ، نفراً","خبّاً، ومستضعفا غرّا، وربّانا",68,"ن",2,0],["واستأنس النادي وراق الحمى","واستحيت الأحياءُ والأربعُ",69,"ع",1,0],["واستأمن الملك السعيد على","افتتاحات تعود وقهر كل أعادى",70,"د",2,0],["واستامنوه على خرافات لهم","فبدا يبدّد ما لهم ويبدرقُ",71,"ق",1,0],["واستَأْنِفِ العَقْلَ وانْزِعْ","عن الذُّنوبِ السَّوالفْ",72,"ف",1,0],["واستأثرت عيناك","بالسحر القلوب فليس تفدى",73,"د",2,0],["واستأصلي حتَّى الرضيعَ","لآل حربٍ والرضيعه",74,"ع",2,0],["واستامهُ مَن ليس يفرقُ بين ما","يفنى ومابقى عَلَى الانشادِ",75,"د",1,0],["وَاِستَأسَدَ العَدوى بِها وَاِستَنسَرَت","فيها البُغاثُ قَديمةُ الأَخطاءِ",76,"ا",2,0],["واستأسدت نوب الأيام فاجترأت","بنات أوى على الأشبيال في الأجم",77,"م",1,0],["واستأذنت عائتها شاكره","فأممت بيروت مع طفلها",78,"ه",2,0],["واستاذ اجيال الى كل سؤدد","احاديثه من غاليات عظات",79,"ت",1,0],["واستأثروا بالردى من دون سيدهم","قصداً وما كل ايثار به الأرب",80,"ب",1,0],["واستأصلت ركن المعالي","بعد تشييد العماد",81,"د",1,0],["واستأنسوا برسالةٍ ألقت على","طول الزمان محامد الآثار",82,"ر",1,0],["وَاستأسد الظَبي الأتيلع جيده","فَتَراه تذعر مُقلتاه الذيبا",83,"ب",2,0],["واستأسد الأتراك والعلوجُ","وهاجمت جيوشهُ الزنوجُ",84,"ج",1,0],["واستأصلي دمعك الهتان يا مقلي","وابكى لنائبة منها وهي جلدي",85,"د",2,0],["واستأنست حين القبول فأرخت","العيد أضحى في حماه وكبرا",86,"ر",2,0],["واستأنف الناس الحياة فعامل","جمّ النشاط وعاطل يتحرق",87,"ق",1,0],["واستأسدوا وهم الذئاب مهانة","لما ثوى تحت التراب الضيغم",88,"م",1,0],["واستأصل واستباح هجري كله","لا حول ولا قوة إلا بالله",89,"ه",1,0],["واستانف الطلاق من قد طلقا","أو لم يطلق من مضى موفقا",90,"ق",2,0],["واستأذنَ الندبُ الهمامُ عَمرو","وصالَ وهوَ الأسدُ الهَزِبرُ",91,"ر",1,1],["واستأذَنَ الإمامَ في القتالِ","وصالَ فيهم صولهَ الرئبالِ",92,"ل",1,0],["وَأَستاهُ الإِماءِ بَني صُبَيرٍ","لَهُم نَوحٌ إِذا مَرِضَ العَتودُ",93,"د",1,0],["واسْتَأْنِ إنْ نَبَذَ الأناة مُعاندٌ","ونأى بجانب شانئٍ مُتلَوّن",94,"ن",1,0],["وأستاف نشراً كلما هب ضائعاً","يحدث أنفاس الحبيب المبعد",95,"د",1,0],["واستأصَلَ اللَهُ أصلاً كانَ أَنبَتَهُ","واجتاحَهُ حينَما تَمَّت مَقاصِدُهُ",96,"د",2,0],["واستاسدَ الآسادَ صِمنَ عرينِها","واراعَ قلبَ الرِيم داخل كُنسِهِ",97,"س",2,0],["واستاصلوا بثبات الجاش شأفتهم","ظهرا وعصرا وإمساء وإصباحا",98,"ح",2,0],["واستأثر الأقويا بالخير بل خدعوا","لب اللبيب فراح الكل منخدعا",99,"ع",2,0],["واستاصل اللَه العظيم شأفته","وأسكت اللَه العزيز نامته",100,"ه",1,0],["واستَأنَفَ السَّيرَ السَّرِيعَ مُطَوِّفاً","لذِيُومذٍ ذي العِزَّةِ الأَبَّاءِ",101,"ا",2,0],["واستاقهم بالصولجان فأدبروا","من وجهه وبنيه أقبل يزجر",102,"ر",1,0],["واستاقها فمضت تغير بداره","ورتاجها من وقع ذاك الجري صر",102,"ر",1,0],["واستأنف السير في جد إلى وطني","إلى الإمار