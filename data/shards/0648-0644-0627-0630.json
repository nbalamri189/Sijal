{"poems":[[53,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[55,"غضبت لأن جاد الرقاد بنظرة","https://www.aldiwan.net/poem26111.html","الطويل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[42,"تعاتبني عرسي على أن أطيعها","https://www.aldiwan.net/poem50365.html","الطويل"],[73,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[54,"أتيت ابن عمرو فصادفته","https://www.aldiwan.net/poem27410.html","المتقارب"],[47,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[72,"نفرت عن الظبي الذي كان ينفر","https://www.aldiwan.net/poem18710.html","الطويل"],[64,"والله ما طلعت شمس ولا غربت","https://www.aldiwan.net/poem67558.html","البسيط"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[91,"لمن يضوع العبير لمن تغني الطيور","https://www.aldiwan.net/poem8821.html","عموديه"],[85,"ألا في سبيل الله ذاك الدم الغالي","https://www.aldiwan.net/poem62834.html","الطويل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[56,"دعانا أبو عمرو عمير بن جعفر","https://www.aldiwan.net/poem58604.html","الطويل"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[28,"صل يا جنيد الخير لله صولة","https://www.aldiwan.net/poem5582.html","الطويل"],[61,"أعاد الحيا سكر النبات وقد صحا","https://www.aldiwan.net/poem51735.html","الطويل"],[44,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[31,"لو كان يخفى الحب يوما خفى لنا","https://www.aldiwan.net/poem42227.html","الطويل"],[74,"وصهوة عزم قد تمطيت والدجى","https://www.aldiwan.net/poem12922.html","الطويل"],[105,"يقولون لي ماذا قرأت لعلهم","https://www.aldiwan.net/poem43113.html","الطويل"],[105,"بجير كيف يخطئك السداد","https://www.aldiwan.net/poem44041.html","الوافر"],[105,"محيصة بلغ ما أمرت فإنما","https://www.aldiwan.net/poem44056.html","الطويل"],[21,"ثم لوط أخو سدوم أتاها","https://www.aldiwan.net/poem36138.html","الخفيف"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[50,"جفا ودهُ فازور أو مل صاحبهُ","https://www.poetsgate.com/ViewPoem.aspx?id=17924",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""]],"verses":[["وَلا ذاكِراً ما كانَ بَيني وَبَينَكُم","مُراجَعَةً إِنَّ المُحِبَّ المُراجِعُ",0,"ع",1,0],["وَلا ذَنبَ لي لَو كُنتُ أَعلَمُ لَم أَنَم","وَلَكِنَّني فيما بَقي سَوفَ أَعلَمُ",1,"م",1,0],["ولاذوا الى السِّلْمِ اسْتِلاماً ورَهْبَةً","وقد شارَفوا وِرْدَ المنيّةِ أو كادُوا",2,"د",3,0],["وَلا ذَنبَ لي قَد قُلتُ في بَدءِ أَمرِنا","وَلَو عَلِمَت ما عُلِّمَت ما تَعَيِّتِ",3,"ت",1,0],["وَلاذَ بِهِ الدينُ مُستَعصِماً","بِذِمَّةِ أَبلَجَ وافي الذِمَم",4,"م",1,0],["وَلا ذَنبَ لِلنارِ في سَفعِهِ","إِذا هُوَ أَصبَحَ مِحراثَها",5,"ث",3,0],["وَلا ذَنبَ لي إِنَّ الفُؤادَ لَصارِمٌ","وَإِنَّ الحُسامَ المَشرَفِيِّ لَفاصِلُ",6,"ل",1,0],["ولا ذنبَ لي عند الزمان كما ترى","سوى كلمٍ كالروض تبهى وتبهر",7,"ر",1,0],["وَلا ذَكَرتُكَ مَحزوناً وَلا فَرِحاً","إِلّا وَأَنت بِقَلبي بَينَ وِسواسي",8,"ي",1,0],["ولأذيالها على","قدميها تلفُّف",9,"ف",1,0],["ولا ذنبَ للمظلومِ إن باتَ مُرصِداً","لسوءِ فعالٍ منكَ سوءَ مقالِ",10,"ل",1,0],["وَلاذَ قَلبي بِصَدري","كَأَنَهُ عُصفورُ",11,"ر",1,0],["وَلاذَ بِقُضبانِ الحَديدِ شَهيدُهُ","فَعادَت رَفيفاً مِن عُيونٍ وَأَطلالِ",12,"ل",1,0],["وَلا ذَرَفتِ الدَمعَ يَوماً وَإِن","أَسرَفتِ في الدَمعِ وَفي سَكبِهِ",13,"ب",2,0],["ولا ذَنْبَ للأَضْيافِ إِنْ نالَكَ الرَّدَى","فإنَّ المنايا للدُّيُوكِ بِمَرْصَدِ",14,"د",1,0],["وَلا ذَكَرتُ جَميلاً مِن صَنائِعِها","إِلّا بَكَيتُ وَلا وُدٌّ بِلا سَبَبِ",15,"ب",1,0],["ولاذُوا بأكراد البوادي وعُرْبهم","ومن كلِّ جيلٍ أمةٌ وقبيلُ",16,"ل",1,0],["وَلا ذُكِرَت عِندَ المُلوكِ قَماقِمٌ","بِفَضلِ نَدىً إِلّا الجُنَيدُ هُمامُها",17,"م",3,0],["ولاذَ نسيمُ الرَّوْضِ من طولِ سَيرِه","حسيراً بأطرافِ الغصونِ مُطلَّحا",18,"ح",2,0],["وَلاذَت بِحُقوَيهِ الخِلافَةُ وَاِلتَقَت","عَلى خِدرِها أَرماحُهُ وَمَناصِلُه",19,"ل",2,0],["وَلا ذُكِرَت يا صاحِ إِلّا وَجَدتُها","بِوُدّي وَإِلّا زادَ حُبّي لَها ضِعفا",20,"ف",2,0],["وَلاذَ بِهِ نَسرُ السَماءِ كَأَنَّما","يَحِنُّ إِلى وَكرٍ بِهِ ذَلِكَ النَسرُ",21,"ر",1,0],["وَلاذَت بِأَكنافِ الجَزيرَةِ مِنهُمو","كَتائِبُ حَلَّت مِن جَهَنَّمَ وادِيا",22,"ي",2,0],["ولاذَ بِمَعْقِلِ الإسلامِ كَعبٌ","فلا رُكنٌ يَميلُ ولا عِمادُ",23,"د",1,0],["ولاذُوا بأكنافِ النبيِّ فصادفوا","كرِيماً يُرجَّى عنده العفوُ والفَضْلُ",24,"ل",1,0],["وَلا ذاهِباً إِنّي أَخافُ نِبالَهُم","يَخالونَهُ مالي وَليسَ بِمالِيا",25,"ا",1,0],["وَلاذَ المَها بِالظِلِّ وَاِستَوفَضَ السَفا","مِنَ الصَيفِ نَتّاجٌ تَخُبُّ مَواكِبُه",26,"ب",2,0],["ولاذَ مِنَ الغزالةِ وهْيَ تُذْكي","بغَرْزِ الراكبِ القَلِقِ الغَزال",27,"ل",1,0],["وَلاَذَ الْمَهَا بالظِلِّ وَاسْتَوْفَضَ السَّفَا","منَ الصَّيْف نَئَاجٌ تَخُبُّ مَوَاكبُهْ",28,"ب",2,0],["ولا ذُعِرْتُ لشرٍّ غيرِ مُنْتَظَرٍ","ولا نزقتُ لخيرٍ غيرِ محسوب",29,"ب",1,0]]}