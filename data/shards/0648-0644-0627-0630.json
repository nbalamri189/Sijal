bi.ae/diwan/poem/91158","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117962","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33140","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105265","المتقارب"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78248","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119654","الطويل"],[4078,"","https://poetry.dctabudhabi.ae/diwan/poem/199413","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90849","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94374","البسيط"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122430","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83562","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28785","البسيط"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130866","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133064","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76722","الطويل"],[4679,"أأذنبَ في لونه الأسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=142773",""],[4755,"العَمَّارُ الغَريب","https://www.poetsgate.com/ViewPoem.aspx?id=184179",""],[4927,"مؤامرات ومؤتمرات سورية","https://www.poetsgate.com/ViewPoem.aspx?id=79602",""],[4927,"أبناء السحالي","https://www.poetsgate.com/ViewPoem.aspx?id=80797",""],[4119,"لك الله إن حاربت فالنصر والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=16107",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5054,"أنتِ مُنايَ","https://www.poetsgate.com/ViewPoem.aspx?id=215691",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5358,"وداع في الليل","https://www.poetsgate.com/ViewPoem.aspx?id=21888",""],[5957,"تنحى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=176787",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[6004,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=59103",""],[6031,"لَعِبتْ بعطفيهِ الشمولُ فَمَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=46254",""],[6102,"عَجِيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=184446",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["وَلا ذاكِراً ما كانَ بَيني وَبَينَكُم","مُراجَعَةً إِنَّ المُحِبَّ المُراجِعُ",0,"ع",1,0],["وَلا ذَنبَ لي لَو كُنتُ أَعلَمُ لَم أَنَم","وَلَكِنَّني فيما بَقي سَوفَ أَعلَمُ",1,"م",1,0],["ولاذوا الى السِّلْمِ اسْتِلاماً ورَهْبَةً","وقد شارَفوا وِرْدَ المنيّةِ أو كادُوا",2,"د",3,0],["وَلا ذَنبَ لي قَد قُلتُ في بَدءِ أَمرِنا","وَلَو عَلِمَت ما عُلِّمَت ما تَعَيِّتِ",3,"ت",1,0],["وَلاذَ بِهِ الدينُ مُستَعصِماً","بِذِمَّةِ أَبلَجَ وافي الذِمَم",4,"م",1,0],["وَلا ذَنبَ لِلنارِ في سَفعِهِ","إِذا هُوَ أَصبَحَ مِحراثَها",5,"ث",3,0],["وَلا ذَنبَ لي إِنَّ الفُؤادَ لَصارِمٌ","وَإِنَّ الحُسامَ المَشرَفِيِّ لَفاصِلُ",6,"ل",1,0],["ولا ذنبَ لي عند الزمان كما ترى","سوى كلمٍ كالروض تبهى وتبهر",7,"ر",1,0],["وَلا ذَكَرتُكَ مَحزوناً وَلا فَرِحاً","إِلّا وَأَنت بِقَلبي بَينَ وِسواسي",8,"س",2,0],["ولأذيالها على","قدميها تلفُّف",9,"ف",1,0],["ولا ذنبَ للمظلومِ إن باتَ مُرصِداً","لسوءِ فعالٍ منكَ سوءَ مقالِ",10,"ل",1,0],["وَلاذَ قَلبي بِصَدري","كَأَنَهُ عُصفورُ",11,"ر",1,0],["وَلاذَ بِقُضبانِ الحَديدِ شَهيدُهُ","فَعادَت رَفيفاً مِن عُيونٍ وَأَطلالِ",12,"ل",1,0],["وَلا ذَرَفتِ الدَمعَ يَوماً وَإِن","أَسرَفتِ في الدَمعِ وَفي سَكبِهِ",13,"ب",2,0],["ولا ذَنْبَ للأَضْيافِ إِنْ نالَكَ الرَّدَى","فإنَّ المنايا للدُّيُوكِ بِمَرْصَدِ",14,"د",1,0],["وَلا ذَكَرتُ جَميلاً مِن صَنائِعِها","إِلّا بَكَيتُ وَلا وُدٌّ بِلا سَبَبِ",15,"ب",1,0],["ولاذُوا بأكراد البوادي وعُرْبهم","ومن كلِّ جيلٍ أمةٌ وقبيلُ",16,"ل",1,0],["وَلا ذُكِرَت عِندَ المُلوكِ قَماقِمٌ","بِفَضلِ نَدىً إِلّا الجُنَيدُ هُمامُها",17,"م",3,0],["ولاذَ نسيمُ الرَّوْضِ من طولِ سَيرِه","حسيراً بأطرافِ الغصونِ مُطلَّحا",18,"ح",2,0],["وَلاذَت بِحُقوَيهِ الخِلافَةُ وَاِلتَقَت","عَلى خِدرِها أَرماحُهُ وَمَناصِلُه",19,"ل",2,0],["وَلا ذُكِرَت يا صاحِ إِلّا وَجَدتُها","بِوُدّي وَإِلّا زادَ حُبّي لَها ضِعفا",20,"ف",2,0],["وَلاذَ بِهِ نَسرُ السَماءِ كَأَنَّما","يَحِنُّ إِلى وَكرٍ بِهِ ذَلِكَ النَسرُ",21,"ر",1,0],["وَلاذَت بِأَكنافِ الجَزيرَةِ مِنهُمو","كَتائِبُ حَلَّت مِن جَهَنَّمَ وادِيا",22,"ي",2,0],["ولاذَ بِمَعْقِلِ الإسلامِ كَعبٌ","فلا رُكنٌ يَميلُ ولا عِمادُ",23,"د",1,0],["ولاذُوا بأكنافِ النبيِّ فصادفوا","كرِيماً يُرجَّى عنده العفوُ والفَضْلُ",24,"ل",1,0],["وَلا ذاهِباً إِنّي أَخافُ نِبالَهُم","يَخالونَهُ مالي وَليسَ بِمالِيا",25,"ا",1,0],["وَلاذَ المَها بِالظِلِّ وَاِستَوفَضَ السَفا","مِنَ الصَيفِ نَتّاجٌ تَخُبُّ مَواكِبُه",26,"ب",2,0],["ولاذَ مِنَ الغزالةِ وهْيَ تُذْكي","بغَرْزِ الراكبِ القَلِقِ الغَزال",27,"ل",1,0],["وَلاَذَ الْمَهَا بالظِلِّ وَاسْتَوْفَضَ السَّفَا","منَ الصَّيْف نَئَاجٌ تَخُبُّ مَوَاكبُهْ",28,"ب",2,0],["ولا ذُعِرْتُ لشرٍّ غيرِ مُنْتَظَرٍ","ولا نزقتُ لخيرٍ غيرِ محسوب",29,"ب",1,0],["ولاذت بك الأفراد في كل وجهةٍ","وأصبح في علياك خائفهم يحمي",30,"م",2,0],["ولا ذاق الزمان لكم فِراقاً","وشمس عُلاك لا رأت الغروبَا",31,"ب",2,0],["ولا ذنب للأيام عندي فإنها","مسالمة لي والصديق أمين",32,"ن",1,0],["وَلا ذَنبَ إِلّا أَنّني بُحتُ بِاسمِهِ","وَلا بُدّ لِلمَحزُونِ أَن يَتَذَكّرا",33,"ر",2,0],["ولا ذنبَ إِن قصرتُ فيما شرحته","فليس الذي يأتي على الجهد مذنبُ",34,"ب",1,0],["ولاذ بالله الهدى وطرفه","تذرى الدموع والضلال يضحك",35,"ك",1,0],["وَلاذَ بِآثارِ الرَسولِ فَحُكمُهُ","لِحُكمِ رَسولِ اللَهِ في الناسِ تابعُ",36,"ع",1,0],["ولا ذَنبَ لي إِلّا حِجىً وَبَراعَةٌ","وَمَجدٌ وَبَيتٌ في رَبيَعَةَ عالِ",37,"ل",1,0],["ولا ذممت ولم أذمم وحسبكها","من خلة حسنت في القول والعمل",38,"ل",1,0],["ولا ذنب عندي لهذا الفقيه","سوى قربه منه إذ حنبله",39,"ل",2,0],["ولا ذكرتُك إلا اعتادَني نَفَسٌ","يبدي الضميرَ ففاض الدَّمعُ مُندَفِقا",40,"ق",2,0],["ولا ذقتم رزا مدى الدهر بعدها","ولا نالكم سوء ولا نالكم مكر",41,"ر",1,0],["ولا ذابلٌ بانَ التفرق والنوى","ولا اخضرَّ دَوْح الوَصْلِ قَطُّ وأوْرَقَا",42,"ق",2,0],["ولاذُوا بعَفْوِك مستأمِنِين","ولم يَجِدوا غيرَه مُلْتَجا",43,"ا",1,0],["ولا ذنب لي إلا الفضيلة انها","من الجهل في الأيام اشنا واشنع",44,"ع",1,0],["ولاذت أساطيلُ الفرنجِ بمخبإٍ","وقد حُطِمَت ألواحُها شرَّ كسرة",45,"ه",1,0],["وَلاذُوا بِأَعْلَى الرَّاسِياتِ تَوَقُّعاً","لِما سَوْفَ يَغْشاهُم وَما حُمَّ واقِعُ",46,"ع",1,0],["وَلا ذُقْتُ أمْناً مِنْ سَرارِ حُجُولِهِ","وَلا ارْتَعْتُ خَوْفاً مِنْ نَمِيمَةِ حَقْبِهِ",47,"ب",2,0],["وَلا ذادَ مَشْهُورٌ مِنَ الْفَضْلِ باهِرٌ","وَلا كَفَّ مَعْرُوفٌ مِنَ الْخَيْرِ أَسْجَحُ",48,"ح",1,0],["وَلا ذَكَروا لَيلى وَلا أُمَّ جُندُبٍ","وَلا تَيَّمَتهُم أُمُّ عَمرٍو وَكَلثَمُ",49,"م",1,0],["وَلا ذنبَ يا غفّارُ يقنط عاصياً","وَذنبكَ يا قهّار يَستوجب النعمى",50,"م",2,0],["وَلاذَت بِه من جورِ جارٍ مكاشحٍ","توجّس يوماً أن تدبّ بِهِ الرقطا",51,"ط",2,0],["وَلاذَتْ سُيُوفٌ بِالغُمُودِ وَقد رَأَتْ","قُلُوبَ رِجَالٍ في الحَدِيدِ تُؤَثِّرُ",52,"ر",1,0],["ولا ذكَرُتكِ مَحْزُونا على سَفَر ٍ","إلا تَقَطّعَ نَوْحُ الريح ِفي رئتي",53,"ت",2,0],["وَلا ذو الكَلاعِ الطالِبونَ بِثَأرِهِم","إِذا أَمكَنَتهُم وَثبَةُ المُتَقاصِرِ",54,"ر",1,0],["ولا ذَنبَ إلاّ للبِعادِ فما لَنا","دَنوْنَا وحَظّي في الدُّنُوِّ قليلُ",55,"ل",1,0],["ولا ذنب لي في القوم إِلا لأنني","جهينة أَسرار وسمهرة الرزق",56,"ق",1,0],["ولا ذنب لي لولا العيون التي رمن","فؤاداً أثارته لمى وخدود",57,"د",1,0],["ولا ذلَّة عاما فعاما تجدُّ لي","على صَعدةٍ من عطفكم ليس تُعْجَمُ",58,"م",1,0],["ولا ذنبَ لي إن أعقمتني عوائقٌ","من الدهر يوماً أن يُقصِّر بي لَقحي",59,"ح",2,0],["ولاذتْ بخداع الصبا عامريَّةٌ","ترومُ اغتراراً من شباب غُلامِ",60,"م",1,0],["ولاذت بفرث المُوديات مع الدجى","من القُرِّ رُعيْانُ الغريب المُردد",61,"د",1,0],["ولا ذنب لي اِنْ فاته شرفُ المُنى","فتلك التي تلْتاثُ منها العقائدُ",62,"د",1,0],["ولا ذنبِ اِلا أنْ تلوتُ ابْن مزْيدٍ","وأصبحَ حبْلي منه وهو رِمامُ",63,"م",1,0],["ولاذت بصيفيِّ الفخارِ فأنْشرتْ","مفاخر أحسابٍ طويلٍ دُثُورُها",64,"ر",3,0],["وَلاذُ البَرقِ قَد نادى عَلَيهِ","مُنادي الرَعدِ في سوقِ الغَمامِ",65,"م",1,0],["ولاذوا بالحُصونِ فما اِستفادوا","نجاةً بالجِدارِ ولا الجِدالِ",66,"ل",1,0],["ولاذت بعطفيها المنيعين دولة","به عاد من بعد المشيب شبابها",67,"ب",3,0],["وَلا ذَكَروا سلعاً وَلا قَصَدوا حِمى","بِهِ لِخِتام المُرسَلين ضَريحُ",68,"ح",1,0],["ولا ذِكرَياتُ الصَّبِّ يلتَاعُ قلبُه","فَتعدِمُه بُعدا وتُوجِدُهُ قُربا",69,"ب",2,0],["ولاذوا خضوعاً بأحجاره","وجرّوا بعَقْوَتهنّ الذُّيولا",70,"ل",2,0],["ولا ذا وصف ذا كلا ولا ذا","لذا وصف لفقدان التكافي",71,"ف",2,0],["ولا ذنب للعود القماري انه","يحرق إِن نمت عليه روائحه",72,"ه",1,1],["ولا ذَنْبَ لي إِلاَّ هَوَاهُ وإِنْ يَكُنْ","فَلاَ تُبْتُ مِنْ ذَنْبي ولا غَفَر الذَّنْبا",73,"ب",2,0],["ولا ذوى ملكَكَ ربٌ قضى","له على الخلق بأَنْ لا زَوَال",74,"ل",1,0],["وَلاَ ذَنْبَ لِي إِلَّا الكَمَالَ عَلَى الصِّبا","فَمَنْ لِي بِعَيْبٍ أَوْ بِشَيْبٍ يردُّهُ",75,"د",2,0],["ولا ذرة أو حبة في سمائه","وفي أرضه عن علمه تتغيب",76,"ب",1,0],["وَلا ذَكَرتَ اِمرِءاً يَوماً بِمَنقَصَةٍ","يا أَبعَدَ الناسِ عَن قيلٍ وَعَن قالِ",77,"ل",1,0],["ولا ذممت البكا عليك ولا","حمدت حسن السلوّ من سالِ",78,"ل",1,0],["ولاذوا بالدُّرُوب فما وَقَتهُم","سِنانَك لا الحصونُ ولا الدروب",79,"ب",1,0],["وَلا ذَنب لي في الحُب يَقضي بِلَوعتي","وَهَجري وَتَعذيبي وَطُول سقامي",80,"م",2,0],["ولا ذنبَ لي إلاّ اشتهاري بحبّها","وكونِيَ مِنْ بين الأنام لها عَبْدَا",81,"د",2,0],["ولا ذنبَ لي إلاّ اشتغالِي بكلّ ما","يُسهِّلُ لي سُبْلَ العُلَى وتَهَمُّمِي",82,"م",2,0],["ولاذت بأم وما هذه الأم","م أثبت قلبا ولا أصلحا",83,"ح",2,0],["وَلا ذَاقَ مِمَّا ذُقْتُه ذو صَبَابةٍ","ولا سَامحَ اللهُ العُيونَ السَّوَاجِيا",84,"ي",2,0],["وَلاَ ذَبُلَ الزَّهْرُ الأنِيقُ لِعِلَّةٍ","وَلَكِن لِكَيْ يَذْكُو شذَاهُ وَمَاؤُهُ",85,"ا",3,0],["ولاذ به البعير فقال آمنا","ودان لأمره بعد النفار",86,"ر",1,0],["ولا ذنب لي فيهِ سوى أنَّني له","سناد إذا ما الأمر أصبح معضلا",87,"ل",2,0],["وَلاذَت بِأعطافي وقَد سالَ دَمعُها","عَلى وردةٍ من خدّها المتورّدِ",88,"د",1,0],["ولا ذاتِ طَوقٍ ما تَمَلُّ هديلَها","رَقوبٍ إذا لم تذرَفِ الدَّمعَ تَندُبِ",89,"ب",1,0],["ولا ذنبَ للأفكارِ أنتَ تَرَكتَها","إذا احتَشدَت لم تُنتَفعَ باحِتشَادِها",90,"د",3,0],["ولا ذكرتُك فى سرٍّ ولا عَلَنٍ","يوماً ولو مُتُّ من وجدٍ ومن شغَفِ",91,"ف",1,0],["ولاذ بالصبر واستحلى مرارته","مسلماً لقضاء اللَه والقدر",92,"ر",1,0],["ولا ذهب العدو لنا بوتر","فأمسينا عليه مغمِّضينا",93,"ن",2,0],["ولا ذرفت عيني لركب يشوقني","غداة النوى فيه خباء وهودج",94,"ج",1,0],["ولا ذبالة فهم جوّه حلك","تحكى ذكاء ذكاء جوّه شمسا",95,"س",2,0],["وَلا ذَنبَ لِلعودِ الذِمارِيِّ إِنَّما","يُحَرَّقُ مَن دَلَّت عَلَيهِ رَوائِحُهْ",96,"ح",2,0],["ولا ذكر وادي الرقمتين يشوقني","ولا بروات الشيح من سحب الرند",97,"د",1,0],["ولا ذنب إلا قد غفرناه عنكم","وما كان من عيب عليكم سترناه",98,"ن",3,0],["ولا ذُقت طعمَ الماءِ إلا وَجَدتُهُ","سوى ذلكَ الماءِ الذي كنتُ أَعرِفُ",99,"ف",1,0],["ولاذَت قُرَيشٌ مِن كلابِ بنِ مُرّةٍ","بِجذلِ حِكاكٍ أو بِعذقٍ مُرَجَّبِ",100,"ب",1,0],["وَلاذوا بِعُبّادِ الصَليبِ تَخَيُّراً","فَما اِنقَلَبوا إِلّا بِسوءِ الخَواتِمِ",101,"م",1,0],["ولأذعنت عدن لبأسك واغتدت","صنعاء أقصى سؤلها أن تُقْدِموا",102,"م",3,0],["ولاذت به من كل شيءٍ يشينها","فكان لها منه السلام المؤبد",103,"د",1,0],["ولاذ بذياك الضريح الذي غدا","به قطب ارباب الولاية ثاويا",104,"ي",2,0],["ولا ذكرتك محزوناً ولا فرحا","إلا وذكرك مقرون بأنفاسي",105,"س",2,0],["وَلا ذَا أخٍ إلا سَيَفجَعُهُ بِهِ","حِمَامُ المَنَايَا حِينَ يَأتِي غَرِيمُهَا",106,"م",3,0],["ولا ذنب له إلا التوافي","لمن في الحب ليست بالوفيه",107,"ي",2,0],["ولأذكرن إذا ذكر","ت أحبتي وقت السحور",108,"ر",1,0],["ولا ذُكِرَ آسمي عندَ مَن كانَ عَالِماً","إذا مُتُّ إلاّ غَرَّقَتهُ المَدَامِع",109,"ع",1,0],["ولا ذات دل مونق في خميلة","ولا فتية تغنى عن الرفع والجمر",110,"ر",1,0],["ولا ذكروا بتاريخ","كعثمان الدمرداش",111,"ش",1,0],["ولا ذنب لي إلا تلثمُ لوعةٍ","أبى الصَّبر أنْ تبدو ودمعي يعيدُها",112,"د",3,0],["ولا ذاقوا لشكوى الحب طعماً","ولا ارتشفوا من الدمع السكوب",113,"ب",1,0],["وَلاذَ بالحرم المَحمي نازله","وَإِن أَلم بِهِ فَقر وَإعسار",114,"ر",1,0],["ولا ذي النون يونس نجلِ متّى","ولا أيوب ذي الصبر القديم",115,"م",1,0],["ولاذت بهم من كلّ أوب ووجهة","وحلّ بهم منهُ العذابُ المنكّرُ",116,"ر",1,0],["ولاذت به أنجالهُ الزّهرُ مثلما","ترى بدر تمّ حُفّ بالأنجم الزُّهر",117,"ر",1,0],["ولا ذكرتُ بلى والكاف ثمّ جلل","إلّا وخابَ لدى تِذكارها الأملُ",118,"ل",1,0],["ولاذ بالجحد لما قاله","فإنما خاف من الصفع",119,"ع",1,0],["ولا ذممت زماني وهو مقتبل","ولا شبابي وهو الروضة الأنف",120,"ف",1,0],["ولا ذَنْبَ إلا أنْ كَتَمْتُ عَلاقَتِي","فَبَاحَتْ بِهِ نُجْلُ الكُلومِ تَكَلُّما",121,"م",2,0],["ولا ذاتُ مُعْجَمَةٍ سَرْدُهَا","كَنَمْنَمَةِ الجَدولِ المُطَّرِدْ",122,"د",1,0],["ولا ذاتُ خالٍ في المناظرِ نجمة","ترشنُ بأَوتارِ القسيِّ ويَنضَحُ",123,"ح",1,0],["ولا ذنب لي إذ صرت أحدوا ركائبي","إلى الورد والدنيا تسيء مصادري",124,"ر",2,0],["ولا ذنب لي عند الزمان علمته","سوى أنني للشعر آخر ناظم",125,"م",1,0],["وَلاذكُرنَّكَ قائِماً أَو قاعِداً","وَلأَشكُرَنَّكَ سائِرَ الأَحيانِ",126,"ن",1,0],["ولا ذنب إلا عفو ربي تمده","شفاعة خير المرسلين محمد",127,"د",1,0],["وَلا ذل من شاد المهيمنُ عزَّه","بِتَوفيق مَولانا الجَليل العَوائد",128,"د",1,0],["وَلا ذَنب لي إِلا اعتزازٌ وَهمة","تَحدّثَ عَنها الفاتكان الصَوارم",129,"م",1,0],["ولا ذنب لي فيما إخال وليس في","معاملتي إياه من ريبة أصلا",130,"ل",2,0],["وَلا ذا رِياءٍ يُنصُبُ الدينَ مَجمَعاً","لِيَأكُلَ لَحمَ الأَتقِياءِ عَلى الشَبَعِ",131,"ع",1,0],["ولاذت بعالم قدس سما","ففاق الأواخر بل والأول",132,"ل",1,0],["وَلا ذَنب لِلوَلهان في لَوعَة الجَوى","اِذا أَبصَرَت قَلبا خَليا مِنَ الهَوى",133,"ه",3,0],["ولا ذنب عندي غير أني عاملٌ","ولا فيّ عيبٌ غير أني عالمٌ",134,"م",1,0],["ولا ذاتِ طَوْقٍ من حمائِم أَيْكَةٍ","بنَعْمان تسجو في الضُحَى والغَياهِب",135,"ب",1,0],["ولاذن قبل العين تعشق حسبما","منها طريق للقلوب مبين",136,"ن",1,0],["ولا ذكاءٌ إلى قصدي يُبلغني","لو كنت أذكى الورى أوفقت أخبارا",137,"ر",2,0],["ولا ذاك عن ذلٍّ ولا عن مخافةٍ","على الدينِ والدنيا لإنجازِ موعدِ",138,"د",1,0],["وَلا ذاقَ طَعمَ الوَصلِ إِلّا هنيهةً","بوردِ حمى المَحبوب إِذ طابَ ذا الوردُ",139,"د",1,0],["وَلا ذَكَرتُك إِلَّا بِتُّ مُرتَفِقاً","صَبّاً حَزيناً كَأَنَّ المَوتَ مُعتَنِقي",140,"ي",1,0],["ولا ذنب لي في أرض قومي وغيرها","سوى البحث في علم الفوائد والنشر",141,"ر",1,0],["ولا ذنب له والذنب جم","ولا عيب وإن كثرت عيوب",142,"ب",1,0],["ولا ذمَّنا في النازلين نزيل","لسان لنا بين الملا ولنا يد",143,"د",1,0],["ولا ذكر في الأفواه حاشاك انما","صفاتك آياتٌ ولعنا بها درسا",144,"س",2,0],["ولا ذنب ياقومُ أصلاً عليه","ولكنه هكذا يولدُ",145,"د",1,0],["ولاذَ مِن بَعدُ ب(العَبَّاسِ) لا وَقَعَت","على نَمِيرٍ يَدَاهُ, أو رَأَى رُطَبَا",146,"ب",2,0],["وَلاْذَ الْمُخْلِصُوْنَ إِلَىْ سِلاْحٍ","وَلاْذَ الْخَاْئِنُوْنَ إِلَى الْحِوَاْرِ",147,"ر",1,0],["وَلاْذَ كَكَلْبَةٍ بِبَنِيْ كِلاْبٍ","كَمَاْ لاْذَ الْمُشَعْوِذُ بِالسَّعَاْلِيْ",148,"ل",2,0],["ولاذت بك التقوى وعاذت بك العلا","ودانت لك الدنيا وعزبك السرح",149,"ح",1,0],["ولاذو الحقا يكفى بكثر حقائه","وغاية ذي الدنيا صناً وصناء",150,"ا",2,0],["ولا ذَرفت عينايَ في الحب دمعةً","ولا كٌنتَ يوماً للمُحبينَ هاويا",151,"ي",2,0],["ولا ذنب لي إن قَد وهبتَ مليكتي","حياتي فذاكَ الجزءُ بعض وفائيا",151,"ي",2,0],["وَلَا ذَرَّةٌ مِن مُنتَهَى العَرْشِ نَازِلًا","إِلَى الفَرشِ إِلَّا فِعْلُهُ القُلُّ والجُلُّ",152,"ل",1,0],["ولا ذكروا حاشاهمو أن قولهم","دليل ولا كالنص قد كان محكما",153,"م",2,0],["ولا ذنب لي عند الغبي يرومه","سوى البغي أو إرضاء فدم يخالله",154,"ل",2,0],["ولا ذرفتْ عينٌ وناحتْ حمامة ٌ","ولا طأئرٌ إلاّ أرادَ التلاقيا",155,"ي",2,0],["ولاذت أمنيات الورد حزنا ً","تأودَ غصنها سجدَ الضياء",156,"ا",2,0],["ولاذخر عندي في القيامة غيركم","وكل رجائي أن يخلصني الذخر",157,"ر",1,0],["وَلَا ذِكْرَيَاتٍ إِنْ تَهَادَتْ طُيُوفُهَا","سَتَدْعُو حَنِينًا يَسْتَغِيثُ الْخَوَالِيَا",158,"ي",2,0],["ولأذكرنَّ على النوى فيها امرءاً","غمرَ النوالِ متى استُمِيحَ أجادا",159,"د",2,0],["وَ لا ذُقنا المَرارَةَ فِي خِيامٍ","يُقَطِّرُها الهَوانُ مِنَ الثُّقُوبِ !",160,"ب",1,0],["وَلا ذَهاب ما هوَ من البَلا","رزق الفَتى مَقسوم يشدا خيالها",161,"ل",3,0]]}