{"poems":[[53,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[55,"غضبت لأن جاد الرقاد بنظرة","https://www.aldiwan.net/poem26111.html","الطويل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[42,"تعاتبني عرسي على أن أطيعها","https://www.aldiwan.net/poem50365.html","الطويل"],[73,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[54,"أتيت ابن عمرو فصادفته","https://www.aldiwan.net/poem27410.html","المتقارب"],[47,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[72,"نفرت عن الظبي الذي كان ينفر","https://www.aldiwan.net/poem18710.html","الطويل"],[64,"والله ما طلعت شمس ولا غربت","https://www.aldiwan.net/poem67558.html","البسيط"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[91,"لمن يضوع العبير لمن تغني الطيور","https://www.aldiwan.net/poem8821.html","عموديه"],[85,"ألا في سبيل الله ذاك الدم الغالي","https://www.aldiwan.net/poem62834.html","الطويل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[56,"دعانا أبو عمرو عمير بن جعفر","https://www.aldiwan.net/poem58604.html","الطويل"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[28,"صل يا جنيد الخير لله صولة","https://www.aldiwan.net/poem5582.html","الطويل"],[61,"أعاد الحيا سكر النبات وقد صحا","https://www.aldiwan.net/poem51735.html","الطويل"],[44,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[31,"لو كان يخفى الحب يوما خفى لنا","https://www.aldiwan.net/poem42227.html","الطويل"],[74,"وصهوة عزم قد تمطيت والدجى","https://www.aldiwan.net/poem12922.html","الطويل"],[105,"يقولون لي ماذا قرأت لعلهم","https://www.aldiwan.net/poem43113.html","الطويل"],[105,"بجير كيف يخطئك السداد","https://www.aldiwan.net/poem44041.html","الوافر"],[105,"محيصة بلغ ما أمرت فإنما","https://www.aldiwan.net/poem44056.html","الطويل"],[21,"ثم لوط أخو سدوم أتاها","https://www.aldiwan.net/poem36138.html","الخفيف"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[50,"جفا ودهُ فازور أو مل صاحبهُ","https://www.poetsgate.com/ViewPoem.aspx?id=17924",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[116,"كشفت حجاب الطمس عن حيطة الأسما","https://www.aldiwan.net/poem41777.html","الطويل"],[129,"أيا سوقا فلو صورت شخصا","https://www.aldiwan.net/poem50670.html","الوافر"],[136,"وكم من أخ يشكو وفاء صديقه","https://www.aldiwan.net/poem49011.html","الطويل"],[137,"عدمت لذيذ العيش بعدك والكرى","https://www.aldiwan.net/poem2689.html","الطويل"],[161,"أعندك علم أم أقول فأطرب","https://www.aldiwan.net/poem58761.html","الطويل"],[161,"الدين دين ربنا والملك","https://www.aldiwan.net/poem59186.html","الرجز"],[165,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[170,"أفي كل يوم للخطوب أصالي","https://www.aldiwan.net/poem1650.html",""],[187,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[187,"إذا ابن جميل مشى خلتنا","https://www.aldiwan.net/poem43437.html","المتقارب"],[205,"يا أفتن الناس ألحاظا إذا رمقا","https://www.aldiwan.net/poem53221.html","البسيط"],[211,"كفاني حزنا أن أضر بي الهجر","https://www.aldiwan.net/poem13494.html","الطويل"],[213,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[230,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[262,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[271,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[276,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[281,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[281,"أحتى إلى العلياء يا خطب تطمح","https://www.aldiwan.net/poem60783.html","الطويل"],[283,"بقلبي حوري الجنان المنعم","https://www.aldiwan.net/poem32629.html","الطويل"],[306,"بذاتك يا الله بغيهبك الأسمى","https://www.aldiwan.net/poem56406.html","الطويل"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[349,"سروا وكأن الليل من بطء سيره","https://www.aldiwan.net/poem20227.html","الطويل"],[377,"حبيبتي دبي","https://www.aldiwan.net/poem965.html","عموديه"],[388,"لا تتركنكُم ذور عين وسكسكٌ","https://www.aldiwan.net/poem549.html",""],[410,"أبا حسن قد ران بعد بعادكم","https://www.aldiwan.net/poem32256.html","الطويل"],[442,"عتاب أحال الشهد كالصاب في الحلق","https://www.aldiwan.net/poem14428.html","الطويل"],[450,"صباحك عيد مشرف","https://www.aldiwan.net/poem974.html",""],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[462,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[462,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[462,"علي المقال الجزل جم ثناؤه","https://www.aldiwan.net/poem15474.html","الطويل"],[462,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[462,"تأرج عرض الدهر من نشر منطقي","https://www.aldiwan.net/poem16146.html","الطويل"],[469,"روابي القاش مذهبة الخيام","https://www.aldiwan.net/poem59656.html","الوافر"],[515,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[516,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[525,"عبير الثنا في الخافقين يفوح","https://www.aldiwan.net/poem13284.html","الطويل"],[539,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[552,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[559,"صفا ماء الحقيقة فهو صافي","https://www.aldiwan.net/poem34351.html","الوافر"],[570,"ولا ذنب للعود القماري انه","https://www.aldiwan.net/poem52033.html","الطويل"],[576,"أبى القلب إلا أن يبيت به صباً","https://www.aldiwan.net/poem2993.html","الطويل"],[576,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"],[587,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[588,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَلا ذاكِراً ما كانَ بَيني وَبَينَكُم","مُراجَعَةً إِنَّ المُحِبَّ المُراجِعُ",0,"ع",1,0],["وَلا ذَنبَ لي لَو كُنتُ أَعلَمُ لَم أَنَم","وَلَكِنَّني فيما بَقي سَوفَ أَعلَمُ",1,"م",1,0],["ولاذوا الى السِّلْمِ اسْتِلاماً ورَهْبَةً","وقد شارَفوا وِرْدَ المنيّةِ أو كادُوا",2,"د",3,0],["وَلا ذَنبَ لي قَد قُلتُ في بَدءِ أَمرِنا","وَلَو عَلِمَت ما عُلِّمَت ما تَعَيِّتِ",3,"ت",1,0],["وَلاذَ بِهِ الدينُ مُستَعصِماً","بِذِمَّةِ أَبلَجَ وافي الذِمَم",4,"م",1,0],["وَلا ذَنبَ لِلنارِ في سَفعِهِ","إِذا هُوَ أَصبَحَ مِحراثَها",5,"ث",3,0],["وَلا ذَنبَ لي إِنَّ الفُؤادَ لَصارِمٌ","وَإِنَّ الحُسامَ المَشرَفِيِّ لَفاصِلُ",6,"ل",1,0],["ولا ذنبَ لي عند الزمان كما ترى","سوى كلمٍ كالروض تبهى وتبهر",7,"ر",1,0],["وَلا ذَكَرتُكَ مَحزوناً وَلا فَرِحاً","إِلّا وَأَنت بِقَلبي بَينَ وِسواسي",8,"س",2,0],["ولأذيالها على","قدميها تلفُّف",9,"ف",1,0],["ولا ذنبَ للمظلومِ إن باتَ مُرصِداً","لسوءِ فعالٍ منكَ سوءَ مقالِ",10,"ل",1,0],["وَلاذَ قَلبي بِصَدري","كَأَنَهُ عُصفورُ",11,"ر",1,0],["وَلاذَ بِقُضبانِ الحَديدِ شَهيدُهُ","فَعادَت رَفيفاً مِن عُيونٍ وَأَطلالِ",12,"ل",1,0],["وَلا ذَرَفتِ الدَمعَ يَوماً وَإِن","أَسرَفتِ في الدَمعِ وَفي سَكبِهِ",13,"ب",2,0],["ولا ذَنْبَ للأَضْيافِ إِنْ نالَكَ الرَّدَى","فإنَّ المنايا للدُّيُوكِ بِمَرْصَدِ",14,"د",1,0],["وَلا ذَكَرتُ جَميلاً مِن صَنائِعِها","إِلّا بَكَيتُ وَلا وُدٌّ بِلا سَبَبِ",15,"ب",1,0],["ولاذُوا بأكراد البوادي وعُرْبهم","ومن كلِّ جيلٍ أمةٌ وقبيلُ",16,"ل",1,0],["وَلا ذُكِرَت عِندَ المُلوكِ قَماقِمٌ","بِفَضلِ نَدىً إِلّا الجُنَيدُ هُمامُها",17,"م",3,0],["ولاذَ نسيمُ الرَّوْضِ من طولِ سَيرِه","حسيراً بأطرافِ الغصونِ مُطلَّحا",18,"ح",2,0],["وَلاذَت بِحُقوَيهِ الخِلافَةُ وَاِلتَقَت","عَلى خِدرِها أَرماحُهُ وَمَناصِلُه",19,"ل",2,0],["وَلا ذُكِرَت يا صاحِ إِلّا وَجَدتُها","بِوُدّي وَإِلّا زادَ حُبّي لَها ضِعفا",20,"ف",2,0],["وَلاذَ بِهِ نَسرُ السَماءِ كَأَنَّما","يَحِنُّ إِلى وَكرٍ بِهِ ذَلِكَ النَسرُ",21,"ر",1,0],["وَلاذَت بِأَكنافِ الجَزيرَةِ مِنهُمو","كَتائِبُ حَلَّت مِن جَهَنَّمَ وادِيا",22,"ي",2,0],["ولاذَ بِمَعْقِلِ الإسلامِ كَعبٌ","فلا رُكنٌ يَميلُ ولا عِمادُ",23,"د",1,0],["ولاذُوا بأكنافِ النبيِّ فصادفوا","كرِيماً يُرجَّى عنده العفوُ والفَضْلُ",24,"ل",1,0],["وَلا ذاهِباً إِنّي أَخافُ نِبالَهُم","يَخالونَهُ مالي وَليسَ بِمالِيا",25,"ا",1,0],["وَلاذَ المَها بِالظِلِّ وَاِستَوفَضَ السَفا","مِنَ الصَيفِ نَتّاجٌ تَخُبُّ مَواكِبُه",26,"ب",2,0],["ولاذَ مِنَ الغزالةِ وهْيَ تُذْكي","بغَرْزِ الراكبِ القَلِقِ الغَزال",27,"ل",1,0],["وَلاَذَ الْمَهَا بالظِلِّ وَاسْتَوْفَضَ السَّفَا","منَ الصَّيْف نَئَاجٌ تَخُبُّ مَوَاكبُهْ",28,"ب",2,0],["ولا ذُعِرْتُ لشرٍّ غيرِ مُنْتَظَرٍ","ولا نزقتُ لخيرٍ غيرِ محسوب",29,"ب",1,0],["ولاذت بك الأفراد في كل وجهةٍ","وأصبح في علياك خائفهم يحمي",30,"م",2,0],["ولا ذاق الزمان لكم فِراقاً","وشمس عُلاك لا رأت الغروبَا",31,"ب",2,0],["ولا ذنب للأيام عندي فإنها","مسالمة لي والصديق أمين",32,"ن",1,0],["وَلا ذَنبَ إِلّا أَنّني بُحتُ بِاسمِهِ","وَلا بُدّ لِلمَحزُونِ أَن يَتَذَكّرا",33,"ر",2,0],["ولا ذنبَ إِن قصرتُ فيما شرحته","فليس الذي يأتي على الجهد مذنبُ",34,"ب",1,0],["ولاذ بالله الهدى وطرفه","تذرى الدموع والضلال يضحك",35,"ك",1,0],["وَلاذَ بِآثارِ الرَسولِ فَحُكمُهُ","لِحُكمِ رَسولِ اللَهِ في الناسِ تابعُ",36,"ع",1,0],["ولا ذَنبَ لي إِلّا حِجىً وَبَراعَةٌ","وَمَجدٌ وَبَيتٌ في رَبيَعَةَ عالِ",37,"ل",1,0],["ولا ذممت ولم أذمم وحسبكها","من خلة حسنت في القول والعمل",38,"ل",1,0],["ولا ذنب عندي لهذا الفقيه","سوى قربه منه إذ حنبله",39,"ل",2,0],["ولا ذكرتُك إلا اعتادَني نَفَسٌ","يبدي الضميرَ ففاض الدَّمعُ مُندَفِقا",40,"ق",2,0],["ولا ذقتم رزا مدى الدهر بعدها","ولا نالكم سوء ولا نالكم مكر",41,"ر",1,0],["ولا ذابلٌ بانَ التفرق والنوى","ولا اخضرَّ دَوْح الوَصْلِ قَطُّ وأوْرَقَا",42,"ق",2,0],["ولاذُوا بعَفْوِك مستأمِنِين","ولم يَجِدوا غيرَه مُلْتَجا",43,"ا",1,0],["ولا ذنب لي إلا الفضيلة انها","من الجهل في الأيام اشنا واشنع",44,"ع",1,0],["ولاذت أساطيلُ الفرنجِ بمخبإٍ","وقد حُطِمَت ألواحُها شرَّ كسرة",45,"ه",1,0],["وَلاذُوا بِأَعْلَى الرَّاسِياتِ تَوَقُّعاً","لِما سَوْفَ يَغْشاهُم وَما حُمَّ واقِعُ",46,"ع",1,0],["وَلا ذُقْتُ أمْناً مِنْ سَرارِ حُجُولِهِ","وَلا ارْتَعْتُ خَوْفاً مِنْ نَمِيمَةِ حَقْبِهِ",47,"ب",2,0],["وَلا ذادَ مَشْهُورٌ مِنَ الْفَضْلِ باهِرٌ","وَلا كَفَّ مَعْرُوفٌ مِنَ الْخَيْرِ أَسْجَحُ",48,"ح",1,0],["وَلا ذَكَروا لَيلى وَلا أُمَّ جُندُبٍ","وَلا تَيَّمَتهُم أُمُّ عَمرٍو وَكَلثَمُ",49,"م",1,0],["وَلا ذنبَ يا غفّارُ يقنط عاصياً","وَذنبكَ يا قهّار يَستوجب النعمى",50,"م",2,0],["وَلاذَت بِه من جورِ جارٍ مكاشحٍ","توجّس يوماً أن تدبّ بِهِ الرقطا",51,"ط",2,0],["وَلاذَتْ سُيُوفٌ بِالغُمُودِ وَقد رَأَتْ","قُلُوبَ رِجَالٍ في الحَدِيدِ تُؤَثِّرُ",52,"ر",1,0],["ولا ذكَرُتكِ مَحْزُونا على سَفَر ٍ","إلا تَقَطّعَ نَوْحُ الريح ِفي رئتي",53,"ت",2,0],["وَلا ذو الكَلاعِ الطالِبونَ بِثَأرِهِم","إِذا أَمكَنَتهُم وَثبَةُ المُتَقاصِرِ",54,"ر",1,0],["ولا ذَنبَ إلاّ للبِعادِ فما لَنا","دَنوْنَا وحَظّي في الدُّنُوِّ قليلُ",55,"ل",1,0],["ولا ذنب لي في القوم إِلا لأنني","جهينة أَسرار وسمهرة الرزق",56,"ق",1,0],["ولا ذنب لي لولا العيون التي رمن","فؤاداً أثارته لمى وخدود",57,"د",1,0],["ولا ذلَّة عاما فعاما تجدُّ لي","على صَعدةٍ من عطفكم ليس تُعْجَمُ",58,"م",1,0],["ولا ذنبَ لي إن أعقمتني عوائقٌ","من الدهر يوماً أن يُقصِّر بي لَقحي",59,"ح",2,0],["ولاذتْ بخداع الصبا عامريَّةٌ","ترومُ اغتراراً من شباب غُلامِ",60,"م",1,0],["ولاذت بفرث المُوديات مع الدجى","من القُرِّ رُعيْانُ الغريب المُردد",61,"د",1,0],["ولا ذنب لي اِنْ فاته شرفُ المُنى","فتلك التي تلْتاثُ منها العقائدُ",62,"د",1,0],["ولا ذنبِ اِلا أنْ تلوتُ ابْن مزْيدٍ","وأصبحَ حبْلي منه وهو رِمامُ",63,"م",1,0],["ولاذت بصيفيِّ الفخارِ فأنْشرتْ","مفاخر أحسابٍ طويلٍ دُثُورُها",64,"ر",3,0],["وَلاذُ البَرقِ قَد نادى عَلَيهِ","مُنادي الرَعدِ في سوقِ الغَمامِ",65,"م",1,0],["ولاذوا بالحُصونِ فما اِستفادوا","نجاةً بالجِدارِ ولا الجِدالِ",66,"ل",1,0],["ولاذت بعطفيها المنيعين دولة","به عاد من بعد المشيب شبابها",67,"ب",3,0],["وَلا ذَكَروا سلعاً وَلا قَصَدوا حِمى","بِهِ لِخِتام المُرسَلين ضَريحُ",68,"ح",1,0],["ولا ذِكرَياتُ الصَّبِّ يلتَاعُ قلبُه","فَتعدِمُه بُعدا وتُوجِدُهُ قُربا",69,"ب",2,0],["ولاذوا خضوعاً بأحجاره","وجرّوا بعَقْوَتهنّ الذُّيولا",70,"ل",2,0],["ولا ذا وصف ذا كلا ولا ذا","لذا وصف لفقدان التكافي",71,"ف",2,0],["ولا ذنب للعود القماري انه","يحرق إِن نمت عليه روائحه",72,"ه",1,1],["ولا ذَنْبَ لي إِلاَّ هَوَاهُ وإِنْ يَكُنْ","فَلاَ تُبْتُ مِنْ ذَنْبي ولا غَفَر الذَّنْبا",73,"ب",2,0],["ولا ذوى ملكَكَ ربٌ قضى","له على الخلق بأَنْ لا زَوَال",74,"ل",1,0],["وَلاَ ذَنْبَ لِي إِلَّا الكَمَالَ عَلَى الصِّبا","فَمَنْ لِي بِعَيْبٍ أَوْ بِشَيْبٍ يردُّهُ",75,"د",2,0],["ولا ذرة أو حبة في سمائه","وفي أرضه عن علمه تتغيب",76,"ب",1,0]]}