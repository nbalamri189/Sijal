],[4691,"هيفاء يا حبي الذي اشتدا","https://www.poetsgate.com/ViewPoem.aspx?id=61729",""],[4691,"بث لأآمال رقايق","https://www.poetsgate.com/ViewPoem.aspx?id=84365",""],[4691,"أميرة الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=155935",""],[4767,"قل للرجال","https://www.poetsgate.com/ViewPoem.aspx?id=175120",""],[4816,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=8484",""],[4852,"خِضر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215938",""],[4929,"الموت القادم من الصين","https://www.poetsgate.com/ViewPoem.aspx?id=211016",""],[3591,"أحبُّ دياراً لا أزور لها مغنى","https://www.poetsgate.com/ViewPoem.aspx?id=149411",""],[5135,"ما بال طرفي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201788",""],[5168,"عسنك بالجبيره","https://www.poetsgate.com/ViewPoem.aspx?id=33603",""],[5285,"الكلُّ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=203143",""],[5285,"زهر الشجون","https://www.poetsgate.com/ViewPoem.aspx?id=203539",""],[5320,"اللقيط","https://www.poetsgate.com/ViewPoem.aspx?id=43106",""],[5431,"فلا تسأل سؤالك ليس يجدي!...","https://www.poetsgate.com/ViewPoem.aspx?id=191234",""],[5507,"إلى كم تقول ولا تفعل","https://www.poetsgate.com/ViewPoem.aspx?id=186889",""],[5582,"أَضَرَّ بِكَ الوَجْدُ لَمَّا تَمادَى","https://www.poetsgate.com/ViewPoem.aspx?id=63488",""],[5859,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=29415",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[5956,"إني ذكرتُكِ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182408",""],[5956,"حَيرَة","https://www.poetsgate.com/ViewPoem.aspx?id=183286",""],[5956,"مغناطيس الاستعطاف","https://www.poetsgate.com/ViewPoem.aspx?id=192106",""],[5956,"هدية من والدي","https://www.poetsgate.com/ViewPoem.aspx?id=192729",""],[5956,"تنقلكم شوّش استقراري","https://www.poetsgate.com/ViewPoem.aspx?id=193157",""],[5956,"أسرة محزونة","https://www.poetsgate.com/ViewPoem.aspx?id=194720",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""]],"verses":[["أَأُمَيمَ إِنَّ أَخاكِ غَضَّ جِماحَهُ","بَيضٌ طَرَدنَ عَنِ الذَوائِبِ سودا",0,"د",2,1],["أَأُمَّ أَبانٍ إِنَّ حُبَّكِ تارِكي","وَحيداً فَما لي بِالمَلامِ يَدانِ",1,"ن",1,0],["أَأُمَيْمَ إِنْ خَفِيَتْ عَلَيْكِ صَبابَتِي","فَسَلِي ظَلامَ اللَّيلِ كيفَ أَكُونُ",2,"ن",1,0],["اَأُمَيْمَ إِنْ لَمْ تَسْمَحي بِزيارَةٍ","بُخْلاً فَجُودي بِالخيالِ الطَّارِقِ",3,"ق",1,1],["أَأُمَيْمَ كُفّي مِنْ دُموعِكِ وانْظُري","خَبَبي إِلى أمَدِ العُلا ووَجِيفي",4,"ف",2,0],["أَأُمَيْمَ إنْ أشْبَهْتِهِ في خُلفِهِ","فالخُلْفُ يَقبُحُ وهْوَ منكِ جَميلُ",5,"ل",1,0],["أأُمَيمَ كيفَ طوَيتِ أروِقَةَ الدُجى","في كلِّ أغْبَرَ قاتِمِ الأرجاءِ",6,"ا",2,0],["أأملك أن أخالفهم","ورأيهم هو العالي",7,"ل",2,0],["أ أميراً والآمرون سواه","لم يكن عندهم سوى مأمور",8,"ر",1,0],["أ أمين جئت إلى العراق لكي ترى","ما فيه من غُرَر العلا وحُجوله",9,"ل",2,0],["أ أمين لا تغضب عليّ فإنني","لا أدّعي شيئاً بغير دليله",9,"ل",2,0],["أأمنع عيني أن تجود بدمعها","على وطني إني إذن لبخيل",10,"ل",1,0],["أَأُمامُ غَيَّرَني وَأَنتِ غَريرَةٌ","حاجاتُ ذي أَرَبٍ وَهَمٌّ كَالجَوى",11,"ا",1,0],["أأمستِ الحيتانُ في ذمّةٍ","أم أصبحتْ من يَمِّها هُرَّبا",12,"ب",2,0],["أَأُمِيتُ ذِكْرَى مَنْ حَيِيتُ بفضله","وَرَعَيْتُ بعد الجدْبِ مَرْجاً أَفْيَحا",13,"ح",2,0],["أأمْرحُ فوق الأرض يا أمُّ والثرى","عليكِ مهيلٌ قد تطابقَ وارتكمْ",14,"م",1,0],["أَأَمانِيَّ كُلَّها مِن تُرابٍ","وَأَمانيكَ كُلَّها مِن عَسجَد",15,"د",1,0],["أَأَميرٌ تَتَّقيهِ دَولَةٌ","يَتَوَقّى كاشِحاً مُختَلَقا",16,"ق",2,0],["أَأَمنَعُ ماءَ ما يَروي أَخا صَدىً","وَقَد كُنتُ لا أَحمي المَناهِلَ صادِيا",17,"ي",2,0],["أَأُمَّ المالِكينَ بَني أَمونٍ","لِيَهنِكِ أَنَّهُم نَزَعوا أَمونا",18,"ن",2,0],["أآمِدُ هَل ألَمَّ بكِ النهارُ","قَديماً أو أُثيرَ بكِ الغُبارُ",19,"ر",1,1],["أَأَمدَحُ عُمّالَ الطَساسيجِ راغِباً","إِلَيهِم وَلي بِالشامِ مُستَمتَعٌ رَغبُ",20,"ب",1,0],["أَأُمنَعُ في هِجرانِهِ مِن صَبابَةٍ","وَقَد كُنتُ صَبّاً مُغرَماً في وِصالِهِ",21,"ل",2,0],["أَأَمِنتَ المَوتَ وَالمَوتُ يَأبى","بِكَ وَالأَيّامُ إِلّا انقِلابا",22,"ب",2,0],["أأموت ظمآناً وثغرك جدولي","وأبيت أشرب لهفتي وولوعي",23,"ي",1,0],["أَأمينُ أَعطيتَ القضيّةَ حَقَّها","وحكمتَ فيها حُكمَكَ المقبولا",24,"ل",2,0],["أَأَموتُ أَو يَبقى الحُسامُ مُضاجِعي","وَالحَربُ عاصِفَةُ الرَدى لَم تَركُدِ",25,"د",1,0],["أَأُمُّ فَقيهاً لَيسَ رَأيِي بِفِقهِهِ","وَلَكِن لَرُبَّ المُردِ مُجتَمِعُ الشَملِ",26,"ل",1,0],["أَأُمَّ تَميمٍ إِنْ تَرَيْني عَدُوَّكُمْ","وَبَيْتِي فَقَدْ أَغْنَى الحَبيبَ المُصَافِيا",27,"ي",2,0],["أأمنع الشفة الدنيا ، ولو طمحت","نفسي إلى شفة الفردوس ما انحجبا",28,"ب",2,0],["أَأَمزُجُ بِاللِئامِ دَمي وَلَحمي","فَما عُذري عَلى النَسَبِ الكَريمِ",29,"م",1,0],["أأمَّ القُدْسِ والتأريخُ دامٍ","ويومُكِ مثلُ أمسِكِ في الكفاح",30,"ح",1,0],["أأمين أن سُرَّ العراقُ فبعدما","أبكى ربوعَ كولمبس َ الهجران",31,"ن",1,0],["أأمريك يابنت \" كولمبس \"","لحبِّك وقع على الأنفس",32,"س",1,1],["أأمير تتقيه دولة","يتوقى كاشحا مختلفا؟",33,"ف",2,0],["أَأَمدَحُ مَن أُرَجِّمُ فيهِ ظَنّي","وَأَترُكُ مَن بِأَنعُمِهِ اِبتَداني",34,"ن",2,0],["أَأُمَيمُ هَل أُخبِرتِ مَتبولاً بَكَى","مِمَّا تَضَمَّنَ مِن هَوىً لِلتّابِلِ",35,"ل",1,0],["أَأُمَّكَ كانَت أَخبَرَتكَ بِطولِهِ","أَم أَنتَ اِمرِؤٌ لَم تَدرِ كَيفَ تَقولُ",36,"ل",1,1],["أأمسُّه بنقيصةٍ لِم ذا ولو","مُلِّكتُ عمري زدتُه في عُمرِهِ",37,"ر",2,0],["أآمرِتي بالصبر وهي تَحُدّه","وعاذلتي في السُّقم وهي له جندُ",38,"د",1,0],["أَأَمْوَاتٌ كَأَحْيَاءٍ","وَأَحْيَاءٌ كَأَمْوَاتِ",39,"ت",1,0],["أ َأُمْنَعُ مِنْ وَرْدٍ تَبَدَّى بِنَاظِرِي","وَعَهْدِي بِأَنَّ الْوَرْدَ يَجْنِيهِ مَنْ بَذَرْ",40,"ر",1,0],["أَأُمسي في جِوار الغَثيِ عَطشى","وَقَد رَوى البلادَ نَدى نديّه",41,"ه",1,1],["أَأَمدَحُ التُركَ أَبغي الفَضلَ عِندَهُمُ","وَالشِعرُ ما زالَ عند التُرك مَتروكا",42,"ك",2,0],["أَأُمّاهُ حيّاكِ الرّبيعُ نضيرا","مُحيّاكِ في قَلبي يَلوحُ مُنيرا",43,"ر",2,1],["أُأُمّاهُ لا تبكي على فَرخِكِ الذي","نأى فغدا مِنهُ الجناحُ كسيرا",43,"ر",2,0],["أَأُمنَعُ طَلَّ الخَيرِ مَعَ أَدَبي بِهِ","وَيُمنَحُ مِنهُ أَبلَهُ القَومِ وَبلَهُ",44,"ل",2,0],["أَامرِي بِهِ طَرفِي مَحَلٌ مَدامِعِي","وَلا غَروَ أَن تَمرِي الغَمَامَ بُرُوقُ",45,"ق",1,0],["أَإمامَ أُمّةِ أحمدٍ وإمامُها","في الحَشْرِ يَشْفَعُ للورَى ويُواسي",46,"س",2,0],["أَآمُلُ نُصحاً مِنهُمُ في اِنفِراجِها","وَلَم أَرَ نُصحاً مِنهُمُ في اِستِماعِها",47,"ه",2,0],["أآمِرَتي بصَبرٍ إنَّ صَبراً","أمَرتِ به يعوِّضُ ما نَهاهُ",48,"ا",2,0],["أَأَمِّلُ مِنْهُمْ بالغِنَى كَشْفَ كُرْبةٍ","وقد أَنْشَبَ الحرمانُ فيهم أظافرا",49,"ر",2,0],["أَأَمَتَّهُ بِالهجرِ قَبلَ مَماتِهِ","فاعِده في الأَسعافِ قَبلَ مَعادِهِ",50,"د",2,0],["أَأُميمُ ما لي كلّ آنٍ مرَّ بي","وهواك تستهوي ليَ الأَفكار",51,"ر",1,0],["أأم أدر أعمالي ففي اللوح سطرت","إلى جنةٍ أم حظها النحس جاحم",52,"م",1,0],["أَأُمُّ عَبيدَةٍ أَقلَقْتِ رَكبي","وقَلْقَلْتِ العِواجَ إلى حِمَاكِ",53,"ك",1,1],["أأمنع من وادي زبالة شربةٍ","وقد نهلت منه الكلاب وعلت",54,"ت",1,0],["أَأُماري في عِلمِه أُماري","وله يَشهَدُ الإِمامُ البُخاري",55,"ر",2,1],["أَأمنَعُ نِضوي أَن يَحِنَّ وَقَد بَدَت","جِبالُ النَّقا مِن عالجٍ وَرِمالِهِ",56,"ل",2,0],["أَامَرَتي بالصَّبر قد كنتُ ألتَجي","إلى سَلوَةٍ لَو أن قلبَكِ لي قلبُ",57,"ب",1,0],["أَأَمدحُ غيرَكَ لا والعظيم","ولا آكلُ الصايَ بعد الرُّطَب",58,"ب",1,0],["أأمُّ المعزبي أم ابتعادٌ","عن الوطنِ القريبِ أمِ اقترابُ",59,"ب",1,0],["أآمن أنْ يَغْتدي ذو اليسار","منهمْ وقد جاز حدَّ الفقير",60,"ر",1,0],["أآمن عربدةً أن تدورَ","بين كبيرهُم والصغير",60,"ر",1,0],["أأمنت مكر الله أم لم تؤمني","بالبعث للعرض المهول المذهل",61,"ل",1,0],["أأمِّل راحة في حبّ سعدى","وَذلكمُ محالٌ في محالِ",62,"ل",1,0],["أَأمنحه هنداً أم فرتنا","وَأَسما وعاتكة أَو سُعادا",63,"د",2,0],["أَأمّة أَحمدٍ لقدِ اِستقامت","طَريقتكم وَلاح لَها اِتّضاحُ",64,"ح",1,0],["أأمسى في مشاكل مبهمات","وأرجع ويك عن سنن السناء",65,"ا",2,0],["أَأَمتاحُ مِن بِئرٍ قَليلِ مَعينِها","وَأَقعُدُ عَن بَحرِ زَلالٍ مَشارِبُه",66,"ه",1,1],["أآملُ كِتمانَ الهوى وهو واضحُ","ودمعيَ يومَ البَيْنِ بالسِّرِّ بائحُ",67,"ح",1,1],["أأمَّ ابنِ ادريسٍ أَلَم يأنِكِ الذي","صَبَحنا ابنَ ادريس به فتقطَّرا",68,"ر",2,1],["أَأُمَّ القُرَى هَلْ لِبَذْلِ الْقِرَى","سَبِيلٌ فَمَا غِبْتُ عَنْكِ اخْتِيَارَا",69,"ر",2,0],["أَأَمدَحُ مَن بهِ أَهجُو مَدِيحِي","إِذَا طَيَّبتُ بِالمِسكِ الكِلابا",70,"ب",2,0],["أآمنة السرب كفّي الملامَ","ضلالاً لرأيكِ منِّي ضلالا",71,"ل",2,0],["أأمنع من بوادي العلم منعاً","كأني ليس لي فيها نصيب",72,"ب",1,0],["أَأُمدح كوني مادح الآل ما الذي","أتيت به غير الفروض المقامةِ",73,"ه",1,0],["أآمِنَ أن أجزعْ عليك فإنني","رُزِئتُكَ أحْلى مِنْ شبابي ومن وفْري",74,"ر",2,0],["أآمِنَ لا والله ما زلتُ موقناً","ببينك لو أني أخذتُ له حِذْري",74,"ر",2,0],["أَأُمامَ بِعَيشِكِ هَل ذَرَفَت","عَيناكِ وَهَل أَرِقت أَرَقي",75,"ق",2,0],["أأم زكي لا كان الزيال","ولا كانت لياليه الطوال",76,"ل",1,1],["أأم زكي فقدك في فؤادي","له ما عشت وقد واشتعال",76,"ل",1,0],["أأميم إنك لو بليت خلائقي","لعلمت أني ماجد بسام",77,"م",1,0],["أأمين رزؤك قد اذاب قلوبنا","وجميعنا شركاك في بلواكا",78,"ك",2,0],["أامين اني لم اقل ما قلته","زوراً فقد شهدت به اعداكا",79,"ك",2,0],["أامين من دنياك قد نلت المنى","ووفت بما يهوى ادي دنياكا",79,"ك",2,0],["أاميل يوم عماد بنتك ناديا","ملأت جموع مهنئيك الناديا",80,"ي",2,1],["أأميل ما انا عن ولاك اميل","وبي الوفاء على الولاء دليل",81,"ل",1,1],["أَأَميرَ الحُسنِ وَهَل أَحدٌ","إِلّا لِجمالِكَ يَأَتَمِرُ",82,"ر",1,0],["أإمام الحق وناصره","طهرت الأرض من الدنس",83,"س",1,0],["أأملهم لما ابغى فالقى","بهم ما لا يراه الواصفونا",84,"ن",2,0],["أأم للذي أضحت به الأرض قد علا","عليها من الأنوار نور له وقد",85,"د",1,0],["أأم هي لما اصفر صفو بياضها","بصفرتها أضنتك أم بالتبهج",86,"ج",1,0],["أأم بدر سلمى لاح من نحو قصرها","فها هو ذا البين المصارع مشرف",87,"ف",1,0],["أأم أشرقت شمس النهار ضحية","ألا لا ولكن فاطم قد تضارع",88,"ع",1,0],["أأم لمنني إذ لم أبت في خدورها","وفوقي ملاءة وتحتي طنافس",89,"س",1,0],["أأم بعث الهموم عليك خطب","ومال بحادث فنفى الرقادا",90,"د",2,0],["أأم لرعابيب عذارى غرانق","يمدن كأغصان فويق النمارق",91,"ق",1,0],["أأم أنت للدنيا الدنية عاشق","وقد كنت في أمس لها غير عاشق",91,"ق",1,0],["أأم حرمة من غير تخييرنا جرت","فهل بد من تعريفها للخلائق",91,"ق",1,0],["أأم خاف سيف البغي والجور فانثنى","فلا هو مملوك وليس بطالق",91,"ق",1,0],["أأم قلت ما قد قلت بالصدق إنني","غلظت وما تعنين إ