i.ae/diwan/poem/122292","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114404","المجتث"],[3862,"","https://poetry.dctabudhabi.ae/diwan/poem/111214","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133303","البسيط"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130560","السريع"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142950","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35535","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111449","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75684","البسيط"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99209","الوافر"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20882","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119597","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119650","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119618","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119639","الطويل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106737","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94436","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105504","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133136","البسيط"],[4927,"عشق ورغد","https://www.poetsgate.com/ViewPoem.aspx?id=29945",""],[5183,"الخد النضر","https://www.poetsgate.com/ViewPoem.aspx?id=186378",""],[5183,"عُلْيَا المَناَصِب","https://www.poetsgate.com/ViewPoem.aspx?id=186458",""],[5213,"أصاتت باسمك الناعون جهرا","https://www.poetsgate.com/ViewPoem.aspx?id=170488",""],[5277,"الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=184871",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[463,"أمنْ أسماءَ والمسرى بعيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60031&r=&rc=87",""]],"verses":[["وَرامَ العُلى بِالشِعرِ وَالشِعرِ دائِباً","فَفي الناسِ شُعرٌ خامِلونَ وَشُعّارُ",0,"ر",1,0],["وَرامينَ وَهناً بِالجِمارِ وَإِنَّما","رَموا بَينَ أَحشاءِ المُحِبّينَ بِالجَمرِ",1,"ر",1,0],["وَراموا أَكلَنا مِن غَيرِ جوعٍ","فَأَشبَعناهُمُ ضَرباً وَطَعنا",2,"ن",2,0],["وَرامِشَةٍ يَشفي العَليلَ نَسيمُها","مُضَمَّخَةُ الأَنفاسِ طَيِّبَةُ النَشرِ",3,"ر",1,1],["وَرامَ يَهدِمُ ما الرَحمَنُ شَيَّدَهُ","وَلَيسَ ما شَيَّدَ الرَحمَنُ بُنيانا",4,"ن",2,0],["ورام الزواج ببنت النقيب","فما قبلوه على ثروته",5,"ه",1,0],["ورام اعتذاري عن ذنوبٍ تقدّمَتْ","وذمّةِ ودٍّ قد أساءَ لها رعيا",6,"ي",2,0],["وراموا بأطرافِ الأنامل غايةً","وطِئتُ وقد أعيتهُمُ بالأخامصِ",7,"ص",1,0],["وَرامَ اِعتِذاراً ثُمَّ غَصَّ بِريقِهِ","وَظَنَّ كَنِيُّ الكَلبِ أَنّى أُكالِبُه",8,"ب",2,0],["وَرامَت بَنو تَيمٍ بِكَرماءَ مُتعَةً","فَما كَرُموا عِندَ اللِقاءِ وَلا عَفّوا",9,"ف",3,0],["وَرامَ في المُلكِ الَّذي رامَهُ","بِغِشِّهِ فيهِ وَإِدغالِهِ",10,"ل",2,0],["ورامَتْ حُماةُ الرُّومِ لُقياه فاغتدَتْ","مواقفُها يومَ اللِّقاءِ قبورَها",11,"ر",3,0],["وَراموا بِأَنواعِ العَقاقيرِ بُرأَهُ","وَهَل يُصلِحُ العَطّارُ ما أَفسَدَ الدَهرُ",12,"ر",1,0],["ورام حَقْنَ دماءِ الرّومِ معتمداً","على وفاءِ وفيّ منك بالذممِ",13,"م",1,0],["ورامُوا بِهِ صَيْدَ البلادِ وغنمها","فَأَضحى وَقَد قُصَّت خوافِقهُ العشرُ",14,"ر",1,0],["وَرامِياً جَمَراتِ الحَجِّ في سَنَةٍ","رَمى بِها جَمَراتِ اليَومِ ذي الشُعَلِ",15,"ل",1,0],["وَراموا دَمَ الإِسلامِ لا مِن جَهالَةٍ","وَلا خَطَإٍ بَل حاوَلوهُ عَلى عَمدِ",16,"د",1,0],["وَرامَ النَصارى بِها نُصرَةً","فَلَم يُنجِدِ الرومَ رَومُ الحِيَل",17,"ل",1,0],["وَرامَهُ موسى فَما أَطاقَه","وَمَجَّهُ مَن فيهِ حينَ ذاقَه",18,"ه",1,0],["وَراموا فَرائِسَ أُسدِ الشَرى","وَقَد نَشِبَت بَينَ أَنيابِها",19,"ب",3,0],["ورامَ جِماحاً والكتائبُ حَولَه","فوافاكَ في ظلّ السُّرادق أجمَحا",20,"ح",2,0],["وراموا التي كانت لهُمْ وإليهِمُ","وقد صَعُبَتْ حالٌ وعَزّ مَرامُ",21,"م",1,0],["ورامت بك الأعداء كل بعيدة","من المكر لم تخطر عليها الخواطر",22,"ر",1,0],["ورام بزعمه قلب الثريا","ثرى والطود صيره خيالا",23,"ل",2,0],["ورام يسيرُ من طَرَبٍ إليها","فقَيَّدَهُ الهُزالُ عنِ المَسيرِ",24,"ر",1,0],["ورامَ توديعاً له فانثَنى","يَرغب في تَقبيل أقدامه",25,"م",2,0],["وَرامَ مَقَامَكَ ا لأعلَى وأغلَى","لَظَى الشَّحنَا وأَعلَنَ بِالضِّرَارِ",26,"ر",1,0],["ورام يلهو بآمالي فقلت له","لا تدعُ بي الشوق إني غير معمودِ",27,"د",1,0],["ورامت بنو رام مراما فأصبحوا","وقد أنزلتهم خيلك المنزل الضنكا",28,"ك",2,0],["وَرَأَّمتُمُوني كُلَّ ذِي عَيدَهِيَّةٍ","بَعِيدَ الرِضا إِن أُعطِهِ الحَقَّ بَرشَما",29,"م",2,0],["ورامَيتُ فيكِ النَّفسَ حَتّى رَمَيتنِنى","مَعَ النّابلِ الحَرّانِ حَيثُ رَمَانى",30,"ن",2,0],["ورام الأجر والفخر المهنّا","بلا عزم ولا ثقة وثوق",31,"ق",1,0],["وراموا ما يروم الشصّ أيضا","وإن كتموا فقد صارواشصوصا",32,"ص",2,0],["ورام الخلاصَ وكيف الخلاصُ","وقد بلغ الماءُ أعلى الزُّبَى",33,"ا",1,0],["وَراموا نَيلَ شَأوِكَ وَالمَعالي","لَها ظَهرٌ بَراكبِهِ زَليلُ",34,"ل",1,0],["وَرَامَتْ ليوثَ الروم فُتخاً كَواسِراً","فَما وَجَدُوا نَصراً وَلا عَدِمُوا هَصرا",35,"ر",2,0],["وَرامَ الْحاسِدُونَ لَدَيْكَ تَبْلاً","وَدُونَ مَرامِهِمْ حَزُّ الْوِداجِ",36,"ج",1,0],["وراموا منه إِحساناً وفضلاً","فأَوسعهم بنائله وأَغنى",37,"ن",2,0],["وَرامت أساطينُ الملوكِ هناءه","فَما بَرِحت تستمجدُ الرسلَ وَالكتبا",38,"ب",2,0],["وراميةٍ وجهَ السَّماءِ بمثلِه","سَراباً فكُلٌّ في مَدى الطرَّفِ واسِعُ",39,"ع",1,0],["ورامَ الْحَيَا يَحْكِيهِ قُلتُ له اتَئِدْ","أَتَرمي إلى شأوٍ من المجدِ أَبْعَدِ",40,"د",1,0],["ورام بأن تزم بنا المطايا","إلى المختار خير بني معدّ",41,"د",1,0],["وَرامَ العَزا لَمّا تَذَكَّرَت ريمها","لِرَبّاتِ أَجيادِ الغَلاصِم تولَجُ",42,"ج",1,0],["وراموا سُلُوّي في هواه عواذلي","وحقّ هواه لست أصغي وأسمع",43,"ع",1,0],["ورامت ان تذكرني عهوداً","تقضت في أويقاتٍ بهيّه",44,"ي",2,0],["ورامَها الغيثُ فنا","دَتْهُ على البعدِ اجْهَدِ",45,"د",1,0],["ورامَ أن يقفزَ بال","أبلقِ عرْضَ الخندَقِ",46,"ق",1,0],["ورَامٍ عن قِسِيِّ الغِلِّ نَبْلاً","أصَبْنَ مقاتِلَ الأَدَبِ النَّبِيلِ",47,"ل",1,0],["وَرَامَتْ ثواءً من أَبٍ وَثواؤه","عَلَى الضَّيْمِ بَرْحٌ من شماتِ عِدَاها",48,"ا",3,0],["ورام حِطاطَها فهوى رجيما","بها شيطانه ونجا سُهاها",49,"ا",3,0],["ورامياً لم يتحرَّجْ من دمي","مقتنصاً كيف استحلَّ الحرما",50,"م",2,0],["ورامياتٍ عن ذواتِ مقلٍ","تلاوذَ القاريُّ من نبالها",51,"ل",3,0],["ورامياتٍ لا يؤدّين دماً","ولا يبالين أسال أم رقا",52,"ق",2,0],["ورامٍ بنجدٍ خضَّب السهمَ من دمى","على ما اتقيتُ وهو بعدُ يفوّقُ",53,"ق",1,0],["ورامٍ سهمَ عينيه بسَلعٍ","وبالزوراء يقتُلُ مَن يريدُ",54,"د",1,0],["وراموا التي يَرضى بها الخُرقُ وحدَهُ","خِداعاً وتأباها الحزامةُ واللُّبُّ",55,"ب",1,0],["ورامُ ذمامي معشرٌ فأبحتُهُ","لأبْلجَ من آل النبي حُلاحِلِ",56,"ل",1,0],["ورام دفينَ الحبِّ من لا يناله","وما يقتل العشاقَ إلا دفينه",57,"ن",2,0],["وَرامَ بِعَينَيهِ جِبالاً مُنيفَةً","وَما لا يَرى فيهِ أَخو القَيدِ مَطمَعا",58,"ع",2,0],["وراموا اندحاض النور إذ بان ساريا","بأفئدة النائين من دغل داغل",59,"ل",1,0],["ورامَ يُطْفئُ طَيْشاً نورَ مَظْهَرِنا","وبُرْجهُ فَوقَ مَجْلى هامَةِ الحَمَلِ",60,"ل",1,0],["ورَامَ بأنْ يَدينَ بِما حَوَتْهُ","نُصُوصُ كِتابِ رَبيِّ ذِي الْجَلالِ",61,"ل",1,0],["وَرامُوا لا رُعوا إطفاءَ عِلْمي","وعابُوا ما يُرْجِّحُهُ اجْتِهادي",62,"د",2,0],["ورَامُوا وَضْعَ رُتْبَتِهِ فكانوا","عَلَى الشَّرَفِ الرَّفِيعِ هُمُ الشُّهُودُ",63,"د",1,0],["وَراموا النِصفَ مِنّا فَاِنتَصَفنا","مِنَ الأَعداءِ أَبلَغَ ما اِنتِصافِ",64,"ف",1,0],["ورامه لا يفوتهُ ما يرومُ","أبو حفصٍ له قلمٌ بديعٌ",65,"ع",1,0],["ورام العِدا أنْ يسلبوك ثيابَها","وقد حالت الأقدارُ دون مَرامِها",66,"م",3,0],["وراموا قطعَ أسبابٍ مِتانٍ","علقتُ بها فما قطعوا قِبالي",67,"ل",2,0],["وَرامَ مداهُ المُترفون وإنّما","يَرومونَ ما رامَ الوِهادُ من الهَضْبِ",68,"ب",1,0],["ورام منه بأن يراه","فجاءه عنه لن تراني",69,"ن",2,0],["وراموا نظمَ تأريخٍ فقالوا","بميخائيلَ تبتَهِجُ المَلائكْ",70,"ك",1,0],["ورام تِبْنِين فَقُلْنا له","لو لَمْ ينمْ عقْلُك لم تَحْلُمْ",71,"م",1,0],["ورامَ قلبيَ أَنْ يسلو فقلتُ له","أَينَ الَّذِي عنه يا قلبي يُسلِّيكا",72,"ك",2,0],["وراموا أموراً لانطلاق عظيمة","بأهل الهدى أهل التقى والحامد",73,"د",1,0],["وَرامَ لَها مِن طَغمة التُرك معتقا","وَبَعدا لِعَهد التُرك أَشأم أَنكَدا",74,"د",2,0],["ورام مرامي ريم رامة فارتمى","مهامه همي لاقتناص أسودي",75,"د",2,0],["ورام بقاءهما عنده","ليعلو على غيره في الرتب",76,"ب",1,0],["وَرامَ بِغدره بُعدي وَيَأبى","سِوى قُربي مِن الأَحيا إلهي",77,"ي",1,0],["ورامحٌ مستعدّ","وأعزلٌ مستفيد",78,"د",1,0],["وَرامَ إِدباراً فقُلتُ اِصطَبِر","لأشربَ الشّمس على البدرِ",79,"ر",1,0],["وَرامَتِ السّيرَ قَبلَ الصّبحِ يَسبِقُها","فَشِمتُ مِمّا فَعَلنا اللَّيلَ قَد شابا",80,"ب",2,0],["وَرامَ كُل مِنهُما يغني","وَينشد الفنَّ وَأَهل الفَن",81,"ن",1,0],["وَرامَ أَن يذبحها لسيِّده","فَصَرَخَت وَهيَ تَروغ في يَده",82,"ه",1,0],["وَرامَ أَن يَكسر مِنها الراسا","وَأَن يُريح مِن أَذاها الناسا",83,"س",2,0],["وَرامَ أَن يصلب فيهِ نَفسه","يُكفى بِهِ الفقر الَّذي قَد مَسَّه",84,"ه",1,0],["وَرامَ أَن يَطمع في أَكل الغَدا","فَحَطَّهُ في الأَرض ثُمَّ اِجتَهَدا",85,"د",2,0],["وَرامَ يَسمعه ما لَيسَ يَنفَعُه","كَأَنَّما يَسمَع النوّام لِلأَبدِ",86,"د",1,0],["وَرامَ نِكايَةَ الأَعداء فيهِ","فَأَوسَعُه اِحتِرافاً وَاِنتِهابا",87,"ب",2,0],["ورام أن يحمل من قدرة","وعندك الباطل لا يقبل",88,"ل",1,0],["ورامَ الصبرَ عنها مَن شكاها","بقلب لا يقرُّ له قرار",89,"ر",1,0],["وَرَامَ يَشْرِي بِغَالِي الهَجْرِ أنْفُسَنَا","رُخْصاً فَأشْرَى رَخِيصَ النَّفْسِ بِالغَالِي",90,"ل",2,0],["ورام أن يشكر المولى على قدم","فقام يحي الدجى حتى زكت ورما",91,"م",2,0],["وراموا وحاشا المجد أن يتقدموا","علينا وهاموا بالاماني وما همنا",92,"ن",2,0],["ورام توديعا له فأثنى","يرغب