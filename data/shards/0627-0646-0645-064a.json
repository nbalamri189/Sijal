{"poems":[[6,"لمن الديار عفون بالحبس","https://www.aldiwan.net/poem378.html",""],[5,"إن تسألي تغلباً وإخوتهم","https://www.aldiwan.net/poem279.html",""],[85,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85522","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[131,"ما هاجك اليوم من رسم وأطلال","https://www.aldiwan.net/poem24261.html","البسيط"],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[245,"إن تسألي جحجبى وإخوتها","https://www.aldiwan.net/poem1767.html","المنسرح"],[556,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88597","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48781","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79863","السريع"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114008","الخفيف"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45470","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201176","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72789","الرمل"],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[5351,"سؤال الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=202130",""],[6185,"صدمةٌ !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87025&r=&rc=11",""]],"verses":[["أَنمِي إِلى حَرفٍ مُذَكَّرَةٍ","تَهِصُ الحَصا بمَواقِعٍ خُنسِ",0,"س",1,0],["أُنمى إِلى الصَيدِ مِن رَبيعَةَ وَال","أَخيارِ مِنهُم إِن حُصِّلوا نَسَبا",1,"ب",2,0],["إنّمى هذا الخليفا","الغني باللّه محمد",2,"د",1,0],["إن ميزان الشعر في كل قوم","مارسوه أن يجذب الإنسانا",3,"ن",2,0],["أَنْمَى المَعَارِفَ وَالفُنُونَ وَأيُّهَا","فِي ظِلِّهِ وَبِفَضْلِهِ لَمْ يُزْهِرِ",4,"ر",1,0],["أنمى صلاة وأزكاها وأوفرها","موصولة الفيض والامداد في العصر",5,"ر",1,0],["أَنمى إِلى مَجدِ أَجدادٍ لَهُم عَدَدٌ","مُذَلِّلينَ لِوَطءِ الحَقِّ اِزوالِ",6,"ل",1,0],["أُنمى إِلى الذّروَةِ العُليا وَتُنجِبُني","أَماجِدٌ لَيسَ في عِيدانِها خَوَرُ",7,"ر",1,0],["أنمي إلى الصيد من رفاعةَ وال","أخيار منهم إن حصلُوا سَبَبا",8,"ب",2,0],["أُنمى إلى بيت العُلا من هاشمٍ","من ذلك الأصلِ الأشمِّ الباسِقِ",9,"ق",1,0],["أَنمى بدوراً تحت داجية الوَغى","يطلعن منها للرماح نجوم",10,"م",1,0],["آن ميعادهم أيصدق ما امتد","دت به ألسنٌ ودارت وجوه",11,"و",2,0],["أنميتَ لي في عُرسه نبعةً","عنك ستروي طيب أفعالها",12,"ل",3,0],["إنّ ميمونَ قد رَمَتني بذَنبٍ","كُنتُ منهُ وعلمِ ربّي برِيّا",13,"ي",2,0],["أَنمي فَأَعقِلُ في ضَبيسٍ مَعقِلاً","ضَخماً مَناكِبُهُ عَظيمُ الهادي",14,"د",2,1],["أنميت نفسي فكادت تهجر البدنا","فالميت إن يحيَ يوماً يخلعِ الكفنا",15,"ن",2,1],["أَنْمى الى شَرفِ الرجاءِ واحتمى","بأجلِّ من تُنمى بهِ الأعْرَاقُ",16,"ق",1,0],["إن ميزان العلى من قسطه","رجحت في راحتيهِ كفتاها",17,"ا",3,0],["أنمى إلى سيد الوادي وتتبعه","روحي وفي نهجه كم تعبق السير",18,"ر",1,0],["أنمى فساداً وأطغى","جَوراً وأبشع قتلا",19,"ل",2,0],["أُنْمَى إِلَى دَوْحَةٍ طَابَتْ أوَائِلُهُا","الجَدُّ حَاتِمُ مِثْلُ الغيثِ مَا هَمَلَا",20,"ل",2,0]]}