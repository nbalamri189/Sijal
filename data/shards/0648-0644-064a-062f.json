{"poems":[[53,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[53,"حلفت بأعلام المحصب من منى","https://www.aldiwan.net/poem30724.html","الطويل"],[63,"أترب الخنى ما لابن أمك مولعا","https://www.aldiwan.net/poem45854.html","الطويل"],[63,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[93,"هي ليلى عبد المسيح فحدث","https://www.aldiwan.net/poem11134.html","الخفيف"],[93,"وليدة دعا المحيون بأن","https://www.aldiwan.net/poem11176.html","الرجز"],[93,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[72,"برغمي أن شرعت له رثاء","https://www.aldiwan.net/poem19178.html","الوافر"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[43,"أماتكم من قبل موتكم الجهل","https://www.aldiwan.net/poem10131.html","الطويل"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[2,"أعن كل أخدان وإلف ولذة","https://www.aldiwan.net/poem25038.html","الطويل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[50,"إليك طلبنا يا وليد وإنما","https://www.aldiwan.net/poem63879.html","الطويل"],[46,"يا قلب لا أدعوك في أكرومة","https://www.aldiwan.net/poem22912.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55145","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[126,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[132,"ألا ليت حظي من حياطة نصركم","https://www.aldiwan.net/poem21010.html","الطويل"],[148,"دليل علاك ليس على اعتراض","https://www.aldiwan.net/poem68471.html","الوافر"],[167,"رويدك يا هذا المليك الحلاحل","https://www.aldiwan.net/poem1646.html",""],[172,"طلعت شمس عقار","https://www.aldiwan.net/poem46036.html","مجزوء الرمل"],[219,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[227,"ليهن الملك مالكه الجديد","https://www.aldiwan.net/poem51155.html","الوافر"],[230,"أخاطبه عند التلفت يا رشا","https://www.aldiwan.net/poem14709.html","الطويل"],[259,"هو المجد ما يقظانه مثل نائم","https://www.aldiwan.net/poem38191.html","الطويل"],[259,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[273,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[301,"جنيت وعاقبت الفؤاد وطالما","https://www.aldiwan.net/poem58114.html","الطويل"],[326,"خلت نفسي يوما إلها عظيما","https://www.aldiwan.net/poem54977.html","الخفيف"],[362,"جعلت فداك الدهر أغرز نابه","https://www.aldiwan.net/poem60861.html","الطويل"],[456,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[462,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[475,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[493,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[549,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[549,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[583,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["وَليدٌ لَوَ أَنَّ اللَيلَ رُدّي بِوَجهِهِ","لَما جاوَرَتهُ بِالجُنوبِ المَضاجِعُ",0,"ع",1,0],["وَليدٌ هَمى ماءُ العُلى في جَبينِهِ","وَقَد شِمتُ مِنهُ بارِقَ الحَسَبِ العِدِ",1,"د",1,0],["وَلي دَمعُ عَينٍ لا يُرَنِّقُ ساعَةً","وَنارُ غَرامٍ بَينَ جَنبَيَّ لا تَخبو",2,"ب",2,0],["وَلي دَوْحَةٌ فَوْقَ السَّماواتِ فَرْعُها","وَتَحْتَ قَرارِ الأَرْضِ مِنْ عِرْقِها شُعَبْ",3,"ب",1,0],["ولي دونَهُمْ منْ سِرِّ عَدنانَ فِتيةٌ","نِزاريّةٌ تَهفو إليهِمْ ضَرائبي",4,"ب",2,0],["وَلْيَدُمْ يُوسُفُ النَّدَى يَنْظُمُ الأَفْ","رَاحَ كَالعِقْدِ دُرَّة إِثْرَ دُرَّهْ",5,"ر",2,0],["وَلِيدَةٌ دَعَا المُحَيُّونَ بِأَنْ","تَحْيَا وَيَحْيَا آلُهَا سِنِينَا",6,"ن",2,1],["وَلْيَدُمْ ذَلِكَ الْوَلاءُ فَكَمْ","صَانَ مُلْكاً وَسَرَّ أَوْطَانَا",7,"ن",2,0],["وليدٌ كان يا أسفي حبيباً","أبى تسيارُ كوكبه رُجوعا",8,"ع",2,0],["وليدُهُم بادي الطَّوى ووليدُكم","من الريف ريَّانُ العظام خَدَلَّجُ",9,"ج",1,0],["وَلي دونَكُم أَهلَونَ سيدٌ عَمَلَّسٌ","وَأَرقَطُ زُهلولٌ وَعَرفاءُ جَيأَلُ",10,"ل",1,0],["وَلي دُرَرُ الأَخلاقِ في المَدحِ وَالهَوى","وَلِلمُتَنَبّي دُرَّةٌ وَحَصاةُ",11,"ه",1,0],["وُلَيدَ أُبَيِّ الطَيِّبِ الكَلبِ ما لَكُم","فَطِنتُم إِلى الدَعوى وَمالَكُمُ عَقلُ",12,"ل",1,0],["ولي ديونٌ على الأيامِ يضمَنُ لي","قضاءَها عن قريب بعد لَيَّانِ",13,"ن",1,0],["وَليدَينِ حَتّى قالَ مَن يَزَعُ الصِبا","أَجِدَّكَ لَمّا تَستَحي أَو تَحَرَّجِ",14,"ج",1,0],["وليدُ عَجاجةٍ وعقيدُ طاوٍ","يَصيدُ عِنانُه الأجلَ الصَّيودا",15,"د",2,0],["وَليدُ اِبنُ عَبّاسٍ وَلَيسَ بِعابِسٍ","إِذا اِحتاجَ جارٌ أَو أَلَمَّ بَعيدُ",16,"د",1,0],["وَلِيُدرِكَنَّ جِعادَنا وَسِباطَنا","وَما أَدراكَ النُعمانَ في ساباطا",17,"ط",2,0],["وَليَدُمْ نَسْلُكَ الكَرِيمُ كَمَا تَهْوى","العُلَى فِي تَعاقُبِ الأَجْيَالِ",18,"ل",1,0],["وليدٌ له عُلْيَا معدّ ذُوابةٌ","جلالةُ أنسابٍ ومجدٌ مُؤشَّب",19,"ب",1,0],["وليدخلُن بغيضهم وحبيبهم","ذمّى ومن أهْوى ومن يَهْواني",20,"ن",2,0],["وَليدٌ أَبوهُ كانَ عَبداً لِجَدِّنا","إِلى عِلجَةٍ زَرقاءَ جالَ بِها السِحرُ",21,"ر",1,0],["ولي دَين بلقيته ولكن","أرى الأيام تمطل بالتقاضي",22,"ض",2,0],["وَلِيَ دُونَ هَذا عِندَ فَضلٍ وَسيلَةٌ","إِذا اِنقَطَعَت فيما سِواهُ الوَسائِلُ",23,"ل",1,0],["وَلْيَدُرْ كَأْسُ بُدُورٍ","فِيهِ أَهْواءُ النُّفُوسِ",24,"س",1,0],["وليدم بيننا التعاون والإخلاص","والود وهو أطيب غرس",25,"س",1,0],["وَليدٌ كانتِ الدنيا ترجِّي","وِلادتَه وترقُبُه السعود",26,"د",1,0],["وَلي دَهشَةُ الساهي إِلَيهِ إِذا بَدا","وَلَم يَبدُ ذاكَ الخَدُّ إلّا لِيُدهِشا",27,"ش",2,0],["وليد لقد مادت لمولده القنا","ودانت ليمناه رقاب الصوارم",28,"م",1,0],["وليدن مني الحامدون","محمد المولى الامين فأنه محمود",29,"د",1,0],["وَليداً وكَهْلاً أحْرَزَ المَجْدَ وَالْعُلى","لَهُ مِنْهُما إِرْثاً سَنَامٌ وكَاهِلُ",30,"ل",1,0],["ولي دين ود قد نسيت وفاءه","سيوفى إذا سل العتابُ سيوفا",31,"ف",2,0],["وليدم ذلك الصراع على الأر","ض إلى أن يحين بدء الختام",32,"م",1,0],["ولي دينُ جُودٍ غَيرَ أَنّىَ ساكتٌ","وتَرْكُ التَّقاضي للكريمِ تَقاض",33,"ض",1,0],["ولي ديونٌ أُجِّلن عندك قد","أكَلن لحمي وقد شرِبن دمي",34,"م",2,0],["وليدةُ ناديكم وغرسُ أكفّكم","تُرَبُّ بتدبيراتكم وتُعالُ",35,"ل",1,0],["وليدهمُ في مهدهِ كابن مريمٍ","يحدّث عن آبائهِ بالمخائل",36,"ل",1,0],["ولي دمعٌ يخبَّرُ عن ضميري","كما شرَح الكلامَ التُّرجُمانُ",37,"ن",1,0],["وليدركن على الكرا","مة سوء عاقبة الغرامه",38,"م",2,0],["وليِدُهُمُ في حِجىً كالكهولِ","وواحِدُهمْ مثلُ جيشٍ لُهامِ",39,"م",1,0],["وَلِي دونَهمْ حقّي وَفوقَ ظُهورهمْ","إذا عضّني المكروه ثِقْلِيَ أَو وِقْري",40,"ي",1,0],["ولي دهرٌ يُراقبني فأَرْمِدْ","بلَحظٍ منك أَلحاظ الرّقيب",41,"ب",1,0]]}