{"poems":[[55,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[55,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[55,"حلفت بأعلام المحصب من منى","https://www.aldiwan.net/poem30724.html","الطويل"],[65,"أترب الخنى ما لابن أمك مولعا","https://www.aldiwan.net/poem45854.html","الطويل"],[65,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[95,"هي ليلى عبد المسيح فحدث","https://www.aldiwan.net/poem11134.html","الخفيف"],[95,"وليدة دعا المحيون بأن","https://www.aldiwan.net/poem11176.html","الرجز"],[95,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[74,"برغمي أن شرعت له رثاء","https://www.aldiwan.net/poem19178.html","الوافر"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[87,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[45,"أماتكم من قبل موتكم الجهل","https://www.aldiwan.net/poem10131.html","الطويل"],[64,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[2,"أعن كل أخدان وإلف ولذة","https://www.aldiwan.net/poem25038.html","الطويل"],[107,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[52,"إليك طلبنا يا وليد وإنما","https://www.aldiwan.net/poem63879.html","الطويل"],[48,"يا قلب لا أدعوك في أكرومة","https://www.aldiwan.net/poem22912.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55145","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[111,"هزت العالم أدوار البشر","https://www.poetsgate.com/ViewPoem.aspx?id=105",""],[132,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[138,"ألا ليت حظي من حياطة نصركم","https://www.aldiwan.net/poem21010.html","الطويل"],[154,"دليل علاك ليس على اعتراض","https://www.aldiwan.net/poem68471.html","الوافر"],[173,"رويدك يا هذا المليك الحلاحل","https://www.aldiwan.net/poem1646.html",""],[178,"طلعت شمس عقار","https://www.aldiwan.net/poem46036.html","مجزوء الرمل"],[226,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[234,"ليهن الملك مالكه الجديد","https://www.aldiwan.net/poem51155.html","الوافر"],[237,"أخاطبه عند التلفت يا رشا","https://www.aldiwan.net/poem14709.html","الطويل"],[266,"هو المجد ما يقظانه مثل نائم","https://www.aldiwan.net/poem38191.html","الطويل"],[266,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[280,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[308,"جنيت وعاقبت الفؤاد وطالما","https://www.aldiwan.net/poem58114.html","الطويل"],[333,"خلت نفسي يوما إلها عظيما","https://www.aldiwan.net/poem54977.html","الخفيف"],[369,"جعلت فداك الدهر أغرز نابه","https://www.aldiwan.net/poem60861.html","الطويل"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[482,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[500,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[556,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[556,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[590,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138962",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66836","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64086","الرمل"],[842,"","https://poetry.dctabudhabi.ae/diwan/poem/138066","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38278","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37789","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38966","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38156","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70689","السريع"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202117","المنسرح"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56095","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56277","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109069","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137916",""],[1613,"","https://poetry.dctabudhabi.ae/diwan/poem/97578","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127953","الطويل"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121545","البسيط"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202557",""],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110343","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53229","الرجز"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144425","السريع"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65989","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201551","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202708","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200008","المتقارب"],[3132,"","https://poetry.dctabudhabi.ae/diwan/poem/73669","البسيط"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/140124",""],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88979","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123925","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85143","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2551","الطويل"],[4172,"","https://poetry.dctabudhabi.ae/diwan/poem/147785","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90834","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91023","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91015","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94623","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83427","الوافر"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123459","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139593",""],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4691,"محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=146375",""],[4691,"فديتكِ غادة ً","https://www.poetsgate.com/ViewPoem.aspx?id=209106",""],[4755,"لِدَارِ الأَسَى بَابَانِ.. عالٍ, وهابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=198745",""],[4578,"أبانت فوق حاجبها المصون","https://www.poetsgate.com/ViewPoem.aspx?id=49534",""],[5277,"أهل قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185166",""],[5277,"أهلُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=205830",""],[5480,"قصور الحب","https://www.poetsgate.com/ViewPoem.aspx?id=1148",""],[5605,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=159457",""],[6124,"وليد","https://www.poetsgate.com/ViewPoem.aspx?id=201254",""]],"verses":[["وَليدٌ لَوَ أَنَّ اللَيلَ رُدّي بِوَجهِهِ","لَما جاوَرَتهُ بِالجُنوبِ المَضاجِعُ",0,"ع",1,0],["وَليدٌ هَمى ماءُ العُلى في جَبينِهِ","وَقَد شِمتُ مِنهُ بارِقَ الحَسَبِ العِدِ",1,"د",1,0],["وَلي دَمعُ عَينٍ لا يُرَنِّقُ ساعَةً","وَنارُ غَرامٍ بَينَ جَنبَيَّ لا تَخبو",2,"ب",2,0],["وَلي دَوْحَةٌ فَوْقَ السَّماواتِ فَرْعُها","وَتَحْتَ قَرارِ الأَرْضِ مِنْ عِرْقِها شُعَبْ",3,"ب",1,0],["ولي دونَهُمْ منْ سِرِّ عَدنانَ فِتيةٌ","نِزاريّةٌ تَهفو إليهِمْ ضَرائبي",4,"ب",2,0],["وَلْيَدُمْ يُوسُفُ النَّدَى يَنْظُمُ الأَفْ","رَاحَ كَالعِقْدِ دُرَّة إِثْرَ دُرَّهْ",5,"ر",2,0],["وَلِيدَةٌ دَعَا المُحَيُّونَ بِأَنْ","تَحْيَا وَيَحْيَا آلُهَا سِنِينَا",6,"ن",2,1],["وَلْيَدُمْ ذَلِكَ الْوَلاءُ فَكَمْ","صَانَ مُلْكاً وَسَرَّ أَوْطَانَا",7,"ن",2,0],["وليدٌ كان يا أسفي حبيباً","أبى تسيارُ كوكبه رُجوعا",8,"ع",2,0],["وليدُهُم بادي الطَّوى ووليدُكم","من الريف ريَّانُ العظام خَدَلَّجُ",9,"ج",1,0],["وَلي دونَكُم أَهلَونَ سيدٌ عَمَلَّسٌ","وَأَرقَطُ زُهلولٌ وَعَرفاءُ جَيأَلُ",10,"ل",1,0],["وَلي دُرَرُ الأَخلاقِ في المَدحِ وَالهَوى","وَلِلمُتَنَبّي دُرَّةٌ وَحَصاةُ",11,"ه",1,0],["وُلَيدَ أُبَيِّ الطَيِّبِ الكَلبِ ما لَكُم","فَطِنتُم إِلى الدَعوى وَمالَكُمُ عَقلُ",12,"ل",1,0],["ولي ديونٌ على الأيامِ يضمَنُ لي","قضاءَها عن قريب بعد لَيَّانِ",13,"ن",1,0],["وَليدَينِ حَتّى قالَ مَن يَزَعُ الصِبا","أَجِدَّكَ لَمّا تَستَحي أَو تَحَرَّجِ",14,"ج",1,0],["وليدُ عَجاجةٍ وعقيدُ طاوٍ","يَصيدُ عِنانُه الأجلَ الصَّيودا",15,"د",2,0],["وَليدُ اِبنُ عَبّاسٍ وَلَيسَ بِعابِسٍ","إِذا اِحتاجَ جارٌ أَو أَلَمَّ بَعيدُ",16,"د",1,0],["وَلِيُدرِكَنَّ جِعادَنا وَسِباطَنا","وَما أَدراكَ النُعمانَ في ساباطا",17,"ط",2,0],["وَليَدُمْ نَسْلُكَ الكَرِيمُ كَمَا تَهْوى","العُلَى فِي تَعاقُبِ الأَجْيَالِ",18,"ل",1,0],["وليدٌ له عُلْيَا معدّ ذُوابةٌ","جلالةُ أنسابٍ ومجدٌ مُؤشَّب",19,"ب",1,0],["وليدم حيا رياض وليعش","ثابت العزة هذا المؤتمر",20,"ر",1,0],["وليدخلُن بغيضهم وحبيبهم","ذمّى ومن أهْوى ومن يَهْواني",21,"ن",2,0],["وَليدٌ أَبوهُ كانَ عَبداً لِجَدِّنا","إِلى عِلجَةٍ زَرقاءَ جالَ بِها السِحرُ",22,"ر",1,0],["ولي دَين بلقيته ولكن","أرى الأيام تمطل بالتقاضي",23,"ض",2,0],["وَلِيَ دُونَ هَذا عِندَ فَضلٍ وَسيلَةٌ","إِذا اِنقَطَعَت فيما سِواهُ الوَسائِلُ",24,"ل",1,0],["وَلْيَدُرْ كَأْسُ بُدُورٍ","فِيهِ أَهْواءُ النُّفُوسِ",25,"س",1,0],["وليدم بيننا التعاون والإخلاص","والود وهو أطيب غرس",26,"س",1,0],["وَليدٌ كانتِ الدنيا ترجِّي","وِلادتَه وترقُبُه السعود",27,"د",1,0],["وَلي دَهشَةُ الساهي إِلَيهِ إِذا بَدا","وَلَم يَبدُ ذاكَ الخَدُّ إلّا لِيُدهِشا",28,"ش",2,0],["وليد لقد مادت لمولده القنا","ودانت ليمناه رقاب الصوارم",29,"م",1,0],["وليدن مني الحامدون","محمد المولى الامين فأنه محمود",30,"د",1,0],["وَليداً وكَهْلاً أحْرَزَ المَجْدَ وَالْعُلى","لَهُ مِنْهُما إِرْثاً سَنَامٌ وكَاهِلُ",31,"ل",1,0],["ولي دين ود قد نسيت وفاءه","سيوفى إذا سل العتابُ سيوفا",32,"ف",2,0],["وليدم ذلك الصراع على الأر","ض إلى أن يحين بدء الختام",33,"م",1,0],["ولي دينُ جُودٍ غَيرَ أَنّىَ ساكتٌ","وتَرْكُ التَّقاضي للكريمِ تَقاض",34,"ض",1,0],["ولي ديونٌ أُجِّلن عندك قد","أكَلن لحمي وقد شرِبن دمي",35,"م",2,0],["وليدةُ ناديكم وغرسُ أكفّكم","تُرَبُّ بتدبيراتكم وتُعالُ",36,"ل",1,0],["وليدهمُ في مهدهِ كابن مريمٍ","يحدّث عن آبائهِ بالمخائل",37,"ل",1,0],["ولي دمعٌ يخبَّرُ عن ضميري","كما شرَح الكلامَ التُّرجُمانُ",38,"ن",1,0],["وليدركن على الكرا","مة سوء عاقبة الغرامه",39,"م",2,0],["وليِدُهُمُ في حِجىً كالكهولِ","وواحِدُهمْ مثلُ جيشٍ لُهامِ",40,"م",1,0],["وَلِي دونَهمْ حقّي وَفوقَ ظُهورهمْ","إذا عضّني المكروه ثِقْلِيَ أَو وِقْري",41,"ر",2,0],["ولي دهرٌ يُراقبني فأَرْمِدْ","بلَحظٍ منك أَلحاظ الرّقيب",42,"ب",1,0],["ولي دموع بسري للورى نطقت","فأطلعت قلبها للناس من فيها",43,"ي",3,0],["وَليدان أمُّهما بَرَّةٌ","حَصانٌ مطهَّرةٌ للحَصانِ",44,"ن",1,0],["وَلْيُدِرها مُخطَفُ الأح","شاءِ كالسيفِ العتيق",45,"ق",1,0],["ولي دموع إذا كفكفتها وكفت","عليك من كل أجفان قريحات",46,"ت",1,0],["وَليدَةُ فِكر اِمرِئٍ خانَتهُ فِكرَتُهُ","فَلَيسَ يفرُق بَينَ الشِّعرِ وَالشَّعرِ",47,"ر",1,0],["وَليدَةُ فِكرٍ لَم أجِدْ خاطباً لها","سِواكَ وقد جاءتكَ جاريةً تجري",48,"ر",2,0],["وَليدَة فِكرٍ فيهِ أَشهر حَمْلِها","قَدِ اِستكملت قَطعاً فَلم تَكن السقطا",49,"ط",2,0],["وَليدةُ فِكرِ مَن أَضحى خَطيباً","بَليغاً بِالبَيانِ وَخير موفِ",50,"ف",1,0],["ولْيدُم الحاسدُ في ذِلةٍ","قرينُه الغَمُّ وداءُ الكُبادْ",51,"د",1,0],["وَلِيُّ دين الهدى سماء ندى","تحيي بوسمي غيثها وولي",52,"ل",2,0],["ولي دسمٌ يزكي كل جنسٍ","من الطبخ الذي لي فيه اصبعْ",53,"ع",1,0],["وليدفع الله عنه كل كارثةٍ","وكل ضيرٍ وضيمٍ مكرهٍ وردى",54,"د",2,0],["وليدفع النفس إِلى البلاء","أما أنا فادمعي رجائي",55,"ي",1,0],["وليدخل البستان كل شاكرا","طول المدى يد بطرس البستاني",56,"ن",2,0],["وَليدكم لَدى رأي كشيخ","وَشيخكمُ لدى حربٍ وليدُ",57,"د",1,0],["وليدهم يسمو به كل منصب","وحدهم للخير خير امام",58,"م",1,0],["ولي دروس بعلم الفقه ما درست","كحال كل فقيه كان في زمني",59,"ن",2,0],["وليدم في العز عامرة","منه أوطار وأوطان",60,"ن",1,0],["وليدمع العلم حزناً في معاهده","فقد أصيبت بمبناها وبالبناني",61,"ن",2,0],["ولي ديون عند سكان النقا","حلت فما للشوق يقتضيني",62,"ن",2,0],["وليدع عند الوضع للخوان","من كان حاضراً من الاخوان",63,"ن",1,0],["ولي دواءٌ من سقام الهوى","لو كنت أروى من لمى أروى",64,"و",2,0],["ولي درهم هو من ثمانين درهماً","وتسعة آلاف وألف فما الجرم",65,"م",1,0],["ولي دنيا سوى الدنيا فسعدي","وبؤسي لا يقرّهما رفيقي",66,"ي",1,1],["ولي دنيا أعيش بها سعيداً","خيالي مطلقٌ والنفس جذلى",67,"ل",2,0],["وليد الحروب بساح الكفاح","من الموت والأسر أنقذته",68,"ت",2,0],["وَلي دُيونٌ عَلَيكِ حَلَّت","لَو أَنَّهُ يَنفَعُ الحُلولُ",69,"ل",1,0],["وليد قد كفاه أب شفيق","وحفّه بالمبرّة والوداد",70,"د",1,0],["وليدع للحكم مستخف ومختلس","أيضاً فإن يمتنع فالجبر قد وصلا",71,"ل",2,0],["وليدفع العبد عن أموال سيده","لو قل لا غيره إلا إذا جعلا",71,"ل",2,0],["وليد جاء والده سميا","وحقق رتبةً فيه رجاءه",72,"ا",3,1],["وليدن نحوي بعد مزجها فما","لبانتي إلا عناق المازج",73,"ج",1,0],["ولي دموعي كم له من كرامة","روتها من الروض الأريض خمائله",74,"ل",2,0],["وَليداً إِلى أَن خالَطَ الشَيبُ مَفرَقي","وَأَلبَسَني مِنهُ الثَغامُ المُنَزَّعُ",75,"ع",1,0],["وليداً إلى أن صحوتَ وأوضحتْ","من الخُصَل اللاتي فرقتَ صُفوح",76,"ح",1,0],["وليد به الدنيا استنارت وأشرقت","بكوكب سعد من شموس تولدا",77,"د",2,0],["وليد المفدى أحمد الشان فرقد ال","سعادة في افق السيادة والفخر",78,"ر",1,0],["وليد به البشرى لوالده عسى","يكون له سيفا بقبضة فيصل",79,"ل",1,0],["ولي ديدنٌ دينٌ بحفظ مودتي","وأذكر معروفاً أخو العُرف واهبُه",80,"ب",2,0],["وَليدُك يا شَفيعَ الخَلقِ مُضنىً","أَجِرهُ بِالشَفاعَة ما اِستَجارَك",81,"ك",1,0],["وليدٍ قد كفاهُ أبٌ شقيقٌ","وحَفَّه بالمبرّةِ والوداد",82,"د",1,0],["وليدر عزرائيل ان سماحه","يولى البيوت واهلها تعميرا",83,"ر",2,0],["ولي داخل البيت جثة قطّ","وخارجه صيت فيل عظيم",84,"م",1,0],["وليدُ الجود خواض المنايا","فتى الهيجاء مغوار الكفاح",85,"ح",1,0],["وليدم تربي بالمسرة حبرا","كاملا فاضلا كريم السجية",86,"ي",2,0],["وليدٌ بهِ يحيا الجَدِيبُ كأنّهُ","سَحَابٌ أَغَاثَ الأرضَ ميلادُهُ الجدا",87,"د",2,0],["ولي دمعٌ سخيٌ حاتميٌّ","فدمع ُ العاشقُ المشغوف عادة",88,"د",2,0],["ولِي _دُونَ هذا البَحرِ والحِبرِ- مُقلَةٌ","على ضَفَّتَيها المَوجُ لِلمَوجِ خابِطُ",89,"ط",1,0],["ولي دينٌ إلى أجلٍ مسمى","على خديه بالدمع الهتون",90,"ن",1,0],["وليدُ الشوقِ ألقى فوق ظهري","معاناةِ الفطامِ..فما أقولُ ؟",91,"ل",1,0],["وليدُ الشوقِ ألقى فوق ظهري","معاناةِ الفطامِ ,كذا العذولُ",92,"ل",1,0],["وليده من خفا قافي وليده","تظم الشوق يالظبي الرغيدي",93,"د",2,0],["وَلِيدٌ أَتَى مِنْ بَعْدِنَا وَوَلِيدَة","وَمَنْ فَارَقَ الدُّنيَا إِلَى القَبر ِيُحمَلُ",94,"ل",1,0],["وَلِيْدٌ أَطْلَقَ الوَجْدَ","عَلَى قَلْبِي كَمَا شَاءَ",95,"ا",2,1]]}