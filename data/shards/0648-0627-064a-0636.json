{"poems":[[74,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67318","الطويل"],[216,"أرى قلمي فوق الصحائف يعبث","https://www.aldiwan.net/poem37902.html","الطويل"],[336,"تردى بثصوب الكبر نوكاً وضلة","https://www.aldiwan.net/poem519.html",""],[447,"ويا طالبا شرح السؤال فآنه","https://www.aldiwan.net/poem14401.html","الطويل"],[534,"شباب مر في قيل وقال","https://www.aldiwan.net/poem37244.html","الوافر"],[563,"ثلاث عليها يدور","https://www.aldiwan.net/poem34506.html","مجزوء المتقارب"],[592,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[1351,"","https://poetry.dctabudhabi.ae/diwan/poem/130686","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64473","الطويل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/216324","الوافر"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28070","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83245","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65989","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65971","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114142","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135207","الوافر"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[164,"","https://poetry.dctabudhabi.ae/diwan/poem/127644","الطويل"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130866","الطويل"],[5055,"غارة الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=103656",""],[5055,"راحة سرية","https://www.poetsgate.com/ViewPoem.aspx?id=177432",""],[5055,"دار الرخا والسكينه","https://www.poetsgate.com/ViewPoem.aspx?id=177451",""],[5122,"وين أنت يالمعتصم","https://www.poetsgate.com/ViewPoem.aspx?id=24262",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5344,"من دروس المعاميل حصه..","https://www.poetsgate.com/ViewPoem.aspx?id=180708",""],[5510,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=206163",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["وإيضاح رأي بنحوِ العلى","قضاياه شافية كافيه",0,"ي",2,0],["وأيضاً فلا يُعْطِيكَهُ ابنُ رواحَةٍ","وإخفَرُهُ من دونِهِ السُّمُّ ناقعُ",1,"ع",1,0],["وأيضاً سليماً ذا الثناء وراشداً","فمن شوقِهم أشكو جَوَى وأغوّثُ",2,"ث",1,0],["وأي ضنينٍ يستحقُّ مبرةً","وأيُّ ضنين حيث كان يسود",3,"د",1,0],["وأَيضاً سؤال كرهوه وانه","سؤالك عما ليس يعني ويجتبى",4,"ب",2,0],["وإيضاحٍ لِمُشْكِلَةٍ وحَلٍّ","لِمُعْضِلَةٍ تَناهَتْ أو سُؤَالِ",5,"ل",1,0],["وأيضا صبرنا به","فجاء بإسم الصبور",6,"ر",1,0],["وأيضاً من علامته اهتمام","بهم واحد غير انتحال",7,"ل",1,0],["وأيضاً من علامته إذا ما","دنا وقت الصلاة لذي الجلال",7,"ل",1,0],["وأيضاً من علامته اهتمام","بتصحيح المقالة والفعال",7,"ل",1,0],["وإيضاح فهمي فيهم ظل مبهما","ففيهم كتمت السر عنهم تكتما",8,"م",2,0],["وايضا إذا عذّبت مثلي وطائعا","تنعّمه فالعفو منك لمن تحبي",9,"ب",2,0],["وأيضاً رأينا العرب تحمي نزيلها","وجيرانها والتابعين من الخطب",9,"ب",1,0],["وأي ضعيف ثابت يا متين إن","قضيت عليه يا متين بنقمة",10,"ه",1,1],["وأيضاً فالصّدوق أبو عبيدٍ","فأعلامٌ من أرباب المقال",11,"ل",1,0],["وَإِيضاعَكَ العَصرَينِ تَبغي نَزيعَةً","بِها الوَسمُ فَذّاً وَحدَهُ وَمُؤالِفا",12,"ف",2,0],["وَأَيضاً ساقُ حُرٍّ يَغتَديها","خِماصِيّاً وَيَأتيها بَطينا",13,"ن",2,0],["وأيضاً الوف أربعون ولم أصب","سوي درهم ياخود ما ذلك الحكم",14,"م",1,0],["وأيضاً فما ذا من جهاداً ذا الفتي","ثحامى على أن لا يلاقى بمارق",15,"ق",1,0],["وأيضاً فلوحيٌّ من الناس لم يمت","لكان ولكن هل بها من مخلد",16,"د",1,0],["وَأَيضاً كانَت جُمعَة يا صاح","وَنَحنُ نَدعو اللَهَ لِلفَلاح",17,"ح",1,0],["وأيضا إن وحد معنى علما","فمع تشخيص يسمى علما",18,"م",2,0],["وَأيضاً الفَاظُ السُّؤَألِ كَمَا","سَمِعتَهَا فِي أوَّلٍ رَاجِحَه",19,"ح",2,0],["وأيضاً ما بذلت فذاك ما لي","وأيضاً ما تركت فليس مالي",20,"ي",1,0],["وأيضاً الَّذِى عَلَى الكفر هَلَك","تَكلِيفُهُ بِهِ إلَى خُسرٍ سَلَك",21,"ك",1,0],["وأيضا فإن العدل من طبعِ نفسهِ","وهذا وهذا لا يوفّر مالا",22,"ل",2,0],["وأيضا صلاة والسلام على الذي","به تنجلى الأهوال في موقف الحشر",23,"ر",1,0],["وأيضا بكى مراتٍ العارض الشيب","يوم أحتنى ظهرة وشابت دْلاله",24,"ل",2,0],["وأيضاً نجند للنفوس الوفيه","ومهارنا ما شببوها المخاسير",25,"ر",1,0],["وايضاً عنيت لجوها صافي البال","تستحظرك ذات العماد الدفينه",26,"ن",2,0],["وايضآ بعد عنده أسلاحه بيولوجيه","يعدم بها المسلمين الناس الاجوادي",27,"د",2,0],["وأيضاً بنو القداح قد كان أمرهم","شهيراً ومعروفاً لدى كل ذي نقد",28,"د",1,0],["وأيضاً فذا يفضي إلى ترك حقه","وتعظيمه إلا لمن زار من بعد",29,"د",1,0],["وأيضاً ففي إسناده فاعلمنه","عيةً العوفي ضعيفٌ لذي النقد",29,"د",1,0],["وأيضاً فتقليد الأئمة عندكم","أحق من الأصحاب بل كان أسلما",30,"م",2,0],["وأيضا فتقليد الصحابة واجب","جميعاً فقد كانوا هداةً وأنجما",30,"م",2,0],["وأيضاً فهم لم يوجبوه وإنما","أحبوا وما قالوا مقالا ًمحتما",30,"م",2,0],["وايضاً قبل ل تسوقها لا تمكنت","ارشف لك بفنجال سميه رخصه..",31,"ص",2,0],["وأيُّ ضوءٍ سما بعد التي هجرتْ","بستانَ عمري وما ألفيتُ من سمتي",32,"ت",2,0],["وأيضا فإن المزج مزج شرائع","بأسرارها الحقانيات البديعتي",33,"ت",2,0]]}