5309,"إذا سايرت اوهامك","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573872",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[242,"أملى الهنا والسعد ردد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563696",""],[6237,"كوكب الشرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77890&r=&rc=32",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""],[5126,"تأمل! فلا سرّ لديك ولا جهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87800&r=&rc=15",""],[6368,"","https://www.linga.org/varities-articles/NDEwMQ","المضارع"]],"verses":[["وَغَني عَنِ الدُنيا وَكانَ شَجىً لَها","إِنَّ الغَنِيَّ قَذىً لِطَرفِ المُعدِمِ",0,"م",1,0],["وغَنِيتَ في حِجْرِ الحَيا مُستَرضَعاً","يَغْذوكَ واشِلُ طَلِّهِ والوابِلُ",1,"ل",1,0],["وَغَنّى عَلى الأَغصانِ وُرقُ الحَمائِمِ","بِقُرطُبَةَ الغَرّاءَ دارِ الأَكارِمِ",2,"م",1,0],["وَغَنَيتُ سَبتاً قَبلَ مُجرى داحِسٍ","لَو كانَ لِلنَفسِ اللَجوجِ خُلودُ",3,"د",1,0],["وغنَّى وقد مالت به نشوة الصبا","نديمي ماس الغصن في سندسيّه",4,"ي",2,0],["وغنت الرُّكبانُ في شتمه","شدواً متى يسمعْهُ لا يَطْربِ",5,"ب",1,0],["وغنّته صوتاً طيباً وهْو قولها","لصفعُ أبي الخرطوم أحلى من القَمْر",6,"ر",1,0],["وغنَّتْه صوتاً ثانياً وهْو قولها","طربت إلى أنف صبور على النقرِ",6,"ر",1,0],["وغنّته صوتاً ثالثاً وهو قولها","غدا أنف عمرو وهو نهْد على قعر",6,"ر",1,0],["وغَناء الخضاب عن صاحب الشَي","ب غَناءُ الرُّقى عن الممراض",7,"ض",1,0],["وغناءٌ كأَنَّهُ أرْيَحيّا","تُ الصِبى تستخِفُّ حِلْمَ الحليمِ",8,"م",1,0],["وغنَّى إذ لحاهُ الناسُ لمّا","رأوه مُطلقاً في ذُلِّ عاني",9,"ن",2,0],["وَغَنَّمَ عَتّابَ اِبنَ سَعدٍ سِواهُمُ","وَشَمَّصَ بَهراءَ الوَشيجُ المُمَكَّرُ",10,"ر",1,0],["وَغِناءٍ يُدارُ لَحناً فَلَحناً","كَحَديثِ النَديمِ أَو كَعُقارِهِ",11,"ر",2,0],["وَغِناكَ مَسأَلَةٌ وَطَيشُكَ نَفخَةٌ","وَرِضاكَ فَيشَلَةٌ وَرَبُّكَ دِرهَمُ",12,"م",1,0],["وَغَنيتُ نَدمانَ الخَلائِفِ نابِهاً","ذِكرى وَناعِمَةً بِهِم نَشَواتي",13,"ت",2,0],["وَغِناءٌ حَسَنٌ مِن قَينَةٍ","وَرَياحينُ وَراحٌ تُستَجَدّ",14,"د",1,0],["وَغَنَّت بِهِ وُرقُ الحَمائِمُ حَولَنا","غِناءً يُنَسّيكَ الغَريضَ وَمَعبَدا",15,"د",2,0],["وَغِناءً لِمَن أَرادَ غِناءً","وَقَريضاً لِمَن أَرادَ قَريضا",16,"ض",2,0],["وغَنِيتُ بالساقي الأَغَنِّ لأنه","وِزْرٌ يَزيدُ الصبَّ من أَوزارِه",17,"ر",2,0],["وغنَّى ارتياحاً إلى عارضٍ","يغنّي وعَبرتُه تَنسَكِبْ",18,"ب",1,0],["وَغِنى النَفوسِ هُوَ الكَفافُ وَإِن أَبَت","فَجَميعُ ما في الأَرضِ لا يَكفيها",19,"ه",2,0],["وَغَنِيتُ عَنْ قُلَتِي بِعَامِلِ أَسْمَرٍ","وَسَلَوْتُ عَنْ مَهْدِي بِصَهْوَةِ أَدْهَمِ",20,"م",1,0],["وَغَنَّيتُهُ شِعري بِهِ أَستَميلَهُ","فَأَبدى اِزدِراءً باِبنِ حُجرٍ وَمَعبَدِ",21,"د",1,0],["وَغِناءٌ يَستَعجِلُ الراحَ غَضٌّ","وَكَما ناحَ في الغُصونِ الحَمامُ",22,"م",1,0],["وَغِناءَ الطُيورِ كُلَّ صَباحٍ","وَاِنفِتاقَ الأَسحارِ بِالأَنوارِ",23,"ر",1,0],["وَغَنّى لَنا في جَوفِها حَبَشِيَّةٌ","عَلَيها سَراويلٌ مِنَ الماءِ مُجسَدُ",24,"د",1,0],["وغنيٌّ مثلُهُ ما دُمْتُمَا","عن حُسامٍ وقَناةٍ وجَواد",25,"د",1,0],["وَغَنّى لَنا صَوتاً بِلَحنٍ مُرَجَّعٍ","سَرى البَرقُ غَربِيّاً فَحَنَّ غَريبُ",26,"ب",1,0],["وَغَنِّني قَد أَجابَ العودُ شائِقَهُ","وَحَرَّكَ النايُ مِنّي بَعضَ وَسواسي",27,"س",2,0],["وَغَنَّتِ الطَيرُ بَعدَ عُجمَتِها","وَاِستَوفَتِ الخَمرُ حَولَها كَمَلا",28,"ل",2,0],["وَغَنِّ إِذا طَرِبتَ فَدَتكَ نَفسي","وَقَد كَحَلَتكَ أَسبابُ المَنامِ",29,"م",1,0],["وغِنَاءِ مُسْمِعَةٍ جَرَرْتُ لِصَوْتِهَا","ثَوْبِي ولَذَّةِ شَارِبٍ وفِضَالِ",30,"ل",1,0],["وغناءٌ كأنَّ قمريةً سك","رى بألحانها تشيع الرّاحُ",31,"ح",1,0],["وغَنَّتْ فأسمعني صوتها","صَدى الروحِ في خلَجات البدنْ",32,"ن",1,0],["وغَنَّتِ الريحُ به في الجبَلْ","فحركتْ منهُ جلاميدَهُ",33,"ه",1,0],["وغَنّتْ لنا في دارِ سابُورَ قَيْنَةٌ","مِن الوُرْقِ مِطرابُ الأصَائلِ ميهال",34,"ل",1,0],["وغنّيت الشام دما وثأرا","فلا شكوى عرفت ولا نواحا",35,"ح",2,0],["وَغَنَّى لَنَا شَادٍ أَغَنُّ مُقَرْطَقٌ","رَفِيقٌ بِجَسِّ الْمِلْهَيَاتِ لَبِيقُ",36,"ق",1,0],["وَغَنَاءِ رَأْيٍٍ عَنْ دَلاَ","لةِ إِبْرَةٍ أَوْ مَهْيعِ",37,"ع",1,0],["وَغَنَّيْتِ حَتَّى تَعَزَّى الْحَزينُ","وَقَرَّ الشَّجِيُّ وَهَام الْخَلِي",38,"ل",2,0],["وغناء كخفق بيت من القش","تعاوت فيه الريّاح الشدائد",39,"د",1,0],["وغنّى على خطوه شارع","ودرب على خطوه زغردا",40,"د",2,0],["وغنّاك حبّي فلاقى لديك","صدى ناعما مترفا كالحرير",41,"ر",1,0],["وغناء مدلّة ينشر الحبّ","صداه وفي فم الصمت يطوى",42,"و",2,0],["وغَنَّى \" أُورْشَلَيمَ \" يُعيدُ لحناً","لداود هَزارٌ بالصُّداح",43,"ح",1,0],["وغنَّتهُ من شعر \" الاخيطلِ \" قَينَةٌ","وطارَحَها فيها المُغنّي فأبهَرا",44,"ر",2,0],["وغناءٌ يتلو غناءً ورُعيانٌ","بقُطْعانِهم تَضيقُ الدروب",45,"ب",1,0],["وغناءٌ كأَنَّهُ أرْيَحياتُ الصْ","صِبى تستخِفُّ حِلْمَ الحليم",46,"م",1,0],["وَغَنَت بِبَيت ما سَمعت بِمِثلِهِ","كَسانيَ في قَيظ الزَمان حَلى البَرد",47,"د",1,0],["وغني من اهل بيت دني","كلما رام رتبة المجد احجم",48,"م",1,0],["وغني غَزَالٌ كالغَزَالَةِ شَادِنٌ","غَدَائِرُهُ قبلٌ وأردَافُهُ رَملُ",49,"ل",1,0],["وغنِّى امرؤٌ خُرِّبتُ في كُلِّ موطنٍ","ومُورِستُ بالتمرين في كل موكب",50,"ب",1,0],["وغَنِّني بحديث الغانيات ولا","تَصِخْ إلى قولِ مَن في حبهنَ لحا",51,"ح",2,0],["وغنّت الحمامُ في عيدانِها","تُحسَبُ في أفنانها مُخارقا",52,"ق",2,0],["وغَنُوا عن خدورهم مذ تغطَّوا","عن محبيّهمُ ببعدٍ وصدِّ",53,"د",1,0],["وَغَنوا وَلا في البَأسِ يَدخُلُ ذِكرُهُم","وَالبَأسُ أَوفى كَسبِهِم وَالجودُ",54,"د",1,0],["وَغَناءُ مَن أَصبَحتَ عَنهُ مُعرِضاً","كَغَناءِ رُمحٍ بانَ عَنهُ سِنانُهُ",55,"ن",2,0],["وَغناءٌ يكادُ أَنْ يَسْكُنَ الما","ء لتغريدِهِ عنِ الاضْطِرابِ",56,"ب",1,0],["وَغَنّنا بِالوَترِ صَوتاً وَقُل","المَوتُ أَحلى مِن سُؤالِ اللِئام",57,"م",1,0],["وغناؤه في قصده","فالمرء يستره اقتصاده",58,"د",2,0],["وغنيا إن رأيتما طللاً","أقفرَ بعدَ الأحبةِ البلدُ",59,"د",1,0],["وغن بمن اهوى وشبب بذكره","وحاول اذا رجعت ان تعرب اللحنا",60,"ن",2,0],["وغناءٌ ترى لبيضهم","في عروض الوغى على الضرب",61,"ب",1,0],["وغنت حمامات فأجرين أدمعى","أتعرف شجوى في الغرام الحمائم",62,"م",1,0],["وغنائي إذا نظمت قصيدي","يا ليالي الأعياد كنتم وكنا",63,"ن",2,0],["وَغِناءُ الغَديرِ ماءٌ قراحٌ"