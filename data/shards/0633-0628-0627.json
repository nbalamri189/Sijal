ِتنا","https://www.poetsgate.com/ViewPoem.aspx?id=176269",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5725,"أقات الموت","https://www.poetsgate.com/ViewPoem.aspx?id=208791",""],[5843,"قلوب احباب","https://www.poetsgate.com/ViewPoem.aspx?id=51295",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[6259,"بدا البرق من نجدٍ فحن إلى نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59369&r=&rc=17",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[2220,"سأحرفُ عن قومٍ عن الحقِّ أعرضوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11496&r=&rc=370",""],[6310,"السُّبات الدَّامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74588&r=&rc=16",""],[6320,"الأَمَةُ الآبِقَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84326&r=&rc=23",""],[572,"ما أَبصَرتْ عيني ولا عَيْنَا أَحَدْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9250&r=&rc=107",""]],"verses":[["سَباني بِخَدٍ كالصَّباحِ مُنَوَّرٍ","وَعَطفَةِ صُدغٍ كالظَلامِ بَهيمِ",0,"م",1,0],["سَبايا بَني شَيبانَ يَومَ أُوارَةٍ","عَلى النارِ إِذ تُجلى لَهُ فَتَياتُها",1,"ت",3,0],["سِبالُهُ وَذَقنُهُ","تَدخُلُ في اِستِ امِّ بَلَك",2,"ك",1,0],["سِباطُ البَنانِ وَالعَرانينِ وَالقَن","لِطافَ الخُصورِ في تَمامٍ وَإِكمالِ",3,"ل",1,0],["سَبَّاقُ غَايَاتٍ إِلَى العُمْرَانِ قَدْ","شَمِلَ المَزَارِعَ مُلْكُهُ المُتَرَامِي",4,"م",2,0],["سَباريتَ إِلّا أَن يَرى مُتَأَمِّلٌ","قَنازِعَ أَسنامٍ بِها وَثَغامِ",5,"م",1,0],["سبارِيتَ يَخلو سَمعُ مُجتازِ خَرقِها","مِنَ الصَوتِ إِلاّ مِن ضُباحِ الثَعالِبِ",6,"ب",1,0],["سَبَّ الفَرَزدَقُ مِن حَنيفَةَ سابِقاً","إِنَّ السَوابِقَ عِندَها التَبشيرُ",7,"ر",1,1],["سبَّاق سعيٍ في العلى ومكارمٍ","بذل لعونٍ في النَّدى ومعين",8,"ن",1,0],["سبايا إليهنَّ استباءُ عقولِنا","مماليك مُلّكْن اقتدارَ الممالك",9,"ك",1,0],["سَبّاقُ غاياتِ البَيانِ جَرى بِلا","ساقٍ فَكَيفَ إِذا اِستَرَدَّ الساقا",10,"ق",2,0],["سَبائِكُ كافورٍ وَعِقيانُهُ الَّذي","بِصُمِّ القَنا لا بِالأَصابِعِ نَقدُهُ",11,"د",2,0],["سَبّاقُ غاياتٍ إِذا طَلَبَ المَدى","بِرَسيلِهِ فَعَدُوُّهُ مِن حِزبِهِ",12,"ب",2,0],["سَبابيطَ تُخبِرُ أجسامُها","بأنْ قد رَعَيْنَ جَناباً خَصيبا",13,"ب",2,0],["سبا حسنُها عقلَ تطريزها","ألمْ تَرَهُ ليسَ يشكو أَلَمْ",14,"م",1,0],["سبّاكُ تبرٍ وفضَّةٍ صَهَرَتْ","نواهُ قلبي فسرَّهُ ذاكا",15,"ك",2,1],["سَباريتَ أَخلاقِ المَوارِدِ يائِسٍ","بِها القَومُ مِن مُستَوضِعاتِ الشَواجِنِ",16,"ن",1,0],["سَبّاقِ غاياتٍ مَجدٍ في عَشيرَتِهِ","مُرَجِّعِ الصَوتِ هَدّاً بَينَ أَرفاقِ",17,"ق",1,0],["سَبَأَ المُدامَةَ فَاِستَدامَ مَسَرَّةً","فيما يُظَنُّ وَلَم يَرِع لمّا سَبى",18,"ب",2,0],["سَباكِ اللَهُ يا دُنيا عَروساً","فَكَم أَوفَدتِ لي شَمعاً بِشَمعِ",19,"ع",1,1],["سَبَاكَ جَمَالُ بِكْفَيَّا بِحَقٍّ","وَفِيهِ كُلُّ مَا يَهْوَى الْفُؤَادُ",20,"د",1,0],["سَباني بِمَخطوطٍ مِنَ المِسكِ أسودٍ","عَلى صَحنِ مَسبوكٍ مِنَ التبرِ أَملَسِ",21,"س",1,0],["سِباطُ البَنانِ وَالعَرانينِ وَالقَنا","لِطافَ الخُصورِ في تَمامٍ وَإِكمالِ",22,"ل",1,0],["سَبَارِيتَ أَخْلاَقِ المَوَارِدِ يَائِسٍ","بِهَا القَوْمُ مِنْ مُسْتَوْضِحَاتِ الشَّوَاجِنِ",23,"ن",1,0],["سبَّاقُ غاياتِ البيانِ جَرى بلا","ساقٍ ، فكيف إذا استرادَّ الساقا ؟ !",24,"ق",2,0],["سباع بغاب الغيب غابوا عن السوى","وخلوا الهوى فاستبعدوا العبد والحرا",25,"ر",2,0],["سب الشبابَ وسب الشيب كلَّهمُ","حتى أباه وسب السهل والجبلا",26,"ل",2,0],["سَبَاني ظبي سَاحِرُ اللَّحظِ فَاتِرٌ","بِلَونَينِ فِيهِ أسنَوِىٍّ وأَلمَوِي",27,"ي",1,0],["سباية صادفت رأى امرىء يقظ","موفق بسبيل الحق معتمد",28,"د",1,0],["سباعي مرادفه خماسي","ثلاثي بلا ألف ولام",29,"م",1,0],["سَباكَ وَلا يَغلِب عَلَيكَ وَقَد بَدا","شُعاعُ مَشيبٍ في المَفارِقِ وابِصُ",30,"ص",1,0],["سبّاقُ غايات الفضائلِ في الورى","طرّاً وسابقُهم لديه أعرجُ",31,"ج",1,0],["سَباني غَزالٌ أَطارَ الرُقادَ","فَأَهلاً بِسَبيِ الغَزالِ الرَبيبِ",32,"ب",1,1],["سباك الجيد والقدّ","وتلك العين والخدّ",33,"د",1,1],["سباق غايات جياد العلا","مدرك شأو والمجد يوم الرهان",34,"ن",1,0],["سباق غايات جواد له","عزم الى شأ والعلا وارتياح",35,"ح",1,0],["سبالك المحفوف قد","حرك مني مخرجا",36,"ج",2,0],["سَباني وَهوَ مَملوكٌ رَقيقٌ","وَكَم حُرٍّ تَمَلَّكَهُ غُلامُ",37,"م",1,0],["سَباني غَزالٌ فاتِرُ الطَرفِ فاتِنٌ","وَلَولا الهَوى ما كُنتُ قَبلُ سُبيتُ",38,"ت",1,0],["سبانه جل من كريم","قد عم بالفضل والأيادي",39,"د",2,0],["سباني هواها وهو مما أجبره","وقد قال فيها العارفون فلا تغوي",40,"و",2,0],["سِبَالُ أبُو الحسينِ لَهُ عِذارٌ","وَحُبُّكَ لِلعِذارِ لِلعِذارِ عَلَيْكَ شَاهِدْ",41,"د",1,0],["سَبايا طَيِّءٍ أَبرَزنَ قَسراً","وَأَبدَلنَ القُصورَ مِنَ الشِعابِ",42,"ب",1,0],["سَبايا طَيِّءٍ مِن كُلِّ حَيٍّ","بِمَن في الفَرعِ مِنها وَالنِصابِ",42,"ب",1,0],["سَباها الصِمّةُ الجُشَميُّ غصباً","كأنَّ بياضَ غُرَّتِها صديعُ",43,"ع",1,0],["سباب الأنام وطول الملا","م وخمل الكلام إلى ذا وذا",44,"ا",1,0],["سبأتَ بطولِ هَجري واجتنابي","كأنَّكَ ناشِئٌ في حِجْرِ هَجْرِ",45,"ر",1,0],["سباريتُ ما فيهن زاء لركب","سَنوي ما حَوَت فيها الأَداحي مِنَ الرَبدِ",46,"د",1,0],["سبَّاق غايات قومٍ لا لحاق له","وكم جرى إثره من سابقٌ فكبى",47,"ب",2,0],["سباق غايات نظم فالبروق إذا","جارته اوقفها سيرا وأعياها",48,"ا",3,0],["سبانه جل من أسرى به شرفا","ليلاً إلى موقف فيه سعادته",49,"ت",2,0],["سباطُ خِلالٍ كالدمقس للامسٍ","وبأسٌ كحد المَشْرفيِّ المُهنَّد",50,"د",1,0],["سباط الجود أغنوا كلَّ عافٍ","عن الجعد الأكفّ أو الشّحاح",51,"ح",1,0],["سباني بوجهٍ لو أماط لثامه","غداة تلاق كان باللحظ يشرب",52,"ب",1,0],["سَباها رِجالٌ من يَهُودَ تَباعَدُوا","لِجِيلانَ يُدْنيها من السُّوقِ مُرْبِحُ",53,"ح",1,0],["سَبَأتُها وَحَولي","خَضارِمٌ أَنجادُ",54,"د",1,0],["سباني جمال الوجه والكل هالك","وعلمي تسامى عن كتاب وعن درس",55,"س",1,0],["سَبَّاقُ غاياتِ الكَمالِ مُجاهِدٌ","في طاعةِ الرَّحمن حقَّ جِهادِهِ",56,"د",2,0],["سَبَّاقُ غاياتٍ ينالُ بفعلِهِ","ما لا يَنالُ سِواهُ في آمالهِ",57,"ل",2,0],["سباني أَنَّهُ يمزِ","جُ تأْنيثاً بتذكير",58,"ر",1,0],["سَباها بِطَبع مِنهُ هين وَمَنظَر","طَرير وَخَلاب مِن القَول رائع",59,"ع",1,0],["سباعاً يسير الناس فيها ضوارياً","ففي جهةٍ ليثٌ وفي جهة ذئب",60,"ب",1,0],["سباني بخد يكاد","وحسن ابتسام أراني السبيلا",61,"ل",2,1],["سَبَاني حَبِيبٌ حَازَ قَلْبي وَنَاظِرِي","حَكى لَمَعَاتٍ مِنْ عُيُونِ الْجَاذِرِ",62,"ر",1,0],["سَبَا النهى لكنهُ","نادى مكاناً سبسبَا",63,"ب",2,0],["سَباني بتكسير أجفانه","وخامَرَني سحر إنسانهِ",64,"ن",2,1],["سباق ذَوي الكَمال لَهُ مَدارٌ","يَأُول إِلَيكَ بِالرَهنِ الثَمين",65,"ن",1,0],["سبا القلب محبوبي وبان التصبر","وأنيّ يطيق الصبر صب مكدر",66,"ر",1,1],["سَبَّاقُ كُلِّ سَابِقٍ مُطَهَّمِ","سَامِي التَّليلِ فِي دَسيعٍ مُفعَمِ",67,"م",1,0],["سباه بطيب العيش والامن والصفا","وجار الى ان كاد يسبي رشاده",68,"د",2,0],["سباك محيَّاه وهو الأغرّ","فغطّ بوجهك هذا الكلف",69,"ف",1,0],["سَباني كَما يَسبي الأَميرُ عُداتَهُ","فَتى المَلِكِ المَنصورِ وَالخَيلُ تُرعَدُ",70,"د",1,0],["سباق غايات أقصى الفضل والشرف ال","أعلى وراقي العلا من غير إدراك",71,"ك",1,0],["سباني اليوم عَن نسكي","فعمري فيه سَكران",72,"ن",1,0],["سبَّاق غاياتٍ زكٍ","ما خاض فكرتَه خلل",73,"ل",1,0],["سَباني بِلَفظٍ كان أَشهى مِنَ المُنى","وَأَوقَعَ في نَفسي مِنَ العَفوِ عَن وِزري",74,"ر",2,0],["سباهم فاطِرُ السبعِ العُلا كرماً","لمن بياسين بين الرسلِ قد شهره",75,"ر",2,0],["سبّاقُ غايةِ بهجةٍ كمحمدٍ","سبّاقِ غايةِ مكرماتِ الناسِ",76,"س",1,0],["سَباسِبٌ يَقلِبُ الأَلوانَ صَيخَدُها","وَتارَةً فَوقَ أَلواحٍ بِذي زَجَلِ",77,"ل",1,0],["سبايا يلاحظن الكفيل مصفداً","على الرحل مغلول اليدين مكنعا",78,"ع",2,0],["سباني وأبلاني بكل مقرطَقٍ","وما نظمَ الرحمن من لؤلؤ التعر",79,"ر",1,0],["سباها وأسلاها وجود منزه","عن الحدِّ بالفصل المقوّمِ والجنسِ",80,"س",1,0],["سبّاقٌ غاياتِ المكارمِ أوحدٌ","حاوي الفضيلةِ يَوْمَ رَفْعِ طواله",81,"ل",2,0],["سَبأن نُحوضاً والسِّبالَ كأَنَّما","يُنَشَّرُ ريطٌ بَينَهُنَّ صَفيقُ",82,"ق",1,0],["سبا مهجتي قدٌّ رشيقٌ ومبسمٌ","عقيقٌ ووجه يستهل جمالا",83,"ل",2,0],["سبّاق غايات تَقطَع دونَها","سِباقُها إِن مدت الحَلبات",84,"ت",1,0],["سباق غايات الفخار ومن به","جبر الكَسير وسدّ فقر المفلس