{"poems":[[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[93,"هانت معالم مات سيدها","https://www.aldiwan.net/poem11139.html","أحذ الكامل"],[93,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11164.html","الخفيف"],[72,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[45,"إني لأحمد ناظري عليكا","https://www.aldiwan.net/poem34270.html","عموديه"],[66,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[66,"ولما رأينا المنع منكم سجية","https://www.aldiwan.net/poem38780.html","الطويل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[69,"أنا لو كنت مقلا","https://www.aldiwan.net/poem29288.html","مجزوء الرمل"],[74,"وحسام بكف أشوس أجرى","https://www.aldiwan.net/poem12931.html","الخفيف"],[105,"أنخ البعير فقد بلغت المسجدا","https://www.aldiwan.net/poem44013.html","الكامل"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[81,"خلصت خلص التبر من علة","https://www.aldiwan.net/poem61548.html","الطويل"],[46,"خلصت من سبرات في السباريت","https://www.aldiwan.net/poem22206.html","البسيط"],[46,"ذكرتني عقوبة من إلهي","https://www.aldiwan.net/poem22732.html","الخفيف"],[46,"الفتى قد رأى اليقين ولكن","https://www.aldiwan.net/poem23262.html","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43838","البسيط"],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[81,"خلُصتَ خُلوصَ التِّبرِ من عِلّة الضنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10971&r=&rc=12",""],[122,"علمك بعمان قرية","https://www.aldiwan.net/poem23740.html","البسيط"],[140,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[202,"إني لأحسد مقلتي عليكا","https://www.aldiwan.net/poem53210.html","الكامل"],[233,"خلصوني من كف حجامكم ه","https://www.aldiwan.net/poem31906.html","الطويل"],[235,"كم ذا تقرطسني بسمر نبالها","https://www.aldiwan.net/poem18851.html","الكامل"],[235,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[257,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[268,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[303,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[326,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[362,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[362,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[362,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[369,"لا تحسبوا صيداء حين تغيرت","https://www.aldiwan.net/poem56994.html","الكامل"],[369,"خلصت من خدعات الأعين النجل","https://www.aldiwan.net/poem57198.html","الكامل"],[456,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[456,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[456,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[462,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[462,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[466,"يا من هو الغصن الرطيب إذا انثنى","https://www.aldiwan.net/poem59606.html","الكامل"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[513,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[513,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[549,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[556,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[556,"نسب المحبة أقرب الأنساب","https://www.aldiwan.net/poem34931.html","الكامل"]],"verses":[["خَلَصَ النَجيُّ مُشاوِراً","قَلباً عَلى النَجوى كَتوما",0,"م",2,0],["خَلُصَتْ لِوَجْهِ الخَيْرِ نِيَّتُهَا","فَزَكَا مِنَ الذِّكْرَى تَزَوُّدِهَا",1,"د",3,0],["خَلُصَتْ مِنْ دَمٍ وَرُدَّتْ لِمَاءٍ","ثُمَّ أَضْحَتْ رُوحاً بِفِعْلِ الزَّمَانِ",2,"ن",1,0],["خلَّصت رزقهم من كيدِ كائدهم","وغبت عنهم فلا والله ما تركوا",3,"ك",3,0],["خلَصَ الهَوَى لَك ،واصْطَفَتْكَ مَوَدَّتي","حَتَّى أَغارَ عَلَيْكَ مِنْ مَلَكيْكَا",4,"ك",2,0],["خَلُصتُ مِنَ الأَهوالِ لَمّا لَقيتُهُ","فَبِتُّ مَنيعاً وَالخُطوبُ شَوائِخُ",5,"خ",1,0],["خَلَصنا وَأَسقَطنا التَجَمُّلَ بَينَنا","فَلا سَيِّدي يُعطي وَلا عَبدُهُ يُهدي",6,"ي",1,0],["خَلُصَتْ خلائِقُهُ ولَم يَعْلَقْ بها","جَبْرِيّةٌ لم يَرْضَها الجبّارُ",7,"ر",1,0],["خَلُصَ العالمُ جمعاً","مِنْ يميني ويساري",8,"ي",1,0],["خَلَّصتُهُ نارُ الطَبيعَةِ سَبكاً","وَأَسالَت لُجَينَهُ وَنُضارَه",9,"ر",2,0],["خلصوا على يده فيا لكِ من يدٍ","فتحت لدينِ اللهِ باباً مُوصَدا",10,"د",2,0],["خَلُصَتْ للنبيِّ مِنكَ خِلالٌ","أفعمتْ نَفْسَهُ هَوىً وودادا",11,"د",2,0],["خَلُصتَ خُلُصَ التِبرِ مِن عِلَّةِ","الضَنى وَأَشبَهتَ مِنهُ عِلَّةً بِشُحوبِ",12,"ب",1,1],["خَلَصتُ مِن سَبَراتٍ في السَباريتِ","وَرُبَّ يَومٍ كَريتٍ دونَ تَكريتِ",13,"ت",1,1],["خَلِّصيني مِن ضَنكِ ما أَنا فيهِ","وَاِطرَحيني لِمَنكَرٍ وَنَكيرِ",14,"ر",1,0],["خَلَصَت مِن بَناتِها وَبَنيها","فَهيَ بَينَ النِساءِ مِثلُ البَتولِ",15,"ل",1,0],["خَلَصَتْ لَهُ الْيُمْنَى وَعَمَّ ثَلاثَةً","مِنْهُ الْبَيَاضُ إِلَى وَظِيفٍ أَجْرَدِ",16,"د",1,0],["خَلصت مِنها وَنَحنُ فيها","مِثل العَصافيرِ في الفِخاخِ",17,"خ",1,0],["خُلصاءِ سَعيِكَ في الجْهاد وإخوةٍ","لكَ في الوفاءِ المحضِ والإِيثار",18,"ر",1,0],["خَلَصَ النعيمُ لهم فهم من رقةٍ","وغضارةٍ بيضُ الوجوه وِسام",19,"م",1,0],["خلَصْتِ كما خَلصَ ابنُ \" القُيون \"","تَرعرَع في النار ثمَّ استوى",20,"ا",1,0],["خلُصتَ خُلوصَ التِّبرِ من عِلّة الضنى","وأشبهتَ منهُ علة ً بشحوبِ",21,"ب",1,1],["خلصك من الدلف تايحطك تحت المزراب","بين حانا ومانا ضاعت لحانا",22,"ن",2,0],["خلِّصونى من ظَبيكم أو أنادى","بالذي يُنقذ الأسارَى ويفدى",23,"د",2,0],["خلص الهوى لك واصطفتك مودَّتي","حتّى حذرتُ عليك من أبويكا",24,"ك",2,0],["خَلِّصوني مِن كَفِّ حَجّامِكُم هَ","ذا فَقَد عَزَّ مِن يَدَيهِ الخَلاصُ",25,"ص",1,1],["خَلِّصْ جُوَيْرَكَ مِنْ حُبُولٍ أَوْلَغَتْ","فِيهِ الْمُدَى فَغَدا حَليفَ قِتالِهَا",26,"ل",3,0],["خَلَّصْتَ مِنْ هُوَى الْهَوَى مَنْ قَدْ بَدَا","لَكَ رَبَّنَا إِخْلاَصُهُ وَخُلُوصُهُ",27,"ص",2,0],["خلّصه ممّا ساء كن كافلَهُ","فأنت في أموره كافي لَهُ",28,"ه",1,0],["خلّصتنا من قيودِ الظالمينَ وقد","ذقنا الرّدى والبلايا من سُيوفهم",29,"م",1,0],["خلصت خلوصَ التبرِ كرّر سبكهُ","في جاحمٍ من فادح التخريبِ",30,"ب",1,0],["خلصلت روحه فسال ضياء","وطوى طينه سجل الرغاب",31,"ب",1,0],["خلَصَتْ سَريرتُه وسائرهمْ","قد نافَقُوا غِشّاً فما نَفقوا",32,"ق",3,0],["خَلَصْنا نَجِيّاً في نَدِيٍّ من الكَرى","ونحن بأسرارِ الصّبابةِ نَنْتَجِي",33,"ج",2,0],["خلَصْنَ غداةَ البَيْنِ من شَبَكِ الهوى","وألقَيْنَ أطرافَ الحبالِ البتائت",34,"ت",1,0],["خَلَصَ الهَوى لمَّا انقضَت أسبابُهُ","فِيها فصِرتُ أحبُّها في اللَّهِ",35,"ه",1,0],["خلصتُ من خَدعاتِ الأَعينِ النُّجلِ","إنِّي إذاً لَشديدُ المكرِ والحِيَلِ",36,"ل",1,1],["خلَّصك الدهرُ من الناس لي","من بعدِ تَركاضي وتَطوافيا",37,"ي",2,0],["خَلِّصهُ لي يا دهرُ وامضِ بمن","يقتادُ واخلُصْ أنتَ من ذمِّي",38,"ي",1,0],["خَلصتَ خلوص التبرِ منها مسلَّمَّاً","عليك وميضٌ صادعٌ ولهيبُ",39,"ب",1,0],["خلِّ صباّ يموت وجداً ويحيا","بوصالٍ من الغواني وصدِّ",40,"د",1,0],["خلصت بنار الشمس مهجةُ تبرها","والتبر يخلصهُ لظى السبَّاك",41,"ك",1,0],["خَلِّص بِجاهِ الوَصلِ قَلبَ مُتَيَّمٍ","غَمَزَ الصُدودُ عَلَيهِ أَعوانَ الضَنى",42,"ن",2,0],["خلصت سلافة ما أقول من القذى","لما تولت عصرها الأعصار",43,"ر",1,0],["خلصهم بجاهه","مشفعاً فيما سأل",44,"ل",1,0],["خلصت كل قبيلة من ضدها","لما التوت وتعقدت عقدانها",45,"ن",3,0],["خَلصتُ خلوصَ التِّبرِ ضوعفَ سبكُهُ","وَطاحَتْ بهِ أَقذاؤُه وشوائبُهْ",46,"ب",2,0],["خلصتها مني ومن","غيري بتشديد ولين",47,"ن",1,0],["خلص محبتك التي هي فيك من","دعوى الوجود تفز بفتح الباب",48,"ب",1,0]]}