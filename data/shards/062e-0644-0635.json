"الطويل"],[563,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[563,"نسب المحبة أقرب الأنساب","https://www.aldiwan.net/poem34931.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83263","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122827","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103072","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101511","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48693","الكامل"],[935,"","https://poetry.dctabudhabi.ae/diwan/poem/146455","الكامل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129546","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59687","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62525","الخفيف"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124614","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120028","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72309","البسيط"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118085","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52082","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76654","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69405","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102136","المنسرح"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137960",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53135","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28507","الكامل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34717","الرمل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70336","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93790","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100379","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109854","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203002","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74197","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74162","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97899","الكامل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106800","الكامل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123599","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86505","الكامل"],[3861,"","https://poetry.dctabudhabi.ae/diwan/poem/73551","المتقارب"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35574","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81298","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117282","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66157","الرمل"],[4767,"شباك الحب","https://www.poetsgate.com/ViewPoem.aspx?id=210275",""],[4778,"خلَصَ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208691",""],[5131,"مكانَكِ يا نفسُ لا تنطقي","https://www.poetsgate.com/ViewPoem.aspx?id=53814",""],[333,"الإنسان والمعرفة","https://www.poetsgate.com/ViewPoem.aspx?id=98236",""],[5495,"منو بحالنه","https://www.poetsgate.com/ViewPoem.aspx?id=175423",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5550,"أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=211701",""],[5664,"الملح والعشرة","https://www.poetsgate.com/ViewPoem.aspx?id=176693",""],[5749,"اه يا دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=157287",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5843,"خيل الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=51277",""],[5848,"حبيبة قلبي البارح","https://www.poetsgate.com/ViewPoem.aspx?id=53161",""],[6100,"خسرتك","https://www.poetsgate.com/ViewPoem.aspx?id=52548",""],[469,"كفي كؤوسك فالمدامة ما سقت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574769",""],[520,"جعل الدعاء وظيفة لك والثنا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577671",""]],"verses":[["خَلَصَ النَجيُّ مُشاوِراً","قَلباً عَلى النَجوى كَتوما",0,"م",2,0],["خَلُصَتْ لِوَجْهِ الخَيْرِ نِيَّتُهَا","فَزَكَا مِنَ الذِّكْرَى تَزَوُّدِهَا",1,"د",3,0],["خَلُصَتْ مِنْ دَمٍ وَرُدَّتْ لِمَاءٍ","ثُمَّ أَضْحَتْ رُوحاً بِفِعْلِ الزَّمَانِ",2,"ن",1,0],["خلَّصت رزقهم من كيدِ كائدهم","وغبت عنهم فلا والله ما تركوا",3,"ك",3,0],["خلَصَ الهَوَى لَك ،واصْطَفَتْكَ مَوَدَّتي","حَتَّى أَغارَ عَلَيْكَ مِنْ مَلَكيْكَا",4,"ك",2,0],["خَلُصتُ مِنَ الأَهوالِ لَمّا لَقيتُهُ","فَبِتُّ مَنيعاً وَالخُطوبُ شَوائِخُ",5,"خ",1,0],["خَلَصنا وَأَسقَطنا التَجَمُّلَ بَينَنا","فَلا سَيِّدي يُعطي وَلا عَبدُهُ يُهدي",6,"د",2,0],["خَلُصَتْ خلائِقُهُ ولَم يَعْلَقْ بها","جَبْرِيّةٌ لم يَرْضَها الجبّارُ",7,"ر",1,0],["خَلُصَ العالمُ جمعاً","مِنْ يميني ويساري",8,"ي",1,0],["خَلَّصتُهُ نارُ الطَبيعَةِ سَبكاً","وَأَسالَت لُجَينَهُ وَنُضارَه",9,"ر",2,0],["خلصوا على يده فيا لكِ من يدٍ","فتحت لدينِ اللهِ باباً مُوصَدا",10,"د",2,0],["خَلُصَتْ للنبيِّ مِنكَ خِلالٌ","أفعمتْ نَفْسَهُ هَوىً وودادا",11,"د",2,0],["خَلُصتَ خُلُصَ التِبرِ مِن عِلَّةِ","الضَنى وَأَشبَهتَ مِنهُ عِلَّةً بِشُحوبِ",12,"ب",1,1],["خَلَصتُ مِن سَبَراتٍ في السَباريتِ","وَرُبَّ يَومٍ كَريتٍ دونَ تَكريتِ",13,"ت",1,1],["خَلِّصيني مِن ضَنكِ ما أَنا فيهِ","وَاِطرَحيني لِمَنكَرٍ وَنَكيرِ",14,"ر",1,0],["خَلَصَت مِن بَناتِها وَبَنيها","فَهيَ بَينَ النِساءِ مِثلُ البَتولِ",15,"ل",1,0],["خَلَصَتْ لَهُ الْيُمْنَى وَعَمَّ ثَلاثَةً","مِنْهُ الْبَيَاضُ إِلَى وَظِيفٍ أَجْرَدِ",16,"د",1,0],["خَلصت مِنها وَنَحنُ فيها","مِثل العَصافيرِ في الفِخاخِ",17,"خ",1,0],["خلصت نفسك بالتحكيم منخدعا","وأنت أولى بها من سائر الفطر",18,"ر",1,0],["خُلصاءِ سَعيِكَ في الجْهاد وإخوةٍ","لكَ في الوفاءِ المحضِ والإِيثار",19,"ر",1,0],["خَلَصَ النعيمُ لهم فهم من رقةٍ","وغضارةٍ بيضُ الوجوه وِسام",20,"م",1,0],["خلَصْتِ كما خَلصَ ابنُ \" القُيون \"","تَرعرَع في النار ثمَّ استوى",21,"ا",1,0],["خلصت..؟ ماعاد... أقاوم صدك.. أو جوره","القلب.....؟ قدهو.. بيموت.. او غيبتك...؟ قبره",22,"ر",2,0],["خلُصتَ خُلوصَ التِّبرِ من عِلّة الضنى","وأشبهتَ منهُ علة ً بشحوبِ",23,"ب",1,1],["خلصك من الدلف تايحطك تحت المزراب","بين حانا ومانا ضاعت لحانا",24,"ن",2,0],["خلِّصونى من ظَبيكم أو أنادى","بالذي يُنقذ الأسارَى ويفدى",25,"د",2,0],["خلص الهوى لك واصطفتك مودَّتي","حتّى حذرتُ عليك من أبويكا",26,"ك",2,0],["خَلِّصوني مِن كَفِّ حَجّامِكُم هَ","ذا فَقَد عَزَّ مِن يَدَيهِ الخَلاصُ",27,"ص",1,1],["خَلِّصْ جُوَيْرَكَ مِنْ حُبُولٍ أَوْلَغَتْ","فِيهِ الْمُدَى فَغَدا حَليفَ قِتالِهَا",28,"ل",3,0],["خَلَّصْتَ مِنْ هُوَى الْهَوَى مَنْ قَدْ بَدَا","لَكَ رَبَّنَا إِخْلاَصُهُ وَخُلُوصُهُ",29,"ص",2,0],["خلّصه ممّا ساء كن كافلَهُ","فأنت في أموره كافي لَهُ",30,"ه",1,0],["خلّصتنا من قيودِ الظالمينَ وقد","ذقنا الرّدى والبلايا من سُيوفهم",31,"م",1,0],["خلصت خلوصَ التبرِ كرّر سبكهُ","في جاحمٍ من فادح التخريبِ",32,"ب",1,0],["خلصلت روحه فسال ضياء","وطوى طينه سجل الرغاب",33,"ب",1,0],["خلَصَتْ سَريرتُه وسائرهمْ","قد نافَقُوا غِشّاً فما نَفقوا",34,"ق",3,0],["خَلَصْنا نَجِيّاً في نَدِيٍّ من الكَرى","ونحن بأسرارِ الصّبابةِ نَنْتَجِي",35,"ج",2,0],["خلَصْنَ غداةَ البَيْنِ من شَبَكِ الهوى","وألقَيْنَ أطرافَ الحبالِ البتائت",36,"ت",1,0],["خَلَصَ الهَوى لمَّا انقضَت أسبابُهُ","فِيها فصِرتُ أحبُّها في اللَّهِ",37,"ه",1,0],["خلصتُ من خَدعاتِ الأَعينِ النُّجلِ","إنِّي إذاً لَشديدُ المكرِ والحِيَلِ",38,"ل",1,1],["خلَّصك الدهرُ من الناس لي","من بعدِ تَركاضي وتَطوافيا",39,"ي",2,0],["خَلِّصهُ لي يا دهرُ وامضِ بمن","يقتادُ واخلُصْ أنتَ من ذمِّي",40,"م",2,0],["خَلصتَ خلوص التبرِ منها مسلَّمَّاً","عليك وميضٌ صادعٌ ولهيبُ",41,"ب",1,0],["خلِّ صباّ يموت وجداً ويحيا","بوصالٍ من الغواني وصدِّ",42,"د",1,0],["خلصت بنار الشمس مهجةُ تبرها","والتبر يخلصهُ لظى السبَّاك",43,"ك",1,0],["خَلِّص بِجاهِ الوَصلِ قَلبَ مُتَيَّمٍ","غَمَزَ الصُدودُ عَلَيهِ أَعوانَ الضَنى",44,"ن",2,0],["خلصت سلافة ما أقول من القذى","لما تولت عصرها الأعصار",45,"ر",1,0],["خلصهم بجاهه","مشفعاً فيما سأل",46,"ل",1,0],["خلصت كل قبيلة من ضدها","لما التوت وتعقدت عقدانها",47,"ن",3,0],["خَلصتُ خلوصَ التِّبرِ ضوعفَ سبكُهُ","وَطاحَتْ بهِ أَقذاؤُه وشوائبُهْ",48,"ب",2,0],["خلصتها مني ومن","غيري بتشديد ولين",49,"ن",1,0],["خلص محبتك التي هي فيك من","دعوى الوجود تفز بفتح الباب",5