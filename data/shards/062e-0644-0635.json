{"poems":[[55,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[95,"هانت معالم مات سيدها","https://www.aldiwan.net/poem11139.html","أحذ الكامل"],[95,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11164.html","الخفيف"],[74,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[47,"إني لأحمد ناظري عليكا","https://www.aldiwan.net/poem34270.html","عموديه"],[68,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[68,"ولما رأينا المنع منكم سجية","https://www.aldiwan.net/poem38780.html","الطويل"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[71,"أنا لو كنت مقلا","https://www.aldiwan.net/poem29288.html","مجزوء الرمل"],[76,"وحسام بكف أشوس أجرى","https://www.aldiwan.net/poem12931.html","الخفيف"],[107,"أنخ البعير فقد بلغت المسجدا","https://www.aldiwan.net/poem44013.html","الكامل"],[107,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[83,"خلصت خلص التبر من علة","https://www.aldiwan.net/poem61548.html","الطويل"],[48,"خلصت من سبرات في السباريت","https://www.aldiwan.net/poem22206.html","البسيط"],[48,"ذكرتني عقوبة من إلهي","https://www.aldiwan.net/poem22732.html","الخفيف"],[48,"الفتى قد رأى اليقين ولكن","https://www.aldiwan.net/poem23262.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43838","البسيط"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[92,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[112,"العبرة","https://www.poetsgate.com/ViewPoem.aspx?id=8374",""],[83,"خلُصتَ خُلوصَ التِّبرِ من عِلّة الضنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10971&r=&rc=12",""],[128,"علمك بعمان قرية","https://www.aldiwan.net/poem23740.html","البسيط"],[146,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[208,"إني لأحسد مقلتي عليكا","https://www.aldiwan.net/poem53210.html","الكامل"],[239,"خلصوني من كف حجامكم ه","https://www.aldiwan.net/poem31906.html","الطويل"],[241,"كم ذا تقرطسني بسمر نبالها","https://www.aldiwan.net/poem18851.html","الكامل"],[241,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[263,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[274,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[309,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[332,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[368,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[368,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[368,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[375,"لا تحسبوا صيداء حين تغيرت","https://www.aldiwan.net/poem56994.html","الكامل"],[375,"خلصت من خدعات الأعين النجل","https://www.aldiwan.net/poem57198.html","الكامل"],[461,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[461,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[461,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[467,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[467,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[471,"يا من هو الغصن الرطيب إذا انثنى","https://www.aldiwan.net/poem59606.html","الكامل"],[518,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[518,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[518,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[554,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[561,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[561,"نسب المحبة أقرب الأنساب","https://www.aldiwan.net/poem34931.html","الكامل"]],"verses":[["خَلَصَ النَجيُّ مُشاوِراً","قَلباً عَلى النَجوى كَتوما",0,"م",2,0],["خَلُصَتْ لِوَجْهِ الخَيْرِ نِيَّتُهَا","فَزَكَا مِنَ الذِّكْرَى تَزَوُّدِهَا",1,"د",3,0],["خَلُصَتْ مِنْ دَمٍ وَرُدَّتْ لِمَاءٍ","ثُمَّ أَضْحَتْ رُوحاً بِفِعْلِ الزَّمَانِ",2,"ن",1,0],["خلَّصت رزقهم من كيدِ كائدهم","وغبت عنهم فلا والله ما تركوا",3,"ك",3,0],["خلَصَ الهَوَى لَك ،واصْطَفَتْكَ مَوَدَّتي","حَتَّى أَغارَ عَلَيْكَ مِنْ مَلَكيْكَا",4,"ك",2,0],["خَلُصتُ مِنَ الأَهوالِ لَمّا لَقيتُهُ","فَبِتُّ مَنيعاً وَالخُطوبُ شَوائِخُ",5,"خ",1,0],["خَلَصنا وَأَسقَطنا التَجَمُّلَ بَينَنا","فَلا سَيِّدي يُعطي وَلا عَبدُهُ يُهدي",6,"د",2,0],["خَلُصَتْ خلائِقُهُ ولَم يَعْلَقْ بها","جَبْرِيّةٌ لم يَرْضَها الجبّارُ",7,"ر",1,0],["خَلُصَ العالمُ جمعاً","مِنْ يميني ويساري",8,"ي",1,0],["خَلَّصتُهُ نارُ الطَبيعَةِ سَبكاً","وَأَسالَت لُجَينَهُ وَنُضارَه",9,"ر",2,0],["خلصوا على يده فيا لكِ من يدٍ","فتحت لدينِ اللهِ باباً مُوصَدا",10,"د",2,0],["خَلُصَتْ للنبيِّ مِنكَ خِلالٌ","أفعمتْ نَفْسَهُ هَوىً وودادا",11,"د",2,0],["خَلُصتَ خُلُصَ التِبرِ مِن عِلَّةِ","الضَنى وَأَشبَهتَ مِنهُ عِلَّةً بِشُحوبِ",12,"ب",1,1],["خَلَصتُ مِن سَبَراتٍ في السَباريتِ","وَرُبَّ يَومٍ كَريتٍ دونَ تَكريتِ",13,"ت",1,1],["خَلِّصيني مِن ضَنكِ ما أَنا فيهِ","وَاِطرَحيني لِمَنكَرٍ وَنَكيرِ",14,"ر",1,0],["خَلَصَت مِن بَناتِها وَبَنيها","فَهيَ بَينَ النِساءِ مِثلُ البَتولِ",15,"ل",1,0],["خَلَصَتْ لَهُ الْيُمْنَى وَعَمَّ ثَلاثَةً","مِنْهُ الْبَيَاضُ إِلَى وَظِيفٍ أَجْرَدِ",16,"د",1,0],["خَلصت مِنها وَنَحنُ فيها","مِثل العَصافيرِ في الفِخاخِ",17,"خ",1,0],["خلصت نفسك بالتحكيم منخدعا","وأنت أولى بها من سائر الفطر",18,"ر",1,0],["خُلصاءِ سَعيِكَ في الجْهاد وإخوةٍ","لكَ في الوفاءِ المحضِ والإِيثار",19,"ر",1,0],["خَلَصَ النعيمُ لهم فهم من رقةٍ","وغضارةٍ بيضُ الوجوه وِسام",20,"م",1,0],["خلَصْتِ كما خَلصَ ابنُ \" القُيون \"","تَرعرَع في النار ثمَّ استوى",21,"ا",1,0],["خلصت..؟ ماعاد... أقاوم صدك.. أو جوره","القلب.....؟ قدهو.. بيموت.. او غيبتك...؟ قبره",22,"ر",2,0],["خلُصتَ خُلوصَ التِّبرِ من عِلّة الضنى","وأشبهتَ منهُ علة ً بشحوبِ",23,"ب",1,1],["خلصك من الدلف تايحطك تحت المزراب","بين حانا ومانا ضاعت لحانا",24,"ن",2,0],["خلِّصونى من ظَبيكم أو أنادى","بالذي يُنقذ الأسارَى ويفدى",25,"د",2,0],["خلص الهوى لك واصطفتك مودَّتي","حتّى حذرتُ عليك من أبويكا",26,"ك",2,0],["خَلِّصوني مِن كَفِّ حَجّامِكُم هَ","ذا فَقَد عَزَّ مِن يَدَيهِ الخَلاصُ",27,"ص",1,1],["خَلِّصْ جُوَيْرَكَ مِنْ حُبُولٍ أَوْلَغَتْ","فِيهِ الْمُدَى فَغَدا حَليفَ قِتالِهَا",28,"ل",3,0],["خَلَّصْتَ مِنْ هُوَى الْهَوَى مَنْ قَدْ بَدَا","لَكَ رَبَّنَا إِخْلاَصُهُ وَخُلُوصُهُ",29,"ص",2,0],["خلّصه ممّا ساء كن كافلَهُ","فأنت في أموره كافي لَهُ",30,"ه",1,0],["خلّصتنا من قيودِ الظالمينَ وقد","ذقنا الرّدى والبلايا من سُيوفهم",31,"م",1,0],["خلصت خلوصَ التبرِ كرّر سبكهُ","في جاحمٍ من فادح التخريبِ",32,"ب",1,0],["خلصلت روحه فسال ضياء","وطوى طينه سجل الرغاب",33,"ب",1,0],["خلَصَتْ سَريرتُه وسائرهمْ","قد نافَقُوا غِشّاً فما نَفقوا",34,"ق",3,0],["خَلَصْنا نَجِيّاً في نَدِيٍّ من الكَرى","ونحن بأسرارِ الصّبابةِ نَنْتَجِي",35,"ج",2,0],["خلَصْنَ غداةَ البَيْنِ من شَبَكِ الهوى","وألقَيْنَ أطرافَ الحبالِ البتائت",36,"ت",1,0],["خَلَصَ الهَوى لمَّا انقضَت أسبابُهُ","فِيها فصِرتُ أحبُّها في اللَّهِ",37,"ه",1,0],["خلصتُ من خَدعاتِ الأَعينِ النُّجلِ","إنِّي إذاً لَشديدُ المكرِ والحِيَلِ",38,"ل",1,1],["خلَّصك الدهرُ من الناس لي","من بعدِ تَركاضي وتَطوافيا",39,"ي",2,0],["خَلِّصهُ لي يا دهرُ وامضِ بمن","يقتادُ واخلُصْ أنتَ من ذمِّي",40,"م",2,0],["خَلصتَ خلوص التبرِ منها مسلَّمَّاً","عليك وميضٌ صادعٌ ولهيبُ",41,"ب",1,0],["خلِّ صباّ يموت وجداً ويحيا","بوصالٍ من الغواني وصدِّ",42,"د",1,0],["خلصت بنار الشمس مهجةُ تبرها","والتبر يخلصهُ لظى السبَّاك",43,"ك",1,0],["خَلِّص بِجاهِ الوَصلِ قَلبَ مُتَيَّمٍ","غَمَزَ الصُدودُ عَلَيهِ أَعوانَ الضَنى",44,"ن",2,0],["خلصت سلافة ما أقول من القذى","لما تولت عصرها الأعصار",45,"ر",1,0],["خلصهم بجاهه","مشفعاً فيما سأل",46,"ل",1,0],["خلصت كل قبيلة من ضدها","لما التوت وتعقدت عقدانها",47,"ن",3,0],["خَلصتُ خلوصَ التِّبرِ ضوعفَ سبكُهُ","وَطاحَتْ بهِ أَقذاؤُه وشوائبُهْ",48,"ب",2,0],["خلصتها مني ومن","غيري بتشديد ولين",49,"ن",1,0],["خلص محبتك التي هي فيك من","دعوى الوجود تفز بفتح الباب",50,"ب",1,0]]}