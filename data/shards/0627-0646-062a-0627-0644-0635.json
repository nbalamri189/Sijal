poetsgate.com/ViewPoem.aspx?id=198568",""],[5458,"العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=72384",""],[5470,"معزوفة السرو","https://www.poetsgate.com/ViewPoem.aspx?id=11002",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[402,"ماذا تعيضك من صباك","https://www.poetsgate.com/ViewPoem.aspx?id=36030",""],[5956,"قدَرٌ عليك بأن تُخان دواما","https://www.poetsgate.com/ViewPoem.aspx?id=193214",""],[5956,"واعدتني والخلف طبعُ \"المؤمنِ\"","https://www.poetsgate.com/ViewPoem.aspx?id=194007",""],[5956,"لما سرحنا في شحيم","https://www.poetsgate.com/ViewPoem.aspx?id=194279",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[6213,"حبّات المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81913&r=&rc=88",""]],"verses":[["أنت الصّديقُ دفنتُ أكرمَ صُحبةٍ","فيهِ وأصدقَ ذِمّةٍ وجوارِ",0,"ر",1,0],["أَنْتَ الصَّفِيُّ لِمنْ صَفَا","أَنْتَ الوَفِيُّ لِمَنْ رعَاكْ",1,"ك",1,0],["أنتَ الصدوقُ بوَعْدِه","لمجانبٍ ومُضاربِ",2,"ب",1,0],["أَنتَ الصَؤولُ بَلا خَيلٍ وَلا دَهَشٍ","أَنتَ القَؤُولُ بِلا عِيٍّ وَلا حَصَرِ",3,"ر",1,0],["أنت الصراط المستقي","مُ من الصراط المستقيم",4,"م",1,0],["أنتِ الصباحُ وغيرُكِ المِصباحُ في","نظري ولستُ إذا جحدتُ بمُفلِح",5,"ح",1,0],["أنت الصباح ذكاؤه تلتاح إذ","تلتاح أنت وأنت أنت ضُحاه",6,"ا",2,0],["أَنتَ الصّحيحُ فكمْ تكو","ن لمن يحبّك مُمرضا",7,"ض",2,0],["أنتَ الصَبُورُ على ذَمِّ تُصادِفُهُ","في مَعرضِ المدحِ ذو حِلمٍ عن التُهَمِ",8,"م",1,0],["أنت الصديق وإن بعدت","وصاحب الشيم الرضية",9,"ي",2,0],["أنت الصدوق بفعله ومقاله","في مدح من كملت جميع خصاله",10,"ه",1,1],["أنت الصفي إذا الأخوان قد كدروا","أنت الوفي إذا ما صاحب خانا",11,"ن",2,0],["أنت الصباحُ فما يضرُّ مؤَمّلٌ","أَلا يقيسَ سناكَ بالنبراس",12,"س",1,0],["أنت الصفيُّ كأنما","قطَّرتَ ماءٍ معين",13,"ن",1,0],["أَنتَ الصِراط المُستَقيم وَسالم","من رام نَهجك وَالمنكب نادم",14,"م",1,0],["أنت الصبور وأنت خير بقيةٍ","ولأنت يا ابن الأكرمين أديب",15,"ب",1,0],["انتَ الصَفا وعليكَ أَبني بِيعتي","كيما تكونَ وطيدة البُنيانِ",16,"ن",1,0],["أَنْتَ الصَّباحُ فَمَزِّقْ لَيْلَ كُفْرِهِمُ","وَاصْبِرْ وَرَابِطْ فَلِلأَعْمالِ نِيَّاتُ",17,"ت",1,0],["أنت الصدوق الَّذي يسموالورى شرفاً","لَم يأَتِ وعدك مطلٌ ثم أعذارُ",18,"ر",1,0],["أنت الصديقة والرقيقة","لي ودادك يعذرُ",19,"ر",1,0],["أنتِ الصلاةُ بمحرابِ السماء ِ وكمْ","أهديتِ للذكرِ ذكراً مورقاً رطبا",20,"ب",2,0],["أنتَ الصديقُ ، إليكَ كلَّ مَوَدّةٍ","إنّي فقيدُكَ إذ تغيبُ ثواني",21,"ن",2,0],["أَنْتِ الصُّمُودُ الَّذِي ظَلَّتْ صَلَابَتُهُ","رَمْزَاً لِمَنْ قَالَهَا بِالْقَلْبِ : \" أَهْوَاكِ \"",22,"ك",1,0],["انت الصباح لليل طال غيهبه","ان تشرقي تتباعد دونك الظلم",23,"م",1,0],["أَنتِ الصَغيرةُ مَازَالَتْ تُلاعبُني","تِلكَ الأصَابعُ في أَعمَاقِهَا القُبَلُ",24,"ل",1,0],["أنت الصباحاتُ في الإشراقِ طالعةٌ","وأنتَ في الليلِ في عيني أماسيها",25,"ي",3,0],["أنت الصواعق إنْ أعلنتَ نقمتها","وقسورُ الغاب مستاءٌ ومنفعلُ",26,"ل",1,0],["أنتِ الصبيحة والمليحة والضحى","أنت ِالثريا نجمة شماء",27,"ا",2,0],["أنتَ الصَّبَاحُ فُنُونُهُ وفُتُونُهُ","فأجعَل صَبَاحَكَ ضِحكَةً تَتعَالَى",28,"ل",2,0],["انْتِ الصهيباء لاسكر تعاقرني","ترمين كالطيف لا ينصادُ بالمقلِ",29,"ل",1,0],["أنت الصفي لما صفا","أنت الوفي لمن رعاك",30,"ك",1,0],["أنت الصفوحُ كمصطفانا أحمدٍ","وهو المَنار لمن يسير أماما",31,"م",2,0],["أنت الصديق جنانُ عدْنٍ نفسها","لكنَّ بُعدَك عن لِقاي مُجَنِّني",32,"ن",2,0],["أنت الصديق من المهيمن نعمة","نَثرتْ على صدر السماء نجوما",33,"م",2,0],["أنت الصبورُ على الإنسان ترحمُهُ","حتى رأيتك تحمي رِعْدةَ الحَمَلِ",34,"ل",1,0],["أنت الصبابة في أسمى معانيها","أنت الحفيف وأنت الغصن والزهَر",35,"ر",1,0]]}