{"poems":[[112,"سابع المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=36761",""],[112,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=8393",""],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107320","الطويل"],[4702,"الوقت ياعزام بانت غوايبه","https://www.poetsgate.com/ViewPoem.aspx?id=155114",""],[4702,"فايف ستار","https://www.poetsgate.com/ViewPoem.aspx?id=155209",""],[4702,"ترفّعي ياكلمتي لاتكلمت","https://www.poetsgate.com/ViewPoem.aspx?id=155322",""],[5198,"في نصرة رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=135209",""],[5198,"بيت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=136097",""],[5370,"ماني شماليه","https://www.poetsgate.com/ViewPoem.aspx?id=85916",""],[5764,"رجلي وبابك","https://www.poetsgate.com/ViewPoem.aspx?id=191426",""]],"verses":[["اليا تجملّنا .. خذينا ... الاصيله","واليا أبتلينا بالخطا ؟ نصبح .آفات",0,"ت",1,0],["اليا تجملّنا .. خذينا ... الاصيله","واليا أبتلينا بالخطا ؟ نصبح .أأأفات",1,"ت",1,0],["إِليَّ أَتى مِنكُم نَسِيجُ فَرِيدَةٍ","مِنَ النَظمِ قَد فاقَت جُمَاناً وَعَسجَدا",2,"د",2,0],["اليا تراكم بالسما ... ليل تدحمه","مدّت له الصحرا كفوفٍ عطايبه",3,"ب",2,0],["اليا تباعدنا صرفنا الملايين","واليا التقينا نجني الربح مليار",4,"ر",1,0],["اليا تغذّا بالمراجل تقدّمت","والا يجيه من الردى له سمي",5,"م",2,0],["اليا تكلّم فيك خبل مخفوفي","صوّرك فاوراق المجلات تصوير",6,"ر",1,0],["اليا تخيلت وجهك طل فجر جديد","لو ترحل الشمس م اسأل راحت الشمس وين",7,"ن",1,0],["إليا تذكرت الموادع وحقّقت","((سِيده)) يديني وسّعن جيب ثوبي",8,"ب",2,1],["‏الياتذكرت من تمسي وتصحابك","‏كن أغلب احزان خلق الله تشملني",9,"ن",2,0]]}