ة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[45,"مَنٌّ مِنَ الله مَشْكُورٌ، وَإحسانُ","https://www.poetsgate.com/ViewPoem.aspx?id=31793",""],[45,"أأفاق صَبٌّ مِنْ هَوىً، فأُفِيقَا","https://www.poetsgate.com/ViewPoem.aspx?id=32851",""],[51,"وَلع الزمانُ بأن يحرِّكَ ساكِناً","https://www.poetsgate.com/ViewPoem.aspx?id=30806",""],[105,"من لي بأجنحة العواصف مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54914&r=&rc=84",""],[105,"كذب الوشاة وأخطأ اللوام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54893&r=&rc=63",""],[31,"لإتني، إن كنتَ ثقفاً شاعراً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18961&r=&rc=224",""]],"verses":[["لا تُنكِروا السَيلَ إِذا كُنتُمُ","عَلى طَريقِ اللَجِبِ الهاطِلِ",0,"ل",1,0],["لا تَنظُرِ الباغي لِقُربى وَاِرمِهِ","بِالذُلِّ وَاِقطَع ما عَلَيهِ يُعَوِّلُ",1,"ل",1,0],["لا تَنشُدَنَّ الدارَ بَعدَهُمُ","إِنّي عَلى الإِقواءِ أَعرِفُها",2,"ف",3,0],["لا تُنكِري هَذا النُحولَ أَما","نَفسي تَذوبُ عَليكَ مِن نَفسي",3,"ي",1,0],["لا تَنظُرا غَيرَ وَعدِ السَيفِ آوِنَةً","مَن لَم يَرِس بِذُبابِ السَيفِ لَم يَرِسِ",4,"س",1,0],["لا تَنظُروا الجاني لِمَحوِ ذُنوبِهِ","بِمُلَفَّقاتِ تَنَصُّلٍ وَمَعاذِرِ",5,"ر",1,0],["لا تَنفُرُ الحَسناءُ مِن مَسّي وَلا","تُثنى إِذا مُدَّت إِلى أَرَبٍ يَدي",6,"د",2,0],["لا تُنكِرَنَّ مِنَ الزَمانِ غَريبَةً","إِنَّ الخُطوبَ قَلِيبُها لا يَنزَحُ",7,"ح",1,0],["لا تُنكِري حُسنَ صَبري","إِن أَوجَعَ الدَهرُ ضَربا",8,"ب",2,1],["لا تُنكِرُ المَوتَ لَها شَرابا","وَلا تَعافُ الصَبِرَ المُذابا",9,"ب",2,0],["لا تُنْطَقُ العَوْراءُ فيهمْ وبهِمْ","يَجْتَنِبُ الجاهِلُ إهْداءَ الخَنى",10,"ا",1,0],["لا تَنفَعُ الصّلواتُ مَنْ هوَ ساحِبٌ","ذَيْلَ الضّلالِ وعنْ هَواهُ أزْوَرُ",11,"ر",1,0],["لا تُنْكِروا منّي الحَنينَ فإنّما","برَتِ البَرايا نَفْخَةٌ معَ تسْوِيَهْ",12,"و",3,0],["لا تَنهَ عَن خُلُقٍ وَتَأتيَ مِثلَهُ","عارٌ عَلَيكَ إِذا فَعَلتُ عَظيمُ",13,"م",1,0],["لا تَندُبيني فَإِنّي","أَقضي وَتَحيا بِلادي",14,"ي",1,0],["لا تَنسَ عَيشاً تَوَلّى","ما بَينَ شَرحٍ وَمَتنِ",15,"ن",1,0],["لا تَنْدُبَنِّي لِلعَظَا","ئِمِ بَعْدَهَا لا تَنْدُبَنِّي",16,"ن",2,0],["لا تَنْقَضِي بِيَ حِجَّةٌ إِلاَّ وَبِي","أَسَفٌ عَلَى خِدْنٍ مِنَ الأَخْدَانِ",17,"ن",1,0],["لا تُنْكِرُوا عَذلِي هَذَا فَمَعْذِرَتِي","جُرْحٌ بِقَلْبِي دَامَ لَيْسَ يَلْتَئِمُ",18,"م",1,0],["لا تنفع الناس مساعيهم","إذا الجُدود انقلبت عاثره",19,"ر",2,0],["لا تَنسَ حاجَتَنا لاقَيتَ مَغفِرَةً","قَد طالَ مُكثِيَ عَن أَهلي وَعَن وَطَني",20,"ي",1,0],["لا تَنسَ حِلمَكَ إِنَّ مالَكَ مَعهُمُ","قَدَرٌ وَلَستَ بِسابِقٍ ما يُقدَرُ",21,"ر",1,0],["لا تُنكِرُ التَيمُ يَوماً أَن يَكونَ لَهُم","سُؤرُ العَشِيِّ وَشُربُ التابِعِ الكَدِرُ",22,"ر",1,0],["لا تُنشَدُ الحُمرُ الأَوالِفُ فيهُمُ","إِذ لا تُرَوَّحُ بِالعَشِيِّ بِهامُ",23,"م",1,0],["لا تُنكِروا يا بَنيهِ ما أَقولُ فَلَن","تُنسى التِراتُ وَلا إِن حالَ شَيخُكُمُ",24,"م",1,0],["لا تَنفُري يا ناقَ مِنهُ فَإِنَّهُ","شَرّابُ خَمرٍ مِسعَرٌ لِحُروبِ",25,"ب",1,0],["لا تُنكِرَنَّ قُرَيشٌ فَضلَ صاحِبَنا","سَعدٍ وَما في مَقالي اليَومَ مِن أَوَدِ",26,"د",1,1],["لا تنكِروا حمرةَ الأظافرِ من","فلانَ والقملُ منه منسرب",27,"ب",1,1],["لا تنكر المدحة الحسنى وقد قرنت","بشاهدٍ من معاليه ومشهود",28,"د",1,0],["لا تنسَ يا مولايَ قمحيَّة","لمعشرٍ حاموا على أفقها",29,"ه",2,1],["لا تنكر المعشوق في خدّه","دم الشهيد الصابر المغرم",30,"م",1,1],["لا تنس رسم العيد في العي","د الذي يختال حسنا",31,"ن",2,1],["لا تَنْجُوَنْ منكم فَراريجُهُ","لا وَهَبَ المُنْجي لها الواهبُ",32,"ب",1,0],["لاتنكروا الإدلالَ من وامقٍ","وجَّهَ تلقاءكُمُ المطلبا",33,"ب",2,0],["لا تَنْطِقنَّ الدهرَ في مَحفلٍ","واعضُض على الكَثْكَث والأَثلبِ",34,"ب",1,0],["لا تنس أن اللّه قد وَعَدَ الندى","أن لا تخون وليَّهُ الأمداد",35,"د",1,0],["لا تنتبذْ عنهم فما عنهمُ","لطالبِ الحظِّ الجزيل انتباذْ",36,"ذ",1,0],["لا تنسَ روحَ الله فيك وأنها","جُعِلت لتصلِح منك كلَّ عُوارِ",37,"ر",1,0],["لا تُنكرا جزعي يا صاحبيَّ على","ما فات والصبُّ إما هام معذور",38,"ر",1,0],["لا تنكريني فإنني رجلٌ","شَيَّد مجدي ربيعةُ الفرَس",39,"س",1,0],["لا تنزلنَّ بمنزلٍ مُتكوِّفٍ","وتنحَّ عنه إلى المحَلِّ الشَّاحط",40,"ط",1,0],["لا تنتجع صيفة لها وهجٌ","حامٍ فما في المصيف منتجع",41,"ع",1,0],["لا تنسيَنّهُمُ فإنَّ لديهمُ","شوقاً وشوقاً للحديثِ إليكا",42,"ك",2,0],["لا تَنفُسا عبرة أجودُ بها","فلستُ أبكي بها على الدِّمنِ",43,"ن",1,0],["لا تُنيلي جوارحاً ما تَمَنَّتْ","وتُنيلي جوارحاً حِرْمانا",44,"ن",2,0],["لا تُنكرنّ من المصائبِ ما أتى","حتى كأنك كنت منها آمنا",45,"ن",2,0],["لا تَنثَني في الرَوضِ أَغصانُ الشَجَر","حَتّى تُدَغدِغُها النَسائِمُ في السَحَر",46,"ر",1,1],["لا تَنظُرِ الأَضواءَ في حُجرَتي","وَاِنظُر إِلى الظَلماءِ في مُهجَتي",47,"ي",1,0],["لا تَنسَ ما بَيني وَبَي","نَكَ مِن عُهودٍ باقِيَه",48,"ي",2,0],["لا تُنكِروا خَفَقانَ قَل","بي وَالحَبيبُ لَدَيَّ حاضِر",49,"ر",1,0],["لا تنطفي برياحِ الإِ","رهاقِ أَو بالحُسامْ",50,"م",1,0],["لا تنس توفيقا فتوفيق له","في ظل موقفه لسان مرهف",51,"ف",1,0],["لا تنقبض ان قلت جدك لم يكن","في الاصل الا قرد غاب يرتع",52,"ع",1,0],["لا تنكروا باللَه اعظامي له","انا لي بابطال الزمان غرام",53,"م",1,0],["لا تنبذوه فما علمتم بالذي","تزجى الحياة من الغيوب أمامها",54,"م",3,0],["لا تنادوا الحصون والسفن وادعوا ال","علم ينشئ لكم حصونا وسفنا",55,"ن",2,0],["لا تنهين الثاكلات عن البكا","فلعل في ذرف الدموع شفاءها",56,"ا",3,0],["لا تنثنى عن محياك القلوب هوى","إن عارض الذهب الأبصار يثنيها",57,"ي",3,0],["لا تنقضى سنة إلاّ ولى ولد","وأنت يا ربّ من ألفين لم تلد",58,"د",1,0],["لا تُنادِم غَيرَ مَأمونٍ كَريم","إِنَّ عَقلَ البَعضِ في كَفِّ النَديم",59,"م",1,0],["لا تَنثَني الآرامُ عَن قاعِهِ","وَلا بَناتُ الشَوقِ عَن شِعبِهِ",60,"ب",2,0],["لا تُنكِرَنَّ رَحيلي عَنكَ في عَجَلٍ","فَإِنَّني لِرَحيلي غَيرُ مُختارِ",61,"ر",1,1],["لا تُنكري يا سَلْمَ لينيَ ربَّما","يعتاقُ عيرٌ هَمَّ بالنَّزَوانِ",62,"ن",1,0],["لا تنظروا يا مجانينَ العقول إِلى","خُبْثِ الإناء فإنَّ الطِيبَ في العَسَلِ",63,"ل",1,0],["لا تَنْسَ عهدِي وإن طالَ الزمانُ به","فشرُّ ما صَحِبَ الإنسانُ من غَدَرا",64,"ر",2,0],["لا تنكري أنّي تغيَّر شيمتي","فالرمحُ قد يَنْأدُّ منه كعوبُ",65,"ب",1,0],["لا تَنظُرَنَّ إِلى الفَيّاضِ مِن صِغَرٍ","في السِنِّ وَاِنظُر إِلى المَجدِ الَّذي شادا",66,"د",2,0],["لا تُنَقِّب عَنِ الصِبا فَخَليقٌ","إِن طَلَبناهُ أَن يَعِزَّ وُجودُه",67,"د",2,0],["لا تُنكِرَن مِن جارِ بَيتِكَ أَن طَوى","أَطنابَ جانِبِ بَيتِهِ أَو قَوَّضا",68,"ض",2,0],["لا تَنَكَّرتُ في الوِصالِ وَإِن أَظ","هَرتَ لي ظالِماً جَفاءً وَبُغضا",69,"ض",2,0],["لا تَنتَضوهُ بِأَن تَروموا خُطَّةً","عَسراءَ تُعيِ الطالِبينَ لُحوقا",70,"ق",2,0],["لا تَنسَ لِلأَبلَقِ المَحبوكِ رَوحَتُهُ","بِمَن أَظُنُّكَ تَهواهُ وَتَعشَقُهُ",71,"ق",2,0],["لا تَنتَقِص لِوَلِيِّ العَهدِ أُبَّهَةٌ","وَلا يَكُن مِنهُ لِلأَيّامِ إِذعانُ",72,"ن",1,0],["لا تَنكِحَن بَعدي فَتى نَمِرِيَّةً","مُزَمَّلَةً مِن بَعلِها لِبِعادِ",73,"د",1,1],["لا تنادي الرجال من عبد شمسٍ","لا تنادي.. لم يبق إلا النساء",74,"ا",2,0],["لا تنثني يبسا وهل تهتدي","شمائل البان إلى النبع",75,"ع",1,0],["لا تُنْكِرا فَرطَ سَقامي إنما","حَمَلْتُ عن أجفانِها بَعضَ السَّقَمْ",76,"م",1,0],["لا تُنْكِري خَفَقانَ قلبٍ خافقٍ","نَفَرَتْ به غِيدُ الظِّباءِ النُّفَّرِ",77,"ر",1,0],["لا تُنْكري جَزَعَ الشَّجيِّ فإنَّه","لم يأتِ يومَ الجِزعِ منهُ بمُنكَرِ",78,"ر",1,0],["لا تَنظُرَنَّ إِلى الهَوى وَاِنظُر إِلى","رَيبِ الزَمانِ بِأَهلِهِ ما يَصنَعُ",79,"ع",1,0],["لا تَنسَ وَاِذكُر سَبيلَ مَن هَلَكا","سَتَسلُكُ المَسلَكَ الَّذي سَلَكا",80,"ك",2,1],["لا تَنسَ حِلمَكَ حينَ يَقرَعُكَ الأَذى","مِن كُلِّ مَن يَجني عَلَيكَ وَيَجبَهُ",81,"ه",1,0],["لا تَنفَعُ الخَمسَةُ الأَسماءُ مُحدِقَةً","لَدَيكَ إِلّا إِذا ما كُنتَ سادِسَها",82,"ه",2,0],["لا تَنقَضوا ذِمَمَي بَعدَ الوَفاءِ بِها","إِنَّ الكِرامَ لَدَيها تُحفَظُ الذِمَمُ",83,"م",1,0],["لا تَنطِقَنَّ عَنِ الهَوى","يا مَن يُعَنَّفُ في الهَوى",84,"و",2,1],["لا تَنسِبَنَّ إِلى الغِربانِ بَينَهُمُ","فَذاكَ بَينَ غَدَت غِربانُهُ الإِبِلُ",85,"ل",1,0],["لا تُنكِروا فَرَقي مِن بَعدِكُمُ","إِنَّ الفِراقَ لَمُشتَقٌّ مِنَ الفَرَقِ",86,"ق",1,0],["لا تنكرنَّ الشمس عند غروبها","أوَ مَا نعمت بِدِفئها وظلالها",87,"ل",3,0],["لا تنكري داءً نحلتُ به","فبِسُقْم طرْفِك سُقْم جثماني",88,"ن",2,0],["لا تنكرِ الظُّلمَ من خودٍ مدلَّلَةٍ","في ظَلْمِها الدرُّ بالمسواكِ قد ظُلما",89,"م",2,0],["لا تُنكري أنَّكِ حوريَّةٌ","فَنفَحَةُ الجنَّةِ نَمَّتْ عليك",90,"ك",1,0],["لا تَنسَ تِسعَةَ أَشهُرٍ أَنضَيتَها","دَأباً وَأَنضَتني إِلَيكَ وَنَيِّفا",91,"ف",2,0],["لا تَنتَسِب قَد حَوَيتَ الفَخرَ مُجتَمِعاً","وَالذِكرَ إِذ صِرتَ مَنسوباً إِلى حَسَدي",92,"ي",1,0],["لا تُنكِري هَمّي فَإِنّي زائِدي","حَزماً حِضارُ النائِباتِ وَشومُها",93,"م",3,0],["لا تَنشِجَنَّ لَها فَإِنَّ بُكاءَها","ضَحِكٌ وَإِنَّ بُكاءَكَ اِستِغرامُ",94,"م",1,0],["لا تُنكِري عَطَلَ الكَريمِ مِنَ الغِنى","فَالسَيلُ حَربٌ لِلمَكانِ العالي",95,"ي",1,0],["لا تَنسَيَن تِلكَ العُهودَ فَإِنَّما","سُمّيتَ إِنساناً لِأَنَّكَ ناسي",96,"س",2,0],["لا تُنكِروا ضَربي لَهُ مِن دونِهِ","مَثَلاً شَروداً في النَدى وَالباسِ",96,"س",1,0],["لا تَنسَ مَن لَم يَنسَ مَدحَكَ وَالمُنى","تَحتَ الدُجى يَزعُمنَ أَنَّكَ ذاكِرُه",97,"ر",2,0],["لا تُنكِرَن أَن يَشتَكي ثِقلَ الهَوى","بَدَني فَما أَنا مِن بَقِيَّةِ عادِ",98,"د",1,0],["لا تُنكِري مِنهُ تَخديداً تَجَلَّلَهُ","فَالسَيفُ لا يُزدَرى إِن كانَ ذا شُطَبِ",99,"ب",1,0],["لا تنكروا النفرةَ مِنْ مثلِهِ","فأيُّ ظبيٍ وَيْكَ لا ينفرُ",100,"ر",1,0],["لا تَنالانِ ذَلِكَ الوَصلَ مِنها","أَو تَنالا السَماءَ بِالأَسبابِ",101,"ب",1,0],["لا تُنكِري شِيَمَ النُّفوسِ وأَبْشري","بِأَحَبِّ مُنْقَلَبٍ وخيرِ مآلِ",102,"ل",1,0],["لا تُنكروا الدَّمَ في المَصارع يلتقي","إنّ الرّجالَ بمثل ذلكَ سادوا",103,"د",3,0],["لا تُنكري يا مِصرُ حُسْنَ بَلائنا","إنّا لَقومٌ صَادِقونَ كِرامُ",104,"م",1,0],["لا تَنعمُ الأَرواحُ في عَليائِها","إلا إذا شَقِيَتْ بها الأشباحُ",105,"ح",1,0],["لا تنامِي للعوادي وادأبي","واذهبي طامحةً في المُزدحَمْ",106,"م",1,0],["لا تنكروا ما شَهِدنا قبل مولدِكم","لقد دعاكم فلبَّت مِنكمُ الصُّوَرُ",107,"ر",1,0],["لا تُنكروا شَغفَ الغُزاةِ بأُمّةٍ","شُعِفتْ بطول تَنافرٍ ونضالِ",108,"ل",1,0],["لا تُنكري عِظَةً يُريكِ سُطورَها","زاهي النُقوشِ وَشامِخُ البُنيانِ",109,"ن",1,0],["لا تنكروا وقضاءُ اللهِ يُرسِلُهُ","ما كانَ من دَهَشٍ جَمٍّ وإطراقِ",110,"ق",1,0],["لا تنهضُ الهِمَمُ الكِبارُ بغيرِه","سبباً ولا تَسمُو النُّفوسُ الحُوَّمُ",111,"م",1,0],["لا تُنكروا حُبَّ النبيِّ لآلِهِ","وديارِهِ الأولى ولا تَتَأسَّفُوا",112,"ف",3,0],["لا تَنْقُضوا العهدَ إنّ اللّهَ مُنزِلُه","على لسانِ رَسو