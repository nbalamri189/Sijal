لشقِيقُ شِقاق",136,"ق",1,0],["لا تَنسَيَن ذِكري على لَذَّةِ ال","كأسِ وطَوفٍ بالخَذوفِ النَّحوص",137,"ص",1,0],["لا تَنَاَمَنَّ كُلَّ يَومِكَ جَهلاً","وتَذَكَّر وحادِثِ التَّذكيرا",138,"ر",2,0],["لا تُنْكِرُ الْكَاعِبُ الْحَسْنَاءُ مَنْطِقَهُ","وَلا يُعَادُ عَلَى قَوْمٍ فَيُبْتَذَلُ",139,"ل",1,0],["لا تنكِرُوا الأَنَّاتِ فِي أَوْتَارِي","لَمْ يَبْقَ لِي فِي العَيْشِ مِنْ أَوْطَارِ",140,"ر",1,1],["لاَ تَنْكِرِي فَضْلاً بَدَا","كَالصُّبْحِ نمَّ بِهِ الضِّيَاءْ",141,"ا",2,0],["لاَ تَنْتَهِي صَفْوَاؤُهُ إِلاَّ","نِيلٍ تَجَدَّدَ مِنْ شَتِيتِ مَسَارِبِ",142,"ب",1,0],["لا تُنالُ العُلا بلَيْت ولكنْ","وعُكوفِ الفَتَى على مِرْآتهْ",143,"ت",2,0],["لا تَنشُروا الأزهارَ حولَ ضريحه","فخلاله ينفَحْنَ في أنحائه",144,"ا",3,0],["لا تنثني عن غاية","والموتُ يهتف: لا براح",145,"ح",1,0],["لا تندُبي شهداءَكِ الأبرارَ، بل","غنِّي على أجداثِهم، وترنَّمي!",146,"م",2,0],["لا تَنْصِبَنَّ لهُ حِبالَ مُعانِدٍ","فَتُرَى بِكَفَّة ِ آفة ٍ مَحْبُولا",147,"ل",2,0],["لا تُنكروا قلبي الخَفوقَ فانما","هي مهجةٌ قد عُلِّقت بشُفوفه",148,"ف",2,0],["لا تنتهون ولن ينهى ذوي شططٍ","كالطعن يذهب فيه الزيت والفتل",149,"ل",1,0],["لا تَنْتَقِضْ لِوَليّ العَهْدِ أُبّهَةٌ،","وَلا يكُنْ منْهُ، للأيّامِ، إذْعانُ",150,"ن",1,0],["لا تَنْتَضُوهُ بِأنْ تَرُومُوا خِطّةً","عَسْرَاءَ تُعْيِي الطّالِبِينَ لُحوقَا",151,"ق",2,0],["لا تُنكرن من المصائبِ منا أتى","حتى كأنك كنت منها آمنا",152,"ن",2,0],["لا تنكبوها بالحماية أمة ً","يقضي على أعقابكم أن تنكبا",153,"ب",2,0],["لا تنشد العهد المؤكد بيننا","النيل عهدٌ دائمٌ وذمام",154,"م",1,0],["لإتني، إن كنتَ ثقفاً شاعراً،","عن فتى ً أعوجَ، اعمى ، مختلفْ",155,"ف",1,1]]}