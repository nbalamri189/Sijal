an/poem/94579","الطويل"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122441","الطويل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67623","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73203","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83451","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120246","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120467","الوافر"],[4767,"مفاصلي","https://www.poetsgate.com/ViewPoem.aspx?id=180914",""],[5136,"هنيت بالإقبال والنصر","https://www.poetsgate.com/ViewPoem.aspx?id=121574",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5362,"بدت وهي حمراء مثل الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=170374",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5582,"أَوَجْهُ أُمَيْمٍ ذاكَ شَفَّ بِهِ السِّتْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=63513",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5736,"قشب الذنوب","https://www.poetsgate.com/ViewPoem.aspx?id=208468",""],[5790,"لمهيار مصرٍ أسجل الفضل عندنا","https://www.poetsgate.com/ViewPoem.aspx?id=111915",""],[5845,"سقاكَ الحيا الوسميُّ ربعاً تأبداً","https://www.poetsgate.com/ViewPoem.aspx?id=198489",""],[5852,"وبالبيداء لما أن تلاقت","https://www.poetsgate.com/ViewPoem.aspx?id=52881",""],[6069,"وما جاء كلب الروم إلا ليحتوي","https://www.poetsgate.com/ViewPoem.aspx?id=105643",""],[520,"لكل مقام في علاك مقال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577597",""],[5957,"ياحبيبي النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82404&r=&rc=39",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6259,"أبا الفضل طال الليل أم خانني صبري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59424&r=&rc=72",""],[6344,"دوّامة المعنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87976&r=&rc=16",""]],"verses":[["فَوَلّى وَوَلَّيتَ الجِيادَ طِلابَهُ","وَسالَت مُروجٌ بِالقَنا وَشِعابُ",0,"ب",1,0],["فولّتْ وقد أبْقَتْ بقَلبي عَلاقَةً","تمرُّ بِها الأيّامُ وهْوَ مَقيلُها",1,"ل",3,0],["فوَلَّتْ على ذُعْرٍ وبالنَّفْسِ ما بِها","منَ الكَرْبِ لا لُقِّيتَ في حادِثٍ كَرْبا",2,"ب",2,0],["فوَلّتْ حِذاراً تستَغيثُ من الرّدى","بأظْلافها والليلُ يُلْقي المَراسِيا",3,"ي",2,0],["فَوَلَّوا سِراعاً وَالقَنا في ظُهورِهِم","تَشُكُّ الكُلى بَينَ الحَشا وَالخَواصِرِ",4,"ر",1,0],["فَوَلّى وَلَم يَطمَع وَفي النَفسِ حاجَةٌ","يُرَدِّدُها مَردودَةً بِإِياسِها",5,"س",3,0],["فَوَلَّيتُ مَخزوناً وَقُلتُ لِصاحِبي","أَقاتِلَتي لَيلى بِغَيرِ قَتيلِ",6,"ل",1,0],["فَوَلَّينَ يَذرينَ العَجاجَ كَأَنَّهُ","عُثانُ إِجامٍ لَجَّ فيها اِشتِعالُها",7,"ل",3,0],["فوَلّى على الأعقاب يحبو وقد دَرى","وللّه دَرّى أنني أنا غالبه",8,"ب",2,0],["فَوَلَّوهُ الظُهورَ وَأَسلَموهُ","بِمَلحَمَةٍ إِذا ما النِكسُ خاما",9,"م",2,0],["فَوَلَّوا لِلقَنا وَالبيضِ فيهِم","وَفي جيرانِهِم نَهلٌ وَعَلُّ",10,"ل",1,0],["فَوَلَّينَ عَنكَ يُفَدَّينَها","وَيَرفَعنَ مِن ذَيلِها ما اِنسَحَب",11,"ب",1,0],["فَوَلّى فَأَوفى عاقِلاً رَأسَ صَخرَةٍ","نَمى فَرعُها وَاِشتَدَّ مِنها القَواعِدُ",12,"د",1,0],["فَوَلَّوا سِراعاً كَوَخدِ النَعا","مِ لَم يَكشِفوا عَن مَلَطٍّ حَصيرا",13,"ر",2,0],["فَوَلَّت نَطيحاً كَبشُها وَجُموعُها","ثُباتٍ عِزينَ ما تُلامُ صُفوفُها",14,"ف",3,0],["فوليُّهُ لِوليّهِ","أبداً بنافلةٍ بشيرُ",15,"ر",1,0],["فوليُّهُ وعْلٌ على جبلٍ","وعدوُّهُ جَزَرٌ على وضمِ",16,"م",1,0],["فَوَلَّيتُ عَنها وَهَي تَكبو لِعَقرِهِ","يُباشِرُهُ مِنها ذُقونٌ وَحَوصَلُ",17,"ل",1,0],["فَوَلَّينا الحُكومَةَ ذا سُجوفٍ","أَخاً دِنيا لَهُ طَرفٌ كَليلُ",18,"ل",1,0],["فوليد تسجد الدنيا له","وسواه في زوايا المهملين",19,"ن",1,0],["فَوَلوَلَت وَعَضَّتِ التُرابا","وَجَمَعَت لِلمَأتَمِ الأَترابا",20,"ب",2,0],["فَوَلّى وَما وَلّى نِظامُ جُنودِهِ","وَيا شُؤمَ جَيشٍ لِلفَرارِ يُرَتِّبُ",21,"ب",1,0],["فَوَلّى وَأَعطاكَ اِبنَهُ وَجُيوشَهُ","جَميعاً وَلَم يُعطِ الجَميعَ لِيُحمَدا",22,"د",2,0],["فَوَلّى بِأَشياعِهِ الخَرشَنِيُّ","كَشاءٍ أَحَسَّ بِزَأرِ الأُسودِ",23,"د",1,0],["فَوَلَّوا بَينَ ذي روحٍ مُفاتٍ","وَذي رَمَقٍ وَذي عَقلٍ مُطاشِ",24,"ش",1,0],["فَوَلَّت تُريغُ الغَيثَ وَالغَيثَ خَلَّفَت","وَتَطلُبُ ما قَد كانَ في اليَدِ بِالرِجلِ",25,"ل",1,0],["فَوَلَّت كَأَنَّ البَينَ يَخلُجُ شَخصَها","أَوانَ تَوَلَّت مِن حَشايَ وَأَضلُعي",26,"ع",2,0],["فَوَلَّت أُصَيلالاً وَقَد كانَ بَعدَها","ضَفادِعُ ما نالَت مِنَ العَينِ خُزَّرا",27,"ر",2,0],["فوَلَّتْ تِجارُ الحَمْدِ تَنْشُرُ حمدَها","وقد سَعِدَتْ بالجُودِ منك جُدودُها",28,"د",3,0],["فَوِلدانٌ تُديرُ بِذا مُداماً","وَغِلمانٌ تُديرُ بِذا كِتابا",29,"ب",2,0],["فَوَلّى وَما أَبقى الرَدى مِن حُماتِهِ","لَهُ غَيرَ أَسآرِ الرِماحِ الذَوابِلِ",30,"ل",1,0],["فولٌ بفلسٍ غداءً","واللبس سحق قطيفَهْ",31,"ف",2,1],["فَولّيتمُ الأدبارَ وارتدَّ جَمعُكم","شراذمَ شتَّى كالشَّعاعِ المُبدَّدِ",32,"د",1,0],["فَوَّلى وأَدبَر أَدراجَهُ","وقَد باءَ بالظُلمِ مَن كانَ ثم",33,"م",1,0],["فَوَلّى بِها جَذلانَ يَنفُضُ رَأسَهُ","كَصاحِبِ غُنمٍ ظافِرٍ بِالتَمَوُّلِ",34,"ل",1,0],["فَوَلَجتُ فيهِ صابِراً","وَخَرَجتُ مِنهُ مُثَقَّفا",35,"ف",2,0],["فَوَلّوا وَقَد ذاقوا الَّتي يَعرِفونَها","فَكانَ لَهُم عُذرٌ وَكانَ لَنا فَخرُ",36,"ر",1,0],["فَوَلَّوْا وَسوءُ الظَّنِّ يَلْوِي وُجُوهَهُمْ","فَتَحْسِبُها صُوراً وما هِيَ صُورُ",37,"ر",1,0],["فَوَلَّى أمْرَها ابنُ أبِي مُلَيْحٍ","فَأَصْبَحَ لا هَزِيلَ وَلاَ سَمِينا",38,"ن",2,0],["فَوَلَّدَتِ السِياطُ لَها هَديراً","كَتَرجيعِ الفُحولِ الهائِجاتِ",39,"ت",1,0],["فَوَلّى بِرُعبٍ قَبلَ وَقتِ انتِصافِهِ","كَأَنّا أَلَحنا عِندَ ذاكَ لَهُ الفَجرا",40,"ر",2,0],["فَوَلَّيتُ ذا مَجدٍ وَأُعطيتُ مِسحَلاً","حُساماً بِهِ شَغبُ الأَلَدِّ نُهوضُ",41,"ض",1,0],["فولّى وأعطاك ابنه وجيوشه","جميعاً ولم يعط الجميع لتحمدا",42,"د",2,0],["فوَلَّتْ ولِلْمِسْكِ مِن ذَيْلِهَا","على الأَرْض خَطٌّ كظَهْرِ الشُّجَاعِ",43,"ع",1,0],["فَوَلَّت حَياءً ثُمَّ أَرخَت لِثامَها","وَقَد نَثَرَت مِن خَدِّها رَطِبَ الوَردِ",44,"د",1,0],["فَوَلَّيْتَ لَمْ يَعْصِمْكَ مُدَّخَرُ الْقُوَى","ولمْ يَتَمَالَكْ حِلمُكَ المُتَوقِّرُ",45,"ر",1,0],["فَوَلُّوْا وَدُسْنَاهُمْ ببِيضٍ صَوَارِمٍ","سَوَاءٌ عَلَيْنَا حِلفُها وصَمِيمُهَا",46,"م",3,0],["فولَّتْ ولى دمعٌ يسيلُ كأنّه","نَدَى كفِّ سلطان بن سيف هُو البحرُ",47,"ر",1,0],["فَوَلَّتهُ الإمارَةَ وهوَ أهلٌ","لها إِذَا كَانَ وَالِيَها وَلِيدَا",48,"د",2,0],["فَوَلّى يَحمَدُ الجُردَ المَذاكي","وَلَيسَ لِسَيفِهِ أَثَرٌ حَميدُ",49,"د",1,0],["فَوَلّى وَلَولا حُسنُ عَفوِكَ لَم يَئِل","وَلا عادَ عَنهُ بِالنَجاةِ مُبَشِّرُ",50,"ر",1,0],["فَوَلَّت بِأَمرِ اللَهِ لا عَن مَخافَةٍ","وَقَد يَحضُرُ الرَوعَ الذَليلُ فَيُنصَرُ",50,"ر",1,0],["فَوَلّى عَظيمُ الرومِ وَالرَأيُ ما رَأى","مُصيخاً إِلى داعِ السَلامَةِ مُهطِعا",51,"ع",2,0],["فولجت ما بين الأسنة والظُّبا","حتى فرجت إليه كل زحام",52,"م",1,0],["فولت تسارقني لحظها","وتومي إليَّ بما أفهم",53,"م",1,0],["فَوَلّوا فَمُنكَبٌّ عَلى أُمِّ رَأسِهِ","لَدُن ذاكَ لَم يَنفُق وَآخَرُ نافِقُ",54,"ق",1,0],["فَوَلَّت حُماةُ القَومِ خَيلاً وَلَم تَزَل","بَنُو الحَربِ في يَومِ التَلاقي تُحاوِلُ",55,"ل",1,0],["فَوَلّوا وَراحَ الرُكنُ مِنهُم كَأَنَّهُ","صَريعُ عُقارٍ باتَ مِنها مُجَشَّما",56,"م",2,0],["فَوَلوَلَت وَوَلوَلَت","وَلي وَلي يا وَيلَ لِي",57,"ل",2,0],["فولَّت وهْي هاربة وقالتْ","تَيبَّبْ لاعتذارك في اعتذاري",58,"ر",2,0],["فَوَلدت لآدمٍ بَنينا","وكانَ شيثٌ خيرَهم يَقينا",59,"ن",2,0],["فولّتْ وآماقي تجودُ بمائِها","ولي حُرَقٌ في مُهجتي ورَسِيسُ",60,"س",1,0],["فولت تسحُ الدمعَ درّاً نفائساً","كما جاد بالأموالِ سيّدنا البَحْرُ",61,"ر",1,0],["فولوا على الأعقاب حين رماهم","فأغشاهم من قبضة من كثاكث",62,"ث",1,0],["فولوا إلى الوفراء والقيظ لافح","لكي يشبعوا الأطماع والكل أشعب",63,"ب",1,0],["فولوا ولم يلووا فلا الابن منقذ","أباه ولا يلوي على إبنه الأب",63,"ب",1,0],["فُولاذُكِ استَثمَرتِه من هامِها","وفَرشتِ من