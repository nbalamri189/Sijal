,"مجزوء الكامل"],[365,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[365,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[378,"حي الديار ديار جلق واستزِد","https://www.aldiwan.net/poem66875.html","الكامل"],[378,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[394,"المجد أجمع ما حوته يميني","https://www.aldiwan.net/poem53666.html","الكامل"],[417,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[417,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[430,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[433,"هجر الحب وإن أصبح جارا","https://www.aldiwan.net/poem12474.html","الرمل"],[444,"لله في ذا الخلق أح","https://www.aldiwan.net/poem56058.html","عموديه"],[453,"لرياض جلق تحت نهر يزيد","https://www.aldiwan.net/poem13732.html","الكامل"],[454,"بشراك هذا العم عيسي","https://www.aldiwan.net/poem61242.html","مجزوء الكامل"],[459,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[459,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[459,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[462,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[465,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[480,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[480,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[483,"أحديقة رقّمت بوشي أزاهر","https://www.aldiwan.net/poem24435.html","عموديه"],[501,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[516,"قد أتتني تلك اليد البيضاء","https://www.aldiwan.net/poem12004.html","الخفيف"],[516,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[539,"أتركوه يهذي فإن كلامه","https://www.aldiwan.net/poem47945.html","عموديه"],[539,"كل هذا خوف فقر ولقد","https://www.aldiwan.net/poem48196.html","عموديه"],[552,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[559,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[559,"بحمد الله خلاق الوجود","https://www.aldiwan.net/poem34612.html","الوافر"],[559,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[563,"أمسى الحبيب ابن الغزال منعما","https://www.aldiwan.net/poem52560.html","الكامل"],[576,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"]],"verses":[["فَتَقوا بِشَزرِ الطَعنِ أَكمامَ العُلى","وَهُمُ جِذاعُ قَبائِلٍ لَم يَقرَحوا",0,"ح",3,0],["فَتَقَضَّتْ شَبيبَتِي بَيْنَ شَكْوَى","وَتَجَنٍّ وَهِجْرَةٍ وَعِتابِ",1,"ب",1,0],["فَتَقَوَّ يَرهَبكَ القَوِي","يُ وَهُن يُلازِمكَ الصَغار",2,"ر",1,0],["فَتَقَيَّدَت فيهِ الصِحافَةُ عَنوَةً","وَمَشى الهَوى بَينَ الرَعِيَّةِ مُطلَقا",3,"ق",2,0],["فَتَقَلَّبتُ في الشَقاءِ زَماناً","وَتَنَقَّلتُ في الخُطوبِ الجِسامِ",4,"م",1,0],["فتقضى لا يصحب الحمد ذكرا","ه وجاءت أيام الاستقلال",5,"ل",1,0],["فَتَقَضَّى لاَ يَصْحَبُ الحَمْدُ ذِكْرَا","هُ وَلاَحَتْ أَيَّامُ الاِسْتِقْلاَلِ",6,"ل",1,0],["فَتَقبَّلْ مِنْ غَرْسِ نَعْمَاكَ حَمْداً","هُوَ جَهْدٌ يَهْدِيهِ مِنْ إِقْلاَلِ",7,"ل",1,0],["فُتقت كمائم جنحه عن أنجم","سفرت زواهرُهنَّ عن أزهارِ",8,"ر",1,0],["فتقبّل مني تهانئ حرّ","لا يداجي الورى إذا قال شعرا",9,"ر",2,0],["فتَقوى الفتى مَسعاه في طلب العلا","وما خُصَّت التقوى بترك المحرّم",10,"م",1,0],["فتقلبت في نهار وليل","ذا مضلٌ وذاك للناس هاد",11,"د",1,0],["فَتَقَصَّدَت مِنها كَسابِ فَضُرِّجَت","بِدَمٍ وَغودِرَ في المَكَرِّ سُخامُها",12,"م",3,0],["فَتَقومُ ساعَتُنا فَنَلقى طَيِّباً","مَخصاً ضَرائِبُهُ كَريمَ المَحتِدِ",13,"د",1,0],["فتقدحُ فيما بين ضِعفيك حسرةً","كحسرته ليست بخامدةِ الجمر",14,"ر",1,0],["فَتْقاء يذهبُ فيها الفيل منزلقاً","يكاد يسبق منه صدرَه العَجُز",15,"ز",1,0],["فتقبلوا لطفَ الإله وصُنْعَه","بقبول ملطوفٍ له مَصْنوع",16,"ع",1,0],["فتقولون من يرومُ ركوب ال","بحْرِ لا سيَّما مَهَبَّ العقيم",17,"م",1,0],["فَتَقَهقَرَت فَزَعاً فَقالَ لَها","لا تَهلَعي وَاِصغي إِلى حُرِّ",18,"ر",1,0],["فَتَقَلَّد سَيفَ جَدِّكَ عُث","مانَ جَدَّ البيضِ وَالخَذَمِ",19,"م",1,0],["فَتَقُرَّ عاصِفَةُ الظَّلامِ","ويَهْجَعَ الرَّعْدُ الغَضُوبْ",20,"ب",1,0],["فَتَقَدَّمَ اللَيثُ الرَفيعُ جَلالُهُ","وَتَعَرَّضَ الفيلُ الفَخيمُ الشانِ",21,"ن",1,0],["فَتَقَلَّدتَهُ وَكُنتَ خَليقاً","سَلَبَتنا كِلَيكُما الأَيّامُ",22,"م",1,0],["فتقولُ يا نارُ اتْرُكي ليَ ذَا","ولِذَا خُذِي فَتَدينُ للأَمْرِ",23,"ر",1,0],["فَتّقْتُ دَيْجُورَهَا إلى قَمَرٍ","أَثْوابُهُ بالعَفَافِ مُسْتَتِرَهْ",24,"ر",2,0],["فَتَقَ المَسامِعَ بالصَّوابِ ولم","تُنْجِدْ بَديهتَه تَفَكُّرُه",25,"ر",2,0],["فتقرَبُ منك أُنساً بالمعالي","وتبعُدُ من بُعولتِها نِفارا",26,"ر",2,0],["فَتَقوى اللَهِ تُغنيكا","وَإِن سُمّيتَ صُعلوكا",27,"ك",2,0],["فتقبّل طاقةً بالدم","دم والدمع نديه",28,"ي",2,0],["فتقبل على المدى","كل شعر مخلد",29,"د",1,0],["فَتْقُ السَّمَاوَاتِ وَالأَرْضِينَ تَرْتُقُهُ","بِإذْنِ رَبِّكَ حَتَّى عَادَ مُنْسَرِدَا",30,"د",2,0],["فَتَقَ الرياح بفخره فكأنّما","خُضْنا إليه بالمعاطسِ عنبرا",31,"ر",2,0],["فَتَقَ المَدامِعَ أَنَّ لَحدَكِ حَلَّهُ","سَكَنُ الزَمانِ وَمُمسِكُ الأَيّامِ",32,"م",1,0],["فَتَقَبَّلْ شُكْرِي عَلَى حُسْنِ وُدِّ","رُحْتُ مِنْهُ مُقَلَّدَاً بِوِسَامِ",33,"م",1,0],["فَتَقَضَّت لَيلَتي في نِعمَةٍ","مَرَّةً أَلثَمُها غَيرَ حَصِر",34,"ر",1,0],["فَتَقَت عَلى حُكمِ البَشاشَةِ نورَها","وَتَنَفَّسَت في أَوجُهِ الجُلَساءِ",35,"ا",2,0],["فَتَقَ الشَبابُ بِوَجنَتَيها وَردَةً","في فَرعِ إِسحِلَةٍ تَميدُ شَبابا",36,"ب",2,1],["فتقدَّموا يا قومِ لا يقعُدْ بكم","عند اللّقاءِ تهيُّبُ الجُبَناءِ",37,"ا",2,0],["فتُقبِلُ من بَصرى إلى البيتِ مالها","على الضَّعفِ والٍ من حُماةِ المَحارِمِ",38,"م",1,0],["فَتِقتُ بِها جَيبَ كافورَةٍ","مِنَ الأَرضِ جَدوَلُها مُنتَقِش",39,"ش",1,0],["فتقدَّمَا وتنصّبَا وتذلّقَا","وتلطّفَا وتشرّفَا وتحرّفَا",40,"ف",2,0],["فتَقطّعتْ أغمادُها قِطَعاً","وأتَتْ إلَيهِمْ وهيَ تَعتَذِرُ",41,"ر",1,0],["فُتِقَتْ لكم ريحُ الجِلادِ بعنبرِ","وأمدَّكُمْ فَلَقُ الصّباحِ المسْفِرِ",42,"ر",1,1],["فتقاصَروا من بعد ما حكمَ الردى","ومضَى الوَعيدُ وشُبّتِ الهيجاء",43,"ا",2,0],["فَتَقولُ طَوراً ذا فَتىً هَتَفَت","نَفسُ النَصيحِ بِهِ فَلَم يُجِبِ",44,"ب",1,0],["فَتَقَضّى الرَجاءُ مِنها لَقَد صَد","دَ طَبيبي عَنّي وَقَضَّيتُ نَحبا",45,"ب",2,0],["فَتَقَلَّبتُ ساهِراً","مُقشَعِرَّ الذَوائِبِ",46,"ب",1,0],["فَتَقيني بِنَحرِها وَأَقيها","بِقَضيبٍ مِنَ القَنا غَيرِ بالي",47,"ل",2,0],["فتقوم فيها بالسداد حكومة","وتزول عنها دولة الأوغاد",48,"د",1,0],["فَتَقول وَيلي بل وويل عشيرتي","للرزء يا لَيلى وَللخسران",49,"ن",1,0],["فَتَقوم أحفاد لأجداد مضوا","وَتعيد مجد اولئك الأجداد",50,"د",1,0],["فتقذفُ بالنار سوريةً","وترمي بلبنان حرباً سجالا",51,"ل",2,0],["فتقدموا تحت اللواء وقرّبوا","هذي السيوف الداميات عزوبها",52,"ب",3,0],["فَتَقضِي فَلَوْلا أَنَّه كُلُّ ريبَةٍ","وكُلُّ قلِيلٍ مِنْ وَعِيدِكِ مُرْهِبي",53,"ب",2,0],["فَتقاضَ أَضْعَافَ الَّذِي قَدَّمْتَهُ","وَاسْتَسْقِ صَوْتَ العَارِضِ المِدْرَارِ",54,"ر",1,0],["فَتَقَبَّلْ شُكْرَ المُحِبِّ لِمَا أَهْدَيْتَ","مِنْ دُرِّكَ النَّظِيمِ الأَنِيقِ",55,"ق",1,0],["فَتَقَضَّى جِيلٌ فجِيلٌ وَلِلدَّا","ءِ دَوَاءٌ بِفَضْلِ تِلكَ الدَّوَاةِ",56,"ه",1,0],["فتقُومُ الزِّينةُ الكُبْرى بِمَا","بَعدَهُ لا تُذْكَرُ الزِّيناتُ صُغرَا",57,"ر",2,0],["فتقطّعت مهجٌ وفاضت أعين","رمت الخدود بكل أوطَفَ صاد",58,"د",1,0],["فتقلَّدْ إنْ رُمتَ في الحرب نصرًا","مَبدأً ساميًا، ورأيًا سَديدا",59,"د",2,0],["فتقاذفني التّجوال كما","تستاق العاصفة الرملا",60,"ل",2,0],["فتقصيني كعادتها","وأتبعها كعاداتي",61,"ت",2,0],["فتقضى الرجاء منها لقد صدَّ","طبيبي عني وقضيت نحبا",62,"ب",2,0],["فتقلّد سيف جدّك عث","مان جدّ البيض والخدم",63,"م",1,0],["فتقّصيي كعادتها","وأتبعها كعاداتي",64,"ت",2,0],["فتقضى فلولا أنه كل ريبة","وكل قليل من وعيدك مزهبي",65,"ب",2,0],["فَتَقَرَّ العَينُ مِنكُم مَرَّةً","بِاِنبِعاثِ الحُرِّ نَوحاً تَلتَدِم",66,"م",1,0],["فَتَقَدَّمِ الأُمرَاءَ غَيرَ مُنازَعِ","فَوَراءَ زِندِكَ كُلُّ زَندٍ قَد وَرى",67,"ر",2,0],["فتقسّموا قِسمين قسمَ عاقل","عَرف الرشادَ فما استعاض ضلالا",68,"ل",2,0],["فتقتلهم من غير سيف سعوده","وتاخذهم آراؤه أخذ ذى قهر",69,"ر",1,0],["فتقاطرت في الخدّ من كلفي بهم","سرب الدموع فخدّت الخدّا",70,"د",2,0],["فَتَقبّل واِعطِف وكُن لي شفيعاً","يومَ تحتاجُ فضلك الشفعاءُ",71,"ا",2,0],["فَتَّقَت بِالهَجرِ دُروزَ الهَوى","إِذ وَخَّزَتني اِبرَةَ الصَدِّ",72,"د",1,1],["فتقول لي والكأس خصّب كفّها","إنّي لأهوى الضم والتقبيلا",73,"ل",2,0],["فَتَّقْتَ أكمامَ البلاغةِ والنُّهى","عن حكمةٍ لم تُؤْتَها الحُكَماءُ",74,"ا",2,0],["فتقطيبُ حاجبه قال لا","وفترة أجفانه إي نعم",75,"م",1,0],["فتُقضى ديون العاشقين نسيئة","بوكسٍ ودَيني في وفاء وفي نقدِ",76,"د",1,0],["فَتَقتُلَني بَنو خَمرٍ بِذُهلٍ","وَكِدتُ أَكونَ مِن قَتلى الرِياحِ",77,"ح",1,0],["فَتَقطَع لَيلَ العُمرِ بِالأُنسِ وَالغنا","وَنَصعَدُ أَبراجَ الكَواكِبِ في الفَجرِ",78,"ر",1,0],["فَتَقنَعَ لي بِبَيعي ماءَ وَجهي","بِمَنزورِ العَطِيَّةِ بَيعَ غَبنِ",79,"ن",1,0],["فَتَقَنَّعتُ بِاليَسيرِ مِنَ ال","وَصلِ وَما كنُتُ قانِعاً بِاليَسيرِ",80,"ر",1,0],["فَتُقضى لباناتٌ وتُطفَى لواعجٌ","وتَبرُدَ أكبادٌ وتَنضُبَ أدمُع",81,"ع",1,0],["فَتَقتَ لِسانَ الحَمدِ ثُمَّ بَسطتَه","اذا قَبضَ النِكسُ اللِسانَ وَأَقفَلا",82,"ل",2,0],["فَتُقَوِّي ذا الضَّعفَ مِنكَ وتُلفَى","عَن لَيالٍ أصَحَّ هذِي الصِّحَاحِ",83,"ح",1,0],["فتقولُ وَيلي من وداعِكَ يا فتى","هلا ارعَوَيتَ أوِ الرَّحيلُ تأخرا",84,"ر",2,0],["فتقتُ إِلى التنزّه في رياض","معلّقةٍ إِلى الجبلِ المريد",85,"د",1,0],["فتقولُ لي أنتَ الصّبا وأنا الشّذا","فخُذِ الأريجَ وأعطني التلوينا",86,"ن",2,0],["فتقولُ حينَ تراهُ أفتَكَ ضاربٍ","ولشوكةِ الظلَّامِ أكبرَ خاضد",87,"د",1,0],["فتقبل باحترام عددا","منه وانعم باشتراك لا تسل",88,"ل",1,0],["فتقحّمُ الشذَّانِ في أخطارها","غَررٌ بدونِ مرافق وقرينِ",89,"ن",1,0],["فَتقرّرُ السلطانِ ضربةُ لازبٍ","لِنظامهم بِالعدلِ والإحسانِ",90,"ن",1,0],["فَتقدّمت بِالختانِ اِحتشاما","للّذي ختنُه تقدّم هلّه",91,"ل",2,0],["فَتقدَّمَ المتقدّمين إبانة","عَن فضلِه كالعدِّ خلف الأصفرِ",92,"ر",1,0],["فتق بأخ أصفاك محض مودة","تشاكل منها ما بدا والتغيب",93,"ب",1,0],["فَتَقَبَّل مَولايَ حُسنَ ثَنائي","أَنَّهُ جاءَ مِن صَميمِ الجِنانِ",94,"ن",1,0],["فَتَقَبَّل جَزاءَ فَضلِكَ شُكراً","كُلَّ يَومٍ وَساعَةٍ يَتَجَدَّدِ",95,"د",1,0],["فتقبّلها طوافا","حول واديك ا