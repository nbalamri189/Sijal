{"poems":[[55,"لولا يذم الركب عندك موقفي","https://www.aldiwan.net/poem29948.html","الكامل"],[95,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[54,"كن جاهلا أو فتجاهل تفز","https://www.aldiwan.net/poem26876.html","السريع"],[52,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16680","الوافر"],[101,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[124,"لنجي الهم يجتاب الكرى","https://www.aldiwan.net/poem49291.html","الرمل"],[202,"لا تصيخن لتشويق النديم","https://www.aldiwan.net/poem51886.html","الرمل"],[214,"رب أقراص لنا منك جاءت","https://www.aldiwan.net/poem13437.html","المديد"],[398,"يا أبا الفضل لم تأخرت عنا","https://www.aldiwan.net/poem53403.html","الخفيف"],[563,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38142","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71026","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70790","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70682","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101983","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112804","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49578","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107007","الخفيف"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104316","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112401","السريع"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199147","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85136","الخفيف"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130442","الرمل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44654","الخفيف"],[4120,"","https://poetry.dctabudhabi.ae/diwan/poem/142544","الرمل"],[4927,"الباص العذول","https://www.poetsgate.com/ViewPoem.aspx?id=29647",""],[5121,"بُلْبُلٌ وَلَكِنْ","https://www.poetsgate.com/ViewPoem.aspx?id=33586",""],[5277,"أرضُ ابتسامتها","https://www.poetsgate.com/ViewPoem.aspx?id=191235",""],[5277,"قبسٌ من طيف","https://www.poetsgate.com/ViewPoem.aspx?id=191961",""],[5277,"فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=195091",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5431,"وفؤادي مشعشعٌ لا أفولُ","https://www.poetsgate.com/ViewPoem.aspx?id=197691",""],[5736,"أين المفر","https://www.poetsgate.com/ViewPoem.aspx?id=203876",""],[5736,"احتراق شهي","https://www.poetsgate.com/ViewPoem.aspx?id=208875",""],[5853,"الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=175698",""],[5918,"أُحبُّكِ فلتسألي الذَّارياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=177711",""],[5992,"ثمّ أهوى صِنْفٌ من الطيرِ للما","https://www.poetsgate.com/ViewPoem.aspx?id=41829",""],[6125,"سكبتُ مدامعي سوداً فسودا","https://www.poetsgate.com/ViewPoem.aspx?id=212884",""],[6152,"كن جابرا للقلوب","https://www.poetsgate.com/ViewPoem.aspx?id=213151",""]],"verses":[["كَنَجائِبٍ قَعَدَت بِها أَرماقُها","مَحسورَةً فَمَشَينَ بِالأَعراقِ",0,"ق",1,0],["كُنْ جَوْهَراً مِمَّا يُمَحَّ","صُ بِاللَّظَى أَوْ كُنْ تُرَابَا",1,"ب",2,0],["كن جسورا اذا طلبت","فقد فاز من جسر",2,"ر",1,0],["كُن جاهِلاً أَو فَتَجاهَل تَفُز","لِلجَهلِ في ذا الدَهرِ جاهٌ عَريضُ",3,"ض",1,1],["كَنَجمِ الدُجى إِذ لاحَ لا بَل كَأَنَّهُ","سَنا نارِ نَشوانٍ تُشَبُّ وَتَبلُجُ",4,"ج",1,0],["كنجمةٍ في سماء الليل خافقة","تذوب في فلَقٍ للصبح وهّاج",5,"ج",1,0],["كنَجْمِ الرَّجْمِ صُكّ به مَريدٌ","فأبْدَعَ في انجِذامٍ وانعِراج",6,"ج",1,0],["كنجمة قد ضيعت دربها","في خصلات الأسود المعتم",7,"م",1,0],["كنجوم الليل وضاح السنى","بربيعٍ غرد حلو الي",8,"ي",1,0],["كنْ جسيمَ المجد والعليا وإن","كان ما تملكه غير جسيم",9,"م",1,0],["كنجوم قد بدت في سماء","وعليها بهجة وحلاوه",10,"ه",1,0],["كُن جَوابي اِذا قَرَأتَ كِتابي","لا تَقُل لِلرَّسول كانَ وَكُنّا",11,"ن",2,0],["كن جماداً وإذا شئت به","كن نباتاً مثمراً كالبلح",12,"ح",1,0],["كَنُجومِ الأُفقِ تَبدو لِلعَيان","ضَوؤُها مِن مَشرق لِلمَغربِ",13,"ب",1,0],["كُن جاعِلاً لِصَوابِ رَأيِهِ حسناً","وَلا تَكُن جاعِلاً رَأيَ المحبّ خَطا",14,"ط",2,0],["كنجل خميس ذى المكارم ناصرٍ","فتىً بعده عزَّ المثيلُ المماثلُ",15,"ل",1,0],["كنجل صالحٍ الزاكي محمدِ ذو","أضحى به رأسُ مَنُ عاداه مُنْفلِذا",16,"ذ",2,0],["كنَجل سيف بن سلطان الذي عَرَفا","منه الجزاءين قاليه ووافدُه",17,"د",2,0],["كنجوم السما إذا غاب منها","كوكب كان مثله موجودا",18,"د",2,0],["كن جنة دنيا وأخرى سيدي","لي والبنين وشرفونا بالنظر",19,"ر",1,0],["كنجومِ السماءِ يَطْلُعْنَ في الكُتْبِ","وَيَغْرُبْنَ في صُدُور الرجال",20,"ل",1,0],["كنجوم السما رجوم الشياطي","ن وللمهتدين سِرُّ هداها",21,"ا",3,0],["كنجوم السماء تزداد حسناً","كلما ازداد بالسواد دجاها",22,"ا",3,0],["كن جليلا والبس ولو جلد كبش","ما ارتفاع الجليل بالسربال",23,"ل",1,0],["كنجمةٍ في أفقها سابحَه","حتى إذا لاحَ الصّباحُ انزَوَت",24,"ت",1,0],["كن جار كلب وجار الشرة اجتنب","ولو أخا لك من أم يرى وأب",25,"ب",1,1],["كن جوابي يا بهجة الروح حالا","لا تدعني من أدمعي في جوابي",26,"ب",2,0],["كن جوابي تغنم الوا","فر من شكري وحمدي",27,"د",2,0],["كُن جَهولاً وَفي ثيابِك تَزهو","وَتَقدم فَأَنتَ أَعظَمُ قَدرا",28,"ر",2,0],["كنجوم نُثرتْ بين الروابي","في روابي الروح في أطياف بيد",29,"د",1,0],["كَنَجْمَةِ الْقُطْبِ فِيْ لَيْلِ الْغَرِيْبِ إِذَاْ","ضَلَّ الطَّرِيْقَº وَمَلَّ الْمُهْرُ مِنْ كَلَلِ",30,"ل",1,0],["كَنَجْمٍ ثَقِيِبٍ لاحَ فِي الأُفْقِ لامِعاً","تَلاشَى بِلَمْحٍ مِنْ سَمَائِي إِلى الْخُنْسِ",31,"س",1,0],["كنجمةٍ ومضَتْ ألقتْ عباءَتها","لتسترَ الشوقَ ..بالديباجِ..والنّدَما",32,"م",2,0],["كنجمٍ ترامى بالليالي على الدجى","ووجهكَ من مرماكَ صاحٍ وناعسُ",33,"س",1,0],["كنجمةٍ هامستْ أقرانَها سحراً","واضّاحكت..ودموعُ القلبِ في شفتي",34,"ت",2,0],["كنجل بن جرجيس ودحلان إذ هما","قد اقترحا كذباً وإفكاً محرما",35,"م",2,0],["كن جسورا على الرزايا صبورا","تتآخى مع الثبات الحلول",36,"ل",1,0],["كنْ جذوةً للحبِّ يُشعلها النوى","كنْ للقصيدِ لهيبَهُ .. كنْ كالخطرْ",37,"ر",1,0],["كنجم الدجى حين يبكيه ليلٌ","جثا الصبر يبكي بكاء السبايا",38,"ا",3,0],["كن جميلا في جمالٍ خالدٍ","ياجميل القلب في طهر الودق",39,"ق",1,0],["كَنَجْمٍ يُسافرُ لا يَستكينُ","يَجُوبُ لَيالي الدُجىً النائية",40,"ي",2,0],["كنجومٍ تساقطت في استواءٍ","وشبيه الرايات في حين تُعكسْ",41,"س",1,0],["كنجمٍ غاب في أفقِ التَّماهي","كبدرٍ بالمحاقِ أبى صعودا",42,"د",2,0],["كن جابراً لقلوب الخلق محتسبا","وكن بلطفك نورا لا تكن نارا",43,"ر",2,1]]}