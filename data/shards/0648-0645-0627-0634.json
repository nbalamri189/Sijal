{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"لهان الغمد ما بقي الحسام","https://www.aldiwan.net/poem29818.html","الوافر"],[53,"خذي نفسي يا ريح من جانب الحمى","https://www.aldiwan.net/poem30594.html","الطويل"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[77,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[71,"أجل أنا في لون الشبيبة مغرم","https://www.aldiwan.net/poem3957.html","الطويل"],[71,"تحية مشتاق بعيد مزاره","https://www.aldiwan.net/poem3992.html","الطويل"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[82,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[82,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[35,"أبائنة سعدى نعم ستبين","https://www.aldiwan.net/poem38821.html","الطويل"],[93,"بوحي الطعام وإذن المدام","https://www.aldiwan.net/poem9779.html","عموديه"],[54,"لقد عجبت سلمى وذاك عجيب","https://www.aldiwan.net/poem27658.html","الطويل"],[30,"وما شنتا خرقاء واه كلاهما","https://www.aldiwan.net/poem29455.html","الطويل"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[88,"سل الإنكليزي الذي لم يزل له","https://www.aldiwan.net/poem44790.html","الطويل"],[88,"هو الدهر لم يترك مشن غواره","https://www.aldiwan.net/poem45014.html","الطويل"],[88,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[27,"ألا إنما تيم لعمرو ومالك","https://www.aldiwan.net/poem4438.html","الطويل"],[27,"أهاج الشوق معرفة الديار","https://www.aldiwan.net/poem5744.html","الوافر"],[27,"ألا أيها القلب الطروب المكلف","https://www.aldiwan.net/poem5922.html","الطويل"],[47,"ولله عندي في الإسار وغيره","https://www.aldiwan.net/poem25174.html","الطويل"],[47,"أسيف الهدى وقريع العرب","https://www.aldiwan.net/poem25374.html","المتقارب"],[72,"يخديك ذا إسم وفعل مصاب","https://www.aldiwan.net/poem18315.html","الطويل"],[72,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"شكرت مديحي فيك إذ سبق الجدا","https://www.aldiwan.net/poem62981.html","الطويل"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[51,"طرفت عيون الغانيات وربما","https://www.aldiwan.net/poem65922.html","الطويل"],[51,"عزمت على تطليق عرسي لعسرتي","https://www.aldiwan.net/poem66518.html","الطويل"],[70,"وغانية لما رأتني أعولت","https://www.aldiwan.net/poem43018.html","الطويل"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[85,"إلى ابن محمد أهدي كتابي","https://www.aldiwan.net/poem7792.html","الوافر"],[85,"ألا في سبيل الله ذاك الدم الغالي","https://www.aldiwan.net/poem62834.html","الطويل"],[85,"بالله يا نسمات النيل في السحر","https://www.aldiwan.net/poem63666.html","البسيط"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[43,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"قليل لها أني بها مغرم صب","https://www.aldiwan.net/poem10656.html","الطويل"],[45,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[45,"قفا في مغاني الدار نسأل طلولها","https://www.aldiwan.net/poem65590.html","الطويل"],[28,"فإن تفخر بنا فلرب قوم","https://www.aldiwan.net/poem5377.html","الوافر"],[49,"ألا للموت كأس أي كاس","https://www.aldiwan.net/poem62125.html","الوافر"],[80,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[87,"صبوت إلى المدامة والغواني","https://www.aldiwan.net/poem8238.html","الوافر"],[74,"أرقت وقد نام الخلي لنازح","https://www.aldiwan.net/poem12977.html","الطويل"],[74,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[105,"نزيل النيل أين تركت ملكا","https://www.aldiwan.net/poem43074.html","الوافر"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[81,"ترى يا زمان الوصل هل أنت راجع","https://www.aldiwan.net/poem61343.html","الطويل"],[102,"برح بي الشوق فلما طغى","https://www.aldiwan.net/poem33000.html","السريع"],[40,"أقول لصاحبي ومثل ما بي شكاه","https://www.aldiwan.net/poem42306.html","الوافر"],[52,"أدام المهيمن عز الوزير","https://www.aldiwan.net/poem26627.html","المتقارب"],[52,"أيا من مات من شوق","https://www.aldiwan.net/poem26802.html","الهزج"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"وفتيان صدق قد صرفت مطيهم","https://www.aldiwan.net/poem63263.html","الطويل"],[50,"خف لبين ساكن الأعداد","https://www.aldiwan.net/poem63900.html","الرجز"],[46,"إن الأعلاء إن كانوا ذوي رشد","https://www.aldiwan.net/poem21996.html","البسيط"],[46,"توخ بهجر أم ليلى فإنها","https://www.aldiwan.net/poem22179.html","الطويل"],[46,"بني الآداب غرتكم قديما","https://www.aldiwan.net/poem22343.html","الوافر"],[46,"أجل سلاح يتقي المرء قرنه","https://www.aldiwan.net/poem22523.html","الطويل"],[46,"بهاء ليل وإن جنت حنادسه","https://www.aldiwan.net/poem23167.html","البسيط"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[46,"وفرت العارضين ولم يعارض","https://www.aldiwan.net/poem23613.html","الوافر"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141011",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30475","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9918","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42697","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55139","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55087","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43881","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[45,"قِفَا في مَغاني الدّارِ نَسألْ طُلُولَها","https://www.poetsgate.com/ViewPoem.aspx?id=32118",""],[80,"أغُمْرَ الهوى كم ذا تُقَطّعُني عَذْلا","https://www.poetsgate.com/ViewPoem.aspx?id=3585",""],[47,"أَسَيْفُ الهُدَى ، وَقَرِيعَ العَرَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=14643",""],[46,"بني الآداب! غرّتكمْ، قديماً","https://www.poetsgate.com/ViewPoem.aspx?id=18034",""],[85,"ألا في سبيلِ الله ذاكَ الدمُ الغالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9618&r=&rc=108",""]],"verses":[["وَما شِبتُ مِن طولِ السِنينَ وَإِنَّما","غُبارُ حُروبِ الدَهرِ غَطّى سَوادِيا",0,"ي",2,0],["وَما شَكوى المَناهِلِ حينَ تُمسي","مُغَيَّضَةً إِذا بَقِيَ الغَمامُ",1,"م",1,0],["وَما شَرَرٌ تَطاوَحَ عَن زِنادٍ","بِمُفتَقَدٍ إِذا بَقِيَ الضِرامُ",1,"م",1,0],["وَما شَرِبَ العُشّاقُ إِلّا بَقِيَّتي","وَلا وَرَدوا في الحُبِّ إِلّا عَلى وِردي",2,"ي",1,0],["وَما شَكَوتُ لِأَنَّ العِزَّ يُقعِدُني","وَأَنتَ سَيفي وَيَومَ الرَوعِ مَشهودُ",3,"د",1,0],["وَما شَهوَتي لَومَ الرَفيقِ وَإِنَّما","كَما يَلتَقي في السَيرِ ظِلفٌ وَمِخلَبُ",4,"ب",1,0],["وَمَا شَدَا مُنْشِدٌ صبٌّ لِفَرْطِ جَوىً","سَلْ مَا لسَلْمَى بِنَارِ الهَجْرِ تَكْوِينِي",5,"ي",1,0],["وَما شِئْتَ مِنْ رَوْضٍ أَنَاخَ بِهِ الْحَيَا","وَأَزْمَعَ عَنْهُ السَّيْرَ بَعْدَ تَلَوّمِ",6,"م",1,0],["وَمَاشِئْتَ مِنْ فَضْلِ وَلُطْفِ سِيَاسَةٍ","يُطِيعُ بِهَا الْعَاصِي وَتُسْتَنْزَلُ الْعُصْمُ",7,"م",1,0],["وَما شانَهُ لَونُ السَوادِ لِأَنَّهُ","بِغُرِّ الثَنايا وَالخَلائِقِ مُعلَمُ",8,"م",1,0],["وَما شامَ مِن أَعلا المُقَطَّمِ جفنُهُ","سَنا بارِقٍ إِلّا تَوالَت قُطارُهُ",9,"ر",2,0],["وَما شَوقُ مَقتولِ الجَوانِحِ بِالصَدى","إِلى نُطفَةٍ زَرقاءَ أَضمَرَها وَقطُ",10,"ط",1,0],["وَما شَرُّ الثَلاثَةِ أُمَّ عَمرٍو","بِصاحِبِكِ الَّذي لا تَصبَحينا",11,"ن",2,0],["وما شبهت وجه الشمس إلا","بوجهك أيها الملك الهمام",12,"م",1,0],["وَماشِياً مَرِحاً يُلهِيهِ مَوطِنُهُ","أَبَعدَ حِمص تَغُرُّ المَرءَ أَوطانُ",13,"ن",1,0],["وَما شَعَرَت أَنَّ الصِبا إِذ تَلومُني","عَلى عَهدِ عادٍ لِلشَبابِ خَدينُ",14,"ن",1,0],["وما شاق أسماعنا من غناء","له خير وقع بنفس الطروب",15,"ب",1,0],["وَما شَيَّبَتني كِبرَةٌ غَيرَ أَنَّني","بِدَهرٍ بِهِ رَأسُ الفَطيمِ يَشيبُ",16,"ب",1,0],["وَما شَنَّتا خَرقاءَ واهٍ كِلاهُما","سَقى فيهِما مُستَعجِلٌ لَم تَبَلَّلا",17,"ل",2,1],["وما شاقني والطيف يرهب أدمعي","ويسبح في بحر من الليل مُرْبدُ",18,"د",1,0],["وما شأن ذيّاك السفير الذي له","على الجانب الغربيّ قصر مشيّد",19,"د",1,0],["وما شرفُ الدرِ الثمينِ فريدُه","إذا هو لم يَبْرَح بطون مَحَاره",20,"ر",2,0],["وما شهبه إلا مخالب كيده","تمدّ بجوف الليل دامية حجنا",21,"ن",2,0],["وَما شَكَرَت تَيمٌ لِقَومٍ كَرامَةً","وَما غَضِبَت تَيمٌ عَلى مَن يُهينُها",22,"ن",3,0],["وَما شَرِبَت بِذي سَبَخٍ أُجاجاً","وَلا وَطِأَت عَلى رَمَضِ الجِفارِ",23,"ر",1,0],["وَما شَهِدَت يَومَ الإِيادِ مُجاشِعٌ","وَذا نَجَبٍ يَومَ الأَسِنَّةِ تَرعَفُ",24,"ف",1,0],["وَماشاءَ رَبّي غَيرَ نَشرِ مَحاسِني","وَأَن يَعرِفوا ماقَد عَرَفتُ مِنَ الفَضلِ",25,"ل",1,0],["وَما شَكَّكَتنِيَ فيكَ الخُطوبُ","وَلا غَيَّرَتني عَلَيكَ النُوَب",26,"ب",1,0],["وما شئتُ إلاَّ أن أذلُّ عواذِلي","على أنَّ رأيي في هواك صواب",27,"ب",1,0],["وما شكوتُ وما الشكوى إلى بشرٍ","من خلق مثلي والأقدار تصريف",28,"ف",1,0],["وما شكا العُسْرَ بعد اليُسْرِ صاحبُهُم","ولا تَحَوَّل عن رَحْلٍ إلى قَتَبِ",29,"ب",1,0],["وما شِبْلُ ذاكَ الْلَّيْث إلا شَبيهُهُ","وغَيْرُ عجيبٍ أن تَرَى الشبل يأْسَدُ",30,"د",1,0],["وما شافِعي إلا سَماحُك وحدَه","ولا وُصْلَتي إلا المديحُ المجوَّدُ",30,"د",1,0],["وما شكر المداح قومٌ سواكُمُ","ولا حكموا أن يسبق النائلُ الشعرا",31,"ر",2,0],["وما شعر سوى شعري","بمحض الحسب الدَّثر",32,"ر",1,0],["وما شبتُ إلا شيبةً غير أنه","قليلُ قذاةِ العينِ غيرُ قليلِ",33,"ل",1,0],["وما شان نُعْمَى الله وَجْهٌ حَمَلْتَه","تزوّجت النُّعمى به أمْ تَبَنَّتِ",34,"ت",1,0],["وَما شِبتُ إِلّا مِن وَقائِعِ هَجرِها","عَلى أَنَّ عَهدي بِالصِبا لَقَريبُ",35,"ب",1,0],["وما شأْنُ هذا العَدَاءِ العنيفِ","وما شأْنُ هذا الإِخاءِ الوَدودْ",36,"د",1,0],["وما شكا أهل الهوى","من الجوى واللوّم",37,"م",1,0],["وما شرب الملوك ولا استعادوا","كهذى الكأس من هذا النديم",38,"م",1,0],["وَما شَغَلَتهُم عَن هَواها قِيامَةٌ","إِذا اِعتَلَّ رَهنُ المَحبِسَينِ بِأَشغالِ",39,"ل",1,0],["وَما شَجانِيَ إِلّا صَوتُ ساقِيَةٍ","تَستَقبِلُ اللَيلَ بَينَ النَوحِ وَالعَبَرِ",40,"ر",1,0],["وَما شُهَداءُ الحَربِ إِلّا عِمادُها","وَإِن شَيَّدَ الأَحياءُ فيها وَطَنَّبوا",41,"ب",3,0],["وَما شِدتُمُ مِن دَولَةٍ عَرضُها الثَرى","يَدينُ لَها الجِنسانِ تُركٌ وَصَقلَبُ",41,"ب",1,0],["وَمَا شَرَقي بالمَاءِ إلاّ تَذكّراً","لمَاءٍ بهِ أهْلُ الحَبيبِ نُزُولُ",42,"ل",1,0],["وَما شَكَرتُ لِأَنَّ المالَ فَرَّحَني","سِيّانَ عِندِيَ إِكثارٌ وَإِقلالُ",43,"ل",1,0],["وَما شَطَطٌ أَن أُتبِعَ الرُغبَ أَهلَهُ","وَأَن أَطلُبَ الجَدوى إِلى واهِبِ الجَدوى",44,"و",2,0],["وَما شَكَّ قَومٌ أَوقَدوا نارَ فِتنَةٍ","وَسِرتَ إِلَيهِم أَنَّ نارَهُمُ تَخبو",45,"ب",2,0],["وَما شَعَفُ المَشعوفِ إِلّا بَلِيَّةٌ","عَلَيهِ إِذا لَم يُعطَ تَنويلَ شاعِفِ",46,"ف",1,0],["وَما شَكَرَ النَعماءَ مِثلِيَ شاكِرٌ","إِذا قائِلُ الأَقوامِ جازى فَعولَها",47,"ل",3,0],["وَما شَيءٌ بِأَضيَعَ مِن قُشَيرٍ","وَلا ضَأنٌ تَريعُ إِلى خَيالِ",48,"ل",1,0],["وَما شَيءٌ بِأَخلَقَ أَن تَراهُ","قَليلاً مِن أَخي ثِقَةٍ مُؤاسِ",49,"س",1,0],["وما شاءَهُ ذو العرشِ جلّ جلالُهُ","يدقّ وَيَخفَى عن خفيّ التوَهَّمِ",50,"م",1,0],["وما شَرِبت سوى خمرِ التراقي","ولا انتشقتْ سِوَى وَرْدِ الكلومِ",51,"م",1,0],["وما شيّبَ الإنسانَ مثلُ تَغَرّبٍ","يَمُرّ عليه اليومُ منه كَعامِ",52,"م",1,0],["وما شئتُ مما لو عُنيتُ بوَصْفِهِ","سلكتُ إليه كلّ قافيةٍ سبلا",53,"ل",2,0],["وَمَا شُرْبِي الْمُدَامَ هَوىً وَلَكِنْ","عَقَدْتُ بِحَدِّ سَوْرَتِهَا لِسَانِي",54,"ي",1,0],["وَما شاقَني إِلّا وَميضُ غَمامَةٍ","تَطَلَّعَ مِن نَجدٍ فَحَيّا اللِوى رَبعا",55,"ع",2,0],["وَما شاقَني إِلّا حَفيفُ أَراكَةٍ","وَسَجعُ حَمامٍ بِالغُمَيمِ تَرَنَّما",56,"م",2,0],["وَما شِئتَ مِن آراءِ نُجحٍ كَوالِئٍ","تُسَدِّدُ مِن أَطرافِ سُمرٍ كَوالِمِ",57,"م",1,0],["وَما شَقَّ الدَواءُ عَلى مَريضٍ","إِذا ما اِستَأصَلَ الداءَ الوَبيلا",58,"ل",2,0],["وما شُغِفَ المَسودُ بِمِثلِ خُلقٍ","يَكونُ لَدى المُسَوَّدُ مُستَجادا",59,"د",2,0],["وَمَا شَيبُ رَأسِي مِن سِنِينَ تطاولَت","عَلَيَّ وَلَكِن شَيَّبَتنِي الوَقَائِعُ",60,"ع",1,0],["وما شفى داءً ولكنَّما","قلبي شكا البعدَ فعلَّلُتُهُ",61,"ت",2,0],["وَما شاقَ القُلوبَ وَراقَ عَيناً","فَتُجلاهُ كَذِي دَلٍّ رَخيمِ",62,"م",1,0],["وَما شاءَ رَأيُكَ في الحادِثا","تِ قالَ الإِلَهُ لَهُ كُن فَكانا",63,"ن",2,0],["وَما شابَت وَلَكِن شا","بَ في عارِضِها ذَرقُ",64,"ق",1,0],["وما شقّ جيْبَ الحُسنِ إلاّ شقائقٌ","بخدّيكِ مفتوكٌ بهِنّ فواتِك",65,"ك",1,0],["وَما شَرَّفَتني كُنيَةٌ عَرَبِيَّةٌ","وَلا أَكسَبَتني لا سَناءً وَلا فَخرا",66,"ر",2,0],["وَما شَعَرتُ بِالتَجَنّي البادي","حَتّى عَلا صَوتُ أَبي المِقدادِ",67,"د",1,0],["وَما شَفاكَ مِنَ الأَشياءِ تَطلُبُها","إِلّا الأَلِبّاءُ لَو تُلفى الأَلِبّاءُ",68,"ب",3,0],["وَما شامَتِ الهِندِيَّ في الكَفِّ عَنوَةً","وَلَكِن ثَنَتهُ في أَنامِلَ ضارِبِ",69,"ب",1,0],["وَما شُقَراؤُكُم إِلّا ذِئابٌ","تَلَصَّصُ في المَدائِحِ وَالسِبابِ",70,"ب",1,0],["وَما شَرَفُ الإِنسانِ إِلّا عَطِيَّةٌ","حَدَتها اللَيالِيَ وَالقَضاءُ المُسَخَّرُ",71,"ر",1,0],["وَما شِمالي لِخِلٍّ بَل أُجَنِّبُهُ","إِلى الجَنوبِ وَإِن سُقتُ الشَماليلا",72,"ل",2,0],["وَما شَأنُ اللَبيبِ بِغَيرِ سِلمٍ","وَإِن شَهِدَ الوَغى مُتَلَبِّبوهُ",73,"ب",3,0],["وَما شَعرٌ بِرَأسِكَ في عِدادٍ","بِأَكثَرَ مِن ذُنوبِكَ وَالخَطايا",74,"ا",3,0],["وَما شَكِسُ الأَنيابِ شَثنٌ بَنانُهُ","مِنَ الأُسدِ يَحمي مِن تِهامَة وادِيا",75,"ي",2,0],["وَما شاعر العصر الجديد سوى الَّذي","على دولة الشعر القديم تمردا",76,"د",2,0],["وما شكاتي حين شملي جميع","وأنت لي أيكٌ وظلٌّ وريف",77,"ف",1,0],["وما شئت إلاّ أن أدلّ عواذلي","على أنّ رأيي في هواك صواب",78,"ب",1,0],["وما شَبّ ناراً في تِهامةَ سامِرٌ","يدَ الدهرِ إلاّ أبَّ قلبُكَ في سَلْع",79,"ع",1,0],["وما شَرِبَ ابْنُ الشُّرْبِ قَبْلَكَ خَمْرَةً","مِن الذُّلِ بالعَجْزِ الصَّرِيحِ تُصَفّقُ",80,"ق",1,0],["وَما شاقَ قَلبي في الدُجى غَيرُ طائِرٍ","يَنوحُ عَلى غُصنٍ رَطيبٍ مِنَ الرَندِ",81,"د",1,0],["وما شَأني بهِ وَالفَيجُ حَولي","وهَمِّي لَو عَنيتُ به مُصيبي",82,"ب",2,0],["وَمَا شَرَفُ الإِنْسَانِ إِلَّا بِنَفْسِهِ","وَإِنْ كَانَ ذَا مَالٍ تَلِيدٍ وَمُطْرِفِ",83,"ف",1,0],["وَمَا شَهِدَ الأَقْوَامُ قَبْلَكِ سَيِّداً","يُطَاعُ مُطِيعاً قَوْمَهُ وَيَصُولُ",84,"ل",1,0],["وَمَا شُغْلكَ عَنْ فنٍّ","سَبَتْنَا فِيهِ أَشْغَالُكْ",85,"ك",1,0],["وما شاقَنِي مِن شقّ جيبٍ ومَدْمَع","أسيلٍ على خَدٍّ أسيلٍ بمأسَلِ",86,"ل",1,0],["وما شجانيَّ إلاّ صوتُ باخرةٍ","تستعجلُ الركبَ إِيذانا وتأذينا",87,"ن",2,0],["وما شطَّ المعلم أو تجنَّى","ولا هو هام بالعيش الرغيد",88,"د",1,0],["وما شاد هذا صروح السلامِ","ولا اعتاد ذلك سفكَ الدماء",89,"ا",2,0],["وماشٍ إلى قلبِ الحقودِ بِحيلةٍ","يُداوي بها حتى تُسَلَّ السّخائم",90,"م",1,0],["وَمَا شَكَرَ النَّعْمَاءَ مِثْليَ شَاكِرُ","إِذا قَائِلُ الأَقوامِ جَزَى فَعُولَهَا",91,"ل",3,0],["وما شئتُ ممات لو عُنيتُ بوَصْفِهِ","سلكتُ إليه كلّ قافية ٍ سبيلا",92,"ل",2,0],["وما شككتنيَ فيكَ الخطوبُ","ولا غيَّرتني فيكَ النُّوبْ",93,"ب",1,0],["وما شعراؤكم إلاّ ذئابٌ،","تَلصَّصُ في المدائحِ والسِّبابِ",94,"ب",1,0],["وما شغلتهم عن هواها قيامة ٌ","إذا اعتلَّ رهنُ المحسينِ بأشغال",95,"ل",1,0]]}