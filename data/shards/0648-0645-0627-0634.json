,[458,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[458,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[458,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[458,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[458,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[461,"علي المقال الجزل جم ثناؤه","https://www.aldiwan.net/poem15474.html","الطويل"],[461,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[461,"حباه إله العرش جودا ونجدة","https://www.aldiwan.net/poem16115.html","الطويل"],[464,"يقول نديمي والمدام يديرها","https://www.aldiwan.net/poem3202.html","عموديه"],[464,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[464,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[464,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[464,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[468,"جوامع أوهامي تقصر عن قدري","https://www.aldiwan.net/poem59974.html","الطويل"],[470,"أفي كل يوم حبة القلب تقرع","https://www.aldiwan.net/poem4735.html","الطويل"],[470,"يا بشر يا رب محزون بمصرعنا","https://www.aldiwan.net/poem4832.html","البسيط"],[477,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[477,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[482,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[482,"زجاج القلب كأس في زمان","https://www.aldiwan.net/poem24487.html","عموديه"],[495,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[500,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[515,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[538,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[551,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[551,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[551,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[551,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[559,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[564,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[567,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"],[567,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[575,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[575,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[575,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[586,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"]],"verses":[["وَما شِبتُ مِن طولِ السِنينَ وَإِنَّما","غُبارُ حُروبِ الدَهرِ غَطّى سَوادِيا",0,"ي",2,0],["وَما شَكوى المَناهِلِ حينَ تُمسي","مُغَيَّضَةً إِذا بَقِيَ الغَمامُ",1,"م",1,0],["وَما شَرَرٌ تَطاوَحَ عَن زِنادٍ","بِمُفتَقَدٍ إِذا بَقِيَ الضِرامُ",1,"م",1,0],["وَما شَرِبَ العُشّاقُ إِلّا بَقِيَّتي","وَلا وَرَدوا في الحُبِّ إِلّا عَلى وِردي",2,"ي",1,0],["وَما شَكَوتُ لِأَنَّ العِزَّ يُقعِدُني","وَأَنتَ سَيفي وَيَومَ الرَوعِ مَشهودُ",3,"د",1,0],["وَما شَهوَتي لَومَ الرَفيقِ وَإِنَّما","كَما يَلتَقي في السَيرِ ظِلفٌ وَمِخلَبُ",4,"ب",1,0],["وَمَا شَدَا مُنْشِدٌ صبٌّ لِفَرْطِ جَوىً","سَلْ مَا لسَلْمَى بِنَارِ الهَجْرِ تَكْوِينِي",5,"ي",1,0],["وَما شِئْتَ مِنْ رَوْضٍ أَنَاخَ بِهِ الْحَيَا","وَأَزْمَعَ عَنْهُ السَّيْرَ بَعْدَ تَلَوّمِ",6,"م",1,0],["وَمَاشِئْتَ مِنْ فَضْلِ وَلُطْفِ سِيَاسَةٍ","يُطِيعُ بِهَا الْعَاصِي وَتُسْتَنْزَلُ الْعُصْمُ",7,"م",1,0],["وَما شانَهُ لَونُ السَوادِ لِأَنَّهُ","بِغُرِّ الثَنايا وَالخَلائِقِ مُعلَمُ",8,"م",1,0],["وَما شامَ مِن أَعلا المُقَطَّمِ جفنُهُ","سَنا بارِقٍ إِلّا تَوالَت قُطارُهُ",9,"ر",2,0],["وَما شَوقُ مَقتولِ الجَوانِحِ بِالصَدى","إِلى نُطفَةٍ زَرقاءَ أَضمَرَها وَقطُ",10,"ط",1,0],["وَما شَرُّ الثَلاثَةِ أُمَّ عَمرٍو","بِصاحِبِكِ الَّذي لا تَصبَحينا",11,"ن",2,0],["وما شبهت وجه الشمس إلا","بوجهك أيها الملك الهمام",12,"م",1,0],["وَماشِياً مَرِحاً يُلهِيهِ مَوطِنُهُ","أَبَعدَ حِمص تَغُرُّ المَرءَ أَوطانُ",13,"ن",1,0],["وَما شَعَرَت أَنَّ الصِبا إِذ تَلومُني","عَلى عَهدِ عادٍ لِلشَبابِ خَدينُ",14,"ن",1,0],["وما شاق أسماعنا من غناء","له خير وقع بنفس الطروب",15,"ب",1,0],["وَما شَيَّبَتني كِبرَةٌ غَيرَ أَنَّني","بِدَهرٍ بِهِ رَأسُ الفَطيمِ يَشيبُ",16,"ب",1,0],["وَما شَنَّتا خَرقاءَ واهٍ كِلاهُما","سَقى فيهِما مُستَعجِلٌ لَم تَبَلَّلا",17,"ل",2,1],["وما شاقني والطيف يرهب أدمعي","ويسبح في بحر من الليل مُرْبدُ",18,"د",1,0],["وما شأن ذيّاك السفير الذي له","على الجانب الغربيّ قصر مشيّد",19,"د",1,0],["وما شرفُ الدرِ الثمينِ فريدُه","إذا هو لم يَبْرَح بطون مَحَاره",20,"ر",2,0],["وما شهبه إلا مخالب كيده","تمدّ بجوف الليل دامية حجنا",21,"ن",2,0],["وَما شَكَرَت تَيمٌ لِقَومٍ كَرامَةً","وَما غَضِبَت تَيمٌ عَلى مَن يُهينُها",22,"ن",3,0],["وَما شَرِبَت بِذي سَبَخٍ أُجاجاً","وَلا وَطِأَت عَلى رَمَضِ الجِفارِ",23,"ر",1,0],["وَما شَهِدَت يَومَ الإِيادِ مُجاشِعٌ","وَذا نَجَبٍ يَومَ الأَسِنَّةِ تَرعَفُ",24,"ف",1,0],["وَماشاءَ رَبّي غَيرَ نَشرِ مَحاسِني","وَأَن يَعرِفوا ماقَد عَرَفتُ مِنَ الفَضلِ",25,"ل",1,0],["وَما شَكَّكَتنِيَ فيكَ الخُطوبُ","وَلا غَيَّرَتني عَلَيكَ النُوَب",26,"ب",1,0],["وما شئتُ إلاَّ أن أذلُّ عواذِلي","على أنَّ رأيي في هواك صواب",27,"ب",1,0],["وما شكوتُ وما الشكوى إلى بشرٍ","من خلق مثلي والأقدار تصريف",28,"ف",1,0],["وما شكا العُسْرَ بعد اليُسْرِ صاحبُهُم","ولا تَحَوَّل عن رَحْلٍ إلى قَتَبِ",29,"ب",1,0],["وما شِبْلُ ذاكَ الْلَّيْث إلا شَبيهُهُ","وغَيْرُ عجيبٍ أن تَرَى الشبل يأْسَدُ",30,"د",1,0],["وما شافِعي إلا سَماحُك وحدَه","ولا وُصْلَتي إلا المديحُ المجوَّدُ",30,"د",1,0],["وما شكر المداح قومٌ سواكُمُ","ولا حكموا أن يسبق النائلُ الشعرا",31,"ر",2,0],["وما شعر سوى شعري","بمحض الحسب الدَّثر",32,"ر",1,0],["وما شبتُ إلا شيبةً غير أنه","قليلُ قذاةِ العينِ غيرُ قليلِ",33,"ل",1,0],["وما شان نُعْمَى الله وَجْهٌ حَمَلْتَه","تزوّجت النُّعمى به أمْ تَبَنَّتِ",34,"ت",1,0],["وَما شِبتُ إِلّا مِن وَقائِعِ هَجرِها","عَلى أَنَّ عَهدي بِالصِبا لَقَريبُ",35,"ب",1,0],["وما شأْنُ هذا العَدَاءِ العنيفِ","وما شأْنُ هذا الإِخاءِ الوَدودْ",36,"د",1,0],["وما شكا أهل الهوى","من الجوى واللوّم",37,"م",1,0],["وما شرب الملوك ولا استعادوا","كهذى الكأس من هذا النديم",38,"م",1,0],["وَما شَغَلَتهُم عَن هَواها قِيامَةٌ","إِذا اِعتَلَّ رَهنُ المَحبِسَينِ بِأَشغالِ",39,"ل",1,0],["وَما شَجانِيَ إِلّا صَوتُ ساقِيَةٍ","تَستَقبِلُ اللَيلَ بَينَ النَوحِ وَالعَبَرِ",40,"ر",1,0],["وَما شُهَداءُ الحَربِ إِلّا عِمادُها","وَإِن شَيَّدَ الأَحياءُ فيها وَطَنَّبوا",41,"ب",3,0],["وَما شِدتُمُ مِن دَولَةٍ عَرضُها الثَرى","يَدينُ لَها الجِنسانِ تُركٌ وَصَقلَبُ",41,"ب",1,0],["وَمَا شَرَقي بالمَاءِ إلاّ تَذكّراً","لمَاءٍ بهِ أهْلُ الحَبيبِ نُزُولُ",42,"ل",1,0],["وَما شَكَرتُ لِأَنَّ المالَ فَرَّحَني","سِيّانَ عِندِيَ إِكثارٌ وَإِقلالُ",43,"ل",1,0],["وَما شَطَطٌ أَن أُتبِعَ الرُغبَ أَهلَهُ","وَأَن أَطلُبَ الجَدوى إِلى واهِبِ الجَدوى",44,"و",2,0],["وَما شَكَّ قَومٌ أَوقَدوا نارَ فِتنَةٍ","وَسِرتَ إِلَيهِم أَنَّ نارَهُمُ تَخبو",45,"ب",2,0],["وَما شَعَفُ المَشعوفِ إِلّا بَلِيَّةٌ","عَلَيهِ إِذا لَم يُعطَ تَنويلَ شاعِفِ",46,"ف",1,0],["وَما شَكَرَ النَعماءَ مِثلِيَ شاكِرٌ","إِذا قائِلُ الأَقوامِ جازى فَعولَها",47,"ل",3,0],["وَما شَيءٌ بِأَضيَعَ مِن قُشَيرٍ","وَلا ضَأنٌ تَريعُ إِلى خَيالِ",48,"ل",1,0],["وَما شَيءٌ بِأَخلَقَ أَن تَراهُ","قَليلاً مِن أَخي ثِقَةٍ مُؤاسِ",49,"س",1,0],["وما شاءَهُ ذو العرشِ جلّ جلالُهُ","يدقّ وَيَخفَى عن خفيّ التوَهَّمِ",50,"م",1,0],["وما شَرِبت سوى خمرِ التراقي","ولا انتشقتْ سِوَى وَرْدِ الكلومِ",51,"م",1,0],["وما شيّبَ الإنسانَ مثلُ تَغَرّبٍ","يَمُرّ عليه اليومُ منه كَعامِ",52,"م",1,0],["وما شئتُ مما لو عُنيتُ بوَصْفِهِ","سلكتُ إليه كلّ قافيةٍ سبلا",53,"ل",2,0],["وَمَا شُرْبِي الْمُدَامَ هَوىً وَلَكِنْ","عَقَدْتُ بِحَدِّ سَوْرَتِهَا لِسَانِي",54,"ي",1,0],["وَما شاقَني إِلّا وَميضُ غَمامَةٍ","تَطَلَّعَ مِن نَجدٍ فَحَيّا اللِوى رَبعا",55,"ع",2,0],["وَما شاقَني إِلّا حَفيفُ أَراكَةٍ","وَسَجعُ حَمامٍ بِالغُمَيمِ تَرَنَّما",56,"م",2,0],["وَما شِئتَ مِن آراءِ نُجحٍ كَوالِئٍ","تُسَدِّدُ مِن أَطرافِ سُمرٍ كَوالِمِ",57,"م",1,0],["وَما شَقَّ الدَواءُ عَلى مَريضٍ","إِذا ما اِستَأصَلَ الداءَ الوَبيلا",58,"ل",2,0],["وما شُغِفَ المَسودُ بِمِثلِ خُلقٍ","يَكونُ لَدى المُسَوَّدُ مُستَجادا",59,"د",2,0],["وَمَا شَيبُ رَأسِي مِن سِنِينَ تطاولَت","عَلَيَّ وَلَكِن شَيَّبَتنِي الوَقَائِعُ",60,"ع",1,0],["وما شفى داءً ولكنَّما","قلبي شكا البعدَ فعلَّلُتُهُ",61,"ت",2,0],["وَما شاقَ القُلوبَ وَراقَ عَيناً","فَتُجلاهُ كَذِي دَلٍّ رَخيمِ",62,"م",1,0],["وَما شاءَ رَأيُكَ في الحادِثا","تِ قالَ الإِلَهُ لَهُ كُن فَكانا",63,"ن",2,0],["وَما شابَت وَلَكِن شا","بَ في عارِضِها ذَرقُ",64,"ق",1,0],["وما شقّ جيْبَ الحُسنِ إلاّ شقائقٌ","بخدّيكِ مفتوكٌ بهِنّ فواتِك",65,"ك",1,0],["وَما شَرَّفَتني كُنيَةٌ عَرَبِيَّةٌ","وَلا أَكسَبَتني لا سَناءً وَلا فَخرا",66,"ر",2,0],["وَما شَعَرتُ بِالتَجَنّي البادي","حَتّى عَلا صَوتُ أَبي المِقدادِ",67,"د",1,0],["وَما شَفاكَ مِنَ الأَشياءِ تَطلُبُها","إِلّا الأَلِبّاءُ لَو تُلفى الأَلِبّاءُ",68,"ب",3,0],["وَما شامَتِ الهِندِيَّ في الكَفِّ عَنوَةً","وَلَكِن ثَنَتهُ في أَنامِلَ ضارِبِ",69,"ب",1,0],["وَما شُقَراؤُكُم إِلّا ذِئابٌ","تَلَصَّصُ في المَدائِحِ وَالسِبابِ",70,"ب",1,0],["وَما شَرَفُ الإِنسانِ إِلّا عَطِيَّةٌ","حَدَتها اللَيالِيَ وَالقَضاءُ المُسَخَّرُ",71,"ر",1,0],["وَما شِمالي لِخِلٍّ بَل أُجَنِّبُهُ","إِلى الجَنوبِ وَإِن سُقتُ الشَماليلا",72,"ل",2,0],["وَما شَأنُ اللَبيبِ بِغَيرِ سِلمٍ","وَإِن شَهِدَ الوَغى مُتَلَبِّبوهُ",73,"ب",3,0],["وَما شَعرٌ بِرَأسِكَ في عِدادٍ","بِأَكثَرَ مِن ذُنوبِكَ وَالخَطايا",74,"ا",3,0],["وَما شَكِسُ الأَنيابِ شَثنٌ بَنانُهُ","مِنَ الأُسدِ يَحمي مِن تِهامَة وادِيا",75,"ي",2,0],["وَما شاعر العصر الجديد سوى الَّذي","على دولة الشعر القديم تمردا",76,"د",2,0],["وما شكاتي حين شملي جميع","وأنت لي أيكٌ وظلٌّ وريف",77,"ف",1,0],["وما شئت إلاّ أن أدلّ عواذلي","على أنّ رأيي في هواك صواب",78,"ب",1,0],["وما شَبّ ناراً في تِهامةَ سامِرٌ","يدَ الدهرِ إلاّ أبَّ قلبُكَ في سَلْع",79,"ع",1,0],["وما شَرِبَ ابْنُ الشُّرْبِ قَبْلَكَ خَمْرَةً","مِن الذُّلِ بالعَجْزِ الصَّرِيحِ تُصَفّقُ",80,"ق",1,0],["وَما شاقَ قَلبي في الدُجى غَيرُ طائِرٍ","يَنوحُ عَلى غُصنٍ رَطيبٍ مِنَ الرَندِ",81,"د",1,0],["وما شَأني بهِ وَالفَيجُ حَولي","وهَمِّي لَو عَنيتُ به مُصيبي",82,"ب",2,0],["وَمَا شَرَفُ الإِنْسَانِ إِلَّا بِنَفْسِهِ","وَإِنْ كَانَ ذَا مَالٍ تَلِيدٍ وَمُطْرِفِ",83,"ف",1,0],["وَمَا شَهِدَ الأَقْوَامُ قَبْلَكِ سَيِّداً","يُطَاعُ مُطِيعاً قَوْمَهُ وَيَصُولُ",84,"ل",1,0],["وَمَا شُغْلكَ عَنْ فنٍّ","سَبَتْنَا فِيهِ أَشْغَالُكْ",85,"ك",1,0],["وما شاقَنِي مِن شقّ جيبٍ ومَدْمَع","أسيلٍ على خَدٍّ أسيلٍ بمأسَلِ",86,"ل",1,0],["وما شجانيَّ إلاّ صوتُ باخرةٍ","تستعجلُ الركبَ إِيذانا وتأذينا",87,"ن",2,0],["وما شطَّ المعلم أو تجنَّى","ولا هو هام بالعيش الرغيد",88,"د",1,0],["وما شاد هذا صروح السلامِ","ولا اعتاد ذلك سفكَ الدماء",89,"ا",2,0],["وماشٍ إلى قلبِ الحقودِ بِحيلةٍ","يُداوي بها حتى تُسَلَّ السّخائم",90,"م",1,0],["وَمَا شَكَرَ النَّعْمَاءَ مِثْليَ شَاكِرُ","إِذا قَائِلُ الأَقوامِ جَزَى فَعُولَهَا",91,"ل",3,0],["وما شئتُ ممات لو عُنيتُ بوَصْفِهِ","سلكتُ إليه كلّ قافية ٍ سبيلا",92,"ل",2,0],["وما شككتنيَ فيكَ الخطوبُ","ولا غيَّرتني فيكَ النُّوبْ",93,"ب",1,0],["وما شعراؤكم إلاّ ذئابٌ،","تَلصَّصُ في المدائحِ والسِّبابِ",94,"ب",1,0],["وما شغلتهم عن هواها قيامة ٌ","إذا اعتلَّ رهنُ المحسينِ بأشغال",95,"ل",1,0],["وَما شينَت بِمَطلٍ وَاِقتِضاءٍ","وَلا سُبِقَت بِوَعدٍ أَو ضَمانِ",96,"ن",1,0],["وما شك أن الله عونك من رأى","سطاك وباب الطعن والضرب منسد",97,"د",1,0],["وما شك من هزت عليه قوامها","بأن القنا منها تعلمت الطعنا",98,"ن",2,0],["وما شكرناك إلا بعد معرفة","وخبرة فحمدنا السر والعلنا",99,"ن",2,0],["وما شَعَراتيْ البيضُ إلا مشاعلٌ","ومِن نارِ قلبي نورُ تلك المشاعلِ",100,"ل",1,0],["وما شَربَ الطّلا إلا استراحتْ","مسامعُهُ إلى نَغَمِ السُّؤالِ",101,"ل",1,0],["وَما شِبتُ مِن عَدِّ السِّنين وَإِنَّما","أَشابَ قَذالي مَيلُها وَاِنقِلابُها",102,"ب",3,0],["وَما شِبتُ مِن سِنٍّ مَضَت بَل أَشابَني","صُروفُ اللَيالي وَالخُطوبُ الفَوادِحُ",103,"ح",1,0],["وَما شَجانِي كَذِكْرَى خِلْتُها حُلُماً","كَأَنَّ قَلْبِي لَها بِالذَّكْرِ مَكْلُومُ",104,"م",1,0],["وما شاقني إلا غير ساق","ولا واقع إلا معنّى بسالم",105,"م",1,0],["وما شوقي إلى شيء كشوقي","إلى مردان أولاد اليهود",106,"د",1,1],["وما شيء أشدّ عليّ غيظا","من الأحكام يحكمها اليهود",107,"د",1,0],["وَما شكَّ في صدقِ الحديثِ وإنّما","رَأى خبَر المُختارِ ما طابقَ الخُبرا",108,"ر",2,0],["وَما شَجاني أَنَّني كُنتُ نائِماً","أُعَلَّلُ مِن فَرطِ الكَرى بِالتَنَسُّمِ",109,"م",1,1],["وما شقَّ وجنتَه عابثٌ","ولكنّها آيةٌ للبشر",110,"ر",1,0],["وما شظفُ المعيشةِ في هناءٍ","تقرُّ بهِ سوى العيش المريعِ",111,"ع",1,0],["وما شفني إلا النَّسيم وتيهُهُ","عليَّ إذا ما لاعبتُه خُدُوروها",112,"ه",2,0],["وما شرف الإنسانِ إلا فعالُه","فكلُّ امرئٍ يُؤتي المكارم مُكرمِ",113,"م",1,0],["وما شاني الإخلاص في الود والهوى","وما الأكل من شاني هناك ولا الشربُ",114,"ب",1,0],["وما شعروا لما الينا تعرضوا","بان على الباغي الدوائر ترجع",115,"ع",1,0],["وما شرف الفتنى وقد استنامت","جوانحُه إلى مثوى الهوابى",116,"ب",2,0],["وما شاع فيه من خلاف لمسلم","فإني لمن يُفتى به لا أبدّع",117,"ع",1,0],["وَما شغَفي بِهِ إِلّا لِعِلمي","بِأَنَّ هَواهُ مِن قَلبي قَريبُ",118,"ب",1,0],["وَما شَغَفي بِرِمالِ العَقيقِ","وَلَكِن بِمَن حَلَّ تِلكَ الرِمالا",119,"ل",2,0],["وَمَا شَهِدْنَاكَ إِلاَّ بِالْبَصَائِرِ لاَ","بِبَصَرٍ يُدْرِكُ الأَخْيَارَ أَوْبَاشَا",120,"ش",2,0],["وما شيءُ له نفسٌ ونفسٌ","ويؤكلُ عظمُه ويُحَكُّ جلدُه",121,"د",2,1],["وما شفَتي الحمراءُ إلا كوردةٍ","عليها من الأسنانِ يَنتَثِرُ القطر",122,"ر",1,0],["وما شِعري سِوى خَفَقان قلبي","وقد عرفَ الحنانَ منَ الحنين",123,"ن",1,0],["وما شاقَني إِلا تَذَكُّر لَيلةٍ","وقَلبي على عهدِ الصبوَّةِ ناضر",124,"ر",1,0],["وَما شاقني برق بأبرق رامة","وَلا نَغمات من حمام مغرد",125,"د",1,0],["وَما شيء بأعظم من جسوم","مفرقة وأَرواح تلاقى",126,"ق",2,0],["وَما شئت من قوم أعد صديقهم","اذا اِستنصر وازالوا وان وزنوا خفوا",127,"ف",3,0],["وَما شاقَنِي أَنْ لَسْتُ مُسْتَعْدِياً عَلَى","نَوائِبِها إِلاّ لِقِلَّةِ مَنْ يُعْدِي",128,"د",2,0],["وَما شيِمَتْ سَحابُ نَداكَ إِلاّ","سَحَبْتُ ذَلاذِلَ الْحَمْدِ الْمَصُونِ",129,"ن",1,0],["وَما شاءَ إلاّ أَنْ تُحَقِّقَ عِنْدَهُ","مَحَلَّكَ مِنْ طاوٍ هَواهُ وَناشِرِ",130,"ر",1,0],["وَما شِئْتُ إِلاّ أَنْ أُشَرِّفَ مَنْطِقِي","بِمَدْحِكَ أَوْ أَقْضِي ذِمامَ الْمَكارِمِ",131,"م",1,0],["وَما شَغَفِي بِالرِّيحِ إِلاّ لأَنَّها","تَمُرُّ بِحَيٍّ دُونَ رامَةَ مَثْواهُ",132,"ا",2,0],["وَمَا شَرُفَتْ عَنْ قِيمَة الزُّبَرِ الظُّبى","إِذَا لَمْ يُشَرّفْهَا مَضاءُ الْمَضَارِبِ",133,"ب",1,0],["وَما شادِنٌ مِن بَني التُّركِ مِنهُ","يُرى التَّجرُ ما بَينَ كابٍ وَباكِ",134,"ك",1,0],["وَما شَفى كَبِدي مِمّا أُكابِدُهُ","إِلّا البَشيرُ بِبَدرِ الدينِ إِذ طَلَعا",135,"ع",2,0],["وَما شَغَفي بالدار أَبكي رسُومَها","وأَندبُها لَولا الصَبابةُ وَالذِكرُ",136,"ر",1,0],["وَما شابتْ لها الأطفالُ لكنْ","بشرعِ طغاتِها وَردتْ رداها",137,"ا",3,0],["وما شيءٌ له حدٌّ وخدٌ","يكلم من يلامسه بحقه",138,"ه",1,1],["وما شيءٌ يدور على","نقيٍّ قلبه قاس",139,"س",1,1],["وما شق قلبي غير شعرةِ خدهِ","وما جبرُ ذاك الصدع مني سوى الصدغ",140,"غ",1,0],["وَما شابَت لَنا الأغراضُ ودّاً","وَلا صَرَفتهُ عن نهجٍ سديدِ",141,"د",1,0],["وَما شئتَ مِن روضٍ يكلّله الحيا","وَتصدحُ منهُ الورق في فنن رطبِ",142,"ب",1,0],["وَما شئت من نهرٍ قد اِطّردت به","مُفاضة ماذيٍّ على صفحة العضبِ",142,"ب",1,0],["وما شئت من هفهافةٍ قلمية الغناء","إلى نايية النغمِ والنبرِ",143,"ر",1,0],["وَما شَرف التَطاول في بِناء","إِذا ما أَعجَز الباني الضَمانُ",144,"ن",1,0],["وَما شرَّف العَلياء مِن أَهلِها سِوى","فَتىً أَرضَعته ثَديها وَهوَ في المَهدِ",145,"د",1,0],["وما شُكري لمِا أَولَيْتَ إلاَّ","رَهينٌ ما أُطيقُ له فَكاكا",146,"ك",2,0],["وما شَبّهوا إلاّ الحواشي بما حكَوا","فجَلَّ عن الشِّبْهِ المَوالي الأكابر",147,"ر",1,0],["وما شامِخٌ لا تُنِصِفُ العَينُ طُولَهُ","بأثقلَ منه حين يَزْوَرُّ جانبه",148,"ب",2,0],["وَما شاقَني إِلّا مِنَ الخَصرِ مُخطَفٌ","وَما راقَني إِلّا مِنَ الثَغرِ خاطِفُ",149,"ف",1,0],["وَما شِيمَتي إِلّا المَحبة وَالوَفا","وَيَعلم رَبي ما أُسِرّ وَما أُبدي",150,"ي",1,0],["ومَا شَعْبُ مِصرَ سوى قصَّةٍ","بأقلامِ أمْجادِنا تُكْتَبُ",151,"ب",1,0],["وما شربت أجفانه لذة الكرى","كأن لذيذ النوم في حكمه سكر",152,"ر",1,0],["وما شأن تقبيل البلاد وإنه","لَفاقِرةٌ في الدين للناس تُفْقِر",153,"ر",1,0],["وما شاء منك الكفر قط وإن قضى","به فالقضا ليس اختيار المشيئة",154,"ه",1,0],["وما شُكرِي لِما أوليتَ كُفءٌ","ولكنّي سأُبلي فيهِ عُذرَا",155,"ر",2,0],["وما شَفَّهُ إلا نَوى من يَودُّهُ","وفُرقَةُ أُلاّفٍ هي الميتَة العَبْطُ",156,"ط",1,0],["وما شرَفُ الأنام بغير قومٍ","هُمُ مذ كُوّنوا شرَفُ الأنام",157,"م",1,0],["وما شقيت من آل بيتك عُصبَةٌ","وأنْتَ بهم في العدل ناهٍ وآمر",158,"ر",1,0],["وما شاد قسطنطين ما شدتَ من عُلًى","مُؤبَّدة تبقى على أبدِ الدهر",159,"ر",1,0],["وما شرّف الأكوان إلّا جمالكُم","وما يقصدُ العُشّاقُ إلّا سناكمُ",160,"م",1,0],["وَمَا شَكَرَ النَّخْعِيُّ شُكْرِي ولا وَفى","وفائيَ إِذْ عَزَّ الوَفاءُ قَصِيرُ",161,"ر",1,0],["وما شِيَمُ الزمانِ رَمَتْ إِلَيْهِ","ولكنْ رَمْيَةٌ من غَيرِ رامِ",162,"م",1,0],["وَمَا شُغِلَتْ يُمْنَاكَ عن بَذْلِ مَا حَوَتْ","وإِنْ غارَ مِنْهُنَّ النَّدى والمكارِمُ",163,"م",1,0],["وماشطة بنتا لفرعون طفلها","تكلم في مهد بلفظ وتجويد",164,"د",1,0],["وما شتّتت أَيدي المنايا مجمع","وما جمعت أيدي البرايا مشتت",165,"ت",1,0],["وما شرحت لي عنه علما جهينة","ولكنه تحقيق علم بلا ظن",166,"ن",1,0],["وما شأن الجهاد وشأن قوم","عدوهم اشترى فيهم وباعا",167,"ع",2,0],["وما شكوت التياعا بل مسايرة","للفن أجتاز أمواتا وأحياء",168,"ا",2,0],["وما شِمنَ حُلوانَ حتى حلا","بأفواهها طعمُ فُوسِ اللُّجُمْ",169,"م",1,0],["وما شكَ فيك الناسُ أنك مُزنَةٌ","تلاقحَ فيها العامُ وهو مُحولُ",170,"ل",1,0],["وما شمسُ النهار وأنت بدرٌ","بمزعجةٍ إذا عزمتْ أفولا",171,"ل",2,0],["وما شبتُ لكن ضاع فيما بكيتكم","سوادُ عِذاري في بياض دموعي",172,"ع",2,0],["وما شاع عن حَسّان في آل جفنة","من السائرات اليومَ ما هو شائعُ",173,"ع",1,0],["وما شبِعت برؤيتكم لحاظٌ","سواغبُ لي ولا بَرَد التياحُ",174,"ح",1,0],["وما شرف الدين الجوادُ بواجِدٍ","ثناءً كقولي والعُداةُ شَواهدُ",175,"د",1,0],["وما شامخٌ طوْدٌ من الشمِّ راسخٌ","بعيدٌ ذُراهُ يُعْجزُ المُتَسنِّما",176,"م",2,0],["وما شُعَراءُ الناس إِلاَّ مَعادِنٌ","وما كل أرضٍ معدنُ الذهب التِّبر",177,"ر",1,0],["وما شكَّ في أنَّ المصابيح شهبها","وأنَّ دخانَ المندليِّ غيومها",178,"م",3,0],["وما شانَ فضلي بين أهلي خمولهُ","وقد بلغتْ آياتهُ الإنسَ والجنّا",179,"ن",2,0],["وما شانه هذا النحول الذي عرى","واقطع هندي الظبي كل ناحل",180,"ل",1,0],["وما شاقني إلاَّ جلالك والحجى","وأن شاق قوماً ظبي نعمانَ والنعف",181,"ف",1,0],["وما شكَّ قلبي إنَّ بلقيسَ أقبلتْ","وفي القصر ذو التاج الأعزِّ سليمان",182,"ن",1,0],["وَما شَرَفي بِالشِعرِ حينَ أَصوغُهُ","فَيُزهى عَلى ما صيغَ مِن خالِصِ التِبرِ",183,"ر",1,0],["وَما شَجوها كالشَجوِ مِنّي وَلا الَّذي","إِذا جَزِعَت مِثلَ الَّذي مِنهُ أَجزَعُ",184,"ع",1,0],["وَما شَماتُ امرِئٍ إِن ماتَ صاحِبُهُ","وَقَد يَرى أَنَّهُ بِالمَوتِ مُرتَهَنُ",185,"ن",1,0],["وما شاءَ فليزددْ دلالاً فاِنَّني","صبورٌ على حُكْمِ التجنَّي لأجلهِ",186,"ل",2,0],["وما شوقُ ورقٍ غابَ عنها هديلُها","وقد كانَ ما بينَ الحدائقِ ساجعا",187,"ع",2,0],["وما شيء لم يمكن بغير طهارة","وذا ناقص قد قرروه بحيلتي",188,"ت",2,0],["وما شيء إن أسقطت أماحه","فقد زال عن قبح وعن فطم خيبتي",188,"ت",2,0],["وما شربوا المدام على الطلول","وما شهدوا الجفون لدى المعان",189,"ن",1,0],["وما شربت بكاس العز مصطبحاً","حتى تجشمت ورد الليل مغتبقا",190,"ق",2,0],["وما شأنُ من يَروي الغَرامَ تَبَجُّحاً","سِوى شأنِ ذي جَهْلٍ يُناظِرُ ذا فَضْلِ",191,"ل",1,0],["وما شِعريْ سوى أجزاءِ روحٍ","إذا جُمِعتْ تخايلَ رسْمُ شاعِرْ",192,"ر",1,0],["وما شئت فاصنع راشداً في سؤالهم","فرأيك من رأي البرية أصوب",193,"ب",1,0],["ومَا شَفَقُ بعدَ الغُروبِ بِلَونِه","يُظَلِّلُ أُفقي غَيرُ راياتِكَ الحُمرِ",194,"ر",1,0],["وَما شقّت الأوطار إِلّا بلغتُها","بكلِّ صهيلٍ تارةً وبُغامِ",195,"م",1,0],["وما شعروا حتّى رأوها مغيرةً","عجالاً لأطرافِ الشَّكِيمِ لوائكا",196,"ك",2,0],["وما شَعَفِي بالحرب إلّا لأنّنِي","أرى السّيفَ أهدى والكريهة أقصَد",197,"د",1,0],["وَما شَعروا حتّى صَبَحْتَ دِيارَهُمْ","بِمَلمومَةٍ فيها القنا والصّفائحُ",198,"ح",1,0],["وما شِمْت من برق الأنانية التِي","شَعرتَ بها منظومةً وسطَ الشِّعرِ",199,"ر",1,0],["وما شد إلا أحمق خائر القوى","يرى أن ضوء الصبح يحجبه ستر",200,"ر",1,0],["وَمَا شِئْتَ مِنْ نَفْسٍ عَزُوفٍ ومَذْهَبٍ","شَرِيْفٍ وَتَرْكِيْبٍ حَكَى بَعْضَهُ بَعْضُ",201,"ض",1,0],["وَمَا شَيَّدْتَ لِلْخَلْوَ","ةِ مِنْ دَارٍ وَمِنْ قَصْرِ",202,"ر",1,0],["وما شاقه صوتُ الحَمام إِذا شَدا","ويُطرِبُه سَجْعُ الحِمام إِذا غنَّى",203,"ن",2,0],["وما شبَّ نارِي منكَ صدٌّ ولا نَوىً","ولكن قبولٌ بزَّ عقْلي وإِقْبَالُ",204,"ل",1,0],["وما شَرِقُوا بالماءِ والرِّيق إِذ رَأَوْا","جيوشَك لكن بالفوارِس والرَّجْلِ",205,"ل",1,0],["وَمَا شَرَفِي إِلَّا بِنَفسِي وَإِنْ يَكُنْ","لِقَوْمِي فَخَارٌ طَاوَلَ النَّجْمَ مَجْدُهُ",206,"د",2,0]]}