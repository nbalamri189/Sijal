{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[65,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[65,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[102,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[59,"فإذا سمعت بأن مجدودا حوى","https://www.aldiwan.net/poem24662.html","الكامل"],[79,"هب النسيم معطر الأراج","https://www.aldiwan.net/poem36664.html","الكامل"],[74,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[53,"يا أبا نصر وما للمرء في","https://www.aldiwan.net/poem64966.html","الرمل"],[53,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[87,"حبيبك من تحب ومن تجل","https://www.aldiwan.net/poem7574.html","الوافر"],[87,"بدأ الطيف بالجميل وزارا","https://www.aldiwan.net/poem7774.html","الخفيف"],[45,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[47,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[47,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[63,"رفق الزمان بنا وكان عنيفا","https://www.aldiwan.net/poem51543.html","الكامل"],[63,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[63,"قم بنا قبل غرة الإصباح","https://www.aldiwan.net/poem51736.html","الخفيف"],[46,"إن عهدا لو تعلمان ذميما","https://www.aldiwan.net/poem30357.html","الخفيف"],[89,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[107,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24726","الكامل"],[108,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[108,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[102,"الربيع والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=50128",""],[89,"كَمْ غادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِكَمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23829&r=&rc=91",""],[164,"اجعل زكاة سديرك المعمور","https://www.aldiwan.net/poem58827.html","الكامل"],[236,"ربع المنى بمنى نعمت صباحا","https://www.aldiwan.net/poem44594.html","الكامل"],[257,"ما نام بعد البين يستحلي الكرى","https://www.aldiwan.net/poem1416.html",""],[280,"ما بسيط الحياة إلا وجيز","https://www.aldiwan.net/poem25401.html","الخفيف"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[422,"أحمد الله بك الحال التي","https://www.aldiwan.net/poem54018.html","الرمل"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[445,"إن روضا لم تسقه منذ عام","https://www.aldiwan.net/poem34767.html","الخفيف"],[445,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[463,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[520,"هم الزمان بها فمنذ كفلتها","https://www.aldiwan.net/poem12234.html","الكامل"],[520,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[556,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[556,"يا عليل الطرف رفقا","https://www.aldiwan.net/poem47264.html","مجزوء الرمل"],[556,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[556,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[556,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[556,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[567,"المرء في الدنيا خيال قد سرى","https://www.aldiwan.net/poem52910.html","الكامل"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107087","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138332",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145908","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48732","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48516","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48837","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48733","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48673","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48886","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48758","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46540","الرجز"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124591",""],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101063","الكامل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11125","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46485","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47128","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77224","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77345","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77201","الخفيف"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198476",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106855","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60905","الكامل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21629","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65118","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100803","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100740","الخفيف"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145539","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91150","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91583","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114538","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40129","الكامل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32470","الخفيف"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103259","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66191","الكامل"],[4978,"لله درك يا أخي وتدوم","https://www.poetsgate.com/ViewPoem.aspx?id=178647",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[3591,"حرم الجمال نواظري سنة الكرى","https://www.poetsgate.com/ViewPoem.aspx?id=149439",""],[5206,"حب غير الله","https://www.poetsgate.com/ViewPoem.aspx?id=187395",""],[351,"إِذَا بَرَزَتْ لَيلَى مِنَ الخِدْرِ أَبْرَزَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=4471",""],[5717,"حبتك طالعة بحسن المطلع","https://www.poetsgate.com/ViewPoem.aspx?id=170588",""],[5782,"تفاعل القصائد بالقوافي","https://www.poetsgate.com/ViewPoem.aspx?id=185762",""],[463,"قمْ غيرَ معتذرٍ ولا متثاقلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60275&r=&rc=331",""]],"verses":[["وَأَحَقُّ بِالإِطراءِ باعِثُ مِنَّةٍ","وَصَلَت مِنَ الأَرحامِ ما لَم يوصَلِ",0,"ل",1,0],["وأحَقُّ مُفْتَقَدٍ بها ذو سُؤْدَدٍ","آباؤُهُ منْ هاشِمٍ أعْمامي",1,"م",2,0],["وأحْقِرُ دُنيا تَسْتَرقُّ لَها الطُّلى","مَطامِعُ لحَظي نَحْوَها متَشاوِسُ",2,"س",1,0],["وأحق أبناء البسيطة بالعل","من شارك العاني وآسى المعدما",3,"م",2,0],["وَأَحَقُّ خَلقِ اللَهِ بِالهَمِّ اِمرُؤٌ","ذو هِمَّةٍ يُبلى بِرِزقٍ ضَيِّقِ",4,"ق",1,0],["وأحَقُّ مَنْ مَلَكَ الخِلافَةَ ناصِرٌ","يَنْمِيهِ صاحِبُ صاحِبِ المِعْراجِ",5,"ج",1,0],["وأحقّ بالأحزان ماض لم يسيء","بيدٍ ولا لسنٍ ول إضمار",6,"ر",1,0],["وأحقُّ مطويٍّ مداه لقاطع","سَفَرٌ تلوح لتاجرٍ أَرْباحُه",7,"ح",2,0],["وأحق الناس بالحسرةِ من","رفع اللَهُ بناه فانخفض",8,"ض",1,0],["وأحقُّ زوجٍ أن يُنتّجَ شكْله","حسناء تُذكرُ عاثرٌ ومُقيلُ",9,"ل",1,0],["وأحقُّ من دعتِ الملوكُ لأمرِها","مَنْ عندَه عوْنٌ وفيه تبتُّلُ",10,"ل",1,0],["وأحقر كل كذاب المعالى","ولو أن السماك له محل",11,"ل",1,0],["وأحقُّ الأقوام بالعز قوم","يقدِرون الأمور والأقدار",12,"ر",1,0],["وَأَحَقَّ الغُيوثِ نَفساً بِحَمدٍ","في زَمانٍ كُلُّ النُفوسِ جَرادُه",13,"د",2,0],["وأحقِنُ ماءَ الوجهِ طَيَّ أديمِه","ومن دونِه ماءُ الوريدينِ مصبوبُ",14,"ب",1,0],["وَأَحَقُّ ما عَجِبتُ مِنهُ ضَرورَةٌ","تُغري المَقودَ بِأَن يُطيعَ القائِدا",15,"د",2,0],["وَأَحَقُّ الإِحسانِ أَن يُصرَفَ الحَم","دُ إِلَيهِ ما لَم يَكُن مَمنونا",16,"ن",2,0],["وأحقُّ مَنْ يُضحي فريسةَ ضَيْغَمٍ","مَنْ رَاحَ مُقْتَحِماً عليه عَريفا",17,"ف",2,0],["وأحقُّ يومٍ بالمُدامِ وشربِها","يومٌ حباكَ بديِمَةٍ مِدرارِ",18,"ر",1,0],["وأحقُّ الأيّامِ بالقَصْفِ يومٌ","جَنَّبَتْ مُزنَه جَنوبُ الرِّياحِ",19,"ح",1,0],["وَأَحَقُّ الأَقوامِ أَن يَقضِيَ الدَي","نَ ثُمَّ لَمّا عَلاهُ صارَ أَديما",20,"م",2,0],["وَأَحَقُّ دَارٍ بِالْكَرَامَةِ مَنْزِلٌ","لِلْقَلْبِ فِيهِ عَلاقَةٌ لَمْ تَصْرَمِ",21,"م",1,0],["وَأَحَقُّ الشعوبِ بِالمَجدِ شَعبٌ","عاشَ حُرّاً في أَرضِهِ مُستَقِلّا",22,"ل",2,0],["وأحقُّ مَن حَمَلَ اللّواءَ مجاهدٌ","ماضٍ على هَوْلِ الخُطُوبِ مُصَمِّمُ",23,"م",1,0],["وَأَحَقَّ أَن يُرمى بِداهِيَةٍ","إِنَّ الدَواهِيَ تَطلُعُ الحَدَبا",24,"ب",2,0],["وأحقُّ مصروفٍ إليه شِرْبُهُ","مَنْ واشَجَتْ أغصانُهُ أغصانَهُ",25,"ن",2,0],["وأحقُّ مَنْ ساسَ الصِّغارَ مُحَنكٌ","صَقَلَتَهُ دُورُ العِلْم أيَّ صِقالِ",26,"ل",1,0],["وأحقُّ نَقَّادِ بصفعِ قَذَالِهِ","من راح يخلطُ نَقْدَهُ بِسبَابِه",27,"ب",2,0],["وأحقّ أبناء البسيطة بالعلا","من شارك العاني وآسى المعدما",28,"م",2,0],["وَأَحَقُّ دَارٍ بِالْكَرَامَة ِ مَنْزِلٌ","للقلبِ فيهِ علاقةق لمْ تصرمِ",29,"م",1,0],["وأحق من أدت إليه زكاتها","بيتي لمالك من هوى لضميري",30,"ر",2,0],["وأحق من بذل الورى في حبه","ومزاره الأموال والأرواحا",31,"ح",2,0],["وَأَحَقُّ مَن خَلعت عَلَيهِ مؤيد","خِلَعَ الَّذين بَغَوا عليهم أَعصُرا",32,"ر",2,0],["وأحقّ النساك بالرفع حالا","من عداه لدى الورى تمييز",33,"ز",1,0],["وأَحَقُّ مَنْ عُنيَ المُلوكُ بِهِ","مَنْ سارَ فيما قالَ ذِكْرُهُم",34,"م",1,0],["وأحقُّ النَّاس في ميراثه","أخرسٌ يطمع في ميراث أخرس",35,"س",1,0],["وأحق خلق الله بالمدح امرؤ","كثرت عطاياه من الإِقلال",36,"ل",1,0],["وأحَقُّ الرياضِ بالسَّقْيِ رَوْضٌ","رَاهِنٌ شُكرُهُ مَعَ الأيامِ",37,"م",1,0],["وأَحْقِرْ بِهَوْلِ البَحْرِ أَنْ يَسْتَكِفَّها","وأَهْوِنْ بِغَوْلِ القَفْرِ أَنْ يَسْتَزِلَّها",38,"ل",3,0],["وأحقُّ بالتمييز عند محمَّدٍ","من كان سامَى منكبيْه راقيا",39,"ي",2,0],["وأحقُّ من صغتُ الثناءَ لجيدِهِ","من لستُ إن لبِسَ الحُلِيَّ بعاطلِ",40,"ل",1,0],["وأحق من وزر الخلافة من مشى","في حضرة الإعظام والإجلال",41,"ل",1,0],["وأحق الأنام بالذم جيل","بين أبنائه الكريم يهان",42,"ن",1,0],["وأحقُّ منّا بالبكاء على الّذي","سلب الزّمانُ الفضلُ والإنعامُ",43,"م",1,0],["وأحقُّ النّاس بالإجْ","مالِ ذو الوجه الجميلِ",44,"ل",1,0],["وَاِحقِنْ حَياتك في خدّيك مبتذلاً","من دونه لدمِ الأرواحِ مُنْسَفِكا",45,"ك",2,0],["وَأَحقّ ما أَرجوه منك زيارةٌ","أُدعى لها في النّاس أيمنَ زائرِ",46,"ر",1,0],["وأحقُّ بالإدْناءِ من حُجُراتكمْ","كَلِفٌ يوالِي فيكُمُ ويعادِي",47,"د",2,0],["وَأَحقُّ مَن لبسَ الكرامةَ مخلصٌ","ما شابَ صفوَ ودادِه بتودّدِ",48,"د",1,0],["وأحَقُّ بالإحسانِ مَن لم يُهمِل ال","مَعروفَ قَطُّ ولم يُباشِرْ مُنكرَا",49,"ر",2,0],["وأحق شخص بالفضيلة من غدا","بين الأنام وكتبه جلاسه",50,"س",2,0],["واحق شخص بالثنا ذو رأفة","وأجل مدح لابق برؤوف",51,"ف",1,0],["وأحقابه فيه مبالغ دوره","وأيام يوم الدين آباد دهره",52,"ه",1,0],["وأحق من يدعي خليفة ربه","ملك خلافته هدى ونجاح",53,"ح",1,0],["وأحق الناس بالعذ","رِ ولاة الأمر فينا",54,"ن",2,0],["وأحق بالترويح قلب مفعم","بعواقب الأبناء والأحفاد",55,"د",1,0],["وأحقها بمحكَّم من خلقه","نصر الضعيف وعفة الزهاد",55,"د",1,0],["وأحق بالتفضيل شاعر أمة","ما زال فيها داعياً ومجيبا",56,"ب",2,0],["وأحق الحكام بالطاعة العف","فُ ومن كان حزبه إحسانه",57,"ن",2,0],["وأحق بالجيش العظيم ونصره","من جيشه التأمين والتمدين",58,"ن",1,0],["وأحقُّ بالتكريم والتقريب مَن","هذي بشائره وذا إلهامه",59,"م",2,0],["وأحق بالعمر الطويل تحوطه","بعد المكاره راحة وسلام",60,"م",1,0],["وأحق بالذكرى سجايا أمة","من قبل ذكرك أصلها والمعدنا",61,"ن",2,0],["وَاحقن دِماء الناس","فَالقَتل طَبع القاسي",62,"ي",1,1],["وأحقرك الذي أوصاك قدما","بأمك لا تتوق إِلى سواها",63,"ا",3,0],["وأحق بالرتب العوالي والعلا","زين الكرام عليٌّ الكيلاني",64,"ن",2,0],["وَأَحقَرُ مَحقورٍ تَميمٌ أَخوكُمُ","وَإِن غَضِبَت يَربوعُها وَرَبابُها",65,"ب",3,0],["وَأَحق مَن نالَ الشَهادة مَقصد","بالمشرفية وَالقَنا الخطار",66,"ر",1,0],["وأحقُّ مَنْ تحت السّماء بأن يُرى","مَلِكَ البسيطةِ والورى أَنْصَارُ",67,"ر",1,0],["وأحقهم بالسبق أسبقهم الى ال","إسلام والتصديق بالقرآن",68,"ن",1,0],["وَأَحَقُّ ما أَهدَت مَلائِكَةُ الهَوى","لِلوالِهِ الظَمآنِ ثَغرُ حَبيبِ",69,"ب",1,0],["وَأَحَقُّ دينٍ أَنتَ مُحتَفِلٌ بِهِ","دينٌ يُلائِمُ فِطرَةَ الإِنسانِ",70,"ن",1,0],["وَأَحَقُّ الوَرى بِخِزيٍ وَإِذلا","لٍ قَوِيٌّ عَلى ضَعيفٍ يَجورُ",71,"ر",1,0],["واحْقِنْ دمَاءَ المسْلمِينَ بِهَا","وَانِقذْهُمُوا من سُوءِ مُنْقَلَبِ",72,"ب",1,0],["واحَقُّنا باللوم ذو قلق","يشكو بقلبٍ دائم الحرق",73,"ق",1,0],["وأحق خلقٍ بالملاَمة شاعِرٌ","يَلحَى على البخلِ الرجالَ ويبخلُ",74,"ل",1,0],["وَأَحَقُّ بِالصَبرِ الجَميلِ مِن اِمرئٍ","كَزٍّ أَنامِلُهُ قَصيرِ الباعِ",75,"ع",1,0],["وأحقّ من تسعى الملوكُ لهُ على","أحداقها سعيا عليه وقارُ",76,"ر",1,0],["وأحق الاقوام بالمدح قوم","ركبوا في سبيلها الاخطارا",77,"ر",2,0],["وأحق الأقوام بالشكر أقوا","مٌ يقيمون للنهى تذكارا",78,"ر",2,0],["وأحق الورى بالشكر بني مر","وان (...) حزبها الحكمي",79,"ي",1,0],["وَأَحقّ بالحسنى فَتىً","خزم المسيء وَأَرغما",80,"م",2,0],["وَأَحق ما صان الفَتى ديباجة","لَيسَت تَقوم بِها صُنوف المال",81,"ل",1,0],["وَأَحق قول قلتَه إِذ قلتَه","قال الأَنام صدقت فانشئ وَانشد",82,"د",1,0],["وأحقُّ ما يصفي الفتى","ودُّ الخليلِ على الحقيقه",83,"ق",2,0],["وأحقُّ من مَلَكَ البلاد وأهلَها","رؤٌف تكنَّف عدلُه أقطارَها",84,"ر",3,0],["وَأَحَقُّ الرِجالِ أَن يَغفِرَ الذَن","بَ لِاِخوانَهُ المُوَفَّرُ عَقلُه",85,"ل",2,0],["وأحق ميت بالمراثي أمة","العين تذرف والقلوب جليدُ",86,"د",1,0],["وأَحقَّ من يهدي لمنهجِ رشده","إن يستبينَ له اتِّضاحُ المنهج",87,"ج",1,0],["وأَحَقُّ مَنْ تُهْدَى إِلَيْهِ مُهْجَتِي","يابَى مِنَ العَلْياءِ غَيْرَ رُباها",88,"ا",3,0],["وأحق بالتكريم مني صاحبٌ","ملأ المواقع علمه المرسوم",89,"م",1,0],["وأحقّ الملوك بالمدح من يم","تلكون القلوب قبل الرّقاب",90,"ب",1,0],["وأحقّ ما أغتنم الفتى في عمره","وقتٌ بباريس اليتيمة قد سرى",91,"ر",2,0],["وَأَحَقُّ مَا بالفَرضِ مِن أنْوَاعِهِ","تَجريدُهُ لِلحَقِّ عَزَّ جَلَالَا",92,"ل",2,0],["وَأَحقَافَ رَمْلٍ جَاذَبَتْهَا وَهَزَّةً","عَرَتْهَا كَمَا هَزَّ الصَّبَا غُصْن النَّقَا",93,"ق",2,0],["وأحق بالتصديق مما يدعي","دعوى تؤيد بالدليل المقنع",94,"ع",1,0],["وأحْقن جسمها أدواءَ شتى","لتعطي نكهة المعنى الشَّبيهِ",95,"ي",2,0],["وأحقُّ من صغتُ الثناءَ لجيدهِ","من ليس إن لبسَ الحليَّ بعاطلِ",96,"ل",1,0]]}