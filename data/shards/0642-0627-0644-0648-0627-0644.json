َقَد ظَلَموا بِالحَقِّ أَنفُسَهُم","وَاللَهُ يَعلَمُ أَنَّ الظالِمينَ هُمُ",1,"م",1,0],["قالوا لَقَد هَجَرَ السِيا","سَةَ وَاِنزَوى في عُقرِ دارِ",2,"ر",1,0],["قَالُوا لِمِثْلِكِ فِي المَدَارِسِ سَلْوَةٌ","كَذَبُوا أَيَسْلُوا كَارِهُ السُّلْوَانِ",3,"ن",1,0],["قَالُوا لِنَابُلْيُونَ ذَاتَ عَشِيَّةٍ","إِذْ كَانَ يَرْقُبُ فِي السَّمَاءِ الأَنْجُمَا",4,"م",2,1],["قالوا لَهُ هَذا عَلَيكَ مُحَرَّمٌ","حَتّى تُبايِعَ لِلغَبِيِّ الأَسوَدِ",5,"د",1,0],["قالوا لَعَلَّكَ مَحزونٌ فَقُلتُ لَهُم","خَلّوا المَلامَةَ لا شَكوى وَلا عِذَرُ",6,"ر",1,0],["قالوا لَهُ أَمرَينِ فَاِختَر فيهِما","فَاِختارَ في الرَأيِ الَذي هُوَ أَرفَقُ",7,"ق",1,0],["قالوا لَنا المُلكُ العَريضُ وَجاهُهُ","كَذَبوا فَإِنَّ المُلكَ لِلرَحمَنِ",8,"ن",1,0],["قالَ وَالنَهرُ كَم طَوى مِن صَبابا","تٍ فَأَطرَقتُ أَستَشِفُّ المِياها",9,"ا",3,0],["قالَ وَاللَيلُ قُلتُ حَسبُكَ إِعنا","تٌ لِنَفسي وَحَسبُ نَفسي دُجاها",9,"ا",3,0],["قالوا لقد مات القريض","بعد من تقدموا",10,"م",3,0],["قالوا لنا اختاروا وما","في الامر اعطونا الخيارا",11,"ر",2,0],["قالوا له فيها الهما","م الفاضل المهذب",12,"ب",1,0],["قالوا لَهُ روحي فِداهُ","هَذا التَجَنّي ما مَداهُ",13,"ا",2,1],["قالوا لَقَد سَمِعَ الغَزالُ لِمَن وَشى","وَأَقولُ ما سَمِعَ الغَزالُ وَلا وَعى",14,"ع",2,0],["قالوا لأَنْفُسِهِمْ يا حَبّذَا نَهَلٌ","مُحَمّدٌ وعليٌّ بعدَهُ صَدَرُ",15,"ر",1,0],["قالوا لَنا ماتَ إِسحاقُ فَقُلتُ لَهُم","هَذا الدَواءُ الَّذي يَشفي مِنَ الحُمُقِ",16,"ق",1,1],["قالوا لَها اِحتَسِبي جَريراً إِنَّهُ","أَودى الهِزَبرُ بِهِ أَبو الأَشبالِ",17,"ل",1,0],["قالوا لِمَا تصلحُ قلتُ الظبا","للصيدِ والأدهمُ للقيدِ",18,"د",1,0],["قالوا لفلانَ أبداً تدقيقُ","في حبك قلت يكذبُ الزنديقُ",19,"ق",1,1],["قالوا لنا نائمٌ فقلنا","بلْ هوَ يقظانُ للمخازي",20,"ي",1,0],["قالوا لنا نائمٌ فقلنا","بلْ هوَ يقظانُ للمعالي",21,"ي",1,0],["قالوا لقدْ كسدَ القريضُ فقلتُ بلْ","عاشتْ ضراغمُهُ وماتَ ضباعُهُ",22,"ه",1,1],["قالوا لمَ تصلحُ قلتُ الظِبا","للصيدِ والأدهمُ للقيدِ",23,"د",1,0],["قالوا له على الورى","كافٌ ورا قلتُ وبا",24,"ب",2,0],["قالوا لها أخطأتِ أنتِ بنجوةٍ","ممّا يروعكِ من أذىً ووَبالِ",25,"ل",1,0],["قالوا لك الأمر فاخترت الكفيَّ لها","وأنت صَاحِبُهُ المَرجوُّ لِلعُضَلِ",26,"ل",1,0],["قال والحج ما جوابك فيه","قلت قد كان لي بحجي سرورُ",27,"ر",1,0],["قالوا لقد صح وحيا","أنا نموت ونحيا",28,"ا",1,0],["قَالُوا لَهَا جَاءَ الغَمَامُ فأَقْبَلتْ","تَسْتَقْبِل الآمالَ في أَنْدَائه",29,"ا",3,0],["قالوا لهم: «حزب الجلاء»، وإنه","لقب يزيد مقامهم تمجيدا",30,"د",2,0],["قالوا: لدينا ذرَّةٌ","فتَّاكةٌ من «هدرجين»",31,"ن",1,0],["قالوا لنا: حسنٌ ترقَّى","فأجبتُ: فاز بما استحقَّا",32,"ق",2,1],["قالوا لنا: شاعرٌ في البصرةِ انقلَبا","فقلتُ: مالَ مِن استقبالها طرَبا!",33,"ب",2,1],["قالوا لخليفة في فاس أحق بها","من فرع عثمان فرع الفضل والجود",34,"د",1,1],["قالوا لشعرك عشاق بودهم","أن يجمعوا بعضه في شبه ديوان",35,"ن",1,0],["قَالُوا لَقَد زَانَ جُملاً جَعلُ لُؤلِئِهَا","حَلياُ فًقُلتُ وأني تَألَفَ العَطَلا",36,"ل",2,0],["قَالوا لَهُ بِأَنَّهُ","فِي هَجْرِهِ قَدْ أَثِمَا",37,"م",2,0],["قالوا له ارجع إن ثم إلى النجا","نهجاً فخذه ولو يشقُّ ويبعدُ",38,"د",1,0],["قالوا لمهدوم الأواخي أطع","فقال لا أفعل قالوا لمه",39,"م",2,0],["قالوا لن الكل يعبد من ربه","حق العبادة لا إلهاً ثاني",40,"ن",2,0],["قالَوا لَهُ هَيهاتَ ذاكَ إِنَّهُ","ما لَكَ في سَلامَةٍ مِن مَطمَعِ",41,"ع",1,0],["قالوا لنَا باقلٌ وَلي فَقُلتُ لَهُم","ما ماتَ مَن ماتَ عَن أَهلٍ وَعَن وَلَدِ",42,"د",1,1],["قالَ والكلّ في يديه أسارى","دون تقييدٍ أنتم الطلقاءُ",43,"ا",2,0],["قالوا لي اش حالك ناديت","واش حال اسير المقلتين",44,"ن",1,0],["قالوا له خال بصفحة خدّه","وتفننوا في كنهه وصفاته",45,"ت",2,1],["قالوا لَها ماذا فَعَلتِ","بِجِفنِ ذَيّاكَ الأَسَد",46,"د",1,1],["قالوا لَها أَوَما حَرامٌ","أَن يُلازِمَهُ النَكَد",46,"د",1,0],["قالوا لَها أَضنَيتِهِ","فَهواكِ من دَمِع اِستَمَد",46,"د",1,0],["قالوا لقينتهم غين عليه لنا","صوتاً ضربنا له في شعره مثلاً",47,"ل",2,0],["قالوا لصفع العباد حتى","يجعل أقفاءهم جذاذاً",48,"ذ",2,0],["قالُوا لَكَ الخَيرُ ما أبصَرتَ قُلتُ لَهُم","جِنِّيَّةٌ أقصَدَتنِي من بني خَلَفِ",49,"ف",1,0],["قال والدمعُ يُوالي","فوق خدّيه انسجامه",50,"م",2,0],["قالوا له إذ تناهى","في الطيب أتعبت نفسك",51,"ك",1,1],["قالوا لِمَن زَعَمَ المَشيبُ مُتَمِّماً","زَينَ الوَقارِ وَقالَ فيهِ هُراءُ",52,"ا",2,1],["قالوا ليّ اركن لأبواب السلاطين","تحز جوائز تغني كلماحين",53,"ن",1,1],["قالوا لَنا قَولُ ما أَرَدنا","وَما لَكُم فيهِ أَن تَقولوا",54,"ل",3,0],["قالوا: لقد كذبَ الحديثَ ، فقلت : م","شأني بمن وضع الحديث وكذَّبا ؟!",55,"ب",2,0],["قالوا لقد صار في مُهذّبكم","شيءٌ به الآن شاعَ في بلدِهْ",56,"د",2,1],["قالوا لنا إن في تاريخكم عبر","وإنما صحفوها فاستوت عربا",57,"ب",2,0],["قالوا لنا فرحات سوف يتركنا","فقلت يا قوم جاء الهم والكدر",58,"ر",1,1],["قالوا له لما رأَوه لها","خذ دَستَها العالي فقلْ واحكُمِ",59,"م",1,0],["قالوا لأنك انفردت بالنظر","بغير رأي من جميع من حضر",60,"ر",1,0],["قالوا له لتعبثنّ الحكما","وغلظوا في القول حتى علما",60,"م",2,0],["قالوا له فمن يلي الحكومة","يحتج في ذلك في الخصومة",60,"ه",1,0],["قالوا له لست تنال الماء","حتى تنال كفك السماء",60,"ا",2,0],["قالوا لهم وعددوا ما عددوا","إذ قال بيعتي عليكم رد",60,"د",1,0],["قَالوا لَنَا عُرِّي فقلنا له","في أَيّ وقت لم يَكُن عَارِيَا",61,"ي",2,1],["قالُوا لَه قَضَى بِذَا ال","جَمْعِ جِناسُ القافِيه",62,"ي",2,0],["قالوا لقد شابَ الحبيبُ","وشابَ فيهِ كُلُّ عَزْمِ",63,"م",1,1],["قالوا لقَدْ أَسْرَفْتَ فيه وما دَرَوْا","أَنَّ اقتصادَ الصَّبِّ في إِسْرَافِه",64,"ف",2,0],["قالوا له مالٌ نعم إِنَّ لي","من جُودِه الفائِض مالٌ وجَاه",65,"ا",2,0],["قالوا لنا اي الرجال الاليق","بكرامة وله الثناء ينمقُ",66,"ق",1,1],["قالوا لنا أين الوزير القادرُ","قلنا لهم ذاك الهمام الماهر",67,"ر",1,1],["قالوا لنا حسنٍ اني ابنُ نصيفِ","فأجبتهم أهلا بخير حصيفِ",68,"ف",1,1],["قالوا لضاء الفضل قلنا ربه","في موكب الفضلا منا قد قرب",69,"ب",1,0],["قالوا لقينا العلم قلت حقيقة","من بحره الفياض كل قد شرب",69,"ب",1,0],["قالوا لنا من أشرف الآنام في","قول وفي فعل اجبنا الصادق",70,"ق",1,0],["قالوا لنا اي الرجال يزينه","علم ومعرفة وفضل رائع",71,"ع",1,0],["قالوا لَكَ اِختارَ السُلُوَّ وَإِنَّما","أَسلو إِذا كانَ الحَبيبُ سِواكا",72,"ك",2,0],["قالوا له هذا اِبن عم","مكَ وهو ذو الحَسَبِ التليدِ",73,"د",1,0],["قالوا له أَخرِجْ لنا من صَخْرَةِ","عشراءَ نَحلِبُها إ