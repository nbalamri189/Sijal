0],["إِذا خِمارُ الظَلامِ لَثَّمَهُ","تَساقَطَت عَن قَميصِهِ التُهَمُ",1,"م",1,0],["إِذا خَلَتِ المَنازِلُ لِلمُوَلّي","فَيا سِرعانَ ما عُزِلَ المُوَلّى",2,"ل",2,0],["إِذا خَبَّ فيهِ مِلءَ حَيزومِهِ الجَوى","تَوَقَّرَ يُخفي مِنهُ غَيرَ الَّذي يُبدي",3,"ي",1,0],["إِذا خَبا بَرقُهُ اِستَعانَ عَلى","إيقادِهِ بِالمُجَلجِلِ اللُجِبِ",4,"ب",1,0],["إِذا خَفَقَت رِياحُ العَزمِ فيها","تَبَلَّجَ عارِضٌ مِنها فَصابا",5,"ب",2,0],["إِذا خَضَبَ الرُمحُ أَدمى بِهِ","كَأَنَّ السِنانَ بَنانٌ خَضيبُ",6,"ب",1,0],["إِذا خَطَرَتْ بِهِ نَمَّتْ عَلَيها","رياحُ التُّبَتِيَّةِ وَالحُلِيُّ",7,"ي",1,0],["إِذَا خَطَرَتْ رِياحُ النَّصْرِ فيها","تَلَقَّتْها خَياشِيمُ العَوالي",8,"ي",1,0],["إذا خَلَّفَتْ بَطْحاءَ نجْدٍ وراءَها","فلسنا بمَنّاعينَ أن تَقفَ الرَّكْبا",9,"ب",2,0],["إِذا خَطَرَت عَبسٌ وَرائِيَ بِالقَن","عَلَوتُ بِها بَيتاً مِنَ المَجدِ مُعلَما",10,"م",2,0],["إِذا خِفنا بُغاةَ الناسِ كُنّا","عَلى حالِ الصَريمَةِ وَالتَقالي",11,"ي",1,0],["إِذا خَدِرَت رِجلي تَذَكَّرتُ مَن لَها","فَنادَيتُ لُبنى بِاِسمِها وَدَعَوتُ",12,"ت",1,1],["إذا خبَرٌ ضُمّتْ إليه قَرينَةٌ","حكَمتَ بظنٍّ ليْسَ بالواهِنِ القُوَى",13,"و",2,0],["إِذا خَرَّ مِنهُ الرَأسُ ثُمَّ نَكستَهُ","غَدا ثاوِياً فَاعجَب وَصَفَّ لَكَ الأَسما",14,"م",2,0],["إِذا خَرَجَت مِن بَيتِها راق عَينَها","مُعَوَّذُهُ وَأَعجَبَتها العَقائِقُ",15,"ق",1,0],["إِذَا خِشِيَ الْجَانِي لِقَاءَ ضَمِيرِهِ","أَدَالَ مِنَ اللَّيْلِ المَصَابِيحَ وَاحْتَمَى",16,"م",2,0],["إِذا خَرَجنَ طَفَلَ الآصالِ","يَركُضنَ رَيطاً وَعِتاقَ الخالِ",17,"ل",1,0],["إِذا خافَ قَلبي جَورَ ساعٍ وَظُلمَهُ","ذَكَرتُكَ أُخرى فَاِطمَأَنَّت بَلابِلُه",18,"ل",2,0],["إِذا خَفَقَتَ بِأمقَهَ صَحصَحانٍ","رُؤوس القَوم وَالتَزَموا الرِحالا",19,"ل",2,0],["إِذا خَشِيَت مِنُه الصَريمَةَ أَبرَقَت","لَهُ بَرقَةً مِن خُلَّبٍ غَيرِ ماطِرِ",20,"ر",1,0],["إِذا خافَ شَيئاً وَقَّرَتهُ طَبيعَةٌ","عَروفٌ لِما خَطَّت عَلَيهِ المَقادِرُ",21,"ر",1,0],["إِذا خَلَّفَت أَعناقُهُنَّ بَسيطَةً","مِنَ الأَرضِ أَو خَشنآءَ أَو جَبَلاً وَعرا",22,"ر",2,0],["إِذا خَطَرَت مِن ذِكرِ مَيَّةَ خَطرَةٌ","عَلى النَفسِ كادَت في فُؤَادِكَ تَجرَحُ",23,"ح",1,0],["إذا خطب العليا تخطّتْ بركبِهِ","على خطر المسعى القنا والقنابلُ",24,"ل",1,0],["إذا خطب الوضيعُ به المعالي","أقام له بنو الشرف الزِفافا",25,"ف",2,0],["إِذا خَطَرَت حَولي رِياحٌ تَضَمَّنَت","بِفَوزِ المَعالي وَالثَأى المُتَفاقِمِ",26,"م",1,0],["إِذا خَلَجوا الأَزِمَّةَ في بُراها","وَأَلصَقنَ المَوارِكَ بِالذَفاري",27,"ي",1,0],["إِذا خَطَرَت عَمروٌ وَرائي وَأَصبَحَت","قُرومُ بَني بَدرٍ تَسامى وَتَصرِفُ",28,"ف",1,0],["إِذا خافَ دَرأً مِن عَدُوٍّ رَمى بِهِ","شَديدُ القُوى وَالنَزعِ في القَوسِ نابِلُ",29,"ل",1,0],["إِذا خِفتُ مِن عَرٍّ قِرافاً شَفَيتُهُ","بِصادِقَةِ الإِشعالِ باقٍ عَصيمُها",30,"م",3,0],["اذا خيط منها جانب راع جانب","أمور مضيع آثر النوم بهل",31,"ل",1,0],["إِذا خِفتُ مِن أَخوالِيَ الرومِ خُطَّةً","تَخَوَّفتُ مِن أَعمامِيَ العُربِ أَربَعا",32,"ع",2,0],["إِذا خَطَروا بِالمَشرِفِيَّةِ وَالقَنا","فَبِخ بِخ لَهُم مِن عُصبَةٍ حينَ تَخطُرُ",33,"ر",1,0],["إذا ختمت تعاد فكل تال","له وقفٌ عليها وابتداء",34,"ا",2,0],["إذا خطرت في الروض طاب كلاهما","فلم يذْرِ من أزهى وأشهى وأعطر",35,"ر",1,0],["إذا خطا نفحت أعطافه أرجاً","نفحَ الثناءِ عليكم يا بني اللكز",36,"ز",1,0],["إذا خطّ فوق الطرس سهم يراعه","طربت لتخطيط الرداء المسهَّم",37,"م",1,0],["إذا خاطبتي في هواهُ عواذلي","مضيتُ على حالي وقلت سلاما",38,"م",2,0],["إذا خلعت وجه الفلا بمناسمٍ","تفاءل حادِيها بنيل مرام",39,"م",1,0],["إذا خاب داعٍ أو تناهَى دعاؤه","فإنّيَ داعٍ والإلهُ مجيبُ",40,"ب",1,1],["إذا خُلَّةٌ خانتك بالغيب عهدها","فلا تجعلنَّ الحزنَ ضربةَ لازِبِ",41,"ب",1,1],["إذا خلونَ بمنْ يهوَينَ خَلْوتَهُ","بذلنَ في ذاك ما أثَّلنَ من نَشَبِ",42,"ب",1,0],["إذا خامرا نفسَ امرئٍ زيّنا له","سدى أو ندى أو وِرْدَ موتٍ يُغامسه",43,"س",2,0],["إِذا خافَ مِن نَجمٍ عَلَيها ظَماءَةً","أَدَبَّ إِلَيها جَدوَلاً يَتَسَلسَلُ",44,"ل",1,0],["إِذا خَفَقَت عَلَيَّ وَأَلبَسَتني","مَلامِعَ آلِها البيدُ القِفارُ",45,"ر",1,0],["إِذا خَطَرَت مِن جانِبِ الشَرقِ نَفحَةٌ","طَرِبتُ فَأَلقى مَنكِبايَ رِدائِيا",46,"ي",2,0],["إِذا خَرَجَت تَحتَ الظَلامِ فَلا تُرى","مِنَ الضَعفِ إِلّا أَن يُصَكَّ لِجامُها",47,"م",3,0],["إِذا خَطَت أَقدامُهُ","كانَت بِها مُعَثَّرَه",48,"ر",2,0],["إِذا خَبَّ رَقراقٌ مِنَ الآلِ بَينَنا","رَفَعنا قُروناً خَطوُها مُتَواتِرُ",49,"ر",1,0],["إِذا خَفَقَت مَشافِرُها وَظَلَّت","بِسيرَتِها مُصانِعَةً ذَقونا",50,"ن",2,0],["إِذا خالَطنَ هامَةَ تَغلِبِيٍّ","فَلَقنَ الرَأسَ مِنهُ وَالجَبينا",50,"ن",2,0],["إِذا خَدِرَت رِجلي وَقيلَ شِفاؤُها","دُعاءُ حَبيبٍ كُنتِ أَنتِ دُعائِيا",51,"ي",2,0],["إِذا خَفَضتُ جَناحَ الذُلِّ أَسأَلُهُ","عِزَّ الشَفاعَةِ لَم أَسأَل سِوى أُمَمِ",52,"م",1,0],["إِذا خانَ عَبدُ السوءِ مَولاهُ مُعتَقاً","فَما يَفعَلُ الكَريمُ المُهَذَّبُ",53,"ب",1,0],["إِذا خَيالاتُهُ أَطَفنَ بِنا","أَضحَكَهُ أَنَّني لَها حامِد",54,"د",1,0],["إِذا خَلَت مِنكَ حِمصٌ لا خَلَت أَبَداً","فَلا سَقاها مِنَ الوَسمِيِّ باكِرُهُ",55,"ر",2,0],["إِذا خانَتهُ في يَومٍ ضَحوكٍ","فَكَيفَ تَكونُ في يَومٍ عَبوسِ",56,"س",1,0],["إِذا خَلَعتُ عَلى عِرضٍ لَهُ حُلَلاً","وَجَدتُها مِنهُ في أَبهى مِنَ الحُلَلِ",57,"ل",1,0],["إِذا خافَ مَلكٌ مِن مَليكٍ أَجَرتَهُ","وَسَيفَكَ خافوا وَالجِوارَ تُسامُ",58,"م",1,0],["إِذا خاضَ في تهويمةِ الفجرِ عينُه","نفَى نومَه وخزُ الندوبِ القدائمِ",59,"م",1,0],["إِذا خاضَ بحراً لم يُبقِّ صدورُهُ","لإعجازهِ في البحر نُغْبَةَ شاربِ",60,"ب",1,0],["إِذا خَلا جَوُّهُ لِلريحِ عارِضَةً","قالَت مَعَ العُفرِ أَو حَنَّت مَعَ النيبِ",61,"ب",1,0],["إِذا خَيَّموا في الدارِ ضاقَت رِباعُها","وَإِن رَكِبوا في الأَرضِ ثارَ عَجاجُها",62,"ج",3,0],["إِذا خَرِسَ الأَبطالُ في حَمَسِ الوَغى","عَلَت فَوقَ أَصواتِ الحَديدِ زَماجِرُه",63,"ر",2,0],["إِذا خُطامَةُ سارَت فيهِ آخِذَةٌ","خِطامَ نَبهانَ وَهيَ الشَوكُ وَالشَجَرُ",64,"ر",1,0],["إِذا خَطَرَت تَأَرَّجَ جانِباها","كَما خَطَرَت عَلى الرَوضِ القَبولُ",65,"ل",1,0],["إِذا خِفتَ أَو لَم تَستَطِع خَوضَ غَمرَةٍ","لِقَومٍ ذَوي دَرءٍ لَجَأتَ إِلى سَعدِ",66,"د",1,0],["إِذا خِندِفٌ جاءَت وَقَيسٌ إِذ اِلتَقَت","بِرُكبانِها حَجٌّ مِلاءٌ مَشاعِرُه",67,"ر",2,0],["إِذا خَطَرَت حَولي الرَبابُ وَمالُكٌ","وَعَمروٌ وَسَعدُ الخَيرِ بِخبِخ بِذا فَخرا",68,"ر",2,0],["إِذا خِندِفٌ بِاللَيلِ أَسدَفَ سَجرُها","وَجاشَت مِنَ الآفاقِ بِالعَدَدِ الدَثرِ",69,"ر",1,1],["إِذا خِندِفٌ بِالأَبطَحَينِ تَغَطرَفَت","وَرائي وَقَيسٌ ذَيَّلَت بِالمُشَرِّقِ",70,"ق",1,0],["إِذا خَمَدَت نارٌ فَإِنَّ اِبنَ غالِبٍ","سَتوقِدُها لِلطارِقينَ خَلائِقُه",71,"ه",1,1],["إِذا خَرَجَت مِنّي تَرى كُلُّ شاعِرٍ","يَدِبُّ وَيَستَخذي لَها حينَ تُرسَلُ",72,"ل",1,0],["إِذا خُيِّرَ السيدِيُّ بَينَ غَوايَةٍ","وَرُشدٍ أَتى السيدِيُّ ما كانَ غاوِيا",73,"ي",2,0],["إذا خطرَت فما للقُمْصِ إلا","مصافحةُ الرَّوادِفِ والنُّهودِ",74,"د",1,0],["إذا خرَّت عليه رأيتَ بحراً","تَخُرُّ عليه من بحرٍ مُدودُ",75,"د",1,0],["إِذا خامَرَتهُ الراحُ أَبقَت رَوِيَّةً","مِنَ الرَأيِ لا تَخفى عَليها المَصالِحُ",76,"ح",1,0],["إذ أخذ البدرُ المنير مكانه","ومُلِّك آفاق السما وتمكنا",77,"ن",2,0],["إذا خلعوا بعض الوقار فدعهم","فمثلك عن مثل الذي صنعوا عفا",78,"ف",2,0],["إذا خَلَلٌ في الحالِ منك وَجَدْتَهُ","فإيّاكَ والتعويلَ منهم على خِلِّ",79,"ل",1,0],["إذا خفَقَ البَرْدُ بي خِلْتَني","عَلى كورها طائِراً يَنتَفِضْ",80,"ض",1,0],["إذا خاض منها الماءُ في مُضْمَر الحشا","بدا الدرّ منها بين طافٍ وراسِبِ",81,"ب",1,0],["إِذا خَفَقَت بالبَذلِ أَرواحُ جودِهِم","حَداها النَدى وَاِستَنشَقَتها المَطامِعُ",82,"ع",1,0],["إِذا خُراسانُ عَن صِنِّبرِها كَشَرَت","كانَت قَتاداً لَنا أَنيابُها العُصُلُ",83,"ل",1,0],["إِذا خَلَعَ اللَيلُ النَهارَ رَأَيتَها","بِإِرقالِها مِن كُلِّ وَجهٍ تُقابِلُه",84,"ل",2,0],["إِذا خَرَجَت مِنَ الغَمَراتِ قُلنا","خَرَجتِ حَبائِساً إِن لَم تَعودي",85,"د",2,0],["إِذا خَدِرَت رِجلي ذَكَرتُكِ صادِقاً","وَصَرَّحتُ إِذ أَدعوكِ بِاِسمِكِ لا أُكني",86,"ن",2,1],["إِذا خَفَقَت مِنهُ نُجومٌ فَحَلَّقَت","تَبَيَّنتُ مِن تالي النُجومِ رَعيلا",87,"ل",2,0],["إِذا خَلَجَت عَيني أَقولُ لَعَلَّها","لِرُؤيَتِها تَهتاجُ عَيني وَتَضرِبُ",88,"ب",1,0],["إِذا خَدِرَت رِجلي أَبوحُ بِذِكرِها","لِيَذهَبُ عَن رِجلي الخُدورُ فَيَذهَبُ",88,"ب",1,0],["إِذا خَطَّ سَطراً بَينَ عَينَيَّ مُذهَباً","تَدارَكَهُ قَطرُ الدُموعِ فَأَعجَما",89,"م",2,0],["إِذا خِفنا مِنَ الرُقَباءِ عَيناً","تَكَلَمَتِ العُيونِ عَنِ القُلوبِ",90,"ب",1,1],["إذا خَفضوا الجناحَ لكم رَضيتم","أعزّاءَ المعاطِسِ كابرينا",91,"ن",2,0],["إِذا خَرَجَت عَن يَدَيكَ السِهامُ","غَدا كُلُّ عُضوٍ لَها مَقتَلا",92,"ل",2,0],["إِذا خُلِّفتَ عَبدَ اللَهِ فَاِعلَم","بِأَنَّ القَومَ لَيسَ لَهُم جَزاءُ",93,"ا",2,0],["إِذا خافَ وارى أَنفَهُ مِن عَدُوِّهِ","وَإِن لَم يَخَفهُ باتَ غَيرَ نَؤومِ",94,"م",1,0],["إِذا خَلَّفتُ باطِنَتي سَرارٍ","وَبَطنِ هُضاضَ حَيثُ غَدا صُباحُ",95,"ح",1,0],["إِذا خاطَ عَينَيهِ كَرى النَومِ لَم يَزَل","لَهُ كالِئٌ مِن قَلبِ شَيحانَ فاتِكِ",96,"ك",1,0],["إِذا خافَ إِصعاباً مِنَ الأَمرِ صَدرُهُ","عَلاهُ فَباتَ الأَمرُ وَهُوَ رَكوبُ",97,"ب",1,0],["إِذا خَرَجَت أَوائِلُهُنَّ يَوماً","مُلَجلَجَةً بِجِنٍّ عَبقَرِيِّ",98,"ي",1,0],["إِذا خافَكَ القَومُ اللِئامُ وَجَدتَهُم","سَراعاً إِلى ما تَشتَهي وَتُريدُ",99,"د",1,1],["إذا خُلّةٌ بانَتْ لَهَوْنا بذِكْرِهَا","وإنْ أقفَرَتْ دارٌ كَفَتنا المَعالم",100,"م",1,0],["إذا خَرِسَ الأبطالُ راقَك مُقدِماً","بحيث الوشيجُ اللَّدنُ تُعطفُ والنَّبع",101,"ع",1,0],["إِذا خَطَرَت فيكَ الهُمومُ فَداوِها","بِكَأسِكَ حَتّى لا تَكونَ هُمومُ",102,"م",1,1],["إِذا خَزَنَ المالَ البَخيلُ فَإِنَّما","خَزائِنُهُ خَطِّيَّةٌ وَدُروعُ",103,"ع",1,0],["إِذا خَلَصَ النادي بِزَيدٍ فَكُلُّهُم","يَرى وَجهَ عَبدٍ في النِداءِ مُنادِ",104,"د",1,0],["إِذا خَلّى مَكانَ المُلكِ رَوحٌ","فَلَيسَ لِمَن يُطيفُ بِهِ رُقادُ",105,"د",1,0],["إِذا خَدِرَت رِجلي شَفَيتُ بِذِكرِها","أَذاها فَأَهفو بِاِسمِها حينَ تُنكَبُ",106,"ب",1,0],["إِذا خَرَجَت مِن عَينِهِ قُلتُ لَيتَني","يَجوبُ الدُجى مِنها حَرارٌ وَتَنعَبُ",106,"ب",1,0],["إِذا خافَت الأُسدُ الخِماصُ مِنَ الظُبى","فَكَيفَ تَعَدّى حوكمَهُنَّ ظِباءُ",107,"ب",3,0],["إِذا خَمِصتُ قَليلاً","عَدَدتُ ذَلِكَ قُربَه",108,"ب",2,0],["إِذا خَلِقَ الإِنسانُ ظَلَّ حِمامُهُ","وَإِن نالَ يُسراً مَن أَجَلَّ المَواهِبِ",109,"ب",1,0],["إِذا خَلَجَتني مِن حَياةٍ مَنيَّةٌ","فَلَستُ عَلى الباغي العَدُوِّ بِحاقِدِ",110,"د",1,0],["إِذا خَشِيَت أُمٌّ عَلى اِبنٍ مَنِيَّةً","فَيا أُمَّ دَفرٍ قَد أَمِنتِ عَلى دَفرِ",111,"ر",1,0],["إِذا خَطَبَ الزَهراءَ كَهلٌ وَناشِئٌ","فَإِنَّ الصِبا فيها شَفيعٌ مُشَفَّعُ",112,"ع",1,1],["إِذا خَضَعَت أَعناقُ رَهطٍ لِكِفرِهِم","فَأعناقُ طُلّابِ الهُدى غَيرُ خُضَّعِ",113,"ع",1,0],["إِذا خَطَبَ الزَهراءَ شَيخٌ لَهُ غِنىً","وَناشِئُ عُدمٍ آثَرَت مَن تُعانِقُ",114,"ق",1,1],["إِذا خَزَنوني في الثَرى فَمَقالِدي","مُضَيَّعَةٌ لا يُحسنُ الحِفظَ خُزّاني",115,"ي",1,0],["إِذا خَلَجَت بَوارِقُ في هَزيعٍ","دَعَوتُ فَقُلتُ يا مَوتُ اِختَلِجني",116,"ي",1,0],["إِذا خُشِيَت لِشَرٍّ عَجَّلَتهُ","وَإِن رُجِيَت لِخَيرٍ عَوَّقَتهُ",117,"ت",2,0],["إذا خَفَقَتْ لمَغْرِبِها الثّريّا","تَوَقّتْ من أسِنّتِهِ اغْتِيالا",118,"ل",2,0],["إذا خفقَ البرْقُ الحِجازِيُّ أعْرَضَتْ","وتَرْنو إذا برْقُ العِراقِ أنارا",119,"ر",2,0],["إِذا خافَ مِنهُنَّ اللِحاقَ نَمَت بِهِ","قَوائِمُ حَمشاتُ الأَسافِلِ روحُ",120,"ح",1,0],["إذا خلق الثوب الَّذي يلبس الفَتى","فأخلق بأن يستبدل الثوب لابس",121,"س",1,0],["إذا خلَت الدنيا من النفر الألى","أَحب فؤادي فالسَلام عَلى الدنيا",122,"ي",2,0],["إذا خَلَتِ الأرضُ من طيرهم","فمن ذا يُحيّي الجمالَ القسيمْ",123,"م",1,0],["إذا خِلَلُ السّيوفِ بَلِينَ يوماً","تَبَلّجَ لا تَرِثّ له خِلال",124,"ل",1,0],["إِذا خَصمي تَقاضاني بِدَينِ","قَضَيتُ الدَينَ بِالرُمحِ الرُدَيني",125,"ي",1,1],["إِذا خَطَرَت عَبسٌ وَرائِيَ بِالقَنا","عَلَوتُ بِها بَيتاً مِنَ المَجدِ مُعلَما",126,"م",2,0],["إِذا خَفَقَ البَرقُ مِن حَيِّهِم","أَرِقتُ وَبِتُّ حَليفَ السُهادِ",127,"د",1,0],["إِذَا خَطَرَتْ مِنْ نَحْوِ حُلْوَانَ نَسْمَةٌ","نَزَتْ بَيْنَ قَلْبِي شُعْلَةٌ تَتَوَقَّدُ",128,"د",1,0],["إِذْ أَخَذَتْهُمْ صَيْحَةٌ مِنْ عَلٍ","تَنْقَضُّ أَوْ تَطْفِرُ مِنْ مَطْفِرِ",129,"ر",1,0],["إِذا خافَ مِنها ضِغنَ حَقباءَ قِلوَةٍ","حَداها بِصَلصالٍ مِنَ الصَوتِ جادِفِ",130,"ف",1,0],["إِذا خافَ إِقواءً بِأَرضٍ تَفاضَلَت","بِهِ عَجِلاتٌ سَيرُهُنَّ نَصيبُ",131,"ب",1,0],["إِذَا خَطَرتَ بِنَادِي الْقَوْمِ حَلُّوا","مِنَ الإِكْبَارِ مَعْقُودَ الْحُبَاءِ",132,"ا",2,0],["إذا خاطبتَهُ في غير لِينٍ","تأوَّه، أو تنهَّد في الخطاب",133,"ب",1,0],["إذا خطرت منك الهموم فداوها","بأصغر حتى لا تكون هموم",134,"م",1,0],["إذا خَافَ إصْعَاباً مِنَ الأَمْرِ صَدْرُهُ","علاه بتات الأمر وهو رَكوب",135,"ب",1,0],["إذا خدرت رجلي شفيت بذكرها","أَذَاها فأهْفُوا باسْمِها حِينَ تُنْكَبُ",136,"ب",1,0],["إذا خرجت من الأغماد يوما","رأيت الهول والفتح المبينا",137,"ن",2,0],["إِذَا خَلَّفْتُ بَاطِنَتَيْ سَرَارٍ","وَبَطْنَ هُضَاضَ حَيْثُ غَذَا صُبَاحُ",138,"ح",1,1],["إذا خَاطَ عَيْنَيْهِ كَرى النَّوْمِ لَمْ يَزَلْ","لَهُ كَالِىءٌ مِنْ قَلْبِ شَيْحَانَ فَاتِكِ",139,"ك",1,0],["اذا خَطَروا فالبِيضُ تنطفُ بالدِّماء","تحييّ خُطاهم . والجماجمُ تنشر",140,"ر",1,0],["إذا خلصَتْ مِن عَثْرةٍ طوَّحتْ بها","عَواثرُ مَن يُؤخذْ بها فهو مُحْرَب",141,"ب",1,0],["إذا خانتك موهبةٌ فحقُ","سبيل العيشِ وَعْرٌ لا يُشَقُ",142,"ق",1,1],["إذا خلَى جَوُّهُ للرّيحِ، عَارِضَةً،","قالَتْ مَعَ العُفْرِ أوْ حَنّتْ مَعَ النِّيبِ",143,"ب",1,0],["إذا خدعت فقد جازيت خدعته","بالعذر أبسطه والذنب أطويه",144,"ي",2,0],["إذا خامرا نفسَ امرىء ٍ زينا له","سدى أو ندى أو وِرْدَ موتٍ يُغامسه",145,"س",2,0]]}