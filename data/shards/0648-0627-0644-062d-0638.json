{"poems":[[55,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[65,"أضاء بريق بالعذيب كليل","https://www.aldiwan.net/poem46146.html","الطويل"],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[49,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[74,"إنسان عيني بتعجيل السهاد بلي","https://www.aldiwan.net/poem19471.html","البسيط"],[93,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[87,"سويجع النيل رفقا بالسويداء","https://www.aldiwan.net/poem63685.html","البسيط"],[99,"شَجنٌ على شَجنٍ وحرقةُ نارِ","https://www.aldiwan.net/poem24753.html","الكامل"],[46,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[71,"لا تحرصن على فضل ولا أدب","https://www.aldiwan.net/poem28843.html","البسيط"],[48,"عاشوا كما عاش آباء لهم سلفوا","https://www.aldiwan.net/poem22332.html","البسيط"],[48,"إلهنا الحق خفف واشف من وصب","https://www.aldiwan.net/poem23395.html","البسيط"],[48,"روح تعدن قضي اليوم وانتظري","https://www.aldiwan.net/poem23472.html","البسيط"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[164,"التام جرح والاساة غيب","https://www.aldiwan.net/poem59006.html","الرجز"],[182,"هد الجوى ركبي","https://www.aldiwan.net/poem50687.html","المواليا"],[190,"أهل الزمان تميزوا","https://www.aldiwan.net/poem43465.html","مجزوء الكامل"],[190,"يا فاضلا حاز فخر الفضل عن أدبه","https://www.aldiwan.net/poem44113.html","البسيط"],[264,"في بحر ملكك يا رب الوجود جرت","https://www.aldiwan.net/poem35812.html","البسيط"],[275,"سل الشواطئ ما أبقين من جسدي","https://www.aldiwan.net/poem35626.html","البسيط"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[325,"الحظ قد أوفى وأوفى بالمنن","https://www.aldiwan.net/poem67166.html","الكامل"],[325,"آل القنال تباشروا وتشكروا","https://www.aldiwan.net/poem67203.html","الكامل"],[325,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[325,"الأنس ساد برتبة الجمال","https://www.aldiwan.net/poem67217.html","الكامل"],[398,"انظر اليه كأنه","https://www.aldiwan.net/poem53499.html","مجزوء الكامل"],[422,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[438,"لو لم يحرم على الأيام إنجادي","https://www.aldiwan.net/poem12352.html","البسيط"],[438,"ضربوا الخيام على الندى والخيم","https://www.aldiwan.net/poem12387.html","الكامل"],[438,"متى يملك الحلم الدنو على البعد","https://www.aldiwan.net/poem12601.html","الطويل"],[443,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[484,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[556,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138367",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87280","المتدارك"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105519","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6759","السريع"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6763","السريع"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202167","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71058","السريع"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137938",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109389","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109426","السريع"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77200","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106854","الرجز"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87698","الرجز"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107183","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94202","المجتث"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94062","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94094","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94195","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94171","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94135","الدوبيت"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94083","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93803","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94204","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94176","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94132","المجتث"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94052","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94044","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93828","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93804","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93820","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94261","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94145","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93821","البسيط"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146358","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118786","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134200","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100832","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130044","الرجز"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141898","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91234","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133292","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133281","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90995","الكامل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4778,"الصدق جُنّة","https://www.poetsgate.com/ViewPoem.aspx?id=188142",""],[585,"هي لفتةٌ أوحت إلي الموعدا","https://www.poetsgate.com/ViewPoem.aspx?id=161932",""],[5186,"تلك الخمائل ما تمايل بأنها","https://www.poetsgate.com/ViewPoem.aspx?id=156464",""],[5376,"قد زاد شوقي كما النيران فاحتدما","https://www.poetsgate.com/ViewPoem.aspx?id=188561",""],[5401,"عندي أمل","https://www.poetsgate.com/ViewPoem.aspx?id=85960",""],[5493,"صهوةُ الصدق","https://www.poetsgate.com/ViewPoem.aspx?id=197404",""],[5538,"الأنس حل فزالت الأتراح","https://www.poetsgate.com/ViewPoem.aspx?id=142644",""],[6085,"سر ياقلم","https://www.poetsgate.com/ViewPoem.aspx?id=8675",""],[1333,"يا أيها المغتر بالله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56036&r=&rc=14",""]],"verses":[["وَالحُظوظُ البَلهاءُ مِن ذي اللَيالي","أَنكَحَت بِنتَ عامِرٍ مِن ثَقيفِ",0,"ف",1,0],["وألْحَظُهُ شَزْراً بمُقْلَةِ أجْدَلٍ","لهُ نَطَراتٌ كلُّهُنَّ عَجولُ",1,"ل",1,0],["وَالْحَظّ أَمْرٌ لَيْسَ فِي وُسْعِ امْرِئٍ","فَمُكَثِّرٌ فِي كَدِّهِ ومُقَلِّلُ",2,"ل",1,0],["وَأَلحَظُ أَحوالَ الزَمانِ بِمُقلَةٍ","بِها الصُدقُ صِدقٌ وَالكِذابُ كِذابُ",3,"ب",1,0],["والحظ مدائح عبدٍ قد أجادَ بما","جادت يداك بهِ من ماطرٍ هطل",4,"ل",1,0],["وَأَلحَظُ شَمسَ الأُفق وَهيَ مُطِلَّةٌ","تُسايِرُ فيها ظِلَّها إِذ تُسايِرُه",5,"ر",2,0],["وَأَلحَظُ الأَرضَ أَطوي ما يَكونُ إِلى","ما كانَ مِن آدَمٍ فيها وَحَوّاءِ",6,"ا",2,0],["والحظُّ أطمارٌ كما شاء البلى","والعيشُ رثٌ والسنونُ عوارِ",7,"ر",1,0],["وَالحَظُّ يُعطاهُ غَيرُ طالِبِهِ","وَيُحرِزُ الدَرَّ غَيرُ مُحتَلِبِه",8,"ب",2,0],["والحظُّ أنفعُ منْ حظٍّ تزوقُهُ","فما يفيدُ قليلَ الحظِّ تزويقُ",9,"ق",1,0],["وَالحَظُّ يَسري فَيُغشى مَعشَراً حُسِبوا","مِنَ اللِئامِ وَتُقضى دونَهُ المُجُدُ",10,"د",1,0],["وَالحَظُّ مِن غَيرِ سَعيٍ مِن مَواهِبِهِ","كَأَنَّها ضَربُ أَيسارٍ بِأَزلامِ",11,"م",1,0],["وَالحَظُّ أَغلَبُ كَم بَيتٍ لِمَكرُمَةٍ","سُدىً يَظَلُّ وَبَيتٌ لِلخَنى سُدِنا",12,"ن",2,0],["والحظ كاب عقير في براثنها","كأنه أمل ينتاشه أجل",13,"ل",1,0],["والحظ يكسو المرء ثوب غيره","ويوجب الأمر الذي لا يجب",14,"ب",1,0],["والحَظُّ ما أشْقاهْ","قدْ حارَ في أمْري",15,"ي",1,0],["والحظ كونك في الخمو","ل عساه ينفعك الخمول",16,"ل",1,0],["والحظ في قسمة الأرزاق عند فنى","سرّ يدِقّ على ذي اللب في عجبه",17,"ب",2,0],["والحَظْ فلحظك أرخنا تأملها","واجعل ببحرك بسم الله مجراها",18,"ا",3,0],["والحظُّ لما طلبتُ المالَ أرجعني","صفرَ اليدينِ إذا فَتّشتُ لم أجد",19,"د",1,0],["وَاِلحظ بِلحظِ الإعتبارِ محدّقاً","فيما تسرّ بهِ النفوسُ وتبخعُ",20,"ع",1,0],["وَالحَظُّ كُلُّ الحَظِّ أَن أَولاهُمو","بِمَحاسِنَ الأَلطافِ مِن بَعدِ الوَهَنِ",21,"ن",1,0],["وَالحَظُّ أَشرَقَ في سَماءِ سُعودِكُم","وَاليُمنُ وافاكُم يُمني بِالنَوالِ",22,"ل",1,0],["وَالحَظُّ آلى لَيسَ يَبرَحُ بِالمُنى","يَسعى إِلَيكَ مَدى الزَمانِ وُفودُهُ",23,"د",2,0],["وَالحَظ راقٍ بِسوقِ مَيدانِ الصَفا","وَرَبَت مَسَرَّتُهُ عَلى الأَموالِ",24,"ل",1,0],["وَالحَظ مَحاسِنَ خَدِّهِ","تَعذر دُموعي حينَ تَذرف",25,"ف",1,0],["والحظّ يصلد في يديَّ زناده","إنِّي أُعيذُك من صُلود زناده",26,"د",2,0],["وأَلحَظُ الشُّرفاتِ البِيضَ مُشْرِفَةً","كالبَيْضِ مُشْرِفَةً في هامِ أَنْجادِ",27,"د",1,0],["والحظُّ حتَّى في الحروفِ مُؤَثِّرٌ","تختصُّ بالتدقيقِ والتفخيمِ",28,"م",1,0],["وألحظُ خلاً لا يُخِلُّ بودِّه","ولا يرتضي إلا الثبوتَ على العَهْدِ",29,"د",1,0],["والحظي لديكمُ في انتقاض","ومديحي لمجدكم في تمام",30,"م",1,0],["والحظّ تُخدِجُ أمُّهُ","لي أو تُتِمُّ فتُحمِقُهْ",31,"ق",2,0],["والحظ بطرفك طاقات الزهور على ال","أفنان والزهر مجموع ومنتقم",32,"م",1,0],["وَأَلحَظْتَ أعيُنَهم غُرّةً","تفارقُ مِنها الجسومُ الطُلى",33,"ا",1,0],["والحظ القاني بمصلحتي التي","القى على البؤس فيها كلكلا",34,"ل",2,0],["وألحظه في كل بر وجاحد","فكل وجود فيه حضرة واحد",35,"د",1,0],["وَالحظوةِ مَع طُول العُمرِ","وَحَميدِ السيرة والذكرِ",36,"ر",1,0],["وَالحَظُّ لِلجهلِ خِدْنٌ لا يُفارِقُهُ","وَالفَضلُ للحظِّ ضدٌّ في العُقولِ جلي",37,"ل",2,0],["والحظ حمى عبدك المسعود من سعدت","به البسيطة واغمرها بجدواه",38,"ا",2,0],["والحظ بنيك بعطفةٍ","أفلست خير أب عطوف",39,"ف",1,0],["وَالحَظ بِعَينَيكَ أَديمَ السَما","مِن طالِعٍ فيها وَمِن آفِلِ",40,"ل",1,0],["وَاِلحَظ بِعَينَيكَ أَديمَ السَما","وَما بِها مِن حِكمَةِ اللَهِ",41,"ل",2,0],["والحظُّ يومَ الجُودِ مِنك مُوَفَّر","للكلِّ لا نَزْرٌ ولا مَبْخوسٌ",42,"س",1,0],["وَالْحَظْهُ يا مولاي لَحْظاً به","يُصْبِحُ من مَحْبسِهِ مُعْتَقا",43,"ق",2,0],["والحظ أظفرها بأحسن فرصةٍ","سنحت لها لتنال منها المغنما",44,"م",2,0],["والحظ في الناس رزق ساقه قدرٌ","منهُ لكل امرء تأتيه قسمته",45,"ت",2,0],["والحظ قد أمسى بها توأماً","حيث جلاها عيدُنا الأكبر",46,"ر",1,0],["وَالحَظونا في الماءِ نَسقي حُفاةً","وَلأَسنانِنا شِتاءً صَريرُ",47,"ر",1,0],["والحظُّ حظي فليكن لي الهنا","والعمر عمري فليكن لكِ البقا",48,"ق",2,0],["وَالحَظُّ لِأَعداك يَوماً حَظُّ","وَقاية مِن الشَقا وَحفظ",49,"ظ",1,0],["وَالحَظ إِلَى الجَنَّةِ في القُرآنِ","تَزِدكَ في عِبادَةِ الرَّحمنِ",50,"ن",1,0],["وَالحَظ إِلى النار تَجِدها ناهِيَه","عَن طُرُقٍ إِلى الفَسادِ غاوِيَه",50,"ه",1,0],["والحظ لي قال أرخ","أبشر بعثمان نجلك",51,"ك",1,0],["والحظ مذ وافى المقام مؤرخاً","أبدى به أزهى وأبهج منظره",52,"ر",2,0],["والحظ قالت تهانيه تؤرخها","قدوم عام جديد قد أتى بسرور",53,"ر",1,0],["والحظ قال مؤرخاً","شمس تزين للقمر",54,"ر",1,0],["والحظ قالت تهانيه مؤرخة","أزهى بها الدنيا ختان الهامي",55,"م",2,0],["والحظ بدا يقول مذ أرخها","ذا العام قدومه قدوم حسن",56,"ن",1,0],["والحظ قالت تهانيه مؤرخة","بشر بأسعد نجل مفرد طاهر",57,"ر",1,0],["والحظ قال بملء فيه مؤرخا","نعم القدوم هذا الوال",58,"ل",1,0],["والحظ قد وافى يقول مؤرخاً","سعد الصعيد بدا بهذا الأصفي",59,"ف",2,0],["والحظ وافت تهانيه يؤرخها","عام أتى قاد ما فيه السرور بدا",60,"د",2,0],["والحظ لي قال أرخ","عيد كما تشتهيه",61,"ه",1,0],["والحظ قالت تهانيه مؤرخة","لمصر بشر بإبراهيم والعدل",62,"ل",1,0],["والحظ نادى مقبلاً أن أرخوا","بتاج إبراهيم بشرى المجد",63,"د",1,0],["والحظ وافى يقول أرخ","هذا مدير هو الأمير",64,"ر",1,0],["والحظ وافى خادماً لجنابه","وله الهناء مساعد وملازم",65,"م",1,0],["والحظ وافى لنا يختال في حلل","لها طراز المعالي باهر الحبك",66,"ك",1,0],["