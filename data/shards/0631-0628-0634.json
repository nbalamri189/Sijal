{"poems":[[95,"يا غرباء الحمى سلاما","https://www.aldiwan.net/poem11291.html","مخلع البسيط"],[93,"لا تسلني عن السماء فما عندي","https://www.aldiwan.net/poem8720.html","عموديه"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[91,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[91,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[91,"رمت للقوم نهضة في الحياة","https://www.aldiwan.net/poem44919.html","الخفيف"],[87,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[68,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[99,"إن تجد يا قلب قلباً قد لها","https://www.aldiwan.net/poem24347.html","الرمل"],[71,"رب شيعية إلى برد فيها","https://www.aldiwan.net/poem28157.html","الخفيف"],[17,"نطفة ما منيت يوم منيت","https://www.aldiwan.net/poem1193.html",""],[48,"صاحب الشرطة إن أنصفني","https://www.aldiwan.net/poem23428.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[108,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[226,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[376,"رب شيء تراه يحسن في عي","https://www.aldiwan.net/poem57027.html","البسيط"],[376,"إن تخطاني زماني","https://www.aldiwan.net/poem57086.html","مجزوء الرمل"],[396,"يا غياث المستغيثين أغث","https://www.aldiwan.net/poem54550.html","عموديه"],[411,"سيدي أنت لا تخل بخل","https://www.aldiwan.net/poem50086.html","الخفيف"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[563,"رب شخص تقوده الأقدار","https://www.aldiwan.net/poem34547.html","الخفيف"],[580,"رب شخص سمج مستقذر","https://www.aldiwan.net/poem2811.html","الرمل"],[580,"رب شهر قد نعمت به","https://www.aldiwan.net/poem2829.html","المديد"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53711","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38321","الخفيف"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122912","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109211","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95569","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202132","الخفيف"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202565","المتقارب"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136896","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137167",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94298","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94299","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93916","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94253","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201605","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201171","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202711","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204663","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205054","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115793","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65263","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87505","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97898","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112292","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35887","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205677","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216378","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205667",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85187","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114244","المديد"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69980","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136927",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83347","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83664","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204281","الخفيف"],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5186,"إن في مشهد الطبيعة حسنا","https://www.poetsgate.com/ViewPoem.aspx?id=156503",""],[5338,"نبهتني والكرى يطوي الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=187811",""],[5409,"نال فيك الغرب يا علم المراما","https://www.poetsgate.com/ViewPoem.aspx?id=155311",""],[5431,"صنعاء_خذلته الأبوة الغرّاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=198199",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[402,"يا غرباء الحمى سلاما","https://www.poetsgate.com/ViewPoem.aspx?id=36423",""],[6055,"إلى الحداثة....مع التحية","https://www.poetsgate.com/ViewPoem.aspx?id=30577",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[5393,"رب شيخ يمد للحق رجلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85468&r=&rc=35",""]],"verses":[["رُبَّ شُيُوخٍ شَقُوا طَوِيلاً","لَمْ يَبْلِغُوا ذَلِكَ المَقَامَا",0,"م",2,0],["رُبَّ شَيءٍ كَالجَوهَرِ الفَردِ فَذِّ","عَدَّدَتهُ الأَغراضُ وَالأَهواءُ",1,"ا",2,0],["رُبَّ شَخصٍ عُشتُ مَعهُ زَمَناً أَلهو وَأَمرَح","أَو مَكانٍ مَرَّ دَهر وَهوَ لي مَسرى وَمَسرَح",2,"ح",1,0],["رُبَّ شَيخٍ أَقعَدَتهُ الحادِثاتُ","وَمَشى الأَبيَضُ في لِمَّتِهِ",3,"ه",1,0],["رب شعر له الملائك تعنو","وهي لله سجد وركوع",4,"ع",1,0],["رب شعر على الاجادة فيه","كان منهم فريسة الاحقاد",5,"د",1,0],["رب شعب يشق ان الجأ الامر","الى السلم بالحراب الطريقا",6,"ق",2,0],["رب شعر كأن ابياته في","السمع مجموعة من الشهقات",7,"ت",1,0],["رُبَّ شَيبٍ بَنَت صُروحَ المَعالي","سَنَتاهُ وَشادَتِ المَجدَ ساعُه",8,"ع",2,0],["رَبِّ شُقتَ العِبادَ أَزمانَ لا كُت","بٌ بِها يُهتَدى وَلا أَنبِياءُ",9,"ا",2,0],["رُبَّ شِعرٍ لَم يَتَّبِع ما رَوى الغا","وُونَ لَكِن بِالفَضلِ يَهدي غُواتَه",10,"ت",2,0],["رُبَّ شمسٍ منحتنَا ظلَّهَا","وتخلَّت غفرَ الله لَهَا",11,"ه",2,0],["ربَّ شيعيَّةٍ إلى بردِ فيها","بيَ حرٌّ وجفنُها في فتورِ",12,"ر",1,1],["رُبَّ شَتمٍ سَمِعتُهُ فَتَصامَم","تُ وَغَيٍّ تَرَكتُهُ فَكُفيتُ",13,"ت",1,0],["رُبَّ شَيخٍ ظَلَّ يَهديهِ إِلى","سُبُلِ الحَقِّ غُلامٌ ما اِحتَلَم",14,"م",1,0],["رب شعر أنفقته في سبيل ال","حق حتى أضرَّ بي إنفاقي",15,"ق",2,0],["رُبَّ شَيْبٍ أَتَمَّ حُسْناً وَأَوْلَى","وَاهِنَ العَزْمِ صَوْلَةَ الْجَبَّارِ",16,"ر",1,0],["ربّ شاكٍ فقدَ العيون ولا","ينفكّ يهدي العيون للمبصرينا",17,"ن",2,0],["رُبَّ شيعَةٍ ظَهَرَت","بِاِقتِدارِ مظهِرِها",18,"ر",3,0],["ربَّ شيخٍ في عالَمِ الطبِّ حيٌّ","ويراه الزمانُ من أمواتهْ",19,"ت",2,0],["رُبَّ شَيْخٍ أفنَى سَوادَ الليالي","ساهِدَ العَيْنِ جاهِداً غَيْرَ واني",20,"ن",2,0],["رُبَّ شِعْرٍ لَه يُرَدِّدُه الدهْرُ","فتُصْغِي مَسامِعُ الأكوانِ",20,"ن",1,0],["ربَّ شعرٍ مقعدٍ هو مرآ","ةٌ لما في النفوس من تعقيد",21,"د",1,0],["رُبَّ شَوْهَاءَ لا ترى الأُم فيها","غيرَ حسناءَ لم تَلِدْها النساءُ",22,"ا",2,0],["رب شكل له بباطن نفسي","أثر لا تحده أفكاري",23,"ر",2,0],["رب شخص اذا تجسد معنى","فيه ما كان غير وحش ضاري",23,"ر",2,0],["رب شخص تراه يرفل في السندس","من حلة الفضائل عاري",23,"ر",2,0],["ربَّ شَيءٍ تَراهُ يحسُنُ في عَي","نِكَ حتى تردَّ عينكَ عَنهُ",24,"ن",2,1],["ربَّ شَأنٍ عِندَه","أفسَدَهُ إِصلاحُ شاني",25,"ن",2,0],["رب شفع سيدي في وقل","فوق ما أملت يا مسكين هاك",26,"ك",1,0],["رُبَّ شِعرٍ لَّمامَدَحتُكَ فيهِ","سارَ في العالَمِينَ بُعداً وقُرْبا",27,"ب",2,0],["رب شبابٍ ليلُهُ","يصبح تنعاه الأُزُرُ",28,"ر",1,0],["رب شخص تقوده الأقدارُ","للمعالي وما لذاك اختيارُ",29,"ر",1,1],["رُبَّ شَخْصٍ سَمِجٍ مُسْتَقْذَرٍ","وَسِخ الأَثْوابِ فَوَّاج السَّهَكْ",30,"ك",1,1],["رُبَّ شهْرٍ قد نَعِمْتُ به","حين رقَّتْ لِي حواشِيهِ",31,"ي",2,1],["رُبَّ شعر قد قلته بتباهٍ","وَيغرَّى به ذوو الألبابِ",32,"ب",1,0],["ربُّ شِعرٍ بِحِكمَةٍ لا تُضاهى","يَتَمنّى أَن نالَها سَحبانُ",33,"ن",1,0],["رب شكوى من الصد","يق الى غير ذي شجن",34,"ن",1,0],["ربَّ شيخ ذاب منه حسداً","وقديماً كان في الناس الحسد",35,"د",1,0],["رب شر يراه ذو الجهل خيراً","منه ذو العقل يستحث الفناءَ",36,"ا",2,0],["رُبَّ شخصٍ محجَّبٍ من وراء ال","رَسمِ مني لا يقبل الاِبتِساما",37,"م",2,0],["رب شمطاء تركناها وقد","ركد الليل وأرخى الطنبا",38,"ب",2,0],["رب شعر لك كالريح سرى","يقطع الأرض سهولا وحزون",39,"ن",1,0],["رب شيخ عاد فيه يافعاً","بين حور ناعمات الخدعين",40,"ن",1,0],["رب شخص يبيت ضاحك سن","وتراه لدى الصباح عبوسا",41,"س",2,0],["رب شمس غابت وقد ناب عنها","بدر تم بدا ينير دجنات",42,"ت",1,0],["رب شمل بالوصل طاب اجتماعاً","غال أسبابه النوى باقتطاع",43,"ع",1,0],["رب شرب قد باكروها اصطباحا","مذ أتى أنف صبحهم بالعطاس",44,"س",1,0],["رب شرح أتى بما هو مغن","عن غوان كزينب ورقاش",45,"ش",1,0],["رُبّ شعر نظمتُه كالثريا","يملأ النفس والمسامع وحيا",46,"ي",2,1],["ربّ شعرٍ نظمته كالثريا","عدت من حسنه أُسبّح ربي",47,"ي",1,1],["رُبَّ شرٍّ مزعجٍ عند الورى","هو خيرٌ مبهجٌ في نظري",48,"ر",2,0],["رب شعر مثل الطلا يسكر المرء","وفيها شقاؤه وبلاه",49,"ا",2,0],["رب شعر سام رأى قيد وزن","فر لما رأى القيود قصيا",50,"ي",2,0],["رُبَّ شيخ رأيته ذات يوم","واهى العقل واهنَ الجسم فاني",51,"ن",2,1],["رُبّ شوّاش مُشوشُ","مُنعش للقلب مُدهشُ",52,"ش",1,1],["ربَّ شخصٍ حَياتُهُ دارُ حربِ","بين شتمٍ لذا ومن ذا وَثَلبِ",53,"ب",1,1],["رب شيءٍ إن أحرم النفس منه","وهو طوعى يكن نصيب المعزى",54,"ز",2,0],["ربّ شيء بَعدما قَد صَعَبَا","هَوّنَتهُ حَادثاتُ الغِيَرِ",55,"ر",1,0],["رُبّ شاعِرٍ","يقطنُ الأطُم",56,"م",1,0],["رُبَّ شِعرٍ نَقَدتُهُ مِثلَ ما يَن","قُدُ رَأسُ الصيارِفِ الدينارا",57,"ر",2,1],["رب شعر أَمدَّ من طول حزني","تتمنى سوادَه الليلاء",58,"ا",2,0],["ربَّ شعرٍ شاقني لمَّا تكدْ","شفتا قائله تنفرجان",59,"ن",1,0],["رب شادٍ في هجرة يتغنَّى","وعليه السلام والتسليم",60,"م",1,0],["رُبَّ شكٍ هو في الأن","قس شرٌّ من غراب",61,"ب",1,0],["رب شخص أعيد من بعد موت","من كراماتكم من الأحياء",62,"ا",2,0],["رُبَّ شَمسٍ طَلَعَت بِدُجًى","فَمَحَت حَالِكَهُ أنواَرَا",63,"ر",2,1],["رَبّش صنهُ للدَوامِ","تاجَ هامات الكِرامِ",64,"م",1,0],["ربّ شعبٍ مقمصٍ بفتاة","كان أولى بعبرة الناظرينا",65,"ن",2,0],["ربّ شفّعه بي بِفَضلِكَ وَاِمنُن","يا كَريم العَطا بِحُسن الخِتامِ",66,"م",1,0],["رَبّ شَفّع بِنا الشَفيع المُرَجّى","وَاِنصُر الدينَ أَنتَ نِعمَ النَصيرُ",67,"ر",1,0],["رب شعر أطاله طول معنا","ه وإن قلَّ لفظه حين يروى",68,"و",2,1],["رب شخص يموت من موته الده","ر وتهوي لفقده الجوزاء",69,"ا",2,0],["رب شعر جم الأمانة لكن","ريشة الرسم كل معنى الأمانه",70,"ن",2,0],["رَبِّ شَفِّعْهُ بِيَوْمِ الْحَشْرِ فِي","عَبْدِكَ الجَانِي إذَا عَزَّ الرَّجَا",71,"ج",2,0],["رب شر سنح الخير به","ودواءٍ أولدوا منه سقاما",72,"م",2,0],["ربّ شِبْلٍ مكبّل في حروبٍ","أضرمتها الأبوة الغَرَّاءُ !!",73,"ا",2,0],["رُبَّ شعبٍ قد تَاه في الدَّربِ حيناً","ذاتَ صُبحٍ يزيحُ عنه غُباره",74,"ر",2,0],["رُبَّ شَوقٍ طَائِرٍ فِي لَيْلَةٍ","بَدرُها في أُفْقِها لم يَطْلُع",75,"ع",1,0],["ربَّ شكوى بمجلس الأمن لم","تُقضَ حواها ملفّيَ المرْكونُ",76,"ن",1,0],["رب شيوخ شقوا طويلا","لم يبلغوا ذلم المقاما",77,"م",2,0],["رب شهمٍ وشاعرٍ خدعوه","فنسى ذلك الحصانُ صهيله",78,"ل",2,0],["رُبَّ شادٍ ؛ كَأَنَّهُ فِي حُبُورٍ","يَتَسَلَّى , وَ قَلبُهُ فِي حِدادِ !",79,"د",1,0],["رب شخص يوليك وجهاً حيياً","في المآسي يوليك وجهاً صفيقا",80,"ق",2,1],["رب شيخ يمد للحق رجلاً ..","كان حيناً يعد ثبتاً صدوقا..",80,"ق",2,0]]}