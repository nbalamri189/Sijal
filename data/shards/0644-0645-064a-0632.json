يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[458,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[458,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[458,"في الظباء الغادين أمس غزال","https://www.aldiwan.net/poem56073.html","الخفيف"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[458,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[461,"هو في ناديه طود راسخ","https://www.aldiwan.net/poem15398.html","الرمل"],[461,"يعجز في مدحه وقد علمت","https://www.aldiwan.net/poem15447.html","المنسرح"],[465,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[479,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[500,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[514,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[515,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[538,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[551,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[551,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[558,"ربنا الله شارع الأحكام","https://www.aldiwan.net/poem33883.html","الخفيف"],[558,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[558,"إن شمسي من طاقتي في طلوع","https://www.aldiwan.net/poem34378.html","الخفيف"],[558,"أيها البرق اللموع","https://www.aldiwan.net/poem34383.html","مجزوء الرمل"],[558,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"],[575,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[586,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["لَم يَزَل يَطوي هَواهُ عَنكُمُ","زَمَناً حَتّى رَأى وَجهَ الطَلَب",0,"ب",1,0],["لَم يَزوِهِ طِرَدٌ فَيُذعَرَ دَرؤُهُ","فَيُلِجَّ في وَهَلٍ وَفي تَشرادِ",1,"د",1,0],["لَم يَزِدهُم سَفاهَةً شَربَةُ الكَأ","سِ وَلا اللَهوُ بَينَهُم وَالسِباقُ",2,"ق",1,0],["لَم يُزَحزِحكَ عَن نُهوضِكَ بِالأَعبا","ءِ داءٌ يُهِدُّ أُسدَ الدِحالِ",3,"ل",1,0],["لَم يَزِدكَ الوِسامُ قَدراً وَلَكِن","زادَ قَدرَ العُلا وَقَدرَ الكَرامَه",4,"م",2,0],["لَم يَزَل مُغضِياً عَلى هَفوَةِ الجاني","مُصيخاً إِلى اِعتِذارِ الكَريمِ",5,"م",1,0],["لَم يَزِده تَقَادُمُ العَهدِ إِلاَّ","جِدَّةً عِندَنا وَحُسنَ احتِلاَلِ",6,"ل",1,0],["لم يزل الدهر بعد مقتله","يضرب في الشعر للورى مثله",7,"ل",2,0],["لم يزل جوده يجور على الما","ل إلى أن كسى النضار اصفرارا",8,"ر",2,0],["لم يزل يجعلُ المساءَ صباحاً","كلما بُدِّل الصباحُ مساءَ",9,"ا",2,0],["لم يزل قَيِّماً لها ذا اخْتِباطٍ","يتأتى لصدْعِها بسدَادِهْ",10,"د",2,0],["لم يَزل طرْفُهُ حبيساً على العُر","ف يرى الغيَّ في المكارم رُشدا",11,"د",2,0],["لم يزل بي تنزُّهي","فيه باللمس والنظرْ",12,"ر",1,0],["لم يزل يبنَى بناء ال","مجد مرفوعَ المنار",13,"ر",1,0],["لم يزل سادراً يسير ويسري","منِ هواه المضلِّ في إمْليس",14,"س",1,0],["لم يزل بين نكبة وهجاءٍ","ظالم الشعرِ في أحر وطيس",14,"س",1,0],["لم يزالوا مُفَضَّلين على النا","س بحُكمَي مُغاضبٍ ومُراضي",15,"ض",2,0],["لم يزل قلبه إليهم مشوقا","ثم أضحى لديهم معلوقا",16,"ق",2,1],["لم يُزهَ بالدولةِ الزهراءِ حاشَ له","مِنْ شيمةٍ تستحقُّ اللومَ والعذلا",17,"ل",2,0],["لم يزلْ غُرّةً يتيهُ بها الده","رُ إذا ما الكرام كانوا حُجولهْ",18,"ل",2,0],["لم يزل خالدٌ لَدُن كانَ طِفلاً","مُرْضَعاً والأيورُ أكبرُ هَمِّهْ",19,"ه",1,1],["لم يزل شاملَ المنافع للأمْ","مَة طُرّاً مَأْمُومِها والإمام",20,"م",1,0],["لم يزل كل عاجل من عطايا","ه بشيراً بآجلٍ مستدامِ",20,"م",1,0],["لم يَزَلْ ذا تَفَقُّد للخفايا","مُذْكياتٍ على الصَّديقِ عُيونه",21,"ن",2,0],["لم يزل للسَّكَنْجَبينِ قرينُ","إن نأى عنه فهو صَبٌّ حزينُ",22,"ن",1,1],["لَم يَزَل لِلصَيفِ فيها عَبَقٌ","وَسَماءُ الصَيفِ ما زالَت سَماها",23,"ا",3,0],["لَم يَزَل مِنّي إِلَيهِ ال","كَأسُ أَو مِنهُ إِلَيّا",24,"ي",2,0],["لَم يَزَل بي مِنَ القِما","طِ هَواكُم إِلى الكَفَن",25,"ن",1,0],["لَم يَزَل عِندَ المَجوسِيِّ","لَها قَدرٌ عَظيمُ",26,"م",1,0],["لَم يَزَل يَنزِلُ الخَمائِلَ حَتّى","حَلَّ في رَبوَةٍ عَلى سَلسَبيلِ",27,"ل",1,0],["لَم يَزِد في الحَديدِ وَالنارِ إِلّا","لَمحَةً حُرَّةً وَصَبراً جَميلا",28,"ل",2,0],["لَم يُزهِهِ فيهِمِ وَهُم سُوَقٌ","في العَينِ وَطءُ المُلوكِ في عَقِبِه",29,"ب",2,0],["لَم يَزَل حَقُّكَ المُقَدَّمُ يَمحو","باطِلَ المُستَعارِ حَتّى اِضمَحَلّا",30,"ل",2,0],["لَم يَزَل شُؤمُكَ المُجَرَّبُ في الأَح","زابِ قِدماً حَتّى عَزَلتَ أَخانا",31,"ن",2,0],["لَم يَزَلِ القانِعونَ أَشرَفَنا","يا حَبَّذا القانِعونَ ما قَنِعوا",32,"ع",3,0],["لَم يَزَل هارونُ خَيراً كُلُّهُ","قُتِلَ الشَرُّ بِهِ يَومَ خُلِق",33,"ق",1,0],["لَمْ يَزَلْ يَرْضَعُ السُّلافَةَ حَتَّى","غَابَ عَنَّا كَأَنَّهُ لَيْسَ مِنَّا",34,"ن",2,0],["لم يَزَلْ يَسألُهُ حتَّى بَدا","من يقينِ الأمرِ ما كانَ اسْتتَر",35,"ر",1,0],["لَم يَزدنا قُدومك اليَوم عَلماً","بِكَ يا صاحب البَنان النَديه",36,"ي",2,0],["لَم يَزَل يَرقوصُ وَهوَ طَروبٌ","ثُمَّ عَلَّقنا عَلَيهِ القِيانا",37,"ن",2,0],["لَم يَزَل ليلَتُهُ في","فَلَكِ السُكرِ يُدار",38,"ر",1,0],["لَم يَزَل يَلمَعُ بِاللَيلِ حَتّى","خِلتُهُ نَبَّهَ فيهِ صَباحا",39,"ح",2,0],["لم يَزِدْهُ كَشْفُ الغِطاءِ يَقِيناً","بَل هُوَ الشمْسُ ما عليه غِطاءُ",40,"ا",2,0],["لَمْ يَزَلْ مِنْ عُلومِهِ وَتُقاهُ","بين تاجٍ مِنْ سُؤدُدٍ وسَريرِ",41,"ر",1,0],["لم يَزِدْنَا القُربُ إلاّ هِجْرَةً","فرَضينَا بالتَّنائي والبِعاد",42,"د",1,0],["لَم يَزَل مُذ كانَ في الدَر","سِ عَنِ الدَرسِ يَحيدُ",43,"د",1,0],["لَم يَزُر مِن سُكّانِها حادِثُ الأَي","يامِ إِلّا فَتىً أُعينَ بِصَبرِ",44,"ر",1,0],["لم يزلِ البيتُ طولَ غيبتهِ","أعمى فلما اسْتَوى بهِ أبصَرْ",45,"ر",1,0],["لم يزل لي عقيدة ذاك حتى","حال من هول القبر فيَّ الشعور",46,"ر",1,0],["لم يَزَل منه في المسامع صوتٌ","تتوقّى الظُّبى صداهُ وترهبْ",47,"ب",1,0],["لم يزَلْ منكمو على الأرض ظِلٌ","وشعاعٌ هادٍ وغيثٌ مُصوّبْ",47,"ب",1,0],["لم يَزَلْ يُغري بنا بنتَ الكرومْ","ويُثيرُ الوجدَ في عشاقها",48,"ه",2,0],["لم يَزَلْ يروي وتُصغي للرواياتِ الدهورُ","والضفافُ الخضر سكرى والسَّنى كاسٌ تدورُ",49,"ر",1,0],["لم يَزَل اللّيْلُ مُقيماً يرى","ما لا رأتْ عادٌ ولا جُرْهُم",50,"م",1,0],["لَمْ يُزَاوِل نَظْمَ القَرِيضِ وَلَكِنْ","بَزَّ أَسْمَى النَّظِيمِ مِنهُ النَّثِيرُ",51,"ر",1,0],["لَمْ يُزْه يَوْماً جَمَالُ مَالِكةٍ","بِمِثْلِهَا مِنْ نَفائِسِ الدرِّ",52,"ر",1,0],["لَمْ يُزَايِلْ كِرَامَهَا عَنْ قِلىً كَلاَّ","وَلَمْ يَسْمَحُوا بِهِ عَنْ جُودِ",53,"د",1,0],["لَمْ يَزَلْ يَدْأَبُ فِي مَطْلَبِهِ","وَنَصِيرَاهُ رَجَاءٌ وَأَنَاةُ",54,"ه",1,0],["لم يَزْهُها ضافي المديح ولم تكن","في الحق ترهب صولةَ النقَّاد",55,"د",1,0],["لم يَزُرْها وشْيُ الرّبيع ولكنْ","لك ما شئْتَ من نسيجِ الرِّمال",56,"ل",1,0],["لم يَزَلْ صاحبي يُعالِجُ مِنْهُنَّ نِفارا","مُسْتَعْصِياًن ويُعانِي",57,"ن",2,0],["لم يزل ما كتبته يسكر الكون","ويجري كالشهد تحت لساني",58,"ي",1,0],["لم يَزلَ يَحْفِرُها حتى جرى","ماؤُها وهْوَ مشُوبٌ بدماهْ",59,"ا",2,0],["لم يزيِّنْ ثِيابَه النقشُ؛ لكن","زيَّن الطهرُ والعفافُ ثيابه",60,"ب",2,0],["لم يَزَلْ منكم على الأرض ظِلٌّ","وشعاعٌ هادٍ، وغيثٌ مُصوَّبْ",61,"ب",1,0],["لمْ يزورهِ طردٌ فيذعرَ درؤهُ،","فيلجَّ في وهلٍ وفي تشرادِ",62,"د",1,0],["لمْ يَزَلْ حَقُّكَ المُقَدَّمُ يَمْحُو","باطلَ المُستَعَارِ، حتّى اضْمخَلاًّ",63,"ل",2,0],["لم يَزَلْ شُؤْمُكَ المُجَرَّبُ في الأَح","زَابِ قِدْماً حَتَّى عَزَاْتَ أَخَانَا",64,"ن",2,0],["لَمْ يَزدْهُ اللهُ إِلاَّ فِي","التَّمَادِي فِي خَبَالِهْ",65,"ل",2,0],["لم يزل للسَّكَنْجَبينِ قرينَ","إن نأى عنه فهو صَبٌّ خرينُ",66,"ن",1,1],["لم يزالوا مُفَضَّلينَ على النا","س بحُكمي مُغضبٍ ومُراضي",67,"ض",2,0],["لم يزل بي إلى الشباب وأيا","م له قد ذهبن عنه نزوع",68,"ع",1,0],["لم يَزَلْ صاحبي يُعالِجُ مِنْهُ","نَّ نِفارا مُسْتَعْصِياً ويُعانِي",69,"ن",2,0],["لم يزل في الوداد يرقب قلبي","ذمة َ فيكم وعهداً والاّ",70,"ل",2,0],["لم يزل يقتلُ العبادَ بطرفٍ","بقيتْ حمرةُ الدّما بإزائه",71,"ا",3,0],["لم يزل ملكُكم قويّاً وجَدْوَا","كمْ عزيزاً وبابُكم مقصودَا",72,"د",2,0],["لم يزلْ قدُّها يقدِّدُ قلبي","وكذا خدُّها يخدُّ فؤادِي",73,"ي",1,0],["لم يزل تابع الفسوق مسوقاً","بالمقادير نحوها مَزموما",74,"م",2,0],["لَم يَزَل جانِبي مَنيعاً مَهيباً","مُذ رَأَتني بِكَ الخُطوبُ مُهيبا",75,"ب",2,0],["لَم يَزَل في جَزيلِ جَدواهُ حَتّى","فِضتُ مِن بَعضِهِ نَوالاً جَزيلا",76,"ل",2,0],["لَم يَزل فينا رَبيعٌ مُربِعٌ","وَحِمىً حامٍ وَهادٍ لِرَشادِ",77,"د",1,0],["لَم يَزَلْ صافي الفُؤادِ نَقيّاً","لَم تَصلْ عِندَهُ الخَبائثُ حَبلا",78,"ل",2,0],["لم يزل يخبز الأرز إلى أن","ناطهُ الصبر بالمحل الرفيع",79,"ع",1,0],["لَم يَزل سارياً سُرى الشمسِ والده","رُ منَ الشركِ ليلةٌ ليلاءُ",80,"ا",2,0],["لَم يَزَل سارياً إلى أَن تجلّت","شمسُ أنوارهِ وفاض الضياءُ",80,"ا",2,0],["لم يُزاحِم مدّاحكَ البعضَ بعضاً","أنتَ بحرٌ والمادحون دلاءُ",80,"ا",2,0],["لم يَزَل ناطقاً يُناغيكَ حتّى","كادت الأرضُ تحتنا أن تَمُورا",81,"ر",2,0],["لم يزل شامخاً على مضض","حاسر دون شأوه الجبل",82,"ل",1,0],["لم يزعزعني مصاب عن هوى","يلج النفس بباب المقل",83,"ل",1,0],["لم يزَل بي ساقى التَسَلّي يُساقي","ني كُئوساً من بعدِها ما ظَميتُ",84,"ت",1,0],["لم يزل يحسن البلاغ إلى أن","عُبد الله في الذرى والشناظ",85,"ظ",1,0],["لَم يَزَل مُغرَماً بِحُبِّكَ حَتّى","كَشَفَ الوَجدُ وَالغَرام قِناعَه",86,"ع",2,0],["لَم يَزَل يُنذِرُ بِالخَص","بِ رُبا الحَزنِ الظِماءا",87,"ا",3,0],["لم يزل جودُه يساوي به العا","فين مالا ولا أقول يواسي",88,"ي",1,0],["لم يزل قلبي يراه حسناً","ما رآه المؤمنون حسنا",89,"ن",2,0],["لم يزل يرفل في ثو","ب كمالٍ وسياده",90,"د",2,0],["لم يزل فيهِ صبيّاً ضاحكاً","يفتحُ الصَّدرَ لطيبِ النفس",91,"س",1,0],["لم يَزَل فيكَ فؤادٌ خافقٌ","أبداً أسمَعُ منه الخفقان",92,"ن",1,0],["لَم يَزَلْ عَطْفُ الأَميرِ المُرْتَضَى","ونَداهُ أبداً يُنْعِشُنِي",93,"ي",1,0],["لَم يَزَلْ يُتْبِعُ المَقَالَ فِعَالاً","والحُسَامُ الهِنْدِيُّ إنْ صَلَّ صَالا",94,"ل",2,0],["لَمْ يَزِنْ دمْلجُها مِعْصَمَها","ذَلِكَ المِعْصمُ زان الدّمْلُجَا",95,"ج",2,0],["لَم يَزَل يَرغَمُ العَدُوَّ وَيَسعى","رافِلاً في مَطارِفِ النعماءِ",96,"ا",2,0],["لَم يَزَل مُنجِباً أَبوكُم فَما بُش","شِرَ إِلّا بِالسادَةِ النُجَباءِ",96,"ا",2,0],["لَم يَزالوا شاهِري أَسيافِهِم","لِنِزالٍ أَو لأَن يَقروا نَزيلا",97,"ل",2,0],["لم يزل يسلس القياد","لمن 