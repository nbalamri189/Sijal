ٍ وَفي تَشرادِ",1,"د",1,0],["لَم يَزِدهُم سَفاهَةً شَربَةُ الكَأ","سِ وَلا اللَهوُ بَينَهُم وَالسِباقُ",2,"ق",1,0],["لَم يُزَحزِحكَ عَن نُهوضِكَ بِالأَعبا","ءِ داءٌ يُهِدُّ أُسدَ الدِحالِ",3,"ل",1,0],["لَم يَزِدكَ الوِسامُ قَدراً وَلَكِن","زادَ قَدرَ العُلا وَقَدرَ الكَرامَه",4,"م",2,0],["لَم يَزَل مُغضِياً عَلى هَفوَةِ الجاني","مُصيخاً إِلى اِعتِذارِ الكَريمِ",5,"م",1,0],["لَم يَزِده تَقَادُمُ العَهدِ إِلاَّ","جِدَّةً عِندَنا وَحُسنَ احتِلاَلِ",6,"ل",1,0],["لم يزل الدهر بعد مقتله","يضرب في الشعر للورى مثله",7,"ل",2,0],["لم يزل جوده يجور على الما","ل إلى أن كسى النضار اصفرارا",8,"ر",2,0],["لم يزل يجعلُ المساءَ صباحاً","كلما بُدِّل الصباحُ مساءَ",9,"ا",2,0],["لم يزل قَيِّماً لها ذا اخْتِباطٍ","يتأتى لصدْعِها بسدَادِهْ",10,"د",2,0],["لم يَزل طرْفُهُ حبيساً على العُر","ف يرى الغيَّ في المكارم رُشدا",11,"د",2,0],["لم يزل بي تنزُّهي","فيه باللمس والنظرْ",12,"ر",1,0],["لم يزل يبنَى بناء ال","مجد مرفوعَ المنار",13,"ر",1,0],["لم يزل سادراً يسير ويسري","منِ هواه المضلِّ في إمْليس",14,"س",1,0],["لم يزل بين نكبة وهجاءٍ","ظالم الشعرِ في أحر وطيس",14,"س",1,0],["لم يزالوا مُفَضَّلين على النا","س بحُكمَي مُغاضبٍ ومُراضي",15,"ض",2,0],["لم يزل قلبه إليهم مشوقا","ثم أضحى لديهم معلوقا",16,"ق",2,1],["لم يُزهَ بالدولةِ الزهراءِ حاشَ له","مِنْ شيمةٍ تستحقُّ اللومَ والعذلا",17,"ل",2,0],["لم يزلْ غُرّةً يتيهُ بها الده","رُ إذا ما الكرام كانوا حُجولهْ",18,"ل",2,0],["لم يزل خالدٌ لَدُن كانَ طِفلاً","مُرْضَعاً والأيورُ أكبرُ هَمِّهْ",19,"ه",1,1],["لم يزل شاملَ المنافع للأمْ","مَة طُرّاً مَأْمُومِها والإمام",20,"م",1,0],["لم يزل كل عاجل من عطايا","ه بشيراً بآجلٍ مستدامِ",20,"م",1,0],["لم يَزَلْ ذا تَفَقُّد للخفايا","مُذْكياتٍ على الصَّديقِ عُيونه",21,"ن",2,0],["لم يزل للسَّكَنْجَبينِ قرينُ","إن نأى عنه فهو صَبٌّ حزينُ",22,"ن",1,1],["لَم يَزَل لِلصَيفِ فيها عَبَقٌ","وَسَماءُ الصَيفِ ما زالَت سَماها",23,"ا",3,0],["لَم يَزَل مِنّي إِلَيهِ ال","كَأسُ أَو مِنهُ إِلَيّا",24,"ي",2,0],["لَم يَزَل بي مِنَ القِما","طِ هَواكُم إِلى الكَفَن",25,"ن",1,0],["لَم يَزَل عِندَ المَجوسِيِّ","لَها قَدرٌ عَظيمُ",26,"م",1,0],["لَم يَزَل يَنزِلُ الخَمائِلَ حَتّى","حَلَّ في رَبوَةٍ عَلى سَلسَبيلِ",27,"ل",1,0],["لَم يَزِد في الحَديدِ وَالنارِ إِلّا","لَمحَةً حُرَّةً وَصَبراً جَميلا",28,"ل",2,0],["لَم يُزهِهِ فيهِمِ وَهُم سُوَقٌ","في العَينِ وَطءُ المُلوكِ في عَقِبِه",29,"ب",2,0],["لَم يَزَل حَقُّكَ المُقَدَّمُ يَمحو","باطِلَ المُستَعارِ حَتّى اِضمَحَلّا",30,"ل",2,0],["لَم يَزَل شُؤمُكَ المُجَرَّبُ في الأَح","زابِ قِدماً حَتّى عَزَلتَ أَخانا",31,"ن",2,0],["لَم يَزَلِ القانِعونَ أَشرَفَنا","يا حَبَّذا القانِعونَ ما قَنِعوا",32,"ع",3,0],["لَم يَزَل هارونُ خَيراً كُلُّهُ","قُتِلَ الشَرُّ بِهِ يَومَ خُلِق",33,"ق",1,0],["لَمْ يَزَلْ يَرْضَعُ السُّلافَةَ حَتَّى","غَابَ عَنَّا كَأَنَّهُ لَيْسَ مِنَّا",34,"ن",2,0],["لم يَزَلْ يَسألُهُ حتَّى بَدا","من يقينِ الأمرِ ما كانَ اسْتتَر",35,"ر",1,0],["لَم يَزدنا قُدومك اليَوم عَلماً","بِكَ يا صاحب البَنان النَديه",36,"ي",2,0],["لَم يَزَل يَرقوصُ وَهوَ طَروبٌ","ثُمَّ عَلَّقنا عَلَيهِ القِيانا",37,"ن",2,0],["لَم يَزَل ليلَتُهُ في","فَلَكِ السُكرِ يُدار",38,"ر",1,0],["لَم يَزَل يَلمَعُ بِاللَيلِ حَتّى","خِلتُهُ نَبَّهَ فيهِ صَباحا",39,"ح",2,0],["لم يَزِدْهُ كَشْفُ الغِطاءِ يَقِيناً","بَل هُوَ الشمْسُ ما عليه غِطاءُ",40,"ا",2,0],["لَمْ يَزَلْ مِنْ عُلومِهِ وَتُقاهُ","بين تاجٍ مِنْ سُؤدُدٍ وسَريرِ",41,"ر",1,0],["لم يَزِدْنَا القُربُ إلاّ هِجْرَةً","فرَضينَا بالتَّنائي والبِعاد",42,"د",1,0],["لَم يَزَل مُذ كانَ في الدَر","سِ عَنِ الدَرسِ يَحيدُ",43,"د",1,0],["لَم يَزُر مِن سُكّانِها حادِثُ الأَي","يامِ إِلّا فَتىً أُعينَ بِصَبرِ",44,"ر",1,0],["لم يزلِ البيتُ طولَ غيبتهِ","أعمى فلما اسْتَوى بهِ أبصَرْ",45,"ر",1,0],["لم يزل لي عقيدة ذاك حتى","حال من هول القبر فيَّ الشعور",46,"ر",1,0],["لم يَزَل منه في المسامع صوتٌ","تتوقّى الظُّبى صداهُ وترهبْ",47,"ب",1,0],["لم يزَلْ منكمو على الأرض ظِلٌ","وشعاعٌ هادٍ وغيثٌ مُصوّبْ",47,"ب",1,0],["لم يَزَلْ يُغري بنا بنتَ الكرومْ","ويُثيرُ الوجدَ في عشاقها",48,"ه",2,0],["لم يَزَلْ يروي وتُصغي للرواياتِ الدهورُ","والضفافُ الخضر سكرى والسَّنى كاسٌ تدورُ",49,"ر",1,0],["لم يَزَل اللّيْلُ مُقيماً يرى","ما لا رأتْ عادٌ ولا جُرْهُم",50,"م",1,0],["لَمْ يُزَاوِل نَظْمَ القَرِيضِ وَلَكِنْ","بَزَّ أَسْمَى النَّظِيمِ مِنهُ النَّثِيرُ",51,"ر",1,0],["لَمْ يُزْه يَوْماً جَمَالُ مَالِكةٍ","بِمِثْلِهَا مِنْ نَفائِسِ الدرِّ",52,"ر",1,0],["لَمْ يُزَايِلْ كِرَامَهَا عَنْ قِلىً كَلاَّ","وَلَمْ يَسْمَحُوا بِهِ عَنْ جُودِ",53,"د",1,0],["لَمْ يَزَلْ يَدْأَبُ فِي مَطْلَبِهِ","وَنَصِيرَاهُ رَجَاءٌ وَأَنَاةُ",54,"ه",1,0],["لم يَزْهُها ضافي المديح ولم تكن","في الحق ترهب صولةَ النقَّاد",55,"د",1,0],["لم يَزُرْها وشْيُ الرّبيع ولكنْ","لك ما شئْتَ من نسيجِ الرِّمال",56,"ل",1,0],["لم يَزَلْ صاحبي يُعالِجُ مِنْهُنَّ نِفارا","مُسْتَعْصِياًن ويُعانِي",57,"ن",2,0],["لم يزل ما كتبته يسكر الكون","ويجري كالشهد تحت لساني",58,"ي",1,0],["لم يَزلَ يَحْفِرُها حتى جرى","ماؤُها وهْوَ مشُوبٌ بدماهْ",59,"ا",2,0],["لم يزيِّنْ ثِيابَه النقشُ؛ لكن","زيَّن الطهرُ والعفافُ ثيابه",60,"ب",2,0],["لمْ يزورهِ طردٌ فيذعرَ درؤهُ،","فيلجَّ في وهلٍ وفي تشرادِ",61,"د",1,0],["لمْ يَزَلْ حَقُّكَ المُقَدَّمُ يَمْحُو","باطلَ المُستَعَارِ، حتّى اضْمخَلاًّ",62,"ل",2,0],["لم يَزَلْ شُؤْمُكَ المُجَرَّبُ في الأَح","زَابِ قِدْماً حَتَّى عَزَاْتَ أَخَانَا",63,"ن",2,0],["لَمْ يَزدْهُ اللهُ إِلاَّ فِي","التَّمَادِي فِي خَبَالِهْ",64,"ل",2,0],["لم يزل للسَّكَنْجَبينِ قرينَ","إن نأى عنه فهو صَبٌّ خرينُ",65,"ن",1,1],["لم يزالوا مُفَضَّلينَ على النا","س بحُكمي مُغضبٍ ومُراضي",66,"ض",2,0],["لم يزل بي إلى الشباب وأيا","م له قد ذهبن عنه نزوع",67,"ع",1,0],["لم يَزَلْ صاحبي يُعالِجُ مِنْهُ","نَّ نِفارا مُسْتَعْصِياً ويُعانِي",68,"ن",2,0],["لم يزل في الوداد يرقب قلبي","ذمة َ فيكم وعهداً والاّ",69,"ل",2,0],["لم يزل يقتلُ العبادَ بطرفٍ","بقيتْ حمرةُ الدّما بإزائه",70,"ا",3,0],["لم يزل ملكُكم قويّاً وجَدْوَا","كمْ عزيزاً وبابُكم مقصودَا",71,"د",2,0],["لم يزلْ قدُّها يقدِّدُ قلبي","وكذا خدُّها يخدُّ فؤادِي",72,"ي",1,0],["لم يزل تابع الفسوق مسوقاً","بالمقادير نحوها مَزموما",73,"م",2,0],["لَم يَزَل جانِبي مَنيعاً مَهيباً","مُذ رَأَتني بِكَ الخُطوبُ مُهيبا",74,"ب",2,0],["لَم يَزَل في جَزيلِ جَدواهُ حَتّى","فِضتُ مِن بَعضِهِ نَوالاً جَزيلا",75,"ل",2,0],["لَم يَزل فينا رَبيع