 وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[477,"بعد أحبابي كساني الأرقا","https://www.aldiwan.net/poem36922.html","الرمل"],[498,"يا إلهي بمحكم القرآن","https://www.aldiwan.net/poem37748.html","الخفيف"],[498,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[513,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[527,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[536,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[549,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[549,"يا من قرنت به على","https://www.aldiwan.net/poem47171.html","مجزوء الكامل"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"لعنة الله على من","https://www.aldiwan.net/poem47303.html","مجزوء الرمل"],[549,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[549,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[549,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[549,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[549,"إما بقيت فهلك غيرك هين","https://www.aldiwan.net/poem47818.html","الكامل"],[549,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[560,"واحد في الحمى فدته ألوف","https://www.aldiwan.net/poem52775.html","الخفيف"],[560,"يا أيها القلب الخفوق بجانبي","https://www.aldiwan.net/poem52943.html","الكامل"],[565,"لي من سر بني العباس","https://www.aldiwan.net/poem69631.html","مجزوء الكامل"],[567,"اتق الأحمق أَن تصحبه","https://www.aldiwan.net/poem51998.html","الرمل"],[573,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[584,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[584,"جادت عليك من السحاب سواري","https://www.aldiwan.net/poem17533.html","الكامل"]],"verses":[["وَإِذا جَهَرتَ بِصَوتِ عَزمِكَ مُسمِعاً","أَصغى إِلَيكَ اليُمنُ وَالتَوفيقُ",0,"ق",1,0],["وَإِذا جُيوشُ الكِسرَوِيِّ تَبادَرَت","نَحوي وَأَبدَت ما تُكِنُّ ضُلوعُها",1,"ع",3,0],["وإذا جِئْتُ رُبوعاً بعْدَها","فعلَ اللّهُ بقَلْبي وصنَعْ",2,"ع",1,0],["وَإِذَا جَرَحْتَ فُؤَادَ حُرٍّ لَمْ تُطِقْ","إِدْمَالَهُ وَبِأَيِّ شَيْءٍ يَدْمُلُ",3,"ل",1,0],["وَإِذَا جَنَى جَانٍ تَبَيَّنَ جَهْلُهُ","فَاحْلُمْ عَلَيْهِ فأَيْنَ مَنْ لاَ يَجْهَلُ",3,"ل",1,0],["وَإذا جَنَبْتَ الْمُقْرَبَاتِ إلَى الْعِدَى","سِيَّانِ عِنْدَكَ فَرْسَخٌ أَوْ مِيلُ",4,"ل",1,0],["وإذا جرى المقْدورُ في بدْرِ الدُجى","يوْماً أيُجْهَلُ بعْدَهُ مِقْدارُهُ",5,"ر",2,0],["وَإِذا جَريتَ مَع السَفيهِ كَما جَرى","فَكِلاكُما في جَريهِ مَذمومُ",6,"م",1,0],["وَإِذا جَلَّتِ الخُطوبُ وَطَمَّت","أَعجَزَت في القَريضِ طَوقَ الرَوِيِّ",7,"ي",1,0],["وإذا جنّها على البحر ليلٌ","أطلع الكهرباء فيها شموسا",8,"س",2,0],["وَإِذا جَرَرتَ إِلى العَدُوِّ كَتائِباً","رَعَبَت مَخافَتُكَ القُلوبَ الصُدَّدا",9,"د",2,0],["وإذا جمعت إلى اللِّحاق محبةٌ","للسبق بالإحسان كنت السابقا",10,"ق",2,0],["وإذا جهلنا ما عواقبُ خُطّةٍ","ظِلنا نسائُل منه رأياً كاهنا",11,"ن",2,0],["وَإِذا جَنى غُرماً سَعَيتُ لِنَصرِهِ","حَتّى أُهينَ كَرائِمي لِفِدائِهِ",12,"ا",3,0],["وإذا جئْنا إلى الغابِ","وغطَّانا الشَّجَرْ",13,"ر",1,0],["وإذا جئتم إلى ناديكم","فاطرحوا خلفكم العبء الثقيل",14,"ل",1,0],["وإذا جرّت المحاماة ذيلا","ونميناه كان فضل ثيابك",15,"ك",1,0],["وإذا جاور الملوك وأمسى","بين عين البلى وعين السواد",16,"د",1,0],["وَإِذا جَرَيتَ مَعَ السَوابِقِ فَاِقتَحِم","غُرَراً تَسيلُ إِلى المَدى وَحُجولا",17,"ل",2,0],["وَإِذا جَلالُ المَوتِ وافٍ سابِغٌ","وَإِذا جَلالُ العَبقَرِيَّةِ ضافي",18,"ي",1,0],["وَإِذا جَمَعتَ الطَيِّباتِ رَدَدتَها","لِعَتيقِ خَمرٍ أَو قَديمِ وِدادِ",19,"د",1,0],["وَإِذا جَلَّتِ الذُنوبُ وَهالَت","فَمِنَ العَدلِ أَن يَهولَ الجَزاءُ",20,"ا",2,0],["وَإِذا جيءَ بِالخُوانِ تَخَوَّف","تُ وَأَشفَقتُ أَن يَموتَ خَنيقا",21,"ق",2,0],["وَإِذا جَميعُ أُمورِها عُقَبٌ","بَينَ البَرِيَّةِ قَلَّما تَبقى",22,"ا",1,0],["وَإِذا جَرَّبَ المُجَرَّبَ عَمرٌو","فَعَلَيهِ إِذا أُصيبَ المَلامُ",23,"م",1,0],["وَإِذا جَرى بَينَ الوَرى ذِكرُ اِسمِهِ","تُغنيهِ شُهرَتُهُ عَنِ اِبنِ فُلانِ",24,"ن",1,0],["وإذا جَرّدوا السيوفَ لضرْبٍ","وَلَغَتْ في الدماء لا من أُوامِ",25,"م",1,0],["وإذا جرى ذِكري تكادُ قلوبُهمْ","تنشقُّ أو تغتالني بشرارِ",26,"ر",1,0],["وَإِذا جِئتُها لِأَشكو إِلَيها","بَعضَ ما شَفَّني وَما قَد شَجاني",27,"ن",2,0],["وإذا جعلتَ أنا شِعارَكَ لم تَسُدْ","بين الرجالِ ولم تَفُزْ بُمِرادِ",28,"د",1,0],["وَإِذَا جِئْتَ بآياتِ صِدْقٍ","لم تَزِدْهُم بِكَ إلَّا ارْتِيابا",29,"ب",2,0],["وإذا جِئْتَ حَاجِزاً بَيْنَ بَلبَي","سَ وَقليوبَ مِنْ خَرابِ فَزارَه",30,"ر",2,0],["وَإِذا جِئتُها سَمِعتُ غِناءً","مُرجِعاً لِلفُؤادِ مِنّي نَصيبا",31,"ب",2,0],["وإِذا جَهِلتَ مِن اِمرِئٍ أَعراقَهُ","وَقَديمَهُ فَاِنظُر إِلى ما يَصنَعُ",32,"ع",1,0],["وَإِذا جَزَيتَ أَخاً بِذَ","بٍ كانَ مِنهُ لَم تَسُدَه",33,"د",2,0],["وَإِذا جَفَوتَ قَطَعتُ عَنكَ مَنافِعي","وَالدَرُّ يَقطَعُهُ جَفاءُ الحالِبِ",34,"ب",1,0],["وَإِذا جُهِدنَ وَقَلَّ مَصُّ نِطافِها","وَصَلَقنَ في دَيمومَةٍ إِمليسِ",35,"س",1,0],["وإذَا جِيَادُ الخَيلِ ماطَلَها المَدى","وتَقطَّعَتْ من شَأوِها المبْهُورِ",36,"ر",1,1],["وإذا جرت البقاع شقاء","لمقيم فتلك شر البقاع",37,"ع",1,0],["وَإِذا جِئتُم إِلى ناديكُمو","فَاِطرَحوا خَلفَكُموا العِبءَ الثَقيل",38,"ل",1,0],["وَإِذَا جَوَادٌ خَرَّ فَارِسُهُ دَعَا","بِصَهِيلِهِ ذَا حَاجَةٍ بِجَوَادِ",39,"د",1,0],["وإذا جلست أذىَ خُشا","مُك من يَضُمُّ المجلس",40,"س",1,0],["وإذا جلستَ على الطري","قِ ولا أرى لك تجلس",40,"س",1,0],["وإِذَا جَلَّتِ الْمَعَانِي تَسَامَتْ","عَنْ قُيُودِ الأَفْعَالِ والأَسْمَاءِ",41,"ا",2,0],["وإِذَا جَالَ وَاصِفاً رَاعَك الْحُسنُ","وَأكْبَرْتَ فنَّهُ وافْتِنَانَه",42,"ن",2,0],["وإذا جفّتْ لَهاةٌ ظمأً","ضنّتِ الأنفسُ بالماءِ القَرَاح",43,"ح",1,0],["وإذا جعت، فامضغ الصبر! ما أح","لاه في ذلك الزمان مذاقا!",44,"ق",2,0],["وإِذا جهلت من امرىء أعراقه","وقديمة فانظر إلى ما يصنع",45,"ع",1,0],["وإذا جزيت أخا بذنب","كان منه لم تسده",46,"د",2,0],["وإذا جِئْتَ حَاجِراً بَيْنَ بَلْبَيْ","س وقليوبَ من خرابِ فزارهْ",47,"ر",2,0],["وإذا جاءت الشدائدُ تَترى","قدَّموهم وولَّوا الأدبار",48,"ر",1,0],["وإذا جهلَنا ما عواقبُ خُطبة ٍ","ظِلنا نسائُل منه رأياً كاهنا",49,"ن",2,0],["وإذا جئتم إلى ناديكمُ","فاطرحوا خلفكمو العِبْءَ الثقيل",50,"ل",1,0],["واذا جلا في دسته تلقاه عن","همم يفيض جداول الاحسان",51,"ن",1,0],["وِإذَا جِئتَ طَالِباً القَضَاءَ","بَعدَ نَومٍ الضُّحَى بِطُولِ المَنَامِ",52,"م",1,0],["وإذَا جَاءَ سَائِلاً صَافي القَل","بِ أَجَبنا بِالحَقِّ مِنهُ السُّؤالا",53,"ل",2,0],["وإذا جرى ذكْرُ المحصَّبِ من منىً","والربعُ من عرفاتِ أمسى هائما",54,"م",2,0],["وإذا جذبتَ إليك من ضَبعِي","طاعنتُها بأسنَّةِ القهرِ",55,"ر",1,0],["وإذا جرى في غايةٍ شهِدت له","أن لا مخلِّقَ في مَداه رسيلُ",56,"ل",1,0],["وَإِذا جَرى الكُرَماءُ بَرَّزَ سابِقاً","خُلُقُ الكَريمِ تَخَلُّقَ المُتَكَرِّمِ",57,"م",1,0],["وإذا جرى ذكر العقيق وأهله","أجرى العقيق تأسّفا وتلهّفا",58,"ف",2,0],["وإذا جرى صدع لأمتمُ شعثهُ","وسواه ما صدع له بملامِ",59,"م",1,0],["وَإِذا جادَتِ الصُدورُ عَلَيهِ","بِقُلوبٍ فَقَد وَهَبنَ الأَقلاَّ",60,"ل",2,0],["وَإِذا جَرى فَوقَ الطُّروسِ يَراعَهُ","فَوَميضُ بَرقٍ في سَحابٍ مُسبَلِ",61,"ل",1,0],["وإذا جفا فألن له","منك الجناح إذا جفا",62,"ف",2,0],["وَإِذا جئتَها بغيرِ دليلٍ","عُدتَ في شرّ صفقةٍ مغبونا",63,"ن",2,0],["وَإِذا جادَتِ الغَوادي بِوَبلٍ","فَسَقاهُ مِنها سَحابٌ مَخيلُ",64,"ل",1,0],["وَإِذا جَرَت خَيلٌ تُبادِرُ غايَةً","فَالسابِقُ الجائي يَقودُ جِيادَها",65,"د",3,0],["وإذا جحدتُ هواه أو أنكرتُهُ","شهدت عَليَّ من الهوى آثارُهُ",66,"ر",2,0],["وإذا جئت رحب حيهم","حيهم بالسلام والرحب",67,"ب",1,0],["وإذا جاشت العواطف في نفسي","عمدت الى دواتي وطرسي",68,"ي",1,0],["وإذا جرى لك بالسعود فدارِه","وأحذر تقلبه وإن هوَ أبرَما",69,"م",2,0],["وإذا جَمَحْنَ بك الخُطوبُ فما لَها","إلاّ التجلّد والثبات لِجامُ",70,"م",1,0],["وَإِذا جَفاجَفنُ السَحابِ فَرِد بِها","ما سالَ في أَعقابِها مِن مَدمَعي",71,"ع",2,0],["وَإِذا جَروا في حَلبَةٍ وَجَرَت إِلى","شَأوٍ تَبَيَّنَ نَقصُهُم وَتَمامُها",72,"م",3,0],["وَإِذا جَلالُ الدينِ راضَ نَداهُ لي","حَظّي فَإِنَّي عَن زَمانِيَّ راضي",73,"ي",1,0],["وَإِذا جَفا الغَيثُ البِلادَ فَأَمسَكَت","أَن تَستَهِلَّ عَلى الثَرى قَطَراتُهُ",74,"ت",2,0],["وإذا جاء فارغاً من سوانا","عاد من فيض سرّنا ملآنا",75,"ن",2,0],["وإذا جاء آخِرٌ لحمانا","ووفى بالعهود فاق الأوائل",76,"ل",1,0],["وَإذا جَلَيْتُ اليومَ دُرَّ مَدائِحي","جُلِبَتْ لأسْواقٍ بِغَيْرِ تِجارِ",77,"ر",1,1],["وإذا جلَوْتَ من المَواهبِ غادةً","ألفَيْتَ أحسَنَ حَلْيِها التَّعْجِيلا",78,"ل",2,0],["وإذا جرى فيه الحَديثُ جَرى لَهُ","دَمعي فَيَنقَلِبُ الحَديثُ بُكاءَ",79,"ا",2,0],["وَإِذا جَرى ماءُ الهَوى","جَرَّا عَلى ماءِ النِضالِ",80,"ل",1,0],["وَإِذا جُدتَ لِلمَنامِ بِطَيفٍ","فَعَلى ناظِري المَنامُ حَرامُ",81,"م",1,0],["وإذا جَرَت مَجرى الشَّرابِ صِفاتُهُ","لم تَلقَ إلا ساقِياً ونَدِيما",82,"م",2,0],["وَإِذا جادَ أَعقَبَ الجُودَ عُذراً","ومَتى قالَ أَتبعَ القَولَ فِعلا",83,"ل",2,0],["وإذا جرَى البرقُ اليَماني خلْفَهُ","أبصَرتَه بغُبارِهِ يتعَثَّرُ",84,"ر",1,0],["وإذا جهلت طريقة","منه فسلني وامتحني",85,"ي",1,0],["وَإِذا جَفاكَ الدَهر وَهوَ أَبو الوَرى","طراً فَلا تَعتَب عَلى أَولادِهِ",86,"د",2,0],["وإذا جَرَّدَهم يومَ وغًى","مثلما جَرَّدَ أَسيافاً صقالا",87,"ل",2,0],["وإِذا جلاكَ حَلَتْ لمستمع","كانت على فمِ قائلٍ أَحْلَى",88,"ل",2,0],["وإِذا جَلَوْتَ الرَّأْيَ ثُرْتَ به","متوضِّحاً في مُظْلِمِ الجُلَّى",88,"ل",2,0],["وإِذَا جَعَلْتَ الجودَ غَرْسَكَ لم تَزَلْ","تَجْنِي ثِمارَ الشَّكْرِ خَيْرَ ثِمارَ",89,"ر",1,0],["وإذا جرى في طِرسِه قلمٌ","بيمينه للنفعِ والضُرِّ",90,"ر",1,0],["وإذا جدّ في العَطاءِ فكالبح","رِ سماحاً والوابل الغَيداقِ",91,"ق",1,0],["وإذا جُدْتَ لي به فكأنْ قد","جُدْتَ بالراحِ والخُدودِ الملاحِ",92,"ح",1,0],["وإِذا جاءَكَ يومٌ بالمُنى","فَاقْتَبِلْ أَضعافَها فِي يومِ غَدْ",93,"د",1,0],["وإذا جَرَتْ ريحُ الحوادث عاصفاً","فلتنحرِفْ عن ذا الخِضمِّ الزاخرِ",94,"ر",1,0],["واذا جريتَ على الرِّهان وبُهْمَهم","لاقَ الخَلوقُ بجبهة الغرّاءِ",95,"ا",2,0],["وإذا جرت هوجُ الرياح عشيَّةً","ما بين نكْباءِ الهُبوبِ وزعزع",96,"ع",1,0],["وإذا جرَّدوا اليراع لروعٍ","بانَ معنى الليوث في الآجامِ",97,"م",1,0],["وإذا جلَّ ما تروم من الأم","ر فأهونْ بحادثٍ أن يجلاَّ",98,"ل",2,0],["وإذا جاذبت منه غصنا","نثر الورد علينا ورقا",99,"ق",2,0],["وإذا جاءَ وارِدُ الحَيْنِ فالْطُفْ","وأَمِتْنا رَبِّي على الإِيمَانِ",100,"ن",1,0],["وإذا جرِّدَ عنه ماؤُهُ","وهو من بعدِ العَصيرِ انْعَدَما",101,"م",2,0],["وإذا جر مقودي لم أجاذب","فيه والعاشق الحرون ثقيل",102,"ل",1,0],["وإذا جَرَى في حَلْبةٍ الشُّ","عَرَ جَرَى الشُّعراء خَلْفا",103,"ف",2,0],["وإذا جالَ في مَيادين شِعرٍ","فَكَجَولاتِهِ غَداةَ نِزالِ",104,"ل",1,0],["وإذا جانبٌ من الأرض لم يس","طِعْ مقامي اِستعطتُ عنهُ مُضِيّا",105,"ي",2,0],["وإذا جعلتك قُرّةً","للعين أسخَنْتَ العيونا",106,"ن",2,0],["وإِذا جزعتَ فكيف يصبر معشرٌ","ما فيك ليس بهمْ من الأحلامِ",107,"م",1,0],["وإذا جرّبتَ منه","مَضْرِباً كان كَليلا",108,"ل",2,0],["وَإِذا جَزعتَ من المصاب فقل لنا","مَن ذا يكون إذا جزعنا المَوْئلا",109,"ل",2,0],["وإذا جَرتْ فالبرقُ ليس بمسرعٍ","إيماضُهُ والطَّرْفُ ليس بسابقِ",110,"ق",1,0],["وإذا جروا طَلَقاً إلى شأْو العُلا","تركوا سَبوقَ معاشرٍ مسبوقا",111,"ق",2,0],["وإِذا جوزِيَ الأنامُ فلا جو","زيتَ إِلّا بالمؤلمِ اللّذّاعِ",112,"ع",1,0],["وإِذا جرى قَدَرٌ بشيءٍ فاِرضَه","فالمُعتبون لَساخِطو ما يُقدَرُ",113,"ر",1,0],["وإذا جزيتُ على القبي","حِ بمثلِهِ فقدِ اِعتديتُ",114,"ت",1,0],["وإذا جادَ مُنعِماً فَهْوَ نِيلٌ","وإذا حلَّ بُقعةً فَهْيَ ريفُ",115,"ف",1,0],["وإذا جَرَتْ لكَ في الطُروسِ يَراعةٌ","فسوادُ وَشمٍ في مَعاصِمِ كاعبِ",116,"ب",1,0],["وَإِذَا جَالَسْتُهُ لَمْ","يُدْرَ مَنْ مِنَّا الجَلِيْسُ",117,"س",1,0],["وَإِذا جالسته في مجلسٍ","أَفسد المجلس منه بالخرق",118,"ق",1,0],["وإِذا جرَّد اليَراعة في الكَفِّ","عَلِمْنَا أَنَّ السيوفَ غُمُودُ",119,"د",1,0],["وَإِذَا جَنيْتُ بِسَيِّئاتي عَدَّها","كَرَماً وإِحْساناً مِنَ الحَسَناتِ",120,"ت",1,0],["وَإِذَا جَنَحْتُ إلى الحِسَانِ تَعَشُّقاً","شَفَعتْ شَبِيبتي الهَوْى بِيَسارِ",121,"ر",1,0]]}