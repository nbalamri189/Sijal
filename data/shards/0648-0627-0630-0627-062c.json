/diwan/poem/132922","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48431","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20642","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45859","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91457","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91286","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91435","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91760","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216470","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117903","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117895","الكامل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123530","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128880","الخفيف"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124274","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32869","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123495","الخفيف"],[4260,"","https://poetry.dctabudhabi.ae/diwan/poem/200369","الخفيف"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[4307,"","https://poetry.dctabudhabi.ae/diwan/poem/31538","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83184","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72434","الطويل"],[4750,"ياسيدي خالد الفيصل","https://www.poetsgate.com/ViewPoem.aspx?id=180430",""],[4764,"بكت لأشواق في غيابه","https://www.poetsgate.com/ViewPoem.aspx?id=36432",""],[4929,"المغرورة","https://www.poetsgate.com/ViewPoem.aspx?id=202413",""],[5005,"هوّن عليك..","https://www.poetsgate.com/ViewPoem.aspx?id=204897",""],[4119,"ما هذه الحدث الفواتن","https://www.poetsgate.com/ViewPoem.aspx?id=16246",""],[5038,"وغى أفكاري","https://www.poetsgate.com/ViewPoem.aspx?id=190137",""],[5054,"لا يا خليلي","https://www.poetsgate.com/ViewPoem.aspx?id=215692",""],[3271,"الشادوف","https://www.poetsgate.com/ViewPoem.aspx?id=104129",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5225,"عنيد تفكير","https://www.poetsgate.com/ViewPoem.aspx?id=36890",""],[5277,"ويْ حبيبي..","https://www.poetsgate.com/ViewPoem.aspx?id=203366",""],[5325,"من شل من غلب العلى أيمانها","https://www.poetsgate.com/ViewPoem.aspx?id=171981",""],[5417,"لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=188602",""],[5422,"كانت الدنيا صبيه","https://www.poetsgate.com/ViewPoem.aspx?id=151980",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5596,"طبع الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=205611",""],[5616,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=203462",""],[5667,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=214888",""],[5956,"تحنان للخلد المفقود","https://www.poetsgate.com/ViewPoem.aspx?id=182999",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""],[5064,"لَمْ يبقَ للحُبِّ العظِيمِ مكَانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87536&r=&rc=31",""]],"verses":[["وَإِذا جَهَرتَ بِصَوتِ عَزمِكَ مُسمِعاً","أَصغى إِلَيكَ اليُمنُ وَالتَوفيقُ",0,"ق",1,0],["وَإِذا جُيوشُ الكِسرَوِيِّ تَبادَرَت","نَحوي وَأَبدَت ما تُكِنُّ ضُلوعُها",1,"ع",3,0],["وإذا جِئْتُ رُبوعاً بعْدَها","فعلَ اللّهُ بقَلْبي وصنَعْ",2,"ع",1,0],["وَإِذَا جَرَحْتَ فُؤَادَ حُرٍّ لَمْ تُطِقْ","إِدْمَالَهُ وَبِأَيِّ شَيْءٍ يَدْمُلُ",3,"ل",1,0],["وَإِذَا جَنَى جَانٍ تَبَيَّنَ جَهْلُهُ","فَاحْلُمْ عَلَيْهِ فأَيْنَ مَنْ لاَ يَجْهَلُ",3,"ل",1,0],["وَإذا جَنَبْتَ الْمُقْرَبَاتِ إلَى الْعِدَى","سِيَّانِ عِنْدَكَ فَرْسَخٌ أَوْ مِيلُ",4,"ل",1,0],["وإذا جرى المقْدورُ في بدْرِ الدُجى","يوْماً أيُجْهَلُ بعْدَهُ مِقْدارُهُ",5,"ر",2,0],["وَإِذا جَريتَ مَع السَفيهِ كَما جَرى","فَكِلاكُما في جَريهِ مَذمومُ",6,"م",1,0],["وَإِذا جَلَّتِ الخُطوبُ وَطَمَّت","أَعجَزَت في القَريضِ طَوقَ الرَوِيِّ",7,"ي",1,0],["وإذا جنّها على البحر ليلٌ","أطلع الكهرباء فيها شموسا",8,"س",2,0],["وَإِذا جَرَرتَ إِلى العَدُوِّ كَتائِباً","رَعَبَت مَخافَتُكَ القُلوبَ الصُدَّدا",9,"د",2,0],["وإذا جمعت إلى اللِّحاق محبةٌ","للسبق بالإحسان كنت السابقا",10,"ق",2,0],["وإذا جهلنا ما عواقبُ خُطّةٍ","ظِلنا نسائُل منه رأياً كاهنا",11,"ن",2,0],["وَإِذا جَنى غُرماً سَعَيتُ لِنَصرِهِ","حَتّى أُهينَ كَرائِمي لِفِدائِهِ",12,"ا",3,0],["وإذا جئْنا إلى الغابِ","وغطَّانا الشَّجَرْ",13,"ر",1,0],["وإذا جئتم إلى ناديكم","فاطرحوا خلفكم العبء الثقيل",14,"ل",1,0],["وإذا جرّت المحاماة ذيلا","ونميناه كان فضل ثيابك",15,"ك",1,0],["وإذا جاور الملوك وأمسى","بين عين البلى وعين السواد",16,"د",1,0],["وَإِذا جَرَيتَ مَعَ السَوابِقِ فَاِقتَحِم","غُرَراً تَسيلُ إِلى المَدى وَحُجولا",17,"ل",2,0],["وَإِذا جَلالُ المَوتِ وافٍ سابِغٌ","وَإِذا جَلالُ العَبقَرِيَّةِ ضافي",18,"ف",2,0],["وَإِذا جَمَعتَ الطَيِّباتِ رَدَدتَها","لِعَتيقِ خَمرٍ أَو قَديمِ وِدادِ",19,"د",1,0],["وَإِذا جَلَّتِ الذُنوبُ وَهالَت","فَمِنَ العَدلِ أَن يَهولَ الجَزاءُ",20,"ا",2,0],["وَإِذا جيءَ بِالخُوانِ تَخَوَّف","تُ وَأَشفَقتُ أَن يَموتَ خَنيقا",21,"ق",2,0],["وَإِذا جَميعُ أُمورِها عُقَبٌ","بَينَ البَرِيَّةِ قَلَّما تَبقى",22,"ا",1,0],["وَإِذا جَرَّبَ المُجَرَّبَ عَمرٌو","فَعَلَيهِ إِذا أُصيبَ المَلامُ",23,"م",1,0],["وَإِذا جَرى بَينَ الوَرى ذِكرُ اِسمِهِ","تُغنيهِ شُهرَتُهُ عَنِ اِبنِ فُلانِ",24,"ن",1,0],["وإذا جَرّدوا السيوفَ لضرْبٍ","وَلَغَتْ في الدماء لا من أُوامِ",25,"م",1,0],["وإذا جرى ذِكري تكادُ قلوبُهمْ","تنشقُّ أو تغتالني بشرارِ",26,"ر",1,0],["وَإِذا جِئتُها لِأَشكو إِلَيها","بَعضَ ما شَفَّني وَما قَد شَجاني",27,"ن",2,0],["وإذا جعلتَ أنا شِعارَكَ لم تَسُدْ","بين الرجالِ ولم تَفُزْ بُمِرادِ",28,"د",1,0],["وَإِذَا جِئْتَ بآياتِ صِدْقٍ","لم تَزِدْهُم بِكَ إلَّا ارْتِيابا",29,"ب",2,0],["وإذا جِئْتَ حَاجِزاً بَيْنَ بَلبَي","سَ وَقليوبَ مِنْ خَرابِ فَزارَه",30,"ر",2,0],["وَإِذا جِئتُها سَمِعتُ غِناءً","مُرجِعاً لِلفُؤادِ مِنّي نَصيبا",31,"ب",2,0],["وإِذا جَهِلتَ مِن اِمرِئٍ أَعراقَهُ","وَقَديمَهُ فَاِنظُر إِلى ما يَصنَعُ",32,"ع",1,0],["وَإِذا جَزَيتَ أَخاً بِذَ","بٍ كانَ مِنهُ لَم تَسُدَه",33,"د",2,0],["وَإِذا جَفَوتَ قَطَعتُ عَنكَ مَنافِعي","وَالدَرُّ يَقطَعُهُ جَفاءُ الحالِبِ",34,"ب",1,0],["وَإِذا جُهِدنَ وَقَلَّ مَصُّ نِطافِها","وَصَلَقنَ في دَيمومَةٍ إِمليسِ",35,"س",1,0],["وإذَا جِيَادُ الخَيلِ ماطَلَها المَدى","وتَقطَّعَتْ من شَأوِها المبْهُورِ",36,"ر",1,1],["وإذا جرت البقاع شقاء","لمقيم فتلك شر البقاع",37,"ع",1,0],["وَإِذا جِئتُم إِلى ناديكُمو","فَاِطرَحوا خَلفَكُموا العِبءَ الثَقيل",38,"ل",1,0],["وَإِذَا جَوَادٌ خَرَّ فَارِسُهُ دَعَا","بِصَهِيلِهِ ذَا حَاجَةٍ بِجَوَادِ",39,"د",1,0],["وإذا جلست أذىَ خُشا","مُك من يَضُمُّ المجلس",40,"س",1,0],["وإذا جلستَ على الطري","قِ ولا أرى لك تجلس",40,"س",1,0],["وإِذَا جَلَّتِ الْمَعَانِي تَسَامَتْ","عَنْ قُيُودِ الأَفْعَالِ والأَسْمَاءِ",41,"ا",2,0],["وإِذَا جَالَ وَاصِفاً رَاعَك الْحُسنُ","وَأكْبَرْتَ فنَّهُ وافْتِنَانَه",42,"ن",2,0],["وإذا جفّتْ لَهاةٌ ظمأً","ضنّتِ الأنفسُ بالماءِ القَرَاح",43,"ح",1,0],["وإذا جعت، فامضغ الصبر! ما أح","لاه في ذلك الزمان مذاقا!",44,"ق",2,0],["واذا جنحت الى مسا","لمتي فحي على الفلاح",45,"ح",1,0],["وإِذا جهلت من امرىء أعراقه","وقديمة فانظر إلى ما يصنع",46,"ع",1,0],["وإذا جزيت أخا بذنب","كان منه لم تسده",47,"د",2,0],["وإذا جِئْتَ حَاجِراً بَيْنَ بَلْبَيْ","س وقليوبَ من خرابِ فزارهْ",48,"ر",2,0],["وإذا جاءت الشدائدُ تَترى","قدَّموهم وولَّوا الأدبار",49,"ر",1,0],["وإذا جهلَنا ما عواقبُ خُطبة ٍ","ظِلنا نسائُل منه رأياً كاهنا",50,"ن",2,0],["وإذا جئتم إلى ناديكمُ","فاطرحوا خلفكمو العِبْءَ الثقيل",51,"ل",1,0],["واذا جلا في دسته تلقاه عن","همم يفيض جداول الاحسان",52,"ن",1,0],["وِإذَا جِئتَ طَالِباً القَضَاءَ","بَعدَ نَومٍ الضُّحَى بِطُولِ المَنَامِ",53,"م",1,0],["وإذَا جَاءَ سَائِلاً صَافي القَل","بِ أَجَبنا بِالحَقِّ مِنهُ السُّؤالا",54,"ل",2,0],["وإذا جرى ذكْرُ المحصَّبِ من منىً","والربعُ من عرفاتِ أمسى هائما",55,"م",2,0],["وإذا جذبتَ إليك من ضَبعِي","طاعنتُها بأسنَّةِ القهرِ",56,"ر",1,0],["وإذا جرى في غايةٍ شهِدت له","أن لا مخلِّقَ في مَداه رسيلُ",57,"ل",1,0],["وَإِذا جَرى الكُرَماءُ بَرَّزَ سابِقاً","خُلُقُ الكَريمِ تَخَلُّقَ المُتَكَرِّمِ",58,"م",1,0],["وإذا جرى ذكر العقيق وأهله","أجرى العقيق تأسّفا وتلهّفا",59,"ف",2,0],["وإذا جرى صدع لأمتمُ شعثهُ","وسواه ما صدع له بملامِ",60,"م",1,0],["وَإِذا جادَتِ الصُدورُ عَلَيهِ","بِقُلوبٍ فَقَد وَهَبنَ الأَقلاَّ",61,"ل",2,0],["وَإِذا جَرى فَوقَ الطُّروسِ يَراعَهُ","فَوَميضُ بَرقٍ في سَحابٍ مُسبَلِ",62,"ل",1,0],["وإذا جفا فألن له","منك الجناح إذا جفا",63,"ف",2,0],["وَإِذا جئتَها بغيرِ دليلٍ","عُدتَ في شرّ صفقةٍ مغبونا",64,"ن",2,0],["وَإِذا جادَتِ الغَوادي بِوَبلٍ","فَسَقاهُ مِنها سَحابٌ مَخيلُ",65,"ل",1,0],["وَإِذا جَرَت خَيلٌ تُبادِرُ غايَةً","فَالسابِقُ الجائي يَقودُ جِيادَها",66,"د",3,0],["وإذا جحدتُ هواه أو أنكرتُهُ","شهدت عَليَّ من الهوى آثارُهُ",67,"ر",2,0],["وإذا جئت رحب حيهم","حيهم بالسلام والرحب",68,"ب",1,0],["وإذا جاشت العواطف في نفسي","عمدت الى دواتي وطرسي",69,"س",2,0],["وإذا جرى لك بالسعود فدارِه","وأحذر تقلبه وإن هوَ أبرَما",70,"م",2,0],["وإذا جَمَحْنَ بك الخُطوبُ فما لَها","إلاّ التجلّد والثبات لِجامُ",71,"م",1,0],["وَإِذا جَفاجَفنُ السَحابِ فَرِد بِها","ما سالَ في أَعقابِها مِن مَدمَعي",72,"ع",2,0],["وَإِذا جَروا في حَلبَةٍ وَجَرَت إِلى","شَأوٍ تَبَيَّنَ نَقصُهُم وَتَمامُها",73,"م",3,0],["وَإِذا جَلالُ الدينِ راضَ نَداهُ لي","حَظّي فَإِنَّي عَن زَمانِيَّ راضي",74,"ض",2,0],["وَإِذا جَفا الغَيثُ البِلادَ فَأَمسَكَت","أَن تَستَهِلَّ عَلى الثَرى قَطَراتُهُ",75,"ت",2,0],["وإذا جاء فارغاً من سوانا","عاد من فيض سرّنا ملآنا",76,"ن",2,0],["وإذا جاء آخِرٌ لحمانا","ووفى بالعهود فاق الأوائل",77,"ل",1,0],["وَإذا جَلَيْتُ اليومَ دُرَّ مَدائِحي","جُلِبَتْ لأسْواقٍ بِغَيْرِ تِجارِ",78,"ر",1,1],["وإذا جلَوْتَ من المَواهبِ غادةً","ألفَيْتَ أحسَنَ حَلْيِها التَّعْجِيلا",79,"ل",2,0],["وإذا جرى فيه الحَديثُ جَرى لَهُ","دَمعي فَيَنقَلِبُ الحَديثُ بُكاءَ",80,"ا",2,0],["وَإِذا جَرى ماءُ الهَوى","جَرَّا عَلى ماءِ النِضالِ",81,"ل",1,0],["وَإِذا جُدتَ لِلمَنامِ بِطَيفٍ","فَعَلى ناظِري المَنامُ حَرامُ",82,"م",1,0],["وإذا جَرَت مَجرى الشَّرابِ صِفاتُهُ","لم تَلقَ إلا ساقِياً ونَدِيما",83,"م",2,0],["وَإِذا جادَ أَعقَبَ الجُودَ عُذراً","ومَتى قالَ أَتبعَ القَولَ فِعلا",84,"ل",2,0],["وإذا جرَى البرقُ اليَماني خلْفَهُ","أبصَرتَه بغُبارِهِ يتعَثَّرُ",85,"ر",1,0],["وإذا جهلت طريقة","منه فسلني وامتحني",86,"ن",2,0],["وَإِذا جَفاكَ الدَهر وَهوَ أَبو الوَرى","طراً فَلا تَعتَب عَلى أَولادِهِ",87,"د",2,0],["وإذا جَرَّدَهم يومَ وغًى","مثلما جَرَّدَ أَسيافاً صقالا",88,"ل",2,0],["وإِذا جلاكَ حَلَتْ لمستمع","كانت على فمِ قائلٍ أَحْلَى",89,"ل",2,0],["وإِذا جَلَوْتَ الرَّأْيَ ثُرْتَ به","متوضِّحاً في مُظْلِمِ الجُلَّى",89,"ل",2,0],["وإِذَا جَعَلْتَ الجودَ غَرْسَكَ لم تَزَلْ","تَجْنِي ثِمارَ الشَّكْرِ خَيْرَ ثِمارَ",90,"ر",1,0],["وإذا جرى في طِرسِه قلمٌ","بيمينه للنفعِ والضُرِّ",91,"ر",1,0],["وإذا جدّ في العَطاءِ فكالبح","رِ سماحاً والوابل الغَيداقِ",92,"ق",1,0],["وإذا جُدْتَ لي به فكأنْ قد","جُدْتَ بالراحِ والخُدودِ الملاحِ",93,"ح",1,0],["وإِذا جاءَكَ يومٌ بالمُنى","فَاقْتَبِلْ أَضعافَها فِي يومِ غَدْ",94,"د",1,0],["وإذا جَرَتْ ريحُ الحوادث عاصفاً","فلتنحرِفْ عن ذا الخِضمِّ الزاخرِ",95,"ر",1,0],["واذا جريتَ على الرِّهان وبُهْمَهم","لاقَ الخَلوقُ بجبهة الغرّاءِ",96,"ا",2,0],["وإذا جرت هوجُ الرياح عشيَّةً","ما بين نكْباءِ الهُبوبِ وزعزع",97,"ع",1,0],["وإذا جرَّدوا اليراع لروعٍ","بانَ معنى الليوث في الآجامِ",98,"م",1,0],["وإذا جلَّ ما تروم من الأم","ر فأهونْ بحادثٍ أن يجلاَّ",99,"ل",2,0],["وإذا جاذبت منه غصنا","نثر الورد علينا ورقا",100,"ق",2,0],["وإذا جاءَ وارِدُ الحَيْنِ فالْطُفْ","وأَمِتْنا رَبِّي على الإِيمَانِ",101,"ن",1,0],["وإذا جرِّدَ عنه ماؤُهُ","وهو من بعدِ العَصيرِ انْعَدَما",102,"م",2,0],["وإذا جر مقودي لم أجاذب","فيه والعاشق الحرون ثقيل",103,"ل",1,0],["وإذا جَرَى في حَلْبةٍ الشُّ","عَرَ جَرَى الشُّعراء خَلْفا",104,"ف",2,0],["وإذا جالَ في مَيادين شِعرٍ","فَكَجَولاتِهِ غَداةَ نِزالِ",105,"ل",1,0],["وإذا جانبٌ من الأرض لم يس","طِعْ مقامي اِستعطتُ عنهُ مُضِيّا",106,"ي",2,0],["وإذا جعلتك قُرّةً","للعين أسخَنْتَ العيونا",107,"ن",2,0],["وإِذا جزعتَ فكيف يصبر معشرٌ","ما فيك ليس بهمْ من الأحلامِ",108,"م",1,0],["وإذا جرّبتَ منه","مَضْرِباً كان كَليلا",109,"ل",2,0],["وَإِذا جَزعتَ من المصاب فقل لنا","مَن ذا يكون إذا جزعنا المَوْئلا",110,"ل",2,0],["وإذا جَرتْ فالبرقُ ليس بمسرعٍ","إيماضُهُ والطَّرْفُ ليس بسابقِ",111,"ق",1,0],["وإذا جروا طَلَقاً إلى شأْو العُلا","تركوا سَبوقَ معاشرٍ مسبوقا",112,"ق",2,0],["وإِذا جوزِيَ الأنامُ فلا جو","زيتَ إِلّا بالمؤلمِ اللّذّاعِ",113,"ع",1,0],["وإِذا جرى قَدَرٌ بشيءٍ فاِرضَه","فالمُعتبون لَساخِطو ما يُقدَرُ",114,"ر",1,0],["وإذا جزيتُ على القبي","حِ بمثلِهِ فقدِ اِعتديتُ",115,"ت",1,0],["وإذا جادَ مُنعِماً فَهْوَ نِيلٌ","وإذا حلَّ بُقعةً فَهْيَ ريفُ",116,"ف",1,0],["وإذا جَرَتْ لكَ في الطُروسِ يَراعةٌ","فسوادُ وَشمٍ في مَعاصِمِ كاعبِ",117,"ب",1,0],["وَإِذَا جَالَسْتُهُ لَمْ","يُدْرَ مَنْ مِنَّا الجَلِيْسُ",118,"س",1,0],["وَإِذا جالسته في مجلسٍ","أَفسد المجلس منه بالخرق",119,"ق",1,0],["وإِذا جرَّد اليَراعة في الكَفِّ","عَلِمْنَا أَنَّ السيوفَ غُمُودُ",120,"د",1,0],["وَإِذَا جَنيْتُ بِسَيِّئاتي عَدَّها","كَرَماً وإِحْساناً مِنَ الحَسَناتِ",121,"ت",1,0],["وَإِذَا جَنَحْتُ إلى الحِسَانِ تَعَشُّقاً","شَفَعتْ شَبِيبتي الهَوْى بِيَسارِ",122,"ر",1,0],["وإذا جوانحنا على البر انطوت","جِاء السرور به وطابت أنفس",123,"س",1,0],["وَإِذا جَرَرتَ عَلى الطُروسِ يَراعَةً","باتَ الصَريرُ بِراحَتَيكَ صَليلا",124,"ل",2,0],["وإذا جُنُودُكَ قَهقَروا عَن مَعقِلٍ","مُلِّكتَ ذَروتَه بغيرِ جنود",125,"د",1,0],["وإذا جَنحتَ لماءٍ اَوْ طَرَبٍ فمنْ","دَمْعي الهَمُوعِ وقَلبيَ الخفَّاقِ",126,"ق",1,0],["وإذا جرى ذكر الكرام بمجلس","بدؤوا بذكرك وانتهى التعداد",127,"د",1,0],["وإذا جسمه نسيمٌ رقيقٌ","رقَّ عن رقَّةِ النسيم الرقيق",128,"ق",1,0],["وَإِذا جَرى ذِكرُ الكِرامِ بِمَحفَلٍ","ذَكَروكَ وَحدَكَ وَاِنتَهى التّعدادُ",129,"د",1,0],["وَإِذا جَثا لِلزَرعِ يَومَ حَصادِهِ","قَطَعَ النَهارَ تَأوُّهاً وَصَفيرا",130,"ر",2,1],["وإذا جاد أخجلَ المزْنَ حتى","أصبحَ المُزْنُ مِنْ عطاياه لِحْزا",131,"ز",2,0],["وإذا جَبينُ العِشْقِ فِي وَجَناتِهِ","قُبلاتُنا تَبكي إلى ذِكْراكِ",132,"ك",1,0],["وإذا جرت حلبات كل فضيلةٍ","فلك المجلي فائزاً بسباقها",133,"ق",3,0],["وإذا جرد يوما عزمه","فسواء هو والعضب الذكر",134,"ر",1,0],["وإذا جرى في الشعر مبتدهابه","في حالة فاكم بنقعر زيادِ",135,"د",1,0],["وإذا جفن الردى الرا","قد في حرب تنّبه",136,"ب",2,0],["وإذا جئت طيبة فتهادى","بسلام إلى النبي الهادي",137,"د",2,0],["وإذا جاور النجومَ لبيبٌ","ظلّ للأرض أمّهِ غير ناسِ",138,"س",1,0],["وَإِذا جَنَّ الدُجى ذكَّرَني","خَلواتٍ بِأَحاديثِ هَواها",139,"ا",3,0],["وإذا جزت بواديه الخصيب","بلّغي شوقي لسادات الكرامْ",140,"م",1,0],["وإذا جاء من حبيبي كتاب","كان عنوانه بنصر قريب",141,"ب",1,0],["وإذا جاءَني ثلاث بناتٍ","هيأت لي أباؤهنَّ بعولا",142,"ل",2,0],["وَإِذا جَلَست عَلى أَرائك أُنسِهِ","فَأَطرَب وَطب وَاشطح مَع النَدمان",143,"ن",1,0],["وَإِذا جَرت بِضَميره يَده","أَبدَت له الدُّنيا مَناقِبَها",144,"ب",3,0],["وَإِذا جَزى اللَّهُ امرأ بِإِخائِه","فَجَزى أَخا لي ماجِدا سَمحا",145,"ح",2,1],["وإذا جرى قلمٌ بكفِّك خالَهُ","بحشاه خصمك صعدةً سمراءا",146,"ا",3,0],["وإذا جهلتِ سلي طروسَك إنني","بيدٍ الوفا سجّلتُ فيها حُجّتي",147,"ي",1,0],["وإذا جرى ذكر الفصا","حة بين أصحاب القصائد",148,"د",1,0],["وإذا جنى بفم السماع حديثه","جان توهم ما جناه مراضبا",149,"ب",2,0],["وإذا جاوب الحمام هديلاً","يشتكي الألف في القضيب القشيب",150,"ب",1,0],["وإذا جزعت فإن ذاك مظنة","أسرى لك الأمر المقيم المقعد",151,"د",1,0],["وَإِذا جَزى اللَهُ اِمرَأً بِفَعالِهِ","فَجَزى أَخاً لِيَ ماجٍداً سَمحا",152,"ح",2,1],["واذا جفّت حميا المجلس","فحديث عنه يسقى أكؤسي",153,"ي",1,0],["وإذا جاء عن سواه فهل كا","ن سواها بل أفكها وافتراها",154,"ا",3,0],["وإذا جاوز الطريقين أعطى","درهماً ذا الخصاصة السوالا",155,"ل",2,0],["وإذا جاءَ ومعها رجلٌ","كان سمح الكف أو كان نكد",156,"د",1,0],["وإذا جاء بشهرٍ سادسٍ","فهوَ بالميراث أولى وأعد",156,"د",1,0],["وَإِذا جَرى تَحتَ العَجاجِ بِرَبِّهِ","طَبَعَ الأَهِلَّةَ في صِفاحِ الجَلمَدِ",157,"د",1,0],