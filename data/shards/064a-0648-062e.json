{"poems":[[64,"وطائر يخرج من حفرة","https://www.aldiwan.net/poem52239.html","السريع"],[47,"إن تأمل محاسن الأصبهاني","https://www.aldiwan.net/poem64696.html","الخفيف"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[52,"نبا بك خلف الظاعنين وساد","https://www.aldiwan.net/poem63876.html","الطويل"],[47,"إِن تأَملْ مَحاسِنَ الأَصبَهَاني","https://www.poetsgate.com/ViewPoem.aspx?id=31114",""],[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[463,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[2822,"","https://poetry.dctabudhabi.ae/diwan/poem/131387","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68026","البسيط"],[4198,"","https://poetry.dctabudhabi.ae/diwan/poem/145260","الطويل"]],"verses":[["يؤخذ حياً ثم يلقى على","نار لنا حامية الجمرِ",0,"ر",1,0],["يُؤخَذُ الحِلمُ مِن مَكيثِ تَأَنّي","هِ وَنُجحُ العِداتِ مِن إِسراعِه",1,"ع",2,0],["يُؤَخَّر فَيوضَع في كِتابٍ فَيُدَّخَر","لِيَومِ الحِسابِ أَو يُعَجَّل فَيُنقَمِ",2,"م",1,0],["يُؤَخِّرُ ما تَعجيلُهُ لَكَ راحَةٌ","فَتَحيا كُروبٌ كُلُّهُنَّ شِدادُ",3,"د",1,0],["يُؤْخدُ الْحلمُ من مَكيثِ تَأَنِّيهِ","ونُجْحُ العِداتِ من إِسراعِهْ",4,"ع",2,0],["يؤخذ حين يدنو أيديه","اخذَ العزيزِ للذليل الأحقرِ",5,"ر",1,0],["يؤخرني القريضُ لدى أناس","ركبت إلى مدائحهم شراعهْ",6,"ع",2,0],["يؤخّرني عنك الحيا ويحثّني","إليك رجاءَ حسن عفوك مسرعا",7,"ع",2,0],["يؤخر الرَّجْل طَوراً ثُمَّ يُقْدِمها","عَلَى السلوِّ فلم يُقْدِم وَلَمْ يخِم",8,"م",1,0],["يؤخرني عن عرصة الفضل أن أرى","وبابك عن نظمي ونثري عاطل",9,"ل",1,0]]}