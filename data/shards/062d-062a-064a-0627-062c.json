{"poems":[[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[51,"لله أنت على جفائك","https://www.aldiwan.net/poem10318.html","مجزوء الكامل"],[51,"للهِ أنتَ علَى جفائِكَ","https://www.poetsgate.com/ViewPoem.aspx?id=16959",""],[275,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[302,"وافتك تنهج للخطاب سبيلا","https://www.aldiwan.net/poem33192.html","الكامل"],[358,"لله در عصابة من هاشم","https://www.aldiwan.net/poem39791.html","الكامل"],[403,"يا جارَ نَضلَةَ قد أنى لكَ","https://www.aldiwan.net/poem702.html",""],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[422,"ما غاب بدر دجى منكم ولا غربا","https://www.aldiwan.net/poem53990.html","البسيط"],[445,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[457,"لله يوم في طلائعه لنا","https://www.aldiwan.net/poem13845.html","مجزوء الكامل"],[458,"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[521,"أصبت يوم الصعيد من سكر","https://www.aldiwan.net/poem48643.html","المنسرح"],[558,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107261","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34434","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63891","البسيط"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133975","البسيط"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145543","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132142","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199100","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86377","الكامل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34763","المنسرح"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[5431,"ولم أزل ممشيا!","https://www.poetsgate.com/ViewPoem.aspx?id=192762",""],[5771,"شُكرًا","https://www.poetsgate.com/ViewPoem.aspx?id=189157",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""]],"verses":[["حَتّى أَجَنَّ سَوادُ اللَيلِ نُقبَتَهُ","حَيثُ اِلتَقى السَهلُ مِن فَيحانَ وَالجَلَدُ",0,"د",1,0],["حَتّى أُجَدِّدُ ما تَغَيَّ","رَ لي وَأَخلَقَ مِن إِخائِك",1,"ك",1,0],["حتَّى أُجدَّ بِمَا تَغَ","يَّرََ لي وأخْلَقَ مِنْ إخائِك",2,"ك",1,0],["حتى اجتياحِ المَغربِ الباكي على","أبنائهِ من مَيِّتٍ ونهيك",3,"ك",1,0],["حتّى أُجادِلَ فيكَ كلَّ مكذّب","وأقيمَ منكَ على الوَفاءِ دَليلا",4,"ل",2,0],["حَتّى اِجتَنوا ثَمر المَحاسن فَاِغتَدى","زرع الجَمال بِوَجنَتيهِ هَشيما",5,"م",2,0],["حتَّى أجازِي بالذِي اجتَرمت","عَبسٌ بأسوأ ذلك الجُرمِ",6,"م",1,0],["حَتّى اجتَلَينا بَعدَ طولِ السُرى","بغرَّة الكامِل وَجه الصَباح",7,"ح",1,0],["حتَّى أجابته إذ نادى مآربه","بمنصب لو دعاه غيره لأبى",8,"ب",2,0],["حتى اجتلَوْا قمر الخلافةِ حولَهُ","أَمثالَ زَهْرِ كَواكبِ الأَفلاكِ",9,"ك",1,0],["حتى اجتلينا الربوةَ ال","غناء من تلك المشارف",10,"ف",1,0],["حتى أجدد من غنى إكسيره","عمري وأرشف نعمتي وروائي",11,"ي",1,0],["حَتّى اجنّوه في ضَريحِهِم","حَتّى اِنتَهى مِن خَليلِهِ الاَجَل",12,"ل",1,0],["حَتّى أَجابوكَ مِن مُستَأمِنٍ حَذِرٍ","راجٍ وَمُنتَظِرٍ حَتفاً وَمَثمودِ",13,"د",1,0],["حَتَّى اجتَمَعنَ مِنَ الآفاقِ أجمعها","مِنَ العراقِ وَمِن شامٍ وَمِن يَمَنِ",14,"ن",1,0],["حَتّى أَجَبتُ الحُبَّ لما دعان","بِلا تَوان",15,"ن",1,0],["حتى أُجاريكَ في ميدانِ لهوكَ ما","أطاقتِ اللهوَ في الميدان أفراسي",16,"س",2,0],["حتى اجتمعنا بسابور الجنود وقد","شبت لنا ولهم نار لها شرر",17,"ر",1,0],["حتى اجتنى ثمراً من غرسها نضراً","افنانه اينعت فيها ازاهره",18,"ر",2,0],["حتى اجتلى غرة السعد التي شفعت","له وللكل في اللقاء ما ركبوا",19,"ب",3,0],["حتى أجلت اللحظ في ظلماتها","وبحثت في الجنبات والأطراف",20,"ف",1,0],["حتى أجوز وتبدو لي معالم من","دوان تخفق في بردين من شمم",21,"م",1,0],["حتى أجزن بذي الأراك ضحى","وعلى المطاف حبسن والمسعى",22,"ع",2,0],["حَتّى أَجَزتُ الأَحماسَ إِنّي عَلى","أَمثالِ هاتيكَ حازِمٌ بَطَلُ",23,"ل",1,0],["حتى اجتباك إلى الإمامة ربنا","ما للإمامة غير نفسٍ طائعة",24,"ع",2,0],["حتى أجيئَ بعرشه ويخر لي","في شرع حبيَ عابدا وثنيا",25,"ي",2,0],["حَتى أُجهّز للطَّريقِ قَوافلي","وأبثّ للأكوانِ فِكراً نيّرا",26,"ر",2,0],["حتّى أجبتُ ملبِّياً لِهتافِهمْ","العرشُ أُبقي فَوقهُ قَدميَّهْ",27,"ي",2,0]]}