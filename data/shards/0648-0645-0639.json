 في منازلنا","https://www.aldiwan.net/poem63828.html","البسيط"],[50,"يا رام قومي اصبحينا غير تصريد","https://www.aldiwan.net/poem63869.html","البسيط"],[50,"تنح لحاك الله لست من العدد","https://www.aldiwan.net/poem63887.html","الطويل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[50,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[46,"يا ظالما عقد اليدين مصليا","https://www.aldiwan.net/poem22585.html","الكامل"],[46,"أيسجنني رب العلا منصف","https://www.aldiwan.net/poem23125.html","الطويل"],[46,"صاحب الشرطة إن أنصفني","https://www.aldiwan.net/poem23428.html","الرمل"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[19,"أبا دليجة من لحي مفرد","https://www.aldiwan.net/poem361.html",""],[76,"ومعترك تهز به المنايا","https://www.aldiwan.net/poem38842.html","الوافر"],[76,"ومعشر تنطق أقلامهم","https://www.aldiwan.net/poem38877.html","السريع"],[76,"وجيش كظهر اليم تنفخه الصبا","https://www.aldiwan.net/poem39021.html","الطويل"],[76,"ومعذر نقش الجمال بمسكه","https://www.aldiwan.net/poem39469.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39309","السريع"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9982","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20999","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42568","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54931","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54861","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55062","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142017","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[106,"سبق الفضاء!","https://www.poetsgate.com/ViewPoem.aspx?id=179491",""],[106,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[93,"هَذِي رُؤُوسُ الْقِمَمِ الشِّمَّاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31925",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[45,"غلّسَ الشّيبُ، أوْ تَعجّلَ وِرْدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32940",""],[45,"سَفَاهَاً تَمَادَى لَوْمُهَا وَلَجاجُها","https://www.poetsgate.com/ViewPoem.aspx?id=32942",""],[80,"ومعرضة ٍ ولتْ تمدّ تجنباً","https://www.poetsgate.com/ViewPoem.aspx?id=3340",""],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[94,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[51,"يا عليّ العلا ابن قاسمِ القا","https://www.poetsgate.com/ViewPoem.aspx?id=30288",""],[89,"أوَ هل يعود إلى العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=55711",""],[56,"ومعدولة ٍ مهما أَمالَتْ إزارَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17693&r=&rc=13",""]],"verses":[["وَمُعتَرَكٍ لِلوَصلِ يُجلى عَجاجُهُ","بِبَطحاءَ قَومٍ عَن قَتيلٍ وَقاتِلِ",0,"ل",1,1],["وَمُعَرَّسٍ هَزِجِ الوُحوشِ كَأَنَّما","طَرَقَ المَسامِعَ عَن غَماغِمِ مِرجَلِ",1,"ل",1,0],["وَمُعتادَةٍ لِلطيبِ لَيسَت تُغِبُّهُ","مُنَعَّمَةِ الأَطرافِ تَدمى مِنَ اللَمسِ",2,"س",1,1],["وَمُعضِلَةٍ كَفيتَ وَذاتِ وَهيٍ","شَدَدتَ لَها العِراقي وَالعِناجا",3,"ج",2,0],["وَمَعرَكٍ صافَحَت أَيدي الحِمامِ بِهِ","طُلى الرِجالِ عَلى الخُرصانِ مِن كَثَبِ",4,"ب",1,0],["وَمَعروفُكِ السامي أَنيسُكِ كُلَّما","وَرَدَ الظَلامُ بِوَحشَةِ الغَبراءِ",5,"ا",2,0],["وَمُعتَلِجِ الجَلالِ نَزَعتَ عَنهُ","عَلى عَجَلٍ رِداءَ الكِبرِياءِ",6,"ا",2,0],["وَمُعلي حَنينِ القَوسِ في كُلِّ غارَةٍ","بِسَهمِ نِضالٍ أَو بِسَهمِ غَلاءِ",7,"ا",2,0],["وَمَعَ الرَّكبِ ظَبيَةٌ تَصرَعُ الأُسْ","دَ بِعَينٍ كالمَشرَفيِّ صَقيلا",8,"ل",2,0],["وَمُعَرَّسٍ لِلَّهْوِ يَسْحَبُ ذَيْلَهُ","فِيهِ السَّحابُ وَطَيْرُهُ يَتَرنَّمُ",9,"م",1,1],["وَمُعْتَجرٍ بِالْحِلْمِ وَالسِّلْمُ تُبْتَغَى","وَلِلْجَأْشِ في بُحْبوحَةِ الحَرْبِ رابِطِ",10,"ط",1,0],["ومُعرَّسُ النُّعْمى دَواةٌ حلْيُها","حَسَبٌ تحُفُّ بهِ عُلاً وفضائِلُ",11,"ل",1,0],["وَمَعَ الجَونِ جَونِ آَلِ بَني الأَو","سِ عَنُودٌ كَأَنَّها دَفواءُ",12,"ا",2,0],["وَمُعاوِدِ التَكرارِ طالَ مُضِيُّهُ","طَعناً بِكُلِّ مُثَقَّفٍ عَسّالِ",13,"ل",1,0],["وَمُعيني عَلى النَوائِبِ لَيثٌ","هُوَ ذُخري وَفارِجٌ لِهُمومي",14,"م",2,0],["وَمَعَانٍ فِي سُطُورٍ","كَأَسُودٍ فِي غِيَاضِ",15,"ض",1,0],["وَمُعْجِزَةُ الْقُرْآنِ أَجْلَى فَإِنَّهُ","عَجَائِبُهُ لاَ تَنْقَضِي وَعُلُومُهُ",16,"م",2,0],["وَمَعْقِدُ مُلْكٍ طَالِبِيٍّ نِجَارُهُ","عُلاَهُ مُرَدىٍّ بِالْمَهَابِةِ مُعْتَمُّ",17,"م",1,0],["ومَعاني البَيانِ هُنّ عَذارَى","لا يُبِحْنَ الشُّيوخَ عَقْدَ نِكاحِ",18,"ح",1,0],["ومَعْلَمٌ للدّينِ شَيّدْتَهُ","فهَذِهِ الأعْلامُ منْهُ تَلوحْ",19,"ح",1,0],["ومُعْتَمِد مِنْ بَعْدِهِم ومُؤَيَّد","وَعُدِّدَتِ الآثَارُ مِنْ كُلِّ أَوْحَدِ",20,"د",1,0],["وَمَعقودَةِ العَزمِ مِن رَأيِهِ","قَليلٌ مِنَ الناسِ يَحتالُها",21,"ل",3,0],["وَمُعَنّىً مِنَ الضَنى بِهَناتٍ","نَكَأَت بِالكُلومِ قَرحَ الكُلومِ",22,"م",1,0],["وَمُعتَقِدُ الرِياسَةِ في سِواهُ","كَمُعتَقِدِ النُبُوَّةِ في سَجاحِ",23,"ح",1,0],["وَمُعتَضِدٌ بِاللَهِ يَحمي ذِمارَهُ","فَلا سِربَ يُلفى في حِماهُ مُرَوِّعا",24,"ع",2,0],["ومعاهد كانت علي كريمة","لم يبق لي منها سوى التذكار",25,"ر",1,0],["وَمَعاصِمٍ لِلهالِكي","نَ وَساسَةٍ قِدَماً مَحاشِد",26,"د",1,0],["وَمُعمَلَةٍ سُقتَها قاعِداً","فَأَعلَمتَ بِالسَيفِ أَغفالَها",27,"ل",3,0],["وَمَعَانٍ يَسْتَدِيمُ بِهَا","وَجْهُ حَيٍّ مُنْقَضِي النَّحْبِ",28,"ب",1,0],["ومع الإجادة جدةٌ","إن تأت من تمثيل فكرك",29,"ك",1,0],["وَمُعَوَّدٍ فِي خُوْضِ كُلِّ كَرِيهَةٍ","أَلاَّ يُبالِيهَا عَلَى أَهْوَالِهَا",30,"ل",3,0],["وَمَعَالِجُ الأَرْضَيْنِ تُصْلِحُهَا","مِنْ حَيْثُ كَانَ الجَهْلُ يُفْسِدُهَا",31,"د",3,0],["وَمُعِيلُونَ تَلاهَوْا عَنْ شَوَاغِلِهِمْ","حِيناً وَمَا الدَّهْرُ بِاللاَّهِي وَلا الوَانِي",32,"ي",1,0],["وَمُعَاتِباً أسيَافَهَا أُغْمِدَتْ","وَالغِمْدُ أَكَّالٌ لِنَصْلِ الصَّارِمِ",33,"م",1,0],["وَمُعَالِجاً أَزَمَاتِهَا مَا أَعْضَلَتْ","بِمَضَاءِ مِقْدَامٍ وَدُرْبَةِ حَازِمِ",33,"م",1,0],["وَمُعتَقِلَ اللِسانِ بِغَيرِ خَبلٍ","يَميدُ كَأَنَّهُ رَجُلٌ أَميمُ",34,"م",1,0],["وَمُعتَدِّ أَيّامٍ كَأَيّامِنا الَّتي","رَفَعنا بِها سَمكَ البِناءِ المُطَوَّلِ",35,"ل",1,0],["وَمُعتَمِدٍ جَعَلَت لَهُ رِبيعاً","وَطاغِيَةٍ جَعَلَت لَهُ نَكالا",36,"ل",2,0],["ومعن مزاج مزنم","من يعشقوا ما يندم",37,"م",1,0],["ومعي أول بدينا","أحبيبي ما بين اديّا",38,"ي",2,0],["ومعروشةِ الأرجاء مفروشةٍ بها","صنوفٌ من النعماء منها وطاؤُها",39,"ا",3,0],["ومعشراً أسكنَتْهم في الذُرا غُرَفاً","ومعشراً بطن ملحود ومضروح",40,"ح",1,0],["ومعهد أسِّست قواعده","في بلد شَفّني هوى عربه",41,"ب",2,0],["ومعهد علم أسسته عِصابة","من القوم تسعَى للنجاح وتَجْهَد",42,"د",1,0],["وَمَعتِبَةَ العِيالِ وَهُم سِغابٌ","عَلى دَرِّ المُجالِحَةِ الرَفودِ",43,"د",1,0],["وَمَعبِدُكُم دَعا عُدَسَ بنِ زَيدٍ","فَأُسلِمَ لِلكُبولِ بِشَرِّ حالِ",44,"ل",1,0],["وَمَعي حامِيَةٌ مِن جَعفَرٍ","كُلَّ يَومٍ تَبتَلي ما في الخِلَل",45,"ل",1,0],["وَمُعتَسِفٍ بِالرُمحِ دونَ صِحابِهِ","تَعَسَّفتُهُ بِالسَيفِ وَالقَومُ شُهَّدُ",46,"د",1,0],["وَمُعَوَّدٍ فَكَّ العُناةِ مُعاوِدٌ","قَتَلَ العُداةِ إِذا اِستَغارَ أَطالا",47,"ل",2,0],["وَمُعتَكِفٍ عَلى حَلَبٍ بَكِيٌّ","يَقوتُ عِطاشَ آمالٍ غِزارِ",48,"ر",1,0],["وَمُعَوَّدٍ لِلكَرِّ في حَمَسِ الوَغى","غادَرتُهُ وَالفَرُّ مِن عاداتِهِ",49,"ت",2,1],["ومعاطفٍ كالماءِ تحتَ ذوائبٍ","فأعجب لهنَّ جوامداً وذوائِبا",50,"ب",2,0],["ومعالٍ عقد أقربها","بالثريا غير منتكث",51,"ث",1,0],["ومعاني ألفاظه تنفث الس","حرَ على بعدها من التعقيد",52,"د",1,0],["ومعاودٍ منه اقتباس فوائد","لو شامها الأعشى الكبير تتلمذا",53,"ذ",2,0],["ومعاطفٍ مثل الغصو","ن سبت حشايَ الطائره",54,"ر",2,0],["ومعدن خير بالفضائل والهدى","لطلابه يهدي الجواهر والنثرا",55,"ر",2,0],["ومعجّل الجدوى جزافاً لا كمن","هو ضارب الأخماس في الأسداس",56,"س",1,0],["ومعانٍ قد شادَ بيت سناها","وبيوت السادات بين انْقضاض",57,"ض",1,0],["ومع المشيب ففي من سنّ الصبى","جهلٌ وضرسُ غوايةٍ لم يقلع",58,"ع",1,0],["ومع اهْتمام الهمّ بي فاسْتجلها","عذراء قالَ ثناؤها ما أصدقا",59,"ق",2,0],["ومعالٍ لو رامها نجم أفق","عاقه عن لحاقها العيوق",60,"ق",1,0],["ومعمل الخدع عند الحرب يعجز عن","عمَّال ما قلَّ منه ألف بطال",61,"ل",1,0],["ومعاطفاً تحكي يراع محمدٍ","غصناً عليه جوامع البستان",62,"ن",1,0],["ومعانٍ يحيى لها فلقد أو","تي حكم الفخار فيها صبيّا",63,"ي",2,0],["ومَعَاذَ الإله لا مدحَ يأتي","فيه كَرْهاً بل مُعفياً إعفاءَ",64,"ا",2,0],["ومعَ العَتْب والعتابِ فإني","حاضرُ الصفح واسعُ الإعفاءِ",65,"ا",2,0],["ومُعنِّفٍ لي أنْ هَجَوْ","تُك يا أقلَّ من الصُّؤَابهْ",66,"ب",2,0],["ومُعَزٍّ عن الشباب مُؤسٍّ","بمشيبِ اللِّدات والأترابِ",67,"ب",1,0],["ومعاني أبي الحسين كَوافٍ","وهو واف من ثغره بِسَدادِهْ",68,"د",2,0],["ومعي سالفُ الموالاة والمد","ح وشكرٌ مستأنفٌ موفورُ",69,"ر",1,0],["ومعافاة وشكرٍ","لا ابتلاء واصطبارِ",70,"ر",1,0],["ومعتضدٍ بالله أضحى وربُّهُ","له عضدٌ يحميه دوْر الدوائِرِ",71,"ر",1,1],["ومعتركٍ ضَنْكٍ تلوح زِجاجُهُ","وتبرقُ هِنْديّاته وقوانسه",72,"س",2,0],["ومعاشر بصقوا على ما قلته","لم أرض أوجههم مَمَجَّ بصاقي",73,"ق",2,1],["ومعي ذاك والمودةُ والشك","رُ ضميراً مجمجماً ومقالهْ",74,"ل",2,0],["ومعتذرٍ من نعمةٍ قد أفادها","وآخر مُمتنٌّ عليَّ بباطلِ",75,"ل",1,1],["ومعتركٍ تبدو نجومُ حديده","وقد لفّه ليلٌ من النقع أطخمُ",76,"م",1,0],["ومعروفٌ له ديوانُ أصلٍ","وليس عليه من عذلٍ زِمامُ",77,"م",1,0],["ومعانِي