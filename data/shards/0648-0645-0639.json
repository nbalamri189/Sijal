ويدُ وُدٍّ","لِلَّذي في قَناتِهِ تَأويدُ",102,"د",1,0],["وَمُعتَرِضينَ إِن عَظَّمتُ أَمراً","بِهِم شَهِدوا عَلَيَّ وَهُم شُهودي",103,"د",2,0],["وَمُعانٌ مِنَ السِيادَةِ خِرقُ","أَجمَعَت وائِلٌ عَلى تَسويدِه",104,"د",2,0],["وَمَعانٍ لَو فَصَّلَتها القَوافي","هَجَّنَت شِعرَ جَروَلٍ وَلَبيدِ",105,"د",1,0],["وَمَعاشِرٍ رَدَّ العُبوسُ وُجوهَهُم","أَوقابَ مَحنِيَةٍ لَبِسنَ العَرمَضا",106,"ض",2,0],["وَمُعانٌ بِالنَصرِ راعَ الأَعادي","بِفُتوحٍ في الخالِعينَ تِباعِ",107,"ع",1,0],["وَمَعالٍ أَصارَها لِاِجتِماعٍ","شَملُ مالٍ أَصارَهُ لِاِفتِراقِ",108,"ق",1,0],["وَمُعتَمِدٌ عَلى اللَهِ قَد","أَيَّدَهُ اللَهُ بِعَقدٍ وَثيق",109,"ق",1,0],["وَمَعاذَ الإِلَهِ أَن أَتَعَزّى","عَنهُ طولَ الأَيّامِ أَو أَتَسَلّى",110,"ل",2,0],["وَمَعَ الشَيبِ عَلى عِلّاتِهِ","مُهلَةٌ لِلَّهوِ حيناً وَالغَزَل",111,"ل",1,0],["وَمُعتَفيهِ مُحِلٌّ مِن صَنائِعِهِ","لَكِنَّهُ مُحرِمٌ مِن خَلَّةِ العَدَمِ",112,"م",1,0],["وَمُعَصَّبٍ بِالتاجِ يَخفِقُ فَوقَهُ","خِرَقُ المُلوكِ لَهُ خَميسٌ جَحفَلُ",113,"ل",1,0],["ومعيد سابغة المواهب بعدما","بدأت فأغنت أن تكون عوائدا",114,"د",2,0],["ومُعَصفَرِ الخدِّ الأسيلِ صَبحتُه","بمُعَصفرِ الناجودِ يَنضَحُ عَندَما",115,"م",2,0],["ومعتدلٍ إذا أمضَى القَضايا","رأيتَ الحُسن عدلاً واعتدَالا",116,"ل",2,0],["وَمُعْتَدِلٍ يسعَى إليَّ بكأسِه","وقَد كادَ ضَوْءُ الصُّبحِ باللَّيلِ يَفْتِكُ",117,"ك",1,1],["ومَعانٍ لو جُلْنَ في أُذُنِ العا","شقِ أنشاه حُسنُها المَعشُوقا",118,"ق",2,0],["ومُعَذَّلٍ أخذَ الصِّبا بيمينِه","فجَرى به جَرْيَ الجَموحِ السابقِ",119,"ق",1,0],["ومَعانٍ فتَّقْتَهُنَّ فأَصبحْ","نَ لمِسْكِ الكَلامِ مثلَ الفِتاقِ",120,"ق",1,0],["ومَعْتَزِلِيٌّ رَامَ عَزْلَ وِلايَتي","عَنِ الشَّرَفِ العَالي بِهِمْ وارتِفَاعِهِ",121,"ع",2,0],["ومَعرَكَةٍ يَسْوَدُّ للنَّقعِ أُفقُها","وتَحمَرُّ من فَيْضِ الدِّماءِ رُبوعُها",122,"ع",3,0],["ومعتصِبٌ بتاجِ المُلكِ فيهِ","إلى مَنْ رامَ نائلَهُ افتقارُ",123,"ر",1,0],["ومعرجا كالأين ما ونت الصبا","فإذا علته أرتك منه مبردا",124,"د",2,0],["ومُعرِّضٍ لي بالطِّرادِ خَسَأتُه","ومتى رأيتَ اللَّيثَ طاردَ ثعلَبا",125,"ب",2,0],["ومُعطيةٍ صَفْوَ ما استودَعَتْ","مسامحةً عندَ إعطائِها",126,"ا",3,1],["وَمَعَ اللَهِ أَنتَ ما دُمتَ حَيّاً","وَإِلى اللَهِ بَعدَ ذاكَ تَصيرُ",127,"ر",1,0],["وَمَعشَرٍ إِن يَمَّموا نَحوَكُم","يَحظونَ بِالزُلفى وَحُسنِ المَآب",128,"ب",1,0],["وَمَعانٍ مُشرِقاتٌ حِسانٌ","ما تَوارَت شَمسُها في حِجابِ",129,"ب",1,0],["وَمَعانٍ تُضيءُ في قالَبِ اللَف","ظِ فَيَجلو مِصباحُها مِشكاتَه",130,"ت",2,0],["وَمُعَربِدِ اللَحَظاتِ يَثني عِطفَهُ","فَيُخالُ مِن مَرَحِ الشَبيبَةِ شارِبا",131,"ب",2,0],["وَمُعَنِّفٍ في الظَنِّ قُلتُ لَهُ اِتَّئِد","فَأَقصِر فَبَعضُ الغَيبِ غَيبٌ يُعلَمُ",132,"م",1,0],["ومعرضُ أجوف المعنى وأسماءٌ","مذ آذنتنا بهذا البينِ أسماءُ",133,"ا",2,0],["ومعاني الحسنِ تَترَى وأنا","ناظرٌ فيها لِمَعنًى خَلفَ معنى",134,"ن",2,0],["ومعلماتِ طَلُوعِ النّبْعِ حيثُ لها","في نَزْعِهِن بألحانِ الردى نَغَمُ",135,"م",1,0],["ومُعتَرَكٍ تَلَقّى الفنشُ فيه","غريماً مهلكاً نَفْسَ الغريمِ",136,"م",1,0],["ومعتادةٍ أكْلَ الكماةِ جيوشها","أعاربُ تدعو للنّزال أعاجما",137,"م",2,0],["ومَعْبَدُ الطير وهو بلبُلها","مُرَجِّعٌ في غصينه نَغَمَه",138,"م",2,0],["ومُعَطَّشاتٍ في سُعُورِ قُيونها","تُسْقى نجيعَ جماجمٍ وكواهِلِ",139,"ل",1,1],["وَمُعجِزِ آياتِ الندى ذي سَماحَةٍ","مُجانِسِ نَظمِ المكرُمات مقابِلِه",140,"ل",2,0],["ومُعْرِضَةٍ وَلّتْ تَمُدّ تجنُّباً","قصارَ خطاها عن مَشيبِيَ والوخطِ",141,"ط",1,1],["ومُعتَذِرٌ عمّا تنيلُ يمينه","وكلّ المنى في البعض منه فما العذرُ",142,"ر",1,0],["ومُعذِّبي مَنْ يَستلذُّ تَعذّبي","لا باتَ من بلوَايَ كيفَ أبِيتُ",143,"ت",1,0],["وَمُعاوِدٍ لِلبيدِ لا يَهفو بِهِ","هافٍ وَلا يَزهاهُ فيها زاهِ",144,"ه",1,0],["وَمُعَرِّفُ الخُلَفاءِ أَنَّ حُظوظَها","في حَيِّزِ الإِسراجِ وَالإِلجامِ",145,"م",1,0],["وَمُعتَرَكٍ لِلشَوقِ أَهدى بِهِ الهَوى","إِلى ذي الهَوى نُجلَ العُيونِ رَبائِبا",146,"ب",2,0],["وَمُعَرَّسٍ لِلغَيثِ تَخفِقُ بَينَهُ","راياتُ كُلِّ دُجُنَّةٍ وَطفاءِ",147,"ا",2,0],["ومعذَّرٍ كالمسكِ نبتُ عذارِهِ","والخالُ فهْوَ زيادةُ العطّارِ",148,"ر",1,0],["وَمَعمَلِ أَصحابي وَخَوصٍ ضَوامِرٍ","وَمَمشى إِلى البُستانِ يَوماً وَمَقعَدِ",149,"د",1,0],["وَمَعينُ ماءِ البِشرِ أَبرَقَ هَشَّةً","فَكَرَعتُ مِن صَفَحاتِهِ في مَشرَبِ",150,"ب",1,1],["وَمَعشوقَةِ الحُسنِ مَمشوقَةٍ","يَهيمُ بِها الطَرفُ وَالمَعطِسُ",151,"س",1,1],["وَمُعَضَّلٍ تُسقى الكُماةُ سِمامَه","وَكَأَنَّما تُسقى سِمامَ الأَسوَدِ",152,"د",1,0],["وَمُعَطَّلٍ وَالحُسنُ يَعشَقُ جيدَهُ","فَيُبينُ بِالوَسواسِ عَن وَسواسِهِ",153,"س",2,1],["وَمَعشوقِ الشَبابِ لَهُ جُفونٌ","تُعَلِّمُ كَيفَ تُختَلَسُ العُقولُ",154,"ل",1,0],["وَمَعَ الشَمسِ أَينَ لاحَت شُروقٌ","وَمَعَ الريحِ حَيثُ طارَت مَطارُ",155,"ر",1,0],["وَمُعتَمَدٍ مِن صَدرٍ رِجلٍ مُحالَةٍ","عَلى عَجَلٍ مِن خائِفٍ غَيرَ آمِنِ",156,"ن",1,0],["وَمُعَوَّدُ الجَفراءِ رَهنُ قِسِيِّهِم","بِالجَرجَرادِ بِكُلِّ يَومِ فَخارِ",157,"ر",1,0],["وَمُعظَمُ الفُتوحِ فيهِ آمِدُ","مَعقِلُ كُلِّ فاجِرٍ مُعانِدِ",158,"د",1,0],["وَمُعافىً وَذو سَقامٍ وَحَيٌّ","وَحَبيسٌ تَحتَ التُرابِ مُقيمُ",159,"م",1,0],["وَمَعشوقٍ يُواصِلُني","بِلا وَعدٍ وَلا عِلَلِ",160,"ل",1,0],["وَمُعتَلِّ المَواعِدِ ذي مِكاسِ","مَليٍّ بِالتَأَبّي وَالشِماسِ",161,"س",1,1],["وَمَعشوقِ الشَمائِلِ عَسكَرِيٍّ","لَهُ قَتلى وَلَيسَ لَهُ جِراحُ",162,"ح",1,0],["وَمُعَشَّقِ الحَرَكاتِ يَحلو كُلُّهُ","عَذبٌ إِذا ما ذيقَ في الخَلَواتِ",163,"ت",1,0],["ومَعْشَرٌ قُطِعَتْ أَوْصالُهمْ قِطَعاً","فما يُلَفِّقُها خَيْطٌ ولا إبَرُ",164,"ر",1,0],["ومَعْشَرٌ بالظُّبا طارتْ رؤُوسُهُمُ","عَنِ الجُسومِ فَقُلْنَا إنها أُكَرُ",164,"ر",1,0],["وَمَعْشَرٌ وُسِّطُوا مثْلَ الدِّلاءِ وَلمْ","تُرْبَطْ حِبَالٌ بها يَوْماً ولا بَكَرُ",164,"ر",1,0],["وَمَعْشَرٌ سُمِّروا فوْقَ الجِيادِ وقدْ","شَدَّتْ جُسومَهُمُ الألواحُ وَالدُّسُرُ",164,"ر",1,0],["ومعَ الجيرَةِ الذينَ غَدَوا دَم","عٌ طليقٌ ومُهجَةٌ في وَثاق",165,"ق",1,0],["ومَعلومُها في كلّ نفسٍ جِبِلّةٌ","بها يَسْتهلّ الطفلُ وهو وليد",166,"د",1,0],["وَمُعتَدٍ بِالَّذي تَحوي أَنامِلُهُ","مِن كَأسِ مُنتَخِبٍ لَم يَثنِهِ المَلَلُ",167,"ل",1,1],["وَمُعتَدِلٍ إِلَيَّ بِشَطرِ عَينٍ","لَهُ مِن كَسرِ ناظِرِهِ رَسولُ",168,"ل",1,0],["وَمُعَقرَبِ الصُدغَينِ في لَحَظاتِهِ","سِحرٌ وَفيهِ تَظَرُّفٌ وَمُجونُ",169,"ن",1,1],["ومعتدل الروادف ذي انخناثٍ","بمحجرِ عينهِ بُدَعُ السقام",170,"م",1,0],["ومعقربِ الأصداغ يهتكُ لحظهُ","عن كلّ مكنونٍ من الأسرار",171,"ر",1,0],["وَمَعشَرٍ جَعَلوا حُبّي زِيارَتَكُم","عاراً عَليَّ وَما بِالحُبِّ مِن عارِ",172,"ر",1,0],["وَمَعشَرٍ مُنقَعٍ لي في صُدورِهِمُ","سُمُّ الأَساوِدِ يَغلي في المَواعيدِ",173,"د",1,0],["وَمُعتَرِضٍ سَكَّنتُهُ بِغَريبَةٍ","لَها مَذهَبٌ في كُلِّ حَيٍّ وَمُنتَقَد",174,"د",1,0],["وَمُعَوَّدٌ ضَربَ الرِقا","بِ وَفَكَّهُنَّ مِنَ الحَدائِد",175,"د",1,0],["وَمُعَذَّلٍ هَجَرَ اللِئامُ حَديثَهُ","مُتَعالِمٍ بِفُتُوَّةٍ وَمِزاحِ",176,"ح",1,0],["وَمَعَ الفَتى مِن نَفسِهِ نُمَيَّةٌ","ما زالَ يَحلِفُ أَنَّها دينارُ",177,"ر",1,0],["وَمُعتَزِليٍّ لَم أُوافِقهُ ساعَةً","أَقولُ لَهُ في اللَفظِ دينُكَ أَجزَلُ",178,"ل",1,0],["وَمَعَ الضَيرِ بُلوغٌ لِلمُنى","وَمَعَ النَفعِ شَكاةٌ وَأَلَم",179,"م",1,0],["ومَعْرِفَةُ ابنِ أحمَدَ أمّنَتْني","فما أخْشَى الحَقيبَ ولا النّطيحَا",180,"ح",2,0],["وَمُعَصَّبينَ عَلى نَواجٍ سُدتَهُم","مِثلُ القِسِيِّ ضَوامِرٍ بِرِحالِ",181,"ل",1,0],["وَمُعْتَرَكٍ تَهُزُّ بهِ المَنايا","ذُكورَ الهِنْدِ في أيْدي ذُكورِ",182,"ر",1,1],["ومَعشرٍ تَنطِقُ أَقلامُهُمْ","بحكمةٍ تَلقَنُها الأَعينُ",183,"ن",1,1],["ومُعتَركٍ ضَنْكٍ تَعاطَتْ كُماتُهُ","كؤوسَ دِماءٍ من كُلىً ومَفاصلِ",184,"ل",1,0],["وَمُعَذَّرٍ نَقشَ الجمالُ بمِسْكِهِ","خَدّاً لَهُ بِدَمِ القُلُوب مُضَرَّجا",185,"ج",2,1],["وَمعرضين وجوههم","بيضاً لنيران لوافح",186,"ح",1,0],["ومعانٍ أرقُّ من نسمة الفجرِ","ولفظٌ من سلسل الخمرِ أعذبْ",187,"ب",1,0],["ومعابدٌ شمٌّ وآلهةٌ على","سُفُنٍ ذواهبَ بينهنَّ جوائي",188,"ا",2,0],["ومعبد مشترك مشاع","كل العبادات به مشاع",189,"ع",1,0],["وَمَعْشَرٌ أَوْعَدهُمْ رَبُّهُمْ","فبادَروا خَشْيَة ذاكَ الوعِيد",190,"د",1,0],["وَمَعي في المَهدِ كانا","فَوقَ صَدري يُؤنِساني",191,"ي",1,0],["ومَعذِرَةٍ جَرَّت إلَيكَ مَلاَمَةً","وطارِفِ مالٍ هاجَ إتلافَ تالِدِ",192,"د",1,0],["ومُعْتَرَكٍ لِلْخَيْلِ فِي جَنَبَاتِهِ","صَهِيلٌ يَهُدُّ الرَّاسِيَاتِ وَئِيدُهُ",193,"د",2,0],["وَمعَ الصَّبْرِ وَالعَزِيمةِ تَخْضَ","رُّ المَوَامِي وَيُسْتَدَرُّ الجَهَامُ",194,"م",1,0],["وَمُعِيدِ النَّسِيمِ سُمّاً زُعَافاً","وَمُبِيدِ السَّفِينِ بِالإِغْرَاقِ",195,"ق",1,0],["وَمُعَقِّبِ الفَخْرِ التَّلِيدِ بِطَارِفٍ","لَوْلاَهُ كَادَ يَكُونَ سُبَّةَ عَارِ",196,"ر",1,0],["وَمَعَانِي هَذَا الوُجُودِ وَمَا فِي","كُلًّ أَجْزَائِهِ مِنَ المُعْجِزَاتِ",197,"ت",1,0],["وَمُعِزَّ الأخْلاَقِ تُرْثِيكَ عَنْهَا","أَلْسُنُ الأَوْفِياءِ وَالأَحْرَارِ",198,"ر",1,0],["وَمَعَانٍ حَضَرِيَّاتٌ جَلاَ","حَسْنَهَا مِنْهُ طِرَازٌ لَمْ يُعَبْ",199,"ب",1,0],["وَمُعِيرَ التَّمْثِيلِ مَوْعِظَةَ التَّارِيخِ","تَبْدُو فِي أيَّ ثَوْبٍ أَنِيقِ",200,"ق",1,0],["وَمَعْنىً كَتَفْتِيحِ الأَزَاهِرِ بَهْجَةً","وَلَفْظٌ كَمَاءِ الْجَدْوَلِ المُتَرَقْرِقِ",201,"ق",1,0],["ومع الليل لي نحيبْ","كنحيب الحمامتينْ",202,"ن",1,0],["ومُعَمَّرٍ عَبَرَ الوُجودَ فَما رَنَا","طَرْفٌ إِليهِ ولا بَكَى لِبعَادِ",203,"د",1,0],["وَمَعَانٍ شَوْقِيَّةٌ في سِيَاقٍ","بُحْتُرِيٍ وَرِقَّةٌ في مَتَانَهْ",204,"ن",2,0],["ومَعَانِيكَ لا تُحَدُّ فَمَاذَا","يَعْمَلُ الشعْرُ قاصِراً مَحْدُودا",205,"د",2,0],["ومُعتَصمٍ بالمَشرفيَّة لم يكنْ","ليسلَمَ منه في ذُرى الطَّوْدِ أعصَمُ",206,"م",1,0],["ومعلم قد راح يبذل نفسه","بذْلَ الكرام لنا شِئينَ صغار",207,"ر",1,0],["ومعاقِلُ اليونانِ وهْيَ محاربٌ","مكتظَّةٌ بالصُّوَّم القُوَّام",208,"م",1,0],["وَمَعْشَرٍ كَأنْجُمِ الْجَوْزَاءِ","يَلْتَمِسُونَ سُتْرَةَ المسَاءِ",209,"ا",2,0],["ومُعارِضٍ خَدَمَ البلادَ لغايةٍ","شَرُفت وآخرَ خائنٍ كذاب",210,"ب",1,0],["ومعملُه تعيشُ بهِ مئاتٌ","سيُعوزِهُم – إذا سُدَّ – الغذاء",211,"ا",2,0],["ومعاتَبٍ والسَوط يُلهب ظهرهُ","ومعذَّبٍ بجراحه ويُلام",212,"م",1,0],["\" ومعبد \" لم يبل منهجه","بالسالكيه . ولم يَلُحْ أثَر",213,"ر",1,0],["ومعنًّى أزعج الشُّهب له","حر أنفاس فرادى وثنى",214,"ن",2,0],["وَمُعاضُ المَشيبِ يَغدو فيَستَخْ","لِقُ مِنْ عَيشِنا الذي نَستَجدّهْ",215,"د",2,0],["وَمعا زَالَتِ العِيسُ المَرَاسِيلُ تَنبري،","فتُقْضَى لَدَى آلِ المُدَبِّرِ حَاجُهَا",216,"ج",3,0],["ومعرضة ٍ ولتْ تمدّ تجنباً","فصارَ خطاها عن مشيبي والوخط",217,"ط",1,1],["ومعانقا أغصانها من وجده","دلّل هواك فقد ضممت خضورا",218,"ر",2,0],["ومعانقاً أغصانها من شوقه","أعلمت أنك قد ضممتَ خُصورا",219,"ر",2,0],["ومعي ذاك والمودة ُ والشك","رُ ضميراً سجمجماً ومقاله",220,"ل",2,0],["وَمعاهد لم يَبقَ من","آثارها إلا طلول",221,"ل",1,0],["ومعدولة ٍ مهما أَمالَتْ إزارَها","فغصنٌ، وأما قدُّها فقضيبُ",222,"ب",1,1]]}