],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104838","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108343",""],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145186","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91270","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91066","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132094","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36746","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102995","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77078","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199115","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136948",""],[4446,"","https://poetry.dctabudhabi.ae/diwan/poem/139099","الوافر"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35417","الطويل"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123852","السريع"],[4578,"متى بوصالكم توفي الوعود","https://www.poetsgate.com/ViewPoem.aspx?id=49409",""],[1901,"أَلا شَدَّ ما ضنّتْ بمعروفها سُعدَي","https://www.poetsgate.com/ViewPoem.aspx?id=160413",""],[4920,"نسيم الصبح قد هبا","https://www.poetsgate.com/ViewPoem.aspx?id=1026",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[4961,"ليسَ في أوَّل ِ الطريق ِ يُكتشَفُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=40462",""],[3591,"أنظر إلى الماء من نار يسيل وهل","https://www.poetsgate.com/ViewPoem.aspx?id=149417",""],[5155,"الربيع والفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=176155",""],[5213,"قفوا خبروني اين تنجون بالمسى","https://www.poetsgate.com/ViewPoem.aspx?id=170457",""],[5213,"أحبتنا عودوا فقد شفني البعد","https://www.poetsgate.com/ViewPoem.aspx?id=170453",""],[5496,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=213695",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5751,"الصقر مرة اخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214980",""],[422,"وميضُ البرق هيَّج منك وجدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22245&r=&rc=1",""]],"verses":[["أحبَّتي في دِمشق ما ترك الن","وى لقلبِي من بعدكم حبَّه",0,"ب",2,1],["أحبتنا لا عين سلوانَ عنكم","بأرض ولكن كلّ وادٍ جهنم",1,"م",1,1],["أحبته في مصر الطوائف كلها","وذاك لأن الحب فوق العقائد",2,"د",1,0],["أَحَبَّتكَ البِلادُ طَويلَ دَهرٍ","وَذا ثَمَنُ الوَلاءِ وَالاِحتِرامِ",3,"م",1,0],["أَحِبَّتي ما الَّذي أَضَرَّ بِكُم","قُربِيَ بَعدَ النَوى لَوِ اِتَّفَقا",4,"ق",2,0],["أحبَّتنا لو أُنزل الشوقُ والهوى","على قلب صخرٍ جامدٍ لتصدَّعا",5,"ع",2,1],["أحبَّتنَا إنَّ همسَ البحار","زفيرُ الأحَّبةِ لو تعلمونا",6,"ن",2,0],["أَحبتنا لَئِن زالَت عُهود","لَكُم فَعُهودَنا أَبَداً تَدومُ",7,"م",1,1],["احبتنا وحفظ العهد دين","يصون نصوصه الزهر الكرام",8,"م",1,0],["احبتنا لا تجعلوا الهجر طبعكم","فاصعب شيء عند اهل الهوى الهجر",9,"ر",1,0],["احبتنا الأُلى كانوا وكنا","وقد اخذوا جميع الصبر منا",10,"ن",2,1],["احبتنا بحق العهد جودوا","على من منه قد ذاب الوجود",11,"د",1,1],["احبتنا طالت ليالي صدودكم","متى بصنيع الوصل يندفع الصد",12,"د",1,0],["أحبّتي لكم صفو الوداد كما","محضتموني ودّاً ليس بالدون",13,"ن",1,0],["أَحَبَّتهُ مِن سِرِّ النُفوسُ غَرائِزُ","فَطوبى لِمَن أَضحى بِهِ وَهوَ فائِزُ",14,"ز",1,0],["أحبتنا رفقا بمن ليس عنده","لكم بالجفا إلا المودة والحبُّ",15,"ب",1,0],["أَحبتنا هلاَّ النتم قلوبكم","فقد لان لي مما بي الحجر الصلدُ",16,"د",1,0],["أحبتنا نمتم وطرفي ساهر","وما حسن نوم المحبّ عن الحبِ",17,"ب",1,0],["أَحبتنا مالي إِ الأَينِ فيكم","صروف الليالي والليالي تعجرْفُ",18,"ف",1,0],["أحبتنا تطاول مذ نأَ يتم","علينا ذلك الليلُ القصيرُ",19,"ر",1,0],["احبتنا طال الفراق فهل لنا","إلى الوصل من بعد الفراق وصول",20,"ل",1,0],["احبتنا ما للوشاة امانة","فتصغون اسماعا لما عنهم يروى",21,"و",2,0],["أحبتنا وما أشقى محبا","جواه على أحبته يهون",22,"ن",1,0],["أَحبَّتَنا ما أَعذَبَ الهَجرَ بَينَنا","إِذا كانَ حَبلُ الوَصلِ لا بُدَّ يَفصمُ",23,"م",1,0],["أحبتي والفراقُ ويلٌ","تُرمى بأرزائهِ القلوبُ",24,"ب",1,0],["أَحِبَّتي بِجَفاكُم طالَت المُدَّه","لا تَهجُروني فَما لي غَيرَكُم عِدَّه",25,"ه",1,1],["أحبَّتَنا هَل في النّوى يَنعمُ البالُ","وقد كثُرَت حَولي عداةٌ وعُذّالُ",26,"ل",1,1],["أحبّت مِنَ الأزهارِ زَهرَ بَنفسجٍ","لها عطرُهُ واللونُ في عينها استَقر",27,"ر",1,0],["أحِبَّتنا في سَفحِ لبنانَ إنكم","حضرتم بأرواحٍ وغبتم بأجسام",28,"م",1,0],["أحبّت غريباً تستفزُّ فؤادَه","بلثغتها في لفظِها لحبيبي",29,"ب",2,0],["أَحِبَّتَنا بِاللَهِ هَل تَذكُرونَنا","فَإِنّا طَوالَ الدَّهرِ لَم نَنسَ ذِكراكُم",30,"م",1,0],["أحبتنا بنجد والصفيح","مراهم كل ذي قلب جريح",31,"ح",1,1],["أحبتنا هل من سبيل لعودة","نسر بها من قبل أن نتفرقا",32,"ق",2,0],["أَحبتنا لَم يَبقَ صَبر وَلَو بَقي","لَنا بَعدَكُم صَبر لَكانَ مِن الغَدر",33,"ر",1,0],["أحبتنا لكم منا سلام ، لكم","من بلبل الشوق الصداح",34,"ح",1,0],["أحبتي حين مالوا عن مواصلتي","تحيلوا يدعون الذنب من قِبَلي",35,"ي",1,1],["أحبتنا إن تفضلوا بسؤال","عن الحال فاستفتوا فصيح مقالي",36,"ل",2,1],["أَحِبَّتنا قد حالَ بيني وبينكم","خطوبٌ لأحداث الزَّمان وأهوال",37,"ل",1,0],["أَحِبَّتَنا أَنتُم على السُّخط والرّضا","وفي القلب منكُم لوعةٌ ووجيبُ",38,"ب",1,1],["أحبّتك الذين شَقِيتَ فيهم","أسالوا من دموعك ما أسالوا",39,"ل",3,0],["أحِبَّتَنا لك تُنْصِفونا بحبّكم","وما هكذا لو تنصفون جزائي",40,"ي",1,0],["أَحبَّتنا أمَّا الغرام وحَرُّه","فباقٍ وأَمَّا الاصطبار فنافد",41,"د",1,0],["أَحِبَّتنا هلْ من رسولٍ إليكم","وهل مبلغ عنِّي الغرام رسولي",42,"ل",2,0],["أحِبَّتَنا لقد طالَ التنائي","وحالت بيننا بيدٌ فبيد",43,"د",1,0],["أحبَّتَنا هل تذكرون ليالياً","لنا في الحمى كانت تُعَدُّ من العمر",44,"ر",1,0],["أحبَّتَنا وإنِّي قبلَ هذا","شريت هواكمُ بالرُّوح نقدا",45,"د",2,0],["أحبَّتنا لي بالايابِ مواعدٌ","فحتامَ تُلوَى والعِداتُ دُيُونُ",46,"ن",1,0],["أحبَّتنَا وُدَّي كما قد علمتُمُ","سليمُ أَواخيَّ الوفاءِ صريحُ",47,"ح",1,0],["أحبتَّنا مَنْ حلَّ بالجِزعِ بعدكمْ","وقد بنتمُ عنه ومَنْ حلَّهُ بعدي",48,"د",2,0],["أحبَّتَنا بِنتمْ فلي بعد بينكمْ","فؤادٌ أَجَدَّ الوجدُ لي فيه ذِكراهُ",49,"ا",2,0],["أحبَّتنا هل ذلكَ العهدُ باللَّوى","يعودُ كما قد كنتُ أعهدُه دهرا",50,"ر",2,0],["أحبَّتنَا رفقاً بصبًّ نقضتمُ","عُرى عهدِه ظلماً فزادَ اكتئابُهُ",51,"ب",2,0],["أَحبِتَّنَا والحُبُّ سِرٌّ مُطَلسَمٌ","صَبرنا عَلى شيءٍ أَمَرَّ مِنَ الصَبرِ",52,"ر",1,0],["أحبتنا هل تسمعون لنا شكوى","فقد زادنا الهجران بلوى على بلوى",53,"و",2,1],["أَحبَّتي هل عِنْدكم أَنَّني","عُلِّقْتُهَا مَاجِنَةً عِلْقَهْ",54,"ه",1,1],["أَحِبَّتَنا إِن قيلَ في الصَبرِ رُجلَةً","فَإِنّي فَتى أَبغي أَنوحُ وَأجَزَعا",55,"ع",2,0],["أَحبَّتَنا لا تنسوا العَهدَ من فَتى","غَريبٍ أَليفِ الحُزنِ مقلتُه عَبرى",56,"ر",2,1],["أحبتنا وقت اللقا وعهودنا","يمرغ من أتراب أقدامكم خد",57,"د",1,0],["أحبَّتنا أذبتم بالتنائي","فؤاديَ فهو مكتئبٌ حزينُ",58,"ن",1,0],["أحبَّتي إنْ نأَوْا عني وإن قرُبوا","مِنِّي وإنْ وصَلُوا حبلي وإنْ صَرمُوا",59,"م",3,0],["أحِبَّتُنَا قَدْ صَيَّرُوا الشَّوْقَ زَادَنَا","وَقَدْ مَنَعُونَا إنْ نَذُوقَ رُقَادَنَا",60,"ن",2,0],["أَحِبَّتُنَا قَدْ بَدَّلُوا الْقُرْبَ بِالنَّوى","لأَجْلِهِمُ يُسْتَعْذَبُ الْجَوْرُ فِي الْهَوى",61,"ه",3,0],["أحِبَّتَنَا بِنْتُمْ فَبَانَ تَصَبُّرِي","وَغِبْتُمْ عَنِ الْمُضنى فَبَانَ تَحَسُّرِي",62,"ي",1,0],["أَحِبَّتَنَا لاَ أَوْحَشَ اللهُ مِنْكُمُ","أَهَنْتُمْ مُحِبّاً فِي الْهَوى لَمْ يُهِنْكُمُ",63,"م",1,0],["أحبّتَنا أما للهجر حدٌّ","فنستقضي بكم زمن الوصال",64,"ل",1,0],["احبتنا بالوصل جادت فمذ جرت","بهم عيسهم أوطات منسمها خدي",65,"د",2,0],["أَحِبَّتَنا بضَعْفي بِانْكسِاري","بِفَقْري بانْقِطاعي بالْتِجائي",66,"ي",1,0],["أَحِبَّتَنَا عُودُوا إِلى الوَصْلِ واصْرِفُوا","كلامَ الأَعادي عن كِرامِ المَسامعِ",67,"ع",1,0],["أَحبَّتُنا صَدُّوا وقد عَلِموا أَنَّا","متى ما صُرِفْنَا عن جنابِهمُ عُدْنا",68,"ن",2,1],["أحبتي أنتم حلا ومرتحلا","وسلوتي ذكر كم ان مسني مضض",69,"ض",1,0],["أَحِبّتَنا رُوَيدَكُمُ عَلَينا","فَقَد جَمَحَ الهَوى كُلّ الجِماحِ",70,"ح",1,0],["أحبتنا أين المواثيق إننا","ظننا بأن يفنى الزمان ولا تفنى",71,"ن",2,1],["أحبَّتنا ما البعد شيئاً نُطيقه","ولكنه من جملة الحكم في الأَزَلْ",72,"ل",1,1],["أحبتنا البابنا تستطيرها","إليكم علاقات الصفاء ولا تسل",72,"ل",1,0],["أحبتنا لا يملك المرء أمره","ولا يدفع المقدار ضرب من الحِيَل",72,"ل",1,0],["أَحبتنا من طيب نَشأة خَمرِكُم","إِذا جَنَّ ليلي هامَ قَبلي بِذكرِكُم",73,"م",1,0],["أحبتَنا حتى م كتمانُنا الهوى","ألا إِنه في حاله مركبٌ صعبُ",74,"ب",1,0],["أَحِبَّتَنَا قَصَّرتُ فِي شُكرِ مَجدِكُم","وَلَكِنَّنِي أَغيَيَتُ فِيهِ عَلَى قَدرِي",75,"ر",2,0],["أَحبتي فابكوا معي وَنوحوا","وَحققوا معنى الهَوى وَبوحوا",76,"ح",3,0],["أحبتي خالفوني","وخلَّفوني عديما",77,"م",2,0],["أحبتنا وما هان الرواح","جرى بالبين بارحهم فراحوا",78,"ح",3,1],["أحبتنا طبتم وطاب حديثكم","فلا عوض عنكم ولا الصبر يطرأ",79,"ا",1,0],["أحبتي بدمشق الشام ذبت جوى","والعيش قضيته من بعدكم فكرا",80,"ر",2,1],["أحبتنا اني يمل جليسكم","ومجلسكم الطافه الزهر فائحه",81,"ه",1,1],["أحبتنا قد سرنى منكم الشرط","سرورا جليلا لم أسر به قط",82,"ط",1,1],["أحبتنا ماذا الجفا والتشرط","وأنتم بمثلى لا محالة تغبط",83,"ط",1,1],["أحبتنا أين المعري بعابد","ولي بحب اللَه قيد قلبه",84,"ب",2,0],["أحبته ملءَ الصدر في مرح الصبا","جميل المحيا فاتر اللحظ أصيدا",85,"د",2,0],["أَحبتنا من للظعاين بَعدكم","فَلَيتَ فَداكم يا كرام الظعائن",86,"ن",1,0],["أَحبتنا ولي عَتب عَلَيكُم","بِأَحناء الضُلوع يَشب نارا",87,"ر",2,0],["أَحبَّتنا الأَكارم في فَرُوقٍ","سُقيتم مُزنَها غَدِقاً سَكوبا",88,"ب",2,0],["أحِبّتي عند اتصالي بكُم","قطَعتُم وصلي كفعل الحسام",89,"م",1,1],["أحبتنا إن البعاد لقتال","فهل حيلة للقرب منكم فيحتال",90,"ل",1,1],["أحبتنا هل ترى تذكرو","ن لنا وقفة وسمانا تجودُ",91,"د",1,1],["أحبتنا طال التعاتب والهجرُ","أراق لكم ان ينقضي هكذا العمر",92,"ر",1,1],["احبتنا هذا الذي نرتجي به","دوام الهوى اذ تعشقون العلى معنا",93,"ن",2,0],["احبتنا من لي بطيف خيالكم","فقد عزَّ مرآكم على مقلة الرائي",94,"ا",2,0],["أحبتنا ما انتم بعد انتمُ","فلله ما كنا عليه وكنتمُ",95,"م",1,1],["احبتنا آل الرفاعي تعطفوا","بوصل علىمن روحه لكم تفدى",96,"د",2,0],["أحبتنا غبتم فأوحشتم المغنى","وصار وجود الدار لفظاً بلا معنى",97,"ن",2,1],["أحبّتي في مآسيهم ومحنتهم","وفي مآسيّ عذّالي وأعدائي",98,"ا",3,0],["أحبتنا أين المواثيق بيننا","زمان خلونا الحمى وتعاهدنا",99,"ن",2,0],["أحبتي ما بنت عن ربعكم","متخذاً في الناس عنكم بدلا",100,"ل",2,0],["أحبّتنا بأبي أنتم","وسقياً لكم أينما كنتم",101,"م",1,1],["أحبتنا سرن الظعون ولم نجد","لنا منكم لما س