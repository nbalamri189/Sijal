ttps://www.aldiwan.net/poem61662.html","الكامل"],[458,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[461,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem16421.html","الوافر"],[468,"خلائقنا من زهرة الروض أعطر","https://www.aldiwan.net/poem59977.html","الطويل"],[468,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[470,"وإذا الدر زان حسن وجوه","https://www.aldiwan.net/poem4831.html","الخفيف"],[470,"ما من مصيبة نكبة أمنى بها","https://www.aldiwan.net/poem4838.html","الكامل"],[479,"عتاب يا حطيئة أم هجاء","https://www.aldiwan.net/poem37174.html","الوافر"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"تدوس بساط الله والقلب فاقد","https://www.aldiwan.net/poem37566.html","الطويل"],[500,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[513,"وتزعم للواشين أني فاسد","https://www.aldiwan.net/poem67697.html","البسيط"],[514,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[515,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[515,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[515,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[529,"درر تلوح من السطور","https://www.aldiwan.net/poem37422.html","مجزوء الكامل"],[538,"ألشمس من ألم النوى مصفرة","https://www.aldiwan.net/poem47948.html","عموديه"],[538,"صدعت بحبه من بعد كتمي","https://www.aldiwan.net/poem48161.html","عموديه"],[538,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"],[540,"وبنات نعش يستدرن كأنها","https://www.aldiwan.net/poem56829.html","الكامل"],[540,"إن سليمى والله يكلؤها","https://www.aldiwan.net/poem56917.html","المنسرح"],[551,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[553,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[558,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[567,"الثلج يسقط أم لجين يسبك","https://www.aldiwan.net/poem69558.html","الكامل"],[575,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[587,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"]],"verses":[["وَتَزْعُمُ أَنَّ المَرْءَ في طَلَبِ العُلا","يَميلُ بِهاديه إِلى مَرْكَبٍ صَعْبِ",0,"ب",1,0],["وتَزْعُمُ أني رُضْتُ قَلبي لسَلْوَةٍ","إذاً لا أقالَ اللهُ عَثْرَةَ مَنْ سَلا",1,"ل",2,0],["وتَزْوَرُّ عنْ بَكْرٍ وللجارِ فيهِمُ","مُهينٌ ومُغْتابٌ وهاجٍ ونابِزُ",2,"ز",1,0],["وتُزْجي برَوْقَيْها أغَنَّ كأنّهُ","مِنَ الضّعْفِ يَطْوي الأرضَ بالرَّسَفانِ",3,"ن",1,0],["وتَزْعُمُ أن الهَجرَ لا يُعْقِبُ الرَّدى","وهَل حادِثٌ يخْشى إذا أُمِنَ الهَجْرُ",4,"ر",1,0],["وَتَزعُم أَنَّكَ مِن عِترَةِ ال","وَصِيِّ وَأَنتَ تُحِبُّ الجَمَل",5,"ل",1,0],["وَتَزَيَّدتَ مَعَ الأَيّامِ","عِزّاً وَعَلاءَ",6,"ا",2,0],["وَتَزدادُ في عَينِ الحَبيبِ مَلاحَةً","وَيَزدادُ تَبغيضاً إِلَيها بَغيضُها",7,"ض",3,0],["وَتَزخَرُ مِن وَرآءِ حِمايَ عَمرٌو","بِذي صُدَّينِ يَكتَفِئُ البِحارا",8,"ر",2,0],["وَتَزعُمُ أَنَّ البَينَ لا يَشعَفُ الفَتى","بَلى مِثلَ بَيني يَومَ لُبنانَ يَشعَفُ",9,"ف",1,0],["وَتَزورُ أَبوابَ المُلوكِ رِكابُنا","وَمَتى نُحَكَّم في البَرِيَّةِ نَعدِلِ",10,"ل",1,0],["وتزداد بالتَّرخيم حيناً خلاف ما","يقاس وترضي الوفد ورداً ومصدرا",11,"ر",2,0],["وتزوَّدت عند ذاك من الما","ء بحسب الإمكان والاستطاعه",12,"ع",2,0],["وتزايلَتْ أوصالُه عن رحْلِهِ","إذْ بتَّ حَبْلي من عُرا أسبابِكِ",13,"ك",1,0],["وتزودتَ من سليماك زاداً","فيه للطالبِ الشفاءَ غليلُ",14,"ل",1,0],["وَتَزيدُني وَلَعاً بِها وَهَوىً","وَتَزيدُني حِقداً عَلى هِنري",15,"ي",1,0],["وَتَزحَمُ الحَسناءَ مَمكورَةً","خَلّابَةً كَالرَوضَةِ الحالِيَه",16,"ه",1,0],["وتزجي لها طفلاً جميلاً أمامها","كما تستحث الخِشف ادماء مغزل",17,"ل",1,0],["وتزهو بزينتها كالعروس","وأنت الخطيب الحبيب الأغر",18,"ر",1,0],["وتزلق الأطفال وال","شيوخ عند المقدم",19,"م",1,0],["وَتَزَوَّجتَ فَقالوا مالَهُ","وَلِحورٍ مِن بَناتِ المَلكِ عين",20,"ن",1,0],["وَتَزعُمُ أَنَّ الَّذينَ اِبتَدَوا","عُلومَ النَصارى رَعاعٌ هَمَج",21,"ج",1,0],["وتزعُمُ أنَّكَ المشهورُ فَضْلاً","فَلْمْ تَخفَى وبَرقُ الحَيْنِ خافي",22,"ي",1,0],["وتَزعَمُ أنَّ الشِّعرَ عندكَ أعرَبتْ","محاسنُه عن ناطقٍ منك مُعرِبِ",23,"ب",1,0],["وَتَزرَعُ في القُلوبِ هَوىً وَوِدّا","وَتَكسوهُم إِذا حَضَروا جَمالا",24,"ل",2,0],["وَتَزَلزَلَ النادي وَأَوجَسَ خيفَةً","مِن هَولِ رُؤياهُ أَنو شِروانُ",25,"ن",1,0],["وَتَزُفُّ داري بِالشُموعِ جَماعَةٌ","غُلبٌ فَيُستَرُ عَن عُلاكَ وَيُكتَمُ",26,"م",1,0],["وَتَزعُمُ أَنَّ الشِعرَ أَحنى فَضائِلي","وَتُنكِرُ أَفعالي وَقَد عَلِمَت أَنّي",27,"ي",1,0],["وَتَزَاوَرَ الأحبابُ بعد قطيعةٍ","دخلتْ بذكر الودّ في النّسيانِ",28,"ن",1,0],["وتَزْحَمُني كُلّ فتّانةٍ","بتفّاحةٍ غَلّفَتْها بِطِيبِ",29,"ب",1,0],["وَتَزَهَّدوا حَتّى أَصابوا فُرصَةً","في أَخذِ مالِ مَساجِدٍ وَكَنائِسِ",30,"س",1,0],["وَتَزعُمُ لَيلى أَنَّني لا أُحِبُّها","بَلى وَاللَيالي العَشرِ وَالشَفعِ وَالوَترِ",31,"ر",1,0],["وَتَزعُمُ أَنَّهُم أَشرافُ بَكرٍ","وَمَن جَعَلَ القَوادِمَ كَالخَوافي",32,"ي",1,0],["وتَزَوَّدِ التَّقْوَى فإن لم تستطعْ","فمِنَ الصلاة على النبيِّ تَزَوَّدِ",33,"د",1,0],["وَتَزولُ العُيونُ عَنّي إِذا حُمَّ","بِعَينِ الحَياةِ ثُمَّ اِنغِماسي",34,"ي",1,0],["وَتَزعَمُ أَنَّكَ فيما فَعَلتَ","عَلى أَثَرٍ مِن رَشيدٍ تَقَصّ",35,"ص",1,0],["وتزحف الظلماء زحف المُغير","حاجبة ما دونها كالسِّتار",36,"ر",1,0],["وتزحفُ رافعةً وجَهها","ضراعةَ مستغفرٍ في ابتهالْ",37,"ل",1,0],["وتزلف الدنيا لها وتجبى","وينثني بها الزمان عُجْبا",38,"ب",2,0],["وتزور البروق تخبرني عنك","ولولاك ما استزرت البروقا",39,"ق",2,0],["وتزوره حيناً، فتؤنسه","بعض الطيور بصوتها الغرد",40,"د",1,0],["وتزينت بحلىَ الكواكبِ مثلَمَا","تَتَزيّنُ الحسناءُ في أفراحها",41,"ح",3,0],["وتزحف رافعة وجهها","ضراعة مستغقر في ابتهال",42,"ل",1,0],["وتَزْعُمُ أنَّك تأتي الصَّباحَ","وقد كذَّبَ القبرُ ما تَزْعُم",43,"م",1,0],["وتزاحمتْ بالهاتفينَ شِعابُها","يُزجُونكَ التكبيرَ والتهليلا",44,"ل",2,0],["وتزعنَ من داودَ أحسنَ صُنعِهِ","ولقَد يَكونُ بِقُوَّة ٍ وَنَعيمِ",45,"م",1,0],["وتزورني الايام وهي كأنها","والهف قلبي كلها اضغاث",46,"ث",1,0],["وتزفر أحياناً وترقد مثلها","كذاك لشعري سورة وتألف",47,"ف",1,0],["وتزيلُ عن أحشائنا وَصَبَ القَذَى","وتُشَرِّدُ الأحزان والأتراحا",48,"ح",2,0],["وتزدادُ تجديداً على الدهر كلَّما","يمرُّ على الدنيا مساءٌ ومُصبَحُ",49,"ح",1,0],["وَتَزعُمُ أَنَّني شَيخٌ كَبيرٌ","وَهَل أَخبَرتُها أَنّي اِبنُ أَمسِ",50,"س",1,0],["وَتزِلُّ مِن أعلَى شَمَارِيخِ الذُّرَى","نَغَمَاتُهُنَّ الأدفيب الصُّلُودَ العَاقِلا",51,"ل",2,0],["وتَزعُمُ أَنَّ شِعرَكَ مثل شِعرى","فَقُل هَيهَاتَ هَيهَاتَ العَقِيقُ",52,"ق",1,0],["وتَزعُمُ أنَّ اللهَ يَاخُذُ جاهِلاً","وَلِيّاً فَيُبقِى دِينَهُ هَمَلاً سُدَى",53,"د",2,0],["وتزاحموا ليروك لولا انهم","مستبشرين إذا لقلِنا المحشرا",54,"ر",2,0],["وَتَزَعزَعَت رَهباً فَجاءَت تَبتَغي","مِنهُ الذِمامَ الشُمُّ مِن عَدوانِ",55,"ن",1,0],["وتزوّدي يا نفس من طربٍ","وتمتعي بفكاهة السكر",56,"ر",1,0],["وَتَزعمُ اللَّه بالذاتِ اِستقرّ على","عَرشٍ فتُلحق أوصافَ الحدوث بهِ",57,"ب",2,0],["وتزكو الأيادي عند ذي الشكر مثل ما","تَضاعف في الأرض الزكيَّة بذرُها",58,"ر",3,0],["وتزاحمت جلّ الخلائق عنده","فسقاهمو من فيضه المدرار",59,"ر",1,0],["وتزعمون أنكم في جامعه","ممنوعةٍ من الفساد مانعه",60,"ه",1,0],["وتزهو بنحرٍ كالسَجنْجَلِ نَيِّرٍ","تُنَاط عقودٌ فَوْقَه وقلائدُ",61,"د",1,0],["وتزوَّد من الحياة وخير ال","زاد في شدة المعاد التقاء",62,"ا",2,0],["وتزوّد من الرجاء إذا ما","كنت ذا فاقة وعزَّ الغناء",62,"ا",2,0],["وَتَزورُهُ عِند المَسا","وَالفَجرِ أَسرابُ الطُيور",63,"ر",1,0],["وَتَزجُّ الوجودَ في ظُلُماتٍ","مُستَبَدٌّ في بُردِها الديجورُ",64,"ر",1,0],["وَتَزيدُ في فَمِها اللآلىءُ قيمةً","حتّى يسودُ كبيرَهُنَّ الأَصغَرُ",65,"ر",1,0],["وَتَزَخْرَفَتْ أَنْوَارُهَا بِبَطَائِحٍ","جَلَّتْ مَحَاسِنُهَا عَنِ التَّعْبِيرِ",66,"ر",1,0],["وتزهو إذا غنّى المغنّون باسمها","ولا نرعوي عنها ولو ضمَّنا اللحد",67,"د",1,0],["وتزداد منك العالمون اولو النهى","علوم حكيم بالأمور بصير",68,"ر",1,0],["وتزفرُ للأطيابِ نفّاثةً كما","سَمعتِ لأنفاسِ المشوقِ تقطعا",69,"ع",2,0],["وَتَزورُ أَرضَهُمُ بِذي لَجَبٍ","قَصدَ العَشِيِّ غُبوقُهُ المَرَقُ",70,"ق",1,0],["وتزيدُني ظمأً مَواردُ حُبِّها","وَلَقَد وردتُ من الغَرام مَشارِبا",71,"ب",2,0],["وَتزاوَرتْ شمسُ النهار عن الحمى","فكأنها في الظهرِ ذات دلوكِ",72,"ك",1,0],["وتزيح الكروب عني وتدني","مأرجي من صالح الأعمال",73,"ل",1,0],["وَتزفُّ في طرسٍ إليّ فَأَجتَني","قَطفَ المُنى مِن روضِها المعروشِ",74,"ش",1,0],["وَتَزينُ الوَجهَ مِنها غُرَّةٌ","تَبرُقُ الأَبصارُ مِنها لَم تُعَش",75,"ش",1,0],["وَتَزدادُ شَرّاً أَن نَرومَ صَغيرَها","فَكَيفَ عَظيمُ الأَمرِ فيها يُوَفَّقُ",76,"ق",1,0],["وتزلف او ما رأيت سراتنا","هاماتهم تمشي على الاعتاب",77,"ب",1,0],["وتزدهيني لبانات فتصرعها","روحي فتردى لباناتي وآمالي",78,"ي",1,0],["وَتُزدَري بَغُصون البان قامَته","ناديت مذ جرحت أَحشاي مقلتَه",79,"ه",1,0],["وتزْخَرُ للعافِينَ أنمُلُ كَفِّه","بأبحُرِ مالٍ لا بأبحرِ ماء",80,"ا",2,0],["وَتُزجي الكُماةُ الكُمتَ طالِبَةَ العِدى","فَيا لَصَقورٍ فَوقَهُنَّ ضَراغِمُ",81,"م",1,0],["وتزعُمُ أن الحق عندك مُلغَزٌ","بحرفٍ طواه السر في ذلك الحرف",82,"ف",1,0],["وتزاحَمَ الوُرّادُ فيكِ لِيَملأوا","من فَيضِ جودٍ حُفَّ باللألاءِ",83,"ا",2,0],["وَتَزيد لِلرائي مَعاني حُسنِهِ","وَجَمالِهِ مَع أَنَّها مُتَناهِيَه",84,"ي",2,0],["وَتَزَوَّجَ الزَهراءَ وَهيَ فَضيلَةٌ","غَرّاءُ لَيسَ تَبيدُها الآبادُ",85,"د",1,0],["وتزهو بها الشهبا على كل بلدة","ويظهر منه نورها وسناها",86,"ا",3,0],["وتزيدُها الشّكوى إليها قَسوةً","وَلَقَلّمَا يُشكِي الظّلومُ القَادِرُ",87,"ر",1,0],["وتزجرها زجر لا راحمٍ","وإنَّكَ بالغْتَ في زجرها",88,"ر",3,0],["وتزهو بأمداح النّقيب قصائدي","بأحْسَنَ ما تزهو بأزهارها الرّبا",89,"ب",2,0],["وتزينت بخلاع عزّك رتبة","أنت الهناءُ لهُ وأنت مناءُ",90,"ا",2,0],["وتزين في أبهى خلق","ثغر الأزهار له افترا",91,"ر",2,0],["وتزاحمت فرق السحاب وقد بدا","للرعد في وسط الغيوم صهيل",92,"ل",1,0],["وتزهو بألوان عجيب وقوعها","ويزهو نداها من ندى فيض نيله",93,"ل",2,0],["وتُزْهى بِهَا من صِنْوِ دِجْلَةَ لُجَّةٌ","تَحَلَّلَ منها الرَّوْضُ جارٍ وجَائرُ",94,"ر",1,0],["وتُزْهى بِسحرٍ من أَحاديثَ بيننا","كَأَنَّ أَسيرَيْ بابلٍ نَفَثَاهَا",95,"ا",3,0],["وتزهق نفس الخاسرين بزحفها","تصول بضرب المؤمنين المحفزِ",96,"ز",1,0],["وَتزودى من كلِّ مرأىً باسمٍ","بِمنىَ الإخاءِ ونعمةِ التوحيدِ",97,"د",1,0],["وتزوَّدْ منها على صحب