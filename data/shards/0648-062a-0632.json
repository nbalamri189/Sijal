{"poems":[[63,"وعاذلة هبت وللنجم لفتة","https://www.aldiwan.net/poem46117.html","الطويل"],[63,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[63,"أثرها فما دون الصرائم حاجز","https://www.aldiwan.net/poem46169.html","الطويل"],[63,"سرى طيفها والملتقى متدان","https://www.aldiwan.net/poem46182.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[71,"فديتك قل للشريف الشهاب","https://www.aldiwan.net/poem3918.html","المتقارب"],[73,"سرك الدهر وساء","https://www.aldiwan.net/poem11921.html","مجزوء الرمل"],[30,"بكيت وما يبكيك من رسم منزل","https://www.aldiwan.net/poem29575.html","الطويل"],[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[27,"ألا أيها القلب الطروب المكلف","https://www.aldiwan.net/poem5922.html","الطويل"],[23,"أسألت رسم الدار أم لم تسأل","https://www.aldiwan.net/poem21245.html","الكامل"],[72,"على حركات اليمن والأمن والهنا","https://www.aldiwan.net/poem18726.html","الطويل"],[51,"ادعني يا أخا العلا وادع عواسا","https://www.aldiwan.net/poem65428.html","الخفيف"],[51,"ردي التحية من وراء حجابك","https://www.aldiwan.net/poem65815.html","الكامل"],[51,"خانك الصبر يوم قيل الرحيل","https://www.aldiwan.net/poem65991.html","الخفيف"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[85,"تحية عمرو لك بل عمر","https://www.aldiwan.net/poem7129.html","المتقارب"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[61,"تلاف السهم أثبت في الشغاف","https://www.aldiwan.net/poem51548.html","الوافر"],[61,"أجزار باب الشام كيف وجدتني","https://www.aldiwan.net/poem51791.html","الطويل"],[49,"هدايا الناس بعضهم لبعض","https://www.aldiwan.net/poem64282.html","الوافر"],[66,"خمدت لفضل ولادك النيران","https://www.aldiwan.net/poem41545.html","الكامل"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[66,"سلوا بعد تسآل الورى عنكم عني","https://www.aldiwan.net/poem41581.html","الطويل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"طربت متى كنت غير الطروب","https://www.aldiwan.net/poem31567.html","المتقارب"],[74,"درسوا العلوم ليملكوا بجدالهم","https://www.aldiwan.net/poem12974.html","الكامل"],[33,"وداع دعا إذ نحن بالخيف من منى","https://www.aldiwan.net/poem25907.html","الطويل"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[46,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[46,"يكاد المشيب ينادي الغوي","https://www.aldiwan.net/poem22885.html","المتقارب"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39608","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[96,"راقصة الحانة","https://www.poetsgate.com/ViewPoem.aspx?id=17511",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[4,"سَفَهاً عَذَلْتِ وقلتِ غَيْرَ مُليمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10949&r=&rc=44",""]],"verses":[["وَتَزْعُمُ أَنَّ المَرْءَ في طَلَبِ العُلا","يَميلُ بِهاديه إِلى مَرْكَبٍ صَعْبِ",0,"ب",1,0],["وتَزْعُمُ أني رُضْتُ قَلبي لسَلْوَةٍ","إذاً لا أقالَ اللهُ عَثْرَةَ مَنْ سَلا",1,"ل",2,0],["وتَزْوَرُّ عنْ بَكْرٍ وللجارِ فيهِمُ","مُهينٌ ومُغْتابٌ وهاجٍ ونابِزُ",2,"ز",1,0],["وتُزْجي برَوْقَيْها أغَنَّ كأنّهُ","مِنَ الضّعْفِ يَطْوي الأرضَ بالرَّسَفانِ",3,"ن",1,0],["وتَزْعُمُ أن الهَجرَ لا يُعْقِبُ الرَّدى","وهَل حادِثٌ يخْشى إذا أُمِنَ الهَجْرُ",4,"ر",1,0],["وَتَزعُم أَنَّكَ مِن عِترَةِ ال","وَصِيِّ وَأَنتَ تُحِبُّ الجَمَل",5,"ل",1,0],["وَتَزَيَّدتَ مَعَ الأَيّامِ","عِزّاً وَعَلاءَ",6,"ا",2,0],["وَتَزدادُ في عَينِ الحَبيبِ مَلاحَةً","وَيَزدادُ تَبغيضاً إِلَيها بَغيضُها",7,"ض",3,0],["وَتَزخَرُ مِن وَرآءِ حِمايَ عَمرٌو","بِذي صُدَّينِ يَكتَفِئُ البِحارا",8,"ر",2,0],["وَتَزعُمُ أَنَّ البَينَ لا يَشعَفُ الفَتى","بَلى مِثلَ بَيني يَومَ لُبنانَ يَشعَفُ",9,"ف",1,0],["وَتَزورُ أَبوابَ المُلوكِ رِكابُنا","وَمَتى نُحَكَّم في البَرِيَّةِ نَعدِلِ",10,"ل",1,0],["وتزداد بالتَّرخيم حيناً خلاف ما","يقاس وترضي الوفد ورداً ومصدرا",11,"ر",2,0],["وتزوَّدت عند ذاك من الما","ء بحسب الإمكان والاستطاعه",12,"ع",2,0],["وتزايلَتْ أوصالُه عن رحْلِهِ","إذْ بتَّ حَبْلي من عُرا أسبابِكِ",13,"ك",1,0],["وتزودتَ من سليماك زاداً","فيه للطالبِ الشفاءَ غليلُ",14,"ل",1,0],["وَتَزيدُني وَلَعاً بِها وَهَوىً","وَتَزيدُني حِقداً عَلى هِنري",15,"ي",1,0],["وَتَزحَمُ الحَسناءَ مَمكورَةً","خَلّابَةً كَالرَوضَةِ الحالِيَه",16,"ه",1,0],["وتزجي لها طفلاً جميلاً أمامها","كما تستحث الخِشف ادماء مغزل",17,"ل",1,0],["وتزهو بزينتها كالعروس","وأنت الخطيب الحبيب الأغر",18,"ر",1,0],["وتزلق الأطفال وال","شيوخ عند المقدم",19,"م",1,0],["وَتَزَوَّجتَ فَقالوا مالَهُ","وَلِحورٍ مِن بَناتِ المَلكِ عين",20,"ن",1,0],["وَتَزعُمُ أَنَّ الَّذينَ اِبتَدَوا","عُلومَ النَصارى رَعاعٌ هَمَج",21,"ج",1,0],["وتزعُمُ أنَّكَ المشهورُ فَضْلاً","فَلْمْ تَخفَى وبَرقُ الحَيْنِ خافي",22,"ي",1,0],["وتَزعَمُ أنَّ الشِّعرَ عندكَ أعرَبتْ","محاسنُه عن ناطقٍ منك مُعرِبِ",23,"ب",1,0],["وَتَزرَعُ في القُلوبِ هَوىً وَوِدّا","وَتَكسوهُم إِذا حَضَروا جَمالا",24,"ل",2,0],["وَتَزَلزَلَ النادي وَأَوجَسَ خيفَةً","مِن هَولِ رُؤياهُ أَنو شِروانُ",25,"ن",1,0],["وَتَزُفُّ داري بِالشُموعِ جَماعَةٌ","غُلبٌ فَيُستَرُ عَن عُلاكَ وَيُكتَمُ",26,"م",1,0],["وَتَزعُمُ أَنَّ الشِعرَ أَحنى فَضائِلي","وَتُنكِرُ أَفعالي وَقَد عَلِمَت أَنّي",27,"ي",1,0],["وَتَزَاوَرَ الأحبابُ بعد قطيعةٍ","دخلتْ بذكر الودّ في النّسيانِ",28,"ن",1,0],["وتَزْحَمُني كُلّ فتّانةٍ","بتفّاحةٍ غَلّفَتْها بِطِيبِ",29,"ب",1,0],["وَتَزَهَّدوا حَتّى أَصابوا فُرصَةً","في أَخذِ مالِ مَساجِدٍ وَكَنائِسِ",30,"س",1,0],["وَتَزعُمُ لَيلى أَنَّني لا أُحِبُّها","بَلى وَاللَيالي العَشرِ وَالشَفعِ وَالوَترِ",31,"ر",1,0],["وَتَزعُمُ أَنَّهُم أَشرافُ بَكرٍ","وَمَن جَعَلَ القَوادِمَ كَالخَوافي",32,"ي",1,0],["وتَزَوَّدِ التَّقْوَى فإن لم تستطعْ","فمِنَ الصلاة على النبيِّ تَزَوَّدِ",33,"د",1,0],["وَتَزولُ العُيونُ عَنّي إِذا حُمَّ","بِعَينِ الحَياةِ ثُمَّ اِنغِماسي",34,"ي",1,0],["وَتَزعَمُ أَنَّكَ فيما فَعَلتَ","عَلى أَثَرٍ مِن رَشيدٍ تَقَصّ",35,"ص",1,0],["وتزحف الظلماء زحف المُغير","حاجبة ما دونها كالسِّتار",36,"ر",1,0],["وتزحفُ رافعةً وجَهها","ضراعةَ مستغفرٍ في ابتهالْ",37,"ل",1,0],["وتزلف الدنيا لها وتجبى","وينثني بها الزمان عُجْبا",38,"ب",2,0],["وتزوره حيناً، فتؤنسه","بعض الطيور بصوتها الغرد",39,"د",1,0],["وتزينت بحلىَ الكواكبِ مثلَمَا","تَتَزيّنُ الحسناءُ في أفراحها",40,"ح",3,0],["وتزحف رافعة وجهها","ضراعة مستغقر في ابتهال",41,"ل",1,0],["وتَزْعُمُ أنَّك تأتي الصَّباحَ","وقد كذَّبَ القبرُ ما تَزْعُم",42,"م",1,0],["وتزاحمتْ بالهاتفينَ شِعابُها","يُزجُونكَ التكبيرَ والتهليلا",43,"ل",2,0],["وتزعنَ من داودَ أحسنَ صُنعِهِ","ولقَد يَكونُ بِقُوَّة ٍ وَنَعيمِ",44,"م",1,0]]}