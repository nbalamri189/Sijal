{"poems":[[55,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[65,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[79,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[11,"ألا أرقت عيني فبت أديره","https://www.aldiwan.net/poem255.html",""],[74,"كنت في ظلمة من الحال لكن","https://www.aldiwan.net/poem18440.html","الخفيف"],[74,"أمولانا فلان الدين رفقا","https://www.aldiwan.net/poem19534.html","الوافر"],[31,"رأيت قريشا حين ميز بينها","https://www.aldiwan.net/poem6025.html","الطويل"],[40,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[91,"تقدم أهله الطاوين يمشي","https://www.aldiwan.net/poem44641.html","الوافر"],[30,"إني ابنُ حمال المئين غالب","https://www.aldiwan.net/poem1242.html",""],[82,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[76,"وغمامة لم يستقل بها السرى","https://www.aldiwan.net/poem12898.html","الكامل"],[76,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[54,"يا جافيا مستعجلا بالقلى","https://www.aldiwan.net/poem26579.html","السريع"],[77,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[50,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[102,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[102,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=50149",""],[11,"ألا أرِقَتْ عَيني، فبِتُّ أُديرُها","https://www.poetsgate.com/ViewPoem.aspx?id=16858",""],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[142,"ربما ضربة بسيف صقيل","https://www.aldiwan.net/poem31.html","الخفيف"],[146,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[147,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[147,"ما ضر طيفك والكرى لو زارا","https://www.aldiwan.net/poem11768.html","الكامل"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[228,"خلعت عن الروح ثوب المدر","https://www.aldiwan.net/poem39688.html","المتقارب"],[240,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[276,"صدوا عن الصب الكئيب واعرضوا","https://www.aldiwan.net/poem52111.html","الكامل"],[303,"وجمرة حب بت أصلى سعيرها","https://www.aldiwan.net/poem36318.html","عموديه"],[333,"أفي القمة السكرى بخمر الأداهر","https://www.aldiwan.net/poem55056.html","الطويل"],[342,"لمن طلل عاف ورسم منازل","https://www.aldiwan.net/poem45427.html","الطويل"],[369,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[438,"هو ملتقى أرج النواسم فانظرا","https://www.aldiwan.net/poem12311.html","الكامل"],[438,"نضا عضبا من الجفن","https://www.aldiwan.net/poem12740.html","الهزج"],[445,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[447,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[482,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[556,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77604","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77553","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70818","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62454","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119932","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96642","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96751","الرمل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35356","الكامل"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74106","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136259","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49977","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50019","الكامل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124028","البسيط"],[1566,"","https://poetry.dctabudhabi.ae/diwan/poem/31436","الوافر"],[1873,"","https://poetry.dctabudhabi.ae/diwan/poem/73010","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53066","الوافر"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33867","البسيط"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119187","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93703","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93620","الكامل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105384","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130766","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65977","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58297","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109791","الخفيف"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117036","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62928","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62922","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45862","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132144","الخفيف"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99235","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86537","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35548","الهزج"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125832","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45040","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81713","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139587",""],[4759,"البعد المتاح","https://www.poetsgate.com/ViewPoem.aspx?id=204929",""],[4782,"رِحَال الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202629",""],[4858,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=30460",""],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5121,"عُصْفُورُ الْجَنَّة","https://www.poetsgate.com/ViewPoem.aspx?id=49543",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5431,"وأفضل الفعل حب الله والناس","https://www.poetsgate.com/ViewPoem.aspx?id=194507",""],[5574,"غمامة أغدقت فوق الربى","https://www.poetsgate.com/ViewPoem.aspx?id=205991",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[5815,"رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=190221",""],[6093,"واحد طش*","https://www.poetsgate.com/ViewPoem.aspx?id=205484",""],[6159,"شكراً جزيلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85857&r=&rc=3",""],[6229,"تفاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82506&r=&rc=41",""],[6251,"الرِّسَالَة ُالخَامِسَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76491&r=&rc=31",""]],"verses":[["وَغَمَطتُمُ تِلكَ السُعو","دَ فَأُبدِلَت بِكُمُ نُحوسا",0,"س",2,0],["وغَمَرْتَ بالكَرَمِ المُلوكَ فكُلُّهُمْ","لمّا شَرَعْتَ لهُ الندىً يتكرَّمُ",1,"م",1,0],["وَغَمَّدَكَ الرَّحْمَنُ مِنْهُ بِرَحْمَةٍ","تُبَلِّغُكَ الزُّلْفَى وَأَقْصَى الْمَآرِبِ",2,"ب",1,0],["وَغَمرَةِ مَوتٍ لَيسَ فيها هَوادَةٌ","يَكونُ صُدورَ المَشرَفِيِّ جُسورُها",3,"ر",3,0],["وغمامين ينشآن نباتاً","يثمر الأجر من جميعِ الجهات",4,"ت",1,0],["وغمِّض إن أساء الخلُّ عيناً","تُفد سنن الطريق ولا تبالي",5,"ل",2,0],["وَغَمرَةَ مَوتٍ لَم تَكُن لِتَخوضَها","وَلَيسَ اِختِلاسي وَسطَهُم بِيَسيرِ",6,"ر",1,0],["وَغَملى نَصِيٍّ بِالمِتانِ كَأَنَّها","ثَعالِبُ مَوتى جِلدُها قَد تَزَلَّعا",7,"ع",2,0],["وغمغم قائلا إنا جياع","فقال يرده جوعوا لنشبع",8,"ع",1,0],["وَغَمرَةَ الدَهنا بِغَيرِ صاحِبِ","وَالمُغرِزِ الرَفدَ بِكَفِّ الجالِبِ",9,"ب",1,0],["وغمرْتَ بالطَّوْلِ الزّمانَ فقلْ لَنا","أهُوَ الهواءُ يعمّ كلّ مكانِ",10,"ن",1,0],["وَغَمامَةٍ لَم يَستَقِلَّ بِها السُرى","فَمَشَت عَلى الظَلماءِ مَشيَّ مُقَيَّدِ",11,"د",1,1],["وَغَمامَةٍ نَشَرَت جَناحَ حَمامَةٍ","وَالبَرقُ قَد نَسَجَ الظَلامَ نَهارا",12,"ر",2,0],["وَغَمامٌ دونَ رَيِّقِهِ","بَرقُ بِشرٍ غَيرُ مُتَّهَمِ",13,"م",1,0],["وَغَمزَةٍ مِن كَفِّهِ كُلَّما","صافَحتُهُ نافِعَةً شافِيَه",14,"ي",2,0],["وغَمَامٍ مِنْ ظِلِّ ألْوِيَةِ النّصْ","رِ فمن راجفٍ ومن خَفّاق",15,"ق",1,0],["وَغُمَّرنَ مِن ماءِ النُقَيبِ بِشَربَةٍ","وَقَد حانَ مِن ديكِ الصَباحِ زَميرُ",16,"ر",1,0],["وغمغمتْ نجمةٌ رؤومُ","أما يرى ضوءَه القمرْ",17,"ر",1,0],["وغَمامٍ باكَرَتْنا عَيْنُهُ","تُتْرِعُ الأُفْقَ بدَمْعٍ صَيِّبِ",18,"ب",1,0],["وغمغم الشارع المهجور : من خطرت","كما تخطر تلّ مائج ترف",19,"ف",1,0],["وغمست قلبك في الحياة وصغتها","لحنا صداه وصوته الإلهام",20,"م",1,0],["وغمرة ٍ وموت ليس فيها هوادة ،","يكون صدور المشرفي جسورها",21,"ر",3,0],["وغمّس في العطر الإلهيّ جانحا","وزفّ من النّور الإلهيّ موكبا",22,"ب",2,0],["وغَمُوسٍ تَضِلُّ فيها يَدُ الآ","سِى ويَعيَى طبِيبُها بالدَواءِ",23,"ا",2,0],["وغَموضَ الحدين من جوهر ال","موت مُوَلًّى على النفوس لغصبِ",24,"ب",1,0],["وَغَمَرتَهُم صَفحاً يُقَرِّبُ مِنهُمُ","مَن مالَهُ عَمَلٌ إِلَيكَ يُقَرِّبُ",25,"ب",1,0],["وَغَمامَةً سَحَّت هُناكَ صَواعِقاً","حَتّى إِذا وَصَلوكَ سَحَّت عَسجَدا",26,"د",2,0],["وَغَمَرتَني بِمَواهِبٍ مَوصولَةٍ","لَم تُبقِ لي عِندَ الحَوادِثِ ثارا",27,"ر",2,0],["وَغَمامَةٌ لَم تَحوِ غَيثاً يُرتَجى","وَتُظِلُّ غَيثَ غَمامَةٍ لا تُقلِعُ",28,"ع",1,0],["وَغَمَرتَ المُسيءَ جوداً فَقُلنا","مُستَقيلاً أَتاهُ أَو مُستَنيلا",29,"ل",2,0],["وَغَمَّستَ ريشَةَ وَحيِكَ في","شَفَتَيها وَلَوَّنتَ تِلكَ الصُوَر",30,"ر",1,0],["وَغِمارُ الفَلا كَأَنَّ مَطايا","هُ إِذا عُمنَ في الفَلاةِ سَفينُ",31,"ن",1,0],["وَغَمائم تكسوا الرباض مطارقا","يفترّ عَنها مذهب وَمفضض",32,"ض",1,0],["وغماءُ مِنْ وجدٍ قديمٍ كشفتها","بصبرِ بصيرٍ بالعواقب حازم",33,"م",1,0],["وغمغمت الأشباح تتلو على الدنى","حديث الليالي والقرون الغوابر",34,"ر",1,0],["وَغَمرَةِ مَوتٍ خُضتُ حَتّى قَطَعتُها","وَقَد أَفظَعَ الجِبسَ الهِدانَ خِياضُها",35,"ض",3,0],["وغَماماً يَسيلُ بالدَّمِ وادي","هِ إذا ما عَلاهُ بَرْقُ الدِّلاص",36,"ص",1,0],["وَغَمَسْتُ ثَوْبَ الرِّيحِ في كاسَاتِها","حتَّى سَرَى أَرَجُ الشَّمائِل أَعْطَرا",37,"ر",2,0],["وغمٍّ مُفزِعٍ للرأ","سِ والراحةِ والبِطْنِ",38,"ن",1,0],["وغمامُ عُرْفٍ فِي الزمانِ المُمْحِلِ","وسراجُ نورٍ فِي الكريهَةِ مُشْعَلِ",39,"ل",1,0],["وغمرةُ شكٍّ أتاها اليقِينُ","بأَنَّ رضيعَ الأَمانِي فطيمُ",40,"م",1,0],["وغمامةٍ قد ظللته بعد ما","رقص السراب على مطار بواته",41,"ت",2,0],["وغمامةُ الحربِ العَوانِ ملثةٌ","بسوى النصالِ كماتُها لا تُمطّرُ",42,"ر",1,0],["وغمامٌ موكّلُ الجَفْنِ بالقَطْ","رِ ووُرْقٌ من الحمامِ ينوحُ",43,"ح",1,0],["وَغَمَروا الأُستاذ بِالفُلوسِ","وَأَحضَروا لَوازمَ التَدريس",44,"س",1,0],["وَغَمَرَ الأَرض بِنَشرِ الماءِ","قَصداً بِنَزع ذَلِكَ الكِساء",45,"ا",2,0],["وغُمةٍ وأسىً في قلبها وجوىً","بها وقلبٍ بنار الحزنِ مسفوعِ",46,"ع",1,0],["وغمامة برقت بهَامة شاهق","تركت جوانبه تسيل وتلتعجْ",47,"ج",1,0],["وغمرتهم بأنامل","معروفة بالعرف ثرة",48,"ر",2,0],["وَغمامُ الجوِّ قَد ظلّله","وَوقاهُ من حراراتِ الرَمَد",49,"د",1,0],["وَغمام ما عدِمنا","من عزاليهِ اِنهطالا",50,"ل",2,0],["وَغَمائِمٌ نَشَأَت حَوامِلَ بِالنَدى","وَالنَدِّ فَهيَ طَوافِحٌ وَنَوافِحُ",51,"ح",1,0],["وَغمامٍ هَطِلٍ شؤبوبه","نادمَ الروضَ فَغَنّى وَسَقى",52,"ق",2,0],["وغمض ولا يصحبك فكر به ترى","عجايب تطوير الحقيقة من افق",53,"ق",1,0],["وغمامةً تُحيي بعاجل نَفْعها","وكأنّها تهمي النباتَ المُثمِرا",54,"ا",1,0],["وغمامتان من الربيع كِلاهما","يتباريان بديمة أو وابلِ",55,"ل",1,0],["وغمامةٌ وقت الهجير تظله","ان كاد يحرق وجه كل مهجر",56,"ر",1,0],["وَغُمدانَ الَّذي خُبِّرتِ عَنهُ","بَناهُ مُشَيَّداً في رَأسِ نيقِ",57,"ق",1,0],["وَغَمِّض عَينَكَ النَجلا","ءَ حَتّى تُنعَتَ الحَوَصا",58,"ص",2,0],["وغميته فيها بعيرٌ وبعضهم","رآها بثلث الأرشِ بالنفسِ تعدلُ",59,"ل",1,0],["وغمد الدَّجْنِ ينضو سيف برق","به الأنواء مثخنة الجراح",60,"ح",1,0],["وَغَمرَةٍ ذاتِ أَهوالٍ تَقَحَّمَها","لَم يَثنِهِ خَوَرٌ عَنها وَلا وَجَلُ",61,"ل",1,0],["وغمرة خضت أعلاها وأسفلها","بالضرب والطعن بين البيض والأسل",62,"ل",1,0],["وَغَمَّضتِ المَنيةُ مِنكَ عَيناً","غَضيض الطَرف ما نَظرت حَراما",63,"م",2,0],["وَغَمزتها غَمز الكَمي قَناته","حَتّى اِستَقَمنَ كُعوبَها وَصُدورَها",64,"ر",3,0],["وغماماً سحت غوادي أياديه","فأزرت بواكف الغيب سكبا",65,"ب",2,0],["وغمرٌ لعمظٌ كفلٌ عبامٌ","ومأفقون بغطريس هوان",66,"ن",1,0],["وغمغمة الأبطال والحرب كاشر","بشدق عبوس أعصل الناب هائل",67,"ل",1,0],["وغمارة جبل وفاس مثله","والتلمسان نظيره في وجدة",68,"ه",1,0],["وَغَمِّرتْ منْكَ بالعَدل العميم إلى","أنْ طابَ حاضرُها سكني وباديها",69,"ي",3,0],["وغمام بكى دموعاً فاضحت","في كؤوس الازهار ثغراً رتيلا",70,"ل",2,0],["وغمرته بالفضل حتى نال ما","يرجوه منك وفوق ما يتوهم",71,"م",1,0],["وغُمدانُ والصَّرحُ من تَدَمُرٍ","بديعانِ ما لهما ثَالِثُ",72,"ث",1,0],["وغَمامةٍ قَسَمَتْ زما","نكَ بين طَلٍّ أَو وكِيفِ",73,"ف",1,0],["وَغَمرتنا بِمكارم ضمنت لَنا","رَد الحَياة عَلى ذَوي الاعدام",74,"م",1,0],["وغمام السماء يبكي ولكن","تضحك الروض كلها من بكائه",75,"ا",3,0],["وغِمْدِ زُجاجٍ من بَنَاني نجادُهُ","لسيفِ مدامٍ لا يَمَانٍ ولا هِنْدِي",76,"د",2,0],["وغمرته بأشعة فتانة","تاللَه قد أعلقته بحبالك",77,"ك",1,0],["وغمرة الموت ترى أهون من","مجلس من ليس هواه قد زكن",78,"ن",1,0],["وغُمّ في مطلعه الهلالُ","ورُكِضت حِجرك يا بلال",79,"ل",1,0],["وَغَمز اللَّحظِ بِاللَّحظِ","وَقَرع الثَّغرِ بِالثَّغرِ",80,"ر",1,0],["وغِمداً وزَاهي نِجادٍ وَنالا","حِزاماً بِفرفيرِهِ قَد تَلالا",81,"ل",2,0],["وغمام التبر بالنور سطع","وحباب القطر من أكنافه",82,"ه",1,0],["وغمامة ذَريَّة","قلبتْ من الأَرضِ الأَديما",83,"م",2,0],["وَغَمَرتَهُم بالجودِ قَبلَ سُؤَالهِم","لِلَّهِ دَرَّكَ كَيفَ لَو قالوا اِعطنا",84,"ن",2,0],["وغمامِ نقعٍ بالغماغم مُرْعدٍ","زجلٍ وبالبيض اللَّموامع مبرق",85,"ق",1,0],["وغمار لهم من الجود في سِت","تِ جهاتِ الوجود تطفح طفحا",86,"ح",2,0],["وغم على مطالعه الترائي","لنكمل ما تدور به القداح",87,"ح",1,0],["وغمامُ الوصل خاوٍ ليس يروي","ضامئَ القلب وأهداب خياله",88,"ل",2,0],["وغمكِ إن ألمّ بي أكتئابٌ","فيبدُو الخصبُ يا أماهُ جدْبا",89,"ب",2,0],["وغمامُ الحياةِ أعشى سواديّ","م ونور المنى بقلبي ، ترحّلْ",90,"ل",1,0],["وَغُمُوضٌ طَيَّ الْجَمَال يُصَلِّي","يَمْلأُ الْوِجْدَانَ الْخُشُوعَ دِثَارَا",91,"ر",2,0],["وغمارُ نقعٍ لم نخضْ في يومِنا","نخشى المنيةَ والحياة ُغمارُ",92,"ر",1,0],["وغمضت عيناً في الوجود بصيرة","على الغيب نور الله فيها تطلعا",93,"ع",2,0],["وغمرتهم بالعطف منك عليهم","حتى دعوك أباً لهم وعميدا",94,"د",2,0],["وغمد سيفيَ مصحوبا بنخوته","يناهض الليل سيفا دون حراس!!",95,"س",1,0],["١٠- وغَمامةً قد أغْدقتْ فوق الرُّبى","غيْثًا بهِ الطّيرُ انْتشى فشدا لَهُ",96,"ل",2,0],["وَغَمامُ الجَوِّ قَدْ ظَلَّلَهُ","وَوَقاهُ مِنْ حَراراتِ الوَمَدْ",97,"د",1,0],["وغمامةً من نرجسٍ وزبرجدٍ ‏‎","ناءت بعين الشمس كي تحميكِ‎",98,"ك",1,0],["وغمضي لا تخوني ثَمَّ مختبأ","نعد (واحد) ....،....، حتى نبلغ العشرةْ",99,"ر",2,0],["وغمرتني بالود أياماً فكم","آثرتَني في مشربٍ أو مَطْعَمِ",100,"م",1,0],["وغمّتا عينايَ من حُمرةٍ","تلظى على وجهي بها وجنتاه",101,"ا",2,0],["وغَمَامَاً سِحْرِيَّةً في نداها","لَبِسَ الشُّوكُ حَوْلَنَا اليَاسَمِيْنَا",102,"ن",2,0]]}