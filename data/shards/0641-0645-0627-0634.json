بيب المبرقع","https://www.poetsgate.com/ViewPoem.aspx?id=111873",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5956,"فراقُ شاطئ اللاذقية","https://www.poetsgate.com/ViewPoem.aspx?id=184917",""],[5956,"بدمع الذل","https://www.poetsgate.com/ViewPoem.aspx?id=185265",""],[6018,"جمعت إلى العلي شرف الأبوه","https://www.poetsgate.com/ViewPoem.aspx?id=181197",""],[469,"ألم تحتلف ان لا تعود الى ظلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574813",""],[520,"تبسم في ليل الشباب مشيب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577435",""],[6277,"ما ذم شعرك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64471&r=&rc=34",""]],"verses":[["فَما شِئتَ تَنسِمُ بِالقَلبِ نَشراً","وَما شِئتَ تَقطِفُ بِالعَينِ وَردا",0,"د",2,0],["فَما شِئتَ مِن داعٍ إِلى اللَهِ مُسمِعٍ","وَمِن ناصِرٍ لِلحَقِّ ماضي الضَرائِبِ",1,"ب",1,0],["فما شاعَ بالأسْرارِ منها مُسَوَّرٌ","ولم نتَّهِمْ أيضاً عليها المُخَدَّما",2,"م",2,0],["فما شِئْتَ فيها من نَمارِقِ سُنْدُسٍ","وإسْتَبْرَقٍ منْ فوْقِ غُبْرِ الرُّبى يبْدو",3,"د",2,0],["فَما شِئْتَهُ منْ نَرْجِسٍ وبنَفْسَجٍ","وآسٍ وسُوسانٍ نَضيرٍ ومنْ وَرْدِ",4,"د",1,0],["فَمَا شِئْتَ مِنْ نَصْرٍ عَزيزِ وَأَنْعُم","أَثَابَ بِهِنَّ الْمُوِمِنينَ مُثيبُ",5,"ب",1,0],["فَما شَتمي بِسَنّوتٍ بِزُبدٍ","وَلا عَسَلٍ تُصَفِّقُهُ بِراحِ",6,"ح",1,0],["فَما شَهِدَ الدُنيا تَزولُ وَلا رَأى","بَلاءَ قَضاءِ اللَهِ فيمَن يُحارِبُه",7,"ب",2,0],["فَما شيمَ مِن ذي الهَبَّةِ الصارِمِ الشَبّا","وَلا حُطَّ عَن ذي المَيعَةِ السابِحِ اللِبدُ",8,"د",1,0],["فَما شَجيتُ بِشَيءٍ ما شَجيتُ بِهِ","كَأَنَّما اِعتَمَّ مِنهُ مَفرِقي بِجَبَل",9,"ل",1,0],["فَما شَهِدَت خَيلُ اِمرِئِ القَيسِ غارَةً","بِثَهلانَ تَحمي عَن فُروجِ الحَقائِقِ",10,"ق",1,0],["فما شئت فالبَسْ فالمُشاهدُ قائلٌ","تبارك ما أبْهى وأسْنى وأَجْملاَ",11,"ل",2,0],["فما شئت من طعم زكيِّ مهنِّاً","وما شئت من عَرْف ذكي ومن نشر",12,"ر",1,0],["فما شاقني إلا بدورَ خدُورِها","وقد لُحْنَ يومَ النّفر في قُضُبِ مُلْدِ",13,"د",1,0],["فَما شَجَراتُ عيصِكَ في قُرَيشٍ","بِعَشّاتِ الفُروعِ وَلا ضَواحي",14,"ح",2,0],["فَما شُهِدَ القُيونُ غَداةَ رُعنا","بَني ذُهلٍ وَحَيَّ بَني مَصادِ",15,"د",1,0],["فَما شَهِدَت يَومَ الغَبيطِ مُجاشِعٌ","وَلا نَقَلانَ الخَيلِ مِن قُلَّتَي يُسرِ",16,"ر",1,0],["فَما شَهِدَت رِجالُ التَيمِ حَرباً","وَلا أَيّامَ طِخفَةَ وَالنِسارِ",17,"ر",1,0],["فَما شَعَروا بِها إِلّا ثَباتاً","دُوَينَ الشَدَّ تَصطَخِبُ اِصطِخابا",18,"ب",2,0],["فما شفني من ذاك إلا تخوُّفي","عليك بما أوْليتني غمصَ غامص",19,"ص",1,0],["فَما شابَ رَأسي مِن سِنينَ تَتابَعَت","طِوالٍ وَلَكِن شَيَّبَتهُ الوَقائِعُ",20,"ع",1,0],["فَما شاقَ طَرفي غَيرَ وَجهِكَ شائِقٌ","وَلا حازَ قَلبي غَيرَ حُبَّكِ حائِزُ",21,"ز",1,0],["فَما شِئتَ مِن أَمرٍ فَسَمعاً وَطاعَةً","فَما ثَمَّ إِلّا ما تُحِبُّ وَتُؤثِرُ",22,"ر",1,0],["فَمَا شَعَرُوا حَتى رَأوْهَا مُغِيرَةً","قِبَاحاً وَأمّا خَلْقُها فَجَميلُ",23,"ل",1,0],["فَما شيمَ مِن سَيفٍ بِقائِمِ نَصلِهِ","يَدٌ مِن لُجَيمٍ أَو يُفَلَّ وَيُكسَرا",24,"ر",2,0],["فَما شَكَيتُ في حِماهُ لَغباً","وَلَو أَطاقَ الدَهرُ غَبني لَغَبَن",25,"ن",1,0],["فَما شِئتَ مِن ماءِ وِردٍ بِهِ","أَراقَ وَمِن ثَوبِ حُسنٍ أَرَق",26,"ق",1,0],["فَما شِئتَ مِن زَهرَةٍ نَضرَةٍ","تَرَدّى القَضيبُ بِها وَاِشتَمَل",27,"ل",1,0],["فَما شِئتَ مِن سَيِّدٍ أَيِّدٍ","يَصُدُّ العِدى وَيَسُدُّ الثُلَم",28,"م",1,0],["فَما شَعَروا حَتّى رَأَوها مُغيرَةً","قِباحاً وَأَمّا خَلفُها فَجَميلُ",29,"ل",1,0],["فما شهدتْ خيلُ امرئِ القيسِ غارة ً","يثهلانَ تحمي عنْ فروجِ الحقائقِ",30,"ق",1,0],["فَما شَيءٌ لَهُ أَرَجٌ","حَواهُ السَهل وَالجَبَل",31,"ل",1,0],["فما شرفي إن مت أو عشت بينهم","بحقك قل للفارغين من العقل",32,"ل",1,0],["فَما شِئتَ مِن فَخرٍ صَميمٍ وَسودَدٍ","لَقَد صَدَقَت فيهِ مَقالَةُ مُنشِدٍ",33,"د",1,0],["فما شأنُ القبائحِ إذ أتاها","ونال قولبها منه انكسارُ",34,"ر",1,0],["فما شئت قل مما تحبُّ وفوقه","وأضعافه في مثلها ألف تضربُ",35,"ب",1,0],["فما شك مذ يممت مثواه أنه","فريسة أطراف المثقفة الملد",36,"د",1,0],["فما شيء ينيل القلب منه","توجع كل محزون مضام",37,"م",1,0],["فَما شَعَروا حَتّى تَداعَت عَلَيهِمُ","كَما يَتَداعى صَيِّبٌ مُتَوابِلُ",38,"ل",1,0],["فما شَفَيا الدّاءَ الذي بيَ كُلَّهُ","وما ذَخَرا نُصْحاً ولا أَلَواني",39,"ن",2,0],["فما شَنَّتا خَرقاءَ واهٍ كُلاهُما","سَقَى بِهِمِا ساقٍ وَلا ماتَبَلّلا",40,"ل",2,1],["فما شاهدت غير مصادقات","وحاجات وعادات اصطلاح",41,"ح",1,0],["فَما شذَّ عن أقوالهم قطُّ مسلمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",42,"م",3,0],["فَما شَكا ظَهرَهُ مِن حَملِ مَضلِعِهِ","وَلا تَكَعكَعَ مِن وَقرٍ وَلا ظَلَعا",43,"ع",2,0],["فَما شَتمي بِنافِعِ حَيِّ عَوفٍ","وَلا مِثلي بِضائِرِهِ الوَعيدُ",44,"د",1,0],["فما شقاوة روحي","يا غ غادرين سعدتم",45,"م",1,0],["فما شكواك من ظلماء طالت","وتلك جناية المجد اللباب",46,"ب",1,0],["فما شمت منه البشر فاليسر ضمنه","وهل بارق إلا وعقباه وابل",47,"ل",1,0],["فما شعرُهم إِلا انفجارُ شعورِهم","فقوَّى على البلوى وروَّى على القحل",48,"ل",1,0],["فما شِئتُ من نوحٍ ومن زبدٍ ومن","هديرٍ فلن ترضى المروءةُ إحجامي",49,"م",2,0],["فما شعرَت نفسٌ بأحزان عابر","ولا مَسحَت كفٌّ دموعَ كئيب",50,"ب",1,0],["فما شَعبُها شعبٌ ولا هيَ موطنٌ","وقد قيلَ للعاوي هُنالِكَ زمجرا",51,"ر",2,0],["فَما شاعَ إِلّا بِالمَحامِدِ ذِكرُهُ","وَلا شاعَ إِلّا في عُلاهُ مَديحُ",52,"ح",1,0],["فما شفيت نفس أطاعته رهبة","وما سعدت نفس عصته لرغبة",53,"ه",1,0],["فما شئت فاصنع وارض عني فإنني","أرى كل صنع منك إسباغ نعمة",53,"ه",1,0],["فَما شاءَ فَليَفعَل فَمُذ ما عَرَفتُهُ","تَعَوَّدتُ مَسَّ الضُرِّ حَتّى أَلِفتُهُ",54,"ه",1,0],["فما شاء مولانا إلا له فإنه","يكون ومالا لا يكون بحيلة",55,"ه",1,0],["فما شفت وجدي ولا كفكفت","دمعى ولا أصغَت إلى طرقي",56,"ق",2,0],["فما شاء فالأرض والساكنون","فدى أمره النافذ السابق",57,"ق",1,0],["فما شعرت بنفسي","الا شهيد ابتذالي",58,"ل",2,0],["فَما شَكا زَفْرةً كالعَاشِقينَ ولا","تخضبَّتْ بِنَجِيعٍ فِيهِ سِكِّينُ",59,"ن",1,0],["فَما شَهِدَتهُ العَينُ مَعنىً فَذاتُها","وَمِن هَيئَةٍ فَهيَ المِثالُ لِهَيئَتي",60,"ي",1,0],["فما شَمسُه إلاّ شُعاعُ صفائح","وما أَرضُه إلاّ ثَرىً فيه ثائر",61,"ر",1,0],["فما شَبَّهتْ عيني لها قوسَ حاجبٍ","أشارَتْ به نحوي سوى قوسِ حاجب",62,"ب",1,0],["فما شبه هند غيرُ أدماءَ خاذِلٍ","من الوحشِ مرتاعٍ تُراعي طَلا فَرْدا",63,"د",2,0],["فَما شَعَرَ الحَيُّ حَتَّى رَأَوْا","بَي