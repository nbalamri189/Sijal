{"poems":[[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[77,"لقد زالت اللأواء وارتفع الجهد","https://www.aldiwan.net/poem36547.html","الطويل"],[77,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[9,"أتاني ما يقول لي ابن بظرى","https://www.aldiwan.net/poem21919.html","الوافر"],[86,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[54,"ألقى عصاه وأرخى من عمامته","https://www.aldiwan.net/poem27379.html","البسيط"],[30,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[83,"أمولاي يا ابن السابقين إلى العلا","https://www.aldiwan.net/poem54264.html","الطويل"],[83,"طعامك من دار النعيم بعثته","https://www.aldiwan.net/poem54300.html","الطويل"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[27,"أتصحو بل فؤادك غير صاح","https://www.aldiwan.net/poem5698.html","الوافر"],[27,"أتنسى دارتي هضبات غول","https://www.aldiwan.net/poem5725.html","الوافر"],[27,"أدار الجميع الصالحين بذي السدر","https://www.aldiwan.net/poem5770.html","الطويل"],[27,"لقد نادى أميرك بابتكار","https://www.aldiwan.net/poem5777.html","الوافر"],[47,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[14,"تقول ألا أقصر من الغزو واشتكى","https://www.aldiwan.net/poem38294.html","الطويل"],[70,"أأحبابنا بالله كيف تغيرت","https://www.aldiwan.net/poem42866.html","الطويل"],[70,"لأجلك سعيي واجتهادي وخدمتي","https://www.aldiwan.net/poem42897.html","الطويل"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[28,"لعمري لقد سلت حنيفة سلة","https://www.aldiwan.net/poem5093.html","الطويل"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[74,"ليهنك وافد أنس سرى","https://www.aldiwan.net/poem13186.html","المتقارب"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/247","الطويل"],[30,"أَقُولُ لِنَفْسِي وَاقِفاً عنْدَ مُشْرِفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20517&r=&rc=11",""],[109,"تناهى عنده الأمل","https://www.aldiwan.net/poem16299.html","مجزوء الوافر"],[115,"إذا لم تكن أسلى بعزي معزة","https://www.aldiwan.net/poem41717.html","الطويل"],[150,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[160,"مقامي تحت ظل الذل عار","https://www.aldiwan.net/poem58760.html","الوافر"],[160,"أعندك علم أم أقول فأطرب","https://www.aldiwan.net/poem58761.html","الطويل"],[160,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[160,"فرائد زانها حسن النظام","https://www.aldiwan.net/poem59119.html","الطويل"],[169,"صداق المعالي مشرفي وذابل","https://www.aldiwan.net/poem1647.html",""],[177,"لعمري إني يوم بصرى وناقتي","https://www.aldiwan.net/poem4500.html","الطويل"],[181,"فما شنتا خرقاء واه كلاهما","https://www.aldiwan.net/poem58855.html","الطويل"],[186,"صحبت الدهر في بوبي فقير","https://www.aldiwan.net/poem44076.html","الوافر"],[189,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[195,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[207,"أراني كلما قاربت قومي","https://www.aldiwan.net/poem27975.html","الوافر"],[211,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[211,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[261,"رؤوس العوالي للمعالي معاقل","https://www.aldiwan.net/poem38212.html","الطويل"],[270,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[270,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[270,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[282,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[313,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[320,"علام الوم الدهر فيها دهمته","https://www.aldiwan.net/poem67111.html","الطويل"],[325,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[328,"مكانتي أصغر من حقي","https://www.aldiwan.net/poem54950.html","الطويل"],[328,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[342,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[348,"كانون مطبخنا في العيد كانون","https://www.aldiwan.net/poem20727.html","البسيط"],[349,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[364,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[364,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[368,"خليلي عوجا بارك الله فيكما","https://www.aldiwan.net/poem1870.html","الطويل"],[368,"أتتني لسان بني عامر","https://www.aldiwan.net/poem1872.html","المتقارب"],[377,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[377,"لنا الحجر المرموز في الكتب سره","https://www.aldiwan.net/poem59333.html","الطويل"],[391,"أنحت بباب الكريم الأمل","https://www.aldiwan.net/poem54548.html","عموديه"],[403,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[410,"مضى لسبيله معن وأبقى","https://www.aldiwan.net/poem67484.html","الوافر"],[439,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[452,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"],[461,"أقول لصحبي حين أجهشت العلى","https://www.aldiwan.net/poem15940.html","الطويل"],[464,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[464,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[464,"ألم تحتلف أن لا تعود إلى ظلم","https://www.aldiwan.net/poem3450.html","عموديه"],[464,"عيون المها مالي بسحرك من يد","https://www.aldiwan.net/poem3556.html","عموديه"],[464,"كأن المغاني حين أعجمها الشحط","https://www.aldiwan.net/poem3607.html","عموديه"],[477,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[505,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[515,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[529,"ليهنكم دار المسرة إنها","https://www.aldiwan.net/poem37313.html","الطويل"],[551,"ألا إن قلبي من بعدكم","https://www.aldiwan.net/poem47260.html","المتقارب"],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"ومنتقبات بالجمال على منى","https://www.aldiwan.net/poem47763.html","الطويل"]],"verses":[["فَما شِئتَ تَنسِمُ بِالقَلبِ نَشراً","وَما شِئتَ تَقطِفُ بِالعَينِ وَردا",0,"د",2,0],["فَما شِئتَ مِن داعٍ إِلى اللَهِ مُسمِعٍ","وَمِن ناصِرٍ لِلحَقِّ ماضي الضَرائِبِ",1,"ب",1,0],["فما شاعَ بالأسْرارِ منها مُسَوَّرٌ","ولم نتَّهِمْ أيضاً عليها المُخَدَّما",2,"م",2,0],["فما شِئْتَ فيها من نَمارِقِ سُنْدُسٍ","وإسْتَبْرَقٍ منْ فوْقِ غُبْرِ الرُّبى يبْدو",3,"د",2,0],["فَما شِئْتَهُ منْ نَرْجِسٍ وبنَفْسَجٍ","وآسٍ وسُوسانٍ نَضيرٍ ومنْ وَرْدِ",4,"د",1,0],["فَمَا شِئْتَ مِنْ نَصْرٍ عَزيزِ وَأَنْعُم","أَثَابَ بِهِنَّ الْمُوِمِنينَ مُثيبُ",5,"ب",1,0],["فَما شَتمي بِسَنّوتٍ بِزُبدٍ","وَلا عَسَلٍ تُصَفِّقُهُ بِراحِ",6,"ح",1,0],["فَما شَهِدَ الدُنيا تَزولُ وَلا رَأى","بَلاءَ قَضاءِ اللَهِ فيمَن يُحارِبُه",7,"ب",2,0],["فَما شيمَ مِن ذي الهَبَّةِ الصارِمِ الشَبّا","وَلا حُطَّ عَن ذي المَيعَةِ السابِحِ اللِبدُ",8,"د",1,0],["فَما شَجيتُ بِشَيءٍ ما شَجيتُ بِهِ","كَأَنَّما اِعتَمَّ مِنهُ مَفرِقي بِجَبَل",9,"ل",1,0],["فَما شَهِدَت خَيلُ اِمرِئِ القَيسِ غارَةً","بِثَهلانَ تَحمي عَن فُروجِ الحَقائِقِ",10,"ق",1,0],["فما شئت فالبَسْ فالمُشاهدُ قائلٌ","تبارك ما أبْهى وأسْنى وأَجْملاَ",11,"ل",2,0],["فما شئت من طعم زكيِّ مهنِّاً","وما شئت من عَرْف ذكي ومن نشر",12,"ر",1,0],["فما شاقني إلا بدورَ خدُورِها","وقد لُحْنَ يومَ النّفر في قُضُبِ مُلْدِ",13,"د",1,0],["فَما شَجَراتُ عيصِكَ في قُرَيشٍ","بِعَشّاتِ الفُروعِ وَلا ضَواحي",14,"ي",1,0],["فَما شُهِدَ القُيونُ غَداةَ رُعنا","بَني ذُهلٍ وَحَيَّ بَني مَصادِ",15,"د",1,0],["فَما شَهِدَت يَومَ الغَبيطِ مُجاشِعٌ","وَلا نَقَلانَ الخَيلِ مِن قُلَّتَي يُسرِ",16,"ر",1,0],["فَما شَهِدَت رِجالُ التَيمِ حَرباً","وَلا أَيّامَ طِخفَةَ وَالنِسارِ",17,"ر",1,0],["فَما شَعَروا بِها إِلّا ثَباتاً","دُوَينَ الشَدَّ تَصطَخِبُ اِصطِخابا",18,"ب",2,0],["فما شفني من ذاك إلا تخوُّفي","عليك بما أوْليتني غمصَ غامص",19,"ص",1,0],["فَما شابَ رَأسي مِن سِنينَ تَتابَعَت","طِوالٍ وَلَكِن شَيَّبَتهُ الوَقائِعُ",20,"ع",1,0],["فَما شاقَ طَرفي غَيرَ وَجهِكَ شائِقٌ","وَلا حازَ قَلبي غَيرَ حُبَّكِ حائِزُ",21,"ز",1,0],["فَما شِئتَ مِن أَمرٍ فَسَمعاً وَطاعَةً","فَما ثَمَّ إِلّا ما تُحِبُّ وَتُؤثِرُ",22,"ر",1,0],["فَمَا شَعَرُوا حَتى رَأوْهَا مُغِيرَةً","قِبَاحاً وَأمّا خَلْقُها فَجَميلُ",23,"ل",1,0],["فَما شيمَ مِن سَيفٍ بِقائِمِ نَصلِهِ","يَدٌ مِن لُجَيمٍ أَو يُفَلَّ وَيُكسَرا",24,"ر",2,0],["فَما شَكَيتُ في حِماهُ لَغباً","وَلَو أَطاقَ الدَهرُ غَبني لَغَبَن",25,"ن",1,0],["فَما شِئتَ مِن ماءِ وِردٍ بِهِ","أَراقَ وَمِن ثَوبِ حُسنٍ أَرَق",26,"ق",1,0],["فَما شِئتَ مِن زَهرَةٍ نَضرَةٍ","تَرَدّى القَضيبُ بِها وَاِشتَمَل",27,"ل",1,0],["فَما شِئتَ مِن سَيِّدٍ أَيِّدٍ","يَصُدُّ العِدى وَيَسُدُّ الثُلَم",28,"م",1,0],["فَما شَعَروا حَتّى رَأَوها مُغيرَةً","قِباحاً وَأَمّا خَلفُها فَجَميلُ",29,"ل",1,0],["فما شهدتْ خيلُ امرئِ القيسِ غارة ً","يثهلانَ تحمي عنْ فروجِ الحقائقِ",30,"ق",1,0],["فَما شَيءٌ لَهُ أَرَجٌ","حَواهُ السَهل وَالجَبَل",31,"ل",1,0],["فما شرفي إن مت أو عشت بينهم","بحقك قل للفارغين من العقل",32,"ل",1,0],["فَما شِئتَ مِن فَخرٍ صَميمٍ وَسودَدٍ","لَقَد صَدَقَت فيهِ مَقالَةُ مُنشِدٍ",33,"د",1,0],["فما شأنُ القبائحِ إذ أتاها","ونال قولبها منه انكسارُ",34,"ر",1,0],["فما شئت قل مما تحبُّ وفوقه","وأضعافه في مثلها ألف تضربُ",35,"ب",1,0],["فما شك مذ يممت مثواه أنه","فريسة أطراف المثقفة الملد",36,"د",1,0],["فما شيء ينيل القلب منه","توجع كل محزون مضام",37,"م",1,0],["فَما شَعَروا حَتّى تَداعَت عَلَيهِمُ","كَما يَتَداعى صَيِّبٌ مُتَوابِلُ",38,"ل",1,0],["فما شَفَيا الدّاءَ الذي بيَ كُلَّهُ","وما ذَخَرا نُصْحاً ولا أَلَواني",39,"ن",2,0],["فما شَنَّتا خَرقاءَ واهٍ كُلاهُما","سَقَى بِهِمِا ساقٍ وَلا ماتَبَلّلا",40,"ل",2,1],["فما شاهدت غير مصادقات","وحاجات وعادات اصطلاح",41,"ح",1,0],["فَما شذَّ عن أقوالهم قطُّ مسلمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",42,"م",3,0],["فَما شَكا ظَهرَهُ مِن حَملِ مَضلِعِهِ","وَلا تَكَعكَعَ مِن وَقرٍ وَلا ظَلَعا",43,"ع",2,0],["فَما شَتمي بِنافِعِ حَيِّ عَوفٍ","وَلا مِثلي بِضائِرِهِ الوَعيدُ",44,"د",1,0],["فما شقاوة روحي","يا غ غادرين سعدتم",45,"م",1,0],["فما شكواك من ظلماء طالت","وتلك جناية المجد اللباب",46,"ب",1,0],["فما شمت منه البشر فاليسر ضمنه","وهل بارق إلا وعقباه وابل",47,"ل",1,0],["فما شعرُهم إِلا انفجارُ شعورِهم","فقوَّى على البلوى وروَّى على القحل",48,"ل",1,0],["فما شِئتُ من نوحٍ ومن زبدٍ ومن","هديرٍ فلن ترضى المروءةُ إحجامي",49,"م",2,0],["فما شعرَت نفسٌ بأحزان عابر","ولا مَسحَت كفٌّ دموعَ كئيب",50,"ب",1,0],["فما شَعبُها شعبٌ ولا هيَ موطنٌ","وقد قيلَ للعاوي هُنالِكَ زمجرا",51,"ر",2,0],["فَما شاعَ إِلّا بِالمَحامِدِ ذِكرُهُ","وَلا شاعَ إِلّا في عُلاهُ مَديحُ",52,"ح",1,0],["فما شفيت نفس أطاعته رهبة","وما سعدت نفس عصته لرغبة",53,"ه",1,0],["فما شئت فاصنع وارض عني فإنني","أرى كل صنع منك إسباغ نعمة",53,"ه",1,0],["فَما شاءَ فَليَفعَل فَمُذ ما عَرَفتُهُ","تَعَوَّدتُ مَسَّ الضُرِّ حَتّى أَلِفتُهُ",54,"ه",1,0],["فما شاء مولانا إلا له فإنه","يكون ومالا لا يكون بحيلة",55,"ه",1,0],["فما شفت وجدي ولا كفكفت","دمعى ولا أصغَت إلى طرقي",56,"ي",1,0],["فما شاء فالأرض والساكنون","فدى أمره النافذ السابق",57,"ق",1,0],["فما شعرت بنفسي","الا شهيد ابتذالي",58,"ي",1,0],["فَما شَكا زَفْرةً كالعَاشِقينَ ولا","تخضبَّتْ بِنَجِيعٍ فِيهِ سِكِّينُ",59,"ن",1,0],["فَما شَهِدَتهُ العَينُ مَعنىً فَذاتُها","وَمِن هَيئَةٍ فَهيَ المِثالُ لِهَيئَتي",60,"ي",1,0],["فما شَمسُه إلاّ شُعاعُ صفائح","وما أَرضُه إلاّ ثَرىً فيه ثائر",61,"ر",1,0],["فما شَبَّهتْ عيني لها قوسَ حاجبٍ","أشارَتْ به نحوي سوى قوسِ حاجب",62,"ب",1,0],["فما شبه هند غيرُ أدماءَ خاذِلٍ","من الوحشِ مرتاعٍ تُراعي طَلا فَرْدا",63,"د",2,0],["فَما شَعَرَ الحَيُّ حَتَّى رَأَوْا","بَياضَ القَوانِسِ فَوقَ الغُرَرْ",64,"ر",1,0],["فما شينَ أيوبٌ لخسَّةِ أصله","ولا زين إسرائيل وهو أصيل",65,"ل",1,0],["فما شئت من إحكام أمرٍ فأبرِمَنْ","وما شئت من إنفاذ حكمٍ فبالغا",66,"غ",2,0],["فما شايكون وما لم يشا","فليس بكائن ففيم الوجل",67,"ل",1,0],["فما شعره إلا جواب لفاضل","أو الوعظ أو ما بين ندب إلى خطب",68,"ب",1,0],["فَما شَهِدَ الوَقائِعَ مِنكَ أَمضى","وَأَكرَمُ محتَداً وَأَشَدُّ بالا",69,"ل",2,0],["فما شَرِبُوا مياهَ الأَرْضِ حَتَّى","تَرَكْنَ وجوهَهُمْ من غَيْرِ ماءِ",70,"ا",2,0],["فما شِعب بَوّانٍ ونهرُ أُبُلَّةٍ","وصُغدُ سَمَرْقندٍ وغُوطةُ جِلقِّ",71,"ق",1,0],["فما شَعَروا حتى تدافعَ مُفْعَمٌ","حميلاه سرحٌ مُخرفٌ وغضاً جزل",72,"ل",1,0],["فما شقّ حسناً مثلها عينَ ناظرٍ","ولا شاق طيباً غيرها إذن سامع",73,"ع",1,0],["فما شئتما من عفَّةٍ تحت قدرةٍ","ومن رفعةِ شمَّاءَ تحت تواضع",73,"ع",1,0],["فما شئتَ من نهرٍ في الوهادِ","وما شئتَ من زهرٍ في القنن",74,"ن",1,0],["فما شافه العذَّال مثل مدامعي","ولا خاطب الواشين أفصحُ من سقمي",75,"م",2,0],["فما شئت من حسنٍ وحزنٍ مضاعف","ونغمة إدلالٍ وأنَّة مكمد",76,"د",1,0],["فما شاقني حسن التسلّي وقد دنوا","ولا راقني طيب الحياة وقد شطّوا",77,"ط",3,0],["فما شاقهاوهي الخوامسُ منهلُ","ولا جَنَحَتْ تبغي بحارَ اليلامعِ",78,"ع",1,0],["فما شفعَتْ لهذا أوْ لأُولا","ءِ نِسبتهمْ لخيرِ الشّافعينا",79,"ن",2,0],["فما شيمة للمجد إلا وقد غدا","لها منك حظ وافر ونصيب",80,"ب",1,0],["فما شِعْبُ بَوَّانٍ وَصُغْدُ سَمَرْ قَدٍ","يماثِلُها فلْيَعْرِفِ الْفَرْقَ عارِفُ",81,"ف",1,0],["فما شئتَ من مَلْطَمٍ ضارعٍ","وماءِ حياءٍ لهم سائلِ",82,"ل",1,0],["فما شئتَ من تامكٍ ناحلٍ","وما شئتَ من ضيّقٍ حائلِ",83,"ل",1,0],["فما شئتَ من طيبٍ ذَكيٍّ لناشقٍ","وما شئتَ من حسنٍ أنيقٍ لمُبص