{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39620","الخفيف"],[98,"الشوق العائد","https://www.poetsgate.com/ViewPoem.aspx?id=17494",""],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[119,"آه هذا برق الابيرق لاحا","https://www.aldiwan.net/poem41175.html","عموديه"],[133,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[203,"أنحلوني وأسقموا","https://www.aldiwan.net/poem45226.html","مجزوء الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5956,"كلما الطيف يلوح","https://www.poetsgate.com/ViewPoem.aspx?id=192770",""],[5966,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=159346",""]],"verses":[["آهِ هاتي قرِّبي الكأس إليَّهْ","واسقنيها أنت يا أندلسيَّهْ",0,"ه",1,0],["آه هاتيها من الحسن جَنِيَّهْ","واسقنيها أنت يا أندلسيَّهْ",0,"ه",1,0],["آه هاتيها كخدّيكِ نقيّهْ","واسقنيها أنت يا أندلسيَّهْ",0,"ه",1,0],["آهِ هيهات أن يعود ولو أفْ","نيتُ عمري تحرُّقاً وولوعا",1,"ع",2,0],["آهِ هيهات أن يعود ولو ذَوْ","وَبتُ قلبي صبابةً ودموعا",1,"ع",2,0],["آه هيهات أن يعود ولو","ذوّبت قلبي صبابة ودموعا",2,"ع",2,0],["آهة بعد آهة من عريب","تخلق الظلّ للضحى المكدود",3,"د",1,0],["آه هذا برق الابيرق لاحا","والفؤاد الولوه بالسر باحا",4,"ح",2,1],["آه هل يَحترِمُ الأعلامَ","دُودٌ في القُبور",5,"ر",1,0],["أهِ هيهاتَ ما لما","تجرحُ العينَ مرهمُ",6,"م",1,0],["آهِ هَكطُورُ أَخي كُلُّ الشُّرُور","والرَّزَايا الدُّهمُ مِن أَجلي تَثُور",7,"ر",1,0],["أهُهُ شاعرٌ بأنا احترقنا","من لظى حرِّه وأنا اكتوينا",8,"ن",2,0],["آهة الإنسان كالأنسامِ تسري","وهي والبسماتُ تأتي وتروحُ",9,"ح",1,0],["آهةُ الفجرِ تناجي حُلماً","صدَّ نحوي باشتعالاتِ الأفق",10,"ق",1,0]]}