{"poems":[[63,"سقى همذان حيا مزنة","https://www.aldiwan.net/poem45813.html","المتقارب"],[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[63,"خاض الدجى ورواق الليل مسدولب","https://www.aldiwan.net/poem46219.html","البسيط"],[100,"اليوم الجنين","https://www.aldiwan.net/poem43675.html","عموديه"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[88,"لله سر في الأنام مطلسم","https://www.aldiwan.net/poem45067.html","الكامل"],[4,"أقوى وعري واسط فبرام","https://www.aldiwan.net/poem21194.html","الكامل"],[51,"أحب كل غادة","https://www.aldiwan.net/poem66035.html","مجزوء الرجز"],[91,"ما بالهم نقضوا العهود جهارا","https://www.aldiwan.net/poem8862.html","عموديه"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[45,"أما وهذا الزمان يمتحنه","https://www.aldiwan.net/poem66844.html","البسيط"],[61,"صبابة منك لجت في تماديها","https://www.aldiwan.net/poem51400.html","البسيط"],[61,"يا أبا إسحاق زاد الله","https://www.aldiwan.net/poem51668.html","مجزوء الرمل"],[40,"إنسانة الحي أم أدمانة السمر","https://www.aldiwan.net/poem42270.html","البسيط"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[48,"يا لاعبا بحياتي","https://www.aldiwan.net/poem62469.html","المجتث"],[48,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[48,"علقت من شقوتي ومن نكدي","https://www.aldiwan.net/poem64442.html","المنسرح"],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72204","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42496","الكامل"],[36,"أياعين بكي توبة ابن حمير","https://www.poetsgate.com/ViewPoem.aspx?id=15865",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[113,"صبرت عليك عن حلم ورفق","https://www.aldiwan.net/poem40587.html","عموديه"],[124,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[126,"يا نفس أنت محادده","https://www.aldiwan.net/poem50643.html","مجزوء الكامل"],[183,"أف لها دنيا فلا تستقر","https://www.aldiwan.net/poem14531.html","السريع"],[202,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[202,"لم أحضر المجلس شوقا الى","https://www.aldiwan.net/poem53263.html","السريع"],[208,"قلبي عليك غراما في الهوى يجب","https://www.aldiwan.net/poem13369.html","البسيط"],[221,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[239,"يا بني الفقر سلاما عاطرا","https://www.aldiwan.net/poem45752.html","الرمل"],[248,"وافي إليك بلهوه النيروز","https://www.aldiwan.net/poem14982.html","الكامل"],[257,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[259,"أعيونهن أم بيض الصفاح","https://www.aldiwan.net/poem38347.html","الرمل"],[259,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[268,"ما زلت يا كاس تعلينا ونعليك","https://www.aldiwan.net/poem35296.html","البسيط"],[268,"سلت مهندها فخف من حده","https://www.aldiwan.net/poem35414.html","الكامل"],[268,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[269,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[280,"القلب من شفقي اللون يرسف في","https://www.aldiwan.net/poem32687.html","البسيط"],[280,"انظر إلى الروض البهيج واعجب","https://www.aldiwan.net/poem32888.html","الكامل"],[283,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[283,"أمحمد بن الشيخ يا فخر القضا","https://www.aldiwan.net/poem39394.html","الكامل"],[303,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[320,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[351,"أفدي الذي وافى إلي بباقة","https://www.aldiwan.net/poem40218.html","الكامل"],[361,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[362,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[362,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[364,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[377,"أصبا الأصيل تحملي","https://www.aldiwan.net/poem49234.html","مجزوء الكامل"],[403,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[403,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[413,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[424,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[438,"يا ليت شعري بما ألقاه في حدثي","https://www.aldiwan.net/poem14356.html","البسيط"],[441,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[447,"إلى ربيع العمر","https://www.aldiwan.net/poem1006.html",""],[450,"وافى الربيع بترنام الفواخيت","https://www.aldiwan.net/poem13672.html","البسيط"],[450,"يا مؤثرا للهو طيب النعمه","https://www.aldiwan.net/poem13927.html","الكامل"],[456,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[456,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[462,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[462,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[462,"طال السهاد مع القلق","https://www.aldiwan.net/poem3469.html","عموديه"],[466,"لا تعتمد عتبا يكدر ما صفا","https://www.aldiwan.net/poem59739.html","الكامل"],[466,"يا من شراني له نخاس همته","https://www.aldiwan.net/poem60356.html","المنسرح"],[466,"الغيم في حافتيه البرق يلتهب","https://www.aldiwan.net/poem60464.html","البسيط"],[475,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[511,"هبني أطيع ملام الكاشحين ولا","https://www.aldiwan.net/poem67690.html","الطويل"],[512,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[513,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[540,"تفرقوا ودعوني","https://www.aldiwan.net/poem34042.html","المجتث"],[556,"لا تخلط الواجب بالممكن","https://www.aldiwan.net/poem33716.html","السريع"],[556,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[556,"عندنا سر عجيب خطرا","https://www.aldiwan.net/poem34522.html","الرمل"],[560,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[573,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[585,"تأجج الوجد في الأحشا واضطربا","https://www.aldiwan.net/poem11556.html","عموديه"]],"verses":[["فَأَلواحُ أَمواهِها كالعَبيرِ","تُرى أَرضُها وَحَصاها الجُمانْ",0,"ن",1,0],["فالوِرْدُ إلا في ذَراكَ مُرَنَّقٌ","والظِّلُّ إلا في جَنابِكَ زائلُ",1,"ل",1,0],["فَالوجْهُ أبلَجُ واللّبَّاتُ واضِحةٌ","وفَرعُها وارِدٌ والمَتْنُ مَجدولُ",2,"ل",1,0],["فألوي زنود الحنان","على خصره الطيّع",3,"ع",1,0],["فَأَلوَت بِهِ طارَ مِنكَ الفُؤادُ","وَأَلفَيتَ حَيرانَ أَو مُستَحيرا",4,"ر",2,0],["فالوجه فيه من القرونة مسحةٌ","للخافيات بها وضوح مبهم",5,"م",1,0],["فَالوادِيانِ فَكُلُّ مَغنىً مِنهُمُ","وَعَلى المِياهِ مَحاضِرٌ وَخِيامُ",6,"م",1,0],["فالوجهُ منها جنة","وحَرُها جهنمُ",7,"م",1,0],["فَالوَيلُ لِلدُنيا إِذا نَفَضَ الكَرى","وَالوَيلُ لِلأَيّامِ إِمّا ثارا",8,"ر",2,0],["فَالوَصلُ أَجمَلُهُ ما كانَ بَعدَ نَوىً","وَالشَمسُ بَعدَ الدُجى أَشهى لِرائيها",9,"ي",3,0],["فالوُجُودُ الشقيُّ غيرُ جديرٍ","بالأَغاني وبالجمالِ الزَّاهي",10,"ي",1,0],["فَالوَرى في ضَلالِهِ مُتَمادٍ","يَفتُكُ الجَهلُ فيهِ وَالجُهَلاءُ",11,"ا",2,0],["فالوَيْلُ والنّارُ والثُّبُورُ لِمَنْ","قَدْ أَسْلَموهُ لِلْجَمْرِ واللّهَبِ",12,"ب",1,0],["فَالوَفرُ بِالنَصلِ يُستَفادُ إِذا","ضاقَت عَلى ذي بَصيرَةٍ مُدُنُه",13,"ن",2,0],["فالوجدُ يُظهِرُها إن رُحتُ أُكمِنُها","والدمعُ يَنشُرُها إن بِتُّ أَطويها",14,"ي",3,0],["فالوَرى في بَرْدِ آصا","لِكَ أو حَرِّ هَجيرِكْ",15,"ك",1,0],["فَالوَردُ وَجنَتُها وَالخَمرُ رِيقَتُها","وَضُوءُ بَهجَتِها أَضوا مِن القَمَرِ",16,"ر",1,0],["فالوَصْفُ يَبْقَى حُكْمُهُ مَع فَقْدِهِ","وَالمَرْءُ مَرْدُودٌ إذَا لَمْ يُفْقَدِ",17,"د",1,0],["فَالوَجهُ بَدرُ تَمامٍ","بِعَينِ ظَبيٍ فَلاةِ",18,"ه",1,0],["فَالوَيلُ لي كَيفَ أَنجو","مِن حُمرِ مَوتٍ وَسودِه",19,"د",2,0],["فَالوَيلُ لي مِن طِلابِ مُحتَبِسٍ","صِرتُ كَميناً لَهُ عَلى طُرُقِه",20,"ق",2,0],["فالوَجْدُ باقٍ والوِصَالُ مُماطلي","والصّبْرُ فانٍ واللّقاء مُسَوّفي",21,"ي",1,0],["فألْوَتْ بأعْناقٍ طِوالٍ وَراعَها","صَلاصِلُ بِيضٍ سابغٍ وسَنَوَّرِ",22,"ر",1,0],["فالوتدُ المَجموعُ منها فافْهمنْ","حركتانِ قبلَ حرفٍ قد سَكَنْ",23,"ن",1,0],["فَالْوُرْقُ تَهْتِفُ وَالرَّبارِبُ تَرْتَعِي","وَالْعِينُ تَبْغَمُ وَالبَلابِلُ تَصْرَأُ",24,"ر",2,0],["فألوت باعناق طوار وراعها","صلاصل بيض سابغ وسنورِ",25,"ر",1,0],["فالوعيُ بَغىٌ ، والتحرُّرُ سُبَّةٌ","والهَمْسُ جُرْمٌ ، والكلامُ حَرام",26,"م",1,0],["فالو وجها عن اللئام ودعهم","فلئام الورى خصوم الكرام",27,"م",1,0],["فالورد في لونه خد الحبيب إذا","قطفت قبلته يحمرٌّ خجلانا",28,"ن",2,0],["فالوصف يقصُرُ عن صفا","تِ نعيمهم والمائِدَهْ",29,"د",2,0],["فالوحشُ لا يأمَنُ من قانِصٍ","أو حابِل أو أسدٍ محتِضر",30,"ر",1,0],["فالورد من وجنة المعشوق صبغتُه","والطِّيبُ من نكهة المعشوق معلولُ",31,"ل",1,0],["فالوصل والهجر على ما جَنى","من وصفة الجنة والنارِ",32,"ر",1,0],["فالورد وجنته والخمر ريقته","وكأس فيه عقيق دره الحبب",33,"ب",1,0],["فَأُلوي بِهِ عَمّا يُقالُ وَما يُروى","كَأَنِّيَ أَخشى أَن أُطاوِعَ لائِمي",34,"ي",1,0],["فالورى شرٌ وهمٌ دائمٌ","وشقاءٌ ليس يَحكِيه شَقَاء",35,"ا",2,0],["فالوجد يفصل عنه منى مثلما","أني رأيت الصَّبر وَهو يَعُوزُ",36,"ز",1,0],["فالويل له إن لم ترحمْ","ونذير الموت له يمّمْ",37,"م",1,0],["فالورى اكثرهم الاك لم","يفرقوا بين زئير ونباح",38,"ح",1,0],["فالورى وجه به أنت حياً","وحياة الوجه إبقاء الحياء",39,"ا",2,0],["فالوردُ والحَبَبُ الطَّافي قد اجتَمَعا","كالثَّغرِ والريقِ من ذاتِ المساويك",40,"ك",1,0],["فالوردُ من خَدَّيكِ مَزهى لونُهُ","والنحلُ من شفتيكِ مَجنى شهده",41,"د",2,0],["فألوانُهُ في كلِّ قلبٍ ومُقلةٍ","ونجمتُهُ تهدي الضَّليلَ المحيَّرا",42,"ر",2,0],["فالوَجد أَوجدني اليك صَبابة","وَحشا الحشا شوقا يشق الاعظما",43,"م",2,0],["فَالوَجهُ كَالشَمسِ في لاذ المَغيبِ وَلا","أَقولُ كَالبَدرِ في لألاءِ إِشراقِه",44,"ق",2,0],["فَالوَردُ يُبدي صُرَرَ الحَريرِ قَد","فُتِحنَ عَن قُراضَةٍ مِن ذَهَبِ",45,"ب",1,0],["فالويل للأفاك إن","يوما به أسدي سخر",46,"ر",1,0],["فالود يبقى ما العتاب مواصل","إن لا فما لك في الأنام خليل",47,"ل",1,0],["فَالوردُ من تيه يصاعرُ خدّه","مُستبدلاً دينارهُ بالدرهمِ",48,"م",1,0],["فَالوَحشُ في رَيعِها يَرعَينَ مُؤتَنِفاً","وَقَد تَكونُ بِهِ إِذ رَبعُها أَهِلُ",49,"ل",1,0],["فَالورد وَالمَنثور مَع ريحانها","خَدُّ الحَبيب وَثَغرهُ وَعذارُهُ",50,"ه",1,0],["فَأَلوَت بَغاياهُم بِنا وَتَباشَرَت","إِلى عُرضِ جَيشٍ غَيرَ أَن لَم يُكَتَّبِ",51,"ب",1,0],["فالوجْنةُ الوَرْدُ إلاّ في تَناوُلِها","والقامةُ الغُصْنُ إلاّ في تَثَنِّها",52,"ه",2,0],["فالوَرْدُ من أَغصانهِ بطَبْعِه","مُنتَشِرٌ لابُدَّ إن لم يُقْطَف",53,"ف",1,0],["فَأَلوِيَةٌ حُمرٌ مِنَ الطَعنِ في العِدى","وَفي اللَيلِ مِن نارٍ بِأَلوِيَةٍ حُمرِ",54,"ر",1,0],["فَالوَجه وَالعَينان عُن","وان الضَمير المُختَفي",55,"ف",2,0],["فالوَحش زادهم وَالمزن ماؤهم","تَحمَّلتهم فَأَغنَتهم عَنِ الأَدمِ",56,"م",1,0],["فالوَجهُ بَدرٌ وَالعَزيمَةُ صارِمٌ","وَالكَفُّ بر وَالبَنانُ بِحارُ",57,"ر",1,0],["فالوقت راقَ وقد راقت مَسَرَّتهُ","واليومَ أصبَحَ طيَّ الزهر منشورا",58,"ر",2,0],["فالواشي يعذلني والوجد يعذرني","والصَّبُّ غزال معذولاً ومعذورا",58,"ر",2,0],["فالوحش ما بين مذهول يصفده","يأس وآخر يعدو وهو حيران",59,"ن",1,0],["فالواحةِ الغرّاءِ أَحسن مطرح","تبدو لنا دخه بأَيمن غرةِ",60,"ه",1,0],["فالويل إن لم من الرحمن سابقةً","لي السلامة تنجيني من الوعث",61,"ث",1,0],["فألوف من تحت باريس تجري","والوف فوق ا