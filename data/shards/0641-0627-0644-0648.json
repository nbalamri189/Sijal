.aspx?id=184935",""],[5187,"زورق الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29708",""],[5213,"حي ربوعا بالعذيب درسا","https://www.poetsgate.com/ViewPoem.aspx?id=170491",""],[5277,"زهرةُ المورينگا...","https://www.poetsgate.com/ViewPoem.aspx?id=202272",""],[5324,"في يوم مولده الزكى.","https://www.poetsgate.com/ViewPoem.aspx?id=211137",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[5338,"نبهتني والكرى يطوي الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=187811",""],[5369,"قومي يا نؤوم","https://www.poetsgate.com/ViewPoem.aspx?id=177446",""],[5376,"عمَّ السماءَ فضائلٌ وسناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188367",""],[5397,"أترقد عين الصب والنجم يسهر","https://www.poetsgate.com/ViewPoem.aspx?id=157961",""],[709,"ضربوا القبابَ وطنّبوها بالقنا","https://www.poetsgate.com/ViewPoem.aspx?id=2906",""],[5565,"وساحِرِ المقلتين تحسَبُه","https://www.poetsgate.com/ViewPoem.aspx?id=110220",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5587,"عمر الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=196762",""],[5602,"معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=205107",""],[5628,"شمس الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=178541",""],[5704,"حُبٌّ وشِعْر","https://www.poetsgate.com/ViewPoem.aspx?id=191112",""],[5717,"وكم بدت للمصطفى معاجز","https://www.poetsgate.com/ViewPoem.aspx?id=170605",""],[5725,"عيناك يابغداد تسكنني","https://www.poetsgate.com/ViewPoem.aspx?id=181642",""],[5725,"رثاء الشيخ نوري صالح الاوحيد","https://www.poetsgate.com/ViewPoem.aspx?id=215669",""],[5736,"يا حادي الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=203923",""],[5736,"ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=208403",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""],[5853,"(((الوردة ُ الحمراء )))","https://www.poetsgate.com/ViewPoem.aspx?id=175662",""],[5858,"يوم التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=190523",""],[5906,"بِترا","https://www.poetsgate.com/ViewPoem.aspx?id=188068",""],[5957,"ولماذا اليأس يتناثر؟","https://www.poetsgate.com/ViewPoem.aspx?id=189869",""],[6069,"يا باكي الدار بكاظمةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105659",""],[6093,"وَرْدٌ يَتَفَلْسَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=192263",""],[6102,"وطن ولا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=182752",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""],[6124,"فسيفساء","https://www.poetsgate.com/ViewPoem.aspx?id=159786",""],[6134,"يا كامل الأوصاف يا سامي النهى","https://www.poetsgate.com/ViewPoem.aspx?id=169529",""],[6139,"قرة العين","https://www.poetsgate.com/ViewPoem.aspx?id=212332",""],[6144,"من يوم مابقينا بشناب","https://www.poetsgate.com/ViewPoem.aspx?id=21673",""],[5309,"أبكي على العلم والإخلاص في بلد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573835",""],[454,"إلى ربيع العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82650&r=&rc=14",""],[2157,"اليتيمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65148&r=&rc=0",""]],"verses":[["فَأَلواحُ أَمواهِها كالعَبيرِ","تُرى أَرضُها وَحَصاها الجُمانْ",0,"ن",1,0],["فالوِرْدُ إلا في ذَراكَ مُرَنَّقٌ","والظِّلُّ إلا في جَنابِكَ زائلُ",1,"ل",1,0],["فَالوجْهُ أبلَجُ واللّبَّاتُ واضِحةٌ","وفَرعُها وارِدٌ والمَتْنُ مَجدولُ",2,"ل",1,0],["فألوي زنود الحنان","على خصره الطيّع",3,"ع",1,0],["فَأَلوَت بِهِ طارَ مِنكَ الفُؤادُ","وَأَلفَيتَ حَيرانَ أَو مُستَحيرا",4,"ر",2,0],["فالوجه فيه من القرونة مسحةٌ","للخافيات بها وضوح مبهم",5,"م",1,0],["فَالوادِيانِ فَكُلُّ مَغنىً مِنهُمُ","وَعَلى المِياهِ مَحاضِرٌ وَخِيامُ",6,"م",1,0],["فالوجهُ منها جنة","وحَرُها جهنمُ",7,"م",1,0],["فَالوَيلُ لِلدُنيا إِذا نَفَضَ الكَرى","وَالوَيلُ لِلأَيّامِ إِمّا ثارا",8,"ر",2,0],["فَالوَصلُ أَجمَلُهُ ما كانَ بَعدَ نَوىً","وَالشَمسُ بَعدَ الدُجى أَشهى لِرائيها",9,"ي",3,0],["فالوُجُودُ الشقيُّ غيرُ جديرٍ","بالأَغاني وبالجمالِ الزَّاهي",10,"ي",1,0],["فَالوَرى في ضَلالِهِ مُتَمادٍ","يَفتُكُ الجَهلُ فيهِ وَالجُهَلاءُ",11,"ا",2,0],["فالوَيْلُ والنّارُ والثُّبُورُ لِمَنْ","قَدْ أَسْلَموهُ لِلْجَمْرِ واللّهَبِ",12,"ب",1,0],["فَالوَفرُ بِالنَصلِ يُستَفادُ إِذا","ضاقَت عَلى ذي بَصيرَةٍ مُدُنُه",13,"ن",2,0],["فالوجدُ يُظهِرُها إن رُحتُ أُكمِنُها","والدمعُ يَنشُرُها إن بِتُّ أَطويها",14,"ي",3,0],["فالوَرى في بَرْدِ آصا","لِكَ أو حَرِّ هَجيرِكْ",15,"ك",1,0],["فَالوَردُ وَجنَتُها وَالخَمرُ رِيقَتُها","وَضُوءُ بَهجَتِها أَضوا مِن القَمَرِ",16,"ر",1,0],["فالوَصْفُ يَبْقَى حُكْمُهُ مَع فَقْدِهِ","وَالمَرْءُ مَرْدُودٌ إذَا لَمْ يُفْقَدِ",17,"د",1,0],["فَالوَجهُ بَدرُ تَمامٍ","بِعَينِ ظَبيٍ فَلاةِ",18,"ه",1,0],["فَالوَيلُ لي كَيفَ أَنجو","مِن حُمرِ مَوتٍ وَسودِه",19,"د",2,0],["فَالوَيلُ لي مِن طِلابِ مُحتَبِسٍ","صِرتُ كَميناً لَهُ عَلى طُرُقِه",20,"ق",2,0],["فالوَجْدُ باقٍ والوِصَالُ مُماطلي","والصّبْرُ فانٍ واللّقاء مُسَوّفي",21,"ف",2,0],["فألْوَتْ بأعْناقٍ طِوالٍ وَراعَها","صَلاصِلُ بِيضٍ سابغٍ وسَنَوَّرِ",22,"ر",1,0],["فالوتدُ المَجموعُ منها فافْهمنْ","حركتانِ قبلَ حرفٍ قد سَكَنْ",23,"ن",1,0],["فَالْوُرْقُ تَهْتِفُ وَالرَّبارِبُ تَرْتَعِي","وَالْعِينُ تَبْغَمُ وَالبَلابِلُ تَصْرَأُ",24,"ر",2,0],["فألوت باعناق طوار وراعها","صلاصل بيض سابغ وسنورِ",25,"ر",1,0],["فالوعيُ بَغىٌ ، والتحرُّرُ سُبَّةٌ","والهَمْسُ جُرْمٌ ، والكلامُ حَرام",26,"م",1,0],["فالو وجها عن اللئام ودعهم","فلئام الورى خصوم الكرام",27,"م",1,0],["فالورد في لونه خد الحبيب إذا","قطفت قبلته يحمرٌّ خجلانا",28,"ن",2,0],["فالوصف يقصُرُ عن صفا","تِ نعيمهم والمائِدَهْ",29,"د",2,0],["فالوحشُ لا يأمَنُ من قانِصٍ","أو حابِل أو أسدٍ محتِضر",30,"ر",1,0],["فالورد من وجنة المعشوق صبغتُه","والطِّيبُ من نكهة المعشوق معلولُ",31,"ل",1,0],["فالوصل والهجر على ما جَنى","من وصفة الجنة والنارِ",32,"ر",1,0],["فالورد وجنته والخمر ريقته","وكأس فيه عقيق دره الحبب",33,"ب",1,0],["فَأُلوي بِهِ عَمّا يُقالُ وَما يُروى","كَأَنِّيَ أَخشى أَن أُطاوِعَ لائِمي",34,"ي",1,0],["فالورى شرٌ وهمٌ دائمٌ","وشقاءٌ ليس يَحكِيه شَقَاء",35,"ا",2,0],["فالوجد يفصل عنه منى مثلما","أني رأيت الصَّبر وَهو يَعُوزُ",36,"ز",1,0],["فالويل له إن لم ترحمْ","ونذير الموت له يمّمْ",37,"م",1,0],["فالورى اكثرهم الاك لم","يفرقوا بين زئير ونباح",38,"ح",1,0],["فالورى وجه به أنت حياً","وحياة الوجه إبقاء الحياء",39,"ا",2,0],["فالوردُ والحَبَبُ الطَّافي قد اجتَمَعا","كالثَّغرِ والريقِ من ذاتِ المساويك",40,"ك",1,0],["فالوردُ من خَدَّيكِ مَزهى لونُهُ","والنحلُ من شفتيكِ مَجنى شهده",41,"د",2,0],["فألوانُهُ في كلِّ قلبٍ ومُقلةٍ","ونجمتُهُ تهدي الضَّليلَ المحيَّرا",42,"ر",2,0],["فالوَجد أَوجدني اليك صَبابة","وَحشا الحشا شوقا يشق الاعظما",43,"م",2,0],["فَالوَجهُ كَالشَمسِ في لاذ المَغيبِ وَلا","أَقولُ كَالبَدرِ في لألاءِ إِشراقِه",44,"ق",2,0],["فَالوَردُ يُبدي صُرَرَ الحَريرِ قَد","فُتِحنَ عَن قُراضَةٍ مِن ذَهَبِ",45,"ب",1,0],["فالويل للأفاك إن","يوما به أسدي سخر",46,"ر",1,0],["فالود يبقى ما العتاب مواصل","إن لا فما لك في الأنام خليل",47,"ل",1,0],["فَالوردُ من تيه يصاعرُ خدّه","مُستبدلاً دينارهُ بالدرهمِ",48,"م",1,0],["فَالوَحشُ في رَيعِها يَرعَينَ مُؤتَنِفاً","وَقَد تَكونُ بِهِ إِذ رَبعُها أَهِلُ",49,"ل",1,0],["فَالورد وَالمَنثور مَع ريحانها","خَدُّ الحَبيب وَثَغرهُ وَعذارُهُ",50,"ه",1,0],["فَأَلوَت بَغاياهُم بِنا وَتَباشَرَت","إِلى عُرضِ جَيشٍ غَيرَ أَن لَم يُكَتَّبِ",51,"ب",1,0],["فالوجْنةُ الوَرْدُ إلاّ في تَناوُلِها","والقامةُ الغُصْنُ إلاّ في تَثَنِّها",52,"ه",2,0],["فالوَرْدُ من أَغصانهِ بطَبْعِه","مُنتَشِرٌ لابُدَّ إن لم يُقْطَف",53,"ف",1,0],["فَأَلوِيَةٌ حُمرٌ مِنَ الطَعنِ في العِدى","وَفي اللَيلِ مِن نارٍ بِأَلوِيَةٍ حُمرِ",54,"ر",1,0],["فَالوَجه وَالعَينان عُن","وان الضَمير المُختَفي",55,"ف",2,0],["فالوَحش زادهم وَالمزن ماؤهم","تَحمَّلتهم فَأَغنَتهم عَنِ الأَدمِ",56,"م",1,0],["فالوَجهُ بَدرٌ وَالعَزيمَةُ صارِمٌ","وَالكَفُّ بر وَالبَنانُ بِحارُ",57,"ر",1,0],["فالوقت راقَ وقد راقت مَسَرَّتهُ","واليومَ أصبَحَ طيَّ الزهر منشورا",58,"ر",2,0],["فالواشي يعذلني والوجد يعذرني","والصَّبُّ غزال معذولاً ومعذورا",58,"ر",2,0],["فالوحش ما بين مذهول يصفده","يأس وآخر يعدو وهو حيران",59,"ن",1,0],["فالواحةِ الغرّاءِ أَحسن مطرح","تبدو لنا دخه بأَيمن غرةِ",60,"ه",1,0],["فالويل إن لم من الرحمن سابقةً","لي السلامة تنجيني من الوعث",61,"ث",1,0],["فألوف من تحت باريس تجري","والوف فوق الهواء تجوس",62,"س",1,0],["فالوصل جنتنا ومأوى حبن","ونعيمنا والصد حسبي ناره",63,"ر",2,0],["فالورض ابدى بواكيراً مذبّحةً","تدعو لجمع اشتمال بعد تشتيت",64,"ت",1,0],["فالوردُ وردُ جورَ والبنفسجُ","بنفسجُ الكوفةِ حين يأْرَجُ",65,"ج",1,0],["فألوانُ القلوب إذا أديرت","تُناسِبها وألوانُ الحداقِ",66,"ق",1,0],["فالواهبُ العدلُ من كرَّت نوافلهُ","ودائمُ المدحِ ترديدٌ وتكريرُ",67,"ر",1,0],["فالواهب الرخْص يغني فقر سائله","والواضحُ الطَّلق تجلى عنده الظلم",68,"م",1,0],["فالوعر سهلٌ والجبالُ كثبٌ","والصعبُ هينٌ والبعيدُ أمَم",69,"م",1,0],["فالوجه طلق والسماح مفهم","والحكم عدل والمقال فيصل",70,"ل",1,0],["فالوجه يقرأُ والضُّحى","والفرعُ يتلو والغسقْ",71,"ق",1,0],["فَالوُدُّ لا تَبقى عَلَيكَ ظِلالُهُ","غِن لَم يَكُن لِلسِيِّئاتِ حَمولا",72,"ل",2,0],["فَالوَقتُ يُجلى فَحَثَّ السَيرَ مُجتَهِداً","عَساكَ تُدرِكُهُ في نَفسِ زينَتِهِ",73,"ت",2,0],["فَالوَقتُ إِن جِئتَهُ حَتى تُشاهِدُهُ","رَأَيتَهُ حَسَناً قَد عَمَّهُ الطَرَبُ",74,"ب",1,0],["فالوجدُ بعدَهمُ حبسٌ عليَّ كما","دمعي عقيبَ النوى في الربعِ منطلقُ",75,"ق",1,0],["فالوزن منكسرٌ والخفض منتصب","واللفظ غث ومعنى اللفظ منقلب",76,"ب",1,0],["فالوُرْقُ تُشفِقُ منه يُغرِقُها النّدى","فلِذاكَ نلجأُ في الغُصونِ لتأمَنا",77,"ن",2,0],["فالوفد ينعم في رياض نعيمه","وعدوه يشقى بشدة أسره",78,"ر",2,0],["فالويلُ فيما دَهاني","من نازلِ البُستانِ",79,"ن",1,0],["فالواجب الحق وجود وما","سواه غير العدم الممكن",80,"ن",1,0],["فالورى نائي ومقتربُ","ساكن حالي ومضطربُ",81,"ب",1,0],["فالوفا قد وجدته من لدنهمْ","ورجوت الكرام أطلب منهمْ",82,"م",1,0],["فالوجود الحق فرد واحد","وسواه كخيال في الكرى",83,"ر",2,0],["فالوَيلُ بينَ صباحِهِ ومَسائِهِ","والعَولُ بينَ مَسائِهِ وصَباحِهِ",84,"ح",2,0],["فالْوجْد لي وَحْديَ دونَ الْوَرَى","والملكُ للهِ وللظَّاهِر",85,"ر",1,0],["فالوجد يولع من في قلبه وله","والشوق يزعج قلباً بالغرام نما",86,"م",2,0],["فالوعر بات ممهدا ومنظما","بك والعسير مسهلا وميسرا",87,"ر",2,0],["فالوجه كالقمر المنير وكفها","مثل السحاب تسح منها الانعم",88,"م",1,0],["فالوَردُ والجُلَنارُ الغَضُّ وَجنَتُهُ","حُسناً وَأنمُلُهُ العُنّابُ والعَنَمُ",89,"م",1,0],["فالوَردُ سَلِّمَّ ذَرواناً وسُلمَ مِن","سِبطِ ابنِ حَمزَةَ عَبدِاللهِ ذَروانُ",90,"ن",1,0],["فالورق تشدو والنسيم مشبب","والنهر يسقي والحدائق تشرب",91,"ب",1,0],["فالوسامُ الخطير يهتزُّ فخراً","فوقَ صدر تزينهُ الأريحيه",92,"ي",2,0],["فالوردُ من أغراسها والطيب من","أَنفاسها واللطفُ من أسرارِها",93,"ر",3,0],["فالوَصف لَن يمثلك","لكل صَبّ يَشعُر",94,"ر",1,0],["فالوصل آن","وَقَد صَفا الوَقتُ وَراق الزَمان",95,"ن",1,0],["فالوردُ ممَّا ترى من حُسن صورته","من قبل يَذبُل في الأغصان يُقتَطف",96,"ف",1,0],["فَالورد مُنفَتِحاً عَلى أَغصانِهِ","مِثلُ النّجومِ تُضيُء جُنحَ الحِنْدسِ",97,"س",1,0],["فَالوَجدُ وَالذّلُّ وَالتّبريحُ تَشهدُ لي","وَالسّقمُ وَالدّمعُ وَالتّسهيد والكَلفُ",98,"ف",1,0],["فَالوَجهُ وَالصّدرُ ثمَّ الجيدُ بَينَهُما","شَمسانِ أَسفَرتا بِالحُسنِ في زَمنِ",99,"ن",1,0],["فالوجهُ منكم جنَّةٌ","رِضوانُها خالُ العَبير",100,"ر",1,0],["فالوعظ معْهم كلامٌ لا يُصاخُ إلى","مُبْديه والنصح معْهم غيرُ مسموعِ",101,"ع",1,0],["فالواو للعطف وما تعطفه","يتبع ما قبل بحكم العاملِ",102,"ل",1,0],["فالورد في الخد والعُنَّاب في اليد والر","مان في الصدر والسوسان في الوسطِ",103,"ط",1,0],["فَالوَصلُ مُتَّصِلٌ وَالصَّدُّ مُنفَصِلٌ","وَالوَقتُ مُبتَسِمٌ عن ثَغرِ مَسرُورِ",104,"ر",1,0],["فالوعد نقد والوعي","د نسيئة والعهد عقدُ",105,"د",1,0],["فالورد غض خجل ولندى","في مقل النرجس قد حارا",106,"ر",2,0],["فالورد أعذب والحِجاب مسهل","والوجه طلقُ والعطاء جزيلُ",107,"ل",1,0],["فَالْوِ عَنْ قَوْلِ حَاسِدِيَّ فَإنِّي","لَمْ أطِعْ فِي هَوَاكَ قَوْلَ حَسُودِ",108,"د",1,0],["فَالورد منها ليسَ يذبلُ زهرهُ","أبداً ولا التفّاحُ منها يقطفُ",109,"ف",1,0],["فَالوجهُ مثلُ الصبحِ منها أبيضٌ","وَالفرع مثلُ الليلِ منها أسودُ",110,"د",1,0],["فالوردُ عند الجُعل نش","رُ أريجهِ لم يحمدِ",111,"د",1,0],["فالوجد مني لا يفنى تضرمه","عليهم أبداً والدمع لم يخن",112,"ن",1,0],["فالويل منها للفرنج","فقد لقوا جهد البلية",113,"ي",2,0],["فالوَجْدُ لا يُعرَضُ في ساحَتي","لِلْبَيْعِ وَالسُّلوانُ لا يُشْتَرى",114,"ر",2,0],["فالوالدين حنانهم يا سيدي","من ذنب نسلهم يزول ويفقد",115,"د",1,0],["فالوعد والسعد للراقي منازلها","وا