{"poems":[[48,"كن وشيكا في حاجة أو مكيثا","https://www.aldiwan.net/poem23260.html","الخفيف"],[408,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38170","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77623","الرجز"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93824","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107514","الكامل"]],"verses":[["إِذ ثُرَيّا النُجومِ تُسمى بِثَروى","وَسُهَيلُ السَماءِ يُدعى بِسَهلِ",0,"ل",1,0],["إذْ ثَنَتْ نحونا الأزمّة بالأحباب","مَنَّاً مِنْها علينا وفَضْلا",1,"ل",2,0],["إِذ ثَمَّ يافاءُ الّتي قَد وَدَّها","فَلَكاً لَهُ بَدرُ الدُّجى والفرقَدُ",2,"د",1,0],["إِذ ثارَ عَقد النَقع وَالتُرابِ","بِالبُعد تَحتَ أَرجُل الكِلابِ",3,"ب",1,0],["إذ ثم مكتشفاتهم والدين لا","ينفي حقائقها لدي العقلاء",4,"ا",2,0],["إذ ثغر أزهار الربا","متبسم لبكا الغمام",5,"م",1,0],["إذ ثار ثائرهم على","استبدادِ فردٍ قد ظلَم",6,"م",1,0]]}