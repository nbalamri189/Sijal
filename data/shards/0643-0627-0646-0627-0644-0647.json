{"poems":[[57,"بكيت الدموع فلما انقضت","https://www.aldiwan.net/poem26163.html","المتقارب"],[36,"إذا ذكرت لبنى تجلتك زفرة","https://www.aldiwan.net/poem4919.html","الطويل"],[79,"أنعام أرضك تقهر الآسادا","https://www.aldiwan.net/poem36557.html","الكامل"],[90,"شكاية قلب بالأسى نابض العرق","https://www.aldiwan.net/poem44834.html","الطويل"],[91,"ذهب الشباب وكل شيء طيب","https://www.aldiwan.net/poem44778.html","الكامل"],[45,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[47,"ما للكبير في الغواني من أرب","https://www.aldiwan.net/poem10669.html","الرجز"],[30,"يا ابن المراغة والهجاء إذا التقت","https://www.aldiwan.net/poem5645.html","الكامل"],[63,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[77,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147508","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[108,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[159,"كأن الهلال إذا ما بدا","https://www.aldiwan.net/poem55603.html","المتقارب"],[159,"كأن الهلال وقد أسرعت","https://www.aldiwan.net/poem55725.html","المتقارب"],[203,"مكانك يا بدر وإن كنت واشيا","https://www.aldiwan.net/poem45229.html","الطويل"],[203,"عجبت لأهل الهوى أنهم","https://www.aldiwan.net/poem45231.html","المتقارب"],[203,"أبيت وجنبي ليس يحويه مضجع","https://www.aldiwan.net/poem45232.html","الطويل"],[208,"وتفاحة من سوسن صيغ نصفها","https://www.aldiwan.net/poem53214.html","الطويل"],[215,"يا ليل يا ليلى يا ليل","https://www.aldiwan.net/poem46606.html","المواليا"],[237,"هيجت وجدي يا نسيم الصبا","https://www.aldiwan.net/poem14742.html","السريع"],[266,"أراحمة قلبي وقد شفني الصبر","https://www.aldiwan.net/poem38281.html","الطويل"],[287,"وقالوا غدا يوم النوى قلت هددوا","https://www.aldiwan.net/poem32298.html","الطويل"],[369,"تظلم من طرف ظبي رخييم","https://www.aldiwan.net/poem60647.html","المتقارب"],[371,"أما المشيب فإنه قد أبرقا","https://www.aldiwan.net/poem17717.html","الكامل"],[376,"حتى متى كل مشتك زاجر","https://www.aldiwan.net/poem57427.html","المنسرح"],[447,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[463,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[482,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[500,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63872","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37820","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62484","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[999,"","https://poetry.dctabudhabi.ae/diwan/poem/143592","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138128",""],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202101","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65074","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64717","البسيط"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117618","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109073","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122019","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121987","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108694","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100974","الوافر"],[1977,"","https://poetry.dctabudhabi.ae/diwan/poem/146995","الطويل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198480","الكامل"],[2389,"","https://poetry.dctabudhabi.ae/diwan/poem/146454","الطويل"],[2512,"","https://poetry.dctabudhabi.ae/diwan/poem/203820","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200793","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202721","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199909","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103508","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132570","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100859","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100737","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62966","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103822","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48314","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86256","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92277","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91447","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117846","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86390","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90829","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90808","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120484","الوافر"],[5163,"تكلمت بلسان حالي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=33947",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5431,"كأنّ الهوى قد كان محض خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=187413",""],[5525,"مداوي الجرح بجراح","https://www.poetsgate.com/ViewPoem.aspx?id=7268",""],[5596,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=205612",""],[5784,"هدية لشاعر واهم غيبه النسيان ..... !؟","https://www.poetsgate.com/ViewPoem.aspx?id=190687",""],[6045,"شباب الحلوة","https://www.poetsgate.com/ViewPoem.aspx?id=123996",""],[6082,"لست مهتما","https://www.poetsgate.com/ViewPoem.aspx?id=59821",""],[6082,"لطفا كفى","https://www.poetsgate.com/ViewPoem.aspx?id=60250",""],[6108,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192747",""],[6125,"كان الهجير وبعض الوصل ما كانا","https://www.poetsgate.com/ViewPoem.aspx?id=210895",""],[6147,"حنين..","https://www.poetsgate.com/ViewPoem.aspx?id=151509",""],[5309,"يقولون لي بادر الى خدمة الوطن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573930",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""]],"verses":[["كَأَنَّ الهَوى لَم يَجِد لِلبَلا","ءِ في صَدرِ غَيري لَهُ مَدَخَلا",0,"ل",2,0],["كَأَنَّ الهَوى بَينَ الحَيازيمِ وَالحَشا","وَبَينَ التَراقي وَاللُهاتَ حَريقُ",1,"ق",1,0],["كانَ الهِزَبْرُ مُحارِباً فجَزَيْتَهُ","بجَزاءِ مَنْ في الأرْضِ رامَ فَسادا",2,"د",2,0],["كأنّا لهم شاءٌ فهم يحلبوننا","وكم مَخضُوا أوطاننا مخضة الزق",3,"ق",1,0],["كان الهوى في مهد قلبي خافيا","فشدوت اوقظه بلحن مطرب",4,"ب",1,0],["كَأَنَّ الهامَ في الهَيجا عُيونٌ","وَقَد طُبِعَت سُيوفُكَ مِن رُقادِ",5,"د",1,0],["كانَ الهوى خِدني فَقَد وَدَّعتُهُ","وَقَلَّما يَعودُ شَيءٌ قَد ذَهَب",6,"ب",1,0],["كانَ الهُذَيلُ يَقودُ كُلَّ طِمِرَّةٍ","دَهماءَ مُقرَبَةٍ وَكُلَّ حِصانِ",7,"ن",1,0],["كانَ الهَوى صُبحاً بليلِ شَبابه","فدَجَى بإِصباحِ المَشيبِ وأظلَما",8,"م",2,0],["كأنّ الهَزيعَ الآبنُوسيَّ لونُهُ","سَرَى بالنسيج الخُسرُوانيِّ مُلتفّا",9,"ف",2,0],["كأنّ الهدى لم يكن كائناً","إلى أنْ دُعيتَ مُعِزَّ الهُدى",10,"ا",1,0],["كأن إله الشرِّ يقتحم الورى","أو أن الردى في برده الرثِّ زاحفُ",11,"ف",1,0],["كأنَّ الهوى صُنْعُ أيديهمُ","فمن غيرهم كلُّ عيشٍ مُحَالْ",12,"ل",1,0],["كان الهدى يهدى إلى قلبه","من سمعه لو أنه يهتدي",13,"د",2,0],["كأنّ الهمّ ضيفك فهو يلقى","على القسمات بشرا وارتياحا",14,"ح",2,0],["كان الهُتافُ لمصرَ كلَّ أنينِه","فوق الفراش، وكان بعضَ دوائه",15,"ا",3,0],["كأنا لهذ الأرض دين ودأبها","غريم على كثر الوفا يتظلم",16,"م",1,0],["كأَنَّ الهِلالَ إِذا ما بَدَا","وَأَيْدي المِحاقِ بِهِ تَمْحَقُ",17,"ق",1,1],["كأنَّ الهِلالَ وَقَدْ أَسْرَعَتْ","يَدُ البَيْنِ في فَرْطِ إِنفادِهِ",18,"د",2,1],["كأنَّ الهوى قد خُطّ قبل وجودنا","كتاباً على ما يلبثُ الكونُ باقيا",19,"ي",2,0],["كأنَّ الهمومَ بانفاسهم","تكونُ ويا حرَّ أنفاسهمْ",20,"م",1,0],["كأنَّ الهوى نورٌ كأنَّ بني الهوى","كواكبٌ إمَّا جنَّها الليلُ تلمعُ",21,"ع",1,0],["كأنَّ الهوى قد ضَمَّ من بعد فرقةٍ","بها خدَّ معشوقٍ إلى خدِّ عاشقِ",22,"ق",1,0],["كان الهوى بغداد","أوّاهُ من بغداد",23,"د",1,0],["كان الهوى باريس","آوّاه من باريس",23,"س",1,0],["كانَ الهَوى حَيثُ النَقا منزِلُ","يَجمَعُنا وَالعَصرُ عَصرُ الصِبا",24,"ب",2,0],["كأن الهلال المستدير حنية","من العاج يرمينا بأسهمها الدهر",25,"ر",1,0],["كَأَنَّ الهَوى بِالعِشقِ جَرَّدَ مَركَباً","فَمُذ جاءَني أَلقى بِقَلبي المَراسِيا",26,"ي",2,0],["كأنّ الهلالَ يُشيرُ أَمامَ","حُسامِ الورَى كسوارٍ فَصيم",27,"م",1,0],["كانَ الهَوى خِلَّ الصِبا وَصَديقَهُ","حَتّى تَلا شَيبيوَإَن يَتَفَرَّقا",28,"ق",2,0],["كان الهَوى سنةً مؤكَّدةً","شاهدُها قائمٌ بها حاضِر",29,"ر",1,0],["كان الهدى بعمان ثمت أَصبحت","من بعده في حندس الظلماء",30,"ا",2,0],["كأن الهلالَ بين جنبيه طالعٌ","ورصعَ الحُلَى من جانبيه نُجومُ",31,"م",1,0],["كان الهوى والشبابُ نِعْم القري","نان وكان الشبابُ خيرَهما",32,"م",2,0],["كان الهوى سكرانَ تنظر عينُه","حتى صحا فرأى بقلبِ مفيقِ",33,"ق",1,0],["كأنَّ الهوى إلى عليه أَليَّةً","بأنْ لا أَرى لي منه ماعشتُ مِن بُدِّ",34,"د",1,0],["كأن ألهمت فضل الذي باسمه جرت","فسارت وما غير الرؤوس لها رجل",35,"ل",1,0],["كان الهوى بالرَّقتين فبعتُهُ","حلباً على سْومٍ به ومِكاس",36,"س",1,0],["كَأنَّ الهَوى نارٌ وَمِنها تصوّرت","عِظامي وَأَعضائي وَروحي مَعَ النَّفسِ",37,"س",1,0],["كأنَّ إله الخلق صاغ لجسمه","من التبر جلداً تجتليه المجاسدُ",38,"د",1,0],["كأن إله الخلق صوَّر ذاتَه","من الفضل والحال الجميل كساها",39,"ا",3,0],["كأنّ الهوى والوجْد حقاً سِنانه","فما حَلّ إلا في فؤادٍ مُحجَّبِ",40,"ب",1,0],["كأن الهوى العذرىَّ عارٌ مبغضٌ","اليه وداء في الحياة وبيل",41,"ل",1,0],["كان الهدى خَبَرا لنا حتى بدا","ميمون طلعته فقام عِيانُه",42,"ن",2,0],["كَأَنَّ الهِلالَ هلال السَّماءِ","وقد لاحَ في قُمُصٍ مِنْ سَوادِ",43,"د",1,1],["كانَ الهُدَى مُجمَلاً فينا فغادَرهُ","مُفَصِّلاً عِلْمَهُ تفصيلَ إِيضاحِ",44,"ح",1,0],["كأن الهم مشغوفٌ بقلبي","فساعةَ هجرها يجد الوصالا",45,"ل",2,0],["كان الهصور وقد تحوَّل نعجة","كان العقاب وقد تحوَّل بلبلا",46,"ل",2,0],["كَأَنَّ الْهَوَى جُودُ الخَلِيفَةِ فَارِسٍ","إِذَا قِيلَ عَمَّ الْخَلْقَ طُرّاً تَزَيَّدَا",47,"د",2,0],["كَأَنَّ الْهَوَى فَرْضٌ عَلَى كُلِّ مَادِحٍ","فَتَارِكُهُ عَمْداً يُذَمُّ وَيُشْنَأُ",48,"ا",1,0],["كأن إله العرش قال لخلقه","دعوا كل شيءٍ جانباً واقصدوا خيري",49,"ر",2,0],["كأن الهول عندك لهولاهٍ","وصدق البأس في الجلى مزاح",50,"ح",1,0],["كأن الهلال المستنير وقد بدا","ونجم الثريا واقف فوق هالته",51,"ه",1,1],["كانَ الهُدى والكَوْنُ في ظُلُماتِهِ","كانَ السَّنى والكَوْنُ فِي النِسْيانِ",52,"ن",1,0],["كأنَّ الهوَى حتمٌ علينا مُقدَّرٌ","فلا مهجةٌ إلاَّ تذوب له شَجْوا",53,"و",2,0],["كأن الهلال له والد","وشمس النهار له والده",54,"د",2,0],["كأنّ إله العالمين أتى بنا","لنشهد فصل الهزل ثم نعود",55,"د",1,0],["كأن الهواء رقيبٌ عليّ","فأصخبُ في وجهه مغضَبا",56,"ب",2,0],["كأن إلهي قد برانيَ مرشدا","فمالي اني سرتُ إلاي مرشدُ",57,"د",1,0],["كَأَنَّ الهَديلَ الظالِعَ الرِجلِ وَسطَها","مِنَ البَغى شِرّيبٌ يُغَرِّدُ مُتَرَفُ",58,"ف",1,0],["كأن آله الخلقِ أَصافهُ رِقَّةً","وَحَكَّمَهُ في نَفسِهِ فتحَكَّما",59,"م",2,0],["كان الهدى بابي المهدي يعتضد","فأين ساعد دين الله والعضد",60,"د",1,1],["كأن الهوى نار فؤادي فراشها","اذ ما ذكت طار الفؤاد المعذب",61,"ب",1,0],["كأن الهوى جمر يسعره القلى","وتلك القلوب الذائبات مجامره",62,"ر",2,0],["كأَن اِلهَ الناسِ صورَ خلقَه","وخيرها فاختارت البخلَ والحُسنَا",63,"ن",2,0],["كأنَّ الهوى ضيفٌ ألمَّ بمهجتي","فَلحمي طعامٌ والنجيعُ شرابُ",64,"ب",1,0],["كأنّ الهِلالَ على أدْهمٍ","من الليلِ سرْجٌ وقدْ فُضِّضا",65,"ض",2,0],["كأن اله العَرش اذ رامَ خقهُ","من اللُطف سِواه فَسُبحان ذا الباري",66,"ر",2,0],["كأن الهَوى خمرٌ وأني شاربٌ","يطوف به ساق من الحسن كاملُ",67,"ل",1,0],["كانّ الهَوى خَمرٌ وَحسنَك كَأسُ