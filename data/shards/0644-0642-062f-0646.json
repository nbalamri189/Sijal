ن خُبثِ نَفسِهم","ألاَ إنَّ خُبثَ النفسِ داؤُه لن يَبرا",159,"ر",2,0],["لقد نالَ العِدا مِنَّا مُنَاهُم","إذا ما صُدِّقَ الكذِبُ الصُّرَاحُ",160,"ح",1,0],["لَقَد نالَ فَخرُ الملكِ مِن قُلَلِ العُلا","مَواطنَ شطّت عَن فَصيحٍ وأعجمِ",161,"م",1,0],["لَقَد نَمَتنِي من قريشٍ فِتيَةٌ","ليسوا كمن تعهد في الفضائلِ",162,"ل",1,0],["لقد نال فخرُ الملك ما شاءَ من عُلاً","حَلَلْنَ على أعلى محلٍّ من السُّحْبِ",163,"ب",1,0],["لقد نظرت قومٌ بطرف لهم قذِي","فلم يشهدوا إلا حجاب جمال ذي",164,"ي",1,1],["لقد نسجت لها الأرواح منا","شرانقَ جسمنا فالروحُ دوده",165,"د",2,0],["لقد ناحَت رُبَى لُبنانَ حُزناً","على مَن كانَ في يدِهِ الزِّمامُ",166,"م",1,1],["لقد نُعِيَ الخليلُ صباحَ يومٍ","بهِ كَثُرَ التَّلهُّفُ والعَويلُ",167,"ل",1,0],["لقد نزلَ الشَّريفُ على شريفٍ","فأكرِمْ بالمَنازِلِ والنَّزِيلِ",168,"ل",1,0],["لَقَدْ نَشِطَتْ لِعِنَادِ الرَّسُولِ","رِجَالٌ بِهَا عَنْ هُدَاهَا كَسَلْ",169,"ل",1,0],["لقد نهى وقدم الأعذارا","من كان أعطى زوجه قنطارا",170,"ر",2,0],["لقد نُصِر الإِسلامُ منكَ بناصرٍ","يرى مغْنماً في الدِّين ما كان مَغْرَما",171,"م",2,0],["لقد نُسخَتْ من بعدمَا مُسِختْ له","ملوكٌ به آسادُها تَتَثَعْلبُ",172,"ب",1,0],["لقد نصحت دعاوى العشق قوماً","يظنّون البَلا في الحبِّ سهلا",173,"ل",2,0],["لَقَدْ نَوَى العَاذِلُ المُسيءُ بِنا","بِظاهِرِ النُّصْحِ وبَاطِنِ الحَسَدِ",174,"د",1,0],["لَقَدْ نَشَطَتْ لَوَاحِظُهُ لِقَتْلِي","بِعَزْمٍ وَهي تُوصَفُ بِالفُتُورِ",175,"ر",1,0],["لقد نَصرَ اللّهُ جَيْشَ الملاحِ","بِبدْرٍ لنا حُسْنُه قَدْ كَملْ",176,"ل",1,0]]}