ُ كَالزَهرِ بِالطَّلِّ يُمطِرُ",109,"ر",1,1],["لقد نطقتْ فينا الليالي فأَفْصحتْ","بوعظٍ لوَ أنّ الوعظَ للمرءِ نافع",110,"ع",1,0],["لقد نَظمتْ محاسنَك الليالي","كما نُظم الزمرد والجُمان",111,"ن",1,0],["لقد نعمت بنو شيبان دهرا","براذان وطال بها النعيم",112,"م",1,0],["لقد نالني في المال والعرض سبة","وان لم انل مالي فيا ضيعة العمر",113,"ر",1,0],["لَقَد نَدمَت لكِن سَتَرجِع إِنَّني","لَمحتُ عَلَيها مِن نَدامَتِها طَمرا",114,"ر",2,0],["لقد نَطق العودُ عن سِّره","فغادر كلَّ صحيح كئيبُ",115,"ب",1,1],["لَقَد ناطَ نورُ الدينِ مِنكَ أُمورَهُ","بِأَغلَبَ شَثنِ الكَفِّ ذي ساعِدٍ عَبلِ",116,"ل",1,0],["لقد نفَّست كَربي وسرَّت كآبتي","رخيمةُ صوتٍ حلوةُ الرَنوات",117,"ت",1,0],["لقد نظموا عقداً ثميناً فأصبحت","لآلئُ ذاكَ العقدِ مُنتَثرات",118,"ت",1,0],["لَقَد نابَ عني كل أَمر أَخافه","فَلَم أَخشَ أَمرا لِلزَمان يَنوب",119,"ب",1,0],["لَقَد نزلت منيبربيع رَبيعة","تَرامى عيون العبر في كل مقتل",120,"ل",1,0],["لَقَدْ نَصَحَ الدَّهْرُ مَنْ غَرَّهُ","فَحَتّامَ يُتَّهَمُ النّاصِحُ",121,"ح",1,0],["لَقَد نَظَرَت عَنزٌ إِلى الجَزعِ نَظرَةً","إِلى مِثلِ مَوجِ المُفعَمِ المُتَلاطِمِ",122,"م",1,1],["لَقَد نعمتُ بِوَعدٍ منك مُنتَظَرٍ","وَنائِلٍ مِن نظامِ الدين مَقضيِّ",123,"ي",1,0],["لَقَد نوديتَ لِلترحالِ فَاِسمَع","وَلا تَتَصامَمَنَّ عَنِ المُنادي",124,"د",2,0],["لَقَدْ نَسِيَتْ عَهْدِى أُناسٌ تَبدَّلُوا","وَقَدْ بَدَلُّوا عَذْباً حَلا بأُجَاجِ",125,"ج",1,1],["لَقَد نَزَلَت بي وَحشَةٌ بَعدَ أُنسِكُم","عَلَيَّ بِها ضاقَ الفَضى وَهوَ واسِعُ",126,"ع",1,0],["لقد نعمت فيه غزاة نسورنا","وسمعت الذؤبان قصفاً على قصف",127,"ف",1,0],["لَقَد نَشَبَت مَخالبها المَنايا","بِهِ فَرأى الحَياة مِن الغُرورِ",128,"ر",1,0],["لقد نامت عيون البين عنا","ليالينا بها فالوصل دان",129,"ن",1,0],["لقد نام بيضُ الهندِ أمْناً فما يُرَى","لَهُنَّ غِرارٌ هاجراً لجُفون",130,"ن",1,0],["لقد نثَرتُ سهامي من كِنانتِها","أَرمِي عِداكَ وقد وَتّرْتُ أقواسي",131,"ي",1,0],["لقد نِلْتَ بالأقلامِ ما يُعجِزُ القَنا","وبالرَّأْيِ ما يَعْيا بهِ العَسكَرُ المَجْر",132,"ر",1,0],["لَقَد نَبَذَ الهَمُّ السَوادَ بِخاطِري","كَما حَصَّلَ الهَمُّ البَي