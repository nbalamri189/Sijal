 شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[575,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[585,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""],[586,"فضحت جيد الغزال بالجيد","https://www.aldiwan.net/poem17492.html","المنسرح"],[586,"أما وتمايل الغصن النضير","https://www.aldiwan.net/poem17536.html","الوافر"],[586,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["لَقَد نالَ مِن عِزِّكَ الأَبعَدونَ","وَقَرَّبَ مِن شَأنِهِ غَيرُ شاني",0,"ي",1,0],["لَقَد نَطَحَ الجَدُّ أَعداءَهُم","بِرَأسٍ جَموحٍ وَرَوقٍ طُوالِ",1,"ل",1,0],["لَقَد نالَ شَكواكَ مِن مُهجَتي","كَما نالَ مِن عِرقِكَ المِبضَعُ",2,"ع",1,0],["لَقَد نَهَيتُكُمُ عَنها وَقُلتُ لَكُم","فيها مَقالَ شَفيقِ القَولِ مُجتَهِدِ",3,"د",1,0],["لَقَد نادى الغُرابُ بِبَينِ لُبنى","فَطارَ القَلبُ مِن حَذَرِ الغُرابِ",4,"ب",1,1],["لَقَدْ نَشَاَتْ عِنْدِي لِلُقِيَاكَ غِبْطَةٌ","تُنَسِّي اغْتِبَاطِي بِالِشِّيْبةِ وَاْلأَهْلِ",5,"ل",1,0],["لَقَد نَسَجَ العَفافُ لَها رِداءً","وَزانَ رِداءَها الخِدرُ المَصونُ",6,"ن",1,0],["لَقَد نَزَحتَ عَنِ الدُنيا كَما نَزَحَت","عَنها لَياليكَ مِن بيضٍ وَمِن سودِ",7,"د",1,0],["لَقَد نَصَلَ الدُجى فَمَتى تَنامُ","أَهَمٌّ ذادَ نَومَكَ أَم هُيامُ",8,"م",1,1],["لَقَد نَعى اِبنُ نَهيكٍ لي أَخا ثِقَةٍ","كانَت تُرَجَّمُ عَنهُ قَبلُ أَخبارُ",9,"ر",1,0],["لَقَد نامَ عَن لَيلى لَقيطٌ وَشاقَني","مِنَ البَرقِ عُلويُّ السَنا مُتياسِرُ",10,"ر",1,0],["لقد نجحت نجاحاً لا يفوز به","من خالق الحزم إلا حازم الخلق",11,"ق",1,0],["لقد نقدوا قريضك نقد أعمى","يدُلّ على الضغائن في المطاوي",12,"ي",1,0],["لقد نزل القضاء بكم أليماً","ولا منجاة إن نزل القضاء",13,"ا",2,0],["لقد ناح العراق عليك حزناً","وضجّ من الخليج إلى دهوك",14,"ك",1,0],["لقد نُزَهت من غمز ولمز","كما نزّهت من شعر ركيك",14,"ك",1,0],["لَقَد نامَ الخَلِيُّ وَطالَ لَيلي","بِحُبِّكَ ما أَبيتُ لَهُ اِنتِحابا",15,"ب",2,0],["لَقَد نَذَرَت جَدعَ الفَرَزدَقِ جَعفَرٌ","إِذا حُزَّ أَنفُ القَينِ حَلَّت نُذورُها",16,"ر",3,0],["لَقَد نادى أَميرُكَ بِاِبتِكارِ","وَلَم يَلوُوا عَلَيكِ وَلَم تُزاري",17,"ر",2,1],["لَقَد نَفَحَت مِنكَ الوَريدَينِ عِلجَةٌ","خَبيثَةُ ريحِ المِنخَرَينِ قَبوعُ",18,"ع",1,0],["لَقَد نادى أَميرُكَ بِاِحتِمالِ","وَصَدَّعَ نِيَّةَ الأَنَسِ الحِلالِ",19,"ل",1,1],["لَقَد نَزَلَ الفَرَزدَقُ دارَ سَعدٍ","لَيالِيَ لا يَعِفُّ وَلا يُحامي",20,"م",2,0],["لَقَد نَمَتنا لَهُم أُصولٌ","مامَسَّ أَعراقَهُنَّ لومُ",21,"م",1,0],["لَقَد نافَسَني الدَهرُ","بِتَأخيري عَنِ الحَضَرَه",22,"ه",1,1],["لَقَد نَزَلَت مِنهُ عَلى أَهلِ يَثرِبٍ","رِكابُ هُدىً حَلَّت عَلَيهِم بِأَسعَدِ",23,"د",1,0],["لقد نهضت علياهُ نهضة ماجدٍ","قصيّ مداهُ فائضات مدُودُه",24,"د",2,0],["لقد نفَّر الحسناء شيبي فأصبحت","على كبري بعد الوداد تكبر",25,"ر",1,1],["لقدْ نَالَ مَنْهاةَ العَلاَءِ وإنَّه","بأنَّ ابْنَهُ مِثْلَ العَلاءِ لأسْعَدُ",26,"د",1,0],["لقد نعيتَ امرَأً ظلَّتْ لِمَصْرَعِهِ","قواعدُ الدين والدنيا على خطر",27,"ر",1,0],["لقد نعيتَ امرأً لم تَحْيَ مَكْرُمَةٌ","إلا به وبه سارت إلى الحفَر",27,"ر",1,0],["لقد نعيتَ امرأً ما كنتُ أحسَبُه","ينعاهُ إلا هُوِيُّ الشمس والقمر",27,"ر",1,0],["لقد نَصَّهُ اللَّهُ في مَنْصبٍ","سليمٍ من الذامِ والذائمِ",28,"م",1,0],["لَقَد نَزَلتُ بِعَبدِ اللَهِ مَنزِلَةً","فيها عَنِ الفَقرِ مَنجاةٌ وَمُنتَفَدُ",29,"د",1,0],["لَقَد نَكَبَ الشَرقَ نَكَباتِهِ","وَحاوَلَ أَن يَنكِبَ المَغرِبا",30,"ب",2,0],["لَقَد نَقَلَ الوُشاةُ إِلَيكَ زوراً","وَنالوا مِنكَ قَصدُهُم وَمِنّي",31,"ن",2,0],["لَقَد نَقَلَ الواشونَ عَنِّيَ باطِلاً","وَمِلتُ لِما قالوا فَزادوا وَأَسرَفوا",32,"ف",3,0],["لقدْ نامَ أَهلُ العِلْم نوماً مغنطَساً","فلمْ يسمعوا مَا رَدَّدَتْهُ العوالِمُ",33,"م",1,1],["لقد نال من اخوانه الغريونس","حفاء الى ان قال مكتفياً حسبي",34,"ب",2,0],["لقد نظرت فما ان","اغنتني النظرات",35,"ت",1,0],["لقد نشرت قوانينا موقتة","ولم تولِّ الذي يُجرى القوانينا",36,"ن",2,0],["لقد نقض الأيام بالعجم مِرّتي","ومرُّ الليالي يَتبّعن اللياليا",37,"ي",2,0],["لقد نسبوني للضلال لأنني","مخالفهم فيما أقول وأكتب",38,"ب",1,0],["لقد نقل الراوون عني حكاية","وقالوا كلاما ما أشدّ وأشاما",39,"م",2,1],["لقد نهلت كفى وعلت بكأسها","مرارا وصدرى لا يُبلّ له صدى",40,"د",2,0],["لَقَد نَسّاهُ يَومُكَ ناصِباتٍ","مِنَ السَنَواتِ قاساها تِباعا",41,"ع",2,0],["لَقَد نَسِيَ القَومُ أَمسِ القَريبَ","فَهَل لِأَحاديثِهِ مِن مُعيد",42,"د",1,0],["لَقَد نَسَبوا الخِيامَ إِلى عَلاءِ","أَبَيتُ قَبولَهُ كُلَّ الإِباءِ",43,"ا",2,1],["لَقَد نُصِرَ الإِمامُ عَلى الأَعادي","وَأَضحى المُلكُ مَوطودَ العِمادِ",44,"د",1,1],["لَقَد نُصِرَت راياتُكَ الصُفرُ إِذ قَنا","بِما اِحمَرَّ مِن لَونِ الدِماءِ جَسيدُها",45,"د",3,0],["لَقَد نافَستَ في الإِحسانِ حَتّى اِن","فَرَدتَ بِكُلِّ مَأثُرَةٍ وَفَخرِ",46,"ر",1,0],["لَقَد نَطَقَ البَشيرُ بِما اِبتَهَجنا","لَهُ لَو كانَ يَصدُقُنا البَشيرُ",47,"ر",1,0],["لَقَد نَوَّهتَ بي شَرقاً وَغَرباً","وَقَد خَوَّلتَني جاهاً وَمالا",48,"ل",2,0],["لَقَد نُصِرَت وَالنَصرُ أَولى حُقوقِها","جُيوشُ أَبي الجَيشِ الحِدادَ مَناصِلُه",49,"ل",2,0],["لقد نزعت من عقد ثغرك درة","وما ذاك إلا أنها شانت العقدا",50,"د",2,1],["لقد نثرتُ على قومٍ حصىَ كِلَمٍ","لو شِئتَ لانْتَثَرَتْ فيكم كواكبُه",51,"ب",2,0],["لَقَد نَصَرا في اللَهِ دينَ مُحَمَدٍ","عَلى مَن بَغى في الدينِ قَد رَعَيا إِلّا",52,"ل",2,0],["لَقَد نَسيتُ وَكَأسُ المَوتِ دائِرَةٌ","في كَفِّ لا غافِلٍ عَنها وَلا ناسِ",53,"س",1,0],["لَقَد نَشَرَ الإِلَهُ عَلَيكَ نوراً","وَحَفَّكَ بِالمَلائِكَةِ الكِرامِ",54,"م",1,0],["لَقَد نِلتُ إِذ نادَمتُهُ مِن حَديثِهِ","مِنَ السُكرِ ما لا نُلتُهُ مِن عَقيقِهِ",55,"ق",2,0],["لَقَد نَصَلَ الدَهرُ صَبغَ الشَبابِ","وَصَبغُ المَحَبَّةِ لَم يَنصُلِ",56,"ل",1,0],["لَقَد نَزَّهَت قَدري عَنِ الشِعرِ أُمَّةٌ","وَلامَ عَلَيهِ مَعشَري وَبَنو أَبي",57,"ب",2,1],["لَقَد نَهَضتَ بِعِبءِ الملكِ مُضطلعاً","به ظهيراكَ فيه السّعْدُ والقدرُ",58,"ر",1,0],["لَقَد نَهَسَ الدَهرُ القَبائِلَ بَعدَهُ","بِنابٍ حَديدٍ يَقطُرُ السَمَّ عانِدِ",59,"د",1,0],["لَقَد نَزَلَت ضَنكاً مِنَ اللَحدِ وَالثَرى","وَلَو كانَ رَحبَ الذَرعِ ما كانَ بِالرَحبِ",60,"ب",1,0],["لَقَد نَكَبَ الغَدرُ الوَفاءَ بِساحَتي","