{"poems":[[95,"ما كان ريب قبل ريب الحمام","https://www.aldiwan.net/poem11325.html","السريع"],[53,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[80,"يا خبر من يلحظه ناظري","https://www.aldiwan.net/poem14166.html","السريع"],[87,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[47,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[47,"من نعمة الصانع الذي صنعك","https://www.aldiwan.net/poem65136.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[96,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""],[186,"في الركب بين هوادج الآرام","https://www.aldiwan.net/poem67034.html","الكامل"],[275,"تمرين يا ذات الملاء المزيل","https://www.aldiwan.net/poem35579.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[443,"دعني أعلل قلبا فيك معمودا","https://www.aldiwan.net/poem2496.html","البسيط"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[466,"عجب العاشقون إذ راح عندي","https://www.aldiwan.net/poem15143.html","الخفيف"],[518,"هدية عيد قد علا فوق قدره","https://www.aldiwan.net/poem67679.html","عموديه"],[543,"رأيك الرأي السديد","https://www.aldiwan.net/poem48206.html","عموديه"],[567,"أتعلم ما هاجت بقلبي من الشغل","https://www.aldiwan.net/poem52926.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83256","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49612","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130747","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62843","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62942","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44907","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125818","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54453","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72678","الطويل"],[5353,"الآتي الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212460",""]],"verses":[["رَأْيُكَ فَوْقَ التَّعْزِيَاتِ الَّتِي","تُقالُ مَهْمَا يَسْمُ وَحْيُ الْكَلامْ",0,"م",1,0],["رأي كأن الدهر أطلعه","من سر كل خفيَّةٍ طلعه",1,"ع",2,0],["رَأَيُك إِمّا شِمَتُهُ صارِمٌ","عَضبٌ عَلى الأَعداءِ مَشهورُ",2,"ر",1,0],["رَأى كَيفَ السَبيلُ إِلى كَريدٍ","وَكَيفَ عَواقِبُ الطَيشِ المَزيدِ",3,"د",1,0],["رَأيَكَ في قارِبٍ يُريدُكَ أَن","تَنصُرَ أَحشاءَهُ عَلى قَرَبِه",4,"ب",2,0],["رَأيُكَ في أُنسَةِ الرِفاقِ وَلَن","تَعتاضَ مِنّي مُكَثِّراً شِيَعَك",5,"ك",1,0],["رَأَى كَلَفِي لا يَسْتَفِيقُ فَظَنَّ بِي","هَنَاتٍ وَسُوءُ الظَّنِّ دَاعِيَةُ الْوِزْرِ",6,"ر",1,0],["رأي كأنّ بنات الغيب تعشقه","فعنده السرّ والأطياف والصور",7,"ر",1,0],["رَأيٌ كَما سَفرَ الضُحى وَبَديهةٌ","مَلَكَت سَدادَ النَقضِ وَالابرامِ",8,"م",1,0],["رأى كاعباً عذراءَ في المرجِ أقبلت","لتقطفَ للأترابِ حزمةَ سنبل",9,"ل",1,0],["رأى كواكباً في أول الأمر فانتهى","به الحال تدريجيا لإفراد وجهة",10,"ه",1,0],["راي كمنبلج الأصباح خوّلهُ","ربّ السماوات توفيقا وتأييدا",11,"د",2,0],["رأيكُمُ لي كَنزٌ وأنتم","صفقةُ ربحي ورأسُ مالي",12,"ل",2,0],["رأيك الباسل المقَحِّم في الحر","بِ وقد أحْجَم القَنا والنُّصولُ",13,"ل",1,0],["رأى كل عبد مهدياً لحبيبه","فلم ير أن يهدي له غير شكره",14,"ه",1,0],["رأيُك الرَّأيُ السَّدِيدُ","أيُّهَا البَاشا السَّعيدُ",15,"د",1,1],["رأى كلُّ بيتٍ نفسَهُ كقَصيدةٍ","فضاقَ بهِ ما كانَ يَحْويه من قبلِ",16,"ل",1,0],["رَأى كَرَماً مِنّي تَذَكَّرَ قَولَهُ","فَدَلَّ عَلى أَعلى خَلالاً وَأَكرَمِ",17,"م",1,0],["رأى كلَّ ما يستعظمُ الناسُ دونَهُ","فولَّى غنياً عنه أو متغاني",18,"ن",2,0],["رأى كتاباً على طرف السرير له","فيه الشقاء له واليأس والخطلُ",19,"ل",1,0],["رأَى كلَّ ساعٍ في الأَنامِ مغَرَّراً","فغَرَّرني كسبُ العُلا والمآثِرِ",20,"ر",1,0],["رأَى كلَّ صرحٍ على ظَهرِها","يبيدُ ولو أَنَّه كَبكَبُ",21,"ب",1,0],["رَأَيك الحَق فاقض فيهم وَعجّل","إِن حزم الأُمور أن تتعجل",22,"ل",1,0],["رَأيُكَ اليَوم في الحَياةِ غَريبٌ","ظاهرُ الضَعفِ واضحُ الخَذلانِ",23,"ن",1,0],["رأى كلَّ شيء باقياً في مكانه","وإن بُدِّلَت أَسماءُ بعضِ الجوانب",24,"ب",1,0],["رأيكَ في الدَّهرِ عن رزايا","جلا مهماته الجلائلْ",25,"ل",1,0],["رأى كل موجود من النعم التي","بها أنعم الباري على كل موجود",26,"د",1,0],["رأى كلَّ غرس ٍأخضر ٍ ناحلا ً ظما","وتلكَ الرّبوعَ الخضرَ قد صرنَ معقِلا",27,"ل",2,0]]}