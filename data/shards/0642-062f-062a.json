wan/poem/54238","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54291","الكامل"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[50,"إنَّني أشتهي لقاءك والله","https://www.poetsgate.com/ViewPoem.aspx?id=31056",""],[67,"البردة","https://www.poetsgate.com/ViewPoem.aspx?id=14575",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"قَدْ تَرَى دارِاساتِ تِلْكَ الرّسومِ","https://www.poetsgate.com/ViewPoem.aspx?id=31726",""],[45,"قَدْ تَخَلَّلْتَ مَسْلَكَ الرُّوحِ مِنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=31858",""],[45,"يا خَليلي، بَلْ لَسْتَ لي بخَليلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31804",""],[45,"بين أفق الصبا وأفق الدبور","https://www.poetsgate.com/ViewPoem.aspx?id=31271",""],[45,"عش حميداً في ظل عيش حميد","https://www.poetsgate.com/ViewPoem.aspx?id=31607",""],[45,"كمْ لَيْلَةٍ فيكِ بِتُّ أسْهَرُها","https://www.poetsgate.com/ViewPoem.aspx?id=31198",""],[91,"دمعة على جبران جبران","https://www.poetsgate.com/ViewPoem.aspx?id=52997",""],[99,"قطرة الندى","https://www.poetsgate.com/ViewPoem.aspx?id=570",""],[97,"زازا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63558&r=&rc=104",""],[31,"قُلْتُ، إذْ أَقْبَلَتْ وَزُهْرٌ تَهَادَى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19041&r=&rc=304",""],[31,"ما عَلَى الرَّسْمِ بالبُلَيَّيْن لَوْ بَيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18767&r=&rc=30",""],[20,"ويح عمرِو بن عدي من رجل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70016&r=&rc=38",""]],"verses":[["قُدتُ خَيلَ اللَثمِ أَصرِفُها","حَيثُ ذاكَ الخَدُّ مَيدانُ",0,"ن",1,0],["قَد تُخَلّى النَفسُ الحَبيبَةُ بِالرُغ","مِ وَقَد يُبعَدُ القَريبُ الداني",1,"ن",2,0],["قَد تَيَقَّظتُم لِأَمري","لَكِنِ الجَدُّ يَنامُ",2,"م",1,0],["قُدَّتْ قَوافِيهِ غُرّاً فَالرُّواةُ لَهُم","بِهِنَّ زَهْوُ عِتاقِ الخَيْلِ بِالغُرَرِ",3,"ر",1,0],["قَد تَخَوَّفتُ أَن أَموتَ مِنَ الشَو","قِ وَلَم يَدرِ مَن هَوَيتُ بِما بي",4,"ب",2,1],["قُدْتَ الصِّعابَ فكُلُّ صعْبٍ سامِحٌ","لكَ بالقِيادِ وكان قبْلُ شَموسا",5,"س",2,0],["قدْ تقضّتْ عشْرٌ الى عُشْرِ عَشْرٍ","وتولّتْ رِكابُها فِي اسْتِباقِ",6,"ق",1,0],["قُدْتُمْ بِهَا الْجُرْدَ الْمَذَاكِيَ قُرَّحاً","غُبْرَ النَّوَاصِي ضُمَّر الأَبْدَ انِ",7,"ن",1,0],["قدْتُهمْ للجِهادِ فاشْتَكوا الضّعْ","فَ وضجّوا لكَثْرَةِ الأسْفارِ",8,"ر",1,0],["قَد تَفَتَّقنَ مِنَ الغُسنِ إِذا","قامَ ذو الضُرِّ هُزالاً وَرَزَح",9,"ح",1,0],["قَد تَعالَلتُها عَلى نَكَظِ المَي","طِ فَتَأتي عَلى المَكانِ المَخوفِ",10,"ف",1,0],["قَد تَجاوَزتُها وَتَحتي مَروحٌ","عَنتَريسٌ نَعّابَةٌ مِعناقُ",11,"ق",1,0],["قَد تَعَلَّلتُها عَلى نَكَظِ المَي","طِ وَقَد خَبَّ لامِعاتُ الآلِ",12,"ل",1,0],["قَد تَعلَمينَ يا قُتَيلَةُ إِذ","خانَ حَبيبٌ عَهدَهُ وَأَدَل",13,"ل",1,0],["قَد تَرَكَ العامِلاتُ الراسِماتُ بِهِ","مِنَ الأَحِزَّةِ في حافاتِهِ خُنُفا",14,"ف",2,0],["قَد تَبَيَّنتَ كُلَّ مَعنىً فَأَنكَر","تَ عَلى السالِفينَ مَعنى المُحالِ",15,"ل",1,0],["قَد تَحَدَّيتَ قُوَّةً تَملَأُ المَع","مورَ مِن هَولِ بَطشِها إِرهابا",16,"ب",2,0],["قَد تَساءَلتُ يَومَ ماتَ حُسَينٌ","أَفَقَدنا بِفَقدِهِ كُلَّ شَيِّ",17,"ي",1,0],["قَد تَحالَفتَ وَالتُرابَ عَلَينا","وَتَقاسَمتُما فَناءَ العِبادِ",18,"د",1,0],["قَد تَوَلّى مُحَمَّدُ الخامِسُ المُل","كَ فَأَعظِم بِتاجِهِ المَعقودِ",19,"د",1,0],["قَد تَحَدَّيتُمُ المَنِيَّةَ حَتّى","هَمَّ أَن يَغلِبَ البَقاءُ الزَوالا",20,"ل",2,0],["قَد تَسَقَّطتُهُ وَخالَفتُ فيهِ","مَن يَرى النَقلَ سُبَّةً وَاِجتِراما",21,"م",2,0],["قَد تَنَقَّلنا بِميمَينِ","وَسينينِ وَجيمِ",22,"م",1,1],["قد تستحب من المقل على","أغلى النفائس من يد المثري",23,"ر",2,0],["قَدْ تُسْتَشَفُّ سَرَائِرٌ","لَطُفَتْ فَلَمْ تَرَهَا الظُّنُونُ",24,"ن",1,0],["قَدْ تَمَّ الاستِقْلالُ مَدْرَجَةً","هِيَ وَحْدَةُ التَّشْرِيعِ وَالنُّظُمِ",25,"م",1,0],["قَدْ تَأْخُذُ الشَّعْبَ الثِّقَالَ هُمُومُهُ","سِنَة الْكَرَى وَضَمِيرُهُ قَوَّامُ",26,"م",1,0],["قد تمّ لي زجلي","من خيرة الأزجال",27,"ل",1,0],["قد تابعوا الموتى عليه وما وقَوا","أهل الحياة به من الأحجاف",28,"ف",1,0],["قد تَولَّوْا تمويننا عن خِداع","فارتقت في غلائها الأسعار",29,"ر",1,0],["قَد تَيَّمَ القَلبَ حَتّى زادَهُ خَبَلاً","مَن لا يُكَلَّمُ إِلّا وَهوَ مَحجوبُ",30,"ب",1,0],["قَد تَجاوَزتُ وَتَحتي جَسرَةٌ","حَرَجٌ في مِرفَقَيها كَالفَتَل",31,"ل",1,0],["قَد تَعَفّى بَعدَنا عاذِبُ","ما بِهِ بادٍ وَلا قارِبُ",32,"ب",1,1],["قَد تَحَقَّقت في سِر","ري فَناجاكَ لِساني",33,"ن",2,1],["قَد تَجَلَّت طَوالِعٌ زاهِراتٌ","يَتَشَعشَعنَ وَالطَوالِعُ بَرقُ",34,"ق",1,0],["قَد تَصَبَّرتُ وَهَل يَص","بِرُ قَلبي عَن فُؤادي",35,"د",2,1],["قد تجرعتْ من جَفائك لما","سُمْتَني ذاك شَربةً كدراءَ",36,"ا",2,0],["قد تَسترُ المرآةُ عَنْ","كَ خدوشَ وجهك مَعْ صَداها",37,"ه",2,1],["قد تحسن الرومُ شعراً","ما أحسنته العُرَيبُ",38,"ب",1,0],["قد ترى ما أظلَّني من فِرَاقِي","كَ ومن دون ذاك تَنْبو الجنُوبُ",39,"ب",1,0],["قد تنفَّلت في اقتضائيك رزقي","فتنفَّلْ فأنت غيثٌ سكوبُ",39,"ب",1,0],["قد تولّى الأمورَ مُعتضدٌ بال","لَه أصبحتَ ثانياً لاعتضادِهْ",40,"د",2,0],["قد تركْتِ الصِّحاح مرْضى يميدُو","ن نُحولاً وأنت خُوطٌ يميدُ",41,"د",1,0],["قد تنطق الأستاهُ في مجلسٍ","وتُملأ الأفواهُ إخراسا",42,"س",2,0],["قد تبدَّلنا بك المر","د فدع باب النفاق",43,"ق",1,0],["قد تُثيبُ القليلَ مدحاً من القو","مِ كثيراً من المثوبةِ جَزلا",44,"ل",2,0],["قد تجلّت على محاسنَ ليستْ","عند فقد الحُليِّ والإعطالِ",45,"ل",1,0],["قد تجاوزتُ ما تجاوزت عنكم","وتغاضت على قذاكمْ جُفوني",46,"ن",2,0],["قد تناولتُكم بما كفَّ غربي","مُعرضاً عن نسائكم فاحذروني",46,"ن",2,0],["قد تعالَوْا على أسِرَّة دُرٍّ","لابسينَ الحريرَ والأرجوانا",47,"ن",2,0],["قد تَصرَّفْتُ في نَواحٍ من الأرْ","ضِ فرَدَّتني النواحِي إليكا",48,"ك",2,0],[