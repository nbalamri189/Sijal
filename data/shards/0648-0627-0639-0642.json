{"poems":[[55,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[55,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[55,"لمن الديار طلولها وقص","https://www.aldiwan.net/poem30177.html","الكامل"],[65,"خليلي ما بال الليالي تلفتت","https://www.aldiwan.net/poem45943.html","الطويل"],[3,"وللموت خير للفتى من حياته","https://www.aldiwan.net/poem139.html",""],[53,"إذا خاب داع أو تناهى دعاؤه","https://www.aldiwan.net/poem8166.html","الطويل"],[53,"سيشكر رب الناس ما قد فعلته","https://www.aldiwan.net/poem62975.html","الطويل"],[53,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[53,"جرى الأضحى رسيل المهرجان","https://www.aldiwan.net/poem66393.html","الوافر"],[68,"وحقك إني قانع بالذي تهوى","https://www.aldiwan.net/poem38475.html","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39411","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[111,"حِكَم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66842&r=&rc=21",""],[173,"أبى الدهر أن يلقاك إلا محارباً","https://www.aldiwan.net/poem1599.html",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[203,"طال علي ليلي","https://www.aldiwan.net/poem45578.html","مجزوء الرجز"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[280,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[280,"نور الهداية ما أضاء ولاحا","https://www.aldiwan.net/poem25603.html","الكامل"],[285,"أترى الهلال أنار ضوء جبينه","https://www.aldiwan.net/poem60770.html","الكامل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[354,"علق الفؤاد بحب ظبي لاعب","https://www.aldiwan.net/poem15876.html","الكامل"],[369,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[371,"تعاور قلبي نازل بعد نازل","https://www.aldiwan.net/poem17079.html","الطويل"],[391,"وللموت خير للفتى من حياته","https://www.aldiwan.net/poem1837.html","الطويل"],[422,"زارت وجنح الدجى يا سعد معتكر","https://www.aldiwan.net/poem53872.html","البسيط"],[422,"غير وجه الجو في حمرة","https://www.aldiwan.net/poem54009.html","السريع"],[435,"لاق المدامة بالمسرة لاقي","https://www.aldiwan.net/poem40041.html","الكامل"],[445,"هنيئا لهذا الدهر روح وريحان","https://www.aldiwan.net/poem34894.html","الطويل"],[447,"أحمل نفسي فوق ما لا تطيقه","https://www.aldiwan.net/poem14396.html","الطويل"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[463,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[482,"دعني أكابد أشجاني وأوصابي","https://www.aldiwan.net/poem15233.html","البسيط"],[487,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[503,"هم نظروا لواحظها فهاموا","https://www.aldiwan.net/poem3708.html","الوافر"],[545,"قد كنت أحسبني جلدا فضعضعني","https://www.aldiwan.net/poem56643.html","البسيط"],[556,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[556,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[558,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[689,"","https://poetry.dctabudhabi.ae/diwan/poem/203594","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62535","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67741","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65036","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136114","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136239","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112951","الوافر"],[1391,"","https://poetry.dctabudhabi.ae/diwan/poem/21202","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79992","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48949","الطويل"],[1560,"","https://poetry.dctabudhabi.ae/diwan/poem/130734","الطويل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17646","الطويل"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104166","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69417","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89517","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53098","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102571","الرمل"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198978","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130807",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130784",""],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96427","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139075",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103971","الوافر"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206266","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45252","الوافر"],[3650,"","https://poetry.dctabudhabi.ae/diwan/poem/34817","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92039","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85123","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4092,"","https://poetry.dctabudhabi.ae/diwan/poem/141706","الكامل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45952","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97081","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97077","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45065","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81237","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136476",""],[4830,"الذُبول","https://www.poetsgate.com/ViewPoem.aspx?id=195424",""],[3591,"يا حافظ الشعر ويا شاعراً","https://www.poetsgate.com/ViewPoem.aspx?id=149433",""],[5200,"أيا واحد الناس فى قوله","https://www.poetsgate.com/ViewPoem.aspx?id=200796",""],[5376,"احزمْ متاعَك أيها الرجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198998",""],[5436,"العى بنا الشوق يابغداد","https://www.poetsgate.com/ViewPoem.aspx?id=185987",""],[5512,"يا أيها الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=204865",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[391,"ولَلمَوتُ خيرٌ للفتى من حياتِه","https://www.poetsgate.com/ViewPoem.aspx?id=4676",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[5988,"هديتي التحية للامام","https://www.poetsgate.com/ViewPoem.aspx?id=99724",""],[6093,"إذا أحَاطتْ بِمغرورٍ منيَّتُه","https://www.poetsgate.com/ViewPoem.aspx?id=176073",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""]],"verses":[["وَاِعقِل رَجاءَكَ بِالحُسَينِ فَإِنَّهُ","حَرَمٌ يُذِمُّ مِنَ الزَمانِ وَمَعقِلُ",0,"ل",1,0],["وَأَعُقُّ الغُرابَ بَي","نَ بَروقٍ وَفارِقِ",1,"ق",1,0],["وَاِعقُد يَدَيكَ بِمُجتَني كَرَمٍ","لا قَدحُ في حَسَبٍ وَلا غَمصُ",2,"ص",1,0],["وَأَعْقَبَني قَبْلَ الثلاثِينَ صَرْفُها","بِسُودِ دَواهِيها بَياضَ المَفارِقِ",3,"ق",1,0],["وَأَعقَبَ نَوءُ المُدبِرينَ بِغَبرَةٍ","وَقَطرٍ قَليلِ الماءِ بِاللَيلِ بارِدِ",4,"د",1,0],["وأعقبَها بُرءٌ جديدٌ كأنه","شبابٌ رَديد شُقَّ عنه مشيبُ",5,"ب",1,0],["وأعقِبْ إذا أبدأتَ عُرفاً فإنما","بوادئه تنسى وعقباه تُذكر",6,"ر",1,0],["وأُعقبك المدُوس على فراغ","وأعقب مثلَ ذاك مُؤازريكا",7,"ك",2,0],["وأعقبَ في أخيرِهما نعيمٌ","ولَهوٌ منك بالنِّعم الحسان",8,"ن",1,0],["وَأَعقَبتَني مِن خَمرِ حُبِّكَ نَشوَةً","فَها أَنا حَتّى الحَشرِ لا أَعرِفُ الصَحوا",9,"و",2,0],["وأعقَبَتْها التي واصلْتُها","بالهجرِ لمَّا رأتْ شَيْبَ القَذال",10,"ل",1,0],["وَأَعْقَبَهَا تِرَاكٌ لَمْ تَذِلُّوا","لِحُكْمِ الدَّهْر فِيهِ وَلَمْ تُذَالُوا",11,"ل",3,0],["واعقل الناس من ابدى تواضعه","من نفسه لانتقاد الخل ما فيها",12,"ي",3,0],["وَأَعقَبَ سوءاً شامِتاً سُرَّ قَلبُهُ","بِضَيمي وَأَضحى عاثِرَ الجدِّ خائِبا",13,"ب",2,0],["وَأَعقلُ منه الكلبُ يسترُ رجسهُ","وَهذا رَأى في نشرِ أَرجاسهِ فخرا",14,"ر",2,0],["وأعقدَ الثديانِ في","قوامها كالثمرِ",15,"ر",1,0],["وأَعْقدُ بالنَّجْمِ المُشَرِّق نَاظِري","فَيَغْرُب عَنِّي سَاهِراً غَيْرَ نَائِمِ",16,"م",1,0],["واعْقدْ لِمَولايَ الأميرِ مُحَمّد","عَهْداً به تُرضِي النّبِيَّ مُحَمّدا",17,"د",2,0],["واعقِد بمظهرِها وحَسبُك مطمَحا","طَرْفاً إلى أمثالِها طمّاحا",18,"ح",2,0],["وَاعْقِدْ لَهُ التّاجَ الْمُنِيف فإِنَّما","فَخْرُ الْمَفاخِرِ عَقْدُها لِجَبِينِهِ",19,"ن",2,0],["وأعقبت من سرور مونق حزناً","ومن نضارة عيش رائق قشفا",20,"ف",2,0],["وَأُعَقِّدُ الأَيمانَ في صَبري عَلى","سَلوانِهِ فَيَحِلُّها بِسَلامِهِ",21,"م",2,0],["وأعقِلُ نَضوي بحَبْل الرّجاءِ","وما زالَ للأملِ النّاسُ أسرى",22,"ر",2,0],["وَأَعقَبَني وَصلَ الأَحِبَّةِ هَجرُهُم","وَلِذَّةَ ذاكَ العَتبِ قَولُ العَواذِلِ",23,"ل",1,0],["وَأَعقَبَ نَوءَ المِرزَمَينِ بِغُبرَةٍ","وَقَطرٍ قَلِيلِ الماءِ بِاللَيلِ بارِدِ",24,"د",1,0],["وأعْقَبَتْ كلَّ حزنٍ بعدَ فرقتها","فهلْ لها أن تُعيدَ الحزنَ أفراحا",25,"ح",2,0],["وأَعْقَبَتْها ظُلْمَةٌ أَيْقَنَتْ","أَنْفُسُنا من أجلها بالبوار",26,"ر",1,0],["واعقد على الكاسات عقد حبابها","صبحاً وخذ عقلي لها بصداقِ",27,"ق",1,0],["وأَعقَبَ طَولُ الحربِ أبناءَ قَيلَةٍ","زكاةً وَرُحماً فِيهِ أَمْنٌ وإِيمانُ",28,"ن",1,0],["وأعقد ميثاقاً إلى غير واثق","لعهد ولم أبرح بعهدي وثيثقه",29,"ق",2,0],["وأعقبهم على الأيّام ذكراً","فعصرك بالكفاية خيرُ عصر",30,"ر",1,0],["وأعقرُهم للبُزْل والعامُ أشهبٌ","وأوسعُهم خَطّاً لأُثْفِيَّةِ القِدْرِ",31,"ر",1,0],["وأعقبتْهُ ببينٍ راعني عَجَلاً","مُستكْرَهٍ لدواعي الشَّوقِ جّلابِ",32,"ب",1,0],["واعقم تدابر لهم والمصائد","أوقعهم بها في جب الأخاديد",33,"د",1,0],["وأعقب بينها في الصدر غمّا","إذا غربت ذُكاءُ أتى الظلامُ",34,"م",1,0],["وَأَعقَبَ الدَهرُ ريشاً في مَناكِبِهِ","فَما يَزالُ مَع الأَعداءِ يَرميني",35,"ن",2,0],["وَاِعقر بِذا العيد آمال العُداةِ لَنا","فَإنّها بالرّدى أَولى منَ النعمِ",36,"م",1,0],["واِعقِرْ قَلوصَك عنده","فهناك مالٌ ثمّ أهلُ",37,"ل",1,0],["وَأَعقِدُ مِئزَري عَقداً ضَعيفاً","عَلى دِعصٍ رُكامٍ مِن كَثيبِ",38,"ب",1,0],["وأعقد يمينك إنه من عقدهم","عين القلادة فصلت بثمين",39,"ن",1,0],["وأعقد محض النصح ديناً إلى بني","شهيم فعادوه وحلوا له الذممْ",40,"م",1,0],["وأعقيبه فتح الاله بلطفه","باب الظهور على عداة الدين",41,"ن",1,0],["وَأعْقَبَ مَدْحَتِي سَرْجاً خَلَنْجَا","وَأبْيَضَ جُوزَ جَانيَّا عَقُودَا",42,"د",2,0],["وأَعقَبَ عَمَّيهِ أَصْفى النَّعيمِ","بِما أَسْلَفا مِنْ جَميلِ الْبَلاءِ",43,"ا",2,0],["واعقل فإن الأمر فيه تنكر","وعلى العيون من العمى جلباب",44,"ب",1,0],["واعقل تصاريف الزمان فانها","عبر بها في الفهم ينكشف الغطا",45,"ط",2,0],["واعقبهم صيامهم دوام الهنا","والقرب من احسان بر",46,"ر",1,0],["وَاِعقِدوا الراياتِ في أَقطارِها","وَاشهَروا البيضَ وَسيروا في الضُحى",47,"ا",1,0],["واعقر قلبي لدى قبره","بسيف الشجا لا جياداً ونيبا",48,"ب",2,0],["واعقدوه عارضاً من عِثيَرٍ","بالدم المهراق منحلّ العَزالى",49,"ل",2,0],["واعقِروا عنده وجلَّ عن العقر","قلوباً مطلولة السوداء",50,"ا",2,0],["وأَعقبه في البحث صوتُ ملثَّمِ","فلم يُبقِ داءً في النفوس ملثَّما",51,"م",2,0],["وأعقب هذا مصطفى بن محمّد","وأخر عما ناله من تقدّم",52,"م",1,0],["وَأَعقَبتَها هَجراً وَشَفَّكَ دونَها","مَناطِقُ رَهطٍ في قَسيمَةِ خُيَّبِ",53,"ب",1,0],["وأعقد بالود حبل الصفاء","إذا غير الود خؤان",54,"ن",1,1],["وَاعقِد عَلَيكَ التاجَ وَاعلَم أَنَّهُ","بِالعِزِّ مَعقُودٌ وَإِن لَم يُعقَدِ",55,"د",1,0],["وَاِعقِد مَعَ اللَهِ عَزماً لِلجِهادِ فَقَد","أوتيتَ نَصراً عَزيزاً فَاِستَقِم وَثِبِ",56,"ب",1,0],["واعقد له عوض التمائم راية","منصورة في كلِّ يوم جلاد",57,"د",1,0],["وأعقل النساء من لا تركن","لساحرٍ ولا إليه تذعن",58,"ن",1,0],["واعقدوا للقرب مجلس","واسجير اللَه من البين",59,"ن",1,0],["وأعقبت إتحافي فرايدك التي","وجوب ثناها يا لساني أعياكا",60,"ك",2,0],["واعقد زواجا جديداً كي اشتته","ما بين منحدر الدينار والقلل",61,"ل",1,0],["واعقل الناس من تجلى حقيقته","بالانتقاد ولين الخلق ادناهُ",62,"ا",2,0],["واعقبني صرماً على غير إحنةٍ","وبخلا وقدما كان لي يتبرعُ",63,"ع",1,0],["واعقد نكاحاك بعد الخطب ان نظرت","عيناك للوجه والكفين واحتكم",64,"م",1,0],["واعقب بالصلاة على المعلَّى","على كل الورى شرفا وحالا",65,"ل",2,0],["وَاِعقرنها مِن جوى مهجا","حيث يَبدو الجوّ من كثبِ",66,"ب",1,0],["وأعقبه التسلي بعد هذا","وضار يرى الهوى عاراً وذاما",67,"م",2,0],["وأعقبه عيد الغدير فلم نخل","لقرب التداني أن بينهما فرقا",68,"ق",2,0],["وَأَعقَبَ أَصدَقَ الخَصمَينِ قَولاً","وَوَلّى اللؤمَ أَولانا بِذاكا",69,"ك",2,0],["وَاِعقِري مُهري أَصابَ ال","لهُ مُهري بِالصِدامِ",70,"م",1,0],["وَأَعقبتَ قلبي زفرةً بعد زفرةٍ","عَلى حسرةٍ من حرِّها يتصدّع",71,"ع",1,0],["وأعقب مولانا الشهاب الذي سما","هو القطب عن دين الضلالة يردع",72,"ع",1,0],["وأعقل يديها في مرابع معقل","للوفد يحسبه النزيل نزيلا",73,"ل",2,0],["واعقر سويداء الضمي","رفليس يقنعني السوامُ",74,"م",1,0],["وَأَعقَبَكُم مِن كُلِّ سوءٍ مَسَرَّةً","وَعافِيَةً مَصحوبَةَ الخُلدِ وَالبَقا",75,"ق",2,0],["واعقل بمغنى قد أسر ضريحه","سراً له اختار المهيمن وارتضى",76,"ض",2,0],["واعقل إذا ما شمت مثوى","عالم ما في المائر",77,"ر",1,0],["وَأعقِرُ مِن أَبكارِ فِكري عَقائِلاً","أَرّقّ مِنَ التَسنيمِ لا ذاتَ مَنسِمِ",78,"م",1,0],["وَاِعقدوا وَاِكتُبوا مِن الكلم الع","ليا حِفاظاً عَلى النَبي الصَغير",79,"ر",1,0],["وَأَعقَبَ التَسليمَ تَوديعٌ بِهِ","غابَ الهِلالُ حينَ لاحَ ابن ذُكا",80,"ا",1,0],["وإعقل قلوصَك إنما هو مربعٌ","ضُربت لآل الله فيه قباب",81,"ب",1,0],["وأعقرَ الوَهْنُ بعد الوَهْنِ راحلتي","واقمرتْ هامتي من غير اعوامِ",82,"م",1,0],["واعقد بها التاج على مفرقٍ","لاق بتاج الفاتح القاهر",83,"ر",1,0],["واعقل ذا الخلق فى حكمه","منجّمه المائق الأرعن",84,"ن",1,0],["واعقدْ متاعَك لا فكاك له","ما دمْتَ عُفْتَ الدارَ ترتحلُ",85,"ل",1,0],["واعقل الدمع حتى ضجّ من فزعٍ","مثل العبيد جهاراً منك قد ابِقوا",86,"ق",3,0],["واعْقُدْ قِلادةَ أمنٍ من لآلئِهِ","لكي تكونَ لنا حِرزاً إلى الأبدِ",87,"د",1,0],["واعقدْ لحقِّك، في الملاحم ندوةً","يقف الزمان بها خطيباً مِصْقَعا!",88,"ع",2,0],["وأَعقَبَ نَوءَ المِرزَمَينِ بغُبرَة","ٍ وقطٍ قليلِ الماءِ بالَّليلِ باردِ",89,"د",1,0],["واعقلوا لا تجهلوا واحفظوا لا تهملوا","واصبروا لا تعجلوا كي تنالوا البركات",90,"ت",1,0],["وأعقبك السلامة منه رب","يريك سلامةً في كل عام",91,"م",1,0],["وأعْقلُ النَّاس مَنْ تلقاه مِنْ فِطَنٍ","لِهَجْمَةِ الموتِ قَبْلَ الموتِ مُحْتاطَا",92,"ط",2,0],["وأعقد صفقة رهن لأرض","عليها الجدود أقروا المصيرا",93,"ر",2,0]]}