{"poems":[[88,"ولت بشاشة دنيانا ودنياك","https://www.aldiwan.net/poem10363.html","البسيط"],[88,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[21,"عرفت الدار قد أقوت سنينا","https://www.aldiwan.net/poem36141.html","الوافر"],[54,"أرد الطرف من حذري عليه","https://www.aldiwan.net/poem27128.html","الوافر"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[409,"جرى هذا الزمان على ضلاله","https://www.aldiwan.net/poem33453.html","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111170","المتقارب"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113979","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109417","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89084","الطويل"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77717","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101374","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94594","الطويل"],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[5480,"عاضد العز","https://www.poetsgate.com/ViewPoem.aspx?id=9881",""],[5957,"يا رفيق كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=187772",""]],"verses":[["وَأَرصَدوا لي رَقيباً لَيسَ يُخطِئُهُ","هَجسُ الفُؤادِ إِذا حاوَلتُ ذِكراكِ",0,"ك",1,0],["وَأَرصَدتَ لِلباغي عَلى دينِ أَحمَدٍ","شَباةَ يَراعٍ ساحِرِ النَفَثاتِ",1,"ت",1,0],["وَأَرصَدنا لِحربِ الدَهرِ جُرداً","تَكونَ مُتُونهاً حِصناً حَصينا",2,"ن",2,0],["وَأَرصُدُ غَفلَةَ الرَقَباءِ عَنهُ","لِتَسرِقَ مُقلَتي نَظَراً جَديدا",3,"د",2,0],["وأرصدت لأوان آن موقعه","وللمواقع أوقات كما علما",4,"م",2,0],["وأرصد لي الرقيب على طريقي","كأني جئت مستلباً لماله",5,"ل",2,0],["وأرصف النوى في باب السلام وهل","إلا عيه أنيخ الأنيق الرسما",6,"م",2,0],["وأرصده في ظلام الدجى","بحيث العدى آمنت باسه",7,"س",2,0],["وارصُدهُمُ في النوبِ لوذاً إنَّهُم","عَصَرُ الحريبِ وموئِلُ المتوَئِّل",8,"ل",1,0],["وأرصد في ليلي مطالعَ وصفه","كأني لاجرام الكواكب راصد",9,"د",1,0],["وأرصاغ كصَنجٍ من حديدٍ","وسَبطٌ شعرُه عَرفٌ رَخي",10,"ي",1,0],["وأرصد أفق الوهم والأمل السهى","ورائد موتي كامن في ورائدي",11,"د",2,0],["وأرصدتُها في الروض أية عدةٍ","فكانتْ لدفع المحْلِ عنهُ بمرصادِ",12,"د",1,0],["وأرصدوا عينين للصوار","ليرقبا عند ورود النهر",13,"ر",1,0],["وارصد بهم من كنوز السر أثمنها","فقد تباح إذا أمست بلا رصد",14,"د",1,0],["وأرصد النجم اليماني وانتسب","قائلا إني فلان بن فلان",15,"ن",1,0],["وأرصادهُ نضَّت ستار خزائنٍ","ونادت إلى شمس البها خازنيَّة",16,"ه",1,0],["وارصد خواطر ساعات النشاط له","إذا أردت لبعض القول تكرارا",17,"ر",2,0],["وأرصد مداري بين لأفكار مركز","وحدي بفكري مثل ما حادي العيس",18,"س",1,0],["وأرصع الدمعات أقمارا بها","ظنا بأنكَ مؤمنٌ بعذابي",19,"ب",2,0]]}