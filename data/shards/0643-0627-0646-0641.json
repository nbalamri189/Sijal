طِل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19567&r=&rc=70",""],[33,"ألا أيُّهَا الشَّيْخُ الَّذِي مَا بِنَا يَرْضَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14126&r=&rc=61",""],[14,"لا تلم شيخي فما أدري به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17391&r=&rc=2",""]],"verses":[["كانَ في مَعطِسِهِ الرَغ","مُ وَفي فيهِ الرَغامُ",0,"م",1,0],["كَأَنفاسِ الشَمولِ كَرَعتُ فيها","عَلى ظَمَإٍ وَأَنفاسِ الشَمالِ",1,"ل",1,0],["كَأَنَّ في الأَيمانِ حَيّاتِ النَقا","أَرقَمَها النَضناضَ أَو شُجاعَها",2,"ع",3,0],["كَأَنَّ في ساعِدِهِ","وَعياً وَعى ثُمَّ جَبَر",3,"ر",1,0],["كأنّ فُؤادي بينَ أحْشاءِ مُجْرِمٍ","دَعاهُ الفَتى الجوثيُّ يَخشى ويَرْتجي",4,"ج",2,0],["كَأَنَّ فُؤادي يَومَ قُمتُ مُوَدِّع","عُبَيلَةَ مِنّي هارِبٌ يَتَمَعَّجُ",5,"ج",1,0],["كَأَنَّ فَوزاً تُعاطيني عَلى فَرَسٍ","إِكليلَ رَيحانِ فَغوٍ كَالدَنانيرِ",6,"ر",1,0],["كأنّ فَتاةً جاءَها منْ خَليلِها","كِتابٌ بشَكْوى الحُبِّ منْ غيرِ موْعِدِ",7,"د",1,0],["كانَ في الأَنفُسِ جُرحٌ مِن هَوىً","نَظَرَ اللَهُ إِلَيهِ فَاِلتَأَم",8,"م",1,0],["كانَ في الوُدِّ مَوضِعَ الثِقَةِ الكُب","رى وَفي العِلمِ مَوضِعَ الإِعجابِ",9,"ب",1,0],["كَأَنَّ فُؤادي إِبرَةٌ قَد تَمَغطَسَت","بِحُبِّكَ أَنّى حُرِّفَت عَنكَ تَعطِفُ",10,"ف",1,0],["كَأَنَّ فيها أَبا المُرَجّى","يُنشِدُ ما قالَهُ الرَشيدُ",11,"د",1,0],["كَأَنَّ فُؤادي يَومَ أَهوى مُوَدِّعاً","هَوى خافِقاً مِنهُ بِحَيثُ هَوى القِرطُ",12,"ط",1,0],["كأَنَّ فُصُوصَ الطَوقِ لَمَّا تَنَاثَرَت","ضِيَاءُ مَصابِيحٍ تَطَايَرنَ عَن شَعَل",13,"ل",1,0],["كَأَنَّ فاها لِمَن تَوَسَّنَها","أَو هَكَذا مَوهِناً وَلَم تَنَمِ",14,"م",1,1],["كانَ في الحَقِّ أَن يَعودَ لَنا المَو","تُ وَأَن لا نَسومُهُ تَسويفا",15,"ف",2,0],["كان في الشعر لي مرام خطير","فعدا طوقي المرام الخطير",16,"ر",1,0],["كَانَ فِي كُلِّ الشُّؤُونِ يَرَى","كَيْفَ يَرْقَى الْأَوَْ ذُو الدَّأْبِ",17,"ب",1,0],["كَانَ فِي أَهْلِهِ وَهُمْ خَيْرُ أَهْلٍ","نِعْمَ رَبُّ الحِمَى القَرِينُ",18,"ن",1,0],["كَانَ فِي المَعْرِضِ السِّرَا","جَ الَّذِي يَكْشِفُ الظُّلَمْ",19,"م",1,0],["كَانَ فِي الغَابِرينَ صَوْتِي هُوَ","الصَّوْتُ وَكَانَتْ تُشْجَى بِهِ الأَقْوَامُ",20,"م",1,0],["كَأَنَّ فُؤادي قَلبُ جاني مَخوفَة","عَلى النَفسِ إِذ يَكسونَ وَشِيَ النَمارِقِ",21,"ق",1,0],["كَأَنَّ فُؤادي هاضَ عِرفانُ رَبعِها","بِهِ وَعي ساقٍ أَسلَمَتها الجَبائِرُ",22,"ر",1,0],["كَأَن فُروجَ اللأَمَةِ السّردِ شَدَّها","عَلى نَفسِهِ عَبلُ الذِراعَينِ مُخدِرُ",23,"ر",1,0],["كان فحل الفحول علماً وفضلاً","فلهذا بكت عليه الفحول",24,"ل",1,0],["كان في الدين آية الله أفنى ال","عمر فيه رعايةً وحراسه",25,"س",2,0],["كَأَنَّ في الخَدِّ قَرنَ الشَمسِ طالِعَةً","لَمّا دَنا مِن جِمارِ الناسِ تَحصيبُ",26,"ب",1,0],["كَأَنَّ فيهِ لَمّا اِرتَفَقتُ لَهُ","رَيطاً وَمِرباعَ غانِمٍ لَجِبا",27,"ب",2,0],["كَأَنَّ فاها إِذا ما اللَيلُ أَلبَسَها","سَيابَةٌ ما بِها عَيبٌ وَلا أَثَرُ",28,"ر",1,0],["كَأَنَّ فَوقَ صَدرِهِ وَالهادي","آثارَ مَشيِ الذَرِّ في الرَمادِ",29,"د",1,0],["كَأَنَّ في رُؤوسِهِ","أَصفَرَهُ وَأَحمَرَه",30,"ر",2,0],["كَأَنَّ فاها ثَغَبٌ بارِدٌ","في رَصَفٍ تَحتَ ظِلالِ الغَمام",31,"م",1,0],["كأنَّ فجاج الأرض مما تنوّرت","بأوصافه الحسنى منازل أنجم",32,"م",1,0],["كأن فاها إذا تنسَّمه","تساط فيه فُروث أكراش",33,"ش",1,0],["كأنَّ في صفحته غماما","وبي يُسمَّى ذَكَراً حساما",34,"م",2,0],["كأنَّ فؤادي ليس يَشْفي غليلَه","سوى أنْ يرى الروحَيْن يمتزجان",35,"ن",1,0],["كَأَنَّ فارَةَ مِسكٍ غارَ تاجِرُها","حَتّى اِشتَراها بِأَغلى بَيعِهِ التَجِرُ",36,"ر",1,0],["كَأَنَّ فارَةَ مِسكٍ في مَفارِقِها","لِلباسِطِ المُتَعاطي وَهوَ مَزكومُ",37,"م",1,0],["كانَ في نَفسِيَ كَربُ صارَ في نَفسي كُروب","أَمِنَ الدَيرِ أَمِ اللَيلِ اِكتِئابي لَستُ أَدري",38,"ي",1,0],["كانَ في دَولَةِ السُيوف وَزيراً","أَلمَعِيّا وَدَولَةً في ذاتِه",39,"ت",2,0],["كانَ في ماضي اللَيالي أُمَّةٌ","خَلَعَ العِزُّ عَلَيها حِبرَه",40,"ر",2,0],["كانَ فيها مَلِكٌ ذي فِطنَةٍ","حازِمٌ يَصفَحُ عِندَ المَقدِرَه",40,"ر",2,0],["كانَ فيها شاعِرٌ مُشتَهِرٌ","ذو قَوافٍ بَينَها مُشتَهِرَه",40,"ر",2,0],["كانَ في قَيسٍ حَسيباً ماجِداً","فَأَتَت نَهدُن عَلى ذاكَ الحَسَب",41,"ب",1,0],["كَأَنَّ في بُرَتَيها كُلَّما بَدَتا","بُردِيَّتَي زَبَدِ الآذِيِّ عَجّاجِ",42,"ج",1,0],["كانَ فيه النَّسيمُ يرقُصُ سَكْراناً","على الوردِ والنَّباتِ البَليلِ",43,"ل",1,0],["كانَ في كوخه الجميل مقيماً","يَسْأَلُ الكونَ في خشوعٍ وهَمْسِ",44,"س",1,0],["كانَ في الصرّةِ شعرٌ","فَتَنَظَّرنا جَوابهْ",45,"ب",2,0],["كَأَنَّ فَتيتَ المِسكِ خالَطَ نَشرَها","تُغَلَّ بِهِ أَردانُها وَالمَرافِقُ",46,"ق",1,0],["كان في ظل عرشه يتمنى","ان يكون انتدابه استقلالا",47,"ل",2,0],["كان فينا استماعها منك يوما","وطرا حافزا من الاوطار",48,"ر",1,0],["كان في الخد دمعها","مثل طل على زهر",49,"ر",1,0],["كأن فيها المعاني من برودتها","موتى عليها من الالفاظ اكفان",50,"ن",1,0],["كان في الروم عظيم","ينتهى الجود إليه",51,"ي",2,1],["كانَ فيما مَضى مِنَ الدَهرِ بَيتٌ","مِن بُيوتِ الكِرامِ فيهِ غَزالُ",52,"ل",1,1],["كانَ في جَنبِكَ شَيءٌ مِن عَلَقَ","حينَ مَسَّتهُ يَدُ اللَهِ خَفَق",53,"ق",1,0],["كأنَّ فُؤَادَهُ قَلِقاً","لِسَانُ الحَيّةِ الفَرِقِ",54,"ق",1,0],["كَأَنَّ فَعلَةَ لَم تَملَء مَواكِبُها","دِيارَ بَكرٍ وَلَم تَخلَع وَلَم تَهِبِ",55,"ب",1,0],["كان فيه الطبع حياً","قبل أن كان الوفاة",56,"ه",1,0],["كَأَنَّ في فيهِ لُقمَةً عَقَلَت","لِسانَهُ فَاِلتَوى عَلى جَنَفِ",57,"ف",1,0],["كَأَنَّ فَريدَةً سَفعاءَ راحَت","بِرَحلي أَو بَكَرتُ بِها اِبتِكارا",58,"ر",2,1],["كَأَنَّ فِصالَها حَبَشٌ جِعادٌ","تُخالُ عَلى مَبارِكِها جِفالا",59,"ل",2,0],["كَأَنَّ فُؤوساً رُكِّبَت في مَحالِها","إِلى دَأيِ مَضبورٍ نَبيلٍ مَحازِمُه",60,"م",2,0],["كان في وجهه سرا","ج من الحسن فانطفا",61,"ف",2,0],["كأنَّ في البَرِّ من سَوابِغِهِ","بحرُ حديدٍ يموجُ مُلتَطِما",62,"م",2,0],["كأنَّ فوارعَ الشَّرَفاتِ منها","نساءٌ في مَلاحِفِها قُعودُ",63,"د",1,0],["كَأَنَّ فُتاتَ العِهنِ في كُلِّ مَنزِلٍ","نَزَلنَ بِهِ حَبُّ الفَنا لَم يُحَطَّمِ",64,"م",1,0],["كَأَنَّ في فيها وَفي طَرفِها","سَواحِراً أَقبَلنَ مِن بابِلِ",65,"ل",1,0],["كَأَنَّ فيهِ السَما وَالأَرضَ واحِدَةٌ","وَنوقُنا نُجبُ نورٍ تَحتَ أَملاكِ",66,"ك",1,0],["كَأَنَّ في الشيزِ يُمناها إِذا ضَرَبَت","صَبحٌ تَقَلقَلَ فيهِ قَلبُ ديجورِ",67,"ر",1,0],["كان فراشاً حائراً في الدنى","في نورها أو نارها يرتمي",68,"ي",1,0],["كان في غير حماه غرضاً","لِسِهامٍ فُوّقَتْ بالحدثان",69,"ن",1,0],["كأنّ في فيها عبيراً إذا","تفجّرَ النورُ وغار الظلام",70,"م",1,0],["كأنّ في كفّه حسامَ سناً","ما مسّ من حندس به حَسَمَه",71,"م",2,0],["كأنّ في فيها سلافَ قهوةٍ","صرفٍ بماءِ ظَلْمها مُشَعْشَعِ",72,"ع",1,0],["كَأَنَّ فروعها أيدٍ أَشارتْ","بأطرافٍ خواتِمُها قِصارُ",73,"ر",1,0],["كانَ في الأَجفَلى وَفي النَقَرى عُر","فُكَ نَضرَ العُمومِ نَضرَ الوِحادِ",74,"د",1,0],["كانَ فيهِ تواضعٌ وسكونٌ","وصلاحٌ بادٍ وحسنُ عبارهْ",75,"ه",1,0],["كأنَّ في الحَبَب المرتجّ مفترقاً","من الطريق على ساهٍ ومذٌكَرِ",76,"ر",1,0],["كَأَنَّ فاها إِذا ما جِئتَ طارِقَها","خَمرٌ بِبَيسانَ أَو ما عَتَّقَت جَدَرُ",77,"ر",1,0],["كَأَنَّ فُؤاداً بَينَ جَنبَيهِ راجِفاً","يَقومُ بِهِ نَأيُ الحَبيبِ وَيَقعُدُ",78,"د",1,0],["كَأَنَّ فُضولَ الرَقمِ حينَ جَعَلنَها","غَريّاً عَلى أُدمِ الجِمالِ عُذوقُ",79,"ق",1,0],["كَأَنَّ فُؤادي فيهِ مورٍ بِقادِحٍ","وَفيهِ لَهيبٌ ساطِعٌ وَبُروقُ",80,"ق",1,0],["كَأَنَّ فُؤادي في مَخالِبِ طائِرٍ","إِذا ذَكَرَتها النَفسُ شَدَّت بِهِ قَبضا",81,"ض",2,0],["كَأَنَّ فِجاجَ الأَرضِ حَلقَةُ خاتَمٍ","عَلَيَّ وَلا تَزدادُ طولاً وَلا عَرضا",81,"ض",2,0],["كَأَنَّ فُؤادي كُلَّما مَرَّ راكِبٌ","جُناحُ عُقابٍ رامَ نَهضاً إِلى وَكرِ",82,"ر",1,0],["كَأَنَّ فُؤادي حينَ جَدَّ مَسيرُها","جَناحُ غُرابٍ رامَ نَهضاً إِلى الوَكرِ",83,"ر",1,0],["كَأَنَّ فُؤادي مِن تَذَكُّرِهِ الحِمى","وَأَهلِ الحِمى يَهفو بِهِ ريشُ طائِرِ",84,"ر",1,0],["كأنّ فلسطينَ لم تَنتَفِضْ","لفرط البلاءِ ولم تَستَجِرْ",85,"ر",1,0],["كان في قومِه رسولاً رَضِيَّاً","يَتَّقِي رَبَّهُ ويَرْجُو المعادا",86,"د",2,0],["كانَ فَرداً لِأَجلِ ذا","مَلَكَ الحُسنُ مَرَّتَين",87,"ن",1,0],["كانَ في شَمسِ خَدِّهِ الوَردُ ضاحٍ","فَهوَ الآنَ قَد أَوى لِظِلالِ",88,"ل",1,0],["كانَ في أَضلُعي","فَرَوَتهُ الجُفون",89,"ن",1,0],["كانَ في الرَوض فَوقَ ما يَتَمَنى","مِن فُنون الأَثمار وَالأَزهارِ",90,"ر",1,0],["كَأَنَّ فُؤادي بَينَ أَظفارِ طائِرٍ","إِذا سنَحَت ذِكراكَ مِن كُلِّ مَسنَحِ",91,"ح",1,0],["كَأَنَّ في كَأسِها وَالماءُ يَفرَعُها","أَكارِعَ النَملِ أَو نَقشَ الخَواتيمِ",92,"م",1,0],["كَأَنَّ في الراحِ حينَ تَمزُجُها","نُجومَ دُرٍّ تَهو