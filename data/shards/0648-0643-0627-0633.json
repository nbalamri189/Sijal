{"poems":[[53,"دوام الهوى في ضمان الشباب","https://www.aldiwan.net/poem30745.html","المتقارب"],[63,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[3,"صحا من سكره قلبي وفاق","https://www.aldiwan.net/poem180.html",""],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[77,"هلم فما بيني وبينك ثالث","https://www.aldiwan.net/poem36673.html","الطويل"],[9,"تصابيت أم بانت بعقلك زينب","https://www.aldiwan.net/poem21908.html","الطويل"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[9,"أجد بتيا هجرها وشتاتها","https://www.aldiwan.net/poem21916.html","الطويل"],[71,"ذراها إذا رامت معاجاً إلى الحمى","https://www.aldiwan.net/poem4002.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[72,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[72,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[72,"يخيل لي برق من الثغر لامع","https://www.aldiwan.net/poem19168.html","الطويل"],[72,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[56,"واصل مدامك واهجر قالة الناس","https://www.aldiwan.net/poem58572.html","البسيط"],[56,"وكأس صهباء صرف ما سرت بيد","https://www.aldiwan.net/poem58659.html","البسيط"],[61,"ويوم كاد من قصر","https://www.aldiwan.net/poem51390.html","مجزوء الوافر"],[80,"وكأس نشوان فيها الشمس بازغة","https://www.aldiwan.net/poem31304.html","البسيط"],[80,"بني الثغر لستم في الوغى من بني أمي","https://www.aldiwan.net/poem31307.html","الطويل"],[44,"أصب بحميا كأسها مقتل العذل","https://www.aldiwan.net/poem29689.html","الطويل"],[74,"وكأس أنس قد جلتها المنى","https://www.aldiwan.net/poem12967.html","السريع"],[81,"تبسم عن لما در نظيم","https://www.aldiwan.net/poem61310.html","البسيط"],[21,"غدا جيران أهلك ظاعنينا","https://www.aldiwan.net/poem36142.html","الوافر"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[52,"وكأس كمصباح السماء شربتها","https://www.aldiwan.net/poem27327.html","الطويل"],[48,"أديرا علي الكأس ينقشع الغم","https://www.aldiwan.net/poem65097.html","الطويل"],[48,"لمن دمن تزداد حسن رسوم","https://www.aldiwan.net/poem65257.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8835","البسيط"],[77,"هلُمَّ فما بيني وبينَكَ ثالثُ","https://www.poetsgate.com/ViewPoem.aspx?id=33656",""],[56,"وكأس صهباءَ صِرْفٍ ما سَرَتْ بِيَدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3533",""],[100,"بعد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=50191",""],[94,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[110,"أبادت بقايا الصبر طارقة الدهر","https://www.aldiwan.net/poem16306.html","الطويل"],[116,"غرام لا يقابل غرام","https://www.aldiwan.net/poem41659.html","الوافر"],[199,"أديراها على الزهر المندى","https://www.aldiwan.net/poem51932.html","الوافر"],[205,"دعي لومي فلست بذي اعتذار","https://www.aldiwan.net/poem53303.html","الوافر"],[230,"وكأس تعيد العسر يسرا وتجتني","https://www.aldiwan.net/poem51087.html","الطويل"],[257,"وليس العيش إلا شرب راح","https://www.aldiwan.net/poem48470.html","الوافر"],[260,"هزار هيامي بالصبابة يصدح","https://www.aldiwan.net/poem35960.html","الطويل"],[271,"أكاد أذوب يا أم الأمين","https://www.aldiwan.net/poem35008.html","الوافر"],[347,"وكأس سباها البحر من أرض بابل","https://www.aldiwan.net/poem23975.html","الطويل"],[372,"هو اليأس إلا من حديث مقوت","https://www.aldiwan.net/poem57517.html","الطويل"],[372,"رضيت بمعصية العاتب","https://www.aldiwan.net/poem57529.html","المتقارب"],[394,"وكأس تقول العين عند جلائها","https://www.aldiwan.net/poem53542.html","الطويل"],[407,"عصى العواذل إذ لجت عواذله","https://www.aldiwan.net/poem50132.html","البسيط"],[442,"سلوا هل تروا خلقا وإن عز باقيا","https://www.aldiwan.net/poem14491.html","الطويل"],[453,"وكأس وندمان وساق وقينة","https://www.aldiwan.net/poem13882.html","الطويل"],[459,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[469,"لأحسن من مصافحة الصفاح","https://www.aldiwan.net/poem60291.html","الوافر"],[487,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[539,"أدام الله أيام الخليفه","https://www.aldiwan.net/poem47554.html","عموديه"],[554,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"],[554,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[568,"تمنينت من خدها قبلة","https://www.aldiwan.net/poem69775.html","المتقارب"],[576,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[576,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"]],"verses":[["وَكَأسي مُعَوِّدَةٌ بِالسَماعِ","تَركُضُ بَينَ القُلوبِ الطِرابِ",0,"ب",1,0],["وكأسٍ كأنّ الشّمسَ ألقَتْ رِداءَها","علَيها بحَيثُ الشُّهْبُ مَثْنى ووحدانُ",1,"ن",1,0],["وَكاساتُ الأَسِنَّةِ لي شَرابٌ","أَلَذُّ بِهِ اِصطِباحاً وَاِغتِباقا",2,"ق",2,0],["وَكَاسَيْنِ لَكِنْ مِنْ كِتَابَيْنِ مُعْلِنِ","بِمَا كَانَ مِنْ قُرْبِ الْحُسَيْنِ وَمُعْلِمِ",3,"م",1,0],["وكأسُ عِتابٍ في الهَوى نقْلُها الرِّضَى","يُديرُ حُمَيّاها النّديمُ المُحادِثُ",4,"ث",1,0],["وَكَأسٍ كَعَينِ الديكِ باكَرتُ حَدَّها","بِفِتيانِ صِدقٍ وَالنَواقيسُ تُضرَبُ",5,"ب",1,0],["وَكَأسٍ شَرِبتُ عَلى لَذَّةٍ","وَأُخرى تَداوَيتُ مِنها بِها",6,"ب",3,0],["وَكَأسٍ كَماءِ النَيِّ باكَرتُ حَدَّها","بِغِرَّتِها إِذ غابَ عَنّي بُغاتُها",7,"ت",3,0],["وَكَأسٍ حَباها بِالحَبابِ مِزاجُها","فَأَلقى عَلَيها المَزجُ عِقداً مُنَظَّما",8,"م",2,0],["وَكَأسٍ قَد شَرِبتُ بِبَعلَبَكٍّ","وَأُخرى في دِمَشقَ وَقاصِرينا",9,"ن",2,0],["وكاسات أشد يدي عليها","مخافة أن تطير من الجماح",10,"ح",1,0],["وكأس ألفاظٍ عِذابٍ إذا","مازجها كافور ثلج نضح",11,"ح",1,0],["وكأس لغيري أصفر من نضارها","ولي من لمى المحبوب للهمِّ فاقع",12,"ع",1,0],["وكأس الحمد في يمناه يملا","بممزوج اللّطافه والشهامهْ",13,"م",2,0],["وكَأْسِ خَمْرٍ كَماءِ التِّبْرِ لابسَةٍ","وِشَاحَ شَذْرٍ تُزْجيِّهِ إِلى طَاسِ",14,"س",1,0],["وكأسِ صَهْباءَ صِرْفٍ ما سَرَتْ بِيَدٍ","إلى فَمٍ ما طَعْمُ ضَرَّاءِ",15,"ا",2,1],["وكأس اللهو دانية","تجول كأنها لهب",16,"ب",1,0],["وكأسِ نشوانَ فيها الشمسُ بازغةٌ","باتت تديمُ إلى الإصباحِ لثَمَ فَمِه",17,"ه",1,1],["وكأسٍ بأُمّ الموْتِ يَسعى مُديرُهَا","إلى أهلِ كأسٍ حَثها بابنةِ الكرم",18,"م",1,0],["وَكَأسٍ كَمَعسولِ الأَماني شَرِبتُها","وَلَكِنَّها أَجلَت وَقَد شَرِبَت عَقلي",19,"ل",2,0],["وَكَأسِ أُنسٍ قَد جَلَتها المُنى","فَباتَتِ النَفسُ بِها مُعرِسَه",20,"س",2,1],["وكأسُ الرَّاحِ تُجلى في رِيَاض","حكت في الوصفِ جنَّاتِ النَّعِيمِ",21,"م",1,0],["وَكأسٍ قَد شُرِبَت بِماءِ ثَلجٍ","وأُخرى قَد شُرِبَت بِقاصِرينا",22,"ن",2,0],["وَكَأسٍ تَلَقَّيتُ الصَباحَ بِشُربِها","وَأَسقَيتُها شَرباً كِراماً وَأَصحابا",23,"ب",2,0],["وَكَأسٍ سَبَقتُ إِلى شُربِها","عَذولي كَذَوبِ عَقيقٍ جَرى",24,"ا",1,0],["وَكَأسٍ كَمِصباحِ السَماءِ شَرِبتُها","عَلى قُبلَةٍ أَو مَوعِدٍ بِلِقاءِ",25,"ا",2,1],["وَكَأسانِ قَد دارا عَلَيَّ مُؤَمَّرٌ","وَمُنتَخَبٌ هَذا فَصيلٌ وَذا قَرمُ",26,"م",1,0],["وَكَأسٍ كَعَينِ الديكِ باتَت تَعُلُّني","عَلى وَجهِ مَعبودِ الجَمالِ رَخيمِ",27,"م",1,0],["وكاسي الأرامل الحرّات","وحالب الأغنام للجارات",28,"ت",1,0],["وَكَأس ثكلٍ عَلى رِيٍّ شَرِبتُ بِها","فَرُحتُ مِنها بِتَمريصٍ وَتَمريثِ",29,"ث",1,0],["وَكَأسِ حَبرِيَّةٍ شَكَّت بِمَبزَلِها","أَحشاءَ مُشعَلَةٍ بِالقارِ جَوفاءِ",30,"ا",2,0],["وكأس عتابٍ في الهوى نُقْلُها الرضا","يدير حمَّياها النَّديمُ المحادِثُ",31,"ث",1,0],["وكأس صهباءَ صِرْفٍ ما سَرَتْ بِيَدٍ","إلى فمٍ فَدَرى ما طَعْمُ ضَرّاءِ",32,"ا",2,1],["وكأس من الشوق والذكريات","وأغنية من شذاك المثير",33,"ر",1,0],["وكأس تساقينا ثلاثين حجّة","عذوبتها طبع وتقطيبها كسب",34,"ب",1,0],["وَكَأسيَ فيها كانَ درديَ يسرة","مَحَت رَسمَهُ منّا مُنادَمةُ العُسر",35,"ر",1,0],["وكاسات السرور تدور فينا","بمعنى لا يماثله مدام",36,"م",1,0],["وكأسُ الراحِ تنظرُ عن حَبابٍ","يَنوبُ لنا عن الحَدَقِ المِراض",37,"ض",1,0],["وكأس قد سُقيت على وجوهٍ","بَهيَّاتٍ بكفي جلَّنارِ",38,"ر",1,0],["وكأسٍ تُعيد العسر يسرا وتجتني","ثمارَ الغِنى للشَرْب من شجر الفقرِ",39,"ر",1,1],["وكأسٍ يعدل الساقون فيها","ولكن حكم سورتها يجورُ",40,"ر",1,0],["وكأس غرامي فاض من خمر حبّه","وكلّ إناءٍ بالّذي فيه ينضحُ",41,"ح",1,0],["وكاسٌ من عديٍّ عِند هندٍ","وياقوتٌ على درٍ ثمين",42,"ن",1,0],["وَكَأسٍ سَباها البَحرُ مِن أَرضِ بابِلٍ","كَرِقَّةِ ماءِ المُزنِ في الأَعيُنِ النُجلِ",43,"ل",1,1],["وكأسٍ عليها مسحةٌ من مُديرها","مذاقاً وتشبيهاً بريقٍ ووَجنةِ",44,"ه",1,0],["وكأسٍ عصيتُ على شربها","صُروفاً من الزمنِ الغاصبِ",45,"ب",1,0],["وَكَأسٍ تَقول العَينُ عِندَ جَلائِها","أَهَل لِخُدودِ الغانِياتِ عَصيرُ",46,"ر",1,1],["وَكأَسُنا كَنَسيم المِسكِ عاطِره","يُديرها شادنٌ حُلوٌ شَمائِلُهُ",47,"ل",2,0],["وكأس الذي يسقى به كل مرشد","سقته المنايا كل من كان غاويا",48,"ي",2,0],["وكأسٍ وندمان وساقٍ وقيْنة","أقمتُ بهم رسْمَ السرور المعجَّلِ",49,"ل",1,1],["وكاسٍ من العلياء والحسنِ يعتدي","سليما على سيفي وسَوطِيَ سالِبُهْ",50,"ب",2,0],["وَكاساتٌ تَدورُ عَلى النَدامى","بِأَجسامٍ لَها أَرواحُ راحِ",51,"ح",1,0],["وَكَأسٌ بِأَيدي الساقِيَينِ رَوِيَّةٌ","يُمِدّانِ راوُقيهِما حينَ تُنزَفُ",52,"ف",1,0],["وكأسٍ لا أُطيقُ لهَا اصطِبَارا","مِن السَّاقِي وإن دَارت خَفِيفَه",53,"ف",2,0],["وَكَأسِ نَدامى يَعشَقُ الشُربُ شَخصَها","لَها مَنظَرٌ دونَ الزُجاجَةِ أَسهَلُ",54,"ل",1,0],["وَكَأسِ راحٍ يُميتُ الهَمَّ شارِبُها","باكَرتُها وَرِداءُ اللَيلِ قَد حَسَرا",55,"ر",2,0],["وكاسات أفراحي براحي وراحتي","دهاق وأيامي المواضي رواجع",56,"ع",1,0],["وكأساً أناولُها مِلْؤُها","فَتَبْدُو وأَشْرَبُ من فَضْلَتِهْ",57,"ت",2,0],["وكاسِرَ الْجَفْنِ الَّذي هُدْ به","قَلْبي بِه فِي مِخْلَبيْ كَاسِر",58,"ر",1,0],["وكاسِرَ الجَفْنِ إِي والله ما انكسرت","فيكَ الجوانحُ إِلاَّ بعد كسرتِه",59,"ت",2,0]]}