try.dctabudhabi.ae/diwan/poem/97071","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45136","المنسرح"],[4242,"","https://poetry.dctabudhabi.ae/diwan/poem/202627","الوافر"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198555","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66120","المتقارب"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96081","الطويل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105180","الوافر"],[4684,"هموم التبغ !","https://www.poetsgate.com/ViewPoem.aspx?id=201033",""],[4717,"مرثية الدكتور أحمد زويل","https://www.poetsgate.com/ViewPoem.aspx?id=199624",""],[4955,"كلام متنه الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=188728",""],[5038,"غنّى الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=189332",""],[5038,"نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=190127",""],[5121,"كأس الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=33579",""],[778,"وكأس كنجح الوعد ممن احبه","https://www.poetsgate.com/ViewPoem.aspx?id=89227",""],[5713,"نعم هِيَ دَار من نهوى يَقِينا","https://www.poetsgate.com/ViewPoem.aspx?id=189216",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5828,"وكأس من الشَّمْس مخلوقة","https://www.poetsgate.com/ViewPoem.aspx?id=190972",""],[5897,"بين رمضان والعيد","https://www.poetsgate.com/ViewPoem.aspx?id=156847",""],[5949,"وكأس كساها الحسن ثوب ملاحةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181660",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[6102,"رب القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=184158",""],[6124,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=103197",""],[6124,"كأس اللوعة","https://www.poetsgate.com/ViewPoem.aspx?id=201264",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["وَكَأسي مُعَوِّدَةٌ بِالسَماعِ","تَركُضُ بَينَ القُلوبِ الطِرابِ",0,"ب",1,0],["وكأسٍ كأنّ الشّمسَ ألقَتْ رِداءَها","علَيها بحَيثُ الشُّهْبُ مَثْنى ووحدانُ",1,"ن",1,0],["وَكاساتُ الأَسِنَّةِ لي شَرابٌ","أَلَذُّ بِهِ اِصطِباحاً وَاِغتِباقا",2,"ق",2,0],["وَكَاسَيْنِ لَكِنْ مِنْ كِتَابَيْنِ مُعْلِنِ","بِمَا كَانَ مِنْ قُرْبِ الْحُسَيْنِ وَمُعْلِمِ",3,"م",1,0],["وكأسُ عِتابٍ في الهَوى نقْلُها الرِّضَى","يُديرُ حُمَيّاها النّديمُ المُحادِثُ",4,"ث",1,0],["وَكَأسٍ كَعَينِ الديكِ باكَرتُ حَدَّها","بِفِتيانِ صِدقٍ وَالنَواقيسُ تُضرَبُ",5,"ب",1,0],["وَكَأسٍ شَرِبتُ عَلى لَذَّةٍ","وَأُخرى تَداوَيتُ مِنها بِها",6,"ب",3,0],["وَكَأسٍ كَماءِ النَيِّ باكَرتُ حَدَّها","بِغِرَّتِها إِذ غابَ عَنّي بُغاتُها",7,"ت",3,0],["وَكَأسٍ حَباها بِالحَبابِ مِزاجُها","فَأَلقى عَلَيها المَزجُ عِقداً مُنَظَّما",8,"م",2,0],["وَكَأسٍ قَد شَرِبتُ بِبَعلَبَكٍّ","وَأُخرى في دِمَشقَ وَقاصِرينا",9,"ن",2,0],["وكاسات أشد يدي عليها","مخافة أن تطير من الجماح",10,"ح",1,0],["وكأس ألفاظٍ عِذابٍ إذا","مازجها كافور ثلج نضح",11,"ح",1,0],["وكأس لغيري أصفر من نضارها","ولي من لمى المحبوب للهمِّ فاقع",12,"ع",1,0],["وكأس الحمد في يمناه يملا","بممزوج اللّطافه والشهامهْ",13,"م",2,0],["وكَأْسِ خَمْرٍ كَماءِ التِّبْرِ لابسَةٍ","وِشَاحَ شَذْرٍ تُزْجيِّهِ إِلى طَاسِ",14,"س",1,0],["وكأسِ صَهْباءَ صِرْفٍ ما سَرَتْ بِيَدٍ","إلى فَمٍ ما طَعْمُ ضَرَّاءِ",15,"ا",2,1],["وكأس اللهو دانية","تجول كأنها لهب",16,"ب",1,0],["وكأسِ نشوانَ فيها الشمسُ بازغةٌ","باتت تديمُ إلى الإصباحِ لثَمَ فَمِه",17,"ه",1,1],["وكأسٍ بأُمّ الموْتِ يَسعى مُديرُهَا","إلى أهلِ كأسٍ حَثها بابنةِ الكرم",18,"م",1,0],["وَكَأسٍ كَمَعسولِ الأَماني شَرِبتُها","وَلَكِنَّها أَجلَت وَقَد شَرِبَت عَقلي",19,"ل",2,0],["وَكَأسِ أُنسٍ قَد جَلَتها المُنى","فَباتَتِ النَفسُ بِها مُعرِسَه",20,"س",2,1],["وكأسُ الرَّاحِ تُجلى في رِيَاض","حكت في الوصفِ جنَّاتِ النَّعِيمِ",21,"م",1,0],["وَكأسٍ قَد شُرِبَت بِماءِ ثَلجٍ","وأُخرى قَد شُرِبَت بِقاصِرينا",22,"ن",2,0],["وَكَأسٍ تَلَقَّيتُ الصَباحَ بِشُربِها","وَأَسقَيتُها شَرباً كِراماً وَأَصحابا",23,"ب",2,0],["وَكَأسٍ سَبَقتُ إِلى شُربِها","عَذولي كَذَوبِ عَقيقٍ جَرى",24,"ا",1,0],["وَكَأسٍ كَمِصباحِ السَماءِ شَرِبتُها","عَلى قُبلَةٍ أَو مَوعِدٍ بِلِقاءِ",25,"ا",2,1],["وَكَأسانِ قَد دارا عَلَيَّ مُؤَمَّرٌ","وَمُنتَخَبٌ هَذا فَصيلٌ وَذا قَرمُ",26,"م",1,0],["وَكَأسٍ كَعَينِ الديكِ باتَت تَعُلُّني","عَلى وَجهِ مَعبودِ الجَمالِ رَخيمِ",27,"م",1,0],["وكاسي الأرامل الحرّات","وحالب الأغنام للجارات",28,"ت",1,0],["وَكَأس ثكلٍ عَلى رِيٍّ شَرِبتُ بِها","فَرُحتُ مِنها بِتَمريصٍ وَتَمريثِ",29,"ث",1,0],["وَكَأسِ حَبرِيَّةٍ شَكَّت بِمَبزَلِها","أَحشاءَ مُشعَلَةٍ بِالقارِ جَوفاءِ",30,"ا",2,0],["وكأس عتابٍ في الهوى نُقْلُها الرضا","يدير حمَّياها النَّديمُ المحادِثُ",31,"ث",1,0],["وكأس صهباءَ صِرْفٍ ما سَرَتْ بِيَدٍ","إلى فمٍ فَدَرى ما طَعْمُ ضَرّاءِ",32,"ا",2,1],["وكأس من الشوق والذكريات","وأغنية من شذاك المثير",33,"ر",1,0],["وكأس تساقينا ثلاثين حجّة","عذوبتها طبع وتقطيبها كسب",34,"ب",1,0],["وَكَأسيَ فيها كانَ درديَ يسرة","مَحَت رَسمَهُ منّا مُنادَمةُ العُسر",35,"ر",1,0],["وكاسات السرور تدور فينا","بمعنى لا يماثله مدام",36,"م",1,0],["وكأسُ الراحِ تنظرُ عن حَبابٍ","يَنوبُ لنا عن الحَدَقِ المِراض",37,"ض",1,0],["وكأس قد سُقيت على وجوهٍ","بَهيَّاتٍ بكفي جلَّنارِ",38,"ر",1,0],["وكأسٍ تُعيد العسر يسرا وتجتني","ثمارَ الغِنى للشَرْب من شجر الفقرِ",39,"ر",1,1],["وكأسٍ يعدل الساقون فيها","ولكن حكم سورتها يجورُ",40,"ر",1,0],["وكأس غرامي فاض من خمر حبّه","وكلّ إناءٍ بالّذي فيه ينضحُ",41,"ح",1,0],["وكاسٌ من عديٍّ عِند هندٍ","وياقوتٌ على درٍ ثمين",42,"ن",1,0],["وَكَأسٍ سَباها البَحرُ مِن أَرضِ بابِلٍ","كَرِقَّةِ ماءِ المُزنِ في الأَعيُنِ النُجلِ",43,"ل",1,1],["وكأسٍ عليها مسحةٌ من مُديرها","مذاقاً وتشبيهاً بريقٍ ووَجنةِ",44,"ه",1,0],["وكأسٍ عصيتُ على شربها","صُروفاً من الزمنِ الغاصبِ",45,"ب",1,0],["وَكَأسٍ تَقول العَينُ عِندَ جَلائِها","أَهَل لِخُدودِ الغانِياتِ عَصيرُ",46,"ر",1,1],["وَكأَسُنا كَنَسيم المِسكِ عاطِره","يُديرها شادنٌ حُلوٌ شَمائِلُهُ",47,"ل",2,0],["وكأس الذي يسقى به كل مرشد","سقته المنايا كل من كان غاويا",48,"ي",2,0],["وكأسٍ وندمان وساقٍ وقيْنة","أقمتُ بهم رسْمَ السرور المعجَّلِ",49,"ل",1,1],["وكاسٍ من العلياء والحسنِ يعتدي","سليما على سيفي وسَوطِيَ سالِبُهْ",50,"ب",2,0],["وَكاساتٌ تَدورُ عَلى النَدامى","بِأَجسامٍ لَها أَرواحُ راحِ",51,"ح",1,0],["وَكَأسٌ بِأَيدي الساقِيَينِ رَوِيَّةٌ","يُمِدّانِ راوُقيهِما حينَ تُنزَفُ",52,"ف",1,0],["وكأسٍ لا أُطيقُ لهَا اصطِبَارا","مِن السَّاقِي وإن دَارت خَفِيفَه",53,"ف",2,0],["وَكَأسِ نَدامى يَعشَقُ الشُربُ شَخصَها","لَها مَنظَرٌ دونَ الزُجاجَةِ أَسهَلُ",54,"ل",1,0],["وَكَأسِ راحٍ يُميتُ الهَمَّ شارِبُها","باكَرتُها وَرِداءُ اللَيلِ قَد حَسَرا",55,"ر",2,0],["وكاسات أفراحي براحي وراحتي","دهاق وأيامي المواضي رواجع",56,"ع",1,0],["وكأساً أناولُها مِلْؤُها","فَتَبْدُو وأَشْرَبُ من فَضْلَتِهْ",57,"ت",2,0],["وكاسِرَ الْجَفْنِ الَّذي هُدْ به","قَلْبي بِه فِي مِخْلَبيْ كَاسِر",58,"ر",1,0],["وكاسِرَ الجَفْنِ إِي والله ما انكسرت","فيكَ الجوانحُ إِلاَّ بعد كسرتِه",59,"ت",2,0],["وَكَأسٌ مِثلُ عَينِ الديكِ صِرفٌ","لَها حَبَبٌ كَمَنظومِ الجُمانِ",60,"ن",1,0],["وكأس من الماء مخروطة","تنير لها مثل نور النهار",61,"ر",1,1],["وكَأسٍ تَمشّى في العِظامِ سبيئةٍ","من الرَّاحِ تعلو الماءَ حتى تكاثِره",62,"ر",2,0],["وَكَأسٌ تَمتَطي أَطرافَ كَفٍّ","كَأَنَّ بَنانَها مِن أُرجُوانِ",63,"ن",1,1],["وكاسرا باطِلَ ما أبدعُوا","نَفْسي فِدَاء الكاسِرِ الجَابر",64,"ر",1,0],["وكاسٌ من الباري لنا محتمٌ به","فلا بد أن نسقاهُ يوماً ونهجعُ",65,"ع",1,0],["وَكأُسُ ثَغْرٍ شهِيٍّ مُنذُ فُزْتُ بِهِ","قُلتُ الْعفاءُ عَلى كَأْسِ ابنَةِ الْعِنَبِ",66,"ب",1,0],["وكأسٌ مِنْ عيونِ العِي","نِ باللَّحظِ شَرِبْناها",67,"ا",3,0],["وكَأْس ثَغْرٍ صَبَحْتِنيهِ وقد","حَيَّيْتِ بالوَرْدِ مِنْ مُحيَّاكِ",68,"ك",1,0],["وكَأْسِ راحٍ يُديرُها قَمَرٌ","لِحاظُهُ في قُلوبِنا تَجْرَحْ",69,"ح",1,0],["وكاسم فاعل من الآحاد","أضف إلى عشر من الأعداد",70,"د",1,0],["وكأس شربناها لدى الشيخ بالظهر","تساوى بها الإِسرارُ منَّا مع الجهر",71,"ر",1,1],["وكأسِ مُدامٍ يحلفُ الدِّيكُ أنَّها","لدى المزجِ من عينيه أصفى وأنورُ",72,"ر",1,1],["وكأسٍ تَرى بين الإناء وبينها","قَذى العين قد نازعتُ أمَّ أبانِ",73,"ن",1,1],["وكاسمِ أَبِيهِ حُبُّه في جَوانِحِي","فَما دُمتُ أَبقَى لَيسَ يَفتَأُ بَاقِيَا",74,"ي",2,0],["وَكَأساً سَقانيها كَقِنديلِ بَيعَةٍ","بِها وَبِهِ في ظُلمَةِ اللَيلِ نَهتَدي",75,"د",2,0],["وكاساتُ حزني بالمصاب طوافحُ","فسامِح اذا ما كنتُ ذات جريمةٍ",76,"ه",1,0],["وكاسف البال بالي الصبر جدت له","بوابلٍ من وبال الخزي متّصِل",77,"ل",1,0],["وَكأسٍ كعينِ الديكِ قَبلَ صِياحِهِ","شَرِبتُ بِزهر لَم يَضرني ضَريرُها",78,"ر",3,0],["وكاسيةٍ رزقاً سواها يحوزهُ","وليس لها حمدٌ عليهِ ولا أَجرُ",79,"ر",1,1],["وكاساته نعم الكؤوس وأهله","ولا سيما مثنى ثلاثا ومربعا",80,"ع",2,0],["وكأسٍ مِنَ الغدرِ مخلوقةٍ","ولكنها للأمير الوَفي",81,"ف",2,1],["وكأسٌ أدارتها يدُ العدلِ بَينَنا","فيَشرَبُها المَولى كما يشرَبُ العَبدُ",82,"د",1,0],["وكأسٍ من اللَّيل مَخلُوقَة","تَبدَّت من التِّبر فيها نُجوم",83,"م",1,1],["وكأس كلون الأرجوان شربتها","على رغم لاح أو عذول مفند",84,"د",1,1],["وَكأسٌ بأَيدي الساقَيينِ رَويَّةٌ","يُمِدانِ راووقَيهما حين تُنزَفُ",85,"ف",1,0],["وَكَأسٍ كَمُستَدمى الغَزالِ قَرَعتُها","لِأَبيَضَ عَصّاءِ العَواذِلِ مِفضال",86,"ل",1,0],["وكأسٍ لها كيسٌ على اللُّبِ والعقلِ","شمول تُريك الأُنس مجتمع الشمل",87,"ل",1,1],["وكأس راحي ما إن","تمل مني راحة",88,"ح",2,0],["وَكَأسٍ كَريقِ الإِلفِ شَعشَعتُها بِهِ","وَعيشي مِن هَذا الشَّراب المُشَعشَعِ",89,"ع",1,1],["وكاساتنا عند التعاطي كأنها","إذا ما بدا فيها من التبر ذائبه",90,"ب",2,0],["وكاسم مفعول يرى المنسوب","فاحفظ لها فحفظها المطلوب",91,"ب",1,0],["وكاسٍ ترينا آيةَ الصُبح والمَسا","فأولُّها شمسٌ وآخرُها بدرُ",92,"ر",1,1],["وكاسٍ من الزرجون لما شربتُها","على ظمأٍ أروت فؤادي بما فيها",93,"ه",2,1],["وَكَأسَ مدامٍ أَو ندامى عَلى صَفا","وَرَوضاً أَريضاً من أَمانٍ وَمَطمع",94,"ع",1,0],["وَكَأسٍ شَربنا عَلى رَوضةٍ","مِن الخَمر تحكي مذابَ الوَرسْ",95,"س",1,1],["وكأسُهُم في كفِّ أبيضَ ماجد","كريمٍ جَعلْناهُ على القَومِ قَاضِيا",96,"ي",2,0],["وكأسٌ تُورِدُ الموتَ","كريهٌ طعمُها مُرَّه",97,"ر",2,0],["وكأساً في يمين عقيدِ مَلكٍ","تزين صِفاته غُرَرُ المديح",98,"ح",1,0],["وكاسبٌ والمكسبُ","إن لم تغثهم ذهبوا",99,"ب",3,0],["وكأس مدام لو تطعم ريقها","فم الدهر يوما مال ميل المعربد",100,"د",1,0],["وكأس جلاب بها يطفى اللهب","يقضى بها عند الخمار ما وجب",101,"ب",1,1],["وكأس من الجلاب أطفأ بردها","سعير خمار الكأس عند التهابه",102,"ه",1,1],["وكأسك المُشْتَها مُقَبَّلُها","أَنت لأَجلي خلقت أَمْ أَجَلي",103,"ل",2,0],["وَكأَسٍ كَسا الساقي لَنا بَعدَ هَجعَةٍ","حَواشيَها ما مَجَّ مِن رِيقِهِ العِنَب",104,"ب",1,0],["وكأس حتفٍ أذاقوه الجنين به","قد جرعوا طفله في كربلاء ردى",105,"د",2,0],["وَكأسُها يُملا","بالغَنجِ وَالدلّ",106,"ل",1,0],["وكأْسِ مُدامةٍ في كَفِّ خُشِفٍ","رَخيم الدَّلِّ مَلْثوغِ الكلامِ",107,"م",1,1],["وكأس على طيب استماعي لصوتها","شربت ودمع المزن يسعدني جريا",108,"ي",2,1],["وكاسُ الاذاةِ تَرُوقُ الفتى","الهُمامَ الكريمَ الأَبِي الأَلْمَعي",109,"ع",2,0],["وكأسٍ كأنَ المسكَ فيها حسوتُها","ونازعنيها صاحب لي ملوّم",110,"م",1,1],["وكأس طلا يشعشعها كحيل","غرير لا يشابهه غرير",111,"ر",1,0],["وكأسي علقمٌ ماعاد فيه","سوى وجعٍ علا بؤس الشُّفافةْ",112,"ف",2,0],["وكأسُ الموتِ دائرةٌ تنادي","وقد لبَّى المنعَّمُ والذليلُ",113,"ل",1,0],["وكاسيةٍ كعاريةٍ","لتجذبَ نحوها الأحداقْ",114,"ق",1,0],["وَكَأْسٌ مِنْ طِلى الْأَنْخابِ تَجْلو","نَسيماً بَلَّ أَشْواقَ الدُّهورِ",115,"ر",1,0],["وَكَأْسُهُ الثّغْرُ وَالْأحْداقُ وادِقَةٌ","وَالْخَدُّ يَنْثرُ عِطْرَ الْوَرْدِ وَالْحَبَقِ",116,"ق",1,0],["وكأسٌ دِهاقٌ رَوَتْ بالجروحِ","شرابٌ لدهري بسيلٍ طَفوحِ",117,"ح",1,1],["وكأس كنجح الوعد ممن احبه","تناولتها منه على غير موعد",118,"د",1,1],["وكاسات المسرة دائرات","تحيينا شمالاً أَو يَمِينا",119,"ن",2,0],["وكأسا من حنايانا عتاقٍ","من الخمر المباحة رشفتين",120,"ن",1,0],["وكأس من الشَّمْس مخلوقة","تضمنها قدح من نَهَار",121,"ر",1,1],["وكأسٍ تساقى الفائزون رحيقه","على أن طعمَ الفقدِ من فيهِ دفاقُ",122,"ق",1,0],["وكأس كساها الحسن ثوب ملاحةٍ","فحارت ضياء يشبه الحسن والشمسا",123,"س",2,1],["وكأسُ غرامي أُفرِغَتْ من وصالها","وكأسهمُ (و) منها مِلاءٌ ونُصَّفُ",124,"ف",1,0],["وَ كَأسًا مِنْ رَحِيقٍ كَانَ ثَغرِي","بِها يَسقِيكِ ؛ خَمرِيَّ الرَّواءِ ؟",125,"ا",1,0],["وكأسُ الهوى الملآنِ غرّدَ لحنها","مُراقاً ورقراقاً لينشد قصرَها",126,"ر",3,0],["وَكَأَسُ اللَّوْعَةِ الحَيْرَى","عَلامَ العُمرَ يَسْقِيْكَ.",127,"ك",1,0],["وكأسٍ غيمةٍ هَطَلَت عَليها","رياحُ نَدىً فباحَ لها الغَريبُ",128,"ب",1,0],["وكاسياتٌ تنتَظِرْ","شتَّى الشّيَاتِ كالحبَرْ",129,"ر",1,0]]}