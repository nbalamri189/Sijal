,2,0],["وأخافني فيك العذولُ وما درى","إني لجودك في الهوى أتشوّق",2,"ق",1,0],["وأخاف العيد يأتي","وأنا قطعة لحم",3,"م",1,0],["وإخالُ ذلك لم يزد","في خُبثه لكن أطابهْ",4,"ب",2,0],["وإخال أنِّي للخضاب محالفٌ","وَهُوَ المحالف لا محالَةَ ينكثُ",5,"ث",1,0],["وإخالُ أنك قائلٌ","فيها لنسوتنا فَرَجْ",6,"ج",1,0],["وإخالُ أنِّي لوْ سَطَوْتُ لَقَالَ لي","لا تَسْلُبِ السَّلَبَ الكريم ولوْ جُرحْ",7,"ح",1,0],["وإخال أن عِداك قد عَطَفَتْهُم","كفَّاك بالإرفاد فالإِرفادِ",8,"د",1,0],["وإخال الضرير لو قابلتْهُ","عاد من نورها الضرير بصيرا",9,"ر",2,0],["وإخال أني جاعل فمعجّلٌ","بيني وبينك عفتي والياسا",10,"س",2,0],["وأخاف المُخيف ذا العيْث حتَّى","أمِن الخائفُ المشتَّتُ شمْلا",11,"ل",2,0],["وأخاه هارون الذي أضحى له","في الصالحات مُشاكلاً وملائما",12,"م",2,0],["وإخالُ الإيوانَ لو كان يسعى","جاء سعياً إليك قبل الأذان",13,"ن",1,0],["وإخالُ أنك لا تَمُجُّ إطالتي","إلا كراهةَ أن تكونَ الغابنا",14,"ن",2,0],["وَأَخّاذُ أَقصى الحَقِّ لا مُتَهَضَّمٌ","أَخوهُ وَلا هَشُّ القَناةِ رَذيلُها",15,"ل",3,0],["واخال الزمان حبلا طويلا","ستراني يوما به مشنوقا",16,"ق",2,0],["واخاف ان يقضى لشدة","ما المّ به انتحارا",17,"ر",2,0],["وَأَخاً سَقى الإِخوانَ مِن رَاوقِهِ","بِوِدادِ لا صَلِفٍ وَلا تَيّاهِ",18,"ا",2,0],["وَإِخالُني مُتَقَرِّباً مِن شاسِعٍ","بِوِدادِهِ وَمُواصِلاً لِمُجانِبِ",19,"ب",1,0],["وَأَخٍ أَتاني عَتبُهُ وَكَأَنَّهُ","سَيفٌ عَلَيَّ مَعَ العَدُوِّ مُجَرَّدُ",20,"د",1,0],["وَإِخاءٍ مِنهُ لَو يُعرَضُ لِل","بَيعِ في سوقِ الثَلاثا ما نَفَق",21,"ق",1,0],["وَأَخٍ أَرابَ فَلَم أَجِد في أَمرِهِ","إِلّا التَماسُكَ عَنهُ وَالهِجرانا",22,"ن",2,0],["وَأَخاكَ إِذ فَتَحَ الإِلَهُ بِهِ","وَأَعَزَّهُ بِاليُمنِ وَالنَصرِ",23,"ر",1,0],["وَأَخاهُ وَاِبنَيهِ الَّذينِ هُما","كانا يَدَيهِ وَخالِصَ الصَدرِ",24,"ر",1,0],["وَأَخٍ أَملى عَلَيهِ اِختِلاطُ ال","دَهرِ طولَ التَقليبِ وَالتَصريفِ",25,"ف",1,1],["وَأَخافَكُم كَي تُغمِدوا أَسيافَكُم","إِنَّ الدَمَ المُغتَرَّ يَحرُسُهُ الدَمُ",26,"م",1,0],["وَإِخالُ أَنَّ نَواهُمُ قَذّافَةٌ","كانَت مُعاوِدَةَ الفِراقِ مِرارا",27,"ر",2,0],["وَإِخالُها بَينَ الحَطيمِ وَزَمزَمٍ","ضُرِحَت لَهُم أَو في عِراصِ الفَرقَدِ",28,"د",1,0],["وَأَخافُ أَن أُبدي مَوَدَّتَها","فَيَغارُ مَولاها وَيَستَشري",29,"ر",2,0],["وَأَخٍ إِن جاءَني في حاجَةٍ","كانَ بِالإِنجازِ مِنّي واثِقا",30,"ق",2,1],["وَأَخالُ نَفسي حينَ تَفقِدُ شَخصَها","تَلقى الَّذي عَمِلَتهُ قَبلَ مَعادِ",31,"د",1,0],["وَإِخالُنا في البَحرِ لَيسَ بِسالِمٍ","مِنهُ الَّذي رَكِبَ الغَوارِبَ ماهِرا",32,"ر",2,0],["وأَخاً فِي وَدَادِهِ","رَأَى إِخْوَانَهُ ائْتَلَفْ",33,"ف",1,0],["وأَخَاكَ تَذْكُرُ فِي أَسًى","لَوْ لَمْ تَكُنْ ثَبْتاً أَبادَك",34,"ك",1,0],["وإخال النبات يبكي حنينا","كلما سال الطَّلُّ منه سجاما",35,"م",2,0],["وإخال الممشى يسترخي","ويلحن خطرتك الكسلى",36,"ل",2,0],["وأخال أنّ البدر يحمل منكم","نبأ إليّ إذا أطلّ ولاحا",37,"ح",2,0],["وَأخَاهُ وابْنَيْهِ اللّذَينِ هُمَا","كَانَا يَدَيْهِ وَخَالِصَ الصّدْر",38,"ر",1,0],["وأخاً سَقى الإخوانَ مِنْ راووقِه","بودادِ لا صَلِفٍ، ولا تَيّاه",39,"ا",2,0],["وأخاف إن طالت جذور تقشفي","أن يدعيني القصر من شيخانه",40,"ن",2,0],["وأخَا المعالِى والعلا","والناصر بن الناصرِ",41,"ر",1,0],["وإخال أنّك لستَ ناسيَهُ","لكنّنى استظهرتُ بالذِّكر",42,"ر",1,0],["وَإِخالُهُ يَأبى الثَدِيَّ بِعِزَّةٍ","حَتّى تَدُرَّ لَهُ الثَناءَ فَيَرضَعا",43,"ع",2,0],["وأخا الندى والبأس وال","منن العريضة والمديده",44,"د",2,0],["واخاف ذنبي ثم أذكر فضلكم","ويقول حسن الظن لا تخشاه",45,"ا",2,0],["وَأَخٍ إِذا ما شَطَّ عَني رَحلُهُ","أَدنى إِلَيّ عَلى النَوى مَعروفهُ",46,"ه",1,1],["وَإِخالُ أَنَّكَ سَوفَ تَلقى مِثلَها","في صَفحَتَيكَ سِنانُها المَسنونُ",47,"ن",1,0],["وَأُخَاطِبُ الْبَدْرَ الْمُنِيرَ إِذَا بَدَا","يَا بَدْرُ إِنَّ الْبَدْرَ مِنْ يَرْبُوعِ",48,"ع",1,0],["وَأَخالُ خالاً لاحَ لي في خَدِّهِ","هُوَ حَبَّةُ القَلبِ الَّذي أَودَعتُهُ",49,"ت",2,0],["وَأَخافُ أَن تَمتَدَّ عِندَ قُدومِهِ","أَفَلا أَرِشُ طَريقَهُ بِدموعي",50,"ع",2,0],["وَأَخافُ سَلباً بَعدَ ذاكَ يَسوءُني","حاشا وَحَقُّ جَلالِهِ لَن يَفعَلا",51,"ل",2,0],["وإخالُ الأنام يدرون ماكا","نَ فأمضى والنار في أحشائي",52,"ي",1,0],["وَأَخا الوزارة من عَلا","لُبنان فيهِ وَنال عزَّا",53,"ز",2,0],["وَأَخا شَمائِلَ أَصبَحَت","كَالماءِ يُمزَجُ بِالمُدامَه",54,"م",2,0],["وأَخافُ من تشنيعِهمْ لو جُرْتُ في","حُكمٍ وليس يُخافُ منْ تَشْنيعي",55,"ع",2,0],["وَأَخافُ سَطوَتَها فَأَمزُجُها","لَقَد اِتَّقَيتُ القَتلَ بِالقَتلِ",56,"ل",1,0],["وأَخافُ اختِلالَ را","مٍ وإِفلات منحَرِف",57,"ف",1,0],["وأخاً أنوا طلعته","ترشد الغاوي إلى رشده",58,"د",2,0],["وأخال الورق في أوراقها","هتفت شوقاً إلى أهل قبا",59,"ب",2,0],["وأخال أن الْوُرْقَ إذ هتفت","في الروض عن وجدي به تنبي",60,"ب",2,0],["وأخاف من تاج العُلا تَطويلَه","لَيلاً فَأَلحق مَلحق ابن خروف",61,"ف",1,0],["وأخافُ أنَّ البينَ يُقذِي ناظِري","بِفِراقِه ما أوْمَضَتْ أشْفَارُهُ",62,"ر",2,0],["واخالفته أعزّة إلّا عذَت","منه رؤوسهم بلا أجسام",63,"م",1,0],["وأخاف أن أعطى إذا نو","قشت باليسرى كتاب",64,"ب",1,0],["وأخاف من جر الزبا","نية الملائكة الغضاب",64,"ب",1,0],["وأخاف من نهش الأفا","عي في اللظى نهش الذئاب",64,"ب",1,0],["وأخاف من تخليدي الني","ران في حر العذاب",64,"ب",1,0],["وأخاف منها أن تق","طع لي الملابس من ثياب",64,"ب",1,0],["وأخاف من زقومها","أكلي ومن حمأ شراب",64,"ب",1,0],["وأخاف إن ناديت ما","لك قال يا ويلي جواب",64,"ب",1,0],["وأخاف من برد الجبا","ل بها ومن ثلج الرواب",64,"ب",1,0],["وأخاف أن أهوي بأق","صى قعرها مثل الشهاب",64,"ب",1,0],["وأخاف أن أدع الإل","ه بها أكن غير المجاب",64,"ب",1,0],["وأخاف هجراً والعَفافُ ذخيرةٌ","أغنى بها عن فاتر الأجفانِ",65,"ن",1,0],["وإخال الأشجار في نثرها","الأوراق تعرين قبل يوم عميق",66,"ق",1,0],["وأخاف الهجاء يا أحقر","الخلق شعورا واضأل الناس ذهنا",67,"ن",2,0],["وأخاف إن نشز القريضُ عليكُمُ","من فرط نفرته إزاءَ سكونهِ",68,"ن",2,0],["وإخالُ أنك سالكٌ بي سُبْلَهُم","وغدت بصدقٍ في الرجال مَخايلي",69,"ل",2,0],["وإخال مشيَ الوخد فيها القهقرى","فإذا الذميلُ وراءه الإيجافُ",70,"ف",1,0],["وإخالُ جودَك نَثْلةً دون الردى","حصداءَ تمنع فَرْجَها الأزرارُ",71,"ر",1,0],["وأخادع اللوام فيكَ وظاهرٌ","نفسُ الشجي وأنه المفؤودِ",72,"د",1,0],["وأخادع الأرواح عن أنفاسهِ","كتماً ويأبى المسكُ غيرَ تضوَّع",73,"ع",1,0],["وأخاف قلب العين حتى شابهُ","ذاك الصُّفارُ ليأسهِ أن يخزنا",74,"ن",2,0],["وأخافُ مِن وَجَعي عليهِ فَقد مَضَتْ","عشرونَ عاما ًبَينَنا تَتَحَسَّرُ",75,"ر",1,0],["وأخاطبُ الأطلالَ ليس يُجيبُني","ما بينهنَّ سِوى الغُرابِ الأبقَعِ",76,"ع",1,0],["وأخاء الود عنه فصرت","جنة الفردوس للملك أمير",77,"ر",1,0],["وَأَخَا الغُصْنِ لا عَراكَ ذُبُولٌ","وَأَخَا البَدْرِ لا دَعاكَ غُروبُ",78,"ب",1,0],["وَأُخالِفُ الشَيخَ التَميمي الَّذي","ما كانَ يَطرَبُ سَمعُهُ نا قوسَها",79,"س",3,0],["وآخاهُ مِن دون أصحابهِ","وقدّمهُ في جَميعِ الأمورِ",80,"ر",1,0],["وأخافُ مِنكَ وأتقي في الإذنِ مِن","غِلظِ الحِجابِ ورِدَّةِ البَوّاب",81,"ب",1,0],["وأخا القضاءِ العدلِ والحَكَم الذي","سوّاه بين عدّوهِ وصديقهِ",82,"ق",2,0],["وأخاف ما يأتي به ال","غدُ من عظيمات المصاعبْ",83,"ب",1,0],["وأخاف الذي يريد من الصل","ح ولو جاء في مقام السؤال",84,"ل",1,0],["وأخاف أن تسعى صلالُ دهاتِه","من بعد ما عبثت عواصفه بنا",85,"ن",2,0],["وَإِخالُها مِن صَدرِهِ قَد أَسفَرَت","وَكَأنَّها إِذ أَسفَرت لم تغرُبِ",86,"ب",1,0],["وأخاف رشقاً من صوائب أسهم","بسنانها حربُ الهوى أصماني",87,"ن",2,0],["واخا ضنك وشاب شايب","وفتى شاخ وفاجاه الهرم",88,"م",1,0],["وَأَخالُ ذاكَ لِعِبرَةٍ عَرَضَت لَها","مِن قَسوَةٍ في القَلبِ أَشبَهتِ الصَفا",89,"ف",2,0],["وَأَخا المَيت إِذا لَم","يَبقَ لِلمَيت صَديق",90,"ق",1,0],["وأخال مرشفها المعسَّل بارداً","وبرشفةٍ منه أُحَمُّ وأصعق",91,"ق",1,0],["وأخاف جن دجىً تتوج بدره","باسم العليِّ ومن وضاءته كُسي",92,"س",2,0],["وأخ إن سطا مضت في الأعادي","عزمة يذهل الردى من سطاها",93,"ا",3,0],["وأخافُ مُرَّ عِتابكم ما لم أَخَف","تحت العجاج عواليَ المُرَّانِ",94,"ن",1,0],["وأخافني ملكي فلما زرتهم","أصبحتُ أقصَدُ مثلهم وأزار",95,"ر",1,0],["وأَخا المكارم يوسفاً فليوسفٍ","فيها مقامٌ ليس بالمذمومِ",96,"م",1,0],["وأخاطبُ القبر الشريفَ مشافِهاً","وأقولُ للفكر القَريحِ ألا ازدَدِ",97,"د",1,0],["وَأَخَافَ الشركَ فاعتصموا","بالجبال الشمِّ من حذره",98,"ر",2,0],["وآخاهُمُ مثلاً لمثلٍ فأصبحت","أخوَّتهُ كالشمسِ ضُمَّت إلى البدرِ",99,"ر",1,0],["وَأَخالُ ثَغرَكَ في فَمي","حيناً فَيحَلو ما أَخال",100,"ل",1,0],["وَأَخالُ مِصرَ قَضَت بِعَهدِ مُلوكِها","وَتَحَنَّطَت مَعهُم بِتِلكَ الأَعصُرِ",101,"ر",1,0],["وَأُخادِعُ الأَيّامَ وَهيَ مَلِيَّةٌ","بِنتاجِ كُلِّ مُلِمَّةٍ لا تُخدَعُ",102,"ع",1,0],["وَأَخافُ فيكَ مِنَ الوُشاةِ وَلَم تَكُن","مِمَّن يُخافُ عَلَيهِ أَن يَتَغَيَّرا",103,"ر",2,0],["وأخا حرب إذا الداعي دعا","باسمها خف لضوضاها اشتياقا",104,"ق",2,0],["وأخا بأس قد ارتاح له ال","دين والكفر به ضاق خناقا",104,"ق",2,0],["وَأَخاف العصاة بِالحَزم حَتّى","صَرف الدَهر عَن طِباع الصُروف",105,"ف",1,0],["وأخاف أن أقضي ولم أقض المنى","بنفوذ سهم منيتي ومروقه",106,"ق",2,0],["وأخاه محمود الفعال أخا العلا","من زينت أوصافه الأقطارا",107,"ر",2,0],["وَأَخاً خَيِّراً عَفيفاً حَييّاً","قَد زَكا فَرعُهُ وَطابَ النِجارُ",108,"ر",1,0],["وأخاف أن تلقي الذي لاقيْته","في الحبّ من وجد ومن حرقات",109,"ت",1,0],["وأخاف أن يَرْمِي سِوا","يَ بسَهمِه ويُقال سَهْمِي",110,"م",2,0],["وأَخافُ أَن تُسدي يداً","أُخرى وليس لديّ شُكْر",111,"ر",1,0],["وَأَخافُ فاجِئَةَ المَنونِ فَإِن تَكُن","فَاِقنِ العَزاءَ فَدَتكَ نَفسي وَاِصبِرِ",112,"ر",1,0],["وأخاف من صحبي فرار هواجسي","فأظلُّ لا مَلَك ولا شيطان",113,"ن",1,0],["وأخاف من حرّ سيقذف بالورى","فالحرّ ينشر كامن الحشرات",114,"ت",1,0],["وأخال الملوك قد غبطوه","وتمنوا ما ناله من سعود",115,"د",1,0],["وأخاف عدواه على","آسٍ عليه موكّل",116,"ل",1,0],["وأخاف إن عاتبته أغريته","فأرى له ترك العتاب عتابا",117,"ب",2,0],["وَأَخافُ إِن طالَ المطا","ل سفت عَلى الأَمل السَوافي",118,"ف",2,0],["وأخالني هيجته بتحسري","أحمامة فوق الأراكة خبري",119,"ي",1,0],["وأخالُهُ حُلُماً لكثرةِ ما أَرى","أَيامه فى طارقِ الأَحْلامِ",120,"م",1,0],["وأخاله يرنو لمضجع جده","دامي الحشاشة والمدامع تهمل",121,"ل",1,0],["وأخ العاقر للناقة في","نفس طه مدرك أقصى مناه",122,"ا",2,0],["وأخالها والدمع يسبق قولها","قد خف قاطنها فعمن تسأل",123,"ل",1,0],["وإخالها تبكي عليك بلوعة","ويكاد فيها الرمل إن يتكلما",124,"م",2,0],["وَأَخاف أَن تَسري سَحيرا نسمة","فَيَقوم مِن سنة الكَرى مُتَذَعِرا",125,"ر",2,0],["وأخال أنك في الدجى","عين المحب الساهر",126,"ر",1,0],["وإخالني لفراقهِ","أُصلى بنيران الزفير",127,"ر",1,0],["وأَخافُ يُدَخّنُ كثْرةٌ ما","يُذْكيهِ هواك ويُخْمِده",128,"د",2,0],["وَأَخالُها في كف من يسعى بِها","صُوراً هيولاها من الوجنات",129,"ت",1,0],["وَأَخالُ أَني قَد سَلَوتُ إِذا جَفا","فَيَقودُني يَومَ اللقا لِأَمان",130,"ن",1,0],["وَأَخالها قد أَوقدت من شهبها","لتزيل ظلمةَ حالتي مصباحا",131,"ح",2,0],["وأخا قُضاعةَ قد أطرتُ فراخه","بالقرنِ حتى خرَّ أهونَ هائنِ",132,"ن",1,0],["وأخاطبُ الغصنَ الرَّطي","بَ وما لخطرته هفوْتُ",133,"ت",1,0],["وأخالط الملل التي اختلفت","في الدين حتى عابد الوثن",134,"ن",1,0],["وأخاها رأت على نعشه في","ه اذلعبت بغاله اذلعباب",135,"ب",1,0],["وآخالهم ذا الحين ما عبئوا","فيه فصانوه كما اعتقدوا",136,"د",3,0],["وأخاف أن يعدو عليه بجهله","فيذيقه ظلماً فنون عقابه",137,"ب",2,0],["وأخاهما عمرو القنا وفوارساً","شُم الأنُوفِ معانقي الأقرانِ",138,"ن",1,0],["وَأخاف أَن تمتدّ نحو بِلادنا","بِمُداهمٍ لِلخَطبِ أَيِّ مُداهمِ",139,"م",1,0],["وأخاف أن يطغى اليرا","ع بنعته فيقال طاغي",140,"غ",2,0],["وأخافَ في الأجم الأسود فلم يكن","ليصول منها في البسيطة صائل",141,"ل",1,0],["وأخا العلياء والمجد الذي","فوق هامات المعالي قد رقى",142,"ا",1,0],["وأَخَافُ مِن شَجَنِي إلَيهِ فَكُلُّ مَن","لاقَاهُ أَفرَغَ ما بهِ, ورَمَى بهِ",143,"ب",2,0],["واخاف نْضيع بالحظّ وْنصيبه","واخاف افْْقدك ياحبيّب يايابه",144,"ب",2,0],["وأخافُ تمتمةَ النساءِ ومكرهنْ","يا ويل حالي لو جهاد تمادى",145,"د",2,0],["وأَخُ العَصا والحَرْبُ تَلْحَقُهُ، على","جَبَلِ الفِرارِ مِنْ الرَّدى يَتَسَلَقُ",146,"ق",1,0],["وَأَخَالُ بِأَنِّي كُنْتُ بِهَا","سَكْرَى بِمَلاَمِحِ خَمْرِيَّهْ",147,"ي",2,0],["وَأُخَاطِبُ الصُّوَرَ الحَبِيسَةُ فِي يَدِي","وَالصَّمْتُ يَبْكِي دَمْعَهُ المُتَوَسِّمَا",148,"م",2,0],["وأخالُ إنْ كانَ الذبيحُ مُنَكَّلاً","ألفى جمالَكِ نحوهُ يتبجحُ",149,"ح",1,0],["وأخال الزهر في أكمامه","وجن الغادات وأدنيها اشتماما",150,"م",2,0],["وأخ إذا جار الزمان مضاضة","نعم المعين لصحبه وأخيه",151,"ي",2,0],["وأخالني وأنا المتيّم في الهوى","أمضي لحتفي..يا حبيب أ ما ترى؟",152,"ر",2,0],["واخافْ أَنِّي إذا ناديتْ أنَّكْ ما تجيْب","حَيَّرتني فِيكْ يا كلّْ الأَمل والمُنى",153,"ن",2,0],["وأخاف من ذكرى اللقاء فإنّها","كمرور حادِ العيسِ بي اذ سلّما",154,"م",2,0],["وأخاف شعرَك إنه حممُ اللظى","وأخاف حرفَك إنّه سهمٌ رمى",154,"م",2,0],["وأخاف هجرَكَ مثلما سلَفَتْ","تلكَ الشهورُ يُصيبُني الهَلَعُ",155,"ع",1,0],["واخاف ان اسلو هواك بغربتي","فدعي الملام وهات كأسك وارشفي",156,"ف",2,0],["وأخاطبُ العربيَّ عندَ وفائِه","فَمَنِ المجيرُ إذا الرجاءُ يخيب",157,"ب",1,0],["وأخايل سْعد فالقلب الحنوني","وتغدر بي جيوشي بانسحابي",158,"ب",2,0],["وأخ الوقائع أحمد بن سعيد من","أردى بصولته قوى الطغيان",159,"ن",1,0],["وأخالُ أنَّكِ بضَّةٌ","ليستْ بما يحلو بَضُوضْ",160,"ض",1,0],["وأخالها عند الغياب تقول لي","طال الغياب أجبتها عيناك",161,"ك",1,0],["وأخافُ مهما قلتُ أنْ لا أُنْصفَا","ما بي كما بِكِ .. ما لهُ أنْ يُوصفَا",162,"ف",2,1],["وأخا الشدائد والذي","ساس الخطوب وروضا",163,"ض",2,0],["وإخالُني أنسى وترجعُ مُقلتي","غرقى بنجمِ سُهادِها الوضّاءِ",164,"ا",2,0],["وإخاء الإيمان يجمع شملا","لاترى مثلنا تقى ورزانه",165,"ن",2,0],["وأخال ماء الكأس يسري جامعاً","في عمق أعماقي خِراجَ مآتم",166,"م",1,0],["وإخاؤه للأنبياء موضَّحٌ","في دعوة عظمى لها أصداءُ",167,"ا",2,0],["وأخاف لو تدنو عقاربها","تشقى كما تشقى لحيظاتي",168,"ت",2,0],["وَأخَالُ من قلبِ السَّحابَةِ رِقَّةً","تَنثَالُ كيما يُستفزَ نماءُ",169,"ا",2,0],["وأَخَا المروءةِ إنْ يُعَدَّ سِوَاهُ من","أجنادِها عَدَّتْهُ من أُمرائِها",170,"ا",3,0],["وأخاف إمّا ليلة","من نفحة قد يقنعوكْ",171,"ك",1,0],["وإخالُ خصرَكِ إنْ مررتِ بِجانبي","مِنْ لينهِ في ثوبهِ يتدفَّقُ",172,"ق",1,0],["وَأَخَافُ إِنْ دَارَيْتُ حُبِّيْ بِالنَّوَىْ","يَأْسَ الفُؤَادُ عَلَىْ الهَجِيْرِ وَيَأْلَمُ",173,"م",1,0],["وَأَخالُ أَنّي مِثلُهُم لا شَأنَ لي","فَأَصيحُ مُرتَعِداً وَتَمشي القافِلَه",174,"ل",2,0],["وأخادعنَّ النفس لا أُلفى بها","إلا خداعا ظاهرا ومسيطرا",175,"ر",2,0],["وأخاف إن طرَفَ اللقاء هنيهة","ينتابني ألم الفراق فأُطرِق",176,"ق",1,0],["وإخال أني لا أحسُّ بنبضه","في الصدر لولا شدة الخفقان",177,"ن",1,0],["وأخافُ كالطِّفلِ المُس","يءِ من احتِمالاتِ العِقابِ",178,"ب",1,0],["وأخافُ أن تذْوي القُوى","إن لمْ تجُدْ بالوصْلِ فُرصَهْ",179,"ص",2,0]]}