{"poems":[[53,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[53,"فتى لم يخلق الله","https://www.aldiwan.net/poem66042.html","الهزج"],[48,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13598","الكامل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[438,"ردوا لها أيامها الأوائلا","https://www.aldiwan.net/poem12388.html","الرجز"],[556,"ألم ترني في كل يوم وليلة","https://www.aldiwan.net/poem47162.html","الطويل"],[580,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[580,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104621","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64856","الطويل"],[1521,"","https://poetry.dctabudhabi.ae/diwan/poem/20767","الكامل"],[1878,"","https://poetry.dctabudhabi.ae/diwan/poem/202467","المتقارب"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109285","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93523","الرمل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83235","المتقارب"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101630","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132694","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62798","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138557",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129501","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109961","البسيط"],[3892,"","https://poetry.dctabudhabi.ae/diwan/poem/97708","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125880","الكامل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123469","البسيط"],[4418,"","https://poetry.dctabudhabi.ae/diwan/poem/95770","الرمل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104907","الطويل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""],[5436,"ياعيد اهلي / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177540",""],[5457,"هذا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=214602",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5720,"الرَّشَا","https://www.poetsgate.com/ViewPoem.aspx?id=211352",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[5782,"جموح / د. عمر هزاع","https://www.poetsgate.com/ViewPoem.aspx?id=183618",""],[6102,"طلل","https://www.poetsgate.com/ViewPoem.aspx?id=184437",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""],[6242,"مَنْ ضيّعَك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87556&r=&rc=3",""]],"verses":[["فرتقتم منه فتقاً","وفتقتم منه رتقا",0,"ق",2,0],["فرتْ جِلْدتَه الألسُ","نُ عن شحمٍ وعن لحمِ",1,"م",1,0],["فرَتِّبِ النّظْمَ تَرْتِيبَ الحُلِيّ على","شَخْصِ الجَلِيّ بلا طَيشٍ ولا خَرَقِ",2,"ق",1,0],["فَرَّت إِلَيكَ بِغَيرِ داعٍ هِمَّتي","وَصَغا إِلَيكَ بِلا قِيادٍ راسي",3,"س",2,0],["فرتبته العليا يقول لأخذه","عن الله لا وحيا بتوسيط آخر",4,"ر",1,0],["فَرَتْ إِليه العِيسُ أَثواب الدُّجَى","رافِلَةً بين الرُّبَى ورافِلا",5,"ل",2,0],["فَرَتْ نائباتُ الدّهرِ أغصانَ دَوْحَتِي","ولاقَ أُصولي ما أصاب غُصوني",6,"ن",2,0],["فرَّت من الفردوس إِمّا","من مَلالٍ أَو تَجَنِّ",7,"ن",1,0],["فرَّت لخوفِكَ غِلمةٌ","ولطَالما فَرَّ الْغُلامُ",8,"م",1,0],["فرَّت جيوشُ الهمومِ لمّا","كرت عليهم مِنَ الكمينِ",9,"ن",1,0],["فَرَتْ بالنَّوَى قَلْبي وقَالتْ شَقَقْتُهُ","لأَكْسَوَ بَيْتي حُسْنَ بَيْتٍ مُصَرَّعِ",10,"ع",1,0],["فرَّت يهود وأسلمت جيرانها","صَمِّي لما لقيت يهود صَمامِ",11,"م",1,0],["فرتب لي الأذن سهلاً لديك","فإني أرضى به راتبا",12,"ب",2,0],["فرّت كمثل الخشف مذعورة","لما رأت في مفرقي مخذمك",13,"ك",1,0],["فَرَّت الآرام لَما أَبصرت","زغب الباز بِأَجناح الغراب",14,"ب",1,0],["فَرَتَّقَ ما فَتَّقَتهُ اللَيالي","وَما غَيرُهُ شِمتُ بِالمُرتِقِ",15,"ق",1,0],["فرت فرار لذيذ أحلامه","لم تبق لي إلا تذكرها",16,"ه",2,0],["فرّت من الظلم اشفاقا فكان لها","سفك الدماء جزاء ان دعت وشكت",17,"ت",1,0],["فرت بنو لقْمانَ عن أحْسابِها","والضّربُ يُنْثَرُ والأسنّةُ تُجْمَعُ",18,"ع",1,0],["فرت من الرعب في البيداء عالمةً","ان ليس ملجاً ولا عن سلبهن نجا",19,"ج",2,0],["فرت بنا من بابل فكأنما","فرت بنا بقوادم وخوافي",20,"ف",2,0],["فرَّت حياتي فَرّا مُعقِباً وَمَداً","ما اغبرَ العيشَ فالآتي كما غبرا",21,"ر",2,0],["فَرّت بنو أسدٍ فرا","رَ الطيرِ عَن أَربابِها",22,"ب",3,0],["فَرتعْتُ تحتَ سمائها مُتَنعِّماً","وغُذِيتُ فوق ترابها بِلبان",23,"ن",1,0],["فرتَّبَ الجيشَ ترتيباً ونظَّمَهُ","حتى ازدرى نظمُه بفاخرِ الدُّرَر",24,"ر",1,0],["فَرتَعنا في رِياضٍ","وَكَرَعنا في عُقار",25,"ر",1,0],["فرتبت من فكري قضايا كثيرة","فما انتجت تلك القضايا سوى العكس",26,"س",1,0],["فرت الأبطال عنه وانجلت","كفرار الطير من خوف البزاة",27,"ه",1,0],["فرتب إلى اليا دوائر خفلشق","أولات عدٍ جُزْءٌ لجزْءٍ ثُنا ثنَا",28,"ا",1,0],["فرت على الرغم منها بعد ألفتها","غداة لاح لها بالغور إنسان",29,"ن",1,0],["فرّتْ نوافر جمعهم لاتلجمُ","لما تحمْحم كالصواعق ادهمُ",30,"م",1,0],["فرَّتْ دموعُ العينِ عندَ مصيبتي","قالتْ سأحكي للقصيدةِ قصتي",31,"ت",2,1],["فرتّلَ الكونُ أصداءَ الحروف له","وأشعلَ الدمُ في تاريخنا الوَرَقا",32,"ق",2,0],["فرَّتْ من الموتِ لمَّا جاءَها وَسَعَتْ","إلىٰ الحياةِ التي في أصلِها المَوتُ",33,"ت",1,1],["فَرَّتْ فِراخُ أمانينا بلا عُذُرٍ","وأفْرَخَتْ ألفَ حربٍ دونما سببِ",34,"ب",1,0],["فَرَّتْ - وَعَن قَصدِ الدَّواةِ - جَمُوحُ","تَعدُو إِلَيَّ بِنَصلِها ؛ وَتَلُوحُ",35,"ح",1,1],["فَرَّتْ , فَمَا لِي - مِنَ الزَّهرِ - الرَّحِيقُ , وَ لَا","- مِنْ لَسعَةِ النَّحلِ - لَا شَهدٌ ؛ وَ لَا عَسَلُ",36,"ل",1,0],["فرّت على ألم النجوى ثقوبَ جوى","فأرهقت غضبا فوضى مآقيها",37,"ي",3,0],["فرّت ثواني العمر بين جراحنا","وكأنّ قلبي لم يكن يوماً معَكْ !",38,"ك",1,0]]}