9",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"لقد وضعت على النص النقاطُ:","https://www.poetsgate.com/ViewPoem.aspx?id=200590",""],[5542,"عندما يعزف الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=10187",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5605,"رسالة إلى وزير الاقتصاد","https://www.poetsgate.com/ViewPoem.aspx?id=160029",""],[5616,"حماس","https://www.poetsgate.com/ViewPoem.aspx?id=205248",""],[2110,"هلال حسن هل يا من يراه","https://www.poetsgate.com/ViewPoem.aspx?id=156288",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5691,"شموع","https://www.poetsgate.com/ViewPoem.aspx?id=206531",""],[5776,"برقيّةٌ عاجلةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=199448",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5956,"مجرمو حرب وينجون من العقاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=192219",""],[5956,"لهفي عليك أيا شهيدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=193142",""],[5956,"أصدقاء خالدون","https://www.poetsgate.com/ViewPoem.aspx?id=194831",""],[5956,"جُزْتِ التصورَ عمّا كنتُ أحسبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=207235",""],[5974,"مرافئ الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=214988",""],[6056,"دلعهن عالي المستوى","https://www.poetsgate.com/ViewPoem.aspx?id=130337",""],[6070,"نصبوا على روحِ الضميرِ مآتما","https://www.poetsgate.com/ViewPoem.aspx?id=188819",""],[6127,"يا ماشياً نحو الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=192767",""],[5309,"أنصفت طول حياتي لم ادع احدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573810",""],[6187,"نبضُ الحكمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82478&r=&rc=1",""],[6213,"بعد المدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76304&r=&rc=52",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""]],"verses":[["هُمُ فَرَطٌ لَنا في كُلِّ يَومٍ","نَمُدُّهُمُ وَإِن لَم يَستَمِدّوا",0,"د",3,0],["هُمُ في الرِّضى كالماءِ يُسْتَنُّ في الظُّبا","وكالنّارِ فيها حينَ يَسْتَلُّها السُّخْطُ",1,"ط",1,0],["هُمْ فِي حَقِيقَةِ أَمرِهِمْ قَوْمٌ وَإِنْ","زَعَمَ المُفَرِّق أَنَّهُمْ أَقْوَامُ",2,"م",1,0],["هُمُ فَتَكوا بِالمُصعَبَينِ كِلَيهِما","وَهُم سَيَّروا عَيلانَ شَرَّ مَسيرِ",3,"ر",1,0],["هُم في الشَرابِ الَّذي نَحتَسي","وَهُم في الطَعامِ الَّذي نَأكُل",4,"ل",1,0],["هُمُ فَخَروا بِخَيلِهِمُ فَقُلنا","بِغَيرِ الخَيلِ تَغلِبُ أَو عِدينا",5,"ن",2,0],["هُم في عُلا الوَطَنِ الأَدا","ةُ فَلا تَحُطَّ مِنَ الأَداةِ",6,"ه",1,0],["هُم في الأَواخِرِ مَولِداً","وَعُقولُهُم في الأَوَّلين",7,"ن",1,0],["هُمُ فَرَّقوا قَبرَيهِما بَعدَ مالِكٍ","وَمَن يَحتَمِل داءَ العَشيرَةِ يَندَمِ",8,"م",1,0],["هُمُ فَتَحوا أَغلاقَها بِسُيوفِهِمْ","وهم تَركوا الأَنوارَ فيها حَنادِسا",9,"س",2,0],["هُمْ في المنابرِ ألسنٌ وجوانِحٌ","وعلى المآذنِ أعيُنٌ أو هامُ",10,"م",1,0],["هُمْ في العُبابِ أراقمٌ ما يَنْقَضِي","منها الدّبيبُ وفي السّحابِ نُسورُ",11,"ر",1,0],["هُمْ في حِمَى الوَحْيِ المُنزَّلِ صخرةٌ","تُعيي الدُّهاةَ وجذوةٌ تتحرَّقُ",12,"ق",1,0],["هم في الكنانة آلُ بدرٍ ما لهم","إلا الشّهادةُ مطلبٌ ومُرادُ",13,"د",1,0],["هُم فَرَّقوا الشَملَ الجَميعَ وَمَزَّقوا","ما أَلَّفَ الصيدُ الأُباةُ فُلولا",14,"ل",2,0],["هُمْ في الحوادِثِ إن قَلُّوا وإن كَثروا","بَأسٌ جَميعٌ ورأيٌ غيرُ مُنْشَعِبِ",15,"ب",1,0],["هُمْ في حُنَيْنٍ يا مُحَمَّدُ مِثلُهُم","في يومِ بدرٍ صَدْعُهُم ما يُرْأَبُ",16,"ب",1,0],["هُمْ في حِمَى الإيمانِ أوّلُ صخرةٍ","فَسَلِ الصخورَ أما عرفن قُواها",17,"ا",3,0],["هَمَّ فَجْرُ الحَيَاةِ بِالإِدْبَارِ","فَإِذَا مَرَّ فهْيَ فِي الآثَارِ",18,"ر",1,1],["هُمْ فِي جَمَاعَتِكُمْ صُدُو","عٌ فَاجْبُرُوا واللهُ جَابِرْ",19,"ر",1,0],["هُمْ فِي المَعَالِي مَنْ هُمُ","سَعْياً وَتَضْحِيَةً وَكَدَّا",20,"د",2,0],["هُمْ فِي الصُّروفِ أَعَزُّ أَعْمِدَةٍ","لِبِلاَدِهِمْ وَأَشَدُّ أَعْضَادِ",21,"د",1,0],["هم فداءٌ لك لا بل كلُّ مَن","تحت عرش الشمسِ في الحكم سواء",22,"ا",2,0],["هُمُ في ظِلالِ الحقِّ جمعٌ موحدٌ","وعند التقاء الرأي فردٌ مُجمَّع",23,"ع",1,0],["هم فاتحون وإن لم يشهَرُوا قُضُبًا","أو تحترق بلهيب النار أبدان",24,"ن",1,0],["همْ في رءوسِ أعاديهم ذوو طمع","وفي الغنائِم -بعدَ النصر- زُهَّاد",25,"د",1,0],["هم في الشراب الذي نحستي","وهم في الطعام الذي نأكل",26,"ل",1,0],["هم في القوم اربعة بدور","بهم بدجا الملمة نستنير",27,"ر",1,0],["هُم فخِر من ولدوا ولكن فخرهم","بك قد وشى ذاك الفخار وفوّفا",28,"ف",2,0],["هم في يديك فما من مهرب لهم","عن المسآء ولا مناى عن القلق",29,"ق",1,0],["هم في الورى قصدي وسؤلي ولو سلوا","على الجمر قلبي ما سلا وهم هم",30,"م",1,0],["هم فوق وجهك في حسن وفي طربٍ","وفي ملامح مثل الشمس بيضاء",31,"ا",2,0],["هُم في الرَخاءِ إِذا ظَفِرتَ بِنِعمَةٍ","آلٌ وُهُم عِندَ الشَدائِدِ آلُ",32,"ل",1,0],["هُمُ فَضَلوا بِخِلّاتٍ كِرامٍ","مَعَدّاً حَيثُما حَلّوا وَساروا",33,"ر",3,0],["هم في غنى ان يزيحو بي ضلالتهم","ما يصنع الأكمه المعذور بالسرج",34,"ج",1,0],["هُمُ فَرَّجُوا غَمَّ الدَّواهِي وَضِيقَها","بِمَا وَسِعَ الدُّنْيَا وأَبْنَاءَها دَهْيَا",35,"ي",2,0],["هُمُ في القَلبِ حَلّوا حينَ ساروا","وَهُم عَقَدوا الهَوى وَالصَّبرَ حَلّوا",36,"ل",3,0],["هم في التراب جوانح","تهفو وألسنةٌ تبين",37,"ن",1,0],["هُمْ فَارَقُوكَ وَهذهِ الأَوطانُ","وَلِهُنَّ بَاقي الدَّمْعِ كانَ يُصَانُ",38,"ن",1,1],["هُمْ في فؤادي ويَبْقَى للفتَى رَمَقٌ","ما دامتِ الرُّوحُ في جُزْءٍ منَ البَدَن",39,"ن",1,0],["هُمْ في قُصورٍ تُضرَبُ الحُجْبُ دونَهمْ","وفيهمْ لناعمّا نُريدُ قُصور",40,"ر",1,0],["هُمُ فيها البنونَ وأنتَ سِقطٌ","وشتان الثعالبُ والأسود",41,"د",1,0],["هم في انتظارك واقفون ونحوهم","تسعى سريعاً لا على الأقدام",42,"م",1,0],["هُمْ فلا ضُعْضِعُوا كَأَرْبَعَةِ الأَرْ","كانِ شَدَّتْ بَنِيَّةَ الصَّلواتِ",43,"ت",1,0],["هُمُ فئةُ الإِسلامِ إِنْ شَهِدُوا الوَغى","وهُمْ أُفُقٌ لِلْمُلْكِ إِن نَزَلوا أُفْقا",44,"ق",2,0],["هم في التراب هوامد حتى بهم","والأرض زعزع راجفاً زلزالها",45,"ل",3,0],["هُم في أَوجُهِ الأَيّامِ حُسنٌ","وَفي ديباجَةِ الدُينا طِرازُ",46,"ز",1,0],["هم في السعادة راتعون وقلبهم","في حالنا كالصخرة الصماء",47,"ا",2,0],["هُمْ في مَناهِجِ دِينِ اللهِ حينَ سَرَوْا","ماتوا على الحقِّ أَشياخٌ وشُبَّانُ",48,"ن",1,0],["هم فتحوها ثلمة في عصا العلى","ولولاك في شعبان ظل انشعابها",49,"ب",3,0],["هُمُ في الورَى حَسبِى وأنَّ سِواهُمُ","بأسفَل أقدامِى عَسيفِ الذُرَى حَطبُ",50,"ب",1,0],["هُمُ فَخَروا عَلَيَّ بِغَيرِ فَخرٍ","وَذادوا دونَ غايَتِهِ جَوادي",51,"د",2,0],["هم في جبين القطر اسنى غرة","او انهم في صِدر مصر وسام",52,"م",1,0],["هم في غنى عن هؤلاء فإننا","حفاظهم والحافظون أسود",53,"د",1,0],["هُم فُؤادي ومُرادِي وهُمُ","نُصبَ عيني حيثُما كانوا وكُنّا",54,"ن",2,0],["هم في الحشا إن أعرقوا أو أشأموا","أو أيمنوا، أو أنجدوا، أو أتهموا،",55,"م",3,0],["هُمْ في ضميْرِكَ خَيَّمُوا أم قَوَّضُوا","ومِنَى جُفُوْنِكَ أَقْبَلُوا أم أَعْرَضُوا",56,"ض",3,1],["همَّ في الفجر والوحوش مع الطي","ر سواهٍ والجن في إغفاء",57,"ا",2,0],["هم فتية ورثوا المكارم والعلى","وتقاسموا وتناصفوا بتصاف",58,"ف",1,0],["هُم فاعلموا أَصلي الَّذي منه منبتي","عَلى كُلِّ فرع في التُراب له أَصل",59,"ل",1,0],["هم فقدوا معك زين الشباب","وهم عدموا معك صدق الإخاء",60,"ا",2,0],["هم فيها كالأعينِ يُمناها","بالرمشِ لا يَسبِقُ يسراها",61,"ا",3,0],["هم فتية كانت لهم ألبابُ","قطعوا ولم تقطعهم الأسبابُ",62,"ب",1,1],["هُم فَوَّقُوا الدِينِ بصدقِ اللِقا","ءِ بعدَ اعوجاجٍ من يدِ الكافِرين",63,"ن",1,0],["هم فتية قد آمنوا بالههم","فزادهم هدياً بنور سنا الكشف",64,"ف",1,0],["هُم فاخَروكم لَدى النُعمانِ فَاِرتَفَعَت","راياتُكُم عِندهُ في ذلكَ الحَفلِ",65,"ل",1,0],["هم في الكتابِ الذي اخفته غيرته","منهم ومن غيرهم في الصدر عنوان",66,"ن",1,0],["هم فؤادي وحياتي مثلَمَا","أنّهم سمعي ومَرْأَى مُقْلَتَيْ",67,"ي",1,0],["هُم فِي الحَقِيقَةِ أهلُ تَأوِيلِ الَّذِي","يُعنَى بِهِ لاَ قَائِلُ الهَذَيَانِ",68,"ن",1,0],["هم فتيةٌ كسيوفِ الهِندِ طالَ بِهم","على المُطاوِلِ آباءٌ مناجيدُ",69,"د",1,0],["هُمْ في ظلامِ الَّليلِ غُيِّبَ وَعْيُهُمْ","هُمْ رافضونَ لأَيّ صُبْحٍ هَادي",70,"د",2,0],["هم فرّقوا بين الضلالة والهُدى","عملاً بموجبِ محكمِ الفرقانِ",71,"ن",1,1],["هم فتَحوا المشرِقَ والمغربَ","والجنوبَ والشَّمالَ والقفرَ الخلا",72,"ا",1,0],["هم فارقُوه فأرّقوه فأنْ شَكا","وبكا فللمجروح أنْ يتألمَا",73,"م",2,0],["هم فُروع مِن دَوحة لِجناها","أَوشج اللَه في الجنان عُروقا",74,"ق",2,0],["هُم فتية خَطَبوا العُلا بِسيوفهم","وَلها النُفوس الغاليات مُهور",75,"ر",1,0],["هُمُ فَرغُكَ الشامي المُؤخَّرُ طالعاً","وسادسُ نَعشٍ في المغيبات زاهِر",76,"ر",1,0],["هم فروع سمت وفاقت أصولاً","فارعها واستجب لفرع المنادي",77,"د",2,0],["هم فروع العلى إذا نسبوهم","وأصول الكمال في التأسيس",78,"س",1,0],["هم في الوقار الهضب راسخة","ولدى العطاء يهزها الجذلُ",79,"ل",1,0],["هم في المعامع كالنعا","م وفي المحافل كالقرب",80,"ب",1,0],["هم فتتوا كبدي بالهجر واندمي","لو كان ينفع فيما فات واندمى",81,"م",2,0],["هُم في ذُرى جبل كان اعتصامُهم","وراح مُعتصما بالله مُتّكلا",82,"ا",1,0],["هُمْ فِيْ الحِسن الْهُم شِبَه فيك","ويزيد حِسنِك بابتسامِ",83,"م",1,0],["هم فتكوا والدّهرُ ينشِبُ ظُفرَهُ","فلا غلَبَتْ شَيبانُ غيرَ مُغلَّبِ",84,"ب",1,0],["هم فجَّروا الأنهارَ طائعةً","فيها وراضوا الخيلَ باللجمِ",85,"م",1,0],["هُمُ فلّوا عنِ الأعداءِ حَدّي","وغلّوا ساعديَّ فما أبُوعُ",86,"ع",1,0],["هم فارقوك وحملوك من الأسى","ما ليس يحمل شامة وطفيل",87,"ل",1,0],["هُمُ فقأوا عَينيَّ لا العَري آمِرٌ","بخيرٍ ولا ذو الذّنبِ إذ كان غافِرُه",88,"ر",2,0],["هم في سما الجود شمسٌ والنجا عصمٌ","وفي الهداية هم نار على علم",89,"م",1,0],["هُم في غِنى عَنكُم عَلى أَن الغِنى","لَم يَمنَع الأَخَوين إِن يَتجَمَلا",90,"ل",2,0],["هم في الوغى شهب تنقض محرقة","من يعتدي وهم يوم الندى ديم",91,"م",1,0],["هم في جنةٍ إلى قدميه","قد تثنت أهدابها المثنيه",92,"ه",1,0],["هم في اليَمين مع العلى","والذل مَعنا في اليسار",93,"ر",1,0],["هُمُ فارَقوا في اللَهِ مَن جارَ حُكمُهُ","وَكُلٌّ عَنِ الرَحمنِ أَصبَحَ راضِيا",94,"ي",2,0],["هم فيوض الله التي في جداهم","ضاقت الأرض كلها والسماء",95,"ا",2,0],["همْ في الحقارة سعيُهم","ومقامُك العالي ، قمَرْ",96,"ر",1,0],["هم في غدٍ في جنة الخلدِ التي","شيدت بها تلك القصور الواسعة",97,"ع",2,0],["هُم فَخرَ هذي الارضِ همْ اسوارها","هم بيرقَ المجدِ الذي لا يُسْقَطُ",98,"ط",1,0],["هم في الشدائدِ خيرُ عونٍ إن دنت"