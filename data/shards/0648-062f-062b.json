{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54833","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113930","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110004","الخفيف"],[333,"روح الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=131025",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""]],"verses":[["وَدِثَارُهَا الوَضاحُ فَوْقَ بَيَاضِهَا","غَزْلُ الأَشِعَّةِ صِيْغَ فَهْوَ دِثارُ",0,"ر",1,0],["ودُثورٍ من الهِجانِ المَهارى","وعناجيجَ مُترصاتٍ هِضابِ",1,"ب",1,0],["ودِثاري عَباءَتي وشِعاري","مع رِدائي نسيجُ شعرٍ وصوفِ",2,"ف",1,0],["ودّثوا لو اقتحموا الزما","ن فأصبحوا في الكائنين",3,"ن",1,0],["ودَثِّري الأرضَ ثلجاً، إذْ مشاعرُها","غزَتْ فؤادا بحبٍ دفَّأ الوَكَنا",4,"ن",2,0]]}