px?id=64038",""],[5271,"الى/ لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=67533",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[5376,"قد زاد شوقي كما النيران فاحتدما","https://www.poetsgate.com/ViewPoem.aspx?id=188561",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5464,"سبايا","https://www.poetsgate.com/ViewPoem.aspx?id=36084",""],[5608,"من جرحك تعلمت","https://www.poetsgate.com/ViewPoem.aspx?id=33182",""],[5609,"جازان","https://www.poetsgate.com/ViewPoem.aspx?id=214101",""],[5652,"طفله تناجي وردة الحلم ل التيه","https://www.poetsgate.com/ViewPoem.aspx?id=179842",""],[5690,"نادى البشير وصبح الخير قد سفرا","https://www.poetsgate.com/ViewPoem.aspx?id=172159",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5853,"((لمن ..أغني ؟))","https://www.poetsgate.com/ViewPoem.aspx?id=175660",""],[161,"قصيدة شكر وعرفان لآل العروض الرقمي","https://www.poetsgate.com/ViewPoem.aspx?id=166365",""],[6093,"أذكي الغرامَ بموْعدٍ وتلاقِ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176202",""],[520,"ردا احاديث المنى وأعيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577496",""],[6171,"عُرسُ الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86324&r=&rc=7",""],[5464,"يا منقذي من وحول العار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=490&r=&rc=4",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["جازَت إِلى خاطِري عَفواً وَخُيِّلَ لي","مِمّا اِستَبَت أُذُني أَن لَم تَجُز أُذُني",0,"ن",2,0],["جازَت بِهِ حَدَّ العُلى وَقَد رَأَت","تَقارُعَ الجُدودِ وَاِطِراعَها",1,"ع",3,0],["جازَت مُلِمّاتُ الزَمانِ حُدودَه","وَاِستَفرَغَت أَيّامُها مَجهودَها",2,"د",3,1],["جازِعاتٍ بَطنَ العَتيقِ كَما تَم","ضي رِقاقٌ أَمامَهُنَّ رِقاقُ",3,"ق",1,0],["جازا مَدى السَبعينَ لَم يَتَوانَيا","عَن وَصلِ حَمدٍ وَاِجتِنابِ سِبابِ",4,"ب",1,0],["جازَ بي عَرفُها فَهاجَ الغَراما","وَدَعاني فَزُرتُها إِلماما",5,"م",2,1],["جازَتا مَوضِعي فَهَبَّ نَسيمٌ","أَذكى مِنّي الأَسى وَهاجَ الهُياما",5,"م",2,0],["جازَيتَني عَن تَمادي الوَصلِ هِجرانا","وَعَن تَمادي الأَسى وَالشَوقِ سُلوانا",6,"ن",2,1],["جازَيتَني بُعداً بِقُربي في الهَوى","وَمَنَحتَني غَدراً بِحُسنِ وَفائي",7,"ي",1,0],["جازَ المِطَالُ بأشْيَاءٍ ولم أرَهُ","يجوز بالغوْثِ والملهوفُ في كَبَدِ",8,"د",1,0],["جازٌ لها لكنه متقلب","في الفقر إلا أنه يتصنع",9,"ع",1,0],["جازى الإله أناساً من بني وطني","بالشر شراً وبالإحسان إحسانا",10,"ن",2,0],["جازَتِ النَجمَ وَاِطمَأَنَّت بِأُفقٍ","مُطمَئِنٍّ بِهِ السَنا وَالسَناءُ",11,"ا",2,0],["جازَ الدُروبَ إِلى ما خَلفَ خَرشَنَةٍ","وَزالَ عَنها وَذاكَ الرَوعُ لَم يَزُلِ",12,"ل",1,0],["جازَ حُدودَ اِجتِهادِهِ فَأَتى","غَيرَ اجتِهادٍ لِأُمِّهِ الهَبَلُ",13,"ل",1,0],["جازَ الأُلى مَلَكَت كَفّاكَ قَدرَهُمُ","فَعُرِّفوا بِكَ أَنَّ الكَلبَ فَوقَهُمُ",14,"م",1,0],["جازَت عَلى الجَوزاتِ وَانكَدَرَت عَلى","ظَهرٍ مِنَ الصَفصافِ قاعٍ صَفصَفِ",15,"ف",1,0],["جازَ المَدى فَرَمى بِغَيرِ مُناضِلٍ","في سُؤدُدٍ وَجَرى بِغَيرِ رَسيلِ",16,"ل",1,0],["جازَنا مُعرِضاً كَأَنّا لَقينا","دونَهُ اللَهوَ أَو شَرِبنا المُداما",17,"م",2,0],["جازَت إِساءَةَ أَفعالي بِمَغفِرَةٍ","فَكانَ غُفرانُها يُغني عَنِ الحِجَجِ",18,"ج",1,0],["جازوا خَلائِقَ قَد تَيَقَّنَتِ العُلى","كُلَّ التَيَقُّنِ أَنَّهُنَّ نُجومُها",19,"م",3,0],["جازِعاتٍ سودَ المَروَراةِ تَه","ديها وُجوهٌ لِمَكرُماتِكَ بيضُ",20,"ض",1,0],["جازَ الخِيامَ إِلى القُصورِ حَضارَةً","وَالشَرُّ بَينَ قُصورِهِ وَخِيامِهِ",21,"م",2,0],["جازتْهُمُ تَرْمَدُّ في غُلَوائِها","فتُخُرّموا وخَلا لها مَيدانُها",22,"ن",3,0],["جازاكَ رَبّكَ بالجِنانِ فهَذِهِ","دارٌ وإنْ حَسُنَتْ تغُرّ بسُحتِها",23,"ت",3,0],["جازَتِ البيدَ إِلى أَرحُلِنا","آخِرَ اللَيلِ بِيَعفورٍ خَدِر",24,"ر",1,0],["جازَ ابْنُ ذَكْوانَ في مَكَارِمِه","حُدُودَ كَعْبٍ وما به وُصِفَا",25,"ف",2,0],["جازَت مُلِمّاتُ الزَمانِ حُدودَها","وَاِستَفرَغَت أَيّامُها مَجهودَها",26,"د",3,1],["جازَت فَرامَحَها كَأَعزَلَ إِذ هَدا","هَدّارُها وَأَمامُها كَوراءِ",27,"ا",2,0],["جازت عن الجلد إلى عرضه","فمزقته كل تمزيق",28,"ق",1,0],["جَازَ الْقُرونَ النَّائِيَا","تِ وَفَكَّ أَسْرَاَ الْعُقُودِ",29,"د",1,0],["جازوا الجسور خفاف الحاذ وقرهم","زهد وخوف واصبار وشكران",30,"ن",1,0],["جازَتْكَ عَن تَعَبِ الفؤادِ ، فلم يكن","تعبُ الدماغ يَهُمُّ شهماً ناصبا",31,"ب",2,0],["جَازَ الْقُرونَ النَّائِيَا","تِ وَفَكَّ أَسْرَارَ الْعُقُودِ",32,"د",1,0],["جاز طيفي نحو أسماء","كل بيداء وظلماء",33,"ا",2,0],["جَازِمٌ أنَّ الأنبَيَاءَ الطًّهَارَى","مُستَحِيلُ عَلَيهِمُ الكِتمَانُ",34,"ن",1,0],["جاز التيمم حيث لا ماءٌ وقد","بطل التيمم معْ وجود الماءِ",35,"ا",2,0],["جازوا على عَنَت الحسودِ فلم يجد","عيبا وماذا في النجوم يقولُ",36,"ل",1,0],["جازَ حَدَّ النَدى وَآمَن سِربي","فَكَفى أَن أَرتادَ أَو أَرتابا",37,"ب",2,0],["جازَها سابِقُ بنُ مَحمودٍ السا","بِقُ يَومَ النَدى وَيَومَ النِزالِ",38,"ل",1,0],["جازيتني هذا الجزاء وإنما","أصل الفتى نفعا به قد يعرف",39,"ف",1,0],["جازَ أبو القاسم المَديحَ عُلاً","وقَدرُه في المَديح لا يُقدَرْ",40,"ر",1,0],["جاز بها مسيلُها مداه","حتى لقد كادت تُغَطِّي فاه",41,"ا",2,0],["جازَ المَخاوِفَ وَالشُراةَ وَأَص","حابُ البَدارِقِ مِن بَني عَمرِو",42,"ر",2,0],["جازياتٍ لَيسَ يَغرَم","نَ عَلى قَتلي الجَزاءا",43,"ا",3,0],["جَازَ الذِي أَبْدَى شَمَائِلَهُمْ","بِجَنَّةِ الْفِرْدَوْسِ فِي حِلْيَهْ",44,"ي",2,0],["جازَيتِني وكما ظلمتُ ظَلمتِني","والظّلمُ مقبولٌ من الأنداد",45,"د",1,0],["جازى الاله جميعهم خير الجزا","وأدام أنس الكل كل زمان",46,"ن",1,0],["جازاك ربك عن خليقته","خير الجزاء فنعم ما يسدي",47,"د",2,0],["جازَ التِماسٌ إِعادَةَ الأَنظارِ في","حُكمِ الحُقوقِ الاِنتِهائي ثاني",48,"ن",2,1],["جازِئاتٌ جَمَعنَ حُسناً وَطيباً","وَقَواماً مِثلَ القَنا في اِعتِدالِ",49,"ل",1,0],["جازوا القرى بَعدَما حازوا النُفوس قرىً","كَأَنَّهُم ريح عاد عِندَما عَصَفا",50,"ف",2,0],["جازى الإِلَه حَواسِدي بِفعالهم","فَلَقَد تَعاظم جَهلهم وَغُرورهم",51,"م",1,1],["جازِعاتٍ بالغُطاطِ مَعاً","مِن أَعالي عازِفٍ شُعَبا",52,"ب",2,0],["جاز القفار فأحياها ومدّ بها","بسط الربيع على الوديان والكثبِ",53,"ب",1,0],["جازت مناقبه عن الأحصاد وال","تعداد والتكييف والتحديد",54,"د",1,0],["جازت روائعها الأكوان وازدحمت","في كل شيء وجازت كل امكان",55,"ن",1,0],["جازَ بِالأَمسِ عَلَينا","فَتَبَدّى بِالسَلامِ",56,"م",1,0],["جازوا على الشعرى وجاوز حدهم","بفضائل لا تقبل التجديدا",57,"د",2,0],["جازَيتُهُ وَاليَواقي","تُ جوزِيَت بِالرِمالِ",58,"ل",1,0],["جَازَتْ مَدَى الفِكْرِ فِي الصَّفَاءِ فَلَوْ","مَازَجَهَا الوَهْمُ مَسَّهَا رَنَقُ",59,"ق",1,0],["جازيكَ مِن شاعِرانِ تَستَجِدُّهُ إِلى","نَظمٍ مَضى فيهِ مِثلَ السَهمِ إِذ مَرَقا",60,"ق",2,0],["جازَيتُ بِالإِعراضِ عَنهُ وَلَم يَكُن","مِثلي لِيَشرِيَهُ طَنينُ ذُبابِ",61,"ب",1,0],["جازى حنوّي بالخداع معذّبي","يا ربِّ عذبهُ ولا ترفق بهِ",62,"ب",2,0],["جازتْ شهاداتُ النِّسَا","ءِ لديهِ حتَّى في الطَّلاقِ",63,"ق",1,0],["جازَ كَحيلُ العينِ أَرضَ الظّبا","وَمُقلتاهُ مِثلُ سَيفينِ",64,"ن",1,1],["جاز المحامدَ عن أهل الندى وله","عزائمٌ يتَّقيها جندُ إبليسا",65,"س",2,0],["جازفت فيه بعزة وحصانة","ورضيت منه بذلة وبهون",66,"ن",1,0],["جازت بها الجوزا فجذت كفَّها","والقطع محدود لكف السَّارقِ",67,"ق",1,0],["جاز العُلا ما لم يح","زه الشِيبُ وهو أمردُ",68,"د",1,0],["جازَ في اللُؤمِ حَدَّهُ","كَأَبيهِ وَعَمُّهُ",69,"م",2,0],["جازَاهُ أَنْ جَازَاهُ أَوْ يُعَافِ","إِنَّكَ لَمْ تُنْصِفْ أَبَا الجَحَّافِ",70,"ف",1,0],["جاز المقدّر عند مالك يجتدي","فيض المهالك في جهنم لم يزلْ",71,"ل",1,0],["جاز فعال الناس","وَلا تَكُن بِالناسي",72,"ي",1,0],["جاز فى الحُسن على الحدِّ فلو","جاز أن يُعبدَ مخلوقٌ عُبِد",73,"د",1,0],["جازَ بَطنَ العَقيقِ نَحوَ سُكارى","مِن عَقارِ المَسيرِ صَرعى نِيامِ",74,"م",1,0],["جاز النسيم على الغيد الرعابيب","فجاء يحمل منها نفحةَ الطيب",75,"ب",1,1],["جازت بهم لبنانَ في طلب المنى","والصدر بالنفس الأَبيّة ضَيّق",76,"ق",1,0],["جازَت بأسباطون منك قوائم","وَعلت بأسطاسون منك مراتب",77,"ب",1,0],["جازني كيف شئت لا أترك الذن","ب إذا كان فرط حبك ذنبي",78,"ب",2,0],["جازوا الحدودَ ومكر اللَه قد أمنوا","وليس عما أتوا لله إغفال",79,"ل",1,0],["جَازَاهُ ذُو الطَّولِ عَلَى فِعْلِهِ","مِنْ مَطْلَبِ المَتْبُوعِ وَالتَّابِعِ",80,"ع",1,0],["جازوا بني عبد العزيز فانهم","جروا اليكم اسوأ الأقدار",81,"ر",1,0],["جازِعات إِلَيهِمُ خُشَّعُ الأَو","داةِ تُسقى قوتاً ضَياحَ المَديدِ",82,"د",1,0],["جاز حد السقام فهو خفيٌّ","عن عيون العُوّاد عند العيان",83,"ن",1,0],["جاز قدر المديح إذ حاز بالس","عي من الفخر كل معنى غريبِ",84,"ب",1,0],["جازوا النقيب وأمواه الحيا نَطَفٌ","واستعذبوا مورداً من دمعي الأسن",85,"ن",1,0],["جازاه ربّي جَنَّةً","وكَوْثراً في شُرْبِهِ",86,"ب",2,0],["جاز الصحارى زائراً لمُعَرّسٍ","بمهامه مجهولَة وصحار",87,"ر",1,0],["جازيتِهم أَنهم أبصروا","ولم يروا وهو مصابٌ جسيم",88,"م",1,0],["جَازاهُ عن ذا الشَرح ما يرضيه","حتّى إلى أحبَابِه يؤُوِيهِ",89,"ه",1,0],["جازَيتها رعي السواري في الدُجى","مِن حين ما تَبدو إِلى غُروبِها",90,"ب",3,0],["جاز الإِساءة بِالإِحسان إِن صدرت","من امرء زلة تَدعو إِلى الغَضب",91,"ب",1,1],["جازَ الشَباب إِلى شَيخوخَةٍ وَرَثت","عَن الشَباب بَقايا الإِثم وَالعار",92,"ر",1,1],["جازت بيوت الحي في غفلةٍ","حتى توارث عن رقيب كفل",93,"ل",1,0],["جاز جفناً فيه انكسار فتور","سيفه ما به فلول قراع",94,"ع",1,0],["جازاهُ رَبّي كُلّ خَير دائِماً","ما سَبحت أَملاك رَبّي في السَما",95,"م",2,0],["جاز الحبالة ينحو البان منفلتاً","ظبيٌ تعرض بالاجفان يحتبلُ",96,"ل",1,0],["جازيت ضعفي في ود وفي ادب","فكنت في كل حال صاحب القصب",97,"ب",1,0],["جازت فقلت اعبري قالت مشيك بان","فقلت كافور يطلع بعد مسكوفان",98,"ن",1,1],["جاز أهاضيب الظنون بفكرة","رأت ما وراء الغيب وهو حصين",99,"ن",1,0],["جازَ العِقابُ بِهِ حَتّى قَصَدتُ لَهُ","واِعتَرَّ حَتّى أَفادَت وَحشَهُ الغَرَرُ",100,"ر",1,0],["جازَ النُجومَ فَخارُه فَدعونه","قف حَيث أَنتَ فَما وَراءَكَ مَصعَدُ",101,"د",1,0],["جاز بالجسم عن الوقتِ وعن","عرصةِ الأين وفيه العقلُ حارا",102,"ر",2,0],["جازاكم الله عما تبذلون لنا","من الجمال وعم الحسن شكران",103,"ن",1,0],["جازَ الوضوءُ لَنا بِهِ وَطُهُورُنا","فاِسمَع بِقَلبٍ حاضِرٍ يَقظانِ",104,"ن",1,0],["جاز ابن اسماعيل أسشع غاية","سمجت وغايات العلى لم تسمج",105,"ج",1,0],["جازت أسابيعُ دانيلَ النبيِّ فهل","مكذِّبٌ قولَهُ والحقُّ شاهِدُهُ",106,"د",2,0],["جازم الأَمر رافع القَدر عال","خافض الضد قاهر تَصليفه",107,"ف",2,0],["جازى ا