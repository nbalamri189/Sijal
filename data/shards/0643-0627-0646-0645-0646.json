/diwan/poem/198925","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72467","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120297","الطويل"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132200","المنسرح"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52126","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204183","المتقارب"],[4755,"جَوَّابُ العُصُور","https://www.poetsgate.com/ViewPoem.aspx?id=185155",""],[4755,"بَدَا كما يَبدو السَّرابُ النَّشُوزْ","https://www.poetsgate.com/ViewPoem.aspx?id=201637",""],[1012,"الشعشعة","https://www.poetsgate.com/ViewPoem.aspx?id=186277",""],[1012,"فتوحات الإمام عزان بن قيس","https://www.poetsgate.com/ViewPoem.aspx?id=124503",""],[669,"وارث السيف والعمامة والراية","https://www.poetsgate.com/ViewPoem.aspx?id=18427",""],[4984,"كريم الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=199233",""],[5092,"القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=190571",""],[5136,"يا خير من جال على سابح","https://www.poetsgate.com/ViewPoem.aspx?id=121597",""],[5136,"صعدت جذوة نار","https://www.poetsgate.com/ViewPoem.aspx?id=121515",""],[2365,"ذكرت شيب العذارين نوار","https://www.poetsgate.com/ViewPoem.aspx?id=200648",""],[5298,"أفاطمُ! قبلَ بينكِ متِّعيني","https://www.poetsgate.com/ViewPoem.aspx?id=183098",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[5431,"حتى نعود من الأجداث...يُحيينا","https://www.poetsgate.com/ViewPoem.aspx?id=187337",""],[5582,"زارَتْ وَثَوْبُ الدُّجَى قَدْ مالَ مَسْدُولا","https://www.poetsgate.com/ViewPoem.aspx?id=187240",""],[5582,"أَبَرْقَ الأَبْرَقَيْنِ أَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63574",""],[5691,"عبير الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=205974",""],[5725,"سما عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=208922",""],[5796,"نِمْتُمُ عن ليلِ حِلْفِ السَّهرِ","https://www.poetsgate.com/ViewPoem.aspx?id=189037",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[6045,"مكياج مطر","https://www.poetsgate.com/ViewPoem.aspx?id=125355",""],[6052,"الشذا","https://www.poetsgate.com/ViewPoem.aspx?id=52572",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[6237,"الليل والشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77881&r=&rc=23",""],[5107,"صورة مناضل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83046&r=&rc=38",""],[6290,"الْقَنْطَرَةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85654&r=&rc=43",""],[4222,"عذر الزمان بأي وجه يقبل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52867&r=&rc=159",""],[6345,"ياليته ما كان ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78669&r=&rc=40",""]],"verses":[["كَأَنَّ مَناسِمَها في السُرى","تَلاعَبُ بَينَ الحَصى بِالزَلَم",0,"م",1,0],["كَانَ مِنْهُمْ مَرْزَبَةٌ وَسِوَاهُ","وَهْوَ مِنْهُمْ مِنْ جُمْلَةِ الظُّرَفَاءِ",1,"ا",2,0],["كانَ مِنّا المُطارِدونَ عَنِ الأُخ","رى إِذا أَبدَتِ العَذارى الخِداما",2,"م",2,0],["كانَ مِن قُربِكَ في عَيشٍ نَدٍ","عَطِرِ الآصالِ وَضّاحِ البُكَر",3,"ر",1,0],["كَأَنَّ مِنَ الديباجِ جِلدَةَ رَأسِهِ","إِذا أَسفَرَت أَغباشُ لَيلٍ يُماطِلُه",4,"ل",2,0],["كَأَنَّ مُنَوِّرَ الحَوذانِ يُضَحّي","يَشُبُّ عَلى مَسارِبِهِ الذُبالا",5,"ل",2,0],["كَأَنَّ مُناخَ الراكِبِ المُبتَغي القِرى","إِذا لَم يَجِد إِلّا اِمرَأَ القَيسِ بَلقَعُ",6,"ع",1,0],["كان منه المقال نوراً فلما","حان الفَعال كان ظلاما",7,"م",2,0],["كأنَّ من رمضان النون قد مكثت","وجداً بمرآك في آفاق شوَّال",8,"ل",1,0],["كأنَّ من عُولجَ من سِحرها","زجاجةٌ يشعبُها شاعبُ",9,"ب",1,0],["كأن مناعمِي حُلمٌ تقضَّي","وأسراري مع الخلل احتلامُ",10,"م",1,0],["كان من ذاك فقدُك ابنتَك الحُرْ","رَةَ مصبوغةً بها الأكفان",11,"ن",1,0],["كانَ مِن قَبلُ أَن تَجيء وَتَمضي","وَهوَ باقٍ في الأَرضِ لِلجَزر وَالمَد",12,"د",1,0],["كانَ مِن قَبلِ حُلولَ الكارِثات","آمِناً كَالنَسرِ في وُكنَتِهِ",13,"ه",1,0],["كَأَنَّ مِنطَقَها ليثَت مَعاقِدُهُ","بِعانِكٍ مِن ذُرى الأَنقاءِ بَحباجِ",14,"ج",1,0],["كَأَنَّ مَناطَ الوَدعِ حَيثُ عَقَدنَهُ","لَبانُ دَخيلِيٍّ أَسيلِ المُقَلَّدِ",15,"د",1,0],["كان منا لك الهتاف طويلا","واذا ذلك الهتاف عويل",16,"ل",1,0],["كان منه الحب برقاً خلباً","لاح في عرض الدجى ثم اضمحلا",17,"ل",2,0],["كان من ثروة البلاد قليل","بعد عام يزول ذاك القليل",18,"ل",1,0],["كَأَنَّ مِنَ السَمَوأَلِ فيهِ شَيئًا","فَكُلُّ جِهاتِهِ شَرَفٌ وَخَلقُ",19,"ق",1,0],["كانَ مَن فيها وَإِن جازوا الثَرى","قَبلَ مَوتِ الجِسمِ أَمواتُ النُفوس",20,"س",1,0],["كانَ مِن هَمِّ نَهاري راحَتي","وَنَدامايَ وَنَقلِيَ وَالشَرابا",21,"ب",2,0],["كأن من يخدمه","في صبره من خدمه",22,"م",2,0],["كَأَنَّ مَنشورَ المُلاءِ فَوقَهُ","متى تَمِلْ ذكاءُ عنها تُرْفَعِ",23,"ع",1,0],["كأنَّ مَنافسَ البُركانِ فيها","لأهوالِ الجحيمِ بها اعتبارُ",24,"ر",1,0],["كانَ مِن فرعها الظَلا","م وَمِن وَجهِها القَمَر",25,"ر",1,0],["كانَ مِن فيه قتلُه بِيَدَيْهِ","فهو في سوء فِعله الزَّبَّاءُ",26,"ا",2,0],["كَأَنَّ مَنارَ اسْكَنْدَرِيَّةَ عنده","نَواةٌ بَدَتْ والبابُ فيهِ نَقِيرُ",27,"ر",1,0],["كأنّ منه الذي في الليلِ من غَسَقٍ","داجٍ وما بحواشي الغَيم من طَحَل",28,"ل",1,0],["كَأَنَّ مَنظَرَها وَالماءُ يَقرَعُها","ديباجُ غانِيَةٍ أَو رَقمُ وَشّاءِ",29,"ا",2,0],["كَأَنَّ مَن تَشكو إِلَيهِ الهَوى","أَصَمُّ لا يَسمَعُ نَجواكا",30,"ك",2,0],["كَأَنَّ مَن يُعنى بِتَضبيعِهِ","رَأسُ يَتيمٍ قَمِلٌ شاعِثُ",31,"ث",1,0],["كَأَنَّ مُنَجِّمَ الأَقوامِ أَعمى","لَدَيهِ الصُحُفُ يَقرَؤُها بِلَمسِ",32,"س",1,1],["كانَ مندوبها وَكانَت تباهي","برجاحاته جميعَ البلاد",33,"د",1,0],["كانَ من قصده التَمتع سراً","واِقتراح التَزويج كان جهارا",34,"ر",2,0],["كَأَنَّ مُنَحَّاهَا إِذَا الشَّمْسُ أَعْرَضَتْ","وأَجْسَامَهَا تَحْتَ الرِّحَالِ النَّوَائِحُ",35,"ح",1,0],["كانَ مِنَ الصَّبْرِ لِي دُرُوع","لَمْ يَدَعِ الدَّهُرِ لِي دُرُوعَا",36,"ع",2,0],["كانَ مِنهُ في مَكانٍ قَريبٍ","وَبَنوهُ في مَكانٍ قَصِيِّ",37,"ي",1,0],["كانَ منّاحُ ملثٍّ هاطِلٍ","وَأَراهُ آنِفاً مَنّاعَ طَش",38,"ش",1,0],["كان منهمْ مرزبَّة ٌ وسواهُ","وهو فيهم من جملة ِ الظُّرفاءَ",39,"ا",2,0],["كَأَنَّ مِنْطَقَهَا لِيثَتْ مَعَاقِدُهُ","بعانكٍ منْ ذرى الأنقاءِ بجباجِ",40,"ج",1,0],["كَأَن مُنتَظِماً لِلارغوان عَلى الأَ","غصان مُنتَثر مِن دَمعيَ القاني",41,"ي",1,0],["كأن من معناك في كامن القل","ب مشاد لهيامي رواق",42,"ق",1,0],["كَأَنَّ مِن نَغَمِكَ امتَدَّت لَهُ نِغَمٌ","ومِن أنَامِلِكِ امتَدَّت أنَامِلُهُ",43,"ل",2,0],["كانَ مِنكَ اليَقينُ لَيسَ بِشافٍ","كَيفَ إِذ رَجَّمَتكَ عِندي الظُنونُ",44,"ن",1,0],["كان من قبله بوجه عبوس","وهو لمّا أتى بثغر بسيمِ",45,"م",1,0],["كان منه الخروجَ آخر شعبا","نَ وباقي الليال قرب الثماني",46,"ن",2,0],["كأنَّ مِن زَبَدٍ جَعدٍ جَماجَمها","بِالسّابِرِىِّ وبالكَتّانِ تَختَمِرُ",47,"ر",1,0],["كانَ من خلفِهِ يَرى الناسَ فالخل","فُ لديهِ كأنّه تلقاءُ",48,"ا",2,0],["كانَ من ساءَهُ حباهُ وأبدى ال","عذرَ حتّى ظنّ المسيء المساءُ",48,"ا",2,0],["كانَ مِنهم إنشادهُ حينَ يسري الس","سرُّ فيهم فينشأ الإنشاءُ",48,"ا",2,0],["كأنّ من شفني عدوّي","وهو على رغم ذاك حِبِّي",49,"ب",2,0],["كأَنَّ مِنْ وَشْي صَنْعَاءَ بِها شيَةً","فَلِلْعُيونِ بِصُنْعٍ زَانَها شَغَفُ",50,"ف",1,0],["كانَ مِن أَعلَمِ الأَنامِ بِأَسما","ءِ رِجالِ الحَديثِ وَالعُلَماءِ",51,"ا",2,0],["كانَ مِن وَصمَةِ التَغَيُّرِ وَالتَّص","حيفِ أَمناً لِخابِطِ العَشواءِ",51,"ا",2,0],["كانَ مِن قَبلُ ذا اِسوِدادٍ وَقَد أَذ","هَبتَ ذاكَ السَوادَ بِالإِذهابِ",52,"ب",1,0],["كَأَنَّ مِن فَوقِ هَذِهِ عَدَمٌ","لَم يوجِدوا أَو كَأَنَّهُم قَبَروا",53,"ر",3,0],["كان منها المسير قصد مني ال","خيف في ثامن من الأيام",54,"م",1,0],["كانَ مِنّي إِلَيكَ لَومٌ وَعَتبٌ","إِذ أَتى البُنُّ وَهوَ كَالصَبرِ مُرّا",55,"ر",2,0],["كان من أوجد الورى من تراب","وله في الوجود أعظم آيه",56,"ه",1,0],["كان من كان بدؤه بدء دنياه","ومن لا يحده الانتهاء",57,"ا",2,0],["كانَ مِنَ الحَنِّ وَفي البِن","نِ وَالطِمِّ وَفي الرَمِّ يَرُمُّ الرَميم",58,"م",1,0],["كأن من الياقوتِ قيست رؤوسُها","على كلّ مسنونٍ مقيضٍ من السدر",59,"ر",1,0],["كانَ مِن قبلِ عارِضَي","هِ بَديعاً كَما وُصِف",60,"ف",1,0],["كَأَنَّ مُناخَها مُلقى لِجامٍ","عَلى مَعزائِها وَعَلى الوَجينِ",61,"ن",1,0],["كان من قبلُ ذا يجذب جهلاً","منه إن الإِغرا من التحذير",62,"ر",1,0],["كان من قبل الهوى مجتهداً","فارتضى في الحب تقليد الظبا",63,"ب",2,0],["كَأَنَّ مَنازِلي وَدِيارَ قَومي","جَنوبُ قَناً وَرَوضاتِ الرُبابِ",64,"ب",1,1],["كانَ من ريق الحميَّا موردي","وبأَزهار الغواني مرتعي",65,"ع",2,0],["كَأَنَّ من وجهِكَ الوضَّاحِ قابَلَهُ","نورٌ أَنارَ إِلَيْهِ وَجْهَ مَقْصِدِهِ",66,"د",2,0],["كان من أَسَّسها إيمانُهُ","برسالاتِ الهدَاةِ الأمُناء",67,"ا",2,0],["كَأَنَّ مَن لامَني لأَصرِمَها","كانُوا عَلَينا بِلَومِهِم شَفَعُوا",68,"ع",3,1],["كان منّا ما كان حتّى أفقنا","واستفاقتْ من سكْرتِها الشّرورُ",69,"ر",1,0],["كأنّ منْ نفَسِ الرّحمنِ أنفُسهمْ","مخلوقةٌ فهْوَ مَطويٌّ بنَشْرِهمِ",70,"م",1,0],["كأنّ منها سِوارَ البِكر شمسُ ضُحىً","شقّ الصّباحُ حَشاها فهْي تصطخِبُ",71,"ب",1,0],["كانَ منَّا كَمِعصَمٍ مِن سِوَارٍ","بِهِ طُفنَا طَوَافَ سورٍ مَتينِ",72,"ن",1,0],["كانَ من قبل ذاكَ سترٌ رقيقٌ","بَيننا فَاِستَلبتُمُ الأستارا",73,"ر",2,0],["كأنَّ مَنزِلَ خِضْرٍ ذَاتُ فاكِهةٍ","مِنَ الجِنانِ بها نخْلٌ ورُمَّانُ",74,"ن",1,0],["كان من قولِه ألا تعودوا","بعد موتي في رِدِّةِ وعُنودِ",75,"د",1,0],["كان من الزمانُ فضاً حتى إِذا ملكوا","تمييزَهُ مَيزوا فانمازَ كلُّ فضا",76,"ض",2,0],["كأَنَّ من جوهرٍ تُنُوسِخَ أو","كأَنَّ منه تُنُوسِخَ الجوهر",77,"ر",1,0],["كانَ مِن أَهلِهِ شموسٌ وبَدرٌ","ثمَّ نَجمٌ حَلّوا بُروجَ المَعالي",78,"ل",2,0],["كَانَ مِنْ عَارِضِ شَكْ","وايَ وَمِنْ دَهْرِي مَجيرَا",79,"ر",2,0],["كانَ مِنهُ غُصنُ الشَّبيبَةِ غَضّاً","فَتَصَدَّت لِكَسرِهِ الحادِثَاتُ",80,"ت",1,0],["كأن من الشهد المصفى لقاءهم","لربهم يوما ألحوا وأسرعوا",81,"ع",3,0],["كان مناه رغيف دخن","وقد غدا يبشم الرقاقا",82,"ق",2,0],["كأنّ منَ السماحة والن","نَدى خُلقت أكفّهما",83,"م",2,0],["كَأَنَّ مِنْ عادِيَّةٍ مَقَابِرا","أَوْ قَرْنَ حَيْدَى راسِهِ قبائِرا",84,"ر",2,0],["كانَ مِنْ خطِّكَ مَوْشيّاً بما","تَبْتَدي أَلطفَ شَيْءٍ بَعْدَ ذا",85,"ذ",2,0],["كأَن من بني صَخرٍ سيوفك لم تكن","مَقامَ جفونِ العين قام ذبابها",86,"ب",3,0],["كأنَّ من وقاره حبوتُه","تضمنُ منه الطودَ في انعقادها",87,"د",3,0],["كأنَّ منها البنانَ ضئرٌ","يرتضعُ الدهرُ ما تميحُ",88,"ح",1,0],["كأن من يعذل في حسنه","يروم يخفي البدر عند التمام",89,"م",1,0],["كان مني لمنتهى أحد الشو","ق بلوغ لو كان قصدي سواها",90,"ا",3,0],["كان من خلفك يمشي خالفًا","صرت تمشي