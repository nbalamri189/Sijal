{"poems":[[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[88,"سائلوا الليل عنهم والنهارا","https://www.aldiwan.net/poem10926.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42571","المنسرح"],[443,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[580,"","https://poetry.dctabudhabi.ae/diwan/poem/47713","الخفيف"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49899","الرجز"],[1837,"","https://poetry.dctabudhabi.ae/diwan/poem/143885","الخفيف"],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""]],"verses":[["كَيفَ طَوى دارَكِ ذو صَبوَةٍ","عَهدي بِهِ يَطرَبُ لِلمَربَعِ",0,"ع",1,0],["كَيفَ طاحَ العَجوزُ تَحتَ جِدارٍ","يَتَداعى وَأَسقُفٍ تَتَجارى",1,"ر",2,0],["كيفَ طالعتَ على آفاقها","روعةَ الغيبِ وأسرارَ السماءْ",2,"ا",2,0],["كَيْفَ طَوَتْكَ الْمَنُونُ يَا وَلَدِي","وَكَيْفَ أَوْدَعْتُكَ الثَّرَى بِيَدِي",3,"د",2,1],["كيف طالت يد المنية حتى","أنزلته من فوق سبع شداد",4,"د",1,0],["كيف طافَ اللِّحاظ بُسْتَانَ خدٍّ","وَعَلَيه من صُدغِه زُرْفِينُ",5,"ن",1,0],["كَيف طباعكم وَما حالاتكم","بأي شيء يَنقَضي أَوقاتكم",6,"م",1,0],["كَيْف طَيَّرْتُموه ف سعةِ الآ","فاقِ وهْو المُدَلَّهُ الْمَقصُوصُ",7,"ص",1,0],["كيف طب وطبيب ، لجرحه وبلسمه","وكل ما جاه عطشان ٍ رجع ماشرب",8,"ب",1,0]]}