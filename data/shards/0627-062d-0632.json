{"poems":[[74,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[87,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[51,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[68,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85400","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[101,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[186,"أيها النائح المبكر مهلا","https://www.aldiwan.net/poem67040.html","الخفيف"],[382,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[396,"باسمك اللهم أبدى ما خطر","https://www.aldiwan.net/poem54574.html","عموديه"],[563,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53832","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145790","الكامل"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131929",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87843","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121194","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100405","المديد"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58360","الخفيف"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122494","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108070","البسيط"],[3645,"","https://poetry.dctabudhabi.ae/diwan/poem/99285","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110048","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131099",""],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101369","الخفيف"],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[4955,"لبسمة الطفل سحر لا يماثله","https://www.poetsgate.com/ViewPoem.aspx?id=190487",""],[4978,"أحزنتني لا رأيت الهمّ والحزنا","https://www.poetsgate.com/ViewPoem.aspx?id=177377",""],[5002,"جرح الأوطان...","https://www.poetsgate.com/ViewPoem.aspx?id=202381",""],[5002,"أحزنتني يادهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206680",""],[5038,"يا راحلا","https://www.poetsgate.com/ViewPoem.aspx?id=188937",""],[5092,"نجمٌ بأخيلتي والليلُ يحجبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=176221",""],[5092,"أنثايَ","https://www.poetsgate.com/ViewPoem.aspx?id=180133",""],[5264,"حقك يا شعب الحرق بجاز","https://www.poetsgate.com/ViewPoem.aspx?id=121866",""],[5277,"نوافلُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=200533",""],[5285,"سميرة","https://www.poetsgate.com/ViewPoem.aspx?id=203519",""],[5285,"خالد","https://www.poetsgate.com/ViewPoem.aspx?id=204393",""],[5376,"احزمْ متاعَك أيها الرجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198998",""],[5431,"كم مسنا الضر ياحنان انت لها","https://www.poetsgate.com/ViewPoem.aspx?id=189875",""],[5493,"هذي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=197567",""],[5550,"لا تكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=215331",""],[5606,"الثقه متبادله بين الثقات","https://www.poetsgate.com/ViewPoem.aspx?id=196664",""],[243,"رثاء القطيع","https://www.poetsgate.com/ViewPoem.aspx?id=50482",""],[5672,"ما لم يقله رؤبة بن العجاج","https://www.poetsgate.com/ViewPoem.aspx?id=213612",""],[5683,"برج الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=32346",""],[5720,"عاصِفةُ الحَزْم","https://www.poetsgate.com/ViewPoem.aspx?id=199941",""],[5815,"تداعيات","https://www.poetsgate.com/ViewPoem.aspx?id=197624",""],[5848,"ياليتني مابديت","https://www.poetsgate.com/ViewPoem.aspx?id=48828",""],[5865,"جزعاً نذوب","https://www.poetsgate.com/ViewPoem.aspx?id=179882",""],[5956,"جوبي السهول","https://www.poetsgate.com/ViewPoem.aspx?id=184926",""],[5956,"أحزانٌ على فقرِ بعض الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=200036",""],[5956,"الله بوَّأ فريد الأطرش وأختَهُ رتبةً أُولى","https://www.poetsgate.com/ViewPoem.aspx?id=203554",""],[5956,"يا ألفَ شكر للسمية بِنْتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=206261",""],[5957,"أوراق حزني","https://www.poetsgate.com/ViewPoem.aspx?id=53846",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6124,"النرجس يغري القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=131004",""],[5309,"أحزنت قلبا ليس فيه سوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573869",""],[6228,"نبحث عن بقيتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85967&r=&rc=4",""]],"verses":[["أحزان مدّكرٍ ووحشةُ مفردٍ","ومقام مضيعة وذلّ جوار",0,"ر",1,0],["أَحزِ اِجتِهادَكَ في جَنى","الثَمَراتِ لِلنَشءِ النَهيمِ",1,"م",1,0],["اِحزُن لِسانَكَ بِالسُكوتِ عَنِ الخَنا","وَاِحذَر عَلَيكَ عَواقِبَ الأَقوالِ",2,"ل",1,0],["أَحزَنَنا فُقدانُهُ فَاِنجَلَت","بِالمَلِكِ الأَفضَلِ أَحزانُه",3,"ن",2,0],["أحزم بناس رأوا في أَرضهم فتناً","فَلَم يَكونوا لمن قاموا بها عضدا",4,"د",2,0],["أَحْزَمُ الْخَلْقِ إِنْ يَكُنْ","سَرَفٌ جَالِبُ الْعَطَبْ",5,"ب",1,0],["أحزانيَ الصغرى .. تعانقنيَ","وتزورنيَ ... أن لم تزوريني",6,"ن",2,0],["أَحزمَ البارعينَ عَقداً وَحَلاًّ","وَأَجَلُّ الكِرامٍ وَصفاً وَحَملا",7,"ل",2,0],["أحزانُه وإياسه وعذابه","كفراشه ووسادِه وغِطائه",8,"ا",3,0],["احزم الناس الذي لا يقرب بالورد","حتى يعرفن كيف الصدر",9,"ر",1,0],["أحزاننا بلقائكم أفراحُ","وزماننا قدح وأنتم راحُ",10,"ح",1,1],["أحزان نفسي عنها غير منصرمه","وأدمعي من جفون الدهر منسجهُ",11,"ه",1,1],["أحزاب مصر إذا رضيت قلادة","شتى فرائدها وأنت الناظم",12,"م",1,0],["أحزابُهُمْ تلكَ الدكاكينُ التي","بِيْعَتْ بها هذي البلادُ جَهَارا",13,"ر",2,0],["أحزُّ مُفوَّقُ السهمين لما","رمى عن قوس حاجبه الرفيقا",14,"ق",2,0],["أحزننا أحزننا بعده","وقبله افرحنا قربه",15,"ه",1,0],["أَحزَمَ لا فَوقٍ وَلا حَزَنبَلِ","مُوَثَّقِ الأَعلى أَمينِ الأَسفَلِ",16,"ل",1,0],["أحزابه النصر فإن تحزبت","أعداؤه تفرقت أيدي سبا",17,"ا",1,0],["أحزمُ العالمين رأياً وأقوا","هم على العاجمين عوداً صليبا",18,"ب",2,0],["أَحَزماً وَلا أَلقى سِوى الضَنكِ وَالأَسى","إِذاً فَاِجتِنابُ الحَزمِ قَد كانَ أَحزَما",19,"م",2,0],["احزنتموا كل نسر قشعم ولقد","فرقتموا بين حد السيف والقمم",20,"م",1,0],["احزنوا والقلب يحفزه ال","حافزان الشوق والحزن",21,"ن",1,0],["أحزِرُ البيضَ قبلَ أنْ يكسروهُ","أنَّ فيهِ البياضَ فوقَ الصّفَار",22,"ر",1,0],["أحزَنَ البانِيَ القُصُور وأشجَى","عرباً فِي العراءِ تَبنِى الخِيَامَا",23,"م",2,0],["احزن على مصطفى والطم يداً بيدِ","وقل تغيب والهفي فتى البلدِ",24,"د",1,1],["أحزاننا بهم لا تنقضي ولنا","شوق إلى ساكني يبرين يبرينا",25,"ن",2,0],["أحزانُ موتك وِقرُ حِملٍ باهظٍ","أَقوَت ذِرى من ثِقلهِ واسافلُ",26,"ل",1,0],["أحزت من المناقب ما تباهي","به الأقران في قرب وبعد",27,"د",1,0],["أحزم الناس ناهضاً بعظام","من مساعيه لا عظام الدفائن",28,"ن",1,0],["أَحْزَاْبُهَاْ مِنْ كُلِّ ثَوْبٍ رُقْعَةٌ","قَدْ خَاْطَهَا الْخَيَّاْطُ وَالرَّفَاْءُ",29,"ا",2,0],["10- \"أَحْزَاْبُ جَبْهَتِهِمْ\" تُوَزِّعُ كَعْكَنَاْ","مَاْ بَيْنَهَاْ، وَتَنَاْلُنَا الثُّؤَبَاْءُ",29,"ا",2,0],["أحزانُ قلبي على أسوارِ بسمتهِ","تُعلِّقُ الحبلَ من فرْحٍ وتنتحرُ",30,"ر",1,0],["أحزنتني لا رأيت الهمّ والحزنا","وطال عمرك في بحبوحة وهنا",31,"ن",2,1],["أحزان أوطانِنا شرخٌ نلملمهُ","أنِينُه وجعٌ يُوْشي به الآنُ",32,"ن",1,1],["أحٔزَنْتَنِي يادَهرُ في زمَنِ الهَنا","وجَوَاهرُ الأفْراح ِفي كفِّ الدُّنَى",33,"ن",2,1],["أَحْزانُهُ تُزْري بهِ","ومسيلُ عينيهِ انْهَمَرْ",34,"ر",1,0],["أحزاننا جبلٌ والقلبُ يحملها","والعمرُ في سَنَني ليلٌ وأنفاقُ",35,"ق",1,0],["أحزاننا جبلٌ بالقلبِ مسكنها","ما عدتُ أقوى على حزنٍ لأحتملا",36,"ل",2,0],["أحزاننا فوق راسنا تواصل - وهو دا الحاصل","واقلامنا تكتب وتواصل - أقلام أحرار",37,"ر",1,0],["أحزانُهمْ للآنَ باقيةٌ","يغتالها غمدٌ ..ولا نصْلُ",38,"ل",1,0],["أحزانُنا الخرساءُ تذرف دمعةً","بالعين تجري نارها تُدمينا",39,"ن",2,0],["أحزنتني ، والفكر فى قلقٍ","يُسقَى ظنوناً من مراويهِ",40,"ي",2,0],["احزمْ متاعَك أيها الرجلُ","فالموتُ آتٍ كم به وصلوا",41,"ل",3,1],["أحزانهم وطناً قد بات يظلمهم","أهلوه لاقوا أذى حاكوه ضلالُ",42,"ل",1,0],["أحزانُنا مثل الورودِ تضوّعتْ","لمَّا وصفناها بحرْفٍ من ألقْ",43,"ق",1,0],["أحزمُ الناس مَنْ إذا رام شيئًا","جعل الدَّهرَ سامعًا ومنيلا",44,"ل",2,0],["أحزم أمرك قبل يكثر طالبيها","مايفيد الحزن لو فات الفوات",45,"ت",1,0],["أحزنا على ما أصاب القطيع","رفيق هواها عراها السقم",46,"م",1,0],["أحزنا على ما أصاب القطيع","أليف الروابي اعتراك الألم",46,"م",1,0],["أحزانه تدنيه والبعد انبثقْ","فها هما من طبق على طبقْ",47,"ق",1,0],["أحزاني أوراق .. وعنا وقتي أقلام","وهمومي أتعابٍ على .. صدر الابيات",48,"ت",1,1],["أحْزِمْ .. فكلُّ الشعبِ خلفكَ حازمٌ","لكَ ندفعُ الأبناءَ .. والأحفادا",49,"د",2,0],["أَحْزَمْتُ أَمْتِعَتي لكنْ وَجَدْت بِهَا","إشْرَاقَة لِسَنَا فيهِ اِزْدَهَتْ صُوَري",50,"ر",2,0],["أحزاني المعشبة وافراحي المجدبة","والخطوة اللي رجعت بها .. وفيها خطيت !",51,"ت",1,0],["أحزانُنا مِلءَ الحياةِ وليلُها","لم يُبقِ من ألقِ المشاعرِ رُبعَهْ",52,"ع",2,0],["أحزانُ قلبي على شعبي مكدَّسةً","قَدَّمْتُ لله – كي يمحو الأسى – قُرَبِي",53,"ب",2,0],["أحزانُ فقر الأرضِ يُقلق بالي","لاسيما مشقوقة الأسمالِ",54,"ل",1,0],["أحزانُه مِن شأنها تطهيرُنا","مِن حزننا بدوائها التَّطهيري",55,"ر",2,0],["أحزنتُها بقصائدٍ عن صحتي..","وبرغم هذا لا تدُعُّ المُحْزِنا",56,"ن",2,0],["أحزان قلبي في دمائي سارية","دعني وهذا الحب إني ماضية",57,"ي",2,0],["أَحزَانُها طَالتْ مَدَى قُنَنًا","غَدرٌ جَرَى وَالظُلمُ كَالظُّلَمِ",58,"م",1,0],["أَحزانَ قلبٍ هائمٍ قصَّ الليالي مَنْهَجَا","فاضتْ علَى أَوجاعنا رَوضًا رَقِيقًا مُسْرَجَا",59,"ج",2,0],["أَحزَنتِ قَلباً لَيسَ فيهِ سِوى","إِخلاصِهِ لِلمَكرُماتِ هَوى",60,"و",2,1],["أحزاننا صحراء مجدبة","وكتاب خالقنا لها مطرُ",61,"ر",1,0]]}