{"poems":[[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[66,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85400","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[99,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[183,"أيها النائح المبكر مهلا","https://www.aldiwan.net/poem67040.html","الخفيف"],[378,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[392,"باسمك اللهم أبدى ما خطر","https://www.aldiwan.net/poem54574.html","عموديه"],[559,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"]],"verses":[["أحزان مدّكرٍ ووحشةُ مفردٍ","ومقام مضيعة وذلّ جوار",0,"ر",1,0],["أَحزِ اِجتِهادَكَ في جَنى","الثَمَراتِ لِلنَشءِ النَهيمِ",1,"م",1,0],["اِحزُن لِسانَكَ بِالسُكوتِ عَنِ الخَنا","وَاِحذَر عَلَيكَ عَواقِبَ الأَقوالِ",2,"ل",1,0],["أَحزَنَنا فُقدانُهُ فَاِنجَلَت","بِالمَلِكِ الأَفضَلِ أَحزانُه",3,"ن",2,0],["أحزم بناس رأوا في أَرضهم فتناً","فَلَم يَكونوا لمن قاموا بها عضدا",4,"د",2,0],["أَحْزَمُ الْخَلْقِ إِنْ يَكُنْ","سَرَفٌ جَالِبُ الْعَطَبْ",5,"ب",1,0],["أحزانيَ الصغرى .. تعانقنيَ","وتزورنيَ ... أن لم تزوريني",6,"ن",2,0],["أَحزمَ البارعينَ عَقداً وَحَلاًّ","وَأَجَلُّ الكِرامٍ وَصفاً وَحَملا",7,"ل",2,0],["أحزانُه وإياسه وعذابه","كفراشه ووسادِه وغِطائه",8,"ا",3,0],["احزم الناس الذي لا يقرب بالورد","حتى يعرفن كيف الصدر",9,"ر",1,0],["أحزاننا بلقائكم أفراحُ","وزماننا قدح وأنتم راحُ",10,"ح",1,1]]}