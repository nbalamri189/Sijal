{"poems":[[64,"وفاتك أفديه من فاتك","https://www.aldiwan.net/poem52325.html","السريع"],[308,"قال وقد أبصر دمعي دما","https://www.aldiwan.net/poem58143.html","السريع"],[333,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[500,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38515","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77539","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202974","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112691","الرجز"],[4239,"","https://poetry.dctabudhabi.ae/diwan/poem/102201","الرجز"],[4830,"مجرى دمي","https://www.poetsgate.com/ViewPoem.aspx?id=202615",""],[5277,"أحدَ عشرَ حسرةً","https://www.poetsgate.com/ViewPoem.aspx?id=200167",""]],"verses":[["قال وقد حاولتُ تقبيلَهُ","اِطْوِ الحَشا طَيّاً على ياسِكْ",0,"ك",1,0],["قال وقد أبصر دمعي دما","هذا وما رعتك بالبين",1,"ن",1,1],["قال وقد ضاقت به نفسه","وعاودته الذكريات النكر",2,"ر",1,0],["قال وقد راش بها دلّها","كما انثنى تحت الصَّبا غصن بان",3,"ن",1,0],["قالَ وَقَد أَورَق مِن ريعةٍ","لا تَعجَبوا شَرِبت ماءَ الحَياه",4,"ه",1,0],["قالَ وَقَد أَحسَن في المَقال","إِسمي مَكتوب عَلى نعالي",5,"ي",1,0],["قال وقد طوّقته في يدي","وخدّه الورد على خدي",6,"د",2,0],["قال وقد أقبل في قوم معه","يا رب هيجا هي خير من دعه",7,"ه",1,0],["قال وقوله لدينا معتمد","إذ قوله بفعله قد اتحد",8,"د",1,0],["قالَ وقد سارقتُه نظرةً","كم أنذرَتْ عيني فقد أُعذِرَتْ",9,"ت",1,0],["قالٌ وقيلٌ وتقتيلٌ ومخمصةٌ","والحربُ صارت سلاماً بالأقاويلِ",10,"ل",1,0]]}