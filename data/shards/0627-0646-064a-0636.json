{"poems":[[86,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[91,"أزف الرحيل وحان أن نتفرقا","https://www.aldiwan.net/poem8988.html","عموديه"],[85,"قل للمنجم بالأرزاء ينذرنا","https://www.aldiwan.net/poem7247.html","البسيط"],[62,"قالوا صبرت على المكروه من نفر","https://www.aldiwan.net/poem52427.html","البسيط"],[105,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[105,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[377,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"]],"verses":[["إِنّي ضَمينُ المُسلِمينَ جَميعُهُم","أَن يُخلِصوا لَكُم إِذا أَخلَصتُمُ",0,"م",1,0],["إِنّي ضَمِنتُ لَكِ الحَياةَ شَهِيَّةً","في أَهلِها وَالعَيشَ أَزهَرَ مونِقا",1,"ق",2,0],["إنى ضحكت من الدنيا وصحبتها","قبل المذنب حتى مِتّ من ضحكي",2,"ي",1,0],["إنْ يضطهدْنِيَ مَنْ دونِي فلا عَجَبٌ","هو الزمانُ يصيدُ الصقرَ بالنغرِ",3,"ر",1,0],["إِن يَضحَكوا بَينَ المَواكِبِ مَرَّةً","فَلَقَد بَكَيتُ عَلى البِلادِ مِرارا",4,"ر",2,0],["إن يضربوه ففارسٌ ذو نجدةٍ","ما انفكَّ يطعنُ في النُّحورِ وَيضرب",5,"ب",1,0],["إني ضُربت وليتها","كانت عليَّ القاضيه",6,"ي",2,0],["إني ضعيفٌ عندها","كوني لضعفي حاميه",6,"ي",2,0]]}