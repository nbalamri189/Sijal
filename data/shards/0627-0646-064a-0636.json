{"poems":[[88,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[93,"أزف الرحيل وحان أن نتفرقا","https://www.aldiwan.net/poem8988.html","عموديه"],[87,"قل للمنجم بالأرزاء ينذرنا","https://www.aldiwan.net/poem7247.html","البسيط"],[64,"قالوا صبرت على المكروه من نفر","https://www.aldiwan.net/poem52427.html","البسيط"],[107,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[107,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[382,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88601","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35388","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112768","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109261","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48944","الرمل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105433","الرمل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114026","الخفيف"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95200","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27933","المجتث"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27917","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65980","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200013",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89171","المتدارك"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74022","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132124","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136017","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135773","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4921,"بك أستجير فمن يجير سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=3652",""],[585,"مهلاً عليَّ فإني الموجع الدنف","https://www.poetsgate.com/ViewPoem.aspx?id=161915",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5431,"لو أن لي...","https://www.poetsgate.com/ViewPoem.aspx?id=192197",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""]],"verses":[["إِنّي ضَمينُ المُسلِمينَ جَميعُهُم","أَن يُخلِصوا لَكُم إِذا أَخلَصتُمُ",0,"م",1,0],["إِنّي ضَمِنتُ لَكِ الحَياةَ شَهِيَّةً","في أَهلِها وَالعَيشَ أَزهَرَ مونِقا",1,"ق",2,0],["إنى ضحكت من الدنيا وصحبتها","قبل المذنب حتى مِتّ من ضحكي",2,"ي",1,0],["إنْ يضطهدْنِيَ مَنْ دونِي فلا عَجَبٌ","هو الزمانُ يصيدُ الصقرَ بالنغرِ",3,"ر",1,0],["إِن يَضحَكوا بَينَ المَواكِبِ مَرَّةً","فَلَقَد بَكَيتُ عَلى البِلادِ مِرارا",4,"ر",2,0],["إن يضربوه ففارسٌ ذو نجدةٍ","ما انفكَّ يطعنُ في النُّحورِ وَيضرب",5,"ب",1,0],["إني ضُربت وليتها","كانت عليَّ القاضيه",6,"ي",2,0],["إني ضعيفٌ عندها","كوني لضعفي حاميه",6,"ي",2,0],["إِن يضطرب ركن الفخار","فأَنت أَمسكت اضطرابه",7,"ب",2,0],["إِن يَضرِبِ الشُعراءُ في النَدى مَثَلاً","بِجودِ أَملاكِهِم فَأَنتُمُ مَثَلي",8,"ل",2,0],["إني ضعيف نازل","بجنابكم أبغى الجوار",9,"ر",1,0],["إن يضجروا منك ولا","يبقى لهم قلب يحنّ",10,"ن",1,0],["إن يَضِق صدرُك فيما قد حوى","فضعِ القلب بصدر رحِب",11,"ب",1,0],["إن يضق في اليوم بي رحب الفضا","فغداً يجري بما أهوى القضا",12,"ض",2,1],["إن يَضنّ السَّحاب بالقطر يزخر","بحر كفيهِ بالنُّضَار الصّراح",13,"ح",1,0],["إن يضربُوه فلا عجب","التبر بالضربِ قد يُصاغُ",14,"غ",1,0],["إني ضعفتُ إلهي","وصِرتُ شيخا عتيّا",15,"ي",2,0],["إني ضربت حجاباً ليس يرفعه","سواه أو من به الألبابُ تعتصم",16,"م",1,0],["إن يضحكوا في دارهم طال البكا","منهم بدار الويل والولوال",17,"ل",1,0],["إني ضبطت أصوله","كيف الخروج على الأصول",18,"ل",1,0],["إن يضحك يوماً تحسبه","قرداً مما يَخشى جعَّر",19,"ر",1,0],["إن يَضمَحلّ هَوى المَها","فَهوى الحمى لا يَضمَحِلُّ",20,"ل",1,0],["إنِّي ضعيفٌ في المحبَّة فاشدُدُو","ني بالزُهور بُحبِّ ذَيَّاكَ الفَتَى",21,"ا",1,0],["إن يضحكنا الدهر ملء ثغورنا","فاصبر فبعد هنيهة يبكينا",22,"ن",2,0],["إِنْ يُضِعْ حَقَّكَ ذُو نَقْصٍ فَلاَ","يَعْرِفُ الكَامِلَ إِلاَّ مَنْ كَمَلْ",23,"ل",1,0],["إنّي ضعيفٌ في ضعيفٍ في ضعيفْ","وإنَّني ملْك الكريم واللطيفْ",24,"ف",1,1],["إني ضعيفٌ وفقيرٌ عاجزُ","وللرذائل جميعاً حائزُ",25,"ز",1,0],["إني ضمنت لك الفدور فما ترى","من بعده عزهاً ولا منجوفا",26,"ف",2,0],["إني ضعيف أستعين على قوى","ذنبي ومعصيتي ببعض قواكا",27,"ك",2,0],["إن يضفر الغار إكليلاً لشاعرهم","أقطاب رومة حسبي الطلع والسعف",28,"ف",1,0],["إنِّي ضَمَمتُ جَنَاحَ مَوتِي ضَاحِكًا","لَم أخشَ كسرَى جُندَهُ أو تُبَّعَا",29,"ع",2,0],["أني ضممتك للحشا متوحدا","فيها إليها منك أنت الموطن",30,"ن",1,0],["إنْ يضْحَ وَارِثُهُ سِوَايَ فَذَا لَهُ","سَهمٌ يُخَصُّ بِهِ وَذَاكَ سُهُومُ",31,"م",1,0],["إِني ضاع فكري بين عقلي وراشدي","وَعلمت أَني بِالقدار عسار",32,"ر",1,0]]}