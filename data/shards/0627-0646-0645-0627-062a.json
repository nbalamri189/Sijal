iewPoem.aspx?id=87998",""],[4869,"الامير نايف بن عبدالعزيز رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=138050",""],[4955,"إن ما تأملت الخلائق كلها","https://www.poetsgate.com/ViewPoem.aspx?id=188763",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[4119,"لا تناظر جاهلا","https://www.poetsgate.com/ViewPoem.aspx?id=16249",""],[585,"دحر البدر حملة الظلماء","https://www.poetsgate.com/ViewPoem.aspx?id=161860",""],[5075,"قلبي على أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=196818",""],[2365,"ذكرت شيب العذارين نوار","https://www.poetsgate.com/ViewPoem.aspx?id=200648",""],[5246,"يا من يؤمل أن ينال ويرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187068",""],[5409,"وحد الرأي كل قومٍ سوانا","https://www.poetsgate.com/ViewPoem.aspx?id=155391",""],[5409,"عدتها والفكر منها","https://www.poetsgate.com/ViewPoem.aspx?id=155256",""],[5409,"نكص الخصم عنك نكص الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=155265",""],[5431,"للحب منزلةٌ بها تُرضيه ...","https://www.poetsgate.com/ViewPoem.aspx?id=199053",""],[5431,"موت الضمير...","https://www.poetsgate.com/ViewPoem.aspx?id=201304",""],[5629,"الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=184606",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"أجثو على قدميك أرجو الأمنا","https://www.poetsgate.com/ViewPoem.aspx?id=182414",""],[5956,"قصة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=192417",""],[5956,"رعى البلاد كما يريده ربُّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194668",""],[6115,"حييت ياشاعر يثمن كلامه","https://www.poetsgate.com/ViewPoem.aspx?id=196487",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[5001,"أيها الساري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80724&r=&rc=14",""],[572,"سيّدي أنتَ مِمَّ سووُّك قُلْ لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9393&r=&rc=250",""]],"verses":[["إن مات عن قتلهم طين تجسدهم","حيناً فما ماتت الأعراف والقيم",0,"م",1,0],["إنما تصغُر الخُطوب لدى القو","م إذا كانت النفوس كبارا",1,"ر",2,0],["إِنَّما تَجري التَصاري","فُ بِتَقليبِ الدُهورِ",2,"ر",1,0],["إنما تُبْرز الجوَاهِرُ ما في","ها إذا ما أَمَعْتها بالصِّلاءِ",3,"ا",2,0],["إنما تُرْتجى البقيّةُ ممن","فيه بُقيا وموضعٌ للبقاءِ",3,"ا",2,0],["إنما تُبذَلُ اللُّهى لابتغاء ال","حمدِ في سدِّ خَلَّةِ المنكوبِ",4,"ب",1,0],["إِنَّما تِلكُ أَخلَفَت","قَبلَ لَيلَينِ مَوعِدي",5,"د",2,0],["إِنَّما تَفتَدي الرَعِيَّةُ مَلكاً","باذِلاً نَفسَهُ فِدىً لِلرَعِيَّه",6,"ي",2,0],["إنما ترتقي الشعوب بعلم","تقتنيه بالدرس لا باضطراد",7,"د",1,0],["إِنَّما تُنجِحُ المَقالَةُ في المَر","ءِ إِذا صادَفَت هَوىً في الفُؤادِ",8,"د",1,0],["إِن ماتَ ماتَ بِلا فَقدٍ وَلا أَسَفٍ","أَو عاشَ عاشَ بِلا خَلقٍ وَلا خُلُقِ",9,"ق",1,0],["إِنَّما تَنفي الحَياةَ المَنايا","مِثلَما يَنفي المَشيبُ الشَبابا",10,"ب",2,0],["إِنَّما تَنظُرُ العُيونُ مِنَ النا","سِ إِلى مَن تَرجوهُ أَو تَخشاهُ",11,"ا",2,0],["إنْ ماتَ هذا صورةً","أحيَتْهُ معنىً سالفاتُهْ",12,"ه",1,0],["إنما تُجْتَلَى الوُجُوهُ إذَا ما","جُلِيَتْ عِنْ مِرْآتِهَا الأصْداءُ",13,"ا",2,0],["إِنَّما تَسرَحُ آسادُ الشَرى","حيثُ لا تُنصَبُ أَشراكُ الحَدَق",14,"ق",1,1],["إِنَّما تَيَّمَ قَلبي","بَقَرٌ في الحَجَلاتِ",15,"ت",1,0],["إِن ماتَ صاحِبُكُم فَجُدّوا بَعدَهُ","في النُسكِ وَاِتَّخِذوا الخُشوعَ جَليسا",16,"س",2,0],["إِن ماتَ جِسمٌ فَهَذي الأَرضُ تَخزِنُهُ","وَإِن نَأَت عَنهُ روحٌ فَهِيَ بِالفَلَكِ",17,"ك",1,0],["انما تمنعني من","نيله عزة نفسي",18,"ي",1,0],["إنما تُبْعَثُ في هذا الثَّرى","بعضَ ما يُقطَفُ أو ما يُحصَدُ",19,"د",1,0],["إنما تنظرُ السما","ءُ إلى هذه الصوَرْ",20,"ر",1,0],["إِنَّما تُحمَدُ عُقبى أَمرِهِ","مَن لِأُخراهُ بِدُنياهُ اِشتَرى",21,"ر",2,0],["إنما تطُهرُ السرائرُ بالصو","م، وتصفو صفاءَ ماءِ الغمام",22,"م",1,0],["إنّما تنبت الكرامات أرض","\" سمّدت تربها \" عظام الأضاحي",23,"ح",2,0],["إن ما تغسلين رجليكِ فيه","ليس ماءً، هذا نزيف حريقي",24,"ق",2,0],["إنّ ما تفعلُ المناجلُ فيها","دونَ ما يفعلُ الشجا والوجيب",25,"ب",1,0],["إنما تحسن في كني","ف إذا كان عندنا",26,"ن",2,0],["إِنَّما تَنظُرُ العُيُونُ لِشَخصَينِ","لِمَن تَرتَجيهِ أو مَن تَخافُه",27,"ه",1,0],["إنما تسألُ عن علمك بالشىء","أو قد كنت في شىءِ مُضلْ",28,"ل",1,0],["إنما تعدَم البِلادُ متى غب","تَ ضياءَ الآفاق شمساً وبدرا",29,"ر",2,0],["إِنَّما تُدرَك غاياتُ المُنى","بِمَسيرٍ أَو طِعانٍ أَو جِلادِ",30,"د",1,0],["إِنَّما تِلكَ سُنَّةٌ لِلمَآقي","سَنَّها العَجزُ في الخَطوبِ العِظامِ",31,"م",1,0],["إنما تعمر العوالم بالح","ب وفي الحسن بهجة الأكوان",32,"ن",1,0],["إنّما تَفهم القلوبُ وقد بِذْ","تَ بِقلبي وكيف يَفهَم جِسمي",33,"م",2,0],["إنما تَكْرُمُ الطِّباعُ إذا ما","كَرُمَتْ قبلها طباعُ الأَصولِ",34,"ل",1,1],["إن ماتَ لا يمكنني دَفنهُ","وإنْ يعشْ يوماً دَفَنَّاهُ",35,"ه",1,0],["إِنَّما تبكي لمجدٍ قَدْ سلفْ","لم يكنْ محتفِظاً فيه الخلفْ",36,"ف",1,0],["إنّما تَسعَدُ الأنامُ لعَمْرِي","بالّذي تَستمِدُّ منك السُّعود",37,"د",1,0],["إن ماتَتِ الهمَمُ العليّة في الورى","فيَحُقُّ أن تَجِدَ الخواطرَ أمْواتا",38,"ت",2,0],["إنما تغسل هذا البوسَ عن","وجهكِ الباكي، دموع التائبين",39,"ن",1,0],["إنَّما تَفْتِك في أحشائه","نظراتٌ ليس ترقيها التمائم",40,"م",1,0],["إِن ماتَ منكم قدوة بمكانه","قد قامَ قدوة قادة قدماء",41,"ا",2,0],["إن ما تحكيه حق","أهو بعد اليوم نكر",42,"ر",1,0],["إن مات منهم سيِّدٌ قام له","منهم شبولٌ يَخلِفون الضَّيغما",43,"م",2,0],["إنّما تُدخل عذلاً","بين جثمانِي وروحِي",44,"ح",2,0],["إِنّما تَعذل الّذي يلج العَذْ","لُ إِلى قلبهِ وما لِيَ قلبُ",45,"ب",1,0],["إنما تشهده في فعلها","وهو فيها ظاهر مشتبك",46,"ك",1,0],["إنما تلك باعتبارك إذ ان","ت مع الكل في الفنا سيان",47,"ن",1,0],["إِنَّما تَصْلُحُ المَهَا لِخُدُورٍ","وَنَعِيْمٍ وَلَذَّةٍ وَعَزِيْفِ",48,"ف",1,0],["إِنَّما تَيَّمَت فُؤادِيَ أُختا","نِ مُلَوّىً عَلَيهِما الأَطواقُ",49,"ق",1,0],["إِنَّما تُثلِجُ الصُدورَ بِسِلمٍ","حَيثُما يوقِدُ الصُدورَ ضِرامِ",50,"م",1,0],["إنما تُمطِرُ النَّضارَ وما تل","معُ برقاً ولا تُزرخمُ رعدا",51,"د",2,0],["إنما تبتغي بمالك علماً","تبلغ المجد عنده والكمالا",52,"ل",2,0],["إن ما تولاك الإله برحمة","ما كان لك صعب الزمان سهيل",53,"ل",1,0],["إنّما تكرمُ الرجالُ على الأح","لامِ والفضلِ لا على الأَجسامِ",54,"م",1,0],["إن مات قلبي غراما في محبتها","فذكر بان اللوى والجزع يحييه",55,"ي",2,0],["إِنَّما تَحسُنُ الرِياضُ إِذا ما","ضَحِكَت في خِلالِها الأَنوارُ",56,"ر",1,0],["إنما تعرب البرية عما","بان مما تحملت آراها",57,"ا",3,0],["إنَّما تَخرُجُ منها","مثلما جئتَ إليها",58,"ه",2,0],["إِنَّما تحسُن الموساة في الشِّد","دَةِ لا حينَ ترخصُ الأَسعارُ",59,"ر",1,0],["انما تسكن قصراً شاده","لك سيف الموثق المرتهن",60,"ن",1,0],["إن ما تلوت تناسباً وتماثلاً","بصفائه أنا ضارب الأمثال",61,"ل",1,0],["إِنَّما تَبني عَلى الوَث","بَةِ في حين الوُثوبِ",62,"ب",1,0],["إن ما تنفقه فالله قد","عوض النزر بما لا ينحصر",63,"ر",1,0],["إنما تبلغ الحَياة لِحَدٍّ","بأخيها وَبَعد ذَلِكَ يُقبَر",64,"ر",1,0],["إنما تخطئ من حب إذا","أخطأ الإنسان من غشٍّ وزور",65,"ر",1,0],["إنما تُسلَسُ الطِّلاب جميعًا","لامرئٍ هانت الطِّلابُ عليْهِ",66,"ه",1,0],["إِنَّما تُدرَكُ المَكارِمُ بِالصَ","برِ لِهَدمِ الحَلوى وَأَكلِ الثَريدِ",67,"د",1,0],["إن مات منكم مصطفى فجميعكم","من بعد موتى يا أفاضف مصطفى",68,"ف",2,0],["إنما تقذف الهموم المطايا","مثلما تقذف السنابك نعلا",69,"ل",2,0],["إنما تُنبتُ الفروعَ أروم","أمّا فيها فتنضر الأفنان",70,"ن",1,0],["إن ماتَ هَزْلا عديّ من سماحته","أو خُلِّد الغُسُّ في قومي فلوميني",71,"ن",2,0],["اِن ماتَ عِشقاً ذو عَفاف كاتِماً","لِلحُبِّ فَهُوَ الفائِز المَبرور",72,"ر",1,0],["إِنَّما تَخدَعُني يا أَمَلِي","وَأَنا المَخدوع في زينٍ وَشينِ",73,"ن",1,0],["إِنّما تستثير رِقّةٌ شكوا","كِ دموعي والوجدُ حيثُ الدموع",74,"ع",1,0],["إِن ماتَ تَبقَ مَبانٍ","قَد شادَها مِنهُ فِكرُ",75,"ر",1,0],["إِنَّما تَطلبُ أَنْ آتيَكُمْ","فَإِذا صِرتُ إِلَيكُم فَلتَطِقْ",76,"ق",1,0],["إنما تفعل ما تف","علُ بي من ذاك عمدا",77,"د",2,0],["إنما تكثر الملامة للدهر","لأن الكرام فيه قليلُ",78,"ل",1,0],["إن ما تهيّا زمرة الظلم تنهان","لا أقول راح الشر ولا اقول طبنا",79,"ن",2,0],["أن ما تفعلونه ليس يجدي","فاللقاء الذي ارتضيتم يطول",80,"ل",1,0],["ان مآتت الأحرآر / الأحرآر يبكون","ولآكل نآيف مثل الآمير نآيف",81,"ف",1,0],["إنْ ما تأمَّلتَ الخلائقَ كلَّها","سترى العجائبَ في بني الإنسانِ",82,"ن",1,1],["إن ماتت الفرس فالروسيا تمثلها","أما ستالين فهو اليوم كِسرانا",83,"ن",2,0],["إنما تهدي له","علما يعاديك عليه",84,"ه",1,0],["إنما تؤثر الخفاء لأمرٍ","عن دهاءٍ تأتيه لا عن جفاء",85,"ا",2,0],["إِنْ مَاتَ عَزْمِي وَإِخْلاصِي أَيَنْفَعُنَا","دَقُّ الطُّبُولِ عَلى أَطْلالِ مَاضِينَا ؟",86,"ن",2,0],["إنما تجرى على أحسابها","عتق الخيل وللغير الغبار",87,"ر",1,0],["إن ما تذكر مشهدا من داره","والأنس أيام الصبا أو أهلها",88,"ه",2,0],["إنما تظهر المعاني من الأح","رف إن كونت لها كلمات",89,"ت",1,0],["إنما تنقطع الأحلا","م من بعد الممات",90,"ت",1,0],["إنما تسعد الشعوب إذا ما","أشرق العدل في سماء الوجود",91,"د",1,0],["إنْ مات فيك جماله وسناؤه","فدموع قلبٍ خاشعٍ تُحييه",92,"ي",2,0],["إنْ مات ياعماه طفلكمُ","فأنا أنا من مات معناه",93,"ا",2,0],["أن مات طايب خلدنه حكاياه ،","وأن مات خايب مادرى عنه جاره ،",94,"ر",2,0],["إن مات بالإصرار فهو مخلَّد","في النار يغدو ماكثا أحقابا",95,"ب",2,0],["إن مات بين يديك مات مُكَرَّماً","لم يلْق منك أيا رفاه أحَنّا..",96,"ن",2,0],["إنما تضحيتي من أجلكم","تجعل السمَّ لذيذاً عندنا",97,"ن",2,0],["إنْ مات، قد مات النبيُّ وصحْبُهُ","فالجرحُ فينا مستمرٌّ سَكْبُهُ",98,"ب",2,1],["أن مات ولا فات ماهو فقيده","وازكى صلاتي والسلام وختامه",99,"ه",1,0],["إن ما ت منا فارس","قا م البديل مزمجرا",100,"ر",2,0],["إنما تُغمض القطاطُ خداعاً","أهبةً للوثوبِ للإستراقِ",101,"ق",1,0],["إنما تلهُو بِنا آمالُنا","ثَّم يطويها ويطوينا الحفير",102,"ر",1,0],["إِنّما تصلحُ المها لنعيمٍ","وخدورٍ ولذّة ٍ وغريفِ",103,"ف",1,0]]}