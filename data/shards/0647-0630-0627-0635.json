{"poems":[[88,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[93,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[68,"قد أيقظ الصبح ذوات الجناح","https://www.aldiwan.net/poem39082.html","السريع"],[82,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[108,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[96,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[96,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[225,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[239,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[274,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[274,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[294,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[420,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[482,"وافاك من بلد يسعى إلى بلد","https://www.aldiwan.net/poem36899.html","البسيط"],[561,"إمامنا هو الإمام الأعظم","https://www.aldiwan.net/poem33865.html","الرجز"],[565,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"]],"verses":[["هَذا صَبِيٌّ هائِمٌ","تَحتَ الظَلامِ هُيامَ حائِر",0,"ر",1,1],["هَذا صَنيعُكِ بي فَما أَنا صانِعُ","قَد شاءَ بَحرُكِ أَن تَضِلَّ سَفيني",1,"ي",1,0],["هَذا صَبوحٌ وَصَباحٌ فَما","عُذرُكَ عَن تَركِ صَبوحِ الصَباح",2,"ح",1,0],["هذا صَبُوحٌ وَصَبَاحٌ فما","عُذْرُكَ في تَرْكِ صَبُوح الصّباح",3,"ح",1,0],["هَذَا صَبَاحٌ مُقْبِلٌ مِنْ غَيْبِهِ","فَتَبَيَّنُوهُ يَا أَولِي الأَبْصارِ",4,"ر",1,0],["هذا صَريعٌ وَذا حَيٌّ إِلى أَجَلٍ","وَذا فَقيرٌ وَذا مُثرٍ بِأَقسامِ",5,"م",1,0],["هذا صلاحُ الدين عا","د يقودُ ألفَ صلاح دين",6,"ن",1,0],["هذا صلاح الدين فاخشع إنّه","ملك الكلوك مسالما ومغيرا",7,"ر",2,0],["هذا صلاحُ الدين فاخشعْ، إنه","ملكُ الملوك مسالماً ومُغيرا",8,"ر",2,0],["هذا صيال وهذي","يا صاح عقبى الصيال",9,"ل",1,0],["هَذا صَباحٌ تَذُرُّ الشَمسُ طالِعَةٍ","مِن بَعدِهِ وَوَميضٌ خَلفَهُ مَطَرُ",10,"ر",1,0],["هذا صلاحُ الدّينِ يَطلعُ ظافراً","وأمامَهُ يُلقى سلاحُ الديك",11,"ك",1,0],["هذا صلاحُ الدّينِ يَبسُطُ ظِلَّهُ","فعِظامُهُ في قَبرهِ تحميك",12,"ك",1,0],["هذا صلاح الدين يهتف","فيك من خلف العصور",13,"ر",1,0],["هذا صباح الحقّ هذا شمسه","قد راقَ منظره ورق المخبر",14,"ر",1,0],["هذا صدى الطريق لما افتر مبسمه","أعاده السمع حرفيا ولم يزد",15,"د",1,0],["هذا صراط الله مثل شعرة","دقيقة وأنت غر أبلم",16,"م",1,0],["هذا صَفِيُّ اللهِ خيرُ عِبادِهِ","وأبَرُّ كُلِّ مُوَحِّدٍ مُتَعبِدِ",17,"د",1,0]]}