{"poems":[[88,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[93,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[68,"قد أيقظ الصبح ذوات الجناح","https://www.aldiwan.net/poem39082.html","السريع"],[82,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[108,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[96,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[96,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[226,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[240,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[275,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[295,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[422,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[484,"وافاك من بلد يسعى إلى بلد","https://www.aldiwan.net/poem36899.html","البسيط"],[563,"إمامنا هو الإمام الأعظم","https://www.aldiwan.net/poem33865.html","الرجز"],[567,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66632","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48662","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77963","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141349","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125370","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132608","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48301","السريع"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143838","الكامل"],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[4988,"أحفاد الاجداد","https://www.poetsgate.com/ViewPoem.aspx?id=196636",""],[5150,"نشيد المقاومة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202934",""],[5189,"يا سعد من فهم الدنا","https://www.poetsgate.com/ViewPoem.aspx?id=191460",""],[5235,"هيتَ له","https://www.poetsgate.com/ViewPoem.aspx?id=128419",""],[5277,"سحابةُ القلقِ","https://www.poetsgate.com/ViewPoem.aspx?id=206887",""],[5279,"الطُّفُولَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=184133",""],[5536,"كفي عن الركض!!","https://www.poetsgate.com/ViewPoem.aspx?id=22809",""],[5616,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=204848",""],[5720,"هَذَا صَبَاحُكَ","https://www.poetsgate.com/ViewPoem.aspx?id=213305",""],[5853,"((القضاة الأربعة ؟ )))","https://www.poetsgate.com/ViewPoem.aspx?id=175665",""],[5975,"من ذا يكفكف!!","https://www.poetsgate.com/ViewPoem.aspx?id=58789",""],[6070,"الفيسُ روحٌ لهُ والناسُ أجناسُ","https://www.poetsgate.com/ViewPoem.aspx?id=189130",""],[6093,"الدُّرَّةُ والعَقِيْق","https://www.poetsgate.com/ViewPoem.aspx?id=190785",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[4701,"بلاغة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87361&r=&rc=1",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["هَذا صَبِيٌّ هائِمٌ","تَحتَ الظَلامِ هُيامَ حائِر",0,"ر",1,1],["هَذا صَنيعُكِ بي فَما أَنا صانِعُ","قَد شاءَ بَحرُكِ أَن تَضِلَّ سَفيني",1,"ي",1,0],["هَذا صَبوحٌ وَصَباحٌ فَما","عُذرُكَ عَن تَركِ صَبوحِ الصَباح",2,"ح",1,0],["هذا صَبُوحٌ وَصَبَاحٌ فما","عُذْرُكَ في تَرْكِ صَبُوح الصّباح",3,"ح",1,0],["هَذَا صَبَاحٌ مُقْبِلٌ مِنْ غَيْبِهِ","فَتَبَيَّنُوهُ يَا أَولِي الأَبْصارِ",4,"ر",1,0],["هذا صَريعٌ وَذا حَيٌّ إِلى أَجَلٍ","وَذا فَقيرٌ وَذا مُثرٍ بِأَقسامِ",5,"م",1,0],["هذا صلاحُ الدين عا","د يقودُ ألفَ صلاح دين",6,"ن",1,0],["هذا صلاح الدين فاخشع إنّه","ملك الكلوك مسالما ومغيرا",7,"ر",2,0],["هذا صلاحُ الدين فاخشعْ، إنه","ملكُ الملوك مسالماً ومُغيرا",8,"ر",2,0],["هذا صيال وهذي","يا صاح عقبى الصيال",9,"ل",1,0],["هَذا صَباحٌ تَذُرُّ الشَمسُ طالِعَةٍ","مِن بَعدِهِ وَوَميضٌ خَلفَهُ مَطَرُ",10,"ر",1,0],["هذا صلاحُ الدّينِ يَطلعُ ظافراً","وأمامَهُ يُلقى سلاحُ الديك",11,"ك",1,0],["هذا صلاحُ الدّينِ يَبسُطُ ظِلَّهُ","فعِظامُهُ في قَبرهِ تحميك",12,"ك",1,0],["هذا صلاح الدين يهتف","فيك من خلف العصور",13,"ر",1,0],["هذا صباح الحقّ هذا شمسه","قد راقَ منظره ورق المخبر",14,"ر",1,0],["هذا صدى الطريق لما افتر مبسمه","أعاده السمع حرفيا ولم يزد",15,"د",1,0],["هذا صراط الله مثل شعرة","دقيقة وأنت غر أبلم",16,"م",1,0],["هذا صَفِيُّ اللهِ خيرُ عِبادِهِ","وأبَرُّ كُلِّ مُوَحِّدٍ مُتَعبِدِ",17,"د",1,0],["هذا صراطي فاتبعوا","وعنهم لا تُخْدَعوا",18,"ا",1,0],["هذا صديق اليوم من","ذاك العدو أشد شرا",19,"ر",2,0],["هَذا صَريع لا يَقوم وَذا شج","لا يَستَفيق وَذا عَليل البال",20,"ل",1,0],["هذا صريع قناً هوى دنفاً","ونجيعه يجري على التّرب",21,"ب",1,0],["هذا صلاحُ الدّينِ من غزواتهُ","أهدَت إلى العُربِ الكرامِ مَفاخِرا",22,"ر",2,0],["هذا صريخ الفرس قد جاءنا","يملأ بالصرخة ارجاءنا",23,"ن",2,0],["هذا صَباحُ الهَدْيِ حيّاكُمُ","هيْهاتَ جلَّ الصُبْحُ أن يكْتَما",24,"م",2,0],["هذا صباحٌ حلِّيت","بسعوده عطل الحقب",25,"ب",1,0],["هذا صراط الله مرشدنا له","وإلى الصراط المستقيم الحجة",26,"ه",1,0],["هذا صحيح الدين والإسلام ذا","هو سيد الكونين عين عناية",26,"ه",1,0],["هذا صحيح العلم ل احفاد الاجداد","يا ولد عمّي والنوايا سليمه",27,"م",2,0],["هذا صلاحُ الدين يربطُ خيلهُ","وعلى رُبى حطينَ قد رفَع اللواءْ",28,"ا",2,0],["هذا صَريحُ خواطري","إنّ الدُعا .. نُور القلوبْ",29,"ب",1,0],["هذا صباح قد أتاك مراودا","قولي فديتكِ يا حبيبة: هيت له",30,"ل",2,0],["هذا صراطُ الافتخارِ بهِ","يمتاز كلُّ الناس بالحذقِ",31,"ق",1,0],["هَذَا صغِيرٌ بِالدِّمَاءِ مُخَضَّبٌ","هَذَا قَتِيلٌ بِالحَدِيدِ يُذَابُ",32,"ب",1,0],["هَذَا صَغِيرِي لَمْ يَمّسَّ حِمَاكُمُ","مَا ذَنْبُ طِفْلِي أَيُّهَا الأَغرَابُ",32,"ب",1,0],["هذا صباحي وهذي قهوتي وأنا..","والحظ ُ ما بين َ فنجاني وأبراجي..",33,"ج",2,0],["هذا صلاحُ الدين فوق جوادهٍ","قَدَرٌ على هتَّافةِ الشيطانِ",34,"ن",1,0],["هَذَا صَبَاحُكَ أَشْرَقَتْ أَنْوَارُهُ","يَا رَبِّ .. وانْزَاحَتْ بِهِ أَوْهَامُ",35,"م",1,1],["هذا صديقي بلبلٌ غنى وإن ْ","غنى الوليد يردد القمري معهْ",36,"ع",2,0],["هذا صديقي قد تخذتُهُ صاحباً","قد خانني في الضيقِ وقتَ الحاجَهْ",37,"ج",2,0],["هذا صديقٌ لهُ بالعينِ منزلَةٌ","كأنهُ شمعَةٌ نورٌ ونبراسُ",38,"س",1,0],["هَذَا صَنِيْعُ كَوَاكِبٍ","فِعْلُ الصَّدِيْقِ مَعَ الصَّدِيْقِ",39,"ق",1,0],["هذا صُرَاخُ الحوتِ يُسكِتُ صوتَنَا","وَ يضيعُ يونُسُ في الظَّلامِ إذَا سَرَى",40,"ر",2,0],["هذا صباي وهذه صبواتي","وقْفٌ على هذا النزيف حياتي",41,"ت",2,1],["هذا صراطي إنْ أردتَ فمرحبا","وإذا أبيتَ فبابُ ناريَ أَرَحبُ",42,"ب",1,0]]}