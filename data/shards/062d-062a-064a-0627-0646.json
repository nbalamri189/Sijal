id=30640",""],[5381,"رياح طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=215670",""],[5431,"أرجوك ياألمي ..أرجوك أن تقفا","https://www.poetsgate.com/ViewPoem.aspx?id=190391",""],[5431,"نفخت طينك نفخ الحب والقبل","https://www.poetsgate.com/ViewPoem.aspx?id=191357",""],[5431,"ماكان أعجلها لتتركه!في برزخٍ والحلم يبطئه","https://www.poetsgate.com/ViewPoem.aspx?id=201659",""],[5561,"الحريّة","https://www.poetsgate.com/ViewPoem.aspx?id=193313",""],[5573,"بكت عيني اليمنى بدمع وزجرتها","https://www.poetsgate.com/ViewPoem.aspx?id=200219",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5595,"ويبْسُطُ العَدْلَ عُنواناً لدولتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=177507",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5596,"مجلس الدولة","https://www.poetsgate.com/ViewPoem.aspx?id=206753",""],[5717,"وكم بدت للمصطفى معاجز","https://www.poetsgate.com/ViewPoem.aspx?id=170605",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5725,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=184767",""],[5725,"لا غالب اليوم الا الله ياوطني","https://www.poetsgate.com/ViewPoem.aspx?id=201303",""],[5750,"كوني مع الليل","https://www.poetsgate.com/ViewPoem.aspx?id=214629",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5795,"عفَى الديارَ ديارَ الحُكْم والحَكَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=167916",""],[5851,"جسر الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=175295",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[6093,"لابد للإنسان أن يتغيرا","https://www.poetsgate.com/ViewPoem.aspx?id=204012",""],[6102,"شاخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184417",""],[6102,"هي .. هي","https://www.poetsgate.com/ViewPoem.aspx?id=185304",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[6199,"أنا آخر العشّاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79701&r=&rc=22",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""],[6211,"نشوة المعنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78238&r=&rc=8",""],[6225,"إلزام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80957&r=&rc=226",""],[463,"راشَ نبالا في جفنه ورمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60296&r=&rc=352",""],[6320,"حَائِطُ الشَّجَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83619&r=&rc=0",""]],"verses":[["حَتّى اِنتَموا في رَأسِ أَشرَفِها","وَعَلى الكُعوبِ يُوَقَّعُ الخُرصُ",0,"ص",1,0],["حتّى انْتَضَتْ يَقَظاتِ العَيْنِ جائِفَةٌ","كطُرَّةِ البُرْدِ لا تأْلوهُ إزْبادا",1,"د",2,0],["حتّى أنَخْنا المَطايا في حمَى ملِك","عنْ منْهَجِ العدْلِ والإحْسانِ ما عَدَلا",2,"ل",2,0],["حَتّى أُنَفِّذَهُ كَما وَجَّهتُهُ","وَكَفى عَليَّ لَهُ بِنَفسي طالِبا",3,"ب",2,0],["حَتّى اِنبَرى شُكري فَأَثبَتَ سَبقُهُ","أَنَّ اِبنَ مِصرَ مُجَرِّبٌ مِقدامُ",4,"م",1,0],["حتى انَبَريتَ لهم فارتدّ طامِعُهُم","عنها وأخَّى أبو بَكرٍ أواخيها",5,"ي",3,0],["حَتّى اِنثَنَيتَ وَما لِلعُربِ مُجتَرِئٌ","عَلى البِناءِ وَلا زارٍ عَلى الباني",6,"ن",2,0],["حَتّى اِنثَنَت صَعدَتي عَنهُ وَبانَ لَهُ","مِنّي الوَنى وَرَأى آثارَ إِقصاري",7,"ر",2,0],["حَتَّى انْتَقَلْتِ وَكُلُّ ظِلٍّ","فِي الوُجُودِ لَهُ انْتِقَالْ",8,"ل",1,0],["حَتّى اِنجَلى اللَيلُ عَنّا في مُلَمَّعَةٍ","مِثلِ الأَديمِ لَها مِن هَبوَةٍ نيمُ",9,"م",1,0],["حَتّى اِنجَلى البَردُ عَنهُ وَهوَ مُحتَقِرٌ","عَرضَ اللِوى زَلِقُ المَتنَينِ مَدمومُ",9,"م",1,0],["حتى انجلت من بيننا","ظلمات كل تقاطُع وعقوق",10,"ق",1,0],["حَتّى اِنتَهَينا إِلى مَن لَن نُجاوِزَهُ","تَجري الأَيامِنُ لا بُخلٌ وَلا عَدَمُ",11,"م",1,0],["حَتّى اِنجَلَت عَنهُ عَمايَةُ نَفرِهِ","فَكَأَنَّ صَرعاها ظُروفُ دِنانِ",12,"ن",1,0],["حتى أناخت بمغناهُ سوى كرمٍ","يسلو عن الأهلِ فيه كلُّ مغترب",13,"ب",1,0],["حتى انتقى من زهرها","هذي الخلال الباهره",14,"ر",2,0],["حَتّى اِنتَهيتُ إِلى حُرٍّ لَهُ كَرَمٌ","يَقري المُدامَ عَلى الإيسارِ وَالبوسِ",15,"س",1,0],["حتّى انكشفتَ له فألقى","رحلَه وتوطّنا",16,"ن",2,0],["حَتّى اِنتَهَيتُ فَصاحَت وَهيَ مُجهِشَةٌ","يا لَيتَ ما قُلتَهُ زورٌ وَبُهتانُ",17,"ن",1,0],["حَتّى اِنقَضى زَمَنُ الصِبا","فَخَرجتُ مِن حُزنٍ لِحُزنِ",18,"ن",1,0],["حَتّى أُنِخنَ إِلى اِبنِ أَكرَمِهِم","حَسَباً وَهُنَّ كَمُنجِزِ النَحبِ",19,"ب",1,0],["حَتّى أُنيخَت لَدى خَيرِ الأَنامِ مَعاً","مِن آلِ حَربٍ نَماهُ مَنصِبٌ حَتِدُ",20,"د",1,0],["حَتّى أُنيخَت عَلى ما كانَ مِن وَجَلٍ","في الدارِ حَيثُ تَلاقى المَجدُ وَالخيرُ",21,"ر",1,0],["حَتّى اِنتَهى الصَقرُ عَن حُمٍّ قَوادِمُها","تَدنو مِنَ الأَرضِ أَحياناً وَما تَقَعُ",22,"ع",1,0],["حتى أنت سفن المغير وخيله","فترّقوا في الضفتين نعاما",23,"م",2,0],["حتى انتحرت جريئا","والانتحار جساره",24,"ر",2,0],["حَتّى أَنافَ عَلى قَوائِمِ سوقِهِ","ثَمَراً تَنوءُ وَراءَهُ الأَكمامُ",25,"م",1,0],["حَتّى اِنحَدَرتُ إِلى فَيحاءَ وارِفَةٍ","فيها النَدى وَبِها طَيٌّ وَشَيبانُ",26,"ن",1,0],["حَتّى اِنثَنوا وَلَوَ أَنَّ حَرَّ قُلوبِهِم","في قَلبِ هاجِرَةٍ لَذابَ الجَلمَدُ",27,"د",1,0],["حَتّى اِنتَهى الفَرَسُ الجاري وَما وَقَعَت","في الأَرضِ مِن جُثَثِ القَتلى حَوافِرُهُ",28,"ر",2,0],["حتَّى انقضَى عَصْرُ الشَّبابِ فبانَ لي","أنّ الشباب هو النعيمُ الأكبرُ",29,"ر",1,0],["حَتّى أَناخَت بَعدَ بُعدِ مَسافَةٍ","بِذُرى اِبنِ هارونَ الرَضِيِّ سَعيدِ",30,"د",1,0],["حَتّى اِنتَهَيتَ إِلى المُصَلّى لابِساً","نورَ الهُدى يَبدو عَلَيكَ وَيَظهَرُ",31,"ر",1,0],["حَتّى أَناخَ مَكانَ الضَيفِ مُغتَصِباً","في مُكفَهِرَّينِ مِثلَي حَرَّةِ اللوبِ",32,"ب",1,0],["حتى انثنَى والخيلُ تسحَبُ فوقَهم","بالرَّكْضِ أرديةَ العَجاجِ الأكدَرِ",33,"ر",1,0],["حَتّى اِنطَوى بَعدَ الدُؤُوبِ ثَميلُها","وَأُذِلَّ مِنها بِالفَلاةِ المَصعَبُ",34,"ب",1,0],["حَتّى اِنتَهَبنا العَيشَ حَتّى كَأَنَّهُ","مالُ اِبنِ أُرتُقَ في يَدِ المُدّاحِ",35,"ح",1,0],["حَتّى اِنثَنى وَالكَرى يَهوي بِجانِبِهِ","إِلى الوِسادِ فَإِن طارَحتَهُ اِنطَرَحا",36,"ح",2,0],["حَتّى أَنَختُ بِمارِدينَ مَطِيَّتي","فَهُناكَ قالَ لي الزَمانُ لَكَ الهَنا",37,"ن",2,0],["حَتّى اِنثَنَت لَم تَدرِ ما تَتَّقي","عِندَ الوَقائِعِ صارِمي أَم مِقوَلي",38,"ل",2,0],["حتى انجلى الإصباحُ عن إظلامه","كالستر يُرفع عن مليكٍ يحجبُ",39,"ب",1,0],["حَتّى اِنتَهَكتَ بِحَدِّ السَيفِ أَنفُسَهُم","جَزاءَ ما اِنتَهَكوا مِن قَبلِكَ الحُرَما",40,"م",2,0],["حَتّى اِنثَنى العُسرُ إِلى يُسرِهِ","وَاِنحَتَّ عَن خَدَّيهِ ذاكَ العُبوس",41,"س",1,0],["حَتَّى انْتَبَهْنَا بَعْدَ مَا ذَهَبَ الصِّبَا","إِنَّ اللَّذَاذَةَ وَالصِّبَا أَحْلامُ",42,"م",1,0],["حَتَّى انْتَبَهْنَا بَعْدَ مَا ذَهَبَ الصِّبَا","أَنَّ الْخَلاعَةَ وَالصِّبَا أَحْلامُ",43,"م",1,0],["حَتّى أَنالَ رِضاكِ حَيثُ عَلِمتُهُ","بِطَريفِ مالي وَالتَليدِ الأَقدَمِ",44,"م",1,0],["حتى انجلى رَهَجُ الوغى","والنَّصْرُ مَرموقُ العنان",45,"ن",1,0],["حَتّى اِنطَوَت طِيَّ رِداءِ الفَتى","وَاِستَبدَلَت ضُمراً بِإِجمامِها",46,"م",3,0],["حَتّى اِنتَهَت إِلى دَعجاءَ جالِسَةٍ","قَد تَرَكَت أَهلَ بَيتِ اللَهِ في ضِيقِ",47,"ق",1,0],["حَتّى أَنَختُ قَلوصي في دِيارِكُمُ","بِخَيرِ مَن يَحتَذي نَعلاً وَحافيها",48,"ي",3,0],["حَتّى اِنثَنَت حُمَةُ الشَبا","بِ كَليلَةً وَصَحَوتُ صَحوا",49,"و",2,0],["حتَّى انْثَنَى أَغْنَى الوَرَى وَأَعَزُّهم","يَنْقادُ مُحْتاجاً إليهِ ذَليلا",50,"ل",2,0],["حتى أنَخْتَ على الخِيامِ إناخَةً","فَغَدَتْ أعالِيهِنَّ وهي أسافل",51,"ل",1,0],["حَتّى اِنثَنى مُختَضِباً وَما خُضِب","مِن مَغرِزِ الزَورِ إِلى عَجبِ الذَنَب",52,"ب",1,0],["حَتّى اِنثَنَيتُ وَلي روحانِ في جَسَدٍ","وَالدَنُّ مُنطَرِحٌ جِسماً بِلا روحِ",53,"ح",1,0],["حَتّى اِنطَوى إِلّا جَنانَ الروحِ","وَعَرَفِ الصَوتِ وَوَحيِ الموحي",54,"ح",2,0],["حَتّى اِنثَنى مِثلَ صَريعِ الهَوى","وَالنَومُ قَد عانَقَ جُلّاسي",55,"س",2,0],["حَتّى اِنثَنى البَحرُ عَن دُفّاعِ جَريَتِهِ","مُستَبطِحِ الماءِ حَيثُ الدورُ يَنحَدِرُ",56,"ر",1,0],["حَتّى اِنقَضى في الصُبحِ مَلعَبُنا","وَكَذاكَ يَهلِكُ ما لَهُ أَمَدُ",57,"د",1,0],["حَتّى اِنطَوى العَيشُ عَن مَريرَتِهِ","في صَوتِ جارٍ حَدا بِنا غَرِدِ",58,"د",1,0],["حَتّى اِنطَوى غَيرَ فَقيدِ الفَقدِ","وَما دَرى ما رَغبَتي مِن زُهدي",59,"د",2,0],["حَتّى اِنثَنى العَيشُ مِن مَريرَتِها","في صَوتِ حادٍ يَحدو بِها غَرِدِ",60,"د",1,0],["حتى أناخ في ذُرى قرْمونَه","بكَلْكلٍ كَمُدْرهِ الطَّاحُونَه",61,"ه",1,0],["حتّى أَنابتْ عَنوةً جِنانُها","وغابَ عن يافوخِها شيطانُها",61,"ه",2,0],["حَتَّى انْتَشَيْنَا عِنْدَ أَدْكَنَ مُتْرَعٍ","حَجْلٍ أُمِرَّ كُرَاعُهُ بِعِقَالِ",62,"ل",1,0],["حتى انتهى الفرس الجاري وما وقعت","في الأرض من جيف القتلى حوافره",63,"ر",2,0],["حتى انقضى سلطانهم وزالا","وفضلهم باق ولن يزالا",64,"ل",2,0],["حتَّى انْتَضَى عَبْدُ العَزِي","زِ عَزِيمَةً مِن صَدْرِ عازِمْ",65,"م",1,0],["حَتَّى انْبَرَى الإِفْرَنْجُ يَبْتَعِثُونَ مَا","دَفَنَتْهُ مِنْ ذُخْرٍ مَدَى أَجْيالِ",66,"ل",1,0],["حَتَّى انْبَرَى مِنهُمْ فَتى","مُتَلَثِّمٌ ضَافِي الْغَدَائِرْ",67,"ر",1,0],["حتَّى انْثَنى وَعلى أَجْفانِهِ بَلَلٌ","وَدَّ الإِباءُ له لَوْ كانَ أَعْماها",68,"ا",3,0],["حتى اندفعت فكلُ صحر روضة","سلمت يداك وكل أفق مطلع",69,"ع",1,0],["حتى انثنى الرَّكبُ: لا رِيٌّ ولا شبعٌ","وكيف يهدي بصيرًا زائغُ البصر؟",70,"ر",1,0],["حتى انجلى الكوكب الدري فانكشفت","بنوره عن وجوه الحق أغيان",71,"ن",1,0],["حتى انثنى وعلى أجفانه بلل","ود الإباء لها لو كان أعماها",72,"ا",3,0],["حتّى انتهى الصّقرُ عنْ حمٍّ قوادمهَ","تدنو منَ الأرضِ أحياناً وما تقعُ",73,"ع",1,0],["حتى انئيالَ الشعر .. حتى","الفمَ الملمومَ .. حتى النظرةَ السارحهْ",74,"ح",2,0],["حتى أنفأى الفأوُ عنْ أعناقها سحرا","أُدْمٌ أَحَنَّ لَهُنَّ الْقَانِصُ الْوَتَرَا",75,"ر",2,0],["حتّى إن ران الكرى بجفونها","ألقت إليك بسمعها إصغاء",76,"ا",2,0],["حَتّى اِنجَلى فَلق الصَباح وَراعَها","نَظر الوشاة تَزَحزحت عَن مَرقَد",77,"د",1,0],["حتى أنا وأنا الوفي لعهده","أَصبحت لا أرتاد نجعة حانه",78,"ن",2,0],["حَتّى اِنجَلَت وَلَهُ الذِكرُ المُبَلِّغُهُ","هَذا المَدى رَضِيَ الحُسّادُ أَو غَضِبوا",79,"ب",3,0],["حَتّى أَنابوا وَالنُفوسُ سَليمَةٌ","وَقِيادُ مَن مَنَعَ المَقادَةَ طَيِّعُ",80,"ع",1,0],["حَتّى اِنبَرى خاضِعاً وَلا عَجَبٌ","أَيُّ عَظيمٍ لَدَيكَ ما خَضَعا",81,"ع",2,0],["حتى انثَنى وَكأَنَّما","في كأسِهِ قبلَ المغيبِ",82,"ب",1,0],["حتى أناب فردَّ ربك ملكه","لما أضناب لربه واستغفرا",83,"ر",2,0],["حَتّى أَناخَ بِبابِ الحِصنِ يَصحَبُهُ","عَزمٌ يَهُدُّ الجِبالَ الشُمَّ وَالأَكَما",84,"م",2,0],