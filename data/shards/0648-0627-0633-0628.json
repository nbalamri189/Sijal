{"poems":[[53,"إذا مضى يوم على هدنة","https://www.aldiwan.net/poem30674.html","السريع"],[83,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[72,"أهلا بها صحف الإمام المسند","https://www.aldiwan.net/poem18563.html","الكامل"],[70,"رق في الجو النسيم","https://www.aldiwan.net/poem42713.html","مجزوء الرمل"],[62,"اعمل بجد وجلد","https://www.aldiwan.net/poem52155.html","مجزوء الرجز"],[45,"ألا هل أتاها بالمغيب سلامي","https://www.aldiwan.net/poem65670.html","الطويل"],[61,"تذكر أيامه الخاليه","https://www.aldiwan.net/poem51396.html","المتقارب"],[61,"ومنزل نزلته ابتكارا","https://www.aldiwan.net/poem51624.html","الرجز"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[74,"جهلت وما ألقى عليما وإنما","https://www.aldiwan.net/poem13222.html","الطويل"],[46,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[76,"ولو شئت راهنت الصبابة والهوى","https://www.aldiwan.net/poem38866.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[45,"ألا هَلْ أتَاهَا، بالمَغِيبِ، سَلاَمي","https://www.poetsgate.com/ViewPoem.aspx?id=31842",""],[122,"يا مدعي عام اللواء","https://www.aldiwan.net/poem23712.html","مجزوء الكامل"],[164,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[167,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[196,"شموس جلتهن النجوم الشوابك","https://www.aldiwan.net/poem51910.html","الطويل"],[208,"تبسمت بالثنايا اللؤلؤيات","https://www.aldiwan.net/poem13360.html","البسيط"],[208,"تنفست الأيام وابتسم الدهر","https://www.aldiwan.net/poem13558.html","الطويل"],[223,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[233,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[235,"إلى ما فؤادي يذوب زفيرا","https://www.aldiwan.net/poem18193.html","المتقارب"],[235,"قصدت أبا يعزى وبالبال بلبال","https://www.aldiwan.net/poem18852.html","الطويل"],[235,"أذا العرش إن تبسم ثغور العرائش","https://www.aldiwan.net/poem19723.html","الطويل"],[235,"أكلنا يوم لمطتنا المريه","https://www.aldiwan.net/poem19753.html","الوافر"],[259,"منال المنى بالعجز غير يسير","https://www.aldiwan.net/poem38319.html","الطويل"],[268,"سرت في الروضة والصبح قريب","https://www.aldiwan.net/poem35660.html","الرمل"],[269,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[273,"دنياك للأخرى سبيل سابل","https://www.aldiwan.net/poem25534.html","الكامل"],[280,"كل سقام زال عن سنقر","https://www.aldiwan.net/poem32779.html","السريع"],[326,"غن عذراءك يا شاطىء","https://www.aldiwan.net/poem54988.html","مجزوء الرمل"],[326,"رق وجه النسمات","https://www.aldiwan.net/poem55044.html","مجزوء الرمل"],[326,"ذكرتك والذكرى تضاعف من كربى","https://www.aldiwan.net/poem55064.html","الطويل"],[340,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[340,"يا شعاع الصباح","https://www.aldiwan.net/poem55362.html","مجزوء الخفيف"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[364,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[393,"ألا هل لهذا الدهر من مُتعللٍ","https://www.aldiwan.net/poem607.html",""],[400,"يا خاطبا لمؤلفاتي راغبا","https://www.aldiwan.net/poem34140.html","الكامل"],[429,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[436,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[436,"غرام ولا شكوى وعتب ولا عتبى","https://www.aldiwan.net/poem34828.html","الطويل"],[436,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[456,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[477,"طال المدى في خطة الأعراض","https://www.aldiwan.net/poem37181.html","الكامل"],[477,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[480,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[480,"صوادج البان ولنا هجرها بادي","https://www.aldiwan.net/poem24365.html","عموديه"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[480,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[498,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[498,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[513,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[513,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[527,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[527,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[556,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[584,"أدام الله أيام الوصال","https://www.aldiwan.net/poem17685.html","الوافر"],[584,"أعز الله أنصار العيون","https://www.aldiwan.net/poem17811.html","الوافر"]],"verses":[["وَاِسبُق وَفي حَبلِكَ أُنشوطَةٌ","ضَغطَ اللَيالي بِيَدِ الحادِثات",0,"ت",1,0],["وأسبلَ ربّ العرش سُحبَ كرامةٍ","تَسُحُّ على ذاكَ الضريح غواديها",1,"ي",3,0],["واسْبقهُ بالعذرِ البسيط فإنَّ لي","همًّا مديداً إن أقل قالَ اقصد",2,"د",1,0],["وَاِسبِقِ الشَمس بِشَمسٍ","لا تُواريها الغُيومُ",3,"م",1,0],["واسبك بلين النار فال","خلط إذا ذاب همد",4,"د",1,0],["وَأَسبَلتُ أَثوابي لِكُلِّ عَظيمَةٍ","وَشَمَّرتُ مِن أُخرى لِكُلِّ عُرامِ",5,"م",1,0],["وأسبُقُ بالسُّكرِ أُولَى الصَّلاَةِ","وَأّثْنِي العِنانَ إلى الثانيه",6,"ي",2,0],["وأسبَلتْ ظُلمتُه الأستارا","وانتثرَ الثَّلجُ به انتثارا",7,"ر",2,0],["وأسبقُ صوبَ الحيا بالنّدى","بكفّيْ جوادٍ وخدَّيْ خَجِل",8,"ل",1,0],["وَأَسبَحُ في بَحرِ الشَكاةِ لَعَلَّني","سَأَعلَقُ يَوماً مِن نَجاةٍ بِساحِلِ",9,"ل",1,0],["وَأَسبابُ المُنى أَسبابُ شِعرٍ","كُفِّفنَ بِعِلمِ رَبِّكَ أَو قِبِضنَه",10,"ن",2,0],["وأسبلتُ من ثوبِ الشَّباب وللصَّبا","عليَّ رداءٌ مُعْلمُ الطَّرفينِ",11,"ن",1,0],["وَاِسبِق الرِفاقَ فَما","رائِحٌ كَمُبكِرِها",12,"ر",3,0],["وأسبِغْ علينا درعَ لطْفِك إنّها","لنا في قتامِ الحادثاتِ وِقاءُ",13,"ا",2,0],["وأسْبَلتُ عند الستر غَرْبَ مَدَامِعي","وما كان دمعي في الحوادث جاريا!",14,"ي",2,0],["وَأسْبَلْتُ أثْوَابي لكُلّ عَظيمَةٍ،","وَشَمّرْتُ مِنْ أُخرَى لكُلّ غَرَام",15,"م",1,0],["واسبأ لنا إن الزقاق","مباءة الأمم السبية",16,"ي",2,0],["وأسبأ من حاناتِها عِكبريّةً","أرقَّ من الإعتاب في عُقَبِ العَتْبِ",17,"ب",1,0],["وَأَسبابٌ جَرَينَ وَكَيدُ أَمرٍ","قُعُودي في النَدِىِّ لَهُ قِيامُ",18,"م",1,0],["وأسبلتِ الظلماءُ ستراً مِنَ الدجى","له منْ حسامي أو سنا البرقِ هاتك",19,"ك",1,0],["وأسبلت عندما مالت ذوائبها","فلذّلي الشهد في تلك اللييلات",20,"ت",1,0],["واسباب سبل الامن منهم تقطعت","وما شعروا انا لنا البر والبحر",21,"ر",1,0],["وَاِسبِق به وَاِضرِب به وَاِفتَح به","ما شِئتَ من بابٍ أَمامَك يُغلَق",22,"ق",1,0],["وَأَسبَلَ صَوبَ رَحمَتِهِ دِراكاً","عَليها بِالغُدُوِّ وَبِالعَشِيِّ",23,"ي",1,0],["وَأَسْبِلْ عَلَيْهِ بُرُودَ الْقَبُولِ","فَلَسْتُ حَبِيباًوَلَسْتُ جَرِيرَا",24,"ر",2,0],["وَإِسْبَالُ سِتْرِ اللهِ فَوْقَ أَقَارِبِي","بِهِ يَشْتَفِي قَلْبِي وَيَسْلُوهُ إِعْلاَلُ",25,"ل",1,0],["وأسبل عليهم من رداك سحائبا","تسح بسيل من بلائك حافش",26,"ش",1,0],["وَأَسْبَلْنَا الْحَلِيبَ عَلَيْهِ حَتَّى","تَطَرَّدَ فِي جَوَاهِرِهِ السَّنِيَّهْ",27,"ي",2,0],["واسباب ادراك المعالي منوطة","بكل بعيد الألتماس عسير",28,"ر",1,0],["واسبقِ الشمسَ إلى رشفِ النّدى","وانتشاقِ العطر فالحرُّ قريب",29,"ب",1,0],["وأسبل عَليهِ الستر من كل نكبة","فَسَترك مَسدول عَلى الخَلق مسبل",30,"ل",1,0],["واسْبِقْ مَشِيبَك بِالمَتَابِ حِزَامَةً","فَلَهُ حُلُولٌ عَاجِلٌ أوْ آجِلُ",31,"ل",1,0],["وَأَسبَلَت سُنبُلَةٌ خَلفَهُ","تَرنو إِلى الميزانِ وَالمُشتَري",32,"ر",2,0],["واسبقى الشمس إلى الماء","فقد حان الغروب",33,"ب",1,0],["واسبق العمر إليها","والتمس فيها العزاء",34,"ا",2,0],["وأسبح في فكري ودمعي سابح","فتوقظني كف كغادية السحب",35,"ب",1,0],["واسبك ضبابي هواء","وصفه نوراً ونارا",36,"ر",2,0],["واسبحي كالخيال","وابزغي كالشموس",37,"س",1,0],["واسبِقْ إلى الدّاعي رجوعَ طَرْفهِ","فاللّيثُ ما استَثرْتَه إلا وَثَب",38,"ب",1,0],["وَأَسبَلتُ العَبرَةَ","كَما أَنشَأَ الأُفُقُ السَحابَ المُدَيَّما",39,"م",2,0],["وأسبابه أهلكن عاداً وأنزلت","عزيزاً يُغنّي فوق غرفة موكل",40,"ل",1,0],["وأسبل عليها الستر فهي صناعتي","لا صنعة الهروي والخطاب",41,"ب",1,0],["وأسبلتِ الظلماءُ سُودَ غدائرٍ","عليهِ أشابَ الصّبحَ منها النّواصيا",42,"ي",2,0],["وأسْبَلَ من غَيْثٍ ومَلَّأَ من يَدٍ","وكم فَكَّ من غُلٍّ وأطْلَقَ من حَبْسِ",43,"س",1,0],["وأُسْبِلُ آماقَ الجفونِ بِعَبْرَةٍ","وإِنْ حُرِمَتْ منكِ المودَّةَ فِي القُرْبى",44,"ب",2,0],["وأَسْبلَ لي من سِتره فَوْقَ سِتَّةٍ","أَهِيمُ بهمْ فِي الأَرضِ مِثلَ القطا الزُّغبِ",45,"ب",1,0],["واسبِقْ بها إلى العلا شوطَ الصَّبا","لعلّها تُعَدُّ في الجِيادِ",46,"د",1,0],["واسبر به قلبا فريت أديمه","وعليك فاخلع برقع الأغراض",47,"ض",1,0],["واسبر طبائع من تنوي مودته","فقلما اتفق القلبان في البشر",48,"ر",1,0],["واسبل عليها كل ستر مسرمد","وواصل عليها الروح منك يجدد",49,"د",1,0],["وأسبل الستر صفحا إن بدا خلل","وأهتك به ستر أعداء وحساد",50,"د",1,0],["وأسبل عليها نفحة سرمدية","مطرزة بالفيض من عين أعيان",51,"ن",1,0],["وأسبل علينا الستر والأمانا","فرح قلوبا وأزح أحزانا",52,"ن",2,0],["واسبل علينا الستر يا قيوم","في كل لحظة لنا يدوم",52,"م",1,0],["وأَسبَلَ فوقَهُمْ أَذيالَ عفوٍ","وقد فَجَروا بزُورٍ وانْتِقادِ",53,"د",1,0],["واسْبِلِ السَّتْرَ لا ترى العيبَ للنَّا","سِ وإِنْ كانَ فالطُّعونُ عَماءُ",54,"ا",2,0],["وأسبلت أستار الحجاب مهابة","وذلك في بعض المواطن أهيب",55,"ب",1,0],["وأسبغتها نعمى عممت بها الورى","فأثنى بما أوليت باد وحاضر",56,"ر",1,0],["واسْبَحْ بقامُوسِ اللَّغى والبُغَى","صِحَاحُها تَلْقَ بِها جَوْهَرا",57,"ر",2,0],["وإِسْبالُ وَبْلِ السّتْرِ مِنْكَ مُؤَمَّلٌ","عَلَى ما تَرَى في طَيٍّ ذا مِنْ مَثالِبِ",58,"ب",1,0],["واسبحوا في مياه بحر علومي","واكشفوا بي ستائر الإلتباس",59,"س",1,0],["وَأَسْبَغَ ظِلَّ أَغْصانِ التَّداني","وَزَادَ قُدُودَها حُسْنَ اعْتِدالِ",60,"ل",1,0],["وَأَسْبغَ ظِلَّ ذَاكَ الشَّعْرِ مِنْهُ","عَلَى قَدٍّ بِهِ هَيَفُ الغُصُونِ",61,"ن",1,0]]}