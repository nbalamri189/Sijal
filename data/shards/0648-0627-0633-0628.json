poetsgate.com/ViewPoem.aspx?id=67536",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5183,"حد الطور","https://www.poetsgate.com/ViewPoem.aspx?id=186609",""],[5183,"ذكرى ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=180225",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5277,"قطرة ندى","https://www.poetsgate.com/ViewPoem.aspx?id=185338",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[5397,"هي الدنيا لها وصل وصد","https://www.poetsgate.com/ViewPoem.aspx?id=157913",""],[5459,"حياة كالموت","https://www.poetsgate.com/ViewPoem.aspx?id=191054",""],[5461,"أنا تسّلى بالشعر لي توصّفت","https://www.poetsgate.com/ViewPoem.aspx?id=1310",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5582,"أَلا هَلْ نَفَتْ عَنْكَ طِيبَ الرُّقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=186965",""],[5704,"اُسْكُبْ خمورك في كاسات آلامي٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204225",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5740,"تندغ الخير","https://www.poetsgate.com/ViewPoem.aspx?id=211474",""],[5858,"الشعر كذبه","https://www.poetsgate.com/ViewPoem.aspx?id=188075",""],[5956,"أمامَ جمالك","https://www.poetsgate.com/ViewPoem.aspx?id=182649",""],[5956,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183218",""],[5956,"اللغة وأنا","https://www.poetsgate.com/ViewPoem.aspx?id=186236",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[5355,"لحى الفراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87123&r=&rc=18",""],[276,"إليهِ بهِ سبحانهُ أتوسلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59268&r=&rc=7",""]],"verses":[["وَاِسبُق وَفي حَبلِكَ أُنشوطَةٌ","ضَغطَ اللَيالي بِيَدِ الحادِثات",0,"ت",1,0],["وأسبلَ ربّ العرش سُحبَ كرامةٍ","تَسُحُّ على ذاكَ الضريح غواديها",1,"ي",3,0],["واسْبقهُ بالعذرِ البسيط فإنَّ لي","همًّا مديداً إن أقل قالَ اقصد",2,"د",1,0],["وَاِسبِقِ الشَمس بِشَمسٍ","لا تُواريها الغُيومُ",3,"م",1,0],["واسبك بلين النار فال","خلط إذا ذاب همد",4,"د",1,0],["وَأَسبَلتُ أَثوابي لِكُلِّ عَظيمَةٍ","وَشَمَّرتُ مِن أُخرى لِكُلِّ عُرامِ",5,"م",1,0],["وأسبُقُ بالسُّكرِ أُولَى الصَّلاَةِ","وَأّثْنِي العِنانَ إلى الثانيه",6,"ي",2,0],["وأسبَلتْ ظُلمتُه الأستارا","وانتثرَ الثَّلجُ به انتثارا",7,"ر",2,0],["وأسبقُ صوبَ الحيا بالنّدى","بكفّيْ جوادٍ وخدَّيْ خَجِل",8,"ل",1,0],["وَأَسبَحُ في بَحرِ الشَكاةِ لَعَلَّني","سَأَعلَقُ يَوماً مِن نَجاةٍ بِساحِلِ",9,"ل",1,0],["وَأَسبابُ المُنى أَسبابُ شِعرٍ","كُفِّفنَ بِعِلمِ رَبِّكَ أَو قِبِضنَه",10,"ن",2,0],["وأسبلتُ من ثوبِ الشَّباب وللصَّبا","عليَّ رداءٌ مُعْلمُ الطَّرفينِ",11,"ن",1,0],["وَاِسبِق الرِفاقَ فَما","رائِحٌ كَمُبكِرِها",12,"ر",3,0],["وأسبِغْ علينا درعَ لطْفِك إنّها","لنا في قتامِ الحادثاتِ وِقاءُ",13,"ا",2,0],["وأسْبَلتُ عند الستر غَرْبَ مَدَامِعي","وما كان دمعي في الحوادث جاريا!",14,"ي",2,0],["واسبح بآفاق الجمال وطف كما","تهوى ويهوى جوّه البسّام",15,"م",1,0],["وَأسْبَلْتُ أثْوَابي لكُلّ عَظيمَةٍ،","وَشَمّرْتُ مِنْ أُخرَى لكُلّ غَرَام",16,"م",1,0],["واسبأ لنا إن الزقاق","مباءة الأمم السبية",17,"ي",2,0],["وأسبأ من حاناتِها عِكبريّةً","أرقَّ من الإعتاب في عُقَبِ العَتْبِ",18,"ب",1,0],["وَأَسبابٌ جَرَينَ وَكَيدُ أَمرٍ","قُعُودي في النَدِىِّ لَهُ قِيامُ",19,"م",1,0],["وأسبلتِ الظلماءُ ستراً مِنَ الدجى","له منْ حسامي أو سنا البرقِ هاتك",20,"ك",1,0],["وأسبلت عندما مالت ذوائبها","فلذّلي الشهد في تلك اللييلات",21,"ت",1,0],["واسباب سبل الامن منهم تقطعت","وما شعروا انا لنا البر والبحر",22,"ر",1,0],["وَاِسبِق به وَاِضرِب به وَاِفتَح به","ما شِئتَ من بابٍ أَمامَك يُغلَق",23,"ق",1,0],["وَأَسبَلَ صَوبَ رَحمَتِهِ دِراكاً","عَليها بِالغُدُوِّ وَبِالعَشِيِّ",24,"ي",1,0],["وَأَسْبِلْ عَلَيْهِ بُرُودَ الْقَبُولِ","فَلَسْتُ حَبِيباًوَلَسْتُ جَرِيرَا",25,"ر",2,0],["وَإِسْبَالُ سِتْرِ اللهِ فَوْقَ أَقَارِبِي","بِهِ يَشْتَفِي قَلْبِي وَيَسْلُوهُ إِعْلاَلُ",26,"ل",1,0],["وأسبل عليهم من رداك سحائبا","تسح بسيل من بلائك حافش",27,"ش",1,0],["وَأَسْبَلْنَا الْحَلِيبَ عَلَيْهِ حَتَّى","تَطَرَّدَ فِي جَوَاهِرِهِ السَّنِيَّهْ",28,"ي",2,0],["واسباب ادراك المعالي منوطة","بكل بعيد الألتماس عسير",29,"ر",1,0],["واسبقِ الشمسَ إلى رشفِ النّدى","وانتشاقِ العطر فالحرُّ قريب",30,"ب",1,0],["وأسبل عَليهِ الستر من كل نكبة","فَسَترك مَسدول عَلى الخَلق مسبل",31,"ل",1,0],["واسْبِقْ مَشِيبَك بِالمَتَابِ حِزَامَةً","فَلَهُ حُلُولٌ عَاجِلٌ أوْ آجِلُ",32,"ل",1,0],["وَأَسبَلَت سُنبُلَةٌ خَلفَهُ","تَرنو إِلى الميزانِ وَالمُشتَري",33,"ر",2,0],["واسبقى الشمس إلى الماء","فقد حان الغروب",34,"ب",1,0],["واسبق العمر إليها","والتمس فيها العزاء",35,"ا",2,0],["وأسبح في فكري ودمعي سابح","فتوقظني كف كغادية السحب",36,"ب",1,0],["واسبك ضبابي هواء","وصفه نوراً ونارا",37,"ر",2,0],["واسبحي كالخيال","وابزغي كالشموس",38,"س",1,0],["واسبِقْ إلى الدّاعي رجوعَ طَرْفهِ","فاللّيثُ ما استَثرْتَه إلا وَثَب",39,"ب",1,0],["وَأَسبَلتُ العَبرَةَ","كَما أَنشَأَ الأُفُقُ السَحابَ المُدَيَّما",40,"م",2,0],["وأسبابه أهلكن عاداً وأنزلت","عزيزاً يُغنّي فوق غرفة موكل",41,"ل",1,0],["وأسبل عليها الستر فهي صناعتي","لا صنعة الهروي والخطاب",42,"ب",1,0],["وأسبلتِ الظلماءُ سُودَ غدائرٍ","عليهِ أشابَ الصّبحَ منها النّواصيا",43,"ي",2,0],["وأسْبَلَ من غَيْثٍ ومَلَّأَ من يَدٍ","وكم فَكَّ من غُلٍّ وأطْلَقَ من حَبْسِ",44,"س",1,0],["وأُسْبِلُ آماقَ الجفونِ بِعَبْرَةٍ","وإِنْ حُرِمَتْ منكِ المودَّةَ فِي القُرْبى",45,"ب",2,0],["وأَسْبلَ لي من سِتره فَوْقَ سِتَّةٍ","أَهِيمُ بهمْ فِي الأَرضِ مِثلَ القطا الزُّغبِ",46,"ب",1,0],["واسبِقْ بها إلى العلا شوطَ الصَّبا","لعلّها تُعَدُّ في الجِيادِ",47,"د",1,0],["واسبر به قلبا فريت أديمه","وعليك فاخلع برقع الأغراض",48,"ض",1,0],["واسبر طبائع من تنوي مودته","فقلما اتفق القلبان في البشر",49,"ر",1,0],["واسبل عليها كل ستر مسرمد","وواصل عليها الروح منك يجدد",50,"د",1,0],["وأسبل الستر صفحا إن بدا خلل","وأهتك به ستر أعداء وحساد",51,"د",1,0],["وأسبل عليها نفحة سرمدية","مطرزة بالفيض من عين أعيان",52,"ن",1,0],["وأسبل علينا الستر والأمانا","فرح قلوبا وأزح أحزانا",53,"ن",2,0],["واسبل علينا الستر يا قيوم","في كل لحظة لنا يدوم",53,"م",1,0],["وأَسبَلَ فوقَهُمْ أَذيالَ عفوٍ","وقد فَجَروا بزُورٍ وانْتِقادِ",54,"د",1,0],["واسْبِلِ السَّتْرَ لا ترى العيبَ للنَّا","سِ وإِنْ كانَ فالطُّعونُ عَماءُ",55,"ا",2,0],["وأسبلت أستار الحجاب مهابة","وذلك في بعض المواطن أهيب",56,"ب",1,0],["وأسبغتها نعمى عممت بها الورى","فأثنى بما أوليت باد وحاضر",57,"ر",1,0],["واسْبَحْ بقامُوسِ اللَّغى والبُغَى","صِحَاحُها تَلْقَ بِها جَوْهَرا",58,"ر",2,0],["وإِسْبالُ وَبْلِ السّتْرِ مِنْكَ مُؤَمَّلٌ","عَلَى ما تَرَى في طَيٍّ ذا مِنْ مَثالِبِ",59,"ب",1,0],["واسبحوا في مياه بحر علومي","واكشفوا بي ستائر الإلتباس",60,"س",1,0],["وَأَسْبَغَ ظِلَّ أَغْصانِ التَّداني","وَزَادَ قُدُودَها حُسْنَ اعْتِدالِ",61,"ل",1,0],["وَأَسْبغَ ظِلَّ ذَاكَ الشَّعْرِ مِنْهُ","عَلَى قَدٍّ بِهِ هَيَفُ الغُصُونِ",62,"ن",1,0],["واسبر لغور الدهر يا","من رأَيه عين الاصابة",63,"ب",2,0],["وَأَسبغت بِالتَوفيق كامل نعمة","عَلى وَطن فيهِ لَكَ الآية الكُبرى",64,"ر",2,0],["وأسبلتَ فينا يدَ المعجزات","تقصر عن وصفها الألسنُ",65,"ن",1,0],["واسبق الآتي ولا تنظر إلى","ما مضى من عمرنا أو بددا",66,"د",2,0],["وأَسبلْ دقها في نا","طبات القرعِ إسبالا",67,"ل",2,0],["واسبل الستر حوله وعليه","وأدم عزه دواما طويلا",68,"ل",2,0],["وَأسبلَ ماء الجفن كل","ما كَفكفتهُ وَكَفا",69,"ف",2,0],["وأسبأل الشهبَ عما","بهما وكيف تُدار",70,"ر",1,0],["واسبلن ذيل سترٍ","اذ منك يبغي القبولا",71,"ل",2,0],["واسبل فوق خدّيه ودَّلى","له ذنبين عنوان الرذالّهْ",72,"ل",2,0],["واسِ بَيْنَنا أَو لا","رُدَّنا إِلى القُرْعَهْ",73,"ع",2,0],["واسبل علينا الستر واجمع شملنا","ياذا المراحم واعف عنا وعاف",74,"ف",1,0],["وأسبي باحسان الجنان بحسنه","واشرب كأس الحب مع أفضل الجند",75,"د",1,0],["واسبل عليّ الستر واحفظني من الضرا","وكن لي دائماً يا رازقي",76,"ق",2,0],["وأسبر من مدهشات الأمور","شؤونًا على الدهر لم تسبر",77,"ر",1,0],["وَاِسبق إِلى الأَجود سَبق ناقِد","فَسَبقك الخَصم مِن المكابد",78,"د",1,0],["وَاِسبِقا فاجِعَ المَنِيَّةِ بِالعي","سِ فَكُلٌّ عَلى الجَديدَينِ فاني",79,"ن",2,0],["واسبق لغايات المعالي","مالكاً قصبَ الرهانِ",80,"ن",1,0],["وأسباب الفلاحِ مُوفّراتٌ","لمن يبغي حياة واْكتسابا",81,"ب",2,0],["وَأَسبَلَت دَمعَةَ الروحِ الأَمينِ عَلى","دَم بِفخٍّ لِآلِ المُصطَفى هَدرِ",82,"ر",1,0],["وَأَسْبِقْ لَنَا الْخَيْرَاتِ أَوَّلَ أَوَّلاَ","وَيَا آخِرُ اخْتِمْ لِي أَمُوتُ مُهَلِّلاَ",83,"ل",2,0],["وأسباب الحياة وإن تراخت","بأهليها مقضبة الصلات",84,"ت",1,0],["وأسبِل سِترَك الضّافي عَلَيهِ","إذا انهتكت او انكشفت سُتُور",85,"ر",1,0],["وأسبابُ هذا الحُسنِ قد تتشَعَّبُ","كم احتضَنَت فيها القيانُ المَزاهِرا",86,"ر",2,0],["واسبِل علينا الستر وامنَح جمعنا","بهدايةٍ وكرامةِ الأوطان",87,"ن",1,0],["وَأَسبَلَ فيهِم مِن شَيِبِ جودِهِ","سِجالاً أَراشَت كُلَّ مَن كانَ مُعدِما",88,"م",2,0],["وأسبل فيك المزن رعدٌ كأنّهُ","لمن بخلت بالسكب منههُنّ رادعُ",89,"ع",1,0],["وَأَسبَلوا مِنَ الجُفونِ أَدمُعاً","ظَنَنتُها ماء وَكانَت أَنفُسا",90,"س",2,0],["وأسبلَ الأليلَ الأثيثَ فَوقَ ضُحىً","وجَوهَرَ الثَّغرَ باللالاءِ والفَلَجِ",91,"ج",1,0],["واسبق له قبل ارتحال الندى","ولا تزره دون شاد الجناح",92,"ح",1,0],["واسبغت احسانا عليه ونعمة","فأنت له كهف وأنت له ذخر",93,"ر",1,0],["واسبكوا الجسم فيكسي صفرة","وترى الشمس بقلب المعدن",94,"ن",1,0],["واسبل دموع المقلتين بزفرة","تتوقد الاحشاء من نيرانها",95,"ن",3,0],["واسبى السرب بالعلمين خشفٌ","سباك وانت تعلم من سباكا",96,"ك",2,0],["واسب بهذا التليد ذا صل","بصوتهِ في الصهيل صهصلقه",97,"ق",2,0],["واسبقهم نيلاً لكل مبرة","وان تكُ لم تعدو بأيامها الخدرا",98,"ر",2,0],["واِسبق سواك إلى الألوان مُلتَهِما","وَقُم بعزمك في الأسحار نحو حِمى",99,"م",2,0],["واسبغت ظل الامن فيها فلم يخف","شذاتك الا زائغ جار واعتدى",100,"د",2,0],["واسبح بابحر تسبيح وصل على","ميت الحوادث وانسبها إلى العدم",101,"م",1,0],["واسبق الى البشر والاكرام ملتزما","لقبلة اليد من ذي الزهد والحكم",101,"م",1,0],["وأسبلت الظلام علي ستراً","ونجم الأفق ناظره كليل",102,"ل",1,0],["واسبِلْ رداءَ الحيا واشددْ يديك عَلَى","خُفوقِ قلبِك إن الحيَّ ذو حَشَمِ",103,"م",1,0],["واسبلِ السِّتْر يَا إلهي عَلَى 