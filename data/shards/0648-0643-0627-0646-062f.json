{"poems":[[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[55,"لما بدت فرأيتها في صفرة","https://www.aldiwan.net/poem26346.html","الكامل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[51,"يا ابن الوزيرين وابن السادة الصيد","https://www.aldiwan.net/poem10866.html","البسيط"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[28,"أباهل هل أنتم مغير لونكم","https://www.aldiwan.net/poem5559.html","الطويل"],[66,"وكأن دجلة والرياح","https://www.aldiwan.net/poem40662.html","مجزوء الكامل"],[105,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[52,"بخلا بهذا الدهر لست أراك","https://www.aldiwan.net/poem26770.html","الكامل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19689","الرجز"],[28,"أباهل هل أنتم مغير لونكم","https://www.poetsgate.com/ViewPoem.aspx?id=20998",""],[229,"لعلك ناظر في أمر من قد","https://www.aldiwan.net/poem50741.html","الوافر"],[229,"نعم المعين على الوغى في مأزق","https://www.aldiwan.net/poem50885.html","الكامل"],[282,"الشعر ما زال لسان الزمان","https://www.aldiwan.net/poem32335.html","السريع"],[364,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[409,"أيلام مسلوب الفؤاد فقيده","https://www.aldiwan.net/poem32496.html","الكامل"],[416,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[515,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[575,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"]],"verses":[["وَكَأَنَّ دارَكَ جَنَّةٌ حَصباؤُها ال","جادِيُّ أَو أَنماطُها الإِستَبرَقُ",0,"ق",1,0],["وَكَأَنَّ دِجلَةَ مُذ حَلَلتُم قُربَها","تَجري لِساكِنِها بِماءِ الكَوثَرِ",1,"ر",1,0],["وَكانَ دَعا رَهطَهُ دَعوَةً","هَلُمَّ إِلى أَمرِكُم قَد صُرِم",2,"م",1,0],["وكان دهراً عن الأذْكار مُنْغَلِقاً","فكان فَألُكَ من خير المقاليدِ",3,"د",1,0],["وَكَأَنَّ دَولَةَ آلِ شَم","سٍ عَن شِمالِكَ وَاليَمين",4,"ن",1,0],["وَكانَ دَقيقَ الرَحطِ فَاِزدادَ رِقَّةً","وَلُؤماً وَخِزياً فاضِحاً في المَقاوِمِ",5,"م",1,0],["وَكَأَنَّ دِجلَةَ وَالرِيا","حُ تُغَيرُ كَالخَيلِ النَوازي",6,"ي",1,1],["وكان دَليلَكم فجنى عليكم","وقد يَجني على القومِ الدليلُ",7,"ل",1,0],["وَكَأَنَّ دِرعاً مُفرَغاً مِن فِضَّةٍ","ماءُ الغَديرِ جَرَت عَلَيهِ صِباكِ",8,"ك",1,0],["وكأنَّ دعْوَتَهُ طليعَةُ قَوْلِ كُنْ","ما بَعْدَها إلا الإجابةَ مَوْكِبُ",9,"ب",1,0],["وَكانَ داودُ طَوداً يُستَظَلُّ بِهِ","وَفي عَلِيٍّ لِأَعداءِ الهُدى هَرَبُ",10,"ب",1,0],["وكان دلفين من ال","حارس ثم اقتربا",11,"ب",2,0],["وَكانَ دقيقَ الرّهْطِ، فازْدادَ رِقّةً،","وَلُؤماً وَخِزْياً فاضِحاً في المَقَاوِمِ",12,"م",1,0],["وكان دَمي بخدّك ليس يَخفى","فها هو فوقَ خدِّك والبنَانِ",13,"ن",1,0],["وكأنّ دَفَّةَ سَرجِه ولجامِه","شُدَّا على ظهرِ السِّماكِ الأعزلِ",14,"ل",1,0],["وَكانَ ديوانُهُمُ فارِقاً","بَينَ الهَجينِ المُدَّعي وَالهِجان",15,"ن",1,0],["وكأنّ دُرًّا فاه راوى مَدْحِه","لمّا رَوى وكأنّ مِسْكا فاحا",16,"ح",2,0],["وكأَنَّ دَمعَكَ حين يخطُرُ ذكرُهُم","عِقدٌ وَهَى فانثَالَ منهُ فَريدُهُ",17,"د",2,0],["وكأَنَّ دمعَ الصّبّ صَوبُ غمامةٍ","يسقي رسوماً نُحَّلاً وطلولا",18,"ل",2,0],["وكأن در التاج حول جبينه","زهر تحف البدر عنه تمامه",19,"م",2,0],["وكان دَرَى أَيَّ البرية عِندَه","وكان رأَى أَيَّ الرجالِ المهذبَا",20,"ب",2,0]]}