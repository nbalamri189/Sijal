دَقيقَ الرَحطِ فَاِزدادَ رِقَّةً","وَلُؤماً وَخِزياً فاضِحاً في المَقاوِمِ",5,"م",1,0],["وَكَأَنَّ دِجلَةَ وَالرِيا","حُ تُغَيرُ كَالخَيلِ النَوازي",6,"ز",2,1],["وكان دَليلَكم فجنى عليكم","وقد يَجني على القومِ الدليلُ",7,"ل",1,0],["وَكَأَنَّ دِرعاً مُفرَغاً مِن فِضَّةٍ","ماءُ الغَديرِ جَرَت عَلَيهِ صِباكِ",8,"ك",1,0],["وكأنَّ دعْوَتَهُ طليعَةُ قَوْلِ كُنْ","ما بَعْدَها إلا الإجابةَ مَوْكِبُ",9,"ب",1,0],["وَكانَ داودُ طَوداً يُستَظَلُّ بِهِ","وَفي عَلِيٍّ لِأَعداءِ الهُدى هَرَبُ",10,"ب",1,0],["وكان دلفين من ال","حارس ثم اقتربا",11,"ب",2,0],["وَكانَ دقيقَ الرّهْطِ، فازْدادَ رِقّةً،","وَلُؤماً وَخِزْياً فاضِحاً في المَقَاوِمِ",12,"م",1,0],["وكان دَمي بخدّك ليس يَخفى","فها هو فوقَ خدِّك والبنَانِ",13,"ن",1,0],["وكأنّ دَفَّةَ سَرجِه ولجامِه","شُدَّا على ظهرِ السِّماكِ الأعزلِ",14,"ل",1,0],["وَكانَ ديوانُهُمُ فارِقاً","بَينَ الهَجينِ المُدَّعي وَالهِجان",15,"ن",1,0],["وكأنّ دُرًّا فاه راوى مَدْحِه","لمّا رَوى وكأنّ مِسْكا فاحا",16,"ح",2,0],["وكأَنَّ دَمعَكَ حين يخطُرُ ذكرُهُم","عِقدٌ وَهَى فانثَالَ منهُ فَريدُهُ",17,"د",2,0],["وكأَنَّ دمعَ الصّبّ صَوبُ غمامةٍ","يسقي رسوماً نُحَّلاً وطلولا",18,"ل",2,0],["وكأن در التاج حول جبينه","زهر تحف البدر عنه تمامه",19,"م",2,0],["وكان دَرَى أَيَّ البرية عِندَه","وكان رأَى أَيَّ الرجالِ المهذبَا",20,"ب",2,0],["وكأنّ درعَكَ أُنشئت من مزنَةٍ","فيكادُ أن يعشى بها المُستلئمُ",21,"م",1,1],["وَكَان دُعَاءُ بِشرٍ صَوبَ غَيثٍ","يُعَاشُ بِهِ وَيُحييِى مَا أصَابَا",22,"ب",2,0],["وكان دعاءه يا رب إني","بقرية قوم سوء فاسقينا",23,"ن",2,0],["وكان دين به دنياهم حسنت","واليوم باتوا ولا دنيا ولا دينا",24,"ن",2,0],["وَكانَ داودُ أَقامَ بَعدَهُ","في أَهلِهِ ثُمَّ أَتاهُ وَحدَهُ",25,"ه",1,0],["وَكَأَنَّ دِعصَ الرَملِ أَسفَلُها","وَكَأَنَّ غُصنَ البانِ أَعلاها",26,"ا",3,0],["وكأن دُرَّ حديثهِ قد جاءَني","كقميصِ يُوسُفَ فانجلت أيَّامي",27,"ي",1,0],["وكان داعي الموت اسكنه الثرى","شغفاً به ليعدَّ من أترابه",28,"ب",2,0],["وَكَأَنَّ دِجلَةَ سِلكُها ف جيدِها","وَالبَعلَ سَيِّدَنا الإِمامُ الهادِي",29,"د",2,0],["وَكانَ دُعائي اللَهَ وَقتَ إِجابَةٍ","فَها هُوَ ذا في لَوعَةٍ وَغَرامِ",30,"م",1,0],["وَكَأنَّ دُرَّ الخَدِّ يُكسى حُمرَة ال","ياقوتِ مِن نظرِ العُيونِ إِلَيهِ",31,"ي",2,0],["وكانَ دَستي فيه مَنصوبةً","عليهِ فيما رمتُ من قَصدي",32,"د",2,0],["وكان دخانٌ موصلٌ قبلاتنا","على رغم بعد الخد منا عن الخد",33,"د",1,0],["وَكَأَنَّ دَولَته المُنيرةَ رَوضَةٌ","طابَ المَقيلُ بِها وَلَذَّ المرتَعُ",34,"ع",1,0],["وكأنّ دجلَةَ إذ يغطمط مَوجَها","ملك يُعَظَّم خيفةً ويُبَجَّل",35,"ل",1,0],["وكأنّ دائرة الحديقة عندما","جاد الغمام لها برشف الريقِ",36,"ق",1,0],["وَكانَ دَهر وَنَكبت حقب","وَالجَهل يَغرى عَلى ثَرى سَبعه",37,"ع",2,0],["وكأنَّ ..دوداً بالثرى","لَمُفَرِّقٌ بين الجِيَفْ",38,"ف",1,0],["وكأَنَ دمعي مطلقُ من رِبقةِ","وكأنَ قلبي في مخالبٍ أجدلِ",39,"ل",1,0],["وَكَأَنَّ دِجْلَةَ وَالْفُرَاْتَ مَسَاْبِحٌ","وَكَأَنَّ إِيْرَاْنَ اللِّئَاْمِ وِسَاْدُ",40,"د",1,0],["وكان دليل الفدم بيتأً لشاعر","ولم يدر ما معناه لما تكلما",41,"م",2,0],["وكأن دهري سيبويه فكم له","بالعالمين تحرك وسكون",42,"ن",1,1],["وكأنَّ دمعي حيث أنشره","من مرِّ صبٍ راح يكتحل",43,"ل",1,0],["وكأن درب الرجولة قفرٌ","وعيوننا في ظلمة عمياءُ",44,"ا",2,0],["وكأنَّ دجلة َ سلكها في جِيدها","والبَعلَ سَيّدَنا الإمامُ الهادي",45,"د",2,0]]}