{"poems":[[49,"مستجير الهوى بغير مجير","https://www.aldiwan.net/poem25293.html","الخفيف"],[74,"نجم تولد بين الشمس والأسد","https://www.aldiwan.net/poem18547.html","البسيط"],[74,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"ما أحسن العفو من المالك","https://www.aldiwan.net/poem65785.html","السريع"],[45,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[30,"نابي الفراش طري اللحم مطعمه","https://www.aldiwan.net/poem5497.html","البسيط"],[63,"وآمن من ندمه","https://www.aldiwan.net/poem51325.html","مجزوء الرجز"],[68,"كم ساهر حرم لمس الوساد","https://www.aldiwan.net/poem38652.html","السريع"],[68,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[50,"سماه مولاه لاستملاحه السمجا","https://www.aldiwan.net/poem62489.html","البسيط"],[50,"ليتني ليت ليتني","https://www.aldiwan.net/poem66221.html","مجزوء الخفيف"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[92,"الصَبر الجَميل","https://www.poetsgate.com/ViewPoem.aspx?id=179152",""],[146,"قد طال للماطل أن يقتضى","https://www.aldiwan.net/poem58443.html","السريع"],[240,"ما سمع الناس ولا أبصروا","https://www.aldiwan.net/poem31959.html","السريع"],[266,"لقد علمت ما قد اضر بنا البعد","https://www.aldiwan.net/poem38339.html","الطويل"],[287,"القلب من شفقي اللون يرسف في","https://www.aldiwan.net/poem32687.html","البسيط"],[354,"أمرتني بستر كشف غطائي","https://www.aldiwan.net/poem15499.html","الخفيف"],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[408,"أيها المقتر شحا لا تخف","https://www.aldiwan.net/poem46996.html","الرمل"],[445,"إليك منك فرار الخائف الوجل","https://www.aldiwan.net/poem34809.html","البسيط"],[463,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[469,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[556,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[567,"ليس يجري غير ما الله كتب","https://www.aldiwan.net/poem52773.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122704","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122648","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122709","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122705","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110401","الرمل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101486","الخفيف"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132476","البسيط"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101977","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65012","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64410","البسيط"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124026","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79794","الخفيف"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36164","الخفيف"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110696","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110330","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109791","الخفيف"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76540","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127233","الرجز"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[5837,"سجين المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=181854",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""]],"verses":[["مُحكَمٌ قَصَّرَ الفَرَزدَقُ وَالأَخ","طَلُ عَنهُ وَفاقَ شِعرَ جَريرِ",0,"ر",1,0],["محكّم الأمر للأقلام في يده","وللسيوف مقام الركَّع السجَّد",1,"د",1,0],["محكم فالفنا بالخوف مضطرب","والقوس منه كما قد قيل موْتور",2,"ر",1,0],["محكم السطوة سحَّاح الديم","يأخذ بالسيفِ ويعطي بالقلم",3,"م",1,0],["محكْتَ في هجرِك لي ظالماً","ولسْتُ في حُبّك بالماحِك",4,"ك",1,0],["مَحِكٌ إِذا مَطَلَ الغَريمُ بِدَينِهِ","جَعَلَ الحُسامَ بِما أَرادَ كَفيلا",5,"ل",2,0],["مَحكانُ شَرُّ فُحولِ الناسِ كُلِّهِمِ","وَشَرُّ والِدَةٍ أُمُّ الفَرازيمِ",6,"م",1,0],["محكم في دم من","يعجز عن سفك دمه",7,"م",2,0],["مُحَكَّمٌ سَلَّ لَطَلَّ الدِما","صَوارِمَ السودِ الصِحاحِ الحِداد",8,"د",1,0],["مُحَكَّمٌ في الوَرى وَآمِلُهُ","يَحكُمُ في مالِهِ وَيَحتَكِمُ",9,"م",1,0],["مُحَكَّماتٌ فما تُبْقِينَ مِنْ شُبَهٍ","لذِي شِقاقٍ وما تَبْغِينَ مِنْ حَكَمِ",10,"م",1,0],["مُحَكَّمُ الطَرفِ يُدمي سَيفُ ناظِرِهِ","إِذا لَحاهُ لِقَلبٍ قالَ لا حَرَجا",11,"ج",2,0],["مُحكَمِ الأمرِ ضَيغم","صائبٍ حين أصدرُه",12,"ر",2,0],["محكمين براء من معاوية","ومن علي يا ليت الأخير بري",13,"ر",2,0],["مِحَكُّ طباعٍ آبياتٍ وطُوَّعٍ","وبَلوى نفوسٍ طامحاتٍ ووُضَّع",14,"ع",1,0],["محكَّم في العلمِ إن شاء أنَّ","يختلَّ في مَرعاه أو يُحمِضا",15,"ض",2,0],["مُحَكَّمٌ لَو أَنصَفَ الدَهرُ في ال","أَحكامِ لَم يَنهَ وَلَم يَأمُرِ",16,"ر",1,0],["محكمة النضيد ضافية الثنا","يضم عليك الوشي من حليها برد",17,"د",1,0],["مُحَكَّمٌ في قُلوبِ الناسِ يَملِكُها","قَسراً فَقَد يَئِستُ مِن روحِ إِعتاقِه",18,"ق",2,0],["مُحكَمٌ ذو تَشابُهٍ وَاِئتِلافٍ","في اِختِلافِ الآياتِ وَالأَجزاءِ",19,"ا",2,0],["مُحكَمُ النَّسْجِ لا يَزالُ غَنيّاً","جَدُّه أن يُشانَ منه برُقْعه",20,"ع",2,0],["مُحكمُ التنزيلِ قد قَالَ لنا","لن تَنَالوا البرَّ حتّى تُنفِقوا",21,"ق",3,0],["مُحَكِّمِينَ يسوقونَ النفوسَ إِلَى","إِنفاذِ حُكْمِكَ سَوْقَ السَّبْيِ والنَّفَلِ",22,"ل",1,0],["محكِّمٌ في ماله أمرَ الندى","بما قضى من معوزٍ أو ممكنِ",23,"ن",1,0],["محكَّمٌ في الناس يقضِي بينهم","بمُحكَم الآي ومنصوصِ السُّوَرْ",24,"ر",1,0],["محكمات الأعجاز تسلم إعجا","زا إلى العي مسلماً والوليدا",25,"د",2,0],["مُحَكَّمٌ فيه أنّى شاء فارسه","للرّيث إنْ رامه طوراً وللعَجَلِ",26,"ل",1,0],["مُحكَمُ الرَّأيِ حصيفٌ حازمٌ","رأيهُ لو غالبَ السَّيفَ غَلَبْ",27,"ب",1,0],["مَحِكٌ إن طَلَبتَ مِنهُ سِوَى الحَ","قِّ تَداعَى طَغيَّةً ومَحاكا",28,"ك",2,0],["مَحِكٌ غَداةَ تماحُكٍ خَصِمٌ غداة","تَخاصُمٍ مَرسٌ غداةَ مِراس",29,"س",1,0],["مَحِكٌ ألَدٌّ يَظَلُّ خَصمُ جِدالِه","حَيرانَ بَينَ إباً وَبَينَ مَحاك",30,"ك",1,0],["مَحِكُ الضَّغينَةِ ما ألَذَّ فُكاهَةً","فَوقَ الخِوانِ وَما أشَدّض مَحاكا",31,"ك",2,0],["مُحكَمُ الرأيِ خلا من خَلَلٍ","طاهرُ القلبِ خلا من دَنَسِ",32,"س",1,0],["محكَم الوضع مُتقن الصُنع زاهٍ","صالحُ العيش جالبٌ للرخاءِ",33,"ا",2,0],["مٌحكَّكٌ حُولٌ قُلَّبٌ","مُحَنَّكٌ عازمٌ حازم",34,"م",1,0],["محكماتُ الحديد لم تغن شيئا","عن ذويها ومرهفات الحديد",35,"د",1,0],["مُحكماً مِثلَ النّسيب المِدَحا","مِثلَ مَدحِ الزّهرِ حسن الفننِ",36,"ن",1,0],["محكما صادقا بشيرا نذيرا","شاهدا مرشدا مبينا دليلا",37,"ل",2,0],["محكما فاصلا مبينا منيرا","دق معنى فحير الأفكارا",38,"ر",2,0],["محكما أبوابه بابا فباب","ألمعي فكره مثل الشهاب",39,"ب",1,0],["مُحكَمََ الوضْع يُناجيكَ مِنْ","صُدورِها سُرِّقوا فيها",40,"ي",3,0],["محكمين براء من معاوية","ومن علي ويا ليت الأخير بري",41,"ر",2,0],["محكم منزلٌ أنت فيه ءايا","ت نثاهم وذمّهم تتوالى",42,"ل",2,0],["محكماتِ البناءِ تنهدمُ الدنيا","ويبقى بناؤهن دُهورا",43,"ر",2,0],["مُحكَمُ النَّقلِ قَد رَوته ثِقاةٌ","مُسنَدٌ بِالرّواةِ وَالاتفاقِ",44,"ق",1,0],["محكمة يؤب سيف النقد إن","شاء بأن يفصمها منثلما",45,"م",2,0],["محكية عن طيرها وسباعها","وسحابها ورياحها ودجانها",46,"ن",3,0],["محكولتان بمرود الوحيين لا","بمراود الآراء والهذيان",47,"ن",1,0],["محكم السَرد لا يَدا داود","مَن تَوقى الآثام فيها كُفيها",48,"ه",2,0],["محكمات الايات في مهجة الص","ب فلا يبتغي لها تبديلا",49,"ل",2,0],["محكّمات فَما يُبقين من شبه","لذي شقاق وَما يَبغين من حِكم",50,"م",1,0],["محكمات فَما يبقين من شُبَه","إلا لباغ عَلى ذي الحق متهم",51,"م",1,0],["مُحكمات فَما يَبقين مِن شبه","وَمحكمات فَما غادرنَ مِن سقم",52,"م",1,0],["مُحَكّمَةٌ في قُلوبِ الأَنا","مِ لَو أَنّ أَحكامَها عادِلَه",53,"ل",2,0],["محكمة يؤب سيف النقدان","شاء فان عنما متثلما",54,"م",2,0],["مُحَكّماتٌ فما يُبْقِينَ مِن شُبَهٍ","لِذِي شِقاقٍ ولا يَبْغِيْنَ مِن حَكَمٍ",55,"م",1,0],["محكمات محكمات إذا أنشد","ن نال المنى بهن الأديب",56,"ب",1,0],["مُحْكَماتٍ نَسَخَتْ بالبّيِّناتْ","عَنْ قُلُوبِ الناسِ داجِي الظُلَمِ",57,"م",1,0],["محك تساوى النفع والضر عنده","فليس بمفراح وليس بحزان",58,"ن",1,0],["محكّمات فما تبقين من شبه","مستحكمات على الدنيا بمنحسم",59,"م",1,0],["محكمات الكتاب بعض ثناه","ومعانيه نعته والبيان",60,"ن",1,0],["محكوم ظلم ولا فزع له محاميه","من حر ما به يمكن يشق جوفه",61,"ف",2,0],["محكمون لهم تخيير أنفسهم","ما يشتهون من الجنات في خلد",62,"د",1,0],["محكما في نفوس العالمين لها","قواعداً ليس عمر الدهر يفنيها",63,"ي",3,0]]}