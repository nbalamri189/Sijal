{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[85,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[76,"خذها يرن لها الجواد صهيلا","https://www.aldiwan.net/poem13220.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141928","الخفيف"],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[112,"ذهاب بلا اياب","https://www.poetsgate.com/ViewPoem.aspx?id=35293",""],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[164,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[295,"أبشري يا دمشق بالأبطال","https://www.aldiwan.net/poem11669.html","الخفيف"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[310,"ما أم ذو أمل حمى ابن عروس","https://www.aldiwan.net/poem56501.html","الكامل"],[438,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48767","الكامل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129528","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59148","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48977","الخفيف"],[1610,"","https://poetry.dctabudhabi.ae/diwan/poem/115020","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108712","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141331","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76654","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202148","الرمل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130061","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138561",""],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46012","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131024",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120496","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35109","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35139","الكامل"],[5277,"\"أينَ العراقُ.. تُرى؟\"","https://www.poetsgate.com/ViewPoem.aspx?id=206804",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5490,"وللحديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=176364",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[1362,"سقتك وهناً يا دارها الديم","https://www.poetsgate.com/ViewPoem.aspx?id=127724",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[6102,"شادن","https://www.poetsgate.com/ViewPoem.aspx?id=184418",""],[6102,"لا نامت أعين الجبناء ..","https://www.poetsgate.com/ViewPoem.aspx?id=184861",""],[6233,"سيمر العاشق فانتظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78445&r=&rc=8",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["إيهٍ وَكَم مِن نِعمَةٍ جَلَّلتَهُ","تَضفو كَهُدّابِ الرِداءِ المُخمَلِ",0,"ل",1,0],["إيهٍ وإن أذكيت نار صبابتي","وقدحتَ زندَ الشوق بالتذكارِ",1,"ر",1,0],["أيَّ هَوْل رأوْا بهمْ أيّ هَوْلٍ","حُقَّ منه تشيبُ رأسُ الغلام",2,"م",1,0],["إيهٍ وَما بَينَ الجَوانِحِ غُلَّةٌ","لَو كُنتُ أَنقَعُ بِالعِتابِ غَليلا",3,"ل",2,0],["إيه وكر النسور لم يحضن الأرز","وليداً أبرّ منكَوأجرا",4,"ر",2,0],["إيه (( وضاح)) دونك البئر فانزل","قطعة دوان وصفها بالحقيره",5,"ر",2,0],["إيه والدنيا مساكن ورحله واغتراب","والغلا في الوقت هذا مميز بالعيوب",6,"ب",1,0],["إيهٍ وللآداب منه فخرها","إذ فاق في المنثور والموزون",7,"ن",1,0],["أيهونُ عندك فقدُ عطفٍ مؤملٍ","روض الأَماني من رضاه أريضُ",8,"ض",1,0],["إيهٍ وإن عذَّبني ذِكرُها","فمِن عذابِ النَّفسِ ما يَعْذُبُ",9,"ب",1,0],["أيه وادي السرحان بئست لياليك","ولا عاش ذكرها في البال",10,"ل",1,0],["إِيهٍ وَلَولا فُلكُها لم ينجهِ","سبحٌ وَطوفانُ البلايا يذرعُ",11,"ع",1,0],["إيهٍ وشمّر فهوَ أعجلُ واِغتنم","مِن فرصةِ الإمكانِ فوتاً يسرعُ",11,"ع",1,0],["إيهٍ وَكَم مِن منزلٍ جلّى به","يَعتاظُ مِنها الصبحُ عن أدموسِ",12,"س",1,0],["إيهٍ ومن وجدي بهِ","أُمسِكُهُ في الطُرُقِ",13,"ق",1,0],["إيهٍ ولمْ يُخبِرْ بشيْءٍ كائنٍ","إلاّ وجاء يُوافقُ الأخْبارَا",14,"ر",2,0],["إيِهٍ وفارقَهُ الأمينُ بموُضِعٍ","هو حَدُّهُ ما جازَهُ استمْرارَا",14,"ر",2,0],["أيهون يومئذ عليهم أن يروا","أعداءهم لهمُ من الشفعاء",15,"ا",2,0],["إيه وإني لا أراك صادقاً","ما صنعت من بعدنا تلك الدمى",16,"ا",1,0],["إيهٍ وَلَوْلاَ نَبْتُ سَالِفِ خَدّهَا","لَمْ أدْرِ أنَّ الآسَ يَنْبتُ فِي الشَّرَرْ",17,"ر",1,0],["إيه وادي الفُرَيْكةِ الغضَّ رحِّبْ","بهزار يأوي إلى أَكفانهْ",18,"ن",2,0],["أيهولنا يا كلبُ أصدق شِدّةٍ","يوم اللقاء أم الهويلُ الأولُ",19,"ل",1,0],["أيِّهوا بالصبوح فالليل فرعٌ","واشربوا فالصباح فيه توارى",20,"ر",2,0],["إيه وادي النّيل أدهشت الأمم","فغدا الشّرق على الغرب يثور",21,"ر",1,0],["إيهٍ وهلْ حُكْمُكَ لي مُنْصِفٌ","وطالبٌ ما فاتَ من ذَحْل",22,"ل",1,0],["إيه وقلت الى الوفاء محركاً","إيه فما خطرت بعطف جماد",23,"د",1,0],["أيهودي بعيسى كافر","أم مسيحي ترومان الفطين",24,"ن",1,0],["إيه وادي النيل ما أبهى سناك","ليس في البلدان مرغوباً سِواك",25,"ك",1,1],["أي هوان كابدته وقد","كان فناها في الورى مستجار",26,"ر",1,0],["إيهٍ وَلَيلٍ في المُروجِ سَرى بِهِ","وَالدُّجن قَيَّدَتِ الدُّجى بِقُيودِ",27,"د",1,0],["أيهوى فؤادي من بني الأرض واحداً","وقد هام بي وجداً ملائكة السما",28,"م",2,0],["ايه ومن مثل العزيز كياسة","وسياسة ورئاسة واثولا",29,"ل",2,0],["إيهٍ وَهَل مَعَ إيهٍ يا أَبا عُمَرٍ","مِن تُحفَةٍ غَيرِ إِعظامٍ وَإِكبارِ",30,"ر",1,0],["إيهٍ وَلَو بَعضَ الحَديثِ عَنِ الَّتي","حَيّا بِها رَبعي أَجشُّ هَزيمُ",31,"م",1,0],["إيهٍ وأنتَ \"مثنى\" الخيرِ تسمعني","أهلوكَ عنْ جيرةِ الصوبينِ قدْ نقلوا",32,"ل",3,0],["أَ يَهُودُ أَنْتُمْ أَمْ نِيَامٌ لَمْ تَرَوْا","مَا حَلَّ بِاليَمَنِ الْمُكَابِدِ لِلْمِحَنْ؟",33,"ن",1,0],["أيهون عندك ان تهان مراقد","للآل فيها منزل ومقام",34,"م",1,0],["أيهونُ أولى القِبلتين وجُندُه","في الهَجْع؟ لا حَوَت العيونَ جفونُ",35,"ن",1,0],["أيُهوِّمُ الغَيرانُ فيك ويتّقي","يقظان حالف طرْفَه التّسهيدُ",36,"د",1,0],["إيه ويا برق هات عن نفر","أين استقرت ظباؤه الجثم",37,"م",1,0],["إِيهِ- وَاللَّهِ- قَد طَعَنتِ قُلُوبًا","دُونَ عِلمٍ لِتَنعُمِي بِالشَّهِيقِ",38,"ق",1,0],["إِيهٍ ؛ وَ \" شَادِنُ \" مِا بَينِ الشَّوَادِنِ قَدْ","شَلَّتْ حُرُوفَ فَمِي , مُذْ سَاقَها القَدَرُ",39,"ر",1,0],["إِيهٍ؛ وَحُكَّامُنا عَلى وَجَلٍ","مِن أَجلِ كُرسِيٍّ أَذعَنُوا عَلَنا",40,"ن",2,0],["أَيَهونُ عليك بأن آتي","وأعودَ بقلبٍ منكسرِ !؟",41,"ر",1,0],["إيهٍ وكم زاد المصيبة أنَّها","تَغتال رمزاً باسماً وسماء",42,"ا",2,0]]}