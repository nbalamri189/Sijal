www.poetsgate.com/ViewPoem.aspx?id=179622",""],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[77,"أثار سناها والديار نوازح","https://www.poetsgate.com/ViewPoem.aspx?id=33819",""],[77,"قفا فاسألا في ساحة الأجدع الفرد","https://www.poetsgate.com/ViewPoem.aspx?id=33812",""],[77,"مقامك مرفوع على عمد السعد","https://www.poetsgate.com/ViewPoem.aspx?id=33814",""],[49,"ركنَّا إلى الدنيَا الدنئة ِ ضلَّة ً","https://www.poetsgate.com/ViewPoem.aspx?id=2741",""],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[27,"وأَقبَّ كالسِّرحان تم له","https://www.poetsgate.com/ViewPoem.aspx?id=180957",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[80,"تدَرّعْتُ صبري جُنَّة ً للنوائبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3007",""],[35,"خَلِيلَيَّ عُوجَا مِنْكُما سَاعة ً مَعِي","https://www.poetsgate.com/ViewPoem.aspx?id=22044",""],[51,"رِكْبتُك الخيرُ التي لم يزل","https://www.poetsgate.com/ViewPoem.aspx?id=30400",""],[86,"أَيُّها المُصْلِحُونَ ضاقَ بنا العَيْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13095&r=&rc=50",""],[105,"ركب الرفاق الظاعنين عجالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55032&r=&rc=202",""]],"verses":[["رَكِبتَ ظِرابَ اللابَتَينِ عَلى الحَفا","وَغَيرُكَ لَم تَسلَم عَلَيهِنَّ نَعلُهُ",0,"ل",2,0],["رَكِبوا صَعبَةَ العُلى أَوَّلَ النا","سِ فَمَن جاءَ بَعدَهُم جاءَ رِدفا",1,"ف",2,0],["رَكِبَتني وَهماً جُلالاً فَمازا","لَ جِذابي حَتّى رَمى بِيَ نِقضا",2,"ض",2,0],["رَكَّبَت صِبغَةَ الهِلا","لِ عَلى صِبغَةِ الغَلَس",3,"س",1,0],["رَكِبوا رِماحَهُمُ إِلى أَغراضِهِم","أَمَمَ العُلى وَجَروا بِغَيرِ عِثارِ",4,"ر",1,0],["رَكِبتُ إِلَيكَ أَعجازَ اللَيالي","أَخوضُ مِنَ المَساءِ إِلى البُكورِ",5,"ر",1,0],["رَكبٌ أَناخوا لا يُرجّى مِنهُمُ","قَصدٌ لِإِتِهامٍ وَلا إِنجادِ",6,"د",1,0],["رَكدَةٌ عَن جَولَةٍ تَحسَبُها","مِرجَلَ القَينِ غَلا ثُمَّ بَرَد",7,"د",1,0],["رَكِبتُ طِرفي فأَذرى دَمعَهُ أَسَفاً","عِندَ اِنصرافيَ مِنهُم مُضمِرَ الياسِ",8,"س",1,1],["رَكَنْتُمْ إِلَيهِ وَالحَوادِثُ عُوِّدَتْ","إِذالَةَ مَالِ المَرْءِ وَهْوَ مَصونُ",9,"ن",1,0],["رَكزْنا حَوالَيْهِ الرِّماحَ وما لَنا","سِواها إذا فارَ الهَجيرُ ظِلالُ",10,"ل",1,0],["رَكِبنا وَفِتيانَ صِدقٍ ثُبينا","طُخارِيَّةً قُرَّحاً يَغتَلينا",11,"ن",2,1],["رُكوبُكَ النَعشَ يُنسيكَ الرُكوبَ عَلى","ما كُنتَ تَركَبُ مِن بَغلٍ وَمِن فَرَسِ",12,"س",1,0],["ركِبَ الطّريقَ الى الجِنانِ وحورُه","يَلْقَيْنَهُ بتَصافُحٍ وعِناقِ",13,"ق",1,0],["ركِبْتَ الهَوْلَ في سُبُلِ المَعالي","فَلُقّيتَ السّعادَةَ والوِفاقَا",14,"ق",2,0],["ركِبْتَ الدّهْرَ مُنْقاداً ذَلولاً","بحُرْمَةِ مُصْطَفَى ركِبَ البُرَاقا",14,"ق",2,0],["ركِبَ السّفينَةَ واسْتَقَلّ بأفْقِها","فكأنّما ركِبَ الهلالَ الفَرْقَدُ",15,"د",1,1],["ركَضْتُ إليْكَ الجُرْدَ أفْلي بها الفَلا","وأذْرَعُ منْها فَدْفَداً بعْدَ فَدْفَدِ",16,"د",1,0],["رَكَضْتُ بِها خيْلَ البَديهَةِ جاهِداً","وأسْمَعْتُ آذانَ المَعاني على بُعْدي",17,"د",2,0],["ركَضْتُ لَها خيْلَ البَديهَةِ جاهِداً","وأسْمَعْتُ آذانَ المَعالي على بُعْدِ",18,"د",1,0],["ركِبْتُ طَريقَ الصّبْرِ وهْيَ مَفازَةٌ","ليَ اللهُ منْ غَوْلِ الطّريقِ وبُعْدِهِ",19,"د",2,0],["رَكَدَت عَلَيها يَومَها","شَمسٌ بِحَرِّ شِهابِها",20,"ب",3,0],["رَكِبَت إِلَيكَ نَزائِعٌ مَلبونَةٌ","قُبُّ البُطونِ يَجُلنَ في الأَلبادِ",21,"د",1,0],["رُكِبَت مِنهُمُ إِلى الرَوعِ خَيلٌ","غَيرُ ميلٍ إِذ يُخطَأُ الإيفاقُ",22,"ق",1,0],["رَكِبوا البِحارَ وَقَد تَجَمَّدَ ماؤُها","وَالجَوَّ بَينَ تَناوُحِ الأَرواحِ",23,"ح",1,0],["رَكِبوا البَحرَ جاوَزوا القُطبَ فاتوا","مَوقِعَ النَيِّرَينِ خاضوا الظَلاما",24,"م",2,0],["رُكنانِ لِلشَرقِ لا زالَت رُبوعُهُما","قَلبُ الهِلالِ عَلَيها خافِقٌ يَجِبُ",25,"ب",1,0],["رَكينُ ما تُثني عَلَيهِ الحُبا","يَهفو بِهِ نَحوَ الثَناءِ اِرتِياح",26,"ح",1,0],["رَكَنتُ إِلى كَرَمِ الصَفحِ مِنهُ","فَآمَنَني ذاكَ أَن يَحقِدا",27,"د",2,0],["رَكودُ الحُمَيّا وَردَةُ اللَونِ شابَها","بِماءِ الغَوادي غَيرَ رَنقٍ مُديمُها",28,"م",3,0],["رَكِبنَ اِتِّضاعاً فَوقَ كُلِّ عُذافِرٍ","مِنَ العيسِ نَضّاحِ المَعَدَّينِ مُرفِعِ",29,"ع",1,0],["رُكامٍ تَرى أَثباجَهُ حينَ تَلتَقي","لَهُ حُبُكٌ لا تَختَطيهِ الضَغابِسُ",30,"س",1,0],["رَكِبتُ بِهِ عَوصاءَ كُلِّ كَريهَةٍ","وَزوراءَ حَتّى يَعرِفَ الضَيمَ جَانِبُه",31,"ب",2,0],["ركدت رياح المعلوات لفقدها","كسَدَتْ به الآداب بعد نَفاقِ",32,"ق",1,0],["ركب الفِرارَ مطيَةً ينجو بها","فجرتْ به حتى استقر على سَقَرْ",33,"ر",1,0],["ركبنا إلى اللَّذات في طَلَقِ الصِّبا","مطايا الليالي وَادعينَ إلى حدِّ",34,"د",1,0],["ركبنا إلى الإِحسان في سُفُنِ الرّجا","بحورَ عطاءٍ ليس تجزُرُ عَن مَدِّ",34,"د",1,0],["ركَبت أرجلها الأداهمَ كلما","يتحركون إلى قيام تصهلُ",35,"ل",1,0],["ركباً كعثباً عضوضاً مصوصاً","ناشزاً ذا بضاضةٍ ورزانه",36,"ن",2,0],["ركضوا بميدان التحاسد خيلهم","وسبَوا من الأعراض غير مباح",37,"ح",1,0],["ركبته وبياض الصبح تحسبه","صدر المليحة مكشوف التلابيب",38,"ب",1,0],["ركِبت بحور الشعر رَهْواً ومائجاً","وأقْحَمْت منها كلّ هَوْلٍ يراعيا",39,"ي",2,0],["رَكودٍ تَسامى بِالمَحالِ كَأَنَّها","شَموسٌ تَذُبُّ القائِدينَ وَتَضرَحُ",40,"ح",1,0],["رَكِبَت رَبابُكُمُ بَعيراً دارِساً","في السوقِ أَفضَحَ راكِبٍ وَبَعيرِ",41,"ر",1,0],["ركبتم صعبتي أشَراً وحيْنا","ولستم للصِّعاب بمُقرنينا",42,"ن",2,1],["رَكُنّا إِلَيهِ وَلَم نَعصِهِ","غَداةَ أَتانا مِنَ ارضِ الحَرَم",43,"م",1,0],["ركعتْ لذكراهُ الحروف فلن تكدْ","تتبيَّنُ الألفاتُ من دالاتها",44,"ت",3,0],["ركوبي على أمثاله في زمانكم","كما ركّبت في العالمين القبائح",45,"ح",1,0],["ركبوا وقد ملأوا الفضا في أحمر","كالشمسِ تشرق في العجاج الأكدر",46,"ر",1,1],["رُكوبُ الحَقيقَةِ لِلحَقِّ حَقُّ","وَمَعني العِبارَةِ فيهِ يَدِقُّ",47,"ق",1,1],["رَكِبتُ الوُجودَ بِفَقدِ الوُجو","دِ وَقَلبي عَلى قَسوَةٍ لا يَرِقُّ",47,"ق",1,0],["رُكْنُ صدقٍ تُدعَى إلى الشَّد منه","لا ضعيف تُدْعى إلى إسنادِهْ",48,"د",2,0],["ركبتُ فصاحو