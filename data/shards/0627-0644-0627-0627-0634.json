{"poems":[[46,"بني حميد الله فضلكم","https://www.aldiwan.net/poem30349.html","المنسرح"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12648","الطويل"],[376,"ألا أشكو إليك نعم سأشكو","https://www.aldiwan.net/poem57333.html","الوافر"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34398","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27161","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93439","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97979","المجتث"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108299","البسيط"],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[5956,"مُبدِعون ، ومُجْتَرُّون","https://www.poetsgate.com/ViewPoem.aspx?id=185568",""]],"verses":[["أَلا اِشكُروا اللَهَ ذا الجَلالِ فَقَد","بِالصُنعِ في أَصرَمٍ تَغَمَّدَكُم",0,"م",1,0],["أَلا أَشرَقَت فَوزٌ مِنَ القَصرِ فَاِنظُرِ","إِلى مَن حَباكَ الوُدَّ غَيرَ مُكَدَّرِ",1,"ر",1,1],["ألا أَشكو إليكَ نَعم سأَشكو","فأوسِع حينَ توسعُني استِماعا",2,"ع",2,1],["إِلّا إِشاعَتَهُم بِأَنَّكَ قاتِلي","صدقوا فَأَنتَ مُعَذّبي وَحَبيبي",3,"ب",2,0],["إِلّا اِشتَهَيتُ أَنَّها","لَما بِنا لَم تَلمَعِ",4,"ع",1,0],["أَلا اشرَبها عَلى النَّاقُوسِ صرفاً","فَذاكَ مُؤَذِّنُ الدينِ القَديمِ",5,"م",1,1],["إلا اشتراء لعقلي","فبعته في وجاب",6,"ب",1,0],["ألا اشكروا الله يا أهل الجمال فكم","متيمٌ بجمال الوجه ولهان",7,"ن",1,0],["ألا أشجي النفوس بشعر فخرٍ","ليوقد شعلة الآمال فينا",8,"ن",2,0],["إلا أشعاري تصفو","وتضيىء الدنيا وتَسُرُّ",9,"ر",1,0]]}