w.aldiwan.net/poem41401.html","الخفيف"],[433,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[433,"عاد له الدهر كما قد بدا","https://www.aldiwan.net/poem12389.html","السريع"],[433,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[433,"يا أولا في كل عد","https://www.aldiwan.net/poem12511.html","مجزوء الكامل"],[433,"كم مرضت صبوتي فجاءت","https://www.aldiwan.net/poem12521.html","مخلع البسيط"],[433,"لو حل عن خديه عقد لثامه","https://www.aldiwan.net/poem12734.html","الكامل"],[433,"خذوا لقلبي أمانا من تجنيه","https://www.aldiwan.net/poem12768.html","البسيط"],[440,"عزم حداه السعد والإقبال","https://www.aldiwan.net/poem34802.html","الكامل"],[440,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[442,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[453,"ومجلس حفت الغصون بنا","https://www.aldiwan.net/poem13686.html","المنسرح"],[459,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[459,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[459,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[459,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[459,"طرف نجدية وطرف عراقي","https://www.aldiwan.net/poem56104.html","الخفيف"],[459,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[459,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[459,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[462,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[462,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[462,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[462,"وعلى الأيام من نعمائه","https://www.aldiwan.net/poem16075.html","الرمل"],[464,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[465,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[465,"نضت يد الشرق سيوف الصباح","https://www.aldiwan.net/poem3576.html","عموديه"],[469,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[469,"اليوم يا ذا الفخر والمجد","https://www.aldiwan.net/poem60223.html","السريع"],[469,"عرائس القضب تجلى","https://www.aldiwan.net/poem60417.html","المجتث"],[469,"قد نتج الجو جموحا أشهبا","https://www.aldiwan.net/poem60443.html","الرجز"],[494,"ومجلس حل من يحل به","https://www.aldiwan.net/poem67406.html","المنسرح"],[500,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[516,"يا من أدل يبسط العذر من جارا","https://www.aldiwan.net/poem12138.html","البسيط"],[541,"سلا القلب إلا من تذكر ليلة","https://www.aldiwan.net/poem56883.html","الطويل"],[552,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[552,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[552,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[552,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[552,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[552,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[554,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[559,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[559,"يا نسبة أدخلت سلمان في النسب","https://www.aldiwan.net/poem34930.html","البسيط"],[559,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[563,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[568,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[576,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[587,"ومجتمعين ما اجتمعا لإثم","https://www.aldiwan.net/poem17627.html","الوافر"]],"verses":[["ومجزعاً حيهم ندباً كما جزعت","في الطف صرعاهم العسلان والرخم",0,"م",1,0],["وَمُجَمِّرٍ لِلجَيشِ قَد","نَسِيَت ضَوامِرُهُ الجُموما",1,"م",2,0],["وَمُجَلِّلٌ يُندي يَدَيكَ كَأَنَّما","غَطّاهُ عُرفُ العارِضِ المُتَهَدِّلِ",2,"ل",1,0],["وَمُجاري الزَمانِ خَطباً فَخَطباً","سابِقاً خَطوَهُ وَصَرفاً فَصَرفا",3,"ف",2,0],["وَمَجلِسٍ ما أَظُنُّ الهَمَّ يَعرِفُهُ","يَنضو الكَرى عَن مَآقي شَربِهِ السَهَرُ",4,"ر",1,0],["وَمَجَرُّ أَرسانِ الجِيادِ لِغِلمَةٍ","سَجَفوا البُيوتَ بِشُقرِها وَوِرادِها",5,"د",3,0],["وَمَجادِلٍ أَدمى جَدالُكَ قَلبَهُ","وَأَعَضَّهُ بِجَوانِبِ الصَيخودِ",6,"د",1,0],["وَمَجاهِلُ الفَلَواتِ أَطيَبُ مَنزِلٍ","عِندي وَأَوفى الواعِدينَ نَجائِبُ",7,"ب",1,0],["وَمَجْنَى العِزِّ مِنْ بِيضٍ رِقاقٍ","وَسُمْرٍ تَخْلِسُ المُهَجاتِ لُدْنِ",8,"ن",1,0],["وَمَجْدٌ رَفيعُ الذُّرا دُونَهُ","لِطالِبِ شَأْوِيَ طَرْفٌ حَسيرُ",9,"ر",1,0],["ومَجْدٌ مُعَمٌّ في كِنانةَ مُخْوَلٌ","تَنوسُ حَوالَيْهِ ذَوائِبُ أنْجُمِ",10,"م",1,0],["ومَجدٌ مُعَمٌّ في العَشيرةِ مُخْوَلٌ","أحَلَّ أبا المِظْفارِ ذِرْوَتَهُ كِسْرُ",11,"ر",1,0],["وَمُجتَهِداتٍ في الفَسادِ حَواسِدٍ","لَها وَهيَ مِمّا قَد أَرَدنَ عَلى جَهلِ",12,"ل",1,0],["ومُجاذِبٍ ثِنْيَ الذّوابَةِ عابِثٍ","تهْفو بخُطوطَتهِ الصَّبا فيَميدُ",13,"د",1,0],["وَمُجَلَّدٌ بِالعَظمِ يَظ","هَرُ مِنهُ خافي أَمرِهِ",14,"ر",2,0],["وَمُجرٍ كَغَيلانِ الأُنَيعَمِ بالِغٍ","دِيارَ العَدُوِّ ذي زَهاءٍ وَأَركانِ",15,"ن",1,0],["وَمُجِدَّةٌ نَسَّأتُها فَتَكَمَّشَت","رَنَكَ النَعامَةِ في طَريقٍ حامِ",16,"م",1,0],["وَمَجهولَةٍ تَيهاءَ تُغضي عُيونُها","عَلى البُعدِ إِغضاءَ الدَوى غَيرِ نائِمِ",17,"م",1,0],["وَمَجدٍ قَد سَمَوتُ لَهُ رَفيعٍ","وَخَصمٍ قَد جَعَلَت لَهُ خَبالا",18,"ل",2,0],["ومجَّد ما للعُرب في الغرب من يدٍ","وما لبني العباس في الشرق من فخر",19,"ر",1,0],["وَمُجاشِعٌ فَضَحوا فَوارِسَ مالِكٍ","فَرَبا الخَزيرُ وَضُيِّعَ الأَدبارُ",20,"ر",1,0],["وَمَجهولٍ عَسَفنَ بِنا إِلَيكُم","قَصيرِ الظِلِّ مُشتَبِهِ الصَحاري",21,"ر",2,0],["وَمُجاشِعٌ قَصَبٌ هَوَت أَجوافُهُ","غَرّوا الزُبَيرَ فَأَيَّ جارٍ ضَيَّعوا",22,"ع",3,0],["وَمَجودٍ مِن صُباباتِ الكَرى","عاطِفِ النُمرُقِ صَدقِ المُبتَذَل",23,"ل",1,0],["وَمُجيبٌ دُعائَهُ إِن دَعاني","عَجِلاً واحِداً وَذا أَصحابِ",24,"ب",1,0],["وَمُجَدَّلٍ لا يَستَجيبُ لِدَعوَةٍ","حَتّى تَزولُ شَوامِخُ الأَعلامِ",25,"م",1,0],["ومجيب داعي الملك يومَ وغى","بكتائبٍ يُنعَتنَ بالكتب",26,"ب",1,0],["ومجمعٌ كنت فيه من ندًى وتقى","أحقُّ أن تتسمَّى بابن دينار",27,"ر",1,0],["ومجدّد العلم الذي شدّت له","للطالبين قدائم الأحلاس",28,"س",1,0],["ومجدٌ على الأنصار شفَّ سناؤه","وعلم لأدواء البصائر شاف",29,"ف",1,0],["ومجد يردّ السائدين به سدًى","وعلم يردّ المفصحين به لكنَا",30,"ن",2,0],["ومجردٍ كالسيف جَرَّد نفسه","لمجرّد يكسوه ما لا يُنسَجُ",31,"ج",1,1],["ومَجالسٍ لي لغوُها","عزفٌ يجاوبهُ زَميرُ",32,"ر",1,0],["ومجال الوشاح منها وثيرٌ","ومجال الخلْخال والحجل حَمشُ",33,"ش",1,0],["ومججت في أرحامهن مجاجة","أوجدتهن لها ألذ مذاق",34,"ق",1,0],["وَمَجلِسٍ دارَت بِهِ الأَكأُسُ","فَشَرِبَ القَومُ وَلَم تَشرَبي",35,"ي",1,0],["ومجداً يكون لنا في الخلود","أَكاليلَ من رائعاتِ الوُرودْ",36,"د",1,0],["وَمَجلِسِ الزَهراءِ في ال","حَظائِرِ المُنَوَّرَه",37,"ر",2,0],["وَمُجاهِدينَ هُناكَ عِندَ مُعَسكَرٍ","وَمِنَ المَهابَةِ بَينَ أَلفِ مُعَسكَرِ",38,"ر",1,0],["وَمُجِدٍّ فيهِ أَمسى خامِلاً","لَيسَ فيمَن غابَ أَو فيمَن حَضَر",39,"ر",1,0],["وَمَجدي يَدُلُّ بَني خِندِفٍ","عَلى أَنَّ كُلَّ كَريمٍ يَمانِ",40,"ن",1,0],["ومجدولةٍ جدلَ العنانِ بكفّها","عنانُ فؤادي في الهَوى وعِناني",41,"ن",2,0],["ومجلسُنا على ما فيه يُرمَى","بنُقصانٍ وأنتَ له تَمامُ",42,"م",1,0],["ومجالسٌ يُكْنَى الكلامُ بها","لِيناً وتُغْضِي دونَها المُقَلُ",43,"ل",1,0],["ومجدٌ أشمُّ بإقبالِكُمْ","فإن هوَ فارقكُمْ أجدَعُ",44,"ع",1,0],["وَمَجرٍ عَلى الأَوتارِ صَوتاً يُجاوِبُه","مُعَقرَبَةٌ أَصداغُهُ وَذَوائِبُه",45,"ب",2,1],["وَمَجدُ بَني دارِمٍ فَوقَهُ","مَكانَ السَماكَينِ وَالفَرقَدِ",46,"د",1,0],["وَمَجدٌ أَذودُ الناسَ أَن يَلحَقوا بِهِ","وَما أَحَدٌ أَو يَبلُغَ الشَمسَ نائِلُه",47,"ل",2,0],["ومجالُ النِّطاقِ حين تُجيل ال","طَرْفَ في جَنَّةٍ ومَجرى الوُشاحِ",48,"ح",1,0],["ومجرّدٍ كالنَّصلِ أسلْمَ نفسَه","لمجرَّدٍ يكسوه ما لا ينسُجُ",49,"ج",1,1],["ومجلِسُنا على شَرَفٍ","بحُجْبِ الغيمِ مُحتَجِبُ",50,"ب",1,0],["ومَجلِسٌ أُسبِلَتْ ستائرُه","على شُموسِ البَهاءِ والحَسَبِ",51,"ب",1,0],["ومَجدولَةٍ جَدْلَ العِنانِ منحتُها","عِناني فأضحَتْ رِحلةُ الهجرِ دابَها",52,"ب",3,0],["وَمَجلِسُنا بِهِ ساقٍ صَغيرٌ","يُحَيّينا بِأَقداحٍ كِبارِ",53,"ر",1,0],["وَمُجَلّي الكُروبِ عَن سَيِّدِ الرُس","لِ بِبَدرٍ وَخَيبَرٍ وَحُنَينِ",54,"ن",1,0],["وَمَجلِسُنا الأَنيقُ تُضيءُ فيهِ","أَواني الراحِ مِن وَرَقٍ وَعَينِ",55,"ن",1,0],["وَمُجَلّي لَبسَ الأُمورِ إِذا بَر","قَعَ قُبحُ الخَطا وُجوهَ الصَوابِ",56,"ب",1,0],["وَمَجلِسِ لَذَّةٍ أَمسى دُجاهُ","يُضيءُ كَأَنَّهُ صُبحٌ مُنيرُ",57,"ر",1,1],["ومجلس قد ضمنا في الرخام","رف على قلبين فيه السلام",58,"م",1,0],["وَمُجَرّرٍ في الأرضِ ذيلَ عسيبِهِ","حَميلَ الزبَرجَدَ منه جِسمُ عَقيق",59,"ق",1,1],["وَمُجَلْجِلٍ دَرّتْ بأنفاسِ الصّبا","وهناً لقَضْباءِ النباتِ ضروعُهُ",60,"ع",2,0],["ومَجموعةٌ جمع الثلاثِ ولم تَزِدْ","عليه صوالي النار أَوجُهها سفعُ",61,"ع",1,0],["ومُجاجَةٍ شَهْدِيّةٍ","تُجْنى من البَرَدِ البَرُودِ",62,"د",1,0],["ومجوَّفٌ لم تُحْنَ أضلُعُهُ على","قلبٍ وقلبُك نحوه مُرْتاحُ",63,"ح",1,0],["ومجدَّلٌ شاكي السّلاحِ من الصِّبا","من لم يُبَقّ له المشيبُ سِلاحا",64,"ح",2,0],["وَمَجدٌ لَم يَدَعهُ الجودُ حَتّى","أَقامَ مُناوِئاً لِلفَرقَدَينِ",65,"ن",1,0],["وَمُجفَرٌ لَم يُصطَلَم كَشحُهُ","فَالضُمُرُ المُفرِطُ فيها رَسيس",66,"س",1,0],["وَمُجَرِّبونَ سَقاهُمُ مِن بَأسِهِ","فَإِذا لُقوا فَكَأَنَّهُم أَغمارُ",67,"ر",1,0],["وَمَجهولَةِ الأَعلامِ طامِسَةِ الصَوى","إِذا اِعتَسَفَتها العيسُ بِالرَكبِ ضَلَّتِ",68,"ت",1,0],["ومُجْمِعينَ تَواصَوا بَينَهُمْ شَرَعاً","على الحفَاظِ، وساوَوْا أمرَهُم طَبَقا",69,"ق",2,0],["وَمَجلِسي لَيلَةَ الخَميسِ لَدى ال","خَيماتِ بَينَ التِلاعِ وَالحُصُنِ",70,"ن",1,0],["وَمَجلِسَ النِسوَةِ بَعدَ الكَرى","أَمِنَّ فيهِ الأَبطَحَ الأَسهَلا",71,"ل",2,0],["وَمَجَرِّ ذَيلِ غَمامَةٍ قَد نَمَّقَت","وَشِيَ الرَبيعِ بِهِ يَدُ الأَنواءِ",72,"ا",2,1],["وَمَجَرِّ ذَيلِ غَمامَةٍ لَبِسَت بِهِ","وَشيَ الحَبابِ مَعاطِفُ الأَنهارِ",73,"ر",1,0],["وَمَجالُ حَربٍ جَرَّ فيهِ لامَةً","قَد قامَ مِنها في غَديرٍ حامِسِ",74,"س",1,0],["وَمَجلِسِ أَربَعٍ يَشكِينَ لَيلاً","إِلَيَّ مِنَ الصَبابَةِ ما لَقِينا",75,"ن",2,0],["وَمَجلِسِ خَمسٍ بِهِ مَوهِناً","تَواعَدنهُ إِذ أَرَدنَ اِجتِماعا",76,"ع",2,0],["وَمَجلِسُ النُسوَةِ بَعدَ الكَرى","في رَوضَةٍ ذاتِ أَقاحٍ نَد",77,"د",1,0],["وَمَجدٍ لِأَقوامٍ شَآهُم طَلَبتَهُ","بِنَفسِ كَريمٍ صَونُها وَاِبتِذالُها",78,"ل",3,0],["وَمَجنونٌ يُخَلَّصُ بَعدَ حَبسٍ","وَأَقيادٍ وَسِلسِلَةٍ وَفُلِّ",79,"ل",1,0],["وَمَجلِسٍ جَلَّ أَن نُشَبِّهَهُ","حَيثُ بِهِ مِزهَرٌ وَمِزمارُ",80,"ر",1,0],["ومُجَدَّلاً فوْقَ الثَّرَى ونَجيعُهُ","والرّوحُ من وَدَجَيهِ مُختَلطانِ",81,"ن",1,0],["وَمُجريهِنَّ ساقٍ يَب","عَثُ الإِبريقَ وَالطاسا",82,"س",2,0],["وَمَجلِسِ خَمّارٍ إِلى جَنبِ حانَةٍ","بِقُطرَبَّلٍ بَينَ الجِنانِ الحَدائِقِ",83,"ق",1,1],["وَمَجلِسٍ ما لَهُ شَبيهٌ","حَلَّ بِهِ الحُسنُ وَالجَمالُ",84,"ل",1,1],["وَمَجلِسِ فِتيَةٍ طابوا وَطابَت","مَجالِسُهُم وَطابَ بِها النَعيمُ",85,"م",1,0],["ومجلسُ لذّةٍ بسماع لهوٍ","ألذُّ من الجلوس على الطريق",86,"ق",1,0],["وَمَجلِسِ خَمسٍ قَد تَرَكتُ لِحُبِّها","وَهُنَّ كَزَهرِ الرَوضِ أَو لُؤلُؤِ السَردِ",87,"د",1,0],["وَمَجِنتَ حَتّى ما تُصَلّي رَكعَةً","وَنَسيتَ ما قالَ النَبِيُّ مُحَمَّدُ",88,"د",1,0],["ومَجْدُهُ أفعالُهُ لا الذي","من قَبْلِهِ كانَ ولا بَعْدِهِ",89,"د",2,0],["ومَجُودٍ قَد اسجَهَرَّ تَنَاوِي","رَ كَلونِ العُهونِ في الأَعلاقِ",90,"ق",1,1],["ومَجُودٍ زَعَلٍ ظِلمانُهُ","كَرِجالِ الَحبشِ تَردي بالعَمَد",91,"د",1,0],["وَمَجَالُ رَأْيٍ فِي الغَوَامِضِ مُبْصِرٍ","مَعْلُومُهُ يَتَصَيِّدُ المَجْهُولاَ",92,"ل",2,0],["وَمُجَدَّدٍ كَالدُّرِّ يُبْدَلُ صَوْغُهُ","فَتَخَالُهُ عَيْنُ الخَبِيرِ قَشِيبَا",93,"ب",2,0],["وَمَجَالِي الأَفْراحِ لَوْ صَوَّرَتْهَا","لَمْ تَزِدْهَا قَرَائِحُ الشُّعَرَاءِ",94,"ا",2,0],["وَمَجَالاَتِ العُلَى شَتَّى فَفِي","كُلِّهَا مِصْرُ تُحَيِّي النُّبَهَاءْ",95,"ا",2,0],["ومُجْنِي الْحِسِّ ما أَجْنَى","وَمُرْضِي النَّفْسِ ما أَرْضَى",96