{"poems":[[74,"مسموع لفظك في القلوب ممكن","https://www.aldiwan.net/poem19159.html","الكامل"],[53,"ورياض تخايل الأرض فيها","https://www.aldiwan.net/poem61829.html","الخفيف"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[53,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[94,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[63,"لو شئت نهنهت من الدمع","https://www.aldiwan.net/poem51354.html","السريع"],[50,"قد أغتدي والطير في مثواتها","https://www.aldiwan.net/poem62480.html","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[124,"غشى الأرض في شباب الزمان","https://www.aldiwan.net/poem49332.html","الخفيف"],[190,"لي صديق من بني ال","https://www.aldiwan.net/poem43342.html","مجزوء الرمل"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[415,"ما استجهلتك معالم ورسوم","https://www.aldiwan.net/poem32386.html","الكامل"],[438,"قولوا لنجم الدين بل بدره","https://www.aldiwan.net/poem12649.html","السريع"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[466,"مسمهر البأس من مضر","https://www.aldiwan.net/poem15686.html","المديد"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122765","الطويل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139044",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64232","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119993","المجتث"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31574","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123709","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48264","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48239","الوافر"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83209","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93372","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132656","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205608","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216475","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85136","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66590","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97104","البسيط"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105528","الخفيف"],[4830,"ياجوهرَ الأقداس","https://www.poetsgate.com/ViewPoem.aspx?id=211350",""],[4978,"حذوة الفرس","https://www.poetsgate.com/ViewPoem.aspx?id=211980",""],[5055,"مصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=105167",""],[5277,"أملٌ لَحوح","https://www.poetsgate.com/ViewPoem.aspx?id=191905",""],[5386,"بين ضلوعنا","https://www.poetsgate.com/ViewPoem.aspx?id=35004",""],[5480,"مذبوح","https://www.poetsgate.com/ViewPoem.aspx?id=9890",""]],"verses":[["مسموع لفظك في القلوب ممكَّنٌ","في الحبِّ فوقَ تمكُّن الملحوظ",0,"ظ",1,1],["مَسْمَعٌ مُطرِب إذا شئت مُلْهٍ","لك عن كل طارف وتلادِ",1,"د",1,0],["مسمّىً بأسماءٍ فمنهن ضيغم","ومنهن ضرغام ومنهن قَسْور",2,"ر",1,0],["مسمومةُ الريق إذا قُبّلت","صَحَّفت التقبيل تقتيلا",3,"ل",2,0],["مَسْمعُ معروفه ومنظرُهُ","يكفيك فاقنع ولا تَمُتْ نَهَما",4,"م",2,0],["مَسْمَعَ القَبْرِ بغَصَّاتِ","نَحِيبي وشُجُوني",5,"ي",1,0],["مسمعة لم تحظ من حبها","بلذة العين ولا السمع",6,"ع",1,0],["مُسَمَّياتٍ وَمُلَقَّباتِها","قودَ الخَراطيمِ مُخَرطَماتِها",7,"ت",3,0],["مَسْمُوعَةُ الإِيقَاعِ في أَقْصَى مَدًى","جَذْلَى بِمَا تُهْدِي مِنَ الآلاَءِ",8,"ا",2,0],["مَسَّ مِنْهُ السَّوَادَ فَانْبَجَسَتْ نَا","رٌ وَنُورٌ مِنْ طَيِّ ذَاكَ السَّوَادِ",9,"د",1,0],["مُسْمِعاً سُمَّارَهَا مِزهَرَهُ","عَارِضاً تَمْثِيلَهُ بَطْناً وَظَهْرَا",10,"ر",2,0],["مسمع معجب ولكنه الآل","تراءى للأغب الظمآن",11,"ن",1,0],["مسمنُ الجثن قد","رثت من الخير حباله",12,"ل",2,0],["مسمياً لها بتقديم على","منوها بالاسم قدرها العلى",13,"ل",2,0],["مسماه كل الكائنات جميعها","من الكلب والخنزير والقرد والفهد",14,"د",1,0],["مَسْمُولَةً بمَدَامعٍ حالَت دماً","فكأنّما إنسانُها مَكلُومُ",15,"م",1,0],["مسٌّ من الدهرِ فهل ذو ندًى","يَشفيهِ بالإحسانِ من مسّهِ",16,"س",2,0],["مُسَمَّىً بفَتحِ اللهِ أَرْضَ العِدى بِهِ","مُكَنَّى بنَصرِ اللهِ والدِّينِ والرَّبِّ",17,"ب",1,0],["مُسْمَهِرُّ البأسِ مِنْ مُضَرٍ","يقْشعرُّ الموتُ مِن حَذَرِهْ",18,"ر",2,1],["مسمى له قد طابق الإسم حيث سا","رت الفته حتى بدت متواخيّه",19,"ي",2,0],["مَُسَّمَةٌ عَيني وَقَلبِي بِحُبِّها","وَهِجرانِها في جَنَّةٍ وَجَهنَّمِ",20,"م",1,0],["مسمع غنا فأغنا","بصفات الحسن ذات",21,"ت",1,0],["مسمعٌ يودع المسامع ما","شاءتْ وما لم تشأ من الألحان",22,"ن",1,0],["مُسمسرُ في دكاكي","ينه تباعُ الفروجُ",23,"ج",1,0],["مَسْمُوعَةٌ كَأَنَّهَا إِحْدَى السِلَقْ","لَوْ صُحِنَتْ حَوْلاً وَحَوْلاً لَمْ تَفِقْ",24,"ق",1,0],["مِسْمار تِبْرٍ أَصْفَرٍ رَكَّبتَه","في فَصِّ خَاتِمِ فِضَّةٍ فَيْروزَجِ",25,"ج",1,0],["مسَّ منه مناكباً لك مسَّت","ه وأخلق عنه بها أن تنوبا",26,"ب",2,0],["مسمى فيه تفريح لروح","ويهدي وصفه بعض الحواس",27,"س",1,0],["مسمعٌ رائقٌ ومرْأىً جميلٌ","من محيّاً ولفظُ صوتٍ رخيمِ",28,"م",1,0],["مُسَمِّلِ أعينِ الأعْدا إِذا ما","تعنَّقت الظُّبا السُّمْرُ الزِّجاجا",29,"ج",2,0],["مِسمارُها هُوَ عَقلُها","حَمّالُها كَالقُعدُدِ",30,"د",1,0],["مُسمِعَةٌ مِن غَيرِ أَوتَارِ","إِلا اِرتِجالاً فَوقَ أَشجارِ",31,"ر",1,1],["مسمعة تطرب الحانها","لكنها ليست بسماعه",32,"ع",2,1],["مسمح النفس في الحياة تولى","مسمح النفس في الردى قبل آنِهْ",33,"ن",2,0],["مسمع العالم في عاصمة","تسبح الدنيا إليها وتطير",34,"ر",1,0],["مسمعي في المنابذ كراك لكن","شرفوا ناظري بأنس اقتراب",35,"ب",1,0],["مِسْمِعٌ كلَّ عَنْ كَلامِ عَذُولِي","حِينَ أَلْقَى عَلَيْهِ قَوْلاً ثَقِيلاَ",36,"ل",2,0],["مسمط كثغور الحور باسمةً","عليه بالنور روح القدس قد مسحا",37,"ح",2,0],["مسمع إذن واحد همس ثان","وهو عنه أنأى من الغرار",38,"ر",1,0],["مِسمارُ بابٍ أو حوافرُ خيلهِ","ضلعين من صَدرِ الرسالةِ هَشّما",39,"م",2,0],["مسمارُ ضِعتَ فضاعت حذوة الفرس","فلم تسر نحو ساح الحرب في الغلس",40,"س",1,1],["مسمار تفكيرنا ما زال مفتَقَداً","وليس من فارسٍ فينا ولا فرسِ",40,"س",1,0],["مسمعك يا صاحبي زاد ختلافه","دام تسمعها لسان الفاجريه",41,"ي",2,0],["مسٌّ من الذكرى يهزُّ خوالجي","ويعيدني لسوابقِ الحدثانِ",42,"ن",1,1],["مسموح يا كل الغلا .. تمشي وأنا أسمع خطاك","تمشي بعيد وتنتهي ........ سلطان بين ضلوعنا",43,"ن",2,0],["مسموح يللي حبه القلب.. مسموح","خذها حياتي واترك الحب سوّاح",44,"ح",1,0]]}