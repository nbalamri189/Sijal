87",""],[709,"ويا وميضَ بروقِ المزنِ إنْ سفرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=2956",""],[5538,"الأنس حل فزالت الأتراح","https://www.poetsgate.com/ViewPoem.aspx?id=142644",""],[5685,"في رثاء زايد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34735",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[5720,"جبلُ الأنيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=200359",""],[5770,"رثاء الشهيد فيصل الحسيني","https://www.poetsgate.com/ViewPoem.aspx?id=178701",""],[5829,"رياضُ الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=212095",""],[1920,"الدوحة","https://www.poetsgate.com/ViewPoem.aspx?id=199884",""],[5956,"في مكتب صهري الأكرم مصطفى عبسي","https://www.poetsgate.com/ViewPoem.aspx?id=210300",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6213,"الناس أسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76273&r=&rc=30",""]],"verses":[["هَذا الإِمامُ يَذودُني عَن وَجهِه","وَيَسومُني لُقيا ذَوي الشَنآنِ",0,"ن",1,0],["هَذا الأَمينُ أَدالَ مِنهُ شَقيقُهُ","وَمَضى عَقيراً بِاِبنِهِ المُتَوَكِّلُ",1,"ل",1,0],["هَذَا الأَمِينُ وَغَيْرُ بَعْ","ثِ الشَّرْقِ لَيْسَ لَهُ أَمَانِي",2,"ن",2,0],["هَذا الأَسيرُ المُبَقّى لافِداءَ لَهُ","يَفديكَ بِالنَفسِ وَالأَهلينِ وَالوَلَدِ",3,"د",1,0],["هذا الأميرُ أَتَتْهُ وهْو في كَنَفٍ","كاللَّيْل من عُدَدٍ ما شئْتَ أو عَدَدِ",4,"د",1,0],["هَذا الأَديمُ كِتابٌ لا كِفاءَ لَهُ","رَثُّ الصَحائِفِ باقٍ مِنهُ عُنوانُ",5,"ن",1,0],["هَذا الأَمينُ بِحائِطَيكِ مُطَوِّفاً","مُتَقَدِّمَ الحُجّاجِ وَالوُفّادِ",6,"د",1,0],["هَذا الأَديمُ يَصُدُّ عَن حُضّارِهِ","وَيَنامُ مِلءَ الجَفنِ عَن غُيّابِهِ",7,"ب",2,0],["هذا الأديبُ برُغمِ أهلِ بلادِه","والشاعرُ الداعي إلى سُنَنِ العُلا",8,"ل",2,0],["هذا الأجمّ رَمَتْهُ حَمّةٌ بشبا","عزمٍ أباحَ حِماهُ فهو مُهتَضمُ",9,"م",1,0],["هذا الأغَرُّ الأزْهَرُ المتألّقُ ال","متَدَفِّقُ المُتَبَلِّجُ الوَضّاء",10,"ا",2,0],["هَذا الأَنامُ لَهُ شَأنٌ يُرادُ بِهِ","وَأَنتَ غَيري وَلَيسَ الأَريُ كَالهَنَمِ",11,"م",1,0],["هذا الأسير المبقى لا فداء لها","يفديك بالنفس والأهلين والولد",12,"د",1,0],["هذا الأديم شمائل غرّ وأحلام عذاب","وأمومة وطفولة ورؤى كما عبر الشهاب",13,"ب",1,0],["هذا الأديم أبي وأمّي والبداية والمآب","ووسائدي وقلائدي ودمى الطّفولة والسخاب",13,"ب",1,0],["هذا الإمامُ إمامُ عد","ل بالمآثر يشتهرْ",14,"ر",1,0],["هذا الإمامُ لكمْ نَذ","يرٌ مِن عذابٍ مستعِرْ",14,"ر",1,0],["هذا الإِمام وكلُّ باغ راغم","هذا السعيد وكُلِّ غادٍ جاهد",15,"د",1,0],["هذا الإمام إمامي حاضرٌ بادِي","فاليومَ أشرفُ أيامي وأعيادي",16,"د",2,1],["هذا الأمير ابن يزدادَ الذي ملأت","آثارُه وأياديه الأقاليما",17,"م",2,0],["هذا الأَميرُ وَقاه اللهُ قدوَتنا","أمسى من الحب مطوياً عَلَى ضرم",18,"م",1,0],["هذا الأسير طليق العمر ذا عجباً","فهل رأيت أسيراً غير معتَقل",19,"ل",1,0],["هذا الإله الذي بالصلب أنقذكم","أسقيتموه مياه الصبر والغث",20,"ث",1,0],["هذا الإِمام شهاب الدِّين ثاقبه","أزال في نور صبح الحقِّ ديجورا",21,"ر",2,0],["هذا الإِمامُ الأعظم الفرد الذي","آثاره تبقى وتفنى الأَعصر",22,"ر",1,0],["هذا الأمير الذي العليا به ابتهجت","حتى هناءً بعلياه تهادينا",23,"ن",2,0],["هذا الإمام ابن الإمام المغتني","عن نعت ناعته وعن تلقيب",24,"ب",1,0],["هذا الابى التونسي","هذا هو الوطني الممجد",25,"د",1,1],["هذا الإِمامُ أَبو عليٍّ أَحمدٌ","قُطبٌ يَقومُ له الفَخارُ ويقْعُدُ",26,"د",1,0],["هذا الأُبَيرِقُ في فِيها فَيا ظمئي","إلى عُذَيبِ عَقيق المَبسمِ العَطِرِ",27,"ر",1,0],["هذا الأثير غدا بها متعلقاً","فجرى له من عفوك الإيثار",28,"ر",1,0],["هذا الإقبال منك والإعراضُ","يا من يلهو وهذه الأغراضُ",29,"ض",1,1],["هذا الأميرُ مُرادُ اللَّمعِ قُبَّتُهُ","كالبُرجِ مِنْ فَلَكٍ أمسَى بهِ القَمَرُ",30,"ر",1,1],["هذا الأميرُ الشِّهابِيُّ بعدَ فُرقتِهِ","طالت ليالي أبيهِ يُوسُفَ السُّودُ",31,"د",1,1],["هذا الأميرُ السَّعيدُ الحظِّ تَخدِمُهُ","مَلائكُ اللهِ حولَ العرشِ تجتمعُ",32,"ع",1,1],["هذا الأميرُ الشِّهابِيُّ الذي يدُهُ","تحمي الدِّيارَ وتُمحَى عندَها الفِتَنُ",33,"ن",1,0],["هذا الأمينُ مَضى فقامَ محمُّدٌ","خَلَفاً فنابَ عن الأمينِ مُحمَّدُ",34,"د",1,0],["هذا الأميرُ أمينُ اللهِ مُضطَجِعٌ","في طَيِّ رَمسٍ منَ الأبراجِ محسودِ",35,"د",1,0],["هذا الأميرُ الذي للأمرِ في يَدِهِ","أزِمَّةٌ ولعُنقِ الدَّهرِ أرسانُ",36,"ن",1,0],["هذا الأمينُ الذي لُبنانُ في يَدِهِ","أمانةُ اللهِ يَرعاها كما وَجبَا",37,"ب",2,0],["هذا الأميرُ قَضَى فسالَتْ أكبُدٌ","ومَدامعٌ وجَرَى القَضاءُ بما جَرَى",38,"ر",2,0],["هَذا الإِمامُ الَّذي طابَت مَخابِرُهُ","وَطابَ نَفساً وَأَغصاناً وَأَوراقا",39,"ق",2,0],["هذا الأمير فعاله شهدت له","والفعل خير من ألوف شهود",40,"د",1,0],["هذا الأمير عليه نعمة ربه","سبغت تقول هنا الجدير بما وهب",41,"ب",1,0],["هذا الإمام المُرتجى","لكلّ أمرٍ معسرِ",42,"ر",1,0],["هَذا الأميرُ الَّذي أدنَى مَواهِبِهِ","لِسائِليهِ جيادُ الخَيلِ والخِلَعُ",43,"ع",1,0],["هذا الإمامُ الذي إليهِ","أسندَ خيرُ الورى الوصيَّهْ",44,"ي",2,1],["هذا الأميرُ الذي أَجرى الدُمُوع دماً","من آل لَمعٍ سليلُ المجدِ والجودِ",45,"د",1,1],["هَذا الأَميرُ شِهاب المَجدِ كَوكبهُ","بَدا بِأَوجِ العُلى تَزهو مَعاليهِ",46,"ي",2,0],["هَذا الأَديب البارع الفَرد الَّذي","خَضَعتَ لَهُ الشُعَراء تَهديهِ الثَنا",47,"ن",2,0],["هَذا الأَصيل فَاسقنيها وَاِشرب","فَالشمس قَد جنحت لأُفق المَغرب",48,"ب",1,1],["هذا الإخاءُ بنا شُدّت أواصرهُ","تقسّمتهُ قلوب فهو أشطارُ",49,"ر",1,0],["هَذَا الأتَايُ رَقِيقُ اللَّونِ في انكَاسِ","يَشفي القُلُوبِ بِتَطرِيبٍ وإِينَاسِ",50,"س",1,1],["هذا الأميرُ الذي تُغنيكَ شهرتُهُ","عن ذكرِه في بلادِ العُجمِ والعَرَبِ",51,"ب",1,1],["هذا الأتيُّ لذاك المزنِ منتسبٌ","عاري الأديمِ من الأقذاء والزبد",52,"د",1,0],["هذا الأساس فأسسوا بنيانكم","فعلى الأساس تشيد الأعلاء",53,"ا",2,0],["هذا الإمام العابد الحرّ الذكي","ي الزاهد البر الرؤوف المشفق",54,"ق",1,0],["هذا الأمير أتاكم فافرحوا وثقوا","بأنه خير من يلقى بأقداح",55,"ح",1,1],["هذا الأزَج الأدعج الطرَف الكَحيلُ","الأبيضُ اللونِ الأغَرُّ الأزهرُ",56,"ر",1,0],["هذا الأراك فلذاك مرتع عِينِه","فاحبس ورِد ما شئت غيرَ مَعِينِه",57,"ن",2,1],["هذا الأمير أبو الغارات راشك يا","لأيدي الجسام وبالأيدي من النعم",58,"م",1,0],["هذا الإِمام حُسَيْنٌ العَلَمُ الذي","نظم التُّقَى والعلمَ أيّ نظام",59,"م",1,0],["هذا الامير الخطير المعتلي شرفا","سليل خير الأنام المصطفى المضري",60,"ر",2,0],["هذا الأمير أمير المؤمنين فإنْ","تزهو المنابرُ أو يرقُصْن لا جرمُ",61,"م",1,0],["هذا الإمامُ وذا السيف الحسامُ وذا","الليثُ الهُمامُ إذا مَا أعيت الهمَمُ",61,"م",1,0],["هذا الإمام الَّذي إِن فاه مِقوَلُه","أَعطى إِلَيهِ الزَمان السَمع وَالبَصَرا",62,"ر",2,0],["هذا الأتايُ علا صِناعةً وعلا","بل طابَ لذ زها بِمَن لَهُ صُنِعَا",63,"ع",2,1],["هذا الإمام اللوذعي الأسد الذي","وقت الهزاهز لا يخاف أهوالها",64,"ل",3,0],["هذا الأصَحُّ عَن نَوَاخِيذِ البَلَد","ووصَفُهَا فَخُذهُ عنِّي بالسَّنَد",65,"د",1,0],["هذا الأفق المبين قد لاح لديك","فاسجد متذللاً وعفر خديك",66,"ك",1,1],["هذا الإمام محمد قطب الشري","عة والحقيقة ظاهر النفحات",67,"ت",1,0],["هذا الأمير وذا الكبير وآخر","رب الفصاحة والبيان الساحر",68,"ر",1,0],["هذا الامام العارف القطب الذي","بركاته فياضة للزائر",69,"ر",1,0],["هذا الإمام الذي لا ريب فيه هدىً","ابن الإمام الذي في الدين محييه",70,"ي",2,0],["هذا الأفنديُّ الكبي","ر تلوح لي فيه الكبائرْ",71,"ر",1,1],["هَذا الإِمام ومن أُصيب برشدهِ","لا يَدرِ ما فضل الإِمام المرشدِ",72,"د",1,0],["هذا الاِريج مِن الاِزهارِ قَد عبقا","يَلذ بِالريحِ مِنهُ كُل من نَشقا",73,"ق",2,1],["هذا الاميرُ هو الَّذي بَينَ الوَرى","قَد طَوَّقَ الاِعناق مِنهُ بِالمِنَن",74,"ن",1,0],["هذا الامير هو الَّذي بِفِعاله","حازَ المَعالي رُغم أَنف الحسد",75,"د",1,0],["هذا الأبي إذا أريد إباءةٌ","هذا الكريم إذا أريد سماح",76,"ح",1,0],["هذا الأمينُ الصادقُ الحقُّ الذي","هو كِلمة الآب الوحيدُ المُجتَبى",77,"ا",1,0],["هذا الإمام محمد الجودي الذي","صان العلوم وحرمة الأيتام",78,"م",1,0],["هذا الأبي وسائلوا بإبائه","محناً يذيب أخفها الأكبادا",79,"د",2,0],["هذا الإِلهيُّ الّذي فِي يَوْمِهِ","يُنْبِيكَ قَبْلَ غِدٍ بِما هُوَ آتِ",80,"ت",1,0],["هذا الإمام الذي حلت مناقبه","فلست أحصرها عدا وتبيانا",81,"ن",2,0],["هذا الإمام إمام الفضل قاطبة","الشافعيّ على ما قلت برهان",82,"ن",1,0],["هذا الإمام له في كل معترك","من الشريعة تحقيق وتبيان",82,"ن",1,0],["هذا الإمام الشافعي البحر الخضم","هذا ابن عم المصطفى خير الأمم",83,"م",1,1],["هذا الإمام إمام الفضل أجمعه","الشافعيّ سديد الراي والقال",84,"ل",1,0],["هذا الإمام به الأمثال قد ضربت","في الفضل حتى بها الركبان قد ساروا",85,"ر",3,0],["هذا الإمام إمام الفضل من صغر","بعلمه ضربت في الناس أمثال",86,"ل",1,0],["هذا الإمام ببابه عنت الملو","ك مهابة لجلاله وتخوفا",87,"ف",2,0],["هذا الإمام الشافعي كنز الكرم","هذا ابن إدريس الإمام المحترم",88,"م",1,1],["هذا الإمام عريض الجاه للجار","فاشرب على ظمأ من ورده الجاري",89,"ر",2,1],["هذا الإمام همام لا يضارعه","بعد النبي وآل البيت موجود",90,"د",1,0],["هذا الأديبُ فلا مالٌ ولا نشبُ","لا كان عهدك عهداً أيها الأدبُ",91,"ب",1,1],["هذا الإمام الذي ترضى حكومته","خلاف ما قاله النحوي في الصحف",92,"ف",1,0],["هذا الأمير الشبل خير معظم","زمر الملوك العز تحت ركابه",93,"ب",2,1],["هذا الازار يحط عن زوَّاره","وزر به رضوى ينوء ويذبل",94,"ل",1,0],["هذا الامن مادام نايف وزيره","ماهوب متزعزع ووالله تبطون",95,"ن",1,0],["هذا الامام الهمام الحبر جسر ولا","محمد الفعل كشاف لاذماء",96,"ا",2,0],["هذا الإمامُ صَلاتُهُ تتكلّمُ","في غيْهبِ السّجانِ إذْ سكتَ الْفمُ",97,"م",1,1],["هَذّا الأَثِيرُ الّذِي يَجْرِي بِأَوْعِيَتِي","سُلَافَةٌ أَسْكَرَتْ حِسِّي عَلَى نَفْسِي",98,"س",2,0],["هذا الإمام ومن إمامٌ غيره","هذا هو البنّاء والبنيان",99,"ن",1,0],["هَذَا الأَبِيُّ تُرَى ، هَلْ كُنُت أَنسَاهُ ؟","ورُوحُهُ فِي دَمِي ، والقَلبُ سُكنَاهُ",100,"ا",2,1],["هذا الإمامُ المُصلحُ العوجَ الذي","آلى هدى الإصلاحِ في إيلائِهِ",101,"ا",3,0],["هذا الإمامُ أميرُ القومِ عائِلُهم","من بحرِه عُصبةُ الألبابِ تَمتَخِرُ",102,"ر",1,0],["هذا الإله محيّرٌ","ثلثاه يمتحنانه",103,"ن",2,0],["هذا الأغرّ الصلْفُ تكرهه","كره القصيد البكر معناه !!",104,"ا",2,0],["هذا الإله الذي خوفا تخرّ له","لولا انبطاحك يا (...) ماكان قد وجدا",105,"د",2,0],["هذَا الأُبَيْرقُ في فِيْهَا فَيَا ظَمَاءِي","إلى عذيبِ عقيقِ المبسمِ العطرِ",106,"ر",1,0],["هذا الأديب حسين أحمد من زهت","بجبينه في عصرنا الأفراح",107,"ح",1,0],["هذا الأمير الذي نهيان ُ مَحْتِدُه","فاق الكرام فلا عُرْب ٌ ولا عَجَم",108,"م",1,0],["هذا الإمام لكل مفضال وكم","عزت بوطأَتِه رؤوس منابرِ",109,"ر",1,0],["هذا الأمير أبو المعالي والنهى","الطاهر ابن الطاهر ابن الطاهرِ",109,"ر",1,0],["هذا الأمين الذي أخلاقه اشتهرت","بالفضل والعدل والإحسان والجودِ",110,"د",1,0],["هذا (الأنيُّ) .. وتلكَ قِصْتُنا","فاضتْ على أرجائنا عِطْرا",111,"ر",2,0],["هذا الأبرّ ابن الأبرّ بأمه","هذا الشهيد ابن الشهيد الأنبل",112,"ل",1,0],["هذا الأجاصُ وقد تدلى متعةً","للناظرينَ مزركشَ الألوانِ",113,"ن",1,0],["هذا الأمان وأفراحٌ تحيط به","هذا الربيع وماء الحبّ ينضحُهُ",114,"ح",2,0],["هذا الأعزُّ على نفسي من الأممِ","هذا المُحسُّ بنا في العزِّ والسَّقمِ",115,"م",1,0],["هذا الإمامٌ عظيمٌ في مكانته","وعمق علمهِ في الكيمياء والجودِ",116,"د",1,0],["هذا الإمامُ الهُمام اْبنُ الفراهيدي","كان امتزاجَ جنان الخلدِ بالبيدِ",116,"د",1,0],["هذا الأثير يغني فوق مجلسنا","القلب منطلق والعمر أوتار",117,"ر",1,0]]}