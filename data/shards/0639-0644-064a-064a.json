{"poems":[[72,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[72,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[72,"أمستنقذي باللطف من قبضة الردى","https://www.aldiwan.net/poem19397.html","الطويل"],[72,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[105,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[52,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[76,"وحاملة راحا على راحة اليد","https://www.aldiwan.net/poem39334.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55174","السريع"],[143,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[183,"على يوسف الفياض فاضت مسرة","https://www.aldiwan.net/poem67009.html","الطويل"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[238,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[283,"هلموا اسمعوا أحجية أبت النقصا","https://www.aldiwan.net/poem32725.html","الطويل"],[365,"تظلم من طرف ظبي رخييم","https://www.aldiwan.net/poem60647.html","المتقارب"],[365,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[367,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[418,"صديق قال لي لما رآني","https://www.aldiwan.net/poem4102.html","الوافر"],[433,"وأشعث مثل أهل النار ثاو","https://www.aldiwan.net/poem12750.html","الوافر"],[450,"هو الدين","https://www.aldiwan.net/poem977.html",""],[450,"كنوز الحب","https://www.aldiwan.net/poem988.html",""],[459,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[459,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[459,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[516,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[564,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[576,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"]],"verses":[["عليَّ يمينُ لا سلوت مهفهفاً","ولا بتُّ في رمَّان صدرٍ مفرّطا",0,"ط",2,0],["على يدِه البيضاء آي يراعةٍ","ينعم جانيها ويشقى لسيعها",1,"ع",3,0],["على يدِ مولانا نشا العمر ثانياً","فلا غَرْوَ أن يُنشا على يدِهِ الرزق",2,"ق",1,0],["عليّ يا ذا الفقار من قلمٍ","يقدّ قد العادي بأرغامه",3,"م",2,0],["على يدِ الزائر منهم زاده","من كلِّ باز قرم فؤاده",4,"ه",1,0],["على يدِهِ وَنِلْتَ به المُرادا","أفادَكَ يا ابن حربٍ ما أفادا",5,"د",2,0],["عَليٌّ يَظِنّونَ بي بُغضَهُ","فَهَلّا سِوى الكُفرِ ظَنّوهُ بي",6,"ب",2,0],["على ياسَمينٍ كاللُّجينِ ونَرْجِسٍ","كأَقْراطِ دُرٍّ في قَضيبِ زَبَرْجَدِ",7,"د",1,0],["عَلِيٌّ يَا زَيْنَ شَبَابِ الحِمَى","بُلِّغْت مَأْمُولاً فَمَأْمُولاُ",8,"ل",2,1],["على يديك المرتجَى إنعامُها","تابَ غرابُ البين من نُعابهِ",9,"ب",2,0],["عَلى يُوسُفَ الفَياض فاضَت مَسَرةٌ","بِاِقبالِ مولودٍ كَبَدرِ تَمامِ",10,"م",1,1],["عَلى يدِهم أَبدى القديرُ بفضلهِ","إِلى الخلقِ مِن آثارِ قُدرتهِ قدرا",11,"ر",2,0],["عَلَى يَعْسُوبِ أَرْوَاحِ الْبَرَايَا","وَأَصْلِ الأَصْلِ وَالِدِ ذِي الْقُرُونِ",12,"ن",1,0],["عَلى يَدِ عَبدِ اللَهِ وَالصاحِبِ الَّذي","بِإِحسانِهِ كَم عَمَّ قَوماً وَكَم خَصّا",13,"ص",2,0],["على يدِ ريحِ صَباً رُوحَ صَبٍّ سَرتْ","إلى مُقلتَيْ رَشأٍ بالصَّريم",14,"م",1,0],["على يَدهِ العلياء حُسْنَ خَواتمي","يكونُ كما قد كان حُسْن فواتحي",15,"ح",2,0],["عَلى يَبَسٍ كَما أُخبِرتُ لَكِن","غَريقٌ خاطِري في أَلفِ بَحرِ",16,"ر",1,0],["على يدِ أيّ شيختُبتَ قُل لي","فقلتُ على يد الإِفلاس تُبتُ",17,"ت",1,0],["على يُمناهُ أحداقٌ صغارٌ","ترامى الماءُ عنها قد أجنّهْ",18,"ن",2,0],["على يده قامت حضارتنا التي","لها وبها التاريخ شادى وسجلا",19,"ل",2,0],["على يديه نسجنا ألف قافية","غنى الزمان وأهلوه بها طربا",20,"ب",2,0],["عليّ يا دار جهدُ عيني وما","عليّ عارٌ أن تبخلَ الدِّيَمُ",21,"م",1,0],["على يدٍ تهزأ في جامد ال","عام بماءِ المزنةِ السائلِ",22,"ل",1,0],["على يده للرزق أذلغُ أحرسٌ","وضَلعاء فوها ساعةَ النزع صائتُ",23,"ت",1,0],["على يستوي فيه قديم وحادث","وإن كان فضل السبق للمتقدم",24,"م",1,0],["عَلى يَدِهِ الطولى تَقَمَّصَت مِطرَفاً","مِنَ العِزِّ وَالإِثراءِ ها أَنا ساحِبُه",25,"ب",2,0],["عليَّ يمينٌ للحِفاظِ وقد نَأَى","خليلُ الهَوى أَن لا أَرَى الصَبْر دَانِيَا",26,"ي",2,0]]}