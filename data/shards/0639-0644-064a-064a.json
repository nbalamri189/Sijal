{"poems":[[74,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[74,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[74,"أمستنقذي باللطف من قبضة الردى","https://www.aldiwan.net/poem19397.html","الطويل"],[74,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[107,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[54,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[78,"وحاملة راحا على راحة اليد","https://www.aldiwan.net/poem39334.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55174","السريع"],[146,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[186,"على يوسف الفياض فاضت مسرة","https://www.aldiwan.net/poem67009.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[242,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[287,"هلموا اسمعوا أحجية أبت النقصا","https://www.aldiwan.net/poem32725.html","الطويل"],[369,"تظلم من طرف ظبي رخييم","https://www.aldiwan.net/poem60647.html","المتقارب"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[423,"صديق قال لي لما رآني","https://www.aldiwan.net/poem4102.html","الوافر"],[438,"وأشعث مثل أهل النار ثاو","https://www.aldiwan.net/poem12750.html","الوافر"],[454,"هو الدين","https://www.aldiwan.net/poem977.html",""],[454,"كنوز الحب","https://www.aldiwan.net/poem988.html",""],[463,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[463,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[520,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[568,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[580,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137752",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48641","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64041","البسيط"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115094","الطويل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82259","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59116","الطويل"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21688","الوافر"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107031","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125447","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198873","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104951","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93597","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93565","الوافر"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205073","المنسرح"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137992",""],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112671","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71324","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89418","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91199","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85273","الطويل"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77099","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117265","الطويل"],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5183,"عبرات الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180253",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5431,"وسوريٌ تمجده الخصالُ","https://www.poetsgate.com/ViewPoem.aspx?id=185127",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""]],"verses":[["عليَّ يمينُ لا سلوت مهفهفاً","ولا بتُّ في رمَّان صدرٍ مفرّطا",0,"ط",2,0],["على يدِه البيضاء آي يراعةٍ","ينعم جانيها ويشقى لسيعها",1,"ع",3,0],["على يدِ مولانا نشا العمر ثانياً","فلا غَرْوَ أن يُنشا على يدِهِ الرزق",2,"ق",1,0],["عليّ يا ذا الفقار من قلمٍ","يقدّ قد العادي بأرغامه",3,"م",2,0],["على يدِ الزائر منهم زاده","من كلِّ باز قرم فؤاده",4,"ه",1,0],["على يدِهِ وَنِلْتَ به المُرادا","أفادَكَ يا ابن حربٍ ما أفادا",5,"د",2,0],["عَليٌّ يَظِنّونَ بي بُغضَهُ","فَهَلّا سِوى الكُفرِ ظَنّوهُ بي",6,"ب",2,0],["على ياسَمينٍ كاللُّجينِ ونَرْجِسٍ","كأَقْراطِ دُرٍّ في قَضيبِ زَبَرْجَدِ",7,"د",1,0],["عَلِيٌّ يَا زَيْنَ شَبَابِ الحِمَى","بُلِّغْت مَأْمُولاً فَمَأْمُولاُ",8,"ل",2,1],["على يديك المرتجَى إنعامُها","تابَ غرابُ البين من نُعابهِ",9,"ب",2,0],["عَلى يُوسُفَ الفَياض فاضَت مَسَرةٌ","بِاِقبالِ مولودٍ كَبَدرِ تَمامِ",10,"م",1,1],["عَلى يدِهم أَبدى القديرُ بفضلهِ","إِلى الخلقِ مِن آثارِ قُدرتهِ قدرا",11,"ر",2,0],["عَلَى يَعْسُوبِ أَرْوَاحِ الْبَرَايَا","وَأَصْلِ الأَصْلِ وَالِدِ ذِي الْقُرُونِ",12,"ن",1,0],["عَلى يَدِ عَبدِ اللَهِ وَالصاحِبِ الَّذي","بِإِحسانِهِ كَم عَمَّ قَوماً وَكَم خَصّا",13,"ص",2,0],["على يدِ ريحِ صَباً رُوحَ صَبٍّ سَرتْ","إلى مُقلتَيْ رَشأٍ بالصَّريم",14,"م",1,0],["على يَدهِ العلياء حُسْنَ خَواتمي","يكونُ كما قد كان حُسْن فواتحي",15,"ح",2,0],["عَلى يَبَسٍ كَما أُخبِرتُ لَكِن","غَريقٌ خاطِري في أَلفِ بَحرِ",16,"ر",1,0],["على يدِ أيّ شيختُبتَ قُل لي","فقلتُ على يد الإِفلاس تُبتُ",17,"ت",1,0],["على يُمناهُ أحداقٌ صغارٌ","ترامى الماءُ عنها قد أجنّهْ",18,"ن",2,0],["على يده قامت حضارتنا التي","لها وبها التاريخ شادى وسجلا",19,"ل",2,0],["على يديه نسجنا ألف قافية","غنى الزمان وأهلوه بها طربا",20,"ب",2,0],["عليّ يا دار جهدُ عيني وما","عليّ عارٌ أن تبخلَ الدِّيَمُ",21,"م",1,0],["على يدٍ تهزأ في جامد ال","عام بماءِ المزنةِ السائلِ",22,"ل",1,0],["على يده للرزق أذلغُ أحرسٌ","وضَلعاء فوها ساعةَ النزع صائتُ",23,"ت",1,0],["على يستوي فيه قديم وحادث","وإن كان فضل السبق للمتقدم",24,"م",1,0],["عَلى يَدِهِ الطولى تَقَمَّصَت مِطرَفاً","مِنَ العِزِّ وَالإِثراءِ ها أَنا ساحِبُه",25,"ب",2,0],["عليَّ يمينٌ للحِفاظِ وقد نَأَى","خليلُ الهَوى أَن لا أَرَى الصَبْر دَانِيَا",26,"ي",2,0],["على يد من مثلوها توز","ع مال غزير بغير سؤال",27,"ل",1,0],["على يدَيْ جدِّ الصريعِ الذي","أنساكمُ سيِّئُهُ الطيِّبا",28,"ب",2,0],["عليُّ يا مَنْ عُلاهُ فَوْقَ ما أَصِفُ","لا تعتذرْ إِنني بالعُذْرِ مُعتَرِفُ",29,"ف",1,1],["علي يمينٌ لا أقولُ قصيدةً","من الشعر إلا أم عمرٍ وشبوبها",30,"ب",3,0],["على يَحْيى وأيُّ فتًى كيَحْيَى","لعَانٍ عائِلٍ غَلِقٍ بوِتْرِ",31,"ر",1,0],["عَلَى يدكِ البَيْضَاءِ أيّ يَرَاعَةٍ","يُرَاعَى مُعَادِيهَا وَيُرْعَى ذِمَامُهَا",32,"م",3,0],["عَلى يَدَيها وَالشِراعِ الأَطوَلِ","أَهدامَ خَرقاءَ تلاحي رَعبَلِ",33,"ل",1,0],["عَلى يُسرٍ وَإِعسارٍ","وَفَيضُ نَوالِكُم فَيضا",34,"ض",2,0],["علي\" يمين قل\"تها غير حانث","لجودك تنظم \"النوال\" ونَضْدُه",35,"د",2,0],["على يد الخبير بالمصالح","أكرم به من مرشد وناصح",36,"ح",1,0],["عليَّ يمين اللَه أنِّي على الوفا","وأن ليس لي في حُبِّ غَيرِكَ مطمعُ",37,"ع",1,0],["علي يمين قد رأى الله جهرة","بذاك ابن عباس يدين ويقطع",38,"ع",1,0],["عليٌّ يدُ الهادي يصول بها وكم","لوالده الزاكي على أحمد يدُ",39,"د",1,0],["عليَّ يَد لِلعيس إِن هِيَ أَرقلت","وَراحَت تَجُوب البيد قَفراً عَلى قفر",40,"ر",1,1],["عليَّ يعز تَقبيل المُواسي","لِعَينك وَهِيَ دامية القُروح",41,"ح",1,0],["على يمين واليمين عزيمة","على المرء ان المرء لا يعدم القبرا",42,"ر",2,0],["على يدي للحديث خير يد","إذ هيأتني للحكم والحكم",43,"م",1,1],["علي يحب النبي قلبه بذكره ملان","عليه دائم يصلي سبحه بالبنان",44,"ن",1,1],["على يزيدَ وهوَ في سُلطانِه","في أوليائه وفي أعوانه",45,"ه",1,0],["عَلَى يَدِّ مَعْنَاهُ يَمُرُّ وُجُوبُهُ","لإِمْكَانِهِ مَرَّ السَّحَابِ المُصَوِّبِ",46,"ب",1,0],["على يد أهل العلم بك حقيقة","بفضلك يا مجيب أجب لي دعوة",47,"ه",1,0],["عليُّ يا درويش في شطرين قل","تاريخ بدءٍ وانتها الأمنيه",48,"ي",2,0],["عَليَّ يَمينُ اللَه إِنك واجدٌ","بِمَغناه ما أَمّلتَ وَالمَجدُ كافل",49,"ل",1,0],["على يده جل الفتوح تتابعت","فساوى القرى في الأمن مرعى السوائم",50,"م",1,0],["على يد العبد الحقير الخاطي","سمي جدِّهِ قتيل الشاطي",51,"ي",1,0],["عَلَيَّ يَدٌ لِلدَّهرِ واجِبَةُ الشُكرِ","بِغَفلَتِهِ عَن وَصلِ رَودٍ حَوَت أَسري",52,"ر",2,1],["على يده أدلاه بالحفرة التي","تبلج فيها الحق وابتسم الرشد",53,"د",1,0],["على يثرب ما لاح برقٌ تحية","كنفحة روض فاح طيبها هبوبها",54,"ب",3,0],["على يده البيضا تخرج جلة","نجوم اهتداء أو هم المزن اذ هما",55,"م",2,0],["على يدك البيضاء والعام مسنت","إذا الضيف نادى يا لأهل صِلاتي",56,"ت",2,0],["عَلِيُّ يَفْدِي رَسُولَ اللهِ فِي فُرُشٍ","أَبْصَارُهُمْ غُشِيَتْ عَنْهُ وَسَمْعُهُمِ",57,"م",1,0],["عليٌ يملأُ الآفاقَ نوراً","وعند السبك ينهزمُ المحالُ",58,"ل",1,0],["على يديك فرنسا زُلزلتْ وهوتْ","فاعمل لقومِكَ ولتهنأ بكَ الشّامُ",59,"م",1,0],["على يدِ الغارِ هذي بكّةٌ وعلى","يدِ النبوّةِ هذا الغارُ قد وفدا",60,"د",2,0],["عَلَى يَدِهِ مِنْ شِدَّةِ الجُودِ كَوْثَرٌ","وَ بَسْمَتُهُ كَالوَرْدِ وَهْجُهُ يُخْلِجُ",61,"ج",1,0],["على يديه سُقُوا عَلّاً فما رويت","نفوسهم فهي ظمأى للزيادات",62,"ت",1,0]]}