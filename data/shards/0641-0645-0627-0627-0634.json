{"poems":[[29,"أجد اليوم جيرتك ارتحالا","https://www.aldiwan.net/poem5947.html","الوافر"],[74,"شدا شدو الحمام وماس غصنا","https://www.aldiwan.net/poem20294.html","الوافر"],[53,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[72,"بحق الله متع","https://www.aldiwan.net/poem42959.html","الهزج"],[80,"تقدم إلى ما اعتدت عندي من الرحب","https://www.aldiwan.net/poem14177.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[83,"تنازعني الآمال كهلا ويافعا","https://www.aldiwan.net/poem61463.html","البسيط"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[132,"سأصبر صبرا لا يشاكله صبر","https://www.aldiwan.net/poem50597.html","الطويل"],[214,"وما اسم خماسي صحيح مذكر","https://www.aldiwan.net/poem13485.html","الطويل"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[276,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[285,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[358,"بدت لك شمس الخدر من فلق السجف","https://www.aldiwan.net/poem40039.html","الطويل"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[463,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[463,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[484,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[518,"ولما وقفنا للوداع وبيننا","https://www.aldiwan.net/poem67764.html","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122041","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46480","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123040","الرجز"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48198","الوافر"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121199","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121198","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83238","البسيط"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105339","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201458","الوافر"],[3298,"","https://poetry.dctabudhabi.ae/diwan/poem/105709","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112342","الوافر"],[3831,"","https://poetry.dctabudhabi.ae/diwan/poem/26598","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199089","الطويل"],[585,"هي الجزيرة فيها الصيحة العمم","https://www.poetsgate.com/ViewPoem.aspx?id=161893",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5277,"طقوس الرِقة","https://www.poetsgate.com/ViewPoem.aspx?id=191210",""],[5324,"فنجان قهوتها.","https://www.poetsgate.com/ViewPoem.aspx?id=211948",""]],"verses":[["فَما أَشوَينَ حينَ رَمَينَ قَلبي","سِهاماً لَم يَرِشنَ لَها نِبالا",0,"ل",2,0],["فما أشهى محيَّا منه زاهٍ","ولحظاً ما رمى قلباً فأسنا",1,"ن",2,0],["فما اشتكى الفضلُ منكم لؤمَ مقدرةٍ","ولا شكى العدلُ منكم جور أحكامِ",2,"م",1,0],["فَما أَشوَقَني مِنكَ","إِلى الهِجرانِ وَالصَدِّ",3,"د",1,0],["فَما أَشعَرَ الرَحمنُ قَلبيَ قَسوَةً","وَلا صارَ نسيانُ الأذمة مِن شَعبي",4,"ب",2,0],["فَما أَشارَ إِلى بُدٍّ بِمِحجَنِهِ","إِلّا هوَى لِيَدٍ مَغلُولَةٍ وَفَمِ",5,"م",1,0],["فَما اِشتَبَهَت طُرقُ النَجاةِ وَإِنَّما","رَكِبتَ إِلَيها مِن يَقينِكَ ظالِعا",6,"ع",2,0],["فَما أُشرِفُ الأَيفاعَ إِلّا صَبابَةً","وَلا أُنشِدُ الأَشعارَ إِلّا تَداوِيا",7,"ي",2,0],["فما اشتد أمرٌ أو تعذرَ نازحٌ","على طالبٍ إلا وفرَّجهُ الصبرُ",8,"ر",1,0],["فما اشتق منه خذ موافق لفظه","وصحف وان حرفت يلزمك الحد",9,"د",1,0],["فما أشاهد في كل الوجود سوى","جمالك الفخم يهوى أسرَهُ العاني",10,"ن",2,0],["فما اشتملت أَرض عَلى مثل أَحمد","وَلا استودع الرحمن رحما وَلا صلبا",11,"ب",2,0],["فَما اشْتَطَّتِ الآمَالُ إِلاَّ أَبَاحَهَا","سَمَاحُ عَلِيٍّ حُكْمَها فِي الْمَواهِبِ",12,"ب",1,0],["فَما أَشبَه الأَقلام بَين بنانِهِ","بخطّيّةٍ زُعفٍ وَهنديّة رُعفِ",13,"ف",1,0],["فما أشجعَ الشُّهْداءَ والحربُ قائمٌ","ولاقَوا زُؤامَ الموت بالبيضِ والسمر",14,"ر",1,0],["فما أَشِروا مع القدَرِ المُوالي","ولا بطِروا على المُلك العقيمِ",15,"م",1,0],["فما أشكو سوى أنّي بعيدٌ","وغيري يومَ ناديكم قريبُ",16,"ب",1,0],["فما أشجاه بالدستور صوتا","تردده العقائر في النوادي",17,"د",2,0],["فما أشبهت عيناي ألا سحابة","دنا صربها واستعجلتها رعودها",18,"د",3,0],["فَمَا اشْتَلاهَا صَفْقُهُ لِلْمُنْصَفَقْ","حَتَّى تَرَدَّى أَرْبَعٌ فِي المُنْعَفَقْ",19,"ق",1,0],["فَمَا أَشْهَى لِقَلْبِي مَا أَضَاعُوا","لِيَوْمِ كَرِيهَةٍ وَسَدَادِ ثَغْرِ",20,"ر",1,0],["فَما أَشكو لِمَن أَشكوه إلا","كَما يَشكو الصَحيح إِلى الجِريح",21,"ح",1,0],["فما أشار نحوه","بالطرف إلا كلّمه",22,"م",2,0],["فما أشعَلتَ حربا قط إِلا","بنصركَ تنجْلىِ عنَّا الكروبُ",23,"ب",1,0],["فما اشتياقي إلى أهل ولا وطن","ما لم تكن فيه ماذا ينفع البلد",24,"د",1,0],["فما اشتكلت ظمأ يوما كصارمه","ولا اشتكى الوحش في أرض العدا الشغبا",25,"ب",2,0],["فَما اِشتَهَرتَ بِهِ خُلقاً وَتَبصِرَةً","يَفوقُ حِذقَ اللَبيقِ النابِهِ الزَكِنِ",26,"ن",1,0],["فما أشقى القطيعة بعد وصل","وما أحلى المطامع بعد يأس",27,"س",1,0],["فما أشقى بكم روحي وشعري","كلانا عائشان بلا قشور",28,"ر",1,0],["فما اشتقت للأغصان إلا لأنها","تشابه من اعطافه مائس القد",29,"د",1,0],["فما أشقى الذي يهتمّ","للدنيَا وما أغبي",30,"ب",2,0],["فَما أَشَطَّت سُمَيٌّ أَن هم قَتَلوا","بَني أُسَيدٍ بِقَتلي آلِ زِنباعِ",31,"ع",1,0],["فما أشرقت من بعد سلطان شمسها","ولا رفلت في حليهن الروافل",32,"ل",1,0],["فما اشمخرت قبابٌ يستظل بها","كأن كل بناءٍ فوقه الهرم",33,"م",1,0],["فَمَا اشْتَدَّ بُطْلانٌ لِيَبْقَى بِأَرْضِهِ","وَلمْ يَخْتَفِ الْحَقُّ اغْتِرَاباً لِيَمْنَعَا",34,"ع",2,0],["فما أشقاكَ يا ليلَ السهارى","طويلٌ..يبتغي طيفاً لريّهْ",35,"ر",3,0],["فماأشقاك في حبي","وما بالصد أقساني.",36,"ن",2,0]]}