,"https://www.poetsgate.com/ViewPoem.aspx?id=210548",""],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[4999,"بخل المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=184281",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5121,"شَاعِرُ الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=212038",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[5376,"بلقيس ألقت جمالا من خمائلها","https://www.poetsgate.com/ViewPoem.aspx?id=189751",""],[5431,"قد جئت دهرك ثائرا ووحيدا","https://www.poetsgate.com/ViewPoem.aspx?id=196789",""],[5512,"الأب والبنون ..","https://www.poetsgate.com/ViewPoem.aspx?id=207955",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5701,"رفيع القدر حيانا","https://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5707,"طرق الصَّوَاب بك استبان سَبِيلهَا","https://www.poetsgate.com/ViewPoem.aspx?id=189187",""],[5732,"انادم اللي رفقته ترفع الراس","https://www.poetsgate.com/ViewPoem.aspx?id=177830",""],[5754,"مَا طبعوا سيوفهم من الحدق","https://www.poetsgate.com/ViewPoem.aspx?id=191643",""],[5829,"درر الجمان","https://www.poetsgate.com/ViewPoem.aspx?id=196437",""],[6075,"في صفحة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=190530",""],[6093,"لا يَنحني إلا ليلتقطَ الفصولْ","https://www.poetsgate.com/ViewPoem.aspx?id=203946",""],[6127,"قد يَصدُقُ السيف!","https://www.poetsgate.com/ViewPoem.aspx?id=188485",""],[6167,"عزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85563&r=&rc=46",""]],"verses":[["كما وحد اثنين، الذي كان ثالث","أقام الذي ألغى، وقام الذي التغى",0,"غ",2,0],["كَم أُوَرّي عَن لَوعَتي وَأُواري","ما أَجَنَّت أَضالِعي مِن أُواري",1,"ر",2,1],["كَما والى عَلَينا مِن نَداهُ","وَشادَ لَنا المَكارِمَ فَاِستَهَلَّت",2,"ت",1,0],["كَم أَوهَمَتني الخَوفَ مِن طارِئٍ","تَشجي بِذا نَفسي فَتُشجيها",3,"ي",3,0],["كَما وُلِدتُم عَلى أَعرافِها وُلِدَت","في ساحَةِ الحَربِ لا في باحَةِ الرَحَبِ",4,"ب",1,0],["كما ود هذا الشهر لو لم يفز به","سواك حنيف في العباد مطهر",5,"ر",1,0],["كَم أوقِدَت لِشُموعِها صُبحِيَّةٌ","في اللَيلِ ثُمَّتَ أُطفِئَت شَمَعاتُها",6,"ت",3,0],["كَما وَسَقَ الراحَ السَقاءُ وَرُبَّما","يُضاهي مَزاداً مِن مَشارِبِهِم وُفرا",7,"ر",2,0],["كم أومض البارق في عارض","فألفي الكاذبَ إذ يلمع",8,"ع",1,0],["كم أُوقدَتْ لشُموعِها صُبْحِيّةٌ","في الليلِ ثُمَّ أُطفئَتْ شمَعاتُها",9,"ت",3,0],["كم أوهمتني الخوف من طارىء","تشجي بذا نفسي فتشجيها",10,"ي",3,0],["كَما وَالى علَيَيْنا مِنْ نَداهُ،","وَشادَ لنَا المكارمَ فاستهلَّتْ",11,"ت",1,0],["كم اوقعت فيه","النبال عيناه",12,"ا",2,0],["كم أودع النسيما","إليكمو تسليما",13,"م",2,0],["كَم أودِعَت مِن صِفاتٍ عَنكَ مُخبِرَةٍ","وَإِن تَظَنّى جَهولٌ أَنَّها لَقَبُ",14,"ب",1,0],["كم أورق جاريته","شأو الأسى فسبقته",15,"ت",2,0],["كما وعدت من في ضربه المنى","بان ابن إسماعيل عنه ينامُ",16,"م",1,0],["كما وَهي من شَطَنٍ رِشَاهُ","ثم بَدَا وهْو على قَفَاه",17,"ا",2,0],["كم أواري بزينبٍ وسعادٍ","وورا ذاكَ رميُ قدحٍ وريّ",18,"ي",1,0],["كما وقعَ النسرُ الجسورُ على الذُّرى","فتاقَ إِلى أعلى وطارَ مُصعّدا",19,"د",2,0],["كَم أودِعَت دَويَّةً داوِيَةً","صُرِعوا بِها في المَعرَكِ المُستَوعِرِ",20,"ر",1,0],["كَم أَوغروا مِن صدورٍ بِاِختلاقهم","وغيّروا مِن حميمٍ حالَ إذ زعموا",21,"م",3,0],["كَما وُجِدت من عالمِ الكونِ كثرةٌ","فَصار كشخصٍ باِعتضادٍ عديدها",22,"د",3,0],["كَم أوكِفُ الظَهرَ بِطَيلَسانِ","وَيُشبِهُ العِدلَينِ لي كُمّانِ",23,"ن",1,0],["كَم أَودَع الأُدباء في أَوراقِهم","حُكماً بِها صَدر الزَمان يَضيق",24,"ق",1,0],["كما وجدتُ على قَومي تخوُّنَهم","ريبُ المَنونِ ودهرٌ طالَ ما خَانا",25,"ن",2,0],["كما وَجَدْتُكَ حُلواً","إِذْ ذُقْتُ دهريَ مُرَّا",26,"ر",2,0],["كما وَصَفَ الكِنْدِيُّ بَعْلَ فَتاتِهِ","عَلَيْهِ القَتامُ سَيِّءَ الظَّنِّ والبالِ",27,"ل",1,0],["كما وُقِّيتَ أمسِ وقد تقصَّى","علاقةَ جسمك الداءُ الوجيعُ",28,"ع",1,0],["كما وثِقتْ مُعْطُ العواسل عندهُ","بأرزاقها ما اهتزَّ للطَّعْنِ عاسلُهْ",29,"ل",2,0],["كمْ أوْصَلتْني يدٌ من طَوْلِ هِمَّتهِ","لِقُعْسِ بيضِ معالٍ قِبْلَها الأرَبُ",30,"ب",1,0],["كم أوْقدوا ناراً لها","في كلّ ناحيةٍ ضَرامُ",31,"م",1,0],["كم أوْهنوا من جراثيمٍ وما وهنوا","وأَرغموا من عرانينٍ وما رُغِموا",32,"م",3,0],["كم أوضعوا في طُرُقاتِ العُلا","وحلّقوا في العزّ إذْ حلّقوا",33,"ق",3,0],["كم أولد الحب أهواء وأعقبها","على الدوام عقيماً ماله عقب",34,"ب",1,0],["كَم أَورث الحرّ ذلّاً بَعد عزته","وَصير العَبدَ بَعد الرقِّ سُلطانا",35,"ن",2,0],["كَما وَلّى أَبو التَنحي","س وَالتَفنيدِ وَالخَلب",36,"ب",1,0],["كما ورق الشجرات تنا","ثر لما يكون الأوان خريفا",37,"ف",2,0],["كم أودعَتْ أُذنيَ من أنَّةٍ","تودعُ قلبي جمرةً محرقه",38,"ق",2,0],["كم اوردن من عدي","فيه الرمل مهتال",39,"ل",1,0],["كَم أَوجدَ اللَّهُ مِن وَجهَينِ في رَجلٍ","وَلَم يَكُنْ جاعِلاً قَلبَينِ في رَجُلِ",40,"ل",1,0],["كَم أُوَيقاتِ صَفاً طابَت لَنا","بِهِمُ وَالدَّهرُ مُغضِي الطَّرفِ عَنّا",41,"ن",2,0],["كم أوقدوا نار حرب من سيوف وغى","ترمي وجوه كماة الشر بالشرر",42,"ر",1,0],["كَم أَومَضَ البَرقُ فَاِفتَرَّت مَباسِمُهُ","حَتّى إِذا ما اِنقَضى اِربَدَّت سَحائِبُهُ",43,"ب",2,0],["كَم أَواري وكم تبدت أُموري","وَدموعي سكبتها مدرارا",44,"ر",2,0],["كَمَا وَرَدَ الكَرِيمُ أبوكَ قَبلاً","عَلَيِهِ وأنتَ فِي طَورِ الوَلِيدِ",45,"د",1,0],["كم أودعني ولهاً بهم","طيف بوصلهم وعدا",46,"د",2,0],["كم أورد جيشاً راحته","لمّا أرداه ظماً وردى",46,"د",2,0],["كم أوقر المجتدِي من سامي مَعْدِنِهِ","عيساً وأوقر خزاً رائقاً عيسا",47,"س",2,0],["كَم أُودعوا الدَهرَ مِن بَأسٍ وَمن كرمٍ","وَأَنقَذوا الناسَ مِن كُفرٍ وَمن حوبِ",48,"ب",1,0],["كما وردٍ إذا الداريّ يمرجه","بما يطيبه من ماءِ خلاف",49,"ف",1,0],["كما وهج الليل والبدر ثاوٍ","وراءَ الغمائم يأبى السفورا",50,"ر",2,0],["كم أوعد الصب بلقياه فما","أنجز في وعد التلاقي ما وعد",51,"د",1,0],["كم أودعت في مقلتي من سهر","واضرمت في مهجتي من حرق",52,"ق",1,0],["كم أوجد الخصم من ثلم بسوركم","وأنتم توسعون الثلم بالأحن",53,"ن",1,0],["كم أورد المنثور نظماً قد حلا","بالذوق من ثغر الأقاح زلاله",54,"ل",2,0],["كما ورث العلا والمج","د عن آبائه العظما",55,"م",2,0],["كم أولجت سمر القنا بصدور قو","م لم يكونوا للقتال يطيقوا",56,"ق",3,0],["كم أوقعوا بك ذرة فتاظمت","وتزلزلت من وقعها الأطواد",57,"د",1,0],["كم أ