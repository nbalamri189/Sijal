{"poems":[[79,"سلام الله بورك من سلام","https://www.aldiwan.net/poem36096.html","الوافر"],[95,"يوم أثار كوامن الأشجان","https://www.aldiwan.net/poem11171.html","الكامل"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[53,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[93,"رسم تعلم منه ناظري الولعا","https://www.aldiwan.net/poem8981.html","عموديه"],[40,"وداع بلحن الكلب يدعو ودونه","https://www.aldiwan.net/poem7868.html","الطويل"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[63,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[52,"وجارية يغلي بأمثالها الفتى","https://www.aldiwan.net/poem24517.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85480","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54991","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67347","الكامل"],[108,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[79,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[92,"أعيذكم من كذبتين","https://www.poetsgate.com/ViewPoem.aspx?id=178981",""],[136,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[139,"أحييت آمالي وكنت أمتها","https://www.aldiwan.net/poem49059.html","الكامل"],[147,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[147,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[147,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[193,"قل لي متى العذراء ترضى","https://www.aldiwan.net/poem35159.html","مجزوء الكامل"],[285,"من كان مثل أبي علي فلينل","https://www.aldiwan.net/poem60759.html","الكامل"],[303,"يفنى الزمان وذكره يتجدد","https://www.aldiwan.net/poem36263.html","عموديه"],[396,"أنني لمقصر","https://www.aldiwan.net/poem54595.html","عموديه"],[447,"أخي ولدي ما بال قلبك لاه","https://www.aldiwan.net/poem14433.html","الطويل"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[463,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[470,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[541,"أشاقك من عهد الخليط مغان","https://www.aldiwan.net/poem23856.html","الطويل"],[543,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"صورة إن نظرتها كلفتني","https://www.aldiwan.net/poem33731.html","الخفيف"],[563,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[567,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107231","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105611","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61126","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79946","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79942","الكامل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128771","البسيط"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103227","البسيط"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116544","الطويل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69421","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[358,"","https://poetry.dctabudhabi.ae/diwan/poem/84124","الطويل"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100481","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109454","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67193","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106844","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93647","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93649","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137233",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137266",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137110",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65942","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100350","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102380","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145048","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206152","الكامل"],[3945,"","https://poetry.dctabudhabi.ae/diwan/poem/130526","البسيط"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105260","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105265","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86376","الوافر"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21516","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90841","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90884","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83524","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120449","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120367","الوافر"],[4578,"ماذا تقول بمدحك الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=49340",""],[5127,"حديثُ النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177309",""],[5135,"هِلَالٌ أَطَلَّ","https://www.poetsgate.com/ViewPoem.aspx?id=204535",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5425,"شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ","https://www.poetsgate.com/ViewPoem.aspx?id=207511",""],[5431,"محض التعقل ما لله قد صعدا","https://www.poetsgate.com/ViewPoem.aspx?id=187678",""],[5431,"وفنائي على ذراعيك حيّ!!","https://www.poetsgate.com/ViewPoem.aspx?id=201377",""],[5464,"أوصيك بي شراً اذا خنت الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=7560",""],[5739,"خيط الازرّه تشنّج ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131234",""],[5765,"موتٌ ينادي للولادة !","https://www.poetsgate.com/ViewPoem.aspx?id=213304",""],[6202,"يا أبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86763&r=&rc=64",""],[463,"أمنْ أسماءَ والمسرى بعيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60031&r=&rc=87",""]],"verses":[["مَحَضْتَ بِهِ الْوَصَاةَ إِلَى رِجَالٍ","كِرَامٍ شَأَنُهُمْ رَعْيُ الذِّمَامِ",0,"م",1,0],["مَحَضَ البِلادَ هَوَاهُ غَيْرُ مُسَاوِمٍ","مَهْمَا يُكَابِدُ فِي الهَوَى وَيُعَانِي",1,"ن",2,0],["محضْتكُم نصحي وإنِّيَ بعدها","لأعنِقُ فيما ساءكم وأُهَمْلِجُ",2,"ج",1,0],["محضتُك مدحاً أنت أهلٌ لمحضه","وإن كان أضحى بالعتاب مُضَيَّحا",3,"ح",2,0],["مَحَضتُكُمُ نُصحَ الصَديقِ عَسى","خَيراً يُفيدُكُمُ فَالنُصحُ كَم نَفَعا",4,"ع",2,0],["مُحَضَّرَةٌ لا يُجعَلُ السِترُ دونَها","إِذا المُرضِعُ العَوجاءُ زالَ بَريمُها",5,"م",3,0],["محضتك النصح لا تعرض لسرهم","من غير خُبر ولا تغترَ بالخبرِ",6,"ر",1,0],["مَحضَ المَذَلَّةِ راكباً عُكَّازَهُ","رَثَّ المعيشةِ شاحبَ الجِلبابِ",7,"ب",1,0],["مَحَضتَ لِيَ النُصحَ إِحساناً إِلَيَّ بِلا","غِشٍّ وَقَلَّدتَني الإِنعامَ فَاِحتَكِمِ",8,"م",1,0],["مَحَّضْتَنِي النُّصْحَ لكِنْ لَسْتُ أَسْمَعُهُ","إنَّ المُحِبِّ عَنْ العُذَّالِ في صَمَمِ",9,"م",1,0],["مَحَضتُ لَها الحَوباءَ حَتّى اِستَثَرتُها","لِسائِسِ مُلكٍ أَو كَواعِبِ عينِ",10,"ن",1,0],["محضتك نصحي أَن تحيد عَن الخنى","وَمن كانَ مثلي فهو للنصح يمحض",11,"ض",1,0],["مَحَضْتُهُ الوُدَّ وَلمْ أُبْدِهِ","أَكلُّ مَنْ أَبْدَى وِدَاداً مَحَضْ",12,"ض",1,0],["مَحَضْنَا بِهِ مِصْرَ الهَوَى لاَ تَشُوبُهُ","شَوَائِبُ مِنْ سُؤْلٍ لنا وطِلاَبِ",13,"ب",1,0],["مَحْضَ الضّرائبِ ماجداً أَعْرَاقَهُ","من خَيْرِ خِنْدِفَ مَنْصِباً وَمَكانَا",14,"ن",2,0],["مَحَّضتُهُمْ ودِّي، ومحَّضوني","لستُ على العهود بالأمينِ",15,"ن",1,0],["محض الله منك ياقوتة الملك","وينبوع العدل والإصلاح",16,"ح",1,0],["محضتُ لكم رشح الوداد كعادتي","ولم تعرفوا لي غير مختلط الرشح",17,"ح",1,0],["مَحضتُ مَوَدَّتِى لبنَى فَكَانَت","إذَا ما خِلتُها تَدنُو تَناءَى",18,"ا",2,0],["محَضتْهم ودّى فلما أيسروا","كانت بداية أمرهم نسياني",19,"ن",2,0],["مَحضُ الإِباءِ وَسُؤدُدُ الآباءِ","جَعَلاكَ مُنفَرِداً عَنِ الأَكفاءِ",20,"ا",2,1],["مَحضِ القَبيلَينِ يُلفى صالِحاً أَبَداً","في حَلبَةِ الفَخرِ وَثّاباً إِذا نُسِبا",21,"ب",2,0],["مَحضُ الإِباءِ مِنَ النَزاهَةِ كُوِّنَت","أَفعالُهُ وَمِنَ النَباهَةِ صُوِّرا",22,"ر",2,0],["مَحضُ الضَريبَةِ مَيمُونُ النَقِيبَةِ طَع","عان الكَتيبَةِ لا غَمرٌ وَلا وَكِلُ",23,"ل",1,0],["مَحَضَ النصيحةَ للورى","إِذ جاءَهم بالحقّ مَحضا",24,"ض",2,0],["مَحْضُ الْعَلاءِ صَرِيحُهُ فِي أُسْرَةٍ","جَمَحِيَّةِ النَّسَبِ الصَّرِيحِ الأَمْحَضِ",25,"ض",1,0],["مَحَضَ (ابنَ حمدان) هواه لأَنَّهُ","حيفٌ بوجهِ المعتدينَ مجرَّد",26,"د",1,0],["محض فضل ومنة","من هباتك تفتح",27,"ح",1,0],["محضتك يا دهمان مني نصيحة","وأَنت عَلى طوع النصيحة زاه",28,"ه",1,0],["محضتُك النصحَ وما انتصحتَني","قولاً فكايلْني الجزاءَ عملا",29,"ل",2,0],["مَحَضْتُ الناسَ مختبراً فكلٌّ","بكىءٌ دون زُبدته زهيدُ",30,"د",1,0],["محضُ وقتٍ على دقائقِه ِ","يَنحَني وهو يَذبلُ الجَسَد ُ",31,"د",1,0],["مَحَضتُكُمُ نُصحي فَلا تَقبَلونَهُ","جَزاكُم إِلهي نُصحَكُم وَجَزاني",32,"ن",2,0],["مَحضُ رُشدٍ وحِكمَةٍ وسَدادٍ","وصَوابٍ ورِفعَةٍ وفَخارِ",33,"ر",1,0],["محض الكناية في الاقوال معجزة","رحب النجاد جبان الكلب من كرم",34,"م",1,0],["محض فضل منها عليَّ وحفظ","لي بلا كلفة لها صورتني",35,"ن",2,0],["محض تشبيه عقيدته","في سوى التجسيم لم يَهِم",36,"م",1,0],["مَحَضْتُك النُّصحَ عن خُبرٍ وتجرِبةٍ","واللهُ سُبحانَهُ الهادي إلى الرَشَدِ",37,"د",1,0],["مَحَضتَ لنا فيهِ النَّصيحةَ فالهُدى","يَلوحُ عَلينَا مِن خِلالِ الصَّحيفَةِ",38,"ه",1,0],["محضت ودي لهم طرا وإن سطعت","لي منهم آية الشحناء والحقد",39,"د",1,0],["مَحضتك الود فَجازَيتَني","مذقاً بِمحض الود ما أجورك",40,"ك",1,0],["محضُ الضريبة مغوارُ الكتيبة مح","مودُ النقيبة يوم السبق والغَلب",41,"ب",1,0],["مَحضُ الصنيعةِ لا كجودِ","سواهُ مصنوعٌ مُموَّه",42,"و",2,0],["محضته الحب طبعا جل عن زلل","واكمل الحب مالله قد صرحا",43,"ح",2,0],["محضَ النِجارِ من البيتِ الذي جُعِلت","فيه النبوَّةُ يجري غيرَ مَسبوقِ",44,"ق",1,0],["مَحضنا لهم نُصحاً فجاءوا بغَدرَةٍ","وكُنّا لهم سِلماً وكانوا لنا حَربا",45,"ب",2,0],["محّض قلبي لشُهودكم","فإذا أنعمتَ فيا نعمي",46,"م",2,0],["مَحضُ الأُبُوَّةِ وَالمُرُوَّةِ خالِصٌ","طابَ النِجارُ فَطابَتِ الأَعراقُ",47,"ق",1,0],["مَحَضْتُ لإِخواني صريح نصيحة","تُعَرِّفهم أَنّي من النُّصُحاءِ",48,"ا",2,0],["مَحضتك مِنّي خالصَ الودّ وَالوَفا","عَلامَ بِقَتلي مقلتاك تهدّدُ",49,"د",1,0],["محضتم لنا صفو الوداد سجيةٌ","وهل تارك صفو الوداد له أهل",50,"ل",1,0],["محض نفعٍ كله ليس به","لسواه أبداً من ضرر",51,"ر",1,0],["مَحضَ كمال نُورهِ القُدسي مِن","أَنوارِ بارِئ الوَرى تمحَّضا",52,"ض",2,0],["محضُ السعادة غذّاها الرجاءُ وقد","باتت بأَمنٍ من الأحداثِ والغير",53,"ر",1,0],["محضت ودي للعباس لا ملقا","أَقولها لا ولا مِن شيمَتي الخدع",54,"ع",1,0],["محضتك وَد النَفس غَير مخادع","وَفي ودّ أَبناء الزَمان خدوع",55,"ع",1,0],["محضتك يا سليمان الودادا","وخذ هبة اذا شئت الفؤادا",56,"د",2,1],["محضتك يا باسيل ودي ومن به","سواك جدير من قصيٍ ومن دان",57,"ن",1,0],["محضتك الود صفواً والاله على","ما قلت يشهد والآيات والسور",58,"ر",1,0],["محض الأرومة من رؤوس بني أبي","أسد العريكة ضيغميّ كفاح",59,"ح",1,0],["محضتك حبّاً لو تقابلني به","لأقبل من بغداد للحب فيلقُ",60,"ق",1,0],["محضتني النصح لكن لست أَسمعه","أعذل مثلك يثنيني عَن الخيَم",61,"م",1,0],["محض الضرية في البيت الذي ضربت","فيه النباوة صدقا غير مسبوق",62,"ق",1,0],["محضتني النصح لَكن لَستُ أسمعه","وَكَيفَ أَسمع قَولاً غَير مُنتظم",63,"م",1,0],["محضناها المحبة واغتدينا","نطارحها التغزل والنسيبا",64,"ب",2,0],["محضتكم صَفوَ الوِداد محبة","فيكم وَفي مثلي يَكون وَفاءُ",65,"ا",2,0],["محضتني سر الحياة وسرها","خافٍ عليك جليله والضامر",66,"ر",1,1],["محض الضريبة عالي الهمّ مختلق","جلد النحيزة ن