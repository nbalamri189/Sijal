{"poems":[[29,"أمسيت إذ رحل الشباب حزينا","https://www.aldiwan.net/poem4446.html","الكامل"],[63,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[107,"يوم الشهيد رجعت أيمن مرجع","https://www.aldiwan.net/poem42070.html","الكامل"],[104,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[125,"أضحى فؤادي والأشواق مرتبضا","https://www.aldiwan.net/poem23822.html","البسيط"],[182,"موت يشتهيه الرثاء","https://www.aldiwan.net/poem50697.html","الكامل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107229","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72289","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89577","الكامل"],[5725,"امنية","https://www.poetsgate.com/ViewPoem.aspx?id=191275",""]],"verses":[["غَيَّضنَ مِن عَبَراتِهِنَّ وَقُلنَ لي","ماذا لَقيتَ مِنَ الهَوى وَلَقينا",0,"ن",2,0],["غيضن من دمع تجدد نازلا","وحبسن من نفس ترفع صاعدا",1,"د",2,0],["غَيَّضتَ عَبْرَةَ كُلِّ عَينٍ ثَرَّةٍ","وشَفَيْتَ لَوعةَ كلِّ قَلبٍ مُوجَعِ",2,"ع",1,0],["غِيضَ دمعي وكان رِيّاً لروحي","من غليل الأَسى فمنْ يرويني",3,"ن",2,0],["غَيَّضتُهُ ما اِستَطَعتُ حَتّى","زادَ وَأَفضى إِلى الفَراغِ",4,"غ",1,0],["غيضا وغيضانة له سألَتْ كما","وجدتها بقضاء من مضى وقضى",5,"ض",2,0],["غَيَّضْتَ دمعكَ في غَرابيبِ الونى","حتى اشْتكَتْ من كأدِكَ الكأداءُ",6,"ا",2,0],["غَيِّضِ الدَّمعَ فالبُكا غَيرُ مُجدٍ","وَالرَّدى لَن تَرُدَّهُ الزَّفَراتُ",7,"ت",1,0],["غيضت بظلم بني زياد أنمل","منهم وقد كانت بحوراً فيَّضا",8,"ض",2,0],["غيضهن عبرتهن يوم الوادي","فأرحن عازب أنس ذاك النادي",9,"د",2,1],["غَيضاتُ غَضّاتُ اِنقَشَع","نَ أَنجَبنَ عَنهُمَّ الكِلَل",10,"ل",1,0],["غيض البحار على النوارس لم يعي","قطرالندى يكوي السحابة كالصفيح",11,"ح",1,0]]}