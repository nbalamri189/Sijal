{"poems":[[53,"المرثديون سادات تعد لهم","https://www.aldiwan.net/poem65463.html","البسيط"],[47,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[47,"رأت وخط شيب في عذاري فصدت","https://www.aldiwan.net/poem62645.html","الطويل"],[47,"ليالينا بين اللوى فزرود","https://www.aldiwan.net/poem63519.html","الطويل"],[99,"متى يرق الحظ يا قاسي","https://www.aldiwan.net/poem24796.html","السريع"],[102,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[101,"امام قصرها","https://www.poetsgate.com/ViewPoem.aspx?id=24598",""],[119,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[234,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[285,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[369,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[447,"أرزى المصائب والخسران في الدين","https://www.aldiwan.net/poem14487.html","البسيط"],[454,"صباحك عيد مشرف","https://www.aldiwan.net/poem974.html",""],[463,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[469,"أوجداً وذياك الحمى ومنازله","https://www.aldiwan.net/poem3610.html","عموديه"],[469,"سرى موهناً والأنجم الزهر لا تسري","https://www.aldiwan.net/poem3632.html","عموديه"],[563,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[567,"نفارقكم ونضرب في البلاد","https://www.aldiwan.net/poem52988.html","الوافر"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44552","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104549","البسيط"],[1390,"","https://poetry.dctabudhabi.ae/diwan/poem/117141","الوافر"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100686","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108822","الوافر"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102074","المتقارب"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100200","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86300","الطويل"],[4691,"هيفاء ردّي لمن أنحلته ِ عُمُرا ً !!","https://www.poetsgate.com/ViewPoem.aspx?id=60737",""],[4755,"إلى الشِّعرِ لَيلًا تَطِيرُ اليَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183688",""],[4929,"الشعر في معادلة التغيير","https://www.poetsgate.com/ViewPoem.aspx?id=199508",""],[4932,"سلى عَن غرامي مدمعي فَهُوَ صَادِق","https://www.poetsgate.com/ViewPoem.aspx?id=189374",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5064,"خُطى وخطايَا","https://www.poetsgate.com/ViewPoem.aspx?id=199132",""],[5408,"عروبيٌّ صوتي","https://www.poetsgate.com/ViewPoem.aspx?id=190873",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[5865,"متى أصحو ؟","https://www.poetsgate.com/ViewPoem.aspx?id=179827",""],[5952,"شوقٌ لِ قُبَّتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=212162",""],[6125,"فَظِيعٌ ما أحلُّوا أو أبَاحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=210570",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""]],"verses":[["متى وصفناه ألفينا محاسنه","من الوفور على أضعاف ما نصف",0,"ف",1,0],["مَتى وَعَدَتنا الحادِثاتُ إِدالَةً","فَأَخلِق بِذاكَ الوَعدِ مِنهُنَّ أَن يُلوى",1,"و",2,0],["مَتى وَقَدَت في مُظلِمِ الأَمرِ ضَوَّأَت","وَإِن ضَرَبَت في جانِبِ الخَطبِ قَدَّتِ",2,"ت",1,0],["مَتى وَتَرَتني النائِباتُ فَجودُهُم","مُديلِيَ مِن أَحداثِها وَمُقَيِّدي",3,"د",2,0],["متى وهل من حيلة في متى","وفي خيالاتٍ وأحداسِ",4,"س",1,0],["متَّ يوماً ياصديقي، وأنا","كل يومٍ والردى شربي وزادي",5,"د",2,0],["متى؟. وردّتْ صلاتي","مع انهمار السدول",6,"ل",1,0],["متى وجه القلب الرفاعي لحاجةٍ","قضاها له الرحمن من لطفه برا",7,"ر",2,0],["متى وُزِنت صُمُّ الحجار بجوهر","متى شارفت شُمَّ الجبال وِهاد",8,"د",1,0],["مَتى وَصَلَ الزَّمانُ إِلى مَحَلٍّ","إِلى دَفْعِ الزَّمانِ بِهِ الْوُصُولُ",9,"ل",1,0],["متى وَرَدوا بي مَنْهلا من وِصالهم","قضَى هَجْرُهم أن يسبق الصدر الوردا",10,"د",2,0],["متى وردت حياض العفو منك فقد","نلت المراد ولا خوف يعديني",11,"ن",2,0],["متى ومتى لا بارك الله في متى","وحتى متى هذا لذاك يكيد",12,"د",1,0],["متى وصلَت تحيةُ مستهامِ","فخصَّكِ غيرَ محجوبٍ سلامي",13,"م",2,1],["متى وقفتني بباب الوزير","فقد بدَّلت كلّ منٍ يمنِ",14,"ن",1,0],["متى وقفت عيسي على حجراتهِ","فسائلها من دمعِ عيني سائله",15,"ل",2,0],["متى وقفت تبكي على عرصاتها","تقلْ هذه الخنساء تبكي على صخر",16,"ر",1,0],["متى والوضع مع ملك","إضافاتٌ بإسناد",17,"د",1,0],["متى وَثِقَتْ بِعهدٍ منكَ نفسٌ","كفاها العهدُ عن صَوبِ العِهادِ",18,"د",1,0],["مَتى وَعَدتُكَ في تَركِ الهَوى عِدَةً","فَاِشهَد عَلى عِدتي بِالزورِ وَالكَذِبِ",19,"ب",1,1],["متى ومن ذا ولا وقتٌ ولا ملكٌ","يُعزِّزان بعزِّ القلبِ قُلَّبهِ",20,"ب",2,0],["متى وردت ركائبنا خفافا","صدرن يجم نائلهم ثقالا",21,"ل",2,0],["متى وسعت لقصدي الأرض حتى","أبرز أو أنيل به جزيلاً",22,"ل",2,0],["متى وصلت لتهجر أو تدانت","لتبعد كلُّ يوميها رحيل",23,"ل",1,0],["متى وصلهم بل متى قربهم","وحب جنت للبعد عند وخاد",24,"د",1,0],["متى ودقت مرابعها غيوث","فمن تيار راحته سخاها",25,"ا",3,0],["مَتى وَجَدوا خَرقاً اَحَبّوا اِتِّساعُهُ","فَكَم ذُقتُ عَيشاً في الغَرامِ تَنَغُّصا",26,"ص",2,0],["متى وناري َ يا هيفاء مضرمة ٌ","ألقاك ِ حتى أرى قلبي وقد ثَلُجَا",27,"ج",2,0],["مَتَى؟! وهيَ بالقُرْبِ تُصغِي إلى","\"مَتَانَا\" وأطرَافُهَا تُحْصَدُ",28,"د",1,0],["متى وعى الشعب أنّ الوعي يَنْقُصُهُ","يخضرُّ إدراكُه بالوعي ِ إنباتا",29,"ت",2,0],["مَتى وعدت بالوصل فالوعد كَاذِب","وَإِن وعدت بالهجر فالوعد صَادِق",30,"ق",1,0],["متى وضعنا على آثارها قدما","نلنا الوصول (ولم نرتب ولم نهم)",31,"م",1,0],["متَى وفَّى الزَّمانُ ونَحْنُ فِيهِ","نَعُدُّ العَهْدَ مِنْ بَعْضِ العطَايَا؟",32,"ا",3,0],["متى وربّتما ظنّي يُخيِّبني","لا لن يعودَ وفينا يسْكنُ النكدُ",33,"د",1,0],["[ مَتَى وَدَّعُوا لِلْبَيْنِ أَيْقَنْتُ أَنَّنِي","مِنَ المَوْتِ ما لِي يَوْمَ فُرْقَتِهِمْ بُدُّ ]",34,"د",1,0],["مَتّى ومُرْقُسُ والأُلى عُرِفوا","لوقا ويوحَنّا وبِرْنابا",35,"ب",2,0],["متى؟ والحلمُ يهمسُ لي: تصبّرْ","سينقشعُ الضبابُ عن الطريقِ",36,"ق",1,0],["متى ومثليَ نرنوا صوْب قُبَّتهِ","يُصوِّبوا نحو أبصارٍ لنا الظُّلَما",37,"م",2,0],["متى وُضعَ الجِهادُ يَكونُ خِزيٌ","ويبقى الذُّلُّ ما نُزعَ السِّلاحُ",38,"ح",1,0],["(متى وكيف خرجتم من كهوفكم ؟؟","كل ( الأكابر ) من تكبيركم رعبوا)",39,"ب",3,0]]}