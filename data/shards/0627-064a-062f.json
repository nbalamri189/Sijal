{"poems":[[53,"صبرا غريم الثأر من عدنان","https://www.aldiwan.net/poem29664.html","الرجز"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[86,"أيدري المسلمون بمن أصيبوا","https://www.aldiwan.net/poem10481.html","الوافر"],[93,"يا رجاء الوطن","https://www.aldiwan.net/poem11167.html","مجزوء الرمل"],[93,"لك في ارتجال جلائل الهمم","https://www.aldiwan.net/poem11336.html","أحذ الكامل"],[93,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[47,"اللوم للعاشقين لوم","https://www.aldiwan.net/poem25159.html","مجزوء البسيط"],[47,"وما كنت أخشى أن أبيت وبيننا","https://www.aldiwan.net/poem25242.html","الطويل"],[72,"قسما بغصن قوامه المتمايل","https://www.aldiwan.net/poem19481.html","الكامل"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[72,"مرحبا بالحيا لكل جديب","https://www.aldiwan.net/poem19533.html","الخفيف"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"فرح الناس أن تهيأ في الفطر","https://www.aldiwan.net/poem66049.html","الخفيف"],[51,"أيها السيد الذي جل عن شكري","https://www.aldiwan.net/poem66516.html","الخفيف"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[91,"الأربعون لو انها تتكلم","https://www.aldiwan.net/poem62688.html","عموديه"],[91,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[85,"إيدسن ماذا ترى في الكهرباء","https://www.aldiwan.net/poem7589.html","الرمل"],[43,"أيدري ما أرابك من يريب","https://www.aldiwan.net/poem9458.html","الوافر"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[43,"أيدري الربع أي دم أراقا","https://www.aldiwan.net/poem9732.html","الوافر"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[45,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[45,"لبيت فيك الشوق حين دعاني","https://www.aldiwan.net/poem66690.html","الكامل"],[28,"إني كتبت إليك ألتمس الغنى","https://www.aldiwan.net/poem5513.html","الكامل"],[28,"قد بلغنا على مخشاة أنفسنا","https://www.aldiwan.net/poem5633.html","البسيط"],[61,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[61,"أسلم للأيام أم لا أسلم","https://www.aldiwan.net/poem51450.html","الطويل"],[80,"يا رسولي الذي يحدث سمعي","https://www.aldiwan.net/poem31299.html","الخفيف"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[105,"مكسويني كتبت للناس درسا","https://www.aldiwan.net/poem43079.html","الخفيف"],[105,"يوم بدر وأنت أعلى مقاما","https://www.aldiwan.net/poem44220.html","الخفيف"],[81,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[52,"أي ورد على خدود الغزال","https://www.aldiwan.net/poem26743.html","الخفيف"],[75,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[46,"لو شاء ربي لصاغني ملكا","https://www.aldiwan.net/poem22596.html","المنسرح"],[46,"هل ألهمت يثرب يوما مثربها","https://www.aldiwan.net/poem23305.html","البسيط"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16624","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55060","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[45,"صُنْتُ نَفْسِي عَمّا يُدَنّس نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=31225",""]],"verses":[["أَيديكُمُ أَريُ العِبادِ وَشَريُها","وَمَفاتِحُ الأَرزاقِ وَالحِرمانِ",0,"ن",1,0],["أَيديهِمُ طُرُقُ النَدى وَجِباهُهُم","أَبهى مِنَ التيجانِ لا بَل أَلمَعُ",1,"ع",1,0],["أَيُّ دُموعٍ عَليكَ لَم تَصُبِ","وَأَيُّ قَلبٍ عَليكَ لَم يَجِبِ",2,"ب",1,1],["أَيدٍ تَجاذَبُ دُنيا لا بَقاءَ لَها","خِباؤُها بَينَ تَقويضٍ وَتَطنيبِ",3,"ب",1,0],["أَيَدري المُسلِمونَ بِمَن أُصيبوا","وَقَد وارَوا سَليماً في التُرابِ",4,"ب",1,1],["أَيِّدْ وَصُنْ","فَارُوقَ مِصْرِ",5,"ر",1,0],["أَيَّدَْتَهَا تَأْيِيدَ ذِي ثِقَةٍ","مِنْ نَفْسِهِ بِالحَق مُعْتَصِمِ",6,"م",1,0],["أَيَّدَ اليَوْمَ مَوْقِفِي وَالأسَانِيدُ","ضِئَالٌ فَعُدْنَ غَيْرَ ضِئَالِ",7,"ل",1,0],["أَيدٍ لَهُم عِندَ كُلِّ خَطبٍ","يُثنى بِها الفادِحُ الجَسيمُ",8,"م",1,0],["أَيُدرِكُ ما أَدرَكتُ إِلّا اِبنُ هِمَّةٍ","يُمارِسُ في كَسبِ العُلا ما أُمارِسُ",9,"س",1,0],["أيديهمُ في الأرضِ نبع زلازلها","ومحطُّ أرجلهم أمان زلازل",10,"ل",1,0],["أي دنيا يصفو لها أمل المر","ءِ وهذي مصارع الآمال",11,"ل",1,0],["أيد الله ملكهُ ووقاه","وحمى سربه وصان جلاله",12,"ل",2,0],["أُيِّد بالساج والحديد ولم","يوهَن بآجُرّةٍ ولا مَدَره",13,"ر",2,0],["أيَّدَ اللَّهُ مُلكَهُ ورعاهُ","وسقاهُ وحاطهُ من إمامِ",14,"م",1,0],["أَيُّ دَيْن يُقْضَى بتَقْسيطِ دينا","رٍ وحالٍ تُشَدُّ من بعد وَهْن",15,"ن",1,0],["أَيديكُمُ فَوقَ أَيدي الناسِ فاضِلَةٌ","وَلَن يُوازِنَكُم شيبٌ وَلا مُرُدُ",16,"د",1,0],["أَيدٍ تُوَدِّعُ مَوطِناً وَعَشيرَةً","وَمَطامِحٌ خَلفَ البِحارِ تُسَلِّمُ",17,"م",1,0],["أَيَدري النَعشُ أَيَّ فَتىً يُاري","وَهَذا القَبرُ أَيَّ فَتىً يَصونُ",18,"ن",1,0],["أَيُّ دُنيا مسحورةٍ أَيُّ رؤيا","طالَعَتْني في ضوءِ هذا العيونِ",19,"ن",1,0],["أي داء فيك قد","دب حتى اكلك",20,"ك",1,0],["إيدسن ماذا ترى في الكهرباء","أنت في الأرض فمن ذا في السماء",21,"ا",2,1],["أَيَدري ما أَرابَكَ مَن يُريبُ","وَهَل تَرقى إِلى الفَلَكِ الخُطوبُ",22,"ب",1,1],["أَيدٍ مُقَطَّعَةٌ حَوالي رَأسِهِ","وَقَفاً يَصيحُ بِها أَلا مَن يَصفَعُ",23,"ع",1,0],["أَيَدري الرَبعُ أَيَّ دَمٍ أَراقا","وَأَيَّ قُلوبِ هَذا الرَكبِ شاقا",24,"ق",2,1],["أيَّدْتَ دينَ الهاشميَّ فلم يضِعْ","لبني الشريعةِ عندَ سيفِك ثارُ",25,"ر",1,0],["أَيدٌ شَديدٌ لَو يُصا","رِعُ يَذبُلاً أَنشا يَهُدُّه",26,"د",2,0],["أَيَّدَ المُلكَ بَعدَ ما مادَ رُكنا","هُ بِسَيفِ الخِلافِ كُلَّ مُميدِ",27,"د",1,0],["أَيّدٌ في السِلاحِ تَبهى عَلَيهِ","خَلَقُ الدِرعِ مُحكَماً وَقَتيرُه",28,"ر",2,0],["أُيِّدتَ مِن فَصلِ الخِطابِ بِخُطبَةٍ","تُنبي عَنِ الحَقِّ المُبينِ وَتُخبِرُ",29,"ر",1,0],["أَيَّدوا مُلكَنا وَشَدّوا قُواهُ","بِكُماةٍ تَحتَ السَنَّورِ حُمسِ",30,"س",1,0],["أُيِّدتَ بِالحَظِّ الَّذي لَم يُنتَقَض","وَنُصِرتَ بِالفِئَةِ الَّتي لَم تَضعُفِ",31,"ف",1,0],["أُيِّدتَ بِالنَصرِ الوَشيكِ وَأُتبِعوا","في ساعَةِ الهَيجاءِ بِالخِذلانِ",32,"ن",1,0],["أَيدٍ سَبَقنَ إِلى المُنادي بِالقِرى","وَالبَأسِ في سَبَلِ العَجاجِ الأَقتَمِ",33,"م",1,0],["أَيدي بَجيلَةَ أَيدٍ لا يُوازِنُها","أَيدي طِعانٍ إِذا لاقَينَ أَقرانا",34,"ن",2,0],["أَيَدْري الغَبيَّانِ اللَّذانِ تَناهَبا","مَحاسِنَ شِعْري أيَّ نَهْبٍ تَقَسَّما",35,"م",2,0],["أَيُدْفَعُ عن حَلْيِ البَلاغَةِ مُعْرِبٌ","ويَرْفُلُ في وَشْيِ الفَصاحَةِ أَعْجَمُ",36,"م",1,0],["أيّ دُرٍّ من العقيق عليه","خاتَمٌ لا يُفكّ عنه بلثمِ",37,"م",1,0],["أيُّ دنيا هذه الدنيا التي","مالنا منها سوى خُفَّيْ حُنَيْنْ",38,"ن",1,0],["أَيُّ دينٍ لِصائِمٍ أَو مُصَلٍّ","في مُروآتِهِ وَفي مَكرُماتِهْ",39,"ت",2,0],["أيُّ دِينٍ كدينِهِ في عُلاهُ","أيُّ قومٍ كالمسلمينَ القدامى",40,"م",2,0],["أَيَّدَ حُبّي كِتابُ عارِضِهِ","كَذلِكَ الكُتبُ تَعضَدُ المَلَلا",41,"ل",2,0],["أَيُّ دُرٍّ إِذا تَبَسَّمَ يُبدي","هِ وَسِحرٍ في طَرفِهِ وَدَلالِ",42,"ل",1,0],["أيّدتَهُ عَضُداً فيما يُحاولُهُ","وكُنتُما واحداً في الرأي والأدب",43,"ب",1,0],["أَيَّدَ مِنّي وَقالَ أَيَّ دَمٍ","أَرَقتَ فَهوَ الجُبارُ وَالهَدرُ",44,"ر",1,0],["أَيدٍ إِذا بَسَطوها لِلعُلا وَصَلوا","وَأَوجُهٌ لا تُغادي مِثلَها اللُطَمُ",45,"م",1,0],["أَيَّدِ الكاهِلِ جَلدٍ بازِلٍ","أَخلَفَ البازِلَ عاماً أَو بَزَل",46,"ل",1,0],["أَيِّدوا كُلَّ مَجمَعٍ قامَ لِلبِر","رِ بِجاهٍ يُظِلُّهُ أَو بِمالِ",47,"ل",1,0],["أيَدْفَعُ مُعْجِزاتِ الرُّسْل قوْمٌ","وفِيكَ وفي بَديهتِكَ اعتِبارُ",48,"ر",1,1],["أيِّد بالصبر وبالثبات","والرابطين البهم الأباة",49,"ه",1,0],["أَيَدَ الْمَنُونِ قَدَحْتِ أَيَّ زِنَادِ","وَأَطَرْتِ أَيَّةَ شُعْلَةٍ بِفُؤَادِي",50,"ي",1,1],["أَيَّدَ اللهُ مُلْكَهُ وَوَقاهُ","كُلَّ عَادٍ مِنَ التَّصَارِيفِ وَاقِ",51,"ق",1,0],["أَيَّدَ الشُّورَى وَأَجْرَى","الْحِكْمَ مَجْرَاهُ السَّدِيدا",52,"د",2,0],["اي دائيك كان أفتك بالجسم","وأورى لثورة الأعصاب",53,"ب",1,0],["أَيُّ دَمٍ مِنكَ جَرى","كَأَنَّ سَهماً نَحَرَك",54,"ك",1,0],["أَيَّدُ الأَعباءِ لَو حَمَّلَهُ","سائِلو القَومِ ثَبيراً لَحَمَل",55,"ل",1,0],["أيُدْعَى سليلُ الشرقِ للشرق غَاصِباً","ومغتالُه في الغربِ ليسَ بغاصبِ",56,"ب",1,0],["أيُّ دينٍ ذلك الدينُ الذي","حَوَّل الأفكارَ عن كلِّ اتجاه؟",57,"ا",2,0],["أي دنيا ستبعدين جناها","وصباها فوق احتمال العباره؟",58,"ر",2,0],["أيّدُو مُلْكَنَا، وَشَدّوا قُوَاهُ","بكُماةٍ، تحتَ السّنَوّرِ، حُمسِ",59,"س",1,0]]}