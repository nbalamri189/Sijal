/poem48764.html","الخفيف"],[400,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[400,"عسى توبة تمحى بها كل زلة","https://www.aldiwan.net/poem34112.html","الطويل"],[402,"قل للذي يرجة ثبات مودتي","https://www.aldiwan.net/poem49892.html","الكامل"],[413,"إن مليك العصر من قد علا","https://www.aldiwan.net/poem53898.html","السريع"],[413,"هكذا كان فعلها الحمقاء","https://www.aldiwan.net/poem53943.html","الكامل"],[413,"أيها الدار لقد نلت الحبورا","https://www.aldiwan.net/poem53995.html","الرمل"],[413,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[413,"ضحك البرق فأبكاني دما","https://www.aldiwan.net/poem54130.html","الرمل"],[413,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[429,"بركة بوركت فنحن لديها","https://www.aldiwan.net/poem12417.html","الخفيف"],[431,"وكأنما راياته","https://www.aldiwan.net/poem26362.html","مجزوء الكامل"],[434,"أيقطعنا في حبه من نواصله","https://www.aldiwan.net/poem2572.html","الطويل"],[438,"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[441,"كل حمد لما صنعتم قليل","https://www.aldiwan.net/poem56020.html","عموديه"],[451,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[456,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[456,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[456,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[456,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[456,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[480,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[498,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[512,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[513,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[513,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[525,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[549,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[549,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[560,"على الدنيا ومن فيها السلام","https://www.aldiwan.net/poem52970.html","الوافر"],[573,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"]],"verses":[["أَيديكُمُ أَريُ العِبادِ وَشَريُها","وَمَفاتِحُ الأَرزاقِ وَالحِرمانِ",0,"ن",1,0],["أَيديهِمُ طُرُقُ النَدى وَجِباهُهُم","أَبهى مِنَ التيجانِ لا بَل أَلمَعُ",1,"ع",1,0],["أَيُّ دُموعٍ عَليكَ لَم تَصُبِ","وَأَيُّ قَلبٍ عَليكَ لَم يَجِبِ",2,"ب",1,1],["أَيدٍ تَجاذَبُ دُنيا لا بَقاءَ لَها","خِباؤُها بَينَ تَقويضٍ وَتَطنيبِ",3,"ب",1,0],["أَيَدري المُسلِمونَ بِمَن أُصيبوا","وَقَد وارَوا سَليماً في التُرابِ",4,"ب",1,1],["أَيِّدْ وَصُنْ","فَارُوقَ مِصْرِ",5,"ر",1,0],["أَيَّدَْتَهَا تَأْيِيدَ ذِي ثِقَةٍ","مِنْ نَفْسِهِ بِالحَق مُعْتَصِمِ",6,"م",1,0],["أَيَّدَ اليَوْمَ مَوْقِفِي وَالأسَانِيدُ","ضِئَالٌ فَعُدْنَ غَيْرَ ضِئَالِ",7,"ل",1,0],["أَيدٍ لَهُم عِندَ كُلِّ خَطبٍ","يُثنى بِها الفادِحُ الجَسيمُ",8,"م",1,0],["أَيُدرِكُ ما أَدرَكتُ إِلّا اِبنُ هِمَّةٍ","يُمارِسُ في كَسبِ العُلا ما أُمارِسُ",9,"س",1,0],["أيديهمُ في الأرضِ نبع زلازلها","ومحطُّ أرجلهم أمان زلازل",10,"ل",1,0],["أي دنيا يصفو لها أمل المر","ءِ وهذي مصارع الآمال",11,"ل",1,0],["أيد الله ملكهُ ووقاه","وحمى سربه وصان جلاله",12,"ل",2,0],["أُيِّد بالساج والحديد ولم","يوهَن بآجُرّةٍ ولا مَدَره",13,"ر",2,0],["أيَّدَ اللَّهُ مُلكَهُ ورعاهُ","وسقاهُ وحاطهُ من إمامِ",14,"م",1,0],["أَيُّ دَيْن يُقْضَى بتَقْسيطِ دينا","رٍ وحالٍ تُشَدُّ من بعد وَهْن",15,"ن",1,0],["أَيديكُمُ فَوقَ أَيدي الناسِ فاضِلَةٌ","وَلَن يُوازِنَكُم شيبٌ وَلا مُرُدُ",16,"د",1,0],["أَيدٍ تُوَدِّعُ مَوطِناً وَعَشيرَةً","وَمَطامِحٌ خَلفَ البِحارِ تُسَلِّمُ",17,"م",1,0],["أَيَدري النَعشُ أَيَّ فَتىً يُاري","وَهَذا القَبرُ أَيَّ فَتىً يَصونُ",18,"ن",1,0],["أَيُّ دُنيا مسحورةٍ أَيُّ رؤيا","طالَعَتْني في ضوءِ هذا العيونِ",19,"ن",1,0],["أي داء فيك قد","دب حتى اكلك",20,"ك",1,0],["إيدسن ماذا ترى في الكهرباء","أنت في الأرض فمن ذا في السماء",21,"ا",2,1],["أَيَدري ما أَرابَكَ مَن يُريبُ","وَهَل تَرقى إِلى الفَلَكِ الخُطوبُ",22,"ب",1,1],["أَيدٍ مُقَطَّعَةٌ حَوالي رَأسِهِ","وَقَفاً يَصيحُ بِها أَلا مَن يَصفَعُ",23,"ع",1,0],["أَيَدري الرَبعُ أَيَّ دَمٍ أَراقا","وَأَيَّ قُلوبِ هَذا الرَكبِ شاقا",24,"ق",2,1],["أيَّدْتَ دينَ الهاشميَّ فلم يضِعْ","لبني الشريعةِ عندَ سيفِك ثارُ",25,"ر",1,0],["أَيدٌ شَديدٌ لَو يُصا","رِعُ يَذبُلاً أَنشا يَهُدُّه",26,"د",2,0],["أَيَّدَ المُلكَ بَعدَ ما مادَ رُكنا","هُ بِسَيفِ الخِلافِ كُلَّ مُميدِ",27,"د",1,0],["أَيّدٌ في السِلاحِ تَبهى عَلَيهِ","خَلَقُ الدِرعِ مُحكَماً وَقَتيرُه",28,"ر",2,0],["أُيِّدتَ مِن فَصلِ الخِطابِ بِخُطبَةٍ","تُنبي عَنِ الحَقِّ المُبينِ وَتُخبِرُ",29,"ر",1,0],["أَيَّدوا مُلكَنا وَشَدّوا قُواهُ","بِكُماةٍ تَحتَ السَنَّورِ حُمسِ",30,"س",1,0],["أُيِّدتَ بِالحَظِّ الَّذي لَم يُنتَقَض","وَنُصِرتَ بِالفِئَةِ الَّتي لَم تَضعُفِ",31,"ف",1,0],["أُيِّدتَ بِالنَصرِ الوَشيكِ وَأُتبِعوا","في ساعَةِ الهَيجاءِ بِالخِذلانِ",32,"ن",1,0],["أَيدٍ سَبَقنَ إِلى المُنادي بِالقِرى","وَالبَأسِ في سَبَلِ العَجاجِ الأَقتَمِ",33,"م",1,0],["أَيدي بَجيلَةَ أَيدٍ لا يُوازِنُها","أَيدي طِعانٍ إِذا لاقَينَ أَقرانا",34,"ن",2,0],["أَيَدْري الغَبيَّانِ اللَّذانِ تَناهَبا","مَحاسِنَ شِعْري أيَّ نَهْبٍ تَقَسَّما",35,"م",2,0],["أَيُدْفَعُ عن حَلْيِ البَلاغَةِ مُعْرِبٌ","ويَرْفُلُ في وَشْيِ الفَصاحَةِ أَعْجَمُ",36,"م",1,0],["أيّ دُرٍّ من العقيق عليه","خاتَمٌ لا يُفكّ عنه بلثمِ",37,"م",1,0],["أيُّ دنيا هذه الدنيا التي","مالنا منها سوى خُفَّيْ حُنَيْنْ",38,"ن",1,0],["أَيُّ دينٍ لِصائِمٍ أَو مُصَلٍّ","في مُروآتِهِ وَفي مَكرُماتِهْ",39,"ت",2,0],["أيُّ دِينٍ كدينِهِ في عُلاهُ","أيُّ قومٍ كالمسلمينَ القدامى",40,"م",2,0],["أَيَّدَ حُبّي كِتابُ عارِضِهِ","كَذلِكَ الكُتبُ تَعضَدُ المَلَلا",41,"ل",2,0],["أَيُّ دُرٍّ إِذا تَبَسَّمَ يُبدي","هِ وَسِحرٍ في طَرفِهِ وَدَلالِ",42,"ل",1,0],["أيّدتَهُ عَضُداً فيما يُحاولُهُ","وكُنتُما واحداً في الرأي والأدب",43,"ب",1,0],["أَيَّدَ مِنّي وَقالَ أَيَّ دَمٍ","أَرَقتَ فَهوَ الجُبارُ وَالهَدرُ",44,"ر",1,0],["أَيدٍ إِذا بَسَطوها لِلعُلا وَصَلوا","وَأَوجُهٌ لا تُغادي مِثلَها اللُطَمُ",45,"م",1,0],["أَيَّدِ الكاهِلِ جَلدٍ بازِلٍ","أَخلَفَ البازِلَ عاماً أَو بَزَل",46,"ل",1,0],["أَيِّدوا كُلَّ مَجمَعٍ قامَ لِلبِر","رِ بِجاهٍ يُظِلُّهُ أَو بِمالِ",47,"ل",1,0],["أيَدْفَعُ مُعْجِزاتِ الرُّسْل قوْمٌ","وفِيكَ وفي بَديهتِكَ اعتِبارُ",48,"ر",1,1],["أيِّد بالصبر وبالثبات","والرابطين البهم الأباة",49,"ه",1,0],["أَيَدَ الْمَنُونِ قَدَحْتِ أَيَّ زِنَادِ","وَأَطَرْتِ أَيَّةَ شُعْلَةٍ بِفُؤَادِي",50,"ي",1,1],["أَيَّدَ اللهُ مُلْكَهُ وَوَقاهُ","كُلَّ عَادٍ مِنَ التَّصَارِيفِ وَاقِ",51,"ق",1,0],["أَيَّدَ الشُّورَى وَأَجْرَى","الْحِكْمَ مَجْرَاهُ السَّدِيدا",52,"د",2,0],["اي دائيك كان أفتك بالجسم","وأورى لثورة الأعصاب",53,"ب",1,0],["أَيُّ دَمٍ مِنكَ جَرى","كَأَنَّ سَهماً نَحَرَك",54,"ك",1,0],["أَيَّدُ الأَعباءِ لَو حَمَّلَهُ","سائِلو القَومِ ثَبيراً لَحَمَل",55,"ل",1,0],["أيُدْعَى سليلُ الشرقِ للشرق غَاصِباً","ومغتالُه في الغربِ ليسَ بغاصبِ",56,"ب",1,0],["أيُّ دينٍ ذلك الدينُ الذي","حَوَّل الأفكارَ عن كلِّ اتجاه؟",57,"ا",2,0],["أي دنيا ستبعدين جناها","وصباها فوق احتمال العباره؟",58,"ر",2,0],["أيّدُو مُلْكَنَا، وَشَدّوا قُوَاهُ","بكُماةٍ، تحتَ السّنَوّرِ، حُمسِ",59,"س",1,0],["أيد الدين بعد طه وأعلى","مذهب الأتباع للمختار",60,"ر",1,0],["أيد حمانا منك بالحماية","وحفنا بالنصر والوقايه",61,"ه",1,0],["أيدعي العلمَ ذو فسق سجيتُه","عقوق أصلٍ وعصيانُ الاله عَلاَ",62,"ل",2,0],["أيّ ديارٍ تُحمَى وقد راع تا","جَ الدِّين خطبٌ أنيابهُ عُصُلُ",63,"ل",1,0],["أَيديكُمُ مَشكورَةُ الآلاءِ","وَوُجوهُكُم مَشهورَةُ اللَألاءِ",64,"ا",2,0],["أَيَّدتَ بِالجِدِّ وَالجَدِّ المُلوكَ فَعِش","عُمرَ الزَمانِ بِمُلكِ الأَرضِ مُنفَرِدا",65,"د",2,0],["أيدت دمعي بالنحول شهادة","لي بالغرام فقال لي لن يقبلا",66,"ل",2,0],["أيدير ناحية السراب لحاظه","من بين عينيه البحار العذبة",67,"ه",1,0],["أيدعي بمحيي الدين هذا فتسكتوا","برئت إلى الرحمن من كل غادر",68,"ر",1,0],["أَيدي الحَوادِثِ في الأَيّامِ وَالأُمَمِ","أَمضى مِنَ الذَكَرِ الصَمصامَةِ الخَذِمِ",69,"م",1,1],["أيد طوال إلى المكروه ما قدروا","وفي ابتناء المعالي شانها القصر",70,"ر",1,0],["أيّدَت خيرَ الورى مُعجِزاتُ","كلُّها آياتُها بيّناتُ",71,"ت",1,1],["أيّدوهُ وبلّغوا الدين عنهُ","فهمُ الناصِحون والنصراءُ",72,"ا",2,0],["اَيدِى الصَّارِيفِ وِراقاً زُيِّفَت","تَنجِلُهُ نَجلاً اِذا تَقَيَّفَت",73,"ت",1,0],["أيدت بالفتح المبي","ن دعائم الدين المتين",74,"ن",1,0],["أَيُدينُ الخاطي جناةٌ صَعالي","كُ وَيَقضي الفجورُ ذَنبَ الفجورِ",75,"ر",1,0],["أَيُّ داءٍ يشفُّهُ أَيُّ داءِ","يا إِلهي يا مُنقِذَ الأَبرِياءِ",76,"ا",2,1],["أَيُّ داءٍ يشفُّهُ فَعَلى عَينَي","هِ طَيفٌ ذو جَبهَةٍ سَوداءِ",76,"ا",2,0],["أيّ دمع جرى وقلب تلظّى","وفؤاد تداول البينُ وخزه",77,"ز",2,0],["أَيَّ دارٍ لِلبَلا نَزَلوا","أَو سَبيلٍ لِلرَدى سَلَكوا",78,"ك",3,0],["أَيُدرِكُ شَأوَكَ ذو كَبوَةٍ","قَصيرُ خُطى المَجدِ يَومَ السِباقِ",79,"ق",1,0],["أَيَّدَ اللَهُ دينَهُ بِجِبالٍ","مِنهُمُ شُمَّخِ الهِضابِ رَواسي",80,"س",2,0],["أَيُّ دَمٍ ما طاحَ في أَرضِهِم","وَذِمَّةٍ لِلَّهِ لَم تُخفَرِ",81,"ر",1,0],["أَيَّدَهُ اللَهُ في خِلافَتِهِ","حَتّى أُمِرَّت لِمُلكِهِ المِرَرُ",82,"ر",1,0],["أَيديكُمُ لِرَباحِ الأَرزاقِ","مِنّا مَفاتِح",83,"ح",1,0],["أَيَّدتُمُ الدينَ الحَنيفِ فَأَصبَحَت","مَجموعَةً لِسُيوفِكُم أَشتاتُهُ",84,"ت",2,0],["أَيُّ دَمٍ ما طاحَ في حُبِّها","وَأَيُّما حَبلٍ لَها ما اِنقَضَب",85,"ب",1,0],["أي دَهرٍ رَاقَت وراعَت عيانا","وَسَماعاً بُرُوقُهُ ورُعُودُه",86,"د",2,0],["أيُّ دهر كَرَّ من أيامه","ولياليه بشُهبٍ وبدُهم",87,"م",1,0],["أَيَّدَتْهُ سُعُودُهَا وَهُدَاها","فَمَحَا الأَشْقِياءَ والضُّلالا",88,"ل",2,0],["أيد الآداب والعلم فما","تمرة الجاه اذا لم يبتذل",89,"ل",1,0],["إِيداع قَلبي هواهم شاد لي بهم","من العناية رُكناً غير منهدِمِ",90,"م",1,0],["أَيَدري مغاصَ الدرِّ مَن ليسَ غائصاً","وَمَشرقَ زهرِ الفضلِ إلّا رَصودها",91,"د",3,0],["أيديكم أوكت ومن أفواهكم","نفخ فبئس النفخ والإيكاءُ",92,"ا",2,0],["أيد يحيى أخطّ كف يحيى","إنّ يحيى بأيده لخطوطُ",93,"ط",1,1],["أي دينٍ ي