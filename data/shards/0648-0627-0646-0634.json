طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[46,"وجدت الناس في هرج ومرج","https://www.aldiwan.net/poem22263.html","الوافر"],[46,"إذا ركبت إجارها ورأيتها","https://www.aldiwan.net/poem22613.html","الطويل"],[46,"تصدق على الأعمى بأخذ يمينه","https://www.aldiwan.net/poem23333.html","الطويل"],[46,"حياة وموت وانتظار قيامة","https://www.aldiwan.net/poem23509.html","الطويل"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85590","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42698","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[77,"تلافيت نصر الدين إذ كاد يتلف","https://www.poetsgate.com/ViewPoem.aspx?id=34179",""],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[85,"الله أكبر كم بالفتح من عجب","https://www.poetsgate.com/ViewPoem.aspx?id=485",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[2,"رأيتُ بني آلِ امرىء القيسِ أصفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=5267",""]],"verses":[["وَاِنشُدا قَلبي فَقَد ضَيَّعتُهُ","بِاِختِياري بَينَ جَمعٍ وَمِنى",0,"ن",2,0],["وَإِن شاءَ كانَ جِماحَ الجِماحِ","وَإِن شاءَ كانَ حِماحَ الحِرانِ",1,"ن",1,0],["وَأُنشِدُهُ وَأَعلَمُ أَينَ أَمسى","مِطالاً لِلبَلابِلِ وَالهُمومِ",2,"م",1,0],["وَإِن شامَ يَوماً نارَهُ خِلتَ أَنَّها","تَطَلَّعُ نَحوَ الوارِدينَ مِنَ الزِندِ",3,"د",1,0],["وَإِنْ شِئْتُما أَنْ تَعْلَما مَا أُجِنُّهُ","فَلَيسَ بمَأَمونٍ عَلَيْهِ لِساني",4,"ن",2,0],["وأنْشَقُ منْ رُبا نَجْدٍ نَسيماً","يُغازِلُ في أباطِحِهِ الأقاحي",5,"ح",2,0],["وأنْشَقُ منها نَفْحَةً غَضَويّةً","ولي عَبراتٌ ما تَجفُّ غُروبُها",6,"ب",3,0],["وإن شامَ مَنْ ألوى بهِ المحْلُ بَرْقَهُ","تَيَقَّنَ أنَّ العُسْرَ يتْبَعَهُ اليُسْرُ",7,"ر",1,0],["وإنْ شكَتْ مرْهَفاتُ البيضِ منْ ظمَأٍ","فسقِّها عَلَلاً صِرْفاً منَ العَلَقِ",8,"ق",1,0],["وأنشأْتَ في أفْقِ العُلا سُحُبَ النّدَى","وسَقَيْتَ روْضَ المَجْدِ فهْوَ مفوَّفُ",9,"ف",1,0],["وَأَنْشَدَتْكَ اللَّيَالِي وَهْيَ صَادِقَةٌ","الْمَجْدُ عُوفِيَ إِذْ عُوفِيتَ وَالْكَرَمُ",10,"م",1,0],["وَاِنشُري رَيّاكِ في ذاكَ الحِمى","وَاِلثِمي الأَرضَ إِذا جِئتِ الإِماما",11,"م",2,0],["وَإِن شاءَ أَدنى إِلَيهِ النُجومَ","فَناجى المَجَرَّةَ وَالفَرقَدا",12,"د",2,0],["وَإِن شاءَ زَعزَعَ شُمَّ الجِبالِ","فَخَرَّت لِأَقدامِهِ سُجَّدا",12,"د",2,0],["وَإِن شاءَ شاهَدَ في ذَرَّةٍ","عَوالِمَ لَم تَحيَ فيها سُدى",12,"د",2,0],["وَإِن شِئتِ عَنّا يا سَماءُ فَأَقلِعي","وَيا ماءَها فَاِكفُف وَيا أَرضُ فَاِبلَعي",13,"ع",2,0],["وَإِن شاوَرتَهُم وَالأَمرُ جِدُّ","ظَفِرتَ لَهُم بِرَأيٍ لا يَزِلُّ",14,"ل",1,0],["وَأَنشَأتُ في صَدري لِحُسنِكَ دَولَةً","لَها الحُبُّ جُندٌ وَالوَلاءُ سَفيرُ",15,"ر",1,0],["وَأُنشِدُ أَشعاري وَإِن قالَ حاسِدي","نَعَم شاعِرٌ لَكِنَّهُ غَيرُ مِكثارِ",16,"ر",1,0],["وَأَنشَدَت وَدُموعُ العَينِ ساجِمَةٌ","في وَجنَتَيها سُجومَ العارِضِ الساري",17,"ي",1,0],["وَإِن شِئتُما بِالنُبلِ أَن تَتَناضَلا","فَدونَكُما بِالرشقِ مِن كُلِّ أَوطَفِ",18,"ف",1,0],["وَإِنَّ شِفائي عَبرَةٌ مَهَراقَةٌ","فَهَل عِندَ رَسمٍ دارِسٍ مِن مُعَوَّلِ",19,"ل",1,0],["وإن شبهته بالبدر يوما","فللبدر الملاحة والتمام",20,"م",1,0],["وَإِن شَحَطَت يَوماً بَكَيتُ وَإِن دَنَت","تَذَلَّلتُ وَاِستَكثَرتُها بِاعتِزالِها",21,"ل",3,0],["وَإِنْ شَقِيَ النَّاسُ مِنْ حَوْلِنَا","أَفِي الحَقِّ أَنَّا مِنَ النَّاعِمِينْ",22,"ن",1,0],["وَإِنْ شَجَا مِصْرَ صَوْتِي هَلْ يَكُونُ سِوَى","صَوْتُ الْعَزِيزَيْنِ سُورِيَّا وَلُبْنَانِ",23,"ن",1,0],["وَأَنَّ شُعُوبَ الشَّرْقِ تَبْكِي دِعَامَةً","تَدَاعَتْ وَلَيْسَتْ بِالكَثِيرِ الدَّعَائِمُ",24,"م",1,0],["وَإِن شِئتَ وَصلَ الرَّحمِ في غَيرِ حيلةٍ","فَعَلنَا وقُلنا للَّذِي تَشتَهي بَلى",25,"ا",1,0],["وَإِن شئتَ صُرماً للتفرُّقِ والنَّوى","فَبُعداً أدَامَ اللَّهُ تفرقةَ النَّوى",25,"ا",1,0],["وَإِن شاءَ داعيها أَتَتهُ بِمالِكٍ","وَشُهبانِ عَمروٍ وَكُلُّ شَوهاءَ صِلدِمِ",26,"م",1,0],["وإن شَأو المعالي ليس يُدركه","عزم تسَّرب في أثنائه السَأم",27,"م",1,0],["وأنشدته يجلو الحقيقة بالنُهَى","ويكشِف عن وجه الصوابِ قناعا",28,"ع",2,0],["وإن شئتم في العيش عزّاً فأقدموا","فكم نيل بالإقدام عزٌّ وسؤدد",29,"د",1,0],["وأنشط بالعلم العزائم وابتنى","لأهليه مجداً ليس بالمتهدّم",30,"م",1,0],["وأنشدك الشعر الحقيقي تارة","فتطرب من ذكر الحقيقة في شعري",31,"ر",2,0],["وَأَنشُدُكُم وَالبَغيُ مُهلِكُ أَهلِهِ","إِذا ما شِتاءُ المَحلِ هَبَّت زَعازِعُه",32,"ع",2,0],["وَأَنشُدُكُم وَالبَغيُ مُهلِكُ أَهلِهِ","إِذا الكَبشُ لَم يوجَد لَهُ مَن يُقارِعُه",32,"ع",2,0],["وَأَنشُدُكُم وَالبَغيُ مُهلِكُ أَهلِهِ","إِذا الخَصمُ لَم يوجَد لَهُ مَن يُدافِعُه",32,"ع",2,0],["وَأَنشُدُكُم وَالبَغيُ مُهلِكُ أَهلِهِ","إِذا الضَيفُ لَم يوجَد لَهُ مَن يُنازِعُه",32,"ع",2,0],["وَاِنشَقَّ عِندَ الحِجرِ كُلُّ مُزَلَّجٍ","إِلّا يَصِح عِندَ المَقالَةِ يَنبَحِ",33,"ح",1,0],["وإنَّ شعري إذا نظمتُ في غزل","ومدحِ سلطاننا للروض وشاءُ",34,"ا",2,0],["وانشروا الآمال بعد البلى","ونفقوا الأشعار بعد الكساد",35,"د",1,0],["وأنشأه في الجود والبأس نشأةً","يبيد بها تبرُ الثرى وحديده",36,"د",2,0],["وأنشدت أمداحاً تقول لمن أتت","مدحتك بالشعرى وغيرك بالشعر",37,"ر",1,0],["وأنشأ في الطروس جنان عدنٍ","فحلّ بطرسهِ شرب الخمور",38,"ر",1,0],["وانْشر على الناسِ أمداحِي التي اشْتهرت","فإنها في معاني مجده اشْتغلت",39,"ت",1,0],["وأنشدت وبأرضِ الشام مركزها","أعلى الممالك ما يبنى على القلل",40,"ل",1,0],["وأنَّ شكرك مرصودٌ بعارفةٍ","أخرى ستأتيك لم تُبخَس ولم تُلَتِ",41,"ت",1,0],["وإن شئتُ ألْهاني سماعٌ بمثله","حمامٌ تغنَّى في غصونٍ تُوَسوسُ",42,"س",1,0],["وإنْ شئتُ ألهاني غناءان خِلْفةً","فصيحٌ ومما تنطق الطير أعجمُ",43,"م",1,0],["وَأَنشَأَ جَنّاتٍ وَأَجرى جَداوِلاً","وَمَدَّ المُروجَ الخُضرَ في كُلِّ جانِبِ",44,"ب",1,0],["وَاِنشُر جَناحَكَ فَالفَضاءُ مُنَوِّرٌ","وَاِملَء كوأُسَكَ قَد وَجَدتَ شَرابا",45,"ب",2,0],["وَأَنشُقُ الوَردَةَ في كُمِّها","لِأَنَّ فيها أَرَجاً عاطِرا",46,"ر",2,0],["وَإِن شَدا البُلبُلُ في وَكرِهِ","فَإِنَّما يَشدو لِكَي تَسمَعيه",47,"ه",1,0],["وَإِن شِئتُمُ حارَبتُموني إِلى مَدىً","فَيَجهَدُكُم شَأوُ الكِظاظِ المُغَرَّبُ",48,"ب",1,0],["وَإِن شَمَلَتني نَظرَةٌ صاحِبيَّةٌ","فَلَستُ أَرى يَوماً مِنَ الدَهرِ مُملِقا",49,"ق",2,0],["وانْشِدْ أناشيدَ الجَمال فإنَّها","روحُ الوُجودِ وسَلْوَةُ المَقْهورِ",50,"ر",1,0],["وانْشر عليه الرُّعب واثر فوقه","رُجُمَ الرَّدى وصواعقَ البأساءِ",51,"ا",2,0],["وان شئت فاحمدها وان شئت فاهجها","فليس بذي بال عقوقك والبر",52,"ر",1,0],["وأنشب في أحشائها الداء ظفره","فظلت له أحشاؤُها تتبزل",53,"ل",1,0],["وَأَنشَئوا نُزهَةً لِلجَيشِ قاتِلَةً","وَمَن تَنَزَّهَ في الآجامِ لَم يَؤُبِ",54,"ب",1,0],["وإِنَّ شفيعي توبتي وندامتي","ومعرفتي أنّ الكرامَ كرامُ",55,"م",1,0],["وإن شِفاءَ الحُبِّ أنْ يُقْلِعَ الهَوى","فَأَسلُو وهل عهدٌ بيبرِينَ راجِعُ",56,"ع",1,0],["وأُنشِئُ في الشُّورى صحائفَ طيُّها","نوافثُ سِحْرٍ للعزائمِ نُسَّخُ",57,"خ",1,0],["وأنشأتُمُ لي مهجةً جُدْتُمُ بِها","على بَدَنٍ ما فيه للروح مَنْفَخُ",57,"خ",1,0],["وأنشدتها أُبَيَّاتاً عبثت بها","تكاد تبعث في قلب الصفا طربا",58,"ب",2,0],["وَإِن شِئتَ فَاِعذُلني فَإِنَّ صَبابَتي","إِذا نَفِدَت بِالدَمعِ عادَت عَلى العَذلِ",59,"ل",1,0],["وَإِنَّ شِفاءَ النَفسِ لَو تَستَطيعُهُ","حَبيبٌ مَواتٍ أَو شَبابٌ مُراجِعُ",60,"ع",1,0],["وَإِن شِئتَ مِن عَبسٍ بِكَ مِنهُمُ","أَبٌ لَكَ طَلّابُ التُراثِ مَطالِبُ",61,"ب",1,0],["وَإِن شِئتَ حَكَّمنا أُثالاً وَرَهطَهُ","وَإِن شِئتَ حَكَّمنا رَبيعَ بنَ أَسوَدِ",62,"د",1,0],["وَإِن شِئتُ مِن حَيَّي خُزَيمَةَ جاءَني","وَخِندِفَ قَمقامُ البُحورِ اللُهامِمِ",63,"م",1,0],["وَإِن شَذَّ مِنهُ الأَلفُ لَم يُفتَقَد لَهُ","وَلَو سارَ في دارِ العَدُوِّ لَيالِيا",64,"ي",2,0],["وإن شرَعوا في لَذَّةٍ كنتَ بيعَةً","وإن طَمِعُوا في مَرفِقٍ كنتَ مَسجِدا",65,"د",2,0],["وأَنشُدُها والقُربُ بيني وبينَها","ولو آبَ حِلمي ما رجوْتُ إيابَها",66,"ب",3,0],["وَإِن شُلَّ رَيعانُ الجَميعِ مَخافَةً","نَقولُ جِهاراً وَيلَكُم لا تُنَفِّروا",67,"ر",3,0],["وَإِن شَرِبَ اِمرِؤٌ يَوماً دَواءً","فَنِعمَ اليَومَ يَومَ الأَربِعاءِ",68,"ا",2,0],["وَإِن شِئتَ أَن تَحيا سَليماً مِنَ الأَذى","فَكُن لِشِرارِ الناسِ ما عِشتَ تَرّاكا",69,"ك",2,0],["وَإِن شوهِدَت قُلتُ نَيمَختَح","أَداوي بِهِ وَجَعَ الحالِبِ",70,"ب",1,0],["وَإِن شَرَّفتَ مَجلِسَنا فَإِنّا","لَنا حَقُّ الصَداقَةِ وَالجُوارِ",71,"ر",1,0],["وَأُنشِدُ مِن مَدحي لَهُ كُلَّ جَزلَةٍ","تُحَلّى بِها أَسماعُهُم وَتُشَنَّفُ",72,"ف",1,0],["وَإِن شاءَ قَومٌ أَن يَعيبوا مَكانَهُ","مِنَ المَجدِ قالوا شامِخٌ مُتَعَذِّرُ",73,"ر",1,0],["وأنشد لا ما كنت فيهنَّ منشداً","ألا حيّ بالزُّرْق الرسوم الخواليا",74,"ي",2,0],["وإنْ شكا قالَ له دهرُهُ","احملْ فلي عندَكَ نصفُ المائهْ",75,"ه",1,0],["وَاِنشُديهِ هَل أَتَيتُ لَهُ","سَخَطاً مِنّي عَلى عِلمِ",76,"م",1,0],["وَإِن شِئتَ عاطَتكَ أَو داعَبَت","لَعوبٌ عَلى كُلِّ أَحيانِكا",77,"ك",2,0],["وَإِن شِئتِ حَرَّمتُ النِساءُ سِواكُمُ","وَإِن شِئتِ لَم أَطعَم نُقاخاً وَلا بَردا",78,"د",2,0],["وَإِن شِئتِ غُرنا نَحوَكُم ثُمَّ لَم نَزَل","بِمَكَّةَ حَتّى تَجلِسوا قابِلاً نَجدا",78,"د",2,0],["وَإِن شَطَّت بِها دارٌ تَعَيّا","عَلَيهِ أَمرُهُ بالَ الغَريبِ",79,"ب",1,0],["وَأَنشَقُ أَنفاسَ الرِياحِ تَعَلُّلاً","فَأَعدَمُ فيها طيبَ ذاكَ التَنَشُّقِ",80,"ق",1,0],["وَإِن شِئتَ مَرأى كَيفَ كَوَّنَ ثانِياً","فَدونَكَ فَاِنظُر كَيفَ كَوَّنَ أَوَّلَك",81,"ك",1,0],["وَأَنشَقُ لَوعَةً لِعَرارِ نَجدٍ","صَبا نَجدٍ أُسائِلُها شَميما",82,"م",2,0],["وانْشُرْ كِتَابكَ هادياً ومهذِّباً","فالنّاسُ ضُلَّالٌ وأنتَ إمامُ",83,"م",1,0],["وانْشُدْ ودائعَ يومِ بَدرٍ إنّه","أمسى أخاً لكَ صادقاً أو جارا",84,"ر",2,0],["وإن شَقُّوا الخنادِقَ في جِناقٍ","فقد شَقُّوا القُبورَ مُموِّهينا",85,"ن",2,0],["وإن شَدَتِ القِيانُ أجال صوتاً","يشُقُّ مرائرَ المُتطرِّبينا",85,"ن",2,0],["وَإِن شِئتَ إِعجازاً ضَرَبتَ بِذِكرِهِ","فُؤادي فَفَجَّرتَ العُيونَ بِآماقي",86,"ي",1,0],["وَإِن شارَكَتهُ في العُلى هَضبَةٌ فَقَد","تَبايَنَ زُجُّ الرُمحِ قَدراً وَعامِلُه",87,"ل",2,0],["وَإِنشِئتِ غُرنا مَعكُمُ حَيثُ غُرتُمُ","بِمَكَّةَ حَتّى تَجلِسُوا قابِلاً نَجدا",88,"د",2,0],["وَانْشُرْ أحاديثَ النَّبيِّ فكلُّ ما","تَرْوِيهِ مِنْ خَبَرِ الحَبيبِ مَليحُ",89,"ح",1,0],["وانْشَقَّ عن زائرَةٍ لم تَدَعْ","قَلْباً لضِلْعٍ غيرِ مُنْشَقِّ",90,"ق",1,0],["وَإِن شَمالاً فَمَوتٌ","لا بُدَّ لي مِن وُرودِه",91,"د",2,0],["وَإِن شِئنا حَثَثنا الطَي","رَ مِن حافاتِها زُمَرا",92,"ر",2,0],["وَأَنشَأنا بِها مِن طُ","رَفِ الرَيحانِ أَجناسا",93,"س",2,0],["وَأَنشَأنا كَراديساً","مِنَ الخَيرِيِّ أَلوانا",94,"ن",2,0],["وَإِن شَبَّتِ الحَربَ العُوانُ سَما لَها","بِصَولَةِ لَيثٍ في مَضاءِ سِنانِ",95,"ن",1,0],["وَإِن شَهِدَت عَينٌ صَفَحتَ وَأَعرَضَت","إِلى عَينِهِ العَينُ الَّتي سَتَغيبُ",96,"ب",1,0],["وَإِنَّ شَرّارَةً وَقَعَت بِوادٍ","لِتُحرِقَ وَحدَها سَمُراً بِشَرجِ",97,"ج",1,0],["وَإِن شاجَرَت في اِبنٍ لَها أَو كَريمَةٍ","عَلَيها فَياسِرها وَخَلِّ شِجارَها",98,"ر",3,0],["وَإِنشادُكَ العَودَ الَّذي ضَلَّ نَعيُهُ","عَلَيكَ فَما بالُ اِمرِئٍ حَيثَما أَمّا",99,"م",2,0],["وَإِن شِئتُما أَن تَخلُصا مِن أَذاتِها","فَحُطّا بِها الأَثقالَ وَاِتَّبِعاني",100,"ن",2,0],["وإن شئتَ فازْعُمْ أنّ مَن فوقَ ظَهرِها","عبيدُكَ واستَشْهِدْ إِلَهَكَ يَشْهَدِ",101,"د",1,0],["وَإِن شِئتُ لَم تُرقِل وَإِن شِئتُ أَرقَلَت","مَخافَةَ مَلويٍّ مِنَ القَدِّ مُحصَدِ",102,"د",1,0],["وَإِن شِئتُ سامى واسِطَ الكورِ رَأسُها","وَعامَت بِضَبعَيها نَجاءَ الخَفَيدَدِ",102,"د",1,0],["وَإِن شَدَّ فيها النَزعُ أَدبَرَ سَهمُها","إِلى مُنتَهىً مِن عَجسِها ثُمَّ أَقبَلا",103,"ل",2,0],["وإن شط عن عينيّ يوماً بك النوى","فإنك يا لَيلى تقيمين في قَلبي",104,"ي",1,0],["وإن شمل فتاها","بها هناك جميع",105,"ع",1,0],["وأنشَدْنَ مِن شِعْرِ المَطايا قصِيدةً","وأَوْدَعْنَها في الشوْقِ كلَّ مّقال",106,"ل",1,0],["وانْشُرْ ضِياءَكَ ساطعاً","ليُنِيرَ أعماقَ القُلُوبْ",107,"ب",1,0],["وَأَنْشَدْتُهُ قِطْعَةً","وَشِعْرِيَ إِحْدَى الطُّرَفْ",108,"ف",1,0],["وَإِنْ شَأَتْكَ الْمُنَى فَاقْنَعْ بِأَقْرَبِهَا","فَلَيْسَ فِي كُلِّ حِينٍ يُدْرَكُ الْوَسَطُ",109,"ط",1,0],["وَأَنْشَأَ دُوراً للصِّنَاعَات جَمَّةً","بهَا خَيْرُ عَهْدٍ للصِّنَاعَات جُدِّدَا",110,"د",2,0],["وأنشئت في أفق العلا سحب الندى","وسقيت روض المجد فهو مفوف",111,"ف",1,0],["وإن شكت مرهفات الهند من ظمأ","فسقها عللا صرفا من العلق",112,"ق",1,0],["وَأَنشَؤوا نُزهَةً لِلجَيشِ قاتِلَةً","وَمَن تَنَزَّهَ في الآجامِ لَم يَؤُبِ",113,"ب",1,0],["وإن شذوذاً أن تُثيري وتصدَعي","شَذاةَ مُحيط بالمدجاة زاخر",114,"ر",1,0],["وإنَّ شباباً يرقَبُ الموتَ جائعاً","متى اسطاعَ عن حوْضِ البلاد دفاعا",115,"ع",2,0],["وإنَّ شباباً في التبذل غاطساً","متى كان درعاً للبلاد مَناعا",115,"ع",2,0],["وإن شئت سامى واسط الكور رأسها","وعامت بضبعيها نجاء الحفيدد",116,"د",1,0],["وإن شئت لم ترقل وإن شئت أرقلت","مخافة ملوي من العد محصد",116,"د",1,0],["وإنْ شلَّ ريعانُ الجميعِ، مخافة","ً، نقولُ، جهاراً: ويحكم، لا تنفروا",117,"ر",3,0]]}