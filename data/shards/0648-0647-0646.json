ي ال","https://www.poetsgate.com/ViewPoem.aspx?id=29584",""],[51,"قدمتَ قدوم البدر بيتَ سُعُودهِ","https://www.poetsgate.com/ViewPoem.aspx?id=27697",""],[29,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""],[88,"نزلت تجر إلى الغروب ذيولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19531&r=&rc=34",""]],"verses":[["وَهُنَّ تَحتَ أَنسُعٍ","كَأَنَّهُنَّ أَنسُعُ",0,"ع",1,0],["وَهُنَّ يَبْسِمْنَ عَنْ غُرٍّ كَشَفْنَ بِها","عَنِ اللَّآلِئِ لِلرَّائِينَ أَصْدافا",1,"ف",2,0],["وهُنَّ مِلاحٌ غيرَ أنّ نَواظِراً","تُديرينَها زلّتْ بهِنَّ نِعالي",2,"ي",1,0],["وهُنّ بُدورٌ حينَ يُشْرِقْنَ في الدُّجى","فلا فارَقَتْها نَضْرَةٌ ونَعيمُ",3,"م",1,0],["وهُنَّ شُعْثٌ كالسّعالي عُوِّدَتْ","حُسْنَ المِشَى بينَ العوالي في الوَغى",4,"ا",1,0],["وهُنَّ القَوافي تَذْرَعُ الأرضَ شُرَّداً","بِشِعْرٍ إذا ما أبْطأَ الرّيحُ أسرَعا",5,"ع",2,0],["وهُنَّ كأمثالِ القِسِيِّ نَواحِلٌ","مَرَقْنَ بأمثالِ السِّهامِ الصّوائِبِ",6,"ب",1,0],["وهُنَّ يُجَرِّرْنَ الذُّيولَ على الثَّرى","مَخافَةَ أن يَستَوضِحَ الحَيُّ آثاري",7,"ر",2,0],["وَهُنَّ يَبكينَ لَنا رَحمَةً","سَقياً لِتِلكَ الأَعيُنِ الباكيِات",8,"ت",1,0],["وهْنأ بنَيْروزٍ مسَرّاتُه","قدْ أصْبَحَتْ أبوابُها شُرَّعا",9,"ع",2,0],["وَهُنَّ مُنتَصِلاتٌ كُلَّها ثَقِفٌ","تَخالُهُنَّ وَقَد أُرهِقنَ نَشّابا",10,"ب",2,0],["وَهُناكَ تَعلَمُ أَنَّ ما","قَدَّمتَ كانَ هُوَ المُطارَه",11,"ر",2,0],["وَهُناكَ يَصدُقُ ظَنُّكُم","أَن لا اِجتِماعَ وَلا زِيارَه",11,"ر",2,0],["وَهُنَّ جُهدُ مُقِلٍّ","حَليفَ هَمٍّ وَبوسِ",12,"س",1,0],["وَهَنّا جَديداهُ الزَمانَ وَأَصبَحَت","تَسوقُ لَنا الأَيّامُ ما نَتَمَنّاهُ",13,"ا",2,0],["وَهُنَّ في السِلمِ وَالأَيّامُ باسِمَةٌ","عَرائِسٌ يَكتَسينَ الدَلَّ وَالخَفَرا",14,"ر",2,0],["وَهُنَّ إِذا ما فارَقَ القَولُ ريبَةً","ضَرَحنَ الخَنا ضَرحَ الجِيادِ العَواذِمِ",15,"م",1,0],["وَهُنَّ لَدى الأَكوارِ يُعكَسنَ بِالبُرى","عَلى غَرَضٍ مِنّا وَمِنهُنَّ وَقَّعُ",16,"ع",1,0],["وَهُنَّ مِن واطِئٍ ثِنيَي حَوِيَّتِهِ","وَناشِجٍ وَعَواصي الجَوفِ تَنشَخِبُ",17,"ب",1,0],["وهُنّيت بالأمداح فيه وقد غدا","وجودك فيه بالإجادة وافيا",18,"ي",2,0],["وهُنِّئ الدينُ والدنيا على ملك","بسعده الطائرُ الميمونُ قد سَنَحا",19,"ح",2,0],["وهناك ذو بر ذو نتين قد انثنى","بهما العشيّ من الكراب نحيلا",20,"ل",2,0],["وهنّ إن شئت منّي أدمع غُزُر","أبكي بهنّ على أيامنا الغُرَر",21,"ر",1,0],["وهنيئاً أن لم تعش في العراقين","مضاعاً تنتابك الأرزاء",22,"ا",2,0],["وهنّ إذا ما يأكلون أكيلهم","وهنّ إذا ما يشربون شريب",23,"ب",1,0],["وَهَنَ الفَرَزدَقُ يَومَ جَرَّبَ سَيفَهُ","قَينٌ بِهِ حُمَمٌ وَآمٍ أَربَعُ",24,"ع",1,0],["وهن يحسُون دون العَبّ ما خلطت","بالماء من كدر الآفةُ السُّلُبُ",25,"ب",1,1],["وَهُنَّ وَإِن جانَبتُ ما يَشتَهينَهُ","حَبائِبُ عِندي مُنذُ كُنَّ أَثائِرُ",26,"ر",1,0],["وهنَّئتَ بالجناتِ يا تارِكي على","سعيرٍ من الأحزانِ بعدَك مشبوب",27,"ب",1,0],["وهنئتها أو هنئت خلعاً إذا","أضاءَت فمن أطواقها مطلعُ الهدى",28,"د",2,0],["وهنئت بالفطر الذي قام ناحراً","عداتك حتَّى أشكل الفطر بالنحر",29,"ر",1,0],["وهنئت بالأعوامِ يصفو جديدها","عليك بإقبالٍ ويطوى خليعها",30,"ع",3,0],["وهنئ أفق الشام رجعة نير","مليٍّ بإسعاد الرعيَّة والرعا",31,"ع",2,0],["وهنَّ الليالي حاكِماتٌ على الورى","بنقضٍ ولا يبقى عليهن ماكثُ",32,"ث",1,0],["وهنيئاً لكَ العَطاء وما أُرْ","دفَ مِنْ رَغْمِ شانئٍ وحَسُودِ",33,"د",1,0],["وُهُنٌ كآنية الزجاج تَصادمتْ","فهوتْ وكلٌّ كاسِرٌ مكسور",34,"ر",1,0],["وهنيئاً لك الثواب إذا هن","نِئَ والٍ بأن أصاب متاعا",35,"ع",2,0],["وهنيئاً لك الفضولُ من اللح","مِ ففاخِر بها ذواتِ الحجالِ",36,"ل",1,0],["وهُنِّئتُمُ ما نلتُمُ من كرامةٍ","إلى كرمٍ فُزْتُمْ به ومَكارِمِ",37,"م",1,0],["وهنيئاً لحرمتيكَ هنيئاً","حازتا فحلتي بغَيْرِ قسيمِ",38,"م",1,0],["وهُنِّئتَ ما أُعطيتَهُ من كرامةٍ","وهُنِّئكَ المِعطاك باني المكارمِ",39,"م",1,0],["وَهُنَ أَذَقنَ المَوتَ جَزءَ بنَ ظالِمٍ","بِماضِيَةٍ بَينَ الشَراسيفِ وَالقُصبِ",40,"ب",1,0],["وَهُنَّ عِندَ اِغتِرارِ القَومِ ثَورَتَها","يَرهَقنَ مُجتَمَعَ الأَذقانِ بِالرُكَبِ",41,"ب",1,0],["وَهُنَّ بِنا عوجٌ كَأَنَّ عُيونَها","بَقايا قِلاتٍ قَلَّصَت لِنُضوبِ",42,"ب",1,0],["وَهُنَّ مُكتَإِباتٌ","كَأَنَّهُنَّ صُخورُ",43,"ر",1,0],["وَهُنالِكَ بارَكَني وَهَنَّأَني","مَن هَنَّأوا قَبلي الفَتى هِنري",44,"ي",1,0],["وَهَنَت أَعصابُهُم لَمّا سَطا","وَالطَوى يوهِنُ عَزَماتِ الأُسود",45,"د",1,0],["وَهُنا تَقَهقَرَ وُليَمٌ ثُمَّ اِختَفى","ما بَينَ لَيلٍ حالِكٍ وَدُخانِ",46,"ن",1,0],["وَهُنِّئتَ أَبناءً كِراماً أَعِزَّةً","رَأَيتَ لَهُم مِثلَ الضَراغِمِ أَشبُلا",47,"ل",2,0],["وَهُنَّئَ بي قَومٌ وَما إِن هَنَأتُهُم","وَأَصبَحتُ في قَومٍ وَلَيسوا بِمُنيَتي",48,"ت",2,0],["وَهُنَّ يُحاذِرنَ الرَدى أَن يُصيبَني","وَمِن قَبلِ خَلقي خُطَّ ما كُنتُ لاقِيا",49,"ي",2,0],["وهُناكَ حيثُ تُعانِقُ","البَسَماتُ أَنْغَامَ الغَزَلْ",50,"ل",1,0],["وهناكَ مَا بَيْنَ الضَّبابِ","الأَقْتَمِ السَّاجي الكئيبْ",50,"ب",1,0],["وهناكَ اصطفى البقاءَ مع الأَموات","في قبرِ أَمسِهِ غيرَ آبِهْ",51,"ه",1,0],["وهناكَ في أمنِ البيوتِ تطارحوا","غَثَّ الحديثِ وميِّتَ الآراءِ",52,"ا",2,0],["وهناك تشترك النفوس بحسها","وهناك اشتات القلوب تألف",53,"ف",1,0],["وهناك المجر فانظر","ملياً الى المجر",54,"ر",1,0],["وهناك الحور الحسان يقعقعن","حواليك الكأس والابريقا",55,"ق",2,0],["وهناك من هو للاسى مستعبر","وهناك من هو للمسرة شاد",56,"د",1,0],["وهناك بحر ثائر","امواجه لا تستقر",57,"ر",1,0],["وهناك مفتخر بايقاع الاذى","وكأن من يؤذي سواه سميذع",58,"ع",1,0],["وهناك من هو جاحد","ما اتعس العين الحسيره",59,"ر",2,0],["وهناك اعمى فهو قد","يرتاب في شمس الظهيره",59,"ر",2,0],["وهناك لولا أبعد ال","أبعاد نيران لواهب",60,"ب",1,0],["وَهُناكَ اِبتَلَعَ اللَيثُ الوَزير","وَحَبا الثَعلَبَ مِنهُ بِاليَسير",61,"ر",1,0],["وَهَنَّأتُ بِالرُتَبِ العَبقَرِيِّ","وَهَنَّأتُ بِالعَبقَرِيِّ الرُتَب",62,"ب",1,0],["وَهُناكَ أَطلالُ الفَصا","حَةِ وَالبَلاغَةِ وَالنَبالَه",63,"ل",2,0],["وَهُناكَ أَزكى مَسجِدٍ","أَزكى البَرِيَّةِ قَد مَشى لَه",63,"ل",2,0],["وَهُناكَ عُذرِيُّ الهَوى","وَحَديثُ قَيسٍ وَالغَزالَه",63,"ل",2,0],["وَهُناكَ مُجري الخَيلِ يَج","ري في أَعِنَّتِها خَيالَه",63,"ل",2,0],["وَهُناكَ مَن جَمَعَ السَما","حَةَ وَالرَجاحَةَ وَالبَسالَه",63,"ل",2,0],["وَهُناكَ خَيَّمَتِ النُهى","وَالعِلمُ قَد أَلقى رِحالَه",63,"ل",2,0],["وَهُناكَ سَرحُ حَضارَةٍ","اللَهُ فَيَّأَنا ظِلالَه",63,"ل",2,0],["وَهُنالِكَ اِزدَهَتِ السَماءُ وَكانَ أَن","آنَستُ نوراً ما أَتَمَّ وَأَبهَرا",64,"ر",2,0],["وَهُنَّ حَولَكَ يَنظُر","نَ وَالأُحَيراحُ رَطبَه",65,"ب",2,0],["وَهُنَّ مَعَ الغِزلانِ في الوادِ كُمَّنٌ","وَهُنَّ مَعَ العِقبانِ في النيقِ حُوَّمُ",66,"م",1,0],["وَهَنَتكَ عافِيَةِ الأَميرِ فَإِنَّهُ","قَد راحَ مُجتَمِعَ العَزيمَةِ وَاغتَدى",67,"د",2,0],["وَهُنّيتَ تَكرُمَةً ساقَها","إِلَيكَ نَدي الكَفِّ فَيّاضُها",68,"ض",3,0],["وَهُنَّ بِشِرحافٍ تَدارَكنَ دالِقاً","عُمارَةَ عَبسٍ بَعدَما جَنَحَ العَصرُ",69,"ر",1,0],["وَهُنَّ عَلى خَدَّي شُتَيرِ بنِ خالِدٍ","أُثيرَ عَجاجٌ مِن سَنابِكِها كُدرُ",69,"ر",1,0],["وَهُنَّ رُدافى يَلتَفِتنَ إِلَيكُمُ","لِأَسوُقِها خَلفَ الرِجالِ قَعاقِعُ",70,"ع",1,0],["وهنا أذلَّ إباءه متكبر","أمرت عيون قلبه فأطاعا",71,"ع",2,0],["وَهُناكَ فَأتوني بِخَرعَبَةٍ","غَرّاءَ آنِسَةٍ مِنَ اللُعسِ",72,"س",1,0],["وَهَنتَ حِسّاً وَهُنتَ نَفساً","فَلا ذَكاءَ وَلا زَكاء",73,"ا",2,0],["وَهُنِّئتَها مِن دارِ مُلكٍ وَهُنِّئَت","بِهِ مَلِكاً وَاللَهُ يُعطي وَيَمنَعُ",74,"ع",1,0],["وَهَنَ البِناءُ فَعاثَ في فَجواتِه","عَادِي الفسادِ مُدَمِّراً ومُخَرِّبا",75,"ب",2,0],["وهَن العَظمُ بِالبِعَادِ فَهَب لِي","ربّ بِالقُربِ مِن لَدُنك ولِيَّا",76,"ي",2,0],["وهناكَ سمْسارُ البلا","دِ فإنه الشَّهْمُ الأغرُّ",77,"ر",1,0],["وهناكَ لا شكوى من الطغيانِ","وهناك فيْضُ العفْوِ والغفرانِ",78,"ن",1,0],["وَهُنا طائِرٌ يُعيد حَديثاً","لَم تَغب عَنهُ هَذِهِ الكَلِماتُ",79,"ت",1,0],["وهنا التخاذُلُ في الشَّدا","ئد والتشَّاؤُمُ والتَّواني",80,"ن",2,0],["وَهناً بِعَرجٍ وَالغَضا مَسكَني","قَد شَطَّ عَن ذَلِكَ مَن بِالغَضا",81,"ض",2,0],["وَهُنَّ في مَجلِسٍ خالٍ وَلَيسَ بِهِ","عَينٌ عَلَيهِنَّ أَخشاها وَلا بَرَمُ",82,"م",1,0],["وَهِندٌ أَتى مِن دونِها ذو غَوارِبٍ","يُقَمَّصُ بِالبوصِيِّ مُعرَورِفٌ وَردُ",83,"د",1,0],["وَهُنَّ يَلحَقنَ بِالمِعزاءِ مُجمِرَةً","خُشمَ الأُنوفِ نَرى في خَطوِها رَوَحا",84,"ح",2,0],["وَهُنَّ يَرفَعنَ صُراخاً كَما","جَهوَرَ في الشَعبِ المُلَبّونا",85,"ن",2,0],["وهندٍ والربابِ وفرتناهم","وعن أم الجُنَيدبِ مع لميس",86,"س",1,0],["وَهُنَّ كَأَنَّهُنَّ نِعاجُ رَملٍ","يُسَوّينَ الذُيولَ عَلى الخِدامِ",87,"م",1,0],["وَهِنْدٌ مَا لَها شِبْهٌ","بِشَرْقٍ لا وَلا غَرْبِ",88,"ب",1,0],["وَهُناك أَيقاظ ترا","هم يغمضون العين عمدا",89,"د",2,0],["وهناك أَندية شدوت بها كَما","في الرَوض يَشدو البلبل الصيداح",90,"ح",1,0],["وَهُناك ناس جاهِلون يَرون في","أمر الزَلازل أصبع الشَيطان",91,"ن",1,0],["وهن قبل ثغور","يَبدو عليها ابتسامُ",92,"م",1,0],["وهناك تشتهر العدالة بينهم","وتعم حتى تشمل الحيوانا",93,"ن",2,0],["وهناك تبتسم المنى في أَوجه","صعب عليها أن ترى حرمانا",93,"ن",2,0],["وَهناك قنابل ناسفة","وَهناك قذائف تنفجر",94,"ر",1,0],["وَهناك حراب قَد لمعت","وَهناك بطون تبتقر",94,"ر",1,0],["وَهناك وجوه ساهمة","وَهناك قلوب تنفطر",94,"ر",1,0],["وَهناك جموع قد هجمت","وَهناك صفوف تندحر",94,"ر",1,0],["وَهنا وادٍ لا أَهبطه","وهنا جبل لا أَصعده",95,"د",2,0],["وَهُناكَ غربانٌ تَطير وَراءه","نصراً لِذاكَ الأجدل المَغرور",96,"ر",1,0],["وَهُناكَ نعمى لَو أَمُرُّ بفيضها","فأصيب منه للحياة كفافي",97,"ي",1,0],["وَهُناك قسم لا يحو","ر إذا تَناهى في النفار",98,"ر",1,0],["وَهناك أجرام عَلى","كر الدهور جمدن بردا",99,"د",2,0],["وهُنتِ على مهدِ الفنونِ وطالما","سموتِ بسلطان من الفنِّ قاهرِ",100,"ر",1,0],["وهُنا كرمةُ الخلو","دِ فطوبى لمن عَصَرْ",101,"ر",1,0],["وهُنّ مُنيفاتٌ إذا جُبْنَ وادياً","توَهّمْنَنا منهُنّ فوْقَ جِبال",102,"ل",1,0],["وهُناكَ أَنْوارُ النَّهارِ تُطِلُّ","مِنْ خَلْفِ الغُروب",103,"ب",1,0],["وَهُنَاك رَابِيَةُ التَّجَليِّ لَمْ تَزَلْ","تُزْهَى بِنُورٍ مِنْ ضَرِيحِ الْفَادِي",104,"د",2,0],["وَهَنِيئاً لك احْتِفَاءُ كِرَامٍ","جَمعتْهمْ رِحَابُ هذَا الطِّرافِ",105,"ف",1,0],["وَهَنِيئاً لِلْمَحْتِدَيْنِ الكَرِيمَيْنِ","ارْتِبَاطٌ بِه تُعَزُّ الرِّبَاعُ",106,"ع",1,0],["وَهَنِئْتَ وَلْيَهْنَأ بَنُوكَ","وَمجْدُ هَذَا الْبَيْتِ زَاخِرْ",107,"ر",1,0],["وهنت مِما فجِعتُ بِاِبني","وَهنتُ فَليَنتَفِ المُناوي",108,"ي",1,0],["وَهُنتُ عَلى أَنّي فَتى الفِئَةِ الَّتي","غَطارفَةُ الدُنيا إِلى نارِهِم تَعشو",109,"و",1,0],["وهنأك الله الذي أنت أهلُهُ","برغم العدى من رأي خير أمير",110,"ر",1,0],["وَهِندٍ وَما أَدَّت سُمَيَّةُ وَاِبنُها","أولو الكُفرِ في الإِسلامِ وَالفَجَراتِ",111,"ت",1,0],["وَهُنَا بَدَا الْقَدَرُ الْمُعَرْبِدُ ضَاحِكاً","وَمَضَى الضبابُ ولاَ يَزَالُ يُقَهْقِهُ",112,"ه",1,0],["وَهناءً مَليكَ مِصْرَ المُفَدَّى","نِلْتَ فَاشْكُرْ للَهِ خَيْرَ مَنال",113,"ل",1,0],["وهنَّأ بعضُنا بعضًا؛ كأنَّا","تبادلنا التَّهانئَ يومَ عيد",114,"د",1,0],["وهنا رأيت الكأس تسقط من يدي","فظمئت، والماء القَراح إزائي!",115,"ا",2,0],["وهناك أخبره التعثر أنه","يمضي ويرجع وهو طاو حاف",116,"ف",1,0],["وهناك الشهب غربان، بلا","أعين، تجتاز غيماً لانهائي",117,"ا",2,0],["وهنا الشمس عجوز، تحتسي","ظلها، تصبو إلى تحديق رائي",117,"ا",2,0],["وهناك مذعور ، بلا","حان على الأشواك عاكف",118,"ف",1,0],["وهنا ، تحدّى الرعب ، أو","داراه ، أو ألف المخاوف",118,"ف",1,0],["وهنا الدجى يسطو على كوخي كما","يسطو على المستضعف العملاق",119,"ق",1,0],["وهنا وراء الكوخ بستان ذوتْ","أغصانه وتهاوت الأوراق",119,"ق",1,0],["وهُنيهة نرتاد مُرتفِعاً","من هَضْب \" لبنانٍ \" ومُنْزَلِقا",120,"ق",2,0],["وهناكَ سوفَ يَرى الغَنيِمةَ معشرٌ","أنْ يُمْسِكُوا من خَلْفِكُمْ بغُبار",121,"ر",1,0],["وهناك سوفَ تَرى النواظرُ مالئاً","كرسيَّهُ قُطباً من الأقطاب",122,"ب",1,0],["وهنا التي فاضت بجرح ناغِرٍ","مَضَت السنونَ الجارحاتُ وما مضى",123,"ض",2,0],["وهنا التي فتَّشتُ عن شَبحٍ لها","فذا به مثل الخِضاب وقد نضا",123,"ض",2,0],["وهناكَ دَينٌ للبلاد قضاءُه","حتمٌ عليَّ ، وقد اعيشُ فيُقتَضَى",123,"ض",2,0],["وهنَّ كماءِ المُزْنِ لطفاً ورقةً","وهنَّ إذا جدَّ النضالُ مَعاول",124,"ل",1,0],["وهنودا حمرا .. وقطارا",".. ويحرك آلاف العسكر",125,"ر",1,0],["وهنود حمرا وقطارا","ويحرك آلاف العسكر",126,"ر",1,0],["وهنيئاً لك الثواب إذا هُن","نِىء والٍ بأن أصاب مَتاعا",127,"ع",2,0],["وهنأك الله الكرامة خافضا","وفي كل حال يا ابن مَجْدٍ وعودِهِ",128,"د",2,0],["وهُنَّ عِندَ اغْترارِ القَوْمِ ثورَتَها","يَرْهَقْنَ مُجتَمَعَ الأذقانِ للرُّكبِ",129,"ب",1,0],["وهناك دون برذونتين قد اثنى","بهما العشيَّ من الكراب نحيلا",130,"ل",2,0]]}