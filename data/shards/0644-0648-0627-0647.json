{"poems":[[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[107,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[119,"على رسلك اصبر يا رسول التلفهي","https://www.aldiwan.net/poem40895.html","عموديه"],[445,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[453,"بعثت لكم مثلى مشوقا قد انطوى","https://www.aldiwan.net/poem53726.html","الطويل"],[469,"لواه القضاء بفرط السلام","https://www.aldiwan.net/poem3116.html","عموديه"],[500,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64732","البسيط"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111441","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["لواهُ للأفلاكِ ما لاحت بها","شهبٌ تنيرُ دياجيَ الظلماءِ",0,"ا",2,0],["لَواهُ عن السَّبيلِ قَضاءُ ربٍّ","له الحِكَمُ الصّوادِعُ والعِظاتُ",1,"ت",1,0],["لواه لبذل البر طور محكم","به لم يكن مستكرها بالتكلف",2,"ف",1,0],["لَوَاهٍ عن الأَكفاءِ عِزَّاً وإِن تَقُلْ","لَهَا بالقنا الخَطِّيِّ خِطْبٌ تَقُلْ نِكْحُ",3,"ح",1,0],["لواها غرام في هواكم وصبوة","وأضناه هجر منكم وبعاد",4,"د",1,0],["لواه القضاء بفرط السلام","فهذا القضاء كفوت الأدا",5,"د",2,1],["لواهِنُ الظهر سخين العين","معترضٌ للحين بعد الحين",6,"ن",1,0],["لَو اهْتَدَى لائمي عليهِ","ناحَ على نَفْسِهِ وعَدَّدْ",7,"د",1,0],["لَواها عَنِ الماءِ حَتّى أَبَت","لِحُبِّ الوُرودِ أَنيقَ الأَكالِ",8,"ل",1,0],["لَو آهِ زَفسُ وآلُهُ مَنُّوا وما","احكَمتُما كُلُّ الكتَائِبِ أَحكَمُوا",9,"م",3,0],["لَوَاهُ أَياسُ بِطَعنتِهِ","فَغَارَت بِقَلبِ تَرِيكتِه",10,"ه",1,0],["لواها ولكن أخيل وثب","عليه ببتاره وضرب",11,"ب",1,0],["لو أهلك الغر للإسلام قد فطنوا","ما ودعوك فما بالدين تقصيرُ",12,"ر",1,0],["لواه يوم انه على الحب يلتوي","ومن دينه دين الجميل اوفاه",13,"ا",2,0],["لواه وإلا لا قرار يطيب لي","عليه وإلا لا تفيض عبرتي",14,"ت",2,0]]}