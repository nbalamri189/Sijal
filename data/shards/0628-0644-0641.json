لوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138771",""],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123456","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139681",""],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140137",""],[4767,"غارة الذئاب","https://www.poetsgate.com/ViewPoem.aspx?id=178790",""],[1901,"لا تعجبوا إن قلتُ بانتْ سعادْ","https://www.poetsgate.com/ViewPoem.aspx?id=160414",""],[182,"","https://www.poetsgate.com/ViewPoem.aspx?id=72802",""],[4955,"قلبي تألم مما كان في الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190115",""],[5038,"أبحث عن وطن","https://www.poetsgate.com/ViewPoem.aspx?id=189952",""],[5101,"بلفور عِد ما شئت","https://www.poetsgate.com/ViewPoem.aspx?id=193170",""],[5135,"قالت: أراك مغرداً","https://www.poetsgate.com/ViewPoem.aspx?id=201786",""],[5183,"رزء العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180254",""],[5186,"لم يبق لي في الساح جولة جائل","https://www.poetsgate.com/ViewPoem.aspx?id=156459",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5431,"عنه الظلامُ بحول الله منكفئُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=201569",""],[5595,"احملْ جراحَك وابتسمْ","https://www.poetsgate.com/ViewPoem.aspx?id=145122",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5742,"لطائف الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=206976",""],[5929,"خارطة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=197059",""],[5956,"الكِذْبُ في قلبي وقلبكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192187",""],[5956,"لا عدل في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192298",""],[5956,"الوعود البلفورية","https://www.poetsgate.com/ViewPoem.aspx?id=192302",""],[5956,"ومضة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=193456",""],[6124,"رنات عود","https://www.poetsgate.com/ViewPoem.aspx?id=201238",""],[6256,"كلمات إليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65934&r=&rc=22",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""]],"verses":[["بِلَفظٍ فاسِقِ اللَحَظاتِ تُنمى","مَحاسِنُهُ إِلى مَعنىً حَصانِ",0,"ن",1,0],["بَل في اِنتِزاعِ المَجدِ مِن سَكَناتِهِ","بِمَطالِبٍ تَسطو عَلى الأَيّامِ",1,"م",1,0],["بل فضلة المعدة وهي التي","تنثُرها معْدَتُه الفاسدهْ",2,"د",2,0],["بل فيه خِيم على الخيرات يحفِزهُ","ناهيك من حافز في خير محفوزِ",3,"ز",1,0],["بل في المعالي حملُهُ وإنْ ثَقُل","وليس أخلاقُكَ بالجُنْد الخُذُل",4,"ل",1,0],["بل فيك سُرْبٌ وطولُ خطْمٍ","ولم يزلْ هكذا النغُولُ",5,"ل",1,0],["بل فتىً ذو خَليقةٍ تَضْرحُ اللَّعْ","نَ إذا اللعنُ جرَّهُ مَلْعونه",6,"ن",2,0],["بل في فَجاجِ الموتِ في عالَمٍ","لا يرقُصُ النُّورُ بِهِ والظِّلالْ",7,"ل",1,0],["بل في التُّرابِ المَيْتِ في حَزْن الثَّرى","تنمو مَشاعِرُهُمْ مع الأعشابِ",8,"ب",1,0],["بَل فاتَني الثاني وَكانَت هِمَّتي","تَرى خَلاءَ الجَوِّ مِنهُ واجِبا",9,"ب",2,0],["بلفورُ بئسَ الوعدُ وعدُك للأُلىَ","جَعلوكَ للأَمَلِ المُخيَّبِ سُلَّما",10,"م",2,0],["بلفورُ أنزلها وَباءَ بإثْمِها","والظُّلمُ إثمٌ كلُّه وفسادُ",11,"د",1,0],["بَل فَلسطين بِالشَياطين مَلأى","ضَجَتِ الأنس مِنهُم وَالجان",12,"ن",1,0],["بلفور كَأسك مِن دَم الش","شهداء لا ماء العنَب",13,"ب",1,0],["بلفور يَومك في السَما","ء عَلَيك صاعِقَة السَماء",13,"ا",2,0],["بَلْ فَوْقَ مَا قَدَّرَتْهُ","مُنَى الضَّمِيرِ الُمَناجِي",14,"ج",2,0],["بِلَفْظَةٍ أَوْ لَحْظَةٍ مِنْهُم","تَقْبَلُ مَا مَرَّ كَمَا لَوْ حَلاَ",15,"ل",2,0],["بِلَفْظٍ عَلَى كَوْنِهِ مُعْجَماً","حَكَى حُسْنُهُ المُعْرَبَ الجَيِّدا",16,"د",2,0],["بل فتى ً ذو خَليقة ٍ تَصْرحُ اللَّعْ","نَ إذا اللعنُ جرَّهُ مَلْعونه",17,"ن",2,0],["بل فضلوا أسر الوفاء على","القيادة ناكثين",18,"ن",1,0],["بل في قلوب هؤلاء أحن","ظهرن للخصم فشد قلبا",19,"ب",2,0],["بَل فَضلُ مِثلِيَ أَن يَسمُو بِهِمَّتِهِ","عَن مَدحِ فَدمٍ عَن العَلياءِ في شُغُلِ",20,"ل",1,0],["بَلْ فِي رِضَاهُ رِضَاهُمْ وَهْوَ مَا شَهِدَتْ","بِهِ الْهُدَى وَالنَّدَى وَالْخُلُقُ السَّبِطُ",21,"ط",1,0],["بلفظِكِ وابتسامِكِ همتُ حتى","رأيتُ الصبحَ بينهما يلوحُ",22,"ح",1,0],["بل في معاصي وفي أشيا","ذي فعلها يرضى الشيطان",23,"ن",1,0],["بل فضله بعد الممات مضاعف","أتت النصوص به على الإِطلاق",24,"ق",1,0],["بل فاتكاً لا يهز الخطب جانبهُ","قد عالج الدهر أحلاء وامرارا",25,"ر",2,0],["بل فاصحفي عن ذنبه","فإنه وسيلتي",26,"ي",1,0],["بل فصولُ الحياةِ موتٌ معادٌ","تتساوى فكلُّها حِرمانُ",27,"ن",1,0],["بلفظةٍ منه يُشْفى داءُ مُعْضلةٍ","أعيا على فُصحاءِ الناس شافيها",28,"ي",3,1],["بلفظٍ يَغارُ الروضُ منه وقد بدا","يروقُكَ مُوشِيَّ اللَّباسِ مُنَمْنمَا",29,"م",2,0],["بلْ فاوضُونيْ علَىْ البقاءِ","ميْتاً لِكيْ يأْمنَ الجلِيبُ",30,"ب",1,0],["بل فاستَمِع لِذَوي الوفا","ء ذوي الضَّمائرِ والذّمام",31,"م",1,0],["بل في التواصل واللقا","وموارد الماء المعين",32,"ن",1,0],["بل فليسوفا لا يشق غباره","أمسى باسمى حكمة موصوفا",33,"ف",2,0],["بل فاق آثار الملوك بأسرها","فالعجز عن أوصافه إفصاح",34,"ح",1,0],["بل فضلكم عم نجداً والحجاز وما","إليهما انضم وهد ومن رابي",35,"ب",2,0],["بل فاتعظ فالوعظ أفضل رادع","للنفس عن ذي الخطة العوجاء",36,"ا",2,0],["بل في نعيمٍ مقيمٍ والكريمُ لهم","جارٌ وما اقتَرحُوا ألفوه مُجتلَبا",37,"ب",2,0],["بِلَفظ في بَراعته","كَسِحر اللَحظ في الهُدب",38,"ب",1,0],["بلفظٍ لو بدا لحليف شَيبٍ","لفارقه وعاد إلى شبابه",39,"ب",2,0],["بَل فيكَ صَبري حَميدٌ","وَكَم شَجى فيكَ مَلّا",40,"ل",2,0],["بَل فيهِ صِلني مِثلَما عَوَّدتني","فَذَلكَ المحمودُ يا ذا الفطنِ",41,"ن",1,0],["بَلفورُ ما بِلفورُ ماذا وَعُدُهُ","لَو لَم يَكُن أَفعالنا الإِبرامُ",42,"م",1,0],["بل في بدر الفهم والبد","ر الذي يجلو الدجيه",43,"ي",2,0],["بَل فَقُل لِي يا سَمِيرِي في الغَرامِ","أَبُرَيقٌ لاحَ مِن نَحوِ الغَمامِ",44,"م",1,0],["بِلَفظَةٍ قَبيحة","أَو نكتَةٍ مَليحة",45,"ه",1,0],["بل في الحوادِثِ والحوا","ئجِ والنوائبِ والنُّوَبْ",46,"ب",1,0],["بل فيه قد غُضَّت لحا","ظُ الفخر من بعد الطِماح",47,"ح",1,0],["بل في أمين الحلم نفسُ كاظمٍ","للغيظ مما ساء من حسّادها",48,"د",3,0],["بلفظ أعجم وله معنى فصيح يفهم","وإنما القصد في الألفاظ معانيها",49,"ي",3,0],["بل فيه يكشف ما يرو","ع عن الأنام ويُستراب",50,"ب",1,0],["بلفظٍ واحد أجملت فيه","لهن القولَ باللفظ المصونِ",51,"ن",1,0],["بل في رِضاء الله لمّا اغتدى","يمْتَحُ في الفِسْق مع الماتِحِ",52,"ح",1,0],["بَل فاضَ وَادٍ فِى سَماوَةَ وَهىَ لاَ","ماءٌ بِها يُروِى الظَّماءَ وَلا مَطَر",53,"ر",1,0],["بل فعله عين الشريعة","ليس فيه منكر",54,"ر",1,0],["بلفظٍ تراه في الحقيقةِ معجزا","لزور الذي يأتي به الخصم مزهق",55,"ق",1,0],["بَل فِعلُه المَفعُولُ خَارِجُ ذَاتِهِ","كَالوَصفِ غَير الذَّاتِ في الحُسبانِ",56,"ن",1,0],["بَل فَرَّقَ الإِنكَارُ منهُ بينَهُم","لَمَّا سَرَى فِي وَهمِهِ غَيرَانِ",56,"ن",1,0],["بَل فِطرةُ اللهِ التَي لَم يُفطرُوا","إلاَّ عَليهَا الخلقُ والثَّقَلاَنِ",56,"ن",1,0],["بَل فِي مَحل الحَذفِ يَكثُرُ ذِكرُهُ","فإذَا هُم ألِفُوهُ إلفَ لِسَانِ",56,"ن",1,0],["بَل فَسَّرُوهُ بِأن قَدرَ الله أع","لَى لاَ بِفَوق الذَّات لِلرَّحمَنِ",56,"ن",1,0],["بَل فِطرَةُ اللهِ التَي فُطِرُوا عَلَى","مَضمُونِهَا وَالعَقلُ مَقبُولاَنِ",56,"ن",1,0],["بَل فَكِّرُوا بِعُقُولِكُم إن شِئتُمُ","أو فَاقبَلُوا آراءَ عَقلِ فَلاَنِ",56,"ن",1,0],["بَل فِي الَّتِي قَد خَالَفَت قَولض الرَّسُو","لِ وَمُحكَمَ الإِيمَانِ وَالفُرقَانِ",56,"ن",1,0],["بل في جميع الشهر سعدك راجعا","بالصالحاتِ لنا أسر رجوعِ",57,"ع",1,0],["بل فضلُكَ العظيمُ قد أقالَنى","منها إلى مَحضِ النّدا أحالنى",58,"ن",2,0],["بَل فيك لَو تَدري الشعاع المنعكس","مِن نُور طَلعته الأَشعة تقتبس",59,"س",1,0],["بَل فيكَ نُور اللَه جلَّ جَلاله","لِذَوي البَصائر يَستشف فَيَلمَع",59,"ع",1,0],["بل فيهمُ الميلُ إلى السماكِ","لا تُهمِلُوهُ أيُّها الزواكي",60,"ي",1,0],["بَل في تَوَاريخِ الذينَ سَلفُوا","أفشاتُ مَع جزائِرٍ لَم يُعرَفُوا",61,"ف",3,0],["بَل فيهِ أَمكِنَه وفيهِ الرُّكُب","يَرميكَ عَنهَا المَدُّ وُقِّيتَ التَّعَب",62,"ب",1,0],["بَل فَاِعتَقِد أَنَّ اللَيالي طَبعُها","لَن تَترُكَ الكَسلانَ يَنجَحُ بِالصُدَف",63,"ف",1,0],["بَل في الدُروسِ عَلى الطُروسِ وَفي الوُقو","فِ مَعَ الصُفوفِ وَلِلعُلومِ قَد اِعتَكَف",63,"ف",1,0],["بَل في المَحابرِ وَالدَفاتِرِ وَالمَسا","طِرِ وَاليَراعَةِ وَالبَراعَةِ وَالصُحُف",63,"ف",1,0],["بَل في نَشاطٍ وَاِشتِراطٍ أَن تُرى","صديانَ مِن بَحرِ الثَقافَةِ تَغتَرِف",63,"ف",1,0],["بَل فَالتَدَرُّبُ قَد يُقَرِّبُ لِلبَلي","دِ مِنَ البَعيدِ جَنى المُفيدِ إِذا اِقتَطَف",63,"ف",1,0],["بَل في يَنايِرَ لَن أُغايِرَ بَل أُنا","فِسُ مَن أُجالِسُ راجِياً ألّا أَسِفّ",63,"ف",1,0],["بلفظ ومعنى حيث لم يمض سبعة","وإلا فلا إيطاء إذ هم به جاؤا",64,"ا",2,0],["بل فضلت صعلوكها ال","فنان ذا الكوخ الحقير",65,"ر",1,0],["بَل فقهنا مِمَّا تقُولُ كَثِيراً","وشرِبنا من سلسَبِيلكَ جَامَا",66,"م",2,0],["بل فاز مسعاه بطيبة ينبع","عذبت مناهله كموقف زمزم",67,"م",1,0],["بل في اعتقادي ان سيتلوه النجا","زُ إذ النجاح مؤكد تأليفه",68,"ف",2,0],["بل فر منه وعذ باللّه من مرض","به ابتلى وامتثل للامر وانهزم",69,"م",1,0],["بل فامش وانهض اليها بالسكون ولا","تهمل للاذكار اصلا لا ولا ترم",69,"م",1,0],["بل فضلها في مباني الأرض أجمعها","كفضل دولة بانيها على الدول",70,"ل",1,0],["بلفظ لجيد الحور فيه مآربٌ","ومعنىً أعار السكر مرتشف المرد",71,"د",1,0],["بَل فيهِ الوية الفُخار تَنكسَت","مِنها الرُؤوسُ كَأَنَّها تَتَفَكَّرُ",72,"ر",1,0],["بل فيك تنطلق العيو","ن وفيك ينعقد اللسان",73,"ن",1,0],["بل فتنة أي نفس","على صدودك تقوى",74,"ق",3,0],["بلفظة واحدة قد جمعا","مرتكباً محرماً مبتدعا",75,"ع",2,0],["بَل فَاِعجَبي مِن كِلابٍ قَد خَدَمتُهُمُ","تِسعينَ عاماً بِأَشعاري وَطُنبوري",76,"ر",2,0],["بلْ فاجعلنّي من الذي سبقْ","إليه معْ من سبقوا بحقٍّ وحقْ",77,"ق",1,0],["بل فاستُرَنَّها عن الجمادِ","وعن ملائكٍ على العبادِ",78,"د",1,0],["بَل فيكَ جبريلٌ وميكالٌ وإس","رافيل والملأُ المقدَّس أجمعُ",79,"ع",1,0],["بَل فِيكَ نُورُ اللَّه جَلَّ جَلالُه","لِذوي البَصائر يَستشفُّ ويَلمعُ",79,"ع",1,0],["بَل في أَماكن بوركت وَتَأهبت","وَترحبت بِقدوم لِفَخر طائِرِ",80,"ر",1,0],["بلفورُ إن اليومَ عيد","فَألبس له الثوبَ الجديدْ",81,"د",1,1],["بلفظٍ ظاهرٍ في لبس جَهلِ","دعي فرط البَكايا يا روح سؤلي",82,"ي",1,0],["بل فضلُ صنعك واجب فالقولُ إن","داخلته لم يلفَ غير مُثَبَّجِ",83,"ج",1,0],["بل في تفرق شملٍ واختلاف هوى","وفي تخاذل سادات وفي عطب",84,"ب",1,0],["بل فاشفعوا للوالدين بيوم إذ","تنشق عنهم للمعاد ضرائح",85,"ح",1,0],["بل فخرُه بالطالع المزري على","شمسِ الضحى والبدر في الإشراق",86,"ق",1,0],["بل فيه شمس ضحىً وبدر دجىً ونج","مُ هدى وبحر ندىً وطود وقار",87,"ر",1,0],["بلفظ كعقد فصلت جنباته","ومعني كما تلقيه نافثة السحر",88,"ر",1,0],["بل فيه خاضوا جميعاً","نحو الجنوبِ انعراجا",89,"ج",2,0],["بل فاسألوها الصفحَ عن زلتي","فإِنهُ والحقُ شيءٌ يُراد",90,"د",1,0],["\"بَلفرونا\" أيّامَ وَعْدٍ \"تَصَهْينْ\"","وشَربنا كأساً دهاقاً ردِيًّا",91,"ي",2,0],["بلفورُ قالَ لهم... القدسُ أرضكمُ","فسرَّهُم قولهُ واستكتموا النجوى",92,"ا",1,0],["بَلْ في الْقُبورِ قَدِ اسْتَباحوا مِيتَتي","لَمْ تَكْفِهِمْ في الْعُمْرِ مَقْصَلَةُ الْفِتَنْ",93,"ن",1,0],["بلفورُ عِدْ ما شِئتَ وعدكَ باطِلُ","لم يبقَ في الشّرقِ المُضَلّلِ جاهِلُ",94,"ل",1,1],["بَلْ فِيْكِ أُنْشِدُ عَبْرَتِي وصَبَابَتِي","وألُوْذُ دوْماً بالْخَيَالِ مُهَرْوِلا",95,"ل",2,0],["بل فقدنا منك شخصاً حشوه","همة شما وعلم دجِّجا",96,"ج",2,0],["بل في قوى عقل وشدة ساعد","وسليم أعضاء وعزم عضائل",97,"ل",1,0],["بل في جليل صناعة وزراعة","ومطارق ومعاول ومناجل",97,"ل",1,0],["بل في القلوب بنى العلم الصحيح لها","حصن العفاف المعلى خير بنيان",98,"ن",1,0],["بلفور طعنة هذا القلب مقتله","المجد للشعب حيث الصحو يبتدئُ",99,"ا",1,0],["بلْ فيكَ عيسى قائماً متضرّعاً","مُتبرِّكاً ، في ثوبه ِ العذراء ُ",100,"ا",2,0],["بلْ فيك انسانٌ يَحبُّ كرامة ً","ويصونُها انْ عجّت ِ الأهواءُ",100,"ا",2,0],["بلْ فيك بغدادٌ تطولُ بليلِها","يا ألفَ ليلٍ للعيون ِ دواء ُ",100,"ا",2,0],["بلْ فيكُ بغداد ُ الحياة تُبغددُ","بلْ أهلُنا فيها هُم الكرماء ُ",100,"ا",2,0],["بلْ فطنة أدركتْ لُبّ الحياة ولمْ","يكُنْ ليشغلها الأصدافُ والزَبَد ُ",101,"د",1,0],["بل فرقتنا للظنون نميمة","والظن بين ذوي الهوى نمام",102,"م",1,0],["بل فجرت من دموع الشوق أودية","فبلت النحر تجريحا وتشويها",103,"ي",3,0],["\" بِلْفُورُ \" وَعْدٌ جَائِرٌ وَشَنَارُ","ذِكْرَى البُكَا لَوْ يَنْفَعُ التِّذْكَارُ",104,"ر",1,0],["بل فرقوا ما كان قبلُ موحَّداً","مهما نوائمْهم فلن يتواءموا",105,"م",3,0],["(بلفور- إسرائيل) حلفٌ واحدٌ","قد أوجدا ليدمّر الموجودٰ",106,"د",1,0],["بلفورُ وغدٌ سبّب الإحراج للص","هيونِ ورّطها، لذاك تغامرُ