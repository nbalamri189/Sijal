{"poems":[[86,"قد غفونا وانتبهنا فإذا","https://www.aldiwan.net/poem10358.html","الرمل"],[86,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[71,"لا تظن الجوزي يصدق في الرؤيا","https://www.aldiwan.net/poem3748.html","الخفيف"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[89,"قد طال للغرب فوق الارض سلطان","https://www.aldiwan.net/poem44895.html","البسيط"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[58,"لا تظلمن إذا ما كنت مقتدرا","https://www.aldiwan.net/poem30864.html","البسيط"],[49,"الخير أفضل ما لزمتا","https://www.aldiwan.net/poem10829.html","مجزوء الكامل"],[66,"يا بعيدا يشتاقه لحظ عيني","https://www.aldiwan.net/poem40322.html","الخفيف"],[66,"نلت من ودك الجميل انتصافي","https://www.aldiwan.net/poem40336.html","الخفيف"],[87,"أنا في الحب وفي","https://www.aldiwan.net/poem8266.html","مجزوء الرمل"],[31,"أوقفت من طلل على رسم","https://www.aldiwan.net/poem41324.html","الكامل"],[31,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[31,"أيها القلب ما أراك تفيق","https://www.aldiwan.net/poem42211.html","الخفيف"],[105,"يا دمنهور ارقبيه موكبا","https://www.aldiwan.net/poem42063.html","الرمل"],[105,"يا قوم ماذا تحملو","https://www.aldiwan.net/poem43057.html","مجزوء الكامل"],[105,"يا أيها القوم ماذا في حقائبكم","https://www.aldiwan.net/poem43072.html","البسيط"],[105,"أبلغ ضيوفك حين يشهد جمعهم","https://www.aldiwan.net/poem43085.html","الكامل"],[105,"نبني وتهدم أيدي الجهل دائبة","https://www.aldiwan.net/poem43368.html","البسيط"],[105,"داء أهل الشرق ضعف الهمم","https://www.aldiwan.net/poem43409.html","الرمل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[105,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[52,"نفس كوني ذات خوف","https://www.aldiwan.net/poem27261.html","مجزوء الرمل"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[46,"الغيب مجهول يحار دليله","https://www.aldiwan.net/poem23025.html","الكامل"],[46,"لا تزدرن صغارا في ملاعبهم","https://www.aldiwan.net/poem23397.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125600","الخفيف"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2242","الطويل"],[19,"لَعَمْرُكَ ما مَلّتْ ثَوَاءَ ثَوِيِّها","https://www.poetsgate.com/ViewPoem.aspx?id=13188",""],[31,"أوقفتَ من طللٍ على رسمِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19081&r=&rc=344",""]],"verses":[["لا تَظُنّوا العَيشَ أَحلامَ المُنى","ذاكَ عَهدٌ قَد تَوَلّى وَاِنصَرَم",0,"م",1,0],["لا تَظُنّوا بِنا العُقوقَ وَلَكِن","أَرشِدونا إِذا ضَلِلنا الرَشادا",1,"د",2,0],["لا تَظلِموا رَبَّ النُهى","وَحَذارِ مِن خَطَلٍ حَذارِ",2,"ر",1,0],["لا تَظُنَّ الجَوزِيَّ يَصدُقُ في الرُؤ","يا فَما الأَمرُ مِثلَ ما يَدَّعيهِ",3,"ي",2,1],["لا تَظمَأونَ وَفي نُحَيحٍ عَمِّكُم","مَروىً وَعِندَ بَني سُوَيدٍ مَشبَعُ",4,"ع",1,0],["لا تُظاهر سلاحَها لمُحبٍّ","فكفاهُ بسهمِها القتَّالِ",5,"ل",1,0],["لا تظنَّنَّ أن مالك شيء","كدم الجوف خيره محقونه",6,"ن",2,0],["لا تظلموا عربياً في مواطنه","فانه مثلكم يا قوم انسان",7,"ن",1,0],["لا تَظلِمَنْ شِعري ولا تَتَكَرَّهَنْ","ألفاظَه فالمِسكُ غيرُ كَريهِ",8,"ي",2,0],["لا تَظلِمَنَّ إِذا ما كُنتَ مُقتَدِراً","فَالظُلمُ مَرتَعُهُ يُفضي إِلى النَدَمِ",9,"م",1,1],["لا تَظلِمَنَّ تَكُن مِنَ ال","أَحزارِ وَاعفُ إِذا ظُلِمتا",10,"ت",2,0],["لا تَظُنَّ البُعادَ يُخلِقُ عَهدي","أَو تَحُلَّ الأَيامُ عَقدَ وِدادي",11,"ي",1,0],["لا تَظُنَّ اِنقِطاعَ كُتبي بِأَنّي","لَكَ جافٍ كَلّا وَلا مُتَجافِ",12,"ف",1,0],["لا تَظُنُّوا بِيَ سُوءاً","إِنَّ بَعْضَ الظَّنِّ إِثْمُ",13,"م",1,0],["لا تُظهِري سِرّي فَإِنَّ حَديثَكُم","في مَحسَنٍ أَنأى مِنَ النَجمِ",14,"م",1,0],["لا تُظهِري حُبَّهُ حَتّى أُراجِعَهُ","إِنّي سَأَكفيكِهِ إِن لَم أَمُت عَجَلا",15,"ل",2,0],["لا تَظُنّي أَنَّ التَراسُلَ وَالبَذ","لَ بِكُلِّ النِساءِ عِندي يَليقُ",16,"ق",1,0],["لا تَظُنِّي الأمرَ مُمتدَّ المَدَى","وَاصْبِري حَتَّى تَدورَ الدائرهْ",17,"ر",2,0],["لا تظلموا استِقلالَكم","حَسْبي أَأنتم والحِمايهْ",18,"ا",3,0],["لا تَظلِموا مِصرَ إِنَّ البِرَّ آيَتُهُ","أَلّا يُرَوِّعُها ظُلمٌ وَلا رَهَقُ",19,"ق",1,0],["لا تَظلِموا الأَقلامَ إِنَّ سَبيلَها","عَونُ الضَعيفِ وَنُصرَةُ المَخذولِ",20,"ل",1,0],["لا تَظلِموا الدينَ إِنَّ الدينَ يَأَمرُنا","بِما عَلِمتُم مِنَ الأَخلاقِ وَالشِيَمِ",21,"م",1,0],["لا تَظُنّوا المَجدَ شَيئاً هَيِّناً","إِنَّهُ في لَهَواتِ الضَيغَمِ",22,"م",1,0],["لا تظنّوا جمعَكم كُفؤاً لها","حينَ تَمضِي في العجاجِ المُطبقِ",23,"ق",1,0],["لا تظنوا أنكم أكفاؤهم","إنها منكم لأحلام شُرُدْ",24,"د",1,0],["لا تَظنَّ الجودَ دَيْناً يُشْتَرى","سَتَرى الجودَ المُصَفَّى والجوادا",25,"د",2,0],["لا تَظُنّي الناسَ ناساً","أَيُّ أُسدٍ في الثِيابِ",26,"ب",1,0],["لا تَظلِموني وَتَظلِموا الحِسْبَه","فليسَ بيني وَبينها نِسْبَه",27,"ب",2,1],["لا تَظلِموا المَوتى وَإِن طالَ المَدى","إِنّي أَخافُ عَلَيكُمُ أَن تَلتَقوا",28,"ق",3,0],["لا تَظلِموا مِن بَنيها وَاحِداً أَبَداً","حَتّى تَعُدّوا ذَوي فِطرٍ كَصَوّامِ",29,"م",1,0],["لا تظني ورداً يكافئ ورداً","أنت أغلى حسناً وأكرم وردا",30,"د",2,0],["لا تُظهِرَن ذَمَّ اِمرِئٍ قَبلَ خُبرِهِ","وَبَعدَ بَلاءِ المَرءِ فَاِذمُم أَوِ اِحمَدِ",31,"د",1,0],["لا تُظهرنْ ذمَّ امرىء ٍ قبلَ خُبرِه","وبعدَ بلاءِ المرْء فاذمُم أوِ احمَدِ",32,"د",1,0],["لا تظهري سري، فإنّ حديثكم","في مَحْصَنٍ أَنْأَى مِنَ النَّجْمِ",33,"م",1,0]]}