{"poems":[[88,"قد غفونا وانتبهنا فإذا","https://www.aldiwan.net/poem10358.html","الرمل"],[88,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[88,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[73,"لا تظن الجوزي يصدق في الرؤيا","https://www.aldiwan.net/poem3748.html","الخفيف"],[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[91,"قد طال للغرب فوق الارض سلطان","https://www.aldiwan.net/poem44895.html","البسيط"],[63,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[60,"لا تظلمن إذا ما كنت مقتدرا","https://www.aldiwan.net/poem30864.html","البسيط"],[51,"الخير أفضل ما لزمتا","https://www.aldiwan.net/poem10829.html","مجزوء الكامل"],[68,"يا بعيدا يشتاقه لحظ عيني","https://www.aldiwan.net/poem40322.html","الخفيف"],[68,"نلت من ودك الجميل انتصافي","https://www.aldiwan.net/poem40336.html","الخفيف"],[89,"أنا في الحب وفي","https://www.aldiwan.net/poem8266.html","مجزوء الرمل"],[33,"أوقفت من طلل على رسم","https://www.aldiwan.net/poem41324.html","الكامل"],[33,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[33,"أيها القلب ما أراك تفيق","https://www.aldiwan.net/poem42211.html","الخفيف"],[107,"يا دمنهور ارقبيه موكبا","https://www.aldiwan.net/poem42063.html","الرمل"],[107,"يا قوم ماذا تحملو","https://www.aldiwan.net/poem43057.html","مجزوء الكامل"],[107,"يا أيها القوم ماذا في حقائبكم","https://www.aldiwan.net/poem43072.html","البسيط"],[107,"أبلغ ضيوفك حين يشهد جمعهم","https://www.aldiwan.net/poem43085.html","الكامل"],[107,"نبني وتهدم أيدي الجهل دائبة","https://www.aldiwan.net/poem43368.html","البسيط"],[107,"داء أهل الشرق ضعف الهمم","https://www.aldiwan.net/poem43409.html","الرمل"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[107,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[107,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[54,"نفس كوني ذات خوف","https://www.aldiwan.net/poem27261.html","مجزوء الرمل"],[69,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[48,"الغيب مجهول يحار دليله","https://www.aldiwan.net/poem23025.html","الكامل"],[48,"لا تزدرن صغارا في ملاعبهم","https://www.aldiwan.net/poem23397.html","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125600","الخفيف"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2242","الطويل"],[111,"ليس في الحب قياس","https://www.poetsgate.com/ViewPoem.aspx?id=612",""],[19,"لَعَمْرُكَ ما مَلّتْ ثَوَاءَ ثَوِيِّها","https://www.poetsgate.com/ViewPoem.aspx?id=13188",""],[96,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[33,"أوقفتَ من طللٍ على رسمِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19081&r=&rc=344",""],[119,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[132,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[136,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[146,"لا تظنن بي سلوا وإن كنت","https://www.aldiwan.net/poem58368.html","الخفيف"],[159,"لا تظلموا الناس ولا تطلبوا","https://www.aldiwan.net/poem55477.html","السريع"],[164,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[177,"لا تظنوا ابن بيش","https://www.aldiwan.net/poem4410.html","مجزوء الخفيف"],[208,"مولاي تمطلني غدا فغدا","https://www.aldiwan.net/poem53339.html","أحذ الكامل"],[214,"زاد وجدي واصطباري ذهبا","https://www.aldiwan.net/poem13495.html","الرمل"],[245,"أيها الناظرون هذا خيالي","https://www.aldiwan.net/poem45541.html","الخفيف"],[254,"وصل الجسم منذ بنتم سقامه","https://www.aldiwan.net/poem15032.html","الخفيف"],[265,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[274,"واها وهل تجديك نفعا واها","https://www.aldiwan.net/poem35227.html","الكامل"],[283,"لا تلوموا عليه قلب محب","https://www.aldiwan.net/poem2643.html","الخفيف"],[307,"لا تظنوا إن لاح في الخد منه","https://www.aldiwan.net/poem57915.html","الخفيف"],[317,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[332,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[332,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[361,"عجبت من بزتي إذ أخلقت","https://www.aldiwan.net/poem4161.html","الرمل"],[368,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[368,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[375,"لا تظنن ما تمكنت منه","https://www.aldiwan.net/poem57019.html","الطويل"],[375,"كذبت مقلتي فلم صدقوها","https://www.aldiwan.net/poem57375.html","الخفيف"],[409,"لا تظنن بي وبرك حي","https://www.aldiwan.net/poem50041.html","الخفيف"],[413,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[433,"أقبلت تنجلي وتسحب ذيلا","https://www.aldiwan.net/poem40711.html","الخفيف"],[436,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[436,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[436,"عجبا من ذا الزمان الساقط","https://www.aldiwan.net/poem12654.html","الرمل"],[456,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[464,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[464,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[486,"يا قومنا لا تسومونا التي كرهت","https://www.aldiwan.net/poem2075.html","البسيط"],[508,"فلسفة","https://www.aldiwan.net/poem27794.html","الخفيف"],[518,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[538,"عاقني عنك توالي المطر","https://www.aldiwan.net/poem4122.html","الرمل"],[561,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[561,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[561,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[561,"فنحت عندنا المليح فاها","https://www.aldiwan.net/poem33654.html","الخفيف"],[561,"كل تحريك تراه وسكون","https://www.aldiwan.net/poem33843.html","الرمل"],[561,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[561,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[561,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[561,"قل لنفس جهلت بين الورى","https://www.aldiwan.net/poem34526.html","الرمل"],[561,"لا تظن الله معنا ها هنا في ذا الوجود","https://www.aldiwan.net/poem34604.html","الرمل"],[561,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[570,"لا تظنين في بكاء النؤى والطنب","https://www.aldiwan.net/poem69810.html","البسيط"],[572,"ما أَحسن الغيرة في حينها","https://www.aldiwan.net/poem51992.html","السريع"],[589,"يا من إذا وعد الوصال لمغرم","https://www.aldiwan.net/poem18023.html","الكامل"]],"verses":[["لا تَظُنّوا العَيشَ أَحلامَ المُنى","ذاكَ عَهدٌ قَد تَوَلّى وَاِنصَرَم",0,"م",1,0],["لا تَظُنّوا بِنا العُقوقَ وَلَكِن","أَرشِدونا إِذا ضَلِلنا الرَشادا",1,"د",2,0],["لا تَظلِموا رَبَّ النُهى","وَحَذارِ مِن خَطَلٍ حَذارِ",2,"ر",1,0],["لا تَظُنَّ الجَوزِيَّ يَصدُقُ في الرُؤ","يا فَما الأَمرُ مِثلَ ما يَدَّعيهِ",3,"ي",2,1],["لا تَظمَأونَ وَفي نُحَيحٍ عَمِّكُم","مَروىً وَعِندَ بَني سُوَيدٍ مَشبَعُ",4,"ع",1,0],["لا تُظاهر سلاحَها لمُحبٍّ","فكفاهُ بسهمِها القتَّالِ",5,"ل",1,0],["لا تظنَّنَّ أن مالك شيء","كدم الجوف خيره محقونه",6,"ن",2,0],["لا تظلموا عربياً في مواطنه","فانه مثلكم يا قوم انسان",7,"ن",1,0],["لا تَظلِمَنْ شِعري ولا تَتَكَرَّهَنْ","ألفاظَه فالمِسكُ غيرُ كَريهِ",8,"ي",2,0],["لا تَظلِمَنَّ إِذا ما كُنتَ مُقتَدِراً","فَالظُلمُ مَرتَعُهُ يُفضي إِلى النَدَمِ",9,"م",1,1],["لا تَظلِمَنَّ تَكُن مِنَ ال","أَحزارِ وَاعفُ إِذا ظُلِمتا",10,"ت",2,0],["لا تَظُنَّ البُعادَ يُخلِقُ عَهدي","أَو تَحُلَّ الأَيامُ عَقدَ وِدادي",11,"د",2,0],["لا تَظُنَّ اِنقِطاعَ كُتبي بِأَنّي","لَكَ جافٍ كَلّا وَلا مُتَجافِ",12,"ف",1,0],["لا تَظُنُّوا بِيَ سُوءاً","إِنَّ بَعْضَ الظَّنِّ إِثْمُ",13,"م",1,0],["لا تُظهِري سِرّي فَإِنَّ حَديثَكُم","في مَحسَنٍ أَنأى مِنَ النَجمِ",14,"م",1,0],["لا تُظهِري حُبَّهُ حَتّى أُراجِعَهُ","إِنّي سَأَكفيكِهِ إِن لَم أَمُت عَجَلا",15,"ل",2,0],["لا تَظُنّي أَنَّ التَراسُلَ وَالبَذ","لَ بِكُلِّ النِساءِ عِندي يَليقُ",16,"ق",1,0],["لا تَظُنِّي الأمرَ مُمتدَّ المَدَى","وَاصْبِري حَتَّى تَدورَ الدائرهْ",17,"ر",2,0],["لا تظلموا استِقلالَكم","حَسْبي أَأنتم والحِمايهْ",18,"ا",3,0],["لا تَظلِموا مِصرَ إِنَّ البِرَّ آيَتُهُ","أَلّا يُرَوِّعُها ظُلمٌ وَلا رَهَقُ",19,"ق",1,0],["لا تَظلِموا الأَقلامَ إِنَّ سَبيلَها","عَونُ الضَعيفِ وَنُصرَةُ المَخذولِ",20,"ل",1,0],["لا تَظلِموا الدينَ إِنَّ الدينَ يَأَمرُنا","بِما عَلِمتُم مِنَ الأَخلاقِ وَالشِيَمِ",21,"م",1,0],["لا تَظُنّوا المَجدَ شَيئاً هَيِّناً","إِنَّهُ في لَهَواتِ الضَيغَمِ",22,"م",1,0],["لا تظنّوا جمعَكم كُفؤاً لها","حينَ تَمضِي في العجاجِ المُطبقِ",23,"ق",1,0],["لا تظنوا أنكم أكفاؤهم","إنها منكم لأحلام شُرُدْ",24,"د",1,0],["لا تَظنَّ الجودَ دَيْناً يُشْتَرى","سَتَرى الجودَ المُصَفَّى والجوادا",25,"د",2,0],["لا تَظُنّي الناسَ ناساً","أَيُّ أُسدٍ في الثِيابِ",26,"ب",1,0],["لا تَظلِموني وَتَظلِموا الحِسْبَه","فليسَ بيني وَبينها نِسْبَه",27,"ب",2,1],["لا تَظلِموا المَوتى وَإِن طالَ المَدى","إِنّي أَخافُ عَلَيكُمُ أَن تَلتَقوا",28,"ق",3,0],["لا تَظلِموا مِن بَنيها وَاحِداً أَبَداً","حَتّى تَعُدّوا ذَوي فِطرٍ كَصَوّامِ",29,"م",1,0],["لا تظني ورداً يكافئ ورداً","أنت أغلى حسناً وأكرم وردا",30,"د",2,0],["لا تُظهِرَن ذَمَّ اِمرِئٍ قَبلَ خُبرِهِ","وَبَعدَ بَلاءِ المَرءِ فَاِذمُم أَوِ اِحمَدِ",31,"د",1,0],["لا تظن الحب شيئا ً هينا ً","ليس في الحب قياس يطرد",32,"د",1,0],["لا تُظهرنْ ذمَّ امرىء ٍ قبلَ خُبرِه","وبعدَ بلاءِ المرْء فاذمُم أوِ احمَدِ",33,"د",1,0],["لا تظنّوا السلام في الأرض حيّا","بعد أن طالبت بها إسترحاما",34,"م",2,0],["لا تظهري سري، فإنّ حديثكم","في مَحْصَنٍ أَنْأَى مِنَ النَّجْمِ",35,"م",1,0],["لا تظنوا لي اليكم ويهم","قطعة كنت وقلي قد محاها",36,"ا",3,0],["لا تُظْهِرَنَّ خلاف ما عملوا به","فالرَّأْىُ دعْهم يفعلوا ما شاءوا",37,"ا",1,0],["لا تُظُنَّ القَرِيضَ كُلَّ مَقُولٍ","هَلهَلِ النَّسجِ مُستَدَامِ الوُقُوعِ",38,"ع",1,0],["لا تَظُنَّنَّ بي سُلُوًّا وإن كن","تُ عزيزَ الدموع بين الجفونِ",39,"ن",1,1],["لاَ تَظْلِمُوا النَّاسَ وَلا تَطْلُبُوا","بِثَأْرِيَ اليَوْمَ أَذى مُسْلِمِ",40,"م",1,1],["لا تظلموا أسياف ألحاظها","فلحظ عيني الخصم في مهجتي",41,"ي",1,0],["لا تَظُنّوا اِبنَ بَيِّشٍ","في قَضاياهُ يُرتَشي",42,"ش",2,1],["لا تظهرن والشمس طالعة","لا تدَّعيك لنفسها ولدا",43,"د",2,0],["لا تظنوني اسأت الأدبا","بل غلو وهو دأب الادبا",44,"ب",2,0],["لا تظنُّوا الحياةَ تبقى طَويلاً","هكذا الجسمُ بعد حينٍ يصيرُ",45,"ر",1,0],["لا تظنوا أني سلوتُ فأين الصبر","من مُهجَةٍ بكم مُستَهامَه",46,"م",2,0],["لا تظنوا بي صبرا إنما","غلب اليأس على حكم الرجاء",47,"ا",2,0],["لا تُظهرَن للناسِ ضعفاً إنهم","يمشونَ ذؤباناً تقيسُ خُطاها",48,"ا",3,0],["لا تظنّوا عِذاره طرّز الخدّ","فما كان ذا افتقاراً إليه",49,"ه",1,0],["لا تظنوا إن لاح في الخد منه","عارضٌ أن حسنه قد تولى",50,"ل",2,1],["لا تظنوا الموت موتاً أنه","لحياة وهي غاية المنى",51,"ن",2,0],["لا تظني أني سأعطيك أيّا","مي جميعا فالخير ألّا تظنّي",52,"ن",2,0],["لا تظنّوا الحياة ما تخرج الأر","ض فلألاؤها خداع سراب",53,"ب",1,0],["لا تَظُنِّي الدَّهرَ لِي مُستَلِباً","إِنَّما جَرَّدَ مِنِّي مُرهَفَا",54,"ف",2,0],["لا تَظنُّوا أنّ سَجعاً شاقَني","أنا أطربتُ حَمامَ الواديَيْن",55,"ن",1,0],["لا تَظْلِمِ الإحْسانَ مُصْطَنِعاً","مَنْ أَنتَ تَبْنِيهِ ويَنْهَدِم",56,"م",1,0],["لا تظُنَّنَّ ما تمكَّنتُ مِنهُ","مِن زَماني صَنيعَةً لزَماني",57,"ن",2,1],["لا تَظُنُّوا دموعَها رُسلَ حُزنٍ","قد تكونُ الدُّموعُ رُسلَ السرورِ",58,"ر",1,0],["لا تَظُنُّنَّ بي وبِرُّكَ حَيَّ","أن شُكري كشكرِ غَيري مَواتُ",59,"ت",1,1],["لا تَظنَّنَ وجدَ مَن فارقَ الأظ","عانَ يحتَثُّهُنَّ حادٍ عَجولُ",60,"ل",1,0],["لا تظني البعاد مني سلّوا","أو جفاءً أو أن قلبي ملّا",61,"ل",2,0],["لا تَظُنَّ الظلامَ يخلع عنه","رُدُنَيْهِ ولا الزَّمانَ الظَّلوما",62,"م",2,0],["لا تظلِم العبادَ واعلَمْ أن مَنْ","آذى امرءاً يُجزاهُ في يومِ اللِّقا",63,"ا",1,0],["لا تظنّني عنه راضياً","إنّني أُخْفي ضَميرَ الساخِطِ",64,"ط",1,0],["لا تظنىّ والألى تحمينهم","أنكم إلاّ هباءً في هَباء",65,"ا",2,0],["لا تظنوا أنَّ الغَرامَ وأنْ بِنَّا وبنْ","تُمْ يقْضي عليه الصَدُّ",66,"د",1,0],["لا تَظُنَّا ضَحِكي عن طَربٍ","فالسَّنا يُخْبرُ عن فرْط الشُّعل",67,"ل",1,0],["لا تظلمونا ولا تنسوا قرابتنا","أطوا إلينا فقدماً تعطف الرحم",68,"م",1,0],["لا تظننّ أنني قُمتُ حتى","لو رأيْتَ يوماً قميصي يُقدُّ!",69,"د",1,0],["لا تظن الأيام أنك ميت","لم يمت من ثناؤه منشور",70,"ر",1,0],["لا تَظُنَّ الأَمرَ عندي هَيِّناً","غَلَب الشَوقُ على مُصطَبري",71,"ر",2,0],["لا تظنوا أننا فيه ولا","هو فينا أي جهلٍ ذاك أيّ",72,"ي",1,0],["لا تظن الخليل قد قال هذا","هو ربي عن كوكب رائيه",73,"ي",2,0],["لا تظن التوحيد بالعقل مقبو","لاً وحاذر تصرْ بذاك سفيها",74,"ي",3,0],["لا تظن الفنا به غير ما أن","ت عليه إذا انتبهت انتباها",75,"ا",3,0],["لا تظن الباب يا باب سوى","أنت والبيت سوى أنت يكون",76,"ن",1,0],["لا تظن الدليل يهدى إليه","أو يرى موقظاً عيون النيام",77,"م",1,0],["لا تظن الوجود حيث ذكرنا","ه هو الخلق عندنا المبذول",78,"ل",1,0],["لا تظلم الله بما لا يليقْ","به ولا تدخل له في مضيقْ",79,"ق",1,1],["لا تظني أن بالفكر وإن","طال وازداد وفيه انتشرا",80,"ر",2,0],["لا تظن الله معنا ها هنا في ذا الوجودْ","هو معنا بالتجلي بتقادير القيودْ",81,"د",1,1],["لا تظن الوجود زاد وهذا","غير أنواع زينة وابتهاج",82,"ج",1,0],["لا تظنين في بكاء النُّؤْى والطنب","ولا تُحَيّ وجه الحيِّ من كَثَبِ",83,"ب",1,1],["لا تظهرن منك على عورة","فيتبع المقرون حبل القرين",84,"ن",1,0],["لا تُظْهِرنَّ لِيَ الوِدَادَ تَكلُّفاً","مَا الآلُ مِثْلُ الماءِ لِلظَمْآنِ",85,"ن",1,0]]}