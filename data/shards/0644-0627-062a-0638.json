{"poems":[[86,"قد غفونا وانتبهنا فإذا","https://www.aldiwan.net/poem10358.html","الرمل"],[86,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[71,"لا تظن الجوزي يصدق في الرؤيا","https://www.aldiwan.net/poem3748.html","الخفيف"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[89,"قد طال للغرب فوق الارض سلطان","https://www.aldiwan.net/poem44895.html","البسيط"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[58,"لا تظلمن إذا ما كنت مقتدرا","https://www.aldiwan.net/poem30864.html","البسيط"],[49,"الخير أفضل ما لزمتا","https://www.aldiwan.net/poem10829.html","مجزوء الكامل"],[66,"يا بعيدا يشتاقه لحظ عيني","https://www.aldiwan.net/poem40322.html","الخفيف"],[66,"نلت من ودك الجميل انتصافي","https://www.aldiwan.net/poem40336.html","الخفيف"],[87,"أنا في الحب وفي","https://www.aldiwan.net/poem8266.html","مجزوء الرمل"],[31,"أوقفت من طلل على رسم","https://www.aldiwan.net/poem41324.html","الكامل"],[31,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[31,"أيها القلب ما أراك تفيق","https://www.aldiwan.net/poem42211.html","الخفيف"],[105,"يا دمنهور ارقبيه موكبا","https://www.aldiwan.net/poem42063.html","الرمل"],[105,"يا قوم ماذا تحملو","https://www.aldiwan.net/poem43057.html","مجزوء الكامل"],[105,"يا أيها القوم ماذا في حقائبكم","https://www.aldiwan.net/poem43072.html","البسيط"],[105,"أبلغ ضيوفك حين يشهد جمعهم","https://www.aldiwan.net/poem43085.html","الكامل"],[105,"نبني وتهدم أيدي الجهل دائبة","https://www.aldiwan.net/poem43368.html","البسيط"],[105,"داء أهل الشرق ضعف الهمم","https://www.aldiwan.net/poem43409.html","الرمل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[105,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[52,"نفس كوني ذات خوف","https://www.aldiwan.net/poem27261.html","مجزوء الرمل"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[46,"الغيب مجهول يحار دليله","https://www.aldiwan.net/poem23025.html","الكامل"],[46,"لا تزدرن صغارا في ملاعبهم","https://www.aldiwan.net/poem23397.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125600","الخفيف"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2242","الطويل"],[19,"لَعَمْرُكَ ما مَلّتْ ثَوَاءَ ثَوِيِّها","https://www.poetsgate.com/ViewPoem.aspx?id=13188",""],[94,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[31,"أوقفتَ من طللٍ على رسمِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19081&r=&rc=344",""],[116,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[129,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[133,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[143,"لا تظنن بي سلوا وإن كنت","https://www.aldiwan.net/poem58368.html","الخفيف"],[156,"لا تظلموا الناس ولا تطلبوا","https://www.aldiwan.net/poem55477.html","السريع"],[161,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[174,"لا تظنوا ابن بيش","https://www.aldiwan.net/poem4410.html","مجزوء الخفيف"],[205,"مولاي تمطلني غدا فغدا","https://www.aldiwan.net/poem53339.html","أحذ الكامل"],[211,"زاد وجدي واصطباري ذهبا","https://www.aldiwan.net/poem13495.html","الرمل"],[242,"أيها الناظرون هذا خيالي","https://www.aldiwan.net/poem45541.html","الخفيف"],[251,"وصل الجسم منذ بنتم سقامه","https://www.aldiwan.net/poem15032.html","الخفيف"],[262,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[271,"واها وهل تجديك نفعا واها","https://www.aldiwan.net/poem35227.html","الكامل"],[280,"لا تلوموا عليه قلب محب","https://www.aldiwan.net/poem2643.html","الخفيف"],[304,"لا تظنوا إن لاح في الخد منه","https://www.aldiwan.net/poem57915.html","الخفيف"],[314,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[329,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[358,"عجبت من بزتي إذ أخلقت","https://www.aldiwan.net/poem4161.html","الرمل"],[365,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[365,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[372,"لا تظنن ما تمكنت منه","https://www.aldiwan.net/poem57019.html","الطويل"],[372,"كذبت مقلتي فلم صدقوها","https://www.aldiwan.net/poem57375.html","الخفيف"],[406,"لا تظنن بي وبرك حي","https://www.aldiwan.net/poem50041.html","الخفيف"],[410,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[430,"أقبلت تنجلي وتسحب ذيلا","https://www.aldiwan.net/poem40711.html","الخفيف"],[433,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[433,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[433,"عجبا من ذا الزمان الساقط","https://www.aldiwan.net/poem12654.html","الرمل"],[454,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[462,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[462,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[484,"يا قومنا لا تسومونا التي كرهت","https://www.aldiwan.net/poem2075.html","البسيط"],[506,"فلسفة","https://www.aldiwan.net/poem27794.html","الخفيف"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[536,"عاقني عنك توالي المطر","https://www.aldiwan.net/poem4122.html","الرمل"],[559,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[559,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[559,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[559,"فنحت عندنا المليح فاها","https://www.aldiwan.net/poem33654.html","الخفيف"],[559,"كل تحريك تراه وسكون","https://www.aldiwan.net/poem33843.html","الرمل"],[559,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[559,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[559,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[559,"قل لنفس جهلت بين الورى","https://www.aldiwan.net/poem34526.html","الرمل"],[559,"لا تظن الله معنا ها هنا في ذا الوجود","https://www.aldiwan.net/poem34604.html","الرمل"],[559,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[568,"لا تظنين في بكاء النؤى والطنب","https://www.aldiwan.net/poem69810.html","البسيط"],[570,"ما أَحسن الغيرة في حينها","https://www.aldiwan.net/poem51992.html","السريع"],[587,"يا من إذا وعد الوصال لمغرم","https://www.aldiwan.net/poem18023.html","الكامل"]],"verses":[["لا تَظُنّوا العَيشَ أَحلامَ المُنى","ذاكَ عَهدٌ قَد تَوَلّى وَاِنصَرَم",0,"م",1,0],["لا تَظُنّوا بِنا العُقوقَ وَلَكِن","أَرشِدونا إِذا ضَلِلنا الرَشادا",1,"د",2,0],["لا تَظلِموا رَبَّ النُهى","وَحَذارِ مِن خَطَلٍ حَذارِ",2,"ر",1,0],["لا تَظُنَّ الجَوزِيَّ يَصدُقُ في الرُؤ","يا فَما الأَمرُ مِثلَ ما يَدَّعيهِ",3,"ي",2,1],["لا تَظمَأونَ وَفي نُحَيحٍ عَمِّكُم","مَروىً وَعِندَ بَني سُوَيدٍ مَشبَعُ",4,"ع",1,0],["لا تُظاهر سلاحَها لمُحبٍّ","فكفاهُ بسهمِها القتَّالِ",5,"ل",1,0],["لا تظنَّنَّ أن مالك شيء","كدم الجوف خيره محقونه",6,"ن",2,0],["لا تظلموا عربياً في مواطنه","فانه مثلكم يا قوم انسان",7,"ن",1,0],["لا تَظلِمَنْ شِعري ولا تَتَكَرَّهَنْ","ألفاظَه فالمِسكُ غيرُ كَريهِ",8,"ي",2,0],["لا تَظلِمَنَّ إِذا ما كُنتَ مُقتَدِراً","فَالظُلمُ مَرتَعُهُ يُفضي إِلى النَدَمِ",9,"م",1,1],["لا تَظلِمَنَّ تَكُن مِنَ ال","أَحزارِ وَاعفُ إِذا ظُلِمتا",10,"ت",2,0],["لا تَظُنَّ البُعادَ يُخلِقُ عَهدي","أَو تَحُلَّ الأَيامُ عَقدَ وِدادي",11,"د",2,0],["لا تَظُنَّ اِنقِطاعَ كُتبي بِأَنّي","لَكَ جافٍ كَلّا وَلا مُتَجافِ",12,"ف",1,0],["لا تَظُنُّوا بِيَ سُوءاً","إِنَّ بَعْضَ الظَّنِّ إِثْمُ",13,"م",1,0],["لا تُظهِري سِرّي فَإِنَّ حَديثَكُم","في مَحسَنٍ أَنأى مِنَ النَجمِ",14,"م",1,0],["لا تُظهِري حُبَّهُ حَتّى أُراجِعَهُ","إِنّي سَأَكفيكِهِ إِن لَم أَمُت عَجَلا",15,"ل",2,0],["لا تَظُنّي أَنَّ التَراسُلَ وَالبَذ","لَ بِكُلِّ النِساءِ عِندي يَليقُ",16,"ق",1,0],["لا تَظُنِّي الأمرَ مُمتدَّ المَدَى","وَاصْبِري حَتَّى تَدورَ الدائرهْ",17,"ر",2,0],["لا تظلموا استِقلالَكم","حَسْبي أَأنتم والحِمايهْ",18,"ا",3,0],["لا تَظلِموا مِصرَ إِنَّ البِرَّ آيَتُهُ","أَلّا يُرَوِّعُها ظُلمٌ وَلا رَهَقُ",19,"ق",1,0],["لا تَظلِموا الأَقلامَ إِنَّ سَبيلَها","عَونُ الضَعيفِ وَنُصرَةُ المَخذولِ",20,"ل",1,0],["لا تَظلِموا الدينَ إِنَّ الدينَ يَأَمرُنا","بِما عَلِمتُم مِنَ الأَخلاقِ وَالشِيَمِ",21,"م",1,0],["لا تَظُنّوا المَجدَ شَيئاً هَيِّناً","إِنَّهُ في لَهَواتِ الضَيغَمِ",22,"م",1,0],["لا تظنّوا جمعَكم كُفؤاً لها","حينَ تَمضِي في العجاجِ المُطبقِ",23,"ق",1,0],["لا تظنوا أنكم أكفاؤهم","إنها منكم لأحلام شُرُدْ",24,"د",1,0],["لا تَظنَّ الجودَ دَيْناً يُشْتَرى","سَتَرى الجودَ المُصَفَّى والجوادا",25,"د",2,0],["لا تَظُنّي الناسَ ناساً","أَيُّ أُسدٍ في الثِيابِ",26,"ب",1,0],["لا تَظلِموني وَتَظلِموا الحِسْبَه","فليسَ بيني وَبينها نِسْبَه",27,"ب",2,1],["لا تَظلِموا المَوتى وَإِن طالَ المَدى","إِنّي أَخافُ عَلَيكُمُ أَن تَلتَقوا",28,"ق",3,0],["لا تَظلِموا مِن بَنيها وَاحِداً أَبَداً","حَتّى تَعُدّوا ذَوي فِطرٍ كَصَوّامِ",29,"م",1,0],["لا تظني ورداً يكافئ ورداً","أنت أغلى حسناً وأكرم وردا",30,"د",2,0],["لا تُظهِرَن ذَمَّ اِمرِئٍ قَبلَ خُبرِهِ","وَبَعدَ بَلاءِ المَرءِ فَاِذمُم أَوِ اِحمَدِ",31,"د",1,0],["لا تُظهرنْ ذمَّ امرىء ٍ قبلَ خُبرِه","وبعدَ بلاءِ المرْء فاذمُم أوِ احمَدِ",32,"د",1,0],["لا تظنّوا السلام في الأرض حيّا","بعد أن طالبت بها إسترحاما",33,"م",2,0],["لا تظهري سري، فإنّ حديثكم","في مَحْصَنٍ أَنْأَى مِنَ النَّجْمِ",34,"م",1,0],["لا تظنوا لي اليكم ويهم","قطعة كنت وقلي قد محاها",35,"ا",3,0],["لا تُظْهِرَنَّ خلاف ما عملوا به","فالرَّأْىُ دعْهم يفعلوا ما شاءوا",36,"ا",1,0],["لا تُظُنَّ القَرِيضَ كُلَّ مَقُولٍ","هَلهَلِ النَّسجِ مُستَدَامِ الوُقُوعِ",37,"ع",1,0],["لا تَظُنَّنَّ بي سُلُوًّا وإن كن","تُ عزيزَ الدموع بين الجفونِ",38,"ن",1,1],["لاَ تَظْلِمُوا النَّاسَ وَلا تَطْلُبُوا","بِثَأْرِيَ اليَوْمَ أَذى مُسْلِمِ",39,"م",1,1],["لا تظلموا أسياف ألحاظها","فلحظ عيني الخصم في مهجتي",40,"ي",1,0],["لا تَظُنّوا اِبنَ بَيِّشٍ","في قَضاياهُ يُرتَشي",41,"ش",2,1],["لا تظهرن والشمس طالعة","لا تدَّعيك لنفسها ولدا",42,"د",2,0],["لا تظنوني اسأت الأدبا","بل غلو وهو دأب الادبا",43,"ب",2,0],["لا تظنُّوا الحياةَ تبقى طَويلاً","هكذا الجسمُ بعد حينٍ يصيرُ",44,"ر",1,0],["لا تظنوا أني سلوتُ فأين الصبر","من مُهجَةٍ بكم مُستَهامَه",45,"م",2,0],["لا تظنوا بي صبرا إنما","غلب اليأس على حكم الرجاء",46,"ا",2,0],["لا تُظهرَن للناسِ ضعفاً إنهم","يمشونَ ذؤباناً تقيسُ خُطاها",47,"ا",3,0],["لا تظنّوا عِذاره طرّز الخدّ","فما كان ذا افتقاراً إليه",48,"ه",1,0],["لا تظنوا إن لاح في الخد منه","عارضٌ أن حسنه قد تولى",49,"ل",2,1],["لا تظنوا الموت موتاً أنه","لحياة وهي غاية المنى",50,"ن",2,0],["لا تظني أني سأعطيك أيّا","مي جميعا فالخير ألّا تظنّي",51,"ن",2,0],["لا تظنّوا الحياة ما تخرج الأر","ض فلألاؤها خداع سراب",52,"ب",1,0],["لا تَظُنِّي الدَّهرَ لِي مُستَلِباً","إِنَّما جَرَّدَ مِنِّي مُرهَفَا",53,"ف",2,0],["لا تَظنُّوا أنّ سَجعاً شاقَني","أنا أطربتُ حَمامَ الواديَيْن",54,"ن",1,0],["لا تَظْلِمِ الإحْسانَ مُصْطَنِعاً","مَنْ أَنتَ تَبْنِيهِ ويَنْهَدِم",55,"م",1,0],["لا تظُنَّنَّ ما تمكَّنتُ مِنهُ","مِن زَماني صَنيعَةً لزَماني",56,"ن",2,1],["لا تَظُنُّوا دموعَها رُسلَ حُزنٍ","قد تكونُ الدُّموعُ رُسلَ السرورِ",57,"ر",1,0],["لا تَظُنُّنَّ بي وبِرُّكَ حَيَّ","أن شُكري كشكرِ غَيري مَواتُ",58,"ت",1,1],["لا تَظنَّنَ وجدَ مَن فارقَ الأظ","عانَ يحتَثُّهُنَّ حادٍ عَجولُ",59,"ل",1,0],["لا تظني البعاد مني سلّوا","أو جفاءً أو أن قلبي ملّا",60,"ل",2,0],["لا تَظُنَّ الظلامَ يخلع عنه","رُدُنَيْهِ ولا الزَّمانَ الظَّلوما",61,"م",2,0],["لا تظلِم العبادَ واعلَمْ أن مَنْ","آذى امرءاً يُجزاهُ في يومِ اللِّقا",62,"ا",1,0],["لا تظنّني عنه راضياً","إنّني أُخْفي ضَميرَ الساخِطِ",63,"ط",1,0],["لا تظنىّ والألى تحمينهم","أنكم إلاّ هباءً في 