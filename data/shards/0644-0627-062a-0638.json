px?id=210354",""],[5756,"لو..ولو..ولو","https://www.poetsgate.com/ViewPoem.aspx?id=35221",""],[5830,"إِنَّ الوَصْلَ يُحْيِيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=200823",""],[5861,"قالت أمي","https://www.poetsgate.com/ViewPoem.aspx?id=191867",""],[5943,"ياأمَّةً قعدتْ","https://www.poetsgate.com/ViewPoem.aspx?id=34678",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""],[6115,"انت ياشاشه بريمته بيدي غيره","https://www.poetsgate.com/ViewPoem.aspx?id=180505",""],[6115,"استمع شوري وسير مغمض","https://www.poetsgate.com/ViewPoem.aspx?id=180509",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6202,"إن تمكري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86708&r=&rc=9",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[5190,"ما كنت محض قصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78368&r=&rc=76",""]],"verses":[["لا تَظُنّوا العَيشَ أَحلامَ المُنى","ذاكَ عَهدٌ قَد تَوَلّى وَاِنصَرَم",0,"م",1,0],["لا تَظُنّوا بِنا العُقوقَ وَلَكِن","أَرشِدونا إِذا ضَلِلنا الرَشادا",1,"د",2,0],["لا تَظلِموا رَبَّ النُهى","وَحَذارِ مِن خَطَلٍ حَذارِ",2,"ر",1,0],["لا تَظُنَّ الجَوزِيَّ يَصدُقُ في الرُؤ","يا فَما الأَمرُ مِثلَ ما يَدَّعيهِ",3,"ي",2,1],["لا تَظمَأونَ وَفي نُحَيحٍ عَمِّكُم","مَروىً وَعِندَ بَني سُوَيدٍ مَشبَعُ",4,"ع",1,0],["لا تُظاهر سلاحَها لمُحبٍّ","فكفاهُ بسهمِها القتَّالِ",5,"ل",1,0],["لا تظنَّنَّ أن مالك شيء","كدم الجوف خيره محقونه",6,"ن",2,0],["لا تظلموا عربياً في مواطنه","فانه مثلكم يا قوم انسان",7,"ن",1,0],["لا تَظلِمَنْ شِعري ولا تَتَكَرَّهَنْ","ألفاظَه فالمِسكُ غيرُ كَريهِ",8,"ي",2,0],["لا تَظلِمَنَّ إِذا ما كُنتَ مُقتَدِراً","فَالظُلمُ مَرتَعُهُ يُفضي إِلى النَدَمِ",9,"م",1,1],["لا تَظلِمَنَّ تَكُن مِنَ ال","أَحزارِ وَاعفُ إِذا ظُلِمتا",10,"ت",2,0],["لا تَظُنَّ البُعادَ يُخلِقُ عَهدي","أَو تَحُلَّ الأَيامُ عَقدَ وِدادي",11,"د",2,0],["لا تَظُنَّ اِنقِطاعَ كُتبي بِأَنّي","لَكَ جافٍ كَلّا وَلا مُتَجافِ",12,"ف",1,0],["لا تَظُنُّوا بِيَ سُوءاً","إِنَّ بَعْضَ الظَّنِّ إِثْمُ",13,"م",1,0],["لا تُظهِري سِرّي فَإِنَّ حَديثَكُم","في مَحسَنٍ أَنأى مِنَ النَجمِ",14,"م",1,0],["لا تُظهِري حُبَّهُ حَتّى أُراجِعَهُ","إِنّي سَأَكفيكِهِ إِن لَم أَمُت عَجَلا",15,"ل",2,0],["لا تَظُنّي أَنَّ التَراسُلَ وَالبَذ","لَ بِكُلِّ النِساءِ عِندي يَليقُ",16,"ق",1,0],["لا تَظُنِّي الأمرَ مُمتدَّ المَدَى","وَاصْبِري حَتَّى تَدورَ الدائرهْ",17,"ر",2,0],["لا تظلموا استِقلالَكم","حَسْبي أَأنتم والحِمايهْ",18,"ا",3,0],["لا تَظلِموا مِصرَ إِنَّ البِرَّ آيَتُهُ","أَلّا يُرَوِّعُها ظُلمٌ وَلا رَهَقُ",19,"ق",1,0],["لا تَظلِموا الأَقلامَ إِنَّ سَبيلَها","عَونُ الضَعيفِ وَنُصرَةُ المَخذولِ",20,"ل",1,0],["لا تَظلِموا الدينَ إِنَّ الدينَ يَأَمرُنا","بِما عَلِمتُم مِنَ الأَخلاقِ وَالشِيَمِ",21,"م",1,0],["لا تَظُنّوا المَجدَ شَيئاً هَيِّناً","إِنَّهُ في لَهَواتِ الضَيغَمِ",22,"م",1,0],["لا تظنّوا جمعَكم كُفؤاً لها","حينَ تَمضِي في العجاجِ المُطبقِ",23,"ق",1,0],["لا تظنوا أنكم أكفاؤهم","إنها منكم لأحلام شُرُدْ",24,"د",1,0],["لا تَظنَّ الجودَ دَيْناً يُشْتَرى","سَتَرى الجودَ المُصَفَّى والجوادا",25,"د",2,0],["لا تَظُنّي الناسَ ناساً","أَيُّ أُسدٍ في الثِيابِ",26,"ب",1,0],["لا تَظلِموني وَتَظلِموا الحِسْبَه","فليسَ بيني وَبينها نِسْبَه",27,"ب",2,1],["لا تَظلِموا المَوتى وَإِن طالَ المَدى","إِنّي أَخافُ عَلَيكُمُ أَن تَلتَقوا",28,"ق",3,0],["لا تَظلِموا مِن بَنيها وَاحِداً أَبَداً","حَتّى تَعُدّوا ذَوي فِطرٍ كَصَوّامِ",29,"م",1,0],["لا تظني ورداً يكافئ ورداً","أنت أغلى حسناً وأكرم وردا",30,"د",2,0],["لا تُظهِرَن ذَمَّ اِمرِئٍ قَبلَ خُبرِهِ","وَبَعدَ بَلاءِ المَرءِ فَاِذمُم أَوِ اِحمَدِ",31,"د",1,0],["لا تظن الحب شيئا ً هينا ً","ليس في الحب قياس يطرد",32,"د",1,0],["لا تُظهرنْ ذمَّ امرىء ٍ قبلَ خُبرِه","وبعدَ بلاءِ المرْء فاذمُم أوِ احمَدِ",33,"د",1,0],["لا تظنّوا السلام في الأرض حيّا","بعد أن طالبت بها إسترحاما",34,"م",2,0],["لا تظهري سري، فإنّ حديثكم","في مَحْصَنٍ أَنْأَى مِنَ النَّجْمِ",35,"م",1,0],["لا تظنوا لي اليكم ويهم","قطعة كنت وقلي قد محاها",36,"ا",3,0],["لا تُظْهِرَنَّ خلاف ما عملوا به","فالرَّأْىُ دعْهم يفعلوا ما شاءوا",37,"ا",1,0],["لا تُظُنَّ القَرِيضَ كُلَّ مَقُولٍ","هَلهَلِ النَّسجِ مُستَدَامِ الوُقُوعِ",38,"ع",1,0],["لا تَظُنَّنَّ بي سُلُوًّا وإن كن","تُ عزيزَ الدموع بين الجفونِ",39,"ن",1,1],["لاَ تَظْلِمُوا النَّاسَ وَلا تَطْلُبُوا","بِثَأْرِيَ اليَوْمَ أَذى مُسْلِمِ",40,"م",1,1],["لا تظلموا أسياف ألحاظها","فلحظ عيني الخصم في مهجتي",41,"ي",1,0],["لا تَظُنّوا اِبنَ بَيِّشٍ","في قَضاياهُ يُرتَشي",42,"ش",2,1],["لا تظهرن والشمس طالعة","لا تدَّعيك لنفسها ولدا",43,"د",2,0],["لا تظنوني اسأت الأدبا","بل غلو وهو دأب الادبا",44,"ب",2,0],["لا تظنُّوا الحياةَ تبقى طَويلاً","هكذا الجسمُ بعد حينٍ يصيرُ",45,"ر",1,0],["لا تظنوا أني سلوتُ فأين الصبر","من مُهجَةٍ بكم مُستَهامَه",46,"م",2,0],["لا تظنوا بي صبرا إنما","غلب اليأس على حكم الرجاء",47,"ا",2,0],["لا تُظهرَن للناسِ ضعفاً إنهم","يمشونَ ذؤباناً تقيسُ خُطاها",48,"ا",3,0],["لا تظنّوا عِذاره طرّز الخدّ","فما كان ذا افتقاراً إليه",49,"ه",1,0],["لا تظنوا إن لاح في الخد منه","عارضٌ أن حسنه قد تولى",50,"ل",2,1],["لا تظنوا الموت موتاً أنه","لحياة وهي غاية المنى",51,"ن",2,0],["لا تظني أني سأعطيك أيّا","مي جميعا فالخير ألّا تظنّي",52,"ن",2,0],["لا تظنّوا الحياة ما تخرج الأر","ض فلألاؤها خداع سراب",53,"ب",1,0],["لا تَظُنِّي الدَّهرَ لِي مُستَلِباً","إِنَّما جَرَّدَ مِنِّي مُرهَفَا",54,"ف",2,0],["لا تَظنُّوا أنّ سَجعاً شاقَني","أنا أطربتُ حَمامَ الواديَيْن",55,"ن",1,0],["لا تَظْلِمِ الإحْسانَ مُصْطَنِعاً","مَنْ أَنتَ تَبْنِيهِ ويَنْهَدِم",56,"م",1,0],["لا تظُنَّنَّ ما تمكَّنتُ مِنهُ","مِن زَماني صَنيعَةً لزَماني",57,"ن",2,1],["لا تَظُنُّوا دموعَها رُسلَ حُزنٍ","قد تكونُ الدُّموعُ رُسلَ السرورِ",58,"ر",1,0],["لا تَظُنُّنَّ بي وبِرُّكَ حَيَّ","أن شُكري كشكرِ غَيري مَواتُ",59,"ت",1,1],["لا تَظنَّنَ وجدَ مَن فارقَ الأظ","عانَ يحتَثُّهُنَّ حادٍ عَجولُ",60,"ل",1,0],["لا تظني البعاد مني سلّوا","أو جفاءً أو أن قلبي ملّا",61,"ل",2,0],["لا تَظُنَّ الظلامَ يخلع عنه","رُدُنَيْهِ ولا الزَّمانَ الظَّلوما",62,"م",2,0],["لا تظلِم العبادَ واعلَمْ أن مَنْ","آذى امرءاً يُجزاهُ في يومِ اللِّقا",63,"ا",1,0],["لا تظنّني عنه راضياً","إنّني أُخْفي ضَميرَ الساخِطِ",64