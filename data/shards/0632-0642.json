{"poems":[[79,"سألتك عبد الله إيضاح مشكل","https://www.aldiwan.net/poem36528.html","الطويل"],[90,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[53,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[101,"لا تسألوني","https://www.aldiwan.net/poem5901.html","عموديه"],[60,"أنا للحراب اليها","https://www.aldiwan.net/poem30806.html","مجزوء الرمل"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[201,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[463,"أإن تحدث عصفور على فننِ","https://www.aldiwan.net/poem55829.html","البسيط"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[558,"هات اسقني طال بي الحبس","https://www.aldiwan.net/poem68376.html","السريع"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124695","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77969","الكامل"],[2488,"","https://poetry.dctabudhabi.ae/diwan/poem/31478","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100895","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58343","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97980","الكامل"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36086","الكامل"],[4831,"ولادة حلم","https://www.poetsgate.com/ViewPoem.aspx?id=208009",""],[5431,"أيّتها النار","https://www.poetsgate.com/ViewPoem.aspx?id=207669",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[6124,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=159782",""],[6124,"زقزق","https://www.poetsgate.com/ViewPoem.aspx?id=201334",""]],"verses":[["زَقَنْدَرُ قالوا عنه معْدِنُ فِضّةٍ","فَما بالُهُ أبْداكَ نُدْرَةَ عسْجَدِ",0,"د",1,0],["زُقا إلى حور الجنان لأجل ذا","لبسا وشاحاً من دم موّار",1,"ر",1,0],["زِقَاقُهُمْ في الدار مَبْطُوحَةٌ","وعُودُهُمْ ليس بِمَبْطُوح",2,"ح",1,0],["زق العبير.. إن حطمتموه","غرقتم بعاطرٍ سكيب",3,"ب",1,0],["زَقَّني بِالعِلمِ زَقّاً","فيهِ قَد صِرتُ فَقيها",4,"ي",3,0],["زِقاقٌ من الرّيحِ منفوخةٌ","وإنْ ثَقَّلَ الزهوُ منها الخطى",5,"ا",1,0],["زقّت وهل زفّت فتا","ة الحي للزوج الحبيب",6,"ب",1,0],["زقا فذكَّرني أيامَ كاظمةٍ","عمارة الدار من لهوٍ ومن دَدَنِ",7,"ن",1,0],["زقت من كُفَّة القنّاص تمكو","إليها وهي أفرخةٌ تُزَقُّ",8,"ق",1,0],["زِقِيَّةُ الدارِ رُصافِيَّةٌ","أَغلى بِها الشَمّاسُ وَالقَسُّ",9,"س",1,0],["زقزقات الطير في أدواحها","ودموع الليل في ثغر الأقاحي",10,"ي",1,0],["زقومها وَحَميمها وَسمومها","سيان بينكما تقسم أَشطرا",11,"ر",2,0],["زَقَبٌ يَظَلُّ الذِئبُ يَتبَعُ ظِلَّهُ","مِن ضيقِ مَورِدِهِ اِستِنانَ الأَخلَفِ",12,"ف",1,0],["زقا صدى من قبور السالفين فهل","دوَّى فذكَّر منكم ناسياً فوعى",13,"ع",2,0],["زَقْزَقَةٌ أعرِفُها","منهُ إذا ما فَشّرا",14,"ر",2,0],["زققتها من حب قلبي واللمى","عنها يسقيني كفرخ أخضر",15,"ر",1,0],["زَقّ الطُيور فِراخها","لِصَبوحِها أَو لِلغَبوقِ",16,"ق",1,0],["زقَّ الوِشَاحُ عَنْ لُجيْنٍ ساحِرٍ","فلاحَ لي فَجْرٌ بَهِيٌّ مُبهرُ",17,"ر",1,0],["زقورةٌ في ساحاتها شُهُبٌ","والعزّ والمجد بالسما سطعا",18,"ع",2,0],["زقاً على ضبِّ النصالِ أسِلْتها","مهْراقةً جود الغيومِ ألحُلّسِ",19,"س",1,0],["زَقْوُرَةٌ تَحْكِي غِنَى آثَارِهَا","وَمَعَالِمٍ قَدْ تَمْلأ الصَفَحَاتِ",20,"ت",1,0],["زَقْزِقْ أيا عصفورُ في داري حنينْ","في شعرِها ليلٌ وفرقانٌ مُبينْ",21,"ن",1,1],["زَقْزَقَ العُصْفُوْرُ صُبْحًا","قَالَ لِلأَحْلامِ قُوْمِي",22,"ي",1,1]]}