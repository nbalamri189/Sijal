{"poems":[[79,"سألتك عبد الله إيضاح مشكل","https://www.aldiwan.net/poem36528.html","الطويل"],[90,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[53,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[101,"لا تسألوني","https://www.aldiwan.net/poem5901.html","عموديه"],[60,"أنا للحراب اليها","https://www.aldiwan.net/poem30806.html","مجزوء الرمل"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[201,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[461,"أإن تحدث عصفور على فننِ","https://www.aldiwan.net/poem55829.html","البسيط"],[461,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[556,"هات اسقني طال بي الحبس","https://www.aldiwan.net/poem68376.html","السريع"],[870,"","https://poetry.dctabudhabi.ae/diwan/poem/31478","الكامل"]],"verses":[["زَقَنْدَرُ قالوا عنه معْدِنُ فِضّةٍ","فَما بالُهُ أبْداكَ نُدْرَةَ عسْجَدِ",0,"د",1,0],["زُقا إلى حور الجنان لأجل ذا","لبسا وشاحاً من دم موّار",1,"ر",1,0],["زِقَاقُهُمْ في الدار مَبْطُوحَةٌ","وعُودُهُمْ ليس بِمَبْطُوح",2,"ح",1,0],["زق العبير.. إن حطمتموه","غرقتم بعاطرٍ سكيب",3,"ب",1,0],["زَقَّني بِالعِلمِ زَقّاً","فيهِ قَد صِرتُ فَقيها",4,"ي",3,0],["زِقاقٌ من الرّيحِ منفوخةٌ","وإنْ ثَقَّلَ الزهوُ منها الخطى",5,"ا",1,0],["زقّت وهل زفّت فتا","ة الحي للزوج الحبيب",6,"ب",1,0],["زقا فذكَّرني أيامَ كاظمةٍ","عمارة الدار من لهوٍ ومن دَدَنِ",7,"ن",1,0],["زقت من كُفَّة القنّاص تمكو","إليها وهي أفرخةٌ تُزَقُّ",8,"ق",1,0],["زِقِيَّةُ الدارِ رُصافِيَّةٌ","أَغلى بِها الشَمّاسُ وَالقَسُّ",9,"س",1,0],["زَقَبٌ يَظَلُّ الذِئبُ يَتبَعُ ظِلَّهُ","مِن ضيقِ مَورِدِهِ اِستِنانَ الأَخلَفِ",10,"ف",1,0]]}