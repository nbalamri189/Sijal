{"poems":[[463,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[482,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2410","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137339",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102739","البسيط"],[463,"من جبَّ غاربَ هاشم وسنامها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60331&r=&rc=387",""]],"verses":[["حَمَّسْتَ حتّى قيل صبَّ دماءها","وغَزِلْتَ حتّى قيل صبَّ مُدامَها",0,"م",3,0],["حُمْسٍ برودُهمُ الزغَّفُ الَّلاصُ اِذا","أمستْ برودُ أُناسٍ سُحْقَ أطمارِ",1,"ر",1,0],["حَمِسٌ بِاللِواءِ لَيثٌ إِذا ما","رايَةُ الموتِ بِالمَنايا تَدورُ",2,"ر",1,0],["حمَّس الجند في المعارك حتى","باتَ كلٌّ إلى المنون يطيرُ",3,"ر",1,0],["حَمْسَاءَ تَمَّتْ مِنْ تَمِيم فَيْلَقا","إِذَا اسْتَبَاحَتْ عِزَّ قَوْمٍ طَرَّقا",4,"ق",2,0],["حمس اللقاء لدى الهيجاء ان صدموا","ليسوا بميل لئام الأصل انكاس",5,"س",1,0],["حمَّستَ حتّى قيل صبَّ دماءها","وعزلتَ حتّى قيل صبَّ مدامها",6,"م",3,0]]}