{"poems":[[88,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[68,"ومدام حكت سهيل اتقادا","https://www.aldiwan.net/poem39189.html","الخفيف"],[52,"أرسلت خلتي من الدمع غربا","https://www.aldiwan.net/poem64795.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85369","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9919","الخفيف"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/6095","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[33,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[132,"هاكم من أخى وداد سلاما","https://www.aldiwan.net/poem50527.html","الخفيف"],[136,"إن أشهى ما تشتهى النفس بنا","https://www.aldiwan.net/poem54724.html","الخفيف"],[154,"قل لمن يحسدكم","https://www.aldiwan.net/poem68538.html","مجزوء الرمل"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[409,"قال لي خلي لما زارني","https://www.aldiwan.net/poem33464.html","الرمل"],[457,"وجليس منيته ظرف الأن","https://www.aldiwan.net/poem13716.html","الخفيف"],[543,"حدثوا عن خائن","https://www.aldiwan.net/poem48300.html","عموديه"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101489","الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53953","الرمل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81898","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109589","السريع"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137372",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75993","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130843",""],[2809,"","https://poetry.dctabudhabi.ae/diwan/poem/146637","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204903","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204881","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204507","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204649","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199907","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216543",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114527","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114113","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125839","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54407","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120346","الرمل"],[4767,"حديث مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=124899",""],[4902,"جتني","https://www.poetsgate.com/ViewPoem.aspx?id=5043",""],[5038,"المربد العجب","https://www.poetsgate.com/ViewPoem.aspx?id=190219",""],[5392,".. للقافياتِ عيون","https://www.poetsgate.com/ViewPoem.aspx?id=132112",""]],"verses":[["قُلتُ كُفّوا فَإِنَّما قُمتُ أَرثي","مِنهُ خِلّاً أَمسى طَويلَ الغِيابِ",0,"ب",1,0],["قُلتُ كَم عُمرُها المَديدُ فَقالوا","خُلِقَت قَبلَما يُخلَقُ التاريخُ",1,"خ",1,0],["قُلتُ كَلّا لا بَل صَفا لَكِ حَتّى","زادَكِ اللَهُ يا عُبَيدَةُ حُبّا",2,"ب",2,0],["قلت كان الإسلام دينيَ فيها","وهو دينٌ بالإحترام جديرُ",3,"ر",1,0],["قلتُ كم عشتَ قال تسعين عاماً","قلت ماذا فعلت فيها فقالا",4,"ل",2,0],["قُلتُ كُفّي الدُموعَ عَنكِ فَقَلبي","ذابَ حُزناً وَلَوعَتي في اِزدِيادِ",5,"د",1,0],["قُلتُ كَلّا لاهِ اِبنُ عَمِّكِ بَل خِف","نا أُموراً كُنّا بِها أَغمارا",6,"ر",2,0],["قلت كلاّ فانظروا وانتبهوا","ليس في الأمر التباسٌ أو خَفاء",7,"ا",2,0],["قُلْتُ: كَلاَّ لاهِ کبْنُ عَمِّكِ بَلْ خِفْ","نا أُموراً كُنّا بِهَا أَغْمَارا",8,"ر",2,0],["قلت كّلا إن التعامى خداعٌ","وخداعى لهمْ يصير حراماً",9,"م",2,0],["قُلتُ كَلاَّ وكَيفَ يُمكِنُ هَذَا","وبِقَلبي غَرَامُ بَنَّه أَبَنَّا",10,"ن",2,0],["قلت كلّ الشّكر منّا","بعض آثار يديه",11,"ي",2,0],["قُلتُ كَي تَشتَفي الآلامَ مِن","جَسَدي يُشفى فُؤادي قالَ كَي",12,"ي",1,0],["قلتُ كم ذا تُديرُ مُرِّ عِتابٍ","قال خيرُ الخُمورِ ما كان مُرّا",13,"ر",2,0],["قلت كالنرجس يا مَنْ حبه","أتلف المملوك لكن ما قتل",14,"ل",1,0],["قلت كيف النَدِيمُ قال يُحيّا","ويُفدّي بأنفسٍ وجُدود",15,"د",1,0],["قلتُ كيف المَنامُ قال على ال","راحِ مزيد هي ابنةُ العُنقود",15,"د",1,0],["قلت كيف السقاةُ قال وهل يَصْ","لُحُ كأسٌ بغير ساقٍ مَيود",15,"د",1,0],["قلتُ كيف المشامُ قال مع ال","ريحان حيّى بنرْجِس وورودِ",15,"د",1,0],["قلتُ كيفَ القيانُ قال اليه","نّ انقياد الأوتاد عند النشيد",15,"د",1,0],["قلتُ كيفَ الغناءُ قال تظرّف","تَ ولم يعْدُ فيه بيت القصيد",15,"د",1,0],["قلتُ كلبٌ خائِنٌ","إنكم لم تكذِبُوا",16,"ب",3,0],["قلتُ كلاَّ ليس يشكو علَّةً","انما يصفرُّ من طول السهَر",17,"ر",1,0],["قلتُ كُنْ لي عندما أوْعدتَنِي","قال وَعْدي لَكَ خالٍ من دَخَنْ",18,"ن",1,0],["قُلْتُ كُفُّوا ثُمَّ اسْمَعُوا نَصَّ قَوْلِي","إِنَّمَا القُطْبُ خَادِمِي وَغُلاَمِي",19,"م",2,0],["قلت كل منه لا من أحدٍ","جل عن كل شريكٍ ووزر",20,"ر",1,0],["قلتُ كذبتم كان من جوده","يطعمني في كل عامٍ رغيف",21,"ف",1,0],["قلت كفوا عن النصيحة اني","من شؤون الجوى وقد كان حرا",22,"ر",2,0],["قُلت كَيفَ الخَلاصُ مِن حُبِّ ريمٍ","قَد سَباني وَلَيس يَنفَعُ كَيفُ",23,"ف",1,0],["قلت كلا ان نفسي ترتقي","في شغوفٍ حرةً لا تسجن",24,"ن",1,0],["قلت: كسير فمن يجبره؟","قال: ترى من يحب جبرانه",25,"ن",2,0],["قلت كلا فقتلها هو قتلي","كلها في حمايَ هذي الطيور",26,"ر",1,0],["قلت كلا فحفلتي حيث لا يو","جد ناس في جانبي أو أمامي",27,"م",2,0],["قلت كفّوا عن المحال فشعري","لا يغنى لأن شعري غناء",28,"ا",2,0],["قلت كم ذقت من طوى قبل لكن","قد أبى لي الاظهار طبع عفيف",29,"ف",1,0],["قلت كم قد صبا ذوو المجد قبلي","قال لم يصب قطُّ الا الضعيف",29,"ف",1,0],["قلت كلا ايمان قلبي اقوى","من دعاوى الحواس والبرهان",30,"ن",1,0],["قِلْتْ كان عِبَّلتي عِباله","قالت ارْمِس لاجْلكْ باغَضِّي",31,"ي",1,0],["قلت كلا فاين للجن لولا","قدرة اللَه ذلك الاقتجار",32,"ر",1,0],["قَلَتكَ وَلَكِن صانَهَا اللَّهُ فادِياً","لَهَا بالسوى حتى أتتكَ تَرَفَّقُ",33,"ق",1,0],["قُلتُ كَيفَ الإخبَارُ عَنهُ وَلاَ يَق","بَلُ تَعرِيفاً إِن عَشِقتَ دَرَيتَه",34,"ه",1,0],["قلت كلا إنه شيءٌ","له عندي حكاية",35,"ا",3,0],["قلتُ كُفّي فخيرُ يومكِ عندي","أَنْ تفوزي بالتبنِ أو بالحشيشِ",36,"ش",1,0],["قلت كلا انما مرآتها","هي مرضاة امير المؤنين",37,"ن",1,0],["قلت: كف يا قلم عما إذا","قلته حبرك يوما يسكب",38,"ب",1,0],["قلت كن بوجنتك زهر النبات","قالت إن الرمش تجرحني صفاها",39,"ا",3,0],["قَلَتْكَ مَرابِدُ الأُدَبا","وَأَنْتَ الْمِرْبَدُ الْعَجَبُ",40,"ب",1,0],["قلتُ: كنتُ الكلامَ قبلَ كلامي","في يديَّ البيانُ رَوضٌ هَتونُ",41,"ن",1,0]]}