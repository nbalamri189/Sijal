ry.dctabudhabi.ae/diwan/poem/86534","الطويل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116894","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75718","الوافر"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123952","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45108","المتقارب"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45111","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67655","الوافر"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103332","الهزج"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123453","الطويل"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/143253","الهزج"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139593",""],[4778,"فت النوى قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190330",""],[5089,"جمالُ الحق قد ظهرا","https://www.poetsgate.com/ViewPoem.aspx?id=128711",""],[1043,"الحبيب الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=94022",""],[5277,"إذا لَجّ الحنينُ","https://www.poetsgate.com/ViewPoem.aspx?id=208795",""],[5277,"\" من البغداديات \"","https://www.poetsgate.com/ViewPoem.aspx?id=210741",""],[5574,"على أرض الخلود - ذكرى ترفرف","https://www.poetsgate.com/ViewPoem.aspx?id=205995",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5582,"بريقٌ لاحَ مُؤْتَلِقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63542",""],[5809,"انا","https://www.poetsgate.com/ViewPoem.aspx?id=205285",""],[5809,"وصفة","https://www.poetsgate.com/ViewPoem.aspx?id=205329",""],[5809,"الود","https://www.poetsgate.com/ViewPoem.aspx?id=205350",""],[5853,"علام..؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=175681",""],[6084,"وطائفة ليلا علينا بكأسها","https://www.poetsgate.com/ViewPoem.aspx?id=170856",""],[6093,"إذا ما شَعَانِي الهمُّ بالذكر ذُدتُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198294",""],[6125,"عَلَامَ تَرَكتَ قَلْبِي لِلمَنَايَا","https://www.poetsgate.com/ViewPoem.aspx?id=210917",""],[6152,"الصلاة على خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=204528",""],[463,"أمرتكمُ أمري بنعمانَ ناصحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60004&r=&rc=60",""],[5567,"وجد الوجود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69070&r=&rc=8",""]],"verses":[["إذا ما شئْتَ أنْ يَلقاكَ فيهِمْ","عَدوٌّ فاتّخِذْ مِنهُمْ خَليلا",0,"ل",2,0],["إِذا ما شِئتَ أَن تَصنَ","عَ شَيئاً يُعجِبُ الناسا",1,"س",2,1],["إذا ما شَرَعْتَ اللّحْظَ نحْوي عابِساً","أقولُ لقَلْبٍ ضاعَ ما بيْنَ جُلاّسِي",2,"س",2,0],["إِذَا مَا شَقِينَا فِي مُعَادَاةِ بعْضِهِ","فَبَاقِيهِ يَجْبِي المَالَ مِنَّا وَيَنْعَمُ",3,"م",1,0],["إِذا ما شِئتَ أَن تَلقى لَئِيما","فَأَوقِد يَأتِكَ المَرَئِيُّ نارا",4,"ر",2,0],["إِذا ما شَرِبتَ البابِلِيَّةَ لَم تُبَل","حَياءً وَلا يُسقى عَفيفاً عَصيرُها",5,"ر",3,0],["إذا ما شحطن الحادييْن سمعتهم","بخاء بِك الحق يهتفون وحَىَّ هَلْ",6,"ل",1,1],["إِذا ما شاتُهُم وَلَدَت تَنادَوا","أَجَديٌ تَحتَ شاتِكِ أَم غُلامُ",7,"م",1,0],["إذا ما شرعتم في علاه عقيقة","شرعنا له في درّةٍ من مدائح",8,"ح",1,0],["إذا ما شَتَا كادتْ أنامِلُ كَفِّهِ","تذوبُ سَمَاحاً والأنامِلُ جُمَّدُ",9,"د",1,0],["إذا ما شنطفٌ نَكَهَت أماتت","فمن ندمائها قتلى وصرعى",10,"ع",2,1],["إذا ما شئتَ أنْ تَعْر","ف يوماً كَذبَ الشهوَهْ",11,"و",2,1],["إِذا ما شَدا بِالطِرسِ أَذهَبَ شَدوُهُ","هُمومَ ذَوي الشَكوى وَوَقرَ ذَوي الوَقرِ",12,"ر",1,0],["إِذا ما شَرِبتُ الخَمرَ صِرفاً مُهَنَّأً","شَرِبنا الَّذي مِن مِثلِهِ شَرِبَ الكَرمُ",13,"م",1,1],["إِذا ما شِتاءُ المَحلِ أَمسى قَدِ اِرتَدى","بِمِثلِ سَحيقِ الأُرجُوانِ قِتامُها",14,"م",3,0],["اِذا ما شئتَ أَن تَحيا","حياةً حُلوَةَ المَحيا",15,"ي",2,1],["إِذا ما شِئتَ أَن تُعصى","فَمُر مَن لَيسَ يَرجوكا",16,"ك",2,0],["إِذا ما شِئتَ أَن تَسلو حَبيباً","فَأَكثِر دونَهُ عَدَدَ اللَيالي",17,"ل",2,0],["إِذا ما شَقَقتَ صُدورَ البُيوتِ","وَجَدتَ بِهِنَّ قُلوبَ المَعاني",18,"ن",2,0],["إذا ما شكّ نحرُ العلجِ منه","تعالى بالحِمام له خُوَارُ",19,"ر",1,0],["إِذا ما شَبابي نالَ شيبُكَ عِطفَهُ","فخاسرةٌ نَفسي ونفسُكَ رابحَه",20,"ح",2,0],["إِذا ما شُبتَ حُسنَ الدي","نِ مِنكَ بِصالِحِ الأَدَبِ",21,"ب",1,1],["إِذا ما شِعرُ قَومٍ كانَ لَيلاً","تَبَلَّجَتا كَما اِنشَقَّ النَهارُ",22,"ر",1,0],["إذا ما شئتَ أن تحيا","سعيداً سالماً راضي",23,"ي",1,1],["إِذا ما شَكا ليمٌ إِلَيكَ مُصيبَةً","بِها قَلبُهُ وافي الهُمومِ عَميدُ",24,"د",1,1],["إِذا ما شِئتُ صَبَّحَني هِلالٌ","وَأَيٌّ الناسِ أَثقَلُ مِن هِلالِ",25,"ل",1,0],["إِذا ما شِئتُ غَنّاني كَريمٌ","لَهُ حَسَبٌ وَلَيسَ لَهُ تِلادُ",26,"د",1,0],["إِذا ما شِئتُ راحَ عَلَيَّ هَمٌّ","مِنَ الغادينَ أَو طَرَبٌ مُلِحُّ",27,"ح",1,0],["إِذا ما شِئتُ نَغَّصَني نَعيمي","وَأَجرى عَبرَتي جَريَ الحَبابِ",28,"ب",1,0],["إِذا ما شِئتُمُ دَعَةً وَخَفضاً","فَعيشوا في البَرِيَّةِ خامِلينا",29,"ن",2,1],["إذا ما شربت الخمر صرفاً مهنئاً","شربنا الذي من مثله شرب الكرم",30,"م",1,1],["إِذَا مَا شَرِبْنَاهَا أَقَمْنَا مَكَانَنَا","وَظَلَّتْ بِنَا الأَرْضُ الْفَضَاءُ تَدُورُ",31,"ر",1,0],["إذا ما شئتَ أن تحيا سعيدا","فقل لا تؤِتنى يا ربِّ عقلا",32,"ل",2,0],["إِذا ما شَهِدتُم مَأزِقاً شَهِدَ الورى","بِأَنَّكُمُ أَجرى وَأَمضى مِنَ الظُبا",33,"ب",2,0],["إذا ما شوى حر الهوى حر وجهه","تذكر ذاك الظل والمورد العذبا",34,"ب",2,0],["إذا ما شربنا أرى الأرض تمشي","وكل امرىءٍ فوقها راكبُ",35,"ب",1,0],["إذا ما شاءَ ردَّ عليَّ نومي","ولكني أراهُ لا يشاءُ",36,"ا",2,0],["إِذا ما شَدَدنا شَدّةً نَصَبوا لَها","صُدورَ المَذاكي وَالرِماحَ المَداعِسا",37,"س",2,0],["إذا ما شدا شاد بوجد ولوعة","بكيت له والدمع غرثان صائم",38,"م",1,0],["إِذا ما شَمَّرَت حَربٌ عَوانٌ","يَخافُ الناسُ عُرَّتَها كَفاها",39,"ا",3,0],["إِذا ما شِئتُ نالَكَ هاجِراتي","وَلَم أُعمِل بِهِنَّ إِلَيكَ ساقي",40,"ق",2,0],["إِذا ما شَمَّرَت حَربٌ سَمَونا","سُمُوَّ البُزلِ في العَطَنِ الفَياحِ",41,"ح",1,0],["إِذا ما شَمَّرَت حَربٌ سَمَونا","سُمُوَّ البُزلِ في العَطَنِ الرَحيبِ",42,"ب",1,0],["إذا ما شاءَ تجربةً رآنا","بتَجربةِ العزائمِ راغبينا",43,"ن",2,0],["إذا ما شكا العشّاقُ وجداً مبِّرحاً","فكلُّ الذي يشكونه بعضُ ما لَقِي",44,"ق",2,0],["إذا ما شكوتُ الحبَّ أَمررت كَفَّها","عَلى كبدٍ ما يندملن صدوعها",45,"ع",3,0],["إذا ما شكا المُلْكُ اعْوجاجَ قَناتِه","كَساها ثِقافَ الرَّأي حتّى تَقَوّما",46,"م",2,0],["إذا ما شَبَّ نارُ الحربِ أَضحَتْ","رؤوسُ عُداتِه شَرَراً تَراقى",47,"ق",2,0],["إذا ما شهابَ الدّينِ زارتْ رِكابُنا","فَقُلْ في سُرَى الصّادي إلى المنهلِ العذب",48,"ب",1,0],["إِذا ما شاربُ القوم اِحتَساها","أَحَسَّ لَها دَبيباً في العِظامِ",49,"م",1,0],["إِذا مَا شَجا الأَعداءَ فِي قِممِ الذُّرَى","شَفاها بِحَظٍّ تَحْتَ أَقدامِها مُلقى",50,"ق",2,0],["إذا ما شاء أن يُغرِيه يوماً","بفرط البذل من يغريه لامَهْ",51,"م",2,0],["إذا ما شربتُ الوصلَ عَذباً مرقرَقاً","بها لم أعَفْ أن أشرب الماء مالحا",52,"ح",2,0],["إذا ما شببتم نار حرب وقودها","صدور المواضي البيض والأسل السمر",53,"ر",1,0],["إذا ما شكت بيض السيوف ظماءةً","سقاها فروَّاها من الهامِ عنترُ",54,"ر",1,1],["إذا ما شمْتُهُ لِقِراعِ خَطْبٍ","جَلا الغمَّاء عن وجهي وصدْري",55,"ر",2,0],["إِذا ما شِئتَ أَن تَغدو عَزيزاً","تُبَجَّلُ في الغُدُوِّ وَفي الرَواحِ",56,"ح",1,1],["إِذا ماشِئتَ أَن تَلقى بِأَرضٍ","لَقَيتَ لَهُ بِها كَرَماً عَجيبا",57,"ب",2,0],["إذا ما شربناها خفينا بنورها","وعند طلوع الشمس ما للدجى رسم",58,"م",1,0],["إذا ماشاء أشهدها أناساً","فكل بالسوى راض قنوع",59,"ع",1,0],["إِذا ما شياطينُ الضَّلالِ تمرَّدت","جِدَالاً فمِنْ أَقواله كَوْكَبُ الرَّجْمِ",60,"م",1,0],["إذا ما شئتَ تعرفُ بَعضَ حَقّي","فَحسبُكَ أنَّني لأخيك غَرسُ",61,"س",1,0],["إِذا ما شَياطينُ السلوّ تعرّضت","فَإِن بعيني أَيَّ رَجمِ شِهابِ",62,"ب",1,0],["إذا ما شدا الشادي به عند بابكمْ","فأعطافُكُمْ حقاً تميل من الزّهوِ",63,"و",1,0],["إذا ما شَياطينُ المُنى طُفْنَ حَولَها","رَمَتْها رُجومُ الخَطِّ عن ضُمَّرٍ جُردِ",64,"د",1,0],["إِذا ما شَدانا أَنعَشَ الجِسمَ وَالحَشا","فَيَرقص ما يَخفى وَما هوَ ظاهِرُ",65,"ر",1,0],["إذا ما شئْتَ بُعْدَ أُنَيِّسَانٍ","وشئت شُطونَه طولَ الحياةِ",66,"ه",1,1],["إذا ما شئتَ مدحاً في","ذوي المعروفِ والفضلِ",67,"ل",1,1],["إِذا ما شَدَدتُ الرأسَ مِنّي بِمِشوَذٍ","فَغَيّكَ مِنّي تَغلِبَ اِبنَةَ وائِلِ",68,"ل",1,1],["إذا ما شياطين الهموم طرقنني","ولاح جبين اليأس وهو دميم",69,"م",1,0],["إِذا ما شئت تَسليني فَزُرني","فَقَد فَهم الشّكاية من رَآني",70,"ن",2,0],["إذا ما شكا الليل هجر الصباح","شكوت إلى الليل هجر الصباح",71,"ح",1,0],["إذا ما شئت وافر كلّ خيرٍ","فَصَلِّ على المظلل بالغمام",72,"م",1,1],["إِذَا مَا شَكَا قَبْضاً أَخُو الفَقْرِ عِنْدَهُ","ثَنَاهُ وَلاَ قَبْضُ لِلأَمْوَالِ ذَا قَبْضِ",73,"ض",1,0],["إذا ما شدا زال العنا وتراكضَت","خيول الصفا من كل فجّ بلاغب",74,"ب",1,0],["إذا ما شدت فوق الأراك ترنّماً","فإنَّك تنعى والجوانح ترجفُ",75,"ف",1,0],["إذا ما شكوناهم عميداً فأمرنا","لأعلم منه بالنكاية أحذق",76,"ق",1,0],["إذا ما شكا قبلى من العيس موجَع","شكوت قطار البَرَّ أدهَم أسفعا",77,"ع",2,0],["إذا ما شكوت اليتم كهلاً بفقدها","شكا هرمي من بعدها لوعة اليتم",78,"م",1,0],["إذا ما شرفَ الإشرافُ قَوماً","فإنَّ بني رَحيمٍ شَرَّفُوهُ",79,"ف",3,1],["إِذا ما شئت أَن تُشنأ فنظِّم","قَريضاً وَالتمس فيهِ الإِثابه",80,"ب",2,0],["إِذا ما شَكَت أَيناً ذَكَرتُكَ فَوقَها","فَزَفَّت زَفيفَ الرَألِ فَأَجاهُ رائِعُه",81,"ع",2,0],["إِذا ما شِئتَ أَن تَسلى حَبيباً","فَأَكثِر دونَهُ عَدَدَ اللَيالي",82,"ي",1,1],["إِذا ما شِئتَ هَبَّ إِلَيَّ مِنها","مُذرَّبَةُ الأَسِنَّةِ كَالنُّجومِ",83,"م",1,0],["إذا ما شربت الراح أبدت مكارمي","وجدت بما حازت يداي من الوفر",84,"ر",1,1],["إِذا ما شَكَوت الحُب أَبصَرت خَده","وَظل الحَيا مِن وَردِهِ يترشح",85,"ح",1,0],["إِذا ما شَكَوت اعتلّ كُل مكون","وَيصلح هذا الدَهر إِن أَنتَ تَصلح",85,"ح",1,0],["إذا ما شدا أنساك ألحان معبد","ومزمار داوود إذا ما ترنما",86,"م",2,0],["إذا ما شربناها لنيل مسرّة","تبسّم عن در لها فتقطّب",87,"ب",1,0],["إِذا ما شَرِبتُ الراحَ يا صاحِ فاتَني","لأَرشِفَ مِن ذاكَ الرُضابِ بَقاياها",88,"ه",2,1],["اذا ما شاء كان الامر حتما","والا فهو يأبى ان يكونا",89,"ن",2,0],["إِذا ما شَرِبنا كَأسَنا صُبَّ فَضلُها","عَلى رَوضِنا للمسمع المُتَخَلَّعِ",90,"ع",1,0],["إذا ما شهرنا السيف في حومة الوغى","يرى البرق في شرق الدنا والمغارب",91,"ب",1,0],["إذا ما شدا يُنسي العراق عراقه","ويلهو بارباب النهى نهيونده",92,"د",2,0],["إذا ما شربت الكأس وارتدت قبلةً","تعين عليها قربت لفمي الفما",93,"م",2,0],["إذا ما شلّ نصفُ المرءِ يوماً","فقَد خارت عَزائمهُ ومالا",94,"ل",2,0],["إذا ما شدا سلم