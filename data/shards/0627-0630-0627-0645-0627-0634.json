ِي المَجالِسِ ناشِدٌ","تَمَلَّكَ مَعْناهُ عُقُولاً وَأَذْهانا",123,"ن",2,0],["إِذا ما شامَ مُزْنَ نَدا","هُ عافٍ سَحَّ وَانْبَعَقَا",124,"ق",2,0],["اذاما شكا للناسِ ذو الهمِّ همَّهُ","لجأتُ لربِّ الناسِ اشكوهُ ناسيا",125,"س",3,0],["إذا ماشئتَ أن تحيا سليماً","صحيحاً ،دعْ طعامَك وجبتينِ",126,"ن",1,1],["اذا ماشحَّ ودُّ أخيكَ يوماً","فليسَ يزيدُهُ الأسَفُ الكثيرُ",127,"ر",1,1],["إذا ما شاهدتْ للخل عينا","تسائل عينها ..لطفا علاما..؟",128,"م",2,0],["اذا ما شربنا خمرة من رضابها","ضللنا سكارى بين متن مرسل",129,"ل",1,0],["إذا ما شَعَانِي الهمُّ بالذكر ذُدتُهُ","ألا إنَّ ذكرَ الله حصنٌ مُحَصَّنُ",130,"ن",1,1],["إذا مَا شِئتَ يا رُوحِي وقَلْبِي","سَأجعَلُ مِنْ لَظَىٰ صَدرِي مَطَايَا",131,"ا",3,0],["إذا ما شئت تفريجا لهّم","فقل : يا رب صل على محمد",132,"د",1,1],["إذا ما شربتُ الوصلَ عذبا مرقوقا","بها لم أعفْ أن أشرب الماء مالحا",133,"ح",2,0],["إذا ما شئتِ أسبابي وبابي","أنا في عمق أعماق السجودِ",134,"د",1,0]]}