أقول ولا جديد يُقالُ","https://www.poetsgate.com/ViewPoem.aspx?id=208820",""],[4734,"خيل من الرشقات","https://www.poetsgate.com/ViewPoem.aspx?id=50220",""],[4767,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=95450",""],[4767,"صفحة الخير","https://www.poetsgate.com/ViewPoem.aspx?id=125022",""],[4767,"غادة الحُسن","https://www.poetsgate.com/ViewPoem.aspx?id=211673",""],[1703,"يا أذن ما تشتكين اليوم يا أذني","https://www.poetsgate.com/ViewPoem.aspx?id=49865",""],[4578,"رنا إلي بعينيه فقلت رشا","https://www.poetsgate.com/ViewPoem.aspx?id=49448",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5085,"هواجس شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=188448",""],[5150,"المعلم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202918",""],[5152,"من أجل من","https://www.poetsgate.com/ViewPoem.aspx?id=184525",""],[5183,"السر الخفي","https://www.poetsgate.com/ViewPoem.aspx?id=180211",""],[5183,"القضاء الحاسم","https://www.poetsgate.com/ViewPoem.aspx?id=185644",""],[5183,"إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=180188",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5302,"ذنوب وتوبة","https://www.poetsgate.com/ViewPoem.aspx?id=202728",""],[5431,"والشعر بحرٌ طائرٌ في أربعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=197923",""],[5458,"الحج غدفة","https://www.poetsgate.com/ViewPoem.aspx?id=72397",""],[5497,"سر السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=206936",""],[5563,"في رثاء ولديَّ إبراهيم وهياء - رحمهما الله - .","https://www.poetsgate.com/ViewPoem.aspx?id=211786",""],[5573,"ياوقتي يامطول ليلك/مع طولك ماتقضي شف","https://www.poetsgate.com/ViewPoem.aspx?id=200307",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5704,"شموس الحق","https://www.poetsgate.com/ViewPoem.aspx?id=200002",""],[4623,"ذكر فان النفع في التذكار ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146607",""],[5778,"الْمَالُ فِي يَدِهِ كَالْمَاءِ فِي يَدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=205155",""],[5791,"وشم ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208559",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5910,"حيِّ الطلولَ ونبِّ عن أخبارِها","https://www.poetsgate.com/ViewPoem.aspx?id=206239",""],[5956,"من مزايا البنك الإسلامي للتنمية","https://www.poetsgate.com/ViewPoem.aspx?id=193485",""],[6093,"يَزُفُّ الدَّهرُ خَوَّاناً","https://www.poetsgate.com/ViewPoem.aspx?id=176379",""],[6142,"كلما اغصوصبوا عليه دحاهم","https://www.poetsgate.com/ViewPoem.aspx?id=155706",""],[5309,"دنياك لهو والحياة زوال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573559",""]],"verses":[["يَقضي الحَريصُ وَلَيسَ يَقضي أُربَةً","مُتَعَلِّلاً أَبَداً بِغَيرِ تَعِلَّةِ",0,"ه",1,0],["يَقضي عَلَيَّ دَلالُهُ","في كُلِّ حينٍ أَو يَكادُ",1,"د",1,0],["يَقْضِي الرَّغَائِبَ بَاذِلاً","فِيهَا نَفَائِسَهُ الرِّغَابَا",2,"ب",2,0],["يَقضي هواه بما يَسُومك في الورى","خَسفاً وينقِم منك إن لم تقبلي",3,"ل",2,0],["يَقضي القَضاءَ الَّذي يُشفى النِفاقُ بِهِ","فَاِستَبشَرَ الناسُ بِالحَقِّ الَّذي عَرَفوا",4,"ف",3,0],["يَقضي الكِتابُ عَلى الصَليبِ وَتَغلِبٍ","وَلِكُلِّ مُنزَلِ آيَةٍ تَأويلُ",5,"ل",1,0],["يَقضِ زَورٌ هُنَاكَ حَقَّ مَزُورِي","نَ وَيَحبُ السَّلاَم أهلُ السَّلامِ",6,"م",1,0],["يقضون للملكِ النهار فإن دجى","مسا الليل باتوا سجَّداً وقياما",7,"م",2,0],["يقضي بسعدِ نجومها من لا درَى","فلكاً بلا حدس ولا تخمين",8,"ن",1,0],["يُقضِّي بها الشيخُ أوطارَهُ","برغم المعنِّفِ والساخِطِ",9,"ط",1,0],["يقضي له الدرهم حاجاته","والسيف يحميه من الحيف",10,"ف",1,0],["يَقضي لُبانَتَهُ بِاللَيلِ ثُمَّ إِذا","أَضحى تَيَمَّمَ حَزماً حَولَهُ جَرَدُ",11,"د",1,0],["يَقضي فَهَذا في السُجونِ مُغَيَّبٌ","رَهنٌ وَهَذا بِالحَديدِ مُكَبَّلُ",12,"ل",1,0],["يَقضي سُلَيمانُ المُبارَكُ حَقَّها","وَتَصونُ حُرمَتَها الرَضِيَّةُ زَينَبُ",13,"ب",1,0],["يقضي الحَيَاةَ طريداً","في ذِلَّةِ واعتزالِ",14,"ل",1,0],["يقضى لبانته منها الى اجل","وقد يكون قصيرا ذلك الاجل",15,"ل",1,0],["يقضى بها طرَفي يومه","ويمضى بها طرفي ليلته",16,"ت",2,0],["يُقَضّي يَومَهُ فيها","وَيَلقى اللَيلَ ما زارَه",17,"ر",2,0],["يَقضي عَلَيهِم في البَرِيَّةِ أَو لَهُم","وَيُديمُ حَمداً أَو يُؤَيِّدُ ذاما",18,"م",2,0],["يَقضونَ ذَلِكَ عَن سَوادٍ غافِلٍ","خُلِقَ السَوادُ مُضَلَّلاً وَمَسودا",19,"د",2,0],["يُقَضقِضُ عُصلا في أَسِرَّتِها الرَدى","كَقَضقَضَةِ المَقرورِ أَرعَدَهُ البَردُ",20,"د",1,0],["يَقضي الأُمورَ وَلَيسَ يُسمَعُ نَبسَةٌ","بِخِلالِ أَشوَسِ في المَحَلِّ الشاسي",21,"س",2,0],["يَقضي عَلينا الأَسى لَولا تَأَسّينا","حَمَدتُ أَيّامَ أُنسٍ لي بِكُم سَعِدَت",22,"ت",1,0],["يَقضونَ بِالأَمرِ عَنها وَهيَ غافِلَةٌ","ما دارَ في فُلُكٍ مِنها وَفي قُطُبِ",23,"ب",1,0],["يَقضي ويَحكمُ في الشُّعوبِ وخلفه","قاضٍ يَجورُ وحاكمٌ يَتَجبَّرُ",24,"ر",1,0],["يَقضِي على مِصرَ القضاءَ سَبيلُه","عَسْفٌ وملءُ كِتابهِ اسْتعبادُ",25,"د",1,0],["يَقضيهِ عنكَ وإن أربيتَ تجعلُهُ","ما تحملُ الأرضُ من إبْلٍ ومن ضَانِ",26,"ن",1,0],["يَقْضُونَ إنْ عَقَلوا قَضاءً صالحاً","هُوَ للنّفوسِ مُهذِّبٌ ومُقَوِّمُ",27,"م",1,0],["يُقْضّي بَقايا عَيْشِهِ وجَناحُهُ","حَثيثُ الدّواعي في الإقامةِ والظّعنِ",28,"ن",1,0],["يقضونَ باسمِ المال فيه كأنما","ضمِنُوا لمصرَ مصادرَ الإثراءِ",29,"ا",2,0],["يُقَضِّبُ عنه أمْرَاسَ المَنَايا","لِباسٌ مِثْلُ أغْراسِ النِّتاج",30,"ج",1,0],["يَقْضُونَ أَيَّامَهُمْ عَلَى خَطَرٍ","فَبِئْسَ عُقْبَى السِّياسَةِ الْخَطِرَهْ",31,"ر",2,0],["يَقْضِي حُقُوقاً لِلبِلاَدِ وَأَهْلِهَا","مِنْهَا وَلاَ يَقْضِي لُبَانَةَ عَالِقِ",32,"ق",1,0],["يقْضِي مُنَاهُ أَنَاقَةً فِي عيْشِهِ","وَيَفِيَ بِحَقِّ المَجْدِ أَيَّ وَفَاءِ",33,"ا",2,0],["يَقْضِي وَذلِكَ نَذْرُهُ فِي يَوْمِهِ","حَاجَاتِ سَائِلِهِ بِلاَ إِبْطَاءِ",34,"ا",2,0],["يَقْضِي سَوادَ الَّليلِ غَيْرَ مُوَسَّدٍ","عَيْنٌ مُسَهَّدَةٌ وقَلْبٌ ذاكِي",35,"ك",2,0],["يقضي لبُانته اليتيم ببابه","ويرى الفقير دعاءَهُ مقبولا",36,"ل",2,0],["يقضي بما يشاء والأسباب جامدة","ويحكم الأمر والأفكار عميان",37,"ن",1,0],["يُقِضُّ مضاجعَ الباغينَ منه","لكلِّ منامةٍ طيفٌ يطوف",38,"ف",1,0],["يقضون قسرا على ريب الزمان ولا","يقضى عليهم وان وفى وان قسطا",39,"ط",2,0],["يَقضي النَهار بِدَرس غَير مُندَرس","وَيَقطَع اللَيل تَسبيحاً وَقُرآنا",40,"ن",2,0],["يَقضي الدجا مُتَوحِشاً مُتَأسِفاً","مِن بَعد ذاكَ القُرب وَالإِيناس",41,"س",1,0],["يَقضي النَهار مُناغياً","ما سَوفَ يَصنَع في المَآل",42,"ل",1,0],["يقضى بما قد قضى النبي به","وعلمتنا اسراره الكتب",43,"ب",1,0],["يقضي بما شاء لا أخشى عواقبهُ","ولا يكدرني منه تكدرهُ",44,"ر",2,0],["يقضي حوائج سائليه فلا يرى","في نفسه سأماً ولا استكبار",45,"ر",1,0],["يقضي علينا بما يهوى ويُخصمنا","بأنه تابعٌ في ذاك قانونا",46,"ن",2,0],["يقضِى المتيَّم منهمُ","نحبا ولو رُدُّوا لعادوا",47,"د",3,0],["يقضي بيمنك دائماً منه على","يمناك ماضي الشفرتين يماني",48,"ن",2,0],["يَقضي وليس له سَمْعٌ ولاَ بَصرٌ","وتَرْتضيه الوَرَى عَدْلاً إذا اخْتَصَموا",49,"م",3,0],["يَقْضِي التَّحَرُّجُ في تَشْبيهِ سُحْمَتِهِ","تَنْزِيه أصْحَمَةٍ عَنْهَا ولُقْمَانَا",50,"ن",2,0],["يقضى عَلَى حقِنا بغياً وَليس لنا","علمٌ، لعمرك هذا الهُوْنُ والعار",51,"ر",1,0],["يَقضي النّهى وَالطبع أنّ لنوعنا","رِمماً عَلى الدقعاء منها أوسعُ",52,"ع",1,0],["يَقضي أُمورَ المُؤمِني","نَ بِرَأيِ حَزمٍ وَاِعتِزامِ",53,"م",1,0],["يَقضون كَالقَدر المُتاح عَلى الوَرى","فَالأَمر يُعطى وَالإِرادة تسلبُ",54,"ب",1,0],["يَقْضى على كرمِ العناصرِ منكَ أنْ","تُهْدِي بلا سَعْيٍ إلى جَناحا",55,"ح",2,0],["يَقضي حُقوقَ لَياليهِ الَّتي وَجَبَت","فَكَم قَضَينَ لَنا حَقّاً وَلَم يَجِبِ",56,"ب",1,0],["يقضي بفحص ضميره أيامَه","متطهراً بالإعتراف الأعظم",57,"م",1,0],["يقضون أيامهم في حرث خدمتها","والأرض تنمي ثمار البر بالحرث",58,"ث",1,0],["يَقضي عَلَيَّ تَعَسُفا","حكَمٌ أَبي أَن يَنصفا",59,"ف",2,1],["يَقضي عَلَيَّ بِنَظرة وَبِمثِلِها","يَهِب الحَياة بِتيهِهِ وَبِلُطفِهِ",60,"ف",2,0],["يَقضي عَليَّ بِسحر مُقلَتِهِ","أَبَداً وَيَحييني وَلا أَدري",61,"ر",2,0],["يقضي ساعات النهار عبادة","ودرساً وتدريساً إلى أن قضى العمر",62,"ر",1,0],["يَقضي بِحُكمِ الهُدى في المُشكِلاتِ كَما","يَقضي بِحُكمِ الظُبيِ في ساعَةِ الوَهلِ",63,"ل",1,0],["يقضِي بتشتِيتِي وإر","جاءِ اللّقاءِ