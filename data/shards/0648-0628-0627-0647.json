{"poems":[[73,"أشكو إلى الله حماتي فما","https://www.aldiwan.net/poem3921.html","السريع"],[84,"وباهر التصنيف مستغرب","https://www.aldiwan.net/poem29407.html","السريع"],[50,"على دمنة الدار لا تربع","https://www.aldiwan.net/poem66620.html","المتقارب"],[147,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[164,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[164,"على الطالع الميمون أسست يا قصر","https://www.aldiwan.net/poem59089.html","الطويل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[264,"بمحمد وببنته وببعلها","https://www.aldiwan.net/poem35542.html","الكامل"],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[264,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[291,"أحارث بن عمر وقد وليت ولاية","https://www.aldiwan.net/poem34052.html","الطويل"],[310,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[369,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[422,"قد نحرنا الزق يوم العيد نحرا","https://www.aldiwan.net/poem53935.html","الطويل"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[466,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[563,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66820","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38981","المتدارك"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56212","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55928","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55985","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112859","المتدارك"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49999","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77883","الكامل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101706","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60852","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137404",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93783","الكامل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11286","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88968","الطويل"],[3631,"","https://poetry.dctabudhabi.ae/diwan/poem/144739","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132098","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69910","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45024","الوافر"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101309","الوافر"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204256","السريع"],[4755,"هذي البلادُ كَثِيرَةُ العِلَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=183695",""],[4767,"نبأ الفرحة","https://www.poetsgate.com/ViewPoem.aspx?id=180784",""],[4926,"بمحمَّدٍ وببنته وببعلها","https://www.poetsgate.com/ViewPoem.aspx?id=171100",""],[5056,"<< صدح البلبلُ..>>","https://www.poetsgate.com/ViewPoem.aspx?id=34078",""],[6259,"أتانيَ عن تاج الزمان تعتُّب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59374&r=&rc=22",""]],"verses":[["وَباهِتيهِ إِن رَأى ريبَةً","وَابكي وَسُبّيهِ وَسُبّي أَباه",0,"ا",2,0],["وباهر التصنيف مستغرب","يعجب من غريب تصنيفه",1,"ه",1,1],["وباهِت له الخصمَ حتّى يقولَ","قاضيكَ يا صدقً ذا المدعي",2,"ع",2,0],["وَبِأَهلِها عَطَشٌ إِلَيكَ وَكُلُّهُم","كَالنَبتِ نَكَّبَهُ السَحابُ المُرزِمُ",3,"م",1,0],["وبأهلها من فرد وجد ما بها","فلهم عيون بعدكم لا تنظر",4,"ر",1,0],["وباهت بك الأرض السماء وفاخرت","فكان لمن أصبحت من حزبه الفخر",5,"ر",1,0],["وَبِأهلِ العباءِ أنت عليٌّ","حَسنٌ والحسين والزهراءُ",6,"ا",2,0],["وَبِأهلِ التوحيدِ من أهلِ قربا","كَ وَبالشركِ تبعد القرباءُ",6,"ا",2,0],["وَبِأهلِ الحديثِ مَن بلّغوه","وِلنعمَ الأئمّة الفقهاءُ",6,"ا",2,0],["وبأهل بدرٍ والصحابة كلّهم","من قاتلوا فيك العشيرة والعدا",7,"د",2,0],["وبأهل الحقّ وحُجّتهم","وبأهل الصدق وبُلجتهم",8,"م",1,0],["وبأهل الذكر ولهجتهم","وبأهل الحيّ وبهجتهم",8,"م",1,0],["وبأهل الجذب وأهل القر","ب وأهل الحبّ المنتهج",9,"ج",1,0],["وَبَاهَ تَمِيماً بِالْغِنَى إِنَّ لِلْغِنى","لِسَاناً بِهِ المَرْءُ الهَيُوبَةَ يَنْطِقُ",10,"ق",1,0],["وَبأهلهِ أهلينَ أَصفى خلّةً","وَبِبيتهِ بيتاً أمدّ فليجه",11,"ج",2,0],["وباهَى طَلْعةَ السَّعْدَيْنِ منه","بسَعْدٍ ما لَهُ في النّاسِ ثان",12,"ن",1,0],["وبأهلي ذلك الظبي وإن","أوْسَعَ المغرم إعراضاً وهجرا",13,"ر",2,0],["وباهلتَ بالأرض فيها السما","ءَ فاعترفت خجلاً وانحصارا",14,"ر",2,0],["وباهر فضلٍ لا يُظاهرُ مجْدهُ","شَبا مُرْهفٍ لا نزْقةُ الأدباءِ",15,"ا",2,0],["وبأهل البيت بأجمعهم","أرباب السبق لدى الدلج",16,"ج",1,0],["وبأهلي وبمالي","وبَناتي والبَنينا",17,"ن",2,0],["وَبِأَهلِ حُنين وَالشّجرهْ","وَذَوي بَدرٍ وَأولي أُحُدِ",18,"د",1,0],["وباهت به إذ أرضعته حليمة","لذلك عزت بين كل المراضع",19,"ع",1,0],["وباهى به في سطوةٍ منه أرعدت","مسامع أعراب الورى والأعاجمِ",20,"م",1,0],["وباهى في كمال الحسن لما","توّلى ضبطه نصحاً وصدقا",21,"ق",2,0],["وباهيت يا حلو المعاني مفاخراً","على كل أهل العصر باللطف والظرفِ",22,"ف",1,0],["وبأهل البيت جميعهم","أصحاب النجدة والبلج",23,"ج",1,0],["وباهِ بها عند الملوك فإنّني","أُباهي بمدحي فيك إِذ أناأصدُقُ",24,"ق",1,0],["وَبأهل دار الخلد ما سيماكم","قالوا التقى وَالعدل والإِنصاف",25,"ف",1,0],["وباهت به فيمن تباهى مدارس","له بالندى والجود فيها مغارس",26,"س",1,0],["وبأهل حَلْي رُعدةٌ من خوفه","والبِرْك لو سمع المصفق هَرْولاَ",27,"ل",2,0],["وباهت بك الشمس افتخارا وعزة","ومثلك من يحلو بعليائه الفخر",28,"ر",1,0],["وبأهل بيتك كلهم","الطيبين الطاهرين",29,"ن",1,0],["وَباهِلِيٍّ مِن بَني وائِلٍ","أَفادَ مالاً بَعدَ إِفلاسِ",30,"س",1,1],["وباهرت الأرض السماء بنوره","قدوم سعودٍ في دوام صعود",31,"د",1,0],["وَبأَهلي بُدّلْتُ لَخْمَا وعكا","وجُذَاماً وأَيْن مِنّي جُذَام",32,"م",1,0],["وبأهله الغرّان أين ترحلوا","خواض مهلكة ليوث صعابَ",33,"ب",1,0],["وَباهتمامٍ وَتَوفيقٍ يقارنهُ","مهدتَ للعلم مَهداً باتَ مَهجورا",34,"ر",2,0],["وَباهى باليَراعِ حَديدَ عَضبٍ","وَصَمصام وَهندي حُسام",35,"م",1,0],["وباهى عنبراً لما تبدى","كمسك فوق كافور نقي",36,"ي",1,0],["وباه بالمنظر بدر الدجى","وأفْضُلْه في بهجته وازدد",37,"د",1,0],["وبأَهلِهَا المُتَصَارِعِينَ عَلَى","وَهْمِ الغِنَى مِن ثَروَةِ الطَّلَلِ",38,"ل",1,0],["وبأهل البيت طراً فبِهم","ما دَعا الداعي دُعَا إلا ارتفع",39,"ع",1,0],["وبأهل بدرٍ والصَّحابة كلَّهم","والتّابعين وتابعيهم سرمدا",40,"د",2,0],["وبآهٍ تلو آهٍ نددا","آه لو يوقظُ فينا ما شدا",41,"د",2,0],["وباهوا به عارية ً لا تملكاً","فإن شئتَ ردّوا ما استعاروا من الدّر",42,"ر",1,0]]}