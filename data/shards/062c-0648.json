iwan.net/poem63943.html","الرجز"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[50,"نور عيني تركت قلبي جناحا","https://www.aldiwan.net/poem63972.html","الخفيف"],[7,"كليني لهم يا أميمة ناصب","https://www.aldiwan.net/poem2017.html","الطويل"],[46,"جوارك هذا العالم اليوم نكبة","https://www.aldiwan.net/poem22608.html","الطويل"],[46,"صنعة عزت الأنام بلطف","https://www.aldiwan.net/poem22771.html","الخفيف"],[46,"لا أسأل المرء قرضا من شهادته","https://www.aldiwan.net/poem22890.html","البسيط"],[46,"إذا داع دعاك لرشد أمر","https://www.aldiwan.net/poem22945.html","الوافر"],[46,"لعمرك ما آسى إذا ما تحملت","https://www.aldiwan.net/poem22950.html","الطويل"],[46,"أوالي هذا المصر في زي واحد","https://www.aldiwan.net/poem23213.html","الطويل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[15,"سقى الرباب مجلجل الأكناف","https://www.aldiwan.net/poem45260.html","مجزوء الكامل"],[15,"نأتك سليمى فالفؤاد قريح","https://www.aldiwan.net/poem45279.html","الطويل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[76,"يا رب صوت يصوغه عصب","https://www.aldiwan.net/poem38999.html","المنسرح"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/70278","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85405","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140867",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140944",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/141830","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202541","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30509","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42491","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55028","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54880","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55210","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67302","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141990","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43836","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43634","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[22,"لمن الدّيارُ كأنَّهنَّ سطور","https://www.poetsgate.com/ViewPoem.aspx?id=19748",""],[50,"نورُ عيني تركت قلبي جناحا","https://www.poetsgate.com/ViewPoem.aspx?id=21644",""],[58,"ألا طرق الناعي بليلٍ فراعني","https://www.poetsgate.com/ViewPoem.aspx?id=22744",""],[45,"عَذِيريَ منْ وَاشٍ بهَا لَمْ أُوَالهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31868",""],[45,"وعالمة وقد جهلت دوائي","https://www.poetsgate.com/ViewPoem.aspx?id=32838",""],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[78,"جَوهَرُ، قد عذّبَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86473&r=&rc=18",""],[105,"أترى الكنانة كيف تعبث بالدم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54977&r=&rc=147",""],[99,"في المقهى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=338&r=&rc=45",""],[31,"يا برقُ، أبرقَ من قري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18925&r=&rc=188",""]],"verses":[["جونُ الذُرى أَقوَدُ مُرجَحَنِّ","أَنفُضُ عَنهُ نَقعَهُ بِرَدني",0,"ي",1,0],["جَوادٌ تُرعَدُ الأَبصارُ فيهِ","إِذا هَزَأَت بِرِجلَيهِ اليَدانِ",1,"ن",1,0],["جَوائِفُ تَبقى أَخاديدُها","عِماقاً وَتَعفو نُدوبُ الطَعانِ",2,"ن",1,0],["جَوائِفٌ مِن جِراحِ الدَهرِ بالِغَةٌ","إِلى القُلوبِ وَلا يَجري لَهُنَّ دَمُ",3,"م",1,0],["جِوارُهُم مِثلُ نَسيمِ الصَبا","وَغَيبُهُم مِثلُ أَجيجِ الضِرام",4,"م",1,0],["جَوامِحاً في العارِ لا","بُقيا وَلا رَعيَ ذِمَم",5,"م",1,0],["جَوانِبُ أَنباءٍ وَدَدتُ بِأَنَّني","صَمَمتُ لَها ما أَورَقَ العودُ مَسمَعا",6,"ع",2,0],["جَوَدٌ أَنتَ راكِبُهُ","وَسَيفٌ أَنتَ شاهِرُهُ",7,"ر",2,0],["جَوادٌ جَرى حَتّى اِستَبَدَّ بِغايَةٍ","تُقَطِّعُ أَنفاسَ الجِيادِ مِنَ الجَهدِ",8,"د",1,0],["جَوادٌ إِذا ما مَزَّقَ الذَودَ عَضبُهُ","أَذاعَ النَدى مِن جُردِهِ بَعدَ نَيبِهِ",9,"ب",2,0],["جودٌ ضَعيفٌ إِن تُلِمَّ مُلِمَّه","لِمُؤَمَّلٍ وَأَذىً أَلَدُّ مُشاغِبُ",10,"ب",1,0],["جَوانحُ لِلغَرامِ بِها وُشومُ","وَأَجفانٌ عَلى أَرَقٍ تَحومُ",11,"م",1,1],["جَوادٌ إِذا شَقَّ المَحافِلَ صَدرُهُ","يَروحُ إِلى ظُعنِ القَبائِلِ أَو يَغدو",12,"د",2,0],["جَواهِرُهُ النُجومُ وَفيهِ بَدرٌ","أَقَلُّ صِفاتِ صورَتِهِ التَمامُ",13,"م",1,0],["جَوادي نِسبَتي وَأَبي وَأُمّي","حُسامي وَالسِنانُ إِذا اِنتَسَبنا",14,"ن",2,0],["جَوابي إليْكَ قُدومِي عليْكَ","فقدْ ضِقْتُ ذرْعاً بِطولِ النّوَى",15,"و",2,1],["جَوْفَاءُ يَحْمِلُهَا وَمَنْ حَمَلَتْ بِهِ","مَنْ يَعْلَمُ الأَنْثَى وَمَا هِيَ تَحْمِلُ",16,"ل",1,0],["جَوَارٍ غَذَاهَا الْغَزْوُ دَرَّ لِبَانِهِ","وَحَجَّبهَا الإسْلاَمُ تَحْتَ حِجَالِهِ",17,"ل",2,0],["جَوَانِحنَا نَحْوَ اللِّقَاءِ جَوَانِحٌ","وَمِقْدَارُ مَا بَيْنَ الدَّيَارِ قَرِيبُ",18,"ب",1,1],["جَوانِحٌ كَالأَفاني في أَفاحِصِها","يَنظُرنَ خَلفَ رَوايا تَستَقي نُطَفا",19,"ف",2,0],["جُوعُ الخَليفَةِ والدُّنيا بقَبضَتِه","في الزُّهدِ مَنزِلَةٌ سبحانَ مُوَليها",20,"ي",3,0],["جَوادٌ وَكَفُّ السُحبِ بِالغَيثِ باخِلٌ","وَقورٌ إِذا خَفَّت جِبالُ حُنَينِ",21,"ن",1,0],["جَوادٌ مَتى اِستَعجَلتَ أولى هِباتِهِ","كَفاكَ مِنَ البَحرِ الخِضَمِّ عُبابُ",22,"ب",1,0],["جَوادٌ إِذا استَنَّ الجِيادُ إِلى مَدىً","تَمَطَّرَ فَاستَولى عَلى أَمَدِ الخَصلِ",23,"ل",1,0],["جَوادٌ ذَراهُ مَطافُ العُفاةِ","وَيُمناهُ رُكنُ النَدى المُستَلَم",24,"م",1,0],["جوانح لا تنطفي","وأدمع تطرد",25,"د",1,0],["جَوادٌ سابِقٌ في اليُسرِ بَحرٌ","وَفي العِلّاتِ وَهّابٌ بَذولُ",26,"ل",1,0],["جَوّابُ أَودِيَةٍ حَمّالُ أَلوِيَةٍ","سَمحُ اليَدَينِ جَوادٌ غَيرُ مِقتارِ",27,"ر",1,0],["جُودُهُ شَافٍ أَعَادَ بِهِ","مَجْدَ مِصْرٍ عَاليَ الكَعْبِ",28,"ب",1,0],["جورجيت هل وصف يصورها","ماذا يصور واصف البدر",29,"ر",1,0],["جودت ما جودت تنسيقها","على المثال الأبهج الأجمل",30,"ل",1,0],["جوادٌ شَاخَ فِي طَلَبِ المَعَالِي","وَلَكِنْ مُهْراً فِي عُيُونِي",31,"ي",1,0],["جودُهَا الشَّامِلُ كَمْ فِيهِ أساً","لِجَرِيحٍ وَسُرُورٌ لِحَزِينْ",32,"ن",1,0],["جَواعِلُ أَيَّامِ الَّذِي هنَّ لَيْلهُ","نَهَاراً طَوِيلاً لا يُرَى مُتَقَسِّمَا",33,"م",2,0],["جُودٌ يَصِحُّ الوَصْفُ فِي تَشْبِيهِهِ","بِالمِّبلِ أَوْ بِالعَارِضِ السَّجَّامِ",34,"م",1,0],["جُودِي عَلَينا اليَومَ أو بَيِّني","فِيمَ قَتَلتِ الرَّجُلَ المُسلِما",35,"م",2,0],["جَواداً تُريهِ الجودَ نَفسٌ كَريمَةٌ","وَعِرضٌ عَنِ التَبخيلِ وَالذَمِّ وافِرُ",36,"ر",1,0],["جودُ مولانا ابنِ نصرٍ","قد حباني بالكمالِ",37,"ل",1,0],["جوهرة يفرح الكرام بها","وغصّة لا تسيغها السفله",38,"ل",2,0],["جَور العدى أزرى بغضّ جمالها","فذوى وما أزرى بعزّ جلالها",39,"ل",3,0],["جودوا عليها بما دَرَّت مكاسِبُكم","وقابلوا باحتقار كل من بَخِلا",40,"ل",2,0],["جواد إذا استمطرته جاد كفّه","بأغزر من وبل الغيوم الدوافق",41,"ق",1,0],["جوفَ الحَناجِرِ وَالأَجوافِ ما صَدَرَت","عَن مَعطِنِ الماءِ إِلّا حَوضُها رَشَفُ",42,"ف",1,0],["جوفٌ مَجارِفُ لِلخَزيرِ وَقَد أَوى","سَلَبُ الزُبَيرِ إِلى بَني الذَيّالِ",43,"ل",1,0],["جَونٍ بِصارَةَ أَقفَرَت لِمَرادِهِ","وَخَلا لَهُ السُؤبانُ فَالبُرعومُ",44,"م",1,0],["جَونٍ تَرَبَّعَ في خَلى وَسمِيَّةٍ","رَشَفَ المَناهِلَ لَيسَ بِالمَظلومِ",45,"م",1,0],["جَوّابُ مَرتٍ مُقفِرٍ سَمالِقُه","خَرقٌ لِهَزِّ اليَعمَلاتِ خارِقُه",46,"ق",2,0],["جودي فَإِنَّ الجودَ مَكرُمَةٌ","وَاِجزي الحُسامَ بِبَعضِ ما يَفري",47,"ر",2,0],["جَوادٍ عَلى العِلّاتِ رَحبٍ فَناؤُهُ","مَتى يُسأَلِ المَعروفَ لا يَتَجَهَّمِ",48,"م",1,0],["جوار قومٍ بنورِهم فرِجت","عنِّي وعن كلِّ وافدٍ كربَه",49,"ب",2,0],["جوانح ينمو شجوها وسقامها","عليَّ ودوني جندل وصفائح",50,"ح",1,0],["جواهراً لا يحد الوصف غايتها","فاعجب لجوهرِ شيءٍ غير محدود",51,"د",1,0],["جوادي من الكاسات في حلبة الهنا","كميتٌ وإلاّ من صدور المها نهد",52,"د",1,0],["جواداً أتينا طالباً بعد طالب","فهذا اجْتذى منه وهذا به اقْتدى",53,"د",2,0],["جواري الأفقِ تخدم زائريه","بتوفيقٍ وتتبعهم سعاده",54,"د",2,0],["جوزيت عني بالثناء كما جزى","نفس الرياض ندى الغمام الباكر",55,"ر",1,0],["جوارحي وكتابي قد نهبتهما","ففي يديك على الحالين مجموعي",56,"ي",1,0],["جوابٌ أتانيَ في ساعة","يدلّ على نفث أصل اليراعه",57,"ه",1,1],["جودك المجتدى وأمداحكَ الغ","رّ كنوزٌ تبقى على الإنفاق",58,"ق",1,0],["جوهر ما علمت إلاَّ","دموع عينيَ لها عقيقه",59,"ه",1,0],["جوداً وبأساً كأنَّ الأرض بينهما","لم تبد عشباً سوَى الأقلام والأسل",60,"ل",1,0],["جود به أنسى أحاديثَ المطر","فليسَ يحتاج لها إلى خبر",61,"ر",1,0],["جُوسُوا عليه الأرضَ واستَخْبروا","حتى يروحَ الخبرُ العازبُ",62,"ب",1,0],["جوادٍ بالتلاد وللمعالي","كسوبٍ أو يزيد على الكسوبِ",63,"ب",1,0],["جُودُ أيديكُمُ أحدُّ من النهْ","ب وأمضى إن فكَّر المبهوتُ",64,"ت",1,0],["جوادٌ يرى تطهير عرضٍ وملبسٍ","وتدنيس طَبَّاخ وتسويد مَطْبَخِ",65,"خ",1,0],["جَوادٌ ثَنَى غَرْبَ الجِياد بغَرْبِه","وظَلَّ يُجَاري ظلَّهُ وهو أوْحدُ",66,"د",1,0],["جوَّدْتُ فيكم كما أجْوَدْتُ أيدِيَكُمْ","ما حَمْدُ مُتْبِعِ أَجْوادٍ بِتَجوِيدِ",67,"د",1,0],["جودٌ كجود السيل إلا أن ذا","كَدِرٌ وأن نداك غير مكدّر",68,"ر",1,0],["جوادٌ إذا سامَ المكارمَ نفسه","فليس له منها شريكٌ مشاكس",69,"س",1,0],["جواد ينادي الهاربين عطاؤهُ","إلى أين مني لات حين مناص",70,"ص",1,0],["جواد غدا كل ذي خلة","بما ضر ثروته منتفع",71,"ع",1,0],["جود يزيد الله صاحبه","وثوابه المذخور لا السمعه",72,"ع",2,0],["جواد به من أريحيَّة جوده","تباريح يعجلن اختيار الصنائع",73,"ع",1,0],["جوادٌ رأى مَنحاً فلم ترَ ما يرى","وما زلتَ مذؤوماً ذَميمَ فَعالِ",74,"ل",1,0],["جواد ثنى غرْبَ الجيادِ بغربه","فظلَّ يجاري ظلّها وهْيَ صُيَّمُ",75,"م",1,0],["جودُ البحارِ وأحلامُ الجبل لهم","وهُمْ لدى الرَّوعِ آسادٌ وجِنّان",76,"ن",1,0],["جودٌ دِيانيٌّ له فضلةٌ","يأمن خُسران موازينه",77,"ن",2,0],["جودا فَوَاللَهِ لا أَنهاكُما أَبَداً","وَزالَ عِندي لَهُ ذِكرٌ وَتَبجيحُ",78,"ح",1,0],["جَوارِسُها تَأرِيِ الشُعوفَ دَوائِباً","وَتَنقَضُّ أَلهاباً مَصيفاً شِعابُها",79,"ب",3,0],["جَوادٌ إِذا ما أَمحَلَ الناسُ مُمرِعٌ","كَريمٌ لِجَوعاتِ الشِتاءِ قَتولُها",80,"ل",3,0],["جُؤذَرٌ لَكِنَّها آنِسَةٌ","لَم يَرُعها ما يَروعُ الجُؤذَرا",81,"ر",2,0],["جوداً فَغَيرُ الحَمدِ غَيرُ مُخَلَّدٍ","ما المالُ إِنَّ المالَ طَيفُ خَيالِ",82,"ل",1,0],["جَوادٌ مَتى تَحلُل بِواديهِ تَلقَهُ","كَما قيلَ في آلِ الجَوادِ المُهَلَّبِ",83,"ب",1,0],["جَواعِلُ أَرماماً يَميناً وَصارَةً","شِمالاً وَقَطَّعنَ الوِهاطَ الدَوافِعا",84,"ع",2,0],["جَوامِعَ أُنسٍ في حَياءٍ وَعِفَّةٍ","يَصِدنَ الفَتى وَالأَشمَطَ المُتَناهِيا",85,"ي",2,0],["جَوهَرَةٌ عذّبَني","مِنكِ تَمَادي الغَضَبْ",86,"ب",1,1],["جَوادٌ أَتاني مِن جَوادٍ تَطابَقا","فَيا كَرَمَ المُهدي وَيا كَرَمَ المُهدَى",87,"د",2,0],["جوابة الآفاق يطوي الارض","من غير تعب",88,"ب",1,0],["جو السياسة مكفهر","ما فيه من لون يسر",89,"ر",1,1],["جود الرجال بمالهم عظم لهم","والجود بالنفس العزيزة اعظم",90,"م",1,0],["جِوارُهُ أَمانُ","وَسِرُّهُ كِتمانُ",91,"ن",1,0],["جومِلَ الأَحياءُ فيهِ وَقَضى","شَهَواتَ أَهلِهِ وَالأَصدِقاء",92,"ا",2,0],["جو