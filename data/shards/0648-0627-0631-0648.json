05,"أنشودة النصر","https://www.poetsgate.com/ViewPoem.aspx?id=161162",""],[5704,"شوقي الى المختار","https://www.poetsgate.com/ViewPoem.aspx?id=194470",""],[5756,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=5431",""],[5762,"الذبيح الصاعد","https://www.poetsgate.com/ViewPoem.aspx?id=13136",""],[5781,"صمتُكَ الغائِرِ كالجُرْح","https://www.poetsgate.com/ViewPoem.aspx?id=202857",""],[5790,"بأبي وبي طيفٌ طرق","https://www.poetsgate.com/ViewPoem.aspx?id=111872",""],[5809,"النسيب","https://www.poetsgate.com/ViewPoem.aspx?id=205307",""],[5819,"بنت صور","https://www.poetsgate.com/ViewPoem.aspx?id=215659",""],[5829,"الى وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=153240",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[5908,"تعرفت منهم بالغربين أربعا","https://www.poetsgate.com/ViewPoem.aspx?id=170975",""],[5939,"أنت كلّي","https://www.poetsgate.com/ViewPoem.aspx?id=178585",""],[5950,"المشهد الأخير ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128146",""],[5956,"جواسيسُ عربٌ ضدُّ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=202496",""],[5977,"سلام على تلك القبور وأهلها","https://www.poetsgate.com/ViewPoem.aspx?id=214339",""],[6019,"عِناقُ مودَّةٍ ل( نجران)","https://www.poetsgate.com/ViewPoem.aspx?id=211669",""],[6120,"أَتُرِيدُنِي أَنْ أَعْتَرِفْ","https://www.poetsgate.com/ViewPoem.aspx?id=213513",""],[6128,"عزيزي","https://www.poetsgate.com/ViewPoem.aspx?id=212860",""],[520,"من استعان بغير الله لم يعن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577661",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""],[463,"دعوها تردْ بعد خمسٍ شروعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60135&r=&rc=191",""],[6248,"تراتيل العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86018&r=&rc=4",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[2220,"ألا انعم صباحا أيها الوارد الذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11564&r=&rc=438",""],[147,"شفاءُ الهدى ياسيفهُ العضبَ أنْ تشفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27434&r=&rc=1",""]],"verses":[["وأروع خواض لكل مهولة","ونساك محراب تواراه عابد",0,"د",1,0],["وَأَروحُ قائِدَ فِتيَةٍ","سودِ الغَدائِرِ وَالجُمامِ",1,"م",1,0],["وَأَرومُ مِن غُلَواءِ عِزِّكَ غايَةً","قَعساءَ تَستَلِبُ النَواظِرَ مِن عَلِ",2,"ل",1,0],["وَأَروحُ في ظَفَرِ القَوِيَّ","وَقَدِ اِنتَصَفتُ مِنَ الفِراقِ",3,"ق",1,0],["وَأَروحُ أَذكَرَ ما أَكونُ لِعَهدِهِ","فَكَأَنَّني اِستَودَعتُهُ الأَحشاءَ",4,"ا",2,0],["وَأرْوَعَ تَحْتَ أَخْمَصِهِ الثُّرَيَّا","وَفَوْقَ جَبينِهِ خَرَزاتُ تاجِ",5,"ج",1,0],["وأرْوَعُ وافي اللُّبِّ والسِّلْمِ جامعٌ","وفي الحَرْبِ إن حكَّتْ بهِ بَرْكَها غَمْرُ",6,"ر",1,0],["وَأَرواحُنا بِاللَيلِ في الحَيِّ تَلتَقي","وَنَعلَمُ أَنّا بِالنَهارِ نَقيلُ",7,"ل",1,0],["وَأَروَعُ لا الباغي أَخاهُ مُبَلَّغٌ","مُناهُ وَلا الراجي نَداهُ مُسَوَّفُ",8,"ف",1,0],["وَأَروَعُ لامُعتَفي رِفدِهِ","يَخيبُ وَلا جارُهُ يُهتَضَم",9,"م",1,0],["وَأَروَثنَهُ نَأياً فَأَضحى كَأَنَّهُ","مُخالِطُهُ يَومَ السُرَيرِ جُنونُ",10,"ن",1,0],["وَأَروَعَ مِهيامِ السُرى كُلَّ لَيلَةٍ","بِذِكرِ الغَواني في الغِناءِ المُواصِلِ",11,"ل",1,0],["وَأَرواح خَرق نازِح جَزَعَت بِنا","زَهاليلُ تَرمي غَولَ كُلِّ نِجادِ",12,"د",1,0],["وَأَروَعَ جَيشُهُ لَيلٌ بَهيمٌ","وَغُرَّتُهُ عَمودٌ مِن صَباحِ",13,"ح",1,0],["وأروع يهتزّ الزمان لأمره","وما الطود أرسى جانباً من سكونه",14,"ن",2,0],["وأروع أخبى للأئمة منصباً","يرقّ ويزهى حين يبكي الجديدان",15,"ن",1,0],["واروعتا لصباحٍ عند رؤيته","أظنُّ أنَّ صباح الحشر ثانيه",16,"ي",2,0],["وأرْوى غُلَّتي لو كنتُ أروى","بما تُروَى به الهِيمُ العِطاش",17,"ش",1,0],["وَأَروحُ في ظِلِّ الشَبابِ وَأَغتَدي","جَذلانَ لا أَشكو وَلا أَتَعَلَّلُ",18,"ل",1,0],["واروا الذين يرون فيكم","خصلة العجز اقتدارا",19,"ر",2,0],["وأروعَ وقّادِ الجبينِ كأنّما","جَرى فوق خدَّيْهِ النُضَارُ المشعشَعُ",20,"ع",1,0],["وأروعُ قُرْحَانٌ من الحُبِّ أمرُهُ","عليَّ إِذا لم يُومِ بالصبرِ جائزُ",21,"ز",1,0],["وَأَرومَةٍ في المُلكِ خاقانِيَّةٍ","تَعتَمُّ أَفناناً وَتَكرُمُ عُنصُرا",22,"ر",2,0],["وأرواحنا ثَمَرَاتٌ له","يَمُدّ إليها يداً جانيَه",23,"ي",2,0],["وَأرَوْكَ أنّ من المياه مَناصِلاً","طُبِعَتْ مضاربها من النيرانِ",24,"ن",1,0],["وأروحُ عن وطني إذا دَمِيَتْ","بعدي مدامعُ دُمْيَةِ الكِلَلِ",25,"ل",1,0],["وأُروّي غُلَلَ الشّوقِ بما","لم يكُنْ في قُدْرَةِ الماءِ القَراح",26,"ح",1,0],["وَأَروَعَ لا يُلقي المَقالِدَ لِاِمرِئٍ","فَكُلُّ اِمرِئٍ يُلقي لَهُ بِالمَقالِدِ",27,"د",1,0],["وَأَروَعَ أَمجَدَ قَرَّظَتهُ","وَبيضُ اللَآلي لِبيضِ النُحورِ",28,"ر",1,1],["وَأَروَعَ يَندى لِلطَلاقَةِ صَفحَةً","وَيَقدَحُ زَنداً لِلنَباهَةِ وارِيا",29,"ي",2,0],["وأَرُوهُ السُّبْلَ ناراً ودماً","مَن يَهَبْ فيها المنايا يُصعَقِ",30,"ق",1,0],["وأرومُ سِنَّكِ ضاحكاً","حتَّى يلوحَ وأرْقُبَه",31,"ب",2,0],["وَأرَوْنا أهلَ التُّقَى في الزَّوايا","سَلَّمُوا في البَقا لأَهْلِ القُصُورِ",32,"ر",1,0],["وأروحُ من طرادِ الخيل ركضاً","طرادُكَ كل مياسٍ لبيقِ",33,"ق",1,0],["وَأَرواحُنا كَالراحِ إِن طالَ حَبسُها","فَلا بُدَّ يَوماً أَن تَكونَ سِباءُ",34,"ب",3,0],["وَأَرواحٌ سَوالِكُ في جُسومٍ","يُهَنَّ بِأَن يُرَينَ مُجَسَّماتِ",35,"ت",1,0],["واروهُ مِن قَبلِ الفَسادِ فَإِنَّهُ","جِسمٌ إِذا فُقِدَت حَرارَتُهُ فَسَد",36,"د",1,0],["وَأَروَحُ الرِزقِ ما وافاكَ في دِعَةٍ","حِلّاً وَقُسِّمَ في أَيّامِهِ بُلَغا",37,"غ",2,0],["وَأَروَحُ مِن عَينٍ يَظَلُّ اِنتِسابُها","إِلى الإِنسِ وَحشٌ بِالمَهامِهِ عينُ",38,"ن",1,0],["وَأَروَحُ مِنهُما حادي ثَلاثٍ","يَسوقَهُنَّ أَو حادي ثَمانِ",39,"ن",1,0],["وَأَروَعُ نَبّاضٌ أَحَذُّ مُلَملَمٌ","كَمِرداةِ صَخرٍ في صَفيحٍ مُصَمَّدِ",40,"د",1,0],["وأَروم إيضاحاً لما قد أَبهمت","فَتَزيد إِبهاما على إِبهام",41,"م",1,0],["وأرواحاً عليكِ محوِّماتٍ","لها فوق الضِّفافِ خُطىً ووثبُ",42,"ب",1,0],["وَارْوِ غُلَّتِي","بِابْنَةِ الْفَرَحْ",43,"ح",1,0],["وأرْوَعُ ما تهفو له العينُ رايةٌ","تُداعبها الأرواحُ في كَفِّ غَالبِ",44,"ب",1,0],["وأروى من النيل للظامئينَ","وأخلدُ من لَبناتِ الهرم",45,"م",1,0],["وارو، يا يرموكُ، ماذا صَنَعتْ","برءوس الرومِ أَسيافُ الكماه؟",46,"ا",2,0],["وأروث حق النصر لا عن كلالة","وللسبط في المشروع أن يرث الجدا",47,"د",2,0],["وأروع نباضٌ أحد ململمٌ","كمرداة صخرٍ في صفيحٍ مصمد",48,"د",1,0],["واروي اسانيد المحبة طاهرا","وخلفي كلاب الحقد بالسوء تجهر",49,"ر",1,0],["وأروح أجني الشوك غير مقلم","ولكم قطفت جنى الغصون الميد",50,"د",1,0],["وارْو عن عامرٍ وأخلاقهِ الحسنى","وحدّثْ عن جُودِه وسَخَائِه",51,"ا",3,0],["وَأَروَعَ لِلعافينَ في حُجُراتِهِ","مَواهِبُ تَتلوها وَتَترى مَواهِبُ",52,"ب",1,0],["وَأَروَعَ تُصبيهِ المَكارِمُ وَالعُلى","إِذا غَيرُهُ أَصبَتهُ زَينَبُ أَو هِندُ",53,"د",1,0],["وَأَروَعَ لا يَقضي عَلى الجودِ لِلغِنى","وَلَكِنَّهُ يَقضي عَلى الوَفرِ لِلوَفدِ",54,"د",1,0],["وَأَروَعَ عَفّى في التَجاوُزِ وَالتُقى","عَلى مَن عَفا بَعدَ اِقتِدارٍ وَمَن عَفّا",55,"ف",2,0],["وَأَروَعُ إِن أَمَّ العُفاةُ فِناءَهُ","أَزالَ عَسى مِن قَولِهِ وَلَعَلَّما",56,"م",2,0],["وأرواحٌ على الأرواحِ تأتي","تشيب ولا يشيب لها الوليدُ",57,"د",1,0],["وَأَرومُ كِتمانَ الهَوى فَيُذيعُهُ","طَرفي وَطَرف الصَّبِّ مِن أَعدائِهِ",58,"ا",3,0],["وَأَروى أَهلَها عَذباً فُراتاً","وَلَم يَنفَح لَها عَذبٌ فُؤادا",59,"د",2,0],["وأرواح العباد الجو","ع نحو الموت يحشوها",60,"ه",2,0],["واروع في عليا معدٍّ اذا اعتزَى","وفي النَّفر الغرّ الكرام اذا عدّا",61,"د",2,0],["وأروهُ أن الفسادَ وإن طا","لَ فعقبى أمورهِ للفسادِ",62,"د",1,0],["واروِ من مهجتي عليكَ غليلاً","سعرتهُ في أضلعي نارُ يأسي",63,"س",2,0],["وَارْوِ حَرَّ الْحَشَا بِجَدْوَاكَ رَيّاً","لَمْ يَدَعْ فِي الْفُؤَادِ مِنَّا رَسِيسَا",64,"س",2,0],["وَارْوِ حَرَّ إِعْسَارِنَا بِنَدَاكُمْ","إِنَّهُ مُبْرِئِي مِنَ الإِفْلاَسِ",65,"س",1,0],["وأَرُوها زخرفَ الدنيا وما","راقَ فيها مِن نعيمٍ وَثَراء",66,"ا",2,0],["وارو عنّي العلم اللدنيّ إذ ما","ختم دنيّ فضّضته بالأنامل",67,"ل",1,0],["وأَروع قد كنّا بجنةِ رأْيه","نردُّ سيوفَ الخطبِ عنا نوابيا",68,"ي",2,0],["وأرواح تطير إلى علاها","بأجنحة الغرام المقعديه",69,"ي",2,0],["واروا علوماً يُنادي مَن يؤرّخُها","وَدائع العلمِ في قبرِ اِبن عاشورِ",70,"ر",1,0],["وَأرويتُ أَفواه الرواةِ بسلسلٍ","تَغشّى مِنَ الألفاظِ مَشمولةً بكرا",71,"ر",2,0],["وارو للتاريخ يوما جم","عت فيه الأماني",72,"ن",2,0],["وارو بالوصل ورودي","كن لقلبي مسعفا",73,"ف",2,0],["وَار وَالمَعالي وَروّ الوارِدين فَما","صبح أَضاء كَنَجم في الظَلام خَفى",74,"ف",2,0],["وأروعَ مَضّاءٍ كأنَّ جَنانَه","شُباةُ سِنانٍ أُودعَتْها التّرائب",75,"ب",1,0],["وأروَعُ يَهْوى الحمدَ في الجودِ كلهِّ","فلا يُلجِىءُ العافي إلى الشُّفعاء",76,"ا",2,0],["وَأَروَيتُ خَدّي مِن دُموعٍ وَرُبّما","غَضِبتُ فَأَروَيتُ العُلا وَالعَوالِيا",77,"ي",2,0],["وَأَروَيتُ نارَ الحُبِّ فيهِ وَرُبَّما","تَعَلَّقَتِ النيرانُ ما كانَ حامِيا",77,"ي",2,0],["وَارو لي يا نَسيم أَخبار أَحبا","بي سرّاً وَغَنني يا سَميرُ",78,"ر",1,0],["واروّي بأدمعي كلّ غصن","ظامىء جفّ زهره المعطار",79,"ر",1,0],["وأروع يُمضي فِعْلَهُ قبل قولِهِ","إذا جَادَ لا يُصغي لرَأْي مُفنّدِ",80,"د",1,0],["وارو الذي تراه من تصنيفي","وما تراه صح من تأليفي",81,"ي",1,0],["وارْوِ علوم المصطفى أحمد","من حاز في الناس شريف الخلال",82,"ل",1,0],["وأروضُ نفسي في رِضَا مُتَجرِّمٍ","فَاتَتْ مودّتُه طِلاَبَ الناشدِ",83,"د",1,0],["وأرَوني العزَّ خفضاً عيشه","والردى أهونُ من عيش الذليل",84,"ل",1,0],["وأَروحُ أزجرُ طائراً","في أسعدِ الأُمراء سَعْدا",85,"د",2,0],["وأروي الدِّيار بماء الجفون","قلم يرق دمعي وفيها ظما",86,"ا",1,0],["وأروم من بعد التفرق أن أرى","طيف الخيال يزورني متعطفا",87,"ف",2,0],["وأَروهُ فارساً مستلْئِماً","وأَنا كَذَّابُكُمْ إِن لَمْ يَشدْ",88,"د",1,0],["وأروم الوفاء من زمن الغد","ر وهل للسَّحوقِ باليد مجنَى",89,"ن",2,0],["وأروعُ لا يَحُلُّ الخطبُ منه","معاقدَ حبوتيه ولا اعتزامَهْ",90,"م",2,0],["وأروعُ ما اشتريتَ به المعالي","وحُزْتَ شَواردَ الذكرِ الجميلِ",91,"ل",1,0],["وأروَعُ المَجْدِ مَرْمَى هامَةٍ زَحَمَتْ","ذ ُرا السَّماءِ ، وَخَطْوٍ لم يَزَلْ تَرِبا !",92,"ب",2,0],["وأُروَّحَ القلبَ الذي لم ينسَهمْ","بعدَ النوى بكواذبِ الآمالِ",93,"ل",1,0],["وأروك مصداق التمدن فانبرت","شبانكم لمعارج التفكير",94,"ر",1,0],["وأرؤس أملاك الحضائر قوبلت","بتربيعها حتى القوى الجبرائيليه",95,"ي",2,0],["وارْوِ عنِّي الطَريقَ حالاً وذَوْقاً","حَسْبَ مَنْصوصِ نَهْجِهِ المَبْنِيِّ",96,"ي",1,0],["وارْوِ عنَّا أَسْرارَنا وافْنَ فينا","وتَهَنَّا بإرْثِنا أنتَ مِنَّا",97,"ن",2,0],["وارْوِ كلامَ المُصْطَفى مُحَقَّق