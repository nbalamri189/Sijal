[353,"الحبيب الشرود","https://www.aldiwan.net/poem950.html",""],[362,"بالجد والجد حاول ذروة الشرف","https://www.aldiwan.net/poem68088.html","البسيط"],[365,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[365,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[367,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[381,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[395,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[403,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[404,"الحمد لله عظيم الشأن","https://www.aldiwan.net/poem33345.html","الرجز"],[404,"الحمد لله على كل حال","https://www.aldiwan.net/poem33479.html","السريع"],[410,"حتام أرغب في مودة زاهد","https://www.aldiwan.net/poem32603.html","الكامل"],[417,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[417,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[417,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[438,"حتام تقطع بالقطيعة والجفا","https://www.aldiwan.net/poem2551.html","الكامل"],[440,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[459,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[459,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[462,"جزاك الله مجد الدين خيرا","https://www.aldiwan.net/poem15284.html","الوافر"],[466,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[478,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[480,"إن رمت إرضاء الخصوم فلا تقل","https://www.aldiwan.net/poem36959.html","الكامل"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[501,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[501,"بين طي الحبيب والنشر معنى","https://www.aldiwan.net/poem37750.html","الخفيف"],[501,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[515,"سلام حكى في حسنه لؤلؤ العقد","https://www.aldiwan.net/poem20834.html","الطويل"],[516,"من استعان بغير الله لم يعن","https://www.aldiwan.net/poem12278.html","البسيط"],[539,"كأس الخطوب بذا العدو دهاق","https://www.aldiwan.net/poem47536.html","عموديه"],[541,"وأروع قد دق الكرى عظم ساقه","https://www.aldiwan.net/poem56820.html","الطويل"],[552,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[552,"إنا نعلل كلنا بمحال","https://www.aldiwan.net/poem47297.html","الكامل"],[552,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[559,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[559,"أيها الناي عندك الخبر","https://www.aldiwan.net/poem34554.html","الخفيف"],[561,"قلوب ودروب","https://www.aldiwan.net/poem67273.html","عموديه"],[576,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[576,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"]],"verses":[["وأروع خواض لكل مهولة","ونساك محراب تواراه عابد",0,"د",1,0],["وَأَروحُ قائِدَ فِتيَةٍ","سودِ الغَدائِرِ وَالجُمامِ",1,"م",1,0],["وَأَرومُ مِن غُلَواءِ عِزِّكَ غايَةً","قَعساءَ تَستَلِبُ النَواظِرَ مِن عَلِ",2,"ل",1,0],["وَأَروحُ في ظَفَرِ القَوِيَّ","وَقَدِ اِنتَصَفتُ مِنَ الفِراقِ",3,"ق",1,0],["وَأَروحُ أَذكَرَ ما أَكونُ لِعَهدِهِ","فَكَأَنَّني اِستَودَعتُهُ الأَحشاءَ",4,"ا",2,0],["وَأرْوَعَ تَحْتَ أَخْمَصِهِ الثُّرَيَّا","وَفَوْقَ جَبينِهِ خَرَزاتُ تاجِ",5,"ج",1,0],["وأرْوَعُ وافي اللُّبِّ والسِّلْمِ جامعٌ","وفي الحَرْبِ إن حكَّتْ بهِ بَرْكَها غَمْرُ",6,"ر",1,0],["وَأَرواحُنا بِاللَيلِ في الحَيِّ تَلتَقي","وَنَعلَمُ أَنّا بِالنَهارِ نَقيلُ",7,"ل",1,0],["وَأَروَعُ لا الباغي أَخاهُ مُبَلَّغٌ","مُناهُ وَلا الراجي نَداهُ مُسَوَّفُ",8,"ف",1,0],["وَأَروَعُ لامُعتَفي رِفدِهِ","يَخيبُ وَلا جارُهُ يُهتَضَم",9,"م",1,0],["وَأَروَثنَهُ نَأياً فَأَضحى كَأَنَّهُ","مُخالِطُهُ يَومَ السُرَيرِ جُنونُ",10,"ن",1,0],["وَأَروَعَ مِهيامِ السُرى كُلَّ لَيلَةٍ","بِذِكرِ الغَواني في الغِناءِ المُواصِلِ",11,"ل",1,0],["وَأَرواح خَرق نازِح جَزَعَت بِنا","زَهاليلُ تَرمي غَولَ كُلِّ نِجادِ",12,"د",1,0],["وَأَروَعَ جَيشُهُ لَيلٌ بَهيمٌ","وَغُرَّتُهُ عَمودٌ مِن صَباحِ",13,"ح",1,0],["وأروع يهتزّ الزمان لأمره","وما الطود أرسى جانباً من سكونه",14,"ن",2,0],["وأروع أخبى للأئمة منصباً","يرقّ ويزهى حين يبكي الجديدان",15,"ن",1,0],["واروعتا لصباحٍ عند رؤيته","أظنُّ أنَّ صباح الحشر ثانيه",16,"ي",2,0],["وأرْوى غُلَّتي لو كنتُ أروى","بما تُروَى به الهِيمُ العِطاش",17,"ش",1,0],["وَأَروحُ في ظِلِّ الشَبابِ وَأَغتَدي","جَذلانَ لا أَشكو وَلا أَتَعَلَّلُ",18,"ل",1,0],["واروا الذين يرون فيكم","خصلة العجز اقتدارا",19,"ر",2,0],["وأروعَ وقّادِ الجبينِ كأنّما","جَرى فوق خدَّيْهِ النُضَارُ المشعشَعُ",20,"ع",1,0],["وأروعُ قُرْحَانٌ من الحُبِّ أمرُهُ","عليَّ إِذا لم يُومِ بالصبرِ جائزُ",21,"ز",1,0],["وَأَرومَةٍ في المُلكِ خاقانِيَّةٍ","تَعتَمُّ أَفناناً وَتَكرُمُ عُنصُرا",22,"ر",2,0],["وأرواحنا ثَمَرَاتٌ له","يَمُدّ إليها يداً جانيَه",23,"ي",2,0],["وَأرَوْكَ أنّ من المياه مَناصِلاً","طُبِعَتْ مضاربها من النيرانِ",24,"ن",1,0],["وأروحُ عن وطني إذا دَمِيَتْ","بعدي مدامعُ دُمْيَةِ الكِلَلِ",25,"ل",1,0],["وأُروّي غُلَلَ الشّوقِ بما","لم يكُنْ في قُدْرَةِ الماءِ القَراح",26,"ح",1,0],["وَأَروَعَ لا يُلقي المَقالِدَ لِاِمرِئٍ","فَكُلُّ اِمرِئٍ يُلقي لَهُ بِالمَقالِدِ",27,"د",1,0],["وَأَروَعَ أَمجَدَ قَرَّظَتهُ","وَبيضُ اللَآلي لِبيضِ النُحورِ",28,"ر",1,1],["وَأَروَعَ يَندى لِلطَلاقَةِ صَفحَةً","وَيَقدَحُ زَنداً لِلنَباهَةِ وارِيا",29,"ي",2,0],["وأَرُوهُ السُّبْلَ ناراً ودماً","مَن يَهَبْ فيها المنايا يُصعَقِ",30,"ق",1,0],["وأرومُ سِنَّكِ ضاحكاً","حتَّى يلوحَ وأرْقُبَه",31,"ب",2,0],["وَأرَوْنا أهلَ التُّقَى في الزَّوايا","سَلَّمُوا في البَقا لأَهْلِ القُصُورِ",32,"ر",1,0],["وأروحُ من طرادِ الخيل ركضاً","طرادُكَ كل مياسٍ لبيقِ",33,"ق",1,0],["وَأَرواحُنا كَالراحِ إِن طالَ حَبسُها","فَلا بُدَّ يَوماً أَن تَكونَ سِباءُ",34,"ب",3,0],["وَأَرواحٌ سَوالِكُ في جُسومٍ","يُهَنَّ بِأَن يُرَينَ مُجَسَّماتِ",35,"ت",1,0],["واروهُ مِن قَبلِ الفَسادِ فَإِنَّهُ","جِسمٌ إِذا فُقِدَت حَرارَتُهُ فَسَد",36,"د",1,0],["وَأَروَحُ الرِزقِ ما وافاكَ في دِعَةٍ","حِلّاً وَقُسِّمَ في أَيّامِهِ بُلَغا",37,"غ",2,0],["وَأَروَحُ مِن عَينٍ يَظَلُّ اِنتِسابُها","إِلى الإِنسِ وَحشٌ بِالمَهامِهِ عينُ",38,"ن",1,0],["وَأَروَحُ مِنهُما حادي ثَلاثٍ","يَسوقَهُنَّ أَو حادي ثَمانِ",39,"ن",1,0],["وَأَروَعُ نَبّاضٌ أَحَذُّ مُلَملَمٌ","كَمِرداةِ صَخرٍ في صَفيحٍ مُصَمَّدِ",40,"د",1,0],["وأَروم إيضاحاً لما قد أَبهمت","فَتَزيد إِبهاما على إِبهام",41,"م",1,0],["وأرواحاً عليكِ محوِّماتٍ","لها فوق الضِّفافِ خُطىً ووثبُ",42,"ب",1,0],["وَارْوِ غُلَّتِي","بِابْنَةِ الْفَرَحْ",43,"ح",1,0],["وأرْوَعُ ما تهفو له العينُ رايةٌ","تُداعبها الأرواحُ في كَفِّ غَالبِ",44,"ب",1,0],["وأروى من النيل للظامئينَ","وأخلدُ من لَبناتِ الهرم",45,"م",1,0],["وارو، يا يرموكُ، ماذا صَنَعتْ","برءوس الرومِ أَسيافُ الكماه؟",46,"ا",2,0],["وأروث حق النصر لا عن كلالة","وللسبط في المشروع أن يرث الجدا",47,"د",2,0],["وأروع نباضٌ أحد ململمٌ","كمرداة صخرٍ في صفيحٍ مصمد",48,"د",1,0],["واروي اسانيد المحبة طاهرا","وخلفي كلاب الحقد بالسوء تجهر",49,"ر",1,0],["وأروح أجني الشوك غير مقلم","ولكم قطفت جنى الغصون الميد",50,"د",1,0],["وارْو عن عامرٍ وأخلاقهِ الحسنى","وحدّثْ عن جُودِه وسَخَائِه",51,"ا",3,0],["وَأَروَعَ لِلعافينَ في حُجُراتِهِ","مَواهِبُ تَتلوها وَتَترى مَواهِبُ",52,"ب",1,0],["وَأَروَعَ تُصبيهِ المَكارِمُ وَالعُلى","إِذا غَيرُهُ أَصبَتهُ زَينَبُ أَو هِندُ",53,"د",1,0],["وَأَروَعَ لا يَقضي عَلى الجودِ لِلغِنى","وَلَكِنَّهُ يَقضي عَلى الوَفرِ لِلوَفدِ",54,"د",1,0],["وَأَروَعَ عَفّى في التَجاوُزِ وَالتُقى","عَلى مَن عَفا بَعدَ اِقتِدارٍ وَمَن عَفّا",55,"ف",2,0],["وَأَروَعُ إِن أَمَّ العُفاةُ فِناءَهُ","أَزالَ عَسى مِن قَولِهِ وَلَعَلَّما",56,"م",2,0],["وأرواحٌ على الأرواحِ تأتي","تشيب ولا يشيب لها الوليدُ",57,"د",1,0],["وَأَرومُ كِتمانَ الهَوى فَيُذيعُهُ","طَرفي وَطَرف الصَّبِّ مِن أَعدائِهِ",58,"ا",3,0],["وَأَروى أَهلَها عَذباً فُراتاً","وَلَم يَنفَح لَها عَذبٌ فُؤادا",59,"د",2,0],["وأرواح العباد الجو","ع نحو الموت يحشوها",60,"ه",2,0],["واروع في عليا معدٍّ اذا اعتزَى","وفي النَّفر الغرّ الكرام اذا عدّا",61,"د",2,0],["وأروهُ أن الفسادَ وإن طا","لَ فعقبى أمورهِ للفسادِ",62,"د",1,0],["واروِ من مهجتي عليكَ غليلاً","سعرتهُ في أضلعي نارُ يأسي",63,"س",2,0],["وَارْوِ حَرَّ الْحَشَا بِجَدْوَاكَ رَيّاً","لَمْ يَدَعْ فِي الْفُؤَادِ مِنَّا رَسِيسَا",64,"س",2,0],["وَارْوِ حَرَّ إِعْسَارِنَا بِنَدَاكُمْ","إِنَّهُ مُبْرِئِي مِنَ الإِفْلاَسِ",65,"س",1,0],["وأَرُوها زخرفَ الدنيا وما","راقَ فيها مِن نعيمٍ وَثَراء",66,"ا",2,0],["وارو عنّي العلم اللدنيّ إذ ما","ختم دنيّ فضّضته بالأنامل",67,"ل",1,0],["وأَروع قد كنّا بجنةِ رأْيه","نردُّ سيوفَ الخطبِ عنا نوابيا",68,"ي",2,0],["وأرواح تطير إلى علاها","بأجنحة الغرام المقعديه",69,"ي",2,0],["واروا علوماً يُنادي مَن يؤرّخُها","وَدائع العلمِ في قبرِ اِبن عاشورِ",70,"ر",1,0],["وَأرويتُ أَفواه الرواةِ بسلسلٍ","تَغشّى مِنَ الألفاظِ مَشمولةً بكرا",71,"ر",2,0],["وارو للتاريخ يوما جم","عت فيه الأماني",72,"ن",2,0],["وارو بالوصل ورودي","كن لقلبي مسعفا",73,"ف",2,0],["وَار وَالمَعالي وَروّ الوارِدين فَما","صبح أَضاء كَنَجم في الظَلام خَفى",74,"ف",2,0],["وأروعَ مَضّاءٍ كأنَّ جَنانَه","شُباةُ سِنانٍ أُودعَتْها التّرائب",75,"ب",1,0],["وأروَعُ يَهْوى الحمدَ في الجودِ كلهِّ","فلا يُلجِىءُ العافي إلى الشُّفعاء",76,"ا",2,0],["وَأَروَيتُ خَدّي مِن دُموعٍ وَرُبّما","غَضِبتُ فَأَروَيتُ العُلا وَالعَوالِيا",77,"ي",2,0],["وَأَروَيتُ نارَ الحُبِّ فيهِ وَرُبَّما","تَعَلَّقَتِ النيرانُ ما كانَ حامِيا",77,"ي",2,0],["وَارو لي يا نَسيم أَخبار أَحبا","بي سرّاً وَغَنني يا سَميرُ",78,"ر",1,0],["واروّي بأدمعي كلّ غصن","ظامىء جفّ زهره المعطار",79,"ر",1,0],["وأروع يُمضي فِعْلَهُ قبل قولِهِ","إذا جَادَ لا يُصغي لرَأْي مُفنّدِ",80,"د",1,0],["وارو الذي تراه من تصنيفي","وما تراه صح من تأليفي",81,"ي",1,0],["وارْوِ علوم المصطفى أحمد","من حاز في الناس شريف الخلال",82,"ل",1,0],["وأروضُ نفسي في رِضَا مُتَجرِّمٍ","فَاتَتْ مودّتُه طِلاَبَ الناشدِ",83,"د",1,0],["وأرَوني العزَّ خفضاً عيشه","والردى أهونُ من عيش الذليل",84,"ل",1,0],["وأَروحُ أزجرُ طائراً","في أسعدِ الأُمراء سَعْدا",85,"د",2,0],["وأروي الدِّيار بماء الجفون","قلم يرق دمعي وفيها ظما",86,"ا",1,0],["وأروم من بعد التفرق أن أرى","طيف الخيال يزورني متعطفا",87,"ف",2,0],["وأَروهُ فارساً مستلْئِماً","وأَنا كَذَّابُكُمْ إِن لَمْ يَشدْ",88,"د",1,0],["وأروم الوفاء من زمن الغد","ر وهل للسَّحوقِ باليد مجنَى",89,"ن",2,0],["وأروعُ لا يَحُلُّ الخطبُ منه","معاقدَ حبوتيه ولا اعتزامَهْ",90,"م",2,0],["وأروعُ ما اشتريتَ به المعالي","وحُزْتَ شَواردَ الذكرِ الجميلِ",91,"ل",1,0],["وأروَعُ المَجْدِ مَرْمَى هامَةٍ زَحَمَتْ","ذ ُرا السَّماءِ ، وَخَطْوٍ لم يَزَلْ تَرِبا !",92,"ب",2,0],["وأُروَّحَ القلبَ الذي لم ينسَهمْ","بعدَ النوى بكواذبِ الآمالِ",93,"ل",1,0],["وأروك مصداق التمدن فانبرت","شبانكم لمعارج التفكير",94,"ر",1,0],["وأرؤس أملاك الحضائر قوبلت","بتربيعها حتى القوى الجبرائيليه",95,"ي",2,0],["وارْوِ عنِّي الطَريقَ حالاً وذَوْقاً","حَسْبَ مَنْصوصِ نَهْجِهِ المَبْنِيِّ",96,"ي",1,0],["وارْوِ عنَّا أَسْرارَنا وافْنَ فينا","وتَهَنَّا بإرْثِنا أنتَ مِنَّا",97,"ن",2,0],["وارْوِ كلامَ المُصْطَفى مُحَقَّقاً","ما كُلُّ راوٍ إِنْ روَى القولَ رَوَى",98,"ا",1,0],["وأروى تحيّاتٍ تغنّى بروضِها","حَمامُ الثّنا شُكراً على فنَنِ الوُدِّ",99,"د",1,0],["وأروح الناس من باتت سريرته","نقية من دخيل الحقد والضغن",100,"ن",1,0],["وأرَوهُمُ وَجهَ الثَّرى ورَمَوا بهِم","والدمعُ مِن أجفَانِهم مُهرَاق",101,"ق",1,0],["وَأَروَعَ قَد دَقَّ الكَرى عَظمَ ساقِهِ","كَضِغثِ الخَلا أَو طائِرِ المُتَبَسِّرِ",102,"ر",1,1],["وأروعَ لم تَمْلَ النّوائبُ ذرعَه","ولا ضلّ في ليلِ السّفاهةِ حلمُهُ",103,"م",2,0],["وأرَوْه غيرَ مضاجعٍ لدنيّةٍ","ونَعَوْه غيرَ مدنَّسِ الأذيالِ",104,"ل",1,0],["وأرْوَعَ من آل النبيِّ إذا اِنتَمى","أصابَ عليَّاً والداً ومحمّدا",105,"د",2,0],["وأروَى بماء العلم منه عطاشه","وأشبعَ بالتحقيق فيه جياعه",106,"ع",2,0],["وارو أخبار من أحب فإن","فاتت العين لم يفت أثر",107,"ر",1,0],["وأرواحٌ تخالطُنا فنسمو","طيوفاً سابحاتٍ لا تئُوبُ",108,"ب",1,0],["وأَرُوحُ لي وَجْدٌ يُجدِّدُه","فِكْرٌ يَمرُّ بِه على بَالِي",109,"ل",2,0],["وأُروِّي نورَ عينيَّ","وقَلْبي مِن رُوَائِكْ",110,"ك",1,0]]}