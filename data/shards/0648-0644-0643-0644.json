poetsgate.com/ViewPoem.aspx?id=200172",""],[5596,"عيدالاضحى بعدما قُدّم موعده وأُخّر !!","https://www.poetsgate.com/ViewPoem.aspx?id=205670",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5648,"العلم مده والصدر هات مافيه","https://www.poetsgate.com/ViewPoem.aspx?id=156417",""],[5725,"رثاء الشيخ نوري صالح الاوحيد","https://www.poetsgate.com/ViewPoem.aspx?id=215669",""],[5929,"وتكاد تمطرنا السماء...","https://www.poetsgate.com/ViewPoem.aspx?id=202655",""],[5956,"لا تستطيع على الشتاء القارس","https://www.poetsgate.com/ViewPoem.aspx?id=184408",""],[5956,"طوبَى للمحامية هالة خضر المحمد","https://www.poetsgate.com/ViewPoem.aspx?id=214190",""],[5956,"يومَ الخميس حبيبتي قد سافرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=215905",""],[5970,"عش غريباً فالعيش محض غريب","https://www.poetsgate.com/ViewPoem.aspx?id=130596",""],[5977,"لا بأس يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=213302",""],[6056,"الفصول الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=130328",""],[6082,"الحب رشفة","https://www.poetsgate.com/ViewPoem.aspx?id=59116",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[6225,"اجتماع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80897&r=&rc=166",""]],"verses":[["وَلِكُلِّ شَيءٍ آخِرٌ","إِمّا جَميلٌ أَو قَبيحُ",0,"ح",1,0],["وَلِكُلِّ قَولٍ سامِعٌ","وَلِكُلِّ داعِيَةٍ جَوابُ",1,"ب",1,0],["ولِكُلِّ نَفْسٍ مَصْرَعٌ لا تُمْتَطَى","إلا إلَيهِ الآلَةُ الحَدْباءُ",2,"ا",2,0],["وَلِكُلِّ مُنهَلٍّ دُموعٌ","تَستَفيقُ وَتَجمُدُ",3,"د",1,0],["وَلِكُلِّ شَيْءٍ غَايَةٌ مَرْقُوبَةٌ","أَعْلاَمُهَا وَلِكُلِّ شَيْءٍ مَفْصِلُ",4,"ل",1,0],["وَلِكُلِّ لَفظٍ في المَعاجِمِ عِندَهُم","مَعنىً يُقالُ بِأَنَّهُ مَعقولُ",5,"ل",1,0],["ولكل مكانه من هوى النا","س وكل بالتكرمات جدير",6,"ر",1,0],["ولكل سيار شعاعٌ سايرٌ","في الغور مهوى كل جدٍ غائر",7,"ر",1,0],["وَلِكُلِّ جُزْءٍ مِنْ دَقَائِقِهَا","مَعْنَىً كَمَعْنَى الكُلِّ لَمْ يُرَمِ",8,"م",1,0],["ولكل من المعيشة نحو","بالُ ذي الشيب للفتى غيرُ بالِ",9,"ل",1,0],["ولكل من الأخلاء حالٌ","هوَ فيها كفءٌ من الأكفاءِ",10,"ا",2,0],["وَلِكُلٍّ مَطامِعٍ وَأَماني","يَبذُلُ النَفسَ دونَها لِلمَنِيَّه",11,"ي",2,0],["وَلِكُلِّ نَفسٍ في الحَياةِ سَبيلُها","وَنَصيبُها مِمّا تَجُرُّ وَتَكسِبُ",12,"ب",1,0],["ولكلِّ مَا في الكونِ من صُوَرِ المنى","وغرائِبِ الأَهواءِ والأَشْجانِ",13,"ن",1,0],["ولكل عصفور من","الانغام ما هو باذل",14,"ل",1,0],["ولكل امرئ من الموت كأس","وسأحسو عند النهاية كاسي",15,"س",2,0],["وَلِكُلِّ نَفسٍ ساعَةٌ مَن لَم يَمُت","فيها عَزيزاً ماتَ وَهوَ ذَليلُ",16,"ل",1,0],["وَلِكُلِّ ما أَتلَفتَ مِن مُستَكرَمٍ","إِلّا مَوَدّاتِ الرِجالِ تَلافِ",17,"ف",1,0],["وَلِكُلٍّ شيعَةٌ مِن جِنسِهِ","إِنَّ لِلشَرِّ إِلى الشَرِّ اِنجِذابا",18,"ب",2,0],["وَلِكُلِّ عَينٍ قُرَّةٌ في قُربِهِ","حَتّى كَأَنَّ مَغيبَهُ الأَقذاءُ",19,"ا",2,0],["وَلِكُلِّ عَهدٍ مُخلَفٍ وَأَمانَةٍ","في الناسِ مِن قِبَلِ الإِلَهِ رِعاءُ",20,"ا",2,0],["وَلِكُلِّ ذي عَمَلٍ يَدينُ بِهِ","يَوماً عَلى دَيّانِهِ عَرضُ",21,"ض",1,0],["وَلِكُلِّ شَخصٍ هِزَّةُ الغُصنِ النَدي","غِبَّ البُكاءِ وَرِنَّةُ المُكاءِ",22,"ا",2,0],["ولكلِّ شعبٍ إن توثّبَ أو مَضَى","يبغي الفريسةَ مَصْرَعٌ وحِمامُ",23,"م",1,0],["وَلِكُلِّ قَومٍ قَد خَبَطتَ بِأَنعُمٍ","تَترى وَجُدتَ بِديمَةٍ مِدرارِ",24,"ر",1,0],["وَلكلِّ عَيْنٍ منه بَدْرٌ طالع","ولكلِّ قلبٍ منه لَيْثٌ أَغْلَبُ",25,"ب",1,0],["ولكُلِّ سابِقِ حلبةٍ أمَدٌ","ولكلِّ واردِ نهلَةٍ صَدَر",26,"ر",1,0],["وَلِكُلِّ عَصرٍ حائِدٌ وَمُقَدَّمٌ","لِلحَربِ يَضرِبُ في جَبينِ الأَصيدِ",27,"د",1,0],["وَلِكُلِّ ما أَصبَحتَ تُدرِكُ حِسَّهُ","ضِدٌّ وَكِبرَةُ مَن تَرى كَصِغارِ",28,"ر",1,0],["وَلِكُلِّ دَهرٍ حَليَّةٌ مِن أَهلِهِ","ما فيهِمُ جَنَفٌ وَلا إِفراطُ",29,"ط",1,0],["ولكلٍّ أنفٌ غليظٌ طويلٌ","هو كالقرن بالنطاح جديرُ",30,"ر",1,0],["ولكل امرئ إذا خالط النا","س طويلاً أَحبة وأَعادي",31,"د",2,0],["وَلكلٍّ توابعٌ أَنا استب","عدُ حرمانها من الأحياء",32,"ا",2,0],["وَلكل سوى القريبين أَقما","ر عليه تدور في الأنحاء",32,"ا",2,0],["ولكل منحل جَدي","دِ تركُّبٌ فيما بدا لي",33,"ل",2,0],["وَلِكُلِّ سَيفٍ مُصلَتٍ","لِحَوادِثِ الدُنيا قِراب",34,"ب",1,0],["ولِكُلِّ شَيْءٍ بَاديءٍ أَجَلٌ","حَتَّى النَّدَى وَاللُّطْفِ وَالرِّفْقِ",35,"ق",1,0],["وَلِكُلٍّ مِنْهُمْ هَوًى فِي فُؤَادِي","وَاشِجَاتٌ أَسْبَابُهُ بِالوَتِينِ",36,"ن",1,0],["وَلِكُلّ سَيَّارٍ شُعَاع سَابِرٌ","فِي الغَوْرِ مَهْوَى كُلِّ جَدٍّ غَائِرِ",37,"ر",1,0],["ولكل عارية مدى","ولكل غاشية جلاء",38,"ا",2,0],["ولكلِّ غاشيةٍ مدىً","ولكلِّ داجيةٍ صباح",39,"ح",1,0],["ولكلِّ مُحتَطِبِ الخنا مَداحةٌ","ولكل مُمتدِح النثا شَتّام",40,"م",1,0],["ولكلِّ \" فاحشةِ \" المَتاع دَميمةٍ","سُوقٌ تُتيحُ لها دَميماً راغبا",41,"ب",2,0],["وَلكل عز في سِواهُ مَذَلة","وَلِكُل صَدر في المَجالس دُونُ",42,"ن",1,0],["ولكل مما عداها نصيب","مثله ان تعد أول أوّل",43,"ل",1,0],["ولكل شيء أجل ومدّة","وعدّة ثم انقضاء العدّة",44,"ه",1,0],["وَلِكلٍّ بالمكرُمات اِئتزار","ولِكلٍّ بالمكرماتِ اِرتداءُ",45,"ا",2,0],["ولكلّ ملتاح صفت","شتّى المناهل والموارد",46,"د",1,0],["ولكلِّ الورى رؤوسٌ فإن لم","يكن العقلُ كانتِ الوهامُ",47,"م",1,0],["ولكلِ الناسِ فقرٌ شاملٌ","والغنيُ فقرهُ أن يبخلا",48,"ل",2,0],["ولكلّ سعدٍ طالعٌ","فعلى علاها له المدار",49,"ر",1,0],["ولكلّ الإخوان من كلّ خلٍّ","روّق الصدق والوفا أوراده",50,"د",2,0],["ولكل ذي جفن قذى","ولكل ذي قلب شجون",51,"ن",1,0],["ولكل طير همة يعلو بها","متن الهواء وليس كالعنقاء",52,"ا",2,0],["ولكل ضيق مخرج من بعده","ولكل داء صحة بدواء",52,"ا",2,0],["ولكلِّ عضوٍ هزَّةٌ فكأنّهُ","ما جاورَ العضوَ القريبَ وحاذى",53,"ذ",2,0],["ولكلِّ أرضٍ من جمالِكِ قِسمَةٌ","وجمالُ كلِّ الأرضِ في ناديك",54,"ك",1,0],["وَلكلِّ خَطبٍ حيلةٌ","والبينُ قل لي ما اِحتيالُه",55,"ل",2,0],["وَلكلّ في الحالتينِ نعيمٌ","وَعذاب نفسيٌّ أو جسماني",56,"ن",2,0],["وَلَكُلِّ عَبدٍ مِن عِبادِكَ أَرتَجي","خَيراً بِلا طَعنٍ وَلا تَجريحِ",57,"ح",1,0],["وَلكلّ صبّ لا محالَة سلوة","وَلكل بَدر قَد أَضاء مُحاق",58,"ق",1,0],["ولِكلِّ أُنثى ضَرَّةٌ","والعدلُ ضَرَّة أُمِّه",59,"م",2,1],["ولكل أنثى بالعفاف تزينت","منهم سهام تآمر وحرابُ",60,"ب",1,0],["ولكل شيخ بالشريعة عالم","منهم عدوٌ ظاهرٌ مرتابُ",60,"ب",1,0],["ولكل شيء آفة","تأتيه بالأمر المفاجي",61,"ج",2,0],["ولِكُلِّ ما تَأْبى وتَهْ","وى إن ص