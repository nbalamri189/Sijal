{"poems":[[53,"صبرا على نوب الزما","https://www.aldiwan.net/poem30646.html","مجزوء الكامل"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[63,"نبأ تقاصر دونه الأنباء","https://www.aldiwan.net/poem46201.html","الكامل"],[55,"يا من يلوم على هوى","https://www.aldiwan.net/poem26385.html","مجزوء الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[93,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[37,"هل لحال من اقتياض بحال","https://www.aldiwan.net/poem7444.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[91,"فتنته محاسن الحريه","https://www.aldiwan.net/poem62823.html","عموديه"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[92,"ما كنت أحسب بعد موتك يا أبي","https://www.aldiwan.net/poem38899.html","الكامل"],[89,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[89,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[85,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[2,"صرمت جديد حبالها أسماء","https://www.aldiwan.net/poem25045.html","الكامل"],[49,"ماذا يصير إليك يا أرض","https://www.aldiwan.net/poem62144.html","الكامل"],[74,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[105,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[46,"أكتم حديثك عن أخيك ولا تكن","https://www.aldiwan.net/poem22483.html","الكامل"],[46,"الوغد يجعل ما أنيل غنيمة","https://www.aldiwan.net/poem22719.html","الكامل"],[46,"أما اليقين فإننا سكن البلى","https://www.aldiwan.net/poem22907.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85639","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85496","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55077","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54914","الكامل"],[106,"رثاء طيارين!","https://www.poetsgate.com/ViewPoem.aspx?id=179490",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[107,"من مبلغ قصر الأمير بأنه","https://www.aldiwan.net/poem16370.html","الكامل"],[149,"هي قذ وتوأم ورقيب","https://www.aldiwan.net/poem1411.html",""],[184,"لا تجزعن وإن رميت بشدة","https://www.aldiwan.net/poem43882.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[195,"جاء الربيع وأنت راقد","https://www.aldiwan.net/poem39867.html","مجزوء الكامل"],[197,"عثرت في مدارها الأيام","https://www.aldiwan.net/poem45167.html","الخفيف"],[197,"آفة العالم أن لا يعملا","https://www.aldiwan.net/poem45670.html","الرمل"],[257,"دار عليها السعد دار","https://www.aldiwan.net/poem35769.html","مجزوء الكامل"],[257,"دعواتي في الغيب عين الشهاده","https://www.aldiwan.net/poem35779.html","الخفيف"],[259,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[259,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[268,"طربا أهجت لنا برقصك هذا","https://www.aldiwan.net/poem35267.html","الكامل"],[268,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[295,"هذا الحجاز وذاك ضاله","https://www.aldiwan.net/poem33196.html","مجزوء الكامل"],[303,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[318,"يا رب إنك عالم بتولعي","https://www.aldiwan.net/poem61818.html","الطويل"],[359,"ينهى محبك انه مشتاق","https://www.aldiwan.net/poem68082.html","الكامل"],[369,"ولكل أنثى ضرة","https://www.aldiwan.net/poem57142.html","مجزوء الكامل"],[397,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[400,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[406,"انظر بعيشك هل ترى","https://www.aldiwan.net/poem32082.html","مجزوء الكامل"],[429,"يا من يرى فضل الشتاء","https://www.aldiwan.net/poem12716.html","مجزوء الكامل"],[456,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"أما النسيم فما يغب وروده","https://www.aldiwan.net/poem3545.html","عموديه"],[488,"ذهب الذين عهدتُ أمس برأيهم","https://www.aldiwan.net/poem660.html",""],[498,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[513,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[549,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[560,"تركت ديار الشيخ مرعي بعلها","https://www.aldiwan.net/poem52531.html","الكامل"],[560,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[560,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[560,"غاب الأمير فما تمادى المرجع","https://www.aldiwan.net/poem52842.html","الكامل"]],"verses":[["وَلِكُلِّ شَيءٍ آخِرٌ","إِمّا جَميلٌ أَو قَبيحُ",0,"ح",1,0],["وَلِكُلِّ قَولٍ سامِعٌ","وَلِكُلِّ داعِيَةٍ جَوابُ",1,"ب",1,0],["ولِكُلِّ نَفْسٍ مَصْرَعٌ لا تُمْتَطَى","إلا إلَيهِ الآلَةُ الحَدْباءُ",2,"ا",2,0],["وَلِكُلِّ مُنهَلٍّ دُموعٌ","تَستَفيقُ وَتَجمُدُ",3,"د",1,0],["وَلِكُلِّ شَيْءٍ غَايَةٌ مَرْقُوبَةٌ","أَعْلاَمُهَا وَلِكُلِّ شَيْءٍ مَفْصِلُ",4,"ل",1,0],["وَلِكُلِّ لَفظٍ في المَعاجِمِ عِندَهُم","مَعنىً يُقالُ بِأَنَّهُ مَعقولُ",5,"ل",1,0],["ولكل مكانه من هوى النا","س وكل بالتكرمات جدير",6,"ر",1,0],["ولكل سيار شعاعٌ سايرٌ","في الغور مهوى كل جدٍ غائر",7,"ر",1,0],["وَلِكُلِّ جُزْءٍ مِنْ دَقَائِقِهَا","مَعْنَىً كَمَعْنَى الكُلِّ لَمْ يُرَمِ",8,"م",1,0],["ولكل من المعيشة نحو","بالُ ذي الشيب للفتى غيرُ بالِ",9,"ل",1,0],["ولكل من الأخلاء حالٌ","هوَ فيها كفءٌ من الأكفاءِ",10,"ا",2,0],["وَلِكُلٍّ مَطامِعٍ وَأَماني","يَبذُلُ النَفسَ دونَها لِلمَنِيَّه",11,"ي",2,0],["وَلِكُلِّ نَفسٍ في الحَياةِ سَبيلُها","وَنَصيبُها مِمّا تَجُرُّ وَتَكسِبُ",12,"ب",1,0],["ولكلِّ مَا في الكونِ من صُوَرِ المنى","وغرائِبِ الأَهواءِ والأَشْجانِ",13,"ن",1,0],["ولكل عصفور من","الانغام ما هو باذل",14,"ل",1,0],["ولكل امرئ من الموت كأس","وسأحسو عند النهاية كاسي",15,"ي",1,0],["وَلِكُلِّ نَفسٍ ساعَةٌ مَن لَم يَمُت","فيها عَزيزاً ماتَ وَهوَ ذَليلُ",16,"ل",1,0],["وَلِكُلِّ ما أَتلَفتَ مِن مُستَكرَمٍ","إِلّا مَوَدّاتِ الرِجالِ تَلافِ",17,"ف",1,0],["وَلِكُلٍّ شيعَةٌ مِن جِنسِهِ","إِنَّ لِلشَرِّ إِلى الشَرِّ اِنجِذابا",18,"ب",2,0],["وَلِكُلِّ عَينٍ قُرَّةٌ في قُربِهِ","حَتّى كَأَنَّ مَغيبَهُ الأَقذاءُ",19,"ا",2,0],["وَلِكُلِّ عَهدٍ مُخلَفٍ وَأَمانَةٍ","في الناسِ مِن قِبَلِ الإِلَهِ رِعاءُ",20,"ا",2,0],["وَلِكُلِّ ذي عَمَلٍ يَدينُ بِهِ","يَوماً عَلى دَيّانِهِ عَرضُ",21,"ض",1,0],["وَلِكُلِّ شَخصٍ هِزَّةُ الغُصنِ النَدي","غِبَّ البُكاءِ وَرِنَّةُ المُكاءِ",22,"ا",2,0],["ولكلِّ شعبٍ إن توثّبَ أو مَضَى","يبغي الفريسةَ مَصْرَعٌ وحِمامُ",23,"م",1,0],["وَلِكُلِّ قَومٍ قَد خَبَطتَ بِأَنعُمٍ","تَترى وَجُدتَ بِديمَةٍ مِدرارِ",24,"ر",1,0],["وَلكلِّ عَيْنٍ منه بَدْرٌ طالع","ولكلِّ قلبٍ منه لَيْثٌ أَغْلَبُ",25,"ب",1,0],["ولكُلِّ سابِقِ حلبةٍ أمَدٌ","ولكلِّ واردِ نهلَةٍ صَدَر",26,"ر",1,0],["وَلِكُلِّ عَصرٍ حائِدٌ وَمُقَدَّمٌ","لِلحَربِ يَضرِبُ في جَبينِ الأَصيدِ",27,"د",1,0],["وَلِكُلِّ ما أَصبَحتَ تُدرِكُ حِسَّهُ","ضِدٌّ وَكِبرَةُ مَن تَرى كَصِغارِ",28,"ر",1,0],["وَلِكُلِّ دَهرٍ حَليَّةٌ مِن أَهلِهِ","ما فيهِمُ جَنَفٌ وَلا إِفراطُ",29,"ط",1,0],["ولكلٍّ أنفٌ غليظٌ طويلٌ","هو كالقرن بالنطاح جديرُ",30,"ر",1,0],["ولكل امرئ إذا خالط النا","س طويلاً أَحبة وأَعادي",31,"د",2,0],["وَلكلٍّ توابعٌ أَنا استب","عدُ حرمانها من الأحياء",32,"ا",2,0],["وَلكل سوى القريبين أَقما","ر عليه تدور في الأنحاء",32,"ا",2,0],["ولكل منحل جَدي","دِ تركُّبٌ فيما بدا لي",33,"ي",1,0],["وَلِكُلِّ سَيفٍ مُصلَتٍ","لِحَوادِثِ الدُنيا قِراب",34,"ب",1,0],["ولِكُلِّ شَيْءٍ بَاديءٍ أَجَلٌ","حَتَّى النَّدَى وَاللُّطْفِ وَالرِّفْقِ",35,"ق",1,0],["وَلِكُلٍّ مِنْهُمْ هَوًى فِي فُؤَادِي","وَاشِجَاتٌ أَسْبَابُهُ بِالوَتِينِ",36,"ن",1,0],["وَلِكُلّ سَيَّارٍ شُعَاع سَابِرٌ","فِي الغَوْرِ مَهْوَى كُلِّ جَدٍّ غَائِرِ",37,"ر",1,0],["ولكل عارية مدى","ولكل غاشية جلاء",38,"ا",2,0],["ولكلِّ غاشيةٍ مدىً","ولكلِّ داجيةٍ صباح",39,"ح",1,0],["ولكلِّ مُحتَطِبِ الخنا مَداحةٌ","ولكل مُمتدِح النثا شَتّام",40,"م",1,0],["ولكلِّ \" فاحشةِ \" المَتاع دَميمةٍ","سُوقٌ تُتيحُ لها دَميماً راغبا",41,"ب",2,0],["وَلكل عز في سِواهُ مَذَلة","وَلِكُل صَدر في المَجالس دُونُ",42,"ن",1,0],["ولكل مما عداها نصيب","مثله ان تعد أول أوّل",43,"ل",1,0],["ولكل شيء أجل ومدّة","وعدّة ثم انقضاء العدّة",44,"ه",1,0],["وَلِكلٍّ بالمكرُمات اِئتزار","ولِكلٍّ بالمكرماتِ اِرتداءُ",45,"ا",2,0],["ولكلّ ملتاح صفت","شتّى المناهل والموارد",46,"د",1,0],["ولكلِّ الورى رؤوسٌ فإن لم","يكن العقلُ كانتِ الوهامُ",47,"م",1,0],["ولكلِ الناسِ فقرٌ شاملٌ","والغنيُ فقرهُ أن يبخلا",48,"ل",2,0],["ولكلّ سعدٍ طالعٌ","فعلى علاها له المدار",49,"ر",1,0],["ولكلّ الإخوان من كلّ خلٍّ","روّق الصدق والوفا أوراده",50,"د",2,0],["ولكل ذي جفن قذى","ولكل ذي قلب شجون",51,"ن",1,0],["ولكل طير همة يعلو بها","متن الهواء وليس كالعنقاء",52,"ا",2,0],["ولكل ضيق مخرج من بعده","ولكل داء صحة بدواء",52,"ا",2,0],["ولكلِّ عضوٍ هزَّةٌ فكأنّهُ","ما جاورَ العضوَ القريبَ وحاذى",53,"ذ",2,0],["ولكلِّ أرضٍ من جمالِكِ قِسمَةٌ","وجمالُ كلِّ الأرضِ في ناديك",54,"ك",1,0],["وَلكلِّ خَطبٍ حيلةٌ","والبينُ قل لي ما اِحتيالُه",55,"ل",2,0],["وَلكلّ في الحالتينِ نعيمٌ","وَعذاب نفسيٌّ أو جسماني",56,"ن",2,0],["وَلَكُلِّ عَبدٍ مِن عِبادِكَ أَرتَجي","خَيراً بِلا طَعنٍ وَلا تَجريحِ",57,"ح",1,0],["وَلكلّ صبّ لا محالَة سلوة","وَلكل بَدر قَد أَضاء مُحاق",58,"ق",1,0],["ولِكلِّ أُنثى ضَرَّةٌ","والعدلُ ضَرَّة أُمِّه",59,"م",2,1],["ولكل أنثى بالعفاف تزينت","منهم سهام تآمر وحرابُ",60,"ب",1,0],["ولكل شيخ بالشريعة عالم","منهم عدوٌ ظاهرٌ مرتابُ",60,"ب",1,0],["ولكل شيء آفة","تأتيه بالأمر المفاجي",61,"ج",2,0],["ولِكُلِّ ما تَأْبى وتَهْ","وى إن صَبَرْتَ مَدىً ومُدَّةْ",62,"د",2,0],["ولكلّ مَلْكٍ منهُما","متسلّم يأتي مُقدّمْ",63,"م",1,0],["ولكلِّ جسمٍ في النحول بليَّةٌ","وبلاءُ جسمي من تفاوتِ همّتي",64,"ي",1,0],["ولكل حي أسوة بمحمد","ومحمد ذو الموقف المحمود",65,"د",1,0],["ولكلّ ملبوسٍ جديدٍ لذّةٌ","والسقم ثوبٌ لا يلذُّ جديده",66,"د",2,0],["وَلِكُلِّ ساعٍ سُنَّةٌ مِمَّن مَضى","تَنمى بِهِ في سَعيِهِ أَو تُبدِع",67,"ع",1,0],["ولكلِّ شيءٍ في الوُجودِ حقيقَةٌ","ضَمِنَتْ خفِيَّ السِّرِّ بالطَّيَّاتِ",68,"ت",1,0],["ولكل عصر دولة وسياسة","تجري الأمور بها على الإيثار",69,"ر",1,0],["ولكلّ من أسدى الجميلَ سوى","مسدي الجَميل إليكُمُ أجرُ",70,"ر",1,0],["ولكلٍّ رأيت منه مقاما","شرحه في الكتاب مما يطول",71,"ل",1,0],["ولكلِّ ما عَثَرَتْ بهِ مِن هَفْوةٍ","في كلِّ تاريخٍ تَعُمُّ المَغفِرهُ",72,"ر",2,0],["ولكُلِّ معُتَرِضٍ علينا مِنَّهٌ","إن كانَ يدَحضُهُ بقولٍ مُلزِمِ",73,"م",1,0],["ولكلِّ والٍ كارِهٌ من دونهِ","فلهُ الوِدادُ مُخصَّصاً ومُعمَّما",74,"م",2,0],["ولكُلِّ شَهْوةِ راغبٍ شِبَعٌ سِوَى","من يَشتَهيهِ فإنَّهُ لا يَشبَعُ",75,"ع",1,0]]}