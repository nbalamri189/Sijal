{"poems":[[75,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[90,"ألا من مبلغ عني زنيما","https://www.aldiwan.net/poem44393.html","الوافر"],[4,"قامت تشكى إلي الموت مجهشة","https://www.aldiwan.net/poem21221.html","البسيط"],[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[35,"فإن تزجريني عنك خيفة كاشح","https://www.aldiwan.net/poem26014.html","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10326","الوافر"],[186,"شهم مضى عن بني الشماع مرتحلا","https://www.aldiwan.net/poem61169.html","البسيط"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[411,"فإن تزرني أزرك أو إن","https://www.aldiwan.net/poem49636.html","مخلع البسيط"],[567,"يقول ذاك الفتى العسال حين مضى","https://www.aldiwan.net/poem52626.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31503","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122475","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17672","الطويل"],[4691,"أميلة","https://www.poetsgate.com/ViewPoem.aspx?id=200688",""],[4954,"ألْمَحتُ بَدْرًا","https://www.poetsgate.com/ViewPoem.aspx?id=207791",""],[5770,"قم حي غزة","https://www.poetsgate.com/ViewPoem.aspx?id=178369",""],[5973,"أنين الروح","https://www.poetsgate.com/ViewPoem.aspx?id=13209",""],[186,"هذا الغريب الذي أبكي دمشق وقد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55851&r=&rc=114",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""]],"verses":[["فَإِنَّ تَزَوُّدَهُ لِلمَعالي","وَإِنَّ تَأَهُّبَهُ لِلأَجَلّ",0,"ل",1,0],["فإن تزد النبيح نزدك زجراً","وهل قدر النوابح غير زجر",1,"ر",1,0],["فَإِن تُزادي ثَلاثاً تَبلُغي أَمَلاً","وَفي الثَلاثِ وَفاءِ لِلثَمانينا",2,"ن",2,0],["فانتزعنا الغُصوبَ من غاصبيها","فحبا صادقٌ بها مصدوقا",3,"ق",2,0],["فَإِن تَزعُميني كُنتُ أَجهَلُ فيكُم","فَإِنّي شَرَيتُ الحِلمَ بَعدَكِ بِالجَهلِ",4,"ل",1,0],["فَإِن تَزجُريني عَنكِ خيفَةَ كاشِحٍ","بِحالي فَإِنّي ما عَلِمتُ كَئيبُ",5,"ب",1,1],["فَإِن تَزدَد لَهُنَّ فَزِد قَليلاً","وَبِنتُ الأَربَعينَ مِنَ الرَزايا",6,"ي",2,0],["فَإِن تَزُر قَبرَهُ يا مَن يؤرِّخُهُ","فَقُل عَلَيكَ الرِّضَى يا قَبرَ يَعقوبِ",7,"ب",1,0],["فَإِن تَزاوَجَ هُم نارُهُ اِضطَرَمَت","بِغَيثِ إِسعافِهِم تُطفي حَرارَتُهُ",8,"ت",2,0],["فإنْ تزُرْني أزُرْكَ أو إنْ","تقِفْ ببابي أقِفْ ببابِكْ",9,"ك",1,1],["فإن تَزُرْ تُربَتي يا مَن يؤرِّخُها","أُكتُبْ بها اختارَ عبد اللهِ مَولاهُ",10,"ه",1,0],["فانتزع الأملاك من أيدينا","بغير شاهد له علينا",11,"ن",2,0],["فَإِن تَزعُمي أَنّي جَبُنتُ فَإِنَّني","أَفِرُّ وَأَرمي مَرَّةً كُلَّ ذلِكِ",12,"ك",1,0],["فإن تزِدِ انتِقَاداً غَيرَ هَذا","أزدكَ على السَّواءِ بِلاَ انقِطَاعِ",13,"ع",1,0],["فاِنتَزَع البين أيّما مهج","يبرق فيها الأَسى فيرعدها",14,"د",3,0],["فَإِن تَزجُراني يا اِبنَ عَفّان اِنزَجِر","وَإِن تَترُكاني أَحمِ عِرضاً مُمَنَّعا",15,"ع",2,0],["فإن تزِني عشاقك ِ اليوم كلّهم","بأول دمعاتي عليهم سأرجحُ ؟!",16,"ح",1,0],["فإنْ تزْعُمي سِحْرا فإنّي وخالِقي","بريءٌ،فمنْ يأْتِيه يعْدُ النّواهِيَا",17,"ي",2,0],["فأنتِ زيتونةُ الوادي ونخلتُهُ","إن تعصري الزيتَ أو إن تقطفي الرُطَبا",18,"ب",2,0],["فأنت زنبقةٌ..لو أنَّ رقَّتها","سرَت إلي قلبِك الأقسي من الحجر",19,"ر",1,0],["فإن تزر تربه يا من يؤرخه","أكتب دعا الله إبراهيم فامتثلا",20,"ل",2,0],["فإنْ تَزُرْهُ يَلُحْ مِن فرط غبطتِهِ","كأنه ناسكٌ في حال إشراقِ",21,"ق",1,0]]}