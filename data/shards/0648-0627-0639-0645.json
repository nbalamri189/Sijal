221","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66219","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204309","المنسرح"],[4755,"دَعِينِي _ وصنعاءُ تَحتَ الحِصارْ _","https://www.poetsgate.com/ViewPoem.aspx?id=184228",""],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[4767,"ذهب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=180947",""],[4767,"نشوة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=198112",""],[4797,"الموت تالي العمر والدنيا مقيل","https://www.poetsgate.com/ViewPoem.aspx?id=174649",""],[4926,"وحَّد إلهك لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""],[2177,"عش ما تشاء فغاية الأحياء","https://www.poetsgate.com/ViewPoem.aspx?id=127081",""],[460,"وكلُّ هوى ً دان عَنِّي زَمانا","https://www.poetsgate.com/ViewPoem.aspx?id=22223",""],[5010,"اِلْحَقْ بِرَكْبِ الْحَقِّ","https://www.poetsgate.com/ViewPoem.aspx?id=190614",""],[5122,"أول كلامي","https://www.poetsgate.com/ViewPoem.aspx?id=24265",""],[5145,"من كان يصبو إلى الأوصاف والغزل","https://www.poetsgate.com/ViewPoem.aspx?id=108227",""],[5160,"نسْوان الدّنا","https://www.poetsgate.com/ViewPoem.aspx?id=183329",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[592,"أدم بالعوال يالطن في الضدان جدا","https://www.poetsgate.com/ViewPoem.aspx?id=128845",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5431,"الصدق","https://www.poetsgate.com/ViewPoem.aspx?id=182989",""],[5431,"وربك رزاق العباد وكافلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=199915",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[1890,"صَرمتْ حبالك بعد وصلك زينبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16446",""],[5943,"أكثرْ من اللذات","https://www.poetsgate.com/ViewPoem.aspx?id=92977",""],[6115,"يالله يامن بامره الشر والخير","https://www.poetsgate.com/ViewPoem.aspx?id=180503",""],[6115,"اسمع الرأي المسدد يالحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=180524",""],[6225,"شكوى وأمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78024&r=&rc=109",""],[6329,"وقفت وقد مد السكون رواقه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82295&r=&rc=18",""]],"verses":[["وَأَعمِدُ لِلأَرضِ الَّتي مِن وَرائِكُم","لِيَرجِعَني يَوماً عَلَيكِ الرَواجِعُ",0,"ع",1,0],["وَأَعْمَلَ فِي الْكَوْمَاءِ حَدَّ حُسَامِهِ","فَخَرَّتْ وَشِيكاً لِلْجَبيِن وَلِلْجَنْبِ",1,"ب",1,0],["وَأَعمَلنا بِها رَأيَ اِبنِ هاني","فَأُلحِقنا بِأَصحابِ الرَقيمِ",2,"م",1,0],["وَأَعْمَلْتَ طِبَّكَ فِيما مَشَى","مِنَ الدَّاءِ فِي جِسْمِهَا السَّالِمِ",3,"م",1,0],["وَأَعمِدُ لِلأَرضِ الَّتي لا ترُدُّها","لِتَرجِعَني يَوماً إِلَيكَ الرَواجِعُ",4,"ع",1,0],["وَاِعمَد إِلى جُلجُلِهِ البَديعِ","فَاِجعَلهُ في عَنزٍ مِنَ القَطيعِ",5,"ع",1,0],["وَأَعمامي رَبيعَةُ وَهيَ رَصَيدٌ","وَأَخوالي بَلَصفَرَ وَهيَ غُلبُ",6,"ب",1,0],["وَأُعمِلُ ذاتَ اللَوثِ حَتّى أَرُدَّها","إِذا حُلَّ عَنها رَحلُها لَم تُقَيَّدِ",7,"د",1,0],["واعمَدْ إذا شئتَ الجِوار إلى الذُرى","إن المكاره أولعتْ بالهابط",8,"ط",1,0],["وإعمالي إليك به المطايا","وقد ضرب الظلام له رواقا",9,"ق",2,0],["وإعمالُنا التفكير في كُلِّ شُبْهةٍ","بها عُجْمَةٌ تُعيي دُهاةَ التراجِمِ",10,"م",1,0],["واعمد إلى البَيْض الصليق الأحمرِ","فرصِّع الجُبنَ بها ودَنِّرِ",11,"ر",1,0],["وَاِعمَل لِكَي تَمضي وَتَبقى رِقَّةً","في مَبسَمٍ أَو نَغمَةً في مَسمَعِ",12,"ع",1,0],["واعملْ كما تأمُرُ الدُّنيا بلا مَضَضٍ","والجمْ شُعوركَ فيها إنَّها صَنَمُ",13,"م",1,0],["وَأَعمَلتُ جُهدي في رِضاكَ مُشَمِّراً","وَمِن دونِ أَن أَفضي إِلَيهِ حِجابُ",14,"ب",1,0],["وَاِعمَلِ الخَيرَ فَإِن عِشتَ لَقي","طَيِّبَ الحَمدِ وَإِن مُتَّ بَقي",15,"ي",1,0],["وَاِعمُروا الأَرضَ فَلَولا","سَعيُكُم أَمسَت يَبابا",16,"ب",2,0],["واعمل لعقباك فالدنيا بأجمعها","ما حزت فاغتنم الإحسان وادخر",17,"ر",1,0],["وَأَعمامي فَقَد عُدُوا قَديماً","مِنَ العُظَماءِ أَهلِ الإِعتِلاءِ",18,"ا",2,0],["وَإِعمالُكَ الحَقَّ المُجَرَّدَ بَينَنا","إِذا عُصبَةٌ مِنّا لِظُلمٍ تَصَدَّتِ",19,"ت",1,0],["واعُمُرا نَوحاً لِفِقدانِهِ","سِيّانِ عَندي شِبتُ أَم مُتُّ",20,"ت",1,0],["وَاِعمَل لِطاعَتِهِ تَنَل مِنهُ الرِضا","إِنَّ المُطيعَ لِرَبِّه لَمُقَرَّبُ",21,"ب",1,0],["وَاعمِد إِلى صِدقِ الحَدي","ثِ فَإِنَّهُ أَزكى فُنونِه",22,"ن",2,0],["وَأَعمى طَرفَ أَعذَرِنا لِحاظاً","وَعَجَّلَ حَتفَ أَسرَعِنا مَلالا",23,"ل",2,0],["واعمُرْ بقصرِ المُلْك ناديكَ الذي","أضحى بمجدك بيته معمورا",24,"ر",2,1],["وأعْمَلتُهُ بَدْراً ولكنْ رَدَدْتُهُ","هلالاً مشى فيه مُحاقُ المَهامِهِ",25,"م",2,0],["واعملْ لتلكَ الدارِ ما هي أهلُهُ","عملَ المداري أهلَ هذي الدارِ",26,"ر",1,0],["واعملْ بما علَّمْتَ فالعلماءُ إنْ","لم يعملوا شجرٌ بلا إثمارِ",26,"ر",1,0],["واعْمَلْ لِربِّكَ لا يَرُعْكَ مُضلَّلٌ","يجفو الإلهَ ويصطفي إبليسا",27,"س",2,0],["وَاعْمَلْ لربِّكَ جَاهِداً لا تَأْلُهُ","دَأَباً فليس يفوزُ من لا يَدْأبُ",28,"ب",1,0],["وَأَعَمَّ منفَعَةً وَأَعظَمَ نائِلاً","لِأَخٍ أَسافَ وَصاحِبٍ مُحتارِ",29,"ر",1,0],["وَأَعملَتني رِجالٌ في مَآرِبِها","كَأَنَّني جَملٌ لِلإِنسِ أُبريتُ",30,"ت",1,0],["وَأَعمارُنا أَبياتُ شِعرٍ كَأَنَّما","أَواخِرُها لِلمُنشِدينَ قَوافي",31,"ف",2,0],["وَأَعمارُ الَّذينَ مَضَوا صِغاراً","كَأَثوابٍ بَلينَ وَما لُبِسنَه",32,"ن",2,0],["وأَعْمَدُ مِنْ قَوْمٍ كَفَاهُمْ أَخُوهُمُ","صِدَامَ الأَعَادِي حَيْثُ فُلَّتْ نُيُوبُهَا",33,"ه",2,0],["وأعْمى أتاهُ بالحجازِ نَثاهُمُ","وكانَ بأطرافِ الجِبالِ فأسْهَلا",34,"ل",2,0],["وَاعُمَرَا أَسَامِعٌ يَوْمَ النَّوَى","آهَة مِصْرٍ وَأَنيِنَ الْوَادي",35,"د",2,0],["وَاعْمَلْ بِجُهْدِكَ ما اسْتَطَعْتَ","فَلَنْ تَفُوزَ بِغَيْرِ جُهْدِ",36,"د",1,0],["وأعمى أتاه باحجاز نثاهم","وكان بأطراف الجبال فأسهلاَ",37,"ل",2,0],["واعمر خراب النفس يا","بنَ الشمس بالأمل الوطيد",38,"د",1,0],["واعمد الى (الجوف) واستظهر أسافلها","أرض لعامر أهل الفضل أوطان",39,"ن",1,0],["واعمل لدار ٍغداً رضوانُ خازنها","والجار احمد والرحمن ناشيها",40,"ي",3,0],["وأعمالٌ مشرِّفةٌ ذويها","تولاَّها فضيَّعها الخفاء",41,"ا",2,0],["وأعمامي \" ربيعة ُ \"و هيَ","صيدٌ وَأخْوَالي بَلَصْفَر وَهْيَ غُلْبُ",42,"ب",1,0],["وأعمر الدهر بها المَشاهدا","عُمرانَ تالي السُّور المساجدا",43,"د",2,0],["وأعملت اقلامي بها عربية","فلم تبد أصغاء لها وسماعا",44,"ا",1,0],["وَأَعمل لِوَجه واحد","يَكفيك كُل الأَوجهِ",45,"ه",1,0],["واعمل بشرع الب شامخ همة","فهي المرؤة اصلها الايمان",46,"ن",1,0],["واعمل بجفوة من جفا","وزد الوفاء لمن وفا",47,"ف",2,0],["واعمل بشأنك يا كرار إن يدي","مدت إليك وحاشا ترتضي خجلي",48,"ل",2,0],["واعمل له واصدق به وكل ال","أمور لفضله تسلم من الأيام",49,"م",1,0],["وأعمال يحال العقل فيها","وأصوات كتصهال البغالِ",50,"ل",1,0],["وَأَعَمَّ مِن كَعبِ اِبنِ مامَةَ نائِلاً","وَأَعَزَّ مِن زَيدِ الفَوارِسِ جارا",51,"ر",2,0],["وَأَعمَلتَهُ وَاِطَّرَحتَ الرِماحَ","لِما في عَوامِلِها مِن خَطَل",52,"ل",1,0],["واعملي بالرأي حيناً","واتركي حكم الجُموحِ",53,"ح",1,0],["واِعمل بقول الأَوَّلِ","الضَيفُ ربُّ المَنزلِ",54,"ل",1,0],["وأَعمى لقد ضلَّ القوافي منيرةً","ولم ير إِلا كلَّ قافيةٍ عورا",55,"ر",2,0],["وأعمل كاسها إن تلق راحا","ونزهها عن الماء القراح",56,"ح",1,0],["واعمالهم تجري على وفق سابق","لهم عنده والختم عند الأولية",57,"ه",1,0],["واعمر بأوراد العبادة عمرك ال","فاني وساعات الزمان المزمع",58,"ع",1,0],["واعمل لنفسك صالحاً","تنجو به من كل شر",59,"ر",1,0],["وأعمال بر لا يخل زمانها","فغن انخرام الخير منبع خسران",60,"ن",1,0],["وَإِعمالِ الَّذي يُنجي وَيُنمي","بِوُسعٍ وَالفِرارُ مِنَ الشواظِ",61,"ظ",1,0],["وَاِعمُم بِها ثَمادَها وَفَلَّها","إِنَّ خُيولي صادَفَت مَحَلَّها",62,"ل",3,0],["وأعمى العواطف شيطانُها","غويُّ الهوى عبقريّ النزَق",63,"ق",1,0],["وأعمى عن الأفق الذي كنت شمسَه","وأُنكِرُ نفسي حين يحزنُها العمى",64,"م",2,0],["وَاِعمَل عَلى ما يَقتَضي","عِلمُكَ فيما دِنتَ بِه",65,"ب",2,0],["وَاِعمَل بِمَسنونِ الهَوى في مِلَّتي","وَاِرفُض فُروضَ غَيرِها مِنَ المِلَل",66,"ل",1,0],["وأُعْمِيَتْ عنك عَيْنُ دَهرٍ","خُطوبُه تَنْتقي بَنيه",67,"ي",2,0],["واعْمُرُ فؤاداً أنت نازلُ سِرِّهِ","فسِواهُ من صَفْوِ الولاء خراب",68,"ب",1,0],["واعمَل عَلى أيما مُهِمٍّ","أوجَبَ أن تَكتَري رَسولا",69,"ل",2,0],["واعمل لاخراك اعمالا حسان","يرضى بها عنك رب العالمين",70,"ن",1,0],["واعمل بعلمك لتحظى بالثواب بالجسيم","وانصح وعلم ففي التعليم فضل عظيم",71,"م",1,0],["واعمر القطر بوال عادل","يبسط العدل ويقهر للطغام",72,"م",1,0],["واعملن بالعلم تظفر بالوطر","لا تظن العلم إحسان المقال",73,"ل",1,0],["واعملن بالعلم تدعى عالما","وبه تسعد وترقى للكمال",74,"ل",1,0],["وأعمال وأقوال وأشيا","علمت بها وأشيا لست أدري",75,"ر",2,0],["واعمل لنفسك أعمالا لا تسر بها","فكل ما يفعل الإنسان محسوب",76,"ب",1,0],["واعمل بما علمت إن علمنا","يزدك رب منه ما أملنا",77,"ن",2,0],["وأعمَّهم جُوداً إذَا","جادُوا وأكثَرَهم نَوالاَ",78,"ل",2,0],["وأعْمَلَتِ الأهواء فيه كما اشتَهَتْ","فلا دَخَلَتْه بعد هذا العوامل",79,"ل",1,0],["وأعمار تناكَصُ بانتقاص","وآمال تهافت بازدياد",80,"د",1,0],["وأَعْمَرْتَ مِنَّا فِي ذَرَاكَ منازِلاً","تَفَقَّدْتَ مَثْواها وأَرْغَدْتَ نُزْلَها",81,"ل",3,0],["واعمرْ بساعاتِ السرور ساعةً","تُتبعُ برءَ سكرةٍ بنكسِ",82,"س",1,0],["وأعمّ حين يخصّ جو","دُ الغيث ساحاً بعد ساحِ",83,"ح",1,0],["وأعمَلَ يأتمُّهُ كالظليمِ","حثيثاً فعادَ بِلا مَوْرِدِ",84,"د",1,0],["وأعملَتِ الكؤوسُ فقالَ قومٌ","بدا لالأؤها لهم فحاروا",85,"ر",3,0],["واعمل بعلمك ما يجديك آخرة","تستثمر الغرس عند المربع الخصب",86,"ب",1,0],["واعمل لدنياك ما يجديك آخرة","ليس اللبيب على الدنيا بمقتصر",87,"ر",1,0],["واعمل بنهج ابن الرفاعيِّ الذي","عن جدِّهِ النبيِّ قام نائبا",88,"ب",2,0],["واعمل بسر كلام المصطفى فيه","أخبار حقٍّ عن الجبار يرويها",89,"ي",3,0],["وأَعملْتُ العَزيمَةَ جهدَ طَوْقي","عَسى عَيْني بناظِرِها ترَاكِ",90,"ك",1,0],["واعْمي عن الوُجودِ إِلاَّ عنْهُم","وشارفي جَمالَهُمْ لِتُفلِحي",91,"ح",2,0],["واعملْ بنُصحِ كتابِ اللهِ معتَقِداً","نُصوصَهُ فهو حقًّا أَشرَفُ الكُتُبِ",92,"ب",1,0],["وأُعملُ الدَّيْنَ في الرّقابِ","فيَنْضَجُ اللّحمُ بالجراحِ",93,"ح",1,0],["واعملوا أني شغفت بكم","وأنا من جملة الخدم",94,"م",1,0],["وأعمام وأخوال","وآباء وأولاد",95,"د",1,0],["واعملوا ما شئتموه ههنا","كل قول هو منكم مثل ريح",96,"ح",1,0],["واعمْ بأنَّ عليكَ العارَ تَلْبَسُهُ","من عَضَّةِ الكلبِ لا من عضَّةِ الأسَدِ",97,"د",1,0],["واعملْ بعلِمِكَ إنَّهُ","من دُونِ ذلكَ كالعَدَمْ",98,"م",1,0],["واعمُرْ لِنَفْسِكَ في العُلاَ","حَالاً وَكُنْ حَسَنَ العِمَارَهْ",99,"ر",2,0],["واعمل على السنة والككتاب","واقض بفصل الحق والصواب",100,"ب",1,0],["وأعمل هديت اليعملات بغزوهم","وأرهبهمو بالصافنات الصلادم",101,"م",1,0],["وأعمال ونيات وقصد","على الإخلاص يحرص بالكمال",102,"ل",1,0],["وأعمالاً تقارنه فإما","بخير قارنت أو سوء حال",102,"ل",1,0],["وَأَعَمُّها بِسِجالِها","وَأَضَنُّها بِدِمائِها",103,"ا",3,0],["واعمَد لِسابِق حَلبَةٍ قد بذَّها","واسمَح بسابِق عِزَّةٍ بَذّاذ",104,"ذ",1,0],["وأعمى عيون العلم من كل ناظر","ومن غير غيري غار كل مغاير",105,"ر",1,0],["وَاِعمِد إِلى ما أَنا مِنهُ واصِفُ","فَإِنَّني بِالطَيِّباتِ عارِفُ",106,"ف",1,0],["وَأَعمرُ الصحراءَ في مأتمٍ","عُمَّارُهُ آلفُ عُمَّار",107,"ر",1,0],["وأعمل حدود اللَه في كل حائدٍ","عن الحق لا تثنيك لومةُ لائم",108,"م",1,0],["واعمَل بقول ناصحٍ خابرٍ","طبعُ خسيسٍ حازَ كلَّ الشَّنار",109,"ر",1,0],["واعْملْ فحرفُ الشَّرط صُنعُك والرَّدى","عنه جوابٌ وهو جازٍ جازمُ",110,"م",1,0],["واعملْ لأيامك الدنَّيةِ","أعمالاً وللآخرات أعمالا",111,"ل",2,0],["وأعمدة تجللها سماء","من الياقوت يكسوها ضبابُ",112,"ب",1,0],["وَاعمل لِمَا يُصلِحُها دائِماً","واستَأصِلِ الدَّاءَ فَأَنتَ الهُمام",113,"م",1,0],["وَاعمُرِ العُمرَ بالتُّقَى وَتَجنَّب","سَيئَاتٍ مَآلُها حَسَراتُ",114,"ت",1,0],["واعمر رباع السرور مجتهدا","عمرك إلا تفارق العمرا",115,"ر",2,0],["وأعمل السيف في أعناقهم فلذا","بادوا وفاعل فع