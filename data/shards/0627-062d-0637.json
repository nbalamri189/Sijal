{"poems":[[66,"رأيت ربي بعنين قلبي","https://www.aldiwan.net/poem67659.html","مخلع البسيط"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[87,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[47,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[63,"طرقنا أبا عامر موهنا","https://www.aldiwan.net/poem51507.html","المتقارب"],[63,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[60,"رأيت ربي بعين قلبي","https://www.aldiwan.net/poem31117.html","مجزوء البسيط"],[51,"يا رب أرجوك لا سواك","https://www.aldiwan.net/poem62204.html","مجزوء البسيط"],[46,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[76,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[309,"يا ربنا يا ربنا","https://www.aldiwan.net/poem16747.html","مجزوء الكامل"],[422,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[454,"أبا خليفة إن الطبع غلاب","https://www.aldiwan.net/poem981.html",""],[463,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[466,"يا راكب الوجناء فاق ذميلها","https://www.aldiwan.net/poem15913.html","الكامل"],[469,"تجاوز دنيات العجيل وجهله","https://www.aldiwan.net/poem3301.html","عموديه"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101989","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64520","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64476","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141327","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109449","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47117","الكامل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105408","الوافر"],[2731,"","https://poetry.dctabudhabi.ae/diwan/poem/102023","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200753","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97998","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118754","الوافر"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105116","الوافر"],[4691,"سلام لغيداء","https://www.poetsgate.com/ViewPoem.aspx?id=216014",""],[4755,"مِلْ أَيُّها المَاءُ واكْبَح سَوْرَةَ الحُطَمَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=197775",""],[4984,"تقاعد","https://www.poetsgate.com/ViewPoem.aspx?id=191623",""],[4119,"تفي بضمانها البيض الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=16114",""],[5055,"مآثر","https://www.poetsgate.com/ViewPoem.aspx?id=100739",""],[5187,"للصبر حدرد","https://www.poetsgate.com/ViewPoem.aspx?id=29248",""],[5376,"بنو قومي أنا منهم وأنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=197598",""],[5411,"(مَدَد)","https://www.poetsgate.com/ViewPoem.aspx?id=186138",""],[5419,"للكبار فقط","https://www.poetsgate.com/ViewPoem.aspx?id=32270",""],[5431,"طعم معسّل...","https://www.poetsgate.com/ViewPoem.aspx?id=213991",""],[5436,"عراق ما بين الأزل والأبد/إسماعيل الصياح","https://www.poetsgate.com/ViewPoem.aspx?id=128302",""],[5490,"ملك البيان","https://www.poetsgate.com/ViewPoem.aspx?id=176292",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[6149,"شهدت ليس الشهد غير ريقه","https://www.poetsgate.com/ViewPoem.aspx?id=169627",""]],"verses":[["أَحَطتَ عِلماً بِكُلِّ شَيءٍ","فَكُلُّ شَيءٍ أَراهُ أَنتَ",0,"ت",1,0],["أَحَطتَ بَينَهُما بِالسِرِّ وَاِنكَشَفَت","لَكَ الخَزائِنُ مِن عِلمٍ وَمِن حِكَمِ",1,"م",1,0],["أَحَطتَ مِنَ المَوتى قَديماً وَحادِثاً","بِما لَم يُحَصِّل مُنكِرٌ وَنَكيرُ",2,"ر",1,0],["أَحَطتَ بِهِ قَهراً فَلَمّا مَلَكتَهُ","أَحَطتَ بِهِ مَنّاً عَلَيهِ وَنائِلا",3,"ل",2,0],["أَحَطْنا لَدَيْهِ بذي أربعٍ","من الصُّفْرِ أبدَعَهُ حاذِقُ",4,"ق",1,0],["أَحطْتَ بها الأسنَّةَ لامعاتٍ","فهنَّ على ترائِبها عُقودُ",5,"د",1,0],["أَحَطتَ عِلماً بِكُلِّ شَيءٍ","فَكُلُ شَيءٍ أَراهُ أَنتا",6,"ت",2,0],["أَحَطتَ عِلماً بِنا جَميعاً","أَنتَ تَرانا وَلا نَراكا",7,"ك",2,0],["أَحَطتَ بِالحَزمِ حَيزوماً أَخا هِمَمٍ","كَشّافَ طَخياءَ لا ضَيقاً وَلا حَرَجا",8,"ج",2,0],["أَحَطتَ بِهِ حَصرَ الإِحاطَةِ مُضعِفاً","تُزَلزِلُ مِن أَركانِهِ وَتُضَعضَعُ",9,"ع",1,0],["أَحَطتَ عِلماً سَيِّدي","مِمّا تَقاصى وُدُّنا",10,"ن",2,0],["أحطنا به وهو المحيط حقيقة","بنا فتعالى أن نحيط به خُبرا",11,"ر",2,0],["أحطتني بسوار الود تكرمة","فالحب والصدق والإخلاص جذاب",12,"ب",1,0],["اُحطط ببيت أبي قوامٍ فالتبس","بالليث في أشباله وعرينهِ",13,"ن",2,0],["أحْطط بكرخ الزَّاب رحلك انها","بأبي المُهنَّد خيرُ منْزلِ نازلِ",14,"ل",1,0],["أحطُّ على مأكولهِ من ذنابةٍ","وانقل فيهم للحديث من النمل",15,"ل",1,0],["أحطت بهذا الدين حوطة حافظ","فكنت وهذا الدين قلباً وأضلعا",16,"ع",2,0],["احطتَ بخَطبي يا محيط وما انطوى","عليه عدائي من حبائل هلكتي",17,"ي",1,1],["أحطني حياتي يا محيط من البلا","ء في الدين والدنيا ومن شؤم زلتي",17,"ي",1,0],["احطت وأحصيت الوجود وما به","فما أفلت الاحصاء مثقال ذرة",18,"ه",1,0],["أحطّ شعوب الأرض تطّلب العلى","وتدفع عنها الجور والذلّ والرّقّا",19,"ق",2,0],["أَحط أمط اقبض ابسط نُط أَبح أَجرِ","أَفِد أَفت ارفِد اخفِض ارفَع انهَ مُرِ",20,"ر",1,0],["أحطت به علماً وأحسنت وصفه","كما أنني أوسعت أهل الندى شكرا",21,"ر",2,0],["أَحَطْتُ بما بعثتَ إليّ خُبْراً","من الصُّوَرِ المُدَارةِ كالقِلاَدَة",22,"د",2,0],["أحطت من العلوم بكل فن","بديع والعلوم على فنون",23,"ن",1,0],["أحطت على علم وحلم ونائل","كما حزت معروفا مجداً وسؤددا",24,"د",2,0],["أحطمهم باللطف إما تغالظوا","فلطفي أقوى من غلاظة معشري",25,"ي",1,0],["أحطت إلا العتب منها ملفقاً","وإلا اعتذاري في هوان ذليل",26,"ل",1,0],["أحطت بكل شيءٍ رب علماً","فإنك أنت علاّم الغيوب",27,"ب",1,0],["أحطت بكل تكييف وحد","ولست تحاط تكييفا وحدا",28,"د",2,0],["أحطت بما لم نحط أنت خضرٌ","إليك اهتدت مهجة الأنبياء",29,"ا",2,0],["أَحَطُّ مِن كُلِّ عَبدٍ: مَن يَلُوذُ بهِ","وأَقبَحُ الناسِ ظُلمًا: عاشِقٌ الظَّلَمَة",30,"م",2,0],["أحْطُطْ رحالك لا تندم فرب غد","باق يحقق ما استهواك في السفر",31,"ر",1,0],["أحطت بهم فكان القتل صبرا","ولا طعن هناك ولا طراد",32,"د",1,0],["أحط الرحل فالطارق أمد أوثاق","وأرسم فالصخور آمال مقداحي",33,"ح",2,0],["أُحطِّمُ الكِبرَ حينَ يَغْدو","خَناجِرَ المَوتِ للعِبادِ",34,"د",1,0],["أحطُّ وحيث ما كانوا بأرض ٍ","أطيرُ إذا الى العلياءِ طاروا",35,"ر",3,0],["أَحَطْتَ بِعِلْمِكَ في كُلّ أَمْرٍ","خَلَقْتَ الْحَياةَ خَلَقْتَ احْتِضارا",36,"ر",2,0],["أحطتُ بما لم تحط يا صديقي","ففي الدمع قلبُ الوجود انخرطْ",37,"ط",1,0],["أحطُ به فراشا مستهاما.","فيعلق بي رحيقا ليس أحلى",38,"ل",2,0],["أحَطتَ زَورائىَ الجَذلى بِمُجْدِبَةٍ","فَصارَ جُرحي فُراتاً سائغاً خَضِلا",39,"ل",2,0],["أحطتَ بما ليس للسابقينَ","وأوتيتَ من أفصح القول قيلا",40,"ل",2,0],["أحطنا به وهو المحيط حقيقة","بما لا تحيط العالمون به طرا",41,"ر",2,0],["أحطت بالأفلاك علما فارتمى","عن شأوها منتعلا سماكها",42,"ك",3,0]]}