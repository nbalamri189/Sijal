{"poems":[[64,"رأيت ربي بعنين قلبي","https://www.aldiwan.net/poem67659.html","مخلع البسيط"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[61,"طرقنا أبا عامر موهنا","https://www.aldiwan.net/poem51507.html","المتقارب"],[61,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[58,"رأيت ربي بعين قلبي","https://www.aldiwan.net/poem31117.html","مجزوء البسيط"],[49,"يا رب أرجوك لا سواك","https://www.aldiwan.net/poem62204.html","مجزوء البسيط"],[44,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[305,"يا ربنا يا ربنا","https://www.aldiwan.net/poem16747.html","مجزوء الكامل"],[417,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[450,"أبا خليفة إن الطبع غلاب","https://www.aldiwan.net/poem981.html",""],[459,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[462,"يا راكب الوجناء فاق ذميلها","https://www.aldiwan.net/poem15913.html","الكامل"],[465,"تجاوز دنيات العجيل وجهله","https://www.aldiwan.net/poem3301.html","عموديه"]],"verses":[["أَحَطتَ عِلماً بِكُلِّ شَيءٍ","فَكُلُّ شَيءٍ أَراهُ أَنتَ",0,"ت",1,0],["أَحَطتَ بَينَهُما بِالسِرِّ وَاِنكَشَفَت","لَكَ الخَزائِنُ مِن عِلمٍ وَمِن حِكَمِ",1,"م",1,0],["أَحَطتَ مِنَ المَوتى قَديماً وَحادِثاً","بِما لَم يُحَصِّل مُنكِرٌ وَنَكيرُ",2,"ر",1,0],["أَحَطتَ بِهِ قَهراً فَلَمّا مَلَكتَهُ","أَحَطتَ بِهِ مَنّاً عَلَيهِ وَنائِلا",3,"ل",2,0],["أَحَطْنا لَدَيْهِ بذي أربعٍ","من الصُّفْرِ أبدَعَهُ حاذِقُ",4,"ق",1,0],["أَحطْتَ بها الأسنَّةَ لامعاتٍ","فهنَّ على ترائِبها عُقودُ",5,"د",1,0],["أَحَطتَ عِلماً بِكُلِّ شَيءٍ","فَكُلُ شَيءٍ أَراهُ أَنتا",6,"ت",2,0],["أَحَطتَ عِلماً بِنا جَميعاً","أَنتَ تَرانا وَلا نَراكا",7,"ك",2,0],["أَحَطتَ بِالحَزمِ حَيزوماً أَخا هِمَمٍ","كَشّافَ طَخياءَ لا ضَيقاً وَلا حَرَجا",8,"ج",2,0],["أَحَطتَ بِهِ حَصرَ الإِحاطَةِ مُضعِفاً","تُزَلزِلُ مِن أَركانِهِ وَتُضَعضَعُ",9,"ع",1,0],["أَحَطتَ عِلماً سَيِّدي","مِمّا تَقاصى وُدُّنا",10,"ن",2,0],["أحطنا به وهو المحيط حقيقة","بنا فتعالى أن نحيط به خُبرا",11,"ر",2,0],["أحطتني بسوار الود تكرمة","فالحب والصدق والإخلاص جذاب",12,"ب",1,0],["اُحطط ببيت أبي قوامٍ فالتبس","بالليث في أشباله وعرينهِ",13,"ن",2,0],["أحْطط بكرخ الزَّاب رحلك انها","بأبي المُهنَّد خيرُ منْزلِ نازلِ",14,"ل",1,0],["أحطُّ على مأكولهِ من ذنابةٍ","وانقل فيهم للحديث من النمل",15,"ل",1,0]]}