oetry.dctabudhabi.ae/diwan/poem/85073","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85044","المتقارب"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85268","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111470","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135087","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138826",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72464","المتقارب"],[4584,"","https://poetry.dctabudhabi.ae/diwan/poem/141866","الوافر"],[4797,"عليكم الشهر الفضيل يتبارك","https://www.poetsgate.com/ViewPoem.aspx?id=174647",""],[4901,"وحقك إن أدخلتني النار قلت","https://www.poetsgate.com/ViewPoem.aspx?id=186128",""],[5121,"لذيذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=33869",""],[5121,"حَوَاس","https://www.poetsgate.com/ViewPoem.aspx?id=216029",""],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5413,"أفي الله شك فاطر السموات والأرض!!","https://www.poetsgate.com/ViewPoem.aspx?id=201589",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5458,"جيمس ( GMC )","https://www.poetsgate.com/ViewPoem.aspx?id=72389",""],[5736,"احتراق شهي","https://www.poetsgate.com/ViewPoem.aspx?id=208875",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[463,"تمدُّ بالآذانِ والمناخرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60073&r=&rc=129",""]],"verses":[["أما قصورك كلما أنشأتها","فقصورنا عنها من الأدراك",0,"ك",1,1],["أَمّا قُرَيشٌ فَإِنّي غَيرُ تارِكِهِم","حَتّى يُنيبوا مِنَ الغِيّاثِ لِلرَشَدِ",1,"د",1,0],["أَم أَقلَعَ الماءُ فَلا جَدوَلٌ","وَماتَتِ الطَيرُ فَلا شادِيَه",2,"ه",1,0],["اما قريش فكانت في عداوتها","كأنها بخشام طال تصطدم",3,"م",1,0],["اما قصارى الساكتين","عن الحقوق فلا قصارى",4,"ر",2,0],["اما قريضي هذا","فانه نفثات",5,"ت",1,0],["إِمّا قَتيلاً يَخوضُ السَيفُ مُهجَتَهُ","أَو نازِعاً لَيسَ يَنوي عَودَةً أَبَدا",6,"د",2,0],["أَما قائِلٌ لِلشاهِ وَالشاهُ غُرَّةٌ","مُخَبِّرَةٌ عَن مُلكِ غَرشٍ وَكابُلِ",7,"ل",1,0],["أَمّا قُرَيشٌ أَبا حَفصٍ فَقَد رُزِئَت","بِالشامِ إِذ فارَقَتكَ البَأسَ وَالمَطَرا",8,"ر",2,1],["أَما قالَهُ الكوفيُّ في الزُهدِ مِثلَ ما","تَغَنّى بِهِ البَصرِيُّ في صِفَةِ الخَمرِ",9,"ر",1,0],["إِمّا قَتيلاً وَإِمّا هالِكاً","وَالشَيبُ شَينٌ لِمَن يَشيبُ",10,"ب",1,0],["أَما قلت خذني حيث شئت فإنني","إليك وَرَبِّي من بنانك أَطوع",11,"ع",1,0],["أُمٌّ أَقَرَّ اللهُ عَيْنَ الْعُلَى","بِفَرْقَدٍ مِنْهَا تَلا فَرْقدَا",12,"د",2,0],["إمَّا قَتيلاً وإمَّا هَلْكًا","والشَّيْبُ شَيْنٌ لِمَنْ يَشِيبُ",13,"ب",1,0],["إمّا قَرىَ بُرثُنُه نابَهُ","أو ماتَ طيَّانَ ولم يَصرَعِ",14,"ع",1,0],["أما قال فض الله فاه بصخرة","تبدد مما التف في فمه الشملا",15,"ل",2,0],["أما قال فض الله فاك لمنشد","لدى مسجد شعرا ولادف يضرب",16,"ب",1,0],["أما قال يأخذه عدو له ولي","فلم لم تصدق ربنا يا مكذب",16,"ب",1,0],["أما قلتم الأصنام مجلى إلهي","إذا عبدت فالحق فيها محجب",16,"ب",1,0],["أَم إِقامَةُ الحُدودِ وَقَد صي","حَ بِتَعطيلِها بِكُلِّ النَوادي",17,"د",2,0],["أَما قرأوا قرآنهُ وعجائِبه","أَما سَمِعوا أخباره وغرائبه",18,"ه",1,0],["أما قد أطعتكَ في حبهِ","وكنتُ لهُ العبدُ بل أطوعُ",19,"ع",1,0],["أَما قُلوب العاشِقاتُ","فَإِنَّها وَآخجَلتاه",20,"ا",2,0],["أما قرعت أسماعكم بصعاقِها","ونيرانُها أجّت أجيجاً فعجّت",21,"ت",1,0],["أَمَا قنعت وَقَدْ كَلِفَت بِهَضْمِي","وَضَيْمِي دُونَ أَبناءِ البَيانِ",22,"ن",1,0],["أمَّا قَتُولُ التي أهْوى تَدَانِيَهَا","فَدُونَها منْ سرَاةِ الحَيِّ أَقْتَالُ",23,"ل",1,0],["أما قد علمنا والعقول شواهد","بأن انقراض العلم أصل المهالك",24,"ك",1,0],["أَمّا قرَيشٌ فَأَنتَ وارِثُها","تَكُفُّ مِن شَغبِهِم إِذا طَمَحوا",25,"ح",3,0],["أما قالَ فَقِّهْهُ في الدّينِ رَبّ","وعلّمْهُ تأويلَه المُبتَغى",26,"ا",1,0],["آماقُها بيضٌ إذا حصَّلتها","وعيونُها عند التأملِ سودُ",27,"د",1,0],["أما قلتُما لي إذْ وقفْنَا على الحِمَى","نُكرّرُ تَسَّال الرُّبى ونَعُيدُ",28,"د",1,0],["أَما قادَ قابوساً أَسيراً لتبَّعٍ","أَما شَدَّ كَبلاً كعبه أَيُّما شَدِّ",29,"د",1,0],["إما قناةً وقد خاض السنانُ دَماً","أو إصبعا تتلظّى مسَّها عنَمُ",30,"م",1,0],["إما قِرَى النادي الكريم أو فَرُد","دوه على أربابه بالخاطرِ",31,"ر",1,0],["إما قضيت وهل سواي مانع","منها فلست بميت الأحياء",32,"ا",2,0],["أمّا قناتُك يا مَلكَ الملوك فما","زالتْ تردّ نُيوبَ القومِ إذْ عَجَموا",33,"م",3,0],["إمّا قَدَرتَ بِسِرِّها المَكتُومِ","لَيسَ الأَليمُ سِوَى الهَوى بِأَليمِ",34,"م",1,1],["أما قيلَ في الأمثالِ فيما عَلمتَه","إذا أنتَ لَم تَغلِب عَدوَّك فأخلب",35,"ب",1,0],["أما قويقٌ فارتدي بمعصفرٍ","شرِقٍ بحمرتِه الغَداة بياضُهُ",36,"ه",1,1],["أمَّا قريشٌ فَلَن تلقاهم أبَداً","إِلاَّ وهم خيرُ مَن يحفى وَينتَعِلُ",37,"ل",1,0],["أمْ أقَاحٌ فِي شَقِيقٍ","قد سقَاهُ الحسنُ مُزْنَهْ",38,"ن",2,0],["أَما قبلة لي منك أطفي ببردها","من الوجدِ جمراً مُحرقات لواهِبُه",39,"ب",2,0],["أما قيل إن مع العسر يُسْرا","فَلِمْ خانني لي مع العسر يسر",40,"ر",1,0],["إمّا قَتَلْتُمْ أميرَ المؤمنينَ فَلاَ","تَرْجُوا الهَوَادَةَ عندِي آخِرَ الأَبَدِ",41,"د",1,0],["أما قال المسيح دمي اشربوه","فأصبح بعده خمراً تقدس",42,"س",1,0],["أما قصائد قاسم بن هتيمل","فمذاقها أحلى من الصهباء",43,"ا",2,1],["أَما قَتَلتَ دِيارَ الحَيِّ عِرفانا","يَومَ الكُفافَةِ بَعدَ الحَيِّ إِذ بانا",44,"ن",2,1],["أم اقتادك التسليمُ لله طائعاً","مهل طاعةٌ إلاَّ وأنتَ فعولها",45,"ل",3,0],["أم اقتنصت أشراك لحظك بلبلاً","يسبح بين الجنتين الذي أسرى",46,"ر",2,0],["أما قال يوحنا بإنجيله الذي","بأيديهم يتلى دواماً ويُسمع",47,"ع",1,0],["إِمّا قَتيلٌ أَو أَسيرٌ فَلا","يُرثى لِمَن يُقتَلُ أَو يُؤسَرُ",48,"ر",1,0],["أَما قالَ للنعمان شاعر قَومِهِ","لِأَنك شَمس وَالمُلوك كَواكب",49,"ب",1,0],["أَما قال مولانا علىٌّ سلامه","علينا مقالا أَسنَدَتْهُ ثِقاتٌ",50,"ت",1,0],["أما قسيي فهي من ألاءِ","وربما تخذتها من آءِ",51,"ا",2,0],["أما قسيي فمن اليَنبُوت","منها معاش