{"poems":[[77,"أما قصورك كلما أنشأتها","https://www.aldiwan.net/poem35697.html","الكامل"],[23,"أمسى الخلابيس قد عزوا وقد كثروا","https://www.aldiwan.net/poem21404.html","البسيط"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[89,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[89,"في الشعر تحكى الحياة","https://www.aldiwan.net/poem44904.html","المجتث"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[45,"تقضى الصبا إلا تلوم راحل","https://www.aldiwan.net/poem65618.html","الطويل"],[28,"أما قريش أبا حفص فقد رزئت","https://www.aldiwan.net/poem5101.html","البسيط"],[46,"أرى ابن أبي إسحاق أسحقه الردى","https://www.aldiwan.net/poem22645.html","الطويل"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[143,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[161,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[161,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[170,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[190,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[200,"أناديك يا قلب مذ ودعوا","https://www.aldiwan.net/poem45607.html","المتقارب"],[224,"أولا تراهم يرتدون","https://www.aldiwan.net/poem41595.html","مجزوء الكامل"],[271,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[276,"تحيف حالتي حيف الزمان","https://www.aldiwan.net/poem25417.html","الوافر"],[276,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[282,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[323,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[365,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[372,"بركات مولانا عليك تعود","https://www.aldiwan.net/poem57476.html","الكامل"],[403,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[407,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[459,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[459,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[480,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[552,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"]],"verses":[["أما قصورك كلما أنشأتها","فقصورنا عنها من الأدراك",0,"ك",1,1],["أَمّا قُرَيشٌ فَإِنّي غَيرُ تارِكِهِم","حَتّى يُنيبوا مِنَ الغِيّاثِ لِلرَشَدِ",1,"د",1,0],["أَم أَقلَعَ الماءُ فَلا جَدوَلٌ","وَماتَتِ الطَيرُ فَلا شادِيَه",2,"ه",1,0],["اما قريش فكانت في عداوتها","كأنها بخشام طال تصطدم",3,"م",1,0],["اما قصارى الساكتين","عن الحقوق فلا قصارى",4,"ر",2,0],["اما قريضي هذا","فانه نفثات",5,"ت",1,0],["إِمّا قَتيلاً يَخوضُ السَيفُ مُهجَتَهُ","أَو نازِعاً لَيسَ يَنوي عَودَةً أَبَدا",6,"د",2,0],["أَما قائِلٌ لِلشاهِ وَالشاهُ غُرَّةٌ","مُخَبِّرَةٌ عَن مُلكِ غَرشٍ وَكابُلِ",7,"ل",1,0],["أَمّا قُرَيشٌ أَبا حَفصٍ فَقَد رُزِئَت","بِالشامِ إِذ فارَقَتكَ البَأسَ وَالمَطَرا",8,"ر",2,1],["أَما قالَهُ الكوفيُّ في الزُهدِ مِثلَ ما","تَغَنّى بِهِ البَصرِيُّ في صِفَةِ الخَمرِ",9,"ر",1,0],["إِمّا قَتيلاً وَإِمّا هالِكاً","وَالشَيبُ شَينٌ لِمَن يَشيبُ",10,"ب",1,0],["أَما قلت خذني حيث شئت فإنني","إليك وَرَبِّي من بنانك أَطوع",11,"ع",1,0],["أُمٌّ أَقَرَّ اللهُ عَيْنَ الْعُلَى","بِفَرْقَدٍ مِنْهَا تَلا فَرْقدَا",12,"د",2,0],["إمَّا قَتيلاً وإمَّا هَلْكًا","والشَّيْبُ شَيْنٌ لِمَنْ يَشِيبُ",13,"ب",1,0],["إمّا قَرىَ بُرثُنُه نابَهُ","أو ماتَ طيَّانَ ولم يَصرَعِ",14,"ع",1,0],["أما قال فض الله فاه بصخرة","تبدد مما التف في فمه الشملا",15,"ل",2,0],["أما قال فض الله فاك لمنشد","لدى مسجد شعرا ولادف يضرب",16,"ب",1,0],["أما قال يأخذه عدو له ولي","فلم لم تصدق ربنا يا مكذب",16,"ب",1,0],["أما قلتم الأصنام مجلى إلهي","إذا عبدت فالحق فيها محجب",16,"ب",1,0],["أَم إِقامَةُ الحُدودِ وَقَد صي","حَ بِتَعطيلِها بِكُلِّ النَوادي",17,"د",2,0],["أَما قرأوا قرآنهُ وعجائِبه","أَما سَمِعوا أخباره وغرائبه",18,"ه",1,0],["أما قد أطعتكَ في حبهِ","وكنتُ لهُ العبدُ بل أطوعُ",19,"ع",1,0],["أَما قُلوب العاشِقاتُ","فَإِنَّها وَآخجَلتاه",20,"ا",2,0],["أما قرعت أسماعكم بصعاقِها","ونيرانُها أجّت أجيجاً فعجّت",21,"ت",1,0],["أَمَا قنعت وَقَدْ كَلِفَت بِهَضْمِي","وَضَيْمِي دُونَ أَبناءِ البَيانِ",22,"ن",1,0],["أمَّا قَتُولُ التي أهْوى تَدَانِيَهَا","فَدُونَها منْ سرَاةِ الحَيِّ أَقْتَالُ",23,"ل",1,0],["أما قد علمنا والعقول شواهد","بأن انقراض العلم أصل المهالك",24,"ك",1,0],["أَمّا قرَيشٌ فَأَنتَ وارِثُها","تَكُفُّ مِن شَغبِهِم إِذا طَمَحوا",25,"ح",3,0],["أما قالَ فَقِّهْهُ في الدّينِ رَبّ","وعلّمْهُ تأويلَه المُبتَغى",26,"ا",1,0],["آماقُها بيضٌ إذا حصَّلتها","وعيونُها عند التأملِ سودُ",27,"د",1,0],["أما قلتُما لي إذْ وقفْنَا على الحِمَى","نُكرّرُ تَسَّال الرُّبى ونَعُيدُ",28,"د",1,0],["أَما قادَ قابوساً أَسيراً لتبَّعٍ","أَما شَدَّ كَبلاً كعبه أَيُّما شَدِّ",29,"د",1,0],["إما قناةً وقد خاض السنانُ دَماً","أو إصبعا تتلظّى مسَّها عنَمُ",30,"م",1,0],["إما قِرَى النادي الكريم أو فَرُد","دوه على أربابه بالخاطرِ",31,"ر",1,0],["إما قضيت وهل سواي مانع","منها فلست بميت الأحياء",32,"ا",2,0],["أمّا قناتُك يا مَلكَ الملوك فما","زالتْ تردّ نُيوبَ القومِ إذْ عَجَموا",33,"م",3,0]]}