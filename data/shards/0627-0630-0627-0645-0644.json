{"poems":[[53,"أمل من مثانيها فهذا مقيلها","https://www.aldiwan.net/poem29893.html","الطويل"],[30,"تعرفت أطلالا فهاجت لك الهوى","https://www.aldiwan.net/poem29521.html","الطويل"],[37,"إذا ملذ التقريب حاكين ملذه","https://www.aldiwan.net/poem7460.html","الطويل"],[45,"لعمرك ما لإسحاق بن سعد","https://www.aldiwan.net/poem11039.html","الوافر"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[31,"لقد أرسلت نعم إلينا أن ائتنا","https://www.aldiwan.net/poem42622.html","الطويل"],[105,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[46,"بك على الناس بالمزموم والرمل","https://www.aldiwan.net/poem23216.html","البسيط"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[94,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[142,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[160,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[160,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[160,"إليك فلو أدركت مغنى الهوى مغنا","https://www.aldiwan.net/poem59014.html","الطويل"],[169,"أراه الهوى ما لم يكن في حسابه","https://www.aldiwan.net/poem1608.html",""],[186,"إذا ملك الفتى هنا ودنا","https://www.aldiwan.net/poem43205.html","الوافر"],[186,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[204,"لولاك لم يحسن السرور","https://www.aldiwan.net/poem53138.html","مخلع البسيط"],[268,"يفوح كفوح المسك فاغم نشرها","https://www.aldiwan.net/poem69114.html","عموديه"],[303,"إذا ملك الإنسان ثوب قناعة","https://www.aldiwan.net/poem58282.html","الطويل"],[353,"فؤاد على حفظ الوداد مقيم","https://www.aldiwan.net/poem39953.html","الطويل"],[405,"محبتي لك طبع","https://www.aldiwan.net/poem50064.html","المجتث"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[458,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[458,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[461,"إذا ما شكت بيض السيوف ظماءة","https://www.aldiwan.net/poem15172.html","الطويل"],[562,"منازل عسفان فدتك المنازل","https://www.aldiwan.net/poem52753.html","الطويل"],[562,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[562,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[575,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"]],"verses":[["إِذا مَلَكَت ريحُ الجَنوبِ عِنانَها","أَحالَت عَلَيها بَعدَ لَأيٍ قَبولُها",0,"ل",3,0],["إِذا مَلأَت مِنها قَطاةٌ سِقاءَها","فَلا تَنظُرُ الأَخرى وَلا تَستَعينُها",1,"ن",3,0],["إذا ملذ التقريب حاكين ملذه","وإن هو منه آل أُلن إلى النَقْلِ",2,"ل",1,1],["إِذا مَلَأَ الشِعابَ سُيولَ جودٍ","رَأَيتَ مَكارِماً تُرضي الشُعوبا",3,"ب",2,0],["إِذا مُلِئَ الزُجاجُ بِها وَطارَت","حَواشي نورِها في المَشرِقَينِ",4,"ن",1,0],["إِذا مِلتُ مالَت كَالكَثيبِ رَخيمَةٌ","مُنَعَّمَةً حُسّانَةَ المُتَجَلبَبِ",5,"ب",1,0],["إذا مَلأتْ جَوانِبَها دَوِيّاً","فلا تَغْرُرْكَ جَلْجَلَةُ السُّعالِ",6,"ل",1,0],["إِذا مَلَكتَ فَاِسحَج غَيرَ مُهتَضَمٍ","وَإِن حَكَمتَ عَلى قَومٍ فَلا تَمِلِ",7,"ل",1,0],["إذا مَلأَتْهُنّ القَنَا جَبَرِيّةً","وغيْظاً فأوْقَعْنَ الحَفيظةَ باللُّجْمِ",8,"م",1,0],["إذَا مَلِكٌ مِن آلِ جَفنَةَ خَالُهُ","وََأَعمامُهُ آلُ اِمرىءٍ القَيسِ أَزهَرا",9,"ر",2,0],["إذا ملأ الحِقْدُ الصدُورَ، فإنَّني","لأحملُهُ صدرًا من الحقد صافيا",10,"ي",2,0],["إذا ملكوا الدنيا على الحرّ عنوة","ففي نفسه دنيا هي العزّ والكبر",11,"ر",1,0],["إذا ملك الحسناء من ليس كفؤها","أشار عليها بالطلاقِ مُشِرُها",12,"ر",3,0],["إِذا ملكت كف الطلوب عنانه","تساوى قريب عنده وبعيدُ",13,"د",1,0],["إذا ملك الحر امرءا كان مذنبا","فقدرته تنسى وتذهب بالحقد",14,"د",1,0],["إذا ملك ناواك هدمت عزه","وعز تولى هدمه أنت لا يبنا",15,"ن",2,0],["إِذا مَلكٌ راحَ الحطامَ اِكتِسابُهُ","فَإِنَّ العُلا وَالمَجدَ حَبلُ اِكتِسابِهِ",16,"ب",2,0],["إذا ملك الفتى هنّا ودنّا","ومقردة وملفسة وصن",17,"ن",1,1],["إذا ملكت الغنى عنهم وعارضني","دون المطامع يأس مانعي خجلي",18,"ل",2,0],["اذا ملكتُم فلا تتيهوا","وإن حكمتم فلا تجوروا",19,"ر",3,0],["اذا ملح المكاء رجع صغيره","يجاوبه قمريها بمليح",20,"ح",1,0],["إذا ملك الإنسان ثوب قناعةٍ","ترشف كأس العز في الناس سائغه",21,"ه",1,1],["إِذا ملك المَرء اليَسار وَلَم يَكُن","كَفاه كَفاف العَيش فَهوَ مَلومُ",22,"م",1,0],["إذا مِلكٌ لم يكُنْ ذا هِبَةْ","فدعْهُ فدَولَتُهُ ذاهِبهْ",23,"ب",2,0],["إذَا مَلأَ الهَوْلُ المُمِيتُ صُدُورَها","تَحَرَّكَ من ذِكْرَاكَ فِيهَا تَمائِمُ",24,"م",1,0],["إذا ملأت فاه الخطابةُ سَرَّه","وما كلّ آلات الفصيح التشدّقُ",25,"ق",1,0],["إذا مَلَكَ الرقابَ به امترينا","مضى قلمٌ بكفّك أم قضيبُ",26,"ب",1,0],["إذا ملك الدَّثْرَ الجزيل فواهبٌ","وإنْ غنم النَّزر الزهيد فمؤثِرُ",27,"ر",1,0],["إذا ملكَتْ أيدي الهَوى قلبَ عاشقٍ","فأهوَنُ شيءٍ ما تقولُ العَواذِلُ",28,"ل",1,0],["إذا مَلَكَتْ يداهُ الفَلسَ أمسَى","رقيقاً ليسَ يطمَعُ في العَتاقِ",29,"ق",1,0],["إذا مَلأتْ يَداهُ سِجالَ رِفْدٍ","نَراها بالغِنَى كَتَبتْ سِجِّلا",30,"ل",2,0],["إِذا مَلِكٌ جار في حُكْمِه","فسيفُك في رأْسِه عادِلُ",31,"ل",1,0]]}