{"poems":[[55,"أمل من مثانيها فهذا مقيلها","https://www.aldiwan.net/poem29893.html","الطويل"],[32,"تعرفت أطلالا فهاجت لك الهوى","https://www.aldiwan.net/poem29521.html","الطويل"],[39,"إذا ملذ التقريب حاكين ملذه","https://www.aldiwan.net/poem7460.html","الطويل"],[47,"لعمرك ما لإسحاق بن سعد","https://www.aldiwan.net/poem11039.html","الوافر"],[68,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[33,"لقد أرسلت نعم إلينا أن ائتنا","https://www.aldiwan.net/poem42622.html","الطويل"],[107,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[48,"بك على الناس بالمزموم والرمل","https://www.aldiwan.net/poem23216.html","البسيط"],[48,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[108,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[146,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[164,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[164,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[164,"إليك فلو أدركت مغنى الهوى مغنا","https://www.aldiwan.net/poem59014.html","الطويل"],[173,"أراه الهوى ما لم يكن في حسابه","https://www.aldiwan.net/poem1608.html",""],[190,"إذا ملك الفتى هنا ودنا","https://www.aldiwan.net/poem43205.html","الوافر"],[190,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[208,"لولاك لم يحسن السرور","https://www.aldiwan.net/poem53138.html","مخلع البسيط"],[273,"يفوح كفوح المسك فاغم نشرها","https://www.aldiwan.net/poem69114.html","عموديه"],[308,"إذا ملك الإنسان ثوب قناعة","https://www.aldiwan.net/poem58282.html","الطويل"],[358,"فؤاد على حفظ الوداد مقيم","https://www.aldiwan.net/poem39953.html","الطويل"],[411,"محبتي لك طبع","https://www.aldiwan.net/poem50064.html","المجتث"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[463,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[466,"إذا ما شكت بيض السيوف ظماءة","https://www.aldiwan.net/poem15172.html","الطويل"],[567,"منازل عسفان فدتك المنازل","https://www.aldiwan.net/poem52753.html","الطويل"],[567,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[567,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122618","الوافر"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206098","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16749","المتقارب"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16816","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136331","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119216","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53105","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100901","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109798","الوافر"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199462","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132725","الوافر"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/140132",""],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28875","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112302","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62948","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131278",""],[3873,"","https://poetry.dctabudhabi.ae/diwan/poem/143524","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101364","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[5261,"عدلا رجاءً","https://www.poetsgate.com/ViewPoem.aspx?id=213852",""],[5533,"دَرْبُ المَحَبَّة","https://www.poetsgate.com/ViewPoem.aspx?id=183841",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""]],"verses":[["إِذا مَلَكَت ريحُ الجَنوبِ عِنانَها","أَحالَت عَلَيها بَعدَ لَأيٍ قَبولُها",0,"ل",3,0],["إِذا مَلأَت مِنها قَطاةٌ سِقاءَها","فَلا تَنظُرُ الأَخرى وَلا تَستَعينُها",1,"ن",3,0],["إذا ملذ التقريب حاكين ملذه","وإن هو منه آل أُلن إلى النَقْلِ",2,"ل",1,1],["إِذا مَلَأَ الشِعابَ سُيولَ جودٍ","رَأَيتَ مَكارِماً تُرضي الشُعوبا",3,"ب",2,0],["إِذا مُلِئَ الزُجاجُ بِها وَطارَت","حَواشي نورِها في المَشرِقَينِ",4,"ن",1,0],["إِذا مِلتُ مالَت كَالكَثيبِ رَخيمَةٌ","مُنَعَّمَةً حُسّانَةَ المُتَجَلبَبِ",5,"ب",1,0],["إذا مَلأتْ جَوانِبَها دَوِيّاً","فلا تَغْرُرْكَ جَلْجَلَةُ السُّعالِ",6,"ل",1,0],["إِذا مَلَكتَ فَاِسحَج غَيرَ مُهتَضَمٍ","وَإِن حَكَمتَ عَلى قَومٍ فَلا تَمِلِ",7,"ل",1,0],["إذا مَلأَتْهُنّ القَنَا جَبَرِيّةً","وغيْظاً فأوْقَعْنَ الحَفيظةَ باللُّجْمِ",8,"م",1,0],["إذَا مَلِكٌ مِن آلِ جَفنَةَ خَالُهُ","وََأَعمامُهُ آلُ اِمرىءٍ القَيسِ أَزهَرا",9,"ر",2,0],["إذا ملأ الحِقْدُ الصدُورَ، فإنَّني","لأحملُهُ صدرًا من الحقد صافيا",10,"ي",2,0],["إذا ملكوا الدنيا على الحرّ عنوة","ففي نفسه دنيا هي العزّ والكبر",11,"ر",1,0],["إذا ملك الحسناء من ليس كفؤها","أشار عليها بالطلاقِ مُشِرُها",12,"ر",3,0],["إِذا ملكت كف الطلوب عنانه","تساوى قريب عنده وبعيدُ",13,"د",1,0],["إذا ملك الحر امرءا كان مذنبا","فقدرته تنسى وتذهب بالحقد",14,"د",1,0],["إذا ملك ناواك هدمت عزه","وعز تولى هدمه أنت لا يبنا",15,"ن",2,0],["إِذا مَلكٌ راحَ الحطامَ اِكتِسابُهُ","فَإِنَّ العُلا وَالمَجدَ حَبلُ اِكتِسابِهِ",16,"ب",2,0],["إذا ملك الفتى هنّا ودنّا","ومقردة وملفسة وصن",17,"ن",1,1],["إذا ملكت الغنى عنهم وعارضني","دون المطامع يأس مانعي خجلي",18,"ل",2,0],["اذا ملكتُم فلا تتيهوا","وإن حكمتم فلا تجوروا",19,"ر",3,0],["اذا ملح المكاء رجع صغيره","يجاوبه قمريها بمليح",20,"ح",1,0],["إذا ملك الإنسان ثوب قناعةٍ","ترشف كأس العز في الناس سائغه",21,"ه",1,1],["إِذا ملك المَرء اليَسار وَلَم يَكُن","كَفاه كَفاف العَيش فَهوَ مَلومُ",22,"م",1,0],["إذا مِلكٌ لم يكُنْ ذا هِبَةْ","فدعْهُ فدَولَتُهُ ذاهِبهْ",23,"ب",2,0],["إذَا مَلأَ الهَوْلُ المُمِيتُ صُدُورَها","تَحَرَّكَ من ذِكْرَاكَ فِيهَا تَمائِمُ",24,"م",1,0],["إذا ملأت فاه الخطابةُ سَرَّه","وما كلّ آلات الفصيح التشدّقُ",25,"ق",1,0],["إذا مَلَكَ الرقابَ به امترينا","مضى قلمٌ بكفّك أم قضيبُ",26,"ب",1,0],["إذا ملك الدَّثْرَ الجزيل فواهبٌ","وإنْ غنم النَّزر الزهيد فمؤثِرُ",27,"ر",1,0],["إذا ملكَتْ أيدي الهَوى قلبَ عاشقٍ","فأهوَنُ شيءٍ ما تقولُ العَواذِلُ",28,"ل",1,0],["إذا مَلَكَتْ يداهُ الفَلسَ أمسَى","رقيقاً ليسَ يطمَعُ في العَتاقِ",29,"ق",1,0],["إذا مَلأتْ يَداهُ سِجالَ رِفْدٍ","نَراها بالغِنَى كَتَبتْ سِجِّلا",30,"ل",2,0],["إِذا مَلِكٌ جار في حُكْمِه","فسيفُك في رأْسِه عادِلُ",31,"ل",1,0],["إذا مَلِكٌ نأى عني أزوِرارا","نأيتُ بِجانِبي عَنهُ أزوِرارا",32,"ر",2,0],["إذا ملأت منها قطاة سقاءها","فلا تعكم الأخرى ولا تستعينها",33,"ن",3,0],["إِذا مُلتَ مُلتَ قَضيباً رَطيبا","وَإِن صُلتَ صُلتَ قَضيباً قَضوبا",34,"ب",2,0],["إِذا مَلَأَ القِرطاسَ سودُ سُطورِهِ","فَتِلكَ أُسودٌ تُتَّقى وَأَساوِدُ",35,"د",1,0],["إذا ملك الصب الهوى من فواده","فماذا يفيد الصب فيه تمايمه",36,"م",2,0],["إذا ملكها تطليقها","طلقت منه على حسب العدد",37,"د",1,0],["اذا ملائكة النصر اختلطت بها","تشابه العالم النوري والنسم",38,"م",1,0],["إذا ملت عن معنى الغنى بمطالبي","فقد رضيت ذلَّ الغنى عزةُ الشعر",39,"ر",1,0],["إذا ملكَ الجمالُ لنَا قلوباً","فطبعُك رقةً مَلكَ الجَمالا",40,"ل",2,0],["إذا ملئت من البدر العيونُ","وهاجت منه أو سكنت جفونُ",41,"ن",1,1],["إذا ملت عن مجرى الجنوب فبلغي","سلامي مبلول الجناح ابن عبدونِ",42,"ن",1,0],["إذا ملك الهوى قلب المعنى","فأيسر ما يعانيه الملام",43,"م",1,0],["إذا ملكت فأسجح","يستكثر الناس فضلك",44,"ك",1,1],["إِذا مِلنا عَلى الأَكوارِ أَلقَت","بِأَلحِيَها لأَجرنها بَليلُ",45,"ل",1,0],["إِذا مَلأت دَهري الخُطوبُ فإنّهَا","لَتَلقى بِصَدري الرّحبِ مُستَودَعاً رَحبَا",46,"ا",1,0],["اذا مليكٌ زُجِرَتْ طيرُه","كانت له كنيتُه فالَهْ",47,"ل",2,0],["إذا ملك لم يدعم الرأي ملكه","فغاية هذا الملك أن يتهدما",48,"م",2,0],["إذا ملأ البدر العيون فإنه","لعينك بدرٌ يملأ العين والقلبا",49,"ب",2,0],["إذا ملك الانسان رأياً ومزبراً","تمنع عن فتح الملمات حصنه",50,"ن",2,0],["اذا ملت للخيرات ملت وان أمل","الى الشر مالت لى بوفر قواها",51,"ا",3,0],["إذا ملك العباد قوام عز","وغاب العدل، فالخسف الرهيب",52,"ب",1,0],["إذا مَلَلتُ مع الأيَّامِ من قصَصٍ","\"فما الحديثُ عن الأَحْباب مَمْلولُ\"",53,"ل",1,0],["اذا ملك الي تسمعه قبل يسمعك","قطع حبل دلوك حين ماجيت جاذبه",54,"ب",2,0]]}