{"poems":[[65,"تذكر الوصل فارفضت مدامعه","https://www.aldiwan.net/poem46128.html","البسيط"],[74,"قام يرنو بمقلة كحلاء","https://www.aldiwan.net/poem18165.html","الخفيف"],[112,"يمسهّر النوّيم ومحضضّ النوم","https://www.poetsgate.com/ViewPoem.aspx?id=8402",""],[119,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216642",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132745","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216532",""],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132002","الرمل"],[4718,"الله من عين ن نظرها نصايف","https://www.poetsgate.com/ViewPoem.aspx?id=137085",""],[4718,"بدر انا يابوك","https://www.poetsgate.com/ViewPoem.aspx?id=137158",""],[4718,"الصاحب الساحب","https://www.poetsgate.com/ViewPoem.aspx?id=137159",""],[4728,"السعة والضيق","https://www.poetsgate.com/ViewPoem.aspx?id=176886",""],[4760,"رضوى ..","https://www.poetsgate.com/ViewPoem.aspx?id=35826",""],[4802,"ياوسع صدرك","https://www.poetsgate.com/ViewPoem.aspx?id=32342",""],[4866,"خَلك قمر","https://www.poetsgate.com/ViewPoem.aspx?id=127737",""],[4869,"لاتزعج شياطيني","https://www.poetsgate.com/ViewPoem.aspx?id=137913",""],[4869,"بدع التماثيل","https://www.poetsgate.com/ViewPoem.aspx?id=139689",""],[4869,"ياملهمي","https://www.poetsgate.com/ViewPoem.aspx?id=151530",""],[4869,"برد الكرك","https://www.poetsgate.com/ViewPoem.aspx?id=151583",""],[4869,"العيد فرحه واحساس","https://www.poetsgate.com/ViewPoem.aspx?id=151637",""],[4869,"غربه وجن","https://www.poetsgate.com/ViewPoem.aspx?id=151646",""],[4869,"لا ترقع اللي صار","https://www.poetsgate.com/ViewPoem.aspx?id=151663",""],[4918,"حبيبي لا","https://www.poetsgate.com/ViewPoem.aspx?id=31102",""],[4988,"يا خالد","https://www.poetsgate.com/ViewPoem.aspx?id=180736",""],[4988,"نزوحي .. نكهة الحاظر وعبق الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=182912",""],[5012,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=35774",""],[5012,"في ها البحر غرق","https://www.poetsgate.com/ViewPoem.aspx?id=34961",""],[5028,"خلاص يعني","https://www.poetsgate.com/ViewPoem.aspx?id=27711",""],[5118,"تخيُّل","https://www.poetsgate.com/ViewPoem.aspx?id=129800",""],[5122,"حال القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=27775",""],[5370,"كلمة طلال","https://www.poetsgate.com/ViewPoem.aspx?id=87423",""],[5433,"كبوة حصان","https://www.poetsgate.com/ViewPoem.aspx?id=36765",""],[5606,"من قال ذي الحرمه رجل قيل الرجل هذا مره","https://www.poetsgate.com/ViewPoem.aspx?id=198092",""],[5648,"شموخ ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=154830",""],[5648,"يبقا سلام الله لو الجرح ماطاب","https://www.poetsgate.com/ViewPoem.aspx?id=155217",""],[5652,"خلي عيوني بالغلا تذرف دموع","https://www.poetsgate.com/ViewPoem.aspx?id=136101",""],[5652,"ياضيق صدر الشمري وانت غايب","https://www.poetsgate.com/ViewPoem.aspx?id=137150",""],[5652,"معالي / توفيق الربيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177752",""],[5677,"بني عزيز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=179980",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5747,"ياسعود","https://www.poetsgate.com/ViewPoem.aspx?id=61661",""],[5837,"عبدالعزيز القنيدي","https://www.poetsgate.com/ViewPoem.aspx?id=181088",""],[5848,"بديت اختنق","https://www.poetsgate.com/ViewPoem.aspx?id=53326",""],[5848,"البال ما روقه قهوة ولا شاهي","https://www.poetsgate.com/ViewPoem.aspx?id=48888",""],[5936,"اللي تخلى عنك لازم تخليه","https://www.poetsgate.com/ViewPoem.aspx?id=184775",""],[5993,"ودعتك الله والليالي طويله","https://www.poetsgate.com/ViewPoem.aspx?id=186753",""],[6008,"شفت الخبل","https://www.poetsgate.com/ViewPoem.aspx?id=59161",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6100,"اشتقت لأنفاسك","https://www.poetsgate.com/ViewPoem.aspx?id=52589",""],[6115,"خلك هبل واحيان يازين الهبال","https://www.poetsgate.com/ViewPoem.aspx?id=180491",""],[6115,"لايضيق الصدر ولا يعتريه الفزه","https://www.poetsgate.com/ViewPoem.aspx?id=180523",""]],"verses":[["خِلٌّ كَريمٌ وشِعْرٌ سائِرٌ وهَوىً","ثَوى على مُنْحَنى الأضْلاعِ ناصِعُهُ",0,"ع",2,0],["خلِّ كعباً ورُم نداه فما كع","بُ العطايا ورأسها بالسواء",1,"ا",2,0],["خلّك كذا . وضعك حلو وانت ملموم","لاتخسر الهيّه ولا تنتصرها",2,"ر",3,0],["خلك من قوم","بخلهم تاهوا",3,"ا",1,0],["خَلِّكْ مَعِيْ يَا مهدي الجَوّ لونين","فعلاً جمالك نادرٍ عَنْ جداره",4,"ر",2,1],["خل كريم في النوى عهده","وما كرام العهد الا الكرام",5,"م",1,0],["خِلِّك يسوى التواهي","بو عنق وبو دلال",6,"ل",1,0],["خل كأس الراح في حانتها","ليس غير الشعر عندي مسكرا",7,"ر",2,0],["خلك مع القران مثل الولايف","تفزع لك ابوقت الشدايد احروفه",8,"ف",2,0],["خلك على جارك كريم الضلالي","وخلك على بيته اليا غاب حراس",9,"س",1,0],["خلك بعيدٍ عنه مافيه داعي","تعطي وتاخذ منه لو كان سماع",10,"ع",1,0],["خلك من الصمت دون الهرج متشبّع","مثل عرينٍ تخاف الناس من سبعه",11,"ع",2,0],["خلك امواظب وخلك للامام","واعط للدنيا ولو رزقك قليل",12,"ل",1,0],["خلّك رجل عاقل وفاطن لدنياك","كم علمّوا بك غاليينك وملوك",13,"ك",1,0],["خلك قمر، ما بك من القدر تقليل","عال المقام وكلّ عينٍ تعرْفه",14,"ف",2,1],["خلّك على دينك / وببقآ على ديني","وكلٍ يدآري عن الثآني أبآليسه",15,"س",2,0],["خلّك صدوقٍ مآتهمّه بهآذيل","الكذب مآيحقق لقلبك منآوي",16,"ا",3,0],["خلك على ما انته وانا اللي تغنيت","صحيح مزيونن وللعين جذاب",17,"ب",1,0],["خلك ياقمرآي وسط الدرج","بالبرد ما انتي بسهرانه",18,"ن",2,0],["خلّك مثل ما انتي ولا اتهون غرّتك","اغتر فيها الراس واستانس الساس",19,"س",1,0],["خلك كذا انسان بالحس معدوم","والا تذوق من الدواير دواير",20,"ر",1,0],["خلّك على فآلك من يمين ليسآر","متخبطٍ والزين ما اظن يلفتك",21,"ك",1,0],["خلك صبور بطاعته وبحكمة المولى رضي","وانا بدوري بحتسب ربي والازمك الدفى",22,"ف",2,0],["خلّك جبل لا تحزن آ بيوم / عافوك","تبدي لك الأيام ما كان وان فات",23,"ت",1,0],["خلّك من الأسلوب وآسمعني آمنيح","مبعد عن الساحه ومعلن نزوحي",24,"ح",2,1],["خلّك معي يآ هوه واعطيك توضيح","درسك بدآ واللوح يا هيه لوحي",24,"ح",2,0],["خلك على تجريح الاحباب حذري","ماتدري ان الليل ستر المواصيل",25,"ل",1,0],["خلك تشوف الفرق ياجاهل الفرق","عساك تحلم كل يوم بخياله",26,"ل",2,0],["خِلّك يحبّك يا بَعَدْ سِيْد المْلاح","إن رحت عنّه راودنّه مصايب",27,"ب",1,0],["خَلّك معه دام الهوى حيل نضّاح","والواش رِدّه يا هوى البال خايب",27,"ب",1,0],["خلّك / . من الإحساس يا صاحبي بِي","__________ ودّي ..! أحس انّي بلا قلب / . وآطيش",28,"ش",1,0],["خلك لفعل الخير والطيب..سباق","لو كان تنصحني نصيحه مفيده",29,"د",2,0],["خلك على ما قيل في برج عاجي","لو تحترق كل البشر داخلي فيّ",30,"ي",1,0],["خلك بعيد ابعد من العام لليوم","وادنى من احلام النجوم وقمرها",31,"ر",3,0],["خلك رجل والمرجله ماهي بثوب ولاعقال","المرجله تبقى بصفحات الرجال مسطره",32,"ر",2,0],["خلك على حالك بما فيك كلك","عزة شموخي عيت اليوم تقفاك",33,"ك",1,0],["خلك على هذي وهذي صددها","منته بكفوٍ لجل اشارهك بعتاب",34,"ب",1,0],["خلك تعيش الحب ضايق ومقطوع","على امل ترجع وتسعد سنينك",35,"ك",1,0],["خلك على فرقاك تبعد وانا ارجيك","وابكيك حتى يصبح الدمع ذايب",36,"ب",1,0],["خلك كما نجمٍ على العالم إتبين","تصدح ل صوت الحق رد إعتباره !!",37,"ر",2,0],["خلك على خبري متين الجنب صلفٍ ماتهاب","اللي رقى فوق الطوال الشامخة ماهابها",38,"ب",3,0],["خلك كما سيفٍ معلق للجميع","واللي زعل يرجع ليا باح الزعل",39,"ل",1,0],["خلك جمل زومان عند الثقيلات","واصبر على الشدات والخير موعود",40,"د",1,0],["خلّك مع الله وتلقى عز ٍ وهيبة","وتصير في حرز والضيقات مدحورة",41,"ر",2,0],["خلك اقرب من انفاسي بديت اختنق","والسهر كل ماله يعتبرني أسير",42,"ر",1,0],["خلك من العذر مادام العذر واهي","إرجع فديتك وضم احساسي الواله",43,"ل",2,0],["خلك عزيزٍ طيباتٍ مباديه","وأترك رديٍ كلمته مستفزه",44,"ز",2,0],["خلك كذا لين الليالي تصحيك","وكلن على ماقيل عقله دليله",45,"ل",2,0],["خلك ترجح بالموازين الثقال","لا تطيح بوسط ميزان البطول",46,"ل",1,0],["خلك على درب المراجل ولوطال","مهما يطول الدرب بالخير عايد",47,"د",1,0],["خلك على فالك وتعرف إمصيبتّك","به يوم تذكرني وتعرف مصابك",48,"ك",1,0],["خلك هبل واحيان يا زين الهبال","بين المهبل سو مثل اهبل هبل",49,"ل",1,1],["خلك بثقل الجبل ماكل شي يهزه","واترك اهل البروزه تسعى ورى البروازي",50,"ز",2,0]]}