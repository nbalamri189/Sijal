{"poems":[[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[119,"حسب الأعداء أني","https://www.aldiwan.net/poem41959.html","مجزوء الرمل"],[164,"يا من يصيد إذا غزا أسد الشرى","https://www.aldiwan.net/poem58800.html","الكامل"],[409,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[543,"يا من تدين وهو في","https://www.aldiwan.net/poem47484.html","عموديه"],[563,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59231","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109142","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118297","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100454","المتدارك"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137945",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53232","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/145916","الكامل"],[5943,"رفقًا بأهل الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=37259",""]],"verses":[["ولمولاه يعصر الكرم خمرًا","ثم يسقيه لاَثِمًا أعتابه",0,"ب",2,0],["ولمولاي اتسنادي","لا إلى جاهي وفعلي",1,"ل",2,0],["ولموته بك هاهنا خيرٌ له","من عيشةٍ فيما هنالك مزدرى",2,"ر",2,0],["ولموسى كم إجاباتٍ وقد","فجر الماء عيوناً من حجر",3,"ر",1,0],["ولِمَوطئٍ من حافِرٍ","بِه قد تسرَّعَ حَافِر",4,"ر",1,0],["ولموسى فتاه يوشع محبو","بٌ وقد جل عن جميع العيوب",5,"ب",1,0],["وَلِمُوسَى اللَّحْظِ حُكْمٌ نَافِذٌ","كَلَّمَ المهجةَ لَمَّا أنْ شَرَطْ",6,"ط",1,0],["ولموطني بملوكه فملكوه","شرعاً بملكه من دوني",7,"ن",2,0],["ولموت من هو هكذا خير له","لو عاش ازمانا من الاحياء",8,"ا",2,0],["ولمولانا الباقر قد عزى","فيها ولمفخره ذكرا",9,"ر",2,0],["ولموا هنالك شعث الرجال ال","أُلى مَلَكُ الموت عنهم عبر",10,"ر",1,0],["ولموسى سائل عن الدهر هل خل","د أم دام بعده هارون",11,"ن",1,0],["ولموسى ابن جعفر والعري","ضي ومن خلَّفا نرى الخلف عارا",12,"ر",2,0],["ولمواريد اغفر الذنوبا","وعاف واشفِ واكشف الكروبا",13,"ب",2,0],["ولمؤجر كسح لبئر ما نقا","بالوعة هو لازم وإن زعج",14,"ج",1,0],["ولمُّوا الشَّملَ بعد َالهجرِ رفقاً","بأهلِّ الضَّادِ في زمنِ انبطاح",15,"ح",1,0]]}