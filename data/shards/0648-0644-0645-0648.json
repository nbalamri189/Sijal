{"poems":[[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[113,"حسب الأعداء أني","https://www.aldiwan.net/poem41959.html","مجزوء الرمل"],[158,"يا من يصيد إذا غزا أسد الشرى","https://www.aldiwan.net/poem58800.html","الكامل"],[400,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[536,"يا من تدين وهو في","https://www.aldiwan.net/poem47484.html","عموديه"],[556,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"]],"verses":[["ولمولاه يعصر الكرم خمرًا","ثم يسقيه لاَثِمًا أعتابه",0,"ب",2,0],["ولمولاي اتسنادي","لا إلى جاهي وفعلي",1,"ي",1,0],["ولموته بك هاهنا خيرٌ له","من عيشةٍ فيما هنالك مزدرى",2,"ر",2,0],["ولموسى كم إجاباتٍ وقد","فجر الماء عيوناً من حجر",3,"ر",1,0],["ولِمَوطئٍ من حافِرٍ","بِه قد تسرَّعَ حَافِر",4,"ر",1,0],["ولموسى فتاه يوشع محبو","بٌ وقد جل عن جميع العيوب",5,"ب",1,0]]}