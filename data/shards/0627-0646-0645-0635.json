{"poems":[[88,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[95,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[95,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[87,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[366,"يا نديمي قسم بي الى الصهباء","https://www.aldiwan.net/poem68143.html","الخفيف"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[580,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48514","الرمل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122378","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110326","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77306","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77213","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130777","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204628","الرجز"],[3290,"","https://poetry.dctabudhabi.ae/diwan/poem/100713","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205604","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205923","الخفيف"],[3796,"","https://poetry.dctabudhabi.ae/diwan/poem/124127","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81730","البسيط"],[5183,"إلى ربوع مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180214",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[5956,"مِزاحٌ مع ابنتي آنَ النحيلة","https://www.poetsgate.com/ViewPoem.aspx?id=203443",""]],"verses":[["إِنَّ مِصراً لا تَني عَن قَصدِها","رَغمَ ما تَلقى وَإِن طالَ الأَمَد",0,"د",1,0],["إن مصر التي نفرنا إليها","بحمولٍ من الهموم ثقال",1,"ل",1,0],["إِنَّ مِصْراً إذْ نَعَوْهُ لَهَا","وَجَمَتْ مِنْ شِدَّةِ الخَطْبِ",2,"ب",1,0],["إِنَّ مِصراً رِوايَةُ الدَهرِ فَاِقرَأ","عِبرَةَ الدَهرِ في الكِتابِ العَتيقِ",3,"ق",1,0],["إنّ مصراً وإنّ إيرانَ في المج","د تليداً وطارفاً أَخَوان",4,"ن",1,0],["إِنَّ مِصْراً أَحْيَتْ مَوَاتَ الْقَوَافِي","وَأَقَامَتْ عَمُودَهَا أَنْ يَميلاَ",5,"ل",2,0],["إنَّ مِصراً لكم بلادٌ وأهْلٌ","لَيْسَ في الْحُبِّ بَيْنَنَا من حُدُودِ",6,"د",1,0],["أَنَّ مِصْراً بَعَثَتْ آدابَها","وأبا الفاروق قَدْ أَحْيا لُغاها",7,"ا",3,0],["إنَّ مصرًا وإنَّ سودانَ مصرٍ","في رضاعٍ وفي دمٍ أخوان",8,"ن",1,0],["اِنَّ مِصرَ الاِحسَن الاِرض عِندي","وَعَلى نيلها قَصرت رَجائي",9,"ا",2,0],["إن مصراًً بعدله ونداه","بلد طيب ورب غفور",10,"ر",1,0],["إِنَّ مِصراً ترى به إِرْثَه الأَقْ","دَمَ حَقَّاً أَثاثُه مَوْجُودُه",11,"د",2,0],["إِنَّ مِصْراً إِذ أَنشأَتْه اسْتَطالَت","وازْدَهاها بِه اختيالٌ وعُجْب",12,"ب",1,0],["إن مصراً لعروسٌ زفَّها","وحلاها عيدك الأسنى وزان",13,"ن",1,0],["ان مصح الدهر بها ربوعها","فليس تمصيح الربا بباطل",14,"ل",1,0],["إن مصراً عرفت أولادها","أكرم الأضياف في ظل بشير",15,"ر",1,0],["إِنَّ مِصراً كِنانَةُ اللَهِ لِلمُس","تَضعِفيها الرَدى وَقَصمُ الظُهورِ",16,"ر",1,0],["إِنَّ مِصراً جَنَّةٌ مِن نيلِها","فَجر اللَهُ تَعالى كَوثَرا",17,"ر",2,0],["إِنَّ مِصراً غادَةٌ مِرآتَها","نيلُها أَعطافَها فيهِ تَرى",17,"ر",2,0],["ان مصراً كنانة اللَه في الأر","ض فمن رامها بسوء تردَّى",18,"د",2,0],["إن مصراً لها السعود نصيب","حيث عباس مالك وحبيب",19,"ب",1,0],["إن مصراً ستبلغ استقلالا","تحت ظل العباس وهو قريب",19,"ب",1,0],["ان مصاعب الحياة كلها","شديدة لكنما الذل أشد",20,"د",1,0],["إن مصرَ لها عانٍ لعَمري","قد تأبّتْ على جميع البلادِ",21,"د",1,0],["إِن مَصر اِزدَهَت بِإشراقك العا","لي وَوَجه الدِيار نُوراً تَهلل",22,"ل",1,0],["إن مصرًا كلها في غدها","هي ميراث مصون للشبابْ",23,"ب",1,0],["إن مصرًا تنال من غاصبيها","أجر بخس وخدعة ومطالِ",24,"ل",1,0],["إن مصراً وانت اكرم ذخرٍ","لبنيها وانت خير مؤمل",25,"ل",1,1],["إن مصاب الحسين رزءٌ","فرّق بين العزا وبيني",26,"ن",2,0],["إن مصر ذلت الفصحى على","أوطانها وتعرضت للهون",27,"ن",1,0],["إنْ مصرَ تنجب مثلهم كم أنجبت","مليونَ عملاق أفاد العالما",28,"م",2,1],["إنْ مصطفى للبخلِ أصبح عِبرة","أنوي بأن أذري عليه العَبْرةَ..",29,"ه",1,0]]}