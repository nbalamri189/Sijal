{"poems":[[55,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[63,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[226,"قد عشقناك لا لأنك أنثى","https://www.aldiwan.net/poem55278.html","الخفيف"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[302,"وروضة قابلنا بشرها","https://www.aldiwan.net/poem33156.html","السريع"],[398,"تسحب ما أردت على الصباح","https://www.aldiwan.net/poem53593.html","الوافر"],[463,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[463,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[463,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[466,"أقول وقد ضاقت قوافي مدائحي","https://www.aldiwan.net/poem16433.html","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130208","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67012","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6761","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132747","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36761","السريع"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35646","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136954",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81695","الطويل"],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5321,"شَرَّك غَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=152742",""],[5419,"تباريح الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=32266",""],[5582,"بَدَتْ بِالسَّلامِ وَلانَتْ مَقالا","https://www.poetsgate.com/ViewPoem.aspx?id=187239",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5853,"ردّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=175668",""],[6056,"ديار الدروزي","https://www.poetsgate.com/ViewPoem.aspx?id=130350",""]],"verses":[["تَسحَبُ بُردَيكَ في مَلاعِبِهِ","وَما اِقتَفَتهُ بَرائِنُ الأَسَدِ",0,"د",1,0],["تَسحَقُ هَذي لِهَذِهِ فَتَرى","شَهيقَ هَذي مِن شَهوَةِ",1,"ه",1,0],["تَسُحُّ بِها بَوغاءَ قُفٍّ وَتارَةً","تَسُنُّ عَلَيها تُربَ آمِلَةٍ عُفرِ",2,"ر",1,0],["تسحّبتُ في شعري ولان لجلدتي","ثراه فما استخشنتُ مسَّ المسَاحبِ",3,"ب",1,0],["تسحَّبتُ عِلماً أنَّ لي متسحَّباً","عليك دميثاً في دَهاسٍ من الرملِ",4,"ل",1,0],["تَسُحُّ فَلَو أَنَّ تَهتانَها","حَيّاً أَنبَت القاحِلَ المُجدِبا",5,"ب",2,0],["تَسحَبُ الفولاذَ في مُلتَطَمٍ","بِالعَوادي مُتَعالٍ مُعتَكِر",6,"ر",1,0],["تَسحَبُ الذَّيْلَ في المسيرِ فتختا","لُ وطوراً تمرُّ مرَّ السَّحابِ",7,"ب",1,0],["تسحر العين كلما قابلتنا","في اللَيالي بوجهها الوضاء",8,"ا",2,0],["تسحر القلب بالحديث وناهي","ك بقول كأبدع الالحان",9,"ن",1,0],["تَسِحُّ عَلى هامِ الأَهاضيبِ هامِياً","مِنَ الوَدقِ حَتّى يَلحَقُ القورُ بِالوَهدِ",10,"د",1,0],["تَسُحُّ النَّدَى عَذْباً فُرَاتاً يَمِينُهُ","لِعَافِيهِ لا مِلحاً أُجَاجاً وَلا طَرْقَا",11,"ق",2,0],["تسحبُ فيها الريحُ أَذيالَها","وَينفحُ الوَردُ بأَكمامِهِ",12,"ه",1,0],["تسحَّب ما أَردتَ عَلى الصِباحِ","فَهُم لَيلٌ وَأَنتَ أَخو الصَباحِ",13,"ح",1,1],["تسحَّلَ لي كلُّ حبلٍ علق","تُ وهو بيمناه لي فاتلُ",14,"ل",1,0],["تسحبُ من ملابس العزِّ به","ذلاذلاً لستَ لهنّ نازعا",15,"ع",2,0],["تَسحَبها في الأرض ولفخْرها","مَعالِقٌ في الجوّ أو مَعاقدُ",16,"د",1,0],["تَسُحُّ بِلا شَيْمٍ إذا حُبِسَ الحَيا","فأبْعدُهُا للاَّمِحينَ رَبابُ",17,"ب",1,0],["تسح ولكن ليس بالماء بل اذا","همت هطلت سحا بيضاء فضة",18,"ه",1,0],["تَسُحُّ بأهواءِ الوَرَى منه راحَةٌ","شآبِيْبُها فيها لُجَيْنٌ وعِقْيَانُ",19,"ن",1,0],["تسحب ذيل التِيه في عِزها","على ابن أوس وأبي الطيبِ",20,"ب",1,0],["تسحُّ علينا منه في كلِّ غدوةٍ","مخايل ودقٍ تقتفيها مخائلُ",21,"ل",1,0],["تَسحَبُ ذَيلَ الصَبا وَتَلهو","بِآنِساتٍ يَقُلنَ هيت",22,"ت",1,0],["تسحب الحلة والفضل لها لقتيل","مدرج في كفن",23,"ن",1,0],["تَسُحُّ الدِما لا الدمعَ حتى تَخالُهم","كأَنَّ شُؤُوناً منهمُ غالَها الفَصدُ",24,"د",1,0],["تَسحَبُ بِالرومِ ذُيولَ المَراح","وَتَزدري الأَقران شاكي السِلاح",25,"ح",1,0],["تَسحّب في المَقال عليّ لَمّا","سَكنتُ لَهُ سُكون الأُفعُوانِ",26,"ن",1,0],["تسحُّ على الروابي السحب دمعاً","فتبسم عن ثناياها السهول",27,"ل",1,0],["تسحّ غواديها ويذكر شهابُها","سماحاً وبأساً فهي للودق والوقد",28,"د",1,0],["تسحر ُ القلب َ هذه الأغنيات ُ","أطربينا بعزفها يا فتاة ُ",29,"ت",3,1],["تسحب ردون الطّيب ياذرب الأيمان","على الثرى وقلوبنا تستلبها",30,"ب",3,0],["تسحّ الدمعَ في صمتٍ عيوني","ويُبكي القلبَ وجدٌ والتياعُ",31,"ع",1,0],["تَسِحُّ اللُّجَيْنَ مَعاً وَالنُّضارَ","وَجُرْدَ المَذاكِي مَعاً وَالجِمالا",32,"ل",2,0],["تَسِحُّ عَلَيْنا مِنْهُ فِي كُلِّ غُدْوَةٍ","مَخايِلُ جُودٍ تَقْتَفِيها مَخايِلُ",33,"ل",1,0],["تَسحقُ الآمالَ مِنَّا","في غياب ِالعقل هفْوةْ",34,"و",2,0],["تسحر بصوت ٍ مايعرف النشوزي","والرمش إلا أغضت وسط قلبي مغزه",35,"ز",2,0]]}