{"poems":[[75,"سقى الغيث أطلال الأحبة بالحمى","https://www.aldiwan.net/poem11852.html","الطويل"],[53,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[93,"أقاح ذاك أم شنب وريق ذاك أم ضرب","https://www.aldiwan.net/poem8741.html","عموديه"],[68,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[83,"كأن الخال في وجنات موسى","https://www.aldiwan.net/poem61528.html","الوافر"],[146,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[214,"لواحظ تشهر بيض الصفاح","https://www.aldiwan.net/poem13460.html","السريع"],[215,"إلى القاضي وعينيه سلام","https://www.aldiwan.net/poem46304.html","الوافر"],[215,"صدقت ولكن كيف تلك رواية","https://www.aldiwan.net/poem46328.html","الطويل"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[240,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[280,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[287,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[415,"لو أحسنوا في ملكنا أو أعتقوا","https://www.aldiwan.net/poem32423.html","الكامل"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[511,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122696","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48538","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59566","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59212","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25336","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122011","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115877","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110312","الطويل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131333","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100924","الكامل"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105339","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74249","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74250","الطويل"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143499","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89148","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129450","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91302","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131280",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107041","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127285","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94865","البسيط"],[4233,"","https://poetry.dctabudhabi.ae/diwan/poem/143550","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73186","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120290","الكامل"],[4679,"لواحظهُ بدت ترمي سهاماً","https://www.poetsgate.com/ViewPoem.aspx?id=142745",""],[5038,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=189980",""],[5038,"غنّى الفرات","https://www.poetsgate.com/ViewPoem.aspx?id=190107",""],[5057,"لا تلوموا","https://www.poetsgate.com/ViewPoem.aspx?id=184016",""],[5163,"إذا الشمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=33951",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5409,"قلبي في حبك نشوان","https://www.poetsgate.com/ViewPoem.aspx?id=155514",""],[6102,"رَسولُ الهَوى...","https://www.poetsgate.com/ViewPoem.aspx?id=182740",""]],"verses":[["لَواحِظُهُ عِندَ الرُنُوِّ سِهامُ","فَقُل لِزَمانٍ قَد تَوَلّى نَعيمُهُ",0,"ه",1,0],["لو احتَجَجْنا في مَحْفلٍ لدرَى","أنْ ليسَ إلزامُهُ كإلزامي",1,"م",2,0],["لَواحِظُها نَمَتها الهِندُ","لَكِن أَهلُها عَرَبُ",2,"ب",1,0],["لَواحِظٌ حاذَرَت أَلحاظَنا فَغَدَت","بِصارِمِ الغُنجِ تَحمي وَردَةَ الخَجَلِ",3,"ل",1,0],["لَواحِظُهُ مُحَيَّرَةٌ وَلَكِن","بِها اِهتَدَتِ الشُجونُ إِلى فُؤادي",4,"د",2,0],["لواحظُنا تجنىِ ولا علَم عندَها","وأنفسُنا مأخوذةٌ بالجرائرِ",5,"ر",1,0],["لَوِ اِحتَساها اِبنُ الزُبَيرِ اِغتَدى","أَكرَمَ مِن كَعبٍ وَأَوسِ بنِ لام",6,"م",1,0],["لواحظ تشهر بيض الصفاح","وقامة تخجل سمر الرماح",7,"ح",1,1],["لواحظُ من رحيق الراح صيغت","فصارت فرحة القلب الحزين",8,"ن",1,0],["لواحظه إن غام كانت صواعقاً","وإن لان كادت بالهوى تتوسل",9,"ل",1,0],["لَواحِقاً أَقرابُها","إِن طُلِبَت لَم تُلحَقِ",10,"ق",1,0],["لَواحِظُ فيها رُقىً لِلمُحِبِّ","إِذا ما كَشَرنَ لِوَعدٍ وَسِحرُ",11,"ر",1,0],["لَوَاحِقُ مِن آلِ الوَصِيِّ ولاحِقٍ","تَمَطَّرُ خُمْصاً تَحْتَ فُرْسانِها الخُمْصِ",12,"ص",1,0],["لَواحِظُهُ سِهامٌ لَيسَ تُخطي","رَمايا قَوسِ حاجِبِهِ السِّهامُ",13,"م",1,0],["لو أحْسنوا في مَلِكنَا أو أعتَقوا","لَصَفَا لَهُم من وُدّنا ما رنَّقُوا",14,"ق",3,1],["لواحظٌ كلُّها نجومٌ إذا","كانت لياليه كلُّها عَتَما",15,"م",2,0],["لواحظاً علَّمَتِ الضربَ الظُّبا","على قوامٍ علَّم الطعنَ الأسلْ",16,"ل",1,0],["لو احتَرموه هَابوه يَوماً","لكانَ لصحبه معه احترام",17,"م",1,0],["لواحظٌ لُحْنَ في زِيِّ الحِدادِ لِكَي","يُبرِزنَ حُزناً على قَتْلَى رواميها",18,"ي",3,0],["لو أحدَثُوا نَفَقاً لِكَيدِكَ أو رَقَوا","في الجَوِّ ما وَجَدُوا إليكَ طَريقا",19,"ق",2,0],["لو أحسنوا أحرقوهم مثل إخوتهم","في الكفر فارتاحت الدنيا بما فعلوا",20,"ل",3,0],["لواحِظ غيد نومةً وتيقظاً","يريك تناجيها سبيل نجاح",21,"ح",1,0],["لَواحِظُهُ والْخَالُ والصُّدْغُ والسَّنَا","وقَامَتُهُ والرّيقُ والْخَدُّ والثَّغْرُ",22,"ر",1,1],["لَو أَحْلَبَتْ حَلائِب الفُسْطاطِ","عَلَيْه أَلْقاهُنَّ بِالبَلاطِ",23,"ط",1,0],["لَوَاحِقَ مِنْ نَسْلِ الوَجِيهِ وَلاَحِقٍ","هِيَ السُّفْنُ فِي بَحْرِ العَجَاجِ لَهَا سَبْحُ",24,"ح",1,0],["لواحِظُ لو برَّزت","فى يوم حربٍ لَسَبَت",25,"ت",1,0],["لواحدهم سدسٌ فإن كثروا فهم","لدى الثلثِ شرعٌ بالسويةِ أجمعُ",26,"ع",1,0],["لواحظهم للبحر تهفو شواخصاً","وبحر دموع الشوق فيها له مد",27,"د",1,0],["لو احْتَمتْ عَنّي بقاهِرِيَّهْ","صِدْتُهما جَمْعاً بِبُندقِيَّهْ",28,"ه",1,0],["لو أحيتِ الموتى مقالةُ شاعرٍ","لنشرتُهم وحشرتُهم ببيانى",29,"ن",2,0],["لواحظه تصيب وليس يجدي","بها حذر ولم تمنع بترس",30,"س",1,0],["لواحي زليخا لَو رَأين جَبينه","لآثرن في القَطع القُلوب عَلى الأَيدي",31,"ي",1,0],["لَواحي زليخا لَو رأَين جبينه","لَغابوا عَن الإِحساس شَوقاً بِلا عَمد",32,"د",1,0],["لواحظه تبثُّ السحر فينا","وفي شفتيه أسباب الشفاء",33,"ا",2,0],["لواحة للأرض لا","تبقى النبات ولا تذر",34,"ر",1,0],["لَواحظها اِصمَت فُؤادي بِغَمزِها","وَقَد هيجَت فيهِ الغَرامُ بِرَمزِها",35,"ه",2,0],["لواحظه من نرجس وخدوده","شقائقه والاقحوان مباسمه",36,"م",2,0],["لَواحظُه لساعاتِ التهاني","تعلمتا الدقائق وَالثواني",37,"ن",2,0],["لو احبوه لقالوا حسبنا","أجرةٌ لا تحرم الشعب الطعاما",38,"م",2,0],["لَوَّاحةٌ تَسْطُو فما","تُبْقي عليه ولا تَذَرْ",39,"ر",1,0],["لواحظه فتاكة بجفونها","وما السيف فتاك إذا كان في الغمد",40,"د",1,0],["لواحظهن قد حاكت لجسمي","سرابيل الضنى من غزلهن",41,"ن",1,0],["لواحظ السعد قد أرَّختُ ترقبها","مليكةٌ مُلِّكَت عن أمر باريها",42,"ي",3,0],["لواحظه وقعُ الأسنّة دونها","وألفاظه سَلُّ السيوف الصوارم",43,"م",1,0],["لواحظُكَ التي تُصمي البرايا","سهامٌ حاجباكَ لها حنايا",44,"ا",3,1],["لو احصيت الفا اتم لقلت من","حرص على طلب المزيد ونيفا",45,"ف",2,0],["لواحظهُ بدت ترمي سهاماً","وتنشبها بمهجة كل عاصي",46,"ي",1,1],["لَو أحْرُفي كَيَمامَةٍ حَطّتْ عَلى","أَيكٍ أحاطَكِ ظِلُّهُ الْهِفْهافُ",47,"ف",1,0],["لَو أُحْسِنَ الإيمانُ ما تَبِعَ الْهوى","نُخّاسُ داءٍ ما شَفاهُ ذُعاقُ",48,"ق",1,0],["لو أحسّت بما أُحِسّ رثتني","دونَ صخرٍ بشعرِها الخنساءُ .",49,"ا",2,0],["لواحظُ منها الجنُّ تنسلُّ خِشيةً","إذا قيلَ خوفاً قلْ بلا وتوسُّلا",50,"ل",2,0],["لو أحسن الأقوام في أفعالهم","لم يشتك الجيران من جيران",51,"ن",1,0],["لو أحسنوا الخلْق ما هانتْ دعائمه","وسادهمْ فيه تأصيلٌ وتجذيرُ",52,"ر",1,0],["لو احتسى مثلي هواك الملا","لأوصدت أبوابها ألحان",53,"ن",1,0],["لَوِ احتَرَقتِ بِنارِ الوَجدِ مِثلِيَ لَم","يَكُنْ لِمَن حاوَلُوا التَّأثِيرَ تَأثِيرُ",54,"ر",1,0]]}