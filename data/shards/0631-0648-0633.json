{"poems":[[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136993",""],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52976","المتدارك"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59458","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94405","البسيط"],[5050,"صبرا على مضض المصارع","https://www.poetsgate.com/ViewPoem.aspx?id=38198",""],[5122,"وين أنت يالمعتصم","https://www.poetsgate.com/ViewPoem.aspx?id=24262",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""]],"verses":[["رؤساءٌ في ممالكهم","عرب والحكم للعجم",0,"م",1,0],["رؤساؤكم هم أُسْد شَرى","كل منهم للمجد شَرى",1,"ر",2,0],["رُؤَسا الرعيَّة والأَئِمَّةُ اصبحوا","في الشرقِ شرَّ الناسِ بالطُغيانِ",2,"ن",1,0],["رُؤَساؤُها جعلوا الكنيسة متجراً","آلَت لهم أَسرارُها بِضَمانِ",2,"ن",1,0],["رُؤساً حاوَلتْ كبراً صُعوداً","فَنالتْهُ على رُوس الِصّعاد",3,"د",1,0],["روسو رشيدُ النُهى وَالفَضلُ دَيدَنهُ","لبطشهِ فالشهود البيض والسمرُ",4,"ر",1,0],["روس البرية في العلا","صدر المجالس والمجامع",5,"ع",1,0],["روس(ن)من المجد والنوماس ممليه","من فقدها العز يلبس حزن وحدادي",6,"د",2,0],["روسية العظمى حبته منصباً","فرعى أوامرها بحسن وفاء",7,"ا",2,0]]}