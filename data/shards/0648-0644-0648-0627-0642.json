{"poems":[[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[53,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[63,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[63,"فتح أعز به الإسلام صاحبه","https://www.aldiwan.net/poem51815.html","البسيط"],[33,"وبعادي وما علمت بذاكا","https://www.aldiwan.net/poem42025.html","الخفيف"],[48,"بك على الناس بالمزموم والرمل","https://www.aldiwan.net/poem23216.html","البسيط"],[108,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[96,"اللهب القدسي","https://www.poetsgate.com/ViewPoem.aspx?id=15627",""],[146,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[146,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[240,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[376,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[505,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[520,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[566,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86852","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64129","الوافر"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80224","الكامل"],[2086,"","https://poetry.dctabudhabi.ae/diwan/poem/205171","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67228","الهزج"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117853","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125801","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93272","الكامل"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198555","الطويل"],[5216,"أحزانُ أمَّتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=186987",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5616,"رزان","https://www.poetsgate.com/ViewPoem.aspx?id=203503",""],[6193,"إذ كنت ذا عين إلى المجد رامقه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55435&r=&rc=11",""]],"verses":[["وَلَوْ أَقْسَمَتْ أَنْ تَغْلِبَ الْجَمْعُ تَغْلِبٌ","وَتَنْسِفَ جِرْمَ الأَرْضِ إِنْ حَمَلَتْ جَرْمُ",0,"م",1,0],["ولو أقصروا عن سعيهم لكفتْهُمُ","مواريثُ مجدٍ للسماك مُناصي",1,"ص",2,0],["ولو اقتَدى فينا بأحمدَ لارتَدَى","بُردَيْنِ من تَوقيفِه وسَدادِه",2,"د",2,0],["ولو أقام فُواقاً إذ دلفتَ له","تحتَ العَجاجِ لقد قامت نوادِبُه",3,"ب",2,0],["وَلَوَ أَقسَمتَ لا يُكَلِّمُ حَتّى","عُمرِ نوحٍ بِعَيشِهِ ما عَصاكا",4,"ك",2,0],["وَلَو أَقامَ لَوافاهُ الَّذي سَمَحَت","بِهِ المَقاديرُ مِن نَقصٍ وَمِن كَمَلِ",5,"ل",1,0],["ولو أقسمَتْ أنها هيَ أمُّ ال","وجودِ لما حِنثَتْ في القَسَمْ!",6,"م",1,0],["ولو أقام الضحايا من مصارعها","لآثرت موتها فيه ضحاياه",7,"ا",2,0],["ولو أقام لازما أصدافَه","لم تكن التيجانُ في حسابه",8,"ب",2,0],["ولو اقتدرتُ قسمتُها يومَ النوى","عينا تلاحظهم وأخرَى تَسْجُمُ",9,"م",1,0],["وَلَو أَقلَعَ الخَوفُ عَنهُ اِهتَدى","وَلَكِنَّهُ زادَ رُعباً فَضَلّ",10,"ل",1,0],["وَلَوِ اِقتَدى بِجَميلِ سي","رَتِكَ الزَمانُ تَأَدَّبا",11,"ب",2,0],["ولو أقدَّ صدار الصَّدر عن كبدي","لم يصبح الوجدُ مني فيه مُنتصفا",12,"ف",2,0],["ولَو اقتَصرتَ عَلى القَديم كَفى العُلى","إنَّ القَديِمَ لَيُوجبُ التَّقدِيما",13,"م",2,0],["ولو أقمتُ كلَّ عو","جاءَ أقمتُ أضلعي",14,"ع",2,0],["ولو أَقمْنا بجَنَّاتٍ مزخْرَفَةٍ","لقامَ يكْنِسُ في أَعْتابِنا الحُورُ",15,"ر",1,0],["ولو اقترحت على الزمان شبيبة","سلفت أتاك بها الزمان مبشرا",16,"ر",2,0],["وَلَو أَقولُ بَرِّخوا لَبَرَّخوا","لِمارَ سَرجيسَ وَقَد تَدَخدَخوا",17,"خ",3,0],["وَلَو اِقتَصرت عَلى الكَبائر هَذِهِ","لَكفت وَحاقَ بِكَ العَذاب الأَكبر",18,"ر",1,0],["ولو أقسمتُ أن المجد شيءٌ","له دون البرية لم أحابه",19,"ب",2,0],["وَلَو اِقتدت بِكَمالِ ذاتك وَالوَفا","لَم تَخلف المِيعاد وَالمَوعودا",20,"د",2,0],["ولو اقتصرت على التي هي قيمتي","فيما بتت قضية الحكماء",21,"ا",2,0],["ولو أقامَ في اللثامِ ثَغره","ما أسفرَ الصبحُ لنا وابتهجا",22,"ج",2,0],["وَلَو اِقتَدَحَت زِناد فكرك فيهم","لأَراكَ وَصف علاهم الايراءُ",23,"ا",2,0],["ولو أقلعوا عن غيّهم لتبوّؤا","منازل مجد بالثوابت لاصقه",24,"ق",2,0],["ولو اقتفاهم بالسيوف لاثخنوا","ولسال جرح بالدماء سخين",25,"ن",1,0],["ولو اقتصرت على حُشاشة مُغْرمٍ","وافاك من مأْسورك الميسور",26,"ر",1,0],["ولو أقلعت أولى عزاليه لانبرت","رياح النوى تمري دموع الهوى مريا",27,"ي",2,0],["ولو أقمنا على الإخلاصِ ما انصَرَفَتْ","عَنّا الحضارةُ قد كانت ولمْ تَدُمِ",28,"م",1,0],["ولو أقدموا ألفوا رجالاً أعزة","قد اعتقلوا بالسمهري وبالبتر",29,"ر",1,0],["ولو أقبلتم وجهاً لوجه","لناح على الجنود الشمعدان !",30,"ن",1,0],["ولو أقلعو عن غيّهم لتبوّؤا","منازل مجد بالثواب لاصقه",31,"ق",2,0]]}