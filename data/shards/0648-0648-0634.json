{"poems":[[65,"وظلام قيد العين به","https://www.aldiwan.net/poem45729.html","الرمل"],[75,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[85,"يا من تمد له الملوك أكفها","https://www.aldiwan.net/poem54343.html","الكامل"],[11,"صحا القلب من سلمى وعن أم عامر","https://www.aldiwan.net/poem246.html",""],[53,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[47,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[47,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[51,"إمام الهدى أصبحت بالدين معنيا","https://www.aldiwan.net/poem65369.html","الكامل"],[76,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[78,"رياحين أهديها لريحانة المجد","https://www.aldiwan.net/poem39441.html","الطويل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142329","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[47,"يا أخَا الأزْدِ ما حَفِظتَ الإخَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=32957",""],[96,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[129,"يا خليلي بالركاب سحيراً","https://www.aldiwan.net/poem4101.html","الخفيف"],[151,"إلى الصون مدت تلمسان يداها","https://www.aldiwan.net/poem47691.html","الطويل"],[178,"داو الخمار بخمره","https://www.aldiwan.net/poem46041.html","مجزوء الكامل"],[240,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[242,"لبس الأصيل ملاءة موشية","https://www.aldiwan.net/poem19515.html","الكامل"],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[302,"وذي هيف ما زال بالرمل مولعا","https://www.aldiwan.net/poem33279.html","الطويل"],[366,"صاح في العاشقين بال كنانه","https://www.aldiwan.net/poem68049.html","الخفيف"],[385,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[398,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[409,"أحلى الهوى ما كان جهرا","https://www.aldiwan.net/poem33914.html","مجزوء الكامل"],[415,"أضحت على مفرقي تاجا وفي عنقي","https://www.aldiwan.net/poem32203.html","البسيط"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[441,"جرر على القمرين ذيل التيه","https://www.aldiwan.net/poem2652.html","الكامل"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[457,"ألا مرحبا باقتبال الربيع","https://www.aldiwan.net/poem13766.html","المتقارب"],[463,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[482,"قف بي على منزل بالربع قد دثرا","https://www.aldiwan.net/poem15341.html","البسيط"],[519,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[556,"ضنت عليك ضنينة الخدر","https://www.aldiwan.net/poem47786.html","أحذ الكامل"],[556,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[556,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[572,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86704","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39224","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38923","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62451","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119964","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59246","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133785","الرجز"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133761","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64874","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64897","السريع"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132816","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78167","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50036","المتقارب"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82716","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202171","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67230","الرمل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111249","الوافر"],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107320","الطويل"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45352","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75939","الرمل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146324","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109796","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132543","الخفيف"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140160",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67974","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88890","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52982","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77086","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94623","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73220","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73153","الوافر"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104873","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139669",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52163","الوافر"],[5388,"سوف أمضي","https://www.poetsgate.com/ViewPoem.aspx?id=206913",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[709,"كتمَ الهوى فوشى النّحولُ بسرّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2905",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""]],"verses":[["وَوَشى العِطرُ بِهِ إِذ بَلَّهُ","آخِرَ اللَيلِ سَقيطٌ مِن نَدى",0,"ا",1,0],["وَوَشَّحَ زَهرَةَ ذاكَ الزَمانِ","بِما حازَ مِن زُهرِ تِلكَ الشِيَم",1,"م",1,0],["ووشت يد الأقدار في أعطافها","وشياً زَرَى بالحلّة السّيَراءِ",2,"ا",2,0],["وَوَشَّت وُشاةٌ بَينَنا وَتَقاذَفَت","نَوى غُربَةٍ مِن بَعدِ طولِ التَجاوُرِ",3,"ر",1,0],["ووِشايةَ العِطْرِ النَّمو","مِ عليَّ والحَلْيِ النَّموم",4,"م",1,0],["وَوَشَت بي إِلى الوُشاةِ دُموعُ ال","عَينِ حَتّى حَسِبتُها أَعداءَ",5,"ا",2,0],["وَوَشكُ النَجاحِ كَالسُمِيِّ هَواطِلاً","يُضاعِفُ وَسمِيّاتِهِنَّ بُكورُها",6,"ر",3,0],["وَوَشَّيتَ وَجهَ الأَرضِ بِالجودِ وَالنَدى","فَأَصبَحَ وَجهُ الأَرضِ بِالجودِ مَوشِيّا",7,"ي",2,0],["وَوَشى رِداءَ الحَمدِ بِاِسمِكَ خاطِرٌ","قَد عاثَ فيهِ السُقمُ فَهوَ كَليلُ",8,"ل",1,0],["ووَشْيُ رَبيعٍ مُشْرِقِ اللَّوْنِ ناضِرٍ","يَلوحُ عليْهِ ثَوْبُ وشْيٍ مِنَ الحمدِ",9,"د",1,0],["ووشّت بساط الفضا بالسنا","وباللّهب البارد العسجدي",10,"د",2,0],["وَوَشَى للرِّيَاضِ ثوباً وَحَلَّى","كلَّ جِيدٍ من الرُّبَا بعُقُودِ",11,"د",1,0],["وَوَشْتْ بي إلى الوُشَاءِ دُموعُ ال","عَينِ، حتى حَسِبتُها أعْداءَ",12,"ا",2,0],["ووشي كأحلام الشباب يصوغه","أنيق بأسرار البيان عليم",13,"م",1,0],["ووشي به الألوان حيرى كأنّها","سماء فتصحو لمحة وتغيم",13,"م",1,0],["وَوَشى القَطرُ جانُبيهِ فَبَاهَى","بِأَزاهيرِه نُجومَ السّماءِ",14,"ا",2,0],["ووشحتها ثوباً من العز رافلاً","فقامت بإعجابٍ تجرّ رداها",15,"ا",3,0],["وَوَشا إلَيَّ بِبَذْلِهِ","زُنَّارُهُ فِي خَصْرِهِ",16,"ر",2,0],["وَوَشى بِأَسرارِ الرِيا","ضِ مِنَ الصِبى نَفسٌ مُرَدَّد",17,"د",1,0],["وَوَشَى النَّسِيمُ بِسِرِّ أَزْهَارِ الرُّبَى","هَلْ مِنْ كُؤُوسِ مَسَرَّةٍ يَا سَاقِ",18,"ق",1,0],["ووشى ونم عليك دمعك عندما","وشي بعندمه الخدود وغنما",19,"م",2,0],["وَوَشّى نَقيَّ الخَدِّ منه بحمرَةٍ","فَقُلتُ طَريقٌ للوِصال تولَّدا",20,"د",2,0],["وَوَشاحه جائِلان عَلى خَص","م أَطالا من وَجدِهِ جولانه",21,"ن",2,0],["وَوشاة لَن يَملوا أَبَدا","وَغَيور لَيسَ يَخشى أَحَدا",22,"د",2,0],["وَوشجي بِالدَمعِ ما","أَفَضتِهِ دَمَ المُقَل",23,"ل",1,0],["وَوَشَى بتُرْبتِكَ التي شَرُفَتْ شَذىً","لولاهُ ما علمَ العدوّ ولا درى",24,"ر",2,0],["ووشحوا ما شئتم من نظم","ونحوه قودوا جيوش الذم",25,"م",1,0],["ووشت عليه دموعه","ففشا له في الناس ذكرا",26,"ر",2,0],["ووشيُ خَطٍ حكى زهرَ الربيع سَرَتْ","أكمامُه عن بديعِ الفضلِ والحِكَمِ",27,"م",1,0],["ووَشَتْ عن كلّ صبٍّ عبرةٌ","فكَفَتْ عَبْرَته الواشي المقالا",28,"ل",2,0],["وَوَشَت يَدُ الإِبداعِ في وَجَناتِهِ","ما المُزنُ في رَوضِ الرُبى وَاشِيه",29,"ي",2,0],["ووُشِّجَ للسَلمِ منكَ السُلامى","فأهدى له كلُّ أفقٍ سلامَهْ",30,"م",2,0],["ووشّى به الزهر خُضْرَ البطاح","وباح النسيم بأسرارهِ",31,"ر",2,0],["ووشى الواشي وفي تأميله","سفَهاً أنِّي مع الغدر أميلُ",32,"ل",1,0],["ووشَّحتْ كلماتي كلَّ ناحيةٍ","منها فصارتْ على لَبّاتِها دُرَرا",33,"ر",2,0],["ووشَتْ له سُودُ العيونِ بهديها","وشيَ الحَمامِ فقمّصَتْهُ بحُمْرِهِ",34,"ر",2,0],["ووشى إليك بوَشْكِ فُرقتِها","صوتُ الغراب وأنتَ لا تدري",35,"ر",2,0],["ووشيكاً يكون ذاك فما بَعْ","دَ شَرارِ الزّناد إلّا اللهيبُ",36,"ب",1,0],["وَوَشى إِلَيهِ بِسَلوَتي مَذِقٌ","نَغِلُ المَودَّةِ صِدقُهُ كِذْبُ",37,"ب",1,0],["وَوَشّحُوا غُرَرَ الآدابِ فَلْسَفَةً","وَحِكْمَةً بعلومِ ذاتِ إيْضَاحِ",38,"ح",1,0],["وَوشَّى فَحشَّى بِالبَراعة وَالنُهى","شُروحاً غَدَت تَقضي لَهُ بِالتَفَرُّد",39,"د",1,0],["ووَشى بأنواع المحاسِنِ هذهِ","وأنارَ هذي بالجَواري الكُنَّسِ",40,"س",1,0],["وَوشيَةِ خَدَّيهِ بِلاماتِ عارِضٍ","مِنَ المِسكِ فَوقَ الجلّنار قَد اِلتووا",41,"و",3,0],["ووشّم خدَّك الورديَّ خالٌ","فكان عليك من ملكٍ خضابٌ",42,"ب",1,0],["ووشى به بعد اكتتا","م وشيء خديك الملوح",43,"ح",1,0],["وَوَشَى العبيرُ بِطِيبِ مَسْرَاهَا وَلَمْ","أسمعْ بحسنٍ لِلْجَمَادِ وَمَنْطِقِ",44,"ق",1,0],["ووشى جناحيه وقلد جيده","بمسك وبالتبر المذاب تلثما",45,"م",2,0],["ووشوشات وأحا","ديث ونجوى اخر",46,"ر",1,0],["ووشى الطيب إلى الناس بنا","فاستعنا الليل فيه فأعانا",47,"ن",2,0],["وَوْشَتْ يدُ الأَنْواءِ بُرْدَ رِياضهِ","بِغَرائِبِ التَّوشيعِ والتَّفْويفِ",48,"ف",1,0],["ووشَّعَتْ أَرْضَكِ أَيْدي الحَيا","بناضرٍ مِنْ رَوْضِهِ المُونِقِ",49,"ق",1,0],["ووَشى به خَطُّ العذارِ بخدِّه","مالا أعارت لحظه فوشَى به",50,"ب",2,0],["وَوَشين أَجنِحَةً لَهُنَ وَهامَة","بِالنور بَعد تَسَربُل وَتَعمم",51,"م",1,0],["ووشَّين بالتّبر بيضَ التَّراقي","وغشَّين سود الفروع المُتونا",52,"ن",2,0],["ووشّاه فَنَمنَمَه مُسَدٍ","فصيحٌ في المقال بلا لسان",53,"ن",1,0],["ووشاة الدمع تروي ما جرى","غادريهِ انهُ قد غدرا",54,"ر",2,0],["وَوَشَتْ حدائقُه عليكِ مَطِارفاً","يَخْتال في حَبَراتها عِطْفاكِ",55,"ك",1,0],["ووشاةُ السوءِ لا أخشاهمُ","لا ولا أخشى رقيباً وحسودا",56,"د",2,0],["ووشى البردة الممدوح فيها","رسول اللَه بالوشي العجيب",57,"ب",1,0],["وَوَشَّيتُهُ وَالفِكرُ مِنِّي شاغِلٌ","وَقَلبي وَقَد أَضحَى مِنَ الهَمِّ جَلمَدَا",58,"د",2,0],["وَوَشِئتُ لَولا الحُلمُ جَدَّعتُ أَنفَهُ","بِايعابِ جَدعٍ باديءٍ وَعَليلِ",59,"ل",1,0],["وَوَشَت بِالحِبرِ في مُهرَقِها","وَشيَ خَطٍّ قَد تَجَلّى أَسطُرا",60,"ر",2,0],["وَوَشْيُ الحِبْر في القِرطاس أَبْقى","على الأَيّامِ من وَشْي الحبير",61,"ر",1,0],["ووشى فابعد قربنا حسداً","وبغى فهدّم بيننا وبنى",62,"ن",2,0],["ووشاح يعدي الفؤاد خفوقاً","فهو يلقى خفوقه بوجيب",63,"ب",1,0],["ووشت بها أيدي الربيع مطارفا","من فضة وزبرجد ونضار",64,"ر",1,0],["ووَشَّم خدَّك الورديَّ خالٌ","فكان عَلَيْكَ من حَلَكٍ خِضاب",65,"ب",1,0],["ووشع الوجد في قلبي لهيب جوىً","فذاب بالمحرقين الشوق والضرم",66,"م",1,0],["ووشْى تنِّيسَ غيرُ منسى","من حسنه الدهر يستفيد",67,"د",1,0],["ووِشاحُ ايليَّا الذي أَبقى لأَليَشَعَ","النبيِّ غَداةَ أُصعِدَ وارتَقى",68,"ا",1,0],["ووُشِحَ بالأَكفانِ وجهٌ مكرَّمٌ","عليهِ من الفضل السنيِّ وشائحُ",69,"ح",1,0],["وَوُشاحاه جائِلانِ عَلى خَص","رٍ حَكى جِسم مَن شَكا هِجرانَه",70,"ن",2,0],["ووشَّيتَ في مدح القريض رسالةً","بها الدر منضودٌ وضاءَت كواكبُه",71,"ب",2,0],["ووشى بِوَشي عِذارهِ فأظُنُّ أنَّ ال","خَدَّ أَوقَفهُ بلافِحِ جَمرهِ",72,"ر",2,0],["ووشَّت أرضَها أيدي سَوارٍ","لها فيها انهمارٌ وانهمالُ",73,"ل",1,0],["ووشع الفخر منه بالمكارم 