{"poems":[[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[54,"جاؤوا من الشام المشومة أهلها","https://www.aldiwan.net/poem27430.html","الكامل"],[88,"يا بني الرافدين مالي أراكم","https://www.aldiwan.net/poem44473.html","الطويل"],[29,"رحلت أمامة للفراق جمالها","https://www.aldiwan.net/poem6173.html","الكامل"],[28,"غلبتم الناس بالحق الذي لكم","https://www.aldiwan.net/poem5083.html","البسيط"],[102,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[392,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[469,"وحلة من أنعم الإنعام","https://www.aldiwan.net/poem59703.html","الرجز"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[559,"إن ذلي في حب علوة عز","https://www.aldiwan.net/poem34457.html","الخفيف"],[568,"اخسأ لحاك الله كلب دناءة","https://www.aldiwan.net/poem69725.html","الكامل"]],"verses":[["اِخسَئي يا نُوَبَ الأَيّا","مِ ما عِشتُ وَخيبي",0,"ب",2,0],["أَخسِر بِها مِن بَيعَةٍ أَمَوِيَّةٍ","لُعِنَت وَحَظُّ البايِعينَ خَسيسُ",1,"س",1,0],["أخسروها بمكرهم كلّ حق","وبغير الوعود ما عوّضوها",2,"و",3,0],["إخسَأ إِلَيكَ جَريرُ إِنّا مَعشَرٌ","نِلنا السَماءَ نُجومَها وَهِلالَها",3,"ل",3,0],["اِخسَأَ كُلَيبٌ فَإِنَّ اللَهَ أَنزَلَكُم","قِدماً مَنازِلَ إِذلالٍ وَتَصغيرِ",4,"ر",1,0],["إِخسأ بِوعدك إِن وَع","دك دونه رَب القَضاء",5,"ا",2,0],["إِخسأ بوعدك لَن يَضي","ر الوَعد شَعباً هَبَّ ناهض",5,"ض",1,0],["أَخسر بهِ أَن تُستردّ وقصرهُ","مِنها رعايتُهُ لها إِذ ترتعُ",6,"ع",1,0],["أخسس بها حالة حازت لكل رداه","زينها إبليس حسنها لهم باغتواه",7,"ا",2,0],["أَخٌ سَجاياهُ عَلى نِظامٍ","لَهُ نَدىً يُقصِرُ كُلَّ خامِ",8,"م",1,0],["أخِسَّاءُ خُلقٍ سَافِلاتٌ نفوسُهُم","طِباعٌ عليهَا مُذ فِطامِهِمُ شَبُّوا",9,"ب",3,0],["اخسئي لا تجاوزي قدْرَ وهمٍ","هو طرزٌ والفهم في الله طرز",10,"ز",1,0],["اخسأْ لَحَاكَ اللّهُ كلبَ دَنَاءَةٍ","كلباً يروح على النِّباحِ ويغْتدي",11,"د",2,1]]}