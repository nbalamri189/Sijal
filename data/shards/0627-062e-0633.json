{"poems":[[55,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[56,"جاؤوا من الشام المشومة أهلها","https://www.aldiwan.net/poem27430.html","الكامل"],[90,"يا بني الرافدين مالي أراكم","https://www.aldiwan.net/poem44473.html","الطويل"],[31,"رحلت أمامة للفراق جمالها","https://www.aldiwan.net/poem6173.html","الكامل"],[30,"غلبتم الناس بالحق الذي لكم","https://www.aldiwan.net/poem5083.html","البسيط"],[104,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[473,"وحلة من أنعم الإنعام","https://www.aldiwan.net/poem59703.html","الرجز"],[543,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[563,"إن ذلي في حب علوة عز","https://www.aldiwan.net/poem34457.html","الخفيف"],[572,"اخسأ لحاك الله كلب دناءة","https://www.aldiwan.net/poem69725.html","الكامل"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/143232","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38327","البسيط"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203763","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144367","الكامل"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199885","الخفيف"],[3227,"","https://poetry.dctabudhabi.ae/diwan/poem/143348","السريع"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83189","الرجز"],[4955,"يأتيكَ شيطانٌ يوسوسُ قائلاً","https://www.poetsgate.com/ViewPoem.aspx?id=187864",""],[5219,"إلى أرض الإسراء","https://www.poetsgate.com/ViewPoem.aspx?id=194255",""],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[5638,"اخسأ ولا تطغى أيا سلمي","https://www.poetsgate.com/ViewPoem.aspx?id=198250",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[6093,"يا جاثياً في رسُوم الحيِّ معتكفا (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176186",""]],"verses":[["اِخسَئي يا نُوَبَ الأَيّا","مِ ما عِشتُ وَخيبي",0,"ب",2,0],["أَخسِر بِها مِن بَيعَةٍ أَمَوِيَّةٍ","لُعِنَت وَحَظُّ البايِعينَ خَسيسُ",1,"س",1,0],["أخسروها بمكرهم كلّ حق","وبغير الوعود ما عوّضوها",2,"و",3,0],["إخسَأ إِلَيكَ جَريرُ إِنّا مَعشَرٌ","نِلنا السَماءَ نُجومَها وَهِلالَها",3,"ل",3,0],["اِخسَأَ كُلَيبٌ فَإِنَّ اللَهَ أَنزَلَكُم","قِدماً مَنازِلَ إِذلالٍ وَتَصغيرِ",4,"ر",1,0],["إِخسأ بِوعدك إِن وَع","دك دونه رَب القَضاء",5,"ا",2,0],["إِخسأ بوعدك لَن يَضي","ر الوَعد شَعباً هَبَّ ناهض",5,"ض",1,0],["أَخسر بهِ أَن تُستردّ وقصرهُ","مِنها رعايتُهُ لها إِذ ترتعُ",6,"ع",1,0],["أخسس بها حالة حازت لكل رداه","زينها إبليس حسنها لهم باغتواه",7,"ا",2,0],["أَخٌ سَجاياهُ عَلى نِظامٍ","لَهُ نَدىً يُقصِرُ كُلَّ خامِ",8,"م",1,0],["أخِسَّاءُ خُلقٍ سَافِلاتٌ نفوسُهُم","طِباعٌ عليهَا مُذ فِطامِهِمُ شَبُّوا",9,"ب",3,0],["اخسئي لا تجاوزي قدْرَ وهمٍ","هو طرزٌ والفهم في الله طرز",10,"ز",1,0],["اخسأْ لَحَاكَ اللّهُ كلبَ دَنَاءَةٍ","كلباً يروح على النِّباحِ ويغْتدي",11,"د",2,1],["إخس كلباً فما لشتمك إلا","حجر يترك الرمايا شظايا",12,"ا",3,0],["أَخسُّها لَم يَنلهُ الكسفُ في زَمَنٍ","وَلَيسَ يُكسفُ إِلّا الشّمسُ وَالقمرُ",13,"ر",1,0],["أخسا فقولك طائح كهباءة","طاحت بها هوج الرياح المعصفة",14,"ف",2,0],["اِخسأ عليّ فَلَيس كُفؤك غَير ما","يَجري مِن الأَعفاج وَالأَمعاء",15,"ا",2,0],["أخسس بمجلس معشر","ما فيه إلا الطنز بر",16,"ر",1,1],["اخس يا كلب إذ نبحث فإني","لست ممت يجيب نبح الكلاب",17,"ب",1,0],["أخسَرني مالي وعقلي الهوى","وما بيَ المالُ بُعيدَ الحجى",18,"ج",2,0],["أخس بقية من قوم عاد","إذا عقد الحبا فعلى ارتداد",19,"د",1,0],["أَخسَرُ من أَبصَرتَ في الحَياةِ","مَن جادَ بِالسُقيا عَلى المَواتِ",20,"ت",1,0],["اخسأ أيا ملعونُ لستَ مُيَئِّساً","عبداً تعوَّذَ منكَ بالرحمنِ",21,"ن",1,0],["اخسأ ورددْ أكاذيباً فكم زعمت","تلك المزاعم أقوامٌ غدوا رمما",22,"م",2,0],["١٢-أ خسفاً أُسام وذكري تجلّى","بذكرٍ حكيمٍ وآيٍ طوال",23,"ل",1,0],["اخْسَأْ ولا تطغى أيَا سِلَمِي","أَتَرُومُ ذُلَّ الدِّينِ وَالْقِيَمِ؟!",24,"م",1,1],["أخسى مِن القردِ أدهى مِن مُزعّفةٍ","أهدى إلى الشَرِّ مِن فاشٍ ومِن تتري١٣",25,"ر",2,0],["إخْسأْ صليباً فلن تبقى بها أبداَ","بدارِ أحمدَ ما طَرْفٌ بها طَرَفَا",26,"ف",2,0]]}