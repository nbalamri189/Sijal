{"poems":[[55,"أرى وجوها وأيمانا مقفلة","https://www.aldiwan.net/poem30515.html","البسيط"],[53,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[87,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[58,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39557","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142001","الرمل"],[96,"المعبد المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15623",""],[113,"رجب يفوق أهلة الأعياد","https://www.aldiwan.net/poem16455.html","الكامل"],[254,"تغيرت المنازل من سليمى","https://www.aldiwan.net/poem2124.html","الوافر"],[333,"غن عذراءك يا شاطىء","https://www.aldiwan.net/poem54988.html","مجزوء الرمل"],[342,"طاف خيال من سليمى فاعترى","https://www.aldiwan.net/poem45338.html","الرجز"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[563,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130199","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145814","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56057","الكامل"],[1354,"","https://poetry.dctabudhabi.ae/diwan/poem/205813",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95581","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87863","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123295","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79718","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216699","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206166","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101360","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90742","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/145923","الخفيف"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127927","الرجز"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[4978,"تشطير","https://www.poetsgate.com/ViewPoem.aspx?id=183247",""],[3271,"أنا شاعر الوادي وعزاف اللظى","https://www.poetsgate.com/ViewPoem.aspx?id=103536",""],[5183,"إلى ربوع مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180214",""],[5431,"زرياب وآلته ...","https://www.poetsgate.com/ViewPoem.aspx?id=205152",""],[5431,"عبدة الشيطان ....","https://www.poetsgate.com/ViewPoem.aspx?id=207545",""],[470,"لي نجمةٌ هُدبُها أضعاف أهدابك!","https://www.poetsgate.com/ViewPoem.aspx?id=178022",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[6268,"عودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82936&r=&rc=22",""]],"verses":[["مُعَبِّسينَ لَئَلّا يُحدِثوا طَمَعاً","لِلسائِلينَ وَلا يوفوا بِمَوعودِ",0,"د",1,0],["مَعْبَدٌ في الغناء وابن سُرَيْج","وَهْيَ في الضَّرْبِ زَلْزَلٌ وعَقيدُ",1,"د",1,0],["معبداً للجمالِ والحبِّ شِعْرِيًّا","مَشيداً على فِجاجِ السِّنينِ",2,"ن",1,0],["معبداً ساحراً مباخِرُهُ الزَّه","رُ على الصَّخرِ والثَّرى والغُصونِ",2,"ن",1,0],["مَعبَدُ الدَولَتَينِ في مِصرَ وَإِسحا","قُ السَمِيَّينِ رَبِّ مِصرٍ وَجارِهِ",3,"ر",2,0],["مَع بَعِيدَيْنِ أَحْرَزَا نَسَباً","مَعْ بُعْدِ دارٍ عَنْ ذلكَ النَّسَبِ",4,"ب",1,0],["معبدٌ للطيور راهبهُ اللي","لُ وناقوسه الصّبَا الرنّانَه",5,"ن",2,0],["معبدي معبدي دجا الليلُ إلا","رعشة الضوءِ في السراج الخفوقِ",6,"ق",1,0],["مَعبدٌ للجمال والسحر والفت","نةِ يُغدى لقدسِه ويُراحُ",7,"ح",1,0],["مَعْبَدٌ لِلأَسْرَارِ قَامَ وَلَكِنْ","صُنْعُهُ كَانَ أَعْظَمَ الأَسْرَارِ",8,"ر",1,0],["معبداً قامت على دين الهوى","ذاك دين الحق بل دين الأبد",9,"د",1,0],["معبد للهوى الأثيم بنينا","الفجر فيه والمشرق الذهبيّا",10,"ي",2,0],["مَعبود حُسن كَم تَفتن إِذ بَدا","في حُسنِهِ الفَتّان مِن عِباد",11,"د",1,0],["مُعَبَّدَةِ السَقائِفِ ذاتِ دُسرٍ","مُضَبِّرَةٍ جَوانِبُها رَداحِ",12,"ح",1,0],["معبدٌ أنت لقلبي","مسرَحٌ أنت لعيني",13,"ي",1,0],["مُعَبَّدٍ يَهدي إِلى ماءٍ صَرى","طامي الجِمامِ لَم تُكَدِّرهُ الدَلا",14,"ا",1,0],["معبساً لوجهه محمضا","في بردة الموت إذا تعرضا",15,"ض",2,0],["معبوده به عليه مقبل","لا ذاك معنى في الخيال يأفل",16,"ل",1,0],["معبس جاء يسقيني الطبيب دواً","مر المذاق لدى حرب اذا غضبا",17,"ب",2,0],["مُعَبَّأ ٌبالمَواويل ِالحَزينةِ يا","قلبي ومُمتليءٌ بالموتِ يا أرقي",18,"ق",2,0],["مع بثَّ شوقٍ صادرٍ من مهجةٍ","حرّى وقلب هايمٍ متصببِ",19,"ب",1,0],["مع بني عمّه وهاليها","شيخ مَنْوى الشعب منواله",20,"ل",2,0],["معبود أجدادنا كم فيك من منن","أصبت بموردك الأقوام يا نيلُ",21,"ل",1,0],["مِعبداً عبداً وبعه إن أبى","وعلى إسحاقَ بالنعلِ اسحقِ",22,"ق",1,0],["مَعبَدٌ خالِدٌ عَلى الدَهرِ ما غَن","نى هَزارٌ وَسَجَّعَت قُمرِيَّه",23,"ي",2,0],["مع بدر تمٍّ نحيل الخصر مُرتدف","ما عاب وجنته بالشعر تنميش",24,"ش",1,0],["مَعبُودُهُ مَوطُوءُهُ فِيهِ يَرَى","وَصفَ الجَمَالِ وَمَظهَرَ الإحسَانِ",25,"ن",1,0],["مَعَ بَحثِهِم وَمُصَنَّفَاتٍ قَصدُهُم","مِنهَا وُصُولُهُمُ إلَى العِرفَانِ",25,"ن",1,0],["مَعَ بَوَادِيهَا لِحَدِّ الجودي","على مشارِق حُمصٍ المَعهُودِ",26,"د",1,0],["معبودتي رفقاً بعبك إنه","لا يعرف السلوان فيك ولا العزاء",27,"ا",2,0],["مع بولسَ الجاني السُمَيساطي الذي","اضحى كعُضوٍ ميِّتٍ مُنهانِ",28,"ن",1,0],["معبودة فيما تحل كأنها","ظل الإله على الخلائق يُعبد",29,"د",1,0],["معبدٌ للحياة نكَّسه الده","ر فأعظم بالمعبد المنهار",30,"ر",1,0],["معبق الريط في ردع الخلوق شذاً","كأن نشر سليم العرض عبقه",31,"ق",2,0],["مع بدر يحتسون الشمس في","أنجم الكاسات من برج الدنان",32,"ن",1,0],["مع بدور يحتسون الشمس في","أنجم الكاسات من برج الدنان",33,"ن",1,0],["معبد الشام يجمع الناس طرأ","وإليه شوقا تميل النفوس",34,"س",1,1],["مع بث اشواق القلوب الوافره","تلك التي عن الصميم صادره",35,"ه",1,0],["مُعَبِّراً بِذَراهُ عَن ذَرى مَلِكٍ","مُستَمطَرِ الكَفِّ وَالأَكنافِ مَمطورِ",36,"ر",1,0],["(مع بعض هذا الشعر أرفق كسرةً )","فالخبزُ أيضًا مطلبُ الإنسانِ",37,"ن",1,0],["معبود قومٍ كلما نادى بهم","سجدوا لديه ضلالةً وتأثّما",38,"م",2,0],["معبودكم أوطأته قدميّ عن","عمد فكيف يقول أهل الدين",39,"ن",1,0],["معبودي الآن في روحي أخزنه","قاتا من التمر في تحشيشة السحر",40,"ر",1,0],["معبودهم شبقٌ بالدمّ منغمسٌ","أحجار معبده : عظم المساكين",41,"ن",1,0],["معبودتيَ لم تُصبِّغْ لي أظافرَها","يوماً.. ولا قدَّمَتْ لي مثلَ ألعابِكْ",42,"ك",1,0],["مَعبد الحبِّ شِيدَ في قفص القل","ب مُحاطاً بالظلِّ من قَصَباته",43,"ت",2,0],["معبد الحبِ رفعنا صرحهُ","وسجدنا في زواياهُ خشوعا",44,"ع",2,0]]}