{"poems":[[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[556,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88609","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132539","الرمل"],[5784,"زمن العقوق","https://www.poetsgate.com/ViewPoem.aspx?id=199041",""]],"verses":[["كَلِمٌ أَثَرْتُ بِها جَوَادَ بَراعَةٍ","لا يُقْتَفَى في الْحُضْرِ وَالتَّقْريبِ",0,"ب",1,0],["كلّما ثبّطنِي عن مرامٍ","زادنِي ضنّاً به واِعتِلاقا",1,"ق",2,0],["كلما ثقف الزَفير ضلوعي","قلت زيدي على الزَفير انحناءا",2,"ا",3,0],["كلما ثار سحاباً جيشهم","عصفت فيه المنايا فانسحب",3,"ب",1,0],["كلما ثارتْ ..بالقوافي القوافي","أعلنوا دون غيرهم بمروقِي",4,"ق",2,0]]}