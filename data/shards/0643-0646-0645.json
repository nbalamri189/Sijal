poetry.dctabudhabi.ae/diwan/poem/114470","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114154","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133230","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136808",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102744","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102733","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90939","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83566","الخفيف"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139186","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139670",""],[4750,"عبدالعزيز بن تركي","https://www.poetsgate.com/ViewPoem.aspx?id=180420",""],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[4796,"من المعارضات","https://www.poetsgate.com/ViewPoem.aspx?id=181324",""],[4814,"ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=193408",""],[5074,"إلى ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=153514",""],[5191,"غزلٌ لا إراديّ","https://www.poetsgate.com/ViewPoem.aspx?id=212086",""],[5232,"ألحان السَّلام","https://www.poetsgate.com/ViewPoem.aspx?id=213566",""],[5376,"دَعْ عنك هَمَّ الدنا يا قلبُ تبْتَسِمِ","https://www.poetsgate.com/ViewPoem.aspx?id=214187",""],[5413,"ليلة الغرباء","https://www.poetsgate.com/ViewPoem.aspx?id=208657",""],[5431,"للدار أنت مودِعٌ وموَدّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=196999",""],[5512,"يا أيها الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=204865",""],[5525,"زمان الشح","https://www.poetsgate.com/ViewPoem.aspx?id=943",""],[5703,"كن مطمئنا","https://www.poetsgate.com/ViewPoem.aspx?id=215960",""],[4623,"لست أحصي على النبي ثناء ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146852",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[5848,"رباعيات","https://www.poetsgate.com/ViewPoem.aspx?id=48997",""],[5956,"ناجيتُ ناجي","https://www.poetsgate.com/ViewPoem.aspx?id=207203",""],[5970,"كن مع الناس تر الناس معك","https://www.poetsgate.com/ViewPoem.aspx?id=130589",""],[5977,"إلى فلذة الكبد","https://www.poetsgate.com/ViewPoem.aspx?id=213284",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[3304,"حواء أم جنية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=135617",""],[6097,"نُورُ الأُخُوَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=190690",""],[6202,"القتل فيكم قد وجبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86743&r=&rc=44",""]],"verses":[["كُنْ مِنْ صُروفِ الرّدى على حَذَرِ","لا يَقْبَلُ الدّهْرُ عذْرَ معتَذِرِ",0,"ر",1,1],["كُنَّ موتى بنات فكرِي ولكن","بعثت من مقامك المحمود",1,"د",1,0],["كن مثل نفسك في السموّ إلى العلى","لا مثل طينة جسمِك الغدّارِ",2,"ر",1,0],["كُن مَعَ الفَجرِ نَسمَةً توسِعُ الأَز","هارَ شَمساً وَتارَةً تَقبيلا",3,"ل",2,0],["كُن مِثلَ يوسُفَ لَمّا كادَ إِخوَتُهُ","سَلَّ الضَغائِنَ حَتّى ماتَتِ الحِقَدُ",4,"د",1,1],["كُن ما اِستَطَعتَ عَنِ الأَنامِ بِمَعزِلٍ","إِنَّ الكَثيرَ مِنَ الوَرى لا يُصحَبُ",5,"ب",1,0],["كنْ مِنْ أولي العلمِ ولو خاملاً","وارضَ بما يقسمُهُ الرازقُ",6,"ق",1,1],["كُن مَوسِماً لِمَطامِعي أَو مَيسَماً","في جَبهَتي أَو مِغفَراً في مَفرِقي",7,"ق",2,0],["كُن مَن تَشاءُ مُهَجَّناً أَو خالِصاً","وَإِذا رُزِقتَ غِناً فَأَنتَ السَيِّدُ",8,"د",1,0],["كُن مِن الرومِ أَو مِنَ التُركِ أَو","سابِحٍ أَو فارِسٍ أَو الإيخاز",9,"ز",1,0],["كنمِر أدار عين","نًا في الدجى وقلبا",10,"ب",2,0],["كُنْ مُلْتَقَى لأَشِعَّةٍ مِنْ لَحْظِهَا","تُرْمَى بِهَا عَنْ قَوْسِ أَرْأَفِ حَاجِبِ",11,"ب",1,0],["كُن مَعَ الجَماعَةِ لا","تُردَ مَع مُغَرِّرِها",12,"ر",3,0],["كُنْ معي يا قريض تُلهمني الف","نَّ فأشدو بأروع الألحان",13,"ن",1,0],["كن مع الفجر نسمة توسع الأزهار","شمّا وتارة تقبيلا",14,"ل",2,0],["كنْ مَن تشاءُ مُهجَّناً، أو خالصاً","، وإذا رُزِقتَ غنًى فأنتَ السيّد",15,"د",1,0],["كنْ مثل خلك لا يضعضع قلبَه","تكرارُ قيلي في الأنامِ وقالِ",16,"ل",1,0],["كنْ من الدنيا على وَجَلِ","وتَوَقَّعْ بَغْتةَ الأَجَل",17,"ل",1,1],["كن مع الناس كما أن","ت مع النار المنيره",18,"ر",2,0],["كَنمرودَ لكن لا سلامَ لنارهِ","وَفي بحرهِ فِرعونُ لا يحسنُ العَبرا",19,"ر",2,0],["كن مثلها لي جذباً في دمي وهوى","او كن دلالا وكن سحراً وكن تيها",20,"ي",3,0],["كُن مَن تَشاءُ كُنِ الدُنيا بِكامِلِها","فَلَستَ تَعدِلُ صِدّيقاً بِميزاني",21,"ن",2,0],["كُن ما اِستَطَعتَ لِخادِعِ ال","طَمَعِ المُذِلِّ مُخَيِّبا",22,"ب",2,0],["كن مثل مولاك إذ قال المليكُ له","حذيفةُ الخير قولاً غير تعذير",23,"ر",1,1],["كن من أَذى الدارين نصرى واحمنى","وَلنيل ما أَرجوه موسم متجري",24,"ر",2,0],["كُن مَعَ اللَهِ يَكُن لَك","وَاِتَّقِ اللَهَ لَعَلَّك",25,"ك",1,1],["كُن مَعَ الحَقِّ كَيفَ كانَ عِياناً","وَبِهِ عُذ مِن باطِلِ التَقليدِ",26,"د",1,1],["كُن مُجيري مِن حادِثاتِ اللَيالي","وَصُروف الزَمان وَالبرَحاءِ",27,"ا",2,0],["كن مثل طفلٍ علا عن كل مُنكَرةٍ","ما كلُّ حُسنٍ يروق العين بالحَسن",28,"ن",1,0],["كن محسناً تحسمْ ملامةَ لائمٍ","فاللُؤمُ يُغري الخُلقَ أن يتخلقا",29,"ق",2,1],["كن معدياً وكن مخشوشناً","لا تكن ظرف طعام وشراب",30,"ب",1,0],["كُن مِثلِ دَهرِكَ إِن حارَبتَهُ أَبَداً","إِن يَستَقِم فاستَقِم واعثُر إِذا عَثَرا",31,"ر",2,0],["كُن من ملاحظ عينيها عَلى حذرٍ","فَإِنَّما لَحظُها أَمضى مِنَ القَدَرِ",32,"ر",1,0],["كُنْ منْه إن كان القَوِيْ","يَ أو الضَّعيفَ على حَذَرْ",33,"ر",1,0],["كن مسعدي إن حالي قد غدا عجبا","في الجفن ماء وفي الأحشاء نيران",34,"ن",1,0],["كن منهم حيثما كانوا على ثقة","واقطع سواهم وخذ في الوزن ما رجحا",35,"ح",2,0],["كنْ مسيحاً يعيدُهُ اللهُ يوماً","كيْ يذوبَ كالمِلحِ منْهُ الظّلومُ",36,"م",1,0],["كن محسناً أو مسيئاً وأبق لي أبداً","تكن لدي على الحالين مشكورا",37,"ر",2,0],["كُن مالِكاً قمَم السّاداتِ كلِّهمُ","أو لا فكن مفرداً في قِمّة القُوسِ",38,"س",1,0],["كن مؤمناً بهما إن لم يكن لهما","فيك اقتدارٌ فللرحمن إقبال",39,"ل",1,0],["كن مع الله تَرَ الله معَكْ","واترك الكل وحاذر طمعَكْ",40,"ك",1,1],["كن مسلماً مؤمناً بالحق تعرفه","أو لست تعرفه واتبع لأهل تقى",41,"ق",2,0],["كن معي لي مقلداً أو توقف","دائماً لا تخض مع المستغيب",42,"ب",1,0],["كنْ مادحَ المصطفى النبي تنل","بمدحه حُظوةً خيار حُظى",43,"ظ",2,1],["كنْ مُجيداً لمدح النبي تنلْ","ما تحبُّ وتبلغْ بذاك الأملْ",44,"ل",1,1],["كن مثل اسمك سالماً","من سهم رامية السننْ",45,"ن",1,0],["كن مُسعدي فضلاً وكن ساعدي","لا نفع في كف بلا ساعد",46,"د",1,0],["كن مجيري إذا الكريم تجلى","بانتقام ليخزي الفجارا",47,"ر",2,0],["كُن مُستَريحاً في الوَرى سارحاً","بِكُل عيش نِلته راضي",48,"ض",2,0],["كن مجيري لدى المعاد فحسبي","أنت ممن يجير عند المعاد",49,"د",1,0],["كن مسعدي ما لي سواك مساعدٌ","يمحو الكروب عن القلوب ويمحق",50,"ق",1,0],["كن منقذي من أسى مازال يأمرني","ومن عدو لنفس ناظر شذر",51,"ر",1,0],["كُن مِن مَناقِبِ مَن آخاكَ مُحتَرِساً","فَرُبَّما اِنقَلَبَت شَرّاً مَناقِبُهُ",52,"ب",2,0],["كُن معيني إن أعجزتني القوافي","ونصيري في ساميات المعاني",53,"ن",2,0],["كن مُعِيني ومُجيري مُنقِذي","مِن هَوى نفسي وشيطان ألَد",54,"د",1,0],["كُنْ مُجِيرِي من حسودٍ","فِعْلُهُ حَاشَاكَ شَيْن",55,"ن",1,0],["كنمروذ بن كنعان","قويّ الصدر والأزر",56,"ر",1,0],["كُن مَن تَشاءُ وَنَل حَظاً تَعيشُ بِهِ","فَالخِصبُ في الوُهدِ مِثلُ الخِصب في الأَكَمِ",57,"م",1,0],["كُن مِثلَ مَن يُعيي وَظيفَ مَطِيِّهِ","في المَجدِ لا مُجلَنظِياً تَتَنَوَّمُ",58,"م",1,0],["كن مصلحاً لا تبغ فعلة عُنْظُبٍ","بالعَنظباءِ يرى النبات فيهشمُ",58,"م",1,0],["كن مطبوع","وابلع تقشع",59,"ع",1,0],["كن ملاذي في النائبات مغيثي","من صروف الزمان والبلواء",60,"ا",2,0],["كن معي عابثاً بعود أراك","فيه شكل من لين تلك القرود",61,"د",1,0],["كن مستعداً إذا أصبحت منحدراً","في مثل ما أنت رائيه من الحُفر",62,"ر",1,0],["كُن مَعَ الأَيّام أَلباً إِنَّما","صُلتُ في الدَّهرِ بكَفٍّ لَم تَنَلني",63,"ن",2,0],["كن مفردا عنهم وكن معهم","مثل انفراد الجليد عن جمده",64,"د",2,0],["كُن من الإخوان مثلي حذرا","وَاعرف الخَلف إِذا ما حالَفوكا",65,"ك",2,0],["كن من زمانك في حذر","وذر التنعم فيه ذر",66,"ر",1,1],["كُن من النَّاسِ كَيف شِئ","تَ عَلَى غايَةِ الحَذَر",67,"ر",1,0],["كن من عباد الله لا الشيطان","فماله عليك من سلطان",68,"ن",1,0],["كنما النيل الخضمّ إذ بدا","يَروي حديثاً وهو ذو تَسَلْسُل",69,"ل",1,1],["كن مونساً لوحشتي وراحماً","لوحدتي بخير مولودٍ أغر",70,"ر",1,0],["كن مسعدي يا صاحبي فإنما","لا بد للولهان ممن يسعده",71,"د",2,0],["كُنْ مِنْ صَديقِكَ لا مِنْ غَيْرِهِ حَذِراً","إِنْ كانَ يُنْجيكَ مِنْهُ شِدَّةَ الحَذَرِ",72,"ر",1,0],["كُنْ مثلَ سابورٍ غَداةَ شَفَى","غيظَ الصُّدُورِ وأَدركَ التبْلا",73,"ل",2,0],["كن مصلحا إن كان غيرك مفسدا","فإن على كل الخلائق حارسا",74,"س",2,0],["كُن مُحسِناً فيما اِستَطَعتَ فَرُبَّما","تُجزى عَنِ الاحسانِ بالإِحسانِ",75,"ن",1,0],["كُن مثلَ ذي الأَسباط ليسَ وكونُهُ","يعقوبَ لكن وَهوَ إِسرائيلُ",76,"ل",1,0],["كن مستعداً للمحاربة التي","من دونها لا نصرَ من ربّ العَلا",77,"ل",2,1],["كن موضعي ولأكن رسما فذلك لي","خير وخذ فكرتي والطرس والقلما",78,"م",2,0],["كن مطيعاً لمن تحب وتهوى","أنسهُ بمذلةٍ وهوانِ",79,"ن",1,1],["كُن مِثلَ صُورةِ بَدرٍ وَافِياً أبَداً","بِوَعدِهِ مُبهِجاً لَنَا بإِسعَادِ",80,"د",1,1],["كن مجيري مما ألاقي فإني","قل صبري وضاق صدري بدائي",81,"ي",1,0],["كن مسلم لها فرحان راضي بما أهدت","وألزم الباب دونب إن سدت الباب وأسدت",82,"ت",1,0],["كن منقذي من صرف دهر نابه","أبدا لمثلى في الورى عظاظ",83,"ظ",1,0],["كن منقذي مما جنيت فأنت من","يرجى ويقصد في ابتغاء نجاح",84,"ح",1,0],["كن مفيداً أخاك أو مستفيدا","منه تزد هدى ورأيا سديدا",85,"د",2,1],["كُن مَع الحَقّ لا مع الخَلق ترقى","كُن مع اللَهِ فهيَ خَيرُ مَعِيَّه",86,"ي",2,0],["كن مع الناس كيف كانوا ووافق","إن من لا يوافق الناس مائق",87,"ق",1,1],["كن معيناً لواحد الخلق فضلاً","حجةٍ للإسلام فيه الحبور",88,"ر",1,0],["كن مقدمه للضيوف يصيح وينوّه","مثومن تمرح البل بين أطانيبه",89,"ب",2,0],["كن مابين الضلوع آلة طباعة","تشتغل لانمت وأقوم مرتاعي",90,"ع",2,0],["كن ما عهِدتُك صابراً ومُصابِراً","والصبحَ مَوْسِقْ شادياً ومزغردا",91,"د",2,0],["كن منّي خفقةَ شرياني","ليبوحَ النبضُ منَ الجوهر",92,"ر",1,0],["كُنْ مَشْعَلاً وَمَنَاراً يُسْتَضَاءُ بِهِ","وَافْعَلْ كَمَا تَقْتَضِيْ الأَخْلاقُ وَالقِيَمُ",93,"م",1,0],["كنْ منصفًا وامننْ بوصلِك","فالنّوى بالهجرِ مَنّ",94,"ن",1,0],["كنْ معي قلبا ً وفكرا ً نيِّرا ً","لانتصار الحقِّ عاما ً بعدَ عامْ",95,"م",1,0],["كنْ معي صوتا ً سماويَّ الصَّدى","نغمر ِالأرضَ بألحان ِ السلامْ .",95,"م",1,0],["كن مقسطاً أبداً في الحقِّ من قِوَلٍ","لا تمشِ جنباً بلا لاءٍ ولا نَعَمِ",96,"م",1,0],["كنْ ما تريدُ فلنَ تكونَ قصيدتي","الأولى ولا ناموسها الممدودا",97,"د",2,0],["كن مخلصا متفانيا لا ترعوي","عمّا يفيضُ من السخاء فتمنعُ",98,"ع",1,0],["كنْ مثلَ نجمِ سُهيلِ في السَّما أَلِقٍ","وكنْ كَسْمْتٍ يناجي كلَّ مُبْتَعِدِ",99,"د",1,0],["كن ما به ارض لا نهر وبحر","كيف جرح الأرض يشفي في الصميم",100,"م",1,0],["كُنْ مُطمئنّاً لاتُغَيّرُني النَوى","لو كالجبالِ غدَتْ بها آلامي",101,"م",2,0],["كن مجيري دنيا وأخرى وكن","لي واكسني من بها رضاك رداء",102,"ا",2,0],["كن مجيري ومجيزي بالرضا","لي مع الأحباب في كل مقام",103,"م",1,0],[":كُنْ مريضاً لترتجي دعمَ غرّ","وتَمارَضْ ببابِ كلِ سِفارهٍ",104,"ر",2,0],["كن موتي في شراييني تهادى","من بعد خطوتك ما اقفت عن حدودي",105,"ي",1,0],["كنْ مثلَه الغيريَّ واتركه لهم","أوقاتُه مُلْكٌ لغوثِ السوري",106,"ر",2,0],["كن مع الناس تر الناس معك","ولدى العثرة كل دعدعك",107,"ك",1,1],["كن معي قلباً وحباً صادقاً","كن رفيقي كن شقيقي الأقربا",108,"ب",2,0],["كُنْ ملاذًا لنا ، وبأسًا على أع","دائنِا واهدِنَا سَبيلَ الخوَالِي",109,"ل",2,0],["كنموذج الفنان هيأها","مستلهماً من سبطها النضر",110,"ر",1,0],["كُنْ مِثْلَ جَوْدِ غَمَامٍ مِنْ تَواضُعِهِ","قدْ فَارَقَ البَغْشَةَ الشَّمَّاءَ لِلتُّرْبِ",111,"ب",1,0],["كن مثل مازن هاربا","وأرح , أرحنا بالهرب",112,"ب",1,0]]}