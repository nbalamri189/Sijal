{"poems":[[85,"هب النسيم على الرياض مع السحر","https://www.aldiwan.net/poem54309.html","الكامل"],[49,"ياطيب ليلة ميلاد لهوت بها","https://www.aldiwan.net/poem25282.html","البسيط"],[80,"القلب قد لج فما يقصر","https://www.aldiwan.net/poem14004.html","السريع"],[91,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[91,"جاء الربيع وورد الرمان","https://www.aldiwan.net/poem44908.html","الكامل"],[68,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[50,"بدير بهرذان لي مجلس","https://www.aldiwan.net/poem65291.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54773","السريع"],[130,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[164,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[214,"ثبوت حسنك لي فيه شهادات","https://www.aldiwan.net/poem13336.html","البسيط"],[214,"جارت على مهجتي ظلما وما عدلت","https://www.aldiwan.net/poem13337.html","البسيط"],[266,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[285,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[287,"تألق البرق له عشيا","https://www.aldiwan.net/poem32299.html","الرجز"],[287,"هذا الحمى ورنده وبانه","https://www.aldiwan.net/poem32404.html","الرجز"],[287,"هل شرب البان شمولا فمال","https://www.aldiwan.net/poem32636.html","السريع"],[287,"هب نسيم بالطل مبلول","https://www.aldiwan.net/poem32639.html","المنسرح"],[287,"هل دهرنا الماضي يعود","https://www.aldiwan.net/poem32804.html","مجزوء الكامل"],[310,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[457,"يا مؤثرا للهو طيب النعمه","https://www.aldiwan.net/poem13927.html","الكامل"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[487,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[591,"يا رب قد علقته","https://www.aldiwan.net/poem17603.html","مجزوء الكامل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53720","البسيط"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/98004","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44580","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122374","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64091","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38961","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38278","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77653","المنسرح"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119293","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120071","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119938","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59070","الدوبيت"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59067","البسيط"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118155","السريع"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122049","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105853","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53153","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53219","السريع"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99094","البسيط"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100443","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87693","السريع"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140080",""],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138922",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74159","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74258","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132597","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121685","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108343",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45781","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86541","الكامل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116893","الكامل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105257","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78334","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73223","البسيط"],[4578,"ريم النقا بالله غني سلاه","https://www.poetsgate.com/ViewPoem.aspx?id=49603",""],[5106,"سَاْجَ الهَوَىْ وًرِشَاً ..","https://www.poetsgate.com/ViewPoem.aspx?id=137169",""],[5106,"دَوَّخَنِيْ حُبُّكِ يَا امْرَأَةً ..","https://www.poetsgate.com/ViewPoem.aspx?id=137209",""],[5136,"يا راقد الليل لم تشعر لمن سهرا","https://www.poetsgate.com/ViewPoem.aspx?id=121584",""],[5145,"راق الهواء ورقّت الخمر","https://www.poetsgate.com/ViewPoem.aspx?id=108073",""],[5145,"أنّى اهتديت لنا يا طيفها الساري","https://www.poetsgate.com/ViewPoem.aspx?id=108208",""],[5145,"هذا الربيع وهذه أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=108102",""],[5184,"على باب الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=186051",""],[5436,"السفر الى ضفاف الرافدين (محمود محمد أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=58602",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""]],"verses":[["والنرجس المطلول يرنو نحوها","بلواحظ دمعُ الندى منها انهمَرْ",0,"ر",1,0],["وَالنَرجِسُ الغَضُّ يَحكي حُسنُ مَنظَرِهِ","صَفراءَ صافِيَةٍ في كَأسِ بَلَّورِ",1,"ر",1,0],["وَالنَرجِسُ الفَوّاح غَبَّ النَدى","في رَوضهِ وَالمَندَلُ الأَذفَرُ",2,"ر",1,0],["والنرجس الوسنان عن","غمز البلابل غافل",3,"ل",1,0],["والنرجس الفياح تنظر عينه","شزراً اليه كأنه حردان",4,"ن",1,0],["وَالنَرجِسُ الغَضُّ لَم تُغضَض نَواظِرُهُ","فَزَهرُهُ بَينَ مُنغَضٍّ وَمَزرورِ",5,"ر",1,0],["وَالنَرجِسُ الغَضُّ لَدى وَردَهُ","وَالوَردُ قَد حُفَّ بِنِسرينِهِ",6,"ن",2,0],["وَالنَّرْجِسُ النَّضْرُ إِلى نَرْجِسٍ","يُظْلَمُ إِنْ قِيسَ إِلى نِدِّ",7,"د",1,0],["والنرجس الغضّ كالعين التي نظرت","إلى محب لها ترجوه إحسانا",8,"ن",2,0],["والنرجس الغض يغض طرفه","فينظر الورد إليه شزرا",9,"ر",2,0],["والنرجس الغض لم تبرح تغازلنا","عيونه ولها بالجفن غمزات",10,"ت",1,0],["والنرجس الغض عنها غض ناظره","من الحيا وخدود الورد قد خجلت",11,"ت",1,0],["والنرجس الغض سقاه الوبل","تلحظنا منه عيون نجل",12,"ل",1,0],["وَالنَّرْدُ كالنّلوَرْدِ فِي مَجالِها","أَوْ كَالْمَجُوسِ ضمَّها ما شُوشُها",13,"ش",3,0],["وَالنَرجِسُ الغَضُّ زُمُرُّدِيُّهُ","في الذَهَبِيِّ عانَقَ الفِضِيّا",14,"ي",2,0],["وَالنَّرجِسُ الغَضُّ رَنَت أَحداقُهُ","وَاِفتَرَّ بِالعُذَيبِ أُقحُوانُهُ",15,"ن",2,0],["وَالنَّرجِسُ الغَضُّ عَلى السُندس ال","أَخضَرِ مِنهُ بُسطُهُ وَالزِلال",16,"ل",1,0],["وَالنَرجِسُ الغَضُّ طَرفُهُ غَنِجٌ","بِصُفرَةِ الزَّعفَرانِ مَكحولُ",17,"ل",1,0],["وَالنَّرجِسُ الرَيّانُ في","قُضُبِ الزَّبَرجَدِ ما يَميدُ",18,"د",1,0],["وَالنرجسُ الراني الجفون مغازلٌ","للأقحوانِ المُزدهي بتبسّمِ",19,"م",1,0],["والنرجسُ الغضُّ به جرجاني","والنوفرُ المطول نهرواني",20,"ي",1,0],["وَالنَرجِسُ البَرزِيُّ زَهرُ مونِقِ","مِثلُ عُيونٍ لِعُيونٍ تَرمُقُ",21,"ق",1,0],["والنرجس الغض غض الطرف حين رنا","الرفق شيمتكم والبين منزعج",22,"ج",1,0],["وَالنَّرْجِسُ الغَضُّ الَّذي","في نَاظِرَيْهِ تَأَلَّفَا",23,"ف",2,0],["والنرجس الغضّ قد حانت مقاطفه","كأنهنّ عيون مالها هدُبُ",24,"ب",1,0],["والنَّرْجِسُ الغضُّ الذي أَحْدَاقُهُ","تَرْنُو لِتَفْهَمَ ما يقولُ خُزَامها",25,"م",3,0],["وَالنَرجِسُ الرَيّانُ بَينَ رِياضِهِ","يَرنو بِعَينِ الباهِتِ المُتَحَيِّرِ",26,"ر",1,0],["والنرجس اصطف وما","احسن صف الملك",27,"ك",1,0],["والنرجسُ الأبلقُ والنفسُ لا","تملُّ قربَ النرجس الأبلق",28,"ق",1,0],["وَالنَّرْجِسُ الغضُّ النّضير فَسوقُه","قُضبُ الزّمرُّدِ تَشرحُ المَغموما",29,"م",2,0],["وَالنّرجِسُ الغضُّ في سوقِ الزّمرُّدِ كَم","يَميسُ تيهاً وَيُبدي غايَةَ الفخرِ",30,"ر",1,0],["وَالنَرجس الغَض يا حَبيبي","حاجِبُهُ في الرِياض نُونُ",31,"ن",1,0],["والنرجس الغض الجني كأنه","حدق تراقب غادة مع جؤذر",32,"ر",1,0],["والنرجس الغض ساه","إلى بهار بهيرِ",33,"ر",1,0],["والنرجس الخصل المحدق ناظر","نحو الشقيق الغضر نظره مبلسِ",34,"س",1,0],["والنرجسُ بَاتَ سَاهرَ الأجْفَانِ","سَاهِي الحَدَقِ",35,"ق",1,0],["والنرجس الغض نَادَى الزهْرَ مبتسماً","يَا ضَاحكَ الثغر سَامِ سَامِيَ الحَدَقِ",36,"ق",1,0],["والنرجس الغض اعتراه الحيا","فغض طرفاً فيه أسقام",37,"م",1,0],["والنَّرْجِسُ المَطلُولُ قَدْ أَهْدَى شَذىً","كَالْمِسْكِ فُصَّ خِتَامُهُ فَتَذَاكَا",38,"ك",2,0],["والنَرجسُ المصفَرُّ ليس بِنافعٍ","ميتاً ولا في الرَوض إذ هو وافِدُ",39,"د",1,0],["والنَّرجِسُ الغضُّ الجميلُ تمايَلَت","أعطافُهُ بالوردِ والأكمامِ",40,"م",1,0],["والنرجس الغضّ يغض أعيناً","عن ثغره ولاثم شقائقا",41,"ق",2,0],["والنرجس الغض بألحاظه","والصدر قد أنبت رمانا",42,"ن",2,0],["والنرجس الغض منهل مدامعه","كأن أجفانه أجفان وسنان",43,"ن",1,0],["والنرجس الغض من عينيك ما برحت","أفعى الغدائر عن عينيك تحميه",44,"ي",2,0],["وَالنَرجسُ الناعس قَد طَلَّه","قَطر النَدى يُخضِله وَاقعه",45,"ع",2,0],["والنرجس الغض في الالحاظ منبته","يرنو فتجرح احشانا محاجره",46,"ر",2,0],["والنرجس الغض معانق الكبا","يرنو إلى الورد بطرف أحور",47,"ر",1,0],["وَالنرجس الغَض يَرنو نَحوَ نَرجسها","شزراً فَيَضرب أولاها بِأُخراها",48,"ا",3,0],["وَالنَرجس الغض يَرنو نَحوَ ناظره","وَيَفتح الجفن مِنهُ وَهوَ مَكسور",49,"ر",1,0],["والنرجس المطلول يرنو طونه","فكأنه يرنو بطرف فاتر",50,"ر",1,0],["والنَّرْجِسُ الغَضُّ يُنادِي في الرُّبَى","أبْشِرْ بما سَرَّ بعيْني تخْتلِجْ",51,"ج",1,0],["والنرجس الغض في البستان مغرسه","ناءٍ ونكهته منا على أسم",52,"م",1,0],["وَالنَرجس الغَض في أَجفانه سَقم","عَن اللَواحظ يَروي صحة الخَبَر",53,"ر",1,0],["والنرجس الملتف أل","بس جسمه ثوباً مفرج",54,"ج",1,0],["والنرجس الغضّ الذكيّ محاجر","تعبت من التسهيد والتأريقِ",55,"ق",1,0],["والنرجس العطر الشذا وشقائق","النعمان والورد الجني بشعبه",56,"ب",2,0],["وَالنَرجِسُ الغض غض الطرف من خجل","وَمال ميلة ذي خوف وَاِشفاق",57,"ق",1,0],["والنرجس الغض في الرياض زها","أم لحظه البابلىّ قد فترا",58,"ر",2,0],["والنرجس الغض رنا","لآسه إنسانه",59,"ن",2,0],["والنَّرجسُ الغَضُّ قد أَضحَت محاجِرهُ","تَحكي فُتورَ عُيونِ الخُرَّدِ العِينِ",60,"ن",1,0],["والنرجس الغض بأىحداقه","يدير راح الأنس فينا صفاه",61,"ا",2,0],["وَالنَّرْجَسُ الْطِّيْبُ مِنْ وَجْدٍ لَنَاْ وَقَفَتْ","فَوْقَ الصَّبَاحِ بِأَضْمُوْمِ الْنَّدَىْ حَرَسَا",62,"س",2,0],["وَالنَّرْجَسُ يَطْلَعُ فِيْ خَدٍ","وَالرَّنْدُ النَّاْعَسُ فِيْ فِيْهَاْ",63,"ي",3,0],["والنرجس الغض غض الجفن حين رنا","واحمر ورد الربا من خده خفرا",64,"ر",2,0],["والنرجس المخمور في يده","كاس تحقق أنها تبر",65,"ر",1,0],["والنرجس الغضّ موهوّاً بنضرته","دراهماً وضحاً حفت بدينار",66,"ر",1,0],["والنرجس العيار أبرز نقده","هذاك در همه وذا ديناره",67,"ر",2,0],["والنرجسُ المذبوحُ في بلدي يُسا","ئلني اما هَدّ البُكا ذبّاحي",68,"ح",2,0],["والنرجسيُّ على الأحلامِ مدَّ المُدى","تلك المقابرُ تحوي مَنْ وعى السَّبَبا",69,"ب",2,0],["وَ النَّرجِسُ البَرِّيُّ فِي","كَفَّيَّ أَذواهُ الجُحُودْ",70,"د",1,0]]}