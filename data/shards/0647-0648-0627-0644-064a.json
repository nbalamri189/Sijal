{"poems":[[55,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[55,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[95,"هو اليوم لن أنساه ما ظلت باقياً","https://www.aldiwan.net/poem11093.html","الطويل"],[46,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[35,"خلت عن ثرى نجد فما طاب بعدها","https://www.aldiwan.net/poem25721.html","الطويل"],[107,"سأتبع يوم السبت ما عشت لعنة","https://www.aldiwan.net/poem42139.html","الطويل"],[146,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[147,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[275,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[314,"أفي السبخات يا مغبون تبني","https://www.aldiwan.net/poem50299.html","الوافر"],[333,"ألا إن سكرى سكر عبد له كأس","https://www.aldiwan.net/poem54940.html","الطويل"],[376,"هو اليأس إلا من حديث مقوت","https://www.aldiwan.net/poem57517.html","الطويل"],[402,"هو اليوم لن أنساه ما ظلت باقيا","https://www.aldiwan.net/poem10956.html","عموديه"],[463,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[463,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[484,"حللت مكانا في الكهولة بعدما","https://www.aldiwan.net/poem37177.html","الطويل"],[484,"سلام عليكم من ورا البحر أينما","https://www.aldiwan.net/poem37606.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138229",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126842","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48792","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70804","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16857","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137864",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93589","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93542","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105672","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130803",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204456","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62823","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48315","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76442","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139530",""],[4755,"بالمقلوب","https://www.poetsgate.com/ViewPoem.aspx?id=184514",""],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""],[5206,"تقريظ كتاب الاستقامة للكُدَمي","https://www.poetsgate.com/ViewPoem.aspx?id=187427",""],[5281,"اليمنُ.. لا يموت!","https://www.poetsgate.com/ViewPoem.aspx?id=203067",""],[5353,"الآتي الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212460",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5444,"صفيُّ العِلم","https://www.poetsgate.com/ViewPoem.aspx?id=205525",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""]],"verses":[["هُوَ اليَأسُ فَليُحبَس هِبابُ رِقابِها","كَما كانَ مَغرورُ الرَجاءِ حَداها",0,"ا",3,0],["هُوَ اليَومُ أَخفَت خَيلُهُ لَمعَ آلِهِ","فَأَشباحُهُ فَوقَ العَجاجِ لَوامِعُ",1,"ع",1,0],["هُوَ اليَومُ لَنْ أَنْسَاهُ مَا ظَلْتُ بَاقِياً","إِذَا آبَ أَلفَانِي وَمَا زِلْتُ بَاكِيَا",2,"ي",2,1],["هُوَ اليَمُّ مِن أَيِّ النَواحي أَتَيتَهُ","فَلُجَّتُهُ المَعروفُ وَالجودُ ساحِلُه",3,"ل",2,0],["هُوَ اليَأسُ مِن لَيلى عَلى أَنَّ حُبَّها","مُقيمُ المَراسي لَم يَزَل عِندَنا بَعدُ",4,"د",1,0],["هو اليومُ يومُ الشُّؤمِ ضَجَّ نذيرهُ","ومرَّ به طيرٌ من النّحسِ بارحُ",5,"ح",1,0],["هو اليومُ لا في حُلَّة الصيف رافلٌ","ولا في سرابيل الشتاء بخاطرِ",6,"ر",1,0],["هُوَ اليَومُ لَو آلُ الزُبَيرِ مُنوا بِهِ","لَقَهقَرَ عَبدُ اللَهِ عَنهُ وَمُصعَبُ",7,"ب",1,0],["هو اليأسُ حتى يكرَه المرءُ نفسَهُ","ويُدمي بكفَّيهِ السماءَ مُهَدّدا",8,"د",2,0],["هُو اليوْمُ أَضْحَى مُكْفَهِراً عَصَبْصَباً","وأَمْسَى بِسِيمَا الفَتْحِ مُسْتَبْشِراً طَلْقَا",9,"ق",2,0],["هُوَ اليَومُ الَّذي لا وُدَّ فيهِ","وَلا نَسَبٌ وَلا أَحَدٌ مُواسي",10,"س",2,0],["هو اليأس مهوانا القديم وحصننا","فدونك فاجعل أوّل الحب آخرا",11,"ر",2,0],["هو اليأسُ إلا من حديثٍ مقوَّت","يروحُ إليه باجتماع موَقَّتِ",12,"ت",1,1],["هو اليوم لن أنساه ما ظلت باقيا","إذا آب ألفاني وما زلت باآيا",13,"ي",2,1],["هو اليومُ أعطاه الإله فضيلةً","كما كنتَ ممّن يحمِلُ الأمرَ أفضلا",14,"ل",2,0],["هو اليوم جاءك في الوافدي","ن معنىً وإن عَزَّه مِقولُ",15,"ل",1,0],["هو اليومُ ابتناه أبوك كسرى","وشيّد من قواعده الوِثاقِ",16,"ق",1,0],["هو اليوم ذو بنت وذو الأخت من أب","وعم اثنتين عد بالزوج سابعا",17,"ع",2,0],["هو اليوم في دست الإمارة حاكم","وحوله من كاوا الأذلة في الحمى",18,"م",2,0],["هو اليوم الذي كل البرايا","تتوق إليه من قلب ودود",19,"د",1,0],["هو اليوم الّذي فيه سَعدنا","وأدرَكنا بهِ كلّ المرامِ",20,"م",1,0],["هو اليوم فيه استجمع الدهر كله","مقاليده تلقى إليك وتسلم",21,"م",1,0],["هو اليعربيُّ الذِّمْرُ والأسد الذي","يبارز بالفولاذ لا بالأظافر",22,"ر",1,0],["هُوَ اليُمنُ لَم يُعدِمكَ مَحبوبَةً دَنَت","وَمَكروهَةً شَطَّت وَصَعباً تَيَسَّرا",23,"ر",2,0],["هو اليازجي الفرد من يوم فقده","فقدنا كنوز الفضل بالنظم والنثر",24,"ر",1,0],["هُوَ اليراع يراع الظالِمين بِهِ","إِن جاءهم مِنهُ تَوعيد وَتَهديد",25,"د",1,0],["هُوَ اليَوم حامي بَيضة الدين عِن عِدىً","تَمَنت جهاراً لَو تَصيح بِهِ نَهبا",26,"ب",2,0],["هو اليوم ولى فاستعد إلى غد","ولا يقبض التحذير منك على يد",27,"د",1,1],["هو اليوم راض ان يعيش مهانةً","ومطمحه ان يستكين ويقنعا",28,"ع",2,0],["هو اليوم منها جزؤها وإذا بدا","غدا أجنبياً عن حماها فتنساه",29,"ا",2,0],["هو اليومَ توسَعُ فيهِ الذّنو","بُ عفواً وتُكْشَفُ فيه الكُرَبْ",30,"ب",1,0],["هوَ اليوسُفيُّ الناصِرُ المَلكُ الذي","عزائِمُهُ تُخْشى ورُحْماهُ تُرْتَجى",31,"ج",2,0],["هوَ اليوسُفيُّ العالِمُ العَلَمُ الذي","عوامِلُهُ شهْبٌ من النّقْعِ في دُجَى",31,"ج",2,0],["هُوَ اليَوم يَرمي للعلا مُتَسائِلا","عَلى طرق تهدي له وَتَقرب",32,"ب",1,0],["هو اليمُّ منه كم أفاض على الملا","خضّماً أفاض المعصرات السواكبا",33,"ب",2,0],["هُوَ (ا ل يَ مَ نُ) الذي قَلَبُوهُ رَأسًا","عَلَى عَقِبٍ, ولكنْ لَن (نَ مِ ي لَ ا)",34,"ل",2,0],["هو اليتيم هو المنسي نضو ضنى","وما يحرك بالوجد الدفين فما",35,"م",2,0],["هُوَ اليَمُّ لِليَمِّ الخِضَمِّ مُحَمَّدٍ","سَليلَ سَعِيدٍ للسَّعَادَةِ مُلتَجا",36,"ج",2,0],["هُوَ اليَمنُ المُبْتَلَى بِالحياةِ","يَغِيبُ.. ولكنَّه لا يَمُوتْ.",37,"ت",1,0],["هو اليتمُ والعمرُ العقيمُ وأرضُهُ","خراب ٌ وإنْ عادَ الرَّبيعُ وأثَّلا",38,"ل",2,0],["هوَ اليتيمُ وكانَ الدِّفءُ منبَعَهُ","هو الصبورُ لنشرِ الحقِّ مُنصَرِفُ",39,"ف",1,0],["هو اليمينُ لمن يرجو سماحتَه","قبضٌ وبسطٌ بإنصاف وإجلال",40,"ل",1,0],["هُُوَ اليَتِيمُ الذِي أَرْسَىَ دَعَائِمَنَا","وَ رُبَّ فَضْلٍ لَدَى الصَّدَفَاتِ فِي اليُتُمِ",41,"م",1,0],["هو اليعربيّ الحق يحمِلُ راية","يموتُ عزيزا أو يعيشُ مكرّما",42,"م",2,0]]}