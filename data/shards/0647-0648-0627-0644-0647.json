{"poems":[[46,"يا هذه أقصري ما هذه بشر","https://www.aldiwan.net/poem30512.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140806",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16629","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42582","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43808","البسيط"],[125,"بالبحر قيلولة والشوق أختنق","https://www.aldiwan.net/poem23821.html","البسيط"],[226,"سجيالليل والجو أمسى عباب","https://www.aldiwan.net/poem55260.html","المتقارب"],[280,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[287,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[302,"ألية بانعطاف القامة النضرة","https://www.aldiwan.net/poem33265.html","البسيط"],[309,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[358,"خذ في هوى الغيد عني أحسن الخبر","https://www.aldiwan.net/poem40343.html","البسيط"],[369,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[409,"هو الهوى فاصطبر فيه لما يجب","https://www.aldiwan.net/poem34153.html","البسيط"],[466,"أقول لقلب هاجه لاعج الهوى","https://www.aldiwan.net/poem15120.html","الطويل"],[469,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[519,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[543,"من ذاك ينكر فضل إبراهيم","https://www.aldiwan.net/poem47956.html","عموديه"],[563,"غير الوجود محال","https://www.aldiwan.net/poem34222.html","المجتث"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37733","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62584","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62452","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56209","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112818","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49616","البسيط"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105431","الرجز"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124785","الوافر"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111230","الرجز"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83059","الوافر"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143109","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94306","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93830","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100336","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74175","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134207","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112479","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65172","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82829","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48317","الطويل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140273",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92451","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85207","المتقارب"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35486","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94585","الوافر"],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[4968,"تعويذة العشق ٢","https://www.poetsgate.com/ViewPoem.aspx?id=208097",""],[5057,"الحرف كالسهم","https://www.poetsgate.com/ViewPoem.aspx?id=197199",""],[585,"عليك وإلا ما عقدت رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=161913",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5851,"المدينة الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=175306",""],[5916,"سَلُوْ بَلْقَيْسَ","https://www.poetsgate.com/ViewPoem.aspx?id=190525",""],[6102,"هو الهوى!","https://www.poetsgate.com/ViewPoem.aspx?id=182770",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""]],"verses":[["هُوَ الهُمامُ هُوَ الصابُ المُريحُ هُوَ ال","حَتفُ الوَحِيُّ هُوَ الصَمّامَةُ الذَكَرُ",0,"ر",1,0],["هو الهمام الذي بادت تميم به","قدماً وساق إليها حينها الأجلا",1,"ل",2,0],["هو الهجر حتى ما يلم خيال","وبعض صدود الزائرين وصال",2,"ل",1,1],["هُوَ الْهُمامُ الَّذِي أَحْيَا بِمَنْطِقِهِ","آثَارَ قَوْمٍ أَجَادُوا النُّطْقَ بِالضَّادِ",3,"د",1,0],["هَوَ الْهَمَامُ الَّذِي يَأْتِي مَحَامِدَهُ","وَحَسْبُهُ مِنْ جَزَاءِ أَجْرِ مُحْتَسَبِ",4,"ب",1,0],["هُوَ الهِلالُ وَإِن أَدمى أَظافِرَهُ","فَشِبلُ غابٍ وَإِمّا إِن رَنا فَرَشا",5,"ش",2,0],["هو الهمام سميذع متى خلقا","وهْوَ الأريبُ هو الجحجاح مختلق",6,"ق",1,0],["هو الهول نلحظه خلسة","ومن مكمن آمن خلف باب",7,"ب",1,0],["هُو الهادي إلَى الخَيْراتِ يُهْدى","له المَدْحُ المُحَبّر والثّنَاءُ",8,"ا",2,0],["هُوَ الهازِمُ الآلافِ في الرَوعِ وَحدَهُ","وَمُعطي أُلوفاً فِضَّةً تَملأُ الكيسا",9,"س",2,0],["هو الهمامُ الَّذي أَعلَته همَّتهُ","مراتباً لذُرا الأَفلاكِ مُحتَقِرَه",10,"ر",2,0],["هو الهوان لما قالوا وقد سرقت","النون منه فجانبه وخذ ومل",11,"ل",1,0],["هُوَ الهمام الَّذي في الدين همّتهُ","فاقَت عَلى فوق حَدّ الصارم الذكرِ",12,"ر",1,0],["هو الهُمامُ الّذي","يُرغِمُ أَهل العِناد",13,"د",1,0],["هو الهوى فاصطبر فيه لما يجب","من حر نار على الأحشاء تلتهب",14,"ب",1,1],["هو الهاطلُ المدرارُ يغينك سيبهُ","إذا الغيث عادي ساحة الحي سائله",15,"ل",2,0],["هو الهازم الإعدام وهو جحافلٌ","ومنهزم الأفعال من واحد الإثم",16,"م",1,0],["هوَ الهُمامُ الّذي صحّت سيادتُه","واِشْتُقَّ من أنبياءِ اللَّهِ عُنصرُهُ",17,"ر",2,0],["هو الهُمامُ ابنُ الهُما","مِ ابنِ الهُمامِ ابنِ الهُمام",18,"م",1,0],["هو الهدى للبرايا","وما سواه ضلال",19,"ل",1,0],["هوَ الهُمامُ الَّذي فيه الزّمانُ صَفا","فَما اِعْتَراهُ بُعَيدَ الصّفوِ إِكْدارُ",20,"ر",1,0],["هو الهمام مليك العصر ملجؤُنا","محمد من بنشر الفضل قد سبقا",21,"ق",2,0],["هو الهمام ابن تركي من له خضعت","شوامخ الدهر وانقادت لخدمته",22,"ت",2,0],["هو الهلال الذي في كل جارحةٍ","منا وفي كل قلبٍ هلَّ واتلدا",23,"د",2,0],["هو الهاشمي المصطفى سيد الورى","عليه صلاة مع شريب التحية",24,"ه",1,0],["هُو الهوى وقديماً كنتُ أَحْذَرُهُ","السُّقْمُ مَوْرِدُهُ والموتُ مَصْدَرُه",25,"ر",2,1],["هو الهَمُّ مِقراضُ الحَياةِ وَإِنَّما","يَطولُ رِشاءُ العُمرِ بِالصَفوِ وَالبِشر",26,"ر",1,0],["هو الهوى مهما كتمته فشا","وكيف يخفي ما به الدمع وشى",27,"ش",2,1],["هو الهادي المشفع في البرايا","وكان لهم رحيما مستجيبا",28,"ب",2,0],["هو الهلال مذبدا بدت لنا","فيه سمات بالكمال تشهد",29,"د",1,0],["هو الهادي الدَّليلُ إِلى المَعالي","وَمِصباحٌ يُضيءُ به الظَّلامُ",30,"م",1,0],["هو الهيولى وأنت الجسم تقبل أص","ناف المعالي قبولاً غير مختلف",31,"ف",1,0],["هو الهمام الذي كانت له همم","كثير وجدى على فقدانها قلا",32,"ل",2,0],["هو الهندس النقريس ذو الهم والحجا","هو العالم النحرير أوفق نابس",33,"س",1,0],["هو الهجان المجلي في السباق اذا","طاح الهجين بتالي الخيل مقرافا",34,"ف",2,0],["هُوَ الهاشمي المُستَضاء بِرَأيه","إِذا ما دَجى لَيل الضلالة أَو جَنا",35,"ن",2,0],["هو الهمام الذي كانت مرؤته","لا يعتريها عن الخيرات احجام",36,"م",1,0],["هو الهدى صرفتكم عنه محنته","إن العزيز مهين حين يمتهن",37,"ن",1,0],["هُو الهمام أبو العباس أحمد من","علا على مفرق الجوزا بلا كلف",38,"ف",1,0],["هو الهُمامُ الَّذي ما راح ذو أَملٍ","يَرجوهُ إِلّا وَيَحلو عِنده الوِردُ",39,"د",1,0],["هو الهَدْيُ يُرْوَى إذ تجلّى فحيّاكا","عنِ البدْرِ عن شمْسِ الضُحى عن مُحيّاكا",40,"ك",2,1],["هو الهزبر الذي تخشى وثائبه","ترى الملوك له تحدوا مطاياها",41,"ا",3,0],["هو الهيكل السرحوبُ يصدم دهره","كما تصدم المقدور واقعةُ القدرْ",42,"ر",1,0],["هو الهاشمي الذي لحظه","إذا هشم العقل أفنى الوقارا",43,"ر",2,0],["هُوَ الهَوى وَهوَ أَنّي فيهِ مُحتَمل","وَربّ مَرّ عَذابي في الهَوى عَذبا",44,"ب",2,0],["هو الهمّام يجلي كل همٍّ","يدكُّ بهمةٍ شُمَّ الجبالِ",45,"ل",1,0],["هوَ الهزبرُ أسود الأرضِ ترهبهُ","كانت لهُ في مجالِ الحربِ زأرتُ",46,"ت",1,0],["هو الهوى في شغاف القلب مسكنه","هل للطّيور على الأشجار من ثقل",47,"ل",1,0],["هوَ الهوَى جنّةُ الفردوسِ أوّلُهُ","فإن تجذّرَ في الأرواحِ صارَ أذى",48,"ذ",2,0],["هو الهدف المنشود في السلم والوغى","وللذود عن أوطانكم شرفاء",49,"ا",2,0],["هو الهادي إلى دين حنيفٍ","يقود العالمين إلى الضياءِ",50,"ا",2,0],["هو الهزار يغنّي للهوى غَرِدًا","وما الهوى غير أجناد تقاتلهُ",51,"ل",2,0],["هَوَ الْهُاديْ لِمَنْ أفْشَى لُقَاهَا","ولَمْ يَخْفَيْ لَهَا سَرٌّ غَوَاهَا",52,"ا",3,0],["هُوَ الهَوَى؛ لَا إِذا نَرتاحُ نَسلُوهُ","وَلَا إِذا أَرهَقَ الأَرواحَ نَهجُوهُ",53,"و",2,1],["هُوَ الهادي مِنَ الهادي وبشرى","بِها قَرَّتْ عيونُ الساجدينا",54,"ن",2,0],["هو الهجرُ قَدْ أضناكَ قلباً وقالباً","وما عادَ في أفْقِ الوساطةِ شافعُ",55,"ع",1,0]]}