{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[65,"وحماء العلاط إذا تغنت","https://www.aldiwan.net/poem46074.html","الوافر"],[53,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[53,"ولي طيلسان ناحل غير أنه","https://www.aldiwan.net/poem65388.html","الطويل"],[53,"غضبت لي السماء والأرض والناس","https://www.aldiwan.net/poem65881.html","الخفيف"],[87,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[216,"ولي طفلة غرثى الوشاحين قدها","https://www.aldiwan.net/poem37847.html","الطويل"],[240,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[275,"فؤادي طار في حب الملاح","https://www.aldiwan.net/poem35371.html","الوافر"],[353,"أساءت الحمى ولكنها لي","https://www.aldiwan.net/poem19894.html","السريع"],[396,"يا رب جئناك نطلب منك مالايعد","https://www.aldiwan.net/poem54593.html","عموديه"],[396,"عظيم الفضل يا رب","https://www.aldiwan.net/poem54638.html","عموديه"],[556,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[580,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48930","المتقارب"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101771","المنسرح"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77375","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204844","الوافر"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32637","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119683","الوافر"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131649",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4239,"","https://poetry.dctabudhabi.ae/diwan/poem/102201","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28715","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52195","المتقارب"],[4767,"فارس القريض","https://www.poetsgate.com/ViewPoem.aspx?id=126303",""],[5092,"من هناك إلى هنا","https://www.poetsgate.com/ViewPoem.aspx?id=178240",""],[5431,"ميحانةٌ...ميحانه...أغنية","https://www.poetsgate.com/ViewPoem.aspx?id=200018",""],[5809,"سلوا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=205565",""],[5809,"يقين","https://www.poetsgate.com/ViewPoem.aspx?id=205637",""],[5861,"ألم الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=190619",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5986,"أرقت وما خوفاً من الموت أأرق","https://www.poetsgate.com/ViewPoem.aspx?id=162957",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""]],"verses":[["وَلي طَرفٌ تُصَرُّفُهُ","عَلى حُكمي مَحاجِرُه",0,"ر",2,0],["وَلي طَرْفٌ أَلَحَّ عَلَيهِ دَمْعٌ","تَتابَعَ فَيْضُهُ فَمَنِ الحَزينُ",1,"ن",1,0],["ولْيطُل عمرك مسرو","راً بأيامٍ قصار",2,"ر",1,0],["ولي طيلسان ناحل غير أنه","ثَبوتٌ لهبات الرياح الزعازعِ",3,"ع",1,1],["ولْيُطِلْ مُعْوِلٌ عليه عَوِيلاً","إنه في لظًى طويل العويل",4,"ل",1,0],["وَلي طِفلَةٌ جازَتِ السَنَتَينِ","كَبَعضِ المَلائِكِ أَو أَطهَرُ",5,"ر",1,0],["ولِي طَرْفٌ لِمَرْآهُ مَشوقٌ","وَلِي قلبٌ لِذِكْراهُ طَرُوبُ",6,"ب",1,0],["وَلْيَطِبْ عَنْ أخيهِ نَفساً وأبْنا","ء أخيهِ جَرائحِ الأكبادِ",7,"د",1,0],["ولي طَفْلةٌ غرثى الوشاحينِ قَدُّها","يُحاكي القَنَا في لِينِه واعتدالِهِ",8,"ل",2,1],["وَليَطوِيَنَّ الأَرضُ مِن أَقطارِها","وَلِواكُمُ مَنشورَةٌ حَذَباتُهُ",9,"ت",2,0],["ولي طَربٌ لأنغامٍ وشعرٍ","وأمواهٍ وريحانٍ وراح",10,"ح",1,0],["وَلي طَبِيبٌ قالَ لا تَخْشَها","فَقُلْتُ لَمْ تَشْهَدْ مَعِي النَّوْبَه",11,"ب",2,0],["ولي طمع فيك وافرجم ممدود مد","عاكف على باب جودك ليس لي عنه صد",12,"د",1,0],["ولي طمع ولي رجوى","لفضل واسع رحب",13,"ب",1,0],["وليطِحْ عنك الّذي لمْ","ترضَهُ فيما يَطيحُ",14,"ح",1,0],["ولي طمعٌ في حسن رأْيك صادقٌ","وما طمعِي في حسنِ رأْيكَ أَشعبا",15,"ب",2,0],["ولي طفلةٌ عمرُها نِصفُ حَولٍ","بدتْ تتمشّى على الأَربعِ",16,"ع",1,1],["وليطلقها أبوه ثم ما","إن لها إرثٌ ولا حقٌّ يعد",17,"د",1,0],["ولي طبيبٌ تشكو مراوِدَهُ","وتستغيثُ الجفونُ والحدق",18,"ق",1,0],["وَلي طَرفٌ يَرى الدُنيا خَيالاً","فَيكبر أَن يُلِمَّ بِها خَيالي",19,"ل",2,0],["ولي طبع الفراشة في هواها","حياتي حين أفنى في اللهيبِ",20,"ب",1,0],["وَلي طَيلَسانٌ إِن تَأَمَّلتَ شَخصَهُ","تَيَقَّنتَ أَنَّ الدَهرَ يَفني وَيَنقَرِض",21,"ض",1,1],["ولي طيرٌ أُمَرّنه زماناً","على صيد الظباء من الصباح",22,"ح",1,1],["ولي طير غدا والحرب هامد","وقع له بندقين من حق حسان",23,"ن",1,0],["ولي طمعٌ بالعفو فيما وعدتني","وأحببتني من بدء تكوين جبلتي",24,"ي",1,0],["وليطلب النفع لهم من دونه","وليكن الإنصاف من شؤونه",25,"ه",1,0],["وَلي طَرفٌ يُنازِعُني إِلَيها","أُحاوِلُ صَرفَهُ عَنِّي فَيابى",26,"ب",2,1],["وَلي طَمَعٌ بَينَ الأَجارِعِ عَهدُه","قَديمٌ وَكَم خابَت هُناكَ المَطامِعُ",27,"ع",1,0],["ولي طفلة لم تَحُزْ سنَتَينِ","إذا أَنا مُتُّ فلن تَسْلَما",28,"م",2,0],["وليَطِبْ ليلنا ببدر منيرٍ","شع منه الضياءُ نوراً تلالا",29,"ل",2,0],["ولي طيشٌ بأشعاري","حِصانُ الشعرِ جمّاحُ",30,"ح",1,0],["وليطعم الهدب النديّ","قصائدا رنانه",31,"ن",2,0],["ولي طمعٌ بجودِك بعد ربي","انالُ بحوضِ كوثرك الشرابا",32,"ب",2,0],["ولي طمعٌ في مالَدى اللهِ من ندى","ولكنني في مالَدى الناسِ زاهدُ",33,"د",1,0],["ولي طعنةٌ هديّ الاحبةِ بينما","فؤادي لهم أهديتَهُ بجميلِهِ",34,"ل",2,0],["ولي طلعةُ الصبح النَّدي وداخلي","كذابلِ وردٍ بعدما الورد يُقطَفُ",35,"ف",1,0],["ولي طمع في عفوه ورضائه","وإن كنت في بحر الجرائم مغرق",36,"ق",1,0],["وليطلقِ المستكبرون كلابَهم","وليقطعوا عنقي بلا إبطاءِ",37,"ا",2,0]]}