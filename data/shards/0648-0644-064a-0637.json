{"poems":[[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[63,"وحماء العلاط إذا تغنت","https://www.aldiwan.net/poem46074.html","الوافر"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"ولي طيلسان ناحل غير أنه","https://www.aldiwan.net/poem65388.html","الطويل"],[51,"غضبت لي السماء والأرض والناس","https://www.aldiwan.net/poem65881.html","الخفيف"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[210,"ولي طفلة غرثى الوشاحين قدها","https://www.aldiwan.net/poem37847.html","الطويل"],[233,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[268,"فؤادي طار في حب الملاح","https://www.aldiwan.net/poem35371.html","الوافر"],[346,"أساءت الحمى ولكنها لي","https://www.aldiwan.net/poem19894.html","السريع"],[388,"يا رب جئناك نطلب منك مالايعد","https://www.aldiwan.net/poem54593.html","عموديه"],[388,"عظيم الفضل يا رب","https://www.aldiwan.net/poem54638.html","عموديه"],[549,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[573,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"]],"verses":[["وَلي طَرفٌ تُصَرُّفُهُ","عَلى حُكمي مَحاجِرُه",0,"ر",2,0],["وَلي طَرْفٌ أَلَحَّ عَلَيهِ دَمْعٌ","تَتابَعَ فَيْضُهُ فَمَنِ الحَزينُ",1,"ن",1,0],["ولْيطُل عمرك مسرو","راً بأيامٍ قصار",2,"ر",1,0],["ولي طيلسان ناحل غير أنه","ثَبوتٌ لهبات الرياح الزعازعِ",3,"ع",1,1],["ولْيُطِلْ مُعْوِلٌ عليه عَوِيلاً","إنه في لظًى طويل العويل",4,"ل",1,0],["وَلي طِفلَةٌ جازَتِ السَنَتَينِ","كَبَعضِ المَلائِكِ أَو أَطهَرُ",5,"ر",1,0],["ولِي طَرْفٌ لِمَرْآهُ مَشوقٌ","وَلِي قلبٌ لِذِكْراهُ طَرُوبُ",6,"ب",1,0],["وَلْيَطِبْ عَنْ أخيهِ نَفساً وأبْنا","ء أخيهِ جَرائحِ الأكبادِ",7,"د",1,0],["ولي طَفْلةٌ غرثى الوشاحينِ قَدُّها","يُحاكي القَنَا في لِينِه واعتدالِهِ",8,"ل",2,1],["وَليَطوِيَنَّ الأَرضُ مِن أَقطارِها","وَلِواكُمُ مَنشورَةٌ حَذَباتُهُ",9,"ت",2,0],["ولي طَربٌ لأنغامٍ وشعرٍ","وأمواهٍ وريحانٍ وراح",10,"ح",1,0],["وَلي طَبِيبٌ قالَ لا تَخْشَها","فَقُلْتُ لَمْ تَشْهَدْ مَعِي النَّوْبَه",11,"ب",2,0],["ولي طمع فيك وافرجم ممدود مد","عاكف على باب جودك ليس لي عنه صد",12,"د",1,0],["ولي طمع ولي رجوى","لفضل واسع رحب",13,"ب",1,0],["وليطِحْ عنك الّذي لمْ","ترضَهُ فيما يَطيحُ",14,"ح",1,0],["ولي طمعٌ في حسن رأْيك صادقٌ","وما طمعِي في حسنِ رأْيكَ أَشعبا",15,"ب",2,0]]}