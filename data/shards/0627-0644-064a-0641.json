{"poems":[[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[29,"عفا واسط من أهله فمذانبه","https://www.aldiwan.net/poem6050.html","الطويل"],[92,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[43,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[45,"كنت إلى وصل سعدى جد محتاج","https://www.aldiwan.net/poem62673.html","البسيط"],[45,"إني تركت الصبا عمدا ولم أكد","https://www.aldiwan.net/poem63458.html","البسيط"],[45,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[49,"ألم نر يا دنيا تصرف حالك","https://www.aldiwan.net/poem63042.html","الطويل"],[105,"ألي في الهوى ما لي وللائم العذر","https://www.aldiwan.net/poem43125.html","الطويل"],[105,"محيصة بلغ ما أمرت فإنما","https://www.aldiwan.net/poem44056.html","الطويل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[48,"يا رب ساق كأنه شبه البدر","https://www.aldiwan.net/poem64402.html","المنسرح"],[48,"إذا خطرت فيك الهموم فداوها","https://www.aldiwan.net/poem65098.html","الطويل"],[48,"غدوت على خمر ورحت إلى خمرِ","https://www.aldiwan.net/poem66261.html","الطويل"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[76,"بني لئن أعيا الطبيب ابن مسلم","https://www.aldiwan.net/poem39264.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54824","الوافر"],[29,"عفا واسطٌ من أهْله فمذانُبْهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17431&r=&rc=4",""],[135,"هدية من مغرم لم يمل","https://www.aldiwan.net/poem49047.html","السريع"],[155,"تظلم الورد من خديه إذ ظلما","https://www.aldiwan.net/poem55561.html","البسيط"],[211,"وأين محط الرمل لا أين إنني","https://www.aldiwan.net/poem46266.html","الطويل"],[270,"توالت ليالي الحب وهي سراع","https://www.aldiwan.net/poem35221.html","الطويل"],[270,"سمائي في جفونك والجبين","https://www.aldiwan.net/poem35451.html","الوافر"],[297,"أفي كل ربع للمطي بنا وقف","https://www.aldiwan.net/poem33218.html","الطويل"],[298,"ألا كل مجد عرضة للتهدم","https://www.aldiwan.net/poem36812.html","عموديه"],[304,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[328,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[328,"مجالي الصبا لا طواك الزمن","https://www.aldiwan.net/poem55036.html","المتقارب"],[342,"عجيب أيحدوني إليك حنين","https://www.aldiwan.net/poem55364.html","الطويل"],[364,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[402,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[403,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[453,"إلى إيطاليا خفوا وطيروا","https://www.aldiwan.net/poem61576.html","الوافر"],[458,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[515,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[537,"أنى تسدت نحونا أم يوسف","https://www.aldiwan.net/poem69412.html","الطويل"],[538,"تجلت معاني الطعن من قدك اللدن","https://www.aldiwan.net/poem47919.html","عموديه"],[538,"إذا ذكر المثقف من شباب","https://www.aldiwan.net/poem47958.html","عموديه"],[567,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"]],"verses":[["إِلى فِتيَةٍ شُعثٍ رَمى بِهِمُ الكَرى","مُتونَ الحَصى لَيسَت عَلَيها مَحابِسُ",0,"س",1,0],["إِلى فِتيَةٍ مِثلَ السُيوفِ وَأَينُقٍ","حَراجيجَ مِن آلِ الجِديلِ وَداعِرِ",1,"ر",1,0],["إلى فتى الخطَّاب ساميّهم","تفننُ الفضل وأفنانه",2,"ن",2,0],["إِلى فاعِلٍ لَو خايَلَ النيلَ أَزحَفَت","مِنَ النيلِ فَوّاراتُهُ وَمَثاعِبُه",3,"ب",2,0],["إليَّ فقدْ وَحَّدَتْ بيننا","قَساوَةُ هذا الزَّمان الظَّلُومْ",4,"م",1,0],["إِلى فَتىً يُصدِرُ الرِماحَ وَقَد","أَنهَلَها في القُلوبِ مَورِدُها",5,"د",3,0],["إِلى فَتىً يُتبِعُ النُعمى نَظائِرَها","كَالبَحرِ يُتبِعُ أَمواجاً بِأَمواجِ",6,"ج",1,0],["إِلى فَتىً مُشرِقِ الأَخلاقِ لَو سُبِكَت","أَخلاقُهُ مِن شُعاعِ الشَمسِ لَم تَزِدِ",7,"د",1,0],["إِلى فارِغٍ مِن كُلِّ شَأنٍ يَشينُهُ","وَإِن يَشتَغِل فَالمَجدُ عُظمُ اِشتِغالِهِ",8,"ل",2,0],["أَليفُكِ يا دُنيا كَثيرٌ غُمومُهُ","فَلَيسَ النَجاةُ مِنكِ غَيرَ اعتِزالِكِ",9,"ك",1,0],["أَلِي في الهَوى ما لي وَلِلّائِمِ العُذرُ","أَما يَعلَمُ اللُوّامُ أَنَّ الهَوى مِصرُ",10,"ر",1,1],["إلى فَدَكٍ فَاحْمِلْ بَلاَغ مُحمّدٍ","وأَنْذِرْ بها قوماً أضلَّهمُ الجَهْلُ",11,"ل",1,0],["إليَّ فما بِمثلي من نكيرِ","أنا الأسدُ الذي يحمي الشُّبولا",12,"ل",2,0],["إِلَيَّ فَاِسمَع تَسمَع إِلى عَجَبٍ","مِن مُستَجِدِّ الحَديثِ مُطَّرِفِه",13,"ف",2,0],["إِلى فِتيَةٍ نادَمتُهُم فَحَمِدتُهُم","وَما في النَدامى ما عَلِمتُ لَئيمُ",14,"م",1,0],["إليّ فلم يكبُ إذا ما حملتهُ","على بطنِ قرطاسٍ ويعنقُ في الظهر",15,"ر",1,0],["إِلى فَتىً لَيسَ لَهُ نَظيرُ","يُشفى بِهِ المُنزَفُ وَالفَجيرُ",16,"ر",1,0],["إِلى فَتىً تَسقي يَداهُ النَدى","حيناً وَأَحياناً دَمَ المُذنِبِ",17,"ب",1,0],["إلى فارجِ الكَرْبِ المجيبِ لمَن دَعا","فَزِعتُ بِكَرْبي إِنَّهُ خَيرُ مَفْزَعِ",18,"ع",1,0],["إِليَّ فُدِيتَ يَا سَاقِي","بِشَمْسٍ مِنْ يَدَيْ بَدْرِ",19,"ر",1,0],["إلى فاعلٍ لوْ خايَلَ النِّيلَ، أزْحفَتْ","من النيلِ فوراتُهْو مثاعِبُهْ",20,"ب",2,0],["إلى فريد العصرِ شمس الهدى","إلى خضيرٍ ذي المقام الجليلْ",21,"ل",1,0],["إِلى فَتَىً تَضْحَكُ الدُّنْيا بِغُرَّتِهِ","فَما تَرى باكِياً فيها إِذا ابْتَسَما",22,"م",2,0],["إلى فاتنات الرمل أسلمت مهجتي","وفيهن غيد قاتلات وغزلان",23,"ن",1,0],["أليفَةَ هذي الرُّوحِ قد كان حبُّنا","سلاماً وأَمَّا اليومَ فهو وداع",24,"ع",1,0],["أَلي في يقظةٍ تقبيلُ ثغرٍ","وخدٍّ أضعفا قلبي وديني",25,"ي",1,0],["أَليفُ العُلى لم يصبُ إِلّا إِلى العُلى","إِذا ما صَبا يوماً إِلى إلفه إِلفُ",26,"ف",1,0],["إلى (فيصل * لا يثلم اللهُ حدَّه","قوارص قولٍ دونها كل مِخْذَمِ",27,"م",1,0],["إلى فبر مهول فيه يلقى","علينا فحسبك ما نصالي",28,"ل",2,0],["إلى فجوة في رحاب الفناء","نزيلا على الأوّلِ الآخر",29,"ر",1,0],["إلى فجرك الرطب حن النظر","وفي حلمك العذب عاش الخيال",30,"ل",1,0],["أليف فراش السقم صبراً فهذه","حياتك طيف يختفي ويبين",31,"ن",1,0],["إلى فتىً آمُلُ من عِنْدِه","عَوْداً على ما أَتَمنّاه",32,"ا",2,0],["إلى فرع مجدٍ أصلُه سيّد الورى","فَبُورِكَ من فرعِ كريم ومِن أَصلِ",33,"ل",1,0],["أليف التقى خدن الهدى صاحب العلى","حليف كتاب اللّه في الخلوات",34,"ت",1,0],["إلى فاروق حيث خصصتموه","بتسبيح هو النيل الكبير",35,"ر",1,0],["إلى فتىً يُسفِر عن بشره ال","أبيضِ وجهُ الزمنِ الأقتمِ",36,"م",1,0],["إلى فخر دولة دين الهدى","بعثت من الشعر جريا له",37,"ل",2,0],["إِلى فِتيةٍ بالطَفِّ نيلَت سَرَاتُهُم","وغودِرَ أفراسٌ لهُم ورَواحلٌ",38,"ل",1,0],["أَليفُ العُلا يَهتَزُّ لِلمَدحِ عِطفُهُ","كما حَرَّكَت أَيدي الصَّبَا قامة الغُصنِ",39,"ن",1,0],["إلى فَخرِ الشَّبابِ أزُفُّ بِكراً","أتَتهُ وغيرُه له لا تَقومُ",40,"م",1,0],["أَلِيْفَيْنِ حَلِيْفَيْنِ","عَلَى الإِعْسَارِ واليُسْرِ",41,"ر",1,0]]}