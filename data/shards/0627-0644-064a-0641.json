ل"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143938","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97983","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67995","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68005","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89233","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216757","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205759","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128942","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131018",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32899","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88559","المتقارب"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29310","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101359","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127134","السريع"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124621","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139690",""],[4830,"رسول الرحمة محمدﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=193598",""],[4935,"بدت بالليل يصحبها الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=129361",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5061,"رسمي ولابس غترة","https://www.poetsgate.com/ViewPoem.aspx?id=153508",""],[5136,"يهنيك يا شمس آل المصطفى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=121551",""],[5145,"أتنكر أني بكم مغرم","https://www.poetsgate.com/ViewPoem.aspx?id=108229",""],[5493,"طيفُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=205292",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5776,"إشراقةٌ حمراء","https://www.poetsgate.com/ViewPoem.aspx?id=199439",""],[5830,"وَ كُنْتُ السَّمَاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=200774",""],[5956,"أليفٌ رَمْقُكمَ","https://www.poetsgate.com/ViewPoem.aspx?id=183485",""],[520,"دنا العيد هنيت امثاله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577630",""],[6225,"تلعثم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80962&r=&rc=231",""],[572,"أَلاَ أَبْلِغْ أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9291&r=&rc=148",""]],"verses":[["إِلى فِتيَةٍ شُعثٍ رَمى بِهِمُ الكَرى","مُتونَ الحَصى لَيسَت عَلَيها مَحابِسُ",0,"س",1,0],["إِلى فِتيَةٍ مِثلَ السُيوفِ وَأَينُقٍ","حَراجيجَ مِن آلِ الجِديلِ وَداعِرِ",1,"ر",1,0],["إلى فتى الخطَّاب ساميّهم","تفننُ الفضل وأفنانه",2,"ن",2,0],["إِلى فاعِلٍ لَو خايَلَ النيلَ أَزحَفَت","مِنَ النيلِ فَوّاراتُهُ وَمَثاعِبُه",3,"ب",2,0],["إليَّ فقدْ وَحَّدَتْ بيننا","قَساوَةُ هذا الزَّمان الظَّلُومْ",4,"م",1,0],["إِلى فَتىً يُصدِرُ الرِماحَ وَقَد","أَنهَلَها في القُلوبِ مَورِدُها",5,"د",3,0],["إِلى فَتىً يُتبِعُ النُعمى نَظائِرَها","كَالبَحرِ يُتبِعُ أَمواجاً بِأَمواجِ",6,"ج",1,0],["إِلى فَتىً مُشرِقِ الأَخلاقِ لَو سُبِكَت","أَخلاقُهُ مِن شُعاعِ الشَمسِ لَم تَزِدِ",7,"د",1,0],["إِلى فارِغٍ مِن كُلِّ شَأنٍ يَشينُهُ","وَإِن يَشتَغِل فَالمَجدُ عُظمُ اِشتِغالِهِ",8,"ل",2,0],["أَليفُكِ يا دُنيا كَثيرٌ غُمومُهُ","فَلَيسَ النَجاةُ مِنكِ غَيرَ اعتِزالِكِ",9,"ك",1,0],["أَلِي في الهَوى ما لي وَلِلّائِمِ العُذرُ","أَما يَعلَمُ اللُوّامُ أَنَّ الهَوى مِصرُ",10,"ر",1,1],["إلى فَدَكٍ فَاحْمِلْ بَلاَغ مُحمّدٍ","وأَنْذِرْ بها قوماً أضلَّهمُ الجَهْلُ",11,"ل",1,0],["إليَّ فما بِمثلي من نكيرِ","أنا الأسدُ الذي يحمي الشُّبولا",12,"ل",2,0],["إِلَيَّ فَاِسمَع تَسمَع إِلى عَجَبٍ","مِن مُستَجِدِّ الحَديثِ مُطَّرِفِه",13,"ف",2,0],["إِلى فِتيَةٍ نادَمتُهُم فَحَمِدتُهُم","وَما في النَدامى ما عَلِمتُ لَئيمُ",14,"م",1,0],["إليّ فلم يكبُ إذا ما حملتهُ","على بطنِ قرطاسٍ ويعنقُ في الظهر",15,"ر",1,0],["إِلى فَتىً لَيسَ لَهُ نَظيرُ","يُشفى بِهِ المُنزَفُ وَالفَجيرُ",16,"ر",1,0],["إِلى فَتىً تَسقي يَداهُ النَدى","حيناً وَأَحياناً دَمَ المُذنِبِ",17,"ب",1,0],["إلى فارجِ الكَرْبِ المجيبِ لمَن دَعا","فَزِعتُ بِكَرْبي إِنَّهُ خَيرُ مَفْزَعِ",18,"ع",1,0],["إِليَّ فُدِيتَ يَا سَاقِي","بِشَمْسٍ مِنْ يَدَيْ بَدْرِ",19,"ر",1,0],["إلى فاعلٍ لوْ خايَلَ النِّيلَ، أزْحفَتْ","من النيلِ فوراتُهْو مثاعِبُهْ",20,"ب",2,0],["إلى فريد العصرِ شمس الهدى","إلى خضيرٍ ذي المقام الجليلْ",21,"ل",1,0],["إِلى فَتَىً تَضْحَكُ الدُّنْيا بِغُرَّتِهِ","فَما تَرى باكِياً فيها إِذا ابْتَسَما",22,"م",2,0],["إلى فاتنات الرمل أسلمت مهجتي","وفيهن غيد قاتلات وغزلان",23,"ن",1,0],["أليفَةَ هذي الرُّوحِ قد كان حبُّنا","سلاماً وأَمَّا اليومَ فهو وداع",24,"ع",1,0],["أَلي في يقظةٍ تقبيلُ ثغرٍ","وخدٍّ أضعفا قلبي وديني",25,"ن",2,0],["أَليفُ العُلى لم يصبُ إِلّا إِلى العُلى","إِذا ما صَبا يوماً إِلى إلفه إِلفُ",26,"ف",1,0],["إلى (فيصل * لا يثلم اللهُ حدَّه","قوارص قولٍ دونها كل مِخْذَمِ",27,"م",1,0],["إلى فبر مهول فيه يلقى","علينا فحسبك ما نصالي",28,"ل",2,0],["إلى فجوة في رحاب الفناء","نزيلا على الأوّلِ الآخر",29,"ر",1,0],["إلى فجرك الرطب حن النظر","وفي حلمك العذب عاش الخيال",30,"ل",1,0],["أليف فراش السقم صبراً فهذه","حياتك طيف يختفي ويبين",31,"ن",1,0],["إلى فتىً آمُلُ من عِنْدِه","عَوْداً على ما أَتَمنّاه",32,"ا",2,0],["إلى فرع مجدٍ أصلُه سيّد الورى","فَبُورِكَ من فرعِ كريم ومِن أَصلِ",33,"ل",1,0],["أليف التقى خدن الهدى صاحب العلى","حليف كتاب اللّه في الخلوات",34,"ت",1,0],["إلى فاروق حيث خصصتموه","بتسبيح هو النيل الكبير",35,"ر",1,0],["إلى فتىً يُسفِر عن بشره ال","أبيضِ وجهُ الزمنِ الأقتمِ",36,"م",1,0],["إلى فخر دولة دين الهدى","بعثت من الشعر جريا له",37,"ل",2,0],["إِلى فِتيةٍ بالطَفِّ نيلَت سَرَاتُهُم","وغودِرَ أفراسٌ لهُم ورَواحلٌ",38,"ل",1,0],["أَليفُ العُلا يَهتَزُّ لِلمَدحِ عِطفُهُ","كما حَرَّكَت أَيدي الصَّبَا قامة الغُصنِ",39,"ن",1,0],["إلى فَخرِ الشَّبابِ أزُفُّ بِكراً","أتَتهُ وغيرُه له لا تَقومُ",40,"م",1,0],["أَلِيْفَيْنِ حَلِيْفَيْنِ","عَلَى الإِعْسَارِ واليُسْرِ",41,"ر",1,0],["أَلِيفٌ مَضَى لَم يَحِن عَهدُهُ","وخُنتَ العُهُودَ فَتَبَّت يَدا",42,"د",2,0],["اليَفانِ لا يَنفِكَ كُلُّ مَتَيَّما","بِصاحِبِهِ تَعي لَدَيهِ اللَوائِمُ",43,"م",1,0],["إلى فمٍ والذي صا","غه مليحٌ بِمَرَّه",44,"ر",2,0],["إلى فُسَيفسٍ ليست","بغيرِ الوَهمِ مَضْبوطَه",45,"ط",2,0],["أَلِيفُ أسىً لم يألَفِ النَومَ طَرفُهُ","لهُ الهمُّ في جُنحِ الدياجي مُنادِمُ",46,"م",1,0],["أَليفُ الشَّتات شَتيتُ الأَليف","بعيدُ القَرين قَرين البِعاد",47,"د",1,1],["إلى فخره يتناهى الفخار","وسؤدده ينتمي السؤددُ",48,"د",1,0],["إِلى فلاح سليل المحسن الملك ال","قرم الّذي في جداهُ يعدم العدمُ",49,"م",1,0],["إِلى فتىً مِن بني ماءِ السماءِ بما","أوتي منَ الفخرِ والإجلالِ مشهورِ",50,"ر",1,0],["إِلى فلاح سليلِ المحسن الملك ال","مَعروفِ بالجودِ في عسرٍ وميسورِ",50,"ر",1,0],["أَليفة رَبات الحجال وَرُبَّما","تَحول إِلى إِلف الرجال بلا نكر",51,"ر",1,0],["أُلَيفاتٌ مِنَ الوَصْلِ","وواواتٌ مِنَ العَطْفِ",52,"ف",1,0],["إلى فوز الكرام اخي سارع","ولا تركن إلى نهج الضلاله",53,"ل",2,1],["أَليفةُ هذي الربى العاريات","كستها الثلوجُ بياضَ النهار",54,"ر",1,0],["أَليفة لبنانَ لا أهله","فهمْ عن مطارحتي في ازورار",54,"ر",1,0],["اليف عناً لم يبقِ دهري عَلَى رشدي","لا لا فقد الف البلابل خاطري",55,"ي",1,0],["أَليف اصطبارٍ لا يذاعُ لهُ سرُّ","أَأَكتم اشواقاً بهِ ام ابثها",55,"ه",2,0],["أَليفُهُ شبههُ للقرن نسبتُهُ","يدنِّس اللومُ عرضَ الأَهل قاطبةً",56,"ه",1,0],["إلى فتى العلم من عقله","والجهل أغلب على الفتيان",57,"ن",1,0],["إلي فإني ربهم ومليكهم","لمن يشتكي المملوك إلا لمولاه",58,"ه",1,0],["إِلى فَضَلاتٍ مِن حِبِىٍّ مُجَلجِلٍ","أَضَرَّت بِهِ أَضواجُها وَهُضومُها",59,"ه",2,0],["إِلى فَتىً نالَ بِالمَعروفِ مُنذُ نَشا","مَحامِداً لَم يَنلها قَبلَهُ أَحَدُ",60,"د",1,0],["إِلى فَتىً مِن بَني الشَدادِ هِمَّتُهُ","مَقرُونَةٌ بِشُعاعِ الكَوكَبِ التالي",61,"ل",2,0],["إِلى فَتىً مُنَشِرحٍ صَدرُهُ","لِطالِبي المَعرُوف أَيَّ اِنشِراح",62,"ح",1,0],["إِلى فَتىً سادَ البَشَر","وَساءَ مُذ شَبَّ وَسَرّ",63,"ر",1,0],["إلى فتاة اسمها يمامه","قد ألفت حدائق اليمامه",64,"ه",1,0],["إلى فناها ولب","ألا يا أحمد",65,"د",1,0],["إلى فهو أبداً ما جَهِلَكَ","وكلُّ شيءٍ أنتَ فيه مَن ملَك",66,"ك",1,0],["إلى فقرة منك يا فقرنا","ونستغن إن قلت نظماً ونثرا",67,"ر",2,0],["إلى فؤادي بشوق","مبرح بالروح",68,"ح",1,0],["أَليفٍ لِقُرآنٍ حَليفٍ لسُنةٍ","عَن الشَرِّ مِبطاءٍ إِلى الخَيرِ نَهّاضِ",69,"ض",1,0],["إلى فتيانكم فيه اعتصام","ونهيٌ عن فسوق وانتهاء",70,"ا",2,0],["إلى فتياتكم فيه احتشام","وتربية فطهر فاحتماءُ",70,"ا",2,0],["إِلى فَتىً ماجدِ الأخلاقِ ذي كرمٍ","سَهلِ المحيّا كريمٍ غير ملجاجِ",71,"ج",1,0],["اليف الوجد يقريك السلاما","اقام على المحبة ما سلا ما",72,"م",2,1],["إِلَى فَرنسَا سَمَاءِ الحُسنِ مُمتَطِياً","ظَهرَ الغطَمطَمِ مَا تَرتَابُ غَيلَتَهُ",73,"ت",2,0],["إلى فتى مستبد","بكل فعلٍ ظريف",74,"ف",1,0],["إلى فارسِ الغارين يوم تلاقيا","بصِفَّين قرمٍ خير نجِلِ قُروم",75,"م",1,0],["إلى فاتنة الندمان واستبقى","هذا الغزال فمنك القد ميّاس",76,"س",1,0],["اليف الهم مهتضم حزين","قريح العين مظلوم كئيب",77,"ب",1,0],["أليفٌ يُراعي في الوَلا حقَّ إِلفهِ","اذا أَلِفَ الانسانَ فهو حَليفهُ",78,"ف",2,0],["أليفان هذا سائر نحو غربةٍ","وهذا مقيم سار عن صدره القلب",79,"ب",1,0],["أليف يميل إلى إلفه","وأنثى يحن إليها الذكر",80,"ر",1,0],["إِلَى فيصلٍ كهفِ الأنام كَفيلِهم","أشدِّهمُ بأساً وأعظم ناديا",81,"ي",2,0],["إِلَى فسيح بظهرِ الأرض نَمْلؤه","وَقَدْ ملأنا الحَشَا بالغِلِّ والحَسَدِ",82,"د",1,0],["أليف السبق يسرع لا بعتق","على خيط من الذيل السوي",83,"ي",1,0],["أليف النفس تأليفٌ ظريفٌ","لأنطون الزكيِّ الفعل جمعه",84,"ع",2,0],["أليف الجبال ويا وحشةً","لمن إلفه الجبل الباسر",85,"ر",1,0],["أليفًا وفيًّا لا يفارق صاحبًا","ولا منزلًا إلا انثنى فتقرَّبا",86,"ب",2,0],["أليف الصبى لا تشكُ في الموت وحشة","فما زال ركب الموت أحفل موكبا",86,"ب",2,0],["الى فم الثعلب في","سرعتها منحدره",87,"ر",2,0],["اليفان لم يفصلهما حادث النوى","ولا اشتكيا منذ اتصالهما بعدا",88,"د",2,0],["إِلى فِتيَةٍ ما شَتَّتَ العَذلُ شَملَهُم","شِعارُهُ عِندَ الصَباحِ شُمولُ",89,"ل",1,0],["إلى فخذ رابىء لحمُها","محملجةِ الفتل كالقَنقَل",90,"ل",1,0],["إِلى فَناءِ الدارِ","تَنَقَّلي تَنَقَّلي",91,"ي",1,0],["إلى فتى مريون قيرانوسا","تابعه الأعمين من لقطوسا",92,"س",2,0],["أَليفَةَ حُمقٍ حَلِيفَةَ نُكر","وَلَيسَت لِغَيرِ المَفاسدِ تَجري",93,"ي",1,0],["إلى فلك العداة ولو","بعادي الآن ساءكم",94,"م",1,0],["أليفي قم تلاف قواي إني","أراك رحلت عني بائتلاف",95,"ف",1,0],["إلى فتى نال العلى من صغر","لأنه قد رضع المفاخرا",96,"ر",2,0],["إلى فارس الاسلام محييى رسومه","صرفت عنان المدح وهوله أهل",97,"ل",1,0],["إلى فضله تُعزى الفضائلُ كلها","وتنمى إليه المكرماتُ جميعها",98,"ع",3,0],["آلى فؤادي بعينيكِ التي قدحتْ","نارَ الصبابة في من ْ قلبُه صممُ",99,"م",1,0],["أليفة معشر يحلو لديها","من الصب التذلل والصغار",100,"ر",1,0],["إلى فرقانه الشعرا","كنمل جدت الطلبا",101,"ب",2,0],["الي فعوله كفو ......وعلومه جزال","الي يمد الطيب .......قدر استطاعه",102,"ع",2,0],["إلى فناء مليك يرتقى صعداً","إلى مدى بعرى كيوان مشدود",103,"د",1,0],["إلى فلك المجد فانظر فما","لآفاقه غيرهم أنجم",104,"م",1,0],["إلَى فستانِها المنهوكِ حُزْنًا","يحيطُ بخصرِها المَرْشوقِ زرعًا",105,"ع",2,0],["أليفة روحي كم تنعت حولها","بظل الأماني والشباب غلام",106,"م",1,0],["إلى فجر سنصحبه إلينا","وفجر ُ الشعب يشرق من سلاحي",107,"ح",2,0],["أَلِيفٌ وَرِيفٌ رَقِيقُ الهَوَىَ","جَمِيلُ التَّغَنِّي بِرُوحِ الوَفَاءْ",108,"ا",2,0],["أليفٌ رَمْقُكم لي يا شياهُ","وعطفكمُ الغزيرُ هو المياهُ",109,"ا",2,1],["إلى فخر دولة دين الهدى","تعب من الشعر جرياله",110,"ل",2,0],["إلى فضاء نغمةٍ يمس ُّعطرُها السنا","فما نقولُ إذ يقولُ صمتنا أنا هنا",111,"ن",2,0],["أَلِيفَيْنِ خَلِيفَيْنِ","على الأَيسارِ والعُسْرِ",112,"ر",1,0]]}