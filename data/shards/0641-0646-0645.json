bi.ae/diwan/poem/90824","الكامل"],[4208,"","https://poetry.dctabudhabi.ae/diwan/poem/110725","البسيط"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127930","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66114","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35418","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33342","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33666","المتقارب"],[4767,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=87662",""],[4578,"بأفق العز أشرق بدرُ سعدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49395",""],[4856,"رحيلٌ مؤقت","https://www.poetsgate.com/ViewPoem.aspx?id=36269",""],[4888,"لذة","https://www.poetsgate.com/ViewPoem.aspx?id=207678",""],[4994,"من قباب الجرح معراجي","https://www.poetsgate.com/ViewPoem.aspx?id=210700",""],[5050,"حدث أخي عن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=38218",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5376,"لنا في الخنا طَرْفٌ من الذلِّ مرتدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=199640",""],[5408,"أوجاع يوسفية","https://www.poetsgate.com/ViewPoem.aspx?id=190737",""],[5409,"طواك الموت قيثاراً بديعا","https://www.poetsgate.com/ViewPoem.aspx?id=155460",""],[5419,"في عيادة طبيب الأطفال ... ( شعر للأطفال )","https://www.poetsgate.com/ViewPoem.aspx?id=71146",""],[5587,"ابن باديس","https://www.poetsgate.com/ViewPoem.aspx?id=197891",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5703,"مازال صوتكَ","https://www.poetsgate.com/ViewPoem.aspx?id=211773",""],[5725,"سهم الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=181550",""],[5751,"صلاة الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=214777",""],[5818,"للكونِ ربٌّ سميعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=193174",""],[5906,"سَماحة","https://www.poetsgate.com/ViewPoem.aspx?id=188070",""],[5956,"يا ليتني أشفيك من كل الضنا","https://www.poetsgate.com/ViewPoem.aspx?id=194650",""],[5969,"على رسل الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=198684",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[6225,"نداء الأرض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80913&r=&rc=182",""]],"verses":[["فَنَم وادِعاً وَاِستَسقِني فَسَتَنتَضي","حُساماً إِذا ما مَرَّ بِالعَظمِ طَبَّقا",0,"ق",2,0],["فَنِمنا غِشاشاً ثُمَّ ثُرنا مِنَ الكَرى","إِلى كُلِّ نِضوٍ لاغِب الصَّوتِ رازِحِ",1,"ح",1,0],["فَنِمَّ بِما تَرَى يا نَجْدُ مِنِّي","وإِيهٍ يا تِهامَةُ عَنْ حَدِيثي",2,"ث",2,0],["فَنَمَّت عَلى قَلبي سَواكِبُ عَبرَةٍ","تَجودُ بِها عَينايَ سَحّاً عَلى خَدّي",3,"د",2,0],["فَنَمْ آمِناً إِنَّ فِي الْغَرْسِ مَا","يُعِيدُكَ فِي خَلَفٍ دَائِمِ",4,"م",1,0],["فنما في بواسق المجد فرداً","مستظلاً منهنّ ظلاَّ مديدا",5,"د",2,0],["فنما المجدُ على آثارهم","وتحدى ، بعد ما زالوا الزوالا",6,"ل",2,0],["فنمتَ ولم تهجر شرابك بعدهمْ","وكم تهجر النفس الزلالَ وتسهر",7,"ر",1,0],["فَنَم آمِناً وَفَيتَ قَومَكَ قِسطَهُم","فَيا طالَما ناموا وَأَنتَ بِيَقظَةِ",8,"ه",1,0],["فَنَم ما شِئتَ لا توحِشكَ دُنيا","وَلا يَحزُنكَ مِن عَيشٍ فَواتُ",9,"ت",1,0],["فَنِمتَ عَنهُ وَلَم تَحفِل بِمَصرَعِهِ","لا مَتَّعَ اللَهُ تِلكَ العَينَ بِالوَسَنِ",10,"ن",1,0],["فَنَمِّ بِأَسرارِ الصَبابَةِ مَدمَعي","وَكُلُّ إِناءٍ بِالَّذي فيهِ يَرشَحُ",11,"ح",1,0],["فَنَمَتْ وأُمِّنَ خَوْفُها وَعَدُوُّها","قد باتَ منها خائفاً مَهْزُولا",12,"ل",2,0],["فَنَما الهَوى فيهِ وَشَبَّ","وَصارَ مَألِفَ كُلِّ حِبِّ",13,"ب",1,0],["فَنِمتُ اللَيلَ إِذ أَوقَعتُ فيكُم","قَبائِلِ عامِرٍ وَبَني تَميمِ",14,"م",1,0],["فنمت فوق أبيك ال","لذي أَعز بنيه",15,"ي",2,0],["فنما في حقله","مخصباً وازدهرا",16,"ر",2,0],["فنما وشبّ عليه من يحمومها","أدمٌ زهاه من السمات مهيبها",17,"ب",3,0],["فَنَمْ على صدريَ الخفوق","واحْلُمْ بما شِئْتَ من هناءِ",18,"ا",2,0],["فنمْ في ظلال الشَّرقِ واهنأ بمضجَعٍ","نديٍّ بأنفاسِ النَّبيِّينَ عاطرِ",19,"ر",1,0],["فنمِ الآنَ في ثرى مصرَ وانزلْ","منزلَ الحبِّ والهدى والسكينه",20,"ن",2,0],["فَنَمْ في حضنِ قافيةٍ رؤوم ٍ","منامَ الصبِّ يحلمُ بالتلاقي",21,"ق",2,0],["فَنَمَّ عَلى الثَرى طيبٌ يَفوحُ","وَنورٌ مِن مَحاسِنِهِ يَلوحُ",22,"ح",1,0],["فنم ملءَ الجفونِ أبا صلاحٍ","ففي الجناتِ للأبرارِ نُزْل",23,"ل",1,0],["فنما المجد على آثارهم","وتخطى بعدما زالوا الزوالا",24,"ل",2,0],["فنمشي على دمنا والطريق º","يضيّعنا والدجى معتمُ",25,"م",1,0],["فَنَمَتْ وأُمِّنَ خَوْفُها وَعَدُوُّها","من عَدَّ موجَ البحرِ عدَّ طويلا",26,"ل",2,0],["فنم واثقا بالله غير مضيع","من الحزم في شيء فقد أوجب السعيا",27,"ي",2,0],["فنمتُ كيما أراهُ","ونامَ كيلا يراني",28,"ن",2,0],["فنمَّت دموعي بالذي قد كتمتُه","ولم أُظهر الشكوى ليعرف مَن عرف",29,"ف",1,0],["فنم في هدوء وفي غبطة","فجهدك في حينه أثمرا",30,"ر",2,0],["فنمت وأسلمت لله روحا","طهورا الى ربه قد أنيبا",31,"ب",2,0],["فنَمَّم الرحمن ربُّ العلا","دهرَ نِزارٍ بالمسَرَّات",32,"ت",1,0],["فَنَمى السُرورُ وَأَصبَحَ الأَنصارُ في","عيدٍ بِمَن شَرفَت بِهِ العيدانِ",33,"ن",1,0],["فَنَمْرَحُ فِي أَكْنَافِ عَيْشٍ مُنَعَّمٍ","وَنَسْرَحُ فِي رَوْضِ السُّرُور ِالْمُنَضَّرِ",34,"ر",1,0],["فنَم ريَّانَ مُغتَبقاً","وقُم ظمآنَ مُصطَبحا",35,"ح",2,0],["فنمزجُ دَمعنا عيناً لعينٍ","وقلبي بالمُنى يَلقى مُناك",36,"ك",1,0],["فنَمشي إِلى نَيلِ العُلى تحتَ رايةٍ","تُظِلُّ بلاداً صانها جيشُها المَجر",37,"ر",1,0],["فنم في ثراها مُطمئنّاً مُكرَّماً","فذاكَ الثّرى قد صارَ مِسكاً وعنبرا",38,"ر",2,0],["فنٌّ من الألم الممض طغ","ى على الأمل المض",39,"ض",1,0],["فَنُماهُم بُؤسي وَراحَتُهُم عَناً","وَأَمنَهُم خَوفٌ وَقُربِهِمُ شَحطُ",40,"ط",1,0],["فَنمّ أَرْضٌ بريحٍ في الدّيارِ لهمْ","ونمَّ ماءٌ بنارٍ في الجوانحِ لي",41,"ل",2,0],["فَنَم لِذا مِنّا عَلى جانِبٍ","ما لَكَ روحٌ أَنتَ جُثمانُ",42,"ن",1,0],["فنمَّ شذا أرجائه بين معشرٍ","رأوا أفضل الإحسان ذكر العواقب",43,"ب",1,0],["فنميل نحن إليه حَسْ","بُ ولا نميل إلى الهدى",44,"ا",1,0],["فَنَمى لَهُ داء الهَوى","وَيَئست مِن إِفراقِهِ",45,"ق",2,0],["فنمشي به صراطا مستيما","صراط الله في علن وإسرار",46,"ر",1,0],["فنم يا عاذلي بالأمن منِّي","فلم تَر بعد عذْلك واعتذاري",47,"ر",2,0],["فَنَمَتْكَ فِي أَقيالِها ومُلُوكِها","وعَمَرْتَ سُبْلَ نوالِها وسَماحِها",48,"ح",3,0],["فنمرح فيها لا الزمان بصادف","منانا وإن شح الزمان وأجدبا",49,"ب",2,0],["فنم بظلال الوهبِ يا خلِّ آمناً","بربك واطرح زعم من ربُّهُ الذهب",50,"ب",1,0],["فنمْشي والأُسودُ لها زَئيرٌ","يرُجُّ مكانَةَ الطَّوْدِ العَظيمِ",51,"م",1,0],["فنَمِ اليومَ كَى تَرى غَيرَ ما قُلتَ","وإلاَّ فقد عَدِمتَ الكَرامَه",52,"م",2,0],["فنم مستريحا فالبلاد بأسرها","سعود وأشبال تجل عن الحصر",53,"ر",1,0],["فَنَم بجوارِ المُرتضى جدّك الذي","له الناس في كلّ النوائب تقصدُ",54,"د",1,0],["فنما بهِ العلمُ الصحيحيُ ومُتّنَت","في ندحة الأَدب الصريح قواعِدُهُ",55,"د",2,0],["فَنَما شُكره وَزاد اِبتِهالاً","وَثَناء لربه وَنَصيره",56,"ر",2,0],["فَنَمَّ لسانِي بالذي صَحَّ عندَه","ولَمْ يَخْشَ عَذْلاً لا ولا لَوْمَ لائِمِ",57,"م",1,0],["فنمَّ على ما ضمَّنتهُ ضلوعهُ","كما نمَّ فضّاحُ الدخانِ على الجمرِ",58,"ر",1,0],["فنمى الحديث إلى الخليفة من له","خضع البرية كلهم وانقادوا",59,"د",3,0],["فنما الصريخ إلى الامام وحزبه","يا غادة الله اغضبي بالعاجلِ",60,"ل",1,0],["فنمشي ، والفتى العملاقُ يُعلي","لواء المالكيّ على الصروح",61,"ح",1,0],["فنم آمناً نم أنت قدوة مقتد","وقبلة مرجو الكمال حصان",62,"ن",1,0],["فَنمت للحين جَميع يَومي","ثَم اِنتَبَهت فَرقاً مِن نَومي",63,"ي",1,0],["فنَمُتُّ بالرَّحِم القريبة بينَنَا","ثدْىٌ على الأدَنْينَ غيرُ مُجَدَّدِ",64,"د",1,0],["فنَما وطابَ محمّد وتكَرّمَت","أَخلاقه وتزَيّنت أَفعالُهُ",65,"ل",2,0],["فنمت يوماً وكنت من سهر ال","ليل وقيذاً كالشارب الثمل",66,"ل",1,0],["فنم قريرا بما قدمت متخذاً","بجار ربك جنات العلى واهناَ",67,"ن",2,0],["فنم آمنا فى دار ربِّك ناعماً","بما قدَمت يمناك ساكناً الخلدَا",68,"د",2,0],["فنما ورفَّ عليه مثلُ","النبت رفَّ على الغديرِ",69,"ر",1,0],["فنم قريراً على تسعينَ ناصعةٍ","يا حسنَها ميتةً يا حسنُهُ هَرَما",70,"م",2,0],["فنماها والموت حتى كأنْ لم","تك كانت أدانه قد نحاها",71,"ا",3,0],["فنم جرس الحلى فيه","وساطع المسك منه والند",72,"د",1,0],["فَنَم آمناً أنتَ الشجاعُ وأَنتَ مَن","ذَهَبتَ شهيداً في الجِنان تَنعَّمُ",73,"م",1,0],["فنمت من غير وساد أو غطا","أو انني امتد لي من ذا وطا",74,"ط",2,0],["فنم بينهما ما كان مكتتما","ما نمه اللفظ لكن نمه النفس",75,"س",1,0],["فنم أنت في منفاك واترك اخاك كي","ينظف ما لوثت في ذلك العصر",76,"ر",1,0],["فنم في هناء، في جوار \"خديجة\"","ونم في رحاب الباسط النضرات",77,"ت",1,0],["فَنَمَّ عليه معسول الأماني","كما نَمَّ النسيمُ على الرياض",78,"ض",1,0],["فنما نمو البدر كاسي نظرة","تزري ببهجة لؤلؤ ونضار",79,"ر",1,0],["فَنٌّ مِنَ العَيشِ لا تُخشى عَواقِبُهُ","وَلا تُثارُ بِهِ الأَحقادُ والإحَنُ",80,"ن",1,0],["فَنَمَا فِي ظِلِّهِ المُلكُ نُمّواً جَوهريّا","وَ حَضَاريّاً لَهُ شَدَّ انتَباهاً دُوَلِيّا",81,"ي",2,0],["فنم هنيئا خلي البال","قرين عين مدى الازمان",82,"ن",1,0],["فنمشي أُطوِّقُها بالذراعِ","وأنشُقُ أنفاسَها العاطره",83,"ر",2,0],["فنمنت السبع الطباق سرادقا","بناها قتام الخيل من غير اعمد",84,"د",1,0],["فنم حلي بات يستصرخ العدا","وغير سواريها الجميع يحارب",85,"ب",1,0],["فنم الدمع من عيني قابدا","سراير سر ما أخفي جهاراً",86,"ر",2,0],["فنمضي معاً أينما شئتمُ","ونحيا معاً حيثما رمتم",87,"م",1,0],["فنِمنا فلما أن تبدت سوابق","من الصبح غطاها الدجى بذيول",88,"ل",1,0],["فنم طيب الحبيب عنا","والطيب كم نم عن حبيب",89,"ب",1,0],["فنُمسي وَقَدْ مدَّ الظلامُ رِواقَه","وَنَفْحُ أَريجِ الزَّهْر من كل جانب",90,"ب",1,0],["فَنَم كما شئتَ حتى الحَشرِ مُغتبطاً","لا عاش مَن يرتضي الدنيَا ويسلوكا",91,"ك",2,0],["فنميرٌ انْ سالمتكَ فَعَنْ كي","دٍ وهل يأَمنُ العدوَّ المُعادَي",92,"د",2,0],["فنمّتْ إليه الريحُ أنّ شَظيّةً","وبهماً بأكنافِ السّماوةِ ضائعُ",93,"ع",1,0],["فنمَّ على عيونكم قذاها","وقد يتطلعُ الداءُ الدَّفِينُ",94,"ن",1,0],["فَنَمَت فُروعُ القَريَتَينِ قُصَيُّها","وَقَسِيُّها بِكَ في الأَشَمِّ الأَكبَرُ",95,"ر",1,0],["فنَما الفِسقُ مُنذُ ذاك بخَلقٍ","خُلِقوا من ذمائِم الأَخلاقِ",96,"ق",1,0],["فنم فالعيش قد أمسى مريرا","ووجه الدهر مبتئس كئيب",97,"ب",1,0],["فنم في نعيم إن سهدي له البقا","وَدُم في رخاء وابق عندي شدائد",98,"د",1,0],["فَنُمسي بكم خَدّاً لخدّ محبةً","وَصَدراً عَلى صَدرٍ وَنهداً عَلى نهد",99,"د",1,0],