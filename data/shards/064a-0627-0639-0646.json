ود لا طاحت سنونه","https://www.poetsgate.com/ViewPoem.aspx?id=135661",""],[4916,"بقايا انسانه","https://www.poetsgate.com/ViewPoem.aspx?id=152166",""],[5039,"بعض الأغاني حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=48130",""],[5184,"على باب الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=186051",""],[5277,"ترَفُ الخوالج","https://www.poetsgate.com/ViewPoem.aspx?id=191056",""],[5338,"غالى ولم يبلغ قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=187759",""],[5358,"ناصية الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=21905",""],[5434,"ذباحة التيس","https://www.poetsgate.com/ViewPoem.aspx?id=37625",""],[5573,"ياعناد","https://www.poetsgate.com/ViewPoem.aspx?id=200344",""],[5690,"يا عنترةَ بسولٍ كفوا","https://www.poetsgate.com/ViewPoem.aspx?id=172287",""],[5756,"الفيصلي","https://www.poetsgate.com/ViewPoem.aspx?id=5382",""],[5956,"سيمفونيَّاتُ نظراتِ الأغنام","https://www.poetsgate.com/ViewPoem.aspx?id=183490",""],[5956,"لله درك يا أحنَّ حبيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=193815",""],[6056,"ملمس الديباج والمخملي","https://www.poetsgate.com/ViewPoem.aspx?id=130141",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6113,"ابعدي يابنت","https://www.poetsgate.com/ViewPoem.aspx?id=14418",""],[6189,"قصيدة عن حب قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67119&r=&rc=4",""],[6328,"عنتر والماسنجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""]],"verses":[["يا عنبرَ الخال في ريحان سالفه","هل بابُ عيشيَ مسرورٌ بمفتاح",0,"ح",1,0],["يا عندليب الروض غرد","للوجوه الناضره",1,"ر",2,0],["يا عندليب ترنَّم","في الروض يا عندليب",2,"ب",1,0],["يا عندليب أَعد ما","تلقيه فالعود أحمد",3,"د",1,0],["يا عندليب الروض ألقِ من الربى","بعضَ القصيد كشاعر مشهور",4,"ر",1,0],["يا عنق الابريق من فضة","وطلعة البدر بلا ريب",5,"ب",1,1],["يا عِنَب المعشوق باللهِ هل","سقاك حتى طِبتَ من رِيقِهِ",6,"ق",2,1],["يَا عَنْبَرَ اللَّيْلِ كَافُورَ الصَّبَاحِ أَعِدْ","قَدْ كَادَ يَلْحَقُنِي مِنْ طُولِكَ الْهَرَمُ",7,"م",1,0],["يا عُنُقَ الإِبريقِ مِن فِضَّةٍ","في الحُسنِ حُزتَ المَذهَبَ المُذهَبا",8,"ب",2,0],["يا عندليب الفكر دونك أدمعي","فاصدح لأنك نحو دمعي صاح",9,"ح",1,0],["يا عنصر اللطف سوريا بأجمعها","تبكيك معربة عما تكن ولا",10,"ا",1,0],["يا عَنائي وجدي كَثيرٌ كَثيرٌ","واحْتِمالي شيءٌ قليلٌ قليلٌ",11,"ل",1,0],["يا عُنقَ الإِبريقِ مِن فِضَّةٍ","وَيا قَوامَ الغُصُنِ الرَطبِ",12,"ب",1,1],["يا عنترة الأبطال لكم","في الغارة ذاع لك الشانُ",13,"ن",1,0],["يا عنتريّ البأس إن ثارت وغىً","واشتد نقعٌ واستطال طرادُ",14,"د",1,0],["يا عنبر الخال في ريحان سالِفِهِ","هل باب حبي مغلوقٌ بمفتاح",15,"ح",1,0],["يا عَندليب كِلانا","بَينَ الرِياض غَريب",16,"ب",1,0],["يا عندليب الوصل قد لي سنين","أرجو وصال الخرد العين",17,"ن",1,0],["يا عنصر العرب الذي فاق الورى","بشريف محتده ومجد فعاله",18,"ل",2,0],["يا عندليب الفضل بل أسد الوغا","يلفي مديحك للفتى ربحا يرام",19,"م",1,0],["يا عنتر اللحظ في لونك وإقدامك","عبلَهْ وليلى بملك الحسن خدّامك",20,"ك",1,0],["يا عندليب الفضل بل أسد","يلفي مديحك للفتى ربحا",21,"ح",2,0],["يا عنصر النور القديم فخاره","حقا وآدم لم يكن فخارا",22,"ر",2,0],["يا عندما قد صَبغت وجَنته","أظنّك اليوم قد سَرقت دمي",23,"م",2,0],["يا عنفوان الردى يا بدء من ولدوا","لها ومن كبروا فيها وما شابوا",24,"ب",3,0],["يا عنفوان الردى يا صوت من ولِدوا","لها ومن كبروا فيها وما شابوا",25,"ب",3,0],["ياعنا القناص يالصيد المّدسم","ياكتاب الشمس وكتاب الطلاسم",26,"م",1,1],["ياعنك يامقشر ظنونه","يموت والمجد ما ناله",27,"ل",2,0],["ياعنك حتى لو بشل اشعاري","صوتي حزين ولا يطيق ألحانه",28,"ن",2,0],["ياعنّها ماجت حياتي لو أقفيت","وش ينفع المجداف عقب السفينه",29,"ن",2,1],["يا عنفوانَ الورد .. اين اناملي","أجَرحتَ فيها نشوةَ الفَلّاحِ ؟؟",30,"ح",1,0],["يا عَنْدَليبَ الحَرْفِ أنتِ حَبيبتي","عُرْسٌ تَزِفُّ عَروسَهُ الأطْيارُ",31,"ر",1,0],["يَا عُنْفُوَانَ الْفِكْرِ يَا","فَضْلًا يُطَوِّقُ كُلََّ جِيدِ",32,"د",1,0],["يَا عُنْفُوَانَ الْفِكْرِ إِنَّ-","- يَدًا تُمَدُّ إِلَى الْقُيودِ",32,"د",1,0],["يَا عُنْفُوَانَ الْفِكْرِ مَا","لاَ قَيْتَ مِنْ طَاغٍ عَنودِ",32,"د",1,0],["يا عنفوانَ الهوى رِفقاً بحاضِرِنا","ويا طيورَ الصِّبا عودي بماضينا",33,"ن",2,0],["ياعنك ماتغنيك ذباحة التيس","ربع السعد مادام حملك خفيفي",34,"ي",1,1],["ياعناد اشكي على الله من همومي والعذاب","ويشهد الله من صهيلك ينطرب قلبن عطيب",35,"ب",1,1],["يا عنترةَ بسولٍ كفوا","عن سائلِ دمعٍ منصبِ",36,"ب",1,1],["ياعناوين المروءه والشهامه والشكاله","يالرحيب اللي قريتك في وجيه الطيبين",37,"ن",1,0],["يا عنزةً ترنو إليَّ برحمة","صَعْبٌ عليَّ من التراحم أَنْزَعُ",38,"ع",1,0],["يا عنكبوتَ الغارِ أنت سترتني","كأبيك من فقرٍ ومن تقطيبِ",39,"ب",1,0],["يا عنك راعي الحسد يبان من منطقه","مهما تشدّق بلحن القول وتمهزلي",40,"ل",2,0],["يا عُنفُوانَ النَّخلِ كُنْ","صَلْبًا: يُهَدُّ... وَلا يُطاوِعْ",41,"ع",1,0],["ياعناي اللي ذبحني بس طير","صرت اشوفك تحت ون الناس فوق",42,"ق",1,0],["يا عُنفوانَ الشِّعرِ حين أهزُّهُ","والخطبُ هوْلُ ، والمدارُ نعيقُ",43,"ق",1,0],["يا ( عنترَ العبسيّ ) لا تعبأ بنا","نحنُ الطرائدُ والأعادي قسورة",44,"ر",2,0],["يا ( عنترَ العبسيّ ) ماتَ حصاننا","والروحُ في الفرسان ِصارتْ غرغرة",44,"ر",2,0],["يا ( عنترَ العبسيّ ) إن زمانَنا","الحبُّ فيهِ والشجاعة ُمسخرة",44,"ر",2,0]]}