{"poems":[[88,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[95,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[508,"أيها الجاهل المسيء الظن","https://www.aldiwan.net/poem21753.html","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133795","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105435","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67197","الكامل"],[2538,"","https://poetry.dctabudhabi.ae/diwan/poem/104500","البسيط"]],"verses":[["إِن مَثَّلوا فَدَعِ الخَيالَ فَإِنَّما","عِندَ الحَقيقَةِ يَسقُطُ التَمثيلُ",0,"ل",1,0],["إِنْ مَثَّلا وَطَنَيْنِ اليَوْمَ فِي وَطَنٍ","فَمَا العُروبَةُ إِلاَّ شَمْلُ أَوْطَانِ",1,"ن",1,0],["إنَّ مِثلِي مِنَ الرِّجَالِ قَلِيلٌ","حِينَ يَبدُو مِنَ النِّساءِ البَرِينُ",2,"ن",1,0],["إن مثواك بيننا","غربة ساقها القدر",3,"ر",1,0],["إن مثلت بك ميتاً كم غظتها","حيا بنظم كفاحك الغياظ",4,"ظ",1,0],["إن مثوى المستكبرين خلودٌ","في زفيرِ الجحيمِ والنيرانِ",5,"ن",1,0],["إن مثَّلت عيناكَ شخصاَ منهم","لم تلفَ إلاّ الألمعيَ الأَمثَلا",6,"ل",2,0],["ان مثلت غيركم نفسي فقد كذبت","أجل ورؤية عيني غيركم حلم",7,"م",1,0]]}