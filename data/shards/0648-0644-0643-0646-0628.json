ِ",149,"ر",1,0],["ولكن بذكري للذي هو بغيتي","سلوت عن النسوان مثنى ومربعا",150,"ع",2,0],["وَلكِن بِلا جَدوى أَتَيتُ فَلَم أَجِد","سِوى قَفرَةٍ أَشباحُها تَتَكاثَرُ",151,"ر",1,0],["وَلَكِن بِمَتنِ المِجَنِّ وَقَع","وَهَكطورَ بِالعُنفِ رَغماً دَفَع",152,"ع",1,0],["ولكِن بآلِ العُلى وَثِقا","وكُلَّ وُجُودٍ لَها مَحَقا",153,"ق",2,0],["وَلكِن بِنا قُومي فَخَيلَكِ هَيئِّي","لأُحضِرَ في مَغنَاهُ لِلحَربِ شِكَّتِي",154,"ي",1,0],["ولكن بادرت فالا","س تنزعه على عجلٍ",155,"ل",1,0],["ولكن بنا سيري فمهما يهج أسىً","فؤادي ففي زفس الجلال تحققا",156,"ق",2,0],["ولكن بخير العلم زفس أسارني","نعم وهو أسمى مشفقٍ لك منصف",156,"ف",1,0],["ولكن بي غصةً حرقت","فؤادي الكليم بحر اللظى",157,"ظ",2,0],["وَلكن بيعة سبقت وَأَعطى","بصفقته فَكانَت كاللزام",158,"م",1,0],["ولكنْ بما شاهدتُ كم مملقٍ به","تفانى وكم أحيا الحشاشةَ جائع",159,"ع",1,0],["ولكن بحر العلم بين أضالعي","طمى فرمى من دره النظم والنثرا",160,"ر",2,0],["ولكنّ بشرى إنها لطليعة ال","وزارة إذ حقّاً ستأتيك في غدِ",161,"د",1,0],["ولكن بمضمار الهداية قد حوى","فصب السباق بسابح سباق",162,"ق",1,0],["ولكن بأَمر اللَه فالمرءُ مُعتَقٌ","وَيَفعل ما يَبغي وتهوى ضرائبه",163,"ب",2,0],["ولكن بالوفاءِ على قبيحٍ","تَراهُ جاءَ مصداقاً شَهيرا",164,"ر",2,0],["ولكن بمن أضحت وحيدة عصرها","نسيت من الأشواق ما جل أو دقَّا",165,"ق",2,0],["ولكن بجاه الأكرمين أصولنا","نحول من ذا المر للمنى والسلوى",166,"و",2,0],["ولكنَّ بالدينِ الأبَاضِي تعلَّقتْ","وعزَّت فما سَامَ العدوَّ وصولُ",167,"ل",1,0],["ولكن بذريّة صالحين","بهم يستزيدُ عديّ عديد",168,"د",1,0],["ولكن بلحن معرب عن دوائه","تغنى فأغنى أحمد بغنائه",169,"ه",1,0],["ولكن بالأعضاد فتَّ بعادُه","وان كان من قلب المحبِّ قريبا",170,"ب",2,0],["وَلَكِن بِذَوبِ الثَلجِ يُرفَعُ حُكمُهُ","وَيوضَعُ حُكمُ الماءِ وَالأَمرُ واقِعُ",171,"ع",1,0],["وَلَكِن بِإيمانٍ وَحُسنِ تَتَبُّعٍ","إِذا قُمتَ جاءَتكَ الأُمورُ تَوابِعُ",171,"ع",1,0],["ولكنْ بفكرِ رصينٍ وعادلْ","لدَيْنا الحلولُ لكلِّ المشاكلْ",172,"ل",1,0],["ولكن بعد ما مات (الصقر) جا للطيور بخوت","وأنا عنهم من (أمّات التسع) في ذاالثمان أدليت",173,"ت",1,0],["ولكن بطني حين يدعو أجي