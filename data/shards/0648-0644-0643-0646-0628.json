ا يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5369,"ستشرق شمس","https://www.poetsgate.com/ViewPoem.aspx?id=177450",""],[5397,"لعمر العلى ما كل من طلب الفخرا","https://www.poetsgate.com/ViewPoem.aspx?id=157968",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[351,"خُذوا بِدَمِي ذَات الوشَاحِ ، فإنَّنِي","https://www.poetsgate.com/ViewPoem.aspx?id=4531",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5616,"أبا الطيب عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=203454",""],[5704,"ألا إن الحبيب مضى وغابا٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204191",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"العين بالعين..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183739",""],[5956,"بالتجاوب لن أعابا","https://www.poetsgate.com/ViewPoem.aspx?id=192424",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[5977,"نقّل فؤادك","https://www.poetsgate.com/ViewPoem.aspx?id=213301",""],[242,"ألا قل لمن يبغي الى العز منفذا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563806",""],[6164,"ماض وحاضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66043&r=&rc=52",""],[6177,"الهجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79065&r=&rc=12",""],[6189,"أحزان جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83596&r=&rc=63",""],[2220,"عجبت لمن دعا ولمن أجابا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11191&r=&rc=65",""],[572,"تَعَزَّ أَبا بكرٍ المرتَجَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9367&r=&rc=224",""]],"verses":[["ولكن بأن تبلوا الزمان قريحتي","ولما تشبها في الزمان شوائبه",0,"ب",2,0],["ولكن بعض الشيء يذكر بعضه","وللحر يكفي أن تشير ليفهما",1,"م",2,0],["ولكِنْ بعْضُ حقِّكَ قُمْتَ فِيهِ","بحقِّكَ بعْدَما استُرِقَ اسْتِراقا",2,"ق",2,0],["وَلَكِن بَلَوا في الجَدِّ مِنكَ ضَريبَةً","بَعيداً ثَراها مُسمَهِرّاً وَجينُها",3,"ن",3,0],["ولكن بطيّارات قوم تطايرت","فكانت من شُواظٍ سحائبا",4,"ب",2,0],["وَلَكِن بِالعُيونِ وَكُلِّ خَدٍّ","تَخالُ بِهِ لِبَهجَتِهِ صِقالا",5,"ل",2,0],["وَلَكِن بِهَذاكَ اليَفاعِ فَأَوقِدي","بِجَزلٍ إِذا أَوقَدتِ لا بِضِرامِ",6,"م",1,0],["ولكِن بِخَأجَأَةِ الأَكرَمِينَ","بِحَظِّيَ في الأكرَمِ الأَطيَبِ",7,"ب",1,0],["وَلَكِن بَينَ ذَلِكَ من أُناس","بِلَيلَى في الغِنَاءِ مُوَكَّلِينَا",8,"ن",2,0],["وَلَكِن بَينَنا بَينٌ وَهَجرٌ","أَأَرجو بَعدَ ذَلِكَ مِن صَلاحِ",9,"ح",1,0],["ولكنْ بَغَى حتى نُصِرْتَ فلم تَكُنْ","تُنَقِّصُهُ إلّا وأَنْتَ تَزَيَّدُ",10,"د",1,0],["ولكن بشمِّ المسك والبان ذُوِّفا","فلا يكن الحساد من ذاك في لَبِس",11,"س",1,0],["ولكنَّ بي من بعد ذلك حاجةً","إلى أن يرى راء ويسمع سامع",12,"ع",1,0],["ولكن بين ذلكُمُ","قواماً فهي مُعتدِلَهْ",13,"ل",2,0],["وَلَكِن بَدا مِنهُ جَفاءٌ فَساءَني","وَذَلِكَ شَيءٌ لَم يَمُرَّ بِبالي",14,"ل",2,0],["ولكن بينهما فارقا","ففيهم حماس وفيهم بلاده",15,"د",2,0],["وَلَكِنَّ بِالفُسطاطِ بَحراً أَزَرتُهُ","حَياتي وَنُصحي وَالهَوى وَالقَوافِيا",16,"ي",2,0],["وَلَكِن بِعُثمانِ البَسيطَةِ قَد تَرى","بِها بُدَّناً أَفخاذُها وَفُراتِ",17,"ت",1,0],["وَلَكِن بِكَفَّيكَ الكَثيرِ نَداهُما","وَنَفسِكَ قَد أَحكَمتَ عِندَ الوَثائِقِ",18,"ق",1,0],["وَلَكِن بَدا لِلذُلِّ رَأسُكَ قاعِداً","بِقَرقَرَةٍ بَينَ الجِداءِ التَوائِمِ",19,"م",1,0],["وَلَكن بِرفقٍ أَو رُقىً لَودَعَت بِها","مِن الرُقشِ في لِصبٍ تَقَرَّبَ أَعرَما",20,"م",2,0],["ولكِنْ به بَدْءاً وبالعيشِ كلّهِ","حميداً على العِلاّتِ غيرَ مُذَمَّم",21,"م",1,0],["وَلَكِن بِتُّ شَرّاً مِنكَ فِعلاً","فَأَغنَيتُ الوِدادَ عَنِ التَقاضي",22,"ض",2,0],["وَلَكِن بَيانٌ زيدَ فيكَ وَإِنَّما","جَرَينا مِنَ الأَمرِ القَديمِ عَلى رَسمِ",23,"م",1,0],["وَلَكِن بِأَطرافِ القَنا وَكُعوبِهِ","وَضَربِ الهَوادي بِالحَديدِ المُسَمَّمِ",24,"م",1,0],["ولكِنْ بالعَواصِمِ من عَدِيّ","أمِيرٌ لا يُكَلّفُنا السّؤالا",25,"ل",2,0],["وَلكن بكاها المستمر لحزنها","عَلى دلبرٍ ما كانَ يُجدي وَيثمر",26,"ر",1,0],["ولكِنْ بَكَتْ قَبْلي فَهَاجَ لِيَ البُكَا","بُكَاهَا فَقُلْتُ الفَضْلُ لِلْمُتَقَدِّمِ",27,"م",1,0],["ولكِنْ بِوَاهِي شَنَّتَيْ مُتَعَجِّلٍ","عَلَى ظَهْرِ عَجْعَاجٍ مِنَ الجُونِ أَجْرَدَا",28,"د",2,0],["ولكنْ بِبَدْرٍ سَائِلوا مَنْ لَقِيتُمُ","مِنَ النّاسِ والأنبَاءُ بالغَيْبِ تَنْفَعُ",29,"ع",1,0],["ولكن بكفٍّ علَّمَ الزندُ كفَّها","مُقارعَةً او يسقطُ الزندُ واهيا",30,"ي",2,0],["ولكنّ بؤساً مُفْرِخاً حَطَّ ثِقْلَهُ","وألقى عصاه فهو موتٌ مخامر",31,"ر",1,0],["ولكنْ بما أُلهِمَ الصابرون","وقد يقرأُ الغيبَ مُستَلهِم",32,"م",1,0],["ولكن بجود أبي قاسمٍ","عُمرنَ المكارمَ بعد العفاءِ",33,"ا",2,0],["ولكن بها سبع مئين وضوعفت","وخذها من السبع السنابل إن تقرا",34,"ر",2,0],["وَلكِن بِكَّقى أُمِّ عَمرٍو فَليتَهَا","إِذا وَلِيَت رَهناً تَلِى الرَّهنَ بِالقَصدِ",35,"د",1,0],["ولكنْ بالشّباب الغضِّ شَيْبٌ","أُكابِدُه وبالوطنِ اغْتِراب",36,"ب",1,0],["وَلكن بِقدرِ القابليّة نورُها","يَكونُ قَليلاً بالمقابلِ أو نزرا",37,"ر",2,0],["وَلَكن بودّي أنّ دين محمّدٍ","تعمُّ جميعَ الناسِ نعمتهُ الكُبرا",38,"ر",2,0],["وَلَكن بحُكمِ الإرثِ للدينِ قلّدوا","رَهابينَهم مَهما رَأوا طعمهُ مرّا",38,"ر",2,0],["ولكن بك الغفران ارجو تكرما","اذا ضبطت اعمال اهل الشقا ضبطا",39,"ط",2,0],["وَلكِنَّ بي نَدَماً كَاللَّهيبِ","يُريني الحَياةَ خِلافَ الشَرَر",40,"ر",1,0],["ولكن بها بعد هذا وذاك","فتون الهوى والجمال العفيف",41,"ف",1,0],["وَلَكِنْ بَِقَصْدٍ وَاجْتِنَابِ تَبَذُّرٍ","وَإِلاَّ فَقَدْ تَبْلَى وَلَنْ تُلْفَ مُنْقَذَا",42,"ذ",2,0],["ولكن بالوجوه البيض مثل ال","أهلة تحت أغصان القدود",43,"د",1,0],["ولكنَّ بعدَ الحبّ بُعداً وسلوةً","فما من بقاءٍ في ديارِ فناة",44,"ه",1,0],["ولكنْ بقول الحقّ أغربت فيكُمُ","ومن يَتَوَخَّ الحَقَّ بالحَقِّ ينطِقِ",45,"ق",1,0],["ولكن بين ما يصطاد بازٍ","وما يصطاده الزنبور فرق",46,"ق",1,0],["ولكنْ بدا لي منك ما لا أطيقه","وإنْ كنت فرداً باحتمال العظائم",47,"م",1,0],["وَلَكِن بِالهُدى قَولاً وَفِعلاً","وَإِدمان التَجَشُّعِ في اللِحاظِ",48,"ظ",1,0],["ولكن بنور العلم تسلم هذه","وتعطب جهلاً تيك أقبح عطبه",49,"ه",1,0],["وَلَكِن بَكَت قَبلي فَهَيَّجَ لِيَ البُكى","بُكاها فَقُلت الفَضل لِلمُتَقَدِّمِ",50,"م",1,0],["وَلَكِن بَعدَ قُربِهِمُ","بِعَدوي مِنهُم بَعَدوا",51,"د",3,0],["وَلَكن بَيت مَجدك بَيت مَدحٍ","مَتى ننظم بِهِ نَزن القَصيدا",52,"د",2,0],["وَلكِن بِرُّهُ يَحنو عَلَينَا","كَمَا تَحنو عَلَى القَلبِ الضُّلُوعُ",53,"ع",1,0],["ولكنْ بطُولِ الخوضِ في غمَراتها","وبطْشُ المنايا بالرِّجالِ شَديد",54,"د",1,0],["ولكن بوناً بين غرقى بأبحرٍ","وبين غريقٍ في المآثم والوزر",55,"ر",1,0],["ولكِنْ بكيتُ لِخَوفِ الفراقِ","فأفْنيته قبل يومِ الفِراقِ",56,"ق",1,0],["ولكِنْ بسَعْيكَ يا بْنَ النبي","يَنَال المؤمَّل أَقصى الأَمَلْ",57,"ل",1,0],["ولكن بأقدار يقدرها الذي","له الأمر في الأكوان من غير إلباس",58,"س",1,0],["ولكن بجيش للهموم وللأسى","وقوس من الأحزان أصمت به قلبي",59,"ب",2,0],["ولكن بأن يعتلى ظهرها","ويغزى عليها ببطن الفلا",60,"ا",1,0],["ولكن بسوء الحظْ يثني عنانه","إلى حيث يشقى عنده من يحاول",61,"ل",1,0],["ولكن بهذا العصر أنت كجنةٍ","بها تتباهى بروة الشام والخالُ",62,"ل",1,0],["ولكنْ بآباءٍ يقر لِمُلْكِهِمْ","وتشهَدُ ساداتُ الملوكِ على عِلمِ",63,"م",1,0],["ولكن بذلت الجهد فيك عساك أن","ترى العذر في التقصير حقّا فتعذرا",64,"ر",2,0],["ولكن بحكم الحظ فالحظ كالوغى","وفي عنفها الهيجاء قد تلد الصلحا",65,"ح",2,0],["ولكن ببغدادٍ فما أنت صانعٌ","وحظُّك منها شعبةٌ من كرامِها",66,"م",3,0],["ولكن بايِعاهُ عن لساني","فإنّي حين أَعجِزُ أستشيرُ",67,"ر",1,0],["وَلَكِن بِكَفّي أُمَّ عَمروٍ فَلَيتَها","إِذا وَلِيَت رَهناً تِلي الرَهنَ بِالقَصدِ",68,"د",1,0],["وَلَكِن بِآباءٍ كِرامٍ غَطارِفٍ","تَزيدُ مَعاليهِم عَلى عَدَدِ القَطرِ",69,"ر",1,0],["ولكنّ بقاءَ النّهرِ رهنٌ","بماءٍ أُسُّهُ المزْنُ الطّواهرْ",70,"ر",1,0],["ولكن بي ظناً أبى أن يقيمني","لديك بما لا أرتضيه مصوبا",71,"ب",2,0],["ولكن بلغت المنتهى مترقياً","ذرى شرف أعليت من