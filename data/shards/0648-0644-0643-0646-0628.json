َهم","أباحَ لطيب القلب بعضَ نُفُور",97,"ر",1,0],["ولكِن بأطرافِ الرماحِ فإِنَّها","شِفاءُ الصدورِ والمذاكي القوافِلُ",98,"ل",1,0],["ولكن بنفحٍ يُخجِلُ الروضَ زاهراً","ولكن بدعسٍ في كُلىً ورقاب",99,"ب",1,0],["ولكنّ بيضَ الهند تسعر نارَنا","إذا ما خبت نار الاعادي فما تخبو",100,"ب",2,0],["وَلَكِن بَغَوصِ الفِكرِ بَعدَ اِرتِياضِهِ","زَماناً بِآدابٍ تُعينُ وَتُفهِمُ",101,"م",1,0],["ولكن بعد ما كانت تغني","بها الرشوات يا مولاي بحت",102,"ت",1,0],["وَلكِن بِأَيديكُم تُراقُ دِماؤُكُم","وَيَحكُمُ في أَرحامِكُم مَن يَكيدُها",103,"د",3,0],["ولكن بقدر علو المكان","يكون هبوط الذي يسقط",104,"ط",1,0],["وَلكِن بِجَوفِ المَرءِ وَاللَهِ مُضغَةٌ","عَلَيها مَدارُ الحَلِّ في الدينِ وَالعَقدِ",105,"د",1,0],["ولكن ببادي الرأي أو باشاعة","تراماه عن قوس طوائف ذا العصر",106,"ر",1,0],["ولكن بإذنِ الشرعِ لا بعقولنا","ولو قال عقلي ما أعرت له أذنا",107,"ن",2,0],["ولكن بالإيابةِ عن قبولٍ","لدعوته فأخطأ ما أصابا",108,"ب",2,0],["ولكن بشرط الامتثال لأمرنا","وإنْ لم يكن هذا فما كنتَ إذ كنتا",109,"ت",2,0],["ولكن بنو العلياء يحلو به الثنا","عليهم وأصداء العقول تزول",110,"ل",1,0],["ولكن بنو مروان كفراً وخسة","أحاطت بذاك الدين من كل جانب",111,"ب",1,0],["ولكن بشراً سهل الباب للتي","يكون لبشر غبها الحمد والأجر",112,"ر",1,0],["ولكن بنو خَيرٍ وشَرٍّ كلَيهما","جَميعاً ومعروفٍ ألمَّ ومُنكَرِ",113,"ر",1,1],["ولكن بمولائي ارى كلّ كُربةٍ","تَزول ومنها الدمعُ كان سَفوحُ",114,"ح",1,0],["وَلَكِن بِتُرسٍ لَيسَ فيها حَمالَةٌ","وَرُمحٍ ضَعيفِ الزُجِّ مُنصَدِعِ النَصلِ",115,"ل",1,0],["ولكن باء عذالي بفوز","وجاؤا بالذي لا أرتضيه",116,"ي",2,0],["وَلَكن بِالعُيونِ اللَخصِ","ذاتِ الأَنفِ الذُلفِ",117,"ف",1,0],["وَلَكن بذهنٍ ثابِت قَد تَشهَّدَت","ثَلاثاً وَفاضَت وَهيَ فيهِ تُراجِعُ",118,"ع",1,0],["وَلَكن بِجودٍ وَاحتِمالٍ يَزينُها","بِنَفحٍ لِذي فَقرٍ وَصَفحٍ عَن البَذي",119,"ذ",2,0],["ولكن بتاييد متين وقوة","وامر سماوى حوى ذروة الفجر",120,"ر",1,0],["ولكن بذلت الوجه في الناس أرتجي","من الاخوة الغر النهى نشر سلطاني",121,"ن",2,0],["ولكن بنى الدنيا يميلون ميلها","وحيث تولت بالصروف تصرفوا",122,"ف",3,0],["ولكن به أصبحت واللّه واثق