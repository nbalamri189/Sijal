{"poems":[[79,"بشرى يقوم لها الزمان خطيبا","https://www.aldiwan.net/poem36781.html","الكامل"],[99,"قل للذين بكوا على شوقي","https://www.aldiwan.net/poem24774.html","أحذ الكامل"],[77,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"هذا طريق للهدى لا حب","https://www.aldiwan.net/poem22107.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[443,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[458,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[563,"ظهرت لي يا غيب يا مطلق","https://www.aldiwan.net/poem34302.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64341","المنسرح"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202110","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111810","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48328","الدوبيت"],[4802,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=34355",""],[5493,"كفُّ المدى","https://www.poetsgate.com/ViewPoem.aspx?id=197091",""],[5526,"قهوتي والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192431",""],[5718,"السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=214026",""],[5756,"اقرب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=5436",""],[5829,"ما سواها زائل","https://www.poetsgate.com/ViewPoem.aspx?id=204861",""],[5953,"اسمٌ قديمٌ ومعنىً","https://www.poetsgate.com/ViewPoem.aspx?id=93837",""],[6093,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=197001",""],[6113,"الهايج والذلول......","https://www.poetsgate.com/ViewPoem.aspx?id=37153",""]],"verses":[["هَذَا طُلُوعُ فُتُوحِكَ الغُرِّ الَّتِي","مَا كَانَ طَالِعُ سَعْدِهَا لِيَغِيْبَا",0,"ب",2,0],["هذا طريق قد ألفناهُ","نمشي وراءَ مُشَيَّعٍ غالِ",1,"ل",1,0],["هذا طرازٌ ما العيون كتبنَه","لكنّه قبلَ العُيونِ تكتّبا",2,"ب",2,0],["هَذا طَريقٌ لِلهُدى لا حِبُ","يَرضى بِهِ المَصحوبُ وَالصاحِبُ",3,"ب",1,1],["هذا طريقُكَ للبيتِ الذي ألِفَتْ","خُطاكَ بالأمسِ فاسلكهُ على مَهلِ",4,"ل",1,0],["هذا طلابك جود لا ترام إذن","صفاته بين تكييف وتحديد",5,"د",1,0],["هذا طوافي حول قبركَ خاشعاً","أبكى كأنَّ الدمعَ من إحرامي",6,"م",2,0],["هذا طريق واسع والسوى","ذاك طريق أعوج ضيق",7,"ق",1,0],["هذا طبيب جسومنا ونفوسنا","صحت وطابت بالخبير المقتدر",8,"ر",1,0],["هذا طراز عليك أم سبج","ذانك صدغان أم هما زرد",9,"د",1,0],["هذا طريق الرشد لا غيره","إن كنت تبغي الرشد فأتْبَعْنِي",10,"ن",2,0],["هَذا طَريق شاسع مَجهول","وَالليث لا تَأمنه وَالغول",11,"ل",1,0],["هذا طريحُ جفاكَ اسكرَهُ الهوى","فهوَى وقد أودى بهِ التبريحُ",12,"ح",1,0],["هذا طمَعي لو نالِ منْهُ ما ابْتغَى","فالدّمعُ طَما وجمْرُ وجْدي قد طَغا",13,"غ",2,0],["هذا طموحي وأحسب إني أناني","ياللي تبني فيه أحقق طموحي",14,"ح",2,0],["هذا طريحُ الجرحِ كادَ يُحيلُه","شبحًا بغيرِ اسْمٍ ولا ألقابِ",15,"ب",1,0],["هذا طيفك !! كيف لو جيتي دهر","غارقٍ ب حروف اسمك .. يرسمه",16,"م",2,0],["هَذَا طَرِيقُكَ إِنْ أَرَدْتَ سَعَادَةً","تُنْجِيكَ مِنْ هَمٍّ ومِنْ آلامِ",17,"م",1,0],["هذا طريقي وكثر الناس يدرون","صديت عن درب حلاله حرامه",18,"م",2,0],["هذا طهور ان عكفت لطاعة","او تستكين فذاك حد فاصل",19,"ل",1,0],["هذا طريقٌ إلى الحق","والهدى مستقيم",20,"م",1,0],["هَذَا طَريِْقِيْ في الغَرَامِ وليْسَ لِيْ","غَيْرُ البَّسَاطَةِ إنْ أردتِ ، تَعَالِي",21,"ي",1,0],["هذا طبع الناس عاون واستعين","وانت طبعك من تعارفناجفول",22,"ل",1,0]]}