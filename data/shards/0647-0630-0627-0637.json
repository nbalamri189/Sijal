{"poems":[[79,"بشرى يقوم لها الزمان خطيبا","https://www.aldiwan.net/poem36781.html","الكامل"],[99,"قل للذين بكوا على شوقي","https://www.aldiwan.net/poem24774.html","أحذ الكامل"],[77,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"هذا طريق للهدى لا حب","https://www.aldiwan.net/poem22107.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[441,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[456,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[561,"ظهرت لي يا غيب يا مطلق","https://www.aldiwan.net/poem34302.html","السريع"]],"verses":[["هَذَا طُلُوعُ فُتُوحِكَ الغُرِّ الَّتِي","مَا كَانَ طَالِعُ سَعْدِهَا لِيَغِيْبَا",0,"ب",2,0],["هذا طريق قد ألفناهُ","نمشي وراءَ مُشَيَّعٍ غالِ",1,"ل",1,0],["هذا طرازٌ ما العيون كتبنَه","لكنّه قبلَ العُيونِ تكتّبا",2,"ب",2,0],["هَذا طَريقٌ لِلهُدى لا حِبُ","يَرضى بِهِ المَصحوبُ وَالصاحِبُ",3,"ب",1,1],["هذا طريقُكَ للبيتِ الذي ألِفَتْ","خُطاكَ بالأمسِ فاسلكهُ على مَهلِ",4,"ل",1,0],["هذا طلابك جود لا ترام إذن","صفاته بين تكييف وتحديد",5,"د",1,0],["هذا طوافي حول قبركَ خاشعاً","أبكى كأنَّ الدمعَ من إحرامي",6,"م",2,0],["هذا طريق واسع والسوى","ذاك طريق أعوج ضيق",7,"ق",1,0]]}