poem/124627","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69952","الوافر"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127135","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135126","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83186","الرجز"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96074","الطويل"],[4691,"توضأ قلبي بماء الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=59823",""],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4778,"قلم القضا","https://www.poetsgate.com/ViewPoem.aspx?id=200387",""],[4869,"سنوات الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=151539",""],[4869,"الحراميه","https://www.poetsgate.com/ViewPoem.aspx?id=151546",""],[4926,"وحَّد إلهك لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[5061,"النصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=156538",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[5344,"اما تقول الخير او إلزم الصمت..","https://www.poetsgate.com/ViewPoem.aspx?id=180834",""],[5413,"إنا بفراقكما لمحزونون","https://www.poetsgate.com/ViewPoem.aspx?id=208634",""],[5550,"أَبُثُّ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213054",""],[5605,"يا موجعا","https://www.poetsgate.com/ViewPoem.aspx?id=161346",""],[5628,"ترتيلة عند السحر","https://www.poetsgate.com/ViewPoem.aspx?id=178484",""],[2598,"أَقُولُ وَالكَأْسُ فِي كَفِّي أُقَلِّبُها","https://www.poetsgate.com/ViewPoem.aspx?id=20755",""],[6035,"إنّ المُقَرِّظَ بالأحبابِ مُتَّهَمُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177163",""],[6089,"هبْ لي جمارك","https://www.poetsgate.com/ViewPoem.aspx?id=213860",""],[6225,"الحصادُ المُرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78052&r=&rc=137",""]],"verses":[["وَلا تَصحَبَن غَيرَ حَدِّ الحُسا","مِ بَرقاً يَسُحُّ مِنَ الضَربِ وَبلا",0,"ل",2,0],["ولا تَصْطَنِعْ إلا الكِرامَ فإنّهُمْ","يُجازونَ بالنَّعْماءِ مَنْ كان مُنْعِما",1,"م",2,0],["ولا تَصْرِفاها عنْ وُرودِ جِمامِهِ","فكَمْ شرِقَتْ بالرّيقِ في موْرِدِ الجُهْدِ",2,"د",1,0],["وَلا تَصولي بِالقَوامِ الَّذي","تَميسُ فيهِ يا مُنايَ المَنون",3,"ن",1,0],["ولا تَصَبّ إلى جارٍ وإِن ظعنت","بعد المُقام وفي أجوافها الثقلُ",4,"ل",1,0],["ولا تُصِخْ لأحاديث الذين مضوا","ألوى العنان بما تملى الروايات",5,"ت",1,0],["وَلا تَصحَب أَخا الجَهلِ","وَإِيّاكَ وَإِيّاهُ",6,"ا",2,0],["وَلا تُصاحِب مَن في طَبائِعِهِ","سِرٌّ لِأَنَّ الطِباعَ تُستَرَقُ",7,"ق",1,0],["وَلا تُصاحِب غَيرَ ذي التَحقيقِ","فَالتَمُّ لايَطيرُ بَينَ الشيقِ",8,"ق",1,0],["وَلا تُصغِيَن لِقَبيحٍ","يَقولُهُ فيكَ قَومُ",9,"م",1,0],["وَلا تَصِفِ الحَضارَةَ لي فَإِنّي","أَرى عَصرَ الحَضارَةِ شَرَّ عَصرِ",10,"ر",1,0],["ولا تَصَدَّوْا لما لم يرض خاطرُهُ","إنَّ التَّصدِّي لما لم يرضه خطَرُ",11,"ر",1,0],["وَلا تُصَدِّقُ بِما البُرهانُ يُبطِلُهُ","فَتَستَفيدُ مِنَ التَصديقِ تَكذيبا",12,"ب",2,0],["وَلا تَصومُ لِوَجهِ اللَهِ مُحتَسِباً","أَم غَيرَ صَومِكَ أَمسى الهَمَّ وَالسَدَما",13,"م",2,0],["وَلا تُصَدِّقهُم إِذا حَدَّثوا","فَإِنَّني أَعهَدُهُم يَكذِبون",14,"ن",1,0],["ولا تصاحب لئيماً","أو أحمقاً أو حسوداً",15,"د",2,0],["ولا تَصْطَحِبْ إِلَّا امْرَأً إِنْ دَعَوْتَهُ","لَدَى جَمَرَاتِ الْحَرْبِ لبَّاكَ وَاحْتَذَى",16,"ذ",2,0],["ولا تُصْغي إلى همس الأماني","وإلا، عشْت في همٍّ مُقيم",17,"م",1,0],["ولا تصليا دمعي بتجريح مقلتي","فدمعي مقبول على القلب ما أدا",18,"د",2,0],["ولا تصحبن إلا تقيّاً مهذّباً","فقدرُك من عليائهِ لم يزل يَعْلُو",19,"ل",2,0],["وَلا تُصاحب أخَا كذِبٍ وكنْ فطِناً","في الفِعل والقول والأخبار والأثرِ",20,"ر",1,0],["ولا تصغ للفتوى التي نطقت بها","رجال هوى حابوا رجال هوى شكلا",21,"ل",2,0],["وَلا تَصِلني فَإِنَّ أَخذي","عِرضَكَ أَحلى مِنَ العَطاءِ",22,"ا",2,0],["وَلاَ تُصِخْ لِدَوَاعِي الْبَثِّ إِنْ صََدَحَتْ","إِنَّ دَواعِيهِ تَسْتَجْلِبُ الضَّرَرَا",23,"ر",2,0],["وَلا تُصغِيَنَّ إِلى مَينِهِم","وَإِن وَفَدوكَ بِرَميِ التُهَم",24,"م",1,0],["ولا تصنع المعروف الا لأهله","لتنجو من ضر ومن قل شكران",25,"ن",1,0],["وَلا تَصِلِ السَفيهَ وَلا تجِبهُ","فَإِنَّ وِصالَ ذي الخَرَباتِ داءُ",26,"ا",2,0],["وَلا تَصحَبنَّ سِوى عالم","وَغَيرَ أَخي الحلم لا تَعشَقِ",27,"ق",1,0],["وَلا تَصحَبن زاداً سِوى البرِّ وَالتُقى","وَإِلّا فشرّ الزادِ ما أَنتَ تَصحبُ",28,"ب",1,0],["ولا تصحب سوى من","يدلك للمبرات",29,"ت",1,0],["ولا تُصِخْ لِلْوشاة وارْفِقْ","بمغرمٍ دَمْعُهُ سِجامُ",30,"م",1,0],["ولا تصِفْهُ أنَّهُ جَوهَرٌ","فإنَّهُ من أنكَرِ المُنكَرِ",31,"ر",1,0],["ولا تصد يوماً بهِ الريح بدا","لأنهُ غير مصادٍ أبداً",32,"د",2,0],["ولا تصدّق عدوا ما يفوه به","عنّي ويشبهُ ما قال من كذب",33,"ب",1,0],["ولا تصحبا إلا عفيفاً مؤبداً","نظيفاً لطيفاً حاذق القلب رائزا",34,"ز",2,0],["ولا تصبَّانِيَ من سَلمِهِ","زخارفٌ للعين غرَّارَهْ",35,"ر",2,0],["ولا تُصبْكم عيونُ الدهر إنّ لها","إلى الكمال لحاظاً سهمُها غَرَبُ",36,"ب",1,0],["وَلا تُصغِ في التَصابي","إِلى زُخرُفِ المَلامَه",37,"ه",1,0],["وَلا تَصحَب أَخا كِبرٍ وَقدِّم","عَلى النَفس الأَعادِيَ وَالصِحابا",38,"ب",2,0],["ولا تصاحب أخا كبرٍ أخا دنسٍ","ملموز دينٍ ومطعون العقيدات",39,"ت",1,0],["ولا تُصَدِّق واشِياً","يَشي بِشاعِرِ الدُّنَا",40,"ن",2,0],["ولا تصدّقْ مائناً دَأْبُهُ","أن يَكذِبَ القولَ وأنْ يَبْطُلا",41,"ل",2,0],["وَلا تُصغِ لِلنّاهِينَ فيما نَوَيتَهُ","وَخَف حَيثُ يُخفي الغِشَّ مَن يُظهِرُ النُّصحا",42,"ح",2,0],["وَلا تَصفَع قَفا أَحد سِواه","إِذا ما رُمت تَحظى بِالسعود",43,"د",1,0],["ولا تصطبر للهضم ما دمت قادراً","على أن ترى بين الورى غير مهضومِ",44,"م",1,0],["ولا تصلح الدنيا بغير مهيمن","على الناس في حر العقائد قيوم",45,"م",1,0],["ولا تصح لإنسان عزائمُهُ","إلا بصحة آراءٍ وأفكار",46,"ر",1,0],["ولا تُصاحب غيرَ شهمٍ يَرى","لكَ مقامَ عِزَّةٍ وافتخار",47,"ر",1,0],["ولا تصحبنْ عبداً يخون أمانة","ولا تُصْلِحنْ بين اللئامِ ولو تُدعى",48,"ع",2,0],["ولا تُصَوِّب في مدحه أحداً","إلا الذي كان عارفا يَقِظا",49,"ظ",2,0],["ولا تصْطنعهمْ بالجهالة إنما","تباع الورى أو تُشترى باختيارها",50,"ر",3,0],["ولا تصادقْ مُبغضاً قالياً","لو كان ذا عقلٍ وذا علمِ",51,"م",1,0],["ولا تصدِّق ذا نفاق ولو","أقسم بالطور وبالنجم",51,"م",1,0],["ولا تصحبْ زنيماً كا","ن نماماً وفتَّانا",52,"ن",2,0],["ولا تصاحب من النا","س عاذلا غير عاذر",53,"ر",1,0],["ولا تُصيخَنَّ للواشين فيه ولو","ضاعتْ حياتُك تمويهاً وإخلافا",54,"ف",2,0],["ولا تصدِّق قول مَنْ قولُه","إن النسا يُوفِين بالعهد",55,"د",1,0],["ولا تصنع المعروف مع غير أهله","فإك بالمعروف أجدر منهم",56,"م",1,0],["ولا تصدع شملي واتسغثت به","إلا تجمع ذاك الشمل والتأما",57,"م",2,0],["ولا تصغوا إلى العذال والهوا","عن الواشي وقولوا روحونا",58,"ن",2,0],["وَلا تَصِفوني بِالَّذي أَنا أَهلُهُ","فَأَشقى وَحَلّوني بِخَيرِ صِفاتِ",59,"ت",1,0],["ولا تصحَبَنَّ سوى ماجدٍ","يزينُكَ في الغَيبِ والحاضِرِ",60,"ر",1,0],["ولا تصد غير ساجي اللحظ ذا حور","فأنت في غير هذا غير مأذون",61,"ن",1,0],["ولا تصبنا بعضال الداء","رب ولا شماتة الاعداء",62,"ا",2,0],["ولا تصحب الحمقى فذو الجهل إن يرم","صلاحا لأمر يا أخا الحزم يفسد",63,"د",1,0],["ولا تصغ في ودّ الصديق لكاذب","نموم وان يعرض لك الشك فاخبُر",64,"ر",1,0],["ولا تُصيحُ لمِثلي","أهكذا الآدابُ",65,"ب",1,0],["ولا تصغيَنّ إلى عاذلٍ","فما آفة الحب إلا العذَل",66,"ل",1,1],["وَلا تُصفَين بِالوُدِّ مَن لَيسَ أَهلَهُ","وَلا تُبعِدَنْ بِالوُدِّ مِمَّن تَوَدَّدا",67,"د",2,1],["وَلا تَصحَبَنَّ الناسَ إِلا بِحالَةٍ","تُصِيبُ حَلالَ الرِّزقِ أَو تَكسِبُ الأَجرا",68,"ر",2,0],["ولا تصر كافراً إن قلت أنك هو","فأنت بالنفس عنه دائم الحجب",69,"ب",1,0],["ولا تصاحب من يرى لنفسه","فضلا بلا فضل وغير المتقي",70,"ق",2,0],["ولا تصحُ من السكر","فإنّ العيشَ في الشكر",71,"ر",1,0],["ولا تصغ إلى زيدَ","لحا فيها ولا عمرو",71,"ر",2,0],["وَلا تصمني بشعر كلُّه حِكم","فَقَد تفاوتَت الألباب والكلمِ",72,"م",1,0],["ولا تصاحب لاهل الشر واجفهم","واصحب لاهل الهدى وانهض لحبهم",73,"م",1,0],["ولا تصحح للسلطان مملكة","أو تدخل البرد عن انفاده السككا",74,"ك",2,0],["وَلا تَصرِميني إِن تَرَيني أُحِبُّكُم","أَبوءٌ بِذَنبٍ إِنَّني أَنا أَظلَمُ",75,"م",1,0],["ولا تَصحَبَن إلَّا كريماً مُهذَّباً","فخَيرُ الأُصيحابِ الكريمُ المهذَّبُ",76,"ب",1,0],["ولا تَصِلَن صِلاً ولا تقرُبِ الصِلى","فيرديكَ ذ لدغاً وهاتيكُمُ لذعا",77,"ع",2,0],["ولا تصغي للتمام سمعك إنما","يجيء به الإفساد والإثم حاصله",78,"ل",2,0],["ولا تصحبِ النمامَ والحاسِدَ الذي","يَضُرُّكَ كالشيطانِ من غَير فارِق",79,"ق",1,0],["وَلا تَصغوا إِلى روح الشَقاقِ","فَغايتهُ وَبالٌ في وبالِ",80,"ل",1,0],["وَلاَ تَصِحُّ نِسبتَةُ التَّأثِيرِ","لِنُطفَةٍ بِالطَّبعِ فِى التَّقدِيرِ",81,"ر",1,0],["وَلاَ تُصِخ لِمَذهَبِ النَّصَارَى","وَمَن إِلَى دَعوَى حُلُولٍ صَارَا",81,"ر",2,0],["وَلاَ تُصِخ لِمَن أبَى الكَرَامَه","لِلأولِيَاءِ وَاجتَنِب مَرَامَه",81,"ه",1,0],["ولا تصحبن من فيه عيب يشينه","فان قرين السوء بعدي كما تدري",82,"ر",2,0],["ولا تصف لا ياس فالذكاء له","ارث اليه من الأسلاف منقول",83,"ل",1,0],["ولا تَصِلهُ تبتَغي بوَصلِه","في البَيت أَن تُؤذِيَه في أَهلِه",84,"ه",1,0],["ولا تصبحوا أحدوثةً مثل قائلٍ","به يضربُ الأمثالَ من يتمثل",85,"ل",1,0],["ولا تصبحي مثل أخرى كنودٍ","بما أنكرتني وفيضَ العطا",86,"ا",1,0],["ولا تصبحي مثل أنثى السعال ِ","تكحُّ علينا كثير الخنا",86,"ا",1,0],["ولا تصحب أوانس من نساء","فيلعب فيك شيطان مريد",87,"د",1,0],["ولا تصرف سرورا أنت فيه","ليوم علمه غيبٌ مصون",88,"ن",1,0],["ولاتصبح شفاتك من الدين يباس","منبوذ ياعايش بدنيا المطافيس",89,"س",1,0],["ولاتصير مثل الحرآميّه","يا مطوّل إيديك لاشعآري",90,"ر",2,0],["ولا تصدَّ للأستكبار عن أحدٍ","ولو حقيراً فقيراً صاغراً وغدا",91,"د",2,0],["ولا تصدَّنَّ عن حقٍّ تعانده","وكالعفا من إذا حقٌّ بدا جحدا",91,"د",2,0],["ؤلاتصارح من يسمون الحريم","حط سرك في وسط بير وغطاهہ",92,"ا",2,0],["ولا تصبحوا فوضى ولا تتفرقوا","وذبوا عن الأرض ذب المصاول",93,"ل",1,0],["ولا تصغوا لمن يحتاجُ نصحاً","ولا تثقوا بمن يُرجي وعودَهْ",94,"د",2,0],["ولا تصغ للنمام سمعك إنما","بزور أتى المأفون والكاشح الوغد",95,"د",1,0],["ولا تصير مثل اللي تتبع للأضرار","حتى عرف به وان رئيته تشائمت",96,"ت",1,0],["ولا تصبَّ علينا الدهر بعدهما","مصائبًا لا ولا شَرًّا ولا خَبَلا",97,"ل",2,0],["ولا تُصْغي إلى أَقْوال وَاشٍ","فَما أَقْواله غَيرُ افتراء",98,"ا",2,0],["ولا تصل من له حق عليك وإن","تلام بالحق لا تهدى وتقتنع",99,"ع",1,0],["ولا تصغيّن َ إلى مقول ٍ","كثير الفخارِ بماض ٍ غَبَرْ",100,"ر",1,0],["وَلاَ تُصَاحِبْ لَئِيماً فِيهِ مَفْرَقَة","ٌ وَلاَ تَزُورَنَّ أصْحَابَ الدَّوَانِيقِ",101,"ق",1,0],["ولا تُصِيبُكِ منْ دهْرٍ نَوائِبُهُ","ولا تَطالكِ شقْواتٌ ولا غُمَمُ",102,"م",1,0],["ولا تصدق أحاديث الوشاة وقل","أحببت في مقلتيها العشق مشتعلا",103,"ل",2,0],["ولا تصيبُ أماسينا رؤىً عبرتْ","منازلَ الحُبِّ واختارتْ لنا بدلا",104,"ل",2,0]]}