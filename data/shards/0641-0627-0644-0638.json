{"poems":[[46,"أكتم حديثك عن أخيك ولا تكن","https://www.aldiwan.net/poem22483.html","الكامل"],[130,"بلغ سلامى إذا جئت البتول لها","https://www.aldiwan.net/poem54771.html","البسيط"],[141,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[164,"يشقى المعيل بقلب ضيق كمدا","https://www.aldiwan.net/poem47092.html","البسيط"],[208,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[235,"أبلغهم مألكا عن قلب من ملكوا","https://www.aldiwan.net/poem18848.html","البسيط"],[268,"أيها النديم إذا","https://www.aldiwan.net/poem35289.html","المقتضب"],[280,"يا نجم كم أدنو إليك وتبعد","https://www.aldiwan.net/poem32806.html","الكامل"],[302,"مرت لنا بالحمى المأنوس أعياد","https://www.aldiwan.net/poem16841.html","البسيط"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[346,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[377,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[388,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[392,"لا تكن واثقاً بمن كظم الغيظ","https://www.aldiwan.net/poem3681.html","الخفيف"],[402,"لا تعظمن عليك مدحة خادم","https://www.aldiwan.net/poem49615.html","الكامل"],[434,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[549,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[549,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[556,"لا شيء غير الله والأشياء","https://www.aldiwan.net/poem33529.html","الرجز"]],"verses":[["فَالظَبيَّةُ الغَيداءُ صَبَّحَها الرَدى","أَدماءَ تَرتَعُ في النَباتِ الأَغيَدِ",0,"د",1,0],["فَالظبي يُذَكِّرني إِن يَرنُ مُقلَتَهَا","والشَّمسُ أشنَبَهَا الألمَى وقَيهَلَها",1,"ل",3,0],["فَالظِلُّ ضافٍ وَالهِباتُ جَزيلَةٌ","وَالوِردُ صافٍ وَالعَطاءُ تَبَرُّعُ",2,"ع",1,0],["فالظهرُ منكَ بحمل مُوقرٌ أبداً","والبطنُ منها بحمل مثقلٌ أبدا",3,"د",2,0],["فالظهر مني عظيم الذنب اثقله","مما جنيت وشرحي فيه تطويل",4,"ل",1,0],["فَالظَّنُّ أَنَّهُ إِنْ يُنْبَأْ وَحُقَّ لَهُ","سَمَا السُّرُورُ بِهِ لِلرَّوْحِ يَبْتَرِكُ",5,"ك",1,0],["فالظَّريفُ من طرَبٍ","ناح والعتلُّ هَذى",6,"ذ",2,0],["فَالظَبيُ وَالغُصنُ المُرَنَّحُ في النَقا","وَالشَمسُ في رَأدِ الضُحى لَكَ حُسَّدُ",7,"د",1,0],["فالظن باللَه مولانا وسيدنا","ظن جميل مع الأنفاس تزداد",8,"د",1,0],["فَالظنّ والحسبان جلّ علومهِ","وَالحقّ ما في الظنِّ منه مقنعُ",9,"ع",1,0],["فَالظَّبيُ والشَّاهِينُ والكلبُ مَعا","والطِّرْفُ قد فاتوا الرِّياحَ الأَرْبَعا",10,"ع",2,0],["فَالظَنُ إِني لا أَكونُ مُضيعاً","مَع ذاكَ بَينَ مكرم وَكَريم",11,"م",1,0],["فالظلم ظلمات في يوم القيامه جزاه","وسوف يندم على ما قدمته يداه",12,"ا",2,0],["فالظبا المرهفات أقتل ما كا","نت إذا غاض ماؤها في الصدور",13,"ر",1,0],["فالظُّفْرُ وهو أخَسُّ أجزاءِ الفتى","يَشفي بِحَكٍّ جِسمَهُ فَيُريحُهُ",14,"ه",1,0],["فالظبا أعداؤُه وردت","والورى أموالهُ وردوا",15,"د",3,0],["فالظّنّ فيهمْ للجميل مكذِّبٌ","والظّنّ فيهمْ للقبيح مصدّقُ",16,"ق",1,0],["فالظّلمُ عَذْلُ خليِّ القلبِ ذا شَجَنٍ","وهُجنَةٌ لومُ موفورٍ لمجهودِ",17,"د",1,0],["فالظاهر الله لهم بفعله","والفعل معدوم له الخفاء",18,"ا",2,0]]}