{"poems":[[48,"أكتم حديثك عن أخيك ولا تكن","https://www.aldiwan.net/poem22483.html","الكامل"],[136,"بلغ سلامى إذا جئت البتول لها","https://www.aldiwan.net/poem54771.html","البسيط"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[170,"يشقى المعيل بقلب ضيق كمدا","https://www.aldiwan.net/poem47092.html","البسيط"],[214,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[242,"أبلغهم مألكا عن قلب من ملكوا","https://www.aldiwan.net/poem18848.html","البسيط"],[275,"أيها النديم إذا","https://www.aldiwan.net/poem35289.html","المقتضب"],[287,"يا نجم كم أدنو إليك وتبعد","https://www.aldiwan.net/poem32806.html","الكامل"],[309,"مرت لنا بالحمى المأنوس أعياد","https://www.aldiwan.net/poem16841.html","البسيط"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[353,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[385,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[400,"لا تكن واثقاً بمن كظم الغيظ","https://www.aldiwan.net/poem3681.html","الخفيف"],[411,"لا تعظمن عليك مدحة خادم","https://www.aldiwan.net/poem49615.html","الكامل"],[443,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[556,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[556,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[563,"لا شيء غير الله والأشياء","https://www.aldiwan.net/poem33529.html","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103078","الكامل"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121531","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109330","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53089","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53088","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93679","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105667","الكامل"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89373","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89218","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44724","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120193","الكامل"],[4927,"غربة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=29605",""],[4929,"جنازة أيلول","https://www.poetsgate.com/ViewPoem.aspx?id=199973",""],[4929,"سوء الظن","https://www.poetsgate.com/ViewPoem.aspx?id=202432",""],[4955,"قالوا إذا وصّفت صف حال الغرور","https://www.poetsgate.com/ViewPoem.aspx?id=188757",""],[4999,"ثورةٌ سُرقت","https://www.poetsgate.com/ViewPoem.aspx?id=184279",""],[585,"حي الشريف وحي البيت والحرما","https://www.poetsgate.com/ViewPoem.aspx?id=161911",""],[5320,"رائد الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=40898",""],[5459,"دنان الغش","https://www.poetsgate.com/ViewPoem.aspx?id=205796",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5943,"إحساسُ الأمة في سقمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=45273",""],[6070,"إعدلْ هداكَ اللهُ للإحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188631",""]],"verses":[["فَالظَبيَّةُ الغَيداءُ صَبَّحَها الرَدى","أَدماءَ تَرتَعُ في النَباتِ الأَغيَدِ",0,"د",1,0],["فَالظبي يُذَكِّرني إِن يَرنُ مُقلَتَهَا","والشَّمسُ أشنَبَهَا الألمَى وقَيهَلَها",1,"ل",3,0],["فَالظِلُّ ضافٍ وَالهِباتُ جَزيلَةٌ","وَالوِردُ صافٍ وَالعَطاءُ تَبَرُّعُ",2,"ع",1,0],["فالظهرُ منكَ بحمل مُوقرٌ أبداً","والبطنُ منها بحمل مثقلٌ أبدا",3,"د",2,0],["فالظهر مني عظيم الذنب اثقله","مما جنيت وشرحي فيه تطويل",4,"ل",1,0],["فَالظَّنُّ أَنَّهُ إِنْ يُنْبَأْ وَحُقَّ لَهُ","سَمَا السُّرُورُ بِهِ لِلرَّوْحِ يَبْتَرِكُ",5,"ك",1,0],["فالظَّريفُ من طرَبٍ","ناح والعتلُّ هَذى",6,"ذ",2,0],["فَالظَبيُ وَالغُصنُ المُرَنَّحُ في النَقا","وَالشَمسُ في رَأدِ الضُحى لَكَ حُسَّدُ",7,"د",1,0],["فالظن باللَه مولانا وسيدنا","ظن جميل مع الأنفاس تزداد",8,"د",1,0],["فَالظنّ والحسبان جلّ علومهِ","وَالحقّ ما في الظنِّ منه مقنعُ",9,"ع",1,0],["فَالظَّبيُ والشَّاهِينُ والكلبُ مَعا","والطِّرْفُ قد فاتوا الرِّياحَ الأَرْبَعا",10,"ع",2,0],["فَالظَنُ إِني لا أَكونُ مُضيعاً","مَع ذاكَ بَينَ مكرم وَكَريم",11,"م",1,0],["فالظلم ظلمات في يوم القيامه جزاه","وسوف يندم على ما قدمته يداه",12,"ا",2,0],["فالظبا المرهفات أقتل ما كا","نت إذا غاض ماؤها في الصدور",13,"ر",1,0],["فالظُّفْرُ وهو أخَسُّ أجزاءِ الفتى","يَشفي بِحَكٍّ جِسمَهُ فَيُريحُهُ",14,"ه",1,0],["فالظبا أعداؤُه وردت","والورى أموالهُ وردوا",15,"د",3,0],["فالظّنّ فيهمْ للجميل مكذِّبٌ","والظّنّ فيهمْ للقبيح مصدّقُ",16,"ق",1,0],["فالظّلمُ عَذْلُ خليِّ القلبِ ذا شَجَنٍ","وهُجنَةٌ لومُ موفورٍ لمجهودِ",17,"د",1,0],["فالظاهر الله لهم بفعله","والفعل معدوم له الخفاء",18,"ا",2,0],["فالظن غيب عنك عينا ظاهراً","والكشف أظهر منه ما لم يفهم",19,"م",1,0],["فالظلم إلا عن جنابك يتقى","والعود إلا عن جنابك أحمد",20,"د",1,0],["فَأَلِظَّ بِالتَقريظِ في الرَّجُلِ الذي","لم يُبدِ لَعمَظَةً ولا هَو يَلؤُمُ",21,"م",1,0],["فالظلم باب الظلمات التي","يقضي على العالم أغلاسها",22,"س",3,0],["فالظاهر الغازي بن يوسف دهره","متقسم بين السطا والجود",23,"د",1,0],["فالظلم والعدل في أيامه سلكا","ما بين مقصور وممدود",24,"د",1,0],["فالظَّاهِرُ المجلوُّ شيءٌ وَاحِدٌ","لَكِن مَظَاهِرُهُ بِلاَ حُسبَانِ",25,"ن",1,0],["فَالظَّاهِرُ اليَومَانِ فِي الوَجهَينِ يَو","مٌ وَاحِدٌ مَا إن هُمَا يَومَانِ",25,"ن",1,0],["فَالظُلم مِنكَ عليّ غَير مذمم","وَالصَبر مني عَنكَ غَير جَميل",26,"ل",1,0],["فالظلم أما صب سوط عذابه","جر البلاد لالفة ووفاق",27,"ق",1,0],["فالظاء لولا الميز بالإطباق جا","ذالاً كمثل الطاء حول التاء",28,"ا",2,0],["فالظفرُ بالتخليف يزري الحورا","والشمع بالتقطيف يبهو نورا",29,"ر",2,0],["فالظبي مرتعه الحشي","ش وذاك مرتعه الحشاشهْ",30,"ه",1,0],["فالظُلمُ من شِيَم النُفوسِ فان تَجِد","ذا عِفَّةٍ فلِعِلَّةٍ لا يَظلِمُ",31,"م",1,0],["فالظلم في كنف الحضارة رائع","والعدل في قفر القفار شريد",32,"د",1,0],["فَالظُلمُ شَيءٌ ما لَهُ دَوامُ","وَمُهمِلُ الأَمر فَقَد يُلامُ",33,"م",1,0],["فالظلم أنكر خطة في سمعه","والعدل أشجى مطرب تنغيما",34,"م",2,0],["فَالظُّلْمُ يُرْعِبُ، وَ الأَحْزَاْبُ مُهْلِكَةٌ","وَفِي الْجَرَاْئِدِ هَذْرٌ يَجْلُبُ الْمَلَلاْ",35,"ل",2,0],["فالظُّلمُ بأبشع صورتِهِ","بخِلالِكَ جاسَ تَنَمْرُدُهُ",36,"د",2,0],["فالظن حكمٍ مسبقٌ مبني على","وهم ولم تملك عليه دليلا",37,"ل",2,0],["فالظلمُ حتماً سوفَ يمحقُ أهلهُ","والجورُ ظلمتهُ تزولُ بعدلِ نورْ",38,"ر",1,0],["فالظلمُ ظل بأرضنا مستوطناً","وتقودهُ مجموعةَ الأوغادِ.",39,"د",1,0],["فالظلم أيقظ منهم كل ذي سنةٍ","ما كان ينهض لولا أنه ظلما",40,"م",2,0],["فالظلم تمحقه السيوف وسيفه","سن اليراع وكان كالصمصام",41,"م",1,0],["فالظلمُ يسحقُ كلّ قلبٍ طيّبٍ","إن كان عاشَرَ في الأنام رَعاعا",42,"ع",2,0],["فَالظَّلامُ الْكَثِيفُ جِنْسٌ وَخَمْرٌ","وَالنَّهَارَاتُ كُلُّهَا غَثَيَانُ",43,"ن",1,0],["فالظالمُ يقصدُ أقصانا","ويحاصرُهُ برضا النخاسْ",44,"س",1,0],["فالظلمُ شؤمٌ والعَدالَةُ ظلها","كالبيرقِ المرفوعِ للبلدانِ",45,"ن",1,0]]}