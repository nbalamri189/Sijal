www.poetsgate.com/ViewPoem.aspx?id=22694",""],[5922,"أفضل امرءة في التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=183795",""],[5943,"بغداد هبيِّ وارجعي المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=61826",""],[5956,"لا يستطيب القلب أن ينساك","https://www.poetsgate.com/ViewPoem.aspx?id=194637",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[5989,"يا نجمةً ومضت","https://www.poetsgate.com/ViewPoem.aspx?id=181494",""],[6090,"يا نجم بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=170919",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[5309,"زار الهوى زهر الربى الأغيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573748",""],[6185,"أنت البلاد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86940&r=&rc=0",""],[6234,"وطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6535&r=&rc=2",""],[6247,"يا ركب أحمد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80283&r=&rc=22",""],[6331,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82025&r=&rc=6",""]],"verses":[["يا نَجوَةَ الخائِفِ مِن دَهرِهِ","وَيا ثِقافَ الخَطَلِ المائِلِ",0,"ل",1,0],["يا نَجدُ لا أَخطأَتْكِ غاديَةٌ","أَغزَرُها لِلحمى وَأَجودُها",1,"د",3,0],["يا نَجدُ ما لِأَحِبَّتي شَطُّوا","لَم يَحْمِ أَرضَكِ مِثلُهُم قَطُّ",2,"ط",1,1],["يَا نُجْعَةَ الْوُزَرَاءِ وَالنُّوَّابِ","وَالْمَلْهَمُ الْمَهِديُّ لِكُلِّ صَوَابِ",3,"ب",1,1],["يا نجل حر صادقٍ لم يزل","أصفى الصفيين وأوفى الصحاب",4,"ب",1,0],["يَا نَجِيَّ الْجَمَالِ فِي مَقْدِسِ الْفَ","نِّ وَمِحْرَابِهِ كَنَجْوَى الْكَلِيمِ",5,"م",1,0],["يا نجل محيي الدين سبحان من","أحيا بنعماك نباتي الهشيم",6,"م",1,0],["يا نجاة الغريق يا فرحة الأوْ","بةِ يا قفْلَةً أَتَتْ بعد كَدِّ",7,"د",1,0],["يا نجدة الروم في بطارقِها","وحكمة الروم في مهارقِها",8,"ق",3,1],["يا نجمة في سماء الرافدين بدت","انا نحييك افواجا فحيينا",9,"ن",2,0],["يا نجمةَ الصبح ما أبهى محياكِ","روحي تُرفرف في جسمي لمرآكِ",10,"ك",1,1],["يا نجمة الصبح ما أزهاك في نظري","يا نجمة الصبح ما أحلى مزاياك",10,"ك",1,0],["يا نجمة الصبح ما إن أنت عالمة","أني على الأرض دون الناس أهواك",10,"ك",1,0],["يا نَجمَ سورِيّا وَلَستَ بِأَوَّلٍ","ماذا نَمَت مِن نَيِّرٍ وَقّادِ",11,"د",1,0],["يا نَجمَ حُسنٍ في جُفوني نَوءُهُ","وَبِأَضلُعي خَفَقانُهُ وَلَهيبُهُ",12,"ب",2,0],["يا نجمة الصبح من حا","لقٍ عَلَينا أطلِّي",13,"ل",2,1],["يَا نَجْلَ يَعْقُوبَ حَقُّ هِمَّتِهِ","عَلَى الْعُلَى أَنْ تُرَى لَهُ نَجْلاَ",14,"ل",2,0],["يَا نَجْمُ قَدْ أَسْهَدْتَ قَوْ","ماً كَانَ أَمْنُهُمُ سُهَادَكْ",15,"ك",1,0],["يا نَجيباً فَقَدتُ مِن","هُ مَهيباً وَمُرتَجى",16,"ج",2,0],["يا نجمُ ويحك لا تغر","يا أرض ويحك لا تميدي",17,"د",2,0],["يا نجوما تمشي على قدميها","كلما أظلم الزمان أضاؤوا",18,"ا",1,0],["يا نجلِ \" سوريا \" وتلك مزية","شهِدت بها بمهارة الأولاد",19,"د",1,0],["يا نجمة تختفي حينا وتشرق لي","حينا أفانين تعريف وتنكير",20,"ر",1,0],["يا نَجل صَديق النَبيّ مُحَمَدٍ","مِن في القِيامة للبرية شافِعُ",21,"ع",1,0],["يا نجم أرضي يا سماء الهوى","تومض فيها أنجم السحر",22,"ر",1,0],["يا نجلَ سلطانِ سيفٍ نجلِ مالكِه","بلعربِ الفضلِ وافِى العَهْدِ والذِّمَمِ",23,"م",1,0],["يَا نَجلَ بي بِمَاذَا كُنتَ مُفتَخِراً","أخِلتني جَاهِلاَ آبَاءَكَ الأُوُلا",24,"ل",2,0],["يا نجلَ أحمد يا خليفةَ أحمدٍ","في دينه في بعض فهمِك ما كفا",25,"ف",2,0],["يا نجلَ أَحمدَ يا منصورُ حيثُ غزاً","نصرت ربَّكَ فالبس نصَره حِقبا",26,"ب",2,0],["يا نجومَ السماءِ ما لكِ تزهي","نَ كلانا قد باتَ يعشقُ بدرا",27,"ر",2,0],["يا نجوم الفنون والدهر ليلٌ","ليس يهدى بغير نور الفنون",28,"ن",1,1],["يا نُجعَةَ العافي وَيا","مَعيشَةَ المُرتَزِقِ",29,"ق",1,0],["يا نجم دين تستضئ به","ذكا والزبرقان",30,"ن",1,0],["يا نَجمُ كَم أَدنو إِلَيكَ وَتُبعِدُ","حَتّى كَأَنَّكَ في السَماءِ الفَرقَدُ",31,"د",1,1],["يا نجمُ هلّا إن شكوت","لك الصبابة والغراما",32,"م",2,1],["يا نجمُ أخشى إن شرحتُ","لك المحبة والهياما",32,"م",2,0],["يا نجوماً في كلِّ بَرّ وبحر","هاديات الأنام في كلّ عَصْرِ",33,"ر",1,0],["يا نجوماً أشرَقَتْ في أفقنا","لا رماكِ الله يوماً بالأفول",34,"ل",1,0],["يا نجمَ دين الله حي","نَ تُمدُّ أسدافُ الضّلالِ",35,"ل",1,1],["يا نجل محمّد المبعو","ث بدينكم ذا اخلق هدي",36,"د",2,0],["يا نجمة في الأفق","بعالم لي جديد",37,"د",1,1],["يا نجومِي لا يَرُعْنِي منكُمُ","غائرٌ باخَ ولا حَيدانُ ندَّا",38,"د",2,0],["يا نجمُ كانت مقلتي تنظرُهُ","حتى أستنار بدرَ تِمٍّ وأستوى",39,"ا",1,0],["يا نَجمُ أَبراجُ الرُبى","مُتَبَرِّجاتُ الأَنجُمِ",40,"م",1,1],["يا نَجمُ قَد لاحَت نُجومُ القَطرِ","مُنتَشِراتٍ في نُفوسِ الزَهرِ",41,"ر",1,1],["يا نُجوماً بالدِّياجي","أَعطَتِ العتمَ نِظَامَا",42,"م",2,0],["يا نَجْلَ أَحْمَدَ حَيَّاكَ الإلَهُ وَلا","بَرِحْتَ مِنْ شامِخِ العَلْياءِ في القُلَلِ",43,"ل",1,1],["يَا نَجْمُ بَلْ يَا بَدْرُ بَل يا شَمْسُ بَلْ","كُلٌّ أَراهُ يَلُوح مِنْ أَزْرارِهِ",44,"ر",2,0],["يا نجلَ شمس الدين كَم لَكَ مِن يَدٍ","هَطَلَت فَأَزرَت بِالحَيا الهَطَالِ",45,"ل",1,1],["يا نجمةً زانت محاسنُها العُلى","إِنَّ العُلى منذ الصبا تهواك",46,"ك",1,0],["يا نجلَ سلطانَ بن سيفٍ فتى","سلطانَ يا نعم الهمامُ الإمام",47,"م",1,0],["يا نجل سيف بن سلطا","ن ذا العطايا العميمه",48,"م",2,0],["يا نجلَ سيفٍ أنت بَحْ","رٌ لن يغيض ولن يغورا",49,"ر",2,0],["يا نجلَ سيفٍ يا وحيدُ لعصرنا","ليثُ الشّرى يا ركْن دينِ محمد",50,"د",1,0],["يا نجلَ حَيْسٍ والفتى حسَّاسِ","إن الحجابَ دلائلُ الإفلاسِ",51,"س",1,1],["يا نجلَ سلطان عشْ ما بين أربعةٍ","عِزٍّ ونْصر وإقبالٍ وتوفيقِ",52,"ق",1,0],["يا نجلَ سلطانَ عشْ بعافيةٍ","والخير ياذا المهذبُ الذَّمِر",53,"ر",1,0],["يا نجلَ سلطانَ عشْ خيراً وعافيةً","ما دامت الناسُ في شوقٍ إلى الناس",54,"س",1,0],["يا نجلَ سيفِ اللَّهِ ياذا الذي","قد فاز بالمجدِ وبالفخْرِ",55,"ر",1,0],["يا نجيَّ القلب عن كثب","ليس بعد البعد مصطبر",56,"ر",1,0],["يا نجوم السماء في الأرض خري","والبسي حلة الأسى يا ذكاء",57,"ا",2,0],["يا نجم لا تعتب لتركِ زيارتي","وارجع إلى ودي فودي مثلما",58,"م",2,1],["يا نجوماً في سما المجد زهت","ويسرُّ المجد قولي يا نجوما",59,"م",2,0],["يا نجل سلطان والدنيا تُشيدُ به","في موقف الحُلم أو في موقف الغضبِ",60,"ب",1,0],["يا نجل يعقوب كل ذي جلد","عليك في مثل حزن يعقوب",61,"ب",1,0],["يا نجوم السماء خرّى على من","خان أوطانه وحاول غدرا",62,"ر",2,0],["يا نجوم السماء لا تشهدي بع","دي بما قد جنت