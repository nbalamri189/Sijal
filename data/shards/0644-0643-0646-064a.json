?id=25793",""],[5320,"بطاقة عضوية","https://www.poetsgate.com/ViewPoem.aspx?id=43258",""],[1021,"لا تعذلن فلست أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=47609",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5401,"خادم الحرمين الشريفين","https://www.poetsgate.com/ViewPoem.aspx?id=183493",""],[5526,"مضرب الأمثال","https://www.poetsgate.com/ViewPoem.aspx?id=192617",""],[5536,"أبناء السبيل!!","https://www.poetsgate.com/ViewPoem.aspx?id=22609",""],[470,"حياتُهُ هكذا","https://www.poetsgate.com/ViewPoem.aspx?id=178032",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5628,"رثاء صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178672",""],[5660,"لَو كانَ يُطَيِّبُ خاطِرَها","https://www.poetsgate.com/ViewPoem.aspx?id=35626",""],[5691,"تحجر العُرْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=206096",""],[5703,"دموع ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=210731",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[402,"يا من يقيمون لاستقلالهم عيدا","https://www.poetsgate.com/ViewPoem.aspx?id=35355",""],[5790,"ومهفهفٍ ماس القضيب وقده","https://www.poetsgate.com/ViewPoem.aspx?id=112146",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[5848,"غير مقصودة","https://www.poetsgate.com/ViewPoem.aspx?id=48839",""],[5848,"لا صار خلك عسل","https://www.poetsgate.com/ViewPoem.aspx?id=53365",""],[5899,"من أجلكِ","https://www.poetsgate.com/ViewPoem.aspx?id=31523",""],[5923,"في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=146240",""],[5939,"بلاغٌ عن حالة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=180016",""],[5939,"قهوة عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=195307",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[5956,"لو","https://www.poetsgate.com/ViewPoem.aspx?id=201561",""],[5956,"ناجيتُ ناجي","https://www.poetsgate.com/ViewPoem.aspx?id=207203",""],[6144,"باريس خلاص","https://www.poetsgate.com/ViewPoem.aspx?id=21847",""],[6180,"الأعداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81071&r=&rc=5",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""]],"verses":[["لكنّ يوم النفر جُدنّ لنا بما","عوَّدْنَنا من جفوة ونِفارِ",0,"ر",1,0],["لكن يؤخرها عنهم إلى أجل","يخزي به كلّ من قد جار واعتسفا",1,"ف",2,0],["لَكِن يَقومُ اللَيلَ مَن يَقتاتُ","فَالبَطنُ لا تَملُؤهُ الصَلاةُ",2,"ه",1,0],["لَكِن يُنَقِّبُ عَن حَقيقَةِ جُرمِهِ","مُتَبَيِّناً فَإِذا تَحَقَّقَهُ عَفا",3,"ف",2,0],["لكنْ يزيدُ ناقصٌ عندي ففي","ظلمِ الحسينِ ألفُ ألفِ فاحشَهْ",4,"ه",1,0],["لَكِن يَمَلُّ ثُمَّ تَدعو بِاِسمِهِ","فَيَقولُ هاهِ وَطالَما لَبّى",5,"ب",2,0],["لكنْ يُقْبّلُ فُوهُ سامعَيْ فَرَسٍ","مقابلَ الخَلْقِ بينَ الشمْسِ والقَمَرِ",6,"ر",1,0],["لكن يحي صبا الليالي","شدواً ويغني الهوى دموعَه",7,"ع",2,0],["لكني احبك ومن كثر ما انساك","اشوفك بصوتك اللي اقبلت واقفيت",8,"ت",1,0],["لَكِن يُؤَسِّسُ ما بَنى عَن هِمَّةٍ","أَبَداً تَعافُ المَنهَلَ المَورودا",9,"د",2,0],["لَكِن يَروعُ العِدا مِنهُ بِذي لَجَبٍ","كَاللَيلِ تَلمَعُ فيهِ البيضُ بِالغَدَرِ",10,"ر",1,0],["لكنْ ينازِعني إلى وطني","شوقٌ إذا استمهَلتُه عَسَفا",11,"ف",2,0],["لكن يطير بها والطير غافلة","فرط الحنين إلى الأوكار والحشدد",12,"د",1,0],["لك نَيلٌ قد أخجل النِّيلَ جوداً","وغدا دونه الفُراتُ ودجلَه",13,"ل",2,0],["لَكِن يَخوضُ لَظاها","غَضَنفَرٌ مِنهُ أَشوَس",14,"س",1,0],["لَكن يقولُ ليستزيدَ مؤرّخٌ","كُن يا كريمُ لِضيفك اِبنِ الخوجه",15,"ج",2,0],["لكنْ يَبيتُ أخا شَجْوٍ إذا انتقَبَتْ","بعارِضٍ مُسبَلٍ للدَّمْع سَفّاك",16,"ك",1,0],["لكنْ يُؤدّي السّيفُ فَرْضَ صَلاتِه","بتَمامِ أَركانٍ له وحُدود",17,"د",1,0],["لكن يسوع بفَصْحِه فتح السما","وبه تخلَّص آدمُ الإنسان",18,"ن",1,0],["لكنْ يُسلِّي النَّفسَ أنْ","نَ لَحاقَنا بهمُ قَريبُ",19,"ب",1,0],["لكن يَهيجُ للحزِين بثُّه","إذا رأى على الحَنين مُسعدَا",20,"د",2,0],["لكن يكون بالسرار حاضر","شاب خفيف بالتلبي ماهر",21,"ر",1,0],["لكن يرى الحانق الأَشياء ظاهرة","بباطن الأَمر فيما كان أَو يكن",22,"ن",1,0],["لكن يُداري حَرجي معشراً","لي في مُداراتهم العُذْرُ",23,"ر",1,0],["لكنْ يَزينُ الكمالَ رونْقُه","تُجْلى المواضي ويُرفَعُ الذَّهبُ",24,"ب",1,0],["لكنْ يَنامُ العاشِقونَ","وشَأنُهُ هَجْر الهُجوعِ",25,"ع",1,0],["لكنْ يطيِّبُ قلبي أنَّهُمْ قَبِلوا","اسمي بديوانِهِمْ في أَهلِ حُبِّهِمِ",26,"م",1,0],["لكن يعد مدحه","للصدق من خير العمل",27,"ل",1,0],["لكنَّ يوسف لاح باهر علمه","للكل لم ينكره غير الأرمد",28,"د",1,0],["لكن يحقّ لنا البكاءُ على الذي","أمسى بلا غسلٍ ولا تكفينِ",29,"ن",1,0],["لكن يقولُ مقدّماً لكَ عذرَهُ","لم يخلقِ الرحمنُ مثلِ محمَّدِ",30,"د",1,0],["لكن يصبرني ويلهمني العزا","ء عليك إن الحي فيها فان",31,"ن",1,0],["لكن يسهله عندي جوارهما لله","والمصطفى المختار في الرسل",32,"ل",1,0],["لكني: باختلافي","يوم أنكر وانتجم",33,"م",1,0],["لكن يُقرِّض شعره في مدح مَنْ","أضحى من الفعلِ القبيح براء",34,"ا",2,0],["لكن يُعزك من يدري بقدرك والْ","جهولُ يتبع لُجَّ الآل في البيد",35,"د",1,0],["لكن يحاول نخلة من طولها","ميلاء ليست في المحل النابتِ",36,"ت",1,0],["لكن يجاور فيض أيمان","واحلاماً ثقالا",37,"ل",2,0],["لكنّ يوم السبت عيدٌ لي لذا","أرجوك تعذرني لأقضي الموسما",38,"م",2,0],["لكن يد المولى كفتني شرهُ","وتلطَّف القدر المعد الجاري",39,"ر",2,0],["لكن يُزادُ فتح رأسٍ فيه","بشعرةٍ خفيفة تلفيه",40,"ه",1,0],["لَكِن يُقِرُّ العَينَ أَنَّ الجَوَى","قَد جَلَّ حَتَّى دَقَّ فِيهِ الأَجَل",41,"ل",1,0],["لكن يزاد إذا تواضع رفعةً","ثم التطاول ماله من حاصل",42,"ل",1,0],["لكن يكون الربّ في الشكلين و","جوداً غذاء مانحا تقديسا",43,"س",2,0],["لكن يومك دونه الأيام كم","فاقت فجائعه على فجعاتها",44,"ت",3,0],["لكن يهون خطبه","كم فلذةٍ لحشاي أولى",45,"ل",2,0],["لكِن يَخُصَّكَ أَن تَرعى لِخِدمَتِهِ","وَقَد عَرَفتَ لَهُ المِقدَارَ فالتَزِمِ",46,"م",1,0],["لكن يُهَوِّنُ بَعْضَهُ","رضوانُ أنت إليه صائر",47,"ر",1,0],["لَكِن يُعاقِبُهُ على أفعَالِهِ","فيهِ تعالَى اللهُ ذُو الإِحسَانِ",48,"ن",1,0],["لَكِن يُعَافِيهِم وَيَرزُقُهُم وَهُم","يُؤذُونَهُ بالشِّركِ وَالكُفرَانِ",48,"ن",1,0],["لَكِن يُحبُّ شُكُورَهم وَشَكُورَهُم","لاَ لاحتِياجٍ مِنهُ للشُّكرَانِ",48,"ن",1,0],["لكن يراه من ورا ذا كله","مثل الشراب لذي زجاج أوان",48,"ن",1,0],["لكن يعرّفه الذي قد ناله","من فضله والعفو والاحسان",48,"ن",1,0],["لكن يحق لنا وقد كنا اذا","جلساء رب العرش ذي الرضوان",48,"ن",1,0],["لكني أوجزت فيك مطولا","وطويت عنك مسالكاً وفصولا",49,"ل",2,0],["لكن يداه شحبٌ كلما","حلّت بأرض حل فيها النجاح",50,"ح",1,0],["لكنَّ يا رُبَّانُ في المطالعِ","يَظهَر لَكَ شِعبٌ فَجُز وطَالِعِ",51,"ع",1,0],["لَكِن يَطُولُ الحُوتُ في الغُرُوبِ","في ذَلِكَ المَوسِمِ يَا حَبيبي",52,"ي",1,0],["لكن يرجى جحفلاً يحيي به","ما سنه البر النبيء الأفضل",53,"ل",1,0],["لكن يداوي حرها بالبرد","معالجا مقابلا بالضد",54,"د",1,0],["لكن يدا الفضل والاحسان قد وهبت","هذا لصب الهوى من قبل صبوته",55,"ت",2,0],["لكن يهون عندي الخطب اني قد","رأيت في عالم التمثيل مرآكا",56,"ك",2,0],["لكن يعز عليّ إتعابي لها","ويعز منها أن أرد تكرما",57,"م",2,0],["لكن يحدق في الزبائن خلسة","يرجو الندى ويخاف من أن يزجرا",58,"ر",2,0],["لكن يعود اليها مكرها جزعا","كساكن قفصا أو موثق أسرا",59,"ر",2,0],["لكن يُقادُ غريبُ الإمتداح لنا","فيكم ويأنس بالأفكار عن عجل",60,"ل",1,0],["لكن يهود ليوم السبت قد لزموا","حكام ما قد مضى مع بطل دينهم",61,"م",1,0],["لكن يَهون بها علينا","ما نَراهُ من العظائم",62,"م",1,0],["لكن يجوز له إن تاب دفعهم","عن نفسه وعن الأموال فاحتفلا",63,"ل",2,0],["لكن يقل لما آثرنه عرضٌ","بعض البعوضة عند اللذه لم يزن",64,"ن",1,0],["لكنّ يأتي بما تُبديهِ فكْرتُهُ","وفضْلُ مَولايَ في الإغْضاءِ يُطْمِعُهُ",65,"ع",2,0],["لكن ىثار النجابة منه قد","لاحت عليه بعفةٍ ومكارم",66,"م",1,0],["لكن يهونها وكل رزيةٍ","رزؤ الحسين وإن يكن عظاما",67,"م",2,0],["لَكن يؤمّن خَوفي أَنني بحمى","خَيرِ البَرية قَد أَصبَحتُ ملتجئا",68,"ا",1,0],["لكن يهون خطب ذلك موعد","حق ودين ثابتٌ في الكلكل",69,"ل",1,0],["لَكِنَّ يوسُفَ هَذا جاءَ إِخوَتُهُ","وَلَم يَكُن بَينَهُم نَزعُ وَلا زَلَلُ",70,"ل",1,0],["لكن يقيني يقيني كل ضائقة","بالنصر والفوز إن شن العدا غاره",71,"ر",2,0],["لَكنَّ يوسف عصرنا نالَ العُلا","مِن غَيرِ ما كدر وَفاقَ صُعودُهُ",72,"د",2,0],["لَكنَّ يوسفنا قَد قامَ مُرتقباً","أَسمى المَراقي وَحازَ الفَخرَ بِالفطنِ",73,"ن",1,0],["لَكن يَحوز الامن في تَشريفِهِ","مِن حادِثاتِ الدَهر في دَوراتِهِ",74,"ه",1,0],["لكن يكون بالهوى خبيرا","مستيقظا في حكمه بصيرا",75,"ر",2,0],["لكن يقولُ الحاسدونَ لمَ انثنى","غِرِّيدُ مدحِهمُ بجيدٍ عاطل",76,"ل",1,0],["لكن يولي من يقوم بفعله","أحسن بمؤتم على هذا نسج",77,"ج",1,0],["لكن يعزُّ خلاصُ قلبِ مُتيَّمٍ","تركتهُ أيدي الهجرِ وهوَ مبُلبَلُ",78,"ل",1,0],["لكن يقل من أهل العصر واحده","على الخبير سقطت فاسمع أنفاس",79,"س",1,0],["لكنَّ يبقَى أثراً أسوداً","بعد جراحِ السيفِ والخنجرِ",80,"ر",1,0],["لكن يهون عندي الخطب أني قد","شاهدت مذ فاتني معناك مغناك",81,"ك",1,0],["لكن يوم الطفل أفجع حيث لم","يعرف له مضمار سعي دار",82,"ر",1,0],["لكنِّي لم أعشق أبداً","في عمري أنثى إلاكِ",83,"ك",1,0],["لكن ياقلبي ترى الصبر محمود","بالصبر تكسب لك جزيل العطايا",84,"ا",3,0],["لكن يكدر صفوة الجو دقات","دقات منفصله وهي ما لها ذيل",85,"ل",1,0],["لكنٌ يا دكتور جعلك ما تهون","ابغيك كلمت راس دامك ما بديت",86,"ت",1,0],["لكن يظلّ الهمّ يغشى قلبنا","حتّى يحِلَّ الطّيرُ في بستانه",87,"ن",2,0],["لكني ادركت بالمعلوم","إني بدونك بلا حيلة",88,"ل",2,0],["لكني بالنسيان شفني تحليت","وغردلي العصفور وتنبحلك كلاب",89,"ب",1,0],["لكني اكره من سقى فكرته شين","وش كان يخسر لو فزع في ظمانه",90,"ن",2,0],["لكن يموت ولا يمثّل ولا دور","ولاَ يمشي بخلسه ويقطع طريقك",91,"ك",1,0],["لكني آشوف الدما مثل الانهار","واشوف شجعانك موارد مصادير",92,"ر",1,0],["لكن يابو رهف صونه","احفظ شقى اليوم ورياله",93,"ل",2,0],["لكنَّ يقظتَه به عادتْ إلى","الأَيقاظِ جسمًا دونَما أن يَشعُرَا",94,"ر",2,0],["لكن يُشاد بفعل الصحب إذ نشطوا","واستدركوا ما رأوا في النار من شرر",95,"ر",1,0],["لكن يجيب بلا والله لو جُمِعت","بهِ الجراح وعانى الضُر مافعلا.",96,"ل",2,0],["لكنَّ يَحْيى لن يَغِيْبَ غَداً","مادام لا يَسْتَرْزِقُ الْكَلِما",97,"م",2,0],["لكن يطيرون أشتات إذا فزعوا","وينفرون إلى الغارات وحدانا",98,"ن",2,0],["لكن يامرحبا لو عذبتني","علي تعذيبها لو مر،،حالي",99,"ل",2,0],["لكن ياحسافه مابقى للحقيقة طيف","سوى،،فكرة في دفتر الوقت طابعها",100,"ع",3,0],["لكني بفك الباب وأطلق محابيسه","شوارد خيال شيبت عين حابسها",101,"س",3,0],["لكني بفك الباب وأطلق محابيسه","شوارد خيال شيبت رأس حابسها",102,"س",