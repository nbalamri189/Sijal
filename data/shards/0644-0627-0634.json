ِ يَشفي جُرحَ صاحِبهِ","ولا حَوَى مثلَهُ حانوتُ عَطَّارِ",254,"ر",1,0],["لا شك سيدا كهول الجنة","وذاك غير ثابت لأنه",255,"ه",1,0],["لا شيءَ أَعجبُ عند الخلقِ قاطبةً","مِنْ عِشْقيَ السرِّ أَو من حُسْنِك العَلَنِ",256,"ن",1,0],["لا شيءَ أَعجبُ من تلَهُّبِ خدِّها","بالماءِ إِلاَّ حسْنُها وتَعَفُّفي",257,"ف",2,0],["لا شيء مما ترى إلا بشاشتهُ","يَبقى الالهُ ويفنى المالُ والولدُ",258,"د",1,0],["لا شيء مما ترى تبقى بشاشته","يبقى الإله ويودي المال والولد",259,"د",1,0],["لا شيء يأتُو أتوَه لمّا علا","فوقَ القطاةِ ورأسُهُ مستتلعِ",260,"ع",1,0]]}