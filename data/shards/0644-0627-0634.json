غدا هل تدري ما يلد الغد","https://www.aldiwan.net/poem55970.html","عموديه"],[452,"إلى هيئة الأمم المتحدة","https://www.aldiwan.net/poem989.html",""],[456,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[456,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[456,"أبا جرير برغمي أن تخط يدي","https://www.aldiwan.net/poem61678.html","البسيط"],[456,"طرفت فلما أغرورقت عيني","https://www.aldiwan.net/poem61681.html","أحذ الكامل"],[461,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[461,"ما أنتِ بعد البين من أوطاني","https://www.aldiwan.net/poem55853.html","الكامل"],[461,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[461,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[461,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[464,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[467,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[467,"شم لأثيلات الحمى وضاله","https://www.aldiwan.net/poem3426.html","عموديه"],[467,"ومشمر للحرب عن أذياله","https://www.aldiwan.net/poem3448.html","عموديه"],[473,"لا شك أن الذي بي سوف يقتلني","https://www.aldiwan.net/poem4662.html","البسيط"],[480,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[480,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[509,"لأشياع الفلاسفة اعتقاد","https://www.aldiwan.net/poem2407.html","الوافر"],[516,"بحرمة هذا الشهر لما نعشتني","https://www.aldiwan.net/poem67745.html","الطويل"],[517,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[518,"اليوم عاد إلى المحلة روحها","https://www.aldiwan.net/poem12051.html","الكامل"],[518,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[518,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[541,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[547,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[547,"حديقة بلا غناء","https://www.aldiwan.net/poem67250.html","عموديه"],[556,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[561,"لا شيء غير الله والأشياء","https://www.aldiwan.net/poem33529.html","الرجز"],[561,"يا خبرا عني إذا","https://www.aldiwan.net/poem34498.html","مجزوء الرجز"],[561,"هو كل شيء في الوجود الواحد","https://www.aldiwan.net/poem34584.html","الكامل"],[561,"قلب المحقق واجد بل فاقد","https://www.aldiwan.net/poem34597.html","الكامل"],[565,"يا بائع الصبر لا تشفق على الشاري","https://www.aldiwan.net/poem52764.html","البسيط"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[578,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"],[862,"","https://poetry.dctabudhabi.ae/diwan/poem/21209","البسيط"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/20924",""],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"]],"verses":[["لا شُبوبٌ مِنَ الصُوارِ وَلا أَع","نَقُ يَرعى مَنابِتَ العُلجانِ",0,"ن",1,0],["لِأَشفي مَريضَ الوُدِّ بَيني وَبَينَكُم","وَعاوَدَ نُكساً بَعدَ بُرءٍ مُبِلُّهُ",1,"ل",2,0],["لا شُجاعٌ يَبقى فَيَعتَنِقَ البي","ضَ وَلا آمِلٌ وَلا مَأمولُ",2,"ل",1,0],["لَأَشكُرَنَّكَ ما ناحَت مُطَوَّقَةٌ","وَإِن عَجَزتُ عَنِ الحَقِّ الَّذي وَجَبا",3,"ب",2,1],["لا شِمْتُ بارِقَةَ اللّئيمِ وإنْ غَدَتْ","إبِلي تَلوبُ على صَرًى نَشّاشِ",4,"ش",1,0],["لأُشارِفَنّ إلَيكِ كلَّ تَنوفَةٍ","زَوراءَ تُعْقَرُ بالمُشيحِ الأزْوَرِ",5,"ر",1,0],["لا شارِخٌ يَبْقى ولا ذو لِمَّةٍ","ألْوَتْ بعَصْرِ شَبابِها العنْقاءُ",6,"ا",2,0],["لا شَيءَ فيها غَيرُ أَصوِرَةٍ","سُفعِ الخُدودِ يَلُحنَ في الشَمسِ",7,"س",1,0],["لا شَكَّ لِلمَرءِ أَنَّ الدَهرَ ذو خُلُفٍ","فيهِ تَفَرَّقَ ذو إِلفٍ وَمَألوفُ",8,"ف",1,0],["لا شَيءَ أَشفى فيما سَمِعتُ بِهِ","مِن سَكَنٍ يَشتَكي إِلى سَكَنِ",9,"ن",1,0],["لا شافِعٌ يَحضُرُكُم","إِذا قَرَأتُم كُتُبي",10,"ب",2,0],["لا شَيءَ إِلا صَبرُهُ","حَتّى يَموتَ بِدائِهِ",11,"ا",3,0],["لاَشُكْرَ لِي إِنْ كُنْتُ قَدْ أَحْبَبَتُكُمْ","أَوْ أَنَّنِي اسْتَوْلَى عَلَيَّ هَوَاكُمُ",12,"م",1,1],["لا شَيءَ يَنفَعُني مِن دونِ رُؤيَتَها","هَل يَشتَفي وامِقٌ ما لَم يُصِب رَهَقا",13,"ق",2,0],["لا شَيءَ أَجوَدُ مِنها وَهِيَ طَيِّبَةٌ","نَفساً بِما سَوفَ يُنجيها وَإِن لَحِقا",14,"ق",2,0],["لا شَيءَ يَلوي مِن هَواهُ فَحَدُّهُ","في السَلبِ حَدُّ الخائِنِ السَرّاقِ",15,"ق",1,0],["لا شَيءَ أَفعَلُ في النُفوسِ كَقامَةٍ","هَيفاءَ رَوَّعَها الأَسى بِهُزالِ",16,"ل",1,0],["لا شَيءَ يَبقى غَيرُ وَجهِ مَليكِنا","وَلَستُ أَرى شَيئاً عَلى الدَهرِ خالِدا",17,"د",2,1],["لا شيء في تعليم قومٍ وفي","تقويمهم أبلغ مما ترى",18,"ا",1,0],["لا شيء أبلغ مدحة من موقفي","بين اليتيم وبين شبه يتيم",19,"م",1,0],["لا شَيْءَ بَاقٍ مِنْكَ إِلاَّ أَسْطُراً","خَلَدَتْ بِحُسْنِ الصَّوْغِ وَالتَّبْيَانِ",20,"ن",1,0],["لا شَأْنَ عَنْ خِدْمَةِ الأَوْطَانِ يَصْدِفُهُ","فَمَا تُعَدُّ مَسَاعِيهِ وَلا الْخِدَمُ",21,"م",1,0],["لا شَعْبَ يَقْوَى عَلَى شَعْبٍ فَيُهْلِكُهُ","فَإِنْ تَرَ الْقَوْمَ صَرْعَى فَالْجُنَاةُ هُمُ",22,"م",1,0],["لا شَيءَ أَحسَنُ مِن مَشيبٍ وافِدٍ","بِالحِلمِ مُختَرِمِ الشَبابِ الأَهوَجِ",23,"ج",1,0],["لَأَشكُرَنَّ لِنوحٍ فَضلَ نِعمَتِهِ","شُكراً تَصادَرُ عَنهُ أَلسُنُ العَرَبِ",24,"ب",1,1],["لأشكرتك يا شكري مدى عمري","وأبكينّك أبكاراً وآصالا",25,"ل",2,0],["لا شُهَدٌ للخَنَا وَمَنطِقِه","ولا عنِ الحِلمِ والنُّهَى غَيَبُ",26,"ب",1,0],["لا شَاكِرَاتٍ اذا غَنِينَ ولا","في فَقرِهِنَّ الجَفَاءُ مُرتأَبُ",26,"ب",1,0],["لا شاكرات اذا عنين ولا في","فقرهن الحفاء مرتاب",27,"ب",1,0],["لَأَشرِكَنَّكَ في اللَأواءِ إِن طَرَقَت","كَما شَرِكتُكَ في النَعماءِ وَالرَغَدِ",28,"د",1,0],["لأشكرنّ أياديه بذاك وذا","إن أحي في هذه الدنيا وإن أمت",29,"ت",1,0],["لا شيء أحسن من مرآه مقتبلاً","إلاَّ محاسن ما ضمَّت سرائره",30,"ر",2,0],["لا شيء أليق من مرأى أنامله","إذا تأمَّلت أمرّيها وما كفلت",31,"ت",1,0],["لا شيء أهْيَبُ من زُرقٍ مُؤَلّلةٍ","وهُنَّ يُنكَحنَ بالأرماح في الجُنُبِ",32,"ب",1,0],["لا شَراباً ولا سَماعاً وأمَّا","زادُهُ إن جفا فأهْوِنْ بزادِهْ",33,"د",2,0],["لا شيء أحسن منها حين تأخذها","من الأكفِّ سماءٌ ذات إرذاذِ",34,"ذ",1,0],["لا شيءَ إلا وفيها منه أحسنُهُ","فأين يُصرَف عنها القلب والنظر",35,"ر",1,0],["لا شيء إلا ذَمّكم وحدهُ","أصبح معموراً به مجلسي",36,"س",2,0],["لا شأنَ يُلهيك عن شأنِ النَّدَى أبداً","إلا نظيرٌ له من شأنِ تقواكا",37,"ك",2,0],["لا شيءَ إلّا وفيه أحسنُهُ","فالعينُ منه إليه تنتقلُ",38,"ل",1,1],["لا شيءَ أقربُ حَيناً من مُناضِلِه","أو من مُطاعنه أو من منازلِهِ",39,"ل",2,0],["لا شَرعَ في الغاباتِ إِلّا شَرعَها","فَدَعِ الكَلامَ شِكايَة وَعِتابا",40,"ب",2,0],["لا شَيءَ مِمّا حَولَنا وَأَمامَنا","حَسَنٌ لَدَيها وَالجَمالُ كَثيرُ",41,"ر",1,0],["لا شَيءٌ في الأُفُقِ الرَحبِ","وَكَأَنَّ هُنالِكَ أَشياءَ",42,"ا",2,0],["لا شَيءَ يُزعِجُ في الحَياةِ نُفوسَنا","لا طارِئٌ لا عارِضٌ لا مُشكِلُ",43,"ل",1,0],["لا شَيءَ في قَبضَتِهِ الشِمالِ","وَلَيسَ في اليُمنى سِوى صَلصالِ",44,"ل",1,0],["لا شَيءَ صَعبٌ عِندَكُم حَتّى الرَدى","الصَعبُ عِندَ نُفوسِكُم أَن تَحجِموا",45,"م",3,0],["لا شَيءَ يَومَ الرَوعِ أَجمَلُ عِندَهُ","مِن أَن يُرى وَالقِرنَ يَصطَرِعانِ",46,"ن",1,0],["لا شَيءَ يُدرَكُ في الدُنيا بِلا تَعَبٍ","مَنِ اِشتَهى الخَمرَ فَليَزرَع دَواليها",47,"ي",3,0],["لا شيءَ إلاَّ أنَّني متغزّلٌ","بالكائناتِ مغرِّدٌ في غابي",48,"ب",2,0],["لا شيء إلا والطبيعة أمه","لكنما كنه الطبيعة خافي",49,"ف",2,0],["لا شيء عن حضن الطبيعة فاصلى","هي مبدئي وقرارتي والمرجع",50,"ع",1,0],["لا شيء يحظى من قلوب سراتهم","بالحب إلا الأصفر الرنان",51,"ن",1,0],["لا شيء في الدنيا على ما بان لي","كالدين محبوب إلى الإنسان",52,"ن",1,1],["لا شكوى نفعت ولا يا قل","ب الحبيب رقيت",53,"ت",1,0],["لا شيكَ يَظهَرُ في البُنو","كِ وَلا حِوالَةَ تُخصَمُ",54,"م",1,0],["لأُشَافِهَنَّ مِنَ الذُّنُوبِ عَظَائماً","يَنْقَدُّ عنها جِلْدُ كُلِّ صِيامِ",55,"م",1,0],["لا شَيْءَ أَحْسَنُ مِنْ راحٍ مُشَعْشَعَةٍ","حِمْصِيّةٍ سِيَمَا مِنْ كَفِّ شَمّاسِ",56,"س",1,0],["لا شَيءَ أَقبَحُ مِن فَحلٍ لَهُ ذَكَرٌ","تَقودُهُ أَمَةٌ لَيسَت لَها رَحِمُ",57,"م",1,0],["لا شعرة نعني ولا بيضة","فعدّ عن تدبيرهم في الشعور",58,"ر",1,0],["لا شرْكةٌ فيما اصطنعتَ ولا يَدٌ","لِسواك فيها ذلَّةٌ وصَغَارُ",59,"ر",1,0],["لَأَشكُرَنَّكَ إِنَّ الشُكرَ نائِلُهُ","أَبقى عَلى حالَةٍ مِن نائِلِ النَشَبِ",60,"ب",1,0],["لَأَشكَلَ القَمَرُ الساري عَلَيَّ فَما","بَيَّنتُ طَلعَتَهُ مِن طَيفِكِ الساري",61,"ر",2,0],["لا شَكَّ أَنّي ثاكِلٌ عُمري","وَمُبَوَّأٌ عَن عاجِلٍ قَبري",62,"ر",2,1],["لَأَشكُرَنَّكَ إِنَّ الشُكرَ مِن أَمَمٍ","حَقٌّ عَلى حامِلِ المَعروفِ مَفروضُ",63,"ض",1,0],["لا شَيءَ أَجوَدُ مِنهُ غَيرُ فَتىً غَدا","مِن جودِهِ الأَوفى وَمِن إِنعامِهِ",64,"م",2,0],["لا شَهرَ أَعدى مِن رَبيعٍ إِنَّهُ","سَيَبينُ عَنّا بِالرَبيعِ رَبيعُ",65,"ع",1,0],["لَأَشتَكِيَن شَكوى يَكونُ اِشتِكاؤُها","لَها نُجُحاً أَو عِذرَةً لِلمُخاطِبِ",66,"ب",1,0],["لا شَيءَ مِثلُ يَدَيكَ خَيرٌ مِنهُما","حَيثُ اِلتَقَت بِيَدَيكَ فَيضُ الأَبحُرِ",67,"ر",1,0],["لا شَيءَ أَسرَعُ مِنها وَهيَ طَيِّبَةٌ","نَفساً بِما سَوفَ يُنجيها وَتَتَّرِكُ",68,"ك",1,0],["لا شَيءَ إِلّا اللَهَ فَاِرفَع ظَنَّكا","يَكفيكَ رَبُّ الناسِ ما أَهَمَّكا",69,"ك",2,1],["لَأَشرَبَنَّ بِكَأسِ المَوتِ مُنجَدِلاً","يَوماً كَما شَرِبَ الماضونَ بِالكاسِ",70,"س",1,0],["لا شَيءَ أَسرَعُ مِن تَقَلُّبِ مَن لَهُ","أُذُنٌ تَسَمَّعُهُ الَّذي لا يَسمَعُ",71,"ع",1,0],["لا شَيءَ لِلمَرءِ أَغنى مِن قَناعَتِهِ","وَلا اِمتِلاءَ لِعَينِ المُلتَهي الطَرِفِ",72,"ف",1,0],["لا شَيءَ مِنهُ أَدَقُّ لُطفَ إِحاطَةٍ","بِالعالَمينَ وَلا أَجَلُّ جَلالا",73,"ل",2,0],["لا شَغَلَ اللَهُ لَكُم خاطِراً","وَلا عَرَتكُم بَعدَها شائِبَه",74,"ه",1,1],["لا شاعَ ذِكري بِنَظمِ قافِيَةٍ","تَلوحُ حُسناً كَأَنَّها عَلَمُ",75,"م",1,0],["لا شيء ملتفا يعانقه","غير السنا في ضوئه البراق",76,"ق",1,0],["لا شيءَ إلا أن ذُكرتِ فهزّني","طربٌ وبات على الحنين فؤادي",77,"د",2,0],["لا شيءَ قد سارت برف","قته وترجعُ وحدها",78,"ه",2,0],["لا شاهِداً أَخزى لِجاحِدِ لُؤمِهِ","مِن أَن تَراهُ زاهِداً في راغِبِ",79,"ب",1,0],["لا شَيءَ أَحسَنُ مِنهُ لَيلَةَ وَصِلنا","وَقَد اِتَخَذتُ مَخَدَّةً مِن خَدِّهِ",80,"د",2,0],["لا شَيءَ إِلّا أَباتَتهُ عَلى وَجَلٍ","وَلَم تَبِت قَطُّ مِن شَيءٍ عَلى و