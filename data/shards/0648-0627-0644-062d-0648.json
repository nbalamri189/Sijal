{"poems":[[73,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[39,"نطعم الجيأل اللهيد من اللحم","https://www.aldiwan.net/poem7058.html","الخفيف"],[87,"قم ناج جلق وانشد رسم من بانوا","https://www.aldiwan.net/poem63693.html","البسيط"],[30,"يا ابن المراغة إنما جاريتني","https://www.aldiwan.net/poem5241.html","الكامل"],[30,"وإذا عددت بني كليب لم تجد","https://www.aldiwan.net/poem5482.html","الكامل"],[30,"عفى المنازل آخر الأيام","https://www.aldiwan.net/poem5617.html","الكامل"],[30,"يا ابن المراغة والهجاء إذا التقت","https://www.aldiwan.net/poem5645.html","الكامل"],[22,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem21640.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[125,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[173,"أيدي الحوادث في الأيام والأمم","https://www.aldiwan.net/poem1667.html",""],[189,"أف لها دنيا فلا تستقر","https://www.aldiwan.net/poem14531.html","السريع"],[190,"إني موصيك فاحفظ عن أخي ثقة","https://www.aldiwan.net/poem44158.html","البسيط"],[242,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[242,"غازي غزاني ابن حيون من الحرس","https://www.aldiwan.net/poem19718.html","البسيط"],[276,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[325,"هذا ضريح أخي علا","https://www.aldiwan.net/poem61610.html","مجزوء الكامل"],[463,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[484,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[505,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[543,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[545,"وبنات نعش يستدرن كأنها","https://www.aldiwan.net/poem56829.html","الكامل"],[563,"فيه أنا ميت ومقبور","https://www.aldiwan.net/poem34481.html","السريع"],[566,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122728","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87205","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86769","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86709","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87071","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87015","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86927","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59049","المواليا"],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124301","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95556","الكامل"],[1507,"","https://poetry.dctabudhabi.ae/diwan/poem/144788","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77960","المنسرح"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49564","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123304","الرمل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124055","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102662","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137452",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137448",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94306","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94254","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94190","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94174","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94182","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94106","المتدارك"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94107","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140093",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140090",""],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121328","الرجز"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82845","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45866","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133308","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133221","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103039","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94547","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83369","الكامل"],[4726,"مآل كل امرءٍ للموت والعطب","https://www.poetsgate.com/ViewPoem.aspx?id=146654",""],[4829,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=36754",""],[4862,"قالت والقول لفيروزٍ","https://www.poetsgate.com/ViewPoem.aspx?id=175394",""],[4927,"داء الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29832",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[5121,"مَسَاءُ الشُّعُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=56463",""],[5183,"مصيبة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180257",""],[5330,"أحببتك أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=15589",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5480,"خزني بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=1587",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5829,"هذي الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=175426",""],[5843,"مكاسر عود جاوي!","https://www.poetsgate.com/ViewPoem.aspx?id=51287",""],[5906,"في الحكمة / الصبر ... صبرا","https://www.poetsgate.com/ViewPoem.aspx?id=193744",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[5997,"ثَغْرُ الحَنَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=214535",""],[5126,"زفرةُ أسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87804&r=&rc=19",""]],"verses":[["وَالحوبُ أَن يَسبِقَ السُؤّالُ نائِلَهُ","وَأَعظَمُ الذَنبِ أَن يَبقى لَهُ نَشَبُ",0,"ب",1,0],["والحوار التمام ذا السر","منهن صحاح العيون يدعين عورا",1,"ر",2,0],["وَالحورُ في دُمَّرَ أَو حَولَ هامَتِها","حورٌ كَواشِفُ عَن ساقٍ وَوِلدانُ",2,"ن",1,0],["وَالحَوفَزانُ مُسَوِّمٌ أَفراسَهُ","وَالمُحصَناتُ حَواسِرُ الأَبكارِ",3,"ر",1,0],["وَالحَوفَزانُ مُسَوِّمٌ أَفراسَهُ","وَالمُحصَناتُ يَجُلنَ كُلَّ مَجالِ",4,"ل",1,0],["وَالحَوفَزانِ تَدارَكَتهُ غارَةٌ","مِنّا بِأَسفَلِ أودَ ذي الآرامِ",5,"م",1,0],["وَالحَوفَزانِ أَميرُهُم مُتَضائِلٌ","في جَمعِ تَغلِبَ ضارِبٌ بِجِرانِ",6,"ن",1,0],["وَالحَوضُ أَلحَقَ بِالخَوالِفِ نَبتُهُ","سَبِطٌ عَلاهُ مِنَ السِماكِ مَطيرُ",7,"ر",1,0],["والحور قصت شذوذاً من غدائرها","وأرسلتها بديلاً من ستائره",8,"ر",2,0],["والحوز ثم أصويرةٌ أو سوسه","أو وادِ نُونَ وأرْضه متضرما",9,"م",2,0],["وَالحَوفَزانَ الَّذي كانَت تَنُوءُ بِهِ","بَكرٌ سَقاهُ بِكاساتٍ مِنَ النِقَمِ",10,"م",1,0],["والحوتُ والطير ووَحْش الفَلا","في كُلَفٍ من وِرْدها والصَّدَر",11,"ر",1,0],["والحوتُ في اللُّجِّ على بُعْدِه","من مَلْمسِ الكفِّ ولَمْحِ البصر",11,"ر",1,0],["والحوت يخرجها الصياد عن شره","فيها عن البحر في شص يحاذبه",12,"ب",2,0],["وَالْحَوْضُ قَدْ رَقَّتْ سَجَايَا مَائِهِ","بِهِ فَانْتَشَى مِنْ عَذْبِهِ دُعْمُوصُهُ",13,"ص",2,0],["وَالْحَوْزُ فِي يَدِنَا فَلاَ يُنَازِعُنَا","فِيهِ سِوَى مَنْ بَغَى عَلَى الْهُدَى فَنَسِي",14,"س",2,0],["وَالحَوض وَهُوَ الكوثر المتلطم","فَبحقه صَلوا عليه وَسلموا",15,"م",3,0],["وَالحورُ إيناساً بِهِ","قالَت وَأَظهَرَتِ المَسارِ",16,"ر",1,0],["والحوضُ يُفنيه اعتوارُ شَفَةٍ","فشفةٍ وإن علا وإن عمُقْ",17,"ق",1,0],["والحور حافلة به","بين المباخر والشموع",18,"ع",1,0],["والحَواميمُ وهي أَقسامُ مِثلي","إِنَّ قلبي لفي حُضورٍ وفقْدِ",19,"د",1,1],["والحَواشي شَدُّوا مَناطقَ حَزمٍ","فَتَخالُ الرِّجالَ صارت صُقورا",20,"ر",2,0],["وَالحوتُ يَسبَحُ في السَماءِ كسِبحِهِ","في الماءِ وَهوَ بِكُلِّ سبحٍ ماهِرُ",21,"ر",1,0],["والحور والولدان تبقى ولا","ولدان إلا هوْ ولا حور",22,"ر",1,0],["والحُوتُ في هِيتِ الرَدى ما هِيتُ","لِلحوتِ في أَثنائِهِ بُيوتُ",23,"ت",1,0],["والحَواجيبَ وأَلحاظَ المَها","كُنَّ لِلبيضِ قِسّياً وَنِبالا",24,"ل",2,0],["وَالحور قالَت أَرخوا","لَنا نَعيم شَخْسَنَهْ",25,"ن",2,0],["وَالحُور قَد مَدّت لَها","في جَنة المَأوى يَدا",26,"د",2,0],["وَالحُور في سلخ المحرّم أَرّخت","لِلبَدر عَباس أَضاء مُحَمد",27,"د",1,0],["وَالحور قالَت تَهنيه مؤرّخة","عَبد اللَطيف نَبيهٌ خُصَّ بِالكَرَم",28,"م",1,0],["وَالحور قالَت مُذ حللتَ بِدارها","أَهلاً وَسَهلاً بِالحَبيب المُقبل",29,"ل",1,0],["وَالحُور قَد قالَت لَها","بُشراك في دار الجَزا",30,"ز",2,0],["والحور مشرفة لتكرم ضيفها","تهتز بين أساور وخلاخل",31,"ل",1,0],["والحوت آمِنْ والذرَاعْ لُو صَدّقْ","والجَوْزَا تشهدْ والسِّمَاكْ قَدْ شَهَّدْ",32,"د",1,0],["والحول يمكثه زهير حجّة","أن القوافي لسن طوع الإمّع",33,"ع",1,0],["والحور والولدان سمَّار","تحيط به غلاه",34,"ا",2,0],["والحوتُ يسبَحُ في صفاء مياهها","والطير بين رياضها يترنّم",35,"م",1,0],["وَالحوت في البحر كَيفَ يشكره","يسبح في غمره وَيستره",36,"ه",1,1],["والحورُ قد برَزَتْ من كُلِّ مطّلَعٍ","تكادُ تُفْصِحُ بالإصغاء والنظر",37,"ر",1,0],["والحوار إن نام تحته","اشتهى لو دام سنين",38,"ن",1,0],["والحور والولدان في غرُفاتها","والدر والياقوت والأزهار",39,"ر",1,0],["والحورُ لا تَفنَى كَذلِكَ جَنَّةُ ال","مأوَى وَمَا فِيهَا مِنَ الوِلدَانِ",40,"ن",1,0],["والحول حولك والجميع ملكك","لا ندّ لك لا ضدّ لك يسانيك",41,"ك",1,0],["والحوتُ والناقة يا أخِي اسمَعِ","باشيُّهُم أَربَعْ مِنَ الأصَابعِ",42,"ع",1,0],["والحور قد أنشدته في مؤرخها","قد طاب مثواك بالجنات يا حسن",43,"ن",1,0],["والحور إذ جاءها وافى مؤرخها","بجنة البشر حل البيك نعمان",44,"ن",1,0],["والحور إذ جردت عنه ملابسه","جاءته خاطبة والخطب قد جلا",45,"ل",2,0],["والحور في جنات عدن أرخت","بنعيمها قد خلد السنجرجي",46,"ج",2,0],["والحور في الفردوس قالت أرخوا","لقد مضى إلى قدوم الجنه",47,"ن",2,0],["والحور قالت لي فيما أرخت","حل بفردوس ديار الخلد",48,"د",1,0],["والحور والولدان قد أرخوا","مقام إبراهيم هذا سنى",49,"ن",2,0],["والحور الآن مؤرخة","عثمان توجه في الجنة",50,"ه",1,0],["والحور قالت أرخوا","بجنة الخلد سكن",51,"ن",1,0],["والحوت ليخ ليثه والذنب له","إذ سهد العذراء وهي السنبله",52,"ه",1,0],["والحوت حامل كلكم مع ثورها","والمآ ثم الأرض ثم الصخرة",53,"ه",1,0],["والحوض يشبه نصف دايرة سوى","سموه حوضاً باصطلاح أيمة",54,"ه",1,0],["وَالحَوضُ حَقٌّ وَالشَفاعَةُ مِثلهُ","لا يُشكِلانِ عَلى اِمرئٍ لا يَمتَري",55,"ر",2,0],["وَالحَواشي وارضَ عَنّا","رَبَّنا أَعلاَ الرضاء",56,"ا",2,0],["والحوتُ يطفو فإذا","ما طفح الفجرُ رَسَب",57,"ب",1,0],["وَالحورُ في الجَنّات قُلنَ أَرِّخ","هَنِّىء بِجنّات النَعيم عصمَت",58,"ت",1,0],["وَأَلَحّوا فَأَظهَرَت منه شَيئاً","هفواتي وَأَبطنت أَشياءَ",59,"ا",2,0],["وَالحور مُذ جاءَها قالَت مُؤرخة","بُشرى فَقَد جاءَنا المَقصود وَالأَرَب",60,"ب",1,0],["والحور ترقص في الخدور مسرة","حتى حسبنا كل خدرٍ ملعبا",61,"ب",2,0],["والحور والولدان قامت حوله","كل يسائله الرضا مستعطفا",62,"ف",2,0],["والحور والولدان تخدمهم بها","ولهم بأعلاها المقام الأول",63,"ل",1,0],["والحول قد حال وحال معمر","عن العهود والحئول المصدر",64,"ر",1,0],["والحور والولدان محدقة به","أضحت فسل جيد العلى عن عقده",65,"د",2,0],["والحور تخطر في جنائن أنسنا","بأبي وأمي سحر ذيّاك الحور",66,"ر",1,0],["وَالحورُ وَالولدان في أَرجائِها","كَاللؤلُؤ المَنثور يَزهو رَونَقا",67,"ق",2,0],["والحور لما اتاها استبشرت فرحا","كأنها طلبته اجمل الطلب",68,"ب",1,0],["والحواجب رسم مثّل سيف الحسم","قلبي ناشك على غفلةٍ ما امهلك",69,"ك",1,0],["والحوثي يلهو بأمانٍ","وفراش القوم له مضجع",70,"ع",1,0],["وَالْحُوْتُ يَجْهَلُ مَاْ بِالْعِشْقِ مِنْ عِبَرٍ","لاْ شَكَّº قَدْ غَاْبَ عَنْ يَأْفُوْخِهِ الْخَبَرُ",71,"ر",1,0],["والحور منتفض الغدائر راقصٌ","نشوانُ من رجع الغِناء مُطيّرُ",72,"ر",1,0],["وَالْحَوَّارِيَّاتُ اللَّوَاتِي بِصَفْوي","رَائِقَاتٌ وَرِيِقُهُنَّ طَهُورُ",73,"ر",1,0],["والحور ترمقه بعيني جؤذر","وتسير في الفردوس حيث يسير",74,"ر",1,0],["وَالحَوَاكِيرُ بَكَتْ مِنْ بَعْدِنَا وَٱلرَّوْضُ أَقْفَرْ","وَكُرُومُ ٱلعِنَبِ الخَمْرِيِّ شَقَّتْ أَلْفَ مِئْزَرْ",75,"ر",1,0],["والحوض يسقي من يشاء به وقد","بلغ الردى من هول ما يتجرع",76,"ع",1,0],["والحواجب كنهن سود النصيل","والحيا فتان في ذاك القوام",77,"م",1,0],["والحوت أرواح الألى يبلى لهم","ما بين تلك المائجات قوام",78,"م",1,0],["21. والحور ترفل بالثياب كأنها","من لؤلؤ يجلو الضياء فينتشر",79,"ر",1,0],["والحور في سكن فيها مخلدة","يا طيب مسكنها في عطر ريحان",80,"ن",1,0],["والحواجب دقة الملي متر منها كسبها","كنها شمسة سواعيه على بشتن حساوي",81,"ا",3,0],["وَالحُوتُ ما أطوى الحَشا في يونُسَ","كَلّا وَ لا رَكَدَتْ عَليهِ بُحورُ",82,"ر",1,0],["والحور يرفعن ذيل فستانها","من خلفها والأملاك ترقيها",83,"ي",3,0],["والحَوْتُ بِالْأَعْصَاْرِ عَاْدَ مُضَرّجاً","بِدَمٍ يَشُقُّ الْحَيْدَ جَهْلَاً بالسبَبْ",84,"ب",1,0],["والحول حول الله، لا حول امرئ","عصفت عليه زوابع الأحْزان",85,"ن",1,0]]}