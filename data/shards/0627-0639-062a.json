om/ViewPoem.aspx?id=188216",""],[5943,"اعتقْ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=92975",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[5954,"أسطورتي","https://www.poetsgate.com/ViewPoem.aspx?id=195113",""],[5956,"زارعُ الأشجار","https://www.poetsgate.com/ViewPoem.aspx?id=183141",""],[5956,"يا ربُّ يا مَن لا تضيع ودائعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=200541",""],[5957,"يا رفيق كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=187772",""],[5997,"الرحى جوعى","https://www.poetsgate.com/ViewPoem.aspx?id=214466",""],[6004,"واستباح العُرى","https://www.poetsgate.com/ViewPoem.aspx?id=33753",""],[6008,"رثاء بالشيوخ (مهل القعقاع -مساعد البنيه )","https://www.poetsgate.com/ViewPoem.aspx?id=60996",""],[6056,"طريق المدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=130179",""],[6082,"بوح انثى","https://www.poetsgate.com/ViewPoem.aspx?id=60186",""],[6221,"على ضفاف القمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64920&r=&rc=0",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[6233,"في خمس دقائق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82085&r=&rc=30",""],[6238,"قلب قزح...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86772&r=&rc=1",""],[6300,"بقايا الزمن المرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82864&r=&rc=35",""],[6315,"البَيدَاءُ وَ الجَنِينُ المُرتَقَب ... تَحِيَّتَانِ للأُنثَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87577&r=&rc=2",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[6339,"أبواب الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87890&r=&rc=2",""],[6345,"يؤرقني الضياعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78671&r=&rc=42",""],[6351,"مخطوطة للمتنبي.. لم تُحقَّق بعد!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86051&r=&rc=4",""]],"verses":[["أَعتادُهُم لا أُرَجّي أَن يَعودَ لَهُم","إِلَيَّ ماضٍ وَلا لي فيهِمُ طَمَعُ",0,"ع",1,0],["أَعتَقَ مِن رِقِّ الهَوى","مُذَلَّلاً مُعَبَّدا",1,"د",2,0],["أعَتْباً وقد سَيَّرْتُ فيكُمْ مَدائِحاً","كَما خالَطَتْ ماءَ الغَمامَةِ قَرْقَفُ",2,"ف",1,0],["اِعتَزَلتُ الكَواعِبَ البيضَ وَاِستَت","مَمتُ وُدّي لَها فَلَستُ أُلامُ",3,"م",1,0],["أَعَتباً عَلَينا يا ظَلومُ فَنُعتِبُ","وَإِن كُنتُ لَم أُحوِجكُمُ أَن تَعتَّبوا",4,"ب",3,1],["أَعتَبتني صُروفُ دَهري فَشُكراً","لِزَمانٍ إِلى جَنابِكَ أَهدى",5,"د",2,0],["أَعتِبُ مِن ظُلمِكَ لي جاهِداً","وَيَغلِبُ الشَوقُ فَأَستَعتِبُ",6,"ب",1,0],["أَعَتبٌ عَلَينا ذادَ عَن ذَلِكَ الرِضى","فَنُعتَبَ أَم بِالمَسمَعِ المُعتَلي وَقرُ",7,"ر",1,0],["اعتبتَ أم عتبتْ عليك صدوف","وعتاب مثلك مثلها تشريفُ",8,"ف",1,1],["أعتقْني الهمّ فكان الوَلا","لابن عقيلِ بن أبي طالب",9,"ب",1,0],["أعتقت رقِّي من الخطوب فما","أطيب فيك الثنا وما أعبق",10,"ق",1,1],["أعتق من المهلكات رقي","ولا تحكّم عليّ مالك",11,"ك",1,0],["اِعتَضتُ مِن وَجهِ خِلّي بَعدَ فُرقَتِهِ","كَأساً أَجَرَّعُ مِنها ما أَجَرَّعُهُ",12,"ع",2,0],["أعتِبْ بيومٍ صالحٍ فيهمُ","ليس على أمثاله عاتبُ",13,"ب",1,0],["أعتبنا الدهرُ بالأمير فلا","بُروكُهُ يُشتكَى ولا خَبَبُهْ",14,"ب",2,0],["أعتدُّها شكوى تشكيتها","إليك لا زُلفى تَزلَّفْتُها",15,"ت",3,0],["أعتبَ الله بعد بلوى تشكَّى","جَهْدَها الناسُ والصخورُ الصُّموتُ",16,"ت",1,0],["أعتقتُ عَبدَيَّ في القريض معاً","عبدةَ والفحلَ من بني عبَدَهْ",17,"د",2,0],["أعتقتَ من أعطيته وحرمتهُ","من مطمع أبداً ومن إفلاس",18,"س",1,0],["أعتبني الدهر بعد معتِبهِ","فغاضِبِ الدهر فيَّ أو راضِه",19,"ض",2,0],["اعتبرْ أين مَنْ يجاهر بالسو","ءةِ في أمِّه من المَشْتوم",20,"م",1,0],["اعتقالا وبعد ذلك نفيا","لم يكن قد بلاهما جثمانك",21,"ك",1,0],["أعتق حياتي حتى يراهق","يا رب والموت بعد ديني",22,"ي",1,0],["اعتقدن ما تشاء","النفس أن تعتقدا",23,"د",2,1],["اِعتَدل الأَمرُ عَلى مقدمِهِ","وَكانَ رُكنُ المُلكِ مَيلاً فَاِستَوى",24,"ا",1,0],["أعتَبت بالصدود بعد عتاب","ورمت بالنقاب بالعُنّاب",25,"ب",1,0],["أَعتاضُ مِنكَ وَلَستَ مِنّي واحِداً","عِوَضاً فَقارِب مُنصِفاً أَو باعِدِ",26,"د",1,0],["اِعتِدالٌ يُميلُ مِنهُ اِنخِناثٌ","وَتَثَنٍّ فيهِ الفَخامَةُ لُطفُ",27,"ف",1,0],["أَعتَدُّ عِزَّكَ مِن وُفورِ مَذاهِبي","وَسُعودِ أَيّامي وَحُسنِ زَماني",28,"ن",2,0],["أَعُتبَةُ إِن تَطاوَلَتِ اللَيالي","عَلَيكَ فَإِنَّ شِعري سَمُّ ساعَه",29,"ع",2,1],["أعُتبَةُ أَجبَنُ الثَقلَينِ عُتبا","بِجَهلِكَ صِرتَ لِلمَكروهِ نَصبا",30,"ب",2,1],["أَعُتَيبَ يا اِبنَ الفِعلَةِ اللَخناءِ","أَأَمِنتَ مِن بَذَخي وَمِن غُلَوائي",31,"ي",1,1],["اعتزلْ ذكرَ الأغاني والغزلْ","وقلِ الفصلَ وجانبْ مَنْ هزلْ",32,"ل",1,1],["اعتبرْ نحنُ قَسَمْنا بينَهُمْ","تلقَهُ حقاً وبالحقِّ نَزَلْ",32,"ل",1,0],["اعتدى الدهرَ وادعى","أنَّهُ وافقَ الخبرْ",33,"ر",1,1],["اعتزلِ الناسَ ومِلْ","عنهمْ بنفسٍ صادقهْ",34,"ق",2,1],["إِعتادَني بَعدَ سُلوَةٍ حَزَني","طَيفُ حَبيبٍ سَرى فَأَرَّقَني",35,"ن",2,1],["إِعتادَ هَذا القَلبُ بَلبالُهُ","إِذ قُرِّبَت لِلبَينِ أَجمالُهُ",36,"ل",2,1],["اعتزلْ ما مَضَى لِنَفْسِكَ في دُنْ","يا الخطَايا فأنتَ خَلْقٌ جَديدُ",37,"د",1,0],["إِعتِناقاً عَلى مَخافَةِ عَينٍ","قَد رُمِقنا بِها وَقَومٍ غِضابِ",38,"ب",1,0],["اعتَلّ من وَجَناتِهِ فأجالَ في","صحنِ العقيقِ جداولاً من عَندَم",39,"م",1,0],["أَعتَلُّ بِالماءِ فَأَدعو بِهِ","لَعَلَّها تَنزِلُ بِالماءِ",40,"ا",2,1],["أَعتَقتُ ما أَملُكُ إِن لَم أَكُن","أُحِبُّ أَن أَلقاكِ فَاِلقَيني",41,"ي",1,1],["أَعتِقيني مِنَ الهَوى","أَو عِدي مِنكِ مَوعِدا",42,"د",2,0],["أعتَزَلْتَ الحكم أم كانَ فرارا","بعد أن ألفيْتَ حوليْكَ الدَّمارا",43,"ر",2,0],["أعْتَبَ أبا كَربٍ وأعْيَتْ تُبَّعاً","وأَبتْ بَسالتُها على الأَعرابِ",44,"ب",1,0],["إعْتِدَالٌ يُميلُ منه انْخِنَاثٌ،","وَيُثَنٍّ فيهِ الفَخَامَةَ لُطْفُ",45,"ف",1,0],["اعتَدتَ من قُطرِكَ الأقصَى لتَقمِرَني","بَني المُدَبِّرِ أنْصَاراً، وَأعْوَانَا",46,"ن",2,0],["اعترت نفسي هزة الأفراح","حينما بان لي بياض الصباح",47,"ح",1,0],["اعتابه حصن النزيل وبابه","بظلاله لاولي القلوب رجاء",48,"ا",2,0],["أَعُتبَةُ لا تَسمَع بِنا قَولَ كاشِحٍ","حَسودٍ كَذوبٍ مُبغِضٍ ذي دَغاولِ",49,"ل",1,0],["أَعتَبتِ إِثرَ تَعَتُّبٍ وَوَصَلتِ غِب","بَ تَجَنُّبٍ وَبَذَلتِ بَعدَ تَمَنُّعِ",50,"ع",1,0],["اعتدل الباطن والظاهر","وكل شيء فله آخر",51,"ر",1,1],["أعتقتُ مِن أَفناءِ كُوزٍ وَهاجِرٍ","ثَلاثين لَم تُهتَك لِسِرٍّ جُيوبُها",52,"ه",2,1],["اعتلى كورها فتحسب من حزم","عليها ساقي حزما وضنينا",53,"ن",2,0],["أعتاب على زمان مسيئ","صاح اني تعاتب الأزمان",54,"ن",1,0],["أَعْتَدُّهُ خَوْطاً لِعَيْشِي نَاعِما","فَيَعُودُ خَطِّيّاً لِقَتْلِيَ ذَابِلا",55,"ل",2,0],["أَعتب الدَهر فيك وَالدهر ما زا","ل خؤنا بِأَهلِه غَدّارا",56,"ر",2,0],["اِعتادَ أن يَطأَ الأفلاكَ أخمَصُه","فما دَرى عند وَطْء الأرضِ كيف يَطا",57,"ط",2,0],["أُعتِقتُ مِن رِقِّ الخَطا","وَفَكِكتُ مِن أَشرِ النَدامَه",58,"م",2,1],["أعْتَصِر الأَنْجُمَ حتى أرى","أكْبَرَها في قبضتي أَصغرا",59,"ر",2,0],["إِعتِرافي بِعِظَم فَضلِكَ فَضلُ","وَعُدولي عَن كُنهِ وَصفِكَ عَدلُ",60,"ل",1,1],["اعتدهم وهم الأسود فرائسي","فهم دريئة صارمي وسناني",61,"ن",2,0],["أعتق عبيدك من لظى نار غدا","نزّاعةً يوم القيامة للشوى",62,"و",2,0],["أعتفي منكِ صخرةً ليس تُثنَي","وهي في العين بانَةٌ تتثنَّى",63,"ن",2,0],["أَعتِق مِنَ الهَمِّ رِقَّ قَلبي","بِعاتِقٍ حَشوَها زُجاجُ",64,"ج",1,1],["اعتدتم الإخلاص مني صادحا","بالشعر فيكم موفيا بالموعد",65,"د",1,0],["اعتبرنا وإن نكن في برود","حيث تدري ما يفعل الزمهرير",66,"ر",1,0],["اعتلت شأنا على أترابها","اعتلاء الشأن في بانت سعاد",67,"د",1,0],["أعتقه من رق الزمان وخله","وقف الثناء على ولاء المعتق",68,"ق",1,0],["أعتقت من رق الملوك مطامعي","ورميت عصمة ودهم بطلاق",69,"ق",1,0],["أعتق باصطناعه","من عز منهم ثم ذل",70,"ل",1,0],["أعتقهم ثم غدا","كل على نداه كل",70,"ل",1,0],["أعتقتني ولك الولاء فإن أمت","فاحجب قبيلي من تباعد أودنا",71,"ن",2,0],["اعتبروا الأرض بأسمائها","واعتبروا الصاحب بالصاحب",72,"ب",1,0],["أَعْتَقْتَني وملكتَ رِقِّ","ي إِذ رَدَدْت إِليَّ رُوحي",73,"ح",2,0],["اعترضْ باطنَ الشقيقِ ففيه","طُرَفٌ ما يملُّها ذو اعتراض",74,"ض",1,0],["أعتدُّ إحدى وعشرٍ من سنيك مَضت","أدركتَ في الفخر ما لا يُدرِك السلف",75,"ف",1,0],["اعتراضيك بالهجاء وتقذي","ريَ شعري بقُذْرَةِ الأقدار",76,"ر",1,0],["إِعتاقهُم ريبُ الزَمانِ فَغالَهُم","وَتُرِكتُ فَرداً غَيرَ ذي إِخوانِ",77,"ن",1,0],["اعتزال الورى وإن جل خطبا","هو عندي دون احتمال اللئام",78,"م",1,1],["أَعتِبَةَ حَرَّكَ مِن أَخيكَ وَلا تَكُن","فَوَلِّ الهُوينا إِن أَرادَ م