{"poems":[[53,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[55,"لا تلمني فما علي ملام","https://www.aldiwan.net/poem26116.html","الخفيف"],[55,"أعتبا علينا يا ظلوم فنعتب","https://www.aldiwan.net/poem26453.html","الطويل"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[73,"يا قمرا مطلعه المغرب","https://www.aldiwan.net/poem11865.html","السريع"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[37,"اعتبت أم عتبت عليك صدوف","https://www.aldiwan.net/poem7233.html","الكامل"],[72,"بهاء دين الله حكمت في","https://www.aldiwan.net/poem18312.html","السريع"],[72,"أعتقت رقي من الخطوب فما","https://www.aldiwan.net/poem19416.html","المنسرح"],[72,"يا معتق المذنبين مما","https://www.aldiwan.net/poem19455.html","مخلع البسيط"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[89,"اعتقدن ما تشاء","https://www.aldiwan.net/poem45111.html","مجزوء الرجز"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[43,"يا ديار العباهر الأتراب","https://www.aldiwan.net/poem10613.html","الخفيف"],[45,"أترى حمولة لا يحمل نفسه","https://www.aldiwan.net/poem63463.html","الكامل"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[44,"أعتبة إن تطاولت الليالي","https://www.aldiwan.net/poem30024.html","الوافر"],[44,"أعتبة أجبن الثقلين عتبا","https://www.aldiwan.net/poem30071.html","الوافر"],[44,"أعتيب يا ابن الفعلة اللخناء","https://www.aldiwan.net/poem30074.html","الكامل"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"اعتدى الدهر وادعى","https://www.aldiwan.net/poem28376.html","مجزوء الخفيف"],[69,"اعتزل الناس ومل","https://www.aldiwan.net/poem29303.html","مجزوء الرجز"],[31,"إعتادني بعد سلوة حزني","https://www.aldiwan.net/poem41290.html","المنسرح"],[31,"إعتاد هذا القلب بلباله","https://www.aldiwan.net/poem41832.html","السريع"],[105,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[40,"تلك عرسي تلومني في التصابي","https://www.aldiwan.net/poem42300.html","الخفيف"],[75,"إيها لك النعمى علي فأنعمي","https://www.aldiwan.net/poem69034.html","الكامل"],[48,"أعتل بالماء فأدعو به","https://www.aldiwan.net/poem10407.html","السريع"],[50,"أعتقت ما أملك إن لم أكن","https://www.aldiwan.net/poem24502.html","السريع"],[50,"اسقني يابن أسعدا","https://www.aldiwan.net/poem63949.html","مجزوء الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67292","الكامل"],[45,"لأخي الحُبّ عَبرَةٌ ما تَجِفُّ","https://www.poetsgate.com/ViewPoem.aspx?id=32543",""],[45,"أعَنْ جِوَارِ أبي إسحاقَ تَطمَعُ أنْ","https://www.poetsgate.com/ViewPoem.aspx?id=31801",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[116,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[135,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[144,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[187,"اعتدل الباطن والظاهر","https://www.aldiwan.net/poem43832.html","السريع"],[209,"أعتقت من أفناء كوز وهاجر","https://www.aldiwan.net/poem2025.html","الطويل"],[262,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[262,"ربع أسماء لا عداك عنان","https://www.aldiwan.net/poem38168.html","الخفيف"],[276,"من عاذري من بابلي طرفه","https://www.aldiwan.net/poem25422.html","الكامل"],[362,"يا لحبر مضى وأخلى الديارا","https://www.aldiwan.net/poem68103.html","الخفيف"],[365,"دم للعلا في ظلال العز مغتبطا","https://www.aldiwan.net/poem60854.html","البسيط"],[367,"أعتقت من رق الخطا","https://www.aldiwan.net/poem17391.html","مجزوء الكامل"],[401,"الشفق الأحمر","https://www.aldiwan.net/poem6796.html","عموديه"],[407,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[410,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[422,"يا قلب زرت وما انطوى ذاك الجوى","https://www.aldiwan.net/poem46393.html","الكامل"],[459,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[469,"أعتق من الهم رق قلبي","https://www.aldiwan.net/poem60324.html","مخلع البسيط"],[480,"سعيا لأجلك في الرعيل المهتدي","https://www.aldiwan.net/poem36956.html","الكامل"],[480,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[480,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[516,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[516,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[516,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[516,"جعل الدعاء وظيفة لك والثنا","https://www.aldiwan.net/poem12288.html","الكامل"],[559,"يا أيها الناس خذوا حذركم","https://www.aldiwan.net/poem34960.html","السريع"],[576,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"]],"verses":[["أَعتادُهُم لا أُرَجّي أَن يَعودَ لَهُم","إِلَيَّ ماضٍ وَلا لي فيهِمُ طَمَعُ",0,"ع",1,0],["أَعتَقَ مِن رِقِّ الهَوى","مُذَلَّلاً مُعَبَّدا",1,"د",2,0],["أعَتْباً وقد سَيَّرْتُ فيكُمْ مَدائِحاً","كَما خالَطَتْ ماءَ الغَمامَةِ قَرْقَفُ",2,"ف",1,0],["اِعتَزَلتُ الكَواعِبَ البيضَ وَاِستَت","مَمتُ وُدّي لَها فَلَستُ أُلامُ",3,"م",1,0],["أَعَتباً عَلَينا يا ظَلومُ فَنُعتِبُ","وَإِن كُنتُ لَم أُحوِجكُمُ أَن تَعتَّبوا",4,"ب",3,1],["أَعتَبتني صُروفُ دَهري فَشُكراً","لِزَمانٍ إِلى جَنابِكَ أَهدى",5,"د",2,0],["أَعتِبُ مِن ظُلمِكَ لي جاهِداً","وَيَغلِبُ الشَوقُ فَأَستَعتِبُ",6,"ب",1,0],["أَعَتبٌ عَلَينا ذادَ عَن ذَلِكَ الرِضى","فَنُعتَبَ أَم بِالمَسمَعِ المُعتَلي وَقرُ",7,"ر",1,0],["اعتبتَ أم عتبتْ عليك صدوف","وعتاب مثلك مثلها تشريفُ",8,"ف",1,1],["أعتقْني الهمّ فكان الوَلا","لابن عقيلِ بن أبي طالب",9,"ب",1,0],["أعتقت رقِّي من الخطوب فما","أطيب فيك الثنا وما أعبق",10,"ق",1,1],["أعتق من المهلكات رقي","ولا تحكّم عليّ مالك",11,"ك",1,0],["اِعتَضتُ مِن وَجهِ خِلّي بَعدَ فُرقَتِهِ","كَأساً أَجَرَّعُ مِنها ما أَجَرَّعُهُ",12,"ع",2,0],["أعتِبْ بيومٍ صالحٍ فيهمُ","ليس على أمثاله عاتبُ",13,"ب",1,0],["أعتبنا الدهرُ بالأمير فلا","بُروكُهُ يُشتكَى ولا خَبَبُهْ",14,"ب",2,0],["أعتدُّها شكوى تشكيتها","إليك لا زُلفى تَزلَّفْتُها",15,"ت",3,0],["أعتبَ الله بعد بلوى تشكَّى","جَهْدَها الناسُ والصخورُ الصُّموتُ",16,"ت",1,0],["أعتقتُ عَبدَيَّ في القريض معاً","عبدةَ والفحلَ من بني عبَدَهْ",17,"د",2,0],["أعتقتَ من أعطيته وحرمتهُ","من مطمع أبداً ومن إفلاس",18,"س",1,0],["أعتبني الدهر بعد معتِبهِ","فغاضِبِ الدهر فيَّ أو راضِه",19,"ض",2,0],["اعتبرْ أين مَنْ يجاهر بالسو","ءةِ في أمِّه من المَشْتوم",20,"م",1,0],["اعتقالا وبعد ذلك نفيا","لم يكن قد بلاهما جثمانك",21,"ك",1,0],["أعتق حياتي حتى يراهق","يا رب والموت بعد ديني",22,"ي",1,0],["اعتقدن ما تشاء","النفس أن تعتقدا",23,"د",2,1],["اِعتَدل الأَمرُ عَلى مقدمِهِ","وَكانَ رُكنُ المُلكِ مَيلاً فَاِستَوى",24,"ا",1,0],["أعتَبت بالصدود بعد عتاب","ورمت بالنقاب بالعُنّاب",25,"ب",1,0],["أَعتاضُ مِنكَ وَلَستَ مِنّي واحِداً","عِوَضاً فَقارِب مُنصِفاً أَو باعِدِ",26,"د",1,0],["اِعتِدالٌ يُميلُ مِنهُ اِنخِناثٌ","وَتَثَنٍّ فيهِ الفَخامَةُ لُطفُ",27,"ف",1,0],["أَعتَدُّ عِزَّكَ مِن وُفورِ مَذاهِبي","وَسُعودِ أَيّامي وَحُسنِ زَماني",28,"ن",2,0],["أَعُتبَةُ إِن تَطاوَلَتِ اللَيالي","عَلَيكَ فَإِنَّ شِعري سَمُّ ساعَه",29,"ع",2,1],["أعُتبَةُ أَجبَنُ الثَقلَينِ عُتبا","بِجَهلِكَ صِرتَ لِلمَكروهِ نَصبا",30,"ب",2,1],["أَعُتَيبَ يا اِبنَ الفِعلَةِ اللَخناءِ","أَأَمِنتَ مِن بَذَخي وَمِن غُلَوائي",31,"ي",1,1],["اعتزلْ ذكرَ الأغاني والغزلْ","وقلِ الفصلَ وجانبْ مَنْ هزلْ",32,"ل",1,1],["اعتبرْ نحنُ قَسَمْنا بينَهُمْ","تلقَهُ حقاً وبالحقِّ نَزَلْ",32,"ل",1,0],["اعتدى الدهرَ وادعى","أنَّهُ وافقَ الخبرْ",33,"ر",1,1],["اعتزلِ الناسَ ومِلْ","عنهمْ بنفسٍ صادقهْ",34,"ق",2,1],["إِعتادَني بَعدَ سُلوَةٍ حَزَني","طَيفُ حَبيبٍ سَرى فَأَرَّقَني",35,"ن",2,1],["إِعتادَ هَذا القَلبُ بَلبالُهُ","إِذ قُرِّبَت لِلبَينِ أَجمالُهُ",36,"ل",2,1],["اعتزلْ ما مَضَى لِنَفْسِكَ في دُنْ","يا الخطَايا فأنتَ خَلْقٌ جَديدُ",37,"د",1,0],["إِعتِناقاً عَلى مَخافَةِ عَينٍ","قَد رُمِقنا بِها وَقَومٍ غِضابِ",38,"ب",1,0],["اعتَلّ من وَجَناتِهِ فأجالَ في","صحنِ العقيقِ جداولاً من عَندَم",39,"م",1,0],["أَعتَلُّ بِالماءِ فَأَدعو بِهِ","لَعَلَّها تَنزِلُ بِالماءِ",40,"ا",2,1],["أَعتَقتُ ما أَملُكُ إِن لَم أَكُن","أُحِبُّ أَن أَلقاكِ فَاِلقَيني",41,"ي",1,1],["أَعتِقيني مِنَ الهَوى","أَو عِدي مِنكِ مَوعِدا",42,"د",2,0],["أعتَزَلْتَ الحكم أم كانَ فرارا","بعد أن ألفيْتَ حوليْكَ الدَّمارا",43,"ر",2,0],["أعْتَبَ أبا كَربٍ وأعْيَتْ تُبَّعاً","وأَبتْ بَسالتُها على الأَعرابِ",44,"ب",1,0],["إعْتِدَالٌ يُميلُ منه انْخِنَاثٌ،","وَيُثَنٍّ فيهِ الفَخَامَةَ لُطْفُ",45,"ف",1,0],["اعتَدتَ من قُطرِكَ الأقصَى لتَقمِرَني","بَني المُدَبِّرِ أنْصَاراً، وَأعْوَانَا",46,"ن",2,0],["اعترت نفسي هزة الأفراح","حينما بان لي بياض الصباح",47,"ح",1,0],["اعتابه حصن النزيل وبابه","بظلاله لاولي القلوب رجاء",48,"ا",2,0],["أَعُتبَةُ لا تَسمَع بِنا قَولَ كاشِحٍ","حَسودٍ كَذوبٍ مُبغِضٍ ذي دَغاولِ",49,"ل",1,0],["أَعتَبتِ إِثرَ تَعَتُّبٍ وَوَصَلتِ غِب","بَ تَجَنُّبٍ وَبَذَلتِ بَعدَ تَمَنُّعِ",50,"ع",1,0],["اعتدل الباطن والظاهر","وكل شيء فله آخر",51,"ر",1,1],["أعتقتُ مِن أَفناءِ كُوزٍ وَهاجِرٍ","ثَلاثين لَم تُهتَك لِسِرٍّ جُيوبُها",52,"ه",2,1],["اعتلى كورها فتحسب من حزم","عليها ساقي حزما وضنينا",53,"ن",2,0],["أعتاب على زمان مسيئ","صاح اني تعاتب الأزمان",54,"ن",1,0],["أَعْتَدُّهُ خَوْطاً لِعَيْشِي نَاعِما","فَيَعُودُ خَطِّيّاً لِقَتْلِيَ ذَابِلا",55,"ل",2,0],["أَعتب الدَهر فيك وَالدهر ما زا","ل خؤنا بِأَهلِه غَدّارا",56,"ر",2,0],["اِعتادَ أن يَطأَ الأفلاكَ أخمَصُه","فما دَرى عند وَطْء الأرضِ كيف يَطا",57,"ط",2,0],["أُعتِقتُ مِن رِقِّ الخَطا","وَفَكِكتُ مِن أَشرِ النَدامَه",58,"م",2,1],["أعْتَصِر الأَنْجُمَ حتى أرى","أكْبَرَها في قبضتي أَصغرا",59,"ر",2,0],["إِعتِرافي بِعِظَم فَضلِكَ فَضلُ","وَعُدولي عَن كُنهِ وَصفِكَ عَدلُ",60,"ل",1,1],["اعتدهم وهم الأسود فرائسي","فهم دريئة صارمي وسناني",61,"ن",2,0],["أعتق عبيدك من لظى نار غدا","نزّاعةً يوم القيامة للشوى",62,"و",2,0],["أعتفي منكِ صخرةً ليس تُثنَي","وهي في العين بانَةٌ تتثنَّى",63,"ن",2,0],["أَعتِق مِنَ الهَمِّ رِقَّ قَلبي","بِعاتِقٍ حَشوَها زُجاجُ",64,"ج",1,1],["اعتدتم الإخلاص مني صادحا","بالشعر فيكم موفيا بالموعد",65,"د",1,0],["اعتبرنا وإن نكن في برود","حيث تدري ما يفعل الزمهرير",66,"ر",1,0],["اعتلت شأنا على أترابها","اعتلاء الشأن في بانت سعاد",67,"د",1,0],["أعتقه من رق الزمان وخله","وقف الثناء على ولاء المعتق",68,"ق",1,0],["أعتقت من رق الملوك مطامعي","ورميت عصمة ودهم بطلاق",69,"ق",1,0],["أعتق باصطناعه","من عز منهم ثم ذل",70,"ل",1,0],["أعتقهم ثم غدا","كل على نداه كل",70,"ل",1,0],["أعتقتني ولك الولاء فإن أمت","فاحجب قبيلي من تباعد أودنا",71,"ن",2,0],["اعتبروا الأرض بأسمائها","واعتبروا الصاحب بالصاحب",72,"ب",1,0],["أَعْتَقْتَني وملكتَ رِقِّ","ي إِذ رَدَدْت إِليَّ رُوحي",73,"ح",2,0]]}