s://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[23,"عرفت ديار زينب بالكتيب","https://www.poetsgate.com/ViewPoem.aspx?id=11527",""],[11,"وإنّي لَعَفُّ الفَقْرِ، مُشترَكُ الغِنى","https://www.poetsgate.com/ViewPoem.aspx?id=16866",""],[90,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[80,"أين مني عتبُ أحبابٍ هجود","https://www.poetsgate.com/ViewPoem.aspx?id=3156",""],[91,"هملت","https://www.poetsgate.com/ViewPoem.aspx?id=53205",""],[91,"حنة مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=53395",""],[91,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[89,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[20,"طال الليل علينا واِعتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69774&r=&rc=15",""],[85,"شَيَّعتُ أَحلامي بِقَلبٍ باكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72247&r=&rc=240",""]],"verses":[["شيمَتا عِزٍّ وَمَجدٍ أَغنَتا","عَن أَبي أَحمَدَ فينا وَالحُسَينِ",0,"ن",1,0],["شَيَّعوهُ بِالدَمعِ يَجري كَما شُي","يِعَ غُدواً بَواكِرُ الأَظعانِ",1,"ن",1,0],["شَيبٌ وَما جُزتُ الثَلاثينَ نَزَل","نُزولَ ضَيفٍ بِبَخيلٍ ذي عِلَل",2,"ل",1,0],["شُيِّعَ بِالقَطرِ الرِوى","ذاكَ الشَبابُ الراحِلُ",3,"ل",1,0],["شَيخانِ هَذا فارِسٌ بَطَلٌ","أَبَداً وَهَذا عاجِزٌ مَذِلُ",4,"ل",1,0],["شَيمي لَحاظَكِ عَنّا ظَبيَةَ الخَمَرِ","لَيسَ الصِبا اليَومَ مِن شَأني وَلا وَطَري",5,"ر",2,1],["شيّدَ ما أثّلَ منْ مَجْدِهِ","والمَجْدُ مَوْروثٌ ومَكْسوبُ",6,"ب",1,0],["شَيْخَ رِبَاطٍ إِنْ أَتَى شَادِنٌ","خَلْوَتَهُ عِنْدَ انْسِدَالِ الظَّلاَمْ",7,"م",1,1],["شِيَمٌ إذَا مَا شِمْتَ بَا","رِقُ عَهْدِهَا بالْعِهْدِ سَائِلْ",8,"ل",1,0],["شِيَمٌ تَرُدُّ الناقِمينَ لِوُدِّهِ","وَشَمائِلٌ تَستَلُّ حِقدَ النابي",9,"ب",2,0],["شُيوخٌ كُلَّما هَمَّت بِأَمرٍ","زَأَرتُم دونَهُ زَأرَ الأُسودِ",10,"د",1,0],["شَيخانِ قَد خَبَرا الوُجودَ وَأَدرَكا","ما فيهِ مِن عِلَلٍ وَمِن أَسبابِ",11,"ب",1,1],["شَياطينُ إِنسٍ تَسرِقُ السَمعَ خِلسَةً","وَلا تَحذَرَ المَخبوءَ لِلمُتَسَمِّعِ",12,"ع",1,0],["شِيَمٌ هِيَ الزَهرُ الجَنِيُّ تَبَسَّمَت","عَنهُ الكَمائِمُ في الضَحاءِ الماتِعِ",13,"ع",1,0],["شِيَمٌ يُنافِسُ حُسنَها إِحسانُها","كَالراحِ نافَسَ طَعمَها الجِريالُ",14,"ل",1,0],["شَيحانُ مُنغَمِسُ السِنانِ مِنَ العِدا","في النَقعِ حَيثُ تَغَلغَلُ الأَحقادُ",15,"د",1,0],["شَيَّدَهَا إِلياسُ داراً وَمَا","أَسعَدَهَا داراً بِأَهْلِيهَا",16,"ي",3,1],["شِيَمُ الْكِنَانَةِ فِي السَّمَا","حَةِ قَدْ بَرَزْنَ مِنِ اكْتِنَانِ",17,"ن",1,0],["شُيُوخُهُمْ وَعَذَارَاهُمْ وَصِبْيَتُهُمُ","ذَاقُوا جَمِيعاً فِطَامَ القَهْرِ وَاليَتَمَا",18,"م",2,0],["شَيَّعَتْهُ البِلادُ وَالحُزْنُ غَلاَّ","بٌ عَلَى الصَّبْرِ فِي الدمُوعِ السِّجَامِ",19,"م",1,0],["شِئْتَ الْتِئَامَ شِعَابِهَا وَلَمَا","تَبْغِيهِ سِرٌّ غَيْرُ مُكْتَتِمِ",20,"م",1,0],["شَيْخَ العُرُوبَةِ أَيْنَ صَائِنُ إِرْثِهَا","وَمُعِيدُ نَضْرَةِ عَهْدِهَا المُتَقَادِمِ",21,"م",1,0],["شِيَمٌ حِينَ صُوِّرَتْ مِنْ نُضَارِ","الحَزْمِ وَالعَزْمِ صُوِّرَتْ لِدَوَامِ",22,"م",1,0],["شَيبُ الرِجالِ لَهُم زَينُ وَمَكرُمَةٌ","وَشَيبُكُنَّ لَكُنَّ العارُ فَاِكتَئِبي",23,"ب",2,0],["شِيَمٌ يُقرُّ الحاسدون بفضلها","والصبح ليس ضياؤُهُ بمكتّمِ",24,"م",1,0],["شيّده للعلوم مدرسة","من كان نشر العلوم من دَأَبه",25,"ب",2,0],["شَياطينُ البِلادِ يَخَفنَ زَأري","وَحَيَّةُ أَريَحاءَ لي اِستَجابا",26,"ب",2,0],["شَيخوخَةٌ سَبَقَت لافَضلَ يَتبَعُها","وَلَيسَ يَفضُلُ فينا الفاضِلُ الهَرِمُ",27,"م",1,0],["شِيَمٌ عُرِفتُ بِهِنَّ مُذ أَنا يافِعٌ","وَلَقَد عَرَفتُ بِمِثلِها أَسلافي",28,"ي",1,0],["شيبت موارِد عيسى","والشِّعر والشَّعر شابا",29,"ب",2,0],["شيخ إسلامِ الورَى دُم للورى","وابنك المحبوب في الوصفِ نبي",30,"ي",1,1],["شيخ إقراء حديث السنِّ يا","حبَّذا الآن بُنيٌّ وأبي",30,"ي",1,0],["شيخ النقا والهنا بهاه","رونقه دائماً جديد",31,"د",1,1],["شيدت ما يبقى ويسري ذكره","في الأرض فاعجب للمقيم السائر",32,"ر",1,0],["شيمٌ زكت من أولٍ","وسعادة لحظت حجر",33,"ر",1,0],["شيبت حياتي ثم شابت لمتي","في غير ذخرٍ للمعاد مجمّع",34,"ع",1,0],["شيمٌ عن السلف الذكيّ ورثتها","لا في الصبى عِيبتْ عليّ ولا في",35,"ف",2,0],["شيخ الشيوخ طريقاً أو مباحثةً","وصاحب الستر من شغلٍ ومن صدقه",36,"ق",2,0],["شيدت بإسماعيل أركان العلى","فإليه يلتجئ الرجاء ويركن",37,"ن",1,0],["شيخ الشيوخ إمامها وبليغها","في عنفوان شبيبة الشيبان",38,"ن",1,0],["شَيءٌ بِقَلبي وَفيهِ مِنكَ أَسماءُ","لا النورُ يُدري بِهِ كلا وَلا الظُلَمُ",39,"م",1,1],["شيخٌ إذا حَدَثٌ أها","نَ مَشيبَهُ فدَّى شبابهْ",40,"ب",2,0],["شيعةٌ للضلال ذاتُ نقيبٍ","قُبِّحت شيعةً وخابَ نَقيبا",41,"ب",2,0],["شَيَّدَتْ أسْلافُهُ بنْيانه","فوْقَ نَجْدٍ لا تُضاهيه النُّجُودُ",42,"د",1,0],["شيخٌ لنا من آل مسعودِ","من أحذق الأمة بالعُودِ",43,"د",1,1],["شَيّبَني من هواهُ ما نَهك ال","جسمَ فماذا ترونَهُ نَكِره",44,"ر",2,0],["شيّد الملكُ به بنيانَهُ","بعدما كان رسوماً داثره",45,"ر",2,0],["شيخ له في حرِها ضرّةٌ","ومالها في أيره ضرَّهْ",46,"ر",2,0],["شيخ يراود مثله وكلاهما","قد زحزح السبعين عنه بنيِّف",47,"ف",1,0],["شئزَ المقيلَ بحيث عبدُك ضاحياً","فامهدْ لعبدك في ذَراك مقيلا",48,"ل",2,0],["شيخ يُناكُ عِيالُهُ","وكأنّهُ تَيْسٌ أحَمُّ",49,"م",1,0],["شيخ لنا في مستوى رأسِهِ","بستان صدق من بساتينه",50,"ن",2,0],["شيخٌ إذا عَلَّمَ الصِّبيان أفزعهم","كأنه أمُّ صبيانٍ وغيلان",51,"ن",1,0],["شَيَمُ الكِرامِ قَصائِدٌ في الكَونِ غِر","رٌ وَهيَ في شِيَمِ الكِرامِ مَعانِ",52,"ن",1,0],["شيمَتي شيمَتي وَخُ