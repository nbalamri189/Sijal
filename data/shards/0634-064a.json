ٌ","ومن يردّ الجوابا",195,"ب",2,0],["شيخ القريض أبا الرصي","ن الجزل والمرح اللعوب",196,"ب",1,0],["شيخ على جرج الشباب كأنه","لجمَ الزمانَ فكان حيثُ أرادا",197,"د",2,0],["شَيَّعَت نَعشَكَ المَلائِكُ وَالنا","سُ وَقَد زاحَمَ الكِرامُ الكِرامُ",198,"م",1,0],["شَيّدتَ داراً للقَضاءِ فأصْبَحَتْ","للدّينِ والأخْلاقِ خيرَ عِماد",199,"د",1,0],["شيخٌ يحس الشيخ عند نسيبه","بدم الشباب يسيل في شريانه",200,"ن",2,0],["شَيَّعَ الدَّمْعُ يَوْمَ شَيَّعَ صَبْرِي","دَوْلَةً فَخْمَةً وَعَصْراً حَفِيلا",201,"ل",2,0],["شيئان مَا عيبَ البكاءُ عليهما","فقدُ الشباب وفرقَةُ الأُلافِ",202,"ف",1,0],["شيِخَةَ الدارِ أنْتُمُ خَدَمُ الفُصْحَى","وحُرَّاسُ ذلكَ البُنْيانِ",203,"ن",1,0],["شيعته ورجعت أقرع بابه","بيدي، أقول: لعله في الدار",204,"ر",1,0],["شيخَ الإمارات، صقرٌ أنت تعرفهُ","وأنت -يوم نَفَوْه- تعرف السببا",205,"ب",2,0],["شِيبَ آذيُّهُ؛ فكان عقيقًا","وصفا؛ فهْو ذوبُ حبِّ الجُمان",206,"ن",1,0],["شيَّع الفجرَ لعمري باسمًا","والضحى في رأده من شَيَّعَه؟",207,"ع",2,0],["شيخَ الكلاب، أخفت ذئ","بَ الأنس، لا ذئب الفلاة",208,"ا",2,0],["شيَّبت ناصية القرون ولم تزل","طفلاً، تُطالعنا بوجهٍ أمرَد",209,"د",1,0],["شيبة قد تركنا في رجال","ذوى حسب ، إذا نسبوا ، نسيب",210,"ب",1,0],["شيكفي ابنتاي المجد، سعد بن حشرج،","أحمل عنكم كل ما حل من أزلي",211,"ل",2,0],["شيع تموج تزاخماً حتى اذا","نزل البلاءُ تضامَنَتْ لبقائك",212,"ك",1,0],["شيئانِ ما مثلهما لذةً","في السمع ذكراك وذكرُ الصِّبا",213,"ب",2,0],["شيئانِ تفتقرُ البلادُ إليهما","خِصبُ الرجال بها وخِصْبُ ربيع",214,"ع",1,0],["شيخوخةٌ ما كان أحوجَها إلى","شملٍ تُسَرُّ بقربِهِ مجموع",215,"ع",1,0],["شَيِمٌ أنافَ تليدُها لطريفها","فسما بها بتليده وطريفه",216,"ف",2,0],["شيئانِ ، يُرْفَع قدرُ المرء ما ارتفعا","نظمٌ لدى الشعر أو مأثورة الخطب",217,"ب",1,0],["شِيدتْ قصورٌ على الأجراف جاهزةٌ","بكلِّ ما تشتهيهِ أعينُ الرائي",218,"ا",2,0],["شَيِب بالمسك وبالشهد معا","ً والمساويك على ذلك شهود",219,"د",1,0],["شيهة الشّرق º انعمي واسلمي","كي تسلم الآمال والآمل",220,"ل",1,0],["شئمت لذاذات الحياة جميعها","ولو رضيت هند سئمت شبابيا",221,"ي",2,0],["شيء ، يوم الرّوع ، أجمل عنده","من أن يرى والقرن يصطرعان",222,"ن",1,0],["شيعوه الى التراب فاشجى","كل ذي قلب ذل التشييع",223,"ع",1,0],["شَئِزٌ جَنبي كَأَنّي مُهدَأٌ","جَعَلَ القَينُ عَلى الدَفِّ الأَبَر",224,"ر",1,0],["شَيَّعتُ أَحلامي بِقَلبٍ باكِ","وَلَمَمتُ مِن طُرُقِ المِلاحِ شِباكي",225,"ك",2,1]]}