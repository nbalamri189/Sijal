{"poems":[[53,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[56,"بغدادُ دارَ الملوكِ كانتْ","https://www.poetsgate.com/ViewPoem.aspx?id=14516",""],[119,"سرت بنا للحب زهر النياق","https://www.aldiwan.net/poem40871.html","عموديه"],[203,"ما لك عند الحبيب عذر","https://www.aldiwan.net/poem45597.html","مخلع البسيط"],[358,"يا سميري في السرى عرجا بي","https://www.aldiwan.net/poem40822.html","الخفيف"],[376,"وحديثي مع الحوادث أني","https://www.aldiwan.net/poem56981.html","الخفيف"],[408,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[409,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[458,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[458,"ما شكاتي من الأنام عداء","https://www.aldiwan.net/poem61578.html","الخفيف"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[572,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63870","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127969","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204636","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87405","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131220",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86470","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33608","البسيط"],[5186,"إن ربع الأحرار ربع مصون","https://www.poetsgate.com/ViewPoem.aspx?id=156471",""],[5587,"قَلْبِي عَلِيلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190229",""],[5939,"لم يكن للورد ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=178580",""],[6355,"مناجاة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66603&r=&rc=63",""]],"verses":[["ليس سماء الله منحطة","وإن تدانت حين تستمطر",0,"ر",1,0],["ليس سواءً كلّها العوان","لا يستوي الدفاع والعدوان",1,"ن",1,0],["ليسَ سُرورٌ بُسُرَّ مْنْ را","بَلْ هي بُؤْسٌ لِمنْ يَراها",2,"ا",3,0],["ليس سوى شخصك في مهجتي","من فوق عرش اللب والسر راق",3,"ق",1,0],["ليسَ سوى الحبُّ من جنونٍ","وليسَ غير العيونِ سحرُ",4,"ر",1,0],["لَيسَ سيّان ذاكَ ملحٌ أجاج","وَهوَ عَذب الوُرود غَير عذابِ",5,"ب",1,0],["ليسَ سَيفُ النَّدى بنابٍ ولا","ركنُ المَعالي الذي بَنَيتَ بِواهِ",6,"ه",1,0],["ليسَ سِوَى طَيبةٍ تفوقكِ في","الفَضْلِ فتيهي مَا شِئت واحتْكمِي",7,"م",2,0],["ليس سوى الخميس","خصوه للنفوس",8,"س",1,0],["ليس سخطي ولوعتي","ليس دمعي الذي انهمر",9,"ر",1,0],["ليس سخري بعالم","في غباواته انتصر",9,"ر",1,0],["ليس سخطي سوى تشوق وج","داني لإصلاحهم وإيثار حسي",10,"س",2,0],["ليس سوى نفحِة الصَّبا لك أو","لمحةِ برقٍ بالغور مبتسمِ",11,"م",1,0],["ليس سِوَى الدَّمْعِ والإناءُ بِمَا","يكونُ فِيْهِ لابُدّ راشِحُهْ",12,"ح",2,0],["ليس سوى ذا وذاك إلا","صفراءُ عذراءُ خَنْدَريس",13,"س",1,0],["ليس سكرى منها غدا بل من الاعين","لما ترنو ورشف الريق",14,"ق",1,0],["ليس سوريا ومصر والعراق","أو سواها من حسا أو عدن",15,"ن",1,0],["لَيسَ سوى الطرف فيهِ حتىّ","يحلُّ عن شبهة ارتيابِ",16,"ب",1,0],["ليس سكراً أو غراماً ما بها","فهي عن مثلهما في شغل",17,"ل",1,0],["ليس سوى حبك في قلبه","مغلغلاً ما بين أطباقه",18,"ق",2,0],["ليسَ سرورٌ ولا ابتهاجٌ","يا أملي حيثُ لا تكونُ",19,"ن",1,0],["ليس سيين ناهض وخمول","ليس سيين من عصى وأطاعا",20,"ع",2,0],["لَيْسَ سِرًّا مَا عَرَّفَ الدَّمْعُ فِيهِ","مِنْ عُيُونٍ تَبْكِي النُّجُومَ ظَلَامَا",21,"م",2,0],["ليسَ سجنًا مُوحشًا أنْ تَسكُنيني باختيارِكْ","ليسَ موتًا مُؤلمًا إنْ تاقَ صدري لاعتصارِكْ",22,"ك",1,0],["ليس سودُ الوجوهِ بالخِزيِ أهلي","أمَّتي أكرمُ الأنامِ جباها",23,"ا",3,0]]}