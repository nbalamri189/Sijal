{"poems":[[62,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[87,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[51,"إسمع إلى الأحكام تحملها","https://www.aldiwan.net/poem64259.html","مجزوء الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"الصبر يوجد إن باء له كسرت","https://www.aldiwan.net/poem22394.html","البسيط"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[136,"دمن الأحبة لو عصيت العاذلا","https://www.aldiwan.net/poem54777.html","الكامل"],[136,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[164,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[266,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[463,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[556,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[556,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122662","البسيط"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/112999","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119355","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64532","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49918","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108650","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123303","الرمل"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123744","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130780",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85080","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85257","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101378","الكامل"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4755,"غَفوةٌ على سَرير البَرزَخ","https://www.poetsgate.com/ViewPoem.aspx?id=215432",""],[4767,"جِنان الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=213975",""],[4858,"أريج مدرسة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=34591",""],[4918,"عطني قربك بالحلال","https://www.poetsgate.com/ViewPoem.aspx?id=32378",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5401,"من هيرتز الموجات","https://www.poetsgate.com/ViewPoem.aspx?id=85370",""],[5461,"أسابق الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=497",""],[5691,"جوهر الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=206131",""],[5756,"الليالي السرمدية","https://www.poetsgate.com/ViewPoem.aspx?id=5438",""],[6068,"حيّ الخريدة حبّة الايناس -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175898",""],[6229,"الوطن المفدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65170&r=&rc=4",""],[463,"أهفو لعلويَّ الرياح إذا جرتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59997&r=&rc=53",""],[463,"في كلّ دارٍ عدوٌ لي أقاذعهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60140&r=&rc=196",""]],"verses":[["وَالمَهرُ يُعطِي الفَتى مِن حَيثُ يَمنَعُهُ","إِرثاً وَيَمنَعُهُ مِن حَيثِ يُطمِعُهُ",0,"ع",2,0],["والمةت حق في البرية قاهر","عجبي لحق قام باستبداد",1,"د",1,0],["والَم هُديتَ بِأَنَّها","حُجَجٌ تَكونُ عَلَيكَ مِنكا",2,"ك",2,0],["والمُهَدِّي يَوْمَ السَّقِيفَةِ لَما","أرْجَفَ الناسُ أنه الدَّأْدَاءُ",3,"ا",2,0],["وَالمَهرُ يَعطيهِ أُنثى غَيرَ مُنصِفَةٍ","سَيبٌ مِنَ اللَهِ وَالمَهرِيَّةُ القودُ",4,"د",1,0],["والمَهاةَ الخَذُولَ أُمَّ الطَّلاَ والر","رَشَأَ الشَّادِنَ الأَغنَّ الرَّخِيمَا",5,"م",2,0],["والمُهدِىَ الغَاوي بِجِذوَةِ سِرِّهِ","وبِجَذبِهِ لِلحَضرَةِ المُتَكَاسِلا",6,"ل",2,0],["والمَهَاةِ الخَذُولِ والفَنَنِ الغَضضِ","وشَوكِ السَّيَاكِ والأَسرُوعِ",7,"ع",1,0],["والمهر مهر المثل سقه لمن","تشيب وقت الشيب والمهرمه",8,"م",2,0],["والمهاب الذي يروع أعاديه","بمقدار ما يروق وداده",9,"د",2,0],["وَالمهتدونَ إِلى الصراط تتبّعوا","سُبلاً بنيّاتٍ لهم فتوزّعوا",10,"ع",3,0],["والمهرجانُ بأن تُرعى وسائلُهُ","منها جديرٌ وأن تزكو ذَرائعُهُ",11,"ع",2,0],["والمهرجان وعيد الفطر قد وَلِيَا","زفافَها بين صَوَّاغٍ وعطَّارِ",12,"ر",1,0],["والمهرجان وكلّ يومٍ عادكم","في لطفه مما كستْ أو زَخرفتْ",13,"ت",1,0],["والمهر سيف بمتنه ربد","والقضب ما لم يقف على فلل",14,"ل",1,0],["والمِهْرَجانُ زمانٌ بالسّعودِ وبالن","نُجحِ القريب إليك الدّهرَ عجلانُ",15,"ن",1,0],["والمِهْرَجانُ مُخبرٌ","أنّ لك العُمرَ الأَتَمْ",16,"م",1,0],["والمَهمَه القَفرُ والبَيداءُ تَعرِفُني","واللَّيلُ والعِيسُ والأكوارُ والنُّسَعُ",17,"ع",1,0],["والمهتدي الصالحُ الميمونُ مقتُلُه","من بعدِ عامِ وقَفّى قَبلَهُ عمرا",18,"ر",2,0],["والمهر إن يضمن أبو","ه فعليه حسبا",19,"ب",2,0],["والمهرمه عن طلبه زاهداً","لتتقي المسقم والمهرمه",20,"ه",1,1],["والمهني أن أنصب الوجه عانياً","لوجهك ربي في رجائي وخيفتي",21,"ت",2,0],["والمهتدِي بدليلٍ من خَلآئقه","طُرق الشَجَاعة والمعروف والأدبِ",22,"ب",1,0],["والمهاة التي بتلك المغاني","خلتها حين غردت شحرورا",23,"ر",2,0],["والمهجور في أشواق","قد أضنته بالإحراق",24,"ق",1,0],["والمهرُ منك جوابُها","وكَفاهُ فخراً من يُجيبُه",25,"ب",2,0],["وآلمه الجوع المميت وراعه","فراغٌ من الافوات فانهدَّ من هول",26,"ل",1,0],["والمهجم الاعلى زبيد وحاجر","مخلافها الجندوح في العندية",27,"ه",1,0],["وَالمُهتَدون بِما جاءَ البَشير به","مستمسكون بحبل غير منفصم",28,"م",1,0],["والمهدويّ البحر ذي الفضل الجلي","والدامغاني والقشيرى الولي",29,"ي",1,0],["والمهر منك قبولها","لازلت في روض السرور",30,"ر",1,0],["والمهتدي بعده المعتز معتمد","وأحمد المعتضد باللَه قد خلفا",31,"ف",2,0],["والمهد بالابريز تبرق أرضه","ذهباً جرى في كف غير بخيل",32,"ل",1,0],["والمهلين المهملين كأنهم","خلقوا من الامهال والاهمال",33,"ل",1,0],["والمهرُ صافي الأديم أضبعهُ","يطير عنه عفاؤهُ قزَعا",34,"ع",2,0],["والمُهطِعُونَ المُقنِعُونَ رُؤُوسَهُم","في سَكرَةِ الرَّمَقِ الأَخِيرِ هُجُوعُ",35,"ع",1,0],["والمُهرُ مهما استوعَرَ المُلتقَى","واستكثر الجَهدَ به ما كبا",36,"ب",2,0],["والمهتدي عشق المعارفَ ،وهو بالطّلاب أحرى","يا أيّها الطّلابُ ،ذقْنا فيكُمُ حُلْواً ومُرّا",37,"ر",2,0],["والمهر لا هو بهمي لو دفع جيبك ريال","كافي انك مشتريني وكافي اني مشتريك",38,"ك",1,0],["والمهر للحسناء ما قدرته","مهرا فمليونان أو ألفان",39,"ن",1,0],["والمهري اللي يحمل البقشه وفالشارع يصيح","الله يغنينا عن البايع وسوء بضاعته",40,"ت",2,0],["والمهتوي لا اهتوى ما يطوي شراعه","يمشي على النار كنه ما وطى فيها",41,"ي",3,0],["والمَهاراتُ خالِصُ الصِّدْقِ والحِسُّ","وخلْقُ الإبْداعِ دونَ اصْطِناعِ",42,"ع",1,0],["والمهابه ماتهادت غير لنفوسٍ رديه","ليت في قلب الليالي للفتى قدر ومهابه",43,"ب",2,0],["والمهلكات إذا جفوْنَ مُهيْجتي","والقلب منك مضرّج بالياس",44,"س",1,0],["والمهى للمروج والأرضِ للغَيْ","ثِ إذا أمحلتْ وماج القَتام",45,"م",1,0],["والمهرجان وكلّ يومٍ عاكم","في لطفه مما كستْ أو زخرفتْ",46,"ت",1,0],["والمهرجانُ بأنْ ترعى وسائلهُ","منها جديرٌ وأنْ تزكى ذرائعهُ",47,"ع",2,0]]}