//www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"صورة للخواطر!","https://www.poetsgate.com/ViewPoem.aspx?id=179131",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[45,"إِنَّ ألأَميرَ أَبا عَليٍّ أَصْبحَت","https://www.poetsgate.com/ViewPoem.aspx?id=32112",""],[45,"بعَيْنَيْكِ إعْوَالي وَطُولُ شَهيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32169",""],[45,"كُنتُ إلى وَصْلِ سُعدى جِدَّ محْتَاجِ","https://www.poetsgate.com/ViewPoem.aspx?id=33104",""],[45,"لَقَدْ أمْسَكَ الله الخلافَةَ بَعدَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=31140",""],[28,"إذا مسمع أعطتك يوما يمينه","https://www.poetsgate.com/ViewPoem.aspx?id=22094",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[39,"لِمَنْ دِيَارٌ بهذا الجِزْعِ مِنْ رَبَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=4232",""],[78,"وعدتَ وأَخلفتني الموعدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86620&r=&rc=115",""],[105,"لبيك من حر المواقف عال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55000&r=&rc=170",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[85,"أَهلَ القُدودِ التي صالت عَوَاليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9579&r=&rc=69",""]],"verses":[["شَمسٌ أُقَبِّلُ جيدَها","يَومَ النَوى وَأُجِلُّ فاها",0,"ا",3,0],["شَمَّروا يَطلُبونَ ناشِئَةَ الصَو","تِ خَناذيذَ كَالقَنيِّ اللَدانِ",1,"ن",1,0],["شَمَختَ عَلَيَّ بِأَنفٍ رَأَي","تُ مَعطِسَهُ دامِياً مِن زِمامي",2,"م",2,0],["شَمَّهُ رِئبالُ غابٍ","أَوَّلُ الفَرسِ شِمامُ",3,"م",1,0],["شَمَّروا يَطلُبونَ ناشِئَةَ الصَو","تِ خَناذيذَ كَالجُذوعِ الطِوالِ",4,"ل",1,0],["شِمالُ المالِ تَعلو عَن يَميني","وَيُمنى المَجدِ تَقصُرُ عَن شِمالي",5,"ي",1,0],["شُموسُ قِبابٍ قَد رَأَينا شُروقَها","فَيا لَيتَ شِعري أَينَ مِنّا أُفولُها",6,"ل",3,0],["شَمَخوا أَن حَلَّقَ الجَدُّ بِهِم","غَلِطَ الدَهرُ وَكَم يَبقى الغَلَط",7,"ط",1,0],["شَماطيطَ يُجرونَ الحَديدَ كَأَنَّما","مَشَينَ عَلى مَوجٍ مِنَ اليَمِّ زاخِرِ",8,"ر",1,0],["شَمِّري أَيُّها الرِكابُ وَخَلّي","عَطَنَ اللُؤمِ وَالعِمادَ القِصارا",9,"ر",2,0],["شَمَمتُ بِنَجدٍ شيحَةً حاجِرِيَّةً","فَأَمطَرتُها دَمعي وَأَفرَشتُها خَدّي",10,"ي",1,0],["شَمِّر ذُوَيلَكَ وَاِركَبها مُذَكَّرَةً","وَاِطلُب عَنِ الوَطَنِ المَذمومِ مُنتَدَحا",11,"ح",2,0],["شِمِذ السَيفَ فَقَد قوتِ","لَ أَعداؤُكَ بِالرُعبِ",12,"ب",1,0],["شِمْهُ عَنّي ما اِستَطَعتَ فَلِي","ناظِرٌ بالدَّمعِ مَشغولٌ",13,"ل",1,0],["شُمُّ العَرانينِ لا تَدْمى أنوفُهُمُ","عندَ اللّقاءِ ولا تَعْرى منَ الأنَفِ",14,"ف",1,0],["شَمالٌ كتَرْنيقِ النُّعاسِ ومُقْلَةٌ","بِها اقْتَنَصَ الأُسْدَ الضّراغِمَ ريمُ",15,"م",1,0],["شمّاءُ تَلعَبُ بالعُيونِ وتَرتَدي","هَضَباتُها حُلَلَ السَّحابِ الأقمَرِ",16,"ر",1,0],["شَمسٌ إِذا طَلَعَت سَجَدتُ جَلالَةً","لِجَمالِها وَجَلا الظَلامَ طُلوعُها",17,"ع",3,0],["شَمسٌ مُمَثَّلَةٌ في خَلقِ جارِيَةٍ","كَأَنَّما كَشحُها طَيُّ الطَواميرِ",18,"ر",1,0],["شَمَائِلُ مَيْمُونِ النَّقِيبَةِ أَرْوَعٌ","لَهُ قَصَبَات السَّبْقِ فِي كُلِّ مَيْدَانِ",19,"ن",1,0],["شَمَلً الْبِلاَدَ وَأَهْلَهَا تَأَمِينُهُ","وَهَمَى عَلَيْهِمْ بِالنَّدَى تَأَمِيلُهُ",20,"ل",2,0],["شُموساً كُلّما غَرَبَتْ ولاحَتْ","على الأفْواهِ تطلُعُ في الخُدودِ",21,"د",1,0],["شِمْتُ المُنى وحَمِدْتُ إدْلاجَ السُّرَى","وزَجَرْتُ للآمالِ كُلَّ سَنيحِ",22,"ح",1,0],["شَمَلَ الرِّضَى فَكَأَنَّ كُلِّ أَقَاحَةٍ","تُومِي بِثغْر لِلسَّلاَمِ شَنِيبِ",23,"ب",1,0],["شُمُّ العَرانينِ أَبطالٌ لَبوسُهُمُ","مِن نَسجِ داوُدَ في الهَيجا سَرابيلُ",24,"ل",1,0],["شَمائِلُكَ الغُرُّ هُنَّ الرِياضُ","رَوى عَن شَذاها نَسيمُ السَحَر",25,"ر",1,0],["شَمِّر وَكافِح في الحَياةِ فَهَذِهِ","دُنياكَ دارُ تَناحُرٍ وَكِفاحِ",26,"ح",1,0],["شَمِتوا كُلُّهُم وَلَيسَ مِنَ الهِم","مَةِ أَن يَشمَتَ الوَرى في طَريدِ",27,"د",1,0],["شَمسُ النَهارِ وَبَدرُهُ وَنُجومُهُ","أَبناؤُهُ مِن فَرقَدٍ وَسِماكِ",28,"ك",1,0],["شَمائِلُ تُهجَرُ عَنها الشَمولُ","وَتُجفى لَها مُشجِياتُ النَغَم",29,"م",1,0],["شَمسٌ تَوارَت في ظَلامِ مَضيعَةٍ","ثُمَّ اِستَطارَ لَها السَنا بِسَناكا",30,"ك",2,0],["شمائل العلياء فيكم","كابراً عن كابر",31,"ر",1,0],["شَمَائِلُ النُّبْلِ فِي كِيرلُّسَ اجْتَمَعَتْ","أشْتَاتُهَا بَيْنَ مُوْهُوبٍ وَمُكْتَسَبِ",32,"ب",1,0],["شمس الحمى زفت إلى بدر الحمى","وتتمه الكفؤين أن يتأهلا",33,"ل",2,0],["شملت به الأحزان شعباً حاشداً","لا فرق بين أكابر وأصاغر",34,"ر",1,0],["شَمَائِلُ الأُمِّ فِيكِ عَادَتْ","وَنُضْرُهُ الوَجْهِ وَالقَوَامُ",35,"م",1,0],["شَمْسٌ تَوَارَتْ بِحِجَابٍ فَيَا","لَلْغُبْنِ أَنْ تُمْسِيَ بَعْضَ الرَّغَامْ",36,"م",1,0],["شَمِلَ السَّعْدُ أَهْلَهَا وَكَفَتْهُمْ","مَا كَفَتْ أَصْفِيَاءهَا الأَيَّامُ",37,"م",1,0],["شُمُوخٌ بِلا مَعْنًى وَطَيْشٌ بِلا مَدًى","وَبَيْنَهَا أَمْصَارُنَا تَتَهَدَّمُ",38,"م",1,0],["شَمِلَ النَّوَاحِي فَهْيَ رَاوِيَةٌ بِمَا","تَلْقَاهُ مِنْ صَوْبِ النَّوَالِ الهامِي",39,"م",2,0],["شَمِلَ الثَّقَافَاتِ الرَّفِيعَةَ وَانْتَحَى","أَرْقَ مَنَاحِيهَا مِنَ الإِحْكَامِ",39,"م",1,0],["شمائلُ لو أن الرياضَ بحسنها","لما صّار فيها زهرها الغضُّ ذاويا",40,"ي",2,0],["شمائلُ فيه من أبيه وجَدّه","ترى العزَّ فيها مستكناً وباديا",41,"ي",2,0],["شمائله مهما أديرت كؤوسُها","قلائدُ أسماع وأُنس قلوب",42,"ب",1,0],["شمس الخلافة قد أمدّت نوره","وبسعدها يرجو التمام ويكملُ",43,"ل",1,0],["شمع توقّد في زجاج أحمر","فغدا حواليه الفراش يدور",44,"ر",1,0],["شمّرت عن همم تعلو النجوم وقد","أمسى الزمان إليها متلع العنق",45,"ق",1,0],["شملت ريحك العقيم وقد كا","نت لقوحاً تهبّ فيك جنوبا",46,"ب",2,0],["شَمَخْت على رُبا القدس اعتلاءً","فكنت لهنّ من شرف وساما",47,"م",2,0],["شُمّاً مَساعِرَ لِلحُروبِ بِشُزَّبٍ","تَدمى شَكائِمُها مِنَ الإِلجامِ",48,"م",1,0],["شماطيط حيات وحينا تلفّها","كتاثب بالمستلبثين المكبكب",49,"ب",1,1],["شم مهاوين أبدان الجزور مخا","ميص العشيَّات لاخُور ولا قُزُمُ",50,"م",1,1],["شُموسٌ مَتى أَعطَتكَ طَوعاً زِمامَها","فَكُن لِلأَذى مِن عَقِّها مُتَرَقِّبا",51,"ب",2,0],["شملتنا جدواه والوقت جدب","فاستلانت ومعطف الدّهر آبي",52,"ب",2,0],["شمَّاء يرْكعُ نظمُ الناظمين لها","كأنما ألفاتُ الخطِّ دالات",53,"ت",1,0],["شمْ في العلى فضله والجود جعفره","والنسك عمَّاره والعزم عامره",54,"ر",2,0],["شمسٌ ينادى ذكره سرّ ويا","طرف الأعادي خاسئاً فارْجعي",55,"ع",2,0],["شم فضله واللفظ وانْظر إلى","صوبِ الغوادِي والحمى الممرع",55,"ع",1,0],["شمس هدىً لا تزال منه","تظهر في طالع جميل",56,"ل",1,0],["شمه تجد حاجباً من نور طلعته","لكنه لم يزل بالنجحِ مقرونا",57,"ن",2,0],["شمْ نداه وذهنه الصفو واحْذر","من عوادِي الطوفان والنيران",58,"ن",1,0],["شمس عليا عمَّت منافعها الخ","لق قريباً من الورَى وقصيّا",59,"ي",2,0],["شم حدّه يوم الندَى والبأس","فإنَّه ماضٍ بغير لبس",60,"س",1,0],["شمسٌ وبدر يشفيان ذوي العمى","وهما سراجا أعينِ البُصراءِ",61,"ر",3,0],["شمسٌ تساترنا وقد بعثت","ضوءاً يُلاحظنا بلا لهبِ",62,"ب",1,0],["شملَ التنوفَةَ فائحٌ من نشره","قطعَ الفضاءَ إلى الأُنوف مَفَاحُه",63,"ح",2,0],["شمسُ دَجْنٍ كِلا المنيرَيْن من شم","سٍ وبدْرٍ من نُورها يستفيدُ",64,"د",1,0],["شمسٌ يحف يمينها وشمالها","بدرُ السماء ومشتريها الأزهَر",65,"ر",1,0],["شمسٌ من الحسن في مُعَصفرةٍ","ضاهتْ بلونٍ لها مُعصفرها",66,"ر",3,0],["شمطاءُ تزني وخَرقُ مَنخِرها","مُعشِّشٌ فيه ألفُ خُفَّاش",67,"ش",1,0],["شمِّري نحو العطاءِ المُنتَجَعْ","واستدلِّي بالثناء المستمَعْ",68,"ع",1,1],["شمَّر للقوت وهو من ذهب","عزاً وللنقد وهو من خزف",69,"ف",1,0],["شم بروق الحسن الأح","سن أخلاقاً وخلقا",70,"ق",2,0],["شمسُ دَجْنٍ ومشتَرٍ غيرِ منحو","سٍ وبدرٌ متمَّمٌ وهلالُ",71,"ل",1,0],["شمَّرْتَ نحوَ عدوِّهم","وكأنّك السِّمعُ الأزلُّ",72,"ل",1,0],["شمَّروا في الوغى وذُلِّل يعقو","بُ وألوى التشميرُ بالزلزالِ",73,"ل",1,0],["شمسٌ كأنْ قد تجلّتْ","تجوب كلَّ ظلامِ",74,"م",1,0],["شِمْ بعدَها عن عليٍّ","نَبْلَ الردى والغرامِ",74,"م",1,0],["شمسُ الضُّحى زُفَّتْ إلى بدرِ الدُّجى","فتكشَّفتْ بهما عن الدنيا الظُّلمْ",75,"م",1,0],["شملَ الناسَ عدلُ أُمِّك حتى","سارَ فيهم كَسيْر جورِ سدُومِ",76,"م",1,0],["شمسٌ أظلَّتْ بليلٍ لا نجومَ لهُ","إلا نجومٌ لها في النَّحرِ أثمان",77,"ن",1,0],["شمسٌ مكوَّنةٌ في خَلْق جاريةٍ","باتتْ تدير بعيدِ الدِّنح قُربانا",78,"ن",2,1],["شُمسُ العَداوَةِ حَتّى يُستَقادَ لَهُم","وَأَعظَمُ الناسِ أَحلاماً إِذا قَدَروا",79,"ر",3,0],["شَمسانَ لَولا أَنَّ بَينَهُما","صِلَةٌ لَمّا بَكَتا مِنَ الهَجرِ",80,"ر",1,0],["شَمطاءَ إِلّا أَنَّها مَحجوبَةٌ","عَذراءُ إِلّا أَنَّها لا تُمنَعُ",81,"ع",1,0],["شَمعَتي فيها لِطُلّابِ اليَقين","أَيَةٌ تَدفَعُ عَنهُم كُلَّ غَي",82,"ي",1,0],["شَمسُ حُسنٍ لَهُ مِنَ ال","شَعرِ ظِلٌّ لَهُ وَفِيَّ",83,"ي",1,0],["شَمسَ الزَمانُ فَما يَلينُ وَرُبَّما","أَخَذَ الصَبِيُّ عِنانَهُ يَتَلَعَّبُ",84,"ب",1,0],["شَمِّر إِزارَكَ إِن نُدِبتَ لِنَصرِها","إِنَّ الكَريمَ لِمِثلِ ذَلِكَ يُندَبُ",84,"ب",1,0],["شُمَّ الكَواهِلِ جُنَّحاً أَعضادُها","صُهباً تُناسِبُ شَدقَماً وَجَديلا",85,"ل",2,0],["شَمائِلُ تَنثرُ شَملَ الهُمو","م نثرَكَ بِالرأي شملَ العِدى",86,"د",2,0],["شمس إذا طلعت عليَّ أواختفت","عن مقلتي تبدو كواكب أدمعي",87,"ي",1,0],["شموس قد أضاء الجوُّ منها","وزال بها عن الكون العماءُ",88,"ا",2,0],["شماء قاهرة فوق المياه فلا","تجرى وتذهب إلا ما توليها",89,"ي",3,0],["شمس النهار وأختها","في الأرض منها مستظلة",90,"ل",2,1],["شَمشونُ أَنتَ وَقَد رَسَت أَركانُها","فَتَمَشَّ في أَركانِها لِتَزولا",91,"ل",2,0],["شُمُّ الجِبالِ إِذا طاوَلتَها اِنخَفَضَت","وَالأَنجُمُ الزُهرُ ما واسَمتَها تَسِمِ",92,"م",1,0],["شَمسَ النَهارِ تَعَلَّمي الميزانَ مِن","سَعدِ الدِيارِ وَشَيخِها النَضّاحِ",93,"ح",1,0],["شَمسُ المَحاسِنِ يُستَبقى النَهارُ بِها","كَأَنَّ يوشَعَ مَفتونٌ يُجاريها",94,"ي",3,0],["شَمّاءُ في عَرضِ الخِضَمِّ كَأَنَّها","بُرجٌ بِذاتِ الرَجعِ لَيسَ يُرامُ",95,"م",1,0],["شَملُ اللُغاتِ لَدى الأَقوامِ مُلتَئِمٌ","وَالضادُ فينا بِشَملٍ غَيرِ مُلتَئِمِ",96,"م",1,0],["شَمَائِلُ إِنْ يَشْهَدْ فَهُنَّ مَشَاهِدٌ","عِظَامٌ وإِنْ يَرْحَلْ فَهُنَّ كَتَائِبُ",97,"ب",1,0],["شِمنا وَما حُجِبَ السَماءُ بُروقَهُ","وَحَرىً يَجودُ وَما مَرَتهُ الريحُ",98,"ح",1,0],["شَمسُ ضُحاها هِلالُ لَيلَتِها","دُرُّ تَقاصيرِها زَبَرجَدُها",99,"د",3,0],["شَمسٌ إِذا الشَمسُ لاقَتهُ عَلى فَرَسٍ","تَرَدَّدَ النورُ فيها مِن تَرَدُّدِهِ",100,"د",2,0],["شِم ما اِنتَضَيتَ فَقَد تَرَكتَ ذُبابَهُ","قِطَعاً وَقَد تَرَكَ العِبادَ جُذاذاً",101,"ذ",2,0],["شمسان يكتنفانها من فوقِها","شمسٌ وآخرُ تحتها مدجونُ",102,"ن",1,0],["شمائلُ مدلولٍ على طُرُقِ العُلَى","طلعْنَ على أفقِ المكارمِ أنجُمَا",103,"م",2,0],["شَمَّرَ الذَيلَ لِلمَحامِدِ حَتّى