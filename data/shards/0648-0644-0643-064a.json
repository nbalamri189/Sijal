{"poems":[[53,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24726","الكامل"],[102,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[92,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[236,"بين العقيق وبين سلع مربع","https://www.aldiwan.net/poem44569.html","الكامل"],[422,"شفيت بطرد صالح كل صدر","https://www.aldiwan.net/poem53900.html","الوافر"],[422,"وقفنا بربع المالكية وقفة","https://www.aldiwan.net/poem53905.html","الطويل"],[447,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51559","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145790","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56293","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144089","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116005","الكامل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102066","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48222","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53132","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58355","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87376","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100172","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216699","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94818","الكامل"],[4896,"نضال لا ينتهي","https://www.poetsgate.com/ViewPoem.aspx?id=180869",""],[5409,"علموا الميسر العروب وقالوا","https://www.poetsgate.com/ViewPoem.aspx?id=155317",""],[5493,"من وحيِ القرنفل","https://www.poetsgate.com/ViewPoem.aspx?id=197043",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5956,"المرأة غالباً أشرف من الرجل","https://www.poetsgate.com/ViewPoem.aspx?id=181897",""],[5956,"تتحدث الطرقات عن كلب الوفا","https://www.poetsgate.com/ViewPoem.aspx?id=193531",""],[5956,"أدواء بسرعة الأضواء","https://www.poetsgate.com/ViewPoem.aspx?id=202751",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[5975,"على نغم المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=58500",""]],"verses":[["ولكي ترى ثقتي بطَوْلك أو يرى","كيف احتمالك معشرٌ أوغادُ",0,"د",1,0],["ولكي تغنّيكَ الجَداولُ","لَحْنَها العَذْبَ الحَبيبْ",1,"ب",1,0],["ولكي تباينَ كلَّ مُنعم نعمةٍ","سلب الزمانُ وليَّهُ فأعانَهُ",2,"ن",2,0],["ولكي لا يقال، ندعو خؤونا","وطنيا، ونستخين الأمينا",3,"ن",2,0],["ولكي تنجبي البنين عظاماً","حان أن تأكلي أبرّ البنينا",3,"ن",2,0],["ولكي تُحسنوا سياسةَ شعبٍ","بَرهنوا أنّكم تسوسون دارا",4,"ر",2,0],["ولكيلا يرى مُسامحةً","يَعدِلُ منها لغيره ويُنيب",5,"ب",1,0],["ولكيف لا تجف الأضالع نحوها","شوقا وتذرف في هواها الأدمع",6,"ع",1,0],["ولك يتحمَّل الإِكرام حتَّى","رماه لؤمه في قعرِ بير",7,"ر",1,0],["ولك يكف هذا الوجد حتَّى استفزَّني","ونحنُ بسلع لهف نفسي على سلع",8,"ع",1,0],["ولكيف لي فيه الثنا واللَه قد","أثنى له بالفضل في آياته",9,"ت",2,0],["ولك يكتَسِب إلا لتسكُنَ وسَطه","مؤَنّثة لم تُكسَ قطُّ خِمارُ",10,"ر",1,0],["ولكي تُحَوِّلَنَا كِلابَ حِرَاسَةٍ","نُعْلِي النِبَاحَ ونَقتَفي الآثَارا",11,"ر",2,0],["ولكيف أنك قد شهرت بمدحه","بين الورى فاجهر بذاك وأجمل",12,"ل",1,0],["ولكي يذاع بأن عفوك غالبٌ","شري وإنك راحمي يا حاكمي",13,"م",2,0],["ولكيْفَ يُنصِفُك الحمامُ وربّما","جار الحميمُ عليك بالتّقريعِ",14,"ع",1,0],["وَلَكَيف يطرقُ طيفُكُم مَن لم ينم","إنّ الرُّقادَ على المحبِّ حَرامُ",15,"م",1,0],["وَلَكَيفَ لا يبكى وتَسهرُ عينُهُ","أسفاً ووَصلُ أرامَ ليس يُرامُ",15,"م",1,0],["ولكيف أنت حبيب ربي خالقي","وخديمه بالصدق داعي مهلكا",16,"ك",2,0],["ولَكَيْفَ يجنحُ للرذيلةِ شاعرُ ال","أزْديِّ سالمنا التقيِّ الزاكي",17,"ك",2,0],["ولكيف يخفى نائل أسديته","فَغَدَا من الشمس المنيرة أشهرا",18,"ر",2,0],["ولكيفَ أرضى بالحياة وَهمّتي","تسمو وَحَظِّي في الحضيضِ الأَوهدِ",19,"د",1,0],["وَلكي تميلَ اذا الرياحُ تناوَحَت","كَتَمايُل الباكي الاسيف العاني",20,"ن",2,0],["ولكيما تسترق العربا","بايعتها الروم تحت البيع",21,"ع",1,0],["ولكي يَظهَرَ الصفيُّ ويُبلى","قَمِنٌ ان يَهُزَّنا الغِربالُ",22,"ل",1,0],["ولكيميائك في الخسائس قدرة","يغدو الخسيس كأنما هو عسجد",23,"د",1,0],["ولكي متى شمَّيت طيبة عَرفهِ","فيشمَّ عني عارضيك بحيلةِ",24,"ه",1,0],["ولكى يجري بماء دافق","ونضير النبت في أربعنا",25,"ن",2,0],["ولكي تخلع الخفارة عنها","وتماشي الهوى سقوها المداما",26,"م",2,0],["ولكيْ يرَى أنَّ الجراحَ تسَلَّقَتْ","ظهرَ الغيابِ ولم تُعمِّر موسمَا",27,"م",2,0],["ولكيْ يُعاقَبَ لفَّقوا","جُرْماً بهِ قدْ ألْصَقوهْ",28,"ق",3,0],["ولكي تتأكدَ من رأيي اْس","تَخْفِ هنا وهناك وجُلْ",29,"ل",1,0],["ولكي تفوز من الهدايا فوق ما","فازت تقول: أيا كُليبة ذا كفى",30,"ف",2,0],["ولكي أحسَّ بأنني أديتُ ما","يدعو الضميرُ له من الإجْراءِ",31,"ا",2,0],["ولِكي أبرهنَ لليهودِ عَمالَتي","أغلقتُ بابَ وزارةِ الحربيَّةْ",32,"ي",2,0],["ولِكي أَفي يا سيِّداتي , سادَتي","ماتتْ لديَّ مَشاعري الوَطنيّةْ",32,"ي",2,0],["ولِكي أخبِّئَ ثَروَتي وجَواهري","خَوفاً بَنيتُ مَلاجئاً سرِّيَّةْ",32,"ي",2,0],["ولكيفَ أنساكم وأنتم مقلتي","وبكم أرى كلَّ الأماكنِ موطنا",33,"ن",2,0]]}