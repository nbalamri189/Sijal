{"poems":[[51,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24726","الكامل"],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[231,"بين العقيق وبين سلع مربع","https://www.aldiwan.net/poem44569.html","الكامل"],[416,"شفيت بطرد صالح كل صدر","https://www.aldiwan.net/poem53900.html","الوافر"],[416,"وقفنا بربع المالكية وقفة","https://www.aldiwan.net/poem53905.html","الطويل"],[441,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"]],"verses":[["ولكي ترى ثقتي بطَوْلك أو يرى","كيف احتمالك معشرٌ أوغادُ",0,"د",1,0],["ولكي تغنّيكَ الجَداولُ","لَحْنَها العَذْبَ الحَبيبْ",1,"ب",1,0],["ولكي تباينَ كلَّ مُنعم نعمةٍ","سلب الزمانُ وليَّهُ فأعانَهُ",2,"ن",2,0],["ولكي لا يقال، ندعو خؤونا","وطنيا، ونستخين الأمينا",3,"ن",2,0],["ولكي تنجبي البنين عظاماً","حان أن تأكلي أبرّ البنينا",3,"ن",2,0],["ولكي تُحسنوا سياسةَ شعبٍ","بَرهنوا أنّكم تسوسون دارا",4,"ر",2,0],["ولكيلا يرى مُسامحةً","يَعدِلُ منها لغيره ويُنيب",5,"ب",1,0],["ولكيف لا تجف الأضالع نحوها","شوقا وتذرف في هواها الأدمع",6,"ع",1,0],["ولك يتحمَّل الإِكرام حتَّى","رماه لؤمه في قعرِ بير",7,"ر",1,0],["ولك يكف هذا الوجد حتَّى استفزَّني","ونحنُ بسلع لهف نفسي على سلع",8,"ع",1,0],["ولكيف لي فيه الثنا واللَه قد","أثنى له بالفضل في آياته",9,"ت",2,0]]}