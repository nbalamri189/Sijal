4.html","البسيط"],[564,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[577,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[1054,"","https://poetry.dctabudhabi.ae/diwan/poem/142128","الكامل"]],"verses":[["أَسَفَّ بِمَن يَطيرُ إِلى المَعالي","وَطارَ بِمَن يُسِفُّ إِلى الدَنايا",0,"ا",3,0],["أَسَفُّهُمُ إِن مُيِّزَ القَومُ خِلَّةً","وَأَثقَبُهُم يَومَ الجِدالِ نِصالا",1,"ل",2,0],["أَسفَعُ إِلّا مَوضِعُ النِطاقِ","يُنزِلُ حَدَّ الصارِمِ الذَلّاقِ",2,"ق",1,0],["أَسفَرَت أَعطانُها عَن مَعشَرٍ","شَغَلوا المَجدَ بِهِم عَن أَن يُعارا",3,"ر",2,0],["أسَفَّ بِهمْ عِرْقٌ لَئيمٌ إِلى الخَنى","وكيفَ يَطيبُ الفَرْعُ والأصلُ يَخبُثُ",4,"ث",1,0],["أَسَفاً عَلَى الْخُلُقِ الْجَمِيلِ كَأَنَّمَا","بَدْرُ الدُّجُنَّةِ قَدْ جَلاَهُ تَمَامُ",5,"م",1,0],["أسفاً عَلَى الْعُمُرِ الْجَدِيدِ كَأَنَّهُ","زَهْرُ الْحَدِيقَةِ زَهْرُهُ بَسَّامُ",5,"م",1,0],["أَسَفاً عَلَى الْخُلُقِ الرَّضِيّ كَأَنَّهُ","زَهْرُ الرِّيَاضِ هَمى عَلَيْهِ غَمَامُ",5,"م",1,0],["أَسَفاً عَلَى الْوَجْهِ الَّذِي مَهْما بَدَا","طَاشَتْ لِنُورِ جَمَالِهِ الأَفْهَامُ",5,"م",1,0],["أسَفى كمْ أرى طَريدَ ذُنوبٍ","أو بَقَتْني فليْسَ لي مِنْ سَراحِ",6,"ح",1,0],["أسَفاً عَلَيْنا مَعْشَرَ الأمْواتِ لا","تنْفَكُّ عنْ شُغْلِ بِهاكَ وَهاتِ",7,"ت",1,0],["أَسَفِي عَلَى مَا ضَاعَ مِنْ حَظِّي بِهَا","لاَ تَنْقَضِي تَرْحَاتُهُ ونَحِيبِي",8,"ب",2,0],["أَسِفتُ فَما أَرتاحُ وَالراحُ تُثمِلُ","وَلا أُسعِفُ الأَوتارَ وَهيَ تَرَسَّلُ",9,"ل",1,0],["أسفاً على ذاك الجمال المزدهي","أسفاً على ذاك الشباب الناضر",10,"ر",1,0],["أسفاً على تلك الرجاحة في الحجى","أسفاً على ذاك الذكاء النادر",10,"ر",1,0],["أسفاً لقد ضيعت في أدبي وفي","تهذيب نفسي أنفس الأعمار",11,"ر",1,0],["أَسَفاً عَلَيْكَ وَنَحْنُ أَوْلَى بِالأَسَى","أَيْنَ الَّذِي يَشْقَى وَأَيْنَ النَّاعِمُ",12,"م",1,0],["أَسَفاً عَلَى ذَاكَ الحِجَى","أَسَفاً عَلَى ذَاكَ الجَمَالْ",13,"ل",1,0],["أَسَفاً عَلَى الشِّيَمِ الحِسَانِ","جَمَعْنَ فِي أَبْهَى مِثَالْ",13,"ل",1,0],["أسفاً على ذاك الجلالِ تقلَّصَت","أفياؤه وعهدْنَ خيرَ رواقِ",14,"ق",1,0],["أسفي على الشعراءِ أنهمو على","حال تثيرُ شماتةَ الأعداء",15,"ا",2,0],["أسفت لشاشي الذي قد مضَى","وفازَ به سارق حاشه",16,"ه",1,1],["أسفي للدراهم الحلبيَّا","ت فقد فرَّحت حشايَ وطرفي",17,"ف",2,1],["أسفت لبدرٍ بانَ عنه محمد","فبان بمعني حسنه وجماله",18,"ل",2,0],["أسفي لو أن قولي أسفي","كان يشفينيَ من حرِّ الأسف",19,"ف",1,0],["أَسَفي عَلَيهِ مُضَرَّجاً لَم تَمتَشِق","يَدُهُ الحُسامَ وَلَم يَسِر لِقِتالِ",20,"ل",1,0],["أَسَفي عَلى زَمَنٍ لَدَيكَ قَطَعتُهُ","وَكَأَنَّني لِلفَرقَدَينِ نَزيلُ",21,"ل",1,0],["أَسَفي عَلى زَمَنِ التَلاقي","وَالعَيشُ مُتَّسِعُ النِطاقِ",22,"ق",1,1],["أُسِفَّ جَسيدَ الحاذِ حَتّى كَأَنَّما","تَرَدّى صَبيغاً باتَ في الوَرسِ مُنقَعا[RIGHT][/P]",23,"ع",2,0],["أَسفي أَوَدُّ وَلا أَوَدُّ وَأغتَدي","وَأَروحُ أحفَظُ عَهدَ مَن قَد ضَيَّعا",24,"ع",2,0],["اسفي على الادب الذي يبغون ان","يكسوه من عصر خلا اهداما",25,"م",2,0],["أسفرتَ عن فرج البلاد وأهلها","صبحَ الجلوس لك النفوس فداء",26,"ا",2,0],["أَسَفي عَلى تِلكَ المَحاسِنِ كُلَّما","نُقِلَت مِنَ البالي إِلى الدَوّارِ",27,"ر",1,0],["أَسَفي عَلى أَسَفي الَّذي دَلَّهتِني","عَن عِلمِهِ فَبِهِ عَلَيَّ خَفاءُ",28,"ا",2,0],["أَسِفتُ لِغَضّاتٍ مِنَ الحُسنِ شارَفَت","لِذُعرِ الفِراقِ أَن تَغَيَّرَ أَو تَذوى",29,"و",2,0],["أَسَفٌ غالِبٌ يَحِرُّ جَواهُ","وَعَزاءٌ مَتَعتَعٌ مَعلوبُ",30,"ب",1,0],["أُسِفُّ إِذا أَسفَفتُ أَدنو لِمَطلَبٍ","خَفٍ وَأَراني مُثرِياً حينَ أَقنَعُ",31,"ع",1,0],["أَسَفاً عَلَيهِ لِآسِفٍ بَينَ القَنا","أَسوانَ تُعذَلُ خَيلُهُ وَتُلامُ",32,"م",1,0],["أَسَفاً لِلحُلومِ كَيفَ إِستَخَّفَت","بِغُلُوِّ الإِسرافِ وَالطُغيانِ",33,"ن",1,0],["أسف كاساتها طاب الزمان ضحا","حقا وألثم عيني لعبة العاج",34,"ج",1,0],["أَسِفتُ لِفَقدِ الأَصمَعِيِّ لَقَد مَضى","حَميداً لَهُ في كُلِّ صالِحَةٍ سَهمُ",35,"م",1,1],["أسفاً عليك وأنتِ روحٌ حائرُ","والكون أسرارٌ يضيقُ بها الحِجَى",36,"ج",2,0],["أسفاً لنصر الدين أينَ جنانُه","وحنانُه الشافي من الأوصابِ",37,"ب",1,0],["أسفاً لعمر كالحباب","والكأس فائضة شقاء",38,"ا",2,0],["أسفي لغالي الدمع تب","ذله لمرتخص الدمى",39,"م",2,0],["أَسَفي لِفِراقِ زَمانِ صبا","وركوبي قَيْدَ مَهَا الخُرُدِ",40,"د",1,0],["أسفي على حلبٍ وَقَدْ عدمَتْ فتىً","يقظانَ كانَ إلى العلى يتطلَّعُ",41,"ع",1,0],["أَسَفي كيفَ كنتُ أطلبُ عزاً","بالولاياتِ وَهْيَ عَيْنُ الهوانِ",42,"ن",1,1],["أسفي واللهِ من قولي أنا","كلْمةٌ ذو العقلِ منها يأنفُ",43,"ف",1,0],["أَسفَرَت لَيلَةَ وَدّا","نَ حِذاراً أَن تَروعا",44,"ع",2,0],["أَسِفٍ عَلَيكِ يَهيمُ حينَ قَتَلتِهِ","وَسَلَبتِهِ لِبَّ الفُؤادِ جِهارا",45,"ر",2,0],["أَسَفِي على الإِسلامِ هَانَ عَرينُه","وعَدَا عليه الفاتِكُ المُسْتَأسِدُ",46,"د",1,0],["أَسَفُ الصَّدَى أن يَضمَحِلَّ ومَا قضَى","وَطراً مِنَ الأَسماعِ والأَكبادِ",47,"د",1,0],["أَسَفِي عليهم يَرتمِي بِرِحالهم","حادي الصَّباحِ وسائقُ الظَّلماءِ",48,"ا",2,0],["أسفِي عليكَ ذهبتَ غير مُودَّعٍ","ومَضَيْتَ بين عَشيَّةٍ ونهارِ",49,"ر",1,0],["أسفِي على الجارِ القريبِ يؤمُّه","عادى الرَّدى فيؤمُّ أبعدَ دارِ",49,"ر",1,0],["أَسَفِي على الوادِي ينامُ حُماتُه","ويَعيثُ في جَنَباتهِ المُرتادُ",50,"د",1,0],["أَسِفتُ لِشَعبٍ مُستَباحٍ وَأُمَّةٍ","أَحاطَ بِها جَيشٌ مِنَ الظُلمِ غالِبُ",51,"ب",1,0],["أَسَفي عَلى المُتَباغِضينَ وَقَد رَأَوا","أَنَّ الفَلاحَ تَوَدُّدٌ وَوِئامُ",52,"م",1,0],["أَسَفَّ هَذا وَهَذا","وَوَقَعا في مَكانِ",53,"ن",1,0],["أُسِفَّ عليهِ المِسكُ والنَّقْعُ مثلما","أُسِفَّ نَؤورٌ فوقَ جِلْدٍ مُوَشَّم",54,"م",1,0],["أسَفي على الأحرارِ قَلّ حِفاظُهم","إن كان يُغني الحُرَّ أن يتأسّفا",55,"ف",2,0],["أَسِفتُ لِفائِتٍ وَسَلَوتُ عَنهُ","وَهَل مِثلي عَلى ماضٍ أَسوفُ",56,"ف",1,0],["أسَفٌ غَيْرُ نافِعٍ وَاجْتِهادٌ","لا يُؤدّي إلى غَنَاءِ اجْتِهادِ",57,"د",1,0],["أسَفٌ أسَفّ بها وأُثْقِلَ نَهضُها","بالحُزْنِ فهْيَ على الترابِ هَوافِ",58,"ف",1,0],["أَسَفي لَأَوبَةِ راحِلٍ لَم تَقضِها","عِدَةُ المُنى وَتَحِيَّةٍ لَم تُنظَمِ",59,"م",1,0],["أسفت إذ قيل لي أن الوليّ قضى","وَهَل يفيد عَلى من قد قَضى الأسف",60,"ف",1,0],["أَسَفي عليك يَطول من مقتولة","برصاص أَهل البغي وَالعدوان",61,"ن",1,0],["أَسَفي عَلى شعبٍ هنالك جاهلٍ","يَلوي رِقاب الذل تحتَ النير",62,"ر",1,0],["أسفي عَلى متعصبين تأَلبوا","يَحمون حوض الجهل بالساطور",62,"ر",1,0],["أَسَفْنَ المَشَافِرَ كَتَّانَهُ","فأَمْرَرْنَهُ مُسْتَدِرّاً فَجَالاَ",63,"ل",2,0],["أسفاً للصِّبا وغرِّ ليالٍ","ليس يُبقي على صباهنَّ فجرُ",64,"ر",1,0],["أسفر الشعرُ عن روائعه فيها","وألقى عن الخفاء لثامَه",65,"م",2,0],["أسفرت سيدان عن مأساتها","وتهاوى حجرُ الحصن المشيد",66,"د",1,0],["أسفاً للحياةِ أصلى لظاها","وأراها وريفةَ العذَباتِ",67,"ت",1,0],["أَسَفِي على دارٍ عَهدْتُ ربوعَها","وظباؤُها بفنائِها تَتَبَخْترُ",68,"ر",1,0],["أَسَفلٌ حُفَّ بالعِضاهِ وأَعلا","هُ صَفَا يُلغِبُ الوُعُولَ دَلُوقُ",69,"ق",1,0],["أَسَفِيرُ مِصْرَ اذْهَبْ عَزِيزاً رَاشِداً","وَبِجَانِبِ التَّامِيزِ زَكِّ النِّيلاَ",70,"ل",2,0],["أَسَفاً عَلى ذَاكَ الَّذِي عَنْ قَوْمِهِ","فِي كُلِّ مَحْمَدَةٍ أُنِيبَ وَنَابَا",71,"ب",2,0],["أَسْفَرَتْ بَيْنَ رُوْعَةٍ وَجَلاَلٍ","عَنْ كُنُوزٍ مَجْلُوَّةٍ مِنْ خَفَاءِ",72,"ا",2,0],["أَسَفاً أَنْ تَبِينَ يَا فخْرَ عصْرٍ","طَوْقَتْهُ يدَاكَ بِالأَفْضَالِ",73,"ل",1,0],["أَسَفاً أَنْ يَبِيتَ مُغْتَمَداً فِي الترْ","بِ سَيْفُ العَزِيمَةِ المَسْلولُ",74,"ل",1,0],["أَسَفاً أَيُّهَا الرَّفِيقُ المُوَلِّي","وَالأَخُ البَرُّ وِالصَّفِيُّ الأَثِيرُ",75,"ر",1,0],["آسِفَاتٍ عَلَى مُنىً شَائِقَاتٍ","فُزْنَ مِنْهَا بِخَيْبَةٍ وَبِصَدِّ",76,"د",1,0],["أَسَفِي أَن يُقَوِّضَ الرَّجُلُ البانِي","وَإِنْ ظَلَّ بَيتُهُ معْمُورَا",77,"ر",2,0],["أَسَفاً أَنْ يَكُونَ يَوْمَ عَزَاءٍ","عَوْدُ ذَاكَ الْحَبِيبِ لاَ يَوْمَ عِيدِ",78,"د",1,0],["أَسَفاً يَا فَرِيدَةً فِي نِسَاء الشَّ","رْقِ بِالفَضْلِ وَالحِجَى أَنْ تَبِينِي",79,"ن",2,0],["أَسَفاً أَنْ خَلاَ ذَرَاكِ فَمَا مِنْ","رَادَةِ الرَّأْيِ غَيْرُ بَاكٍ حَزِينِ",79,"ن",1,0],["أَسَفِي عَلَى الغصْنِ النَّضيرِ","أَسفي عَلَى القَمرِ المُنيرِ",80,"ر",1,1],["أَسفي عَلَى تلكَ الشَّمائلِ","كالخَمائِلِ فِي البُكُورِ",80,"ر",1,0],["أَسفي عَلَى كلِّ الجَمالِ","يَبِيتُ فِي بَعضِ القُبُورِ",80,"ر",1,0],["أَسفي الكبيرِ عَلَى أَبيكَ","الشَّاعرِ اللَّبِقِ الكَبِيرِ",80,"ر",1,0],["أَسَفاً أَنْ يَبِينَ مَنْ","دُونَ أَوصَافِهِ المِدَحْ",81,"ح",1,0],["أَسْفٌ عَظِيمٌ لِلأحِبَّةِ","أَنْ تَبَينَ بِلاَ مَآبْ",82,"ب",1,0],["أسَفٌ أَنْ يُغَيِّبَ الْقَبْرُ رُوحاً","مَلَكِيّاً وَطَلْعَةً زَهْرَاءَ",83,"ا",2,0],