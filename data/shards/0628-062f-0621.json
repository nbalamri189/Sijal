{"poems":[[50,"هلا استعنت على الهموم","https://www.aldiwan.net/poem65095.html","مجزوء البسيط"],[48,"لا يغبطن أخو نعمى بنعمته","https://www.aldiwan.net/poem22083.html","البسيط"],[102,"ثرثرات محموم","https://www.poetsgate.com/ViewPoem.aspx?id=50376",""],[47,"عَهْدِي بِرَبْعِكَ مُثَّلاً آرَامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32042",""],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[543,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55893","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112832","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2899,"","https://poetry.dctabudhabi.ae/diwan/poem/107123","المديد"],[3241,"","https://poetry.dctabudhabi.ae/diwan/poem/147627","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109924","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91824","الكامل"],[5111,"عَيْنَاكِ فَلْسَفَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212614",""],[5943,"جنَّةُ النارِ","https://www.poetsgate.com/ViewPoem.aspx?id=41590",""]],"verses":[["بَدءُ التَحِيَّةِ بَينَهُم","نَظَرُ النَديمِ إِلى النَديمِ",0,"م",1,0],["بَدءُ السَعادَةِ أَن لَم تُخلَقِ اِمرَأَةٌ","فَهَل تَوَدُّ جُمادى أَنَّها رَجَبُ",1,"ب",1,0],["بدء ليلي حبّ ، بدون عشاء","نصف يومي هوى وخبز معادي",2,"د",2,0],["بَدْءَاتُهُ بِنَوَالِهِ إِغْنَاَؤْنا","مِن عُدْمِنَا ، وسُؤَالُنا إِعْدَامُهُ",3,"م",2,0],["بدءُ هَذا الدهرِ مع غاياتهِ","فوقَ أَهليهِ لهُ حكمُ الشمول",4,"ل",1,0],["بدءُ انتصارٍ ذا وكُلُّ بِدايةٍ","شُكِرَت فإنَّ خِتامَها مَشكورُ",5,"ر",1,0],["بدء تمداحى تغالى فيهما","وبتاريخي زها حسن الختام",6,"م",1,0],["بدء المقاصد باسم ربي منحة","فيها السمو إلى رفيع سنا السنن",7,"ن",1,1],["بَدءاً وَخَتماً وَفيما بَينَ ذَلِكَ قَد","دانَت لَهُ الرُّسلُ مِن عُربٍ وَمِن عَجَمِ",8,"م",1,0],["بدء صعق الأرض نشءٌ وطل","ورياحٌ ثم غيمٌ أبَل",9,"ل",1,0],["بدءوا نزيلهم بكأس لذة","معسولة وثنوا بكأس ممقر",10,"ر",1,0],["بَدءُ كوني رآهُ من قبلِ كوني","لا كَما خالَني بهِ التشريحُ",11,"ح",1,0],["بدءٌ يبدّلُهُ الزَمانُ وغايةٌ","تُخشَى وَتُرجَى وَالجَميع تورّط",12,"ط",1,0],["بدءٌ بَدَا حَيْرَةً عَيْنَايَ تَسْألُهُ","أيَّانَ ؟ أيْنَ ؟ مَتَى ؟ عَيْنَاكَ حَيَّرَتَا",13,"ت",2,0],["بَدءًا من اللوم في سرٍّ تفسرُهُ","شمسُ الأصيلِ إلى ما عينُها نفذتْ",14,"ت",1,0]]}