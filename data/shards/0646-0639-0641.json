{"poems":[[79,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[1,"إني من القوم الذين إذا","https://www.aldiwan.net/poem34001.html","الكامل"],[422,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[422,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[469,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113768","الطويل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20537","الطويل"],[4788,"خلاص جزنا من المحبه وتبنا","https://www.poetsgate.com/ViewPoem.aspx?id=132246",""],[469,"سرت زينب والبرق مبتسم الثغر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574816",""]],"verses":[["نُعَفِّرُ في الآثارِ حُرَّ خُدودِنا","ونَشْكو الى الأطْلالِ ما البَيْنُ صانِعُ",0,"ع",1,0],["نَعِفُّ وَنَعرِفُ حَقَّ القِرى","وَنَتَّخِذُ الحَمدَ ذُخراً وَكَنزا",1,"ز",2,0],["نَعفو وَما اِشتَفَتِ السُيوفُ وَلا هَفا","بِصُدورِها شَوقٌ إِلى الأَجفانِ",2,"ن",1,0],["نَعفو كَما تَعفو الجِيادُ عَلى ال","عِلّاتِ وَالمَخذولُ لا نَذَرُه",3,"ر",2,0],["نعفّر فيه الوجه قَصْدَ تيمُّنِ","ويخدم قبر المرتضى كلٌّ مؤمنٍ",4,"ن",1,0],["نعفّر منا أوجهاً في صعيدكم","عليهنّ من صبغ المشيب نقاب",5,"ب",1,0],["نعفّي بأذيال المروط من الدجى","لما كتبت منها الذوائبُ في العفر",6,"ر",1,0],["نُعَفِّر فيه الخَدِّ والوجهَ كلَّهُ","ولستُ أرى مِمَّن يخُصُّ به الفَما",7,"م",2,0],["نُعَفّى بآثارِ الثِيابِ مَبيتَنا","ونَلقُطُ رَفضاً مِن جُمانٍ تَحَطَّما",8,"م",2,0],["نعفي عن إللي جار أمس وحرَبنا","إليا قدرنا ماتتبعنا الأحزاب",9,"ب",1,0],["نعفِّي بأذيال المروط مع الدجى","لما كتبتْ منها الذوائبُ في العفرِ",10,"ر",1,0]]}