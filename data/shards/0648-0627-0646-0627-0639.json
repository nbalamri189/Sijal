54432",""],[5648,"انا اسف","https://www.poetsgate.com/ViewPoem.aspx?id=155191",""],[5652,"وشلون هانت عشرتي واتركوني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=165471",""],[5652,"عذّب","https://www.poetsgate.com/ViewPoem.aspx?id=177370",""],[5725,"سهم الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=181550",""],[5809,"اعجب شيء","https://www.poetsgate.com/ViewPoem.aspx?id=205478",""],[5837,"عرفة وجه","https://www.poetsgate.com/ViewPoem.aspx?id=181852",""],[5848,"خيوط الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=50585",""],[5848,"ليلة خميس","https://www.poetsgate.com/ViewPoem.aspx?id=48969",""],[5881,"يستر وجهها الشفق","https://www.poetsgate.com/ViewPoem.aspx?id=183822",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5897,".. وقلت لليل","https://www.poetsgate.com/ViewPoem.aspx?id=176471",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[5952,"لا وجه لي","https://www.poetsgate.com/ViewPoem.aspx?id=205983",""],[6031,"إلى الملكِ الوهَّابِ ما في يمينِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46259",""],[6056,"وطفاء الحجاجين","https://www.poetsgate.com/ViewPoem.aspx?id=130183",""],[6089,"طافوا وطفتُ سعوا سعيتُ رموا رميتُ","https://www.poetsgate.com/ViewPoem.aspx?id=214664",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[6238,"غِيضَ الكَلامُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86771&r=&rc=0",""],[6259,"حُييتما من دمنتي طللينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59406&r=&rc=54",""],[2220,"الحمدُ للهِ لا أشركُ به أحدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11299&r=&rc=173",""],[6314,"جدارية عارية للبحر والجسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88073&r=&rc=8",""],[6336,"لقاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73564&r=&rc=25",""]],"verses":[["وإن أعشى العقول جليل خطبٍ","أقالوا خط عثرتها خطابا",0,"ب",2,0],["وَإِنَّ أَعجَزَ مَن لاقَيتُ ذو أَمَلٍ","يَرجو الصَلا عِندَ زَندٍ ضَنَّ بِالقَبَسِ",1,"س",1,0],["وَإِن أَعِش هُنَيهَةً فَرُبَّما","شَقَّ عَلى أُذنِ العَدُوِّ خَبَري",2,"ر",2,0],["وَإِن أَعيشَ بَعيداً مِن لِقائِكُمُ","ظَمآنَ قَلبٍ وَذاكَ الوِردُ مَورودُ",3,"د",1,0],["وَإِن أَعرَضَت قُلتَ سَرعوفَةً","لَها ذَنَبٌ خَلفَها مُسبَطِر",4,"ر",1,0],["وَأَنّا عَرانينٌ صُقورٌ مَصالِتٌ","نَهُزُّ قَناةً مَتنُها لَم يُوَصَّمِ",5,"م",1,0],["وأن أعوَّضَ منثورَ المدامع عن","سماعِ درٍّ من الأقوال منضود",6,"د",1,0],["وإنّ اعتذاراً منكَ تِلقاءَ حاجتي","لأعجبُ من أن يصبح البحرُ ناضبا",7,"ب",2,0],["وإنّ أعجب من عمروٍ وناسِله","لأنْ غدا وهو محجوج ومُعتمَر",8,"ر",1,0],["وإن أعجبَ شيءٍ أنت مُبصرُه","في كل ما حُمّلتْهُ الأرضُ من ثقلِ",9,"ل",1,0],["وَإِن أَعفُ عَنها أَو أَدَعها لِجَهلِها","فَما لِبَني قَيسٍ عِتابٌ وَلا عُذرُ",10,"ر",1,0],["وَإِنِ اِعتَزَّ بِها الشَرُّ غَداً","فَتَعالَت تُمطِرُ المَوتَ الزُؤاما",11,"م",2,0],["وَإِن أَعرَضَت عَنهُ لَم يَحلُ في","عُيونِ الخَرائِدِ غَيرُ الخَزَف",12,"ف",1,0],["وَأَنَّ إِعطائَهُ الصَوارِمُ وَال","خَيلُ وَسُمرُ الرِماحِ وَالعَكَرُ",13,"ر",1,0],["وَإِن أَعرَضَت زَوراءَ أَو شَمَّرَت بِها","فَلاةٌ تَرى مِنها مَخارِمَها غُبرا",14,"ر",2,0],["وَإِنّا عَلى أَمثالِهِ مِن جِبالِنا","لَأَبقى مَعَدٍّ لِلنَوائِبِ وَالدَهرِ",15,"ر",1,0],["وَإِن أَعفُ أَستَبقي حُلومَ مُجاشِعٍ","فَإِنَّ العَصا كانَت لِذي الحِلمِ تُقرَعُ",16,"ع",1,0],["وإن أعرَضْتَ عن تَعْريضِ شُكْرٍ","أُثَوِّبُ فيه تَثويبَ الأَذانِ",17,"ن",1,0],["وإن أَعْرَ ن سَلوةٍ أو أَحِدْ","عَنِ الرُّشد لم يكسُني الغَيُّ عارا",18,"ر",2,0],["وإن اعتذرت فلي يقين لم يزد","في صدق ودك لي ولو كشف الغطا",19,"ط",2,0],["وإنْ أعرضتَ يوماً عن صديقٍ","فقد حملتَهُ في الناسِ عارا",20,"ر",2,0],["وإنْ أعرناهُ لها سكتةً","ألحقَ بالتسعةِ تسعينا",21,"ن",2,0],["وَإِن أَعوَزَتها في المَطايا نَجيبَةٌ","جَعَلنا مَطاياها الرِياحَ الذَوارِيا",22,"ي",2,0],["وَأنَّ أَعْمالَها لَمَّا حَللْتَ بها","تَغارُ مِنْ طِيبِها الجَنَّاتُ والنُّهُرُ",23,"ر",1,0],["وَإِن أَعجَبَهُ النَحوُ","فَهَذاكَ لَنا أَجوَد",24,"د",1,0],["وَإِن أُعفَ بَعدَ المَوتِ مِمّا يُريبُني","فَما حَظِّيَ الأَدنى وَلا يَدِيَ الخُسرى",25,"ر",2,0],["وأنّ إعطاءه الصّوارم والخي","ل وسمر الرّماح والعكر",26,"ر",1,0],["وَإِن أُعطَ لَيلى في حَياتِيَ لَم يَتُب","إِلى اللَهِ عَبدٌ تَوبَةً لا أَتوبُها",27,"ب",3,0],["وانا علي نذر مارخص جيتك وانتي","نذر على رقبتك إنك .. ماتخليني",28,"ن",2,0],["وإِنَّ اعتقاداً خالياً منْ مَحَبَّة ٍ","وودٍ لكم آل النبي لفاسدُ",29,"د",1,0],["وانا عبدك الذي باعتقاد","علقت راحتاه في أثوابك",30,"ك",1,0],["وأنا على أعتاب دولة حسنها","ألقيت رحل جوى جريح الملمس",31,"س",1,0],["وإن أعطاكَ سرّاً ذو ودادٍ","فأقبرْه وحاذِرْ أن يضيعَا",32,"ع",2,0],["وَإِن أَعمَلَ الأَفكارَ عِندَ مُلِمَّةٍ","تُلِمُّ أَرَتهُ ما يُسِرُّ المُغَيَّبُ",33,"ب",1,0],["وَإِن أَعِش صاحَبتُ دَهري عالِماً","بِما اِنطَوى مِن صَرفِهِ وَما اِنسرى",34,"ا",1,0],["وَإِنِ اِعتَرَتكَ جَهالَةٌ طَبَعِيَّةٌ","فَاِسكُت وَطُف تِلكَ الدُروبَ قَليلا",35,"ل",2,0],["وإِنَّا على ما يَزْعُمُ النّاسُ بَيْنَنَا","مِنَ الحبِّ يا عفرا لَمُهْتَجِرانِ",36,"ن",1,0],["وَإِن أَعجَبَتكَ الدَهرَ حالٌ مِن اِمرِئٍ","فَدَعهُ وَواكِل حالَهُ وَاللَيالِيا",37,"ي",2,0],["وإِن أُعمِلت نَغَمات القِيا","نِ أَدْمَنْتُ للكأس إِعمالها",38,"ل",3,0],["وإن أعظم ذنب لا خلاف به","أن يعبد العبد رباً خلفه ذنب",39,"ب",1,0],["وإن أُعَرِّج على الجنَّاتِ مُقتطِفاً","خَرَجتُ منها وقد كسَّرتُ أغصانا",40,"ن",2,0],["وَأن اعْتَمَدْتَ الصالِحاتِ مزَاوِداً","وعَلِمْتَ أن العَيْشَ ظِلٌّ زائِلُ",41,"ل",1,0],["وَإِنَّ اعْتِصامِي بِالْوَزِيرِ وَظِلِّهِ","يَدٌ لِلنَّدى ما مِثْلُها مِنْ يَدٍ عِنْدِي",42,"د",2,0],["وإنا على آثارهم وسبيلهم","وما نحن عن حق لهم بنيام",43,"م",1,0],["وَإِنَّ اِعتِقادَ الهَمِّ لِلخَيرِ جامِعٌ","وَقِلَّةُ هَمِّ المَرءِ تَدعو إِلى النَقصِ",44,"ص",1,0],["وإن اعتدى اليوم الزمان لها على","أهل الهوى فغداً عليها يعتدي",45,"د",2,0],["وَإِن أَعيا اللِسان بَيان ما بي","شَكَوت إِلَيكَ بِالدَمع الصَبيب",46,"ب",1,0],["وَأَنا عَلى الأَيّامِ أَعتَبُ عاتِبٍ","وَبذاك يَقضي بينهنَّ وَبَيني",47,"ن",2,0],["وإنْ أعْضَلَتْ مشكلاتُ الأمور","أزال وفسَّر إشكالها",48,"ل",3,0],["وإنَّا على يأس النَّدى ورجائه","لنا منك رجَّافُ العشي هطول",49,"ل",1,0],["وإن أعوز الرأي الرصين لشكل","أطال صواب الرأي فيه وأعرضا",50,"ض",2,0],["وإِن أَعلقَتْ فِي حبلِ مُلْكِكَ حَبْلَها","فحبلٌ من الأَحبابِ مُنْصَرِمُ القَطْعِ",51,"ع",1,0],["وأنا عليه كما عهدتَ فلا تكن","أبَداً بحالٍ غير ذي ودٍّ وفي",52,"ف",2,0],["وإن أعرضتُمُ ورضيتموهُ","فإنّ المجدَ ممتعِضٌ غَضوبُ",53,"ب",1,0],["وَإِنّا عَدانا عَن بِلادٍ نُحِبُّها","إِمامٌ دَعانا نَفعُهُ المُتَتابِعُ",54,"ع",1,0],["وَإِن أَعرَضَت رَآء فيها البَصي","رُ ما لا يُكَلِّفُهُ أَن يَفيلا",55,"ل",2,0],["وأن اعترافي بالتأخر حيث لا","يقدمني فضل أجل وأرجح",56,"ح",1,0],["وأنا عَنهمُ أصولُ بِقُربي","مِن حِمى سيِّدِ العُلا المِغوارِ",57,"ر",1,0],["وإن أعطَى المُؤَدِّبُ فضلَ علمٍ","فلا يُعطي الحَذاقةَ في الجَنانِ",58,"ن",1,0],["وإِن اعتزازي بعد وتِك ذَلةٌ","وإِنَّ يَساري بعدَ فقْدِك إِعْسَارُ",59,"ر",1,0],["وإِن أَعوزهم نُقْلٌ","فأَعراضُ المشاهيرْ",60,"ر",1,0],["وَإنَّ أَعجَبَ ما تَأتي الحُظُوظُ بِهِ","فَوزُ الجَحاشِ بِحَظِ السّابِقِ الأَرِنِ",61,"ن",1,0],["وأنا على ما كنته من رغبتي","في أخذه لم أنتقل عما مضى",62,"ض",2,0],["وإنِ اعتراك عَشىً لِنيِّرِ نَوْرِهِ","فاعدِلْ لإثمدِ ظِلِّهِ فتكحَّلِ",63,"ل",1,0],["وأنا عكس ذاك كان ابي صد","ر المعالي فصرت في الناس سقا",64,"ق",2,0],["وإنا على الحالات نحمد ربنا","على نعمٍ عظماء جلت عن الحصر",65,"ر",1,0],["وإنَّ أعز الناسِ من كان بيتُه","صدورَ العوالي والمعالي ستائرُهْ",66,"ر",2,0],["وإن اعتقاد الاتحاد جهالة","فسل عنه من يدريه أن كنت لا تدر",67,"ر",1,0],["وإن اعتقادات الحلول ضلالة","إذا لم يكن كفر فلا يخل من كفر",67,"ر",1,0],["وَإنْ أعْرَبَ المُثْنِي مَنَاصِبَ مَجْدِهِ","فَنَصْباً عَلَى التَّمْيِيزِ بَيْنَ المَنَاصِبِ",68,"ب",1,0],["وَأَنَا عَمَّا عِفْتُ ذُو اعْتِيافِ","وَأَنَا فِي المَنْطِقِ ذُو احْتِيَافِ",69,"ف",1,0],["وإنْ أَعْجَزاكَ فَيا طالما","بِهذا لَهَوْتَ وهذا وَلِهْتا",70,"ت",2,0],["وأنا على ظن جميل فيهم","ولذاك عندي أعظم الأسباب",71,"ب",1,0],["وإن أعوزته الراح في خلواتهِ","ترشّفها بالوهم من وجنة الحِبّ",72,"ب",1,0],["وَإن أعِش صَاحَبتُ دَهرِي عَالِمَا","بِمَا أنطَوَى مِن سِرِّهِ وَمَا انسَرَى",73,"ر",2,0],["وَأنا عَلى حُكمِ الحَقيقَةِ شَمسُها","فاخسَأ وأنتَ عَلى المحالِ ذُبالُها",74,"ل",3,0],["وإنَّ أعجب شيء أن أبثَّكها","كأَنَّ قلبك خالٍ وهو مُحتدم",75,"م",1,0],["وإنا عن قريب سوف نمضي","على آثارهم عن الأبصار ترب",76,"ب",1,0],["وأنا عذير العاشقين على البكا","فالحسن تبرٌ والمدامع زئبق",77,"ق",1,0],["وإن أعطى السيادة وفق دهر","بغى ولبغيِه شاب الغراب",78,"ب",1,0],["وإنا على ما نحن لينٌ وعزَّة","وذو الحق من آياته العزُّ والنصر",79,"ر",1,0],["وإنا على آثارهم نرسم الخطا","سراعاً وصدق العزم جد كفيل",80,"ل",1,0],["وأنا عليك كما عهد","ت وإن نقضت علي عهدك",81,"ك",1,0],["وإن أعلمتها وأصبت منها","فجئ بالشاهدين على الصداق",82,"ق",1,0],["وإن أعيان البصائر معضلاتٍ","أحال لحلها رأياً سديدا",83,"د",2,0],["وَإِنّا عَلى وَعدٍ مِنَ اللَهِ صادِقٍ","وَتَأخيرُهُ إِيّاهُ كَي يَعظُمَ الأَجرُ",84,"ر",1,0],["وانا على ذري النّسانيس بهديك","يا من تجدّذ في ضميري رسومك",85,"ك",1,0],["وإنَّ اعتدال الأمر ليس بواقع","ولا نافع فاعلم فما فيه طائل",86,"ل",1,0],["وإنَّ أعمالنا عن أمره ظهرت","وإنّ عابدَه لذاته عبدا",87,"د",2,0],["وإن أعجل تراه","بصورة الحالِ ينسي",88,"س",2,0],["وان أعدت نفسها له أمه","تملكه طوعاً بتلك المكرمه",89,"ه",1,0],["وان اعجب شيء منه دل على","قصوره وعلينا أوجب الحذرا",90,"ر",2,0],["وان اعتمادي على اللَه دوماً","يؤمل نفسي بحسن العواقب",91,"ب",1,0],["وَانا عقبهم لا انا بصاحي ولا مَيْهُود","أقَزِّر زماني بين واعي وبين طْيوح",92,"ح",1,0],["وأنا عليل منذ أسبوع ولم","تسمح ولا بعيادة الأوراقِ",93,"ق",1,0],["وَإِنَّ أَعَزّ الناس حرٌّ سَمَيدَعٌ","عَيُوفٌ حَياة الذُل ماضي العَزيمة",94,"ه",1,0],["وان اعتزيت لنا بجدّ ظالم","جدّي الذي في العالمين يشفع",95,"ع",1,0],["وإن اعتاقك، في إحداهما","طارق الموت فقد حزت الجهادا",96,"د",2,0],["وَإِن أَعرَضَت عَنّا كَما شاءَ رَبُّنا","فَما القَلبُ عَنها طولَ دَهري بِمُعرِضِ",97,"ض",1,0],["وان أعدى عدوٍ بالتملق من","إذا تبين عيباً فيك اطراه",98,"ا",2,0],["وإن أعشْ بعدك رغم الهوى","فإن عيشي في سبيل الأخر",99,"ر",1,0],["وإن أعرضت لم أدر من ظلمة الحزن","لئالي بدور أم ثغور تشف عن",100,"ن",1,0],["وأنا على كسب المعاصي آملٌ","منك الرضا يا أكرم الكرماء",101,"ا",2,0],["وأنا عنه غافل","لا وجدت الذي يجد",102,"د",1,0],["وإن اعتبته ليالي العجوز","تدلت عناقيده كالمزابي",103,"ب",2,0],["وَأَنا عَلى حالي أَقَمت وَهَكَذا","شَوقي أَمامي وَالقَضاء وَرائي",104,"ي",1,0],["وإن أعوز الحسن نيل الكفاف","جرى العهر للخرّد المحصنات",105,"ت",1,0],["وأنا عائش بماضي حياتي","فهو حسبي من الحياة",106,"ه",1,0],["وإن أعطب فلا عجبٌ","لكلِّ منيةٍ سبب",107,"ب",1,0],["وإن أعلا رُتَبِ السعادة","للمرءِ نيلُ شَرَف الشهادَة",108,"ه",1,0],["وإنّ اعتِقادي أنْ أتيتُكَ مِدْحَةً","تقابلُ ما أولَيْتَني لَبَديعُ",109,"ع",1,0],["وَإِن أُعطيتَ سُلطاناً","فَحاذِر صَولَةَ الزَمَنِ",110,"ن",1,1],["وَإن أَعدى العِدا من ظل يضحكها","وَإن أَوفى صَديق كان أَبكاها",111,"ا",3,0],["وَإِنّ أَعظم همٍّ بِالعَواقب مَن","يَلقى بِبَهرجِ هَذا الدَهر مُغتبطا",112,"ط",2,0],["وَأَنا عَلى عَهد المَحبة لَم أَزَل","أَقضي الحَياة بحسرةٍ وَسُهاد",113,"د",1,0],["وإن أعدَت فهل تُعدي","بغير الشجو والسهد",114,"د",1,0],["وإِنّا عَلى غَمزِ المَنونِ قَناتَنا","وَجَدِّكَ حاموا فَرعِها أَن يُهَصَّرا",115,"ر",2,0],["وإن أعدى الملوك لهم عطاء","فنزر في عطاياه الجزالي",116,"ل",2,0],["وإنا على درب الزعيم مسيرنا","على دربه ركب الحضارة يذهب",117,"ب",1,0],["وأن أعيش قريرَ العين في دعةٍ","منها حياتي بحسن الحظ موصوله",118,"ل",2,0],["وإن أعش كان لي في قربكم أمل","فالصبر تحمد بعد الضيق عقباه",119,"ا",2,0],["وأنَّ اعتمادي في الأمور جميعها","عليه وحسبي علمه بي مُسْجَلا",120,"ل",2,0],["وإن أعتزلهم وشأنهم","وآخيل مكتسحٌ لهم",121,"م",1,0],["وَإِن أَعد في رِجال السَند","فَإِن يَكُن أَسَعَدتَّني لِلأَبَد",122,"د",1,0],["وَأَنا عاذِر وَإِن قُلتَ عَتباً","فَمَدامَ الصِحابِ صافي العِتاب",123,"ب",1,0],["وَأَنَّ أَعجبَ ما في الحُبِّ مِن بِدَعٍ","وَالحُبُّ إِن شئتَ حَقّاً كُلُّهُ بِدَعُ",124,"ع",1,0],["وإن أعظم خطبٍ","أدمى دموع المآقي",125,"ق",2,0],["وإنَّ اعتدادي بالوِداد لصادق","لديكَ فلمْ كذَّبتَ آمال مُعْتَدِّ",126,"د",1,0],["وإن أعرضتمُ عنهُ فعرضي","لكم يُبدي بمعترض السلامِ",127,"م",1,0],["وأنا على كيد الزَمان وجورهِ","حزمي نصيري والفؤاد جسورُ",128,"ر",1,0],["وأنا عيوني لا تنام","سوى بحضن الذكريات",129,"ت",1,0],["وأنا عائ