,88,"ن",1,0],["يا قدس إنّ النوى يقتات من كبدي","ورغم هذا تراني فيك هيمانا",89,"ن",2,0],["يا قُدسُ يا سِنَةً عَذرَاءَ خَبَّأَها","تَحتَ الجُفُونِ خَيَالٌ آبِقُ الفِكرَه",90,"ر",2,0],["يَا قُدسُ يا نَفحَةَ الغُفرَانِ مِنْ كَفَنٍ","جَاءَتْ وَ يَا رَمَقاً يَنثَالُ مِنْ خُضرَه",90,"ر",2,0],["يَا قُدسُ أَنتِ أَذَانُ العُنفُوَانِ ! نَعَمْ","وَ ذَا مَطَافُ الصَّدَى مُستَجمِعاً فَخرَه",90,"ر",2,0],["يا قُدسُ ! يالَهْفَةَ الأكْبَاد صادقةً","ولهفَةً عمَّها الإعصارُ والغَضَبُ",91,"ب",1,0],["يا قُدسُ! يَا نجْوى الزَّمان ولَهْفةَ ال","أُفُقِ اُلمُطِلِّ على رُبَاكِ ! فأجْملي",92,"ل",2,1],["يَا قُدسُ ! يَا إشراقة الفَجْر النَّدِ","يِّ وبسمةً طَلَعتْ مَع الصُّبْحِ الجَلِي",92,"ل",2,0],["يَا قُدسُ! يَا عِطرَ الدُّهور ونفحةً","مَا جَت على الأمَلِ الغنيِّ المرفِلِ",92,"ل",1,0],["يا قُدسُ! يا رفَّ الحَنين وخَفْقةً","مِن كلِّ قَلبٍ خَاشعٍ متبتِّلِ",92,"ل",1,0],["يا قُدسُ! يَا عَبَقَ الفُتُوحِ ونسمةً","سَارَتْ بريَّا المِسْكِ فوحَ قُرنْفُلِ",92,"ل",1,0],["يا قُدسُ ! يا نُورَ النُّبوَّةِ أشرقَتْ","في الدَّاجياتِ ويَا صَفاء المَنْهَلِ",92,"ل",1,0]]}