px?id=200771",""],[5900,"باسمكِ اللهمَّ يا ربَّ العبادْ","https://www.poetsgate.com/ViewPoem.aspx?id=150189",""],[192,"ما أظن","https://www.poetsgate.com/ViewPoem.aspx?id=16325",""],[5937,"يا قُدسُ","https://www.poetsgate.com/ViewPoem.aspx?id=211883",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6048,"يا قدسُ","https://www.poetsgate.com/ViewPoem.aspx?id=197745",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6097,"التّيه","https://www.poetsgate.com/ViewPoem.aspx?id=197427",""],[6102,"الشهيد ..","https://www.poetsgate.com/ViewPoem.aspx?id=182893",""],[5601,"نهر الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65792&r=&rc=131",""],[6185,"لنكبة وأخواتها !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87024&r=&rc=10",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[5355,"يا قدس مهلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87121&r=&rc=16",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[6234,"ديواني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6528&r=&rc=0",""],[6285,"أغنيات على أبواب القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86824&r=&rc=17",""],[6315,"ابتِهَالٌ على خُيُوطٍ مُقَدَّسَة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87582&r=&rc=7",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6318,"يا قُدسُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66166&r=&rc=16",""]],"verses":[["يا قَدَمي دونَكِ مَسعاةَ العُلى","قَد ضَمِنَ الإِقبالُ أَن لا تَعثِري",0,"ر",2,0],["يا قدوة العلماء عشْ مترقياً","وأخْفض بأمرك ما تحاول وارفع",1,"ع",1,0],["يا قُدسُ هَيِّئ مِن رِياضِكَ رَبوَةً","لِنَزيلِ تُربِكَ وَاِحتَفِل بِلِقائِهِ",2,"ا",3,0],["يا قَدَّها حَتّامَ تَغ","دو عاذِلاً وَتَروحُ جائِر",3,"ر",1,0],["يا قُدْوَةَ الجِيل الْجَديِدِ وَذخْرَهُ","عِشْ لِلْمُنَى فَرْداً بِغَيرِ نَديدِ",4,"د",1,0],["يا قدوةَ الأُمراءِ بل يا خيرةَ","الوزراءِ بل قادة الأَعْلامِ",5,"م",1,0],["يا قدسُ قد هاضَتْ عَزائِمُنا","دَيْجورُ غَيٍّ مادَ يَغْشانا",6,"ن",2,0],["يا قده يا ردفه لولاكما","ما شاقني ذاك الكثيب وبانه",7,"ن",2,0],["يا قُدوَةَ الإِسلامِ كَيفَ تَرَكتَني","بِيَدِ الصَلاحِ وَشَأنِهِ التَقصيرُ",8,"ر",1,0],["يا قدس قلبٍ في الهوى معراجه","سبحان من بالروح قد أسراك",9,"ك",1,0],["يا قدسُ مكةُ قد آستكِ باكيةً","لما أتاها بنعي الدينِ مَنعاك",10,"ك",1,0],["يا قَّدسَ الله منهم معشراً كرماً","بذَّتْ مآثرهم أوصاف من وصفا",11,"ف",2,0],["يا قديراً يا عظيماً شأنه","بهر الألباب من أهل الذكر",12,"ر",1,0],["يا قدوةَ العُلماء يا من عِلْمُه","بحرٌ ومنهلٌ فضلِه مَوْرودُ",13,"د",1,1],["يا قدوة الإِسلام يا عَلَم الهُدى","إنَّ الهُدى من نور علمك يظهر",14,"ر",1,0],["يا قدوة الأبدال هنيت الرضى","أنت الشفيع لك النبي شفيع",15,"ع",1,0],["يا قدَّسَ الله أَسْراَراً لأَخْيار","ورَوَّح اللهُ أَرْواحاً لأَطْهارِ",16,"ر",1,1],["يا قدوة الكبراء يا ذا السيّدُ","كم يا عليّ الشان شانك يُحمدُ",17,"د",1,1],["يا قديم الاحسان ذا الطول يا مع","طي أغثني وحياً بيسر وطول",18,"ل",1,0],["يا قدوتي يا نصرتي يا عدّتي","لا تعبدن ان المنية موعد",19,"د",1,0],["يا قدوةً للأولياءِ لك الولا","يا شاذلي باذا المباهج والعُلا",20,"ل",2,0],["يا قد قد حيرتَ فيكَ نواظري","لما انثنيت بعطفٍ اعجزَ حُسنُهُ",21,"ه",1,1],["يا قد لحاها اللَه كم نادت على","شمل الأنام بفرقة وبداد",22,"د",1,0],["يا قَدرَ إِسحقَ وَاللَ","هِ لا نَسِيتُك جُمعَهْ",23,"ع",2,0],["يا قدوة العرب الفخام وخير من","بلغت أرومتهم كمال السؤدد",24,"د",1,0],["يا قدس نبقى رغم كلّ جراحنا","قلباً على أنّات جرحكِ يخفقُ",25,"ق",1,0],["يا قدس ضاعت بعد ضيعتكِ الدنا","بغداد واليمن السعيد وجُلّقُ",25,"ق",1,0],["يا قدس يا مسرى الرسول ضياؤهُ","من صخرة المعراج فيضٌ مشرقُ",25,"ق",1,0],["يا قديم الهوى رجعتَ جديدا","......................قد ظننتُ السلوان َ أصلبَ عودا",26,"د",2,1],["يا قدس قد ضجَّ الحنين بخافقي","وعلى فؤادي أضرموا بالنار",27,"ر",1,0],["يا قدسُ ياأمَّ الجراحِ تجلدي","أنتِ اليقينُ وما سواك سرابُ",28,"ب",1,0],["يَا قُدسُ يَا أرضَ الرّباطِ تحيّةً","مِنْ كُلّ مَكْلُومٍ لِحُزنِك أبصْرَا",29,"ر",2,0],["يا قدسُ يا أخت الطّهارةِ والنّقا","لن يُفلِحَ ( الشّاباكُ ) ( والليكودُ )",30,"د",1,0],["يا قدسُ لا تأسَي وإن طالَ النّوى","فالحقُّ مهما غابَ سوفَ يعودُ",30,"د",1,0],["يا قدسُ إني ها هنا لأنادي","مَنْ ذا يُبَلّغكِ السلامَ النادي",31,"د",2,1],["ياقدسُ ياملكَ السّماءْ","يا قدسُ أرّقني نِداءْ",32,"ا",2,1],["ياقدوةً للعالمينَ وقائدًا","جَمَعَ الشُّعوبَ مُّوَحِّدًا مُتَفَوِّقا",33,"ق",2,0],["يا قُدسُ بَعدَكِ لم يَعدْ رشدٌ لذي","رشدٍ .. ولا لذوي الصَّوابِ صوابُ",34,"ب",1,0],["يا قُدسُ مهلاً لا يَصحُّ سوى الصَّحيحِ","ولا يَدومُ البَغيُ والإرهابُ",34,"ب",1,0],["يا قُدسُ أنتِ لنا وإن تتغيَّرِ","الأسماءُ والألقابُ والأثوابُ",34,"ب",1,0],["يا قدس لي في الحاكمين القابعين ..",".. على العروش الواهيات كلامُ",35,"م",1,0],["يا قدس هذي حالنا ومآلنا","عصفت بنا الأحزان والآلامُ",35,"م",1,0],["يا قدس مَن إلاّ صلاحُ الدين ..",".. ثانيةً ليومِكِ قائدٌ وإمامُ",35,"م",1,0],["يا قدَّها الميَّاسَ كُنْ مترفِّقًا","قد لا يحيطُ بوصفِ عبلةَ عنترُ",36,"ر",1,0],["ياقدسُ باتتْ على حقدٍ ضمائرُهمْ","وكلُّهمْ منْ عتيقِ الغدرِ مجبولُ",37,"ل",1,0],["يا قدسُ لا سيفٌ بنخوةِ ماجدٍ","يفني الفجورَ وفورةَ الأقداحِ",38,"ح",1,0],["ياقدسُ عذراً فما تُغني بكِ الخُطَبُ","وذي اليهودُ بأقصى اللهِ تصطخبُ",39,"ب",1,0],["ياقدسُ عذراً فما مِن بعدُ معتبةٌ","وقلَّ واللهِ فيكِ القولُ والعتبُ",39,"ب",1,0],["يَا قُدسُ يَا جُرْحًا يُمَزِّقُ قَلْبَنا","في كُلِّ قَلْبٍ مَأْتَمٌ لبُكائك",40,"ك",1,0],["يا قُدسُ يَا مَسرَى النبيِّ \"محمدٍ\"","ورُبَا \"يَسوعَ\" ومهدُهُ بفِنَائك",40,"ك",1,0],["يا قدسُ مهلا فان اللهَ نعمتُه","لا بد تأتيك في فضلٍ وفي كرمِ",41,"م",1,0],["يا قدسُ تحنو في الثنايا مهجةٌ","فتثورُ كالبركانِ عند تلطُّفِ",42,"ف",1,0],["يا قدسُ مثل الريح انَّي عابرٌ","لكنَّ مجدَك باقيا لم يختفِ",42,"ف",1,0],["يا قدس إليك فقد جئنا","لنزفَّ الفرحةَ للمللِ",43,"ل",1,0],["يا قدس أنواؤنا دمع يصاحبها","وبلبل في هوى الأوطان صدَّاح",44,"ح",1,0],["يا قدسُ لو متْنا جميعاً كلَّنا","كي تسعدين فما فقدْنا فألَنا",45,"ن",2,1],["يا قدسُ لو متْنا جميعاً كلَّنا","لو تسعدين فما فقدْنا فأ