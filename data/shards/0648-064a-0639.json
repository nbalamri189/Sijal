مدحاً في جواد","https://www.poetsgate.com/ViewPoem.aspx?id=27813",""],[51,"يرى ما وأى عنه الرجاءُ كما وأى","https://www.poetsgate.com/ViewPoem.aspx?id=27638",""],[32,"ويعجبني من جعفرٍ أنّ جعفراً","https://www.poetsgate.com/ViewPoem.aspx?id=15997",""],[30,"أَقُولُ لِنَفْسِي وَاقِفاً عنْدَ مُشْرِفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20517&r=&rc=11",""]],"verses":[["وَيُعرَفُ غَيري بِلا ميسَمٍ","مُبينٍ وَلا غُرَّةٍ ضاحِيَه",0,"ي",2,0],["وَيَعودُ بِالرَأسِ الطَمو","حِ العَينِ مِطراقاً أَميما",1,"م",2,0],["وَيُعلِفنَ الذَميلَ وَلا سَبيلٌ","إِلى الغُدرانِ وَالنُطَفِ الطَوامي",2,"م",2,0],["وَيَعرِفُني العَدُوُّ بِوَقعِ رُمحي","إِذا ما الوَجهُ مُوَّهَ بِالسُهومِ",3,"م",1,0],["وَيَعرُقوني بِالأَذى كُلَّما","لانَ لَهُم مَسِّيَ عَرقَ العِظام",4,"م",1,0],["وَيُعنِتُها الحادونَ أَو تُوسِعَ الخُطا","إِلى قُربِ دارِ المَوقِفِ المُتَضائِقِ",5,"ق",1,0],["وَيُعجِبُني البِعادُ كَأَنَّ قَلبي","يُحَدِّثُ عَن عَدِيَّ بِنِ الرِقاعِ",6,"ع",1,0],["وَيَعودُ مُرَّ الطَعمِ لا","عَذبُ المَذاقِ وَلا مَسوسا",7,"س",2,0],["وَيَعلَمُ جُرحُ صارِمِهِ","بِأَنَّ الرُمحَ سابِرُه",8,"ر",2,0],["وَيَعلَمُ مَن يُنازِلُهُ","بِأَنَّ المَوتَ آسِرُه",8,"ر",2,0],["وَيُعجِبُني أَطيطُ الرَحلِ تَرمي","أَزِمَّتُهُ السُهولَ إِلى الوُعورِ",9,"ر",1,0],["وَيُعطيكُما اللَهُ نَفسَ الحَسو","دِ رِقّاً مُسَلَّمَةً أَو أَسارى",10,"ر",2,0],["وَيَعجَبُ مِن غَضَبي جَهلَةً","وَمَن ذا يُضامُ فَلا يَغضَبُ",11,"ب",1,0],["وَيَعودَ وَجهُ الشَمسِ","لا نَقعٌ عَلَيهِ وَلا ضَبابُ",12,"ب",1,0],["وَيُعجِبُني مِنكَ النَسيمُ إِذا هَفا","أَلا كُلَّ ما سَرى عَنِ القَلبِ مُعجِبُ",13,"ب",1,0],["وَيُعجِلنَ الصَريخَ وَهُنَّ زَورٌ","إِلى الأَعداءِ يُرسِلنَ اللُعابا",14,"ب",2,0],["وَيَعذِلُني صَحبي وَيُسبِلُ دَمعَهُ","خَليلي هُذَيمٌ بَلَّ هامَتَهُ القَطرُ",15,"ر",1,0],["وَيَعذِلُنِي صَحبي وأُعرِضُ عَنهُمُ","فَهُم لا رَضُوا عَنِّي وَعَنكَ غِضابُ",16,"ب",1,0],["وَيَعلَمُ أَنَّني فَرَطٌ لِحيِّ","حَمَوْا خُطَطَ المَعالي بِالعوالي",17,"ي",1,0],["وَيَعذِلُني صَحبي وَيَعذُرُني الهَوى","وَهَل يَستَطيعُ الصَبُّ أَن يَتَجَلَّدا",18,"د",2,0],["وَيُعشي عُيونَ النَّاظِرينَ وَكُلُّهُم","يُقَلِّبُ في أَنوارِهِ لَحظَ أَرمَدا",18,"د",2,0],["وَيَعْتادُهُ عِنْدَ الندى أَرْيَحِيَّةٌ","كَما هَزَّ أَعْطافَ الخَليعِ طِلاءُ",19,"ا",2,0],["وَيَعْلَمُ أَنّي أَستَنيمُ إِلى الرَّدى","بِها حِينَ يَسْتَشْري عَلَيْها هَوانُها",20,"ن",3,0],["وَيَعْذُلُني خِلِّي وَيَزْعُمُ أَنَّهُ","نَصيحٌ وَهَلْ في العاذِلينَ نَصيحُ",21,"ح",1,0],["ويَعْتادُني ذِكْرى العَقيقِ وأهْلِهِ","بحيثُ الحَمامُ الوُرْقُ شاجٍ هَديلُها",22,"ل",3,0],["ويَعْذُلُني منْ غِلْمةِ الحيّ باسِلٌ","على شيمَتَيْهِ مَسْحةٌ منْ نِزارِهِ",23,"ر",2,0],["ويُعْجِبُني نَفْحُ العَرارِ وربّما","شَمَخْتُ بعِرْنيني وقد فاحَ عَنْبَرُ",24,"ر",1,0],["ويعلَمُ أنّ سَيفَكَ عن قَليلٍ","يَشوبُ منَ العَدُوِّ دَماً بحِقْدِ",25,"د",1,0],["ويعلمُ أن الشوقَ أهدى فما لَهُ","يُشيرُ بأطرافِ القَطيعِ المُحَرَّمِ",26,"م",1,0],["ويعطي حياة .. بلا","نيوب ولا مصرع",27,"ع",1,0],["وَيُعطي القَنا الخَطِّيَّ في الحَربِ حَقَّهُ","وَيَبري بِحَدِّ السَيفِ عُرضَ المَناكِبِ",28,"ب",1,0],["ويُعْرِبُ عمّا في الضّميرِ كأنّما","قصَدْنا سَطيحا أو حُبِسْنا الى شِقِّ",29,"ق",1,0],["وَيُعْلِمُ ثَوْبَ الْمَجْدِ بِالْخُلُقِ الرِّضَى","كَمَا يُعْلِمُ الثَّوْبَ الطِّرَازُ أَوِ الرَّقْمُ",30,"م",1,0],["ويَعْتَدُّ منْكَ المُلْكُ والدِّينُ والوَرى","بكافِي الدّواهِي والهُمامِ المؤيَّدِ",31,"د",1,0],["وَيُعْطي الرِّمَاحَ السَّمْهَرِيَّةَ حَقَّهَا","وَيَضْمَنُ عُتْبَى الدَّهْرِ وَالدَّهْرُ عَاتِبُ",32,"ب",1,0],["وَيُعجِبُهُ صَفحي لَهُ وَتَحمُّلي","وَذو الجَهلِ يُحذي الفُحشَ مَن لا يُعاجِلُه",33,"ل",2,0],["وَيُعقَلُ إِن نابَت عَلَيهِ عَظيمَةٌ","إِذا ما أُناسٌ موسِعونَ تَغَيَّبوا",34,"ب",3,0],["وَيُعقَدُ مُؤتَمَرٌ لِلسَلامِ","فَنَخرُجُ مِنهُ إِلى مُؤتَمَر",35,"ر",1,0],["وَيُعطي عَطاءً تَنتَهي دونَهُ المُنى","عَطاءَ وَهوبٍ لِلرَغائِبِ مُجزِلِ",36,"ل",1,0],["وَيَعذُبُ لي مِن غَيرِها فَأَعافُها","مَشارِبُ فيها مَقنَعٌ لو أُريدُها",37,"د",3,0],["وَيَعُدُّهُ أُدَبَاؤُهُمْ","أَسْنَى ثَوَابٍ لِلأَدَبْ",38,"ب",1,0],["وَيَعُدُّهُ عُلَمَاؤُهُمْ","بِالْعِلْمِ مُتَّصِلَ السَّبَبْ",38,"ب",1,0],["وَيَعْبُدُ الطَّيْفَ مِنْهَا","في مَأْمَنٍ مِنْ رَقِيبِ",39,"ب",1,0],["وَيَعْقِدُ أَوْلِيَاءُ الله عَقْداً","يَزِيدُ جَلالَهُ قُدْسُ المَكَانِ",40,"ن",1,0],["وَيَعْدُ هَلْ أَذْكُرُ مَا صَاغَهُ","يُوسُفُ مِنْ آيِ الْعُلَى فِي نِظَامْ",41,"م",1,0],["وَيُعْوِزُنَا الإِخْلاصُ فِي كُلِّ مَطْلَبٍ","وَيُعْوِزُنَا الْحُلْقُ المَتِينُ المُقَوَّمُ",42,"م",1,0],["وَيَعلمُ رَبّي أَنَّ قَلبي يُحِبُّها","عَلى تِلكَ مِن حالٍ مَتينُ العلائِقَ",43,"ق",1,0],["ويَعيب قوماً بالخيا","نة والخيانة بعض عابه",44,"ب",2,0],["ويعلم كيف يدّرع المعالي","ويعرِف كيف يَبْتِدر المَراما",45,"م",2,0],["ويعض من مطاعمنا غذاء","تُحاك على العظام به اللحوم",46,"م",1,0],["وَيَعلَمُ مَن يُحارِبُ أَنَّ قَيساً","صَناديدٌ لَها اللُجَجُ الغِمارُ",47,"ر",1,0],["وَيَعقوبُ مِنّا زادَهُ اللَهُ حِكمَةً","وَكانَ اِبنُ يَعقوبٍ أَميناً مُصَوَّرا",48,"ر",2,0],["وَيَعلَمَ المُعيا بِهِ وَالسابِقُ","ما أَنتَ إِن ضُمَّ عَلَيكَ المازِقُ",49,"ق",1,0],["وَيَعلَمُ أَكفائي مِنَ الناسِ أَنَّني","أَنا الفارِسُ الحامي الذَمارَ المُناجِدُ",50,"د",1,0],["وَيَعرِضُ في أَهلِ المَواسِمِ نَفسَهُ","فَلَم يَرَ مَن يُؤوِي وَلَم يَرَ داعِيا",51,"ي",2,0],["وَيَعرُبُ يَنميهِ لِقَحطانَ يَنتَمي","لِهودٍ نَبِيَّ اللَهِ فَوقَ الحَبائِكِ",52,"ك",1,0],["ويعتقنا المشفّع من جحيم","فلا عجبٌ له منا الولاء",53,"ا",2,0],["ويعجبُ الدمعُ حين حينَ يجرحها","وما العدَالة إلا حيثما جرحت",54,"ت",1,0],["ويعذلني من ليس يدري صبابتي","فأصرفه من حيث يدري ولا يدري",55,"ر",2,0],["ويعرض عن كيد العدا لاحتقارهم","بلا قاصدٍ ماشٍ ولا حائمٍ صقر",55,"ر",1,0],["ويعجبني طرفٌ تدرُّ دموعه","على حسنه الغالي فلله درّه",56,"ر",2,0],["ويعجبهُ فعلُ الجميل مطابقاً","فيحفظ علياه ويبذل وفره",57,"ر",2,0],["ويعبق بينكم في النحر عرفٌ","كأنَّ المسك بعضُ دم النحير",58,"ر",1,0],["ويعلو على تبر السبائك حظّها","فإن شئت حاكي بالسبائك أو احكي",59,"ك",2,0],["ويعجبني رمل المنجم باسمه","وما ذاك إلا حبّ من حلَّ بالرمل",60,"ل",1,0],["ويعذلني من لا يهيم وأدمعي","كجدوى عماد الدين سابقة العذل",60,"ل",1,0],["ويعلم بأسي من جميل وفائه","فما ضرَّه بالقول لو يتجمَّل",61,"ل",1,0],["ويعلم أنَّ الحمدَ والذمَّ للفتى","حذيَّتُهُ في إذنه وحجابِهِ",62,"ب",2,0],["ويعطي فيكفي بدءُ جَدْواه عَودَها","ألا هكذا فليَمنع اليومُ رِفْدَ غدْ",63,"د",1,0],["ويُعدُّ ظلماً أن يَعُد","دَ المخطئين كمن تعمَّدْ",64,"د",1,0],["ويعَضُدُني صبري ويُغْفِلُ قاسمٌ","مُعِاضدَتي والعَقْر من زمني عَقر",65,"ر",1,0],["ويعلمُ ذو التمييز أنك مُوجعٌ","توقَّرَ باديه وخافيه يختلطْ",66,"ط",1,0],["ويعتفي فضله العزوف إذا","لم يلتمس فضل غيره الجشِع",67,"ع",1,0],["ويعرضُ عِلقَ الصدرِ من حُرِّ شعره","على القوم لا يدرون ما قيمة العلق",68,"ق",1,0],["ويُعوزِكْ الذي ترضى لِمثلي","وإن لم يُعْوزِ الرأيُ الجميل",69,"ل",1,0],["ويعجُزني صبرُ أضعافِه","لما دونَه أمَلُ الآملِ",70,"ل",1,0],["ويعولُني فعِيالتي","حَقٌّ عليه كما براني",71,"ن",2,0],["وَيَعوذُ بِالأَرطى إِذا ما شَفَّهُ","قَطرٌ وَراحَتهُ بَلِيلٌ زَعزَعُ",72,"ع",1,0],["وَيَعتَرِفُ البَكرِيُّ ما دامَتِ العَصا","لِذي العِزِّ وَالبَكرِيُّ ما اِسطاعَ ظالِمُ",73,"م",1,0],["وَيَعشَقُ مِنكَ البَأسَ وَالحِلمَ وَالنَدى","كَذَلِكَ مَن يَنظُرُ إِلى الحُسنِ يَعشَقِ",74,"ق",1,0],["وَيَعيشُ مِثلَ العَنكَبوتِ يَعِش","في الناسِ مَذموماً وَمُمتَهِنا",75,"ن",2,0],["وَيَعودُ بِالأَغصانِ يَبريها","سُيوفاً أَو قَنا",76,"ن",2,0],["وَيُعرِضُ لا يُكَلِّمُني دَلالاً","فَيَغلِبُهُ عَلى ذاكَ اِبتِسامُ",77,"م",1,0],["ويعبَقُ منه أريجُ الغَرامِ","ونَفْحُ الشَّبابِ الحَيِيِّ السَّعيدْ",78,"د",1,0],["ويعيشُ في كونٍ عقيمٍ ميِّتٍ","قَدْ شيَّدتْهُ غباوةُ الأحقابِ",79,"ب",1,0],["ويعيشُ جبَّاراً يحدِّق دائماً","بالفجر بالفجرِ الجميلِ النَّائي",80,"ي",1,0],["وَيَعجِبُني مِن جَعفَرٍ أَنَّ جَعفَراً","مُلِحٌّ عَلى قُرصٍ وَيَبكي عَلى جُملِ",81,"ل",1,1],["ويعقب العرس الذي","افرح قوما مأتم",82,"م",1,0],["ويعتز بالصرح الذي شرفاته","حوته كأن الصرح لا يتهدم",83,"م",1,0],["ويعيش مسروراً بها آهٍ فقد","هبت على الآمال ريحٌ زعزع",84,"ع",1,0],["ويعرق منها الجسم في كل ليلة","وتنفث من سُل دماً حين تسعلُ",85,"ل",1,0],["ويعُزَّ ملككما ويلحظَ أمةً","أغرى الزمان بها الصروف تنكُّرا",86,"ر",2,0],["ويعجبني منك ألتقى حين لا تقى","وجدك حين الهازلون كثير",87,"ر",1,0],["وَيُعِدُّ الضَريحَ مِن مَرمَرِ الخُل","دِ الكَريمِ المُهَذَّبِ المَصقولِ",88,"ل",1,0],["وَيُعَلِّمُ كُلَّ مُطَوَّقَةٍ","شَجَناً في الدَوحِ تُرَدِّدُهُ",89,"د",2,0],["وَيَعي ما تُسِرُّهُ مِن كَلامٍ","وَيُؤَدّي كَما وَعاهُ الكَلاما",90,"م",2,0],["ويَعْذِلُني السّفِيهُ على بُكائي","كأَنِّي مُبْتَلىً بالحزنِ وَحدِيْ",91,"د",2,0],["وَيُعيرُني جَذبُ الزِمامِ لِقَلبِها","فَمَها إِلَيكِ كَطالِبٍ تَقبيلا",92,"ل",2,0],["وَيَعرِفُ الأَمرَ قَبلَ مَوقِعِهِ","فَما لَهُ بَعدَ فِعلِهِ نَدَمُ",93,"م",1,0],["ويُعجبُني أن تُسقيَا باكرَ الحَيَا","بأبطحَ وسمِيٍّ تراه هجانِ",94,"ن",1,0],["وَيُعطيهِ مَرجُوَّ العَواقِبِ مُسرِعاً","إِلَيهِ رُكوبُ الأَمرِ تُخشى عَواقِبُه",95,"ب",2,0],["وَيُعرَفُ المَرذولُ مِن غَيرِهِ","بِمَن لَحى المَبتولَ أَو أَسعَدَه",96,"د",2,0],["وَيُعجِبُني فَقري إِلَيكَ وَلَم يَكُن","لَيُعجِبُني لَولا مَحَبَّتُكَ الفَقرُ",97,"ر",1,0],["وَيُعقِبُ المَرءَ بُرءً مِن صَبابَتِهِ","تَجَرُّمُ العامِ يَأتي ثُمَّ قابِلُهُ",98,"ل",2,0],["وَيَعرِفُني مَعروفُهُ حينَ مَعشَرٌ","يَرونَ عُقوقَ المالِ أَن يَعلَموا عِلمي",99,"ي",1,0],["وَيَعِزُّ جانِبُهُ فَيَظلِمُ نَفسَهُ","لِعُفاتِهِ بِالجودِ إِن لَم يُظلَمِ",100,"م",1,0],["وَيُعجِبُني فيكِ أَن أَستَدي","مَ صَباباتِ نَفسي وَأَشجانَها",101,"ن",3,0],["ويَعْلَمُ أنَّ السِّلْمَ كانَ سَلامَةً","لَدَيْهِ وظِلاً آذِناً بِزَوالِ",102,"ل",1,0],["ويعودُه أعداؤُّه وأشدُّ مِنْ","مَرَضِ المريضِ عيادةُ الأعداءِ",103,"ا",2,0],["وَيَعتادُني مِن خَمرِ مَعنايَ نَشوَةٌ","أَوَدُّ سُروراً أَن يَدومَ بِها سُكري",104,"ي",1,0],["وَيُعرِضَ عَن رَدِّ الجَوابِ لِسائِلٍ","وَقَد كُنتَ لَم يَعرَف لِسائِلِكَ الرَدُّ",105,"د",1,0],["وَيَعجَبُ مِنّي إِن تَمَنّيتُ عَتبَهُ","وَحَسبُ المَنايا أَن يَكُنَّ أَمانِيا",106,"ي",2,0],["وَيُعوِزُ الفِكرُ فيهِ إِن أُريدَ لَهُ","وَصفٌ وَيَفضُلُ مَرآهُ عَنِ الحَدَقِ",107,"ق",1,0],["ويعبث الدهر بحلو الجنى","وتستر الصبغة إثم السنين",108,"ن",1,0],["ويعقبنا وإياهُ سماحاً","ومغفرةً ويعفو عنْ كثيرِ",109,"ر",1,0],["ويعجبني منها تملُّقُ أهلِها","وقد زادَ حتّى ماؤُها يتملَّقُ",110,"ق",1,0],["وَيَعصي قَولَ مَن يَنهى","وَمَن يَعذُلُهُ فينا",111,"ن",2,0],["ويَعجَبُ أن يَرى منها رجالاً","يجوبون البلادَ مُناضِلينا",112,"ن",2,0],["ويَعيثُ في مجرى الهواءِ فما ترى","مَسْرَى جَنوبٍ أو مهبَّ شمالِ",113,"ل",1,0],["وَيَعلَمُ أَنَّ وَعدَ اللَهِ حَقٌّ","وَأَنَّ لَهُ الحُكومَةَ وَالوِلايَهْ",114,"ا",3,0],["وَيُعيدُ المَيتَ مِن آمالِها","مُشرِقَ الطَلعَةِ وَضّاحَ الجَبينْ",115,"ن",1,0],["وَيَعلو الحَقُّ بَينَ مُهَوِّلاتٍ","مِنَ الأَنباءِ باطِلُها زَهوقُ",116,"ق",1,0],["وَيُعِزُّهُم في العالَمينَ وَيَدَّعي","لَهُمُ المَفاخِرَ كُلَّها يَتَعَصَّبُ",117,"ب",1,0],["وَيَعتَدُّهُ نِمرٌ وَأَشياخُ قَومِهِ","أَجَلَّ مِنَ الأَسطولِ شَأناً وَأَعظَما",118,"م",2,0],["وَيَعذُلُني العَواذِلُ فيهِ جَهلاً","عَزيزٌ ما يَقولُ العاذِلانِ",119,"ن",1,0],["ويُعربُ عن سِرِّ الضُّلوعِ شحوبُها","إذا ما تلاقينا فبئْسَ إذنْ زَعْمي",120,"ي",1,0],["وَيَعتَرِقُ النَقنَقَ المُسبَطِرُّ","وَالجَأبُ ذا العانَةِ المِسحَلا",121,"ل",2,0],["وَيَعفو وَيَصفَحُ عَن مَعشَرٍ","وَيَخضِبُ مِن آخَرينَ السِلاحا",122,"ح",2,0],["وَيُعْجِبُهُ أَنّي نَحِيفٌ وأَنّه","سَمِينٌ يَسُرُّ الناظِرينَ طَرِيرُ",123,"ر",1,0],["ويُعجِبُهُم مَن جَدُّ جَدَّيْهِ بُطْرُسٌ","وَيحزنُهُمْ مَنْ جَدُّ جَدَّيْهِ جَحْدَرُ",124,"ر",1,0],["ويُعجبني أنني شاعرٌ","وقولُ البريَّةِ ما أشعرَهُ",125,"ر",2,0],["ويَعدِلُ في شَرْقِ البِلادِ وغَربها","على أنّهُ للبِيضِ والسُّمْرِ ظالم",126,"م",1,0],["ويَعنُفُ في الهيجاءِ بالقِرْن رِفْقُهُ","وأعنَفُ ما يسطو به السيْفُ أرفَقُه",127,"ق",2,0],["ويعبق ذاك الترب من أوجه الدجى","كما فاح من نثر الأجنة أعبقه",127,"ق",2,0],["ويَعْيَا بما يأتي خطيبٌ وشاعِرٌ","وإن جاوز الإطناب واستغرق الوصفا",128,"ف",2,0],["ويُعْطي الجِزا والسلمَ عن يدِ صاغرٍ","ويقضي وصدرُ الرّمحِ فيه قصيد",129,"د",1,0],["ويعدو وقَونَسُه كوكبٌ","وسُنْبُكُه من أديمِ الصَّفا",130,"ا",1,0],["وَيَعلَمُ اللَهُ عَلى عَرشِهِ","ما طِبِّيَ الماءُ وَلا دائي",131,"ا",2,0],["وَيُعمِلُ الطَرفَ نَحوي إِن مَرَرتُ بِهِ","حَتّى لَيُخجِلُني مِن حِدَّةِ النَظَرِ",132,"ر",1,0],["وَيُعجِبُني وَجيفُ الكا","سِ بَينَ النايِ وَالوَتَرِ",133,"ر",1,0],["وَيُعطيكَ ذُلّاً إِذا رُعتَهُ","كَما ذَلَّ لِلقَدَمِ المِربَدُ",134,"د",1,0],["وَيَعطِفُ كِندِيٌّ عَلَيهِ وَظالِمٌ","مَآثِرَ أَيّامٍ تَطيبُ وَتَرحُبُ",135,"ب",1,0],["وَيَعتَري النَفسُ إِنكارٌ وَمَعرِفَةٌ","وَكُلُّ مَعنىً لَهُ نَفيٌ وَإيجابُ",136,"ب",1,0],["وَيُعجِبُني دَأبُ الَّذينَ تَرَهَّبوا","سِوى أَكلِهِم كَدَّ النُفوسِ الشَحائِحِ",137,"ح",1,0],["وَيَعبُرُ الحَيُّ بِالخالي فَيَعبَرُهُ","وَكَم رَأى ذاتَ أَلوانٍ فَما اِعتَبَرا",138,"ر",2,0],["وَيَعبِسُ وَجهُ الدَهرِ وَالمَرَءُ ضاحِكٌ","وَيَضحَكُ هُزءاً وَالوُجوهُ عَوابِسُ",139,"س",1,0],["وَيَعلَمُ كُلٌّ أَنَّ لِلخَيرِ مَوضِعاً","وَفَضلاً عَلى إِثباتِهِ أَجمَعَ الدُهَم",140,"م",1,0],["وَيَعُدُّ كَونَكَ في الزَمانِ بَليَّةً","فَاِصبِر لَها فَكَذاكَ هَذا العالَمُ",141,"م",1,0],["وَيُعجِبُني شَيآنِ خَفضٌ وَصَحَّةٌ","وَلَكِنَّ رَيبَ الدَهرِ غَيَّرَ شَيّاني",142,"ي",1,0],["ويُعْدَمُ عنْدَه في الجودِ مَطْلٌ","ومُعْدُومٌ مع العِتْقِ الحِرَانُ",143,"ن",1,0],["وَيَعود الرَبيع غضاً فأَمشي","جانياً للأزهار بين الرياض",144,"ض",1,0],["وَيَعلو إلى أَن يحسب المرء أنه","مناجٍ لأبواب السموات يقرع",145,"ع",1,0],["ويعطفني في الهوى ضعفُها","وأنسَى بأنِّي في أسرها",146,"ه",2,0],["ويعنو إليك الجنُّ والإِنسُ طاعةً","كأنكَ فيهم عن سليمان تَحْكُمُ",147,"م",1,0],["وَيَعَضُّ أَرْدَافَ الحِسَانِ وماله","كَفٌّ وَلَكِنْ فُوهُ مِن أَعْدَى الحراب",148,"ب",1,0],["ويَعْرِفُ للكَوْنِ ما في يَدَيْهِ","وَما الكَوْنُ إِلا نَذِيرُ الفَسادِ",149,"د",1,0],["ويَعيشُ مُضْطَلِعاً بأحزانِ","الشَّبيبَةِ والمَشِيبْ",150,"ب",1,0],["وَيُعِيرُ مِنْ حَسَنَاتِهَا قَلْبَيْكُمَا","آيَاتِ سِحْرٍ لِلْعُقُولِ حَلالِ",151,"ل",1,0],["وَيَعْتَسِفُ التُّرْكُ فِي كُلِّ صَوْ","بٍ فَهَذَا يَرُوحُ وَذَا يَغْتَدِي",152,"د",2,0],["وَيَعَضُّهُ نَابُ الصَّوَاعِقِ مُحْرِقاً","فَيَرُدُّهُ كِسَراً وَلاَ يَتَثَقَّبُ",153,"ب",1,0],["وَيُعِيضُ مِنْك وَكُنْتَ جَوْهَرَةَ الحِمَى","صَوْغُ الكلامِ مُرَصعاً وَمُزَخْرَفا",154,"ف",2,0],["وَيَعِمُّ كُلَّ مَبَرَّةٍ بِعِنَايَةٍ","مِنْهُ فَلَمْ يُخْصِصْ بِهَا الْفُقَرَاءُ",155,"ا",2,0],["وَيُعِدِّ الأَخْلاَق لِلنَّهْضَةِ الْكُبْرَى","وَيُنَمُّ النُّهَى وَيُذْكِ الشعُورَا",156,"ر",2,0],["وَيَعيشُ مِنْ رَامَ المَنيعَةَ","دُونَهَا أَجَمُ القَسَاورْ",157,"ر",1,0],["وَيُعَلِّمُ الوَحْشَ الأَسَى","وَيُلينُ أًحْجَارَ المَقابِرْ",158,"ر",1,0],["ويَعْرِفُ الْحَالَ مِمَّا قَبلَهُ فَيَرَى","لِكُلِّ طَارِئَةٍ عُوْداً إلى سَبَبِ",159,"ب",1,0],["وَيُعِيدُ وَجْهَ الغَيْبِ غَيْرَ مُحَجَّبٍ","وَيَرَدُّ خَافِيةً بِغَيرِ خَفَاءِ",160,"ا",2,0],["وَيَعْلَمَ أهلُ مكَّةَ حينَ سَارُوا","وأحزابٌ أَتَوْا مُتحَزِّبِينَا",161,"ن",2,0],["وَيُعِينُنَا اللهُ العَزِيرُ بقوَّةٍ","مِنْهُ وصِدْقِ الصّبْرِ سَاعَةَ نَلْتَقِي",162,"ق",2,0],["ويُعيد للذكرى صحائف كالضحى","بيِضًا، وأخرى كالذوائب سودا",163,"د",2,0],["ويعلِّمون ليجذبوا","من شاء أن يتعلما",164,"م",2,0],["ويعرب عما في الضمير كأننا","قصدنا سطيحا أو جلسنا إلى شق",165,"ق",1,0],["ويُعطي الرّماحَ السَّمْهريّة َ حقّها","ويضْمنُ عُقْبى الدَّهرِ والدهرُ عاتِب",166,"ب",1,0],["ويعود قبل العصر ، يقصد جدّها","في البيت ، يطري حمقه ويصافي",167,"ف",2,0],["ويعيد رؤيتها ويحضن ظلها","ويمد آمالا ، بلا أطراف",167,"ف",1,0],["ويعي ، فيتهم المنى ، ويعوده","حلم سخي الهمس والارجاف",167,"ف",1,0],["ويعفّ الظالم الجلّاد لو","لم تقلّده ضحاياه الحساما",168,"م",2,0],["ويعرفُ من أراد صميمَ شعبي","رَميِّاً أيَّ شاكلةٍ أصابا",169,"ب",2,0],["وَيُعْرَفُ المَرْذولُ مِنْ غَيرِهِ،","بمَنْ لحَى المَتْبُولَ أوْ أسعَدَهْ",170,"د",2,0],["وَيَعْقُبُ المْرءَ بُرْءاً منْ صَبابَتِهِ،","تَجَرُّمُ العَامِ يَأتي، ثمّ فابِلُهُ",171,"ل",2,0],["ويعشق منك البأس والحلم والنّدى","كذاك من ينظر إلى الحسن يعشق",172,"ق",1,0],["ويعتفيهم دونكَ الحِمامُ","فأنتَ روحٌ والورى أجسامُ",173,"م",1,0],["ويُعدُّ ظلماً أن يَعُدَّ","المخطئين كمن تعمَّدْ",174,"د",1,0],["ويعطي فيكفي بدء جدْواه عودها","ألا ها كذا فليمنع اليوم رفد غد",175,"د",1,0],["ويعجبني من جعفرٍ أنّ جعفراً","ملٌّ على قرصٍ، ويبكي على جملِ",176,"ل",1,1],["ويعلمُ ربّي أنَّ قلبي بذكرها","عَلَى تِلْكَ مِنْ حَالٍ مَتِينُ الْعَلائِقِ",177,"ق",1,0]]}