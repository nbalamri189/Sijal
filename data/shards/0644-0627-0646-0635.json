{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[74,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[382,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[473,"لا نصر الله أبا نصر","https://www.aldiwan.net/poem60021.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63852","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145847","المجتث"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27662","الكامل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105404","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112679","الرجز"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111312","السريع"],[4755,"لِأَنَّ صَنعَاءَ لا تُضِيءُ","https://www.poetsgate.com/ViewPoem.aspx?id=198020",""],[5183,"جلوة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=186442",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[5997,"الرحى جوعى","https://www.poetsgate.com/ViewPoem.aspx?id=214466",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""]],"verses":[["لإن صوحت من ماء وجهي نضارة","فلي سؤدد قد راق للعين شاحبه",0,"ب",2,0],["لأنصحنك نصحاً إن مشيت به","فيالهُ من سبيلٍ للعلى جددِ",1,"د",1,0],["لا نصح يجدي في مشوق جسمه","قد دقَّ حتى عاد كالعرجون",2,"ن",1,0],["لانَ صَخرٌ وأَبغضَ القومُ حرباً","حينَ ساءَت دُمىً وسالت دماءُ",3,"ا",2,0],["لأن صغير الدر يفضل قيمةً","على المعدن المسبوك وهو ثقيل",4,"ل",1,0],["لا نَصَرَ اللَهُ أَبا نَصرِ","فَإِنَّهُ عُسرٌ بِلا يُسرِ",5,"ر",1,1],["لا نصارى ترضى بهنَّ هجاءً","لمهاجٍ ولا كلابُ النصارى",6,"ر",2,0],["لأنَّ صَمتَكَ أعتى","منَ الكلامِ المُغَلّفْ",7,"ف",1,0],["لا نصرَ إلا بوصلِ يطمئِنُّ لهُ","قلبي وإلا فهذا النصرُ خذلانُ",8,"ن",1,0],["لا نصَّ أجلي من نصوص كتابه","قد رتلتْه رُسله ترتيلا",9,"ل",2,0],["لأن صد عني من أحب فطالما","علي بوصل جاد دهراً وأنعما",10,"م",2,0],["لا نصّ في التقبيل للأعتابِ","لكن عليهِ عملُ الأصحابِ",11,"ب",1,0],["لأن صدغ ابن اخي مرسل","على محياه ولم يحجب",12,"ب",1,0],["لِأَنَّ صَنعَاءَ لا تُضِيءُ","أَيَرحَلُ اللَّيلُ؟! أَم يَجِيءُ؟!",13,"ي",2,1],["لأن صدري إذا ضاق الصدور بما","حملته فهو حاشى أن يضيق عيا",14,"ي",2,0],["لأنّ صراخَهُ مُوثقْ","لهُ في أضلعي خندقْ",15,"ق",1,1],["لا نصرناْ الله في سبعٍ طواها","حرب زيف زادها نيل الفوائد",16,"د",1,0],["لا نص فيها ولا الإجماع تم لها","وهل يتم وأهل البيت في جنب",17,"ب",1,0]]}