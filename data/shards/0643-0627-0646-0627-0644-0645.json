مولاي ......","https://www.poetsgate.com/ViewPoem.aspx?id=190528",""],[5790,"ولم تر عيناي من قبله","https://www.poetsgate.com/ViewPoem.aspx?id=112165",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5828,"وكأس من الشَّمْس مخلوقة","https://www.poetsgate.com/ViewPoem.aspx?id=190972",""],[5956,"رَفَّ البليبل","https://www.poetsgate.com/ViewPoem.aspx?id=183637",""],[5956,"حتى المَكيف قد أقام حِدادا","https://www.poetsgate.com/ViewPoem.aspx?id=192400",""],[5956,"النزفُ ابتدا","https://www.poetsgate.com/ViewPoem.aspx?id=192494",""],[5956,"إنا جميعاً في الأصول سواء","https://www.poetsgate.com/ViewPoem.aspx?id=192608",""],[5956,"ثيابي على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=192800",""],[5956,"صراع بين التفاؤل والتشاؤم","https://www.poetsgate.com/ViewPoem.aspx?id=207548",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[5966,"حلم الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=159347",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6069,"ومحمرةٍ من بنات الغصو","https://www.poetsgate.com/ViewPoem.aspx?id=105656",""],[6069,"وكم ليلةٍ عاطاني الراح بدرها","https://www.poetsgate.com/ViewPoem.aspx?id=105687",""],[6189,"فيروز أغنية العش الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83597&r=&rc=64",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""],[5355,"حظي عنيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87130&r=&rc=25",""],[5957,"فحبكَ عندي فراتٌ ونيلٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82451&r=&rc=90",""],[2696,"أنّى سَرَبْتِ وكنتِ غيرَ سَرُوبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27397&r=&rc=1",""],[6336,"أشواق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73400&r=&rc=6",""]],"verses":[["كَأَنَّ المَنايا إِن تَوَسَّدَ باعَهُ","تَيَقَّظُ في أَنيابِهِ وَهوَ نائِمُ",0,"م",1,0],["كانَ المَشيبُ وَراءَ ظِلٍّ قالِصٍ","لِأَخي الصِبا وَأمامَ عُمرٍ قاصِرِ",1,"ر",1,0],["كَأَنَّ المُكرَهَ المَعبوطَ مِنها","مَدوفُ الوَرسِ أَو رُبٌّ عَقيدُ",2,"د",1,0],["كَأَنّا لَم تُؤالِفنا","زَمانٌ لَيِّنُ الأَخدَع",3,"ع",1,0],["كَأَنَّ المُدامَ وَصَوبَ الغُمامِ","وَريحُ الخُزامى وَنَشرُ القُطُر",4,"ر",1,0],["كَأَنَّ المَطايا تَتَّقي مِن زُبانَة","مَناكِبَ رُكنٍ مِن نَضادِ مُلَملَمِ",5,"م",1,0],["كَانَ المِضَنَّةَ لِلنُّفُوسِ فَلَمْ","يَشْفَعْ بِهِ أَنْ ضَنَّ أَجْوَدُهَا",6,"د",3,0],["كَانَ المُحَامِي عَنْ قَضِيَّةِ قَوْمِهِ","بِمضَاءِ لاَ وَكَلٍ وَلاَ مُتَوَانِي",7,"ن",2,0],["كأن الموج في الدأما رجال","وهذا القصر بينهم خطيب",8,"ب",1,0],["كَأَنَّ المِسكَ خالَطَ طَعمَ فيها","بِماءِ المُزنِ يَطَّرِدُ الحَبابا",9,"ب",2,0],["كَأَنَّ المُرجِفينَ وَهُم نَشاوى","نَصارى يَلعَبونَ غَداةَ عيدِ",10,"د",1,0],["كَأَنَّ المُنعَلاتِ وَهُنَّ حُدبٌ","عِصِيُّ الضالِ يَخبِطُهُ الجَليدُ",11,"د",1,0],["كانَ المُمانِحَ في العَرِيَّةِ بَعدَما","أَلقى الشِتاءُ أَصِرَّةَ الأَشوالِ",12,"ل",1,0],["كَأَنَّ المِرطَ ذا الأَنيارِ يُكسى","إِذا اِتَّزَرَت بِهِ عَقِداً رُكاما",13,"م",2,0],["كان المَحالة منها الرَّدا","ح لم تعرُها الناحضات أهتبارا",14,"ر",2,1],["كأنَّ المَطَافِيلَ المواليه وَسطَه","يُجَاوبَهنَّ الخَيزُرَانُ المُثَقَّبُ",15,"ب",1,0],["كأنَّ المحاريبَ القيام بصدرهِ","لفرقةِ ذاك الصدر قد قوّست ظهرا",16,"ر",2,0],["كانَ المديح له عرساً بدولتِهِ","فأحسن الله للشعرِ العزا فيه",17,"ي",2,0],["كانَ المؤيد في يومي ندى وردَى","غيثاً لراجيه أو غوثاً للاجيه",17,"ي",2,0],["كانَ المُحيَّنُ ذئبَ رَدْهةِ دَهْرِه","ورجالُ دولتهِ ذئاب رِداهِ",18,"ه",1,0],["كَأَنَّ المَشرَفِيَّةَ في ذُراهُ","وَنيرانَ الحَجيجِ لَها سَعيرُ",19,"ر",1,0],["كَأَنَّ المَحالَ الغُرَّ في حَجَراتِها","عَذارى بَدَت لَمّا أُصيبَ حَميمُها",20,"م",3,0],["كَأَنَّ المُحِبَّ قَصيرُ الجُفونِ","لِطولِ اللَيالي وَلَم تَقصُرِ",21,"ر",1,1],["كان المعظَم في الخوا","قين الأميرَ على الصدور",22,"ر",1,0],["كَأَنَّ المَنايا في ضَميرِ ظَلامِهِ","هُمومٌ بِها فاضَ الضَميرُ المُحَجَّبُ",23,"ب",1,0],["كَأَنَّ المَعاني في فَصاحَةِ لَفظِها","نُجومُ الثُرَيّا أَو خَلائِقُكَ الزُهرُ",24,"ر",1,0],["كَأَنَّ المَوتَ لَم يَفجَع بِنَفسٍ","وَلَم يَخطُر لِمَخلوقٍ بِبالِ",25,"ل",1,0],["كأنَّ المحاسنَ غارَت عليكَ","فسَلَّت لدَيكَ سُيوفَ الفِتَن",26,"ن",1,0],["كان المروءةُ والفتوَّةُ والنَّدى","وابنُ الكمالِ الفاضلُ المتفضِّلُ",27,"ل",1,0],["كانَ المُهَلَّبُ لِلعِراقِ سَكينَةً","وَحَيا الرَبيعِ وَمَعقِلَ الفُرّارِ",28,"ر",1,0],["كَأَنَّ المَطايا إِذ عَدَلنا صُدورَها","بَعَثنا بِأَيديها الحَمامَ المُطَيَّرا",29,"ر",2,0],["كَأَنَّ المَنايا يَطَّلِبنَ نُفوسَنا","بِذَحلٍ إِذا ما حُمَّ يَوماً حِمامُها",30,"م",3,0],["كَأَنَّ المَحالَ الغُرَّ في حَجَراتِها","عَذارٍ بَدَت لَمّا أُصيبَ حَميمُها",31,"م",3,0],["كَأَنَّ المِلحَ خالَطَهُ إِذا ما","تَلَظّى كَالعَقيقَةِ في الظَلالِ",32,"ل",1,0],["كَأَنَّ المَنايا قَد قَرَعنَ صَفاتي","وَقَوَّسنَني حَتّى قَصَفنَ قَناتي",33,"ت",2,1],["كَأَنَّ المَنايا قَد قَصَدنَ إِلَيكُما","يُرِدنَكَ فَانظُر ما لَهُنَّ لَدَيكا",34,"ك",2,1],["كَأَنَّ المَوتَ قَد نَزَلا","فَفَرَّقَ بَينَنا عَجِلا",35,"ل",2,1],["كَأَنَّ المَنايا لَيسَ تَجري لَدى الوَغى","إِذا التَقَتِ الأَبطالُ إِلّا بِرائِكا",36,"ك",2,0],["كأنّ المُهْلَ في الأنبوب منه","إلى شَيِّ الوجوه له ابتِدارُ",37,"ر",1,0],["كَأنَّ المَنايا في الكَريهَةِ أَلفَيَت","على خلقها من خَلقِه صُوَرُ الجُندِ",38,"د",1,0],["كأنّ المَدى منهُ في قبضَةٍ","فإيّاكَ إيّاكَ من قبضته",39,"ت",2,0],["كأنَّ المنارةَ مِنْ تحتِهِ","قضيبُ نقا مثمرٌ بالقمرْ",40,"ر",1,0],["كَأَنَّ المَنايا الحُمرَ آلَينَ حِلفَةً","لِغَليومَ لا يُبقينَ في الناس باقِيا",41,"ي",2,0],["كَأَنَّ المُلكُ في عَينَيهِ حُلمٌ","يَلُذُّ بِهِ فَما يَألو رُقادا",42,"د",2,0],["كَأَنَّ المِسكَ تَخلِطُهُ بِفيها","وَرِيحَ قُرُنفُلٍ وَالياسَمينا",43,"ن",2,0],["كَأَنَّ المَطايا لَيلَةَ الخِمسِ عُلِّقَت","بِوَثّابَةٍ حُردِ القَوائِمِ شَحشَحِ",44,"ح",1,0],["كَأَنَّ المِسكَ وَالعَنبَ","رَ وَالكافُورَ في فيهِ",45,"ي",2,0],["كَأَنَّ المُضلِعاتِ عَلَونَ سَلمى","فَصُبنَ عَلى البَواذِخِ مِن ذُراها",46,"ا",3,1],["كانَ المُصيبَ بِسَهمِ الرَأيِ قَبضَتَهُ","وَالقائِلَ الحَقِّ مَوزوناً بِميزانِ",47,"ن",1,0],["كَأَنَّ المَطايا إِن غَدَونَ بِسُحرَةٍ","تَرَكنَ أَفاحيصَ القَطا في المَبارِكِ",48,"ك",1,0],["كَأَنَّ المُلاءَ البيضَ في يَدِ ناشِرٍ","عَلى الأُفُقِ الغَربيِّ يَنفُضُها نَفضا",49,"ض",2,0],["كأنّ المَجامرَ أذكَيْنَهُ","أوِ اغتَبَقَ الخمرَ حتى انتشَى",50,"ا",1,0],["كانَ المُغَنّونَ لَهُم خَزرَجٌ","فَصارَ داوُودُ لَنا خَزرَجا",51,"ج",2,1],["كانَ المُوادِعُ شَأوَ الفَضلِ مُستَتِراً","حَتّى إِذا رامَ تِلكَ الخُطَّةَ اِفتَضَحا",52,"ح",2,0],["كانَ المُشَفَّعَ في مَآرِبِهِ","عِندَ الفَتاةِ وَمُدرِكَ التَبلِ",53,"ل",1,0],["كَأَنَّ المَسجِدَ الجامِ","عَ عِندَ اللَيلِ بُستانُ",54,"ن",1,0],["كَأَنَّ المُلكَ لَم يَكُ قَبلُ شَيئاً","إِلى أَن قامَ بِالمُلكِ الأَمينُ",55,"ن",1,0],["كَأَنَّ المُلوكَ الزُهرَ حَولَ سَريرِهِ","وَمِنبَرِهِ الكِروانُ أَطرَقنَ مِن صَقرِ",56,"ر",1,0],["كَأَنَّ المُستَزيدي فَضلِ رَوحٍ","غَوارِبَ دَجلَةَ الجَونِ اِستَزادوا",57,"د",3,0],["كَأَنَّ المُهَيمِنَ أَوصى النُفوسَ","بِعِشقِ الحَياةِ وَإِحبابِها",58,"ب",3,0],["كأنّ المَنايا جيشُ ذَرّ عَرَمْرَمٌ","تَخِذْنَ إلى الأرْوَاحِ فيهِ مَسارا",59,"ر",2,0],["كأنّ المَثاني والمَثالِثَ بالضّحَى","تَجاوَبُ في غِيدٍ رُفِعْنَ طِوال",60,"ل",1,0],["كَان المَقامُ مَقَامَهُ إِنْ","كَانَ مَجْدٌ أَوْ خَطَرْ",61,"ر",1,0],["كَانَ المَلَثِّمُ لا يُخا","لِسُ مَقْتَلاً مِمَّنْ يُنَافِرْ",62,"ر",1,0],["كَأَنَّ المُدامَ الصَرفَ مالَت بِعِطفِهِ","كَما مالَ في الأُرجوحَةِ المُتَرَجِّحُ",63,"ح",1,0],["كانَ المَآرِب فيهِ حَتّى رابَني","وَرَمٌ بِعَينَيهِ أَبى أَن يخمَصا",64,"ص",2,0],["كَأَنَّ المَوتَ في الدُنيا حَديثٌ","لَقَد نَسِيَ الحَديثَ المُستَفاضا",65,"ض",2,0],["كأنَّ المصابيحَ الخوافقَ حَوْلَنا","سيوفُ وَغىً في ظلمةِ النَّقْعِ تلمَع",66,"ع",1,0],["كَانَا لِمِصْرَ وَأَهْلِهَا","عَضُداً يَصُولُ بِخَيْرِ زَنْدِ",67,"د",1,0],["كأن المنايا حسبنا من تصرفت","بهم وكأن الظفر منها مقلم",68,"م",1,0],["كان المساء الغضّ عند رجوعه","حقلا ربيعيّا ، ونهر سلاف",69,"ف",1,0],["كأنّ المسك يغلي حين تغلي","ويجري في الأواني حين تجري",70,"ر",2,0],["كان المساء يجرني كذبوله","وأجرّ خلف جنازتي ، أذيالي",71,"ل",2,0],["كأن الموج في الدأماء رجال","مهذا القصر تصفيق مهيب",72,"ب",1,0],["كأنَّ المعالي الآهلات 