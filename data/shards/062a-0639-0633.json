 كانا","https://www.poetsgate.com/ViewPoem.aspx?id=36844",""],[5690,"ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[5701,"حي في المغرب شعبا عربيا","https://www.poetsgate.com/ViewPoem.aspx?id=164613",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[445,"شكرا لمن أعطاك ما أعطاكا","https://www.poetsgate.com/ViewPoem.aspx?id=23016",""],[5923,"لغد أقول ....... ذاك دأبي قبل يوم الأفول","https://www.poetsgate.com/ViewPoem.aspx?id=146239",""],[5923,"سورية الميساء","https://www.poetsgate.com/ViewPoem.aspx?id=150626",""],[5939,"ثورة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=178590",""],[5961,"ماء الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=199791",""],[6046,"حدود... بلا حدود!","https://www.poetsgate.com/ViewPoem.aspx?id=37247",""],[6062,"وعد","https://www.poetsgate.com/ViewPoem.aspx?id=176606",""],[6070,"العنيد","https://www.poetsgate.com/ViewPoem.aspx?id=187816",""],[6070,"بيريزُ مَاتَ وطارتِ الغربانُ","https://www.poetsgate.com/ViewPoem.aspx?id=188857",""],[6099,"قانأ","https://www.poetsgate.com/ViewPoem.aspx?id=35798",""],[6237,"وحشة قلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77896&r=&rc=38",""]],"verses":[["تَعْساً لشِرْذِمَةٍ دبّوا الضّرَاءَ لهُ","أدْمى الشّحيحَةَ من أيْديهِمُ النّدَمُ",0,"م",1,0],["تَعِسَ الهَجرُ وَالَّذي شَأنُهُ الهَج","رُ مِنَ الناسِ كُلِّهم حاشاكِ",1,"ك",1,0],["تَعِسَ المُستَقِلُّ خَمسَ لَيالٍ","لِمُوافاةِ مَن بِأَرضِ العِراقِ",2,"ق",1,1],["تَعِسَ الغُرابُ لَقَد جَرى بِفِراقِ","هَلّا جَرى بِتَزاوُرٍ وَتَلاقِ",3,"ق",1,1],["تعِسَ العَذولُ أمَا دَرى أنّ الهَوى","خَفيَتْ على أرْبابِهِ أسْرارُهُ",4,"ر",2,0],["تَعَسَّفتُهُ بِالرَكبِ حَتَّى تَكَشَّفَت","عَنِ الصُهبِ وَالفِتيانِ أَرواقُهُ الخُضرُ",5,"ر",1,0],["تعس المخاصم إن لي لقصائداً","طرف المعاند دونهنّ غضيض",6,"ض",1,0],["تعست هذه الحياة وإن كا","نت لعمري خلابةً حسّاسه",7,"س",2,0],["تعسفتها فمزجت المياه","بالدم والطعم والحنظل",8,"ل",1,0],["تَعِسَ الحَريصُ وَقَلَّ ما يَأتي بِهِ","عِوَضاً مِنَ الإِلحاحِ وَالإِلحافِ",9,"ف",1,0],["تَعَسَّفَتْني أنْ رَأتْني امرَأً","لم ترني قَطُّ تَعَسَّفْتُها",10,"ت",3,0],["تعساً لها تعساً إذا ما عوت","ونزعةً للنفس نزّاعه",11,"ع",2,0],["تعسَّفتُه إمَّا لخفضٍ أناله","وإمَّا سآمَ الخفضِ والخفضُ يُسْأمُ",12,"م",1,0],["تَعِسَ اِمرُؤٌ لا يَستَفيدُ","مِنَ الرِجال وَلا يُفيد",13,"د",1,0],["تَعِسُ الحَظ وَهَل أَتعَسُ مِن","شاعِرٍ في أُمَّةٍ موحتَضَرَه",14,"ر",2,0],["تَعَسَّفتُ مِنهُ بَعدَما سَقَطَ النَدى","غَماليلَ يَخشى عَيلَها المُتَعَسَّفُ",15,"ف",1,0],["تَعَسَّفتُها لَمّا تَلاوَمَ صُحبَتي","بِمُشتَبِهِ المَوماةِ وَالماءُ نازِحُ",16,"ح",1,0],["تَعِسَ المَهاري غَيرَ مَهرِيٍّ غَدا","بِمُصَوَّرٍ لَبِسَ الحَريرَ مُصَوَّرا",17,"ر",2,0],["تَعِستُ فَما لَي مِن وَفاءٍ وَلا عَهدِ","وَلَستُ بِأَهلٍ مِن أَخِلّايَ لِلوُدِّ",18,"د",1,1],["تَعَسَّفتُها وَاللَيلُ قَد صَبَغَ الرُبى","بِلَونٍ مِنَ الدَيجورِ أَسوَدَ فاحِمِ",19,"م",1,0],["تَعْسِلُ منه جانباه إنْ عَدا","مثلَ اضطِرابِ السمهَرِيِّ المشرَعِ",20,"ع",1,0],["تَعِسَ الهَجرُ وَالَّذي شَأنُهُ الهَج","رُ مِنَ الناسِ كُلِّهِم حاشاكا",21,"ك",2,0],["تَعَسَّفتُها وَاللَيلُ مُلقٍ جِرانَهُ","وَجَوزاؤُهُ في الأُفقِ حينَ اِستَقَلَّتِ",22,"ت",1,0],["تَعِسَ الثعلبُ ما أخبثَهُ","فَدَعِي بَدراً وآسادَ العرِينْ",23,"ن",1,0],["تَعَسَّفتُهُ بِاللَيلِ لَم يَهدِني لَهُ","دَليلٌ وَلَم يُحسِن لِيَ النَعتَ خابِرُ",24,"ر",1,0],["تَعَسّفُوا البِيدَ مُلتَفّاً بأسوُقهِمْ","مِثلُ الأساوِدِ في سَجعِ القُماريّ",25,"ي",1,0],["تَعساً لِمَن ضَيَّعَ المَحارِمَ يَو","مَ الرَوعِ يَجتاحُ مِن صَواحِبِها",26,"ب",3,0],["تَعِسَ الفُؤادُ أَلا يُصابِرُها","حَتّى تَكونَ كَمازِحٍ مَزَحا",27,"ح",2,0],["تعساً لثائرة الحروب فإنها","تردي النفوس وتتلف الأبدانا",28,"ن",2,0],["تَعِست مُقارَنَةُ اللَّئِيمِ فَإِنَّها","شَرَقُ النُّفُوسِ وَمِحْنَةُ الْكُرَمَاءِ",29,"ا",2,0],["تَعَسَ امْرُؤٌ نَسِيَ الْمَعَادَ وَمَا دَرَى","أَنَّ الْمَنُونَ إِلَيْهِ بِالْمِرْصَادِ",30,"د",1,0],["تعساً لها من أمة… أزعيمها","جلادها وأمينها جاسوسها ؟",31,"س",3,0],["تَعس الفَألُ في تَغَرُّبِهِ كا","نَ صَدوقاً وَفي الإِيابِ كَذوبا",32,"ب",2,0],["تَعسها يَنُمُّ عَلى","حُسنِها كَمِعجَرِها",33,"ر",3,0],["تَعس المَظلومُ بَعدَكُمُ","أَن يَرى عَدلاً وَإِنصافا",34,"ف",2,1],["تعساً له كم نُعزِّي","حيناً وحيناً نُهَنِّي",35,"ن",2,0],["تعس البحرُ، وهْوَ ملْحٌ أجاجٌ","كيف يَحْظَى بوصلِ عَذْب فرات؟!",36,"ت",1,0],["تعست، فما لي من وفاء ولا عهد","ولست بهل من أخلاي للود",37,"د",1,1],["تعس الحظّ ، وهل من","شاعر في أمّة محتضره ؟",38,"ر",2,0],["تعس امريء لا يستفيد","من الرجال ولا يفيد",39,"د",1,0],["تعساً لوقت لم تفرق عينه ال","حولاء بين البيض والاغماد",40,"د",1,0],["تعساً لهم وخساراً خابَ سَعيهمُ","لا هُم عملوا خيراً وقد خَسرُوا",41,"ر",3,0],["تعساً وقُبحاً يا سُلالة مُشملٍ","وشَرُفْتَ إذ أعملتُ فيك ندائي",42,"ا",2,0],["تَعَسَّفَ نَحوَكُم بِيداً عِرَاضاً","خَلَت مِن غَير مازَعِلٍ ورِيمِ",43,"م",1,0],["تعسّفتِ الفيفاء في غسق الدجى","فكم قطعت نهراً من الخيل والخال",44,"ل",1,0],["تَعِستُم وَأَدّى اللَّهُ ما في رِقابِكُم","أَما لِإِلَهٍ فيكُم مِن مُراقِبِ",45,"ب",1,0],["تَعِستَ لَقَد عَلَّمتَنا بَعدَهُ البُكا","وَعَرَّفتَنا بِالثُكلِ ما الحُزنُ صانِعُ",46,"ع",1,0],["تَعسفتُه سَعْيا على غيرِ منهجٍ","وكُدْر القَطا عن أَخْمَصَيَّ تَحيد",47,"د",1,0],["تَعساً لذيّاك اللعينِ وحزبهِ","فازَت أبابيلُ الطيورِ بحربهِ",48,"ه",1,0],["تَعِسَ الزمان فإنَّما أيامه","ومقامنا في ظلِّها أحلام",49,"م",1,0],["تَعْسَاً لجدِّي إنْ عَدَتْكَ مدائحي","أظَهَرتَ في نُعْماكَ أم لم تظهر",50,"ر",1,0],["تعساً لمن جاراك في","امد يقوم به الرهان",51,"ن",1,0],["تعساً لمن جاراهم في سؤدد","وهو الجدير بأن يضل ويتعسا",52,"س",2,0],["تعست جدود أولى الهوى أمن المها","يرجي الوفاء وذاك مالا يوجد",53,"د",1,0],["تعساً لمن جاراك في سؤدد","وكيف يستهون ما يصعب",54,"ب",1,0],["تعسُ الرعايا من هناءِ ملوكِ","ما أشبَهَ المعتوق بالمملوكِ",55,"ك",1,1],["تعَسَّفتِ في ليلٍ من الشكِّ دامسٍ","ولا بدَّ من أن يطلعَ الصبحُ والشمس",56,"س",1,0],["تَعِس المُفَنِّد هبّ يَلْحى في الهَوى","ما لاحَ مِنْ رُشْدٍ لَهُ إذْ لاحا",57,"ح",2,0],["تعساً لجدّك أيّ طوق معرّةٍ","طُوّقته يلوي بليتك ساحبا",58,"ب",2,0],["تَعسالَهُم كَم أَساؤا وَاِعتَدوا سَفَهاً","فَشاكَلتَهُم مِنَ القِهارِ نَقمَتُهُ",59,"ت",2,0],["تَعسِلُ تَح