,""],[4984,"من رواق جميل بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=175550",""],[5079,"يافؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=177146",""],[5111,"جَمَرُ الكَلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=212329",""],[5147,"يا ربع زحلة أين عنا","https://www.poetsgate.com/ViewPoem.aspx?id=166758",""],[5419,"إصرار","https://www.poetsgate.com/ViewPoem.aspx?id=32222",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5770,"حُلُم","https://www.poetsgate.com/ViewPoem.aspx?id=178691",""],[5861,"وَرَجعْتَ!!","https://www.poetsgate.com/ViewPoem.aspx?id=192660",""],[5879,"غربل ترابك","https://www.poetsgate.com/ViewPoem.aspx?id=215401",""],[5906,"من ضلع آدم","https://www.poetsgate.com/ViewPoem.aspx?id=188307",""],[5956,"الذكرى تنفعُ المؤمنين","https://www.poetsgate.com/ViewPoem.aspx?id=184490",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[1100,"أترى انت دليلي تهت من فكر ضليل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612986",""]],"verses":[["فَأَرى مَغانِمَ لَو أَشاءُ حَوَيتُه","فَيَصُدُّني عَنها كَثيرُ تَحَشُّمي",0,"م",2,0],["فَأَرى مَن عَصاكَ أَصبَحَ مَخذو","لاً وَكَعبُ الَّذي يُطيعُكَ عالي",1,"ل",2,0],["فَأَرى الفُتُوَّةَ غَضَّةً","في ثَوبِ أَوّاهٍ حَليم",2,"م",1,0],["فَأَرَى الَّذي كُنَّا وَكَانَ بِغرَّةٍ","نَلهُو بِغرَّتِهِ وَنَهوى دَلَّهُ",3,"ل",2,0],["فأريها من الغرام فنوناً","وتريني من حسنها أفنانه",4,"ن",2,0],["فأريت معناه العقول كما يُرى","معنى كلام المرء في تصحيفه",5,"ف",2,0],["فأرى أن أنيكها ثم أرمي","ها بما قد شهدتُه بالعيان",6,"ن",1,0],["فأرى الليالي ما نقضنَ مَعاهداً","فيما أتينَ ولا هَجَمْنَ مآمنا",7,"ن",2,0],["فَأَرى الفِردَوسَ في كُلِّ حِمىً","وَأَرى الناسَ جَميعاً سُعَداء",8,"ا",2,0],["فأَرَى صَوْتِي فَريدْ","فأُنَادي",9,"ي",1,0],["فارى ضاحكا بجانب آس","وارى مأتما بجانب عرس",10,"س",1,0],["فَأَرى أَينَ مَوضِعُ الجودِ في القَو","مِ مَكاني وَمَيَّزَ الناسَ عُدمي",11,"م",2,0],["فَأَرى السَمينَ الفَدمَ حينَ تُمِضُّهُ","قِطَعُ القَنا وَتَرُضُّهُ القُضبانُ",12,"ن",1,0],["فأَرى العدوَّ نقيصةً في عُمرهِ","وأرَى الصديقَ زيادةً في حالِه",13,"ل",2,0],["فأريكما الدنيا به مُغبرَّةً","حتى يُظَنَّ اليومُ يومَ ضَبابِ",14,"ب",1,0],["فأريتُه زُهرَ الربيعِ مَدائحا","ورأيت منه حَيَا الرَّبيعِ مَواهبا",15,"ب",2,0],["فَأَرى مُقلَتَيكَ تَنفُثُ سِحراً","وَعَلى فيكَ خاتَمٌ مِن عَقيقِ",16,"ق",1,0],["فأرى صفاء الود غيمانا","والمطلق المجهول ممتنعا",17,"ع",2,0],["فأرى ابن حمدانٍ ونورَ جبينه","يجلو سناهُ قذى جفون الأرْمَدِ",18,"د",1,0],["فَأَرى القَلبَ قَد تَنَشَّبَ فيهِ","حُبُّ هِندٍ فَما يُريدُ نُزوعا",19,"ع",2,0],["فَأَرى بِهِ لِلقَلبِ قَلباً ثانِياً","عِزّاً وَلِلعَينَينِ عَيناً ثالِثَه",20,"ث",2,0],["فأرى حماراً بعد ذلك كلّه","رفَعَ المضاف إليه والمفعولا",21,"ل",2,0],["فَأَرى النُجوم تَريد أَن","تنقض فَوقي كَالرجوم",22,"م",1,0],["فَأَرى شَرَّ كُلِّ يَومٍ وَيُشفى","سُقمُ نَفسي وَحَسرَتي وَاِكتِئابي",23,"ب",2,0],["فَأَرى ذاكَ قُبلَةً مِن بَعيدٍ","أَسعَدَتني وَما بَرِحتُ مَكاني",24,"ن",2,0],["فَأُريدُ صَرمَكَ تارَةً","وَإِذا اِرعَوى قَلبي نَهَيتُه",25,"ت",2,0],["فأرى بُرْقُعاً شفيفاً من الأو","جاعِ يُلقي عليكَ شجوَ الكَئيبِ",26,"ب",1,0],["فَأَرى مَغانِمَ لَو أَشاءُ حَوَيتُها","فَيَصُدُّني عَنها كَثيرُ تَحَشُّمي",27,"م",2,0],["فَأَرَى مِثَالاً رَائِعاً في صُوَرَةٍ","لِلنِّيل تُمْلأُ مِنْهُ عَيْنُ الرَّائِي",28,"ا",2,0],["فَأَرَى رُوحاً قَدِيماً طَائِفاً","بَاكِياً مِمَّا جَنَتْ مِصْرُ الفَتَةُ",29,"ه",1,0],["فأرى الفردوس في كلّ حمى","ورأى الناس جميعا سعداء",30,"ا",2,0],["فأرى النار في يد تتلظى","وأرى السيف في يد أصليتا",31,"ت",2,0],["فَأَرَى وُجوماً كالضَّبابِ مُصَوِّراً","ما في قُلوبِ النَّاسِ مِنْ غَلَيانِ",32,"ن",1,0],["فأرَى الناسَ صديقاً لفتىً","ذَا سخارٍ وأعادى مَنْ بَخَلْ",33,"ل",1,0],["فَأَريتُهُ مِن عَبرَتي","ما سالَ مِن دَمِهِ نَجيعا",34,"ع",2,0],["فَأَرى أَنَّهُم لِذَلِكَ أَهلٌ","فَهُم خَيرٌ مَن تُظَلُّ السَماءُ",35,"ا",2,0],["فأريشيه كي أحلّق في ج","وّ الأماني ما راقني التحليق",36,"ق",1,0],["فأريتني ديوانَ مجدكَ شامخاً","فحلا لأشعاري بهِ التدوينُ",37,"ن",1,0],["فأرى طعامي في الهوى ذا غُصَّةٍ","في قربها منّي وفي إقصائها",38,"ا",3,0],["فأرى جمالك في صبا","حك يا حبيب وفى مساك",39,"ك",1,0],["فَأَرى مِن أُمَيةٍ","فيكَ ظِلّاً مِنَ النَسَب",40,"ب",1,0],["فَأَرى الصُبحَ يَنجَلي","عَن شُعاعٍ من الحُلي",41,"ي",1,0],["فأريحوا فيها المطايا قليلاً","من وجاها فقد براها النحول",42,"ل",1,0],["فأرى الذل سؤالا","لم نجز فيه كلاما",43,"م",2,0],["فأرى مِنها فراشاً حائماً","فوقَ وردٍ إن تروِّح وجنتيك",44,"ك",1,0],["فأرَيتني الأوطارَ أصنافاً وقد","كتَمَ الذي بُحنا به الحِنديس",45,"س",1,0],["فَأَرى أَعْطافَهُ شاهِدَةً","أَنَّهُ قَدْ جارَتِ الْكَأْسُ عَلَيْهِ",46,"ي",2,0],["فَأَرَيتُها أَوضاحَها في لَيلَةٍ","بَدرُ التَمامِ بِأُفقِها مِثلُ السُها",47,"ه",2,0],["فَأُريقَ ماءُ شَبيبَتي فَرَأَيتُ شَي","بَ المَرءِ عِندَ الغيدِ أَقبحَ زلَّةِ",48,"ه",1,0],["فَأَرى الفَأرَ قَد تَجَنَّبن بَيتي","عائِذاتٌ مِنهُ بِدارِ الإِمارَةِ",49,"ر",2,0],["فأريحوا من متاعبه","قلبه المشحون بالحزن",50,"ن",1,0],["فأرى في الكون نور الل","ه لا نور الصباح",51,"ح",1,0],["فَأَرى لِسانَ السَيفِ يُفصِحُهُ إِذا","ما جِئتَ مِن نَسجِ الحَديدِ بِمُشكِلِ",52,"ل",1,0],["فَأرى كَأَمثالِ الدُّمى","أَمثالَها يَجفِلنَ جَفلا",53,"ل",2,0],["فأَرى المَعالي والليا","لي قَد فتَكنَ وهنَّ أقدَر",54,"ر",1,0],["فَأَرى ساعة مِن العَيش تَصفو","لِكَريم مِن عَربدات الزَمان",55,"ن",1,0],["فَأَرى البكاءَ مدى الزَمانِ مُحَلَّلاً","وَالضحك بَعد السبط غيرَ محلَّل",56,"ل",1,0],["فأرى البيض ليس تقطع حتَّى","تَتَناءى يوماً عن الأجفانِ",57,"ن",1,0],["فأرى الذل قد تولى عليهم","من إلهي ذي العزة المتعال",58,"ل",1,0],["فأرى النَّاس ما سواه وهاداً","مُذْ أرينا علومه الأَعلاما",59,"م",2,0],["فأُرِيحَ قَلْبِي مِنْ جَوَى الْبُرَحاءِ","وَلَهيبِ نَارِ الْوَجْدِ وَالأدْواءِ",60,"ا",2,0],["فأَرَيْتَ هَذَا العيدَ عِزَّةَ مالكٍ","متذلِّلاً لإِلهِهِ مُتَدَيِّنا",61,"ن",2,0],["فَأَرَيْتَهُ كيْفَ ارتِجَاعُ حَ