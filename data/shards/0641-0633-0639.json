tps://www.poetsgate.com/ViewPoem.aspx?id=150189",""],[5956,"تحنان للخلد المفقود","https://www.poetsgate.com/ViewPoem.aspx?id=182999",""],[6093,"شهمٌ على ظَهرِ المآذن صادحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176426",""],[6256,"تحية أدباء المغرب العربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65918&r=&rc=6",""],[6331,"خبِّريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82020&r=&rc=1",""]],"verses":[["فسَعْيُكَ مَدْعىً لا يُخَيِّبُ مَنْ نأى","ورَعْيُكَ مرْعىً لا يَضيقُ بمَنْ يَسْرَحْ",0,"ح",1,0],["فَسَعى أَهلُها إِلى شاطِئِ البَح","رِ وُفوداً بِالبِشرِ وَالتِرحابِ",1,"ب",1,0],["فسعيك مشكور ورأيك صائب","وفعلك محمود وسيرك راشد",2,"د",1,0],["فَسَعَيتِ في دورِ الظَوا","هِرِ وَالبَواطِنِ جاهِدَه",3,"د",2,0],["فسعى يطلب عُلْيا أهلِه","سَعْيَ جِدٍّ لم يخالطهُ سُمودُ",4,"د",1,0],["فسعيتُم لصلاح ال","أمر سعياً سدَّ بثقا",5,"ق",2,0],["فَسَعَت تَجري وَعَينا","ها تَرى الطَودَ فَتَندَم",6,"م",1,0],["فَسَعى إِلَيهِ مُبَشِّراً بِمُحَمَّدٍ","عَجِلاً فَقالَ لَهُ اشفِني بِالراسِ",7,"س",1,0],["فَسعَد أَميرَ المُؤمِنينَ مُمَتَّعاً","بِالعِزِّ ما عَمِرَ الزَمانُ وَما بَقي",8,"ق",2,0],["فَسَعدٌ جِبالُ العِزِّ وَالبَحرُ مالِكٌ","فَلا حَضَنٌ يُبلى وَلا البَحرِ يُنزَفُ",9,"ف",1,0],["فسَعَيْتَ سَعيَ أبيكَ وهو المُعتَلي","وورِثْتَ سْيفَ أبيكَ وهو القاصل",10,"ل",1,0],["فَسَعى الغَلّاقُ بَينَهُمُ","سَعيَ خَبٍّ كاذِبٍ شِيَمُه",11,"م",2,0],["فَسَعَى الفَرَنْسِيُّونَ فِي آثَارِهِمْ","بِعَزَائِمٍْ لاَ يَنْثَلِمْن حِداد",12,"د",1,0],["فسَعَى لِيَخْطُبَهَا عَلى","صُلْحٍ فعَادَ بِسَعْيِ خَاسِرْ",13,"ر",1,0],["فسعَتْ بمصرَ إلى العُلا، وجوادُها","كابٍ، ولهْجَتُها تَسير القَهْقرَى",14,"ر",2,0],["فسعيك مدعى لا يخيب من نأى","ورعيك مرعى لا يضق بمن يسرح",15,"ح",1,0],["فَسْعد بِمَغْفِرَةِ الإلَهِ، فلَمْ يَزَلْ","يَهَبُ الذُّنُوبَ لمَنْ يَشَاءُ، ويَغفِرُ",16,"ر",1,0],["فسعى إلى قوم غدا جارا لهم","متطفلا تبا له من جارِ",17,"ر",1,0],["فسعى بالبناتِ يطلب رزقا","إِذ غدا عند قومه محروما",18,"م",2,0],["فَسَعيُكَ نَاءٍ عَن طريقةَ سَعيِهِ","وَمعنَاكَ عَن مَّعنَاتِهِ أعوَجَّ وَالتَوَى",19,"و",2,0],["فسعدك جيش لا يطاق نزاله","بحرب متى تبعث به وحده يكفى",20,"ف",2,0],["فَسَعدُ معاذٍ سيّد الكلّ مَن له","قَدِ اِهتزَّ عرشُ اللَّهِ أَرفعهُم قدرا",21,"ر",2,0],["فَسَعْداً لأَمْلاكٍ عَلَيْكَ اعْتمِادُها","وَفَخْراً لأيّامٍ إِلَيْكَ مَصِيرُها",22,"ر",3,0],["فسعيتُ نحو الموتِ أَعلم أَنه","من ضنْكِ هذا العيش أحسن حالا",23,"ل",2,0],["فسعي إليه سموى به","سؤالي عنه سلامي عليه",24,"ه",1,0],["فَسَعادَةُ الشَهمِ المُحافِظِ زارَها","بِوَلائِهِ المَحمودِ أَبرَكَ زَورَةِ",25,"ه",1,0],["فَسَعى جَداً فَلَمّا جاءَهُ","وَجَدَ النارَ بِهِ لَم تُبقِ شَي",26,"ي",1,0],["فسعَى وُشاةٌ لا سَعوْا ما بينَهمْ","بالبَغْيِ حتّى بدَّلوا تَبْديلا",27,"ل",2,0],["فسعيد من على أحداقه","كان ممشاه إلى عالي ذراها",28,"ا",3,0],["فسعى بالجهد في تعميرها","سَعْيَ من يبلُغُ غايات المرام",29,"م",1,0],["فسعى إلى جدواك كلُّ مؤمَّلٍ","باب المواهب دونه لا يغلق",30,"ق",1,0],["فسعرت من حر أنفاسي بها","لظىً أذاب حرُّه شحم الكلى",31,"ا",1,0],["فسعى بي عند قاضي البلد","زاعما أني شديد اللدد",32,"د",1,0],["فسعيك تأهيل لكلِّ رغيبةٍ","سترشف معسولَ الأماني به رشفا",33,"ف",2,0],["فسعيك مشكور وجدك مقبلٌ","ورفدك مبذول وبشرك لا يخفى",33,"ف",2,0],["فَسَعَةُ الأنفسِ وانبساطُها","يَبينُ في العزّةِ من سلطانِها",34,"ن",3,0],["فسعى قِبالك جدُّه لا حاله","عفو النفوس ولا اجتهاد المالِ",35,"ل",1,0],["فَسَعدٌ أَرحَلَت مِنها مَعَدّاً","وَكَيفَ تُصاقِبُ الداءَ الدَفينا",36,"ن",2,1],["فَسَعوا كَي يُفَلِّلوكَ وَيَأبى ال","لَهُ إِلّا الَّذي يَرى وَيَشاءُ",37,"ا",2,0],["فسعودٌ المغوار قائد جيشه","بطل إذا مالاح تنهزم العدى",38,"د",2,0],["فَسُعداً لِمَن في حَلبَةِ العِلمِ قَد جَرى","وَسُحقاً لِمَن في حَلبَةِ العِلمِ أَحجَما",39,"م",2,0],["فسعى بعد ساعة في ركاب ال","داوري للحجاز دام بَقاه",40,"ا",2,0],["فَسَعَت نَحوَ البُروج","لِلعُلا حَتّى تَصيدهْ",41,"ه",1,0],["فسعيه عند أهل الْ","إسلام يُرضَى ويُشْكر",42,"ر",1,0],["فسعى بينهما الدهر ولم","يَدُم الدهر لخلق سَلَما",43,"م",2,0],["فَسَعد البَرايا أَرخوهُ بَدا وَقَد","أَتى صَدرَهُ العالي أَميناً عَلي المَلا",44,"ل",2,0],["فَسَعَى بَينَنا الوشاةُ فأَقرر","تَ عيونَ الوشاةِ بي فَهناكا",45,"ك",2,0],["فسعده الذابح الفاري حسام أبي","سعدى الذي فيه أرقاب العدى نحروا",46,"ر",3,0],["فسعى مع التشمير منه ولم يزل","لعصى التوجه للعلي متأطبا",47,"ط",3,0],["فسعدت قبل بقربه وبقربتي","وشقيت بعد ببعده ودياري",48,"ر",2,0],["فسعيت أحسبها غرا","باً أو حداة أو حمامه",49,"م",2,0],["فسعت إلينا حورها في أثرهم","إذ عزَّ من بعد البعادِ قرارُها",50,"ر",3,0],["فسعى كل إليها ودنا","ينفق الفضة فيها والذهب",51,"ب",1,0],["فسعت نحوه الوشاة ونالوا","كل ما أملوه منه وأزيد",52,"د",1,0],["فَسَعْدَكَ يستنجحُ الطالبونَ","وإن رَغِمَ المُشْترِي أو زُحَل",53,"ل",1,0],["فسعيد إذا دعاه يجبه","وشقيّ مخالف للدعاء",54,"ا",2,0],["فَسَعى الأعادي بالنمائم بيننا","حتى تنافرنا فبنتُ وبانوا",55,"ن",3,0],["فسعى من وحدوا الله على","رشد من امرهم يتحدون",56,"ن",1,0],["فَسَعَى لِذَاكَ وَسَاعَدَ المَقدُورِ بِال","أمرِ الذِي هُوَ حِكمَةُ الرَّحمَنِ",57,"ن",1,0],["فَسَعَت إلَى الأبَوَينِ رَحمَتُكَ الَّتِي","وَسِعَتهُمَا فَعَلاَ بِكَ الأبَوَانِ",57,"ن",1,0],["فَسَعى الى القَتلى بقلب خاشع","ودموع عين بالزفير اذالها",58,"ل",3,0],["فسُعوده فوق السعود وملكُه","فوق التبابع والأكاسرة الأولى",59,"ل",2,0],["فسعيكم سعي غير ممنون","لا برد في ذا ولا سلام",60,"م",1,0],["فَسعى حَتَّى إِذا ما اِشتَمَّهُ","غَلَبَ الرَّوعُ عَلَيهِ فَمَثَل",61,"ل",1,0],["فسعى بينه وبيني وشاة","حولوا نقض عهدنا وفساده",62,"د",2,0],["فسعى الى شغل فأعيا نيله","وسعى الى موت يريح فقصّرا",63,"ر",2,0],["فسعى ليدخلها فرد بضربة","عنها وكان يظنها دار القرى",63,"ر",2,0],["فسعى براح خلتَها","من وجنتيه تعتصَر",64,"ر",1,0],["فسعدُ سُعود الملك أنت وإنما","خباؤُك فيها سعدُ أخبية النّصب",65,"ب",1,0],["فسعدهُ قد نالَ منه الكُلُّ","كما روى أبو سعيد الخدرى",66,"ر",2,0],["فسعدت حيا والإمامة رتبة","وسعدت ميتا والجنان مقام",67,"م",1,0],["فَسَعادَةٌ أوليةٌ سَبَقَتْ وَمَا","هوَ ثابتٌ أزلاً فلنْ يَتَغَيَّرا",68,"ر",2,0],["فسعادة الدنيا بجودك نالها","فعسى من الأخرى غدا لا يحرم",69,"م",1,0],["فَسَعى وَلَبى لِلمهيمن دَعوَةً","وَلَهُ المَلائِكَ بِالسُعود تبشَر",70,"ر",1,0],["فسعيت كل السعي في إسقاطه","ظنا بأنك مسعد بشقائه",71,"ا",3,0],["فَسعت لطاعته وَفي مَرضاته","فَسمت بِهِ وَزَهَت بِها أَوطانه",72,"ن",2,0],["فسعاد جاءتك تحمل ورداً","وزهيراً قلادة لؤلؤيه",73,"ه",1,0],["فسعيدٌ من قد تحامى هواكن","وحسب الإنسان ان لا يخيبا",74,"ب",2,0],["فَسَعْدُ هَذا بِما قَد قُدَّ مِنْ دُبُرٍ","فِيهِ وهَذا بِما قَد قُدَّ مِنْ قُبُلِ",75,"ل",1,0],["فسعيُ المالكينَ دُوَيْنَ سعيي","وكلُّ متوَّجٍ في الفضلِ دوني",76,"ن",2,0],["فسعدها بتمام اللّيل متّصلٌ","ونحسها فرقةٌ يأتي مع السّحر",77,"ر",1,0],["فَسَعى يُؤَنِّبُ عاتِباً بِمَلامَةٍ","واستَنكَرَ المَسعى بالإستبطاء",78,"ا",2,0],["فسعديك يا ابن منتيوس هزم","ت كل فتىً هالماً مقشعرا",79,"ر",2,0],["فسعدي نديمي، والمدامة ريقها،","ووجنتها روضي، وتقبيلها النقل",80,"ل",1,0],["فسعى السعد مقبلا حيث حلت","واستقرّت بمسعد السعداء",81,"ا",2,0],["فسعى مسرعا واخبر عنه","انه المصطفى من الأصفياء",81,"ا",2,0],["فسعى ليثرب نحومن","وفوا بنصرته ذمامه",82,"م",2,0],["فسعيد في المجلسين سعاد","وسليم سلمى ومارون مريم",83,"م",1,0],["فسعديك يا من حزت سبقاً على الورى","بسعد رقى سعد السعود مخلَّدا",84,"د",2,0],["فسعيت أمس إلى رحابكَ قاصداً","رؤيا خدين أفتديهِ بمهجتي",85,"ي",1,0],["فسعدتُ يا بن سعيدٍ الأَعلى أبي","عبد الإِله ونلتُ ما أَنا أَرتجي",86,"ج",2,0],["فَسَعت سَعيَها الحَثيث لتخلي","صي فرُدَّت خصومة الأَخصامِ",87,"م",1,0],["فَسَعى مَسعاتَهُم في قَومِهِ","ثُمَّ لَم يَظفَر وَلا عَجزاً وَدَع",88,"ع",1,0],["فسعدك يبقى عندك الدهر خادما","كعبد مطيع ما له ابداً أبق",89,"ق",1,0],["فسعى يحث لما رأى همماً","عزم التكافل بينها كبرا",90,"ر",2,0],["فسعى يذلل فى الطريق صعابها","تبنى البناء لساكنيه غدا يده",91,"د",2,0],["فسعى ليحفظها تطيع لأمره","في سعيه المشكور ذاك صوارم",92,"م",1,0],["فسعيُكَ مشكورٌ وحجك بالصفا","من الله مبرور فبشراك بالهنا",93,"ن",2,0],["فسعيتُ ..سبعًا بين وصلِكَ والنَّوى","لا زمزما إلّا لماكَ .. ألا اسقِني",94,"ن",2,0],["فَسَعَى الْمُحِبُّ إِلَىْ لِقَاْءِ حَبِيْبِةٍ","غَرِقَتْ بِبَحْرِ مَحَبَّةٍº وَفِرَاْقِ",95,"ق",1,0],["فَسَعَىْ إِلَىْ أَهْلِ السِّعَاْيَةِ جَاْهِداً","وَدَلِيْلُهُ التَّعْقِيْدُ وَالإِيْذَاْءُ",96,"ا",2,0],["فسعيت ألثم تربة","حملته في ذاك المساء",97,"ا",2,0],["فسعت إليَّ يسوقها حادي الحمى","والليل يزحف والظلام رغاء",98,"ا",2,0],["فَسَعَتْ كَهاجَرَ مِنْ حُسَيْنٍ نَحْوَهُ","وَتَرومُهُ لَثْمَاً لِتُرْبَتِهِ تَظُنْ",99,"ن",1,0],["فَسَعدَيكَ يا قلبُ إِنْ أَشرقت","كَشَمسِ الصباحِ بلونِ الذهَبْ !!",100,"ب",1,0],["فسعت لتشبع نزوة في نفسها","حتى وإن خرجت على الأسياد",101,"د",1,0],["فسعدتَ بدفءِ أناملهَِ","وطربت بما كتبتْ يدُه",102,"د",2,0],["فسعوْا فيها خراباً ومَضوْا","في اقتِرافِ الجُرْمِ أنّى ذهَبوا",103,"ب",3,0],["فسعى ساقي الهوى في درعها","لايخاف الرمح من شاكي السلاحِ",104,"ح",1,0],["فسعيتَ خلفَ رحيقِها مستمتعاً","بالمغرياتِ وبالمنى ما أجهلَك",105,"ك",1,0],["فَسَعَى لكَ المِلْيارُ يبذلُ رُوحَهُ","ولَهُ بمَهْدِ المُصطفى تهْيامُ",106,"م",1,0],["فسعى بين الصفا والمروة","طالبًا مرضاةَ خلاق العباد",107,"د",1,0],["فسعى يُجسّد شكلها كخياله","من سائر الأنصاب والأوثان",108,"ن",1,0],["فسعى لِشُكْرِ مُؤذِّنٌ وأذانِه","منْ قَعْر جُحرٍ مُؤمنٌ ثعبانُ",109,"ن",1,0],["فسعى الكل خلفها عاقد العزم","قيا بارك الإله الجهودا",110,"د",2,0],["فسُعودي أنجمٌ عَمِيَتْ","ونحوسي كلُّها نظرُ",111,"ر",1,0]]}