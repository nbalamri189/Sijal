{"poems":[[65,"وظلام قيد العين به","https://www.aldiwan.net/poem45729.html","الرمل"],[95,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11075.html","الخفيف"],[95,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11164.html","الخفيف"],[74,"قال العذول فزاد قلبا شيقا","https://www.aldiwan.net/poem19352.html","الكامل"],[53,"يا فاصد العرق المبارك فصده","https://www.aldiwan.net/poem62867.html","البسيط"],[71,"ألا أيها المولى الذي زار عبده","https://www.aldiwan.net/poem28560.html","الطويل"],[108,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[186,"أحبابنا هل لذاك العهد تذكار","https://www.aldiwan.net/poem67065.html","البسيط"],[371,"لم تعر جسمك علة بل صحة","https://www.aldiwan.net/poem16989.html","الكامل"],[391,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[463,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[466,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[505,"الحمد لله لي للمصطفى نسب","https://www.aldiwan.net/poem37811.html","البسيط"],[556,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[580,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53774","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122640","المديد"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136239","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88665","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88651","المنسرح"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87765","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204960","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205002","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204574","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132642","المنسرح"],[3177,"","https://poetry.dctabudhabi.ae/diwan/poem/113904","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40117","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69920","الكامل"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127769","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94956","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94942","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58070","البسيط"],[4690,"عمّي الفَلاّح / أدب الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=120388",""],[585,"حياك منهمرُ الغوادي الجون","https://www.poetsgate.com/ViewPoem.aspx?id=161937",""],[5186,"خلوا عقيم البحث في خلخالها","https://www.poetsgate.com/ViewPoem.aspx?id=156494",""],[5436,"سكن المجد(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35148",""],[470,"المنعطف","https://www.poetsgate.com/ViewPoem.aspx?id=18589",""],[5732,"البارحه يازبن بالقلب هوجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177848",""],[6070,"ناحتْ على غصنِها المملوءِ بالتَّرفِ","https://www.poetsgate.com/ViewPoem.aspx?id=188430",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""]],"verses":[["عَرَقٌ طابَ وَوَجهٌ يَرتَدِي","بِسَنا البَدرِ وَمِسكٌ وَحُلَى",0,"ا",1,0],["عرق الزوق آية الذوق فيما","وصفوه وغاية الإتقان",1,"ن",1,0],["عَرَقُ الذُّوقِ آيَةُ الذَّوقِ فِيمَا","وَصَفوُهُ وَغَايَةُ الإِتْقَانِ",2,"ن",1,0],["عرقت جباه السائدين حياله","وكذا يكون ابن السيادة معرقا",3,"ق",2,0],["عِرق فَراه شبا الحديدة عن دمٍ","كعُصارة المسك الذكي الأذفرِ",4,"ر",1,0],["عرقْتُ حياءً من حضورِكَ ذاهلاً","بفضلِكَ عنْ حسنِ المباحثِ والنقدِ",5,"د",1,0],["عَرَقُ الجِبَاه كم اسْتَحا","لَ قلائدًا في كلِّ جيد!",6,"د",1,0],["عِرقٌ كَريمٌ وَأحسابٌ مُؤثَّلةٌ","بِمثلِها أُحرِزَت لِلمَجدِ أَخطارُ",7,"ر",1,0],["عَرَقٌ جَرى نَهراً مُحَيّاهُ بِهِ","كَصَحيفَةٍ قَد أُلقِيَت في كافِرِ",8,"ر",1,0],["عَرقاءَ وَجناءَ جُمالِيَّةٍ","مُكرَبَةٍ أَرساغُها جَلمَدِ",9,"د",1,0],["عَرَقُ المجاسدِ فاض ماءُ شبابه","والوردُ أطيب منه ريحاً ما رشحْ",10,"ح",1,0],["عرقتهُ غبراءُ المطالع أزْمةٌ","شوهاءُ عضْبُ شمالها كالمُنْصُلِ",11,"ل",1,0],["عَرقَ الطَّوى أشْبالَه وتَناذرَ الأظع","انُ فهو مُلَجِّجٌ سَرَّاءُ",12,"ا",2,0],["عرقُ الأُمومَةِ للأسْتاذِ يرفعُني","أَبي الخَوارِقِ عبد القادرِ الجيلي",13,"ل",2,0],["عَرَقَ الدّهرُ لحسنَهُ وهْو باقٍ","كالمُدى تعرُقُ التَّريبةَ نَحْضا",14,"ض",2,0],["عَرَقَتْهُمُ حتّى أتَوْهُ هُزّلاً","بِيدٌ عِراضٌ دونَه وفجاجُ",15,"ج",1,0],["عَرَّقَتْني الأَيام بَعْدَكَ واجتا","حَت وللدَّهْر فيَّ أَكْلٌ وشُربُ",16,"ب",1,0],["عَرقَتْ بنافضها وشدّتها","لحمي ورَضَّتْ اعظمي رضَّا",17,"ض",2,0],["عِرقُ إبراهيمَ دَسَّ لَكم","شَرَفاً والعِرقُ دسّاس",18,"س",1,0],["عرق اللبيب بها سفاهة قاصد","عرضا من الدنيا لغاربه امتطا",19,"ط",2,0],["عرق المعروف فيه جعفر","ولما اسس قد شاد دعام",20,"م",1,0],["عرق فيه ابوه عارفة","غباوة من يقول اجلها",21,"ل",3,0],["عَرَقُ الجِدّ وَقَد ضمَّخكم","قَطراتٍ دُونَها حبُّ الجُمان",22,"ن",1,0],["عرقلتها عني ظروف وسقم","فتراها موزعات بشعري",23,"ر",2,0],["عرق الموت كلما سار يبدو","في محياه عاقدا إكليلا",24,"ل",2,0],["عرق الحياة يسيل منك لألئاً","فيزان منها للغنيِّ وشاح",25,"ح",1,0],["عرّق كسرى به وملكه","ممالك الفضل كلها ومضى",26,"ض",2,0],["عرقت منها فبات الجسم في ألم","كل المتاعب والنكب يعانيها",27,"ي",3,0],["عرقت فيه دوحة المجد قدما","فهو زك من معشر ازكياء",28,"ا",2,0],["عَرَقْتَهُم مدى الخُطوب فأَحيي","تَ رُفاتاً مِنَ التُرابِ دَفينا",29,"ن",2,0],["عرقا عَلى بعدها غرقى بانعمِهِ","ابقى لَها الذكر حيّاً لَيسَ يَنقطعُ",30,"ع",1,0],["عرقت حباً في المدح والدر قد حكت","جواهرها للتاج بالعين تقشعُ",31,"ع",1,0],["عرقت فيه البهاليل ومن","عرقت فيه البهاليل نجب",32,"ب",1,0],["عرقت فاطمةٌ قيه ومن","عرقت فاطمة فيه نجب",33,"ب",1,0],["عرقتنجيُّ قومٍ مذ تناءى","عن الأخطار حفَّ بهِ الأمانُ",34,"ن",1,1],["عَرَقتنجيَّةٌ لمّا تناءَت","بتولاً قد ثوَت خدرا أمينا",35,"ن",2,1],["عرقُ الكرامِ بهمْ قد دسَّ مكرمةً","فالعرقُ إن مرَّ دهرٌ أيُّ دسَّاسِ",36,"س",1,0],["عَرَقًا مِنْ كدّ حَماسَتِهِ","وصنيعًا يَنْثُرُهُ فينا",37,"ن",2,0],["عِرق يمت إلى الصميم وعزمةٌ","صدقت فما اختبأت وراء حصون",38,"ن",1,0],["عرق الفتى فيها فماذا يرتجى","لفتاتنا بلجامها وشكالها",39,"ل",3,0],["عرقُ العراق ِ بعرقِ الشعب قاطبةً","مثل النخيلِ تحدّى عرقها الوهنا",40,"ن",2,0],["عرقي بعرقك مشدود ، فلو نهضا","أبقى فسيلا ، وتعلو هذه الالف",41,"ف",1,0],["عرق الندا بقلوب الأجود معروس","حمله زهور الورد هي والرياحين",42,"ن",1,0],["عِرقاً عَريقاً وفي طياتهِ ألِفٌ","أحيا الحياةَ وأحيا جنَّةَ السَّعفِ",43,"ف",1,0],["عِرْقٌ شَربتمْ منه كأساً واحداً","كيف استفاقَ تَحَدُّداً وتَعَدُّدا ؟!",44,"د",2,0]]}