etsgate.com/ViewPoem.aspx?id=63571",""],[5582,"ستبدي خفيّات الأمورِ العواقبُ","https://www.poetsgate.com/ViewPoem.aspx?id=63465",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[1117,"رفيق الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=19376",""],[5616,"آلاء","https://www.poetsgate.com/ViewPoem.aspx?id=205243",""],[5618,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=208911",""],[5691,"النحت في الصخر","https://www.poetsgate.com/ViewPoem.aspx?id=206352",""],[5736,"مها","https://www.poetsgate.com/ViewPoem.aspx?id=203847",""],[5784,"حقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=197505",""],[5873,"تباريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215466",""],[5906,"ألفظ شرابك","https://www.poetsgate.com/ViewPoem.aspx?id=188309",""],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5956,"أخاف عليك يا نجلي","https://www.poetsgate.com/ViewPoem.aspx?id=193290",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6070,"إعدلْ هداكَ اللهُ للإحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188631",""],[6070,"أسيرُ معَ الحروفِ إلى الخيالِ","https://www.poetsgate.com/ViewPoem.aspx?id=191744",""],[6084,"سافر فسوف ترى اللذات في السفر","https://www.poetsgate.com/ViewPoem.aspx?id=170838",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6189,"السابحون في منطقة انعدام الوزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83549&r=&rc=16",""],[463,"اللَّيلُ فالأرضُ للِّيثِ الشَّرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60078&r=&rc=134",""]],"verses":[["وَأَركانِ العَتيقِ وَبانِيَيها","وَزَمزَمَ وَالمَقامِ وَمَن سَقاها",0,"ا",3,0],["وَأُركِزُ في قُلوبِهِمُ رِماحي","وَأَضرِبُ في دِيارِهِمُ قِبابي",1,"ب",2,0],["وَأَركَبُها مُحَصَّنَةً شَبوباً","تُمانِعُ غَيرَ فارِسِها الرِكابا",2,"ب",2,0],["وَأَرْكَبُ الأَمْرَ تَسْتَوْشي عَواقِبُهُ","خَطْباً يُصافِحُ فيهِ الأَعْيُنَ الأَرَقُ",3,"ق",1,0],["وَارْكُضْ إِلَى اللَّهْوِ أَفْرَاسَ الصِّبَا مَرَحاً","إِذَا وَجَدْتَ لِخَيْلِ اللَّهْوِ مَيْدَانَا",4,"ن",2,0],["وَأَركَبُ في اللَهامِ المُجرِ حَتّى","أَنالَ مَآكِلَ القُحمِ الرِغابِ",5,"ب",1,0],["وَأَركَبُ في الرَوعِ خَيفانَةً","كَسى وَجهَها سَعَفٌ مُنتَشِر",6,"ر",1,0],["وأركب متن الهَول دون لُبانتي","ولست أبالي بالكوارث والكَرْث",7,"ث",1,0],["وأركب على صَهَوات الجِدّ مغترباً","فيما تحاول ذا حلّ وترحال",8,"ل",1,0],["وأركبُ أخمصي إذ لا تُراعي","حَفَايَ كيف كان ولا انتعالي",9,"ل",2,0],["وَاِركَب جَناحَ النَسرِ لا يَعصِمكَ مِن","نَسرٍ يُرَفرِفُ فيهِ عِزرائيلُ",10,"ل",1,0],["وَاِركُزوهُ إِلى القِيامَةِ رُمحاً","كانَ لِلحَشدِ وَالنَدى وَالطِرادِ",11,"د",1,0],["وَأَركَبُ إِذ لا أَرض إلّا غُطامِطٌ","مطيّةَ ماءٍ سَبْحُها فيه إرقالُ",12,"ل",1,0],["وأَركبْ زماناً لا جماحٌ لهُ","من قبْلِ أنْ يحدثَ فيه الجماح",13,"ح",1,0],["وأركبُ عزّاً صهوتي وهي مهرةٌ","أُساور منها بالشبابِ شبابا",14,"ب",2,0],["وأركبُ الهوْلَ في ريعانِ مامَنةٍ","حبُّ الحياة بِحبِّ الموتِ يُغريني",15,"ن",2,0],["وَاِركُض بِنا رَكضاً حَثيثاً","فيهِ عَن نَظَرٍ دَفيقِ",16,"ق",1,0],["وَاِركَب بِنا اللَفظَ الجَليلَ","وَسِر إِلى المَعنى الدَقيقِ",16,"ق",1,0],["وَأَركَبُ أَردافَ الرُبى مُتَأَسِّفاً","فَأَنشَقُ أَنفاسَ الصَبا مُتَنَسِّما",17,"م",2,0],["وَأَركَبني طِرفَ الهَوى غُنجُ طَرفِهِ","وَأَشرَقَني بِالدَمعِ إِشراقُ خَدِّهِ",18,"د",2,0],["وَأَركَبوهُ أَكبَرَ البَهائِمِ","مَركَبَ كِسرى مَلِكِ الأَعاجِمِ",19,"م",1,0],["وَأَركَبُ ظَهرَ الأَرضِ أَو بَطنَ لُجَّةٍ","مُهَملَجَةٍ لَتَشتَكي خَبَبَ السَفرِ",20,"ر",1,0],["وَأَركُدَ فيها تَحتَ عِبءٍ لَو أَنَّهُ","عَلى العيسِ ما قَرَّت بِهِ في المَبارِكِ",21,"ك",1,0],["وأركب الظهرَ بَلَى","مَن ركبَ الظهرَ أَمِنْ",22,"ن",1,0],["واركبِ الجدَ في الأمورِ ولا تجبنْ","إذا فاتَ بعضها أحيانا",23,"ن",2,0],["واركب رؤوسَ السَّمْهَريّة في العُلا","فالرمحُ ناهٍ للعُلا أَن تشسعا",24,"ع",2,0],["واركب به على رخاخ العزمِ","مجتهداً واطلق عنان الحزمِ",25,"م",1,0],["واركع بجامع فرقٍ واسجدنّ به","ثمّ اقترب يا أخا التقريب واعتكف",26,"ف",1,0],["وَاِركَب كُمَيتاً راضها أَشهَبٌ","فَاقَا عِتاقَ الضُمَّرِ القُودِ",27,"د",1,0],["وأَركبني فُلكَ النَجاةِ فأَصبحَت","على ثَبج الدأماءِ سابحةً تَجري",28,"ر",2,0],["وَاِركَع خُضوعاً إِلَيهِ وَاِسجُد","وَاِستَمنِحِ الصَفحَ في سُجودِك",29,"ك",1,0],["وَاِركَب الحَزم إِلى نَيل المُنى","وَرُضِ العَزم إِذا ما جَمَحا",30,"ح",2,0],["وأركبُ بعدَ العُدم والشَّيب تالِياً","يَقودُهما خَلفي ويَمشي تَعسُّفا",31,"ف",2,0],["وإركب من مطاياه جَنيباً","يفوت بوَخده وَخْدَ المطايا",32,"ا",3,0],["وأركبتها طِرفَ الشريعة مُسرَجاً","تصول على الأعداء بين الجلامد",33,"د",1,0],["واركع ورض في ركوعك لا تكن صاح لاه","ثم اعتدل واحمد المولى على ماحباه",34,"ا",2,0],["واركع ورض واعتدل","واسجد مع الساجدات",35,"ت",1,0],["واركض وراءَ شبابِ \"مصرَ\" لأنهم","رفعوا الجباهَ وحاربوا التطبيعا",36,"ع",2,0],["واركب جواد الشوق تكف الرجا","فالشوق للمشتاق نعم الجواد",37,"د",1,0],["وأركد الراسيات الراسيات بها","كيما تسيح فأرست بعد ما سمقا",38,"ق",2,0],["وأركض في ميادين ال","هوى ملء الميادين",39,"ن",1,0],["واركب مطاها فقد استخضعتْ","ذلّاً لأنْ تُلْجَم أو تُثفَرا",40,"ر",2,0],["وأركب الظَّهر ظُهراً لا لُغوب به","جلْداً على الوعرِ مأموناً من السَّأم",41,"م",1,0],["وَاِركُض عَلى كُلِّ لَهوٍ","لَهُ جَبينٌ أَغَرُّ",42,"ر",1,0],["وَاِركَبِ الإِنخِلاعَ إِن كُنتَ مِمَّن","يَشتَهي السَيرَ في طَريقِ السُرورِ",43,"ر",1,0],["وَاِركُض وَلا تَنزِل بِرِجلِكَ ساعَةً","عَن ظَهرِ شَبابِكَ المَدّادِ",44,"د",1,0],["وارْكُنْ إليه وخذْ نَتائجَ قلبِهِ","فمَتى ثبَتَّ بلوحِهِ لم تُخْذَلِ",45,"ل",1,0],["وأركبَهمْ لمُعضلةٍ قَموصٍ","تَشامَسُ عن ركوبِ الرَّاكبينا",46,"ن",2,0],["وأرْكَبني أثباجَ كلّ فضيلةٍ","مُمَنَّعَة الأرجاءِ محميّةِ الغَرْبِ",47,"ب",1,0],["واركع له عن سواه واسجد","إليه في حضرة التعلي",48,"ل",2,0],["واركُن إلى أعلى ذُرى نفحاته","وإلى انتصاركَ عزمُ غارتِهِ انهزِ",49,"ز",1,0],["وأركانه موضوعة في الطبيعة","لقد نظمت خط المزاج بحرفها",50,"ه",2,0],["وَأَركانها مِن بَعده قَد تهدّمت","وَلاحَ عَلَيها يَوم فاظَ خَراب",51,"ب",1,0],["وَاركض مَعي في مَيادين المَديح وَقل","ما شئت في وَصفه مِن بَعد تَنميق",52,"ق",1,0],["وَاركض بمضمار أَفراح بَشائرها","تَدوم بِالداوري مَنشورة العلم",53,"م",1,0],["وَأَركض في مضمار كُل صبابة","بِأَفراس لَهو طارف وَتَليد",54,"د",1,0],["وَأَركَضُهُنَّ الفَيرُزانَ عَلى الصَفا","فَلَم يُنجه مِنها اِنفِساحُ المَخارِمُ",55,"م",1,0],["وأركانها تتعالى اتصالا","وهنّ بقلب السحاب صواعد",56,"د",1,0],["وأركبُ عودَ الصَّبرِ في مهمهِ الرّضى","بزادٍ مِن التَّقوى وهادٍ مشن الذّكرِ",57,"ر",1,0],["وَاِركَب عَلى العَزمِ شِمليلاً مهذّبةً","حرفاً مُذلّلة لا تَرهَبُ الأَجَما",58,"م",2,0],["وَأَركَبُ مَتنَ الصّفوِ وَالأنسِ راكِضاً","وَلَيسَ كَمَتنِ الصّفوِ عزٌّ لِراكِبِ",59,"ب",1,0],["وَأَركَبُ مِن أَغلى القَوافي جِيادَها","فَأَحظى لَدى سَبْقي بِأَعلى المَراتِبِ",59,"ب",1,0],["وَأَركَبَها مِنها غَوانِيَ خرّداً","عَذارى عِراباً عادِمات الشكولِ",60,"ل",1,0],["وَاِركَب على طِرفٍ أغرَّ مضمَّرٍ","مِثلَ الرّياحِ وَإنّه لا يجهَدُ",61,"د",1,0],["وَاِركُن إِلى شاعر ذي الحِكايَه","فَإِنَّهُ أَعجَبَني لِلغايَه",62,"ه",1,0],["وَأَركَب اِبنه عَلى قَفاه","وَالشَيخ مِن وَرا مَشي قَفّاه",63,"ه",1,0],["واركبْ سفينة عِز تنْجُ من نكد ال","ورى إذا الناسُ في أطماعهم غرقوا",64,"ق",3,0],["وأركبُ ما أستصعَبَت هِمّتي","أمثلي رَكوبٌ لِمَا أستُسهِلا",65,"ل",2,0],["واركض إلى اللذات في ميدانها","واسبق لسد ثغورها ودروبها",66,"ب",3,0],["وأركب كثباناً واقرص عندما","وأنظر بستانا وأمسح عبرها",67,"ا",1,0],["واركب من العفو طرفا لا يعارضه","يوما عشار فان الحر راكبه",68,"ب",2,0],["وأركب اثباج التفكة في الدى","الى كل فتان أميناً من الوقص",69,"ص",1,0],["واركب ليوم قتاله","قبا تشن اذا هبط",70,"ط",1,0],["واركب متون الصافنات ولا تقل","إن الهوى بجوانحي يعصيني",71,"ن",2,0],["وَأَركبنَّ خطوبَ الدهرِ مُقتحماً","مِنها مهالكَ يبلى كلّ مقتحمِ",72,"م",1,0],["وَأركب عيسَ المشكلاتِ تبرّعاً","إِذا لَم يكن لي غيرهنّ مراكبُ",73,"ب",1,0],["وأركبه سلساً طيعاً","وقد كنت عريت أفراسه",74,"س",2,0],["واركُنْ إِلى واجبِ التَّفويضِ مُتَّكِلاً","ولا تُفيضَنَّ في عَتْبٍ على الزَّمَنِ",75,"ن",1,0],["وأركبُ في حبِّه","على الحالتينِ الخطرْ",76,"ر",1,0],["وَأَركَبُ ظَهراً لا يَؤوبُ بِراكِبٍ","وَلا يُمتَطى إِلّا إِلى الهَلَكاتِ",77,"ت",1,0],["واركسه مخفوضاً على أم رأسه","إلى دركات المهلكات الوبيلة",78,"ه",1,0],["واركب مطايا الليالي في العبادة لا","تنم على غفلة المغرور تقضيها",79,"ي",3,0],["وَأَركَبُ مَتنَهَا غُبراً كَبَاعِي","وَخُضراً مِثلَ خَاطِرِيَ انسِيَابا",80,"ب",2,0],["وأركع في محراب مسجد بيته","وأكرع من أكواب زمزمه تير",81,"ر",1,0],["وَاركَب جِيادَ ابنِ النَبِيِّ طَوامِحاً","مِثلَ الصُقورش دَوالِجاً في العَسجَدِ",82,"د",1,0],["واركب سفينتهم بالصدق مُعتمداً","تجد سبيلك في بحر الهوى عجبا",83,"ب",2,0],["وارْكَبِ الليلَ إنْ نهى عنه جُبْنٌ","فمُعاني السُّرى بنُجْحٍ حَقيقُ",84,"ق",1,0],["وأركانُها خمسٌ عتاقٌ نجائبُ","تسيرُ على حكمِ الحقيقةِ بالصّوى",85,"ا",1,0],["واركب ببحر الذنوب فلك ال","رجا وخلِّ الهوى لتسلم",86,"م",1,0],["واركب البحرَ منشداً ولهي","هزَّتُه مثل هزة الطرب",87,"ب",1,0],["وَاركَب عَلى اسم اللَه إِنكَ راجع","بعداك أَسرى وَالخُيول جَنائب",88,"ب",1,0],["واركب حد السيف في حومو الوغى","إذا لم أجد إلا إلى السيف مفزعا",89,"ع",2,0],["واركن إلى النفس بعد الله معتمداً","إذا أردت من الاسعاد تنويلا",90,"ل",2,0],["وأركب متن البيد سيراً إلى العلى","وما كل قوال إذا قال فعال",91,"ل",1,0],["وَأَركَزَت أَعلامهُ المَكسورَه","بَل نَزَلَت جُنودهُ المَقهورَه",92,"ه",1,0],["وآرك أوقات الصفو إذا","في جنة أنس في دانية",93,"ه",1,0],["وآرك وانظر قوما عذلوا","حتى خاضوا في الآثام",93,"م",1,0],["واركب الحزم في الأمور إذا ما","بان وجهُ الصّواب واشدُد حزامه",94,"م",2,0],["واركب مطايا الحزم وهي هنية","فالحزم نهج ليس فيه تكتم",95,"م",1,0],["وأركم في القلوب جبال هم","فأرساها وقد كانت سرابا",96,"ب",2,0],["وأركبت ظهر كورٍ حسراً وسرت","بها أسارى على الأنضا بغير حمى",97,"م",2,0],["وَأَركب للأَهوال أَصعبَ مركبٍ","وَأَصدم صدر الداهمات العظائم",98,"م",1,0],["واركب نجيب التوب في المثلى إلى","ساحات ذي الطول المجيب السائل",99,"ل",1,0],["وَارْكَبْ جَوادَ الدَّهْرِ وَاسْبِقْ إلى","ما تَشْتَهِيهِ قَدْ مَلَكْتَ العِنان",100,"ن",1,0],["وَارْكَبِ الجِدَّ وَلاَ تَحْفِلْ بِمَا","فِيهِ لَهْوٌ مِنْ أغَانٍ أوْ غَزَلْ",101,"ل",1,0],["وأَركَسِيلانٍ وإِكلُورِينُسِ","وبَعضُهُم من أَهلِ وَعرِ أُولِسِ",102,"س",1,0],["وأركبه معه السفنا","فبيع بلمنوس ممتهنا",103,"ن",2