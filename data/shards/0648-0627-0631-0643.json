{"poems":[[53,"أحبك ما أقام منى وجمع","https://www.aldiwan.net/poem29632.html","الوافر"],[53,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[63,"يا صاحبي أثيراها على عجل","https://www.aldiwan.net/poem45892.html","البسيط"],[77,"ياصاح لا تبك عهدا للوصال مضى","https://www.aldiwan.net/poem36074.html","البسيط"],[0,"أرانا موضعين لأمر غيب","https://www.aldiwan.net/poem60.html","الوافر"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[88,"خليل هل من منصت فأبثه","https://www.aldiwan.net/poem44797.html","الطويل"],[88,"لا تشك للناس يوما عسرة الحال","https://www.aldiwan.net/poem44974.html","البسيط"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[85,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[85,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[80,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[74,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[74,"ألا ثل من عرش الشباب وثلما","https://www.aldiwan.net/poem13251.html","الطويل"],[81,"يمثل لي نهج الصراط بوعده","https://www.aldiwan.net/poem61533.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"سأرحل عنكم لا جوادا بعبرة","https://www.aldiwan.net/poem26976.html","الطويل"],[46,"كأن عقول القوم والله شاهد","https://www.aldiwan.net/poem23098.html","الطويل"],[166,"البطن لا أسلكه","https://www.aldiwan.net/poem46845.html","مجزوء الرجز"],[199,"ما لأيام ذا الصبا تتفانى","https://www.aldiwan.net/poem45673.html","الخفيف"],[229,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[259,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[259,"من بحر حمدي لرب المنح مغترفي","https://www.aldiwan.net/poem35943.html","البسيط"],[282,"يا صاح أيقظ راقد العود","https://www.aldiwan.net/poem32809.html","السريع"],[297,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[320,"ما أسعد العيد في وجودك","https://www.aldiwan.net/poem67183.html","مخلع البسيط"],[353,"راح ساقي الراح يجلو القدحا","https://www.aldiwan.net/poem40540.html","الرمل"],[371,"دنت فرأتني عاتبا متطرفا","https://www.aldiwan.net/poem57300.html","الطويل"],[377,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[377,"تنبه دهري من عهود معاهدي","https://www.aldiwan.net/poem59454.html","الطويل"],[391,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[391,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[400,"رسالة إلى فرعون مصر","https://www.aldiwan.net/poem10305.html","عموديه"],[403,"لا صبر لا صبر على ذا البعاد","https://www.aldiwan.net/poem33937.html","السريع"],[441,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[441,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[458,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[461,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[468,"الدهر مد وجزر","https://www.aldiwan.net/poem59984.html","المجتث"],[468,"باكر الراح في أوان البكور","https://www.aldiwan.net/poem60134.html","الخفيف"],[468,"اشرب على نار الشقائق فالندى","https://www.aldiwan.net/poem60250.html","الكامل"],[500,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[551,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[558,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"]],"verses":[["وَأَركانِ العَتيقِ وَبانِيَيها","وَزَمزَمَ وَالمَقامِ وَمَن سَقاها",0,"ا",3,0],["وَأُركِزُ في قُلوبِهِمُ رِماحي","وَأَضرِبُ في دِيارِهِمُ قِبابي",1,"ي",1,0],["وَأَركَبُها مُحَصَّنَةً شَبوباً","تُمانِعُ غَيرَ فارِسِها الرِكابا",2,"ب",2,0],["وَأَرْكَبُ الأَمْرَ تَسْتَوْشي عَواقِبُهُ","خَطْباً يُصافِحُ فيهِ الأَعْيُنَ الأَرَقُ",3,"ق",1,0],["وَارْكُضْ إِلَى اللَّهْوِ أَفْرَاسَ الصِّبَا مَرَحاً","إِذَا وَجَدْتَ لِخَيْلِ اللَّهْوِ مَيْدَانَا",4,"ن",2,0],["وَأَركَبُ في اللَهامِ المُجرِ حَتّى","أَنالَ مَآكِلَ القُحمِ الرِغابِ",5,"ب",1,0],["وَأَركَبُ في الرَوعِ خَيفانَةً","كَسى وَجهَها سَعَفٌ مُنتَشِر",6,"ر",1,0],["وأركب متن الهَول دون لُبانتي","ولست أبالي بالكوارث والكَرْث",7,"ث",1,0],["وأركب على صَهَوات الجِدّ مغترباً","فيما تحاول ذا حلّ وترحال",8,"ل",1,0],["وأركبُ أخمصي إذ لا تُراعي","حَفَايَ كيف كان ولا انتعالي",9,"ي",1,0],["وَاِركَب جَناحَ النَسرِ لا يَعصِمكَ مِن","نَسرٍ يُرَفرِفُ فيهِ عِزرائيلُ",10,"ل",1,0],["وَاِركُزوهُ إِلى القِيامَةِ رُمحاً","كانَ لِلحَشدِ وَالنَدى وَالطِرادِ",11,"د",1,0],["وَأَركَبُ إِذ لا أَرض إلّا غُطامِطٌ","مطيّةَ ماءٍ سَبْحُها فيه إرقالُ",12,"ل",1,0],["وأَركبْ زماناً لا جماحٌ لهُ","من قبْلِ أنْ يحدثَ فيه الجماح",13,"ح",1,0],["وأركبُ عزّاً صهوتي وهي مهرةٌ","أُساور منها بالشبابِ شبابا",14,"ب",2,0],["وأركبُ الهوْلَ في ريعانِ مامَنةٍ","حبُّ الحياة بِحبِّ الموتِ يُغريني",15,"ن",2,0],["وَاِركُض بِنا رَكضاً حَثيثاً","فيهِ عَن نَظَرٍ دَفيقِ",16,"ق",1,0],["وَاِركَب بِنا اللَفظَ الجَليلَ","وَسِر إِلى المَعنى الدَقيقِ",16,"ق",1,0],["وَأَركَبُ أَردافَ الرُبى مُتَأَسِّفاً","فَأَنشَقُ أَنفاسَ الصَبا مُتَنَسِّما",17,"م",2,0],["وَأَركَبني طِرفَ الهَوى غُنجُ طَرفِهِ","وَأَشرَقَني بِالدَمعِ إِشراقُ خَدِّهِ",18,"د",2,0],["وَأَركَبوهُ أَكبَرَ البَهائِمِ","مَركَبَ كِسرى مَلِكِ الأَعاجِمِ",19,"م",1,0],["وَأَركَبُ ظَهرَ الأَرضِ أَو بَطنَ لُجَّةٍ","مُهَملَجَةٍ لَتَشتَكي خَبَبَ السَفرِ",20,"ر",1,0],["وَأَركُدَ فيها تَحتَ عِبءٍ لَو أَنَّهُ","عَلى العيسِ ما قَرَّت بِهِ في المَبارِكِ",21,"ك",1,0],["وأركب الظهرَ بَلَى","مَن ركبَ الظهرَ أَمِنْ",22,"ن",1,0],["واركبِ الجدَ في الأمورِ ولا تجبنْ","إذا فاتَ بعضها أحيانا",23,"ن",2,0],["واركب رؤوسَ السَّمْهَريّة في العُلا","فالرمحُ ناهٍ للعُلا أَن تشسعا",24,"ع",2,0],["واركب به على رخاخ العزمِ","مجتهداً واطلق عنان الحزمِ",25,"م",1,0],["واركع بجامع فرقٍ واسجدنّ به","ثمّ اقترب يا أخا التقريب واعتكف",26,"ف",1,0],["وَاِركَب كُمَيتاً راضها أَشهَبٌ","فَاقَا عِتاقَ الضُمَّرِ القُودِ",27,"د",1,0],["وأَركبني فُلكَ النَجاةِ فأَصبحَت","على ثَبج الدأماءِ سابحةً تَجري",28,"ر",2,0],["وَاِركَع خُضوعاً إِلَيهِ وَاِسجُد","وَاِستَمنِحِ الصَفحَ في سُجودِك",29,"ك",1,0],["وَاِركَب الحَزم إِلى نَيل المُنى","وَرُضِ العَزم إِذا ما جَمَحا",30,"ح",2,0],["وأركبُ بعدَ العُدم والشَّيب تالِياً","يَقودُهما خَلفي ويَمشي تَعسُّفا",31,"ف",2,0],["وإركب من مطاياه جَنيباً","يفوت بوَخده وَخْدَ المطايا",32,"ا",3,0],["وأركبتها طِرفَ الشريعة مُسرَجاً","تصول على الأعداء بين الجلامد",33,"د",1,0],["واركع ورض في ركوعك لا تكن صاح لاه","ثم اعتدل واحمد المولى على ماحباه",34,"ا",2,0],["واركع ورض واعتدل","واسجد مع الساجدات",35,"ت",1,0],["واركض وراءَ شبابِ \"مصرَ\" لأنهم","رفعوا الجباهَ وحاربوا التطبيعا",36,"ع",2,0],["واركب جواد الشوق تكف الرجا","فالشوق للمشتاق نعم الجواد",37,"د",1,0],["وأركد الراسيات الراسيات بها","كيما تسيح فأرست بعد ما سمقا",38,"ق",2,0],["وأركض في ميادين ال","هوى ملء الميادين",39,"ن",1,0],["واركب مطاها فقد استخضعتْ","ذلّاً لأنْ تُلْجَم أو تُثفَرا",40,"ر",2,0],["وأركب الظَّهر ظُهراً لا لُغوب به","جلْداً على الوعرِ مأموناً من السَّأم",41,"م",1,0],["وَاِركُض عَلى كُلِّ لَهوٍ","لَهُ جَبينٌ أَغَرُّ",42,"ر",1,0],["وَاِركَبِ الإِنخِلاعَ إِن كُنتَ مِمَّن","يَشتَهي السَيرَ في طَريقِ السُرورِ",43,"ر",1,0],["وَاِركُض وَلا تَنزِل بِرِجلِكَ ساعَةً","عَن ظَهرِ شَبابِكَ المَدّادِ",44,"د",1,0],["وارْكُنْ إليه وخذْ نَتائجَ قلبِهِ","فمَتى ثبَتَّ بلوحِهِ لم تُخْذَلِ",45,"ل",1,0],["وأركبَهمْ لمُعضلةٍ قَموصٍ","تَشامَسُ عن ركوبِ الرَّاكبينا",46,"ن",2,0],["وأرْكَبني أثباجَ كلّ فضيلةٍ","مُمَنَّعَة الأرجاءِ محميّةِ الغَرْبِ",47,"ب",1,0],["واركع له عن سواه واسجد","إليه في حضرة التعلي",48,"ي",1,0]]}