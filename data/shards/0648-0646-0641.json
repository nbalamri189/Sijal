َى سوى طالبٍ للعلمِ مُجتهِدِ",199,"د",1,0],["ونفورُ الغزلان أقرب للقطع","فإيّاك بعدها الغزلانا",200,"ن",2,0],["ونفاسة الصّمصام في إفرنده","لا في نفاسة غمده ونجاده",201,"د",2,0],["ونفيخ الريح من أبوابنا","في صفير فاق صوت البلبل",202,"ل",1,0],["ونفس تعاف العار حتى كأنّه","هو الثكل طعما أو غدا دونه الثكل",203,"ل",1,0],["ونفيسَةٍ أَقْحَمْتَ نفسَكَ دُونَها","إِنَّ النفائِسَ بالنفوسِ تُنَالُ",204,"ل",1,0],["ونَفْحُ صَباً يَهْفُو عَلَى جَنَباتِهِ","كتَصْعِيد أَنفاسي إذَا لامَ لائِمُ",205,"م",1,0],["ونَفْتَرِشُ الدِّيباجَ منْ جُودِ كَفِّهِ","وَمَا فَرْشُهُ إِلّا الجَوادُ ولِبدُهُ",206,"د",2,0],["ونفسي بها لي عبرةٌ أي عبرةٍ","ولي موقعٌ منها بها لهديف",207,"ف",1,0],["ونفرك أخرانا على حب هذه","وهذي التي أولى من الأصل تفرك",208,"ك",1,0],["ونفرح بالمال والمال فان","ونهتز للمقبل الدنيوي",209,"ي",1,0],["ونفور سمعك من غثاثة منطق","تأباه نفسك كالحديث المفترى",210,"ر",2,0],["ونفحة العطر أشواق تساورني","كأنما مثلت أمواجه ذاتي",211,"ت",2,0],["ونَفحَةٌ من الهوى تلُفُّنا","يومَ الوَداع غُصُنا بغُصُنِ",212,"ن",1,0],["ونفيسةٌ من ماله موهوبةٌ","لم تُحصَ في كيلٍ ولا ميزانِ",213,"ن",1,0],["ونفَّرت بالأنفاس عنّي حُدوجَهم","كأنّ مطاياهم بهنّ تُوسَّمُ",214,"م",1,0],["ونفسٌ قضَتْ فيكم زمانَ شبابها","رجَتْ أنَّها فيكم تَشيبُ وتهرَمُ",214,"م",1,0],["ونفسُ كلِّ طائع","ونارُ كلِّ وَسمِ",215,"م",1,0],["ونفسِّق الراوين من سَرَفٍ","ونشكُّ في الأخبارِ والنَّقْلِ",216,"ل",1,0],["ونفَّر ذؤبانَ الغضا ريحُ ضيغم","تطيح عليه نَوْشةً وعراكا",217,"ك",2,0],["ونفس لم يبت حادي الأماني","يسوقُ رجاءَها فيما يسوقُ",218,"ق",1,0],["ونفسٌ إذا العيش كان اثنتين","عُلاً تُقتنَى وغنىً يؤثَرُ",219,"ر",1,0],["ونفسٌ حرّةٌ لا يزدهيها","حُلَى الدنيا وزخرفُها المُعارُ",220,"ر",1,0],["ونفضتَ عن ظَهرِي بفضلك ثِقل ما","أوعيتُ من نُوبٍ عليّ شدائدِ",221,"د",1,0],["ونَفَّرها رِجالٌ لم يُروَّحْ","على أفهامِهم منها عَزيبُ",222,"ب",1,0],["ونفْسٍ شَعاعٍ قد أخلَّ وقارُها","بعادتِهِ في النازلاتِ الصعائبِ",223,"ب",1,0],["ونفسي لكم تلك التي لودادها","ولو أُغْضِبتْ في واجبٍ ألفُ مُوجِبِ",224,"ب",1,0],["ونفَّرتم أنس القوافي وقد دنتْ","إليكم دُنوّ