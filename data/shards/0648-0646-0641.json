],["ونفحة من عطور","ام ومضة من لآلي",176,"ل",2,0],["وَنَفديهِ بِالأَقمارِ فَهْيَ لِنَعتِه","وبِاسمِ أَبيهِ تَستَديرُ فَتَكمُلُ",177,"ل",1,0],["وَنَفسُ مَقامي ما اِدَّعَيتُ عَلى الوَرى","فَما فيهِ تَفريطٌ لَدَيَّ وَلا فُرطُ",178,"ط",1,0],["وَنَفيي لَكَ إِثباتي","وَإِنكارُكَ عِرفاني",179,"ن",2,0],["وَنَفسٍ صَبٍّ بِالجَوى أَذَبنَها","فَاِنبَعَثَت حَزَناً مِنَ الشُؤونِ",180,"ن",1,0],["وَنَفى مُحدَثَ ما شاهَدتُهُ","قِدَمٌ ثَبَّتَ فيهِ قَدَمَي",181,"ي",1,0],["وَنَفيت الرِقاد عَن جِفن عَيني","وَتَرَكت الفُؤاد في وُسواس",182,"س",1,0],["ونفسَك أَنفِقْ على النّائباتِ","وخَلِّ صديقَكَ للدّهرِ ذُخرا",183,"ر",2,0],["ونفسٌ تَضيقُ الأرضُ عَنها وهمَّةٌ","تطِلُّ عَلَيها من عُلوٍّ وتُشرِفُ",184,"ف",1,0],["وَنَفسٌ تَعاف دَني الورو","ر وَإِن أَفعمت مِنهُ غَدراته",185,"ه",1,0],["وَنَفحة شَممتها","مِن نَشر وَرد الخَفر",186,"ر",1,0],["وَنَفى السَداد وَزادَ في","سَواديَ أَسود خالِهِ",187,"ل",2,0],["ونفسَ الرَّسولِ بنصِّ الكِتابِ","وما النّفسُ كالصَّاحب الأبعدِ",188,"د",1,0],["ونفسُ خيرِ الأَنامِ أنت فَمَنْ","مِثلكَ في العَالمين كلّهمِ",189,"م",1,0],["ونفاقاً بغضه صح كما","حبه عنوان من كان تقيا",190,"ي",2,0],["ونفي للبغاة مع البغايا","وطردهم إلى مصر وشام",191,"م",1,0],["ونفسك صنها قبل إلقائها الردى","فموج الخطايا حولها متلاطم",192,"م",1,0],["ونفي نبوءات النبيئين كلهم","فما أحمد الهادي لدى ذاك بالمهدي",193,"د",2,0],["ونفثة مسطور أتتك فلا تَلُمْ","إذا لم تزنها بالبديع عقود",194,"د",1,0],["ونفاذ أمر لا يرد يطيعه","فيما قضى العاصي من الأقوام",195,"م",1,0],["ونفس لا تسف لمستفاد","ولا تأسى على وفر سليب",196,"ب",1,0],["ونَفَّقَ العلمَ مِن بعد الكسَاد فَما","تَرَى سوى طالبٍ للعلمِ مُجتهِدِ",197,"د",1,0],["ونفورُ الغزلان أقرب للقطع","فإيّاك بعدها الغزلانا",198,"ن",2,0],["ونفاسة الصّمصام في إفرنده","لا في نفاسة غمده ونجاده",199,"د",2,0],["ونفيخ الريح من أبوابنا","في صفير فاق صوت البلبل",200,"ل",1,0],["ونفس تعاف العار حتى كأنّه","هو الثكل طعما أو غدا دونه الثكل",201,"ل",1,0],["ونفيسَةٍ أَقْحَمْتَ نفسَكَ دُونَها","إِنَّ النفائِسَ بالنفوسِ تُنَالُ",202,"ل",1,0],["ونَفْحُ صَباً يَهْفُو عَلَى جَنَباتِهِ","كتَصْعِيد أَنفاسي إذَا لامَ لائِمُ",203,"م",1,0],["ونَفْتَرِشُ الدِّيباجَ منْ جُودِ كَفِّهِ","وَمَا فَرْشُهُ إِلّا الجَوادُ ولِبدُهُ",204,"د",2,0],["ونفسي بها لي عبرةٌ أي عبرةٍ","ولي موقعٌ منها بها لهديف",205,"ف",1,0],["ونفرك أخرانا على حب هذه","وهذي التي أولى من الأصل تفرك",206,"ك",1,0],["ونفرح بالمال والمال فان","ونهتز للمقبل الدنيوي",207,"ي",1,0],["ونفور سمعك من غثاثة منطق","تأباه نفسك كالحديث المفترى",208,"ر",2,0],["ونفحة العطر أشواق تساورني","كأنما مثلت أمواجه ذاتي",209,"ت",2,0],["ونَفحَةٌ من الهوى تلُفُّنا","يومَ الوَداع غُصُنا بغُصُنِ",210,"ن",1,0],["ونفيسةٌ من ماله موهوبةٌ","لم تُحصَ في كيلٍ ولا ميزانِ",211,"ن",1,0],["ونفَّرت بالأنفاس عنّي حُدوجَهم","كأنّ مطاياهم بهنّ تُوسَّمُ",212,"م",1,0],["ونفسٌ قضَتْ فيكم زمانَ شبابها","رجَتْ أنَّها فيكم تَشيبُ وتهرَمُ",212,"م",1,0],["ونفسُ كلِّ طائع","ونارُ كلِّ وَسمِ",213,"م",1,0],["ونفسِّق الراوين من سَرَفٍ","ونشكُّ في الأخبارِ والنَّقْلِ",214,"ل",1,0],["ونفَّر ذؤبانَ الغضا ريحُ ضيغم","تطيح عليه نَوْشةً وعراكا",215,"ك",2,0],["ونفس لم يبت حادي الأماني","يسوقُ رجاءَها فيما يسوقُ",216,"ق",1,0],["ونفسٌ إذا العيش كان اثنتين","عُلاً تُقتنَى وغنىً يؤثَرُ",217,"ر",1,0],["ونفسٌ حرّةٌ لا يزدهيها","حُلَى الدنيا وزخرفُها المُعارُ",218,"ر",1,0],["ونفضتَ عن ظَهرِي بفضلك ثِقل ما","أوعيتُ من نُوبٍ عليّ شدائدِ",219,"د",1,0],["ونَفَّرها رِجالٌ لم يُروَّحْ","على أفهامِهم منها عَزيبُ",220,"ب",1,0],["ونفْسٍ شَعاعٍ قد أخلَّ وقارُها","بعادتِهِ في النازلاتِ الصعائبِ",221,"ب",1,0],["ونفسي لكم تلك التي لودادها","ولو أُغْضِبتْ في واجبٍ ألفُ مُوجِبِ",222,"ب",1,0],["ونفَّرتم أنس القوافي وقد دنتْ","إليكم دُنوَّ العاطشاتِ من الورْدِ",223,"د",1,0],["ونفسك فاحذرها ولا تعطها هوىً","هوى النفس في الدنيا عدوٌ مسلّط",224,"ط",1,0],["وَنَفعِيَ نَفعُ الموسِرينَ وَإِنَّما","سَوامي سَوامُ المُقتِرينَ المَفالِسُ",225,"س",1,0],["وَنَفنى وَلا نَخشَى الفراقَ وَنَلتَقِي","وَلَيسَ عَلَينا فِي اللِّقاءِ أَميرُ",226,"ر",1,0],["ونفوس تقضي وركب يسير","وأمور تبدو ودنيا تدور",227,"ر",1,0],["ونفى الرمي عنه وقتا وحالا","إذ رميت بعنوان القرآن",228,"ن",1,0],["ونفحَةٌ من سِرِّ طَوْرِ قلبِهِ","من بعْدِ موتِ نَشْأَتي تُحْيينِي",229,"ن",2,0],["ونفسِ حُرٍّ عن الأكوانِ قَدْ عزَفتْ","لأجلِ وجهكَ منها الذَّاتُ قَدْ بُذِلتْ",230,"ت",1,0],["وَنَفَّلَنا اللَهُ أَموالَهُم","فَنَأسُرُهُم بَعدَما نَقتُلُ",231,"ل",1,0],["ونفختَ من كَرَمٍ قضى ومضى","روحاً لنا وقتلتَ مِن مَحْلِ",232,"ل",1,0],["وَنَفضتُ بعدك راحتي من معشرٍ","لو سابقوك إلى الفضيلةِ قصّرُوا",233,"ر",3,0],["ونفسٌ تنزّى ليتها في جوانحٍ","لذِي قوَّةٍ يَسطيعها فيردّها",234,"د",3,0],["ونُفِحْنَ من عَبَقِ الجنا","نِ أريجهُ بالذّاكياتِ",235,"ت",1,0],["ونفتكم عن الهدى شهوات","من حلال ومن حرام مهين",236,"ن",1,0],["ونفوسكم مفتونة","بزخارف الماء المهين",237,"ن",1,0],["ونفسه بالله قامت تعمل","فهو الإمام الكامل المكمل",238,"ل",1,0],["ونفسه يعرفها أنها","داخلة في حكم تقديره",239,"ر",2,0],["ونفسُ المرءِ في الدُّنيا أسيرٌ","ومَوْتُ الجسمِ إطلاقُ الأسيرِ",240,"ر",1,0],["ونفعٌ وضَرٌّ عندهُ غيرَ أنَّهُ","إلى النَّفعِ معجالٌ عنِ الضَّرِّ مِكسالُ",241,"ل",1,0],["ونَفَى عيوبَ الناسِ عنهُ جامعاً","ألطافَهُمْ في شَخصهِ فتَفرَّدا",242,"د",2,0],["وَنَفَوهُ عَن أَهلِ البَوادي وَالقُرى","إِذ كُلُّهُم أَهلُ اِعتِبارٍ دائِمِ",243,"م",1,0],["ونَفْسٌ دَفَعَتْهَا غم","رةُ الحُبّ إلى غَمْرِهْ",244,"ر",2,0],["ونفس تُنافِس في المأْثرات","وتُؤثِر منها الذي يُؤْثَر",245,"ر",1,0],["وَنفَقأ ناظريهِ وَلا نُبالي","وَنَجعلُ فوقَ هامتهِ الذرورا",246,"ر",2,0]]}