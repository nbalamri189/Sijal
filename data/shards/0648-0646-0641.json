طويل"],[477,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[480,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[498,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[498,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[534,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[549,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[549,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[549,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[549,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[556,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[556,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[556,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[556,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[560,"إذا ذهب الكثير من الكثير","https://www.aldiwan.net/poem52789.html","الوافر"],[560,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[560,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[561,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[565,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[580,"قعيدك يا يزيد أبا قبيس","https://www.aldiwan.net/poem1747.html","الوافر"]],"verses":[["وَنُفوسُنا مَرضى تَشَبَّثُ مِنكُمُ","بِثناً يُطَهِّرُها مِنَ الأَسقامِ",0,"م",1,0],["وَنَفسي ما عَلِمتَ وَلي جَنانٌ","أَبى لي أَن أُهانَ وَأَن أُذَلّا",1,"ل",2,0],["وَنَفسٌ عَلى صَبرِها مُرَّةٌ","وَقَلبٌ عَلى رَأيِهِ مُجمِعُ",2,"ع",1,0],["وَنَفسُكَ مِن نَفسَيكَ تَشفَعُ لِلنَدى","إِذا قَلَّ مِن أَحرارِهِنَّ شَفيعُها",3,"ه",2,0],["وَنَفسٌ عَلى كَرِّ النَوائِبِ حُرَّةٌ","وَقَلبٌ عَلى حَربِ الزَمانِ مُطيعُ",4,"ع",1,0],["وَنَفَضتُ إِلّا مِن هَواكَ خَواطِري","نَفضَ المُشَمِّرِ بِالعَراءِ وِعاءَ",5,"ا",2,0],["وَنَفحَةٍ مِن رُبا ذي الأَثلِ قابَلَني","بِها نَسيمٌ يُزيرُ القَلبَ أَحزانا",6,"ن",2,1],["ونَفْسٌ على الأيّامِ غَضْبى وقد أبَتْ","تَصاريفُها أن تُبْدِلَ السُّخْطَ بالرِّضى",7,"ض",2,0],["ونَفْحةُ الشِّيحِ إذ فاحَ النسيمُ بها","مِن غُلَّةٍ أضْمَرَتْها النَّفسُ تَشفيني",8,"ي",1,0],["وَنَفسي مُضَمَّنَةٌ مِن هَوا","كِ ما لا تُطيقُ عَلَيه اِصطِبَارا",9,"ر",2,0],["وَنَفخُ نارٍ وَحَملُ عارٍ","وَبَيعُ دارٍ بِرُبعِ فِلسِ",10,"س",1,0],["وَنَفْسٍ إِلَى دَاعِي الْكَمَالِ مُجِيبَةٍ","تَذُوبُ حَيَاءً وَهْيَ غَيْرُ مُرِيَبة",11,"ه",1,0],["وَنَفسي فَريقانِ هَذا بِهِ","مَزَجتُ الوَفاءَ وَذاكَ النَدى",12,"ا",1,0],["وَنَفسي لِنَفسَيكُما البِرَّتَي","نِ مِن كُلِّ ما يُتَوَقّى الفِدا",13,"د",2,0],["وَنَفسي سَوفَ يَسلِبُها وَجِرمي","فَيُلحِقَني وَشيكاً بِالتُرابِ",14,"ب",1,0],["وَنَفسٍ تُرجّى وَصلَها بَعدَ صَرمِها","تَجَمَّلُ كي يَزدادَ غَيظًا حَسودُها",15,"د",3,0],["وَنَفسي إِذا ما كُنتُ وَحدي تَقَطَّعِت","كَما اِنسَلَّ مِن ذاتِ النِظامِ فَريدُها",15,"د",3,0],["ونفائس وثب الضرام بها","ليغولها والريح توعدها",16,"د",3,0],["وَنَفَى عَنْهَا بِهِ","طَارِئَاتِ المِحَنِ",17,"ن",1,0],["وَنَفسٌ دونَ مَطلَبِها الثُرَيّا","وَكَفٌّ دونَها فَيضُ البِحارِ",18,"ر",1,0],["وَنَفسٌ لاتُجاوِرُها الدَنايا","وَعِرضٌ لايَرِفُّ عَلَيهِ عارُ",19,"ر",1,0],["وَنَفسٌ لَها في كُلِّ أَرضٍ لُبانَةً","وَفي كُلِّ حَيٍّ أُسرَةٌ وَمَعاشِرُ",20,"ر",1,0],["وَنَفسٌ تَكَبَّرُ إِلّا عَلَيكَ","وَتَرغَبُ إِلّاكَ عَمَّن رَغِب",21,"ب",1,0],["ونفس ذنبها كالنيلِ مدّا","وما لوعود توبتها وفاء",22,"ا",2,0],["ونفَّر الكلم اللاتي أغازلها","ما نفّر الغيد من شيبي وإقلالي",23,"ي",1,0],["ونفّقت قولي وهو في الدهر كاسدٌ","وحققت ظني وهو في الخلق واهم",24,"م",1,0],["وَنَفسُكَ نَفسُكَ كُن خائِفاً","عَلى حَذَرٍ مِن كَمينِ الجَفا",25,"ا",1,0],["ونفسُ أبي عبد الإله ضنينةٌ","به أن تراه حيث يُكْدى ويعذر",26,"ر",1,0],["ونفَّستْه نفسَ المهمومِ","مشَّاءة في الليل بالنميمِ",27,"م",1,0],["وَنَفسي تُمَنّيني العِراقَ وَأَهلَهُ","وَبِشرٌ هَواها مِنهُمُ وَحَميمُها",28,"م",3,0],["وَنَفسُ المَرءِ تَرصُدُها المَنايا","وَتَحدُرُ حَولَهُ حَتّى يُصابا",29,"ب",2,0],["وَنُفوسُ الخَلقِ إِمّا طينَةٌ","لا سَنا فيها وَإِمّا جَوهَرُ",30,"ر",1,0],["وَنَفسُكَ كَالصَدى في قاعِ بِئرٍ","وَمِثلِ الفَجرِ مُلتَحِفاً بِدَجنِ",31,"ن",1,0],["وَنَفَّرَ الطَيرَ حَتّى ما تُلِمُّ بِهِ","إِلّا كَما اِعتادَتِ الأَحلامُ وَسنانا",32,"ن",2,0],["وَنَفسٌ كُلَّما اِشتاقَت","لِلُقياكُم زَجَرناها",33,"ا",3,0],["وَنَفَضتُ في وَجهِ النَدي","مِ وَقَد أَتى بِالكَأسِ رُدني",34,"ن",2,0],["وَنَفسي بِحَمدِ اللَهِ نَفسٌ أَبِيَّةٌ","فَها هِيَ لا تَهفو وَلا تَتَلَهَّفُ",35,"ف",1,0],["ونَفَضْتُ أَعماقَ الفَضَاءِ فلمْ أَجِدْ","إلاَّ سُكوناً مُتعَباً مَحْمُوما",36,"م",2,0],["ونفذت في اعماق نفسي فاتحا","حتى ملكت منافذ الاحساس",37,"س",1,0],["ونفعت الانام شرقا وغربا","باختراعات قد بلغن المئينا",38,"ن",2,0],["وَنَفحَةٌ مِن قَوافي الشِعرِ كُنتَ لَها","في مَجلِسِ الراحِ وَالرَيحانِ تَحتَشِدُ",39,"د",1,0],["وَنَفَرنَ مِن حَولي وَبَينَ حَبائِلي","كَالسِربِ صادَفَ في الرَواحِ كَمينا",40,"ن",2,0],["وَنَفسٍ لا تُجيبُ إِلى خَسيسِ","وَعَينٍ لا تُدارُ عَلى نَظيرِ",41,"ر",1,0],["وَنَفسي لَهُ نَفسي الفِداءُ لِنَفسِهِ","وَلَكِنَّ بَعضَ المالِكينَ عَنيفُ",42,"ف",1,0],["وَنُفوسٌ إِذا اِنبَرَت لِقِتالٍ","نَفِدَت قَبلَ يَنفَدُ الإِقدامُ",43,"م",1,0],["ونفى الظلَّ الترابيَّ الذي","كان فيه فهو نوريّ السمات",44,"ت",1,0],["ونفسٌ بأعقابِ الأمور بصيرةٌ","لها من طِلاع الغيب حادٍ وقائدُ",45,"د",1,0],["وَنَفَّستَ عَن نَفسِ الظَلومِ وَقَد رَأَت","مَنِيَّتَها بَينَ السُيوفِ اللَواعِبِ",46,"ب",1,0],["وَنَفسُكَ نَفسٌ إِذا ما النُفو","سُ تَوَقَّدنَ لِلشُحِّ مَثلوجَه",47,"ج",2,0],["وَنَفاذٌ يُفُلُّ مُستَصعَبُ الخَط","بِ بِعَزمُِ يَخُدُّ في الجُلمودِ",48,"د",1,0],["وَنَفى الأَراقِمَ أُفعُوانُ مَضِلَّةٍ","يَفري بِنابَيهِ قَميصَ الأَرقَمِ",49,"م",1,0],["وَنَفيرٍ إِلى عَقَرقُسَ أَنفَر","تَ فَكُنتَ المُظَفَّرَ المَيمونا",50,"ن",2,0],["وَنَفسُ الفَتى مَسرورَةٌ بِنَمائِهَ","وَلِلنَقصِ تُنمي كُلُّ ذاتِ نَماءِ",51,"ا",2,0],["وَنَفَّسَ إِذ تَنَفَّسَ مِن كُروبي","وَفَرَّجَ حينَ أَرَّجَ مِن هُمومي",52,"م",2,0],["وَنَفسٌ أَبَت إِلّا نِزاعاً إِلى الصِبا","تَقاعَسَها وَخطُ المَشيبِ فَتَجمَحُ",53,"ح",1,0],["ونفسي وإن مُدّ في عُمرِها","لما لقيَتْ نفسُه لاقيه",54,"ي",2,0],["ونفحةُ الطيبِ في ذوائبها","وصبغةُ الكحل في مآقيها",55,"ي",3,0],["ونفسِ مَلكٍ عظيم قدرُها رجحتْ","بأنفسِ الخلقِ من قيسٍ ومن يمنِ",56,"ن",1,0],["ونفحةُ الزّهر شمُّها عَبِقٌ","وريقةُ الماء بالصَّبا شَبِمَه",57,"م",2,0],["ونَفَيتُ الهَمَّ بِبِنتِ الكَر","مِ وَنَقرِ العودِ فَلَم يَعدِ",58,"د",1,0],["وَنَفَّسَت عَن بارِضٍ مَكروبِ","وَسَكَّنَت مِن نافِرِ الجَنوبِ",59,"ب",1,0],["وَنَفسٌ تَعافُ العارَ حَتّى كَأَنَّهُ","هُوَ الكُفرُ يَومَ الرَوعِ أَو دونَهُ الكُفرُ",60,"ر",1,0],["وَنَفيسَةٍ في أَهلِها مَرجُوَّةً","جَمَعَت صَباحَةَ صورَةٍ وَتَماما",61,"م",2,0],["وَنَفَضتُ مِنهُ يَدي بِعِلقِ مَضَنَّةٍ","فُتَّت بِهِ الأَكبادُ وَالأَعضادُ",62,"د",1,0],["وَنَفحَةُ ريحٍ لِلرَبيعِ ذَكِيَةٌ","وَلَمحَةُ وَجهٍ لِلشَبابِ نَضيرِ",63,"ر",1,0],["وَنَفسٍ إِلى جَوِّ الكَنيسَةِ صَبَّةٍ","وَقَلبٍ إِلى أُفقِ الجَزيرَةِ حَنّانِ",64,"ن",1,0],["ونَفِي بِذمَّتِها وَإِنْ كَرِهَ العِدى","ما في الوفاءِ على الرّجالِ مَلامُ",65,"م",1,0],["ونَفْدِي مِصرَ بالمُهجاتِ تُزْجَى","إذا زَجّوا الكتائب والجنودا",66,"د",2,0],["وَنَفسٌ لَها في كُلِّ عَلياءَ مَوقِفٌ","تَزِلُّ النُفوسُ الشُمُّ عَنهُ وَتَزلَقُ",67,"ق",1,0],["وَنَفسَكَ لا تَبِع إِن كُنتَ حُرّاً","بِزائِلِ مَنصِبٍ وَخَسيسِ مالِ",68,"ل",1,0],["وَنَفسي دَعَتني لِلشَقاءِ كَما دَعَت","عِصاماً إِلى العَلياءِ نَفسُ عِصامِ",69,"م",1,0],["وَنُفوس الجلّاس تَأنف إِلّا","عِندَه أَن تَكون رَهن القُيودِ",70,"د",1,0],["وَنَفَّضَ اللَيلُ عَلى الوَردِ النَدى","وَحَرَّكَت أَغصانَهُ ريحُ الصَبا",71,"ب",2,0],["وَنَفى مَكروهَ سورَتِها","ثُمَّ هَدّاها إِلى الكَرَمِ",72,"م",1,0],["وَنَفَخْتُ نارَ عَداوةٍ لا تُصْطَلَى","بَلْ لا يُطِيقُ لها العَدُوُّ حَسيسا",73,"س",2,0],["ونفحةً منك في إخْميمَ عاطرةً","مِسْكيّةً عَبِقَتْ بالماء والعُشُبِ",74,"ب",1,0],["وَنَفِّروا اللَيلَ عَنكُم","بِلَذَّةٍ وَسُهادِ",75,"د",1,0],["وَنَفسي تُرَجّي كَإِحدى النُفوسِ","وَتَذري النَوائِبُ سَكنَ الذُرى",76,"ر",2,0],["وَنَفسٍ تَمَنَّت لَذيذَ الطَعامِ","فَلَمّا أَصابَت مَناها غَثَت",77,"ت",1,0],["وَنَفسُكَ ظَبيَةٌ رَتَعَت بِقَفرٍ","يُراقِبُ أَخذَها المِغوارُ جَعدُ",78,"د",1,0],["وَنَفسَكَ عُقَّ بِتَركِ السُ","رورِ فَإِنَّ عُقوقَكَ لِلنَفسِ بِر",79,"ر",1,0],["وَنَفسُ الفَتى وَلِيَت جِسمَهُ","إِذا جاءَ ميقاتُها تُعزَلُ",80,"ل",1,0],["وَنُفوسٌ تَرومُ إِرثاً وَما الوا","رِثُ إِلّا المُهَيمِنُ الدَيّانُ",81,"ن",1,0],["وَنَفسي وَالحَمامَةُ لَم تُطَوَّق","مُيَسَّرَةٌ لِأَمرٍ طَوَّقَتهُ",82,"ت",2,0],["وَنَفسَكَ فَاِنعَ وَلا تَنعَني","وَداوِ الكُلومَ وَلا تُبرِقِ",83,"ق",1,1],["ونفثاتُ القلم الساحرِ","في جوبكَ الأفق وطيِّ السحابْ",84,"ب",1,0],["ونفدتْ بقيةٌ من صَحْبِ","تلقتِ الطعنَ بصدرٍ رَحْبِ",85,"ب",1,0],["وَنَفَيْتِ عَنْ عَيْنِي الْمَنَامَ فَمَا لَهَا","غَيْرَ الْمَدَامِعِ وَالسُّهَادِ لَمَاظُ",86,"ظ",1,0],["وَنفحَاتٍ بَاقِيَا","تٍ مِنْ شبَابٍ قَدْ عَبَرْ",87,"ر",1,0],["وَنَفَّسَ كرْبَ الظِّبَا لاَفِتَاتٍ","وَرَوَّحَ أَيِّلَهَا أَصْوَرَا",88,"ر",2,0],["وَنفَائِسُ الذَّهَبِ الضَّوا","حِكِ فِي مُمَازَجَة الحَرِيرْ",89,"ر",1,0],["ونفس الخداع","ونفس الغباء",90,"ا",2,0],["وَنَفسي بِأَنفاسي تَذوبُ حَرارَةً","فَمِن أَينَ يشفى بِالدُموعِ غَليلُ",91,"ل",1,0],["ونَفُورٍ أزْرَى بصَيَّادِهِ الطبِ","وأَعْيَا قِسِيَّهُ وَسِنَانَهْ",92,"ن",2,0],["ونَفَاذٌ في المُعْضِلاتِ برَأْيٍ","ثَاقِبٍ يَكْشِفُ الغُيوبَ ذَكاؤه",93,"ا",3,0],["ونفسُ طاهرةِ الجدَّينِ يَسَّرَها","ربُّ البَريَّةِ للحُسنَى وزَكَاها",94,"ا",3,0],["ونفسُ الفَتَى مسرورَة ٌ بنمائِهَا","وللنقْصِ تنْمُو كُلُّ ذاتِ نمَاءِ",95,"ا",2,0],["ونفَدتُ للأعماقِ من أطباعهم","إذ كنتُ بالأشكال غير قَنوع",96,"ع",1,0],["ونفساً على أن لا تزالَ أمينةً","أخذتُ عليها كلَّ عهدٍ وموثَّق",97,"ق",1,0],["ونفسُك للنفع مخلوقة","فلو رُمت ، لم تدر كيف الضرر",98,"ر",1,0],["ونفسَك في النفع لا تبلُها","وعَقْلَكَ في الخير لا تُجهِد",99,"د",1,0],["وَنفَضتُ كفّيَ من شبابٍ مُخلِفٍ","إيراقهُ للعين مِثلُ ذبوله",100,"ل",2,0],["ونفسي،، سَوفَ يَسْلُبُها، وجِرْمي","، فيلحِقني وشكا بالتراب",101,"ب",1,0],["ونفسي ترجّي، كإحدى ا