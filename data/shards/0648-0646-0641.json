oem56217.html","الكامل"],[461,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[461,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[461,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[464,"مدحتكم للود لا لرغيبة","https://www.aldiwan.net/poem16085.html","الطويل"],[467,"توق حدود البغي يوم تنازع","https://www.aldiwan.net/poem3534.html","عموديه"],[469,"ألا رب راج حاجة لا ينالها","https://www.aldiwan.net/poem50421.html","الطويل"],[473,"ألا نولي قبل الفراق قذور","https://www.aldiwan.net/poem4845.html","الطويل"],[482,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[485,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[503,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[503,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[539,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[554,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[554,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[554,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[554,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[561,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[561,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[561,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[561,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[565,"إذا ذهب الكثير من الكثير","https://www.aldiwan.net/poem52789.html","الوافر"],[565,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[565,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[566,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[570,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[578,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[585,"قعيدك يا يزيد أبا قبيس","https://www.aldiwan.net/poem1747.html","الوافر"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10452","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/46009","الطويل"]],"verses":[["ونفس تجلى في مهابتها الحيا","وحلم توازى فيه عزم يجالد",0,"د",1,0],["وَنُفوسُنا مَرضى تَشَبَّثُ مِنكُمُ","بِثناً يُطَهِّرُها مِنَ الأَسقامِ",1,"م",1,0],["وَنَفسي ما عَلِمتَ وَلي جَنانٌ","أَبى لي أَن أُهانَ وَأَن أُذَلّا",2,"ل",2,0],["وَنَفسٌ عَلى صَبرِها مُرَّةٌ","وَقَلبٌ عَلى رَأيِهِ مُجمِعُ",3,"ع",1,0],["وَنَفسُكَ مِن نَفسَيكَ تَشفَعُ لِلنَدى","إِذا قَلَّ مِن أَحرارِهِنَّ شَفيعُها",4,"ه",2,0],["وَنَفسٌ عَلى كَرِّ النَوائِبِ حُرَّةٌ","وَقَلبٌ عَلى حَربِ الزَمانِ مُطيعُ",5,"ع",1,0],["وَنَفَضتُ إِلّا مِن هَواكَ خَواطِري","نَفضَ المُشَمِّرِ بِالعَراءِ وِعاءَ",6,"ا",2,0],["وَنَفحَةٍ مِن رُبا ذي الأَثلِ قابَلَني","بِها نَسيمٌ يُزيرُ القَلبَ أَحزانا",7,"ن",2,1],["ونَفْسٌ على الأيّامِ غَضْبى وقد أبَتْ","تَصاريفُها أن تُبْدِلَ السُّخْطَ بالرِّضى",8,"ض",2,0],["ونَفْحةُ الشِّيحِ إذ فاحَ النسيمُ بها","مِن غُلَّةٍ أضْمَرَتْها النَّفسُ تَشفيني",9,"ن",2,0],["وَنَفسي مُضَمَّنَةٌ مِن هَوا","كِ ما لا تُطيقُ عَلَيه اِصطِبَارا",10,"ر",2,0],["وَنَفخُ نارٍ وَحَملُ عارٍ","وَبَيعُ دارٍ بِرُبعِ فِلسِ",11,"س",1,0],["وَنَفْسٍ إِلَى دَاعِي الْكَمَالِ مُجِيبَةٍ","تَذُوبُ حَيَاءً وَهْيَ غَيْرُ مُرِيَبة",12,"ه",1,0],["وَنَفسي فَريقانِ هَذا بِهِ","مَزَجتُ الوَفاءَ وَذاكَ النَدى",13,"ا",1,0],["وَنَفسي لِنَفسَيكُما البِرَّتَي","نِ مِن كُلِّ ما يُتَوَقّى الفِدا",14,"د",2,0],["وَنَفسي سَوفَ يَسلِبُها وَجِرمي","فَيُلحِقَني وَشيكاً بِالتُرابِ",15,"ب",1,0],["وَنَفسٍ تُرجّى وَصلَها بَعدَ صَرمِها","تَجَمَّلُ كي يَزدادَ غَيظًا حَسودُها",16,"د",3,0],["وَنَفسي إِذا ما كُنتُ وَحدي تَقَطَّعِت","كَما اِنسَلَّ مِن ذاتِ النِظامِ فَريدُها",16,"د",3,0],["ونفائس وثب الضرام بها","ليغولها والريح توعدها",17,"د",3,0],["وَنَفَى عَنْهَا بِهِ","طَارِئَاتِ المِحَنِ",18,"ن",1,0],["وَنَفسٌ دونَ مَطلَبِها الثُرَيّا","وَكَفٌّ دونَها فَيضُ البِحارِ",19,"ر",1,0],["وَنَفسٌ لاتُجاوِرُها الدَنايا","وَعِرضٌ لايَرِفُّ عَلَيهِ عارُ",20,"ر",1,0],["وَنَفسٌ لَها في كُلِّ أَرضٍ لُبانَةً","وَفي كُلِّ حَيٍّ أُسرَةٌ وَمَعاشِرُ",21,"ر",1,0],["وَنَفسٌ تَكَبَّرُ إِلّا عَلَيكَ","وَتَرغَبُ إِلّاكَ عَمَّن رَغِب",22,"ب",1,0],["ونفس ذنبها كالنيلِ مدّا","وما لوعود توبتها وفاء",23,"ا",2,0],["ونفَّر الكلم اللاتي أغازلها","ما نفّر الغيد من شيبي وإقلالي",24,"ل",2,0],["ونفّقت قولي وهو في الدهر كاسدٌ","وحققت ظني وهو في الخلق واهم",25,"م",1,0],["وَنَفسُكَ نَفسُكَ كُن خائِفاً","عَلى حَذَرٍ مِن كَمينِ الجَفا",26,"ا",1,0],["ونفسُ أبي عبد الإله ضنينةٌ","به أن تراه حيث يُكْدى ويعذر",27,"ر",1,0],["ونفَّستْه نفسَ المهمومِ","مشَّاءة في الليل بالنميمِ",28,"م",1,0],["وَنَفسي تُمَنّيني العِراقَ وَأَهلَهُ","وَبِشرٌ هَواها مِنهُمُ وَحَميمُها",29,"م",3,0],["وَنَفسُ المَرءِ تَرصُدُها المَنايا","وَتَحدُرُ حَولَهُ حَتّى يُصابا",30,"ب",2,0],["وَنُفوسُ الخَلقِ إِمّا طينَةٌ","لا سَنا فيها وَإِمّا جَوهَرُ",31,"ر",1,0],["وَنَفسُكَ كَالصَدى في قاعِ بِئرٍ","وَمِثلِ الفَجرِ مُلتَحِفاً بِدَجنِ",32,"ن",1,0],["وَنَفَّرَ الطَيرَ حَتّى ما تُلِمُّ بِهِ","إِلّا كَما اِعتادَتِ الأَحلامُ وَسنانا",33,"ن",2,0],["وَنَفسٌ كُلَّما اِشتاقَت","لِلُقياكُم زَجَرناها",34,"ا",3,0],["وَنَفَضتُ في وَجهِ النَدي","مِ وَقَد أَتى بِالكَأسِ رُدني",35,"ن",2,0],["وَنَفسي بِحَمدِ اللَهِ نَفسٌ أَبِيَّةٌ","فَها هِيَ لا تَهفو وَلا تَتَلَهَّفُ",36,"ف",1,0],["ونَفَضْتُ أَعماقَ الفَضَاءِ فلمْ أَجِدْ","إلاَّ سُكوناً مُتعَباً مَحْمُوما",37,"م",2,0],["ونفذت في اعماق نفسي فاتحا","حتى ملكت منافذ الاحساس",38,"س",1,0],["ونفعت الانام شرقا وغربا","باختراعات قد بلغن المئينا",39,"ن",2,0],["وَنَفحَةٌ مِن قَوافي الشِعرِ كُنتَ لَها","في مَجلِسِ الراحِ وَالرَيحانِ تَحتَشِدُ",40,"د",1,0],["وَنَفَرنَ مِن حَولي وَبَينَ حَبائِلي","كَالسِربِ صادَفَ في الرَواحِ كَمينا",41,"ن",2,0],["وَنَفسٍ لا تُجيبُ إِلى خَسيسِ","وَعَينٍ لا تُدارُ عَلى نَظيرِ",42,"ر",1,0],["وَنَفسي لَهُ نَفسي الفِداءُ لِنَفسِهِ","وَلَكِنَّ بَعضَ المالِكينَ عَنيفُ",43,"ف",1,0],["وَنُفوسٌ إِذا اِنبَرَت لِقِتالٍ","نَفِدَت قَبلَ يَنفَدُ الإِقدامُ",44,"م",1,0],["ونفى الظلَّ الترابيَّ الذي","كان فيه فهو نوريّ السمات",45,"ت",1,0],["ونفسٌ بأعقابِ الأمور بصيرةٌ","لها من طِلاع الغيب حادٍ وقائدُ",46,"د",1,0],["وَنَفَّستَ عَن نَفسِ الظَلومِ وَقَد رَأَت","مَنِيَّتَها بَينَ السُيوفِ اللَواعِبِ",47,"ب",1,0],["وَنَفسُكَ نَفسٌ إِذا ما النُفو","سُ تَوَقَّدنَ لِلشُحِّ مَثلوجَه",48,"ج",2,0],["وَنَفاذٌ يُفُلُّ مُستَصعَبُ الخَط","بِ بِعَزمُِ يَخُدُّ في الجُلمودِ",49,"د",1,0],["وَنَفى الأَراقِمَ أُفعُوانُ مَضِلَّةٍ","يَفري بِنابَيهِ قَميصَ الأَرقَمِ",50,"م",1,0],["وَنَفيرٍ إِلى عَقَرقُسَ أَنفَر","تَ فَكُنتَ المُظَفَّرَ المَيمونا",51,"ن",2,0],["وَنَفسُ الفَتى مَسرورَةٌ بِنَمائِهَ","وَلِلنَقصِ تُنمي كُلُّ ذاتِ نَماءِ",52,"ا",2,0],["وَنَفَّسَ إِذ تَنَفَّسَ مِن كُروبي","وَفَرَّجَ حينَ أَرَّجَ مِن هُمومي",53,"م",2,0],["وَنَفسٌ أَبَت إِلّا نِزاعاً إِلى الصِبا","تَقاعَسَها وَخطُ المَشيبِ فَتَجمَحُ",54,"ح",1,0],["ونفسي وإن مُدّ في عُمرِها","لما لقيَتْ نفسُه لاقيه",55,"ي",2,0],["ونفحةُ الطيبِ في ذوائبها","وصبغةُ الكحل في مآقيها",56,"ي",3,0],["ونفسِ مَلكٍ عظيم قدرُها رجحتْ","بأنفسِ الخلقِ من قيسٍ ومن يمنِ",57,"ن",1,0],["ونفحةُ الزّهر شمُّها عَبِقٌ","وريقةُ الماء بالصَّبا شَبِمَه",58,"م",2,0],["ونَفَيتُ الهَمَّ بِبِنتِ الكَر","مِ وَنَقرِ العودِ فَلَم يَعدِ",59,"د",1,0],["وَنَفَّسَت عَن بارِضٍ مَكروبِ","وَسَكَّنَت مِن نافِرِ الجَنوبِ",60,"ب",1,0],["وَنَفسٌ تَعافُ العارَ حَتّى كَأَنَّهُ","هُوَ الكُفرُ يَومَ الرَوعِ أَو دونَهُ الكُفرُ",61,"ر",1,0],["وَنَفيسَةٍ في أَهلِها مَرجُوَّةً","جَمَعَت صَباحَةَ صورَةٍ وَتَماما",62,"م",2,0],["وَنَفَضتُ مِنهُ يَدي بِعِلقِ مَضَنَّةٍ","فُتَّت بِهِ الأَكبادُ وَالأَعضادُ",63,"د",1,0],["وَنَفحَةُ ريحٍ لِلرَبيعِ ذَكِيَةٌ","وَلَمحَةُ وَجهٍ لِلشَبابِ نَضيرِ",64,"ر",1,0],["وَنَفسٍ إِلى جَوِّ الكَنيسَةِ صَبَّةٍ","وَقَلبٍ إِلى أُفقِ الجَزيرَةِ حَنّانِ",65,"ن",1,0],["ونَفِي بِذمَّتِها وَإِنْ كَرِهَ العِدى","ما في الوفاءِ على الرّجالِ مَلامُ",66,"م",1,0],["ونَفْدِي مِصرَ بالمُهجاتِ تُزْجَى","إذا زَجّوا الكتائب والجنودا",67,"د",2,0],["وَنَفسٌ لَها في كُلِّ عَلياءَ مَوقِفٌ","تَزِلُّ النُفوسُ الشُمُّ عَنهُ وَتَزلَقُ",68,"ق",1,0],["وَنَفسَكَ لا تَبِع إِن كُنتَ حُرّاً","بِزائِلِ مَنصِبٍ وَخَسيسِ مالِ",69,"ل",1,0],["وَنَفسي دَعَتني لِلشَقاءِ كَما دَعَت","عِصاماً إِلى العَلياءِ نَفسُ عِصامِ",70,"م",1,0],["وَنُفوس الجلّاس تَأنف إِلّا","عِندَه أَن تَكون رَهن القُيودِ",71,"د",1,0],["وَنَفَّضَ اللَيلُ عَلى الوَردِ النَدى","وَحَرَّكَت أَغصانَهُ ريحُ الصَبا",72,"ب",2,0],["وَنَفى مَكروهَ سورَتِها","ثُمَّ هَدّاها إِلى الكَرَمِ",73,"م",1,0],["وَنَفَخْتُ نارَ عَداوةٍ لا تُصْطَلَى","بَلْ لا يُطِيقُ لها العَدُوُّ حَسيسا",74,"س",2,0],["ونفحةً منك في إخْميمَ عاطرةً","مِسْكيّةً عَبِقَتْ بالماء والعُشُبِ",75,"ب",1,0],["وَنَفِّروا اللَيلَ عَنكُم","بِلَذَّةٍ وَسُهادِ",76,"د",1,0],["وَنَفسي تُرَجّي كَإِحدى النُفوسِ","وَتَذري النَوائِبُ سَكنَ الذُرى",77,"ر",2,0],["وَنَفسٍ تَمَنَّت لَذيذَ الطَعامِ","فَلَمّا أَصابَت مَناها غَثَت",78,"ت",1,0],["وَنَفسُكَ ظَبيَةٌ رَتَعَت بِقَفرٍ","يُراقِبُ أَخذَها المِغوارُ جَعدُ",79,"د",1,0],["وَنَفسَكَ عُقَّ بِتَركِ السُ","رورِ فَإِنَّ عُقوقَكَ لِلنَفسِ بِر",80,"ر",1,0],["وَنَفسُ الفَتى وَلِيَت جِسمَهُ","إِذا جاءَ ميقاتُها تُعزَلُ",81,"ل",1,0],["وَنُفوسٌ تَرومُ إِرثاً وَما الوا","رِثُ إِلّا المُهَيمِنُ الدَيّانُ",82,"ن",1,0],["وَنَفسي وَالحَمامَةُ لَم تُطَوَّق","مُيَسَّرَةٌ لِأَمرٍ طَوَّقَتهُ",83,"ت",2,0],["وَنَفسَكَ فَاِنعَ وَلا تَنعَني","وَداوِ الكُلومَ وَلا تُبرِقِ",84,"ق",1,1],["ونفثاتُ القلم الساحرِ","في جوبكَ الأفق وطيِّ السحابْ",85,"ب",1,0],["ونفدتْ بقيةٌ من صَحْبِ","تلقتِ الطعنَ بصدرٍ رَحْبِ",86,"ب",1,0],["وَنَفَيْتِ عَنْ عَيْنِي الْمَنَامَ فَمَا لَهَا","غَيْرَ الْمَدَامِعِ وَالسُّهَادِ لَمَاظُ",87,"ظ",1,0],["وَنفحَاتٍ بَاقِيَا","تٍ مِنْ شبَابٍ قَدْ عَبَرْ",88,"ر",1,0],["وَنَفَّسَ كرْبَ الظِّبَا لاَفِتَاتٍ","وَرَوَّحَ أَيِّلَهَا أَصْوَرَا",89,"ر",2,0],["وَنفَائِسُ الذَّهَبِ الضَّوا","حِكِ فِي مُمَازَجَة الحَرِيرْ",90,"ر",1,0],["ونفس الخداع","ونفس الغباء",91,"ا",2,0],["وَنَفسي بِأَنفاسي تَذوبُ حَرارَةً","فَمِن أَينَ يشفى بِالدُموعِ غَليلُ",92,"ل",1,0],["ونَفُورٍ أزْرَى بصَيَّادِهِ الطبِ","وأَعْيَا قِسِيَّهُ وَسِنَانَهْ",93,"ن",2,0],["ونَفَاذٌ في المُعْضِلاتِ برَأْيٍ","ثَاقِبٍ يَكْشِفُ الغُيوبَ ذَكاؤه",94,"ا",3,0],["ونفسُ طاهرةِ الجدَّينِ يَسَّرَها","ربُّ البَريَّةِ للحُسنَى وزَكَاها",95,"ا",3,0],["ونفوس راقها من سوئها","رنق العيش وفي العيش الغيل",96,"ل",1,0],["ونفلت منها والحياة سفينة","مخرقة الألواح بالموج تحطم",97,"م",1,0],["ونفسُ الفَتَى مسرورَة ٌ بنمائِهَا","وللنقْصِ تنْمُو كُلُّ ذاتِ نمَاءِ",98,"ا",2,0],["ونفاحا أخزى هجوما وتربا","سمّدته الدماء فاخضرّ خصبا",99,"ب",2,0],["ونفوس شحّت على الموت لكن","أيّ موت صان النفوس الشحاحا ؟",100,"ح",2,0],["ونفخت الغرام من حبّة القل","ب كما تنفخ الرياح الهباء",101,"ا",2,0],["ونفَدتُ للأعماقِ من أطباعهم","إذ كنتُ بالأشكال غير قَنوع",102,"ع",1,0],["ونفساً على أن لا تزالَ أمينةً","أخذتُ عليها كلَّ عهدٍ وموثَّق",103,"ق",1,0],["ونفسُك للنفع مخلوقة","فلو رُمت ، لم تدر كيف الضرر",104,"ر",1,0],["ونفسَك في النفع لا تبلُها","وعَقْلَكَ في الخير لا تُجهِد",105,"د",1,0],["وَنفَضتُ كفّيَ من شبابٍ مُخلِفٍ","إيراقهُ للعين مِثلُ ذبوله",106,"ل",2,0],["ونفسي،، سَوفَ يَسْلُبُها، وجِرْمي","، فيلحِقني وشكا بالتراب",107,"ب",1,0],["ونفسي ترجّي، كإحدى النفوس،","وتَذري النوائبُ سَكْنَ الذُّرا",108,"ر",2,0],["ونفحة لله عطريّة","ندّية حيّا بها البائسين",109,"ن",1,0],["ونفسي لو أنّ الجمر مسّ إباءها","على بشرها الريّان لاحترق الجنر",110,"ر",1,0],["ونَفَادٌ في المُعْضِلاتِ برَأْيٍ","ثَاقِبٍ يَكْشِفُ الغُيوبَ ذَكاؤه",111,"ا",3,0],["وَنَفَّضْتُ عَنِّي النَّوْم، أَقْبَلْتُ مِشْيَة َ الْ","حبابِ، وركني، خشية َ القومِ، أزور",112,"ر",1,0],["وکنفضّ نادٍ بالشآم، وسامرٌ","في مصرَ أنت هزاره الصدَّاح",113,"ح",1,0],["ونفحة جدي الغوث الرفاعي","اعارتني برونقها جلالا",114,"ل",2,0],["ونفثة مصدور يفوه بسرها","اخو ارق اعنته سود الطوائل",115,"ل",1,0],["ونفسي علت عن وهدة العيب وارتقت","الى قمة المجد المؤثل والفخر",116,"ر",1,0],["ونفسك في طيها عزة","لسدرة عرش النهى تصعد",117,"د",1,0],["ونفت لكل نجح باب فتح","وأنت رسول مولى الخلق طه",118,"ه",1,0],["ونفسِى لما ترجوهُ عندك أيقنت","فحقق لها دون الخلاف يقينها",119,"ه",2,0],["