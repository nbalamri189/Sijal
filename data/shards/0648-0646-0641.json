َاتُ قَدْ بُذِلتْ",229,"ت",1,0],["وَنَفَّلَنا اللَهُ أَموالَهُم","فَنَأسُرُهُم بَعدَما نَقتُلُ",230,"ل",1,0],["ونفختَ من كَرَمٍ قضى ومضى","روحاً لنا وقتلتَ مِن مَحْلِ",231,"ل",1,0],["وَنَفضتُ بعدك راحتي من معشرٍ","لو سابقوك إلى الفضيلةِ قصّرُوا",232,"ر",3,0],["ونفسٌ تنزّى ليتها في جوانحٍ","لذِي قوَّةٍ يَسطيعها فيردّها",233,"د",3,0],["ونُفِحْنَ من عَبَقِ الجنا","نِ أريجهُ بالذّاكياتِ",234,"ت",1,0],["ونفتكم عن الهدى شهوات","من حلال ومن حرام مهين",235,"ن",1,0],["ونفوسكم مفتونة","بزخارف الماء المهين",236,"ن",1,0],["ونفسه بالله قامت تعمل","فهو الإمام الكامل المكمل",237,"ل",1,0],["ونفسه يعرفها أنها","داخلة في حكم تقديره",238,"ر",2,0],["ونفسُ المرءِ في الدُّنيا أسيرٌ","ومَوْتُ الجسمِ إطلاقُ الأسيرِ",239,"ر",1,0],["ونفعٌ وضَرٌّ عندهُ غيرَ أنَّهُ","إلى النَّفعِ معجالٌ عنِ الضَّرِّ مِكسالُ",240,"ل",1,0],["ونَفَى عيوبَ الناسِ عنهُ جامعاً","ألطافَهُمْ في شَخصهِ فتَفرَّدا",241,"د",2,0],["وَنَفَوهُ عَن أَهلِ البَوادي وَالقُرى","إِذ كُلُّهُم أَهلُ اِعتِبارٍ دائِمِ",242,"م",1,0],["ونَفْسٌ دَفَعَتْهَا غم","رةُ الحُبّ إلى غَمْرِهْ",243,"ر",2,0],["ونفس تُنافِس في المأْثرات","وتُؤثِر منها الذي يُؤْثَر",244,"ر",1,0],["وَنفَقأ ناظريهِ وَلا نُبالي","وَنَجعلُ فوقَ هامتهِ الذرورا",245,"ر",2,0]]}