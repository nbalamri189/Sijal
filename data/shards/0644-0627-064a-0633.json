,[482,"لا يستوي معرب فينا ودرّ حسن","https://www.aldiwan.net/poem24425.html","عموديه"],[482,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[500,"أنا الفتى من بني الصياد لي نسب","https://www.aldiwan.net/poem37773.html","البسيط"],[506,"لا يستوي شرق البلاد وغربها","https://www.aldiwan.net/poem2410.html","الكامل"],[514,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[514,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[515,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[515,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[515,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[515,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[529,"من دونها يا عمر وخز الرماح","https://www.aldiwan.net/poem37480.html","السريع"],[540,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[540,"ومعجب بمديح الشعر يمنعه","https://www.aldiwan.net/poem56732.html","البسيط"],[551,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[551,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[551,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[553,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[562,"ألناس في الدهر لفظ أنت معناه","https://www.aldiwan.net/poem52808.html","البسيط"],[562,"اليوم ربك أعطى القوس باريها","https://www.aldiwan.net/poem52826.html","البسيط"],[562,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[562,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[562,"تناقض الرأي بين الناس والعمل","https://www.aldiwan.net/poem52856.html","البسيط"],[562,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[562,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[567,"أخوك الذي إن أفسد الدهر وده","https://www.aldiwan.net/poem69503.html","الطويل"],[567,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[567,"ومستدير كجرم البدر مسطوح","https://www.aldiwan.net/poem69754.html","البسيط"],[575,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[575,"بمهجتي أفديه","https://www.aldiwan.net/poem2865.html","مجزوء الرجز"],[575,"قد شاب شارب من أحب فجاز لي","https://www.aldiwan.net/poem2870.html","الكامل"],[575,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[586,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["لا يَستَقِرُّ المالُ فَوقَ أَكُفِّهِم","كَالسَيلِ يَزلَقُ عَن ذُرى الأَعلامِ",0,"م",1,0],["لا يُسلِمونَ مَنِ اِتَّقى بِهِمُ","قَرعَ القَنا وَمَواقِعَ النَبلِ",1,"ل",1,0],["لا يَسأَلُ الضَيفُ عَن مَنازِلِهِ","وَمَنزِلُ البَدرِ غَيرُ مُفتَقَدِ",2,"د",1,0],["لا يَستَقِلُّ بِرَحلِهِ","إِلّا الذَوائِبُ وَالهِضابُ",3,"ب",1,0],["لا يَستَشيرونَ إِلّا كُلَّ مُنصَلِتٍ","حامي الحَقيقَةِ طَلّاعٍ عَلى النُقَبِ",4,"ب",1,0],["لا يَستَطيعُ مِنَ الضَرورَةِ حيلَةً","أَمسى تُرَجَّمُ دونَهُ الأَخبارُ",5,"ر",1,0],["لا يسْتقِرُّ قَرارُ أفْكاري إلى","أنْ أستَقِرَّ لَدى عُلاكَ جَليسا",6,"س",2,0],["لاَ يَسْتَقِلُّ بِهَا إِلاَّ أَخُو ثِقَةٍ","لاَ يَتْرُكُ الْجِدَّ فِي حَلٍّ وَترْحَالِ",7,"ل",1,0],["لا يَسوءُ ظنُّكَ منْ أجْلِ سهْمِ","عادَ مغْنى السّعْدِ منْ غيرِ عادَهْ",8,"ه",1,1],["لاَ يَسْتَلِذُّ الْعَيْشَ لَيْثُ الشَّرَى","حَتَّى يَذْودَ الأسْدَ عَنْ غابِهِ",9,"ب",2,0],["لا يَسمَعُ المَرءُ فيها ما يُؤَنِّسُهُ","بِاللَيلِ إِلّا نَئيمَ البومِ وَالضُوَعا",10,"ع",2,0],["لا يَستَفيقونَ مِنها وَهيَ راهَنَةٌ","إِلّا بِهاتِ وَإِن عَلَّوا وَإِن نَهِلوا",11,"ل",3,0],["لا يَستَغِلُّ كَما عَلِمتَ ذَكاءَهُ","وَذَكاؤُهُ كَالخاطِفِ اللَمّاحِ",12,"ح",1,0],["لا يَستَشيرُ سِوى العَزي","مَةِ في المَوارِدِ وَالمَصادِر",13,"ر",1,0],["لا يَستَقِرُّ وَلا يُحَدِّثُ نَفسَهُ","أَن يَنثَني عَن جَيئَةٍ وَذَهابِ",14,"ب",1,0],["لا يَستَشيرونَ إِن هَمّوا سِوى هِمَمٍ","تَأبى المُقامَ عَلى ذُلٍّ وَإِذعانِ",15,"ن",1,0],["لا يَسلَمُ الشَرَفُ الرَفيعُ مِنَ الأَذى","حَتّى يُراقَ عَلى جَوانِبِهِ الدَمُ",16,"م",1,0],["لا يَستَوي الأَخَوانِ أَمّا بَكرُنا","فَيَدينُ لِلمَلِكِ اللِئامِ العُنصُرُ",17,"ر",1,1],["لا يَسْتَقِل بِهِ عَلَى أَعْبَائِهِ","إِلاَّ حِجَى دَرِبٍ وَقَلْبُ هُمَامِ",18,"م",1,0],["لا يستحق كرامة","إلاّ الأصمّ الأبكم",19,"م",1,0],["لا يَستَطيعُ أَخو الصَبابَةِ أَن يُرى","حَجَراً أَصَمَّ وَلا يَكونَ حَديدا",20,"د",2,0],["لا يُسلِمونَ لَدى الحَوادِثِ جارَهُم","وَهُمُ لِمَن خَشِيَ الحَوادِثَ جارُ",21,"ر",1,0],["لا يَستَطيعُ اِمتِناعاً فَقعُ قَرقَرَةٍ","بَينَ الطَريقَينِ بِالبيدِ الأَماليسِ",22,"س",1,0],["لا يَستَطيعُ الناسُ مَحوَ كِتابِهِ","أَنّى وَلَيسَ قَضائُهُ بِمُبَدَّلِ",23,"ل",1,0],["لا يستقرُّ بكفَّيهِ الثراء فما","تلك الحظوظ بها إلاَّ معابره",24,"ر",2,0],["لا يسأل القاصد عن بابه","إلا سنا النشر وطيب الشميم",25,"م",1,0],["لا يُستَدَلُّ عَلى الباري بِصَنعَتِهِ","رَأَيتُم حَدَثاً يَنبي عَن أَزمانِ",26,"ن",1,0],["لا يسلب الله نعمى أنت لابِسُها","فما مشيتَ بها في أرضه مرحا",27,"ح",2,0],["لا يستحيل ولا يغيِّرُ عهدَه","إمساؤهُ أبداً ولا إصباحُهُ",28,"ح",2,0],["لا يستطيعك بالتَنَقُّصِ حادثٌ","وأبَى لك التكميلُ أن تتزيَّدا",29,"د",2,0],["لا يُسمَّى في هزْل شعري ولكن","في أجَلِّ الجليل من أجدادِهْ",30,"د",2,0],["لا يستعير له المَما","دحَ مِن سواهُ مُستعيرُ",31,"ر",1,0],["لا يستعيرُ حُليَّهُ","من غيره بل فيه يظهر",32,"ر",1,0],["لا يُستخفُّ لدى ريح تهبُّ له","ولا عليه ولا تلقاه رجّافا",33,"ف",2,0],["لا يسرقن الحق من قاسم","فليس يخفي الحق سراقه",34,"ق",2,0],["لا يسألُ الحاجةَ المعوجَّ مسلكُها","ولا يحاوِل أمراً بيّنَ الحولِ",35,"ل",1,0],["لا يسودُ امرؤٌ يَعُدُّ الرزايا","في المعالي مغانماً مغنومه",36,"م",2,0],["لا يستثيبُ ببذل العُرف محمدةً","ولا تراه بما أسداهُ مَنّانا",37,"ن",2,0],["لا يستثيب ببذلِ العُرْفِ محْمدةً","ولا يَمُنُّ إذا ما قَلَّد المِننا",38,"ن",2,0],["لا يُسخِطَنَّك ذنبٌ غيرُ معتمدٍ","على الوفاء الذي استخلصته سَكَنا",39,"ن",2,0],["لا يستفزُّكَ بالمكارمِ سُوقةً","وأبوك أكرمُ دائنٍ ومَدين",40,"ن",1,0],["لا يَسبقن إليَّ يا من لا يرى","شأواً له في المجد غير بطين",40,"ن",1,0],["لا يَستَظِلُّ أَخوها وَهُوَ مُعتَجِرٌ","لِرَيدِها مِن سَمومِ الصَيفِ مُلتاحُ",41,"ح",1,0],["لا يَستَقِلُّ ذَوُو الأَضغانِ حَربَهُمُ","وَلا يُبَيِّنُ في عيدانِهِم خَوَرُ",42,"ر",1,0],["لا يَسمَعُ الصَوتَ مُستَكّاً مَسامِعُهُ","وَلَيسَ يَنطِقُ حَتّى يَنطِقَ الحَجَرُ",42,"ر",1,0],["لا يَستَقِلُّ رِجالٌ ما يُحَمَّلَهُ","وَلا قَريبونَ مِن أَخلاقِهِ العُظُمِ",43,"م",1,0],["لا يُسمَعُ الجَهلُ يَجري في نَدِيِّهِمِ","وَلا أُمَيَّةُ مِن أَخلاقِها الفَنَدُ",44,"د",1,0],["لا يَستَقِرُّ بِها إِلّا عَلى وَجَلٍ","كَالطَيرِ بَينَ أَحابيلٍ وَأَشراكِ",45,"ك",1,0],["لا يَستَوي الرَجُلانِ هَذا قَلبُهُ","خالٍ وَهَذا قَلبُهُ الجَهولُ",46,"ل",1,0],["لا يَستَطيعُ الاِنتِصار","وَلا يَطيقُ الاِنكِسار",47,"ر",1,0],["لا يُسفِرُ الحُسنُ النَزيهُ لِناظِرٍ","ما دامَ مِنهُ الطَرفُ غَيرَ نَزيهِ",48,"ي",2,0],["لا يَسمَعُ الحَبَشِيُّ وَسطَ عِراكِها","صَوتاً إِذا ما العَبدُ أَورَدَ مَنهَلا",49,"ل",2,0],["لا يَستَبيكَ الهَمُّ نَفسَكَ عَنوَةً","وَالكأسُ سَيفٌ في يَدَيكَ صَقيلُ",50,"ل",1,0],["لا يَستَقِرُّ مَكانَهُ","وَأَبوكَ كالضِرغام خادِرْ",51,"ر",1,0],["لا يستخف بما يعالج من أسى","إلا الذي قد مات منه ضميره",52,"ر",2,0],["لا يسليني في شقائي إلا","طيف ليلى إن جاد بالالمام",53,"م",1,0],["لا يستوى الباطل والحق","لدى من يفهم",54,"م",1,0],["لا يستطيع بناء مجد صادق","من لا يكون لكاذب هداما",55,"م",2,0],["لا يستوي الناس في اتقان صنعتهم","والقول كالفعل مذموم ومحمود",56,"د",1,0],["لا يسبق الراكب اليعفور ينخسه","من تحتهم تتبارى الضمر القود",57,"د",1,0],["لا يستطيع من البلية","ان يقول الحق حر",58,"ر",1,0],["لا يستوي سرعانها وبطاؤها","والطائرات رفيعة والنوق",59,"ق",1,0],["لا يستوي النور عند","البصير والظلمات",60,"ت",1,0],["لا يستقلّ بسيفه الشعب الذي","لا يستقلّ بنقده المنقود",61,"د",1,0],["لا يَستوي مَن عُمرَه تَحنَّفا","وَمَن رَسولُ اللَهِ أَقصى وَنَفى",62,"ف",2,0],["لا يُسأَلونَ إِذا جَرَت أَلفاظُهُم","مِن أَينَ لِلحَجَرِ اللِسانُ الأَذلَقُ",63,"ق",1,0],["لا يَستَحي أَحَدٌ يُقالُ لَهُ","نَضَلوكَ آلُ بُوَيهِ أَو فَضَلوا",64,"ل",3,0],["لا يَستَكِنُّ الرُعبُ بَينَ ضُلوعِهِ","يَوماً وَلا الإِحسانُ أَن لا يُحسِنا",65,"ن",2,0],["لا يَستَفِزُّني الطَفيفُ وَلا أَرى","تَبَعاً لِبارِقِ خُلَّبٍ إِن أَومَضا",66,"ض",2,0],["لا يَستَريحُ مِنَ الأَلفاظِ مَنطِقُهُ","إِلّا إِلى نَعَمٍ تَفتَرُّ عَن نِعَمِ",67,"م",1,0],["لا يَستَثيبونَ نُعماهُم إِذا سَلَفَت","وَلَيسَ في فَضلِهِم مَنٌّ وَلا كَدَرُ",68,"ر",1,0],["لا يَستَطيعُ جَوادٌ بَعدَ جودِهِمُ","وَلا يُدانيهِمُ قَومٌ وَإِن كَرُموا",69,"م",3,0],["لاَ يَسْتَطِيعُ جَوَادٌ بُعْدَ غَأيَتِهِمْ","وَلاَ يُدَانِيهِمُ قَوْمٌ وَإنْ كَرُمُوا",70,"م",3,0],["لا يَستعيرُ له المُدَّاحُ مَنقَبَةً","ولا يقولون فيه غيرَ ما عَلِموا",71,"م",3,0],["لاَ يستفيقُ كأنَّ نَفثةَ نابلٍ","بَكَرَت عليه أو سُلافَةَ بابلِ",72,"ل",1,0],["لا يستَقِرُّ كأنَّ أَربعَه","فُرْشٌ يَطَا من تَحتِها الجَمرا",73,"ر",2,0],["لا يسلُبانِ أخا الثَّراءِ وإنما","يَتناهبانِ نتائجَ الألبابِ",74,"ب",1,0],["لا يَستَوي مَن يَعمُرُ المَساجِدا","وَمَن يَبيتُ راكِعاً وَساجِدا",75,"د",2,1],["لا يُستَقالُ اليَومَ إِن","وَلّى وَلا لِلأَمسِ رَدُّ",76,"د",1,0],["لا يَستَطيعُ اِنتِقاصاً في مَحَلَّتِهِ","مِنَ القَبيحِ وَلا يَزدادُ في الحَسَنِ",77,"ن",1,0],["لا يَسأَلُ العَبدُ غَيرَ مَن هُوَ بِال","عَفوِ جَديرٌ وَأَنتَ أَجدَرُ بِه",78,"ب",2,0],["لا يُستَعانُ بِهِ وَلا","يُعبا بِما هُوَ قائِلُ",79,"ل",1,0],["لا يَستَطيعُ جُحودَ شامِلِ بِرِّهِ","عَبدٌ قَلائِدُ جودِهِ في جيدِه",80,"د",2,0],["لا يَستَشيرُ سِوى نَفسٍ مُؤَيَّدَةٍ","مَن أَخطَأَ الرَأيَ لا يَستَذنِبُ النُصَحا",81,"ح",2,0],["لا يَستَشيرونَ في الهَيجا سِوى قُضُبٍ","إِذا اِستُشيرَ بِها في مَعرَكٍ نَصَحَت",82,"ت",1,0],["لا يَسأَلونَ أَخاهُم حينَ يَندُبُهُم","في النائِباتِ عَلى ما قالَ بُرهانا",83,"ن",2,0],["لا يَسمَعُ العودَ مِنّا غَيرُ خاضِبِهِ","مِن لَبَّةِ الشوسِ يَومَ الرَوعِ بِالعَلَقِ",84,"ق",1,1],["لا يسمع البحرُ الغضوب إلى","شاكٍ ولا يصغي إلى أحدِ",85,"د",1,0],["لا يستجيبُ لسائلٍ فكأنّهُ","طَلَلٌ وهل طللٌ يجيبُ سُؤالا",86,"ل",2,0],["لا يَسمَعُ 