{"poems":[[82,"شوقي إليك مجدد","https://www.aldiwan.net/poem31468.html","مجزوء الكامل"],[443,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48901","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124719","الكامل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216395",""],[2350,"","https://poetry.dctabudhabi.ae/diwan/poem/147620","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115457","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91306","الكامل"],[4791,"الجرح الاول","https://www.poetsgate.com/ViewPoem.aspx?id=36968",""],[4953,"حروف هجائية غاضبة","https://www.poetsgate.com/ViewPoem.aspx?id=201707",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5843,"أعطني حريتي اطلق يديه","https://www.poetsgate.com/ViewPoem.aspx?id=51302",""],[5848,"اذكرك وانساني","https://www.poetsgate.com/ViewPoem.aspx?id=48967",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""]],"verses":[["أَبِجَنَّةِ الفِردَوسِ أُحْرَمُ","شُرْبَ ماءِ الكَوثَرِ",0,"ر",1,0],["أبجرم واحد يدحض لي","كل إحساني وأقلى ثمّ أجلى",1,"ل",2,0],["أبجرثومة رمتك المقادي","رُ من الريح أم رمتك بسهم",2,"م",1,0],["أبجراءةٍ بارزته متعرضاً","للقاءِ من يلقاك بالنيرانِ",3,"ن",1,0],["ابْجاه عيسى والْكَليم","ومحمدٍ خير البَراه",4,"ا",2,0],["أبجرعائها كواكب نارن","ج دنا في غصونه فتدلى",5,"ل",2,0],["أبجملُ أن أُهانَ بغير جرمٍ","ويحسنُ أن أضامَ بغير ذنبِ",6,"ب",1,0],["أَبجَنَّةٍ من خدّهِ أَو حبَّةٍ","مِن خاله شغلَ الشجيَّ وَأَوصبا",7,"ب",2,0],["أبجرحك بالهوى لاشك ما أمداني","الله على جرح قلبٍ في لجا جوفك",8,"ك",1,0],["((أَبْجِدْ)) وَ((هَوَّزُ)) ثُمَّ ((حُطِّي)) بَعْدَهُم","((كَلَمُنْ)) وَ((سَعْفَصُ)) لا يَفُتكَ هِجَاءُ",9,"ا",2,0],["أَبْجَدِيَّاتُنَا طُمُوحٌ وَعَزْمٌ","وَإِخَاءٌ وَأُلْفَةٌ وَأَمَانُ",10,"ن",1,0],["أبجد الوجدان وش خليت تالي","مابعدها غير بيبان النهايه",11,"ا",3,0],["أبجمع كل حزن الكون في ليلة عشان ابكيك","بكل الدمع واتشتت بضيقاتي.. ولا القاني !",12,"ن",2,1],["أبٌ جريحٌ .. وطفلٌ خائفٌ .. وردىً","يُزخُّ من ثَكنَات الحقد نيرانا",13,"ن",2,0]]}