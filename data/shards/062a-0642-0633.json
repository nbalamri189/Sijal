etry.dctabudhabi.ae/diwan/poem/147265","الطويل"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130292","المتقارب"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204313","الطويل"],[4983,"يا ساكن الروح","https://www.poetsgate.com/ViewPoem.aspx?id=11016",""],[5092,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=190569",""],[5135,"قلوب متحجرة","https://www.poetsgate.com/ViewPoem.aspx?id=202533",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5333,"حروفُ الهجا عشرتها لتكون لي","https://www.poetsgate.com/ViewPoem.aspx?id=9344",""],[5431,"شعر معتّق...","https://www.poetsgate.com/ViewPoem.aspx?id=211179",""],[5459,"كيف السبيل ..?","https://www.poetsgate.com/ViewPoem.aspx?id=193116",""],[5783,"لايشرب الخمرة .. لكن يحتسيها","https://www.poetsgate.com/ViewPoem.aspx?id=34048",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6202,"هيهات هيهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86756&r=&rc=57",""],[463,"نظرة ٌ منكِ ويومٌ بالجريبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59977&r=&rc=33",""],[4890,"الغزو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74048&r=&rc=254",""]],"verses":[["تَقَسَّمَني الهَوى قِطَعا","فَلَم أَرَ مِثلَ ما صَنَعا",0,"ع",2,0],["تَقَسّمَ منْك التُّرْبَ قَوْمي وجيرَتي","فَفي الظَّهْرِ أحْيائِي وفي البَطْنِ أمْواتي",1,"ي",1,0],["تَقَسَّمَهُم رَيبِ الزَمانِ فَما تَرى","لَهُم عَقوَةً مَغشِيَّةَ الحُجُراتِ",2,"ت",1,0],["تقسو قلوبكم لمّا نفاوضكم","كأننا نحن منكم تنقر الحجرا",3,"ر",2,0],["تقسَّمت فيك يا جيد الغزال وفي","مدح الدوادار أمداح وأغزال",4,"ل",1,0],["تقسّمتِ الأَسقامُ أعضاءَ جسمِهِ","ففي كلّ عضوٍ مَألفٌ لكئيبِ",5,"ب",1,0],["تَقَسَّمها نصفان نصف مؤنثٌ","ونصف كخُوط الخيزران مذكر",6,"ر",1,0],["تقسّمهُ صحو ودجن فشمسه","تبرَّج أحياناً وحيناً تَخَفَّر",7,"ر",1,0],["تقسِم الحَلي بين قُبّ خماصٍ","تحت أثنائه وجسمٍ خِدالِ",8,"ل",1,0],["تقسَّمَ أمره شجرٌ وروضٌ","عليه من زواهره فِدامُ",9,"م",1,0],["تُقَسِّمُ في المعروفِ ما أنت مالكٌ","وتجْشَمُ فيه كُلَّ ما أنت جاشمُ",10,"م",1,0],["تَقسِمُ الأمر رهنَ نحرٍ وعَقْرٍ","قد تَحيَّرتَ حيرةَ المدهوم",11,"م",1,0],["تُقَسِّمُ الأَشياءَ أَفهامُنا","وَلَيسَتِ النَخلَةُ إِلّا النَواة",12,"ه",1,0],["تُقسم الكائنات منك بنون","قلم النور خطها فحلاكا",13,"ك",2,0],["تَقَسَّمَ بَينَهُما قَلبُهُ","وَخانَتهُ عَيناهُ وَالأَرجُلُ",14,"ل",1,0],["تَقَسَّمَ زُوَّار منَ الهِنْدِ سقفَها","خِفافٌ على قَلبِ النَّديمِ رِشاقُ",15,"ق",1,0],["تَقَسَّمَتهُم يَدُ الهَيجاءِ عادِلَةً","فَالهامُ لِلبِيض وَالأَبدانُ لِلرَّخَمِ",16,"م",1,0],["تَقَسَّمَهُ خُلْقَانِ لِينٌ وَشِدَّةٌ","بِعَصْفَةِ رِيحٍ فَهْوَ دَاهٍ وَأَرْفَلُ",17,"ل",1,0],["تَقَسَّمَهُ جودٌ يَفيضُ وَهِمَّةٌ","فَمِن مَنهَلٍ غَمرٍ وَمِن جَبَلٍ وَعرِ",18,"ر",1,0],["تَقسو وَتَزعُمُ أَنَّما هِيَ رَحمَةٌ","تُحيي النُفوسَ وَنِعمَةٌ تُمتاحُ",19,"ح",1,0],["تقسَّمها الأَقوامُ لا ذو حَمِيَّةٍ","فَيَحمي وَلا واقٍ فَيُرجى وَقاؤُهُ",20,"ا",3,0],["تَقَسَّمَهُنَّ الحَربُ إِلّا بَقِيَّةً","تَرُدُّ عَلَينا حينَ تُخشى الجَوائِحُ",21,"ح",1,0],["تَقَسَّمَتها ظُنونُ الفِكرِ إِذ خَفِيَت","كَما تَقَسَّمَتِ الأَديانَ آراءُ",22,"ا",2,0],["تَقَسَّمَ كِسرى رَهطُهُ بِسُيوفِهِم","وَأَمسى أَبو العَبّاسِ أَحلامَ نائِمِ",23,"م",1,0],["تُقَسَّمُ أَطواقُ المَنايا وَلَم تَزَل","تَبُتُّ سُلوكاً مِن عُقودِ الخَرائِدِ",24,"د",1,0],["تقسمك الورى قوماً فقوماً","وما لك بالورى ضجر الملول",25,"ل",1,0],["تَقَسَّمَتْنِي النَّوَى مِنْ بَعْدِهِمْ وَعَدَتْ","عَنْهُمْ عَوَادٍ فَلا كُتْبٌ وَلا رُسُلُ",26,"ل",1,0],["تَقسَّمَ بيْنَ النَّفعِ للنَّاسِ قلبُه","وَبَيْنَ جَمِيلِ البِرِّ بِالصَّحْبِ وَالأهْل",27,"ل",1,0],["تقسّم الناس دنياهم وفتنتها","وقد نفرّد من يهوى بدنياه",28,"ا",2,0],["تَقسَّمُهُ أَيدي التِجارِ لَطيمةً","وَيحمِلُهُ الدرايّ أَيّانَ يَمَّما",29,"م",2,0],["تقسمتهم بقاع الأرض فانقذفوا","وخلفوا في القلوب الحزن مستعرا",30,"ر",2,0],["تَقَسَّموا قَلبَهُ ثُمَّ اِغتَدوا زُجَلاً","وَاِستَكرَهوهُ بِدَمعٍ لَم يَكُن يَكف",31,"ف",1,0],["تقسَّم قلبي بين طفلين شطرُهُ","لهذا وهذا قد تعلَّقَ بالشَّطر",32,"ر",1,0],["تقسَّمتني أقاصي الأرضِ إذ بَعُدوا","وأنجزوا لحُداةِ العِيسِ ما وَعدُوا",33,"د",3,1],["تقسمني الهَوى العذرى هما","وَسقما لا أَرى لهما دواء",34,"ا",2,0],["تَقَسَّمَتَا العُلا صَوْلاً وَطَوْلاً","أُعِدَّا لِلْعَدُوِّ وَلِلْوَلِيِّ",35,"ي",1,0],["تقسَّمَ فيها الحسنُ لمّا تفردَّت","فكُلُّ فؤادٍ في هَواها مقسَّمُ",36,"م",1,0],["تقسَّمه رقُّ الجَمال وَجزلُه","فرنَّ وشاحاهُ وصُمَّت خَلاخِلُه",37,"ل",2,0],["تَقسَّمتِ الوُفودُ غداةَ سارَتْ","وخَيلُ الدَّهرِ تَعترِكُ اعْتراكا",38,"ك",2,0],["تَقسَّم وَجدي فيكِ بينَ مكذِّبٍ","بِه حينَ يَلقاني وبَينَ مُصدِّقِ",39,"ق",1,0],["تقسَّم جورُ البينِ قسمينِ في الهوى","فنارٌ لها قلبٌ ودمعٌ له خدُّ",40,"د",1,0],["تُقَسِّمُ ما فيها فإن هي قَسمت","فذاكَ وإِن أكرَت فعن أهلها تُكري",41,"ي",1,1],["تقسم الأفكار والمطامع","قلبي ولا تشفيني المدامع",42,"ع",1,0],["تقسَّم قَلبي في هواهُ فعندهَهُ","فَريقٌ وعندي شُعبَةٌ وفَريقُ",43,"ق",1,1],["تقسم الماءَ والهواءَ لساقٍ","وجناحٍ من عائِمٍ طَيَّارِ",44,"ر",1,0],["تقسّم بين شمسِ ضحىً وبحرٍ","هدايةَ خابطٍ وغِنى عَديمِ",45,"م",1,0],["تَقَسَّمَ رَيْبُ الدَّهْرِ والنَّأي شملَنا","وقلباً غدا لِلبَينِ نَهْباَ مُقَسَّما",46,"م",2,0],["تَقَسَّمَهُنَّ السيفُ والحَيفُ والبِلى","وشَطَّتْ بنا عنها عصورٌ وأَزْمانُ",47,"ن",1,0],["تقسم الزبر أَقساماً وقد قصدت","ليلي وبعض أحاطت دار أَنصار",48,"ر",1,0],["تُقسِم لا خادعَها","مَتاعُها المزخرَفُ",49,"ف",1,0],["تقسَّموا الأرضَ يفتضُّون عُذرتَها","بعدلهم بين عُمّال وعُمّارِ",50,"ر",1,0],["تُقسِّي القلوبَ بعدها وحشةً لها","كأنَّ قلوبَ الغانيات وُكورُها",51,"ر",3,0],["تقسّمَ البأسُ فيهِم والجَمالُ مَعاً","فشابَهَ القِرْنُ منهمْ قَرْنَ شَمسهمِ",52,"م",1,0],["تَقَسُّمُ البيضِ في الهَيجاءِ عادتُهُ","فالدَّمُّ للتربِ وَالأشلاءُ للرخمِ",53,"م",1,0],["تَقَسَّمَني في مالِكٍ آلُ مالِكٍ","وَفي أَسلَمَ الأَثرَينِ آلُ رُزَينِ",54,"ن",1,1],["تَقَسَّمَ الشَوقُ أَنفاسي فَقَطَّعَها","حُبٌّ بِنَفسِيَ في الأَحشاءِ وَالكَبدِ",55,"د",1,0],["تَقَسَّم اسْمُكَ تَقْسِيماً أَردْتَ بِهِ","الصَّادُ عَيْنُكَ والبَاقِي على كَبِدِي",56,"د",2,0],["تَقَسَّمَتا نِصفَي فَنِصفٌ بِمَكَّةٍ","وَنِصفٌ لِأَهلِ الغَورِ فيمَن تُقُسِّما",57,"م",2,0],["تُقَسَّمَ حُسناً بيَن خَصرٍ مؤنَّث","تَجُولُ وشاحاه وصَدرٍ مُذكَّرِ",58,"ر",1,0],["تقسمنا القبائل من معد","علانية كأيسار الجزور",59,"ر",1,0],["تَقَسَّمنَ لُبِّي يَومَ نُعمانَ أَنَّني","بُليتُ بِطَرفٍ فاتِكِ اللَحظاتِ",60,"ت",1,0],["تقسَّم جيرتي وصحاب ودي","رياض في رباها أو رجام",61,"م",1,0],["تقسمهم فكري وذَهني وخاطري","فواللّه ما أدري مَنِ القلب منهم",62,"م",1,0],["تقسّم دمعي في هواكم ومهجتي","وبي صبوة يأبى لمثلي انقسامُها",63,"م",3,0],["تَقَسَّمْنَ أعْشَارَ الفُؤَادِ عَنِيمَةً","كَمَا قَسَمَ الفُتَّاكُ أمْوَالَ مَغْنَمِ",64,"م",1,0],["تَقَسَّموني، فقِسْمٌ لا يُفارِقُهمْ","أَيْنَ اسْتَقلّوا وقسمٌ شَفَّه الدَّنَفُ",65,"ف",1,0],["تَقَسَّمتِ العلياءُ جسمَك كُلَّه","فمن أين فيه للسَّقام نصيبُ",66,"ب",1,0],["تُقسمُني الأيامُ قسمةَ جائر","على نَضرةٍ من حولها وشُحُوبِ",67,"ب",1,0],["تقسمت بيننا الأديان يا أملي","فكنت ديني ومن أحشاك دياني",68,"ن",2,0],["تُقَسَّمُ أمْوَالُهُ في العُفَاةِ","فإن فَضَلَتْ فَلَهُ ما فَضَل",69,"ل",1,0],["تقسم كالنفال بين معاشر","تنادوا إليها في عديد ودردق",70,"ق",1,0],["تقسموا بين مكلوم ومستلب","وهالكٍ بالصّدى لم يروه آل",71,"ل",1,0],["تقسّمني ما بين حَيٍّ وميّتٍ","فمن مَعشَرٍ قَتلى ومن مَعشَرٍ أسرى",72,"ر",2,0],["تقسَّمَ فيوادي قُبا قلبهُ هبا","وفاءً بحقّ القاطنينَ التفَرُّقُ",73,"ق",1,0],["تقسمت الأهواء قلبي كما غدا","نوال علي في العلى متقسما",74,"م",2,0],["تقسم هذا الأمر بيني وبينه","فها هو في شِقٍّ وها أنا في شِقِّ",75,"ق",1,0],["تقسمت كلماتُ الله فانفصلت","أعيانها بعضها عن بعضها الحسن",76,"ن",1,0],["تقسمه تقسيمَ حرِّ ممكن","خبير بما لي فهي للخيرِ واصله",77,"ل",2,0],["تقسم في الإحساسِ من هو واحد","عزيزٌ نزيهُ الذاتِ لا يتقسم",78,"م",1,0],["تقسم قلبي في هواه وإنه","لداء عظيم إن تحققتَ مُعضل",79,"ل",1,0],["تقسم المجد جنساً وهو مجتمعٌ","به وصورته تمت ومعناه",80,"ا",2,0],["تقسم المجد ما بين الملا سلفاً","وحاز من بعدهم هذا تتمتهُ",81,"ت",2,0],["تَقَسَّمَني هَمّي فَجَفنِيَ مُترَعٌ","وَصَدرِيَ بِالضَيفِ الَّذي حَلَّ ضائِقُ",82,"ق",1,0],["تقسمني الهوى غربا وشرقا","فيا للمشرقي المغربي",83,"ي",1,0],["تَقَسَّمَها وَرَبابُ القِداح","مُعَطَّلَةٌ عِندَ ايسارِها",84,"ر",3,0],["تقسَّم اثلاثا قضيباً مهفهفاً","ورِدْفاً زرودياً وصُدْغا مُعقربا",85,"ب",2,0],["تَقسَّمنا المَشاغل فَاِختَصصنا","وَكانَ لِبَعضنا بَعض مُوافق",86,"ق",1,0],["تَقسّمك الأَحزان فَذّاً وَتؤماً","وَتُضوِيكَ أَدواء الهُموم الشَواغل",87,"ل",1,0],["تَقسِمُها وتَضرِبُ مِثلَ القَمَر","فإن تَرَ القسمَ عَن السَّبعَة قَصَر",88,"ر",1,0],["تَقَسَّمت الأَزمانَ فيهِ مَحَبَّتي","فَوَجدِي بِهِ ماضٍ وَآتٍ وَحاضِرُ",89,"ر",1,0],["تَقَسَّمت لَونَهُ الأَبصارُ وَالِهَةً","في حُسنِهِ فَإِذا إِنسانُها بَصَرا",90,"ر",2,0],["تقسمت الأفكار في مدحه كما","غدا وفره بين الوفود مقسما",91,"م",2,0],["تَقسو وَتأَنَف أَن تلين لِعاشِق","أَو أَن تَلينَ الصخرة الصيخودُ",92,"د",1,0],["تقسيمهُ معجزات في ذرى عللِ","كالبرص والصمِّ والعميان والبكمِ",93,"م",1,0],["تُقَسِّمُ فينا قِسْمَةً عَجْرَفِيّةً","وكلٌّ إليها بالمطامع أشْعَبُ",94,"ب",1,0],["تقسم قلبي في محبة معشر","بكل فتى منهم هواي منوط",95,"ط",1,1],["تَقسَّم في الدينا نداهم وَبأسُهم","فَسادوا عَلى الدُنيا بِنارٍ وَجنة",96,"ه",1,0],["تَقسّم نور الشمس أحمر قانيا","وأصفر وضّاحاً وأخضر زاهيا",97,"ي",2,0],["تَقْسمُ الضيزي ووجه","العدل لا شك صفيق",98,"ق",1,0],["تَقَسَّمتُها بَينَ وَجه الحَبيب","وَطَرف الرَقيب مَتى يَغفَلُ",99,"ل",1,0],["تقسيمه الدهر يوما أمسه كغد","في الحلم والجود والإيفاء للذمم",100,"م",1,0],["تقسم الحسن منه والجمال معا","في كل شخص لمعنى الحسن منتسب",101,"ب",1,0],["تَقَسَّمَ الناس بِها قِسمَينِ مِن","بِينِ خَلِيِّ قَلبُهُ وَمُصطَبى",102,"ا",1,0],["تَقَسَّمَ الْمَجْدٌ جِنْساً وهُوَ مُجْتَمِعٌ","بِهِمْ وَصُوُرَتُهُ تَمَّتْ وَمَعْنَاهُ",103,"ا",2,0],["تقسميهُ معجزات في ذوي عللٍ","كالبرص والصمّ والعميان والبكم",104,"م",1,0],["تقسمت بالتعقيد والسهل حاضر","فهذا غرور العقل بالوهم متعب",105,"ب",1,0],["تقسمتها بين وجه الحبيب","ووجه الرقيب متى يغفل",106,"ل",1,0],["تقسم هذا الفضل بين طوائف","وأقسامه مجموعة فيك تختزنْ",107,"ن",1,0],["تقسو علي بحب أنت تزعمه","فأين حبك من سهدي فيشفين