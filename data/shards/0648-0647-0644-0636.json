{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30448","المتقارب"],[147,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[154,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[173,"ترى حيث أعلام العيون تراها","https://www.aldiwan.net/poem1689.html",""],[369,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[422,"بروحك يا سليمى ما لقلبي","https://www.aldiwan.net/poem53844.html","الوافر"],[463,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[463,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[534,"أتى منك يا فخر الأوان وزينة","https://www.aldiwan.net/poem37453.html","الطويل"],[1141,"","https://poetry.dctabudhabi.ae/diwan/poem/130707","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60819","الكامل"],[2501,"","https://poetry.dctabudhabi.ae/diwan/poem/198534","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118743","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91186","الطويل"],[4830,"قافية الحشد الشعبي","https://www.poetsgate.com/ViewPoem.aspx?id=194857",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5302,"والظبي راتع","https://www.poetsgate.com/ViewPoem.aspx?id=201661",""],[5410,"أراك عصيّ الصوت","https://www.poetsgate.com/ViewPoem.aspx?id=142117",""]],"verses":[["وَهَل ضَرر عَلى قمر تسامى","إذا نبحت عَلى القمر الكلاب",0,"ب",1,0],["وَهل ضَرَبَ السّيْفُ مِن غَيْرِ كَفٍّ","وهل ثَبُتَ الرَّأْسُ في غَيْرِ هادِ",1,"د",1,0],["وَهَل ضَمِنَت تِلكَ الحَقائِبُ آنِفاً","أُلوفاً بِها لا تَستَقِلُّ الرَكائِبُ",2,"ب",1,0],["وهل ضاحٍ مع السَّبَرا","تِ كالآوي إلى حِصن",3,"ن",1,0],["وَهَل ضَرَّ قَرنَ الشَمسِ عِندَ ذُرُورِها","عُواءُ كِلابٍ أَو نُباحُ جِراها",4,"ا",3,0],["وهل ضائري أن كنتُ في العَصْرِ آخِراً","إذا كان نُطْقي فوق نُطْق الأوائل",5,"ل",1,0],["وهل ضَحِكَ الأقاح على رباها","وخضَّبَ خدَّه فيها الشقيق",6,"ق",1,0],["وهل ضائعٌ حقيّ ومجدُك شاهدٌ","بفضلي وسلطاني على مالِكَ الشعرُ",7,"ر",1,0],["وهل ضائري شيئاً إذا جئتُ آخراً","تأخُّرُ مِيلادي وقد جئتُ فاصحا",8,"ح",2,0],["وهَلْ ضَرَّ شَمْسَ الأُفْقِ وَهْيَ مُنِيرَةٌ","إذا ضَعفَتْ عَنْ نُورِها الأَعْيُنُ الرُّمْدُ",9,"د",1,0],["وهل ضمير اتصالي عنك متصل","بعامل الجر من مجرور رؤياك",10,"ك",1,0],["وهل ضائر دمعي إذا جاد مِنّةً","ذكرتُ بها إلْفاً قديماً وَمأْلَفَا",11,"ف",2,0],["وهل ضرك الباغي بسهم مكيدة","وأنت بواقي عصمة الله دارع؟",12,"ع",1,0],["وهل ضائرٌ بدر الدجى الكلبُ إن عوى","أو الجبل السامي الذرى وطأة النعل",13,"ل",1,0],["وَهَل ضاعَ حيّ يَكفل البَأس حفظه","وَهَل طاش سَهم بِالنهى غَير حائد",14,"د",1,0],["وَهَل ضَل مَن هاديه رَأيٌ وَحكمةٌ","تضم إِلى إقبال دَهر مساعد",14,"د",1,0],["وهل ضرَّتْ معاولُكم","جبالاً تحضنُ الشُهُبا",15,"ب",2,0],["وهل ضحكت لي فيه سنُّ حبيبة","إليّ وكم سنٍ بدا لي جلاؤه",16,"ا",3,0],["وهل ضاقت الآفاق بعد اتساعها","وجفت بها للعاشقين المنابع",17,"ع",1,0],["وهل ضاقت الذكرى وفي من سرى فيها","فأجفا مداها الجاه والسيف والشعر",18,"ر",1,0]]}