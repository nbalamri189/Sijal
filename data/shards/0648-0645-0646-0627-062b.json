{"poems":[[119,"بحيث اندهش الفكر","https://www.aldiwan.net/poem41097.html","عموديه"],[154,"أرقت لبرق من تهامة مومض","https://www.aldiwan.net/poem68586.html","الطويل"],[520,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54129","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48869","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69338","الهزج"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109443","الوافر"],[3456,"","https://poetry.dctabudhabi.ae/diwan/poem/206007","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72514","الطويل"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[4859,"ونسيت نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=211153",""],[5237,"رويدكم فما سمعي بقابل","https://www.poetsgate.com/ViewPoem.aspx?id=113117",""],[5355,"حقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=203962",""]],"verses":[["ومن آثاره في الكو","ن لاحت انجم زهر",0,"ر",1,0],["وَمِن أَثَرِ يأتيكَ نَصّا عَنِ الصُحفِ","إِلى شيَمٍ قُدسيَّةِ المُتَوَلَّدِ",1,"د",1,0],["ومن أثقلته أيادي الرجال","فلا خفف الله أثقاله",2,"ل",2,0],["ومن آثاره في الفضل سارت","مسير الشمس والبدر اللياحِ",3,"ح",1,0],["ومن آثر الأكفاء واختار واصطفى","رأى كل يوم في المحامد نده",4,"د",2,0],["وَمَن أُثني عَلى نُعما","هُ في سِرِّي وَفي جَهري",5,"ر",2,0],["ومن أثنى عليك يرى سبيلاً","لما يرجوه من كرمٍ ونعمه",6,"م",2,0],["ومن إثمدٍ جَونٍ وكِلْسِ وفضَّة","ومن تُوتِياءِ في معادنه هِنْدِي",7,"د",2,0],["ومن أثر التخديش يحكى بنانها","أساريع ظبي أو مساويك أسحل",8,"ل",1,0],["ومِن أثري (أبوزيدٍ) (كبلفٍ)","وَ لَا عَجَبٌ .. فهُمْ أَوْلَى مِنَ (الغُرْ..)",9,"ر",1,0],["ومن أثمار أفراحي طعمتم","مذاق السعد رغم مرار بؤسي",10,"س",2,0],["ومن أثنى المهيمن ثم صلى","عليه كيف يمدح بالمقاول",11,"ل",1,0],["ومن أثر القصيد رسمت حلما","به قلبي يقوم ويستمِّرُ",12,"ر",1,0]]}