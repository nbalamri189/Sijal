{"poems":[[79,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[75,"أيها الظافر أبشر بالظفر","https://www.aldiwan.net/poem11957.html","الرمل"],[90,"قل لسلمان بعدما كان حرا","https://www.aldiwan.net/poem44799.html","الخفيف"],[68,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[52,"قل لسعدى تحرجي","https://www.aldiwan.net/poem63989.html","مجزوء الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16707","المنسرح"],[108,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[159,"صولج لامين في عذارين","https://www.aldiwan.net/poem55539.html","المنسرح"],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[369,"قل لسديد الحضرة المرتجى","https://www.aldiwan.net/poem60793.html","السريع"],[438,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119953","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119982","السريع"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58521","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74286","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127322","الرمل"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130547","الخفيف"],[4691,"قل: لسامي أخرستَ صوت َ الخصامِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=59591",""],[4691,"إيه ِ سلمى ويا أنامل سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=142520",""],[5970,"قل لسار في مضلات الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=130602",""],[6090,"قل لسكرى فليحيي آنا ليرنو","https://www.poetsgate.com/ViewPoem.aspx?id=170906",""],[4115,"قل لساقي قهوة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607720",""]],"verses":[["قُلْ لِسُكَّانِ رَامَةٍ وَالأَمَانِي","لِلَّيَالِي شَرَّابَةٌ أَكَّالَهْ",0,"ل",2,0],["قُل لِساقينا يَحُز أَكؤُسَهُ","وَلِشادينا يَصِل قَطعَ الوَتَر",1,"ر",1,0],["قل لسلمان بعدما كان حراً","كيف قد جاز رقه والأسار",2,"ر",1,1],["قُل لِساجي العُيونِ قَد سَلَبَت عَي","ناكَ قَلبي وَأَفرَطَت في اِنتِهاكي",3,"ك",2,0],["قُل لِسُعدى تَحَرَّجي","وَجِّهيني لِمَخرَجي",4,"ج",2,1],["قُلْ لِسِنانِ القَناة كيف رأى","أخْلَفَ ما كان في الطّعانِ وأى",5,"ا",2,1],["قل لسعدٍ، وقل لإخوة سعدٍ:","لا يعيدُ الأسى حياةَ فقيد",6,"د",1,0],["قُلْ لِسَمِيِّ الوَصِيِّ يا ثانِيَ القَطْ","رِ وَيَا ثالِثَ الرَّبِيعَينِ",7,"ن",1,0],["قُل لِساري الظَلامِ يُع","مِلُ وَجناءَ كَالفَدَن",8,"ن",1,0],["قُلْ لسديدِ الحضرةِ المُرتجَى","القائلِ المَعْروفَ والفاعلِ",9,"ل",1,1],["قلْ لَسودِ دَعِي الخُروج فإِنَّها","قد مَنَّعتْ غِزْلانَها بثعالِبِ",10,"ب",1,0],["قل لسديد الدين المرجَّى","لا زلت ترجي جودا وترهب",11,"ب",1,1],["قل لسديد الدين يا ماجدا","ليس له في جوده من ضريب",12,"ب",1,1],["قُل لِساداتِ الزَّمانِ","لا بَرِحتُمْ في أَمانِ",13,"ن",1,1],["قُل لِسَعيد الجد يا واحد","فَضلك قَد عَم جَميع العِباد",14,"د",1,1],["قل لساقي قهوة البن","ن إذا ما يجتليها",15,"ه",2,1],["قل لسعد وجه العجوز لقد كن","ت لما قد أوتيت سعدا مخيلا",16,"ل",2,1],["قل: لسامي أخرستَ صوت الخصام ِ","جئتَ قلباً ذا رفعة وتسامِ",17,"م",1,1],["قل : لسلمى لله در افتنانٍ","حسنهُ ساحرٌ يراهُ الأعمى",18,"م",2,0],["قل لسار في مضلات الحياة","يقصر اليوم كثيراً من مناه",19,"ا",2,1],["قل لسكرى فليحيي آنا ليرنو","فتك بنت له بكل العباد",20,"د",1,1],["قل لساقي قهوة","البن إذا ما يجتليها",21,"ه",2,1]]}