{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[74,"عج من العجب فهذي جلق","https://www.aldiwan.net/poem19976.html","الرمل"],[53,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[82,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[33,"من عاشق كلف الفؤاد متيم","https://www.aldiwan.net/poem41822.html","الكامل"],[107,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[302,"بكيت لبرق لاح بالثغر باسمه","https://www.aldiwan.net/poem33167.html","الطويل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[333,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[369,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[415,"عجمتني الخطوب حينا فلما","https://www.aldiwan.net/poem31677.html","عموديه"],[415,"لو أحسنوا في ملكنا أو أعتقوا","https://www.aldiwan.net/poem32423.html","الكامل"],[463,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[463,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[469,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[500,"كذا من شام بارقة الثنايا","https://www.aldiwan.net/poem10288.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122667","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122772","الكامل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138815",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59774","الرمل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56197","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11919","السريع"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113934","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69361","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53110","المديد"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121012","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76029","البسيط"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124017","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62888","الكامل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103621","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36760","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36771","الكامل"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124267","الرجز"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131667",""],[4177,"","https://poetry.dctabudhabi.ae/diwan/poem/105691","البسيط"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104519","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66101","البسيط"],[4513,"","https://poetry.dctabudhabi.ae/diwan/poem/121977","الكامل"],[585,"هل في العراق من الرفاق مواس","https://www.poetsgate.com/ViewPoem.aspx?id=161918",""],[5139,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=68955",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5518,"نور الحياة (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=196535",""],[6069,"بكت الخطوب وثغر مجدك ضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=105696",""]],"verses":[["عَجمَةً طَوَّحَها المِر","ضاخُ وَالعَجمُ رِمامُ",0,"م",1,0],["عَجَمتُم عُودَنَا وعَجمتُمُونَا","فَأَنبَينَا ضُرُوسَ العَاجِمِينَا",1,"ن",2,0],["عج من العجب فهذي جلّق","أصبحت منه على حال ذميم",2,"م",1,1],["عَجَمَ الدَّهْرُ خلْفَتَيْن وسوَّى","بين حالَيْ رخائه والبلاءِ",3,"ا",2,0],["عجمتَ حصاةً لا تلين لعاجمٍ","ورُضْتَ شموساً لا يذلّ لراكبِ",4,"ب",1,0],["عَجَمَت عَلَيهِ بِكَفِّها وَبَنانِها","مِن ماءِ مُقلَتِها بِغَيرِ المُعجَمِ",5,"م",1,0],["عَجَموا قِوامَ مُجرَّبينَ وإنّما","عجموا الحُسامَ وجرَّبوا الرِّئبالا",6,"ل",2,0],["عَجَمتُ مِن آرائِهِ صُلَّباً","ما خارَ في العَجَمِ لَهُ عودُ",7,"د",1,0],["عجمتُهمُ عجَمَ المثقّف عودَه","فَما ظَفِرت كفّي بصلبٍ معاجمُه",8,"م",2,0],["عجمتني الأيام طفلا فما لنت","لأنّي ما كنت أدري الهموما",9,"م",2,0],["عجمت عوده الليالي فما لا","ن ولا خاف من أذى أو وعيد",10,"د",1,0],["عَجَميٌّ إمامُه عَرَبيٌّ","قد ألمّا فليَهْنِكَ الزّائران",11,"ن",1,0],["عَجميُّ عِيدٍ تابِعٌ عَربيَّهُ","من بَعْدِ شَهْرٍ كاملٍ مَعْدود",12,"د",1,0],["عجمتني الخطوب حينا فلما","عجزت أن تطيق مني مساغا",13,"غ",2,1],["عجماءُ تَنطِقُ بالحَنينِ ولم يَهِج","شوقَ القلوبِ كاعَجمِيٍّ ينطِقُ",14,"ق",1,0],["عجمَ الناسَ فكنتم دونهم","يدَه تحمِلُ سيفاً ورِحالَهْ",15,"ل",2,0],["عَجمتُ أيّامَ دهري صعبةً بكُمُ","فسالمتْني وفي أيّامها خَوَرُ",16,"ر",1,0],["عجماءَ ألاَّ أنَّ أفعالها","في كونها تعربُ عنها فصاحْ",17,"ح",1,0],["عجمت مكاسراً طابت نضاراً","وزدت مكارماً كرمت زكايا",18,"ا",3,0],["عَجَمَتني بُزلُ الحَوادِثِ واستَنَّ","ت إلَيَّ الفِصال حَتَّى القَرعَى",19,"ع",2,0],["عَجَمَ الأَعاجِمُ عُودَهُ فَتَطايَرَت","عَن عُودِهِ فِلقاً بُيُوتُ أَعاجِمِ",20,"م",1,0],["عجمية تركية عربية","خود خدلجة وأي رداح",21,"ح",1,0],["عجم الدهرُ قناتي فأبت","وغداَ مطعمها يُستفظع",22,"ع",1,0],["عُجْماً تُغَنِّي جِنُّهُ بِبَيْهَقا","كَأَنَّ لَعَّابِينَ زارُوا هَفْتَقا",23,"ق",2,0],["عجمٌ بهملٍ وهملٌ أن تقارن مع","أيّ العواجم شمت الضبط ساواها",24,"ا",3,0],["عُجمٌ لَو اِسطَعتُ إِذا غَرَّدَت","بَذَلتُ في كُلِّ هِزارٍ هَزار",25,"ر",1,0],["عجَمجَمَةٍ روعاءَ زيّافةِ السُرى","أمونٍ كبُرجِ الأندَرِيِّ المُرَزَّجِ",26,"ج",1,0],["عَجَمَت عودَنا اللَيالي فَلَم يَص","لب لَها غَيرَ ذَلِكَ العودِ عودُ",27,"د",1,0],["عجمت عودي نوائبه","فَنَبَتْ عن كنه مختبره",28,"ر",2,0],["عجميّ الأصل ثم حُسنُهُ","عندما صاد الغزالةَ الأسَد",29,"د",1,0],["عَجماءُ يُفصِحُ بِالرومِيِّ مَنطِقُها","شَمّاءُ عزٍّ نَماها الملكُ إِفريقُ",30,"ق",1,0],["عجمتم اساليب الفصاحة فاصطفت","قرائحكم أسفا أساليبها فرعا",31,"ع",2,0],["عَجَم الحوادثُ عُودَه","فوجدتَه صُلبَ المَعَاجِمْ",32,"م",1,0],["عجمة أعربت بوجه دقيق","وكلام مقطع من كلام",33,"م",1,0],["عَجماءُ يُعرِبُ لَحنُها","سِرَّ الغَرامِ المكتَتم",34,"م",1,0],["عَجماء يُعرِبُ لَحنُها","سِرَّ الغَرام المُكتَمَن",35,"ن",1,0],["عجمجمات في سراها خُشُفا","أدنى مسير الخيزلي والخيطفا",36,"ف",2,0],["عج مثل الخردله عنده وإن","مال يتهادق براسه في زحل",37,"ل",1,0],["عجمت فيهن إخوان الزمان لذا","هيهات بعد على الإخوان اعتمد",38,"د",1,0],["عجم الناس فازدرى غير عودي","وابتلاهم فاختارني من دعاته",39,"ت",2,0],["عُجْمُ البَهاامِ تابَى انْ تُضامَ ولا","أَراكِ تَأْبَيْنَهُ يا خَيْرَةَ الأُمَمِ",40,"م",1,0],["عجماءُ ما كادَتْ تُبينُ لسامعٍ","ولها حديثٌ في الفُؤَادِ صحيح",41,"ح",1,0],["عجم الحوادث والرجال وإنه","صلبٌ على عجم الحوادث عاس",42,"س",1,0],["عجموه فاستعصى فلمّا استيأسوا","نزعوه عن فَوْديه نَزْعاً مُنكَرا",43,"ر",2,0],["عجمت عودك المواقف حتى","عرفتك المثقف السمهريا",44,"ي",2,0],["عجم الخلائق والقلوب هفت","للقاءِ من بالرحمة انتصرا",45,"ر",2,0],["عجميةٌ قرنت بخير متوجٍ","زفت إليه مدائحٌ وممالك",46,"ك",1,0]]}