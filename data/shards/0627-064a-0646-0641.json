{"poems":[[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[74,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[53,"أيها المهدي ثناء جميلا شارك التنميق فيه الصواب","https://www.aldiwan.net/poem8504.html","الخفيف"],[53,"يا ابن بوران لات حين مناص","https://www.aldiwan.net/poem64937.html","الخفيف"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[93,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[93,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[87,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[45,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[68,"أين في الحمى عرب","https://www.aldiwan.net/poem40097.html","المقتضب"],[83,"تنازعني الآمال كهلا ويافعا","https://www.aldiwan.net/poem61463.html","البسيط"],[104,"لذة العيش بسفح الكرمل","https://www.aldiwan.net/poem33109.html","الرمل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140972",""],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[102,"مأساة حارس الملك","https://www.poetsgate.com/ViewPoem.aspx?id=50435",""],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[92,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[92,"في طهران","https://www.poetsgate.com/ViewPoem.aspx?id=179053",""],[93,"أم القرى","https://www.poetsgate.com/ViewPoem.aspx?id=53352",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[80,"رد بري بغيا علي وبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87611&r=&rc=156",""],[97,"عروس المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=745&r=&rc=23",""],[132,"أرى الدنيا وزخرفها غرورا","https://www.aldiwan.net/poem50617.html","الطويل"],[228,"عند ذا هب جالسا وتهيا","https://www.aldiwan.net/poem41607.html","الخفيف"],[246,"منع النفس أن تنال مناها","https://www.aldiwan.net/poem45758.html","الطويل"],[255,"أين فعل المدام بالجلاس","https://www.aldiwan.net/poem14984.html","الخفيف"],[290,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[406,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[408,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[484,"أينفى الاعتصاب بنفي سبع","https://www.aldiwan.net/poem37607.html","الوافر"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[556,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[563,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137348",""],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138088",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64858","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79862","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49586","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202063","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110326","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109300","الرمل"],[2284,"","https://poetry.dctabudhabi.ae/diwan/poem/143050","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28550","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88638","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106868","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205795","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100493","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3149,"","https://poetry.dctabudhabi.ae/diwan/poem/198917",""],[3159,"","https://poetry.dctabudhabi.ae/diwan/poem/205122","المنسرح"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131280",""],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/143000","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76476","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111471","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136899",""],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127081","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136676",""],[4771,"أينفعُ قولي إنَّني لا أُحبِّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=106549",""],[4968,"كان ظلي","https://www.poetsgate.com/ViewPoem.aspx?id=206572",""],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5431,"سادن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209045",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5689,"ترى أنت تهوي غير نفسك في ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=143396",""],[5700,"خَفقَة","https://www.poetsgate.com/ViewPoem.aspx?id=191217",""],[5906,"بي وجع","https://www.poetsgate.com/ViewPoem.aspx?id=188235",""],[5956,"الحب الجسدي","https://www.poetsgate.com/ViewPoem.aspx?id=182495",""],[5956,"تضحيات وشهادات","https://www.poetsgate.com/ViewPoem.aspx?id=192314",""],[5956,"معركة بدر الفلسطينية","https://www.poetsgate.com/ViewPoem.aspx?id=192325",""],[6102,"جُناح","https://www.poetsgate.com/ViewPoem.aspx?id=183610",""],[6102,"عرس برسم الدم!!","https://www.poetsgate.com/ViewPoem.aspx?id=186280",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""]],"verses":[["أَيَنْفَعُنِي جَاهِي وَعِلْمِي وَفِطْنَتِي","وَهَلْ عَصَمَتْ قَبْلِي سِوَايَ فَأُعُصَمَا",0,"م",2,0],["أينفد عني الحزن بعد محمد","وما استنفذت كفي نوافل ماله",1,"ل",2,0],["أين في الدنيا حكيمٌ كريمٌ","أين هُو لا أين إلا الكِذابُ",2,"ب",1,0],["أي نفسٍ تطيبُ عن ترك غُنمٍ","حاصلٍ وقتَ نُهزةٍ وافتراص",3,"ص",1,0],["أين فُلْكٌ فيها وفُلْكٌ إليها","مُنشآتٌ في البحر كالأعلام",4,"م",1,0],["أين فِتيانه الحِسانُ وجُوهاً","أين أشياخُهُ أولو الأحلام",4,"م",1,0],["أَينَ في مَوكِبِ القَريضِ لِوائي","قَد طَواهُ بَيانُهُم وَطَواني",5,"ن",2,0],["أَينَ في نَفسي رُأىً تُسعِدُها","سَرَقَت نِيويوركُ مِن نَفسي رُؤاها",6,"ا",3,0],["أي نفع جنيته في حياتي","أنا من تأويبي ومن إدلاجي",7,"ي",1,0],["أَينَ فِرعَونُ في المَواكِبِ تَترى","يَركُضُ المالِكينَ كَالخَيلِ رَكضا",8,"ض",2,0],["أَينَ فَضلي إِذا قَنِعتُ مِنَ الدَه","رِ بِعَيشٍ مُعَجَّلِ التَنكيدِ",9,"د",1,0],["أَينَ في الحِمى عَرَبُ","لي بِرَبعِهِم أَرَبُ",10,"ب",1,1],["أَيَنفَكُّ عَزمي عَن قُيودٍ ثَقيلَةٍ","أَيَمحو الهَوى عَن طينَةِ القَلبِ طابِعا",11,"ع",2,0],["أَيّ نَفس زَهقت بَعدُ جَوىً","أَي روحٍ قَد تَلاشَت حَسَرات",12,"ت",1,0],["أينفع في الخيمة العذّل","وتشمل من دهرها يشمل",13,"ل",1,1],["أَينَ فِرعَون وَالألى أغرقوا مِن","بَعدِ آيٍ مُفصّلاتٍ وَرِجزِ",14,"ز",1,0],["أين فرعون وهاما","نُ ونمرودُ النسورِ",15,"ر",1,0],["أيُّ نفع للمسك في حُقّةِ المس","كِ وللمال في يَدَيْ خزّانِهْ",16,"ن",2,0],["أين فَتْكُ العيونِ لم يترك الدهْ","رُ سيوفاً لها ولم يُبْقِ غِمْدا",17,"د",2,0],["أيّ نفع يجتني الشعب إذا ،","مات (فرعون) اتبقى الفرعنه ؟",18,"ن",2,0],["ايُّ نَفْس هذي التي لا تعُدُّ العمرَ","غُنْماً إلا بظِلِّ المَغارِم",19,"م",1,0],["أيُّ نفعٍ من عيشةٍ بين زوجينِ","بعيدين نزعةً واختبارا",20,"ر",2,0],["أين فضلُ الشباب إن لم يكن لي","حين أرجو وصالَكُمْ بشفيع",21,"ع",1,0],["أين في نفسي رؤى تسعدها ؟","سرقت نيويورك من نفسي رؤاها",22,"ا",3,0],["أئن فرغت أيامنا من محمد","وأصحابه يوم النشور بعيد",23,"د",1,0],["أيُّ نفعٍ يُجدي احتياطُ شفيق","مُتُّ ضُرَّا فكيف أرهَبُ ضُرَّا",24,"ر",2,0],["أينَ في القدسِ ضلوعٌ غضّةٌ","لم تلامسها ذنابى عقربِ؟",25,"ب",1,0],["أينفعُهم خليلٌ ذاتَ يوم","يكون الشرُّ فيه مستطيرَا",26,"ر",2,0],["أَيُّ نَفعٍ ترجينه يا عَروسي","من بُكاءٍ ما عادَ يَنفَعُ شَيّا",27,"ي",2,0],["أَيُّ نَفعٍ وَالمَوتُ يَنسِجُ ثَوبي","بِخُيوطِ الظَلامِ من مُقلَتَيّا",27,"ي",2,0],["أي نفسٍ مرزوءةٍ مثل نفسٍ","سلبتها أيدي المنونِ أخاها",28,"ا",3,0],["أين فعلُ المدام بالجُلاّسِ","فاملَ لي يا نديمُ بالخمر كأسي",29,"س",2,1],["أين فرعون وشداد ومن","بعده ممن على العرش استوى",30,"و",2,0],["أين فاروقها أمير المساكين","وأين الصديق قلب النبي",31,"ي",1,0],["أين فَتْحُ الفتوحِ يومَ رسمنا","لخيول الإيمانِ دَرْبَ انطلاقِ؟",32,"ق",1,0],["أيُّ نَفْسٍ حُرّةٍ أذلَلْتَها","لحُطامٍ إنّما الدّنيا حُطامُ",33,"م",1,0],["أينفى الاعتصاب بنفي سبع","وإن هطلت لهم عيني بدمع",34,"ع",1,1],["أَيُّ نَفعٍ في أَن أراها دياراً","خالياتٍ ولا أرى دَيّارا",35,"ر",2,0],["أَيُّ نَفعٍ في أَن تُقيم وتمضِي","حَيَداً عن ثَوابِهِ وَاِزوِرارا",36,"ر",2,0],["أين فهم الشمول والشرب منها","بافتكار وأين ذوق الشمول",37,"ل",1,0],["ايَّ نفع يُجديهمِ يومَ يغدو","عابدُ المالِ بينَ اهل الوقود",38,"د",1,0],["أين في الناس من يصور أشبا","ح الأناسيّ في ظلام القبور",39,"ر",1,0],["أَينَ فُؤادي والجَفْنُ والجِسْمُ إِذْ","نَبَتْ سُروري والغَمْضُ والمَضْجَعْ",40,"ع",1,0],["أينَ في عصرنا نرى لك مِثلا","جئتَ بعداً فَفُقتَ من جاءَ قبلا",41,"ل",2,1],["أيَنَفَضِي الدَّهْرُ لم تَظْفَرْ يَدِي بأَخٍ","إذا سمعتُ بسوْءٍ عنهُ لم أخَل",42,"ل",1,0],["أي نفس تولعت باشتياق","ما أمال المقداد غير بقاها",43,"ا",3,0],["أي نفس شأت جميع الورى فخ","راً بأدنى فخر حواه سناها",43,"ا",3,0],["أي نفس ينمي إليها صواب","وهي ما جانَبَت سبيل خطاها",43,"ا",3,0],["أي نفس تُعزى لأجلاف تيم","قد حواها الكساء فيمن حواها",43,"ا",3,0],["أي نفس لم يشجها من مساوٍ","إن رأته بالسابقات سماها",43,"ا",3,0],["أي نفس نالت من الهَدْيِ شيئاً","أنبئت أنه منيل هداها",43,"ا",3,0],["أين فرعون أين هامان من جيش","كأسد تقوه وهو غالب",44,"ب",1,0],["أين في مصر ما استعاد بنوها","يوم عدت ألوفها الزوراء",45,"ا",1,0],["أين فخر الدين فالضيف امير","حل في ذمة لبنان الكبير",46,"ر",1,1],["أين في الروضات غصن","حائزٌ رمانتيها",47,"ي",3,0],["أين في الناس من يبوحُ برأي ٍ","فتلبّي وتستجيبُ الحشودُ ؟",48,"د",1,0],["أَيَنفَعُني فَضلُ الحَنينِ المُرَجَّع","وَهَيهاتَ ما وَجدي عَلَيكَ بِمُنجَعِ",49,"ع",1,1],["أي نفس تطوى على زهد سلمان","وقد كان زادها تقواها",50,"ا",3,0],["أينفعني الحبُّ الجديدُ وصاحبي","فؤادٌ كما شاء الزمانُ قديم",51,"م",1,1],["أين فرعون وكنعان ومن","بطشه اضحى به ضرب المثل",52,"ل",1,0],["أىّ نفس سبَرْتِ غَوْرَ هواها","وتحدّيْت سرّها بالهتْك",53,"ك",1,0],["أينفذ كلا حزننا بعد من له","مآثر حمد ذكرها ليس ينفد",54,"د",1,0],["أَيَنفَع النصح إن قصرت في عَمَلي","لَقَد نَسبت به نسلا لِذي عُقُم",55,"م",1,0],["أين فلان وكم فلانٍ","قد غيبوا في الثرى فبادروا",56,"ر",3,0],["أين فؤادي عن الحتوف إذا","كانت جفوني إلي تجلبها",57,"ب",3,1],["أي نفعٍ ناله لبنان من","معشرٍ ما حذقوا إلا الكلاما",58,"م",2,0],["أينفع قولي إنّني لا أحبّه","ودمعي بما يمليه وجدي يكتب",59,"ب",1,1],["أي نفس اذا الجَنادِل جنت","لَم يجرعها حنظلا وَسموما",60,"م",2,0],["أيَّ نَفَعٍ جَنَيتُ مِن قَهرِ نَفسِي","واقتِحامِ الأَهوالِ فَتكاً بِبَأسِي",61,"ي",1,0],["ائن فتشعر في صدرها","كان انيني وخز الابر",62,"ر",1,0],["أي نفس نفيسة قد فقدنا","فعليها أنفاسنا صعداء",63,"ا",2,0],["أين فرعون كي يرى سحرَ جفنيك","فيلُقى لذي القلوب الحِبالا",64,"ل",2,0],["أينفعُ قولي إنَّني لا أُحبِّهُ","وَدَمعي بما يُميله وَجدِيَ يكتبُ",65,"ب",1,1],["أين فَجْرُ الوصلِ في ليلي فَحَرْفي","بالهوى جُنَّ وَأَشعاري أُسَارى",66,"ر",2,0],["أين فجر الجنان؟ يا فجر هدهد","نغماتي ، ولا تضيّع ندائي",67,"ا",2,0],["أين فاروقها أمير المساكين وأين الصديقُ قلبُ النبيّ","لا حمى الشرق من بنيه ذليلا وهو الشرق أُمة الهاشميّ",68,"ي",1,0],["أين فرعون بعدما قد تمادى ؟","أين منه ممالك وصروح !؟",69,"ح",1,0],["أينَ في ما قيلَ الصوابُ وقلبي","في الأسى والعذابِ صارَ يقيمُ",70,"م",1,0],["أينَ فرَّ الغزالُ منِّي وما كُنْ","تُ بليداً حتَّى يفرَّ الغزالُ؟",71,"ل",1,0],["أئن فيقليني الأنام لأنني","ومن يبد منه الضعف بين الورى يقلا",72,"ل",2,0],["أَيُ نَفعٍ لِ