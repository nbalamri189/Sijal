7,"وافي بعطفتك البشير فلو غدت","https://www.poetsgate.com/ViewPoem.aspx?id=34155",""],[100,"حَنِين","https://www.poetsgate.com/ViewPoem.aspx?id=199745",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"أين منّي","https://www.poetsgate.com/ViewPoem.aspx?id=50140",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[67,"حَيَّ بُلْبَيْسَ مَنْزِلاً في العِمارهْ","https://www.poetsgate.com/ViewPoem.aspx?id=14533",""],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[58,"وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=11530",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[90,"أكلة الثريد","https://www.poetsgate.com/ViewPoem.aspx?id=179172",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[54,"إنَّ هذا الذي داودٌ أبوه","https://www.poetsgate.com/ViewPoem.aspx?id=13853",""],[45,"لكَ في المَجدِ أوّلٌ وَأخيرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31259",""],[45,"إِن تأَملْ مَحاسِنَ الأَصبَهَاني","https://www.poetsgate.com/ViewPoem.aspx?id=31114",""],[91,"موت العبقري","https://www.poetsgate.com/ViewPoem.aspx?id=52962",""],[28,"إن هجاء الباهليين دارما","https://www.poetsgate.com/ViewPoem.aspx?id=21710",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[51,"أحمدُ اللَّه مُبدِئاً ومُعيد","https://www.poetsgate.com/ViewPoem.aspx?id=27043",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[44,"ألاَ تَرَى ما أصدَقَ الأنواءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15643&r=&rc=3",""],[99,"الشقيقتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=341&r=&rc=48",""],[97,"كيف أنساك؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63619&r=&rc=166",""],[31,"بكرَ العاذلاتِ فيها صراحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18816&r=&rc=79",""],[31,"أبهَجْرٍ يُوَدَّعُ الأَجْوَارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18868&r=&rc=131",""],[85,"أخذتْ نعشكِ مصرُ باليمينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9630&r=&rc=120",""],[96,"موت الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66379&r=&rc=55",""],[96,"الشّاطئ المهجور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66348&r=&rc=24",""]],"verses":[["إِنَّها أَنوارُ أَحدا","قٍ وَنُوّارُ حَديقَه",0,"ق",2,0],["إِن هانَ سَفحُ دَمي بِالبَينِ عِندَهُمُ","فَواجِبٌ أَن يَهونَ الدَمعُ إِن سُفِحا",1,"ح",2,0],["إِنَّها مَنزِلٌ بِهِ التَقَمَ الأَج","رَعُ في مَيعَةِ الشَّبابِ رِدائي",2,"ا",2,0],["إِن هَزَّني اليُسرُ لَم أَنهَض عَلى مَرَحٍ","أَو مَسَّني العُسرُ لَم أَجثِم عَلى لَغَبِ",3,"ب",1,0],["إِنَّهم إِن رَأَوا لَدَيكِ رَسولي","حَقَّقوا ما رَأَوا وَكانَ دَليلا",4,"ل",2,1],["إِن هُنتُ عَزَّ وَإِن واصَلتُ صَدَّ وَإِن","أَغضَيتُ لَم يَلتَفِت نَحوي وَلمَ يَكَدِ",5,"د",1,0],["أَنْهَضْتَنِي لَمَّا قَعَدْتُ وَقُمْتُ فِي","نَصْرِي ومَا لِي مِنْ نَصِيرٍ أَوْ وَلِي",6,"ي",1,0],["إِنَّها النَكبَةُ الَّتي كُنتُ أَخشى","إِنَّها الساعَةُ الَّتي كُنتُ آبى",7,"ب",2,0],["إِنَّها اللَفظَةُ الَّتي تَنسِفُ الأَن","فُسَ نَسفاً وَتَفقُرُ الأَصلابا",7,"ب",2,0],["إِنَّهُم لَو أَنصَفوها لَبَنَوا","مَعهَداً تَعتادُهُ كَفُّ الوَهوبِ",8,"ب",1,0],["إِن هُدَّ رُكنُكَ مَنكوباً فَقَد رَفَعَت","لَكَ الفَضيلَةُ رُكناً غَيرَ مَهدودِ",9,"د",1,0],["إِن هَيَّؤوهُ مِن حَريرٍ لَكُم","فَهوَ عَلى لينٍ بِهِ أَفدَحُ",10,"ح",1,0],["إِنَّهُم كَالظُبا أَلَحَّ عَلَيها","صَدَأُ الدَهرِ مِن ثَواءِ وَغِمدِ",11,"د",1,0],["إِنَّها مُثلَةٌ تَشُفُّ عَن الغَي","ظِ وَلَسنا لِغَيظِكُم أَندادا",12,"د",2,0],["إِنَّ هَذا الكَريمَ قَد صانَ عِرضي","وَحَماني مِن عادِياتِ السَقامِ",13,"م",1,0],["إِن هَنَّؤوكَ بِها فَلَستُ مُهَنِّئاً","إِنّي عَهِدتُكَ قَبلَها مَحسودا",14,"د",2,1],["إِنَّها لَو دَرَت مَكانَكَ في المَج","دِ وَمَرماكَ في صُدورِ الصِعابِ",15,"ب",1,0],["أَنَهدِيّاً إِذا ما جِئتَ نَهداً","وَتُدعى بِالجَزيرَةِ مِن نِزارِ",16,"ر",1,1],["إِنَّها كانَت زَماناً","رَوضَةً مُؤتَنِفَه",17,"ف",2,0],["إن هذا الإكرام للفن لا لي","والمرام الذي ابتغيتم كبير",18,"ر",1,0],["إِنَّهَا نَهْوَاهُ فِي","سِرِّهَا وَالعَلَنِ",19,"ن",1,0],["إنَّهُ كَانَ للِعُلَى سَكَناً","فَبَكَتْ شَجْوَهَا عَلَى السَّكَنِ",20,"ن",1,0],["إِنَّ هَذِي الْحَيَاةَ سُخْرِيَةٌ تُق","ضَى بِجِدٍّبِئْسَ الطِّبَاقِ الأَلِيمُ",21,"م",1,0],["أَنَهُوضٌ كَاللَّيْثِ ثُمَّ لَقىً","يُبْضَعُ بَضْعاً فَجُثَّةٌ فَرَمِيمُ",21,"م",1,0],["إِنَّ هّذَا الإِقْدَامَ فِيمَا تَوَجَّهْ","تَ إِلَيْهِ يُشَرِّفُ الإِقْدَامَا",22,"م",2,0],["أَنهَلتُ مِنهُ وَالنُجومُ تَزهَرُ","وَلَم يُغَرِّد بِالصَباحِ الحُمَّرُ",23,"ر",1,0],["إنّه أكبر غنيما","فوجب يشكر ويحمد",24,"د",1,0],["أن هذا الجمال شيء عجيب","حيرة في العقول والأفهام",25,"م",1,0],["أنهم أقصر الورى عنك باعاً","وأقلّ الأنام عقلاً وفكرا",26,"ر",2,0],["إنهم حين هاجموك لقتل","كذباب غدا يهاجم نسرا",26,"ر",2,0],["أن هذا في الجاهليّة والإس","لام فعل يعدّ نكراً وكفرا",27,"ر",2,0],["إن هم عماد لعرش أنت ماسكه","فاضرب بغاث العدى منهم بأبواز",28,"ز",1,0],["إن هذا في الحكم منهم لظلم","وهو عار عليهم وشنار",29,"ر",1,0],["أنها مثل حومة الحرب ما دا","رت رَحاها إلاّ على الأبطال",30,"ل",1,0],["أنه واللَّه لا عن كذِب","شرف النفس ونفس الشرف",31,"ف",1,0],["أنهض القوم للعلاء وكانت","في دُنى القوم رقدة وخُمول",32,"ل",1,0],["إن هذا الأفول كان شروقاً","في دياجير طالع منحوس",33,"س",1,0],["إن هذا أمر يتيه ضلالاً","في بوادي تفسيره الحكماء",34,"ا",2,0],["إنه لما أرادت نفسه","ميتة حمراء ما فيها اعتلال",35,"ل",1,0],["إنه يكفيه ما يج","رع من مرّ الشقاء",36,"ا",2,0],["إنهم يسعون للمث","رين سعى الأجراء",36,"ا",2,0],["إنهم قد مهنوا النا","س بكدّ وعناء",36,"ا",2,0],["أَنهِض جَناحَيَّ في ريشي فَقَد رَجَعَت","ريشَ الجَناحَينِ مِن آبائِكَ النِعَمُ",37,"م",1,0],["إِنَّهُمُ الساداتُ وَالغُرَرُ الَّتي","أَطولُ عَلى خَصمي بِها وَأُكاثِرُ",38,"ر",1,0],["إِن هُم أَقاموا حَلَّ فَوقَ رِقابِهِم","أَبَداً وَإِن يَتَحَوَّلوا يَتَحَوَّلِ",39,"ل",1,0],["إن هرَب العبدُ ولا طالب","فسيدُ العبدِ هوَ الهارِب",40,"ب",1,1],["إنَّها كالظباء في أعين الخل","ق ومثل الشنوف في الآذان",41,"ن",1,0],["أنهيت عاليَ قصدي","فيه ورأيك أعلى",42,"ل",2,0],["أنهلَتْ صِبْغَ نفسها ثم عُلَّتْ","من دماءِ القتلى بغير ذنوبِ",43,"ب",1,0],["إنهم مَنْ أتاك بالأمسِ يغزو","ك فلا تُبقيَنَّ منهم غَريبا",44,"ب",2,0],["إنَّه لا يصلح الإح","سانُ إلا لِوعاتِهْ",45,"ت",2,0],["إنه في أبي الحسين وما أحْ","سب إلا بمدحه تغريدَكْ",46,"ك",1,0],["إنها من شكل دار ال","فوز لا دار البوارِ",47,"ر",1,0],["أنهضهُ في أوانِ إنهاضِهِ","غيثٌ دعا طرفَهُ بإيماضِهِ",48,"ض",2,1],["أنهضني بعدما رزَحْتُ وكمْ","من رازحٍ ناهضٍ بإنهاضه",48,"ض",2,0],["إن هتْكَ الثيابِ في دهرنا هَ","ذا شبيهٌ بالهتكِ للأعراضِ",49,"ض",1,1],["أنه عبد لجعسٍ","يشتريه ويبيعه",50,"ه",1,0],["أنهى إليه نصيحٌ غيرُ متَّهمٍ","أن قد تركتَ مغيضَيْ عرسِه ردغه",51,"غ",2,0],["إن هذا الأمر أمر مِعْورٌ","دونه ستر رقيق المستشف",52,"ف",1,0],["إن هذا لحادث لم أخله","في طروق الخطوب ذات الطروق",53,"ق",1,0],["إن هذا من الأمور لبدعٌ","حين ترعى الأمور عينا رموقا",54,"ق",2,0],["إنها كُنيةُ من كا","نَ به عرٌّ كَعرّك",55,"ك",1,0],["إنه لَلجموح يجمحُ في الغَيْ","ي لنِكْل من أعظم الأنكالِ",56,"ل",1,0],["إنَّ هذا من الأمورِ لأمْرٌ","كاد أن لا يقومَ في الأوهام",57,"م",1,0],["إنه أخلَقُ منه للهدى","في معانيه لدى من وزنه",58,"ن",2,0],["أُنهنِهُ غَرْبي عن الجاهلي","نَ حلما وإني لعضب اللسانِ",59,"ن",1,1],["إنّه مِصفْاةُ أعلا","هُ وعِطرٌ لبُطونه",60,"ن",2,0],["إنه يستنقذ المجْ","نونَ من داء جُنونه",60,"ن",2,0],["إن هذين ما علمتَ لَضِدَّا","ن بعيدان عند ذي التشبيه",61,"ي",2,0],["إِنَّهُ الثَعلَبُ مَكراً وَهوَ كَالس","سَرَطانِ غَدراً وَحَكيمٌ كَالغُرابِ",62,"ب",1,0],["إِنَّ هَذا الغَيثَ يَهمي حينَ يَهمي مُكرَها","وَزُهورُ الأَرضِ تُفشي مُجبَراتٍ عِطرَها",63,"ه",2,0],["إِنَّهُ يَسلُبُ الغِوايَةَ كَالرُشدِ","فَلَيسَ التَميِّزُ مِن عاداتِه",64,"ت",2,0],["إِنَّهُ كانَ مَلاكاً بَشَراً","فَمَضى عَنّا المَلاكُ البَشَرُ",65,"ر",1,0],["إِنَّها سِرٌّ فَشا بَينَ الوَرى","وَإِذا السِرُّ فَشا لا يُكتَمُ",66,"م",1,0],["إِنَّها الجَنَّةُ فَاِعجَب لِاِمرِئٍ","هُوَ فيها وَقَليلاً ما يَراها",67,"ا",3,0],["إِنَّهُ غَرسَةٌ سَتَطلُعُ يَوماً","ثَمَراً طَيِّباً وَزَهراً جَنِيّا",68,"ي",2,0],["إِنَّ هَذا عَلِمَ اللَ","هُ هُوَ الغُبنُ الشَديدُ",69,"د",1,0],["إِنَّها غَفلَةٌ لَكَ الوَيلُ مِنها","ما رَواها الرُواةُ في تاريخِ",70,"خ",1,0],["إنَّ هذي الحَيَاةَ قيثارَةُ اللهِ","وأَهْلُ الحَيَاةِ مِثْلُ اللًّحُونِ",71,"ن",1,1],["إنَّه ساحرٌ تُعَلِّمُهُ السِّحْرُ","الشياطينُ كلَّ مَطْلعِ شَمْسِ",72,"س",1,0],["إنَّها في الوجودِ تشكو إلى الأيام","عِبءَ الحَياةِ بالتَّغريدِ",73,"د",1,0],["إنَّها من طِينَةِ الحُزْنِ المَرِيرْ","صَاغَهَا الخَلاّقْ",74,"ق",1,0],["إنها ينبوع إذا جف في الشي","خ فقد روى اليافع الينبوع",75,"ع",1,0],["إن هذا الذي ألم بمصر","حدث فاجع وضرب وجيع",75,"ع",1,0],["إنه لا يزال يلهج باستقلا","ل مصر كعهده ويجد",76,"د",1,0],["إنها حول الشمس تجرى كما طا","فت بليل فراشة بضرام",77,"م",1,0],["انها أحرزت سيادتها بالبط","ش أتى توجهت والخصام",77,"م",1,0],["انه وحده الحبيب الذي قد","كنت منه وكان منك قريبا",78,"ب",2,0],["انهم ضلوا في ظلام الليالي","وهدتك المجرّة البيضاء",78,"ا",2,0],["انهم يكبرون منك زعيما","اقعد الناس شعره واقاما",78,"م",2,0],["انهم لبوا دعوة الشعب لما","قدموا افواجا فكانوا كراما",78,"م",2,0],["ان هذا العفو الذي منحوه","هو شر من الجزاء الرديء",79,"ي",2,0],["ان هذا الجميل الذي نحن منه","هو من هاتيك الضحايا بقايا",80,"ي",2,0],["انه لما قام للمجد يدعو","شخصت عن بعد اليه العيون",81,"ن",1,0],["انها اكوان تدور على انفسها","دورة الرحى مسرعات",82,"ت",1,0],["انهد يصحبه دوي من عل","علم الى غير العلا لم يخلد",83,"د",1,0],["انها في الصميم منه وان لم","يك فيه ظهورها ذا اطراد",84,"د",1,0],["انها سير للتقدم فيه","انها فيه قوة للجهاد",84,"د",1,