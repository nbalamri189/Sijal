{"poems":[[65,"سقى همذان حيا مزنة","https://www.aldiwan.net/poem45813.html","المتقارب"],[63,"إلف الخيال أراك إلفا شاسعا","https://www.aldiwan.net/poem51575.html","الكامل"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[170,"يا أهل جرجان عفاء على","https://www.aldiwan.net/poem47043.html","السريع"],[201,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[412,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17641","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46520","الرجز"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6770","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48242","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53207","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132093","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117842","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59478","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44652","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136505",""],[5191,"الدّمُ الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=212451",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""]],"verses":[["فَسَفحُ المُقَطَّمِ بِئسَ البَديلُ","نَبيهاً وَأَروَندُ نِعمَ المَكانْ",0,"ن",1,0],["فسَفَرْنَ عن شِيَمِ الوَدادِ بَواذِلاً","مِنْ وَصْلِنا ما كُنَّ قبلُ مَوانِعا",1,"ع",2,0],["فَسَفَيتَهُم وَهُمُ الجِبالُ بِعَزمَةٍ","صَدَقَت كَما سَفَتِ الرِياحُ نَسيلا",2,"ل",2,0],["فسُفرتي من خُبزكم قَفرةٌ","وصُرَّتي من خَيركم آيِسَهْ",3,"س",2,0],["فسَفَحتُ الدموعَ بين يديهِ","وهو في شبه حيرة المذهولِ",4,"ل",1,0],["فَسفكت ما كانَ الصَلاح بِسَفكِهِ","وَحقنتَ بَعضَ دِمائِهِ استِصلاحا",5,"ح",2,0],["فسفت بالقلب أين أنت وبال","صدر تشمّر وبالطبع حَيَّهَلِ",6,"ل",1,0],["فَسَفكُ الدِّمَاءِ لَهُ مَورِدٌ","وحَقنُ الدِّمَاءِ لَهُ مَصدَرُ",7,"ر",1,0],["فسفهته عرسه في عشقها","وَذاكَ مِن نُقصانِها وَحمقها",8,"ه",2,0],["فَسَفيني تَجري بِأَطيَبِ ريحٍ","لا بِريحٍ ضَعيفَةٍ نَكباءِ",9,"ا",2,0],["فَسَفكُ دَمٍ يَثورُ لَهُ عَجاجٌ","وَسَفكُ دَمٍ يَثورُ لَهُ دُخانُ",10,"ن",1,0],["فسفحتُ دمعاً كاللُّجَيْنِ فما ارتوَى","منه الثَّرى إِلا اغتدَى كالعَسْجدِ",11,"د",1,0],["فسفح خِلاط قاسيون وتركها","يقلد طوق العار جيد المقطم",12,"م",1,0],["فُسفَّة صنع السيف والنار وانبرى","ومنه لتعميم السلام بشيرُ",13,"ر",1,0],["فسفه أحلام المشائخ منهم","وآذوه لما عاب دينهم الألوى",14,"و",2,0],["فسفحيْ جماحٍ فالفُليجِ فما حَوَتْ","حَويةُ عزٍ من ربى وشقائقِِ",15,"ق",1,0],["فَسَفينةُ الإِصلاحِ فيها صلّاحَنا","وَحَياتُنا لَو صادَفَت رُبانا",16,"ن",2,0],["فسفكُ الدما والتيه والصُّد والجفا","ونقضُ عُهود العاشقينَ مَذاهبه",17,"ب",2,0],["فَسفكتَهُ متعطِّشًا","ورأيتَهُ الماءَ الزُّلالْ",18,"ل",1,0],["فَسَفَحْتُ بِها أَدْمُعِي هُتُناً","وَقَضَيْتُ مِنَ الحَقِّ ما يَجِبُ",19,"ب",1,0]]}