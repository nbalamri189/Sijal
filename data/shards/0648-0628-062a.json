ادي ذكر ليلى ومن لها","https://www.aldiwan.net/poem14324.html","الطويل"],[441,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[458,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[458,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[458,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[458,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[458,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[458,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[458,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[458,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[461,"صحا القلب من حب الرجاء وغودرت","https://www.aldiwan.net/poem15476.html","الطويل"],[464,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[464,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[464,"ومخطف القد معسول مقبله","https://www.aldiwan.net/poem3322.html","عموديه"],[464,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[464,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[470,"ألا يا عبل قد طال اشتياقي","https://www.aldiwan.net/poem4774.html","الوافر"],[477,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[479,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[500,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[500,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[510,"وبتنا جميعاً وبات الغيور","https://www.aldiwan.net/poem1576.html",""],[514,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[514,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[551,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[551,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[553,"وبتنا على رغم الحسود وبيننا","https://www.aldiwan.net/poem68320.html","الطويل"],[558,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[558,"ولعت بذاك الحي والمورد الحلو","https://www.aldiwan.net/poem33533.html","الطويل"],[558,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"لي قصر عالي نصبتو من خشب كالبرج","https://www.aldiwan.net/poem34685.html","المواليا"],[558,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[567,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[575,"حذار سيوف الهند من أعين الترك","https://www.aldiwan.net/poem2903.html","الطويل"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[575,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[575,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[575,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[575,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[586,"صدقتم قده يحكي القضيبا","https://www.aldiwan.net/poem17428.html","الوافر"],[586,"زار وجنح الظلام منسدل","https://www.aldiwan.net/poem17541.html","المنسرح"],[586,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["وَبِتنَ عَلى المَطالِعِ مُلجَماتٍ","عَلائِقُها أَنابيبُ القُنينا",0,"ن",2,0],["وَبِتنا بِجَمعٍ وَالمَطيُّ مُوَقَّفٌ","نُؤَمِّلُ أَن نَلقى مِنىً وَحِصابَها",1,"ب",3,0],["وَبِتُّ وَباتَ مُنتَزَعَينِ مِمّا","يُطيلُ هَوى سُعادَ بِهِ الحَنينا",2,"ن",2,0],["وَبِتُّ لَقىً مِن عَتبِهِ وَمُدامِهِ","وَريقَتِهِ وَاللَيلُ ضافٍ لِباسُهُ",3,"س",2,0],["وبِتْنا نُكَفْكِفُ صَوْبَ الغَمامِ","بفَضْلِ الوِشاحِ تُحَيْتَ الغَضى",4,"ا",1,0],["وبتُّ أحْبُو إلَيها وهْيَ خائِفَةٌ","كما حَبا في حَواشي الرّمْلِ ثُعْبانُ",5,"ن",1,0],["وبِتْنا برَوْضٍ يَنْثُرُ الطَّلُّ زَهْرَهُ","عَلينا ويُرخي منْ ذَوائِبِهِ الرَّنْدُ",6,"د",1,0],["وَبِتُّ كَأَنّي بِالثُرَيّا مُعَلَّقٌ","أُناشِدُ مَن يَدري وَيَعلَمُ ما أُخفي",7,"ي",1,0],["وبِتْنا كما شاءَ الهَوى عقِبَ النّوى","على رَغْمِ أنْفٍ منْ عدُوٍّ وحاسِدِ",8,"د",1,0],["وبِتْ بِها في مَسْقَطٍ للنّدَى","في بُرْدَةٍ أو مَقْطَعٍ بَرْجي",9,"ج",2,0],["وَبِتُّ يَرتاحُ سَمعي حينَ يَفتُقُهُ","صَوتُ النَوادِبِ لا صَوتُ الأَغاريدِ",10,"د",1,0],["وَبِتنا نَحِنُّ لِتِلكَ القُصورِ","وَأَهلِ القُصورِ وَزُوّارِها",11,"ر",3,0],["وَبِتُّ خِلواً مِنَ الآمالِ وَاِتَّصَلَت","بَيني وَبَينَ العُلى مِن بابِهِ نَسَبُ",12,"ب",1,0],["وبتُّ أُسقّي وردة الخد أدمعي","فأصبح فيها نرجسُ اللحظ ذاويا",13,"ي",2,0],["وبتلك قلب الجهل مصدوع كما","ثوب الهموم بهذه مطرور",14,"ر",1,0],["وبتّ طريد النوم أختلس الكرى","بشاخص طرفٍ في الدجى يرقب الشهبا",15,"ب",2,0],["وَبِتُّم تَعَشَّونَ الخَزيرَ كَأَنَّكُم","مُطَلَّقَةٌ حيناً وَحيناً تُراجَعُ",16,"ع",1,0],["وَبِتُّ مُؤَرِّقاً مِن غَيرِ سُقمٍ","حَمى جَفنَيكَ طيبَ النَومِ حامِ",17,"م",1,0],["وَبِتُّ يَظُنُّ الناسُ فِيَّ ظُنونَهُم","وَثَوبِيَ مِمّا يَرجُمُ الناسُ طاهِرُ",18,"ر",1,0],["وَبِتنا كَغُصنَي بانَةٍ عابَثَتهُما","إِلى الصُبحِ ريحا شَمأَلٍ وَجَنوبِ",19,"ب",1,0],["وبتُّ أجلو على الندمانِ رونقها","حتَّى لقد أصبحوا من قبلِ ما باتوا",20,"ت",3,0],["وبتُّ لا أشتكِي حالاً إذا شكيت","في بابِ غيرك أحوال وحالات",20,"ت",1,0],["وبتُّ وبين شخصينا عَفافٌ","سِخابُ عِناقِها دون السِّخابِ",21,"ب",1,0],["وبِتُّ مراقباً نجمَ الثريّا","مراقبةَ المُخالِسِ للرقيبِ",22,"ب",1,0],["وبتسديدك استفدتُ سدادي","ولَحَسبي بأن أكون سديدَكْ",23,"ك",1,0],["وبتدبيره عصى ابْنُ سجستا","نَ ومن قبلِه أخو تَنِّيس",24,"س",1,0],["وَبِتنا كَأَنّا ضَيفُ جِنٍّ بِليلَةٍ","يَعودُ بِها القَلبَ السَقيمَ طَبائِبُه",25,"ب",2,0],["وَبِتُّ وَإِيّاكِ في مَعزِلٍ","كَأَنّي وَإِيّاكِ في مَجلِسِ",26,"س",1,0],["وَبِتُّ وَالقَومُ كُلَّما اِجتَمَعوا","رَمَيتُهُم بِالبُذورِ فَاِفتَرَقوا",27,"ق",3,0],["وَبِتُّمُ اللَيلَ في أَمنٍ وَفي دَعَةٍ","وَلَيسَ عِندَكُمُ عِلمٌ بِمَن سَهِرَه",28,"ر",2,0],["وَبِتنا كَما نَهوى حَبيبَينِ بَينَنا","عِتابٌ كَما اِنحَلَّ الجُمانُ المُنَضَّدُ",29,"د",1,0],["وَبِتُّ عَن خَبَري لاتَسَل","بِذاكَ الَّذي وَبِتِلكَ الَّتي",30,"ت",2,0],["وبت أصون في الحب اعتقادي","ورأى لا تغيره أصيل",31,"ل",1,0],["وَبِتنا نُقَبِّلُ أَسيافَنا","وَنَمسَحُها مِن دِماءِ العِدا",32,"ا",1,0],["وَبِتْنَ بحصْنِ الرّانِ رَزْحَى منَ الوَجى","وَكُلُّ عَزيزٍ للأمِيرِ ذَلِيلُ",33,"ل",1,0],["وبِتْنَا على رغمِ الحسود تضُمُّنَا","جميعاً حواشي بُردِها ورِدائيا",34,"ي",2,0],["وَبِتُّ أَهابُ المِسكَ مِنهُ وَأَتَّقي","رُداعِ عَبيرٍ صائِكٍ وَخَلوقِ",35,"ق",1,0],["وَبِتُّ أُراعيهِم مَتى يَنشُرونَني","وَقَد وَطَّنتُ نَفسي عَلى القَتلِ وَالأَسرِ",36,"ر",1,0],["وَبِتُّ أُغري بِها أَخا صَلَفٍ","قَد نَشَّفَتهُ الدُروسُ وَالكُتُبُ",37,"ب",1,0],["وَبِتُّ في طيبِ عَيشٍ رَقَّ جانِبُهُ","مُرَفَّهَ البالِ لا أَخشى بِهِ نَصَبا",38,"ب",2,0],["وَبِتنا نُوَفّي الحاشِرِيَةَ حَقَّها","وَنُثبِتُ مِن بَعدِ الغَبوقِ لَها نَصبا",39,"ب",2,0],["وَبِتنا نُوَفّي العَيشَ بِاللَهوِ حَقَّهُ","وَنَسرَحُ في رَوضٍ مِنَ الأُنسِ أَعشَبا",40,"ب",2,0],["وَبِتُّ أُخفي أَنيني وَالحَنينَ بِكُم","تَوَهُّماً أَنَّ ذاكَ الجُرحَ يَندَمِلُ",41,"ل",1,0],["وبتُّ قرير عينٍ للتداني","كما قدْ كنتُ أسهرُ للصدودِ",42,"د",1,0],["وَبِتُّ لِذاكَ مُكتَئباً","أُقاسي الهَمَّ وَالسَهَرا",43,"ر",2,0],["وَبِتُّ أُناجي النَفسَ أَينَ خِباؤُها","وَكَيفَ لِما آتي مِنَ الأَمرِ مَصدَرُ",44,"ر",1,0],["وَبِتُّ وَعِندِيَ لِلصَباحِ مُلاءَةٌ","تَروقُ وَجَيبٌ لِلظَلامِ يُمَزَّقُ",45,"ق",1,0],["وَبِتُّ وَسِرّي راكِبٌ ظَهرَ مَدمَعٍ","طَليقٍ إِذا ما أَنجَدَ الرَكبُ أَتهَما",46,"م",2,0],["وَبِتنا خَليطَي ضَمَّةٍ وَاِعتِناقَةٍ","كَما خالَطَت ماءَ الغَمامِ مُدامُ",47,"م",1,0],["وَبِتَّ خِلافَ القَومِ تَغسِلُ ثَوبَها","بِكَفَّيكَ مِن مُستَكرَهِ الصائِكِ الوَردِ",48,"د",1,0],["وَبِتنا بِأَكُفِّ الخَو","فِ نَج