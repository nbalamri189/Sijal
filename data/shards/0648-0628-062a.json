{"poems":[[53,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[53,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[63,"أقول لصاحبي والوجد يمري","https://www.aldiwan.net/poem45705.html","الوافر"],[63,"دعاني إلى الصهباء والليل عاقد","https://www.aldiwan.net/poem45843.html","الطويل"],[63,"هي العيس مبتذرات الخطا","https://www.aldiwan.net/poem46132.html","المتقارب"],[63,"تلك الحدوج يراعيهن غيران","https://www.aldiwan.net/poem46159.html","البسيط"],[63,"طربن إلى نجد وأنى لها نجد","https://www.aldiwan.net/poem46175.html","الطويل"],[55,"سرى طيف فوز آخر الليل بالطف","https://www.aldiwan.net/poem26241.html","الطويل"],[77,"نعمنا بوصل من حبيب مساعد","https://www.aldiwan.net/poem36532.html","الطويل"],[77,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[86,"ردا كؤوسكما عن شبه مفؤود","https://www.aldiwan.net/poem10500.html","البسيط"],[86,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[88,"كم قد لبست بها الضحا من روضة","https://www.aldiwan.net/poem44440.html","الكامل"],[88,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[27,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[47,"يعز على الأحبة بالشآم","https://www.aldiwan.net/poem25139.html","الوافر"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[47,"لبسنا رداء الليل والليل راضع","https://www.aldiwan.net/poem25364.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[29,"عفا واسط من أهله فمذانبه","https://www.aldiwan.net/poem6050.html","الطويل"],[91,"أحب معانقة النرجس لعينيك يا ابنة كولمبس","https://www.aldiwan.net/poem8967.html","عموديه"],[91,"أمست ثيابي وكلها خرق","https://www.aldiwan.net/poem8984.html","عموديه"],[70,"لم يقض زيدكم من وصلكم وطره","https://www.aldiwan.net/poem42926.html","البسيط"],[70,"عفا الله عنكم أين ذاك التودد","https://www.aldiwan.net/poem42937.html","الطويل"],[70,"مقيم على العهد من صبوتي","https://www.aldiwan.net/poem42995.html","المتقارب"],[85,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[43,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[62,"ألا أيها الركب اليمانون ما لكم","https://www.aldiwan.net/poem52244.html","الطويل"],[45,"بعينيك إعوالي وطول شهيقي","https://www.aldiwan.net/poem65197.html","الطويل"],[58,"وقيت بنفسي خير من وطئ الحصى","https://www.aldiwan.net/poem31064.html","الطويل"],[66,"وقهوة يجتلى السرور بها","https://www.aldiwan.net/poem39195.html","المنسرح"],[66,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[66,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[66,"أدرها بلطف واجعل الرفق مذهبا","https://www.aldiwan.net/poem39207.html","الطويل"],[66,"في مثل حبكم لا يحسن العذل","https://www.aldiwan.net/poem39928.html","البسيط"],[69,"أما وقطاف رمان النهود","https://www.aldiwan.net/poem29006.html","الوافر"],[31,"طربت ورد من تهوى","https://www.aldiwan.net/poem42505.html","مجزوء الوافر"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[74,"تحلت به من كوكب لبة الدجى","https://www.aldiwan.net/poem13192.html","الطويل"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[74,"وألزمته حكم الهوى فالتقى به","https://www.aldiwan.net/poem13247.html","الطويل"],[39,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[52,"أللمنزل بالحنو","https://www.aldiwan.net/poem26584.html","الهزج"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[50,"راحت رواحا بين كناد","https://www.aldiwan.net/poem63898.html","السريع"],[50,"خف لبين ساكن الأعداد","https://www.aldiwan.net/poem63900.html","الرجز"],[50,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem63925.html","الطويل"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[50,"طال انتظاري عهد أباء","https://www.aldiwan.net/poem64889.html","السريع"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141020",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30466","المتقارب"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30506","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30467","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9918","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55188","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54792","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[50,"غدا سلفٌ فأصْعَدَ «بالرَّبَابِ»","https://www.poetsgate.com/ViewPoem.aspx?id=17144",""],[18,"أَهَاجَ قَذَاءَ عَيْنِي الإِذِّكَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=22981",""],[58,"وقيت بنفسي خير من وطئ الحصى","https://www.poetsgate.com/ViewPoem.aspx?id=10866",""],[90,"هجرت الديار","https://www.poetsgate.com/ViewPoem.aspx?id=178969",""],[90,"منى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=178934",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[29,"عفا واسطٌ من أهْله فمذانُبْهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17431&r=&rc=4",""],[31,"طربتَ، وردّ من تهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18895&r=&rc=158",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""]],"verses":[["وَبِتنَ عَلى المَطالِعِ مُلجَماتٍ","عَلائِقُها أَنابيبُ القُنينا",0,"ن",2,0],["وَبِتنا بِجَمعٍ وَالمَطيُّ مُوَقَّفٌ","نُؤَمِّلُ أَن نَلقى مِنىً وَحِصابَها",1,"ب",3,0],["وَبِتُّ وَباتَ مُنتَزَعَينِ مِمّا","يُطيلُ هَوى سُعادَ بِهِ الحَنينا",2,"ن",2,0],["وَبِتُّ لَقىً مِن عَتبِهِ وَمُدامِهِ","وَريقَتِهِ وَاللَيلُ ضافٍ لِباسُهُ",3,"س",2,0],["وبِتْنا نُكَفْكِفُ صَوْبَ الغَمامِ","بفَضْلِ الوِشاحِ تُحَيْتَ الغَضى",4,"ا",1,0],["وبتُّ أحْبُو إلَيها وهْيَ خائِفَةٌ","كما حَبا في حَواشي الرّمْلِ ثُعْبانُ",5,"ن",1,0],["وبِتْنا برَوْضٍ يَنْثُرُ الطَّلُّ زَهْرَهُ","عَلينا ويُرخي منْ ذَوائِبِهِ الرَّنْدُ",6,"د",1,0],["وَبِتُّ كَأَنّي بِالثُرَيّا مُعَلَّقٌ","أُناشِدُ مَن يَدري وَيَعلَمُ ما أُخفي",7,"ي",1,0],["وبِتْنا كما شاءَ الهَوى عقِبَ النّوى","على رَغْمِ أنْفٍ منْ عدُوٍّ وحاسِدِ",8,"د",1,0],["وبِتْ بِها في مَسْقَطٍ للنّدَى","في بُرْدَةٍ أو مَقْطَعٍ بَرْجي",9,"ج",2,0],["وَبِتُّ يَرتاحُ سَمعي حينَ يَفتُقُهُ","صَوتُ النَوادِبِ لا صَوتُ الأَغاريدِ",10,"د",1,0],["وَبِتنا نَحِنُّ لِتِلكَ القُصورِ","وَأَهلِ القُصورِ وَزُوّارِها",11,"ر",3,0],["وَبِتُّ خِلواً مِنَ الآمالِ وَاِتَّصَلَت","بَيني وَبَينَ العُلى مِن بابِهِ نَسَبُ",12,"ب",1,0],["وبتُّ أُسقّي وردة الخد أدمعي","فأصبح فيها نرجسُ اللحظ ذاويا",13,"ي",2,0],["وبتلك قلب الجهل مصدوع كما","ثوب الهموم بهذه مطرور",14,"ر",1,0],["وبتّ طريد النوم أختلس الكرى","بشاخص طرفٍ في الدجى يرقب الشهبا",15,"ب",2,0],["وَبِتُّم تَعَشَّونَ الخَزيرَ كَأَنَّكُم","مُطَلَّقَةٌ حيناً وَحيناً تُراجَعُ",16,"ع",1,0],["وَبِتُّ مُؤَرِّقاً مِن غَيرِ سُقمٍ","حَمى جَفنَيكَ طيبَ النَومِ حامِ",17,"م",1,0],["وَبِتُّ يَظُنُّ الناسُ فِيَّ ظُنونَهُم","وَثَوبِيَ مِمّا يَرجُمُ الناسُ طاهِرُ",18,"ر",1,0],["وَبِتنا كَغُصنَي بانَةٍ عابَثَتهُما","إِلى الصُبحِ ريحا شَمأَلٍ وَجَنوبِ",19,"ب",1,0],["وبتُّ أجلو على الندمانِ رونقها","حتَّى لقد أصبحوا من قبلِ ما باتوا",20,"ت",3,0],["وبتُّ لا أشتكِي حالاً إذا شكيت","في بابِ غيرك أحوال وحالات",20,"ت",1,0],["وبتُّ وبين شخصينا عَفافٌ","سِخابُ عِناقِها دون السِّخابِ",21,"ب",1,0],["وبِتُّ مراقباً نجمَ الثريّا","مراقبةَ المُخالِسِ للرقيبِ",22,"ب",1,0],["وبتسديدك استفدتُ سدادي","ولَحَسبي بأن أكون سديدَكْ",23,"ك",1,0],["وبتدبيره عصى ابْنُ سجستا","نَ ومن قبلِه أخو تَنِّيس",24,"س",1,0],["وَبِتنا كَأَنّا ضَيفُ جِنٍّ بِليلَةٍ","يَعودُ بِها القَلبَ السَقيمَ طَبائِبُه",25,"ب",2,0],["وَبِتُّ وَإِيّاكِ في مَعزِلٍ","كَأَنّي وَإِيّاكِ في مَجلِسِ",26,"س",1,0],["وَبِتُّ وَالقَومُ كُلَّما اِجتَمَعوا","رَمَيتُهُم بِالبُذورِ فَاِفتَرَقوا",27,"ق",3,0],["وَبِتُّمُ اللَيلَ في أَمنٍ وَفي دَعَةٍ","وَلَيسَ عِندَكُمُ عِلمٌ بِمَن سَهِرَه",28,"ر",2,0],["وَبِتنا كَما نَهوى حَبيبَينِ بَينَنا","عِتابٌ كَما اِنحَلَّ الجُمانُ المُنَضَّدُ",29,"د",1,0],["وَبِتُّ عَن خَبَري لاتَسَل","بِذاكَ الَّذي وَبِتِلكَ الَّتي",30,"ت",2,0],["وبت أصون في الحب اعتقادي","ورأى لا تغيره أصيل",31,"ل",1,0],["وَبِتنا نُقَبِّلُ أَسيافَنا","وَنَمسَحُها مِن دِماءِ العِدا",32,"ا",1,0],["وَبِتْنَ بحصْنِ الرّانِ رَزْحَى منَ الوَجى","وَكُلُّ عَزيزٍ للأمِيرِ ذَلِيلُ",33,"ل",1,0],["وبِتْنَا على رغمِ الحسود تضُمُّنَا","جميعاً حواشي بُردِها ورِدائيا",34,"ي",2,0],["وَبِتُّ أَهابُ المِسكَ مِنهُ وَأَتَّقي","رُداعِ عَبيرٍ صائِكٍ وَخَلوقِ",35,"ق",1,0],["وَبِتُّ أُراعيهِم مَتى يَنشُرونَني","وَقَد وَطَّنتُ نَفسي عَلى القَتلِ وَالأَسرِ",36,"ر",1,0],["وَبِتُّ أُغري بِها أَخا صَلَفٍ","قَد نَشَّفَتهُ الدُروسُ وَالكُتُبُ",37,"ب",1,0],["وَبِتُّ في طيبِ عَيشٍ رَقَّ جانِبُهُ","مُرَفَّهَ البالِ لا أَخشى بِهِ نَصَبا",38,"ب",2,0],["وَبِتنا نُوَفّي الحاشِرِيَةَ حَقَّها","وَنُثبِتُ مِن بَعدِ الغَبوقِ لَها نَصبا",39,"ب",2,0],["وَبِتنا نُوَفّي العَيشَ بِاللَهوِ حَقَّهُ","وَنَسرَحُ في رَوضٍ مِنَ الأُنسِ أَعشَبا",40,"ب",2,0],["وَبِتُّ أُخفي أَنيني وَالحَنينَ بِكُم","تَوَهُّماً أَنَّ ذاكَ الجُرحَ يَندَمِلُ",41,"ل",1,0],["وبتُّ قرير عينٍ للتداني","كما قدْ كنتُ أسهرُ للصدودِ",42,"د",1,0],["وَبِتُّ لِذاكَ مُكتَئباً","أُقاسي الهَمَّ وَالسَهَرا",43,"ر",2,0],["وَبِتُّ أُناجي النَفسَ أَينَ خِباؤُها","وَكَيفَ لِما آتي مِنَ الأَمرِ مَصدَرُ",44,"ر",1,0],["وَبِتُّ وَعِندِيَ لِلصَباحِ مُلاءَةٌ","تَروقُ وَجَيبٌ لِلظَلامِ يُمَزَّقُ",45,"ق",1,0],["وَبِتُّ وَسِرّي راكِبٌ ظَهرَ مَدمَعٍ","طَليقٍ إِذا ما أَنجَدَ الرَكبُ أَتهَما",46,"م",2,0],["وَبِتنا خَليطَي ضَمَّةٍ وَاِعتِناقَةٍ","كَما خالَطَت ماءَ الغَمامِ مُدامُ",47,"م",1,0],["وَبِتَّ خِلافَ القَومِ تَغسِلُ ثَوبَها","بِكَفَّيكَ مِن مُستَكرَهِ الصائِكِ الوَردِ",48,"د",1,0],["وَبِتنا بِأَكُفِّ الخَو","فِ نَجني ثَمَرَ اللَهوِ",49,"و",1,0],["وَبِتَّ تَرْقَى إلَى أنْ نِلْتَ مَنْزِلَةً","مِنْ قَابِ قَوْسَيْنِ لَمْ تُدْرَكْ وَلَمْ تُرَمِ",50,"م",1,0],["وَبِتُّ مُشتاقاً إِلى وَجهِها","أَلقى عَلَيهِ غُلَّةَ الصادي",51,"ي",1,0],["وَبِتُّ مَحجوباً عَنِ الوُفّادِ","وَكَيفَ يُغفي قَلِقُ الوِسادِ",52,"د",1,0],["وَبِتُّ كَأَنّي بِالنُجومِ مُعَلَّقٌ","أُسائِلُ وُسطاها عَنِ الكَوكَبِ الفَردِ",53,"د",1,0],["وَبِتُّ بِحاجَةٍ في الصَدرِ مِنها","تَحَرَّقُ نارُها بَينَ الحِجابِ",54,"ب",1,0],["وَبِتُّ كَالنَشوانِ مِن حاجَةٍ","ضاقَت بِها نَفسي وأَحشائى",55,"ا",2,0],["وبتنا نقبّل أسيافنا","ونمسحها من دماء العدى",56,"ا",1,0],["وبِتُّ بمُسْتَنّ اليَرابيعِ راقِداً","يُطَوِّفْنَ حوْلي مِن فُرادى ومن شَفْع",57,"ع",1,0],["وبِتُّ به لَيْلتي ناعِماً","إِلى أَنْ تَبَسَّمَ ثَغْرُ الغلَسْ",58,"س",1,0],["وبِتُّ فَرْداً أُناجِي مُقْلَتِي شَغَفاً","كأَنَّني في نُقُوبِ الدارِ جِنِّيُّ",59,"ي",1,0],["وبِتْنَا نُرَاعِي اللَّيْلَ لم يَطْوِ برْدَهُ","ولَم يَجْرِ شَيْبُ الصُّبْحِ في فَرعِهِ وخْطَا",60,"ط",2,0],["وَبِتُّ بِطَيفٍ مِنكِ يا عَبلَ قانِعاً","وَلَو باتَ يَسري في الظَلامِ عَلى خَدّي",61,"ي",1,0],["وَبِتَهْذِيبِك الرجال إِلَى قَوْ","مِكَ أَهْدَيْتَ نُخبةً فِي الرِّجالِ",62,"ل",1,0],["وَبِتُّ إِذا تَذَكَّرَهُمْ فُؤادِي","رَأَيْتُ خَوَاطِرِي تَجْرِي دُمُوعَا",63,"ع",2,0],["وَبِتَ أَباً وَمَا خِلْنَاكَ تَرْضَى","بِغَيرِ وَلاَئِدِ الأَفْكَارِ وُلْدَا",64,"د",2,0],["وَبِتَّ لِمِصْرٍ بِالمَفَاخِرِ مَحْتِداً","وَمِنْ قَبْلُ كَانتْ لِلمَفاخِرِ مَعتدا",65,"د",2,0],["وبِتُّ بحاجة ٍ في الصَّدْر منْه","تَحَرَّقُ نارُها بيْن الْحجاب",66,"ب",1,0],["وَبِتُّ أُرَاقِبُ الْجَوْزَاءَ حَتَّى","تقاربَ منْ أوائلها انحدارُ",67,"ر",1,0],["وَبِتُّ أُراعِيْهِم مَتَى ينشرُونَني","وَقَدْ قَرَّرَتْ نَفْسي عَلَى القَتْلِ والأسْر",68,"ر",1,0],["وبتُّ بليل لفرط الأسى","كَلَيل الضجيع على ناره",69,"ر",2,0],["وبتنا كما شاءت اخوة جنسنا","خليلين أصفى من عقيل ومالك",70,"ك",1,0],["وبتلكُمُ الخَلَواتِ تُمْسَخُ عندَها","تُلْعُ الرِّقابِ من الظّباءِ ثعالبا!!",71,"ب",2,0],["وبِتُّ عكوفاً على غُمَّتي","حريصاً على المنظر المُكْرِب!",72,"ب",1,0],["وبتنا كأنّا ضيفُ جنّ بليلة ٍ","يعودُ بها القَلْبَ السّقيمَ صبائِبُهْ",73,"ب",2,0],["وَبِتُّ لِذاكَ مُكْتَئِباً","أُقَاسي الهَمَّ وَکلسَّهَرا",74,"ر",2,0],["وبتلك قلب الجهل مصدوع كما","ثوب الهموم بهذه مطرود",75,"ر",3,0]]}