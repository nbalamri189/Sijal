ي","https://www.aldiwan.net/poem12386.html","البسيط"],[445,"أذاب فؤادي ذكر ليلى ومن لها","https://www.aldiwan.net/poem14324.html","الطويل"],[445,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[461,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[461,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[461,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[461,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[461,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[461,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[461,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[461,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[464,"صحا القلب من حب الرجاء وغودرت","https://www.aldiwan.net/poem15476.html","الطويل"],[467,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[467,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[467,"ومخطف القد معسول مقبله","https://www.aldiwan.net/poem3322.html","عموديه"],[467,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[467,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[473,"ألا يا عبل قد طال اشتياقي","https://www.aldiwan.net/poem4774.html","الوافر"],[480,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[482,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[503,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[503,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[513,"وبتنا جميعاً وبات الغيور","https://www.aldiwan.net/poem1576.html",""],[517,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[517,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[517,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[554,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[554,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[554,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[556,"وبتنا على رغم الحسود وبيننا","https://www.aldiwan.net/poem68320.html","الطويل"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[561,"ولعت بذاك الحي والمورد الحلو","https://www.aldiwan.net/poem33533.html","الطويل"],[561,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"لي قصر عالي نصبتو من خشب كالبرج","https://www.aldiwan.net/poem34685.html","المواليا"],[561,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[570,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[578,"حذار سيوف الهند من أعين الترك","https://www.aldiwan.net/poem2903.html","الطويل"],[578,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[578,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[578,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[578,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[578,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[589,"صدقتم قده يحكي القضيبا","https://www.aldiwan.net/poem17428.html","الوافر"],[589,"زار وجنح الظلام منسدل","https://www.aldiwan.net/poem17541.html","المنسرح"],[589,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216891","المتقارب"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67418","الطويل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10451","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[1027,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"]],"verses":[["وَبِتنَ عَلى المَطالِعِ مُلجَماتٍ","عَلائِقُها أَنابيبُ القُنينا",0,"ن",2,0],["وَبِتنا بِجَمعٍ وَالمَطيُّ مُوَقَّفٌ","نُؤَمِّلُ أَن نَلقى مِنىً وَحِصابَها",1,"ب",3,0],["وَبِتُّ وَباتَ مُنتَزَعَينِ مِمّا","يُطيلُ هَوى سُعادَ بِهِ الحَنينا",2,"ن",2,0],["وَبِتُّ لَقىً مِن عَتبِهِ وَمُدامِهِ","وَريقَتِهِ وَاللَيلُ ضافٍ لِباسُهُ",3,"س",2,0],["وبِتْنا نُكَفْكِفُ صَوْبَ الغَمامِ","بفَضْلِ الوِشاحِ تُحَيْتَ الغَضى",4,"ا",1,0],["وبتُّ أحْبُو إلَيها وهْيَ خائِفَةٌ","كما حَبا في حَواشي الرّمْلِ ثُعْبانُ",5,"ن",1,0],["وبِتْنا برَوْضٍ يَنْثُرُ الطَّلُّ زَهْرَهُ","عَلينا ويُرخي منْ ذَوائِبِهِ الرَّنْدُ",6,"د",1,0],["وَبِتُّ كَأَنّي بِالثُرَيّا مُعَلَّقٌ","أُناشِدُ مَن يَدري وَيَعلَمُ ما أُخفي",7,"ف",2,0],["وبِتْنا كما شاءَ الهَوى عقِبَ النّوى","على رَغْمِ أنْفٍ منْ عدُوٍّ وحاسِدِ",8,"د",1,0],["وبِتْ بِها في مَسْقَطٍ للنّدَى","في بُرْدَةٍ أو مَقْطَعٍ بَرْجي",9,"ج",2,0],["وَبِتُّ يَرتاحُ سَمعي حينَ يَفتُقُهُ","صَوتُ النَوادِبِ لا صَوتُ الأَغاريدِ",10,"د",1,0],["وَبِتنا نَحِنُّ لِتِلكَ القُصورِ","وَأَهلِ القُصورِ وَزُوّارِها",11,"ر",3,0],["وَبِتُّ خِلواً مِنَ الآمالِ وَاِتَّصَلَت","بَيني وَبَينَ العُلى مِن بابِهِ نَسَبُ",12,"ب",1,0],["وبتُّ أُسقّي وردة الخد أدمعي","فأصبح فيها نرجسُ اللحظ ذاويا",13,"ي",2,0],["وبتلك قلب الجهل مصدوع كما","ثوب الهموم بهذه مطرور",14,"ر",1,0],["وبتّ طريد النوم أختلس الكرى","بشاخص طرفٍ في الدجى يرقب الشهبا",15,"ب",2,0],["وَبِتُّم تَعَشَّونَ الخَزيرَ كَأَنَّكُم","مُطَلَّقَةٌ حيناً وَحيناً تُراجَعُ",16,"ع",1,0],["وَبِتُّ مُؤَرِّقاً مِن غَيرِ سُقمٍ","حَمى جَفنَيكَ طيبَ النَومِ حامِ",17,"م",1,0],["وَبِتُّ يَظُنُّ الناسُ فِيَّ ظُنونَهُم","وَثَوبِيَ مِمّا يَرجُمُ الناسُ طاهِرُ",18,"ر",1,0],["وَبِتنا كَغُصنَي بانَةٍ عابَثَتهُما","إِلى الصُبحِ ريحا شَمأَلٍ وَجَنوبِ",19,"ب",1,0],["وبتُّ أجلو على الندمانِ رونقها","حتَّى لقد أصبحوا من قبلِ ما باتوا",20,"ت",3,0],["وبتُّ لا أشتكِي حالاً إذا شكيت","في بابِ غيرك أحوال وحالات",20,"ت",1,0],["وبتُّ وبين شخصينا عَفافٌ","سِخابُ عِناقِها دون السِّخابِ",21,"ب",1,0],["وبِتُّ مراقباً نجمَ الثريّا","مراقبةَ المُخالِسِ للرقيبِ",22,"ب",1,0],["وبتسديدك استفدتُ سدادي","ولَحَسبي بأن أكون سديدَكْ",23,"ك",1,0],["وبتدبيره عصى ابْنُ سجستا","نَ ومن قبلِه أخو تَنِّيس",24,"س",1,0],["وَبِتنا كَأَنّا ضَيفُ جِنٍّ بِليلَةٍ","يَعودُ بِها القَلبَ السَقيمَ طَبائِبُه",25,"ب",2,0],["وَبِتُّ وَإِيّاكِ في مَعزِلٍ","كَأَنّي وَإِيّاكِ في مَجلِسِ",26,"س",1,0],["وَبِتُّ وَالقَومُ كُلَّما اِجتَمَعوا","رَمَيتُهُم بِالبُذورِ فَاِفتَرَقوا",27,"ق",3,0],["وَبِتُّمُ اللَيلَ في أَمنٍ وَفي دَعَةٍ","وَلَيسَ عِندَكُمُ عِلمٌ بِمَن سَهِرَه",28,"ر",2,0],["وَبِتنا كَما نَهوى حَبيبَينِ بَينَنا","عِتابٌ كَما اِنحَلَّ الجُمانُ المُنَضَّدُ",29,"د",1,0],["وَبِتُّ عَن خَبَري لاتَسَل","بِذاكَ الَّذي وَبِتِلكَ الَّتي",30,"ت",2,0],["وبت أصون في الحب اعتقادي","ورأى لا تغيره أصيل",31,"ل",1,0],["وَبِتنا نُقَبِّلُ أَسيافَنا","وَنَمسَحُها مِن دِماءِ العِدا",32,"ا",1,0],["وَبِتْنَ بحصْنِ الرّانِ رَزْحَى منَ الوَجى","وَكُلُّ عَزيزٍ للأمِيرِ ذَلِيلُ",33,"ل",1,0],["وبِتْنَا على رغمِ الحسود تضُمُّنَا","جميعاً حواشي بُردِها ورِدائيا",34,"ي",2,0],["وَبِتُّ أَهابُ المِسكَ مِنهُ وَأَتَّقي","رُداعِ عَبيرٍ صائِكٍ وَخَلوقِ",35,"ق",1,0],["وَبِتُّ أُراعيهِم مَتى يَنشُرونَني","وَقَد وَطَّنتُ نَفسي عَلى القَتلِ وَالأَسرِ",36,"ر",1,0],["وَبِتُّ أُغري بِها أَخا صَلَفٍ","قَد نَشَّفَتهُ الدُروسُ وَالكُتُبُ",37,"ب",1,0],["وَبِتُّ في طيبِ عَيشٍ رَقَّ جانِبُهُ","مُرَفَّهَ البالِ لا أَخشى بِهِ نَصَبا",38,"ب",2,0],["وَبِتنا نُوَفّي الحاشِرِيَةَ حَقَّها","وَنُثبِتُ مِن بَعدِ الغَبوقِ لَها نَصبا",39,"ب",2,0],["وَبِتنا نُوَفّي العَيشَ بِاللَهوِ حَقَّهُ","وَنَسرَحُ في رَوضٍ مِنَ الأُنسِ أَعشَبا",40,"ب",2,0],["وَبِتُّ أُخفي أَنيني وَالحَنينَ بِكُم","تَوَهُّماً أَنَّ ذاكَ الجُرحَ يَندَمِلُ",41,"ل",1,0],["وَبِتُّ أُراقِبُ الجَوزاءَ حَتّى","تَقارَبَ مِن أَوائِلِها اِنحِدارُ",42,"ر",1,0],["وبتُّ قرير عينٍ للتداني","كما قدْ كنتُ أسهرُ للصدودِ",43,"د",1,0],["وَبِتُّ لِذاكَ مُكتَئباً","أُقاسي الهَمَّ وَالسَهَرا",44,"ر",2,0],["وَبِتُّ أُناجي النَفسَ أَينَ خِباؤُها","وَكَيفَ لِما آتي مِنَ الأَمرِ مَصدَرُ",45,"ر",1,0],["وَبِتُّ وَعِندِيَ لِلصَباحِ مُلاءَةٌ","تَروقُ وَجَيبٌ لِلظَلامِ يُمَزَّقُ",46,"ق",1,0],["وَبِتُّ وَسِرّي راكِبٌ ظَهرَ مَدمَعٍ","طَليقٍ إِذا ما أَنجَدَ الرَكبُ أَتهَما",47,"م",2,0],["وَبِتنا خَليطَي ضَمَّةٍ وَاِعتِناقَةٍ","كَما خالَطَت ماءَ الغَمامِ مُدامُ",48,"م",1,0],["وَبِتَّ خِلافَ القَومِ تَغسِلُ ثَوبَها","بِكَفَّيكَ مِن مُستَكرَهِ الصائِكِ الوَردِ",49,"د",1,0],["وَبِتنا بِأَكُفِّ الخَو","فِ نَجني ثَمَرَ اللَهوِ",50,"و",1,0],["وَبِتَّ تَرْقَى إلَى أنْ نِلْتَ مَنْزِلَةً","مِنْ قَابِ قَوْسَيْنِ لَمْ تُدْرَكْ وَلَمْ تُرَمِ",51,"م",1,0],["وَبِتُّ مُشتاقاً إِلى وَجهِها","أَلقى عَلَيهِ غُلَّةَ الصادي",52,"د",2,0],["وَبِتُّ مَحجوباً عَنِ الوُفّادِ","وَكَيفَ يُغفي قَلِقُ الوِسادِ",53,"د",1,0],["وَبِتُّ كَأَنّي بِالنُجومِ مُعَلَّقٌ","أُسائِلُ وُسطاها عَنِ الكَوكَبِ الفَردِ",54,"د",1,0],["وَبِتُّ بِحاجَةٍ في الصَدرِ مِنها","تَحَرَّقُ نارُها بَينَ الحِجابِ",55,"ب",1,0],["وَبِتُّ كَالنَشوانِ مِن حاجَةٍ","ضاقَت بِها نَفسي وأَحشائى",56,"ا",2,0],["وبتنا نقبّل أسيافنا","ونمسحها من دماء العدى",57,"ا",1,0],["وبِتُّ بمُسْتَنّ اليَرابيعِ راقِداً","يُطَوِّفْنَ حوْلي مِن فُرادى ومن شَفْع",58,"ع",1,0],["وبِتُّ به لَيْلتي ناعِماً","إِلى أَنْ تَبَسَّمَ ثَغْرُ الغلَسْ",59,"س",1,0],["وبِتُّ فَرْداً أُناجِي مُقْلَتِي شَغَفاً","كأَنَّني في نُقُوبِ الدارِ جِنِّيُّ",60,"ي",1,0],["وبِتْنَا نُرَاعِي اللَّيْلَ لم يَطْوِ برْدَهُ","ولَم يَجْرِ شَيْبُ الصُّبْحِ في فَرعِهِ وخْطَا",61,"ط",2,0],["وَبِتُّ بِطَيفٍ مِنكِ يا عَبلَ قانِعاً","وَلَو باتَ يَسري في الظَلامِ عَلى خَدّي",62,"د",2,0],["وَبِتَهْذِيبِك الرجال إِلَى قَوْ","مِكَ أَهْدَيْتَ نُخبةً فِي الرِّجالِ",63,"ل",1,0],["وَبِتُّ إِذا تَذَكَّرَهُمْ فُؤادِي","رَأَيْتُ خَوَاطِرِي تَجْرِي دُمُوعَا",64,"ع",2,0],["وَبِتَ أَباً وَمَا خِلْنَاكَ تَرْضَى","بِغَيرِ وَلاَئِدِ الأَفْكَارِ وُلْدَا",65,"د",2,0],["وَبِتَّ لِمِصْرٍ بِالمَفَاخِرِ مَحْتِداً","وَمِنْ قَبْلُ كَانتْ لِلمَفاخِرِ مَعتدا",66,"د",2,0],["وبتلك يمتلك الرقاب مليكها","وبتلك يقتاد الصعاب همامها",67,"م",3,0],["وبِتُّ بحاجة ٍ في الصَّدْر منْه","تَحَرَّقُ نارُها بيْن الْحجاب",68,"ب",1,0],["وَبِتُّ أُراعِيْهِم مَتَى ينشرُونَني","وَقَدْ قَرَّرَتْ نَفْسي عَلَى القَتْلِ والأسْر",69,"ر",1,0],["وبتُّ بليل لفرط الأسى","كَلَيل الضجيع على ناره",70,"ر",2,0],["وبتنا كما شاءت اخوة جنسنا","خليلين أصفى من عقيل ومالك",71,"ك",1,0],["وبتلكُمُ الخَلَواتِ تُمْسَخُ عندَها","تُلْعُ الرِّقابِ من الظّباءِ ثعالبا!!",72,"ب",2,0],["وبِتُّ عكوفاً على غُمَّتي","حريصاً على المنظر المُكْرِب!",73,"ب",1,0],["وبتنا كأنّا ضيفُ جنّ بليلة ٍ","يعودُ بها القَلْبَ السّقيمَ صبائِبُهْ",74,"ب",2,0],["وَبِتُّ لِذاكَ مُكْتَئِباً","أُقَاسي الهَمَّ وَکلسَّهَرا",75,"ر",2,0],["وبتلك قلب الجهل مصدوع كما","ثوب الهموم بهذه مطرود",76,"ر",3,0],["وَبت أَظن الجلنار بِدَوحِهِ","نُجوم عَقيق في سَماءِ زَبَرجَد",77,"د",1,0],["وَبِتنا وافياء الغُصون سَماؤُنا","فَنَحنُ بِدور وَالنَدامى كَواكِبُ",78,"ب",1,0],["وَبِتنا لَنا سَكرانٍ مِن خَمر ريقِهِ","وَذات وِشاح لِلنُهى فَهِيَ أَشراك",79,"ك",1,0],["وبتلك الذوائب السود إذ تل","وون أطرافها فتلوى الرجالا",80,"ل",2,0],["وبتُّ غير معَاهِدٍ لها حُصرت","ذكر المَعَاهِدِ عندي حُسنُه حُصرا",81,"ر",2,0],["وبتُّ غير الذي من حُسنها نَظَرَتْ","نفسي فلا غيرَها نفسي له نَظَرا",81,"ر",2,0],["وبتُّ وأحشائي تُقَطَّعُ بالهوى","ومن حُرَقِ الأشواق باتت صَوادِيا",82,"ي",2,0],["وبت وقلبي من لظاها بجنة","وجنَّةُ ذِكراها تُذَكِّرُ ناسيا",82,"ي",2,0],["وَبتَّت مِن مُمِرَّاتِ التَّصَابي","حِبَالكَ وأنتأت عنكَ إنتِئَاءَ",83,"ا",2,0],["وبتشتري في القولِ وتبيعْ","يا ما أنت شاطرْ في التأليس",84,"س",1,0],["وَبِتَّ من شَهَواتِ النَّفسِ في شُغُلٍ","تُفنِي زمانَكَ في لهو وتفترق",85,"ق",1,0],["وَبِتنا نُعاطي الراحَ بَعدَ اِكتِفائِنا","عَلى مُحزَئِلّاتٍ وِثارٍ أَثائِثِ",86,"ث",1,0],["وَبِتُّ عَزائي السِجنُ في مُدلَهِمَّةٍ","يُجاوِبُني فِيها ثِقالُ الأداهِمِ",87,"م",1,0],["وَبِتنَا فُوَيقَ الحَىِّ لا نَحَن مِنهُمُ","وَلا نَحنُ بِالأعدَاءِ مُختَلِطانِ",88,"ن",1,1],["وبتّ مبيتَ الطفل دون حلومة","بفيه معافى من منازلة الفكر",89,"ر",1,0],["وبت أكتم أمري خوف حادثة","فنمّ حرفي بمكتومي إلى المطر",90,"ر",1,0],["وبتّ أرعد والأثواب 