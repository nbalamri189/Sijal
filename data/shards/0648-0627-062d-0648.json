ديه"],[469,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[469,"وأحور ساج لم أكن قبل حبه","https://www.aldiwan.net/poem3355.html","عموديه"],[500,"وأحور ساجي الطرف أغرى بي الضنى","https://www.aldiwan.net/poem10263.html","الطويل"],[520,"قبولاً وإن بان عجز الخواطر","https://www.aldiwan.net/poem12122.html","الطويل"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[558,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[567,"كثير العمر في الدنيا قليل","https://www.aldiwan.net/poem52877.html","الكامل"],[572,"كتبت وعندنا ورد وراح","https://www.aldiwan.net/poem69747.html","الوافر"],[592,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104092","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86989","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86729","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130151","الطويل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138818",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59575","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119873","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120094","الرمل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216853","الهزج"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96628","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64887","المتقارب"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118167","الوافر"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118113","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49957","الطويل"],[1883,"","https://poetry.dctabudhabi.ae/diwan/poem/98015","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89549","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53127","المتقارب"],[2512,"","https://poetry.dctabudhabi.ae/diwan/poem/203820","المتقارب"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116510","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93386","الطويل"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199452","المتقارب"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32747","المتقارب"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77720","الطويل"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77709","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216758","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36795","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202338","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34602","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114557","الوافر"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111188","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54331","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73211","البسيط"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144247","الوافر"],[4912,"وأحوى حوى رقي برقة لفظه","https://www.poetsgate.com/ViewPoem.aspx?id=181784",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[5145,"تولّى الظلم وإنجاب الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=108226",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5582,"قِفا بِمُقامٍ لِلأَحِبَّةِ ماصِحِ","https://www.poetsgate.com/ViewPoem.aspx?id=63481",""],[5790,"من أطلع البدر في داج من الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=112058",""],[572,"أعاذ الله شكواكَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9403&r=&rc=260",""],[572,"كتبتُ وعِندَنَا ماءٌ وراحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9210&r=&rc=67",""]],"verses":[["وَأَحوكُ أَفوافَ القَريضِ فَلا أَرى","أَنّي أُدَنِّسُ بِاللِئامِ بُرودي",0,"د",2,0],["وَأَحوَرَ مَعشوقِ الدَّلالِ مُهَفهَفٍ","يُديرُ إِلى العُشَّاقِ مُقلَةَ ريمِ",1,"م",1,1],["وَأَحْوَلَ يُعْدِي القَلْبَ سُقْمُ جفُونِهِ","فَتُضْحِي صَحِيحَاتُ القُلُوبِ بِهِ مَرْضَى",2,"ض",2,1],["وَأَحوَرُ ساجي الطَرفِ حَشوُ جُفونِهِ","سَقامٌ بَرى الأَجسامَ مِنهُ سَقامُ",3,"م",1,0],["وَأَحوى لا يُعابُ وَذا غُروبٍ","عَلَيهِ شُنبَةٌ أضلمى صَقيلا",4,"ل",2,0],["وَأَحوى كَأَيمِ الضالِ أَطرَقَ بَعدَما","حَبا تَحتَ فَينانٍ مِنَ الظِلِّ وارِفِ",5,"ف",1,0],["وَأَحواضٌ يُراضُ النيلُ فيها","وَكُلُّ نَجيبَةٍ وَلَها لِجامُ",6,"م",1,0],["وَأَحوالُ خَلقٍ غابِرٍ مُتَجَدِّدٍ","تَشابَهَ فيها أَوَّلٌ وَأَخيرُ",7,"ر",1,0],["وأحورَ بارزتْنِي مقلتَاه","بسيفٍ لا يُرَدُّ عن القلوبِ",8,"ب",1,1],["وَأَحوَجَني بِالجَورِ عَن سُنَنِ الوَفا","فَأَخرَجَني بِالجَورِ عَن سُنَنِ العَدلِ",9,"ل",1,0],["وَأَحوَرَ ذِمِّيٍّ طَرَقتُ فِنائَهُ","بِفِتيانِ صِدقٍ ما تَرى مِنهُمُ نُكرا",10,"ر",2,1],["وَأَحوَرِ المُقلَتَينِ مُكتَحِلٍ","في فِتيَةٍ سادَةٍ نَحاريرِ",11,"ر",1,0],["وَأَحوَرَ مَخلوعِ الزِمامِ تَخالُهُ","قَضيباً مِنَ الريحانِ يَهتَزُّ أَخضَرا",12,"ر",2,0],["وَأَحوَرَ لا تُجاوِزُهُ الأَماني","حَلَبتُ لِوُدِّهِ ماءَ المَآقي",13,"ق",2,0],["وَأَحوَرَ مَحسودٍ عَلى حُسنِ وَجهِهِ","يَزينُ السُموطَ نَحرُهُ وَتَرائِبُه",14,"ب",2,0],["وَأَحولُ مِن شَرَفِ العَشيرَةِ مُبسِقٌ","قَوماً وَأُمسِكُ عَن هُمامِ الغابِ",15,"ب",1,0],["وأَحَورِ العَينِ مَربُوبٍ لَه غُسَنٌ","مُقَلَّدٌ من جَنَاحِ الدُّرِّ تِقصارا",16,"ر",2,0],["وأحول يعدي القلب سقمى جفونه","فتضحى صحيحات الجسوم به مرضى",17,"ض",2,1],["وَأَحوَرُ العَينِ مَربوبٍ لَهُ غُسَنٌ","مُقَلَّدٍ مِن نَظامِ الدُرِّ تَقصارا",18,"ر",2,0],["وَأَحوك نَظماً بِالثَناء كَأَنَّما","أَلفاظُهُ قَطع مِن الفُولاذ",19,"ذ",1,0],["واحوال مباركة وعزم","ينوب عن الاحبة والرفيق",20,"ق",1,0],["وأحواله العظمى تسامت برونق","جلالته دلت على قدرة الرب",21,"ب",1,0],["وَأحوَى في المَلاحَةِ ذِي افتِتَانِ","عَنِيتُ بِهٍ فَصَدَّ وَمَا عَنَاني",22,"ن",2,1],["وأحوَرَ فَتَّاناً أعَدَّ بِسِحرِهِ","خَطَاطِيفَ للأَلبَابِ تَجدِ بها حِجنَا",23,"ن",2,0],["وَأحوَى شَادِناً رَشاً رَبِيباً","يُزِلُّ رَخِيمُ نَعمتِهِ الوُعُولا",24,"ل",2,0],["وأحورَهَا الغَضِيضَ الطرف الأَحوَى","وسهمَ لِحاظِ أجوِرِهَا المَضَاءَ",25,"ا",2,0],["وأحوك كلّ قصيدة","عذراء تكبر عن شبيهه",26,"ي",3,0],["وأحوالُ الزمانِ رخاً وضيقٌ","فذ ابابٌ يعد ولا يسدُّ",27,"د",1,0],["وأحوالُهم في فَرْط عُسْرٍ وضيقةٍ","وليس لهم إلا نَداك مُريح",28,"ح",1,0],["وأَحورَ يُغْنِى البابليين لحظُه","ويُهدى إلى الأغصانِ لينَ المَعاطف",29,"ف",1,0],["وأحوزُ مِن إكرامهِ التَكريما","صلّوا عليهِ وسلّموا تسليما",30,"م",2,0],["وأَحْوى رَمى عَنْ قِسِّيِّ الحَوَرْ","سِهاماً يُفَوِّقُهُنَّ النظرْ",31,"ر",1,1],["وأحورَ صبَّحتُه في المساءِ","وإني لمن دَهَشٍ مُرعَشُ",32,"ش",1,1],["وأحوى حَوَى قلبي فَحَاولت وَصْلَه","فَحال القَضَا حتى انقضى عمرُ من يَهوى",33,"و",2,0],["وَأَحوى لَحظُهُ يَنفُ","ثُ في الأَلبابِ بِالسِّحرِ",34,"ر",1,0],["وأحور أحوى فاتن الطرفِ كم غدا","به قلبُ صبٍّ بالجوى يتضرم",35,"م",1,1],["وأحوال من يأتي وأحوال من مضى","وأنباء ترغيب وانباء رهبة",36,"ه",1,0],["وأحوال أرباب الرسالة والذي","به أيدوا من معجزات جليلة",36,"ه",1,0],["وأحوال من رد الهدى فتعجلت","له قبل يوم الحشر بعض العقوبة",36,"ه",1,0],["وأحوالك اكتب كل يوم بيومه","بها قتل اعداء وانفاذ غرقان",37,"ن",1,0],["وَأَحوى قَد حَوى مُهجَ البَرايا","كَما اِحتَوَت الضُلوعُ عَلى الحِوايا",38,"ا",3,1],["وأحورَ ما يعفي العيونَ من العشقِ","له كذبٌ في الجدّ أحلى من الصدقِ",39,"ق",1,1],["وَأحورُ صاغَهُ الرَحمَن درّاً","سِوى الشفة الَّتي هِيَ بهرمانُ",40,"ن",1,0],["وَأَحور أَمّا لَحظه فَهوَ صارِمٌ","صَحيحٌ وَأَمّا طَرفه فَكَسيرُ",41,"ر",1,0],["وَأحوى حوى مِن كُلّ ما يَبعَث الجَوى","وَيَعبث بِالمُشتاق مِنهُ أمورُ",41,"ر",1,0],["وأحوِي منه للكُبَراء ودّاً","تَقطَّعُ للحسودِ به الحَوايا",42,"ا",3,0],["وأحور المقلتينِ أَحوى","كأنَّه البدرُ مُستديرا",43,"ر",2,1],["وَأَحواضُ عِزٍّ حَومَةُ المَوتِ دونَها","وَأَحواضُ عُرفٍ لَيسَ عَنهُنَّ ذائِدُ",44,"د",1,0],["وأحورٍ مهما رَنا ناظراً","أعلَّ الجوارحَ أو أمرَضا",45,"ض",2,0],["وأحورَ أحوى ساحر الطرف أغيدِ","رقيق حواشي الدِلّ أو هي تجلدي",46,"د",2,1],["وأحور سهماهُ لي مصميانِ","فسيَّان عندي رمى أو نظر",47,"ر",1,0],["وأحورَ في عينيهِ هاروتُ بابلٍ","رمى فاتقينا نبلهُ بالمقاتلِ",48,"ل",1,1],["وأحورَ ساجٍ لم أكن قبل حبّهِ","لأعرف ما وجدٌ بأحور ساجِ",49,"ج",1,1],["وأحور ساجي الطرف أغرى بي الضنى","وقصر نومي في ليال أطالها",50,"ه",2,1],["وأحوال قوم زعزعت فرددتها","فكنت لكسر القوم أكرم جابر",51,"ر",1,0],["وأحواضُهم مورودةٌ فعدوّهم","يُحَلّا وأصحابُ الولايةِ تَرْشُفُ",52,"ف",1,0],["وَأَحوَرَ وَسنانَ ذي غُنَّةٍ","كَأَنَّ بِوَجنَتِهِ الجُلَّنارا",53,"ر",2,0],["وأحوالُ الفتى في الدَّهرِ شَتَّى","ولكنْ أيُّ حالٍ لا تَحولُ",54,"ل",1,0],["وَأَحْوَرُ من ظِبَاءِ الرُّومِ ساقٍ","كَغُصْنِ الْبَانِ تَثْنِيْهِ الرِّيَاحُ",55,"ح",1,0],["وأحوالا وأهوالا عضالا","وأخباراً وأحداثاً عظاما",56,"م",2,0],["وأحورَ وَسنانِ الجفونِ كأنّه","قَضيبٌ من الرِّيحانِ لدنٌ مُنعّمُ",57,"م",1,0],["وَأَحوَجتَني أَني أَقول مُؤرخاً","رقى في وَقت وَصل بِلا حَق",58,"ق",1,0],["وَأَحوَجتَني أَني أَقول مُؤرِّخاً","رقى في شَهر لَهوٍ بِلا قَصد",59,"د",1,0],["وأحوى بدا من نور خديه مشرق","ولكن له في غابة الاسد مغرب",60,"ب",1,0],["وأحور معسول المراشف لو رنا","بمقلته رضوى لذاق كما ذقنا",61,"ن",2,0],["وأحور ساجي الطرف لم يدر ما الهوى","وَلوعٌ بتعذيب المحب وصده",62,"د",2,1],["وأحور من ظباء الشرق يزرى","بضوء الشمس في وقت الشروق",63,"ق",1,0],["واحو مع عسر شعيب","عمر أصحاب الرقيمِ",64,"م",1,0],["وأحْوى سَلِسُ المرْس","نِ مثلُ الصَّدع الشّعْبِ",65,"ب",1,1],["وَأحوى غثاء فاحَ عبء سمائه","بِنشرٍ حَكى نشرَ اللطيمةِ فائحِ",66,"ح",1,0],["وأَحْوي بِهِ ذَهَباً خالِصاً","تِشحُّ الأَكارمُ عن صَرْفِهِ",67,"ف",2,0],["وأحوى فاتر الأجفان ألمى","رشيقٍ قده رخص البنان",68,"ن",1,1],["وأحوى ثنى من قده اللدن ذابلاً","فأخجل غصن البان وهو نضير",69,"ر",1,1],["وأَحورُ مكحُولُ الجُفون غَضيضُها","وأَشَنبُ مَعسُول الرُّضاب برَودُهُ",70,"د",2,0],["وأحواض الخلافة مترعات","لها عرفٌ ومعروف كبير",71,"ر",1,0],["وَأحورَ مَهضومِ الوِشاحينِ زارَني","عَلى رَقبَةِ الواشينَ لَيلاً فَأَمتَعا",72,"ع",2,0],["وأحور أغيد في مقلتيه وعط","فيه يَسْطُو ببيض وسمر",73,"ر",1,0],["وأحور لو أن عرس العزيز","رأته لخرت له ساجده",74,"د",2,0],["واحواله في غير اوقات وحيه","واهوال يوم الدين والوعظ والذكر",75,"ر",1,0],["وَأَحورَ وَسنانِ الجُفونِ كَأَنَّما","بِهِ سَقَمٌ في لَحظِهِ غَيرُ موجِعِ",76,"ع",1,1],["وأحور حيا بنارنجةٍ","تضرم نصف اسمها في البدن",77,"ن",1,1],["وَأَحوَجَني دَهري إِلى مالِهِم فَلَم","يَجودوا بِشَيءٍ وَاِستَباحوا مَثالِبي",78,"ب",2,0],["وَأَحوَلُ بِسطام ظِلُّ المُشيرِ","وَكانَ يَحوكُ بِبُرزاطِيَه",79,"ي",2,0],["وأحورَ وَسْنانِ الجفونِ مرابطٍ","سبى حُسْنُهُ لبَّ اللبيب وصبرَهُ",80,"ه",1,1],["وأحورَ زانَ خديّه عِذارٌ","سبى الألبابَ منظرهُ العجابُ",81,"ب",1,1],["وأحوط حسنك بالتمائم والرُّقى","وتظل تنثر عقدها وتبدد",82,"د",1,0],["وَأَحوَرَ وَسنانَ الجُفون إِذا رَنا","أَدارَ كُؤوس الراحِ بِالحَدَقِ النُجلِ",83,"ل",1,0],["وأحور ما عللت قلبي بذكره","ليسلو إلا زاده في جنونه",84,"ن",2,0],["وأحورَ محسودٍ على حسنِ وجهِه","يزيد تماماً حين يبدو على البدرِ",85,"ر",1,1],["وأحوى الطرفِ أحورُ ذو دَلالٍ","تولَّعَ بالتجني وبالعكوسِ",86,"س",1,1],["واحوى من بني جشم أتاني","على حذر وجنح الليل داج",87,"ج",1,0],["وأَحور يسبي بطرفٍ يكل","وتخجلُ منه الظُّبا والظباءْ",88,"ا",2,1],["وأحورٍ فاتنٍ من ريش مقلتهِ","كَم جال بالناس فصّامٌ وهَبّارُ",89,"ر",1,0],["وأَحورٍ صادَني في لَحظهِ حَوَرٌ","والحُورُ تَقتنصُ الآسادَ بالحَورِ",90,"ر",1,0],["وأحوال القلوب عليك تجلى","معارفها فتأخذ كل بكر",91,"ر",1,0],["وأحوى حوى رقي برقة لفظه","وغادرني إلف السهاد بغدره",92,"ر",2,1],["وأحوالنا أحوى لنا إذ تغيَّرت","وأفعالنا أفعى لنا بالضَّرورة",93,"ه",1,0],["وأحوجنا إلى أرباب جهلٍ","إذا ما خاطبوا قلنا: سلام",94,"م",1,0],["وأحوالك اكتب كل يوم بيومه","بها قتل أعداء وإنقاذ غرقان",95,"ن",1,0],["وَأَحْوَى غُثاءٍ فاحَ غِبَّ سَمائِهِ","بِنَشْرٍ حَكَى نَشْرَ اللَّطِيمَةِ فائِحِ",96,"ح",1,0],["وأحور صادني من لحظه حورٌ","والحور قد تقنص الآساد بالحور",97,"ر",1,0],["وأحوزَنا من الدرّاجِ","ما الرّجْلُ بهِ ضَاقَا",98,"ق",2,0],["وأحورُ من ظِبَاءِ الرّومِ سَاقٍ","كغصنِ البانِ اثْنَتُهُ الرّياحُ",99,"ح",1,0]]}