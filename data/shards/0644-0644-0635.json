{"poems":[[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[95,"ألصيد لهو الملوك من قدم","https://www.aldiwan.net/poem11360.html","المنسرح"],[74,"للصاحب بن الصاحب الناصر من","https://www.aldiwan.net/poem18376.html","الرجز"],[74,"للصاحب العلمي الذكر نور ثنا","https://www.aldiwan.net/poem20035.html","البسيط"],[91,"أين القصيد التي أبياتها خزف","https://www.aldiwan.net/poem44782.html","البسيط"],[87,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[47,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[47,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[121,"ظامئ","https://www.aldiwan.net/poem24063.html","الرمل"],[160,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[164,"أهلا بما أنسى الذنوب المذنب","https://www.aldiwan.net/poem58813.html","الكامل"],[164,"للصبر في مهجتي والهم معترك","https://www.aldiwan.net/poem58994.html","البسيط"],[228,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[240,"قل لصديقي أبي علي","https://www.aldiwan.net/poem31802.html","مجزوء البسيط"],[287,"امدد إلي يدا يعتادها الكرم","https://www.aldiwan.net/poem32458.html","البسيط"],[353,"للصاحب الندب عز لا يبيد فقل","https://www.aldiwan.net/poem19845.html","البسيط"],[371,"يا شجاع بن شاور بن مجير","https://www.aldiwan.net/poem17210.html","الخفيف"],[396,"الزم البيت لا تخرج من البيت تندم","https://www.aldiwan.net/poem54507.html","عموديه"],[415,"مثوبة الفاقد عن فقده","https://www.aldiwan.net/poem31930.html","السريع"],[415,"لو استطعت ولو ملكت أمري في","https://www.aldiwan.net/poem32204.html","البسيط"],[435,"للصيد فضل لدى أهل العلى ظهرا","https://www.aldiwan.net/poem40507.html","البسيط"],[435,"للصيد أنشاها الشهابي","https://www.aldiwan.net/poem40728.html","مجزوء الكامل"],[435,"للصيد فضل في ثمان فوائد","https://www.aldiwan.net/poem40762.html","الكامل"],[469,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[484,"طلعت فينا هلالا","https://www.aldiwan.net/poem37051.html","المجتث"],[563,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138425",""],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138980",""],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104094","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86777","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77586","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71027","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120083","الكامل"],[1204,"","https://poetry.dctabudhabi.ae/diwan/poem/123658","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64723","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56641","المتدارك"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140220",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79815","الكامل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26650","الكامل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99061","الرجز"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20400","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96032","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27544","البسيط"],[2244,"","https://poetry.dctabudhabi.ae/diwan/poem/202676","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83226","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133946","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71397","الكامل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46852","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48328","الدوبيت"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128476","البسيط"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106758","الرمل"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139422",""],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36605","الدوبيت"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/46004","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90852","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[4578,"مصر الغرام فؤادي في هوى الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49405",""],[4869,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=151566",""],[4882,"سمّي العراقَ اذا ما اصْلحتْ ذِمما-بهاء الدين الخاق","https://www.poetsgate.com/ViewPoem.aspx?id=11522",""],[4918,"عيد وحداد","https://www.poetsgate.com/ViewPoem.aspx?id=34595",""],[4929,"العراق الحر","https://www.poetsgate.com/ViewPoem.aspx?id=207477",""],[5038,"في الحكمة / الصدق4","https://www.poetsgate.com/ViewPoem.aspx?id=190170",""],[5186,"الروح والريحانة الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=156506",""],[307,"أجملُ ما في الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=213656",""],[5365,"تراتيل في محراب الألم","https://www.poetsgate.com/ViewPoem.aspx?id=191272",""],[5376,"إياك نعبدُ ما في القلبِ الاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=188352",""],[5409,"قل للمجانين في الدنيا لكم طوبى","https://www.poetsgate.com/ViewPoem.aspx?id=155254",""],[5447,"ألف طريقة","https://www.poetsgate.com/ViewPoem.aspx?id=208337",""],[5459,"للصبر حد ..","https://www.poetsgate.com/ViewPoem.aspx?id=202617",""],[5770,"قم حي غزة","https://www.poetsgate.com/ViewPoem.aspx?id=178369",""],[5848,"البرتقاله","https://www.poetsgate.com/ViewPoem.aspx?id=53334",""],[5848,"للصمت لذة","https://www.poetsgate.com/ViewPoem.aspx?id=49001",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""],[6115,"للصمت سبع فوائد","https://www.poetsgate.com/ViewPoem.aspx?id=180497",""],[5309,"إصبر ففي الصبر اعجاز ومقدرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573679",""],[6198,"أجنحة الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79236&r=&rc=10",""]],"verses":[["لِلصُلبِ مِن غَسّانَ فَوقَ جَراثِمٍ","تَنبو خَوالِدُها عَنِ المِنقارِ",0,"ر",1,0],["لِلصَّيْدِ مَغْزَى جَدٍّ وَلَيْسَ سُدىً","مَا فِيهِ مَعْنَى الإِبَاءِ وَالشَّمَمِ",1,"م",1,0],["للصاحبِ بن الصاحبِ الناصر من","دعاه رأيٌ في الصلاةِ الراتِبة",2,"ه",1,1],["للصاحب العلميّ الذكر نور ثناً","أشهى وأشهر من نارٍ على علم",3,"م",1,1],["للصادقين عقاب في مواطنهم","كأنما الصدق ذنب",4,"ب",1,0],["لِلصالِحاتِ عَقائِلِ ال","وادي هَوىً في الصالِحاتِ",5,"ت",1,0],["لِلصامِتِيِّ مُحَمَّدٍ في صامِتٍ","نَسَبٌ كَعِقدِ الدُرِّ غِبَّ نِظامُهُ",6,"م",2,0],["لِلصَريحِ الصَريحِ وَالأَشرَفِ الأَشرَ","فِ إِن عُدَّ وَالصَميمِ الصَميمِ",7,"م",1,0],["لِلصَّدْقِ وَالصَّبْرِ الجَّمِيلِ نُجِلُّهُ","أَفَمَا يُجَلُّ الصَّابِرُ الصِّدِّيقُ",8,"ق",1,0],["للصمت أبلغُ منها وهو منسحقٌ","والدمع أفعل منها وهو منسجم",9,"م",1,0],["لِلصَّبايا وَطَنٌ بين دَمي","وإلَيْهِنَّ الهَوى صَلَّى وسَلَّم",10,"م",1,0],["لِلصَّيعَرِيَّةِ فَوقَ حاجِبِ عَينِها","أَثَرٌ يُبَيِّنُهُ وَلَمّا يَدرُسِ",11,"س",1,0],["للصومِ إِجلالٌ لديكَ وحرمةٌ","تكسوهُ أُبهةُ لديك ومَنصِبا",12,"ب",2,0],["للصبر في مهجتي والهم معترك","والظن فيك لديها مسرح يزك",13,"ك",1,1],["لِلصَعاليكِ لِلذين","خَدَّروا الأَسدَ في العَرين",14,"ن",1,0],["لِلصَبِّ مِن وَردِ وَجنَتَيها","وِردٌ وَمِن ثَغرِها رَحيقُ",15,"ق",1,0],["لِلصاحِبِ ابنِ عَلِيٍّ في العُلا هِمَمٌ","لَم يَدنُ مِن شَأوِها عُربٌ وَلا عَجَمُ",16,"م",1,0],["لِلصَّاحِبِ النَّدْبِ عِزٌ لا يَبيدُ فَقُلْ","عِزٌّ يَدومُ وإقْبالٌ لِصَاحبهِ",17,"ب",2,1],["لِلصُدورِ الصُدورُ في كُلِّ حَفلٍ","فيهِ أَهلُ الصُدورِ غَيرُ صُدورِ",18,"ر",1,0],["للصله والزياره أو تكن باتعلم","منهم العلم فاطلبه وكن كأنك أعجم",19,"م",1,0],["للصّابرينَ الأجرُ والأمنُ مِن","عَذابِهِ والفوزُ في خُلْدِهِ",20,"د",2,0],["للصّالِحِ الملِكِ الميمونِ طائرُهُ","بِجِيدِهِ طوقُ مَنٍّ غيرُ منفَصِمِ",21,"م",1,0],["للصيد فضلٌ لدى أهل العلى ظهرا","ونزهةٌ تذهب الأتراح والكدرا",22,"ر",2,1],["للصيد أنشاها الشها","بي البشير أبو الفخار",23,"ر",1,1],["للصيد فضل في ثمان فوائدٍ","من بعدها عشر تشيد أساسه",24,"س",2,1],["للصمّ من هاماتهم وسيوفهِ","ما شئت من ساقٍ هناك ومسمع",25,"ع",1,0],["للصالح اسما أبيكم","منا الهناء المشارك",26,"ك",1,0],["للصب في خفض الجناح جناح","لجمالكم في كل قلب ساحة",27,"ه",1,0],["للصادق الشهم المبجل قدره","اهدي الثناء واوفر الشكران",28,"ن",1,0],["للصب بعدك حالة لا تعجب","وتتيه من صلف عليه وتعجب",29,"ب",1,1],["للصَّبا منّةٌ على الرّوض هادت","هُ بطيبِ الحبيبِ أي ذمامِ",30,"م",1,1],["لِلصادق البشري ببهجة عيدِ","في طالع زاهٍ عَلَيهِ سَعيدِ",31,"د",1,1],["لِلصُّمِّ نادى طامِعا أَن يُسمعا","وَأَيُّ شَخص يُسمع الصُمَّ الدُعا",32,"ع",2,0],["للصدقاء صادق نصيحُ","لا يُظهر السرَّ ولا يبوحُ",33,"ح",1,0],["للصاحب الملك الجلي","ل بكل مكرمة خليق",34,"ق",1,0],["للصبّ أسوةُ خالٍ خدّك إنه","متنعّمٌ في جَمره المتوقّد",35,"د",1,0],["للصَّلاحِ بنِ العَزيزِ بْ","نِ الغِياثِ بْنِ الصَّلاحِ",36,"ح",1,0],["للصبح سناؤك أبيضه","لليل غرامي أسوده",37,"د",2,0],["للصبر عاقبة تحلو مذاقتها","لا سكر مثلها يحلو ولا عسل",38,"ل",1,0],["للصالحات كلها مفارق","فخذ بيمناه إلى هداه",39,"ه",1,0],["للصنع ما أبقى التحمّل","موضعاً فدع الصنيعه",40,"ع",2,0],["للصيد قبلك سنة مأثورة","لكنها بك أعجب الأشياء",41,"ا",2,1],["للصخر عند وقعه التهاب","إذا تدانى فهو الحِباب",42,"ب",1,0],["لِلصَدرِ مِنهُ عَويلٌ فيهِ حَشرَجَةٌ","كَأَنَّما هِيَ في أَحشاءِ مَصدورِ",43,"ر",1,0],["للصائمين نهارهم لم يبرحوا","للقائمين بليلهم ان اعتما",44,"م",2,0],["للصور والروح والأرزاق أجمعها","والوعد ثم وعيد سيفه مسلول",45,"ل",1,0],["للصالحين إلى الصلاح طريق","رحبت بهم وعدت عليك تضيق",46,"ق",1,1],["لِلصَفوِ فيهِ وَلِلسُرورِ وَلِلرَجا","سوقٌ بِأَنحاءِ البِلادِ تُقامُ",47,"م",1,0],["للصوم بالصون عند الله تفضيل","كما لا جماله في الفضل تفضيلُ",48,"ل",1,1],["للصبا في ذلك الوشي البديع","خطرات بين غصن وفنن",49,"ن",1,0],["لِلصَّبِّ أُسْوَةُ خَالِ خَدِّكَ إِنَّهُ","مُتَمَتِّعُ فِي جَمْرِهِ المُتَوَقِّدِ",50,"د",1,0],["لِلصّالِحاتِ نَصيرهُ وَمَسيره","يَسْتَنْفدُ الإهْذَابَ والإهبَاذا",51,"ذ",2,0],["للصبح بين الراضي والغضبان","غالطته في الغلَطَهْ لما انكبسْ",52,"س",1,0],["للصّبْرِ حُسامٌ كلّما أُنضيهِ","يفُلُّ الهَوى ما عزْمُهُ يُمْضيهِ",53,"ه",1,0],["للصادق الباي نجل المصطفى بن علي","باشا احتفالات باشا راقيا شأنا",54,"ن",2,1],["للصَّبَا مِنِّي مَحَلِّ","في غُدُوٍّ ورواح",55,"ح",1,0],["للصدق والكذب وعكس الموجبة","جزئية موجبة لا سالبة",56,"ه",1,0],["للصالحات أخاً جعلتَ وللتقى","وأباً رؤوفاً للفقيرِ القانع",57,"ع",1,0],["لِلصُحبَةِ لَو نقلت نَحوي قَدَماً","أَدنى الخدم اِصطَنَعت كالخلخالِ",58,"ل",1,0],["لِلصَّيفِ جَديران خَريفٌ بِزيرَةٍ","شِتاءٌ بِقَلبٍ وَالرَبيعُ بِماخيهِ",59,"ه",1,0],["للصعب حلال إذا","ما الأمر يوما اشكلا",60,"ل",2,0],["للصبا من عِذاره نسجُ حُسْنٍ","رقمَ المسْكُ في الشقائقِ طرزَهْ",61,"ر",3,0],["للصفح والسماح والغفران","والبر والرحمة والرضوان",62,"ن",1,0],["للصَديق نخلَي النفس خضَاعه","ما نوريه الجفا والتمطَاعي",63,"ع",2,0],["للصبر حلت وفي قلبي بما عقدت","من بند خصرٍ به قد حل معقودي",64,"د",2,0],["للصمت معنى وانت ياجاهل الصمت","ماتفضحك ياكود عينك مع الصوت",65,"ت",1,0],["للصبر عند عراق الحزن راحلة","كالشهب شقت فضاء العتم منهزما",66,"م",2,0],["للصاحب اللي ما خذا الشوق بيده","لاهي.. وأنا فكري معه وين ما راد",67,"د",1,0],["للصبرِ حدٌّ وإن ضاق الإطارُ به","صار الجنونُ له أمًّا وصار أبَا",68,"ب",2,0],["لِلصِّدْقِ في وَجْهِ الْجَليسِ نَضارَهْ","تُغْنيكَ عَنْ أَلْفٍ وَأَلْفِ إِشارَهْ",69,"ه",1,1],["للصدر دونهم مخالب ما رعت","فيه الحنو، بواشق وحداء",70,"ا",2,0],["للصبحِ ينتظرُ التقاةُ تشوّقاً","مثلَ العشيقِ يحاورُ الأجراما",71,"م",2,0],["للصّبرِ للطّهرِ يزهو فوق قافيتي","تَعُبُّ منهُ نسيمَ الحبّ راحاتي",72,"ت",2,0],["للصوم فضلٌ قيامُ الليلِ يسعفُنا","وفضلُ صومكَ ربي ما أضعناه",73,"ا",2,0],["للصدق تعرف بين الناس قيمته","إذا رأيت بغيض الصدق محبوبا",74,"ب",2,0],["للصمت ألفُ طريقةٍ حتى يقولَ مرادَه..","أما الكلامُ فواحدة!",75,"ه",1,1],["للصبر حدٌّ فأط