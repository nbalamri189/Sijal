{"poems":[[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[93,"ألصيد لهو الملوك من قدم","https://www.aldiwan.net/poem11360.html","المنسرح"],[72,"للصاحب بن الصاحب الناصر من","https://www.aldiwan.net/poem18376.html","الرجز"],[72,"للصاحب العلمي الذكر نور ثنا","https://www.aldiwan.net/poem20035.html","البسيط"],[89,"أين القصيد التي أبياتها خزف","https://www.aldiwan.net/poem44782.html","البسيط"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[45,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[117,"ظامئ","https://www.aldiwan.net/poem24063.html","الرمل"],[156,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[160,"أهلا بما أنسى الذنوب المذنب","https://www.aldiwan.net/poem58813.html","الكامل"],[160,"للصبر في مهجتي والهم معترك","https://www.aldiwan.net/poem58994.html","البسيط"],[223,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[235,"قل لصديقي أبي علي","https://www.aldiwan.net/poem31802.html","مجزوء البسيط"],[282,"امدد إلي يدا يعتادها الكرم","https://www.aldiwan.net/poem32458.html","البسيط"],[348,"للصاحب الندب عز لا يبيد فقل","https://www.aldiwan.net/poem19845.html","البسيط"],[366,"يا شجاع بن شاور بن مجير","https://www.aldiwan.net/poem17210.html","الخفيف"],[391,"الزم البيت لا تخرج من البيت تندم","https://www.aldiwan.net/poem54507.html","عموديه"],[409,"مثوبة الفاقد عن فقده","https://www.aldiwan.net/poem31930.html","السريع"],[409,"لو استطعت ولو ملكت أمري في","https://www.aldiwan.net/poem32204.html","البسيط"],[429,"للصيد فضل لدى أهل العلى ظهرا","https://www.aldiwan.net/poem40507.html","البسيط"],[429,"للصيد أنشاها الشهابي","https://www.aldiwan.net/poem40728.html","مجزوء الكامل"],[429,"للصيد فضل في ثمان فوائد","https://www.aldiwan.net/poem40762.html","الكامل"],[464,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[479,"طلعت فينا هلالا","https://www.aldiwan.net/poem37051.html","المجتث"],[558,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"]],"verses":[["لِلصُلبِ مِن غَسّانَ فَوقَ جَراثِمٍ","تَنبو خَوالِدُها عَنِ المِنقارِ",0,"ر",1,0],["لِلصَّيْدِ مَغْزَى جَدٍّ وَلَيْسَ سُدىً","مَا فِيهِ مَعْنَى الإِبَاءِ وَالشَّمَمِ",1,"م",1,0],["للصاحبِ بن الصاحبِ الناصر من","دعاه رأيٌ في الصلاةِ الراتِبة",2,"ه",1,1],["للصاحب العلميّ الذكر نور ثناً","أشهى وأشهر من نارٍ على علم",3,"م",1,1],["للصادقين عقاب في مواطنهم","كأنما الصدق ذنب",4,"ب",1,0],["لِلصالِحاتِ عَقائِلِ ال","وادي هَوىً في الصالِحاتِ",5,"ت",1,0],["لِلصامِتِيِّ مُحَمَّدٍ في صامِتٍ","نَسَبٌ كَعِقدِ الدُرِّ غِبَّ نِظامُهُ",6,"م",2,0],["لِلصَريحِ الصَريحِ وَالأَشرَفِ الأَشرَ","فِ إِن عُدَّ وَالصَميمِ الصَميمِ",7,"م",1,0],["لِلصَّدْقِ وَالصَّبْرِ الجَّمِيلِ نُجِلُّهُ","أَفَمَا يُجَلُّ الصَّابِرُ الصِّدِّيقُ",8,"ق",1,0],["للصمت أبلغُ منها وهو منسحقٌ","والدمع أفعل منها وهو منسجم",9,"م",1,0],["لِلصَّبايا وَطَنٌ بين دَمي","وإلَيْهِنَّ الهَوى صَلَّى وسَلَّم",10,"م",1,0],["لِلصَّيعَرِيَّةِ فَوقَ حاجِبِ عَينِها","أَثَرٌ يُبَيِّنُهُ وَلَمّا يَدرُسِ",11,"س",1,0],["للصومِ إِجلالٌ لديكَ وحرمةٌ","تكسوهُ أُبهةُ لديك ومَنصِبا",12,"ب",2,0],["للصبر في مهجتي والهم معترك","والظن فيك لديها مسرح يزك",13,"ك",1,1],["لِلصَعاليكِ لِلذين","خَدَّروا الأَسدَ في العَرين",14,"ن",1,0],["لِلصَبِّ مِن وَردِ وَجنَتَيها","وِردٌ وَمِن ثَغرِها رَحيقُ",15,"ق",1,0],["لِلصاحِبِ ابنِ عَلِيٍّ في العُلا هِمَمٌ","لَم يَدنُ مِن شَأوِها عُربٌ وَلا عَجَمُ",16,"م",1,0],["لِلصَّاحِبِ النَّدْبِ عِزٌ لا يَبيدُ فَقُلْ","عِزٌّ يَدومُ وإقْبالٌ لِصَاحبهِ",17,"ب",2,1],["لِلصُدورِ الصُدورُ في كُلِّ حَفلٍ","فيهِ أَهلُ الصُدورِ غَيرُ صُدورِ",18,"ر",1,0],["للصله والزياره أو تكن باتعلم","منهم العلم فاطلبه وكن كأنك أعجم",19,"م",1,0],["للصّابرينَ الأجرُ والأمنُ مِن","عَذابِهِ والفوزُ في خُلْدِهِ",20,"د",2,0],["للصّالِحِ الملِكِ الميمونِ طائرُهُ","بِجِيدِهِ طوقُ مَنٍّ غيرُ منفَصِمِ",21,"م",1,0],["للصيد فضلٌ لدى أهل العلى ظهرا","ونزهةٌ تذهب الأتراح والكدرا",22,"ر",2,1],["للصيد أنشاها الشها","بي البشير أبو الفخار",23,"ر",1,1],["للصيد فضل في ثمان فوائدٍ","من بعدها عشر تشيد أساسه",24,"س",2,1],["للصمّ من هاماتهم وسيوفهِ","ما شئت من ساقٍ هناك ومسمع",25,"ع",1,0],["للصالح اسما أبيكم","منا الهناء المشارك",26,"ك",1,0],["للصب في خفض الجناح جناح","لجمالكم في كل قلب ساحة",27,"ه",1,0]]}