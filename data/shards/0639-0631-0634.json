{"poems":[[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[85,"هذي العوالم لفظ أنت معناه","https://www.aldiwan.net/poem54231.html","البسيط"],[90,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[90,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[87,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[107,"عرش القياصر والقضاء إذا جرى","https://www.aldiwan.net/poem43116.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39557","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[108,"ظل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179710",""],[108,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[108,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[98,"مهرجان الزفاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66369&r=&rc=45",""],[203,"عرش بطول مدار السبعة الشهب","https://www.aldiwan.net/poem45349.html","البسيط"],[228,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[290,"يا سيد ما أنت إلا سيد","https://www.aldiwan.net/poem39427.html","الكامل"],[422,"قطب تدور عليه أفلاك الهدى","https://www.aldiwan.net/poem53840.html","الكامل"],[487,"من هو أصل وجود","https://www.aldiwan.net/poem24334.html","عموديه"],[563,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[563,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[572,"عرش العلا منهدم مؤتفك","https://www.aldiwan.net/poem69561.html","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103083","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119993","المجتث"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95507","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111779","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108516","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66262","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110320","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105041","المجتث"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21455","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106880","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101595","الخفيف"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125991","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125950","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216803","السريع"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34548","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127769","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125807","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94393","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94590","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198189","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35095","الكامل"],[4684,"مع (دونكيشوته) بدون همز.","https://www.poetsgate.com/ViewPoem.aspx?id=201111",""],[4765,"فرعون الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=215674",""],[4791,"ويلاه","https://www.poetsgate.com/ViewPoem.aspx?id=37100",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5183,"عواطف الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180212",""],[5183,"ذكرى ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=180225",""],[5184,"قَطَّعْتُ كلَّ اصابعي","https://www.poetsgate.com/ViewPoem.aspx?id=196813",""],[5338,"عرش الإمامة جنب حوض الكوثر","https://www.poetsgate.com/ViewPoem.aspx?id=190172",""],[5431,"هند..وبلقيس المقعدة!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200068",""],[5447,"رمشاك","https://www.poetsgate.com/ViewPoem.aspx?id=208293",""],[5628,"أنا أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=178805",""],[5952,"مَايا","https://www.poetsgate.com/ViewPoem.aspx?id=202877",""],[6124,"عرش الملوك","https://www.poetsgate.com/ViewPoem.aspx?id=174820",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["عَرْشٌ أَقِيمَ فَلَمْ يَتِمَّ بِنَاؤُهُ","حَتَّى انْقَضَتْ مِئَةٌ مِنَ الأَعْوَامِ",0,"م",1,0],["عَرْشُ مِصْر أَضْفَى عَلَيْنَا ظِلاَلاً","وَالأغَارِيدُ وَحْيُ تِلْكَ الظِّلاَلِ",1,"ل",1,0],["عرش وفرش وأملاك مسخّرة","وكلها ساجد لله مولاهُ",2,"ا",2,0],["عرش به تعرف الناس الجلالة إذ","لاح الجمال على مبناه ألوانا",3,"ن",2,0],["عرش بلقيس في المناعة لكن","قد حكت في احتشامها بلقيسا",4,"س",2,0],["عَرشُ النَبِيِّ مُحَمَّدٍ جَنَباتُهُ","نورٌ وَرَفرَفُهُ الطَهورُ غَمامُ",5,"م",1,0],["عُرشٌ كَحاشِيَةِ الإِزارِ شَريجَةٌ","صَفراءُ لا سِدرٌ وَلا هِيَ تَألَبُ",6,"ب",1,0],["عَرشَ القَياصِرِ وَالقَضاءُ إِذا جَرى","هَوَتِ العُروشُ وَطارَتِ التيجانُ",7,"ن",1,1],["عَرشٌ تَأَلَّبَتِ الرَواجِفُ حَولَهُ","فَهَوى بِشامِخِ عِزِّهِ الرَجفانُ",7,"ن",1,0],["عرشه في السماء وهو عليه","مستوٍ ما لأمره تغيير",8,"ر",1,0],["عرشُ غرناطة إلهُ أثينا","تاجُ روما سماءُ مجدِ الكنانَه",9,"ن",2,0],["عرشٌ قوائمهُ التُّقى وظلالهُ","عَدْلٌ وروحانيةٌ وترفُّقُ",10,"ق",1,0],["عرشٌ لفاروقَ العظيمِ يزينهُ","هذا الشبابُ العبقريُّ المشرقُ",10,"ق",1,0],["عَرشُ القِيامَةِ أَنتَ تَحتَ لِوائِهِ","وَالحَوضُ أَنتَ حِيالَهُ السَقاءُ",11,"ا",2,0],["عرشٌ ينوح أسى على سلطانهِ","قد غاب كسرى الشعر عن إيوانِهِ",12,"ن",2,1],["عرشُ القوافي بعد موتك شاغرٌ","يا طول ما يلقاه من أشجانه",12,"ن",2,0],["عرشٌ على الدستور قام أساسُه","فإذا به أرسَى من الأطواد",13,"د",1,0],["عرشُ القوافي أنت ربُّ","الحكم فيه، مستقلُّه",14,"ل",2,0],["عرش الطبيعة قد صُفَّتْ أرائكُهُ","إن الربيع لهذا العرش سلطان",15,"ن",1,0],["عرش، سرادقهُ في كل ناحيةِ","يقام، يشهده حُورٌ وولدان",15,"ن",1,0],["عرشٌ يَمُدُّ على العروبة ظلَّه","وعليه أجنحةُ السماء تُظَلِّل",16,"ل",1,0],["عرش لفروق العظيم ، يزينه","هذا الشّباب العبقريّ المشرق",17,"ق",1,0],["عرشٌ بطولِ مدارِ السبعَةِ الشهبِ","والشمسُ في تاجِهِ لا حليةَ الذهبِ",18,"ب",1,1],["عَرشُ العَتِيِّ عَلى بُركانِ مُنكِرِهِ","شَتيمَةٌ رَخَمَت في قَلبِ سَكرانِ",19,"ن",1,0],["عرش الخلافة فاتحا بيمينه","باب الصفا وشماله سيف النقم",20,"م",1,0],["عرشٌ به عِلْمُ الشريعة ثابتٌ","إذ قام كرسي العلوم بحدّه",21,"د",2,0],["عرش التجلي الكمالي","محمد عبد صالح",22,"ح",1,0],["عرشي أتى من سباغيٍّ لقدس هدى","ومع سليمانه إسلام بلقيس",23,"س",1,0],["عرش الوجود أظلني بضيائه","وحبا التجلي لي ثياب ولائه",24,"ه",1,0],["عَرْشُ العُلاَ مُنْهَدِمٌ مُؤْتَفِكْ","مُذْ جَاوَرَ الأَجْدَاثَ عَبْدُ المَلِكْ",25,"ك",1,1],["عرش إذا ما الحس غير مركب","بالأمر والملكوت عنه يعبر",26,"ر",1,0],["عرشنَ وسطَ دماغٍ","ما مخه طَوجُ",27,"ج",1,0],["عرشٌ له الأهرام قاعدةٌ فلا","يزداد إلا مَنعَةً وشُمولا",28,"ل",2,0],["عرش الجمال عَلَى الجبين مسترٌ","بدجى الكمال ليكتمَ الاسرارا",29,"ر",2,0],["عرِّش عليَّ بكرمٍ من ذوائبها","أعطيك فيه كروم الروم والعرب",30,"ب",1,0],["عرش بلقيس كان آصفه","عيسى وقد فاق سبقه من جارا",31,"ر",2,0],["عَرشُهُ الأرضُ والسماءُ قريبٌ","لم يَغِب فيضُ نورِهِ عن مكانِ",32,"ن",1,0],["عرش القلوب واي عرشٍ مثله","ركب الملوك بصولة الأجناد",33,"د",1,0],["عرش العراق جمال","لكل ملك مفضل",34,"ل",1,0],["عُرِشَ الثَّقابُ لَها بِدارِ إِقامةٍ","لِلحيِّ بَينَ نَظائرٍ وِترِ",35,"ر",1,0],["عرشان في الدنيا بربهما","سقطا وقد خانتهما العمد",36,"د",1,0],["عَرشُ لُطفٍ فوقَ الكيانِ تَدَلَّى","وإليهَ انتهى عُروج الكيانِ",37,"ن",1,0],["عرشٌ حباهُ لاسماعيلَ فاطِرُه","وعزَّ وارثُ إسماعيلَ وانتَصَرَا",38,"ر",2,0],["عرشه سدة السحاب عليها","نفض الليل كل رهبة رسمه",39,"م",2,0],["عرش كسرى ومصر والشام ثلّوا","وجروا في الفتوح جرّي السوابق",40,"ق",1,0],["عرش الإسلام قوائمه","قد قامت في ماضي حيدر",41,"ر",1,0],["عرشاً قوائمه الهمو","م وتاجه شوك القتاد",42,"د",1,0],["عرشٌ لأجدادك وُلّيته","كيف تولى عنه ذاك الجلالْ",43,"ل",1,0],["عرشٌ بلا طنبٍ من فوقه زبدٌ","قد جل عن صفةٍ في حسن لألاء",44,"ا",2,0],["عرشاً بديعاً محكم القياس","قتيره من اللجين القاسي",45,"ي",1,0],["عرشت لقلبي أنت في وسط مه","جتي مقيماً ونظمي فيكم يترفعُ",46,"ع",1,0],["عرش بإخلاص القلوب وطيدُ","والشعب بالملك الجليل سعيد",47,"د",1,1],["عرشَ الوزارة مذ رقى عن والدٍ","قد قيل فيهِ نِعَم ذا المَولودُ",48,"د",1,0],["عرش الفصاحة قد علوتَ ومِنبرا","وسما البلاغة قد سموت ومن بَرا",49,"ر",2,1],["عَرْشُ المُروءَةِ في ((أبي ظَبْيِ))العُلَى","بِكَ يَابْنَ ((سُلْطانٍ)) غدا يَتَعالَى",50,"ل",2,0],["عُرِشَت سَماءُ عَلائِكُم ما أَنتُمُ","مِن بَعد ذلِكُم الشهابُ الهادي",51,"د",2,0],["عرش العفاف مدمر من فترة","الصدق مات وأعدم الأمس الوفا",52,"ا",1,0],["عرشُ الحروفِ لهُ أهْلٌ تليقُ بهِ","تسْبيْ القلوبَ بإنصافٍ غدا طَبْعَا",53,"ع",2,0],["عرش الهوى خلقت له رموش عينك","عكشٍ بحربة حبّهن صوّبنِّيْ",54,"ن",2,0],["عرش ُ الكِبار ِ مواطن ٌ لا فكرة ٌ","تأتي لرأس ٍ بالفراغ ِ يُطَبّل",55,"ل",1,0],["عرش الخلافة بل مهد النبيينا","حياك مقتبس الأنوار من سينا",56,"ن",2,1],["عرش على المغرب الأقصى يباركه","للعبقرية عيص الهاشميينا",57,"ن",2,0],["عرش تربع عيص الأزد هامته","يجلو التبابع والصيد الميامينا",57,"ن",2,0],["عَرْشٌ مِنَ الوَهْمِ - يا بِلْقِيْسُ - فَانْتَبِهي","ما رُدَّ لِلْقَصْرِ - يا بِلْقِيْسُ - مَفْقوْدُ",58,"د",1,0],["عَرْشُ الإمَامَةِ جَنْبَ حَوْضِ الكَوْثَرِ","تَعْلو مَهَابَتَهُ جَلَالةُ حَيْدَرِ",59,"ر",1,1],["عرش الطغاة اليوم منهدمٌ","في الجوع تُعلن غزْوَها الأُسْدُ",60,"د",1,0],["عرشٌ لقافيتي بفُسطاطِ اللمى","شرقيَّ لَحظِ الضادِ شِيدَ عتيدا",61,"د",2,0],["عرْشها كان َ غناها إنّما","ابتساماتك ِ أغلى ما لديك ِ",62,"ك",1,0],["عرشُها لم تستطعْه الجِنُّ .... ما","عرشُ (بلقيسٍ) سوى بعضِ البقايا",63,"ا",3,0],["عرشُ الملوكِ على فراغٍ قد سطا","والأرضُ تحت العرشِ من ماءٍ جمدْ",64,"د",1,1],["عَرَّشَ السندسُ في صحرائِنا","وجَلا عن أَزَلِ الدهرِ غُبَارَهْ",65,"ر",2,0]]}