{"poems":[[55,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[53,"يا مستقر العار والنقص","https://www.aldiwan.net/poem64934.html","البسيط"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[154,"لعمري لقد ذقت الهوى فوجدته","https://www.aldiwan.net/poem68554.html","الطويل"],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[240,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[354,"لواجب الوجد في كلي لكلكم","https://www.aldiwan.net/poem15768.html","البسيط"],[376,"قد سلم الناس إليك المدى","https://www.aldiwan.net/poem57366.html","السريع"],[406,"ريحانة القلب","https://www.aldiwan.net/poem10296.html","عموديه"],[463,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26537","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36799","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58164","الوافر"],[4578,"عينا بمنشور الهوى جيت والياً","https://www.poetsgate.com/ViewPoem.aspx?id=49614",""],[5455,"الريح والناي","https://www.poetsgate.com/ViewPoem.aspx?id=213958",""],[5461,"لواجب اكبر","https://www.poetsgate.com/ViewPoem.aspx?id=5309",""]],"verses":[["لَو أُجيزَت لَهُ العِيادَةُ يَوماً","لَقَضى مِن فَظاظَةِ العُوّادِ",0,"د",1,0],["لواجدٌ فيك بلا فِريةٍ","مشاتماً تُغني عن النصِّ",1,"ص",1,0],["لو أَجْمَعَ الخَلْقُ أَنْ يُحْصُوا مَحاسِنَهُ","أَعْيَتْهُمُ جُمْلَةٌ منها وتَفْصِيلُ",2,"ل",1,0],["لو اجتَمَعَت عَيني بمرآكَ لَمحَةً","لَلَذَّ لها في حَقِّكًَ المَوتُ والقَتلُ",3,"ل",1,0],["لَوِ اِجتازَت بِسامِعَتَي جَريرٍ","لَقامَ لَها جَلالاً وَاِستَعادا",4,"د",2,0],["لو اِجتَمعوا من أوّل الدهرِ جملةً","لَما اِختَرعوا روحاً إذا صوّروا ذرّا",5,"ر",2,0],["لَو أَجابَ اللهُ في المَع","عشوقِ لِلعاشِقِ دَعوَه",6,"و",2,0],["لِواجِبِ الوَجدِ في كُلّي لِكُلِّكُم","مِكانُ صَبرِيَ عَنهُ راحُ مُتَّسِعا",7,"ع",2,1],["لو أجدَبَ العامُ فكلُّ امرئٍ","يلقاكَ منه طاعِمٌ كاسِ",8,"س",1,0],["لو اجمعَ الناسُ أمراً في مساءتنا","ولم يُقدّر لما فازوا بما طلبوا",9,"ب",3,0],["لو أُجيبتْ لمحبٍّ دعوةٌ","لسألتُ اللهَ في الظالمِ منَّا",10,"ن",2,0],["لو اجتبت في آل حرب كما","نكب عن ألفاظها الأخطل",11,"ل",1,0],["لوِ اجتازَ جَفرانٌ بِها ظَلَّ حائِراً","يَعَضُّ عَلى كَفَّيهِ مِن ضَيعَةِ الفِكرِ",12,"ر",1,0],["لَو أَجابَتهُم لَصِرنا","آيَةً لِلسّائِلينا",13,"ن",2,0],["لو أجادت نفس الردى منه نفساً","لسناها بالسيف كاس رداها",14,"ا",3,0],["لو أجاجُ البحارِ صارَ مِداداً","وأمدَّ البحارَ سبعٌ دوانِ",15,"ن",1,0],["لَو أَجارَ الزُهرَ ما غَرِقَت","فِي خَليج الفَجرِ عُوّمُها",16,"م",3,0],["لَوِ اِجتَزنَ بِالطائيِّ قِدماً قَضى لَها","بِسَبقٍ وَقالَ الطاءُ مِن بَعدُ لا تُوطا",17,"ط",2,0],["لو اجتاحني وسلاحي سلب","لقيل همامٌ هماماً ضرب",18,"ب",1,0],["لو اجتمعوا جميعُ الخلق طُرّاً","على ردٍّ فلْيسُوا قادرينا",19,"ن",2,0],["لواجب هذا المدح أصبح نادتي","فليته في حلبة الشعر جاريا",20,"ي",2,0],["لو اجرحتني وقتها .. يمكن أرتاح","لكنها.. وبدون كلمة ولا راي ..",21,"ا",2,0],["لواجب اكبر يا بوخالد علينا","لو بعت أنا روحي فلا ظني اوفيه",22,"ي",2,1]]}