{"poems":[[55,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[42,"بعني نسيب ولا تهب لي إنني","https://www.aldiwan.net/poem50457.html","الكامل"],[54,"عللاني بسماع وطلا","https://www.aldiwan.net/poem27664.html","الرمل"],[27,"ما بال نومك بالفراش غرارا","https://www.aldiwan.net/poem5750.html","الكامل"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[91,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[89,"حبذا تمثال أمامي تعالى","https://www.aldiwan.net/poem44741.html","الخفيف"],[85,"أيها الثغر بلغت الأملا","https://www.aldiwan.net/poem7143.html","الرمل"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[43,"لم لا يغاث الشعر وهو يصيح","https://www.aldiwan.net/poem10608.html","الكامل"],[45,"قل للأرند إذا أتى الروحين لا","https://www.aldiwan.net/poem64596.html","الكامل"],[28,"طرقت أمية في المنام تزورنا","https://www.aldiwan.net/poem5168.html","الكامل"],[49,"أبلغ سلمت أبا الوليد سلامي","https://www.aldiwan.net/poem64907.html","الكامل"],[66,"وإذا فاتك الغنى نكص العز","https://www.aldiwan.net/poem38558.html","الخفيف"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[44,"هي فرقة من صاحب لك ماجد","https://www.aldiwan.net/poem30554.html","الكامل"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[52,"قد عضني صرف النوائب","https://www.aldiwan.net/poem27242.html","مجزوء الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"وأخ إن جاءني في حاجة","https://www.aldiwan.net/poem64461.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54306","الكامل"],[115,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[122,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[122,"لا در درك جعفر يا جعفر","https://www.aldiwan.net/poem23739.html","الكامل"],[126,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[148,"الخمر متلفة لدينك فاحذر","https://www.aldiwan.net/poem68531.html","الكامل"],[158,"من بات مثلي للنجوم نزيلا","https://www.aldiwan.net/poem59095.html","الكامل"],[227,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[295,"بك في ملة الغرام اقتديت","https://www.aldiwan.net/poem33080.html","الخفيف"],[303,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[362,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[364,"وإذا فتى أسدى يدا لي مرة","https://www.aldiwan.net/poem17307.html","الكامل"],[369,"خذ حديثي فكم أغططي","https://www.aldiwan.net/poem57293.html","مجزوء الخفيف"],[374,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[403,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[406,"حيا ربوعك من ربى ومنازل","https://www.aldiwan.net/poem31851.html","الكامل"],[406,"نفسي الفداء لمن أذود بذكره","https://www.aldiwan.net/poem32247.html","الكامل"],[406,"لا غرو إن هجر الخيال الزائر","https://www.aldiwan.net/poem32484.html","الكامل"],[456,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[456,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[456,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[462,"ما جماد يفيد مالاً وعدماً","https://www.aldiwan.net/poem3460.html","عموديه"],[549,"يا طالب الدنيا على ذل بها","https://www.aldiwan.net/poem47304.html","الكامل"],[549,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[549,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[556,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[556,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[574,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"]],"verses":[["وَإِذا فَرَرتُ مِنَ الهَوى","أَلفَيتُهُ يَسعى وَيَلحَق",0,"ق",1,0],["وَإِذا فَعَلتُ فَعَلتُ غَيرَ مُحاسَبٍ","وَكَفى بِرَبِّكَ جازياً وَمُحاسِبا",1,"ب",2,0],["وَإِذا فاتَكَ مِنها واحِدٌ","نَقَصَ العَيشُ بِنُقصانِ الهَوى",2,"ا",1,0],["وَإِذا فَخَرتَ بِأُمَّهاتِ مُجاشِعٍ","فَاِفخَر بِقَبقَبَ وَاِذكُرِ النِخوارا",3,"ر",2,0],["وإذا في خشوعه ذلك الأمي","يتلو رسالة الإيحاء",4,"ا",2,0],["وَإِذا فَتىً كَالفَجرِ طَلعَتُهُ","بَل رُبَّما أَربى عَلى الفَجرِ",5,"ر",1,0],["وإذا فتنةُ الحَيَاة وسِحْرُ الكونِ","ضَرْبٌ من الغَمامِ الزَّاهي",6,"ي",1,0],["واذا فكر المفكر لا يلقى","حياة الشعوب الا نضالا",7,"ل",2,0],["وإذا فاتك لمس بيد","فتزوّد باللحاظ القبلا",8,"ل",2,0],["وَإِذا فاتَكَ اِلتِفاتٌ إِلى الما","ضي فَقَد غابَ عَنكَ وَجهُ التَأَسّي",9,"س",2,0],["وإذا فشا طغيان عادٍ فيكم","فتأملوا وجهي فإني الريح",10,"ح",1,0],["وَإِذا فَلَيتَ أُصولَهُم رَجَعوا إِلى","نَسَبٍ كَرَيعانِ السَرابِ لَبيسِ",11,"س",1,0],["وَإِذا فَخَرتُ فَخَرتُ غَيرَ مُكَذَّبٍ","وَلِيَ العُلى وَكَريمُها المَأثورُ",12,"ر",1,0],["وَإِذا فَرَغتَ مِنَ السَلامِ فَقُل لَهُ","قَد كانَ ما شاهَدتَ مِن إِفحامي",13,"ي",1,0],["وَإِذا فاتَكَ الغِنى نَكَصَ العَز","مُ وَكَلَّ اللِسانُ عِندَ الكَلامِ",14,"م",1,1],["وإذا فارَقتَ ريعانَ الصِّبا","فَاللّيالي بأمانيكَ شِحاح",15,"ح",1,0],["وَإِذا فَقَدتَ أَخاً وَلَم تَفقِد لَهُ","دَمعاً وَلا صَبراً فَلَستَ بِفاقِدِ",16,"د",1,0],["وإذا فهمتَ الفقهَ عشتَ مصدَّراً","في العالمينَ معظَّمَ المقدارِ",17,"ر",1,0],["وَإِذا فَتاةٌ كَالرَبيعِ خَصيبَةٌ","وَفَتىً كَرَيعانِ الصِبى مِسماحُ",18,"ح",1,0],["وَإِذا فَقَدتَ الحاسِدينَ","فَقَدتَ في الدُنيا الأَطايِب",19,"ب",1,0],["وإذا فَرَضْتُمْ أنَّ عيسى ربّكُمْ","أفَلَمْ يَكُنْ لِفِدَائِكُمْ مَبْذُولا",20,"ل",2,0],["وَإِذا فاجَأتُهُ في مِثلِها","كانَ بِالرَدِّ بَصيراً حاذِقا",21,"ق",2,0],["وإذا في أيامن الغرب منا","كَرَجاء المسلول ضوء ضَئيل",22,"ل",1,0],["وإذا فَرَرْتُ من الوداعِ وهَوْلهِ","فلقد بعثتُ مع الدُّموعِ وَداعي",23,"ي",1,0],["وإذا فَسَقْتُ بِسَبِّكُمْ وعِدائِكُمْ","فالكُلُّ مِنْكُمْ فاسِقٌ سَبَّابُ",24,"ب",1,0],["وإذا فتاوى الشيخ محض سخافة","وإذا به في فقهه مسكين",25,"ن",1,0],["وإذا فقيه القوم أسهب واعظاً","وبه اهتدى غيري فدعني أكفر",26,"ر",1,0],["وإذا فاتَك شىءٌ لا تقل","ليتَه لي وعَسَاهُ ولَعَلّْ",27,"ل",1,0],["وإذافقدت العقلَ كنت بهيمةً","في جلد إنسان وحسبك فانظر",28,"ر",1,0],["وإذا فرقت على الجماعة جملة","حملوا وخف ولو يكون ثقيلا",29,"ل",2,0],["وإذا فشا سقم المحِبِّ ودمعه","مَنَعَا منِيع السرّ أن يتمنّعا",30,"ع",2,0],["وإذا فهتُ للوَرى بغَرامي","بسطَ العاذلون فيك مَلامي",31,"ي",1,0],["وَإِذا فككت حرائريّاً شمته","نبزاً يسوؤك للتخنّث لازبا",32,"ب",2,0],["وإذا فَسادُ العُضْوِ أصبحَ زائداً","لم يَشْفَ منه غيرُ كَفِّ القاطع",33,"ع",1,0],["وَإِذا فَتىً أَسدى يَداً لِيَ مَرَّةً","مَلَأَت يَدَيهِ في الثَوابِ بِها يَدي",34,"ي",1,1],["وإِذا في جَماعَة ال","قَومِ يَعدو ويَنصَرِف",35,"ف",1,0],["وإذا فَهمتَ وجدتَها","ليست عليك بخافيه",36,"ي",2,0],["وَإِذا فاضَ في نَوالٍ وَبَأسٍ","غَرَّقَ الخافِقينَ نَفعاً وَضرا",37,"ر",2,0],["وإذا فَزعتُ إلى العَزاءِ دعوتُ مَن","لا يَستجيبُ ورُمتُ نُصرةَ خاذِلِ",38,"ل",1,0],["وإذَا فَررتُ من الخُطوبِ جَعلتُه","فِئَتِي فَيُفرِقُها امتِنَاعُ مَكانِي",39,"ي",1,0],["وإذَا فَزِعتُ إلى الأماني صدّني","يأسٌ يُحقِّقُه الزّمانُ الخَاتِرُ",40,"ر",1,0],["وإذا فتلتَ حبالَ عهدٍ لم يكن","يوماً ليُنكثَ حبلُك المستحصِفُ",41,"ف",1,0],["وإذا فار فيهمُ عرقُ طيٍّ","أضرم الأصلُ نارَه في الفرعِ",42,"ع",1,0],["وإذا فزعتُ لجأتُ من أَسدٍ إلى","أسدٍ تأشَّبَ في القنا المخضوبِ",43,"ب",1,0],["وإذا فارقتهُ لا عن هلاكٍ","فاض للبين دمعهُ واستهلا",44,"ل",2,0],["وإذا فجعتَ بماء وجهك لم يُفِدْ","إنْ نلتَ من أيدي الرّجال جزيلا",45,"ل",2,0],["وإذا فاتنا غَبوقُ المنايا","بِاِتّفاقِ الزّمانِ فهو الصَّبوحُ",46,"ح",1,0],["وَإِذا فُزنا بِصِدقٍ","مِن غِنىً فَهوَ كِذابُ",47,"ب",1,0],["وإذا فعلٌ تكون له","نسبتانِ الأمرُ فيه مجال",48,"ل",1,0],["وإذا في حبه مت فقد","عشت بعد الموت عيش السُعَدا",49,"د",2,0],["وَإِذا فَزِعتَ رَأَيتَنا","حَلَقاً وَعادِيَةً وَرَزدَق",50,"ق",1,0]]}