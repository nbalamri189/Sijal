92,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5409,"بين نشر الدجى وطي النهار","https://www.poetsgate.com/ViewPoem.aspx?id=155459",""],[5508,"زهرُ الحسنِ فوق زَهْرِ الرياضِ","https://www.poetsgate.com/ViewPoem.aspx?id=110832",""],[5521,"سائل تميماً هل وقيت فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=85035",""],[5664,"الجموح","https://www.poetsgate.com/ViewPoem.aspx?id=176695",""],[5727,"الشاطئ البعيد","https://www.poetsgate.com/ViewPoem.aspx?id=205417",""],[5897,"إيه .. يا جنة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=176413",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"وخْزٌ في زَند ابنتي آن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213372",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[6093,"أطلق سبيلي يا مدير","https://www.poetsgate.com/ViewPoem.aspx?id=197904",""],[6142,"بالغريين وبين الذكوات","https://www.poetsgate.com/ViewPoem.aspx?id=155734",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""],[5001,"الرسم بالحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80718&r=&rc=8",""]],"verses":[["وَإِذا فَرَرتُ مِنَ الهَوى","أَلفَيتُهُ يَسعى وَيَلحَق",0,"ق",1,0],["وَإِذا فَعَلتُ فَعَلتُ غَيرَ مُحاسَبٍ","وَكَفى بِرَبِّكَ جازياً وَمُحاسِبا",1,"ب",2,0],["وَإِذا فاتَكَ مِنها واحِدٌ","نَقَصَ العَيشُ بِنُقصانِ الهَوى",2,"ا",1,0],["وَإِذا فَخَرتَ بِأُمَّهاتِ مُجاشِعٍ","فَاِفخَر بِقَبقَبَ وَاِذكُرِ النِخوارا",3,"ر",2,0],["وإذا في خشوعه ذلك الأمي","يتلو رسالة الإيحاء",4,"ا",2,0],["وَإِذا فَتىً كَالفَجرِ طَلعَتُهُ","بَل رُبَّما أَربى عَلى الفَجرِ",5,"ر",1,0],["وإذا فتنةُ الحَيَاة وسِحْرُ الكونِ","ضَرْبٌ من الغَمامِ الزَّاهي",6,"ي",1,0],["واذا فكر المفكر لا يلقى","حياة الشعوب الا نضالا",7,"ل",2,0],["وإذا فاتك لمس بيد","فتزوّد باللحاظ القبلا",8,"ل",2,0],["وَإِذا فاتَكَ اِلتِفاتٌ إِلى الما","ضي فَقَد غابَ عَنكَ وَجهُ التَأَسّي",9,"س",2,0],["وإذا فشا طغيان عادٍ فيكم","فتأملوا وجهي فإني الريح",10,"ح",1,0],["وَإِذا فَلَيتَ أُصولَهُم رَجَعوا إِلى","نَسَبٍ كَرَيعانِ السَرابِ لَبيسِ",11,"س",1,0],["وَإِذا فَخَرتُ فَخَرتُ غَيرَ مُكَذَّبٍ","وَلِيَ العُلى وَكَريمُها المَأثورُ",12,"ر",1,0],["وَإِذا فَرَغتَ مِنَ السَلامِ فَقُل لَهُ","قَد كانَ ما شاهَدتَ مِن إِفحامي",13,"م",2,0],["وَإِذا فاتَكَ الغِنى نَكَصَ العَز","مُ وَكَلَّ اللِسانُ عِندَ الكَلامِ",14,"م",1,1],["وإذا فارَقتَ ريعانَ الصِّبا","فَاللّيالي بأمانيكَ شِحاح",15,"ح",1,0],["وَإِذا فَقَدتَ أَخاً وَلَم تَفقِد لَهُ","دَمعاً وَلا صَبراً فَلَستَ بِفاقِدِ",16,"د",1,0],["وإذا فهمتَ الفقهَ عشتَ مصدَّراً","في العالمينَ معظَّمَ المقدارِ",17,"ر",1,0],["وَإِذا فَتاةٌ كَالرَبيعِ خَصيبَةٌ","وَفَتىً كَرَيعانِ الصِبى مِسماحُ",18,"ح",1,0],["وَإِذا فَقَدتَ الحاسِدينَ","فَقَدتَ في الدُنيا الأَطايِب",19,"ب",1,0],["وإذا فَرَضْتُمْ أنَّ عيسى ربّكُمْ","أفَلَمْ يَكُنْ لِفِدَائِكُمْ مَبْذُولا",20,"ل",2,0],["وَإِذا فاجَأتُهُ في مِثلِها","كانَ بِالرَدِّ بَصيراً حاذِقا",21,"ق",2,0],["وإذا في أيامن الغرب منا","كَرَجاء المسلول ضوء ضَئيل",22,"ل",1,0],["وإذا فَرَرْتُ من الوداعِ وهَوْلهِ","فلقد بعثتُ مع الدُّموعِ وَداعي",23,"ع",2,0],["وإذا فاجأ اليقين على الشك","حسبت اليقين تهويل واهم",24,"م",1,0],["وإذا فتى كالفجر طلعته","ل ربما أربى على الفجر",25,"ر",1,0],["وإذا فتّ أعين النّاس دلاّ","فلمن صاغ حسنك الرّحمن",26,"ن",1,0],["وإذا فَسَقْتُ بِسَبِّكُمْ وعِدائِكُمْ","فالكُلُّ مِنْكُمْ فاسِقٌ سَبَّابُ",27,"ب",1,0],["وإذا فتاوى الشيخ محض سخافة","وإذا به في فقهه مسكين",28,"ن",1,0],["وإذا فقيه القوم أسهب واعظاً","وبه اهتدى غيري فدعني أكفر",29,"ر",1,0],["وإذا فاتَك شىءٌ لا تقل","ليتَه لي وعَسَاهُ ولَعَلّْ",30,"ل",1,0],["وإذافقدت العقلَ كنت بهيمةً","في جلد إنسان وحسبك فانظر",31,"ر",1,0],["وإذا فرقت على الجماعة جملة","حملوا وخف ولو يكون ثقيلا",32,"ل",2,0],["وإذا فشا سقم المحِبِّ ودمعه","مَنَعَا منِيع السرّ أن يتمنّعا",33,"ع",2,0],["وإذا فهتُ للوَرى بغَرامي","بسطَ العاذلون فيك مَلامي",34,"ي",1,0],["وَإِذا فككت حرائريّاً شمته","نبزاً يسوؤك للتخنّث لازبا",35,"ب",2,0],["وإذا فَسادُ العُضْوِ أصبحَ زائداً","لم يَشْفَ منه غيرُ كَفِّ القاطع",36,"ع",1,0],["وَإِذا فَتىً أَسدى يَداً لِيَ مَرَّةً","مَلَأَت يَدَيهِ في الثَوابِ بِها يَدي",37,"ي",1,1],["وإِذا في جَماعَة ال","قَومِ يَعدو ويَنصَرِف",38,"ف",1,0],["وإذا فَهمتَ وجدتَها","ليست عليك بخافيه",39,"ي",2,0],["وَإِذا فاضَ في نَوالٍ وَبَأسٍ","غَرَّقَ الخافِقينَ نَفعاً وَضرا",40,"ر",2,0],["وإذا فَزعتُ إلى العَزاءِ دعوتُ مَن","لا يَستجيبُ ورُمتُ نُصرةَ خاذِلِ",41,"ل",1,0],["وإذَا فَررتُ من الخُطوبِ جَعلتُه","فِئَتِي فَيُفرِقُها امتِنَاعُ مَكانِي",42,"ن",2,0],["وإذَا فَزِعتُ إلى الأماني صدّني","يأسٌ يُحقِّقُه الزّمانُ الخَاتِرُ",43,"ر",1,0],["وإذا فتلتَ حبالَ عهدٍ لم يكن","يوماً ليُنكثَ حبلُك المستحصِفُ",44,"ف",1,0],["وإذا فار فيهمُ عرقُ طيٍّ","أضرم الأصلُ نارَه في الفرعِ",45,"ع",1,0],["وإذا فزعتُ لجأتُ من أَسدٍ إلى","أسدٍ تأشَّبَ في القنا المخضوبِ",46,"ب",1,0],["وإذا فارقتهُ لا عن هلاكٍ","فاض للبين دمعهُ واستهلا",47,"ل",2,0],["وإذا فجعتَ بماء وجهك لم يُفِدْ","إنْ نلتَ من أيدي الرّجال جزيلا",48,"ل",2,0],["وإذا فاتنا غَبوقُ المنايا","بِاِتّفاقِ الزّمانِ فهو الصَّبوحُ",49,"ح",1,0],["وَإِذا فُزنا بِصِدقٍ","مِن غِنىً فَهوَ كِذابُ",50,"ب",1,0],["وإذا فعلٌ تكون له","نسبتانِ الأمرُ فيه مجال",51,"ل",1,0],["وإذا في حبه مت فقد","عشت بعد الموت عيش السُعَدا",52,"د",2,0],["وَإِذا فَزِعتَ رَأَيتَنا","حَلَقاً وَعادِيَةً وَرَزدَق",53,"ق",1,0],["وإذا فاته نداي فنفسي","تفتديه في الطارىء المدلهم",54,"م",1,0],["وَإِذا فَتَّحت خُدودُك وَرداً","ثَغرُكَ العَذبُ قَد أَبانَ الأَقاحا",55,"ح",2,0],["وإذا في البعيد عندَ قيامِ الد","دهرِ طيفانِ يسحبانِ الهوانا",56,"ن",2,1],["وإذا في جوانب الناس شوق","والتفات إلى البعيد العالي",57,"ل",2,0],["وإذا فُوجيءَ امْرُؤٌ بِمُصاب","مالَ للشَّكِّ فيهِ والإنْكارِ",58,"ر",1,0],["وإذا فرّكَ النسيمُ قميصَ ال","ماءِ أضحى مكسَّرَ الأطرافِ",59,"ف",1,0],["وإذا فنيت إلى لقاه فنفحة","من عرف حضرة قدسه تحييني",60,"ن",2,0],["واذا فخرت بتغلب ابنة وائل","فأذكر مكارم من ندى وأوائل",61,"ل",1,0],["وَإِذا فاتك السباق فألحق","وَإِذا جاوزوا أَقم في اللحاق",62,"ق",1,0],["وإذا فاه غادر الصبية الأغ","مار بالعلم سادةً أبرارا",63,"ر",2,0],["واذا فقدت الصبر فالبس مسحة ال","أحزان وابك ممزق الاطواق",64,"ق",1,0],["وإذا فقدت ضياك من فرط الظّلم","فبنور عيني أستعيد ضياك",65,"ك",1,0],["وإذا فُلانٌ عُدَّ سَيّدَ مَعْشَرٍ","زحفوا له منهمْ بأَلْفِ فُلان",66,"ن",1,0],["وإذا فهمت مقالتي","زند المشاهد ينقدح",67,"ح",1,0],["وَإِذا في الغَباءِ سَمُّ بُرَيصٍ","قائِمٌ فَوقَ بَيتَنا بِقَدوم",68,"م",1,0],["وإذا فُدِيَت شَاقت وعَدَت","وإذا إشتاقَت نفسُ وَجَدَت",69,"ت",1,0],["وَإِذا فرَّت المَلاحم قُلنا","يا مُنى النَفس طالَ مِنكَ الصُدود",70,"د",1,0],["وَإِذا فَقَدت العزّ بَين مَعاشر","طلبته غارة سيري الملحاح",71,"ح",1,0],["وَإِذا فيكَ جانب الكَرخ جاءَت","نلت ما شئت مِن مناك وَشاءَت",72,"ت",1,0],["وإذا في دار السلام أقمتم","فعلى ذلك المقام السلام",73,"م",1,0],["واذا فؤادك سر في ميلاده","فبه السرور مشى بكل فؤاد",74,"د",1,0],["واذا فاخرت ببولس حصرون","ففيه فخار كل البلاد",75,"د",1,0],["وإذا فلسطين الحبيبة قلعة","للثأر بين جحافل وقلاعِ",76,"ع",1,0],["وَإِذا فَخَرتُ فَخَرتُ غَيرَ مُكَذَّبٍ","فَخرٌ أَدُقُّ بِهِ فَخارَ الفاخِرِ",77,"ر",1,0],["واذا فزت بالرواح","وتمشّيت في زبيد",78,"د",1,0],["وإذا فطنت بما حوته قضية","السَّكاف تعلم أنهم قد خانوا",79,"ن",3,0],["وإذا فاض من جفوني دمع","قلت للعين كفكفي الدمع عنها",80,"ه",2,0],["وإذا فاح شذا نشرهم","قلت داريون بالعنبر فاحوا",81,"ح",3,0],["واذا فؤاد فتى تصبر مكرها","فالفضل للاكراه لا لفؤاده",82,"د",2,0],["وإذا فرغت فلا تقم","حتى تصوت بالنديم",83,"م",1,0],["واذا في أُذنَيهِ صَوتُ قُلوبٍ","يَتَضرَّعنَ من خِلال الترائب",84,"ب",1,0],["وَإِذا فُلانٌ ماتَ عَنْ أُكْرومَةٍ","رَقُعَوا مَعاوِزَ فَقدِهِ بِفُلانِ",85,"ن",1,0],["وإذا في العشقِ عني حدّثوا","قِيلَ لا تخفى عَلَيهِ خافيَه",86,"ف",3,0],["وَإِذا فاضلت ثراه الثريّا","فضلتها وَجازَت الجَوزاءَ",87,"ا",2,0],["وإذا في الغرام مات شهيداً","كان خيراً له وأعظم أجرا",88,"ر",2,0],["وإذا فقدت مشقةً وتنعُّماً","فاعلم بأنَّك عنه دونَ حجاب",89,"ب",1,0],["وإذا فكرت أيّاماً لهم","صحتُ وا شوقي لأوقات التلاقْ",90,"ق",1,0],["وَإِذا فنيتُ صَبابةً","فَأَطِل غناءَك وَاسجَع",91,"ع",1,0],["وإذا فتى حر السجية ناله","عرضاً تراه لنفسه مستصغرا",92,"ر",2,0],["وإذا فولكان في","نيريانِه يَطفو وَيرسب",93,"ب",1,0],["وإذا فاجأ المشوق جنود ال","بين عبى من المدامع جندا",94,"د",2,0],["وإذا فاز خصمه ودّ لو كلّ","خبير سواه باللعب مخصي",95,"ص",2,0],["وإذا في الأفق شمس طلعت","حجب الشمس عن الكون الضباب",96,"ب",1,0],["وإذا فرحت يصوغ من فرحي رضاً","ويكون إن حلّ الهنا إكليلي!",97,"ل",2,0],["وإذ افتقدت الزارعي (م)","ن الوردَ، دع من يحسدُكْ",98,"ك",1,0],["واذا في يوم حسّيتي بوصلي يالغلا تقصير","أنا اسف على التقصير رغم الحب مديونك",99,"ك",1,0],["وإذا فقدتَ من الحياة أحبةً","قل إنما كُنهُ الحياة رحيلُ",100,"ل",1,0],["وإذا فعلتَ فقل لهم يأتيكمو","ما بين رعدَ* وخيبرَ* زلزالي*",101,"ل",2,0],["وإذا فقدنا لا فقدنا وجهه","فأذن بثورة فتنة صماء",102,"ا",2,0],["وإذا فحصت عن السيادة في الورى","ما بين مبدئها وبين مآلها",103,"ل",3,0],["وإذا فررتِ فسجنُ قلبي موصدٌ","أنَّى فررتِ وعشقُ روحي حارسُ",104,"س",1,0],["وإذ أفضل المولى وجاد عليكمو","بأنس وصيد من رواس رواكد",105,"د",1,0],["وإذا فرية قد يعلم الله أنه","علي من البهتان والإفك حاصله",106,"ل",2,0],["وإذا فوجئ امرؤ بمصاب","مال للشك فيه والإنكار",107,"ر",1,0],["وإذا فوّقَتْ سهاماً من الهُدْ","بِ رَمَينَ السَّهامَ بالأغراضِ",108,"ض",1,0],["وإذا فعلتم ذلكم لم تتركوا","أحداً يذب لكم عن الاحساب",109,"ب",1,0],["واذا في يوم اشواقي تبي عندك توصلني","ومن كفوف الوله تاخذ يديني لك توديها",110,"ي",3,0],["وإذا فَتَّحَ الصباحُ أماني","هِ بأفياءِ خالداتِ النعيمِ",111,"م",1,0],["وإذا فجاج النور تعتنق السها","بروافدٍ من طيِّبِ الأورادِ",112,"د",1,0],["وإذا فجرت بحرةٍ","في البعد منك وفي الكثب",113,"ب",1,0],["وإذا فرَكتُكِ لحظة أحتاج أنْ","تقفوا لساعاتٍ على تدليكي",114,"ك",2,0],["وإذا فَقدتُ مَناصِبي وعَمالتي","فسأنتهي بالسَّكتةِ القلبيَّةْ",115,"ي",2,0],["وَإِذَا فَعَلْتَ أَزَحْتَ عَنِّيَ كُرْبَةً","كَاللَّيْلِ عَنْ صَدْرِ السَّمَاءِ أُزِيْحَا",116,"ح",2,0],["وإذا في كيمياه امتزجت","ظلم الهول استحالت نيرات",117,"ت",1,0],["وإذا فتحت درج أوراق الرسائل","فاذكري بين الركام قصيدتي",118,"ت",2,0],["وإِذْ أَفاوِيْقُ ما يَجْنِيْهِ قاطِنُهُ","فِيْهِ المَجَاعَاتُ والأَمْراضُ والخَطَرُ",119,"ر",1,0],["وإذا فَجّرْتِ أنهارَ السنى","وسنون الجدبِ بُدّلن خِصابا",120,"ب",2,0],["واذا فؤادي والشجون تلفُّني","يشقي.. ويؤرق ليلي البَلبَالُ",121,"ل",1,0]]}