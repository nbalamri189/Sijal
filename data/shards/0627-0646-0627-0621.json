{"poems":[[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16293","الكامل"],[1001,"","https://poetry.dctabudhabi.ae/diwan/poem/100567","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109075","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109024","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74255","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74209","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117948","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83141","الكامل"]],"verses":[["إِناءُ مَجدٍ مَلآنُ بورِكَ في","صَريحِهِ لِلعُلى وَفي زَبَدِه",0,"د",2,0],["إناءٌ من النُّور طافتْ بهِ","يَدُ الحبِّ غارسةُ الزَّنبقِ",1,"ق",1,0],["آناءُ لَيلِكَ وَالنَهارُ كِلاهُما","مِثلُ الإِناءِ مِنَ الحَوادِثِ مُفعَمُ",2,"م",1,1],["أناء أنت عن عبد بحال","وهذا فضلك السامي يليه",3,"ي",2,0],["إناء ماؤه لا لون فيه","كذاك الماء من لون الإناء",4,"ا",2,0],["إناءٌ عليه الشمس ألقت شعاعها","وليس له غير الزجاج من الحجب",5,"ب",1,0],["اناء نضار فيهِ شَمس مُنيرة","وَأَي نضار لا يضيء مِن الشَمس",6,"س",1,0],["إِناءة عرفان وَهمة باسل","وَصمت وَقور لا يزلزله الخَطب",7,"ب",1,0],["أناءتْ ولم تُنضِجْ فأنتَ ترى لها","قروفاً نمَتْ منهنَّ دونَ البَراجمِ",8,"م",1,0],["اناء عز بساحات لبست بها","من الصبا ما يكاد البين يخلقه",9,"ق",2,0],["آناءُ لَهوٍ خَلَّفَت","حُزناً عَلَيها كُلَّ آنِ",10,"ن",1,0]]}