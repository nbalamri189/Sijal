{"poems":[[55,"عجلت يا شيب على مفرقي","https://www.aldiwan.net/poem29876.html","السريع"],[30,"إن الأرامل والأيتام قد يئسوا","https://www.aldiwan.net/poem5055.html","البسيط"],[92,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[77,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[92,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[107,"لبيك من حر المواقف عال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55000&r=&rc=170",""],[382,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[2397,"","https://poetry.dctabudhabi.ae/diwan/poem/204366","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65952","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201182","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200527","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100829","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114058","البسيط"],[4989,"الله يعلم أن قد جبت ذا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=82183",""],[5278,"سيقول السفهاء : ليس بمُجرم...","https://www.poetsgate.com/ViewPoem.aspx?id=203388",""],[5376,"يا جلق المجد والعلياء من زمن","https://www.poetsgate.com/ViewPoem.aspx?id=188535",""],[5051,"قالوا اعتباطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87706&r=&rc=0",""]],"verses":[["قالوا دَعِ القاعِدَ يُزري بِهِ","مَن قَطَعَ اللَيلَ وَجابَ الفَلا",0,"ل",2,0],["قالوا دَفَنّا اِبنَ لَيلى فَاِستَهَلَّ لَهُم","مِنَ الدُموعِ عَلى أَيّامِها دِرَرُ",1,"ر",1,0],["قالوا (دِمَشْقُ) و(بَغْدادٌ) فقلتُ هما","فَجْرٌ على الغَدِ مِن أَمْسَيْهِما انْبَثَقا",2,"ق",2,0],["قالوا دعوا السّودانَ إنّ لنا به","حقَّ الشريكِ من الزّمانِ الخالي",3,"ل",2,0],["قالوا دَواءً نبتغي فأجبتُهُمْ","ليسَ السَّقامُ لمثلِهِ بعَقيدِ",4,"د",1,0],["قالوا دَخيلٌ في القَري","ضِ فَما أَجاد وَلا أَجدّا",5,"د",2,0],["قالوا دهت مصر دهياء فقلت لهم","هل غيض النيل أم زلزل الهرم",6,"م",1,1],["قالوا دسائسها في طي زخرفها","وقلت قد صرحت بالسم في العسل",7,"ل",1,0],["قالوا : دمشق ، فقلت : غاية الربى","قالوا : لذاك تطاول الاناق",8,"ق",1,0],["قالوا دعوا السوادان إن لنا به","حق الشريك من الزمان الخالي",9,"ل",2,0],["قالوا دُعيتَ إلى الشَقا فاجبتُهم","من يُنكرُ الحقَّ الصراحَ فأحمق",10,"ق",1,0],["قالوا دمشق ينبيك الخبير بها","ثم ائت مصر فثم النائل الغمم",11,"م",1,0],["قالوا دمعت فقلت الدمع من رمد","والعين ما دمعت إلا على الكمد",12,"د",1,1],["قالوا دع الخمر الحرام فإن من","يدنو لها سيُزج في النيران",13,"ن",1,1],["قالوا دخلتَ لنادٍ ما به أدبٌ","وسوف تنحطُّ منه في الورى شانا",14,"ن",2,1],["قالوا دعوتم للتعصب دعوة","هلعت لهول سماعها الامصار",15,"ر",1,0],["قَالُوا دَعِيٌّ وَحَقِّ اللهِ لَيسَ لَهُ","أصلٌ فَلاَ تُخزِنَا بِذَاكَ إخزَاءَ",16,"ا",2,0],["قالوا دمشق ينبيك الخبير بها","ثم ائت مصر فثم النائل العمم",17,"م",1,0],["قالواْ : دَعُوهُ فإنّهُ مُتَجَنِّنُ","لاَ تَظلمُوهُ بقَولِكُم مُتَصَهْيِنُ..!!!",18,"ن",1,1],["قالوا دمشق فقلت الخير يسكنها","يا دار صحبي وخير الناس امثالأ",19,"ل",2,0],["قالوا: دَعِ الشِّعْرَ للمجنُونِ يكتُبُهُ","واذهبْ إلى الغاب يَاذَا واجمَعِ الحَطَبَا",20,"ب",2,0]]}