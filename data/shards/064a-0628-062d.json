{"poems":[[39,"يبحث الترب عن كوارع في المشرب","https://www.aldiwan.net/poem7074.html","الخفيف"],[31,"لقد غدوت على الندمان لا حصر","https://www.aldiwan.net/poem6163.html","البسيط"],[108,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[213,"غار مثل النجم من خلف البحور","https://www.aldiwan.net/poem26480.html","عموديه"],[463,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[510,"الأجير","https://www.aldiwan.net/poem56765.html","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125918","السريع"],[4984,"صلابة الرأي","https://www.poetsgate.com/ViewPoem.aspx?id=191136",""],[5701,"كم فيلسوف ركب الت","https://www.poetsgate.com/ViewPoem.aspx?id=164634",""],[5839,"عاشق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=62053",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["يبحث الترب عن كوارع في المشرب","لا تجشم السقاة الصفيرا",0,"ر",2,1],["يَبحَثُ الأَحساءَ مِن ظَبيٍ وَقَد عَلِمَت","مِن حَيثُ يُفرِغُ فيهِ ماءَهُ الوَعِرُ",1,"ر",1,0],["يبحثُ حسنُها عن العيونِ","لا بمُخَدَّر، ولا مصُونِ",2,"ن",1,0],["يبحث الفكر فيكبو دونها","ولذا يتعب ارباب الشعور",3,"ر",1,0],["يُبحن السُّرى أظهراً في الحبا","ل شامخةً ورقاباً خضوعا",4,"ع",2,0],["يبحث في الانبياء علّه يجدُ","اسم النبيّ الذي أضاعهُ السندُ!",5,"د",1,0],["يبحث عن صدر اذا ضمه","أباد جيش الموت من صدره",6,"ر",2,0],["يبحث عن أحلامه في الدجى","كم في هراء الشعر من رتق",7,"ق",1,0],["يبحث عنه في الصبا","حِ والمساء ما هدأ",8,"ا",1,0],["يبحثُ عنْ خلٍّ أرّقهُ","عنْ طيفِ حبيبٍ ذابَ نقا",9,"ق",2,0],["يَبْحَثُونَ الحُلُولَ حَلاًّ فَحَلاًّ","وَيَرُوغُونَ دُونَ حَلِّ الحُلُولِ",10,"ل",1,0]]}