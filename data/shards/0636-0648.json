{"poems":[[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"ضوءا حين أومضا","https://www.aldiwan.net/poem30170.html","مجزوء الخفيف"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[5,"جلبنا الخيل من جنبي أَريكٍ","https://www.aldiwan.net/poem295.html",""],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[38,"ولم أر معقورا به وسط معشر","https://www.aldiwan.net/poem7708.html","الطويل"],[78,"ثلاثة منعتها عن زيارتنا","https://www.aldiwan.net/poem14011.html","البسيط"],[62,"ضيف سرى والليل ينفض صبغه","https://www.aldiwan.net/poem52365.html","الكامل"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"حاجة ذا الحيران أن ترشده","https://www.aldiwan.net/poem63481.html","البسيط"],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[45,"خيال ملم أم حبيب مسلم","https://www.aldiwan.net/poem65652.html","الطويل"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[7,"أهاجك من أسماء رسم المنازل","https://www.aldiwan.net/poem1978.html","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6805","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55058","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[45,"خيَالٌ مُلِمٌّ، أو حَبيبٌ مُسَلِّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=32021",""]],"verses":[["ضَوامِرَ مِن طولِ الوَجيفِ كَأَنَّها","ذَوائِبُ نَبتٍ طامَنَت لِذُبولِ",0,"ل",1,0],["ضَوَّءا حينَ أَومَضا","مَنبِتَ الرَملِ وَالغَضا",1,"ض",2,1],["ضَوءٌ تَشَعشَعَ في سَوادِ ذَوائِبي","لا أَستَضيءُ بِهِ وَلا أَستَصبِحُ",2,"ح",1,0],["ضَوامِرَ خوصاً قَد أَضَرَّ بِها السُرى","وَطابَقنَ مَشياً في السَريحِ المُخَدَّمِ",3,"م",1,0],["ضَوامِرَ كِالقِداحِ تَرى عَلَيه","يَبيسَ الماءِ مِن حُوٍّ وَشُقرِ",4,"ر",1,0],["ضَوَّعتُ فيكم كل مشمولة","لكنني من مسككُمْ دُفْتُها",5,"ت",3,0],["ضُوعِفَ الليْلُ في الكثافةِ والطُّو","لِ عليه بِمُرْجَحِنٍّ رُكام",6,"م",1,0],["ضَوارِبُ بِالأَذقانِ مِن ذي شَكيمَةٍ","إِذا ما هَوى كَالنَيزَكِ المُتَوَقِّدِ",7,"د",1,0],["ضَوءُ الجَبينِ وَوسواسُ الحَلي وَما","تَحوي مَعاطِفُها مِن عَنبَر عَبِق",8,"ق",1,0],["ضوءٌ كما صَبَّ الغزالةُ ذوبَها","يُطْفِي تلاحُقَ نورِها الفيَّاضِ",9,"ض",1,0],["ضوامِنُ أن تشقَى الغُمودُ بحَدِّها","إِذا سلِمت منها الطُّلى والعراقيبُ",10,"ب",1,0],["ضَوءٌ لَو اَنَّ الفَلَكَ اِزدادَ في","أَنجُمِهِ مِنهُ لَما أَنفَدَه",11,"د",2,0],["ضَوارِبُ في الآفاقِ لَيسَ بِبارِحٍ","بِها مِن مَحَلٍّ أَوطَنَتهُ اِرتِحالُها",12,"ل",3,0],["ضَوامِنُ لِلحَجاتِ إِمّا شَوافِعاً","مُشَفَّعَةً أَو حاكِماتٍ تُحَكَّمُ",13,"م",1,0],["ضوضاؤُهُ زجلُ الحديد وإنما","يتوعد الأعداء في ضوضائه",14,"ا",3,0],["ضَوءٌ مِنَ النارِ وَالظَلماءِ عاكِفَةٌ","وَظُلمَةٌ مِن دُخانٍ في ضُحىً شَحِبِ",15,"ب",1,0],["ضَوارِبَ بِالأَيدي وَراءَ بَراغِزٍ","حِسانٍ كَآرامِ الصَريمِ الخَواذِلِ",16,"ل",1,0],["ضَوامِرَ كِالقِداحِ تَرى عَلَيها","يَبيسَ الماءِ مِن حُوٍّ وَشُقرِ",17,"ر",1,0],["ضَوَارِبُ فِي العَنَانِ مُسَيَّرَات","بِأَنْفَاسٍ دَوَائِبِ الاحْتِراقِ",18,"ق",1,0],["ضَواحِكُ أَزهارٍ وَأَعيُنُ نَرجِسٍ","أَشارَت بِأَلحاظٍ إِلَيَّ مِراضِ",19,"ض",1,0],["ضوء عينيك أم هم نجمتان","كلهم لا يرى وأنت تراني",20,"ي",1,1],["ضوء عينيك أم حوار المرايا","أم هما طائران يحترقان",20,"ن",1,0],["ضَوَامِنُ للحاجاتِ، إمّا شَوَافِعاً","مُشَفَّعَةً، أوْ حاكمَاتٍ تُحَكَّمُ",21,"م",1,0]]}