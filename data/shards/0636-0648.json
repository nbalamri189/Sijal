51,"سؤال الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=202130",""],[5431,"أهواه ملتحما...بالروح ينصهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=186938",""],[5431,"ماروته شهرذاد...","https://www.poetsgate.com/ViewPoem.aspx?id=202447",""],[5525,"لا تعقد الحبل","https://www.poetsgate.com/ViewPoem.aspx?id=7191",""],[2110,"ضوء الأهلة أم برق الحمى ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=156277",""],[5770,"يا جيرةَ الحرمِ المكيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=178684",""],[5791,"حيود في نسق المحبرة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208644",""],[3976,"نعى ناعياً ليلى عشياً فراعني","https://www.poetsgate.com/ViewPoem.aspx?id=186543",""],[5956,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=194897",""],[6124,"والتينُ والزيتونُ","https://www.poetsgate.com/ViewPoem.aspx?id=109751",""],[6131,"فراشَةُ الفَجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=189286",""],[6144,"عزرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=21837",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""]],"verses":[["ضَوامِرَ مِن طولِ الوَجيفِ كَأَنَّها","ذَوائِبُ نَبتٍ طامَنَت لِذُبولِ",0,"ل",1,0],["ضَوَّءا حينَ أَومَضا","مَنبِتَ الرَملِ وَالغَضا",1,"ض",2,1],["ضَوءٌ تَشَعشَعَ في سَوادِ ذَوائِبي","لا أَستَضيءُ بِهِ وَلا أَستَصبِحُ",2,"ح",1,0],["ضَوامِرَ خوصاً قَد أَضَرَّ بِها السُرى","وَطابَقنَ مَشياً في السَريحِ المُخَدَّمِ",3,"م",1,0],["ضَوامِرَ كِالقِداحِ تَرى عَلَيه","يَبيسَ الماءِ مِن حُوٍّ وَشُقرِ",4,"ر",1,0],["ضَوَّعتُ فيكم كل مشمولة","لكنني من مسككُمْ دُفْتُها",5,"ت",3,0],["ضُوعِفَ الليْلُ في الكثافةِ والطُّو","لِ عليه بِمُرْجَحِنٍّ رُكام",6,"م",1,0],["ضَوارِبُ بِالأَذقانِ مِن ذي شَكيمَةٍ","إِذا ما هَوى كَالنَيزَكِ المُتَوَقِّدِ",7,"د",1,0],["ضَوءُ الجَبينِ وَوسواسُ الحَلي وَما","تَحوي مَعاطِفُها مِن عَنبَر عَبِق",8,"ق",1,0],["ضوءٌ كما صَبَّ الغزالةُ ذوبَها","يُطْفِي تلاحُقَ نورِها الفيَّاضِ",9,"ض",1,0],["ضوامِنُ أن تشقَى الغُمودُ بحَدِّها","إِذا سلِمت منها الطُّلى والعراقيبُ",10,"ب",1,0],["ضَوءٌ لَو اَنَّ الفَلَكَ اِزدادَ في","أَنجُمِهِ مِنهُ لَما أَنفَدَه",11,"د",2,0],["ضَوارِبُ في الآفاقِ لَيسَ بِبارِحٍ","بِها مِن مَحَلٍّ أَوطَنَتهُ اِرتِحالُها",12,"ل",3,0],["ضَوامِنُ لِلحَجاتِ إِمّا شَوافِعاً","مُشَفَّعَةً أَو حاكِماتٍ تُحَكَّمُ",13,"م",1,0],["ضوضاؤُهُ زجلُ الحديد وإنما","يتوعد الأعداء في ضوضائه",14,"ا",3,0],["ضَوءٌ مِنَ النارِ وَالظَلماءِ عاكِفَةٌ","وَظُلمَةٌ مِن دُخانٍ في ضُحىً شَحِبِ",15,"ب",1,0],["ضَوارِبَ بِالأَيدي وَراءَ بَراغِزٍ","حِسانٍ كَآرامِ الصَريمِ الخَواذِلِ",16,"ل",1,0],["ضَوامِرَ كِالقِداحِ تَرى عَلَيها","يَبيسَ الماءِ مِن حُوٍّ وَشُقرِ",17,"ر",1,0],["ضَوَارِبُ فِي العَنَانِ مُسَيَّرَات","بِأَنْفَاسٍ دَوَائِبِ الاحْتِراقِ",18,"ق",1,0],["ضَواحِكُ أَزهارٍ وَأَعيُنُ نَرجِسٍ","أَشارَت بِأَلحاظٍ إِلَيَّ مِراضِ",19,"ض",1,0],["ضوء عينيك أم هم نجمتان","كلهم لا يرى وأنت تراني",20,"ن",2,1],["ضوء عينيك أم حوار المرايا","أم هما طائران يحترقان",20,"ن",1,0],["ضَوَامِنُ للحاجاتِ، إمّا شَوَافِعاً","مُشَفَّعَةً، أوْ حاكمَاتٍ تُحَكَّمُ",21,"م",1,0],["ضويؤك أم بريقات وهذا","سويقك أم جذيع من نخيل",22,"ل",1,0],["ضَوؤُهُ سَيفُهُ إِذا حُشَّ لِلمُت","رَفِ تَحتَ الدُجى الذُبالُ السَليطُ",23,"ط",1,0],["ضوامر من طول السرى برّحت بها","البرى وبراها الحثّ من كل موجف",24,"ف",1,0],["ضَوءُ نَهاري بَعدَكُم","مِثلَ اللَيالي مُعتِمُ",25,"م",1,0],["ضوامر تطوي لقاء أضالعا","على سغب والبيد يطويه ظلعها",26,"ع",3,0],["ضوامر أرمى الشأو عنها ضامر","ينال بأيديه الأهلة واثبا",27,"ب",2,0],["ضَوار ضَوارِبُ أظفارِهَا","تُعِيرُ الظُّبَى رقّةَ المَضْرب",28,"ب",1,0],["ضَواه لإِنشاءِ الكتابة فَاِعتزت","لَه رتبةُ الإنشا اِعتزاء القطا السربِ",29,"ب",1,0],["ضَوابِعُ تَنوي بَيضَةَ الحَيِّ بَعدَما","أَذاعَت بِرَيعانِ السَوامِ المُعَزَّبِ",30,"ب",1,0],["ضوامرٌ تَمْلأُ الأنساعَ إن ظَفِرَتْ","فلا تَجولُ على أثباجِها الوُضُن",31,"ن",1,0],["ضَوَّأَ الكونَ كلَّه","ضاءَ غرباً ومشرقا",32,"ق",2,0],["ضَوامِرُ أَمثالُ القِداحِ يَكُرُّها","عَلى المَوتِ أَبناءُ الحُروبِ فتحرَبُ",33,"ب",1,0],["ضوءُ شعاع لاح في حبهم","يقول للحادي إذا زار ضو",34,"و",1,0],["ضوامن في الحاجاتِ كلَّ بعيدة","وصائل في الآمال كلَّ قطوعِ",35,"ع",1,0],["ضوافياً من فوقِ أعراضِكم","للمُسدِلِ المُرخِي وللساحبِ",36,"ب",1,0],["ضَوءُ نارٍ بَدا لِعَينَيكَ أَم شُب","بَت بِذي الأَثلِ مِن سَلامَةَ نارُ",37,"ر",1,1],["ضواحكٌ وإِنما","يضحكنَ حين تختَلِط",38,"ط",1,0],["ضو مقلةٍ هاروتُ في طَرْفِها","أَمْلَكُ بالطَّرْفِ من الطرف",39,"ف",1,0],["ضوءُ العُقارِ وضوءُ وَجْهكَ مازجاً","ضَوءَ الهلال وضَوءَ برقٍ لامع",40,"ع",1,0],["ضَوؤُها مِن تَحتِهِ بَرقُ السّما","قَد حَكاهُ لامِعاً في الغلَسِ",41,"س",1,0],["ضوضاء تزعج ذهن الساكن الهادى","فعد عنها إلى أرياف بغداد",42,"د",1,1],["ضوء الجبين ووسواس الحليّ وما","يفوح من عرق كالعنبر العبق",43,"ق",1,0],["ضَؤُلَ الذهْنُ وَلَكِنْ مَدحكم","يُلبِسُ الخَامِلَ أبهَى الحلَلِ",44,"ل",1,0],["ضوامر تمرق من شُكْمِها","إلى أعاديه مروق السهام",45,"م",1,0],["ضوءُ كلِّ البلادِ زهرُ رُباها","نورُها في محلولكاتِ الزَّمانِ",46,"ن",1,0],["ضَوابح يَعلكنَ الشَكيم كَأَنَّما","غدا رَعيها مِن دُون مَرعى وَمَورده",47,"د",2,0],["ضوء الصابح يُضاهي منه بهجته","وَمن المَكارِم مملأ الأوفاض",48,"ض",1,0],["ضوؤه، إما تلفّتِّ دَدٌ","ورياحينُ فُرادى وزُمَر",49,"ر",1,0],["ضوحوة عيدي يوم أضحى بقربكم","ودمعي بنيل المكرمات قرير",50,"ر",1,0],["ضَوءُ بَرقٍ تَلالا","في الدَياجي خِلالا",51,"ا",1,0],["ضوء ذَاكَ المقام يَزداد وَمضا","قَد سَرى في الوُجود طولاً وَعَرضا",52,"ض",2,1],["ضوارينا شأنكن النهود","لهن فهن إلينا يكنه",53,"ن",2,0],["ضوامُره من بعد ذاكَ سرتْ به","برسم اعتمارِ ثم صدّت عوارض",54,"ض",1,0],["ضوا نحوه أصحابُه يوم ذلكم","على بيعة الرضوان والعزم ناهض",54,"ض",1,0],["ضَوامِرَ قَد شَفَّهُنَّ الوَجي","فُ يُثِرنَ العَجاجةَ دونى صِفافا",55,"ف",2,0],["ضوء تشعشع وهو أسود سافع","تالله ما ذاك الضياء بمرتضى",56,"ض",2,0],["ضوعت نشر الجود في راح السخا","فدنا وكان عن البرية معرضا",56,"ض",2,0],["ضؤلتِ سراجاً يا شموس إذا خبا","سراجي وليلي قاتم الجنح أليل",57,"ل",1,0],["ضواحي الوغى أعلامُهُ ظُلَّةٌ بها","ويا لعقابٍ فوقَ رأسِهِم انقضا",58,"ض",2,0],["ضَوامِرَ كَالقِداح تَجِدُّ وَخداً","إلى مَغنى المَعالي وَالجَلالِ",59,"ل",1,0],["ضوامر من بنات الكوم كوم","كبت عن نيل غابتها الشمال",60,"ل",1,0],["ضوَّءتَ في رأس الرواسي