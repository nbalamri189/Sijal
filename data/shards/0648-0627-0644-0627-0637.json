{"poems":[[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21019","الخفيف"],[369,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56404","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137930",""],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96028","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83547","الوافر"],[4797,"تالي عصير","https://www.poetsgate.com/ViewPoem.aspx?id=29435",""],[5186,"الروح والريحانة الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=156506",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[6102,"منة","https://www.poetsgate.com/ViewPoem.aspx?id=185063",""],[6115,"الاطرش بهذا الوقت ذرب وفصيح لسان","https://www.poetsgate.com/ViewPoem.aspx?id=196464",""]],"verses":[["وَالأَطيَبينَ الأَكرَمي","نَ الأَفضَلينَ لَدى التَفاضُل",0,"ل",1,0],["والأَطِباءُ بَعدَهُم لَحِقُوهُم","ضَلَّ عَنهُم سَعُوطُهُم واللَّدودُ",1,"د",1,0],["والأَطْولينَ إلى فَرْعِ العلاء يَداً","والأبعدِينَ إلى شَأْوِ الكرامِ خُطا",2,"ط",2,0],["والاطمنان على اعتدال مزاجكم","ذاك اللطيف وطيب تلك الصحة",3,"ه",1,0],["والاَّ طمَّني غرقاً وذيل ال","دمارِ عليَّ ثم عليكِ جرا",4,"ر",2,0],["وإلا طلا تبرى ومعتقلاً يرى","وسابغة تفرى وعضب تفلل",5,"ل",1,0],["وَإِلّا طِرتُ في البيدا إليها","عَلى اِسم اللَهِ طيرانا غَريبا",6,"ب",2,0],["وإلا طرالي واحد كانه اصغير ..",".. أم أصغر بيومين ولا سنيني",7,"ن",2,0],["والأطوعان لأمره، والأصفرا","ن لنهيه والأطهران فداء",8,"ا",2,0],["و(الاطلس ) الحر في ابطاله ظهرت","خوارق لهمو منها سرابيل",9,"ل",1,0],["وَ الأَطِبَّاءُ حَولَنا فِي هَياجٍ","وَ الطَّبِيباتُ - حَيرَةً - حَسبُهُنَّهْ",10,"ن",2,0],["والاطرش بهذا الوقت ذرب وفصيح لسان","وينقد ويشرح والغوامض يفسرها",11,"ر",3,0]]}