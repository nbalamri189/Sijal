ن أسيافنا العضاب الدوامي","جعلت ملكنا قديم الدوام",154,"م",1,1],["أُناسٌ حاوَلوا ما أنتَ فيه","وما سَلَكوا طريقك واستقاموا",155,"م",3,0],["أُناساً يعيشُ الحرُّ فيهم منغَّصاً","ولي كلمات فيه تصدعُ الحصا",156,"ص",2,0],["إنَّ أسلافكم إذا خطبوها","جعلوا مهرها قناً ونصولا",157,"ل",2,0],["أناس حكوا زهر النجوم وصاحبي","بموكبهم بدر فيا سعد من رعى",158,"ع",2,0],["إِن أَسكروني بخمرِ لَوْمِهِمُ","فَقَدْ رَمَوْا عِرْضَهُمْ لِعِرْبيدِ",159,"د",1,0],["إن استقامَ فاستقِمْ كفِعلِه","وإن أبى فأْبَ إذاً كما أبى",160,"ا",1,0],["إن أسقَتْهُ الليالي بعدَ صحّتهِ","فهو الدّواءُ لمن أعيى تَداويهِ",161,"ي",2,0],["إن اسوداد مغارقي لوسيلة","عند المها للقرب والتسليم",162,"م",1,0],["أناسُ زكت أحلامهم وأصولهم","فأفعالهم في جبهة الدهر تشرقُ",163,"ق",1,0],["أنا سامني سوم العذاب لك الجوى","من ذا يعنفني إذا ما سامني",164,"ن",2,0],["أناس قد ملكناهم","ببلف غير محتشم",165,"م",1,0],["إنا سئمنا الدعاوى كم حمت مرضا","وكم حمت غرضا بين الأضاحيك",166,"ك",1,0],["أناسئُهُ الثناءَ ليوم عُسرِي","وكم وجدَ القضاءَ فما قضاني",167,"ن",2,0],["أناس أجموا أنفساً عن كريهةٍ","وصانوا رخيِّاً بالوهينة مُودعا",168,"ع",2,0],["أُناسٌ زَهرُ جودِهِمُ العَطايا","وَنَبَت رِياضُ رَأيِهُمُ السَدادُ",169,"د",1,0],["أناسٌ نأوا عنِّي فها أتا بعدَهمْ","أجوبُ الفيافي منفذاً بعدَ منفذِ",170,"ذ",1,0],["أُناسٌ جفونا والديارُ قريبةٌ","عليه محبٌّ في الغرامِ غريبُ",171,"ب",1,0],["أناس مضى صدر من العمر عندهم","أصعد ظني فيهم وأصوب",172,"ب",1,0],["أناسٌ يا بنَ وُدّي كُلّ فَرْدٍ","بذُلِّ الأَسْرِ في التّقْلِيدِ عَاني",173,"ن",2,0],["أُناسٌ فأما البخلُ فهو حياتُهم","وَيقضي الذي منهم يَرومُ تَكرُّما",174,"م",2,0],["أُناسٌ أَصلُنا منهم","ودِنّا كالذي دانوا",175,"ن",3,0],["إِنَّ إِسماعيلَ مَن يَفخَر بِهِ","يُلفَ في دارٍ بِها حَلَّ الفَخارُ",176,"ر",1,0],["أُناسٌ لا يبالون المنايا","ونارُ الحربِ ساطعةُ الدُّخانِ",177,"ن",1,0],["أُناساً يدارون سُقْمَ السّقيم","ومن أجلِهِمْ دَبَّ ذاك السَّقَمْ",178,"م",1,0],["أُناسٌ يخوضون الرّدى وأكفُّهمْ","تهزّ أنابيبَ القِنيِّ الرّواعفِ",179,"ف",1,0],["إن أسْخَطِ الأمرَ أُدركْ عنه مُضطَرَباً","وإِنْ أُرِدْ بَدَلاً من مذهبٍ أجِدِ",180,"د",1,0],["ان استعارة قلبي في الهوى حرقت","ثوب السلو فعشقي ثابت القدم",181,"م",1,0],["أنا ساع في هدم كل بناء","دون مرأى حقيقتي المبحوت",182,"ت",1,0],["أُناسٌ كلُّها تُمسي تُرابا","بدارٍ كلُّها تُمسي خَرابا",183,"ب",2,1],["أُنَاسٌ أَعْرَضُوا عَنَّا","بِلاَ جُرْمٍ وَلاَ مَعْنَى",184,"ن",2,1],["إِن استكثروا الملكَ الذي يستقِلُّه","فغيرُ كثيرٍ ملكُه الأَرضَ وحدَه",185,"د",2,0],["أُناسٌ دَبّت الأَعلالُ فيهم","وليس لهم كسيفك من طبيب",186,"ب",1,0]]}