],[28,"إني وإن كانت تميم عمارتي","https://www.aldiwan.net/poem5528.html","الطويل"],[28,"لقد كدت لولا الحلم تدرك حفظتي","https://www.aldiwan.net/poem5587.html","الطويل"],[99,"يد","https://www.aldiwan.net/poem5809.html","عموديه"],[58,"ولما رأيت الخيل تقرع بالقنا","https://www.aldiwan.net/poem30881.html","الطويل"],[49,"كل إلى الرحمن منقلبه","https://www.aldiwan.net/poem10384.html","السريع"],[49,"إن استتم من الدنيا لك الياس","https://www.aldiwan.net/poem62128.html","البسيط"],[49,"إن أسوا يوم يمر عليا","https://www.aldiwan.net/poem63200.html","البسيط"],[66,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[80,"لعمري لقد ظنوا الظنون وأيقنوا","https://www.aldiwan.net/poem31560.html","الطويل"],[44,"ألم يأن أن تروى الظماء الحوائم","https://www.aldiwan.net/poem30365.html","الطويل"],[87,"تصابيت بعد الحلم واعتادني زهوي","https://www.aldiwan.net/poem8193.html","الطويل"],[69,"أنا سني وحالي","https://www.aldiwan.net/poem28158.html","مجزوء الرمل"],[69,"إن استوى في العلم قوم فقد","https://www.aldiwan.net/poem28604.html","السريع"],[69,"أناس ما استطعت لهم سلوا","https://www.aldiwan.net/poem28752.html","الوافر"],[31,"لقد أرسلت في السر ليلى بأن أقم","https://www.aldiwan.net/poem42021.html","الطويل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[81,"قل لمن أسهر بالعين الجفون","https://www.aldiwan.net/poem61468.html","الرمل"],[102,"أنا ساعة الرجل الصبور","https://www.aldiwan.net/poem33054.html","مجزوء الكامل"],[102,"أنا ساعة الرجل العتيد","https://www.aldiwan.net/poem33057.html","مجزوء الكامل"],[102,"أنا ساعة النفس الأبيه","https://www.aldiwan.net/poem33059.html","مجزوء الكامل"],[40,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"إن اسم حسن لوجهها صفة","https://www.aldiwan.net/poem64381.html","المنسرح"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[50,"خليلي ما بال الدجى لا تزحزح","https://www.aldiwan.net/poem63979.html","الطويل"],[46,"نصحتك أجسام البرية أجناس","https://www.aldiwan.net/poem22781.html","الطويل"],[46,"صدقتك صاحبي لا مال عندي","https://www.aldiwan.net/poem22986.html","الوافر"],[46,"أخفت حلوم الناس أم كان من مضى","https://www.aldiwan.net/poem23368.html","الطويل"],[46,"يا أمة في التراب هامدة","https://www.aldiwan.net/poem23433.html","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202707","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9959","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/19803","الطويل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141961","الطويل"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[106,"تقليد","https://www.poetsgate.com/ViewPoem.aspx?id=179377",""],[100,"أثيم الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50095",""],[90,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[45,"سَفَاهَاً تَمَادَى لَوْمُهَا وَلَجاجُها","https://www.poetsgate.com/ViewPoem.aspx?id=32942",""],[45,"وَكانَ الشَّلْمَغانُ أبَا مُلُوكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31664",""],[35,"أمِن آلِ سَلْمى دِمنَة ٌ بالذنَّائِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=21920",""]],"verses":[["أُناسيهِمُ بَغضاءَهُم غَيرَ غافِلٍ","وَأَسأَلُهُم مَعروفَهُم غَيرَ راغِبِ",0,"ب",1,0],["أَناسِيَةٌ ما كانَ بَيني وَبينَها","وَقاطِعَةٌ حَبلَ الصَفاءِ ظَلومُ",1,"م",1,1],["أنا سَعْدُ السّعودِ في كَفِّ مَوْلا","يَ وإنْ قيلَ فيَّ سَعْدُ الذّابِحْ",2,"ح",1,0],["أُناسٌ إِذا شَهِدوا غارَةً","يَكونونَ ضِدّاً لِأَندادِها",3,"د",3,0],["إِنّا سَمِعنا عَنكَ ما قَد رابَنا","وَأَطالَ فيكَ وَفي هَواكَ اللُوَّمُ",4,"م",1,0],["إِنّا سَنَعمَلُ لِلخَلاصِ وَلا نَني","وَاللَهُ يَقضي بَينَنا وَيُديلُ",5,"ل",1,0],["أُناساً أَعدُ الغَدرَ مِنهُم بِذِمَّتي","وَفاءً وَأَلقى كُلَّ ما ساءَني حَسَن",6,"ن",1,0],["أُناسٌ هُمُ أَخشى لِلَذعَةِ مِقوَلي","إِذا لَم يَكُن مِمّا فَعَلتَ لَهُم مُضرِ",7,"ر",1,0],["أَنا سَيفُكَ الصَدِئُ الَّذي مَهما تَشَأ","تُعِدِ الصِقالَ إِلَيهِ وَالتَذريبا",8,"ب",2,0],["إِن أَساءَ الزَمانُ أَحسَنَ دَأباً","مِثلَما بايَنَ النَقيضَ النَقيضُ",9,"ض",1,0],["أُناسٌ أَصَدّوا الناسَ بِالضَربِ عَنهُمُ","صُدودَ السَواقي مِن أُنوفِ المَخارِمِ",10,"م",1,0],["أُناسٌ أَهلَكوا الرُؤَسآءَ قَتلاً","وَقادوا الناسَ طَوعا وَاِعتِسارا",11,"ر",2,0],["أُناسٌ إِن نَظَرتَ رَأَيتَ مِنُهم","وَرآءَ حِمايَ أَطوادا كِبارا",11,"ر",2,0],["إن أسمعت ألسن الأقلام ظالمها","بعضَ الصرير كمن يبكي وينظلم",12,"م",1,0],["إن أسينا أسىً عليه كثيراً","فكثير الأسى عليه قليل",13,"ل",1,0],["أُناسٌ يَنبُتونَ بِشَرِّ بَذرٍ","وَبَذرُ السوءِ يوجَدُ في الحَصادِ",14,"د",1,0],["أُناساً يَخالونَ العَباءَةَ فيهِمُ","قَطيفَةَ مِرعِزّى يُقَلَّبُ نيرُها",15,"ر",3,0],["إِنَّ اِستَهُ مِن بَرَصٍ مُلَمَّعَه","وَإِنَّهُ يُدخِلُ فيها إِصبَعَه",16,"ع",2,0],["أناس إذا وردت بحرهم","صوادي العرائب لم تُضْرَبِ",17,"ب",1,1],["أُناس بِهِم عَزَّت قُرَيشٌ فأصبَحُوا","وفيهِم خِبَاءُ المَكرُمَاتِ المُطَنَّبُ",18,"ب",1,0],["أُناسٌ إذا وَرَدَت بَحرَهُم","صَوَادِي الغَرَائِبِ لم تُضرَبِ",19,"ب",1,0],["أُناسٌ هُمُ مِن قَومِهِم في صَميمِهِم","بِمَنزِلَةِ الزِمعانِ دُبرِ القَوادِمِ",20,"م",1,0],["إن أساءَ الحبيبُ قامت بعذرٍ","وجنةٌ منه فوق شامات",21,"ت",1,1],["إن استعبدت قلبي فنظمي على الورى","بمدح الإمام المالكيّ مملك",22,"ك",1,0],["أُناس كلُّهم فَرْدٌ","وسوآتُهُمُ مَثْنَى",23,"ن",2,0],["أُناسٌ متى ساءلت نَافَس حظَّهمْ","بأيَّامهم في الجود والبأس بَخْبَخَا",24,"خ",2,0],["إن أَسْرِقِ الشعراءَ شعْرَهُمُ","فجزاءُ ما سَرقُوا من المجدِ",25,"د",1,1],["أن إسماعيل يهدي","هدي إسماعيل صدقا",26,"ق",2,0],["أناسٌ يسوسُون البلادَ وأهلها","بشدَّةِ أركانٍ ولينِ عرائك",27,"ك",1,0],["أناسٌ إذا علُّوا رأوا أن علَّهم","عُفاتَهمُ تلك الفواضلَ إنهالُ",28,"ل",1,0],["إنَّ إسماعيل قِرْدٌ مجرمٌ","إن سقاني دَمَهُ اللَّهُ شفاني",29,"ن",2,1],["إن إسماعيل فاعلم","كاتبٌ ذو قلمين",30,"ن",1,1],["إِنّا سَنَبقى بَعدَ أَن يَمضي الوَرى","وَيَزولُ هَذا العالَمُ المَنظورُ",31,"ر",1,0],["إِن اِستَهلَّت بِالدِماءِ مُدَّتُه","فَما وَقاها الهَيج إِلّا شِدتُه",32,"ه",1,0],["أُناسٌ كَما تَدري وَدُنيا بِحالِها","وَدَهرٌ رَخِيٌّ تارَةً وَعَسيرُ",33,"ر",1,0],["إِن أَسَأنا لَكُمُ أَو لَم نُسِئ","نَحنُ هَلكى فَلَكُم طولُ البَقاء",34,"ا",2,0],["أُناسٌ إِذا لاقَوا عِدىً فَكَأَنَّما","سِلاحُ الَّذي لاقَوا غُبارُ السَلاهِبِ",35,"ب",1,0],["إِنِ اِستَجرَأتَ تَرمُقُهُ بَعيداً","فَأَنتَ اِسطَعتَ شَيئاً ما اِستُطيعا",36,"ع",2,0],["إِنِ اِستَحسَنتَ وَهوَ عَلى بِساطٍ","فَأَحسَنُ ما يَكونُ عَلى الرِجالِ",37,"ل",1,0],["إِنِ اِستَرفَدتُهُ فَخَليجُ بَحرٍ","أَوِ اِستَنهَضتُهُ فَسَليلُ غابِ",38,"ب",1,0],["أُناسٌ قَديمُ المَكرُماتِ وَجَدتُها","لَهُم وَسَريرُ العُجمِ فيهِم وَتاجُها",39,"ج",3,0],["أُناسٌ لَو تَأَمَّلَهُم لَبيدٌ","بَكى الخَلفَ الَّذي يَشكو لَبيدُ",40,"د",1,0],["إِن أَسخَطِ الهَجرَ لا أَرجِع إِلى بَدَلٍ","مِنهُ وَإِن أَطلُبِ السُلوانَ لا أَجِدِ",41,"د",1,0],["أُناسٌ بَيتُ سُؤدُدِهِم مَطافُ ال","مَعالي وَاِسمُ نائِلِهِم جَزيلُ",42,"ل",1,0],["إِن أُسقِيَتهُ فارِسٌ فَبِعَقبِ ما","ظَمِأَت جَوانِبُ رَبعِها الحَرّانِ",43,"ن",1,0],["أُناسٌ لا صَلاتُهُمُ لِماني","تُقامُ وَلا نَبِيُّهُمُ بنُ بايا",44,"ا",3,0],["إِن أَستَطِع مِنكَ الدُنُوِّ فَإِنَّني","سَأَدنو بِأَشلاءِ الأَسيرِ المُقَيَّدِ",45,"د",1,1],["أُناسٌ لَهُم عادِيَّةٌ يُهتَدى بِها","لَهُم مِرفَدٌ عالٍ عَلى كُلِّ مِرفَدِ",46,"د",1,0],["أُناسٌ تُراخي الكَربَ عَنهُم سُيوفُهُم","إِذا كانَتِ الأَنفاسُ عِندَ الحَناجِرِ",47,"ر",1,0],["إِنَّ اِستِراقَكَ يا جَريرُ قَصائِدي","مِثلُ اِدِّعاءِ سِوى أَبيكَ تَنَقَّلُ",48,"ل",1,1],["أُناسٌ إِذا ما الكَلبُ أَنكَرَ أَهلَهُ","أَناخوا فَعاذوا بِالسُيوفِ الصَوارِمِ",49,"م",1,0],["أُناسٍ بِثَغرٍ ما تَزالُ رِماحُهُم","شَوارِعَ مِن غَيرِ العَشيرَةِ في الدَمِ",50,"م",1,0],["أنا ساهر .. ومعي يد امرأة","بيضاء .. هل اشهى وهل أطيب؟",51,"ب",1,0],["أَناسٌ يُحِبّونَ النَبيَّ وَرَهطَهُ","سِراعٌ إِلى الهَيجاءِ غَيرَ كَهامِ",52,"م",1,0],["إِنَّ اِستَهانَتَها بِمَن صَرَعَت","لَبِقَدرِ مَن تَسمو بِهِ رُتَبُه",53,"ب",2,0],["إِنِ اِستَتَمَّ مِنَ الدُنيا لَكَ الياسُ","فَلَن يَغُمَّكَ لا مَوتٌ وَلا ناسُ",54,"س",1,1],["إِنَّ أَسوا يَومٍ يَمُرُّ عَلَيّا","يَومُ لا رُغبَةٌ تَكونُ إِلَيّا",55,"ي",2,1],["إِن أَسَأنا لَم يَرُعنا بِلَومٍ","وَإِذا لُمناهُ أَبدى اِحتِمالا",56,"ل",2,0],["إِنَّ أَسبابَ فاصِلاتِ المَنايا","قَد أَبادَت فِرعونَ ذا الأَوتادِ",57,"د",1,0],["أناسٌ رأوْا مني مخادعةَ الهَوى","أشدّ عليهم مِن مخادَعَةِ الحرْبِ",58,"ب",1,0],["أُناسٌ إِذا راحوا إِلى الرَوعِ لَم تَرُح","مُسالِمَةً أَسيافُهُم وَالجَماجِمُ",59,"م",1,0],["أُنَاسٌ إِذَا مَا أَجْمَعُوا الأَمْرَ أَصْبَحُوا","وَمَا هُمْ بِنَظَّارِينَ لِلْغَيْمِ وَالصَّحْوِ",60,"و",1,0],["أنا سنيٌّ وحالي","بالإماميَّةِ خالِ",61,"ل",1,1],["إنِ استوى في العلمِ قومٌ فقدْ","تختلفُ النياتُ والقلبُ",62,"ب",1,1],["أُناسٌ ما استطعتُ لهم سلُوّاً","ولا عتباً وليتنيَ استطعتُ",63,"ت",1,1],["أُناسٌ أَمِنّاهُم فَبَثّوا حَديثَنا","فَلَمّا قَصَرنا السَيرَ عَنهُم تَقَوَّلوا",64,"ل",3,0],["إنّا سنأخذُه صحيحاً كاملاً","ونَزيده من صحّةٍ وكمالِ",65,"ل",1,0],["أنَاسٌ هُمُ لِلاَّئِذِين سَواحِلُ","ولِلمُعتَفِي الجَدوى بُحُورٌ خَضارِمُ",66,"م",1,0],["أنَاسٌ هُمُ لِلمُعتَفِينَ نَدَاهُمُ","بُحُورٌ وَلِلمُستَضعَفِينَ سَوَاحِلُ",67,"ل",1,0],["إِن أَساءَ الخِلُّ مِنهُ أَدَباً","فَبِفِرطِ الشَوقِ وَالوَجدِ يَهون",68,"ن",1,0],["أنا ساعةُ الرّجل الصَّبورِ","أنا ساعةُ القلبِ الكبيرِ",69,"ر",1,1],["أنا ساعةُ الرجل العتيدِ","أنا ساعةُ البأسِ الشديدِ",70,"د",1,1],["أنا ساعةُ الموت المشر","رف كلَّ ذي فعلٍ مجيدِ",70,"د",1,0],["أنا ساعةُ النفسِ الأَبيَّه","الفضلُ لي بالأَسبقيَّهْ",71,"ي",2,1],["أُناسٌ امِنّاهُم فَنَثُّوا حَدِيثَنا","فَلَمّا كَ