,"ف",1,0],["أُناسٌ مَتى تَهرُب إِلى القَبرِ مِنهُمُ","فَأَنتَ بِعِلمِ اللَهِ غَيرُ مَلومِ",80,"م",1,0],["إِنِ اِستَرَحتُم مِمّا نُكابِدُهُ","فَنَحنُ مِن بَعدُ في جَرائِرِكُم",81,"م",1,0],["أنا سكرانُ وفي الكأس بقيَّهْ","أيُّ خمر من جَنى الخلد عصرتُ",82,"ت",1,0],["إن أسأنا إليك فاليوم يجزي","كَ بما ذُقتَه رِضىً وسماحُ",83,"ح",1,0],["أنا سهران على عهدِ الهوى","لم أنَمْ وهو لعهدي ما وفا",84,"ف",2,0],["أُناسٌ أَنزَلونا في مَكانٍ","مِنَ العَلياءِ فَوقَ النَجمِ يَعلو",85,"و",1,0],["أُنَاسٌ شَرَوْا خِزْيَ الضَّلالَةِ بِالْهُدَى","نِفَاقاً وَبَاعُوا الدِّينَ مِنْهُم بِدَانِقِ",86,"ق",1,0],["إِنْ أَسْعَفْتَنَا سَاعَةٌ مِنْهُ فَقَدْ","أَرْبَتْ بِغِبْطَتِهَا عَلَى التَّخْلِيدِ",87,"د",1,0],["أَناسٌ يَنَالُ الماءَ قَبلَ شِفَاهِهِم","لَهُ وارِداتُ العَرضِ شُمُّ الأَرانِبِ",88,"ب",1,0],["أُناسٌ هُمُ سَنّوا الطَريقَ إِلى العُلا","وَهُم أَعرَبوا عَنها وَقالوا فَأَفصَحوا",89,"ح",3,0],["أنا ساهرٌ والكونُ نامَ","وكلّ ما في الكونِ نام",90,"م",1,1],["أنا ساهر وجبال لبنان","عليها الصمت حام",90,"م",1,0],["أنا ساهرق والسهل في","حضن الطبيعة كالغلام",90,"م",1,0],["أنا ساهر والبحر أخرس","لا هدير ولا احتدام",90,"م",1,0],["إنْ أسعَدَ اللهُ روحي في مَحَبّتِهِ","وجِسْمَهَا بينَ أرواحٍ وأجسام",91,"م",1,0],["إنا سنتخذ الوزير إمامَنَا","من يمشِ خلف خطاه، عاش سعيدا",92,"د",2,0],["أنا سارق الحبّ وحدي ! أنا","خبيث السقا قذر المرتع",93,"ع",1,0],["إن أسأنا إليك فاليوم يجزي","كَ بما ذُقتَه رِضًا وسماحُ",94,"ح",1,0],["إنا سرينا على الأمواجِ تحملنا","وباسْمِكم بعد إسم اللهِ مسرانا",95,"ن",2,0],["أُنَاسٌ، قَديمُ المَكرُمَاتِ وَحَدْثُها لَهُمْ،","وَسَرِيرُ العُجْمِ فيهمْ وَتَاجُها",96,"ج",3,0],["أُناسٌ، لا صَلاتُهُمُ لِمَاني","تُقَامُ، وَلا نَبِيُّهُمُ ابنُ بَايَا",97,"ا",3,0],["أناسٌ يَنَالُ الماءَ قبلَ شِفَاهِهِمْ","لهُ وافراتُ العِرضِ شُمُّ الأرانبِ",98,"ب",1,0],["أنا سرِّى أصونُه عن كبيرٍ","وجهولٍ وعالمٍ وصغيرِ",99,"ر",1,0],["أنا سكرانُ مثله في الهَوى لك","نّه لا تضرُّه سكراتُه",100,"ت",2,0],["أُنَاسٌ في شَنَاشِنِهِم جَفَاءٌ","جَدِيرٌ أن يَجُرَّ لَهُم شَنَانَا",101,"ن",2,0],["أنَاسٌ تَحتَ أخبِيَةٍ صِغَارٍ