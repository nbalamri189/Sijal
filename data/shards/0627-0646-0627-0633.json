],[516,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[530,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[539,"دعوني فإني لا أطيق التكلما","https://www.aldiwan.net/poem47949.html","عموديه"],[544,"أقيدوا القوم إن الظلم لايرضاه ديان","https://www.aldiwan.net/poem1761.html","الهزج"],[544,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[552,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[552,"أقول لصحبي وقد هوموا","https://www.aldiwan.net/poem47189.html","المتقارب"],[552,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[552,"ما خامر الرزق قلبي قبل فجأته","https://www.aldiwan.net/poem47854.html","البسيط"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[559,"بوجودي فغذني يا قوتي","https://www.aldiwan.net/poem34717.html","الخفيف"],[563,"أناس كلها تمسي ترابا","https://www.aldiwan.net/poem52795.html","الوافر"],[568,"أناس أعرضوا عنا","https://www.aldiwan.net/poem69485.html","الهزج"],[576,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[586,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["أُناسيهِمُ بَغضاءَهُم غَيرَ غافِلٍ","وَأَسأَلُهُم مَعروفَهُم غَيرَ راغِبِ",0,"ب",1,0],["أَناسِيَةٌ ما كانَ بَيني وَبينَها","وَقاطِعَةٌ حَبلَ الصَفاءِ ظَلومُ",1,"م",1,1],["أنا سَعْدُ السّعودِ في كَفِّ مَوْلا","يَ وإنْ قيلَ فيَّ سَعْدُ الذّابِحْ",2,"ح",1,0],["أُناسٌ إِذا شَهِدوا غارَةً","يَكونونَ ضِدّاً لِأَندادِها",3,"د",3,0],["إِنّا سَمِعنا عَنكَ ما قَد رابَنا","وَأَطالَ فيكَ وَفي هَواكَ اللُوَّمُ",4,"م",1,0],["إِنّا سَنَعمَلُ لِلخَلاصِ وَلا نَني","وَاللَهُ يَقضي بَينَنا وَيُديلُ",5,"ل",1,0],["أُناساً أَعدُ الغَدرَ مِنهُم بِذِمَّتي","وَفاءً وَأَلقى كُلَّ ما ساءَني حَسَن",6,"ن",1,0],["أُناسٌ هُمُ أَخشى لِلَذعَةِ مِقوَلي","إِذا لَم يَكُن مِمّا فَعَلتَ لَهُم مُضرِ",7,"ر",1,0],["أَنا سَيفُكَ الصَدِئُ الَّذي مَهما تَشَأ","تُعِدِ الصِقالَ إِلَيهِ وَالتَذريبا",8,"ب",2,0],["إِن أَساءَ الزَمانُ أَحسَنَ دَأباً","مِثلَما بايَنَ النَقيضَ النَقيضُ",9,"ض",1,0],["أُناسٌ أَصَدّوا الناسَ بِالضَربِ عَنهُمُ","صُدودَ السَواقي مِن أُنوفِ المَخارِمِ",10,"م",1,0],["أُناسٌ أَهلَكوا الرُؤَسآءَ قَتلاً","وَقادوا الناسَ طَوعا وَاِعتِسارا",11,"ر",2,0],["أُناسٌ إِن نَظَرتَ رَأَيتَ مِنُهم","وَرآءَ حِمايَ أَطوادا كِبارا",11,"ر",2,0],["إن أسمعت ألسن الأقلام ظالمها","بعضَ الصرير كمن يبكي وينظلم",12,"م",1,0],["إن أسينا أسىً عليه كثيراً","فكثير الأسى عليه قليل",13,"ل",1,0],["أُناسٌ يَنبُتونَ بِشَرِّ بَذرٍ","وَبَذرُ السوءِ يوجَدُ في الحَصادِ",14,"د",1,0],["أُناساً يَخالونَ العَباءَةَ فيهِمُ","قَطيفَةَ مِرعِزّى يُقَلَّبُ نيرُها",15,"ر",3,0],["إِنَّ اِستَهُ مِن بَرَصٍ مُلَمَّعَه","وَإِنَّهُ يُدخِلُ فيها إِصبَعَه",16,"ع",2,0],["أناس إذا وردت بحرهم","صوادي العرائب لم تُضْرَبِ",17,"ب",1,1],["أُناس بِهِم عَزَّت قُرَيشٌ فأصبَحُوا","وفيهِم خِبَاءُ المَكرُمَاتِ المُطَنَّبُ",18,"ب",1,0],["أُناسٌ إذا وَرَدَت بَحرَهُم","صَوَادِي الغَرَائِبِ لم تُضرَبِ",19,"ب",1,0],["أُناسٌ هُمُ مِن قَومِهِم في صَميمِهِم","بِمَنزِلَةِ الزِمعانِ دُبرِ القَوادِمِ",20,"م",1,0],["إن أساءَ الحبيبُ قامت بعذرٍ","وجنةٌ منه فوق شامات",21,"ت",1,1],["إن استعبدت قلبي فنظمي على الورى","بمدح الإمام المالكيّ مملك",22,"ك",1,0],["أُناس كلُّهم فَرْدٌ","وسوآتُهُمُ مَثْنَى",23,"ن",2,0],["أُناسٌ متى ساءلت نَافَس حظَّهمْ","بأيَّامهم في الجود والبأس بَخْبَخَا",24,"خ",2,0],["إن أَسْرِقِ الشعراءَ شعْرَهُمُ","فجزاءُ ما سَرقُوا من المجدِ",25,"د",1,1],["أن إسماعيل يهدي","هدي إسماعيل صدقا",26,"ق",2,0],["أناسٌ يسوسُون البلادَ وأهلها","بشدَّةِ أركانٍ ولينِ عرائك",27,"ك",1,0],["أناسٌ إذا علُّوا رأوا أن علَّهم","عُفاتَهمُ تلك الفواضلَ إنهالُ",28,"ل",1,0],["إنَّ إسماعيل قِرْدٌ مجرمٌ","إن سقاني دَمَهُ اللَّهُ شفاني",29,"ن",2,1],["إن إسماعيل فاعلم","كاتبٌ ذو قلمين",30,"ن",1,1],["إِنّا سَنَبقى بَعدَ أَن يَمضي الوَرى","وَيَزولُ هَذا العالَمُ المَنظورُ",31,"ر",1,0],["إِن اِستَهلَّت بِالدِماءِ مُدَّتُه","فَما وَقاها الهَيج إِلّا شِدتُه",32,"ه",1,0],["أُناسٌ كَما تَدري وَدُنيا بِحالِها","وَدَهرٌ رَخِيٌّ تارَةً وَعَسيرُ",33,"ر",1,0],["إِن أَسَأنا لَكُمُ أَو لَم نُسِئ","نَحنُ هَلكى فَلَكُم طولُ البَقاء",34,"ا",2,0],["أُناسٌ إِذا لاقَوا عِدىً فَكَأَنَّما","سِلاحُ الَّذي لاقَوا غُبارُ السَلاهِبِ",35,"ب",1,0],["إِنِ اِستَجرَأتَ تَرمُقُهُ بَعيداً","فَأَنتَ اِسطَعتَ شَيئاً ما اِستُطيعا",36,"ع",2,0],["إِنِ اِستَحسَنتَ وَهوَ عَلى بِساطٍ","فَأَحسَنُ ما يَكونُ عَلى الرِجالِ",37,"ل",1,0],["إِنِ اِستَرفَدتُهُ فَخَليجُ بَحرٍ","أَوِ اِستَنهَضتُهُ فَسَليلُ غابِ",38,"ب",1,0],["أُناسٌ قَديمُ المَكرُماتِ وَجَدتُها","لَهُم وَسَريرُ العُجمِ فيهِم وَتاجُها",39,"ج",3,0],["أُناسٌ لَو تَأَمَّلَهُم لَبيدٌ","بَكى الخَلفَ الَّذي يَشكو لَبيدُ",40,"د",1,0],["إِن أَسخَطِ الهَجرَ لا أَرجِع إِلى بَدَلٍ","مِنهُ وَإِن أَطلُبِ السُلوانَ لا أَجِدِ",41,"د",1,0],["أُناسٌ بَيتُ سُؤدُدِهِم مَطافُ ال","مَعالي وَاِسمُ نائِلِهِم جَزيلُ",42,"ل",1,0],["إِن أُسقِيَتهُ فارِسٌ فَبِعَقبِ ما","ظَمِأَت جَوانِبُ رَبعِها الحَرّانِ",43,"ن",1,0],["أُناسٌ لا صَلاتُهُمُ لِماني","تُقامُ وَلا نَبِيُّهُمُ بنُ بايا",44,"ا",3,0],["إِن أَستَطِع مِنكَ الدُنُوِّ فَإِنَّني","سَأَدنو بِأَشلاءِ الأَسيرِ المُقَيَّدِ",45,"د",1,1],["أُناسٌ لَهُم عادِيَّةٌ يُهتَدى بِها","لَهُم مِرفَدٌ عالٍ عَلى كُلِّ مِرفَدِ",46,"د",1,0],["أُناسٌ تُراخي الكَربَ عَنهُم سُيوفُهُم","إِذا كانَتِ الأَنفاسُ عِندَ الحَناجِرِ",47,"ر",1,0],["إِنَّ اِستِراقَكَ يا جَريرُ قَصائِدي","مِثلُ اِدِّعاءِ سِوى أَبيكَ تَنَقَّلُ",48,"ل",1,1],["أُناسٌ إِذا ما الكَلبُ أَنكَرَ أَهلَهُ","أَناخوا فَعاذوا بِالسُيوفِ الصَوارِمِ",49,"م",1,0],["أُناسٍ بِثَغرٍ ما تَزالُ رِماحُهُم","شَوارِعَ مِن غَيرِ العَشيرَةِ في الدَمِ",50,"م",1,0],["أنا ساهر .. ومعي يد امرأة","بيضاء .. هل اشهى وهل أطيب؟",51,"ب",1,0],["أَناسٌ يُحِبّونَ النَبيَّ وَرَهطَهُ","سِراعٌ إِلى الهَيجاءِ غَيرَ كَهامِ",52,"م",1,0],["إِنَّ اِستَهانَتَها بِمَن صَرَعَت","لَبِقَدرِ مَن تَسمو بِهِ رُتَبُه",53,"ب",2,0],["إِنِ اِستَتَمَّ مِنَ الدُنيا لَكَ الياسُ","فَلَن يَغُمَّكَ لا مَوتٌ وَلا ناسُ",54,"س",1,1],["إِنَّ أَسوا يَومٍ يَمُرُّ عَلَيّا","يَومُ لا رُغبَةٌ تَكونُ إِلَيّا",55,"ي",2,1],["إِن أَسَأنا لَم يَرُعنا بِلَومٍ","وَإِذا لُمناهُ