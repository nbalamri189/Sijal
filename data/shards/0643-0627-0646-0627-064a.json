{"poems":[[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[95,"نأسى إذا ودعتنا الشمس في الطفل","https://www.aldiwan.net/poem11475.html","البسيط"],[74,"نعاه للفضل والعلياء والنسب","https://www.aldiwan.net/poem18241.html","البسيط"],[40,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[68,"أفدي غزالا من آل ليث","https://www.aldiwan.net/poem39221.html","مجزوء البسيط"],[99,"دع النفس تمرح في خيال وأوهام","https://www.aldiwan.net/poem24779.html","الطويل"],[107,"هي الدراري فأين المطمح العالي","https://www.aldiwan.net/poem43059.html","البسيط"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[52,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[48,"كإنائك الجسم الذي هو صورة","https://www.aldiwan.net/poem22965.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[92,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[159,"عذبتها بالمزاج فابتسمت","https://www.aldiwan.net/poem55789.html","المنسرح"],[261,"تقول لي وهي غضبى من تدللها","https://www.aldiwan.net/poem48323.html","البسيط"],[261,"يا معشر الناس اسمعوا دعوة","https://www.aldiwan.net/poem48454.html","السريع"],[353,"كان أيرا صار سيرا","https://www.aldiwan.net/poem20385.html","مجزوء الرمل"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[435,"من الأحبة أم من طيب ربعهم","https://www.aldiwan.net/poem41426.html","البسيط"],[463,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[520,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[556,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37870","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25429","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47502","المنسرح"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11990","المنسرح"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118324","البسيط"],[2192,"","https://poetry.dctabudhabi.ae/diwan/poem/203430",""],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28509","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60894","البسيط"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99090","الوافر"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130747","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204723","المنسرح"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66490","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110154","المنسرح"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216693","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29309","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77180","الطويل"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20888","الهزج"],[778,"قم فاسقني قهوة اذا انبعثت","https://www.poetsgate.com/ViewPoem.aspx?id=89145",""],[5431,"يارحمة الله ..لاجنٌ ..ولاعربُ","https://www.poetsgate.com/ViewPoem.aspx?id=187110",""],[1547,"قلبٌ ، وقلبي لأسهم المُقَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=17074",""],[5725,"ايقونة","https://www.poetsgate.com/ViewPoem.aspx?id=195001",""],[4442,"قبلت خديه وهو نائم","https://www.poetsgate.com/ViewPoem.aspx?id=171022",""],[6189,"ما تبقى من أحزان الرجال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83551&r=&rc=18",""]],"verses":[["كَأَنَّ أَيديهِمُ نَبَتنَ لَهُم","مَعَ القَنا حَيثُ يَنبُتُ الأَسَلُ",0,"ل",1,0],["كَأَنَّ أَيديها يُلا","طِمنَ مِنَ المَروِ إِبَر",1,"ر",1,0],["كَأَنَّ إِياةَ الشَمسِ بِشرِ بنِ جَهوَرٍ","إِذا بَذَلَ الأَموالَ وَهيَ رِغابُ",2,"ب",1,0],["كَانَّ أَيَّامَهُ دِيباجَةٌ نُسِجَتْ","مِنَ المَفَاخِرِ فِي حَلٍّ وَمُرْتَحَلِ",3,"ل",1,0],["كأنَّ أيديهمو تبت أسىً فغدت","من عيِّ أقلامِها حمَّالةَ الحطب",4,"ب",1,0],["كَأَنَّ أَينُقَنا جونِيَّ مَورِدَةٍ","مُلسُ المَناكِبِ في أَعناقِها هَنَعُ",5,"ع",1,0],["كَأَنَّ أَيدي فَتى هِلالٍ","عَرَقنَ نوناً عَلى هِلالِ",6,"ل",1,0],["كأن ائتلاق النجم والنجم مُشرقٌ","ثناياه تبدو في عبوسة أيامي",7,"م",2,0],["كَأَنَّ أَيدِيَهُم فيها إِذا اِنطَلَقَت","أَيدي شَياطينَ أَو أَنيابُ أَغوالِ",8,"ل",1,0],["كأنّ أيديَها والقِدُّ يَكعَمُها","في كل ماجرة أيدي الحرابي",9,"ي",1,0],["كَأَنَّ أَيراً في اِستِها في اِستِهِ","يَخفى وَيَبدو أَجرَدٌ نابِثُ",10,"ث",1,0],["كَإِنائِكِ الجِسمُ الَّذي هُوَ صورَةٌ","لَكِ في الحَياةِ فَحاذِري أَن تُخَدعي",11,"ي",1,1],["كان إيماني في شبابي جمّاً","ما به نزرةٌ ولا تقصير",12,"ر",1,0],["كَأَنَّ أيَّامَهُ وَالْبِرُّ يَغْمُرُهَا","صَحَائِفُ الطُّهْرِ في أَيْمَانِ أَبْرَارِ",13,"ر",1,0],["كانا يَرُبَّانِ الغرامَ معاً","ذا يَصْطَفيهِ ، وذا يُهَدْهِده",14,"د",2,0],["كأَنّ أَيدي المِزاجِ قَد سكبت","في كأْسها فضةً عَلَى ذَهَبِ",15,"ب",1,0],["كأَنَّ أَيركَ شمعٌ في رَخاوَتهِ","فكلَّما عَرَكَتْهُ رَاحتي لانَا",16,"ن",2,0],["كأن أيري في استها زمجٌ","يطلب بين الشوك دراجه",17,"ج",2,0],["كانَ أَيراً صارَ سَيْراً","يَجلِدُ الأَكْسَاسَ سُخْرَه",18,"ه",1,1],["كأن أيديها إذا شارفَتْ","فِناءه فائزةٌ بالقِداح",19,"ح",1,0],["كأن أيوانها السامي بعزته","قوس لدارة برج الليث فيما سمي",20,"م",2,0],["كأنّ أيديهم على خَلَّتي","عصائبُ الجَبْرِ على الأعظُمِ",21,"م",1,0],["كأن أيمانهم سلت عزائمهم","من الجفون على الهامات واليلب",22,"ب",1,0],["كأن أيامه وهي التي حسنت","عندي من العمر أسحار وآصال",23,"ل",1,0],["كأنّ أيدِيَهُمْ في النّاس ما خُلقتْ","إِلّا لِبَذل الأيادِي والعَطِيّاتِ",24,"ت",1,0],["كَأنَّ أَيّامَهم حَيثُ العَجاجُ عَلا","لَيلُ الشّتاءِ عَلَيهِ الجُنحُ مَسدولُ",25,"ل",1,0],["كأنَّ إيطاليَا جِنٌّ بمسْبَعَةٍ","يتُلى عليها مِنَ القُرآن آياتُ",26,"ت",1,0],["كَأَنَّ أَيْدِيهِنَّ بِالقاع القَرَقْ","أَيْدِي جَوارٍ يَتَعاطَيْنَ الوَرَقْ",27,"ق",1,1],["كَأَنَّ أَيْدي الرِّياحِ مُذْ بَسَطَتْ","في مَتْنِهِ أَظْهَرَتْ لنا حُبُكَهْ",28,"ه",1,0],["كَأَنَّ أَيدي عِداهُ بَنَوا","أَيدي بَني ضَبَّةٍ عَلى الجَمَلِ",29,"ل",1,0],["كان ايديهم اذ يقذفون بها","ايدي سقاة تعاطوا اكؤس الراح",30,"ح",1,0],["كانا يديَّ فشلتا","بالساعدين وبالمعاصم",31,"م",1,0],["كَأَنَّ أَيديهمُ لِلرِّزقِ ضامِنَةٌ","فَالِلنَّدى قائِمٌ مِنهُم وَمُنتَظَرُ",32,"ر",1,0],["كأنّ أيدي مطايَاهُم وَقدْ حُدِيتْ","تطا على حُرِّ وجهي أو على كبدي",33,"د",2,0],["كأنا يوم منعناه إلينا","وقد فتكت بأنفسنا الهموم",34,"م",1,0],["كانا يحوكان في رأسيهما خدعاً","في مطلب المال وهو المطلب الجلل",35,"ل",1,0],["كانا يشدانني لصدرهما","شدّ محب للحب مقترب",36,"ب",1,0],["كأن آية عيسى فيه قد نزلت","فلو قَضَيتِ بأمرِ اللَّه أحياكِ",37,"ك",1,0],["كأَنَّ ايدي الرياض قد خلعت","عليهِ من وَشيِ زهرها حُلَلا",38,"ل",2,0],["كان إيواؤها حراماً فأضحى ال","يوم إيواؤها حلالاً مباحا",39,"ح",2,0],["كَأَنَّ أَيّامَهُ وَالسِحرُ يُطلِقُها","أَحلامُ حَسناءَ طافَت في لَياليها",40,"ي",3,0],["كَأَن إِياساً قَد أُعيدَ بِعَصرِنا","فَضاء بِهِ وَجهُ الذَكاءِ لمعتد",41,"د",1,0],["كأنا يوم قرّى","إنما نقتل إيّانا",42,"ن",2,0],["كأن ايدي الرياح قد بسطت","لنا على وجه مائه شبكه",43,"ك",2,0],["كأن أيوب قد أهداه بردته","يُقلبُ الحزن بين الصبر ..يحتسبُ",44,"ب",1,0],["كأَنّ أَيدي عداه حين بَنَوْا","أَيدي بني ضَبّة ٍ على الجَملِ",45,"ل",1,0],["كأن ايامنا خيل بنا جمحتْ","مثل المجانين لا نرخي لها الرسنا",46,"ن",2,0],["كأن أيديهم بنودا","علت على الهام والعمائم",47,"م",1,0],["كانا يقولان والعصفُ البهيم شجى","\"إن كنت ريحاً فقد لاقيت إعصارا\"",48,"ر",2,0]]}