tsgate.com/ViewPoem.aspx?id=213403",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[592,"هو الله معبود الورى فله الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=128841",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5375,"سرى يتخطى الركب والركب نوم","https://www.poetsgate.com/ViewPoem.aspx?id=186864",""],[5431,"عن رحمة الله أتكلم...","https://www.poetsgate.com/ViewPoem.aspx?id=191462",""],[5431,"مسدس....","https://www.poetsgate.com/ViewPoem.aspx?id=213714",""],[5431,"هو الوعظُ!","https://www.poetsgate.com/ViewPoem.aspx?id=213735",""],[5470,"الليل والشجن","https://www.poetsgate.com/ViewPoem.aspx?id=10906",""],[5537,"وجع","https://www.poetsgate.com/ViewPoem.aspx?id=208165",""],[5537,"قصيدة_حب","https://www.poetsgate.com/ViewPoem.aspx?id=214726",""],[5582,"أَلا ما لِدَمْعِكَ يَجْرِي طَلَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=187236",""],[5582,"خَيالٌ سَرَى وَهْناً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=63489",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5605,"لهب في اللهب","https://www.poetsgate.com/ViewPoem.aspx?id=160691",""],[5756,"خطاك السو","https://www.poetsgate.com/ViewPoem.aspx?id=5364",""],[5781,"قصيدةٌ محروقةٌ ودخان....","https://www.poetsgate.com/ViewPoem.aspx?id=198547",""],[5784,"يأسي يسرج حرفي","https://www.poetsgate.com/ViewPoem.aspx?id=189746",""],[5969,"مَدارٌ لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=206928",""],[6127,"أبى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190758",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""]],"verses":[["هُوَ اللافِتي عَن ذا الزَمانِ وَأَهلِهِ","بِشيمَةِ لا وانٍ وَلا مُتَوانِ",0,"ن",1,0],["هُوَ اللَيثُ لا مُستَنهَضٌ عَن فَريسَةٍ","وَلا راجِعٌ عَن فُرصَةٍ لِحَياءِ",1,"ا",2,0],["هوَ اللهُ يبْلو النّاسَ بالخَيْر فِتْنَةً","وبالشّرِّ والأيّامُ سُمٌّ وتَرْياقُ",2,"ق",1,0],["هُوَ اللهُ يُمْلِي للْعِدَى وَيَدُ الْهُدَى","بِبُرْهَانِهَا تَجْلُو ظَلاَمَ مُحَالِهِ",3,"ل",2,0],["هُوَ اللَيثُ قَلَّدَ مِنكَ النِجادَ","لِيَومِ الوَغى شِبلَهُ الأَنجَدا",4,"د",2,0],["هو الليل يُغريه الأسى فيطول","ويرخي وما غيرُ الهموم سدول",5,"ل",1,1],["هو اللفظ حالٍ بهِ جيدها","كفيل ندًى وردًى يهمر",6,"ر",1,0],["هو الليث طوراً بالعراء وتارةً","له بين آجامِ القنا متأجَّمُ",7,"م",1,0],["هو اللَه يعبد في أرضه","كما أنهُ في السماوات يعبد",8,"د",1,0],["هو الليثُ الذي إن يَحْمِ أرضاً","فكلُّ فِجاجِ تلك الأَرضِ غابُ",9,"ب",1,0],["هُوَ اللَهُ رَبّي وَالقَضاءُ قَضاؤُهُ","وَرَبّي عَلى ما كانَ مِنهُ حَميدُ",10,"د",1,0],["هُوَ اللَهُ هُوَ اللَهُ","وَلَكِن يَغفِرُ اللَهُ",11,"ه",1,1],["هوَ اللَّيثُ إِلّا أنّ رِفعةَ تاجهِ","على قمرٍ في هالةِ المُلْكِ كامِلِ",12,"ل",1,0],["هُوَ اللَيثُ لَيثُ الغابِ بَأساً وَنَجدَةً","وَإِن كانَ أَحيا مِنهُ وَجهاً وَأَكرَما",13,"م",2,0],["هو اللهُ يحمي دينَهُ ويُعِزّهُ","فَمَنْ ذا يُناويهِ ومن ذا يُصاولُهْ",14,"ل",2,0],["هو اللّيْثُ خانتْه المخالبُ فاجْعلوا","من العلمِ أنياباً له وأظافرا",15,"ر",2,0],["هو اللَّهُ فاعْرِفْ يا عديُّ سَبيلَهُ","وَدَعْ خطراتِ الوهمِ من كلِّ واهمِ",16,"م",1,0],["هُوَ اللَّهُ يَهدِي نُفوسَ الرجال","ويَرزقها البِرَّ والمَرْحَمَهْ",17,"م",2,0],["هو اللَّهُ فانْظرْ يا أبا الفضلِ ما قَضَى","من اليُسرِ بعد العُسْرِ بُورِكْتَ ناظرا",18,"ر",2,0],["هواللَهُ باري الخَلقِ وَالخَلقُ كُلُّهُم","إِماءٌ لَهُ طَوعاً جَميعاً وَأَعبُدُ",19,"د",1,0],["هُوَ اللَيثُ اِسمُ مَأَواهُ عَرينٌ","أَو الظَبيُّ اِسمُ مَأواهُ كِناسُ",20,"س",1,0],["هُوَ اللَهُ فَاِعتَقدَنَّ اليَقينَ","وَخَلّ الزَنادِقَة الأُفَّكا",21,"ك",2,0],["هو اللّيل في صمته ضجّة","وفي سرّه عالم أبكم",22,"م",1,0],["هو اللّيل يطوي بأعطافه","قلوبا بأشواقها تضرم",22,"م",1,0],["هو الله جلَّ اللهُ فاعكف ببابِهِ","له البدءُ في مخلوقه وله الختم",23,"م",1,0],["هو الله من حَبلَي وريدك أقرب","فأين الحيا يا شيخ أين التهيب",24,"ب",1,1],["هُوَ اللَيثُ إِلّا أَنَّ عِرِّيسَهُ القَنا","وَصيداتِهِ الصّيدُ المُلوكُ العَباهِلُ",25,"ل",1,0],["هو الله يقضي ما يشاء بحكمة","وعدل وقول الخارصين ضلال",26,"ل",1,0],["هو الليل ليل والنهار نهار","وفي كل أرض للمحوّل دار",27,"ر",1,1],["هوَ اللَّه لا نُحصي لآلائهِ شكرا","لهُ الحمدُ في الأولى له الحمدُ في الأخرى",28,"ر",2,1],["هو اللَّه ربُّ الكلّ جلّ جلالهُ","فَما جِهةٌ باللَّه مِن جهةٍ أحرى",28,"ر",2,0],["هو اللَّه فاِفهم فالمُهيمن أخبرُ","وَعَن جدّهم جاءَ الحديث يبشّرُ",29,"ر",1,0],["هو الليث في باس هو الغيث في ندى","اذا حاد يوم الروع او جاد نائله",30,"ل",2,0],["هو الليل ما لليل من صبوةٍ بدّ","ولا لشجون الليل عن مهجتي ردّ",31,"د",1,1],["هو اللَه إن الله يحفظ عهده","ويحرس في عهد الهدى من يصابر",32,"ر",1,0],["هو اللَّبْقُ عند الضَّرْبِ في الحرب بالقنا","وللحلمِ يوم السِلم فَهْوَ حَلِيْفُ",33,"ف",1,0],["هو اللَّبْقُ مَعْ ضربِ الجماجم والطُّلى","وحَطَّمَ في الهيجا قَناها وكَسّرا",34,"ر",2,0],["هُوَ اللَيلُ لا حسَّ هُناكَ وَلَيسَ","سَميرٍ يُؤسّي شَقوَتي غَيرُ كَوكَبِ",35,"ب",1,0],["هو الليثُ تُنْسِيك أهوَالُه","زئيرَ الليوثِ وأَهوالَها",36,"ل",3,0],["هو الليلُ للأرواحِ مجرى ومَلعَبٌ","وللريحِ فيه زفرةٌ وعويل",37,"ل",1,0],["هو اللّيلُ يخفي الويلَ والنّاسُ نُوَّمٌ","وسيفُ الرّدَى فوقَ النيامِ صقيل",37,"ل",1,0],["هُوَ اللَيثُ لَولا البَرقُ وَالرَّعدُ دونَهُ","هُوَ البَحرُ جوداً وَالمُعَظَّمُ أَعظَمُ",38,"م",1,0],["هُوَ اللَيثُ بَأساً لَكِنِ اللَيثُ عابِثٌ","قَطوبٌ وَعيسى لَم يَزَل يَتَبَسَّمُ",38,"م",1,0],["هُوَ اللَّيثُ في يَومِ الكَريهَةِ مُقدِماً","لَهُ الدَّمُ غَيلٌ وَالذَوابِلُ غيلُ",39,"ل",1,0],["هُوَ اللَيث إِلّا أَنَّهُ الغَيث نائِلاً","عَلى أَنَّهُ بَحر وَلَكنّهُ بَدرُ",40,"ر",1,0],["هو الليلُ في بُعْدِ أحبابنا","وفي قُرْب أحبابنا المشعَلُ",41,"ل",1,0],["هو الليث إلّا أنهُ غير مفتر","وكالغيث لكن قطر كفيه عسجدُ",42,"د",1,0],["هو الله الذي خلق البرايا","له وهدى وأسعهم ضلالا",43,"ل",2,0],["هو الله لا عقل له مدرك ولا","يحيط به علماً سواه مؤبدا",44,"د",2,0],["هو الله ربي هو المبتدا","وما رفعه بسوى الإبتدا",45,"د",2,1],["هو الله الذي لا شيء معه","وهل ظل يكون مع العمود",46,"د",1,0],["هُوَ اللَيثُ لَكِنَّ المَحامِدَ غابُهُ","هُوَ السَيفُ لَكِنَّ المَكارِمَ غَمدُهُ",47,"د",2,0],["هُوَ اللَوذَعيُّ الأَلمعيْ دَوحةُ العُلا","هُوَ السَيد المَوصوف وَالحبر وَالبَحر",48,"ر",1,0],["هو الليث بل ما الليث في حومة الوغا","وما عنترٌ يوم الطرادِ ولا عمرو",49,"ر",2,0],["هوَ اللُّؤلُؤُ المَكنونُ وَالدُرّةُ الّتي","تَجِلُّ اِرتِفاعاً أَن يَكونَ لَها نِدُّ",50,"د",1,0],["هو اللَّيثُ إلاّ أَنَّه وهو خادِرٌ","سطا فأَغاب الليثَ عن أُنس غابه",51,"ب",2,0],["هو الليثُ حتى لا ليوث وماله","مثيلٌ ولكن بالمهنْد يغرسُ",52,"س",1,0],["هو الليثُ حاشا أن يباهَى به امرؤ","هو العدلُ حاشاه عن الشِّبْه والشَّرْوى",53,"و",2,0],["هو الليثُ الذي يُخشَى ولكن","أظافرُه الأسنَّة والحسامُ",54,"م",1,0],["هو الليل مسدول لدينا رِواقُه","هو الصبح مشدود علينا نطاقه",55,"ق",2,1],["هو الليث بل أعدى ولولاه ما سمت","مسارح آرام بصوله عنبس",56,"س",1,0],["هو الليث بل أعدى من الليث سطوة","إذا ما اعتدت صيد الخطوب البواقع",57,"ع",1,0],["هو الليث لا والله بل هو أشجع","من الليث في وقت الجلاد وأقدم",58,"م",1,0],["هُوَ الليل مستخف به من أراده","وضوء صباح للذي كان ساريا",59,"ي",2,0],["هو الليث لكن ليس فيه ملالةٌ","ولم يعره جبنٌ ولم يشنه غيرْ",60,"ر",1,0],["هو الليث والأشبال تختال حوله","بنون له كلٌّ تراه غضنفرا",61,"ر",2,0],["هو الليث عبد الله اشرف سيّد","طوامي ندا كفيه بحرٌ تلاطما",62,"م",2,0],["هُوَ اللَّيثُ لَكِن غابُهُ البيضُ وَالقَنا","هُوَ النَّصلُ لَكِن كُلُّ مَتنٍ لَهُ قَربُ",63,"ب",1,0],["هو الله الذي يعطي ويولي","تفرد بالعطا وهو الرقيب",64,"ب",1,0],["هو الله ربي قد وقفت ببابه","أناجيه يا من يعلم السر والجهرا",65,"ر",2,0],["هو اللّه خير حافظاً لعباده","فما منهم من ناشيء بمضيعة",66,"ه",1,0],["هو اللّه فاعرفه ودع فيه من وما","دعاك ولم يترك طريقك مظلما",67,"م",2,1],["هو اللّه بسم اللّه تسبيح فطرتي","هو اللّه إخلاصي وفي اللّه نزعتي",68,"ت",2,1],["هو اللّه بسم اللّه ذاتي تجردت","وهامت بمجلى النور عين حقيقتي",68,"ت",2,0],["هو اللّه بسم اللّه ضاءت فأشرقت","بأنوار نور اللّه نفس هويتي",68,"ت",2,0],["هو اللّه بسم اللّه في كل لحظة","بأسرار سر الجمع جمع تشتتي",68,"ت",2,0],["هو اللّه بسم اللّه ذرات عالمي","خواتمهما بدء كعالم ذرتي",68,"ت",2,0],["هو اللّه بسم اللّه هبت فشاهدت","بروق جلال من أنا اللّه غيبتي",68,"ت",2,0],["هو اللّه بسم الله شاهدت اسمه","فتاهت بافناء الفناء أنيتي",68,"ت",2,0],["هو اللّه بسم اللّه فقري محقق","غذائي وذلي باسمه عين عزتي",68,"ت",2,0],["هو اللّه بسم اللّه نور جلاله","به احترقت آفات نفسي ونشأتي",68,"ت",2,0],["هو اللّه بسم اللّه أسرار اسمه","بها صعقت عني شياطين شهوتي",68,"ت",2,0],["هو اللّه بسم اللّه تزكو خواطري","وتصدق إلا عن مراضيه لفتتي",68,"ت",2,0],["هو اللّه بسم اللّه جردت وحدتي","لوحدته إذ منه لي فيه وحدتي",68,"ت",2,0],["هو اللّه بسم اللّه أنسي شهوده","ولو غيبته العين مت بوحشتي",68,"ت",2,0],["هو اللّه بسم اللّه أوقفت رؤيتي","عليه وديني مخلصاً نفسي رؤيتي",68,"ت",2,0],["هو اللّه بسم اللّه حجي وعمرتي","إلى بيته المعمور إذ هو بضعتي",68,"ت",2,0],["هو اللّه بسم اللّه نفسي مشاعري","ونسكي حياتي والمحبة وقفتي",68,"ت",2,0],["هو اللّه بسم اللّه لولا صلاته","عليَّ لعزتني صلاتي وسجدتي",68,"ت",2,0],["هو اللّه بسم اللّه ما صمت لحظة","على أنني لم تعهد الفطر فطرتي",68,"ت",2,0],["هو اللّه بسم اللّه وتري شهادتي","وتلك صلاة الوتر في جنح ظلمتي",68,"ت",2,0],["هو اللّه بسم اللّه جاهدت شوكتي","فكانت له فيه به منه نصرتي",68,"ت",2,0],["هو اللّه بسم اللّه كون اضافتي","إليه زكاتي وهي أفخر نسبتي",68,"ت",2,0],["هو اللّه بسم اللّه محق ارادتي","مرادي واثباتي لمحوي بغيتي",68,"ت",2,0],["هو اللّه بسم اللّه نفذ مشيئتي","ومالي بشيء جزء حولي وقوتي",68,"ت",2,0],["هو اللّه بسم اللّه لو عارض الفنا","حياتي لم تذهب حياتي بموتتي",68,"ت",2,0],["هو اللّه بسم اللّه في كل وارد","له من يقيني فيه كل تثبت",68,"ت",1,0],["هو اللّه بسم اللّه في كل خطوة","له ملك منى يطير بسبحتي",68,"ت",2,0],["هو اللّه بسم اللّه أسنى معارجي","إليه نزولي في مدارك خشيتي",68,"ت",2,0],["هو اللّه بسم اللّه ملك عوالمي","بتدبير سر الاسم في قهر قبضتي",68,"ت",2,0],["هو اللّه بسم اللّه قهري مسخر","شياطين نفسي تحت كرسي عزتي",68,"ت",2,0],["هو اللّه بسم اللّه والجد باسمه","بجد اسمه أربت على الجد خطوتي",68,"ت",2,0],["هو اللّه بسم اللّه والفيض باسمه","تجلى لعقلي كنه كل حقيقة",68,"ه",1,0],["هو اللّه بسم اللّه والفتح باسمه","فتوحات عرفاني وكشفي استهلت",68,"ت",1,0],["هو اللّه بسم اللّه والوهب باسمه","أفاض على الوه