{"poems":[[55,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[89,"أحبب بهن معاهداً ومعانا","https://www.aldiwan.net/poem8235.html","الكامل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[54,"هذا الفراق وكنت أفرقه","https://www.aldiwan.net/poem26805.html","الكامل"],[48,"إن شئتما أن تنسكا فاسكنا","https://www.aldiwan.net/poem23553.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[105,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[89,"أحببْ بهنَّ معاهداً وَ معانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23876&r=&rc=138",""],[119,"شيخي أمام الاولياء النجبا","https://www.aldiwan.net/poem41227.html","عموديه"],[136,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[154,"يا نائم الطرف عن سهدي وعن أرقي","https://www.aldiwan.net/poem68546.html","البسيط"],[189,"هذا الفراق وهذه الأظعان","https://www.aldiwan.net/poem14686.html","الكامل"],[190,"هذا الفؤاد بلي بأحسن","https://www.aldiwan.net/poem43486.html","مجزوء الكامل"],[190,"لولا التمتع بالعناق","https://www.aldiwan.net/poem43550.html","مجزوء الكامل"],[275,"هذا الفؤاد من الهوى فرغا","https://www.aldiwan.net/poem35045.html","أحذ الكامل"],[275,"أبدي هلالك من غمام البرقع","https://www.aldiwan.net/poem35396.html","الكامل"],[275,"جردت من تلك الجفون سيوفا","https://www.aldiwan.net/poem35430.html","الكامل"],[275,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[376,"ولكل أنثى ضرة","https://www.aldiwan.net/poem57142.html","مجزوء الكامل"],[415,"أتظن صبرك منجدا إن أنجدوا","https://www.aldiwan.net/poem32499.html","الكامل"],[422,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[447,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[447,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[447,"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[447,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[482,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[484,"طلل يلوح من الضمير ضئيلا","https://www.aldiwan.net/poem37066.html","الكامل"],[563,"خفض عدوي في الهوى ومصادقي","https://www.aldiwan.net/poem34337.html","الكامل"],[563,"يا من يقول بأنه يدري الفنا","https://www.aldiwan.net/poem34465.html","الكامل"],[591,"هذا الفقير الذي تراه","https://www.aldiwan.net/poem17567.html","مخلع البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112432","الكامل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110734","الكامل"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142216","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62515","الكامل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75752","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119864","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109190","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50028","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93726","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108269","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135347","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111051","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127062","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90802","البسيط"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147256","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120300","الكامل"],[4679,"حتى مَ نلهو والمنية تنذر","https://www.poetsgate.com/ViewPoem.aspx?id=142723",""],[5038,"هذي بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=189564",""],[5081,"الكلُّ رفَّدَ أحمداً وأُرَفِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=185846",""],[5189,"له في العشق أذواقا","https://www.poetsgate.com/ViewPoem.aspx?id=213143",""],[5216,"أحزانُ أمَّتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=186987",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[5365,"خمرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=191265",""],[5397,"بشرا بوجهك ثغر الدهر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=157924",""],[5409,"قالوا فتى كان بإحدى القرى","https://www.poetsgate.com/ViewPoem.aspx?id=155270",""],[5431,"الحب معجزة","https://www.poetsgate.com/ViewPoem.aspx?id=191865",""],[5431,"هذا الفراتي..","https://www.poetsgate.com/ViewPoem.aspx?id=197355",""],[5431,"هذا الفراتي..","https://www.poetsgate.com/ViewPoem.aspx?id=197649",""],[5431,"جذب الظباء السمر إذْ تردُ","https://www.poetsgate.com/ViewPoem.aspx?id=198444",""],[5459,"رجوع","https://www.poetsgate.com/ViewPoem.aspx?id=198266",""],[5459,"إصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200151",""],[5493,"تهفو الأقاحي","https://www.poetsgate.com/ViewPoem.aspx?id=197610",""],[5674,"لو جئت طيفا أمطرت غيماتي","https://www.poetsgate.com/ViewPoem.aspx?id=185900",""],[5674,"الحديث يطول","https://www.poetsgate.com/ViewPoem.aspx?id=189482",""],[5688,"خلّوا الدموع تَسرّب","https://www.poetsgate.com/ViewPoem.aspx?id=200824",""],[5690,"بيمن سلطاننا عبد العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=172150",""],[5704,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=192535",""],[5704,"يا سيد الرسل ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=198742",""],[5956,"فَرْقُ العمر فرّقنا","https://www.poetsgate.com/ViewPoem.aspx?id=182148",""],[5956,"جوبي السهول","https://www.poetsgate.com/ViewPoem.aspx?id=184926",""],[5969,"ما وشوشت به الروح","https://www.poetsgate.com/ViewPoem.aspx?id=198633",""],[5969,"الساعةُ الواحدة بعد منتصف العشق","https://www.poetsgate.com/ViewPoem.aspx?id=198666",""],[5974,"أمَلِي","https://www.poetsgate.com/ViewPoem.aspx?id=200510",""],[6069,"هذا الفراق وأنت شاهده","https://www.poetsgate.com/ViewPoem.aspx?id=105661",""],[6075,"مخاض النصر","https://www.poetsgate.com/ViewPoem.aspx?id=190481",""],[6102,"غُربَةُ الزَّمَكان!","https://www.poetsgate.com/ViewPoem.aspx?id=186283",""],[6127,"فداء العرش","https://www.poetsgate.com/ViewPoem.aspx?id=189496",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[6160,"أَجنِحَةُ الضَّوء ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87084&r=&rc=1",""]],"verses":[["هَذا الفِراقُ وَأَنتِ أَعلَمُ بِالهَوى","فَاِرعَي فَأَيّامُ المُحِبِّ غَوادِرُ",0,"ر",1,0],["هَذَا الْفَخَارُ فَدُرْ بِعَينَيْكَ حَيْثُمَا","دَارَ الزَّمَانُ فَلَنْ تَرَى نُقْصَانَا",1,"ن",2,0],["هذا الفتى الفِهريُّ أقبلَ جامحاً","يغزو المدينةَ والمضلَّلُ يَجمحُ",2,"ح",1,0],["هَذا الفُراقُ وَكُنتُ أَفرَقُهُ","قَد قُرِّبَت لِلبَينِ أَينُقُهُ",3,"ق",2,1],["هَذا الفَتى أَوقَحُ مِن صَخرَةٍ","يَبهَتُ مِن ناظِرَهُ حَيثُ كان",4,"ن",1,0],["هذا الفتى الممراح","قد أغلقَ البابا",5,"ب",2,0],["هذا الفتى في الأمس، صار إلى","رجل هزيل الجسم منجرد",6,"د",1,0],["هذا الفساد البذى أبدى نواجذه","نار لها اليوم من إيماننا حطب",7,"ب",1,0],["هَذَا الْفَخَارُ، فَدُرْ بِعَيْنِكَ حَيْثُمَا","دارَ الزمانُ ، فلنْ ترى نقصانا",8,"ن",2,0],["هذا الفتى الرواس فياض الهمم","ذو المجد والقدر المعلى والشيم",9,"م",1,0],["هذا الفرات وهذا النيل مازخرا","إلا رَمَى باللآلِى منهما الزبد",10,"د",1,0],["هذا الفُراقُ وهذا الهَجرُ يَتبَعُهُ","يا قَلبُ صَبراً على مَوتينِ في نَسَقِ",11,"ق",1,0],["هذا الفراقُ وهذه الأَظعانُ","هل غيرَ وقِتك للدموعِ أَوانُ",12,"ن",1,1],["هذا الفؤاد بلي بأح","سَن من حلي",13,"ل",2,1],["هذا الفراق أظلّني","فمتى أبشّر بالتلاقي",14,"ي",1,0],["هذا الفؤادُ مِنَ الهوى فرغا","ولطالما كالسَّيلِ فيه طَغى",15,"غ",2,1],["هذا الفؤادُ لطولِ صدِّكِ مظلمٌ","ولئن يذرَّ عليهِ نورُكِ يَسطَع",16,"ع",1,0],["هذا الفؤادُ إذا رَفعتِ شغَافهُ","أبصرتِ فيهِ من الجمالِ صُنوفا",17,"ف",2,0],["هذا الفؤادُ الكثيرُ الهمِّ يحمِلُهُ","فتى غريبٌ يرى النُّعمى بقُربهِم",18,"م",1,0],["هَذا الفُضولُ بعَينِه","ألا قَنِعت بِعلمِهِ",19,"م",2,0],["هذا الفِراقُ فإِن تُطِقْ","جَلَداً فَمِيعادُ اللقاءِ المَوعِدُ",20,"د",1,0],["هذا الفُؤاد وهذه أعلاقُه","ضاق الغرام به عن الكتمان",21,"ن",1,0],["هذا الفراق وهكذا التوديع","مما يقد به حشا وضلوع",22,"ع",1,1],["هذا الفراق متى يكون لنا أبا","فطرٍ لقاك ونحن ثم جميع",22,"ع",1,0],["هذا الفراق فهل تلاق بعده","إِني لقى منه خلاف لقاء",23,"ا",2,0],["هذا الفراق متى يكون بك اللقا","وعليك من صم الصلاد صلاب",24,"ب",1,0],["هذا الفراق متى اللقاء محمد","أو ما لنا قبل القيامة مطمع",25,"ع",1,0],["هذا الفراقُ وكم عندَِ اللقِّاءِ لنا","صبحٌ إذا ما تغشَّتنا لياليهِ",26,"ي",2,0],["هذا الفؤاد وأنت فيه زهرة","ما حطمتك يد الخريف ذبولا",27,"ل",2,0],["هذا الفضاء بدا فقم متنزّهاً","في النور واخرج من خلال مضايق",28,"ق",1,0],["هذا الفنا هو مسقط الأحكام عن","كل امرئٍ دهمته حالة نكره",29,"ر",2,0],["هَذَا الفَقِيرُ الَّذي تَراهُ","كَالفَرْخِ مُلْقىً بِغَيْرِ رِيشِ",30,"ش",1,1],["هذا الفتى ليس الفتى بمحمر","وجناته ومطيب بملاب",31,"ب",1,0],["هذا الفتى السامي الذي","ينهى له حل وعقد",32,"د",1,0],["هذا الفتى بحجارة من أرضه","صنع انتفاضة شعبه الجباره",33,"ر",2,0],["هذا الفتى العربي فارس أمتي","هو من أتابع معجبا أخباره",33,"ر",2,0],["هذا الفؤاد سلوه ممن ذوبُهُ","والجفن ذا فيمن سبيل بكائه",34,"ا",3,0],["هَذا الفَتى الأوسي أَنّى راية","رُفِعَت لمجد حازه بيمينه",35,"ن",2,0],["هذا الفراق ولو أردت زيادة","مما لقيت من الأسى لم تزدد",36,"د",1,0],["هَذا الفَتى لَم يَعرف الرحمانا","وَلا رَسول اللَّه إِلا الآنا",37,"ن",2,0],["هذا الفتى العامل من درهم","يعيش مغبوطاً وأشقى أنا",38,"ن",2,0],["هذا الفتى وعسى يكون لهُ","عقب الضلالة فالهدى حتْمُ",39,"م",1,0],["هَذا الفَناء الَّذي عَم البَرية فال","أحياء مِنّا سواءٌ وَالَّذين فنُوا",40,"ن",3,0],["هذا الفؤاد لمن يحن فخبري","قلباً يحن اليك فهومخبر",41,"ر",1,0],["هذا الفؤاد من الهوى صديان","لما تطاول للجمال ورانُ",42,"ن",1,1],["هذا الفؤاد أسرته","يا ظبي ما يكفيك اسره",43,"ر",2,0],["هذا الفتى وابن الفتى","وأخو الفتى خير الورى",44,"ر",2,1],["هذا الفخار فيا بشرى لذي أدب","بمدح ابناء باز الله مفتخر",45,"ر",1,0],["هذا الفضول له تَجلٍ مزمن","حمم الشكوك وقوده إذ يُسبر",46,"ر",1,0],["هذا الفخار لمن يحاول ان يرى","عند المهيمن سعيه مشكورا",47,"ر",2,0],["هذا الفخار لملة الاسلام في","حلق العداة شجا ونار الاضلع",48,"ع",1,0],["هذا الفضول بعينه لمؤرس","عند الابيل رئيسه تأريسا",49,"س",2,0],["هذا الفقيد قضى وخلف بعده","ذكراً على صحف القلوب يسطر",50,"ر",1,0],["هذا الفِقارُ مَشيْمٌ كَبّرَتْ يَدُهُ","وعِطْرُ فاطمةٍ وَتْرٌ وأقْواسُ",51,"س",1,0],["هذا الفؤادُ مع اللِّسانِ مُرَدِّدٌ","خَيْرُ الوَرَى هذا النبىُّ محمَّدُ",52,"د",1,0],["هذا الفؤاد الذي مجراهُ من عبقٍ","بهِ فتحتُ إلى الجوزاءَ آفاقَا",53,"ق",2,0],["هذا الفُراتُ وهذا النّيلُ قدْ رَوَيا","حضارةَ الأرضِ مِنْ عُربٍ ومن عَجَمِ",54,"م",1,0],["هذا الفخار ومن يكن ذا وصفه","فالمدح فيه كقطرة في النيل",55,"ل",1,0],["هذا الفُؤادُ تصَوّفَت دقّاتُهُ","وسعَى إليكِ كمن أرادَ رِضاكِ",56,"ك",1,0],["هذا الفتى هاشمي يا هشام ففي","قبال نعليه منك الأنف منهشم",57,"م",1,0],["هذا الفتى حي وهل ينطق ال","ميت فيدعوني إلى نصره",58,"ر",2,0],["هذا الفؤاد له في كل ما فيه","إنْ شاء يهلكه ..أوشاء يُحييه",59,"ي",2,1],["هذا الفراتيُ من سيماه معناه","نهران فيه ونبع الجود سقياه",60,"ه",1,1],["هذا الفراتيُ عمقٌ في أصالته","فيض المروءة فوق الغيم تلقاه",60,"ه",1,0],["هذا الفراتي سمحٌ في صداقته","فيض المروءة فوق الغيم تلقاه",61,"ا",2,0],["هذا الفراتي طهر النفس طينته","نبلٌ يكلله أدناه -أقصاه",61,"ا",2,0],["هذا الفراتي مجبولٌ برفعته","بفيئه السعد روضٌ دام مرعاه",61,"ا",2,0],["هذا الفضاء الرحب أوّله","مذ تاهت الأنفاسُ والجسدُ",62,"د",1,0],["هذا الفراقُ وإن يطُلْ كذبٌ .. وكم","أَفشَى ميولَ الراحلينَ رجوعُ ..!",63,"ع",1,0],["هذا الفساد المستبدّ سينتهي","ولَسَوفَ يَقلع جذرَهُ الإصلاح ..",64,"ح",1,0],["هذا الفَرَاشُ أتى مِن قبلِ موعدِهِ","مِن كلِّ شرنقةٍ ينْسَلُّ مُنجذِبَا",65,"ب",2,0],["هذا الفرات رحيله قد هزني","وأمات حلو العيش في مأساتي",66,"ت",2,0],["هذا الفؤاد من الحنين ممزق","قد مات شوقا والحديث يطول ُ",67,"ل",1,0],["هذا الفؤاد محطّم","يشكو الفراق ويندب",68,"ب",1,0],["هذا الفريق الذي تنبيك سمتهُ","عن حسن شيمتهِ 