{"poems":[[88,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54646","الكامل"],[141,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[202,"صار التغزل في هواه عتابا","https://www.aldiwan.net/poem53367.html","الكامل"],[233,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[280,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[340,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[355,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[456,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[513,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[536,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"]],"verses":[["ولقومنا في الشرق حال كلما","زدت أفتكاراً فيه زدت تعجُّبا",0,"ب",2,0],["وَلَقوا عَواصِيَ قَد عَيِيتَ بِنَقضِها","وَلَقَد نُقِضتَ فَما بِكَ اِستِمرارُ",1,"ر",1,0],["وَلِقَولِ العُذّالِ عَنكِ بَخيلٌ","هُوَ خَيرٌ مِن قَولِهِم مِسكينَه",2,"ن",2,0],["وَلِقَومٍ نَوالُهُ وَرِضاهُ","وَلِأَقوامِ القِلى وَالجَفاءُ",3,"ا",2,0],["وَلَقَوْا الإِثَابَةَ مِنْ وَفَاءِ حُ","كُومَةٍ وَثَنَاءِ شَعْبِ",4,"ب",1,0],["وَلَقوا الحَربَ دارِعينَ مِنَ الصَب","رِ دُروعاً لَيسَت تَحُلُّ العِيابا",5,"ب",2,0],["ولقوله صلّى عليه إلهُهُ","وكفى بما قال النبيُّ صوابا",6,"ب",2,0],["وَلَقوا الحُروبَ بِكُلِّ مُش","تَرِفٍ أَقَبِّ البَطنِ أَجرَد",7,"د",1,0],["وَلِقَوسِهِ رُسُلُ المَنونِ إِلى العِدا","تُصمي النُفوسَ فَتَسقُطُ الأَجسامُ",8,"م",1,0],["ولقوا في ثيابهم","ميعة الخمر والاسن",9,"ن",1,0],["وَلَقَوا فِي حِصِنِهَا مُمتَنَعاً","رَيثَمَا يَستَرجِعُونَ النَّفَسَا",10,"س",2,0],["ولقولةٍ عوصاءَ أُرتِج بابُها","ففتحتَه لمّا ولجتَ خصامَها",11,"م",3,0],["ولقوم زبدة الوطب الذي","لم أفز منه بغير الزبد",12,"د",1,0],["ولَقَوهُ بِقُلوبٍ","يَلتظى فيها السَّعيرُ",13,"ر",1,0]]}