{"poems":[[90,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[93,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54646","الكامل"],[147,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[208,"صار التغزل في هواه عتابا","https://www.aldiwan.net/poem53367.html","الكامل"],[240,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[287,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[347,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[362,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[463,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[520,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122709","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136368","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78183","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50028","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47166","الكامل"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101404","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""]],"verses":[["ولقومنا في الشرق حال كلما","زدت أفتكاراً فيه زدت تعجُّبا",0,"ب",2,0],["وَلَقوا عَواصِيَ قَد عَيِيتَ بِنَقضِها","وَلَقَد نُقِضتَ فَما بِكَ اِستِمرارُ",1,"ر",1,0],["وَلِقَولِ العُذّالِ عَنكِ بَخيلٌ","هُوَ خَيرٌ مِن قَولِهِم مِسكينَه",2,"ن",2,0],["وَلِقَومٍ نَوالُهُ وَرِضاهُ","وَلِأَقوامِ القِلى وَالجَفاءُ",3,"ا",2,0],["وَلَقَوْا الإِثَابَةَ مِنْ وَفَاءِ حُ","كُومَةٍ وَثَنَاءِ شَعْبِ",4,"ب",1,0],["وَلَقوا الحَربَ دارِعينَ مِنَ الصَب","رِ دُروعاً لَيسَت تَحُلُّ العِيابا",5,"ب",2,0],["ولقوله صلّى عليه إلهُهُ","وكفى بما قال النبيُّ صوابا",6,"ب",2,0],["وَلَقوا الحُروبَ بِكُلِّ مُش","تَرِفٍ أَقَبِّ البَطنِ أَجرَد",7,"د",1,0],["وَلِقَوسِهِ رُسُلُ المَنونِ إِلى العِدا","تُصمي النُفوسَ فَتَسقُطُ الأَجسامُ",8,"م",1,0],["ولقوا في ثيابهم","ميعة الخمر والاسن",9,"ن",1,0],["وَلَقَوا فِي حِصِنِهَا مُمتَنَعاً","رَيثَمَا يَستَرجِعُونَ النَّفَسَا",10,"س",2,0],["ولقولةٍ عوصاءَ أُرتِج بابُها","ففتحتَه لمّا ولجتَ خصامَها",11,"م",3,0],["ولقوم زبدة الوطب الذي","لم أفز منه بغير الزبد",12,"د",1,0],["ولَقَوهُ بِقُلوبٍ","يَلتظى فيها السَّعيرُ",13,"ر",1,0],["ولَقُوهُ بالِجَبَهاتِ ثَمَّتَ عايَنُوا","ما هالَهُم فَلَقَوه بالأوراكِ",14,"ك",1,0],["ولقوا منَّا لَهُم هَ","ذا على هذا معينا",15,"ن",2,0],["ولقوم فيه اختيار مصيب","عند بعض وبعضهم قال واهي",16,"ي",1,0],["وَلِقَولي كُن سَميعاً","وَاتِ لِلوَرد مُطيعا",17,"ع",2,0],["ولقومه في كل ناحيةٍ","حبل قد اعتصمت به الهُضْمُ",18,"م",1,0],["ولقولتي حَقِّق بفضلك فيه إذْ","أَرَّخْت قيل ادخل لنا بسلام",19,"م",1,0],["ولقومك الغر الهداة","بي علي والبتول",20,"ل",1,0],["ولقوم يونس اجبل بجزاير","وجبال أخرى من معادن فضة",21,"ه",1,0]]}