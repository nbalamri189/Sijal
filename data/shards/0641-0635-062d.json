.dctabudhabi.ae/diwan/poem/69408","المتدارك"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53066","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28014","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67965","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106865","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83210","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94037","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200771","الرمل"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198397",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133946","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65320","السريع"],[3261,"","https://poetry.dctabudhabi.ae/diwan/poem/146039","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68028","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112394","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112363","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52980","المتدارك"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86306","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138705",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110079","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91837","الكامل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138911",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103028","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77002","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107513","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94564","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94709","الطويل"],[4264,"","https://poetry.dctabudhabi.ae/diwan/poem/142245","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72784","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120496","الكامل"],[4804,"يا قصر ذا النخلات من بارا","https://www.poetsgate.com/ViewPoem.aspx?id=92094",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4578,"لبدرٍ زفاف الشمس والنجم شاهد","https://www.poetsgate.com/ViewPoem.aspx?id=49397",""],[4927,"سَهَرُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=29636",""],[4984,"ويحك ..","https://www.poetsgate.com/ViewPoem.aspx?id=175801",""],[585,"لك الله من دمعٍ تحدّر صيّبا","https://www.poetsgate.com/ViewPoem.aspx?id=161848",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5419,"في عيادة طبيب الأطفال ... ( شعر للأطفال )","https://www.poetsgate.com/ViewPoem.aspx?id=71146",""],[5431,"قالت لي القدس...","https://www.poetsgate.com/ViewPoem.aspx?id=202677",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5790,"ليس في التقويم لي رأ","https://www.poetsgate.com/ViewPoem.aspx?id=111952",""],[5809,"سياحة","https://www.poetsgate.com/ViewPoem.aspx?id=205334",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[6045,"أطياف ودّ","https://www.poetsgate.com/ViewPoem.aspx?id=125353",""],[6093,"كمن نطق الشهادة بعد كفر","https://www.poetsgate.com/ViewPoem.aspx?id=215714",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""],[6225,"المبدع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71261&r=&rc=17",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""],[6325,"الغياب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88020&r=&rc=2",""]],"verses":[["فصِحّةُ الوُدِّ تَأبى وهْيَ ظاهِرةٌ","أن تُخفيَ الحالُ في أيّامكُمْ سَقَما",0,"م",2,0],["فَصِحْتَ فيه تَحَوَّلْ عن مَدينَتِهِم","فإنّها فِتنَةٌ أخشى تَماديها",1,"ي",3,0],["فصِحتَ: يا قوم، كادَ الزَّهوُ يَقتُلُني","وداخَلَتنِيَ حالٌ لستُ أدْريها",1,"ي",3,0],["فصحّ عقلي وقبلاً كنت مشتكياً","من علّة الجهل أوجاعاً وأوجالا",2,"ل",2,0],["فَصَحَوتُ عَنها بَعدَ حُبٍّ داخِلٍ","وَالحُبُّ تُشرِبُهُ فُؤادَكَ داءُ",3,"ا",2,0],["فصحت بها إلى أن جف حلقي","فحين سكتُّ كلمني إِبائي",4,"ي",1,0],["فَصُحتُ أَغِثني يا غُلامُ فَجاءَني","وَقَد زَلِقَت رِجلي وَلُجِّجتُ في الغَمرِ",5,"ر",1,0],["فَصَحَّوا وَاِزدَهَوا مَرَحاً","وَأَنحَلَ جِسمَكَ السَقَمُ",6,"م",1,0],["فُصحاء الخِطاب في الخَطبِ تَعيا","وَكَفى أَعجَمُ الخُطوب خَطيبا",7,"ب",2,0],["فَصَحَّتْ كَنَبْتِ الطَّوْدِ بَيْنَ المعَاطِبِ","وَمَدَّتْ إِلَى حيْثُ الثَّرى غَيْرُ نَاضب",8,"ب",1,0],["فصحبته بطريق نعم المصحب","وكريمة من قومه كالمعصما",9,"م",2,0],["فصحتُ يا ناسُ ماتَ قلبي","طفلاً وما زال في القِماط",10,"ط",1,0],["فَصَحَّ حَقُّكَ لَمّا اِعتَلَّ بِاطِلَهُم","لَن يَنفُقَ الصِدقُ حَتّى يَكسُدَ الكَذِبُ",11,"ب",1,0],["فصحوا له وسواه لما لم يفك ال","ضيق عن مكروبه مكروا به",12,"ب",2,0],["فصحفي بحمد الله من حسناتكم","ملاءا فزد سباً فلست بخاسر",13,"ر",1,0],["فصحَ عنديَ فيما قلت أنيَ لم","أخلق ولم أك إلا بعد قسمته",14,"ت",2,0],["فصحّ له الزهد الصريح بقدرة","وعلم فمن ذا منه أغنى وأقنع",15,"ع",1,0],["فصُحبةُ الشَحيحِ","تمسُّكٌ بالريحِ",16,"ح",1,0],["فصحبت الظلام طائف ليل","لم تشاهد عيناه من قبلُ فجرا",17,"ر",2,0],["فَصِحتُ بِأَصحابي اِمكُثو عَلَّنا نَرى","هَدانا عَلى الأَنوارُ مِن نارِ عَلوَةِ",18,"ه",1,0],["فصحيفةُ الدّنيا الطّويلةُ لم تَزَلْ","يُطوى لها طَرَفٌ وآخَرُ يُنشَر",19,"ر",1,0],["فصحَّت لها أسماؤه وصفاتُه","مباركها وعزُّها وسعيدُها",20,"د",3,0],["فصحح أساساً للبناء فكم ترى","على جرف هار بناء تهدما",21,"م",2,0],["فصحتها والعز والمال بعدها","سقام وذل وافتقار بقلة",22,"ه",1,0],["فصحاء الأتراك تأخذ عنه","وهو منشي فصاحة العربي",23,"ي",1,0],["فصحّ وقد رأيتُك كلُّ وعدٍ","ملكتُ به مناجزةَ الوُعودِ",24,"د",1,0],["فصُحتُ ليعرُبٍ فيها كأنّي","عَجُمتُ ببابلٍ فنَفَثْتُ سِحْرا",25,"ر",2,0],["فَصحَ البوازلَ وهو قارحُ عامه","وأجابَ داعي الشَّيبِ وهو وليدُ",26,"د",1,0],["فَصُحَتْ حتى الاشاراتُ لهُ","توصِلُ المعنى إلى الفَهْم الأكَلْ",27,"ل",1,0],["فصِحتُ فِيهِم إسمَعُوا","مِن مَنطِقِي فَحوَاه",28,"ا",2,0],["فصح في الحكم على يديه","ظلم أبي بكر وصاحبيه",29,"ه",1,0],["فَصَحَتْ وصحّ زمانها","من ذا يُغشّ وأَنت ناقد",30,"د",1,0],["فصح عن المعصوم أن طهورنا","إذا لم نجد ماء هو الترب فاقتد",31,"د",1,0],["فصحت يا ظبي النقى راجياً","منه البقا وليك مني خبير",32,"ر",1,0],["فَصَحَّ عِندي الَّذي اِدَّعتهُ","مِنْ أَنّها العَنبرُ المُذابُ",33,"ب",1,0],["فصحَّ عليه الخسف والخسفُ عادةٌ","على كل بدرٍ بالكمال قد ارتدى",34,"د",2,0],["فصحَّت لعباد به حجة النهى","وَكانَ له فيهم بإِبدائها رجح",35,"ح",1,0],["فَصَحَّ لي وَلِسانُ الحالِ يُنشِدُني","إِن طِعتُ هَذا فَمَن لي فاتَني حَسبي",36,"ب",2,0],["فصحِّة الخط حديقة الحدق","وثقة الرواة أروى من غدق",37,"ق",1,0],["فَصَحِّفْهُ وأَعكِسْهُ تَجِدْهُ مُفْسَّراً","وفي الوَصفِ كافٍ إِنْ تَفَطَّنَ حادِسُ",38,"س",1,0],["فصح ولكن عند ما لاح شاهدي","بمعنى به قد يقدم المتاخر",39,"ر",1,0],["فَصحبة الأَشرار داء يعدي","مثل السجايا عَن أَب وَجد",40,"د",1,0],["فصِحتُ محمّدُ ألاّ فتحتَ","فقالَ الوزير على المائدهْ",41,"د",2,0],["فَصَحَّ حَدِيثُ الحُسْنِ عَنْ وَرْدِ خَدِّهَا","وَإِنْ كَانَ أَضْحَى وَهْوَ رَاوٍ مُضَعَّفُ",42,"ف",1,0],["فصِحتُ من فرط جنونىن به","يا ليتنى راكبُ ذا الرَّاكبِ",43,"ب",1,0],["فصحيفةُ البشرى محيَّاه","ورونقه البشيرُ",44,"ر",1,0],["فصِحتِ وصِحنا ولم تعلمي","بأَنك جالبةُ الداهيه",45,"ي",2,0],["فَصَحتُ أَنا وَأَنتَ الناسَ قَولاً","وَفِعلاً في المَعالي وَالمَعاني",46,"ن",2,0],["فصَحوتَ مرتجفَ الفؤاد مُقَلّباً","كَفَّيكَ تصلى زفرةَ النَّدمانِ",47,"ن",1,0],["فصحوا وَقَد كذبتهمُ آمالهم","