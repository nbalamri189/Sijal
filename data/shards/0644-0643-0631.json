{"poems":[[83,"يا أيها المولى الذي بركاته","https://www.aldiwan.net/poem54305.html","الكامل"],[72,"يا صاحب الحسن البديع تركتني","https://www.aldiwan.net/poem18278.html","الكامل"],[51,"لك ريحان وراح ومجيدات ملاح","https://www.aldiwan.net/poem9410.html","مجزوء الرمل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[70,"أيها الخائف من أمر","https://www.aldiwan.net/poem42404.html","مجزوء الرمل"],[89,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42498","الخفيف"],[155,"لكرامتي أعرضت لا لهواني","https://www.aldiwan.net/poem55531.html","الكامل"],[225,"ابن إبراهيم طب إنا وإن","https://www.aldiwan.net/poem55182.html","الرمل"],[231,"لكرب بني العباس سفاحهم جلا","https://www.aldiwan.net/poem44601.html","الطويل"],[235,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[235,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[280,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[380,"سقت الغريب حمائم الفجر","https://www.aldiwan.net/poem49205.html","أحذ الكامل"],[458,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[458,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[461,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[464,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[500,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[515,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"]],"verses":[["لك راحة تزجي الغمام بأنمل","فَجْرْتَ منها بالنوال بحورا",0,"ر",2,0],["لك راحةٌ تعبَ الثراءُ بعتبها","ما أكرم المتعوبَ والمعتُوبا",1,"ب",2,0],["لك ريحانٌ ورَاحُ","ومُجِيدَاتٌ مِلاَحُ",2,"ح",1,1],["لك رأيٌ كأنه رأي شِقٍّ","أو سطيحٍ قَريعَي الكُهان",3,"ن",1,0],["لَكَ رَبٌّ لَم يَخِب","قَطُّ لَدَيهِ مَن رَجاهُ",4,"ا",2,0],["لكروب يفللن حدّ المواضي","وهموم يأكلن قلب الحديد",5,"د",1,0],["لِكِرامِهِم فَوقَ الكِرا","مِ مَزِيَّةٌ وَزنَ الرَواجِح",6,"ح",1,0],["لَكَ رُوحِي فَاصْنَعْ بِها مَا تَشاءُ","فَهْيَ مِنِّي لِناظِرَيْكَ فِداءُ",7,"ا",2,1],["لِكَرامَتي أَعْرَضْتَ لا لِهَواني","لَمْ تَجْفُني حَتَّى اهْتَمَمْتَ بِشَاني",8,"ي",1,1],["لَكِرامٌ إن غَضِبنا رَدَّنا","عن أَذى مِثلكَ طَبعُ الكاظِمين",9,"ن",1,0],["لكرب بني العباس سفاحهم جلا","وجر لمنصور ومهدي الولا",10,"ل",2,1],["لَكَ راحَةٌ فَضَلَت شَآ","بيبَ الحَيا بِسَخائِها",11,"ا",3,0],["لَكَ راحَةٌ أُمسى يُراحُ بِجودِها ال","عافي وَتَتعَبُ في النَدى لُوّامُها",12,"م",3,0],["لِكَرِيمِ الثَّناءِ وَالْيَدِ وَالْخِي","مِ عَمِيمِ الأَخْلاقِ وَالْخَلْقِ نَجْدِ",13,"د",1,0],["لَكَرعت مِن عَذب مجاجَتِهِ","خصر المَراشف عاطر الخَمر",14,"ر",1,0],["لك راحتان كلاهما يُمنَى إذا","كانت شمالٌ عن يمين تضعُفُ",15,"ف",1,0],["لكرماءَ التقموا طريقَهَ","وألَّقوا بينهُمُ تلك السِّيَرْ",16,"ر",1,0],["لكريمٍ هاشميٍّ نَجُرُهُ","سَبَلُ الجود وإجراء الجياد",17,"د",1,0],["لك رأيٌ لو ادَّعاه قصيرٌ","رام نيل السهى بباعٍ قصير",18,"ر",1,0],["لكَ رُوحي وليسَ عندي سِواها","إن تكنْ ذاكِري بذاكَ الرُّوَاقِ",19,"ق",1,0],["لك رضوان زائر ولقوم","هلكوا فيك منكر ونكير",20,"ر",1,0]]}