{"poems":[[85,"يا أيها المولى الذي بركاته","https://www.aldiwan.net/poem54305.html","الكامل"],[74,"يا صاحب الحسن البديع تركتني","https://www.aldiwan.net/poem18278.html","الكامل"],[53,"لك ريحان وراح ومجيدات ملاح","https://www.aldiwan.net/poem9410.html","مجزوء الرمل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[72,"أيها الخائف من أمر","https://www.aldiwan.net/poem42404.html","مجزوء الرمل"],[91,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42498","الخفيف"],[159,"لكرامتي أعرضت لا لهواني","https://www.aldiwan.net/poem55531.html","الكامل"],[230,"ابن إبراهيم طب إنا وإن","https://www.aldiwan.net/poem55182.html","الرمل"],[236,"لكرب بني العباس سفاحهم جلا","https://www.aldiwan.net/poem44601.html","الطويل"],[240,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[240,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[285,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[385,"سقت الغريب حمائم الفجر","https://www.aldiwan.net/poem49205.html","أحذ الكامل"],[463,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[466,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[469,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[505,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101506","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88601","الكامل"],[733,"","https://poetry.dctabudhabi.ae/diwan/poem/144569","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63847","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120003","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119901","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35351","الخفيف"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136791",""],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46436","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102139","المديد"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137083",""],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84841","الكامل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121137","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58390","الخفيف"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110797","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140025","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53006","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132097","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103015","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103053","الخفيف"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111052","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89570","المديد"],[4691,"في جلدكِ اختصرت حضارة رقّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=216012",""],[4760,"دنيتي والله بدونك لا تُعد","https://www.poetsgate.com/ViewPoem.aspx?id=35824",""],[5121,"بَيْرُوتُ الْحُبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=215332",""],[5183,"عالي الجناب","https://www.poetsgate.com/ViewPoem.aspx?id=186607",""],[5183,"فتاة النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185689",""],[5376,"غمَّ قلبي من الزمان طويلا","https://www.poetsgate.com/ViewPoem.aspx?id=197729",""],[5431,"عظُمَ الحنينُ وعنّفا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198505",""],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5582,"هذِي بِشاراتُ السُّرُورِ تَراها","https://www.poetsgate.com/ViewPoem.aspx?id=187331",""],[5703,"كن مطمئنا","https://www.poetsgate.com/ViewPoem.aspx?id=215960",""],[5956,"أسيرُ النعومة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182288",""],[6045,"وثبة قلب طروب","https://www.poetsgate.com/ViewPoem.aspx?id=181560",""],[520,"ليت يوم الإثنين لم يتبسم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577506",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""],[6355,"أمام البيت الحرام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66582&r=&rc=42",""]],"verses":[["لك راحة تزجي الغمام بأنمل","فَجْرْتَ منها بالنوال بحورا",0,"ر",2,0],["لك راحةٌ تعبَ الثراءُ بعتبها","ما أكرم المتعوبَ والمعتُوبا",1,"ب",2,0],["لك ريحانٌ ورَاحُ","ومُجِيدَاتٌ مِلاَحُ",2,"ح",1,1],["لك رأيٌ كأنه رأي شِقٍّ","أو سطيحٍ قَريعَي الكُهان",3,"ن",1,0],["لَكَ رَبٌّ لَم يَخِب","قَطُّ لَدَيهِ مَن رَجاهُ",4,"ا",2,0],["لكروب يفللن حدّ المواضي","وهموم يأكلن قلب الحديد",5,"د",1,0],["لِكِرامِهِم فَوقَ الكِرا","مِ مَزِيَّةٌ وَزنَ الرَواجِح",6,"ح",1,0],["لَكَ رُوحِي فَاصْنَعْ بِها مَا تَشاءُ","فَهْيَ مِنِّي لِناظِرَيْكَ فِداءُ",7,"ا",2,1],["لِكَرامَتي أَعْرَضْتَ لا لِهَواني","لَمْ تَجْفُني حَتَّى اهْتَمَمْتَ بِشَاني",8,"ن",2,1],["لَكِرامٌ إن غَضِبنا رَدَّنا","عن أَذى مِثلكَ طَبعُ الكاظِمين",9,"ن",1,0],["لكرب بني العباس سفاحهم جلا","وجر لمنصور ومهدي الولا",10,"ل",2,1],["لَكَ راحَةٌ فَضَلَت شَآ","بيبَ الحَيا بِسَخائِها",11,"ا",3,0],["لَكَ راحَةٌ أُمسى يُراحُ بِجودِها ال","عافي وَتَتعَبُ في النَدى لُوّامُها",12,"م",3,0],["لِكَرِيمِ الثَّناءِ وَالْيَدِ وَالْخِي","مِ عَمِيمِ الأَخْلاقِ وَالْخَلْقِ نَجْدِ",13,"د",1,0],["لَكَرعت مِن عَذب مجاجَتِهِ","خصر المَراشف عاطر الخَمر",14,"ر",1,0],["لك راحتان كلاهما يُمنَى إذا","كانت شمالٌ عن يمين تضعُفُ",15,"ف",1,0],["لكرماءَ التقموا طريقَهَ","وألَّقوا بينهُمُ تلك السِّيَرْ",16,"ر",1,0],["لكريمٍ هاشميٍّ نَجُرُهُ","سَبَلُ الجود وإجراء الجياد",17,"د",1,0],["لك رأيٌ لو ادَّعاه قصيرٌ","رام نيل السهى بباعٍ قصير",18,"ر",1,0],["لكَ رُوحي وليسَ عندي سِواها","إن تكنْ ذاكِري بذاكَ الرُّوَاقِ",19,"ق",1,0],["لك رضوان زائر ولقوم","هلكوا فيك منكر ونكير",20,"ر",1,0],["لكربلا تربة طابت وقد طَهُرت","فيها الشفاءُ منَ الأسقام والعللِ",21,"ل",1,0],["لك رأيٌ مهما اجنَّ ظلامٌ","فيهِ برقٌ يستوضح الاشياءَ",22,"ا",2,0],["لك راحة درَّت لها","عن كل أَنملة سحابه",23,"ب",2,0],["لَكَ رسمُ إحسانٍ تَمُنُّ به","فامنُنْ على عاداتك الحُسنى",24,"ا",1,0],["لكرزيِّنا فقحةٌ فاجرهْ","تحنُّ إلى الفَيْشَةِ الوافرهْ",25,"ه",1,1],["لك راحة وطفاء يا ابن محمد","قد رحت ضرارا بها ونفوعا",26,"ع",2,0],["لك راحة ما أن تزال بباطن","تسدي النوال وظاهر ملثومٍ",27,"م",1,0],["لك رأي يقظان إن ضعف الرأي","على حاملي الصليب صليب",28,"ب",1,0],["لِكَريمِ الأُصولِ وَالمالِكِ الطَو","دِ وَقُطبِ الجُيوشِ يَومَ انتِدابِ",29,"ب",1,0],["لكرامته خلق الله ال","أكوان وقد كانت عدما",30,"م",2,0],["لَكَ راحة خُلِقَت لَضَبط أَعنة","وَلِهَز مرهفةٍ وِبَذل حِباء",31,"ا",2,0],["لك ربّي ابرز المرئي","وكذا المخفّى لا عدد",32,"د",1,0],["لكريم الجدود هامي حَيَا الج","ود عظيم العلا جسيم الأَيادي",33,"د",2,0],["لك راضت رئاسة الدين منها","ما تعاصى على عظام الرجال",34,"ل",1,0],["لِكَريم جاه واصِفاً","قَد نِلت في الدُنيا نَجاه",35,"ا",2,0],["لك رِفقُ فنان وصولة ماردِ","فتكاد كالبركان تقتلع الثرى",36,"ا",1,1],["لَكَ رِدفٌ غادَرْتُه رَهْنَ غُصنٍ","وَهْوَ رَهْنٌ كما علمتُ ثقيلُ",37,"ل",1,0],["لك رعب في قلب كل عدو","كسنا البيض والقنا المهزوز",38,"ز",1,0],["لكرّتة من بعد أحدٍ تفرّقت","قريشٌ وكانتْ بين ماضٍ ومقبل",39,"ل",1,0],["لكريمة زهراء تاج محاسنٍ","قد أخجلتْ زهرَ الرياض نضاره",40,"ر",2,0],["لك رغم صنعك في حشاي محبة","ممزوجة بلواعج الأشواق",41,"ق",1,0],["لك راحة خير العطاء عطاؤها","وكذا مدام الكرم خير مدام",42,"م",1,0],["لك رأي كأنه الشهب تقضي","بالغنى والفنا بغير قتال",43,"ل",1,0],["لك راحة كالغيث يسكب منها","بيضاء تبسم في الزمان وتلمع",44,"ع",1,1],["لك راحة نبت الربيع نوالها","صلحت بصيبها الطلاح الضلع",44,"ع",1,0],["لَكَ رَحمَتَهُ وَنِعمَتَهُ","وَحَبيبَ اللَهِ مِن قِدمِ",45,"م",1,0],["لكِ رقةٌ تبتزّني لأقولَ ما","أمْلتْ إلي ّ مشاعري السرّية",46,"ر",3,0],["لك رصيدن بالحشا سهمه صعد","لك فوادي مستعدة ارهنه",47,"ن",2,0],["لَكِ رَبٌّ يَا رَبَّةَ الْحُسْنِ مِدِّي","مِنْ مُحَيَّاكِ صَحْوَةً لَا تَفُوتُ",48,"ت",1,0],["لكريم الآباء عالي الجناب","كلمات كالسابق الوثاب",49,"ب",1,1],["لك ربي لا يروِّعك الهوى","إنه أعذب ما في الأمل",50,"ل",1,0],["لك رب وما أحاسب عبدا","لست عنه في العالمين حويلا",51,"ل",2,0],["لك روضة الشعر البهيِّ","وقد رُزقتَ الأحرفا",52,"ف",2,0],["لَكَرِهْتُمْ نِسَاءَكُمْ مِنْ هَوَاهَا","وَلَجَدَّ السُّرَى لَهَا وَالرَّحِيلُ",53,"ل",1,0],["لَكَ رُتْبَةٌ فِي المَجْدِ جاوَزَ فَرْعُها","نَجْمَ السِّماكِ مُبارِياً وَلِحاها",54,"ا",3,0],["لكَ رَغم بُعدكَ صَبوتي وَغَرامي","ياجنّة الفردوسِ في أحْلامي",55,"م",2,1],["‏لك روضة معطارةٌ لَحَستْ يدي","‏ ‏ مِن عطرها ما عطَّرَ الوِجدانا",56,"ن",2,0],["لكريم ملأ الدنيا سنى","وترقى فوق هامات السحب",57,"ب",1,0],["لك رضوان زائرٌ ولقوم","هلكوا فيه منكرٌ وتكير",58,"ر",1,0],["لك روح فسيحة تَسَعُ الدنيا","إذا ضاق ساكنوها قلوبا",59,"ب",2,0],["لَكَ رحمةٌ عظمى تظلِّلُهم بها","ولهمْ نفوسٌ خشَّعٌ وقلوبُ",60,"ب",1,0]]}