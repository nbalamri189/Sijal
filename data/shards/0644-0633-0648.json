{"poems":[[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[47,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[30,"تقول كليب حين مثت سبالها","https://www.aldiwan.net/poem1306.html","الطويل"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[107,"أرى بمصر ولاة لا خلاق لهم","https://www.aldiwan.net/poem43133.html","البسيط"],[107,"يا منزل النفس ترضاه إلى أجل","https://www.aldiwan.net/poem43569.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85310","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54864","الطويل"],[108,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[128,"فتنتك تذكارات ميه","https://www.aldiwan.net/poem23746.html","مجزوء الكامل"],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[309,"يا صاحبي إن دمعي اليوم ينهمل","https://www.aldiwan.net/poem16875.html","البسيط"],[358,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[422,"أقول لصاحبي ورضيع كأسي","https://www.aldiwan.net/poem54079.html","الوافر"],[580,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177891","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56334","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109088","المتدارك"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104800","المديد"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110233","البسيط"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110613","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93702","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99085","المجتث"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144169","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94018","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100425","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100350","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100344","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100843","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100755","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100833","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100866","البسيط"],[3150,"","https://poetry.dctabudhabi.ae/diwan/poem/82369","الوافر"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136891","البسيط"],[3444,"","https://poetry.dctabudhabi.ae/diwan/poem/130736","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74057","الخفيف"],[3478,"","https://poetry.dctabudhabi.ae/diwan/poem/198221","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52990","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86283","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91729","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132133","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117963","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85092","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54414","الطويل"],[4929,"ارهاصات النهاية","https://www.poetsgate.com/ViewPoem.aspx?id=199351",""],[4929,"سيأتي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200127",""],[4935,"لسواك لا تحلو المراتب في الملا","https://www.poetsgate.com/ViewPoem.aspx?id=129514",""],[4984,"بشرى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189552",""],[5213,"قف بي على أبرق الحمى أو الاثل","https://www.poetsgate.com/ViewPoem.aspx?id=170512",""],[5277,"بحقّ وجهكِ سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=190801",""],[5277,"تطويحٌ وتلميح","https://www.poetsgate.com/ViewPoem.aspx?id=210330",""],[5277,"وقفاتٌ إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=211297",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5320,"بنت مصر","https://www.poetsgate.com/ViewPoem.aspx?id=41645",""],[5351,"دعوه يعد للعشرة","https://www.poetsgate.com/ViewPoem.aspx?id=203209",""],[5376,"تكالبتْ أممٌ والمجْدُ في حَلَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=188444",""],[5376,"بَلْقيسُ ألْقتْ جَمَالاً من خمائلِها","https://www.poetsgate.com/ViewPoem.aspx?id=196647",""],[5408,"لو مرة حاولت","https://www.poetsgate.com/ViewPoem.aspx?id=190757",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5410,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=139635",""],[5410,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=142234",""],[5411,"كفّي الّتي","https://www.poetsgate.com/ViewPoem.aspx?id=185428",""],[5842,"كي لا ينضب الماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=73684",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""],[6278,"جميلتي عمّان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86849&r=&rc=2",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["لسواءٌ إن استمدّ ذليلٌ","بذليل أو مُدَّ بالماء ثأط",0,"ط",1,0],["لِسَوارٍ مِنَ الغَمامِ تُزَجّي","ها جَنوبٌ كَما تُزَجّى العِشارُ",1,"ر",1,0],["لِسُؤبانِ أَغنامِ رَعَتهُنَّ أُمُّهُ","إِلى أَن عَلاها الشَيبُ فَوقَ الذَوائِبِ",2,"ب",1,0],["لَسَوَّدْتَهُ بِالْفَخْرِ فَابْيَضَّ وَجْهُهُ","بِأَسْمَرَ خَطِّيٍّ وَأَبْيَضَ صَارِمِ",3,"م",1,0],["لَسَوفَ يَلقَونَ يَوماً لَيسَ تَعصِمُهُم","فيهِ الدُروعُ وَلا تُنجيهِمُ الجُنَنُ",4,"ن",1,0],["لَسَوفَ تَقضي النَوى مِن بَعدنا عَجَباً","لِمُقفرٍ بِعوادي الدَهرِ مَسكونِ",5,"ن",1,0],["لسوف تنمين جسما","حَتّى تَكوني أتما",6,"م",2,0],["لِسُورِيَّةَ فخْرٌ بِمَا هِي أَحْرَزتْ","وغَيْرُ كَثِيرٍ أَنَّهَا اليَوْمَ تَفْخَرُ",7,"ر",1,0],["لسو أُلقيتْ وَسَط العُبا","ب، لعكرت صفْو العباب",8,"ب",1,0],["لسوف أسخر منه وهو يطلبني","ودون ذاك صفاحٌ وكثبان",9,"ن",1,0],["لسواك ما خفق الفؤاد","ولا تململ يا صبيه",10,"ي",2,0],["لسوف يسمع حتى الصم من غرري","آيات تلفظها أفواه خرسان",11,"ن",1,0],["لسوى أسنّتك المِجنُّ مضاعَفٌ","ولغير أسهمك السوابغُ تُصنَعُ",12,"ع",1,0],["لسوى هوائم لم امل فكأنما","خلقو على حسب الهوى ومرادي",13,"د",2,0],["لسوف تشرب بالكأس الذي شربوا","بها بها إن يكن نهل وإن علل",14,"ل",1,0],["لَسَوفَ يَعلم قَومي أَنّ مَن جَهلوا","مِقداره هُوَ فيهم دُرّة اليلبِ",15,"ب",1,0],["لسوفَ أُهدِي لك أمثالها","إن كان في مُدَّةِ عُمْري انفِتاح",16,"ح",1,0],["لسَوَّدْتُ الصحائفَ فيك هجواً","وإنِّي اليوم أهجى من جرير",17,"ر",1,0],["لسوءِ اختياري كان لي عنك مَذْهَبٌ","على أن قلبي لم يجد عنك مذهبا",18,"ب",2,0],["لسوى الحبّ ينفع الصبر ذخراً","وسوى اللحظ ينسج الدرع جنّه",19,"ن",2,0],["لسواك بعد الله لا أبدي ولا","أنهي ولا أشكو وبالاً أو بلا",20,"ل",2,1],["لَسَوفَ تَعَضُّ مِن نَدَمٍ عَلَيها","وَما تُغني النَدامَةُ إِن نَدِمتا",21,"ت",2,0],["لسواها الإسم دعي قدماً","وأبيح لها فتسماها",22,"ه",2,0],["لسواه عنه لا يلوي الزِماما","فقضى مِن حقِّه ما وجبا",23,"ب",2,0],["لسواه يا عاصراً حلبَ الفكر","بكفِّ الخسار تعصر خمرا",24,"ر",2,0],["لِسَوَاهُ جَلَّ مَرتَبَةً","نالَها مِن مُوهِبِ الكَرَمِ",25,"م",1,0],["لسوفَ تدري ثريا أن مَركبها","يجري وفي الغد أنواءٌ وأهوالٌ",26,"ل",1,0],["لسوى علياكم ما رشحت","وبها قد سجعت ورق الحما",27,"م",2,0],["لسوى أحشائه لم يلذع","بهناكم دام قمري الهنا",28,"ن",2,0],["لِسواك يُلطم بِالأَكُفِّ وَهَذِهِ","بيضُ الظُبا لك في جَبيني تلطم",29,"م",1,0],["لسؤدد ابني علي","قد جاء بالبهتان",30,"ن",1,0],["لسواي عندي من سوامِكُم قِرىً","وقِراي قُبلة ناظرٍ أو مَحجِرِ",31,"ر",1,0],["لسود أجفانه بيض الظبا شهدت","وكيف يجرح سيف غير مشهور",32,"ر",1,0],["لسوف يهون فيها الخطب حتى","تميط الداء عنك وتمتطيه",33,"ي",2,0],["لسوّفتموا لي القرب عنقاء مغرب","تزفّ على طول النوى وتحلِّقُ",34,"ق",1,0],["لسوف ابكيك يا نجل الوصي اسىً","عن مهجة سقطعت او مدمع نزفا",35,"ف",2,0],["لسوف يدرون عقباهم اذا فشلوا","ويعلم الاولى ظلمونا أي منقلب",36,"ب",1,0],["لسوف يبقى هجائي فيه ما بقيت","هذي القوافي الى آت من الحقب",36,"ب",1,0],["لسوف يرى سعيه بيننا","ويجزى من الحكم العادل",37,"ل",1,0],["لسوف تحول الحال فليهن قلبه","فما كل حالات الزمان بسرمد",38,"د",1,0],["لسوف يأتي زمان ان ذكرت","يوما اقام لك الشعب التماثيلا",39,"ل",2,0],["لسوّارٍ عَلى الأَعداءِ سَيفٌ","أَبادَ ذَوي العَدوَةِ فَاِضمَحَلّوا",40,"ل",3,1],["لسوف يقصد بيت الله منتقما","ممن أباح له سراً ولم يهب",41,"ب",1,0],["لِسُوسةَ وبها رأوا المقيلَ وقد","صفت بأحوازِها أوعارُ أبعادِ",42,"د",1,0],["لسوى المَجد لَيسَ يَرضون ضمّا","كلّما قيل زد هَوى وَعناقا",43,"ق",2,0],["لسوتكين نظمت الشعر ممتدحا","للحاجب الأريحي الضيغم البطل",44,"ل",1,0],["لسواكم ما رمتُ قط التفاتاً","وإليكم صرفتُ كل التفاتي",45,"ت",2,0],["لِسودِ اقلامِهِ بيضُ الصِفاح عَنَت","وَطَأطَأَت هامَة المُرّان وَالقضب",46,"ب",1,0],["لَسَوف إمّا يَرى الأَعداء ما مكروا","أَو لا فيحجز فيما بَيننا الأَجل",47,"ل",1,0],["لسوف ينشدها الحادي على بردى","ولا يمل على الأردن راويها",48,"ي",3,0],["لِسِوى سمي العز ما قالا نعم","ولمجتديه كلاهما ما قال لا",49,"ل",2,0],["لسوف أجازيكم بتغريق كلكم","ببحر دموع ما لا دناه نم حد",50,"د",1,0],["لِسواها قَطُّ لا يُفتَحُ باب","فَوقَ أَبراجٍ عَلَت أَرتاجُها",51,"ه",2,0],["لسوى نظمِ مدحهِ أَهجرُ النظْ","مَ فما مدحُ غيرهِ غير هُجرِ",52,"ر",1,0],["لَسوَّدَني تسويدُ مدحِك في الورى","فإضْتُ بوجهٍ من ولائكَ مبيضِّ",53,"ض",1,0],["لَسَوفَ تحصُدُ محصولَ الذي زَرَعَتْ","يداكَ أضعافهُ من جنسِ ما زُرِعَا",54,"ع",2,0],["لسوفَ يُغَنِّيْ الوجودُ لهُ","وتشدو العصافير لحناً طروبا",55,"ب",2,0],["لسواك لا تحلو المراتب في الملا","يامن تفرد بالسعادة والملا",56,"ل",2,1],["لسوء التصرف منا دروس","فمن فِعْلِ سوء نَبَا بِكَ دهر",57,"ر",1,0],["لسوف أقذفها في البيد بعملة","كأنها السيل إذ ينحط عن جبل",58,"ل",1,0],["لسواكِ لا تعنو الجباهُ تذلّلا","ولغير بابك لم أقفْ متسولا",59,"ل",2,1],["لسواكِ ما هشَّ الفؤادُ صبابةً","وكأنّ غيركِ لم تلدْ حوّاءُ",60,"ا",2,0],["لسواكَ لا تعنو الوجوهُ وتركعُ","والساجدونَ على جلالِكَ خُضَّعُ",61,"ع",1,1],["لَسَوْفَ تَأْتِي ِبهَا الأَيَّامُ كَاسِفَةً","لِتنْشُدَ الظِلَّ في مجْرى سَوَاقِيهِ",62,"ي",2,0],["لسوف أصوغ لجيدك عقدا","حلاه انتصار وحب وبِشر",63,"ر",1,0],["لسوف يعد آلافًا","ولن يحظى بما انْتَظَرَه",64,"ر",2,0],["لسوف يذكرك التاريخ في كتبٍ","ما خطَّ طفلٌ بما في عرقِه سكبا",65,"ب",2,0],["لسوف يرجعُ ماضِ المجدِ في يمنٍ","فعزةُ الدينِ مرهونٌ بباذلِها",66,"ل",3,0],["لِسِوَاكَ ما صاحَتْ قصَائدُ رَغْبتي","وأتيْتُ في حِبْرِ الجُروحِ أُسَطّرُكْ",67,"ك",1,0],["لسوف تبقى مثالاً للحياة كما","تبقى الحقيقة مثلي سرمداً أبدا",68,"د",2,0],["لسوف نرى حدود الكون","نعلو بالهوى قدرا",69,"ر",2,0],["لسوف نعبر أياماً نعايشها","ونلتقي في مدى الآتي ونكتمل",70,"ل",1,0],["لِسِواكَ ما حَشَّدْت نَسْغَ مَشاعِرٍ","وَسَفَحْتُ شِعْرًا لِلزَّمان الْعائِدِ",71,"د",1,0],["o لسوف يكتشف الباغون أن لهم","نار الحساب وفي الرمضاء إبقاء",72,"ا",2,0],["لسومرَ مِنْ عظيمِ الذّكْرِ فيهِ","حكاياتٌ لآتٍ يبتلينا",73,"ن",2,0],["لسويعة عاد الحنين إلى الورا","قدَّ المدامع في الزمان وما سلا",74,"ل",2,0],["لِسواهُ إن هي عَدَّدت أربابها","هو ذلك الحسن الزكيُّ المجتبى",75,"ب",2,0]]}