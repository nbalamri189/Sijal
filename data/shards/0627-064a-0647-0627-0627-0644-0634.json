ِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[6315,"محاريب الحيرة .. حيرة الفراديس!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87576&r=&rc=1",""]],"verses":[["أَيُّها الشانِئُ المُبلِّغُ عَنّا","عِندَ عَمرَوٍ وَهَل لِذاكَ اِنتهاءُ",0,"ا",2,0],["أَيُّها الشادِنُ الَّذي رامَ صَرمي","وَأَبى لِلوِصالِ أَن يُستَداما",1,"م",2,0],["أَيُّها الشَرقِيُّ شَمِّر لا تَنَم","وَاِنفُضِ العَجزَ فَإِنَّ الجِدَّ قاما",2,"م",2,0],["أَيُّهَا الشَّاعِرُ الفَتَى عِشْ وَزِدْنَا","مُبْدَعَاتٍ عَلَى تَوَالِي السِّنِينَا",3,"ن",2,0],["أيها الشامتون ما نَضَبَ البح","ر ولا يُتَّقَى عليه النُّضوبُ",4,"ب",1,0],["أيها الشيب لِم حللتَ برأسي","إنما لي عشرٌ وعشرٌ وبَنْجُ",5,"ج",1,0],["أيها الشيْبُ قد ذَعَرتَ ظباءً","سَمِعَتْ فيّ دُونها تهديدَكْ",6,"ك",1,0],["أيها الشاتميَّ في كل حينٍ","يتحدَّونني وكلِّ أوانِ",7,"ن",1,1],["أَيُّها الشَّعْبُ ليتني كنتُ حطَّاباً","فأهوي على الجذوعِ بفأسي",8,"س",2,1],["أَيُّها الشَّعْبُ أَنْتَ طِفْلٌ صغيرٌ","لاعبٌ بالتُّرابِ والليلُ مُغْسِ",8,"س",1,0],["أيها الشعب إن أردت حياة","فتقدم إلي الأمام الأمام",9,"م",1,0],["ايها الشاعر الحفي القدير","باسمك اليوم يهتف الجمهور",10,"ر",1,0],["ايها الشعب لا يثبطك يأس","انما في الموت الملم حياة",11,"ه",1,0],["ايها الشعر انك ابن شعوري","تغتذي من كآبتي وسروري",12,"ي",1,0],["ايها الشعر انت عزي ولكن","في بلاد بعيدة عن بلادي",13,"د",2,0],["ايها الشاعر العظيم سلام","من محب لآي شعرك تال",14,"ل",1,0],["ايها الشرق كنت والغرب داج","مطلع النور في السنين الخوالي",14,"ل",2,0],["ايها الشيخ ان قلبك","اقسى من الحجر",15,"ر",1,0],["ايها الشيخ انت تسبح","في عيلم زخر",15,"ر",1,0],["ايها الشيخ لا سلا","م لمن فلكه انكسر",15,"ر",1,0],["ايها الشيخ حم ما","كنت تخشى فلا مفر",15,"ر",1,0],["ايها الشعر انت","سلوة ايامي الاخر",15,"ر",1,0],["أَيُّها الشَجِيُّ أَفِق","مِن عَناءِ ما تَجِدُ",16,"د",1,0],["أَيُّها الشَرقُ اِنتَبِه مِن غَفلَةٍ","ماتَ مَن في طُرُقاتِ السَيلِ ناما",17,"م",2,0],["أيها الشعر الذي كفنته","مقسما لا قلت شعرا بعدها",18,"ه",2,0],["أيها الشاكي من الدهر استرح","كلنا يا أيها الشاكي سواء",19,"ا",2,0],["أيها الشاعر تغفو","تذكر العهد وتصحو",20,"و",1,0],["أيها الشاعر خذ قيثارتك","غن أشجانك واسكب دمعتك",20,"ك",1,0],["أيها الشاعر كم من زهرة","عوقبت لم تدر يوماً ذنبها",20,"ه",2,0],["أَيُّهَا الشَّاعِرُ الْمُجِيدُ تَدَبَّرْ","وَاجْعَلِ الْقَوْلَ مِنْكَ ذَا تَحْكِيمِ",21,"م",1,1],["أَيُّها الشاتِمُ وَهناً","مِن أَبي إِسحاقَ بَرقا",22,"ق",2,0],["إيُّها الشَيبُ لا يَريبُكَ مِن كَف","في مِقَصٌّ وَلا يُواريكَ خِطرُ",23,"ر",1,0],["أَيُّها الشعر أَنت لست متاعاً","يُشتَرى أَو يباع في الأسواق",24,"ق",1,0],["أَيُّها الشعر سلوِّي","أَنتَ في ساعة همي",25,"ي",1,1],["أيها الشيخ لا تذمَّ المنايا","فالمنايا نهاية الآلام",26,"م",1,0],["أَيُّها الشعب طال نومك فايقظ","لِلمَساعي فاللَيل صار نهارا",27,"ر",2,0],["أيها الشرق تأملْ أتراها","أنت من داراتها أين سناها",28,"ه",2,0],["أيُّها الشوق خَلِّ عنكَ ودعني","لا خادعاً ولا مخدوعا",29,"ع",2,0],["أيها الشيطانُ ما أعظم ما","قُلْتَهُ ما قُلتَ لغواً أو سفاها",30,"ا",3,0],["أيها الشاعرُ الكئيبُ مضى اللي","لُ وما زلتَ غارقاً في شجونِكْ",31,"ك",1,1],["أَيُّهَا الشَّامِتُ المُعَيِّرُ بِالشَّي","بِ أَقِلَّن بِالشَّبابِ أفتخِارا",32,"ر",2,1],["أَيُّهَا الشَّاعِرُ الَّذِي كَانَ حِيناً","يَتَغَنَّى وَكَانَ يَنْحَبُ حِيناً",33,"ن",2,0],["أَيُّهَا الشَّاعرُ الْمُقلُّ وَلَوْ أَكْثَرَ","لَمْ يَأْتِ تَالياً في السِّبَاقِ",34,"ق",1,0],["أَيُّها الشامِتُ هَل تَأمن مِن","حدثانِ الدَهرِ نَحساً وَرَهَق",35,"ق",1,0],["أيها الشاعرانِ قد صَوّح الدوْ","حُ وولّت بشاشةُ البستان",36,"ن",1,0],["أيها الشاعران في جنّةِ الْخُلْ","دِ هَناءً بالْخُلْدِ والرِّضوان",36,"ن",1,0],["أيّها الشاعرأزمعت السرى","وتخيرت على البيْن الأوانا",37,"ن",2,0],["أيها الشَّرقُ، أذِعْهُ نَبَأً","يَقْرَعُ الآذانَ في الغرب صداهْ",38,"ا",2,0],["أيُّها الشرقُ، قد ركدْتَ طويلاً","يأسَنُ الماءُ إنْ أَطال الرُّكودا",39,"د",2,0],["أيُّها الشعرُ، ذكِّر الشرقَ ذكِّ","رهُ بماضيه، عَلَّه أنْ يَعودا",39,"د",2,0],["أيها الشاعرُ، انطلق في السَّمْوا","تِ، وخلّ الأنام فوق الصَّعيد",40,"د",1,0],["أيها الشعرُ، ما عهدناك إلا","ساحرًا تبعثُ اللَّظى في الجليد",40,"د",1,0],["أيّها الشّيطان ما أعظم ما","قلته ، وما قلت لغوا أو سفاها",41,"ا",3,0],["أيّها الشّوق خلّ عنك ودعني","وامض لا خادعا ولا مخدوعا",42,"ع",2,0],["أيّها الشاعر الذي كان يشدو","بين ضاح من الجمال وضاحك",43,"ك",1,1],["أيّها الشّيبُ لا يَرِيبُكَ منْ كَفّ","ي مِقَصٌّ، ولا يُواريكَ خِطر",44,"ر",1,0],["أَيُّهَا الشَّامِتُ المُعَيِّرُ بِالشَّ","بِ أَقِلَّن بِالشَّبابِ أفتخِارا",45,"ر",2,1],["أيها الشعر أنت أشجى غناء","أنا فيه أبث صادق وجدي",46,"ي",1,0],["أَيُّها الشامِتُ المُعَيِّرُ بِالدَه","ر أَ أَنتَ المُبَرَّأُ المَوفورُ",47,"ر",1,0],["أيها الشيخ الذي دستوره","إنما الإفتاء توجيه ونصح",48,"ح",1,0],["ايها الشادن الذي","لي قد نم واسترق",49,"ق",1,0],["أَيُّها الشاخِصونَ لِلكَونِ سُخرا","من خِلالِ القَذائِفِ الصَمّاءِ",50,"ا",2,0],["أَيُّها الشاطىءُ المسرّ إِلى المو","جِ حَديثَ العُشّاقِ وَالأَحبابِ",51,"ب",1,0],["أيها الشيخُ دعوةً من مُحبٍّ","وخليل خال من التنكيت",52,"ت",1,1],["أَيُّها الشامِتُ بِالمَوتِ اِنتَظِر","فَالرَدى كَأسُ مُديرٍ ذي اِنتِقالِ",53,"ل",1,0],["أيها الشرق خطم القيد وانهض","للمعالي لا عاش كل جبان",54,"ن",1,0],["أَيُّها الشَهمُ بِالمَحامِدِ أَبشِر","وَاِشكُرِ اللَهَ أَنتَ خَيرُ شَكورِ",55,"ر",1,0],["أيها الشاعر الذي كان يوما","قمّةً لا تنال بالنظرات",56,"ت",1,0],["أيها الشاربون من كرمِ الني","ل رويداً فالظامئون كثير",57,"ر",1,0],["أيّها الشك يا بن أيّام عمري","ولَياليّ في الشقاء الطويل",57,"ل",1,0],["أَيُّها الشَيخُ كَم تَرومُ وَتَبني","لَيسَ مِنكَ الدُنيا وَلا أَنتَ مِنها",58,"ه",2,1],["أَيُّها الشَيخُ المُعَل","لِلُ نَفسَهُ وَالشَيبُ شامِل",59,"ل",1,1],["أيها الشخص العقول استمع مالك أقول","جنة الدنيا الخمول",60,"ل",1,1],["أَيُّها الشيعَةُ لا أَع","ني بِقَولي مَن عَداها",61,"ا",3,0],["أيها الشاعرون يا عاشقي النب","ل وروح الخيال والأنغام",62,"م",1,1],["أيُّها الشيخُ، لقد علَّمتن","كيف نرعى حُرمَةَ المستضعفين",63,"ن",1,0],["أيُّها الشيخُ الذي أهدى لن","صُوَراً بيضاءَ من علمٍ ودين",63,"ن",1,0],["أيها الشيخُ الذي ودَّعَن","عاليَ الهمَّةِ وضَّاح الجبين",63,"ن",1,0],["أيُّها الشاعر الذي بات يَبكي","ما لعينيكَ تُخْجِلانِ السَّحابا؟!",64,"ب",2,0],["أيُّها الشاعر الحزينُ، ترفَّقْ","بقوافيكَ، لا تَ