3er&doWhat=shqas&qid=68182&r=&rc=174",""],[402,"أعظم به إذ تولى الأمر أجمعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54033&r=&rc=885",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""],[6333,"جرح وقصيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7035&r=&rc=6",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""],[6355,"الطريق إلى مهجتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66572&r=&rc=32",""],[6355,"لِمَ أعْرَضَتْ عنكَ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66676&r=&rc=136",""]],"verses":[["أُغلوطَةٌ لا نَهضَ مِن عَثرِها","قَد سَبَقَ السَهمُ يَدَ النابِلِ",0,"ل",1,0],["أَغلَبُ لا يَخشى وَعيدَ السَفَرِ","كَأَنَّما يَدعونَهُ بِالزَجرِ",1,"ر",1,1],["أَغَلَّ إِلى القَلبِ المَنيعِ مِنَ القَنا","وَأَجرى إِلى الآحالِ مِن قُضُبِ الهِندِ",2,"د",1,0],["أَغلَقَت بابَها عَليَّ وَقالَت","إِنَّ خَيرَ النساءِ ذاتُ البُعولِ",3,"ل",1,0],["أَغلى وَأَثمَنُ مِن تَجارِبِ عِلمِهِ","يَومَ الفَخارِ تَجارِبُ الحَلّاقِ",4,"ق",1,0],["أَغلَيتَ بِالعَدلِ مُلكاً أَنتَ حارِسُهُ","فَأَصبَحَت أَرضُهُ تُشرى بِميزانِ",5,"ن",1,0],["أغلى الجواهر أرخصوه وما","وما ضنوا بديباج ولا شذر",6,"ر",1,0],["أَغْلى مَفَاخِرِ حِمصَ فِي ال","دُّنْيَا وَأَغْلاهَا محلهْ",7,"ل",2,0],["أَغْلَى النيَابَةَ سَعُدُ أنَ يَرْأَسُهَا","وَشَرَّفَ الْحُكْمَ سَعْدٌ حِينَ يَحْتَكِمُ",8,"م",1,0],["أغليتَ يا رُزْءُ التصبُّرَ مثلما","أَرْخصْتَ دُرَّ الدمعِ في الآماقِ",9,"ق",1,0],["أُغلي السِباءَ بِكُلِّ أَدكَنَ عاتِقٍ","أَو جَونَةٍ قُدِحَت وَفُضَّ خِتامُها",10,"م",3,0],["أغلقَ بابي في وجه مطلبي","وصدَّ مع من يصدّ مفتاح",11,"ح",1,0],["أغلقتُ حانوتي لطو","ل كساده وفتحتُ عَمْرا",12,"ر",2,0],["أغلاءٌ وبلاءٌ","وبريديٌّ ضرُوطُ",13,"ط",1,1],["أغلّ الثناءَ الذي تعلمو","ن أنْ ليس منه قليلٌ يقلُّ",14,"ل",1,0],["أَغلَيتَ حينَ تَواكَلَتني وائِلٌ","إِنَّ المَكارِمَ عِندَ ذاكَ غَوالي",15,"ل",2,0],["أَغلى المَواهِب وَالعُقولِ رَأَيتُها","سَكَنَت قُصورَ مَهارِق وَمِدادِ",16,"د",1,0],["أُغل فلا أُسقى من الماءِ شربة","ودجلة تجري بالنمير أماميا",17,"ي",2,0],["أغلى لدى الكتّاب إن ظفروا بها","من ريشة الألماس عند الغِيد",18,"د",1,0],["أَغلَبُ الحَيِّزَينِ ما كُنتَ فيهِ","وَوَلِيُّ النَماءِ مَن تَنميهِ",19,"ه",1,1],["أُغلِقَ دوني بابُ الصَفاءِ كَأَن","لَم يَكُ بَيني وَبَينَهُ سَبَبُ",20,"ب",1,0],["أَغِل شِعري غَلاءَهُ إِنَّ بِالدو","نِ وَأَشباهِهِ يُباعُ الدونُ",21,"ن",1,0],["أُغلِقَ بابُ السُّرورِ دونَهمُ","فكُنْ لِبابِ السُّرورِ مِفتاحا",22,"ح",2,0],["أَغلَقتَ بابَ العُذرِ مَع تَصحيفِهِ","وَالجودُ عِندَكَ بابُهُ لا يُغلَقُ",23,"ق",1,0],["أَغلى عَذارى الشِعرِ إِنَّ مُهورَها","عِندَ الكَريمِ وَإِن رَخُصنَ غَوالي",24,"ل",2,0],["أغلى اللآلئِ قيمةً ما ضمَّ من","تلك القذائفِ تاجُها اللمَّاحُ",25,"ح",1,0],["اغلُل عَصاكَ إِلى لِسانِكَ إِنَّما","يَلقى الهَوانَ الفاحِشُ المُتَبَذِّلُ",26,"ل",1,0],["أَغلَقَت مِن دونِ أَغراسِها","حَلَقاً أُرتِجنَ بَعدَ اِعتِقام",27,"م",1,0],["أغْلَقُوا بابَ الهُدَى مِنْ دُونِهِمْ","بَعْدَ ما كانُوا بهِ يَسْتَفْتِحُونا",28,"ن",2,0],["أَغلَبُ أَوفى عَلى بَراثِنِهِ","يَفتَرُّ عَن كُلَّحِ الشَبا روقِ",29,"ق",1,0],["أَغلِقي عَنّي بِوَصلٍ","بابَ سُقمي وَأَذاتي",30,"ت",2,0],["أغلى الذخائرِ من ميراثِ نهضته","رفاتُ مستشهدٍ في الحقِّ مقتتلِ",31,"ل",1,0],["أغلى الذخائر في كنوز فخارِها","تاجٌ يُجمِّلهُ بنوركَ مفرِقُ",32,"ق",1,0],["أَغْلَى كُنُوزِ الشَّرْقِ فِي نَفْسِهِ","وَكَفُّهُ مِنْ دِرْهَمٍ صِفْرُ",33,"ر",1,0],["أَغْلى الْجَوَاهِرِ أَرْخَضُوهُ وَمَا","ضَنَّوا بِديبَاجٍ وَلا شَذْرِ",34,"ر",1,0],["أَغْلَى تُرَاثٍ فِي يَدَيْكُمْ فَاحْرِصُوا","مِنْ قَدَّرَ الذُّخَر تَفَادَى الفَقْدَا",35,"د",2,0],["أَغْلَى عَلَى مَاءِ الَّلآلِيءِ صَافياً","مَا فَاضَ ثَمَّةَ مِنْ مَشُوبِ المَاءِ",36,"ا",2,0],["أغل مهر العلى إذا كنت شهماً","هان من نام في الطريق وذلا",37,"ل",2,0],["أغلى الجوائز من جمال: قُبْلَةٌ","طُبِعَت على هذا الجبينِ الطاهر",38,"ر",1,0],["أغلبُ الظَّنِّ، لعمري، أنها","خيرُ مَنْ صاحَبَه أو ودَّعه",39,"ع",2,0],["أغلقت بابا البيت والدرس في","وجهي .. سألقي الدرس والموضعا",40,"ع",2,0],["أَغْلِ شِعرِي غَلاؤهُ، إنّ بالدّونِ","وَأشْبَاهِهِ، يُبَاعُ الدّونُ",41,"ن",1,0],["أغليت نعمى الهوى عندي ومحنته","فحبّ ما مرّ منه حبّ ما عذبا",42,"ب",2,0],["أغلى منال لنا في الكون قربكمو","نرضاه لو كانت الأقدار ترضينا",43,"ن",2,0],["أَغلتْ مكارمُه المهورَ على","تزويج بِكرِ القول بالفعلِ",44,"ل",1,0],["أَغلَيتَ يا شَرَفَ المُلوكِ مُهورَها","في بَثِّكَ الإِنعامَ وَالإِرغاما",45,"م",2,0],["أغلب لا يفرح إن نال ولا","يجزع إن نيل ببعض الضر",46,"ر",1,0],["أغليتَ سعرَ الشعرِ بل أَعليتَه","لما بذلتَ لأهله الأثمانا",47,"ن",2,0],["اغليوم اذللت المعالي فلم تزل","على بابك العالي لهنَّ عثور",48,"ر",1,0],["أَغلاهُ ما أَبقى بِمَض","رِبِهِ القِراعُ مِنَ الفُلولِ",49,"ل",1,0],["أَغلقتَ باب الوِصال دوني","فَسُدَّض للصّبر كلُّ باب",50,"ب",1,0],["أَغلى الأَداهِمَ مَن أَسَرتَ وَأُرخِصَت","بيضُ الصَوارِمِ مِن نهابِ العَسكَرِ",51,"ر",1,0],["أغلقت باب علوم ثم باب هدى","أخذت مني محب الدين من وطني",52,"ن",2,0],["أغلوا الفداء ومن أغلى الفدا","ولم يثنه من مطلب لا بدّ منتصر",53,"ر",1,0],["أَغَليلاً وَالماءُ فَوقَ الثَنايا","وَهَواناً بَينَ القَنا وَالقُضبِ",54,"ب",1,0],["أَغلِق بِنا ذا البابَ ما خَلفَهُ","فَتحٌ فَلا تَتعَبُ في الفَتحِ",55,"ح",1,0],["أَغلَت عَلى السُلوانِ شَوقَكُمُ فَما","باعَت كَما أَمَرَ الغَرامُ مَن اِشتَرَت",56,"ت",1,0],["أغلى مفاخر حمص في الديما وأعلاها ملحه","لله ذاك النهر ما",57,"م",2,0],["أغلى هدايا حاكمٍ ونظامِ","للناس ، حُكْمُ شَريعَةِ الإسْلامِ",58,"م",1,1],["أغلى الهدايا للشُّعوبِ ، حمَايةٌ","للمالِ ، والأعراضِ ، والأَفْهامِ",58,"م",1,0],["إغلاقُ أبوابِ المفاسِدِ والهوى","ومنافِذِ التَّضليلِ والإيهَامِ",58,"م",1,0],["أغلى الهدايا للبلادِ وأهْلهَ","تطبيقُ شرع الله في الأحكامِ",58,"م",1,0],["أغلى منَ الدُّنيا ، ومن لذَّاتِه","وبرِيقِ ما فيها منَ الأوهامِ",58,"م",1,0],["أغْلى الهَدَايا حِسْبَةٌ محمُدَةٌ","بينَ الأنامِ ، تشُدُّ أزْرَ نِظامِ",58,"م",1,0],["أغلقوا هيئتتكم فهي لكم","ملعبٌ,أنت عليهِ اللاعبون",59,"ن",1,0],["أغلقوا بوابة \" الحافظ \" فيه","من كتاب الله ما يتلوهُ تالِ",60,"ل",1,0],["أغليتُها بَذْلاً وأعليتُها","فضلاً وللأشعارِ أسعارُ",61,"ر",1,0],["أغلى الهدايا لحظة الأنس","لطفت كذوب النفس في النفس",62,"س",1,0],["