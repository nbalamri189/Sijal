{"poems":[[55,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[65,"وسرب عذارى من عقيل سمعنني","https://www.aldiwan.net/poem46076.html","الطويل"],[65,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[65,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[65,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[51,"إنما الذنب على من جناه","https://www.aldiwan.net/poem63185.html","المديد"],[68,"فسد الشرب حين أعوزت الراح","https://www.aldiwan.net/poem39049.html","الخفيف"],[76,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[107,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[50,"يا واضعا بيض القطا","https://www.aldiwan.net/poem62545.html","مجزوء الكامل"],[52,"فسد الزمان وساد فيه المقرف","https://www.aldiwan.net/poem62325.html","الكامل"],[48,"لو كان لي أمر يطاوع لم يشن","https://www.aldiwan.net/poem23315.html","الكامل"],[48,"أين عمر لما دعا أم عمر","https://www.aldiwan.net/poem23462.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54757","الكامل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10134","الوافر"],[108,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[56,"إذا نزلَ الغريبُ بأرضِ حمصٍ","https://www.poetsgate.com/ViewPoem.aspx?id=14312",""],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[242,"أيارب أذا العزه","https://www.aldiwan.net/poem18833.html","الهزج"],[242,"سهام الردى تخطي الذي قصد الهبطي","https://www.aldiwan.net/poem18843.html","الطويل"],[242,"أذا العرش إن تبسم ثغور العرائش","https://www.aldiwan.net/poem19723.html","الطويل"],[285,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[315,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[342,"وحرف قد بعثت على وجاها","https://www.aldiwan.net/poem45435.html","الوافر"],[382,"شعار المدح من كرم الطبيعه","https://www.aldiwan.net/poem59346.html","الوافر"],[422,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[445,"بشير يوم بملك دهر","https://www.aldiwan.net/poem34907.html","مخلع البسيط"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[484,"فسد الزمان وأهله","https://www.aldiwan.net/poem37028.html","مجزوء الكامل"],[563,"عندنا سر عجيب خطرا","https://www.aldiwan.net/poem34522.html","الرمل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83316","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122780","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96977","الطويل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38401","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64730","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64723","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46567","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35777","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108836","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108834","البسيط"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110697","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2432,"","https://poetry.dctabudhabi.ae/diwan/poem/147046","الكامل"],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138890",""],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132213","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145048","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89041","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110040","الكامل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33119","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76439","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70166","الوافر"],[351,"","https://poetry.dctabudhabi.ae/diwan/poem/18855","الطويل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203270","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91047","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83423","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133150","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57951","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72428","البسيط"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4852,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=214379",""],[4852,"طاووس خزف","https://www.poetsgate.com/ViewPoem.aspx?id=214455",""],[5002,"ياطير","https://www.poetsgate.com/ViewPoem.aspx?id=205176",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5431,"وتلى العراق وكبّره ...","https://www.poetsgate.com/ViewPoem.aspx?id=197650",""],[5518,"وسل القصائد/صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=193963",""],[5616,"شموخا أيتها المآذن","https://www.poetsgate.com/ViewPoem.aspx?id=204845",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[6052,"نحتُّ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=50324",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""]],"verses":[["فَسَدَّدَ رُمحاً لَم يَكُن بِمُثَقَّفٍ","وَجَرَّدَ عَضباً لَم يَكُن بِيَماني",0,"ن",2,0],["فَسُدَّتْ خَصاصَاتُ الخُدورِ بِأَعْيُنٍ","حَكَتْ قُضُباً في كُلِّ قَلْبٍ لَها غِمْدُ",1,"د",1,0],["فسدَّ بِكَ الحيُّ العَباديُّ في العُلا","مَكانَ الخَفاجيِّ الأغَرِّ المُتَوَّجِ",2,"ج",1,0],["فسَدَ الأنامُ فكُلُّ مَنْ صاحَبْتُهُ","راجٍ يُنافِقُ أو مُداجٍ خاشِ",3,"ش",1,0],["فسَدَ الزَّمانُ فليسَ يأمَنُ ظُلْمَهُ","أهْلُ النُّهى وبَنوهُ مِنهُ أظْلَمُ",4,"م",1,0],["فَسَدَحنا في مَقامٍ واحِدٍ","مِنكُمُ سَبعينَ غَيرَ المُنتَحَل",5,"ل",1,0],["فسدْ وشدْ وابقَ ما دامَ الزمانُ ففي","بقياك للدِّين والدُّنيا عنايات",6,"ت",1,0],["فَسَدَ الناسُ وَصاروا إِن رَأَوا","صالِحاً في الدينِ قالوا مُبتَدِع",7,"ع",1,0],["فَسَدَ الناسُ جَميعاً فَأَمسى","خَيرُهُم مَن كَفَّ عَنّا أَذاهُ",8,"ه",1,0],["فَسَدَ الشَربُ حينَ أَعوَزَتِ الرا","حُ وَحالَت قَواعِدُ النَدمانِ",9,"ن",1,1],["فَسُد وَطَإِ التيجانَ عِزّاً وَذُد وَجُد","فَسيحَ فِناءِ المُلكِ عالي يَدِ الأَمرِ",10,"ر",1,0],["فسَدَ الأمرُ فهل من مُصلِحٍ","أصلحوه يا شبابَ المُسلِمينْ",11,"ن",1,0],["فَسَدَ الخَلائِقُ كُلُّهُم","فَاِنظُر لِنَفسِكَ مَن تُؤاخي",12,"خ",2,0],["فَسَدَ الزَمانُ وَسادَ فيهِ المُقرِفُ","وَجَرى مَعَ الطِرفِ الحِمارُ الموكَفُ",13,"ف",1,1],["فَسَدَ الزَمانُ فَلا رَشادٌ ناجِمٌ","بَينَ الأَنامِ وَلا ضَلالٌ مُنجِمُ",14,"م",1,0],["فَسَدَ الأَمرُ كُلُّهُ فَاِترُكوا الإِع","رابَ إِنَّ الفَصاحَةَ اليَومَ لَحنُ",15,"ن",1,0],["فسَدِيمُهَا كَغُبَارِ دُرٍّ","سَاطِعٍ فِي مَسْطَعِ",16,"ع",1,0],["فَسَدَ التَّوَسُّل فِي الْبَلدْ","هَيْهَاتَ يَصْدقُ مَنْ وَعَدْ",17,"د",1,1],["فَسَدِّد لِاِستِ أَشعَثَ أَيرَ بَغلٍ","وَآخَرَ في حِرِ أُمِّ أَبي الصَناعِ",18,"ع",1,0],["فسدَ القياسُ؛ وما أصا","بَتْ في حَزِيرانَ المعاير",19,"ر",1,0],["فَسدِّدْ لاسْتِ أَشَعَثَ أ... بَغلٍ","وآخرَ في حرِ امِّ أبي الصَّناعِ",20,"ع",1,0],["فَسُدَ الناسُ فَالمَ","وَدّاتُ فيهِمُ عَلى دَخَن",21,"ن",1,0],["فَسَدِّدْهُ وَأَيِّدْهُ","وَثَبِّتْهُ كَمَا الرَّزَّهْ",22,"ز",2,0],["فَسَدِّدْ إِلَى الأَوْجَالِ سَهْمَ عِنَايَةٍ","مَرِيشاً بِعَزْمٍ لاَ يَطِيشُ وَلاَ يُخْطِيِ",23,"ط",2,0],["فَسَدِّدْ إِلَى مَنْ حَلَّ فِيهِ مِنَ الْعِدَا","مِنَ الرُّعْبِ سَهْماً مُصْمِياً غَيْرَ طَائِشِ",24,"ش",1,0],["فَسُدَّتْ مَطالِعُ ذاكَ الْجَوادِ","وَفُلَّتْ مَضارِبُ ذاكَ الْحُسامِ",25,"م",1,0],["فسددت مطلع النفاق وأنت لا","تنبو ظباك ولا العزيمة تنكل",26,"ل",1,0],["فَسَدَّدَ إِذ شَرَعنَ لَهُنَّ سَهماً","يَؤُمُّ بِهِ مَقاتِلَ بادِياتِ",27,"ت",1,0],["فَسَدُّ الأُذنِ عن ثلبٍ وذمٍّ","بشرع اللَه أَحكَمُها صنيعه",28,"ع",2,0],["فَسَدَتْ معاملة الحسان لمَفْرِقٍ","نَزَلَ البياضُ به مكان سواده",29,"د",2,0],["فَسُدِّدَتْ كفُّه بصنعٍ","وَأُدْهِشَت نفسُهُ بذُعْرِ",30,"ر",1,0],["فسدَ الناسُ بعدكم فاستوى في ال","عيش مَن سرَّني نفاقاً وضَرَّا",31,"ر",2,0],["فسد الزمان وأهله","أسفي عليه وأهله",32,"ل",2,1],["فسداه أوّلاً قد مده","ربنا من ذاته نورا برى",33,"ر",2,0],["فَسَدَّ ثُغورَ المُلكِ بَعدَ اِنثِلامِها","وَجازَ إِلى دارِ الوَغى وَهوَ ثالِمُ",34,"م",1,0],["فَسَدَدتَ عَوراتِ الثُّغُور وَلَم يَكُن","في فِعلِكَ المَحمُودِ بِالمَذمَومِ",35,"م",1,0],["فسدت عليه السبل من كف حيدرٍ","أطاحت برغم الأنف منها سبالها",36,"ل",3,0],["فسدلنَ أسباباً إليَّ ضعيفةً","إمَّا وهتْ لم يلقَ لي من عاذرِ",37,"ر",1,0],["فَسَدَّها حينَما قَد ظَنّها خُرِقَت","بِبَلعهِ الشَّعْر حتّى قاءَهُ شِعرا",38,"ر",2,0],["فَسَدَ الزَّمانُ وأَهلُهُ","فاخْتَرْ لنفسِكَ مَنْ تُؤاخي",39,"خ",2,0],["فَسَدَتْ آراءُ غِرٍّ","أَطْمَعَتْهُ في صلاحي",40,"ح",2,0],["فَسدت الأَخلاق","وَكثر النفاق",41,"ق",1,0],["فَسدَّت عَلَيهِ وَجهَ كُلِّ مُحجَّةٍ","رِماحُ اِبنِ يَحيى جَعفَرٍ وَمَناصِلُه",42,"ل",2,0],["فسد وافتخر واقبل هدية شاعرٍ","له رفق محكوم وصولة حاكم",43,"م",1,0],["فَسُدْ وتِهْ وافتخر واسلم وعزَّ وطب","وكِدْ وخذ وانتصر واعظم وفز ودُم",44,"م",1,0],["فسدد رأيه يا رب لطفا","وجنبه الضلالة والغوايه",45,"ا",3,0],["فَسَدَت تَصانِيفُ الُوجُودِ بأسرِهَا","وَغَدَت عُلُومُ النَّاسِ ذَاتَ هَوَانِ",46,"ن",1,0],["فسد الزمان فما ترى","إلا ذئاباً أو ذبابا",47,"ب",2,1],["فسدوا خللي يا سادةً بهم","أرجو النجاة إذا ما خانني الأمل",48,"ل",1,0],["فسدت القوم كلهم جميعاً","ومأواك بينهم ذروة المعالي",49,"ل",2,0],["فسدت في وجوههم النواحي","مسالكها ولم ترحم حبيبا",50,"ب",2,0],["فسدد سهام الرأي وارم بها تصب","فسهمك في أغراضه آمنُ الرد",51,"د",1,0],["فَسدت خَلائقهم فَمَهما حاوَلوا","إِصلاحَها بسواك كانَ بأفسدِ",52,"د",1,0],["فَسَدَ القِياسُ من المقدَّم إذ غدا","موضوعُهُ يعلو على محمولهِ",53,"ه",1,0],["فَسَدَّ ثُغرَتَها وَاِشتَدَّ مُعتَمِداً","أَرضَ العَدُوِّ فَلَم يَلبَث بِها الظَفَرُ",54,"ر",1,0],["فسدت طباع العالمين وأخلقت","حلل الفضائل والزمان جديد",55,"د",1,0],["فسدت وَاللَه أَخلاقك بل","نفخة قد أَشعلتها كحريق",56,"ق",1,0],["فسد يا سيدي لَيلاً نهاراً","بعزٍّ لا تَرى يَوماً صغاراً",57,"ر",2,0],["فَسدّدنَ أَخصاصَ البُيوتِ بَأَعيُنٍ","حَكَت قُضُباً في كُلِّ قَلبٍ لَها غمدُ",58,"د",1,0],["فسدت لطول بعادكم أحلامنا","وعقولنا وجفا الجفون منام",59,"م",1,1],["فسد الزمان فساد فيه عصابة","ظهرت به بالإثم والعدوان",60,"ن",1,0],["فَسَدِّد بِمَحض الفَضلِ منكَ مغارِماً","بِذِمَّة مسكينٍ لَدَيك مُجاوِرُ",61,"ر",1,0],["فسد الزمان وعاثت الأشرار","سلم هديت بذا جرت أقدارُ",62,"ر",1,1],["فسَدَ الرعيةُ بعد ما","فسدتْ بها الأمراءُ",63,"ا",2,0],["فسدرة المنتهى لا شك حضرته","لقد تناهى إليها علم جبريل",64,"ل",1,0],["فَسِدرَةُ أَوجِ المُنتَهى لِيَ مَوطِن","وَغايَةُ غاياتِ الكَمالِ مَشارِعُ",65,"ع",1,0],["فسدىً يهزُّ بلاطَهُ","ما اهتز منهُ سوى السّعَفْ",66,"ف",1,0],["فَسُدَىً ..أخذتُ حصانتي","وسُدَىً أخذتُ المنتصَفْ",67,"ف",1,0],["فسديمُ رُوحي آمنٌ","والصَّبْرًُ فيه تسَلَطنا",68,"ن",2,0],["فسددهم ربي وأظفرهم به","وأجلوهمو منها على كثرة الجند",69,"د",1,0],["فسددهم ربي وأظفرهم بهم","وأجلوهمو منها على القهر والقسر",70,"ر",1,0],["فسديم عزّك عائدٌ","رؤيايَ فيك مبشّره",71,"ر",2,0],["فسد الزمانُ وأنت أرضك من وفا","والصبر خيم في مراتعه الجفا",72,"ف",2,1],["فسدتْ هذه الحياةُ وصارَ ال","فَوحُ فيها كزفرةِ التنُّورِ!",73,"ر",1,0],["فَسَدَتْ فِيهِمُ الطِّبَاعُ فَهَذَا","ثُعْلُبَانٌ وَهَذِه ثُعْبَانُ",74,"ن",1,0],["فسدَّ الباب سكينا نبيلا","فصار بصدره أحلى وساما",75,"م",2,0],["فسدتَ يا زمني في كل ناحيةٍ","حتى لأفسدتَ منّي كلَّ أعمالي",76,"ل",2,0]]}