زوء الكامل"],[400,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[424,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[436,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[450,"أورى الهوى بحشاي زندا","https://www.aldiwan.net/poem13712.html","مجزوء الكامل"],[451,"قالوا طيور تغالي في محبتها","https://www.aldiwan.net/poem61224.html","البسيط"],[451,"إن نالني السقم لم يبلغ بي الجزع","https://www.aldiwan.net/poem61292.html","البسيط"],[451,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[456,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[456,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[456,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[456,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[459,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[466,"عندي طباهجة وجدي بارد","https://www.aldiwan.net/poem60498.html","الكامل"],[475,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[477,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[477,"حمامات أيك عذبة النغمات","https://www.aldiwan.net/poem37913.html","الطويل"],[522,"ما زال نور محمد متنقلا","https://www.aldiwan.net/poem13285.html","الكامل"],[549,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[549,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[549,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[549,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[549,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[549,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[549,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[549,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem47855.html","الطويل"],[549,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[549,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[556,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[556,"هوى قد أذاب الروح والنفس والجسما","https://www.aldiwan.net/poem34192.html","الطويل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[556,"لك الحمد يا رب السموات والأرض","https://www.aldiwan.net/poem34419.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أموت بمن لو مر ذيل قميصه","https://www.aldiwan.net/poem2980.html","الطويل"],[573,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[573,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[585,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"]],"verses":[["وَحَواشي الجَوِّ ناصِلَةٌ","وَالدُجى بِالصُبحِ مَطلولُ",0,"ل",1,0],["وَحوشيتَ أَن أَلقاكَ سَبطاً تَظاهُري","وَإِن كُنتَ مَطوِيّاً عَلى باطِنٍ جَعدِ",1,"د",1,0],["وَحَوْلَ خِبائِها أَشْلاءُ قَتْلى","رَفَعْنَ عَقِيرَةَ الطَّيْرِ المُرِنِّ",2,"ن",1,0],["وَحَوْلَكَ مِنْ حَيَّيْكَ قَيسٍ وَخِنْدِفٍ","كُهولٌ مَكاريمُ الضُّيوفِ وَشِيبُ",3,"ب",1,0],["وحَوليَ منْ رَوْقَيْ أميّةَ غِلْمَةٌ","بهِمْ تُطْفَأُ الحَرْبُ العَوانُ وتُشْعَلُ",4,"ل",1,0],["وحوْليَ قَوْمٌ يعْلَمُ اللهُ أنّني","بِهمْ وهُمُ بي يَكْثُرونَ قَليلُ",5,"ل",1,0],["وحَوليَ منْ عُلْيا خُزَيْمَةَ عُصْبَةٌ","إذا غَضِبَتْ ظلّتْ لها الأرضُ تَرجُفُ",6,"ف",1,0],["وحَولي أناسٌ تُنْفَضُ الرَّاحُ مِنهُمُ","كثيرونَ إلا أن يُقَلِّلَهُمْ خُبْرُ",7,"ر",1,0],["وَحَولِيَ مِن دونِ الأَنامِ عِصابَةٌ","تَوَدُّدُها يَخفى وَأَضغانُها تَبدو",8,"د",2,0],["وَحَوافِرُ الخَيلِ العِناقِ عَلى الصَف","مِثلُ الصَواعِقِ في قِفارِ الفَدفَدِ",9,"د",1,0],["وَحَولَكَ نِسوَةٌ يَندُبنَ حُزن","وَيَهتِكنَ البَراقِعَ وَاللِفاعا",10,"ع",2,0],["وَحَوالَيَّ كَالتَماثيلِ أَبكا","رٌ حِسانٌ مِثلُ الجَآذِرِ عينُ",11,"ن",1,0],["وَحَوراءَ مِن حورِ الجِنانِ مَصونَةٍ","يَرى وَجهَهُ في وَجهِها كُلُّ ناظِرِ",12,"ر",1,1],["وَحَولي مِنَ العوّادِ باكٍ وَمُشفِقٍ","أُباعِدُ أَهلي كُلَّهُم وَأَقارِبي",13,"ب",2,0],["وحَوى الكَبيرُ فخارَهُ عنْ كابِرٍ","وتوارَثَ الأبْناءُ فيهِ جُدودا",14,"د",2,0],["وَحورٌ كَأَمثالِ الدُمى وَمَناصِفٌ","وَقِدرٌ وَطَبّاخٌ وَصاعٌ وَدَيسَقُ",15,"ق",1,0],["وَحَولِيَ بَكرٌ وَأَشياعُها","وَلَستُ خَلاةَ لِمَن أَوعَدَن",16,"ن",1,0],["وَحَوادِثٌ في الكَونِ إِثرَ حَوادِثٍ","جاءَت مُشَمَّرَةً لِهَدِّ كِيانِهِ",17,"ن",2,0],["وَحَوى اللُؤمَ وَالرقاعَةَ وَالخِ","سَةَ وَالجَهلَ وَالخَنا وَالخِيانَه",18,"ن",2,0],["وَحِوَارٌ يُبَلِّغُ العِظَةَ المُثْ","لَى مِنَ الأَوَّلِينَ لِلآخِرِينَا",19,"ن",2,0],["وَحَوْلَهَا السَّبْعَةُ الأَنْهَارُ جَارِيَةٌ","مِنْ غَيْرِ جَدْوَى بِذَاكَ المَدْمَعِ الشَّبِمِ",20,"م",1,0],["وَحَوْلَهَا مِنْ أَخٍ وَخَالٍ","مَنْ يَعْرِفُ النبْلُ وَالذِّمَامُ",21,"م",1,0],["وَحُواً تُجَلّي عَن عِذابٍ كَأَنَّها","إِذا نَغمَةٌ جاوِبنِها بِالهَماهِمِ",22,"م",1,0],["وَحَومانَةٍ وَرقاءَ يَجري سَرابُها","بِمُنسَحَّةِ الآباطِ حُدبٍ ظُهورُها",23,"ر",3,0],["وحولك من حفظ الإله كتائبٌ","وفوقَكَ من ظلِّ السعادة رَفْرَفُ",24,"ف",1,0],["وحولها أنفس مصرَّعة","يسرح فيها ويمرح العَطَب",25,"ب",1,0],["وحوادث الأيام مثل نسائها","في الحكم تَطُهر تارةً وتَحيض",26,"ض",1,0],["وحول سريرك من غالب","ثُبى العزِّ والعربُ الهيْضَلُ",27,"ل",1,1],["وحويت ديناراً لوجهك فانتحى","صرف الزمان فراح بالدينار",28,"ر",1,0],["وحوى نبيّ تراب مصر وجلق","كالغيم مرتكناً على أقمار",28,"ر",1,0],["وحول نقا سوالفه عذارٌ","كما شعرت نقوش في لجين",29,"ن",1,0],["وحوى من علاه كوكب رأيٍ","طالع السعد بكرةً وعشيّا",30,"ي",2,0],["وحوله غِلمةٌ شُقْرٌ طَماطمةٌ","كلٌّ طويلُ قناةِ الظهر مَعْصوبُ",31,"ب",1,0],["وحوشٌ رعاها حَيْنها حول غابةٍ","أُسامةُ فيها مُلبدٌ بالكلاكلِ",32,"ل",1,0],["وَحَوِلنَ مِن خَلجِ الأَعِنَّةِ فَاِنطَوَت","مِنها البُطونُ وَفي الفُحولِ جُفورُ",33,"ر",1,0],["وَحَواها قَبلَ رَحمِ الكَرمِ رَحمُ الغادِيَه","إِنَّما مِن قَبلِ هَذا أَينَ كانَت لَستُ أَدري",34,"ي",1,0],["وَحَوَّلتُ طَرفي إِلى المَشرِقِ","فَلَم أَرَ غَيرَ جِبالِ الغُيوم",35,"م",1,0],["وَحوطوا قُصورَكُم بِالرِجالِ","وَحوطوا رِجالَكُم بِالحوصون",36,"ن",1,0],["وَحَوِّلِ المالَ إِلى راحَةٍ","وَحَوِّلِ القَصرَ إِلى خَيمَةِ",37,"ه",1,0],["وحوشٍ يُرى بادِ الذِّئابِ مَضلّة","بَواطِنُه لِلجنِّ والأُسدِ مَألَفُ",38,"ف",1,0],["وحوله تَزْعَقُ المنايا","كأنَّها جنَّةُ الجَحِيمْ",39,"م",1,0],["وحوادث تجرى لغايتها غدا","ولكل جار غاية وقرار",40,"ر",1,0],["وحوى النوابغ فيه حول نواله","شعب على حرم الفنون يغار",40,"ر",1,0],["وَحَوّلَ المَنصورُ مَجرى العَهدِ","أَخَّر عيسى وَأَقام المَهدي",41,"ي",1,0],["وَحَولي فِتيَةٌ غُرٌّ صِباحٌ","لَهُم في الفَضلِ غاياتٌ وَسَبقُ",42,"ق",1,0],["وَحُوِّرَ قَولُ الناسِ مَولىً وَعَبدُهُ","إِلى قَولِهِم مُستَأجِرٌ وَأَجيرُ",43,"ر",1,0],["وَحَولَكَ أَهلُ شوراكَ الثُقاتُ","تَسوسونَ الجُيوشَ مُظَفَّرينا",44,"ا",1,0],["وَحَوى الغِمدُ بَقايا صارِمٍ","لَم تُقَلِّب مِثلَهُ أَيدي القُيون",45,"ن",1,0],["وَحَوَيتَ فَضلَهُما وَما طَمِعَ اِمرُؤٌ","فيهِ وَلا طَمِعَ اِمرُؤٌ أَن يَطمَعا",46,"ع",2,0],["وحولها سدرة خضراء قد حملت","حمر اليواقيت فامتدت إلى الفلكِ",47,"ك",1,0],["وحولَ ميادينِ الرياضِ تراصفَتْ","نظائرُ أشباهٍ ملابسُها خُضْرُ",48,"ر",1,1],["وَحَولَكَ رَكّابونَ لِلهَولِ عاقَروا","كُؤوسَ الرَدى مِن دارِعينَ وَحُسَّرِ",49,"ر",1,0],["وَحَولَكَ أَقوامٌ رَدَدتَ عُقولَهُم","عَلَيهِم لَكانوا كَالفَراشِ مِنَ الجَهلِ",50,"ل",1,0],["وحولَكَ من بَكْرِ بنِ وائِلَ فِتيَةٌ","إذا عُدَّ أهلُ الفَضْلِ كانوا الأوائِلا",51,"ل",2,0],["وحَوى أبو العبَّاسِ كلَّ فَضيلَةٍ","تَرَكَتْ شريفَ القَومِ غيرَ شَريفِ",52,"ف",1,0],["وحَوَيتُ فضلَ المالِ من إفضالِه","ومحاسنَ الآدابِ من آدابِه",53,"ب",2,0],["وَحَولي مَعشَرٍ كَرُمُوا وَطابوا","يَرجونَ الغَنيمَةَ وَالنِهابا",54,"ب",2,0],["وَحَوادِثُ الدُنيا تَرو","حُ عَلَيكُمُ طَورا