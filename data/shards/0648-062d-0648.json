],[406,"كم ذا التلعب يا غزال الأجرع","https://www.aldiwan.net/poem33672.html","الكامل"],[406,"شرفتني ببديع طرسك","https://www.aldiwan.net/poem33725.html","مجزوء الكامل"],[406,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[419,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[430,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[442,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[454,"أورى الهوى بحشاي زندا","https://www.aldiwan.net/poem13712.html","مجزوء الكامل"],[455,"قالوا طيور تغالي في محبتها","https://www.aldiwan.net/poem61224.html","البسيط"],[455,"إن نالني السقم لم يبلغ بي الجزع","https://www.aldiwan.net/poem61292.html","البسيط"],[455,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[460,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[460,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[460,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[460,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[463,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[465,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[466,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[470,"عندي طباهجة وجدي بارد","https://www.aldiwan.net/poem60498.html","الكامل"],[479,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[481,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[481,"حمامات أيك عذبة النغمات","https://www.aldiwan.net/poem37913.html","الطويل"],[526,"ما زال نور محمد متنقلا","https://www.aldiwan.net/poem13285.html","الكامل"],[553,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[553,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[553,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[553,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[553,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[553,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[553,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[553,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem47855.html","الطويل"],[553,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[553,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[560,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[560,"هوى قد أذاب الروح والنفس والجسما","https://www.aldiwan.net/poem34192.html","الطويل"],[560,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[560,"لك الحمد يا رب السموات والأرض","https://www.aldiwan.net/poem34419.html","الطويل"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"أموت بمن لو مر ذيل قميصه","https://www.aldiwan.net/poem2980.html","الطويل"],[577,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[577,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[589,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"],[728,"","https://poetry.dctabudhabi.ae/diwan/poem/84970","الطويل"],[759,"","https://poetry.dctabudhabi.ae/diwan/poem/89627","الوافر"],[771,"","https://poetry.dctabudhabi.ae/diwan/poem/75803","الوافر"],[792,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20448","الكامل"],[819,"","https://poetry.dctabudhabi.ae/diwan/poem/20923","الوافر"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"]],"verses":[["وَحَواشي الجَوِّ ناصِلَةٌ","وَالدُجى بِالصُبحِ مَطلولُ",0,"ل",1,0],["وَحوشيتَ أَن أَلقاكَ سَبطاً تَظاهُري","وَإِن كُنتَ مَطوِيّاً عَلى باطِنٍ جَعدِ",1,"د",1,0],["وَحَوْلَ خِبائِها أَشْلاءُ قَتْلى","رَفَعْنَ عَقِيرَةَ الطَّيْرِ المُرِنِّ",2,"ن",1,0],["وَحَوْلَكَ مِنْ حَيَّيْكَ قَيسٍ وَخِنْدِفٍ","كُهولٌ مَكاريمُ الضُّيوفِ وَشِيبُ",3,"ب",1,0],["وحَوليَ منْ رَوْقَيْ أميّةَ غِلْمَةٌ","بهِمْ تُطْفَأُ الحَرْبُ العَوانُ وتُشْعَلُ",4,"ل",1,0],["وحوْليَ قَوْمٌ يعْلَمُ اللهُ أنّني","بِهمْ وهُمُ بي يَكْثُرونَ قَليلُ",5,"ل",1,0],["وحَوليَ منْ عُلْيا خُزَيْمَةَ عُصْبَةٌ","إذا غَضِبَتْ ظلّتْ لها الأرضُ تَرجُفُ",6,"ف",1,0],["وحَولي أناسٌ تُنْفَضُ الرَّاحُ مِنهُمُ","كثيرونَ إلا أن يُقَلِّلَهُمْ خُبْرُ",7,"ر",1,0],["وَحَولِيَ مِن دونِ الأَنامِ عِصابَةٌ","تَوَدُّدُها يَخفى وَأَضغانُها تَبدو",8,"د",2,0],["وَحَوافِرُ الخَيلِ العِناقِ عَلى الصَف","مِثلُ الصَواعِقِ في قِفارِ الفَدفَدِ",9,"د",1,0],["وَحَولَكَ نِسوَةٌ يَندُبنَ حُزن","وَيَهتِكنَ البَراقِعَ وَاللِفاعا",10,"ع",2,0],["وَحَوالَيَّ كَالتَماثيلِ أَبكا","رٌ حِسانٌ مِثلُ الجَآذِرِ عينُ",11,"ن",1,0],["وَحَوراءَ مِن حورِ الجِنانِ مَصونَةٍ","يَرى وَجهَهُ في وَجهِها كُلُّ ناظِرِ",12,"ر",1,1],["وَحَولي مِنَ العوّادِ باكٍ وَمُشفِقٍ","أُباعِدُ أَهلي كُلَّهُم وَأَقارِبي",13,"ب",2,0],["وحَوى الكَبيرُ فخارَهُ عنْ كابِرٍ","وتوارَثَ الأبْناءُ فيهِ جُدودا",14,"د",2,0],["وَحورٌ كَأَمثالِ الدُمى وَمَناصِفٌ","وَقِدرٌ وَطَبّاخٌ وَصاعٌ وَدَيسَقُ",15,"ق",1,0],["وَحَولِيَ بَكرٌ وَأَشياعُها","وَلَستُ خَلاةَ لِمَن أَوعَدَن",16,"ن",1,0],["وَحَوادِثٌ في الكَونِ إِثرَ حَوادِثٍ","جاءَت مُشَمَّرَةً لِهَدِّ كِيانِهِ",17,"ن",2,0],["وَحَوى اللُؤمَ وَالرقاعَةَ وَالخِ","سَةَ وَالجَهلَ وَالخَنا وَالخِيانَه",18,"ن",2,0],["وَحِوَارٌ يُبَلِّغُ العِظَةَ المُثْ","لَى مِنَ الأَوَّلِينَ لِلآخِرِينَا",19,"ن",2,0],["وَحَوْلَهَا السَّبْعَةُ الأَنْهَارُ جَارِيَةٌ","مِنْ غَيْرِ جَدْوَى بِذَاكَ المَدْمَعِ الشَّبِمِ",20,"م",1,0],["وَحَوْلَهَا مِنْ أَخٍ وَخَالٍ","مَنْ يَعْرِفُ النبْلُ وَالذِّمَامُ",21,"م",1,0],["وَحُواً تُجَلّي عَن عِذابٍ كَأَنَّها","إِذا نَغمَةٌ جاوِبنِها بِالهَماهِمِ",22,"م",1,0],["وَحَومانَةٍ وَرقاءَ يَجري سَرابُها","بِمُنسَحَّةِ الآباطِ حُدبٍ ظُهورُها",23,"ر",3,0],["وحولك من حفظ الإله كتائبٌ","وفوقَكَ من ظلِّ السعادة رَفْرَفُ",24,"ف",1,0],["وحولها أنفس مصرَّعة","يسرح فيها ويمرح العَطَب",25,"ب",1,0],["وحوادث الأيام مثل نسائها","في الحكم تَطُهر تارةً وتَحيض",26,"ض",1,0],["وحول سريرك من غالب","ثُبى العزِّ والعربُ الهيْضَلُ",27,"ل",1,1],["وحويت ديناراً لوجهك فانتحى","صرف الزمان فراح بالدينار",28,"ر",1,0],["وحوى نبيّ تراب مصر وجلق","كالغيم مرتكناً على أقمار",28,"ر",1,0],["وحول نقا سوالفه عذارٌ","كما شعرت نقوش في لجين",29,"ن",1,0],["وحوى من علاه كوكب رأيٍ","طالع السعد بكرةً وعشيّا",30,"ي",2,0],["وحوله غِلمةٌ شُقْرٌ طَماطمةٌ","كلٌّ طويلُ قناةِ الظهر مَعْصوبُ",31,"ب",1,0],["وحوشٌ رعاها حَيْنها حول غابةٍ","أُسامةُ فيها مُلبدٌ بالكلاكلِ",32,"ل",1,0],["وَحَوِلنَ مِن خَلجِ الأَعِنَّةِ فَاِنطَوَت","مِنها البُطونُ وَفي الفُحولِ جُفورُ",33,"ر",1,0],["وَحَواها قَبلَ رَحمِ الكَرمِ رَحمُ الغادِيَه","إِنَّما مِن قَبلِ هَذا أَينَ كانَت لَستُ أَدري",34,"ي",1,0],["وَحَوَّلتُ طَرفي إِلى المَشرِقِ","فَلَم أَرَ غَيرَ جِبالِ الغُيوم",35,"م",1,0],["وَحوطوا قُصورَكُم بِالرِجالِ","وَحوطوا رِجالَكُم بِالحوصون",36,"ن",1,0],["وَحَوِّلِ المالَ إِلى راحَةٍ","وَحَوِّلِ القَصرَ إِلى خَيمَةِ",37,"ه",1,0],["وحوشٍ يُرى بادِ الذِّئابِ مَضلّة","بَواطِنُه لِلجنِّ والأُسدِ مَألَفُ",38,"ف",1,0],["وحوله تَزْعَقُ المنايا","كأنَّها جنَّةُ الجَحِيمْ",39,"م",1,0],["وحوادث تجرى لغايتها غدا","ولكل جار غاية وقرار",40,"ر",1,0],["وحوى النوابغ فيه حول نواله","شعب على حرم الفنون يغار",40,"ر",1,0],["وَحَوّلَ المَنصورُ مَجرى العَهدِ","أَخَّر عيسى وَأَقام المَهدي",41,"ي",1,0],["وَحَولي فِتيَةٌ غُرٌّ صِباحٌ","لَهُم في الفَضلِ غاياتٌ وَسَبقُ",42,"ق",1,0],["وَحُوِّرَ قَولُ الناسِ مَولىً وَعَبدُهُ","إِلى قَولِهِم مُستَأجِرٌ وَأَجيرُ",43,"ر",1,0],["وَحَولَكَ أَهلُ شوراكَ الثُقاتُ","تَسوسونَ الجُيوشَ مُظَفَّرينا",44,"ا",1,0],["وَحَوى الغِمدُ بَقايا صارِمٍ","لَم تُقَلِّب مِثلَهُ أَيدي القُيون",45,"ن",1,0],["وَحَوَيتَ فَضلَهُما وَما طَمِعَ اِمرُؤٌ","فيهِ وَلا طَمِعَ اِمرُؤٌ أَن يَطمَعا",46,"ع",2,0],["وحولها سدرة خضراء قد حملت","حمر اليواقيت فامتدت إلى الفلكِ",47,"ك",1,0],["وحولَ ميادينِ الرياضِ تراصفَتْ","نظائرُ أشباهٍ ملابسُها خُضْرُ",48,"ر",1,1],["وَحَولَكَ رَكّابونَ لِلهَولِ عاقَروا","كُؤوسَ الرَدى مِن دارِعينَ وَحُسَّرِ",49,"ر",1,0],["وَحَولَكَ أَقوامٌ رَدَدتَ عُقولَهُم","عَلَيهِم لَكانوا كَالفَراشِ مِنَ الجَهلِ",50,"ل",1,0],["وحولَكَ من بَكْرِ بنِ وائِلَ فِتيَةٌ","إذا عُدَّ أهلُ الفَضْلِ كانوا الأوائِلا",51,"ل",2,0],["وحَوى أبو العبَّاسِ كلَّ فَضيلَةٍ","تَرَكَتْ شريفَ القَومِ غيرَ شَريفِ",52,"ف",1,0],["وحَوَيتُ فضلَ المالِ من إفضالِه","ومحاسنَ الآدابِ من آدابِه",53,"ب",2,0],["وَحَولي مَعشَرٍ كَرُمُوا وَطابوا","يَرجونَ الغَنيمَةَ وَالنِهابا",54,"ب",2,0],["وَحَوادِثُ الدُنيا تَرو","حُ عَلَيكُمُ طَوراً وَتَغدو",55,"د",2,0],["وَحَولَهُ مِن رَهطِهِ عُصبَةٌ","يُشيرُ نَحوي لَهُم بِالبَنانِ",56,"ن",1,0],["وَحَولَنا مِن بَني عُمومَتِنا","كَتائِبٌ كَالغَمامِ تَزدَحِمُ",57,"م",1,0],["وَحَولَها سورُ طينٍ","كَأَنَّهُ طَورُ سينِ",58,"ن",1,0],["وَحَومَةٍ لِلخِطابِ فَرَّجَها وَال","قَومُ عُجمٌ في مِثلِها خُرسُ",59,"س",1,0],["وَحَوانٍ أَبَت عَلَيها المَعالي","أَن تُسَمّى مَطِيَّةَ الأَحقادِ",60,"د",1,0],["وَحَولِيَ مِن هَذا الأَنامِ عِصابَةٌ","تَوَدُّدُها يَخفى وَأَضغانُها تَبدو",61,"د",2,0],["وَحُوّلَت قِبلَةُ الإِسلامِ وَقتَئِذٍ","عَن وِجهَةِ القُدسِ نَحوَ البَيتِ ذي العِظَمِ",62,"م",1,0],["وحويتُ منْ علمٍ ومنْ أدبٍ ومن","جاهٍ ومن مالٍ ومنْ مقدارِ",63,"ر",1,0],["وحولَه الشاءُ والمِعزى مهوِّمةً","تُزجي الأكارع أو تُرخي العثانينا",64,"ن",2,0],["وحول ضفافهِ يمتد نبعٌ","بما يُحيَّ يفور وما يبد",65,"د",1,0],["وَحَوراءَ آنِسَةً كَالهِلا","لِ رَخواً مَفاصِلُها مُعصِرا",66,"ر",2,0],["وَحَوماً عَلى ماءٍ تَدانى بِهِ المُنى","وَيَنأى بِهِ المَسرى فَيَدنو وَيَبعُدُ",67,"د",1,0],["وَحُوطوا حِمَى الإِسلامِ إنّي أخافُها","كتائبَ شتَّى حَوله تَتألَّبُ",68,"ب",1,0],["وَحَولَكَ مِن عُوجِ القِسِيّ أهِلَّةٌ","تَوَسَّطَهَا بَدرٌ لِوَجهِكَ كَامِلُ",69,"ل",1,0],["وَحَواليه طافَ أَسراب حور","بِغُصون النَخيل وَالرَيحان",70,"ن",1,0],["وَحَورٌ لا يَرينَ الشَمسَ فيها","عَلى صَورِ الدُمى فيها سُهومُ",71,"م",1,0],["وَحوسِبوا بِالَذي لَم يُحصِهِ أَحَدٌ","مِنهُم وَفي مِثلِ ذاكَ اليَومِ مُعتَبَرُ",72,"ر",1,0],["وَحَوَيتَ بِنتَ وِزارَةٍ","كَالشَمسِ حينَ طُلوعِها",73,"ع",3,0],["وَحَوارِيِّكَ الزُّبَيْرِ أبي القَرْ","مِ الذي أَنْجَبَتْ بِهِ أسماءُ",74,"ا",2,0],["وَحَولَها حارِسٌ ذو صَلعَةٍ شَكِسٌ","عِلجٌ يَدورُ أَخو طِمرٍ وَتُبّانِ",75,"ن",1,0],["وَحَوراءَ مِن حورِ الجِنانِ غَريرَةٍ","يَرى وَجهَهُ في وَجهِها كُلُّ ناظِرِ",76,"ر",1,0],["وَحَوادِثُ الأَيّامِ مِثلُ نَباتِها","تُرعى وَيَأمُرُها المَليكُ فَتَنبُتُ",77,"ت",1,0],["وَحَوادِثُ الأَيّامِ تولَدُ جِلَّةً","وَتَعودُ تَصغُرُ ضِدَّ كُلِّ وَليدِ",78,"د",1,0],["وَحَوّاءُ أَعطَت بِنتَها البُؤسَ وَاِبنَها","لِآدَمَ يُغذى بِالشَقاءِ وَيُؤدَمُ",79,"م",1,0],["وحَومَةٍ غادَرت فُرسانَها","في مَبْركٍ لِلحَربِ جَعْجاعِ",80,"ع",1,1],["وحول ضفافهِ يمتد نبعٌ","بما يُحيي يفور وما يبيد",81,"د",1,0],["وحَوْمٌ حَوَتْ آبَاؤُهُمْ أُمَّهَاتِهَا","نَجَائِبُ نُعْطِيهَا ونَعْقِلُهَا عَقْلاَ",82,"ل",2,0],["وحُوتُها جائِلٌ على ظمَأٍ","في ناضِبِ الماء غيرِ مُلْتَطِم",83,"م",1,0],["وحوض ما جف من الشباب","وقَصَفَ الدهرُ من الأحباب",84,"ب",1,0],["وحَوْلَكَ أَسْيَافٌ مِن السَّعْدِ تُنتَضَى","وفَوْقكَ أَعْلامٌ مِن النّصْرِ تَخْفُقُ",85,"ق",1,0],["وَحَوى اللُؤمَ وَالرقاعَةَ وَالخِس","سَةَ وَالجَهلَ وَالخَنا وَالخِيانَه",86,"ن",2,0],["وَحَولَكَ نِسوَةٌ يَندُبنَ حُزناً","وَيَهتِكنَ البَراقِعَ وَاللِفاعا",87,"ع",2,0],["وَحَوافِرُ الخَيلِ العِناقِ عَلى الصَفا","مِثلُ الصَواعِقِ في قِفارِ الفَدفَدِ",88,"د",1,0],["وحُوِّرَ الَحضرُ وأستُبيحَ وقَد","أُحرِقَ في خِدرِها مَشاجبُها",89,"ب",3,0],["وَحَوْلكَ أَعْلامٌ يَكَادُ نِظَامُهُمْ","يَدُورُ مدَارَ الشَّمْسِ وَالأَنْجُمِ الزُّهْرِ",90,"ر",1,0],["وَحَوْلَكِ أُمةٌ قَرَّتْ عُيوناً","بِوَجُهِكِ يُجْتَلَى بعدَ ارْتِقَابِ",91,"ب",1,0],["وحَواشٍ رقَّتْ مِنْ أَدَبِ","حتّى فَضَحت من يِنشدهُ",92,"د",2,0],["وحواه الماضي الْخِضمُّ وأبقَى","ذكرياتٍ تطفو على شُطْئانه",93,"ن",2,0],["وحولَكَ من أصحابِكَ الصيدِ فتية","خفافٌ إلى المولى شِدادٌ على الخَصْمِ",94,"م",1,0],["وحولّ الرمل إلى لؤلؤٍٍ نبني به قصراً أو قلعتين","وردني بعد مشيبي فتىً تعجب من نضرته كل عين",95,"ن",1,0],["وحَوْلَ صنعاء: جيشٌ ثَلَّ قائدُهُ","عرش