[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[90,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[105,"عندي إذا صرع الجنوب سبات","https://www.aldiwan.net/poem42095.html","الكامل"],[105,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[52,"أبصرته في المنام معتذرا","https://www.aldiwan.net/poem26642.html","المنسرح"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[48,"لست بدار عفت وغيرها","https://www.aldiwan.net/poem62428.html","البسيط"],[48,"إن لا تزوري فإن الطيف قد زارا","https://www.aldiwan.net/poem63288.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85616","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54946","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"الجيل الجَديدْ","https://www.poetsgate.com/ViewPoem.aspx?id=179209",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"أَجْرِ حَدِيثي ، وكُنْ لهُ فَطِناً","https://www.poetsgate.com/ViewPoem.aspx?id=31789",""],[28,"يختلف الناس ما لم نجتمع لهم","https://www.poetsgate.com/ViewPoem.aspx?id=186559",""],[51,"سَمْعا أبا إسحق إنك ماجدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30803",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""]],"verses":[["وَلَأَنتَ حَسرَةُ ذي الخُمولِ وَما دَرى","أَنَّ الثُرَيّا حَسرَةُ الدَبَرانِ",0,"ن",1,0],["وَلَأَنتَ أَولى أَن تُرِبَّ صَنائِعاً","كَثُرَت بِهِنَّ مَطامِعٌ وَأماني",0,"ي",1,0],["وَلا نَظَرتَ إِلى ماءٍ عَلى ظَمَإٍ","تَبغي الوُرودَ وَلَيسَ الوِردُ بِالداني",1,"ي",1,0],["وَلا نَبَت أَطرافُها عَن حَجَرٍ","مِن مُضَرٍ ذاتِ القُوى وَلا اليَمَن",2,"ن",1,0],["وَلَأَنتَ أَنجَدُ صابِرٍ لِمُلِمَّةٍ","وَأَعَزُّ مَن يَنجابُ عَنهُ أَرومُها",3,"م",3,0],["وَلا نَصحَبُ اللَيلَ حَتّى نَخالُ","كَواكِبَهُ في الفَيافي بُهُم",4,"م",1,0],["وَلا نَشَرَت فيكَ تِلكَ الرِياحُ","غَدائِرَ مِن مُزنَةٍ أَو جُمَم",4,"م",1,0],["وَلا نَقعاً يَثورُ عَلى مُغيرٍ","وَلا بَيتاً يَظَلُّ عَلى مُقيمِ",5,"م",1,0],["وَلا نَعِمَ الحُمرُ الشِفاهُ كَأَنَّما","تَبَطَّنَ داءً أَو وَلَغنَ بِها دَما",6,"م",2,0],["وَلَأَنتَ مِثلُ السَيفِ في مُضَرٍ","عاذَت بِقائِمِهِ مِنَ الذُلِّ",7,"ل",1,0],["وَلا ناطِقٌ لِلخَوفِ إِلّا مُخافِتٌ","وَلا ناظِرٌ لِلذُلِّ إِلّا مُخالِسُ",8,"س",1,0],["وَلَأَنتَ مِثلُ القُرُّ يَع","صِفُ مِنهُ بِالشِعرى العَبورِ",9,"ر",1,0],["وَلا نَظَروا إِلّا بِعَمياءَ بَعدَهُ","وَلا اِرتَضَعوا إِلّا بِخِلفٍ مُجَدَّدِ",10,"د",1,0],["وَلَأَنفُضَنَّ يَدَيَّ يَأساً مِنكُمُ","نَفضَ الأَنامِلِ مِن تُرابِ المَيِّتِ",11,"ت",1,0],["وَلا ناصِرٌ سِيّانِ مَن هُوَ حاضِرٌ","إِذا ما دَعا مِنّا وَمَن هُوَ غائِبُ",12,"ب",1,0],["وَلا نَقعٌ يُثارُ وَلا قَتامٌ","وَلا طَعنٌ يُشَبُّ وَلا ضِرابُ",13,"ب",1,0],["وَلا نُطقَ إِلّا وَمِن دونِهِ","عَزاءٌ يَغورُ وَدَمعٌ رَبيبُ",14,"ب",1,0],["ولأنْظِمَنَّ قَصائِداً لَفَّ الحِجى","فيها سُهولَ بَلاغَةٍ بحُزونِ",15,"ن",1,0],["ولا نَيْلَ إلا الطّيف في القُربِ والنّوى","وأما الذي تَهذي بهِ فأماني",16,"ن",2,0],["وَلا نُباليهِمُ إِذ قَد وَثِقتِ بِنا","أَيُكثِرونَ كَلاماً أَم يُقِلّونا",17,"ن",2,0],["وَلا نُشُراتٌ باتَ يَغسِلُني بِها","إِذا ما بَدا لي الكَوكَبُ المُتَصَوِّبُ",18,"ب",1,0],["ولا نسَخَتْ كَرْبي بقَلْبِيَ سَلْوَةً","فلمّا سَرى فيهِ نَسيمُ سَلا سَلا",19,"ل",2,0],["وَلأَنْتَ أَوْلَى بِالتَّشيُّعِ شِيمَةٌ","لَمْ تَتَّفِقْ لِسِوَاكَ مِنْ إِنْسَانِ",20,"ن",1,0],["وَلأنْتَ يَا هَذاَ ضَيَاعٌ مُغْفَلٌ","بَيْنَ الْكَسَادِ وَمُرْخَصِ الاْثْمَانِ",21,"ن",1,0],["ولا نَظَمْتُ على لَبّاتِهِ مِدَحي","نَظْمَ الحُليِّ على لَبّاتِ ذي غَيَدِ",22,"د",1,0],["ولا نَجْدَ إلا رَوضَة وحَديقَةٌ","ولا غَوْرَ إلا جَدْولٌ وخَليجُ",23,"ج",1,0],["وَلأَنْتَ ظِلُّ اللهِ بَيْنَ عِبَادِهِ","وَبِلاَدِهِ إِنْ عُدِّدَ الأَفْيَاءُ",24,"ا",2,0],["وَلا نَلعَنُ الأَضيافَ إِن نَزَلوا بِنا","وَلا يَمنَعُ الكَوماءَ مِنّا نَصيرُها",25,"ر",3,0],["وَلا نُشَبَّهُ بِالكِلا","بِ عَلى المِياهِ مِنَ الحَرارَه",26,"ر",2,0],["وَلا نُعطي المُنى قَوماً عَلَينا","كَما لَيسَ الأُمورُ عَلى مُنانا",27,"ن",2,0],["وَلَأَنتَ أَمضى نَبلَةٍ نَرمي بِها","فَاِنفُذ وَأَقصِد فَالنِبالُ قَليلُ",28,"ل",1,0],["وَلَأَنتَ إِن رُفِعَ اِمرُؤٌ مِن غَيرِهِ","كَالمُبتَدا سَبَبُ اِرتِفاعِكَ مَعنَوي",29,"ي",1,1],["وَلَأَنتَ خَيرُ الكافِلينَ فَلا تَدَع","أَيتامَكُم يا اِبنَ الكِرامِ تُضامُ",30,"م",1,0],["وَلا نَنشَقُ العِطرَ النَمومَ أَريجُهُ","إِذا لَم يُشَعشَع بِالعَجاجِ مَلابُ",31,"ب",1,0],["وَلَأَنتَ أَنفَسُ شيمَةً مِن أَن يُرى","لِنَفيسِ أَعلاقي لَدَيكَ كَسادُ",32,"د",1,0],["ولانت سمح من يؤم جنابه","فيعيد إعسراً إلى الأيسار",33,"ر",1,0],["وَلأَنْتَ أَبْقَى مَنْ أَلَمَّ بِهِ الرَّدَى","إِنْ صَحَّ أَنَّ الذِّكْرَ عُمْرٌ ثَانِ",34,"ن",1,0],["وَلَأَنتَ أَعلَمُ بِالمَكارِمِ وَالعُلا","مِن أَن أَقولَ فَعَلتَ ما لَم تَفعَلِ",35,"ل",1,0],["وَلا نَحنُ مَشؤومٌ لَنا طائِرُ النَوى","وَلا ذَلَّ بِالبَينِ الفُؤادُ المُرَوَّعُ",36,"ع",1,0],["ولا نحالف أحلافاً فنخذ لهم","ولو لبسنا المنايا دونهم ازرا",37,"ر",2,0],["ولا نخصَص في رزءٍ بتعزية","إلا علوماً أضاعت منك مفضالا",38,"ل",2,0],["وَلا نَحتَبي عِندَ عَقدِ الجِوارِ","بِغَيرِ السُيوفِ وَلا نَرتَدي",39,"د",2,0],["وَلا نَعتَصي الأَرطى وَلَكِن عِصِيُّنا","رِقاقُ النَواحي لا يُبِلُّ سَليمُها",40,"م",3,0],["وَلاَنتَشَلَت عِضوَينِ مِنهَا يُحَابِرٌ","وكَانَ لِعَبدِ القَيس عِضوٌ مُؤَرّبُ",41,"ب",1,0],["ولانتَقَلَت من خِندِفٍ في سِوَاهُمُ","وَلاَقتَدَحَت قَيسٌ بِهَا ثم أثقَبُوا",41,"ب",3,0],["وَلَأَنتِ أَحسَنُ إِذ بَرَزتِ لَنا","يَومَ الخُروجِ بِساحَةِ القَصرِ",42,"ر",1,0],["وَلا نَنتَهي حَتّى نَفُكَّ كُبولَهُ","بِأَموالِنا وَالخَيرُ يُحمَدُ صانِعُه",43,"ع",2,0],["وَلا نَديمي العِضُّ البَخيلُ وَلا","يَخافُ جاري ما عِشتُ مِن وَبَدِ",44,"د",1,0],["ولا نسيم ثنائي بالخفيّ وقد","رويته بالعطايا أي إرواء",45,"ا",2,0],["ولأَنتَ الذي يَعُدُّ تَمَاماً","للأيادي أن تطمئنَّ القلوبُ",46,"ب",1,0],["ولأنت أولى أن يجود لمجْدِبٍ","عفواً ولم تُشدَد له أقتادُ",47,"د",1,0],["ولأنت أحْسَمُ للمطامع والمنى","من ذاك حين يَشيمُك الروَّادُ",48,"د",1,0],["ولأنتَ ابنُه المورَّثُ ذاك ال","زنْدَ أكرِمْ بذلك الزندِ زَنْدا",49,"د",2,0],["ولا نثَا سيِّئٌ فيكم بمتَّسقٍ","ولا نثا حسنٌ فيكم بمعكوس",50,"س",1,0],["ولا نرى أنه يزيدك في","مجدك من متلد ومطَّرف",51,"ف",1,0],["ولان لي كل شيء بعد قسوته","فالجذعُ جُمّارةٌ والعظمُ غضروف",52,"ف",1,0],["ولأنت المحقوق بالعشق لا المر","زوق لكن إخالني المرزوقا",53,"ق",2,0],["ولا نعدمْ سجايا في","ه للخيرات مُعتملَهْ",54,"ل",2,0],["ولا نهماً فيه وإن كنت إنما","تحب من الأضياف من كان أَنْهما",55,"م",2,0],["ولأنت أكرمُ شيمةً إذ لم تزل","ليديك نبتٌ لا يهيجُ عميمُ",56,"م",1,0],["ولأُنشقنَّكَ من ثنائي نفحةً","كالمسك يجلبُه إليك نسيمُ",56,"م",1,0],["ولأنت الحقيق أنْ لا يُرى من","ك إذا ما وأيْتَ وأْياً ندامُ",57,"م",1,0],["ولا نِقنِقٌ خاظي البضيع صمحمحٍ","من الآكلات النار تأتجُّ في الفَحمْ",58,"م",1,0],["ولأنت إذ راعيتَ كفَّ مُؤاكِلٍ","أوْلى بأن تُهْجَى وأكثرُ لائما",59,"م",2,0],["ولأنت الشريكُ في ذاك فاعْلمْ","غيرَ مظْنونةٍ ولا مَوْهومه",60,"م",2,0],["ولأنت أولى بالتجاوُزِ والندى","يا ابنَ الملوكِ وساسة الآيين",61,"ن",1,0],["ولأنت أسْكتُ حين يفخرُ فاخرٌ","ولأنتَ أنطقُ إذ سَكتَّ مَحاسنا",62,"ن",2,0],["وَلا نَخشى مِنَ الحُكّامِ حَداً","وَعِندَ اللَهِ لَم نوصَم بِوِزرِ",63,"ر",1,0],["وَلا نَتَحَمَّل مِنَّةَ الرُسلِ بَينَنا","وَلا غُرَرَ الكُتبِ الَّتي تَتَرَدَّدُ",64,"د",1,0],["ولأنت مبق في زوالك عندهم","لك ذكريات ما لهن زوال",65,"ل",1,0],["ولانت من وقع الخريف ونوئه","اسوانة يرثى لها اسوان",66,"ن",1,0],["ولأنت اليوم تبنى","كعبة للصانعين",67,"ن",1,0],["وَلَاِنقَضى العُمرانُ في وَقفَةٍ","نَسلو بِها الغُمضَ وَنَسلو الطَعام",68,"م",1,0],["وَلَأَنتَ الَّذي رَعَّيتُهُ الأُس","دُ وَمَسرى ظِلالِها الآجامُ",69,"م",1,0],["وَلا نالَ مِن حُسّادِهِ الغَيظُ وَالأَذى","بِأَعظَمَ مِمّا نالَ مِن وَفرِهِ العُرفُ",70,"ف",1,0],["وَلا نَدعوكَ صاحِبَهُ فَتَرضى","لِأَنَّ بِصُحبَةٍ يَجِبُ الذِمامُ",71,"م",1,0],["وَلا نَبَحَت خَيلي كِلابُ قَبائِلٍ","كَأَنَّ بِها في اللَيلِ حَملاتِ دَيلَمِ",72,"م",1,0],["ولا ناراَ ولا أرضاً جديدا","وصار جميع سعيكم هباءَ",73,"ا",2,0],["ولانَ بهِ قلبُ الغَمامِ على الثَّرَى","كرأفتِه إذْ يَطْرد البُؤْسَ والفَقْرَا",74,"ر",2,0],["وَلا نَقصَ في الغَيثِ الدِراكِ يَغُضُّهُ","سِوى أَنَّهُ أَزرى بِهِ مِنهُ ما أَزرى",75,"ر",2,0],["وَلَأَنتُمُ عُدَدُ الخِلافَةِ إِن غَدا","أَو راحَ مِنها مَجلِسٌ أَو مَوكِبُ",76,"ب",1,0],["وَلَأَنتَ أَنفَحُ بِالنَوافِلِ وَالنَدى","مِن واكِفٍ مُسحَنفِرٍ مُتَصَبِّبِ",77,"ب",1,0],["وَلَأَنتَ أَمنَعُ مِن كُلَيبٍ جانِباً","لِلمُستَجيرِ المُرهَقِ المُتَرَقِّبِ",77,"ب",1,0],["وَلَأَنتَ أَبعَدُ في السَماحَةِ هِمَّةً","مِن أَن تَضَنَّ بِموكَفٍ أَو مُسرَجِ",78,"ج",1,0],["وَلا نَصَرَ المُعتَزَّ مَن كانَ يُرتَجى","لَهُ وَعَزيزُ القَومِ مَن عَزَّ ناصِرُه",79,"ر",2,0],["وَلَأَنتَ أَملَأُ لِلعُيونِ لَدَيهِمِ","وَأَجَلُّ قَدراً في الصُدورِ وَأَكبَرُ",80,"ر",1,0],["وَلا نافِعي سَكبُ الدُموعِ الَّتي جَرَت","لَدَيها وَلا فَرطُ الحَنينِ المُرَجَّعِ",81,"ع",1,0],["وَلَاِنقَلَبَت نَحوَ العِراقِ مُغِذَّةً","حَمولَةُ رِفدٍ مِن حَمولَةَ توضِعُ",82,"ع",1,0],["وَلا نَجَوا إِنَّ النَجاةَ يَسيرَةٌ","وَلَكِن سُيوفٌ أَكرَهَتها رِجالُها",83,"ل",3,0],["وَلَأَنتَ غالِبُ غالِبٍ يَومَ النَدى","كَرَماً وَواهِبُ رِفدِها وَجَزيلِها",84,"ل",3,0],["وَلانَ حَتّى إِذا هَمَمتُ بِهِ","أَيقَظَني ياسِرٌ فَلا كانا",85,"ن",2,0],["وَلا نَثَرَ الجاني ثِباناً أَمامَها","وَلا اِنتَقَلَت مِن رَهبَةٍ سَيلَ مِذنَبِ",86,"ب",1,0],["وَلا نُحالِفُ إِلّا اللَهَ مِن أَحَدٍ","غَيرَ السُيوفِ إِذا ما اِغرَورَقَ النَظَرُ",87,"ر",1,0],["وَلا نَستَجِمُّ الخَيلَ حَتّى نُعيدَها","غَوانِمَ مِن أَعدائِنا وَهيَ زُحَّفُ",88,"ف",1,0],["وَلا نَقتُلُ الأَسرى وَلَكِن نَفُكُّهُم","إِذا أَثقَلَ الأَعناقَ حَملُ المَغارِمِ",89,"م",1,0],["وَلَأَنتَ أَشجَعُ حينَ تَتَّجِهُ ال","أَبطالُ مِن لَيثٍ أَبي أَجري",90,"ر",2,0],["وَلا نَبيتُ إِذا شِئنا نُعاقِرُها","لَنا عَلى البابِ حُفّاظٌ وَحُرّاسُ",91,"س",1,0],["وَلا نُضِع فُرصَةَ الزَمانِ فَما","تَعلَمُ ما في حَوادِثِ النُوَبِ",92,"ب",1,0],["ولا ندىً فيه ضروبُ الغنى","إلا ندى هذا مليكِ الزّمان",93,"ن",1,0],["وَلَأَنتَ أَوضَحُ فيهِمُ مِن غُرَّةٍ","شَدَخَت وَفازَ بِها الجَوادُ الأَدهَمُ",94,"م",1,0],["وَلَأَنتَ أَكرَمُ مِن نَوالِكَ مَحتِدا","وَنَداكَ أَكرَمُ مِن عَدُوِّكَ مَحتِدا",95,"د",2,0],["ولأنتِ أحوجُ بعدَ أتعابِ","الرُّضُوخِ إلى جِمَامِ",96,"م",1,0],["ولا نُعاني طوِّياتٍ معقَّدةً","كما يَحُلُّ تلاميذٌ تمارينا",97,"ن",2,0],["وَلأنتُمُ إن غاب نجمٌ يُقتدى","أو حُمَّ خَطبٌ حالِكٌ غِرْبيب",98,"ب",1,0],["وَلأْنتُمُ أنْتُمْ – وليس سواكمُ","أملُ البلادِ وذُخْرُها المطلوب",98,"ب",1,0],["وَلأْنتُمُ إذ لا ضمائرَ تُرْتَجَى","للرافدَيْن ، ضمائرٌ وقلوب",98,"ب",1,0],["ولأنتُمُ إن شوّشتْ صفحاتِنا","مما أُجِدَّ نقائصٌ وذُنوب",98,"ب",1,0],["وَلا نِسوَةٌ صَبَّغنَ كَبداءَ جَلعَداً","لِتُشبِهَ لَيلى ثُمَّ عَرَّضنَها لِيا",99,"ي",2,0],["وَلأَنتِ جامعةُ الدّهورِ وأهلِها","وكفاكِ ما جَمعتْ لك المَثُلاتُ",100,"ت",1,0],["ولأنتِ إن عظُمتْ فوائدُ خيبرٍ","أسْنَى وأعظمُ ما أفادتْ خَيبرُ",101,"ر",1,0],["وَلانَ حَتّى إِذا هَمَمتُ بِهِ","نُبِّهتُ عِندَ الصَباحِ لا كانا",102,"ن",2,0],["ولأنتَ أفضَلُ من تُشيرُ بجاهِهِ","تحتَ المِظَلّةِ بالسلام يمين",103,"ن",1,0],["وَلا نُطيلُ البُكا إِذا شَطَّتِ ال","نِيَّةُ وَاِستَعبَرَت لِذاهِبِها",104,"ب",3,0],["وَلا نَقَلتُ إِلى حانوتِهِ قَدَماً","وَلا نَبَذتُ إِلَيهِ النَقدَ فَاِختارا",105,"ر",2,0],["ولأَنا قد أردنا","غير ما الناس أرادوا",106,"د",3,0],["وَلا نفع السيف الصَقيل حديده","مضاء وَلا الرمح الطَويل عسول",107,"ل",1,0],["ولا نَسمتْ غيرَ روحِ الهوى","ولا غيرَ أنفاسهِ أو شَذاهْ",108,"ه",1,0],["ولا نَقولُ غيرَ ما قد قالوا","لأنَّه من قَولنا مُحالُ",109,"ل",1,0],["وَلاَ نَثْرَ بَعْدَ اليَوْمِ عَذْبٌ مَساغُهُ","سَلِيمٌ مِنَ العِلاَّتِ غَانٍ عَنِ الحِلَى",110,"ل",2,0],["وَلاَ نَأَى عَنْ مَسْمَعِ القَوْمِ مَا","غنَّيْتِ مِنْ أُنْشُودَةٍ بِكْرِ",111,"ر",1,0],["وَلأَنْتَ أَسْمَحُ مَنْ يُؤَمُّ جَنَابُهُ","فَيُعيدُ إِعْسَاراً إِلى الإِيسارِ",112,"ر",1,0],["وَلأَنْتَ خَيْرُ بَقِيَّةٍ","منْهَا تُرْجَى أَوْ تُهَابْ",113,"ب",1,0],["ولأنت أجدر بالذي","قال الفتى المُتَنطِّس",114,"س",1,0],["ولأنتَ خيرُ لسان صدقٍ ناطقٍ","عنها إذا صَمَتَتْ ، وخيرَ كتاب",115,"ب",1,0],["ولأنْتَ القديرُ بالرغم مما","عِشْتَ من جَمْعِنا على التأليف",116,"ف",1,0],["ولانك استمت العدالةَ خطةً","من في يديه النقضُ والإِبرام",117,"م",1,0],["ولا نمحى كلُ رَسمٍ من مَعالمكُم","ولاشتَفَتْ بِكُم الأمثالُ والسِيَر",118,"ر",1,0],["ولأنتِ إنْ أدبرتِ مُبديةٌ","للعينِ أحسنَ ما ترى خَلْفا",119,"ف",2,0],["ولأن الشعورَ يُوريهِ ابداعُكِ","وَرْيَ الزِنادِ بالإحتِكاك",120,"ك",1,0],["ولا نكبِتُ العاطفاتِ الجْياعَ","فيُشرِقنا كبتُها بالشجا",121,"ا",1,0],["ولأنتَ صُنْتَ الدارَ يومَ أباحها","باغٍ يُنازلُ في الكريهةِ طالبا",122,"ب",2,0],["وَلأنتَ أثخَنْتَ الفؤادَ من الأسى","للمثُخَنينَ مِن الجراحِ تعاقُبا",122,"ب",2,0],["ولأنَّها أبداً تدوسُ أفاعياً","منهمْ تَمُجُ سمومَها وعقاربا",122,"ب",2,0],["ولأنتَ أعلمُ إنْ تُزحْزَحْ عندَهم","شبراً ، فسوفَ يُزحزحونكَ ميلا",123,"ل",2,0],["وَلاَنَ حَتَّى إِذا هَمَمْتُ","أَيْقَظَنِي ياسِرٌ فلا كَانَا",124,"ن",2,0],["ولا نحالف غير الله من أحد","إلا السيوف إذا ما اغرورق النظر",125,"ر",1,0],["ولأنت أولى بالتجاوُزِ والندى","يا بنَ الملوكِ وساسة الآيين",126,"ن",1,0],["ولانَصْرَ إلاّ قيْنَة ٌ وأكاويب","وإن اختلَفْنا حينَ تَنسِبْنا أبَا",127,"ب",2,0],["ولا نكُ مثلَ نادبة ِ المسجَّى","بَكت كَسْباً، ولم تَبْكِ الْتِياعا",128,"ا",1,0]]}