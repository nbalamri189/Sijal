{"poems":[[55,"هوى لكما إن الشباب يعاد","https://www.aldiwan.net/poem30513.html","الطويل"],[30,"رويد عن الأمر الذي كنت جاهلاً","https://www.aldiwan.net/poem1275.html",""],[82,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[48,"يلام الممسك الإعطاء حتى","https://www.aldiwan.net/poem23234.html","الوافر"],[202,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[266,"رمقن ما بي فعفن الحب من رمقي","https://www.aldiwan.net/poem38225.html","البسيط"],[457,"أرى زهر القرنفل قد جليت","https://www.aldiwan.net/poem13909.html","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104581","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38067","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96635","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96740","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109064","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44821","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108580","الطويل"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143196","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28550","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45710","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100266","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201767","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201459","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200503","الطويل"],[2964,"","https://poetry.dctabudhabi.ae/diwan/poem/121986","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121785","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62830","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120518","البسيط"],[5561,"على قارعة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=195028",""],[5582,"قِفا وَاَسْعِدانِي كَيْ نُحَيِّي المَنازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=187238",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[5582,"أَضَرَّ بِكَ الوَجْدُ لَمَّا تَمادَى","https://www.poetsgate.com/ViewPoem.aspx?id=63488",""],[5881,"تنثر أعذاراً وتختلق","https://www.poetsgate.com/ViewPoem.aspx?id=183796",""]],"verses":[["أَرى زُهدَ مُستامٍ وَأَرجو زِيادَةً","ضَلالاً أَبَينَ الزاهِدينَ أُزادُ",0,"د",1,0],["أَرى زَهدَماً لا يَستَطيعُ فَعالَهُ","لَئيمٌ وَلا الكَسبَ الَّذي هُوَ كاسِبُه",1,"ب",2,0],["أرى زَمَنَ الدنْيا يُنَقِّلُ أهلها","إلى دار أخرى من غنيّ ومعدمِ",2,"م",1,0],["أَرى زَمَناً تَقادَمَ غَيرَ فانٍ","فَسُبحانَ المُهَيمِنِ ذي الكَمالِ",3,"ل",1,0],["أرى زهرةَ العَليا تجفُّ وماؤها","يغيضُ وأرواح البشاشة تركد",4,"د",1,0],["أرى زماني على الشحناء منطويا","كالماء يطوى لظمآنٍ على الشرق",5,"ق",1,0],["أرى زَهْرَ القرنفلِ قد جُلِيَتْ","قدودٌ ترجحنَّ به قيامُ",6,"م",1,1],["أرى زهرةَ الدَّنيا بعينٍ مريضةٍ","عليها حجابٌ من زُجاجٍ ممردِ",7,"د",1,0],["أَرى زَمَني كَالصَّيفِ قد زادَ حَرُّهُ","وكلُّ الخبايا فيه من حُجره بُزْغُ",8,"غ",1,1],["أَرى زَمني لم أَخل أنّهُ","تودّد لي بعد منه إلّا بعادا",9,"د",2,0],["أَرى زمني وأهليهِ أراه","أراه ما رآهم ما أراني",10,"ن",2,0],["أرى زيجة الإثنين إن لم يكن هوى","خداعا تغطى بالتغاضي وبالصبر",11,"ر",1,0],["أَرَى زَفرَتِي تُذكَى وَدَمعِيَ يَنهَمِي","نَقِيضَينِ قَاما بالصِلاء وَبالوردِ",12,"د",1,0],["أرى زهرة الزمان غضبي على الطلا","وزهر الطلا الجبار لا يطلب الصلحا",13,"ح",2,1],["أرى زمن الشبيبة قد تقضى","وأخلق برده الغض القشيب",14,"ب",1,1],["أَرى زَفَراتِ الحُزنِ بَعدَكَ سَلوة","يَدُلُّ عَلى وِجدانِ قَلبٍ وَأَضلُعِ",15,"ع",1,0],["أَرى زلتي كُفراً فَهَل لي تَوبَةٌ","وَكَم كافر بِاللَه راجَ لِغُفرانِهِ",16,"ه",1,1],["أرى زمني المزيد بدا بطردٍ","وأعقبني بعكس من مرادي",17,"د",2,0],["أرى زمني تجاهلني وإني","على رغم الزمان عرفت قدري",18,"ر",2,0],["أرى زهر شعري كاد يذوي من الظما","ويترك روضَ الشعر في الكون ذابلاً",19,"ل",2,1],["أرى زهر شعري كاد يذوي من الظما","ويترك حقل الشعر في الكون قاحلا",20,"ل",2,1],["أرى زمناً قد جاء يقتنص المها","بلا جارح والأسد في فلواتها",21,"ت",3,1],["أرى زمناً كنتَ فيه العَمِي","دَ عِرْسَ الكِرامِ وعيدَ الفَلَكْ",22,"ك",1,0],["أرى زَمناً ضاعَ أحْرارُهُ","وعيشاً يضُرُّ ولا ينْفَعُ",23,"ع",1,0],["أرى زماني وفي سيماه تبشير","بان في الناس شهما طبعه الخير",24,"ر",1,1],["أرى زمَرَ التمنّي مُهلكاتٍ","تجيِّشُ فيكَ ما كبُرَ الحنينُ",25,"ن",1,0],["أَرَى زَمَنِي فِي حُكْمِهِ وَقَضائِهِ","إِذا جَدَّت النَّفْسُ الأَبِيَّةُ هازِلا",26,"ل",2,0],["أَرَى زَمَنِي إِذا ما قُلْتُ هَمَّتْ","أَوامِرُهُ لِجَبْرِ الكَسْرِ هاضَا",27,"ض",2,0],["أَرَى زَمَنِي لَمْ أَخَلْ أَنَّهُ","تَوَدَّدَ لِي بَعْدُ إِلاَّ تَعادَى",28,"د",2,0],["أرى زهوري وقد ماتت نضارتها","وألف دمعة شوقٍ تنزف الحدق",29,"ق",1,0]]}