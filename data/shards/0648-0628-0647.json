{"poems":[[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[55,"أسأل الله خير هذا المسير","https://www.aldiwan.net/poem26285.html","الخفيف"],[77,"يا وارث المهدي في الجبل الذي","https://www.aldiwan.net/poem36511.html","الكامل"],[71,"ريح الشمال عساك أن تتحملي","https://www.aldiwan.net/poem4013.html","الكامل"],[82,"وبهار حكى كؤوس لجين","https://www.aldiwan.net/poem29408.html","الخفيف"],[10,"مرهت عيني فعيني","https://www.aldiwan.net/poem21115.html","مجزوء الرمل"],[93,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[83,"يا من له الوجه الجميل إذا بدا","https://www.aldiwan.net/poem54263.html","الكامل"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[51,"كنز الله في كنيزة نتنا","https://www.aldiwan.net/poem64718.html","البسيط"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"يا رجلا أوفى على كل رجل","https://www.aldiwan.net/poem65868.html","الرجز"],[51,"سئل الأير ما تريد إلى الكعثب","https://www.aldiwan.net/poem65932.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"أيها السيد الذي جل عن شكري","https://www.aldiwan.net/poem66516.html","الخفيف"],[91,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[38,"تغير قومي ولا أسخر","https://www.aldiwan.net/poem7712.html","المتقارب"],[89,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[43,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[43,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[62,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[62,"الصلب يخلط بالرطوبة مدة","https://www.aldiwan.net/poem52221.html","الكامل"],[62,"بالنار صنعتها وفيها","https://www.aldiwan.net/poem52236.html","مجزوء الكامل"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[45,"ريح الشمال أتت بريح شمال","https://www.aldiwan.net/poem65636.html","الكامل"],[28,"شعثا شوازب قد طوى أقرابها","https://www.aldiwan.net/poem5483.html","الكامل"],[58,"أجد الثياب إذا اكتسيت فإنها","https://www.aldiwan.net/poem30852.html","الكامل"],[66,"أنعم وشرف بالجواب","https://www.aldiwan.net/poem39053.html","مجزوء الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[97,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[31,"أرسلت خلتي إلي بأنا","https://www.aldiwan.net/poem42604.html","الخفيف"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[81,"عميد أصيب عن عمد","https://www.aldiwan.net/poem61406.html","الطويل"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[50,"وبهماء يستاف التراب دليلها","https://www.aldiwan.net/poem62305.html","الطويل"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140807",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30470","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20994","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55188","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55117","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"أتَرَاكَ تَسْمَعُ، للحَمَامِ الهُتَّفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32843",""],[45,"إنّ طَيْفاً يزُورُني في المَنامِ","https://www.poetsgate.com/ViewPoem.aspx?id=31854",""]],"verses":[["وَبَهاءٌ وَضِياءٌ","وَغِياثٌ وَقِوامُ",0,"م",1,0],["وَبِهَجرٍ مِنَ الحَبيبِ فَلا تَس","أَل بِأَحوالِ عاشِقٍ مَهجورِ",1,"ر",1,0],["وبهِ مُصَلاّهُ ومدْرَسُهُ الذي","أهْدى منَ التّوْحيدِ يانِعَ زَهْرِهِ",2,"ر",2,0],["وَبِهِ يَبيتُ الحلمُ مُعتَصِماً إِذا","هَزَّت رِياحُ الشَوقِ رُكني يَذبُلِ",3,"ل",1,0],["وبهار حكى كؤوس لجين","حملتها أناملٌ من زبرجد",4,"د",1,1],["وَبِها مِن صَخرَ شَيءٌ","لَيسَ يُحكى بِالصِفَه",5,"ف",2,0],["وبه يعود هوى النفوس إلى الهدى","بتسلط الآراء والأفكار",6,"ر",1,0],["وبها من الأَترجِّ شمسٌ أطلعت","من كل شطر للعيونِ هلالا",7,"ل",2,0],["وبها من النَّقْل الشَّهيِّ مذكَّرٌ","عهداً تولّى ليْتَهُ يتوالى",7,"ل",2,0],["وبها الأرض والسموات ترضى","وتُقِرّ التوراة والإنجيل",8,"ل",1,0],["وبه اهتدوا فتتابعوا في نصره","من طائعٍ وافى إليه ومهطع",9,"ع",1,0],["وبه من طَعَامِهِمْ","فَحَجٌ أيُّمَا فَحَجْ",10,"ج",1,0],["وبها غُلمةٌ تزيد على الني","ك استعاراً كالنّارِ حين تُحشُّ",11,"ش",1,0],["وبه نحوك الشعر فيه لأننا","تبع لمفتقر الفعال مَقِيفه",12,"ف",2,0],["وبهجةُ الزينةِ أوْلى بالعُطل","أو ينكُلُ الماضونَ أو يمضي النُّكل",13,"ل",1,0],["وبها ترعوي حياتي إذا مِتْ","تُ وتشتدُّ قوّتي حين أذبلْ",14,"ل",1,0],["وبهذا قضى لك الشعرُ شكراً","لك يا خير قَيِّمٍ ومُعاني",15,"ن",2,0],["وبه تكْتَسِي الرِّياضُ بقاعاً","مُونِقاتٍ مِنْ كُلِّ سَهْلٍ وحَزْن",16,"ن",1,0],["وَبِهَذِهِ الأَوتارِ سِحرٌ جائِلٌ","مُتَمَلمِلٌ كَالوَحيِ حانَ ظُهورُهُ",17,"ر",2,0],["وَبُهمى أَنابيبُها تَقطُرُ","فَظَلَّ يُقَلِّبُ أُلّافَهُ",18,"ه",1,0],["وبه رحبت ملائكة العر","ش كما ينبغي له التبجيل",19,"ل",1,0],["وبه يستقل بالرغم","من عصبة الامم",20,"م",1,0],["وَبِها شَبابُكَ وَاللِداتُ بَكَيتُهُ","وَبَكَيتُهُم بِالمَدمَعِ الذَرّافِ",21,"ف",1,0],["وَبِهِ تَلوذُ الطَيرُ في طَلَبِ الكَرى","وَيَبيتُ قَيصَرُ وَهوَ مِنهُ مُؤَرَّقُ",22,"ق",1,0],["وَبِهِمَّةٍ في كُلِّ نَفسٍ حَلَّقَت","في الجَوِّ وَاِرتَفَعَت عَلى كَيوانِهِ",23,"ن",2,0],["وَبِهِ يُبارِكُ في المَما","لِكِ وَالمُلوكِ عَلى الدُهور",24,"ر",1,0],["وَبِهِم فَخرُ كُلِّ مَن نَطَقَ الضا","دَ وَعَوذُ الجاني وَعَوثُ الطَريدِ",25,"د",1,0],["وَبِهِ يُضَنُّ عَلى البَرِيَّةِ لا بِها","وَعَلَيهِ مِنها لا عَلَيها يوسى",26,"س",2,0],["وبهذا قال الحكيم برمز","غامض بيّن خفي شهيرِ",27,"ر",1,0],["وبهذه الأجساد لما جن في ال","أجساد قد صار الثخين نضارا",28,"ر",2,0],["وبها لدى التحمير زال","بياضها وسوادُها",29,"د",3,0],["وَبَهَولِ إيعادِ الهِزَبرِ فَإِنَّهُ","قَصَفَ العَدُوَّ بِرَعدِهِ المُتَقَصِّفِ",30,"ف",1,0],["وَبِها غَنيتُ عَنِ العِبادِ رَسولَةً","تَفري القِفارَ وَما تَني لِكَلالِ",31,"ل",1,0],["وَبِهِنَّ نَدفَعُ كَربَ كُلُّ مُثَوِّبٍ","وَتَرى لَها خُدَداً بِكُلِّ مَجالِ",32,"ل",1,0],["وَبهاءُ ثَوبِكَ لا يَضُرُكَ بَعدَ أَن","تَخشى الإِلَهَ وَتَتَّقي ما يَحرُمُ",33,"م",1,0],["وَبِهِ القُدورُ الراسِياتُ","لَدى جِفانٍ كَالجَوابي",34,"ب",2,0],["وَبِهِ الجَواري المُنشَآتُ كَأَنَّها","أَعلامُ بيدٍ أَو فُروعُ قِنانِ",35,"ن",1,0],["وبه من إشعاعه أثر البرق","إذا مرّ خاطفاً ناظريه",36,"ه",1,0],["وبه قد رفرفَ الصمتُ علينا","إنَّ في صَمتِ الحبيبين عباده",37,"ه",1,0],["وبه قد رفرف الصمت علينا","إنَّ في صمت المحبين عباده",38,"ه",1,0],["وبه شتى لحون من أسى","وحنين وأنين وتمني",38,"ي",1,0],["وبها ارتعاشة طائر فزع","من قلبها تسري إلى كتفي",39,"ي",1,0],["وَبِهِ رَأَينا كَعبَةَ اللَهِ الَّتي","هِيَ كَوكَبُ الدُنيا تُحِلُّ وَتُحرِمُ",40,"م",1,0],["وَبِهَضبَتَي أَبرَشتَويمَ وَدَروَذٍ","لَقِحتِ لَقاحَ النَصرِ بَعدَ حِيالِ",41,"ل",1,0],["وَبِهِجرانِكَ الرَبابَ حَديثاً","سَوأَةٌ يا خَليلَ ما قَد فَعَلتا",42,"ت",2,0],["وَبِهِم ماجَرَّ ذَلِكَ مِن","كَلَمِ عارٍ أَو جَنى كَلِمِ",43,"م",1,0],["وَبِهِ خافِقُ الحَشا حَلّا","وَعَن وِردِ وَصلِهِ حَلّا",44,"ل",2,0],["وَبَهماءَ دَيمومٍ كَسَوتُ قِفارَها","مَناسِمَ حُرجوجٍ وَبَهماءَ عَرَّيتُ",45,"ت",1,0],["وَبهَا أخبَر النبيُّ وكم أخ","رَجَ خَبْئاً له الغُيُوبُ خِبَاءُ",46,"ا",2,0],["وَبهِ جَنَّاتُ عَدْنٍ رُفِعَتْ","عَلَماً أَبْوابُها لِلْمُسْلِمِينا",47,"ن",2,0],["وَبهِ نُوحٌ دَعا في فُلْكِهِ","فَأَغاثَ اللهُ نوحاً والسَّفِينا",47,"ن",2,0],["وَبَهماءُ يَستافُ التُرابَ دَليلُها","وَلَيسَ لَهُ إِلاّ اليَمانِيّ مَخَلقُ",48,"ق",1,1],["وبِهِمْ فَضَّلَ المَلِيكُ بَني حَوّا","ءَ حتى سَمَوْا على الحَيَوانِ",49,"ن",1,0],["وبها ألبانٌ تفيضُ ولهوٌ","وأباريقُ ثرةٌ وخمور",50,"ر",1,0],["وبها رمانٌ ونخلٌ وأعنا","بٌ وطلحٌ تشدو عليه الطيور",50,"ر",1,0],["وبهاروت ثم ماروتَ والسح","ر الذي أسدلت عليه الستور",50,"ر",1,0],["وبها بعد ذلكم ثمراتٌ","وبها أكوابٌ وفيها خمور",50,"ر",1,0],["وبها دوحةٌ يقال لها الطو","بى لها ظل حيث سرت يسير",50,"ر",1,0],["وبه لي بعد الظهور خفاءٌ","وله بي بعد الخفاء ظهور",50,"ر",1,0],["وبهم فخر كل من نطق الضا","د وعوذ الجاني وغوث الطريد",51,"د",1,0],["وبها من خفاءِ مهبطه الخا","في خفيُّ الأخبارِ والأوصافِ",52,"ف",1,0],["وَبِها صَدَفتُ عَنِ الضَلا","لَةِ وَاِهتَدَيتُ إِلى الصَواب",53,"ب",1,0],["وَبِها البَنَفْسَجُ قد حكى بخُضُوعِهِ","وقُنُوِّ لَوْنٍ في سَوَادٍ مُشْبَعِ",54,"ع",1,0],["وبِها فِدىً لَكَ ما عَلا قَدَمي","قابُوسُ مِن جَسَدي نَعَم وأَبي",55,"ب",2,0],["وَبِهِ السَّلْوَى إِذَا الْحَظُّ التَوَى","وَبِهِ الأَمْنُ إِذَا الآمِنُ رِيعْ",56,"ع",1,0],["وَبِهِ دَفْع الرَّزَايَا عَنْكمُ","إِنَّ فِعْلَ البُؤْسِ فِي الخَلْقِ فَظِيعْ",56,"ع",1,0],["وَبِهَا سَمَا أَوْجَ المَرَاتبِ وَاقْتَنَى","أَسْنَى السِّمَاتِ وأَحْرَزِ الأَلْقَابَا",57,"ب",2,0],["وَبِهِ غِيَاثٌ لِلَّهِي","فِ وَنَجْدَةٌ لِلْمُسْتَضَامِ",58,"م",1,0],["وَبِهِ ينتَهِي التَّفَاوُتُ بَيْن الخلْقِ","وَالتَّفْرِقَاتُ فِي الآجالِ",59,"ل",1,0],["وَبِهَا يَبُزُّ مُنَافِسِيهِ ظَافِراً","وَبِهَا يُوَامِقُ رَاشِداً وَيُقَالِي",60,"ل",2,0],["وَبِهِ مِنَ الإِيقَاعِ ضَرْ","لاَ تُحَاكِيهِ الضّرُوبُ",61,"ب",1,0],["وَبِهِ أَحْمَدُ ارْتَقَى","ذُرْوَةَ الشِّعُرِ في الْعَرَبْ",62,"ب",1,0],["وَبِهِ يَرُوضُ الصَّعْبَ كُلُّ أَخِي حِجًى","فَكَأَنَّهُ أَسَرَ العِبَادَ جَمِيلاً",63,"ل",2,0],["وَبَهْجَةٌ سَاطِعَةٌ بِالبِشْرِ","أَعَارَتِ اللَّيْلَ ضِيَاءَ الفَجْرِ",64,"ر",1,0],["وَبِهَذا يَترَّضَّى شعْبَهُ","فرْطَ ما الشَّعْبُ بِذاكَ اللَّهْوِ مُغْرى",65,"ر",2,0],["وَبهَا يَدْركُ المَقَامَ الْمُعَلَّى","مَنْ بكَ أَتَمَّ عَنْ هُدَى وَرَشَاد",66,"د",1,0],["وَبِهِ يُوقَى العَالِمُونَ تَحَوُّلاً","رَاعَ النُّهَى بِنَذِيرُهِ المُتَعَاقِبِ",67,"ب",1,0],["وَبِهِ الائِمَّةُ وَالْوَلاَةُ وَكُلُّ مَنْ","فِي قَوْمِهِ هُوَ سَيِّدٌ وَعَمِيدُ",68,"د",1,0],["وَبِهَدْيِهِمْ رَضِيَ الإلهُ لِخَلْقِهِ","وَبِجَدِّهِمْ نُصِرَ النّبيُّ المُرْسَلُ",69,"ل",1,0],["وَبِها تُشرِفُ الأَوائِلَ مُلكاً","وَتُباهى مُكاثِري الإِسلامِ",70,"م",1,0],["وبَهاءُ الرِّياضِ كَللَها الغَيْثُ","فتَاهَتْ بنَوْرِهنّ بَهاؤُهْ",71,"ا",3,0],["وبه تَمثَّل كلُّ صَبٍّ","يشْتكي خِلاًّ هَجَر",72,"ر",1,0],["وبه تُشْغَف السوائم حبًّا","ويراها دُونَ الورى أحبابه",73,"ب",2,0],["وبهذا يبيدنا كل عاد","ويبيد القرين منا القرينا",74,"ن",2,0],["وبها تَسَتَّرَ عن صَغارةِ نفسِهِ","خَزيانَ يأكُلُ زادهُ ويَنام",75,"م",1,0],["وَبِهَوْلِ إبعادِ الهِزَبْرِ، فإنّهُ","قَصَفَ العَدوَّ برَعْدِهِ المُتَقَصِّفِ",76,"ف",1,0],["وَبِهَا تَشْرَبُ الأوَائِلُ مُلْكاً،","وَتُباهي مُكاثِري الإسْلامِ",77,"م",1,0]]}