{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54764","الخفيف"],[92,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[556,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[563,"قد جاء ربنا لنا","https://www.aldiwan.net/poem33876.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122788","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122789","المديد"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77591","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77630","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25318","الرجز"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102133","المنسرح"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109510","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102715","المواليا"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100392","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138445",""],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125956","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[5431,"ثورة السودان (3)","https://www.poetsgate.com/ViewPoem.aspx?id=202088",""],[402,"قف بهذا الضريح وابك فقيدا","https://www.poetsgate.com/ViewPoem.aspx?id=35418",""]],"verses":[["والْمِثَالُ الْفَرِيدُ فِي الدَّينِ","وَالدنْيَا جَمِيعاً بِكُلِّ مَعْنىً فَرِيدِ",0,"د",1,0],["والمثُخنِ المجهولِ لم يَنشُد يداً","تأسوا الجْراحَ ولا تَطلَّب ناشدا",1,"د",2,0],["والمثْبتونَ أَسْنَدوا","أَدِلَّةً وشَيَّدوا",2,"د",3,0],["والمثْبتُونَ أَوْلَى","وَرَاجِعِ الأصُولاَ",2,"ل",2,0],["والمثقِلاتِ المُعْييا","تِ من الأمور الهيّناتِ",3,"ت",1,0],["والمثل الأعلى له","في الأرض والسما يقام",4,"م",1,0],["والمَثاني يَحُثُّها نَغَمُ الطَّي","رِ بِلَحنٍ ضُرُوبُهُ ألحانُ",5,"ن",1,0],["والمَثاني في تَرَنُّمِها","ضَربُها مَثنَى وَوُحدانُ",6,"ن",1,0],["وَالمثل الثاني استمعه وَاتَّخذ","كَم آخِذٍ شَيئاً بِجَهله أُخِذ",7,"ذ",1,0],["وَالمثل الشائع عَينُ الصدق","أَلسنة الخَلق كلامُ الحَق",8,"ق",1,0],["والمثل المضروب بالاسكندر","وبابنه علامة فاذكر",9,"ر",1,0],["وَالمَثُلاتُ قَبْلَنَا لَنْ تُمْتَحا","وَقَدْ رَأَيْنا مُلْكَ قَوْمٍ فِي رَحَا",10,"ح",2,0],["والمثلِ والمكاسِب","ما سارَت النجائِب",11,"ب",1,0],["والمثل السائر بين الملا","بالخير قد كان له شاهدا",12,"د",2,0],["وَالمُثبِتُونَ طَرِيقُهُم نَفيٌ عَلَى ال","إجمَالِ وَالتَّفصِيلِ بِالتِّبيَانِ",13,"ن",1,0],["والمثاني لها رنات والأنس حاصل","والمشاميم شيء مجنا وشيء منه ذابل",14,"ل",1,0],["والمثقل النادي اذا عقد الحبا","والمستخف من الجبال حلوما",15,"م",2,0],["والمثل الأعلى وأسماؤه ال","حسنى فمعنى الكل فيها انجلا",16,"ل",2,0],["وألمثها وتلثمني","وفوق رؤسنا الطهر",17,"ر",1,0],["والمثنى وابن الحسين علي","من به كل مقتد لن يضارا",18,"ر",2,0],["والمثخنون بقهرهم","والنازفون مع الرواح",19,"ح",1,0],["والمثال الفريد في الدين","كان أحرى الاسماء بالتخليد",20,"د",1,0]]}