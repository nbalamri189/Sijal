{"poems":[[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[55,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[65,"أبت إبلي والليل وحف الغدائر","https://www.aldiwan.net/poem46167.html","الطويل"],[88,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[74,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[93,"رأيت غلاما مليح الرواء","https://www.aldiwan.net/poem8783.html","عموديه"],[94,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[47,"أنبيك عن عيني وطول سهادها","https://www.aldiwan.net/poem63499.html","الطويل"],[63,"ملامك في الهوى أذكى غليلي","https://www.aldiwan.net/poem51484.html","الوافر"],[68,"حتام أمنحك المودة والوفا","https://www.aldiwan.net/poem38754.html","الكامل"],[76,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[77,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[50,"لم أشرك الناس يوم العيد في الفرح","https://www.aldiwan.net/poem62529.html","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[92,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[147,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[189,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[189,"بكم آل وحي الله يفتخر المجد","https://www.aldiwan.net/poem14508.html","الطويل"],[208,"رحلت وما شوقي عن الإلف راحل","https://www.aldiwan.net/poem53189.html","الطويل"],[228,"أطبق جناحيك معقودا لك الظفر","https://www.aldiwan.net/poem39690.html","البسيط"],[228,"أطلت من الشباك والليل نير","https://www.aldiwan.net/poem39705.html","الطويل"],[234,"إذا لم أصدق ظن كل مؤمل","https://www.aldiwan.net/poem50857.html","الطويل"],[261,"ولم أطرب إلى عذراء رود","https://www.aldiwan.net/poem48377.html","الوافر"],[275,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[382,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[396,"متى متى ياسا كنين سمعون","https://www.aldiwan.net/poem54484.html","عموديه"],[412,"ولما طواك البين واجتاحك الردى","https://www.aldiwan.net/poem50151.html","الطويل"],[445,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[449,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[468,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[469,"لقد وافيت بابك مستغيثاً","https://www.aldiwan.net/poem3568.html","عموديه"],[520,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[556,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[556,"رأينا بوادي الرمث ظبي صريمة","https://www.aldiwan.net/poem47874.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122589","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130152","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63786","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38775","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107201","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96609","الطويل"],[1113,"","https://poetry.dctabudhabi.ae/diwan/poem/101186","السريع"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109220","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100955","الوافر"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76898","السريع"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53117","الهزج"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53248","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99080","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75898","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201753","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132614","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89014","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126960","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126921","الطويل"],[3557,"","https://poetry.dctabudhabi.ae/diwan/poem/140210",""],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138049","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35535","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119506","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119698","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136709",""],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116081","المتقارب"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35097","الطويل"],[4727,"أبت شفتايَ اليومَ إلا تكلُماَ","https://www.poetsgate.com/ViewPoem.aspx?id=215160",""],[4755,"لِصَمتِكِ وهْو يَقرَؤُنِي استِماعا","https://www.poetsgate.com/ViewPoem.aspx?id=197893",""],[5102,"غلطة..","https://www.poetsgate.com/ViewPoem.aspx?id=12894",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5452,"عذابي","https://www.poetsgate.com/ViewPoem.aspx?id=120639",""],[5582,"لِمَنْ مَرْبَعٌ للبُقْعِ فِيهِ نَعِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186672",""],[5956,"دعوت له بخيراتٍ كباراً","https://www.poetsgate.com/ViewPoem.aspx?id=194174",""],[5309,"عذابي اليم من مهاة اصابها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573548",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6269,"نار الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87855&r=&rc=17",""]],"verses":[["وَلَمّا طَغَت عَيلانُ في عِشقِ غَيِّها","رَماها مِنَ الكَيدِ الوَحيِّ بِساحِرِ",0,"ر",1,0],["وَلَمّا طُوي طَيَّ البُرودِ وَأَقبَلوا","يُهادونَهُ بَينَ الطُلى وَالمَناكِبِ",1,"ب",1,0],["وَلَمّا طَغى بادٍ وَأَضرَمَ نارَهُ","عَلى الغَدرِ إِنَّ الغادِرينَ ذِئابُ",2,"ب",1,0],["ولما طَوَتْ عنّي خُزَيْمةُ كَشْحها","ولم تَرْعَ في حَيَّيْ قُرَيْشٍ أواصِري",3,"ر",2,0],["وَلَمّا طَوى بَطحاءَ مَكَّةَ هَزَّهُ","إِلى البَيتِ شَوقُ المُستَهامِ فَيَمَّما",4,"م",2,0],["وَلَمّا طَغى عِلجُ العِراقِ اِبنُ رائِقٍ","شَفى مِنهُ لاطاغٍ وَلا مُتَكاثِرُ",5,"ر",1,0],["ولم أطرق الحيّ الخصيب زمانه","يقابلني زهرٌ لديه ومزهر",6,"ر",1,0],["وَلَمّا طَلَبَتُ الجَوابَ تَنحنَح","وَقالَ الحِلاقَةُ أَصلُ الشُرور",7,"ر",1,0],["ولمَّا طَغَتْ عَصَفاتُ القُنُوط","فمادتْ بكلِّ مَكِينٍ عَتيدْ",8,"د",1,0],["وَلَمّا طَغَت في دارِها الرومُ وَاِعتَدَت","سَفاهاً رَماها جَعفَرٌ بِحَصادِها",9,"د",3,0],["ولمَّا طابَ أصلاً طابَ فَرعاً","وطِيبُ الفَرعِ من طِيبِ الأصولِ",10,"ل",1,0],["وَلِمَ اِطَّلَعتَ عَلى جِبالِ مَوَدَّتي","فَجَعَلتَها بِالهَجرِ قاعاً صَفصَفا",11,"ف",2,0],["وَلَم أَطرُقِ الحَسناءَ تَهتَزُّ خوطَةً","وَتَسحَبُ مِن فَضلِ الضَفيرَةِ أَرقَما",12,"م",2,0],["ولمّا طَغَوا في الأرض أعصُرَ فتنةٍ","وكان دبيبَ الكفر في الدولة الخَلع",13,"ع",1,0],["وَلَم أُطاوِع فَماً فيهِ عَلى ضَحِكٍ","وَلا مَدَدتُ يَدي فيهِ إِلى قَدَحِ",14,"ح",1,0],["ولمّا طَما بحْرُ البيانِ بفِكْرتِي","وأَغْرقَ قَرْنَ الشَّمْسِ بعْضُ جداوِلي",15,"ل",2,0],["ولمّا طبَّقَ الأرَجُ الثنايا","وفُتِّح مِنْ جِنانِ الخُلدِ باب",16,"ب",1,0],["وَلَمّا طَغى نَصرٌ أَطَحتَ لَهُ الرَدى","فَلَم يَحمِهِ الجَمعُ الصَريحُ وَلا الحَشدُ",17,"د",1,0],["ولما طَمَى بحرُ الغرامِ بقلبه","طَفا زَبَدٌ في فَرْقِه من عُبابه",18,"ب",2,0],["ولما طغى شيطانُها وتأكدتْ","بذاك عليها حُجَّةٌ ما لها رَد",19,"د",1,0],["ولم أطوِ سرّي عنكمُ لاتِّهامكم","ولكن لإفشاء الحديث غوائلُ",20,"ل",1,0],["وَلَم أَطَأ قَلبَهُ إِلّا عَلى زَهَرٍ","وِسادَتي وَفِراشي قَلبُهُ العَطِرُ",21,"ر",1,0],["وَلَمّا طَوى اللَيلُ النَجِيُّ وشاحَهُ","وَجاءَ سَفيرٌ لِلصَّباحِ يُشَيِّعُ",22,"ع",1,0],["ولم أُطِع المعروفَ والبِرَّ والعُلا","وأَعْصِ ذواتِ الحُسنِ والأَعُينِ النُّجْل",23,"ل",1,0],["ولم أطرب إلى عذراء رودٍ","بها عن وصل عاشقها نفارُ",24,"ر",1,1],["ولمّا طالَ بي أَرَقي وهمِّي","نَهضتُ كموثَقٍ يَبغي الفرارا",25,"ر",2,0],["ولما طغى إبليس وهو مُخيَّرٌ","نفاه إلهُ المُلكِ عن مُلكه المَكفي",26,"ف",2,0],["ولم أطق وصف الذي عرفته","من شانهم أيضا وما خبرته",27,"ه",1,0],["وَلَمّا طَواكَ البين واجتاحَكَ الرَدى","بَكَيناكَ ما لَم نَبكِ قَطُّ عَلى قِطِّ",28,"ط",1,1],["ولم أَطْوِ سِنَّ الاكْتِهَالِ مُحاكِماً","إليك خُطُوباً شَيَّبَتْ مَفْرِقَ الطفلِ",29,"ل",1,0],["ولما طالت البلوى","تنادى القوم للشيم",30,"م",1,0],["ولما طال منبِتها وطالت","تفرَّع من رَواسيها رباها",31,"ا",3,0],["ولما طمعنا غمض جفن ليلة","ولما أسغنا لقمة في عافيه",32,"ي",2,0],["ولم أطمع بربعك في نعيمٍ","وقد شقيتْ بساحته الضيوف",33,"ف",1,0],["ولما طرا كسر العمود جبرتهم","فيا طيب شهد بعد مطعم صاب",34,"ب",1,0],["ولمّا طلعتَ ولم يشعروا","فأيقَظَهمْ من كرى الغافلِ",35,"ل",1,0],["وَلمّا طلبنا الوصلَ لم يكُ وصْلهُ","لطالبهِ إلّا السُّها والفراقدُ",36,"د",1,0],["ولما طَفَت سُفنُ النَّجاةِ وأرِسيَت","سَفينٌ ومَوجُ الموتِ مُضطَرِم الوَقد",37,"د",1,0],["ولما طرقت الحي وهنا تفطنت","فقالت تناجى جارها وجوارها",38,"ر",3,0],["ولما طار بأسُكَ أمسِ فيهم","هَفَوا جَزَعاً كما تَهْفُو الطيور",39,"ر",1,0],["وَلَمّا طيبُها قَد فاحَ عرفا","سَكِرنا إِذ نَشقنا مِن شَذاه",40,"ه",1,0],["ولَم أُطارِحكُمُ أَلحانَ ذِي شَجَنٍ","كَم حانَ مِنها لِمَن في الحانِ إِسكارُ",41,"ر",1,0],["ولما طَغَى حصنُ البَرَابِر واغتدت","معَاقِلُهُ تَحْمِي حِمَاهَا الجَنَادِلُ",42,"ل",1,0],["وَلَم أَطلب الفسحانَ منك تملّلا","وَهل يَملُل الخلّ الأديب أديبُ",43,"ب",1,0],["ولم اطل بردي في غارة","اجلبها خيلا وركبانا",44,"ن",2,0],["ولم أطلب من الدنيا محالا","ولكني سألت رضاً ومالا",45,"ل",2,0],["ولم أُطِع النهى غدراً ولكن","يلذ الحبَّ من وجَد الشبابا",46,"ب",2,0],["وَلم أَطِق لمّا جرت أدمعي","لَها من الحرقة أن أَمنعا",47,"ع",2,0],["ولم أَطْوِ كَشْحاً دون ذاك ولا رأت","على سَتْرهِ نفسي التِحافَ كِساءِ",48,"ا",2,0],["ولما طاف بالك","أس وحيَّانِيَ بالثغر",49,"ر",1,0],["ولما طغى البحر الخضمّ بأهله الطغ","اة وأضحى بالمراكب مزبدا",50,"د",2,0],["ولما طال انتزاحي","عن بلادي واغترابي",51,"ب",2,0],["وَلَمّا طَغى الإِنسانُ سَلَّطَ رَبُّهُ","عَلى نَفسِهِ مِن نَفسِهِ عُضوَهُ الفَردا",52,"د",2,1],["ولم أطق مثلكم وثبةً","لكي تروا في جيشكم ضربي",53,"ب",2,0],["ولما طغى أمر البغاة واعلنوا","بما قد أسرّوا من غوايتهم جهرا",54,"ر",2,0],["ولم أطل في مدحه كلمى","وصفاً على كبير شهرته",55,"ت",2,0],["ولما طغى تيار جدواه أصبحت","تعوم بنو الآمال فيه وتسبح",56,"ح",1,0],["ولما طمت في الحرب للموت أبحر","غدت خيلها منها تخوض عبابها",57,"ب",3,0],["ولما طرقتُ الحيَّ أسأل عنهُمُ","أجابتْ نساءُ الحيّ إنه في القصر",58,"ر",1,0],["وَلَمّا طَعنْتُمْ نازِحِينَ وَضَمّكُم","مقام به ِ الجَلْدُ الْعَزِيزُ ذَلِيلُ",59,"ل",1,1],["وَلَم أُطِلها لِأَنّي جدّ مُعترفٌ","بِأَنّ كُلَّ مطيلٍ فيكَ مُختَصرُ",60,"ر",1,0],["ولما طمى لج المنى بين أضلعي","تعسفت لجاً من دجا الليل طاميا",61,"ي",2,0],["ولم أطقِ الشراب على الشرابِ","وأنى لي بذا والقلب أمسى",62,"س",2,0],["ولما طغى ماءُ الصبَابة أصبحت","نواظرهُ تهمي على وجناته",63,"ت",2,0],["ولما طَوَى الليلُ ثوبَ النَّهارِ","وجَرَّت جياجيه أردانَها",64,"ن",3,0],["وَلَم أَطوِ عَنها الخَطوَ هَجراً لَها إِذاً","فَلا لَثَمَت نَعلي مَساكِنَها الخَضرا",65,"ر",2,0],["ولم أطلبِ الإِيضاعَ فيهِ وإنّما","مَشَتْ به رجلي حيث لا حيَّ راجلُه",66,"ل",2,0],["ولَم أُطِقِ الوَدَاعَ, ولا بَدَت لِي","طَريقٌ أَستَهِلُّ بها الوَدَاعا",67,"ع",2,0],["ولما طلبنا الجواب مرارا","أجبت أخيرا بما لا يرادْ",68,"د",1,0],["ولما طلبت الإذن من شبل حيدر","فديت له في جملة السر أشبالا",69,"ل",2,0],["ولم أطلب زمانا كي أعيش","فعيش دونها مثل المماتِ",70,"ت",1,0],["وَلَمْ أَطْلُب الفُسْحانَ مِنْكَ تَمَلُّلاً","وَهَلْ يَمْلَلُ الخِدْنَ الأَدِيبَ أَدِيبُ",71,"ب",1,0],["ولم أطمع فهذا ما كفاني","وفاض الشكرُ مني وامتناني",72,"ن",2,0],["وَلَمَّا طَوَت مِن رَيِّقِ العُمرِ ما طَوَت","أَثارَت أَضاليلُ الحَياةِ ارتِيابَها",73,"ب",3,0],["ولم أطرب لتصفيق ومدح","لعجزي عن مديحك بالجديد",74,"د",1,0],["ولم أطع نشوتي .. صلّيتُ نافلتي","ولم أُضع دون غاياتي تفاصيلي",75,"ل",2,0]]}