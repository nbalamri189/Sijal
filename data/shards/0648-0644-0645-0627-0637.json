{"poems":[[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[53,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[63,"أبت إبلي والليل وحف الغدائر","https://www.aldiwan.net/poem46167.html","الطويل"],[86,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[91,"رأيت غلاما مليح الرواء","https://www.aldiwan.net/poem8783.html","عموديه"],[92,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[45,"أنبيك عن عيني وطول سهادها","https://www.aldiwan.net/poem63499.html","الطويل"],[61,"ملامك في الهوى أذكى غليلي","https://www.aldiwan.net/poem51484.html","الوافر"],[66,"حتام أمنحك المودة والوفا","https://www.aldiwan.net/poem38754.html","الكامل"],[74,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[75,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[48,"لم أشرك الناس يوم العيد في الفرح","https://www.aldiwan.net/poem62529.html","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[141,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[183,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[183,"بكم آل وحي الله يفتخر المجد","https://www.aldiwan.net/poem14508.html","الطويل"],[202,"رحلت وما شوقي عن الإلف راحل","https://www.aldiwan.net/poem53189.html","الطويل"],[221,"أطبق جناحيك معقودا لك الظفر","https://www.aldiwan.net/poem39690.html","البسيط"],[221,"أطلت من الشباك والليل نير","https://www.aldiwan.net/poem39705.html","الطويل"],[227,"إذا لم أصدق ظن كل مؤمل","https://www.aldiwan.net/poem50857.html","الطويل"],[254,"ولم أطرب إلى عذراء رود","https://www.aldiwan.net/poem48377.html","الوافر"],[268,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[374,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[388,"متى متى ياسا كنين سمعون","https://www.aldiwan.net/poem54484.html","عموديه"],[403,"ولما طواك البين واجتاحك الردى","https://www.aldiwan.net/poem50151.html","الطويل"],[436,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[441,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[456,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[461,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[462,"لقد وافيت بابك مستغيثاً","https://www.aldiwan.net/poem3568.html","عموديه"],[513,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[549,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[549,"رأينا بوادي الرمث ظبي صريمة","https://www.aldiwan.net/poem47874.html","الطويل"]],"verses":[["وَلَمّا طَغَت عَيلانُ في عِشقِ غَيِّها","رَماها مِنَ الكَيدِ الوَحيِّ بِساحِرِ",0,"ر",1,0],["وَلَمّا طُوي طَيَّ البُرودِ وَأَقبَلوا","يُهادونَهُ بَينَ الطُلى وَالمَناكِبِ",1,"ب",1,0],["وَلَمّا طَغى بادٍ وَأَضرَمَ نارَهُ","عَلى الغَدرِ إِنَّ الغادِرينَ ذِئابُ",2,"ب",1,0],["ولما طَوَتْ عنّي خُزَيْمةُ كَشْحها","ولم تَرْعَ في حَيَّيْ قُرَيْشٍ أواصِري",3,"ر",2,0],["وَلَمّا طَوى بَطحاءَ مَكَّةَ هَزَّهُ","إِلى البَيتِ شَوقُ المُستَهامِ فَيَمَّما",4,"م",2,0],["وَلَمّا طَغى عِلجُ العِراقِ اِبنُ رائِقٍ","شَفى مِنهُ لاطاغٍ وَلا مُتَكاثِرُ",5,"ر",1,0],["ولم أطرق الحيّ الخصيب زمانه","يقابلني زهرٌ لديه ومزهر",6,"ر",1,0],["وَلَمّا طَلَبَتُ الجَوابَ تَنحنَح","وَقالَ الحِلاقَةُ أَصلُ الشُرور",7,"ر",1,0],["ولمَّا طَغَتْ عَصَفاتُ القُنُوط","فمادتْ بكلِّ مَكِينٍ عَتيدْ",8,"د",1,0],["وَلَمّا طَغَت في دارِها الرومُ وَاِعتَدَت","سَفاهاً رَماها جَعفَرٌ بِحَصادِها",9,"د",3,0],["ولمَّا طابَ أصلاً طابَ فَرعاً","وطِيبُ الفَرعِ من طِيبِ الأصولِ",10,"ل",1,0],["وَلِمَ اِطَّلَعتَ عَلى جِبالِ مَوَدَّتي","فَجَعَلتَها بِالهَجرِ قاعاً صَفصَفا",11,"ف",2,0],["وَلَم أَطرُقِ الحَسناءَ تَهتَزُّ خوطَةً","وَتَسحَبُ مِن فَضلِ الضَفيرَةِ أَرقَما",12,"م",2,0],["ولمّا طَغَوا في الأرض أعصُرَ فتنةٍ","وكان دبيبَ الكفر في الدولة الخَلع",13,"ع",1,0],["وَلَم أُطاوِع فَماً فيهِ عَلى ضَحِكٍ","وَلا مَدَدتُ يَدي فيهِ إِلى قَدَحِ",14,"ح",1,0],["ولمّا طَما بحْرُ البيانِ بفِكْرتِي","وأَغْرقَ قَرْنَ الشَّمْسِ بعْضُ جداوِلي",15,"ل",2,0],["ولمّا طبَّقَ الأرَجُ الثنايا","وفُتِّح مِنْ جِنانِ الخُلدِ باب",16,"ب",1,0],["وَلَمّا طَغى نَصرٌ أَطَحتَ لَهُ الرَدى","فَلَم يَحمِهِ الجَمعُ الصَريحُ وَلا الحَشدُ",17,"د",1,0],["ولما طَمَى بحرُ الغرامِ بقلبه","طَفا زَبَدٌ في فَرْقِه من عُبابه",18,"ب",2,0],["ولما طغى شيطانُها وتأكدتْ","بذاك عليها حُجَّةٌ ما لها رَد",19,"د",1,0],["ولم أطوِ سرّي عنكمُ لاتِّهامكم","ولكن لإفشاء الحديث غوائلُ",20,"ل",1,0],["وَلَم أَطَأ قَلبَهُ إِلّا عَلى زَهَرٍ","وِسادَتي وَفِراشي قَلبُهُ العَطِرُ",21,"ر",1,0],["وَلَمّا طَوى اللَيلُ النَجِيُّ وشاحَهُ","وَجاءَ سَفيرٌ لِلصَّباحِ يُشَيِّعُ",22,"ع",1,0],["ولم أُطِع المعروفَ والبِرَّ والعُلا","وأَعْصِ ذواتِ الحُسنِ والأَعُينِ النُّجْل",23,"ل",1,0],["ولم أطرب إلى عذراء رودٍ","بها عن وصل عاشقها نفارُ",24,"ر",1,1],["ولمّا طالَ بي أَرَقي وهمِّي","نَهضتُ كموثَقٍ يَبغي الفرارا",25,"ر",2,0],["ولما طغى إبليس وهو مُخيَّرٌ","نفاه إلهُ المُلكِ عن مُلكه المَكفي",26,"ف",2,0],["ولم أطق وصف الذي عرفته","من شانهم أيضا وما خبرته",27,"ه",1,0],["وَلَمّا طَواكَ البين واجتاحَكَ الرَدى","بَكَيناكَ ما لَم نَبكِ قَطُّ عَلى قِطِّ",28,"ط",1,1],["ولم أَطْوِ سِنَّ الاكْتِهَالِ مُحاكِماً","إليك خُطُوباً شَيَّبَتْ مَفْرِقَ الطفلِ",29,"ل",1,0],["ولما طالت البلوى","تنادى القوم للشيم",30,"م",1,0],["ولما طال منبِتها وطالت","تفرَّع من رَواسيها رباها",31,"ا",3,0],["ولما طمعنا غمض جفن ليلة","ولما أسغنا لقمة في عافيه",32,"ي",2,0],["ولم أطمع بربعك في نعيمٍ","وقد شقيتْ بساحته الضيوف",33,"ف",1,0],["ولما طرا كسر العمود جبرتهم","فيا طيب شهد بعد مطعم صاب",34,"ب",1,0],["ولمّا طلعتَ ولم يشعروا","فأيقَظَهمْ من كرى الغافلِ",35,"ل",1,0],["وَلمّا طلبنا الوصلَ لم يكُ وصْلهُ","لطالبهِ إلّا السُّها والفراقدُ",36,"د",1,0]]}