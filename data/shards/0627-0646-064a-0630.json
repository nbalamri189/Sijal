{"poems":[[53,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[73,"إني ذكرتك بازهراء مشتاقا","https://www.aldiwan.net/poem11858.html","البسيط"],[10,"يا عين بكي على صخر لأشجان","https://www.aldiwan.net/poem20943.html","عموديه"],[93,"حبا دعاة البر بالإنسان","https://www.aldiwan.net/poem11239.html","الكامل"],[93,"أمر الأمير لما أحب دعاني","https://www.aldiwan.net/poem11259.html","الكامل"],[97,"هل أنت سامعة أنيني","https://www.aldiwan.net/poem24746.html","مجزوء الكامل"],[105,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[105,"أقبل رفاعة لا معرج لامرئ","https://www.aldiwan.net/poem44003.html","الكامل"],[46,"يا أم دفر لو رحلت عن الورى","https://www.aldiwan.net/poem22764.html","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202537","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141995","الكامل"],[106,"أبو الشعراء!","https://www.poetsgate.com/ViewPoem.aspx?id=179680",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[73,"إنّي ذكرْتُكِ، بالزّهراء، مشتاقا،","https://www.poetsgate.com/ViewPoem.aspx?id=814",""],[115,"ان يذكر الحسب الكريم مسلسلا","https://www.aldiwan.net/poem41209.html","عموديه"],[117,"عسل","https://www.aldiwan.net/poem24056.html","الكامل"],[270,"إني ذكرتك في العباب المزبد","https://www.aldiwan.net/poem35210.html","الكامل"],[270,"من غصن قلبك زهر الحب ينتثر","https://www.aldiwan.net/poem35472.html","البسيط"],[270,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[437,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[437,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"]],"verses":[["إِنّي ذَكَرتُكَ خالِياً فَكَأَنَّما","أَخَذَت عَلَيَّ الأَرضُ بِالأَطرارِ",0,"ر",1,0],["إِنّي ذَكَرتُكِ بِازَهراءَ مُشتاقاً","وَالأُفقُ طَلقٌ وَمَرأى الأَرضِ قَد راقا",1,"ق",2,1],["انّي ذكرتُ ندى صخرٍ فهيّجني","ذكرُ الحبيبِ على سقمٍ واحزانِ",2,"ن",1,0],["إنْ يُذْكَرِ الْفَضَلُ العَظِيمُ فَحَسْبُكُمْ","جَمْعُ الْقُوَى وَإزَالَةُ الشَّنَانِ",3,"ن",1,0],["إِنْ يَذْكُرِ الخُلُقُ العَظِيمُ فَرَمْزُهُ","عُمَرٌ وَهَلْ فِي عَصْرِنَا عُمَرَانِ",4,"ن",1,0],["إني ذكرتك باكياً","والأفق مُغبر الجبينِ",5,"ن",1,0],["إن يذكروا هِمَمَ الرّجالِ فَحسبُهم","هِمَمٌ بِمصرَ أبِيَّةٌ وَرِجالُ",6,"ل",1,0],["إن يذكروا فَضْلَ الرجالِ وأيُّهم","أرْبَى فأنتَ السابقُ المتقدّمُ",7,"م",1,0],["إِنّي ذَمَمتُكِ فَاِشهُري أَو أَشرِعي","لا أَرهَبُ المَعمودَ وَالمَركوزا",8,"ز",2,0],["إن يذكر الروم إليهم ينسب","وهو من الفرس وفي الروم سبي",9,"ي",1,0],["إني ذكرتُكَ والظلامُ مخَيِّمٌ","وبراعمُ الاقلامِ لم تِتِفَتَّقِ",10,"ق",1,1],["إن يذرفِ الشعراءُ الدمعَ فيك دمًا","ملء العيون، فما يَبكون غيرَ أب",11,"ب",1,0],["إن يذكرِ العَرَبَ ارتاعَتْ قياصِرهُ","وبات يخفقُ من رُعْبٍ أكاسره",12,"ر",2,0],["إنّي ذكرْتُكِ، بالزّهراء، مشتاقا،","والأفقُ طلقٌ ومرْأى الأرض قد راقَا",13,"ق",2,1],["ان يذكر الحسب الكريم مسلسلا","اعمامهم اخوالهم وكذا الحسب",14,"ب",1,1],["إنّي ذَبَحْتُ الصَّبْرَ فِيكِ وطالما","حُبٌّ، تَفَجَّرَ عندما فَقَدَ الأمَلْ",15,"ل",1,0],["إني ذكرتُك في العبابِ المُزبدِ","فضحكتُ من هولِ الرّدى المتهدِّدِ",16,"د",1,1],["إني ذكرتكِ تحتَ الزّهرِ ساطعةً","كأنها عقدُكِ الدريِّ ينتثر",17,"ر",1,0],["إن يُذكر الزعماءُ في أمم بهم","سادت فأنتَ لهم زعيمٌ أكبر",18,"ر",1,0],["أنى ذكرتكم فصبر غائر","عنكم وقلب في هواكم منجد",19,"د",1,0],["أنّى ذكرتكم فالشوق من وله","جمر الفضا بفنا الأوطان أوطاني",20,"ي",1,0]]}