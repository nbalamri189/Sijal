tabudhabi.ae/diwan/poem/75782","الرمل"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146948","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109104","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60837","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137279",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202041","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204581","البسيط"],[2995,"","https://poetry.dctabudhabi.ae/diwan/poem/198812","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132747","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132606","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139895","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62948","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108384",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108355",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91683","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91664","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91120","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216814","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44912","الخفيف"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105524","الرمل"],[4529,"","https://poetry.dctabudhabi.ae/diwan/poem/105373","الرجز"],[4782,"في سلة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=206196",""],[4852,"دعاء رخا","https://www.poetsgate.com/ViewPoem.aspx?id=215900",""],[5185,"عبّاد الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=72892",""],[5189,"إن لم تصلِّ","https://www.poetsgate.com/ViewPoem.aspx?id=212830",""],[5431,"موفق...","https://www.poetsgate.com/ViewPoem.aspx?id=195198",""],[5691,"سجال(6)","https://www.poetsgate.com/ViewPoem.aspx?id=206585",""],[5956,"إني ذكرتُكِ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182408",""],[5956,"إنْ تَرجعِ الشامَ يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183700",""],[5956,"الحمد لله أعطانا أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=192130",""],[5956,"إنْ ترجِعِ الشامَ يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=196801",""],[6152,"إني ذكرتك في الأفلاج","https://www.poetsgate.com/ViewPoem.aspx?id=203184",""],[6278,"أمّاه يا فرح العيون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86863&r=&rc=16",""]],"verses":[["إِنّي ذَكَرتُكَ خالِياً فَكَأَنَّما","أَخَذَت عَلَيَّ الأَرضُ بِالأَطرارِ",0,"ر",1,0],["إِنّي ذَكَرتُكِ بِازَهراءَ مُشتاقاً","وَالأُفقُ طَلقٌ وَمَرأى الأَرضِ قَد راقا",1,"ق",2,1],["انّي ذكرتُ ندى صخرٍ فهيّجني","ذكرُ الحبيبِ على سقمٍ واحزانِ",2,"ن",1,0],["إنْ يُذْكَرِ الْفَضَلُ العَظِيمُ فَحَسْبُكُمْ","جَمْعُ الْقُوَى وَإزَالَةُ الشَّنَانِ",3,"ن",1,0],["إِنْ يَذْكُرِ الخُلُقُ العَظِيمُ فَرَمْزُهُ","عُمَرٌ وَهَلْ فِي عَصْرِنَا عُمَرَانِ",4,"ن",1,0],["إني ذكرتك باكياً","والأفق مُغبر الجبينِ",5,"ن",1,0],["إن يذكروا هِمَمَ الرّجالِ فَحسبُهم","هِمَمٌ بِمصرَ أبِيَّةٌ وَرِجالُ",6,"ل",1,0],["إن يذكروا فَضْلَ الرجالِ وأيُّهم","أرْبَى فأنتَ السابقُ المتقدّمُ",7,"م",1,0],["إِنّي ذَمَمتُكِ فَاِشهُري أَو أَشرِعي","لا أَرهَبُ المَعمودَ وَالمَركوزا",8,"ز",2,0],["إن يذكر الروم إليهم ينسب","وهو من الفرس وفي الروم سبي",9,"ي",1,0],["إني ذكرتُكَ والظلامُ مخَيِّمٌ","وبراعمُ الاقلامِ لم تِتِفَتَّقِ",10,"ق",1,1],["إن يذرفِ الشعراءُ الدمعَ فيك دمًا","ملء العيون، فما يَبكون غيرَ أب",11,"ب",1,0],["إن يذكرِ العَرَبَ ارتاعَتْ قياصِرهُ","وبات يخفقُ من رُعْبٍ أكاسره",12,"ر",2,0],["إنّي ذكرْتُكِ، بالزّهراء، مشتاقا،","والأفقُ طلقٌ ومرْأى الأرض قد راقَا",13,"ق",2,1],["ان يذكر الحسب الكريم مسلسلا","اعمامهم اخوالهم وكذا الحسب",14,"ب",1,1],["إنّي ذَبَحْتُ الصَّبْرَ فِيكِ وطالما","حُبٌّ، تَفَجَّرَ عندما فَقَدَ الأمَلْ",15,"ل",1,0],["إني ذكرتُك في العبابِ المُزبدِ","فضحكتُ من هولِ الرّدى المتهدِّدِ",16,"د",1,1],["إني ذكرتكِ تحتَ الزّهرِ ساطعةً","كأنها عقدُكِ الدريِّ ينتثر",17,"ر",1,0],["إن يُذكر الزعماءُ في أمم بهم","سادت فأنتَ لهم زعيمٌ أكبر",18,"ر",1,0],["أنى ذكرتكم فصبر غائر","عنكم وقلب في هواكم منجد",19,"د",1,0],["أنّى ذكرتكم فالشوق من وله","جمر الفضا بفنا الأوطان أوطاني",20,"ن",2,0],["إِنّي ذُؤابَةُ مَذحَجٍ وَسَنامُها","وَأَنا الكَريمُ ذُرى القَديمَةِ كُرِّرا",21,"ر",2,0],["إن يذكرا ذاك العناد تنَدَّمَا","واستغفرا الأعمام والأخوالا",22,"ل",2,0],["إن يذكروا النفي والتغريب تكرمة","فكم أثيبوا على نفيٍ وتغريب",23,"ب",1,0],["إن يذكروا طاعاتنا نذكر لهم","درساً تلقَّتْه البلاد جليلا",24,"ل",2,0],["إِن يذع رند وآس فاِسقني","بينَ بانِ المنحنى ثم الحمى",25,"م",2,1],["إني ذكرتك والغرام مواصل","نفساً عليك يهيجه التذكار",26,"ر",1,0],["إن يذكر التاريخ تقويضه","أيامَ كان الجور ميزانه",27,"ن",2,0],["أن يذكرونا كذكرانا لهم فلقد","حَلوا القلوبَ وسَارتْ حيثُ مَا ساروا",28,"ر",3,0],["ان يذكر الطائي باندية الكرم","وحديثه المأثور عنه في القدم",29,"م",1,1],["أنّى ذهبتُ يصادمْ مأملي نحسي","وإن غرستُ جنيت الشوك من غرسي",30,"ي",1,1],["أني ذهبت أجد مأوى أقيم به","فلا أهم بأمر الدار والسكن",31,"ن",1,0],["أنَّى ذهبت فأحلام مطرزة","وإن نظرت يحار الفكر والنظر",32,"ر",1,0],["ان يذم اليوم قوم غرسنا","فلنا من بعد حمد المجتني",33,"ن",2,0],["ان يذخر الوفر قوم لاخلاق لهم","فالحمد خير نفيس أنت ذاخره",34,"ر",2,0],["إن يذكر السلوان قال خطيبه","عند المحبّة يوم يسلو آبق",35,"ق",1,0],["انْ يذكر الجهدَ وما ناله","فيشكرُ الطولَ الذي طالَهْ",36,"ل",2,0],["اني ذكرت له اذا جن الدجى","بدر السداد بجنح ليل اقتم",37,"م",1,0],["اني ذكرتك في الاصيل وفي الضحى","ولقد تضوع مندل وبشام",38,"م",1,0],["إِني ذكرتُكَ وَالظَلامُ معبّسٌ","وَالغَيم بَين تجمِّعٍ وَتفرّدِ",39,"د",1,1],["إِني ذكرتُكمُ وَقَد بعُدَ اللقا","ما بَينَنا وَتَغلّقت أَبوابُهُ",40,"ب",2,1],["إِني ذكرتُكَ والزَمان معبِّس","وَالخطب يدهم وَالكروب تعربد",41,"د",1,1],["ان يذكروك فما جاءتك ذكرتهم","في الغابرين ولا سرتك في الرمم",42,"م",1,0],["أن يُذِيعَ فِي قَومِهِ مِنكَ فَضلاً","مَا مَضَت فَترَةٌ مِنَ الرُّسلِ إلاَّ",43,"ل",2,0],["أَن يذل الزَمان في كبريائه","وَيَميتُ الغُرور مِن أَحيائهْ",44,"ه",1,0],["إن يذق صهباءها ميت الصبا","جعلت فيه حياة الأنفس",45,"س",1,0],["أن يذهب المجد الأثيل ذاهباً","ففي الجواد بعده يسلو العلى",46,"ا",1,0],["إن يذبل الحلم يحيا في ملامحنا","دهرًا ، ويسفر عند الصبح معتنَقا",47,"ق",2,0],["إن يذكروا (عبقرا) .. إنّي مليكتُهُ","أو يذكروا (سبأً) .. مُلكي الذي كانا",48,"ن",2,0],["أنّى ذهبت يجيء بالخبر الذي","يحيي النهار وفي المساء يعاد",49,"د",1,0],["إنّي ذكرتُ محمدّا هل يا تُرى","عَطّرتَ قولكَ عفةً وحَلالا",50,"ل",2,0],["إني ذُبحتُ على خطاه بقبلة","وردية فيها الخلود المطلق",51,"ق",1,0],["أنّى ذهبتُ فأنت في صدري معي","كيما أظلّ مدى الزمانِ أراكِ",52,"ك",1,0],["إني ذكرتك حين أحسو قهوة","متصفحاً تذكارنا إنجيلا",53,"ل",2,0],["أنَّى ذهبتُ أرى دمعي جرَى هَطِلا","أنَّى مشيتُ أرى دمعي جرى بَخِلا",54,"ل",2,0],["أنَّى ذهبنا نرى نسلاً يؤازرنا","نرى بناتٍ وأصهاراً تُفَدِّينا",55,"ن",2,0],["أنى ذهبتُ أرى دمعي جرى هطِلا","أنى أسير أرى دمعى جرى بَخِلا",56,"ل",2,0],["إني ذكرتكِ في الأفلاج مشتاقا","والشوق حلق كالأطيار خفاقا",57,"ق",2,1],["إنّي ذكرتكِ يا حبيبة فاسألي","سرب الحمائم حين طاف مع الهوى",58,"ا",1,0]]}