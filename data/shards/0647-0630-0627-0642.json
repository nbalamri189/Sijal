{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[88,"قالوا صدقت فكان الصدق ما قالوا","https://www.aldiwan.net/poem68960.html","البسيط"],[73,"حاشا لعبد الرحيم سيدنا الفاضل","https://www.aldiwan.net/poem3821.html","المنسرح"],[90,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[94,"البؤس لابن الشعب يأكل قلبه","https://www.aldiwan.net/poem38966.html","الكامل"],[87,"الناس للدنيا تبع","https://www.aldiwan.net/poem63761.html","مجزوء الكامل"],[99,"فجر أطل علي بالإشراقِ","https://www.aldiwan.net/poem24597.html","الكامل"],[71,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[50,"هذا قناع الليل محسور","https://www.aldiwan.net/poem63258.html","السريع"],[48,"روح ذبيحك لا تعجله ميتته","https://www.aldiwan.net/poem22242.html","البسيط"],[48,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54707","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54644","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54605","الكامل"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[215,"بيني وبين غد عهد سأذكره","https://www.aldiwan.net/poem46780.html","البسيط"],[274,"هذا قران سعيد أكسب الدارا","https://www.aldiwan.net/poem35264.html","البسيط"],[279,"وخافت الحس ما له جسد","https://www.aldiwan.net/poem25573.html","المنسرح"],[307,"قد فاق غصن النقا حبيبي","https://www.aldiwan.net/poem58082.html","مخلع البسيط"],[346,"يا نفس ما لك تنشرين","https://www.aldiwan.net/poem55350.html","مجزوء الكامل"],[381,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[420,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[447,"نوابنا نوائب كلهم","https://www.aldiwan.net/poem55947.html","عموديه"],[456,"لا ترقبوا مني الدموع رخيصة","https://www.aldiwan.net/poem61319.html","الكامل"],[482,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[485,"يا واردا من ليلى قف متصاغيا","https://www.aldiwan.net/poem24336.html","عموديه"],[543,"هيهات أوتي في سراتهم","https://www.aldiwan.net/poem56647.html","البسيط"],[565,"هذا قران حسين قد كتبت له","https://www.aldiwan.net/poem52644.html","البسيط"],[565,"أرثي ويا ليت شعري من سيرثيني","https://www.aldiwan.net/poem52888.html","البسيط"],[729,"","https://poetry.dctabudhabi.ae/diwan/poem/84972","الرجز"]],"verses":[["هَذَا قِيَاسٌ لَيْسَ يُدْفَعُ حُكْمُهُ","مِنْ بَعْدِ مَا شَهِدَ الْكِتَابُ الْمُنْزَلُ",0,"ل",1,0],["هَذا قَريضي وَهَذا قَدرُ مُمتَدَحي","هَل بَعدَ هَذَينِ إِحكامٌ وَإِجلالُ",1,"ل",1,0],["هَذا قِياسٌ في غَيرِ سَيِّدِنا","يَصِحُّ إِن كانَ يَحبَلُ الرَجُلُ",2,"ل",1,0],["هذا قضى بيد اللئام مضرّجاً","بدم وذاك بأنصل الكفّار",3,"ر",1,0],["هذا قليلٌ من حياةٍ مُرّة","في دولة الأنْصابِ والألقابِ",4,"ب",1,0],["هَذا قَضاءُ اللَهِ مُم","تَثَلُ الحُكومَةِ مُتَّبَع",5,"ع",1,0],["هذا قليل قد شرحت دفينه","وعلى ذكائك أنت فهم الباقي",6,"ق",2,0],["هذا قريضٌ عنِ الأفلاكِ محتجبٌ","كأنهُ الروضُ أبدى منظراً عجبا",7,"ب",2,0],["هَذا قِناعُ اللَيلِ مَحسورُ","فَاِشرَب فَقَد لاحَ التَباشيرُ",8,"ر",1,1],["هَذا قَبيحٌ وَعِلمِيَ غَيرُ مُتَّسِقٍ","بِما يَكونُ وَلَكِن في الثَرى أَلِجُ",9,"ج",1,0],["هذا قَريضٌ عن الأملاكِ محْتَجِبٌ","فلا تُذِلْهُ بإكْثارٍ على السّوقِ",10,"ق",1,0],["هَذَا قَضَى وَطَرَ الْحَيَاةِ وتِلْكَ لَمْ","تَبْلُغْ شَبِيبَةَ عُمْرِهَا الْمُعْتَادِ",11,"د",1,0],["هَذَا قرَانٌ قَدْ تَجَلَّتْ","لِلْعنَايَةِ فيهِ يَدْ",12,"د",1,0],["هَذَا قَرَارٌ لِلْبِلَى صَامِتٌ","صُمٌّ بِهِ السَّمْعُ وَعْنَ الخَطيبْ",13,"ب",1,0],["هَذَا قِرَانٌ قَدْ شَهِدْتُ جَلاَلَهُ","فَرَأَيْتُ فِيهِ مَفَاخِرَ الأَحْسَابِ",14,"ب",1,0],["هذا قصيدي إلى بغداد أرسله","من نور قلبي ومن نيران أحشائي",15,"ي",1,0],["هذا قصيدٌ سترويه وتحفظه","من الخلائق أجيالٌ وأجيال",16,"ل",1,0],["هذا قِرانٌ سعيدٌ أكسَبَ الدارا","من جنَّةِ الخلدِ أطياباً وأنوارا",17,"ر",2,1],["هَذَا قَتيلُ الهَوَى فلا ديةٌ","تُؤْخَذُ في قتلِه وَلا قَوَدُ",18,"د",1,0],["هذا قوامٌ بلا محيا","وذا محيا بلا قوام",19,"م",1,0],["هذا قضا","الدهر الخؤون",20,"ن",1,0],["هذا قضاء الله فاصبر طائعاً","إن المطيع له السلام ثواب",21,"ب",1,0],["هذا قضاء الله جلَّ جلاله","لا والدٌ يبقى ولا مولود",22,"د",1,0],["هذا قضاء مبرم عادل","به عليهم نائبوهم قضوا",23,"ض",3,0],["هذا قريضي ثورة لمواطني","في بؤسها وهداية المجموع",24,"ع",1,0],["هذا قليلي والعطاء سيان في","هذا السبيل قليله وكثير",25,"ر",1,0],["هذا قد بدل شربه لبلغة","باهت مساجد بلوان فصراح",26,"ح",1,0],["هَذا قَرينُكَ لَم يَمدَحكَ مِن فَزَعٍ","وَلَم يخُنكَ وَقِدماً كانَ خَوّانا",27,"ن",2,0],["هذا قِرانُ حُسينٍ قد كتبتُ لهَ","تاريخَ عامِ قِرانِ الشَّمسِ والقَمرِ",28,"ر",1,1],["هذا قَضاءُ الذي في عَرشِ قُدْرَتِهِ","يُصرِّفُ الأمرَ بينَ الكافِ والنونِ",29,"ن",1,0],["هذا قتالي فاشهدوا يا من حضر","وكل هذا في رضا رب البشر",30,"ر",1,0]]}