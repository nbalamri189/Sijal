poetry.dctabudhabi.ae/diwan/poem/216814","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75684","البسيط"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107297","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119665","البسيط"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145345","المجتث"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117253","الكامل"],[4715,"وصية أمي","https://www.poetsgate.com/ViewPoem.aspx?id=204453",""],[4723,"شهقة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=61980",""],[4767,"جمرة الآلام","https://www.poetsgate.com/ViewPoem.aspx?id=204789",""],[4778,"الحياة محبة","https://www.poetsgate.com/ViewPoem.aspx?id=190355",""],[4791,"هذا قصيدي فيك","https://www.poetsgate.com/ViewPoem.aspx?id=37110",""],[4858,"في ظل الحضارة الزائفة","https://www.poetsgate.com/ViewPoem.aspx?id=33863",""],[4858,"أوَ بعدَ دارِكَ في الدّنا من دارِ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138208",""],[4942,"يا طفلتي","https://www.poetsgate.com/ViewPoem.aspx?id=188682",""],[4980,"أضحى مبارك!","https://www.poetsgate.com/ViewPoem.aspx?id=191114",""],[5092,"همسة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=177000",""],[5111,"مَرَاكِبُ العشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212250",""],[5121,"هذا القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=37453",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5273,"في الفخر","https://www.poetsgate.com/ViewPoem.aspx?id=215879",""],[5277,"البشير","https://www.poetsgate.com/ViewPoem.aspx?id=185161",""],[5281,"أخي؛ إلى اللقاء!","https://www.poetsgate.com/ViewPoem.aspx?id=200106",""],[5295,"خمر السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=210633",""],[307,"كوفيدُ رفقاً ما لسيفك ينْحرُ","https://www.poetsgate.com/ViewPoem.aspx?id=213996",""],[5324,"في يوم مولده الزكى.","https://www.poetsgate.com/ViewPoem.aspx?id=211137",""],[5324,"إلى من فارقت في وطني.","https://www.poetsgate.com/ViewPoem.aspx?id=211391",""],[5355,"أسَف","https://www.poetsgate.com/ViewPoem.aspx?id=188321",""],[5363,"كحِّل عيونك إن البدر مكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=144466",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5408,"أوجاع يوسفية","https://www.poetsgate.com/ViewPoem.aspx?id=190737",""],[5463,"ألف ونّه وسط قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=25292",""],[5542,"مالي أراك تقلبُ النظرا","https://www.poetsgate.com/ViewPoem.aspx?id=9683",""],[5542,"القدوم الى المدينة المنورة","https://www.poetsgate.com/ViewPoem.aspx?id=10028",""],[5574,"أزكى الحبّ أثمله","https://www.poetsgate.com/ViewPoem.aspx?id=206027",""],[482,"خلا مِنَ القومِ مصطاف ومرتبعُ","https://www.poetsgate.com/ViewPoem.aspx?id=111303",""],[5616,"سيف على لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=205036",""],[5695,"حرقة الفقد..","https://www.poetsgate.com/ViewPoem.aspx?id=212537",""],[5704,"كمْ سالَ دمعي ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204226",""],[5720,"قراري ..","https://www.poetsgate.com/ViewPoem.aspx?id=198925",""],[5720,"البَصْمَة","https://www.poetsgate.com/ViewPoem.aspx?id=200696",""],[402,"فهمت معنى العمر فهم الأريب","https://www.poetsgate.com/ViewPoem.aspx?id=35443",""],[5829,"صرخة المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=152733",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""],[5943,"إنْ غابَ نجمي","https://www.poetsgate.com/ViewPoem.aspx?id=11265",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[6093,"خَالِد","https://www.poetsgate.com/ViewPoem.aspx?id=198602",""],[6097,"قل للشّهيدة في النّقاب الأسودِ","https://www.poetsgate.com/ViewPoem.aspx?id=190678",""],[6124,"لا تسأليني","https://www.poetsgate.com/ViewPoem.aspx?id=122216",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""]],"verses":[["هَذَا قِيَاسٌ لَيْسَ يُدْفَعُ حُكْمُهُ","مِنْ بَعْدِ مَا شَهِدَ الْكِتَابُ الْمُنْزَلُ",0,"ل",1,0],["هَذا قَريضي وَهَذا قَدرُ مُمتَدَحي","هَل بَعدَ هَذَينِ إِحكامٌ وَإِجلالُ",1,"ل",1,0],["هَذا قِياسٌ في غَيرِ سَيِّدِنا","يَصِحُّ إِن كانَ يَحبَلُ الرَجُلُ",2,"ل",1,0],["هذا قضى بيد اللئام مضرّجاً","بدم وذاك بأنصل الكفّار",3,"ر",1,0],["هذا قليلٌ من حياةٍ مُرّة","في دولة الأنْصابِ والألقابِ",4,"ب",1,0],["هَذا قَضاءُ اللَهِ مُم","تَثَلُ الحُكومَةِ مُتَّبَع",5,"ع",1,0],["هذا قليل قد شرحت دفينه","وعلى ذكائك أنت فهم الباقي",6,"ق",2,0],["هذا قريضٌ عنِ الأفلاكِ محتجبٌ","كأنهُ الروضُ أبدى منظراً عجبا",7,"ب",2,0],["هَذا قِناعُ اللَيلِ مَحسورُ","فَاِشرَب فَقَد لاحَ التَباشيرُ",8,"ر",1,1],["هَذا قَبيحٌ وَعِلمِيَ غَيرُ مُتَّسِقٍ","بِما يَكونُ وَلَكِن في الثَرى أَلِجُ",9,"ج",1,0],["هذا قَريضٌ عن الأملاكِ محْتَجِبٌ","فلا تُذِلْهُ بإكْثارٍ على السّوقِ",10,"ق",1,0],["هَذَا قَضَى وَطَرَ الْحَيَاةِ وتِلْكَ لَمْ","تَبْلُغْ شَبِيبَةَ عُمْرِهَا الْمُعْتَادِ",11,"د",1,0],["هَذَا قرَانٌ قَدْ تَجَلَّتْ","لِلْعنَايَةِ فيهِ يَدْ",12,"د",1,0],["هَذَا قَرَارٌ لِلْبِلَى صَامِتٌ","صُمٌّ بِهِ السَّمْعُ وَعْنَ الخَطيبْ",13,"ب",1,0],["هَذَا قِرَانٌ قَدْ شَهِدْتُ جَلاَلَهُ","فَرَأَيْتُ فِيهِ مَفَاخِرَ الأَحْسَابِ",14,"ب",1,0],["هذا قصيدي إلى بغداد أرسله","من نور قلبي ومن نيران أحشائي",15,"ي",1,0],["هذا قصيدٌ سترويه وتحفظه","من الخلائق أجيالٌ وأجيال",16,"ل",1,0],["هذا قِرانٌ سعيدٌ أكسَبَ الدارا","من جنَّةِ الخلدِ أطياباً وأنوارا",17,"ر",2,1],["هَذَا قَتيلُ الهَوَى فلا ديةٌ","تُؤْخَذُ في قتلِه وَلا قَوَدُ",18,"د",1,0],["هذا قوامٌ بلا محيا","وذا محيا بلا قوام",19,"م",1,0],["هذا قضا","الدهر الخؤون",20,"ن",1,0],["هذا قضاء الله فاصبر طائعاً","إن المطيع له السلام ثواب",21,"ب",1,0],["هذا قضاء الله جلَّ جلاله","لا والدٌ يبقى ولا مولود",22,"د",1,0],["هذا قضاء مبرم عادل","به عليهم نائبوهم قضوا",23,"ض",3,0],["هذا قريضي ثورة لمواطني","في بؤسها وهداية المجموع",24,"ع",1,0],["هذا قليلي والعطاء سيان في","هذا السبيل قليله وكثير",25,"ر",1,0],["هذا قد بدل شربه لبلغة","باهت مساجد بلوان فصراح",26,"ح",1,0],["هَذا قَرينُكَ لَم يَمدَحكَ مِن فَزَعٍ","وَلَم يخُنكَ وَقِدماً كانَ خَوّانا",27,"ن",2,0],["هذا قِرانُ حُسينٍ قد كتبتُ لهَ","تاريخَ عامِ قِرانِ الشَّمسِ والقَمرِ",28,"ر",1,1],["هذا قَضاءُ الذي في عَرشِ قُدْرَتِهِ","يُصرِّفُ الأمرَ بينَ الكافِ والنونِ",29,"ن",1,0],["هذا قضاء الله في الآنام من","قدم فليس يفيدنا أن نحذرا",30,"ر",2,0],["هذا قَميصُكَ إمّا قُدَّ من قُبُلٍ","كابن النَّبيِّ وإمّأ قُدَّ مِن دُبر",31,"ر",1,0],["هذا قرانٌ سعيدٌ قد كتبتُ لَهُ","ما سطروهُ لنا من سالفِ الأَمدِ",32,"د",1,1],["هذا قتيلُ الأشقيا","ءِ وذا قتيلُ الأدعياءِ",33,"ا",2,0],["هذا قديما دأبه","يعفو وينشر رحمته",34,"ه",1,0],["هَذا قَرار ما بِهِ رَجَونا","فَامنُن عَلَينا ثُمَ قالَ عَفَونا",35,"ن",2,0],["هَذا قَتيلكِ فَاِرحَميه فَإِنَّهُ","قَد صارَ مِن فَرط النُحول عَلى شَفا",36,"ف",2,0],["هَذَا قَضَاءُ البارِقِيّ وَإنَّني","بِالمَيلِ فِى مِيزَانِهِم لَبَصِير",37,"ر",1,0],["هذا قضاء الله أم غدر","ماذا أصابك أيها القصر",38,"ر",1,1],["هَذا قَليل مِن كَثير ما ذكر","بلعب الشطرنج فافهم وَاعتبر",39,"ر",1,0],["هذا قَوامُك أم غُصنٌ ووجهُك أم","بدرٌ ونَشرُك فى الكاساتِ أم طِيبُ",40,"ب",1,0],["هذا قران السعد والمكرمات جَلاَّ","عقد لواء في القلوب الأُباة حلاَّ",41,"ل",2,0],["هذا قريض لم تَشبهُ شوائبٌ","وافاك جزلاً صادقَ الكلماتِ",42,"ت",1,0],["هذا قتالي فاشهدوا يا من حضر","وكل هذا في رضا رب البشر",43,"ر",1,0],["هذا قضاء الواحد الصمد الذي","بقضائه بين البرية يعدل",44,"ل",1,0],["هَذَا قُصَارَى بَحثِهِ وَعُلُومِهِ","أن شَكَّ فِي الله العَظِيمِ الشَّانِ",45,"ن",1,0],["هذا قوامُك غصنُها الرطبُ الذي","في رأسه زهرُ القرنفل فتِّحا",46,"ح",2,0],["هذا قليل من عبيد موّدة","والحر يرضى بالقليل ويقنع",47,"ع",1,0],["هذا قبر قد حل به","أستاذ من أهل السنه",48,"ه",1,1],["هذا قديمك كان يزخر بالغنى","وبسدك العالي غدا سيجدد",49,"د",1,0],["هذا قَليلٌ مِن كَثير","وَالأَمرُ وَاللَهِ خَطير",50,"ر",1,0],["هَذا قُعودي بارِكاً بِالأَبطَحِ","عَلَيهِ عِكماً أَكمَرٍ لَم تُفتَحِ",51,"ح",1,1],["هذا قَلْبي صَبا إليْهِ وصَغا","لقد بلغَ الغرامُ منّي مَبْلَغا",52,"غ",2,0],["هذا قصاراك في الدنيا وأحسبها","تلهو بنا بيد هوجاء لا بفم",53,"م",1,0],["هَذا قَضى حاجة في نفسه وَكَذا","عفو وَصفح وَذا وَلّى وَقَد غنما",54,"م",2,0],["هَذا قُصارى مَبلغِ الدُنيا فكُن","يَقِظاً 