{"poems":[[55,"دعا بالوحاف السود من جانب الحمى","https://www.aldiwan.net/poem29645.html","الطويل"],[107,"يقول البرق شر مستطير","https://www.aldiwan.net/poem43067.html","الوافر"],[280,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[401,"فإما أن تمر على شُريبٍ","https://www.aldiwan.net/poem604.html",""],[556,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34409","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48534","الوافر"],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""]],"verses":[["بِأَظمى إِلى الأَحبابِ مِنّي وَفيهِمُ","غَريمٌ إِذا رُمتُ الدُيونَ لَواني",0,"ن",2,0],["بِأَظهُرِنا وَأَيدينا جَميعاً","تَحَصَّنَ مُصطَفى وَرَمى فَريدُ",1,"د",1,0],["بإِظْهارِها وَصَّى أبو حَفْصٍ الرِّضى","بَنِيهِ فَوَفَّى دُونَهُمْ مَا بهِ وَصَّى",2,"ص",2,0],["بأظفارٍ له حُجنٍ طِوالٍ","وأنيابٍ له كانت كِلالا",3,"ل",2,0],["بأظهَرَ مِنِّي هزّةً يومَ أقبلتْ","تشكّي الهوى وحْياً به لا تُصَرِّحُ",4,"ح",1,0],["بِأظرفَ مِن أَخلاقِهِ وَحَديثِهِ","وَلا سيّما لَمّا تَرَنَّمَ عودهُ",5,"د",2,0],["بأظلم منهمُ وقد استخفوا","بتدبير الأطباء الثقات",6,"ت",1,0],["بإظهاره تلبيس إبليس إذ رنا","إليه بطرف عن سنا نوره أعمى",7,"م",2,0],["بإظهار دين الله قسراً ودعوةً","إلى الله بالتقوى وبالصارم الهند",8,"د",1,0]]}