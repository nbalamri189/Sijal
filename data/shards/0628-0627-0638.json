{"poems":[[53,"دعا بالوحاف السود من جانب الحمى","https://www.aldiwan.net/poem29645.html","الطويل"],[105,"يقول البرق شر مستطير","https://www.aldiwan.net/poem43067.html","الوافر"],[275,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[396,"فإما أن تمر على شُريبٍ","https://www.aldiwan.net/poem604.html",""],[551,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"]],"verses":[["بِأَظمى إِلى الأَحبابِ مِنّي وَفيهِمُ","غَريمٌ إِذا رُمتُ الدُيونَ لَواني",0,"ي",1,0],["بِأَظهُرِنا وَأَيدينا جَميعاً","تَحَصَّنَ مُصطَفى وَرَمى فَريدُ",1,"د",1,0],["بإِظْهارِها وَصَّى أبو حَفْصٍ الرِّضى","بَنِيهِ فَوَفَّى دُونَهُمْ مَا بهِ وَصَّى",2,"ص",2,0],["بأظفارٍ له حُجنٍ طِوالٍ","وأنيابٍ له كانت كِلالا",3,"ل",2,0],["بأظهَرَ مِنِّي هزّةً يومَ أقبلتْ","تشكّي الهوى وحْياً به لا تُصَرِّحُ",4,"ح",1,0]]}