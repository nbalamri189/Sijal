لَوَقتَكَ الرَدى نُفوسٌ عَزيزا","تٌ وَأَيدٍ مَليئَةٌ بِالطِعانِ",0,"ن",1,0],["لَو قابَلَ اللَيلَ البَهي","مَ لَمَزَّقَ اللَيلَ البَهيما",1,"م",2,0],["لَوَقَفتُ بَينَكُما لِأَعكِسَ سَهِمَها","عَن نَحرِكَ البادي إِلى نَحري",2,"ر",2,0],["لَو قَدَرنا وَساعَفَتنا اللَيالي","لَوَصَلنا بِعُمرِكَ الأَعمارا",3,"ر",2,0],["لَو قَدَرنا عَلى المُنى لَفَدَينا","ذي الأَضاحي مِنَ الظُبى بِالأَعادي",4,"د",2,0],["لو قارَعَ الناسُ المَنونَ لردَّها","عنهُ السّيوفُ فَوالِقاً لِلْهامِ",5,"م",1,0],["لَوْ قَالَ فِي هَرِمٍ زُهَيْرٌ مِثْلَهَا","هَرِمَ الزَّمَانُ وَذِكْرُهُ لَمْ يَهْرَمِ",6,"م",1,0],["لَو قامَ بَعضُ رُواةِ الشِعرِ يُنشِدُهُ","يَوماً بِأَرضِ أَزالٍ أخجلَ الحِبَرا",7,"ر",2,0],["لو قلت إن بهاء طليعتها","صاف أغر كطلعة الفجر",8,"ر",1,0],["لَوْ قِيلَ لِلْحُسْنِ كيْفَ تَهْوَى","إِنْ أَنْتَ خُيِّرْتَ أَنْ تَكُونَا",9,"ن",2,1],["لَو قِيلَ يَا وَضَّاحُ قُم","فَاختَر لِنَفسِكَ أَو تَمَن",10,"ن",1,0],["لو قيل لي في الجيش مَن ذا الذي","كان بما أوقعه آمره",11,"ر",2,0],["لو قاس كلّ فتى سواه بنفسه","فيما أراد لما تعادى اثنان",12,"ن",1,0],["لَو قُلتَ أَينَ هَوادي الخَيلَ ما عَرَفوا","قالوا لِأَذنابِها هَذي هَوادِيَها",13,"ي",3,0],["لَو قَد عَلَونا سَماوِيّاً مَوارِدُهُ","مِن نَحوِ دَومَةِ خَبتٍ قَلَّ تَعريسي",14,"س",2,0],["لو قيل للجود من حليفك ما","إن كان إلا إليك ينتسبُ",15,"ب",1,1],["لو قابلت سنوننا شمسه","أو نوءها أبصرته قد نسخ",16,"خ",1,0],["لو قيل إن شموس الصحو خافية","ما قال عنها عدو أنها بخلت",17,"ت",1,0],["لو قالَ طلت السهى قال الأنام نعم","يا صادق القول والعليا فقل وطل",18,"ل",1,0],["لو قُلِّدت نحرها السعود من ال","سَبعة قلَّت لذلك النحر",19,"ر",1,0],["لو قابلتْها بنا خلائقنا","لم نكُ في حسنها لنَعشِرها",20,"ر",3,0],["لو قارع الأكفاء كلهم","عن سؤدد وقعت له القرعه",21,"ع",2,0],["لو قصدتُ المديحَ في هذه الخط","بةِ ماطلْتُكَ الجراءَ مطالا",22,"ل",2,0],["لوقفْتها نصبَ الكريهةِ موقفاً","ما كان تعذيراً ولا تحليلا",23,"ل",2,0],["لو قضى الدهرُ للمُحقِّ لأضحوا","لا يسوّي خدودهم بنعالي",24,"ل",2,0],["لو قُدِّسَ اللَّهُ ذو الجلال به","لم يرفعِ اللَّهُ طيِّب الكلِمِ",25,"م",1,0],["لو قصدَ العاشقُ في عشقه","قصدَ جزاء ما بكى دِمنهْ",26,"ن",2,0],["لَو قُلتُمُ اِختَر لِلنِيابَةِ جاهِلاً","أَو لِلخَطابَةِ باقِلاً لَتَخَيَّرا",27,"ر",2,0],["لَو قَدَروا جاؤوكُمُ بِالثَرى","مِن قُطبِهِ مُلكاً إِلى قُطبِهِ",28,"ب",2,0],["لَو قُلتَ لِلدَنِفِ الحَزينِ فَدَيتُهُ","مِمّا بِهِ لَأَغَرتَهُ بِفِدائِهِ",29,"ا",3,0],["لَو قيلَ لِلمَجدِ اِنتَسِب إِلى اِمرِئٍ","لَم تُلفِهِ إِلّا إِلَيهِ يَنتَسِب",30,"ب",1,0],["لَو قيلَ لِلأَزدِ ما قالوا وَما اِنتَحَلوا","مِن اِدِّعاءٍ إِلَيهِ قالَ ما صَدَقوا",31,"ق",3,0],["لَو قَليلٌ كَفى اِمرَأً مِن كَثيرٍ","لَاِكتَفَينا بِقَولِهِ مِن فَعالِهِ",32,"ل",2,0],["لَو قيلَ مَن حازَ السَماحَةَ وَالنَدى","يَومَ الفَخارِ لَقيلَ ذاكَ الشاهُ",33,"ا",2,0],["لو قرأنا التاريخ ما ضاعت القدس","وضاعت من قبلها \"الحمراء\"..",34,"ا",2,0],["لَو قَد دُعيتَ لَما أَجَبتَ لِما","تُدعى لَهُ فَانظُر لِما تُدعى",35,"ا",1,0],["لَو قَد ظَعَنتَ عَنِ البُيو","تِ وَرَوحِها وَسَكَنتَ لَحدَك",36,"ك",1,0],["لَو قَنِعَ الناسُ بِالكَفافِ إِذاً","لَاِتَّسَعوا في الَّذي بِهِ قَنِعوا",37,"ع",3,0],["لَو قَد تُرِكتَ صَريعاً","وَقَد بَكَتكَ العُيونُ",38,"ن",1,0],["لَو قَد دُفِنتَ غَداً وَأَقبَلَ نافِضاً","كَفَّيهِ عَنكَ مِنَ التُرابِ الدافِنُ",39,"ن",1,0],["لَو قَد دُعيتَ غَداً لَتُس","أَل ذا مُحاسَبَةً وَوَزنا",40,"ن",2,0],["لَو قيلَ لِلعَبّاسِ يا اِبنَ مُحَمَّدٍ","قُل لا وَأَنتَ مُخَلَّدٌ ما قالَها",41,"ل",3,1],["لَو قيلَ عُج نَحوَ السَماءِ مُبادِراً","وَطِئَت يَداهُ دَوابِرَ الدَبَرانِ",42,"ن",1,0],["لو قدْ وقفتِ على ضَنى جَسَدي","لوقفتِ باكيةً على رسمِ",43,"م",1,0],["لَو قيلَ لِلحُسنِ تَمَنّى المُنى","إِذَن تَمَنّى أَنَّهُ مِثلُهُ",44,"ل",2,0],["لَو قيلَ سَل تُعطَ المُنى كانَ المُنى","أَن لَو رَأى مَولاهُ كَيفَ بُكاؤُهُ",45,"ا",3,0],["لَو قُلتُ حُصِّلَ بَعضُها أَو كُلُّها","في حاتِمٍ لَدُعيتُ دافِعَ مَغرَمِ",46,"م",1,0],["لَو قَبلَ ما كانَ مَزوراً بِها","إِذاً لَسُرَّ الرَبعُ بِالرابِعِ",47,"ع",1,0],["لو قلتَ للعشاقِ موتوا لوعةً","وصبابةً بانَ المحبُّ الصادقُ",48,"ق",1,0],["لَو قيلَ يَومَ يَقومُ الناسُ مَوعِدُنا","قالوا مَساريعُ راعونا بِتَعجيلِ",49,"ل",1,0],["لَو قيلَ لِلمَجدِ فيمَن أَنتَ مُنتَسِبٌ","لَأَفصَحَ المَجدُ عَنهُم أَيَّ إِفصاحِ",50,"ح",1,0],["لو قُمْتَ يومئذٍ بالسّيفِ تأخذُه","بعثتَها غضبةً جأواءَ تستعر",51,"ر",1,0],["لو قلتُ للقومِ جيئوني بهامتِه","رأيتَهم يفعلون اليومَ ما أُمرِوا",51,"ر",3,0],["لَو قادَ مِن فَقرِهِ قَولاً يُفَقِّرُهُ","أَو لَو يُشَجِّعُهُ لَفظٌ يُسَجِّعُهُ",52,"ع",2,0],["لَو قيلَ وَالنَفسُ رَهنُ المَوتِ مِن ظَمَءِ","موسى أَو البارِدُ السَلسالُ لَم أَرِدِ",53,"د",1,0],["لو قلتُ إنّ المُرهَفاتِ البِيضَ لم","تُخْلَقْ لغَيركُمُ لقُلتُ صَوابا",54,"ب",2,0],["لَو قُستُ بِالشَمِّ بَلائي بِهِم","زادَ فَأَفنى حَسبَ حُسّابي",55,"ي",1,0],["لَو قُرِّبَت في الظَلامِ يَوماً","لَاِنجابَ عَنها دُجى الظَلامِ",56,"م",1,0],["لَو قيلَ لِلحُسنِ صِف مَحاسِنَها","ما اِسطاعَ ضَعفاً بِذاكَ يَحكيها",57,"ي",3,0],["لوقتهِ الكرّارِ","والنوكرور الكبارِ",58,"ر",1,0],["لَو قَدِرنا عَلى رُقى سِحرِ هارو","تَ طَلَبنا الوِصالَ بِالتَحبيبِ",59,"ب",1,0],["لَو قَد لَقيتُكِ خَلفَ العَينِ خالِيَةً","أَصلَحتِ مِنّي الَّذي لا يُصلِحُ الطيبُ",60,"ب",1,0],["لَو قامَ بِالحادِثِ العَظيمِ لَما","عَيَّ بِعُمرانِهِ وَلا خَرِبِه",61,"ب",2,0],["لَو قالَ بَدرُ التَمِّ إِني دِرهَمٌ","قالَت لَهُ السَفهاءُ أَنتَ مُزأَبِقُ",62,"ق",1,0],["لَو قامَ أَمواتُ العَواصِمِ وَحدَها","مَلَأوا البِلادَ حَزونَها وَسُهولَها",63,"ل",3,0],["لَو قالَ سيدُ غَضاً بُعِثتُ بِمِلَّةٍ","مِن عِندِ رَبّي قالَ بَعضُهُم نَعَم",64,"م",1,0],["لَو قيلَ لَم يَبقَ سِوى ساعَةٍ","أَمَّلتَ ما تَعجِزُ عَنهُ سَنَه",65,"ن",2,0],["لَوْ قالَ تِيهاً قِفْ على جَمْر الغَضا","لَوَقَفْتُ مُمْتَثِلاً ولم أتوَقّف",66,"ف",1,0],["لَو قدَّروا الأمر ما ثارَت عجاجتها","وَلا شكت عينهم من خوضها الرمدا",67,"د",2,0],["لو قِيلَ أبطالُ العصورِ فمنهُمو","لحُماتِكِ الإعظامُ والإِكبارُ",68,"ر",1,0],["لو قِسْتهم بعدوِّهم وسلاحِهِ","أيقنتَ أنهمو فريسةُ جارحِ",69,"ح",1,0],["لو قال لي مالِكُه سَمّه","ما جُزْتُ عن ناجِيَةٍ أو بُدَيْل",70,"ل",1,0],["لو قُلتِ ما قالَه فِرْعَوْنُ مُفترِياً","لخِفتُ أن تُنْصَبي في الأرضِ طاغوتا",71,"ت",2,0],["لوْ قِيلَ كَيْفَ تَتَم غانِيَةٌ","أَشَرْتُ إِلى أَلِيسْ",72,"س",1,1],["لَوْ قُلْتُ إِنَّ بَهَاءَ طَلْعَتِهَا","صَافٍ أَغَرُّ كَطَلْعَة الْفَجْرِ",73,"ر",1,0],["لَوْ قَدْ رَأَيْتَ الشحْمَ وَاللحْمَ فِي","أَيَّةِ حالٍ بَيْنَ أَضْرَاسِي",74,"س",2,0],["لَو قالَ عَبدُ الغَنِيِّ مُت أَسَفاً","لَقُلتُ إيهِ وَلَستُ أَهوى لا",75,"ل",2,0],["لو قدَّر اللهُ الكمالَ لغَيْرِه","قُلْنَا له: استَمْسِك بكُل كَمالِ",76,"ل",1,0],["لو قرأتَ الخطَّ ! الذي واسَطَ النهدينِ","يستهدفُ الطريقَ السويّا!",77,"ي",2,0],["لو قُلدت نحرها السعود من السْ","سَبعة قلَّت لذلك النحر",78,"ر",1,0],["لو قابلتْها نُبُلاً خلائقنا لم نكُ","في حسنها لنَعشِرها",79,"ر",3,0],["لو قال تعطيني الفؤا","د لم اقل والله لا",80,"ل",2,0],["لو قربوا النار من قلبي لأحرقها","وزادها من لهيب الوجد مقدارا",81,"ر",2,0],["لو قلت إنك ربهم","لرأيتهم بك مؤمنين",82,"ن",1,0],["لو قلتُ بأنكَ أوقرُ من","أحدٍ مما نازعني أحدُ",83,"د",1,0],["لو قُلّد الشجعانُ عزمَته","لغَنُوا عن الهِندىِّ ذى الصقلِ",84,"ل",1,0],["لو قَرُبَ الدُّرُّ على جالبه","ما لجَّجَ الغائصُ في طِلابه",85,"ب",2,0],["لَوْ قِيلَ هَلْ رَجُلٌ طالَتْ بَلِيَّتُهُ","لاسْتَعْبَرَتْ مُقْلَتِي حَتَّى أَقولَ أَنا",86,"ن",2,1],["لَوْ قَاسَ مَنْ قَدْ مَضى حُبِّي بِحُبِّهِمُ","كانُوا إِذا وُصِفَتْ أَشْجَانُهُمْ دُوني",87,"ي",1,0],["لَوْ قِيلَ لِي ما تَشْتَهِي","مُخَيَّراً مُحَكَّما",88,"م",2,0],["لَوْ قالَ لي مُتْ طاعَةً","لأَطَعْتُهُ وقَبِلْتُ أَمْرَهْ",89,"ر",2,0],["لَوْ قال لي مُتْ طاعَةً","مَا عِشْتُ بَعْدَ سَماعِ أَمْرِهْ",90,"ه",1,0],["لو قللوا الشكوى لاحدث عنده","فالوهم يحصل في الفتى أن كثرا",91,"ر",2,0],["لو قذفت ما شربته من دماً","سيوفه روت ربوعا ودمن",92,"ن",1,0],["لوقنعنا من المحال استرحنا","وكفانا عن الكثير القليل",93,"ل",1,0],["لَو قيلَ لِلحُسنِ اِحتَكِم لَم يَعدُها","أَو قيلَ خاطِب غَيرَها لَم يَنطُقِ",94,"ق",1,0],["لَو قيلَ كُن هُوداً لِأَشرَفِ رُتبَةٍ","مِنهُم وَدونَكَ دِرهَماً لَتَهَوَّدا",95,"د",2,0],["لَو قُسِّمَت في الأسدِ نَجدَتُهُ لَما","رَضِيَت لِأَشبُلِها العرينَة مَولِدا",95,"د",2,0],["لَو قيلَ مَن في الأَرضِ أَعلى هِمَّةٍ","وَأَعَزُّ نافِلَةٍ وَأَشرَفُ مَعشَرِ",96,"ر",1,0],["لو قيل لي ما الحُسْن كن","تُ أَفُضُّه وأقول هذا",97,"ذ",2,0],["لو قيل لي هل رأيت منتفعا","بغيره كارها لقلت أنا",98,"ن",2,0],["لو قنعوا فيه بالمباح","ما كان في الحب من جناح",99,"ح",1,0],["لَو قَلاهُ ولَم يصلهُ بضمٍّ","أحرَقتهُ مِن وجده الصعداءُ",100,"ا",2,0],["لَو قُلتَ لِلبَدرِ أَلَستَ الَّذي","فُقتُكَ في الحُسنِ لَما فَنّدك",101,"ك",1,0],["لو قابل الشمسَ كادت","لخجلةٍ منه تكسف",102,"ف",1,0],["لو قيل لي مت غدا طوع الغرام بها","وكان ذاك رضاها مت قبل غد",103,"د",1,0],["لو قيل لي مت غدا قضيت على","حكم الهوى وامتثلت ما رسمه",104,"م",2,0],["لو قدك العادل السمر الطيال رأت","يوما تثنيه لاستغرقن بالنظر",105,"ر",1,0],["لو قسمت للورى طُرّاً رزيته","ذابوا غَراماً وهم للصبر ما طاقوا",106,"ق",3,0],["لو قيل لي ما تَشْتهي لم أَقُلْ","شيئاً سوى قَلْع عيون الوُشاه",107,"ا",2,0],["لَو قَد رَآهُ ساجِداً لَسَطا بِهِ","فَلَكَيفَ أَدبَرَ عَنهُ ذا نكسانِ",108,"ن",1,0],["لو قيل ما تهوى لقال مبادراً","أهوى زيارتكم على أجفاني",108,"ن",2,0],["لَو قيلَ إِنَّكَ مُعرِضٌ","في النَومِ عَنهُ لَاِنزَعَج",109,"ج",1,0],["لو قابل البدر جزءاً من سناك غدا","له محاق التلاشي في الهوى قوتا",110,"ت",2,1],["لَو قيلَ لي ما تَمَنّى قُلتُ عَودُ لَيا","لينا بِخَيفِ مِنى حَسبي بِذاكَ مُنى",111,"ن",2,0],["لَو قالَ لِلفَلَكِ المُديرِ لِسائِرِ ال","أَفلاكِ قِف لَم يَتَّفِق دَوَرانُهُ",112,"ن",2,0],["لَو قابَلَت وَجهَكَ عَينُ الشَمسِ في","رَأدِ الضُحى كانَت بِهِ تَنكَسِفُ",113,"ف",1,0],["لَو قَد رَأَيتُ سَريري كُنتَ تَرحَمُني","وَاللَهُ يَعلَمُ مالي فيهِ تَلبيسُ",114,"س",1,1],["لو قمت قلت من الذي يرثونه","أولي أم ملك الملوك تفانا",115,"ن",2,0],["لو قيل بدر محمد","هذا لماد وما صبر",116,"ر",1,0],["لَو قيلَ من سَلَبَ النُهى","لَم تعدُهُ كفُّ المُشيرِ",117,"ر",1,0],["لَو قابَلته أُسودُ الغاب مُشبلةً","لأَدبرَت نادِماتٍ كَيفَ لم تَغِبِ",118,"ب",1,0],["لو قَدْ تقادم عصره","لرواه عني (الأَصمعي)",119,"ي",1,0],["لَوْ قُلْتُ يا أَبْخَلُ مِن مادِرٍ","لَقَالَ يا أَطْمَعُ مِن أَشعبِ",120,"ب",1,0],["لَو قابل النسوة اللاتي فُتنَّ جَوىً","لَقُلن تاللّه ما هَذا مِن البَشَرِ",121,"ر",1,0],["لو قَدْ قَدرْنا لسايَرْنا رِكابَكُمُ","لو أمكنَ السَّيرُ بالأبصارِ إمكانا",122,"ن",2,0],["لو قضَى بالعدلِ قاضٍ بَيْنَنا","وكِلانا ذابِلٌ يشكو الأُواما",123,"م",2,0],["لو قَسَّم الماءَ ما بين الظِماء يَدٌ","بالعَدْلِ لم يَبْقَ فوق الأرضِ ذو غُلَل",124,"ل",1,0],["لو قَبْلَ أن عَلِقَ الفؤادُ بحُبِّكمْ","يا سادتي لم تَعْدِلوا لم نَعْذُل",125,"ل",1,0],["لو قاتَلوا بَدَلَ الظُّبَى بلِحاظِها","كانوا إذنْ أمضى الأنامِ سِلاحا",126,"ح",2,0],["لَوَقَيتُ النبيَّ بالنفسِ منّي","ولَعانقتُ دونَه الأَقرانا",127,"ن",2,0],["لو قلتُ منُّوا بأخذ قلبي","لكان أولَى من امتِنانِ",128,"ن",1,0],["لو قسمت بين الورى","لرأوا الإلهَ علانيه",129,"ي",2,0],["لو قابلت شمسُ العلاء ضياءه","لا تَدَّعي بالإسم إن لم تُكسَف",130,"ف",1,0],["لَو قالَها بَينَ سُكّانِ الجنانِ غَداً","تَباهَت الحورُ لقطَ الدرِّ من فيهِ",131,"ي",2,0],["لَو قُلتُ هَل مِثلُ ما ناحَت مطوَّفَةٌ","لما تَقَصَّيتُ هاتيكَ التَحاسينا",132,"ن",2,0],["لَو قيلَ لِلمُجبَرِ المَعتوهِ اِنَّ لَهُ","أَباً يُريدُ فَساداً طاحَ من غَضَبِهِ",133,"ب",2,1],["لو قدرنا إذاً قضينا بتقبيل","خفاف المطيّ فرضاً ونَفْلاَ",134,"ل",2,0],["لَو قصَّر العافونَ عن طَلب النّدى","لأقَامَ فيهمْ للنّوال مُنادي",135,"ي",1,0],["لو قُلتُ ما قُلْتُ فيهمُ قَصْرَتْ","عَنْ عُشْرِ مِعشار فَضلِهمْ كلمي",136,"م",2,0],["لَو قالَ للسَّيل وهْوَ مُنحدِرٌ","في صَبَبٍ قِفْ ولا تَفِضْ وقَفا",137,"ف",2,1],["لو قابل العامري أسرار طلعتها","لهام في بيتها المعمور اوباهي",138,"ا",3,0],["لو قُمْتُ في الديوانِ أَنظِمُ هَجْوَهُ","ديوانَ شعرٍ لم أَقُمْ بالواجِبِ",139,"ب",1,0],["لو قلتُ تحكيه الغَمامُ سماحةً","فنوالُه طولَ المدى عِقْيانُ",140,"ن",1,0],["لو قلتُ للساعي ليدرِكَه","ارْجِعْ عَمِيتَ بمَسْلَكٍ غُفْلِ",141,"ل",1,0],["لو قامَ ينطحُ ذو القرنينِ صخرتَهُ","لعادَ واهي قرونِ الرّأسِ كالوعَلِ",142,"ل",1,0],["لو قيلَ ما الجودُ لقال الوَرى","كلهُمُ من بعضِ أسمائكْ",143,"ك",1,0],["لَوْ قيلَ لي خُذْ أَماناً","مِنْ حادِثاتِ الزَّمانِ",144,"ن",1,1],["لَوْ قارَعَتْ عنكَ الخلائِقِ كلَّها","غَلَبَتْ عَلَيْكَ بشكرِها ووِدادِها",145,"د",3,0],["لو قورنت بالآلي فاق جوهره","حسنا وحير ما تحويه أفكارا",146,"ر",2,0],["لو قلت ألف قصيدة وقصيدة","خرجت شظاياها من الأعماق",147,"ق",1,0],["لو قَدُمت لم يُروَ شيءٌ غيرُها","لكنني أُتيتُ من حِدثانِها",148,"ن",3,0],["لو قُرنتْ بالبحر لم تحتشِمْ","أو مُسِحتْ بالنجم لم يُظلِمِ",149,"م",1,0],["لو قيل سكانُ الحمى وفعلُهم","بي فعلُهم نزا فؤادي ورجَفْ",150,"ف",1,0],["لو قد رأيتَ مع الدموع جدوبَهُ","فرطَ الزفيرِ عجبتَ للراوي الصَّدِي",151,"د",2,0],["لو قيل إنِّي سرقتُ السمعَ أو صرفوا","إليَّ تبديلَ دينِ اللهِ أو نَسَبوا",152,"ب",3,0],["لو قِيض إنصافُك قِدماً له","عَزَّ فلم يُقْصَ ولم يُقْصَبِ",153,"ب",1,0],["لو قدرنا حين يجلوه الكرى","لجعلنا أنجمَ الليل نثارا",154,"ر",2,0],["لَو قيلَ لِلفَمِ مِنّي","تَمَنَّ ما تَشتَهيهِ",155,"ي",2,0],["لَو قَطَّعَ قَفا عِرضِهِ","بِالهَجوِ ما خَلَّصَهُ دِرهَمُه",156,"م",2,0],["لَو قاسَ عُروَةُ والنَهديُّ وَجدَهُما","لَكانَ وَجدي بِسُعدى فَوقَ ما وَجَدا",157,"د",2,0],["لو قيل لي وأنا المكلوم في كرم","من كنت تهوى أقل في الحين جرمان",158,"ن",1,0],["لو قيل لي أقم الدلي","ل على رقي الشبان",159,"ن",1,0],["لو قابَلَ السَّحابُ فيكُمْ دَمْعَتي","وحَقِّكُمْ لَسَحَّ دَمعي خَجَلا",160,"ل",2,0],["لو قابَلَتْ مُقلةَ الحِرباءِ طلعَتُهُ","ليلاً لرُدَّ إليها الطّرفُ وهوَ عَمي",161,"م",2,0],["لو قست بي من يدعي لك خدمة","ومحبة لغدوت وحدي أوحدا",162,"د",2,0],["لو قصر الحمد بي عن شكر نعمته","فالله شاكره عني وحامده",163,"د",2,0],["لَو قَطرَةٌ مِن دَمِهِ","سالت في ماءِ النيلِ",164,"ل",1,1],["لو قيلَ مَن بِني الحَمراءِ قاطبة","يسبِي عُقولَ البرَايا قلتُ بَلُوطُ",165,"ط",1,1],["لو قال ما عنده من علم خالقه","عن النبي دهاه قطعُ بلعوم",166,"م",1,0],["لو قامتِ الأمواتُ من أرماسِها","لم يبقَ مَوْضِعُ وقفةٍ مَعَها لَنا",167,"ا",1,0],["لو قُلتَ للكَرَمِ المصفَّى من تُرَى","تدعو أباكَ لقالَ قُلْ يا يوسُفُ",168,"ف",1,0],["لو قامَ من قَتَلتْهُ سَطوةُ مِثلِهِ","ضاقت بكثرتِهمْ رِحابُ الفدْفَدِ",169,"د",1,0],["لَوْ قِيْلَ مَنْ أَحْسَنُ الأَنَامِ وَمَنْ","أَعْشَقُهُمْ قَلْتُ هَذِهِ وَأَنَا",170,"ن",2,0],["لَوْ قيسَتِ الدُّنيْا ولذاتُها","بِساعَةٍ من وَصْلِهِ ما وَفَتْ",171,"ت",1,0],["لو قال كان قوله لزاما","وكان كل رجل إماما",172,"م",2,0]]}