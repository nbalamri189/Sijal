{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[71,"عجبت للطيف يا لمياء حين سرى","https://www.aldiwan.net/poem4012.html","البسيط"],[93,"قد قلدوك قلائد الدرر","https://www.aldiwan.net/poem9844.html","أحذ الكامل"],[93,"لو قيل للحسن كيف تهوى","https://www.aldiwan.net/poem11207.html","مخلع البسيط"],[41,"يا روضة الوضاح قد","https://www.aldiwan.net/poem42348.html","مجزوء الكامل"],[88,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[88,"لو أسكر الإنسان باطل أمره","https://www.aldiwan.net/poem45061.html","الطويل"],[27,"قد غلبتني رواة الناس كلهم","https://www.aldiwan.net/poem4428.html","البسيط"],[27,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[37,"لو قيل للجود من حليفك ما","https://www.aldiwan.net/poem6420.html","المنسرح"],[72,"البرق في كانونه قد نفخ","https://www.aldiwan.net/poem18532.html","السريع"],[72,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[72,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[51,"صادت فؤادي عشية النفر","https://www.aldiwan.net/poem62946.html","الطويل"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"ومسمع لا عدمت فرقته","https://www.aldiwan.net/poem66043.html","المنسرح"],[51,"لا تلح من تفتنه قينه","https://www.aldiwan.net/poem66452.html","السريع"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[43,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem9442.html","الكامل"],[45,"ما للكبير في الغواني من أرب","https://www.aldiwan.net/poem10669.html","الرجز"],[45,"هو الظلام فلا صبح ولا شفق","https://www.aldiwan.net/poem65179.html","البسيط"],[45,"خير يوميك في الهوى واقتباله","https://www.aldiwan.net/poem65606.html","الخفيف"],[45,"ربع خلا من بدره مغناه","https://www.aldiwan.net/poem66856.html","الكامل"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[49,"ستباشر الأجداث وحدك","https://www.aldiwan.net/poem62062.html","مجزوء الكامل"],[49,"الحرص لؤم ومثله الطمع","https://www.aldiwan.net/poem62152.html","المنسرح"],[49,"سكر الشباب جنون","https://www.aldiwan.net/poem63129.html","المجتث"],[49,"سبق القضاء بكل ما هو كائن","https://www.aldiwan.net/poem63143.html","الكامل"],[49,"أبنيت دون الموت حصنا","https://www.aldiwan.net/poem63147.html","مجزوء الكامل"],[49,"لو قيل للعباس يا ابن محمد","https://www.aldiwan.net/poem64285.html","الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[80,"أظلوم منك تعلمت ظلمي","https://www.aldiwan.net/poem31314.html","أحذ الكامل"],[44,"معتدل لم يعتدل عدله","https://www.aldiwan.net/poem30127.html","السريع"],[44,"نفسي فداء محمد ووقاؤه","https://www.aldiwan.net/poem30295.html","الكامل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[44,"ها إن هذا موقف الجازع","https://www.aldiwan.net/poem30459.html","السريع"],[69,"كبد معذبة وقلب خافق","https://www.aldiwan.net/poem28903.html","الكامل"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[105,"هل في جفونكما دمع لممتاح","https://www.aldiwan.net/poem43147.html","البسيط"],[105,"ما يكسب المرء من إثم ولا يزر","https://www.aldiwan.net/poem44197.html","الطويل"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[81,"أحلى من الأمن لا يأوي لذي كمد","https://www.aldiwan.net/poem61536.html","البسيط"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[48,"ما غضبي من شتم أحبابي","https://www.aldiwan.net/poem10797.html","السريع"],[48,"وخندريس لها شعاع","https://www.aldiwan.net/poem65100.html","مجزوء البسيط"],[48,"يا ليلة بت في دياجيها","https://www.aldiwan.net/poem66173.html","المنسرح"],[48,"يا غاسل الطرجهارِ","https://www.aldiwan.net/poem66568.html","المتقارب"],[50,"حن قلبي إلى غزال ربيب","https://www.aldiwan.net/poem64826.html","الخفيف"],[50,"يا طيب سيان عندي أنت والطيب","https://www.aldiwan.net/poem64855.html","البسيط"],[50,"يا مالك الناس في مسيرهم","https://www.aldiwan.net/poem64869.html","المنسرح"],[46,"الدهر يزبق من حواه كأنهم","https://www.aldiwan.net/poem23024.html","الكامل"],[46,"طلب الخسائس وارتقى في منبر","https://www.aldiwan.net/poem23178.html","الكامل"],[46,"ما للأنام وجدتهم من جهلهم","https://www.aldiwan.net/poem23424.html","الكامل"],[46,"ما وقع التقصير في لفظنا","https://www.aldiwan.net/poem23491.html","السريع"],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85425","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54980","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54909","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54970","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43826","المنسرح"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[90,"أول العهد","https://www.poetsgate.com/ViewPoem.aspx?id=179151",""],[51,"صادت فؤادي عشية َ النفر","https://www.poetsgate.com/ViewPoem.aspx?id=29036",""],[51,"أشدْ بأيامنا لتَشهرَها","https://www.poetsgate.com/ViewPoem.aspx?id=29178",""]],"verses":[["لَوَقتَكَ الرَدى نُفوسٌ عَزيزا","تٌ وَأَيدٍ مَليئَةٌ بِالطِعانِ",0,"ن",1,0],["لَو قابَلَ اللَيلَ البَهي","مَ لَمَزَّقَ اللَيلَ البَهيما",1,"م",2,0],["لَوَقَفتُ بَينَكُما لِأَعكِسَ سَهِمَها","عَن نَحرِكَ البادي إِلى نَحري",2,"ر",2,0],["لَو قَدَرنا وَساعَفَتنا اللَيالي","لَوَصَلنا بِعُمرِكَ الأَعمارا",3,"ر",2,0],["لَو قَدَرنا عَلى المُنى لَفَدَينا","ذي الأَضاحي مِنَ الظُبى بِالأَعادي",4,"د",2,0],["لو قارَعَ الناسُ المَنونَ لردَّها","عنهُ السّيوفُ فَوالِقاً لِلْهامِ",5,"م",1,0],["لَوْ قَالَ فِي هَرِمٍ زُهَيْرٌ مِثْلَهَا","هَرِمَ الزَّمَانُ وَذِكْرُهُ لَمْ يَهْرَمِ",6,"م",1,0],["لَو قامَ بَعضُ رُواةِ الشِعرِ يُنشِدُهُ","يَوماً بِأَرضِ أَزالٍ أخجلَ الحِبَرا",7,"ر",2,0],["لو قلت إن بهاء طليعتها","صاف أغر كطلعة الفجر",8,"ر",1,0],["لَوْ قِيلَ لِلْحُسْنِ كيْفَ تَهْوَى","إِنْ أَنْتَ خُيِّرْتَ أَنْ تَكُونَا",9,"ن",2,1],["لَو قِيلَ يَا وَضَّاحُ قُم","فَاختَر لِنَفسِكَ أَو تَمَن",10,"ن",1,0],["لو قيل لي في الجيش مَن ذا الذي","كان بما أوقعه آمره",11,"ر",2,0],["لو قاس كلّ فتى سواه بنفسه","فيما أراد لما تعادى اثنان",12,"ن",1,0],["لَو قُلتَ أَينَ هَوادي الخَيلَ ما عَرَفوا","قالوا لِأَذنابِها هَذي هَوادِيَها",13,"ي",3,0],["لَو قَد عَلَونا سَماوِيّاً مَوارِدُهُ","مِن نَحوِ دَومَةِ خَبتٍ قَلَّ تَعريسي",14,"س",2,0],["لو قيل للجود من حليفك ما","إن كان إلا إليك ينتسبُ",15,"ب",1,1],["لو قابلت سنوننا شمسه","أو نوءها أبصرته قد نسخ",16,"خ",1,0],["لو قيل إن شموس الصحو خافية","ما قال عنها عدو أنها بخلت",17,"ت",1,0],["لو قالَ طلت السهى قال الأنام نعم","يا صادق القول والعليا فقل وطل",18,"ل",1,0],["لو قُلِّدت نحرها السعود من ال","سَبعة قلَّت لذلك النحر",19,"ر",1,0],["لو قابلتْها بنا خلائقنا","لم نكُ في حسنها لنَعشِرها",20,"ر",3,0],["لو قارع الأكفاء كلهم","عن سؤدد وقعت له القرعه",21,"ع",2,0],["لو قصدتُ المديحَ في هذه الخط","بةِ ماطلْتُكَ الجراءَ مطالا",22,"ل",2,0],["لوقفْتها نصبَ الكريهةِ موقفاً","ما كان تعذيراً ولا تحليلا",23,"ل",2,0],["لو قضى الدهرُ للمُحقِّ لأضحوا","لا يسوّي خدودهم بنعالي",24,"ل",2,0],["لو قُدِّسَ اللَّهُ ذو الجلال به","لم يرفعِ اللَّهُ طيِّب الكلِمِ",25,"م",1,0],["لو قصدَ العاشقُ في عشقه","قصدَ جزاء ما بكى دِمنهْ",26,"ن",2,0],["لَو قُلتُمُ اِختَر لِلنِيابَةِ جاهِلاً","أَو لِلخَطابَةِ باقِلاً لَتَخَيَّرا",27,"ر",2,0],["لَو قَدَروا جاؤوكُمُ بِالثَرى","مِن قُطبِهِ مُلكاً إِلى قُطبِهِ",28,"ب",2,0],["لَو قُلتَ لِلدَنِفِ الحَزينِ فَدَيتُهُ","مِمّا بِهِ لَأَغَرتَهُ بِفِدائِهِ",29,"ا",3,0],["لَو قيلَ لِلمَجدِ اِنتَسِب إِلى اِمرِئٍ","لَم تُلفِهِ إِلّا إِلَيهِ يَنتَسِب",30,"ب",1,0],["لَو قيلَ لِلأَزدِ ما قالوا وَما اِنتَحَلوا","مِن اِدِّعاءٍ إِلَيهِ قالَ ما صَدَقوا",31,"ق",3,0],["لَو قَليلٌ كَفى اِمرَأً مِن كَثيرٍ","لَاِكتَفَينا بِقَولِهِ مِن فَعالِهِ",32,"ل",2,0],["لَو قيلَ مَن حازَ السَماحَةَ وَالنَدى","يَومَ الفَخارِ لَقيلَ ذاكَ الشاهُ",33,"ا",2,0],["لو قرأنا التاريخ ما ضاعت القدس","وضاعت من قبلها \"الحمراء\"..",34,"ا",2,0],["لَو قَد دُعيتَ لَما أَجَبتَ لِما","تُدعى لَهُ فَانظُر لِما تُدعى",35,"ا",1,0],["لَو قَد ظَعَنتَ عَنِ البُيو","تِ وَرَوحِها وَسَكَنتَ لَحدَك",36,"ك",1,0],["لَو قَنِعَ الناسُ بِالكَفافِ إِذاً","لَاِتَّسَعوا في الَّذي بِهِ قَنِعوا",37,"ع",3,0],["لَو قَد تُرِكتَ صَريعاً","وَقَد بَكَتكَ العُيونُ",38,"ن",1,0],["لَو قَد دُفِنتَ غَداً وَأَقبَلَ نافِضاً","كَفَّيهِ عَنكَ مِنَ التُرابِ الدافِنُ",39,"ن",1,0],["لَو قَد دُعيتَ غَداً لَتُس","أَل ذا مُحاسَبَةً وَوَزنا",40,"ن",2,0],["لَو قيلَ لِلعَبّاسِ يا اِبنَ مُحَمَّدٍ","قُل لا وَأَنتَ مُخَلَّدٌ ما قالَها",41,"ل",3,1],["لَو قيلَ عُج نَحوَ السَماءِ مُبادِراً","وَطِئَت يَداهُ دَوابِرَ الدَبَرانِ",42,"ن",1,0],["لو قدْ وقفتِ على ضَنى جَسَدي","لوقفتِ باكيةً على رسمِ",43,"م",1,0],["لَو قيلَ لِلحُسنِ تَمَنّى المُنى","إِذَن تَمَنّى أَنَّهُ مِثلُهُ",44,"ل",2,0],["لَو قيلَ سَل تُعطَ المُنى كانَ المُنى","أَن لَو رَأى مَولاهُ كَيفَ بُكاؤُهُ",45,"ا",3,0],["لَو قُلتُ حُصِّلَ بَعضُها أَو كُلُّها","في حاتِمٍ لَدُعيتُ دافِعَ مَغرَمِ",46,"م",1,0],["لَو قَبلَ ما كانَ مَزوراً بِها","إِذاً لَسُرَّ الرَبعُ بِالرابِعِ",47,"ع",1,0],["لو قلتَ للعشاقِ موتوا لوعةً","وصبابةً بانَ المحبُّ الصادقُ",48,"ق",1,0],["لَو قيلَ يَومَ يَقومُ الناسُ مَوعِدُنا","قالوا مَساريعُ راعونا بِتَعجيلِ",49,"ل",1,0],["لَو قيلَ لِلمَجدِ فيمَن أَنتَ مُنتَسِبٌ","لَأَفصَحَ المَجدُ عَنهُم أَيَّ إِفصاحِ",50,"ح",1,0],["لو قُمْتَ يومئذٍ بالسّيفِ تأخذُه","بعثتَها غضبةً جأواءَ تستعر",51,"ر",1,0],["لو قلتُ للقومِ جيئوني بهامتِه","رأيتَهم يفعلون اليومَ ما أُمرِوا",51,"ر",3,0],["لَو قادَ مِن فَقرِهِ قَولاً يُفَقِّرُهُ","أَو لَو يُشَجِّعُهُ لَفظٌ يُسَجِّعُهُ",52,"ع",2,0],["لَو قيلَ وَالنَفسُ رَهنُ المَوتِ مِن ظَمَءِ","موسى أَو البارِدُ السَلسالُ لَم أَرِدِ",53,"د",1,0],["لو قلتُ إنّ المُرهَفاتِ البِيضَ لم","تُخْلَقْ لغَيركُمُ لقُلتُ صَوابا",54,"ب",2,0],["لَو قُستُ بِالشَمِّ بَلائي بِهِم","زادَ فَأَفنى حَسبَ حُسّابي",55,"ي",1,0],["لَو قُرِّبَت في الظَلامِ يَوماً","لَاِنجابَ عَنها دُجى الظَلامِ",56,"م",1,0],["لَو قيلَ لِلحُسنِ صِف مَحاسِنَها","ما اِسطاعَ ضَعفاً بِذاكَ يَحكيها",57,"ي",3,0],["لوقتهِ الكرّارِ","والنوكرور الكبارِ",58,"ر",1,0],["لَو قَدِرنا عَلى رُقى سِحرِ هارو","تَ طَلَبنا الوِصالَ بِالتَحبيبِ",59,"ب",1,0],["لَو قَد لَقيتُكِ خَلفَ العَينِ خالِيَةً","أَصلَحتِ مِنّي الَّذي لا يُصلِحُ الطيبُ",60,"ب",1,0],["لَو قامَ بِالحادِثِ العَظيمِ لَما","عَيَّ بِعُمرانِهِ وَلا خَرِبِه",61,"ب",2,0],["لَو قالَ بَدرُ التَمِّ إِني دِرهَمٌ","قالَت لَهُ السَفهاءُ أَنتَ مُزأَبِقُ",62,"ق",1,0],["لَو قامَ أَمواتُ العَواصِمِ وَحدَها","مَلَأوا البِلادَ حَزونَها وَسُهولَها",63,"ل",3,0],["لَو قالَ سيدُ غَضاً بُعِثتُ بِمِلَّةٍ","مِن عِندِ رَبّي قالَ بَعضُهُم نَعَم",64,"م",1,0],["لَو قيلَ لَم يَبقَ سِوى ساعَةٍ","أَمَّلتَ ما تَعجِزُ عَنهُ سَنَه",65,"ن",2,0],["لَوْ قالَ تِيهاً قِفْ على جَمْر الغَضا","لَوَقَفْتُ مُمْتَثِلاً ولم أتوَقّف",66,"ف",1,0],["لَو قدَّروا الأمر ما ثارَت عجاجتها","وَلا شكت عينهم من خوضها الرمدا",67,"د",2,0],["لو قِيلَ أبطالُ العصورِ فمنهُمو","لحُماتِكِ الإعظامُ والإِكبارُ",68,"ر",1,0],["لو قِسْتهم بعدوِّهم وسلاحِهِ","أيقنتَ أنهمو فريسةُ جارحِ",69,"ح",1,0],["لو قال لي مالِكُه سَمّه","ما جُزْتُ عن ناجِيَةٍ أو بُدَيْل",70,"ل",1,0],["لو قُلتِ ما قالَه فِرْعَوْنُ مُفترِياً","لخِفتُ أن تُنْصَبي في الأرضِ طاغوتا",71,"ت",2,0],["لوْ قِيلَ كَيْفَ تَتَم غانِيَةٌ","أَشَرْتُ إِلى أَلِيسْ",72,"س",1,1],["لَوْ قُلْتُ إِنَّ بَهَاءَ طَلْعَتِهَا","صَافٍ أَغَرُّ كَطَلْعَة الْفَجْرِ",73,"ر",1,0],["لَوْ قَدْ رَأَيْتَ الشحْمَ وَاللحْمَ فِي","أَيَّةِ حالٍ بَيْنَ أَضْرَاسِي",74,"س",2,0],["لَو قالَ عَبدُ الغَنِيِّ مُت أَسَفاً","لَقُلتُ إيهِ وَلَستُ أَهوى لا",75,"ل",2,0],["لو قدَّر اللهُ الكمالَ لغَيْرِه","قُلْنَا له: استَمْسِك بكُل كَمالِ",76,"ل",1,0],["لو قرأتَ الخطَّ ! الذي واسَطَ النهدينِ","يستهدفُ الطريقَ السويّا!",77,"ي",2,0],["لو قُلدت نحرها السعود من السْ","سَبعة قلَّت لذلك النحر",78,"ر",1,0],["لو قابلتْها نُبُلاً خلائقنا لم نكُ","في حسنها لنَعشِرها",79,"ر",3,0]]}