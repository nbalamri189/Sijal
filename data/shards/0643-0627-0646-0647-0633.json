{"poems":[[95,"إقبال مولودك السعيد","https://www.aldiwan.net/poem11196.html","مخلع البسيط"],[53,"وقائل لم هجوت الورد معتمدا","https://www.aldiwan.net/poem65032.html","البسيط"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[77,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[50,"قد أغتدي والصبح مشهور","https://www.aldiwan.net/poem63411.html","الخفيف"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[469,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[556,"قلت وقد لاح بريق الدجى","https://www.aldiwan.net/poem47830.html","السريع"],[566,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106979","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93360","البسيط"],[2986,"","https://poetry.dctabudhabi.ae/diwan/poem/146206","البسيط"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33119","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119680","الرجز"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[5776,"جُرْحٌ أخضر","https://www.poetsgate.com/ViewPoem.aspx?id=199581",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["كَأَنَّهُ سُلَّ مِنْ حَشَانَا","ذَاكَ الَّذِي هَلَّ مِنْ بَعِيدِ",0,"د",1,0],["كأنه سُرمُ بغلٍ حين يُخرجُه","عند الرِياث وباقي الروث في وسطِهْ",1,"ط",2,0],["كَأَنَّهُ ساجِدٌ مِن نَضخِ ديمَتِهِ","مُسَبِّحٌ قامَ بَعضَ اللَيلِ فَاِبتَهَلا",2,"ل",2,0],["كأنّهُ ساخِطٌ يَرضى على عَجَلٍ","فما يدومُ رِضىً منه ولا سَخَط",3,"ط",1,0],["كَأَنَّهُ سَهمٌ إِلى غايَةٍ","أَو كَوكَبٌ في الأُفقِ مَحدورُ",4,"ر",1,0],["كَأَنَّهُ سَيفُ وَغىً مَشهورُ","خالَطَ مِسكاً وَبِهِ تَأمورُ",5,"ر",1,0],["كأنَّهُ سميُّهُ","هبَّ فأحيى من قتل",6,"ل",1,0],["كأنّه سَيفٌ ولكنّه","طوعُ بنانِ المُخرِجِ المغمدِ",7,"د",1,0],["كَأَنَّهُ سِبطٌ مِنَ الأَسباطِ","بَينَ حَوامي هَيدَبٍ سَقّاطِ",8,"ط",1,0],["كأنه سرق في اللين أو ورقٌ","في الجيد أو صولجانٌ باكرَ اللعبا",9,"ب",2,0],["كأنه سلك عقيق وبه","من الثنايا لؤلؤ منضد",10,"د",1,0],["كَأَنَّهُ سارِقٌ طيباً تَفَرَّقَ في الظ","ظَلماءِ فَهوَ بِنَمِّ الرِّيح مُشتَهِرُ",11,"ر",1,0],["كأنّه سحب من فضة ضربت","وزيّنت بدنانير مفاصله",12,"ل",2,1],["كَأَنَّهُ سُحُبٌ تَرمي صَواعِقُها","أَرضاً وَيَنزِلُ في أُخرى بِها المَطَرُ",13,"ر",1,0],["كأنه سيف إذا","ما سُلّ أراك العَجَب",14,"ب",1,0],["كَأَنَّهُ سالِكٌ مِنهُ عَلى وَشَلٍ","في الأَرضِ مِن مُهَجِ الأَسيافِ مَقطورِ",15,"ر",1,0],["كأنهُ سنبلاتٌ أينعتْ قدرًا","وحانَ ميعادها تطفو على السطحِ",16,"ح",1,0],["كأنه سحرُ اللَهِ للقلبِ جاذبٌ","واللَهُ يُحِقُّ الحق والباطلُ يفلا",17,"ل",2,0]]}