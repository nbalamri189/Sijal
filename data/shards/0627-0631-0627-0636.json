{"poems":[[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[376,"أراضية أنت إن شفه","https://www.aldiwan.net/poem57233.html","المتقارب"],[519,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49943","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35735","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93926","الطويل"],[5277,"منادمة","https://www.poetsgate.com/ViewPoem.aspx?id=206862",""],[5848,"جنب السور","https://www.poetsgate.com/ViewPoem.aspx?id=53154",""],[5939,"فتاتان","https://www.poetsgate.com/ViewPoem.aspx?id=195309",""]],"verses":[["أَراضَت بِمَثواكَ القُبورُ وَلَم يَزَل","عَلَيها لِساجي المزنِ مِن أَجلِهِ خَفشُ",0,"ش",1,0],["أَراضِيَةٌ أَنتِ إِن شَفَّهُ","هَواكِ وساخِطَةٌ إِن سَلا",1,"ل",2,1],["أراضَ جوانحَ الحِدْثانِ حتّى","به ثبتَتْ لنا صفةُ الصُّفونِ",2,"ن",1,0],["ارَاضٍ انا من زَيْنَبٍ زَيَنباً بِها","ومُسْتبدلٌ من ابطَحِ السّهل ابطَحَا",3,"ح",2,0],["أَراضِيَةٌ سَلمى بِما صَنَعَ الدَهرُ","وَإبعادهِ وَصلاً دَنا مَعَهُ هَجرُ",4,"ر",1,0],["أراضيهم الدنيا وناسهم الورى","ينال مناه من بظلهم استظل",5,"ل",1,0],["أراضعك المودةَ في ذهولٍ","حميمٍ..حين تذهلُ نظرتيكِ",6,"ك",1,1],["اراضي بور وقبور وشعور ( اللا شعور ) يثور","وادوّن لا مبالاتي على رزنامة ايامي",7,"م",2,1],["أُراضيها بأشعاري","وما بالعطفِ تَشملُني",8,"ن",2,0]]}