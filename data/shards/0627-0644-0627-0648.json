{"poems":[[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[55,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem26543.html","الطويل"],[71,"يا ابن الكرام الأولين","https://www.aldiwan.net/poem3980.html","مجزوء الكامل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[54,"تأسفت جارتي لما رأت زوري","https://www.aldiwan.net/poem27564.html","البسيط"],[88,"هو الدهر لم يترك مشن غواره","https://www.aldiwan.net/poem45014.html","الطويل"],[51,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[51,"تجرد من غمدين سيف مهند","https://www.aldiwan.net/poem61940.html","الطويل"],[51,"إذا حاولت تطفيلا","https://www.aldiwan.net/poem61986.html","الهزج"],[51,"يقول وقد سددوا نحوه","https://www.aldiwan.net/poem64056.html","المتقارب"],[51,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[14,"أرقت وصحبتي بمضيق عمق","https://www.aldiwan.net/poem38306.html","الوافر"],[38,"طال العشاء ونحن بالهضب","https://www.aldiwan.net/poem7686.html","الكامل"],[78,"لله ما خلد الأمحاض في خلدي","https://www.aldiwan.net/poem14279.html","البسيط"],[89,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[45,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem11438.html","الطويل"],[45,"ربع خلا من بدره مغناه","https://www.aldiwan.net/poem66856.html","الكامل"],[49,"لدوا للموت وابنوا للخراب","https://www.aldiwan.net/poem10340.html","الوافر"],[49,"نسيت منيتي وخدعت نفسي","https://www.aldiwan.net/poem62121.html","الوافر"],[49,"لعمري لقد نوديت لو كنت تسمع","https://www.aldiwan.net/poem62151.html","البسيط"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[81,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[48,"يا عمرو من لم يختنق","https://www.aldiwan.net/poem64444.html","مجزوء الرجز"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"يا مقلة الرشإ الغري","https://www.aldiwan.net/poem39329.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85793","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24724","الرمل"],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""]],"verses":[["أَلّا وَقى المَجدُ المُؤَثَّلُ رَبَّهُ","أَلّا زَوى المِقدارُ أَلّا حالا",0,"ل",2,0],["أَلا وِصالٌ سِوى طَيفٍ يُؤَرِّقُني","وَلا رَسائِلَ إِلّا البيضُ وَالأَسَلُ",1,"ل",1,0],["أَلا وَاستَزيديها هَوىً وَتلَطُّفاً","وَقولي لَها في السِرِّ يا أُمَّ طالِبِ",2,"ب",1,0],["الأَوَّلينَ إِلى الوَغى","وَالآخِرينَ إِلى الغَنائِم",3,"م",1,0],["أَلّا وَقَد حانَ صُبحُ البَينِ صَبَّحَنا","حَينٌ فَقامَ بِنا لِلحَينِ ناعينا",4,"ن",2,0],["أَلا وَقَدْ بَلَغَتْ فِي الخَافِقِينَ بِهِ","مَكَانَةً لَمْ تَكُنْ مِنْهَا بِحُسْبَانِ",5,"ن",1,0],["إِلّا وَهُم شُرَكاءٌ في دِمائِهُمُ","كَما تَشارَكَ أَيسارٌ عَلى جُزُرِ",6,"ر",1,0],["ألا وَرْيَ في زند الزمان فنهتدي","بسقط ضئيل من سقيط شراره",7,"ر",2,0],["الأوفياءُ إذا ما معشرٌ نَكَثُوا","والجاعلون الرضا للَّه والغضبا",8,"ب",2,0],["ألا وعلى أشياعه مثل لَعْنَةٍ","رماهُ بها داعٍ عليه وأوْكَدُ",9,"د",1,0],["ألا واجعلْه تطفيلاً","ذليق الحد نفّاذا",10,"ذ",2,0],["ألا وأبيكِ ابنةَ العامري","ي لا يدعي القوم أني أفر",11,"ر",1,0],["إلّا وهم شركاءُ في مُتعاته","فمَن السليمُ من الشريك الأشْكَس",12,"س",1,0],["ألا وازدرع ماجداً مدحة","فإنك حاصد ما تزدرع",13,"ع",1,0],["ألا واستجيري الله لي إنَّ جارهُ","بمَنْجىً بعيدٍ من ممرِّ القواصمِ",14,"م",1,0],["أَلا وَأَبيكَ لَو كَاليَومَ أَمري","وَمَن لَكَ بِالتَدَبُّرِ في الأُمورِ",15,"ر",1,0],["أَلأَوبُ أَوبُ نَعائِمٍ قَطَرِيَّةٍ","وَالأَلُّ أَلُّ نَحائِصٍ حُقبِ",16,"ب",1,0],["الأَوحَديّ أَبي الجَيشِ الَّذي ظَفَرَت","مِنهُ بِأَنفَسِ عِلقٍ في الأَنامِ يَدي",17,"د",2,0],["الاولون ابتدؤا","والاخرون تمموا",18,"م",3,0],["إلّا وأنتَ على سَراةِ طِمِرَّةٍ","كالسِّيْدِ وقعُ جِرائِها متتابِعُ",19,"ع",1,0],["أَلا وَاِستَزيريها إِلَينا تَطَلُّعاً","وَقولي لَها في السِرِّ يا أُمَّ طالِبِ",20,"ب",1,0],["إِلّا وَلِيَّكَ فَاِعتَبِدهُ بِشاحِجٍ","لِطَريقِهِ لَم يَحوِهِ شَطَناهُ",21,"ا",2,0],["أَلا وَأَراكَ تَبذُلُ يا زَماني","لي الدُنيا وَتَسرِعُ بِاِستِلابي",22,"ي",1,0],["أَلا وَلَقَلَّ ما تَلقى شَجِيّاً","يَضيعُ صَجاهُ إِلّا بِالتَأَسّي",23,"ي",1,0],["أَلا وَإِذا وُدِّعتَ تَوديعَ هالِكٍ","فَآخِرُ يَومٍ مِنكَ يَومُ تُوَدَّعُ",24,"ع",1,0],["أَلا وَكَما شَيَّعتَ يَوماً جَنائِزاً","فَأَنتَ كَما شَيَّعتَهُم سَتُشَيَّعُ",24,"ع",1,0],["ألا وفيّ ألا معين","في مدلهم بلا صباح",25,"ح",1,0],["أَلا وَتَهنَأ موسِماً لِوُفودِهِ","لَقَد كادَ قَبلَ الوَقتِ نَحوَك يَسبِقُ",26,"ق",1,0],["إِلّا وَداعي حُبِّهِ","يَثني إِلَيهِ عُنُقي",27,"ي",1,0],["إِلا وقد صَيَّرها هَباءَ","كالنَّارِ إذ وافَقتِ الآباءَ",28,"ا",2,0],["إلا وَضَعْتُ يَدي عَلى","قَلبي مَخافةَ أَنْ يَطيرْ",29,"ر",1,0],["الأولون ابتدؤوا","والآخرون تمَّموا",30,"م",3,0],["ألا وهو العدل الذي قد نفاه في","تعدده واللَه بالناس أعلم",31,"م",1,0],["أَلاَ وَقدْ عَلَّمْتَنِي","بِمَشْهَدٍ وَمُخْتَبَرْ",32,"ر",1,0],["ألا واجعله ممتثِلاً","محاسنَ وجهك الحَسَنِ",33,"ن",1,0],["الأوصياءُ القيِّمون على الورىْ","تركوا الورى بدمائهم مخضوبا",34,"ب",2,0],["إلاَّ ونالَ بِجُودِهِ المَأْمُولا","وكفى بفضلٍ منه لي تنويلا",35,"ل",2,0]]}