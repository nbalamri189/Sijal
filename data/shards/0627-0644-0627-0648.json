m/ViewPoem.aspx?id=202690",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[5565,"وساحِرِ المقلتين تحسَبُه","https://www.poetsgate.com/ViewPoem.aspx?id=110220",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5606,"الرجل كلمته تظهرمدى مستواه","https://www.poetsgate.com/ViewPoem.aspx?id=194430",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5694,"مدير الحب","https://www.poetsgate.com/ViewPoem.aspx?id=132094",""],[5701,"بنى مصر إن الجيش أمضى وثيقة","https://www.poetsgate.com/ViewPoem.aspx?id=164593",""],[5704,"على قدر الِْبِغَا يأتي العذابُ...","https://www.poetsgate.com/ViewPoem.aspx?id=204266",""],[5739,"عشرة جواهر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131710",""],[5747,"شوق شما","https://www.poetsgate.com/ViewPoem.aspx?id=61618",""],[5770,"كم في الموت من عجبِ","https://www.poetsgate.com/ViewPoem.aspx?id=178685",""],[5790,"ألا واقف في باب مولاه واصلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=111964",""],[5848,"سرحان عبدالصبور","https://www.poetsgate.com/ViewPoem.aspx?id=53460",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5956,"الحمد لله حمداً لا يفارقني","https://www.poetsgate.com/ViewPoem.aspx?id=193794",""],[5956,"أخلاقه","https://www.poetsgate.com/ViewPoem.aspx?id=194553",""],[5956,"يا أبا ثابت أرجوك قل لسميةَ الحسناءا","https://www.poetsgate.com/ViewPoem.aspx?id=205164",""],[6052,"بستان جهدي","https://www.poetsgate.com/ViewPoem.aspx?id=50109",""],[6056,"ملتقى الخطين","https://www.poetsgate.com/ViewPoem.aspx?id=130529",""],[6093,"زُمُرُّدَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=188614",""],[6093,"أما المعلم كان خطا أحمرا","https://www.poetsgate.com/ViewPoem.aspx?id=201760",""],[6100,"قضية تيسير علوني","https://www.poetsgate.com/ViewPoem.aspx?id=52599",""],[2575,"فمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=24770",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[520,"هل تبلغان لبختيار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577537",""],[313,"ألا واشيب عيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=902&r=&rc=3",""],[243,"المساء الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68160&r=&rc=152",""],[6237,"لكل صابونة ليفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77876&r=&rc=18",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""]],"verses":[["أَلّا وَقى المَجدُ المُؤَثَّلُ رَبَّهُ","أَلّا زَوى المِقدارُ أَلّا حالا",0,"ل",2,0],["أَلا وِصالٌ سِوى طَيفٍ يُؤَرِّقُني","وَلا رَسائِلَ إِلّا البيضُ وَالأَسَلُ",1,"ل",1,0],["أَلا وَاستَزيديها هَوىً وَتلَطُّفاً","وَقولي لَها في السِرِّ يا أُمَّ طالِبِ",2,"ب",1,0],["الأَوَّلينَ إِلى الوَغى","وَالآخِرينَ إِلى الغَنائِم",3,"م",1,0],["أَلّا وَقَد حانَ صُبحُ البَينِ صَبَّحَنا","حَينٌ فَقامَ بِنا لِلحَينِ ناعينا",4,"ن",2,0],["أَلا وَقَدْ بَلَغَتْ فِي الخَافِقِينَ بِهِ","مَكَانَةً لَمْ تَكُنْ مِنْهَا بِحُسْبَانِ",5,"ن",1,0],["إِلّا وَهُم شُرَكاءٌ في دِمائِهُمُ","كَما تَشارَكَ أَيسارٌ عَلى جُزُرِ",6,"ر",1,0],["ألا وَرْيَ في زند الزمان فنهتدي","بسقط ضئيل من سقيط شراره",7,"ر",2,0],["الأوفياءُ إذا ما معشرٌ نَكَثُوا","والجاعلون الرضا للَّه والغضبا",8,"ب",2,0],["ألا وعلى أشياعه مثل لَعْنَةٍ","رماهُ بها داعٍ عليه وأوْكَدُ",9,"د",1,0],["ألا واجعلْه تطفيلاً","ذليق الحد نفّاذا",10,"ذ",2,0],["ألا وأبيكِ ابنةَ العامري","ي لا يدعي القوم أني أفر",11,"ر",1,0],["إلّا وهم شركاءُ في مُتعاته","فمَن السليمُ من الشريك الأشْكَس",12,"س",1,0],["ألا وازدرع ماجداً مدحة","فإنك حاصد ما تزدرع",13,"ع",1,0],["ألا واستجيري الله لي إنَّ جارهُ","بمَنْجىً بعيدٍ من ممرِّ القواصمِ",14,"م",1,0],["أَلا وَأَبيكَ لَو كَاليَومَ أَمري","وَمَن لَكَ بِالتَدَبُّرِ في الأُمورِ",15,"ر",1,0],["أَلأَوبُ أَوبُ نَعائِمٍ قَطَرِيَّةٍ","وَالأَلُّ أَلُّ نَحائِصٍ حُقبِ",16,"ب",1,0],["الأَوحَديّ أَبي الجَيشِ الَّذي ظَفَرَت","مِنهُ بِأَنفَسِ عِلقٍ في الأَنامِ يَدي",17,"د",2,0],["الاولون ابتدؤا","والاخرون تمموا",18,"م",3,0],["إلّا وأنتَ على سَراةِ طِمِرَّةٍ","كالسِّيْدِ وقعُ جِرائِها متتابِعُ",19,"ع",1,0],["أَلا وَاِستَزيريها إِلَينا تَطَلُّعاً","وَقولي لَها في السِرِّ يا أُمَّ طالِبِ",20,"ب",1,0],["إِلّا وَلِيَّكَ فَاِعتَبِدهُ بِشاحِجٍ","لِطَريقِهِ لَم يَحوِهِ شَطَناهُ",21,"ا",2,0],["أَلا وَأَراكَ تَبذُلُ يا زَماني","لي الدُنيا وَتَسرِعُ بِاِستِلابي",22,"ب",2,0],["أَلا وَلَقَلَّ ما تَلقى شَجِيّاً","يَضيعُ صَجاهُ إِلّا بِالتَأَسّي",23,"س",2,0],["أَلا وَإِذا وُدِّعتَ تَوديعَ هالِكٍ","فَآخِرُ يَومٍ مِنكَ يَومُ تُوَدَّعُ",24,"ع",1,0],["أَلا وَكَما شَيَّعتَ يَوماً جَنائِزاً","فَأَنتَ كَما شَيَّعتَهُم سَتُشَيَّعُ",24,"ع",1,0],["ألا وفيّ ألا معين","في مدلهم بلا صباح",25,"ح",1,0],["الا وانجديني إنّني قَلَّ مُنجدي","بدمعٍ كريمٍ ما يُخيَّبُ زائلُهْ..",26,"ل",2,0],["أَلا وَتَهنَأ موسِماً لِوُفودِهِ","لَقَد كادَ قَبلَ الوَقتِ نَحوَك يَسبِقُ",27,"ق",1,0],["إِلّا وَداعي حُبِّهِ","يَثني إِلَيهِ عُنُقي",28,"ق",2,0],["إِلا وقد صَيَّرها هَباءَ","كالنَّارِ إذ وافَقتِ الآباءَ",29,"ا",2,0],["إلا وَضَعْتُ يَدي عَلى","قَلبي مَخافةَ أَنْ يَطيرْ",30,"ر",1,0],["الأولون ابتدؤوا","والآخرون تمَّموا",31,"م",3,0],["ألا وهو العدل الذي قد نفاه في","تعدده واللَه بالناس أعلم",32,"م",1,0],["أَلاَ وَقدْ عَلَّمْتَنِي","بِمَشْهَدٍ وَمُخْتَبَرْ",33,"ر",1,0],["ألا واجعله ممتثِلاً","محاسنَ وجهك الحَسَنِ",34,"ن",1,0],["الأوصياءُ القيِّمون على الورىْ","تركوا الورى بدمائهم مخضوبا",35,"ب",2,0],["إلا وقام يمين الله ساعده","والفتح والنصر والتأييد أعوان",36,"ن",1,0],["إلاَّ ونالَ بِجُودِهِ المَأْمُولا","وكفى بفضلٍ منه لي تنويلا",37,"ل",2,0],["الاولياء نجوم الارض ما برحوا","وانت شمس سناها ليس ينحجب",38,"ب",1,0],["ألا واستنى خمراً بعينك أنها","وإن أسقمت أشفى لدائي وأتجمع",39,"ع",1,0],["ألا وَجَبَ الفِرَارُ عَنِ الجُلَيلاَ","ولَو كانَت بِها سُعدَى ولَيلَى",40,"ل",2,1],["إلا وظلت مرهفات لحظه","مختلفات في القلوب تفرى",41,"ر",2,0],["إلا وقد علمت بأن الحربِ إن","من حسن صبرك إِنه يستغربُ",42,"ب",1,0],["الأوحد السلطان أكرمُ من سما","بشجاعةٍ ومهابةٍ وبباسٍ",43,"س",1,0],["إِلّا وَناداهُ السَلامُ عَلَيكَ بِال","لَفظِ الفَصيحِ كَناطِقٍ بِلِسانِ",44,"ن",1,0],["إِلّا وَقَرَّحَتِ الدُموعُ مَحاجِري","وَإِذا صَرَفتُ إِلى سِواهُم ناظِري",45,"ي",1,0],["إِلّا وَلي أَمامَها","شَفاعَةٌ مُوَطِّيَه",46,"ي",2,0],["الأوّل الآخر الذخر الغياث ومن","يلقى على الحوض وهو السابق الفرط",47,"ط",1,0],["الأوّل الاليّ في الوجود","في المشهد الغيبيّ والشهود",48,"د",1,0],["ألا وحد العلبي من","يسمو على السبع الطباق",49,"ق",1,0],["الا وحد المولي الأمير على الذي","مُنعت علاه وجوده لم يمنع",50,"ع",1,0],["آلاؤُهُ كَالرَّوْضِ حَيَّتْهُ الصَّبا","لا يَسْتَطيعُ لِنَشْرِهِ كِتْمانا",51,"ن",2,0],["إِلا وَعَوَّذناهُ عُجباً بِما","يَنشُرُهُ مِن طَيِّهِ بِالمَثان",52,"ن",1,0],["إلاَّ وَللّغة المقام المجتبى","جعلوا إلى هامِ السها معراجها",53,"ج",3,0],["إِلّا وَباستورَ لَهُ","في كُلِّ آوِنَةٍ مُساعِفِ",54,"ف",1,0],["الأوحد الفَرد الَّذي سَعدت بِهِ","هَذي الدِيار تَشرّفاً وَتَجمُّلا",55,"ل",2,0],["ألا وَهوَ مَحمود الشَمائل في المَلا","لَهُ كَرَم الأَخلاق وَالشِيَم الغُرُّ",56,"ر",1,0],["إلاّ وصادَ به حَمْداً وشاد به","مَجداً وزاد به عَدّاً مَساعيه",57,"ي",2,0],["آلاؤك الطّوقُ والنّاسُ الحَمامُ فهم","في حَلْيها وقَعوا في الأرضِ أم طاروا",58,"ر",3,0],["إلا وفي يَدِه عَزي","ماتٌ يحلُّ بِها الأُمورا",59,"ر",2,0],["إِلّا وَإِنَّكَ أَشهى","مِن الحَياة وَأَحلى",60,"ل",2,0],["إِلّا وَكِدتُ أَطير مِن","شَوق الدِيار مَع الرِياح",61,"ح",1,0],["الا وسابق قضائه قد جرى به وجال","وأنه بعث المنقذ لنا من ضلال",62,"ل",1,0],["ألا واعلما والعلم أشرف مكسب","وقد صرتما شمسين في أفق أهليه",63,"ي",2,0],["إلاّ وَقال الهَوى مَهْلاً سواكَ عَنَوْا","وكُلّما أَهْمَلوا حِفْظَ الهَوى وَوَنَوا",64,"ن",3,0],["إلا واعيا ءُ اشتباك القنا","لما سيوف القوم دما همَو",65,"و",1,0],["الأوحدُ الغدِّ الذي لم يختلفْ","في فضلِه ونَدى يديْهِ اثنانِ",66,"ن",1,0],["أُلاوِذُ عنها قلبَ مكتئِبٍ شَجٍّ","وتَحْفزُ نَحوي قلبَ ذي لَوْعةٍ صبِّ",67,"ب",1,0],["الا واعلام ليلى غير خافية","في كل ماثره تعلو ببرهان",68,"ن",1,0],["الاو فهم بين عبدٍ طالبٍ صلةً","وآخرٍ مالهُ رجسٌ وطُغيان",69,"ن",1,0],["إلاّ وفيه من الجفون سقامها","ومن الثغور سلافة الصهباء",70,"ا",2,0],["إِلّا وَنَجمُ قِياسِهِ","قَد غابَ في فَلَكِ الغُرورِ",71,"ر",1,0],["ألاّوجدتُ بردَه على حشاً","أبدى بهِ فراقُكمْ صُدوعا",72,"ع",2,0],["اِلاّ وذكَّرَهُ مِنَ","المحبوبِ في الليلِ ابتسامَه",73,"م",2,0],["اِلاّ وحيّاهُ محيّاهُ","بما روّى اُوامَه",73,"م",2,0],["الأول الفحل ذو النورين فاتحها","والآخر الخان من جدي إليه سبى",74,"ب",2,0],["ألا وإن مصابات الهوى ما رثت","لمن رمته خطوب والهوى أنق",75,"ق",1,0],["إلا وذب بجسمه","مل لتنين بلا توان",76,"ن",1,0],["ألا وهو الماء الذي في عيونهم","تدلى بنورٍ عم كل سريرة",77,"ه",1,0],["الأَولِياءُ لهم جاهٌ ومنزِلةٌ","ووجْهُهُمْ عند مولى الفَضلِ مَقبولُ",78,"ل",1,1],["الأَولِياءُ وإِنْ جلَّتْ مَراتِبُهُمْ","في رتبَةِ العبدِ والسَّاداتُ ساداتُ",79,"ت",1,0],["الأورع البر لا تخشى بوادره","إذا استخفت رجالاً سورة الغضب",80,"ب",1,0],["الأوحد الملك المفضل عن","ذوي الهمم الكبار",81,"ر",1,0],["ألا وإنِّي أُنْهِي","إليكَ شَوْقاً يُلْهي",82,"ي",1,0],["ألا وقد فسح الزّمانُ لنا","أَعطانَه وَاِستُغزِرَ الدَّرُّ",83,"ر",1,0],["ألا وهو الوجود الحق فرد","بلا كيف لديه ولا شبيه",84,"ي",2,0],["ألا والظهور البطون","ألا والبطون الظهور",85,"ر",1,0],["الأولى فيه الألذ الأطيبُ","تأتي لسري آية منصوصة",86,"ه",1,0],["إِلا وِشاحاً جالَ في ضامرٍ","مِن خَصرِهِ فوقَ النَّقا الرَّاسِي",87,"س",2,0],["أَلا وَالمَعالي وَبيضُ العَوالي","لَئِن ناصَبَ الحادِثِ القاهِرُ",88,"ر",1,0],["إلاَّ وأنت الملاذ المستجار به","وليس يقصر مافيكم من الهمم",89,"م",1,0],["أَلا ودعي يا نفوسُ المنى","فقد غار بعد الفقيد الأمل",90,"ل",1,0],["ألا واعجب المزمار توفى","إِلى أجل لكي تحيا المعارف",91,"ف",1,0],["إلا وغفرُ الزبانى","يلوحُ فيه العمود",92,"د",1,0],["إلا وردتمْ بحاراً طالما وَرِدَتْ","أَلا انتجعتمْ جَناباً طالما انْتِجُعَا",93,"ع",2,0],["ألا ويلهم يوم القيامة من لظى","وقد زفرت غيظا عليهم جهنم",94,"م",1,0],["الأَوحد الفَرد مَن قَلَّ النّظيرُ لَهُ","وَمَن بِهِ الآنَ حقَّ الفَخرُ لِلخَلفِ",95,"ف",1,0],["أَلا وَاِنعِ خَيرَ الناسِ حَيّاً وَمَيِّتاً","إِلى أَهلِ بَطحاءَي قُرَيشٍ وَيَثرِبِ",96,"ب",1,0],["ألا ولا أشتُمُ الزُّبيرَ ولا","طلحة إن قال قائلٌ غدَرا",97,"ر",2,0],["إلا ووجهتها إليك","بالافتقار إلى غنائك",98,"ك",1,0],["ألا وقفة بالتاج يوماً لهائم","ألا خطرةٌ من ذلك الرَّبْع تَخطر",99,"ر",1,0],["ألا ورد إلا حيث تهمي جفونه","ألا نارَ إلا حيث تذكي ضلوعه",100,"ع",2,0],["ألا وارحمن من عيل بالهجر صبره","وأقلقه شوق إليك مبرحُ",101,"ح",1,0],["ألا وهبتني لشخص تاجر","ولم أكن عند فقير فاجر",102,"ر",1,0],["إِلاَّ وهُم جَبَلُ الله الذي قَصُرت","عَنه الجبالُ فما ساوى به جَبَلُ",103,"ل",1,0],["الأوحدُ السلطان من ألقى له","هذا الزمانُ أزمّة التفويضِ",104,"ض",1,0],["الا واعبروا ببلاغ التقى","فتلك سبيل إلى من عبر",105,"ر",1,0],["الأَوحَد النَّدبَ الأَجَلَّ فَتى العُلا","الحازِمَ اليَقِظَ الهِزَبرَ الأَدرَعا",106,"ع",2,0],["أَلا وَاقطُف مِنَ الوَجَناتِ وَرداً","ولا تَسمَع لأربابِ المَلامِ",107,"م",1,0],["أَلا وَارضَع ثُديَّ الوَصلِ وَاغنَم","رَضاعاً جاءَ من بَعدِ الفِطامِ",107,"م",1,0],["إلاّ وأنت معلّم أبطاله","ضرب القوانتس والكميّ المعلمُ",108,"م",1,0],["إلاَّ وَسَالَتْ دِمَا الحَنَاجِرْ","مِنْ غَيْرِ طَعْنٍ وَلاَ جِرَاحْ",109,"ح",1,0],["الأول الأخير مبدأ الورى","الظاهر الباطن مسك الختام",110,"م",1,0],["الأوصل الأوفى الشفيع الرضا","الأصول الحامي الشجاع الهمام",110,"م",1,0],["إلاَّ وَبَكَتْ بِدَمْعِهَا الهَتَّانِ","عَيْنُ الأفُقِ",111,"ق",1,0],["أَلا وأَنا الأسيرُ أسير وجدٍ","وَكيفَ تجلّدي وأنا الأسيرُ",112,"ر",1,0],["إِلَّا وَساويسَ هَيانِيمِ الهَنَمْ","لا وَقَعٌ في نَعْلِهِ وَلا عَسَمْ",113,"م",1,0],["إلا وقد خفقت على روس الملا","والجمع راية فضله المتأثلِ",114,"ل",1,0],["الا واظهر شاهدا في علمه","ينبي بسر مراتب الاعمال",115,"ل",1,0],["ألا وهيج مني الوجد وانتعشت","روحي إلى قربهم وانزاح اكدار",116,"ر",1,0],["الا وابدا حكمة","تعرب عن حال المطيع",117,"ع",1,0],["الا واجرى من عيوني دما","حزنا على ما مر في الغابرين",118,"ن",1,0],["أَلّا وَجَدتَ الوَجدَ فيهِ لَذّةٌ","أَلّا رَأَيت السُقمَ خَيرَ لِباسِ",119,"س",1,0],["الاولى والبعد كلوا","كيف لا كيف وكيفا",120,"ف",2,0],["الأول الآخر الفرد المهيمن لم","يعزب ولم يذكر قرب ولا بعد",121,"د",1,0],["إلا وإما افتح وحتى لمّا","لعلّ حاشا وكانّ إذ ما",122,"م",2,0],["ألا ورعى دهراً تقضَّى بجلِّقٍ","ولولا الهوى ما قلت يوماً لها رعى",123,"ع",2,0],["الأول المحي المميت الآخر","سبحانه النور البديع الظاهر",124,"ر",1,0],["ألا وَلَهُ فِي مِسطَحٍ شَرُّ إسوَةٍ","غَدَاةَ ازدَرَى جَهلاً بِفَضلِ عَتِيقِ",125,"ق",1,0],["ألاَ وصلتَ محبًّا إن تصلهُ يعِش","بالوصل منك وإن تهجُرهُ لم يَعِش",126,"ش",1,0],["إلا وأرداه رشقٌ","أو دعاء يقرّب الآجالا",127,"ل",2,0],["ألا ويل الفرات ولا استهلت","على جنبيه بارقة رعود",128,"د",1,0],["إلاَّ وللمصطفى أبصرتَ ما لهما","يوم الرهان من الإيرادِ والصدر",129,"ر",1,0],["ألا وقتك حشا العافين صائبةً","ولا وقاءً إذا رامي القضاء رمى",130,"م",2,0],["إلا وقال سريعاً","هذا بديع الجمال",131,"ل",1,0],["ألا ويح هذا الليل في كل ساعة","حكى منه يوم البعث بل مثله ألفا",132,"ف",2,1],["ألا وَدِّعا أرضَ الحُمَيِّمِ وابكيا","معاهِدَ منّا كنَّ قدماً أواهِلا",133,"ل",2,1],["ألا واغنما إنها ساعة","قليلاً بها عشتما أو كثيرا",134,"ر",2,0],["أَلا واشعر بما يشعر","فقد أَمسيت بالمشعر",135,"ر",1,0],["إِلّا وَقَد كَشَرَ الظَلامُ لِوَجهِهِ","وَأَبانَ عَن أَنيابِهِ وَنَوائِبِه",136,"ب",2,0],["ألا والذي لا يعبد العبد غيره","ولا يتناسى فضله الحازم الحر",137,"ر",1,1],["أَلاوَذتُمُ حَتى إِذا ما أَمِنتُمُ","تَعاوَرتُمُ سَجعاً كَسَجعِ الهَداهِدِ",138,"د",1,0],["ألا واصل غرامك وابك شوقا","إلى ماء العيون بما العيون",139,"ن",1,0],["إلا وكنت بذاك أول آخذ","متتبع ما يرتضيه ويؤثر",140,"ر",1,0],["آلاؤه ليس بها ارتياب","يضلّ في إحصائها الحساب",141,"ب",1,0],["الا ودون غنائه يشدو لبنا","يوم الرحيل فعلت ما لم أفعل",142,"ل",1,0],["إلا وَخاصم فيه قَل","بي كُلَّ عذالي وَلاحى",143,"ح",2,0],["ألا وإني منهم إن وجدتُ إلى","هذا سبيلاً ولي في العجز نيّاتُ",144,"ت",1,0],["ألا ورغيف أسيوط أُخَيّ ولو أتى","إليّ بلا أُدمٍ به أنا قانع",145,"ع",1,0],["أَلا واغسلوا من كلِّ حِقْدٍ قلوبَكم","عليكم فَداءُ الحِقْدِ أَجْبَثُ داءِ",146,"ا",2,0],["ألا ولهُ كم غارةٍ إِثرَ غارةٍ","به اصطلمَ الأعداء من قبَّةِ الصَّرْحِ",147,"ح",1,0],["ألا وإِنِّي بحمدِ الله لستُ كمَنْ","في الحبِّ أصبحَ بالآثامِ متَّهَما",148,"م",2,0],["ألا وهواكَ يا أقصى مُناي","ويا خلاً عليهِ الصَّبُّ يُحسدْ",149,"د",1,0],["ألا ويح الليالي السود كم قد","دعتني لل