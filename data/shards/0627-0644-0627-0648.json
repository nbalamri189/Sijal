{"poems":[[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[55,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem26543.html","الطويل"],[71,"يا ابن الكرام الأولين","https://www.aldiwan.net/poem3980.html","مجزوء الكامل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[54,"تأسفت جارتي لما رأت زوري","https://www.aldiwan.net/poem27564.html","البسيط"],[88,"هو الدهر لم يترك مشن غواره","https://www.aldiwan.net/poem45014.html","الطويل"],[51,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[51,"تجرد من غمدين سيف مهند","https://www.aldiwan.net/poem61940.html","الطويل"],[51,"إذا حاولت تطفيلا","https://www.aldiwan.net/poem61986.html","الهزج"],[51,"يقول وقد سددوا نحوه","https://www.aldiwan.net/poem64056.html","المتقارب"],[51,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[14,"أرقت وصحبتي بمضيق عمق","https://www.aldiwan.net/poem38306.html","الوافر"],[38,"طال العشاء ونحن بالهضب","https://www.aldiwan.net/poem7686.html","الكامل"],[78,"لله ما خلد الأمحاض في خلدي","https://www.aldiwan.net/poem14279.html","البسيط"],[89,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[45,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem11438.html","الطويل"],[45,"ربع خلا من بدره مغناه","https://www.aldiwan.net/poem66856.html","الكامل"],[49,"لدوا للموت وابنوا للخراب","https://www.aldiwan.net/poem10340.html","الوافر"],[49,"نسيت منيتي وخدعت نفسي","https://www.aldiwan.net/poem62121.html","الوافر"],[49,"لعمري لقد نوديت لو كنت تسمع","https://www.aldiwan.net/poem62151.html","البسيط"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[107,"قفي ساعة يفديك قولي وقائلة","https://www.aldiwan.net/poem69426.html","عموديه"],[81,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[48,"يا عمرو من لم يختنق","https://www.aldiwan.net/poem64444.html","مجزوء الرجز"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"يا مقلة الرشإ الغري","https://www.aldiwan.net/poem39329.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85793","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24724","الرمل"],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[116,"لك الاضافات بالاسرار والنسب","https://www.aldiwan.net/poem41224.html","عموديه"],[121,"ألا ليت شعري هل لمافات مرجع","https://www.aldiwan.net/poem49309.html","الطويل"],[133,"ألا وجب الفرار عن الجليلا","https://www.aldiwan.net/poem54773.html","الوافر"],[161,"ما عن سرب الضبيات العفر","https://www.aldiwan.net/poem58722.html","الرجز"],[161,"يا أيها الملك الذي لا يغلب","https://www.aldiwan.net/poem58818.html","الكامل"],[161,"خطرت بقد أهيف مياس","https://www.aldiwan.net/poem58852.html","الكامل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"هاتيك دارهم رويدك بالسرا","https://www.aldiwan.net/poem14862.html","الكامل"],[236,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[260,"يا من يغيث الورى من بعد ما قنطوا","https://www.aldiwan.net/poem35529.html","البسيط"],[260,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[262,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[262,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[276,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[283,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[299,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[321,"كانت دمنهور لنا","https://www.aldiwan.net/poem61672.html","مجزوء الكامل"],[354,"المجد كبر بالسرور وهللا","https://www.aldiwan.net/poem39589.html","الكامل"],[354,"بقدر النهى بين الورى يشرف القدر","https://www.aldiwan.net/poem40345.html","الطويل"],[365,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[365,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[372,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[381,"يا من جفاني وملا","https://www.aldiwan.net/poem48749.html","المجتث"],[381,"أنا والحمام مع الصباح","https://www.aldiwan.net/poem48789.html","مجزوء الكامل"],[392,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[404,"أجزتكما يا أهل ودي روايتي","https://www.aldiwan.net/poem33356.html","الطويل"],[410,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[430,"قوم لهم حسن الوفا شيمة","https://www.aldiwan.net/poem41416.html","السريع"],[433,"أنا من جوارك في أعز مكان","https://www.aldiwan.net/poem12752.html","الكامل"],[440,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[444,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[454,"تبارك الله هل كافور فنان","https://www.aldiwan.net/poem61601.html","البسيط"],[465,"اصمى بسهم المقلة النجلاء","https://www.aldiwan.net/poem3631.html","عموديه"],[469,"صيد السرور أجل من المعقول","https://www.aldiwan.net/poem60006.html","مجزوء الكامل"],[478,"حن فأجرى للنوى دموعا","https://www.aldiwan.net/poem15204.html","السريع"],[478,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[480,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[483,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[483,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[501,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[501,"الأولياء لهم جاه ومنزلة","https://www.aldiwan.net/poem37818.html","البسيط"],[501,"لنا بنفي شؤون الغير إثبات","https://www.aldiwan.net/poem38062.html","البسيط"],[516,"ما كل سجع بمعدود من الخطب","https://www.aldiwan.net/poem12020.html","البسيط"],[516,"هل تبلغن لبختيار","https://www.aldiwan.net/poem12133.html","مجزوء الكامل"],[530,"مولاي ذا الكرامه","https://www.aldiwan.net/poem37163.html","منهوك المنسرح"],[552,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[559,"أنا معنى عناني الحق فيه","https://www.aldiwan.net/poem33592.html","الوافر"],[559,"ثلاث عليها يدور","https://www.aldiwan.net/poem34506.html","مجزوء المتقارب"],[559,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"]],"verses":[["أَلّا وَقى المَجدُ المُؤَثَّلُ رَبَّهُ","أَلّا زَوى المِقدارُ أَلّا حالا",0,"ل",2,0],["أَلا وِصالٌ سِوى طَيفٍ يُؤَرِّقُني","وَلا رَسائِلَ إِلّا البيضُ وَالأَسَلُ",1,"ل",1,0],["أَلا وَاستَزيديها هَوىً وَتلَطُّفاً","وَقولي لَها في السِرِّ يا أُمَّ طالِبِ",2,"ب",1,0],["الأَوَّلينَ إِلى الوَغى","وَالآخِرينَ إِلى الغَنائِم",3,"م",1,0],["أَلّا وَقَد حانَ صُبحُ البَينِ صَبَّحَنا","حَينٌ فَقامَ بِنا لِلحَينِ ناعينا",4,"ن",2,0],["أَلا وَقَدْ بَلَغَتْ فِي الخَافِقِينَ بِهِ","مَكَانَةً لَمْ تَكُنْ مِنْهَا بِحُسْبَانِ",5,"ن",1,0],["إِلّا وَهُم شُرَكاءٌ في دِمائِهُمُ","كَما تَشارَكَ أَيسارٌ عَلى جُزُرِ",6,"ر",1,0],["ألا وَرْيَ في زند الزمان فنهتدي","بسقط ضئيل من سقيط شراره",7,"ر",2,0],["الأوفياءُ إذا ما معشرٌ نَكَثُوا","والجاعلون الرضا للَّه والغضبا",8,"ب",2,0],["ألا وعلى أشياعه مثل لَعْنَةٍ","رماهُ بها داعٍ عليه وأوْكَدُ",9,"د",1,0],["ألا واجعلْه تطفيلاً","ذليق الحد نفّاذا",10,"ذ",2,0],["ألا وأبيكِ ابنةَ العامري","ي لا يدعي القوم أني أفر",11,"ر",1,0],["إلّا وهم شركاءُ في مُتعاته","فمَن السليمُ من الشريك الأشْكَس",12,"س",1,0],["ألا وازدرع ماجداً مدحة","فإنك حاصد ما تزدرع",13,"ع",1,0],["ألا واستجيري الله لي إنَّ جارهُ","بمَنْجىً بعيدٍ من ممرِّ القواصمِ",14,"م",1,0],["أَلا وَأَبيكَ لَو كَاليَومَ أَمري","وَمَن لَكَ بِالتَدَبُّرِ في الأُمورِ",15,"ر",1,0],["أَلأَوبُ أَوبُ نَعائِمٍ قَطَرِيَّةٍ","وَالأَلُّ أَلُّ نَحائِصٍ حُقبِ",16,"ب",1,0],["الأَوحَديّ أَبي الجَيشِ الَّذي ظَفَرَت","مِنهُ بِأَنفَسِ عِلقٍ في الأَنامِ يَدي",17,"د",2,0],["الاولون ابتدؤا","والاخرون تمموا",18,"م",3,0],["إلّا وأنتَ على سَراةِ طِمِرَّةٍ","كالسِّيْدِ وقعُ جِرائِها متتابِعُ",19,"ع",1,0],["أَلا وَاِستَزيريها إِلَينا تَطَلُّعاً","وَقولي لَها في السِرِّ يا أُمَّ طالِبِ",20,"ب",1,0],["إِلّا وَلِيَّكَ فَاِعتَبِدهُ بِشاحِجٍ","لِطَريقِهِ لَم يَحوِهِ شَطَناهُ",21,"ا",2,0],["أَلا وَأَراكَ تَبذُلُ يا زَماني","لي الدُنيا وَتَسرِعُ بِاِستِلابي",22,"ب",2,0],["أَلا وَلَقَلَّ ما تَلقى شَجِيّاً","يَضيعُ صَجاهُ إِلّا بِالتَأَسّي",23,"س",2,0],["أَلا وَإِذا وُدِّعتَ تَوديعَ هالِكٍ","فَآخِرُ يَومٍ مِنكَ يَومُ تُوَدَّعُ",24,"ع",1,0],["أَلا وَكَما شَيَّعتَ يَوماً جَنائِزاً","فَأَنتَ كَما شَيَّعتَهُم سَتُشَيَّعُ",24,"ع",1,0],["ألا وفيّ ألا معين","في مدلهم بلا صباح",25,"ح",1,0],["الا وانجديني إنّني قَلَّ مُنجدي","بدمعٍ كريمٍ ما يُخيَّبُ زائلُهْ..",26,"ل",2,0],["أَلا وَتَهنَأ موسِماً لِوُفودِهِ","لَقَد كادَ قَبلَ الوَقتِ نَحوَك يَسبِقُ",27,"ق",1,0],["إِلّا وَداعي حُبِّهِ","يَثني إِلَيهِ عُنُقي",28,"ق",2,0],["إِلا وقد صَيَّرها هَباءَ","كالنَّارِ إذ وافَقتِ الآباءَ",29,"ا",2,0],["إلا وَضَعْتُ يَدي عَلى","قَلبي مَخافةَ أَنْ يَطيرْ",30,"ر",1,0],["الأولون ابتدؤوا","والآخرون تمَّموا",31,"م",3,0],["ألا وهو العدل الذي قد نفاه في","تعدده واللَه بالناس أعلم",32,"م",1,0],["أَلاَ وَقدْ عَلَّمْتَنِي","بِمَشْهَدٍ وَمُخْتَبَرْ",33,"ر",1,0],["ألا واجعله ممتثِلاً","محاسنَ وجهك الحَسَنِ",34,"ن",1,0],["الأوصياءُ القيِّمون على الورىْ","تركوا الورى بدمائهم مخضوبا",35,"ب",2,0],["إلاَّ ونالَ بِجُودِهِ المَأْمُولا","وكفى بفضلٍ منه لي تنويلا",36,"ل",2,0],["الاولياء نجوم الارض ما برحوا","وانت شمس سناها ليس ينحجب",37,"ب",1,0],["ألا واستنى خمراً بعينك أنها","وإن أسقمت أشفى لدائي وأتجمع",38,"ع",1,0],["ألا وَجَبَ الفِرَارُ عَنِ الجُلَيلاَ","ولَو كانَت بِها سُعدَى ولَيلَى",39,"ل",2,1],["إلا وظلت مرهفات لحظه","مختلفات في القلوب تفرى",40,"ر",2,0],["إلا وقد علمت بأن الحربِ إن","من حسن صبرك إِنه يستغربُ",41,"ب",1,0],["الأوحد السلطان أكرمُ من سما","بشجاعةٍ ومهابةٍ وبباسٍ",42,"س",1,0],["إِلّا وَناداهُ السَلامُ عَلَيكَ بِال","لَفظِ الفَصيحِ كَناطِقٍ بِلِسانِ",43,"ن",1,0],["إِلّا وَقَرَّحَتِ الدُموعُ مَحاجِري","وَإِذا صَرَفتُ إِلى سِواهُم ناظِري",44,"ي",1,0],["إِلّا وَلي أَمامَها","شَفاعَةٌ مُوَطِّيَه",45,"ي",2,0],["الأوّل الآخر الذخر الغياث ومن","يلقى على الحوض وهو السابق الفرط",46,"ط",1,0],["الأوّل الاليّ في الوجود","في المشهد الغيبيّ والشهود",47,"د",1,0],["ألا وحد العلبي من","يسمو على السبع الطباق",48,"ق",1,0],["الا وحد المولي الأمير على الذي","مُنعت علاه وجوده لم يمنع",49,"ع",1,0],["آلاؤُهُ كَالرَّوْضِ حَيَّتْهُ الصَّبا","لا يَسْتَطيعُ لِنَشْرِهِ كِتْمانا",50,"ن",2,0],["إِلا وَعَوَّذناهُ عُجباً بِما","يَنشُرُهُ مِن طَيِّهِ بِالمَثان",51,"ن",1,0],["إلاَّ وَللّغة المقام المجتبى","جعلوا إلى هامِ السها معراجها",52,"ج",3,0],["إِلّا وَباستورَ لَهُ","في كُلِّ آوِنَةٍ مُساعِفِ",53,"ف",1,0],["الأوحد الفَرد الَّذي سَعدت بِهِ","هَذي الدِيار تَشرّفاً وَتَجمُّلا",54,"ل",2,0],["ألا وَهوَ مَحمود الشَمائل في المَلا","لَهُ كَرَم الأَخلاق وَالشِيَم الغُرُّ",55,"ر",1,0],["إلاّ وصادَ به حَمْداً وشاد به","مَجداً وزاد به عَدّاً مَساعيه",56,"ي",2,0],["آلاؤك الطّوقُ والنّاسُ الحَمامُ فهم","في حَلْيها وقَعوا في الأرضِ أم طاروا",57,"ر",3,0],["إلا وفي يَدِه عَزي","ماتٌ يحلُّ بِها الأُمورا",58,"ر",2,0],["إِلّا وَإِنَّكَ أَشهى","مِن الحَياة وَأَحلى",59,"ل",2,0],["إِلّا وَكِدتُ أَطير مِن","شَوق الدِيار مَع الرِياح",60,"ح",1,0],["الا وسابق قضائه قد جرى به وجال","وأنه بعث المنقذ لنا من ضلال",61,"ل",1,0],["ألا واعلما والعلم أشرف مكسب","وقد صرتما شمسين في أفق أهليه",62,"ي",2,0],["إلاّ وَقال الهَوى مَهْلاً سواكَ عَنَوْا","وكُلّما أَهْمَلوا حِفْظَ الهَوى وَوَنَوا",63,"ن",3,0],["إلا واعيا ءُ اشتباك القنا","لما سيوف القوم دما همَو",64,"و",1,0],["الأوحدُ الغدِّ الذي لم يختلفْ","في فضلِه ونَدى يديْهِ اثنانِ",65,"ن",1,0],["أُلاوِذُ عنها قلبَ مكتئِبٍ شَجٍّ","وتَحْفزُ نَحوي قلبَ ذي لَوْعةٍ صبِّ",66,"ب",1,0],["الا واعلام ليلى غير خافية","في كل ماثره تعلو ببرهان",67,"ن",1,0],["الاو فهم بين عبدٍ طالبٍ صلةً","وآخرٍ مالهُ رجسٌ وطُغيان",68,"ن",1,0],["إلاّ وفيه من الجفون سقامها","ومن الثغور سلافة الصهباء",69,"ا",2,0],["إِلّا وَنَجمُ قِياسِهِ","قَد غابَ في فَلَكِ الغُرورِ",70,"ر",1,0],["ألاّوجدتُ بردَه على حشاً","أبدى بهِ فراقُكمْ صُدوعا",71,"ع",2,0],["اِلاّ وذكَّرَهُ مِنَ","المحبوبِ في الليلِ ابتسامَه",72,"م",2,0],["اِلاّ وحيّاهُ محيّاهُ","بما روّى اُوامَه",72,"م",2,0],["الأول الفحل ذو النورين فاتحها","والآخر الخان من جدي إليه سبى",73,"ب",2,0],["ألا وإن مصابات الهوى ما رثت","لمن رمته خطوب والهوى أنق",74,"ق",1,0],["إلا وذب بجسمه","مل لتنين بلا توان",75,"ن",1,0],["ألا وهو الماء الذي في عيونهم","تدلى بنورٍ عم كل سريرة",76,"ه",1,0],["الأَولِياءُ لهم جاهٌ ومنزِلةٌ","ووجْهُهُمْ عند مولى الفَضلِ مَقبولُ",77,"ل",1,1],["الأَولِياءُ وإِنْ جلَّتْ مَراتِبُهُمْ","في رتبَةِ العبدِ والسَّاداتُ ساداتُ",78,"ت",1,0],["الأورع البر لا تخشى بوادره","إذا استخفت رجالاً سورة الغضب",79,"ب",1,0],["الأوحد الملك المفضل عن","ذوي الهمم الكبار",80,"ر",1,0],["ألا وإنِّي أُنْهِي","إليكَ شَوْقاً يُلْهي",81,"ي",1,0],["ألا وقد فسح الزّمانُ لنا","أَعطانَه وَاِستُغزِرَ الدَّرُّ",82,"ر",1,0],["ألا وهو الوجود الحق فرد","بلا كيف لديه ولا شبيه",83,"ي",2,0],["ألا والظهور البطون","ألا والبطون الظهور",84,"ر",1,0],["الأولى فيه الألذ الأطيبُ","تأتي لسري آية منصوصة",85,"ه",1,0]]}