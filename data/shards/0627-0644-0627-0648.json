مرددا","لأكرم رسل اللَه طرّاً وأسعدا",175,"د",2,1],["إلا وطه المصطفى عبده","حبيبه من خلقه الأكمل",176,"ل",1,0],["ألا واعتراني منذ فارقت حيكم","همومٌ لها حشو الحشاء سعير",177,"ر",1,0],["ألا والحقا كأساً بكأس تتابعاً","وان نم من اولي الكؤوس بي السكر",178,"ر",1,0],["ألا وردةٌ في الروض تجلو نواظري","فأنى أدرت الطرفَ يُصدم بالشوك",179,"ك",1,0],["إلّا وأحداقالورى","بما حواهُ محدقَه",180,"ق",2,0],["آلاؤه شملت كل البقاع فلا","يخلو من الحمد قاصيها ودانيها",181,"ي",3,0],["إلا: وِدّي بصحبةٍ بالحقّ أدراها","عذراً من البيض ما حدٍّ رمس فيها",182,"ي",3,0],["أَلا وهو مُنميها بشمس ذَكائِهِ","وَغيث نداهُ وهوَ بالفضل ماطرُ",183,"ر",1,0],["ألا وإنّي زاحفٌ بأسرتي","وإن همُ قلّوا وقلّت عُدّتي",184,"ي",1,0],["ألا وإنّي قد أذنتُ لكُمُ","فانطلقوا ولا عهد لي عليكُمُ",185,"م",1,0],["إلا وخيال ملاحيتي","يحتل اللوح ويدفعه",186,"ع",2,0],["الأول القديم وهو الأزلى","ولم يزل من قبل كل أول",187,"ل",1,0],["إلا وأبصرت كل عامرة","داري وكل الأنام إخواني",188,"ي",1,0],["ألا ويح الفؤاد من الغمومِ","ومن زمني وديوان العمومِ",189,"م",1,1],["آلاؤُكَ الغرّ الحسان تمنّعت","مِن أَن يُقال لبعضها مَحصورُ",190,"ر",1,0],["الّا وَكادَ فُؤادي اِن يَذوبَ اسىً","وَاوقَد الشَوقُ منّي حرَّ بِلبالي",191,"ي",1,0],["ألا ودّع فؤاداً عن قريب","يودع منكم عشق الجمال",192,"ل",1,0],["الأَوَّلُ المُبدي بِغَيرِ بِدايَةٍ","وَالآخيرُ المُفني وَلَيسَ بِفانِ",193,"ن",1,0],["إلاَّ ولائي لبني هاشمِ","آل النبي العترة الطاهره",194,"ه",1,0],["إِلا وحيدُ الآبِ مُحيِي الميتِ وال","عَظمِ الرميمِ المستهيضِ الهاري",195,"ر",2,0],["آلاؤها خفقت بها راياتها","ولواؤها في النصر خير لواء",196,"ا",2,0],["الاول المفعول اعني المطلقا","كتُبتُ توبةً هدتني للتقى",197,"ق",2,0],["إِلا وَجُدتُ بِمدمعٍ","مثل السَحاب الماطر",198,"ر",1,0],["إِلا وَذاك لها نطقٌ تردّده","وَذاك منها يُرى في زيّ نشوان",199,"ن",1,0],["أَلا وَقفة تَرعى بِها حَق صحبتي","وَفي ودّك الصافي مضت بهجة العُمر",200,"ر",1,0],["ألا وادخر عزمًا يقودك شرخه","إلى الأوج فاحفظه لشوط مغيبِ",201,"ب",1,0],["إلا وددت بأن أراه فلا أرى","أفقاً يصد الطرف دون مداه",202,"ا",2,0],["ألا ولتفرق والداً عن وليده","فل