{"poems":[[63,"تحية الغيث منهلا سحائبه","https://www.aldiwan.net/poem51806.html","البسيط"],[93,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[139,"اليوم أوفت على خمس وعشرينا","https://www.aldiwan.net/poem49192.html","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143975","السريع"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142957","السريع"],[4771,"يَغرسُ وَرداً ناضِراً ناظري","https://www.poetsgate.com/ViewPoem.aspx?id=106574",""]],"verses":[["فلِمْ مَنعْتَ على الإحسانِ مُحسِنَه","ما نالَ من جاهِكَ المبذولِ خاطبُه",0,"ب",2,0],["فلم مثله للخير دنيا","ولم أر مثله فتحا مبينا",1,"ن",2,0],["فلمّ من شملها ما كان مفترقاً","وفكّ من أرضها ما كان مرهونا",2,"ن",2,0],["فلم منعت عقلك الشريفا","يا ذا النهي غذاءه اللطيفا",3,"ف",2,0],["فلم منعتم شفتي قطفها","والحل ان الزرع للزارع",4,"ع",1,0],["فلم منعتم شفتي قطفه","والحكم أن الزرع للزارع؟!",5,"ع",1,0],["فَلِم منعتم شفَتي قَطفَها","والحُكمُ أنَّ الزَّرعَ للزَّارعِ؟!",6,"ع",1,0]]}