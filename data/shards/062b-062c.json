{"poems":[[0,"ديمة هطلاء فيها وطف","https://www.aldiwan.net/poem76.html","الرمل"],[68,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[314,"فما رسم شجاني قد","https://www.aldiwan.net/poem50231.html","الهزج"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132225","المجتث"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126256","الكامل"],[5470,"جُوعَ الانتِظَارْ","https://www.poetsgate.com/ViewPoem.aspx?id=17456",""],[2110,"ثقل الملام وطالت الأبحاث","https://www.poetsgate.com/ViewPoem.aspx?id=156266",""],[5894,"ثبت الغرام وفي فؤادي يحدث","https://www.poetsgate.com/ViewPoem.aspx?id=131413",""]],"verses":[["ثَجَّ حَتّى ضاقَ عَن آذِيِّهِ","عَرضُ خَيمٍ فَخُفاءٍ فَيُسُر",0,"ر",1,0],["ثَجَّ الهَوى فَأَنا الغَريقُ بِلُجَّهِ","لَكِنَّني بِحِبالِكُم أَتَشَبَّثُ",1,"ث",1,0],["ثَجيجُ الرَعدِ ثَجّاجٍ","إِذا أَرخى نِطاقَيهِ",2,"ي",2,0],["ثجّ ووبلُ وسح","وكف وصاد وباء",3,"ا",2,0],["ثجت سحائب اعينى من هجرها","بدم على خدى المخدد يزفر",4,"ر",1,0],["ثَجَّتْ أعَاصِيرُ الجَوى","فِي قلبه والعَقلُ حَارْ",5,"ر",1,0],["ثجت بحار الدمع من جفني دما","لما لواك العاذل النباث",6,"ث",1,0],["ثجاج سرك في بنيك لقد سرى","فيهم لدى جدب السنين نغاث",6,"ث",1,0],["ثجبت دموعي مثل جود أبي العطا","المصري من في فضله نتحدث",7,"ث",1,0]]}