{"poems":[[53,"أجد بربات الحجال صدودها","https://www.aldiwan.net/poem61836.html","الطويل"],[53,"أيادي بني الجراح عندي كثيرة","https://www.aldiwan.net/poem64032.html","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56659","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76157","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204877","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204725","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132068","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54411","الكامل"],[4701,"ثلاثون عامًا تمرُّ الظباءْ","https://www.poetsgate.com/ViewPoem.aspx?id=45009",""],[4930,"جدِّدي عهد الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=213235",""],[4942,"مجد الحسين ع","https://www.poetsgate.com/ViewPoem.aspx?id=188838",""],[5081,"نَهْرُ الْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=190167",""],[5121,"قَلَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33498",""],[5121,"كأس الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=33579",""],[5277,"المقصورة النبوية","https://www.poetsgate.com/ViewPoem.aspx?id=187883",""],[5285,"سموم الأفاعي","https://www.poetsgate.com/ViewPoem.aspx?id=203536",""],[5295,"شذا القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=210634",""],[5295,"ميلاد الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=210856",""],[5324,"آن الأوان .","https://www.poetsgate.com/ViewPoem.aspx?id=207639",""],[5750,"مطرٌ على الرمقِ الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=214642",""],[5956,"بين الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=181865",""],[5956,"سأدخل للقبر قربك أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=192103",""],[6125,"سأزهدُ في الحياةِ وأزدريها","https://www.poetsgate.com/ViewPoem.aspx?id=212870",""],[6152,"جار الطير","https://www.poetsgate.com/ViewPoem.aspx?id=205855",""],[6167,"معركة الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85480&r=&rc=9",""]],"verses":[["سأزهدُ في الدنيا الدنية كاسمها","فلم يبق أيْمُ اللّه إلا زهيدُها",0,"د",3,0],["سأزجر عنه اللّوم من كل لائمٍ","حِفاظاً له ما دام لي عنه مَزجَر",1,"ر",1,0],["سأزجر عن هواك غداً فؤادي","ولا والله لست غداً بزاجر",2,"ر",1,0],["سَأَزهَدُ حَتى لا أَرى لي صاحِباً","وَأُنجِدُ حَتّى لا أُلاقيَ مُتهِما",3,"م",2,0],["سأزيد الحياة فيها لتنمو","فتطوف الجمال في أشكاله",4,"ل",2,0],["سأزداد كبرا عند تصغير جاهل","وأعذره في جهله غير حانق",5,"ق",1,0],["سأزجر قلباً رام في الحب سلوة","وأهجره إن لم يمت بكم عشقا",6,"ق",2,0],["سأزُمُّ نحوكَ للِّقاءِ قلائصاً","يا خيرَ من زُمّتْ إليه قلائصُ",7,"ص",1,0],["سأزرع في كل شبرٍ عراقًا","يرحِّب بالأهل والأصدقاء!!",8,"ا",2,0],["سأُزَينُ الأشعارَ فيكِ لتسعدي","وأتوهُ في بحرِ القصيدِ لتهتدي",9,"د",2,0],["سأزور مجدك يا حسين وسؤددَكْ","وأطوف قلبك كم فؤادي رددَكْ",10,"ك",1,1],["سَأَزْرَعُ فِي فُؤَادَيْنَا هَنَاءً","وَأَغْمُرُهُ بِمَاءِ الْحُبِّ غَمْرَا",11,"ر",2,0],["سَأُزَيِّنُ الصُّوَرَ الَّتِي سَكَنَتْ مَعِي","وَأُضِيِفُ نُورَ مَشَاعِلٍ بِبَدَائِلِي",12,"ل",2,0],["سأزرعُ وردَ الجمالِ بِقلبي","وأروي لأحْصِدَ قطفَ الصَّلوحِ",13,"ح",1,0],["سَاُزْجي الغَداةَ قَلوصي لَهُ","لَعلّي غداً أن أرى أحمدا",14,"د",2,0],["سأزرعُ في الروض للموتِ زهراً","لينموَ في القلبِ لونُ الغروبْ",15,"ب",1,0],["سأُزَخْرِفُ التّاريخَ فَوقَ جَبينِها","وبكفِّها أَهَبُ الزّمانَ هَدايا",16,"ا",3,0],["سأزيلُ عنْ ثغرِ الْفؤادِ لِجامَهُ","حتى يبوحَ بكلِّ شوقٍ خبَّأهْ",17,"ا",2,0],["سأزلزلُ الأرضَ الوطيّةَ تحتَكم","يامن بأوجاعِ الكرامِ تسببوا",18,"ب",3,0],["سأزفُّني بينَ الضَّبابِ مسافراً","وأشقُّ في صَدري بقايا أنهُري",19,"ر",2,0],["‏ ‏سأزيد إخلاصي لهنَّ ورحمتي","‏ ‏ بمحبة لا تعرف النُّقْصانا",20,"ن",2,0],["سأزرع إكليلَ آسٍ عليك","وطوق زهور من الياسَمينْ",21,"ن",1,0],["سأزهدُ في الحياةِ وأزدريها","وأقتحمُ الصِّعابَ فأمتطيها",22,"ي",3,1],["سأزرع من بقايا الحُلم وردا","شذاه يعم أفئدة الحيارى",23,"ر",2,1],["سأزورُ أودية التأسّي دارِعاً","وأبيتُ يمتشقُ الحسامَ حُطامي",24,"م",2,0]]}