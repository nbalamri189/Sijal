{"poems":[[55,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[32,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[32,"ألا حي الدار قفرا جنوبها","https://www.aldiwan.net/poem29610.html","الطويل"],[74,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[53,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[91,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[87,"يقولون رشدي مات","https://www.aldiwan.net/poem7790.html","الطويل"],[46,"راحتي في البكاء حتى أراكا","https://www.aldiwan.net/poem30144.html","الخفيف"],[71,"أرشف مبرد ريقه","https://www.aldiwan.net/poem28990.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199476","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[92,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[103,"جدّدي يا رشيدُ للحبّ عَهْدَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62414&r=&rc=6",""],[119,"صاح يمم ان رمت نيل الاماني","https://www.aldiwan.net/poem40476.html","عموديه"],[230,"أرشدي سلام مرحبا بك مرحبا","https://www.aldiwan.net/poem55126.html","الطويل"],[275,"مجلسها صمت وإيجاز","https://www.aldiwan.net/poem35256.html","السريع"],[290,"يا رئيس الخطابة ازددت قدرا","https://www.aldiwan.net/poem39413.html","الخفيف"],[369,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[409,"لاح عذار الحبيب يوما","https://www.aldiwan.net/poem33897.html","مخلع البسيط"],[415,"أتهم فيكم لائمي وأنجدا","https://www.aldiwan.net/poem32486.html","الرجز"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[457,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[457,"أرش لي جناح الحظ مولاي إنني","https://www.aldiwan.net/poem13786.html","الطويل"],[458,"أرشد الله أمة الإسلام","https://www.aldiwan.net/poem61362.html","الخفيف"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[484,"الله أكبر في ضريح واحد","https://www.aldiwan.net/poem37048.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138290",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48537","الرجز"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122378","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38939","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38981","المتدارك"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202078",""],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203788","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80206","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64782","الخفيف"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31563","المنسرح"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48954","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77738","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89539","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53059","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105067","السريع"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110613","الرمل"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111233","البسيط"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105352","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204652",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134196","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100818","الطويل"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115131","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62835","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62743","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66454","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117891","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131045",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131084",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103014","الوافر"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44669","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44636","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94330","الكامل"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143317","الخفيف"],[4691,"حافظ القرآن الماجن","https://www.poetsgate.com/ViewPoem.aspx?id=174368",""],[4815,"إرم البذار","https://www.poetsgate.com/ViewPoem.aspx?id=210463",""],[4830,"لُغةُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=214827",""],[4935,"بفضله أوجدني مولى المنن","https://www.poetsgate.com/ViewPoem.aspx?id=129320",""],[2365,"ذكرت شيب العذارين نوار","https://www.poetsgate.com/ViewPoem.aspx?id=200648",""],[5282,"نظرة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=214011",""],[5295,"إمامُ العشقِ","https://www.poetsgate.com/ViewPoem.aspx?id=163335",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5373,"بلاغة القرآن وإعجازه","https://www.poetsgate.com/ViewPoem.aspx?id=186008",""],[5401,"الشيطنه والشقاوه","https://www.poetsgate.com/ViewPoem.aspx?id=85139",""],[5408,"إليّ ولا أحد","https://www.poetsgate.com/ViewPoem.aspx?id=190738",""],[5452,"شّاي وشعر وسمر","https://www.poetsgate.com/ViewPoem.aspx?id=112999",""],[5528,"ضياع","https://www.poetsgate.com/ViewPoem.aspx?id=201145",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5847,"يمشي على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=1320",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[5567,"مدار الفراغ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81817&r=&rc=67",""],[6360,"صَهيلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87606&r=&rc=9",""]],"verses":[["أَرَشَّ فَوقَكَ نَجديٌّ يَمُدُّ لَهُ","نيلُ السَماءِ بِآذِيٍّ وَدُفّاعِ",0,"ع",1,0],["أَرَشِيدٌ وَهْوَ الطَّبِيبُ المُوَاسِي","وَهْوَ آسِي الضُّلُوعِ وَالأَوْصَالِ",1,"ل",1,0],["أَرَشَّت بِها عَيناكَ حَتّى كَأَنَّما","تَحُلّانِ مِن سَفح الدُموعِ بِها نَذرا",2,"ر",2,0],["أَرَشَّت لَها عَيناكَ دَمعاً كَأَنَّهُ","كُلى عَيّنٍ شَلشالُها وَصَبيبُها",3,"ب",3,0],["أرشّح ذا الخمائل مشمعلاّ","بها وأحيد عن ذات الوشاح",4,"ح",1,0],["أُرشِّحُ آمالاً طِوالاً وأجتني","جنى العيشِ في ظل ظليلٍ من النِّعمْ",5,"م",1,0],["أَرْشِفينا كما أريْتِ وأسمعْ","تِ ولا تتركي الهوى صديانا",6,"ن",2,0],["ارشدوني فقد ضللت سبيلي","بين طرد للحادثات وعكس",7,"س",1,0],["أرشدي لقد عشت الذي عشت سيدا","ولم تك عبد الجاه والأمر والمال",8,"ل",1,0],["أَرشِدَنّي إِلى رِضاكَ فَإِنّي","لَستُ أَدري ما حيلَتي في رِضاكا",9,"ك",2,0],["أرشف مبرَّدَ ريقِهِ","مِنْ ثعلبٍ إنْ صدَّ أَنكى",10,"ك",2,1],["أَرْشِدْ بِكُمْ مُسْتَطْلِعِينَ لِشَأْنِكُمْ","فِي الْغَرْبِ كُلَّ مَطَالعِ الأَنْوَارِ",11,"ر",1,0],["أَرْشِدْ بِرِفْقٍ تَارَة","وَتَارَةً بِمُزْدَجَرْ",12,"ر",1,0],["أرشي ابياتي على شجعانها","الزراعي دروبها بالأمنيات",13,"ت",1,0],["أرشيدٌ وأنت جنَّةُ خُلْدٍ","لو أتاح الإلهُ في الأرضِ خُلدا",14,"د",2,0],["أرشيدٌ دونَ المدائنِ تبقَى","مُسْتراضاً لكلِّ داءٍ ووِرْدا",14,"د",2,0],["أرشيدُ لا جُرْحٌ ولا إيلامُ","عاد الزمانُ وصحّتِ الأحلامُ",15,"م",1,1],["أرشيدُ يا بلدي ويا ملهَى الصبا","بيني وبين مَدَى الصبا أعوام",15,"م",1,0],["أرشيدُ فيكِ لُبانتي وصَبابتي","والصِّهْرُ والأخوالُ والأعمام",15,"م",1,0],["أرشيدُ هل في أن يبوحَ أخو الهوى","حَرَجٌ وهل في أن يَحِنَّ ملام",15,"م",1,0],["أرشيدُ مجدُكِ في القديمِ صحيفةٌ","بيضاءُ لا لبْسٌ ولا إبهَامُ",15,"م",1,0],["أرشيدُ لم نسمَعْ لصدرِك أَنّةً","للنّازلاتِ الدُّهْمِ وهي جِسام",15,"م",1,0],["أُرشحُ من لم يعرفِ الشعبُ باسمه","أباعدَ عنه لفّقوا وأجانبا",16,"ب",2,0],["أرشيدٌ دونَ المدائنِ تبقَى","مُسْتراضًا لكِّ داءٍ ووِرْدا",17,"د",2,0],["ارشدتنا الى الاله فقمنا","بمروط اليقين والايمان",18,"ن",1,0],["أَرُشدي سلامٌ مرحباً بكَ مرحباً","وَأَهلا بِصافي الروحِ وَالقَلبِ وَالقَصدِ",19,"د",1,1],["أرشِدهُ يا يسوعُ واغفر له","من أجلِنا جرحُكَ نزَّاز",20,"ز",1,0],["ارشدن زهرة الشبيبة وارسم","فوق ذا المنبر المشيد طغرا",21,"ر",2,0],["أُرشُوا ولا أُرشَى وتلك غَبينةٌ","تُمسى لها الأكبادُ ذاتَ صُدوع",22,"ع",1,0],["أرش بالدمع صحن خدي","ويكنس الحسن بالعذار",23,"ر",1,0],["أرشدَنِي بزعمه وما أرَى","سُلُوَّ قلبي عن هَواكمُ رَشَدَا",24,"د",2,0],["أرشفة من ريق من أحبُّه","فتنطفي جذوة وجد في الحشا",25,"ا",1,0],["أرشفتني كأسَ النعيم يديرها","بعْضي عليّ ألذّ من سنة الكرى",26,"ر",2,0],["أرِش لي جناحَ الحظّ مولاي إِنني","إِذا لمْ تَرشْهُ الدهرَ جَلْدٌ على الصَبْر",27,"ر",1,1],["أرشد الله أمة الإسلام","إن تدم في عبادة الأصنام",28,"م",1,1],["أرشفُ من فيه مكانَ اسمك لا","أحسَبني أرشفُ إلا الضَّرَبا",29,"ب",2,0],["أرشدتماه إلى الهدى وطريقه","فجنيتما منه مجاني الراشد",30,"د",1,0],["أرشدتنا بمواعظ وضحت كما","وضحت لعين المدلجين بدور",31,"ر",1,0],["أرشدت كالمصباح في المشكاة من","ضلوا فقالوا مرشد ورشيد",32,"د",1,0],["أرشده اللّه إلى المفيد","مباركاً في سعيه الحميد",33,"د",1,0],["ارشفها حتى إذا ما فرغت","جمعت بين القرط والخلاخل",34,"ل",1,0],["إِرشادُهُ وَفَضلُهُ المَشهورُ","وَهوَ بِهِ المَحمودُ والمشكورُ",35,"ر",1,0],["أَرشِدهُ كَإِرشادِ الخُلفا","خُلَفاءِ مُحمَّدنا الحُنَفا",36,"ف",2,0],["أَرشدَهُ اللَّه لأَهدى السُّبلِ","أَسعَدَه اللَّه بِنَيل السُؤلِ",37,"ل",1,0],["أرْشَدتُه إذْ تاهَ في","بَيداء مِحْنَتِهِ وضَلا",38,"ل",2,0],["أرشدتَ موكبها وصنت ذمارها","وجلوت غيهب ليلها المتجهم",39,"م",1,0],["أَرشف النَيلَ وَظَنّى أَنَّهُ","مِن نَدى لُبنانَ قَطرٌ مُستَفاد",40,"د",1,0],["أَرْشَفَتْنِيكَ غادةٌ","تَقْمُرُ الشمْسَ والقَمَرْ",41,"ر",1,0],["أَرْشُفُ رِيقاً عَذْبَ الَّلمى خَصِراً","كأَنَّ فِيهِ الضَّريبَ والضَّرَبا",42,"ب",2,0],["أَرشاداً بايعتُم أَم رَشادا","وخلعتُمُ نيراً أَمِ اْستبدادا",43,"د",2,1],["أَرشدت للإِرشاد يا رَشيد","فالمستفاد علمك المفيد",44,"د",1,0],["أَرشَدتَ جاهِلَهُم عِلماً وَمُحسِنَهُم","فَضلاً وَمُذنِبِهُم عَفواً عَن الزَلَلِ",45,"ل",1,0],["ارشد سواء فقد مثلته صنماً","ما ساءني أنني من جاهليته",46,"ت",2,0],["أرشف من ريقته خمرة","لم يعتصرها كف إنسان",47,"ن",1,0],["أرشد الركب الذي القرب نوى","وسما هام الثريا همما",48,"م",2,0],["ارشدن ذا عمه ابصرن ذا كمه","انطقن ذا بكم اسمعن ذا صمم",49,"م",1,0],["ارشفينها خالصاً وتارة","يمزجها من ريقه أعذب ما",50,"م",2,0],["أرشف ريقها ولو","أخرج في لعابها",51,"ب",3,0],["ارشد الناس للمكارم حتى","علم الجود والعطاء الكراما",52,"م",2,0],["ارشت جناحي بعد طول انكساره","وقد طاش سهم للزمان مصيب",53,"ب",1,0],["أرشدني إلى خيالكَ كيما","أتقاضاهُ موعِداً لي عليه",54,"ه",1,0],["أُرشِّحُها لمدحِ أبي شُجاعٍ","فتَقْصُرُ أو تُعارِكُ بالمَضيقِ",55,"ق",1,0],["أرشدْ إلى مَلكٍ يُعطي عطاءَكَ ذا","إنْ شِئْتَ أنْ استكِلَّ البينَ بالرِحَلِ",56,"ل",1,0],["أرشفتني ثغرها مية","فشفى تعليلها عللي",57,"ي",1,0],["أرشد الله شيعة ابن سعود","لاعتقاد الصواب كي لا تعيثا",58,"ث",2,1],["أرشدوا نشأكم الى طلب العلم","لينجو من الزمان الآتي",59,"ي",1,0],["أرشاد يا خير الخلائف في الورى","كن كالملوك الراشدين كبيرا",60,"ر",2,0],["أرشن النبال نبال الجفون","فقال الفؤاد هنا المصرع",61,"ع",1,0],["أرشنا نبل أقواس التصابى","فما أخطأت أفئدة الهموم",62,"م",1,0],["أَرشيد إِن وَضَعوكَ في كَفَن فَقَد","وَضَعوا الرَشادَ وَقُوةَ الإِيمان",63,"ن",1,0],["أَرشيد إِن الغَرس أَصبَحَ مُثمِراً","تَمَ بِالهَنا في جَنة الرُضوان",63,"ن",1,0],["إِرشف لَذيذ الخَمرِ","مِن الشِفاه الحُمرِ",64,"ر",1,0],["أرشدتنا بنصائح تجلي الصدا","وُيُسَرُّ منها المُرمَل المقهورُ",65,"ر",1,0],["أرشدوني بنظرةٍ","قد سئمنا التَعسُّفا",66,"ف",2,0],["أرشّ محبتي وصفاء نفسي","وعنواني المحبة والغناءُ",67,"ا",2,0],["ارشِدْ بأَهلِكَ عَقلَ طِفلٍ واعِدٍ","يَكبُرْ وعَقلُكَ في نُهاهُ مَعَ الفِكَرْ",68,"ر",1,0],["أرشِفُ الرّاحَ من شِفاهِ المِلاحِ","ليس اِلاّهُ بلسمٌ لجراحي",69,"ح",2,1],["أرشدني إلى صراط هديه","صراط أهل الذكر أرباب الفطن",70,"ن",1,0],["أرشد ا