{"poems":[[53,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[93,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[30,"ألا حي الدار قفرا جنوبها","https://www.aldiwan.net/poem29610.html","الطويل"],[72,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[89,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[85,"يقولون رشدي مات","https://www.aldiwan.net/poem7790.html","الطويل"],[44,"راحتي في البكاء حتى أراكا","https://www.aldiwan.net/poem30144.html","الخفيف"],[69,"أرشف مبرد ريقه","https://www.aldiwan.net/poem28990.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199476","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[101,"جدّدي يا رشيدُ للحبّ عَهْدَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62414&r=&rc=6",""],[116,"صاح يمم ان رمت نيل الاماني","https://www.aldiwan.net/poem40476.html","عموديه"],[226,"أرشدي سلام مرحبا بك مرحبا","https://www.aldiwan.net/poem55126.html","الطويل"],[271,"مجلسها صمت وإيجاز","https://www.aldiwan.net/poem35256.html","السريع"],[286,"يا رئيس الخطابة ازددت قدرا","https://www.aldiwan.net/poem39413.html","الخفيف"],[365,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[404,"لاح عذار الحبيب يوما","https://www.aldiwan.net/poem33897.html","مخلع البسيط"],[410,"أتهم فيكم لائمي وأنجدا","https://www.aldiwan.net/poem32486.html","الرجز"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[453,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[453,"أرش لي جناح الحظ مولاي إنني","https://www.aldiwan.net/poem13786.html","الطويل"],[454,"أرشد الله أمة الإسلام","https://www.aldiwan.net/poem61362.html","الخفيف"],[459,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[480,"الله أكبر في ضريح واحد","https://www.aldiwan.net/poem37048.html","الكامل"]],"verses":[["أَرَشَّ فَوقَكَ نَجديٌّ يَمُدُّ لَهُ","نيلُ السَماءِ بِآذِيٍّ وَدُفّاعِ",0,"ع",1,0],["أَرَشِيدٌ وَهْوَ الطَّبِيبُ المُوَاسِي","وَهْوَ آسِي الضُّلُوعِ وَالأَوْصَالِ",1,"ل",1,0],["أَرَشَّت بِها عَيناكَ حَتّى كَأَنَّما","تَحُلّانِ مِن سَفح الدُموعِ بِها نَذرا",2,"ر",2,0],["أَرَشَّت لَها عَيناكَ دَمعاً كَأَنَّهُ","كُلى عَيّنٍ شَلشالُها وَصَبيبُها",3,"ب",3,0],["أرشّح ذا الخمائل مشمعلاّ","بها وأحيد عن ذات الوشاح",4,"ح",1,0],["أُرشِّحُ آمالاً طِوالاً وأجتني","جنى العيشِ في ظل ظليلٍ من النِّعمْ",5,"م",1,0],["أَرْشِفينا كما أريْتِ وأسمعْ","تِ ولا تتركي الهوى صديانا",6,"ن",2,0],["ارشدوني فقد ضللت سبيلي","بين طرد للحادثات وعكس",7,"س",1,0],["أرشدي لقد عشت الذي عشت سيدا","ولم تك عبد الجاه والأمر والمال",8,"ل",1,0],["أَرشِدَنّي إِلى رِضاكَ فَإِنّي","لَستُ أَدري ما حيلَتي في رِضاكا",9,"ك",2,0],["أرشف مبرَّدَ ريقِهِ","مِنْ ثعلبٍ إنْ صدَّ أَنكى",10,"ك",2,1],["أَرْشِدْ بِكُمْ مُسْتَطْلِعِينَ لِشَأْنِكُمْ","فِي الْغَرْبِ كُلَّ مَطَالعِ الأَنْوَارِ",11,"ر",1,0],["أَرْشِدْ بِرِفْقٍ تَارَة","وَتَارَةً بِمُزْدَجَرْ",12,"ر",1,0],["أرشي ابياتي على شجعانها","الزراعي دروبها بالأمنيات",13,"ت",1,0],["أرشيدٌ وأنت جنَّةُ خُلْدٍ","لو أتاح الإلهُ في الأرضِ خُلدا",14,"د",2,0],["أرشيدٌ دونَ المدائنِ تبقَى","مُسْتراضاً لكلِّ داءٍ ووِرْدا",14,"د",2,0],["أرشيدُ لا جُرْحٌ ولا إيلامُ","عاد الزمانُ وصحّتِ الأحلامُ",15,"م",1,1],["أرشيدُ يا بلدي ويا ملهَى الصبا","بيني وبين مَدَى الصبا أعوام",15,"م",1,0],["أرشيدُ فيكِ لُبانتي وصَبابتي","والصِّهْرُ والأخوالُ والأعمام",15,"م",1,0],["أرشيدُ هل في أن يبوحَ أخو الهوى","حَرَجٌ وهل في أن يَحِنَّ ملام",15,"م",1,0],["أرشيدُ مجدُكِ في القديمِ صحيفةٌ","بيضاءُ لا لبْسٌ ولا إبهَامُ",15,"م",1,0],["أرشيدُ لم نسمَعْ لصدرِك أَنّةً","للنّازلاتِ الدُّهْمِ وهي جِسام",15,"م",1,0],["أُرشحُ من لم يعرفِ الشعبُ باسمه","أباعدَ عنه لفّقوا وأجانبا",16,"ب",2,0],["أرشيدٌ دونَ المدائنِ تبقَى","مُسْتراضًا لكِّ داءٍ ووِرْدا",17,"د",2,0],["ارشدتنا الى الاله فقمنا","بمروط اليقين والايمان",18,"ن",1,0],["أَرُشدي سلامٌ مرحباً بكَ مرحباً","وَأَهلا بِصافي الروحِ وَالقَلبِ وَالقَصدِ",19,"د",1,1],["أرشِدهُ يا يسوعُ واغفر له","من أجلِنا جرحُكَ نزَّاز",20,"ز",1,0],["ارشدن زهرة الشبيبة وارسم","فوق ذا المنبر المشيد طغرا",21,"ر",2,0],["أُرشُوا ولا أُرشَى وتلك غَبينةٌ","تُمسى لها الأكبادُ ذاتَ صُدوع",22,"ع",1,0],["أرش بالدمع صحن خدي","ويكنس الحسن بالعذار",23,"ر",1,0],["أرشدَنِي بزعمه وما أرَى","سُلُوَّ قلبي عن هَواكمُ رَشَدَا",24,"د",2,0],["أرشفة من ريق من أحبُّه","فتنطفي جذوة وجد في الحشا",25,"ا",1,0],["أرشفتني كأسَ النعيم يديرها","بعْضي عليّ ألذّ من سنة الكرى",26,"ر",2,0],["أرِش لي جناحَ الحظّ مولاي إِنني","إِذا لمْ تَرشْهُ الدهرَ جَلْدٌ على الصَبْر",27,"ر",1,1],["أرشد الله أمة الإسلام","إن تدم في عبادة الأصنام",28,"م",1,1],["أرشفُ من فيه مكانَ اسمك لا","أحسَبني أرشفُ إلا الضَّرَبا",29,"ب",2,0],["أرشدتماه إلى الهدى وطريقه","فجنيتما منه مجاني الراشد",30,"د",1,0]]}