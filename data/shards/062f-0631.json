],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54824","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54621","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141970","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43839","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43637","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142345","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"منى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=178934",""],[45,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[105,"ألا لا أرى في مصر إلا دعاويا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54862&r=&rc=32",""],[31,"قل للمنازل من أثيلة َ، تنطقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18975&r=&rc=238",""]],"verses":[["دَرَجوا كَما دَرَجَ القُرونُ وَعِلمُهُم","أَن سَوفَ يُخبِرُ آخِرٌ عَن أَوَّلِ",0,"ل",1,0],["دَرَجوا عَلى أَثَرِ القُرونِ وَخَلَّفوا","طُرُقاً مُعَبَّدَةً مِنَ العَلياءِ",1,"ا",2,0],["دُرًّاتَكَوَّنَ فِي بِحَارِ بَلاَغَةٍ","يُهْدَى إِلَيْكَ ثَمِينُهُ وَجَلِيلُهُ",2,"ل",2,0],["دَرَجوا ولَسْتُ بخالِدٍ منْ بَعْدِهِمْ","مُتَميِّزٍ عنْهُمْ بوَصْفِ حَياةِ",3,"ه",1,0],["دَروبا بتصْريفِ اليَراعَةِ والقَنا","طَروباً بحَمْلِ المشرَفيّةِ والكاسِ",4,"س",1,0],["دَراهِمُنا كُلَّها جَيِّدٌ","فَلا تَحبِسَنّا بِتَنقادِها",5,"د",3,0],["دَرمَكٌ لَنا غُدوَةً وَنَشيلٌ","وَصَبوحٌ مُباكِرٌ وَاِغتِباقُ",6,"ق",1,0],["دَرِبوا كَما دَرِبت أُسودٌ خَفِيَّةٌ","غُلبُ الرِقابِ مِنَ الأُسودِ ضَواري",7,"ر",2,0],["دَرَجَ الأَحِبَّةُ بَعدَ ما","تَرَكوا الأَسى وَالحُزنَ لي",8,"ي",1,0],["دَرَى عميدُ بني الشُّورَى بمَوضِعِها","فعاشَ ما عاشَ يَبنيها ويُعليها",9,"ي",3,0],["دَرَجَ الزَمانُ وَأَنتَ مَفتونُ المُنى","وَمَضى الشَبابُ وَأَنتَ ساهٍ مُطرِقُ",10,"ق",1,0],["دَريرٍ كَخُذروفِ الوَليدِ أَمَرَّهُ","تَقَلُّبُ كَفَّيهِ بِخَيطٍ مُوَصَّلِ",11,"ل",1,0],["دُرّةٌ ضمَّت عَلى ياقوتةٍ","أَم لجينٌ فيهِ ثَوبٌ عسجدي",12,"د",2,0],["دُرْ فِي سَمَائِكَ يَا قَضَاءُ فَإِنْ يَثُرْ","بِكَ عِثْيَرٌ فَقَرَارُهُ فِي لَحْدِهِ",13,"د",2,1],["دُرٌّ يُسَلْسِلُهُ فِيمَا يَفُوهُ بِهِ","فَالْقَلْبُ مُبْتَهِجٌ وَالْعَقْلُ مُغْتَنِمُ",14,"م",1,0],["دَرَّ فِي المَجْدِ دَرُّ فِتْيَانِ مَجْدٍ","كُلُّهُمْ نَابِهُ الفؤَادِ عِصَامُ",15,"م",1,0],["دَروجٌ طَوَت آطالَها وَاِنطَوَت لَها","بَلاليقُ أَغفالٌ قَليلٌ حِلالُها",16,"ل",3,0],["دِرَفسٍ رَمى رَوضُ القِذافَينِ متَنَهُ","بِأعرَفَ ينَبو بِالحنَيَّينِ تامِكِ",17,"ك",1,0],["در الدراري تنظم قلادا","وتهدها لو على البديه",18,"ه",1,0],["دَرى بِاليَسارى جَنَّةً عَبقَرِيَّةً","مُسَطَّعَةَ الأَعناقِ بُلقَ القَوادِمِ",19,"م",1,0],["دَرَسَ المَنا بِمُتالِعٍ فَأَبانِ","وَتَقادَمَت بِالحُبسِ فَالسوبانِ",20,"ن",1,1],["درجت عليك الغاديا","ت الرائحات من الأعاصر",21,"ر",1,0],["درى ذو الجيش ما صنعت ظباه","وما يدريه ما صنع الدعاء",22,"ا",2,0],["درّ المقال وتبر الجود تبعثه","فابعث لكانوننا شيئاً من السبج",23,"ج",1,0],["درّت عليك من الغمام مراضعٌ","وتكنفتك من النجوم جوار",24,"ر",1,0],["درت به حلب لطالب رسلها","وحنت على العافي حنو المرضع",25,"ع",1,0],["دٌرٌّ يتيمٌ قد تضوّع نشره","يا من يرق على اليتيم الضائع",26,"ع",1,0],["دراهم عن كلماتٍ عدّدت","فأقبلت تجري على حروفها",27,"ه",2,0],["درر خدمتُ بها علاك وإنما","عُطفت على درر العلى عطف النسق",28,"ق",1,0],["دَرَى مع دهري كيفَ حال تذلّلي","فلاقاه حتَّى كادَ وهو مذلَّل",29,"ل",1,0],["درَّةٌ أو زهوةٌ أو زهرةٌ","فاجتبي أو فاجتلي أو فاجتني",30,"ي",1,0],["درست فهي لا تُبين إلاَّ","بالأسى تستفزُّ قلب الحزين",31,"ن",1,0],["درَّت بمذهبه الكلاميّ الذي","قالَ البيان لفكرِه أشعر وافقه",32,"ه",1,0],["دُريرةُ تَجْلُبُ الطَّربا","ونزهةُ تجلُبُ الكُرَبا",33,"ب",2,1],["دُرُّ صهباءَ قد حكى دُرَّ بيضا","ءَ عَروبٍ كَدمْيةِ المحرابِ",34,"ب",1,0],["دريرةُ منّي بالمكان الذي به","حياتي فدعْ عنك الملام المكررا",35,"ر",2,0],["دريرة ما للدر عنديَ مَفْخر","سواك ولولا أنت ما عُدّ مفخرا",35,"ر",2,0],["درَّ درُّ الصَبا ودرُّ مغاني ال","لهو لو أنها ديار قرار",36,"ر",1,0],["درّعْ يماناً جسْمَها وادَّرِعْ","زينتها تشركْهُ خيرَ الشِّرَك",37,"ك",1,0],["دُرُساً براهُنَّ البِلى بريَ الضَّنا","جسمي لبينِ قطينها المتحمّلِ",38,"ل",1,0],["درَّ دَرُّ الصِّبا ودَرُّ مغاني الْ","لهو لو أنَّها دِيار مُقام",39,"م",1,0],["دَرَجَ البَوارِحُ فَوقَها فَتَنَكَّرَت","بَعدَ الأَنيسِ مَعارِفُ الأَطلالِ",40,"ل",1,0],["دُرَّةٌ ما خَرَجَت مِن صَدَفٍ","تُرخِصُ الدَرَّ عَلى قيمَتِهِ",41,"ه",1,0],["دَرَسَت مَعالِمُها وَغَيَّرَها البِلى","وَلَقَد تُرى حِلَلُ المَحاسِنِ كاسِيَه",42,"ي",2,0],["دَرَت بِأني عاشِقٌ لاسمِها","فَلَم تُرَد لِلغَيظ أَن تَذكُرَهْ",43,"ر",2,0],["دُرّا بَعثتَ مُفصّلاً بِجُمانِ","أَو رَوضَةً مِسكيَّةَ الريحانِ",44,"ن",1,1],["درست يا قبر وقد","زرتك ابكي طللك",45,"ك",1,0],["درى أنه جاء من غير مقصد","فسارع للعود والعود أحمد",46,"د",1,1],["دَرَكٌ مُستَحدَثٌ مِن دَرَجٍ","وَمِنَ الرِفعَةِ ما حَطَّ الدُخانا",47,"ن",2,0],["دَرَجَت عَلى الكَنزِ القُرون","وَأَتَت عَلى الدَنِّ السُنون",48,"ن",1,1],["دَرَّ دَرُّ الصِبا أَأَيّامَ تَجري","رِ ذُيولي بِدارِ أَثلَةَ عودي",49,"د",2,0],["دُروعٌ لِمَلكِ الرومِ هَذي الرَسائِلُ","يَرُدُّ بِها عَن نَفسِهِ وَيُشاغِلُ",50,"ل",1,1],["درجُوا وعندَك من تُراثِهمُ","طِيبُ النَّجَارِ وعِزَّةُ النَّفْسِ",51,"س",1,0],["دُرٌّ مِنَ الشِعرِ لَم يَظلِمهُ ناظِمُهُ","وَلَم يَزُغ مُخطِىءَ التَوسيطِ ثاقِبُهُ",52,"ب",2,0],["دَرَسَت عِهادُ الغَيثِ مِن","هُ فَحالَ عَمّا كُنتَ تَعهَد",53,"د",1,0],["دَرَّت عَلَيهِ غَزيرَةً ضَرّاتُها","تُروي الهُيامَ بِمِحلَبٍ وَعِساسِ",54,"س",1,0],["دَرَجاتُ السَحابِ فاوَتَ مِنها","في السُمُوِّ اِزدِيادُهُ وَاِنتِقاصُه",55,"ص",2,0],["دَرَسَت مَحاسِنُهُ وَطارَ غُرابُهُ","وَلَقَد تَكونُ لَهُ عَلَيكَ مَحاسِنُ",56,"ن",1,0],["درياق أفعى الشتاء وهو إذا","سل علينا سيوفه ذلق",57,"ق",1,0],["درجني الحرف أي تدريج","في منهج بالنحوس منهوج",58,"ج",1,1],["دَرَجوا غَداةَ رَماهُمُ","رَيبُ الزَمانِ فَأَنفَذا",59,"ذ",2,0],["دَرَسَت مَحاسِنُ وَجهِهِ وَنَفى","عَنهُ النَعيمُ فَتِلكَ ساتِرُهُ",60,"ر",2,0],["دَرَجوا فَأَصبَحَتِ المَنازِلُ مِنهُمُ","قَفراً وَأَصبَحَتِ المَدائِنُ خالِيَه",61,"ي",2,0],["دَرَجوا فَما أَبقَت صُرو","فُ الدَهرِ مِنهُم باقِيَه",62,"ي",2,0],["دَرَسَ الزَمانُ جَديدَها بِيَدِ البِلى","فَالقَلبُ يَبلى وَالهَوى يَتَجَدَّدُ",63,"د",1,0],["دِرعٌ بِهِ المَلِكُ العَزيزُ مُدَرَّعٌ","سَيفٌ بِهِ الدينُ الحَنيفُ مُقَلَّدُ",63,"د",1,0],["دَرَسَت تِلكُمُ اللُغاتُ وَأَمسى","مَذهَبُ الناسِ ما يَقولُ الرَئيسُ",64,"س",1,0],["دُرُّ لَفظٍ مِنَ النِظام","مُخجِلٌ سَبعَها الطُوَل",65,"ل",1,0],["درجوا في ذرا العلا","نوَّروا في رُبى النعم",66,"م",1,0],["درجَ الدهرُ وما أذكر بعدك","غير أيامك يا توأم نفسي",67,"ي",1,0],["دَرَسَت صَفائِحُ كَيدِهِم فَكَأَنَّما","أَذكَرنَ أَطلالاً بِبَرقَةِ ثَهمَدِ",68,"د",1,0],["دَرِيَّةُ خَيلٍ ما يَزالُ لَدى الوَغى","لَهُ مِخلَبٌ وَردٌ مِنَ الأَسَدِ الوَردِ",69,"د",1,0],["دُرَّةٌ يا طالما حجَّبْتُها","وبرغمي نبذوها بالعَرا",70,"ر",2,0],["دَرَجَت عَلَيهِ العاصِفاتُ فَقَد عَفَت","آياتُهُ إِلّا ثَلاثٌ جُثَّمُ",71,"م",1,0],["دَرما المَرافِقِ طَيِّبٌ أَردانُها","حَشوُ الحَقيبَةِ بادِنُ المُتَنَطَّقِ",72,"ق",1,0],["دُرمٌ مَرافِقُها وَمِئزَرُها","لا عاجِزٌ تَفِلٌ وَلا صِفرُ",73,"ر",1,0],["دَرَسوا العُلومَ لِيَملِكوا بِجِدالِهِم","فيها صُدورَ مَراتِبٍ وَمجالِسِ",74,"س",1,1],["دَرَجوا على الإيمانِ أبيضَ ساطعاً","لا الكفرُ شيبَ به ولا الإلحادُ",75,"د",1,0],["دَرَجَت عَلى ذِمَمٍ خَوالِدَ لَم تَزَل","تَمضي القُرونُ بِها وَتَأتي الأَعصُرُ",76,"ر",1,0],["دَرَجوا فَلَم تَصفُ الحَياةُ وَلَم تَزَل","تَشقى بِناقِعِ سُمِّها الوُرّادُ",77,"د",1,0],["دَرَجَ الزَمانُ عَلى المَوَدَّةِ بَينَنا","وَأَراهُ يَنقُصُ وَالإِخاءُ يَزيدُ",78,"د",1,0],["دَرَجنا عَلى أَنّا نَكونُ أَعِزَّةً","نَصولُ فَنَجتاحُ العَدُوَّ المُناوِيا",79,"ي",2,0],["دَرجوا على دينِ الفِداءِ فما بهم","عِندَ الحفيظةِ ما يُعابُ ويُحْتَمَى",80,"م",2,0],["دِرعنا كنت وهذا دِرعنا","حَربة في ظهرنا شبت حريقا",81,"ق",2,0],["دُرٌّ ثَناياهُ وَأَلفاظُهُ","فَلَقَّبوهُ الكَوكَبَ الدُرّي",82,"ي",1,0],["دَرَّتِ الشاةُ حينَ مرَّتْ عَلَيها","فلها ثَرْوَةٌ بها وَنَماءُ",83,"ا",2,0],["دَرُّهَا أطيبُ دَرٍّ فإنْ أمْ","كَنَكَ الحَلْبُ فَرَاعِ العِطابا",84,"ب",2,0],["دُرْتُ حتى وَقَعْتُ عِنْدَ المنَاحِي","سِ فيا لَيْتَ أنني دَوَّارَهْ",85,"ر",2,0],["دَرَسَت معالِمُها ألا فاستَخبِرُوا","منها رُسوماً قد عَفَتْ وطُلُولا",86,"ل",2,0],["دَريئةُ الهَيْجا إذا أظلمَتْ","وضاقَ جَيْبُ المَهْمَهِ الخَرْق",87,"ق",1,0],["دِراسَتُهُ الإِنجيلُ حَولَ دِنانِهِ","بَصيرٌ بِبَذلِ الدِنِّ وَالكَيَلانِ",88,"ن",1,0],["دُرَّةٌ بَحرِيَّةٌ مَكنونَةٌ","مازَها التاجِرُ مِن بَينِ الدُرَر",89,"ر",1,0],["دُرَّةٌ حَيثُما أُديرَت أَضاءَت","وَمَشَمٌّ مِن حَيثُما شُمَّ فاحا",90,"ح",2,1],["دَرورٌ لِقَومٍ بِالحَياةِ عَلى الرِضى","عَلى أَنَّ فيها مَوتَهُم حينَ يَغضَبُ",91,"ب",1,0],["دَراهِمُهُم نَقِيّاتٌ وَلَكِن","نُفوسُهُمُ إِذا كُشِفَت زُيوفُ",92,"ف",1,0],["دُرّةٌ من ذُراكَ تَسْكُنُ بحْراً","وكذا الدّرّ ساكنٌ في البُحورِ",93,"ر",1,0],["دَرَّ دَرُّ الشَبابِ وَالشَعَرِ الأَس","وَدِ وَالراتِكاتِ تَحتَ الرِحالِ",94,"ل",1,0],["درجَ الزمانُ على معارِفها","كمدارجِ الأقلام في الرقِّ"