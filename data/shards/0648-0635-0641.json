,["وصِفاحٌ تُمْضى وسُمْرٌ تلظّى","تقْدَحُ النّارَ في مُتونِ الصِّلادِ",2,"د",1,0],["وَصَفراءَ شَكَّتها الأَسِرَّةُ عودُها","عَلى الطَلِّ وَالأَنداءِ أَحمَرُ كاتِمُ",3,"م",1,0],["وَصَفراءَ تَلمعُ بالنابِلين","كَلَمعِ الخَريعِ تَحَلَّت رِعاثا",4,"ث",2,0],["وَصَفْتِهَا صَادِقَةً أَمِينَهْ","فِي قِصَّةٍ مُحْكَمَةٍ رَصِينَهْ",5,"ن",2,0],["وَصْفٌ لَنَا الوَرْدُ فِي زَهْ","وِهِ وَفِي تَصْوِيحِهْ",6,"ح",2,0],["وَصْفٌ مِنَ الرَّكْبِ حَالي","طَلِيقَهِ وَطَلِيحِهْ",6,"ح",2,0],["وَصْفاً تَنَاهَيْتَ فِيهِ","بَرَاعَةً وَفُنُونَا",7,"ن",2,0],["وَصْفُ مَا فَاضَ مِنْ سُرُورِ بَنيهِ","فِي الأَقَالِيمِ يُعْجِزُ الأقْلامَا",8,"م",2,0],["وصفق حتى الريح في لِمَمِ الرُّبى","وأشفق حتّى الطفل في كبد المهدِ",9,"د",1,0],["وَصَفائِحاً صُمّاً رَوا","سيها يُسَدِّدنَ الغُضونا",10,"ن",2,0],["وصفت لنا أكناف سهلٍ موطأ","وإذ فات مقرورٌ أو أطعمت بائسا",11,"س",2,1],["وَصَفوانَ عوداً حَنَّ مِن شُفُرِ اِستِهِ","فَهَذا أَوانُ الحَربِ شُدَّ عِصابُها",12,"ب",3,0],["وُصفت بأوصاف القريض لشقوتي","فلا غَرْوَ إن دارت عليّ الدوائر",13,"ر",1,0],["وصفرت تصفير تحبيبهم","فكنت شميسهمُ من قديم",14,"م",1,0],["وصَفَتْ محبةُ أهلها","منها لمُدْغِلةٍ مُضِبَّهْ",15,"ب",2,0],["وصفحٌ وإكرامٌ وعقلٌ يَزينُهُ","خلائق لا يَخْزَى بهن دمائثُ",16,"ث",1,0],["وصفَ المكارم وهو فيها زاهدٌ","ورأى الجميلَ وفيه عنه تَغَاضي",17,"ض",2,0],["وصفتُ فيها الذي هويتُ على ال","وهم ولم تُختَبر ولم تُذَق",18,"ق",1,0],["وصفراءَ بكرٍ لا قذاها مُغيّبٌ","ولا سرُّ من حَلّتْ حشاهُ مُكتّمُ",19,"م",1,0],["وصَفْعانٍ يجودُ بمصْفَعَيْه","ويصفع نفسَهُ في الصَّافعينا",20,"ن",2,1],["وَصَفا وَشَفَّ فَأَوشَكَت ضِفّاتُهُ","تَنسابُ مِن وَجدٍ بِهِ مُنسابا",21,"ب",2,0],["وَصَفوكَ بِالتَقوى وَقالوا جَهبَذٌ","عَلامَةٌ وَلَقَد وَجَدتُكَ مِثلَما",22,"م",2,0],["وصف الدنيا كثيرو","ن ولكن ما أصابوا",23,"ب",3,1],["وصف ل منزلا حُملوا إليه","وما لمحوا الطريق ولا المطيا",24,"ي",2,0],["وصفت له من أنتِ ثم جرى لنا","حديثٌ يهمُ العاشقين عجيبُ",25,"ب",1,0],["وَصِفِ الحورَ موجَزاً","وَإِذا شِئتَ مُطنِبا",26,"ب",2,0],["وَصِف لَنا كَيفَ تَجفو الروحُ هَيكَلَها","وَيَستَبِدُّ البِلى بِالهَيكَلِ الخالي",27,"ل",2,0],["وَصِفِ المَنونَ فَكَم قَعَدتَ تَرى لَها","شَبَحاً بِكُلِّ قَرارَةٍ وَيَفاعِ",28,"ع",1,0],["وَصِفِ العِزَّ في زَمانِ عَلِيٍّ","وَاِذكُرِ اليُمنَ في زَمانِ سَعيدِ",29,"د",1,0],["وَصِفا لي مُلاوَةً مِن شَبابٍ","صُوِّرَت مِن تَصَوُّراتٍ وَمَسِّ",30,"س",1,0],["وَصَفتُكَ في قَوافٍ سائِراتٍ","وَقَد بَقِيَت وَإِن كَثُرَت صِفاتُ",31,"ت",1,0],["وَصفاً لَهُ عِندَ الأَميرِ الأَمجَدِ","المَلِكِ القَرمِ أَبي مُحَمَّدِ",32,"د",1,0],["وَصَفتَ لَنا وَلَم نَرَهُ سِلاحاً","كَأَنَّكَ واصِفٌ وَقتَ النِزالِ",33,"ل",1,1],["وَصِفتُ فيها مَصيفَ بادِيَةٍ","شَتَوتُ بِالصَحصَحانِ مَشتاها",34,"ا",3,0],["وُصِفَ ابنُ يُوسفَ لي بكلِّ فَضيلةٍ","ورأيتُه فرأيتُ منه أثوَلا",35,"ل",2,1],["وَصَفْراءَ مِنْ مَاءِ الكُرُومِ شَرِبْتُها","عَلَى وَجْهِ صَفْراءِ الغَلائِلِ غَضَّةِ",36,"ه",1,1],["وُصِفَتْ لكَ اللذّاتُ بينَ غَرائبٍ","للعيشِ في أفيائِهنَّ صَفاءُ",37,"ا",2,0],["وَصَفتَ التُقى وَصفاً كَأَنَّكَ ذو تُقاً","وَريحُ الخَطايا مِن ثِيابِكَ تَسطَعُ",38,"ع",1,0],["وَصَفنا نَداهُ لِلمَطِيِّ فَأَطلَعَت","يَداها وَسارَت نَحوَهُ تُسرِعُ الخَطوا",39,"و",2,0],["وَصُفرِ جُفونٍ ما بَكَت بِمَدامِعٍ","وَلَكِنَّها روحٌ تَذوبُ وَتَقطُرُ",40,"ر",1,0],["وَصَفراءُ مِن رَوقِ الأَواري نَحيفَةٍ","إِذا جُذِبَت صَرَّت صَريرَ الجَنادِبِ",41,"ب",1,0],["وَصَفْحٌ عن الجاني بشيمةِ صَفْحِهِ","وَحِلْمٌ حكى في الغيظِ هضْبَ يلملمِ",42,"م",1,0],["وصفراءَ في جسم الزّجاج تَمَيّعَتْ","تألُّقَ بَرْقٍ في الغمام لشائمِ",43,"م",1,0],["وَصَفْتُ حُسْنَكِ للسّالي فجُنّ به","كأنّ للسمعِ منه رؤيةَ البصرِ",44,"ر",1,1],["وَصَفراءُ كَالشَّمسِ تَبدو لَنا","مِنَ الكأسِ في هالَةٍ مُستَديرَه",45,"ر",2,1],["وَصَفراءَ أَحدَقنا بِها في حَدائِقٍ","تَجودُ مِنَ الأَثمارِ بِالثَعدِ وَالمَعدِ",46,"د",1,0],["وَصَفا كَما يَصفو الشِهابُ وَإِنَّهُ","في ذاكَ مِن صِبغِ الحَياءِ لَمُشرَبُ",47,"ب",1,0],["وصفْ لهُ عنيَ الدعاءَ لهُ","أمْ عندَ مولاكَ أنني راقدْ",48,"د",1,0],["وصفْ جنانَ قبا واختمْ بطيبةَ ما","سامرْتني فَهْوَ عندي أطيبُ السمرِ",49,"ر",1,0],["وَصِفنَ بِهِ فَقُلنَ لَنا بِنَجدٍ","مِنَ الحَرِّ الَّذي نَلقى فُروجُ",50,"ج",1,0],["وَصَفحَةً تُنشَرُ مِن صَفحَةٍ","رَأَيتُ فيها الحُسنَ مَسطورا",51,"ر",2,0],["وَصَفراءَ طَلَّقتُ بِنتاً لَها","وَما لِلكَريمِ وَمَأتى الحَرامِ",52,"م",1,0],["وصف ما يعاني النيل من شعرائه","ألم ترهم قلو وإن كثروا عدا",53,"د",2,0],["وَصَفَ الدّواءَ لكم وخَلَّفَ عِلْمَهُ","فيكم فأين يُريدُ منكم من أَبَى",54,"ب",2,0],["وَصِفِي لهذا الجيلِ أيّامَ الأُلى","سبقوكِ من صحبٍ عليكِ كِرامِ",55,"م",1,0],["وصفوكَ بالفردِ الضّعيفِ وإنّنا","لَنراكَ وَحدكَ أُمّةً وقبيلا",56,"ل",2,0],["وَصَفوا المُصابَ لِدَنشوايَ فَكَبَّرت","لِلمُصلِحينَ مَقابِراً وَرِباعا",57,"ع",2,0],["وَصَفتُم لَنا حَسَناتِ الكِتابِ","فَما إِن رَأَينا سِوى السَيِّئاتِ",58,"ت",1,0],["وصِفِ المدائنَ والقصورَ لمعشرٍ","مَثّلتها صُوراً لهم ورسوما",59,"م",2,0],["وَصفْ للنّاسِ آدابَ الحياةِ","وكيف تكونُ دُنيا الصّالحاتِ",60,"ت",1,0],["وَصَفراءِ المَعاصِمِ قَد دَعَتني","إِلى وَصلٍ فَقُلتُ لَها أَبَيتُ",61,"ت",1,0],["وَصَفَّقوا قَفاهُ صَفقَ الطَبلِ","نَصباً بِعَينِ شامِتٍ وَخِلِّ",62,"ل",1,0],["وَصَفراءَ مِن صَبغِ الهَجيرِ لِرَأسِها","إِذا مُزِجَت إِكليلُ دُرٍّ مُنَظَّمِ",63,"م",1,0],["وَصَفَّقَ الديكُ مِن وَجدٍ وَمِن أَسَفٍ","عَلى الظَلامِ وَناداهُم بِتَغويثِ",64,"ث",1,0],["وَصَفْتُ شمائلاً منه حِسَاناً","فما أدري أمدحٌ أمْ نَسيبُ",65,"ب",1,0],["وصِفات ذاتك منكَ يأخذها الورى","في المكرُماتِ فكلّها أسماء",66,"ا",2,0],["وَصَفَّقوها بِماءِ النيلِ إِذ بَرَزَت","في قِدرِ قَسٍّ كَجَوفِ الجُبِّ رَوحاءِ",67,"ا",2,0],["وَصَفراءَ طولِ الدَهرِ فيها يَزيدُها","إِذا شَجَّها هَوناً بِماءِ غَوادِ",68,"د",1,0],["وَصَفتَ خَمسينَ فَمَيَّزتَهُم","وَأَنتَ أَنتَ الظِبيَةُ المُغزِلُ",69,"ل",1,0],["وَصَفراءَ قَبلَ المَزجِ بَيضاءَ بَعدَهُ","كَأَنَّ شُعاعَ الشَمسِ يَلقاكَ دونَها",70,"ن",3,0],["وَصَفراءُ مِثلُ الخَيزُرانَةِ لَم تَعِش","بِبُؤسٍ وَلَم تَركَب مَطِيَّةَ راعِ",71,"ع",1,0],["وَصَفراوَينِ مِن بَقَرٍ وَراحٍ","أَصَبتُهُما وَما حَسُنَ السَوادُ",72,"د",1,0],["وَصَفَت مَجاسِدُها رَوادِفَ فَعمَةً","وَمُهَفهَفاً قَلِقَ الوِشاحِ خَضيدا",73,"د",2,0],["وَصَفتُكَ فَإِبتَهَجتَ وَقُلتَ خَيراً","لِتُجزِيَني فَأَدرَكَني اِبتِهاجي",74,"ي",1,1],["وُصِفتِ لِقَومٍ ر