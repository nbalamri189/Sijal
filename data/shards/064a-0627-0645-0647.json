{"poems":[[93,"يا مهدياً ديوان أكبر شاعر","https://www.aldiwan.net/poem11279.html","الكامل"],[93,"أتحين في هذي النضارة والصبا","https://www.aldiwan.net/poem11406.html","الكامل"],[93,"يا مهدياً قلم النضار وإنه","https://www.aldiwan.net/poem11423.html","الكامل"],[72,"يا مهديا من خطه قاعدا","https://www.aldiwan.net/poem20554.html","السريع"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[92,"يا ليت شعري هل لليل الن","https://www.aldiwan.net/poem38974.html","مجزوء الكامل"],[85,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[85,"جبريل هلل في السماء وكبر","https://www.aldiwan.net/poem63765.html","الكامل"],[66,"يا مهيني عند المغيب ومبد","https://www.aldiwan.net/poem38771.html","الخفيف"],[69,"اسأل الفوعة الشديدة حزنا","https://www.aldiwan.net/poem28977.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[90,"الشباب المر","https://www.poetsgate.com/ViewPoem.aspx?id=178970",""],[180,"يا مهدي الدر بين الحبر والورق","https://www.aldiwan.net/poem67045.html","البسيط"],[191,"يا مهديا لي بنفسجا أرجا","https://www.aldiwan.net/poem13010.html","المنسرح"],[191,"يا مهديا لي بنفسجا سمجا","https://www.aldiwan.net/poem13012.html","المنسرح"],[195,"إعزف على العود يا معبودي الثاني","https://www.aldiwan.net/poem39888.html","البسيط"],[195,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[227,"يا مهمل العيش إن الدهر ذو نوب","https://www.aldiwan.net/poem51227.html","البسيط"],[233,"يا مهدي الورد الجني لنا","https://www.aldiwan.net/poem31780.html","السريع"],[295,"زهر الدراري أم نظام الجوهر","https://www.aldiwan.net/poem33261.html","الكامل"],[296,"(أدمشق) ما للحسن لا يعدوك","https://www.aldiwan.net/poem36849.html","عموديه"],[303,"ما خلت لبي يستفز ويسحر","https://www.aldiwan.net/poem56534.html","الكامل"],[346,"يا لحظه أثخنت قلبي جراح","https://www.aldiwan.net/poem20028.html","السريع"],[351,"حمدا لك اللهم يا من قد قضى","https://www.aldiwan.net/poem40828.html","الرجز"],[359,"حتام يا ساجي اللواحظ تهجر","https://www.aldiwan.net/poem68111.html","الكامل"],[362,"هاك عهدي فلا أخونك عهدا","https://www.aldiwan.net/poem60925.html","الخفيف"],[388,"ياكريم الوجه ضاقت وأنت بالعالم عليم","https://www.aldiwan.net/poem54488.html","عموديه"],[402,"قد قلت لما أن سمعت بقترة","https://www.aldiwan.net/poem49664.html","الكامل"],[413,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[413,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[426,"أقبلت تنجلي وتسحب ذيلا","https://www.aldiwan.net/poem40711.html","الخفيف"],[429,"هيهات تعطف بالملام جموحا","https://www.aldiwan.net/poem12498.html","الكامل"],[462,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[462,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[462,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[496,"يا مهدي الرشأ الذي ألحاظه","https://www.aldiwan.net/poem3709.html","الكامل"],[504,"يا مهدى الموز تبقى","https://www.aldiwan.net/poem2453.html","المجتث"],[511,"يا مهديا يا سمينا حول سوسنة","https://www.aldiwan.net/poem67691.html","البسيط"],[565,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"]],"verses":[["يَا مُهْدِياً دِيوَانَ أَكْبَرِ شَاعِرٍ","مِنْ شَرْحِ نَابِغَةِ البَيَانِ الأَعْظَمِ",0,"م",1,1],["يَا مُهْجَةً ذَابَتْ وَعَيْناً أُغْمِضَتْ","ذَهَبَ الرَّدَى بِهِمَا وَكَانَ أَثِيمَا",1,"م",2,0],["يَا مُهدِياً قَلَمَ النُّضَارِ وَإِنَّهُ","فِي خَيْرِ مَا يُهْدَى لَرَمْزٌ غَالِ",2,"ل",1,1],["يا مهدياً من خطه قاعداً","على سواد العين محمولا",3,"ل",2,1],["يا مُهاناً تلاده كل هونٍ","مُتَحَفَّىً بضيفه مرفوقا",4,"ق",2,0],["يا مُهْجَةَ الغابِ الجميلِ","ألمْ يُصَدِّعْكِ النَّحيبْ",5,"ب",1,0],["يا مِهرَجانَ العِلمِ حَولَكَ فَرحَةٌ","وَعَلَيكَ مِن آمالِ مِصرَ زِحامُ",6,"م",1,0],["يا مِهرَجانَ البَرِّ أَنتَ تَحِيَّةٌ","لِلَّهِ مِن مَلَإٍ كَريمٍ خَيِّرِ",7,"ر",1,0],["يا مُهيني عِندَ المَغيبِ وَمُبدٍ","مَع حُضوري خُضوعَ عَبدٍ لِمَولى",8,"ل",2,1],["يا مهنَّا أنا المنغَّصُ وحدي","لا بل العالمونَ إنساً وجنَّا",9,"ن",2,0],["يا مهين العراق هَل كنت تَدري","أن أَهلَ العِراق لَيسوا غيارى",10,"ر",2,0],["يَا مَهَاةً فِي الْعَيْنِ أَنْشَأَها","بَهْجَةً لِلْعُيُونِ مَنْ أَنْشَا",11,"ش",2,0],["يا مهبِطَ الرسل الدعاة إلى الهدى","عليا بنيك عن العلى ما عاقها",12,"ق",3,0],["يا مُهدي الدُّرِّ بَينَ الحبرِ وَالوَرَقِ","قَلائِداً بِحُلاها طوَّقَتْ عُنُقِي",13,"ق",2,1],["يا مُهدِياً لِي بَنَفسَجاً أَرجاً","يَرتاحُ صَدري لَهُ وَيَنشَرِحُ",14,"ح",1,1],["يا مُهدياً لِي بَنَفسَجاً سَمِجاً","وَدِدتُ لَو أَنَّ أَرضَهُ سَبَخُ",15,"خ",1,1],["يا مهبط الوحي يا ملهى طفولتنا","أوّاهُ ليت الذي أهواهُ يهواني",16,"ي",1,0],["يا مَهبطَ الوَحي القديم ومَرقدَ","الرُسلِ الكرامِ ومَنبعَ الأديان",17,"ن",1,0],["يا مهْمِلَ العيش إنّ الدهر ذو نُوَبٍ","حكمُ الحوادث صعبٌ غيرُ مُنْجَذِب",18,"ب",1,1],["يا مُهدِيَ الوَردِ الجَنِيِّ لَنا","جَرياً عَلى عاداتِهِ الأُوَلِ",19,"ل",1,1],["يا مُهدياً لي من سَنيِّ نظامِه","وَنثارِه دُرّاً بهيَّ المَنظَرِ",20,"ر",1,0],["يا مهبطَ السحرِ الحلال أَلم يكنْ","(حسَّان) ينشي سحرَه من فيكِ",21,"ك",1,0],["يا مهديَ الطرسِ الّذي في طيّهِ","أعلامُ المفاخرِ تنشرُ",22,"ر",1,0],["يَا مُهَجَ العُشَّاقِ مَاذا جَنَتْ","عَليكِ في الحُبِّ عُيُونُ المِلاحْ",23,"ح",1,0],["يا مُهلِكاً عاداً بِريحٍ صَرصَرٍ","وَمنجياً هوداً نَجاة المُرتَضى",24,"ا",1,0],["يا مُهجَتي الحرا عَلَيهِ تَفتى","وَجدا فما لَك عَن هَواهُ تَأخر",25,"ر",1,0],["يا مَهاةَ الصَريمِ عَيناً وَجيداً","وَأَخا الوَردِ في الطَروَةِ خَدّا",26,"د",2,0],["يامهيمن ياعليم وصلاة الله تترى","كل ماهب النسيم",27,"م",1,0],["يا مُهْجَتي إنْ كُنتِ واقِيةً فَتىً","لفضائلٍ مَلأ القُلوبَ فَقيهِ",28,"ه",1,0],["يا مهاةَ الجزع أنتنَّ له","سالباتٌ قَلْبَه المضنى جمالا",29,"ل",2,0],["يا مهاب البأس مرجوّ الندى","لا تزال الدهر مرجوًّا مهابا",30,"ب",2,0],["يا مهاة لها لحشاشة مرعى","عمركِ اللَه قد فتكت فمها",31,"ه",2,0],["يا مُهدياً نحوي الملامةَ إنما","أهديتَ نحو الجَمرِ منها الرّيحا",32,"ح",2,0],["يا مهاةَ الصَّريم ضلَّ فتى ظن","ن مهاةَ الصريَّم تحفظ إلاَّ",33,"ل",2,0],["يا مهاة المنحنى هل من لمامٍ","وضلالٌ قولتي هل من لمامِ",34,"م",1,0],["يا مهاة الصّريم ما زورة النّ","عف بأولى يدٍ لطيفك عندي",35,"د",2,0],["يا مُهدِيَ الرَشأ الَّذي ألحاظُه","تَركت فُؤادي نُصبَ تِلكَ الأَسهمِ",36,"م",1,1],["يا مهدىَ الموزِ تبقَى","وميمه لكَ فاء",37,"ا",2,1],["يا مهدياً يا سميناً حول سوسنةٍ","في باقةٍ من خلاف حشوها الآس",38,"س",1,1],["يا مَهاةَ الفلاةِ يا عِرْضَةَ الأع","راض يا عَذْبَةَ الثنايا العذابِ",39,"ب",1,0]]}