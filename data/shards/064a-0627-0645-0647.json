d=213055",""],[5753,"في انتظار الآخرة","https://www.poetsgate.com/ViewPoem.aspx?id=207646",""],[5770,"تكريم المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=178686",""],[5829,"خطاب لم يصل","https://www.poetsgate.com/ViewPoem.aspx?id=152684",""],[5848,"ختامها مسك","https://www.poetsgate.com/ViewPoem.aspx?id=53164",""],[5848,"حزني واعرفه زين","https://www.poetsgate.com/ViewPoem.aspx?id=53358",""],[5875,"دروب الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=26770",""],[5875,"كبرياء الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=211781",""],[5956,"تصوُّرُ رحيلها والأطفال للشام","https://www.poetsgate.com/ViewPoem.aspx?id=182404",""],[5976,"أنشودة التيه","https://www.poetsgate.com/ViewPoem.aspx?id=30346",""],[5977,"حب الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=213124",""],[5977,"إلى طفلة.","https://www.poetsgate.com/ViewPoem.aspx?id=213139",""],[6038,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=32327",""],[6068,"هل تنجزيني الموعدا -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175856",""],[469,"يا مهدي الأبذنج اهلا بما","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574775",""],[6185,"حاولت ريّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86944&r=&rc=4",""],[186,"يا مهدي الدر بين الحبر والورق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55786&r=&rc=49",""],[6213,"ومضة من الألق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81912&r=&rc=87",""]],"verses":[["يَا مُهْدِياً دِيوَانَ أَكْبَرِ شَاعِرٍ","مِنْ شَرْحِ نَابِغَةِ البَيَانِ الأَعْظَمِ",0,"م",1,1],["يَا مُهْجَةً ذَابَتْ وَعَيْناً أُغْمِضَتْ","ذَهَبَ الرَّدَى بِهِمَا وَكَانَ أَثِيمَا",1,"م",2,0],["يَا مُهدِياً قَلَمَ النُّضَارِ وَإِنَّهُ","فِي خَيْرِ مَا يُهْدَى لَرَمْزٌ غَالِ",2,"ل",1,1],["يا مهدياً من خطه قاعداً","على سواد العين محمولا",3,"ل",2,1],["يا مُهاناً تلاده كل هونٍ","مُتَحَفَّىً بضيفه مرفوقا",4,"ق",2,0],["يا مُهْجَةَ الغابِ الجميلِ","ألمْ يُصَدِّعْكِ النَّحيبْ",5,"ب",1,0],["يا مِهرَجانَ العِلمِ حَولَكَ فَرحَةٌ","وَعَلَيكَ مِن آمالِ مِصرَ زِحامُ",6,"م",1,0],["يا مِهرَجانَ البَرِّ أَنتَ تَحِيَّةٌ","لِلَّهِ مِن مَلَإٍ كَريمٍ خَيِّرِ",7,"ر",1,0],["يا مُهيني عِندَ المَغيبِ وَمُبدٍ","مَع حُضوري خُضوعَ عَبدٍ لِمَولى",8,"ل",2,1],["يا مهنَّا أنا المنغَّصُ وحدي","لا بل العالمونَ إنساً وجنَّا",9,"ن",2,0],["يا مهين العراق هَل كنت تَدري","أن أَهلَ العِراق لَيسوا غيارى",10,"ر",2,0],["يَا مَهَاةً فِي الْعَيْنِ أَنْشَأَها","بَهْجَةً لِلْعُيُونِ مَنْ أَنْشَا",11,"ش",2,0],["يا مهبِطَ الرسل الدعاة إلى الهدى","عليا بنيك عن العلى ما عاقها",12,"ق",3,0],["يا مُهدي الدُّرِّ بَينَ الحبرِ وَالوَرَقِ","قَلائِداً بِحُلاها طوَّقَتْ عُنُقِي",13,"ق",2,1],["يا مُهدِياً لِي بَنَفسَجاً أَرجاً","يَرتاحُ صَدري لَهُ وَيَنشَرِحُ",14,"ح",1,1],["يا مُهدياً لِي بَنَفسَجاً سَمِجاً","وَدِدتُ لَو أَنَّ أَرضَهُ سَبَخُ",15,"خ",1,1],["يا مهبط الوحي يا ملهى طفولتنا","أوّاهُ ليت الذي أهواهُ يهواني",16,"ن",2,0],["يا مَهبطَ الوَحي القديم ومَرقدَ","الرُسلِ الكرامِ ومَنبعَ الأديان",17,"ن",1,0],["يا مهْمِلَ العيش إنّ الدهر ذو نُوَبٍ","حكمُ الحوادث صعبٌ غيرُ مُنْجَذِب",18,"ب",1,1],["يا مُهدِيَ الوَردِ الجَنِيِّ لَنا","جَرياً عَلى عاداتِهِ الأُوَلِ",19,"ل",1,1],["يا مُهدياً لي من سَنيِّ نظامِه","وَنثارِه دُرّاً بهيَّ المَنظَرِ",20,"ر",1,0],["يا مهبطَ السحرِ الحلال أَلم يكنْ","(حسَّان) ينشي سحرَه من فيكِ",21,"ك",1,0],["يا مهديَ الطرسِ الّذي في طيّهِ","أعلامُ المفاخرِ تنشرُ",22,"ر",1,0],["يَا مُهَجَ العُشَّاقِ مَاذا جَنَتْ","عَليكِ في الحُبِّ عُيُونُ المِلاحْ",23,"ح",1,0],["يا مُهلِكاً عاداً بِريحٍ صَرصَرٍ","وَمنجياً هوداً نَجاة المُرتَضى",24,"ا",1,0],["يا مُهجَتي الحرا عَلَيهِ تَفتى","وَجدا فما لَك عَن هَواهُ تَأخر",25,"ر",1,0],["يا مَهاةَ الصَريمِ عَيناً وَجيداً","وَأَخا الوَردِ في الطَروَةِ خَدّا",26,"د",2,0],["يامهيمن ياعليم وصلاة الله تترى","كل ماهب النسيم",27,"م",1,0],["يا مُهْجَتي إنْ كُنتِ واقِيةً فَتىً","لفضائلٍ مَلأ القُلوبَ فَقيهِ",28,"ه",1,0],["يا مهاةَ الجزع أنتنَّ له","سالباتٌ قَلْبَه المضنى جمالا",29,"ل",2,0],["يا مهاب البأس مرجوّ الندى","لا تزال الدهر مرجوًّا مهابا",30,"ب",2,0],["يا مهاة لها لحشاشة مرعى","عمركِ اللَه قد فتكت فمها",31,"ه",2,0],["يا مُهدياً نحوي الملامةَ إنما","أهديتَ نحو الجَمرِ منها الرّيحا",32,"ح",2,0],["يا مهاةَ الصَّريم ضلَّ فتى ظن","ن مهاةَ الصريَّم تحفظ إلاَّ",33,"ل",2,0],["يا مهاة المنحنى هل من لمامٍ","وضلالٌ قولتي هل من لمامِ",34,"م",1,0],["يا مهاة الصّريم ما زورة النّ","عف بأولى يدٍ لطيفك عندي",35,"د",2,0],["يا مُهدِيَ الرَشأ الَّذي ألحاظُه","تَركت فُؤادي نُصبَ تِلكَ الأَسهمِ",36,"م",1,1],["يا مهدىَ الموزِ تبقَى","وميمه لكَ فاء",37,"ا",2,1],["يا مهدياً يا سميناً حول سوسنةٍ","في باقةٍ من خلاف حشوها الآس",38,"س",1,1],["يا مَهاةَ الفلاةِ يا عِرْضَةَ الأع","راض يا عَذْبَةَ الثنايا العذابِ",39,"ب",1,0],["يا مهجة القلبِ هل عودٌ نؤَملّهُ","وهل كتاب سلامٍ منكَ حيَّانا",40,"ن",2,0],["يا مهاةً راحَت وَخلَّت فؤادي","يتلظّى بلاعج التَبريحِ",41,"ح",1,1],["يا مهر لا تسام فعند ال","صبح يحمد منه مسرى",42,"ر",2,0],["يا مهدي النرجس أهديته","ذا مقل ما أخطأت مقلتي",43,"ي",1,1],["يا مهجةً جُزْتُ فضمنتها","من الثرى غيرَ الضمين الثقه",44,"ق",2,0],["يا مُهجَتي مُوتي أَسىً وَصَبابةً","إِنَّ الحَبيبَة أَحرمَتكَ صِلاتها",45,"ت",3,0],["يا مُهجَةَ الصبِّ أَفناهُ الجَوى وصَباً","فَالرّوحُ ذائِبة وَالقَلبُ مَفقودُ",46,"د",1,0],["يا مهدي النظر الحسنْ","أأبن زيد والحسنْ",47,"ن",1,1],["يا مهجتي لا تيأسي من رحمة","وسعت جميع الخلق باغ أو ولي",48,"ل",2,0],["يا مِهرَجاناً تَوَدُّ الحورُ لَو حَضَرَت","ما دارَ فيهِ بِلا لَهوٍ وَغَيرِ دَدِ",49,"د",1,0],["يا مُهجَةً غالَها غَولُ الرَدى قَنَصاً","وَأَنشَبَت سَهمَها فيها المَنِيّاتُ",50,"ت",1,0],["يامهُ الغرّاء حاكت في البها","شمساً تجلّت بالضياء الباهرِ",51,"ر",1,0],["يا مهاد الزهر من بان اللهوى","كم سحبنا فيك اذيال الهوى",52,"ه",3,0],["يا مُهْجتي التي مَلامي","لا تَسْمَعُهُ ولا تَعيهِ",53,"ي",2,0],["يا مهجتي يا جلدي يا صبا","إن لم أمت وجداً فلا بد لي",54,"ي",1,0],["يا مهديَ الراح الرقيقة إنها","جازت برقتها معاني الراحِ",55,"ح",1,1],["يا مهديَ الطّرفِ الجوادِ كأنَّما","قد أنْعَلُوهُ بالرياحِ الأربعِ",56,"ع",1,1],["يأمهم إمامهم وتقفو","سبيل نتيجة الأنجاب نجب",57,"ب",1,0],["يا مهجتي سيموتُ من لم يقتلِ","فلأشفينَّ النفس ثمَّ اميتها",58,"ه",2,0],["يا مهاةَ الخدر لي قلبٌ اذا","ما غزاهُ الغدرُ يحميهِ وفا",59,"ا",1,0],["يا مهر ميداني وَيا نَجيبي","أَقبل تَرى يفديك من تولى",60,"ل",2,0],["يا مهاة الحمى وشمس الغواني","طاب شرب الصبوح بعد الوصال",61,"ل",1,0],["يا مهجتي هذا الغزال الرومي","والشادن التركي أين تحومي",62,"ي",1,1],["يا مهاةً تكاملَ الحسنُ فيها","فتبارت لها قلوبُ الرِّجَالِ",63,"ل",1,0],["يا مَهاةً تجمَّع الحُسنُ فيها","وحباها الجمالُ منه ابتساما",64,"م",2,0],["يا مَهاتي إنَّ قلبي","ذابَ من طولِ البعاد",65,"د",1,0],["يا مُهدِياً أَهدَى المُدَى","ذُق من هَدِيَّتِكَ الرَّدَى",66,"د",2,1],["يا مُهجتي التَهبي يا عبرتي انسكبي","عَزّ اللّقا بهم في سائر العمر",67,"ر",1,0],["يا مَهاة الحُسن مهلاً","إن صبر الصبّ زالا",68,"ل",2,0],["يا مهد آبائي واجدادي الألى","تخذوا جبالك للسماء مراقي",69,"ق",2,0],["يا مهد اكرم أمةٍ نشرت على","هام السهى خفاقةً أعلامها",70,"م",3,0],["يا مهد ما الذكرى بنافعةٍ","لا هندُ راجعةٌ ولا دعد",71,"د",1,0],["يا مهد حسبك أن جلهم","نشآت حضنك أيها المهد",71,"د",1,0],["يا مهاة العرب يحمي خدرها","في صدور البيد اطراف القنا",72,"ا",1,0],["يا مَهاةَ الرَملِ مَرعاكِ القُلوبُ","نَظرَةً لا تَزهدِي ثُمَّ نَتوبُ",73,"ب",1,1],["يا مهاة بين سلع والنقا","سلبت رشدي وقد كنت رشيدا",74,"د",2,0],["يا مهجتي شقي الصفوف وبادري","لا ترجعي لا ترجعي",75,"ع",2,0],["يا مهجتي بلظى الأحزان فاتقدي","وذب لهول صروف الدهر يا كبدي",76,"د",2,1],["يا مهجتي صبراً عسى أن يرعوي","من كان لم يتلاف ما هو تالف",77,"ف",1,0],["يا مهديا لي صورة الأمل","أهديت لي حقبا من الأجل",78,"ل",1,1],["يا مهجتي بلظى شوق قد اضطرما","وسال مذ سال دمعي منه منسجما",79,"م",2,1],["يا مهدي الغرر الحسنى التي خجلت","من دونها غرر الاتراك والعرب",80,"ب",1,0],["يا مهاة تمر وهي تغني","وهي لحن ومشيها ألحانُ",81,"ن",1,1],["يا مُهدِيَ الدُرِّ النَظيمِ الَّذي","أَحسَنَ مِنهُ مَسمَعي ما وَعى",82,"ا",1,0],["يا مُهجتي أضناك رُمحُ قوامه","طعنا وسيفُ لحاظه بتّاك",83,"ك",1,0],["يا مهاة سلت على الليث نابليون","من لحظها الضبا المشرفيه",84,"ي",2,0],["يا مهر إن جئت العذيب وأهله","تنل المنى بثماده وتمامه",85,"م",2,0],["يا مهاة البان يا ذات الدلال","جل من أبدع ذا الوجه الجميل",86,"ل",1,1],["يا مهاة الضال يا رشدي","يا ظلالي في طرائقها",87,"ق",3,1],["يا مهبطَ الوحي أَجِر مُذنباً","قَد شفّه الوجد الَّذي شَفا",88,"ف",2,0],["يا مُهجَتي صَبراً عَلى ظلمه","ما أَكبَر الظلم عَلى الصابرِ",89,"ر",1,0],["يا مهاة رأيت منها دلالا","شاقني والدلال قدما يشوق",90,"ق",1,0],["يا مَهيَعَ القوم الكِرام ومَربَعَ ال","فِئة الفِهامِ ومَرتَع النُبَلاءِ",91,"ا",2,0],["يا مهدي الاقصاب من سكر","صفرا حكى سمر القنا طولها",92,"ه",2,1],["يا مهدياً صورة تحكي شمائله","وقابلاً صورتي من عطفه بدلا",93,"ل",2,1],["يا مُهجَتي في الهَوى ما كانَ أَسماكِ","لَو رَوَّحَتني بِراحِ الوَصلِ أَسماكِ",94,"ك",1,1],["يا مُهديَ الحُلَلِ الرشيقه","ومهديَ السبلِ الشريقه",95,"ق",2,1],["يا مُهدياً لي وَالهدايا جمةٌ","قلَّما تَعجُّ بِهِ الحَياةُ وَتَحتَدِمْ",96,"م",1,0],["يا مُهدياً بكتابهِ وعتابهِ","كلَماً شَفَتْ وكلومَ لَوْمٍ شَفّتِ",97,"ت",1,1],["يا مُهدياً فقَراً جلّتْ قلائدُها","عن وصفِ مُطْرٍ لها أو رَصفِ رَصافِ",98,"ف",1,1],["يا مُهدي الفَرَح","في الرِضى أَرغَب",99,"ب",1,0],["يا مهجتي ذوبي إليهِ تشوقاً","يا حرَّ قلبي خلِّني لا أشعرُ",100,"ر",1,0],["يا مَهوباً زانهُ الصدر الرحيب","يا عسوباً فاق في نوعٍ غريب",101,"ب",1,0],["يا مهبَطَ الوحي وَيا من عِندهُم","ما هُوَ آتٍ وعلومُ ما مَضى",102,"ا",1,0],["يا مهجة الدين لا قطعا ولا ألما","إلا كما يستذيب الشحم صاهره",103,"ر",2,0],["يا مُهجة الصب صبراً بعد بَينهم","فانَّ عبء جفاهم ليس يُحتمل",104,"ل",1,0],["يا مهبَطَ الوحي الشريف ومنزلَ","التنزيلِ والآياتِ والإرشاد",105,"د",1,0],["يا مَهاةَ الجِزْعِ بالله اسْمَعِي","دَقَّةَ القَلْبِ وزُورِيني لِماما",106,"م",2,0],["يأمة المليارعندي خبر هام","اللي جرى انتم طريقه لزومي",107,"م",2,0],["يا مهنّدنا الحدَب لا تعوّد سنديان","دام لك فعل أبو حفصة أمير المؤمنين",108,"ن",1,0],["يا مهلكاً في صرصرٍ عاداً إرم ذات العماد","يا منجياً يونس وهو في بطن حوتٍ ذا كمد",109,"د",1,0],["يامهجتي ياطيّب الفال","انته الفخر والطيب والورد",110,"د",1,0],["يا مَهْدَ مَن كَسَتِ الجِبالَ بُيُوتُهُم","فَغَدَوا جِبالًا تَحتَهُنَّ جِبالُ",111,"ل",1,1],["يامُهجةَ الروحِ ياصَهباءَ نشوتِها","أجريتَ مجرى دمي كي تُلهبَ الدّارا",112,"ر",2,0],["يا مُهجةً لِلرُّوحِ قَد أَحبَبْتُهَ