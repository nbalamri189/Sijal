{"poems":[[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[53,"كان هزلا فعاد جدا غرامي","https://www.aldiwan.net/poem66364.html","الخفيف"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[201,"طرقتني فجر يوم المولد","https://www.aldiwan.net/poem39890.html","الرمل"],[201,"بما أودعته فيها","https://www.aldiwan.net/poem39940.html","مجزوء الوافر"],[280,"الله عن تلك المناقب دافع","https://www.aldiwan.net/poem25488.html","الكامل"],[376,"نعم الله يا ابن عبد الله","https://www.aldiwan.net/poem56984.html","الخفيف"],[422,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[519,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138221",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38756","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70768","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107212","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49935","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87920","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108505","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108650","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123091","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113800","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99086","الرمل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124679","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68022","الكامل"],[3506,"","https://poetry.dctabudhabi.ae/diwan/poem/107337","الطويل"],[3685,"","https://poetry.dctabudhabi.ae/diwan/poem/203155","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66162","الكامل"],[5120,"حَمَامَةُ نَارٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179988",""],[5183,"بَْينَ الْشَّهْدِ وَالْشَّهَادَة","https://www.poetsgate.com/ViewPoem.aspx?id=186463",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5431,"رقص سوريالي!!","https://www.poetsgate.com/ViewPoem.aspx?id=200445",""],[5582,"لَقَدْ زِدْتِ نُوراً يا ابْنَةَ الخَمْسِ وَالتِّسْعِ","https://www.poetsgate.com/ViewPoem.aspx?id=187178",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[5751,"طِفلة الورد","https://www.poetsgate.com/ViewPoem.aspx?id=214766",""],[6075,"أرض الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=190500",""]],"verses":[["وترَشّفَ العافونَ منكَ أنامِلاً","يَخْلُفْنَ غاديَةَ الغَمامِ المُغزِرِ",0,"ر",1,0],["وترشَّفْ منها لمىً فهْو كأْسٌ","ليسَ في شربِ خمرها من أَثام",1,"م",1,0],["وترشَّفَتْهُ ولم تكن مكروهةً","نكهاتُ مِسكٍ عند ذي استنكاهِ",2,"ه",1,0],["وترشفا كأس الغرام، وما","تركا بها من نهلة لصدي",3,"د",2,0],["وترشدها أطياب قبرك في الدجى","فتعصمها من حيرة ونكوب",4,"ب",1,0],["وتَرشَّفتُ رُضابا كُلّما عَلَّنِي","عُدتُ كأنْ لم أشربِ",5,"ب",1,0],["وترشفنا حميا القبل","وتركنا النوم للغر الخلي",6,"ي",1,0],["وترشفُ روحي العطشى","رواها من مآقيها",7,"ي",3,0],["وتَرَشُّفُ النُّعْمَى بهِ مُتَنَاسِقٌ","وتَشَرُّفُ الدّنيا بهِ مُتَتَابِعُ",8,"ع",1,0],["وترشّف أفواهَ تلكَ الأباري","قِ فَتِلكَ الأفواهُ كالأَفواهِ",9,"ه",1,0],["وترشَّفتُ شذًى من مرشف","عنبريّ الطيب مسكيّ الختام",10,"م",1,0],["وترشَّفوا شَهْدَ الشِفاهِ لأنّها","تحكي اِسْمِرارَ اللُدْنِ في لَونِ اللَّمى",11,"م",2,0],["وترشفا راح الرفا من كوثر","لكما جرى منه النمير ولا حرج",12,"ج",1,0],["وَتَرشَّفي خَمرَ اللّمى","مِن فيكِ حاوي عَذبَ شَهدِك",13,"ك",1,0],["وترشقُ قلبَ الصبِّ أسهمُ لحظها","وأسهم نهدٍ قاعدٍ يحرق القمصا",14,"ص",2,0],["وَتُرشِفُني رَحِيقاً مِن لَماها","وَتُسكِرُنِي بِهِ السُّكرَ الحَلالا",15,"ل",2,0],["وترشق عن قوس الحواجب أسهما","نواش بأهداب لها القلب مغنم",16,"م",1,0],["وتَرشَّفَت من أُفقها بَلَلَ النَّدى","واسْتَنْشَقتْ لَفسَ النَّسيم السَّجْسَجِ",17,"ج",1,0],["وترشُّحاً للنفس من جسم فنى","في الشيخ يمضي منعشاً او سائلاً",18,"ل",2,0],["وترشفت راح الدلال فأصبحت","تهتز كاليزنية السمراء",19,"ا",2,0],["وترشفت بعد لثم محيا","ه الرضاب المطيب المأثورا",20,"ر",2,0],["وَتَرَشَّفتُ رِيقَها فَتَوَهَّم","تُ بِأَنّي غَدَوتُ أَرشِفُ خَمرا",21,"ر",2,0],["وترشفه ظُلماً قسيّ حواجب","تحلل قتل الصبّ وهو حرام",22,"م",1,0],["وتُرشِدُ أنَّ العَبدَ مهما أصابَهُ","بنائِبةٍ مولاهُ قُرِّبِ مِن بُعدِ",23,"د",1,0],["وترشفت على شو","ق ثناياه العذابا",24,"ب",2,0],["وترشفها الشمس عند الضحى","باكوابها وبانوارها",25,"ا",1,0],["وتَرشَّحتْ وصلاً إِلَيْكَ فهالَها","إِن كنت مُشتاقاً فها هي أَشْوَق",26,"ق",1,0],["وترشُفُ من ثَغري مُداماً مُرَوَّقاً","وَثَغرِي مِن خَمرِ اللَمى يَتَرَشَّفُ",27,"ف",1,0],["وترشحت للجواب فأعيا","ني وانسل هارباً شيطاني",28,"ن",2,0],["وَتَرَشَّفَ الثَّغْرانِ منْ خَمْرِ اللَّمَى","كاسا يَرُوقُ الشارِبينَ طِلاها",29,"ا",3,0],["وَ تَرْشُفُ مَا يَطْفُو عَلَى نَهْرِ حَيْرَتِي","لِمَعْزُوفَةٍ تَشْدُو عَلَى أَلَقِ السِّحْرِ",30,"ر",1,0],["وترشفه على القبلات ثغرا","وتلثمه على الوجنات وُرَّدا",31,"د",2,0],["وترشُقُ عينَ أغنيتي سهاماً","تُشقّقني ولوعاً في جُروفي",32,"ف",2,0],["وترشفني كما لو كنتُ زهرا","لأعبقَ من توجّعها ملّوى",33,"و",2,0],["وَتَرْشُقُنِي مِنْها سِهاماً كأَنَّها","سِهامُ أَبِي سُلْطانَ فِي مَعْرَكِ الجَمْعِ",34,"ع",1,0],["وَتَرْشُقُنا بِالنَّبْلِ مِنْهُنَّ أَعْيُنٌ","مِراضٌ مِنَ السَّقْمِ الرَّدِيءِ صِحاحُ",35,"ح",1,0],["وَتَرَشَّفْتُ مُداماً","مِنْهُ يُزْرِي بِالمُدامِ",36,"م",1,0],["وَتَرُشُّ نظرَتُها فَساتينَ الضِّيا","فبكلِّ نَهْرٍ يزدهي فُستانُ",37,"ن",1,0],["وَتَرُشُّ فَوْقَ ثَرَاكِ عِطْرَ شَهَادَةٍ","مُزِجَتْ بِمِسْكِ الحُبِّ والرَيْحانِ",38,"ن",1,0]]}