//poetry.dctabudhabi.ae/diwan/poem/31516","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120548","الطويل"],[5183,"مُلعِزَه رق204م","https://www.poetsgate.com/ViewPoem.aspx?id=186394",""],[5246,"بين الربى وعلى ضفاف الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=187024",""],[5782,"ما الشعر؟","https://www.poetsgate.com/ViewPoem.aspx?id=185756",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""],[3986,"عزلت الجن والجنان عني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502415",""],[6198,"أجنحة الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79236&r=&rc=10",""]],"verses":[["وَخِزانَةُ التاريخِ ساعَةَ عَرضِها","لِلفَخرِ خَيرُ كُنوزِها ماضيكِ",0,"ك",1,0],["وخُزْرَ عيُونٍ لم تكنْ لَحظَاتُها","لتصدُرَ إلا عن قُلوبٍ رَواجفِ",1,"ف",1,0],["وخزانة النسب المطه","هر من سلالة آل طه",2,"ه",1,0],["وخزيكم من كتبهم وافتضاحكم","لدى الله يوم العرض أخزى وأعطب",3,"ب",1,0],["وخزيمٌ كنانةُ النضرُ والما","لكُ فهرٌ وغالبٌ واللواءُ",4,"ا",2,0],["وخزت من المجد الرفيع مكانة","سموت بها قدرا على هامة السنر",5,"ر",1,0],["وخز البلى منها الغوارب والذرى","فلفتن خزراً بالعيون الشوس",6,"س",1,0],["وخزياً لِوجهٍ هانَ فِي صَوْنِ أَوْجُهٍ","كريمٍ بهم رِبْحِي لَئيمٍ بهم تَجْرِي",7,"ر",2,0],["وخَزَّ على الأحفاضِ كلُّ مُعمَّدٍ","أطال الأواسي في الثَّرى والأواخيا",8,"ي",2,0],["وخز اليراع كوخز الرمح في الألم","فاضرب بأيهما من شئت وانتقم",9,"م",1,1],["وَخَزَّنتُها في دَنِّها وَكَسَوتُهُ","مِن خَيشِ مِصرٍ وَالعَباءِ جِلالا",10,"ل",2,0],["وخزامى شممت من","نفحاتي وعرفجا",11,"ج",2,0],["وخَزائنُ الأصدافِ تَنثِرُ بيننا","دُرَراً تُزَانُ بها المَعاصِمُ والطُلَى",12,"ا",1,0],["وَخَزَّ السوسِ وَالإِضري","جَ فَصَّلَ بَينَهُ السَرَقُ",13,"ق",1,0],["وَخَزائِنَ الأَرضِ اِحتوا","ها فِكرُهُ حِفظاً وَعِلما",14,"م",2,0],["وخزائن الاحسان عندك سيدي","ملأى فيا فوز الذي لك يقصد",15,"د",1,0],["وخزمهم بمعجم الزاي وضع","في أول البيت ومن وزن منع",16,"ع",1,0],["وخزم بيت جائز في الأول","من واحد لأربع كاشدد علي",16,"ي",1,0],["وخزم الشفاه كالنوافذ أرشه","من الدية العظمى بثلث يقلل",17,"ل",1,0],["وخزقها رجسٌ ورجسٌ من ال","ضفدع إن جاءت من البر",18,"ر",1,0],["وخزائنُ من هو المولى","لك تفعل ما تشا ترد",19,"د",1,0],["وخزانة الأدب الجميل فلا يرى","فيما حوته اثنان يختلفان",20,"ن",1,0],["وَخْزُ الأَسنَّة والخُضوعُ لناقصٍ","أَمران، في ذوق النُهى، مُرّان",21,"ن",1,1],["وخز من الدهر لي من كل واجهة","شوك ويندر فيما بينه الزهر",22,"ر",1,1],["وخزيَهُ بالمرأة البلّانَهْ","برأسها طبليّةٌ ملآنهْ",23,"ه",1,0],["وخزى الرجل يخزَى خِزيا","من الهوان ومن الاستحيا",24,"ي",2,0],["وَخزتُ مطيَّة العَزم المشوقِ","لادركَ صاحبَ الفَضلِ العَريقِ",25,"ق",1,1],["وَخَزّالٌ لِمَولاهُ إِذا ما","أَتاهُ عائِلاً قَرِعَ المُراحِ",26,"ح",1,0],["وخزى عليك اليوم ان كنت عالما","وانت لدى قس يهينك خادم",27,"م",1,0],["وخزته شوك الهوى وأرته","آية البر وهي ثم عفاء",28,"ا",2,0],["وخزام معقل كل وال نافذ","سلطانه في شرق أرض عمان",29,"ن",1,0],["وخزانُ أطيافٍ وقلعةُ طالبٍ","لحكمة عقل وحْيُها كالحمائمِ ؟",30,"م",1,0],["وخزانُ أشباح وبئرُ تصوُّرٍ","ورنَّاتُ أصداءٍ ولوحاتُ راسمِ ؟",30,"م",1,0],["وخزانات جوه اتمدت وعين انسدت","وع الطوابي اللي انهدت حانحط غفير",31,"ر",1,0],["وَخِزيٌ في الحَياةِ وَإِن يَموتوا","يُلاقوا ما تَضيقُ بِهِ الصُدورُ",32,"ر",1,0],["وخزائن الكلمات أقفل بابها","من روعةٍ... وملاحةٍ... سلطانُ",33,"ن",1,0]]}