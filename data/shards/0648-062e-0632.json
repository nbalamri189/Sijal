{"poems":[[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[61,"قضى بوقوف الركب حق المواقف","https://www.aldiwan.net/poem51551.html","الطويل"],[113,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[208,"تراءت لك الأيام باسمة الثغر","https://www.aldiwan.net/poem13519.html","الطويل"],[308,"ضحكت وجوه الدهر بعد عبوس","https://www.aldiwan.net/poem59511.html","الكامل"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[459,"شموس المواضي ان بغيت الأمانيا","https://www.aldiwan.net/poem15466.html","الطويل"],[477,"وخز اليراع كوخز الرمح في الألم","https://www.aldiwan.net/poem37183.html","البسيط"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[556,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[560,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"]],"verses":[["وَخِزانَةُ التاريخِ ساعَةَ عَرضِها","لِلفَخرِ خَيرُ كُنوزِها ماضيكِ",0,"ك",1,0],["وخُزْرَ عيُونٍ لم تكنْ لَحظَاتُها","لتصدُرَ إلا عن قُلوبٍ رَواجفِ",1,"ف",1,0],["وخزانة النسب المطه","هر من سلالة آل طه",2,"ه",1,0],["وخزيكم من كتبهم وافتضاحكم","لدى الله يوم العرض أخزى وأعطب",3,"ب",1,0],["وخزيمٌ كنانةُ النضرُ والما","لكُ فهرٌ وغالبٌ واللواءُ",4,"ا",2,0],["وخزت من المجد الرفيع مكانة","سموت بها قدرا على هامة السنر",5,"ر",1,0],["وخز البلى منها الغوارب والذرى","فلفتن خزراً بالعيون الشوس",6,"س",1,0],["وخزياً لِوجهٍ هانَ فِي صَوْنِ أَوْجُهٍ","كريمٍ بهم رِبْحِي لَئيمٍ بهم تَجْرِي",7,"ر",2,0],["وخَزَّ على الأحفاضِ كلُّ مُعمَّدٍ","أطال الأواسي في الثَّرى والأواخيا",8,"ي",2,0],["وخز اليراع كوخز الرمح في الألم","فاضرب بأيهما من شئت وانتقم",9,"م",1,1],["وَخَزَّنتُها في دَنِّها وَكَسَوتُهُ","مِن خَيشِ مِصرٍ وَالعَباءِ جِلالا",10,"ل",2,0],["وخزامى شممت من","نفحاتي وعرفجا",11,"ج",2,0],["وخَزائنُ الأصدافِ تَنثِرُ بيننا","دُرَراً تُزَانُ بها المَعاصِمُ والطُلَى",12,"ا",1,0]]}