{"poems":[[47,"أبقاك ربك في عز وتأييد","https://www.aldiwan.net/poem63547.html","البسيط"],[236,"يا قسوة القلب مالي حيلة فيك","https://www.aldiwan.net/poem44559.html","البسيط"],[382,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[398,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107229","الخفيف"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59214","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128886","الخفيف"],[4859,"صعبٌ بأن تنسى وأن أنساها!","https://www.poetsgate.com/ViewPoem.aspx?id=207792",""],[4869,"روس الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=138049",""],[182,"من لي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=72826",""],[5823,"كم تقت للأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=61555",""],[5829,"خطاب لم يصل","https://www.poetsgate.com/ViewPoem.aspx?id=152684",""],[6224,"نَبِيُّ الوجع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88199&r=&rc=14",""],[6300,"كلمات في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82851&r=&rc=22",""]],"verses":[["يا قَسمَ لا تَذكُرَن عَهدَن وَتُخلِفُهُ","فَالقَلبُ يُؤلِمُهُ خَلفُ المَواعيدِ",0,"د",1,0],["يا قسوة القلب مالي حيلة فيك","ملكت قلبي فأضحى شر مملوك",1,"ك",1,1],["يا قِسطَ مَنٍّ يا عَصا هرونَ بل","يا جِزَّةً تَخضَلُّ بالأنداءِ",2,"ا",2,0],["يا قَسيمَ النارِ وَالجَن","نَةِ لا تَخشى اِشتِباها",3,"ا",3,0],["يا قَسِيمِي هَذا المُصَابَ تَرَفَّق","فَلِرَبِّي فِي حالِنا نَظَراتُ",4,"ت",1,0],["يا قسوة لم يجد فيها موعد","قر ولا حامي التوعدآن",5,"ن",1,0],["يَا قُسَاةَ القُلُوبِ رِفْقًا بِقَلْبٍ","لَمْ يَكُنْ قَطُّ يَألَفُ الأحْجَارَا",6,"ر",2,0],["يا قساة القلوب هلا رأفتم","بضعاف من صبية ونساء",7,"ا",2,0],["يا قسوةَ الأيّامِ كيف أتت لنا","من بعدِ حلو حياتِنا أشقاها",8,"ا",3,0],["يآقسآه ويآرضآه .. ويآحرآم","لآ مسآه ولآ صبآحه بل ريق",9,"ق",1,0],["يا قسيمَ الروحِ رفْقا ً","أعطٍني هَدْأةَ نفسي",10,"س",2,1],["يا قسيمَ الروحِ منْ لي؟","أرتجيهِ يومَ بؤسي",10,"س",2,0],["يا قسوة الأخبارِ من وطني","إنّي أتوقُ اليومَ للبَطَلِ",11,"ل",1,0],["يا قسوة الأيام كيف تصرّفت","إن أضمرت أمرا تقضّ وتفجع",12,"ع",1,0],["يا قَسْوَةَ الصَّيْفِ حينَ الدارُ يَسْكُنُها","نايٌ وَحيدٌ لِقَلْبٍ مُهْتَري القَصَبِ",13,"ب",1,0],["يا قسوة الزمنِ السجّان في خلدي","صارتْ حروفي, قرودًا ,طلقة, بجعا",14,"ع",2,0]]}