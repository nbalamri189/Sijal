{"poems":[[171,"واحة الوجه","https://www.aldiwan.net/poem1035.html",""],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145637","المديد"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143011","الخفيف"],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5943,"يابحور الشعر غني واهتفي","https://www.poetsgate.com/ViewPoem.aspx?id=37260",""],[6143,"حسبنا أن نتفق","https://www.poetsgate.com/ViewPoem.aspx?id=34953",""]],"verses":[["واحةُ الوجهِ وبستانُ المحيَّا","جعلاني ميتاً فيكِ وحيَّا",0,"ي",2,1],["وَاحَةُ الأشْجَانِ بَيْنَ دَمِهْ","تَقْتُلُ الألْحَانَ دُونَ فَمِهْ",1,"ه",1,0],["واحة أثمرت فما جاع فيها","لاجىء خائف ولم يشك حالا",2,"ل",2,0],["واحةٌ للجمال ، قلبي فيها","من أسى الدَّهر نَاسكٌ مُتغزّلْ",3,"ل",1,0],["واحةُ الآدابِ دارُ سميرِنا","للإخوَّة دارُ أهلِ المصحفِ",4,"ف",1,0],["واحة الحب الشجيْ جهد ماض يختنقْ","كنت ربا أرتجي , إنما قد نعتزقْ",5,"ق",1,0]]}