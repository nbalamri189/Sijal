{"poems":[[79,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[53,"مطايب عيش زايلته مخابثه","https://www.aldiwan.net/poem9226.html","الطويل"],[31,"عفا دير لبى من أميمة فالحضر","https://www.aldiwan.net/poem6041.html","الطويل"],[30,"رأى عبد قيس خفقة شورت بها","https://www.aldiwan.net/poem5050.html","الطويل"],[30,"طويل عماد البيت تبني مجاشع","https://www.aldiwan.net/poem5286.html","الطويل"],[77,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[52,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[52,"أعاتك بعض الود مر ممزج","https://www.aldiwan.net/poem63986.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39665","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54713","المجتث"],[30,"جزى الله عني في الأمور مجاشعا","https://www.poetsgate.com/ViewPoem.aspx?id=2461",""],[128,"ليت الوقوف بوادي السير إِجباري","https://www.aldiwan.net/poem23722.html","البسيط"],[173,"لذا اليوم أعملت القلاص العباهلا","https://www.aldiwan.net/poem1655.html",""],[186,"من آل صافي الأكرمين فقيدة","https://www.aldiwan.net/poem61196.html","الكامل"],[186,"من آل صباغ الكرام كريمة","https://www.aldiwan.net/poem66903.html","الكامل"],[203,"من الصدع في قلبي غداة تهدما","https://www.aldiwan.net/poem45161.html","الطويل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[280,"لمن كلم كاللؤلؤ المتناسق","https://www.aldiwan.net/poem25423.html","الطويل"],[354,"من الصهباء بالنشر","https://www.aldiwan.net/poem15719.html","الهزج"],[422,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[422,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[435,"من الصبابة تثني القد نيروز","https://www.aldiwan.net/poem40501.html","البسيط"],[509,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[592,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/112999","البسيط"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/198730","الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/198770","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46549","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93101","الرجز"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131546",""],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132225","المجتث"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11195","الطويل"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130678","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69423","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69320","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69385","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53051","الهزج"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28046","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87338","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31512","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200807","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202713","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74213","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132732","الكامل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125986","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68017","الطويل"],[3444,"","https://poetry.dctabudhabi.ae/diwan/poem/130736","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62887","الطويل"],[3694,"","https://poetry.dctabudhabi.ae/diwan/poem/203554","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21405","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131304",""],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199111","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90846","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4701,"ثلاثون عامًا تمرُّ الظباءْ","https://www.poetsgate.com/ViewPoem.aspx?id=45009",""],[4978,"تحية لأستاذتي نادية بوغرارة","https://www.poetsgate.com/ViewPoem.aspx?id=189774",""],[5002,"جائحةُ العصرِ.....","https://www.poetsgate.com/ViewPoem.aspx?id=211792",""],[5017,"إني امرؤ غافقي ليس لي حسب","https://www.poetsgate.com/ViewPoem.aspx?id=187189",""],[5150,"سناء","https://www.poetsgate.com/ViewPoem.aspx?id=202796",""],[5277,"هلال الكرخ","https://www.poetsgate.com/ViewPoem.aspx?id=188113",""],[5277,"خاتمة المرام","https://www.poetsgate.com/ViewPoem.aspx?id=198362",""],[5277,"في عيدها","https://www.poetsgate.com/ViewPoem.aspx?id=205393",""],[5277,"سما بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=206860",""],[5316,"ثأرت ركاب العير منهم بهجمة","https://www.poetsgate.com/ViewPoem.aspx?id=52806",""],[5341,"أخافُ","https://www.poetsgate.com/ViewPoem.aspx?id=185802",""],[5770,"تكريم المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=178686",""],[5997,"المنصور اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=215047",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["منَ الصُّفْرِ إلا أنّها عرَبيّةٌ","إذا اجْتُلِيَتْ فيها سِماتُ بَني سَعْدِ",0,"د",1,0],["من الصالحين المُصلحينَ بيُمنهِ","غدا العيشُ محموداً ولُمَّتْ مشاعِثُهْ",1,"ث",2,0],["مِنَ الصُوَرِ اللاتي يَرَحنَ إِلى الصِبا","تَظَلُّ إِلَيها تَنزِعُ النَفسُ وَالهَجرُ",2,"ر",1,0],["مِنَ الصُمِّ تَكفي مَرَّةً مِن لُعابِهِ","وَما عادَ إِلّا كانَ في العودِ أَحمَدا",3,"د",2,0],["مِنَ الصُمِّ إِن تَعلُكَّ مِنهُ شَكيمَةٌ","تَمُت أَو تُفِق قَد ماتَ عَقلُكَ أَجمَعُ",4,"ع",1,0],["من الصائداتِ الإنسَ بينَ جُفونها","إذا ما جرَتْ بَرْقٌ وفي ريشها رَعد",5,"د",1,0],["مِنَ الصيدِ وَلّاغُ الدِماءِ إِذا غَدا","وَمُستَمطِرُ المَعروفِ وَقراً عَلى وَقرِ",6,"ر",1,0],["مِنَ الصيدِ مَكتوبٌ عَلى حُرِّ وَجهِهِ","جَوادُ قُرَيشٍ هاشِمِيٌّ مُتَوَّجُ",7,"ج",1,0],["من الصين حتى ساحل الغربِ عالمٌ","به المسلمون الأولونَ تقدموا",8,"م",3,0],["مِنَ الصَّبَابَةِ مَهْدِي","ومِنْ سَقَامِي وِسَادِي",9,"د",2,0],["مِنَ الصُّمّ إنْ تَعْلُكْكَ منه شكيمةٌ","تَمُتْ أوْ تُفِقْ قد بادَ عَقلُكَ أجمعُ",10,"ع",1,0],["من الصبابات أَقضي بعض ما برحت","به تشبث رغم الشيب أَظفاري",11,"ر",2,0],["مِنَ الصارِمِ الهِنديّ أَمضى عَزائِماً","وَأَصدَقَ مِن نَوءِ الثُرَيّا مَخائِلا",12,"ل",2,0],["مِن آلِ صافي الأَكرَمينَ فَقيدةٌ","نزَلَ الثَرى مِنها تُقَىً وَجمالُ",13,"ل",1,1],["مِن آلِ صَبّاغَ الكِرامَ كَريمةٌ","كَالبَدرِ واراها ضَريحٌ مُظلمُ",14,"م",1,1],["من الصدع في قلبي غداةَ تهدَّما","سمت نظراتُ الروح خلفك للسما",15,"م",2,1],["مِن الصِّفاتِ المَعنَوِيَّةِ حلمُهُ","وَالصَّفحُ عَن ذَنبِ المُسيءِ الجاني",16,"ن",2,0],["مِن الصَّفْوةِ الأَبْرار صِيغُوا وَصُوِّرُوا","لِمَوتِ أَعِادٍ أَو حَياةِ أَصَادِقِ",17,"ق",1,0],["مِنَ الصَهباءِ بِالنَشرِ","وَمِن طَيِّ البِلى نَشري",18,"ر",2,1],["من الصّيد سبَّاق المقال بفعله","وقلَّ قؤولٌ في الأَنام فعول",19,"ل",1,0],["من الصيد لا يستصعب الحتف إنْ دنا","ولا باتَ يشكو للخطوب أذاها",20,"ا",3,0],["من الصبابة تثني القد نيروزُ","عند التحية أم دلٌ وتعزيزُ",21,"ز",1,1],["من الصفو عكسٌ عن سواد قد يدتي","على خده حين التشهد قد بدا",22,"ا",1,0],["مِن آَلِ صَعفوقٍ وأَتباعٍ أُخَر","مِن طامِعينَ لا يُبالونَ الغَمَر",23,"ر",1,0],["مِنَ الصَفا العاسي وَيَدهَسنَ الغَدَر","عَزازَهُ وَيَهتَمِرنَ ما انهَمَر",23,"ر",1,0],["مِنَ الصِحابِ وَمَتاعُ المُرمِلِ","سامٍ إِلى المَعلاةِ غَيرُ حَنبَلِ",24,"ل",1,0],["من الصحب في عهد النبي وبعده","إلى أن أجيزت في عقوبة عادل",25,"ل",1,0],["مِنَ الصحابةِ سبعٌ كالنجومِ ومن","بني أميَّةَ اثنانِ تلي عشرا",26,"ر",2,0],["من الصَّحراء جئتَ كَنوِر بدر","يبدِّد في بَوادينا الظلاما",27,"م",2,0],["مِنَ الصَعبِ تِكرَارُ أمثالِهِ","وذو الحظِّ مَنْ عَاشَ يوماً زمانَهْ",28,"ن",2,0],["منَّ الصَّنيع يفسده","وَمطله ينكده",29,"ه",1,0],["من الصلاح وجهه كأنه","وجه الصباح بهجة إذا بدا",30,"د",2,0],["من الصِّغَر سابقَ الجله","فكان له السبق في الميدان",31,"ن",1,0],["من الصلاة دواما","واو وكاف وفاء",32,"ا",2,0],["مِنَ الصُّفرِ لا وَرهاءُ سَمجٌ دَلالُها","وَلَيسَت مِنَ السّودِ القِصارِ الحَوائِلِ",33,"ل",1,0],["من الصدود فما الاعراب تفعل ما","فعلت بالصب عند الفوز بالسلب",34,"ب",1,0],["من الصدر والجردانِ والضفن إنه","يخرج مقد الراس في الحكمِ يعدلُ",35,"ل",1,0],["مِنَ الصالِحيِّينَ الَّذينَ تَطَوَّلُوا","فَطالُوا وَجَلَّوا كُلَّ بُؤسٍ وَفَرَّجُوا",36,"ج",3,0],["مِنَ الصالِحيّينَ الَّذينَ تَمَرَّدوا","عَلى الخَطبِ مُذ كانوا كُهولاً وَهُم مُردُ",37,"د",1,0],["مِنَ الصالِحِيِّينَ الَّذينَ تَقَلَّدُوا","سُيُوفاً إِذا سَلُّوا أَذِبَّتَها ذَبّوا",38,"ب",3,0],["مِنَ الصِّيد الصناديد","من الشمِّ الشَّنَاخِيبِ",39,"ب",1,0],["من الصفاتِ التي جاءت مرتبة","على الحقائق في حاف ومنتعل",40,"ل",1,0],["مِنَ الصِّينِ لِلإفرَنجِ تَسهَرُ آمِناً","على كلِّ بَحرٍ إن عَرَفتَ أشَايِر",41,"ر",1,0],["مِنَ الصِّينِ لللإفرَنجِ يَعمَلنَ مَشرِقاً","وَغَرباً إذا قِيسَت وَكُلِّ المَضَارِبِ",42,"ب",1,0],["مِنَ الصُحمِ ميفاءُ الرُزونِ كَأَنَّهُ","إِذا صاحَ في وَجهٍ مِنَ اللَيلِ ناشِدُ",43,"د",1,0],["من الصبح مذ شاهدت جيشاً من الظبّا","إلى الآن عقلي لم يعد لمكانه",44,"ه",1,1],["من الصبح الصراعُ بدون نصر","ولا أدري النتيجة كيف تمسي",45,"س",2,0],["مِن الصيد الأولى بِالمَجد طالوا","لَهُم دانَت بَنو الدُنيا جَلالا",46,"ل",2,0],["من آل صدر الدين ان جلسوا","كانوا الصدور القالة العلما",47,"م",2,0],["من آل صقلب والإفرنج كلهم","والقوط والهنُّ والسكسون والعصب",48,"ب",1,0],["من الصُّدَف اللائي جَلَبْنَ ليَ الهَوى","وأَسْبَلْنَ من عيني غزيرَ المَدامعِ",49,"ع",1,0],["من الصبيةِ للحسيانِ بعدهُمَا","خرقٌ إلى غار مسعُودِ بن مسعادِ",50,"د",1,0],["من الصمِّ أَعيا حادثَ الدَّهْر كيدُهُ","تَصَرَّمَ ليلٌ دونَه وَنَهَارُ",51,"ر",1,0],["من الصهب أثناء وجدعاً كأنها","عذارى عليها شارة ومعاصر",52,"ر",1,0],["مِنَ الصَاحِبِ الفَردِ القَريبِ مُعادياً","إِذا كانَ في جيرانِ بَيتٍ تُجاوِرُه",53,"ر",2,0],["من الصدف اللماع صيغ أديمها","ولم يك لولا ذلك الصدف الدر",54,"ر",1,0],["من الصيد الكرام نماه بيت","إلى قحطان في أعلى مكان",55,"ن",1,0],["من الصالحين الوارثين الذي هم","ائمتنا حتى إلى السيد المهدي",56,"د",2,0],["من الصفا جسمٌ ولكنْ ترى","على صَفاءِ الماءِ تامورَهْ",57,"ر",2,0],["من الصخر يطحن بعض الدقيق","ويصنع من غيمتين الحساء",58,"ا",2,0],["من الصباح أراها فيه ساعية","ولا تكلّ به حتّى تمسّيه",59,"ي",2,0],["مِنَ الصِّين \" كابوسٌ \" لقد حلَّ جَمرةً","على أمَمٕ والموتُ فينا مُباغث ُ ُ",60,"ث",1,0],["من آل صبرة قدما قد سمعت بهم","سحب إذا وهبوا أسد إذا صالوا",61,"ل",3,0],["من الصرفِ يُمنعُ إسمُ سناءْ","ويصرفُ.. يعربُ.. يُبنى سناءْ",62,"ن",3,0],["من الصوبينِ ضاحكني هلالٌ","وقلبي يشتهي في الكرخِ وردَهْ",63,"د",2,1],["من الصلواتِ يسبقها وضوءاً","بماءِ المكرماتِ على الدوامِ",64,"م",1,0],["من الصلصالِ كنا ذاتَ يومٍ","وفي أحلامِنا الخضراءَ ماءُ",65,"ا",2,0],["من الصوبين مخضوبٌ دجاها","بحنّاءِ المواجعِ والرهابِ",66,"ب",1,0],["من الصهب أثناء وجذعنا كأنها","عذارى عليها شارة ومعاصر",67,"ر",1,0],["من الصوتِ والظلمِ والبُعدِ والعُذر","أخافُ من النارِ والعصْفِ والهجر",68,"ر",1,0],["من الصناديد أبطالا، لبوسهُمُ","من الدروع تَفِلُّ النَبعَ والغَرَبا",69,"ب",2,0],["من الصحبِ محمود أوصافهِ","وهذا من اعلامِ ليث الشخب",70,"ب",1,0],["من الصُبح لاوضح النجم بالسَما","وَحنا نشالش وَالدما سيال",71,"ل",1,0]]}