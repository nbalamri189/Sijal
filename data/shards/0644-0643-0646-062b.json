{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[415,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[983,"","https://poetry.dctabudhabi.ae/diwan/poem/114044","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144014","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60830","الكامل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11305","البسيط"]],"verses":[["لَكِنَّ ثَمَّةَ أُمَّةً","عَظُمَتْ بِنَشْأَتِهَا العَتِيدَهْ",0,"د",2,0],["لكن ثِقاتُك ما زالوا بِغِشِّهِمُ","حتى استوتْ عندَكَ الأنوارُ والظُّلَمُ",1,"م",1,0],["لكن ثقي ريحانتي أني إلى","هذا الهوى بحقيقتي ويقيني",2,"ن",2,0],["لكن ثناني عن فراقهما","علمي بأن الناس قد خس",3,"س",1,0],["لكن ثبوت صفاته وكلامه","وعلوه حقا بلا نكران",4,"ن",1,0],["لكنّ ثناني العجزُ دون رِفاقتي","فبعثتُ طِرسي والثناءَ السرمدا",5,"د",2,0],["لَكِن ثَنائي أَن أَجزِيَكَ سَيِّئَةً","حِفظُ النِدامِ وَإِكرامي بَني عَمَلي",6,"ل",2,0]]}