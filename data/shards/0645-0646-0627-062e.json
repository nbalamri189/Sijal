{"poems":[[55,"لحب إلي بالدهناء ملقى","https://www.aldiwan.net/poem29852.html","الوافر"],[55,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[79,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[32,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[29,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[53,"من أخذ الحذر من المحذور","https://www.aldiwan.net/poem63005.html","الخفيف"],[53,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[31,"لعمري لقد أسريت لا ليل عاجز","https://www.aldiwan.net/poem6023.html","الطويل"],[30,"إليك سبقت ابني فزارة بعدما","https://www.aldiwan.net/poem5602.html","الطويل"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[50,"حميد ماذا دهاكا","https://www.aldiwan.net/poem66560.html","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[102,"في الشاطىء الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=50418",""],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[147,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[154,"خذها إليك أبا إسحاق عن عجل","https://www.aldiwan.net/poem68543.html","البسيط"],[154,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[237,"ما لي وللاحي عليك يعنف","https://www.aldiwan.net/poem14814.html","الكامل"],[276,"أرى برق الغوير اذا تراءى","https://www.aldiwan.net/poem52103.html","الوافر"],[303,"ردي علي رقادي فهو مختلس","https://www.aldiwan.net/poem36304.html","عموديه"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[325,"قل للمعالي ترطب مسمعي طربا","https://www.aldiwan.net/poem67218.html","البسيط"],[385,"من مسعدي من عذيري","https://www.aldiwan.net/poem48807.html","المجتث"],[435,"ما للمعالي تفيض الدمع مدرارا","https://www.aldiwan.net/poem38732.html","البسيط"],[445,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[543,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[556,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[556,"إن عاقب الشيب السواد بمفرقي","https://www.aldiwan.net/poem47899.html","الكامل"],[590,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38083","السريع"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146417","الدوبيت"],[1155,"","https://poetry.dctabudhabi.ae/diwan/poem/203311",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136327","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46536","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50021","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50026","المتدارك"],[1973,"","https://poetry.dctabudhabi.ae/diwan/poem/145494","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88666","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124600","الطويل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201921","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62750","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138599",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66364","السريع"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66320","السريع"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132098","الكامل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139838",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102933","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103010","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111475","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77054","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101378","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102728","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102751","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141605","الكامل"],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4701,"يَحْكِي لعينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=50541",""],[4859,"عصر الشياطين!","https://www.poetsgate.com/ViewPoem.aspx?id=191635",""],[4903,"يا رب فتيَانِ صِدق رحتُ بينهم","https://www.poetsgate.com/ViewPoem.aspx?id=96544",""],[4940,"سطوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=205547",""],[4984,"عيد الشجرة","https://www.poetsgate.com/ViewPoem.aspx?id=180037",""],[5026,"بردة أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=210479",""],[5119,"النرد","https://www.poetsgate.com/ViewPoem.aspx?id=196606",""],[5277,"قبضةٌ من أثرِ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=210888",""],[5409,"حياك وادي الرافدين وما به","https://www.poetsgate.com/ViewPoem.aspx?id=155250",""],[5431,"بكتاب عشقي اودعتْ كي أفتحه !!","https://www.poetsgate.com/ViewPoem.aspx?id=197671",""],[5736,"من أغمد النصل بأضلعك","https://www.poetsgate.com/ViewPoem.aspx?id=208284",""],[5776,"إني أرى ما لا ترونْ","https://www.poetsgate.com/ViewPoem.aspx?id=205837",""],[5879,"غربل ترابك","https://www.poetsgate.com/ViewPoem.aspx?id=215401",""],[5909,"مناخ كذات الليل يرخي سدولَه","https://www.poetsgate.com/ViewPoem.aspx?id=210601",""],[5943,"جنَّةُ النارِ","https://www.poetsgate.com/ViewPoem.aspx?id=41590",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""],[6093,"ضلعُ آدم ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176003",""],[6142,"من فالق الكبش من قرن إلى قدم","https://www.poetsgate.com/ViewPoem.aspx?id=155714",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""]],"verses":[["مُناخُ مُطَلَّحينَ تَقاذَفَتهُم","غَريبُ الحاجِ وَالهِمَمِ العَوالي",0,"ل",2,0],["مَن أَخطَأَتهُ سِهامُ المَوتِ قَيَّدَهُ","طولُ السِنينَ فَلا لَهوٌ وَلا جَذَلُ",1,"ل",1,0],["مِنْ أَخضَرٍ كالحِبْرِ أَوْ مِنْ أَشْقَرٍ","كَالتِّبْرِ أَوْ مِنْ أَحْمَرٍ كَالْعَنْدَمِ",2,"م",1,0],["مُناخَ قُرونِ الرُكبَتَينِ كَأَنَّهُ","مُعَرِّسُ خَمسٍ مِن قَطاً مُتَجاوِرِ",3,"ر",1,0],["مَناخِرُ شانَتها القُيونُ كَأَنَّها","أُنوفُ خَنازيرِ السَوادِ القَوابِعِ",4,"ع",1,0],["من أخذ الحذر من المحذورِ","قلّ تجنِّيه على المقدورِ",5,"ر",1,1],["مَنْ أخَفْ خُلْفَهُ فما زال ميعا","دُك عندي كأنَّه ميثاقُك",6,"ك",1,0],["مُناخِ ذَوي الحاجاتِ يَستَمطِرونَهُ","عَطاءَ كَريمٍ مِن أُسارى وَمِن نَهبِ",7,"ب",1,0],["مُناخٌ لِأَهلِ الأَرضِ يَجمَعُ بَينَهُم","لِمُطَّلِبي الحاجاتِ غُبرُ المَخارِمِ",8,"م",1,0],["مِن آخِذٍ لَكَ نَعلاً","وَآخِذٍ مِسواكا",9,"ك",2,0],["من آخذٍ لكَ نعلاً","وآخذٍ مِشواكا",10,"ك",2,0],["مَنْ أَخْطَأَ الأُولَى فَظلَّ عَلى","إِيمَانِهِ لمْ يُخْطِيءِ الأُخْرَى",11,"ر",2,0],["من أخبرتني عنك ؟ لا أحد","من دلّني ..؟ عيناك شيطاني",12,"ن",2,0],["مناخٌ له رحب الفنا جفلت له","بمدح تليد ذالقات مجرجما",13,"م",2,0],["مِن آخِذٍ بِمَضَلَّةٍ أَو عائِدٍ","بِمَذَلَّةٍ أَو عائِذٍ بِأَمانِ",14,"ن",1,0],["من أخطأ السَّمت والظلماء عاكفة","لم يهد مقلته إلاَّ سنى القمر",15,"ر",1,0],["من اختَصَّهُ بِالسَعدِ حُكمُ إِلَهِهِ","فَلَم يَنأَ عَن إِرشادِهِ لِسَفاهِهِ",16,"ه",1,0],["مَن آخِذٌ بِيَدي وَقَدَّكَ عامِلٌ","لا يَسمَعُ الشَكوى وَصَدغُكَ مُشرِفُ",17,"ف",1,0],["من اختار الوَسيلَة في المَعالي","ومن اوتى الوَسيلة وَاللواء",18,"ا",2,0],["مَنْ آخذٌ بيدي مما أُكابدُه","فإِنَّ ما بيَ قد حارَتْ به النطس",19,"س",1,0],["من أخيفين لكل نصف منهما","ولمهمل ولمعجم أنباءُ",20,"ا",2,0],["مَن أَخلَصَ السَعدُ إيفاءً بِخِدمَتِهِ","وَلَم يُفارِق لَهُ طولَ المَدى عَتبا",21,"ب",2,0],["مِن آخذ بِيَميني","مِن جور ظَبي غَرير",22,"ر",1,0],["من أخصب العدل في أيامه وزهت","رياضه فاجتناها الناس أثمارا",23,"ر",2,0],["مَنِ اخْتَرَقَ الدُّنْيَا لأَوَّلِ دَعْوَةٍ","إِلَى دَعْوَةِ الإِسلامِ فافْتَكَّ غُلَّها",24,"ل",3,0],["مِن أخٍ مُخلِصٍ إليكَ كما تَع","هَدُه مِن سنينَ ذاتِ اعتِبارِ",25,"ر",1,0],["مَنْ أخرج اللّيثَ مِن ذاك العرين ومَن","حطّ المحلِّقَ في العلياءِ مِن عالِ",26,"ل",1,0],["مَنْ أخْطَأَتْهُ وقد رمتْ قوسُ الرّدى","تبيضُّ منه مفارقٌ ومسائحُ",27,"ح",1,0],["مُناخُ للأَراذل منذ كانت","محرَّمَةٌ على الحرّ الكريم",28,"م",1,0],["مَن أَخلَصَ الوُدَّ بِحُبِّ اِمرِئٍ","بِغَيرِ عينِ الودِّ لا يُلْحَظُ",29,"ظ",1,1],["من أخمصه لثما الى وجنته","حتى اشتكت القضب وضجّ الورد",30,"د",1,0],["من آخذ من خدّه","بدم الشهيد المغرمِ",31,"م",1,1],["من اخوة الصدق وأحزابه","من كل بر مستقيم عليم",32,"م",1,0],["مِن أَخبَث الأَعمال","عَداوة الرِّجال",33,"ل",1,0],["من اخر البا سمِّها مجموعه","لجمعةٍ بذيلها موضوعه",34,"ه",1,0],["من اختار نقصَ المالِ أَورثَه الفضْلا","ومن طاب فرعاً دلَّ أَن قد زكا أصلا",35,"ل",2,1],["منْ أَخطأ ليمَ ومن رُزِقَ","التّوفيق أَصابَ ولم يُلمِ",36,"م",1,0],["من أخضرٍ ناضرٍ والطل يلحقه","وأبيضٍ تحت قبطيِّ الضحى يَقِق",37,"ق",1,0],["من آخذ لي بحد السيف","بالحيف من فاتك الاجفان",38,"ن",1,0],["مَن آختَرعَ الفَرغَينِ ثُمَّ نُعُوشَهُم","على كُلِّ فَنٍّ شيتَهُ غَيرَ صَاخِبِ",39,"ب",1,0],["من آخرِ الخُنصُرِ لللإبهامِ","مُدَّ بهِ الذراعَ بالتَمامِ",40,"م",1,0],["من اختصهم رب الورى بين مغفَر","ببذل الندى والعدل والحلم والصبر",41,"ر",1,0],["مِن أَخدَرِيّاتِ الدَنا اِلتَفَعَت لَهُ","بُهمى النِقاعِ وَلَجَّ في إِحناقِ",42,"ق",1,0],["من أخلائَي كيف الارتقاءْ","وهم عنديَ والروح سَواء",43,"ا",2,1],["مَن أَخطأته سِهامها فَلَقَد نَجا","حيناً وَمن أَصمته فَهوَ بِها رَدي",44,"د",2,0],["من اخترمتَ فعينُ الحزمِ جئتَ بهِ","ومن وهبتَ فعينُ الجودِ والكَرَمِ",45,"م",1,0],["مناخ ركاب للوفود يخاله","إذا ما رأى الرائي الركاب معسكرا",46,"ر",2,0],["من أخضر دبجّه أحمر","وأصفر في لونه يفقع",47,"ع",1,0],["من أخرست في الدين أقواله","ألسن قسّيس وشماسِ",48,"س",1,0],["من أخوة وعمومة وخؤولة","من كوكب متنقلٍ وشهابِ",49,"ب",1,0],["من آخذ لي من الأيام مظلمة","ومنصفي من زمان السوء والغير",50,"ر",1,0],["مَنْ أخذَ الصّدقَ له سَفينةً","وفوَّضَ الأمرَ لذي الطَّول نجَا",51,"ا",1,0],["من آخذ بدم القتيل أراقه","في الترب بيض كواعب أتراب",52,"ب",1,0],["من آخذ بيد العليل تذيبه","لفحات وجدٍ لا يبوخ ضرامها",53,"م",3,0],["مِن أَخيلٍ أُنِيلَها مُذ غَزا إِس","كِيرُسا مِن إِيفِس وأحرَزَ وَفرا",54,"ر",2,0],["مَن أَخافَ العدى أَعز المَوالي","وَاِقتَنى في الأَنامِ جاهاً وَحَمدا",55,"د",2,0],["من آخذ بيديه حتى يشتكي","تعطيله لوزارة الأشغال",56,"ل",1,0],["من اخرس الفصحاء فصل خطابه","عجزا وحير سائر البلغاء",57,"ا",2,0],["من أخرس البلغاء منطق فضله","سيان ناثرهم أو النظام",58,"م",1,0],["منا خرجن وعقلنا يخرجن إذ","يدخلن أو يخرجن سفّه من مرى",59,"ر",2,0],["من أختصه بالجم من حسناته","ومن عليه بالنظام المفضل",60,"ل",1,0],["من آخرِ الأرضِ في المنفى يَظلُّ لنا","حلْمُ العصافير أنْ تأويْ إلى الأَيَكِ",61,"ك",1,0],["من أخرسوا لغةَ الأفراحِ واغتصبوا","مهدَ الأمان وأحلامَ الملايين !",62,"ن",1,0],["من أخضَرٍ ناضِرٍ والطلّ يَلحفُه","وأبيض تحتَ قبطيّ الضحى يَقَقِ",63,"ق",1,0],["من أخبرَ القلبَ أن الروحَ محضُ خطىً","تجري عليه وإن ضاقت به يقفُ؟!",64,"ف",1,0],["من أخضر الشجر المخزون من حقب","تحت الثرى مُحتوى في البحر والجزر",65,"ر",1,0],["من آخِر الكون جرَّ الدَّهْرُ منتشِيًا","خطْوي إليكَ ليَرْوِي القلبُ أغْنِيَتَكْ",66,"ك",1,0],["من أخبر النّرد أنّ الوقت أرملةٌ؟","شكٌّ.. وعنها يموتُ الصبر لا فيها",67,"ي",3,0],["من آخرِ الدنيا أتتْ بعبيرها","والياسمينُ بعطرها قد عُطِّرا",68,"ر",2,0],["من آخذ بيد الضعيف وضعفه","ذنبٌ به مستوجبٌ لعقابه",69,"ب",2,0],["من أخبر الشمشون أنّك شَعره","فإذا قُصصتَ سينتهي في مذبحة!!",70,"ح",2,0],["منْ أخبرَ الأزهارَ أن أريجَها","حدَّ الثمالةِ لا يفي بتضوّعِكْ ؟",71,"ك",1,0],["من آخرِ اللحظاتِ من","بدءٍ يصومُ عن الظنونْ",72,"ن",1,0],["مَنْ أَخْبَرَ الأَوْبَاشَ عَنْ صَمَّامِ بَاحَتِهَا؟","وَمَنْ أَوْشَى، فَدَكَّ قِلَاعَهَا؟",73,"ع",3,0],["مناخ كذات الليل يرخي سدولَه","عليّ ويضفى بالسواد مآليا",74,"ا",1,1],["من اخضرارِ البعيدِ اليومَ يقصدُها","غصنٌ من الرَّندِ بعدَ النَّفسِ ما يبستْ",75,"ت",1,0],["مِن أخلص الخلصاء قلبه طيبٌ","رحمتْ عقيدتُه ألوفَ عقائدِ",76,"د",1,0],["منَّا خُلقْن وجزؤنا فتنٌ لنا","آيٌ تقولُ بما أقول صحاحُ",77,"ح",1,0],["من آخذٌ من نبي الله رايته","وهي التي لسواه ليس يعطيها",78,"ي",3,0],["من آخر الحلم آتٍ ، والسنين مدى","يطوي الحماقات لا يحصي لها عددا",79,"د",2,1]]}