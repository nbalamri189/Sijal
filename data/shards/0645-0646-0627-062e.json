{"poems":[[53,"لحب إلي بالدهناء ملقى","https://www.aldiwan.net/poem29852.html","الوافر"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[27,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[51,"من أخذ الحذر من المحذور","https://www.aldiwan.net/poem63005.html","الخفيف"],[51,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[29,"لعمري لقد أسريت لا ليل عاجز","https://www.aldiwan.net/poem6023.html","الطويل"],[28,"إليك سبقت ابني فزارة بعدما","https://www.aldiwan.net/poem5602.html","الطويل"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[48,"حميد ماذا دهاكا","https://www.aldiwan.net/poem66560.html","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[100,"في الشاطىء الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=50418",""],[122,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[144,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[151,"خذها إليك أبا إسحاق عن عجل","https://www.aldiwan.net/poem68543.html","البسيط"],[151,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[233,"ما لي وللاحي عليك يعنف","https://www.aldiwan.net/poem14814.html","الكامل"],[272,"أرى برق الغوير اذا تراءى","https://www.aldiwan.net/poem52103.html","الوافر"],[299,"ردي علي رقادي فهو مختلس","https://www.aldiwan.net/poem36304.html","عموديه"],[306,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[321,"قل للمعالي ترطب مسمعي طربا","https://www.aldiwan.net/poem67218.html","البسيط"],[381,"من مسعدي من عذيري","https://www.aldiwan.net/poem48807.html","المجتث"],[430,"ما للمعالي تفيض الدمع مدرارا","https://www.aldiwan.net/poem38732.html","البسيط"],[440,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[539,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[552,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[552,"إن عاقب الشيب السواد بمفرقي","https://www.aldiwan.net/poem47899.html","الكامل"],[586,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""]],"verses":[["مُناخُ مُطَلَّحينَ تَقاذَفَتهُم","غَريبُ الحاجِ وَالهِمَمِ العَوالي",0,"ل",2,0],["مَن أَخطَأَتهُ سِهامُ المَوتِ قَيَّدَهُ","طولُ السِنينَ فَلا لَهوٌ وَلا جَذَلُ",1,"ل",1,0],["مِنْ أَخضَرٍ كالحِبْرِ أَوْ مِنْ أَشْقَرٍ","كَالتِّبْرِ أَوْ مِنْ أَحْمَرٍ كَالْعَنْدَمِ",2,"م",1,0],["مُناخَ قُرونِ الرُكبَتَينِ كَأَنَّهُ","مُعَرِّسُ خَمسٍ مِن قَطاً مُتَجاوِرِ",3,"ر",1,0],["مَناخِرُ شانَتها القُيونُ كَأَنَّها","أُنوفُ خَنازيرِ السَوادِ القَوابِعِ",4,"ع",1,0],["من أخذ الحذر من المحذورِ","قلّ تجنِّيه على المقدورِ",5,"ر",1,1],["مَنْ أخَفْ خُلْفَهُ فما زال ميعا","دُك عندي كأنَّه ميثاقُك",6,"ك",1,0],["مُناخِ ذَوي الحاجاتِ يَستَمطِرونَهُ","عَطاءَ كَريمٍ مِن أُسارى وَمِن نَهبِ",7,"ب",1,0],["مُناخٌ لِأَهلِ الأَرضِ يَجمَعُ بَينَهُم","لِمُطَّلِبي الحاجاتِ غُبرُ المَخارِمِ",8,"م",1,0],["مِن آخِذٍ لَكَ نَعلاً","وَآخِذٍ مِسواكا",9,"ك",2,0],["من آخذٍ لكَ نعلاً","وآخذٍ مِشواكا",10,"ك",2,0],["مَنْ أَخْطَأَ الأُولَى فَظلَّ عَلى","إِيمَانِهِ لمْ يُخْطِيءِ الأُخْرَى",11,"ر",2,0],["من أخبرتني عنك ؟ لا أحد","من دلّني ..؟ عيناك شيطاني",12,"ن",2,0],["مناخٌ له رحب الفنا جفلت له","بمدح تليد ذالقات مجرجما",13,"م",2,0],["مِن آخِذٍ بِمَضَلَّةٍ أَو عائِدٍ","بِمَذَلَّةٍ أَو عائِذٍ بِأَمانِ",14,"ن",1,0],["من أخطأ السَّمت والظلماء عاكفة","لم يهد مقلته إلاَّ سنى القمر",15,"ر",1,0],["من اختَصَّهُ بِالسَعدِ حُكمُ إِلَهِهِ","فَلَم يَنأَ عَن إِرشادِهِ لِسَفاهِهِ",16,"ه",1,0],["مَن آخِذٌ بِيَدي وَقَدَّكَ عامِلٌ","لا يَسمَعُ الشَكوى وَصَدغُكَ مُشرِفُ",17,"ف",1,0],["من اختار الوَسيلَة في المَعالي","ومن اوتى الوَسيلة وَاللواء",18,"ا",2,0],["مَنْ آخذٌ بيدي مما أُكابدُه","فإِنَّ ما بيَ قد حارَتْ به النطس",19,"س",1,0],["من أخيفين لكل نصف منهما","ولمهمل ولمعجم أنباءُ",20,"ا",2,0],["مَن أَخلَصَ السَعدُ إيفاءً بِخِدمَتِهِ","وَلَم يُفارِق لَهُ طولَ المَدى عَتبا",21,"ب",2,0],["مِن آخذ بِيَميني","مِن جور ظَبي غَرير",22,"ر",1,0],["من أخصب العدل في أيامه وزهت","رياضه فاجتناها الناس أثمارا",23,"ر",2,0],["مَنِ اخْتَرَقَ الدُّنْيَا لأَوَّلِ دَعْوَةٍ","إِلَى دَعْوَةِ الإِسلامِ فافْتَكَّ غُلَّها",24,"ل",3,0],["مِن أخٍ مُخلِصٍ إليكَ كما تَع","هَدُه مِن سنينَ ذاتِ اعتِبارِ",25,"ر",1,0],["مَنْ أخرج اللّيثَ مِن ذاك العرين ومَن","حطّ المحلِّقَ في العلياءِ مِن عالِ",26,"ل",1,0],["مَنْ أخْطَأَتْهُ وقد رمتْ قوسُ الرّدى","تبيضُّ منه مفارقٌ ومسائحُ",27,"ح",1,0],["مُناخُ للأَراذل منذ كانت","محرَّمَةٌ على الحرّ الكريم",28,"م",1,0]]}