{"poems":[[95,"حجك أرضى ربك العليا","https://www.aldiwan.net/poem11101.html","الرجز"],[47,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[30,"فأغلق من وراء بني كليب","https://www.aldiwan.net/poem4952.html","الوافر"],[92,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[119,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem41234.html","عموديه"],[124,"سأهدل كالحمائم في رياض","https://www.aldiwan.net/poem49286.html","الوافر"],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[185,"قفى يا أميم القلب نقرأ تحية","https://www.aldiwan.net/poem58834.html","الطويل"],[201,"صهرت في قدح الصهباء أحزاني","https://www.aldiwan.net/poem39945.html","البسيط"],[237,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem14836.html","الطويل"],[242,"صبا نجد ألا هبي علينا","https://www.aldiwan.net/poem19274.html","الوافر"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[302,"خليلي هل عهدي بمكة راجع","https://www.aldiwan.net/poem33227.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[369,"طلعت علينا من سماء المكارم","https://www.aldiwan.net/poem60662.html","الطويل"],[402,"حجك أرضى ربك العليا","https://www.aldiwan.net/poem10965.html","عموديه"],[447,"لقد فاز قوم باللباب من العلم","https://www.aldiwan.net/poem14385.html","الطويل"],[449,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[520,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[558,"أحق أنه أودى يزيد","https://www.aldiwan.net/poem68415.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86688","الوافر"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73516","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102274","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76610","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119187","البسيط"],[2378,"","https://poetry.dctabudhabi.ae/diwan/poem/199544","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109795","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48458","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48283","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126964","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127006","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138574",""],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132015","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59449","الطويل"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113703","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45126","الطويل"],[4679,"أأذنبَ في لونه الأسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=142773",""],[5041,"إلى عزيزٍ لهُ في مُهْجَتي نُزُلُ","https://www.poetsgate.com/ViewPoem.aspx?id=24396",""],[585,"خلا المجال وأودى الشاعر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=161942",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[6102,"عيد شديد","https://www.poetsgate.com/ViewPoem.aspx?id=184462",""],[6102,"يَارَا","https://www.poetsgate.com/ViewPoem.aspx?id=185333",""]],"verses":[["وهلْ شَهِدتِ ظُلْمَةً غَاشِيَةً","وَلَمْ تَكونِي الكَوْكَبَ الدرِيا",0,"ي",2,0],["وَهَل شَيَّعَ الأَظعانَ بَغتاً فِراقُهُم","كَمُنهَلَّةٍ تَدمى جَوىً حينَ تَدمَعُ",1,"ع",1,0],["وَهَل شَيءٌ يَكونُ أَذَلَّ بَيتاً","مِنَ اليَربوعِ يَحتَفِرُ التُرابا",2,"ب",2,0],["وهل شرفٌ بلا نكَدٍ وضُرٍّ","يُتمِّمُ خِلقةَ الشرف العناء",3,"ا",2,0],["وهل شجرات بالاثيل انيقة","يروح لها قلب ويغدو لها لب",4,"ب",1,0],["وهل شجراتنا إلا فروع","نماها خير أصل في الخوالي",5,"ل",2,0],["وَهَل شَفَّ كومَ العيسِ شَوقٌ مُبَرِّحٌ","كَشَوقي فَلَجَّت في الذَميلِ وَفي الوَخدِ",6,"د",1,0],["وَهَل شِفاؤُكَ إِلّا رَحمَةٌ لَهُمُ","فَليَشكُروا اللَهَ وَليوفوا بِما نَذَروا",7,"ر",3,0],["وَهَل شَفَّكُم يَومَ ارتَحلنا زِيالُنا","كَما شَفَّني يَومَ ارتَحَلتُم زِيالُكِ",8,"ك",1,0],["وهل شجا قلبَها نوحُ الحمامِ بهِ","فاستَعبَرَت وَرَثَت لي بعدَ فقداني",9,"ن",2,0],["وَهَل شَجراتٌ بِالأَثيلِ أَنيقَةٌ","يَروحُ وَيَغدو مُستَظِلاً بِها الرَكبُ",10,"ب",1,0],["وَهَلْ شِمْتِ الَّلوَامِعَ مِنْ سَنَاهُمْ","فَتَدْرِيْ قَدْرَ بَيْنِهِمُ عَلَيْنَا",11,"ن",2,0],["وَهَل شُرعَت تلك القِبابُ بسَفحها","وأَمسى بها حاديهُم يترنَّمُ",12,"م",1,0],["وَهَل شربةٌ من ماء زَمزمَ تَرتَوي","بها كبِدٌ قد أَظمأتها الوقائعُ",13,"ع",1,0],["وهل شارب كأساً من الحب جاهل","بما أحدثت في عقله حين دبت",14,"ت",1,0],["وَهَل شائِمٌ إِلّا يَدُ اللَهِ حَدُّهُ","لِإِعداءِ مَظلومٍ وَإِراداءِ ظالِمِ",15,"م",1,0],["وهل شهدت ظلمة غاشية","ولم تكوني الكوآب الدريا",16,"ي",2,0],["وهل شاعر في الناس أصبح قدوةٌ","وإن كان ذا نثر أنيق وذا نظم",17,"م",1,0],["وهل شم الكرام العر","ب ريح الحكم والعلم",18,"م",1,0],["وهل شهر الصيام سوى هلال","يزورك وافداً في كل عام",19,"م",1,0],["وَهَل شيمَت سُيوفُ بَني نِزارٍ","وَهَل وُضِعَت عَلى الخَيلِ اللُبودُ",20,"د",1,0],["وَهَل شارَكت في الأَرصاد يَوماً","بِمَصر خَليفة الوَقت العُبيدي",21,"د",2,0],["وَهَل شِعرُهُ إِلّا كَفارغ حمصٍ","خَلِيٌّ مِن المَعنى وَلَكن يَفرقِعُ",22,"ع",1,0],["وهل شائم برق الثنية ناظري","على القرب يخفى تارة ثم يخفق",23,"ق",1,0],["وهل شافهت في مره روضة الحمى","فأنا نرى طيها النشر فائحا",24,"ح",2,0],["وهل شققت هوج الرياح جيوبها","لغيري او حنت حنين الروائم",25,"م",1,0],["وهل شاركوه في الذي قلت إنه","يؤول الى جبن الإمام وينجرُّ",26,"ر",1,0],["وهل شآني إلى الغايات سابقها","وهل فزعت إلى غير القنا الذبل",27,"ل",1,0],["وهل شعرٌ يعبر عن علاه","ودون محله الشعرى العبور",28,"ر",1,0],["وهل شوقكم شوقي وهل في جفونكم","كما في جفوني من دموع ومن سهد",29,"د",1,0],["وهلْ شرَفُ الأملاكِ إلا إذا أتَتْ","تقبِّلُ يُمْناهُ بها وتُبايِعُ",30,"ع",1,0],["وهل شغَفي بالبانِ إلا لأنّه","بهِ شَبَهٌ ممّنْ كَلِفتُ بها معْنَى",31,"ن",2,0],["وهل شاقتك هيفاء تبدت","كبدر التم في ليل الجعود",32,"د",1,0],["وهل شاق منك القلب ركب مفوض","وأورى الحشا وجدا خليط مودع",33,"ع",1,0],["وهل شاقك الأمر الالهي للقا","وهل لك في قطع الحياة مرام",34,"م",1,0],["وهل شاهدت ريم القاع يعدو","طريد الذعر قد طلب الأراما",35,"م",2,0],["وهلَ شرعُ بُهلي ذُو المعاقلَ عائدٌ","بأيَّامنا لذّاتُه ومطاربُهْ",36,"ب",2,0],["وهل شرف الأعلى مطلٌّ وقعره","على المرجةِ الخضراءِ فيه كرامُ",37,"م",1,0],["وهل شاقها غير الغوير فساقها","فأنت ورامت رامة ورباها",38,"ا",3,0],["وَهَل شِمتُما في خالَتَيهِ شَمائِلاً","أَرَقَّ مِنَ الشَكوى وَأَقسى مِنَ الهَجرِ",39,"ر",1,0],["وهل شكل جلدته زلةٌ","فما انفك يضرَبُ أو يجلدُ",40,"د",1,0],["وهلْ شَبِعْتَ بُكاءً مالِحًا وَدَمًا","أَمْ أَنَّ جُرْحَكَ مِثْلي، ليسَ يَنْدَمِلُ؟",41,"ل",1,0],["وهل شكت أمة في الشرق من نقم","إلا انتفضت ومست قلبك النقم",42,"م",1,0],["وهل شعرتَ اغتراباً في مَعيَّتِه؟ِ","قضيتَ عمركَ يا مولايَ مُغتَربا!",43,"ب",2,0],["وَ هَلْ شاقَ \" مُوسَى \" غَيرُ أَهلٍ أَعانَهُمْ ؟!","وَ هَلْ مُكرَمٌ - فِي قَومِهِ \" عادَ \" - هُودُ ؟!",44,"د",1,0],["وَ هَلْ شَبِعَا - هَيهَاتَ - مِنْ حَرِّ مِبسَمِي ؟","- فَجُوعًا - أَرَى نَهدَيكِ - \" يَارا \" - تَضَوَّرا !!",45,"ر",2,0]]}