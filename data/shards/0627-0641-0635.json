{"poems":[[75,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[93,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[51,"راعني يا يزيد صوت الغراب","https://www.aldiwan.net/poem63232.html","الخفيف"],[68,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[46,"يا سمي الذي تبهل يدعو","https://www.aldiwan.net/poem30270.html","الخفيف"],[76,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55158","الرجز"],[102,"لِعينيكَ يا مَوطني","https://www.poetsgate.com/ViewPoem.aspx?id=183583",""],[189,"هذا الفراق وهذه الأظعان","https://www.aldiwan.net/poem14686.html","الكامل"],[203,"هدم الأنام وجئت انت تشيد","https://www.aldiwan.net/poem45155.html","الكامل"],[228,"واستفاق المريض من هذيانه","https://www.aldiwan.net/poem41606.html","الخفيف"],[261,"أفصح ودعني من الرموز","https://www.aldiwan.net/poem48565.html","مخلع البسيط"],[396,"ذاوقت يا صاح مما به فؤادي صاح","https://www.aldiwan.net/poem54527.html","عموديه"],[422,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[458,"أيار كاد يذوب عطرا سابغا","https://www.aldiwan.net/poem61325.html","الكامل"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[520,"كلما رمت سلمه رام حربي","https://www.aldiwan.net/poem12232.html","الخفيف"],[556,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66967","السريع"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119319","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120033","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136302","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144136","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80031","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108927","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108774","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100473","السريع"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104812","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27843","المجتث"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93720","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200050","المجتث"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145880","الرمل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121869","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112616","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35510","المديد"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119714","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72498","الكامل"],[4718,"ياصاح مالي ومال الحب ودروبه","https://www.poetsgate.com/ViewPoem.aspx?id=137246",""],[4830,"حُمرةُ الخدَّين","https://www.poetsgate.com/ViewPoem.aspx?id=213318",""],[4857,"جيش محمد","https://www.poetsgate.com/ViewPoem.aspx?id=37073",""],[4929,"ازهر الرأس","https://www.poetsgate.com/ViewPoem.aspx?id=199507",""],[5198,"جلد الذات","https://www.poetsgate.com/ViewPoem.aspx?id=135071",""],[6019,"إبحار في عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53055",""],[6027,"لي في هواك .. تعقل وجنون","https://www.poetsgate.com/ViewPoem.aspx?id=187195",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[463,"منْ حاكمٌ وخصوميَ الأقدارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60069&r=&rc=125",""]],"verses":[["أَفَصَبرٌ مِئينَ خَمساً مِنَ الأَيّامِ","ناهيكَ مِن عَذابٍ أَليمِ",0,"م",1,0],["أَفصَحُ مِن كُلِّ فَصيحٍ بِنا","هَذا الَّذي أَعياهُ رَدُّ السَلام",1,"م",1,0],["أَفصَحَ البَينَ بِالنَعيبِ وَما أَف","صَحَ لي في نَعيبِهِ بِالإِيابِ",2,"ب",1,0],["أَفصَحَّ أَنَّ الذِئبَ آكِلُ يوسُفٍ","أَوَليسَ فيهِ لَكُم دَليلٌ كافِ",3,"ف",1,0],["أَفصَحَ اليَومَ ناظِراً مُستَهامٍ","نَطَقا عَن ضَميرِ قَلبٍ قَريحِ",4,"ح",1,0],["أَفصَحَ غِرّيدٌ بِها مُطرِبٌ","نَفَشَّ مِن طِرسٍ قُدامى جَناح",5,"ح",1,0],["أَفْصَحُ مِنْ قُسٍ وَلَوْ قِيسَ بِهِ","لَمْ تَسْتَقِمْ طَرَائِقُ التَّمْثِيلِ",6,"ل",1,0],["أُفَصِّلُ لِلياءِ وَجهًا بَهيجًا","ولِلمِيمِ جيدًا ولِلنونِ طرفْ",7,"ف",1,0],["أفصِحْ بما ضَمِنت دموعك من أسى","فعليكَ من أمر الهوى برهان",8,"ن",1,0],["افصحت إِفصاح المهنَّد يُنتضى","ولأنت في كف الزمان مهنَّدُ",9,"د",1,0],["أَفصَحَت عَن نُبوءَةٍ تَمَّمَتها","نَزَواتُ المَساءِ في إِبّانِه",10,"ن",2,0],["أفصح ودعني من الرموز","قد دخل الشيخ بالعجوز",11,"ز",1,1],["أفصحت أفصاح","هل من يسمع الإنصاح",12,"ح",1,0],["أفصحت عن أخرسٍ فيك له","من قريض النثر نثراً ونظاما",13,"م",2,0],["أفصح ولاتك مبهما كقصيدة","مطويّة بمشاعر وجنان",14,"ن",1,0],["أفصح فينتفض الربيع مجدّدا","والحب والنعمى بكل مكان",14,"ن",1,0],["أفصخرةٌ يا دهرُ هذا القلبُ أم","هو للهموم الساريات قرارُ",15,"ر",1,0],["أفصحُ ماقيلَ ولكنَّها","فصاحةٌ تُهدَى إلى يَعْرُبِ",16,"ب",1,0],["أفصح الناس في ثلاث حروف","وهو في غيرها قليل المجال",17,"ل",1,0],["أفصحتَ لا أفلحتَ بالنبأِ الّذي","للقلبِ منه توقّدٌ وتوهّجُ",18,"ج",1,0],["أُفْصِحُ وَحْدِي يومَ فِصْحٍ لَهُمْ","بَين الأرَيْطَى والدُّوَيْحاتِ",19,"ت",1,0],["افصل خلا اذا دجا","واجد اذا الخل صفا",20,"ف",2,1],["أفصح من شعر أبي نواس","وفارس النظم أبي فراسِ",21,"س",1,0],["افصح عن الحق الجلي فانه","معنى الوصال وغاية الآمال",22,"ل",1,0],["أفصح دمعي بالهوى","فصار سرّي علنا",23,"ن",2,1],["أفصحتُ عن وجدي إليك بدعوةٍ","رُبَّما ذممت بها الزمان الأعجما",24,"م",2,0],["أفصار قول الحق يحسب مدحةً","يا شبلَ من مُدِحَت به عدنان",25,"ن",1,0],["أفصح الناس بعد من فخم الضا","د وأسخى الورى على الإطلاق",26,"ق",1,0],["أفصح الأبله البليد ذكاه","مثل ما منه تخرس الفصحاء",27,"ا",2,0],["أفصح في تغريده منطقاً","يقول بشرى بمدير أمين",28,"ن",1,0],["أفصَح لكَ الضَبُّ بَينَ الناسِ يَشهَدُ أن","أُرسِلَتَ بالحَقِّ تَنجُو الخَلقَ مِن نارِ",29,"ر",1,0],["أفصحتُ فيه لساني","لأنني بين خرس",30,"س",1,0],["أفصح أن الجاحدين لكونه","متكلما بحقيقة وبيان",31,"ن",1,0],["أَفصِحوا عَن مُرادِكُم وَأَبينوا","ما لَكُم تَلجَأونَ لِلتَعقيدِ",32,"د",1,0],["افصل وان توسطت فالوصل","لجامع أرجح ثم الفصل",33,"ل",1,0],["أَفصح بِالمَوت لِسان الوَغى","وَمصقع القَوم غَدا ألكَنا",34,"ن",2,0],["أفصح قليلا فحسبي","منك الفصيح القليل",35,"ل",1,0],["أفصح القول بصوت واثق","فحديثي ليس لغوا أو حرام",36,"م",1,0],["أُفَصِّل من دِيباجَتيْهِ وِقايةً","تُمَدُّ عليها حَذْوُكَ النَّعْلَ بالنَّعْلِ",37,"ل",1,0],["أفصِح وجىء بأحسنِ الأصواتِ","وَقِف على أواخرِ الأبياتِ",38,"ت",1,0],["أفصَحُ النَّاسِ نُطقاً أبلَغُهُم فِي","كَلِمَاتٍ عَنَت لَهَا الفُصَحَاءُ",39,"ا",2,0],["أفصَحَت بِالّذِي جَلَوتُهُ آثَا","رٌ صِحَاحٌ وَغَيرَ ذَاكَ جَفَاءُ",40,"ا",2,0],["أَفصَحت في شُكرِهِ وَهيَ خُرسٌ","عَجَباً مِنها لِخُرس فِصاحِ",41,"ح",1,0],["أفصحت إذ بات عياً من تلا","شرح أنبائهم في الصحف",42,"ف",1,0],["أفصَدَ القلبَ إن رنا بسهام","بل إذا غضَّ هاجراً لا خشوعا",43,"ع",2,0],["أفصحهم منطقا وأحسنهم","خلقا وخلقا فاحوى احنا",44,"ن",2,0],["أفصحت إبراهيم عما","قد غمَّ من هذا المعمى",45,"م",2,1],["افصّل الصدق له واقول ذا ثوبه","واكذب العين لكن مايطاوعني",46,"ن",2,0],["أفصِحْ فديتُكَ نفسَ مغرومٍ فهل","منعَ التعذّرُ أنْ تبوحَ أمِ الثِّقَلْ",47,"ل",1,0],["أفصح لعالمنا وقل ها قد رجع","جيش الرسول إلى الوغى فرقا شيع",48,"ع",1,1],["أفصحُ الناطقينَ هنَّ ،...وأوعى","مُتَلَقٍّ حديثهنَّ القلوبُ",49,"ب",1,0],["افصلّه من احساسي ومن خام القصيد هدوم","واجيب الحرف من بستان ورد وود واهديله",50,"ل",2,0],["أَفصَحتُ عَنْ مَكنُونِ قَلبِيَ حَالِمَاً","بزهورِ عُمرِكِ في جِنَانِيَ تَعبَقُ",51,"ق",1,0],["أفصح وقل إن شئت قولة واثق","إني المتيم في هواك حنين",52,"ن",1,0],["أفصحْ فإن السيفَ أصدقُ رايةً","إن كنتَ تهوى والحبيبُ جريحُ",53,"ح",1,0],["أفصخرة ٌ يا دهرُ القلبُ أم","هو للهموم الساريات قرارُ",54,"ر",1,0]]}