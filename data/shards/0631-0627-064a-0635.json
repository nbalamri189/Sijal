{"poems":[[65,"رأى صحبي بكاظمة","https://www.aldiwan.net/poem45706.html","مجزوء الوافر"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[47,"إن ترج طول عبيد الله لا تخب","https://www.aldiwan.net/poem11041.html","البسيط"],[47,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[30,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[47,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[366,"رأى صاحبي هذا الوزير فقال لي","https://www.aldiwan.net/poem68067.html","الطويل"],[422,"أرد الدموع بأردانه","https://www.aldiwan.net/poem53918.html","المتقارب"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108466","الوافر"],[3521,"","https://poetry.dctabudhabi.ae/diwan/poem/199466","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""]],"verses":[["رأى صَحبي بِكاظِمَةٍ","سَنا نارٍ عَلى بُعدِ",0,"د",1,1],["رأى صَيْدَه من أفْضل الصَّيْدِ كُلِّهِ","على أنَّهُ مِنْ شرِّ ما يُتَصَيَّدُ",1,"د",1,0],["رَأيٌ صَليبٌ عَلى الأَيّامِ يَتبَعُهُ","ظَرفٌ مَتى يَعتَرِض في عَيشِنا يَطِبِ",2,"ب",1,0],["رَأى صاعِداً أَهلاً لِأَشرَفِ رُتبَةٍ","يَشُقُّ عَلى ساري النُجومِ صُعودُها",3,"د",3,0],["رَأى صاحِبُ المِعزى الَّذي في عُراقِها","رَخيصاً وَلَو أُعطي بِها أَلفَ رائِمِ",4,"م",1,0],["رأى صاعداً أهى لأشرف رتبة","يشق على ساري النجوم، صعودها",5,"د",3,0],["رَأى صاحِبي هذا الوَزير فَقالَ لي","تَأَمّل مَزاياهُ وَصف لي أَحوالُه",6,"ه",1,1],["رأى صاحبي آيةً للفؤاد","تدلُّ على ضد سُلْوانه",7,"ن",2,0],["رأى صبري قتيلاً في شجوني","فلم يصبر على ما قد شجاه",8,"ا",2,0],["رأى صاحبي عمرا فكلّف وصفه","وحملني من ذاك ما ليس في الطوقِ",9,"ق",1,1],["رَأى صَغري فَاِستَصغَر الدَهر همتي","وَلي همم لَو صادمته يَمور",10,"ر",1,0],["رأى صحابي دربي فأبكاه بعدها","فقلت له مهلا لقد قارب المدى",11,"د",2,0],["رأى صحبة زمت بهم نجب القضا","وفتيانه قد شط عنه مزارها",12,"ر",3,0]]}