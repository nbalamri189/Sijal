{"poems":[[77,"وافى لعطفتك البشير فلو غدت","https://www.aldiwan.net/poem36370.html","الكامل"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"قل للمسمى بما تكنى الكلاب به","https://www.aldiwan.net/poem65713.html","البسيط"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[90,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[48,"يا مبيح الدمع في الطلل","https://www.aldiwan.net/poem64995.html","المديد"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49137","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[77,"وافي بعطفتك البشير فلو غدت","https://www.poetsgate.com/ViewPoem.aspx?id=34155",""],[51,"ما القلبُ في إثْرِهم بمختطَفِ","https://www.poetsgate.com/ViewPoem.aspx?id=29597",""],[141,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[184,"قلت نصيحة من تشاور","https://www.aldiwan.net/poem43878.html","مجزوء الكامل"],[191,"يا مبتلى بضناه يرجو رحمة","https://www.aldiwan.net/poem12999.html","الكامل"],[202,"يا مبدعا قتل النفوس جهارا","https://www.aldiwan.net/poem53294.html","الكامل"],[209,"تظل أمواج هذا البحر تطربني","https://www.aldiwan.net/poem46261.html","البسيط"],[233,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[273,"قابلت نعماك بالسجود","https://www.aldiwan.net/poem25581.html","مخلع البسيط"],[362,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[362,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[399,"يا مبتدي ظلمي ستلقى","https://www.aldiwan.net/poem46457.html","مجزوء الكامل"],[456,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[498,"يا كاشف الضر عن أيوب يا سندا","https://www.aldiwan.net/poem37561.html","البسيط"],[536,"قالوا المعري كافر","https://www.aldiwan.net/poem47481.html","عموديه"],[549,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[551,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[556,"يا مبتلى بالغرام اصبر لأوجاعك","https://www.aldiwan.net/poem34261.html","المواليا"]],"verses":[["يَا مُبْقِياً رَمَقِي بِفَضْلِ حَنَانِهِ","يَا مَفْزَعِي يَا مَلْجَئِي يَا مَوْئِلِي",0,"ي",1,0],["يا مبرئ الحسبة التي سقمت","بل التي أشرفت على التلف",1,"ف",1,0],["يا مبتلىً ببلاءٍ لا ثواب له","يوم الحساب ولكن سوف يوبقه",2,"ق",2,0],["يا مُبيدَ الأَسدِ في آجامِها","هَل أَبادَت خَيلُكَ الدودَ المَهين",3,"ن",1,0],["يا مُبْرِئَ العِلَلَ الجِسَامَ بطِبّهِ","تَأْبَى المروءةُ أنْ تَكُونَ عَلِيلا",4,"ل",2,0],["يا مُبيحَ الدَمعِ في الطَلَلِ","راكِباً مِنهُ إِلى أَمَلِ",5,"ل",1,1],["يا مَبركَ القُصوَى أتلك رسالةٌ","جاءتكَ أم هي من كَلالٍ ترْزمُ",6,"م",1,0],["يَا مُبْدِعاً فِي فنه وَمُحَلياً","يَقَظَاتِنَا بِرَوَائِعِ الأحْلاَمِ",7,"م",1,0],["يا مُبتَلي النَعيم بعلةٍ","فيها عَذابٌ لِلصَبورِ بَئيسُ",8,"س",1,0],["يا مبقيا رمقي بفضل حنانه","يا مفزعي يا ملجأي يا موئل",9,"ل",1,0],["يا مُبرىء الحِسبة التي سَقُمتْ","بل التي أشرفتْ على التَّلف",10,"ف",1,0],["يا مُبيدَ الأَحقادِ أَعظَمُ طَبٍّ","واحِدٌ عَمَّ نَفعُهُ الأَعضاءَ",11,"ا",2,0],["يا مبتلي بشقاية","يا غائبا في حال حاضر",12,"ر",1,0],["يا مُبتَلىً بِضَناه يَرجُو رَحمَةً","مِن مالِكٍ يَشفيهِ مِن أَوصابِهِ",13,"ب",2,1],["يا مُبدِعاً قتلَ النفوس جهارا","أشعلتَ بين حشا الجوانح نارا",14,"ر",2,1],["يا مبدع الكون من ماء ومن لهب","ومن غرائب نعماء وبأساء",15,"ا",2,0],["يا مُبيدَ العِدى وَيا قاتِلَ المَح","لِ نَداهُ وَطارِدَ الإِفلاسِ",16,"س",1,0],["يا مُبْدِئاً في العُلَى مُعِيداً","أيِّدْتَ بالمُبْدِئ المُعيدِ",17,"د",1,0],["يا مُبدعَ القَولِ مَبْسوطاً ومُخَتصراً","ومُحسِنَ الفِعلِ مُعتاداً ومُبْتَديا",18,"ي",2,0],["يا مُبِرّاً على بني الدَّهْرِ فَضْلاً","مِثْلَ شَخْصٍ عالٍ على أَشْخاص",19,"ص",1,0],["يا مُبْتدِي ظلْمي سَتلْقى","غِبّ صنعك في ابتدائكْ",20,"ك",1,1],["يا مبدىء الإحسان فينا أعدْ","فالبدر إن مرّ مع الشهر عادْ",21,"د",1,0],["يا مبرداً نار إبراهيم خذ بيدي","وزد فؤادي بثلج اللطف إيمانا",22,"ن",2,0],["يا مُبصرينَ وفي بصَا","ئِرهِم عَماها يَكمُنُ",23,"ن",1,0],["يا مُبرِزَ الغِيدِ الحِسا","نِ من السّتائرِ والسُّجوفِ",24,"ف",1,0],["يا مُبدِعَ الذَنبِ لي لِيَظلِمَني","هَجرُكَ لي في الذُنوبِ مُمتَحِنُ",25,"ن",1,0],["يا مبتلى بالغرام اصبر لأوجاعَكْ","لو كنت عاقلْ دليل العقل ما طاعَكْ",26,"ك",1,1]]}