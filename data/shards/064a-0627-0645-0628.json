{"poems":[[79,"وافى لعطفتك البشير فلو غدت","https://www.aldiwan.net/poem36370.html","الكامل"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[53,"قل للمسمى بما تكنى الكلاب به","https://www.aldiwan.net/poem65713.html","البسيط"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[92,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[50,"يا مبيح الدمع في الطلل","https://www.aldiwan.net/poem64995.html","المديد"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49137","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[79,"وافي بعطفتك البشير فلو غدت","https://www.poetsgate.com/ViewPoem.aspx?id=34155",""],[53,"ما القلبُ في إثْرِهم بمختطَفِ","https://www.poetsgate.com/ViewPoem.aspx?id=29597",""],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[190,"قلت نصيحة من تشاور","https://www.aldiwan.net/poem43878.html","مجزوء الكامل"],[197,"يا مبتلى بضناه يرجو رحمة","https://www.aldiwan.net/poem12999.html","الكامل"],[208,"يا مبدعا قتل النفوس جهارا","https://www.aldiwan.net/poem53294.html","الكامل"],[215,"تظل أمواج هذا البحر تطربني","https://www.aldiwan.net/poem46261.html","البسيط"],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[280,"قابلت نعماك بالسجود","https://www.aldiwan.net/poem25581.html","مخلع البسيط"],[369,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[369,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[408,"يا مبتدي ظلمي ستلقى","https://www.aldiwan.net/poem46457.html","مجزوء الكامل"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[505,"يا كاشف الضر عن أيوب يا سندا","https://www.aldiwan.net/poem37561.html","البسيط"],[543,"قالوا المعري كافر","https://www.aldiwan.net/poem47481.html","عموديه"],[556,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[558,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[563,"يا مبتلى بالغرام اصبر لأوجاعك","https://www.aldiwan.net/poem34261.html","المواليا"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66726","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34440","الرجز"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122353","السلسلة"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119977","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59416","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96654","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56245","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136098","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112768","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64551","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79897","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80054","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125370","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53227","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27158","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109363","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111157","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93554","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201710","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65255","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216570",""],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104303","المديد"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48369","البسيط"],[3623,"","https://poetry.dctabudhabi.ae/diwan/poem/143421","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206160",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216811","الكامل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99222","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135732","الرجز"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88530","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69921","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94760","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94417","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94430","الكامل"],[4272,"","https://poetry.dctabudhabi.ae/diwan/poem/145988","الكامل"],[4493,"","https://poetry.dctabudhabi.ae/diwan/poem/20669","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139673",""],[5055,"عطني أمل","https://www.poetsgate.com/ViewPoem.aspx?id=109395",""],[5061,"سكرة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=147178",""],[307,"الرحيل الى الله تعالى","https://www.poetsgate.com/ViewPoem.aspx?id=213747",""],[5323,"مبتدا الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=207210",""],[5410,"رقيب","https://www.poetsgate.com/ViewPoem.aspx?id=109732",""],[5431,"علمه في شرع الهوى التحليقا","https://www.poetsgate.com/ViewPoem.aspx?id=185261",""],[5574,"علمُ النبض","https://www.poetsgate.com/ViewPoem.aspx?id=206016",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5599,"هديه جزيله","https://www.poetsgate.com/ViewPoem.aspx?id=213862",""],[5690,"ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[5707,"يَا مبدعاً فِي النّظم والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=189185",""],[5732,"يا روح روحي","https://www.poetsgate.com/ViewPoem.aspx?id=177940",""],[5732,"بعدك يزيد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177947",""],[402,"أيتم أنس أم يطيب ترنم","https://www.poetsgate.com/ViewPoem.aspx?id=36198",""],[5848,"ياشعل سيجارة","https://www.poetsgate.com/ViewPoem.aspx?id=48950",""],[5943,"مساكب الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=46741",""],[5957,"الحب يا خلّي اقدسهُ","https://www.poetsgate.com/ViewPoem.aspx?id=36267",""],[6070,"يامبحراً في نوايا النَّاسِ كُنْ حَذِراً","https://www.poetsgate.com/ViewPoem.aspx?id=189512",""],[6131,"على سلَّمِ المَوتِ نهْتديْ","https://www.poetsgate.com/ViewPoem.aspx?id=189334",""],[6142,"بكر الردى فاجتاح في نكبائه","https://www.poetsgate.com/ViewPoem.aspx?id=155755",""],[313,"يا شادي البان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66516&r=&rc=38",""],[463,"خاطرْ بها إما ردى أو مرادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60030&r=&rc=86",""]],"verses":[["يَا مُبْقِياً رَمَقِي بِفَضْلِ حَنَانِهِ","يَا مَفْزَعِي يَا مَلْجَئِي يَا مَوْئِلِي",0,"ل",2,0],["يا مبرئ الحسبة التي سقمت","بل التي أشرفت على التلف",1,"ف",1,0],["يا مبتلىً ببلاءٍ لا ثواب له","يوم الحساب ولكن سوف يوبقه",2,"ق",2,0],["يا مُبيدَ الأَسدِ في آجامِها","هَل أَبادَت خَيلُكَ الدودَ المَهين",3,"ن",1,0],["يا مُبْرِئَ العِلَلَ الجِسَامَ بطِبّهِ","تَأْبَى المروءةُ أنْ تَكُونَ عَلِيلا",4,"ل",2,0],["يا مُبيحَ الدَمعِ في الطَلَلِ","راكِباً مِنهُ إِلى أَمَلِ",5,"ل",1,1],["يا مَبركَ القُصوَى أتلك رسالةٌ","جاءتكَ أم هي من كَلالٍ ترْزمُ",6,"م",1,0],["يَا مُبْدِعاً فِي فنه وَمُحَلياً","يَقَظَاتِنَا بِرَوَائِعِ الأحْلاَمِ",7,"م",1,0],["يا مُبتَلي النَعيم بعلةٍ","فيها عَذابٌ لِلصَبورِ بَئيسُ",8,"س",1,0],["يا مبقيا رمقي بفضل حنانه","يا مفزعي يا ملجأي يا موئل",9,"ل",1,0],["يا مُبرىء الحِسبة التي سَقُمتْ","بل التي أشرفتْ على التَّلف",10,"ف",1,0],["يا مُبيدَ الأَحقادِ أَعظَمُ طَبٍّ","واحِدٌ عَمَّ نَفعُهُ الأَعضاءَ",11,"ا",2,0],["يا مبتلي بشقاية","يا غائبا في حال حاضر",12,"ر",1,0],["يا مُبتَلىً بِضَناه يَرجُو رَحمَةً","مِن مالِكٍ يَشفيهِ مِن أَوصابِهِ",13,"ب",2,1],["يا مُبدِعاً قتلَ النفوس جهارا","أشعلتَ بين حشا الجوانح نارا",14,"ر",2,1],["يا مبدع الكون من ماء ومن لهب","ومن غرائب نعماء وبأساء",15,"ا",2,0],["يا مُبيدَ العِدى وَيا قاتِلَ المَح","لِ نَداهُ وَطارِدَ الإِفلاسِ",16,"س",1,0],["يا مُبْدِئاً في العُلَى مُعِيداً","أيِّدْتَ بالمُبْدِئ المُعيدِ",17,"د",1,0],["يا مُبدعَ القَولِ مَبْسوطاً ومُخَتصراً","ومُحسِنَ الفِعلِ مُعتاداً ومُبْتَديا",18,"ي",2,0],["يا مُبِرّاً على بني الدَّهْرِ فَضْلاً","مِثْلَ شَخْصٍ عالٍ على أَشْخاص",19,"ص",1,0],["يا مُبْتدِي ظلْمي سَتلْقى","غِبّ صنعك في ابتدائكْ",20,"ك",1,1],["يا مبدىء الإحسان فينا أعدْ","فالبدر إن مرّ مع الشهر عادْ",21,"د",1,0],["يا مبرداً نار إبراهيم خذ بيدي","وزد فؤادي بثلج اللطف إيمانا",22,"ن",2,0],["يا مُبصرينَ وفي بصَا","ئِرهِم عَماها يَكمُنُ",23,"ن",1,0],["يا مُبرِزَ الغِيدِ الحِسا","نِ من السّتائرِ والسُّجوفِ",24,"ف",1,0],["يا مُبدِعَ الذَنبِ لي لِيَظلِمَني","هَجرُكَ لي في الذُنوبِ مُمتَحِنُ",25,"ن",1,0],["يا مبتلى بالغرام اصبر لأوجاعَكْ","لو كنت عاقلْ دليل العقل ما طاعَكْ",26,"ك",1,1],["يا مُبغضاً لأمير المؤمنين وقد","قال النبيُّ له من دون إنكارِ",27,"ر",1,0],["يا مُبدعاً في حسناء واصِل أخا","هَمّ لَهُ عامٌ وَما واصَلتا",28,"ت",2,1],["يا مبتدع العذل ان عذلك اشراك","عذرا بعذار رميت منه باشراك",29,"ك",1,1],["يا مبديَ الجودِ المعا","د لحاضر منا وبادي",30,"د",2,0],["يا مبدع النطف المهينة في الحشا","يا ناسر الموتى في الأرماس",31,"س",1,0],["يا مبدع الكوان من غير احتيا","ج أو مثال يا بديع يا قديم",32,"م",1,0],["يَا مُبِيدِي بِالبِيض مِنْ مُقْلَتَيْهِ","كُنْ مُجِيرِيَ مِنَ العُيُونِ السُّودِ",33,"د",1,0],["يا مُبدياً النكارةَ لي في الهوى","مهلاً فماذا اللوم والإنكارُ",34,"ر",1,0],["يا مبدعاً صنع الوجود وكونه","يا من على عرش الدوام قد ارتقى",35,"ق",2,1],["يا مباني اصول معنى ابتداي","رحلتي فيكم قضت بالعجابي",36,"ب",2,0],["يا مبدئاً بنواله","يا من له حسن اليسار",37,"ر",1,0],["يا مبيد القرون يا قابض الأر","واح خذ روحه على غير مهل",38,"ل",1,0],["يا مبدئ النَعما ليك","ملها أعدها مستطابه",39,"ب",2,0],["يا مباري الصبا بصُغرى بنانٍ","بالعطايا سماءها مستهلّه",40,"ل",2,0],["يا مُبدعَ الأكوانِ عَزِّز جيشنا","واحفَظ لنا تاجَ القيادةِ أنورَا",41,"ر",2,0],["يا مبيد العدا ومبدي الندى عَ","وْداً وبدءاً لمبتغي إحسانه",42,"ن",2,0],["يا مَبسِماً أَحبَبتُ مِنهُ الحَبَبا","وَيا رُضاباً ذُقتُ مِنهُ الضَرَبا",43,"ب",2,0],["يا مبدي الخلق على حكمةٍ","ويا معيد الكل بعد الفناء",44,"ا",2,0],["يا مبغضا أهل الحديث وشاتما","أبشر بعقد ولاية الشيطان",45,"ن",1,0],["يا مباري غر السحائب جوداً","وموازي هضب الثرى أحلاما",46,"م",2,0],["يا مبيتا بِهِ الصبا نَفحتنا","فَحمدنا الصبا وَطابَ البيات",47,"ت",1,0],["يا مبعث الآمال في أهل الهوى","كم أملٍ فيك غرير ضُيّعا",48,"ع",2,0],["يا مُبدلي بالهجر من وصله","كن مُبدلي بالوحش إيناسا",49,"س",2,1],["يا مبتدي فِيْ الشعر مِثلاي","بيصح مدحي يوم بَلْقاك",50,"ك",1,0],["يا مببنا من مناقبهم","ساعيا في فتق راتقها",51,"ق",3,0],["يا مُبْصراً من جمالي ما يَروقُ حُلىً","أقْصِرْ فحُسْنُ صفاتي فوق ما تصِفُ",52,"ف",1,0],["يا مُبطِلاً فِعلَ الجميلِ بمِنّةٍ","أسخطْتَني من بعد ما أرضيْتَني",53,"ي",1,1],["يا مبدعًا للناس دينًا","مهلًا نخبِّرك اليقينا",54,"ن",2,1],["يا مبعداً عنا وليس بمبعد","جسد له في الأرض لحد ضيق",55,"ق",1,0],["يا مُبْغِضَ الذَّهَبِ المحبوب راحته","حتى كأَنَّ ذهابَ الحَمْدِ في الذهب",56,"ب",1,0],["يا مبدىءُ ويا معيدُ نورُ بَرْ","بك اهدنا وعافنا فلا نُضَرْ",57,"ر",1,0],["يا مبتلَى بالحبِّ مفدوحاً","لاقي من الحبِّ تباريحا",58,"ح",2,1],["يا مبعدَ الاحزان بَل يا مبدعَ ال","آحسان بَل يا مترع المستترعِ",59,"ع",1,0],["يا مبتغي التبغ دعني من دواهيهِ","ولا تزُرني لنيلٍ منهُ تبغيهِ",60,"ي",2,1],["يا مُبلغ الكون آمالاً بلا طلبٍ","وسن أن تنجز الميعاد أحرارُ",61,"ر",1,0],["يا مبدع الآراءِ أنتَ أميرها","خلَّدت ذكراً في خَليج نتائجِ",62,"ج",1,0],["يا مبرزاً إبريز خير سبيكة","ومكللاً إكليل خير متوج",63,"ج",1,1],["يا مُبلِغِ الأَخبارِ عَن رَبِّهِ","فينا وَيا مُحييَ لَيلَ التَمام",64,"م",1,0],["يا مُبهراً أهلَ البصائر","ببدائع الفضل البواهر",65,"ر",1,1],["يا مبطيٍ بالهم ما عاد بي هم","ما دام شمسك في شموسي شارقة",66,"ق",2,1],["يا مبطيٍ بالهم وشراعي اليم","خدك يبث النور وكلك بارقة",66,"ق",2,0],["يا مبطيٍ بالهم لو زاد بي هم","طفيّت أنا شموعي وأنتي شارقة",66,"ق",2,0],["يأمبعدن ساعات والفين مشوار","حرفك ثبت فيّ داخل القلب منحوت",67,"ت",1,1],["يا مُبْتَلِي ا