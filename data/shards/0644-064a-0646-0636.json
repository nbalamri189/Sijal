{"poems":[[65,"كتمنا الهوى وكففنا الحنينا","https://www.aldiwan.net/poem46144.html","المتقارب"],[65,"لك المجد لا ما تدعيه الأوائل","https://www.aldiwan.net/poem46184.html","الطويل"],[73,"أجل أنا في لون الشبيبة مغرم","https://www.aldiwan.net/poem3957.html","الطويل"],[29,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[74,"لئن ضاع مثلي عند مثلك إنني","https://www.aldiwan.net/poem19190.html","الطويل"],[53,"بني وهب الله جار لكم","https://www.aldiwan.net/poem66482.html","المتقارب"],[87,"الله في الخلق من صب ومن عانى","https://www.aldiwan.net/poem7881.html","البسيط"],[107,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[13,"على الشنفرى ساري الغمام فرائح","https://www.aldiwan.net/poem2227.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/200108","الطويل"],[107,"حماة الوغى أين السلام الموطد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54957&r=&rc=127",""],[164,"لصومك شهر الصوم يكسى من الفجر","https://www.aldiwan.net/poem59111.html","الطويل"],[215,"رويدك أيها القلب","https://www.aldiwan.net/poem46777.html","مجزوء الوافر"],[240,"تأوبني فأرقني خيال","https://www.aldiwan.net/poem31734.html","الوافر"],[240,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[255,"بذاك الفتور وهذا الهيف","https://www.aldiwan.net/poem14997.html","المتقارب"],[280,"يفندني في العامرية لومي","https://www.aldiwan.net/poem25519.html","الطويل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[303,"أرى الأزهار تبعث في الربيع","https://www.aldiwan.net/poem36801.html","عموديه"],[422,"لقد عجب الحسان الغيد لما","https://www.aldiwan.net/poem53981.html","الوافر"],[463,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[466,"لئن ضاق حقي عند عوف بن خندف","https://www.aldiwan.net/poem15290.html","الطويل"],[470,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[482,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96970","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96992","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53946","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48650","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64259","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105612","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38333","الطويل"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/76585","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77678","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109289","الوافر"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105077","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65974","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201914","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103430","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63014","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45816","الطويل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123599","الوافر"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136594",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120250","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120512","الطويل"],[4694,"أسير الخطايا عند بابك واقفٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187820",""],[4955,"أخي في الله لا تحزن","https://www.poetsgate.com/ViewPoem.aspx?id=202292",""],[5573,"لاتقولو ضاق فالدرب الحليم","https://www.poetsgate.com/ViewPoem.aspx?id=210462",""],[6213,"نداء العجوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76265&r=&rc=22",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""]],"verses":[["لَئِنْ ضَنّتِ السُّحُبُ الغادِياتُ","فلَسْتُ بدَمْعي عليها ضَنينا",0,"ن",2,0],["لَئِنْ ضِقْتِ عني فالبِلادُ فَسيحةٌ","وحَسْبُكِ عاراً أنني عَنْكِ راحِلُ",1,"ل",1,0],["لَئِن ضَمَّ جُنحَ اللَيلِ أَثناءُ بُردِهِ","لَقَد شَقَّ عَن مِثلِ الصَباحِ التَبَسُّمُ",2,"م",1,0],["لَئِن ضَلَّ يَوماً بِالمُجَشَّرِ رَأيُهُ","وَكانَ لِعَوفٍ حاسِداً لا يَضيرُها",3,"ر",3,0],["لئن ضاع مثلي عند مثلك إنني","لعمر المعالي عند غيرك أضيع",4,"ع",1,1],["لئن ضُمِّنُوا صوْن ساداتنا","لما صان عينا كأجفانها",5,"ن",3,0],["لئن ضننت فما لي لا أضنّ به","على الفناء سوى آثار وجدان",6,"ن",1,0],["لَئِن ضَجَّتِ الهُلّاكُ مِن نَكَدِ الرَدى","لَعيشُ الأُلى لَم يُطعَموا الهُلَكَ أَنكَدُ",7,"د",1,0],["لَئِن ضَحِكَت مِنكَ الإِماءُ لَقَد بَكَت","عَلَيكَ فَأَعوَلنَ النِساءُ الحَرائِرُ",8,"ر",1,0],["لئن ضعت عند الأغنياء من الورى","فلي أسوة في خالد بن سنان",9,"ن",1,0],["لئن ضجت الهلاك من نكد الردى","لعيش الألى لم يطمعوا الهلك أنكد",10,"د",1,0],["لئن ضاع سعي الخلق في جنب سعيه","كما ضاع في بحر رذاذ من القطر",11,"ر",1,0],["لئن ضيّعتني قلبي","فأنت الروح والقلب",12,"ب",1,0],["لَئِن ضاقَت بِيَ الزَوراءُ داراً","فَما ضاقَت بِلادُ اللَهِ عَنّي",13,"ن",2,0],["لَئِن ضاقَتِ الزَوراءُ عَني مَنزِلاً","فَلي في بِلادِ اللَهِ مُرتَكَضٌ رَحبُ",14,"ب",1,0],["لئن ضاع عمري فيمن سواك","غراماً فإن عليك الخَلَف",15,"ف",1,0],["لَئِنْ ضُمِّخَتْ دِيباجَتَاها بِمِسْكَةٍ","لقَد ضُرِّجَت كافورَتاها بِعَنْدَمِ",16,"م",1,0],["لئن ضاعَ عهدي عندها بعد بُعدِها","فَما ضاعَ عِندي عهدُها المتقدِّمُ",17,"م",1,0],["لئن ضنَّ الغمامُ عليكِ إِني","سقيتُ ثرى ضريحكِ من دموعي",18,"ع",2,0],["لئن ضيّعتُ أيام التصابي","فإنِّي قد حَظيتُ على الوقار",19,"ر",1,0],["لئن ضرّني بالهجر أني أسيرها","لما سرّني بالغدر أني طليقُها",20,"ق",3,0],["لئنْ ضاق حقي عند عوف بن خندف","فعند ابن نوشروان غيرُ مُضاعِ",21,"ع",1,1],["لَئِن ضَجَّ من حولكَ الظالمون","فإنّا وُكِلنا إلى الأظلَمِ",22,"م",1,0],["لئن ضيَّعوا عهدي فما ضاعَ عهدهمْ","وحاشا بعدَ الحفظِ يُحسَبُ ضائعا",23,"ع",2,0],["لئن ضاق بطن الأرض فيه فإنه","لمن ضاق في آلائه كل راحب",24,"ب",1,0],["لئن ضرب الأمثال في فقد يوسف","وما نال من يعقوب فيه التأسف",25,"ف",1,0],["لَئِنْ ضاعَ رِزْقِي عندكَ اليومَ إنّه","لدى قاسمِ الأرْزاقِ ليسَ يَضِيعُ",26,"ع",1,1],["لئن ضعفنا في عباب البحرِ","فسوفَ نقوى في يباب البرِّ",27,"ر",1,0],["لئن ضُمِّنَ القبرُ الكريم كريمتي","فأكرمُ مضمونٍ وأكرمُ ضامن",28,"ن",1,0],["لئن ضل ركب يمموك هداهم","عبير تراب فيك مازال معطارا",29,"ر",2,0],["لَئِن ضَلَّ عَنها مَن يُريد كِرامها","فَنَفحُكَ لا رَيب إِلَيها لَهُ يهدي",30,"د",2,0],["لَئِن ضَنَّ هَذا الدّهر في بَذلِ مِثلِهِ","أَما هوَ في ذا الدَّهرِ لا شَكَّ واحِدُ",31,"د",1,0],["لَئِن ضَنَّ الأَسى بِالصَبرِ عَنّي","فَما ضَنَّت بِأَدمُعِها مَآقي",32,"ق",2,0],["لئن ضاقَ رحب ارض في عظم رزئكم","فصدرُك منه أي وعلياك أرحبُ",33,"ب",1,0],["لَئِن ضحكتُ سُروراً بِالوِصال لَقَد","بَكَيتُ حُزناً عَلَيهم وَالدُموعُ دَمُ",34,"م",1,0],["لئن ضن الزمان بها علينا","فتلك عوائد الزمن الظلوم",35,"م",1,0],["لئن ضاع وتربني هاشم","إذا عدمت هاشم مجدها",36,"د",3,0],["لَئِن ضاقَ مِنها الجفنُ مِن عَبَراتها","فَأَضلاعُها عَن دَمعِها لَم تُضَيَّقِ",37,"ق",1,0],["لئن ضحكوا يوماً فيا رب ضاحك","يصير إذا أصبحته غير ضاحك",38,"ك",1,0],["لئن ضاع عُكازي تعكزت بالسمع","كأني أخو رقص يسير على الوقع",39,"ع",1,0],["لئن ضَعُفتَ وأضناك الساقم فلم","تضعف قوى عقلك الصافي ولم تمد",40,"د",1,0],["لئن ضاقَ عني عفوكَ الواسعُ الذي","أُرجى لاسرافي فإني لتالفُ",41,"ف",1,0],["لَئن ضَرَبَ النَطق البَليغ سَرادِقاً","عَلى البَعض مِنهُ أَعوزتهُ التَمائم",42,"م",1,0],["لئِنْ ضاقتْ بيَ الأيامُ ذَرْعاً","فصبرِي مُذْهِبٌ ما عِشْتُ كَرْبِي",43,"ي",1,1],["لئن ضاع فضلي لدى معشر","أراهم بعين المعالي حميرا",44,"ر",2,0],["لئن ضاع حقُّ الود بين ظبائها","فصَّدت فما ضاعت لدي حقوقها",45,"ق",3,0],["لئن ضننت عليه الارض يوما","بقبر فهو في صدري رحيب",46,"ب",1,0],["لئن ضقت ذرعا بالصدود فكلما","عراني وجد فيك قلت على الرحب",47,"ب",1,0],["لئن ضاق عني عفوك الواسع الذي","أرجو لإسرافي فإني لتالفُ",48,"ف",1,0],["لئن ضاقت بنا الدُّنيا","فظلُّ العرشِ يَجمَعُنَا",49,"ن",2,0],["لين ضاع الخير بالشر العميم","واصبح المضهود ماينشد جداي",50,"ا",2,0],["لئن ضاعت مواكب أهل عزم","وباتت في مخالبه ظباء",51,"ا",2,0],["لَئِنْ ضَاعَ وَقْتٌ فِي غَيَاهِبِ سِجْنِهِمْ","فَكَمْ سُجِنَ الْأَحْرَارُ وَ الثُّوَّرُ الشُّمُّ",52,"م",1,0]]}