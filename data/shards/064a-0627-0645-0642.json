{"poems":[[53,"يا مقلقي قلقي عليك","https://www.aldiwan.net/poem29917.html","مجزوء الكامل"],[53,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[72,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[61,"طلب الدهر ثأره","https://www.aldiwan.net/poem51353.html","مجزوء الخفيف"],[44,"مثل ودي لا يغيره","https://www.aldiwan.net/poem30596.html","المديد"],[52,"قل لمراض الحدق","https://www.aldiwan.net/poem26815.html","مجزوء الرجز"],[52,"ألا ترى يا صاح ما حل بي","https://www.aldiwan.net/poem27117.html","السريع"],[52,"يا مقلة أدنفت كما دنفت","https://www.aldiwan.net/poem27208.html","المنسرح"],[76,"أنت بما في نفسه أعلم","https://www.aldiwan.net/poem39002.html","الرجز"],[76,"يا مقلة الرشإ الغري","https://www.aldiwan.net/poem39329.html","مجزوء الكامل"],[199,"دارت عليها للهوى راحة","https://www.aldiwan.net/poem45173.html","السريع"],[225,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[225,"يا مقر الغزال قد صح عندي اليوم","https://www.aldiwan.net/poem55158.html","الخفيف"],[235,"يا قضيبا إذا انثنى","https://www.aldiwan.net/poem31897.html","مجزوء الخفيف"],[297,"من أودع الراح والأقاح فمك","https://www.aldiwan.net/poem33200.html","المنسرح"],[305,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[364,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[364,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[377,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[441,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[464,"يا غصن بان على دعص","https://www.aldiwan.net/poem3225.html","عموديه"],[464,"يا مقعد القاضي السعيد","https://www.aldiwan.net/poem3331.html","عموديه"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"طيب الحبائب إذا هب الهوى ندي","https://www.aldiwan.net/poem34589.html","المواليا"],[575,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"]],"verses":[["يا مُقلِقي قَلَقي عَلَي","كَ أَظُنُّهُ ذَنبي إِلَيكا",0,"ك",2,1],["يا مِقوَلَ الدَهرِ لِم صَمَتَّ وَقَد","كُنتَ زَماناً أَمضى مِنَ القُضُبِ",1,"ب",1,0],["يا مقلتي بالوصلِ قرّي ويا","مدائحي في ابن حميد ارْتعي",2,"ع",2,0],["يا مقطعاً قلبي وقاطع عادتي","من عاجل التأميل والتأمين",3,"ن",1,0],["يا مقيما على الوفا","ء لمن يكره الوفا",4,"ف",2,0],["يَا مُقيدَ الشَوقِ مِن كَبِدي","آهِ لا صَبرٌ وَلا جَلَدُ",5,"د",1,0],["يا مُقلَةً أَجفانُهَ","مَفتوقَةٌ بِالأَرَقِ",6,"ق",1,0],["يا مُقمِراً في الشَعَرِ الأَسوَدِ","وَضاحِكاً في أُقحُوانٍ نَدي",7,"ي",1,0],["يا مُقلَةً أُدنِفَت كَما دَنِفتُ","مَرَّت بِنا سَنحَةً وَما وَقَفتُ",8,"ت",1,1],["يا مقلةً وحشيَّةً قتلتْ","نفساً بلا نفْسٍ ولم تَظلِمْ",9,"م",1,0],["يَا مُقْلةَ الرَّشإِ الغَري","رِ وشُقةَ القَمَرِ المُنيرْ",10,"ر",1,1],["يا مقلتيَّ إذا بقي","في الجفنِ دمعٌ فاسكباهُ",11,"ه",1,0],["يا مُقفِرَ المُلكِ إِلّا من جلالتِهِ","وَمُلبِسَ القومِ ثوبِ العِزِّ وَالهونِ",12,"ن",1,0],["يا مقرَّ الغزالِ قد صحَّ عندي ال","يومَ أَنّي اقتَحَمتُ منكَ عرينا",13,"ن",2,1],["يا مُقيماً عَلى الصُدو","دِ أَما تَعرِفُ الرِضا",14,"ض",2,0],["يا مقسِماً أَن يُذيبَني كلَفاً","حسبُك أَبررتَ بالجَفا قَسمَك",15,"ك",1,0],["يا مقحماً بمحاضر الآداب سخ","رِيةً لكيما يستدرّ مكاسبا",16,"ب",2,0],["يا مُقيمَ المجدِ في أعلَى السُّها","ومُطارَ الذِّكْرِ بينَ الخافقَين",17,"ن",1,0],["يا مُقلةً نَجلاءَ كُلُّ دمٍ بها","مِمّا سَفَكْتِ فإنّه مَطْلول",18,"ل",1,0],["يا مَقدس الأقداس فيك أعظمُ ال","أحبارِ حلَّ وبابُه مقفول",19,"ل",1,0],["يا مقلتيَّ انزلا في جري دمعكما","على الذي راح تحت الترب منزولا",20,"ل",2,0],["يا مقلة الريم قد الغصن سالفة ال","غزال ثغر الأقاحي طلعة القمر",21,"ر",1,0],["يا مقعد القاضي السعي","د منحتني عيَّا ولكنه",22,"ن",2,1],["يا مقتني ذممي ما نعتني بدمي","جزيتني فظمي قلبي السني وفمي",23,"م",2,0],["يا مقلتي أمطري أو بالدما ندّي","لا تلتقي ندهم هم يلتقوا ندّي",24,"ي",1,0],["يا مقلتي قد كنتِ مُشتاقةً","أَرْضاً تَطاها خيلُه فالْثَم",25,"م",1,0]]}