{"poems":[[55,"يا مقلقي قلقي عليك","https://www.aldiwan.net/poem29917.html","مجزوء الكامل"],[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[74,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[74,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[63,"طلب الدهر ثأره","https://www.aldiwan.net/poem51353.html","مجزوء الخفيف"],[46,"مثل ودي لا يغيره","https://www.aldiwan.net/poem30596.html","المديد"],[54,"قل لمراض الحدق","https://www.aldiwan.net/poem26815.html","مجزوء الرجز"],[54,"ألا ترى يا صاح ما حل بي","https://www.aldiwan.net/poem27117.html","السريع"],[54,"يا مقلة أدنفت كما دنفت","https://www.aldiwan.net/poem27208.html","المنسرح"],[78,"أنت بما في نفسه أعلم","https://www.aldiwan.net/poem39002.html","الرجز"],[78,"يا مقلة الرشإ الغري","https://www.aldiwan.net/poem39329.html","مجزوء الكامل"],[203,"دارت عليها للهوى راحة","https://www.aldiwan.net/poem45173.html","السريع"],[230,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[230,"يا مقر الغزال قد صح عندي اليوم","https://www.aldiwan.net/poem55158.html","الخفيف"],[240,"يا قضيبا إذا انثنى","https://www.aldiwan.net/poem31897.html","مجزوء الخفيف"],[302,"من أودع الراح والأقاح فمك","https://www.aldiwan.net/poem33200.html","المنسرح"],[310,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[369,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[369,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[382,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[447,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[469,"يا غصن بان على دعص","https://www.aldiwan.net/poem3225.html","عموديه"],[469,"يا مقعد القاضي السعيد","https://www.aldiwan.net/poem3331.html","عموديه"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"طيب الحبائب إذا هب الهوى ندي","https://www.aldiwan.net/poem34589.html","المواليا"],[580,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110444","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48805","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64108","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38645","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59265","السريع"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136247","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136176","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112738","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64548","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95564","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79967","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79794","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113737","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106873","البسيط"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144373","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140068",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122495","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118950","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132730","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45905","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66529","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125925","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135729","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203268","المجتث"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83126","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33780","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33168","البسيط"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113824","البسيط"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67452","الخفيف"],[4717,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=199597",""],[4778,"سائل الأطيار عني","https://www.poetsgate.com/ViewPoem.aspx?id=193619",""],[4797,"من لابتي مّره الى جدي افطيس","https://www.poetsgate.com/ViewPoem.aspx?id=71831",""],[4830,"ياموسى العراق","https://www.poetsgate.com/ViewPoem.aspx?id=198352",""],[4866,"قيود الريح","https://www.poetsgate.com/ViewPoem.aspx?id=135939",""],[5000,"كلُّ عام","https://www.poetsgate.com/ViewPoem.aspx?id=5540",""],[5005,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=195380",""],[5198,"زهرة الريف","https://www.poetsgate.com/ViewPoem.aspx?id=135066",""],[5277,"يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=190761",""],[5356,"جنّيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204487",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5442,"ذاك الفراق وان أصم مسامعي","https://www.poetsgate.com/ViewPoem.aspx?id=114744",""],[5533,"وَطَنِي","https://www.poetsgate.com/ViewPoem.aspx?id=176873",""],[5573,"ياهجسُ مالكَ لاتميلُ لراحتي","https://www.poetsgate.com/ViewPoem.aspx?id=213731",""],[5725,"الصلاة على محمد","https://www.poetsgate.com/ViewPoem.aspx?id=211490",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[5829,"شيء من الاحلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=213519",""],[5848,"يا للأسف","https://www.poetsgate.com/ViewPoem.aspx?id=53383",""],[6164,"إلى البلبل الغريد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66078&r=&rc=87",""],[6234,"ديواني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6528&r=&rc=0",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["يا مُقلِقي قَلَقي عَلَي","كَ أَظُنُّهُ ذَنبي إِلَيكا",0,"ك",2,1],["يا مِقوَلَ الدَهرِ لِم صَمَتَّ وَقَد","كُنتَ زَماناً أَمضى مِنَ القُضُبِ",1,"ب",1,0],["يا مقلتي بالوصلِ قرّي ويا","مدائحي في ابن حميد ارْتعي",2,"ع",2,0],["يا مقطعاً قلبي وقاطع عادتي","من عاجل التأميل والتأمين",3,"ن",1,0],["يا مقيما على الوفا","ء لمن يكره الوفا",4,"ف",2,0],["يَا مُقيدَ الشَوقِ مِن كَبِدي","آهِ لا صَبرٌ وَلا جَلَدُ",5,"د",1,0],["يا مُقلَةً أَجفانُهَ","مَفتوقَةٌ بِالأَرَقِ",6,"ق",1,0],["يا مُقمِراً في الشَعَرِ الأَسوَدِ","وَضاحِكاً في أُقحُوانٍ نَدي",7,"د",2,0],["يا مُقلَةً أُدنِفَت كَما دَنِفتُ","مَرَّت بِنا سَنحَةً وَما وَقَفتُ",8,"ت",1,1],["يا مقلةً وحشيَّةً قتلتْ","نفساً بلا نفْسٍ ولم تَظلِمْ",9,"م",1,0],["يَا مُقْلةَ الرَّشإِ الغَري","رِ وشُقةَ القَمَرِ المُنيرْ",10,"ر",1,1],["يا مقلتيَّ إذا بقي","في الجفنِ دمعٌ فاسكباهُ",11,"ه",1,0],["يا مُقفِرَ المُلكِ إِلّا من جلالتِهِ","وَمُلبِسَ القومِ ثوبِ العِزِّ وَالهونِ",12,"ن",1,0],["يا مقرَّ الغزالِ قد صحَّ عندي ال","يومَ أَنّي اقتَحَمتُ منكَ عرينا",13,"ن",2,1],["يا مُقيماً عَلى الصُدو","دِ أَما تَعرِفُ الرِضا",14,"ض",2,0],["يا مقسِماً أَن يُذيبَني كلَفاً","حسبُك أَبررتَ بالجَفا قَسمَك",15,"ك",1,0],["يا مقحماً بمحاضر الآداب سخ","رِيةً لكيما يستدرّ مكاسبا",16,"ب",2,0],["يا مُقيمَ المجدِ في أعلَى السُّها","ومُطارَ الذِّكْرِ بينَ الخافقَين",17,"ن",1,0],["يا مُقلةً نَجلاءَ كُلُّ دمٍ بها","مِمّا سَفَكْتِ فإنّه مَطْلول",18,"ل",1,0],["يا مَقدس الأقداس فيك أعظمُ ال","أحبارِ حلَّ وبابُه مقفول",19,"ل",1,0],["يا مقلتيَّ انزلا في جري دمعكما","على الذي راح تحت الترب منزولا",20,"ل",2,0],["يا مقلة الريم قد الغصن سالفة ال","غزال ثغر الأقاحي طلعة القمر",21,"ر",1,0],["يا مقعد القاضي السعي","د منحتني عيَّا ولكنه",22,"ن",2,1],["يا مقتني ذممي ما نعتني بدمي","جزيتني فظمي قلبي السني وفمي",23,"م",2,0],["يا مقلتي أمطري أو بالدما ندّي","لا تلتقي ندهم هم يلتقوا ندّي",24,"ي",1,0],["يا مقلتي قد كنتِ مُشتاقةً","أَرْضاً تَطاها خيلُه فالْثَم",25,"م",1,0],["يا مقرَّ الهنا عليكَ سَلاَمُ","يا جناناً بهِ يطيبُ المَقامُ",26,"م",1,0],["يا مقبلين بمصدوق المنى زمراً","ملء الميادين والآفاق والقنن",27,"ن",1,0],["يا مقيماً على سبيل انطلاقِ","ومخلَّىً وروحُهُ في وَثاقِ",28,"ق",1,1],["يا مُقرِفاً في الأَكلِ حينَ يُريدُهُ","ما كانَ بَينَ النّاسِ بِالإِنسانِ",29,"ن",1,1],["يَا مُقْلَةَ الظَّبْيِ وَغُصْنَ النَّقَا","وَمَبْسَمَ الدُّرَ وَجِيدَ الغَزَالْ",30,"ل",1,1],["يا مقيماً في الصدر قد خِفت","أن يؤذيك للقلب حرقة ووجيب",31,"ب",1,0],["يا مقبلا على الهوى","قدمت في حصن منيع",32,"ع",1,0],["يا مقيما بين الاماني على ما","ذا التمادي والناهضات اكيده",33,"د",2,0],["يا مقسط يا جامع انت الغني المغنى","فاتحفنا بلطف جال",34,"ل",1,0],["يا مقيت المبر يا واجد المو","جد رزقي بارك عليه وزد لي",35,"ل",2,0],["يا مقيماً لمسجد فيه فرض الل","هِ يُقضى فتخدم الإسلامَا",36,"م",2,0],["يا مقرضَ الأرض في عصرٍ بها وثقت","بنو الزمان بكنز البيض والصفر",37,"ر",1,0],["يا مُقيل العِثار تُهنيك بُشرى","تركت جدَّ حاسديك عَثورا",38,"ر",2,0],["يا مقيم الدنيا أتهوي صريعاً","وتقر الدنيا على مرساها",39,"ا",3,0],["يا مُقلتي هذا المقامُ الأكبَرُ","والروضَةُ الغنّاءُ فيها المنبَرُ",40,"ر",1,1],["يا مقلتاكِ وإني شاربٌ بهما","خمرَ الهوى وفؤادي في الهوى ثملا",41,"ل",2,0],["يا مقلة الظبي الغرير","ووجنة القمر المنير",42,"ر",1,1],["يا مقري الضيفان يا من إذا","ناديته أو قلت شيء لله",43,"ل",2,0],["يا مُقبِرِيه لقَد أقبرتُم مَعُهُ ال","فخَارَ والبِرَّ والتَّوفِيقَ والحِكَمَا",44,"م",2,0],["يا مقعد العزمات يا عبد الهوى","يا بانياً والبين يهدم ما بنى",45,"ن",2,1],["يا مقبلا سر باقباله","فخض قوما بالتهاني وعم",46,"م",1,0],["يا مَقعد الحَظ العَظيم","أَبلغ لربك وَاِسأل",47,"ل",1,1],["يا مقيساً صوب الغمام بندب","قد غدا طاعة السخاء وراحا",48,"ح",2,0],["يا مقر الحب يا نبع النهى","أنت ميدان التصافي والألم",49,"م",1,0],["يا مقسطٌ يا جامعٌ أيا غني","يا مغني أغنني بفضلك السني",50,"ي",1,0],["يا مقسط مغني ومعطي مانعُ","جميع خيرك لنا يسارعُ",51,"ع",1,0],["يا مقلة الحب مهلاً","فقد أخذت بثارك",52,"ك",1,1],["يا مُقسِمينَ بِحُبِّ مصرَ وَإِنَّهُ","قَسَمٌ أَحَقّ بَحُرمَةٍ وَوَفاءِ",53,"ا",2,0],["يا مقلتيَّ قتلتماني","فبقِيتُ رَحمة من يراني",54,"ن",2,1],["يا مقلةً سوف أبكيها ويا كبداً","بها أنيط الهوى والشوق فاحترقت",55,"ت",1,0],["يا مقصد العلماء النجب تجمعهم","في حضن مكتبة من كل معلوم",56,"م",1,0],["يا مقيتاً يصور اليوم حولاً","ساعة منه ليلة الميلاد",57,"د",1,0],["يَا مُقْلَةَ الْكَرْمِ وَالْأَجْفاَنُ تَعْصِرُهَا","عَتَّقْتُ باِلْقَلْبِ مَا قطَّرتِ مِنْ سَكَرِ",58,"ر",1,0],["يا مقيما في فؤادي","................... ماثلا تلقاء ظني",59,"ن",2,0],["يامقلّطينٍ شذرة السيف والكيس","قد قالها ابن حميد ضمن المثايل",60,"ل",1,0],["يامقلةً تتلو بفيضِ دموعها","آيَ التضرّعِ ترتجي عُقباكا",61,"ك",2,0],["يا مْقيّده بالريح والقيد كونك","يا ركابه بالريح موجة عنيفة",62,"ف",2,0],["يا مُقيما في جَناني","حُبُّه قد باتَ فرضا",63,"ض",2,0],["يا مقلتيّ خذاني للحبيب عسى","أطفي اللهيب الذي في خافقي استعرا",64,"ر",2,0],["يامقرب الغبّة ويامبعد السيف","بانت علامات الغرق حسب ظنّي",65,"ن",2,0],["يا مقلةَ العينِ هل تدري مدى وجَعي","إن غابَ طيفُكَ قل لي كيف ألقاهُ ؟",66,"ا",2,0],["يا مُقلتيَّ وقد أشعلتما لَهَفي","بحثاً عن الحُسنِ بينَ العَينِ والحورِ",67,"ر",1,0],["يا مقلة العين هل تنأى بمهجتنا","من سوق كنَّاة تحت الأرض مفرودِ",68,"د",1,0],["يامقلتي خل البكاء ليجتلي","بصري سنا هذا الضياء الساطع",69,"ع",1,0],["يا مُقِيْماً في فُؤَادِي","أَنْتَ لي ظِلٌّ ظَلِيْلْ",70,"ل",1,1],["يامُقفراً جذبَ السُرى بحِبالهِ","حين إستمال برجْعِهِ النسماتِ",71,"ت",1,0],["يا مقلةً وقرتْ بلون سوادها","يا أحلى من يحلو بها تأبيني",72,"ن",2,0],["يامقام الزين ..... مافيها جدال.","شدني التفكير ..... لخطوطٍ حمر.",73,"ر",1,1],["يا مقلتيها والبحار تماوجت","زرقا وخضرا تستفز هيامي",74,"م",2,0],["يا مقبلات ايامنا وش وراكن؟","وماضيكن اللي فات معروف وش جاب",75,"ب",1,0],["يا مُقْبِلَ الشِّعْرِ.. ما أحْلاكَ مِن وَتَرٍ","غَنَّى. فَلِلسَّمْع تطريب. ولِلْبَصَرِ!",76,"ر",1,1],["يا مقلتي إن لم تري في الضحى ‍ ‍","شيئا فماذا في الدجى تبصرين ؟",77,"ن",1,0],["يا مُقيل العِثار تُهنيك بُشرى","تركت جدج حاسد يك عثورا",78,"ا",1,0]]}