{"poems":[[46,"ألم يأن أن تروى الظماء الحوائم","https://www.aldiwan.net/poem30365.html","الطويل"],[286,"إلى أحمد المختار نهدي تحية","https://www.aldiwan.net/poem1393.html","الطويل"],[376,"تمادى بهم أمد سرمد","https://www.aldiwan.net/poem57478.html","المتقارب"],[409,"إلي أحاديث الصبابة تسند","https://www.aldiwan.net/poem33978.html","الطويل"],[422,"إلى إحسان مولانا الرفاعي","https://www.aldiwan.net/poem54178.html","الوافر"],[475,"أيا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem4800.html","الطويل"],[580,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34902","الهزج"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93838","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202514","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86244","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72431","الرجز"],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[5739,"خيط الازرّه تشنّج ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131234",""],[6075,"على بوابة الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190650",""]],"verses":[["إِلى أَحمَدَ المَحمودِ رامَت بِنا السُرى","نَواعِبُ في عَرضِ الفَلا وَرَواسِمُ",0,"م",1,0],["إلى أحمد المختار نُهدي تحية","تُفاوحُ روض الحزنِ بلّله المزنُ",1,"ن",1,1],["إلى أحمدٍ ومتى لم يكن","يفرِّقُ ما بيننا أحمدُ",2,"د",1,0],["إليَّ أحاديث الصبابة تُسْنَدُ","وَعَنِّي رُوَاةُ الحب في الوجد أسندوا",3,"د",3,1],["إلى إحسان مولانا الرفاعي","بكشكول الرَّجاء مددت باعي",4,"ع",2,1],["إِلى أَحَدٍ مِن آلِ مَروانَ ذي حِجىً","بِأَمرٍ كَرِهناهُ مَقالاً لِقائِلِ",5,"ل",1,0],["إِلى أَحمدَ المُحيي شَريعةَ أَحمدٍ","فلا عَدِمتْ منهُ أَباً أُمَّهُ الأُمِّي",6,"م",2,0],["إِلى أَحسَنِ خَلقِ اللَ","هِ إِن قَدَّسَ أَو غَنّا",7,"ن",2,0],["إلى أحمد الناس انتهت غابة الرجا","وإني لفقدان الدراهم واجد",8,"د",1,0],["إلى أحمدٍ أُنمَى وأخلاق أحمد","فإني هذا الجزء من ذلك الكل",9,"ل",1,1],["إِلى احمَد الاِفعالِ وَجهت هِمَّتي","وَنَحو حَماهُ قَد سَلَكَت طَريقا",10,"ق",2,0],["إلى احتساء الحيس من انشاده","كم قد دعا جندب فهمي فاحتسا",11,"س",2,0],["إلى أَحضانِها م الحَرِّ فِئْناº","وحُجرُ الأُمِّ أَولى بالصغيرِ",12,"ر",1,0],["اليا حضرتي ..... صلاحيات منتهيه.","الغيد شانت ..... لو المكياج ماليها.",13,"ي",3,0],["إِلَى أَحْضَانِه الْوَلْهَى","يَزُفُّ حَنِينَهُ الْأَعْدَلْ",14,"ل",1,0]]}