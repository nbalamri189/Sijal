"الوافر"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136379",""],[4755,"أَرَى أُمَّةً فِي الدُّرِّ تَطوِي شِرَاعَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=190645",""],[4767,"تاج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=179616",""],[4797,"الحب مثل النوم","https://www.poetsgate.com/ViewPoem.aspx?id=29437",""],[4809,"وفوق الرمل من يبني سيشقى","https://www.poetsgate.com/ViewPoem.aspx?id=201475",""],[4858,"غفلة وتوبة","https://www.poetsgate.com/ViewPoem.aspx?id=30104",""],[4858,"ضعيفاً قد خُلِقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=155356",""],[4988,"فوز وفشيله","https://www.poetsgate.com/ViewPoem.aspx?id=185312",""],[5057,"ثمار المحبّة","https://www.poetsgate.com/ViewPoem.aspx?id=208545",""],[5105,"إلام اتباعي للأماني الكواذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=135342",""],[5131,"أخذت المبادئ عن عصبةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=42206",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5184,"صبرُ الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=189879",""],[5198,"نواف","https://www.poetsgate.com/ViewPoem.aspx?id=156536",""],[5277,"لا أهوى سواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=191240",""],[5302,"بلغوا هندا سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=200950",""],[5431,"فداك القلب ياطفلا بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=188499",""],[5431,"أيا عيدي وياسكني وأنسي","https://www.poetsgate.com/ViewPoem.aspx?id=190959",""],[709,"ويا وميضَ بروقِ المزنِ إنْ سفرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=2956",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5595,"العظيم له احتراما","https://www.poetsgate.com/ViewPoem.aspx?id=144522",""],[5595,"سَلاماً أيّها الوطنُ","https://www.poetsgate.com/ViewPoem.aspx?id=144627",""],[5595,"أبا السّجادِ يا كلَّ نبيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=175953",""],[5595,"ويا وَجعاً","https://www.poetsgate.com/ViewPoem.aspx?id=176739",""],[5616,"تغريبة \"محمود\"","https://www.poetsgate.com/ViewPoem.aspx?id=203240",""],[5616,"اسمنت","https://www.poetsgate.com/ViewPoem.aspx?id=203432",""],[5694,"ياشين قهر الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=129914",""],[5704,"ألا إن الحبيب مضى وغابا٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204191",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5756,"أهل الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=34581",""],[5790,"إن أقفر السفح والصريخ","https://www.poetsgate.com/ViewPoem.aspx?id=112129",""],[5860,"فراق","https://www.poetsgate.com/ViewPoem.aspx?id=191882",""],[5877,"يا وجودي ..","https://www.poetsgate.com/ViewPoem.aspx?id=37475",""],[5956,"في الحقيقة أنت سُوري","https://www.poetsgate.com/ViewPoem.aspx?id=183707",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5969,"مَدارٌ لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=206928",""],[5997,"أسير","https://www.poetsgate.com/ViewPoem.aspx?id=214460",""],[6100,"العام في شوفي تزف التباشير","https://www.poetsgate.com/ViewPoem.aspx?id=52552",""],[6115,"يالله يالمعبود يارب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=181732",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[6229,"نشيد أطفال الحضانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82510&r=&rc=45",""],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""]],"verses":[["وَيا وَيحَ قَلبي كَيفَ زايَدتُ في مِنىً","بِذي البانِ لا يُشرَينَ إِلّا غَوالِيا",0,"ي",2,0],["وَيَأْوي إِلَيْها كُلُّ أَروعَ يَرْتَقِي","إِلى المَجْدِ حُرِّ البَأْسِ حُلْوِ الشَّمائِلِ",1,"ل",1,0],["ويأْوي إلَيها مِنْ لُؤَيِّ بنِ غالِبٍ","إذا شَبَّتِ الهَيْجاءُ ذو لَجَبٍ مَجْرُ",2,"ر",1,0],["وَيا وَيحَ لِلأَشعارِ بَعدَ نَجِيِّها","وَوَيحَ القَوافي ساقَها غَيرُ شاعِرِ",3,"ر",1,0],["وَيا وَيحَ لِلفُتيا إِذا قيلَ مَن لَها","وَيا وَيحَ لِلخَيراتِ وَالصَدَقاتِ",4,"ت",1,0],["ويا واديا رفّت عليَّ ظلالهُ","ونحن ندير الوصل قُدِّستِ لياليا",5,"ي",2,0],["ويا وجنة قد جاورتْ سيف لحظه","ومن شأنها تدمى من اللمح بالبصرْ",6,"ر",1,0],["ويا واضعاً في كفهِ السيف لم يضر","علاه بوضع السيف في موضع الندى",7,"د",2,0],["ويأوي لظل من سواك رجاؤه","ويعتنق الحرمان من أنت قصده",8,"د",2,0],["وَيا وَطَني لَقَيتُكَ بَعدَ يَأسٍ","كَأَنّي قَد لَقيتُ بِكَ الشَبابا",9,"ب",2,0],["وَياوَيحَ نَفسي وَيحَها ثُمَّ وَيحَها","أَلَم تَنجُ يَوماً مِن شِباكِ الحَبائِلِ",10,"ل",1,0],["وَيا وَيحَ عَيني قَد أَضَرَّ بِها البُكا","فَلَم يُغنِ عَنها طِبُّ ما في المَكاحِلِ",10,"ل",1,0],["وَيا وَجهَ مَن ذَلَّت وُجوهٌ أَعِزَّةٌ","لَهُ وَسَطا عِزّاً فَلَيسَ يُرامُ",11,"م",1,0],["ويا واصِلاً من نشيدِ الخُلود","خِتَامَ القصيدةِ بالمَطْلَعِ",12,"ع",1,0],["ويا ويحَ الحلائلِ والذَّرارِي","تُعانِي البَرْحَ من أَلَمِ الفِراقِ",13,"ق",1,0],["ويا وادي الرمان لا ساغ طعمُهُ","إذاً أنا لم أْمدُدْ لذاك الجنى يدا",14,"د",2,0],["ويا وادي الرمان واهاً وعندهم","حرامٌ على المحزون أنْ يتنهَّدا",14,"د",2,0],["ويا وَيْحَ خانقةٍ مِن غدٍ","إذا نَفَّسَ الغدُ ما يَكظم",15,"م",1,0],["وياوجودي كل ماخلوا محلّه","وياصدع راسي وعقدة حاجبيني",16,"ن",2,0],["ويا ويلنا إن بتُّ أستعطفُ الهوى","وبتَّ على حكمِ الهوى تتجنَّبُ",17,"ب",1,0],["ويا وُزراءَ الصفرِ والبِيض يَقظَةً","لما بِكُم من أشنع العارِ يُلصَقُ",18,"ق",1,0],["وَيا وُلاة الجَمال اِرثوا لمدنفكم","فَلَيسَ عارا عَلَيكُم اِن يُقال رَثوا",19,"ث",3,0],["ويأوي رُكْنُ دينِ اللهِ منه","إلى حَرَمٍ منَ الشُّبُهاتِ آمن",20,"ن",1,0],["ويا وزراء السوء يا شر فرقة","وأخبث أعان لناه وآمر",21,"ر",1,0],["ويا ويحَ قلبي كيفَ يرمينَ أعينٌ","تعلَّمْنَ مرمى الصّيد ثمَّ رَمَيْنَنا",22,"ن",2,0],["ويا واعظاً حيًّا وميتاً وكلُّه","مواعظ تشفي أنفساً ومكارم",23,"م",1,0],["ويا ويح الملاهي وال","أماني والبها الاسنى",24,"ا",1,0],["ويا وحشتي في غُربتيَّ وقلما","أرى غير من باهىَ على الشرِّ وابتدر",25,"ر",1,0],["ويا وشْكَ ما تمسى الديارُ خليّةً","إذا ذهب الباقي ولم يعد الخالي",26,"ل",2,0],["ويأوي ضَريكُ الحي بين بيوتهِ","إِلى رغدٍ من خُرَّمِ العيش ناضرِ",27,"ر",1,0],["ويا وصيَّ رسول الله عنك لنا","منه الفيوضات قد سحَّت ولم تزل",28,"ل",1,0],["ويا وَميضَ بُروقِ المُزنِ إن سفَرتْ","عن الثّنايا فغُضَّ الطَّرْفَ واِستَتِرِ",29,"ر",1,1],["ويا وَجيزَ عِبارات البيان لقد","أطْنَبتَ في وصف ذاك الخَصْر فاِختصِرِ",29,"ر",1,0],["ويا وابلاً لم يحظ روضي بطله","وقد عم أقطار البسيطة قطره",30,"ر",2,0],["ويا واردي ماء العقوق تأدبوا","فذا مورد لا بد تصفو منهله",31,"ل",2,0],["ويا واجد اسعفني وأوجد لي المنى","ويا ماجد اجعلني بمجدك ساميا",32,"ي",2,0],["وياويح عشاق الملاحة في الهوى","يحيرون بين الشرق للشمس والغرب",33,"ب",1,0],["ويا وجهَ إبراهيمَ غيَّرَكَ البِلَى","كما غيَّرَتْنا لوعةُ الحُزنِ لو تدري",34,"ر",2,0],["ويا ويحَ قَلبي كيف يأْوِي لأَضْلعي","وأَفٍّ لنَفْسِي كيف تَسْكُنُ جثماني",35,"ن",2,0],["وياؤُه حُذِفَتْ من اسمه غَلَطاً","فهو الجميلُ وإِنْ سمَّوهُ بالْجَمل",36,"ل",1,0],["ويا وَنّتي وَنّات لي تسجَع الألحان","خُلوجٍ بطول اليوم والليل ما تَمْسيه",37,"ي",2,0],["ويا واحداً ما حَكاه الأنامُ","ولا جاوزوا أُفقاً فاغترب",38,"ب",1,0],["وَيا وَيل مَن عاداه عِندَ نِضاله","سيصلى سَعيراً مِن هوانِ حِمام",39,"م",1,0],["وَيا وَليدة مَحمود مَناقبه","عَلا بِها قَدره في البَدو وَالحضر",40,"ر",1,0],["وَيا واحد الأَيّام يا مَن بِهِ سَمَت","محافلُنا الغَرا بِدُون تَواني",41,"ن",2,0],["وَيا وَحشَتي يا مصرُ منك لبلدة","لداخلها بالأمن بشرى من الباري",42,"ر",2,0],["وَيا وَعدَ من أَهواه ما لَكَ مُخلفاً","وَأَنتَ منى قَلب المَشوقِ وَعيدهُ",43,"د",2,0],["ويا وحشَ الفلاةِ رِدِي عِطاشاً","دُموعي فاكرعي فيها وخُوْضي",44,"ض",2,0],["ويا واحلى في الارض دقّات وطيها","يغبّر بها القاع من بار جودها",45,"د",3,0],["ويا واوحلاها لين ذابت وأدبرت","واصبح بها قوس القدح في ركودها",45,"د",3,0],["وَيا واهِبَ الجُردِ مِثلِ القِدا","حِ قَد يُعجِبُ الصَفَّ شُوّارُها",46,"ر",3,0],["وَيا واهِبَ البَكَراتِ الهِجا","نِ عوذاً تَجاوَبُ أَبكارُها",46,"ر",3,0],["ويا وَجَعَا ًأنوءُ بهِ","وأظهرُهُ وأكتمنُ",47,"ن",1,0],["ويا وليَّ العهود ما نعمتْ","في وطن الملك منك بالوطر",48,"ر",1,0],["وَيَا وِسامًا غَالِيًا","لِشَعْبِنَا المُوَفَّقِ",49,"ق",1,0],["وَيا وَيحَ نَفسِي وَيحَها ثُمَّ وَيحَها","لَئِن لَم يَكُن لِي في هَواكِ نَصِيبُ",50,"ب",1,0],["ويا وهبة الله الزيّن بالتقى","تمثل بايوب الجزيل التورّعِ",51,"ع",1,0],["ويا وافد العرف عد بالسحاب","غب وغيب رجاسه",52,"س",2,0],["وَيا وافِداً قَد أَنزَلَته عِنايَةٌ","هُناكَ فَأَضحى بِالكَرامَة راضيا",53,"ي",2,0],["وياؤه تسكن في رفع وجر","ووقفا أحذفها وإثبات نذر",54,"ر",1,0],["ويا وارث اصرف سورة البغي وانتقم","بعدلك ممن بالضلال تسربلا",55,"ل",2,0],["ويا واحد الباقي بوحدة ذاته","كما كان قبل القبل والأزلية",56,"ه",1,1],["ويا واجد الحق الإلهي لم يفت","كمالك حق من حقوق الألوهة",57,"ه",1,1],["ويا والي الأشياء ملكاً وحيطة","تصرفها حكماً بحسب المشيئة",58,"ه",1,1],["ويا واسع الأشياء علماً ورحمة","فلا شيء إلا بين علم ورحمة",59,"ه",1,1],["ويا واسع البرهان لا لنهاية","ويا واسع السلطان للأبدية",59,"ه",1,0],["ويا واسع الإكرام والفضل والغنى","غناء بلا حد ولا أمدية",59,"ه",1,0],["ويا واسع الأشياء حكماً وقدرة","وسلباً وإيجاباً بغير وسيطة",59,"ه",1,0],["ويا واسع الملك العلي جلاله","جلالك ضاقت تحته كل عزة",59,"ه",1,0],["ويا ويحَ أقدامٍ عَثَرْنَ لفَقده","فلمّا استقالت ثُبِّتتْ عَثَراتُها",60,"ت",3,0],["وَيَا وَاجِدَ الأنَوَار أَوْجِدْ مَسَرَّتِي","وَيَا مَاجِدَ الأَنْوَارِ كُنْ لِي مُعَوِّلاَ",61,"ل",2,0],["وَيَا وَاحِدٌ مَا ثَمَّ إلاَّ وُجُودُهُ","وَيَا صَمَدٌ قَامَ الْوُجُودُ بِهِ عَلاَ",61,"ل",2,0],["وَيَا وَالٍ أَوْلِ أمْرَنَا كُلِّ نَاصِحٍ","وَمُتْعَالِ أَرْشِدْهُ وَأَصِلحْ لَهُ الَولاَ",61,"ل",2,0],["وَيَا وَارِثُ اجْعَلْنِي لِعِلْمِكَ وَارِثاً","وَرُشْداً أَنِلْنِي يا رشِيدُ تَجَمُّلاَ",61,"ل",2,0],["ويأوي إلى بيت وطيء عماده","وفي مصر يبكيه البناء المطنف",62,"ف",1,0],["ويا ويل الظلوم فسوف يلقى","عقاباً يبقى وذكرى",63,"ر",2,0],["ويا ويلَ من لم يراع عهود ال","أمانة بل خانها وغدر",64,"ر",1,0],["ويا واهبَ الآلافِ دون تريُّثٍ","فليس تُحاكيهِ العهادُ المواطِرُ",65,"ر",1,0],["ويا ويلاه من شوق رماني","بسهم مقعد وجوى مقيم",66,"م",1,0],["ويا واحداً ما للمساكين غيرة","اذا ما اثارت قسطلاً أم قسطل",67,"ل",1,0],["ويا ويح من أمعنوا في الفلا","ة إذا الليل جن وغاب القمر",68,"ر",1,0],["وياواحداً أفنى الجموع ولم يزل","بصيحته في الروع يغني عن الألف",69,"ف",1,0],["ويا ويح دهر خطبه يستفزني","وقل له أن قلت يا ويحه دهرا",70,"ر",2,0],["ويا ويحَ مُشتاقٍ محا اليأس مارجا","لحرقته شَرقٌ ولَيسَ لها غَربُ",71,"ب",1,0],["ويأويك الغنى منه قصوراً","ولا يأوى إلى ظل الكهوف",72,"ف",1,0],["ويا والد الندب الهمام تصبرا","ففي جنة الفردوس قد سكن الندب",73,"ب",1,0],["ويا ويل عذالي كتمنا غرامنا","فملا أذاعو لسرنا ظهر السر",74,"ر",1,0],["ويا ويل من لم يستفق من رقاده","إذا الشر اخنى قبل ان يقرع السنا",75,"ن",2,0],["وياوم بر ساجان الأسفل ثم من","شهروج حتى يلتقي بالانة",76,"ه",1,0],["ويا واديا بالرؤى مفعماً","فأنت لكل الرؤى موئل",77,"ل",1,0],["وَيا وابل العافين إِن ذكر النَدى","وَيا فَخر هَذا العَصر إِن ذكر الفَخر",78,"ر",1,0],["وَيَأوي إِلَيهِ المُستَجيرُ مِنَ الرَدى","وَيَأوي إِلَيهِ المُستَعيضُ مِنَ العَدَم",79,"م",1,0],["ويا ويح قوم لا يزال بيومهم","مليك على مهد الضلال عليل",80,"ل",1,0],["ويا وجه هذا البدر هل جئت ساطعاً","لترشدَ أبناء البلاد فيَسعَدوا",81,"د",3,0],["ويا ويحَ مثلي إذا ما دنا ال","صّباحُ دنوتُ إِلى مصرعي",82,"ي",1,0],["وَيا وَيل نفسي يومَ قلتُ لها اصبري","ولم أدرِ أنّ النّفس فارَقهَا الصّبرُ",83,"ر",1,0],["ويا ويح قلبي كيفَ باتَ مُقلَّباً","على جَمرةٍ ما زال يُضرمها الدهرُ",83,"ر",1,0],["ويا واحداً أعيا الكثير مطالُهُ","وما ابن كثير العصر عندي كواحد",84,"د",1,0],["ويا واو صدغيه والثغر منه","بلائي منك بعطف النسق",85,"ق",1,0],["ويا ورق غصنَ البان والرند غادري","على جيف العشاق نوحي سواجعا",86,"ع",2,0],["ويا وجد قلبي دمت مفتاح أدمعي","ولا زلت في تلخيص حزني مطوّلا",87,"ل",2,0],["وَيا وُرْقَ هاتيك الرِياضِ تُغرّدي","وَعَمّا تُغنِّي علّمي أَو تعلّمي",88,"م",2,0],["وَيا وَقى اللَهُ قلباً ما بهِ جَزَعٌ","يَروعُه إثرَ تفريق المحبينا",89,"ن",2,0],["وَيا وَجنةً مِن نَفحةِ الطيب وَالبَها","تذكّرنا الرضوانَ للنفس حَيثُ حل",90,"ل",1,0],["ويا ويح للأبناء يا خير والد","وقد رُوِّعوا في وكرهم حين بشروا",91,"ر",3,0],["ويا ويلكم بعدها إن جفا","وعاف المقام بأرض الهرمْ",92,"م",1,0],["ويا ويل شعب لم يبر فقيره","ولا سمعت من مخلصيه شكة",93,"ه",1,0],["ويا ويح صب غره منك مظهرٌ","أنيقٌ فأمسى وهو عندك موثق",94,"ق",1,0],["ويا وليُّ وارثٌ وفيُّ","إليَّ يأتي خيرُك السنيُّ",95,"ي",1,0],["ويا وكيل يا قويُّ يا متينْ","ويا وليُّ والنا الحفظ المتينْ",96,"ن",1,0],["ويا واحد كن لي معيناً وحافظاً","وفرِّج همومي واطردِ الخوفَ من صدري",97,"ر",2,0],["ويا وارث ارزقني تراث نبيكا","وكثِّر عطائي وارفعَنْه بلا حَدرِ",97,"ر",1,0],["ويا وكيلُ صمدُ يا حكيمْ","مانعُ قابضُ فردّه عميمْ",98,"م",1,0],["ويا ودودُ يا شكورُ ماجدُ","وُدِّي وشكري كبِّرنْ يا واجدُ",99,"د",1,0],["ويا وليُّ يا رشيدُ يا عفوْ","ويا غفورُ بك فاجعل لي البُهُوْ",99,"و",1,0],["ويا ولي يا نصيرُ كن لي","يا حقُّ يا مبين أصلحْ كلي",100,"ي",1,0],["ويا وفي وافي واقي فقنا","شر الذي خلقته ورقّنا",101,"ن",2,0],["ويا واسع وسِّع لنا الرزق كلَّهُ","ووسِّع صدوراً بالعلوم أواسعُ",102,"ع",1,0],["وَيا وَلِيَّ خَرِيسٍ قَد أَجَبتَ دُعا","دَعَوتُهُ وَبَلَوتَ القَوم شَرَّ بَلا",103,"ل",2,0],["وَيا وَطَني مازلتَ لي خَيرَ صاحبٍ","إِذا خانَنَي خَيرُ الصَديقِ المُصاحبِ",104,"ب",1,0],["وَيا وَطَني عَقَّتكَ شِيبٌ وَفتيةٌ","تَداعَوا كَثيراً في مَهاوي المَعاطبِ",104,"ب",1,0],["ويا وحشتي دهراً لفقدكَ مؤنسي","ويا حرّ لبي الدهر أنَّك لازِبُه",105,"ب",2,0],["ويا وأي بل ثم عن قد فاحفظن","كذاك كي لا ثم مذها ثم لن",106,"ن",1,0],["ويا وزيراً شد أَزر الُملكِ بالرَّ","أي الذي أيدهث حتى استقر",107,"ر",1,0],["وَيا وَيلا لِجَسّاسٍ وَعَمرٍو","لَقَد رَميا أَخاكَ بِعَنفَقِيرِ",108,"ر",1,0],["ويا ويل من يلقاه غضبان معرضاً","فيحسب من أهل الشقاوة والحقر",109,"ر",1,0],["ويا وَعْدَهَا الآتِي عَلَى ظَهْرِ غَارَةٍ","بِمَوْتَينِ, كُن شَهْمًا وغَيِّر طِبَاعَهَا",110,"ع",3,0],["ويا وِتراً ببيت الله جاءت","به في البيت آيات الجلال",111,"ل",1,0],["وياوجد حالي وجد من نام ثم قام","على صياح امه وهو دون رجلين",112,"ن",1,0],["ويا وطنًا يسافر في تبابٍ","من الأشلاء إن غربًا وشرقا",113,"ق",2,0],["ويا ويل الذي ضحى بأخرى","لعيش بهارجِ العمر القصيرِ",114,"ر",1,0],["ويا ويلي غررت بما دعتنيِ","إليه النفس من وهمٍ وزورِ",114,"ر",1,0],["ويا ويلَ الّذي قد ضلّ سعياً","ولبّى منْ دعاهُ إلى ضلال",115,"ل",1,0],["ويا ويل من جازت عيونه عن النوم","ليله يعدّي ما تهنى مقيله",116,"ل",2,0],["ويا ويل من هو بدّل الحرّ برخوم","ما فاز في مسعاه تايه دليله",116,"ل",2,0],["ويا ويل من خابت هقاويه بقروم","وشلون يصبر والهقاوي قتيله",116,"ل",2,0],["ويا وَطناً بهِ أحيا طليقاً","إذا ما طالَ في اليمنِ الحِصارُ",117,"ر",1,0],["ويا وطني إن بنتَ عنّي فإنني","سأوطنُ أكوارَ العتاقِ النجائب",118,"ب",1,0],["ويا وطني ما أنا بالذي","يصدُّ إذا ناب ما يصرع",119,"ع",1,0],["ويا واحد امنن لي بجود ورحمة","ووجد ووجدان لما أتمناه",120,"ا",2,0],["ويا واحد أشملني بتوحيدك الذي","به العبد يوتي من دنوك أدناه",120,"ا",2,0],["ويا وارث اجعلني من الوارثين من","يرث جنة الفردوس طوباه طوباه",120,"ا",2,0],["ويا وطناً أحْكيْ ويُخْرِسُني.. ألا","أذِنتَ لِهذا القلْب ِأنْ يخرقَ الضِّلْعا",121,"ع",2,0],["ويا وطناً تُهنا بِسَكرةِ حُبِّهِ","فَضِقْنا بهِ حُبّاً وضاقَ بِنا ذَرْعا",121,"ع",2,0],["ويا وطناً لُذْنا بِخِرْقَةِ ثَوْبِهِ","لِيَمْنَحَنا دِفأً فَأشْبَعَنا رَقْعا",121,"ع",2,0],["ويا والله الاّ روّح النوم يانواف","عسى الحظ لعيوني وانا عمّك يردّه",122,"د",2,1],["ويا ويلي إذا ما جنَّ ليلٌ","وبي من صمتِ غربته نداكِ",123,"ك",1,0],["ويا ويل من يمضي سعيدا بكبره","فيشمخ عني في فصال ويأنف",124,"ف",1,0],["وياوردا تفتح في مسامي","وذابت بي مسامي في شذاه",125,"ا",2,0],["وياولهي بيوميَ بعد أمسي","ويا معنى تماهت فيه نفسي",126,"س",2,0],["ويا وميضَ بروقِ المزنِ إنْ سفرتْ","عنِ الثنايا فغضَّ الطَّرفِ واا ستتر",127,"ر",1,1],["ويا واهب الخيل هذا المدى","ألا أعجل الخيل إعجالها",128,"ل",3,0],["ويا وحياً تراءى في سماء ٍ","تجلّى ينثر العلم انتظاما",129,"م",2,0],["ويا وطناً تطوّحُه الرّزايا","فتخبطُ في دهاليزٍ تلوحُ",130,"ح",1,0],["ويا وجعَ اليتامى والثكالى","ويا حُلماً يداعبُنا سنينا",131,"ن",2,0],["ويا وَجعاً يضمْدُه الشّروقُ","ويَألمُ حينَ يطحَنُه ُالأفول ُ",132,"ل",1,1],["ويا ويل أذني إن تأخّرتُ ساعة","وكنت عليها إن تأخرت أكذب!",133,"ب",1,0],["ويا ويل من عاشوا ضجيجاً وشهرة","كأنهم الأصنام في زمن النحت!",134,"ت",1,0],["وياويلنا من عدوٍ باطشٍ فينا","ياويل الإسلام من عدوان الإسلامي",135,"م",2,0],["وَيَا ويح المصاب بداء عشقٍ","وَيَا ويلاً لمن في الحبِّ خابَا",136,"ب",2,0],["وياوزير الداخلية يارفيع للجناب","لاتهون وجعل كل من يستمع لي مايهون",137,"ن",1,0],["ويا ويل حالي كل ما يحلا لها لون الغروب","تطري لي الريم اللعوب وسالفة ترحالها",138,"ل",3,0],["ويا ولاةَ القلوب رفقا","به أما فيكم رحيم",139,"م",1,0],["ويا وطني هجرتك لا لبغض","ولا أني منحت سواك ودا",140,"د",2,0],["ويا وطني نبا بي عنك حب","وأحياناً يكون الحب صدا",140,"د",2,0],["ويا وطني وداعاً من محب","تحير رأيه أخذاً وردا",140,"د",2,0],["ويا وجودي وجد منهو بساحات القتال","يوم عجّ المعركه ماتوا اخوانه وابيه",141,"ي",2,0],["ويا وطنَ المروءةِ والمعالي","أعِدني في سمائكَ طيرَ دوري",142,"ر",2,0],["ويأوي شفاهي ويسكن عقلي","ويحتلُّ فيَّ الضيا والظلالا",143,"ل",2,0],["وَيا وَطَني سَلامٌ مِنْ فؤادٍ","يُريدُكَ ثائراً تَهفو لثاري",144,"ر",2,0],["ويا ويل قلبي إذا من عليها","بلوها بعسرٍ وخان الصديق",145,"ق",1,0],["ويا ورد قل للتوت لا يكشف البير","كان الصدور قبور لو هي تعاني",146,"ن",2,0],["وياويل نقّال النميمه ومغتاب","يوم الحساب وكشف ستر الخمالي",147,"ل",2,0],["ويأْوي إلى عُشَّ مُرِيحٍ مُنَعَّم","بأفراخِهِ . وهو الحَصِينُ المُسَوَّرُ!",148,"ر",1,0],["ويا وطناً رعى مَهدي صغيراً","ليعهدَ لي رعايتَه فتيّا",149,"ي",2,0],["ويأوي الغباءُ إلى حُضنِهِ","فينجبُ في كل يومٍ بليدْ",150,"د",1,0]]}