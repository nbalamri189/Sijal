{"poems":[[85,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[93,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[45,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[45,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[82,"صب يذوب إلى لقاء مذيبه","https://www.aldiwan.net/poem31568.html","الكامل"],[107,"أرأيتها تبغي السبيل فتهتدي","https://www.aldiwan.net/poem42103.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[280,"ما العيد بعدك بالأماني عائد","https://www.aldiwan.net/poem25592.html","الكامل"],[302,"زهر الدراري أم نظام الجوهر","https://www.aldiwan.net/poem33261.html","الكامل"],[385,"أصبا الأصيل تحملي","https://www.aldiwan.net/poem49234.html","مجزوء الكامل"],[409,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138290",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83288","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96973","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79854","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62931","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66483","الخفيف"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77695","الكامل"],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["فلش يلام عليه خليع","إذا خلع فيه الرسن",0,"ن",1,0],["فَلِشَدوِ مِثلَكَ كُوِّنَت وَلِمِثلِها","خَلَقَ الإِلَهُ البُلبُلَ المِطرابا",1,"ب",2,0],["فَلِشُكلِهِم في خَيلِهِ عَمَلٌ","وَلِعُقلِهِم في بُختِهِ شُغُلُ",2,"ل",1,0],["فَلَشَدَّ ما جاوَزتَ قَدرَكَ صاعِداً","وَلَشَدَّ ما قَرُبَت عَلَيكَ الأَنجُمُ",3,"م",1,0],["فَلِشِبْهِ دُهمتِهِ بدُهمةِ ليله","أمْسى يُفتّشهُ بفرْطِ لهيبهِ",4,"ب",2,0],["فَلَشَرُّ صحبِكَ في النّضالِ سليمُها","ولَخَيْرُ رفقتِكَ الشَقِيُّ بك الرَّدي",5,"د",2,0],["فَلَّ شباهُ أفول نَجم عُلاً","لَهُ بدورُ التَمامِ أَشباهُ",6,"ا",2,0],["فَلَشَدّ ما قَلَصَتْ ظِلالٌ لِلمُنى","تَصْفو وَأقوت للنّعيمِ مَعاهِد",7,"د",1,0],["فلِشعرِه الشِعري العَبورُ تَضاءَلت","كَرهاً وودَّت أَنَّه لم يشعُرِ",8,"ر",1,0],["فَلشدَّ ما زرفت بِغَي","ر تَوقف وَتَكلف",9,"ف",1,0],["فلشيخوخة تسربلت أسما","لأضعافاً ما كن من أثمانك",10,"ك",1,0],["فلشانئ أو حاسد لا تكترث","ان الوضيع على الرفيع يثور",11,"ر",1,0],["فَلَشَدَّ ما قَرَّت عُيونَكَ عِندَما","حَفَّ الجَميعُ لِواءَكَ المَعقودا",12,"د",2,0],["فلشد ما ربضت كلابكم","حذر الأسود فلم تطق نهضا",13,"ض",2,0],["فلشمل السرور عندك نظمٌ","وعلى حاسديك للسوء نثر",14,"ر",1,0],["فَلشَدَّ ما شرَدتْ صَيودُكَ بعدما","تنقادُ مُصْحَبَةً بغيرِ زِمَامِ",15,"م",1,0],["فلشمس الآداب منك شروق","ولبدر الكمال منك بزوغ",16,"غ",1,0],["فلشمس النهار منها وجوب","ولقلب الزمان منها وجيب",17,"ب",1,0],["فَلَشدّ ما قَد أَحسَنا في أَمرهِ","هَذا محمّده وَذا جِبريلُهُ",18,"ل",2,0],["فلشتان بين من عرف الحق","ومن كان جاهلا بالأمور",19,"ر",1,0],["فَلِشَهرَزَادَ الآنَ ( ثَورَةُ لَحْدِهَا )","وَ لَهَا الشَّوَاطِئُ نَورَساً وَ عُبَابا",20,"ب",2,0]]}