{"poems":[[83,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[91,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[43,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[43,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[80,"صب يذوب إلى لقاء مذيبه","https://www.aldiwan.net/poem31568.html","الكامل"],[105,"أرأيتها تبغي السبيل فتهتدي","https://www.aldiwan.net/poem42103.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"]],"verses":[["فلش يلام عليه خليع","إذا خلع فيه الرسن",0,"ن",1,0],["فَلِشَدوِ مِثلَكَ كُوِّنَت وَلِمِثلِها","خَلَقَ الإِلَهُ البُلبُلَ المِطرابا",1,"ب",2,0],["فَلِشُكلِهِم في خَيلِهِ عَمَلٌ","وَلِعُقلِهِم في بُختِهِ شُغُلُ",2,"ل",1,0],["فَلَشَدَّ ما جاوَزتَ قَدرَكَ صاعِداً","وَلَشَدَّ ما قَرُبَت عَلَيكَ الأَنجُمُ",3,"م",1,0],["فَلِشِبْهِ دُهمتِهِ بدُهمةِ ليله","أمْسى يُفتّشهُ بفرْطِ لهيبهِ",4,"ب",2,0],["فَلَشَرُّ صحبِكَ في النّضالِ سليمُها","ولَخَيْرُ رفقتِكَ الشَقِيُّ بك الرَّدي",5,"د",2,0],["فَلَّ شباهُ أفول نَجم عُلاً","لَهُ بدورُ التَمامِ أَشباهُ",6,"ا",2,0]]}