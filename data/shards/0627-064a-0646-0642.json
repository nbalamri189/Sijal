{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[95,"رمى الجاهل الباغي فأودى بجاره","https://www.aldiwan.net/poem11367.html","الطويل"],[53,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[87,"قف بروما وشاهد الأمر واشهد","https://www.aldiwan.net/poem63737.html","الخفيف"],[68,"إنما الحيزبون والدردبيس","https://www.aldiwan.net/poem38647.html","الخفيف"],[104,"أيها الموسم هل أنت سوى","https://www.aldiwan.net/poem33072.html","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[53,"أسالمُ قد سلمتَ من العيوب","https://www.poetsgate.com/ViewPoem.aspx?id=27041",""],[124,"آنستني بالأملا المغري","https://www.aldiwan.net/poem49283.html","السريع"],[201,"اذكريني كلما هب الندامى","https://www.aldiwan.net/poem39906.html","الرمل"],[215,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[215,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[230,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[234,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[280,"قابلت نعماك بالسجود","https://www.aldiwan.net/poem25581.html","مخلع البسيط"],[382,"يا نسيما نراه يروي الغليلا","https://www.aldiwan.net/poem59174.html","الخفيف"],[406,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[411,"أين قلبي سباه من بدر تم","https://www.aldiwan.net/poem49866.html","البسيط"],[422,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[422,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[443,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[482,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[556,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[556,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[567,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122627","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59649","الطويل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145637","المديد"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136093","الخفيف"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122885","الوافر"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144617","المديد"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77364","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129866","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100503","الرجز"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139840",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136516",""],[4717,"فرجعناك إلى أمك كي (...)","https://www.poetsgate.com/ViewPoem.aspx?id=199882",""],[5000,"كيفَ لا أهوى ؟!.","https://www.poetsgate.com/ViewPoem.aspx?id=6405",""],[5064,"إِنّ عيني حبيبتي بلقِيسُ","https://www.poetsgate.com/ViewPoem.aspx?id=199094",""],[5121,"روايتي الشقية","https://www.poetsgate.com/ViewPoem.aspx?id=37466",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[402,"رمى الجاهل الباغي فأودى بجاره","https://www.poetsgate.com/ViewPoem.aspx?id=36302",""],[2096,"ذكر الأحباب والوطنا","https://www.poetsgate.com/ViewPoem.aspx?id=106662",""]],"verses":[["أَينَ قَومٌ عَهِدتُهُم","يَملَؤونَ المَقارِيا",0,"ي",2,0],["أَيَنْقُضُ حَرْباً لَمْ يَرَ اللهُ نَقْصَهُ","وَيَنْمِي عَدِيدَ وَاللهُ مُرغَمُ",1,"م",1,0],["أينقُصُ كاملٌ عُرْفاً أتاه","إلى حُرٍّ وليس بذي ذُنوبِ",2,"ب",1,0],["أَينَ قاضيكِ ما أَناخَ عَلَيهِ","أَينَ ناديكِ ما دَهى شَيخانَه",3,"ن",2,0],["أَينَ قَولي هَذا كَثيبٌ قَديمٌ","وَمَقالي عَقَنقَلٌ قَدموسُ",4,"س",1,0],["أَينَ قَوم جَهلوا مَعنى الخُنوع","ذَهب الآباء تَعساً لِلبَنين",5,"ن",1,0],["أين قلبي غصبوه فاسألوا","جارةَ الوادي عن المغتصب",6,"ب",1,0],["أينقُص كاملٌ عُرْفاً أتاه","إلى حُرٍّ ليس بذي ذُنوبِ",7,"ب",1,0],["أينقضي العمر وما صافحت","عيناي عينيه بلا ذعر",8,"ر",1,0],["أينَ قيثاري وكوبي والحبيب","وشموعي ونديمي واحنيني",9,"ي",1,0],["أينقضى العمر عتباً","على الهوى وعليكم",10,"م",1,0],["أين قلبي وأين آثارُ قلبي","من خفوقٍ يعتادهُ ووجيبِ",11,"ب",1,1],["أَينَ قاضيكِ دافِعُ الضيم طاغي","المُستَبِدّينَ صائِنُ الدُستورِ",12,"ر",1,0],["أين قومٌ شادوا البِلادَ وَسادو","ها وكانت تَهواهُمُ العَلياء",13,"ا",2,0],["أَيْنَ قومي الأُلَى الذين بهمْ كا","ن يموت الخنا ويحيا الفقير",14,"ر",1,0],["أيَنْقُصُ اليَأسُ مِنْ رَجائِي","وذلكَ الفَضْلُ في مَزيدِ",15,"د",1,0],["أين قولي تركتُ عالمَ أُنسي","أين قولي نَبذتُ عني الأصولا",16,"ل",2,0],["أين قولي تركت لذة عيشٍ","ومقاماً وعِشرةً وخليلا",16,"ل",2,0],["أين قومي؟ تلفَّتَ المجدُ يوم","فرآهم يقدِّسون القِبَابا",17,"ب",2,0],["أينَ قَلبي سَباهُ من بَدرِ تِمٍّ","تَمَّ بالثَّغرِ أمْ لَحيْني وحَتْفي",18,"ي",1,1],["أينَ قومي لهم على النَّاس فخرُ","وإباءٌ بأنْفِهِ مشمخرُّ",19,"ر",1,0],["أينَ قِطّانُك في عهد الصبا","يا مراحاً كانَ للهو ومغدى",20,"د",2,0],["أين قلبي من السلو وجفني","من رقاد بل كل ذاك مقاله",21,"ل",2,0],["أينُقٌ كم ذرعتْ مَرْتاً وكم","قطعتْ حَزْنَ الفلا وخداً وسَهْلَه",22,"ل",2,0],["أين قومٌ كانوا على الليل صُبحاً","لا يُوارى وفي الجدوبِ ربيعا",23,"ع",2,0],["أين قومٌ كنّا نراهمْ على الأط","واد حلّوا ثرى الصّعيد اِنتِشارا",24,"ر",2,0],["أينَ قُسٌّ من حَبْرِ عَصرٍ هُوَ المظْ","لومُ إن قِيسَ بالأيَّمِةِ طُرَّا",25,"ر",2,0],["أينَ قَدرُ الكرامِ منكَ وهيها","ت وكلاّ ما الفلس كالدّينار",26,"ر",1,0],["أين قُطَّانٌ مَحَاهُم","رَيْبُ دَهْرٍ ومحاها",27,"ا",3,0],["أينقضُ عَهدَ الحب يا أهله فتى","له الهمةُ العليا له الخلق السّبط",28,"ط",1,0],["أيْنَ قَبْلِي هَاجَرَ الأُدَبا؟","أَيْنَ بَعدِي يَمَّمَ الغُرَبا؟",29,"ا",1,0],["أين قاض بالعلم يهدي سبيلا","فيه للقاصدين كشف الغطاء",30,"ا",2,0],["أينقضُ أم يزيد من الرقاعه","أخو حمق له الدنيا مشاعه",31,"ه",1,1],["أين قلبي ما صنعت به","لا أرى صدري له وطنا",32,"ن",2,0],["أَينَ قاضي شَرعِنا أَشكو لَهُ","كُلَّ مَن بَدَّلَ أَو مَن غَيَّرا",33,"ر",2,0],["أين قومٌ ألفتهُم فيكَ لمّا","قرّبَ الدهرُ اذنوا بالرواحِ",34,"ح",1,0],["أينقضي الوجد لمولىً رزؤه","كذكره الجميل ما له انقضا",35,"ض",2,0],["أينقضي العمر في عتب وفي عذل","ما أقبح العيش بين العتب والعذل",36,"ل",1,0],["أين قوسٌ فيبوس قبل حباكا","أين تلك النبال تنمي الهلاكا",37,"ك",2,0],["أين قصرٌ لابرهيم منيفٌ","كان أبهى القصورِ في الفيحاءِ",38,"ا",2,0],["أين قتل المسئ من توبة أو","أين قرض من طهر رجس بماء",39,"ا",2,0],["أينقع سيلُ الدمعُ غلة مهجتي","فأغرق سكان الغري بغربه",40,"ب",2,0],["أين قولٌ لي صغيراً عن هدىً","إن بعض الظن إثمٌ يا بني",41,"ي",1,0],["أين قلبي؟ أين عقلي؟","كلُّها طَوْعُ هواكِ",42,"ك",1,0],["أيْنَ قدِّيسَةُ الغرَامِ فقَلبِي","في محاريبِ ما مضَى محبُوسُ",43,"س",1,0],["أَيْنَ قُرَّائِي؟ مَنْ سَيَهْوَى كِتَاباً","وَالْقَرَاطِيِسُ اصْفَرَّ فِيِهَا الْغِشَاءُ",44,"ا",2,0],["أينَ قلبُ الأمِّ أينَ المُرتَجى","مِن رِضاها حينَ صارتْ شَوكَتي",45,"ت",2,0],["أين( قُسْطنطينيَّةٌ ) زانَها( الفاتِحُ )","نصْراً وطاحَ( قُسْطنْطينُ )؟",46,"ن",1,0],["أينقص حربا لم ير الله نقصه","وينمي عديد الله والله مرغم",47,"م",1,0],["أين قلبي ما صنعت به","ما أرى صدري له سكنا",48,"ن",2,0]]}