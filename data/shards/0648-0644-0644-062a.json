{"poems":[[79,"بشرى تقوم لها الدنيا على قدم","https://www.aldiwan.net/poem36125.html","البسيط"],[95,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[29,"إليك كلفنا كل يوم هجيرة","https://www.aldiwan.net/poem5963.html","الطويل"],[45,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[147,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[226,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[409,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[484,"أيقظ شعورك واطرح برقع الكسل","https://www.aldiwan.net/poem37601.html","البسيط"],[543,"درست الفقه علما والأصولا","https://www.aldiwan.net/poem47454.html","عموديه"],[543,"كلانا طالب للعلم ساع","https://www.aldiwan.net/poem47473.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87110","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77638","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107226","الوافر"],[1118,"","https://poetry.dctabudhabi.ae/diwan/poem/146000","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101035","البسيط"],[1727,"","https://poetry.dctabudhabi.ae/diwan/poem/118027","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125403","المتقارب"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33846","الرجز"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111250","الوافر"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125979","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135662","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135880","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72526","الوافر"],[4759,"غنيتها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205795",""],[5183,"الخيزران والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180267",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5369,"قومي يا نؤوم","https://www.poetsgate.com/ViewPoem.aspx?id=177446",""],[5829,"رسالة الى اوباما","https://www.poetsgate.com/ViewPoem.aspx?id=148336",""]],"verses":[["وَلِلتَّنَافُسِ فِي تَقْبِيلِ رَاحَتِهِ","ظَلَّ التَّفَاخُرُ بَيْنَ السَّيْفِ وَالْقَلَمِ",0,"م",1,0],["وَلِلَّتِي استَبدَلَتْ بِالقَبْرِ مَرتَعَهَا","قِسطٌ مِنَ الفخْرِ فَوقَ العُمْرِ تَقويما",1,"م",2,0],["وَلِلتُركِ مِن عَبدِ العَزيزِ وَقيعَةٌ","وَلِلرومِ يَومٌ ما تُتِمُّ حَوامِلُه",2,"ل",2,0],["وَلِلتَركُ لِلإِحسانِ خَيرٌ لِمُحسِنٍ","إِذا جَعَلَ الإِحسانَ غَيرَ رَبيبِ",3,"ب",1,0],["وَلِلتَنافُسِ صارَ المُسلِمونَ إِلى","ما يَكرَهونَ وَعادَ الدينُ أَديانا",4,"ن",2,0],["وللتواريخ ذكريات","تحف من حولها غرر",5,"ر",1,0],["وللتمييز يكتبها بحسن","فقيه في المدارس لا يحابي",6,"ب",2,0],["وللتقاليد آجال محددة","وكل عصر وما فيه إلى أجل",7,"ل",1,0],["وللتَّاريخِ والتَّوقيتش وقُتٌ","وهندسةٌ قرأتُ بها قَليلا",8,"ل",2,0],["وللتَّعليمِ أُسلوبانِ لكن","نُريدُ السَّيرَ في النَّهجِ القَويمِ",9,"م",1,0],["وِللتمدّن مدّت باعَها وَإِلى","أَوج العُلا سارعت مِن غَير إِحجام",10,"م",1,0],["وَلِلتَواشيح غَرامٌ عِندي","وَكَم أُغنّي لِلطُيورِ وَحدي",11,"ي",1,0],["وللتدبير فوق المال فضل","فكيف إذا هما اجتمعا بنفسِ",12,"س",1,0],["وَلِلتّبسِيِّ بِالكاساتِ زَهوٌ","فَقُل في الرَّوضِ بِالأَزهارِ حالِ",13,"ل",1,0],["وللترك أحشاء يلج اضطرابها","ولا الذهب الملقى على النار للسبك",14,"ك",1,0],["وللتَلَقّي اللام إنّ لا وما","ثلاثةُ التنبيه ها ألا أما",15,"م",2,0],["وللتقى بينا عهود","تقدست في القلوب قبلى",16,"ل",2,0],["وللترك أدنى من نزار بعهدها","فلا يأمننّ الغدر يوما عهيدها",17,"ه",2,1],["وللترك فخرٌ بما أجهدَت","ونالت من الفوز أسمى الرُّتَب",18,"ب",1,0],["وَلِلتَصابي بَينَنا","رَسائِلٌ تَختَلِفُ",19,"ف",1,0],["وللتسميط في الحسن اختلاف","وقد يخفى على الفطن اللبيب",20,"ب",1,0],["وَلِلتَّقاديرِ سُبلٌ لا تُغَيِّرُها","وَالنّاس في عَجزِهم عَن قَصدِهم قَصرُوا",21,"ر",3,0],["وللتطوّر أحكام مقرّرة","والنفس والجسم في الأحكام سيان",22,"ن",1,0],["وَلِلتَدابير شجعان اِذا رَكَضوا","يَخلو لَهُم في قِصابِ السَبق ميدان",23,"ن",1,0],["وللتلاميذ فإنا ذو كسلْ","والنوم والعبث والعمل قلْ",24,"ل",1,0],["وللتلاميذِ فأصلحْ ظاهرا","وباطناً وكثِّرَنْ ونوِّرا",25,"ر",2,0],["وَلِلتَّكَالِيفِ بِهَذِى الدَّارِ","وَمَا يُقَاسُونَ مِنَ الأَكدَارِ",26,"ر",1,0],["وللترحال عن دار الفنا بالحس والمعنى","جرس فرياد ميداردكه بر بنديد محملها",27,"ه",2,0],["وللتراتيل في محرابها لغة","ما جاءت الآي. والألواح والقلم",28,"م",1,0],["وللتوفيق أسباب خفيّ","تَبيُّنها عزيز الإنتماء",29,"ا",2,0],["وللتراب بلون الماء رائحة","تزكو طيوبا لها تقنا وتنتشر",30,"ر",1,0],["وللتزييفِ أشياخٌ كبارٌ","وللتسويغِ تُمتهنُ العلوم",31,"م",1,0],["وللتاريخ فينا قول حقٍّ","فإن الشام آجام عظام",32,"م",1,0]]}