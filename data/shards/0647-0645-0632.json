{"poems":[[87,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[87,"جبريل هلل في السماء وكبر","https://www.aldiwan.net/poem63765.html","الكامل"],[30,"تقول كليب حين مثت سبالها","https://www.aldiwan.net/poem1306.html","الطويل"],[63,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[119,"سبقوا البرية طارفا وتليدا","https://www.aldiwan.net/poem41963.html","الكامل"],[242,"بالقصر سادات ذوو هدي","https://www.aldiwan.net/poem19751.html","الكامل"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[287,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[466,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[532,"فإن ردني دهري عليك طريدة","https://www.aldiwan.net/poem45958.html","الطويل"],[534,"هذي بيوت حل فيها القاصر","https://www.aldiwan.net/poem37377.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126744","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107220","الوافر"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45186","الطويل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130870","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126146","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100990","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109365","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104975","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199946","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88961","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62831","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95349","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83193","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120496","الكامل"],[4802,"والله مصيبه","https://www.poetsgate.com/ViewPoem.aspx?id=36911",""],[4978,"تشطير لأبيات أستاذي محمد ذيب سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=211981",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5670,"يا رب لا تحرمنّي الظل والحدبا","https://www.poetsgate.com/ViewPoem.aspx?id=215250",""],[5943,"في ملتقى شبَّابنا","https://www.poetsgate.com/ViewPoem.aspx?id=34292",""],[6024,"الجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=186349",""],[6093,"ما بَعدَ مكة َ والمدينةِ والتي","https://www.poetsgate.com/ViewPoem.aspx?id=179793",""],[6124,"همزة","https://www.poetsgate.com/ViewPoem.aspx?id=120683",""]],"verses":[["هم زادوا القضاء جمال وجه","وازدوا غُرة الفتيا ألتماعا",0,"ع",2,0],["هُم زَيَّنوكَ بِكُلِّ أَزهَرِ في الدُجى","وَاللَهُ زانَكَ بِالقَبولِ الأَنوَرِ",1,"ر",1,0],["هُم زَوَّجوا قَبلي ضِراراً وَأَنكَحوا","لَقيطاً وَهُم أَكفاؤُنا في المَناسِبِ",2,"ب",1,0],["هم زَيَّنُوا أُخرَياتِ الدَّهرِ مَكرُمةً","وقَبلُ زِينَتْ بهم أيامُه الأُوَلُ",3,"ل",1,0],["هم زيّنوه لقومهم فتدافعوا","يتنازعون مواكبَ الإجلالِ",4,"ل",1,0],["هم زبدة الكون الوسيع وجدهم","أضحى على كل الأنام شهيدا",5,"د",2,0],["هُمْ زِينَةُ الْقَصْرِ وَحِلْيَتِهِ","وَالْقَصْرُ مُفْتَقِرٌ إِلَى الْحَلْيِ",6,"ي",1,0],["هُمُ زَوامِلُ ثِقلِ العارِ مُعنقةً","وَهُم عَلى حَملِهِ أَقوى مِنَ الإِبِلِ",7,"ل",1,0],["هُم زَحزَحوا عَن مُلكِهِ","كِسرى وَأَردَوا قَيصَرا",8,"ر",2,0],["هُمُ زند مجدٍ أنت نارُ اقتداحه","وأفخرُ ما كان الزنادُ إذا وَرَى",9,"ر",2,0],["هُمُ زوجوني الهمَّ بعد طلاقه","وذلك عرسٌ للمآتم جالب",10,"ب",1,0],["همزتُها وألِفُ المفاعَلَه","وسين الاسْتِفعال والمغالبه",11,"ه",1,0],["هُم زينة النادي وهُم","شهبٌ بأفقِ المجد تُزهِر",12,"ر",1,0],["همُ زُبْدةُ الفخرعنهم في القديم وفي ال","حديثِ صَرَّحَ محضُ الفخرِ إذ مُخِضا",13,"ض",2,0],["هُمُ زَجَرُوا الغُرابَ لَنا بِبَينٍ","وَهُم عَدَلُوا إِلَى غَيرِ الصَّوابِ",14,"ب",1,0],["هُمُ زَجَروا مَن عابَ عُثمانَ بَينَهُم","وَأَولى بَني العَلّاتِ بِالعَيبِ عائِبُهْ",15,"ب",2,0],["هم زعموا أن كل برق يخيفنا","فخابوا بما قالوا وقلنا فما خبنا",16,"ن",2,0],["همزة روح القدس جبرائيلا","وقيل سقيا الله اسماعيلا",17,"ل",2,0],["هم زينة الناس هم نور الوجود هم","روح الحياة هم ريحانها العطر",18,"ر",1,0],["هم زينة الدنيا ودولة ملكها","وملاذ خائفها من الأخطار",19,"ر",1,0],["هم زينة المجلس إن ذكرٌ طرا","وهم غياث الناس إن خطب طرق",20,"ق",1,0],["هم زائدون على الوجود لأنهم","جنس يخالف سائر الأجناس",21,"س",1,0],["همُ زهرة الدنيا وزينات أهلها","ورونق وجه الأفق صبو لأرشد",22,"د",1,0],["هُمُ زَرْعٌ يَحُلُّ نَداكَ منهُ","مَحَلَّ الماءِ منه والتّرابِ",23,"ب",1,0],["هم زندك الأقوى وحد حسامك ال","ماضي المذلل في الوغى ما استعصبا",24,"ب",2,0],["همزة لمزة يعيب","هُذَرة منطيقنا الخطيب",25,"ب",1,0],["همزاته والالفات الألى","فيه حمام قضبها شرع",26,"ع",1,0],["هُم زينَةُ الإِنسانِ","وَسَلوَةُ الأَحزانِ",27,"ن",1,0],["هم زهرة الجنيا وبهجة مصرها","فيهم تجر من الفخار ذيولا",28,"ل",2,0],["هم زرعوا في دربنا كل الالغام","يا ويلهم يا ويلهم لا مشينا",29,"ن",2,0],["(هم زرعوه من سبعين عام)","(\\متى يا ربّ منه متى نُعافى ؟)",30,"ف",2,0],["همزية ً سَتُؤكّد ُ الفصل َ الذي","من رائه ِ بِدْأ ً سقانا الجدول ُ",31,"ل",1,0],["‏هم زهرة العمر إن شحّت سحائبُهُ","‏وهم بقيةُ عهدٍ زاهرٍ ذهَبا",32,"ب",2,0],["همْ زينةُ الشُّبانِ والبلدانِ بلْ","همْ فَخرُ مَنْ بعفافِهِمْ أطهارُ",33,"ر",1,0],["هم زملوني بالعلا وملامحي","لدي يسدِّيها ويلحمها النصر",34,"ر",1,0],["هُمْ زِيْنَةُ الدُّنيَا وخِيْرةُ أَهْلِهَا","فِيْ النَّاسِ قَوْمِيَ غَايَةٌ وَ لُبَابُ",35,"ب",1,0],["هَمْزَةُ القَطْعِ الّتِي أَسْكنْتَهَا بَيْنَ الضّلوعِ","أَحْكَمَتْ رَسْمِي وَطْمسِي من على بابِ الرّجُوعِ",36,"ع",1,1],["هَمْزْةُ الوَصْلِ التِي كَانَتْ سَرَابًا فِي خشُوعِي","أَيْقَظَتْنِي حِيْنَ مَاتتْ مُهْجَةٌ بَيْنَ الشّمُوعِ",36,"ع",1,0]]}