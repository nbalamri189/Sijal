1,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[461,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[461,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[461,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[461,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[461,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[461,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[464,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[471,"عامل دمياط فتى قلما","https://www.aldiwan.net/poem60013.html","البسيط"],[485,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[498,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[503,"بمعراجنا طر أنت للفلك الأعلى","https://www.aldiwan.net/poem37813.html","الطويل"],[517,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[517,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[519,"وإن وراء ظهري يا ابن ليلى","https://www.aldiwan.net/poem48736.html","الوافر"],[532,"قدمت خير مقدم","https://www.aldiwan.net/poem37139.html","مجزوء الرجز"],[532,"في حاديات الليالي للفتى عجب","https://www.aldiwan.net/poem37535.html","البسيط"],[541,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[544,"فإن تسيروا إلينا ترفدوا عجلاً","https://www.aldiwan.net/poem675.html",""],[554,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[554,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[555,"ويخدعنا الزمن!","https://www.aldiwan.net/poem24829.html","عموديه"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[561,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[561,"هي الذات التي فوق البراق","https://www.aldiwan.net/poem34331.html","الوافر"],[566,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[570,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[578,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[590,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10455","البسيط"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10416","الوافر"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/46009","الطويل"]],"verses":[["وَإِنَّ وَراءَ الشَيبِ ما لا أَجوزُهُ","بِعائِقَةٍ تُنسي جَميعَ العَوائِقِ",0,"ق",1,0],["وَإِن وَلَجَ الضِغنُ أَثوابَهُ","نَضا لِبدَةَ الأَسَدِ الحادِرِ",1,"ر",1,0],["وَأَنَّ وَرائِيَ سَوقاً عَنيفاً","وَأَنَّ أَمامي يَوماً عَصِيبا",2,"ب",2,0],["وَإِنَّ وَراءَ ذاكَ الحِلمِ صَولاً","وَإِنَّ لِتِلكُمُ البُقيا عِقابا",3,"ب",2,0],["وإنْ وَشى الحَلْيُ بهِ راعَهُ","بَعْدَ وَفاءِ الخُرْسِ غَدْرُ الفِصاحْ",4,"ح",1,0],["وإنْ وفَيْتُ ببَعْضِ القوْلِ رُبَّتَما","يكْفي منَ العِقْدِ ما قدْ حفَّ بالعُنُقِ",5,"ق",1,0],["وإنْ وَقَفَتْ في حادِثٍ عَزَماتُه","فقدْ أمِنَ الإسْلامُ ما يُتَوقَّعُ",6,"ع",1,0],["وَإِنَّ وِدَادِي فِي الْخَلِيفَةِ يُوسُفٍ","يُكَفِّرُ عِنْدَ اللهِ مَا كَانَ مِنْ ذَنْبِي",7,"ب",2,0],["وَإِن وَضَعَت أَوزارَها الحَربُ كُنتُمُ","مَصيرَ النَدى وَالمُترَعينَ المُقارِيا",8,"ي",2,0],["وَأَنواءُ أَحوالٍ تِباعٍ ثَلاثَةٍ","بِها كانَ مِمّا يَستَحيرُ مَطيرُها",9,"ر",3,0],["وإن ومض البرق الحجازيُّ مَوْهنا","يُردِّدُ في الظلماء أنَّة لهفانِ",10,"ن",1,0],["وَإِنَّ وَراءَ السَترِ أُمّاً بُكاؤُها","عَلَيَّ وَإِن طالَ الزَمانُ طَويلُ",11,"ل",1,0],["وإن وجدت غَشومَ القوم في بلدٍ","حلاً فقلْ أنتَ في حلٍّ من البلد",12,"د",1,0],["وأن وليد الأفضل الملك قد محا","عن الناس حزناً لا ينادى وليدُه",13,"د",2,0],["وإن وقفت الوقوفَ فاز بها","قاضٍ يرى ظلمَ كل ذي صِغر",14,"ر",1,0],["وَإِن وُزِنَ الحَصى فَوَزَنتُ قَومي","وَجَدتُ حَصى ضَريبَتِهِم رَزينا",15,"ن",2,0],["وإن وجود ما في الكون طراً","عليك إذا تأملنا ثناء",16,"ا",2,0],["وأنواع النحاس وهن عشر","مسمّاة بها كمل العديدُ",17,"د",1,0],["وإن وقفت على سر الخميرة لم","تحتج إلى العود فيها مدة العمرِ",18,"ر",1,0],["وَإِنَّ وَسيلَتي وَأَجَلَّ مَتّي","إِلَيكَ بِحَقِّ أَصحابِ الإِساءِ",19,"ا",2,0],["وَإِن وَلِيَ العُمّالُ مِنّي مَبَرَّةً","فَمُستَعمِلُ العُمّالِ أَحرى وَأَخلَقُ",20,"ق",1,0],["وَإِنَّ وَلاءَ المُعتِقينَ مِنَ الرَدى","يَفوقُ وَلاءَ المُعتِقينَ مِنَ الرِقِّ",21,"ق",1,0],["وَإِنَّ وُلاةَ العَهدِ في الحِلمِ وَالتُقى","وَفي الفَضلِ مِن أَمثالِهِ وَشُكولِهِ",22,"ل",2,0],["وَإِن وَجَدوا عِندي رَخاءً تَقَرَّبوا","وَإِن نَزَلَت بي شِدَّةٌ خَذَلوني",23,"ن",2,0],["وإن وهبَ الألوفَ وهنَّ كُثْرٌ","تقدَّمَ قبلهنَّ الإعتذارُ",24,"ر",1,0],["وَأَنَّ وُحوشَ البَرِّ يَأتَلِفونَ بي","ذُكورٌ إِناثٌ ثُمَّ خَشفٌ وَمُرضَعُ",25,"ع",1,0],["وإن وَهَنَ الحُماةُ أوِ اسْتكانوا","فليسوا في الجهادِ بِمُفلِحينا",26,"ن",2,0],["وَإِن وَجَدَت قِلىً وَرَأَت صُدوداً","صَدَدتُ عَنِ الحَياةِ صُدودَ قالِ",27,"ل",1,0],["وَإِن وَثَبَ الضرغامُ لِلصَيدِ عادِياً","فَلا تَعجبوا أَيُّ الضَراغمِ لا يَعدو",28,"د",2,0],["وَإِنَّ وَجدِيَ الَّذي أَراقَ دَمَ ال","عَينِ لَدَمعٌ أَهدى لَها الأَرَقا",29,"ق",2,0],["وَإِن وَقَفتُ لَهُ كَيما يُكَلِّمُني","في المَوضِعِ الخَلوِ لَم يَنطِق مِنَ الحَصَرِ",30,"ر",1,0],["وَأَنوَكَ قالَ لَو أَقصَرتُ عَنهُ","فَقُلتُ لَهُ اللِقاءُ عَلى الصِراطِ",31,"ط",1,0],["وَإِن وَصَلتُ فَشُكري شُكرُ بَروَقَةٍ","تَرضى بِبَرقٍ مِنَ الأَمطارِ خَلّابِ",32,"ب",1,0],["وَأَنوارُ أَعوامٍ مَضَينَ شَواهِدٌ","بِما ضَمِنَتهُ بَعدَهُنَّ الكَمائِمُ",33,"م",1,0],["وَإِنَّ وَليداً حَلَّها لَمُعَذَّبٌ","جَرَت لِسِواهُ بِالسُعودِ الأَيامِنُ",34,"ن",1,0],["وإن وَراء الشيب حتفاً وإنه","لما قلت إِثبات اذا رمت إِثباتا",35,"ت",2,0],["وإنْ وجدتَ الثانيَ المنْقوصا","مُحرَّكاً سَمَّيْتهُ المَوْقُوصا",36,"ص",2,0],["وإِنَّ وِدادَ الْقَلْبِ ما لَمْ يَكُنْ لَهُ","دَلِيلٌ عَلَى إِخْلاصِهِ لَمُرِيبُ",37,"ب",1,0],["وَإِنَّ وَراءَ الحَزمِ فيها وَدونَهُ","مَواقِفَ تُنسى دُنَهُنَّ التَجارِبُ",38,"ب",1,0],["وإِن وَصَف الحربَ خِلْتَ الْحِرابَ","تَسُدُّ من الأرض أقطارها",39,"ر",3,0],["وأن وراءَ هذا الكونِ ربًّا","له في الكونِ أسْرارٌ كِبَار!",40,"ر",1,0],["وأن وقوع الدين في الأرض مفسد","وان قوانين السماء فظائع",41,"ع",1,0],["وان وقوع الموت للمرء موضع","وليس لموت كالجهاد مواضع",41,"ع",1,0],["وإنَّ ودادي في الخليفة ِ يوسُفٍ","يكفِّرُ عند الله ما كان من ذنبِ",42,"ب",1,0],["وإن وفيت ببعض القصد ريتما","يكفي من العقد ما قد حف بالعنق",43,"ق",1,0],["وإنِّ وَإنّي عُمِّرْتُ أَعْلَمُ أَنَّنِي","سَأَلْقَى سِنَانَ الْمَوْتِ يَبْرُقُ أَصْلَعَ",44,"ع",1,0],["وإن وجوهاً كالبدور تغيرت","فللدود طرف أحور وخدود",45,"د",1,0],["وإن ومضت للخلّ منك سحابة","فلا يَكُ منها خلَّباً ذلك الومض",46,"ض",1,0],["وآن وأصحاب كرام وحزبهم","وللقوم أصحاب الطريق وأهله",47,"ل",2,0],["وأنوار نور النور فاضت بنوره","وأنواره نور الدياجي مسجّما",48,"م",2,0],["وأنوانسٍ بيض خَدالٍ تخذلُ","ببوارق عذب بروقاً مبسما",49,"م",2,0],["وأن وادي الشتا حو جآذره","وأن مصطافها موءاب أَسماء",50,"ا",2,0],["وإنّ وَلوعى بأهل الحمى","يخيِّل لي كلَّ سِربٍ قَطينا",51,"ن",2,0],["وإن وراء دولته دعاءً","تُهدُّ له قلوبُ الدارعينا",52,"ن",2,0],["وإِنْ وُفِّقْتُ فالمَعْنَى","صَوَابٌ سَاقَهُ الرَّبُ",53,"ب",1,0],["وَإِن وَنَت رُعودُهُ حَدا بِها","حادي الجَنوبِ فَحَدَت كَما حَدا",54,"ا",1,0],["وَإِن وَطَنٌ ساءَتكَ أَخلاقُ أَهلِهِ","فَدَعهُ فَما يُغضي عَلى النَقصِ ماجِدُ",55,"د",1,0],["وَإِن وَعَدُوا أَوفُوا وَإِن قَدَرُوا عَفَوا","وَإِن سُئِلُوا النَعماءَ جادُوا وَأَنعَمُوا",56,"م",3,0],["وإن واصَل الإخوان بالأكل عندهم","فذاك طفيليٌّ وللشرِّ واغِل",57,"ل",1,0],["وإن وقع الحريق بأرض مصر","من الأمصار أو جنب الفريق",58,"ق",1,0],["وَأَنوارُهم في كلّ شرقٍ ومغربٍ","على كلِّ خلقِ اللَّه قد سفَرت سفرا",59,"ر",2,0],["وَأَنواءُ الغِمامِ تَجودُ غَبّاً","وَجودُكَ لا يَغِبُّ لَهُ اِنسِكابُ",60,"ب",1,0],["وَإِنَّ وَراءَ اِبتِسامي لَهُم","فُؤاداً بِأَشجانِهِ يَنتَحِب",61,"ب",1,0],["وَأَنَّ وَظائِفَ التَسبيحِ قوتي","وَما أَحيا عَليهِ مِنَ الدُعاءِ",62,"ا",2,0],["وان وُعِدوا النُزر القَليل مُؤَجَّلاً","عَلى البُطء أُعطيتَ الكَثيرَ مُعجَّلا",63,"ل",2,0],["وأنوار حكمة سر الشباب","قضي عليه إلى أن يذيعا",64,"ع",2,0],["وان وشى الطروس به سطوراً","وجمع ضمنها حكما فرادي",65,"د",2,0],["وأنوارِ صبحٍ بين أزهارِ جنَّةٍ","وطُهرِ ابتِسامٍ من ثغورِ الكواعب",66,"ب",1,0],["وإن وطأته الخيلُ والرجْلُ وطّأت","قواعدَ ليست بعدَهُ بحصينة",67,"ه",1,0],["وانوح في آثارهم متعللا","من بعد بعدهم بعل وربما",68,"م",2,0],["وان وَصَفوا سليمان بملك","فَذاكره الكنوز وَقَد عرضنا",69,"ن",2,0],["وان وردت بها ماء العَذيب فقل","سَقى العذيب من الامواه ما عذبا",70,"ب",2,0],["وان وصلت بها باب السلام فقل","مني السَلام عَلى أَوفى الورى حسبا",70,"ب",2,0],["وان وقدت نار بأحد تبلدرت","اليهاوَفي أَحشائها النار توقد",71,"د",1,0],["وإنْ وُكِلَ الحِبَاءُ إلى نَداهُ","فَما البَحْرانِ عَبّا في الْتِطامِ",72,"م",1,0],["وإن وَهى للملكِ ركنٌ أو هوَى","تدَاركاهُ ساعِداً وعضُدا",73,"د",2,0],["وَإِنْ وَلَدَتْ لَكَ الآمالُ حَظَّاً","فَما زالَتْ مَواعِدُها عِشَارا",74,"ر",2,0],["وإِن وَعَدوا أَوفوا وإِن أَوعَدوا عَفوا","وإِن غَضِبوا ساؤوا وإِن حلموا سَرّوا",75,"ر",3,0],["وَأَنوفٍ وَخُدودٍ","وَلِثاتٍ وَثُغورِ",76,"ر",1,0],["وإن ومضت أصدافها كان ومضها","لظى جمرة حمراء تغلى بناظري",77,"ر",2,0],["وإن وقَعتْ في صَدْرِهِ شُهُبُ القَنا","تَملَّس من أطرافِها وحبَتْ عَجْلى",78,"ل",2,0],["وإن وهَبتْ مطَرتْ للعُفا","ةِ حتّى تَقومَ على الحَمْدِ سُوق",79,"ق",1,0],["وَأَنَّ وُجوهَ القَومِ تَبدو عَوابِساً","وَأَنّي لِمَرآها أَهَشُّ وَأَبسِمُ",80,"م",1,0],["وآنوريوسٌ فيه الرواة تخالفوا","فبعضٌ يماري بعضهم في الروية",81,"ه",1,0],["وَإِن وِدادَك لَم تَبق مِنهُ","كَجسمي وَصَبري اللَيالي أَثَر",82,"ر",1,0],["وانو وكبر وقم واقرأ بأحسن قراه","للفاتحة وافهم المعنى لما الله تلاه",83,"ا",2,0],["وانو وكبر لا حرام وقم باستقال","والفاتحة فاقرها واحذر يكون ابتدال",84,"ل",1,0],["وانو وكبر وقم","والفاتحة بعدهات",85,"ت",1,0],["وإن وجدت سبيلا أو قدرت على","خلاص عقل أسير في يد الكاس",86,"س",1,0],["وإن وَعَدَتْني باقترابِكُمُ المُنَى","نَهَتْنَي عَنْ تَصدِيقِ موعِدها مصرُ",87,"ر",1,0],["وإِن وفَّرْتَ فِيَّ الجودَ إِني","لأَرحلُ عنكَ بالشكرِ المُشَاعِ",88,"ع",1,0],["وإن وهبوا المافي طريفا وتالداً","فجودهم في بحر إحسانه ثمد",89,"د",1,0],["وإِنْ وَرَدُوا قليبَ الجود عُطْلاً","فأَنت الدَّلْوُ فِيهَا والرِّشاءُ",90,"ا",2,0],["وَإِن ونى الرعد تحدوه الجنوب فلم","تنفك ترزم أَرزاماً أَيانقه",91,"ق",2,0],["وإِن وقى الغرب مني وهو مغترب","فحبذا وطنا للمرء إِن نزلا",92,"ل",2,0],["وَإِنّ ولوجَ البيت حلٌّ لجحوشٍ","إِذا جاءَ والمتسأذنون نيامُ",93,"م",1,1],["وأن وجدي وتفكيري وفلسفتي","ليست سوى مثل من فن رسام",94,"م",1,0],["وأنَّ وُجودَ الناسِ بعد مماتهم","فبعضهمو يحيا وُجُّلهمو يَفنىَ",95,"ن",2,0],["وإن وقعنا وارتفعتَ طائرا","تُطلِعُكَ السماءُ من أعنانِها",96,"ن",3,0],["وأن ودّاً بينهم دلَّ على","صفائه رضاهُمُ بما فعلْ",97,"ل",1,0],["وإن وسِعَ القريبَ أصولُ مجدي","ولم يسع الغريبَ فضولُ مالي",98,"ل",2,0],["وإن وصلتَ أو سألتَ فأخاً","صَحَّ على التجريب والمَخابرِ",99,"ر",1,0],["وإِنَّ وراءها لَقناً تَلظَّى","وأسيافاً وأَلسنةً تُحَدُّ",100,"د",1,0],["وإن وليّ الأمر دونك ناهضُ ال","بصيرةِ طَبٌّ بالخطوب مدرَّبُ",101,"ب",1,0],["وإِن وراء بحر عُمان مُلْكاً","رطيبَ الظلِّ فَضفاضَ الرِّحابِ",102,"ب",1,0],["وإن وراء الحب حباً وصالهُ","مجال المذاكي في دماء الموارق",103,"ق",1,0],["وَإِن وَفىً عادَ إِلى غَدرِهِ","لِضَعفِ رَأيٍ وَعَمى خاطِرِ",104,"ر",1,0],["وإن وسطا أسقطته صار مالكا","لغيره أو غيرته بذل ثروتي",105,"ت",2,0],["وإن وسطا قدمته هذا رمسه","وإن صحفت أجزاؤه عين فطنتي",105,"ت",2,0],["وإن وزنوا بأهل الأر","ض في أحلامهم رجحوا",106,"ح",3,0],["وإن وَهَبوكَ العرشَ والفرشَ والفَضا","برمشَةِ عينٍ ضمنَ حجْبٍ فقلْ كلاَّ",107,"ل",2,0],["وإنْ وَهَنَتْ قِوايَ فإنّ دَمعي","على كَلِفي بكُم أبداً مُعيني",108,"ن",2,0],["وإن وصلتَ إلى حيٍّ بأيمنهِ","بعد البُلوغِ فبالِغْ في تحيّتِهِ",109,"ت",2,0],["وَإن وَراءَ ظَهري يا اِبن لَيلى","أناساً يَنظُرونَ مَتى أَؤوب",110,"ب",1,1],["وإنْ وَصَلْتَ واصَلَتْ","نِي عِنْدَ ذاكَ نِعَمي",111,"م",2,0],["وإنْ وَجَدْتَ قَبِيحاً بَعْدَ مَخْبَرَةٍ","فَذاكَ لَمْعُ سَرابٍ كُلُّهُ كَذِبُ",112,"ب",1,0],["وإن وقعت عيني على هرم لها","أحسه طود الهم يرسو على صدري",113,"ر",2,0],["وَإِن وَقَفتُم فَإِنّا سائِرونَ لَكُم","يا آلَ خالي بِجُردِ الخَيلِ تَنجَرِدُ",114,"د",1,0],["وَإِنْ وُزِنوا كانوا الجبالَ رزانةً","وَكم طائشٍ منهمْ إلى الموتِ مُسرِعُ",115,"ع",1,0],["وَإنّ ودادي بعده لمّ نَفسَه","وَحاصَ اِمتِراقاً من أكفِّ الخواطِبِ",116,"ب",1,0],["وأنواع عطر ونجم صغير","يداعبنا بالمنى من بعيد",117,"د",1,0],["وأنوار شهدناها","مزيلاتٍ لما أظلمْ",118,"م",1,0],["وأنوار غيب إلهية","مثالية تملك الوالِها",119,"ل",3,0],["وأنوار الجمال بكل قلب","تسمّى بالهوى والإشتياق",120,"ق",1,0],["وَأَنوارُ الدَراري وَالزَهاوي","تَلاشَت في مُحَيّاها الوَسيمِ",121,"م",1,0],["وإن وُتِرَ القومُ في بدرِهِم","لقد نَقَضَ القومُ في كَرْبِلاَءِ",122,"ا",2,0],["وإِنْ وقَفتْ بي بعد شَيْبيَ صَبْوةٌ","فما وقَفَتْ إِلاَّ لأَنِّيَ أَطْلاَلُ",123,"ل",1,0],["وإن وقعت في مائع من نجاسة","سواء قليلاً أو يكن غير حامل",124,"ل",1,0],["وَإِنَّ وَرقاءَ قَد أَردى أَبا كَنَفٍ","وَاِبنَي إِياسٍ وَعَمرا وَاِبنَ أَيّوبِ",125,"ب",1,0],["وَإِنَّ وَعيدَناكُم حينَ نَمشي","بِهِنَّ عَلى المَنونِ وَلا وَعيدا",126,"د",2,0],["وَإِن وَقَفَت بَعدَ الهَزاهِزِ وَاللَغى","تَوالَت مَراخيها بِعَزمِ الشَكائِمِ",127,"م",1,0]]}