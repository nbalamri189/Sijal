spx?id=204353",""],[5206,"شُموسُ العَارفين","https://www.poetsgate.com/ViewPoem.aspx?id=187389",""],[5213,"الله يعلم اني منذ أبلغني","https://www.poetsgate.com/ViewPoem.aspx?id=170550",""],[5223,"صدت سعاد وما للحال تحويل","https://www.poetsgate.com/ViewPoem.aspx?id=187501",""],[5277,"يا سيّدَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188104",""],[5321,"شَرَّك غَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=152742",""],[5351,"صرخة الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=202459",""],[5365,"باختصار","https://www.poetsgate.com/ViewPoem.aspx?id=190821",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"ركبتُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=182998",""],[5436,"بغداد .. يا مجد هارون ( علي محمد السليم )","https://www.poetsgate.com/ViewPoem.aspx?id=46675",""],[5480,"ابكي وليفي ناحل العود","https://www.poetsgate.com/ViewPoem.aspx?id=5143",""],[5490,"خضر عروش الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176332",""],[5542,"هو المختار ( صلى الله عليه وسلم )","https://www.poetsgate.com/ViewPoem.aspx?id=9675",""],[5561,"أُحُبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197377",""],[5573,"بأطراف المدينه منغرس حارس","https://www.poetsgate.com/ViewPoem.aspx?id=206495",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5582,"قِفا وَاَنْظِرانِي كَيْ نَزُورَ وَنَسْأَلا","https://www.poetsgate.com/ViewPoem.aspx?id=63603",""],[5595,"وبنفسج ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=144630",""],[5616,"العقد الفريد","https://www.poetsgate.com/ViewPoem.aspx?id=204588",""],[5626,"لا ترحلي","https://www.poetsgate.com/ViewPoem.aspx?id=189637",""],[5653,"سل البانة الغيناء عن ملعب الجردِ","https://www.poetsgate.com/ViewPoem.aspx?id=26397",""],[5736,"نصائح رمضانية","https://www.poetsgate.com/ViewPoem.aspx?id=208473",""],[5790,"هم جيرتي حيث استقلوا ويمموا","https://www.poetsgate.com/ViewPoem.aspx?id=112132",""],[5848,"أخت القمر","https://www.poetsgate.com/ViewPoem.aspx?id=53377",""],[6069,"ومغرمٍ بالبدال قلت له","https://www.poetsgate.com/ViewPoem.aspx?id=105703",""],[6084,"سقى دمنا بين النقا فالمطا ليا","https://www.poetsgate.com/ViewPoem.aspx?id=170887",""],[6102,"ريما","https://www.poetsgate.com/ViewPoem.aspx?id=184167",""],[6115,"الناس ذا الوقت ياحاقد ويا حاسد","https://www.poetsgate.com/ViewPoem.aspx?id=180502",""],[6115,"انت ياشاشه بريمته بيدي غيره","https://www.poetsgate.com/ViewPoem.aspx?id=180505",""],[6277,"والعلم في عمان أزياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64489&r=&rc=52",""],[6305,"لا تَبْكِ قَتْلاكَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87353&r=&rc=26",""]],"verses":[["وَإِنَّ وَراءَ الشَيبِ ما لا أَجوزُهُ","بِعائِقَةٍ تُنسي جَميعَ العَوائِقِ",0,"ق",1,0],["وَإِن وَلَجَ الضِغنُ أَثوابَهُ","نَضا لِبدَةَ الأَسَدِ الحادِرِ",1,"ر",1,0],["وَأَنَّ وَرائِيَ سَوقاً عَنيفاً","وَأَنَّ أَمامي يَوماً عَصِيبا",2,"ب",2,0],["وَإِنَّ وَراءَ ذاكَ الحِلمِ صَولاً","وَإِنَّ لِتِلكُمُ البُقيا عِقابا",3,"ب",2,0],["وإنْ وَشى الحَلْيُ بهِ راعَهُ","بَعْدَ وَفاءِ الخُرْسِ غَدْرُ الفِصاحْ",4,"ح",1,0],["وإنْ وفَيْتُ ببَعْضِ القوْلِ رُبَّتَما","يكْفي منَ العِقْدِ ما قدْ حفَّ بالعُنُقِ",5,"ق",1,0],["وإنْ وَقَفَتْ في حادِثٍ عَزَماتُه","فقدْ أمِنَ الإسْلامُ ما يُتَوقَّعُ",6,"ع",1,0],["وَإِنَّ وِدَادِي فِي الْخَلِيفَةِ يُوسُفٍ","يُكَفِّرُ عِنْدَ اللهِ مَا كَانَ مِنْ ذَنْبِي",7,"ب",2,0],["وَإِن وَضَعَت أَوزارَها الحَربُ كُنتُمُ","مَصيرَ النَدى وَالمُترَعينَ المُقارِيا",8,"ي",2,0],["وَأَنواءُ أَحوالٍ تِباعٍ ثَلاثَةٍ","بِها كانَ مِمّا يَستَحيرُ مَطيرُها",9,"ر",3,0],["وإن ومض البرق الحجازيُّ مَوْهنا","يُردِّدُ في الظلماء أنَّة لهفانِ",10,"ن",1,0],["وَإِنَّ وَراءَ السَترِ أُمّاً بُكاؤُها","عَلَيَّ وَإِن طالَ الزَمانُ طَويلُ",11,"ل",1,0],["وإن وجدت غَشومَ القوم في بلدٍ","حلاً فقلْ أنتَ في حلٍّ من البلد",12,"د",1,0],["وأن وليد الأفضل الملك قد محا","عن الناس حزناً لا ينادى وليدُه",13,"د",2,0],["وإن وقفت الوقوفَ فاز بها","قاضٍ يرى ظلمَ كل ذي صِغر",14,"ر",1,0],["وَإِن وُزِنَ الحَصى فَوَزَنتُ قَومي","وَجَدتُ حَصى ضَريبَتِهِم رَزينا",15,"ن",2,0],["وإن وجود ما في الكون طراً","عليك إذا تأملنا ثناء",16,"ا",2,0],["وأنواع النحاس وهن عشر","مسمّاة بها كمل العديدُ",17,"د",1,0],["وإن وقفت على سر الخميرة لم","تحتج إلى العود فيها مدة العمرِ",18,"ر",1,0],["وَإِنَّ وَسيلَتي وَأَجَلَّ مَتّي","إِلَيكَ بِحَقِّ أَصحابِ الإِساءِ",19,"ا",2,0],["وَإِن وَلِيَ العُمّالُ مِنّي مَبَرَّةً","فَمُستَعمِلُ العُمّالِ أَحرى وَأَخلَقُ",20,"ق",1,0],["وَإِنَّ وَلاءَ المُعتِقينَ مِنَ الرَدى","يَفوقُ وَلاءَ المُعتِقينَ مِنَ الرِقِّ",21,"ق",1,0],["وَإِنَّ وُلاةَ العَهدِ في الحِلمِ وَالتُقى","وَفي الفَضلِ مِن أَمثالِهِ وَشُكولِهِ",22,"ل",2,0],["وَإِن وَجَدوا عِندي رَخاءً تَقَرَّبوا","وَإِن نَزَلَت بي شِدَّةٌ خَذَلوني",23,"ن",2,0],["وإن وهبَ الألوفَ وهنَّ كُثْرٌ","تقدَّمَ قبلهنَّ الإعتذارُ",24,"ر",1,0],["وَأَنَّ وُحوشَ البَرِّ يَأتَلِفونَ بي","ذُكورٌ إِناثٌ ثُمَّ خَشفٌ وَمُرضَعُ",25,"ع",1,0],["وإن وَهَنَ الحُماةُ أوِ اسْتكانوا","فليسوا في الجهادِ بِمُفلِحينا",26,"ن",2,0],["وَإِن وَجَدَت قِلىً وَرَأَت صُدوداً","صَدَدتُ عَنِ الحَياةِ صُدودَ قالِ",27,"ل",1,0],["وَإِن وَثَبَ الضرغامُ لِلصَيدِ عادِياً","فَلا تَعجبوا أَيُّ الضَراغمِ لا يَعدو",28,"د",2,0],["وَإِنَّ وَجدِيَ الَّذي أَراقَ دَمَ ال","عَينِ لَدَمعٌ أَهدى لَها الأَرَقا",29,"ق",2,0],["وَإِن وَقَفتُ لَهُ كَيما يُكَلِّمُني","في المَوضِعِ الخَلوِ لَم يَنطِق مِنَ الحَصَرِ",30,"ر",1,0],["وَأَنوَكَ قالَ لَو أَقصَرتُ عَنهُ","فَقُلتُ لَهُ اللِقاءُ عَلى الصِراطِ",31,"ط",1,0],["وَإِن وَصَلتُ فَشُكري شُكرُ بَروَقَةٍ","تَرضى بِبَرقٍ مِنَ الأَمطارِ خَلّابِ",32,"ب",1,0],["وَأَنوارُ أَعوامٍ مَضَينَ شَواهِدٌ","بِما ضَمِنَتهُ بَعدَهُنَّ الكَمائِمُ",33,"م",1,0],["وَإِنَّ وَليداً حَلَّها لَمُعَذَّبٌ","جَرَت لِسِواهُ بِالسُعودِ الأَيامِنُ",34,"ن",1,0],["وإن وَراء الشيب حتفاً وإنه","لما قلت إِثبات اذا رمت إِثباتا",35,"ت",2,0],["وإنْ وجدتَ الثانيَ المنْقوصا","مُحرَّكاً سَمَّيْتهُ المَوْقُوصا",36,"ص",2,0],["وإِنَّ وِدادَ الْقَلْبِ ما لَمْ يَكُنْ لَهُ","دَلِيلٌ عَلَى إِخْلاصِهِ لَمُرِيبُ",37,"ب",1,0],["وَإِنَّ وَراءَ الحَزمِ فيها وَدونَهُ","مَواقِفَ تُنسى دُنَهُنَّ التَجارِبُ",38,"ب",1,0],["وإِن وَصَف الحربَ خِلْتَ الْحِرابَ","تَسُدُّ من الأرض أقطارها",39,"ر",3,0],["وأن وراءَ هذا الكونِ ربًّا","له في الكونِ أسْرارٌ كِبَار!",40,"ر",1,0],["وأن وقوع الدين في الأرض مفسد","وان قوانين السماء فظائع",41,"ع",1,0],["وان وقوع الموت للمرء موضع","وليس لموت كالجهاد مواضع",41,"ع",1,0],["وإنَّ ودادي في الخليفة ِ يوسُفٍ","يكفِّرُ عند الله ما كان من ذنبِ",42,"ب",1,0],["وإن وفيت ببعض القصد ريتما","يكفي من العقد ما قد حف بالعنق",43,"ق",1,0],["وإنِّ وَإنّي عُمِّرْتُ أَعْلَمُ أَنَّنِي","سَأَلْقَى سِنَانَ الْمَوْتِ يَبْرُقُ أَصْلَعَ",44,"ع",1,0],["وإن وجوهاً كالبدور تغيرت","فللدود طرف أحور وخدود",45,"د",1,0],["وإن ومضت للخلّ منك سحابة","فلا يَكُ منها خلَّباً ذلك الومض",46,"ض",1,0],["وآن وأصحاب كرام وحزبهم","وللقوم أصحاب الطريق وأهله",47,"ل",2,0],["وأنوار نور النور فاضت بنوره","وأنواره نور الدياجي مسجّما",48,"م",2,0],["وأنوانسٍ بيض خَدالٍ تخذلُ","ببوارق عذب بروقاً مبسما",49,"م",2,0],["وأن وادي الشتا حو جآذره","وأن مصطافها موءاب أَسماء",50,"ا",2,0],["وإنّ وَلوعى بأهل الحمى","يخيِّل لي كلَّ سِربٍ قَطينا",51,"ن",2,0],["وإن وراء دولته دعاءً","تُهدُّ له قلوبُ الدارعينا",52,"ن",2,0],["وإِنْ وُفِّقْتُ فالمَعْنَى","صَوَابٌ سَاقَهُ الرَّبُ",53,"ب",1,0],["وَإِن وَنَت رُعودُهُ حَدا بِها","حادي الجَنوبِ فَحَدَت كَما حَدا",54,"ا",1,0],["وَإِن وَطَنٌ ساءَتكَ أَخلاقُ أَهلِهِ","فَدَعهُ فَما يُغضي عَلى النَقصِ ماجِدُ",55,"د",1,0],["وَإِن وَعَدُوا أَوفُوا وَإِن قَدَرُوا عَفَوا","وَإِن سُئِلُوا النَعماءَ جادُوا وَأَنعَمُوا",56,"م",3,0],["وإن واصَل الإخوان بالأكل عندهم","فذاك طفيليٌّ وللشرِّ واغِل",57,"ل",1,0],["وإن وقع الحريق بأرض مصر","من الأمصار أو جنب الفريق",58,"ق",1,0],["وَأَنوارُهم في كلّ شرقٍ ومغربٍ","على كلِّ خلقِ اللَّه قد سفَرت سفرا",59,"ر",2,0],["وَأَنواءُ الغِمامِ تَجودُ غَبّاً","وَجودُكَ لا يَغِبُّ لَهُ اِنسِكابُ",60,"ب",1,0],["وَإِنَّ وَراءَ اِبتِسامي لَهُم","فُؤاداً بِأَشجانِهِ يَنتَحِب",61,"ب",1,0],["وَأَنَّ وَظائِفَ التَسبيحِ قوتي","وَما أَحيا عَليهِ مِنَ الدُعاءِ",62,"ا",2,0],["وان وُعِدوا النُزر القَليل مُؤَجَّلاً","عَلى البُطء أُعطيتَ الكَثيرَ مُعجَّلا",63,"ل",2,0],["وأنوار حكمة سر الشباب","قضي عليه إلى أن يذيعا",64,"ع",2,0],["وان وشى الطروس به سطوراً","وجمع ضمنها حكما فرادي",65,"د",2,0],["وأنوارِ صبحٍ بين أزهارِ جنَّةٍ","وطُهرِ ابتِسامٍ من ثغورِ الكواعب",66,"ب",1,0],["وإن وطأته الخيلُ والرجْلُ وطّأت","قواعدَ ليست بعدَهُ بحصينة",67,"ه",1,0],["وانوح في آثارهم متعللا","من بعد بعدهم بعل وربما",68,"م",2,0],["وان وَصَفوا سليمان بملك","فَذاكره الكنوز وَقَد عرضنا",69,"ن",2,0],["وان وردت بها ماء العَذيب فقل","سَقى العذيب من الامواه ما عذبا",70,"ب",2,0],["وان وصلت بها باب السلام فقل","مني السَلام عَلى أَوفى الورى حسبا",70,"ب",2,0],["وان وقدت نار بأحد تبلدرت","اليهاوَفي أَحشائها النار توقد",71,"د",1,0],["وإنْ وُكِلَ الحِبَاءُ إلى نَداهُ","فَما البَحْرانِ عَبّا في الْتِطامِ",72,"م",1,0],["وإن وَهى للملكِ ركنٌ أو هوَى","تدَاركاهُ ساعِداً وعضُدا",73,"د",2,0],["وَإِنْ وَلَدَتْ لَكَ الآمالُ حَظَّاً","فَما زالَتْ مَواعِدُها عِشَارا",74,"ر",2,0],["وإِن وَعَدوا أَوفوا وإِن أَوعَدوا عَفوا","وإِن غَضِبوا ساؤوا وإِن حلموا سَرّوا",75,"ر",3,0],["وَأَنوفٍ وَخُدودٍ","وَلِثاتٍ وَثُغورِ",76,"ر",1,0],["وإن ومضت أصدافها كان ومضها","لظى جمرة حمراء تغلى بناظري",77,"ر",2,0],["وإن وقَعتْ في صَدْرِهِ شُهُبُ القَنا","تَملَّس من أطرافِها وحبَتْ عَجْلى",78,"ل",2,0],["وإن وهَبتْ مطَرتْ للعُفا","ةِ حتّى تَقومَ على الحَمْدِ سُوق",79,"ق",1,0],["وَأَنَّ وُجوهَ القَومِ تَبدو عَوابِساً","وَأَنّي لِمَرآها أَهَشُّ وَأَبسِمُ",80,"م",1,0],["وآنوريوسٌ فيه الرواة تخالفوا","فبعضٌ يماري بعضهم في الروية",81,"ه",1,0],["وَإِن وِدادَك لَم تَبق مِنهُ","كَجسمي وَصَبري اللَيالي أَثَر",82,"ر",1,0],["وانو وكبر وقم واقرأ بأحسن قراه","للفاتحة وافهم المعنى لما الله تلاه",83,"ا",2,0],["وانو وكبر لا حرام وقم باستقال","والفاتحة فاقرها واحذر يكون ابتدال",84,"ل",1,0],["وانو وكبر وقم","والفاتحة بعدهات",85,"ت",1,0],["وإن وجدت سبيلا أو قدرت على","خلاص عقل أسير في يد الكاس",86,"س",1,0],["وإن وَعَدَتْني باقترابِكُمُ المُنَى","نَهَتْنَي عَنْ تَصدِيقِ موعِدها مصرُ",87,"ر",1,0],["وإِن وفَّرْتَ فِيَّ الجودَ إِني","لأَرحلُ عنكَ بالشكرِ المُشَاعِ",88,"ع",1,0],["وإن وهبوا المافي طريفا وتالداً","فجودهم في بحر إحسانه ثمد",89,"د",1,0],["وإِنْ وَرَدُوا قليبَ الجود عُطْلاً","فأَنت الدَّلْوُ فِيهَا والرِّشاءُ",90,"ا",2,0],["وَإِن ونى الرعد تحدوه الجنوب فلم","تنفك ترزم أَرزاماً أَيانقه",91,"ق",2,0],["وإِن وقى الغرب مني وهو مغترب","فحبذا وطنا للمرء إِن نزلا",92,"ل",2,0],["وَإِنّ ولوجَ البيت حلٌّ لجحوشٍ","إِذا جاءَ والمتسأذنون نيامُ",93,"م",1,1],["وأن وجدي وتفكيري وفلسفتي","ليست سوى مثل من فن رسام",94,"م",1,0],["وأنَّ وُجودَ الناسِ بعد مماتهم","فبعضهمو يحيا وُجُّلهمو يَفنىَ",95,"ن",2,0],["وإن وقعنا وارتفعتَ طائرا","تُطلِعُكَ السماءُ من أعنانِها",96,"ن",3,0],["وأن ودّاً بينهم دلَّ على","صفائه رضاهُمُ بما فعلْ",97,"ل",1,0],["وإن وسِعَ القريبَ أصولُ مجدي","ولم يسع الغريبَ فضولُ مالي",98,"ل",2,0],["وإن وصلتَ أو سألتَ فأخاً","صَحَّ على التجريب والمَخابرِ",99,"ر",1,0],["وإِنَّ وراءها لَقناً تَلظَّى","وأسيافاً وأَلسنةً تُحَدُّ",100,"د",1,0],["وإن وليّ الأمر دونك ناهضُ ال","بصيرةِ طَبٌّ بالخطوب مدرَّبُ",101,"ب",1,0],["وإِن وراء بحر عُمان مُلْكاً","رطيبَ الظلِّ فَضفاضَ الرِّحابِ",102,"ب",1,0],["وإن وراء الحب حباً وصالهُ","مجال المذاكي في دماء الموارق",103,"ق",1,0],["وَإِن وَفىً عادَ إِلى غَدرِهِ","لِضَعفِ رَأيٍ وَعَمى خاطِرِ",104,"ر",1,0],["وإن وسطا أسقطته صار مالكا","لغيره أو غيرته بذل ثروتي",105,"ت",2,0],["وإن وسطا قدمته هذا رمسه","وإن صحفت أجزاؤه عين فطنتي",105,"ت",2,0],["وإن وزنوا بأهل الأر","ض في أحلامهم رجحوا",106,"ح",3,0],["وإن وَهَبوكَ العرشَ والفرشَ والفَضا","برمشَةِ عينٍ ضمنَ حجْبٍ فقلْ كلاَّ",107,"ل",2,0],["وإنْ وَهَنَتْ قِوايَ فإنّ دَمعي","على كَلِفي بكُم أبداً مُعيني",108,"ن",2,0],["وإن وصلتَ إلى حيٍّ بأيمنهِ","بعد البُلوغِ فبالِغْ في تحيّتِهِ",109,"ت",2,0],["وَإن وَراءَ ظَهري يا اِبن لَيلى","أناساً يَنظُرونَ مَتى أَؤوب",110,"ب",1,1],["وإنْ وَصَلْتَ واصَلَتْ","نِي عِنْدَ ذاكَ نِعَمي",111,"م",2,0],["وإنْ وَجَدْتَ قَبِيحاً بَعْدَ مَخْبَرَةٍ","فَذاكَ لَمْعُ سَرابٍ كُلُّهُ كَذِبُ",112,"ب",1,0],["وإن وقعت عيني على هرم لها","أحسه طود الهم يرسو على صدري",113,"ر",2,0],["وَإِن وَقَفتُم فَإِنّا سائِرونَ لَكُم","يا آلَ خالي بِجُردِ الخَيلِ تَنجَرِدُ",114,"د",1,0],["وَإِنْ وُزِنوا كانوا الجبالَ رزانةً","وَكم طائشٍ منهمْ إلى الموتِ مُسرِعُ",115,"ع",1,0],["وَإنّ ودادي بعده لمّ نَفسَه","وَحاصَ اِمتِراقاً من أكفِّ الخواطِبِ",116,"ب",1,0],["وأنواع عطر ونجم صغير","يداعبنا بالمنى من بعيد",117,"د",1,0],["وأنوار شهدناها","مزيلاتٍ لما أظلمْ",118,"م",1,0],["وأنوار غيب إلهية","مثالية تملك الوالِها",119,"ل",3,0],["وأنوار الجمال بكل قلب","تسمّى بالهوى والإشتياق",120,"ق",1,0],["وَأَنوارُ الدَراري وَالزَهاوي","تَلاشَت في مُحَيّاها الوَسيمِ",121,"م",1,0],["وإن وُتِرَ القومُ في بدرِهِم","لقد نَقَضَ القومُ في كَرْبِلاَءِ",122,"ا",2,0],["وإِنْ وقَفتْ بي بعد شَيْبيَ صَبْوةٌ","فما وقَفَتْ إِلاَّ لأَنِّيَ أَطْلاَلُ",123,"ل",1,0],["وإن وقعت في مائع من نجاسة","سواء قليلاً أو يكن غير حامل",124,"ل",1,0],["وإن وَردَ الصِّيدُ الرَّدى فَهوَ أولٌ","وإن صَدَروا عنَ معَرَكٍ فهوَ آخر",125,"ر",1,0],["وإن ورد الأعناق يوماً حكينه","من الهيم بعد الخمس عطشى تلهف",126,"ف",1,0],["وإن وقعت عليك سهام خطب","جليل فاجعل السلوان درعا",127,"ع",2,0],["وَإِن وَزير الإِستشارة مصطفى","لطالع رَب الملك أَشرَف باصم",128,"م",1,0],["وإنَّ وزيراً سار في المُلْكِ سيْرَهُ","لَتُلْفِيه مِنْ أعطافه يَتمسَّحُ",129,"ح",1,0],["وإن واحدهم إن يلقه عددٌ","منهم على ظلمهم لم يفلح العددُ",130,"د",1,0],["وإنْ وَلِهَتْ فيه أَذَيْهانُ مَعْشَرٍ","فلا فَضْلَ للأنوار في مُقْلَةِ الخُلْدِ",131,"د",1,0],["وإن وجب الثواب غداً لمثلي","فحسبي جمع شملهمُ ثوابا",132,"ب",2,0],["وإن وطئت أرضاً أتى الأمن والندى","بنيها فأضحى عيشهم وهو أخضر",133,"ر",1,0],["وإن وزير القوم من قام عنهمُ","بأوزارهم لا طالب الجاه والوفر",134,"ر",1,0],["وإن وجب الإيثار عند مثوبة","فحسب الفتى من دهره لقب واسم",135,"م",1,0],["وإن وُكِّل العبدُ النخيلَ فإنه","أشدُّ على الأثمار من أكل فارِها",136,"ر",3,0],["وإن وعظت مُصِرّاً","على فعال المناكر",137,"ر",1,0],["وَإِن وَصَلَت أَرضي رَغابي مُطيعَةً","فَهَل لِسَمائي عَن وِصالِيَ عاضِلُ",138,"ل",1,0],["وَأَنْوَارُهُ نَارَ الضَّلاَلَةِ أَخْمَدَتْ","وَمِنْهُ جُيُوشُ الشِّركِ خَوْفاً تَشَرَّدَتْ",139,"ت",1,0],["وأنواعها عشرون مع مائة وقد","توحد فيها بالذكا فهو أوحد",140,"د",1,0],["وَإِنَّ وَعيدَ الحَيِّ بَكرِ بنِ وائِلِ","إِلى المَوتِ يَرمي الروحَ بِالسَكَراتِ",141,"ت",1,0],["وإن وجودي أن أرى فيك فانيا","ولاحظ لي من دون ذلك في أمر",142,"ر",1,0],["وإن وجودي في فنائي فإنه","فناء صفات النفس عن محكم البشر",142,"ر",1,0],["وإن ورد الوغى في يوم حرب","رأيت البيض في حلل وِرادِ",143,"د",1,0],["وإن وثب الزمان على فقير","قصرت خطاه عنه بما تثيبُ",144,"ب",1,0],["وإنْ وَشَّحَ الأطْرَافَ خِلْتَ سُطُورَهَا","أزَاهِرَ رَوْضٍ أوْ زَوَاهِرَ أنْجُمِ",145,"م",1,0],["وَإنْ وَعَدَ ارْفَضَّتْ عَطَاءً عِدَاتُهُ","بِرَاحَةِ مَسْبُولٍ على الجُودِ غَالِبِ",146,"ب",1,0],["وإن وشّحت أو خلخلت خلن وشحها","بها واِشتكى الخلخالُ منها المخلخلا",147,"ل",2,0],["وَإنّ وفاءَ العهدِ منّي سجيّةٌ","مآكلها لي عذبةٌ والمشاربُ",148,"ب",1,0],["وَأَنَّ وُجوهَ الغُدرِ راقَ بَياضُها","وَأَنَّ وُجوهَ الأَرضِ راعَ اِخضِرارُها",149,"ر",3,0],["وأنواع البقول وكل نبتٍ","نشا للاكل لي خدمٌ وتبّغْ",150,"غ",1,0],["وأنوح معكم نادباً فقد الذي","حزني عليه مثلكم بي يعلقُ",151,"ق",1,0],["وإن وجدت هذه الأسماء","قد أطنبت في ذكرها الأنباء",152,"ا",2,0],["وإنّ واللام مع الايجاب","ولا وما للنفي في الجواب",153,"ب",1,0],["وإن ولاكما مع التنكير","والعرف واخصص لات بالتقدير",153,"ر",1,0],["وانْوِرِتْ عيمان في عهده","شيخ يجذبك ابشاشاته",154,"ت",2,0],["وإِن وفائي لا يفي بحقوكم","فكنت بنقض العهد آبى تأثما",155,"م",2,0],["وإن ورد المعروف والزمر وارد","فأوَّل من يسعى لمعروفه يحيى",156,"ح",3,0],["وأنْوَكَ رَكّاضٍ إلى الغَيّ رُعْتَهُ","على حينَ أن جَدَّ اعتزاماً وأوضَعَا",157,"ع",2,0],["وأنواع حسن بين أنواع لذَّة","تَوالى أعوامُها وشُهورُها",158,"ر",3,0],["وإن وَعدُوا بالغزوِ نَظماً، فهذه","رؤوس أعاديهم بأسيافنا نثر",159,"ر",1,0],["وان ودك اخشى أن تمزقه","يد الهواجس يا من وده كبدي",160,"د",2,0],["وَإِن واجَهَت هَولاً مِنَ اللَيلِ لَفّها","عَلى جانِبَيهِ عَزمُها وَجُسورُها",161,"ر",3,0],["وإن وصفتُ فكاليوم الذي عرفت","بكَ الفرنجةُ فيه كُنهَ ما جهلوا",162,"ل",3,0],["وان ورد وأطاب الغدير وغادروا","به من رحيق الثغر ما فضح الدنا",163,"ن",2,0],["وإن وِجهَةٌ سُدَّت علَيك فروجُها","فإنك لاقٍ لا محالةَ مَذهَبا",164,"ب",2,0],["وإن وصلت له تشريف كنيته","جمعت بالطّول بين الرّوض والمطر",165,"ر",1,0],["وإن ولجت بالقذف منك تعمداً","فبن بوداعٍ من خليطٍ مصرمِ",166,"م",1,0],["وإن ولدٌ يوماً أقر بوالدٍ","فوالدهُ في إرثهِ يتبحبح",167,"ح",1,0],["وإن ولى وفات الوقت صلى","تماماً حين ذاك إذ تحرى",168,"ر",2,0],["وإن ولي الذبيحة أعجميٌّ","فكلها من يدي رجلٍ رشيدِ",169,"د",1,0],["وأنوارٍ تعلَّت","وأحوالٍ تُقيم",170,"م",1,0],["وإن وضعَ الكلاةَ تقولُ هذا","أبو درباس من جبّ عسالِ",171,"ل",1,0],["وإن وقفتْ ليلاً تصلِّي فريضةٌ","فتنوي قبيلَ الفرضِ من جهلِها الوِترا",172,"ر",2,0],["وأنورَ الوجهِ في الديجورِ من قمرٍ","تحت الأكاليل مسبولٍ ومتجدلُ",173,"ل",1,0],["وانور في تعسفه تمادى","وظلَّ على ضلالته مصرّا",174,"ر",2,0],["وان وعدتهم الأحلام نصرا","فقل لهم اخسأوا فالوعد مائن",175,"ن",1,0],["وأنواع خيرات الوجود لأهله","تُساق ولذات النعيم تُسبسب",176,"ب",1,0],["وَإِن وَعَدوا أَوفَوا وَإِن قَدَروا عَفَوا","وَإِن حَكَّموهُم أَقسَطوا في المُحَكَّمِ",177,"م",1,0],["وانوارهم فتح لرشد موفق","وآثارهم حتف لغي مضلل",178,"ل",1,0],["وإن واوات شعر عارضه","كالشصّ تصطادُ من بها عبرا",179,"ر",2,1],["وإن وافيته في السلم يوماً","وقد هزَّت شمائله الشَّمول",180,"ل",1,0],["وإنَّ وجودي صائنٌ من علمته","وبيني وبين الحقِّ فيه تباين",181,"ن",1,0],["وأنوارُها مثلُ بُردِ البَنِيِّ","رُدَّعَ بالمسكِ والزَّعفرانِ",182,"ن",1,0],["وَإِنَّ وَرقاءَ قَد أَردى أَبا كَنَفٍ","وَاِبنَي إِياسٍ وَعَمرا وَاِبنَ أَيّوبِ",183,"ب",1,0],["وأن وضوء المرء مع غسل فرجه","إذا رام عودا يستحب فجوّد",184,"د",1,0],["وإنَّ وجدي من ضيمٍ تَجرعهُ","من ذي الورى وجد يعقوبٍ بن إسحاق",185,"ق",1,0],["وأن ولا كيسان للحارث الذي","ولي زمناً حفر القبور بيثرب",186,"ب",1,0],["وأنوي لغير إبنِ المظفرِ حاجة","وما كل خلق الله أن سِيْل أنْعَمَا",187,"م",2,0],["وَإِن وَهم المماثل فَاعذروه","فَقَد صَيرتم الأَبصار حولا",188,"ل",2,0],["وَإِن وُرود الحَتف في ظُلَّة القَنا","لِأَكرَمُ مِنهُ فَوقَ ظَهر الحَشِيَّة",189,"ه",1,0],["وان وعرت طرق العلا قبل عهده","ففي عهده فوق المجرة تمتد",190,"د",1,0],["وَإن وَصَلتَ وَالقِيَاسُ قَد كَمُل","ثَمَانِيَه وَرُبعَ مَافِيهِ خَلَل",191,"ل",1,0],["وَإِنَّ وَعيدَناكُم حينَ نَمشي","بِهِنَّ عَلى المَنونِ وَلا وَعيدا",192,"د",2,0],["وَإِن وُقِيتَ بِحَمدِ اللَهِ شَرَّتَهُم","فَلتحمد اللَهَ فَالعُقبى لِمَن حَمِدُوا",193,"د",3,0],["وَأَنوَرُ هَل حَباهُ اللَهُ نُجحاً","يَزيدُ بِهِ الصَفا في الخاطِراتِ",194,"ت",1,0],["وإن وشى عاذل وأبدى","بزوره زخرف الكلام",195,"م",1,0],["وإن وضعتها أسفرت عن غريبة","مخبأة لم تحتسب لمفكر",196,"ر",1,0],["وأنوار الخليل تلوح فيه","واسحق المفدي ثم سارا",197,"ر",2,0],["وان وجدت للكلام موضعاً","فكن عراراً فيه أو كالأشدق",198,"ق",1,0],["وإن وَقَعَ الذُّهُولُ فليسَ بِدعاً","فبيتُكَ صارَ كالمَثَلِ المُشَاعِ",199,"ع",1,0],["وإِن وَعَظَ الخطِيبُ ذَوِي عَنَادٍ","فلَيسَ بِوَاقِعٍ فِي القَلبِ سَردُ",200,"د",1,0],["وَإِن وَهَبوا سحباً وَإِن غَضبوا ربى","وَإِن طالَعوا نَجماً وَإِن رَكِبوا أسدا",201,"د",2,0],["وَأَنوار تَبَدَّت مِن وجوه","وَأَنواء بِها الركبان ساروا",202,"ر",3,0],["وأنواع التباين ليس منها","أشدّ من التباين في المعاني",203,"ي",1,0],["وانو انصرافك عن مُهجتي","فتنشد أحمد لا ينصرف",204,"ف",1,0],["وَإِن وَقَفَت بَعدَ الهَزاهِزِ وَاللَغى","تَوالَت مَراخيها بِعَزمِ الشَكائِمِ",205,"م",1,0],["وان وجد العميد بمصر حزباً","أناخ عليه بالامر الخريب",206,"ب",1,0],["وانو التحدث بالانعام مبتهجاً","بما حبته اياديه من القسم",207,"م",1,0],["وإن ولّى القديم بفقد شهمٍ","فقَد يُحيي الجديد له مثالا",208,"ل",2,0],["وإن وجدتَ سُكراً فانْعَمْ به","ولا تَسَلْ عَمَّا جَرى على القَصَبْ",209,"ب",1,0],["وإن وقفت عن الهيجا رجال","فعبد الله في الهيجاء واثب",210,"ب",1,0],["وَإِنَّ وِداداً صادَفَ القَلبَ فارِغاً","أَثارَ مَديحي فَالقَبولُ لَهُ مَهرُ",211,"ر",1,0],["وإن وجدت اسما له معاني","فاحكم بما جاور في المثانى",212,"ن",2,0],["وإن وعدوا ترى مَينا وخُلفا","وإن حكموا ترى في الحكم أمرا",213,"ر",2,0],["وإن ولعتْ كفّه بالفصوص","فإنّ الغنيّ لديه فقيرُ",214,"ر",1,0],["وأنوار أفلاك الأفق بأسرها","ومنها مدد الكل في كل لمحة",215,"ه",1,0],["وان وقفوا بمعترك وضاقت","بجيش عداهم سعة الفضاء",216,"ا",2,0],["وإن ونت لوعة عن كنه صولتها","هبت له لوعة رقشاء تلسعه",217,"ع",2,0],["وإنّ وليَّ الكُفْرِ بالفِكْرِ طالَما","يُنازِلُ أحْزابَ العِدَى وينازِعُ",218,"ع",1,0],["وإنّ وليَّ الغدر في كلِّ حالَةٍ","عن الرُشْدِ ساهٍ أو منَ الرّوْعِ ساهِرُ",219,"ر",1,0],["وإنْ وعَدَ الوعْدَ الجَميلَ رأيتَهُ","علَيْنا وفينا صادِقاً متصَدِّقا",220,"ق",2,0],["وأنْوارُ هَدْيٍ تُجْتَلى حيثُ للعِدى","عُيونٌ تَعامَى عنْ سَناها كَليلُها",221,"ل",3,0],["وَإن وَلاَم لاَمُ ابتِدَاءٍ أو قَسَم","كذَا وَالإستِفهامُ ذَا لَهُ انحَتم",222,"م",1,0],["وَانوِ انضِمَامَ ما بَنَوا قَبل النَّدَا","وَليُجرَ مُجرَى ذِى بِنَاءٍ جُدِّدَا",222,"د",2,0],["وأنواره في كل عصرٍ كأنها","مصابيح في غر الجباه زواهر",223,"ر",1,0],["وان وزيراً طبق الأرض جوده","جدير بأن لا يطلب القوت شاعره",224,"ر",2,0],["وَأَنوح نوح حمامة","فقدت نضيراً باسما",225,"م",2,0],["وَإِن وَهَبوا كانوا غيوثاً لمجتدٍ","وَإِن غلبوا كانوا ليوثَ الكريهة",226,"ه",1,0],["وإن ود عسكركم أن يثور","يقابله من صبوتي عسكران",227,"ن",1,0],["وأنوح منك أخا غذيت بحبه","أم والدا إياه كنت أنادي",228,"د",2,0],["وأنواع الأفاويه","وجوز الطيب والسنبل",229,"ل",1,0],["وأن وثاق الذل في الزند محكمٌ","وأن خناق الغم في النحر محصف",230,"ف",1,0],["وإن وصلت مقام الحي في سحر","فانزل فأوجبههم فيه قناديل",231,"ل",1,0],["وإن وشى ثوبَ غيري قُلتُ في ضَجرٍ","شِ الثوبَ ويكَ شياه شوه شي شينا",232,"ن",2,0],["وان وردت بحره المديدا","مازلت تلقى كل يوم عيدا",233,"د",2,0],["وأنوار كالشمس تشرق في الضحى","عيون العدى منها مدى الدهر تطرف",234,"ف",1,0],["وَإِن وَصَلتَ إِلى قَصرِ الخِلافَةِ قُل","حُيِّيتَ حُييتَ يا مأوى السَلاطينِ",235,"ن",1,0],["وإن وإذما ومهما ثم من ومتى","ومثل أنى وأيان وأين وما",236,"م",2,0],["وَأَنَّ وادي أَنَّةٍ في غَربِهِ","وَغَربُهُ ملآنُ من دَمعٍ جَرى",237,"ا",1,0],["وإن واجهتني نفحةٌ مندليةٌ","لها أرجٌ تعتادُني قُلت مِنهمُ",238,"م",1,0],["وإن واصلوا ألهوا جميع جوارحي","بنَسج برود الشكر والمدح والحمد",239,"د",1,0],["وإن وقفت يومَ الكفاح بمعركٍ","رأيتَ رواسي الارض شُّم هضابها",240,"ب",3,0],["وإن وهَبت سالت اباطحُ رامةٍ","ونعمان بل ضاقت بطون شِعابها",240,"ب",3,0],["وإن وردوا ماء وردت وإن طووا","طويت وإن قالوا تحولت قائلا",241,"ل",2,0],["وإن وردوا ماء حملت سقائهم","أو انتجعوا أرضاً حدوت الزوائلا",241,"ل",2,0],["وإن وافى وذكركم بنادٍ","فيزدادُ الولوعُ إلى حماكم",242,"م",1,0],["وأنو الخير فيمن تجالسه وتصحب","ولا تطمع فتدع مع أهل الوقت أشعب",243,"ب",1,0],["وإنَّ وَجِيهَ القومِ مَنْ كانَ طائعاً","لمولاهُ والإسلامُ أَضْحَى مُؤازِرا",244,"ر",2,0],["وَأَنوارِ السُعودِ عَلى البَرايا","وَحَيُّ العِزِّ قَد حَيّا الأَناما",245,"م",2,0],["وان وشى برد درس","أعطى لنعمانَ خالَه",246,"ل",2,0],["وَأَنواعُ تَعذيبٍ هُناكَ عَلِمتُها","وَأَهوالَها طُرّاً وَهُنَّ فَظائِعُ",247,"ع",1,0],["وإن وفد الزوار سارعت نحوهم","أقبل من شوقي أكف الحضارمه",248,"م",2,0],["وأنور وجهاً من النيرين","إذا له الحطب في مضمحل أدجا",249,"ا",1,0],["وإن وافقتهم في كل شأن","لقالوا : ذاك إمّعة هوائي",250,"ا",2,0],["وأن وأمسى باكياً ومعدداً","فلم ترحمي تعديدهُ وبكاءهُ",251,"ا",3,0],["وإن وُلّيت أمر الناس فاعدل","ولا تتبع هوى فيه الهمود",252,"د",1,0],["واِنْ وِلّيتَ فاعدِلْ في البرايا","فانَّ العَدْلَ اُسُّ المُلْكِ أمرُهْ",253,"ر",2,0],["وانْ وشى الصبحُ بالعينينِ مشرقُهُ","نظرتُ للشمسِ تمويهاً على عَمَدِ",254,"د",1,0],["وأنواعُه قل خَمْسَةَ عْشَرَ كلُّها","تؤلف من جزئين فرعين لا سوى",255,"ا",1,0],["وانْوِ أنْ تفدي الثواني","فالفِدا .. عينٌ بعيْنْ",256,"ن",1,0],["وَإِنْ وَجَّهَ الْعُذَاْلُ نَقْداًº وَتُهْمَةً","وَقَاْلُواْ بِنَا الأَقْوَاْلَº فَالْحُبُّ أَفْصَحُ",257,"ح",1,0],["وإن وجدت سبيل العيش مُتَّسِعا","ولم تجد حاجة للكد والعمل",258,"ل",1,0],["وان وصفتك خآف في شعري يخون","أو يقصر في وصوفك يآآ ملآآك",259,"ك",1,0],["وإنّ وليّ العهد بالعهد قائمٌ","وإن كان غيرُ العرب بالعهد يكفر",260,"ر",1,0],["وإن وراء الثائرين ربوعهم","لها صرخاتٌ حولهم وزماجر",261,"ر",1,0],["وإن وجدوا لنار الضغن فينا","خموداً بادروها بالوقود",262,"د",1,0],["وإن وصلت قمَّةً نظرَتْ نحوَ","أُخرى طموحاً وتسعى لتكبُرْ",263,"ر",1,0],["وأنوارُ أبصَارِ البصَايرِ كَونُهَا","لأسرَارِ أبْحَارِ العُلومِ مَنَابِغُ",264,"غ",1,0],["وان وسمت وما عوفيت من ألم","فقيلك القلب من وجد به وسما",265,"م",2,0],["وإن وجنتها شبه العقيق وقد","سما على رأسها تاج وإكليل",266,"ل",1,0],["وإن وعظتَ فعظْ بالصدقِ...تنجُ بِهِ","ولا تكنْ مثلَ غاوٍ بينَ مرتكسِ",267,"س",1,0],["وإن وقّدوها نار في عُسر الأكوان","من روس عدوانك تولّم حطبها",268,"ب",3,0],["وإن واجهوا الحرب في إنفةٍ","يقولون للنصر كن فيكونْ",269,"ن",1,0],["وإن وصَفتُ بشِعري سِحرَ فاتنةٍ","لزارَني البدرُ في كفّيَّ واكتالا",270,"ل",2,0],["وأنوفاً مصابةً بزكام","لم تطق أن تشم مسكاً ذكيا",271,"ي",2,0],["وإن ورمت أنوفٌ ذاتُ كبرٍ","يرون الكبريا عنها فخارا",272,"ر",2,0],["وإن واصلتُ في إبحار وجدي",".أضاء النور في وجهي وشكلي",273,"ل",2,0],["وإنْ وجدت ُ بحورَ الشعر ِ ظامئة ً","أسقيتُها دمع َ بحر ٍغير ِ ممنون",274,"ن",1,0],["وانوح لين صوتي محنني","ابكي وليفي ناحل العود",275,"د",1,0],["وإنّ وميضَ الروح وهي شفيفةٌ","تلألأ في العينين والقسماتِ",276,"ت",1,0],["وان واجهوا ظلما رموه بعدلهم","واذا رأوا ليل الضلال أناروا",277,"ر",3,0],["وأنَّ... وأنَّ أحزاني بحارٌ","مِنَ القلقِ الذي يَخشى فُجورَهْ",278,"ر",2,0],["وانور ليلي المظلم ولوانه شديد ادماس","ولا به صوت يزهمني ولا اسمع صلصلة جارس",279,"س",1,0],["وَإِنْ وَعَدَتْ أَوْ أَوْعَدَتْ لَسْتُ جازِعاً","لإِيعادِها أَوْ راغِباً فِي المَواعِدِ",280,"د",1,0],["وَإِنْ وَشَّحَتْ أَوْ خَلْخَلَتْ جُلْنَ وُشْحُها","بِها وَاشْتَكَى الخَلْخالُ ( مِنْها ) المُخَلْخَلا",281,"ل",2,0],["وإنوثةِ الفرشاة ِخاطبَ رسمَها","ماءٌ يمازحُ لونُها بسلام ِ",282,"م",1,0],["وان وهن الرجال فإن فيها","رجالا لايفلهم الحديد",283,"د",1,0],["وإنْ وَصَلْناهُ في يَوْمٍ نُؤَمِّلُهُ","فَهَلْ تُرانا كَأَمْسٍ فيهِ نَحْتَفِلُ ؟",284,"ل",1,0],["وإن ولهت فيخ أذيهان معشرٍ","فلا فَضْلَ للأنوار في مُقْلَة ِ الخُلْدِ",285,"د",1,0],["وانوِ الصيامَ عن المعاصي كلِّها","وصُنِ الجوارحَ من هوى اللذاتِ",286,"ت",1,0],["وإن واجهتني نفحةٌ مندليةٌ","لها أرج يقتادني قلت منهم",287,"م",1,0],["وان وقفت تاقف عليها العصافير","شافت غصون وجت تدوّر ثمرها",288,"ر",3,0],["وإن وجه الإقبال عنك إذا","ولى رأيت التعذير قد أقبل",289,"ل",1,0],["وأنواء حي قد عهدنا ربوعه","مقيل ظبا تجد ومغنى الغوانيا",290,"ي",2,0],["وَ أَنُوءُ بِمَكرِ خَدِيعَتِها","فِيما تَتَنَعَّمُ بِهُيَامِي",291,"م",2,0],["وان وصلت الجد خذ من علمي الواكد","والله لاتبطي تجر الصوت وتمول",292,"ل",1,0],["وان وقعت احذر تدور لك على تبريره","انقل الموتر على نقلية البسامي",293,"م",2,0],["وأنّ وادي الشّتا حوّ جآذره","وأنّ مصطافها موآب أسماء",294,"ا",2,0],["وإنْ وجدتَ يداً سوداءَ تمسخُهم","ألعوبة ًفعسى تفنى الألاعيب",295,"ب",1,0]]}