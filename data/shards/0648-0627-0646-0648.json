{"poems":[[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[53,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[53,"أودع في كل يوم حبيبا","https://www.aldiwan.net/poem30733.html","المتقارب"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[77,"نووا سفرا عني الغداة وأزمعوا","https://www.aldiwan.net/poem35980.html","الطويل"],[77,"برئت إلى الشوق المبرح من قلبي","https://www.aldiwan.net/poem36770.html","الطويل"],[30,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[30,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[47,"مصابي جليل والعزاء جميل","https://www.aldiwan.net/poem25177.html","الطويل"],[72,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[72,"هلال بأفقالملك تزهى سعوده","https://www.aldiwan.net/poem18551.html","الطويل"],[51,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[62,"موازين الطبائع في يدينا","https://www.aldiwan.net/poem52159.html","الوافر"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[45,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[45,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[45,"أما والذي أعطاك فضلا وبسطة","https://www.aldiwan.net/poem65204.html","الطويل"],[45,"أبى الليل إلا أن يعود بطوله","https://www.aldiwan.net/poem65540.html","الطويل"],[49,"لقد طال يا دنيا إليك ركوني","https://www.aldiwan.net/poem63125.html","الطويل"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[33,"ألا أيها القصاد نحوي لتعلموا","https://www.aldiwan.net/poem25885.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[105,"غوى الناس حتى لا صواب ولا رشد","https://www.aldiwan.net/poem43420.html","الطويل"],[81,"ياجامع الشمل بعدما افترقا","https://www.aldiwan.net/poem61453.html","الطويل"],[48,"يا ذا الذي عن جنان ظل يخبرني","https://www.aldiwan.net/poem63315.html","البسيط"],[48,"تبدلت اكسارا بالنشاط","https://www.aldiwan.net/poem64371.html","الخفيف"],[46,"يأتي الردى ويواري إثلب جسدا","https://www.aldiwan.net/poem22199.html","البسيط"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"لعمرك ما الدنيا بدار إقامة","https://www.aldiwan.net/poem23441.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85355","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42522","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54209","المتقارب"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[77,"برِحتُ إلى الشّوق المبرِّح من قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=33309",""],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[13,"وَقَالُوا لَهَا لاَ تُنْكِحِيهِ فَإنَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=180832",""],[88,"تحرّ إذا صادقتَ مَن رُدُّه مَحض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19572&r=&rc=75",""]],"verses":[["وَإِنَّ وَراءَ الشَيبِ ما لا أَجوزُهُ","بِعائِقَةٍ تُنسي جَميعَ العَوائِقِ",0,"ق",1,0],["وَإِن وَلَجَ الضِغنُ أَثوابَهُ","نَضا لِبدَةَ الأَسَدِ الحادِرِ",1,"ر",1,0],["وَأَنَّ وَرائِيَ سَوقاً عَنيفاً","وَأَنَّ أَمامي يَوماً عَصِيبا",2,"ب",2,0],["وَإِنَّ وَراءَ ذاكَ الحِلمِ صَولاً","وَإِنَّ لِتِلكُمُ البُقيا عِقابا",3,"ب",2,0],["وإنْ وَشى الحَلْيُ بهِ راعَهُ","بَعْدَ وَفاءِ الخُرْسِ غَدْرُ الفِصاحْ",4,"ح",1,0],["وإنْ وفَيْتُ ببَعْضِ القوْلِ رُبَّتَما","يكْفي منَ العِقْدِ ما قدْ حفَّ بالعُنُقِ",5,"ق",1,0],["وإنْ وَقَفَتْ في حادِثٍ عَزَماتُه","فقدْ أمِنَ الإسْلامُ ما يُتَوقَّعُ",6,"ع",1,0],["وَإِنَّ وِدَادِي فِي الْخَلِيفَةِ يُوسُفٍ","يُكَفِّرُ عِنْدَ اللهِ مَا كَانَ مِنْ ذَنْبِي",7,"ي",1,0],["وَإِن وَضَعَت أَوزارَها الحَربُ كُنتُمُ","مَصيرَ النَدى وَالمُترَعينَ المُقارِيا",8,"ي",2,0],["وَأَنواءُ أَحوالٍ تِباعٍ ثَلاثَةٍ","بِها كانَ مِمّا يَستَحيرُ مَطيرُها",9,"ر",3,0],["وإن ومض البرق الحجازيُّ مَوْهنا","يُردِّدُ في الظلماء أنَّة لهفانِ",10,"ن",1,0],["وَإِنَّ وَراءَ السَترِ أُمّاً بُكاؤُها","عَلَيَّ وَإِن طالَ الزَمانُ طَويلُ",11,"ل",1,0],["وإن وجدت غَشومَ القوم في بلدٍ","حلاً فقلْ أنتَ في حلٍّ من البلد",12,"د",1,0],["وأن وليد الأفضل الملك قد محا","عن الناس حزناً لا ينادى وليدُه",13,"د",2,0],["وإن وقفت الوقوفَ فاز بها","قاضٍ يرى ظلمَ كل ذي صِغر",14,"ر",1,0],["وَإِن وُزِنَ الحَصى فَوَزَنتُ قَومي","وَجَدتُ حَصى ضَريبَتِهِم رَزينا",15,"ن",2,0],["وإن وجود ما في الكون طراً","عليك إذا تأملنا ثناء",16,"ا",2,0],["وأنواع النحاس وهن عشر","مسمّاة بها كمل العديدُ",17,"د",1,0],["وإن وقفت على سر الخميرة لم","تحتج إلى العود فيها مدة العمرِ",18,"ر",1,0],["وَإِنَّ وَسيلَتي وَأَجَلَّ مَتّي","إِلَيكَ بِحَقِّ أَصحابِ الإِساءِ",19,"ا",2,0],["وَإِن وَلِيَ العُمّالُ مِنّي مَبَرَّةً","فَمُستَعمِلُ العُمّالِ أَحرى وَأَخلَقُ",20,"ق",1,0],["وَإِنَّ وَلاءَ المُعتِقينَ مِنَ الرَدى","يَفوقُ وَلاءَ المُعتِقينَ مِنَ الرِقِّ",21,"ق",1,0],["وَإِنَّ وُلاةَ العَهدِ في الحِلمِ وَالتُقى","وَفي الفَضلِ مِن أَمثالِهِ وَشُكولِهِ",22,"ل",2,0],["وَإِن وَجَدوا عِندي رَخاءً تَقَرَّبوا","وَإِن نَزَلَت بي شِدَّةٌ خَذَلوني",23,"ن",2,0],["وإن وهبَ الألوفَ وهنَّ كُثْرٌ","تقدَّمَ قبلهنَّ الإعتذارُ",24,"ر",1,0],["وَأَنَّ وُحوشَ البَرِّ يَأتَلِفونَ بي","ذُكورٌ إِناثٌ ثُمَّ خَشفٌ وَمُرضَعُ",25,"ع",1,0],["وإن وَهَنَ الحُماةُ أوِ اسْتكانوا","فليسوا في الجهادِ بِمُفلِحينا",26,"ن",2,0],["وَإِن وَجَدَت قِلىً وَرَأَت صُدوداً","صَدَدتُ عَنِ الحَياةِ صُدودَ قالِ",27,"ل",1,0],["وَإِن وَثَبَ الضرغامُ لِلصَيدِ عادِياً","فَلا تَعجبوا أَيُّ الضَراغمِ لا يَعدو",28,"د",2,0],["وَإِنَّ وَجدِيَ الَّذي أَراقَ دَمَ ال","عَينِ لَدَمعٌ أَهدى لَها الأَرَقا",29,"ق",2,0],["وَإِن وَقَفتُ لَهُ كَيما يُكَلِّمُني","في المَوضِعِ الخَلوِ لَم يَنطِق مِنَ الحَصَرِ",30,"ر",1,0],["وَأَنوَكَ قالَ لَو أَقصَرتُ عَنهُ","فَقُلتُ لَهُ اللِقاءُ عَلى الصِراطِ",31,"ط",1,0],["وَإِن وَصَلتُ فَشُكري شُكرُ بَروَقَةٍ","تَرضى بِبَرقٍ مِنَ الأَمطارِ خَلّابِ",32,"ب",1,0],["وَأَنوارُ أَعوامٍ مَضَينَ شَواهِدٌ","بِما ضَمِنَتهُ بَعدَهُنَّ الكَمائِمُ",33,"م",1,0],["وَإِنَّ وَليداً حَلَّها لَمُعَذَّبٌ","جَرَت لِسِواهُ بِالسُعودِ الأَيامِنُ",34,"ن",1,0],["وإن وَراء الشيب حتفاً وإنه","لما قلت إِثبات اذا رمت إِثباتا",35,"ت",2,0],["وإنْ وجدتَ الثانيَ المنْقوصا","مُحرَّكاً سَمَّيْتهُ المَوْقُوصا",36,"ص",2,0],["وإِنَّ وِدادَ الْقَلْبِ ما لَمْ يَكُنْ لَهُ","دَلِيلٌ عَلَى إِخْلاصِهِ لَمُرِيبُ",37,"ب",1,0],["وَإِنَّ وَراءَ الحَزمِ فيها وَدونَهُ","مَواقِفَ تُنسى دُنَهُنَّ التَجارِبُ",38,"ب",1,0],["وإِن وَصَف الحربَ خِلْتَ الْحِرابَ","تَسُدُّ من الأرض أقطارها",39,"ر",3,0],["وأن وراءَ هذا الكونِ ربًّا","له في الكونِ أسْرارٌ كِبَار!",40,"ر",1,0],["وإنَّ ودادي في الخليفة ِ يوسُفٍ","يكفِّرُ عند الله ما كان من ذنبِ",41,"ب",1,0],["وإن وفيت ببعض القصد ريتما","يكفي من العقد ما قد حف بالعنق",42,"ق",1,0],["وإنِّ وَإنّي عُمِّرْتُ أَعْلَمُ أَنَّنِي","سَأَلْقَى سِنَانَ الْمَوْتِ يَبْرُقُ أَصْلَعَ",43,"ع",1,0],["وإن ومضت للخلّ منك سحابة","فلا يَكُ منها خلَّباً ذلك الومض",44,"ض",1,0]]}