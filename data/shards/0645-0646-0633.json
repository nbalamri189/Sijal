iwan.net/poem54130.html","الرمل"],[416,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[429,"من سفح لبنان أم من ذيل لبنان","https://www.aldiwan.net/poem40249.html","البسيط"],[429,"يا مي يا ظبية وادي اللوى","https://www.aldiwan.net/poem40271.html","السريع"],[439,"من سبي سيبك مما أنبتت نعمك","https://www.aldiwan.net/poem34790.html","البسيط"],[441,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[441,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[441,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[441,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[441,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[441,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[452,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[453,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[453,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[453,"هدر تلكمو الدماء الزكيه","https://www.aldiwan.net/poem61604.html","الخفيف"],[458,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[458,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[458,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[458,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[458,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[461,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[461,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[464,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[464,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[464,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[464,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[479,"بشراكمو بازديادي","https://www.aldiwan.net/poem37053.html","المجتث"],[479,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[493,"من سره العيد فما سرني","https://www.aldiwan.net/poem67306.html","السريع"],[500,"لنا بنفي شؤون الغير إثبات","https://www.aldiwan.net/poem38062.html","البسيط"],[514,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[515,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[529,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[538,"هي النتائج فما","https://www.aldiwan.net/poem47459.html","عموديه"],[551,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[551,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[551,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[551,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[558,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[558,"إنني إن أمت فما أنا ميت","https://www.aldiwan.net/poem34725.html","الخفيف"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[561,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[561,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[564,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[567,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"],[567,"غيث أتانا مؤذنا بخفض","https://www.aldiwan.net/poem69621.html","الرجز"],[567,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[586,"من سحر طرفك يا علي","https://www.aldiwan.net/poem17665.html","مجزوء الكامل"]],"verses":[["مَن ساءَ ظَنّاً بِمَن يَهواهُ فارَقَهُ","وَحَرَّضَتهُ عَلى إِبعادِهِ التُهَمُ",0,"م",1,0],["مِنْ سائِلٍ صَفَداً يُؤَمِّلُ سَيْبَهُ","ومُكَبَّلٍ في قِدِّهِ مَصْفودِ",1,"د",1,0],["مَنْ سالَمَ الدّنْيا يسالِمُ حيّةً","مرْهوبَةً فلْيَدْرِ كيفَ حِذارُهُ",2,"ر",2,0],["مِن سوقَةٍ حَكَمٍ وَمِن","مَلِكٍ يُعَدُّ لَهُ ثَوابُه",3,"ب",2,0],["مِن ساقِطِ الأَكنافِ ذي","زَجَلٍ أَرَبَّ بِهِ سَحابُه",3,"ب",2,0],["مِن سِرِّكَ المَكتومِ تَن","أى عَن هَواكَ فَلا ثَمارَه",4,"ر",2,0],["مِن سَراةِ الهِجانِ صَلَّبَها العُض","ضُ وَرَعيُ الحِمى وَطولُ الحِيالِ",5,"ل",1,0],["مَن سَّرهُ كَرُمُ الحَياةِ فَلا يَزَل","في مِقنَبٍ مِن صالِحي الأَنصارِ",6,"ر",1,1],["مِن سَنا رَأيِكَ لي في","غَسَقِ الخَطبِ اِقتِباسُ",7,"س",1,0],["مَن سُرَّ لَمّا عاشَ قَلَّ مَتاعُهُ","فَالعَيشُ نَومٌ وَالسُرورُ خَيالُ",8,"ل",1,0],["مِنْ سَدِيدِ الرَّأْيِ مُبْرَمِهِ","مُحْكَمِ الإِيجَابِ وَالسَّلْبِ",9,"ب",1,0],["مِنْ سَفْحِ لُبْنَانٍ تَعَالَى صَوْتُهُمْ","وَصَدَاهُ فِيمَا رَدَّدَ الْهَرَمَانِ",10,"ن",1,0],["مَنْسُوجَةٌ أَيَّامُهُ مِنْ خَيْرِ مَا","يُبْدِي النَّهَارَ وَيَكْتُمُ الإِظْلامُ",11,"م",1,0],["مِنْ سَرَيٍّ فِي الحَيَاةِ وَهْيَ هَدَاهُ","وَجَدَ الصُّبْحَ فِي الظَّلامِ البَهِيمِ",12,"م",1,0],["منْ سَامَكِ السُّوءَ شَلَّتْ دُونَهُ يَدُهُ","يَدُ المُسِيء إِلَى الإِحْسَانِ لاَ تَصِلُ",13,"ل",1,0],["من سار في دنياه سيرة مصلح","لهجت بخالد ذكره الأمصار",14,"ر",1,0],["مَن سلَهُ في دجى الآمال كان له","فجراً تحُلّ حُباها دونه الظُلَم",15,"م",1,0],["مَن سامعٌ قصةً لي كنت شاهدها","على الربا الخضر من جنّات لبنان",16,"ن",1,1],["مِن سَدِّ مُطَّلَعَ النِفاقِ عَلَيهِمِ","أَم مَن يَصولُ كَصَولَةِ الحَجّاجِ",17,"ج",1,0],["مَن سَرَّهُ المَوتُ صِرفاً لا مِزاجَ لَهُ","فَليَأتِ مَأسَدَةً في دارِ عُثمانا",18,"ن",2,1],["منسبٌ غرٌّ لها رونقٌ","أبصرت عقد الدُّر في نضده",19,"د",2,0],["من سفح عدنان التي شرفت به","من ذلك الشرف القديم المهيع",20,"ع",1,0],["من سلّمٍ قد وقعت وقعة من","زاد مقال الحاكمين في ألمه",21,"م",2,0],["من سنقر عالي المدا والشانْ","معظم الأخبار والعيانْ",22,"ن",1,0],["مَن سارَروهُ فَأَبدى كُلَّ ما سَتَروا","وَلَم يُراعِ اِتِصالاً كانَ غَشّاشا",23,"ش",2,1],["مِن سُمسُمٍ وَشَيرَجٍ وَأَحرُفٍ","وَياسَمينٍ في جَبينٍ قَد سُطِر",24,"ر",1,0],["من سِباعٍ ومن أفاعٍ وكلٌّ","مُفسدٌ ما استحنَّتِ النِّيبُ نيبا",25,"ب",2,0],["من سعادات جدودٍ أقبلت","وسعادات جدود حاضره",26,"ر",2,0],["مَنْ سائلٌ قمر الدُجى","ما بالُهُ تركَ الطلوعا",27,"ع",2,0],["من سيدات القوافي ما يزال لها","راو تظل به السادات حُفّافا",28,"ف",2,0],["مَنْ سقَى ما سقَى وأسمعَ ما أسْ","مع لم يُبِق غايةً للنديمِ",29,"م",1,0],["مِن سِحرِ طَرفِكِ مِن مُجيري","يا ضَرَّةَ الرَشَءِ الغَريرِ",30,"ر",1,1],["من سيد بالأمس ننكر قوله","صرنا لفعّال من الأسياد",31,"د",1,0],["مِن سُيوفِ الجِهادِ فولاذُهُ ال","حَقُّ فَهَل كانَ قَينُهُ جِبريلا",32,"ل",2,0],["مَن سارَ لَم يَثنِ العِنا","نَ وَمَن أَقامَ إِلى اِقتِرابِ",33,"ب",1,0],["مَن سَبَّ دينَ مُحَمَّدٍ فَمُحَمَّدٌ","مُتَمَكِّنٌ عَنّا الإِلَهُ رَسولا",34,"ل",2,0],["مَن سَرَّهُ أَلّا يَموتَ فَبِالعُلا","خَلُدَ الرِجالُ وَبِالفِعالِ النابِهِ",35,"ب",2,0],["مَن سائِلٌ لِمُعَذِّرٍ عَن خَطبِهِ","أَو صافِحٌ لِمُقَصِّرٍ عَن ذَنبِهِ",36,"ب",2,1],["مِن ساعِدَينِ يَزيدَ يَقدَحُ زِندَهُ","كَفّاهُما وَأَشَدُّ عَقدِ جِوارِ",37,"ر",1,0],["من سودت لحيته خدّه","مات وإن لم يكن رهن الثرى",38,"ا",1,0],["من سراويلِ سُندُسٍ تملأ العَي","نَ بَهاءً ومن غُلالَةِ داحِ",39,"ح",1,0],["مَن سالَموا نالَ الكَرامَةَ كُلَّها","أَو حارَبوا أَلوى مَعَ العَشّاءِ",40,"ا",2,0],["مَن سامَحَ الحادِثاتِ ذَلَّت لَهُ ال","أَرضُ وَلانَت لَهُ مَناكِبُها",41,"ب",3,0],["مَن سابَقَ الدَهرَ كَبا كَبوَةً","لَم يَستَقِلها مِن خُطى الدَهرِ",42,"ر",1,1],["مَن سالَمَ الناسَ سَلِم","مَن شاتَمَ الناسَ شُتِم",43,"م",1,1],["مُنسَرِحٌ فيهِ يُضرَبُ المَثَلُ","مُستَفعِلُن فاعِلاتٌ مُفتَعِلُ",44,"ل",1,0],["مِن سُبِّقٍ لا يَرى سَوطٌ لَها سَمَلاً","وَلا جَديدٌ مِنَ الأَرسانِ وَاللُجُمِ",45,"م",1,0],["من سقى يوماً بماء ظامئاً","فأنا من قدح العمر سقيته",46,"ه",1,0],["مَن سَلّمَ الأمرَ للإله نجا","ومن عدا القصد واقعَ الهلكه",47,"ك",2,0],["من سالَمَ الضعفاءَ راموا حرْبَهُ","فالبسْ لكلّ الناسِ شِكّةَ محرَبِ",48,"ب",1,0],["من سادةٍ أخلاقُهُمْ وحلومُهُمْ","تتعرّضانِ بسائطاً وجبالا",49,"ل",2,0],["مِن سَجايا الطُلولِ أَلّا تُجيبا","فَصَوابٌ مِن مُقلَةٍ أَن تَصوبا",50,"ب",2,1],["مَنْ سمعْ لفظَها تراهُ","كالغصنِ معَ النسيمِ مائلْ",51,"ل",1,0],["مِنْ سعدِ جلِّقَ أن النائباتِ بها","بيضٌ وفي غيرها ما ابيضَّتِ النُّوَبُ",52,"ب",1,0],["مُنساغَةً فَكَأَنَّها مِن ريقِهِ","مُحَمَرَّةً فَكَأَنَّها مِن خَدِّه",53,"ه",1,0],["مُنسَلِبِ الحيلَةِ وَالصَبرِ لا","يَأوي إِلى عَقلٍ وَلا مَعقِلِ",54,"ل",1,0],["مِن سَبَأَ الحاضِرينَ مأرِبَ إِذ","يَبنونَ مِن دونِ سَيلِهِ العَرِما",55,"م",2,1],["مَن سارَ كُلَّ ساعَةٍ","أَوشِك بِهِ أَن يَرِدا",56,"د",2,0],["من ساور الرقشَ في مكامنها","واستنزل العصم من معاقلها",57,"ل",3,0],["من سابحٍ منها إذا استحضَرتَهُ","رَبِذِ اليدَين وسَلهَبٍ مَحبوك",58,"ك",1,0],["مَنْسَكٌ للوفود يُعْتَامُ قد أن","ضَى المَطايا بطول وَخْدٍ ورَتك",59,"ك",1,0],["مَن سَبَّني مِن ثَقيفٍ","فَإِنَّني لَن أَسُبَّه",60,"ب",2,1],["مِن سَرَّ آلَ النَبِيِّ في رُتَبٍ","قالَ لَها اللَهُ بِالتُقى فوقي",61,"ق",2,0],["مِن ساحِرِ العَينَينِ يَج","ذِبُ خَصرَهُ رِدفٌ ثَقيلُ",62,"ل",1,0],["مِن سُلافٍ كَأَنَّها كُلُّ شَيءٍ","يَتَمَنّى مُخَيَّرٌ أَن يَكونا",63,"ن",2,0],["مِن سَوسَنٍ غَضِّ القِطافِ وَخُزَّمٍ","وَبَنَفسَجٍ وَشَقائِقِ النُعمانِ",64,"ن",1,0],["مِن سُفعَةٍ طُرَّ بِها خَدّاهُ","أَزرَقُ لا تَكذِبُهُ عَيناهُ",65,"ا",2,0],["مِن سِحرِ عَينَيكِ المَهاةُ تَعَلَّمَت","وَكَذَلِكَ الغِزلانُ مِنها تَغزِلُ",66,"ل",1,0],["مِن سَبعَةٍ فَإِذا أَنشَأتَ تَحسُبُها","وَفّاكَها كُمَّلاً في كَفِّكَ العَدَدُ",67,"د",1,0],["مِن سِهامِ الحُبِّ إِنّي","أَشتَهيها لِلحِبابِ",68,"ب",1,0],["مَن سَرَّهُ بُدنٌ يَعيشُ بِهِ","فَسُرورِيَ التَلويحُ وَالضُمرُ",69,"ر",1,0],["مَن سَيبُهُ سَحُّ الفُراتِ وَحَملُهُ","يَزِنُ الجِبالَ وَنَيلُهُ لا يَنفَدُ",70,"د",1,0],["من سُؤدُدِ الصِّدِّيقِ أنّ زمانَهُ","لو لم يَلِدْهُ لكانَ خَصْمَ السُّؤْدُدِ",71,"د",1,0],["من ساءَ من مرض عضال طبعه","يَستقبح الأيام وَهيَ حسان",72,"ن",1,0],["من سفينٍ يملأُ البحرَ ضِراما","ذلك الأُسطول كم ثارَ احتداما",73,"م",2,0],["من ساعةِ الطوفانِ أو فيْضٍ طَغى","فعَلا قُرى سَبَإٍ مَوَالِدُ ساعِها",74,"ع",3,0],["من سخر الصخر الأصم للقلم","حتى جرى نورا عليه في الظلم",75,"م",1,1],["مَن سَرَّهُ العَيشُ وَلذَّاتُهُ","فَليَجعَلِ الرَّاحَ لَهُ سُلَّما",76,"م",2,0],["مِنْ سَانِحَاتِ الْعَبْقَرِيَّ","ةِ فِي حِجَى قَيْلٍ هُمَامِ",77,"م",1,0],["مِنْ سَمَاءِ الأهْرَامِ جَلَّلَ قَيْسو","نَ وَأَلقَى السَّوَادَ فَوْقَ السَّوَادِ",78,"د",1,0],["مَنْ سَقَتْهُ النَّوَى ثُمَالَةَ كَأْسٍ","قَدْ سَقَتْنِي النَّوَى بِكَأْسٍ دِهَاقِ",79,"ق",1,0],["مَنْ سِوَاهُ بِيَقْظَةٍ وَحَنَانٍ","كُلُّ آنٍ لِشَعْبِهِ يَتَعَهَّدْ",80,"د",1,0],["مَنْ سَرَّه ضَرْبٌ يُمَعْمِعُ بعضُهُ","بعضاً كمعمعةِ الأَبَاءِ المُحْرَقِ",81,"ق",1,1],["من سواد يحكي قلنسوة القسيس","في راسه الصغير استدارا",82,"ر",2,0],["مَن سَرَّهُ أَن يَرى قَطيعَتَنا","أَطعَمَه اللَهُ لَحمَهُ كَلَبا",83,"ب",2,0],["مَن سالَ عَن ميتي وَعَن ثكلي","قُلتُ مُجيباً لَهُ أَلا حُلوا",84,"ل",3,1],["منْ سِوَى ذِي الْمَضَاءِ وَالْهِمَّةِ الشَّماءِ","أَوْلَى بِالْقِمَّةِ الشمَّاءِ",85,"ا",2,0],["مَنْ سَلَبَ الأعْيُنَ أنْ تَهْجَعَا","وبَزَّ ذَاتَ الطَّوْقِ أنْ تَسْجَعَا",86,"ع",2,1],["مَنْ سَارَ في نُورِ الإِلهِ","سَعَى إِلَيْهِ كُلُّ قَصْدِ",87,"د",1,0],["مِنْ سدرةِ المنتهَى أصْغَى الحبيبُ إلى","صوتٍ -يَجِلُّ عن التشبيه- ناداهُ",88,"ا",2,0],["مَنْ سَمَّن الكلبَ أمسى منه مَعْقُورا","يا جيرة «المَنْشِ»، هذا كلب«بلفورا»",89,"ر",2,1],["مِن سراديبه، إلى البوح يرقى","يمتطي صوته، ويهمي رذاذا",90,"ذ",2,0],["من سؤال عن الحجاز وردّ","عن غلاء الكساء و((التبن)) كاسد",91,"د",1,0],["من سكون الدّجا ومن هجهة الصح","را وحشة القفار المهيلة",92,"ل",2,0],["من سيعطي (سعدا) حساما بصيرا","ثالث الساعدين ، ذيل ، حيادي",93,"د",2,0],["مَن سَبَّ دينَ مُحَمَّدٍ فَمُحَمَّدٌ","مُتَمَكِّنٌ عَند الإِلَهُ رَسولا",94,"ل",2,0],["منسابةً لطفاً وبين سطورها","حزناً عليك مدامعي تنساب",95,"ب",1,0],["من سفح دجلةَ حين رق نسيمهُ","سَحَراً وراقت دانيات قُطوفه",96,"ف",2,0],["من سخرية الاقدار؟ انّي انا وأنت","يضمنا جد ... ونسمّى جماعه",97,"ع",2,0],["من سحاي .. وم