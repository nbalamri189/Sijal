{"poems":[[53,"نهنه عتابك إلا إن هفا جرم","https://www.aldiwan.net/poem29760.html","البسيط"],[63,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[73,"ما على ظني باس","https://www.aldiwan.net/poem11908.html","مجزوء الرمل"],[73,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[93,"بارك الله في قران النجيبين","https://www.aldiwan.net/poem11381.html","الخفيف"],[93,"يا ربة الحسن ترعاه طهارتها","https://www.aldiwan.net/poem11424.html","البسيط"],[88,"قالوا نخلد ذكره بحديقة","https://www.aldiwan.net/poem44396.html","الكامل"],[88,"هي المنى كثغور الغيد تبتسم","https://www.aldiwan.net/poem44833.html","البسيط"],[88,"من سامع قصة لي كنت شاهدها","https://www.aldiwan.net/poem45041.html","البسيط"],[27,"هاج الهوى لفؤادك المهتاج","https://www.aldiwan.net/poem5696.html","الكامل"],[23,"من سره الموت صرفا لا مزاج له","https://www.aldiwan.net/poem21252.html","البسيط"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[72,"يا سيدا لا زال ممتحنا","https://www.aldiwan.net/poem20015.html","المنسرح"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[64,"من سارروه فأبدى كل ما ستروا","https://www.aldiwan.net/poem67633.html","البسيط"],[64,"يا طالما غبنا عن أشباح النظر","https://www.aldiwan.net/poem67646.html","الرجز"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[51,"وهبت له عيني الهجوعا","https://www.aldiwan.net/poem65049.html","مجزوء الكامل"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"حبستنا السماء حبسا كريما","https://www.aldiwan.net/poem66305.html","الخفيف"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[85,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[85,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[45,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[28,"وإذا الرجال رأوا يزيد رأيتهم","https://www.aldiwan.net/poem5177.html","الكامل"],[61,"لكل شيء حسن آفة","https://www.aldiwan.net/poem51392.html","السريع"],[61,"قم بنا قبل غرة الإصباح","https://www.aldiwan.net/poem51736.html","الخفيف"],[2,"سترحل بالمطي قصائدي","https://www.aldiwan.net/poem25044.html","الكامل"],[49,"عجبت للنار نام راهبها","https://www.aldiwan.net/poem10385.html","المنسرح"],[49,"من سابق الدهر كبا كبوة","https://www.aldiwan.net/poem62078.html","البسيط"],[49,"من سالم الناس سلم","https://www.aldiwan.net/poem63111.html","مجزوء الرجز"],[66,"طويل له دون البحور فضائل","https://www.aldiwan.net/poem38472.html","الطويل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[97,"نداؤك يا فؤاد كفى نداء","https://www.aldiwan.net/poem25073.html","الوافر"],[80,"نفوسنا بالرجاء ممتسكه","https://www.aldiwan.net/poem31223.html","المنسرح"],[80,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[69,"يا أفضل مرسل كريم","https://www.aldiwan.net/poem29050.html","مجزوء الدوبيت"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[74,"حيا بها ونسيمها كنسيمه","https://www.aldiwan.net/poem12906.html","الكامل"],[81,"لا تطلبوا ثأري فلا حق لي","https://www.aldiwan.net/poem61502.html","السريع"],[21,"من سبأ الحاضرين مأرب إذ","https://www.aldiwan.net/poem36157.html","المنسرح"],[52,"راح فراق أوغدا","https://www.aldiwan.net/poem27133.html","مجزوء الرجز"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[75,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[75,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[48,"من سبني من ثقيف","https://www.aldiwan.net/poem10785.html","المجتث"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[48,"إن التي أبصرتها","https://www.aldiwan.net/poem64970.html","مجزوء الكامل"],[48,"غننا بالطلول كيف بلينا","https://www.aldiwan.net/poem65279.html","الخفيف"],[48,"لا تخشعن لطارق الحدثان","https://www.aldiwan.net/poem65313.html","الكامل"],[48,"قد أغتدي والصبح في دجاه","https://www.aldiwan.net/poem66201.html","الرجز"],[50,"يا من برائق ريقه يحيي الورى","https://www.aldiwan.net/poem62264.html","الكامل"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[46,"لا علم لي بم يختم العمر","https://www.aldiwan.net/poem22588.html","الكامل"],[15,"إن الحوادث قد يجيء بها الغد","https://www.aldiwan.net/poem45274.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49163","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85350","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21092","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12478","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43823","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"أغنية الإِسراء","https://www.poetsgate.com/ViewPoem.aspx?id=179622",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[100,"الهارب.. إلى صوته","https://www.poetsgate.com/ViewPoem.aspx?id=183582",""],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[85,"أَيّامُكُم أَم عَهدُ إِسماعيلا","https://www.poetsgate.com/ViewPoem.aspx?id=1912",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[51,"مَنْ سَرَّهُ ألا يرى ما يَسُوءُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=28624",""]],"verses":[["مَن ساءَ ظَنّاً بِمَن يَهواهُ فارَقَهُ","وَحَرَّضَتهُ عَلى إِبعادِهِ التُهَمُ",0,"م",1,0],["مِنْ سائِلٍ صَفَداً يُؤَمِّلُ سَيْبَهُ","ومُكَبَّلٍ في قِدِّهِ مَصْفودِ",1,"د",1,0],["مَنْ سالَمَ الدّنْيا يسالِمُ حيّةً","مرْهوبَةً فلْيَدْرِ كيفَ حِذارُهُ",2,"ر",2,0],["مِن سوقَةٍ حَكَمٍ وَمِن","مَلِكٍ يُعَدُّ لَهُ ثَوابُه",3,"ب",2,0],["مِن ساقِطِ الأَكنافِ ذي","زَجَلٍ أَرَبَّ بِهِ سَحابُه",3,"ب",2,0],["مِن سِرِّكَ المَكتومِ تَن","أى عَن هَواكَ فَلا ثَمارَه",4,"ر",2,0],["مِن سَراةِ الهِجانِ صَلَّبَها العُض","ضُ وَرَعيُ الحِمى وَطولُ الحِيالِ",5,"ل",1,0],["مَن سَّرهُ كَرُمُ الحَياةِ فَلا يَزَل","في مِقنَبٍ مِن صالِحي الأَنصارِ",6,"ر",1,1],["مِن سَنا رَأيِكَ لي في","غَسَقِ الخَطبِ اِقتِباسُ",7,"س",1,0],["مَن سُرَّ لَمّا عاشَ قَلَّ مَتاعُهُ","فَالعَيشُ نَومٌ وَالسُرورُ خَيالُ",8,"ل",1,0],["مِنْ سَدِيدِ الرَّأْيِ مُبْرَمِهِ","مُحْكَمِ الإِيجَابِ وَالسَّلْبِ",9,"ب",1,0],["مِنْ سَفْحِ لُبْنَانٍ تَعَالَى صَوْتُهُمْ","وَصَدَاهُ فِيمَا رَدَّدَ الْهَرَمَانِ",10,"ن",1,0],["مَنْسُوجَةٌ أَيَّامُهُ مِنْ خَيْرِ مَا","يُبْدِي النَّهَارَ وَيَكْتُمُ الإِظْلامُ",11,"م",1,0],["مِنْ سَرَيٍّ فِي الحَيَاةِ وَهْيَ هَدَاهُ","وَجَدَ الصُّبْحَ فِي الظَّلامِ البَهِيمِ",12,"م",1,0],["منْ سَامَكِ السُّوءَ شَلَّتْ دُونَهُ يَدُهُ","يَدُ المُسِيء إِلَى الإِحْسَانِ لاَ تَصِلُ",13,"ل",1,0],["من سار في دنياه سيرة مصلح","لهجت بخالد ذكره الأمصار",14,"ر",1,0],["مَن سلَهُ في دجى الآمال كان له","فجراً تحُلّ حُباها دونه الظُلَم",15,"م",1,0],["مَن سامعٌ قصةً لي كنت شاهدها","على الربا الخضر من جنّات لبنان",16,"ن",1,1],["مِن سَدِّ مُطَّلَعَ النِفاقِ عَلَيهِمِ","أَم مَن يَصولُ كَصَولَةِ الحَجّاجِ",17,"ج",1,0],["مَن سَرَّهُ المَوتُ صِرفاً لا مِزاجَ لَهُ","فَليَأتِ مَأسَدَةً في دارِ عُثمانا",18,"ن",2,1],["منسبٌ غرٌّ لها رونقٌ","أبصرت عقد الدُّر في نضده",19,"د",2,0],["من سفح عدنان التي شرفت به","من ذلك الشرف القديم المهيع",20,"ع",1,0],["من سلّمٍ قد وقعت وقعة من","زاد مقال الحاكمين في ألمه",21,"م",2,0],["من سنقر عالي المدا والشانْ","معظم الأخبار والعيانْ",22,"ن",1,0],["مَن سارَروهُ فَأَبدى كُلَّ ما سَتَروا","وَلَم يُراعِ اِتِصالاً كانَ غَشّاشا",23,"ش",2,1],["مِن سُمسُمٍ وَشَيرَجٍ وَأَحرُفٍ","وَياسَمينٍ في جَبينٍ قَد سُطِر",24,"ر",1,0],["من سِباعٍ ومن أفاعٍ وكلٌّ","مُفسدٌ ما استحنَّتِ النِّيبُ نيبا",25,"ب",2,0],["من سعادات جدودٍ أقبلت","وسعادات جدود حاضره",26,"ر",2,0],["مَنْ سائلٌ قمر الدُجى","ما بالُهُ تركَ الطلوعا",27,"ع",2,0],["من سيدات القوافي ما يزال لها","راو تظل به السادات حُفّافا",28,"ف",2,0],["مَنْ سقَى ما سقَى وأسمعَ ما أسْ","مع لم يُبِق غايةً للنديمِ",29,"م",1,0],["مِن سِحرِ طَرفِكِ مِن مُجيري","يا ضَرَّةَ الرَشَءِ الغَريرِ",30,"ر",1,1],["من سيد بالأمس ننكر قوله","صرنا لفعّال من الأسياد",31,"د",1,0],["مِن سُيوفِ الجِهادِ فولاذُهُ ال","حَقُّ فَهَل كانَ قَينُهُ جِبريلا",32,"ل",2,0],["مَن سارَ لَم يَثنِ العِنا","نَ وَمَن أَقامَ إِلى اِقتِرابِ",33,"ب",1,0],["مَن سَبَّ دينَ مُحَمَّدٍ فَمُحَمَّدٌ","مُتَمَكِّنٌ عَنّا الإِلَهُ رَسولا",34,"ل",2,0],["مَن سَرَّهُ أَلّا يَموتَ فَبِالعُلا","خَلُدَ الرِجالُ وَبِالفِعالِ النابِهِ",35,"ب",2,0],["مَن سائِلٌ لِمُعَذِّرٍ عَن خَطبِهِ","أَو صافِحٌ لِمُقَصِّرٍ عَن ذَنبِهِ",36,"ب",2,1],["مِن ساعِدَينِ يَزيدَ يَقدَحُ زِندَهُ","كَفّاهُما وَأَشَدُّ عَقدِ جِوارِ",37,"ر",1,0],["من سودت لحيته خدّه","مات وإن لم يكن رهن الثرى",38,"ا",1,0],["من سراويلِ سُندُسٍ تملأ العَي","نَ بَهاءً ومن غُلالَةِ داحِ",39,"ح",1,0],["مَن سالَموا نالَ الكَرامَةَ كُلَّها","أَو حارَبوا أَلوى مَعَ العَشّاءِ",40,"ا",2,0],["مَن سامَحَ الحادِثاتِ ذَلَّت لَهُ ال","أَرضُ وَلانَت لَهُ مَناكِبُها",41,"ب",3,0],["مَن سابَقَ الدَهرَ كَبا كَبوَةً","لَم يَستَقِلها مِن خُطى الدَهرِ",42,"ر",1,1],["مَن سالَمَ الناسَ سَلِم","مَن شاتَمَ الناسَ شُتِم",43,"م",1,1],["مُنسَرِحٌ فيهِ يُضرَبُ المَثَلُ","مُستَفعِلُن فاعِلاتٌ مُفتَعِلُ",44,"ل",1,0],["مِن سُبِّقٍ لا يَرى سَوطٌ لَها سَمَلاً","وَلا جَديدٌ مِنَ الأَرسانِ وَاللُجُمِ",45,"م",1,0],["من سقى يوماً بماء ظامئاً","فأنا من قدح العمر سقيته",46,"ه",1,0],["مَن سَلّمَ الأمرَ للإله نجا","ومن عدا القصد واقعَ الهلكه",47,"ك",2,0],["من سالَمَ الضعفاءَ راموا حرْبَهُ","فالبسْ لكلّ الناسِ شِكّةَ محرَبِ",48,"ب",1,0],["من سادةٍ أخلاقُهُمْ وحلومُهُمْ","تتعرّضانِ بسائطاً وجبالا",49,"ل",2,0],["مِن سَجايا الطُلولِ أَلّا تُجيبا","فَصَوابٌ مِن مُقلَةٍ أَن تَصوبا",50,"ب",2,1],["مَنْ سمعْ لفظَها تراهُ","كالغصنِ معَ النسيمِ مائلْ",51,"ل",1,0],["مِنْ سعدِ جلِّقَ أن النائباتِ بها","بيضٌ وفي غيرها ما ابيضَّتِ النُّوَبُ",52,"ب",1,0],["مُنساغَةً فَكَأَنَّها مِن ريقِهِ","مُحَمَرَّةً فَكَأَنَّها مِن خَدِّه",53,"ه",1,0],["مُنسَلِبِ الحيلَةِ وَالصَبرِ لا","يَأوي إِلى عَقلٍ وَلا مَعقِلِ",54,"ل",1,0