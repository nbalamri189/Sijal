6,"من سبي سيبك مما أنبتت نعمك","https://www.aldiwan.net/poem34790.html","البسيط"],[438,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[438,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[438,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[438,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[438,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[438,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[450,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[451,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[451,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[451,"هدر تلكمو الدماء الزكيه","https://www.aldiwan.net/poem61604.html","الخفيف"],[456,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[456,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[456,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[456,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[456,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[459,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[459,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[462,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[462,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[462,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[462,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[477,"بشراكمو بازديادي","https://www.aldiwan.net/poem37053.html","المجتث"],[477,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[491,"من سره العيد فما سرني","https://www.aldiwan.net/poem67306.html","السريع"],[498,"لنا بنفي شؤون الغير إثبات","https://www.aldiwan.net/poem38062.html","البسيط"],[512,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[513,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[527,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[536,"هي النتائج فما","https://www.aldiwan.net/poem47459.html","عموديه"],[549,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[549,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[549,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[549,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[556,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[556,"إنني إن أمت فما أنا ميت","https://www.aldiwan.net/poem34725.html","الخفيف"],[559,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[559,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[562,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[565,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"],[565,"غيث أتانا مؤذنا بخفض","https://www.aldiwan.net/poem69621.html","الرجز"],[565,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[584,"من سحر طرفك يا علي","https://www.aldiwan.net/poem17665.html","مجزوء الكامل"]],"verses":[["مَن ساءَ ظَنّاً بِمَن يَهواهُ فارَقَهُ","وَحَرَّضَتهُ عَلى إِبعادِهِ التُهَمُ",0,"م",1,0],["مِنْ سائِلٍ صَفَداً يُؤَمِّلُ سَيْبَهُ","ومُكَبَّلٍ في قِدِّهِ مَصْفودِ",1,"د",1,0],["مَنْ سالَمَ الدّنْيا يسالِمُ حيّةً","مرْهوبَةً فلْيَدْرِ كيفَ حِذارُهُ",2,"ر",2,0],["مِن سوقَةٍ حَكَمٍ وَمِن","مَلِكٍ يُعَدُّ لَهُ ثَوابُه",3,"ب",2,0],["مِن ساقِطِ الأَكنافِ ذي","زَجَلٍ أَرَبَّ بِهِ سَحابُه",3,"ب",2,0],["مِن سِرِّكَ المَكتومِ تَن","أى عَن هَواكَ فَلا ثَمارَه",4,"ر",2,0],["مِن سَراةِ الهِجانِ صَلَّبَها العُض","ضُ وَرَعيُ الحِمى وَطولُ الحِيالِ",5,"ل",1,0],["مَن سَّرهُ كَرُمُ الحَياةِ فَلا يَزَل","في مِقنَبٍ مِن صالِحي الأَنصارِ",6,"ر",1,1],["مِن سَنا رَأيِكَ لي في","غَسَقِ الخَطبِ اِقتِباسُ",7,"س",1,0],["مَن سُرَّ لَمّا عاشَ قَلَّ مَتاعُهُ","فَالعَيشُ نَومٌ وَالسُرورُ خَيالُ",8,"ل",1,0],["مِنْ سَدِيدِ الرَّأْيِ مُبْرَمِهِ","مُحْكَمِ الإِيجَابِ وَالسَّلْبِ",9,"ب",1,0],["مِنْ سَفْحِ لُبْنَانٍ تَعَالَى صَوْتُهُمْ","وَصَدَاهُ فِيمَا رَدَّدَ الْهَرَمَانِ",10,"ن",1,0],["مَنْسُوجَةٌ أَيَّامُهُ مِنْ خَيْرِ مَا","يُبْدِي النَّهَارَ وَيَكْتُمُ الإِظْلامُ",11,"م",1,0],["مِنْ سَرَيٍّ فِي الحَيَاةِ وَهْيَ هَدَاهُ","وَجَدَ الصُّبْحَ فِي الظَّلامِ البَهِيمِ",12,"م",1,0],["منْ سَامَكِ السُّوءَ شَلَّتْ دُونَهُ يَدُهُ","يَدُ المُسِيء إِلَى الإِحْسَانِ لاَ تَصِلُ",13,"ل",1,0],["من سار في دنياه سيرة مصلح","لهجت بخالد ذكره الأمصار",14,"ر",1,0],["مَن سلَهُ في دجى الآمال كان له","فجراً تحُلّ حُباها دونه الظُلَم",15,"م",1,0],["مَن سامعٌ قصةً لي كنت شاهدها","على الربا الخضر من جنّات لبنان",16,"ن",1,1],["مِن سَدِّ مُطَّلَعَ النِفاقِ عَلَيهِمِ","أَم مَن يَصولُ كَصَولَةِ الحَجّاجِ",17,"ج",1,0],["مَن سَرَّهُ المَوتُ صِرفاً لا مِزاجَ لَهُ","فَليَأتِ مَأسَدَةً في دارِ عُثمانا",18,"ن",2,1],["منسبٌ غرٌّ لها رونقٌ","أبصرت عقد الدُّر في نضده",19,"د",2,0],["من سفح عدنان التي شرفت به","من ذلك الشرف القديم المهيع",20,"ع",1,0],["من سلّمٍ قد وقعت وقعة من","زاد مقال الحاكمين في ألمه",21,"م",2,0],["من سنقر عالي المدا والشانْ","معظم الأخبار والعيانْ",22,"ن",1,0],["مَن سارَروهُ فَأَبدى كُلَّ ما سَتَروا","وَلَم يُراعِ اِتِصالاً كانَ غَشّاشا",23,"ش",2,1],["مِن سُمسُمٍ وَشَيرَجٍ وَأَحرُفٍ","وَياسَمينٍ في جَبينٍ قَد سُطِر",24,"ر",1,0],["من سِباعٍ ومن أفاعٍ وكلٌّ","مُفسدٌ ما استحنَّتِ النِّيبُ نيبا",25,"ب",2,0],["من سعادات جدودٍ أقبلت","وسعادات جدود حاضره",26,"ر",2,0],["مَنْ سائلٌ قمر الدُجى","ما بالُهُ تركَ الطلوعا",27,"ع",2,0],["من سيدات القوافي ما يزال لها","راو تظل به السادات حُفّافا",28,"ف",2,0],["مَنْ سقَى ما سقَى وأسمعَ ما أسْ","مع لم يُبِق غايةً للنديمِ",29,"م",1,0],["مِن سِحرِ طَرفِكِ مِن مُجيري","يا ضَرَّةَ الرَشَءِ الغَريرِ",30,"ر",1,1],["من سيد بالأمس ننكر قوله","صرنا لفعّال من الأسياد",31,"د",1,0],["مِن سُيوفِ الجِهادِ فولاذُهُ ال","حَقُّ فَهَل كانَ قَينُهُ جِبريلا",32,"ل",2,0],["مَن سارَ لَم يَثنِ العِنا","نَ وَمَن أَقامَ إِلى اِقتِرابِ",33,"ب",1,0],["مَن سَبَّ دينَ مُحَمَّدٍ فَمُحَمَّدٌ","مُتَمَكِّنٌ عَنّا الإِلَهُ رَسولا",34,"ل",2,0],["مَن سَرَّهُ أَلّا يَموتَ فَبِالعُلا","خَلُدَ الرِجالُ وَبِالفِعالِ النابِهِ",35,"ب",2,0],["مَن سائِلٌ لِمُعَذِّرٍ عَن خَطبِهِ","أَو صافِحٌ لِمُقَصِّرٍ عَن ذَنبِهِ",36,"ب",2,1],["مِن ساعِدَينِ يَزيدَ يَقدَحُ زِندَهُ","كَفّاهُما وَأَشَدُّ عَقدِ جِوارِ",37,"ر",1,0],["من سودت لحيته خدّه","مات وإن لم يكن رهن الثرى",38,"ا",1,0],["من سراويلِ سُندُسٍ تملأ العَي","نَ بَهاءً ومن غُلالَةِ داحِ",39,"ح",1,0],["مَن سالَموا نالَ الكَرامَةَ كُلَّها","أَو حارَبوا أَلوى مَعَ العَشّاءِ",40,"ا",2,0],["مَن سامَحَ الحادِثاتِ ذَلَّت لَهُ ال","أَرضُ وَلانَت لَهُ مَناكِبُها",41,"ب",3,0],["مَن سابَقَ الدَهرَ كَبا كَبوَةً","لَم يَستَقِلها مِن خُطى الدَهرِ",42,"ر",1,1],["مَن سالَمَ الناسَ سَلِم","مَن شاتَمَ الناسَ شُتِم",43,"م",1,1],["مُنسَرِحٌ فيهِ يُضرَبُ المَثَلُ","مُستَفعِلُن فاعِلاتٌ مُفتَعِلُ",44,"ل",1,0],["مِن سُبِّقٍ لا يَرى سَوطٌ لَها سَمَلاً","وَلا جَديدٌ مِنَ الأَرسانِ وَاللُجُمِ",45,"م",1,0],["من سقى يوماً بماء ظامئاً","فأنا من قدح العمر سقيته",46,"ه",1,0],["مَن سَلّمَ الأمرَ للإله نجا","ومن عدا القصد واقعَ الهلكه",47,"ك",2,0],["من سالَمَ الضعفاءَ راموا حرْبَهُ","فالبسْ لكلّ الناسِ شِكّةَ محرَبِ",48,"ب",1,0],["من سادةٍ أخلاقُهُمْ وحلومُهُمْ","تتعرّضانِ بسائطاً وجبالا",49,"ل",2,0],["مِن سَجايا الطُلولِ أَلّا تُجيبا","فَصَوابٌ مِن مُقلَةٍ أَن تَصوبا",50,"ب",2,1],["مَنْ سمعْ لفظَها تراهُ","ك