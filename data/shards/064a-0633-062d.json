{"poems":[[53,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[47,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[47,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[46,"كانت صروف الزمان من فرقك","https://www.aldiwan.net/poem30398.html","المنسرح"],[33,"قل للمليحة قد أبلتني الذكر","https://www.aldiwan.net/poem42546.html","البسيط"],[33,"وكم من قتيل لا يباء به دم","https://www.aldiwan.net/poem42659.html","الطويل"],[33,"وَكَمْ مِنْ قَتِيلٍ لا يُباءُ بِهِ دَمٌ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18744&r=&rc=7",""],[226,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[303,"ساجع حن إلى ذات جناح","https://www.aldiwan.net/poem36843.html","عموديه"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[463,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[466,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[466,"يسح نواله من غير شيم","https://www.aldiwan.net/poem16159.html","الوافر"],[469,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[505,"ألا يا ابن عم المصطفى لحظة لمن","https://www.aldiwan.net/poem37668.html","الطويل"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[556,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132443","المتقارب"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216906","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96754","المتدارك"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96612","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64895","البسيط"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6763","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48956","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69373","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109452","البسيط"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18051","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65960","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65979","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34609","المنسرح"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59482","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97076","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81687","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83183","الخفيف"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[5111,"غَسَقُ الليْلِ","https://www.poetsgate.com/ViewPoem.aspx?id=212394",""],[5351,"الشعب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=202103",""],[5751,"بينَ موتٍ وموت","https://www.poetsgate.com/ViewPoem.aspx?id=214771",""],[5829,"عرس حلب","https://www.poetsgate.com/ViewPoem.aspx?id=210425",""],[5989,"عتا الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=181563",""],[5997,"بيّاع الأضاحي","https://www.poetsgate.com/ViewPoem.aspx?id=215045",""]],"verses":[["يسحَبْنَ أو يوكينَ إيكاء العُككْ","إذا رأينَ الحادرَ العبل المِصَكْ",0,"ك",1,0],["يَسُحُّ تُرابُهُ أَبَداً عَلَيها","عِهاداً مِن مُراقِ دَمٍ صَبيبِ",1,"ب",1,0],["يَسُحُّ عَطاؤُهُ فينا فَيُغني","عَنِ القَلبِ النَوازِحِ وَالسَواني",2,"ن",2,0],["يَسُحُّ سَحّاً عَلَيكَ حَتّى يُرى","خَلقُكَ فيها أَصَحَّ مِن خُلُقِك",3,"ك",1,0],["يَسحَبنَ خَلفي ذُيولَ الخَزِّ آوِنَةً","وَناعِمَ العَصبِ كَيلا يُعرَفَ الأَثَرُ",4,"ر",1,0],["يُسَحِّبنَ أَذيالَ المُروطِ بِأَسوُقٍ","خِدالٍ وَأَعجازٍ مَآكِمُها رِوى",5,"ا",1,0],["يُسَحِّبْنَ أَذْيَالَ المُرُوطِ بِأَسْوَاقٍ","خدالٍ، وأعجازٍ مآكمها روى",6,"ا",1,0],["يسحرك الصبح إن سفر","والليل فيها اذا اعتكر",7,"ر",1,0],["يسحبُ الذَيْلَ وَيُرخي طرفاً","من جناحيه مُدِلاًّ كالوشاحِ",8,"ح",1,0],["يَسُحُّ رَوايا فَهوَ دانٍ يَثُجُّها","هَرِيتُ العَزالي كُلُّها مُتَبَعِّقُ",9,"ق",1,0],["يَسحَبُ ناديكم بها ال","حُلَّةَ بعد الحُلَّهْ",10,"ل",2,0],["يَسْحَنْفرُ العلَقُ القاني ويُعْجله","إلى الحضيض مسيح العذر واللُّجم",11,"م",1,0],["يسُحُّ نوالُهُ من غير شَيْمٍ","إذا ما أخْلَفَ الجَوْنُ الرُّكامُ",12,"م",1,1],["يسحُّ بشهدٍ في مواليهِ مجتنى","مباحٍ وسمٍ في أعاديه ناقع",13,"ع",1,0],["يسح ويبسم طبعَ الغمام","فيجمع ما بين حسنى وحسن",14,"ن",1,0],["يسحُُّ عليهم بكشرةً وعشيةً","من الرفرفِ القدسي سحَّ السحائبِ",15,"ب",1,0],["يسحب ذيل السحب فيها وابل","ترخى على وجه الثرى أستاره",16,"ر",2,0],["يسحبن أذيالَ الشّفوفِ غوانياً","بالحُسنِ عن حَسَنٍ بكلِّ شُفوفِ",17,"ف",1,0],["يسحُّ به للندى حاجبٌ","إذا جاءه الضيفُ لا يُحجبُ",18,"ب",1,0],["يَسْحَبُ اللّيلُ نُجُوماً طلّعاً","وتواليها بَطيئاتُ التّبَعْ",19,"ع",1,1],["يسحر العقل باللَّحظ منه فهل","لحظه كان بالسِّحر مكتحلا",20,"ل",2,0],["يسحّ ويهمي مستهلّاً كأنّما","أَكفّ فلاح قَد حَوتها سحائِبُه",21,"ب",2,0],["يسُحُّ مالاً إِذا سَحَّ الغَمامُ لَنا","ماءً فما اتَّفَقَا جُوداً ولا افْتَرَقَا",22,"ق",2,0],["يُسحَبُ في النارِ عَلى وَجهِهِ","بِسابِقِ الحُكمِ مِنَ اللَهِ",23,"ل",2,0],["يسحبنَ أردان الدّ","لال على الأَصاغر والأَكابر",24,"ر",1,0],["يَسِحُّ شِمالِيَّ المُصَلّى فَيَستَوي","بِما سَحَّ مِنهُ خَلفُهُ وَأَمامُهُ",25,"م",2,0],["يسح غيث الرضا من فوق تربته","كغيث دمع من الأجفان مدرار",26,"ر",1,0],["يَسُحّانِ ماءَ البِئرِ عَن ظَهرِ شارِفٍ","بِأَمراسِ كَتّانٍ وَقِدٍّ مُوَصَّلِ",27,"ل",1,0],["يسحبن بين مصاريع الخيام معاً","في العبقري ذيول السندس الزهر",28,"ر",1,0],["يسحبن ثم ذيول الخز في فرش","من عبقر وزراّ بي ومن حلل",29,"ل",1,0],["يسحبها رفيقها الرباني","وكان اسمُ عمِّها حيينا",30,"ن",2,0],["يسحبُ ذيلَ القميصِ صعترَه","ووارداتٍ من هُدبِ مئزرهِ",31,"ر",2,0],["يَسحُّ انسلالَ السمع في ظل أغضفِ","يُطحطح فيه غَيمُة وغياِطلهْ",32,"ل",2,0],["يَسحَقُها بِرائِعِ الأَنيابِ في","كِناسِها سَحقاً بِلا تَكَلُّفِ",33,"ف",1,0],["يسحبن أذيالاً تعالى شأنها","عن غير هدي أو جليل وقار",34,"ر",1,0],["يسحُّ عليهم كلَّ يومٍ وليلةٍ","وليٌّ وَوَسْميٌّ من الجود ساكب",35,"ب",1,0],["يَسحَرُ السامِعينَ بِالمَنطِق العَذ","بِ وَيَغذُو الأَلبابَ مِن مَغزاهُ",36,"ا",2,0],["يَسحَبُ اللَيلُ نُجوماً ظُلَّعا","فَتَواليها بَطيئاتُ التَبَع",37,"ع",1,0],["يسح لها وبل من النبل لم تزل","قلوب العدى منه ترش وترشق",38,"ق",1,0],["يسْحقُ الوهمُ ويُذْرَى في بِحَارٍ","يُجْرَفُ الغَرْقَدُ ، يُجْتَثُّ اقتلاعَا",39,"ع",2,0],["يسحق الطغيان يرميه إلى","آخر المجهول ملعوناً دجاه",40,"ا",2,0],["يَسحبُ البحرَ للبساتينِ خمرًا","والليالي لأعينِ النهرِ كُحلا",41,"ل",2,0],["يسحق الارهاب في آجامه","يضرم الارجاء يصليها لهب",42,"ب",1,0],["يسحق العشاق في طياته","لانتهاش القلب أظفارٌ وفمْ",43,"م",1,0],["يسحقُ الأزْهار في خف الأسى","في خطاباتٍ أراها واهيه",44,"ي",2,0]]}