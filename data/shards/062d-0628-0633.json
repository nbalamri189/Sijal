?id=186716",""],[4866,"حبست جرحي","https://www.poetsgate.com/ViewPoem.aspx?id=177694",""],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[5122,"الدرة اللي تلبس اللماسي","https://www.poetsgate.com/ViewPoem.aspx?id=27279",""],[5409,"شهد الليل غارة للغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=155312",""],[5409,"بنفسي التي ذكرت خلها","https://www.poetsgate.com/ViewPoem.aspx?id=155501",""],[482,"حرامٌ على الجفنِ القريحِ منامُه","https://www.poetsgate.com/ViewPoem.aspx?id=111412",""],[5612,"هِيَ سِكَّةٌ للشَّوْق","https://www.poetsgate.com/ViewPoem.aspx?id=186956",""],[5725,"عرس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177970",""],[5804,"كورونا والحدود","https://www.poetsgate.com/ViewPoem.aspx?id=214739",""],[5970,"حبست نفسي على العلياء أطلبها","https://www.poetsgate.com/ViewPoem.aspx?id=130658",""],[463,"أخلقَ الدهرُ لمتي وأجدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60027&r=&rc=83",""]],"verses":[["حَبَسَ الأَورادَ بِالغُل","لَةِ وَالحَيُّ قِيامُ",0,"م",1,0],["حُبِسَ القَطرُ بِأَرضي","وَأَرى الجَوَّ يُغامُ",0,"م",1,0],["حَبَستُ مَقالي مَحبَسَ البُدنِ أَبتَغي","بِهِ عِوَضاً جَمّاً وَلَيسَ يُرادُ",1,"د",1,0],["حَبَستُ بِهِ قَلباً جَرِيّاً عَلى الرَدى","وَقَد رَجَفَت تَحتَ الصُدورِ قُلوبُ",2,"ب",1,0],["حَبَسْتُ بها العِيسَ المَراسيلَ أجْتَلي","على مُنْحَنى الوادي عُيونَ صِوارِهِ",3,"ر",2,0],["حُبُّ سِحرٍ شاهِدي إِن شَهِدَت","وَإِذا ما هِيَ غابَت لَم يَغِب",4,"ب",1,0],["حبَسْتُ بِها ركْبي فُواقاً وإنّما","عقَدْتُ على قلْبي لَها عقْدَ تَحْبيسِ",5,"س",1,0],["حَبَسَ اللِسانَ وَأَطلَقَ الدَمعا","ناعٍ أَصَمَّ بِنَعيِكَ السَمعا",6,"ع",2,1],["حَبَسَ الخَطبُ فيكَ أَلسِنَةَ القَو","لِ وَأَعيا قَريحَةَ العَبقَرِيِّ",7,"ي",1,0],["حبس الخصر حيث ضاق ولكن","أطلق النحر بادياً والتريبا",8,"ب",2,0],["حبّست أغزالي على حسنها","فيا له ديوان أحباس",9,"س",1,0],["حبست لضيق الرزق حبس حمامة","فها أنا فيكم بالمدائح أسجع",10,"ع",1,0],["حبس الغيَّ عن وفاه يراعى","بثلاثٍ كأنه مخنوق",11,"ق",1,0],["حبسوه لا بجريمةٍ لكنهم","بخلوا على لحظ العيون بحسنه",12,"ن",2,1],["حبستْنا السماءُ حبساً كريماً","من كريمٍ وعِندَ حُرٍّ كريمِ",13,"م",1,1],["حبَسْتَ أخاً في سجن هَمٍّ وما جَنَى","فأطْلِقْهُ بالإعتاب من ذلك السجن",14,"ن",1,0],["حَبَستُ بِهِ عَلى المَكروهِ نَفسي","وَلَيسَ يَقومُهُ إِلّا قَليلُ",15,"ل",1,0],["حَبَسوا المَطِيَّ عَلى قَديمٍ عَهدُهُ","طامٍ يَعينُ وَمُظلِمٌ مَسدومُ",16,"م",1,0],["حُبِسَت في دَنِّها مِن قَدَمٍ","ما لَها ذَنبٌ وَلَكِن ظَلَموا",17,"م",3,0],["حبسته عن لذاته اوهامه","فهو السجين النكد والسجان",18,"ن",1,0],["حبست يتامى دمعها وأرامل","لما تنقل في القرى البشراء",19,"ا",2,0],["حَبَستُ القَوافي عَنكَ وَهيَ نَوازِعٌ","تُجاذِبُ مِن شَوقٍ إِلَيكَ كُبولَها",20,"ل",3,0],["حَبَسوا اِبنَ قَيصَرَ وَاِبتَنوا بِرِماحِهِم","يَومَ الكُلابِ كَأَكرَمَ البُنيانِ",21,"ن",1,0],["حُبِسَ اللَهوُ وَالسُرورُ فَما في ال","أَرضِ شَيءٌ يُلهى بِهِ أَو يَسُرُّ",22,"ر",1,0],["حبستها قرب عيوني","إن أشَأ نظرتها",23,"ت",3,0],["حَبَستُ هذا الصوتَ لم ينطلق","إِلا على حزنكِ أو فرحتك",24,"ك",1,0],["حُبِستَ فَاِحتَبَسَت مِن أَجلِكَ الدِيَمُ","وَلَم يَزَل نابِياً عَن صَحبِكَ العَدَمُ",25,"م",1,1],["حُبِسَتْ بِأَكْلَفَ لَمْ يَصِلْ لِفِنَائِهِ","نُورٌ وَلَمْ يَسْرَحْ عَلَيْهِ ظَلامُ",26,"م",1,0],["حُبِسَتْ بِأَكْلَفَ لَمْ يَقُمْ بِفِنَائِهِ","نُورٌ وَلَمْ يَبْرَحْ عَلَيْهِ ظَلامُ",27,"م",1,0],["حَبَسَ الفيلَ حَتى","ظَلَّ يَحبو كَأَنَهُ مَعقورُ",28,"ر",1,0],["حَبَسَت مَناكِبُها السَفى فَكَأَنَّها","رُفَةٌ بِناحِيَةِ المَداوِسِ مُسنَدُ",29,"د",1,0],["حُبِسَت صُهارَتُهُ فَظَلَّ عُثانُهُ","في سَيطَلٍ كُفِئَت لَهُ يَتَرَدَّدُ",29,"د",1,0],["حَبَستِ هَداكِ اللَهُ قَلبي لِحَقِّهِ","وَتَقضي نِساءٌ ما لَهُنَّ قَليلُ",30,"ل",1,0],["حَبَستُ بِها لَحظي وَأَطلَقتُ عَبرَتي","وَما كانَ لي في الصَبرِ لَو كانَ لي عُذرُ",31,"ر",1,0],["حُبِسَت وَلَم تَرَ غَيرَها في دَنِّها","فَتَقَصَّرَت مِن نَقشِها وَتَخَلَّتِ",32,"ت",1,0],["حَبَستَ لي الخاتَمَ مِنّي وَقَد","سَلَبتَني إِيّاهُ مُذ أَشهُرِ",33,"ر",1,0],["حَبَستُ بِها صَحبي فَجَدَّدتُ عَهدَهُم","وَإِنّي عَلى أَمثالِ تِلكَ لَحابِسُ",34,"س",1,0],["حُبِسَت لِلشُراةِ في بَيتِ رَأسٍ","عُتِّقَت عانِساً عَلَيها الخِتامُ",35,"م",1,0],["حَبَستُ عَلَيكَ النَفسَ حَولَينِ لا أَرى","نَوالاً وَلا وَعداً بِنَيلٍ مُعَقَّبِ",36,"ب",1,0],["حَبَسَتكَ أَقدارٌ ذَوَتكَ عَنِ المُنى","فَمَضى الصِحابُ وَأَنتَ ثاوٍ حابِسُ",37,"س",1,0],["حَبَستَ كِتابَ العَينِ في كُلِّ وُجهَةٍ","فَخُذ حَذَراً مِن تَرجُمانِ المُفَجَّعِ",38,"ع",1,1],["حُبُسٌ في المَحلِ حَتّى يُفسِحوا","لِاِبتِغاءِ المَجدِ أَو تَركِ الفَنَد",39,"د",1,0],["حَبَستُ فيها صِحابي كَي أُسائِلَها","وَالدَمعُ قَد بَلَّ مِنّي جَيبَ سِربالي",40,"ل",2,0],["حبس المانعون خيرك عنا","وسكتنا كأننا أموات",41,"ت",1,0],["حَبَسْتُ بها عَدْواً زِمَامَ مَطِيَّتِى","فَحَلَّتْ بها عَيْنِي عليَّ وِكاءَهَا",42,"ا",3,0],["حُبِسَتْ عَنِ الأَبْصَارِ حَتَّى أَنَّهَا","لَمْ تَدْرِ غَيْرَ الدَّيْرِ وَالشَّمَّاسِ",43,"س",1,0],["حَبسْتَ عَلَى الْوَظِيفَةِ مِنْكَ نُوراً","تَفَقَّدَهُ الْحِمَى وَاللَّيْلُ غاشِ",44,"ش",1,1],["حَبَسُوهُ عنْ مُقَلٍ إِلَيْهِ مَشوقَةٍ","فَاضَت أَسىً وَدُمُوعُهُنَّ غَوَالِ",45,"ل",1,0],["حبسوا الماء عن شفاه اليتامى","وأراقوه في شفاه الغواني",46,"ن",2,0],["حبسُوكَ في قفصٍ، ولست بضيغمٍ","لكن نزلتَ به نُزُول المجرمِ",47,"م",1,1],["حبست في ضنك ووحشة طبع","فتمنت ان لا يحول عناها",48,"ا",3,0],["حبست الكأس عنا أم عمرو","وامني كأس برك في يميني",49,"ن",2,0],["حبستُ لساني بين شِدْقَيَّ مُرغماً","على أنه ماضي الشَّبا إذ يناضل",50,"ل",1,0],["حبست مياه الرّافدين وحلاّت","عن ورد دجلة لخمها وإيادها",51,"د",3,0],["حَبَسَتْ مَنَاكِبُها السَّفَى ، فَكَأَنَّهُ","رُفَة ٌ بِنَاحِيَة ِ المَدَاوسِ مُسْنَدُ",52,"د",1,0],["حبسَ الخضرَ حيث ضاق ولكن","من تزيا به، وفي الطيب طيبا",53,"ب",2,0],["حب سلمان حين صح لأهل ال","بيت ذي المنصب العزيز المثنى",54,"ن",2,1],["حبست سماؤك عنه صيبها","فتسول الفضلات والسؤرا",55,"ر",2,0],["حَبَستُ عَلَيكَ الظَنَّ وَالشِعرَ فِعلَ مَن","يَرى النيلَ إِلّا مِن يَدَيكَ مُحَرَّما",56,"م",2,0],["حَبَسَت رِكابي عَن ذَراكَ عَوائِقٌ","يَحيا الغَنِيُّ بِها حَياةَ المُعدِمِ",57,"م",1,0],["حَبَستُ عَلَيهِ رأسَ مالِ مَدائِحي","لِعِلمي بإِضعافِ المَثوبَةِ في الرِبحِ",58,"ح",1,0],["حبسَ الإِلهُ العلمَ حتى قتّلوا","وتسابق الخبران كي لا تأسفا",59,"ف",2,0],["حَبَست لَمِيسُ بِناءَهُ وَغِراسَهُ","فَغَدا لَها فَردوسُ برٍّ مُثمِرا",60,"ر",2,0],["حبست نار حشاه","على غرير ملول",61,"ل",1,0],["حبست وقد حشاه","على غرير ملول",62,"ل",1,0],["حُبِستِ على رحماتِ الرَحيم","وَجادَكِ رِضوانهُ الصَيِّب",63,"ب",1,0],["حَبَّسَهُ أَهْلُنَا عَلَى ضَعِيفِهِمُ","فَكُنْتَ أَوْلَى بِهِ فِي حُكْمِ ذِي نَفَسِ",64,"س",1,0],["حَبَسْتُ الْقَوافِي قَبْلَ إِغْضابِ رَبِّها","وَما لِلْقَوافِي بَعْدَ إِغْضابِها حَبْسُ",65,"س",1,0],["حُبِسَ المِسكُ بِالمُسوكِ سَحيقاً","فَعَسى السُؤلُ يُرسِلُ المَحبوسا",66,"س",2,0],["حَبَستُ رُكابَ الفَيرَزانِ وَجَمعَهُ","عَلى فَتَرٍ مِن حَرِّها غَيرِ فاتِرِ",67,"ر",1,0],["حَبَسْتهُ أَنملُكَ الكرامُ عنِ الخَنا","وَسَعَى إلى الحَسَناتِ وَهْوَ طَلِيقُ",68,"ق",1,0],["حَبست روحي بِسجن البُعد عَنك فَهَل","هَذا مَتاع لِحَولٍ غَير إِخراجِ",69,"ج",1,0],["حَبَستُ سَراتَهم بالضِحِّ حتى","أنابُوا بعد إِبراقٍ وَرَعدِ",70,"د",1,0],["حُبِسْتُ ومن بَعدِ الكُسوفِ تَبَلُّجٌ","تُضئُ بهِ الآفاق للبَدرِ والشَّمسِ",71,"س",1,0],["حبسوك والطير النواطق إنما","حبست لميزتها على الأنداد",72,"د",1,1],["حَبَسْتِ بعينيك هذي الدُّموع","تريدين يا ناقُ إرسالَها",73,"ل",3,0],["حبستُ بها المطيَّ فقال صحبي","أَضرَّ بهذه النُّوق المقامُ",74,"م",1,0],["حَبَسْتُ بها صَحْباً كأَنَّ قلوبهم","من الشَّوق في تلك المنازل تُخْلَعُ",75,"ع",1,0],["حبٌّ سماعيٌّ بدا وتعشقُ","الآذان قبل تعشق الأحداقِ",76,"ق",1,0],["حبسنا عن مراتعها نفوساً","تَعزّى بالمواعيد الكذاب",77,"ب",1,0],["حبسا ولو زادك من مضمضةٍ","بَينَ الغِرارِ خائفا والوسنِ",78,"ن",1,0],["حبسنا العيشَ منه على بخيلٍ","نؤمِّلُ عندَه جدوَى الكريمِ",79,"م",1,0],["حُبِستُ ولكن كان حبساً مشرِّفاً","أناف بذكري واعتقالا مُجمِّلا",80,"ل",2,0],["حُبستَ وأيّام الملوكِ كذاكا","تكون إِساراً مرّة وفَكاكا",81,"ك",2,1],["حَبستُ به أبغي الحياة لقاتلي","غراماً وأدعو بالشفاء لممرضي",82,"ض",2,0],["حبساً ولو ساعةً تروَى بها مقلٌ","هِيمٌ وأنت عليها الدهرَ مشكورُ",83,"ر",1,0],["حَبَسَ الناسَ أن يُجاروك في السؤ","دُدِ تعريجُهم وسَيْرُك قَصدا",84,"د",2,0],["حَبستُ عنانِيَ مستبصرا","بأيّةِ يستبقون الذُّنوبا",85,"ب",2,0],["حبست