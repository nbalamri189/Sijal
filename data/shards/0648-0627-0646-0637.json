{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[53,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[63,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[63,"إذا زم للبين الغداة جمال","https://www.aldiwan.net/poem46158.html","الطويل"],[63,"ألا بأبي كعب خليلا وصاحبا","https://www.aldiwan.net/poem46163.html","الطويل"],[3,"طربت وهاجني البرق اليماني","https://www.aldiwan.net/poem220.html",""],[57,"وأنطقت الدراهم بعد صمت","https://www.aldiwan.net/poem24717.html","الوافر"],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[86,"رحم الله صاحب النظرات","https://www.aldiwan.net/poem10351.html","الخفيف"],[86,"رياض أفق من غمرة الموت واستمع","https://www.aldiwan.net/poem10488.html","الطويل"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[86,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[35,"وقفت عليه ناقتي فتناعت","https://www.aldiwan.net/poem38814.html","الطويل"],[35,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[35,"أشاقك برق آخر الليل واصب","https://www.aldiwan.net/poem39619.html","الطويل"],[54,"وما المرء إلا الأصغران لسانه","https://www.aldiwan.net/poem27400.html","الطويل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"سأبدي لدهري ناج المتضحك","https://www.aldiwan.net/poem45011.html","الطويل"],[47,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[72,"دعاه لذكر الحمى مذهب","https://www.aldiwan.net/poem18271.html","المتقارب"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[51,"ما الشكر مني لما أوليتني ثمنا","https://www.aldiwan.net/poem66514.html","البسيط"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[43,"أراع كذا كل الملوك همام","https://www.aldiwan.net/poem10525.html","الطويل"],[49,"لقد طال يا دنيا إليك ركوني","https://www.aldiwan.net/poem63125.html","الطويل"],[97,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[74,"أيها التائه مهلا","https://www.aldiwan.net/poem13210.html","مجزوء الرمل"],[105,"عيد الفداء جرى باليمن طائره","https://www.aldiwan.net/poem42105.html","البسيط"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[40,"عوجي علينا ربة الهودج","https://www.aldiwan.net/poem42341.html","السريع"],[22,"ألا من لقلب عارم النظرات","https://www.aldiwan.net/poem21659.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[46,"نفوس للقيامة تشرئب","https://www.aldiwan.net/poem22091.html","الوافر"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"أوى ربي إلي فما وقوفي","https://www.aldiwan.net/poem22692.html","الوافر"],[46,"أوالي هذا المصر في زي واحد","https://www.aldiwan.net/poem23213.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85482","المجتث"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142345","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[22,"أَلا مَنْ لِقَلْبٍ عارِمِ النّظراتِ","https://www.poetsgate.com/ViewPoem.aspx?id=18935",""],[100,"حيث التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=50147",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[99,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""]],"verses":[["وَإِن طَلَبَ الذُحولَ تَهَضَّمَتهُ","وَباعَ دَمَ الفَوارِسِ بِاللِبانِ",0,"ن",1,0],["وَإِنَّ طَريقي بِالمَناسِمِ فاضِحي","إِذا لَم تَسِر فيهِ الصَبا بِذُيولِ",1,"ل",1,0],["وَإِنَّ طِرادَ النَفسِ عَمّا تَرومُهُ","أَشَدُّ عَناءً مِن طِرادِ قَتيلِ",1,"ل",1,0],["وَإِن طَرَقَ القَومُ العَبوسُ تَهَلَّلوا","وَإِن مالَتِ السُمرُ الذَوابِلُ مالوا",2,"ل",3,0],["وَإِن طالَت بِها أَيدي الأَماني","فَلا اِمتَدَّت يَدُ الوَعدِ القَصيرِ",3,"ر",1,0],["وَإِن طَلَبَ النَدى خَرَجَت يَداهُ","خُروجَ الوَدقِ مِن خَلَلِ الغَماءِ",4,"ا",2,0],["وإنْ طَرَقَ الأعْداءَ أقْمرَ لَيْلُهُمْ","بهِ وأَديمُ الأرْضِ بالدَّمِ وارِسُ",5,"س",1,0],["وإنْ طَرَقَ الأعْداءَ واللّيلُ مُظْلِمٌ","أطَلَّتْ علَيهمْ بالصّباحِ نِصالُ",6,"ل",1,0],["وإنْ طاشَ حَرْبٌ كَفَّ بالحِلْمِ غَرْبَها","وأهْوى بنيرانٍ إِلى السِّلْمِ بُوَّخِ",7,"خ",1,0],["وَإِن طَرِبَ الرِجالُ بِشُربِ خَمرٍ","وَغَيَّبَ رُشدَهُم خَمرُ الدِنانِ",8,"ن",1,0],["وَأَنطَقَتِ الدَراهِمُ بَعدَ صَمتٍ","أُناساً بَعدَما كانوا سُكوتا",9,"ت",2,1],["وَإِنْ طَلَبَ الصَّعْبَ الْمُمَنَّعَ نَالَهُ","بمُدْرَكَةِ الأَقْصَى وَمَنْزِلِةِ الْعُصْمِ",10,"م",1,0],["وَاِنطَوَت رِقَّةُ الشُعورِ وَكانَت","سَلوَةَ البائِسينَ وَالبائِساتِ",11,"ت",1,0],["وَإِن طَلَعَت في مِصرَ شَمسُ نَباهَةٍ","فَمِن بَيتِكَ المَعمورِ تَبدو وَتَطلُعُ",12,"ع",1,0],["وَإِن طَلَبتَ مَزيداً","فَفي مُناجاةِ خِدنِ",13,"ن",1,0],["وَإِن طالَعَتها ذُكاءُ الصَباحِ","أَرَتكَ اللُجَينَ بِأَنهارِها",14,"ر",3,0],["وَإِن طَنَّتِ الأُذنانِ قُلتُ ذَكَرتِني","وَإِن خَلَجَت عَيني رَجَوتُ التَلاقِيا",15,"ي",2,0],["وَإِن طُوِيَت من دونِهِ الأَرضُ وَاِنبَرى","لَنُكبِ الرِياحِ وَفيُها وَحَفيرُها",16,"ر",3,0],["وَإِنَّ طِلابي عانِسًا أُمَّ وَلدةٍ","لَممّا تُمَنِّيني النُفوسُ الكَواذِبُ",17,"ب",1,0],["وَإِن طُرَّةٌ راقَتكَ فَاِنظُر فَرُبَّما","أَمَرَّ مَذاقُ العودِ وَالعودُ أَخضَرُ",18,"ر",1,0],["وإن طلبت زُهرُ النجوم لَحَاقَهُ","فمن دون ما تبغي المدى المتطاولُ",19,"ل",1,0],["وإن طَوَتِ البُرْدَ اليماني يدُ البلى","فقد نُشِرَ البُردُ الجديدُ المُفَوَّفُ",20,"ف",1,0],["وأن طبيب القوم ناصب كفّة","ليصطاد فيها بالدواء الممصطك",21,"ك",1,0],["وَإِن طُرِقَت بِداهِيَةٍ نَآدٍ","تُدافِعُها الرِجالُ بِكُلِّ جارِ",22,"ر",1,0],["وإن طمعت في ليالي الحمى","منايَ فكم قد فشا أشعب",23,"ب",1,0],["وإن طلب الأعداء راع جيادهم","فذو السبق في تمحيله كالمقيد",24,"د",1,0],["وانْطوى مبسم العلوم وأغضت","مقلة البحث دونها والجدال",25,"ل",1,0],["وإن طوى وطنٌ حبّاً لنُجْعتِه","كنتم لآمالِ أهلِ النُّجعةِ الوطنا",26,"ن",2,0],["وَاِنطَوى رَونَقُ الصِبا","مِثلَ بَرقٍ بِفَدفَدِ",27,"د",1,0],["وَاِنطَوَينا في مَوكِبٍ مِن ضِياءٍ","وَسَطَعنا في غَمرَةٍ مِن دُخانِ",28,"ن",1,0],["وَإِن طالَ أَعمارُ الرِماحِ بِهُدنَةٍ","فَإِنَّ الَّذي يَعمَرنَ عِندَكَ عامُ",29,"م",1,0],["وَإِن طَرَقَتني نَكبَةٌ فَكِهوا بِها","وَإِن صَحِبَتني نِعمَةٌ حَسَدوني",30,"ن",2,0],["وإن طُوِيَ البساطُ فنصبَ عيني","عليكِ خيالُ أحبائي القدامى",31,"م",2,0],["وإن طاحَ الزمانُ بكأس حبي","فلا الساقي نسيتُ ولا الندامى",31,"م",2,0],["وَاِنطَوى الحُسنُ فَهَلّا","أَجمَلَ الحُسنُ وَهَلّا",32,"ل",2,0],["وإن طَوَى مِن حَديثِ الغَيبِ ما حَمَلْت","صُحفُ الزّمانِ طَوَى الآفاقَ نَاشِرُهُ",33,"ر",2,0],["وإن طلبوا العَوانَ بعثتموها","وسِرتم باللّواءِ مُظفَّرينا",34,"ن",2,0],["وإن طَمحَ الرّجالُ إلى حياةٍ","فَغُضَّ الطَّرفَ بين الطّامحينا",34,"ن",2,0],["وَاِنطَوى العاصفُ وَالمَوج لَهُ","فَاِكتَسى البَحرُ غَضونَ الجَدولِ",35,"ل",1,0],["وَاِنطَلَقَت تَهوى بِها بَغلَةٌ","في بَغلاتٍ وُقُحٍ وَسَّجِ",36,"ج",1,0],["وَإِن طافَ فيها الحالِبانِ اِتَّقَتهُما","بِجوفٍ عَلى أَيديهِما هَمِراتِ",37,"ت",1,0],["وانْطَوَتْ في الصُّدُورِ حاجاتُ نفسٍ","ما لها عَنْ نَدَى يَدَيْكَ انْطِوَاءُ",38,"ا",2,0],["وَإنَّ طالِعَها مِنَّا وَغَارِبَها","جِيلٌ يَمُرُّ وَيَأتي بَعْدَهُ جِيلُ",39,"ل",1,0],["وإنْ طالَ عمرٌ في نَعيمٍ وغِبطَةٍ","فما هوَ إلاّ من يَمينكَ موْهوب",40,"ب",1,0],["وَإِن طالَ الرُقادُ مِنَ البَرايا","فَإِنَّ الراقِدينَ لَهُم مَهَبُّ",41,"ب",1,0],["وَإِن طاوَعنَ أَمرَكَ فَإِنَّهُ غِيداً","يُزِرنَ عَرائِساً مُتَيِمِّماتِ",42,"ت",1,0],["وَإِنَّ طَوارَ ذاكَ الرَبعِ أَودى","بِرَبرَبَ أَهلِهِ نوبٌ طَواري",43,"ي",1,0],["وَإِنَّ طَوالَ الدَهرِ صَيَّرَ أَينُقي","رَذايا وَجَربى ما لَهُنَّ طَوالِ",44,"ل",1,0],["وإن طريق المجد في كل بقعة","قَريب على من سار لكنه وعر",45,"ر",1,0],["وإن طرفاً يَرى وج","هَ من أحب قَرير",46,"ر",1,0],["وإِنْ طَال ذِكْرِي بالمُجُونِ فإِنَّهَا","عَظائِمُ لم يصْبِرْ لهُنَّ جلِيدُ",47,"د",1,0],["وَأَنْطَقْتُ قَلْبِي بِمَا صَانَهُ","زَمَاناً فَلَمْ يَبْتَذِلهُ الفَمُ",48,"م",1,0],["وانطلق مثل النسيم المرسل","ترتجي أن تصبح الكف وأن",49,"ن",1,0],["وانطلاق النور حتى يرتوي","كل جفن بالثرى مختضب",50,"ب",1,0],["وانطوَى مجلسُ الصحابِ بمن في","ه وما فيه من أمانٍ لِدان",51,"ن",1,0],["وَإن طُرِفتْ عينٌ ببغدادَ من قذىً","رأيتَ بمصرٍ أعيناً مُلِئتْ سُهدا",52,"د",2,0],["وانطقِي ينثْر إذَا حدّثتِنا","لفظُك العذبُ عن القلبِ العنَاء",53,"ا",2,0],["وإنْ طَارَ فيها الحَالِبَانَ اتَّقَتْهُمَا","بجُوفٍ على أيْدِيهِما هَمِرَاتِ",54,"ت",1,0],["وانطفا فجر أمانينا ولم","ينطف الشوق ولم يخب الضرام",55,"م",1,0],["وان طُوِيت على دَغَلٍ قلوبٌ","فقد أُعطِيتَ ألسنةً رطابا",56,"ب",2,0],["وإن طننت نحلةُ في الفراغ","تطن مع النحل قُبلاتُنا",57,"ن",2,0]]}