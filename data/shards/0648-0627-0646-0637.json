"الوافر"],[456,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[456,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[456,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[462,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[462,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[493,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[498,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[498,"أجل نظرا في الكائنات ترى العجب","https://www.aldiwan.net/poem37679.html","الطويل"],[498,"أطلق الصب في الهوى تقييده","https://www.aldiwan.net/poem37687.html","الخفيف"],[498,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[498,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[498,"ما طوى الركب شقة الأرض يوما","https://www.aldiwan.net/poem38090.html","الخفيف"],[502,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[513,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[513,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[549,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[556,"نحن في وادي وغيب الغيب في وادي عميق","https://www.aldiwan.net/poem34310.html","الرمل"],[556,"وجود كوني من تجلي الجواد","https://www.aldiwan.net/poem34632.html","السريع"],[556,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[557,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"]],"verses":[["وَإِن طَلَبَ الذُحولَ تَهَضَّمَتهُ","وَباعَ دَمَ الفَوارِسِ بِاللِبانِ",0,"ن",1,0],["وَإِنَّ طَريقي بِالمَناسِمِ فاضِحي","إِذا لَم تَسِر فيهِ الصَبا بِذُيولِ",1,"ل",1,0],["وَإِنَّ طِرادَ النَفسِ عَمّا تَرومُهُ","أَشَدُّ عَناءً مِن طِرادِ قَتيلِ",1,"ل",1,0],["وَإِن طَرَقَ القَومُ العَبوسُ تَهَلَّلوا","وَإِن مالَتِ السُمرُ الذَوابِلُ مالوا",2,"ل",3,0],["وَإِن طالَت بِها أَيدي الأَماني","فَلا اِمتَدَّت يَدُ الوَعدِ القَصيرِ",3,"ر",1,0],["وَإِن طَلَبَ النَدى خَرَجَت يَداهُ","خُروجَ الوَدقِ مِن خَلَلِ الغَماءِ",4,"ا",2,0],["وإنْ طَرَقَ الأعْداءَ أقْمرَ لَيْلُهُمْ","بهِ وأَديمُ الأرْضِ بالدَّمِ وارِسُ",5,"س",1,0],["وإنْ طَرَقَ الأعْداءَ واللّيلُ مُظْلِمٌ","أطَلَّتْ علَيهمْ بالصّباحِ نِصالُ",6,"ل",1,0],["وإنْ طاشَ حَرْبٌ كَفَّ بالحِلْمِ غَرْبَها","وأهْوى بنيرانٍ إِلى السِّلْمِ بُوَّخِ",7,"خ",1,0],["وَإِن طَرِبَ الرِجالُ بِشُربِ خَمرٍ","وَغَيَّبَ رُشدَهُم خَمرُ الدِنانِ",8,"ن",1,0],["وَأَنطَقَتِ الدَراهِمُ بَعدَ صَمتٍ","أُناساً بَعدَما كانوا سُكوتا",9,"ت",2,1],["وَإِنْ طَلَبَ الصَّعْبَ الْمُمَنَّعَ نَالَهُ","بمُدْرَكَةِ الأَقْصَى وَمَنْزِلِةِ الْعُصْمِ",10,"م",1,0],["وَاِنطَوَت رِقَّةُ الشُعورِ وَكانَت","سَلوَةَ البائِسينَ وَالبائِساتِ",11,"ت",1,0],["وَإِن طَلَعَت في مِصرَ شَمسُ نَباهَةٍ","فَمِن بَيتِكَ المَعمورِ تَبدو وَتَطلُعُ",12,"ع",1,0],["وَإِن طَلَبتَ مَزيداً","فَفي مُناجاةِ خِدنِ",13,"ن",1,0],["وَإِن طالَعَتها ذُكاءُ الصَباحِ","أَرَتكَ اللُجَينَ بِأَنهارِها",14,"ر",3,0],["وَإِن طَنَّتِ الأُذنانِ قُلتُ ذَكَرتِني","وَإِن خَلَجَت عَيني رَجَوتُ التَلاقِيا",15,"ي",2,0],["وَإِن طُوِيَت من دونِهِ الأَرضُ وَاِنبَرى","لَنُكبِ الرِياحِ وَفيُها وَحَفيرُها",16,"ر",3,0],["وَإِنَّ طِلابي عانِسًا أُمَّ وَلدةٍ","لَممّا تُمَنِّيني النُفوسُ الكَواذِبُ",17,"ب",1,0],["وَإِن طُرَّةٌ راقَتكَ فَاِنظُر فَرُبَّما","أَمَرَّ مَذاقُ العودِ وَالعودُ أَخضَرُ",18,"ر",1,0],["وإن طلبت زُهرُ النجوم لَحَاقَهُ","فمن دون ما تبغي المدى المتطاولُ",19,"ل",1,0],["وإن طَوَتِ البُرْدَ اليماني يدُ البلى","فقد نُشِرَ البُردُ الجديدُ المُفَوَّفُ",20,"ف",1,0],["وأن طبيب القوم ناصب كفّة","ليصطاد فيها بالدواء الممصطك",21,"ك",1,0],["وَإِن طُرِقَت بِداهِيَةٍ نَآدٍ","تُدافِعُها الرِجالُ بِكُلِّ جارِ",22,"ر",1,0],["وإن طمعت في ليالي الحمى","منايَ فكم قد فشا أشعب",23,"ب",1,0],["وإن طلب الأعداء راع جيادهم","فذو السبق في تمحيله كالمقيد",24,"د",1,0],["وانْطوى مبسم العلوم وأغضت","مقلة البحث دونها والجدال",25,"ل",1,0],["وإن طوى وطنٌ حبّاً لنُجْعتِه","كنتم لآمالِ أهلِ النُّجعةِ الوطنا",26,"ن",2,0],["وَاِنطَوى رَونَقُ الصِبا","مِثلَ بَرقٍ بِفَدفَدِ",27,"د",1,0],["وَاِنطَوَينا في مَوكِبٍ مِن ضِياءٍ","وَسَطَعنا في غَمرَةٍ مِن دُخانِ",28,"ن",1,0],["وَإِن طالَ أَعمارُ الرِماحِ بِهُدنَةٍ","فَإِنَّ الَّذي يَعمَرنَ عِندَكَ عامُ",29,"م",1,0],["وَإِن طَرَقَتني نَكبَةٌ فَكِهوا بِها","وَإِن صَحِبَتني نِعمَةٌ حَسَدوني",30,"ن",2,0],["وإن طُوِيَ البساطُ فنصبَ عيني","عليكِ خيالُ أحبائي القدامى",31,"م",2,0],["وإن طاحَ الزمانُ بكأس حبي","فلا الساقي نسيتُ ولا الندامى",31,"م",2,0],["وَاِنطَوى الحُسنُ فَهَلّا","أَجمَلَ الحُسنُ وَهَلّا",32,"ل",2,0],["وإن طَوَى مِن حَديثِ الغَيبِ ما حَمَلْت","صُحفُ الزّمانِ طَوَى الآفاقَ نَاشِرُهُ",33,"ر",2,0],["وإن طلبوا العَوانَ بعثتموها","وسِرتم باللّواءِ مُظفَّرينا",34,"ن",2,0],["وإن طَمحَ الرّجالُ إلى حياةٍ","فَغُضَّ الطَّرفَ بين الطّامحينا",34,"ن",2,0],["وَاِنطَوى العاصفُ وَالمَوج لَهُ","فَاِكتَسى البَحرُ غَضونَ الجَدولِ",35,"ل",1,0],["وَاِنطَلَقَت تَهوى بِها بَغلَةٌ","في بَغلاتٍ وُقُحٍ وَسَّجِ",36,"ج",1,0],["وَإِن طافَ فيها الحالِبانِ اِتَّقَتهُما","بِجوفٍ عَلى أَيديهِما هَمِراتِ",37,"ت",1,0],["وانْطَوَتْ في الصُّدُورِ حاجاتُ نفسٍ","ما لها عَنْ نَدَى يَدَيْكَ انْطِوَاءُ",38,"ا",2,0],["وَإنَّ طالِعَها مِنَّا وَغَارِبَها","جِيلٌ يَمُرُّ وَيَأتي بَعْدَهُ جِيلُ",39,"ل",1,0],["وإنْ طالَ عمرٌ في نَعيمٍ وغِبطَةٍ","فما هوَ إلاّ من يَمينكَ موْهوب",40,"ب",1,0],["وَإِن طالَ الرُقادُ مِنَ البَرايا","فَإِنَّ الراقِدينَ لَهُم مَهَبُّ",41,"ب",1,0],["وَإِن طاوَعنَ أَمرَكَ فَإِنَّهُ غِيداً","يُزِرنَ عَرائِساً مُتَيِمِّماتِ",42,"ت",1,0],["وَإِنَّ طَوارَ ذاكَ الرَبعِ أَودى","بِرَبرَبَ أَهلِهِ نوبٌ طَواري",43,"ي",1,0],["وَإِنَّ طَوالَ الدَهرِ صَيَّرَ أَينُقي","رَذايا وَجَربى ما لَهُنَّ طَوالِ",44,"ل",1,0],["وإن طريق المجد في كل بقعة","قَريب على من سار لكنه وعر",45,"ر",1,0],["وإن طرفاً يَرى وج","هَ من أحب قَرير",46,"ر",1,0],["وإِنْ طَال ذِكْرِي بالمُجُونِ فإِنَّهَا","عَظائِمُ لم يصْبِرْ لهُنَّ جلِيدُ",47,"د",1,0],["وَأَنْطَقْتُ قَلْبِي بِمَا صَانَهُ","زَمَاناً فَلَمْ يَبْتَذِلهُ الفَمُ",48,"م",1,0],["وانطلق مثل النسيم المرسل","ترتجي أن تصبح الكف وأن",49,"ن",1,0],["وانطلاق النور حتى يرتوي","كل جفن بالثرى مختضب",50,"ب",1,0],["وانطوَى مجلسُ الصحابِ بمن في","ه وما فيه من أمانٍ لِدان",51,"ن",1,0],["وَإن طُرِفتْ عينٌ ببغدادَ من قذىً","رأيتَ بمصرٍ أعيناً مُلِئتْ سُهدا",52,"د",2,0],["وانطقِي ينثْر إذَا حدّثتِنا","لفظُك العذبُ عن القلبِ العنَاء",53,"ا",2,0],["وإنْ طَارَ فيها الحَالِبَانَ اتَّقَتْهُمَا","بجُوفٍ على أيْدِيهِما هَمِرَاتِ",54,"ت",1,0],["وانطفا فجر أمانينا ولم","ينطف الشوق ولم يخب الضرام",55,"م",1,0],["وان طُوِيت على دَغَلٍ قلوبٌ","فقد أُعطِيتَ ألسنةً رطابا",56,"ب",2,0],["وإن طننت نحلةُ في الفراغ","تطن مع النحل قُبلاتُنا",57,"ن",2,0],["وَإِن طارَ الفُراق بِنا تَرَكنا","قُلوباً في دِيارَكُم تَحوم",58,"م",1,0],["وانطوينا بذيله وهو باب اللَ","ه باب الوصول للغفار",59,"ر",1,0],["وَإِن طالَما أَرسَلتُ غَيرَ مُدافِعٍ","عُقودَ ثَناءٍ دُرُّها الكَلِمُ الحُرُّ",60,"ر",1,0],["وَإِن طَلَبوا جابوا مَهامَةِ لَم تُجَب","وَإِن حارَبوا اِجتابوا مِنَ الصَبرِ أَدرُعا",61,"ع",2,0],["وَإِن طالَ الكَلامُ بِلا صَوابٍ","أَصَبتُ لَدَيكَ أَدنى القَولِ فَصلا",62,"ل",2,0],["وَأَنطَقتَني يا مُنطِقَ الخُرسِ بِالنَدى","فَأَلفَيتَني دونَ الوَرى مُسمِعَ الصُمِّ",63,"م",1,0],["وإِنَّ طَبِيباً يَشعَبُ القَلبَ بَعدَما","تَصَدَّعَ مِن وَجدٍ بِهَا لَكَذوبُ",64,"ب",1,0],["وإن طلبَ الطفوف فقده أيضا","إلى بئر الصويد إلى السليق",65,"ق",1,0],["وإن طلب الشآم فقده رفقا","إلى المقلوب تحت الفيد موق",65,"ق",1,0],["وانطوَت شُقَّةُ النوى والتقينا","بعدَ لأيٍّ وبعد قالٍ وقيل",66,"ل",1,0],["وإن طالعتْهُ الشمسُ تذهلُ فلا ترى","أمغربها في النقعِ أم ذاكَ مطلعُ",67,"ع",1,0],["وإن طلبَ الظلُّ فيها الهجيرَ","تأبتْ عليهِ بأشجارها",68,"ر",3,0],["وإن طالت مصاولة الليالي","هزمتُ صيالها فيما هزمتُ",69,"ت",1,0],["وإن طاب لي أن أوقد الحرب سالمت","ذئابٌ نهاها نسكها والتبتل",70,"ل",1,0],["وإن طربوا ليلا وللقلب حقه","حسبتهم جنّا أقبلوا من القد",71,"د",1,0],["وانطِقي يَنثُرِ إذا حدَّثتِنا","ناثِرُ الدُرِّ علينا ما نَشاء",72,"ا",2,0],["وَإِن طَرَقَتني في الزَمانِ مُلِمَّةٌ","نَزَلتُ بِحاجاتي عَلَيهِ وَأَثقالي",73,"ل",2,0],["وَإِن طَمعَت مِن غَيرِهِ في نَوالِهِ","فَلا صَدقَت فيما رَجَتهُ ظُنونُها",74,"ن",3,0],["وان طيفاً منك عاود مضجعي","قلت اسكني يا نفس يا عين اهجعي",75,"ع",2,1],["وإن طاوَعتُها طمِعَت بضعفي","وإن خالفتُها فأنا عَضيض",76,"ض",1,0],["وإن طربنا لألحانٍ تردِّدُها","فإنها أخذت عنّا أَغانينا",77,"ن",2,0],["وَإِنْ طالَ عُمْرٌ لَمْ تُقَصِّرْ غَرائِبٌ","يَعُزُّ اللَّيالِي أَنْ تُطاوِلَها عُمْرا",78,"ر",2,0],["وإِنَّ طِلابَ مَجْدِكَ وَهْوَ بَسْلٌ","كَخِيسِ اللَّيْثِ مَحْذُورِ الْوِلاجِ",79,"ج",1,0],["وإن طرق العدى لم يرض منهم","سوى هام الملوك له طراقا",80,"ق",2,0],["وأن طبي من الأسقام في يدها","سهل عليها فلا تبخل بإحسان",81,"ن",1,0],["وانطلاق النسيم يحبو إلى الزه","ر حيّ الخطا عفيف الغرام",82,"م",1,0],["وانطلق تبصر الوجود مثالا","فقدت فيه غيرة المثال",83,"ل",1,0],["وانطوى عمرى ليذهب ذكرا","خالداً في الأعمار والأحقاب",84,"ب",1,0],["وانطوت صفحة أيا","مي وعهد مستطاب",85,"ب",1,0],["وإن طمحت أركانه كان قطبه","حجى ملكٍ نجدٍ شمائله عفِّ",86,"ف",1,0],["وإنْ طالَ تأخيرُ الجَوابِ لِعائقٍ","إلى حينَ ضَمَّ الاتّفاقُ لها الشَّمْلا",87,"ل",2,0],["وإن طالَ بي عن كعبةِ المدحِ غَيبةٌ","فهذا أوانُ السّائراتِ الشَّوارد",88,"د",1,0],["وإنْ طَوَّفوا حولَ قُطْبِ السّماءِ","فَسِيروا نطُفْ حولَ قٌطْبِ العُلا",89,"ا",1,0],["وَإِن طَرَدَتني عَن ذُراكُمُ طَوارِدٌ","فَما أَنا مِن خَوفِ المَذَلَّةِ بارِحُ",90,"ح",1,0],["وأنطيتُهُ سيفي لكيما أقيمَهُ","فلا أوداً فيه استنبتُ ولا خَضْدا",91,"د",2,0],["وأن طعم حياتي صار بعدكموا","مرا،وكان بكم فيما مضى عسلا",92,"ل",2,0],["وانطبقت في مقته العبارة","ونحوه كل يشن الغاره",93,"ه",1,0],["وإنْ طُوِيَتْ صُحُفُ الأَكرمين","فإنِّي أراها بهم تُنْشَرُ",94,"ر",1,0],["وإن طلت لقومك مُسرعات","فذاك لأنهم ركِبوا الضَلالا",95,"ل",2,0],["وإِنْ طَوَتِ الرَّزايا من سَناهُمْ","فلحظُكَ منه يتَّضِحُ الخَفاءُ",96,"ا",2,0],["وإِنْ طَرَحَتْ عَنْها الرِّياسَةَ حَلْيَها","وبَدَّلَها الإِشْفاقُ لَوْثَ نَصيفِها",97,"ف",3,0],["وإِن طالَ البكاء فليس يجدي","لنا ويعيد ما يمضي ويبدي",98,"ي",1,0],["وإن طغت غريبةٌ","تُهِمُّ أو تقَسِّمُ",99,"م",1,0],["وانطوى الدهر على أعقابه","والقضايا وهي لم تقض انتقالَهْ",10