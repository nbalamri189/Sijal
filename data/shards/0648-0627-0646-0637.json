138,"د",1,0],["وَاِنطَلقوا لِلأَرض بِالفُؤوس","لِيَعرِفوا مَخابئ الفُلوس",139,"س",1,0],["وإن طلقت بعد الدخول ففرضها","بقرء من الأقراء تأتي به فردا",140,"د",2,0],["وإنْ طرَقَتْ جِيادُكَ دارَ قومٍ","فشُمُّ الشامخات لها وُهود",141,"د",1,0],["وانطقْ بما أوتيتَ من حكمةٍ","والنطق زِنْه قبلَ وقع الكلامْ",142,"م",1,0],["وإن طابتْ خواطرُنا","أَثيبُونا بمزمار",143,"ر",1,0],["وإِنَّ طريقِ الاضطرار لَمهْيَع","يمر به المضطر وقت امتحانه",144,"ن",2,0],["وإن طعن الشهم الكمي برمحه","وجدت زهيرا بين كفيه أرقم",145,"م",1,0],["وانطوى كل جميل فاتن","لهف نفسي أين أزهاري وطيري",146,"ر",2,0],["وانطوى الليل، ليلُنا القاتم الدا","مي وفرَّتْ سياطُه الرعناءُ",147,"ا",2,0],["وَأُنطِقَتِ الأَصنامُ نُطقاً تَبَرَّأَت","إِلى اللَهِ فيهِ مِن زَخارِفِ مَيّانِ",148,"ن",1,0],["وانطلاقُ الأضواء من غُرَرِ الصبح","صلاةٌ عميقةُ الإِبتهال",149,"ل",1,0],["وإنّ طبع من سألتم منه","يكرهه جداً وينأى عنه",150,"ه",1,0],["وانطوى تحت الثرى يا هاشم","منك بدر فيه ليل الغي يجلى",151,"ل",2,0],["وان طال مسرانا فَ للشوق مسرى","نطوي به التاريخ عامٍ ورا عام",152,"م",1,0],["وانطق بشاهد ما تلقاه في جدث ال","امكان واسمع لذكر القلب من ذاته",153,"ت",2,0],["وإن طال الحمام إلى علاه","فثم الهضب تغمرها السيول",154,"ل",1,0],["وان طلعتَ أو أضفته لِما","يليه فاللف بصدرٍ عُلِما",155,"م",2,0],["وَإن طَوَى ذَاكَ فَقَاعٌ صَفصَفُ","وَالجِنُّ لا تَبرَحُ فِيهِ تَعزِفُ",156,"ف",1,0],["وَأَنْطَقَ بِالأَشْعَارِ فِي الحَفْلِ أَلْسُناً","تَنَزَّهْنَ حَتَّى عَنْ مَعِيبِ لِثَاغِ",157,"غ",1,0],["وَأَنْطِقْ لِسَانِي بِالْبَيَانِ مُعَلِّماً","فَإِنِّيَ فِي التَّعْلِيمِ لِلْجُودِ رَاغِبُ",158,"ب",1,0],["وأن طال الترابُ بكلِّ وقتٍ","ومَن أهواهُ ثاوٍ فى التّراب",159,"ب",1,0],["وانطوى عزُّ نزار كلّها","بمصابٍ سامها أن تخضعا",160,"ع",2,0],["واْنطِق بصادِ الوصلِ من بَرد النَّدى","إن كنتَ ممن ينطِقُونَ بِضَادِ",161,"د",1,0],["وإن طلبت رشفة من ثغره","عز عليك أن تنال الطلبا",162,"ب",2,0],["وان طال عمري ينل بحساميَ","عزّاً عزيزاً وملكاً موطد",163,"د",1,0],["وانطق خالق الزهر الأقاحي","وأودع في خطابتها النسيما",164,"م",2,0],["وإن طرّفت بالواو والنجم غائبٌ","غدت طائ