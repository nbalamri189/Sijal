في الغاباتِ جوعاً","وَلَحمُ الضَأنِ تَأكُلُهُ الكِلابُ",2,"ب",1,1],["تَمّوزُ أَنتَ أَبو الشُهورِ جَلالَةً","تَمّوزٌ أَنتَ مُنى الأَسيرِ العاني",3,"ن",2,0],["تَمّوزُ إِنَّ بِنا إِلَيكَ لَحاجَةً","فَمَتى الأَوانُ وَأَنتَ خَيرُ أَوانِ",3,"ن",1,0],["تَموتُ قَطا الفَلاةِ بِها أُواماً","وَيَهلِكُ في جَوانِبِها النَسيمُ",4,"م",1,0],["تَموتُ وَتَحيا حائِلٌ مِن بَناتِها","وَمِنهُنَّ أُخرى عاقِرٌ وَهيَ تَحمِلُ",5,"ل",1,0],["تَموجَ ذِراعاها وَتَرمي بِجَوزِها","حِذاراً مِن الإِيعادِ وَالرَأسُ مُكمَحُ",6,"ح",1,0],["تموت القوى أن لم تكن في تبايُنٍ","ويَحَيْين ما دام التبايُنُ باقيا",7,"ي",2,0],["تموا وصحوا بأبواب العلاء فما","في الاسمِ نقص ولا في الجمع تكسير",8,"ر",1,0],["تمور أكسابُها عليه","إذا التوى الكسبُ كلَّ مور",9,"ر",1,0],["تَموتُ طَوراً وَتَحيا في أَسِرَّتِها","كَما تَفَلَّتُ في الرُبطِ المَراويدُ",10,"د",1,0],["تَموتُ وَما أَموتُ عَلَيكَ حُزناً","وَحَقَّ هَواكَ خُنتُكَ في هَواكا",11,"ك",2,0],["تَموتُ سِباعُ الجَوِّ غَرثى حِيالَها","وَتَحيا نُفوسُ الخَلقِ وَالمُهَجاتِ",12,"ت",1,0],["تموت الذكورة في جوفها","فتعقب نسلاً ولا تعقمُ",13,"م",1,0],["تموتُ عِداكم قبلَ سَلِّ سيوفِكم","ويَفنيهِمُ من قبلِ حَربِكمُ الرُّعبُ",14,"ب",1,0],["تَموتُ غَداً وَأَنتَ قَريرُ عَينٍ","مِنَ الفَضَلاتِ في لُجَحٍ تَعومُ",15,"م",1,0],["تَموتُ فَرداً وَتَأتي","يَومَ القِيامَةِ فَردا",16,"د",2,0],["تَموتُ كَما ماتَ الَّذينَ نَسيتَهُم","وَتُنسى وَتَهوى العِرسُ بَعدُ سِواكا",17,"ك",2,0],["تَموتُ غَداً وَأَنتَ قَريرُ عَينٍ","مِنَ الغَفَلاتِ في لُجَجٍ تَعومُ",18,"م",1,0],["تُمَوِّجينَ ظِلالَ الذِّكْرَياتِ هَوىً","وتُسْعِدينَ الأَسى، والهَمَّ والقَلََقا",19,"ق",2,0],["تموت على جوانبه الضواري","وتهلك في غواربه الذئاب",20,"ب",1,0],["تَموجُ مع الدياجرِ في يَدَيْهِ","صحائفُ من خطوب الدّهرِ سُودُ",21,"د",1,0],["تَمورُ الدِيارُ لِهَزّاتِها","وَلَو أَمسَكَتها قُوى الراسِياتِ",22,"ت",1,0],["تَموجُ شَوقاً إِلَيها وَهيَ ساكِنَةٌ","حَتّى تَكادُ لِطولِ الشَوقِ تَقتَتِلُ",23,"ل",1,0],["تَمُورُ كَما مارَت مَهاةٌ بِذي الغُضا","تُزَجّى بِبَطحاءِ القَسِيَّةِ فَرقَدا",24,"د",2,0],["تَموتُ النُفوسُ بِآجالِها","وَيَقطَعنَ ما بَينَ جِسمٍ وَراسِ",25,"س",1,0],["تموتُ الدّرْعُ دونَكَ حَتْفَ أنْفٍ","ويَبْلى فوْقَ عاتِقِكَ النّجادُ",26,"د",1,0],["تَموت بريعان الشَبيبة بنتُها","وَتَحيا سليمى في محاسن تكثر",27,"ر",1,0],["تَمُورُ بِضَبْعَيْهَا وتَرْمِي بِجَوْزِهَا","حِذَاراً مِنَ الإِيعَادِ والرَّأْسُ مُكْمَحُ",28,"ح",1,1],["تمَوّج باللهيب فكان بحراً","وكان سفينهُ جثَثا وهاما",29,"م",2,0],["تموز في عيونها","كالعانس المولّهه",30,"ه",1,0],["تمُّوز عاش منك في إِرهاب","آرَادُهُ حانية الرقاب",31,"ب",1,0],["تَمُّوزُ بالثورة البيضاء تاه على","كل الشهور؛ فَغَضَّ الطَّرْفَ نيسان",32,"ن",1,0],["تَمُّوزُ، ذكَّرتَنِي ما لَسْتُ ناسيَه","والذكرياتُ: مَسَرَّاتُ، وأحزان!",32,"ن",1,0],["تموت أسى . كي تشيع السرور","تغني وأنت القتيل السلام",33,"م",1,0],["تموت غداً وأنت قرير عين","مِنَ العَضَلاتِ في لُجَجٍ تَعُومُ",34,"م",1,0],["تموية الاحيا .. فالعيون الذليله","صدّقني أنّه مثل تموية .. الاموات",35,"ت",1,0],["تموج ألحان الصبا فيهما","كأنّما نهداك أغرودتان",36,"ن",1,0],["تموت القوى ان لم تكن في تباين","ويحين ما دام التباين باقيا",37,"ا",1,0],["(تمّوزُ) قد عادَ، ولَمَّا يَعُدْ","للجِسمِ ما أَبلى مِنَ العافِيةْ",38,"ي",2,0],["تموت مع المرء الهموم ولن ترى","ككأن الردى من علة العيش شافيا",39,"ي",2,0],["تموتُ قلوبٌ ثم تحيى لأجلها","إذا ارتفعتْ عن وَجْههن البراقعُ",40,"ع",1,0],["تموت فلا ترى مثواك أمٌّ","ولا أختٌ ولا زوجٌ ودود",41,"د",1,0],["تموت في كل يوم","بالانتحار كتيبه",42,"ب",2,0],["تموتُ في الماجور لولا النشَا","يَبعَثُهَا في ساعة النَّشرِ",43,"ر",1,0],["تَمَوَّج بِالمَضَارِبِ والمَبَانِي","وتَطْفَحُ بالمَذَاكِي والنِّياقِ",44,"ق",1,0],["تموّج دون الكشحِ وانداحَ ذيلُه","فكانتْ كمن يطفو عَلَى لججٍ خضرِ",45,"ر",1,0],["تموج بالغيب والأسرار ساهمةٌ","كأنَّها للغد المجهول تنطلقُ",46,"ق",1,0],["تموّجها كما تهوى","أعاصير من الوهم",47,"م",1,0],["تمورُ بِضِعْفِ نُجُومِ الثُّرَيَّا","لَوِ انْفَرَدَتْ بأَديمِ السَّمَاءِ",48,"ا",2,0],["تمورُ بِهَا فِي كُلِّ بحرٍ من الوغى","سوابِحُ محمودٌ لَهَا شِيَمُ السَّبْحِ",49,"ح",1,0],["تمورُ دماءُ الكُفرِ فِي شَفَراتِها","ويرجعُ عنها الطرفُ وهوَ كليلُ",50,"ل",1,0],["تموت الرجال الأغنياء