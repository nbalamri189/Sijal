{"poems":[[53,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[2469,"","https://poetry.dctabudhabi.ae/diwan/poem/203618","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62898","الرجز"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32670","المديد"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33493","الخفيف"],[5480,"(( يا علي ))","https://www.poetsgate.com/ViewPoem.aspx?id=1588",""]],"verses":[["بين ثوبَيْهِ شمسُ رأي وغَيْثٍ","مستهَلُّ الحيا علينا هَتُونه",0,"ن",2,0],["بين ثناياها وذاك اللمى","برق تلالى في دياجي الظلام",1,"م",1,0],["بينَ ثريَّاه ونسرٍ طايرِ","يَستَدبِرُ المِرزَمَ خُذ أشايري",2,"ي",1,0],["بينَ ثَنِيٍّ وَجَذَعْ","يَبِتْنَ في مَرْعَى السَّبُعْ",3,"ع",1,0],["بَينَ ثَوبَيهِ أَخو عَزَماتٍ","يَتَّقيها الحادِثُ المُصمَئِلُّ",4,"ل",1,0],["بين ثوبي شاهدٌ في هواهُ","دنفُ الطرفِ إي وجسمٌ نحيلُ",5,"ل",1,0],["بين ثمرن زاهي اخضاري","في مقامه الناظر يسله",6,"ل",2,0]]}