{"poems":[[202,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126273","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114467","الوافر"],[3464,"ألفٌ أمعاني من يذكرْ","https://www.poetsgate.com/ViewPoem.aspx?id=158742",""],[4859,"بعض الغرور ملاحة","https://www.poetsgate.com/ViewPoem.aspx?id=210681",""],[5282,"لؤلؤةٌ... وحروف زمرد (٢)","https://www.poetsgate.com/ViewPoem.aspx?id=214080",""],[5310,"مَعْبَدُ الْقَصِيْدَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=211298",""],[5818,"ما أقبح الراء بين الحاء والباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=193486",""]],"verses":[["راء رنا ظبياً وغنى أورقاً","ومشى قضيب نَقا ولاح هلالا",0,"ل",2,0],["راء وباء للمكارم يافتى","فالفعل يشهد لى بذاك وينطق",1,"ق",1,0],["راءني من لواحظه بسهمٍ","وأثخن في الحشا لما رآني",2,"ن",2,0],["راءٌ رأيٌ لم يخش خطا","ثبتٌ بالقلب فما عنتر",3,"ر",1,0],["راء وواو ثم ألف مودة","والنون يختم لطفها الآلاء❤",4,"ا",2,0],["راءٌ رَمتْ قلباً يَذوبُ إلىٰ السِقَاءْ","قد باتَ منها رَاحِلاً نَحوَ العَرَاءْ",5,"ا",2,0],["رَاءً تُرأرِئهُ الْعِيُونُ عَلَى الرؤى","\"يَاسِيْنُ\" حَاطَتْ بِالْجَمَالِ ضُحَاكِ",6,"ك",1,0],["راء الغرورِ هلالٌ لا اكتمال له","ما ضيّع الناس إلّا دورة الراءِ",7,"ا",2,0]]}