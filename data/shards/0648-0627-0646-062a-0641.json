w.poetsgate.com/ViewPoem.aspx?id=161904",""],[585,"أين القصائد أفوافاً توشيها","https://www.poetsgate.com/ViewPoem.aspx?id=161879",""],[5100,"انقلاب","https://www.poetsgate.com/ViewPoem.aspx?id=207702",""],[3591,"يا حافظ الشعر ويا شاعراً","https://www.poetsgate.com/ViewPoem.aspx?id=149433",""],[5183,"ذكرى ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=180225",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5186,"إاذا كانت الآمال بالوصل أوهاما","https://www.poetsgate.com/ViewPoem.aspx?id=156475",""],[5271,"ومنْ نورِ وجهُكِ صُبحي انفَلَقْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=59741",""],[5277,"حوارية","https://www.poetsgate.com/ViewPoem.aspx?id=190985",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5409,"إن عشتم بحبورٍ ناعمي البال","https://www.poetsgate.com/ViewPoem.aspx?id=155303",""],[5480,"همت فيني","https://www.poetsgate.com/ViewPoem.aspx?id=37269",""],[5490,"وقفت بالباب","https://www.poetsgate.com/ViewPoem.aspx?id=176378",""],[5508,"يا سيّدي قد رمُيتُ من زمني","https://www.poetsgate.com/ViewPoem.aspx?id=110835",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[5616,"جرح وتعديل","https://www.poetsgate.com/ViewPoem.aspx?id=203229",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[5701,"يا ليت شعري أي شيء أرى","https://www.poetsgate.com/ViewPoem.aspx?id=164594",""],[5703,"أسطورة حلب","https://www.poetsgate.com/ViewPoem.aspx?id=206281",""],[5803,"أنت الهيام وصبر العاشقين أنا","https://www.poetsgate.com/ViewPoem.aspx?id=104035",""],[732,"وَالدَهر إِن جارَ فيا","https://www.poetsgate.com/ViewPoem.aspx?id=153422",""],[5978,"التيه","https://www.poetsgate.com/ViewPoem.aspx?id=191362",""],[6093,"أَضْحَى التَّحَدُّثُ بِالفُصْحَى مِنَ العَجَبِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=184315",""],[6102,"جرش المداميك ..","https://www.poetsgate.com/ViewPoem.aspx?id=183608",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[3477,"إذا غردت قمرية خال صيحة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612728",""],[520,"ما عن هوى الرشإ العذري اعذار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577540",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[4792,"جَمالٌ ينحتُ القصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86320&r=&rc=2",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""],[5396,"المسافر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65510&r=&rc=9",""]],"verses":[["وَأَنتَ في ظِلَّ أَفنانٍ مُهَدَّلَةٍ","تَحنو عَليكَ نِقِنوانِ العَناقيدِ",0,"د",1,0],["وَأَنتَ فَما لَحِقتَ أَباكَ إِلّا","كَما لَحِقَ الذُنابى بِالجَناحِ",1,"ح",1,0],["وأنت في حضن هذا الشعر فاتنة","تطل منه، وحيناً فيه تستتر",2,"ر",1,0],["وَأَنتَ فَلا تُفقَد وَلا زالَ مِنكُمُ","إِمامٌ يُحَيّا في حِجابٍ مُسَدَّنِ",3,"ن",1,0],["وَأَنْتَ فِي بَلَدِ الأَنْوَارِ لا أَثَرٌ","فِيهِ يُذَكِّرُ عَصْراً بَاتَ فِي الظُّلَمِ",4,"م",1,0],["وَأَنتَ فَرعٌ إِلى عيصَينِ مِن كَرَمٍ","قَد اِستالا ذُرى الأَطوادِ وَالشَجَرا",5,"ر",2,0],["وأنت في حضرات القدس تنقلني","حتى استقر بهذا الكون مثواهُ",6,"ا",2,0],["وأن تفعل ففعلك فعل وَغد","وأن تترك فمن زجر وقهر",7,"ر",1,0],["وَأَنتَ فَقيرٌ لَم تُبَدَّل خَليفَةً","سِوايَ وَلَم يَلحَق بَنوكَ الأَصاغِرُ",8,"ر",1,0],["وأنت في الشتوة الجماد إذا","أخلف من أنجُم رواعدها",9,"ه",2,1],["وَإِن تَفتَدوني تَفتَدوا لِعُلاكُم","فَتىً غَيرَ مَردودِ اللِسانِ أَوِ اليَدِ",10,"د",1,0],["وَإِن تَفسُد فَما أُلفيتَ إِلّا","بَعيداً ما عَلِمتُ مِنَ السَدادِ",11,"د",1,0],["وأنتَ في الدولة ابن المعزّ","فلا تقصرن عن ابن الأجل",12,"ل",1,0],["وانتفع بالعُلا بذهِنك واذمُمْ","كلَّ ذهن لا ينفع الذُّهَناءَ",13,"ا",2,0],["وانتفى الشيخ من بنيه ولم تع","طف على بَكْرِهَا أعفُّ النساءِ",14,"ا",2,0],["وأنت فيها من ولاة الأمر","لولا دليل كبياض الفجر",15,"ر",1,0],["وأنت في عِفَّة السريرة وال","علم شبيه بجدك الحَبرِ",16,"ر",1,0],["وانتَفَجَتْ أوْرادُه واقعَنْسَسا","كعُنُق الهَيْق إذا تَوَجَّسا",17,"س",2,0],["وأنتَ فتى فتيان أهل زمانه","وبارعهُمُ طَوْلاً فلِمْ لا تَبرَّعُ",18,"ع",1,0],["وأنت فتبقى الدهر والغيثُ ينقضي","وتنهلّ بالجدوى وينهلُّ بالودق",19,"ق",1,0],["وأنت في منعِ ما أُحبُّ مع ال","قومِ فمن ذا يجير مُضطَهَدَكْ",20,"ك",1,0],["وأنتَ فتىً أحطتَ بكل علمٍ","لغوصك في است أمك واغتماسك",21,"ك",1,0],["وأنتَ في حِلٍّ وإنْ نالني","منك الذي لا يسعُ الحِلُّ",22,"ل",1,0],["وانتفاع يُنالُ من بَعْدِ ضُرٍّ","وسُرورٍ يَحِلُّ من بَعْدِ حُزْنِ",23,"ن",1,0],["وَإِن تُفقِدونا في الحُروبِ تَجَشَّموا","مِراسَ عُرىً تَأتي مَعَ اللَيلِ تَكدَحُ",24,"ح",1,0],["وأنت فوقَ الأسى والموت مبتسمٌ","ترنو إلى الكون يُبْنَى ثمَّ يندَثِرُ",25,"ر",1,0],["وانت في الحياة لي","يا شعر دين قيم",26,"م",1,0],["وأنت في مجلس الريحان لاهية","ما سِرت من سامر إلا إلى نادي",27,"د",2,0],["وَاِنتَفَضَت شَوارِباً","عَن مِثلِ بَيتِ الإِبرَةِ",28,"ه",1,0],["وَأَنتَ في الأَسرِ تَشكو ما تُكابِدُهُ","لِصَخرَةٍ مِن بَني الأَعجامِ صَمّاءُ",29,"ا",2,0],["وأنت فتحت لهم في الإباقُ","وذلك من طبعهم مستحيلُ",30,"ل",1,0],["وَأَنتَ فَعارِفٌ سَلَفي وَجَدّي","فَقيهُ الأَرضِ في حَشدِ المُلاءِ",31,"ا",2,0],["وَأَنتَ في شَحطِ نِيَّةٍ قَذَفٍ","يَهونُ فيها عَلَيكَ تَعذيبي",32,"ب",2,0],["وَأَنتَ فَلا حالِفٌ بِالعِتا","قِ وَلا حانِثٌ في طَلاقِ الحَرَج",33,"ج",1,0],["وَأَنتَ في القَومِ تَستَدعي سِيادَتَهُم","كَسالِحٍ يَدَّعي فَضلاً عَلى خارِ",34,"ر",1,0],["وَاِنتِف لَنا لَهوَ أَيّامٍ نَعيشُ بِهِ","فَاللَهوُ أَجمَعُ إِن مَيَّزتَهُ نَتَفُ",35,"ف",1,0],["وَإِن تَفَكَّرتُ وَاِعتَبَرتُ وَأَب","صَرتُ فَإِنّي في دارِ مُعتَبَرِ",36,"ر",1,0],["وَأَنتَ فَرعٌ طَيِّبٌ أَصلُهُ","لا بُدَّ لِلآخِرِ مِن أَوَّلِ",37,"ل",1,0],["وأنت في أفق الأوهام طيف صبا","سما ودقَّ على الأفهام موضعُه",38,"ع",2,0],["وأنت فراش ليل كلّ نور","تبعت وكلَّ برق قد أضاءَ",39,"ا",2,0],["وأنتَ في القبرِ حيٌّ ما عراكَ بلى","والبدرُ في الوهنِ مثلُ البدرِ في السحرِ",40,"ر",1,0],["وأنتَ فَاضْرِبْ في الطُّلَى يا أبَا","دُجانَةَ اضْرِبْ مُقْبِلاً مُدْبِرا",41,"ر",2,0],["وَأَنتَ في البَيتِ إِذ يُحَمُّ لَكَ ال","ماءُ وَتَدعو قِتالَنا لَعِبا",42,"ب",2,0],["وَأنتَ في خدمَةِ قَوْمٍ فَهَل","تَخْدُمُهُمْ يا أبَتا سُخْرَهْ",43,"ر",2,0],["وأنتَ في بأس ليثٍ","فضافضِ الناب قشوَر",44,"ر",1,0],["وأنت فكاك دائرتي قريضٍ","وهندسةٍ حللت بها الشكولا",45,"ل",2,0],["وَأَنْتَ فِي الحَقِّ جَدِيرٌ بِمَا","أَدْرَكْتَهُ مِنْ حَظِّكَ الأَكْمَلِ",46,"ل",1,0],["وَأَنتَ في العَونِ فإن","شُغِلتَ عَنهُ عذرَك",47,"ك",1,0],["وان تفكرت في خطب لتنسفه","بصولة الرأي غرت فكرك الحيل",48,"ل",1,0],["وإنْ تفترِسْني الآكلاتُ فبعدَ ما","وثِقتُ بها فاستلَّتِ النابَ والظُفرا",49,"ر",2,0],["وانت في ليل سفار الحمى قمر","واحمق الناس خب يحسد القمرا",50,"ر",2,0],["وأنت في الدنيا عزيزبنا","وبيننا منا بدار السلام",51,"م",1,0],["وأنت في العين أنوارٌ ملمعة","وأنت في القلب برد العارض الهطل",52,"ل",1,0],["وأنت فينا نبي الحسن لا كذبا","وللهو مرسل من أفصح الرسل",52,"ل",1,0],["وَأنت في درجِ العلياءِ مرتقياً","ما مرَّ ذو الحجة الزهراءِ أو صَفرُ",53,"ر",1,0],["وإنت في شهرِ الوخمِ والكسل","وإللي فيه تصبح كمان يه تِبات",54,"ت",1,0],["وَأَنْتَ فَاحْكُمْ بِمَا تَهْواهُ يا تَلَفِي","رَضِيتُ مِنْكَ بِهِ إِنْ كُنْتَ تُرْضِيها",55,"ي",3,0],["وأنت فريسة بيد المنايا","لهنَّ عليك في الموت اقتراحُ",56,"ح",1,0],["وإنْ تفقّهَ في نادٍ أقرَّ لَهُ","أبو حنيفةَ بالتَبريز إذْعانا",57,"ن",2,0],["وإن تفحّصَ أحوالَ النّجومِ درى","ما حُم من أجّلٍ في الغَيبِ أو أمَلِ",58,"ل",1,0],["وَأَنتَ فَقَد جَرَّبتَ كُلَّ مُجَرَّبٍ","وَطاوَلتَ ما لا كانَ خَلقٌ يُطاوِلُه",59,"ل",2,0],["وأنت في غفلة على غرر","والشيب ناع والموت منتظري",60,"ر",2,0],["وإن تفضل الحكامَ علماً وسؤدداً","فقد فضلت قدماً تنوخُ القبائلا",61,"ل",2,0],["وأنت في حضنى","تشكو الجوى والليل",62,"ل",1,0],["وأنت في الليل تشكو","من لذعة الحرمان",62,"ن",1,0],["وأنتَ في النَيْلِ جَوَّاد تفوقُ على","ماء السَّمَاء وفَضَحْتَ البحرَ والنيلا",63,"ل",2,0],["وأنتَ في كلّ يومٍ","عيدٌ يَلُوحُ عُلاه",64,"ا",2,0],["وأنت فيه بشير القوم إن يئسوا","وأنت فيه خطيب القوم إن وفدوا",65,"د",3,0],["وَأَنتَ في كُلِّ عُلوِيٍّ لَهُ أَثَرٌ","مُؤَثَّرٌ وَعَلى الطوفانِ طوفانُ",66,"ن",1,0],["وأنت فسيء الأخلاق جداً","كما تدري قليلُ الإحتمال",67,"ل",1,0],["وأنتف الشعر من جبين حر","لطفت في نتفه وما شعرا",68,"ر",2,0],["وإنّ تفضيله وهو الجدير به","قد كان من قِبَل الرحمن لا قِبلي",69,"ل",2,0],["وَاِنتَفَضَ الرَّيحانُ مِن طَلِّهِ","يَنثُرُ عِطفاهُ عُقودَ الجُمان",70,"ن",1,0],["وَأَنتَ فيما قُلتَهُ صادِقٌ","إِن لَم يَكُن أَفسَدَكَ المُصلِحُ",71,"ح",1,0],["وأنت فديتك يا منيتي","على القلب آمرة ناهيه",72,"ي",2,0],["وَأَنتَ في الدارين لي موئلٌ","إذا جفا الأَقربُ والأَبعدُ",73,"د",1,0],["وانتفضتْ كأَنما","قدْ بلّلتها لتنشره",74,"ر",2,0],["وأنت فعغرى بالحسان وإنني","لأكره ما بي أن أرى وجه ضرتي",75,"ي",1,0],["وأنت فهل تدري بما أنا جاهلٌ","وهل فيك من هدى لأيّامي الحيرى",76,"ر",2,0],["وأنتِ في قلبي الوليد حياة","وأنتِ من غدر الزمان شفاء",77,"ا",2,0],["وَاِن تَفاخَر اِبطال الوِلايَة في","مِضمار سَبق وَلِلاِبطال صولات",78,"ت",1,0],["وَإِن تَفتَتِح طَولاً فَما زِلتَ سابِقاً","إِلى كُلِّ غاياتِ العُلا وَالمَكارِمِ",79,"م",1,0],["وَأَنتَ في الأَرضِ أَم فَوقَ السَماءِ فَفي","يَمينِكَ البَحرُ أَم في وَجهِكَ القَمَرُ",80,"ر",1,0],["وَأَنتَ في جَيشِ رَأي لا غُبارَ لَهُ","تَرمي العُداةَ بِقَوسٍ ما لَها وَتَرُ",80,"ر",1,0],["وأنت فيما زعمتَ تنصحُ لي","تهوى ويأتيكَ مثل ذا النصحِ",81,"ح",1,0],["وانتفاء الأعم فهو مفيد","لانتفاء الأخص بالالتزام",82,"م",1,0],["وأنت في فسحة فتوبي","واستفرغي الوسع في السلامه",83,"م",2,0],["وأَنْتَ في النَّاس لمَنْ يقتفي","قافية المجد وبيت القصيد",84,"د",1,0],["وأَنْتَ فأَكرَمُ مِنْ أَنْ أُرَى","وشيمتُك النفعُ أَشكو الضَّررْ",85,"ر",1,0],["وإنْ تفتكّ فافتكّ","فإني غلِقُ الرهنِ",86,"ن",1,0],["وأنت فوق الأنام منزلة","في هضبان العلياء تفترع",87,"ع",1,0],["وانتفاخُ الأوداجِ والص