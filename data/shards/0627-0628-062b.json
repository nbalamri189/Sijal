],[5376,"أبث النفس بالأملِ","https://www.poetsgate.com/ViewPoem.aspx?id=202177",""],[5408,"أبي...وعاد أخي","https://www.poetsgate.com/ViewPoem.aspx?id=190865",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5516,"إلى من بان واحتجبا","https://www.poetsgate.com/ViewPoem.aspx?id=212478",""],[5550,"أَبُثُّ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213054",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5628,"المرأة الساحرة","https://www.poetsgate.com/ViewPoem.aspx?id=179898",""],[5717,"حبتك طالعة بحسن المطلع","https://www.poetsgate.com/ViewPoem.aspx?id=170588",""],[5742,"نفح العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=206890",""],[5912,"ذكرى الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=202553",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[5957,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=24468",""],[6068,"لُبنى -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175839",""],[6124,"همس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=128748",""],[6152,"هواك الغرم والمغنم","https://www.poetsgate.com/ViewPoem.aspx?id=203036",""],[6152,"أيا ليل الحجاز","https://www.poetsgate.com/ViewPoem.aspx?id=203102",""],[6152,"اسئلة الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=204727",""],[240,"أُبِثُّكَ مَجْدَ کلدِّينِ حَالاً سَمَاعُهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26475&r=&rc=0",""]],"verses":[["أبث عن غايتي فيها شكاة فتاً","تقطعت دونه الأسباب والعصم",0,"م",1,0],["أَبُثُّكَ عَن لَيلٍ تَعَسَّفتُ مَتنَهُ","كَأَنّي أَمشي في مُتونِ الأَراقِمِ",1,"م",1,0],["أَبَثَثتُهُ كَمَدي وَطولَ تَجَلُّدي","وَأَليمَ ما بي مِن نَوىً وَفِراقِ",2,"ق",1,0],["أَبُثُّكَ أَنَّ المالَ عارٌ عَلى الفَتى","وَما المالُ إِلّا عِفَّةٌ وَقُنوعُ",3,"ع",1,0],["أَبُثُّكَ أَنّي قَطَعتُ الزَما","نَ أَطلُبُ عِزِّيَ أَو ناصِري",4,"ر",2,0],["أَبُثُّكَ أَنّي راغِبُ عَن مَعاشِرٍ","يَضنّونَ بِالوُدِّ القَليلِ وَأَسمَحُ",5,"ح",1,1],["أَبُثُّكَ مِن وُدّي بِغَيرِ تَكَلُّفٍ","وَأُرضيكَ مِن نُصحي بِغَيرِ رِياءِ",6,"ا",2,0],["أَبُثُّكَ ما لَقيتُ مِنَ اللَيالي","فَقَد قَصَّت نَوايِبُها جَناحي",7,"ي",1,1],["أَبُثُّكَ يا صَفِيَّ الدينِ حالي","وَلا يُشكى إِلى غَيرِ الكِرامِ",8,"م",1,1],["أَبُثُّكِ ما أَلقى وَفي النَفسِ حاجَةٌ","لَها بَينَ جِلدي وَالعِظامِ دَبِيبُ",9,"ب",1,0],["أبثُّكُمُ إني على النأي حافظٌ","ذمامَ الهوى لو تحفظون ذماميا",10,"ي",2,0],["أبثُّ صريحَ المدح أخرُج فيهِ من","قشوري فيأتي المدحُ فهو لباب",11,"ب",1,1],["أبثك يا أخا العلياء أني","سئمت من الليالي كم تروع",12,"ع",1,1],["أبثك إنّ عاذليَ المعنى","رآك بعين حبٍّ مثل عيني",13,"ن",2,0],["أَبُثُّها الوَجد وَهيَ لاهِيَةٌ","أَذهَلَها الحُبُّ فَهيَ تَفتَكِرُ",14,"ر",1,0],["أَبُثُّ لَكَ الشُكرَ الَّذي طابَ نَشرُهُ","وَأُطري بِما أُثني عَلَيكَ وَأُطرِبُ",15,"ب",1,0],["أَبُثَينَ هل تَدرِينَ كَم جَشَّمتِني","من عَقرِ ناجِيَةٍ وحَربِ مَوالِ",16,"ل",1,0],["أَبُثَينَ إِنَّكِ قَد مَلِكتِ فَأَسجِحي","وَخُذي بِحَظِّكِ مِن كَريمٍ واصِلِ",17,"ل",1,1],["أَبَثنَةُ لَلوَصلُ الَّذي كانَ بَينَنا","نَضا مِثلَما يَنضو الخِضابُ فَيَخلُقُ",18,"ق",1,0],["أَبثنَةُ ما تَنأَينَ إِلّا كَأَنَّني","بِنَجمِ الثُرَيّا ما نَأَيتِ مُعَلَّقُ",18,"ق",1,0],["أبث شعوري فيك غيرمقلد","واعرض آمالي ورأيي ومذهبي",19,"ب",2,0],["أَبُثُّكَ وَجدي يا حَمامُ وَأودِعُ","فَإِنَّكَ دونَ الطَيرِ لِلسِرِّ مَوضِعُ",20,"ع",1,1],["أَبَثُّ لِأَصحابِ السَفينِ غَوائِلاً","وَأَلأَمُ ناباً حينَ تَفغَرُ فاها",21,"ا",3,0],["أبُثُّكَ مجدَ المُلْكِ قولةَ صادقٍ","وكِذْبُ الفَتَى فيما يُحَدِّثُ حوبُ",22,"ب",1,0],["أَبُثُّكَ بِالأَشعارِ فَرطَ تَشَوُّقي","وَلا أَتَعاطى حَصرَ وَصفِكَ بِالشِعرِ",23,"ر",1,0],["أبثكِ بَيْنَاً ودمعاً جرى","فهذا حجازٌ وذا ينبعُ",24,"ع",1,0],["أَبُثُّكُم فيهِ جَوىً شَفَّني","حُمِّلتُهُ مِن حُبِّكُم مُثقِلا",25,"ل",2,0],["أَبُثُّ مَعَ البَليلِ إِلَيهِ شَوقي","فَتَبلُغُهُ وَقَد عادَت سَموما",26,"م",2,0],["أبثين إن أدنى العدو حمامي","بمسدس يوريه أَو بحسامِ",27,"م",1,1],["أبثين إن أودى جميلك خابطاً","بدم له اهريق فوق رغام",27,"م",1,0],["أبُثُّك أن الفؤاد الرقيقَ","يُمِضُّ به الحادث الفادح",28,"ح",1,0],["أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ","فإنك دونَ الطيرِ للسرِّ موضعُ",29,"ع",1,1],["أَبثك بَعض ما عِندي فَتَقضي","وَتَعلَم سرَّ ما أَخفي جِهارا",30,"ر",2,0],["أبثُّ لها الشكْوى وتُبْدِى ملاحة","إلى أن طوى أثوابَ ليلَتِنا الفجرُ",31,"ر",1,0],["أَبُثُّكُما وَجدي وَأَشكُو إِلَيكُما","جَوىً بَينَ أَثناءِ الحَشا لا يُفارِقُ",32,"ق",1,0],["أَبُثُّكِ مابي فَإن تَرحَمي","رَحِمتِ أَخا لَوعَةٍ ماتَ حُبّا",33,"ب",2,1],["أَبُثُّكُم يا أَهلَ وُدِّيَ إِنَّني","حِذارُ نَواكُم لِلتَواصُلِ رامِقُ",34,"ق",1,0],["أَبُثُّكِ وَجدي لَو أَصَختِ لِمَعمودِ","وَكَيفَ يُرجى عَطفُ صَمّاءَ صَيخودِ",35,"د",1,1],["أُبِثُّكُمُ أَنّي مَشوقٌ بِكُم صَبُّ","وَأَنَّ فُؤادي لِلأَسى بَعدَكُم نَهبُ",36,"ب",1,1],["أُبِثُّكَ مَجدَ الدَينِ حالاً سَماعُها","يَشُقُّ عَلى الأَمجادِ وَالكُبَراءِ",37,"ا",2,1],["أبثك ما بعد الندامة مغنم","لقد سلموا من في الحوادث سلموا",38,"م",3,1],["أبثك ما في الدهر مثلك ذو علاً","علا ذروة الشعرى ولا شاعر مثلي",39,"ل",2,0],["أبثثتُها وجدي فلمَّا أزمعتْ","لتبوحَ لي بكوامنِ الأسرار",40,"ر",1,0],["أُبُثُّكَ أم أَصُونُكَ يَا خَلِيلي","فَإنّ البَثَّ مِفتَاحُ الغَلِيلِ",41,"ل",1,1],["أَبث له الشَكوى فيحمر خدّه","حَياء وَأَعضائي من الوجد ترجف",42,"ف",1,0],["أبُثُّكَ أنّ الصّدرَ ضاق عن الجوَى","فدعْ عنك لَومي واتْركِ النّارَ في الزَّنْد",43,"د",1,0],["أبُثُّكَ ما بِي وماذا عَسَى","أبثُّك أعيا عَليَّ البَيانُ",44,"ن",1,1],["أبثُّك ما الحَديثُ به شجُونا","حَوادثَ ما يُصَدَّقُ أن تَكُونا",45,"ن",2,1],["أبثُّكَ ما سَهِرتُ له خُطوبا","مُوكَّلةً نَوائِبُها بِعَيني",46,"ن",2,1],["أبثُّكَ ما لِلعِيد عِندي وأبتَدي","أُهنِّيكَ باليَوم الَّذي ليسَ يَهنِينِي",47,"ن",2,0],["أبثّك فرْطَ اشتياقٍ إليْك","بهِ ظلَّ يعذرني مَنْ عذلْ",48,"ل",1,1],["أبثّ له شجوي فيزداد قسوةً","إذا قلتُ يوماً راقبِ الله في أمري",49,"ر",2,0],["أَبثْكَ شوقاً لي إليكَ أَقَلّه","يهدِّدُ مِن ركنًَي ثَبير وثَهْلاَنِ",50,"ن",1,0],["أبثك شوقاً لي إليك مضاعفا","لِنيرانِهِ بين الضلوع وقودُ",51,"د",1,0],["أبثك أني ما وجدت مشقة","ولم أر في الأسفار ما كنت أخشاه",52,"ا",2,1],["أبث لها وجدي وأبكي صبابة","فتضحك إعجاباً لما هي تسمع",53,"ع",1,0],["أُبثُّكَ يا جمالَ المُلْكِ أَّنِّي","سَكِرْتُ وما شَرِبْتُ كؤوسَ راحِ",54,"ح",1,0],["أَبُثُكَ أَني في يَدِ الحب مُوثَقٌ","فهل مُنْقِذٌ من ضاربٍ أَو مُطاعِنِ",55,"ن",1,1],["أبثّكَ يا بَحر النّدى أنّ مورِدي","ومَرعايَ ذا غيضٌ لديّ وذا جَدْبُ",56,"ب",1,0],["أبثّكَ من أشواق قلبي بعضها","وأنت بحال الوجد مني أفهم",57,"م",1,0],["ابث إِلى علياه بعض خلاله","وهذا لساني بالثناء له رطب",58,"ب",1,0],["أبثّ من لوعتي ما فاض عن كلمي","وإن تحجب في مكنوز إضماري",59,"ر",2,0],["أُبُّث الشِّعر أنىَّ كنتُ حُبِّى","وأرعاه بإيماني الأمين",60,"ن",1,0],["أبثأرٍ ضاع تبغينِيَ لا بل","حسدَ الفضلِ وقصداً للكمالِ",61,"ل",1,0],["أبثُّك عن قلبٍ أحبَّك صادقاً","إذا كان حبٌّ خدعةً وتملُّقا",62,"ق",2,0],["أبثك أشواقي إليكَ وإنما","أحنًّ إلى العلياء أو أتشوَّق",63,"ق",1,0],["أبثُّ الأسى وجداً بهيف غصونها","كأني من بعض الحمام السواجع",64,"ع",1,0],["أبثثتهُ الشكوى وكيف بمنزل","قد خفَّ مثل قطينهِ إسعافه",65,"ف",2,0],["أبثُّكَ ما بي أم كفاكَ نحولي","ففيه على وجدي أتَمُّ دليلِ",66,"ل",1,1],["أَبُثُّ ما بَيْنَهُمْ مِنْ مَذْهَبِي دُرَراً","حَجَبْتُها عَنْ ذَوي التَّقْلِيدِ والرِّيَبِ",67,"ب",1,0],["أبثُّهُ عُجَرِي حتّى يكون لها","كفيلَها وأُقضِّي عنده بُجَرِي",68,"ر",2,0],["أبثها بين أقوامٍ فيوهمني","بعضٌ بإيمانه والبعض نقال",69,"ل",1,0],["أبُثُّك أني راغبٌ غيرُ راغب","مُلِحٌ وإنّي زاهدٌ غيرُ زاهد",70,"د",1,0],["أبُثُّكَ يا بنَ أحمَدَ إنَّ قَصدي","لِبابِكِ زادَني شَرَفاً ويُمنا",71,"ن",2,0],["أبث بها للبدر وجدي وهاجسي","وأغدو أواري عن ذكاء أواري",72,"ر",2,0],["أَبثُّكِ أَنّي بالتَجلّد وَالبُكى","وَبالبثّ مَع فقد الكرى في شَدائِدِ",73,"د",1,0],["أبثُّه سِرَّ حُسْنٍ جلَّ مُضمَرُهُ","عنْ أن تُطالعهُ الأقلامُ والكُتُبُ",74,"ب",1,0],["أبثُّ جناياتِ العشيرةِ معلناً","الى من بمكنونِ السّرائرِ يعلّمُ",75,"م",1,0],["أبثك ما عندي فهل أنت سامع","وادعوك للجلى فهل أنت دافع",76,"ع",1,1],["أبثّ به كتب المحبة والأسى","يقابلني فيه ببثِّ الكتائب",77,"ب",1,0],["أبث هواي ووجدي لكم","وتجفونني أكذا يجمُلُ",78,"ل",1,0],["أبثّ الرياح الهوج برح لواعجي","ويطربني قصفٌ لها وهزيم",79,"م",1,0