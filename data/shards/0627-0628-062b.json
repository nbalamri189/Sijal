{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"ولقد أقول لصاحب نبهته","https://www.aldiwan.net/poem29945.html","الكامل"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[53,"أبثك أني راغب عن معاشر","https://www.aldiwan.net/poem30647.html","الطويل"],[53,"جزاء أمير المؤمنين ثنائي","https://www.aldiwan.net/poem30783.html","الطويل"],[71,"أبثك ما لقيت من الليالي","https://www.aldiwan.net/poem3941.html","الوافر"],[71,"أبثك يا صفي الدين حالي","https://www.aldiwan.net/poem3976.html","الوافر"],[35,"ألا طرقت بعد العشاء جنوب","https://www.aldiwan.net/poem39618.html","الطويل"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[72,"أبث صريح المدح أخرج فيه من","https://www.aldiwan.net/poem18232.html","الطويل"],[72,"أبثك يا أخا العلياء أني","https://www.aldiwan.net/poem19250.html","الوافر"],[72,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[91,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[70,"سواك الذي ودي لديه مضيع","https://www.aldiwan.net/poem43024.html","الطويل"],[32,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[32,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[32,"ألم تسأل الربع الخلاء فينطق","https://www.aldiwan.net/poem27817.html","الطويل"],[89,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[85,"أبثك وجدي يا حمام وأودع","https://www.aldiwan.net/poem63659.html","الطويل"],[85,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[66,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[31,"أرسلت لما عيل صبري إلى","https://www.aldiwan.net/poem41857.html","السريع"],[81,"أثار الليث ألحاظ نيام","https://www.aldiwan.net/poem61486.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85548","الكامل"],[90,"تذكر العهود","https://www.poetsgate.com/ViewPoem.aspx?id=178985",""],[85,"أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9555&r=&rc=45",""]],"verses":[["أَبُثُّكَ عَن لَيلٍ تَعَسَّفتُ مَتنَهُ","كَأَنّي أَمشي في مُتونِ الأَراقِمِ",0,"م",1,0],["أَبَثَثتُهُ كَمَدي وَطولَ تَجَلُّدي","وَأَليمَ ما بي مِن نَوىً وَفِراقِ",1,"ق",1,0],["أَبُثُّكَ أَنَّ المالَ عارٌ عَلى الفَتى","وَما المالُ إِلّا عِفَّةٌ وَقُنوعُ",2,"ع",1,0],["أَبُثُّكَ أَنّي قَطَعتُ الزَما","نَ أَطلُبُ عِزِّيَ أَو ناصِري",3,"ر",2,0],["أَبُثُّكَ أَنّي راغِبُ عَن مَعاشِرٍ","يَضنّونَ بِالوُدِّ القَليلِ وَأَسمَحُ",4,"ح",1,1],["أَبُثُّكَ مِن وُدّي بِغَيرِ تَكَلُّفٍ","وَأُرضيكَ مِن نُصحي بِغَيرِ رِياءِ",5,"ا",2,0],["أَبُثُّكَ ما لَقيتُ مِنَ اللَيالي","فَقَد قَصَّت نَوايِبُها جَناحي",6,"ي",1,1],["أَبُثُّكَ يا صَفِيَّ الدينِ حالي","وَلا يُشكى إِلى غَيرِ الكِرامِ",7,"م",1,1],["أَبُثُّكِ ما أَلقى وَفي النَفسِ حاجَةٌ","لَها بَينَ جِلدي وَالعِظامِ دَبِيبُ",8,"ب",1,0],["أبثُّكُمُ إني على النأي حافظٌ","ذمامَ الهوى لو تحفظون ذماميا",9,"ي",2,0],["أبثُّ صريحَ المدح أخرُج فيهِ من","قشوري فيأتي المدحُ فهو لباب",10,"ب",1,1],["أبثك يا أخا العلياء أني","سئمت من الليالي كم تروع",11,"ع",1,1],["أبثك إنّ عاذليَ المعنى","رآك بعين حبٍّ مثل عيني",12,"ن",2,0],["أَبُثُّها الوَجد وَهيَ لاهِيَةٌ","أَذهَلَها الحُبُّ فَهيَ تَفتَكِرُ",13,"ر",1,0],["أَبُثُّ لَكَ الشُكرَ الَّذي طابَ نَشرُهُ","وَأُطري بِما أُثني عَلَيكَ وَأُطرِبُ",14,"ب",1,0],["أَبُثَينَ هل تَدرِينَ كَم جَشَّمتِني","من عَقرِ ناجِيَةٍ وحَربِ مَوالِ",15,"ل",1,0],["أَبُثَينَ إِنَّكِ قَد مَلِكتِ فَأَسجِحي","وَخُذي بِحَظِّكِ مِن كَريمٍ واصِلِ",16,"ل",1,1],["أَبَثنَةُ لَلوَصلُ الَّذي كانَ بَينَنا","نَضا مِثلَما يَنضو الخِضابُ فَيَخلُقُ",17,"ق",1,0],["أَبثنَةُ ما تَنأَينَ إِلّا كَأَنَّني","بِنَجمِ الثُرَيّا ما نَأَيتِ مُعَلَّقُ",17,"ق",1,0],["أبث شعوري فيك غيرمقلد","واعرض آمالي ورأيي ومذهبي",18,"ب",2,0],["أَبُثُّكَ وَجدي يا حَمامُ وَأودِعُ","فَإِنَّكَ دونَ الطَيرِ لِلسِرِّ مَوضِعُ",19,"ع",1,1],["أَبَثُّ لِأَصحابِ السَفينِ غَوائِلاً","وَأَلأَمُ ناباً حينَ تَفغَرُ فاها",20,"ا",3,0],["أبُثُّكَ مجدَ المُلْكِ قولةَ صادقٍ","وكِذْبُ الفَتَى فيما يُحَدِّثُ حوبُ",21,"ب",1,0],["أَبُثُّكَ بِالأَشعارِ فَرطَ تَشَوُّقي","وَلا أَتَعاطى حَصرَ وَصفِكَ بِالشِعرِ",22,"ر",1,0],["أبثكِ بَيْنَاً ودمعاً جرى","فهذا حجازٌ وذا ينبعُ",23,"ع",1,0],["أَبُثُّكُم فيهِ جَوىً شَفَّني","حُمِّلتُهُ مِن حُبِّكُم مُثقِلا",24,"ل",2,0],["أَبُثُّ مَعَ البَليلِ إِلَيهِ شَوقي","فَتَبلُغُهُ وَقَد عادَت سَموما",25,"م",2,0],["أبثين إن أدنى العدو حمامي","بمسدس يوريه أَو بحسامِ",26,"م",1,1],["أبثين إن أودى جميلك خابطاً","بدم له اهريق فوق رغام",26,"م",1,0],["أبُثُّك أن الفؤاد الرقيقَ","يُمِضُّ به الحادث الفادح",27,"ح",1,0],["أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ","فإنك دونَ الطيرِ للسرِّ موضعُ",28,"ع",1,1]]}