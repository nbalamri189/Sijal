{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"ولقد أقول لصاحب نبهته","https://www.aldiwan.net/poem29945.html","الكامل"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[53,"أبثك أني راغب عن معاشر","https://www.aldiwan.net/poem30647.html","الطويل"],[53,"جزاء أمير المؤمنين ثنائي","https://www.aldiwan.net/poem30783.html","الطويل"],[71,"أبثك ما لقيت من الليالي","https://www.aldiwan.net/poem3941.html","الوافر"],[71,"أبثك يا صفي الدين حالي","https://www.aldiwan.net/poem3976.html","الوافر"],[35,"ألا طرقت بعد العشاء جنوب","https://www.aldiwan.net/poem39618.html","الطويل"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[72,"أبث صريح المدح أخرج فيه من","https://www.aldiwan.net/poem18232.html","الطويل"],[72,"أبثك يا أخا العلياء أني","https://www.aldiwan.net/poem19250.html","الوافر"],[72,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[91,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[70,"سواك الذي ودي لديه مضيع","https://www.aldiwan.net/poem43024.html","الطويل"],[32,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[32,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[32,"ألم تسأل الربع الخلاء فينطق","https://www.aldiwan.net/poem27817.html","الطويل"],[89,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[85,"أبثك وجدي يا حمام وأودع","https://www.aldiwan.net/poem63659.html","الطويل"],[85,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[66,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[31,"أرسلت لما عيل صبري إلى","https://www.aldiwan.net/poem41857.html","السريع"],[81,"أثار الليث ألحاظ نيام","https://www.aldiwan.net/poem61486.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85548","الكامل"],[90,"تذكر العهود","https://www.poetsgate.com/ViewPoem.aspx?id=178985",""],[85,"أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9555&r=&rc=45",""],[107,"أدار علي طرفك ما أدارا","https://www.aldiwan.net/poem16251.html","الوافر"],[126,"لمي بوادى المنحنى طلل قفر","https://www.aldiwan.net/poem50600.html","الطويل"],[167,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[223,"أبثك مابي فإن ترحمي","https://www.aldiwan.net/poem55162.html","المتقارب"],[230,"متى لا ح لي من أبرق الجزع بارق","https://www.aldiwan.net/poem14849.html","الطويل"],[233,"أبثك وجدي لو أصخت لمعمود","https://www.aldiwan.net/poem32105.html","الطويل"],[233,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[233,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[259,"أبثك ما بعد الندامة مغنم","https://www.aldiwan.net/poem38185.html","الطويل"],[259,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[296,"أفدي التي لما رأتني مقبلا","https://www.aldiwan.net/poem36326.html","عموديه"],[355,"أبثك أم أصونك يا خليلي","https://www.aldiwan.net/poem4150.html","الوافر"],[359,"لقد شاقني هذا القوام المهفهف","https://www.aldiwan.net/poem68090.html","الطويل"],[362,"أضم على قلبي يدي من الوجد","https://www.aldiwan.net/poem60941.html","الطويل"],[369,"أبثك ما بي وماذا عسى","https://www.aldiwan.net/poem57024.html","المتقارب"],[369,"أبثك ما الحديث به شجونا","https://www.aldiwan.net/poem57071.html","الخفيف"],[369,"أبثك ما سهرت له خطوبا","https://www.aldiwan.net/poem57083.html","الوافر"],[369,"أرى طارقا يصبو إلي ويصبيني","https://www.aldiwan.net/poem57085.html","الطويل"],[399,"أبثك فرط اشتياق إليك","https://www.aldiwan.net/poem46535.html","المتقارب"],[399,"أيا وجد أبقيت حتى على صبري","https://www.aldiwan.net/poem46745.html","الطويل"],[399,"فراقكم هاج اشتياقي وأشجاني","https://www.aldiwan.net/poem46756.html","الطويل"],[399,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[400,"أبثك أني ما وجدت مشقة","https://www.aldiwan.net/poem33357.html","الطويل"],[400,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[429,"يمينك في النوال وفي الكفاح","https://www.aldiwan.net/poem12349.html","الوافر"],[429,"أبثك أني في يد الحب موثق","https://www.aldiwan.net/poem12396.html","الطويل"],[429,"وما كنت أخشى من زماني نبوة","https://www.aldiwan.net/poem12561.html","الطويل"],[441,"إلى وجهك الوضاح يشتاق مغرم","https://www.aldiwan.net/poem55910.html","الطويل"],[450,"مهينمة جاءت بأوصاف ماجد","https://www.aldiwan.net/poem13647.html","الطويل"],[451,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[451,"سواء حول لنكلن المعلى","https://www.aldiwan.net/poem61754.html","الوافر"],[456,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[456,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[462,"أموضع سري والذي حسن عهده","https://www.aldiwan.net/poem3163.html","عموديه"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[462,"وجه الحبيب شهية ألطافه","https://www.aldiwan.net/poem3540.html","عموديه"],[475,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[527,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[549,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[556,"الحمد لله لا جاه ولا مال","https://www.aldiwan.net/poem34213.html","البسيط"]],"verses":[["أَبُثُّكَ عَن لَيلٍ تَعَسَّفتُ مَتنَهُ","كَأَنّي أَمشي في مُتونِ الأَراقِمِ",0,"م",1,0],["أَبَثَثتُهُ كَمَدي وَطولَ تَجَلُّدي","وَأَليمَ ما بي مِن نَوىً وَفِراقِ",1,"ق",1,0],["أَبُثُّكَ أَنَّ المالَ عارٌ عَلى الفَتى","وَما المالُ إِلّا عِفَّةٌ وَقُنوعُ",2,"ع",1,0],["أَبُثُّكَ أَنّي قَطَعتُ الزَما","نَ أَطلُبُ عِزِّيَ أَو ناصِري",3,"ر",2,0],["أَبُثُّكَ أَنّي راغِبُ عَن مَعاشِرٍ","يَضنّونَ بِالوُدِّ القَليلِ وَأَسمَحُ",4,"ح",1,1],["أَبُثُّكَ مِن وُدّي بِغَيرِ تَكَلُّفٍ","وَأُرضيكَ مِن نُصحي بِغَيرِ رِياءِ",5,"ا",2,0],["أَبُثُّكَ ما لَقيتُ مِنَ اللَيالي","فَقَد قَصَّت نَوايِبُها جَناحي",6,"ي",1,1],["أَبُثُّكَ يا صَفِيَّ الدينِ حالي","وَلا يُشكى إِلى غَيرِ الكِرامِ",7,"م",1,1],["أَبُثُّكِ ما أَلقى وَفي النَفسِ حاجَةٌ","لَها بَينَ جِلدي وَالعِظامِ دَبِيبُ",8,"ب",1,0],["أبثُّكُمُ إني على النأي حافظٌ","ذمامَ الهوى لو تحفظون ذماميا",9,"ي",2,0],["أبثُّ صريحَ المدح أخرُج فيهِ من","قشوري فيأتي المدحُ فهو لباب",10,"ب",1,1],["أبثك يا أخا العلياء أني","سئمت من الليالي كم تروع",11,"ع",1,1],["أبثك إنّ عاذليَ المعنى","رآك بعين حبٍّ مثل عيني",12,"ن",2,0],["أَبُثُّها الوَجد وَهيَ لاهِيَةٌ","أَذهَلَها الحُبُّ فَهيَ تَفتَكِرُ",13,"ر",1,0],["أَبُثُّ لَكَ الشُكرَ الَّذي طابَ نَشرُهُ","وَأُطري بِما أُثني عَلَيكَ وَأُطرِبُ",14,"ب",1,0],["أَبُثَينَ هل تَدرِينَ كَم جَشَّمتِني","من عَقرِ ناجِيَةٍ وحَربِ مَوالِ",15,"ل",1,0],["أَبُثَينَ إِنَّكِ قَد مَلِكتِ فَأَسجِحي","وَخُذي بِحَظِّكِ مِن كَريمٍ واصِلِ",16,"ل",1,1],["أَبَثنَةُ لَلوَصلُ الَّذي كانَ بَينَنا","نَضا مِثلَما يَنضو الخِضابُ فَيَخلُقُ",17,"ق",1,0],["أَبثنَةُ ما تَنأَينَ إِلّا كَأَنَّني","بِنَجمِ الثُرَيّا ما نَأَيتِ مُعَلَّقُ",17,"ق",1,0],["أبث شعوري فيك غيرمقلد","واعرض آمالي ورأيي ومذهبي",18,"ب",2,0],["أَبُثُّكَ وَجدي يا حَمامُ وَأودِعُ","فَإِنَّكَ دونَ الطَيرِ لِلسِرِّ مَوضِعُ",19,"ع",1,1],["أَبَثُّ لِأَصحابِ السَفينِ غَوائِلاً","وَأَلأَمُ ناباً حينَ تَفغَرُ فاها",20,"ا",3,0],["أبُثُّكَ مجدَ المُلْكِ قولةَ صادقٍ","وكِذْبُ الفَتَى فيما يُحَدِّثُ حوبُ",21,"ب",1,0],["أَبُثُّكَ بِالأَشعارِ فَرطَ تَشَوُّقي","وَلا أَتَعاطى حَصرَ وَصفِكَ بِالشِعرِ",22,"ر",1,0],["أبثكِ بَيْنَاً ودمعاً جرى","فهذا حجازٌ وذا ينبعُ",23,"ع",1,0],["أَبُثُّكُم فيهِ جَوىً شَفَّني","حُمِّلتُهُ مِن حُبِّكُم مُثقِلا",24,"ل",2,0],["أَبُثُّ مَعَ البَليلِ إِلَيهِ شَوقي","فَتَبلُغُهُ وَقَد عادَت سَموما",25,"م",2,0],["أبثين إن أدنى العدو حمامي","بمسدس يوريه أَو بحسامِ",26,"م",1,1],["أبثين إن أودى جميلك خابطاً","بدم له اهريق فوق رغام",26,"م",1,0],["أبُثُّك أن الفؤاد الرقيقَ","يُمِضُّ به الحادث الفادح",27,"ح",1,0],["أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ","فإنك دونَ الطيرِ للسرِّ موضعُ",28,"ع",1,1],["أَبثك بَعض ما عِندي فَتَقضي","وَتَعلَم سرَّ ما أَخفي جِهارا",29,"ر",2,0],["أبثُّ لها الشكْوى وتُبْدِى ملاحة","إلى أن طوى أثوابَ ليلَتِنا الفجرُ",30,"ر",1,0],["أَبُثُّكُما وَجدي وَأَشكُو إِلَيكُما","جَوىً بَينَ أَثناءِ الحَشا لا يُفارِقُ",31,"ق",1,0],["أَبُثُّكِ مابي فَإن تَرحَمي","رَحِمتِ أَخا لَوعَةٍ ماتَ حُبّا",32,"ب",2,1],["أَبُثُّكُم يا أَهلَ وُدِّيَ إِنَّني","حِذارُ نَواكُم لِلتَواصُلِ رامِقُ",33,"ق",1,0],["أَبُثُّكِ وَجدي لَو أَصَختِ لِمَعمودِ","وَكَيفَ يُرجى عَطفُ صَمّاءَ صَيخودِ",34,"د",1,1],["أُبِثُّكُمُ أَنّي مَشوقٌ بِكُم صَبُّ","وَأَنَّ فُؤادي لِلأَسى بَعدَكُم نَهبُ",35,"ب",1,1],["أُبِثُّكَ مَجدَ الدَينِ حالاً سَماعُها","يَشُقُّ عَلى الأَمجادِ وَالكُبَراءِ",36,"ا",2,1],["أبثك ما بعد الندامة مغنم","لقد سلموا من في الحوادث سلموا",37,"م",3,1],["أبثك ما في الدهر مثلك ذو علاً","علا ذروة الشعرى ولا شاعر مثلي",38,"ل",2,0],["أبثثتُها وجدي فلمَّا أزمعتْ","لتبوحَ لي بكوامنِ الأسرار",39,"ر",1,0],["أُبُثُّكَ أم أَصُونُكَ يَا خَلِيلي","فَإنّ البَثَّ مِفتَاحُ الغَلِيلِ",40,"ل",1,1],["أَبث له الشَكوى فيحمر خدّه","حَياء وَأَعضائي من الوجد ترجف",41,"ف",1,0],["أبُثُّكَ أنّ الصّدرَ ضاق عن الجوَى","فدعْ عنك لَومي واتْركِ النّارَ في الزَّنْد",42,"د",1,0],["أبُثُّكَ ما بِي وماذا عَسَى","أبثُّك أعيا عَليَّ البَيانُ",43,"ن",1,1],["أبثُّك ما الحَديثُ به شجُونا","حَوادثَ ما يُصَدَّقُ أن تَكُونا",44,"ن",2,1],["أبثُّكَ ما سَهِرتُ له خُطوبا","مُوكَّلةً نَوائِبُها بِعَيني",45,"ن",2,1],["أبثُّكَ ما لِلعِيد عِندي وأبتَدي","أُهنِّيكَ باليَوم الَّذي ليسَ يَهنِينِي",46,"ي",1,0],["أبثّك فرْطَ اشتياقٍ إليْك","بهِ ظلَّ يعذرني مَنْ عذلْ",47,"ل",1,1],["أبثّ له شجوي فيزداد قسوةً","إذا قلتُ يوماً راقبِ الله في أمري",48,"ي",1,0],["أَبثْكَ شوقاً لي إليكَ أَقَلّه","يهدِّدُ مِن ركنًَي ثَبير وثَهْلاَنِ",49,"ن",1,0],["أبثك شوقاً لي إليك مضاعفا","لِنيرانِهِ بين الضلوع وقودُ",50,"د",1,0],["أبثك أني ما وجدت مشقة","ولم أر في الأسفار ما كنت أخشاه",51,"ا",2,1],["أبث لها وجدي وأبكي صبابة","فتضحك إعجاباً لما هي تسمع",52,"ع",1,0],["أُبثُّكَ يا جمالَ المُلْكِ أَّنِّي","سَكِرْتُ وما شَرِبْتُ كؤوسَ راحِ",53,"ح",1,0],["أَبُثُكَ أَني في يَدِ الحب مُوثَقٌ","فهل مُنْقِذٌ من ضاربٍ أَو مُطاعِنِ",54,"ن",1,1],["أبثّكَ يا بَحر النّدى أنّ مورِدي","ومَرعايَ ذا غيضٌ لديّ وذا جَدْبُ",55,"ب",1,0],["أبثّكَ من أشواق قلبي بعضها","وأنت بحال الوجد مني أفهم",56,"م",1,0],["ابث إِلى علياه بعض خلاله","وهذا لساني بالثناء له رطب",57,"ب",1,0],["أبثّ من لوعتي ما فاض عن كلمي","وإن تحجب في مكنوز إضماري",58,"ي",1,0],["أُبُّث الشِّعر أنىَّ كنتُ حُبِّى","وأرعاه بإيماني الأمين",59,"ن",1,0],["أبثأرٍ ضاع تبغينِيَ لا بل","حسدَ الفضلِ وقصداً للكمالِ",60,"ل",1,0],["أبثُّك عن قلبٍ أحبَّك صادقاً","إذا كان حبٌّ خدعةً وتملُّقا",61,"ق",2,0],["أبثك أشواقي إليكَ وإنما","أحنًّ إلى العلياء أو أتشوَّق",62,"ق",1,0],["أبثُّ الأسى وجداً بهيف غصونها","كأني من بعض الحمام السواجع",63,"ع",1,0],["أبثثتهُ الشكوى وكيف بمنزل","قد خفَّ مثل قطينهِ إسعافه",64,"ف",2,0],["أبثُّكَ ما بي أم كفاكَ نحولي","ففيه على وجدي أتَمُّ دليلِ",65,"ل",1,1],["أَبُثُّ ما بَيْنَهُمْ مِنْ مَذْهَبِي دُرَراً","حَجَبْتُها عَنْ ذَوي التَّقْلِيدِ والرِّيَبِ",66,"ب",1,0],["أبثُّهُ عُجَرِي حتّى يكون لها","كفيلَها وأُقضِّي عنده بُجَرِي",67,"ر",2,0],["أبثها بين أقوامٍ فيوهمني","بعضٌ بإيمانه والبعض نقال",68,"ل",1,0]]}