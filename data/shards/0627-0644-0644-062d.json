{"poems":[[93,"إني امرؤ لا شيء يطرب روحه","https://www.aldiwan.net/poem62762.html","عموديه"],[94,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[237,"يا من سبي العشاق حسنه","https://www.aldiwan.net/poem14715.html","مجزوء الكامل"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[487,"وغزالة لغزالة خضعت ولكن","https://www.aldiwan.net/poem24327.html","عموديه"],[500,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48788","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56020","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87693","السريع"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204908","الكامل"],[5145,"أعلمت أنا سيد الأنس","https://www.poetsgate.com/ViewPoem.aspx?id=108220",""],[5186,"مرحى! ضيوف مالها عد","https://www.poetsgate.com/ViewPoem.aspx?id=156446",""],[5461,"يوم ميلادي","https://www.poetsgate.com/ViewPoem.aspx?id=5242",""],[5701,"قالوا الأغاني قلت فيها صالح","https://www.poetsgate.com/ViewPoem.aspx?id=164626",""],[161,"السُّكَّرُ والسُّكَّرِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=157685",""],[6144,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=13694",""],[231,"لماذا أحبك !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79161&r=&rc=35",""]],"verses":[["اللَحنُ مِن قُمرِيَّةٍ أَو مُنشِدٍ","وَالزَهرُ في حَقلٍ وَفي بُستانِ",0,"ن",1,0],["اللَّحْدُ قَدْ ضمَّ الحَبيبْ","فَابْكِ يا قلبُ بما فيكَ",1,"ك",1,0],["أللحكام ما نجني","متى كنا لهم رزقا",2,"ق",2,0],["اللحمُ رِخْوٌ بدين","له نعومةُ قُطن",3,"ن",1,0],["اللَحظُ صارِمُهُ الصَقي","لُ إِذا رَنا وَالقَدُّ لَدنَه",4,"ن",2,0],["اللَّحْظُ شَزْرٌ للرَّقي","بِ إذا بدَتْ والطّعْنُ شَزر",5,"ر",1,0],["اللحظ سحر والدياجي عقيصة","وبنانها قضب الورق لفاقتي",6,"ت",2,0],["أللحبيبة أمشي وهي ظاعنة","أم للشبيبة أنْضو بُردها خلَقا",7,"ق",2,0],["أللحرية المفتون يدعى","ويرجى وهو للشهوات عبد",8,"د",1,0],["أللحرية العليا دعاة","همُ وهمُ لدنياهم عبيد",9,"د",1,0],["اللحد ضمّك لكن النفس احتظت","بنعيمِ مجد أنت فيه مجاورُ",10,"ر",1,0],["اللَحن ما صاغَتهُ أَفنانه","وَالشعر ما غَنىّ بِهِ ساجعه",11,"ع",2,0],["اللحم والعَجْم مع الرطوبه","والقَشْر في تركيبِها أُعْجُوبَه",12,"ه",1,0],["اللحن عندكمو شعور ذائب","واللحن فن عندنا متجمد",13,"د",1,0],["اللحم لحمي الغث أنهسه","عهدي بلحمي غير مستهس",14,"س",1,0],["اللحم والخبز الطري لهم","ولنا فتات الخبز والثرد",15,"د",1,0],["الّلحظه الماضيه ما عاد تنعاد","والقادم من العمر باالغيب تفنيده",16,"د",2,0],["اللحن مسروق لها ومكرر","والصوت نونوة ونبح كلاب",17,"ب",1,0],["اللَّحْمُ رِطْلٌ وَكِيلُو السُّكَّرٍ مَرَقًا","الحُلْوُ شَتَّى وَنَفْسٌ تَغْرِفُ الضَّرَرَا",18,"ر",2,0],["اللحم ابيض ومزقلط وبيتزفلط","والوش ده مش متخطط زي ام لتام",19,"م",1,0],["أللحسن ؟ كم قد لقيت الحسان","فما هجن بي ومضة من حنين !",20,"ن",1,0]]}