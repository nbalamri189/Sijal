{"poems":[[56,"بانت سليمى وأمسى حبلها انقضبا","https://www.aldiwan.net/poem27654.html","البسيط"],[85,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[94,"ترجو السعادة يا قلبي ولو وجدت","https://www.aldiwan.net/poem38910.html","البسيط"],[91,"من كان في المجد المؤثل راغبا","https://www.aldiwan.net/poem44986.html","الكامل"],[48,"لا تصحبن يد الليالي فاجرا","https://www.aldiwan.net/poem22573.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[108,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[98,"يوم الملتقي","https://www.poetsgate.com/ViewPoem.aspx?id=17501",""],[96,"أهوى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=15665",""],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[325,"ما تم أمر بلا سبق إلى قدر","https://www.aldiwan.net/poem61657.html","البسيط"],[371,"سالت جفون الهوى على قدر","https://www.aldiwan.net/poem16982.html","المنسرح"],[409,"هذا بلا ريب لكل أريب","https://www.aldiwan.net/poem34119.html","الكامل"],[469,"عصفت به ريح الخطوب زعازعاً","https://www.aldiwan.net/poem3113.html","عموديه"],[484,"عاقبتني بالصد وهو عصيب","https://www.aldiwan.net/poem36947.html","الكامل"],[484,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[543,"مراكش متفاخر متباه","https://www.aldiwan.net/poem47519.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48849","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48890","الكامل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138819",""],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99986","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55921","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80009","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107001","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137068",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94118","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115655","الرجز"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130051","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48322","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45768","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216798","البسيط"],[3883,"","https://poetry.dctabudhabi.ae/diwan/poem/97677","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94535","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66144","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66142","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204304",""],[4697,"الدار صدت","https://www.poetsgate.com/ViewPoem.aspx?id=22675",""],[4802,"ذهول","https://www.poetsgate.com/ViewPoem.aspx?id=33013",""],[4858,"من وحي اول زيارة لولدي الاسير","https://www.poetsgate.com/ViewPoem.aspx?id=138041",""],[4935,"آيات شعري من سما برهانها","https://www.poetsgate.com/ViewPoem.aspx?id=129467",""],[4119,"قلت تقول الله لا خائفا","https://www.poetsgate.com/ViewPoem.aspx?id=16247",""],[5055,"سواري الليل","https://www.poetsgate.com/ViewPoem.aspx?id=103418",""],[5055,"خفايا الكون","https://www.poetsgate.com/ViewPoem.aspx?id=120915",""],[5111,"عَلَى وَتَرِ الْحَنِينِ","https://www.poetsgate.com/ViewPoem.aspx?id=212447",""],[5129,"مقام الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=120509",""],[5277,"قصائدي البكماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210825",""],[307,"متى نعود أيا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=213657",""],[5324,"لاتنكروا بغداد فهي ملاذكم .","https://www.poetsgate.com/ViewPoem.aspx?id=207544",""],[5391,"يا الله يا علاّم باحوال ناسه","https://www.poetsgate.com/ViewPoem.aspx?id=25791",""],[5431,"للحيتان ...","https://www.poetsgate.com/ViewPoem.aspx?id=210256",""],[5437,"السر الدفين","https://www.poetsgate.com/ViewPoem.aspx?id=152567",""],[5542,"القدوم الى المدينة المنورة","https://www.poetsgate.com/ViewPoem.aspx?id=10028",""],[5736,"نخل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208488",""],[5776,"إليهم... هم","https://www.poetsgate.com/ViewPoem.aspx?id=199538",""],[5815,"رفراف","https://www.poetsgate.com/ViewPoem.aspx?id=190767",""],[5907,"رحلة الامس !","https://www.poetsgate.com/ViewPoem.aspx?id=176270",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[6093,"سَرِيْرَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202607",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""],[6113,"ياصاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=77904",""],[6127,"رحلة الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=192766",""],[6215,"شرقيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84933&r=&rc=7",""],[6228,"نعم سأنساك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85968&r=&rc=5",""],[2638,"تحية العلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87847&r=&rc=11",""],[6300,"نرجسيّة قلمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82865&r=&rc=36",""]],"verses":[["هَذي سَبيلي وَهَذا فَاِعلَمي خُلُقي","فَاِرضَي بِهِ أَو فَكوني بَعضَ مَن غَضِبا",0,"ب",2,0],["هذي سيوفك في الأجفان نائمة","والمشركون سيوف الله تُفنيها",1,"ي",3,0],["هذي سعادَةُ دُنيانا فكنْ رجلاً","إنْ شئْتَها أَبَدَ الآباد يَبْتَسِمُ",2,"م",1,0],["هذي سفائنهم تروح وتغتدي","ببضائع لم تُحص بالتعديد",3,"د",1,0],["هَذي سَجايا آلِ آدَمَ إِنَّهُم","لِثِمارِ كُلِّ ظُلامَةٍ أَشجارُ",4,"ر",1,0],["هذي سماؤكِ أنغامٌ وأضواءُ","غنّاكِ داودُ أم حياكِ سيناءُ",5,"ا",2,1],["هذي سفينُ اللهِ سارَتْ عليمًا","متراميًا في عيلمٍ مُتَرامِ",6,"م",1,0],["هذي سماؤك أنغام وأضواء","غنّاك داود أم حيذاك سيناء",7,"ا",2,1],["هذي سيوف الفاتحين من البلى","قذ صنتم أجفانها وشفارها",8,"ر",3,0],["هَذي سبيلُ الغابرينَ وَأنت في","آثارهِم فَاِنظر لماذا المرجعُ",9,"ع",1,0],["هَذي سبيلُ الغابرينَ وَأَنتَ في","آثارهِم فَاِنظر إذاً ما تصنعُ",9,"ع",1,0],["هَذي سَحابَةُ صَيفٍ عَنكَ يَقشَعُها","نورُ الشَمائِلِ وَالأَخلاقِ وَالفِطرِ",10,"ر",1,0],["هَذي سُيولٌ أَنّى يَقومُ لَها ال","عَذلُ وَما قامَ قائِمُ الحَجَرِ",11,"ر",1,0],["هذي سهام قد أصبت كل من","أخطا الصواب فكان غير مصيب",12,"ب",1,0],["هذي سيوفك محرمات دونه","لبكائهن تبسمت حجراته",13,"ت",2,0],["هذي سجية من ظعنت بوده","وبدا له في وجهك التقطيب",14,"ب",1,0],["هذي سبيل فهل من سالك سبلي","هذي يدي في يديكم يا بني وطني",15,"ن",2,0],["هذِي سِنونَ مَضَت لِرؤيَتِه ولَ","كن لم يَزل طَرفِي يَرَاهُ تُجَاهِي",16,"ه",2,0],["هذي سياسة من أراد لمصر أن","يجتاز سدّاً أو يشقَّ عبابا",17,"ب",2,0],["هذي سجاياك الكريمة خير ما","أورثته الأبناء والأحفاد",18,"د",1,0],["هذي سجية كل معشوق","ورب العشق صاغر",19,"ر",1,0],["هَذي سَوَابِقُ لا يمُتُّ بِمثْلَهَا","مَنْ قَدْ أَتَى خَلْفَ السُّكَيْت مُرْكضا",20,"ض",2,0],["هذي سطور كسيحٍ ما به أبداً","الا اللسان صحيحاً فيه ينطربُ",21,"ب",1,0],["هذي سما الدين فانظر كيف زينتُها","بأنجم العلم من أبنائها الزهرِ",22,"ر",1,0],["هَذِي سَبِيلُكُم وَتِلكَ سَبِيلُنَا","وَالمَوعِدُ الرَّحمَنُ بَعدَ زَمَانِ",23,"ن",1,0],["هذي سجيتك التي لم تتخذ","يوماً بها بدلاً ولا تحويلا",24,"ل",2,0],["هذي سفينته فاملك قيادتها","حتام في هائج الامواج تضطرب",25,"ب",1,0],["هذي سفينة فن بالمنى شحنت","والفضل في بحره العجاج أجراها",26,"ه",2,1],["هذي سيوفٌ تنتضى","وذي سهامٌ ترشقُ",27,"ق",1,0],["هذي سبيلُ المجد إن شئتم فلا","تَتواكلوا فيها ولا تتأخّروا",28,"ر",3,0],["هذي سُعودُك قد حيّتْ طوالِعُها","واستشْرَفَتْ من ثَناياها طلائِعُها",29,"ع",3,1],["هَذي سَفينة نَوح وَهِيَ مِن خَشَب","لَما جَرَت كان مَرساها عَلى الجَودي",30,"د",2,0],["هذي سعادة إنسان تخطّفها","لا تخفِ آثارَها في وجهك الحسن",31,"ن",1,0],["هَذي سبيلُ النّاس كلّهم","لا بدَّ سالكُها على سفرِ",32,"ر",1,0],["هذي سَجايانا وَيَشهَدُ خالِقي","ما كُنتُ في دَعوايَ أَفّا كَأردي",33,"د",2,0],["هذي سياسته وهذا بأسه","أما الخصال فأفعل التفضيل",34,"ل",1,0],["هذي سجنجل فرق خودٍ خيَّلت","لك عارضاً ما لم تنلهُ عذارى",35,"ر",2,0],["هذي سَبِيلُ المجدِ واضِحَةَ الصُّوا","مَحْمُودَةً غِبَّ السُّرَى آثارُها",36,"ر",3,0],["هذي سَبيلُ المجدِ إِنْ رُمْتَ العُلاَ","مما لِلْمُخادِعِ والهَوَى الكَذابِ",37,"ب",1,0],["هذي سبيل الخائب ال","كابي الزناد فلا تكنه",38,"ن",2,0],["هذي سوايانها وفعل ايدينا","اللي جرا كلنا نعرف أسبابه",39,"ب",2,0],["هذى سواتى...لا...ماهى سواتى","انا بخاتم ماعرف ....وين محجوز",40,"ز",1,0],["هذي سبيل الحقّ للأحرار لا تسمع لِقيلْ","مَن رامَ علّيينَ فلْيسلُكْ كما سلك الرّسولْ",41,"ل",1,0],["هذي سنية من غدت بمعارف","وعوارف تسمو على أقرانها",42,"ن",3,0],["هذي سجوف الملك مرفوعة","عن ملك أخباره كالعيان",43,"ن",1,0],["هذي سواري الليل يا عز لصحاب","رجواي يفهم لغزها من قراها",44,"ا",3,0],["هذي سوايا الوقت في أول وتالي","وهذا حصاد اليوم يا جاهل أسبابه",45,"ب",2,0],["هَذِي سُيُوفُ الْبِينِ تهْصُرُ مُهْجَتِيْ","فَالجُرْحُ يُدْمَى ، وَالفُؤَادُ تَوَرَّمَا",46,"م",2,0],["هذِي سَنَابِكُ خَيْلِهَا تَرَكَتْ عَلى","دَرْبِ الكَرَامَةِ لِلْكِرَامِ دَليلا",47,"ل",2,0],["هذي سلاطينُ الغرامِ تجيئني","وعليهمُ بالبوحِ والنجوى حكمتْ",48,"ت",1,0],["هذي سماؤك طول الدهرِ مُمْطرة","فوق الجناةِ لظىً ينهالُ بركانا",49,"ن",2,0],["هذي سواعد أهلها ..قد شمروا","عنها وقد رفعوا البناء وزوقوا",50,"ق",3,0],["هذي سبب ناسٍ تكن النحاسه","جهّال ما تملك من العقل مثقال",51,"ل",1,0],["هذى سرّا ولم يعرف","بأنّا نقرأ الهمسا",52,"س",2,0],["هذي سواة العاشقين","ياكل قصايد شاعرك",53,"ك",1,0],["هذي سقيفتها تلوح أمامنا","فنرى بها شمل الرجال جميعا",54,"ع",2,0],["هذي سماءٌ لنا في فيئها سكنٌ","وتلك أقمارنا بالسحر تغتسلُ",55,"ل",1,0],["هذي سطور الشعر خاوية","مني ولكني الذي هجما",56,"م",2,0],["هذي سحائبها زفّتْ بشائرها","فالغيثُ يهْميْ بعطْرٍ غير ‏منْصرمِ‎",57,"م",1,0],["هذي سنه مرت وماكنه يحس","يجي يشوف شلون وقتي حداني",58,"ن",2,0],["هذي سموم الغرب تسري بينا","تعمي البصيرة والصواب موزع",59,"ع",1,0],["هذي سَرِيرَتُهُ وتلكَ سَريرَتي","شَتَّان بينَ سَرِيرَةٍ وسَرِيرَةْ",60,"ه",1,0],["هَذي ( سَمَرْقَنْدٌ ) وَ تِلْكَ ( طُلَيطِلٌ )","وَ هُنا بَقايا المَجدِ في قرْطَاجِها",61,"ج",3,0],["هذي سلومي لاحشامقدر اطيش","ون ضاق صدري عالجته المحاني",62,"ن",2,0],["هذي سماتُهُمو أظماهمو قبسٌ","مذ لاحَ فيهِ مصاب الآل يبتهلُ",63,"ل",1,0],["هذي سطوري وهذا الشِعرُ مشتعلٌ","فليعبدوا الله في عينيكِ مَن كفروا",64,"ر",3,0],["هذي سنين مضت ما جئت تسألني","عما جرحتَ وما أَدْمَتْهُ كفّاكَ!!",65,"ك",1,0],["هذي سماؤك فأخفق أيها العلم","وأرقص مع النور لا تعلق بك الظلم",66,"م",1,1],["هذي سمائِي اليومَ ناعسة","أُقتلْ بأقمارِ الجوى الوَسَنا",67,"ن",2,0]]}