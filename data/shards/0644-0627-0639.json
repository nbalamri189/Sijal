.aldiwan.net/poem69026.html","الطويل"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[48,"إني لما سمت لركاب","https://www.aldiwan.net/poem10804.html","السريع"],[48,"لا أستزيد حبيبي من مواتاتي","https://www.aldiwan.net/poem62462.html","البسيط"],[48,"لست أرى لذة ولا فرحا","https://www.aldiwan.net/poem62502.html","المنسرح"],[48,"لأعذلن فؤادي أبلغ العذل","https://www.aldiwan.net/poem64989.html","البسيط"],[48,"لمن دمن تزداد حسن رسوم","https://www.aldiwan.net/poem65257.html","الطويل"],[48,"الدار أطبق إخراس على فيها","https://www.aldiwan.net/poem66195.html","البسيط"],[50,"قد أذهب الداء حسادي بكثرتهم","https://www.aldiwan.net/poem24522.html","البسيط"],[50,"حسبي بما قد لقيت يا عمر","https://www.aldiwan.net/poem63806.html","المنسرح"],[50,"يا طول هذا الليل لم أرقد","https://www.aldiwan.net/poem63954.html","السريع"],[46,"لا علم لي بم يختم العمر","https://www.aldiwan.net/poem22588.html","الكامل"],[15,"طاف الخيال علينا ليلة الوادي","https://www.aldiwan.net/poem45273.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[69,"","https://poetry.dctabudhabi.ae/diwan/poem/57224","السريع"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30506","البسيط"],[21,"","https://poetry.dctabudhabi.ae/diwan/poem/11042","الخفيف"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40678","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42595","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54923","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54992","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54668","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[77,"صدني عن لقاء نجلك عذر","https://www.poetsgate.com/ViewPoem.aspx?id=33930",""],[77,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[84,"أمن جنابهم النفح الجنوبي","https://www.poetsgate.com/ViewPoem.aspx?id=26368",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[33,"ألا أيُّهَا الشَّيْخُ الَّذِي مَا بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=2673",""],[45,"يُفَنِّدونَ وَهُمْ أدْنَى إلى الفَنَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31627",""],[51,"لا عرتك الخطوبُ يابن حريثٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30092",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[51,"قدم الإمامُ يسير تحت لوائه","https://www.poetsgate.com/ViewPoem.aspx?id=26054",""],[39,"إنَّ الفؤادَ هفَا للبائنِ الغردِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7469&r=&rc=9",""],[88,"إذا انقضى مارْتُ فاكسر خلفه الكوزا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""]],"verses":[["لا عُذرَ بَعدَ تَنائي الدارِ مِن سَكَنٍ","لِمُدَّعي الوَجدِ لَم يَدمَع لَهُ شانُ",0,"ن",1,0],["لا عادَتِ الكَأسُ عَليلَ النَسيم","بَعدي وَلا فُضَّت خِتامُ الهُموم",1,"م",1,1],["لا عَجيبٌ حِفظُ كَفٍّ لِبَنانٍ","وَوَفاءٌ مِن يَمينٍ لِشِمالِ",2,"ل",1,0],["لا عَجَبٌ إِن نَقيكُمُ حَذَراً","نَحنُ جُفونٌ وَأَنتُمُ مُقَلُ",3,"ل",1,0],["لَأَعاقِبَنَّكَ بِالغَليلِ فَإِنَّني","لَولاكَ لَم أَذُقِ الهَوى لَولاكا",4,"ك",2,0],["لَأَعراضُكُم عِندي أَشَدُّ مَهانَةً","مِنَ الحَنظَلِ العامِيِّ عِندَ النَواقِفِ",5,"ف",1,0],["لا عَجيبٌ أَنّي سَبَقتُ وَأَعرَق","تُ جِيادَ المَنثورِ وَالمَرصوفِ",6,"ف",1,0],["لا عَينَ تَنظُرُ إِن أَرسى بِعَقوَتِها","زَورٌ وَلا أُذُنٌ عِندَ النِداءِ تَعي",7,"ع",2,0],["لِأَعقِدَ مَجداً يُعجِزُ الناسَ حَلُّهُ","وَتَنحَلُّ مِن هامِ الأَعادي مَعاقِدُ",8,"د",1,0],["لا عُذرَ إِلّا أَن أَرى سُرباتِها","سَومَ الجَرادِ يَثورُ مِنها الأَبطَحُ",9,"ح",1,0],["لا عَزَّ أَخبَثُنا عِرقاً وَأَهجَنُنا","أُمّاً وَأَصلَدُنا زَنداً إِذا قُدِحا",10,"ح",2,0],["لا عُذرَ لي إِلّا ذَهابي عَنكُمُ","فَإِذا ذَهَبتُ فَيَأسُكُم مِن رَجعَتي",11,"ي",1,0],["لا عُلِّقَ المَوتُ نَفساً أَنتَ صاحِبُها","إِنَّ الحِمامَ مُحِبٌّ غَيرُ مَحبوبِ",12,"ب",1,0],["لا عَيْبَ بالسّيفِ إنْ رَقّتْ مضارِبُهُ","منَ النّحولِ ولا بالرُّمْحِ منْ قَضَفِ",13,"ف",1,0],["لا عُذْرَ للقَيْسيِّ يَضرِبُ طَوْقُهُ","طَرَفَ اللَّبانِ ولا يَسود فَطيما",14,"م",2,0],["لِأَعظَمِ حادِثٍ حُبِسَ الرَسولُ","وَأُمسِكَ عَنكَ وَاِنقَطَعَ الخَليلُ",15,"ل",1,1],["لا عارَ في الحُبِّ إِنَّ الحُبَّ مَكرُمَةً","لَكِنَّهُ رُبُّما أَزرى بِذي الخَطَرِ",16,"ر",1,0],["لا عَدِمْتَ الرِّضى منَ اللهِ والحُسْنى","كَما نصَّ وحْيُهُ والزِّيادَهْ",17,"د",2,0],["لاعَنْتُ أمَّ الصّبْرِ فيكَ وبَعْدَهُ","ورّثْتُ للأشْجانِ كنْزَ فؤادي",18,"د",2,0],["لاَ عَدْلَ فِي الْمُلْكِ إِلاَّ وَهْوَ قَدْ نَصَبَهْ","وَصَيَّر الْخَلْقَ فِي مِيَراثِهِ عَصَبَهْ",19,"ه",1,1],["لَأَعرِفَنَّكَ إِن جَدَّ النَفيرُ بِنا","وَشُبَّتِ الحَربُ بِالطُوّافِ وَاِحتَمَلوا",20,"ل",3,0],["لَأَعرِفَنَّكَ إِن جَدَّت عَداوَتُنا","وَاِلتُمِسَ النَصرُ مِنكُم عوضُ تُحتَمَلُ",20,"ل",1,0],["لَأَعطاكَ رَبُّ الناسِ مِفتاحَ بابِها","وَلَو لَم يَكُن بابٌ لَأَعطاكَ سُلَّما",21,"م",2,0],["لا عَداكِ السَماءُ وَالخِصبُ وَالأَم","نُ وَلا زِلتِ لِلسَلامِ رِباعا",22,"ع",2,0],["لا عادَ في حَلبٍ زَمانٌ مَرَّ لي","ما الصُبحُ فيهِ مِنَ المَساءِ بِأَمثَلِ",23,"ل",1,1],["لا عاجِزاً عِندَ حَملِ المُثقِلاتِ وَلا","يَمشي الهُوَينى كَما يَمشي الوَجى الوَجِلُ",24,"ل",1,0],["لا عيشَتي تَصفو وَلا رسمُ الهَوى","يَعفو وَلا جَفني يُصافِحُهُ الكَرى",25,"ر",2,0],["لَأَعذَرتَ لَمّا لَم يُمِلَّكَ مُكثُهُم","إِذا عَذَرَ المُستَثقِلُ المُتَثاقِلُ",26,"ل",1,0],["لا عَدا حَظَّكَ إِقبالٌ تُرى","قاضِياً أَثناءَهُ كُلَّ وَطَر",27,"ر",1,0],["لا عقوبة لهما","حللت ولا عذل",28,"ل",1,0],["لا عَيْشَ إِلاَّ بِالمُنَى وَشَكِيَّتِي","أَنِّي قَصَرْتُ عَلَى رِضَاكِ مُنَايَا",29,"ا",3,0],["لا عَلَى الذَّاهِبِينَ لَكِنْ عَلَيْنَا","حِينَ يَمْضُونَ تَسْتَدِرُّ الشُّؤُونُ",30,"ن",1,0],["لا عِتَابٌ وَهَذِهِ","سُنَّةُ الدَّهْرِ مِنْ قِدَمْ",31,"م",1,0],["لا عذر لي أَنْ كنتُ فيه مقصِّراً","سدَّت صفاتك أوجهَ الأعذار",32,"ر",1,1],["لا عذر للمسلمين اليوم إن وَهَنُوا","في هوشة ذلّ فيها كل مَن وَهَنا",33,"ن",2,0],["لِأَعظَمِ غَدرَةٍ نَفَشوا لِحاهُم","غَداةَ العِرقِ أَسفَلَ مِن سَنامِ",34,"م",1,0],["لا عين نارك عن سارٍ مغَمَّضَة","ولا محلتك الطأطاء والدَّغلُ",35,"ل",1,0],["لاعَن أَبي مُسلِمٍ في نُصحِهِ صَفَحوا","وَلا الهُبَيرِيَّ نَجّى الحِلفُ وَالقَسَمُ",36,"م",1,0],["لا عَيبَ بِالقَومِ مِن طولٍ وَلا عِظَمٍ","جُسمُ البِغالِ وَأَحلامُ العَصافيرِ",37,"ر",1,0],["لا عيبَ فيه سوى تعجيلِ أنعمهِ","فما يلذّ برجوى بعد إرجاء",38,"ا",2,0],["لا عيبَ في نعماهُ إلا أنَّها","تسلي عن الأوطانِ والقرباء",39,"ا",2,0],["لا عدمنا قصصاً للمدح فيهم","داعياً كالنمل وفد الشعراء",40,"ا",2,0],["لأعرض عن رجوايَ عطفك مرةً","فأعرض عنِي سادةٌ وصِحاب",41,"ب",1,0],["لا عدَت بابكَ السعودُ فقد أض","حى لوفدِ الأشعار أنجح باب",42,"ب",1,0],["لا عجب قاضي قضاةِ الورَى","وافَى وفي خدمتِه حاجب",43,"ب",1,0],["لا عجيبٌ إذا جلبت ليَ الض","رَّ فهذي عاداتُ عيني وقلبي",44,"ي",1,0],["لا عيبَ فيهِ سوى علياء معجزة","فيها لأهلِ العُلى قِدماً نكايات",45,"ت",1,0],["لاعبُ شطرنجٍ بفصل الشتا","عشقته ويلاهُ من بُهْتِه",46,"ت",2,1],["لا عيبَ في بعضِ الكرامِ سوى ندًى","متعمّق للمرءِ عند صِلاته",47,"ه",1,1],["لا عيبَ فيها سوى ريق على بَرد","مبرِّد في الشتا والصيف ثلاَّج",48,"ج",1,0],["لا عيبَ في مجده العالي سوى أذُنٍ","في الجود لا 