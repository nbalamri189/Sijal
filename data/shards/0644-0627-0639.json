,"فأسلو عنْ نواحي في النواحي",147,"ح",2,0],["لا عبْتُ بالشطرنجِ مَنْ","أضحى كشمسٍ طالعَهْ",148,"ه",1,1],["لا عادَ عُمْرٌ مضى لي","في الحكمِ غالٍ بساعهْ",149,"ه",1,1],["لا عدمِناك مروجاً للهوى","جدَة فيها وللدهر اقتبال",150,"ل",1,0],["لاعَبَ تِلكَ الريحَ ذاكَ اللَهَبُ","فَعادَ عَينَ الجِدِّ ذاكَ اللَعِبُ",151,"ب",1,1],["لاعِنَباً أَمتَصُّ عُنقودَهُ","ثَدياً كَأَنّي بَعدُ في المَهدِ",152,"د",1,0],["لَأَعطَيتُ في لَيلى الرِضا مَن يَبيعُها","وَلَو أَكثَروا لَومي وَلَو أَكثَروا القَرضا",153,"ض",2,0],["لا عُذرَ لِلقَومِ إِن قُلتُ اِنفِروا فَأَبَوا","الحَزمُ مُستَنفِرٌ وَالرَأيُ مُنتَدَبُ",154,"ب",1,0],["لا عَهدَ أَشأَمَ مِن عَهدٍ لَهُم جَمَحَت","فيهِ النُفوسُ وَضَلَّت في مَساعيها",155,"ي",3,0],["لا عَذَّبَ اللَهُ الكِنانَةَ إِنَّها","لَتُغادِرُ الحُرَّ الكَريمَ مُعَذَّبا",156,"ب",2,0],["لأعظَمِ مطلبٍ وأجلِّ سُولِ","لِدينِ اللهِ دينِ ذوي العُقُولِ",157,"ل",1,0],["لا عُذرَ للمصروفِ عن رُشدِهِ","لم يَبْقَ من داجٍ ولا مجهَل",158,"ل",1,0],["لِأَعلَمَ كَيفَ اِستَهلَكَ الهَجرُ مَعشَراً","وَكَيفَ قَضوا يَأساً بِهَذي البَلابِلِ",159,"ل",1,0],["لا عَرَفتُ الوَفا وَلا كانَ وَعدٌ","يَجعَل البَسمة الوَديعة حِقدا",160,"د",2,0],["لا عَزَّ نَصرُ اِمرِئٍ أَضحى لَهُ فَرَسٌ","عَلى تَميمٍ يُريدُ النَصر مِن أَحَدِ",161,"د",1,0],["لا عاجِزَ الرَأيِ وَلا بَليدا","لَكِن شُجاعاً يَخضِبُ الحَديدا",162,"د",2,0],["لا عَيشَ إِلّا بِكَفِّ ساقِيَةٍ","ذاتَ دَلالٍ في طَرفِها مَرَضُ",163,"ض",1,1],["لا عُذرَ لِلعاذِلِ في الكاسِ","فَما أَرى في الكاسِ مِن باسِ",164,"س",1,1],["لَأَعطى أَبا حَفصٍ يُديرُ عِنانَها","وَما شَكَّ فيهِ وَالأُمورُ إِلى قَدرِ",165,"ر",1,0],["لا عَيبَ فيهِ سِوى إِذاعَتِهِ","سِرَّ الَّذي في حَشاهُ يَحتَجِبُ",166,"ب",1,0],["لا عُذرَ لي في سِمَتي وَلِمَّتي","سَيّانَ مِن شَيبٍ وَشَعرٍ لَم يَشِب",167,"ب",1,0],["لأُعَفِّرَنَّ بأَرْضِكُمْ خَدِّي مِنْ","مَمْشَى المَهَا وَمَراتِعِ الآرامِ",168,"م",1,0],["لاعبتهُ الشطرنجَ في خَلوةٍ","حُكمَ مُطاعٍ في الذي قد يُريد",169,"د",1,0],["لأعرِفَنّ الأديمَ السّابِرِيَّ إذا","ما راحَ في سابرِيّ النسجِ ماذِيّ",170,"ي",1,0],["لأعَطِّشَنّ الرّوْضَ بعدهُمُ ولا","يُرْوِيهِ لي دَمْعٌ عليه هَتُون",171,"ن",1,0],["لا عُرّيَتْ منكَ الليالي إنّهَا","بك حُلِّيَتْ والذّاهباتُ عواطِل",172,"ل",1,0],["لأعْرُقَنّ زماناً راب حادِثُهُ","إذا استَمَرّ فَألقَى بالمَقَاليد",173,"د",1,0],["لا عائِفاً شَيئاً وَلَو شيبَ لي","مِن يَدِكَ العَلقَمُ وَالصابُ",174,"ب",1,0],["لا عُذرَ لِلصَبِّ أَن تَهوى جَوانِحُهُ","وَقَد تَطَعَّمَ فوهُ بِالمُواتاةِ",175,"ت",3,0],["لا عَيشَ إِلّا المُدامُ أَشرَبُها","مُغتَبِقاً تارَةً وَمُصطَبِحا",176,"ح",2,0],["لَأَعذَلَنَّ فُؤادي أَبلَغَ العَذَلِ","حَتّى أُنَهنِهَهُ عَن مِثلِ ذا العَمَلِ",177,"ل",1,1],["لَأَعلَمَ ما تَأتي وَإِن كُنتُ عالِماً","بِأَنَّكَ مَهما قُلتَ غَيرِ مَليمِ",178,"م",1,0],["لَأَعطافِهِنَّ عَلى الصَهباءِ عَن دِمَنٍ","لَم يَبقَ مِن عَهدِها إِلّا أَثافيها",179,"ي",3,0],["لا عِشتُ خِلواً مِنَ الحُسّادِ إِنَّهُمُ","أَعَزُّ فَقداً مِن اللائي أَحَبّوني",180,"ي",1,0],["لا عَهدَ لي بالرَسولِ يُخبِرُني","عَنها فَنَفسي مِن ذاكَ تَستَعرُ",181,"ر",1,0],["لا عَيبَ فيها غَيرَ تَأخيرِها","كُلَّ صَباحٍ وَعدَنا في غَدِ",182,"د",1,0],["لا عِلمَ لي بِمَ يُختَمُ العُمرُ","شَجَرُ الحَياةِ لَهُ الرَدى ثُمرُ",183,"ر",1,1],["لَأَعرِفَنَّكَ بَعدَ المَوتِ تَندُبُني","وَفي حَياتِيَ ما زَوَّدتَني زادي",184,"ي",1,0],["لا علم إلا كنت حي","ناً منه خواض الغمار",185,"ر",1,0],["لا عتب لي عَلى ال","أيام وَالقدر",186,"ر",1,0],["لا عذَّلي من حزبِ خيرٍ ولا","آراؤُهُمْ في سلوتي عاليَهْ",187,"ي",2,0],["لَأَعطَيتُها ما جاءَ يَبغي رَسولُها","وَقُلتُ لَها بَعدَ اليَمينِ سَليني",188,"ي",1,0],["لا عِشْتُ إِنْ مُتَّ لِي يا واحِدِي أَبداً","ومَوْتُنا واحِدٌ لا شَكَّ مرئِيُّ",189,"ي",1,0],["لا عَلى كَوكَبٍ بِنوءٍ وَلا","ريحٍ جَنوبٍ وَلا تَرى طَخرورا",190,"ر",2,0],["لا عيب فيه أدام الله دولته","إلاّ عزائم مجدٍ عندهنَّ شره",191,"ر",2,0],["لا عَيْبَ فِيَّ سِوَى حُرِّيَّةٍ مَلَكَتْ","أَعِنَّتِي عَنْ قَبُولِ الذُّلِّ بِالْمَالِ",192,"ل",1,0],["لا عَيْشَ إِلَّا لِلنَّفَادِ","فَاحْبِبْ حَيَاتَكَ أَوْ فَعَادِ",193,"د",1,1],["لا عَيْنُه تَسْهُو وَلا تُخْفَى عَلى","ذَاكَ الضَّمِيرِ مُخبآتُ ضَمَائِرِ",194,"ر",1,0],["لاَ عَارَ عِنْدَهُمْ كَخَلْعِ نِسائِهِمْ","أَسْتَارَهُنَّ وَلَوْ فَعَلْنَ ثَكَالَى",195,"ل",2,0],["لاَ عَجَبٌ إِنْ قَضى لِسَاعَتهِ","وَمَا بِه عِلَّةٌ وَلاَ مَرَضُ",196,"ض",1,0],["لاَ عَزْمَ يَدْفَعُ مَا دَهَاكَ وَلاَ","صَوْتٌ عَلَى عَادِيكَ يَسْتَعْدي",197,"د",2,0],["لاِعْتِدَالِ الجَوِّ فِيهِ عِزَّةٌ","بِالْتِوَاءِ الشَّجَرَاتِ البَاسِقَاتْ",198,"ت",1,0],["لاعِباً حَتَّى إِذَا ضَاقَ بِهِ","مَلْعَبُ الدُّنْيَا تَخَطاهُ وَمرا",199,"ر",2,0],["لاَ عُمْرُهُ المَفْقُودُ عِلَّةَ بَثِّهِ","كَلاَّ وَلاَ نُعْمَى الثَّرَاءِ الذَّاهِبِ",200,"ب",1,0],["لاعذر لا لاعذر أنظرني إذن","لغد إذن فجر النهار الثاني",201,"ن",2,0],["لا عُذرَ لمادِحِهِ إن لَمْ","يدفق بغرِيبٍ يَنْقُدهُ",202,"د",2,0],["لا على سُلطانه يخشى، ولا","يَرْهَبُ الفقرَ إذا الفقرُ اعتراهْ",203,"ا",2,0],["لا عيب فيك، سوى كأس تضاجعُعا","في النوم، تغنيك عن زوجٍ وأصهار",204,"ر",1,0],["لا عدمت الرضا من الله والحسنى","كما نص وحيه والزيادة",205,"د",2,0],["لا عادَ يومٌ نالَ مِنْك ولا أتَتْ","سَنَة ٌ به ما اللَّيْلُ أبدى كَوْكَبا",206,"ب",2,0],["لا عشت إن مت لي يا واحدا ابدا","وموتنا واحد لا شك مرئي",207,"ي",1,0],["لا عن بيوت المال كان إذا انتمى","يُقصَى ولا عن بابهم مدفوعا",208,"ع",2,0],["لا عرَتْ أرضُكِ من لطفٍ فقد","ضَمِنَ الحسنَ لها جوٌ لطيف",209,"ف",1,0],["لا عيبَ فيه سوى إسرافِهِ كرماً","يومَ النَّوال ولولا ذاك لم يُعَب",210,"ب",1,0],["لأعطيت في ليلى الرضا من يبيعه","ولو أكثروا لومي ولو أكثروا القرضا",211,"ض",2,0],["لا عَيْشُ وَجْرَةَ يُنْسِي عَهْدَ ذي سَلَمٍ،","وَلاَ هَوَى القُرْبِ يُسْلي عن هَوَى البُعُدِ",212,"د",1,0],["لا عرتك الخطوبُ يابن حريثٍ","لا ولا نالكَ الفناءُ الوشيكُ",213,"ك",1,1],["لا عجولٌ على العقول جهولٌ","بل حليمٌ عنهنَّ في غير ضَعفِ",214,"ف",1,0],["لا عيبَ عند ذوي التُّعنتِ فيهما","إلا انفرادُهما من النظراء",215,"ر",3,0],["لا عزَّ نصرُ امرىء ٍ أضحى لهُ فرسٌ","عَلى تَميمٍ يُريدُ النَّصْرِ مِنْ أحَدِ",216,"د",1,0],["لا عاش من لا يخوض الموت مرتضيا","بقاءَه بعصيّ الذل موكوزا",217,"ز",2,0]]}