s://www.poetsgate.com/ViewPoem.aspx?id=184596",""],[5187,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=33000",""],[5187,"أحلام هاربة","https://www.poetsgate.com/ViewPoem.aspx?id=32997",""],[5224,"قد تجلى جماله جلوات","https://www.poetsgate.com/ViewPoem.aspx?id=121312",""],[5269,"طَعْنُ الكُماة ورَكْضُ الجِياد","https://www.poetsgate.com/ViewPoem.aspx?id=81494",""],[5277,"ذاكرةُ النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=186653",""],[5277,"طعمُ العَرُوب","https://www.poetsgate.com/ViewPoem.aspx?id=203515",""],[308,"ظَنَنْت العَبْد عَن مصر تسلى","https://www.poetsgate.com/ViewPoem.aspx?id=189405",""],[5304,"الضيقه","https://www.poetsgate.com/ViewPoem.aspx?id=155915",""],[5351,"حسناً سأحدث","https://www.poetsgate.com/ViewPoem.aspx?id=202715",""],[5376,"أبحَرْتُ في عيْنَيْكِ موجاً هائجا","https://www.poetsgate.com/ViewPoem.aspx?id=205067",""],[5397,"بآل محمدٍ عرف الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=157900",""],[5431,"كلّي دموعٌ والفرات صلاتي","https://www.poetsgate.com/ViewPoem.aspx?id=186984",""],[5431,"شفاهٌ من القلب المراقِ تُخَضّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=198270",""],[5431,"وعشقك السيل لاحدٌ ولا وسطُ","https://www.poetsgate.com/ViewPoem.aspx?id=199798",""],[5431,"هذا بعلي!!....","https://www.poetsgate.com/ViewPoem.aspx?id=201150",""],[5431,"على لسان ابليس!!....","https://www.poetsgate.com/ViewPoem.aspx?id=202708",""],[5431,"الحب المجلجل...","https://www.poetsgate.com/ViewPoem.aspx?id=210261",""],[5431,"أما اكتفيت؟","https://www.poetsgate.com/ViewPoem.aspx?id=212797",""],[5436,"السفر الى ضفاف الرافدين (محمود محمد أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=58602",""],[5444,"أمة الخيرية","https://www.poetsgate.com/ViewPoem.aspx?id=185388",""],[5444,"أمة الخيرية","https://www.poetsgate.com/ViewPoem.aspx?id=205442",""],[5464,"القتلى لن يُحييهم الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=125401",""],[5664,"فصل الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=176680",""],[5704,"بلاد العرب","https://www.poetsgate.com/ViewPoem.aspx?id=197638",""],[5720,"الذَّاكِرونَ اللهَ","https://www.poetsgate.com/ViewPoem.aspx?id=202697",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[5725,"سلام على بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=180137",""],[5756,"السفينة","https://www.poetsgate.com/ViewPoem.aspx?id=5180",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5763,"طعنٌ بلا موتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27067",""],[5848,"حبيبة قلبي البارح","https://www.poetsgate.com/ViewPoem.aspx?id=53161",""],[5848,"يضيع الشارع بصمتي","https://www.poetsgate.com/ViewPoem.aspx?id=48996",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[5956,"رأيٌ في الصداقة *","https://www.poetsgate.com/ViewPoem.aspx?id=184175",""],[6045,"لا تيأس","https://www.poetsgate.com/ViewPoem.aspx?id=138521",""],[6069,"ومضرج الوجنات تحسبها","https://www.poetsgate.com/ViewPoem.aspx?id=105649",""],[6069,"يا صاح هل لك في احتمال تحيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105719",""],[6093,"بنك الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=205829",""],[6202,"القتل فيكم قد وجبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86743&r=&rc=44",""],[1583,"ثمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73057&r=&rc=14",""],[2588,"شاخصة ( افتئات)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65586&r=&rc=18",""],[2944,"شكوى العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86015&r=&rc=4",""]],"verses":[["طعينا وما في مثله طعن خنجر","بأعظم من أن يزدريه مخاطبه",0,"ب",2,0],["طَعِمنا وَأَطعَمنا القَنا مِن دِمائِهِ","وَسارَت بِآمالِ الرِجالِ صُدوعُ",1,"ع",1,0],["طَعَنتَ ظَلامَهُ بِالرَكبِ حَتّى","رَأَيتَ لَهُ اِنجِياباً وَاِنعِطاطا",2,"ط",2,0],["طَعَنوا الظَلامَ بِكُلِّ ناجِيَةٍ","في موقِ كُلِّ دُجىً لَها بَحصُ",3,"ص",1,0],["طَعَنتَ بِالحُجَّةِ الغَرّاءِ ثَغرَتَهُ","وَرُمحُ غَيرِكَ فيهِ العَيُّ وَالحَصَرُ",4,"ر",1,0],["طَعناً كَما صَبَّحَ الغُدرانَ مُمتَحِنٌ","رَمى فَشَتَّتَ شَملَ الماءِ بِالحَجَرِ",5,"ر",1,0],["طَعمُ ثَناياها بُعَيدَ الكَرى","أَخبُرُهُ مِنها بِلا خُبرِ",6,"ر",1,0],["طَعامُ العِراقُ المُستَفيضُ الَّذي تَرى","وَفي كُلِّ عامٍ حُلَّةٌ وَدَراهِمُ",7,"م",1,0],["طَعَنْتَ خاصِرَةَ الفاروقِ مُنتَقِماً","من الحَنيفَةِ في أعلى مَجاليها",8,"ي",3,0],["طَعَنتُهُ بِقَوِيِّ المَتنِ مُعتَدِلٍ","صَدقِ الأَنابيبِ كَالخَطِيِّ خَطّارِ",9,"ر",1,0],["طعانٌ يَفُضُّ الجُدلَ عَن آنُفِ الشَبا","وَضَربٌ بِبيضٍ أَخلَصَتها الصَياقِلُ",10,"ل",1,0],["طعامُك من دار النعيم بعثْتَهُ","فشرَفتَه من حيث أدري ولا أدري",11,"ر",2,1],["طعام الناس أعجب ما أحبّوا","فمنه حياتهم وبه الحِمام",12,"م",1,0],["طَعنٌ إِذا خِفتُ الهَوانَ بِبَلدَةٍ","وَأَخو المَضاعِفِ لا يَكادُ يَريمُ",13,"م",1,0],["طعنتُها أسفلَ وَجْعائها","فانبجست من ثُقْبها الأعلى",14,"ل",2,0],["طعامُك إطعامُ الطعام ولم يزلْ","لديك طعام يا ابنَ يحيى مُقدَّما",15,"م",2,0],["طعامٌ لا وخامةَ فيه تُخشى","وفي المعروف أطعمةٌ وِخامُ",16,"م",1,0],["طعنوك يا وطني المفدى","في الصدر حتى كدت تردى",17,"د",2,1],["طعنت الأشم الأبىّ العيوف","الأنوف السميك العريق الطويلا",18,"ل",2,0],["طعنت الصحافة في أنفها","طعنت الرصيف الحصيف النبيلا",18,"ل",2,0],["طعنت الجوائب في ربها","ولم تخش جورجي بها أو مشيلا",18,"ل",2,0],["طَعامُ الفَقيرِ وَحَلوى الغَنِيِّ","وَزادُ المُسافِرِ وَالمُغتَرِب",19,"ب",1,0],["طُعِنَت فَاِنبَجَسَت فَاِستَصرَخَت","فَأَتاها حينُها فَهيَ خَبَر",20,"ر",1,0],["طعمه الأنبياء قون حلال","وبلاغ الأبرار والأخيارِ",21,"ر",1,0],["طَعَنَ التَلَهُّفُ قَلبَهُ فَفُؤادُهُ","مِن غَيرِ طَعنَةِ فارِسٍ مَطعونُ",22,"ن",1,0],["طِعانُ عَمرِو كُلثومٍ وَنائِلُهُ","حَذوَ السُيورِ الَّتي قُدَّت مِنَ الأَدَمِ",23,"م",1,0],["طَعنَ الدُّستورَ في مَقتلهِ","فَلَوى قَرْنَيْهِ مَن يلوِي الرِّماحا",24,"ح",2,0],["طَعَامُ السُّوءِ مَسْمُومٌ وهذا","أخِي جبريلُ بالأنباءِ جَاءَ",25,"ا",2,0],["طَعَامُ كلِّ فَتىً للَّهِ مُنتَدَبٍ","لا يغمدُ السَّيْف عَمَّنْ يُطعِمُ الصَّنما",26,"م",2,0],["طَعنٌ وضَربٌ يعافُ البأسُ عندهما","سِلاحَ من طَعنَ الأبطالَ أو ضربا",27,"ب",2,0],["طَعَنَت بِالجَيشِ بِها هادِياً","خَوفَ مَلاقيها وَأَهضامِها",28,"م",3,0],["طَعمُ كَأسي مُرٌّ إِذا لَم تَزُرني","وَهوَ يَحلو إِذا رَأَيتُكَ عِندي",29,"ي",1,0],["طَعْنٌ يُكوِّرُ هذا في فريصة ذا","كأنّ في كلّ شِلْوٍ بطنَ ملحود",30,"د",1,0],["طعنتهُ فانثنى فقلتُ له","والرمح منّي في العينِ من كفَلِه",31,"ل",2,0],["طَعمُهُ مِن ذَوبِ شُهدٍ","شيبَ بِالماءِ الفُراتِ",32,"ت",1,0],["طِعانٌ كُلَّ حينٍ أَو ضِرابٌ","يَموتُ بِها طَعينٌ أَو ضَريبُ",33,"ب",1,0],["طَعامُ غَنِيِّ الإِنسِ وَالفاقِدِ الغِنى","سَواءٌ إِذا ما غَيَّبَتهُ الحَناجِرُ",34,"ر",1,0],["طَعَنوا بِمُرّانِ الوَشيجِ فَما تَرى","خَلفَ الأَسِنَّةِ غَيرَ عِرقٍ يَشخَبُ",35,"ب",1,0],["طعامُ مَنْ لستُ له ذاكراً","دقَّ كما دَقَّ بأن يُذْكرا",36,"ر",2,1],["طَعَنَّاً حُبَيْشاً طَعْنَةً ظَلَّ بَعْدَهَا","يَنُوءُ حُبَيْشُ لِلْيَدَيْنِ ويُنْزَفُ",37,"ف",1,0],["طعامها من فُتات العيش مسغبةٌ","وريُّها منهُ إيلامٌ وإشقاءُ",38,"ا",2,0],["طَعْنَةٌ إِثْرَ طَعْنَةٍ فِي حَشَاهَا","آهِ مِمَّا جَنَى عَلَيْهَا الحِمَامُ",39,"م",1,0],["طعَامُهُمُ لَوْنٌ وَلَكِنْ مُيَسَّرٌ","وَمَشْرَبُهُمْ عَذْبٌ بِلا رَنَقٍ يَجْرِي",40,"ر",2,0],["طَعَنّا طَعْنَةً حَمْراءَ فِيهمْ","حَرامٌ رَأْبُها حَتَّى المَماتِ",41,"ت",1,1],["طَعِمتُ الهَوى في لَحظَةٍ وَشَرِبتُهُ","فَلَم أَستَطِع نَحوَ السُلُوِّ نَشاطا",42,"ط",2,0],["طَعَنتُ فُؤادي مِن بَعيد وَهكَذا","قَنا اللَحظ يَبلُغنَ النُجومَ شِطاطا",42,"ط",2,0],["طِعانُ يومٍ ضاحكٍ مُستَبشِرِ","لم تَعثُرِ الخيلُ بهِ في عِثْيَرِ",43,"ر",1,0],["طعنوا في الصميم من يركُن","الشعبُ إليه ونصبَّوا القُطَّاعا",44,"ع",2,0],["طعنتُه بالقوافي فانثنى فَرَقاً","يشكو إلى الله وقع ِ المقْولِ الَّرب",45,"ب",1,0],["طُعمَتْ مصافحتي له إذ زرته","فقبضت من ظلّ الخيال النافر",46,"ر",1,0],["طِعانٌ كلَّ حينٍ، أو ضِرابٌ،","يموتُ به طعينٌ، أو ضريبُ",47,"ب",1,0],["طعنته أطماع السياسة طعنة","نفذت فراح السلم وهو قتيل",48,"ل",1,0],["طعامُك إطعامُ الطعام ولم يزلْ","لديك طعام يا بنَ يحيى مُقدَّما",49,"م",2,0],["طعنت فؤادي برمح القوام","وقديت قلبي بسيف المقل",50,"ل",1,1],["طعانة فعالة قتالة","لكن إلى الصدقاء والأصحاب",51,"ب",