{"poems":[[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[53,"لمن الديار طلولها وقص","https://www.aldiwan.net/poem30177.html","الكامل"],[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[53,"شيمي لحاظك عنا ظبية الخمر","https://www.aldiwan.net/poem30460.html","البسيط"],[55,"يا من تمادى قلبه في الهوى","https://www.aldiwan.net/poem26347.html","السريع"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[71,"لما تشكى ابن عصرون إلي حمى","https://www.aldiwan.net/poem3816.html","البسيط"],[35,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[83,"طعامك من دار النعيم بعثته","https://www.aldiwan.net/poem54300.html","الطويل"],[88,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[51,"هاجرني ظلما أبو حفصل","https://www.aldiwan.net/poem7968.html","السريع"],[51,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[89,"طعنوك يا وطني المفدى","https://www.aldiwan.net/poem44659.html","مجزوء الكامل"],[85,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[85,"أرى شجراً في السماء احتجب","https://www.aldiwan.net/poem8087.html","المتقارب"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[62,"حكمة أخفيت عن الناس طرا","https://www.aldiwan.net/poem52188.html","الخفيف"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[105,"سائلوا الأبطال هل ملوا الكفاحا","https://www.aldiwan.net/poem42054.html","الرمل"],[105,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[105,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[105,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[52,"بأبي هل ملأت عينا بشيء","https://www.aldiwan.net/poem27114.html","الخفيف"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[48,"سقيا لظبي كالرمح في عدله","https://www.aldiwan.net/poem66276.html","المنسرح"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[46,"تريب وسوف يفترق التريب","https://www.aldiwan.net/poem22096.html","الوافر"],[46,"دع القوم سلوا بالضغائن بينهم","https://www.aldiwan.net/poem22527.html","الطويل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[76,"طعام من لست له ذاكرا","https://www.aldiwan.net/poem39320.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67296","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43645","الطويل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50221","الرجز"],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[80,"هجرَ الخيالُ فزرته بالخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=3222",""],[46,"تريبُ، وسوف يفترقُ التريبُ،","https://www.poetsgate.com/ViewPoem.aspx?id=2688",""],[51,"ليهنَكَ أن أفطرتَ لا متطلعاً","https://www.poetsgate.com/ViewPoem.aspx?id=30406",""]],"verses":[["طَعِمنا وَأَطعَمنا القَنا مِن دِمائِهِ","وَسارَت بِآمالِ الرِجالِ صُدوعُ",0,"ع",1,0],["طَعَنتَ ظَلامَهُ بِالرَكبِ حَتّى","رَأَيتَ لَهُ اِنجِياباً وَاِنعِطاطا",1,"ط",2,0],["طَعَنوا الظَلامَ بِكُلِّ ناجِيَةٍ","في موقِ كُلِّ دُجىً لَها بَحصُ",2,"ص",1,0],["طَعَنتَ بِالحُجَّةِ الغَرّاءِ ثَغرَتَهُ","وَرُمحُ غَيرِكَ فيهِ العَيُّ وَالحَصَرُ",3,"ر",1,0],["طَعناً كَما صَبَّحَ الغُدرانَ مُمتَحِنٌ","رَمى فَشَتَّتَ شَملَ الماءِ بِالحَجَرِ",4,"ر",1,0],["طَعمُ ثَناياها بُعَيدَ الكَرى","أَخبُرُهُ مِنها بِلا خُبرِ",5,"ر",1,0],["طَعامُ العِراقُ المُستَفيضُ الَّذي تَرى","وَفي كُلِّ عامٍ حُلَّةٌ وَدَراهِمُ",6,"م",1,0],["طَعَنْتَ خاصِرَةَ الفاروقِ مُنتَقِماً","من الحَنيفَةِ في أعلى مَجاليها",7,"ي",3,0],["طَعَنتُهُ بِقَوِيِّ المَتنِ مُعتَدِلٍ","صَدقِ الأَنابيبِ كَالخَطِيِّ خَطّارِ",8,"ر",1,0],["طعانٌ يَفُضُّ الجُدلَ عَن آنُفِ الشَبا","وَضَربٌ بِبيضٍ أَخلَصَتها الصَياقِلُ",9,"ل",1,0],["طعامُك من دار النعيم بعثْتَهُ","فشرَفتَه من حيث أدري ولا أدري",10,"ر",2,1],["طعام الناس أعجب ما أحبّوا","فمنه حياتهم وبه الحِمام",11,"م",1,0],["طَعنٌ إِذا خِفتُ الهَوانَ بِبَلدَةٍ","وَأَخو المَضاعِفِ لا يَكادُ يَريمُ",12,"م",1,0],["طعنتُها أسفلَ وَجْعائها","فانبجست من ثُقْبها الأعلى",13,"ل",2,0],["طعامُك إطعامُ الطعام ولم يزلْ","لديك طعام يا ابنَ يحيى مُقدَّما",14,"م",2,0],["طعامٌ لا وخامةَ فيه تُخشى","وفي المعروف أطعمةٌ وِخامُ",15,"م",1,0],["طعنوك يا وطني المفدى","في الصدر حتى كدت تردى",16,"د",2,1],["طعنت الأشم الأبىّ العيوف","الأنوف السميك العريق الطويلا",17,"ل",2,0],["طعنت الصحافة في أنفها","طعنت الرصيف الحصيف النبيلا",17,"ل",2,0],["طعنت الجوائب في ربها","ولم تخش جورجي بها أو مشيلا",17,"ل",2,0],["طَعامُ الفَقيرِ وَحَلوى الغَنِيِّ","وَزادُ المُسافِرِ وَالمُغتَرِب",18,"ب",1,0],["طُعِنَت فَاِنبَجَسَت فَاِستَصرَخَت","فَأَتاها حينُها فَهيَ خَبَر",19,"ر",1,0],["طعمه الأنبياء قون حلال","وبلاغ الأبرار والأخيارِ",20,"ر",1,0],["طَعَنَ التَلَهُّفُ قَلبَهُ فَفُؤادُهُ","مِن غَيرِ طَعنَةِ فارِسٍ مَطعونُ",21,"ن",1,0],["طِعانُ عَمرِو كُلثومٍ وَنائِلُهُ","حَذوَ السُيورِ الَّتي قُدَّت مِنَ الأَدَمِ",22,"م",1,0],["طَعنَ الدُّستورَ في مَقتلهِ","فَلَوى قَرْنَيْهِ مَن يلوِي الرِّماحا",23,"ح",2,0],["طَعَامُ السُّوءِ مَسْمُومٌ وهذا","أخِي جبريلُ بالأنباءِ جَاءَ",24,"ا",2,0],["طَعَامُ كلِّ فَتىً للَّهِ مُنتَدَبٍ","لا يغمدُ السَّيْف عَمَّنْ يُطعِمُ الصَّنما",25,"م",2,0],["طَعنٌ وضَربٌ يعافُ البأسُ عندهما","سِلاحَ من طَعنَ الأبطالَ أو ضربا",26,"ب",2,0],["طَعَنَت بِالجَيشِ بِها هادِياً","خَوفَ مَلاقيها وَأَهضامِها",27,"م",3,0],["طَعمُ كَأسي مُرٌّ إِذا لَم تَزُرني","وَهوَ يَحلو إِذا رَأَيتُكَ عِندي",28,"ي",1,0],["طَعْنٌ يُكوِّرُ هذا في فريصة ذا","كأنّ في كلّ شِلْوٍ بطنَ ملحود",29,"د",1,0],["طعنتهُ فانثنى فقلتُ له","والرمح منّي في العينِ من كفَلِه",30,"ل",2,0],["طَعمُهُ مِن ذَوبِ شُهدٍ","شيبَ بِالماءِ الفُراتِ",31,"ت",1,0],["طِعانٌ كُلَّ حينٍ أَو ضِرابٌ","يَموتُ بِها طَعينٌ أَو ضَريبُ",32,"ب",1,0],["طَعامُ غَنِيِّ الإِنسِ وَالفاقِدِ الغِنى","سَواءٌ إِذا ما غَيَّبَتهُ الحَناجِرُ",33,"ر",1,0],["طَعَنوا بِمُرّانِ الوَشيجِ فَما تَرى","خَلفَ الأَسِنَّةِ غَيرَ عِرقٍ يَشخَبُ",34,"ب",1,0],["طعامُ مَنْ لستُ له ذاكراً","دقَّ كما دَقَّ بأن يُذْكرا",35,"ر",2,1],["طعامها من فُتات العيش مسغبةٌ","وريُّها منهُ إيلامٌ وإشقاءُ",36,"ا",2,0],["طَعْنَةٌ إِثْرَ طَعْنَةٍ فِي حَشَاهَا","آهِ مِمَّا جَنَى عَلَيْهَا الحِمَامُ",37,"م",1,0],["طعَامُهُمُ لَوْنٌ وَلَكِنْ مُيَسَّرٌ","وَمَشْرَبُهُمْ عَذْبٌ بِلا رَنَقٍ يَجْرِي",38,"ر",2,0],["طَعَنّا طَعْنَةً حَمْراءَ فِيهمْ","حَرامٌ رَأْبُها حَتَّى المَماتِ",39,"ت",1,1],["طَعِمتُ الهَوى في لَحظَةٍ وَشَرِبتُهُ","فَلَم أَستَطِع نَحوَ السُلُوِّ نَشاطا",40,"ط",2,0],["طَعَنتُ فُؤادي مِن بَعيد وَهكَذا","قَنا اللَحظ يَبلُغنَ النُجومَ شِطاطا",40,"ط",2,0],["طِعانُ يومٍ ضاحكٍ مُستَبشِرِ","لم تَعثُرِ الخيلُ بهِ في عِثْيَرِ",41,"ر",1,0],["طعنوا في الصميم من يركُن","الشعبُ إليه ونصبَّوا القُطَّاعا",42,"ع",2,0],["طعنتُه بالقوافي فانثنى فَرَقاً","يشكو إلى الله وقع ِ المقْولِ الَّرب",43,"ب",1,0],["طُعمَتْ مصافحتي له إذ زرته","فقبضت من ظلّ الخيال النافر",44,"ر",1,0],["طِعانٌ كلَّ حينٍ، أو ضِرابٌ،","يموتُ به طعينٌ، أو ضريبُ",45,"ب",1,0],["طعامُك إطعامُ الطعام ولم يزلْ","لديك طعام يا بنَ يحيى مُقدَّما",46,"م",2,0]]}