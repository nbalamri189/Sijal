{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[55,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[55,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[55,"لمن الديار طلولها وقص","https://www.aldiwan.net/poem30177.html","الكامل"],[55,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[55,"شيمي لحاظك عنا ظبية الخمر","https://www.aldiwan.net/poem30460.html","البسيط"],[57,"يا من تمادى قلبه في الهوى","https://www.aldiwan.net/poem26347.html","السريع"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[73,"لما تشكى ابن عصرون إلي حمى","https://www.aldiwan.net/poem3816.html","البسيط"],[37,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[85,"طعامك من دار النعيم بعثته","https://www.aldiwan.net/poem54300.html","الطويل"],[90,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[53,"هاجرني ظلما أبو حفصل","https://www.aldiwan.net/poem7968.html","السريع"],[53,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[91,"طعنوك يا وطني المفدى","https://www.aldiwan.net/poem44659.html","مجزوء الكامل"],[87,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[87,"أرى شجراً في السماء احتجب","https://www.aldiwan.net/poem8087.html","المتقارب"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[64,"حكمة أخفيت عن الناس طرا","https://www.aldiwan.net/poem52188.html","الخفيف"],[46,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[46,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[107,"سائلوا الأبطال هل ملوا الكفاحا","https://www.aldiwan.net/poem42054.html","الرمل"],[107,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[107,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[107,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[41,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[54,"بأبي هل ملأت عينا بشيء","https://www.aldiwan.net/poem27114.html","الخفيف"],[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[50,"سقيا لظبي كالرمح في عدله","https://www.aldiwan.net/poem66276.html","المنسرح"],[52,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[48,"تريب وسوف يفترق التريب","https://www.aldiwan.net/poem22096.html","الوافر"],[48,"دع القوم سلوا بالضغائن بينهم","https://www.aldiwan.net/poem22527.html","الطويل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[78,"طعام من لست له ذاكرا","https://www.aldiwan.net/poem39320.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62227","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67296","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43645","الطويل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50221","الرجز"],[92,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[92,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[82,"هجرَ الخيالُ فزرته بالخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=3222",""],[48,"تريبُ، وسوف يفترقُ التريبُ،","https://www.poetsgate.com/ViewPoem.aspx?id=2688",""],[96,"تلك الأقانيم الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=15662",""],[53,"ليهنَكَ أن أفطرتَ لا متطلعاً","https://www.poetsgate.com/ViewPoem.aspx?id=30406",""],[118,"طعنت فؤادي برمح القوام","https://www.aldiwan.net/poem41514.html","المتقارب"],[118,"فتكت عيون الغيد بالألباب","https://www.aldiwan.net/poem41657.html","الكامل"],[118,"طعن الحسود بنا لخفة عقله","https://www.aldiwan.net/poem41695.html","الكامل"],[131,"ثلاث تزيد الوجه نورا ونضرة","https://www.aldiwan.net/poem50647.html","الطويل"],[131,"ثلاث بهاء الوجه تذهب سرعة","https://www.aldiwan.net/poem50649.html","الطويل"],[132,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[135,"أثار غريمى وشجا عقيلى","https://www.aldiwan.net/poem54762.html","الطويل"],[167,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[172,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[198,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[201,"سفرت وريعان التبلج مسفر","https://www.aldiwan.net/poem51949.html","الكامل"],[215,"حشا في حشائي الهم والشوق ما حشا","https://www.aldiwan.net/poem37871.html","الطويل"],[225,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[238,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[238,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[253,"طربت اشتياقا للنبي محمد","https://www.aldiwan.net/poem15069.html","الطويل"],[259,"وكم حديث كأنه سمر","https://www.aldiwan.net/poem48439.html","المنسرح"],[278,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[285,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[380,"اليوم يخفق كل نجم مرجف","https://www.aldiwan.net/poem59331.html","الكامل"],[406,"طعمت حلاوة الأشياء طرا","https://www.aldiwan.net/poem34109.html","الوافر"],[435,"سلني عن الحب يا من ليس يعرفه","https://www.aldiwan.net/poem12598.html","البسيط"],[446,"في بعلبك جنة الخوام","https://www.aldiwan.net/poem55930.html","عموديه"],[463,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[463,"له عن الشر إعراض ومجتنب","https://www.aldiwan.net/poem16164.html","البسيط"],[466,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[466,"جهلاً نظرت برامتين","https://www.aldiwan.net/poem3478.html","عموديه"],[484,"يا راميا قلبا جريح","https://www.aldiwan.net/poem24200.html","عموديه"],[485,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[489,"طعنت غداة القاع شملة طعنة","https://www.aldiwan.net/poem2052.html","الطويل"],[508,"قلم به الاقليم أصبح في حمى","https://www.aldiwan.net/poem2414.html","الكامل"],[517,"قد كان حبي محض","https://www.aldiwan.net/poem12302.html","المجتث"],[543,"تولت رجالي بالغنائم والغنى","https://www.aldiwan.net/poem680.html",""],[553,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[553,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[560,"طوبى لمن كشفت بصيرته الغطا","https://www.aldiwan.net/poem33544.html","الكامل"],[560,"طاء طيب الطباع في الأقساط","https://www.aldiwan.net/poem34405.html","الخفيف"],[560,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[569,"سلام على دير القصير وسفحه","https://www.aldiwan.net/poem69772.html","الطويل"],[571,"أرى كل ريح سوف تسكن مرة","https://www.aldiwan.net/poem52004.html","الطويل"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10480","المتقارب"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/10407","الطويل"],[1190,"","https://poetry.dctabudhabi.ae/diwan/poem/28235","الخفيف"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/200298","الوافر"]],"verses":[["طعينا وما في مثله طعن خنجر","بأعظم من أن يزدريه مخاطبه",0,"ب",2,0],["طَعِمنا وَأَطعَمنا القَنا مِن دِمائِهِ","وَسارَت بِآمالِ الرِجالِ صُدوعُ",1,"ع",1,0],["طَعَنتَ ظَلامَهُ بِالرَكبِ حَتّى","رَأَيتَ لَهُ اِنجِياباً وَاِنعِطاطا",2,"ط",2,0],["طَعَنوا الظَلامَ بِكُلِّ ناجِيَةٍ","في موقِ كُلِّ دُجىً لَها بَحصُ",3,"ص",1,0],["طَعَنتَ بِالحُجَّةِ الغَرّاءِ ثَغرَتَهُ","وَرُمحُ غَيرِكَ فيهِ العَيُّ وَالحَصَرُ",4,"ر",1,0],["طَعناً كَما صَبَّحَ الغُدرانَ مُمتَحِنٌ","رَمى فَشَتَّتَ شَملَ الماءِ بِالحَجَرِ",5,"ر",1,0],["طَعمُ ثَناياها بُعَيدَ الكَرى","أَخبُرُهُ مِنها بِلا خُبرِ",6,"ر",1,0],["طَعامُ العِراقُ المُستَفيضُ الَّذي تَرى","وَفي كُلِّ عامٍ حُلَّةٌ وَدَراهِمُ",7,"م",1,0],["طَعَنْتَ خاصِرَةَ الفاروقِ مُنتَقِماً","من الحَنيفَةِ في أعلى مَجاليها",8,"ي",3,0],["طَعَنتُهُ بِقَوِيِّ المَتنِ مُعتَدِلٍ","صَدقِ الأَنابيبِ كَالخَطِيِّ خَطّارِ",9,"ر",1,0],["طعانٌ يَفُضُّ الجُدلَ عَن آنُفِ الشَبا","وَضَربٌ بِبيضٍ أَخلَصَتها الصَياقِلُ",10,"ل",1,0],["طعامُك من دار النعيم بعثْتَهُ","فشرَفتَه من حيث أدري ولا أدري",11,"ر",2,1],["طعام الناس أعجب ما أحبّوا","فمنه حياتهم وبه الحِمام",12,"م",1,0],["طَعنٌ إِذا خِفتُ الهَوانَ بِبَلدَةٍ","وَأَخو المَضاعِفِ لا يَكادُ يَريمُ",13,"م",1,0],["طعنتُها أسفلَ وَجْعائها","فانبجست من ثُقْبها الأعلى",14,"ل",2,0],["طعامُك إطعامُ الطعام ولم يزلْ","لديك طعام يا ابنَ يحيى مُقدَّما",15,"م",2,0],["طعامٌ لا وخامةَ فيه تُخشى","وفي المعروف أطعمةٌ وِخامُ",16,"م",1,0],["طعنوك يا وطني المفدى","في الصدر حتى كدت تردى",17,"د",2,1],["طعنت الأشم الأبىّ العيوف","الأنوف السميك العريق الطويلا",18,"ل",2,0],["طعنت الصحافة في أنفها","طعنت الرصيف الحصيف النبيلا",18,"ل",2,0],["طعنت الجوائب في ربها","ولم تخش جورجي بها أو مشيلا",18,"ل",2,0],["طَعامُ الفَقيرِ وَحَلوى الغَنِيِّ","وَزادُ المُسافِرِ وَالمُغتَرِب",19,"ب",1,0],["طُعِنَت فَاِنبَجَسَت فَاِستَصرَخَت","فَأَتاها حينُها فَهيَ خَبَر",20,"ر",1,0],["طعمه الأنبياء قون حلال","وبلاغ الأبرار والأخيارِ",21,"ر",1,0],["طَعَنَ التَلَهُّفُ قَلبَهُ فَفُؤادُهُ","مِن غَيرِ طَعنَةِ فارِسٍ مَطعونُ",22,"ن",1,0],["طِعانُ عَمرِو كُلثومٍ وَنائِلُهُ","حَذوَ السُيورِ الَّتي قُدَّت مِنَ الأَدَمِ",23,"م",1,0],["طَعنَ الدُّستورَ في مَقتلهِ","فَلَوى قَرْنَيْهِ مَن يلوِي الرِّماحا",24,"ح",2,0],["طَعَامُ السُّوءِ مَسْمُومٌ وهذا","أخِي جبريلُ بالأنباءِ جَاءَ",25,"ا",2,0],["طَعَامُ كلِّ فَتىً للَّهِ مُنتَدَبٍ","لا يغمدُ السَّيْف عَمَّنْ يُطعِمُ الصَّنما",26,"م",2,0],["طَعنٌ وضَربٌ يعافُ البأسُ عندهما","سِلاحَ من طَعنَ الأبطالَ أو ضربا",27,"ب",2,0],["طَعَنَت بِالجَيشِ بِها هادِياً","خَوفَ مَلاقيها وَأَهضامِها",28,"م",3,0],["طَعمُ كَأسي مُرٌّ إِذا لَم تَزُرني","وَهوَ يَحلو إِذا رَأَيتُكَ عِندي",29,"ي",1,0],["طَعْنٌ يُكوِّرُ هذا في فريصة ذا","كأنّ في كلّ شِلْوٍ بطنَ ملحود",30,"د",1,0],["طعنتهُ فانثنى فقلتُ له","والرمح منّي في العينِ من كفَلِه",31,"ل",2,0],["طَعمُهُ مِن ذَوبِ شُهدٍ","شيبَ بِالماءِ الفُراتِ",32,"ت",1,0],["طِعانٌ كُلَّ حينٍ أَو ضِرابٌ","يَموتُ بِها طَعينٌ أَو ضَريبُ",33,"ب",1,0],["طَعامُ غَنِيِّ الإِنسِ وَالفاقِدِ الغِنى","سَواءٌ إِذا ما غَيَّبَتهُ الحَناجِرُ",34,"ر",1,0],["طَعَنوا بِمُرّانِ الوَشيجِ فَما تَرى","خَلفَ الأَسِنَّةِ غَيرَ عِرقٍ يَشخَبُ",35,"ب",1,0],["طعامُ مَنْ لستُ له ذاكراً","دقَّ كما دَقَّ بأن يُذْكرا",36,"ر",2,1],["طَعَنَّاً حُبَيْشاً طَعْنَةً ظَلَّ بَعْدَهَا","يَنُوءُ حُبَيْشُ لِلْيَدَيْنِ ويُنْزَفُ",37,"ف",1,0],["طعامها من فُتات العيش مسغبةٌ","وريُّها منهُ إيلامٌ وإشقاءُ",38,"ا",2,0],["طَعْنَةٌ إِثْرَ طَعْنَةٍ فِي حَشَاهَا","آهِ مِمَّا جَنَى عَلَيْهَا الحِمَامُ",39,"م",1,0],["طعَامُهُمُ لَوْنٌ وَلَكِنْ مُيَسَّرٌ","وَمَشْرَبُهُمْ عَذْبٌ بِلا رَنَقٍ يَجْرِي",40,"ر",2,0],["طَعَنّا طَعْنَةً حَمْراءَ فِيهمْ","حَرامٌ رَأْبُها حَتَّى المَماتِ",41,"ت",1,1],["طَعِمتُ الهَوى في لَحظَةٍ وَشَرِبتُهُ","فَلَم أَستَطِع نَحوَ السُلُوِّ نَشاطا",42,"ط",2,0],["طَعَنتُ فُؤادي مِن بَعيد وَهكَذا","قَنا اللَحظ يَبلُغنَ النُجومَ شِطاطا",42,"ط",2,0],["طِعانُ يومٍ ضاحكٍ مُستَبشِرِ","لم تَعثُرِ الخيلُ بهِ في عِثْيَرِ",43,"ر",1,0],["طعنوا في الصميم من يركُن","الشعبُ إليه ونصبَّوا القُطَّاعا",44,"ع",2,0],["طعنتُه بالقوافي فانثنى فَرَقاً","يشكو إلى الله وقع ِ المقْولِ الَّرب",45,"ب",1,0],["طُعمَتْ مصافحتي له إذ زرته","فقبضت من ظلّ الخيال النافر",46,"ر",1,0],["طِعانٌ كلَّ حينٍ، أو ضِرابٌ،","يموتُ به طعينٌ، أو ضريبُ",47,"ب",1,0],["طعنته أطماع السياسة طعنة","نفذت فراح السلم وهو قتيل",48,"ل",1,0],["طعامُك إطعامُ الطعام ولم يزلْ","لديك طعام يا بنَ يحيى مُقدَّما",49,"م",2,0],["طعنت فؤادي برمح القوام","وقديت قلبي بسيف المقل",50,"ل",1,1],["طعانة فعالة قتالة","لكن إلى الصدقاء والأصحاب",51,"ب",1,0],["طعن الحسود بنا لخفة عقله","وعدا علينا في عساكر جهله"