ml","مجزوء الرمل"],[140,"لو يهتدى وصفى إلى شغفى","https://www.aldiwan.net/poem58374.html","أحذ الكامل"],[183,"متلونين على شواهد حبهم","https://www.aldiwan.net/poem14804.html","الكامل"],[233,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[233,"لو أنصفت ذات النصيف","https://www.aldiwan.net/poem31817.html","مجزوء الكامل"],[248,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[257,"كلنا في جماله ذو هيام","https://www.aldiwan.net/poem35562.html","الخفيف"],[303,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[364,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[374,"بئس الزمان المرتدي بشرار","https://www.aldiwan.net/poem59431.html","الكامل"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[406,"انظر منازل آل منقذ إنها","https://www.aldiwan.net/poem31689.html","عموديه"],[406,"قل لمن أوحش بالهجر","https://www.aldiwan.net/poem32518.html","مجزوء الرمل"],[421,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[434,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[456,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[456,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[462,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[462,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[462,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[462,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[462,"وجه الحبيب شهية ألطافه","https://www.aldiwan.net/poem3540.html","عموديه"],[475,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[480,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[513,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[513,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[536,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[549,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"]],"verses":[["مُتَلَفِّتينَ مِنَ القِبابِ كَأَنَّما اِن","تَقَبوا بِأَعيُنِ رَبرَبِ وَخُدودِ",0,"د",1,0],["مِتْلُكَ مَنْ قَرْطَسَ أغْ","رَاضَ الْعُلاَ لَمَّا رَمَى",1,"م",2,0],["مُتَلَفِّتاً مُتَحَيِّراً مُتَخَيِّراً","رَجُلاً يُناضِلُ عَنهُ يَومَ فَخارِ",2,"ر",1,0],["مُتَلَفِّعاً جِلبابَهُ","مُتَرَقِّباً مَعروفَ عابِر",3,"ر",1,0],["مُتلِفٌ مُخلِفٌ مُفيتٌ مُفيدٌ","مُعجِزٌ مُنجِزٌ وَعيداً وَوَعدا",4,"د",2,0],["متلاعبات في الحلي ينوب في","وجناتهنَّ الوردُ حسناً عن خَفَرْ",5,"ر",1,0],["متلوِّن الأخلاق مثل مدامِعي","والقلبُ مثل خدوده ملتهِب",6,"ب",1,0],["متلوّن الأخلاق إلا أنها","لشقاوتي ليست تملّ ملالها",7,"ل",3,0],["متلِفٌ فهو للثراءِ مُفِيتٌ","مخلِفٌ فهو للثناء كسوبُ",8,"ب",1,0],["مُتلفٌ مُخْلِفٌ مُفِيتٌ مُفيدٌ","خَيرُ جَمَّاع ثَرْوةٍ فَضّاض",9,"ض",1,0],["مُتلفاً مخلفاً مُفيتاً مفيداً","جِذمَ مالٍ مُستهلكٍ مرجوعِ",10,"ع",1,0],["متلافُ أموال صناعةُ كفَّهِ","تفريقُ كل مُؤثَّلٍ مجموعِ",11,"ع",1,0],["مُتلاحِق الأطرافِ مُتَّسقٍ","فكأنَّه قد طُمَّ بالجَلمِ",12,"م",1,0],["متلطفاً لهمُ تلطُّف قُلَّبٍ","لو شاء شادَ على البحارِ مَدائنا",13,"ن",2,0],["مُتَلَفَّفٌ في بُردَةٍ حَبَقِيَّةٍ","بِفَناءِ بَيتِ مَذَلَّةٍ وَهَوانِ",14,"ن",1,0],["مُتَلَفِّتاً عَن جانِبَيهِ كَعاشِقٍ","مُتَلَفِّتٍ حَذَرَ الرَقيبِ القالي",15,"ل",2,0],["مُتَلَفِّتينَ إِلى الوَراءِ بِأَعيُنٍ","تَتَخَيَّلُ الأَعداءَ في الأَجفانِ",16,"ن",1,0],["مُتَلاصِقي الجِسمَينِ يَس","نُدُ ساعِدَيهِ ساعِداها",17,"ا",3,0],["متلهب الطغوى إذا","أخذ الفريسة لم يغادر",18,"ر",1,0],["مُتَلَطِّفٍ في النُصحِ غَيرِ مُجادِلٍ","وَالنُصحُ أَضيَعُ ما يَكونُ جِدالا",19,"ل",2,0],["مُتلِفٍ مُخلِفٍ وَفِيٍّ أَبِيٍّ","عالِمٍ حازِمٍ شُجاعٍ جَوادِ",20,"د",1,0],["مُتَلاحِظَينِ نَسُحُّ ماءَ شُؤونِنا","حَذَراً مِنَ الرُقَباءِ في الأَكمامِ",21,"م",1,0],["متلثّمينَ بنقعِ شأوكَ وُقَّفاً","عُقلوا بقيدَيْ حَيْرةٍ وحِرانِ",22,"ن",1,0],["متلثِّمٌ ولِثَامُهُ","غَيْمٌ يُوارِي منه بَدْرا",23,"ر",2,0],["مُتلِفٌ مُخلِفٌ يُخافُ وَيُرجى","لِكِلا حالَتَينِ نَفعٍ وَضَرِّ",24,"ر",1,0],["مُتَلَفِّفُ العُثنونِ مِن إِكبابِهِ","لِلخَرزِ بَينَ قَوالِبٍ وَأَشافِ",25,"ف",1,0],["مُتَلَوِّنٌ يُبْدي لنا","طُرَفاً بأطرافِ النَّهارِ",26,"ر",1,0],["مُتَلَذِّذاً فيهِ بِكُلِّ هَنِيَّةٍ","وَمُبَلَّغاً كُلَّ المُنى مِن دَهرِهِ",27,"ر",2,0],["متلهفاً أستبطئ الزمنا","وأظل أسأل ساعتي عنها",28,"ه",2,0],["مُتَلاطِمُ الأَحشاءِ تَحسِبُ أَنَّهُ","بَحرٌ طَمى مُتَلاطِمَ الأَرجاءِ",29,"ا",2,0],["مُت لِتَحيا وَلا تُرِدها حَياةً","تَصطَليها النُفوسُ مَوتاً فَظيعا",30,"ع",2,1],["مُتَلَثِّمٍ لُجُمَ الحَديدِ يَلوكُها","لَوكَ الفَتاةِ مَساوِكاً مِن إِسحِلِ",31,"ل",1,0],["مُتَلَفِّتٌ حَتّى أَتاكَ وَقَد","خافَ الرَقيبَ وَهَزَّهُ الذُعرُ",32,"ر",1,0],["مُتَلَطِّفٌ لا أَشرَئِب","بُ وَلا تُوَبِّخُني المَلامَه",33,"م",2,0],["متلاعبات فوق أذيال الربى","وَشعابها كتلاعب الغزلان",34,"ن",1,0],["مُتَلَفِّعٌ بحَريرهِ مُتَضَمِّخٌ","بعَبيرهِ مُتَرَنِّحٌ بفُتُورِه",35,"ر",2,0],["مُتَلَوِّنُ الأَخْلاقِ بَيْنَ عَشِيرِهِ","جَهْلاً كَمَا يَتَلَوَّنُ الشِّقْرَاقُ",36,"ق",1,0],["مُتَلَفِّتَاً عَنْ جَانِبَيهِ يَهُزُّهُ","مَرَحُ الصِّبَا كَالشَّارِبِ الْمُتَغَرِِّد",37,"د",1,0],["مُتَلَفِّتاً حِيْنَ الْوَدَاعِ وَفِي الْحَشَى","مَا فِيهِ مِنْ غُصَصٍ وَمِنْ أَكْدَارِ",38,"ر",1,0],["مُتَلاَشِيَ الأَنْفَاسِ فِي نَفَسٍ","مُتَوَارِياً كَالطَّيْفِ عَنْ بُعْد",39,"د",1,0],["مُتلِفاً لِلزرْعِ وَالضَّرْعِ مَعاً","تارِكاً فِي إِثرِهِ المَعْمور قَفْرا",40,"ر",2,0],["مَتَلاَحَقُ العُمْرَانُ لاَ يَخْتَارُ فِي","مَجْرَاهُ بَيْنَ مَوَاقِعٍ وَمَوَاقِعِ",41,"ع",1,0],["مُتَلَفِّتَاتٍ نَحْوَ من","هُوَ مِثْلُهُ غَزِلٌ وَشَاعِرْ",42,"ر",1,0],["متلجلج الألفاظ مضطرب","متواصل الأنفاس مطرد",43,"د",1,0],["متلازمينِ، توجَّسا إثمَ الهوى","فتخوَّفا طرفَ الضحى اللماحِ",44,"ح",1,0],["متلفت ما تبتغي؟ متوجع","ما تشتكي؟ متنصتق ما تسمعُ",45,"ع",1,0],["مُتَلَدِّداً أَرنو إِلى مَن مَرَّ بي","مِثلَ الغَريقِ بِما لَقي يَتَعَلَّقُ",46,"ق",1,0],["مُتَلفِّتاتٍ حَوْلَ رَكْبِك حُوَّماً","لا يَسْتقِر لوَجْدِهنّ قَرَار",47,"ر",1,0],["مُتَلوِّياً يُعطيك في لَفتاته","بين المسارب تائهاً حيرانا",48,"ن",2,0],["مُتلفاً مخلفاً مُفتياً مفيداً جِذمَ","مالٍ مُستهلكٍ مرجوعِ",49,"ع",1,0],["متلون صعب المزاج مخادع","لا فرق بين بعاده ووصاله",50,"ل",2,0],["مُتلِفاً في اللَهوِ مالي","عاشِقاً حورَ القِيانِ",51,"ن",1,0],["متلفتا تِلقاءَ داركُمُ","أرنو بعينَىْ مغرم دنِفِ",52,"ف",1,0],["مُتلوِّنين على شواهدِ حبِّهم","فالعينُ تُمطِرهم بذي ألوانِ",53,"ن",1,1],["مُتَلَفِّتاتٍ مِن شَرا","فِ إِلى سَنا بَرقٍ كَليلِ",54,"ل",1,0],["مُتَلَفِتاً لَو رَدَّ أَيّامَ","الصِبى مَدُّ الصَليفِ",55,"ف",1,0],["مِتُّ لما نأَى فها أنا مندو","بُ فراقٍ وحبُّه مَفرُوضُ",56,"ض",1,0],["مت لتحيا وافنَ لتبقى كأهل ال","حبّ عُميٌ عمّا سواه وخرسُ",57,"س",1,0],["مُتلوّنُ الحالاتِ ما برّ اِمرءاً","إلّا وَأتبع برّه تمجيجه",58,"ج",2,0],["مُتَلَهِّبٌ ناراً وَلا تَعجَل فَتِل","كَ النارُ قَد سَكَنَت لَهُ في المِعدَةِ",59,"ه",1,0],["متلوناً متلويّاً فكأنه ال","حرباء والجرباء أو كالنار",60,"ر",1,0],["مُتَلهَفٌ غضبان مِمّا نالَها","لا يَستطيعُ تجلّداً وتَصبرَا",61,"ر",2,0],["متلهفا ما اسطاعها ومن الذي","يلج العرين على الهزير الخادر",62,"ر",1,0],["مُتِلفٌ بالهَجر نَفسي","وإِليهِ مُشْتَكاهَا",63,"ا",3,0],["مُتَلَبِّسٌ جِلْبَابَ صَبْرٍ تَحْتَهُ","قَلْبٌ كَمِثْلِ الصَّخْرَةِ الصَّمّاءِ",64,"ا",2,0],["متلفي روحي صدودكم","قاتلي داركم صددُ",65,"د",1,0],["متلثّم والشمسُ تحت لثامهِ","أو سافرٌ والنجمُ تحت جبينهِ",66,"ن",2,0],["متلوّم العزماتِ لا هو قاطنٌ","في داره قفراً ولا هو راحلُ",67,"ل",1,0],["متلاحقين إلى العلاء كأنهّهم","مُجرَوْنَ يجمعُ بينهم مِضمارُ",68,"ر",1,0],["مُتلفٌ ما احتواهُ جُوداً جُوداً وبذْلاً","يُهدمُ المالُ حيث يُبْنى المجْدُ",69,"د",1,0],["متلوَّةٌ آياته مشهودةٌ","أوقاته مخطوبةٌ أبكاره",70,"ر",2,0],["متلون الأخلاق غادرَ مدمعي","بالصدِّ والإعراض ذا ألوان",71,"ن",1,0],["متلوّن الخلاق يلطم وجههَ","الجدِّ منهُ براحة الهزل",72,"ل",1,0],["متلاحق الأوزان لا أنفكُّ من","مقصورهِ إلاَّ إلى ممدوده",73,"د",2,0],["متلون بالدمع بعد صدوده","قد كنت أرجوه فصرتُ أخافه",74,"ف",2,0],["متلفَّتاً نحوَ الديارِ وهكذا","داءُ الغرامِ إذا تقادمَ يصنعُ",75,"ع",1,0],["متلثم بعناصر التنزيه في","تشبيه أين جواهر البستان",76,"ن",1,0],["متلهفاً أبكي إلى من مر بي","وإذا أرى ولداً يثور بلائي",77,"ي",1,0],["متلاطم كالموج إلا أنه","متتابع الأمواج والأزباد",78,"د",1,0],["مُتَلَهِّفينَ لِيَومِ فَصلٍ حاسِمٍ","يُبدونَ فيه ما تُكِنُّ صُدورُ",79,"ر",1,0],["متلهِّبٌ فإذا علا قِمَمَ العِدا","بسيوفِه ماتتْ هناك ذُحولُهُ",80,"ل",2,0],["متلوّنٌ إعطاؤه حرمانُهُ","متقلّبٌ ممنوعُهُ مبذولُهُ",80,"ل",2,0]]}