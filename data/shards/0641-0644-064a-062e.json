{"poems":[[75,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[95,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[95,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[90,"أما وقد طلع الرجاء","https://www.aldiwan.net/poem44794.html","مجزوء الكامل"],[53,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[53,"يا ليت شعري حين فارقتكم","https://www.aldiwan.net/poem66085.html","السريع"],[102,"رحلة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=50115",""],[102,"الحكم للشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50179",""],[147,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[147,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[275,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[376,"بعض بنات الزمن","https://www.aldiwan.net/poem57080.html","مجزوء الرجز"],[411,"خمسين عاما كنت أملتها","https://www.aldiwan.net/poem50043.html","السريع"],[556,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56289","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109041","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108857","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120864","الكامل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138496",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95369","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72452","الكامل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105178","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4978,"عين سارة","https://www.poetsgate.com/ViewPoem.aspx?id=177199",""],[4978,"تشطير عين سارة لغالية أبو ستة","https://www.poetsgate.com/ViewPoem.aspx?id=177201",""],[5046,"الشهيد فادي","https://www.poetsgate.com/ViewPoem.aspx?id=198117",""],[5212,"وليدُ الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=212040",""],[5365,"مالم تقلهُ زرقاءُ اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=190408",""],[402,"صدقت في عتبكم أو يصدق الشمم","https://www.poetsgate.com/ViewPoem.aspx?id=36829",""],[6075,"في صفحة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=190530",""],[520,"ليست صفات علاك مما يمترى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577514",""]],"verses":[["فَليَخرِقَنَّ الأَرضَ شُكرٌ مُنجِدٌ","مِنّي تَناقَلُهُ المَحافِلُ مُتهِمُ",0,"م",1,0],["فَلْيُخَلَّدْ فِي قَلْبِ كُلِّ شَكُورٍ","ذَلِكَ الصَّادِقُ الوَفِيُّ الأَمِينُ",1,"ن",1,0],["فَلْيَخْطُبِ السَّيْفُ فَصْلاً فِي مَفَارِقِهِمْ","يَدِنْ لِذَاكَ البَيَانِ الْقَاطِعِ الْعَجَمُ",2,"م",1,0],["فليخز كل مشاغب","في القوم ينزغ بالشرور",3,"ر",1,0],["فليختبرْك السائلون فإنّهم","إن جرَّبُوك أتاهمُ التأويلُ",4,"ل",1,0],["فلْيخْشَ مني من دنا مُنْصُلي","وليخش مني من نأى سهمي",5,"م",2,0],["فليخنّي الزمان والشعب إنّي","شعب شعبي ، أنا زمان الزمان",6,"ن",1,0],["فليخسأ الظلم ولتذهب حكومته","ملعونة وليوليّ عهدها النتن",7,"ن",1,0],["فَليَخلُ ذو الأَمَلِ الطَمّاحِ مِن تَعَبٍ","يُضيعُهُ وَليُخَلِّ الحاسِدُ الحَسَدا",8,"د",2,0],["فَليَختَبِر قَبلَ التَقَدُّمِ نَفسَهُ","مَن مالَهُ قِبَلٌ بِمَن يَلقاكا",9,"ك",2,0],["فَليخشَ بَأسِيَ مَن طالَت حَماقَتُهُ","وَرُبَّ عاجِلِ شَرٍّ قادَهُ أَشَرُ",10,"ر",1,0],["فليخفقنَّ القلبُ في لذّاتهِ","ما زلتِ سامعةً له خَفَقانا",11,"ن",2,0],["فلي خيرُ إرثِ من فضائلَ جمَّةٍ","ومن موهباتٍ كنَّ فيكِ عِظاما",12,"م",2,0],["فَليَخشَ مَن لم يَضنَ أن","يَلقاهُ طَرفٌ قد ضَني",13,"ن",2,0],["فَلْيخْتَرِ العَدلَ إذا ما كنَى","ولْيَلزَمِ الإنصاتَ إنْ صاتا",14,"ا",1,0],["فَليَخلُ قلبُك مِن أَحاديثِ الهوى","وليخلُ غُمضُك من مطيف الطائفِ",15,"ف",1,0],["فليخرجوا بيض الوجوه ويتركوا","للدولة الكبرى رضى الدولات",16,"ت",1,0],["فليخزَ مضطرباً إذاً جمع العدى","طراً ولا يُرجى لهم بي من أربْ",17,"ب",1,0],["فليخبط الكتاب في ظُلُماتهم","فلقد خبا عنهم ضياء النادي",18,"د",2,0],["فليخسأِ الشاني اللئيم محقَّراً","وليسلم المولى الكريم معظَّما",19,"م",2,0],["فليخسأ الفُنش اللعين وحزبه","فلقد أتاه يومه الموعود",20,"د",1,1],["فليَخشَ أعداؤُها حصنا وَحارسَه","كاللَيث حل مع الأشبال في أجم",21,"م",1,0],["فليخسأ الوهم عجزاً عن علا قدم","في موضع وضع الرحمن يمناه",22,"ه",1,0],["فليخسأ الحكماء عن","حرم به الأمك سجد",23,"د",1,0],["فَليَخشَ بَطشَ أَخِي باسٍ أَشَدَّ قُوىً","وَصَولَةً مِنكِ يَستَقرِيهِ بالطَّلَبِ",24,"ب",1,0],["فلى خلاص بمدح أكرم من","أزال بالطب والشفا زمنا",25,"ن",2,0],["فلى خلاص باخلاصى بمدى من","له على كل خلق الله تفضيل",26,"ل",1,0],["فليخسؤا الحكماء عن","حرم به الاملاك سجد",27,"د",1,0],["فلي خدود خدها مدمعي","لما جرى وناظر ساخر",28,"ر",1,0],["فليخسأ العازي اليهم منكرا","وكذا جزاء السامع المتسمع",29,"ع",1,0],["فليخسأ القوم منْ أمْنُ العدو لهم","رسالة ما لهم من دونها شُغُلُ",30,"ل",1,0],["فليخسأ القوم من أمن العدوّبهم","( محروقة كل أوراق بها أئتمَلوا",31,"ل",3,0],["فليخجل الحكامُ من هذا الّذي","يسعى إلى عدَنٍ بلا رجلين !",32,"ن",1,0],["فَليَخسأ الجّاني وَيَخسَأُ سَيفهُ","مِنْ ضَربَةٍ فُطِرَتْ عَلَيْها الجُّمْجُمه",33,"م",2,0],["فليَخلُدِ المجدُ في تاريخنا قصصاً","هذا عزاءٌ لنا في قولنا كُنّا",34,"ن",2,0],["فليخطب السيف فصلا في مفارقهم","يدن لذاك البأذن المدفع الجلم",35,"م",1,0],["فَلْيَخْسَأِ الْيَوْمَ مَنْ خَانُوا وَمَنْ ظَلَمُوا","مَنْ مَزَّقُوا شَمْلَنَا بِالْإِفْكِ وَالْإِحَنِ",36,"ن",1,0],["فليخي ما حييت مدائح مجده","وليبق ما بقي الزمان معمرا",37,"ر",2,0]]}