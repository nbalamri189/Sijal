54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[77,"قلدت من نصر الإله حساما","https://www.poetsgate.com/ViewPoem.aspx?id=34200",""],[100,"حين يصحو الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50112",""],[18,"أثبت مرة والسيوف شواهر","https://www.poetsgate.com/ViewPoem.aspx?id=27779",""],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"ذاكَ وَادي الأرَاكِ فاحبِسْ قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=32098",""],[20,"إِن للدهرِ صولة فاحذرنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69769&r=&rc=10",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[85,"أَبولُّو، مَرحَباً بك يا أَبولُّو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9669&r=&rc=159",""],[92,"أنتِ كالزهرة ِ الجميلة ِ في الغاب،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14570&r=&rc=15",""]],"verses":[["وَبَناني خُلِقَت أَطرافُها","عَقِباً لِلرُمحِ طَوراً وَالقَلَم",0,"م",1,0],["وَبَنو عَمِّنا بَنو جَمرَةِ الحَر","بِ وَماءُ المَكارِمِ الرَقراقِ",1,"ق",1,0],["وَبَنى الحُصونَ تَمَتُّعاً فَكَأَنَّما","أَمسى بِمَضيَعَةٍ وَلا يَدري",2,"ر",2,0],["وَبِنَجدٍ لِلعَامِريَّةِ دارٌ","بِرُباها مُعَرَّسُ الأَهواءِ",3,"ا",2,0],["وَبِنَفسي هيَ وَالسِّربُ الَّتِي","توقِظُ الرَّكبَ إِذا الصُّبحُ دَنا",4,"ن",2,0],["وَبِنَحْرِها مِنْ أَدْمُعي بَلَلٌ","وَبِراحَتي مِنْ نَشرِها عَبَقُ",5,"ق",1,0],["وَبِنا شَوْقٌ إِلَيْها وَبِها","مِثْلُهُ لا أَجْدَبَتْ مِنْها الرُّبوعُ",6,"ع",1,0],["وبَنو رُؤاسٍ يَنهَجونَ إِلى الندىً","طُرُقاً يَضِلُّ أمامَها الحِرْمانُ",7,"ن",1,0],["وبنَفْحَةِ الأرَجِ الذي أودَعْتِهِ","عَبقَتْ حَواشي رَيْطَتي وردائي",8,"ا",2,0],["وَبَنو صُباحٍ أَفلَتونا عَنوَةً","وَالكَيسُ أَينَ ما تَنَلهُ يَنفَعِ",9,"ع",1,0],["وَبَني صَباحٍ قَد تَرَكنا مِنهُمُ","جَزَراً بِذاتِ الرِمثِ فَوقَ أُثالِ",10,"ل",1,0],["وبنورِ الطُّوْرِ وقدْ أضْحى","مُوسَى لجلالَتِهِ صَعِقا",11,"ق",2,0],["وَبَنَوْا لَكَ الْمَجْدَ الْمُؤَثَّلَ وَالْعُلَى","فَفَرَعْتَ مِنْهَا ذِرْوَةً وَسَنَامَا",12,"م",2,0],["وَبَنُو الزَّمَانِ عَلَى سَبِيلِ أَبِيهِمُ","إِنْ عَزَّ عَزُّوا أَوْ يَذِلُّ تَذَلَّلُوا",13,"ل",3,0],["وبَنو أميّةَ قد أدارَ علَيْهِمُ","قدَحاً تفشّتْ في الجميعِ عُقارُهُ",14,"ر",2,0],["وبَنو عُبَيْدٍ إذ تعبّد مُلْكُهُمْ","سُلْطان مصْرَ وأذْعَنَتْ أمْصارُهُ",14,"ر",2,0],["وبنَفْسي مَنْ إذا جنّ الدُّجى","أمْسكَ النوْمَ وأهْداني السّهَرْ",15,"ر",1,0],["وَبَني بُدَيدٍ إِنَّهُم","أَهلُ اللَآمَةِ وَالصَغارَه",16,"ر",2,0],["وَبَنو ضُبَيعَةَ يَعلَمو","نَ بِوارِدِ الخُلُقِ الشَرارَه",16,"ر",2,0],["وَبَني المُنذِرِ الأَشاهِبِ بِالحي","رَةِ يَمشونَ غُدوَةً كَالسُيوفِ",17,"ف",1,0],["وَبَنانٍ مُبدِعاتٍ صَوَّرَت","أَوجُهَ العُذرِ لِعُبّادِ الصَنَم",18,"م",1,0],["وَبُناةُ الأَهرامِ في سالِفِ الدَه","رِ كَفَوني الكَلامَ عِندَ التَحَدّي",19,"ي",1,0],["وَبَنو مِصرَ في حِمى النيلِ صَرعى","يَرقُبونَ القَضاءَ عاماً فَعاما",20,"م",2,0],["وَبَنو الأَيّامِ أَخيا","فٌ سَراةٌ وَخِساسُ",21,"س",1,0],["وَبِنَفسي وَإِن أَضَرَّ بِنَفسي","قَمَرٌ لا يَنالُ مِنهُ السِرارُ",22,"ر",1,1],["وَبَنيِ القِبابِ وَمَلءِ الجِف","نِ وَالنارِ وَالحَطَبِ المُفأَدِ",23,"د",1,0],["وبنت أيك غذاها الحسن فاختلست","لينا من الماء أو لونا من اللهب",24,"ب",1,1],["وَبَني أَبي حَسَنٍ وَوَالدِهِم","مَن طابَ في الأَرحامِ وَالصُلبِ",25,"ب",1,0],["وَبِنَفسي لَهُمومٌ","فَهِيَ حَرّى أَسِفَه",26,"ف",2,0],["وَبَنَتْ لَهُ بِعَنَائِهَا وَسُهَادِهَا","تِلْكَ الدَّعَامَةَ مِنْ دَعَائِمِ مَجْدِهِ",27,"د",2,0],["وَبَنُوكَ فِيهَا ذَاكِرُوا أُستَاذِهِمْ","بِالخَيْرِ فِي الإسُرَارِ وَالإعْلاَنِ",28,"ن",1,0],["وَبَنَى الثَّبَاتُ بِنَاءهُ حَتَّى غَدَا","بِجَلالِهِ أُمْنِيَّةَ المُتَلَوِّمِ",29,"م",1,0],["وَبَنُوكَ الكِرَامُ وَاسِطَةٌ فِي","ذَلِكَ العِقْدِ مِنْ وُفُودٍ كِرَامِ",30,"م",1,0],["وبنَوْا لهم داراً بما جادت به","أيدي الكرام لهم من الأموال",31,"ل",1,0],["وبَنَت بأقطار البلاد مَصانعاً","تتحيّر الأفكار في بُنيانها",32,"ن",3,0],["وَبَنو البَعيثِ ذَكَرتُ حُمرَةَ أُمِّهِم","فَشَفَيتُ نَفسي مِن بَني الحَمراءِ",33,"ا",2,0],["وَبَني أَبي بَكرٍ وَطِئنَ وَجَعفَراً","وَبَني الوَحيدِ فَما تَرَكنَ وَحيدا",34,"د",2,0],["وَبَنو قُفَيرَةَ قَد أَجابوا نَهشَلاً","بِاِسمِ العُبودَةِ قَبلَ أَن يَتَصَعصَعوا",35,"ع",3,0],["وَبِنا يُدافَعُ كُلُّ أَمرِ عَظيمَةٍ","لَيسَت كَنَزوِكَ في ثِيابِ الكَرَّقِ",36,"ق",1,0],["وَبَنو الوَليدِ مِنَ الوَليدِ بِمَنزِلٍ","كَالبَدرِ حُفَّ بِواضِحاتِ الأَنجُمِ",37,"م",1,0],["وَبُنَيُّ بَرزَةَ مُقرِفٌ في نَعلِهِ","قَدَمٌ لَئيمَةُ مَوضِعِ الإِبهامِ",38,"م",1,0],["وَبَنى لِمَسلَمَةَ الخَلائِفُ في العُلى","شَرَفاً أَقامَ بِمَنزِلٍ مَعلومِ",39,"م",1,0],["وَبَنو الدَيّانِ لا يَأتونَ لا","وَعَلى أَلسُنِهِم خَفَّت نَعَم",40,"م",1,1],["وبنا لها وما ولدته","ن إناثاً طوراً وطوراً ذكورا",41,"ر",2,1],["وَبَنو عُبادٍ حينَ أُحرِجَ حارِثٌ","جَرّوا التَخالُفَ في بَني شَيبانِ",42,"ن",1,0],["وَبَنو أَبيهِ وَرَهطُهُ في مَعرَكٍ","نَصَرَ الإِلَهُ بِهِ ذَوي الإِسلامِ",43,"م",1,0],["وَبَنى لَهُم بَيتاً أَبوكَ مُقَصِّراً","كُفراً وَلُؤماً بِئسَ بَيتُ المَحتِدِ",44,"د",1,0],["وَبَنوكَ نَوكى كُلُّهُم ذو عِلَّةٍ","وَلَأَنتَ شَرٌّ مِن بَنيكَ وَأَلأَمُ",45,"م",1,0],["وَبَنانٍ نادِرٍ أَطرافُها","وَعَراقيبَ تَفَسّا كَالفِلَك",46,"ك",1,0],["وَبِنا أَعَزَّ نَبِيَّهُ وَكِتابَهُ","وَأَعَزَّنا بِالضَربِ وَالإِقدامِ",47,"م",1,0],["وَبَني الحِماسِ لَأَبعَثَنَّ عَلَيهِمِ","حَرباً تَفوقُ نَوائِبَ الحَدَثانِ",48,"ن",1,0],["وَبَنى المَليكُ مِنَ المَخازي فَوقَهُم","بَيتاً أَقامَ عَلَيهِمِ لَم يُنقَلِ",49,"ل",1,0],["وبنتِ نعيم في ضباب