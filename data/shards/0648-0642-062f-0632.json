an/poem/33694","المتقارب"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136380",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139629",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101936","الطويل"],[1012,"الحكمة الفلسفية","https://www.poetsgate.com/ViewPoem.aspx?id=186331",""],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[1901,"أنساك ما سَرَّكَ من بُعدِه","https://www.poetsgate.com/ViewPoem.aspx?id=160412",""],[5183,"سَيْفُ الْلّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186452",""],[778,"وحانة خمار انخت مطيتي","https://www.poetsgate.com/ViewPoem.aspx?id=89223",""],[5219,"عزف على أوتار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=194114",""],[5219,"الأم مدرسة إذا.......","https://www.poetsgate.com/ViewPoem.aspx?id=194906",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"ألا بلغا من قد تسامى به الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=128830",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"صلاةُ العرْبِ في قدْسنا الفجْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=188290",""],[5376,"هل أنشدُ الدارَ قحطاناً وعدنانا.","https://www.poetsgate.com/ViewPoem.aspx?id=188463",""],[5431,"حب بدائي...","https://www.poetsgate.com/ViewPoem.aspx?id=215203",""],[5582,"لَقَدْ زِدْتِ نُوراً يا ابْنَةَ الخَمْسِ وَالتِّسْعِ","https://www.poetsgate.com/ViewPoem.aspx?id=187178",""],[5660,"شَرِبتُ العِشقَ في الأَرحامِ صَفواً","https://www.poetsgate.com/ViewPoem.aspx?id=23799",""],[5688,"عَذَابُ الشَّوْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=200684",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5979,"حمى الله من كيد الزمان خلائقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181360",""],[6069,"متى نجعت في لوعتي وبلابلي","https://www.poetsgate.com/ViewPoem.aspx?id=105701",""],[6079,"أيُبكيكَ رَسمٌ في الشآم عليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207850",""],[6079,"ألا إن ليلى لا يدوم لها ودُّ","https://www.poetsgate.com/ViewPoem.aspx?id=210599",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""],[5724,"أحجاج بيت الله ألف تحية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55154&r=&rc=21",""],[5190,"الرزق الحلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78291&r=&rc=5",""],[6156,"أَمَاطَتْ لِثَاماً عَنْ أَقَاحِي الدَّمَائِثِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17593&r=&rc=9",""],[572,"أَتَأسَى يا أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9288&r=&rc=145",""]],"verses":[["وَقَد زَأدَت ضَراغِمُها الضَواري","وَقَد هَدَرَت مَصاعِبُها الصِعابُ",0,"ب",1,0],["وَقَد زُرتُها وَالباتِراتُ هَواتِفٌ","بِنا وَأَنابيبُ الرُدَينيَّةِ المُلْدُ",1,"د",1,0],["وَقَدْ زَعَمُوا أَنِّي أُلِينُ عَريكَتي","لَهُمْ إِذْ تَوَسَّدْتُ الخَمَاصَةَ مُعْدِما",2,"م",2,0],["وقد زُرْتُ منْ أفْناءِ سَعْدٍ ومالكٍ","ضَراغِمَةً تُغْرى كِنانِيَّةً غُلْبا",3,"ب",2,0],["وَقَد زَعَمَت يُمنٌ بِأَنّي أَرَدتُها","عَلى نَفسِها تَبّاً لِذَلِكَ مِن فِعلِ",4,"ل",1,0],["وَقَد زَعَمَ الحُرُّ اِبنُ نَوفَلَ أَنَّ ذا","أَصَبُّ وَأَجرى لِلدُّموعِ وَأَشوَقُ",5,"ق",1,0],["وقد زَحَفتْ يُعْشِي العيونَ رُواؤُها","صُفوفٌ من الفُرْسانِ وهْيَ دَوارِعُ",6,"ع",1,0],["وَقَد زانَ لَهوَكَ ثَوبُ الوَقارِ","فَلَهوُكَ في كُلِّ ذَوقٍ حَلا",7,"ا",1,0],["وَقَد زادَ أَلعابَهُ بَهجَةً","مَكانٌ فَسيحٌ مُعَدٌّ لَها",7,"ا",1,0],["وَقَد زالَ ما كانَ مِن أُلفَةٍ","وَوُدٍّ زَوالَ شِهابِ الدُجى",8,"ا",1,0],["وَقَد زانَها زيناً لَهُ وَكَرامَةً","كَما كانَ في ظَهرِ البِلادِ يَزينُها",9,"ن",3,0],["وَقَد زَعَمَت أَني تَغَيَّرتُ بَعدَها","وَمَن ذا الَّذي يا عَزَّ لا يَتَغَيَّرُ",10,"ر",1,0],["وَقَد زَوَّدَت مَيٌّ عَلى النَأي قَلبَهُ","عَلاقاتِ حاجاتٍ طَويلٍ سَقامُها",11,"م",3,0],["وقد زرتمو دار السلام زيارة","ستذكرها الأقلام بالشكر والحمد",12,"د",1,0],["وقد زحفت لهم فيها جيوش","تجاوزت الألوف مع المئينا",13,"ن",2,0],["وقد زعموا أن لَسْن يصلحن في الدنى","لغير قرار في البُيوت وباء",14,"ا",2,0],["وَقَد زَعَموا أَنَّ الفَرَزدَقَ حَيَّةٌ","وَما قَتَلَ الحَيّاتِ مِن أَحَدٍ قَبلي",15,"ل",2,0],["وَقَد زَوَّدَت مِنّا عَلى النَأيِ حاجَةً","وَشَوقاً لَوَ أَنَّ الشَوقَ أَصبَحَ عادِلا",16,"ل",2,0],["وَقَد زَوَّجوها وَقَد عَنَسَت","وَقَد أَيقَنوا أَنَّها عاقِرُ",17,"ر",1,0],["وَقَد زَعَمتُم بِأَن تَحموا ذِمارَكُمُ","وَماءُ بَدرٍ زَعَمتُم غَيرُ مَورودِ",18,"د",1,0],["وقد زال من أفق الأثير عن الورَى","سنا كوكبٍ تسهو السها لمناله",19,"ل",2,0],["وقد زَعَمتْ ألّا تزالَ كعهِدنا","وإن طال بي غَيْب وطال بها العُمْر",20,"ر",1,0],["وقد زاح المزاحُ وآن جدٌّ","كجدّ الليثِ حفّتْهُ الشبولُ",21,"ل",1,0],["وَقَد زَعَموا أَنَّهُ مَضعَفٌ","وَما عَلِموا أَنَّهُ مُضعِفي",22,"ف",2,0],["وَقَد زَعَمَت أَنَّها","وَلَيسَت بِتِلكَ الَّتي",23,"ت",2,0],["وَقَد زَعَموهُ لِلغاداتِ رَمساً","وَأَنتَ لِهَمِّهِنَّ الدَهرَ رَمسُ",24,"س",1,0],["وَقَد زادَ البَسالَةَ مِن وَقارِ","هِزَبرٌ مِن لُيوثِ التُركِ ضاري",25,"ا",3,0],["وقَدْ زَعموا أَنِّي بغيركِ مُغْرَمٌ","وعنكِ عَزُوفٌ كالصَّدوفِ المُوارِبِ",26,"ب",1,0],["وَقَد زَعَموا أَنَّهُ إِن يَعُد","يَعُد مَعَهُ المَلِكُ المُعتَصِب",27,"ب",1,0],["وَقَد زَعَموا أَنَّ النُجومَ خَوالِدٌ","وَلَو حارَبَتهُ ناحَ فيها الثَواكِلُ",28,"ل",1,0],["وقد زادَ طِيباً ذِكركُم مُذْ مُحِنْتُمُ","كذا العودُ إِن مَسَّتْهُ نارٌ تضَوَّعَا",29,"ع",2,0],["وقد زادَها حُبَّاً لديَّ ونعمةً","سفارتُها بينَ الأراكةِ والرَّنْدِ",30,"د",1,0],["وَقَد زَعَمَت لا يَقرُبُ اللَهوَ ذو الحِجى","وَقَد يَشهَدُ اللَهوَ الَّذي يَشهَدُ النَوى",31,"و",2,0],["وَقَد زادَها إِفراطَ حُسنٍ جِوارُها","لِأَخلاقِ أَصفارٍ مِنَ المَجدِ خُيَّبِ",32,"ب",1,0],["وَقَد زَعَموا مِصرٌ مَعانٌ مِنَ الغِنى","فَكَيفَ أَسَفَّت بي إِلى عَدَمٍ مِصرُ",33,"ر",1,0],["وَقَد زَعَموا أَن لَيسَ يَغتَصِبُ الفَتى","عَلى عَزمِهِ إِلّا الهَدِيَّةُ وَالسِحرُ",34,"ر",1,0],["وَقَد زاحَمَت حَظّي الحُظوظُ وَأَجلَبَت","طَوارِقُ مِنها صادِراتٌ وَشُرَّعُ",35,"ع",1,0],["وَقَد زَعَمَت أَنّي تَعَمَّدتُ هَجرَها","وَلَم تَدرِ ماخَطبُ الهَوى وَبَلابِلُه",36,"ل",2,0],["وَقَد زَعَمَت أَن سَوفَ تُنجِحُ ما وَأَت","وَظَنّي بِها الإِخلافُ في ذَلِكَ الزَعمِ",37,"م",1,0],["وقد زَعْزَعَت منهم ثَبِيراً وقلَّعَت","شُماماً وهزَّت يَذبُلاً وَيَرَمْرَما",38,"م",2,0],["وَقَد زينَ حُسنُ سَماءِ الغُصونِ","بِأَنجُمِ أَزهارِها الزاهِرَه",39,"ر",2,0],["وَقَد زُرناكَ في أَمسٍ فَزُرنا","نَكُن عِندَ الزِيارَةِ بِالسَواءِ",40,"ا",2,0],["وقد زارَ عذبَ اللمى في الأقاحِ","أُجاجُ الدموع منَ النّرجِسِ",41,"س",1,0],["وَقَد زَعَمَت أَنَّ الَّذي وَجَدَت بِنا","مُقيمٌ لَنا في أَسوَدِ القَلبِ دائِمُ",42,"م",1,0],["وَقَد زَعَموا أَنَّ المُحِبَّ إِذا دَنا","يَمَلُّ وَأَنَّ النَأيَ يَشفي مِنَ الوَجدِ",43,"د",1,0],["وَقَد زَعَمَت أَنّي سَأَبغي إِذا نَأَت","بِها بَدَلاً يا بِئسَ ما بِيَ ظَنَّتِ",44,"ت",1,0],["وَقَد زَعموها تُنفِدُ المالَ كَثرةً","فَهَل ترَكوا مالاً هُناكَ فَينفدا",45,"د",2,0],["وَقَد زَبَرَتْ زَبْراً وقَبْضاً وحارِثاً","كِنانةُ مِثْلَ الكَرْمِ إبَّانَ يُزْبَرُ",46,"ر",1,0],["وَقَد زادَني وَجداً عَلَيها وَما دَرَت","مَجامِرُ في أَيدي الجَواري تَأَجَّجُ",47,"ج",1,0],["وَقَد زُوِّجَت عُثمانَ دَرّاً غَريرَةً","فَيا لَيتَني عُثمانُ إِذ لَم تُزَوَّجِ",48,"ج",1,0],["وَقَد زادَني شَوقاً هَديلُ حَمامَةٍ","عَلى إِلفِها تَبكي لَهُ وَتُطَرِّبُ",49,"ب",1,0],["وَقَد زَعَموا هَذي النُفوسَ بَواقِياً","تَشَكَّلُ في أَجسامِها وَتَهَذَّبُ",50,"ب",1,0],["وَقَد زَعَموا بِأَنَّ لَها عُقولاً","وَأَقضِيَةُ المَليكِ مُؤَكَّداتُ",51,"ت",1,0],["وَقَد زَعَموا النارَ مَبعوثَةً","تُهَذِّبُ مِمَّن عَلَيكِ الخَبَث",52,"ث",1,0],["وَقَد زَعَموا أَنَّ القِرانَ مُغَيِّرٌ","مُلوكَ بَني النَضرِ الأُلى مَلَكوا النَضرا",53,"ر",2,0],["وَقَد زَعَموا الأَفلاكَ يُدرِكُها البِلى","فَإِن كانَ حَقّاً فَالنَجاسَةُ كَالطُهرِ",54,"ر",1,0],["وَقَد زَعَموا أَنَّ الشَقِيَّ هُوَ الَّذي","حَوى السَعدَ فيها وَالسَعادَةَ لِلأَشقى",55,"ق",2,0],["وَقَد زالَ عَنهُ ساكِنٌ بَعدَ ساكِنٍ","فَهَل هُوَ ماضٍ مَرَّةً بِمُزيلِ",56,"ل",1,0],["وَقَد زَعَمَ الزَواعِمُ وَاِفتَكَرنا","فَوَيحٌ لِلخَواطِرِ ما هَجَسنَه",57,"ن",2,0],["وَقَد زارَني طيفها مرة","فَيا لَك طيفاً يَزور لماما",58,"م",2,0],["وَقَد زوجوها وَهي غير مريدة","بشيخ كَبير جاء بالمال يُطمع",59,"ع",1,0],["وقد زحفت يغشي العيون رواؤها","صفوف من الفرسان وهي دوارع",60,"ع",1,0],["وَقَدْ زَعَمَتْ لا يَقربُ اللّهوَ ذو الحجى،","وَقد يَشهَد اللّهوَ الذي يَشهُد النّجوَى",61,"و",2,0],["وَقَدْ زَعَمتْ أَنِّي تَغَيَّرتُ بَعْدَهَا","وَلَمْ تَدْرِ مَا خَطْبُ الْهَوَى وَبَلاَبِلُهُ",62,"ل",2,0],["وَقد زَعَمُو أنْ لَيْسَ يَغتَصِبُ الفتى،","على عَزْمِهِ، إلاّ الهَدِيّةُ والسّحْرُ",63,"ر",1,0],["وقد زار عذبَ اللمى في الأقلح","أُجاجُ الدموع من النّرجس",64,"س",1,0],["وقد زعمت وفاءً من أبيها","لقد كذبت وما ألفت وفاء",65,"ا",2,0],["وقد زعمَ المخبّرُ من قريبٍ","بأنّا حيث يطّلع البراء",65,"ا",2,0],["وقد زادها حسنا لعينيك أنها","على مسمعَىْ داود يُتلَى زَبورُها",66,"ر",3,0],["وقد زففنا هداياه مُنمنَمةً","كأنّها في رقاب المجد تِقصارُ",67,"ر",1,0],["وَقَد زَأَرَت أُسودُهُمُ فَلَمّا","دَنَوتَ غَدا زَئيرُهُمُ شَهيقا",68,"ق",2,0],["وَقَد زِدتَها مِنَ التَقِيَّةِ نِحلَةً","فَكُنتَ الأَعَفَّ الأَحلَمَ الأَكرَمَ الأَتقا",69,"ق",2,0],["وقد زعمتَ بأنَّ النَّفسَ زاكيةٌ","أنَّى وأنت مع الأمحاض ممتذق",70,"ق",1,0],["وقد زلزلت شم الذرا منك هيبةً","وضاقت بمن ناواك في الأرض سبلُهَ",71,"ل",2,0],["وقد زين الشيطان أعمالهم لهم","وأوهم منهم من طغى أنه الأعلا",72,"ل",2,0],["وَقد زَفَرَت صِرٌّ فَغَشَّت صُدورها","وُجوهَ المَهاري بِالحَصى وَالكَثاكِثِ",73,"ث",1,0],["وَقَد زَحَفت بِالقَومِ زَحفاً فَزُلزِلَت","وَماجَت بِمَن فيها وَحانَ اِنقِلابُها",74,"ب",3,0],["وَقَد زَعَموا في زَعمِهم أَنَّ خَيلَهُم","تَدوسُ قُرى البَحَرينِ مِن كُلِّ جانِبِ",75,"ب",1,0],["وَقَد زالَتِ الأَعذارُ لا الغَوصُ بائِرٌ","وَلا البَحرُ مَمنوعٌ وَلا الدَخلُ فاسِدُ",76,"د",1,0],["وَقَد زَعمَت لى ما فَعَلتُ فَكَيفَ لِى","إِذا كُنتُ مَردُودَ الكَلامِ مُكَذَّبَا",77,"ب",2,0],["وَقَد زَعَما أَنَّ الهَوَى يُذهِبُ الهَوَى","وَما صَدَقَا فِى القَولِ حِينَ تَنَوَّعَا",78,"ع",2,0],["وَقَد زَعَمَوا أَنَّ الرِّياحَ إِذا جَرَت","يَمانِيةً يَشفِى المُحِبَّ دَبِيبُهَا",79,"ب",3,0],["وَقَد زَهِدوا في مالِهم وجمالهم","فَما عَشِقوا بَيضا ولا عشقوا صفرا",80,"ر",2,0],["وَقَد زَعَموا التبشيرَ لكنَّ ربّنا","يُكذِّبُهم إِذ قالَ في الذكر لا بُشرى",80,"ر",2,0],["وَقَد زَعموا مَع لينهم حبَّ خَيركم","فَلا تُخدَعوا مَن في الأفاعي رأى خيرا",80,"ر",2,0],["وقد زينَ السعدُ أبراجَها","على كلِ برجٍ ترفرفُ رايةْ",81,"ا",3,0],["وقد زها في جبينه أبداً","عنقودُ صدغٍ عليه معروشُ",82,"ش",1,0],["وقد زهرتْ بِيض النجوم كأنّها","على الأفُق الأعلى قلائد من درّ",83,"ر",1,0],["وقدْ زادت الراحُ إقْلاقَهُ","لَنا بعْدَما هَصَرتْ قَدهُ",84,"د",2,0],["وَقَدْ زَادَتْ بِمَنْ وَلَدَتْ عَلاَءً","فَمَا وَقَفَتْ بِمَنْ وَلَدَتْ بِحَدِّ",85,"د",1,0],["وقد زعمت ليلى بأنيَّ فاجرٌ","لنفسي تُقاها أو عليها فجورُها",86,"ر",3,0],["وَقَد زارَكُم صَلتٌ مِنَ القَومِ حاشِدٌ","وَأَنتُم لَهُ بادي الظَعينَةِ مُذنِبُ",87,"ب",1,0],["وقد زانهُ عقدٌ من الدرِّ تلتقي","على صَدرِها حبّاتُه بصليب",88,"ب",1,0],["وقد زدتم عليه ملكَ دارا","وقيصرَ ثم فرعونَ الحمي",89,"ي",1,0],["وَقَد زَعَموا أَنهُ كافِرٌ","وَأَنَّ التَزَندُقَ مِن شَكلِهِ",90,"ل",2,0],["وقد زان لقيا الناس في جلب نفعهم","وقد شان لقياهم على فوت إبان",91,"ن",1,0],["وَقَد زَعَموا أَنّ المحبّ إِذا دَنا","تَبدّل مِن غيّ الهَوى سلوةَ الرشدِ",92,"د",1,0],["وَقد زَففت لخيرِ الدين غانيةً","فَهوَ الّذي بِمزاياه يكافئها",93,"ا",3,0],["وَقَدْ زُفَّ في ضَوْءٍ مِن الشَّمْعِ أَسُوَدٌ","حَكَى وَحَكَتْ لَيْلاً تَرصَّعَ بالشُّهْبِ",94,"ب",1,0],["وَقَد زَعَم الأُفقَ أَنَّ الهِلا","لَ طَوقٌ عَلى النَحرِ مِنهُ اِنفَصَم",95,"م",1,0],["وقد زاد أشواقي إليكم حَمائمٌ","وما كنتُ أدرِي أنّ شيئاً يَزيدها",96,"د",3,0],["وقد زادَني فوق الذي كنتُ آلفاً","نجيبٌ نماهُ للعلا خيرُ مُنْجِب",97,"ب",1,0],["وقد زاد منه الرَّدفَ ثِقْلا سلاحُه","فبَرَّح بالخَصْرِ النحيلِ لُغوب",98,"ب",1,0],["وقد زارَنا رَوْعانَ يَسترقُ الخُطا","ليكتُمَ وَصْلاً والكَتومُ مُريب",98,"ب",1,0],["وقد زَعمَ النَّاسُ أن قَد غَنُوا","بِما خَيَّلَ البُخلُ لِلزَّاعِمِ",99,"م",1,0],["وقد زينتها في النساء بِكارةٌ","كما زين الأشجارَ في روضها السرو",100,"و",1,0],["وقد زانك العقل الوضيء بفكره","تُجِلُّ الحواسُ الخمسُ عن كل منكر",101,"ر",1,0],["وقد زان فيها فعلها فهو سالمٌ","كما شانها من فعلها عند علة",102,"ه",1,0],["وَقد زَهرت فيهِ الأَقاحي كَأَنَّها","ثغورُ عَذارى بِالأَراكَ تُعَهَّد",103,"د",1,0],["وقد زِيْنَتِ الأيّام مِنهُ بسيّدٍ","تُقَرِّضُه المدّاحُ في كلّ مَشهد",104,"د",1,0],["وقد زيد زيد ثم قال وعمه","أبو زيد المعروف عند أولي النهى",105,"ا",1,0],["وقد زادني يأسي سقاماً فكيف بالش","شقاء لصبّ داؤه في دوائهِ",106,"ه",1,0],["وقد زَيَّنَ الشيطانُ أعمالَه له","على أنهه لم يَدْرِ ما الله عامل",107,"ل",1,0],["وقد زارَ من أهوى على غير موعدٍ","فيا قُربَ منآه وبعد مزاره",108,"ر",2,0],["وَقَدْ زُمَّتْ رِكابُ الشِّرْكِ منها","إِلَى سَفَرٍ وَكَانَا الحادِيَيْنِ",109,"ن",1,0],["وَقَدْ زَأَرَتْ حوْلي أُسودٌ تَهامَستْ","لَهَا الأُسدُ أَنْ كُفِّي عن السمع زَارَكِ",110,"ك",1,0],["وَقَدْ زَادَ أَبناءُ السَّبيلِ وَسِيلَةً","وحَلُّوا فَزَادُوا أَنَّهم لَكَ ضِيفانُ",111,"ن",1,0],["وقد زعموا أنّ العفافَ غميزةٌ","وأن التراخي في الطِّلابِ نُكولُ",112,"ل",1,0],["وقد زادك التخميرُ عَبْقاً وضَوعةً","ونشراً كأنَّ الحبسَ كان مُداكا",113,"ك",2,0],["وقد زعموا أن لا مردَّ لفائتٍ","وأنّ الردى يومٌ مَتى حُمَّ قاطعُ",114,"ع",1,0],["وقد زعموا أنَّ الحجا متكَهّلٌ","وأنّ رجالاتِ السِيادةِ شِيبُ",115,"ب",1,0],["وقد زادني شكراً لِحُسْنِ وفائها","بما وَعَدتْ أنَّ الوفاءَ غريبُ",116,"ب",1,0],["وقد زعمَ الناسُ أنَّ السعيد","بضدّ اسمه قطُّ لم يسعدِ",117,"د",1,1],["وقد زعمت لمياءُ إنْ قد سلوتها","ويا راحتي لو كان في الأرض ما يسلي",118,"ل",2,0],["وقد زعموا أنَّ التفرّق في غدٍ","فلا سلمت من غير عقرٍ مطاياها",119,"ا",3,0],["وقد زعموا أنَّ الغرامَ فضيحةٌ","وفي مثل ميٍّ تستطابُ الفضائح",120,"ح",1,0],["وَقَد زَحَمْنا لَها أمضى قَوافِلِنا","فَأرقَلَتْ .. وَحَدا بالنَّاس ِحادينا",121,"ن",2,0],["وَقَد زَها تُفّاحَها المُضَرَّجُ","لَمّا بَدا لُفّاحَها المُدَبَّجُ",122,"ج",1,0],["وَقَد زَها رُمّانُها مَع مازِها","لَمّا حَوى حُسناً وَطيباً وَبَها",122,"ه",2,0],["وَقَد زَعَمَت بِهراءُ أَنَّ رِماحَنا","رِماحُ نَصارى لا تَخوضُ إِلى الدَمِ",123,"م",1,0],["وقد زعموا بأنَّ البين