{"poems":[[53,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[63,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[63,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[63,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[55,"يقولون لي واصل سواها لعلها","https://www.aldiwan.net/poem26186.html","الطويل"],[55,"كذبت على نفسي فحدثت أنني","https://www.aldiwan.net/poem26221.html","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[86,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[86,"تناءيت عنكم فحلت عرا","https://www.aldiwan.net/poem68847.html","المتقارب"],[35,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[35,"أيادي سبا يا عز ما كنت بعدكم","https://www.aldiwan.net/poem39151.html","الطويل"],[30,"مررنا على دار لمية مرة","https://www.aldiwan.net/poem29525.html","الطويل"],[88,"أرى بعد نوم طال في الشرق يقظة","https://www.aldiwan.net/poem44423.html","الطويل"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"ألا ما لأهل الشرق في برحاء","https://www.aldiwan.net/poem44973.html","الطويل"],[27,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[11,"أرى أجأ من وراء الشقيق","https://www.aldiwan.net/poem250.html",""],[23,"مستشعري حلق الماذي يقدمهم","https://www.aldiwan.net/poem21266.html","البسيط"],[72,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[51,"أحباءنا ما كان لي عنكم صبر","https://www.aldiwan.net/poem64074.html","الطويل"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[70,"لحاظك أمضى من المرهف","https://www.aldiwan.net/poem42815.html","المتقارب"],[70,"فلانة من تيهها","https://www.aldiwan.net/poem42996.html","مجزوء المتقارب"],[85,"تحية شاعر يا ماء جكسو","https://www.aldiwan.net/poem63712.html","الوافر"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[43,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[43,"دروع لملك الروم هذي الرسائل","https://www.aldiwan.net/poem9969.html","الطويل"],[62,"أتاني والأخبار سقم وصحة","https://www.aldiwan.net/poem52355.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"بنا أنت من مفجوة لم تعتب","https://www.aldiwan.net/poem10896.html","الطويل"],[45,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[45,"عمرت أبا إسحاق ما صلح العمر","https://www.aldiwan.net/poem63637.html","الطويل"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"سقى ربعها سح السحاب وهاطله","https://www.aldiwan.net/poem65565.html","الطويل"],[45,"أعن سفه يوم الأبيرق أم حلم","https://www.aldiwan.net/poem65673.html","الطويل"],[61,"قصاراك أن تلقى الزمان مسلما","https://www.aldiwan.net/poem51453.html","الطويل"],[66,"رعى الله ليلتنا بالحمى","https://www.aldiwan.net/poem38808.html","المتقارب"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[80,"شموس دعاهن وشك الفراق","https://www.aldiwan.net/poem31415.html","المتقارب"],[31,"رأيت بجنب الخيف هندا فراقني","https://www.aldiwan.net/poem41821.html","الطويل"],[33,"خليلي مرا بي على الأبرق الفرد","https://www.aldiwan.net/poem25950.html","الطويل"],[33,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[102,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[50,"أجارتنا أخطأت حظك فاخرجي","https://www.aldiwan.net/poem63987.html","الطويل"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[46,"نقمت على الدنيا ولا ذنب أسلفت","https://www.aldiwan.net/poem22057.html","الطويل"],[46,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[46,"أيا أرض فوقك أهل الذنوب","https://www.aldiwan.net/poem22236.html","المتقارب"],[46,"أرى الأرض فيها دولة مضرية","https://www.aldiwan.net/poem22600.html","الطويل"],[46,"غدا رمضاني ليس عني بمنقض","https://www.aldiwan.net/poem22643.html","الطويل"],[46,"إذا رشقت دنياك هذي إلى الفتى","https://www.aldiwan.net/poem23029.html","الطويل"],[46,"إذا صقلت دنياك مرآة عقلها","https://www.aldiwan.net/poem23215.html","الطويل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[45,"لَنَا أبَداً بَثٌّ نُعانيهِ من أرْوَى","https://www.poetsgate.com/ViewPoem.aspx?id=31686",""],[45,"أُرَجِّمُ في لَيْلَى الظُّنُونَ، وَإِنَّمَا","https://www.poetsgate.com/ViewPoem.aspx?id=31685",""],[45,"عَمَرْتَ أبا إسحاقَ ما صَلُحَ العُمْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31197",""],[80,"شموسٌ دعاهنّ وشكُ الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=3318",""]],"verses":[["وَقَد زَأدَت ضَراغِمُها الضَواري","وَقَد هَدَرَت مَصاعِبُها الصِعابُ",0,"ب",1,0],["وَقَد زُرتُها وَالباتِراتُ هَواتِفٌ","بِنا وَأَنابيبُ الرُدَينيَّةِ المُلْدُ",1,"د",1,0],["وَقَدْ زَعَمُوا أَنِّي أُلِينُ عَريكَتي","لَهُمْ إِذْ تَوَسَّدْتُ الخَمَاصَةَ مُعْدِما",2,"م",2,0],["وقد زُرْتُ منْ أفْناءِ سَعْدٍ ومالكٍ","ضَراغِمَةً تُغْرى كِنانِيَّةً غُلْبا",3,"ب",2,0],["وَقَد زَعَمَت يُمنٌ بِأَنّي أَرَدتُها","عَلى نَفسِها تَبّاً لِذَلِكَ مِن فِعلِ",4,"ل",1,0],["وَقَد زَعَمَ الحُرُّ اِبنُ نَوفَلَ أَنَّ ذا","أَصَبُّ وَأَجرى لِلدُّموعِ وَأَشوَقُ",5,"ق",1,0],["وقد زَحَفتْ يُعْشِي العيونَ رُواؤُها","صُفوفٌ من الفُرْسانِ وهْيَ دَوارِعُ",6,"ع",1,0],["وَقَد زانَ لَهوَكَ ثَوبُ الوَقارِ","فَلَهوُكَ في كُلِّ ذَوقٍ حَلا",7,"ا",1,0],["وَقَد زادَ أَلعابَهُ بَهجَةً","مَكانٌ فَسيحٌ مُعَدٌّ لَها",7,"ا",1,0],["وَقَد زالَ ما كانَ مِن أُلفَةٍ","وَوُدٍّ زَوالَ شِهابِ الدُجى",8,"ا",1,0],["وَقَد زانَها زيناً لَهُ وَكَرامَةً","كَما كانَ في ظَهرِ البِلادِ يَزينُها",9,"ن",3,0],["وَقَد زَعَمَت أَني تَغَيَّرتُ بَعدَها","وَمَن ذا الَّذي يا عَزَّ لا يَتَغَيَّرُ",10,"ر",1,0],["وَقَد زَوَّدَت مَيٌّ عَلى النَأي قَلبَهُ","عَلاقاتِ حاجاتٍ طَويلٍ سَقامُها",11,"م",3,0],["وقد زرتمو دار السلام زيارة","ستذكرها الأقلام بالشكر والحمد",12,"د",1,0],["وقد زحفت لهم فيها جيوش","تجاوزت الألوف مع المئينا",13,"ن",2,0],["وقد زعموا أن لَسْن يصلحن في الدنى","لغير قرار في البُيوت وباء",14,"ا",2,0],["وَقَد زَعَموا أَنَّ الفَرَزدَقَ حَيَّةٌ","وَما قَتَلَ الحَيّاتِ مِن أَحَدٍ قَبلي",15,"ي",1,0],["وَقَد زَوَّدَت مِنّا عَلى النَأيِ حاجَةً","وَشَوقاً لَوَ أَنَّ الشَوقَ أَصبَحَ عادِلا",16,"ل",2,0],["وَقَد زَوَّجوها وَقَد عَنَسَت","وَقَد أَيقَنوا أَنَّها عاقِرُ",17,"ر",1,0],["وَقَد زَعَمتُم بِأَن تَحموا ذِمارَكُمُ","وَماءُ بَدرٍ زَعَمتُم غَيرُ مَورودِ",18,"د",1,0],["وقد زال من أفق الأثير عن الورَى","سنا كوكبٍ تسهو السها لمناله",19,"ل",2,0],["وقد زَعَمتْ ألّا تزالَ كعهِدنا","وإن طال بي غَيْب وطال بها العُمْر",20,"ر",1,0],["وقد زاح المزاحُ وآن جدٌّ","كجدّ الليثِ حفّتْهُ الشبولُ",21,"ل",1,0],["وَقَد زَعَموا أَنَّهُ مَضعَفٌ","وَما عَلِموا أَنَّهُ مُضعِفي",22,"ي",1,0],["وَقَد زَعَمَت أَنَّها","وَلَيسَت بِتِلكَ الَّتي",23,"ي",1,0],["وَقَد زَعَموهُ لِلغاداتِ رَمساً","وَأَنتَ لِهَمِّهِنَّ الدَهرَ رَمسُ",24,"س",1,0],["وَقَد زادَ البَسالَةَ مِن وَقارِ","هِزَبرٌ مِن لُيوثِ التُركِ ضاري",25,"ا",3,0],["وقَدْ زَعموا أَنِّي بغيركِ مُغْرَمٌ","وعنكِ عَزُوفٌ كالصَّدوفِ المُوارِبِ",26,"ب",1,0],["وَقَد زَعَموا أَنَّهُ إِن يَعُد","يَعُد مَعَهُ المَلِكُ المُعتَصِب",27,"ب",1,0],["وَقَد زَعَموا أَنَّ النُجومَ خَوالِدٌ","وَلَو حارَبَتهُ ناحَ فيها الثَواكِلُ",28,"ل",1,0],["وقد زادَ طِيباً ذِكركُم مُذْ مُحِنْتُمُ","كذا العودُ إِن مَسَّتْهُ نارٌ تضَوَّعَا",29,"ع",2,0],["وقد زادَها حُبَّاً لديَّ ونعمةً","سفارتُها بينَ الأراكةِ والرَّنْدِ",30,"د",1,0],["وَقَد زَعَمَت لا يَقرُبُ اللَهوَ ذو الحِجى","وَقَد يَشهَدُ اللَهوَ الَّذي يَشهَدُ النَوى",31,"و",2,0],["وَقَد زادَها إِفراطَ حُسنٍ جِوارُها","لِأَخلاقِ أَصفارٍ مِنَ المَجدِ خُيَّبِ",32,"ب",1,0],["وَقَد زَعَموا مِصرٌ مَعانٌ مِنَ الغِنى","فَكَيفَ أَسَفَّت بي إِلى عَدَمٍ مِصرُ",33,"ر",1,0],["وَقَد زَعَموا أَن لَيسَ يَغتَصِبُ الفَتى","عَلى عَزمِهِ إِلّا الهَدِيَّةُ وَالسِحرُ",34,"ر",1,0],["وَقَد زاحَمَت حَظّي الحُظوظُ وَأَجلَبَت","طَوارِقُ مِنها صادِراتٌ وَشُرَّعُ",35,"ع",1,0],["وَقَد زَعَمَت أَنّي تَعَمَّدتُ هَجرَها","وَلَم تَدرِ ماخَطبُ الهَوى وَبَلابِلُه",36,"ل",2,0],["وَقَد زَعَمَت أَن سَوفَ تُنجِحُ ما وَأَت","وَظَنّي بِها الإِخلافُ في ذَلِكَ الزَعمِ",37,"م",1,0],["وقد زَعْزَعَت منهم ثَبِيراً وقلَّعَت","شُماماً وهزَّت يَذبُلاً وَيَرَمْرَما",38,"م",2,0],["وَقَد زينَ حُسنُ سَماءِ الغُصونِ","بِأَنجُمِ أَزهارِها الزاهِرَه",39,"ر",2,0],["وَقَد زُرناكَ في أَمسٍ فَزُرنا","نَكُن عِندَ الزِيارَةِ بِالسَواءِ",40,"ا",2,0],["وقد زارَ عذبَ اللمى في الأقاحِ","أُجاجُ الدموع منَ النّرجِسِ",41,"س",1,0],["وَقَد زَعَمَت أَنَّ الَّذي وَجَدَت بِنا","مُقيمٌ لَنا في أَسوَدِ القَلبِ دائِمُ",42,"م",1,0],["وَقَد زَعَموا أَنَّ المُحِبَّ إِذا دَنا","يَمَلُّ وَأَنَّ النَأيَ يَشفي مِنَ الوَجدِ",43,"د",1,0],["وَقَد زَعَمَت أَنّي سَأَبغي إِذا نَأَت","بِها بَدَلاً يا بِئسَ ما بِيَ ظَنَّتِ",44,"ت",1,0],["وَقَد زَعموها تُنفِدُ المالَ كَثرةً","فَهَل ترَكوا مالاً هُناكَ فَينفدا",45,"د",2,0],["وَقَد زَبَرَتْ زَبْراً وقَبْضاً وحارِثاً","كِنانةُ مِثْلَ الكَرْمِ إبَّانَ يُزْبَرُ",46,"ر",1,0],["وَقَد زادَني وَجداً عَلَيها وَما دَرَت","مَجامِرُ في أَيدي الجَواري تَأَجَّجُ",47,"ج",1,0],["وَقَد زُوِّجَت عُثمانَ دَرّاً غَريرَةً","فَيا لَيتَني عُثمانُ إِذ لَم تُزَوَّجِ",48,"ج",1,0],["وَقَد زادَني شَوقاً هَديلُ حَمامَةٍ","عَلى إِلفِها تَبكي لَهُ وَتُطَرِّبُ",49,"ب",1,0],["وَقَد زَعَموا هَذي النُفوسَ بَواقِياً","تَشَكَّلُ في أَجسامِها وَتَهَذَّبُ",50,"ب",1,0],["وَقَد زَعَموا بِأَنَّ لَها عُقولاً","وَأَقضِيَةُ المَليكِ مُؤَكَّداتُ",51,"ت",1,0],["وَقَد زَعَموا النارَ مَبعوثَةً","تُهَذِّبُ مِمَّن عَلَيكِ الخَبَث",52,"ث",1,0],["وَقَد زَعَموا أَنَّ القِرانَ مُغَيِّرٌ","مُلوكَ بَني النَضرِ الأُلى مَلَكوا النَضرا",53,"ر",2,0],["وَقَد زَعَموا الأَفلاكَ يُدرِكُها البِلى","فَإِن كانَ حَقّاً فَالنَجاسَةُ كَالطُهرِ",54,"ر",1,0],["وَقَد زَعَموا أَنَّ الشَقِيَّ هُوَ الَّذي","حَوى السَعدَ فيها وَالسَعادَةَ لِلأَشقى",55,"ق",2,0],["وَقَد زالَ عَنهُ ساكِنٌ بَعدَ ساكِنٍ","فَهَل هُوَ ماضٍ مَرَّةً بِمُزيلِ",56,"ل",1,0],["وَقَد زَعَمَ الزَواعِمُ وَاِفتَكَرنا","فَوَيحٌ لِلخَواطِرِ ما هَجَسنَه",57,"ن",2,0],["وَقَد زارَني طيفها مرة","فَيا لَك طيفاً يَزور لماما",58,"م",2,0],["وَقَد زوجوها وَهي غير مريدة","بشيخ كَبير جاء بالمال يُطمع",59,"ع",1,0],["وقد زحفت يغشي العيون رواؤها","صفوف من الفرسان وهي دوارع",60,"ع",1,0],["وَقَدْ زَعَمَتْ لا يَقربُ اللّهوَ ذو الحجى،","وَقد يَشهَد اللّهوَ الذي يَشهُد النّجوَى",61,"و",2,0],["وَقَدْ زَعَمتْ أَنِّي تَغَيَّرتُ بَعْدَهَا","وَلَمْ تَدْرِ مَا خَطْبُ الْهَوَى وَبَلاَبِلُهُ",62,"ل",2,0],["وَقد زَعَمُو أنْ لَيْسَ يَغتَصِبُ الفتى،","على عَزْمِهِ، إلاّ الهَدِيّةُ والسّحْرُ",63,"ر",1,0],["وقد زار عذبَ اللمى في الأقلح","أُجاجُ الدموع من النّرجس",64,"س",1,0]]}