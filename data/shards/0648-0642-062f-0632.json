.html","عموديه"],[462,"سلوا بالحمى أين الظباء السوانح","https://www.aldiwan.net/poem3587.html","عموديه"],[463,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[466,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[469,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[475,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[475,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[475,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[501,"لعمرك يا جرير لقول عمرو","https://www.aldiwan.net/poem21749.html","الوافر"],[534,"وقد زاد نفسي واطمأنت وآمنت","https://www.aldiwan.net/poem23845.html","الطويل"],[549,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[549,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[549,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[549,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[551,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[556,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[556,"تمسك بغيب الغيب واترك سواه لا","https://www.aldiwan.net/poem33575.html","الطويل"],[556,"رفعت ولم أرفع إلى غير منزلي","https://www.aldiwan.net/poem34215.html","الطويل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[565,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[565,"أتأسى يا أبا بكر","https://www.aldiwan.net/poem69652.html","مجزوء الوافر"],[573,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[583,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[585,"أتعرف نظماً فيك منى مسراً","https://www.aldiwan.net/poem11501.html","عموديه"]],"verses":[["وَقَد زَأدَت ضَراغِمُها الضَواري","وَقَد هَدَرَت مَصاعِبُها الصِعابُ",0,"ب",1,0],["وَقَد زُرتُها وَالباتِراتُ هَواتِفٌ","بِنا وَأَنابيبُ الرُدَينيَّةِ المُلْدُ",1,"د",1,0],["وَقَدْ زَعَمُوا أَنِّي أُلِينُ عَريكَتي","لَهُمْ إِذْ تَوَسَّدْتُ الخَمَاصَةَ مُعْدِما",2,"م",2,0],["وقد زُرْتُ منْ أفْناءِ سَعْدٍ ومالكٍ","ضَراغِمَةً تُغْرى كِنانِيَّةً غُلْبا",3,"ب",2,0],["وَقَد زَعَمَت يُمنٌ بِأَنّي أَرَدتُها","عَلى نَفسِها تَبّاً لِذَلِكَ مِن فِعلِ",4,"ل",1,0],["وَقَد زَعَمَ الحُرُّ اِبنُ نَوفَلَ أَنَّ ذا","أَصَبُّ وَأَجرى لِلدُّموعِ وَأَشوَقُ",5,"ق",1,0],["وقد زَحَفتْ يُعْشِي العيونَ رُواؤُها","صُفوفٌ من الفُرْسانِ وهْيَ دَوارِعُ",6,"ع",1,0],["وَقَد زانَ لَهوَكَ ثَوبُ الوَقارِ","فَلَهوُكَ في كُلِّ ذَوقٍ حَلا",7,"ا",1,0],["وَقَد زادَ أَلعابَهُ بَهجَةً","مَكانٌ فَسيحٌ مُعَدٌّ لَها",7,"ا",1,0],["وَقَد زالَ ما كانَ مِن أُلفَةٍ","وَوُدٍّ زَوالَ شِهابِ الدُجى",8,"ا",1,0],["وَقَد زانَها زيناً لَهُ وَكَرامَةً","كَما كانَ في ظَهرِ البِلادِ يَزينُها",9,"ن",3,0],["وَقَد زَعَمَت أَني تَغَيَّرتُ بَعدَها","وَمَن ذا الَّذي يا عَزَّ لا يَتَغَيَّرُ",10,"ر",1,0],["وَقَد زَوَّدَت مَيٌّ عَلى النَأي قَلبَهُ","عَلاقاتِ حاجاتٍ طَويلٍ سَقامُها",11,"م",3,0],["وقد زرتمو دار السلام زيارة","ستذكرها الأقلام بالشكر والحمد",12,"د",1,0],["وقد زحفت لهم فيها جيوش","تجاوزت الألوف مع المئينا",13,"ن",2,0],["وقد زعموا أن لَسْن يصلحن في الدنى","لغير قرار في البُيوت وباء",14,"ا",2,0],["وَقَد زَعَموا أَنَّ الفَرَزدَقَ حَيَّةٌ","وَما قَتَلَ الحَيّاتِ مِن أَحَدٍ قَبلي",15,"ي",1,0],["وَقَد زَوَّدَت مِنّا عَلى النَأيِ حاجَةً","وَشَوقاً لَوَ أَنَّ الشَوقَ أَصبَحَ عادِلا",16,"ل",2,0],["وَقَد زَوَّجوها وَقَد عَنَسَت","وَقَد أَيقَنوا أَنَّها عاقِرُ",17,"ر",1,0],["وَقَد زَعَمتُم بِأَن تَحموا ذِمارَكُمُ","وَماءُ بَدرٍ زَعَمتُم غَيرُ مَورودِ",18,"د",1,0],["وقد زال من أفق الأثير عن الورَى","سنا كوكبٍ تسهو السها لمناله",19,"ل",2,0],["وقد زَعَمتْ ألّا تزالَ كعهِدنا","وإن طال بي غَيْب وطال بها العُمْر",20,"ر",1,0],["وقد زاح المزاحُ وآن جدٌّ","كجدّ الليثِ حفّتْهُ الشبولُ",21,"ل",1,0],["وَقَد زَعَموا أَنَّهُ مَضعَفٌ","وَما عَلِموا أَنَّهُ مُضعِفي",22,"ي",1,0],["وَقَد زَعَمَت أَنَّها","وَلَيسَت بِتِلكَ الَّتي",23,"ي",1,0],["وَقَد زَعَموهُ لِلغاداتِ رَمساً","وَأَنتَ لِهَمِّهِنَّ الدَهرَ رَمسُ",24,"س",1,0],["وَقَد زادَ البَسالَةَ مِن وَقارِ","هِزَبرٌ مِن لُيوثِ التُركِ ضاري",25,"ا",3,0],["وقَدْ زَعموا أَنِّي بغيركِ مُغْرَمٌ","وعنكِ عَزُوفٌ كالصَّدوفِ المُوارِبِ",26,"ب",1,0],["وَقَد زَعَموا أَنَّهُ إِن يَعُد","يَعُد مَعَهُ المَلِكُ المُعتَصِب",27,"ب",1,0],["وَقَد زَعَموا أَنَّ النُجومَ خَوالِدٌ","وَلَو حارَبَتهُ ناحَ فيها الثَواكِلُ",28,"ل",1,0],["وقد زادَ طِيباً ذِكركُم مُذْ مُحِنْتُمُ","كذا العودُ إِن مَسَّتْهُ نارٌ تضَوَّعَا",29,"ع",2,0],["وقد زادَها حُبَّاً لديَّ ونعمةً","سفارتُها بينَ الأراكةِ والرَّنْدِ",30,"د",1,0],["وَقَد زَعَمَت لا يَقرُبُ اللَهوَ ذو الحِجى","وَقَد يَشهَدُ اللَهوَ الَّذي يَشهَدُ النَوى",31,"و",2,0],["وَقَد زادَها إِفراطَ حُسنٍ جِوارُها","لِأَخلاقِ أَصفارٍ مِنَ المَجدِ خُيَّبِ",32,"ب",1,0],["وَقَد زَعَموا مِصرٌ مَعانٌ مِنَ الغِنى","فَكَيفَ أَسَفَّت بي إِلى عَدَمٍ مِصرُ",33,"ر",1,0],["وَقَد زَعَموا أَن لَيسَ يَغتَصِبُ الفَتى","عَلى عَزمِهِ إِلّا الهَدِيَّةُ وَالسِحرُ",34,"ر",1,0],["وَقَد زاحَمَت حَظّي الحُظوظُ وَأَجلَبَت","طَوارِقُ مِنها صادِراتٌ وَشُرَّعُ",35,"ع",1,0],["وَقَد زَعَمَت أَنّي تَعَمَّدتُ هَجرَها","وَلَم تَدرِ ماخَطبُ الهَوى وَبَلابِلُه",36,"ل",2,0],["وَقَد زَعَمَت أَن سَوفَ تُنجِحُ ما وَأَت","وَظَنّي بِها الإِخلافُ في ذَلِكَ الزَعمِ",37,"م",1,0],["وقد زَعْزَعَت منهم ثَبِيراً وقلَّعَت","شُماماً وهزَّت يَذبُلاً وَيَرَمْرَما",38,"م",2,0],["وَقَد زينَ حُسنُ سَماءِ الغُصونِ","بِأَنجُمِ أَزهارِها الزاهِرَه",39,"ر",2,0],["وَقَد زُرناكَ في أَمسٍ فَزُرنا","نَكُن عِندَ الزِيارَةِ بِالسَواءِ",40,"ا",2,0],["وقد زارَ عذبَ اللمى في الأقاحِ","أُجاجُ الدموع منَ النّرجِسِ",41,"س",1,0],["وَقَد زَعَمَت أَنَّ الَّذي وَجَدَت بِنا","مُقيمٌ لَنا في أَسوَدِ القَلبِ دائِمُ",42,"م",1,0],["وَقَد زَعَموا أَنَّ المُحِبَّ إِذا دَنا","يَمَلُّ وَأَنَّ النَأيَ يَشفي مِنَ الوَجدِ",43,"د",1,0],["وَقَد زَعَمَت أَنّي سَأَبغي إِذا نَأَت","بِها بَدَلاً يا بِئسَ ما بِيَ ظَنَّتِ",44,"ت",1,0],["وَقَد زَعموها تُنفِدُ المالَ كَثرةً","فَهَل ترَكوا مالاً هُناكَ فَينفدا",45,"د",2,0],["وَقَد زَبَرَتْ زَبْراً وقَبْضاً وحارِثاً","كِنانةُ مِثْلَ الكَرْمِ إبَّانَ يُزْبَرُ",46,"ر",1,0],["وَقَد زادَني وَجداً عَلَيها وَما دَرَت","مَجامِرُ في أَيدي الجَواري تَأَجَّجُ",47,"ج",1,0],["وَقَد زُوِّجَت عُثمانَ دَرّاً غَريرَةً","فَيا لَيتَني عُثمانُ إِذ لَم تُزَوَّجِ",48,"ج",1,0],["وَقَد زادَني شَوقاً هَديلُ حَمامَةٍ","عَلى إِلفِها تَبكي لَهُ وَتُطَرِّبُ",49,"ب",1,0],["وَقَد زَعَموا هَذي النُفوسَ بَواقِياً","تَشَكَّلُ في أَجسامِها وَتَهَذَّبُ",50,"ب",1,0],["وَقَد زَعَموا بِأَنَّ لَها عُقولاً","وَأَقضِيَةُ المَليكِ مُؤَكَّداتُ",51,"ت",1,0],["وَقَد زَعَموا النارَ مَبعوثَةً","تُهَذِّبُ مِمَّن عَلَيكِ الخَبَث",52,"ث",1,0],["وَقَد زَعَموا أَنَّ القِرانَ مُغَيِّرٌ","مُلوكَ بَني النَضرِ الأُلى مَلَكوا النَضرا",53,"ر",2,0],["وَقَد زَعَموا الأَفلاكَ يُدرِكُها البِلى","فَإِن كانَ حَقّاً فَالنَجاسَةُ كَالطُهرِ",54,"ر",1,0],["وَقَد زَعَموا أَنَّ الشَقِيَّ هُوَ الَّذي","حَوى السَعدَ فيها وَالسَعادَةَ لِلأَشقى",55,"ق",2,0],["وَقَد زالَ عَنهُ ساكِنٌ بَعدَ ساكِنٍ","فَهَل هُوَ ماضٍ مَرَّةً بِمُزيلِ",56,"ل",1,0],["وَقَد زَعَمَ الزَواعِمُ وَاِفتَكَرنا","فَوَيحٌ لِلخَواطِرِ ما هَجَسنَه",57,"ن",2,0],["وَقَد زارَني طيفها مرة","فَيا لَك طيفاً يَزور لماما",58,"م",2,0],["وَقَد زوجوها وَهي غير مريدة","بشيخ كَبير جاء بالمال يُطمع",59,"ع",1,0],["وقد زحفت يغشي العيون رواؤها","صفوف من الفرسان وهي دوارع",60,"ع",1,0],["وَقَدْ زَعَمَتْ لا يَقربُ اللّهوَ ذو الحجى،","وَقد يَشهَد اللّهوَ الذي يَشهُد النّجوَى",61,"و",2,0],["وَقَدْ زَعَمتْ أَنِّي تَغَيَّرتُ بَعْدَهَا","وَلَمْ تَدْرِ مَا خَطْبُ الْهَوَى وَبَلاَبِلُهُ",62,"ل",2,0],["وَقد زَعَمُو أنْ لَيْسَ يَغتَصِبُ الفتى،","على عَزْمِهِ، إلاّ الهَدِيّةُ والسّحْرُ",63,"ر",1,0],["وقد زار عذبَ اللمى في الأقلح","أُجاجُ الدموع من النّرجس",64,"س",1,0],["وقد زعمت وفاءً من أبيها","لقد كذبت وما ألفت وفاء",65,"ا",2,0],["وقد زعمَ المخبّرُ من قريبٍ","بأنّا حيث يطّلع البراء",65,"ا",2,0],["وقد زادها حسنا لعينيك أنها","على مسمعَىْ داود يُتلَى زَبورُها",66,"ر",3,0],["وقد زففنا هداياه مُنمنَمةً","كأنّها في رقاب المجد تِقصارُ",67,"ر",1,0],["وَقَد زَأَرَت أُسودُهُمُ فَلَمّا","دَنَوتَ غَدا زَئيرُهُمُ شَهيقا",68,"ق",2,0],["وَقَد زِدتَها مِنَ التَقِيَّةِ نِحلَةً","فَكُنتَ الأَعَفَّ الأَحلَمَ الأَكرَمَ الأَتقا",69,"ق",2,0],["وقد زعمتَ بأنَّ النَّفسَ زاكيةٌ","أنَّى وأنت مع الأمحاض ممتذق",70,"ق",1,0],["وقد زلزلت شم الذرا منك هيبةً","وضاقت بمن ناواك في الأرض سبلُهَ",71,"ل",2,0],["وقد زين الشيطان أعمالهم لهم","وأوهم منهم من طغى أنه الأعلا",72,"ل",2,0],["وَقد زَفَرَت صِرٌّ فَغَشَّت صُدورها","وُجوهَ المَهاري بِالحَصى وَالكَثاكِثِ",73,"ث",1,0],["وَقَد زَحَفت بِالقَومِ زَحفاً فَزُلزِلَت","وَماجَت بِمَن فيها وَحانَ اِنقِلابُها",74,"ب",3,0],["وَقَد زَعَموا في زَعمِهم أَنَّ خَيلَهُم","تَدوسُ قُرى البَحَرينِ مِن كُلِّ جانِبِ",75,"ب",1,0],["وَقَد زالَتِ الأَعذارُ لا الغَوصُ بائِرٌ","وَلا البَحرُ مَمنوعٌ وَلا الدَخلُ فاسِدُ",76,"د",1,0],["وَقَد زَعمَت لى ما فَعَلتُ فَكَيفَ لِى","إِذا كُنتُ مَردُودَ الكَلامِ مُكَذَّبَا",77,"ب",2,0],["وَقَد زَعَما أَنَّ الهَوَى يُذهِبُ الهَوَى","وَما صَدَقَا فِى القَولِ حِينَ تَنَوَّعَا",78,"ع",2,0],["وَقَد زَعَمَوا أَنَّ الرِّياحَ إِذا جَرَت","يَمانِيةً يَشفِى المُحِبَّ دَبِيبُهَا",79,"ب",3,0],["وَقَد زَهِدوا في مالِهم وجمالهم","فَما عَشِقوا بَيضا ولا عشقوا صفرا",80,"ر",2,0],["وَقَد زَعَموا التبشيرَ لكنَّ ربّنا","يُكذِّبُهم إِذ قالَ في الذكر لا بُشرى",80,"ر",2,0],["وَقَد زَعموا مَع لينهم حبَّ خَيركم","فَلا تُخدَعوا مَن في الأفاعي رأى خيرا",80,"ر",2,0],["وقد زينَ السعدُ أبراجَها","على كلِ برجٍ ترفرفُ رايةْ",81,"ا",3,0],["وقد زها في جبينه أبداً","عنقودُ صدغٍ عليه معروشُ",82,"ش",1,0],["وقد زهرتْ بِيض النجوم كأنّها","على الأفُق الأعلى قلائد من درّ",83,"ر",1,0],["وقدْ زادت الراحُ إقْلاقَهُ","لَنا بعْدَما هَصَرتْ قَدهُ",84,"د",2,0],["وَقَدْ زَادَتْ بِمَنْ وَلَدَتْ عَلاَءً","فَمَا وَقَفَتْ بِمَنْ وَلَدَتْ بِحَدِّ",85,"د",1,0],["وقد زعمت ليلى بأنيَّ فاجرٌ","لنفسي تُقاها أو عليها فجورُها",86,"ر",3,0],["وَقَد زارَكُم صَلتٌ مِنَ القَومِ حاشِدٌ","وَأَنتُم لَهُ بادي الظَعينَةِ مُذنِبُ",87,"ب",1,0],["وقد زانهُ عقدٌ من الدرِّ تلتقي","على صَدرِها حبّاتُه بصليب",88,"ب",1,0],["وقد زدتم عليه ملكَ دارا","وقيصرَ ثم فرعونَ الحمي",89,"ي",1,0],["وَقَد زَعَموا أَنهُ كافِرٌ","وَأَنَّ التَزَندُقَ مِن شَكلِهِ",90,"ل",2,0],["وقد زان لقيا الناس في جلب نفعهم","وقد شان لقياهم على فوت إبان",91,"ن",1,0],["وَقَد زَعَموا أَنّ المحبّ إِذا دَنا","تَبدّل مِن غيّ الهَوى سلوةَ الرشدِ",92,"د",1,0],["وَقد زَففت لخيرِ الدين غانيةً","فَهوَ الّذي بِمزاياه يكافئها",93,"ا",3,0],["وَقَدْ زُفَّ في ضَوْءٍ مِن الشَّمْعِ أَسُوَدٌ","حَكَى وَحَكَتْ لَيْلاً تَرصَّعَ بالشُّهْبِ",94,"ب",1,0],["وَقَد زَعَم الأُفقَ أَنَّ الهِلا","لَ طَوقٌ عَلى النَحرِ مِنهُ اِنفَصَم",95,"م",1,0],["وقد زاد أشواقي إليكم حَمائمٌ","وما كنتُ أدرِي أنّ شيئاً يَزيدها",96,"د",3,0],["وقد زادَني فوق الذي كنتُ آلفاً","نجيبٌ نماهُ للعلا خيرُ مُنْجِب",97,"ب",1,0],["وقد زاد منه الرَّدفَ ثِقْلا سلاحُه","فبَرَّح بالخَصْرِ النحيلِ لُغوب",98,"ب",1,0],["وقد زارَنا رَوْعانَ يَسترقُ الخُطا","ليكتُمَ وَصْلاً والكَتومُ مُريب",98,"ب",1,0],["وقد زَعمَ النَّاسُ أن قَد غَنُوا","بِما خَيَّلَ البُخلُ لِلزَّاعِمِ",99,"م",1,0],["وقد زينتها في النساء بِكارةٌ","كما زين الأشجارَ في روضها السرو",100,"و",1,0],["وقد زانك العقل الوضيء بفكره","تُجِلُّ الحواسُ الخمسُ عن كل منكر",101,"ر",1,0],["وقد زان فيها فعلها فهو سالمٌ","كما شانها من فعلها عند علة",102,"ه",1,0],["وَقد زَهرت فيهِ الأَقاحي كَأَنَّها","ثغورُ عَذارى بِالأَراكَ تُعَهَّد",103,"د",1,0],["وقد زِيْنَتِ الأيّام مِنهُ بسيّدٍ","تُقَرِّضُه المدّاحُ في كلّ مَشهد",104,"د",1,0],["وقد زيد زيد ثم قال وعمه","أبو زيد المعروف عند أولي النهى",105,"ا",1,0],["وقد زادني يأسي سقاماً فكيف بالش","شقاء لصبّ داؤه في دوائهِ",106,"ه",1,0],["وقد زَيَّنَ الشيطانُ أعمالَه له","على أنهه لم يَدْرِ ما الله عامل",107,"ل",1,0],["وقد زارَ من أهوى على غير موعدٍ","فيا قُربَ منآه وبعد مزاره",108,"ر",2,0],["وَقَدْ زُمَّتْ رِكابُ الشِّرْكِ منها","إِلَى سَفَرٍ وَكَانَا الحادِيَيْنِ",109,"ن",1,0],["وَقَدْ زَأَرَتْ حوْلي أُسودٌ تَهامَستْ","لَهَا الأُسدُ أَنْ كُفِّي عن السمع زَارَكِ",110,"ك",1,0],["وَقَدْ زَادَ أَبناءُ السَّبيلِ وَسِيلَةً","وحَلُّوا فَزَادُوا أَنَّهم لَكَ ضِيفانُ",111,"ن",1,0],["وقد زعموا أنّ العفافَ غميزةٌ","وأن التراخي في الطِّلابِ نُكولُ",112,"ل",1,0],["وقد زادك التخميرُ عَبْقاً وضَوعةً","ونشراً كأنَّ الحبسَ كان مُداكا",113,"ك",2,0],["وقد زعموا أن لا مردَّ لفائتٍ","وأنّ الردى يومٌ مَتى حُمَّ قاطعُ",114,"ع",1,0],["وقد زعموا أنَّ الحجا متكَهّلٌ","وأنّ رجالاتِ السِيادةِ شِيبُ",115,"ب",1,0],["وقد زادني شكراً لِحُسْنِ وفائها","بما وَعَدتْ أنَّ الوفاءَ غريبُ",116,"ب",1,0],["وقد زعمَ الناسُ أنَّ السعيد","بضدّ اسمه قطُّ لم يسعدِ",117,"د",1,1],["وقد زعمت لمياءُ إنْ قد سلوتها","ويا راحتي لو كان في الأرض ما يسلي",118,"ل",2,0],["وقد زعموا أنَّ التفرّق في غدٍ","فلا سلمت من غير عقرٍ مطاياها",119,"ا",3,0],["وقد زعموا أنَّ الغرامَ فضيحةٌ","وفي مثل ميٍّ تستطابُ الفضائح",120,"ح",1,0],["وَقَد زَحَمْنا لَها أمضى قَوافِلِنا","فَأرقَلَتْ .. وَحَدا بالنَّاس ِحادينا",121,"ن",2,0],["وَقَد زَها تُفّاحَها المُضَرَّجُ","لَمّا بَدا لُفّاحَها المُدَبَّجُ",122,"ج",1,0],["وَقَد زَها رُمّانُها مَع مازِها","لَمّا حَوى حُسناً وَطيباً وَبَها",122,"ه",2,0],["وَقَد زَعَمَت بِهراءُ أَنَّ رِماحَنا","رِماحُ نَصارى لا تَخوضُ إِلى الدَمِ",123,"م",1,0],["وقد زعموا بأنَّ البينَ يُنْسي","وَمنْ عَرَفَ الوِصالَ فكيف يَنسى",124,"س",2,0],["وقد زعموا أن المحبَّةَ رشدُها","ضلالٌ وهم عندَ المحبينَ ضُلاّلُ",125,"ل",1,0],["وقد زرتُ ربعَ الظاعنينَ عشيَّةً","فباتَ إلى قلبي رسيسُ الهوى يَهدي",126,"د",2,0],["وقَد زَأَرُوا إِليَّ أَوعَدُونِي","وَمَن ذَا مَاتَ مِن خَوفِ الكَلاَمِ",127,"م",1,0],["وَقَد زادَ نَفسي وَاِطمَأَنَّت وَآمَنَت","بِهِ اليَومَ ما لاقى جَوادُ اِبنِ مُدلِجِ",128,"ج",1,1],["وقد زلقتُم في مطافٍ له","بابٌ إلى العزّ ولم يزلقوا",129,"ق",3,0],["وَقَد زعزعوا لكنْ لمَن ليسَ يَنْثني","وقد هدّدوا لكنْ لمن ليس يفزَعُ",130,"ع",1,0],["وَقَد زارَنا بَعَد الهدوِّ تَوصُّلاً","إِلى الزّادِ غرْثانُ العشيّاتِ أطْلَسُ",131,"س",1,0],["وَقَد زادَني منكَ النّظامُ كأنّه","رياضٌ بأعلى الحَزْنِ جاد لها النّدى",132,"د",2,0],["وَقَد زادَني طَرَباً نَحوَهُ","مُضاجَعَةُ الياسَمينَ البَهارا",133,"ر",2,0],["وقد زرنا اَرسلان ال","وَليَّ الكاملَ الضيغمْ",134,"م",1,0],["وقد زرنا خليل الل","هِ إبراهيمهُ الملهمْ",134,"م",1,0],["وقد زرنا لعيسى مَو","لِداً أضحى ببيتِ اللّحمْ",134,"م",1,0],["وقد زادهم ربهم علمهم","به في المجالي وإجلالها",135,"ل",3,0],["وقد زاغت الأبصار عنه وزاغت ال","بصائر لما أن عصيتم تخيلا",136,"ل",2,0],["وقد زجَّ بي في النور نور وجودِهِ","فأصبحتُ معدوماً بغير تحوُّلِ",137,"ل",1,0],["وقد زهدوا في الزهد عما سواه إذ","رأوا الزهد معنىً للعقول يخادع",138,"ع",1,0],["وَقَدْ زَيَّنَهَا الطَّاهِي","لَنَا أَحْسَنَ تَزْيِيْنَهْ",139,"ن",2,0],["وَقَدْ زَوَّجْتَهَا القَبْرَ","وَمَا كَالقَبْرِ مِنْ صِهْرِ",140,"ر",1,0],["وقدْ زَعمُوا أَنِّي قُتِلتُ وأَنَّنِي","رَضيتُ فما بالُ المليحةِ تَغْضَبُ",141,"ب",1,0],["وقد زَفّ الربيع إِليك رَوْضاً","قشيبَ الزَّهْر مُعْتَلَّ النسيم",142,"م",1,0],["وقد زعموا أني نظمت ولم يكن","ولو كان أبديت الفؤاد المسطرا",143,"ر",2,0]]}