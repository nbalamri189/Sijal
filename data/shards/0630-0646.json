{"poems":[[53,"لقد طال هزي من قوائم معشر","https://www.aldiwan.net/poem29850.html","الطويل"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[53,"يعاقبني وهو المذنب","https://www.aldiwan.net/poem30692.html","المتقارب"],[3,"ذنبي لعبلة ذنب غير مغتفر","https://www.aldiwan.net/poem162.html",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.aldiwan.net/poem36535.html","الكامل"],[86,"ملك النهى لا تبعدي","https://www.aldiwan.net/poem10479.html","مجزوء الكامل"],[93,"ذنبها أنها رأت","https://www.aldiwan.net/poem9153.html","مجزوء الخفيف"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[88,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[91,"تلك السنون الغاربات ورائي","https://www.aldiwan.net/poem8726.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[58,"إذا قربت ساعة يا لها","https://www.aldiwan.net/poem30902.html","المتقارب"],[58,"ذنوبي إن فكرت فيها كثيرة","https://www.aldiwan.net/poem30969.html","الطويل"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[97,"إن تجد يا قلب قلباً قد لها","https://www.aldiwan.net/poem24347.html","الرمل"],[80,"فعوضت شيبا من شبابي كأنني","https://www.aldiwan.net/poem31211.html","الطويل"],[87,"ذنبي إليك غرامي","https://www.aldiwan.net/poem8275.html","المجتث"],[69,"قولوا لمن يفخر بالعظم","https://www.aldiwan.net/poem28565.html","السريع"],[69,"ألا يا نفس لا تعصي","https://www.aldiwan.net/poem28715.html","مجزوء الوافر"],[69,"من قال بالمرد فاحذر إن تصاحبه","https://www.aldiwan.net/poem28769.html","البسيط"],[105,"ما لي دعوت فلم أجد","https://www.aldiwan.net/poem42138.html","مجزوء الكامل"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[81,"ويأتي من الهجران زلة مدنف","https://www.aldiwan.net/poem61487.html","الوافر"],[46,"تصدق على الأعمى بأخذ يمينه","https://www.aldiwan.net/poem23333.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43840","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43638","الطويل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""]],"verses":[["ذُنابى قِصارٍ لا يَزيدونَ بَسطَةً","وَإِن رَكِبوا يَوماً ظَنَنتَهُمُ رَجلا",0,"ل",2,0],["ذَنبي إِلى البُهمِ الكَواذِبِ أَنَّني ال","طُرفُ المُطَهَّمُ وَالأَغَرُّ الأَقرَحُ",1,"ح",1,0],["ذُنوبي إِنِ اِستَمطَرتُ مِن غَيرِ ماطِرٍ","وَأَنّي طَلَبتُ الغَيثَ مِن غَيرِ غائِثِ",2,"ث",1,0],["ذُنابى مَصَعنَ بِأَبعارِهِنَّ","وَقَد يُمصَعُ الذَنَبُ الأَهلَبُ",3,"ب",1,0],["ذَنبي لِعَبلَةَ ذَنبٌ غَيرُ مُغتَفِرِ","لَمّا تَبَلَّجَ صُبحُ الشَيبِ في شَعري",4,"ر",2,1],["ذَنْبي عداني عنْ لِحاقِ ذوي الهُدى","فغدَوْتُ عنْ دَرَكِ الرّشادِ طَريدا",5,"د",2,0],["ذَنبُ المَنِيَّةِ في اِغتِيا","لِ شَبابِها لا يُغتَفَر",6,"ر",1,0],["ذنبها أنها رأت","فتصبته فانضوى",7,"و",2,1],["ذُنابى الشَفا أَو قَمسَةَ الشَمسِ أَزمَعا","رَواحاً فَمَدّا مِن نَجآءٍ مُناهِبِ",8,"ب",1,0],["ذَنَب أصبح للحك","م به أقبح شاره",9,"ر",2,0],["ذنب يستوجب الإخ","لاص والصدق انبتاره",9,"ر",2,0],["ذَنوبٍ يمس الأرض عند صيامه","بضافٍ يواري فرجَهُ سَبِط الهُلْبِ",10,"ب",1,0],["ذنبُ إحسانه العظيم لدينا","أننا عاجزون عن تعدادِهْ",11,"د",2,0],["ذَنبي إِلى الحُسّادِ أَنّي فُتُّهُم","وَتَرَكتُهُم يَتَعَثَّرونَ وَرائي",12,"ي",1,0],["ذَنبي إِلى هَذا الوَرى خِلقَتي","فَهَل أَنا المُجرِمَةُ الجانِيَه",13,"ه",1,0],["ذَنَبٌ كَما سُحِبَ الرِداءُ يَذُبُّ عَن","عُرفٍ وَعُرفٌ كَالقِناعِ المُسبَلِ",14,"ل",1,0],["ذنبي إلى الأعداء فضلُ مواقفي","والفضلُ ذنبٌ لستُ منه بتائبِ",15,"ب",1,0],["ذُنوبي ثِقالٌ فَما حِيلَتي","إِذا كُنتُ في البَعثِ حَمّالَها",16,"ل",3,0],["ذُنوبيَ إِن فَكَّرتُ فيها كَثيرَةٌ","وَرَحمَةُ رَبّي مِن ذُنوبي أَوسَعُ",17,"ع",1,1],["ذَنبٌ إِذا عُدَّ الذُنوبُ رَأَيتُهُ","مِن حُسنِهِ كَالخالِ في وَجَناتِها",18,"ت",3,0],["ذنبُ من يهواكَ أو ذنبُ السنين","ذلكَ الهجرُ ولا لومَ عليك",19,"ك",1,0],["ذنوبيَ تنمي كلّ يومٍ تكسّباً","فيوْمي بها في اليوْم أثقلُ من أمسي",20,"ي",1,0],["ذَنْبِي إِلَيْكَ غَرَامِي","فَهَلْ يَحِلُّ مَلامِي",21,"م",2,1],["ذنبي إليهمْ أنني عالمٌ","وفارسٌ في النثرِ والنظمِ",22,"م",1,0],["ذنوبي في زياداتٍ","وعمري لجَّ في النقصِ",23,"ص",1,0],["ذنبٌ بهِ هلكتْ منْ قبلنا أممٌ","والعرشُ يهتزُّ منْهُ هزَّ إكبارِ",24,"ر",1,0],["ذَنبي إليه أَمانةٌ","هي عنده شرُّ الذنوبْ",25,"ب",1,0],["ذَنبُ المُلوكِ رَمى الشُعوبَ بِنَكبَةٍ","جُلّى تَنوءُ بِحَملِها الغَبراءُ",26,"ا",2,0],["ذُنوبُ مَليحِ الوَجهِ غَيرُ قَبيحَةٍ","وَمِن عادَةِ العُشّاقِ شَحذُ العَزائِمِ",27,"م",1,0],["ذنَهَيتُكَ عَن سَهمِ الأَذى ريشَ بِالخَنى","وَنَصَّلَهُ غَيظٌ فَأُرهِفَ أَو سُمّا",28,"م",2,0],["ذَنْبٌ جَسِيمٌ يَقِلُّ الْ","تَّأْنِيبُ فِيهِ جَزَاءَ",29,"ا",2,0],["ذَنبي عَظيمٌ وَسالَتي أن","يَجعَلَكَ اللَهُ لي معاذا",30,"ذ",2,0],["ذُنوبي لَعَمري غَرَّقتني فَأَوبَقت","وَإِلّا فَإِنّي ثابِتُ القَلبِ جَهبَذُ",31,"ذ",1,0],["ذنوب الضعاف العاجزين كثيرةٌ","وما لقوى إذ تحاسبه ذنب",32,"ب",1,0],["ذنبي عداني عن لحاق ذوي الهوى","فغدوت عن درك الرشاد طريدا",33,"د",2,0],["ذنبنا والدهر في صرعته","أنٍْ وفينا لأخي الوِد وخانا",34,"ن",2,0]]}