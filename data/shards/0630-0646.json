{"poems":[[53,"لقد طال هزي من قوائم معشر","https://www.aldiwan.net/poem29850.html","الطويل"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[53,"يعاقبني وهو المذنب","https://www.aldiwan.net/poem30692.html","المتقارب"],[3,"ذنبي لعبلة ذنب غير مغتفر","https://www.aldiwan.net/poem162.html",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.aldiwan.net/poem36535.html","الكامل"],[86,"ملك النهى لا تبعدي","https://www.aldiwan.net/poem10479.html","مجزوء الكامل"],[93,"ذنبها أنها رأت","https://www.aldiwan.net/poem9153.html","مجزوء الخفيف"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[88,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[91,"تلك السنون الغاربات ورائي","https://www.aldiwan.net/poem8726.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[58,"إذا قربت ساعة يا لها","https://www.aldiwan.net/poem30902.html","المتقارب"],[58,"ذنوبي إن فكرت فيها كثيرة","https://www.aldiwan.net/poem30969.html","الطويل"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[97,"إن تجد يا قلب قلباً قد لها","https://www.aldiwan.net/poem24347.html","الرمل"],[80,"فعوضت شيبا من شبابي كأنني","https://www.aldiwan.net/poem31211.html","الطويل"],[87,"ذنبي إليك غرامي","https://www.aldiwan.net/poem8275.html","المجتث"],[69,"قولوا لمن يفخر بالعظم","https://www.aldiwan.net/poem28565.html","السريع"],[69,"ألا يا نفس لا تعصي","https://www.aldiwan.net/poem28715.html","مجزوء الوافر"],[69,"من قال بالمرد فاحذر إن تصاحبه","https://www.aldiwan.net/poem28769.html","البسيط"],[105,"ما لي دعوت فلم أجد","https://www.aldiwan.net/poem42138.html","مجزوء الكامل"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[81,"ويأتي من الهجران زلة مدنف","https://www.aldiwan.net/poem61487.html","الوافر"],[46,"تصدق على الأعمى بأخذ يمينه","https://www.aldiwan.net/poem23333.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43840","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43638","الطويل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[94,"وفاء القبور","https://www.poetsgate.com/ViewPoem.aspx?id=13790",""],[116,"يا ايها الحادي اعد مغناه","https://www.aldiwan.net/poem40434.html","عموديه"],[116,"ما هب نشر الصبا","https://www.aldiwan.net/poem41256.html","عموديه"],[116,"ذنوبي أثقلت ظهري وجلت","https://www.aldiwan.net/poem41986.html","الوافر"],[116,"ذنوبي أعمت عين قلبي وقالبي","https://www.aldiwan.net/poem41987.html","الطويل"],[116,"ذنوبي أثقلت ظهري وإني","https://www.aldiwan.net/poem42013.html","الوافر"],[121,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[161,"ما خاب من في الله كان رجاه","https://www.aldiwan.net/poem59130.html","الكامل"],[161,"إلى كم تمادى في غرور وغفلة","https://www.aldiwan.net/poem59149.html","الطويل"],[187,"إن الحسود بلاؤه حسده","https://www.aldiwan.net/poem43967.html","الكامل"],[190,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[200,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[211,"سفحت عقيق الدمع من سفح مقلتي","https://www.aldiwan.net/poem13304.html","الطويل"],[212,"أتخطر في بالي خطرت فليتني","https://www.aldiwan.net/poem46622.html","الطويل"],[233,"من شيمة الدهر إعراض وإقبال","https://www.aldiwan.net/poem14796.html","البسيط"],[236,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[250,"ألا بلحت خفارة آل لأم","https://www.aldiwan.net/poem2117.html","الوافر"],[251,"ذخرت مديحي في النبي محمد","https://www.aldiwan.net/poem15062.html","الطويل"],[310,"فإن الله تواب رحيم","https://www.aldiwan.net/poem50228.html","الوافر"],[310,"أفي السبخات يا مغبون تبني","https://www.aldiwan.net/poem50299.html","الوافر"],[354,"شكا ثقل الذنوب لنا ثقيل","https://www.aldiwan.net/poem39979.html","الوافر"],[367,"بعد المعاطف والروادف لم ترق","https://www.aldiwan.net/poem17156.html","الكامل"],[442,"متى بنا العيس ينكحن السماليقا","https://www.aldiwan.net/poem14318.html","البسيط"],[442,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[442,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[442,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[442,"قد خان سمعي وعيني خانها بصري","https://www.aldiwan.net/poem14370.html","البسيط"],[442,"لك اللهم تبت من المعاصي","https://www.aldiwan.net/poem14376.html","الوافر"],[442,"حقيق إن بكيت دماً حقيق","https://www.aldiwan.net/poem14382.html","الوافر"],[442,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[442,"هيظت قلبي أبا الخرصي يسلوكا","https://www.aldiwan.net/poem14470.html","البسيط"],[454,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[459,"أسترشد البان وهو غضبان","https://www.aldiwan.net/poem55858.html","المنسرح"],[478,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[501,"آل النبي الطاهر المصطفى","https://www.aldiwan.net/poem37678.html","السريع"],[501,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[516,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[559,"ذو العلم يعرف أن أصل المأخذ","https://www.aldiwan.net/poem33551.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["ذُنابى قِصارٍ لا يَزيدونَ بَسطَةً","وَإِن رَكِبوا يَوماً ظَنَنتَهُمُ رَجلا",0,"ل",2,0],["ذَنبي إِلى البُهمِ الكَواذِبِ أَنَّني ال","طُرفُ المُطَهَّمُ وَالأَغَرُّ الأَقرَحُ",1,"ح",1,0],["ذُنوبي إِنِ اِستَمطَرتُ مِن غَيرِ ماطِرٍ","وَأَنّي طَلَبتُ الغَيثَ مِن غَيرِ غائِثِ",2,"ث",1,0],["ذُنابى مَصَعنَ بِأَبعارِهِنَّ","وَقَد يُمصَعُ الذَنَبُ الأَهلَبُ",3,"ب",1,0],["ذَنبي لِعَبلَةَ ذَنبٌ غَيرُ مُغتَفِرِ","لَمّا تَبَلَّجَ صُبحُ الشَيبِ في شَعري",4,"ر",2,1],["ذَنْبي عداني عنْ لِحاقِ ذوي الهُدى","فغدَوْتُ عنْ دَرَكِ الرّشادِ طَريدا",5,"د",2,0],["ذَنبُ المَنِيَّةِ في اِغتِيا","لِ شَبابِها لا يُغتَفَر",6,"ر",1,0],["ذنبها أنها رأت","فتصبته فانضوى",7,"و",2,1],["ذُنابى الشَفا أَو قَمسَةَ الشَمسِ أَزمَعا","رَواحاً فَمَدّا مِن نَجآءٍ مُناهِبِ",8,"ب",1,0],["ذَنَب أصبح للحك","م به أقبح شاره",9,"ر",2,0],["ذنب يستوجب الإخ","لاص والصدق انبتاره",9,"ر",2,0],["ذَنوبٍ يمس الأرض عند صيامه","بضافٍ يواري فرجَهُ سَبِط الهُلْبِ",10,"ب",1,0],["ذنبُ إحسانه العظيم لدينا","أننا عاجزون عن تعدادِهْ",11,"د",2,0],["ذَنبي إِلى الحُسّادِ أَنّي فُتُّهُم","وَتَرَكتُهُم يَتَعَثَّرونَ وَرائي",12,"ي",1,0],["ذَنبي إِلى هَذا الوَرى خِلقَتي","فَهَل أَنا المُجرِمَةُ الجانِيَه",13,"ه",1,0],["ذَنَبٌ كَما سُحِبَ الرِداءُ يَذُبُّ عَن","عُرفٍ وَعُرفٌ كَالقِناعِ المُسبَلِ",14,"ل",1,0],["ذنبي إلى الأعداء فضلُ مواقفي","والفضلُ ذنبٌ لستُ منه بتائبِ",15,"ب",1,0],["ذُنوبي ثِقالٌ فَما حِيلَتي","إِذا كُنتُ في البَعثِ حَمّالَها",16,"ل",3,0],["ذُنوبيَ إِن فَكَّرتُ فيها كَثيرَةٌ","وَرَحمَةُ رَبّي مِن ذُنوبي أَوسَعُ",17,"ع",1,1],["ذَنبٌ إِذا عُدَّ الذُنوبُ رَأَيتُهُ","مِن حُسنِهِ كَالخالِ في وَجَناتِها",18,"ت",3,0],["ذنبُ من يهواكَ أو ذنبُ السنين","ذلكَ الهجرُ ولا لومَ عليك",19,"ك",1,0],["ذنوبيَ تنمي كلّ يومٍ تكسّباً","فيوْمي بها في اليوْم أثقلُ من أمسي",20,"س",2,0],["ذَنْبِي إِلَيْكَ غَرَامِي","فَهَلْ يَحِلُّ مَلامِي",21,"م",2,1],["ذنبي إليهمْ أنني عالمٌ","وفارسٌ في النثرِ والنظمِ",22,"م",1,0],["ذنوبي في زياداتٍ","وعمري لجَّ في النقصِ",23,"ص",1,0],["ذنبٌ بهِ هلكتْ منْ قبلنا أممٌ","والعرشُ يهتزُّ منْهُ هزَّ إكبارِ",24,"ر",1,0],["ذَنبي إليه أَمانةٌ","هي عنده شرُّ الذنوبْ",25,"ب",1,0],["ذَنبُ المُلوكِ رَمى الشُعوبَ بِنَكبَةٍ","جُلّى تَنوءُ بِحَملِها الغَبراءُ",26,"ا",2,0],["ذُنوبُ مَليحِ الوَجهِ غَيرُ قَبيحَةٍ","وَمِن عادَةِ العُشّاقِ شَحذُ العَزائِمِ",27,"م",1,0],["ذنَهَيتُكَ عَن سَهمِ الأَذى ريشَ بِالخَنى","وَنَصَّلَهُ غَيظٌ فَأُرهِفَ أَو سُمّا",28,"م",2,0],["ذَنْبٌ جَسِيمٌ يَقِلُّ الْ","تَّأْنِيبُ فِيهِ جَزَاءَ",29,"ا",2,0],["ذَنبي عَظيمٌ وَسالَتي أن","يَجعَلَكَ اللَهُ لي معاذا",30,"ذ",2,0],["ذُنوبي لَعَمري غَرَّقتني فَأَوبَقت","وَإِلّا فَإِنّي ثابِتُ القَلبِ جَهبَذُ",31,"ذ",1,0],["ذنوب الضعاف العاجزين كثيرةٌ","وما لقوى إذ تحاسبه ذنب",32,"ب",1,0],["ذنبي عداني عن لحاق ذوي الهوى","فغدوت عن درك الرشاد طريدا",33,"د",2,0],["ذنبنا والدهر في صرعته","أنٍْ وفينا لأخي الوِد وخانا",34,"ن",2,0],["ذنوبه خفرات من براءته","أحلى الغواية ما يندى به الخفر",35,"ر",1,0],["ذنبا له وجدا واقلق لبنا","والسر منا بالهوى معناه",36,"ا",2,0],["ذنوب ذي صبوة","عليه لن تكتبا",37,"ب",2,0],["ذنوبي أثقلت ظهري وجلت","وقد بعد المراد عن الوصول",38,"ل",1,1],["ذنوبي أعمت عين قلبي وقالبي","لذاك سطا الواشي علي وقال بي",39,"ب",2,1],["ذنوبي أثقلت ظهري وإني","لمفرط الوزر أضنتني الخطوب",40,"ب",1,1],["ذنبي إليك هوى ينفك يعلنه","شعري وإحسانكم صدّق وحرمان",41,"ن",1,0],["ذنبي وإن كان العظيم فإنه","في جنب عفوك هين معزاه",42,"ا",2,0],["ذنوبك في الطاعات وهي كثيرة","إذا عددت تكفيك عن كل زلة",43,"ه",1,0],["ذنب المحسّد عند حاسده","نعم الإله وحتفهُ جلده",44,"د",2,0],["ذُنوبيَ أوساخٌ وهو مثل أمطارِ","وطهَ هو البحر المحيط وأعظمُ",45,"م",1,0],["ذنبُ الرجال ولكنَّ النساء بهِ","مُعاقباتٌ بآلام واشجانِ",46,"ن",1,0],["ذنوبي وزلاتي لحظي تعاظمت","وانت الذي ترجى لكل عظيمة",47,"ه",1,0],["ذنوبي وما ذنبي لديك ولم تكن","سوى خاطر يهتاج في الحب بلبالي",48,"ي",1,0],["ذَنبي إِلى الدَهرِ أَقوامٌ صَحِبتُهُم","أَنّى يَميلُ زَمان بِالفَتى مالوا",49,"ل",3,0],["ذَنبي إِلى الأَيّامِ حُرِّيَّتي","وَلَم تَزَل أَلباً عَلى الحُرِّ",50,"ر",1,0],["ذُنابى لا يَفَونَ بِعَهدِ جارٍ","وَلَيسوا يَنعَشونَ لَهُم فَقيرا",51,"ر",2,0],["ذُنوبي التي اثقلت ظَهري بحملِها","تخفُّ إذا ما كانَ لي منهُ مُنقذُ",52,"ذ",1,0],["ذُنوبي قَد كَوَت جَنبيّ كَيّا","أَلا إِنَّ الذُنوبَ هِيَ المَكاوي",53,"ا",3,0],["ذُنوبُكَ جَمَّةٌ تَترى عِظاماً","وَدَمعُكَ جامِدٌ وَالقَلبُ قاسي",54,"س",2,0],["ذُنوبك مِثل روحك ضمن جسمٍ","ثَقيلٌ في ثَقيلٍ في ثَقيلِ",55,"ل",1,0],["ذَنبي الفِراقُ فإِن ظَفِرتُ بِقُربِكُم","فَعَلى يَدَيهِ مِنَ الفِراقِ أَتوبُ",56,"ب",1,0],["ذنبي تملكني رقّاً ولي أملٌ","من الشفاعة أغدو منه معتوقا",57,"ق",2,0],["ذنبي يخف فيقعان لوزنه","وعظيم عفوك لن يكال ويوزنا",58,"ن",2,0],["ذنوباً لو الدنيا تحمل بعضها","ولو عشر عشر العشر ثقلاً يؤودها",59,"د",3,0],["ذنوبي إلهي قد أثقلتني","حنانيك هدني طريق الرشاد",60,"د",1,0],["ذنبي عظيم وعفو اللَه أعظم من","ذنبي ولا يتكافى الجم بالنزر",61,"ر",1,0],["ذنوب كل يومٍ في ازدياد","وعمرٌ كل يومٍ في انتقاص",62,"ص",1,0],["ذنوباً لو بها ألقيت ميتاً","تحامتني القشاعم والأنوق",63,"ق",1,0],["ذنوب يا لها عظمت فخفت","لها الأجبال وزناً واشتاها",64,"ا",3,0],["ذنوب أفضحت متحمليها","فكيف سؤال مفتضح جناها",64,"ا",3,0],["ذنبي عظيم ومنك العفو أعظم من","ذنبي ومن ذا على الحسنى يكافيكا",65,"ك",2,0],["ذنبه إيثاره أمّه","ليس ينسيه سواها دنفه",66,"ف",2,0],["ذَنْبِيَ في ذمّة الصِّبا وإسا","ءتي بحكم الشباب إحسانُ",67,"ن",1,0],["ذنبي إلى البيضِ ذنبٌ غيرُ مغتفَرِ","لما توضَّحَ صبحُ الشيبِ في شَعَري",68,"ر",2,1],["ذنوب أهل البيت مغفورةٌ","وهاتف العفو يناجيهم",69,"م",1,0],["ذُنوبي نَعَمْ زادتْ ووِزريَ فادِحٌ","وَجودُكَ يا ربَّاهُ أعْظَمُ من وِزْري",70,"ر",2,0],["ذنبي إلى الدهر فضل لو سترت به","عيب الحوادث لم تنسب إلى الزلل",71,"ل",1,0],["ذنب عظيم ما له من توبة","دعوى الوجود مع المحيط بك الذي",72,"ذ",2,0],["ذنبا فقال الناس في الإعلان","أخرجه ذاك من الإيمان",73,"ن",1,0]]}