w.poetsgate.com/ViewPoem.aspx?id=178070",""],[5587,"وجد وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=196570",""],[5784,"كنت أظن الحب تسلية.....","https://www.poetsgate.com/ViewPoem.aspx?id=190616",""],[5784,"زمن العقوق","https://www.poetsgate.com/ViewPoem.aspx?id=199041",""],[5784,"#تجليات","https://www.poetsgate.com/ViewPoem.aspx?id=210524",""],[5794,"النضال العفاف","https://www.poetsgate.com/ViewPoem.aspx?id=80278",""],[2430,"ذنبي إلى الدهر أني لم أمدّ يدي","https://www.poetsgate.com/ViewPoem.aspx?id=90264",""],[5926,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=214300",""],[5939,"ذنب هواك","https://www.poetsgate.com/ViewPoem.aspx?id=195301",""],[5969,"بزهرةٍ وَحَنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=198703",""],[5969,"ذُنوبُ العَيش","https://www.poetsgate.com/ViewPoem.aspx?id=200147",""],[5997,"الخل","https://www.poetsgate.com/ViewPoem.aspx?id=214226",""],[6019,"تلاوةُ حبٍّ في محرابِ الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=197104",""],[6152,"أخاف عليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203776",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["ذُنابى قِصارٍ لا يَزيدونَ بَسطَةً","وَإِن رَكِبوا يَوماً ظَنَنتَهُمُ رَجلا",0,"ل",2,0],["ذَنبي إِلى البُهمِ الكَواذِبِ أَنَّني ال","طُرفُ المُطَهَّمُ وَالأَغَرُّ الأَقرَحُ",1,"ح",1,0],["ذُنوبي إِنِ اِستَمطَرتُ مِن غَيرِ ماطِرٍ","وَأَنّي طَلَبتُ الغَيثَ مِن غَيرِ غائِثِ",2,"ث",1,0],["ذُنابى مَصَعنَ بِأَبعارِهِنَّ","وَقَد يُمصَعُ الذَنَبُ الأَهلَبُ",3,"ب",1,0],["ذَنبي لِعَبلَةَ ذَنبٌ غَيرُ مُغتَفِرِ","لَمّا تَبَلَّجَ صُبحُ الشَيبِ في شَعري",4,"ر",2,1],["ذَنْبي عداني عنْ لِحاقِ ذوي الهُدى","فغدَوْتُ عنْ دَرَكِ الرّشادِ طَريدا",5,"د",2,0],["ذَنبُ المَنِيَّةِ في اِغتِيا","لِ شَبابِها لا يُغتَفَر",6,"ر",1,0],["ذنبها أنها رأت","فتصبته فانضوى",7,"و",2,1],["ذُنابى الشَفا أَو قَمسَةَ الشَمسِ أَزمَعا","رَواحاً فَمَدّا مِن نَجآءٍ مُناهِبِ",8,"ب",1,0],["ذَنَب أصبح للحك","م به أقبح شاره",9,"ر",2,0],["ذنب يستوجب الإخ","لاص والصدق انبتاره",9,"ر",2,0],["ذَنوبٍ يمس الأرض عند صيامه","بضافٍ يواري فرجَهُ سَبِط الهُلْبِ",10,"ب",1,0],["ذنبُ إحسانه العظيم لدينا","أننا عاجزون عن تعدادِهْ",11,"د",2,0],["ذَنبي إِلى الحُسّادِ أَنّي فُتُّهُم","وَتَرَكتُهُم يَتَعَثَّرونَ وَرائي",12,"ي",1,0],["ذَنبي إِلى هَذا الوَرى خِلقَتي","فَهَل أَنا المُجرِمَةُ الجانِيَه",13,"ه",1,0],["ذَنَبٌ كَما سُحِبَ الرِداءُ يَذُبُّ عَن","عُرفٍ وَعُرفٌ كَالقِناعِ المُسبَلِ",14,"ل",1,0],["ذنبي إلى الأعداء فضلُ مواقفي","والفضلُ ذنبٌ لستُ منه بتائبِ",15,"ب",1,0],["ذُنوبي ثِقالٌ فَما حِيلَتي","إِذا كُنتُ في البَعثِ حَمّالَها",16,"ل",3,0],["ذُنوبيَ إِن فَكَّرتُ فيها كَثيرَةٌ","وَرَحمَةُ رَبّي مِن ذُنوبي أَوسَعُ",17,"ع",1,1],["ذَنبٌ إِذا عُدَّ الذُنوبُ رَأَيتُهُ","مِن حُسنِهِ كَالخالِ في وَجَناتِها",18,"ت",3,0],["ذنبُ من يهواكَ أو ذنبُ السنين","ذلكَ الهجرُ ولا لومَ عليك",19,"ك",1,0],["ذنوبيَ تنمي كلّ يومٍ تكسّباً","فيوْمي بها في اليوْم أثقلُ من أمسي",20,"س",2,0],["ذَنْبِي إِلَيْكَ غَرَامِي","فَهَلْ يَحِلُّ مَلامِي",21,"م",2,1],["ذنبي إليهمْ أنني عالمٌ","وفارسٌ في النثرِ والنظمِ",22,"م",1,0],["ذنوبي في زياداتٍ","وعمري لجَّ في النقصِ",23,"ص",1,0],["ذنبٌ بهِ هلكتْ منْ قبلنا أممٌ","والعرشُ يهتزُّ منْهُ هزَّ إكبارِ",24,"ر",1,0],["ذَنبي إليه أَمانةٌ","هي عنده شرُّ الذنوبْ",25,"ب",1,0],["ذَنبُ المُلوكِ رَمى الشُعوبَ بِنَكبَةٍ","جُلّى تَنوءُ بِحَملِها الغَبراءُ",26,"ا",2,0],["ذُنوبُ مَليحِ الوَجهِ غَيرُ قَبيحَةٍ","وَمِن عادَةِ العُشّاقِ شَحذُ العَزائِمِ",27,"م",1,0],["ذنَهَيتُكَ عَن سَهمِ الأَذى ريشَ بِالخَنى","وَنَصَّلَهُ غَيظٌ فَأُرهِفَ أَو سُمّا",28,"م",2,0],["ذَنْبٌ جَسِيمٌ يَقِلُّ الْ","تَّأْنِيبُ فِيهِ جَزَاءَ",29,"ا",2,0],["ذَنبي عَظيمٌ وَسالَتي أن","يَجعَلَكَ اللَهُ لي معاذا",30,"ذ",2,0],["ذُنوبي لَعَمري غَرَّقتني فَأَوبَقت","وَإِلّا فَإِنّي ثابِتُ القَلبِ جَهبَذُ",31,"ذ",1,0],["ذنوب الضعاف العاجزين كثيرةٌ","وما لقوى إذ تحاسبه ذنب",32,"ب",1,0],["ذنبي اليه جنفي عن لؤمه","وقدرتي على احتمال ما حنى",33,"ا",1,0],["ذنبي عداني عن لحاق ذوي الهوى","فغدوت عن درك الرشاد طريدا",34,"د",2,0],["ذنبنا والدهر في صرعته","أنٍْ وفينا لأخي الوِد وخانا",35,"ن",2,0],["ذنوبه خفرات من براءته","أحلى الغواية ما يندى به الخفر",36,"ر",1,0],["ذنبي إليه جَنَفي عن لؤمه","وقدرتي على احتمال ما جنى",37,"ا",1,0],["ذنبا له وجدا واقلق لبنا","والسر منا بالهوى معناه",38,"ا",2,0],["ذنوب ذي صبوة","عليه لن تكتبا",39,"ب",2,0],["ذنوبي أثقلت ظهري وجلت","وقد بعد المراد عن الوصول",40,"ل",1,1],["ذنوبي أعمت عين قلبي وقالبي","لذاك سطا الواشي علي وقال بي",41,"ب",2,1],["ذنوبي أثقلت ظهري وإني","لمفرط الوزر أضنتني الخطوب",42,"ب",1,1],["ذنبي إليك هوى ينفك يعلنه","شعري وإحسانكم صدّق وحرمان",43,"ن",1,0],["ذنبي وإن كان العظيم فإنه","في جنب عفوك هين معزاه",44,"ا",2,0],["ذنوبك في الطاعات وهي كثيرة","إذا عددت تكفيك عن كل زلة",45,"ه",1,0],["ذنب المحسّد عند حاسده","نعم الإله وحتفهُ جلده",46,"د",2,0],["ذُنوبيَ أوساخٌ وهو مثل أمطارِ","وطهَ هو البحر المحيط وأعظمُ",47,"م",1,0],["ذنبُ الرجال ولكنَّ النساء بهِ","مُعاقباتٌ بآلام واشجانِ",48,"ن",1,0],["ذنوبي وزلاتي لحظي تعاظمت","وانت الذي ترجى لكل عظيمة",49,"ه",1,0],["ذنوبي وما ذنبي لديك ولم تكن","سوى خاطر يهتاج في الحب بلبالي",50,"ي",1,0],["ذَنبي إِلى الدَهرِ أَقوامٌ صَحِبتُهُم","أَنّى يَميلُ زَمان بِالفَتى مالوا",51,"ل",3,0],["ذَنبي إِلى الأَيّامِ حُرِّيَّتي","وَلَم تَزَل أَلباً عَلى الحُرِّ",52,"ر",1,0],["ذُنابى لا يَفَونَ بِعَهدِ جارٍ","وَلَيسوا يَنعَشونَ لَهُم فَقيرا",53,"ر",2,0],["ذُنوبي التي اثقلت ظَهري بحملِها","تخفُّ إذا ما كانَ لي منهُ مُنقذُ",54,"ذ",1,0],["ذُنوبي قَد كَوَت جَنبيّ كَيّا","أَلا إِنَّ الذُنوبَ هِيَ المَكاوي",55,"ا",3,0],["ذُنوبُكَ جَمَّةٌ تَترى عِظاماً","وَدَمعُكَ جامِدٌ وَالقَلبُ قاسي",56,"س",2,0],["ذُنوبك مِثل روحك ضمن جسمٍ","ثَقيلٌ في ثَقيلٍ في ثَقيلِ",57,"ل",1,0],["ذَنبي الفِراقُ فإِن ظَفِرتُ بِقُربِكُم","فَعَلى يَدَيهِ مِنَ الفِراقِ أَتوبُ",58,"ب",1,0],["ذنبي تملكني رقّاً ولي أملٌ","من الشفاعة أغدو منه معتوقا",59,"ق",2,0],["ذنبي يخف فيقعان لوزنه","وعظيم عفوك لن يكال ويوزنا",60,"ن",2,0],["ذنوباً لو الدنيا تحمل بعضها","ولو عشر عشر العشر ثقلاً يؤودها",61,"د",3,0],["ذنوبي إلهي قد أثقلتني","حنانيك هدني طريق الرشاد",62,"د",1,0],["ذنبي عظيم وعفو اللَه أعظم من","ذنبي ولا يتكافى الجم بالنزر",63,"ر",1,0],["ذنوب كل يومٍ في ازدياد","وعمرٌ كل يومٍ في انتقاص",64,"ص",1,0],["ذنوباً لو بها ألقيت ميتاً","تحامتني القشاعم والأنوق",65,"ق",1,0],["ذنوب يا لها عظمت فخفت","لها الأجبال وزناً واشتاها",66,"ا",3,0],["ذنوب أفضحت متحمليها","فكيف سؤال مفتضح جناها",66,"ا",3,0],["ذنبي عظيم ومنك العفو أعظم من","ذنبي ومن ذا على الحسنى يكافيكا",67,"ك",2,0],["ذنبه إيثاره أمّه","ليس ينسيه سواها دنفه",68,"ف",2,0],["ذَنْبِيَ في ذمّة الصِّبا وإسا","ءتي بحكم الشباب إحسانُ",69,"ن",1,0],["ذنبي إلى البيضِ ذنبٌ غيرُ مغتفَرِ","لما توضَّحَ صبحُ الشيبِ في شَعَري",70,"ر",2,1],["ذنوب أهل البيت مغفورةٌ","وهاتف العفو يناجيهم",71,"م",1,0],["ذُنوبي نَعَمْ زادتْ ووِزريَ فادِحٌ","وَجودُكَ يا ربَّاهُ أعْظَمُ من وِزْري",72,"ر",2,0],["ذنبي إلى الدهر فضل لو سترت به","عيب الحوادث لم تنسب إلى الزلل",73,"ل",1,0],["ذنب عظيم ما له من توبة","دعوى الوجود مع المحيط بك الذي",74,"ذ",2,0],["ذنبا فقال الناس في الإعلان","أخرجه ذاك من الإيمان",75,"ن",1,0],["ذُنوبُ العُيونِ النُّجل مَغْفورةٌ لها","فما الذَّنْبُ إِلّا للفُؤادِ المَعذَّبِ",76,"ب",1,0],["ذُنابَى حُبارى أخطَأَ الصقرُ رأسَها","فجادتْ بمكنونٍ من السَّلْحِ يَثْعَبُ",77,"ب",1,0],["ذنب جناه على البسيطة أهلها","لتنوء أجيال به وقرون",78,"ن",1,0],["ذنبيَ وحدي كذنوبِ الورى","في الهدم للجاهِ وللعِرض",79,"ض",1,0],["ذَنْبُ الفتى يومَ القضا غمُّه","وحِرْزُه عن ذنبه حلمُه",80,"م",2,1],["ذنوب تحيل العذر فالخوف غالب","ولكن رجائي في جنابك أغلب",81,"ب",1,0],["ذُنُوبُهُمُ وَالسَّيَّئاتُ تَبَدَّلَتْ","نَفى الشَِّرْكَ عَنَّا بِالْحَقِيقَةِ فَانْجَلَتْ",82,"ت",1,0],["ذنب العواذلِ ليس يغفر","والرفق بالعشاق أجدر",83,"ر",1,1],["ذنوباً من الاهوال قد اذهب صبري","أأحمد يا خير الوجود وسيلتي",84,"ي",1,0],["ذنوب قد أصابتني وأردت","وأنت الذخر فانقذني حنانا",85,"ن",2,1],["ذَنبٌ أَبتَرٌ لَعَمرُكَ خَيرٌ","مِن طَويلٍ يُجَرُّ في الأَقذاءِ",86,"ا",2,0],["ذنبي إلى الدهر إن أبدى تعنُّتَهُ","ذنبُ الحسام إذا ما أحجمَ البطل",87,"ل",1,0],["ذَنباً علينا ما لَنا من صبر","عَلى السها من بعد نور البدر",88,"ر",1,0],["ذنبكم كان لديه أنكم","عصبةٌ لم ترتض العيش الدّنيّا",89,"ي",2,0],["ذَنْبي إلى الدَّهْرِ حلمْي عن جَر