{"poems":[[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[505,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[505,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[4929,"ازهر الرأس","https://www.poetsgate.com/ViewPoem.aspx?id=199507",""],[6237,"جبل فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77861&r=&rc=3",""]],"verses":[["يا لتَفْضيله ومدحيَ فيه","وهو أهل الهجاء والتخسيس",0,"س",1,0],["يالَ تَميمٍ وَذو قارٍ لَهُ حَدَبٌ","مِنَ الرَبيعِ وَفي شَعبانَ مَسجورُ",1,"ر",1,0],["يا لتمثاليَ الجميلِ احتواهُ","ساربُ الماء كالشهيد الغريقِ",2,"ق",1,0],["يا لتلك الطلول كم هام لهفا","مغرمٌ راح والهاً يهواها",3,"ا",3,0],["يا لتَنْسيقِ فَناءٍ عَمَّني","فكأنِّي في نِساقاتِ العَمَا",4,"م",2,0],["يالتي منكِ بي الذي بي ومابي","دون عُشرٍ من عشرهِ التعذيبُ",5,"ب",1,0],["يا لتلك الذرى الموشاة بالزهر","نضيراً وبالثمار حوالِ",6,"ل",1,0]]}