{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[9,"لعمري لئن أمسى من الحي شاخصا","https://www.aldiwan.net/poem21947.html","الطويل"],[41,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[190,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[208,"تقمص العيش بين الدل والترف","https://www.aldiwan.net/poem53235.html","البسيط"],[266,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[266,"تقمص ثوبا أبيضا من بجوده","https://www.aldiwan.net/poem38363.html","البسيط"],[287,"كفى حزنا أني عن الحي سآل","https://www.aldiwan.net/poem32671.html","الطويل"],[382,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[443,"أمن منزل بالجق أقوت معالمه","https://www.aldiwan.net/poem2537.html","الطويل"],[463,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[466,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[466,"تعلمت البيداء فسحة صدره","https://www.aldiwan.net/poem15445.html","الطويل"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[484,"حللت مكانا في الكهولة بعدما","https://www.aldiwan.net/poem37177.html","الطويل"],[519,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[727,"","https://poetry.dctabudhabi.ae/diwan/poem/204996","الطويل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145634","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102143","الهزج"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58427","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109788","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201425","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202518","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132699","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100182","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127013","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/198271","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129351","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117923","الرمل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143855","الوافر"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105151","الطويل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105157","الوافر"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113008","الطويل"],[5074,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=175382",""],[5093,"حكاية حب","https://www.poetsgate.com/ViewPoem.aspx?id=144989",""],[5121,"فِي قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33499",""],[5186,"كنا من الدنيا على باخرة","https://www.poetsgate.com/ViewPoem.aspx?id=156435",""],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5431,"فيجرف أحزانا ..وينزع أقنعه...","https://www.poetsgate.com/ViewPoem.aspx?id=191747",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""]],"verses":[["تقمصهم يوم من الدهر فانجلى","وقد طليت بالقار حتى غياهبه",0,"ب",2,0],["تَقَمَّرَها شَيخٌ عِشاءً فَأَصبَحَت","قُضاعِيَةً تَأتي الكَواهِنَ ناشِصا",1,"ص",2,0],["تَقَمَّعُ في أَظلالِ مُحنِطَةِ الجَنى","صحاحَ المَآقي ما بِهِنَّ قُموعُ",2,"ع",1,0],["تقمّصت من الحرف","قميصا باقيا بعدي",3,"د",2,0],["تقمَّص العيش بين الدَّل والترَفِ","لا يرفع الطرفَ من تيهٍ ومن صَلَفِ",4,"ف",1,1],["تقمص حظى الليل ثوبا فليته","نضى عنه ثوبي طوله وثباته",5,"ت",2,0],["تقمص ثوباً أبيضاً من بجوده","لنا عند إمساك السحاب سحاب",6,"ب",1,1],["تَقَمَّصَ أَثوابَ المَعالي قَشيبَةً","وَهَل يَستَوي بُردٌ قَشيبٌ وَأَسمالُ",7,"ل",1,0],["تقمصْنا به جلبابَ حزمٍ","يقينا سردُه الأمرَ المحالا",8,"ل",2,0],["تقمّص ثوب الحزن من فرح به","فبيّض حظ المرء إذ ذاك فاحمه",9,"م",2,0],["تَقمَّصَها قومٌ وما خُلِقتْ لهم","فهانوا ومن بعضِ الجَمالِ عيوبُ",10,"ب",1,0],["تقمصتها فضفاضةَ البُرْدِ حُرَّةً","مُكرَّمةً عن مِشيةٍ بِضَراءِ",11,"ا",2,0],["تقمَّص ملبوسَ الوزارة عالماً","بسرِّ عُلاها من مقيمٍ وذاهبِ",12,"ب",1,0],["تقمَّصها بالدَّهي والبأسِ ماجِدٌ","حوى المجد ما بين النُّهى والتجارب",12,"ب",1,0],["تقمّص أثوابَ العلى فهو رافلٌ","وشانئهُ عن شأنه ذاك غافل",13,"ل",1,0],["تقمص في شخصي فما أنا غيره","ولا هو غيري فاختفى وبدا معا",14,"ع",2,0],["تقمّصْتُ ثوباً من دُخانٍ ومهجتي","عليها قميصٌ من لظاكَ تجسّما",15,"م",2,0],["تقمّصت ثوب العلم والحلم والندى","فأنت صلاح للورى وخليل",16,"ل",1,0],["تقمعُ الإرهابَ في أوكارِهِ","أرهبت خَصمًا عنيدًا دَمَويَّا",17,"ي",2,0],["تقمص الليل ثوبا وارتدى حللا","حيكت لها بيد الأضوا ضرارات",18,"ت",1,0],["تقمصت عارا كي اقابل بالصدِّ","قحمتُ المنايا والظبى تقرعُ الظبي",19,"ي",1,0],["تقم يا خير مرسل","لنا في ذا المقام",20,"م",1,0],["تَقُم في رأس أمّه","وتُعرض في السَلام",20,"م",1,0],["تَقَمّصَ منْ قُمصِ الخلاعة حلّةً","عَليها طرازٌ مِن وقارٍ وَحِشمَةٍ",21,"ه",1,0],["تقمة صبها القضاء على الابرا","ر ظلماً ومن يردُّ القضاء",22,"ا",2,0],["تقمصت الأحزاب فيّ جميعها","فمن كل حزب خيرُ ما عنده عندي",23,"ي",1,1],["تقمّص لا بل حلَّ بي كل شاعرٍ","عرفتم ومن لا تعرفون له ذكرا",24,"ر",2,0],["تقمصها ظلما عتيق وعهدها","جديد بنص يوم خم تسلسلا",25,"ل",2,0],["تقمصتموها حيث بؤتم بعارها","ملابس ذل ليس يبلى إلى النشر",26,"ر",1,0],["تقمصت أبراد المهابة والنهى","ورحت بها بين الملا تتغطرف",27,"ف",1,0],["تقمَّم الرمل بالضُمرين وابلُهُ","وبالرقاشين من اسباله شَمَلُ",28,"ل",1,1],["تقمص جلباب الوفاء وكم فنى","رأيناه من ثوب الوفاء مجردا",29,"د",2,0],["تقمع الهم من القلب كما","يقمع الجور وقارُ الأمرا",30,"ر",2,0],["تقمصّت البنفسج واستقلت","من الآس الرطيب على قضيب",31,"ب",1,0],["تقمص أثواب النهى وهو كاهل","وأدرك غايات العلى وهو يافع",32,"ع",1,0],["تقمص حلة المعروف طفلا","وأدرك غاية العليا غلاما",33,"م",2,0],["تقمَّصَ ثوبَ اللاَّذِ من فوقِ لؤلؤٌ","ورصَّعَ بالدُّرِّ الجمانَ بديدا",34,"د",2,1],["تَقَمَّصَ وَردُ المَرجِ لَونَ خُدُودِهَا","ومِنْ شَفَتَيهَا اسْتَلهَمَ الحُمرَةَ الزَّهْرُ",35,"ر",1,0],["تقمّصني الحبُّ حتى نسيتُ","كياني فلا أملك الآن أمرا",36,"ر",2,0],["تَقَمَّصْتَ فِي رُوحِي قَرِينَ سَرِيِرَتِي","فَعِشْنَا بِذِي الأَشْوَاقِ تَيْدًا وَتِرْحَابَا",37,"ب",2,0],["تقمصت أرواحنا طفلة","\"ما فتئت في زعمهم \"\"قاصرة\"\"\"",38,"ر",2,0],["تَقَمَّصتُ كلَّ وجوهٍ تحبّي","-نَ حتّى أنالَ بها ما أردتُ",39,"ت",1,0],["تقمص في شرح الكتاب وفقهه","وأمعن في شرح المحال لأسمعه",40,"ع",2,0],["تقمص في حرف ثقيل بحزنه","وأقسم أن الحرف يرثيه مصرعه",40,"ع",2,0],["تقَمَّصَ رُوحَيْنا فكُنَّا كَتوْأَمٍ","يَراه الورى فَرْداً .. فما أكْرَمَ الشّجوا!",41,"و",2,0]]}