oetry.dctabudhabi.ae/diwan/poem/57951","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72438","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120511","الوافر"],[4744,"هذا العقيق وذي ربا أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=131549",""],[4955,"الماء يطفىء جمر النارِ يخمدهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187905",""],[4955,"يارب أنت بحال قلبي أعلم","https://www.poetsgate.com/ViewPoem.aspx?id=215777",""],[4976,"في رحاب شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=207834",""],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5112,"الوالد أحمد الحذيفي","https://www.poetsgate.com/ViewPoem.aspx?id=215308",""],[5121,"رحيق الشِّعر","https://www.poetsgate.com/ViewPoem.aspx?id=33866",""],[5121,"الكَأْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215480",""],[5156,"تطيرت أيام اجتنابك أن ترى","https://www.poetsgate.com/ViewPoem.aspx?id=99198",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5285,"خالد","https://www.poetsgate.com/ViewPoem.aspx?id=204393",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5431,"كنتِ كنزه!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200141",""],[5431,"ومضةٌ من تجلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215817",""],[5442,"نمت ولم يجف كراك الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=114769",""],[5459,"لزمنا الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190906",""],[5725,"جمعة محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177425",""],[5725,"رحيق الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=177720",""],[5736,"لملم جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=203889",""],[5736,"روح الأماكن","https://www.poetsgate.com/ViewPoem.aspx?id=208208",""],[5736,"استكانة","https://www.poetsgate.com/ViewPoem.aspx?id=208472",""],[5744,"انا الأُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=207275",""],[5881,"لهب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=183864",""],[5943,"إلهي أبعد الواشينَ عنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=11096",""],[5997,"يا هاجري","https://www.poetsgate.com/ViewPoem.aspx?id=214976",""],[6102,"اغضبي","https://www.poetsgate.com/ViewPoem.aspx?id=182847",""],[6124,"منك كلي","https://www.poetsgate.com/ViewPoem.aspx?id=128747",""],[6124,"خانت غنائي","https://www.poetsgate.com/ViewPoem.aspx?id=194521",""],[6125,"علوتُ وكنتُ مُتَّشحاً خِصَالا","https://www.poetsgate.com/ViewPoem.aspx?id=212871",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""],[6344,"جنوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87977&r=&rc=17",""]],"verses":[["فأَسكَرَني وَالنَّجمُ مُرخٍ نِطاقَهُ","جَنى الرِّيقِ لا ما أُرعِفَتْ مِنهُ كاسُهُ",0,"س",2,0],["فَاِسكُت فَإِنَّكَ قَد غُلِبتَ فَلَم تَجِد","لِلقاصِعاءِ مَآثِرَ الأَيّامِ",1,"م",1,0],["فَاسْكُنِي يا هموم نَفِسيَ إن ال","لَهَ أمضى قضَاءَهُ المقدورا",2,"ر",2,0],["فَاِسكُن إِلى سَكَنٍ تُسَرُّ بِهِ","ذَهَبَ الزَمانُ وَأَنتَ مُنفَرِدُ",3,"د",1,0],["فاسكبي الخمر وارشفي","هِ على رَنّةِ الوتَرْ",4,"ر",1,0],["فاسكبي روحك الحنون عليه","كانسكاب السماء في عينيك",5,"ك",1,0],["فاسكُبِ الدمعَ وابعثِ الشعرَ وامْلأ","أُذُنَ الخافقَيْنِ من آيَاتِهْ",6,"ت",2,0],["فاسكُبُ على الأبيضِ من أسودٍ","يلذَعُ في الأوراقِ لَذعَ الحُمَم",7,"م",1,0],["فاسكنهُ لا خوفٌ ولا حزنٌ به","ورضى المهيمنِ دائمٌ يتجدّدُ",8,"د",1,0],["فاسكن إذا قضيت منه منسكا","فاكرم الوفد عليه من سكن",9,"ن",1,0],["فاسكنه في ملك عقيم ناعما","بلهو بيض ودقاق سمر",10,"ر",1,0],["فاسكن على اسم الله في الدار التي","أصبحت تستخدم فيها الدهرا",11,"ر",2,0],["فاسكتْ فأنتَ وإن أسمعتَ جارتنَا","فقد عنيتَ بشجوِ الشَّدوِ إيّانا",12,"ن",2,0],["فَاسكُن لَدَيهِ أَميناً يا أَمينُ كَما","دُعِيتَ لا جَزعاً تَلقَى وَلا وَجلا",13,"ل",2,0],["فأسكَرَ القومَ دَورُ كأسٍ","وكان سكري من المُديرِ",14,"ر",1,0],["فاسكر من الليل واصطبح سحراً","غداً تراني وأنت مخمور",15,"ر",1,0],["فاسكن لها وارتقب يا قلب واصطبر","واسأل من اللَه كشف البؤس والضرر",16,"ر",1,0],["فاسكبيه ينبت أزاهر نسيا","ن فلا تذكرين بعد الشجونا",17,"ن",2,0],["فَاِسكُت فَما أَسكُت عَن ذِكرِهِ","وَفي سُكوتي لَكَ إِذاعانُ",18,"ن",1,0],["فاسكن بقلبٍ أنت في","ه كدرَّةٍ متلاليه",19,"ي",2,0],["فاسكنه بالعيش الرغيد فإنه","أضحى مقاماً للسعادةِ مسكنا",20,"ن",2,0],["فاسكب علينا جمالا أنت مبدعه","يا عيد وامسح دموع الحزن يا عيد",21,"د",1,0],["فاسْكَرْ بلا جُرْمٍ وكُنْ ساحِراً","مِنْ غَيْرِ إثْمٍ مِنْ عَظيم الجَلالْ",22,"ل",1,0],["فاسكن به في ظله","فهو الكريم الماجد",23,"د",1,0],["فأسكُتُ عن هذا وذاك تأدُّباً","وكم من سكوتٍ قد تمنَّاهُ قائِلُ",24,"ل",1,0],["فاسكندر لجوار بارئه مضى","ويظل ما كتبت يداه خالدا",25,"د",2,0],["فأسكرَتنا بأَحاديثها","وَلَم نَذُق مِنَّةَ كأسِ الشَراب",26,"ب",1,0],["فأسكتُ عنه والجوانحُ تنطوي","على أعظم الأشجان والبُرَحاءِ",27,"ا",2,0],["فاسكت لها سكتة قوم لقد","طابت لهم إذ عمت البلوه",28,"و",2,0],["فأسكنته عيني القريحة بالبكا","على أنني قد كنت حاربته دهرا",29,"ر",2,0],["فاسكن في مالطةٍ وانظر","ما تستلقيه من الثقلهْ",30,"ل",2,0],["فأسكتني ما أسكت الورق في الدجى","وأنطقني ما أنطق الورق في السحر",31,"ر",1,0],["فاسكنه الباري كخال محمد","لدى كتفيها الغرّ خير المساكن",32,"ن",1,0],["فَأَسْكَرَهُمْ كَأْسِي فَبَاتُوا بِخَمْرَتِي","سَكَارَى حَيَارَى مِنْ شُهُودِي وَعِرْفَانِي",33,"ن",2,0],["فاسكر الصب وهناً من محاجره","ما لم يعتقه في حانوت خمار",34,"ر",1,0],["فاسكُنِ الخُلدَ حيثُ تبقى عزيزاً","بين حُورِ الجِنانِ والولدانِ",35,"ن",1,0],["فاسكُنِ الخضرا وخامِر خَيرَها","والبِسِ الأمنَ بها والعافِيَه",36,"ه",1,0],["فاسكبى الدمع واهجري النوم عيني","صرَمَت حبل الوصل أمّ حكيم",37,"م",1,0],["فأسكَنها كلبا فأضحَتْ بُليْدةً","بها منزل رحب الجناب خصيبْ",38,"ب",1,0],["فاسكبي يا عين دمعاً","سال من ذوب الكبود",39,"د",1,0],["فاسكنه دار الكرامة خالدا","وخلد فينا بالفراق تأسفا",40,"ف",2,0],["فاسكر بخمر الحياة صرفاً","وخل ماتدعي الخمور ُ",41,"ر",1,0],["فأسكِتَ الضجيجُ بالإيماءِ","وقالَ حامداً لِذي الآلاءِ",42,"ا",2,0],["فاسكبوا فوقَ قبرِه ماءَ وردٍ","وانضحوه بزعفرانٍ ومسكِ",43,"ك",1,0],["فأسكرتِ قلبي بخمرِ الغرام","وخلّفتِ نفسي بوادي الشقاء",44,"ا",2,0],["فاسكن بدار سعادةٍ","في الأمن من حركات دهرك",45,"ك",1,0],["فاسكندريَّةُ لم يَعُد فيها فَتىً","يَرَعى رعايا اللَه باطمِئنانِ",46,"ن",1,0],["فاسكب عليه مدامعَ استوعبتها","من جفن كل متيم مهجور",47,"ر",1,0],["فأسكَرَني مُسرعاً","قويٌّ من المشربِ",48,"ب",1,0],["فاسكرت النُفوس بِنشر طيبٍ","يكاد بمرهِ يَشفي جِراحي",49,"ي",1,0],["فَأَسكَرَني ذاكَ الحَديثُ وَطيبُه","وَتِذكارُهُ لِليَومَ أَسكر مُطرِب",50,"ب",1,0],["فاسكتوا إنْ أَرهقوكم","في دماءٍ ودموع",51,"ع",1,0],["فاسكتوه بزجر من بنادقهم","فيه شجا ليس يلتئم",52,"م",1,0],["فاسكب الدمع الهتون دائماً","عل سح الدمع يدنيك لنا",53,"ن",2,0],["فاسكن أخي شمر الذرى","ما دامت الغوغاء",54,"ا",2,0],["فأسكب في معاهدهم دموعا","يطول على العهاد لهنَّ مدِّ",55,"د",1,0],["فاسكب عندها دمعا فيغني","ذراها عن اذى جرف السواري",56,"ر",2,0],["فاسكب دموعك في ثرى أعتابه","وامسح خدودك في ثرى آثاره",57,"ر",2,0],["فاسكب دموعكَ كي يرتاحَ قلبكَ من","حرِّ الذنوبِ وتب للخالقِ الباري",58,"ي",1,0],["فاسكب على النَّفسِ الجموحِ هدايةً","ياخيرَ من يَهدِي العبادَ ويرحمُ",59,"م",1,0],["فأسكرني جمالُ رشاً تَحلَّى","بسحرٍ يسعد القلبَ المصابا",60,"ب",2,0],["فاسكبي ليَ السنا ، وطوفي بنَعشي","يُنْعشُ الرّوحَ سحرك المتهلّلْ",61,"ل",1,0],["فاسكُبيها علَى جَنَاني ، وخلّي","سحرَها في مشاعري يتهدّلْ!",61,"ل",1,0],["فَأَسْكَنَكَ الْإلَهُ جِنَان عَدْنٍ","بِهَا الْأَنْهَارُ مِنْ تَحْتَ الْقُصُورِ",62,"ر",1,0],["فاسكبْ رحيقَ الكاسِ شِعرًا مُتقَنا","وأدِرْ مُدَامَ الرُّوحِ دونَ قِياسِ",63,"س",1,0],["فَاسْكُبِ الْكَأْسَ كَيْ يَفُورَ الدُّوَارُ","إِنَّ مَا فَاضَ مِنْ خُمُورٍ قُشَارُ",64,"ر",1,1],["فأسكنته نوراً كرياك طيبه","يذكرني منك الذي لست ناسيا",65,"ي",2,0],["فَاسْكُبِ الدَّمْعَ عَلَى عِزٍّ مَضَى","كَانَ لَفْظُ الْعُرْبِ سِحْرًا لِلْجَنَانِ",66,"ن",1,0],["فاسكن بقلبٍ أنت فيه كما","نبضٌ ، وذي النوباتِ تأتيهِ",67,"ي",2,0],["فاسكن القلب إنني حين أعطي","لك شيئا تأتي بشيء يفوق",68,"ق",1,0],["فاسكنْ جواراًً للالهِ فانَّه","عدلٌ وحقُ للورى أوفاهُ",69,"ا",2,0],["فاسكبيني قصائدا من دلال","واهجريني قصيدةً مستفزه",70,"ز",2,0],["فاسكب اللحن همهمات ورودٍ