,"https://www.aldiwan.net/poem37740.html","البسيط"],[501,"كلفت بحبكم وجدا وإني","https://www.aldiwan.net/poem37964.html","الوافر"],[506,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[515,"سلام حكى في حسنه لؤلؤ العقد","https://www.aldiwan.net/poem20834.html","الطويل"],[516,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[516,"أزور القرافة لا عن هوى","https://www.aldiwan.net/poem12221.html","المتقارب"],[525,"الصلاة عليك يا شمس الكمال","https://www.aldiwan.net/poem13293.html","الوافر"],[539,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[539,"كما قلتم روض المعالي به خصب","https://www.aldiwan.net/poem48292.html","عموديه"],[563,"رسالة ليس قاريها بذي ملل","https://www.aldiwan.net/poem52729.html","البسيط"],[563,"رسالة فاضل وردت فكانت","https://www.aldiwan.net/poem52745.html","البسيط"],[563,"اذا أعيت مكأفأة الجميل","https://www.aldiwan.net/poem52747.html","الوافر"],[563,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[563,"آس العذار على خديه قد كتبا","https://www.aldiwan.net/poem52882.html","البسيط"],[563,"هذه رسالة صب دائم القلق","https://www.aldiwan.net/poem52904.html","البسيط"],[563,"أتتنا وهي سافرة الجبين","https://www.aldiwan.net/poem52938.html","الوافر"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["رسول الله نشأه اصطفاءاً","وبيت الله قمطه انتجابا",0,"ب",2,0],["رُسَّت قُبورُهُمُ عَلى","هامِ المَكارِمِ وَالمَعالي",1,"ل",2,1],["رَسَخَت في العَلاءِ أَجبالُكَ الشُم","مُ وَدارَت عَلى الأَعادي رَحاكا",2,"ك",2,0],["رَسَبوا في غِمارِها وَلَوَ اِنَّ ال","طَودَ يُمنى بِها لَذَلَّ وَخَفّا",3,"ف",2,0],["رَسيماً بِهِ يَعتَلُّ بِالأَعيُنِ الكَرى","وَيَنشَقُّ عَن مَكنونِهِ كُلُّ ناظِرِ",4,"ر",1,0],["رَسُولٌ أَتَى حُكْمُ الْكِتَابِ بِمَدْحِهِ","وَأَثْنَى عَلَيْهِ اللَّهُ بِالصِّدْقِ وَالْحِلْمِ",5,"م",1,0],["رَسُولٌ مِنَ الرَّحْمَانِ يَدْعُو إلَى الْهدَى","وَيَدْعُو إِلَى دَارِ السَّلاَمَةِ وَالسِّلْمِ",5,"م",1,0],["رَسَائِلَ شكْوَى خَطَّ أَحْرُفُهَا الْجَوَى","وَحَيَّى عَلَى شَطِّ الْفُرَاتِ نَزِيلُ",6,"ل",1,0],["رُسُومُ جُسُومٍ فِي رُسُومٍ تَشَابَهَا","كِلاَنَا عَلَى حُكْمِ الْبِعَادِ نَحِيلُ",6,"ل",1,0],["رَسولُ البَرايا جاءَ بالصّدْقِ فامّحَتْ","بنورِ هُداهُ التّرَّهاتُ الصّحاصِحُ",7,"ح",1,0],["رسَتْ بأقْصَى الغرْبِ ذُخْرَ مَضنّةٍ","وكمْ دُرّةٍ علْياءَ في قاعِ قاموسِ",8,"س",1,0],["رَسولاً إِذا كُنتَ ذا إِربَةٍ","بِما يَعتَريكَ بَصيراً فَقيها",9,"ي",3,0],["رَسَخَت بِنايَةُ مَجدِكُم","فَوقَ الرَوِيَّةِ وَالهِدايَه",10,"ا",3,0],["رَسَموا بِذاتِكَ لِلنَواظِرِ جَنَّةً","مَحفوفَةً بِمَكارِهِ الأَشعارِ",11,"ر",1,0],["رَسيلُكَ في شَأوِ المَعالي كِلاكُما","بَعيدُ المَدى صَعبُ الهُمومِ هُمامُ",12,"م",1,0],["رَسا بِغُرانٍ وَاِستَدارَت بِهِ الرَحى","كَما يَستَديرُ الزاحِفُ المُتَغَيِّفُ",13,"ف",1,0],["رَسا بَينَ سَلعٍ وَالعَقيقِ وَفارِعٍ","إِلى أُحُدٍ لِلمُزنِ فيهِ غَشامِرُ",14,"ر",1,0],["رَسَائِلُهُ مُنْسُوجَةٌ نَسْجَ وَحْدِهَا","تَرُوعُ بِوَشْيٍ فِيهِ لِلطَّرْفِ أَفْنَانُ",15,"ن",1,0],["رَسْمُهَا فِي سَنَائِهَا وَسَنَاهَا","وَصَدى لاسْمِهَا أَوِ اسْمٌ ثَانِي",16,"ن",2,0],["رسالة ناصح يهدي سلاماً","ويأمر في الذي ركبوا بجَدِ",17,"د",1,0],["رَسولٌ نُصَدِّقُ ما جاءَهُ","مِنَ الوَحيِ كانَ سِراجاً مُنيرا",18,"ر",2,0],["رَسا في قَرارِ الأَرضِ ثُمَّ سَمَت بِهِ","فُروعُ تُسامي كُلَّ نَجمٍ مُحَلَّقِ",19,"ق",1,0],["رَسولُ اللَهِ وَالأَبطالُ مِنّا","وَما تَحمي لَدى هَيجٍ حِماكا",20,"ك",2,0],["رَسولَ رَسولِ اللَهِ غَدراً وَلَم تَكُن","هُذَيلٌ تُوَقّى مُنكَراتِ المَحارِمِ",21,"م",1,0],["رست أحلامهم وسرت لهاهمُ","فأكرم بالجبالِ وبالصخور",22,"ر",1,0],["رسمٌ ببابِ الحمى العزيّ مكتتب","قابل حماه وقل عزٌّ وإقبال",23,"ل",1,0],["رسمت عوادي السحر من ألحاظِهِ","سطر الضنا من فوق جسمي البالي",24,"ي",1,1],["رَسَخَ الحبُّ في عظامي وجارى","في عروقي من قبلِ ذاك الغذاءَ",25,"ا",2,0],["رسمٌ مُحيلٌ بانَ سكانُهُ","فما على أمثاله عَرْجَهْ",26,"ج",2,0],["رسا جبلا حَزْمٍ وعزمٍ وقوةٍ","بمثلهما تحمى القواصي وتُعْصَمُ",27,"م",1,0],["رَسمٌ تَعَلَّمَ مِنهُ ناظِري الوَلَعا","كَأَنَّ طَرفِيَ قَلبي فيهِ قَد وُضِعا",28,"ع",2,1],["رَسائِلُ الشَوقِ عِندي لَو بَعَثتُ بِها","إِلَيكُمُ لَم تَسَعها الطُرقُ وَالسُبُلُ",29,"ل",1,0],["رَسولُ الرِضا أَهلاً وَسَهلاً وَمَرحَبا","حَديثُكَ ما أَحلاهُ عِندي وَأَطيَبا",30,"ب",2,1],["رَسمِ دارٍ وَقَفتُ في طَلَلِه","كُدتُ أَقضي الغَداةَ مِن جَلَلِه",31,"ل",2,1],["رسول الله لن يشقى","ببابك من يُيَمِّه",32,"م",2,0],["رسم مليك محكم التمثيل","بصولجان المجد والإكليل",33,"ل",1,0],["رَسائِلُ تُذري بِسَجعِ البَديعِ","وَتُنسي رَسائِلَ عَبدِ الحَميد",34,"د",1,0],["رَسائِلُ مِن عَفوِ الكَلامِ كَأَنَّها","حَواشي عُيونٍ في الطُروسِ عِذابِ",35,"ب",1,0],["رَسولُ الصابِرينَ أَلَمَّ وَهناً","وَبَلَّغَني التَحِيَّةَ وَالسُؤالا",36,"ل",2,0],["رَسَبوا فيهِ كِراماً وَطَفا","طائِفُ النَصرِ عَلَيهِم وَالظَفَر",37,"ر",1,0],["رَسمٌ وَقَفنا عَلى رَسمِ الوَفاءِ لَهُ","نَجيشُ بِالدَمعِ وَالإِجلالِ يَثنينا",38,"ن",2,0],["رسيسُ هوىً قد كاد يمحو رسومَهُ","صروفُ الليالي الجائراتِ الغواشمِ",39,"م",1,0],["رَسائِلِ ذي الأَسماءِ مَن يَدعُهُ بِها","يَجِد خَيرَ مَسؤولٍ عَطاءً لِسائِلِ",40,"ل",1,0],["رسومٌ كأنَّ الطَّرْفَ يَقرأُ كلَّما","تأمَّلَها آيَ الهَوى من صَحائفِ",41,"ف",1,0],["رَسائِلُ تُدرَسُ في المُؤمِنينَ","بِهِنَّ اصطَفى أَحمَدُ المُصطفى",42,"ف",2,0],["رَسَمتَ جوداً حَكى الطَوفانَ فَاِعتَصَمَت","مِنهُ الخَلائِقُ بِالأَلواحِ وَالدُسُرِ",43,"ر",1,0],["رَسٌّ وَإِشباعٌ وَحَذوٌ ثُمَّ تَو","جيهٌ وَمَجرى بَعدَهُ وَنَفاذُ",44,"ذ",1,0],["رَسائِلُ صِدقِ إِخوانِ الصَفاءِ","تُجَدِّدُ أُنسَ خُلّانِ الوَفاءِ",45,"ا",2,1],["رَسمَ الحبيبِ الأوَّلِ","دعني لحسنِكَ أجتلي",46,"ل",2,1],["رسولٌ يجوس خلال الديار","وينزل كالرحمة الزائره",47,"ر",2,0],["رسبت بلَجَّتِهِ النُّفوسُ ولو طَفَتْ","لحسبتَهُ قَبْلَ القيامةِ محشرا",48,"ر",2,0],["رَسولُكَ الخَطِّيُّ يَومَ الوَغى","تُردِفُهُ بِالأَبيَضِ الصارِمِ",49,"م",1,1],["رِسالَةَ مَن تَمَتَّعَ بَعدَ حينٍ","وَمَتَّعَنا مِنَ الأَدَبِ الرَضِيِّ",50,"ي",1,0],["رسا على حَدَثَانِ الدّهرِ حائِطُها","فما اتَّقَى عاصِفاً أو خَافَ زِلزالا",51,"ل",2,0],["رُسُلَ العروبةِ هل سأَلتُم جُرْحَها","ما بَالُهُ اسْتَعْصَى وماذا أعقبا",52,"ب",2,0],["رُسُلُ الحضارةِ ضجَّ من إنجيلهم","إنجيلُ عِيسَى والكتابُ المُحكَمُ",53,"م",1,0],["رُسْلُ الصَّداقةِ من صرعى رسالتهم","حقُّ البلادِ ومن قتلاهم الشَّمَمُ",54,"م",1,0],["رَسولُ حياةٍ للشُّعوبِ ويقظةٍ","يُهيبُ بقومٍ في الكنانةِ نُوَّامِ",55,"م",1,0],["رُسُلٌ يُشَيِّعُها الرَدى وَرَسائِلٌ","يَرمي بِها مَلَكٌ إِلى شَيطانِ",56,"ن",1,0],["رسولُ اللهِ أكثرُ مِنكَ عِلماً","بِصاحِبِهِ ولستَ لهُ بِسِيِّ",57,"ي",1,0],["رَسولُ اللهِ ليس له كِفاءٌ","إذا التقتِ الفَوارِسُ والكُمَاةُ",58,"ه",1,0],["رَسولُ اللهِ أكرمُ من أناختْ","بهِ الآمالُ وانْتَجَعَ العُفَاةُ",58,"ه",1,0],["رُسُلُ النبيِّ بكلِّ أرضٍ جُوَّلٌ","تَرمِي بهم هِمَمٌ نواهِضُ قُذَّفُ",59,"ف",1,0],["رسولُ الهُدَى والخيرِ من يَرْعَ حقَّهُ","فليس يَرى شيئاً على الدّهرِ ضائرا",60,"ر",2,0],["رَسُولُ اللهِ كيف وجدتماه","وماذا بعدَ ذلكَ تبغيانِ",61,"ن",1,0],["رسولٌ جاءَ بالفَرَجِ المُرَجَّى","وبالنُّور الذي كشفَ الضَّبابا",62,"ب",2,0],["رسولُ اللَّهِ ما عنه صُدوفٌ","لمن يبغي النَّجاةَ ولا عُدُولُ",63,"ل",1,0],["رسولَ اللهِ نحن لهم ويَجرِي","قضاءُ اللهِ إن طرقوا بِشرِّ",64,"ر",1,0],["رسولُ الله إلّا تنصروهُ","فإنّ الحقَّ ينصرُهُ ذَووهُ",65,"ه",1,0],["رَسولٌ له من حكمةِ الوَحْيِ عاصمٌ","ومن نُورهِ في ظُلمةِ الرأيِ كاشِفُ",66,"ف",1,0],["رسالة واهاً لَها واها","شَرقت بِالدَمع لفحواها",67,"ا",3,1],["رَسولاً لَهُم واللَهُ يَحكُمُ أَمرَهُ","يُبَيِّنُ لَهُم هَل يُؤنَسُ الثوبُ باديا",68,"ا",1,0],["رَسا أَصلُهُ تَحتَ الثَرى وَسَما بِهِ","إِلى النَجمِ فَرعٌ لا يُنالُ طَويلُ",69,"ل",1,0],["رَسولُهُ كَأَنَّهُ قَد أَفلَحا","وَقَد أَتى بِطائِلٍ وَأَنجَحا",70,"ح",2,0],["رُسُلُ القَومِ حينَ لَدَّوا جَميعاً","غَيرَهُ كَيفَ فُضِّلَ المَلدودُ",71,"د",1,0],["رسولَ اللَّهِ دعوةَ مُستقيلٍ","مِنَ التقصيرِ خاطِرُهُ هَيُوبُ",72,"ب",1,0],["رَسولي قالَ أَوصَلتُ الكِتابا","وَلَكِن لَيسَ يُعطونَ الجَوابا",73,"ب",2,1],["رَسمُ الكَرى بَينَ الجُفونِ مَحيلُ","عَفّى عَلَيهِ بُكاً عَلَيكِ طَويلُ",74,"ل",1,1],["رَسمُ دِيارٍ يَفتَرُّ مُبت