س أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[512,"سلام حكى في حسنه لؤلؤ العقد","https://www.aldiwan.net/poem20834.html","الطويل"],[513,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[513,"أزور القرافة لا عن هوى","https://www.aldiwan.net/poem12221.html","المتقارب"],[522,"الصلاة عليك يا شمس الكمال","https://www.aldiwan.net/poem13293.html","الوافر"],[536,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[536,"كما قلتم روض المعالي به خصب","https://www.aldiwan.net/poem48292.html","عموديه"],[560,"رسالة ليس قاريها بذي ملل","https://www.aldiwan.net/poem52729.html","البسيط"],[560,"رسالة فاضل وردت فكانت","https://www.aldiwan.net/poem52745.html","البسيط"],[560,"اذا أعيت مكأفأة الجميل","https://www.aldiwan.net/poem52747.html","الوافر"],[560,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[560,"آس العذار على خديه قد كتبا","https://www.aldiwan.net/poem52882.html","البسيط"],[560,"هذه رسالة صب دائم القلق","https://www.aldiwan.net/poem52904.html","البسيط"],[560,"أتتنا وهي سافرة الجبين","https://www.aldiwan.net/poem52938.html","الوافر"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[573,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["رُسَّت قُبورُهُمُ عَلى","هامِ المَكارِمِ وَالمَعالي",0,"ي",1,1],["رَسَخَت في العَلاءِ أَجبالُكَ الشُم","مُ وَدارَت عَلى الأَعادي رَحاكا",1,"ك",2,0],["رَسَبوا في غِمارِها وَلَوَ اِنَّ ال","طَودَ يُمنى بِها لَذَلَّ وَخَفّا",2,"ف",2,0],["رَسيماً بِهِ يَعتَلُّ بِالأَعيُنِ الكَرى","وَيَنشَقُّ عَن مَكنونِهِ كُلُّ ناظِرِ",3,"ر",1,0],["رَسُولٌ أَتَى حُكْمُ الْكِتَابِ بِمَدْحِهِ","وَأَثْنَى عَلَيْهِ اللَّهُ بِالصِّدْقِ وَالْحِلْمِ",4,"م",1,0],["رَسُولٌ مِنَ الرَّحْمَانِ يَدْعُو إلَى الْهدَى","وَيَدْعُو إِلَى دَارِ السَّلاَمَةِ وَالسِّلْمِ",4,"م",1,0],["رَسَائِلَ شكْوَى خَطَّ أَحْرُفُهَا الْجَوَى","وَحَيَّى عَلَى شَطِّ الْفُرَاتِ نَزِيلُ",5,"ل",1,0],["رُسُومُ جُسُومٍ فِي رُسُومٍ تَشَابَهَا","كِلاَنَا عَلَى حُكْمِ الْبِعَادِ نَحِيلُ",5,"ل",1,0],["رَسولُ البَرايا جاءَ بالصّدْقِ فامّحَتْ","بنورِ هُداهُ التّرَّهاتُ الصّحاصِحُ",6,"ح",1,0],["رسَتْ بأقْصَى الغرْبِ ذُخْرَ مَضنّةٍ","وكمْ دُرّةٍ علْياءَ في قاعِ قاموسِ",7,"س",1,0],["رَسولاً إِذا كُنتَ ذا إِربَةٍ","بِما يَعتَريكَ بَصيراً فَقيها",8,"ي",3,0],["رَسَخَت بِنايَةُ مَجدِكُم","فَوقَ الرَوِيَّةِ وَالهِدايَه",9,"ا",3,0],["رَسَموا بِذاتِكَ لِلنَواظِرِ جَنَّةً","مَحفوفَةً بِمَكارِهِ الأَشعارِ",10,"ر",1,0],["رَسيلُكَ في شَأوِ المَعالي كِلاكُما","بَعيدُ المَدى صَعبُ الهُمومِ هُمامُ",11,"م",1,0],["رَسا بِغُرانٍ وَاِستَدارَت بِهِ الرَحى","كَما يَستَديرُ الزاحِفُ المُتَغَيِّفُ",12,"ف",1,0],["رَسا بَينَ سَلعٍ وَالعَقيقِ وَفارِعٍ","إِلى أُحُدٍ لِلمُزنِ فيهِ غَشامِرُ",13,"ر",1,0],["رَسَائِلُهُ مُنْسُوجَةٌ نَسْجَ وَحْدِهَا","تَرُوعُ بِوَشْيٍ فِيهِ لِلطَّرْفِ أَفْنَانُ",14,"ن",1,0],["رَسْمُهَا فِي سَنَائِهَا وَسَنَاهَا","وَصَدى لاسْمِهَا أَوِ اسْمٌ ثَانِي",15,"ي",1,0],["رسالة ناصح يهدي سلاماً","ويأمر في الذي ركبوا بجَدِ",16,"د",1,0],["رَسولٌ نُصَدِّقُ ما جاءَهُ","مِنَ الوَحيِ كانَ سِراجاً مُنيرا",17,"ر",2,0],["رَسا في قَرارِ الأَرضِ ثُمَّ سَمَت بِهِ","فُروعُ تُسامي كُلَّ نَجمٍ مُحَلَّقِ",18,"ق",1,0],["رَسولُ اللَهِ وَالأَبطالُ مِنّا","وَما تَحمي لَدى هَيجٍ حِماكا",19,"ك",2,0],["رَسولَ رَسولِ اللَهِ غَدراً وَلَم تَكُن","هُذَيلٌ تُوَقّى مُنكَراتِ المَحارِمِ",20,"م",1,0],["رست أحلامهم وسرت لهاهمُ","فأكرم بالجبالِ وبالصخور",21,"ر",1,0],["رسمٌ ببابِ الحمى العزيّ مكتتب","قابل حماه وقل عزٌّ وإقبال",22,"ل",1,0],["رسمت عوادي السحر من ألحاظِهِ","سطر الضنا من فوق جسمي البالي",23,"ي",1,1],["رَسَخَ الحبُّ في عظامي وجارى","في عروقي من قبلِ ذاك الغذاءَ",24,"ا",2,0],["رسمٌ مُحيلٌ بانَ سكانُهُ","فما على أمثاله عَرْجَهْ",25,"ج",2,0],["رسا جبلا حَزْمٍ وعزمٍ وقوةٍ","بمثلهما تحمى القواصي وتُعْصَمُ",26,"م",1,0],["رَسمٌ تَعَلَّمَ مِنهُ ناظِري الوَلَعا","كَأَنَّ طَرفِيَ قَلبي فيهِ قَد وُضِعا",27,"ع",2,1],["رَسائِلُ الشَوقِ عِندي لَو بَعَثتُ بِها","إِلَيكُمُ لَم تَسَعها الطُرقُ وَالسُبُلُ",28,"ل",1,0],["رَسولُ الرِضا أَهلاً وَسَهلاً وَمَرحَبا","حَديثُكَ ما أَحلاهُ عِندي وَأَطيَبا",29,"ب",2,1],["رَسمِ دارٍ وَقَفتُ في طَلَلِه","كُدتُ أَقضي الغَداةَ مِن جَلَلِه",30,"ل",2,1],["رسول الله لن يشقى","ببابك من يُيَمِّه",31,"م",2,0],["رسم مليك محكم التمثيل","بصولجان المجد والإكليل",32,"ل",1,0],["رَسائِلُ تُذري بِسَجعِ البَديعِ","وَتُنسي رَسائِلَ عَبدِ الحَميد",33,"د",1,0],["رَسائِلُ مِن عَفوِ الكَلامِ كَأَنَّها","حَواشي عُيونٍ في الطُروسِ عِذابِ",34,"ب",1,0],["رَسولُ الصابِرينَ أَلَمَّ وَهناً","وَبَلَّغَني التَحِيَّةَ وَالسُؤالا",35,"ل",2,0],["رَسَبوا فيهِ كِراماً وَطَفا","طائِفُ النَصرِ عَلَيهِم وَالظَفَر",36,"ر",1,0],["رَسمٌ وَقَفنا عَلى رَسمِ الوَفاءِ لَهُ","نَجيشُ بِالدَمعِ وَالإِجلالِ يَثنينا",37,"ن",2,0],["رسيسُ هوىً قد كاد يمحو رسومَهُ","صروفُ الليالي الجائراتِ الغواشمِ",38,"م",1,0],["رَسائِلِ ذي الأَسماءِ مَن يَدعُهُ بِها","يَجِد خَيرَ مَسؤولٍ عَطاءً لِسائِلِ",39,"ل",1,0],["رسومٌ كأنَّ الطَّرْفَ يَقرأُ كلَّما","تأمَّلَها آيَ الهَوى من صَحائفِ",40,"ف",1,0],["رَسائِلُ تُدرَسُ في المُؤمِنينَ","بِهِنَّ اصطَفى أَحمَدُ المُصطفى",41,"ف",2,0],["رَسَمتَ جوداً حَكى الطَوفانَ فَاِعتَصَمَت","مِنهُ الخَلائِقُ بِالأَلواحِ وَالدُسُرِ",42,"ر",1,0],["رَسٌّ وَإِشباعٌ وَحَذوٌ ثُمَّ تَو","جيهٌ وَمَجرى بَعدَهُ وَنَفاذُ",43,"ذ",1,0],["رَسائِلُ صِدقِ إِخوانِ الصَفاءِ","تُجَدِّدُ أُنسَ خُلّانِ الوَفاءِ",44,"ا",2,1],["رَسمَ الحبيبِ الأوَّلِ","دعني لحسنِكَ أجتلي",45,"ي",1,1],["رسولٌ يجوس خلال الديار","وينزل كالرحمة الزائره",46,"ر",2,0],["رسبت بلَجَّتِهِ النُّفوسُ ولو طَفَتْ","لحسبتَهُ قَبْلَ القيامةِ محشرا",47,"ر",2,0],["رَسولُكَ الخَطِّيُّ يَومَ الوَغى","تُردِفُهُ بِالأَبيَضِ الصارِمِ",48,"م",1,1],["رِسالَةَ مَن تَمَتَّعَ بَعدَ حينٍ","وَمَتَّعَنا مِنَ الأَدَبِ الرَضِيِّ",49,"ي",1,0],["رسا على حَدَثَانِ الدّهرِ حائِطُها","فما اتَّقَى عاصِفاً أو خَافَ زِلزالا",50,"ل",2,0],["رُسُلَ العروبةِ هل سأَلتُم جُرْحَها","ما بَالُهُ اسْتَعْصَى وماذا أعقبا",51,"ب",2,0],["رُسُلُ الحضارةِ ضجَّ من إنجيلهم","إنجيلُ عِيسَى والكتابُ المُحكَمُ",52,"م",1,0],["رُسْلُ الصَّداقةِ من صرعى رسالتهم","حقُّ البلادِ ومن قتلاهم الشَّمَمُ",53,"م",1,0],["رَسولُ حياةٍ للشُّعوبِ ويقظةٍ","يُهيبُ بقومٍ في الكنانةِ نُوَّامِ",54,"م",1,0],["رُسُلٌ يُشَيِّعُها الرَدى وَرَسائِلٌ","يَرمي بِها مَلَكٌ إِلى شَيطانِ",55,"ن",1,0],["رسولُ اللهِ أكثرُ مِنكَ عِلماً","بِصاحِبِهِ ولستَ لهُ بِسِيِّ",56,"ي",1,0],["رَسولُ اللهِ ليس له كِفاءٌ","إذا التقتِ الفَوارِسُ والكُمَاةُ",57,"ه",1,0],["رَسولُ اللهِ أكرمُ من أناختْ","بهِ الآمالُ وانْتَجَعَ العُفَاةُ",57,"ه",1,0],["رُسُلُ النبيِّ بكلِّ أرضٍ جُوَّلٌ","تَرمِي بهم هِمَمٌ نواهِضُ قُذَّفُ",58,"ف",1,0],["رسولُ الهُدَى والخيرِ من يَرْعَ حقَّهُ","فليس يَرى شيئاً على الدّهرِ ضائرا",59,"ر",2,0],["رَسُولُ اللهِ كيف وجدتماه","وماذا بعدَ ذلكَ تبغيانِ",60,"ن",1,0],["رسولٌ جاءَ بالفَرَجِ المُرَجَّى","وبالنُّور الذي كشفَ الضَّبابا",61,"ب",2,0],["رسولُ اللَّهِ ما عنه صُدوفٌ","لمن يبغي النَّجاةَ ولا عُدُولُ",62,"ل",1,0],["رسولَ اللهِ نحن لهم ويَجرِي","قضاءُ اللهِ إن طرقوا بِشرِّ",63,"ر",1,0],["رسولُ الله إلّا تنصروهُ","فإنّ الحقَّ ينصرُهُ ذَووهُ",64,"ه",1,0],["رَسولٌ له من حكمةِ الوَحْيِ عاصمٌ","ومن نُورهِ في ظُلمةِ الرأيِ كاشِفُ",65,"ف",1,0],["رسالة واهاً لَها واها","شَرقت بِالدَمع لفحواها",66,"ا",3,1],["رَسولاً لَهُم واللَهُ يَحكُمُ أَمرَهُ","يُبَيِّنُ لَهُم هَل يُؤنَسُ الثوبُ باديا",67,"ا",1,0],["رَسا أَصلُهُ تَحتَ الثَرى وَسَما بِهِ","إِلى النَجمِ فَرعٌ لا يُنالُ طَويلُ",68,"ل",1,0],["رَسولُهُ كَأَنَّهُ قَد أَفلَحا","وَقَد أَتى بِطائِلٍ وَأَنجَحا",69,"ح",2,0],["رُسُلُ القَومِ حينَ لَدَّوا جَميعاً","غَيرَهُ كَيفَ فُضِّلَ المَلدودُ",70,"د",1,0],["رسولَ اللَّهِ دعوةَ مُستقيلٍ","مِنَ التقصيرِ خاطِرُهُ هَيُوبُ",71,"ب",1,0],["رَسولي قالَ أَوصَلتُ الكِتابا","وَلَكِن لَيسَ يُعطونَ الجَوابا",72,"ب",2,1],["رَسمُ الكَرى بَينَ الجُفونِ مَحيلُ","عَفّى عَلَيهِ بُكاً عَلَيكِ طَويلُ",73,"ل",1,1],["رَسمُ دِيارٍ يَفتَرُّ مُبتَسِماً","مِنها البِلى عَن نَواجِذِ الهَرِمِ",74,"م",1,0],["رَسائِل مشتاق الى من أَحبَّهُ","تخبر عَن وجد به وَنزوع",75,"ع",1,0],["رسائلُ أنبلُ ما سطَّرتْ","يدُ الحبِّ أو ردَّدَتهُ شفهْ",76,"ه",1,0],["رسمتُها بعضَ خطوطٍ كما","يُرْسَمُ أُفْقُ الكونِ للناظرينْ",77,"ن",1,0],["رَسَا أ