{"poems":[[53,"شرب البيهقي والبين ناء","https://www.aldiwan.net/poem9232.html","الخفيف"],[170,"أقبل من كندر مسيخرة","https://www.aldiwan.net/poem47109.html","المنسرح"],[422,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[422,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"أي شيء يمنح الأوطان قدرا","https://www.aldiwan.net/poem56777.html","الرمل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123440","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113991","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69316","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204880","الخفيف"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33110","الوافر"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18728","الطويل"],[5121,"البلبل الصداح","https://www.poetsgate.com/ViewPoem.aspx?id=33672",""],[5431,"قلتُ كلا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210687",""]],"verses":[["يحضرُ البينُ لا شَهِيَّ المُلاقا","ةِ وإن غابَ غاب لا مُستراثا",0,"ث",2,0],["يحضُرُ دورَ الأميرِ وهو فتىً","موضع أمثالِهِ الخراباتُ",1,"ت",1,0],["يحضُّ على مسرَّات النَّدامى","ويأمُرُ في مُصافاة النَّديم",2,"م",1,0],["يحضُّ على ما يسرُّ النفوس","ويدعو إلى ما هو المشتهى",3,"ا",1,0],["يحضرها منهم سوى ابن عمها","ورهطه ثم مضت بغمّها",4,"ه",2,0],["يحضُنُ الأرضَ،أكانتْ غيرَ أُمٍّ؟!","هوَ منها وإليها نحوَ أُخرى",5,"ر",2,0],["يحض على التقوى ويكره قربه","وتنفر منه النفس وهو نذير",6,"ر",1,0],["يحضؤونَ الزخيخَ فوقَ الروابي","حينَ تُطفى مخافَةَ الضيفانِ",7,"ن",1,0],["يَحضُنُ دُرماً كَالأُكَر","كَأَنَّهُ إِذا وَكَر",8,"ر",1,0],["يحضر الشعر في غياب جمال","فإذا لاح غاب عنا وزالا",9,"ل",2,0],["يُحَضِّضُنا عُمارَةُ في نُمَيرٍ","لِيَشغَلَهُم بِنا وَبِهِ أَرابوا",10,"ب",3,1],["يَحُضُّ عَلَينا عامِراً وَأَخالُنا","سَنُصبِحُ أَلفاً ذا زَائِدَ عامِرا",11,"ر",2,0],["يحضنُ الآهات قطْرًا في غيوم ٍ","تهطلُ الآهاتُ خيرًا في البحور ِ",12,"ر",1,0],["يحضن الكون بدفءٍ","عن هواه ماتخلّى",13,"ل",2,0]]}