{"poems":[[55,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[0,"ألا انعم صباحا أيها الربع وانطق","https://www.aldiwan.net/poem79.html","الطويل"],[26,"وأبلغ لديك معقل بن خويلد","https://www.aldiwan.net/poem24078.html","الطويل"],[31,"غدا ابنا وائل ليعاتباني","https://www.aldiwan.net/poem6060.html","الوافر"],[64,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[46,"ألم يأن تركي لا علي ولا ليا","https://www.aldiwan.net/poem29568.html","الطويل"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[7,"وإن يرجع النعمان نفرح ونبتهج","https://www.aldiwan.net/poem1981.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62234","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54988","الوافر"],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[201,"يا ليتني فوق الغصون حمامة","https://www.aldiwan.net/poem39817.html","الكامل"],[217,"تعجبُ جارتي لما رأتني","https://www.aldiwan.net/poem405.html",""],[368,"صحا قلبه وأقصر اليوم باطله","https://www.aldiwan.net/poem1724.html","الطويل"],[371,"على إثر ما حل الدخول وحوملا","https://www.aldiwan.net/poem17063.html","الطويل"],[471,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[505,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137680",""],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137727",""],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96567","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32610","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65991","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113898","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112301","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48288","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48337","الوافر"],[3631,"","https://poetry.dctabudhabi.ae/diwan/poem/144728","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[5213,"بماضي رهيف العزم أقتحم الصعبا","https://www.poetsgate.com/ViewPoem.aspx?id=170408",""],[5431,"أنا وأنا والإنعتاق الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=200430",""],[5751,"أميرة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214765",""]],"verses":[["عَلى آثارِهِم حَدوُ ال","قَنا بِالضُمَّرِ القُبِّ",0,"ب",1,0],["على أثباجِ مُقرَبَةٍ تمطَّتْ","بِهمْ ورِعالُها تَنْضوا الرِّعالا",1,"ل",2,0],["عَلى آثارِنا بيضٌ حِسانٌ","نُحاذِرُ أَن تُقَسَّمَ أَو تَهونا",2,"ن",2,0],["عَلى إِثرِ حَيٍّ عامِدينَ لِنِيَّةٍ","فَحَلّوا العَقيقَ أَو ثَنِيَّةَ مُطرِقِ",3,"ق",1,0],["عَلى إِثرِ أُخرى قَبلَ ذلِكَ قَد أَتَت","إِلَيكَ فَجاءَت مُقشَعِرّاً شَواتُها",4,"ت",3,0],["عَلى إِثرِ الحَميرِ مُوَكِّفيها","جَنائِبُهُم حَوالِيُّ الكِلابِ",5,"ب",1,0],["على أثَلاتِ الواديينِ سَلامُ","وبعضُ تحايا الزائرينَ غَرامُ",6,"م",1,1],["عَلى إِثرِ ما قَد كانَ مِنّي صَبابَةً","لَيالِيَ فيها كُنتُ لِلَّهِ عاصِيا",7,"ي",2,0],["عَلى إِثرِ الأَدِلَّةِ وَالبَغايا","وَخَفقِ الناجِياتِ مِنَ الشَآمِ",8,"م",1,0],["عَلى إِثرِ خَيرِ الناسِ إِن كانَ هالِكاً","وَإِن كانَ في جَنبِ الفَتاةِ ضَجيعُها",9,"ع",3,0],["عَلَى إِثْر شَحّاجٍ لَطِيفٍ مَصِيرُهُ","يَمُجُّ لُعَاعَ العِضْرِسِ الجَوْنِ سَاعِلُهْ",10,"ل",2,0],["عَلَى آثَارِهِ أَرْسلْتُ","دَمْعَ الْعيْنِ مُرْفضَّا",11,"ض",2,0],["على آثارنا بيضٌ حسانُ","تُحاذرُ أن تقسم أو تهوُنا",12,"ن",2,0],["عليّ أثير بقلب كلّ مليحة","عطفا على البؤسا من الشعراء",13,"ا",2,0],["عَلى آثارِ أَحمِرَةٍ وَفِرقٍ","تُقَسَّمُ بَينَ أَغوِلَةٍ شِحاحِ",14,"ح",1,0],["عَلى إِثرِ حَيٍّ لا يَرى النَجمَ طالِعاً","مِنَ اللَيلِ إِلّا وَهوَ بادٍ مَنازِلُه",15,"ل",2,0],["عَلى إِثرِ ما حَلَّ الدَخولَ وَحَومَلا","تَسَلّى بِدارٍ بَعدَ دارٍ فَما سَلا",16,"ل",2,1],["عَلى إِثرِ هِجرانٍ وَساعَةِ خَلوَةٍ","مِنَ الناسِ نَخشى غُيَّباً أَن تَطَلَّعا",17,"ع",2,0],["على إثر روح العالمين تزاحمت","جنائبهم في السير من كل وجهة",18,"ه",1,0],["على اثر الرعب وافى المخاض","شديدا يذيق الحشا الألما",19,"م",2,0],["على إثرها من أصيبوا صفوفا","وقد أمنوا من طروق المنايا",20,"ا",3,0],["على أَثرِ الجُعفِىِّ دهرٌ وقد أَتى","له منذُ ولَّى يَسحَجُ السَيرَ أَربعُ",21,"ع",1,0],["على أثر المختار سارٍ وانه","بأخلاقه بين الورى متخلق",22,"ق",1,0],["على أثارهن مقل","لص السربال معتمل",23,"ل",1,0],["على اثر المرداس أو كل مقتد","بمرداس والمرداس من نسل هاشم",24,"م",1,0],["على اثر يآس فت في ساعد المنى","لقد اطلعوا الآمال تلمع كالشهب",25,"ب",1,0],["عَلى أثَري يا مَن أرَاهُ مُجَاهِداً","لِيَبلُغَ في هذا الزّمانِ الرّغائِبَا",26,"ب",2,0],["على إثْر مَن جَدّ في سَيْرِهِ","وحادِي المَنايا بِهِ قدْ حَدا",27,"د",2,0],["على أثَر الرّكائِبِ يوْمَ بانُوا","يَحينُ الحَيْنُ أو تدْنو المنيَّهْ",28,"ه",1,0],["على أثَر البيضِ الذين تَحملُوا","لمُقْلِيهِمُ منا جميعاً فَوَدَعوا",29,"ع",3,0],["عَلى إِثرِيَ اِرتَدَّيتُ حَتّى لَقيتُ مَن","هُوَ الأَصلُ إِذ نَقشٌ أَنا وَهوَ طابعُ",30,"ع",1,0],["علي أثام العرب ان ضل صارمي","ولم يحتلب غلب الرقاب له شربا",31,"ب",2,0],["على أثري ابتكرتك ياأنايا","ليقرأني كتاب الشعر متنا",32,"ن",2,0],["على آثارِها كتبَ النَّوايا","كنقشٍ فوقَ أوراقِ الجريدَهْ",33,"د",2,0]]}