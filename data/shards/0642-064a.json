لي قَد أَسى عَلَيكَ فُلانٌ","وَمُقامُ الفَتى عَلى الذُلِّ عارُ",4,"ر",1,1],["قيّضَ اللهُ لِحْيَةً لخَلاصي","قُبِضَتْ بالبَنانِ فوْقَ خِناقِهْ",5,"ه",1,0],["قيّضَ اللّهُ لهُ يوْمَ النّوى","اشْعَلَ النّارَ بهِ حتى انْصَدَعْ",6,"ع",1,0],["قَيْساً دَعَانِي وَسَمَّانِي عَلَى اسْمِ أَبِي","قَيْس بْنِ سَعْدٍ أَلا فَاعْظِمْ بِهِ نَسَبَا",7,"ب",2,0],["قيلَ لي ماتَتْ فَراشَهْ","منْ بُخارِ ابْنِ كُماشَهْ",8,"ش",2,1],["قيلَ تَرثي ذاكَ الَّذي يُنكِرُ النو","رَ وَلا يَهتَدي بِهَديِ الكِتابِ",9,"ب",1,0],["قيلَ اِسكُتوا فَسَكَتنا ثُمَّ أَنطَقَنا","عَسفُ الجُفاةِ وَأَعلى صَوتَنا الأَلَمُ",10,"م",1,0],["قَيَّدْتَ منه جَليلاً شاب مَفرِقُه","في عِزِّةٍ ليس من عِزٍّ يُدانيها",11,"ي",3,0],["قيمَةُ المَرءِ عِندَهُم بَينَ ثَوبٍ","باهِرٍ لَونُهُ وَبَينَ حِذاءِ",12,"ا",2,0],["قيلَ إِذا التاجُ عَليّ خَلا","مَع الكَمالِ الجاهِلِ الأَحمَقِ",13,"ق",1,1],["قيلَ لي إِنَّ مدلويه بنَ بَدرٍ","قَتَلوهُ بِالصَفعِ أَشنَعَ قَتلِ",14,"ل",1,1],["قيلَ يا صاحِ ما اِسمُهُ قُلتُ بَدرٌ","إِنَّما راءُ بَدرِهِ واوُ عَمروِ",15,"و",1,0],["قيل لي أن في دنان خمراً","عتقت منذ حقبةٍ في الدنان",16,"ن",1,0],["قِيلَ لِي إِنَّ فِي دِنَانِكَ خَمْراً","عُتِّقَتْ مُنْذُ حُقْبَةٍ فِي الدِّنَانِ",17,"ن",1,0],["قَيَّدْتَ فِيهِ أَوَابِدَ الْفُصْحَى بما","فَاتَ الأُولَى سَبَقُوا مِنَ الأَقْرَانِ",18,"ن",1,0],["قِيَامَ بَحْرٍ تَلاقَى","حَبَابُهُ وَالغَمَائِمْ",19,"م",1,0],["قِيَاماً بِفَرْضٍ لِلدِّيَارِ مُقَدَّسٍ","وَهَلْ مَنْ يُؤَدِّي ذَلِكَ الفَرْضَ نَادِمُ",20,"م",1,0],["قِياماً يَنظُرونَ إِلى بِلالٍ","رِفاقُ الحَجِّ أَبصَرت الهِلالا",21,"ل",2,0],["قيادي قد تملكه الغرام","ووجدي لا يُطاق ولا يُرامُ",22,"م",1,1],["قيّدوكم لنفعهم بعهود","ناطقات من أسركم بلسان",23,"ن",1,0],["قَيسٌ عَلى وَضَحِ الطَريقِ وَتَغلِبٌ","يَتَقاوَدونَ تَقاوُدَ العُميانِ",24,"ن",1,0],["قَيسُ الطِعانِ فَلا تَهجو فَوارِسَهُم","لِحاجِبٍ وَأَبي القَعقاعِ أَربابُ",25,"ب",1,0],["قَيسٌ وَجَدُّ أَبيكَ في أَكيارِهِ","قُوّادُ كُلِّ كَتيبَةٍ جُمهورِ",26,"ر",1,0],["قَيسٌ تَبيتُ عَلى الثُغورِ جِيادُهُم","وَتَبيتُ عِندَ صَواحِبِ الماخورِ",26,"ر",1,0],["قَيسٌ يَرَونَكَ ما حَيِيتَ لَهُم حَياً","وَلِآلِ خِندِفِ مُلكُكَ اِستِبشارُ",27,"ر",1,0],["قَيسٌ وَخِندِفُ أَهلُ المَجدِ قَبلَكُمُ","لَستُم إِلَيهِم وَلا أَنتُم لَهُم خَطَرُ",28,"ر",1,0],["قَيسٌ وَخِندِفُ إِن عَدَدتَ فَعالَهُم","خَيرٌ وَأَكرَمُ مِن أَبيكَ فَعالا",29,"ل",2,0],["قَيسٌ تَزيدُ عَلى رَبيعَةَ في الحَصى","وَجِبالُ خِندِفَ بَعدَ ذاكَ فُضولُ",30,"ل",1,0],["قيل ما بلدة لها في الثنا الشا","ئع وصف محاسن الترتيب",31,"ب",1,0],["قيراط وصل كنت أجعله على","قنطار هجرانٍ يُغير ذاته",32,"ت",2,0],["قيل لي كنت واصلاً لكريمٍ","فاضَ حتى بأبيض الدّرج فيضا",33,"ض",2,1],["قيل لي ما اسمها الذي يلسع الض","دّ وتجني حلاوة قلت نحله",34,"ل",2,0],["قيامة عند قوم","وعند قوم قيامهْ",35,"م",2,0],["قيل يعني عطارداً قلت لا بل","مشتري الحمد بالنفائسِ بذلا",36,"ل",2,0],["قَيِّمٌ قوَّمَ الأمورَ فعادتْ","قيِّماتٍ به من التحنيبِ",37,"ب",1,0],["قيل لي إنَّ جارَه ابنَ أبي العقْ","لينِ أضحى لأرضه حَرَّاثا",38,"ث",2,0],["قِيلَ لي لمْ ذَمَمْتَ كُلَّ البَرَايَا","وهجَوْتَ الأنَامَ هَجْواً قَبِيحا",39,"ح",2,1],["قيِّمَ الملك يمنح الشمل تألي","فك للمال واللهى تبديدَك",40,"ك",1,0],["قيانيٌّ جواد الكفْ","ف بالمهر وبالجذر",41,"ر",1,0],["قينة عند خالد","تترك الروح تارزَهْ",42,"ز",2,1],["قيل لي إنك شُعِّر","تَ فَضاق المتنفس",43,"س",1,0],["قينةٌ ملعونة من أجلها","رفَضَ اللهوَ معاً من رفضَهْ",44,"ض",2,1],["قيل إن العبد عبدٌ كفورٌ","ما لفحشاء لديه قناع",45,"ع",1,0],["قيل قومي إلى الصَّرا","ة فهذا تكلُّف",46,"ف",1,0],["قَيِّم ملكٍ وابن قوامه","فتّاق ما أعيا ورتاقه",47,"ق",2,0],["قَيِّمٌ كلّهُ وإنْ صِيغَ مِنْ أعْ","وجَ ذي عطفةٍ ومن مُستقيمِ",48,"م",1,0],["قيل لي إنَّ أباه","شِيروِيٌّ نبطيُّ",49,"ي",1,0],["قيلَ لي في الدَيرِ قَومٌ أَدرَكوا سِرَّ الحَياة","غَيرَ أَنّي لَم أَجِد غَيرَ عُقولٍ آسِنات",50,"ت",1,0],["قيلَ أَدرى الناسِ بِالأَسرارِ سُكّانُ الصَوامِع","قُلتُ إِن صَحَّ الَّذي قالوا فَإِنَّ السِرَّ شائِع",50,"ع",1,0],["قيلَ اِعشَقوها قُلتُ لَم يَبقَ لَنا","مَعَها قُلوبٌ كَي نُحِبَّ وَنَعشَقا",51,"ق",2,0],["قيلَ اِغتَنى زَيدٌ فَلَيتَكَ مِثلَهُ","أَنا مِثلُهُ إِن لَم أَقُل أَنا أَفضَلُ",52,"ل",1,0],["قَيَّدتُ قَلبي في هَواهُ فَلَم أَعُد","أَهوى السِوى إِذ لَيسَ لي قَلبانِ",53,"ن",1,0],["قيلَ عَنّا قُصورُنا مِن هَباءِ","تَتَلاشى في ضَحوَةٍ وَمَساءِ",54,"ا",2,0],["قيلَ لَها في البَحرِ كُلُّ المُنى","فَلَم تَجِد في البَحرِ إِلّا الضَباب",55,"ب",1,0],["قَيَّدتُ في مِصرٍ إِلَيكَ رَكائِبي","غَيري يُغَرِّبُ تارَةً وَيُشرِقُ",56,"ق",1,0],["قَيدي أَما تَعلمني مُسلما","أَبَيتَ أَن تُشفِقَ أَو تَرحَما",57,"م",2,1],["قيل لي انت في حفير ولكن","لم اجد في الحفير غير رفاتك",58,"ك",1,0],["قيل لي ان الناس تضحك جمعا","ء سرورا فلا نلاقي حزينا",59,"ن",2,1],["قيل ان الشهيد يحيا لدي الرب","فمن ذا في الارض غير شهيد",60,"د",1,0],["قيل لي احمد على الشدائد والاو","صاب رباً يهدى الورى ويدسى",61,"س",2,0],["قيل ما الفن قلت كل جميل","ملأ النفس حسنه كان فنا",62,"ن",2,1],["قيلَ فَلَمّا تَرَكوا السَفينَه","مَشى مَعَ السَمينِ وَالسَمينَه",63,"ه",1,0],["قيلَ حَلِّلهُ قُلتُ عِرقٌ مِنَ التِب","رِ أَراحَ البَيانَ وَالتَحليلا",64,"ل",2,0],["قيلَ غالٍ في الرَأيِ قُلتُ هَبوهُ","قَد يَكون الغُلُوُّ رَأياً أَصيلا",64,"ل",2,0],["قَيصَرا الأَنسابِ فيهِ نازَلا","قَيصَرَ النَفسِ عِصامَ المالِكين",65,"ن",1,0],["قَياصِرُ أَحياناً خَلائِفُ تارَةً","خَواقينُ طَوراً وَالفَخارُ المُقَلَّبُ",66,"ب",1,0],["قيلَ إيزيسُ رَبَّةَ الكَونِ لَولا","أَن تَوَحَّدتِ لَم تَكُ الأَشياءُ",67,"ا",2,0],["قَيلٌ بِمَنبِجَ مَثواهُ وَنائِلُهُ","في الأُفقِ يَسأَلُ عَمَّن غَيرَهُ سَأَلا",68,"ل",2,0],["قِياماً لِمَن يَشفي مِنَ الداءِ كَيُّهُ","وَمَن بَينَ أُذنَي كُلِّ قَرمٍ مَواسِمُه",69,"م",2,0],["قيامتنا جمع أرواحنا","وأجسادهن بدار المقامه",70,"م",2,1],["قيامة الأرواح في الأجسادِ","لأربع صرن إلى اتحاد",71,"د",1,0],["قيمها الشمس التي لم تزل","بالدور في أفلاكها ترأب",72,"ب",1,0],["قِيامٌ في المَراتِبِ أَو قُعودٌ","سُكونٌ في أَناةٍ وَاِتِّئادِ",73,"د",1,0],["قيدَت لَهُ مِن قُصورِ الشامِ ضُمَّرُها","يَطلُبنَ شَرقِيَّ أَرضٍ بَعدَ تَغريبِ",74,"ب",1,0],["قِياماً يَنظُرونَ إِلى سَعيدٍ","كَأَنَّهُمُ يَرَونَ بِهِ هِلالا",75,"ل",2,0],["قَيَّدْتَ لَحْظَ جُفونِه فأرَيْتَه","رأدَ الضُّحى ليلاً عليه كَثيفا",76,"ف",2,0],["قِيامٌ يَهُزُّونَ النُّسوعَ كأنَّما","بأيديهمُ حيَّاتُ ر