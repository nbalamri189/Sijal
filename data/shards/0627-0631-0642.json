","المديد"],[349,"أرقني دمل وأقلقني","https://www.aldiwan.net/poem20271.html","المنسرح"],[354,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[365,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[365,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[366,"أرقت وأمسيت لا أرقد","https://www.aldiwan.net/poem44522.html","المتقارب"],[371,"أتاني على قرب المزار صحيفة","https://www.aldiwan.net/poem1325.html",""],[371,"ولما أتانا والديار بعيدة","https://www.aldiwan.net/poem1329.html",""],[381,"سقى الله في مصر السعيدة منزلا","https://www.aldiwan.net/poem48748.html","الطويل"],[381,"سلام على من لا أنوه باسمه","https://www.aldiwan.net/poem48776.html","الطويل"],[381,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[381,"أمسى المعنى يعاني ما يعانيه","https://www.aldiwan.net/poem48841.html","البسيط"],[406,"أرقت حتى حسبت عيني","https://www.aldiwan.net/poem49721.html","مخلع البسيط"],[407,"أيا من نعاه لسان القريض","https://www.aldiwan.net/poem50146.html","المتقارب"],[417,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[417,"وقفنا بالركائب يوم سلع","https://www.aldiwan.net/poem54152.html","الوافر"],[433,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[433,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[438,"ترفّق فذا قلب على العذل لا يقوى","https://www.aldiwan.net/poem2504.html","الطويل"],[442,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[454,"أرقصي أيتها الأضواء","https://www.aldiwan.net/poem61391.html","مجزوء الرمل"],[456,"أرقت فما أنام ولا أنيم","https://www.aldiwan.net/poem26656.html","الوافر"],[459,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[459,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[459,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[462,"كفي مقالك عن لومي وتفنيدي","https://www.aldiwan.net/poem15135.html","البسيط"],[462,"شربت دما ان حال ودي ساعة","https://www.aldiwan.net/poem15480.html","الطويل"],[465,"قالوا شكا جسم ابرهيم قلت لهم","https://www.aldiwan.net/poem3223.html","عموديه"],[465,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[469,"أرقت لبرق هز عطفيه في الدجى","https://www.aldiwan.net/poem59679.html","الطويل"],[469,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[469,"نور الصباح مسبل الأطناب","https://www.aldiwan.net/poem60429.html","الرجز"],[478,"أرقت من بارق بالجزع لماع","https://www.aldiwan.net/poem15184.html","البسيط"],[478,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[478,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[478,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[480,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[483,"سرى بفؤادي الوجد نحوك هائم","https://www.aldiwan.net/poem24474.html","عموديه"],[483,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[501,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[514,"أرقت لبرق من تهامة خافق","https://www.aldiwan.net/poem67714.html","الطويل"],[514,"أرقت بنار بالطليحة أوقدت","https://www.aldiwan.net/poem67772.html","الطويل"],[515,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[517,"أرق المحب وعاده سهده","https://www.aldiwan.net/poem48696.html","أحذ الكامل"],[528,"هذا أبو بكر صقلت حسامه","https://www.aldiwan.net/poem46008.html","الكامل"],[528,"كتابي أبا نصر إليك وحالتي","https://www.aldiwan.net/poem46019.html","الطويل"],[530,"هل إلى وصل من هويت سبيل","https://www.aldiwan.net/poem37274.html","الخفيف"],[541,"أرقتني تلومني أم بكر","https://www.aldiwan.net/poem56642.html","الخفيف"],[541,"أجارتنا بذي نفر أقيمي","https://www.aldiwan.net/poem56652.html","الوافر"],[547,"لابنة عجلان بالجو رسوم","https://www.aldiwan.net/poem1857.html","مجزوء البسيط"],[552,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[552,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[552,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[552,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[563,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[563,"لمن طلل بوادي الرمل باد","https://www.aldiwan.net/poem52899.html","الوافر"],[563,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[564,"أرق ماء الحياة لأجل جلى","https://www.aldiwan.net/poem13616.html","الوافر"],[567,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[576,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[588,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"]],"verses":[["أَرِقتُ وَلَم يَأرَق مَعي مَن رَجَوتُهُ","لِيَومي إِذا دارَت عَليَّ الدَوائِرُ",0,"ر",1,0],["أَرِقتُ لِأَجفانِ الرَكائِبِ هَبَّةً","بِأَلحاظِ جَوّالِ العَزائِمِ ساهِرِ",1,"ر",1,0],["أَرِقتُ لشوقٍ أَضمرَتْهُ الأَضالعُ","بِلَيلٍ يداني الخَطْوَ والنَّجمُ ظالِعُ",2,"ع",1,1],["أَرِقْنا وَأسْرابُ النُّجومِ هُجوعُ","نُعالِجُ هَمّاً أَضْمَرَتْهُ ضُلوعُ",3,"ع",1,1],["أَرِقاً بِتُّ ما أَلَذُّ رُقاداً","تَعتَريني مُبَرِّحاتُ الأُمورِ",4,"ر",1,0],["أرِقْتُ فجُنْحُ اللّيلِ قُيِّدَ خَطْوُهُ","فلَهْفي على الجَفْنِ القَريحِ المُسَهَّدِ",5,"د",1,1],["أَرِقتُ وَهاجَتني الهُمومُ الحَواضِرُ","وَهَمُُّ الفَتّى سارٍ عَليهِ وَباكِر",6,"ر",1,1],["أَرِقتُ وَما هَذا السُهادُ المُؤَرِّقُ","وَما بِيَ مِن سُقمٍ وَما بِيَ مَعشَقُ",7,"ق",1,1],["أَرَقَّ مِن شِعرِ أَبي تَمّامِ","وَمَجلِسٍ في غَفلَةِ الأَيّامِ",8,"م",1,0],["أرقد هنيئا إنني","لا استطيع أرقد",9,"د",1,0],["أَرِقتُ وَنامَ عَن سَهَري صِحابي","كَأَنَّ النارَ مُشعِلَةٌ ثِيابي",10,"ب",2,1],["أَرَقُّ امْرُيءٍ لِلْشَّاهِدِينَ رِعَايَةً","وَأَوْفَى امرِيءٍ حِفَظاً لِغَيْبَةِ غَائِبِ",11,"ب",1,0],["أرقعة والبأس غير العدد","قد حملوا مختلفات العدد",12,"د",1,0],["أَرِقتُ لِبَرقِ آخَرَ اللَيلِ مُنصِبِ","خَفِيٍّ كَبَطنِ الحَيَّةِ المُتَقَلِّبِ",13,"ب",1,1],["أَرِقتُ وَقَد نامَ العُيونُ لِمُزنَةٍ","تَلأَلأَ وَهَناً بَعدَ هَدءٍ وَميضُها",14,"ض",3,0],["أَرِقتُ لَهُ وَحدي وَقَد نامَ صُحبَتي","بَطيئا مِنَ الغَورِ التِهامي نُهوضُها",14,"ض",3,0],["أَرقتُ لَهُ وَالثَلجُ بَيني وَبَينَهُ","وَحَومانُ حُزوى فَاللَّوى وَالحَرائِرُ",15,"ر",1,0],["أرَقَ سجية منهم وأرقى","حمير الوحش سارحةً بمَرج",16,"ج",1,0],["أرقى الشعوب تمدناً وحضارة","من كان منهم في الفنون عريقا",17,"ق",2,0],["أرقى الصحائف فيما عندهم أدباً","ما شذّ منها بهم عن خطّة الأدب",18,"ب",1,0],["أَرِقَ العُيونُ فَنَومُهُنَّ غِرارُ","إِذ لا يُساعِفُ مِن هَواكَ مَزارُ",19,"ر",1,1],["أَرِقتُ لَهُ وَأَنجَدَ بَعدَ هَدءٍ","وَأَصحابي عَلى شُعَبِ الرِحالِ",20,"ل",1,0],["أَرِقتُ لِتَوماضِ البُروقِ اللَوامِعِ","وَنَحنُ نَشاوى بَينَ سَلعٍ وَفارِعِ",21,"ع",1,1],["أَرِقتُ لَهُ حَتّى عَلِمتُ مَكانَهُ","بِأَكنافِ سِلعٍ وَالتِلاعِ الدَوافِعِ",21,"ع",1,0],["أرقد هنيئاً فلا سهد بممتنعٍ","منَّا عليك ولا قلبٌ بصبَّار",22,"ر",1,0],["أرقب الغرب حين أذكر مولا","يَ كأن الشهاب صار هلالا",23,"ل",2,0],["أرقُّ من الماءِ الذي في حُسامه","طِبَاعاً وأمضى منْ شَبَاهُ وأنجدُ",24,"د",1,0],["أرْقَدَ السَّاهِرين أنَّ بني وهْ","بٍ عن النائباتِ غيْرُ رُقُودِ",25,"د",1,0],["أرقتُ كأني بتُّ ليلي على الجمرِ","أُراعي كرىً بين السّماكين والنَّسْرِ",26,"ر",1,1],["أرقْتُ كأنِّي النجمُ يجري ويكنسُ","مدى ليلتي أنْضُو دُجَاها وألبسُ",27,"س",1,1],["أرقَّ مالي ولو أشاء لأص","بحت وأمسيت منه في كَثَف",28,"ف",1,0],["أرَّقه مدحُك لا مجدياً","فاقتصّ تأريقاً بتأريق",29,"ق",1,0],["أرّقني بعد أن عجبت له","أبيضُ كالأقحوان متَّسقا",30,"ق",2,1],["أرقَّى إليكَ الكاشحونَ نميمة","طويتَ لها كَشْحَيْكَ مني على ضِغن",31,"ن",1,0],["أَرِقتُ لِذِكرِهِ مِن غَيرِ نَوبٍ","كَما يَهتاجُ مَوشِيٌّ ثَقيبُ",32,"ب",1,0],["أَرِقتُ لَهُ ذاتَ العِشاءِ كَأَنَّهُ","مَخاريقُ يُدعى وَسطَهُنَّ خَريجُ",33,"ج",1,0],["أَرِقتُ وَصُحبَتي بِمَضيقِ عُمقِ","لِبَرقٍ في تِهامَةَ مُستَطيرِ",34,"ر",1,1],["أَرَقُّ مِنَ الماءِ الزُلالِ شَمائِلاً","وَأَصفى مِنَ الخَمرِ السُلافِ وَأَلطَفُ",35,"ف",1,0],["أرْقُبُ الموتَ والحياةَ وأصغي","لحديثِ الآزالِ والآبادِ",36,"د",1,0],["أرقب النجم فيه نجم الثريا","بعيونِ ما ذقن طعم الهجود",37,"د",1,0],["أرقت وما نسيت بنات بوم","على المطرية اندفعت بكيا",38,"ي",2,0],["أرقصوه بقولهم فيلسوف","حين غنت على قفاه الكفوف",39,"ف",1,1],["ارقت دماءهم لعبا ولهوا","ولم تعرف لغاليها مقاما",40,"م",2,0],["أَرِقتَ وَكَيفَ يُعطى الغُمضَ جَفنٌ","تَسُلُّ وَراءَهُ القَلبَ الرُواعا",41,"ع",2,0],["أَرَقُّ شَبابِ دِمياطٍ عَلَيها","وَأَنشَطُهُم لِحاجَتِها قَضاءَ",42,"ا",2,0],["أَرِقتُ وَعادَتني لِذِكرى أَحِبَّتي","شُجونٌ قِيامٌ بِالضُلوعِ قُعودُ",43,"د",1,0],["أَرَقٌ عَلى أَرَقٍ وَمِثلِيَ يَأرَقُ","وَجَوىً يَزيدُ وَعَبرَةٌ تَتَرَقرَقُ",44,"ق",1,1],["أرقالُ أقداحٍ وأرمالُ الغِنى","أشهى من الإرقالِ والذَّملانِ",45,"ن",1,0],["أَرِقْتُ لبرقٍ لاح عنِّي وميضُه","وإنسانُ عيني في صَرَى الدمعِ سابحُ",46,"ح",1,1],["أَرَقَّ مِن لَفظِ صَبٍّ","شَكا حَرارَةَ وَجدِ",47,"د",1,0],["أَرَقَّت جِناياتُ المُضَلَّلِ ثَروَتي","فَلا نَشَبٌ بَعدَ العُبَيدِ وَلا وَفرُ",48,"ر",1,0],["أَرَّقَ العَينَ أَنَّ قُرَّةَ عَيني","دَخَلَت بَينَهُ اللَيالي وَبَيني",49,"ن",2,1],["أَرِقتُ فَلَم أَنَم لَيلاً طَويلاً","أُراقِبُ هَل أَرى النِسرَينِ زالا",50,"ل",2,0],["أرقت دما أرجو الشفاء وإنما","بكأس مدام من أراق دما يشفى",51,"ف",2,1],["أرق جفني حبش ونوب","فبات والغمض به غريب",52,"ب",1,1],["أَرَقْتُ دمي وأَعوَزَني","سَليلُ الكَرْمِ والكَرَمِ",53,"م",1,0],["أَرَقْتُ ماءَ شبابي في محاسِنِها","حتى تَرقَرقَ فيها ماؤُها الجاري",54,"ر",2,0],["أَرِقْتُ لوُدٍّ منك أودى ابتسامُه","وأنجُمِ بشرٍ منك غابَتْ سُعودُها",55,"د",3,0],["أَرِقتُ لَنوحٍ آخِرَ اللَيلِ غَرَّدا","لِشَيخِيَ يَنعي وَالرَئيسُ المُسَوَّدا",56,"د",2,1],["أُرَقِّعُ مِن دُنيايَ دُنيا دَنِيَّةً","وَداراً كَثيراً وَهيُها وَخُروقُها",57,"ق",3,0],["أَرقيكَ أَرقيكَ بِاِسمِ اللَهِ أَرقيكا","مِن بُخلِ نَفسِكَ عَلَّ اللَهَ يَشفيها",58,"ه",2,1],["أَرِقتُ وَطارَ عَن عَيني النُعاسُ","وَنامَ السامِرونَ وَلَم يُواسوا",59,"س",3,1],["أُرقي إِلى عَرشِ الرَجا رَبَّ النَدى","فَكَأَنَّ يَومي لَيلَةُ الإِسراءِ",60,"ا",2,0],["أرقّ الهوى عندها مجهداً","وأنَّ النسيمُ بها مرهقَا",61,"ق",2,0],["أرقبه يا كَدّ هذا الرقيب","في طيب الكون وفي باطله",62,"ه",1,0],["أرقوني أجرع السقم وبي","صفرة الكأس وأوهام الحباب",63,"ب",1,0],["أرق ما تشتهي الن","نفس منظراً وعبيرا",64,"ر",2,0],["أرّقَ الأجفانَ رعدٌ صوتُهُ","كهديرِ القَرْمِ في الشّوْلِ حَفَد",65,"د",1,0],["أَرِقتُ وَآبَني هَمّي","لِنَأيِ الدارِ مِن نُعمِ",66,"م",1,1],["أَرِقتُ وَلَم آرَق لِسَقمٍ أَصابَني","أُراقِبُ لَيلاً ما يَزولُ طَويلا",67,"ل",2,1],["أَرقُبُ نَجماً كَأَنَّ آخِرَهُ","بَعدَ السِماكَينِ لُؤلُؤٌ نَسَقُ",68,"ق",1,0],["أَرِقَ الحَبيبُ إِلى الحَبيبِ لَوَ أَنَّ","عَذَرَت بِذَلِكَ أَوَّلَ العُذرِ",69,"ر",1,0],["أَرِقتُ وَلَم أَملِك لِهَذا الهَوى رَدّا","وَأَورَثَني حُبّي وَكِتمانُهُ جَهدا",70,"د",2,1],["أَرِقتُ وَلَم يُمسِ الَّذي أَشتَهى قُربا","وَحُمِّلتُ مِن أَسماءَ إِذ نَزَحَت نُصبا",71,"ب",2,1],["أَرِقتُ فَلَم أَنَم طَرَبا","وَبِتُّ مُسَهَّداً نَصِبا",72,"ب",2,1],["أَرِقتُ عَلى الصِبا لِطُلوعِ نَجمٍ","أُسَمّيهِ مُسامَحَةً مَشيبا",73,"ب",2,1],["أَرَقتُ أَكُفَّ الدَمعِ طَوراً وَأَسفَحُ","وَأَنضَحُ خَدّي تارَةً ثُمَّ أَمسَحُ",74,"ح",1,1],["أَرَقَّ نَسيبي فيهِ رِقَّةُ حُسنِهِ","فَلَم أَدرِ أَيُّ مِنهُما قَبلَها السِحرُ",75,"ر",1,0],["أَرِقتُ وَقَد نامَ الخَلِيُّ لِنازِحٍ","تَشَظَّت حَصاةُ القَلبِ في حُبِّهِ صَدعا",76,"ع",2,1],["أَرِقتُ لِذِكرى مَنزِلٍ شَطَّ نازِحٍ","كَلِفتُ بِأَنفاسِ الشَمالِ لَهُ شَمّا",77,"م",2,1],["أَرِقتُ أَغوصُ عَلى دُرِّهِ","وَقَد ماجَ بَحرُ الدُجى وَاِلتَطَم",78,"م",1,0],["أَرَقتُ وَعادَني هَمٌّ جَديدُ","فَجِسمي لِلهَوى نِضوٌ بَليدُ",79,"د",1,1],["أرقتَ حَياتَهُ فأرقتَ منها","صَرِيحَ الكُفْرِ يأبى أن يُشابا",80,"ب",2,0],["أَرِقتُ لِبَرقٍ بِالحِمى يَتَأَلَّقُ","فَقَلبي أَسيرٌ حَيثُ دَمعِيَ مُطلَقُ",81,"ق",1,1],["أَرِقتُ بِسَلعٍ إِنَّ ذا الشَوقِ يَأرَقُ","لِبَرقٍ تَبَدّى آخِرَ اللَيلِ يَخفُقُ",82,"ق",1,1],["إِرقالُها وَالسَيرُ تَحتَ الرَحلِ","رَأَيتُ بِالجودِ عُيوبَ البُخلِ",83,"ل",1,0],["أُرَقّي زَفيري في التَراقي عَلَيهِمُ","إِذا لاعَجُ الأَحزانِ أَوجَعَني مَضّا",84,"ض",2,0],["أَرِقتُ لَهُ وَالرُكبُ مَيلٌ رُؤوسُهُم","يَخوضونَ ضَحضاحَ الكَرى وَبِهِم وَقرُ",85,"ر",1,0],["أَرِقتُ جَميعَ اللَيلِ لِلبارِقِ الَّذي","تَرَفَّعَ مَع نَجدٍ فَشاقَ إِلى نَجدِ",86,"د",1,1],["أرَقُّ من صَفحةِ الماء المَعِينِ وإنْ","خاطبتَ خاطبتَ قُحّاً فوقَ مَهريّ",87,"ي",1,0],["أرِقْتُ لِبُرقٍ يستطيرُ له لَمْعُ","فعصفَرَ دمعي جائلٌ من دمي رَدْعُ",88,"ع",1,1],["أَرِقتُ مِن خُلَّةٍ باتَت وَساوِسُها","تَسري عَلَيَّ وَباتَت دارُها صَدَدا",89,"د",2,0],["أَرَقي لِشَخصٍ ما يُفارِقُني","وَيُحِبُّهُ قَلبي وَإِن نَزَحا",90,"ح",2,0],["أَرِقتُ إِلى بَطنِ الخَرينِ وَرَغبَتي","إِلى مَلِكٍ يَجلو الدُجى حينَ يَخرُجُ",91,"ج",1,0],["أَرقُبُ البَدرَ كَي أَرى","وَجهَ بَدرٍ مُتَوَّجِ",92,"ج",1,0],["أَرقُبُ اللَيلَ كَأَنّي واجِدٌ","راحَةً في الصُبحِ مِن جَهدِ التَعَب",93,"ب",1,0],["أَرِقتُ فَهَل نَجمُ الدُجُنَّةِ آرِقُ","وَتَجري الغَوادي بِالرَدى وَالطَوارِقُ",94,"ق",1,1],["أَرَّقَ العَينَ خَيالٌ لَم يَقِر","طافَ وَالرَكبُ بِصَحراءِ يُسُر",95,"ر",1,0],["أَرِقتُ لِضَوءِ بَرقٍ في نَشاصِ","تَلَألَأَ في مُمَلَّأَةٍ غِصاصِ",96,"ص",1,1],["أرقتُ وقلبي عنك ليسَ يُفيقُ","وأسعدتَ أعدائي وأنتَ صديقُ",97,"ق",1,1],["أُرْقُصي يا نجومُ في الليلِ حولي","واتبعي يا جبالُ في الأرضِ ظِلِّي",98,"ل",2,1],["أرّقته صبابةٌ","بين جنبيه تضطرمْ",99,"م",1,0],["أرَّقتهُ صبابةٌ حملتها","نفسهُ من ربوعهِ النائياتِ",100,"ت",1,0],["أرقّ النّاس عاطفة وطبعا","وأعنفهم على الطّاغي جماحا",101,"ح",2,0],["أَرِقتُ لمُكفَهِرٍّ باتَ فيهِ","بَوارِقُ يَرتَقينَ رُؤوسَ شِيبِ",102,"ب",1,1],["أَرِقْتُ لَهُ وَالشُّهْبُ حَيْرَى كَلِيلَةٌ","مِنَ السَّيْرِ وَالآفَاقُ حَالِكَةُ الْبُرْدِ",103,"د",1,0],["أَرِقتُ لِبَرقٍ مِن تِهامَةَ ضاحِكٍ","أَهابَ بِهِ نَحوَ العِراقِ مُهيبُ",104,"ب",1,0],["أَرَقُ العَينِ بَرقٌ","شَقَّ مِنها رُكاما",105,"م",2,0],["أرق جفني وسنان","ينهب نوم السهران",106,"ن",1,0],["أرَّقْتَ طَرْفاً لم تَرِقَّ لقَرحه","وأخَفْتَ قلباً لم تُرَع لحفيفه",107,"ف",2,0],["أرقت أجفاني فلو راودتها","غمضاً لما طاوعن في الاطباق",108,"ق",1,0],["أرق ما