اك","وأناجى في صباباتي صباك",135,"ك",1,0],["أُرقُد قَريرَ العَينِ يا خِلِيُّ","وَانتَ فَاِشقَ أَيُّها الشَقِيُّ",136,"ي",1,0],["أُرقِدي أُرقِدي فَغَيرُ الرِقادِ","لَيسَ يَحلو لِأَعيُنِ الأَولادِ",137,"د",1,1],["أُرقِدي وَاِحلَمي فحلمُك عَذبٌ","يا سعاداً كَالسَلسَبيل البُرادِ",137,"د",1,0],["أُرقِدي يا سعادُ فَالنَومُ عَذبٌ","لِفُؤادٍ ما ذاقَ طُعمَ السهادِ",137,"د",1,0],["أرقتُ وعاد القلبَ طائفُ فِكرةٍ","نَأَى بالكرى عن مقلتي وشَجاني",138,"ن",2,0],["أَرقتَ دمي ومالك فيه حَقٌّ","تَصُول به وليس عليه دين",139,"ن",1,0],["أرقّ جلداً إذا تأمّل مِن","شكوَى بدت بين سَفْك دَمْعَين",140,"ن",1,0],["أرقَّ أملاكِ هاشمٍ أدبا","وخيرهم منظَراً ومختبرَا",141,"ر",2,0],["أرِقت لبرقٍ أضاء الدّجون","وأذهب حُلْكةَ أطنابِها",142,"ب",3,0],["أرق من أَدْمُع التّصابي","سَكْبا وأَشْهى من الضِّراب",143,"ب",1,0],["أَرّق إذا رَقْرقتَها في زجاجة","وألطَفُ من نَفْسٍ تَداولَها الحبُّ",144,"ب",1,0],["أرِقتُ لهذا البَرْقِ حتى كأنّما","شَرَى فبدَتْ منه لعينيَ زينبُ",145,"ب",1,0],["أَرِقتُ لَهُ وَالبَرقُ دونَ طَمِيَّةٍ","وَذي نَجَبٍ يا بُعدَهُ مِن مَكانِيا",146,"ي",2,0],["أَرِقتُ لِلَمعِ بَرقٍ حاجِرِيٍّ","تَأَلَّقَ كَاليَماني المُشرَفِيِّ",147,"ي",1,1],["أُرَقِّعُ عُمراً أَخلَقَتهُ بِكَرِّها","اللَيالي إِلى كَم يُرقَعُ الخَلَقُ البالي",148,"ل",2,0],["أَرَقتَ بِالبَينِ دَماً","لَولا الهَوى لَم يُرَقِ",149,"ق",1,0],["أُرقُد هَنيئاً فَإِنّي","ما ذُقتُ بَعدَكَ غُمضا",150,"ض",2,0],["أَرْقَتْكَ لِلْفِرْدَوْسِ مِنْ","قَبْلِ ا لنُّزُولِ إِلَى الصَّعِيدْ",151,"د",1,0],["ارق بالأبرقين جفني","يرف على رامة مليح",152,"ح",1,0],["أرِقتُ ولذَّ لي أرقي عليهِ","لسكري بالجمالِ السرمدي",153,"ي",1,0],["أَرِقْتَ لِلْواحِدِ القَيُّومِ مُتَّصِلاً","بِهِ فَلَيْسَ رِضَاهُ عَنْكَ مُنْقَطِعا",154,"ع",2,0],["أَرِقتُ لِبَرقٍ مِن أَهاضيبِ لُبنانِ","خَفوقٍ كَقَلبي مُمتَرٍ سُحبَ أَجفاني",155,"ن",2,1],["أَرقدةُ أَهل الكَهفِ يا حَظِيَ انتَبِه","فَإِنّي حُرِمتُ النَّومَ إِلا أَقَلَّهُ",156,"ل",2,0],["أَرقُّ مِنَ الخَمرِ المُرَوَّقِ جِسمُها","وَلَكِن بِهِ قَلبٌ قَساوَتُهُ صَخرُ",157,"ر",1,0],["أَرَقنا لَدَيكُم مِياهَ الوُجوهِ","وَإِهراقُ ذاكَ مِنَ الحُرِّ مُر",158,"ر",1,1],["أرقت من دمك الغالي على وطن","ومن فؤادك ألحاناً وأشجانا",159,"ن",2,0],["أَرِقتُ بها وَالصبحُ قد حالفَ الدُجى","فَما نَسرُها سارٍ ولا الديك صارخُ",160,"خ",1,0],["أَرِقتُ وقد نامَ الخَليُّ من الأَسى","لبَرقٍ بأَعلى الرَقمتين لَموحِ",161,"ح",1,0],["أَرقُّ من اللّحظ الفتون فتورهُ","دَعا لِلهوى صبّاً بإيماءةِ الهدبِ",162,"ب",1,0],["أَرقّ مِنَ الصهباءِ سلسال طبعهِ","وَأَنضَرُ مِن زهرِ الربى ضاحك السكبا",163,"ب",2,0],["أرقّ من الأسحارِ ثوباً ونسمةً","وَأَلطف من نوم بها غازل الحبّا",163,"ب",2,0],["أرقد صديقي في خلودك وَحدهُ","إن لم نَجد نحنُ الخلودَ الشاملا",164,"ل",2,0],["أرقد فحسبك ما حَملت من الأذَى","وداع الممات يُميتُ داءكَ عاجلا",164,"ل",2,0],["أَرِقتُ وَصاحِبايَ بِبَعلَبكِّ","وَأَرَّقَني الهُمومُ مَع التَشَكّي",165,"ك",2,1],["أَرقتُ وَشَرُّ الداءِ هَمٌ مُؤَرِّق","كَأَنّي أَسيرٌ جانَبَ النَومَ موثَقُ",166,"ق",1,1],["أرقتُ على أقدامِها خمرةَ الصبا","وأفنيتُ في لذّاتِها كلّ مالِيا",167,"ي",2,0],["ارقصوا رقصة الحياة أو المو","ت إذا مات سيد أو زنيم",168,"م",1,0],["أرق السهد مقلة","لم تدنس مدى السنين",169,"ن",1,0],["أَرِقتُ لَهُ في القَومِ وَالصُبحِ ساطِعٌ","كَما سَطَعَ المِرّيخُ شَمَّرَهُ الغالي",170,"ل",2,0],["أرقصي فالحياة","غادتي من خيال",171,"ل",1,0],["ارق قد حار في وطن","ساغب حران ممتهن",172,"ن",1,0],["أَرَّقَني دُمّلٌ وأَقلَقَني","فَما لِلَيلي وَمَالَهُ فَجْرُ",173,"ر",1,1],["أَرقت وَقَد أَراقَ دَمي غَزالٌ","بِخَدّيهِ شُهود دَمي المُراقِ",174,"ق",1,0],["أَرِقْتُ له لمّا أَضاء وَميضُه","أُقلِّبُ منّي فيه طَرْفَ حَزين",175,"ن",1,0],["أرِقْتُ وصَحْبي بنَجْدٍ هُجودُ","وأيدِي الرّكائبِ وَهْناً ركودُ",176,"د",1,1],["أَرِقتُ وأَمسَيتُ لا أَرقُدُ","وساوَرَني المُوجِعُ الأَسودُ",177,"د",1,1],["أَرَقُّ مِنَ السّلسَالِ لَفظَاً، كَأَنَّمَا","جَرَتْ في نَواحِيها بَرِقْرَاقِهَا السُّحْبُ",178,"ب",1,0],["أَرَقُّ مِنَ السلْسَالِ لُطْفاً كَأَنَمَّا","تَأَلَّفَ مِنْ روح الصَّبَا وَتَجَّمعا",179,"ع",2,0],["أَرق وَأَشهى مِن تَنصل مُغرَم","وَأَعذَب مِن عَتب الحَبيب عَلى الصَب",180,"ب",1,0],["أَرق وَاصفي مِن دُموع النَدى عَلى","أَقاح الرُبى صُبحاً وَأَذكى مِن المسك",181,"ك",1,0],["أَرقت لِبَرق باتَ يَشئم تارَةً","وَيَعرَق أُخرى لِأكليل وَلا واني",182,"ن",2,0],["أَرقت مِنهُ كَراه بَعد عِبرَتِهِ","لِبُعد وَسِنان سُهدي مشن تَنائِيهِ",183,"ي",2,0],["أرِقتُ حتَّى حَسِبْتُ عَيني","قد خُلِقَتْ لي بِلا جُفونِ",184,"ن",1,1],["أَرقتَ دَماً بَعدَما صُنتَهُ","وَأَشعَلتَ جَمراً وَلَم تُطفِهِ",185,"ف",2,0],["أُرقْرِقُ عَبرة وأذوبُ شوقاً","ويَعدِمُني بها الشَّوقُ القرارا",186,"ر",2,0],["أرق يا سعد دمعك إنَّ دمعي","دمٌ إنْ كانَ منك الدمع ماءا",187,"ا",3,0],["أَرْقَصَها مُطْرِبُ الأَغارِيدِ","فاسْتَرَقَتْ هِزَّةَ الأَماليدِ",188,"د",1,1],["أرقَه الحبّ وأضنى جسدَهْ","وأشمَت الوجدَ به من حسَدِهْ",189,"ه",1,0],["أرقش من شعرى إليك قصيدة","بها عطش يروي إذا لفظها يروي",190,"و",2,0],["أرقاه في درج لم تلقها رسل","من قبله فحوت مجداً رقايته",191,"ت",2,0],["أرقصي أيتها ال","أضواء بالحلم المردد",192,"د",1,1],["أَرقتُ فَما أَنامُ وَلا أُنيمُ","وَجاءَ بِحُزنِيَ اللَيلُ البَهيمُ",193,"م",1,1],["أرِقتُ ونام عن إسعادِ عيني","خليلٌ كان يُسهمُ في كراها",194,"ا",3,0],["أرقشَ ما أوجرَ من","ها رِيقَةً فأمهلا",195,"ل",2,0],["أرقتُ فهل لهاجعةٍ بسلعٍ","على الأرِقين أفئدةٌ ترِقُّ",196,"ق",1,0],["أرقبُ من نجومها","زوالَ أمرٍ مستقِرّْ",197,"ر",1,0],["أرقُّ من خُلقِ الصهباء شيمتُهُ","فإن يُهَجْ فهو كاسٍ خُلق جلمودِ",198,"د",1,0],["أرَقُّ من الماء الزُّلالِ لسائِلٍ","وأخشنُ في نصر النزيل من النصل",199,"ل",1,0],["أرق من وجنة الصهباء قبلها","ماء الغمام فتلك الحمرة الخجل",200,"ل",1,0],["أرقت له وبعثت الخيال وهل","يطرق الطيفُ إلاّ الهجوعا",201,"ع",2,0],["أَرِقتُ لِبَرقٍ هَزَّ عِطفَيهِ في الدُجى","فَأَرتَقَني لَأَلاؤُهُ إِذ تَضَرَّما",202,"م",2,1],["أَرَقُّ مِنَ العُذرِ عِندَ العِتابِ","وَأَحلى مِنَ الأَمنِ عِندَ الحَذِر",203,"ر",1,0],["أَرَقُّ سِربالاً مِنَ السَرابِ","تُعرَضُ في مَعارِضِ الأَكوابِ",204,"ب",1,0],["أرِْقتُ مِن بارقٍ بالجِزْعِ لمّاعِ","بدا فهيَّجَ أشواقي وأوجاعي",205,"ع",2,1],["أرقَّشُه بالنَّقْسِ حتى كأنَّه","على صفحاتِ الطَّرسِ وشيٌ مُنَمْنَمُ",206,"م",1,0],["أَرِقْتُ هوًى والليلُ مُرخي الذوائبِ","ووكَّلَني وجدي برعي الكواكبِ",207,"ب",1,1],["أرقُّ مِنَ النسيمِ إذا تمشَّى","عليلاً في جوانبهِ النسيمُ",208,"م",1,0],["أرقت وما غير الشجون سمير","لا السهد يتركها ولا التفكير",209,"ر",1,1],["أرقت لشجو الورق والنجم شاهد","لدي وقاضي العشق فيه جرائم",210,"م",1,0],["أرقني سقم النوى","والجسم ذاب من جوى",211,"ج",3,1],["أرقه سقم النوى","والجسم ذاب من جوى",211,"ج",3,0],["أرقبُ البارقَ لا يصرفني","عنه آناً حاجرٌ والأبرق",212,"ق",1,0],["أرقت لبرقٍ من تهامة خافقٍ","كأن سنا إيماضه قلب عاشق",213,"ق",1,1],["أرقت بنارٍ بالطليحة أوقدت","تراءت للحظ العين ثم تسرت",214,"ت",1,1],["أرقُّ من الرّاحِ الشَّمولِ شَمائِلاً","وألطَفُ خُلقاً من نَسيم الهوى العُذري",215,"ر",2,0],["أرق المُحب وَعادَهُ سَهَدُه","لِطَوارِقِ الهم الَّتي ترِدُه",216,"د",2,1],["أرقيتَ بي في سلَّمٍ حتى إذا","نلت الذي تهوى كسرت السُلما",217,"م",2,0],["أرق من الشكوى وأدجى من النوى","وأضعف من قلب المحبِ المتيمِ",218,"م",1,0],["أَرْقُبُ الوَصْلَ واصِلاً لِسُهادٍ","وَنَدِيمي التَّسْويفُ والتَّأْميلُ",219,"ل",1,0],["أَرَّقتني تَلومُني أُمُّ بَكرٍ","بَعدَ هَدءٍ وَاللَومُ قَد يؤذيني",220,"ن",2,1],["أَرقِتُ وَغابَ عَنّي مَن يَلومُ","وَلَكِن لَم أَنَم أَنا لِلهُمومِ",221,"م",1,0],["أَرقتُ وَشفَّني وَجَعٌ بِقَلبي","لِزَينَبَ أَو أُميمَةَ أَو رَعومِ",221,"م",1,0],["أَرَّقَنِي اللَّيْلَ بَرْقٌ ناصِبٌ","ولَمْ يُعِنِّي على ذاكَ حَمِيمْ",222,"م",1,0],["أرِقتُ لضوءِ نارٍ منك تبدو","وتخبو في السّماءِ بلا دُخانِ",223,"ن",1,0],["أرِقْتُ للبرق بالعلياء يضطرمُ","وحبّذا ومضُهُ لو أنّه أَمَمُ",224,"م",1,1],["أرّقَ عيني طارقٌ","يا ليتَه ما طرقا",225,"ق",2,1],["أَرّقنِي فَقدُك مِن راحلٍ","وَاِستَلَّ مِن عَينَيَّ طعمَ الكَرى",226,"ا",1,0],["أرَقُّ من الماءِ الزُّلالِ شمائِلاً","بألطافها فاقت صَفاهُ ولِينَهُ",227,"ن",2,0],["أرَقُّ منَ الزُّلالِ العَذْبِ لُطفاً","وأثبتُ من ثَبيرٍ في الوِدادِ",228,"د",1,0],["أرِقتُ لعُصبَةٍ في الحيِّ زَمُّوا","فُؤَادي عِندَما زَمُّوا الجِمالا",229,"ل",2,0],["أَرِق ماءَ الحَياةِ لِأَجلِ جُلّى","عَرَتكَ وَلا تُرِق ماءَ المُحَيّا",230,"ي",2,1],["أَرِقتُ فَلَم تَخدَع بِعَينَيَّ وَسنَةٌ","وَمَن يَلقَ ما لاقَيتُ لا بُدَّ يَأرَقِ",231,"ق",1,1],["أَرِقُّ لخَدٍّ ربُّه لا يَرقُّ لِي","وأَرحَمُ خِصْراً ربُّه ليس يَرحَمُ",232,"م",1,0],["أرقت وما لي في الدجى من مسامر","يرى فيض دمعي والنجوم الزواهر",233,"ر",1,0]]}