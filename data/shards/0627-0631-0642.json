t/poem37274.html","الخفيف"],[543,"أرقتني تلومني أم بكر","https://www.aldiwan.net/poem56642.html","الخفيف"],[543,"أجارتنا بذي نفر أقيمي","https://www.aldiwan.net/poem56652.html","الوافر"],[549,"لابنة عجلان بالجو رسوم","https://www.aldiwan.net/poem1857.html","مجزوء البسيط"],[554,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[554,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[554,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[554,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[565,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[565,"لمن طلل بوادي الرمل باد","https://www.aldiwan.net/poem52899.html","الوافر"],[565,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[566,"أرق ماء الحياة لأجل جلى","https://www.aldiwan.net/poem13616.html","الوافر"],[569,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[578,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[590,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"],[737,"","https://poetry.dctabudhabi.ae/diwan/poem/97762","الوافر"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31492","الطويل"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/29561","الطويل"],[963,"","https://poetry.dctabudhabi.ae/diwan/poem/96116","الطويل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/29531","الطويل"],[1027,"","https://poetry.dctabudhabi.ae/diwan/poem/20562","الطويل"],[1044,"","https://poetry.dctabudhabi.ae/diwan/poem/27092","الطويل"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17775","الطويل"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28928","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/122173","الوافر"],[1173,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"]],"verses":[["أَرِقتُ وَلَم يَأرَق مَعي مَن رَجَوتُهُ","لِيَومي إِذا دارَت عَليَّ الدَوائِرُ",0,"ر",1,0],["أَرِقتُ لِأَجفانِ الرَكائِبِ هَبَّةً","بِأَلحاظِ جَوّالِ العَزائِمِ ساهِرِ",1,"ر",1,0],["أَرِقتُ لشوقٍ أَضمرَتْهُ الأَضالعُ","بِلَيلٍ يداني الخَطْوَ والنَّجمُ ظالِعُ",2,"ع",1,1],["أَرِقْنا وَأسْرابُ النُّجومِ هُجوعُ","نُعالِجُ هَمّاً أَضْمَرَتْهُ ضُلوعُ",3,"ع",1,1],["أَرِقاً بِتُّ ما أَلَذُّ رُقاداً","تَعتَريني مُبَرِّحاتُ الأُمورِ",4,"ر",1,0],["أرِقْتُ فجُنْحُ اللّيلِ قُيِّدَ خَطْوُهُ","فلَهْفي على الجَفْنِ القَريحِ المُسَهَّدِ",5,"د",1,1],["أَرِقتُ وَهاجَتني الهُمومُ الحَواضِرُ","وَهَمُُّ الفَتّى سارٍ عَليهِ وَباكِر",6,"ر",1,1],["أَرِقتُ وَما هَذا السُهادُ المُؤَرِّقُ","وَما بِيَ مِن سُقمٍ وَما بِيَ مَعشَقُ",7,"ق",1,1],["أَرَقَّ مِن شِعرِ أَبي تَمّامِ","وَمَجلِسٍ في غَفلَةِ الأَيّامِ",8,"م",1,0],["أرقد هنيئا إنني","لا استطيع أرقد",9,"د",1,0],["أَرِقتُ وَنامَ عَن سَهَري صِحابي","كَأَنَّ النارَ مُشعِلَةٌ ثِيابي",10,"ب",2,1],["أَرَقُّ امْرُيءٍ لِلْشَّاهِدِينَ رِعَايَةً","وَأَوْفَى امرِيءٍ حِفَظاً لِغَيْبَةِ غَائِبِ",11,"ب",1,0],["أرقعة والبأس غير العدد","قد حملوا مختلفات العدد",12,"د",1,0],["أَرِقتُ لِبَرقِ آخَرَ اللَيلِ مُنصِبِ","خَفِيٍّ كَبَطنِ الحَيَّةِ المُتَقَلِّبِ",13,"ب",1,1],["أَرِقتُ وَقَد نامَ العُيونُ لِمُزنَةٍ","تَلأَلأَ وَهَناً بَعدَ هَدءٍ وَميضُها",14,"ض",3,0],["أَرِقتُ لَهُ وَحدي وَقَد نامَ صُحبَتي","بَطيئا مِنَ الغَورِ التِهامي نُهوضُها",14,"ض",3,0],["أَرقتُ لَهُ وَالثَلجُ بَيني وَبَينَهُ","وَحَومانُ حُزوى فَاللَّوى وَالحَرائِرُ",15,"ر",1,0],["أرَقَ سجية منهم وأرقى","حمير الوحش سارحةً بمَرج",16,"ج",1,0],["أرقى الشعوب تمدناً وحضارة","من كان منهم في الفنون عريقا",17,"ق",2,0],["أرقى الصحائف فيما عندهم أدباً","ما شذّ منها بهم عن خطّة الأدب",18,"ب",1,0],["أَرِقَ العُيونُ فَنَومُهُنَّ غِرارُ","إِذ لا يُساعِفُ مِن هَواكَ مَزارُ",19,"ر",1,1],["أَرِقتُ لَهُ وَأَنجَدَ بَعدَ هَدءٍ","وَأَصحابي عَلى شُعَبِ الرِحالِ",20,"ل",1,0],["أَرِقتُ لِتَوماضِ البُروقِ اللَوامِعِ","وَنَحنُ نَشاوى بَينَ سَلعٍ وَفارِعِ",21,"ع",1,1],["أَرِقتُ لَهُ حَتّى عَلِمتُ مَكانَهُ","بِأَكنافِ سِلعٍ وَالتِلاعِ الدَوافِعِ",21,"ع",1,0],["أرقد هنيئاً فلا سهد بممتنعٍ","منَّا عليك ولا قلبٌ بصبَّار",22,"ر",1,0],["أرقب الغرب حين أذكر مولا","يَ كأن الشهاب صار هلالا",23,"ل",2,0],["أرقُّ من الماءِ الذي في حُسامه","طِبَاعاً وأمضى منْ شَبَاهُ وأنجدُ",24,"د",1,0],["أرْقَدَ السَّاهِرين أنَّ بني وهْ","بٍ عن النائباتِ غيْرُ رُقُودِ",25,"د",1,0],["أرقتُ كأني بتُّ ليلي على الجمرِ","أُراعي كرىً بين السّماكين والنَّسْرِ",26,"ر",1,1],["أرقْتُ كأنِّي النجمُ يجري ويكنسُ","مدى ليلتي أنْضُو دُجَاها وألبسُ",27,"س",1,1],["أرقَّ مالي ولو أشاء لأص","بحت وأمسيت منه في كَثَف",28,"ف",1,0],["أرَّقه مدحُك لا مجدياً","فاقتصّ تأريقاً بتأريق",29,"ق",1,0],["أرّقني بعد أن عجبت له","أبيضُ كالأقحوان متَّسقا",30,"ق",2,1],["أرقَّى إليكَ الكاشحونَ نميمة","طويتَ لها كَشْحَيْكَ مني على ضِغن",31,"ن",1,0],["أَرِقتُ لِذِكرِهِ مِن غَيرِ نَوبٍ","كَما يَهتاجُ مَوشِيٌّ ثَقيبُ",32,"ب",1,0],["أَرِقتُ لَهُ ذاتَ العِشاءِ كَأَنَّهُ","مَخاريقُ يُدعى وَسطَهُنَّ خَريجُ",33,"ج",1,0],["أَرِقتُ وَصُحبَتي بِمَضيقِ عُمقِ","لِبَرقٍ في تِهامَةَ مُستَطيرِ",34,"ر",1,1],["أَرَقُّ مِنَ الماءِ الزُلالِ شَمائِلاً","وَأَصفى مِنَ الخَمرِ السُلافِ وَأَلطَفُ",35,"ف",1,0],["أرْقُبُ الموتَ والحياةَ وأصغي","لحديثِ الآزالِ والآبادِ",36,"د",1,0],["أرقب النجم فيه نجم الثريا","بعيونِ ما ذقن طعم الهجود",37,"د",1,0],["أرقت وما نسيت بنات بوم","على المطرية اندفعت بكيا",38,"ي",2,0],["أرقصوه بقولهم فيلسوف","حين غنت على قفاه الكفوف",39,"ف",1,1],["ارقت دماءهم لعبا ولهوا","ولم تعرف لغاليها مقاما",40,"م",2,0],["أَرِقتَ وَكَيفَ يُعطى الغُمضَ جَفنٌ","تَسُلُّ وَراءَهُ القَلبَ الرُواعا",41,"ع",2,0],["أَرَقُّ شَبابِ دِمياطٍ عَلَيها","وَأَنشَطُهُم لِحاجَتِها قَضاءَ",42,"ا",2,0],["أَرِقتُ وَعادَتني لِذِكرى أَحِبَّتي","شُجونٌ قِيامٌ بِالضُلوعِ قُعودُ",43,"د",1,0],["أَرَقٌ عَلى أَرَقٍ وَمِثلِيَ يَأرَقُ","وَجَوىً يَزيدُ وَعَبرَةٌ تَتَرَقرَقُ",44,"ق",1,1],["أرقالُ أقداحٍ وأرمالُ الغِنى","أشهى من الإرقالِ والذَّملانِ",45,"ن",1,0],["أَرِقْتُ لبرقٍ لاح عنِّي وميضُه","وإنسانُ عيني في صَرَى الدمعِ سابحُ",46,"ح",1,1],["أَرَقَّ مِن لَفظِ صَبٍّ","شَكا حَرارَةَ وَجدِ",47,"د",1,0],["أَرَقَّت جِناياتُ المُضَلَّلِ ثَروَتي","فَلا نَشَبٌ بَعدَ العُبَيدِ وَلا وَفرُ",48,"ر",1,0],["أَرَّقَ العَينَ أَنَّ قُرَّةَ عَيني","دَخَلَت بَينَهُ اللَيالي وَبَيني",49,"ن",2,1],["أَرِقتُ فَلَم أَنَم لَيلاً طَويلاً","أُراقِبُ هَل أَرى النِسرَينِ زالا",50,"ل",2,0],["أرقت دما أرجو الشفاء وإنما","بكأس مدام من أراق دما يشفى",51,"ف",2,1],["أرق جفني حبش ونوب","فبات والغمض به غريب",52,"ب",1,1],["أَرَقْتُ دمي وأَعوَزَني","سَليلُ الكَرْمِ والكَرَمِ",53,"م",1,0],["أَرَقْتُ ماءَ شبابي في محاسِنِها","حتى تَرقَرقَ فيها ماؤُها الجاري",54,"ر",2,0],["أَرِقْتُ لوُدٍّ منك أودى ابتسامُه","وأنجُمِ بشرٍ منك غابَتْ سُعودُها",55,"د",3,0],["أَرِقتُ لَنوحٍ آخِرَ اللَيلِ غَرَّدا","لِشَيخِيَ يَنعي وَالرَئيسُ المُسَوَّدا",56,"د",2,1],["أُرَقِّعُ مِن دُنيايَ دُنيا دَنِيَّةً","وَداراً كَثيراً وَهيُها وَخُروقُها",57,"ق",3,0],["أَرقيكَ أَرقيكَ بِاِسمِ اللَهِ أَرقيكا","مِن بُخلِ نَفسِكَ عَلَّ اللَهَ يَشفيها",58,"ه",2,1],["أَرِقتُ وَطارَ عَن عَيني النُعاسُ","وَنامَ السامِرونَ وَلَم يُواسوا",59,"س",3,1],["أُرقي إِلى عَرشِ الرَجا رَبَّ النَدى","فَكَأَنَّ يَومي لَيلَةُ الإِسراءِ",60,"ا",2,0],["أرقّ الهوى عندها مجهداً","وأنَّ النسيمُ بها مرهقَا",61,"ق",2,0],["أرقبه يا كَدّ هذا الرقيب","في طيب الكون وفي باطله",62,"ه",1,0],["أرقوني أجرع السقم وبي","صفرة الكأس وأوهام الحباب",63,"ب",1,0],["أرق ما تشتهي الن","نفس منظراً وعبيرا",64,"ر",2,0],["أَرَقتُ وَصاحِبي بِجَنوبِ شِعبٍ","لِبَرقٍ في تِهامَةَ مُستَطيرِ",65,"ر",1,0],["أرّقَ الأجفانَ رعدٌ صوتُهُ","كهديرِ القَرْمِ في الشّوْلِ حَفَد",66,"د",1,0],["أَرِقتُ وَآبَني هَمّي","لِنَأيِ الدارِ مِن نُعمِ",67,"م",1,1],["أَرِقتُ وَلَم آرَق لِسَقمٍ أَصابَني","أُراقِبُ لَيلاً ما يَزولُ طَويلا",68,"ل",2,1],["أَرقُبُ نَجماً كَأَنَّ آخِرَهُ","بَعدَ السِماكَينِ لُؤلُؤٌ نَسَقُ",69,"ق",1,0],["أَرِقَ الحَبيبُ إِلى الحَبيبِ لَوَ أَنَّ","عَذَرَت بِذَلِكَ أَوَّلَ العُذرِ",70,"ر",1,0],["أَرِقتُ وَلَم أَملِك لِهَذا الهَوى رَدّا","وَأَورَثَني حُبّي وَكِتمانُهُ جَهدا",71,"د",2,1],["أَرِقتُ وَلَم يُمسِ الَّذي أَشتَهى قُربا","وَحُمِّلتُ مِن أَسماءَ إِذ نَزَحَت نُصبا",72,"ب",2,1],["أَرِقتُ فَلَم أَنَم طَرَبا","وَبِتُّ مُسَهَّداً نَصِبا",73,"ب",2,1],["أَرِقتُ عَلى الصِبا لِطُلوعِ نَجمٍ","أُسَمّيهِ مُسامَحَةً مَشيبا",74,"ب",2,1],["أَرَقتُ أَكُفَّ الدَمعِ طَوراً وَأَسفَحُ","وَأَنضَحُ خَدّي تارَةً ثُمَّ أَمسَحُ",75,"ح",1,1],["أَرَقَّ نَسيبي فيهِ رِقَّةُ حُسنِهِ","فَلَم أَدرِ أَيُّ مِنهُما قَبلَها السِحرُ",76,"ر",1,0],["أَرِقتُ وَقَد نامَ الخَلِيُّ لِنازِحٍ","تَشَظَّت حَصاةُ القَلبِ في حُبِّهِ صَدعا",77,"ع",2,1],["أَرِقتُ لِذِكرى مَنزِلٍ شَطَّ نازِحٍ","كَلِفتُ بِأَنفاسِ الشَمالِ لَهُ شَمّا",78,"م",2,1],["أَرِقتُ أَغوصُ عَلى دُرِّهِ","وَقَد ماجَ بَحرُ الدُجى وَاِلتَطَم",79,"م",1,0],["أَرَقتُ وَعادَني هَمٌّ جَديدُ","فَجِسمي لِلهَوى نِضوٌ بَليدُ",80,"د",1,1],["أرقتَ حَياتَهُ فأرقتَ منها","صَرِيحَ الكُفْرِ يأبى أن يُشابا",81,"ب",2,0],["أَرِقتُ لِبَرقٍ بِالحِمى يَتَأَلَّقُ","فَقَلبي أَسيرٌ حَيثُ دَمعِيَ مُطلَقُ",82,"ق",1,1],["أَرِقتُ بِسَلعٍ إِنَّ ذا الشَوقِ يَأرَقُ","لِبَرقٍ تَبَدّى آخِرَ اللَيلِ يَخفُقُ",83,"ق",1,1],["إِرقالُها وَالسَيرُ تَحتَ الرَحلِ","رَأَيتُ بِالجودِ عُيوبَ البُخلِ",84,"ل",1,0],["أُرَقّي زَفيري في التَراقي عَلَيهِمُ","إِذا لاعَجُ الأَحزانِ أَوجَعَني مَضّا",85,"ض",2,0],["أَرِقتُ لَهُ وَالرُكبُ مَيلٌ رُؤوسُهُم","يَخوضونَ ضَحضاحَ الكَرى وَبِهِم وَقرُ",86,"ر",1,0],["أَرِقتُ جَميعَ اللَيلِ لِلبارِقِ الَّذي","تَرَفَّعَ مَع نَجدٍ فَشاقَ إِلى نَجدِ",87,"د",1,1],["أرَقُّ من صَفحةِ الماء المَعِينِ وإنْ","خاطبتَ خاطبتَ قُحّاً فوقَ مَهريّ",88,"ي",1,0],["أرِقْتُ لِبُرقٍ يستطيرُ له لَمْعُ","فعصفَرَ دمعي جائلٌ من دمي رَدْعُ",89,"ع",1,1],["أَرِقتُ مِن خُلَّةٍ باتَت وَساوِسُها","تَسري عَلَيَّ وَباتَت دارُها صَدَدا",90,"د",2,0],["أَرَقي لِشَخصٍ ما يُفارِقُني","وَيُحِبُّهُ قَلبي وَإِن نَزَحا",91,"ح",2,0],["أَرِقتُ إِلى بَطنِ الخَرينِ وَرَغبَتي","إِلى مَلِكٍ يَجلو الدُجى حينَ يَخرُجُ",92,"ج",1,0],["أَرقُبُ البَدرَ كَي أَرى","وَجهَ بَدرٍ مُتَوَّجِ",93,"ج",1,0],["أَرقُبُ اللَيلَ كَأَنّي واجِدٌ","راحَةً في الصُبحِ مِن جَهدِ التَعَب",94,"ب",1,0],["أَرِقتُ فَهَل نَجمُ الدُجُنَّةِ آرِقُ","وَتَجري الغَوادي بِالرَدى وَالطَوارِقُ",95,"ق",1,1],["أَرَّقَ ا