{"poems":[[55,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[55,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[65,"عرضت ناشئة المزن لنا","https://www.aldiwan.net/poem46104.html","الرمل"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[88,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[90,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[53,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[53,"للحريثي نكهة","https://www.aldiwan.net/poem66535.html","مجزوء الخفيف"],[93,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[91,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[87,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[47,"قد ترى دارسات الرسوم","https://www.aldiwan.net/poem65654.html","الخفيف"],[60,"إنما نعمة دنيا متعة","https://www.aldiwan.net/poem31007.html","الرمل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[50,"يا ابنة الشيخ اصبحينا","https://www.aldiwan.net/poem65280.html","مجزوء الرمل"],[48,"إنما نحن في ضلال وتعلي","https://www.aldiwan.net/poem22218.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85321","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85470","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[102,"البعث العربي","https://www.poetsgate.com/ViewPoem.aspx?id=50164",""],[53,"للحُريثيِّ أبي بكرٍ غَبَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=27034",""],[186,"أيها النائح المبكر مهلا","https://www.aldiwan.net/poem67040.html","الخفيف"],[333,"هذه الليلة من عمر الخلود","https://www.aldiwan.net/poem55022.html","الرمل"],[342,"إنما نحن مثل خامة زرع","https://www.aldiwan.net/poem45321.html","الخفيف"],[348,"إنما جاري لعمري","https://www.aldiwan.net/poem24177.html","مجزوء الرمل"],[396,"ضاعت الأعمار في قيل وقال","https://www.aldiwan.net/poem54510.html","عموديه"],[469,"يا بني الدنيا رويداً","https://www.aldiwan.net/poem3123.html","عموديه"],[495,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[500,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[500,"وأبى الدهر لقد جذذ","https://www.aldiwan.net/poem10234.html","مجزوء الرمل"],[500,"قسماً لا زعزع الشيب","https://www.aldiwan.net/poem10237.html","مجزوء الرمل"],[510,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[543,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[563,"ربما يكذب حسادي علي","https://www.aldiwan.net/poem33569.html","الرمل"],[563,"إنما نحن ربنا في شئونه","https://www.aldiwan.net/poem33689.html","المديد"],[563,"إنما نحن للإله شئون","https://www.aldiwan.net/poem33829.html","المديد"],[563,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[567,"أخذت نحوي سبيلا","https://www.aldiwan.net/poem52909.html","مجزوء الرمل"],[567,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122650","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48548","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48822","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70728","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96714","الرمل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72280","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72268","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133761","الرمل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90635","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74992","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69413","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108423","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27423","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27850","الرمل"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105652","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106849","الخفيف"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17377","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100887","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130790",""],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93333","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205781","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109778","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101610","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87378","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109916","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216790","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117967","الخفيف"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132062","الخفيف"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86543","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29330","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111454","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111422","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52140","الرمل"],[4684,"الطائر المهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=201382",""],[4767,"السيرة العظيمة","https://www.poetsgate.com/ViewPoem.aspx?id=204762",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[243,"أعاصير","https://www.poetsgate.com/ViewPoem.aspx?id=50473",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5701,"إنما نحن في زمان عجيب","https://www.poetsgate.com/ViewPoem.aspx?id=164624",""],[5725,"أملأ القلب مفرحات ونبلا","https://www.poetsgate.com/ViewPoem.aspx?id=213017",""],[5956,"نوع احتياجي","https://www.poetsgate.com/ViewPoem.aspx?id=181892",""],[5956,"دائماً صهيون تنجو من العقاب","https://www.poetsgate.com/ViewPoem.aspx?id=192311",""],[5956,"أوَ ما نخجل من أنفسنا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194418",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""]],"verses":[["إِنَّما نَلبَسُ الدُروعَ ثِقالاً","لِرُجوعٍ إِلى خِفافِ الشُفوفِ",0,"ف",1,0],["إِنَّما نَحنُ مُشبِهوكَ وما الأَش","بالُ إِلّا طَبائِعُ الآسادِ",1,"د",1,0],["إنّما نَحنُ بُدورٌ وَكَذا","شِيمَةُ البَدْرِ مَغِيبٌ وَطُلوعُ",2,"ع",1,0],["إِنَّما نَحنُ كَشَيءٍ فاسِدٍ","فَإِذا أَصلَحَهُ اللَهُ صَلَح",3,"ح",1,0],["إِنَّما نَحنُ وَالحَمامُ سَواءٌ","لَم تُغادِر أَطواقُنا الأَجيادا",4,"د",2,0],["إِنما نَحْنُ هَذَا لا مَلامٌ","وَصَريحُ العِرْفَانِ فِينا المُلِيمُ",5,"م",1,0],["إنما نحن مصلحون وما إن","غاية الامصلحين إلاّ الرفاء",6,"ا",2,0],["إنما ناك قديماً أختَهُ","ففَخارُ الوغدِ في هذا السَبَبْ",7,"ب",1,0],["إنما نحنُ في كني","فٍ إذا كان عندنا",8,"ن",2,0],["إِنَّما نَفسي الَّتي مَلَتِ العُم","رانَ مَلَّت في الغابِ صَمتَ الغابِ",9,"ب",1,0],["ان ما ناله الردى من حياتك","لم ينله للعجز من كلماتك",10,"ك",1,0],["انما نهضة الامم","هي من يقظة الهمم",11,"م",1,1],["إنما نحن مسلمين وقبطا","أمة وحِّدت على الأجيال",12,"ل",1,0],["إِنَّما نَحمَدُ الفَعالَ مِنَ الحُرِّ","إِذا ما اِستَلامَ فِعلَ المُليمِ",13,"م",1,0],["إِنَّما نِعمَةَ دُنيا مُتعَةً","وَحياةُ المَرءِ ثَوبٌ مُستَعار",14,"ر",1,1],["إنما نِلتَ بالمساءةِ منه","والداً مُدبِراً وشيخاً ضريرا",15,"ر",2,0],["إِنَّما نَشرَبُ مِنها","فَاِعلَمي ذاكَ يَقينا",16,"ن",2,0],["إِنَّما نَحنُ في ضَلالٍ وَتَعلي","لٍ فَإِن كُنتَ ذا يَقينٍ فَهاتِه",17,"ت",2,1],["إنما نحن ساكِنون بأرض","هي أدنى مراتب الإيجاد",18,"د",1,0],["إنما نحن في العراق بعصرٍ","يَتَسامى فيه الفَتى بالخداع",19,"ع",1,0],["أَنما ناموس الوراثة في الأح","ياء أن تتبع الفروع الأصولا",20,"ل",2,0],["إِنَّمَا نُزِّلَتْ علَيهِ انفِراداً","كَلِمَاتُ الهُدَى فكَانَ الطُّورُ",21,"ر",1,0],["إِنَّمَا نَحْنُ فِي الْحياةِ إِلَى","حِينٍ شَبَاباً وَفِتْيَةً وَكُهُولاَ",22,"ل",2,0],["إنّما نحن أمّة تبذل الأر","واح في ذمّة العلا والخلود",23,"د",1,0],["إنما ناك قديماً أختَهُ","ففَخارُ الوغدِ من هذا السَبَبْ",24,"ب",1,0],["إِنَّما نَحنُ ثاكِلٌ وَصَريعٌ","ذاكَ يَشقَى وَذاكَ في التُربِ يَبلى",25,"ل",2,0],["إنما نحنُ على ال","دنيا صباحٌ وسناه",26,"ه",1,0],["إِنَّما نَحنُ مِثلُ خامَةِ زَرعٍ","فَمَتى يَأنِ يَأتِ مُحتَصِدُه",27,"ه",1,1],["إِنَّما ناقَةُ جاري","في جِواري وَظِلالي",28,"ل",2,0],["إنما نجزي بما تعمل فكن","بالذي ينفعك ياذاذا اشتغال",29,"ل",1,0],["إنما نولد للمو","ت ونبني للخراب",30,"ب",1,0],["إِنَّما نِعمَةُ قَومٍ مُتعَةٌ","وَحَياةُ المَرءِ ثَوبٌ مُستَعارُ",31,"ر",1,0],["إنما نحن إلى الآ","جال نغْدو ونروح",32,"ح",1,0],["إنما نحن لأحداث ال","ردى ماء ومرعى",33,"ع",2,0],["إنما نحن من الأي","ام إعطاءً ومنعا",33,"ع",2,0],["إنما نحن من الده","ر بواد ذي سباع",34,"ع",1,0],["إنّما نحنُ في حياةٍ بها لا","ينفعُ المرءَ غيرُهُ في الشّدادِ",35,"د",1,0],["إِنَّما نَحنُ فِي الحَقِيقَةِ جِسمٌ","حَلَّ فِيه الباشَا رُوحاً أمِينا",36,"ن",2,0],["إنما نحن وأنتم خلقه","وهو مولى في يديه كل شي",37,"ي",1,0],["إنما نحن ربنا في شئونِهْ","ناظرتٌ عيوننا بعيونِهْ",38,"ن",2,1],["إنما نحن للإله شئونُ","فهو فينا في كل يوم يكونُ",39,"ن",1,1],["إنما نحن واحد نتجارى","في بحار الوجود كالموجات",40,"ت",1,0],["إنَّما نحنُ نَباتٌ","يَنقضِي جِيلاً فجِيلا",41,"ل",2,0],["إنما نحنُ في اختِلافِ عُقولٍ","مِثلَما نحنُ في اختلافِ وُجوهِ",42,"ه",1,0],["إنما نائبُ الوزير وزيرٌ","قامَ بالفضل وهْو لا يدَّعيهِ",42,"ي",2,0],["إنما نَشوَتي بما في ثَنايا","كِ مِنَ الرّاح لا بِما في الكاس",43,"س",1,0],["إنما نفسك في جس","مك لا ترضى انتقالا",44,"ل",2,0],["إن ما نلتموه وهو عظيمٌ","لقوام الباقي من الأوطار",45,"ر",1,0],["إنما نظمُ قريضى","مثلُ دُرٍّ في نظام",46,"م",1,1],["إنّما نوحُ الحمام","منهُ قد حمّ حمامِ",47,"م",1,1],["إنما نطعم الطعام لوجه اللّه","لا نبتغي لديكم شكورا",48,"ر",2,0],["إِنما نطعم الطعام لوجه","اللّه لا للجزاء في العاجلاتِ",49,"ت",1,0],["إنما نحمل رياك إلى","آخر الدهر ولو فيك عصانا",50,"ن",2,0],["إنَّ ما نَوَّلتَنِي منكَ","وإن قلَّ كثيرُ",51,"ر",1,0],["إنما نفس أحمد بين جنبي","ه تجلت فمن رأه رأها",52,"ا",3,0],["إنَّما نعمة من اللَه أَبدَت","واِستَنارَت بها القلوب جهارا",53,"ر",2,0],["إِنَّما نَحنُ في نَعيمٍ مِن اللَ","هِ وَمِن كُلِّ حادِثٍ في أَمانِ",54,"ن",1,0],["انما نور الرجا اشرق في","ظلمات اليأس مثل الكوكب",55,"ب",1,0],["إنما نحن عبيدٌ كلنا","عندنا وعندهم ليس كما",56,"م",2,0],["إنما نحن لها","في الوجود فدعي",57,"ع",2,0],["إنما نحن عالم ليس يرقى","فيه إلا نوابه الأفهام",58,"م",1,0],["إنما نحن في زمانٍ حفيلٍ","بالضلالاتِ في الرجال الهداة",59,"ه",1,0],["إِنَّما نَشرَبُ مِن أَموالِنا","فَسَلوا الشُرطِيَّ ما هَذا الغَضَب",60,"ب",1,0],["إنما نحن فى ربيع من العيش","وفي أنجمٍ من الأفكار",61,"ر",1,0],["انما نحن قد الفنا حضيض ال","هون حتى أودي بنا تنكيلا",62,"ل",2,0],["إِنَّما نَحنُ في مَجالسِ لَهوٍ","نَشرَبُ الراحَ ثُمَّ أَنتَ مُواتِ",63,"ت",1,0],["إنما نحن رفقة من كرام ال","طير خفت على جناح الحنين",64,"ن",1,0],["انما نحن هيكل واختلا","ف الاسم وهم فكلنا اعضاء",65,"ا",2,0],["إنما نلمح الصفاء عليه","لمحةً والصفاء في العيش لمح",66,"ح",1,0],["إنَّما نحن وَالنَباتُ عَلى حَدٍّ","سَوا وَالخَريفُ يَتلو الرَبيعا",67,"ع",2,0],["إِنما نُورُ الهُدى يَنفِي الضَلال","فالدجى يُجلى إذا الصبح جشر",68,"ر",1,0],["ان مانَ لا تَشكُوا وإِمَّا مالَ لا","تَتَحسَّروا فالغدرُ من عاداتِهِ",69,"ت",2,0],["إنما نحن في ضلال من الأم","ر وليس الجمال بالضلّيل",70,"ل",1,0],["إنما نلت سنة الدهر في من","رشحتهم أحسابهم للمعالي",71,"ل",2,0],["إنما نحن بين ظفر وناب","من خطوب أسودهن ضِراء",72,"ا",2,0],["إن مان يوماً في المقال فكذبه","متلقن عن مخبر كذاب",73,"ب",1,0],["إِنَّما نَحنُ كَركَبٍ ضَلَّ في","تيهِ صَحراءَ بِقَومٍ تائِهين",74,"ن",1,0],["إِنَّما نَحنُ نَجدَةٌ وَعَلَينا","أًَنتَ أَلقَيتَ كُلَّ ثِقلِ المَنُونِ",75,"ن",1