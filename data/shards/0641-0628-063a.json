{"poems":[[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[82,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[42,"ألم ينس ليلى عهدك المتباعد","https://www.aldiwan.net/poem42299.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/200108","الطويل"],[147,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[147,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[170,"وفت السعود بوعدها المضمون","https://www.aldiwan.net/poem46843.html","الكامل"],[371,"فبغا يقوم على أربع","https://www.aldiwan.net/poem17378.html","المتقارب"],[398,"يا أبا الفضل لم تأخرت عنا","https://www.aldiwan.net/poem53403.html","الخفيف"],[409,"مثلي بهذا منك لا يرضى","https://www.aldiwan.net/poem33696.html","الكامل"],[447,"ألا مبلغ عني بشير بن جمعة","https://www.aldiwan.net/poem14425.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48632","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77477","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101029","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53116","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67258","الرمل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83214","المتدارك"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201306","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125801","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120527","الكامل"],[4680,"أبا خالدٍ أنت صوت العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185025",""],[4680,"وبغداد بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=207429",""],[5302,"يلومني الخراص","https://www.poetsgate.com/ViewPoem.aspx?id=204915",""],[5431,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=186521",""],[5701,"أخي يا أخا الآيات في الشعر والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=164601",""]],"verses":[["فبغاثُها مستنسِرٌ وشرارُهَا","نارٌ تُشَبُّ ودودُهَا تِنِّينُ",0,"ن",1,0],["فَبِغامُ الرِئمِ حلاوَتُهُ","وجزالتُه زَأرُ الأسدِ",1,"د",1,0],["فَبُغتُ بِسَأوي الزَعفَرانَ فَلَم أَرِم","مَعَ القَومِ حَتّى لَم تُخِفني المَراصِدُ",2,"د",1,0],["فبغداد من مصر إذا رمت ثروة","لدى أهلها والري من همذان",3,"ن",1,0],["فَبَغَيتُ مِنها ما يُعَدُّ قَلائِداً","وَصَدَفتُ عَمّا عُدَّ في الأَغلالِ",4,"ل",1,0],["فَبَغَت مَطالِعَكَ المُلوكُ فَقَصَّرَت","وَرَأى وَقائِعَكَ الزَمانُ فَأَحجَما",5,"م",2,0],["فبَغى وألسنةُ القَنا يُنْذرْنَهُ","برحىً لحِبّاتِ القلوب طَحونِ",6,"ن",1,0],["فَبَغّا يَقومُ عَلى أَربَعٍ","وَما هُوَ مِن ذا البِغاءِ الوَلاشي",7,"ش",2,1],["فَبِغُصن الشَبابِ لما تَثَنّى","وَبِعَهد الصِبا وَان بِان مِنّا",8,"ن",2,0],["فبغير هذا نفسه ألفت","ورأت ظلال رياضها رَمْضَا",9,"ض",2,0],["فبغض لجمع المال فوق معاشه","وحب لشرح الكتب من حيث تشرح",10,"ح",1,0],["فبغت على جاراتها","طوع الأماني الكواذبْ",11,"ب",1,0],["فَبَغلة الأَثقالِ سارَت في خَرَس","وَبَغلةُ الأَموالِ رَنَّت بِالجَرَس",12,"س",1,0],["فبغور وادي النيل كل منضر","للعيش فيه غرة وحجول",13,"ل",1,0],["فبغازي بن يوسف الملك الظاهر","من جور صرفه أستجير",14,"ر",1,0],["فبغير الكأسِ لم اُفتَتن","فغدا يملأ من إبريقهِ",15,"ه",1,0],["فَبِغَزلِ بَنيهِ أَقي جَسَدي","أَشريهِ بِمُرتَفِعِ الثَمَنِ",16,"ن",1,0],["فبغضك لي في البعد ليس بمزعج","لنفسيَ يوماً مثلَ حبّك من قرب",17,"ب",1,0],["فَبِغالي إِذا اِسْبَطَرَّتْ وَغِلما","ني وَما أَثمرَت خِصي غِلماني",18,"ن",2,0],["فبغوا فجازاهم بما هم أهله","هذا النعيم فهل هم الماعون",19,"ن",1,0],["فبغيث ملهوفا وينعش ضارعا","وينيل ما لا طارفا وتليدا",20,"د",2,0],["فبغداد حين تجور الخطوب","عليها تُحطّمُ أغلالها",21,"ل",3,0],["فبغداد بغداد أمّ الرجال","يصيح الردى ذاهلاً يالها",22,"ل",3,0],["فبغضك لا يخفى ولؤمك بين","ودربك أشواك وبيتك واجذ",23,"ذ",1,0],["فبغداد الحضارة في مداها","تدور الفلك فيها أو تروح",24,"ح",1,0],["فبغداد خير من سواها وإن يكن","بها ما بكل الشرق من محن الدهر",25,"ر",1,0]]}