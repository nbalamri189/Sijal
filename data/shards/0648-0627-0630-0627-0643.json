29","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83595","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28683","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28626","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35448","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120193","الكامل"],[4679,"يا لقومي ما الدين لبس حريرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=142772",""],[4755,"بَينَ الكَلامِ وأَهلِهِ سِرُّ","https://www.poetsgate.com/ViewPoem.aspx?id=198399",""],[4755,"لا غائِمٌ أُفُقِي, ولا صَحْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=202891",""],[4902,"مريض اللي فقد \"سلطان\"","https://www.poetsgate.com/ViewPoem.aspx?id=22951",""],[182,"قِف بِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=72803",""],[5050,"خفف العذل عن محب تصامم","https://www.poetsgate.com/ViewPoem.aspx?id=38204",""],[5168,"لا تصدك","https://www.poetsgate.com/ViewPoem.aspx?id=33623",""],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5185,"انتباه","https://www.poetsgate.com/ViewPoem.aspx?id=73863",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5392,".. للقافياتِ عيون","https://www.poetsgate.com/ViewPoem.aspx?id=132112",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5536,"صرح فرعون!!","https://www.poetsgate.com/ViewPoem.aspx?id=27509",""],[470,"الموجَعَة","https://www.poetsgate.com/ViewPoem.aspx?id=178092",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5587,"قَلْبِي عَلِيلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190229",""],[5756,"قالها حامد","https://www.poetsgate.com/ViewPoem.aspx?id=5429",""],[5756,"وش اللي يجبر الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=5428",""],[5756,"صح النوم","https://www.poetsgate.com/ViewPoem.aspx?id=5437",""],[469,"عادَ من عيد وصلهِ ما تولَّى","https://www.poetsgate.com/ViewPoem.aspx?id=76835",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5997,"جائحة","https://www.poetsgate.com/ViewPoem.aspx?id=214297",""],[6115,"ماكل من ينتخي ويقال له ونعم","https://www.poetsgate.com/ViewPoem.aspx?id=180487",""],[5309,"يحسب المرء في ربيع شبابه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573878",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[520,"هل لميعادك الكريم تمام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577695",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""],[6249,"أفّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85663&r=&rc=6",""]],"verses":[["وَإِذا كَشَّفتُ ما يُرمِضُني","مِن مَضيضِ الداءِ قالَ الحِلمُ غَطّ",0,"ط",1,0],["وإذا كِتابُ اللهِ أثْنَى مُفْصِحاً","كان القُصورُ قُصارَ كُلِّ فَصيحِ",1,"ح",1,0],["وإذا كتاب اللهِ يتلو حمدهم","أودى القصور بمِنّةِ الأشعارِ",2,"ر",1,0],["وإذا كان في البلاد ثراء","فبفضل الأنتاج والأبدال",3,"ل",1,0],["وَإِذا كُنتَ يا اِبنَ عَمّي قَنوعاً","بِجَوابي قَنِعتَ بِالمَيسورِ",4,"ر",1,0],["وإذا كنت لا تُؤَثِّل إلا","درهماً جائزاً على البُصراءِ",5,"ا",2,0],["وإذا كان شاهدي بَضعةً منْ","ك فحسبي أمِنتُ أن تستريبا",6,"ب",2,0],["وإذا كادت الأعا","لي تُلاقي الأسافلا",7,"ل",2,0],["وَإِذا كان وَما فيهِ جَزاءٌ أَو خَسارَه","دَلِمَ الأَسماءُ إِثمٌ أَو صَلاحٌ لَستُ أَدري",8,"ي",1,0],["وَإِذا كَتَبتَ فَفي الطُروسِ حَدائِقٌ","وَشّى حَواشيها اليَراعُ وَنَمنَما",9,"م",2,0],["وَإِذا كَتَبتَ عَساكَ تَذ","كُرُني وَلو في الحاشِيَه",10,"ي",2,0],["وَإِذا كانَ لَكَ اللَ","هُ فَلا تَسأَل سِواهُ",11,"ا",2,0],["وَإِذا كُنتُمُ مِنَ اللَهِ في خَي","رٍ وَفي نِعمَةٍ فَذاكَ مُرادي",12,"د",2,0],["واذا كان المرء يفعل مضطرا","فان الجناة غير جناة",13,"ه",1,0],["واذا كنت من هواة الخرافا","ت فلا تستفيد من نظراتي",13,"ت",2,0],["واذا كانت حاجة لي الى ها","د فيا عقل انت ذاك الهادي",14,"د",2,0],["واذا كان للفقيد بقلب","خافق مثوى فهو غير فقيد",15,"د",1,0],["واذا كان الروح ليس بفان","فافدنا علما بذاك مبينا",16,"ن",2,0],["واذا كان الدهر ذا دوران","لم تكن سابقا ولا مسبوقا",17,"ق",2,0],["واذا كنت لي ترين جناحا","فاذكريه يغسله دمعي فيذهب",18,"ب",1,0],["وإذا كان في الطباع ولم تحس","ن فما أنت بالغ فيه حسنا",19,"ن",2,0],["وَإِذا كانَتِ العُقولُ كِباراً","سَلِمَت في المَضايِقِ الأَجسامُ",20,"م",1,0],["وَإِذا كانَ في الأَنابيبِ خُلفٌ","وَقَعَ الطَيشُ في صُدورِ الصِعادِ",21,"د",1,0],["وَإِذا كانَتِ النُفوسُ كِباراً","تَعِبَت في مُرادِها الأَجسامُ",22,"م",1,0],["وَإِذا كَسَرنَ جُفونَهُنَّ نَظَرنَ مِن","مَرضى يَشُفُّكَ سِحرُهُنَّ صِحاحِ",23,"ح",1,0],["وَإِذا كَتَبتُ مُعَذِّراً لَم يُعطِني","صَدرُ الكِتابِ رِضاً وَلا العُنوانُ",24,"ن",1,0],["وَإِذا كِلابُ بَني المَراغَةِ رَبَّضَت","خَطَرَت وَرائي دارِمي وَجِماري",25,"ر",2,0],["وإذا كانَتِ الجواهِرُ للزِّي","نَةِ كانَتْ جَواهِرَ الأرزاقِ",26,"ق",1,0],["وإذا كاشفَ العدوُّ فأبَدى ال","غِمْرَ أو دَبَّ في ظَلامِ النِّفاقِ",27,"ق",1,0],["وإذا كانَ مِئزَرُ الكَفَلِ النَّه","دِ عدوّاً لطرْفِك الطَّماحِ",28,"ح",1,0],["وَإِذا كَبِرتَ فَهَل لِنَفسِكَ لَذَّةً","ما لِلكَبيرِ بِلَذَّةٍ مُستَمتِعُ",29,"ع",1,0],["وَإِذا كانَ عارِضُ المَوتِ سَحّاً","خَضِلاً بِالرَدى أَجَشَّ هَزيما",30,"م",2,0],["وَإِذا كَفُّ راغِبِ سَلَبَتهُ","راحَ طَلقاً كَالكَوكَبِ المَشبوبِ",31,"ب",1,0],["وإذا كنتُ في هواك مسيئاً","فمديحُ الوزيرِ كالتكفيرِ",32,"ر",1,0],["وإذا كانَ في ودادكِ نقصٌ","فبمدحِ الوزير تمَّ سروري",32,"ر",2,0],["وإذا كان القطْع وَالوصلُ لل","هِ تَسَاوَى التَّقْرِيبُ وَالإِقْصاءُ",33,"ا",2,0],["وَإذا كانَ مِثْلُ ذَاك على الوا","رِثِ إنيَ عَبْدٌ لِعَبْدِ الشَّكُورِ",34,"ر",1,0],["وإذا كنتَ نُصرَةً لِيَ فِيما","أَرْتَجِيهِ فَذَاكَ عَيْنُ سُؤَالِي",35,"ل",2,0],["وإذا كانَتْ صلاةٌ فَعَلى","هاشِمِ البطحاءِ أربابِ العِباد",36,"د",1,0],["وَإِذا كَتَبتُ إِلَيهِ أَش","كو لَم يَجُد بِجَوابِ كُتبي",37,"ب",2,0],["وَإِذا كانَ قِطافٌ","وَتَوَقَّعتَ العُصارا",38,"ر",2,0],["وَإِذا كَلَّمتُهُ واحِدَةً","هَيَّجَت مِنهُ عُلالاتِ الطَرَب",39,"ب",1,0],["وَإِذا كانَ ما يَقولونَ في عي","سى صَحيحاً فَأَينَ كانَ أَبوهُ",40,"ب",3,0],["وإذا كان منه كفري وإيما","ني فإن الجزاءَ شيءٌ نكير",41,"ر",1,0],["وإِذا كان نزيهاً","كأَغاريد الطيورِ",42,"ر",1,0],["وإذا كانَت الخصوم كثاراً","لَم يكن ذا جَدوى دفاعُ الشجاع",43,"ع",1,0],["وإذا كان ذلك العشبُ خفضا","وهو يهتزّ هزّة المرتاع",44,"ع",1,0],["وإذا كان راضياً بقضاهم","فاشكروهم لأجل ما عذبوه",45,"ب",3,0],["وإذا كان ساخطاً بأذاهم","فاعبدوهم لأنهم غلبوه",45,"ب",3,0],["وَإِذَا كُلُّ وَلاءٍ عَامِرٍ","تَحْتَهُ مَفْسَدَةٌ تَحْفُرْ حَفْرَا",46,"ر",2,0],["وإذا كان عمرهُ بعضَ يومٍ","وتمشّى الذبولُ في ورقاتِه",47,"ت",2,0],["وَإِذا كانَ الفَتى خَلفاً","فَحُلى أَجدادِهِ جُدُدُ",48,"د",1,0],["وإذا كرّم الرجالُ ابن توفي","قٍ فقد كرّموا النبوغَ لذاته",49,"ت",2,0],["وإذا كبا، فعلى يديك نهوضُهُ","وإذا تأوَه، كنت خير أُسَاتِهِ",50,"ت",2,0],["وأذاك .؟ مستكثر اللحضه عقب غيبه.....؟","ترى أول العمر لحضه.؟ وأخره..؟ لحضه",51,"ض",2,0],["وأذاك.. ناسي..؟؟؟؟؟؟؟ تراها عندي الصوره...","أقفيت تضحك.. وأنا..غصتني.. العبره.",52,"ر",2,0],["واذاك متحمس متاهات وطروق","أنا تعبت أشد حيلي وأحاولك",53,"ك",1,0],["وإِذا كَتَبْتُ مُعَذِّراً لم يُعْطِني","صَدْرُ الكِتَابِ رِضًى ولا العُنْوَانُ",54,"ن",1,0],["وإذا كنت نازلا بمكان","فهو موبوء ليس فيه سلام",55,"م",1,0],["وإذا كانت العقولُ كِباراً","ولو أنّ المحاصرين الأنام",56,"م",1,0],["وإذا كانت القعولُ كباراً","سلمت في المضايق الأجسام",56,"م",1,0],["وإذا كان وعد بعد وصد","تلق في الحال وعدها مأتيا",57,"ي",2,0],["وإذا كنتَ ذا جَمالِ ومالِ","وشبابِ ونجْدَةٍ وعَلاءِ",58,"ا",2,0],["وإذا كنتَ يا بُنَيَّ فقيراً","غيرَ مُثْرِ فاخطُبْ من النُّظَرَاءِ",58,"ا",2,0],["وإذا كنتَ ذا مَشيبٍ وفَقْرٍ","فعَجُوزاً وَلَّى بغير مِراءِ",58,"ا",2,0],["وإذا كنتَ ذا مَشيبٍ غِنيّاً","فَطَمَاعِيَّةُ النسا في الثّرَاءِ",58,"ا",2,0],["وإذا كان فيك نَشرٌ كريهٌ","من فَمٍ أو أنفٍ من الأدْوَاءِ",58,"ا",2,0],["وإذا كان مورد الماء عذباً","ليس بدعاً عليه أن يتصادم",59,"م",1,0],["وإذا كبا في محفل وإذا احتبى","أبصرته كاليم جاوز يذبلا",60,"ل",2,0],["وإِذَا كَانَ لِلإِلاهَ مَرَادِي","لاَ أُبالي مِن مِيتَةٍ لاَ أُبَالِي",61,"ل",2,0],["وَإِذا كانَ في السُلوِّ شِفاءٌ","فَقَليل سلوُّنا في شِفاها",62,"ا",3,0],["وإذا كنت صحيحَ الذاتِ لا","تَقرعِ السنَّ على مالٍ سقيم",63,"م",1,0],["وإذا كانَ في الرؤوسِ ضلالٌ","وقفتْ عندَ قصدها الأقدامُ",64,"م",1,0],["وإذا كانَ للخطيئةِ عذرٌ","أيُّ عذرٍ لمخطئٍ في التمادي",65,"د",2,0],["وإذا كانَ بينَ قومٍ ودادٌ","لم يخنهْ في القومِ غيرُ الأخَسِّ",66,"س",1,0],["وإذا كان من العلمِ شقا","فنعيمُ المرء في أن يجهلا",67,"ل",2,0],["وإذا كانت الأمور بمقدا","ر فحرص الفتى عليها شقاء",68,"ا",2,0],["وَإِذا كَتَمتُ السِرَّ با","حَ بِسِرِّهِ دَمعٌ نَمومُ",69,"م",1,0],["وإذا كنت هكذا فلقلبي","في سما حبّه مراقي العروج",70,"ج",1,0],["وَإِذا كانَ مِثلَ ما قُلتُ كَيفَ ال","حالُ يَخفى عَلَيهِ كُلّاً وَبعضا",71,"ض",2,0],["وَإِذا كنت الشَفيع غدا","لِلوَرى فالقاسميّ سمى",72,"م",2,0],["وَإِذا كُنْتَ لِي عَلَى الدَّهْرِ عَوناً","فَمُحالٌ أَنْ يُمْكِنُ الدَّهْرَ ظُلْمِي",73,"م",2,0],["وإذا كانت الحياةُ هي الدا","ءَ المعنىِّ فقد عدِمنا الشفاءَ",74,"ا",2,0],["وَإِذا كانَ ظُلمُ الناسِ في النَفسِ كامِنا","فَما لي وَقَد خانوا أَنغَصَ عيشَتي",75,"ي",1,0],["وَإِذا كُنتَ تَتَّقي أَن يَرانا","أَحَدُ الناسِ خِلسَةً مِن شَرفَه",76,"ف",2,0],["وَإِذا كانَ في الوُجودِ كَرامُ","فَهُم مِنهُ قَطرَةً مِن غَمامَه",77,"م",2,0],["وَإِذا كُنتَ ذا أَناهٍ وَحِلمٍ","لَم تَطِر عِندَ طَيرَةِ الجُهّالِ",78,"ل",1,0],["وإذا كان المَودّاتُ جَناحاً","لم يكنْ أقدامُها إلاّ القُدامى",79,"م",2,0],["وإذا كان خِلْعةُ القَلْبِ منه","سُنّةً كان خِلْعُة الكَفِّ بِدْعه",80,"ع",2,0],["وإذا كنتِ قد رَحَلتِ بقَلبي","فاعلَمي أنَّ سرَّ حُبِّكِ فيهِ",81,"ه",1,1],["وإذا كنتُ مُقيماً خالِياً","من فؤادي فَمُقامِي ظَعني",82,"ن",2,0],["وإذا كانت الأصول كِراماً","باتضاعٍ يزينُها فتُهاب",83,"ب",1,0],["وإذا كانت النفوس كِباراً","تعبت في مرادها الأصحاب",83,"ب",1,0],["وإذا كرالهك ذكرا دائما أبدا","فالذكر بالذكر مقرون ومصحوب",84,"ب",1,0],["وإذا كُنتُ للكِرام غُلاماً","فأنا الحُرُّ والزَّمانُ غُلامي",85,"ي",1,0],["وإذا كنتَ لي قَعيداً فإنِّي","للنُّجومِ المُدَبِّراتِ قَعيدُ",86,"د",1,0],["وإذا كنت معافى سالما","في اعتلاء وسعود هان همي",87,"م",2,0],["وإذا كنتَ أطيبَ النَّاس فرعاً","كنتَ لا شك أطيبَ النَّاس أصلا",88,"ل",2,0],["وإذا كانتْ سماوات العُلى","فهُمُ منها سواريها السَّوامي",89,"م",2,0],["وإذا كنت معجبا","بمزاياك لاعجب",90,"ب",1,0],["وإِذا كنتُ بالأوانسِ مغرى","كيف يُرجى من اللِّحَاظِ خَلاصي",91,"ص",2,0],["وإذا كرّ كلامٌ شائِهٌ","مللا زدن على التكرير حُسنا",92,"ن",2,0],["وإذا كنت عَقْبَ مَيْتٍ فلم تع","فُ له آيةٌ ولم تَبلَ رِمَّهْ",93,"م",2,0],["وإذا كنت نازلاً سلَّم الل","ه على منزلٍ حللتَ وصلَّى",94,"ل",2,0],["وإذا كلابُ الحيّ أهدت طارقاً","جزعت عشار النوق من أصواتها",95,"ت",3,0],["وإذا كنتَ لا تحبُّ الأماني","فلماذا تهوى خيال الحبيب",96,"ب",1,0],["وإذا كان هزلهُ","قاتلاً كيف جدُّه",97,"د",2,0],["وإذا كلُّ سَعْيِه ِ بَدَ د ُ","شِعْرُه ُ،والدّروسُ، والوَلَد ُ",98,"د",1,0],["وإذا كانَ آخِرَ العُمْرِ مَوْتٌ","فسَواءٌ قَصيرُهُ والطَّويلُ",99,"ل",1,0],["وآذاكُمُو قلباً فذاك بحزْيِهِ","رَهينٌ عن الباري بعيدُ التَّقارُبِ",100,"ب",1,0],["وإذا كنت والياً بالسجايا","والعطايا فغيرك المعزول",101,"ل",1,0],["وَإذا كانَ مِنَ الْحَمْلِ على","شَبَهِ الشّيءِ وَنَحْوِ الْمَثَلِ",102,"ل",1,0],["وإذا كانت مديحاً","مُطرياً فيه وزيراً",103,"ر",2,0],["وإذا كنتَ على عِلمٍ به","فعلى قَتلِ الوَرى مَن حَمَلَك",104,"ك",1,0],["وإذا كُنتُ مُبتَلىً في مَغيبي","بِنُباحٍ من زُمرَةِ الأغمارِ",105,"ر",1,0],["وإذا كانتِ المُلاقاةُ ليلاً","فاللّيالي خيرٌ من الأيّامِ",106,"م",1,0],["وإذا كنتُ في يَفاعٍ من العِز","زِ منيفٍ على ذُرا الأحلامِ",107,"م",1,0],["وَإِذا كنتُ بالهوى ذا اِعوجاجٍ","فاِهنَ دوني بأن تكون قويما",108,"م",2,0],["وإذا كنتُ لا يطورُ بِيَ الذّم","مُ فما ضرّني مَنِ المذمومُ",109,"م",1,0],["وإذا كنتُ مرتضىً عند مَلْكِ النّا","سِ طُرّاً فمن يكون نديدي",110,"د",2,0],["وَإِذا كُنتَ لِي شراباً فما تُخ","دَعُ لي مُقلةٌ بلمْعِ سرابِ",111,"ب",1,0],["وَإِذا كَتَمتُ جَوى الأَسى بَعَثَ الهَوى","نَفَساً يَكونُ عَلى الضَميرِ دَليلا",112,"ل",2,0],["وإذا كنت هكذا فتأمل","من أنا يا أنا أسير أداته",113,"ت",2,0],["وإذا كان ساخطاً 