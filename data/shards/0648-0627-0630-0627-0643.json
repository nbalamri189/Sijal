.html","الخفيف"],[527,"الجواب الحق في هذا بلا","https://www.aldiwan.net/poem37268.html","الرمل"],[536,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[536,"دمت للفن ودام الفن لك","https://www.aldiwan.net/poem47968.html","عموديه"],[536,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[549,"ضن عني بالنزر إذ أنا يقظا","https://www.aldiwan.net/poem47194.html","الخفيف"],[549,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[549,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[549,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[549,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[549,"أعلى العهد منزل بالجناب","https://www.aldiwan.net/poem48064.html","الخفيف"],[551,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[556,"أنا عبد الغني أي عبد ذات ال","https://www.aldiwan.net/poem33518.html","الخفيف"],[556,"خادم الله يخدم العز بابه","https://www.aldiwan.net/poem33523.html","الخفيف"],[556,"كعبة الحسن أسفرت بالجمال","https://www.aldiwan.net/poem34228.html","الخفيف"],[556,"كيف يا قوم يوصف المخلوق","https://www.aldiwan.net/poem34317.html","الخفيف"],[556,"نشأة الروح بالغروب الطلوع","https://www.aldiwan.net/poem34385.html","الخفيف"],[556,"عالم النطق عالم الأنفاس","https://www.aldiwan.net/poem34442.html","الخفيف"],[556,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[556,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[556,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[556,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[585,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"]],"verses":[["وَإِذا كَشَّفتُ ما يُرمِضُني","مِن مَضيضِ الداءِ قالَ الحِلمُ غَطّ",0,"ط",1,0],["وإذا كِتابُ اللهِ أثْنَى مُفْصِحاً","كان القُصورُ قُصارَ كُلِّ فَصيحِ",1,"ح",1,0],["وإذا كتاب اللهِ يتلو حمدهم","أودى القصور بمِنّةِ الأشعارِ",2,"ر",1,0],["وإذا كان في البلاد ثراء","فبفضل الأنتاج والأبدال",3,"ل",1,0],["وَإِذا كُنتَ يا اِبنَ عَمّي قَنوعاً","بِجَوابي قَنِعتَ بِالمَيسورِ",4,"ر",1,0],["وإذا كنت لا تُؤَثِّل إلا","درهماً جائزاً على البُصراءِ",5,"ا",2,0],["وإذا كان شاهدي بَضعةً منْ","ك فحسبي أمِنتُ أن تستريبا",6,"ب",2,0],["وإذا كادت الأعا","لي تُلاقي الأسافلا",7,"ل",2,0],["وَإِذا كان وَما فيهِ جَزاءٌ أَو خَسارَه","دَلِمَ الأَسماءُ إِثمٌ أَو صَلاحٌ لَستُ أَدري",8,"ي",1,0],["وَإِذا كَتَبتَ فَفي الطُروسِ حَدائِقٌ","وَشّى حَواشيها اليَراعُ وَنَمنَما",9,"م",2,0],["وَإِذا كَتَبتَ عَساكَ تَذ","كُرُني وَلو في الحاشِيَه",10,"ي",2,0],["وَإِذا كانَ لَكَ اللَ","هُ فَلا تَسأَل سِواهُ",11,"ا",2,0],["وَإِذا كُنتُمُ مِنَ اللَهِ في خَي","رٍ وَفي نِعمَةٍ فَذاكَ مُرادي",12,"ي",1,0],["واذا كان المرء يفعل مضطرا","فان الجناة غير جناة",13,"ه",1,0],["واذا كنت من هواة الخرافا","ت فلا تستفيد من نظراتي",13,"ت",2,0],["واذا كانت حاجة لي الى ها","د فيا عقل انت ذاك الهادي",14,"ي",1,0],["واذا كان للفقيد بقلب","خافق مثوى فهو غير فقيد",15,"د",1,0],["واذا كان الروح ليس بفان","فافدنا علما بذاك مبينا",16,"ن",2,0],["واذا كان الدهر ذا دوران","لم تكن سابقا ولا مسبوقا",17,"ق",2,0],["واذا كنت لي ترين جناحا","فاذكريه يغسله دمعي فيذهب",18,"ب",1,0],["وإذا كان في الطباع ولم تحس","ن فما أنت بالغ فيه حسنا",19,"ن",2,0],["وَإِذا كانَتِ العُقولُ كِباراً","سَلِمَت في المَضايِقِ الأَجسامُ",20,"م",1,0],["وَإِذا كانَ في الأَنابيبِ خُلفٌ","وَقَعَ الطَيشُ في صُدورِ الصِعادِ",21,"د",1,0],["وَإِذا كانَتِ النُفوسُ كِباراً","تَعِبَت في مُرادِها الأَجسامُ",22,"م",1,0],["وَإِذا كَسَرنَ جُفونَهُنَّ نَظَرنَ مِن","مَرضى يَشُفُّكَ سِحرُهُنَّ صِحاحِ",23,"ح",1,0],["وَإِذا كَتَبتُ مُعَذِّراً لَم يُعطِني","صَدرُ الكِتابِ رِضاً وَلا العُنوانُ",24,"ن",1,0],["وَإِذا كِلابُ بَني المَراغَةِ رَبَّضَت","خَطَرَت وَرائي دارِمي وَجِماري",25,"ر",2,0],["وإذا كانَتِ الجواهِرُ للزِّي","نَةِ كانَتْ جَواهِرَ الأرزاقِ",26,"ق",1,0],["وإذا كاشفَ العدوُّ فأبَدى ال","غِمْرَ أو دَبَّ في ظَلامِ النِّفاقِ",27,"ق",1,0],["وإذا كانَ مِئزَرُ الكَفَلِ النَّه","دِ عدوّاً لطرْفِك الطَّماحِ",28,"ح",1,0],["وَإِذا كَبِرتَ فَهَل لِنَفسِكَ لَذَّةً","ما لِلكَبيرِ بِلَذَّةٍ مُستَمتِعُ",29,"ع",1,0],["وَإِذا كانَ عارِضُ المَوتِ سَحّاً","خَضِلاً بِالرَدى أَجَشَّ هَزيما",30,"م",2,0],["وَإِذا كَفُّ راغِبِ سَلَبَتهُ","راحَ طَلقاً كَالكَوكَبِ المَشبوبِ",31,"ب",1,0],["وإذا كنتُ في هواك مسيئاً","فمديحُ الوزيرِ كالتكفيرِ",32,"ر",1,0],["وإذا كانَ في ودادكِ نقصٌ","فبمدحِ الوزير تمَّ سروري",32,"ر",2,0],["وإذا كان القطْع وَالوصلُ لل","هِ تَسَاوَى التَّقْرِيبُ وَالإِقْصاءُ",33,"ا",2,0],["وَإذا كانَ مِثْلُ ذَاك على الوا","رِثِ إنيَ عَبْدٌ لِعَبْدِ الشَّكُورِ",34,"ر",1,0],["وإذا كنتَ نُصرَةً لِيَ فِيما","أَرْتَجِيهِ فَذَاكَ عَيْنُ سُؤَالِي",35,"ل",2,0],["وإذا كانَتْ صلاةٌ فَعَلى","هاشِمِ البطحاءِ أربابِ العِباد",36,"د",1,0],["وَإِذا كَتَبتُ إِلَيهِ أَش","كو لَم يَجُد بِجَوابِ كُتبي",37,"ي",1,0],["وَإِذا كانَ قِطافٌ","وَتَوَقَّعتَ العُصارا",38,"ر",2,0],["وَإِذا كَلَّمتُهُ واحِدَةً","هَيَّجَت مِنهُ عُلالاتِ الطَرَب",39,"ب",1,0],["وَإِذا كانَ ما يَقولونَ في عي","سى صَحيحاً فَأَينَ كانَ أَبوهُ",40,"ب",3,0],["وإذا كان منه كفري وإيما","ني فإن الجزاءَ شيءٌ نكير",41,"ر",1,0],["وإِذا كان نزيهاً","كأَغاريد الطيورِ",42,"ر",1,0],["وإذا كانَت الخصوم كثاراً","لَم يكن ذا جَدوى دفاعُ الشجاع",43,"ع",1,0],["وإذا كان ذلك العشبُ خفضا","وهو يهتزّ هزّة المرتاع",44,"ع",1,0],["وإذا كان راضياً بقضاهم","فاشكروهم لأجل ما عذبوه",45,"ب",3,0],["وإذا كان ساخطاً بأذاهم","فاعبدوهم لأنهم غلبوه",45,"ب",3,0],["وَإِذَا كُلُّ وَلاءٍ عَامِرٍ","تَحْتَهُ مَفْسَدَةٌ تَحْفُرْ حَفْرَا",46,"ر",2,0],["وَإِذا كانَ الفَتى خَلفاً","فَحُلى أَجدادِهِ جُدُدُ",47,"د",1,0],["وإذا كرّم الرجالُ ابن توفي","قٍ فقد كرّموا النبوغَ لذاته",48,"ت",2,0],["وإذا كبا، فعلى يديك نهوضُهُ","وإذا تأوَه، كنت خير أُسَاتِهِ",49,"ت",2,0],["وإذا كان عمره بعض يوم","وتمشى الذبول فى ورقاته",50,"ت",2,0],["وإِذا كَتَبْتُ مُعَذِّراً لم يُعْطِني","صَدْرُ الكِتَابِ رِضًى ولا العُنْوَانُ",51,"ن",1,0],["وإذا كنت نازلا بمكان","فهو موبوء ليس فيه سلام",52,"م",1,0],["وإذا كانت العقولُ كِباراً","ولو أنّ المحاصرين الأنام",53,"م",1,0],["وإذا كانت القعولُ كباراً","سلمت في المضايق الأجسام",53,"م",1,0],["وإذا كان وعد بعد وصد","تلق في الحال وعدها مأتيا",54,"ي",2,0],["وإذا كنتَ ذا جَمالِ ومالِ","وشبابِ ونجْدَةٍ وعَلاءِ",55,"ا",2,0],["وإذا كنتَ يا بُنَيَّ فقيراً","غيرَ مُثْرِ فاخطُبْ من النُّظَرَاءِ",55,"ا",2,0],["وإذا كنتَ ذا مَشيبٍ وفَقْرٍ","فعَجُوزاً وَلَّى بغير مِراءِ",55,"ا",2,0],["وإذا كنتَ ذا مَشيبٍ غِنيّاً","فَطَمَاعِيَّةُ النسا في الثّرَاءِ",55,"ا",2,0],["وإذا كان فيك نَشرٌ كريهٌ","من فَمٍ أو أنفٍ من الأدْوَاءِ",55,"ا",2,0],["وإذا كان مورد الماء عذباً","ليس بدعاً عليه أن يتصادم",56,"م",1,0],["وإذا كبا في محفل وإذا احتبى","أبصرته كاليم جاوز يذبلا",57,"ل",2,0],["وإِذَا كَانَ لِلإِلاهَ مَرَادِي","لاَ أُبالي مِن مِيتَةٍ لاَ أُبَالِي",58,"ي",1,0],["وَإِذا كانَ في السُلوِّ شِفاءٌ","فَقَليل سلوُّنا في شِفاها",59,"ا",3,0],["وإذا كنت صحيحَ الذاتِ لا","تَقرعِ السنَّ على مالٍ سقيم",60,"م",1,0],["وإذا كانَ في الرؤوسِ ضلالٌ","وقفتْ عندَ قصدها الأقدامُ",61,"م",1,0],["وإذا كانَ للخطيئةِ عذرٌ","أيُّ عذرٍ لمخطئٍ في التمادي",62,"د",2,0],["وإذا كانَ بينَ قومٍ ودادٌ","لم يخنهْ في القومِ غيرُ الأخَسِّ",63,"س",1,0],["وإذا كان من العلمِ شقا","فنعيمُ المرء في أن يجهلا",64,"ل",2,0],["وإذا كانت الأمور بمقدا","ر فحرص الفتى عليها شقاء",65,"ا",2,0],["وَإِذا كَتَمتُ السِرَّ با","حَ بِسِرِّهِ دَمعٌ نَمومُ",66,"م",1,0],["وإذا كنت هكذا فلقلبي","في سما حبّه مراقي العروج",67,"ج",1,0],["وَإِذا كانَ مِثلَ ما قُلتُ كَيفَ ال","حالُ يَخفى عَلَيهِ كُلّاً وَبعضا",68,"ض",2,0],["وَإِذا كنت الشَفيع غدا","لِلوَرى فالقاسميّ سمى",69,"م",2,0],["وَإِذا كُنْتَ لِي عَلَى الدَّهْرِ عَوناً","فَمُحالٌ أَنْ يُمْكِنُ الدَّهْرَ ظُلْمِي",70,"ي",1,0],["وإذا كانت الحياةُ هي الدا","ءَ المعنىِّ فقد عدِمنا الشفاءَ",71,"ا",2,0],["وَإِذا كانَ ظُلمُ الناسِ في النَفسِ كامِنا","فَما لي وَقَد خانوا أَنغَصَ عيشَتي",72,"ي",1,0],["وَإِذا كُنتَ تَتَّقي أَن يَرانا","أَحَدُ الناسِ خِلسَةً مِن شَرفَه",73,"ف",2,0],["وَإِذا كانَ في الوُجودِ كَرامُ","فَهُم مِنهُ قَطرَةً مِن غَمامَه",74,"م",2,0],["وَإِذا كُنتَ ذا أَناهٍ وَحِلمٍ","لَم تَطِر عِندَ طَيرَةِ الجُهّالِ",75,"ل",1,0],["وإذا كان المَودّاتُ جَناحاً","لم يكنْ أقدامُها إلاّ القُدامى",76,"م",2,0],["وإذا كان خِلْعةُ القَلْبِ منه","سُنّةً كان خِلْعُة الكَفِّ بِدْعه",77,"ع",2,0],["وإذا كنتِ قد رَحَلتِ بقَلبي","فاعلَمي أنَّ سرَّ حُبِّكِ فيهِ",78,"ه",1,1],["وإذا كنتُ مُقيماً خالِياً","من فؤادي فَمُقامِي ظَعني",79,"ي",1,0],["وإذا كانت الأصول كِراماً","باتضاعٍ يزينُها فتُهاب",80,"ب",1,0],["وإذا كانت النفوس كِباراً","تعبت في مرادها الأصحاب",80,"ب",1,0],["وإذا كرالهك ذكرا دائما أبدا","فالذكر بالذكر مقرون ومصحوب",81,"ب",1,0],["وإذا كُنتُ للكِرام غُلاماً","فأنا الحُرُّ والزَّمانُ غُلامي",82,"ي",1,0],["وإذا كنتَ لي قَعيداً فإنِّي","للنُّجومِ المُدَبِّراتِ قَعيدُ",83,"د",1,0],["وإذا كنت معافى سالما","في اعتلاء وسعود هان همي",84,"ي",1,0],["وإذا كنتَ أطيبَ النَّاس فرعاً","كنتَ لا شك أطيبَ النَّاس أصلا",85,"ل",2,0],["وإذا كانتْ سماوات العُلى","فهُمُ منها سواريها السَّوامي",86,"م",2,0],["وإذا كنت معجبا","بمزاياك لاعجب",87,"ب",1,0],["وإِذا كنتُ بالأوانسِ مغرى","كيف يُرجى من اللِّحَاظِ خَلاصي",88,"ي",1,0],["وإذا كرّ كلامٌ شائِهٌ","مللا زدن على التكرير حُسنا",89,"ن",2,0],["وإذا كنت عَقْبَ مَيْتٍ فلم تع","فُ له آيةٌ ولم تَبلَ رِمَّهْ",90,"م",2,0],["وإذا كنت نازلاً سلَّم الل","ه على منزلٍ حللتَ وصلَّى",91,"ل",2,0],["وإذا كلابُ الحيّ أهدت طارقاً","جزعت عشار النوق من أصواتها",92,"ت",3,0],["وإذا كنتَ لا تحبُّ الأماني","فلماذا تهوى خيال الحبيب",93,"ب",1,0],["وإذا كان هزلهُ","قاتلاً كيف جدُّه",94,"د",2,0],["وإذا كانَ آخِرَ العُمْرِ مَوْتٌ","فسَواءٌ قَصيرُهُ والطَّويلُ",95,"ل",1,0],["وآذاكُمُو قلباً فذاك بحزْيِهِ","رَهينٌ عن الباري بعيدُ التَّقارُبِ",96,"ب",1,0],["وإذا كنت والياً بالسجايا","والعطايا فغيرك المعزول",97,"ل",1,0],["وَإذا كانَ مِنَ الْحَمْلِ على","شَبَهِ الشّيءِ وَنَحْوِ الْمَثَلِ",98,"ل",1,0],["وإذا كانت مديحاً","مُطرياً فيه وزيراً",99,"ر",2,0],["وإذا كنتَ على عِلمٍ به","فعلى قَتلِ الوَرى مَن حَمَلَك",100,"ك",1,0],["وإذا كُنتُ مُبتَلىً في مَغيبي","بِنُباحٍ من زُمرَةِ الأغمارِ",101,"ر",1,0],["وإذا كانتِ المُلاقاةُ ليلاً","فاللّيالي خيرٌ من الأيّامِ",102,"م",1,0],["وإذا كنتُ في يَفاعٍ من العِز","زِ منيفٍ على ذُرا الأحلامِ",103,"م",1,0],["وَإِذا كنتُ بالهوى ذا اِعوجاجٍ","فاِهنَ دوني بأن تكون قويما",104,"م",2,0],["وإذا كنتُ لا يطورُ بِيَ الذّم","مُ فما ضرّني مَنِ المذمومُ",105,"م",1,0],["وإذا كنتُ مرتضىً عند مَلْكِ النّا","سِ طُرّاً فمن يكون نديدي",106,"د",2,0],["وَإِذا كُنتَ لِي شراباً فما تُخ","دَعُ لي مُقلةٌ بلمْعِ سرابِ",107,"ب",1,0],["وَإِذا كَتَمتُ جَوى الأَسى بَعَثَ الهَوى","نَفَساً يَكونُ عَلى الضَميرِ دَليلا",108,"ل",2,0],["وإذا كنت هكذا فتأمل","من أنا يا أنا أسير أداته",109,"ت",2,0],["وإذا كان ساخطاً قل سريعاً","إنما الله ساخطٌ فتشابه",110,"ب",2,0],["وإذا كنت عابداً فهي سلمى","لبست ثوبَ هيبة وكمال",111,"ل",1,0],["وإذا كان هكذا الأمر قل لي","كيف وصف الوجود فيه يليق",112,"ق",1,0],["وإذا كانت الذوات وجوداً","وكذاك الشخوص زالت فروق",112,"ق",1,0],["وإذا كان فعلها مثل برق","لامع في صدورها والرجوع",113,"ع",1,0],["وإذا كنت أنت والكل لا شي","ء فقل لي من أنت يا ابن الناس",114,"س",1,0],["وإذا كان جاحداً مسلماً في","ظاهر الشرع يلتقي تيسيرا",115,"ر",2,0],["وإذا كان في السواد بياض","لاح غير البياض في المعتاد",116,"د",1,0],["وإذا كنت ليس عندك فرق","بين لون الدجا ولون الصباح",117,"ح",1,0],["وإذا كنت جاهلاً فتوقى","حي ميت من هذه الأمواج",118,"ج",1,0],["وإِذا كسِلْتَ عن العُلا","فانْشَطْ لها صَهْباءَ بكْرَا",119,"ر",2,0],["وإِذا كان يشتكي فُرْقَةَ البَلْ","وى فماذا يقولُ في النَّعْمَاءِ",120,"ا",2,0],["وإذا كنت يوماً ذاكراً بفضيلة","ومنقبة يثني بها في المحاشد",121,"د",1,0]]}