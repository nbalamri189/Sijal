 النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[346,"حصل العز لها مذ خطبت","https://www.aldiwan.net/poem20702.html","الرمل"],[351,"حصنت وجه محمد بسميه","https://www.aldiwan.net/poem39750.html","الكامل"],[362,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[364,"حصن فجرت به للناس نهر ظبا","https://www.aldiwan.net/poem17224.html","البسيط"],[369,"طال الزمان وما ثناه ولا انثنى","https://www.aldiwan.net/poem57023.html","الكامل"],[374,"أذكرت مسكا من مديحك صائكا","https://www.aldiwan.net/poem59303.html","الكامل"],[374,"هذا التواضع إن أردت مواهبا","https://www.aldiwan.net/poem66936.html","الكامل"],[377,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[388,"حصحص الحق يا فلان بالمسير بالرحيل","https://www.aldiwan.net/poem54538.html","عموديه"],[397,"عندما يكون العتاب دليلاً على الحب","https://www.aldiwan.net/poem6750.html","عموديه"],[397,"أمام حجرة عائشة رضي الله عنها","https://www.aldiwan.net/poem6772.html","عموديه"],[400,"العلم في قول لا إله إلا الله","https://www.aldiwan.net/poem33366.html","البسيط"],[407,"وسدت بهارون الثغور فأحكمت","https://www.aldiwan.net/poem67500.html","الطويل"],[429,"أي نجم من أي شمس وبدر","https://www.aldiwan.net/poem12370.html","الخفيف"],[438,"ألا من لصب بالحجاز غريب","https://www.aldiwan.net/poem14297.html","الطويل"],[438,"قرعت على ليلى الشريفة بابها","https://www.aldiwan.net/poem14323.html","الطويل"],[438,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[456,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"صدق الوشاة العهد عندك ضائع","https://www.aldiwan.net/poem56138.html","الكامل"],[456,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[456,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[459,"عمت شهامته كما شملت","https://www.aldiwan.net/poem15608.html","أحذ الكامل"],[459,"أمنت فقري لما قلت عن ثقة","https://www.aldiwan.net/poem16050.html","البسيط"],[462,"جلت عزماتك الفتح المبينا","https://www.aldiwan.net/poem3115.html","عموديه"],[462,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[491,"حصلت من الهوى بك في محل","https://www.aldiwan.net/poem67349.html","الوافر"],[502,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[512,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[512,"حصن العلية بفخرك زاد فخر وسما","https://www.aldiwan.net/poem20931.html","المواليا"],[513,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[536,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[560,"أقول لعطفها عند النهوض","https://www.aldiwan.net/poem52931.html","الوافر"]],"verses":[["حِصاني كانَ دَلّالَ المَناي","فَخاضَ غُبارَها وَشَرى وَباعَ",0,"ع",1,0],["حصْحَصَ الحقُّ يا خَوَنْدُ فدَعْني","أنا راوَدْتُ يوسفاً عنْ نفسِهِ",1,"س",2,0],["حَصائِدُ أَلسُنٍ جَرَّت","إِلى الوَيلاتِ وَالحَرَبِ",2,"ب",1,0],["حَصَدَت مَناجِلُهُ غِراسَ رَجائِنا","وَلَو أَنَّها أَبقَت عَلَيهِ لَأَورَقا",3,"ق",2,0],["حَصانٌ وَما رَدَّت أَنامِلَ لامِسٍ","نَتوجٌ وَمِقلاتٌ وَما ضاجَعَت ذكَر",4,"ر",1,0],["حَصانٌ إِنِ التَقوى اِستَبَدَّت بِسِرِّها","فَمِن صالِحِ الأَعمالِ يُستَوضَحُ الجَهرُ",5,"ر",1,0],["حِصْنٌ يَذُودُ بِهِ عَنْ قَوْمِهِ بَطَلٌ","بِالحَقِّ مُعْتَضِدٌ بِالعَدْلِ مُعْتَصِمُ",6,"م",1,0],["حصباؤها لؤلؤ قد شفَّ جوهرها","والنهر قد سال ذوباً من لآليها",7,"ي",3,0],["حصون تستخفّ بكلّ طَوْدٍ","وتستعشي برؤيتها العيونا",8,"ن",2,0],["حَصانٌ لا المُريبُ لَها خَدينٌ","وَلا تُفشي الحَديثَ وَلا تَرودُ",9,"د",1,0],["حَصاناً رَزانَ الرِجلِ يَشبَعُ جارُها","وَتُصبِحُ غَرثى مِن لُحومِ الغَوافِلِ",10,"ل",1,0],["حَصانٌ رَزانٌ ما تُزَنُّ بِرَيبَةٍ","وَتُصبِحُ غَرثى مِن لُحومِ الغَوافِلِ",11,"ل",1,1],["حَصباؤُهُ جَوهَرٌ لَم تَدنُ مِنهُ يَدٌ","لَكَنَّهُ بِيَدِ الأَفهامِ مَنهوبُ",12,"ب",1,0],["حِصْرِمٌ من زَبرجدٍ بين نَبْعٍ","من يواقيت جمرُها غيرُ خابِ",13,"ب",1,0],["حَصَرْتَ عميدَ الزَّنْج حتَّى تَخَاذَلَتْ","قُواهُ وأَوْدَى زادُهُ المُتَزَوَّدُ",14,"د",1,0],["حَصَّلته هاشمياً لا نظير له","مِلْحاً وظرفاً وإن قال الخنا نفر",15,"ر",1,0],["حَصَّاءُ لا نبت في قفاها","ولم تزل لاستها ضفيره",16,"ر",2,0],["حصلنا من فتوحك يا سليْمى","على أن تَسْلَمي وتُهنِّئينا",17,"ن",2,1],["حُصونُ البِلاد وَأَسوارُها","إِذا نامَ حُرّاسُها وَالحُماة",18,"ه",1,0],["حَصَدَت أَنامُلُهُ المُنى فَتَساقَطَت","صَرعى كَما حَصَدَ السَنابِلَ مِنجَلُ",19,"ل",1,0],["حَصَدَ الَّذي زَرَعَ الشُيوخَ لِنَسلِهِم","وَقَضى عَلى القُطّانِ أَن يَتَحَوَّلوا",20,"ل",3,0],["حَصِّلِ الزادَ وَإِلّا","لَيسَ بَعدَ اليَومِ كوفَه",21,"ف",2,0],["حصحص الحق لا غبا","ر عليه ولا قتم",22,"م",1,0],["حِصنُ غِرناطَةَ وَدارُ بَني الأَح","مَرِ مِن غافِلٍ وَيَقظانَ نَدسِ",23,"س",1,0],["حَصِّنوا ما شِئتُمُ مَوتاكُمُ","هَل وَراءَ المَوتِ مِن حِصنٍ حَصين",24,"ن",1,0],["حَصانٌ مِثلُ ماءِ المُزنِ فيهِ","كَتومُ السِرِّ صادِقَةُ المَقالِ",25,"ل",1,0],["حَصَلتُ بِأَرضِ مِصرَ عَلى عَبيدٍ","كَأَنَّ الحُرَّ بَينَهُمُ يَتيمُ",26,"م",1,0],["حصباؤهُ دُرٌّ ورَضْرَاضُهُ","سُحالةُ العسجدِ حولَ الدررْ",27,"ر",1,0],["حَصِراً يترجمُ عن ضمي","رِ فؤادِيَ الدمعُ الفصيحُ",28,"ح",1,0],["حَصَّ التَريكُ رُؤوسَهُم فَرُؤوسَهُم","في مِثلِ لَألاءِ التَريكِ المُذهَبِ",29,"ب",1,0],["حَصَرَ الأَعداءَ في قُدرَتِهِ","ظَفَرٌ لَو زاوَلَ النَجمَ لَحِق",30,"ق",1,0],["حُصُونُ خَرْشَنَةَ العُليا فَرائِضُه","إذا غَزا وضَواحيها نَوافِلُه",31,"ل",2,0],["حصباؤُه لؤْلؤٌ نَثْرٌ وتُربَتُه","مِسكٌ ذكيٌّ فلو لم تَحمِه انُتهِبا",32,"ب",2,0],["حصونُه الشُّمُّ إن أفضى عواملُه","وسُورُه دونَ ما تحمي قواضبُه",33,"ب",2,0],["حصنٌ بَنَتْهُ لِصَوْنِ الملك كاهنةٌ","وأُفْرِغَتْ فيه من تدبيرها الحِكَمُ",34,"م",1,0],["حَصَدَتْهَا يَدُ الْمَنُونِ فَصَارَتْ","خَبَراً فِي الْوُجُودِ بَعْدَ عِيَانِ",35,"ن",1,0],["حَصَبَ الأَباطِحَ مِنهُ ماءٌ جامِدٌ","غَشّى البِلادَ بِهِ عَذابٌ ذائِبُ",36,"ب",1,0],["حِصنُ القضيّةِ يَنهضُ الوادي على","جَنَباتِهِ ويجولُ في أفيائِهِ",37,"ا",3,0],["حَصَّنْتَ دُستورَ البلادِ وصُنْتَهُ","عن أن يكون أذىً لِقومكَ ضائرا",38,"ر",2,0],["حِصنٌ يلوذُ الدينُ مِنهُ بِجانبٍ","عَزريلُ مُرتَقِبٌ عَلَيهِ يُرَفرفُ",39,"ف",1,0],["حُصُونٌ كلما زِيدَتْ دُعاءً","إلى البيضاء زادتها اجتنابا",40,"ب",2,0],["حَصانٌ لَها في البَيتِ زِيٌّ وَبَهجَةٌ","وَمَشيٌ كَما تَمشي القَطاةُ قَطوفُ",41,"ف",1,0],["حَصَّلَ مالاً جَمَّاً وعَدَّدَه","مِنْ أَصْلِ مَالِ الزَّكاةِ والوهْبَهْ",42,"ب",2,0],["حَصَّنَها في الحِياضِ فَاِحتَجَبَت","ما راعَها رَهبَةٌ وَلا فَرَقُ",43,"ق",1,0],["حَصَلنا عَلى التَمويهِ وَاِرتابَ بَعضُنا","بِبَعضٍ فَعِندَ العَينِ رَيبٌ مِن الشُفرِ",44,"ر",1,0],["حصر الشعر أُنا","سٌ غووا فانحصرا",45,"ر",2,0],["حَصَانٌ بَغِيٌّ ما ثَنَتْ يدَ لامِسٍ","ذَكَتْ وأحسّ القُرَّ فيها اللّوامِس",46,"س",1,0],["حصَّلَه كاتِبٌ حَفِيظٌ","وضمَّهُ صادِقٌ شَهِيدُ",47,"د",1,0],["حِصاني كانَ دَلّالَ المَنايا","فَخاضَ غُبارَها وَشَرى وَباعَ",48,"ع",1,0],["حَصَرُوا العَدُوَّ فَمَا وَقَتْهُ حُصُونُهُ","مِنْ بَأْسِهِمْ وَكَثَافَةُ الأَسْوَارِ",49,"ر",1,0],["حِصْنٌ أَشَمُّ تسَاندَتْ أَجْزَاؤُهُ","عِلْماًن وَأمَّنَهُ النَّهَى أَنْ يُنْسفَا",50,"ف",2,0],["حَصَرْتُ فِيكِ مَنَايَ","الحِسَانَ وَالآمَالاَ",51,"ل",2,0],["حَصَّلْتَ مَا لَمْ يُحَصِّلْهُ النَّوَابغُ فِي","قَوْمٍ فَجاوَزْتَهُمْ سَبْقاً وَلَمْ تَقِفِ",52,"ف",1,0],["حَصَّنتَ بَيضَتَهُم وَحُطتَ حَريمَهُم","وَحَمَلتَ مِن أَعبائِهِم ما اِستَثقَلوا",53,"ل",3,0],["حصيفٌ له في موقف الحقِّ صَوْلةٌ","ورأيٌ إذا غُمَّ الصوابُ صوابُ",54,"ب",1,0],["حصدْنَا سنابلَها من حقولٍ","رَوينَ بدمعٍ صَبيب ودَمْ",55,"م",1,0],["حَصَّادُ مالِ العالمين بكلِّ ما","يُنْدى الجبينَ، كأنما هو مِنْجَل",56,"ل",1,0],["حِصْنانِ: هذا يقيها كلَّ لافحةٍ","هبَّتْ، وذلكَ يحميها من البَلَلِ",57,"ل",1,0],["حصَّادُ هامِ العِدا في كل معركةٍ","وللسنابل يومَ السلم حصَّاد",58,"د",1,0],["حصانٌ لها في البيت زيٌّ وبهجة ٌ","ومشيٌ كما تمشي القطاة ُ كثيفُ",59,"ف",1,0],["حصَدَت خصومُك حسرةً وخجالةً","حتى لودّوا أَنهم لم يزْرَعوا",60,"ع",3,0],["حصانك فى سيناء يشرب دمعَهُ","ويا لعذاب الخيل ، إذ تتذكّرُ",61,"ر",1,0],["حصدتها يدُ المونونِ ، فصارتْ","خبراً في الوج بعدَ عيانٍ",62,"ن",1,0],["حصاني كانَ دلاّل المنايا","فخاض غُبارها وشَرى وباعا",63,"ع",2,0],["حصاد عيش الهشيم وا أسفي","على الرطب الرفيف من شجري",64,"ر",2,0],["حَصَّنتَ طارِفَها وَكَم مُتَوَسِّطٍ","لَولاكَ أَصبَحَ بِالقَنا مُتَطَرِّفا",65,"ف",2,0],["حَصَّنتَ شاسِعَها بِرَأيٍ لَو حَمى","بَدرَ السَماءِ عَنِ النَواظِرِ لَاِحتَما",66,"م",2,0],["حصنتُ ذا الوجه الأغر","بالمرسَلاتِ وبالزُمَر",67,"ر",1,1],["حَصَانُ الجَنبِ لَم تُرضِع صَبِيَّا","بِثَديَيهَا وَلَم تَحمِل جَنِينَا",68,"ن",2,0],["حصّلت أمر الزمان عن فطن","له مقام يعيبه أوله",69,"ل",2,0],["حصّلتُ علقا ماجنا شاعرا","محركا في كل حالاته",70,"ت",2,1],["حصَرَ الخيرَ فيكَ إِذ سوّاكا","كلُّ مَن أمّه بغيرِ هُداكا",71,"ك",2,0],["حَصَروهُ فمرّ عَنهم ولم يخ","لُص لِذاك الوليِّ منهم عناءُ",72,"ا",2,0],["حَصِرَ الناسُ أَن يَنالوا حِماها","وَأَرَنَّت بِرَوضِها الأَمطارُ",73,"ر",1,0],["حصاني لا في الصافناتِ التي مَضَتْ","سواه ولا في المقبلاتِ نَظِيرُ",74,"ر",1,1],["حصر الكاتبان قولي وفعلي","في كتاب محبّر مرقوش",75,"ش",1,0],["حَصَّنتَ بَيضَتَها بِكُلِّ كَتيبَةٍ","لا يَرهَبُ المَوتَ الزُؤامَ غُلامُها",76,"م",3,0],["حَصَلتَ عَلى الثَناءِ الحُرِّ مِنّي","بِها وَسَلِمتَ مِن جِهَةِ المَلامِ",77,"م",1,0],["حَصَّلَها القَنّاصُ بِال","حيلَةِ وَالتَوَصُّلِ",78,"ل",1,0],["حَصَّلَهُ خِيانَةً","طَوراً وَطوراً سَرِقَه",79,"ق",2,0],["حَصانُ الحَبيبِ ما جُلِيَت","عَلى الخُطّابِ وَالجُلَسا",80,"س",2,0],["حَصانُ الحَبيبِ ما جُلِيَت","بِها شُبثاً وَلا نَجَسا",80,"س",2,0],["حَصَّ رُؤوساً تَريكُها وَنَما","لَهُم عَلى طولِ لُبسِها الشَعرُ",81,"ر",1,0],["حَصيدُ سَيفك قَد أَعفَيته زَمَناً","لَو لَم يَطُل عَهدُه بالسَيفِ لَم يَطُلِ",82,"ل",1,0],["حصلتنا حتى نمو","ت بدائنا عطشاً وجوعاً",83,"ع",2,0],["حصنٌ حصينٌ في الحمى سامي الذرى","من ذا الّذي يسطو على ليث الشرى",84,"ا",1,0],["حَصَدَتها يَدُ الصَبابَةِ حَتّى","دَرَستَها بِالكَتمِ مِن لُبِّ بالي",85,"ي",1,0],["حُصونُ لُجينها أنحَتْ علَيهِ","بِما جَعَلَت ودائِلَة تُديلُ",86,"ل",1,0],["حصادُكُمُ على الأسْيافِ دَيْنٌ","ومِنْ تلك الأكفِّ لَهُ اقْتضاءُ",87,"ا",2,0],["حَصَّنْتَها بِسَدادِ رَأْيِكَ ضارِ