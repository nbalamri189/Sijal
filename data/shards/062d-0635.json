{"poems":[[3,"إذا كشف الزمان لك القناع","https://www.aldiwan.net/poem176.html",""],[77,"سار بي للأمير يشكو اعتراضي","https://www.aldiwan.net/poem35883.html","الخفيف"],[86,"سكت فأصغروا أدبي","https://www.aldiwan.net/poem10513.html","مجزوء الوافر"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[71,"وجارية يشفي الغليل رضابها","https://www.aldiwan.net/poem3895.html","الطويل"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11945.html","الطويل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[27,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[23,"علمتك والله الحسيب عفيفة","https://www.aldiwan.net/poem21376.html","الطويل"],[23,"حصان رزان ما تزن بريبة","https://www.aldiwan.net/poem21410.html","الطويل"],[64,"للعلم أهل وللإيمان ترتيب","https://www.aldiwan.net/poem67665.html","البسيط"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"تخلفت شنطف فقلنا","https://www.aldiwan.net/poem64013.html","مخلع البسيط"],[51,"حصلنا من فتوحك يا سليمى","https://www.aldiwan.net/poem66397.html","الوافر"],[91,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[70,"أيها النفس الشريفه","https://www.aldiwan.net/poem42809.html","مجزوء الرمل"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[43,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[43,"أما في هذه الدنيا كريم","https://www.aldiwan.net/poem10573.html","الوافر"],[62,"عجنا إلى الجزع الذي مد في","https://www.aldiwan.net/poem52404.html","السريع"],[62,"يا من يسيء إلى الأنام","https://www.aldiwan.net/poem52460.html","مجزوء الكامل"],[45,"رحلوا فأية عبرة لم تسكب","https://www.aldiwan.net/poem10645.html","الكامل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[61,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[61,"فتح أعز به الإسلام صاحبه","https://www.aldiwan.net/poem51815.html","البسيط"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[87,"أي شيء يبقى على الحدثان","https://www.aldiwan.net/poem8231.html","الخفيف"],[74,"يا رب قطر جامد حلى به","https://www.aldiwan.net/poem12841.html","الكامل"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[105,"وفد البحيرة جاء طوع يقينه","https://www.aldiwan.net/poem42098.html","الكامل"],[105,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[22,"أمن رسم دار مربع ومصيف","https://www.aldiwan.net/poem21650.html","الطويل"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[48,"يا ليلة طاب لي بها الأرق","https://www.aldiwan.net/poem64420.html","المنسرح"],[46,"أرى كفرطاب أعجز الماء حفرها","https://www.aldiwan.net/poem22649.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30449",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9945","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54931","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55154","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55026","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[106,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[106,"جمال طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179605",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[22,"أمِنْ رَسْمِ دارٍ مَرْبَعٌ ومصِيفُ","https://www.poetsgate.com/ViewPoem.aspx?id=19786",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[87,"أَيُّ شَيْءٍ يَبْقَى عَلَى الْحَدَثَانِ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23884&r=&rc=146",""],[3,"إذا كشفَ الزَّمانُ لك القِناعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10712&r=&rc=66",""]],"verses":[["حِصاني كانَ دَلّالَ المَناي","فَخاضَ غُبارَها وَشَرى وَباعَ",0,"ع",1,0],["حصْحَصَ الحقُّ يا خَوَنْدُ فدَعْني","أنا راوَدْتُ يوسفاً عنْ نفسِهِ",1,"س",2,0],["حَصائِدُ أَلسُنٍ جَرَّت","إِلى الوَيلاتِ وَالحَرَبِ",2,"ب",1,0],["حَصَدَت مَناجِلُهُ غِراسَ رَجائِنا","وَلَو أَنَّها أَبقَت عَلَيهِ لَأَورَقا",3,"ق",2,0],["حَصانٌ وَما رَدَّت أَنامِلَ لامِسٍ","نَتوجٌ وَمِقلاتٌ وَما ضاجَعَت ذكَر",4,"ر",1,0],["حَصانٌ إِنِ التَقوى اِستَبَدَّت بِسِرِّها","فَمِن صالِحِ الأَعمالِ يُستَوضَحُ الجَهرُ",5,"ر",1,0],["حِصْنٌ يَذُودُ بِهِ عَنْ قَوْمِهِ بَطَلٌ","بِالحَقِّ مُعْتَضِدٌ بِالعَدْلِ مُعْتَصِمُ",6,"م",1,0],["حصباؤها لؤلؤ قد شفَّ جوهرها","والنهر قد سال ذوباً من لآليها",7,"ي",3,0],["حصون تستخفّ بكلّ طَوْدٍ","وتستعشي برؤيتها العيونا",8,"ن",2,0],["حَصانٌ لا المُريبُ لَها خَدينٌ","وَلا تُفشي الحَديثَ وَلا تَرودُ",9,"د",1,0],["حَصاناً رَزانَ الرِجلِ يَشبَعُ جارُها","وَتُصبِحُ غَرثى مِن لُحومِ الغَوافِلِ",10,"ل",1,0],["حَصانٌ رَزانٌ ما تُزَنُّ بِرَيبَةٍ","وَتُصبِحُ غَرثى مِن لُحومِ الغَوافِلِ",11,"ل",1,1],["حَصباؤُهُ جَوهَرٌ لَم تَدنُ مِنهُ يَدٌ","لَكَنَّهُ بِيَدِ الأَفهامِ مَنهوبُ",12,"ب",1,0],["حِصْرِمٌ من زَبرجدٍ بين نَبْعٍ","من يواقيت جمرُها غيرُ خابِ",13,"ب",1,0],["حَصَرْتَ عميدَ الزَّنْج حتَّى تَخَاذَلَتْ","قُواهُ وأَوْدَى زادُهُ المُتَزَوَّدُ",14,"د",1,0],["حَصَّلته هاشمياً لا نظير له","مِلْحاً وظرفاً وإن قال الخنا نفر",15,"ر",1,0],["حَصَّاءُ لا نبت في قفاها","ولم تزل لاستها ضفيره",16,"ر",2,0],["حصلنا من فتوحك يا سليْمى","على أن تَسْلَمي وتُهنِّئينا",17,"ن",2,1],["حُصونُ البِلاد وَأَسوارُها","إِذا نامَ حُرّاسُها وَالحُماة",18,"ه",1,0],["حَصَدَت أَنامُلُهُ المُنى فَتَساقَطَت","صَرعى كَما حَصَدَ السَنابِلَ مِنجَلُ",19,"ل",1,0],["حَصَدَ الَّذي زَرَعَ الشُيوخَ لِنَسلِهِم","وَقَضى عَلى القُطّانِ أَن يَتَحَوَّلوا",20,"ل",3,0],["حَصِّلِ الزادَ وَإِلّا","لَيسَ بَعدَ اليَومِ كوفَه",21,"ف",2,0],["حصحص الحق لا غبا","ر عليه ولا قتم",22,"م",1,0],["حِصنُ غِرناطَةَ وَدارُ بَني الأَح","مَرِ مِن غافِلٍ وَيَقظانَ نَدسِ",23,"س",1,0],["حَصِّنوا ما شِئتُمُ مَوتاكُمُ","هَل وَراءَ المَوتِ مِن حِصنٍ حَصين",24,"ن",1,0],["حَصانٌ مِثلُ ماءِ المُزنِ فيهِ","كَتومُ السِرِّ صادِقَةُ المَقالِ",25,"ل",1,0],["حَصَلتُ بِأَرضِ مِصرَ عَلى عَبيدٍ","كَأَنَّ الحُرَّ بَينَهُمُ يَتيمُ",26,"م",1,0],["حصباؤهُ دُرٌّ ورَضْرَاضُهُ","سُحالةُ العسجدِ حولَ الدررْ",27,"ر",1,0],["حَصِراً يترجمُ عن ضمي","رِ فؤادِيَ الدمعُ الفصيحُ",28,"ح",1,0],["حَصَّ التَريكُ رُؤوسَهُم فَرُؤوسَهُم","في مِثلِ لَألاءِ التَريكِ المُذهَبِ",29,"ب",1,0],["حَصَرَ الأَعداءَ في قُدرَتِهِ","ظَفَرٌ لَو زاوَلَ النَجمَ لَحِق",30,"ق",1,0],["حُصُونُ خَرْشَنَةَ العُليا فَرائِضُه","إذا غَزا وضَواحيها نَوافِلُه",31,"ل",2,0],["حصباؤُه لؤْلؤٌ نَثْرٌ وتُربَتُه","مِسكٌ ذكيٌّ فلو لم تَحمِه انُتهِبا",32,"ب",2,0],["حصونُه الشُّمُّ إن أفضى عواملُه","وسُورُه دونَ ما تحمي قواضبُه",33,"ب",2,0],["حصنٌ بَنَتْهُ لِصَوْنِ الملك كاهنةٌ","وأُفْرِغَتْ فيه من تدبيرها الحِكَمُ",34,"م",1,0],["حَصَدَتْهَا يَدُ الْمَنُونِ فَصَارَتْ","خَبَراً فِي الْوُجُودِ بَعْدَ عِيَانِ",35,"ن",1,0],["حَصَبَ الأَباطِحَ مِنهُ ماءٌ جامِدٌ","غَشّى البِلادَ بِهِ عَذابٌ ذائِبُ",36,"ب",1,0],["حِصنُ القضيّةِ يَنهضُ الوادي على","جَنَباتِهِ ويجولُ في أفيائِهِ",37,"ا",3,0],["حَصَّنْتَ دُستورَ البلادِ وصُنْتَهُ","عن أن يكون أذىً لِقومكَ ضائرا",38,"ر",2,0],["حِصنٌ يلوذُ الدينُ مِنهُ بِجانبٍ","عَزريلُ مُرتَقِبٌ عَلَيهِ يُرَفرفُ",39,"ف",1,0],["حُصُونٌ كلما زِيدَتْ دُعاءً","إلى البيضاء زادتها اجتنابا",40,"ب",2,0],["حَصانٌ لَها في البَيتِ زِيٌّ وَبَهجَةٌ","وَمَشيٌ كَما تَمشي القَطاةُ قَطوفُ",41,"ف",1,0],["حَصَّلَ مالاً جَمَّاً وعَدَّدَه","مِنْ أَصْلِ مَالِ الزَّكاةِ والوهْبَهْ",42,"ب",2,0],["حَصَّنَها في الحِياضِ فَاِحتَجَبَت","ما راعَها رَهبَةٌ وَلا فَرَقُ",43,"ق",1,0],["حَصَلنا عَلى التَمويهِ وَاِرتابَ بَعضُنا","بِبَعضٍ فَعِندَ العَينِ رَيبٌ مِن الشُفرِ",44,"ر",1,0],["حصر الشعر أُنا","سٌ غووا فانحصرا",45,"ر",2,0],["حَصَانٌ بَغِيٌّ ما ثَنَتْ يدَ لامِسٍ","ذَكَتْ وأحسّ القُرَّ فيها اللّوامِس",46,"س",1,0],["حصَّلَه كاتِبٌ حَفِيظٌ","وضمَّهُ صادِقٌ شَهِيدُ",47,"د",1,0],["حِصاني كانَ دَلّالَ المَنايا","فَخاضَ غُبارَها وَشَرى وَباعَ",48,"ع",1,0],["حَصَرُوا العَدُوَّ فَمَا وَقَتْهُ حُصُونُهُ","مِنْ بَأْسِهِمْ وَكَثَافَةُ الأَسْوَارِ",49,"ر",1,0],["حِصْنٌ أَشَمُّ تسَاندَتْ أَجْزَاؤُهُ","عِلْماًن وَأمَّنَهُ النَّهَى أَنْ يُنْسفَا",50,"ف",2,0],["حَصَرْتُ فِيكِ مَنَايَ","الحِسَانَ وَالآمَالاَ",51,"ل",2,0],["حَصَّلْتَ مَا لَمْ يُحَصِّلْهُ النَّوَابغُ فِي","قَوْمٍ فَجاوَزْتَهُمْ سَبْقاً وَلَمْ تَقِفِ",52,"ف",1,0],["حَصَّنتَ بَيضَتَهُم وَحُطتَ حَريمَهُم","وَحَمَلتَ مِن أَعبائِهِم ما اِستَثقَلوا",53,"ل",3,0],["حصيفٌ له في موقف الحقِّ صَوْلةٌ","ورأيٌ إذا غُمَّ الصوابُ صوابُ",54,"ب",1,0],["حصدْنَا سنابلَها من حقولٍ","رَوينَ بدمعٍ صَبيب ودَمْ",55,"م",1,0],["حَصَّادُ مالِ العالمين بكلِّ ما","يُنْدى الجبينَ، كأنما هو مِنْجَل",56,"ل",1,0],["حِصْنانِ: هذا يقيها كلَّ لافحةٍ","هبَّتْ، وذلكَ يحميها من البَلَلِ",57,"ل",1,0],["حصَّادُ هامِ العِدا في كل معركةٍ","وللسنابل يومَ السلم حصَّاد",58,"د",1,0],["حصانٌ لها في البيت زيٌّ وبهجة ٌ","ومشيٌ كما تمشي القطاة ُ كثيفُ",59,"ف",1,0],["حصَدَت خصومُك حسرةً وخجالةً","حتى لودّوا أَنهم لم يزْرَعوا",60,"ع",3,0],["حصانك فى سيناء يشرب دمعَهُ","ويا لعذاب الخيل ، إذ تتذكّرُ",61,"ر",1,0],["حصدتها يدُ المونونِ ، فصارتْ","خبراً في الوج بعدَ عيانٍ",62,"ن",1,0],["حصاني كانَ دلاّل المنايا","فخاض غُبارها وشَرى وباعا",63,"ع",2,0]]}