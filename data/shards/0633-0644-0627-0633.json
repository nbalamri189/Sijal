{"poems":[[74,"سل أسياف لحظه","https://www.aldiwan.net/poem19666.html","مجزوء الخفيف"],[48,"سلاسل برق تقل البلاد","https://www.aldiwan.net/poem23192.html","المتقارب"],[92,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[276,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[358,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[409,"شبهت ما دارت به","https://www.aldiwan.net/poem33348.html","مجزوء الرجز"],[469,"كأنما الطلع إذا لاح","https://www.aldiwan.net/poem3346.html","عموديه"],[484,"سلا سليمى سلاها","https://www.aldiwan.net/poem37021.html","المجتث"],[572,"يا حبذا يومنا ونحن على","https://www.aldiwan.net/poem69548.html","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48845","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202132","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93795","البسيط"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101362","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4829,"ملحمة الطلاسم للألفية الدمويّة","https://www.poetsgate.com/ViewPoem.aspx?id=34257",""],[5449,"إلى عينيكَ","https://www.poetsgate.com/ViewPoem.aspx?id=189387",""],[5596,"ردي على قصيدة ناصر بن سعيد الرواحي","https://www.poetsgate.com/ViewPoem.aspx?id=206691",""],[5776,"عامُ الأبابيلِ اليمانية...","https://www.poetsgate.com/ViewPoem.aspx?id=203647",""]],"verses":[["سلَّ أسياف لحظه","فالْتقتها مقاتلي",0,"ل",2,1],["سَلاسِلُ بَرقٍ تُقِلُّ البِلادَ","مِنَ المَحلِ جادَت بَني سَلسِلَه",1,"ل",2,1],["سلاسلُ صِيغتْ من معانٍ مُبَغَّضٍ","لها الذهبُ الأبريزُ وهو سلاسل",2,"ل",1,0],["سَلاسلُ أقدارٍ منَ اللَّه حُكّمت","بِأعناقِهم قادَتهم للرَدى قَسرا",3,"ر",2,0],["سَلاسيوفكما وَذبا عَن حمى","عَبد الرَحيم ومن يَليه تكرما",4,"م",2,0],["سَل أَسمَر الخَطِّ كَم قَد خَطَّ طرس وَغىً","عَن أَبيَض الحَظّ يُنبينا مسطّرهُ",5,"ر",2,0],["سلاسل من ذهب","على جبين تركيه",6,"ي",2,0],["سلاسلٌ من فضَّةٍ","في غلفٍ من صدف",7,"ف",1,0],["سلا سليمى سلاها","عن الذي ما سلاها",8,"ا",3,1],["سَلاَسِلٌ مِنْ زَبَرْجَدٍ حَمَلَتْ","مِنْ ذَهَبٍ أًصْفَرٍ قَنَادِيْلاَ",9,"ل",2,0],["سلاسلَ تقليدٍ وأغلالَ عادةٍ","كسرتِ ولا ضرباً شهدتِ ولا طعنا",10,"ن",2,0],["سل أسودًا مسختُهنَّ قرودًا","وحمامًا مثَّلتهنَّ حِماما",11,"م",2,0],["سلاسل من مذاب التبر أفرغها","في قالب الظرف حسن السبك فاطردت",12,"ت",1,0],["سلاسلمات المهر أين ترحّلت","مهارى اللوائي بارحتها وقودها",13,"د",3,0],["سلاسل الجعد قد سلسلت فاحمها","دقصا تقاد به طوعا اساراكا",14,"ك",2,0],["سلاسِلٌ ما اعتَقَلَ الغُصنَ لها","عَنِ المراح مَعقِلٌ ولا اعتقى",15,"ا",1,0],["سلاسة اكبر السبطين وجده احمد المشهور","تقارب نجمه البارح دلالة قرب مهدّيه",16,"ي",2,0],["سلاسلُ معصميكَ لها أنينٌ","ويوجعُها بكفِّيكَ الصدامُ",17,"م",1,0],["سلاسل تتلوها سلاسل وُثّقت","عُراها بإبراقٍ يظل يثور",18,"ر",1,0],["سلاسلُ ذلّ قيّدتهم بسكرةٍ","من النفطِ كانت عيشّهم والمنافيا",19,"ي",2,0]]}