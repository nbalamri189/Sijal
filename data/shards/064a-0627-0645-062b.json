{"poems":[[95,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[95,"يا مثالاً قدمته وشفيعي","https://www.aldiwan.net/poem11426.html","الخفيف"],[74,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[50,"قد علا الديوان كابه","https://www.aldiwan.net/poem62436.html","مجزوء الرمل"],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[119,"يا بعينيك طر الى بغداد","https://www.aldiwan.net/poem41168.html","عموديه"],[215,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[242,"يا مثيرا في حشى الصب الشجي","https://www.aldiwan.net/poem18108.html","الرمل"],[438,"يا مثلا في فضله سائرا","https://www.aldiwan.net/poem12353.html","السريع"],[463,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[558,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[563,"يا مثمرا قبل ينبت","https://www.aldiwan.net/poem34535.html","المجتث"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205470",""],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143792","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53152","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47152","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88653","الكامل"],[2432,"","https://poetry.dctabudhabi.ae/diwan/poem/147047","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205850","الخفيف"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122469","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132721","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125876","الخفيف"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114609","الكامل"],[4755,"ما زالَ يَطرُقُ بابَ البَوْحِ مُذْ كُبِتَا","https://www.poetsgate.com/ViewPoem.aspx?id=184104",""],[4755,"ُرَوَّعٌ.. ما أَدَارَ العَينَ في جِهَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=185918",""],[242,"يا مثيرا في حشا الصب الشجي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563772",""]],"verses":[["يَا مِثَالَ الْكَمَالِ فِي حْرَّةِ الطَّبْ","عِ وَفِي دُرَّةِ الْجَمَالِ المَصُونِ",0,"ن",1,0],["يَا مِثَالاً قَدَّمْتُهُ وَشَفِيعي","فِيهِ صِدْقُ الوَلاءِ وَالإِجْلاَلِ",1,"ل",1,1],["يا مثريَ الخدّ بالمحمر من ذهبٍ","دارِك ضرورة محتاجٍ ومجتاح",2,"ح",1,0],["يا مِثالاً كانَ وَهماً قَبلَما شاءَ البُناة","أَنتَ فِكرٌ مِن دِماغٍ غَيَّبَتهُ الظُلُمات",3,"ت",1,0],["يَا مِثْلَهُ لاجِئاً يَا مِثْلَهُ تَعِبَاً","كُنْ مِثْلَهُ فَارِسَاً كُنْ مِثْلَهُ نَجُدَا",4,"د",2,0],["يَا مِثْلَنَا كُنْتَ مَطْرُودَاً وَمُغْتَرِبَاً","يَا مِثْلَنَا كُنْتَ مَظْلُومَاً وَمُضْطَهَدَا",4,"د",2,0],["يا مِثالاً مِن هُمومٍ","يا تَباريحَ كَآبَه",5,"ب",2,0],["يا مَثارَ الأحلامِ ، يا عالَمَ الشّعر","طريّاً ، يا جَنَّةً من تراب",6,"ب",1,0],["يا مثير الركبان والحب دين","حي عني قيعان ذاك النادي",7,"د",2,0],["يا مثال النبل يا زين الشباب","كيف أمسيت رهينا للتراب",8,"ب",1,0],["يَا مُثِيراً فِي حَشَى الصَّبِّ الشَّجِي","نَارَ وَجْدٍ بِلِحَاظِ الدَّعَجِ",9,"ج",1,1],["يا مَثَلاً في فضلِهِ سائراً","انظُرْ إِلى صِحَّةِ تمثيلي",10,"ل",2,1],["يا مثكلاً أمَّ الفضائلِ مُورثاً","يُتماً بناتِ القاطناتِ الشُّرَّدِ",11,"د",1,0],["يا مُثْكِلِي نومَ عينٍ فيه ساهرةٍ","جَفْنِي عليك بدمعي فيك قد قُرِحا",12,"ح",2,0],["يا مُثبِتَ المُلكِ إِذا زالَت دَعائِمُهُ","وَثارَ بِالفِتنَةِ العَمياءِ باغيها",13,"ي",3,0],["يا مثمراً قبل ينبُتْ","في قلبه الجهل يَنْكُتْ",14,"ت",1,1],["يا مثال الجود والبر","ر لنا في بلديك",15,"ك",1,0],["يا مثيرات كل حرب ويا من","لالهن العهود لا والوفاء",16,"ا",2,0],["يا مثلاً سائراً إذا ذكر ال","حسن تركت الحسان كالمثل",17,"ل",1,0],["يا مثنياً من حسنه عَطفاً على","قلب يبيت من التصبر مُمْلقا",18,"ق",2,0],["يا مثالَ النّعال تفديك نفسي","من مثال لم يحكِه من مثال",19,"ل",1,1],["يا مثلة شنعاء قد عبثت","في الدين فيها يضرب المثل",20,"ل",1,0],["يا مثرياً من كل مكرمة","إني إلى جدواك مفتقر",21,"ر",1,0],["يا مثالاً يضمُّ كل الضحايا","في سبيل الفخار والعلياء",22,"ا",2,0],["يا مثلَهُ لِمَن","تمسَّكَ بدينِ القُدسِ",23,"س",1,1],["يا مثقبا لضيوف العلم نار قرى","تهدي إلى حكم غرّ واحكام",24,"م",1,0],["يا مثمراً إن جنا الجاني إليه حَنا","ومغضياً إن جنى الجاني بغير إِحَن",25,"ن",1,0],["يا مُثخِناً جُرحَ المعاصي لُذَّ بطا","عتهِ فيُوسِي جُرحَك المتماسي",26,"س",2,0],["يا مثالَ الذكاءِ والجدِّ حقاً","فيك لو شاء رسمُهُ الرسام",27,"م",1,0],["يا مثريا صدقات حسنك أدها","قُبَلاً بها يزداد فرط نماء",28,"ا",2,1],["يا مُثْقِلَ الأرضِ بالأَوطانِ لِي وَطَنٌ","مَا بَينَ عَينِيْ وصَدرِي صَخرُهُ نَبَتَا",29,"ت",2,0],["يا مُثْقِلَ الأَرضِ بالأَوطانِ لِي وَطنٌ","ما بَينَ جَفنِي وصَدرِي صَخرُهُ نَبَتَا",30,"ت",2,0],["يا مُثيراً في حَشا الصَبِّ الشَجِيِّ","نارَ وَجدٍ بِلِحاظِ الدَعجِ",31,"ج",1,1]]}