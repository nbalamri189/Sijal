{"poems":[[93,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[93,"يا مثالاً قدمته وشفيعي","https://www.aldiwan.net/poem11426.html","الخفيف"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[48,"قد علا الديوان كابه","https://www.aldiwan.net/poem62436.html","مجزوء الرمل"],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[113,"يا بعينيك طر الى بغداد","https://www.aldiwan.net/poem41168.html","عموديه"],[209,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[235,"يا مثيرا في حشى الصب الشجي","https://www.aldiwan.net/poem18108.html","الرمل"],[429,"يا مثلا في فضله سائرا","https://www.aldiwan.net/poem12353.html","السريع"],[456,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[549,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[551,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[556,"يا مثمرا قبل ينبت","https://www.aldiwan.net/poem34535.html","المجتث"]],"verses":[["يَا مِثَالَ الْكَمَالِ فِي حْرَّةِ الطَّبْ","عِ وَفِي دُرَّةِ الْجَمَالِ المَصُونِ",0,"ن",1,0],["يَا مِثَالاً قَدَّمْتُهُ وَشَفِيعي","فِيهِ صِدْقُ الوَلاءِ وَالإِجْلاَلِ",1,"ل",1,1],["يا مثريَ الخدّ بالمحمر من ذهبٍ","دارِك ضرورة محتاجٍ ومجتاح",2,"ح",1,0],["يا مِثالاً كانَ وَهماً قَبلَما شاءَ البُناة","أَنتَ فِكرٌ مِن دِماغٍ غَيَّبَتهُ الظُلُمات",3,"ت",1,0],["يا مِثالاً مِن هُمومٍ","يا تَباريحَ كَآبَه",4,"ب",2,0],["يا مَثارَ الأحلامِ ، يا عالَمَ الشّعر","طريّاً ، يا جَنَّةً من تراب",5,"ب",1,0],["يا مثير الركبان والحب دين","حي عني قيعان ذاك النادي",6,"ي",1,0],["يا مثال النبل يا زين الشباب","كيف أمسيت رهينا للتراب",7,"ب",1,0],["يَا مُثِيراً فِي حَشَى الصَّبِّ الشَّجِي","نَارَ وَجْدٍ بِلِحَاظِ الدَّعَجِ",8,"ج",1,1],["يا مَثَلاً في فضلِهِ سائراً","انظُرْ إِلى صِحَّةِ تمثيلي",9,"ل",2,1],["يا مثكلاً أمَّ الفضائلِ مُورثاً","يُتماً بناتِ القاطناتِ الشُّرَّدِ",10,"د",1,0],["يا مُثْكِلِي نومَ عينٍ فيه ساهرةٍ","جَفْنِي عليك بدمعي فيك قد قُرِحا",11,"ح",2,0],["يا مُثبِتَ المُلكِ إِذا زالَت دَعائِمُهُ","وَثارَ بِالفِتنَةِ العَمياءِ باغيها",12,"ي",3,0],["يا مثمراً قبل ينبُتْ","في قلبه الجهل يَنْكُتْ",13,"ت",1,1]]}