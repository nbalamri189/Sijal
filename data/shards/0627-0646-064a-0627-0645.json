منسرح"],[3408,"","https://poetry.dctabudhabi.ae/diwan/poem/146236","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45257","البسيط"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45251","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45903","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45768","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109898","البسيط"],[3732,"","https://poetry.dctabudhabi.ae/diwan/poem/131942","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133235","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69935","الكامل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75824","الرمل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121277","البسيط"],[4439,"","https://poetry.dctabudhabi.ae/diwan/poem/105893","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66142","الكامل"],[4487,"","https://poetry.dctabudhabi.ae/diwan/poem/18772","الرجز"],[4493,"","https://poetry.dctabudhabi.ae/diwan/poem/20664","البسيط"],[4502,"","https://poetry.dctabudhabi.ae/diwan/poem/75856","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104918","الرجز"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116070","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116059","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52145","الكامل"],[4699,"لقاء في الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=153960",""],[4929,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=199526",""],[460,"صرمت سعيدة ُ ودَّها وخلالها","https://www.poetsgate.com/ViewPoem.aspx?id=22229",""],[5017,"إني امرؤ غافقي ليس لي حسب","https://www.poetsgate.com/ViewPoem.aspx?id=187189",""],[585,"لم يغن تحذير ولا إغراء","https://www.poetsgate.com/ViewPoem.aspx?id=161847",""],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[5092,"هدأة صمت","https://www.poetsgate.com/ViewPoem.aspx?id=190703",""],[5156,"إني أمت على الذي ودي له","https://www.poetsgate.com/ViewPoem.aspx?id=99134",""],[5191,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=212089",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[5468,"إني امرؤ لا أرى بالباب أقرعه","https://www.poetsgate.com/ViewPoem.aspx?id=181090",""],[5582,"هَذِي أُمَيْمٌ تَجَلَّى شَخْصُها وَبَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=63503",""],[5582,"قِفْ وَاسْأَلْ السَّفْحَ سَفْحَ الرَّمْلِ وَالبانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63598",""],[5582,"قِف بِالرسومِ الخاليات مخاطباً","https://www.poetsgate.com/ViewPoem.aspx?id=63456",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5674,"البعد سهم قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=189076",""],[5910,"الثقة.. والغرور","https://www.poetsgate.com/ViewPoem.aspx?id=206321",""],[5910,"للهِ أشكو شجونًا","https://www.poetsgate.com/ViewPoem.aspx?id=206879",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[5956,"العاشقات دخلن عمري فجأة","https://www.poetsgate.com/ViewPoem.aspx?id=182270",""],[5956,"إني أمد إليك كل حبالي","https://www.poetsgate.com/ViewPoem.aspx?id=182290",""],[5956,"مِثْل الفقير يرى القصور بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=182343",""],[5956,"ألمي عليها","https://www.poetsgate.com/ViewPoem.aspx?id=182412",""],[5956,"الشَّعر أبيضُ","https://www.poetsgate.com/ViewPoem.aspx?id=182615",""],[5956,"أرجو بقايَ لأجل زوجي الصابرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183732",""],[5956,"لهفي أموت","https://www.poetsgate.com/ViewPoem.aspx?id=183882",""],[5956,"ما عاد يقْبل عقلي الشعرَ واسطة","https://www.poetsgate.com/ViewPoem.aspx?id=183972",""],[5956,"جوبي السهول","https://www.poetsgate.com/ViewPoem.aspx?id=184926",""],[5956,"كم أبتغي إضحاككم","https://www.poetsgate.com/ViewPoem.aspx?id=192423",""],[5956,"إني أمين مثل والدكم","https://www.poetsgate.com/ViewPoem.aspx?id=193690",""],[5956,"رمضان هذا لم يُعِنِّي أكتبُ","https://www.poetsgate.com/ViewPoem.aspx?id=194108",""],[5956,"إني امرؤٌ متخلف أو أين أنا من التطور؟","https://www.poetsgate.com/ViewPoem.aspx?id=194463",""],[5956,"إني على تل الحصا متمدد","https://www.poetsgate.com/ViewPoem.aspx?id=208051",""],[5956,"لله درُّ الأريحية سامِيا","https://www.poetsgate.com/ViewPoem.aspx?id=208562",""],[6031,"ما كُنْتُ أَحْسَبُ والأيَّامُ مولَعَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46407",""],[6082,"صديقي والعزوبية","https://www.poetsgate.com/ViewPoem.aspx?id=59117",""],[6090,"هدمت للمجد والعلياء أركانا","https://www.poetsgate.com/ViewPoem.aspx?id=170920",""],[2841,"إني امرؤ لا يعتري خلقي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=613096",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""]],"verses":[["إِنّي اِمرُؤٌ مِن خَيرِ عَبسٍ مَنصِب","شَطرِي وَأَحمي سائِري بِالمُنصُلِ",0,"ل",1,0],["إِنّي اِمرُؤٌ سَمحُ الخَليقَةِ ماجِدٌ","لا أُتبِعُ النَفسَ اللَجوجَ هَواها",1,"ا",3,0],["إنّي امرؤٌ أعْطيْتُ دهْريَ مِقْوَدي","وجرَيْتُ في طَلْقٍ معَ الأعْصارِ",2,"ر",1,0],["إِنّي اِمرُؤٌ مِن عُصبَةٍ قَيسِيَّةٍ","شُمِّ الأُنوفِ غَرانِقٍ أَحشادِ",3,"د",1,0],["إِنّي اِمرُؤٌ أَقني الحَياءَ وَشيمَتي","كَرمُ الطَبيعَةِ وَالتَجَنُّبُ لِلخَنا",4,"ا",1,0],["إِنّي اِمرُؤٌ أُبدي مُخ","لَفَتي وَأَكرَهُ أَن أُسِرّا",5,"ر",2,0],["أنيام والدهر يفتح فيكم","من جديدَيْه مقلَتيْ يقظان",6,"ن",1,0],["إِنّي اِمرُؤٌ لَم أُرِد فيمَن أُناوِئُهُ","لِلناسِ ظُلماً وَلا لِلحَربِ إِدهانا",7,"ن",2,0],["إِنّي اِمرُؤٌ يَبني لِيَ المَجدَ البان","أَندُبُ مَجداً غَيرَ مَجدِ ثُنيان",8,"ن",1,1],["إِنّي اِمرُؤٌ مِن نِزارٍ في أَرومَتِهِم","مُستَحصِدٌ أَجَمي فيهِم وَعِرَّيسي",9,"س",2,0],["إِنّي اِمرُؤٌ مُضَريٌّ في أَرومَتِها","مَشهورَةٌ غُرَّتي فيهِم وَتَحجيلُ",10,"ل",1,0],["إِنّي اِمرُؤٌ مَنَعَت أَرومَةُ عامِرٍ","ضَيمي وَقَد جَنَفَت عَلَيَّ خُصومُ",11,"م",1,0],["إني امرؤ إن لم يكن لي موضعٌ","في مَرْكبٍ يوماً ركِبت القاربا",12,"ب",2,0],["أنَّى امتُحِنت ببلوى لا يُشاكلها","ما خلتُها غير تعبيرٍ وإنذار",13,"ر",1,0],["إني امرؤ مَن أبَى عفوي وعافيتي","أرشتُ شرِّي عليه أيَّ تأريش",14,"ش",1,0],["إني امرؤ أودى الزمانُ بثروتي","وألحَّ يكلمُني وكفُّك تُدملُ",15,"ل",1,0],["إني امرؤٌ إن أراد ميمنتي","كريمُ قومٍ غدوتُ ميمونا",16,"ن",2,0],["إني امرؤ مستعيذٌ أَن تُهَجِّنني","أو أن أُرى بحجابٍ منك مُمتَهَنا",17,"ن",2,0],["إِنّي اِمتَدَحتُ جَريرَ الخَيرِ إِنَّ لَهُ","عِندي بِنائِلِهِ الإِحسانَ وَالصَفَدا",18,"د",2,0],["إِن يَأمَنوا وَجَدوا المَنايا يومنَةً","أَو يَأسِروا وَجَدوا الجُيوشَ شِمالا",19,"ل",2,0],["إِنّي اِمرُؤٌ لا شَيءَ يُطرِبُ روحَهُ","وَيَهُزُّها كَالزَهرِ وَالأَلحانِ",20,"ن",1,1],["إِن يَأمَنو وَقعَ الأَسِنَّةِ وَالظُبى","فَالذُعرُ طاعِنُهُم بِشَرِّ سِنانِ",21,"ن",1,0],["إِنّي اِمرُؤٌ عافي إِنائِيَ شِركَةٌ","وَأَنتَ اِمرُؤٌ عافي إِنائِكَ واحِدُ",22,"د",1,1],["إِنّي اِمرُؤٌ لَم أَزَل وَذاكَ مِنَ ال","لَهِ قَديماً أُعَلِّمُ الأُدُبا",23,"ب",2,1],["اني امرؤ الشك لا ايمان يربطني","بالخير ان كان شيئا غير ملموس",24,"س",1,0],["إنِّي امْرُؤٌ بازِلٌ في ذُرْوَتَيْ شَرَفٍ","لِقَيْصَرٍ ولِكِسْرَى مَحْتِدِي وأَبي",25,"ب",2,0],["إنّي أميلُ إِلى قسيِّ حواجبٍ","عن عطفِ كلِّ حنيَّةٍ مرنانِ",26,"ن",1,0],["إِني أمُتُّ حزامةً من مِقولي","يُلقَى عليها للجمال براقِعُ",27,"ع",1,0],["إِنّي أَمُتُّ بِوُدٍّ قَد تَقادَمَ عَن","حُدثِ اللَيالي وَلَم يُخلِق عَلى القِدَمِ",28,"م",1,0],["إِنّي أَمِنتُ مِنَ الزَمانِ وَرَيبِهِ","لَمّا عَلِقتُ مِنَ الأَميرِ حِبالا",29,"ل",2,0],["إني امرؤٌ يُفضي إلى","أزمانه المرقَّعه",30,"ع",2,0],["إني امرؤ لا تَرى لساني","مُنَظِّماً ما حييتُ هَجْوا",31,"و",2,1],["إنِّي امرؤ أبني القريض ولا أرى","زَمَناً يحاولُ هدْمَ ما أنا باني",32,"ن",2,0],["إِنِّي امرؤٌ في ودادي ذو محافظةٍ","فما يَرَى في وفائي الخلُّ من خلَلِ",33,"ل",1,0],["إنّي امرؤ ما زلتُ أنظمُ في","جيدِ الغزال قلائدَ الغزلِ",34,"ل",1,0],["إنّي امرؤ وطباعُ الحقِّ تَعْضُدُني","مُطَهَّرُ العِرْضِ لا أدْنو من الدّنَسِ",35,"س",1,0],["إنِّي امرؤ كلّ الفكاهة حازها","والصّيْدُ كلُّ الصَّيدِ في جوفِ الفِرا",36,"ر",2,0],["إِنِّي امرؤ لا أرى خَلْعَ العذارَ على","مَن لا يقُومُ عَلَيهِ في الهوى عُذُري",37,"ر",2,0],["إنّي امرؤٌ ممّا طُرقت مُهَيّدٌ","بفراقِ أهْلي وانْتزاحِ بلادي",38,"د",2,0],["إِنّي اِمرُؤٌ أَسِمُ الصَبابَةَ وَسمَها","فَتَغَزُّلي أَبَداً بِغَيرِ المُغزِلِ",39,"ل",1,0],["إنّي امرؤٌ قَلَّ بينَ الناسِ أشباهي","إذ لا أزالُ غنيَّ النفس باللّهِ",40,"ه",1,1],["إِنّي اِمرُؤٌ مولَعٌ بِالحُسنِ أَتبَعُهُ","لاحَظَ لي فيهِ إِلّا لَذَّةُ النَظَرِ",41,"ر",1,1],["إِنّي اِمرُءٌ جَمُّ الطِماحِ إِلى الَّتي","تَرِثُ الفَتى شَرَفَ الحَياةِ وَتُعقِبُ",42,"ب",1,0],["إِنّي اِمرُؤٌ لَكَ لا لِغَيرِكَ ما أَني","مِنكُم أَشيمُ مَصاوِبَ الأَمطارِ",43,"ر",1,0],["إِنّي امرُؤلَجَّ بي حُبٌ فَاحرَضَني","حَتّى بَليِتُ وَحَتّى شَفَّني السَقَمُ",44,"م",1,0],["إِنِّي امْرُؤٌ حِرْفَتِي الحِسابُ فَلا","يَدْخُلُ رَيْبٌ عليَّ في حِسْبَهْ",45,"ب",2,0],["إنّي امرُؤٌ قَلبي يُحِبُّ مُحَمَّداً","ويَلومُ فيهِ لائِماً وَعَذُولا",46,"ل",2,0],["إني امْرُؤٌ أُعْطَى السُّلُوَّ قيادَهُ","وَأًراحَ مِنْ تَعَبِ المَلامَةِ عُذَّلَهْ",47,"ل",2,0],["إني امْرُؤٌ ما مَدَّ عينَ خَلاعَتي","طَمْعٌ لِدِينارٍ وَلا دِرْهامِ",48,"م",1,0],["إِنّي اِمرُؤٌ هِمَّتي وَاللَهُ يكلؤني","أَمرانِ ما فيهِما شُربٌ وَلا أَكلُ",49,"ل",1,0],["إني امرؤٌ أبغضُ النعاجَ وقد","يعجبني من نتاجِها الحمَلُ",50,"ل",1,1],["إِنّي اِمرُؤٌ عِندي لَكُم تَحبيرُ","أَنتَ اِبنُ أَملاكٍ لَهُم نَكيرُ",51,"ر",1,0],["إِنّي اِمرُؤٌ في الناسِ لَيسَ لَهُ أَخٌ","إِمّا يُسَرُّ بِهِ وَإِمّا يُغضَبُ",52,"ب",1,0],["إِنِّي اِمرُؤٌ قَد ظَلَمتُ نَفسِي وَإِلاَّ","تَعفُ عَنّي أُغلا دَماً كَثِما",53,"م",2,0],["إني أمت اليه","وإن تأخَّر عصري",54,"ر",2,0],["إني امرؤ لا أَجهرُ","إلا بما أَنا أَشعرُ",55,"ر",1,1],["إنى امرؤ بالصدق ذو ولع فما","أَصبو إلى جنف ولا أَرتاحُ",56,"ح",1,1],["إني امرؤ لَيسَ عندي للحياة يدٌ","فَما من الموت لي إن جاءَني رهب",57,"ب",1,0],["إني امرؤٌ عشتُ زما","ني حائراً معذَّبا",58,"ب",2,0],["إني امرؤ زادي على الذكريات","وما غلا عندي لا يرخصُ",59,"ص",1,0],["إِنّي اِمرُؤٌ أُبدي مُخا","لَفَتي وَأَكرَهُ أَن أُسِرّا",60,"ر",2,0],["إِنّي اِمرُؤٌ مِن خَيرِ عَبسٍ مَنصِباً","شَطرِي وَأَحمي سائِري بِالمُنصُلِ",61,"ل",1,0],["إِنِّي امْرُؤٌ مَلَكَ الودادُ قِيَادَتِي","وَجَرَى عَلَى صِدْقِ الْعُهُودِ وَفائِي",62,"ا",2,0],["إِنِّي امْرُؤٌ لا يَرُدُّ الخَوْفُ بادِرَتِي","وَلا يَحِيفُ عَلَى أَخْلاقِيَ الْغَضَبُ",63,"ب",1,0],["إِنِّي امْرُؤٌ كَفَّنِي حِلْمِي وَأَدَّبَنِي","كَرُّ الْجَدِيدَيْنِ مِنْ مَاضٍ وَمُقْتَبَلِ",64,"ل",1,0],["إِنِّي امْرُؤٌ لا يَرُدُّ الْعَذْلُ بَادِرَتِي","وَلا تَفُلُّ شَبَاةُ الْخَطْبِ إِزْمَاعِي",65,"ع",2,0],["إِنَّ ياماً أَوى إِلى جَبَلٍ يَو","ماً فَلَم يَعتَصِم مِنَ الماءِ يامُ",66,"م",1,0],["إني امرؤ ليسَ في ديني لغامِزَةٍ","لينٌ ولستُ على الأسلافِ طعّانا",67,"ن",2,1],["إن يأمنوا وجدوا المنايا يمنة","أو يأسروا وجدوا الجيوش شمالا",68,"ل",2,0],["إن يأمنوا وقع الأسنّة والظّبى","فالذّعر طاعنهم بشّر سنان",69,"ن",1,0],["إني امرؤ مستعيذٌ أَتُهَجِّنني","أو أن أُرى بحجابٍ منك مُمتَهِنا",70,"ن",2,0],["إنّي أمينٌ صَفِيٌّ الودِّ ذُو مِقَةٍ","مُعلمٌ لك هادٍ فاستمع خبَرِى",71,"ر",2,0],["أَنّى أَمُدُّ يَداً إِلى طَلَبٍ وَلي","مِن جودِ كَفِّكَ طارِفٌ وَتِلادُ",72,"د",1,0],["إِنّي اِمرُؤٌ إِن كَشَرتُ النابَ عَن غَضَبٍ","لا الخَطُّ يَمنَعُ مِن بَأسي وَلا هَجَرُ",73,"ر",1,0],["إنّي امرؤٌ قد اضرّ بي حنفي","قصّر بي عن منازِل الشرَفِ",74,"ف",1,1],["إِنّي اِمرُؤٌ في وُثاقِ الحُبِّ يَكبَحَهُ","لَجامَ هَجرُ عَلى الأَسقامِ مَعذور",75,"ر",1,0],["إني أمسُّ جوارحي فأظنُّها","جمراً تأجّج في لظى بُرَحائها",76,"ا",3,0],["إني أموت ببُعده وبصدِّه","وكذا أعيش بقربه وبعطفِهِ",77,"ف",2,0],["إنى امرؤٌ زادُه الذنوبُ","لا يسمع النصح لا يتوب",78,"ب",1,0],["أَنّي اِمرُوءٌ هَجرُ المَطامِعِ مَذهَبي","وَالصَونُ عادي وَالقَناعَةُ ديني",79,"ن",2,0],["اني أمرؤ يعييه أمر","هواه ان يخفى ضميره",80,"ر",2,0],["إِنّي اِمرُؤٌ مُهدٍ بِغَيبٍ تَحِيَّةً","إِلى اِبنِ الجُلَندى فارِسِ الخَيلِ جَيفَرِ",81,"ر",1,1],["إنّي اِمرؤٌ لَيسَ لدائي سِوى","هذي الَّتي أَنعَتُها من عِلاج",82,"ج",1,0],["إِنّي اِمرُؤٌ صافَ عَنّي مَن يُشاحِنُني","وَرَدَّني أَهلُ وُدّي مَعشَرٌ أُنُفُ",83,"ف",1,0],["إِنّي اِمرُؤٌ مِن بَني ذُبيانَ قَد عَلِموا","أَحمي شَريعَةَ مَجدٍ غَيرِ مَورودِ",84,"د",1,0],["إنِّي امرؤ لا أقيلُ الخصم عَثرَتَهٌ","عند الأمير اذا ما خصمهُ ظلعا",85,"ع",2,1],["إنّي امْرؤٌ أضَعُ الأقوالَ مَوْضعَها","فإنْ أرابكَ م