{"poems":[[43,"أبت بالشام نفسي أن تطيبا","https://www.aldiwan.net/poem42381.html","الوافر"],[29,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[31,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[47,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[89,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[154,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[190,"سبوت وآحاد تمر على الفتى","https://www.aldiwan.net/poem43362.html","الطويل"],[358,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[369,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[370,"تطاول ليلك بالأثمد","https://www.aldiwan.net/poem44362.html","المتقارب"],[408,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[422,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[422,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[447,"الحمد الله رب اللوح واللوح","https://www.aldiwan.net/poem14288.html","البسيط"],[466,"يود المسف الجون تحمله الصبا","https://www.aldiwan.net/poem15374.html","الطويل"],[567,"منازل عسفان فدتك المنازل","https://www.aldiwan.net/poem52753.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103066","البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67829","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72327","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112808","الوافر"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96345","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69412","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110662","البسيط"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105733","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104275","الهزج"],[3589,"","https://poetry.dctabudhabi.ae/diwan/poem/34906","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132190","الوافر"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35117","الطويل"],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4888,"يموتون ثلجا","https://www.poetsgate.com/ViewPoem.aspx?id=207769",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5225,"نصيحه منه تحتاج إلنصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=27612",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[2110,"سريت بها والليل داجي الحنادس","https://www.poetsgate.com/ViewPoem.aspx?id=156274",""],[5630,"أشاقكَ والليل مُلْقي الجِرانِ","https://www.poetsgate.com/ViewPoem.aspx?id=15429",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"أساريرُ فلسطيني أسير","https://www.poetsgate.com/ViewPoem.aspx?id=207867",""],[6115,"اذا كان داعش دولة الحق والأسلام","https://www.poetsgate.com/ViewPoem.aspx?id=181802",""]],"verses":[["سَبَوا قَلبي فَحَلَّ بحيث حلُّوا","ويُعظِمُ إِن دَعَوا أَلاَّ يُجيبَا",0,"ب",2,0],["سَبَوا نِسوَةَ النُعمانِ وَاِبنَي مُحَرِّقٍ","وَعِمرانَ قادوا عَنوَةً بِالخَزائِمِ",1,"م",1,0],["سَبّوا الحِمارَ فَسَوفَ أَهجو نِسوَةً","لِلكيرِ وَسطَ بُيوتِهِنَّ أُوارُ",2,"ر",1,0],["سبوق متى يطلبْ سبوقٌ لحاقَه","يفتْهُ به غَمْرُ البديهة مرْجَمُ",3,"م",1,0],["سبوحٌ مروحٌ رعيُهُ حيثُ وِرْدهِ","رغيبُ المِعا مهما استُطِفَّ له التقمْ",4,"م",1,0],["سَبوقٌ لِغاياتِ الحِفاظِ إِذا جَرى","وَوَهّابُ أَعناقِ المِئينَ حَمولُها",5,"ل",3,0],["سُبوتُ الإِصطِباحِ مُعَشَّقاتٌ","وَأَحظَهُنَّ سَبتُ المِهرَجانِ",6,"ن",1,0],["سَبُوقٌ إِذَا جَارَى لَحُوقٌ إِذَا هَوَى","غَلُوبٌ إِذَا بَادَى قَتُولٌ إِذَا أَهْوَى",7,"و",2,0],["سَبَوُا الرَّعِيَّةَ لَمْ يُبْقُوا عَلَى أحَدٍ","ولا أَمانَةَ لِلْقِبْطِ المَلاعِينِ",8,"ن",1,0],["سبوا وَبالسب راموا الحط من أَدَبي","كأَنَّما السب عند القوم برهان",9,"ن",1,0],["سَبوقٌ بِلا أَينٍ قَريبٌ بِلا مَدى","عَليمٌ بِلا خَطٍّ حَفيظٌ بِلا دَرسِ",10,"س",1,0],["سبوت وآحاد تمرّ على الفتى","وليل يغطيه وصبح يواصله",11,"ل",2,1],["سَبوح رَقيق الخَدّ أَوجنَ صافنٍ","إِذا جنَّ لَيل النَقع مِن رَكضِهِ جُنّا",12,"ن",2,0],["سَبوقٍ لخيلِ اللّيلِ والصُّبحِ عَفْوُهُ","على بُعْد شأوٍ للرّهانِ بَطين",13,"ن",1,0],["سبُوحاً جَمُوحاً وإِحضارُها","كَمعمَعةِ السَّعَفِ الموقَدِ",14,"د",1,0],["سَبَوْا بَعْدَ قَتْلِ ابنِ النبيّ حريمَهُ","وَمَا بَلِيتْ تَحتَ التّرابِ تَرائبُهْ",15,"ب",2,0],["سبوحٌ سرت ليلاً فسبحان من أسرى","تخيَّرتها دون السَّفائن مركبا",16,"ب",2,0],["سبُّوا أئمَّتنا وأنجمَ ديننا","من نرتجي يوم المعاد ونذخر",17,"ر",1,0],["سبوح قدوس علام الغيوب فلا","يدعى سواه بقدوس وسبوح",18,"ح",1,0],["سبوقٌ إِلى الغايات في كل مفخرٍ","يلينُ له وَعْرٌ ويقربُ شاسعُ",19,"ع",1,0],["سَبوقٌ إلى الغاياتِ قصَّرتُ دُونَهُ","وكيفَ يُباري فارسَ الخيلِ راجِلُ",20,"ل",1,0],["سبوحة سبحتها كل ناطقة","صلت عليها وعنها الدهر لم يصم",21,"م",1,0],["سَبُوقٌ وَإنْ كَانَ النَّبِيُّونَ قَبْلَهُ","تراهم غداً في الحشر يرجون فضله",22,"ه",1,0],["سبوا حريم رسول الله بل طعنوا","فيه بهم بأنابيب القنا اللدن",23,"ن",1,0],["سبوعا لم يقف حتى دعا بانكشاف","الماء كف عن الأنام",24,"م",1,0],["سبوقا لغايات يوم المدى","اذا ما الجياد علكن اللجم",25,"م",1,0],["سَبُوقٌ إِلى الغاياتِ مَرّاً أَحُثهُ","وَمَرّاً أُعَفِّيهِ وَمَرّاً أُناقِلُه",26,"ل",2,0],["سبوا النبي غصبوا الوصي","ضربوا البتول بلا ملامه",27,"م",2,0],["سَبُّوكُمُ جُهَّالُهُم فَسَبَبتُمُ","سُنَنَ الرَّسُولِ وَعَسكَرَ الإِيمَانِ",28,"ن",1,0],["سبوا نساه على عجف وعترته","جزر الأضاحي بأرض الطف قد جزروا",29,"ر",3,0],["سبوحٍ طموح الطرف يستنّ مِرجمٍ","أُمِرَّ كأمرارِ الرشاء المشُذَّبِ",30,"ب",1,0],["سبوح قد سرت ليلا","فسبحان الذي أسرى",31,"ر",2,0],["سَبوتا الرَجعِ مائِرَتا الأَعالي","إِذا كَلَّ المَطِيُّ سَفيهَتانِ",32,"ن",1,0],["سَبوحٍ أقبَّ كذئب القِفار","نبيل المراكم والمحزَمِ",33,"م",1,0],["سبُّوح يا ستَّار فاستر عيبي","عن ذي الشهادة وعن ذي الغيبِ",34,"ب",1,0],["سبوح تزدري بالبدر زهوا","منورة بنور الكهرباء",35,"ا",2,0],["سُبوحُ اليَدينِ طموحِ الجِرانِ","غؤُولٍ لأَنساعهِ والبِطانِ",36,"ن",1,0],["سبوحاً بلجّاتٍ كراقٍ سفينةً","تقاذفها الأمواج من دون دفَّةِ",37,"ه",1,0],["سَبوقاً مَغَبّاتِ الظَلامِ إِلَيهِما","لِيَقرِيَ ضَيفاً أَو يُجيرَ مُرَوَّعا",38,"ع",2,1],["سبو لابن مر نسوة ورووا لم","ية دمنة لا تبتإس فكذا قضى",39,"ا",1,0],["سبّورتي الملساءُ أخفتْ ظلّها","عن شمعتي، طبشورُها لا يَبرقُ",40,"ق",1,0],["سبوح قدوس في مداركنا","ندركه لا إله إلا الله",41,"ل",2,0],["سبوق الشّاردهْ منها طريحهْ","وباقيهن خمورٍ في المغابي",42,"ب",2,0],["سبِّوا عَلِيًا جِهَارًا فِي مَسَاجدِكُمْ","تِسْعينَ عَامًا وقُلتمْ: ذَاكَ مَغْفُولُ",43,"ل",1,0],["سبوح بقاموس الظلام كأنما","قوائمها هوج الرياح الدواهس",44,"س",1,0],["سبوح اليدين طموحِ الحرانِ","غؤُولٍ لأنساعه والبِطانِ",45,"ن",1,0],["سبوح تباري الريح في بعض غدوها","وتمرح بالخطى إذا ما تثنتِ",46,"ت",1,0],["سبوه أراضيه بالرغم عنه","وشاهد دارَه تُنسف نسفا",47,"ف",2,0],["سبوعين ربى لحيته ثم لبس حزام","ولو يعرف الله كان يخشاه ويجلّه",48,"ل",2,0]]}