400,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[405,"يا ناعما بسرور عيش زائل","https://www.aldiwan.net/poem49936.html","الكامل"],[406,"ولى ولم يقض من أحبابه وطرا","https://www.aldiwan.net/poem50171.html","البسيط"],[406,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[416,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[441,"إن العداوة لم تزل","https://www.aldiwan.net/poem14397.html","مجزوء الكامل"],[441,"وهبتك النصح لو طاوعت من نصحا","https://www.aldiwan.net/poem14423.html","البسيط"],[441,"هجيت ما بي وقد كشفت مكنوني","https://www.aldiwan.net/poem14489.html","البسيط"],[443,"لله ما أسعدني سيدتي","https://www.aldiwan.net/poem55922.html","عموديه"],[443,"إن الحبيب الذي لسنا نسميه","https://www.aldiwan.net/poem56042.html","عموديه"],[452,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[453,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[461,"حلفت بالواضحات الغر مسفرة","https://www.aldiwan.net/poem15907.html","البسيط"],[461,"لا تلطفن بذي لؤم فتطغيه","https://www.aldiwan.net/poem16077.html","البسيط"],[470,"إن الحسام وإن رثت مضاربه","https://www.aldiwan.net/poem4776.html","البسيط"],[479,"عاقبتني بالصد وهو عصيب","https://www.aldiwan.net/poem36947.html","الكامل"],[479,"من بطن أمك للجدث","https://www.aldiwan.net/poem37180.html","مجزوء الكامل"],[479,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[513,"هذا مقام فتي اضاع زمانه","https://www.aldiwan.net/poem67677.html","عموديه"],[529,"درر تلوح من السطور","https://www.aldiwan.net/poem37422.html","مجزوء الكامل"],[540,"إن الحديث تغر القوم خلوته","https://www.aldiwan.net/poem56824.html","البسيط"],[551,"لا تحذر البيض الصوارم والقنا","https://www.aldiwan.net/poem47372.html","الكامل"],[551,"تقول لي إنما الستون مقطعة","https://www.aldiwan.net/poem47829.html","البسيط"],[551,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[553,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[558,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[558,"إياك تشهد غيره ودع العنا","https://www.aldiwan.net/poem33787.html","الكامل"],[558,"يا مدعي العرفان فجرك كاذب","https://www.aldiwan.net/poem34926.html","الكامل"],[562,"ماذا التعلل في دنياك بالأمل","https://www.aldiwan.net/poem52780.html","البسيط"],[562,"المرء في الدنيا خيال قد سرى","https://www.aldiwan.net/poem52910.html","الكامل"],[562,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[562,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[575,"إن الحبيب ملالاً","https://www.aldiwan.net/poem2871.html","المجتث"],[576,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"],[586,"أهلا بوجهك لا حجبت عن نظري","https://www.aldiwan.net/poem17534.html","البسيط"]],"verses":[["إِنَّ الحَياةَ وَإِن غَرَّت مَخائِلُها","ظِلٌّ وَإِنَّ المُنى أَضغاثُ أَحلامِ",0,"م",1,0],["إنّ الحُروبَ سِجالٌ طالَما وَهَبَتْ","في اليومِ فُرْصَتَها واسْتَرْجَعَتْ لِغَدِ",1,"د",1,0],["إِنَّ الحَقيقَةَ أَصبَحَت هَدَفاً","لِلراكِبينَ مَراكِبَ الزَلَلِ",2,"ل",1,0],["إِنَّ الحَوادِثَ لا يَبقى لِنائِبِها","إِلّا الإِلَهُ وَراسي الأَصلِ مَعلومُ",3,"م",1,0],["إِن الحَياةَ أَطَالَ اللهُ عُمْرَكُمَا","لَيْسَتْ سِوَى لَفْظَةٍ وَالحُبُّ معنَاها",4,"ا",3,0],["إَِنَّ الحَقِيقَةَ حِينَ نَبْ","لُغُهَا لَتَكْفِينَا وَتُغْنِي",5,"ن",2,0],["إن الحجاز مغانيه بأندلسٍ","ألفاظها طابقت منها معانيها",6,"ي",3,0],["أن الحريق خبت نيرانه ومضت","وما خبت في فؤادي منه أو جال",7,"ل",1,0],["أن الحدائق لا تخّلد بإسمها","من لا تخّلد ذكره الآثار",8,"ر",1,0],["إن الحميّة لم تنظر بمُقلتها","إلى وسامَيكما إلاّ بكت حَزَنا",9,"ن",2,0],["إن الحكومة وهي جمهورية","كشفت عماية قلب كل مضلّل",10,"ل",1,0],["إن الحِصال التي تسمو الحياة بها","عزم وحزم وإقدام ومقتحم",11,"م",1,0],["إن الحديد على ما القَين يطبَعه","عليه في الكُور إن سيفاً وإن جَلَما",12,"م",2,0],["إن الحقيقة قالت لي وقد صدقت","لا ينفع العلم إلاّ فوقه عَلَم",13,"م",1,0],["أن الحياة ليقظة فعّالة","فالراقد الكسلان فيها بائد",14,"د",1,0],["أن الحياة على الكُدورة لم تجد","مثل الفنون لنفسها راووقا",15,"ق",2,0],["أن الحياة لفي ثلاثة أنهُر","تجري وأرضكِ حولهنّ مَوات",16,"ت",1,0],["إِنَّ الحَواريَّ لَو نادى فَوارِسَنا","لَاِستُشهِدوا أَو نَجا وَالقَومُ أَحرارُ",17,"ر",1,0],["إِنَّ الحَفافيثَ حَقّاً يا بَني لَجَإٍ","يُطرِقنَ حينَ يَسورُ الحَيَّةُ الذَكَرُ",18,"ر",1,0],["إِنَّ الحَجيجَ دَعَوا يَستَمتِعونَ بِهِ","تَكادُ تَرجُفُ جَمعٌ كُلَّما رَجَفوا",19,"ف",3,0],["إِنَّ الحَبيبَ الَّذي هامَ الفُؤادُ بِهِ","يَنامُ عَن طولِ لَيلٍ أَنتَ ساهِرُهُ",20,"ر",2,0],["إِنَّ الحِجاءَ إِلَيكُمُ لَبِعِلَّةٍ","فَتَحَشحَشوا إِنَّ الذَليلَ ذَليلُ",21,"ل",1,0],["إِنَّ الحَبيبَ الَّذي يُرضيهِ سَفك دَمي","دَمي حَلالٌ لَهُ في الحِلِّ وَالحَرمِ",22,"م",1,1],["إن الحُلَى عند الحسام وديعةٌ","ليست تضيع لديه لكن توجدُ",23,"د",1,0],["إن الحُقُود إذا تذكرها الفتى","تحيا حياة الجمر بالمِسعارِ",24,"ر",1,0],["إن الحياة نفيسةٌ مَوقوتةٌ","فانفَس بها عما يُريبُك وانفس",25,"س",1,0],["أنال حتى أعفَّ الملحفين معاً","بنائل سد أفواها وأجوافا",26,"ف",2,0],["إن الحلالَ لديه","على الضيوفِ مُحَرَّمْ",27,"م",1,0],["إن الحوادثَ قد غدونَ فواجعاً","فاشدُد إزاركَ لا يكنَّ فواتِنا",28,"ن",2,0],["إِنّا لَحَبّاسونَ عَكّافَةً بِنا","لِتَنظُرَ ما يَقضي إِلَيها الأَراقِمُ",29,"م",1,1],["إِنَّ الحَياةَ الروحُ بَعضُ عَطائِها","وَأَنا ثِمارُ الروحِ كُلُّ عَطائي",30,"ي",1,0],["إِنَّ الحَقائِقَ أَنتَ ناشِرٌ بَندَها","في حينِ كانَ العِلمُ كَالإِلحادِ",31,"د",1,0],["إِنَّ الحَوادِثَ في تَتابُعِها","أَبدَلنَني مِن ضِلَّتي رَشَدا",32,"د",2,0],["إِنَّ الحَياةَ حَبَتكَ كُلَّ كُنوزِها","لا تَبخَلَنَّ عَلى الحَياةِ بِبَعضِ ما",33,"م",2,0],["إِنَّ الحَياةَ مَعَ الجُمودِ قَذىً","وَمَعَ الحِراكِ بَشاشَةً وَهَنا",34,"ن",2,0],["إِنَّ الحَديدَ إِذا ما لانَ صارَ مُدىً","فَكُن عَلى حَذَرٍ مِنهُ إِذا لانا",35,"ن",2,0],["إِنَّ الحَياةَ قَصيدَةٌ أَبياتُها","أَعمارُنا وَالمَوتُ فيها القافِيَه",36,"ي",2,0],["إِنَّ الحَياةَ قَصيدَةٌ أَعمارُنا","أَبياتُها وَالمَوتُ فيها القافِيَه",37,"ي",2,0],["إِنَّ الحَلالَ وَخَنزَراً وَلَدَتهُما","أُمٌّ مُعامِسَةٌ عَلى الأَطهارِ",38,"ر",1,0],["إِنَّ الحَيا وَلَدَت أَبي وَعُمومَتي","وَنَبَتُّ في سَبطِ الفُروعِ نُضارِ",38,"ر",1,0],["إنَّ الحَيَاةَ وقد قضيْتَ","قُبَيْلَ معرفَةِ الحَيَاةْ",39,"ه",1,0],["إنَّ الحَيَاةَ صِراعٌ","فيها الضَّعيفُ يُداسْ",40,"س",1,1],["إنَّ الحَيَاةَ سُباتٌ","سينقضي بالمنايا",40,"ي",2,0],["إنَّ الحَياةَ كئيبةٌ","مَغْمورةٌ بِدُمُوعِها",41,"ه",2,0],["إن الحياة وغي وليس بظافر","في خوضها غير الكمي المعلم",42,"م",1,0],["إن الحياة كمشكلات كلها","أما المنون فوحده الحلال",43,"ل",1,0],["ان الحياة كلها","الى الحتوف صائره",44,"ر",2,0],["ان الحياة ولا غضاضة ان عفت","كالشعر تجدر بالفتى المتجدد",45,"د",1,0],["ان الحياة لمشكلات كلها","اما المنون فوحده الحلال",46,"ل",1,0],["ان الحياة لتبتغي","في عصرنا هذا انقلابا",47,"ب",2,0],["ان الحياة وغى وقد ينبو بها","سيف الشجاع ولا يكون كهاما",48,"م",2,0],["ان الحبيب لذي اودى الخضم به","هو القريض ومن يهواه جبران",49,"ن",1,0],["ان الحياة اذا حوت حرية","هي نعمة ما ان يراد زوالها",50,"ل",3,0],["ان الحياة جزيرة","والفن صرح في الجزيره",51,"ر",2,0],["ان الحقائق كالصباح جميلة","للناظرين وكالنجوم عوار",52,"ر",1,0],["إن الحياة وغى وقد","يهوي الشجاع من الصفوف",53,"ف",1,0],["ان الحياة ومضة","منك ابت ان تكمنا",54,"ن",2,0],["إن الحياة تبين حي","ث ترى لها وسطاً يناسب",55,"ب",1,0],["إن الحضارة في اطراد جديدها","خصم القديم وحرب كل تِلاد",56,"د",1,0],["إِنَّ الحَكيمَ نَبِيٌّ","لِسانُهُ مَعصومُ",57,"م",1,0],["إِنَّ الحِجابَ سَماحَةٌ وَيَسارَةٌ","لَولا وُحوشٌ في الرِجالِ ضَواري",58,"ر",2,0],["إِنَّ الحُسَينَ اِبنَ الحُسَي","نِ أَميرَ مَكَّةَ وَالإِيالَه",59,"ل",2,0],["إِنَّ الحَياةَ نَهارٌ أَو سَحابَتُهُ","فَعِش نَهارَكَ مِن دُنياكَ إِنسانا",60,"ن",2,0],["إِنَّ الحِجابَ عَلى فُروقٍ جَنَّةٌ","وَحِجابُ مِصرَ وَريفِها مِن نارِ",61,"ر",1,0],["إن الحسودَ وإن أراكَ توَدُّداً","منه أضرُّ من العدوِّ الحاقدِ",62,"د",1,0],["إن الحوادثَ بين أجنحةِ ال","أيامِ وهي سريعةُ الحَثِّ",63,"ث",1,0],["إن الحبائِلَ بُثَّتْ","من تحتِها في الترابِ",64,"ب",1,0],["إِنَّ الحَكيمَ لَهُ مَقالٌ سائِرٌ","يَلتَذُّهُ ما قالَ أُذنُ السام