{"poems":[[95,"أين المجاز فيهبط الإلهام","https://www.aldiwan.net/poem11414.html","الكامل"],[93,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[87,"عجبوا من المصفوع كيف تجمعت","https://www.aldiwan.net/poem7566.html","الكامل"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49190","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1417","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142031","الخفيف"],[302,"لمعت ليلا فقالوا لهب","https://www.aldiwan.net/poem33330.html","الرمل"],[443,"ولى فأسرع في الفراق وما شفى","https://www.aldiwan.net/poem2558.html","الكامل"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[466,"عجبوا لعلمي كيف أكتمه","https://www.aldiwan.net/poem16070.html","أحذ الكامل"],[556,"عج بوادي البشام علك أن تق","https://www.aldiwan.net/poem47214.html","الخفيف"],[563,"عجب وما هو بالعجب","https://www.aldiwan.net/poem34949.html","مجزوء الكامل"],[567,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62492","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48916","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111858","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104800","المديد"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62869","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205584","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85221","الكامل"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124150","الخفيف"],[164,"","https://poetry.dctabudhabi.ae/diwan/poem/127634","الكامل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126358","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97070","الخفيف"],[1536,"بَارَكَ اللهُ لِلأَمِيرِ أَبِي الْعب","https://www.poetsgate.com/ViewPoem.aspx?id=85707",""],[4955,"عجبٌ وإن تقرأ لهُ تلقَ العجبْ","https://www.poetsgate.com/ViewPoem.aspx?id=189714",""],[5804,"أبيات من مساجلة","https://www.poetsgate.com/ViewPoem.aspx?id=180668",""],[5956,"الظلم والطيبون","https://www.poetsgate.com/ViewPoem.aspx?id=192334",""],[6286,"لَمعَتْ ليلاً فقالوا لَهبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27561&r=&rc=10",""]],"verses":[["عَجَبٌ وَأَنْتَ السَّيْفُ أَنَّكَ مَوْرِدٌ","تَهْفُو الضِّعافُ إِليهِ وَهْيَ حَمَامُ",0,"م",1,0],["عَجَبوا مِنّي وَقالوا عَلَناً","قَد رَأَينا الصَخرَ في زَيِّ الأَنام",1,"م",1,0],["عجبوا من المصفوع كيف تجمعت","كل البلادة عند شخص واحد",2,"د",1,1],["عَجِبُوا للأُلَى رَموهم بمكرٍ","هُوَ أقوى من مكرهم وأشدُّ",3,"د",1,0],["عَجِبوا أَنَّ قانِصاً بَثَّ في الآ","فاقِ أَشراكَهُ فَصادَ غَزالا",4,"ل",2,0],["عَجَبٌ وَمَوْرِدهُّنَّ مِنْهَا وَاحِدٌ","أَنْ يَخْتَلِفْنَ عَلَى اتِّفَاقِ الْمَوْرِد",5,"د",1,0],["عجبوا أن يموت في ريّقِ العُمر","ويطوي كالبرق سفرَ حياته",6,"ت",2,1],["عجِبوا من نورها إذ أَشرقَت","وَشَذاها من سَناها أَعجَبُ",7,"ب",1,0],["عجبوا الدقة خصره وقد اغتدى","جسدي على حبيه منها أنحفا",8,"ف",2,0],["عَجبوا من وجودهم ومناهُم","بينما البؤسُ حَولهم طُوفانُ",9,"ن",1,0],["عجِبوا وقد لفَّ الجيا","دَ إلى المدى مِضمارُها",10,"ر",3,0],["عجبوا لعلمي كيف أكْتُمهُ","والشِّعْرُ عني سائرٌ يسْري",11,"ر",2,1],["عُج بوادي البشامِ علّك أَن تق","ضِيَ فيهِ حقّاً لأهل البشامِ",12,"م",1,1],["عجب وما هو بالعجبْ","نور بظلمته احتجبْ",13,"ب",1,1],["عَجِبوا من صَغيرِ ما لاحَ من أفْ","عالهِ والكبيرُ لا يُرضيهِ",14,"ي",2,0],["عَجَبٌ والقَضادُ يَقْعِد ذا الْقُ","وَّةِ عَنْ خُطْوِةِ الضَّعِيفِ الْعَجِيز",15,"ز",1,0],["عُج بوادي الأثْل وهنا","ثمَّ غرِّبْ تَأتِ أهلا",16,"ل",2,0],["عجبٌ وكفرٌ في ربوع تقهقرٍ","وهِدايةٌ وتُقىً بربع تجدُّد",17,"د",1,0],["عجبوا لمقتلةِ الكلابِ ولا أرى","عجباً لمن لم يدر معنى بخسهِ",18,"ه",1,1],["عُج بِوَادِى الرَّندِ وَالخَزَم","وَاسكُبَن لِلدَّمعِ مُنسَجِمِ",19,"م",1,1],["عَجِبوا لارتياحه بالعطايا","وارتياحُ الكريمِ غيرُ طَرِيفِ",20,"ف",1,0],["عجبوا كيف فاتهم يوم وافى","فرعَوْا عهده بذكر معادِ",21,"د",1,0],["عجب وأعجب منه ما فعلت","غزواته بمجرة الزهر",22,"ر",1,0],["عجبوا من عذاره بعد حولي","ن وما طال وهو غض النبات",23,"ت",1,1],["عجبوا لجبني عن تناولِ بذلهِ","والله ما استكثرتُ شيئاً هينّاً",24,"ن",2,0],["عجبوا لصبري في المصاب ولو دروا","ضربوا بحزني والبكا الأمثالا",25,"ل",2,0],["عجبوا أن رأوا حليمة صارت","بعد فقر من أكبر الأغنياء",26,"ا",2,0],["عج بوادي الغري واخضع إذا ما","شمت مثوى الوصي غوث المنادي",27,"د",2,0],["عَجَبٌ والقَضاءُ يُقْعِدُ ذا الْقُو","وَةِ عَنْ خُطْوَةِ الضَّعِيفِ الْعَجِيز",28,"ز",1,0],["عجبٌ وإن تقرأ لهُ تلقَ العجبْ","حتى المعاجمُ تشتكي منهُ الشغبْ",29,"ب",1,1],["عجبوا منّي وفي كفّي دواتي","أكتبُ الأشعارَ باللفظِ الرقيقِ",30,"ق",1,0],["عجبوا منّي وقالوا كيف هذا؟","قلت قد قطّع أعماقي أساهُ",31,"ا",2,0],["عجِبوا من نُورها إذْ أشرقَتْ","وشَذَها من سَناها أعجبُ",32,"ب",1,0]]}