{"poems":[[55,"لمن دمن بذي سلم وضال","https://www.aldiwan.net/poem29896.html","الوافر"],[53,"بكاؤكما يشفي وإن كان لا يجدي","https://www.aldiwan.net/poem10863.html","الطويل"],[68,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63894","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132707","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103852","الطويل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126355","السريع"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28672","الوافر"],[4978,"رد مشاكس","https://www.poetsgate.com/ViewPoem.aspx?id=177202",""],[5431,"القلب الوطن ...قصيدة سوريالية","https://www.poetsgate.com/ViewPoem.aspx?id=202071",""],[5770,"نجوى طائر","https://www.poetsgate.com/ViewPoem.aspx?id=178264",""]],"verses":[["تُنَغِّصُني بِأَيّامِ التَلاقي","مُعاجَلَتي بِأَيّامِ الزِيالِ",0,"ل",1,0],["تَنَغَّصَ قَبْلَ الرِّيِّ ماءُ حَياتِهِ","وفُجِّعَ منْه بالعُذُوبة والبَرْدِ",1,"د",1,0],["تَنَغَّصَ فيكَ بِالزَوراءِ عَيشي","وَبُدِّلَ زَينُ لَذّاتي بِشَينِ",2,"ن",1,0],["تنغَّصُ بالوَردِ في خدّها","إذا لم تجدْنِيَ في المجتنينا",3,"ن",2,0],["تنغُّمُ الطيرِ في الأشجارِ يُوقظني","إِذا كؤوسُهُمُ هَمَّتْ بإِنعاسي",4,"س",2,0],["تنغص خشية الهجران وصلا","تجود به فنشقى بالوصال",5,"ل",1,0],["تنغص عندي كل ما قد وصفته","ولم يهنني إذا غاب عني سيدي",6,"د",2,0],["تنغيص دنيانا قديمٌ فما","على اديم الارض شيءٌ جديد",7,"د",1,0],["تُنَغِّصُكَ الطَّعامَ وَكُلَّ عَيشٍ","وَتَمزُج ما يَسوؤك بِالشَّرابِ",8,"ب",1,0],["تنغنغ القومُ لا يُخشى افتقارهمُ","كيف الدماءُ إلى الدولار تنتقلُ !",9,"ل",1,0],["تُنغّمُ الآن موال الجياع وما","في خيمة البرد من بؤسٍ ومن شجنِ",10,"ن",1,0],["تُنغِّمُ الطيرُ بترنيمةٍ","فينتشي السربُ سميعاً مُجيب",11,"ب",1,0]]}