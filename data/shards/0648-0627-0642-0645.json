,"https://www.poetsgate.com/ViewPoem.aspx?id=131042",""],[4691,"السيد المقيم","https://www.poetsgate.com/ViewPoem.aspx?id=114273",""],[4755,"مطر القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=200000",""],[4767,"عقد الجمان","https://www.poetsgate.com/ViewPoem.aspx?id=178711",""],[4888,"غروب في ظلِّ الغُربةِ","https://www.poetsgate.com/ViewPoem.aspx?id=207740",""],[4898,"وطني الكبير !","https://www.poetsgate.com/ViewPoem.aspx?id=35778",""],[4981,"موعظة","https://www.poetsgate.com/ViewPoem.aspx?id=191763",""],[5057,"المسافات تخلق الإحترام","https://www.poetsgate.com/ViewPoem.aspx?id=207365",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5197,"يا عظيم الأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=131027",""],[5206,"صِرف النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187394",""],[5240,"عج بالكناس وعج بربع لم تزل","https://www.poetsgate.com/ViewPoem.aspx?id=171237",""],[5267,"من كل ذات روادف","https://www.poetsgate.com/ViewPoem.aspx?id=109427",""],[5273,"تناقض نبض","https://www.poetsgate.com/ViewPoem.aspx?id=198357",""],[5327,"رابعةُ الصُّمود","https://www.poetsgate.com/ViewPoem.aspx?id=147699",""],[5327,"غَيْبَةُ القِيَم","https://www.poetsgate.com/ViewPoem.aspx?id=176735",""],[5358,"طيرُ المَجَرّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=48735",""],[5376,"أرَّا ومارَّا والعواصمُ واحدُ","https://www.poetsgate.com/ViewPoem.aspx?id=196641",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5582,"بِاللهِ ما سَرَتْ الجَنُوبُ نَسِيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63576",""],[5596,"غيث الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205673",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5829,"قم لرمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212930",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5974,"في وجنتيها الحسن حط رحاله","https://www.poetsgate.com/ViewPoem.aspx?id=214828",""],[6045,"حبٌّ في أكفان موتى !","https://www.poetsgate.com/ViewPoem.aspx?id=125346",""],[6256,"تحية أدباء المغرب العربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65918&r=&rc=6",""]],"verses":[["وَأَقِم عَلى يَأسٍ فَقَد ذَهَبَ الَّذي","كانَ الأَنامُ عَلى نَداهُ عِيالا",0,"ل",2,0],["وأقَمْتَ في مِحْرابِهِ فكأنّهُ","مجْلىَ إناءُ الماءِ فيهِ عَروسُ",1,"س",1,0],["وَأَقَمْتَ فِيهَا مَأتَماً لَكِنَّهُ","عُرْسٌ لِنَسْرٍ بالْفَلاَةِ وَذيِبِ",2,"ب",1,0],["وَأَقَمتُم في كُلِّ أَرضٍ صُروحاً","تَنطَحُ السُحبَ شامِخاتٍ طِوالا",3,"ل",2,0],["وَأَقَمتَ جامِعَةً بِمِص","رَ تَشُدُّ أَزرَ العِلمِ شَدّا",4,"د",2,0],["وَأَقَمتُما فيها المَعاقِلَ مَنعَةً","مِن أَرضِ نَجدٍ إِلى خَليجِ عُمانِ",5,"ن",1,0],["وَأَقِم بِالسوسِ مُعتَكِفاً","كَاِعتِكافِ الطَيرِ بِالحَرَمِ",6,"م",1,0],["وأقمتني فيها خطيباً بالثنا","ومننت حتَّى باللباسِ الأسودِ",7,"د",1,0],["وأقمت متصل الرجاء بواحدٍ","لم يختلف في الفضل منه اثنان",8,"ن",1,0],["وأقمت للحق المنار على","لَقَم الطريق فبان مهيعه",9,"ع",2,0],["وَأَقَمتَ في ذاكَ البُعا","دِ وَطابَ فيهِ لَكَ الإِقامَه",10,"م",2,0],["وَأَقَمتِ بِالدَمِ جانِبَيهِ وَلَم تَزَل","تُبنى المَمالِكُ بِالدَمِ المَسفوكِ",11,"ك",1,0],["وَأَقَمتَ الصَلاةَ في مَعشَرٍ لا","يَعرِفونَ الصَلاةَ إِلّا مُكاءَ",12,"ا",2,0],["وأقمارُه حينَ تُبدي له","محاسنُها الصُّبحَ سِلمُ المساءِ",13,"ا",2,0],["وَأَقَمتُ أَرقُبُ وَصلَهُ","فَأَقامَ في هَجري القِيامَه",14,"م",2,0],["وَأَقَمتَ فيها وادِعاً مُتَمَهِّلاً","حَتّى ظَنَنّا أَنَّها لَكَ دارُ",15,"ر",1,0],["وَأَقَمتَ مِن أَوَدٍ هُناكَ وَهَهُنا","فَدَفَقتَ آراءً وَأَنتَ جَليلُ",16,"ل",1,0],["وَأَقمارُها حينَ يُخفي الظَلامُ","ضِياءَ النُجومِ وَنورَ القَمَرْ",17,"ر",1,0],["وَأَقِم لَنا الحَقَّ المُعَطَّلَ وَاِستَقِم","إِن مالَ أَزوَرُ في الحُكومَةِ أَنكَبُ",18,"ب",1,0],["وَأَقَمتَ مُغتَرِباً وَما اِغتَرَبَ اِمرُؤٌ","يَنأى فَيَتَّخِذ العَزائِمَ صاحِبا",19,"ب",2,0],["وَأَقَمْتَ ذاكَ العَضْبَ فيهمْ قاضِيا","ونَصَبْتَ تلكَ البيِّنَاتِ عُدولا",20,"ل",2,0],["وَأَقَمنَ قَتلى لِلمَقانِبِ وَالقَنا","بَعدَ الحَصانَةِ مَنهَلاً مَورودا",21,"د",2,0],["وَأَقمُسُ في لُجِّ النَوائِبِ طالِباً","وَيُغرِقُني مِن دونِ لُؤلُؤِهِ القَمسُ",22,"س",1,0],["وَأَقِمْ لَهُ صَرْحاً يَفِيئ","ه مُشَيَّداً حَتْى السمَاكْ",23,"ك",1,0],["وأقمت من محرابه فكأنه","مجلى إناء الماء فيه غروس",24,"س",1,0],["وأقمتَ فيها مأتماً لكنه","عرسٌ لنسر في الفلاة َ وذيبِ",25,"ب",1,0],["وأقَمت من يَومي لأمسيَ حاجزاً","وضَرَبت سَداً بينَنا النِسيانا",26,"ن",2,0],["وأقمنا على الكهانة فيه","والعبادات شاعرا عبقريّا",27,"ي",2,0],["وَأَقم إِذا جَنَّ الدُجا","مُتَرَديّاً ظلّ الكُروم",28,"م",1,0],["وأقمار الحمى تزهو بطرز","به اندمجت افانين الجمال",29,"ل",1,0],["وَأَقِم فَقَد قامَت لِبَأسِكَ هَيبَةٌ","لَم يَخلُ مِنها في الأَنامِ فُؤادُ",30,"د",1,0],["وَأَقمَنُ شَيءٍ بِالهَلاكِ مَدينَةٌ","تُريكَ نَبِيهَ القَدرِ مَن كانَ أَخمَلا",31,"ل",2,0],["وأَقَمتَ لِلقُرَشِيِّ في آرائِهِ","حُجَجاً يُقَصِّرُ دُونَها النُظّامُ",32,"م",1,0],["وأقمرتَ يا بدرَ الملاحة كلِّها","فما ضرَّنا البدرُ الذي ليس يقمرُ",33,"ر",1,0],["وَأَقَمتَ سوقاً لِلمَدائِحِ مُربِحاً","فَإِلَيهِ أَعلاقُ الفَضائِلُ تُجلَبُ",34,"ب",1,0],["وأقمتَ للملكِ الرفيعِ عمادَه","عَدلاً فأصبحَ ثابتَ الآساس",35,"س",1,0],["واقمع بحولك باغضيه وكل من","يؤذيه من متمرد مرتاب",36,"ب",1,0],["وأقمت فيهم منذرا وَمبشرا","بتعطف وَتَلَطف وتأدب",37,"ب",1,0],["واقمع بحولك مبغضيه وكل من","يؤذيه من متمرد متعصب",37,"ب",1,0],["واقمع بحولك حاسديه وكن له","حرما من المَكروه واحم حماه",38,"ا",2,0],["وأقمتُ أشكو لوعةً","وجوىً يقضّ مضاجعي",39,"ع",2,0],["وأقمت صبري حاصلاً وأضفت ما","وجبت إضافته على العشاق",40,"ق",1,0],["وأقمنا بطيبة الخير حينا","نتملى بنور بدر التمام",41,"م",1,0],["وَأَقمتُ أَنتَظِر الإجابةَ زاجراً","مِنها لِنجحِ السعيِ أيمن طائرِ",42,"ر",1,0],["وَاِقمَع هَواك وَلا يَغر","رك غيّ نَفسك بَعد رُشدك",43,"ك",1,0],["وَأَقم لي الاعذار في التَأخير عن","هذا المَقام المُبهج المتضوع",44,"ع",1,0],["وَأَقَمتُم عِرسا يُضىء كَإِنَّما","أَلدَهر مِنهُ كَوكَب وَضاح",45,"ح",1,0],["وَأَقَمتُ بَعدُ وَلِلزَمانِ عَجائِبٌ","مِنها تَرَحُّلُ مُهجَتي وَمُقامي",46,"ي",1,1],["وأَقمارٌ هَوادِجُها أفولٌ","وأَغصانٌ تَميلُ فَتَستَميلُ",47,"ل",1,0],["وأقمتَ في طُرقٍ تُعالِجُ داءهُ","بدَوائِهِ فنَجا من الأمراضِ",48,"ض",1,0],["وأقمنا بها ليالِيَ أُنْسٍ","ليس فيها هَمٌّ ولا أكْدَار",49,"ر",1,0],["وأقمارٌ غَرُبْنَ فَلَيْتَ شعري","ألا بعد الغروب لها طلوع",50,"ع",1,0],["وأقماراً تضيءُ على قدودٍ","وما لذوي الهوى إلّا الصداعُ",51,"ع",1,0],["وأقمار السعادة والتهاني","بذروة وكنها السامي ظواهر",52,"ر",1,0],["وأقِمْ بُرهةً بربعٍ شجاني","بعدَ يأسِ تذكّري أيامَهْ",53,"م",2,0],["وأقمتُ حيث المجدُ نائي المُرتَقى","وجَنى المكارمِ بالمواهبِ دانِ",54,"ن",1,0],["وأقمت الصلاة في ذلك الدر","ب وقد كانت الصلاة مكاء",55,"ا",2,0],["وأقَمْتَ حَدَّ اللهِ فِيمَنْ ضامَها","ضَرْباً بِحَدِّ الصارِمِ الصَّمْصامِ",56,"م",1,0],["وأَقَمْتَ لي سُوقَ المكارِمِ مُغْلِياً","بِجَوَاهِرِ الإِبْداعِ والإِغْرابِ",57,"ب",1,0],["وأَقَمْتَ تاجَ جَبينِهِ منْ بعدِما","عفَتِ المعالِمُ منهُ والآثارُ",58,"ر",1,0],["وأقمارُ حَربٍ طالِعَاتٌ كَأَنَّمَا","عَمَائِمُهُمْ فِي موقفِ الرَّوْعِ تِيجانُ",59,"ن",1,0],["وأقم دور اليعملاتِ محاولاً","باب المغرِ إذا الدليل تحَّيرا",60,"ر",2,0],["وأَقِمْ لي يا دمعُ لُجَّةَ بَحْري","بسُبوحٍ في الفَلاةِ بوَخْدِ",61,"د",1,0],["وأقم على نصحي وكن متحققاً","بمقالتي فمقالتي الفرقان",62,"ن",1,0],["وأقمنا على المحبة نلقى ال","غير عنها بحفظ عهد وثيق",63,"ق",1,0],["وأقِمْ لها سُوقاً تُنَفْ","فِقُها وَتَأْخُذُهَا تِجارَهْ",64,"ر",2,0],["وأَقمْتَ في عِشقِي تدب","رُه عليَّ بغير لُبِّ",65,"ب",1,0],["وَأَقمارٌ تُضيء لِكلِّ سارٍ","لَهَا مِنْ نُورِ حُسْنِكُمُ تَمامُ",66,"م",1,0],["وأقمت للندماء سوق خلاعة","يجبى المجون إلي فيه ويجلب",67,"ب",1,0],["وَأَقمت الحُدود في كُل حُكمٍ","فيهِ إِنصاف صامَت مَصدور",68,"ر",1,0],["واقمَعوا الخَصمَ الأَلدَّا","وَاقطعوا مِنهُ المَطامعْ",69,"ع",1,0],["وَأَقمارُ عز قَد تَوارى عبوسُها","فَجادَت عَلى الدُنيا بِأَبهَج نُور",70,"ر",1,0],["وأقمت بنيهم الصلاة فسلموا","إلا فريقاً ما يزال يثور",71,"ر",1,0],["وأقم لأهل الفضل مو","سمهم كما اعتادت علاك",72,"ك",1,0],["وأقمت دون مراصد ال","حدثان كالجبل الرصين",73,"ن",1,0],["وأقمنا وللسان مجال","بثناء يذكو شذا ويطيب",74,"ب",1,0],["وأقمتُ فرضاً للجميل وسنة","فإذا الوجود تحية وسلام",75,"م",1,0],["وَأَقِم عَلى الأَشلاءِ صَرحَكَ إِنَّما","مِن فَوقِهِ تُبنى العُلا وَتُقامُ",76,"م",1,0],["وأقمع لموت القلب بارد يابس","بضدهما والشيء بالضد يقمعُ",77,"ع",1,0],["وأقمت في ربع العلوم لك البقا","وسواك ممنوع عن استطراقها",78,"ق",3,0],["واقمع به كل جبار يعانده","وارحم به كل ملهوف ترجاه",79,"ا",2,0],["وأقمناك في مقام رضانا","وكسوناك خلعة التخبير",80,"ر",1,0],["وأقم بنده بنصر وفتح","وارتقاء وعزة ورشاد",81,"د",1,0],["وَأقمت لي في روض حبّك جنّةً","وَمنَ التجافي والصدودِ جَحيما",82,"م",2,0],["وَأَقمارُ رَوضٍ قَمَرنَ العُقولَ","وَغُزلانَ رَملٍ قَلَبنَ القُلوبا",83,"ب",2,0],["وَأَقَمتَ لِلإِعذارِ فيهِ مُعَرّساً","هُوَ جامِعٌ وَلِكُلِّ صَدرٍ شارِحُ",84,"ح",1,0],["وأقمتَ دولتهم لها سعة المدى","في الأرض يرحب ما يضيق ويبعد",85,"د",1,0],["وأقمت من لبنانَ حارسها","فكان المجد حارس",86,"س",1,0],["وأَقَمتُ في يومِ الخَميسِ مُبالِغاً","في الجمَعْ بَيْنَ طوائف الأَتراكِ",87,"ك",1,0],["واقمني بشاهد الصدق ادعو","ك منيبا وصالح النيبات",88,"ت",1,0],["وأَقَمْتُ في غُرَفٍ لَدَيْ","هِ كَأَنَّها غُرَفُ الجِنانِ",89,"ن",1,0],["وأَقْمتُ مُرْتضِعاً مَطالبَ من بني","نَبْهانَ مُنْتَجةً وأُخرى لُقَّحا",90,"ح",2,0],["وأقم في سلامةٍ وحبورٍ","رافَه البالِ مستطابَ العِراص",91,"ص",1,0],["وأَقم على مرّ الزمان ممدَّحاً","تُحبى صباحاً بالسنى ومَساءا",92,"ا",3,0],["وأقم سوقها على كل سوق","يا لَها متجر وَسوق ربيح",93,"ح",1,0],["وأقمت في شق العجوز مخيماً","والناس راجعة على ذنون",94,"ن",1,0],["وأقمار السماء وما حوتهُ","بأنّك لن تماثل في البوادي",95,"د",2,0],["وأقمار انسي غيبت من سمائها","وشمس وجودي حالها الكسف بالوجد",96,"د",1,0],["وأَقمتَ للأَشعار أَسْعاراً وكم","عَمَرَتْ وسِعْر بديعها مَوْكوسُ",97,"س",1,0],["واقِمنِ عبداً في العوالم شاكراً","وطّن لسرّي في الملا الصمداني",98,"ن",2,0],["وَأَقَمتَ رُكنَ المُلكِ بَعدَ نَوائِبٍ","مالَت عَلَيهِ فَمالَ مِن أَركانِهِ",99,"ه",1,0],["وأقمت كل خليقة معوجة","في سيف حسن خليقة وطباع",100,"ع",1,0],["وَأَقمَعنا فيها الوِطابَ وَحَولَنا","بُيوتٌ عَلَيها كُلُّها فوهٌ مُقبلِ",101,"ل",1,0],["وأقم فإن عطل الثرى من حليه","في خصب كل مشرق ومغرب",102,"ب",1,0],["وأقم لأهل السنة النبوية ال","انصار وانصرهم بكل زمان",103,"ن",1,0],["وأقَمتَ من قربانِهِ ما سنَّه الد","دين الحَنِيفُ قريبُهُ وبعيدُهُ",104,"د",2,0],["وَأَقِم لِمَن صافيتَ وَجهاً واحِداً","وَخَليقَةً إِنَّ الكَريمَ قَؤومُ",105,"م",1,0],["واقمت محراب الرفاهة للورى","فالناس فيه ركع وسجود",106,"د",1,0],["واقم لها مجداً تجلى سالفاً","باحاسن الاداب والعادات",107,"ت",1,0],["وَأَقَمتُمُ سوقَ الثَناءِ وَلَم تَكُن","سوقُ الثَناءِ تُقامُ في الأَسواقِ",108,"ق",1,0],["وأقمت في بلدٍ ونورك طالع","منها الى كل النواحي الضلع",109,"ع",1,0],["وأقمار تمٍ لم ير الناس قبلها","بدوراً تثنى تحتهن غصون",110,"ن",1,0],["وَأَقم مَناجلك الحداد بِزَرعه","قَد حانَ يا ابن الأَكرَمين حَصاده",111,"د",2,0],["وَأقم لِلصبا جِدار غَرام","كُلَّما رُمت نَقصه طالَ قَدرا",112,"ر",2,0],["وَأَقم لِعَبد اللَه عُذرك إِن تَكُن","ألمحت فَالحر الكَريم يَعود",113,"د",1,0],["واقمت تعظيم الشعائر حيث لا","تحتاج في التقوى إلى اثبات",114,"ت",1,0],["وأقمت أركان الشّريعة إثر ما","فينا تداعى ركنها وتهدّما",115,"م",2,0],["وَأَقِم فالقصور سَوفَ تحيّي","ك وَتحيي بِفَضلك الآمالا",116,"ل",2,0],["وأقمارُ الأماني طالعاتٌ","لرائيها فدونك يا بصيرُ",117,"ر",1,0],["وأقَمْتَ بالقَصْرِ الذي بنُجودِهِ","يُلْفَى الأمانُ لمنجِدٍ أو مُتْهِمِ",118,"م",1,0],["وأقِمْ صغا الإسلامِ في الوطنِ الذي","أضْحى يُطيعُ مقامَكَ المحْمودا",119,"د",2,0],["وأقمت عصراً في حما","ه فلم أقُل فيمَ الإقامه",120,"م",2,0],["وَأَقمارُ عزٍّ في مَنازلِ رفعةٍ","لَها بِاِقتِرانات السُعود تَجامُعُ",121,"ع",1,0],["وأقمنا مستمتعين بما نب","غيه بين الكؤوس والأوتار",122,"ر",1,0],["وأقم لهذا الملك سؤدده الذي","يبديه مرفوع المقام وقورا",123,"ر",2,0],["وأقمتَ فيض العلم صرحاً شامخاً","ووضعتَ للدين الحنيف منَابرا",124,"ر",2,0],["وأقمار المعالي لم يشنها","وليس يضرها نبح الكلاب",125,"ب",1,0],["وأقمار السماء تود نو أن","تكون لاخمصيها كالنعال",126,"ل",1,0],["وَأَقمتَ 