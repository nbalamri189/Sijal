ِ الأرضِ موتٌ حاصدُ",152,"د",1,0],["وأقمت قاعدة الهدى بمواقف","فيها قلعت لحصن خيبر بابا",153,"ب",2,0],["وأقمت أنت على الغر وقد نرى","فتك الردى ومصارع الأتراب",154,"ب",1,0],["وَأَقَمْتِ لِي مِنْ رَوْضِ حُسْنِكِ جَنَّةً","وَمِنَ التَّجافِي وَالصُّدُودِ جَحِيمَا",155,"م",2,0],["وأقم ضميرك حارسا متربصا","لخطاك واحذر خافي الزلات",156,"ت",1,0],["وأقم ببيت الدين واخضع إذ ترى","بحتف نصر اللّه بالأعوانِ",157,"ن",1,0],["واقمْ ليالي عشْرِهِ متحمساً","نفحاتُ دهرِكَ يا حبيبُ قﻻئِلُ",158,"ل",1,0],["وأقمت اسمي فيكم يدعوكم","بمناطق شتى لها منح",159,"ح",1,0],["وأقمتُ في الأحداق فرض غرامنا","فانهالت الأشواق خلفي سُجّدا",160,"د",2,0],["وأقمتُ أبكيه وأندب لوعتي","والقلبُ من فرْي الشجونِ تليدُ",161,"د",1,0],["وأقمنا مجدًا يتيه على الدهر","أنار الدنيا وأحيى الرقودا",162,"د",2,0]]}