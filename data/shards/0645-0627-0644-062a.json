6",""],[5302,"وسبت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=201220",""],[5307,"الامطار","https://www.poetsgate.com/ViewPoem.aspx?id=10541",""],[5376,"ماذا أقول وهذا القلب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=194861",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5425,"إِبْتِهَالْ","https://www.poetsgate.com/ViewPoem.aspx?id=198924",""],[5431,"لم تروها شفتي...","https://www.poetsgate.com/ViewPoem.aspx?id=190639",""],[5497,"مر السحائب","https://www.poetsgate.com/ViewPoem.aspx?id=210555",""],[470,"المنعطف","https://www.poetsgate.com/ViewPoem.aspx?id=18589",""],[5582,"قِفْ بِالدِّيارِ دِيارِ الحَيِّ مِنْ إِضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=63571",""],[5653,"أقبلن في الحبرات الخطى","https://www.poetsgate.com/ViewPoem.aspx?id=26438",""],[5691,"أفْوافٌ...!","https://www.poetsgate.com/ViewPoem.aspx?id=207696",""],[5725,"مالت","https://www.poetsgate.com/ViewPoem.aspx?id=197793",""],[5751,"العامليّة","https://www.poetsgate.com/ViewPoem.aspx?id=214762",""],[5781,"وارفةُ العشقِ...أنا","https://www.poetsgate.com/ViewPoem.aspx?id=190949",""],[402,"غلب الموت فالحياة ثكول","https://www.poetsgate.com/ViewPoem.aspx?id=36544",""],[5817,"فاتنة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191046",""],[5848,"ليلة السبت","https://www.poetsgate.com/ViewPoem.aspx?id=50605",""],[5943,"غرِّيدة","https://www.poetsgate.com/ViewPoem.aspx?id=21947",""],[6038,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=32327",""],[6124,"مالت","https://www.poetsgate.com/ViewPoem.aspx?id=120681",""],[6124,"أحلام العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=125194",""],[6127,"ظلمة واهمة","https://www.poetsgate.com/ViewPoem.aspx?id=188639",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[6152,"لأجلكِ عشقتُ ديارك","https://www.poetsgate.com/ViewPoem.aspx?id=203285",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""],[6320,"حَائِطُ الشَّجَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83619&r=&rc=0",""]],"verses":[["مَالَتْ فَوَارِسُهَا عَلَى أَعْرَافِهَا","وَهُمُ سُكَارَى مَا عَرَفْنَ مُدَامَا",0,"م",2,0],["مالَتا نَحوَ دَوحَةٍ تُرسِلُ الأَغ","صانَ وَاِختارَتا لَدَيها مُقاما",1,"م",2,0],["مالَتْ إِلَيْكَ وَمَا فِي قَدِّهَا مَيلٌ","وَمَا طَوَتْ غَيْر مَا تُبْدِي طَوايَاهَا",2,"ا",3,0],["مالَت كَمَيلِ النَقا لَيسَت إِذا جُلِيَت","مِن رُصعِ تَيمٍ يُنَطِّقنَ البَواسينا",3,"ن",2,0],["مالَت عَلَيكَ جِبالُ غورِ تِهامَةٍ","وَغَرِقتَ حَيثُ تَناطَحَ البَحرانِ",4,"ن",1,0],["مالَت بِهِ نَحوَها الجَنوبُ مَعاً","ثُمَّ اِزدَهَتهُ الشَمالُ فَاِنقَلَبا",5,"ب",2,0],["مالتْ علينا غصونُ العيش مُثقلةً","حملاً وقام عمودُ الحقِّ فاعتدلا",6,"ل",2,0],["مالت بقسطاس الحقوق نوازل","ومشت على ركن القضاء عواد",7,"د",1,0],["مالت برأسي فلم آمنْ يديِّ لها","على جُيوبي وأذيالي وأرداني",8,"ن",2,0],["مالَت جَوانِبُ عُرفِهِ فَكَأَنَّها","عَذَباتُ أَثلٍ مالَ تَحتَ حَمامِهِ",9,"م",2,0],["مَالَتْ خَمَائِلُهُ بِخُضْرِ غُصُونِهِ","وَصَفَتْ مَوَارِدُهُ بِزُرْقِ جِمَامِهِ",10,"م",2,0],["مالَتْ إلى مَنْ يميلُ عنها","فالزاهدونَ الملوكُ حقّا",11,"ق",2,0],["مالَت بِهِ كَبِدٌ إِلَيكِ رَقيقَةٌ","وَصَبابَةٌ تَسري لَهُ بِسُهادِ",12,"د",1,0],["مالت النفس بعدها إذ رأتها","فهي ريح وصار جسمي هباء",13,"ب",3,0],["مَالَتِ السِّنُّ بِاللِّدَاتِ وَما كَا","نَ سِوَى السَّمْهَرِيِّ حِين يَمِيلُ",14,"ل",1,0],["مالت على الشعرات البيض تقطفها","يارا وتضحك: لا أرضى لك الكبرا",15,"ر",2,1],["مالت له أُذُني من بعد جَفْوتِها","وكم حديثٍ تمنَّتْ عنده الصَمَمَا",16,"م",2,0],["مَالَ تيهاً كما تميلُ العَذارَى","هلْ على الزَّهر في الهوى من جُناحِ",17,"ح",1,0],["مالَت رِقابُ ثغورِ الشام مُصغيةً","إلى السرورِ الذي كانت تراقبُه",18,"ب",2,0],["مالت على الماء الغصون كما انحنت","أمٍّ تقبل طفلها المحبوبا",19,"ب",2,0],["مالت فوائقها على أعرافها","وهن سكرى ما عرفن مداما",20,"م",2,0],["مالت إليك بودّها","واستكتمتك مقالها",21,"ل",3,0],["ما لتلكَ اللحاظِ وهيَ حدادٌ","أصبحتْ في العدوِ غيرَ حدادِ",22,"د",1,0],["مالتْ دلالاً فارتمى شعرها","كالليلةِ الظلماءِ أو شبهها",23,"ه",2,1],["مالت ذوائبه ولاح جبينه","فتعارضا ليل وصبح مشرق",24,"ق",1,0],["مالَت إِلى مزيِّدِ","بالبِشر والتودُّدِ",25,"د",1,0],["مالتْ بمنقارِها القاني عَلَى عنقٍ","فخلتُ أَسوارَ ياقوتٍ بيمناك",26,"ك",1,0],["مالتْ إلى الغربِ تتلوها مشيعةً","مواكبٌ ناشرات حمرَ أعلام",27,"م",1,0],["مالتِ الخمرُ بأعطافِهما","من رأَى غصناً على غصنٍ يميلُ",28,"ل",1,0],["مالَت بِهِم عَنكَ دُنيا أَقبَلَت لَهُم","وَأَدبَرَت عَنكَ وَالأَيّامُ أَحوالُ",29,"ل",1,0],["مالَت عَليَّ فَقَد جعلت مَطيَّتي","ما بين أَجفان الدياجيَ ميلاد",30,"ل",3,0],["مالت على تلك الحجال أسابرٌ","أجناحها أمضى من الصمصام",31,"م",1,0],["مالت وقد ثملت بخمر دلالها","تهتزّ ما هزّ الغصون نسيم",32,"م",1,0],["مالَتْ نواحي عُرفِه كأنّه","تعثكُلُ القِنْوِ سريع كالهوا",33,"ا",1,0],["مالت بنا الآمالُ نحو فِناء مَنْ","أَفنى النُّضار فما انثنى عنهُ الثنا",34,"ن",2,0],["مالت إلى عذَّالها وإنما","لشقوتي مالت إلى عذَّالها",35,"ل",3,0],["مالتْ عليها غصونُ البانِ مونعةً","خُضْراً مطارِفُها مِن ادمُعِ الطَّفَلِ",36,"ل",1,0],["مالت لندوتنا الألباب قاطبة","ميل الكريم إلى الإنشاد والطرب",37,"ب",1,0],["مالت عليهم لغيظ غبية بركت","فيهم أحاديثهم في الناس كالحلم",38,"م",1,0],["مالت ملاحة الى بيع البها","بسطت بساطا ماله التعزيل",39,"ل",1,0],["مالت على الدهر ولكنه","لم يستند منك إلى مائل",40,"ل",1,0],["مالت عليهم بالتمالي أمة","باعت جزيل الربح بالخسران",41,"ن",1,0],["مالَتِ الريحُ عَلى أَباتِكُم","مِن لَظاها بِلَظىً فيهِ الدَمارُ",42,"ر",1,0],["مالت بها القوم صرعى عندما برزت","بها البطارق تسقيها الشماميسا",43,"س",2,0],["مالت إليك نواظر وقلوب","شهدت بأنك للجميع حبيب",44,"ب",1,1],["مالت على النهر إذ جاش الحرير به","كأنها إذن مالت لإصغاء",45,"ا",2,0],["مالت على يدهِ كأسٌ فملتُ لها","سكرى معربدةٌ في كفِّ سكرانِ",46,"ن",1,1],["مالت على طيِّ الجناحِ وإنما","جعلت أَريكتَها قضيبَ أراكِ",47,"ك",1,0],["مالٌ تمزّقَ في نهبٍ وَفي غرقٍ","إِن فات مالي سألقى منك آمالي",48,"ل",2,0],["مالت لتحجب شخصها فكأنها","صدت على الدنيا بساطا مذهبا",49,"ب",2,0],["مالَتْ مَعَطِفُهُنَّ مِنْ سُكْرِ الصِّبا","مَيْلاً يُخِيْفُ قُدُوْدَها أنْ تَسْقُطَا",50,"ط",2,0],["مالت لنشوتها النفوس لانها","حلت هناك محملة الارواح",51,"ح",1,0],["مالتْ الخمرُ ميلاَ","فيسَّرَتْ ما تعسَّرْ",52,"ر",1,0],["مالتْ إليَّ ولي نفسٌ أُقهْقرها","بالوعظِ عما يؤديها إلى التلف",53,"ف",1,0],["مالتْ بِغصن الدَّوْح نَسْمَتهُ فهل","طمعٌ لنا من بَعدُ في استقلاله",54,"ل",2,0],["مالٌ تقضّا أحداث الزمان وعن","جوادِ الحوادثِ في أمنٍ وفي حرمِ",55,"م",1,0],["مالت إِلى التوديع واِنشطّت لها","كفّ يصافحني البنانُ مخضبا",56,"ب",2,0],["مالت الأرضُ بالهوى من جديدِ","وسرى البوح في الربى والصرود",57,"د",1,1],["مالت لتحجب شخصها فكأنها","مدت على الدنيا بساطاً مذهباً",58,"ب",2,0],["مالَت عليَّ تُفدِّيني وترُشفُني","كما يميلُ نسيمُ الرِّيحِ بالغُصنِ",59,"ن",1,0],["مالَت لَها عَن أَوجِها فَكَأَنَّها","فَسَحَت لَها بَينَ النُجومِ سَبيلا",60,"ل",2,0],["مالت طرباً أغصانه راقصة","لما صدح الطير عليها وشدا",61,"د",2,0],["مَالَت عليهم مَعلواتُكَ مَيلَةً","خَضعُوا لها لَيسَ الصَّباحُ بمُنكَر",62,"ر",1,0],["مالت قدودهم تُغري لواحظهم","واستأثروا كلّ مطعون ومضروب",63,"ب",1,0],["مالت عن الوادي","أيام أعيادِ",64,"د",1,0],["مالت بنا الأيام نحو المغرب","مهما يشرق كوكب نغرب",65,"ب",1,0],["مالت بنا وأماله سكر الصبا","فنديمها كمديرها يتأوَّد",66,"د",1,0],["مالَت بِقامَتِها يابانَةُ اِعتَدِلي","شَدَت بِأَنغامِها يا بُلبُلُ اِستَرِق",67,"ق",1,0],["مالَت مَعَ الواشي وَماسَ قَوامُها","فَرَأَيتُ ليَّ عُهودِها في قَدِّها",68,"ه",2,0],["مالت غصونُ الروض جازعةً","من هول مصرع غصنك النضر",69,"ر",1,0],["مالت جَوانب تَخت الملك وَاِعتَدَلَت","سُرعان ما مال تَخت المُلك وَاعتَدَلا",70,"ل",2,0],["مالت بقرطيه على عارضه","نشوة راحين شبيبة ودل",71,"ل",1,0],["مالت تسائلني إذ مثلها يسل","خود خدلجّة ألفاظها عسل",72,"ل",1,1],["مالت بأعناقهم أيدي اللثام دجى","فأقبل الفجر يبكي ما جنى السحر",73,"ر",1,0],["مالت إلى النهر إذ جاش الخرير به","كأنها أذنٌ مالت لإصغاء",74,"ا",2,0],["مالَت إليه تُرَجّي أَن ترغّبه","عَن نفسه فأَراها أَيما شمَم",75,"م",1,0],["مالت عَلي وَحدرت عَن ثَغرِها","وَجمانه المَنظوم وَالمَنضود",76,"د",1,0],["ما لت على وجناته بفروعها","والأصل احكام الهوى في المغرم",77,"م",1,0],["مالَت إِلى كلّ الجِها","ت كأنَّها شربت شُمولا",78,"ل",2,0],["مالتْ بنا طَرباً أو لوْعَةً فحَكَتْ","كأسَ المُدامِ أمالَ القوْمَ مُتْرَعُهُ",79,"ع",2,0],["مالت بنا تلكَ المعاني عَنوةً","فكأَنَّما كُلٌّ لديك ثَمُولُ",80,"ل",1,0],["مالت على القوس ترمينا على غرر","من الظلام بلا وري ولا نغم",81,"م",1,0],["مَالَت عَلَيَّ بِكاسٍ غُصناً اثقَلَهُ","أترُجُّهُ وَبِهَا مِن نَومٍ اسكَارُ",82,"ر",1,1],["ما لتلك الكف لا تلبي وَقَد","احرمت كفين من تحصيل زاد",83,"د",1,0],["مالت إلى الإِغريقِ رأفَتُهُ","فأَرادَ أَن تَستَدفِعَ الضُّرَّا",84,"ر",2,0],["مالت الشمس وقد حجبها","حالك الغيم إلى نحو المغيب",85,"ب",1,1],["مال تكفلت الجباة بعسفهم","إحضاره لخزائن اللذات",86,"ت",1,0],["مالت فقلت لها يا بانة اعتدلي","وإن جبلت على التعطاف والميل",87,"ل",1,1],["ما لت أولو الفضل ايه والعلا","للمح ما قد كان عنه نقلا",88,"ل",2,0],["مالتْ تودعني والدمعُ يغلبها","على الكلامِ فلا تستطيع تبيانا",89,"ن",2,0],["مالت بذكر مديحه أعطافنا","وتلذّذت بسماعه أسماعنا",90,"ن",2,0],["مالت عليَ تغديني وترشفني","كما يميل نسيم الريح بالغصن",91,"ن",1,0],["مالت إليهِ القلوبُ طَوعاً","فكلنا سامعٌ مُطيعُ",92,"ع",1,0],["مالت الشمسُ مساءً للمغيبْ","فبدتْ للعين في مرأىً عجيبْ",93,"ب",1,1],["مالت عليك وغالت كلَّ أمنيةٍ","طافت بأحلام قلبٍ ينزف الشعرا",94,"ر",2,0],["مالت إليه بُعيدَ ما","قد هيأتْهُ لها أمم",95,"م",1,0],["مالت الدنيا بنا إذ أدبرت","فغدونا اليوم فيها الغرباءْ",96,"ا",2,0],["مالَتْ عليَّ بِدلِّها ودلالِها","لولا الحياءُ لَقُلْتُ أنّي أَحْلُمُ",97,"م",1,0],["مالَتْ تَقُولُ وَسِحْرٌ في تألُّقِها","والوجْهُ يقْطُرُ أشْواقاً وتَحْنانا",98,"ن",2,0],["مالتْ عليَّ ، وقدُّها الأزهارُ","(فالقب من ميلانها موّارُ)",99,"ر",1,1],["مالتْ بنا سفنُ الرَّخَاءِبأمْنِها","والحرُّ قد خَنَقَتهُ يدُ العُدْوانِ",100,"ن",1,0],["مالت لطافت شوق وتناثر أفكار","قمريةٍ ترسم من البعد لآلي",101,"ل",2,0],["مالت فَقُلتُ عساها أن تميلَ لنا","مالت ولَكِن عن الوفاءِ بالذِّمَمِ",102,"م",1,0],["مالت غصونُ الشوقِ عند مرورها","وتراقصت من غنجها الأوتارُ",103,"ر",1,0],["مالَت