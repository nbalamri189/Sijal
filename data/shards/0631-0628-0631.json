8","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132933","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131256",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135851","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105561","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125866","الخفيف"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103267","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133117","الرجز"],[4929,"الزمان الأجنبي","https://www.poetsgate.com/ViewPoem.aspx?id=199262",""],[5031,"غريبٌ عن جسد العراق","https://www.poetsgate.com/ViewPoem.aspx?id=165138",""],[5136,"رب روح من المعاني لطيف","https://www.poetsgate.com/ViewPoem.aspx?id=121537",""],[5213,"أكثرا من ملامتي أو أقلا","https://www.poetsgate.com/ViewPoem.aspx?id=170511",""],[5414,"لحن الوفاء …","https://www.poetsgate.com/ViewPoem.aspx?id=180859",""],[5436,"صبر ايوب / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177648",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5720,"سُبْحَانَ الله","https://www.poetsgate.com/ViewPoem.aspx?id=204966",""],[5732,"دار لنا","https://www.poetsgate.com/ViewPoem.aspx?id=177832",""],[5741,"رب روض أزرته بدر تم","https://www.poetsgate.com/ViewPoem.aspx?id=187456",""],[5970,"عش غريباً وارتحل عنها غريباً","https://www.poetsgate.com/ViewPoem.aspx?id=130603",""],[572,"أَكْفِنَا يا عَذُولُ شرَّ لسانِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9418&r=&rc=275",""]],"verses":[["رُبَّ رَفدٍ هَرَقتَهُ ذَلِكَ اليَو","مَ وَأَسرى مِن مَعشَرٍ أَقتالِ",0,"ل",1,0],["رُبَّ رامٍ مِن بَني ثُعَلٍ","مُتلِجٍ كَفَّيهِ في قُتَرِه",1,"ر",2,1],["رُبّ راحٍ بتّ أشربها","من يديْ عذب اللما خنث",2,"ث",1,1],["رُبَّ روحٍ مِثلُ روحي عافَتِ الدُنيا المُضِرَّه","فَاِرتَقَت في الجَوِّ تَبغي مَنزِلاً فَوقَ المَجَرَّه",3,"ر",2,0],["رب رأى للفرد كالسيف ماض","يخرق المأثورات والاجماعا",4,"ع",2,0],["رُبَّ رُغبٍ نَقَّبتُ عَنهُ فَلَم يَب","عُد وَنُجحٍ نَشَطتُهُ مِن عِقالِه",5,"ل",2,0],["رَبُّ رُشدٍ مُلَقَّبٍ بِضَلالٍ","وَشَقاءٍ مُلَقَّبٍ بِنَعيمِ",6,"م",1,0],["ربّ رأيٍ لك جَهّزْتَ به","جحفلاً ذاقَ العدى منه الشجب",7,"ب",1,0],["رُبَّ رسَّامٍ مليحٍ","حَسَنِ الطلْعةِ كاسِمهْ",8,"ه",1,1],["رُبَّ رَكبٍ عَرَّسوا ثُمَّ هَبّوا","نَحوَ إِسراجٍ وَشَدِّ رِحالِ",9,"ل",1,1],["رُبَّ ريمٍ كانَ فيها","يَملَءُ العَينَ جَمالا",10,"ل",2,0],["رَبُّ رَوحٍ كَطائِرِ القَفَصِ المَس","جونِ تَرجو بِمَوتِها التَسريحا",11,"ح",2,0],["رُبَّ رَبعٍ كَأَنَّهُ النُجمُ في العِزِّ","أَتاهُ رَيبُ الزَمانِ فَجيسا",12,"س",2,0],["رُبّ رِماحٍ طَعَنَتْ في العِدى","وهْيَ الرّمَاحُ القَصَبِيّاتُ",13,"ت",1,0],["رُبَّ رَكبٍ قَد أَنَاخُوا عِندَنا","يَشرَبُونَ الَخمرَ بِالماءِ الزُّلال",14,"ل",1,0],["رُبَّ رَأْيٍ أَنالَ مَا لَمْ يَنَلْهُ","بَطْشُ غَازٍ بِعَسْكَرٍ وَعَتَادِ",15,"د",1,0],["ربّ رحماك فالمتاه طويل","والدجا في الطريق حيران أبكم",16,"م",1,0],["رُبّ رَغْبٍ نَقّبْتُ عَنْهُ فَلَمْ يَبْعُدْ","ونُْجحٍ، أنشَطتُهُ من عِقَالِهْ",17,"ل",2,0],["ربّ روحي طليقة في سماواتك","والجسم موثّق مغلول",18,"ل",1,0],["رُبَّ رَكبٍ قَد أَناخوا حَولَنا","يَشرَبونَ الخَمرَ بِالماءِ الزُلال",19,"ل",1,0],["ربّ رُعبٍ منهم لعجمٍ وعُربٍ","دونَ حربٍ به العدا حرباءُ",20,"ا",2,0],["ربّ رحماك بالفتاة ورفقا","فكفاها ما حمّلاها كفاها",21,"ا",3,0],["ربّ رحماك بالحبيب إذا ما","عاد والشوق شفّه للقاها",21,"ا",3,0],["ربِّ رُحماكَ لا تُذلَّ فُؤادي","بِحَبيبي وَلا تَجهَّم مَسائي",22,"ا",2,0],["رب ريح يوم الدواء دبورٌ","شوشت في عصاعص الأغبياء",23,"ا",2,0],["رب رَحيم مشفق متعطف","لا يَنتَهي بالحصر ما أَعطاه",24,"ا",2,0],["رب رحيم مخلف ومعوض","ما فات بالأَضعاف والإكثار",25,"ر",1,0],["رُبَّ رأي بالخطب يفعل ما لا","يفعل السَّمهريُّ والصَّمصام",26,"م",1,0],["ربَّ ريحينِ بين شدٍّ وليْنٍ","ذي سُمومٍ تُرْدي وتلك نَسيمُ",27,"م",1,0],["رُبَّ رِفْدٍ وإنْ تكاثرَ عدّاً","قَلَّ من فَرطِ كَثرةٍ التَّردادِ",28,"د",1,1],["ربَّ روحٍ بجملةٍ من كلامٍ","وكلامٍ للسمع فيه مدام",29,"م",1,0],["رُبَّ ريحٍ لِأُناسٍ عَصَفَت","ثُمَّ ما إِن لَبِثَت أَن سَكَنَت",30,"ت",1,1],["رُبَّ رَاحٍ بَاكَرْتُهَا فِي دَمَنْهُو","رِكَ مَعَ مَنْ تَوَدُّ أَوْ حُلْوَانِكْ",31,"ك",1,0],["رُبَّ رَاح شَرِبْتُها اليومَ صِرْفاً","مِنْ ثَنَاياهُ ثُمَّ قُلْتُ لَه سِرْ",32,"ر",1,0],["رب راى لولا زنادك لم يو","ر وخطبٍ فصله بخطابِ",33,"ب",1,0],["رب رحب أثاره بجواد","تؤذن الأرض تحته بارتعاد",34,"د",1,0],["ربُّ رفقٍ في رعاياه حليمْ","كم حوى من كل فخر واقتنى",35,"ن",2,0],["رب رأس تكلل الشيب فيه","وتراه يقل عقل غلام",36,"م",1,0],["رب رؤف رازق متفضل","مرضاته تغنى عن استمداد",37,"د",1,0],["رب رجراجة تموج أشتعالا","وسط هيجاء ظلمة دهماء",38,"ا",2,0],["رَبّ رُحْمَاكَ لِمَنْ أحْيَيْتَهُ","خَيِّراً عَفاً وَقَدْ زَارَ الحَرَمْ",39,"م",1,0],["رب رحماك لركب نزلوا","ساحة الجود ومأوى المعتضين",40,"ن",1,0],["رب رحماك إليك المشتكي","أترى العميان يوما يبصرون",41,"ن",1,0],["ربِّ رُحماك إليك المشتكى","هل يفيق القوم من نومهم",42,"م",1,0],["رُبَّ ريحين تجريان بضر","وبنفع فزَعزَع ورخاء",43,"ا",2,0],["ربَّ رامٍ عن مثل حاجبه","بمثل ألحاظه لمغرمهِ",44,"ه",1,1],["رُبَّ رَوضٍ قد حلَلنا دَوحَهُ","وتمتّعنا اغتباقاً واصطِباحا",45,"ح",2,1],["ربٍّ رحماك بالشريعة والحكام","والمصلحين والمصلحات",46,"ت",1,0],["رب روض يجتني ثمرا","قد ذوي ثم انقضى ثمره",47,"ر",2,0],["رب ردف يهتز ثانيَ عطف","منه ترمي بثالثات الآثافي",48,"ف",2,0],["رب ركب ملازمٍ لذميل الس","سير مالازم الغراب النعيبا",49,"ب",2,0],["ربَّ رَنقٍ قد سقانيه","وصافٍ من سجاله",50,"ل",2,0],["رب رج قبر النبي بعرفٍ","من شذي الصلاة والتسليم",51,"م",1,0],["ربَّ رَبعٍ وقفتُ فيه وعهدٍ","لمْ أجاوزه والركائبُ تسري",52,"ر",2,1],["رب روضٍ خِلتُ آذر","يُونَه لَّما تُوقد",53,"د",1,1],["رب رفقاً بمن خلقت فقد عم","البلاء الأنام شيخاً وطفلا",54,"ل",2,0],["ربِّ رجائي فيك لا يخيبُ","وأنت قادرٌ كذا مجيبُ",55,"ب",1,0],["رب رب أنالني منه سمعا","فكلام الصديق يحسن وقعا",56,"ع",2,0],["ربرب أشنب أحوى أحور","ناعس الأجفان نشوانٌ وصاح",57,"ح",1,0],["ربِّ رحماك ثغرةٌ بعد أُخرى","تتوالى فينا بلا ترميم",58,"م",1,0],["رب رحماك عاجل الظلم بالعد","ل مجيب الدعاء غوث الأنام",59,"م",1,0],["رب رؤف راحم عليم","فكم عفى عن عاصيين قبلي",60,"ي",1,0],["ربِّ رُحْماكَ مسَّنا الضُّرُّ فاجبُرْ","كَسرنَا وارحمْ ضعفَنَا يارحيمُ",61,"م",1,0],["رب ٌ رحيم ٌ لا شحيح ٌ فَضلُه ُ","وتَطوف ُ حَولك َ بالرًحيق ِ كِعابُها",62,"ب",3,0],["رب روح من المعاني لطيف","حملته أجسام عفص وزاج",63,"ج",1,1],["رب ركب سرى بهدوة ليل","ما اختبرناه أين أم وحلا",64,"ل",2,0],["رب راقد في التراب سيبقى","خالدَ الذكر، فائق النبضات",65,"ت",1,0],["ربربٌ مرّ في الفلاةِ وفيه","شادن الحسنِ هدّنا منه نأيُ",66,"ي",1,0],["رُبَّ روْض ٍكأنَّهُ جَنَّة ُالخُلْدِ","لديْهِ ما تشْتَهيهِ العُيونُ",67,"ن",1,0],["رَبٌ رَحِيْمٌ .. كَلَمَا عَثَرَتْ","أَقْدَامُنَا .. أَوْ قَارَفَتْ لَمَمَا",68,"م",2,0],["ربرب طهاه وما طره بالمهل جاد","وسكر هواه وصب صافي صدوقه",69,"ق",2,0],["رب روض أزرته بدر تم","حين غالى في تيهه والتجري",70,"ر",2,1],["رب رأى كان عذباً ناضجاً","عد من يأتيه خداعاً كذوباً",71,"ب",2,0],["رُبّ راحٍ باكَرتُها في دمنهو","رِكَ مَعْ مَنْ تودّ مِنْ خُلاّنِكْ",72,"ك",1,0]]}