{"poems":[[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[48,"نحن في الفرقة طرا","https://www.aldiwan.net/poem66286.html","مجزوء الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[116,"يا رجال البطاح يا ساداتي","https://www.aldiwan.net/poem41205.html","عموديه"],[194,"يا سروري بنيل تحفة خل","https://www.aldiwan.net/poem13045.html","الخفيف"],[276,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[354,"لو كان يوفي في الهوى بوعوده","https://www.aldiwan.net/poem40393.html","الكامل"],[480,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[563,"يا راحلين إلى الديار الباقيه","https://www.aldiwan.net/poem52885.html","البسيط"]],"verses":[["هو زيّ يزيد في الحسن حسناً","من تزيّا به وفي الطيب طيبا",0,"ب",2,0],["هو زينٌ غير شينٍ","هو شاهُ وابنُ شاهِ",1,"ه",1,0],["هو زاد الأسير في القيدِ باتت","نفسه من موارد الحتف قابا",2,"ب",2,0],["هُوَ زَيْنُ فِتْيَةِ مِصْرَ وَابْ","نُ مُلوكِهَا الصِّيْدُ الكِرَامِ",3,"م",1,0],["هو زخري وركن ظهري وفخري","وامامي وموئلي في حياتي",4,"ت",2,0],["هُوَ زَينُ الأَدآبِ تَفتَرُّ مِنهُ","عَن سِراجِ العُيونِ مِلءَ الصُدورِ",5,"ر",1,0],["هُو زانَ إِخوَتَه وَهم زانوا الهُدى","فكأنه بَيْتُ القَصيدِ مُجَوَّدا",6,"د",2,0],["هُوَ زينة النادي وَبَدر سَمائه","وَهِلال بَهجته وَشَمس سُعودهِ",7,"د",2,0],["هو زهرة في كمها","ذبلت وكادت تطلع",8,"ع",1,0],["هُوَ زُبدةُ الأمراضِ في جُمهورِها","مثلَ الخُلاصةِ من بيوتٍ الكافيَهْ",9,"ي",2,0]]}