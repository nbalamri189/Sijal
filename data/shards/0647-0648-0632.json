{"poems":[[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[50,"نحن في الفرقة طرا","https://www.aldiwan.net/poem66286.html","مجزوء الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[119,"يا رجال البطاح يا ساداتي","https://www.aldiwan.net/poem41205.html","عموديه"],[197,"يا سروري بنيل تحفة خل","https://www.aldiwan.net/poem13045.html","الخفيف"],[280,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[358,"لو كان يوفي في الهوى بوعوده","https://www.aldiwan.net/poem40393.html","الكامل"],[484,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[567,"يا راحلين إلى الديار الباقيه","https://www.aldiwan.net/poem52885.html","البسيط"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145601","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188164","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198482","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198481","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198479","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198476",""],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198395","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198392","الكامل"],[2362,"","https://poetry.dctabudhabi.ae/diwan/poem/198790","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83225","الكامل"],[3249,"","https://poetry.dctabudhabi.ae/diwan/poem/198804","الكامل"],[3429,"","https://poetry.dctabudhabi.ae/diwan/poem/198731","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89210","الكامل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32421","الكامل"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20944","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139523",""],[4830,"لسانُ جَناني","https://www.poetsgate.com/ViewPoem.aspx?id=194090",""],[4858,"أريج مدرسة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=34591",""],[4858,"الى الام التي ترضع طفلها الحليب الصناعي","https://www.poetsgate.com/ViewPoem.aspx?id=138297",""],[4940,"سيف التجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=210451",""],[5628,"اقرعي الطبول","https://www.poetsgate.com/ViewPoem.aspx?id=178532",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""]],"verses":[["هو زيّ يزيد في الحسن حسناً","من تزيّا به وفي الطيب طيبا",0,"ب",2,0],["هو زينٌ غير شينٍ","هو شاهُ وابنُ شاهِ",1,"ه",1,0],["هو زاد الأسير في القيدِ باتت","نفسه من موارد الحتف قابا",2,"ب",2,0],["هُوَ زَيْنُ فِتْيَةِ مِصْرَ وَابْ","نُ مُلوكِهَا الصِّيْدُ الكِرَامِ",3,"م",1,0],["هو زخري وركن ظهري وفخري","وامامي وموئلي في حياتي",4,"ت",2,0],["هُوَ زَينُ الأَدآبِ تَفتَرُّ مِنهُ","عَن سِراجِ العُيونِ مِلءَ الصُدورِ",5,"ر",1,0],["هُو زانَ إِخوَتَه وَهم زانوا الهُدى","فكأنه بَيْتُ القَصيدِ مُجَوَّدا",6,"د",2,0],["هُوَ زينة النادي وَبَدر سَمائه","وَهِلال بَهجته وَشَمس سُعودهِ",7,"د",2,0],["هو زهرة في كمها","ذبلت وكادت تطلع",8,"ع",1,0],["هُوَ زُبدةُ الأمراضِ في جُمهورِها","مثلَ الخُلاصةِ من بيوتٍ الكافيَهْ",9,"ي",2,0],["هو زهرة الدنيا وباب سرورها","فاعهد وسُرَّ به الأنامَ وأبهج",10,"ج",1,0],["هو زين لها وليس ببدع","أن يزين الرياض صوب العهاد",11,"د",1,0],["هو ( زايد) الخيرات كون كامل","تلقى به أمل الوجود مديدا",12,"د",2,0],["هُوَ ((زايِدُ)) الخَيْراتِ يَرْعَى شَعْبنَا","بالصّالِحَاتِ بِحِكْمَةٍ وَقَرارِ",13,"ر",1,0],["هو زايِدٌ حَقَنَ الدّماءَ بِحِكْمِةٍ","بَسَطَ السّلامَ على الخليجِ الهَادي",14,"د",2,0],["هُوَ ((زَايِدٌ)) حَطّ الرِّحالَ فَمَرْحَباً","دَامَ الوَفِىُّ عَلَى مَدَى إنْسانِهِ",15,"ن",2,0],["هو ((زَايِدُ)) العِمْلاَقُ نَشهَدُهُ","يَبْني الصّرُوحَ بلاهب الشُّهُبِ",16,"ب",1,0],["هو ((زايِدٌ )) للإِتّحادِ زعامةٌ","بتعاون مع إخوة أنجاد",17,"د",1,0],["هُوَ ((زايِدٌ))رَمْزُ التّجمّعِ حَاشِداً","وَليَعْرُبٍ في قِمَّةِ الرُّوّادِ",17,"د",1,0],["هو زايدٌ تَخِذَ السّبيلَ إلى العُلا","سبقَ الجميعَ لقمّة العَليْاء",18,"ا",2,0],["هو زايد الخيرات عز رجالها","قلب المحبة واليد البيضاء",19,"ا",2,0],["هو زايد السيب العميم لأمة","شهدت لفيض بنانه البلواء",19,"ا",2,0],["هو زايد القلب الكبير بأمة","شقت ظلال سيوفها البغضاء",19,"ا",2,0],["هو زايد الحب الذي لا ينتهي","العنفوان وقد كساه رواء",19,"ا",2,0],["هُوَ زينَةُ الوادي وَمَجرى عِزِّهِ","وَمَلاذُنا بَعدَ الإِلَهِ تَضَرُّعا",20,"ع",2,0],["هو زايد الخير الذي منه استحت","أنهارها وبحارها وسحابها",21,"ب",3,0],["هو زايدُ التاريخِ والنورُ الذي","نادى بنا العلياءَ هيّا انقادِ",22,"د",1,0],["هو زايدٌ والخيرُ منه بزائدٍ","في كلِ أرجاء الوجودِ يُنادي",22,"د",2,0],["هو زادُها وقريةٌ في فعلِةِ","وصنيعُ زايد مادَ بالأمجادِ",22,"د",1,0],["هو زينة الدنيا وملجأ أهلها","وذكاؤه قبسٌ من الأقباس",23,"س",1,0],["هَوَّزُ فوهُ وَأَنفُهُ","كَلَمُنَّ في إِحدى الصِفاتِ",24,"ت",1,0],["هُوَ زَينُ الوَجهِ لِلمَرءِ كَما","زَيَّنَ الطَرفَ تَحاسينُ القُزَح",25,"ح",1,0],["هو زوج العلا وفرد المعالي","حصنُها الأرفع المنيع جنابا",26,"ب",2,0],["هوَ زهرةٌ يغوي الفراشةَ عبقُها","أَو قطرةٌ تغفو على الأفنانِ",27,"ن",1,0],["هوَ زفرةٌ هوَسَكرَةٌ هوَ عَبرَةٌ","هوَ نَشوَةٌ هوَ حِكمةُ الكُهّانِ",27,"ن",1,0],["هو زهر أشجار المحبّة ، فاق في التّقدير تِبْرا","هو يُثمر العيش الهنيء ،قلا ترى في النّاس شرّا",28,"ر",2,0],["هو زينة الدّنيا وبهجةُ عمرنا","فإذا رعيناه ازدهت أُخرانا",29,"ن",2,0],["هو زائر يأتي إليك بناره","في ذلك اسأل عاشقا أو صبَّا",30,"ب",2,0],["هو زادي وشرابي لا غنى","عَنْه لولاه لما عِشْتُ طويلا",31,"ل",2,0],["هُوَ زَهْوُ الصِّبَا التَّقيِّ وَشَوْقٌ","مَنْ عَفافٍ وَزِيْنَةٌ في بُرُودِ",32,"د",1,0]]}