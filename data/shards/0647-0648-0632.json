{"poems":[[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[50,"نحن في الفرقة طرا","https://www.aldiwan.net/poem66286.html","مجزوء الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[118,"يا رجال البطاح يا ساداتي","https://www.aldiwan.net/poem41205.html","عموديه"],[196,"يا سروري بنيل تحفة خل","https://www.aldiwan.net/poem13045.html","الخفيف"],[278,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[356,"لو كان يوفي في الهوى بوعوده","https://www.aldiwan.net/poem40393.html","الكامل"],[481,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[564,"يا راحلين إلى الديار الباقيه","https://www.aldiwan.net/poem52885.html","البسيط"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/20944","الرمل"]],"verses":[["هو زيّ يزيد في الحسن حسناً","من تزيّا به وفي الطيب طيبا",0,"ب",2,0],["هو زينٌ غير شينٍ","هو شاهُ وابنُ شاهِ",1,"ه",1,0],["هو زاد الأسير في القيدِ باتت","نفسه من موارد الحتف قابا",2,"ب",2,0],["هُوَ زَيْنُ فِتْيَةِ مِصْرَ وَابْ","نُ مُلوكِهَا الصِّيْدُ الكِرَامِ",3,"م",1,0],["هو زخري وركن ظهري وفخري","وامامي وموئلي في حياتي",4,"ت",2,0],["هُوَ زَينُ الأَدآبِ تَفتَرُّ مِنهُ","عَن سِراجِ العُيونِ مِلءَ الصُدورِ",5,"ر",1,0],["هُو زانَ إِخوَتَه وَهم زانوا الهُدى","فكأنه بَيْتُ القَصيدِ مُجَوَّدا",6,"د",2,0],["هُوَ زينة النادي وَبَدر سَمائه","وَهِلال بَهجته وَشَمس سُعودهِ",7,"د",2,0],["هو زهرة في كمها","ذبلت وكادت تطلع",8,"ع",1,0],["هُوَ زُبدةُ الأمراضِ في جُمهورِها","مثلَ الخُلاصةِ من بيوتٍ الكافيَهْ",9,"ي",2,0],["هُوَ زَينُ الوَجهِ لِلمَرءِ كَما","زَيَّنَ الطَرفَ تَحاسينُ القُزَح",10,"ح",1,0]]}