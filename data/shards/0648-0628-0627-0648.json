{"poems":[[99,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[119,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[139,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[358,"يا سرورا على القلوب تجلى","https://www.aldiwan.net/poem39588.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104696","الكامل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101415","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133970","الخفيف"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123511","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[5150,"حوران .. الثورة ..!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202805",""],[5908,"أسفر الحي حين زارت نوار","https://www.poetsgate.com/ViewPoem.aspx?id=170973",""]],"verses":[["وبأوتاره المنى","تتلاقى وتزدحم",0,"م",1,0],["وبأولادها وكل ولي","وبأهل الخشوع والأذكار",1,"ر",1,0],["وبا وسخره وشغلْ كتير","الله يساعدكَ يا ناصف",2,"ف",1,0],["وَبِأولادِكم رُقيّة عبد ال","لَهِ مِنهم وللبتول اِرتقاءُ",3,"ا",2,0],["وَبِأَوراق دَوحها الورق غنَّت","فَشجت قَلب مُغرَمٍ ما تَسلّى",4,"ل",2,0],["وبأوْساطٍ على حَذ","وِ الزنانير حذاها",5,"ا",3,0],["وباولي الاصدار والايراد","ساداتنا سلسلة الاوراد",6,"د",1,0],["وَبأَولِياءِكَ قُدِّسَت أَسرَارُهُم","أَهلِ الهُيامِ وَالإصطِلامِ مِنَ السَّكَر",7,"ر",1,0],["وباولاة الهوى قوموا بنصر فتى","حقوقه بينات وهي تنكرها",8,"ر",3,0],["وبأوصاف مدحه شهد الكو","ن دليلاً على اعتراف الخصوم",9,"م",1,0],["وَبِأوُلَى أشِر لِجَمعٍ مُطَلَقَا","وَالمَدُّ أولَى ولَدَى البُعدِ انطِقَا",10,"ق",2,0],["وباؤا بأوباء وآلوا الى الردى","ومسهم البأساء والضر والضغط",11,"ط",1,0],["وبأولياء اللَه منك العاملي","ن الخائضين من العلوم بحارا",12,"ر",2,0],["وبأوج روما لم تهُنْ بل قدَّمتْ","\"فيليبَها\" ملكاً على الرومانِ",13,"ن",1,0],["وبأوصاف جعفر تتحلى","إي وآبائه الكرام الديار",14,"ر",1,0]]}