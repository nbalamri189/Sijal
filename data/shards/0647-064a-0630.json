{"poems":[[88,"سخر العلم ليبني آية","https://www.aldiwan.net/poem10359.html","الرمل"],[85,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[85,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[119,"هيج البعد هواها","https://www.aldiwan.net/poem40431.html","عموديه"],[119,"أه من يوسف قلبي","https://www.aldiwan.net/poem40883.html","عموديه"],[333,"أنا وحدي أواه من أنا وحدي","https://www.aldiwan.net/poem55016.html","الخفيف"],[563,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[563,"نشأة الروح بالغروب الطلوع","https://www.aldiwan.net/poem34385.html","الخفيف"],[567,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38324","الخفيف"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142216","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145971","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108486","الكامل"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144366","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68031","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83133","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139651",""],[4679,"يا خليلي لك الهناء بخود","https://www.poetsgate.com/ViewPoem.aspx?id=142796",""],[4690,"من القلب إلى القلب","https://www.poetsgate.com/ViewPoem.aspx?id=131041",""],[4755,"دُرَّةُ الطِّين","https://www.poetsgate.com/ViewPoem.aspx?id=183558",""],[4755,"هِيَ لَم تَنُحْ بالأمسِ هابِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=184710",""],[4898,"إنّا هُنا !","https://www.poetsgate.com/ViewPoem.aspx?id=35811",""],[4955,"صدر الحقيقة كم يعاني من ألم","https://www.poetsgate.com/ViewPoem.aspx?id=193788",""],[5102,"غنائم حربك","https://www.poetsgate.com/ViewPoem.aspx?id=12895",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5187,"تجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=29696",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5277,"الزاجلةُ رابحة","https://www.poetsgate.com/ViewPoem.aspx?id=198632",""],[5277,"بلا عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=204814",""],[5596,"تتابُع الأكدار","https://www.poetsgate.com/ViewPoem.aspx?id=206775",""],[5628,"الكأس والدموع","https://www.poetsgate.com/ViewPoem.aspx?id=178704",""],[5644,"من هي حواء","https://www.poetsgate.com/ViewPoem.aspx?id=211090",""],[5691,"غراب صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=206340",""],[5691,"شموع","https://www.poetsgate.com/ViewPoem.aspx?id=206531",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""],[5775,"العمر جمره","https://www.poetsgate.com/ViewPoem.aspx?id=35140",""],[402,"عاد عهد المدير في اعين الناس","https://www.poetsgate.com/ViewPoem.aspx?id=36831",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5956,"هذي الأنوثة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182150",""],[5956,"أقصوصة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[5956,"لا تستطيع على الشتاء القارس","https://www.poetsgate.com/ViewPoem.aspx?id=184408",""],[5956,"يومَ الخميس حبيبتي قد سافرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=215905",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[6198,"المهاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79235&r=&rc=9",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""],[4890,"أرض الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72998&r=&rc=200",""]],"verses":[["هِيَ ذِكرٌ خالِدٌ لَكِنَّهُ","عابِسُ الوَجهِ إِذا الذِكرُ اِبتَسَم",0,"م",1,0],["هيذ هي أم العجائب","وبها تحدى النجائب",1,"ب",1,0],["هيذ أعطتنا التجارب","فملك قشتِلّ هارب",1,"ب",1,0],["هيذ تحفة سنيّا","أشكرَ اللّه الذي أولاك",2,"ك",1,0],["هي ذي الدفاتر ناطقات في يدي","بكمال ضبط الدخل والنفقات",3,"ت",1,0],["هيَ ذاقتْ من يدِ اللّهِ انتقاما","لآثامِ خالدٍ عاماً فعاما",4,"م",2,0],["هِيَ ذِكْرَى بِمِثْلِهَا العِزَّةُ الفَعْ","سَاءُ فِي كُلِّ أُمَّةٍ تُسْتَدامُ",5,"م",1,0],["هي ذاك الحي لاش","ك من الكون ماها",6,"ا",3,0],["هي ذي الدنيا كطيف","فاذكر السير وخفف",7,"ف",1,0],["هي ذُلٌّ وعزّةٌ واقتدار","وهي ذلّى وعزّةُ المتحدّي",8,"ي",1,0],["هي ذات الخال فيها","لم تجد إلا لهيفا",9,"ف",2,0],["هي ذاتٌ لها صفاتٌ وأفعا","ل ولا غير عند أهل الخشوع",10,"ع",1,0],["هِيَ ذَلِكَ الإِكسيرُ صُنعُ اللَهِ لا اُل","إِكسيرُ مِمَّا يَصنَعُ الإِنبيقُ",11,"ق",1,0],["هِيَ ذِكرى الحبيبِ فَهيَ حَياةٌ","فَأَدِمْها لَعَلّها تُحييني",12,"ن",2,0],["هي ذي بداية رحلة قدسية","في لج بحر ما خشيت غماره",13,"ر",2,0],["هِيَ ذي بلادُكَ فاتخِذْ","مِنها خِصَالَكَ وَالفِعَالا",14,"ل",2,0],["هِيَ ذاتي عَن سِماتي اِنفَصَلَت فَإِنا","لَستُ أَنا بَعد نَواها",15,"ا",3,0],["هي ذات البروج سبعٌ طباقٌ","كلَّ يوم بديعها في شانِ",16,"ن",1,0],["هي ذات حسن بالكمال وصفتها","ولسان حالي بالحقيقة ناطق",17,"ق",1,0],["هي ذهن وحكمة ومضاء","وكلام في وقته وسكوت",18,"ت",1,0],["هي ذاتٌ سرُّ الوجودِ من الل","هِ وشمسٌ قَدْ اهْتُدِي بِضياها",19,"ا",3,0],["هِيَ ذِكرى بَعدَ المَشيبِ وَسَلوى","في اِكتِهالٍ وَصَبوَةٌ لِلفَتيِّ",20,"ي",1,0],["هي ذروة الشرف التي أركانها","شيدت بذروة عزِّة المتشيِّد",21,"د",1,0],["هي ذات الذكاوانت النجيب الباهر","الوصف الفائق الألمعية",22,"ي",2,0],["هي ذي النّدامة تعتريك ألَم تري","كيف استدار الوَغد بعد القاضيه ؟",23,"ي",2,0],["هِيَ ذِي قُرُونٌ عَشْرَةٌ عَبَرَت","مِنها وبِنتُ الحُسْنِ حَسناءُ",24,"ا",2,0],["هِيَ ذِي تَعُودُ اليَومَ قاسِمَةً","أوجَاعَهُ الكُبرَى سَرَابِيلا",25,"ل",2,0],["هِيَ ذِي حِكَايَتُنَا الَّتي لا تَنْتَهِي","مَا دَامَ يَجْرِي وَحْشُ الاسْتِيْطَانِ",26,"ن",1,0],["هي ذي العلاماتُ التي ظهرت وقد","دنت القيامةُ فاستفيقي يا أممْ",27,"م",1,0],["هي ذي الغنائم فاقتسمها بينهم","لك نصفها فلتعتبره حلالا",28,"ل",2,0],["هي ذيالك المجرد لكن","تخذت أجمة الطبيعة غيلا",29,"ل",2,0],["هِيَ ذي الرَّسائلُ بين أوراقي هُنا","هِيَ ذي التَّواقيعُ الصغيرةُ تشهدُ",30,"د",1,0],["هِيَ ذِي \" وَفَاءُ \" أُخيَّةٌ عَرَبِيَّةٌ","غَلَبَتْ \" نَعَمْ \" فِيهَا جَحَافِلَ \"لائها\"",31,"ا",3,0],["هِيَ ذِي فِلِسطِينُ الحَبِيبَةُ تَكتَوِي","صُبحاً ولَيلاً مِن لَظَى أَعدَائِهَا",31,"ا",3,0],["هي ذلك الإحساسُ يملكُ داخلي","وتملّكتْ قلبي هوىً بهواها",32,"ا",3,0],["هي ذاتُها روحٌ تهيمُ بروحِها","وأنا لها جسدٌ بلا عنوانِ",33,"ن",1,0],["هي ذلك الظِلُّ الظليلُ لكل مَن","لَفحتْهُ هاجرةُ العناءِ فهانا",34,"ن",2,0],["هي ذي الكأسُ بقايا من دموعي","ونديمي لهب بين الضلوع ِ",35,"ع",1,1],["هي ذلك البيت الذي يزهو بها","بحنانها وبعطفها وضّاءْ",36,"ا",2,0],["هيَ ذيْلُ أمْريكا فليْسَ بها","لكنْ برَبَّتِها العَناوينُ !",37,"ن",1,0],["هي ذي الشموعُ على الدروب مضيئة ٌ","تَهدي الخُطى عبرالظلام ِالأقتَم ِ",38,"م",1,0],["هي ذي طرابلس الأبية تلتقي","أحبابها الثوار بالتكبير",39,"ر",1,0],["هي ذكرياتك باقيه للسعاده","والا السعاده ذكرياتك وماضيك",40,"ك",1,0],["هي ذكرى بمثلها العزة","القعساء في كل أمة تستدام",41,"م",1,0],["هي ذلك القلب المبادر إن أتت","حيناً علينا دورة الدولاب",42,"ب",1,0],["‏هي ذات خد لست أنسى نسْجَهُ","‏ ‏ وجمالها بالأمس منّي نُوْدِيا",43,"ي",2,0],["هي ذات إسلام فقط في زيجة‎","مثنى .. رباعا فاقتِ التعدادا‎",44,"د",2,0],["هي ذلة الأيام قد نصحتْ لنا","أسمى النصائح من فؤاد بائسِ",45,"س",1,0],["هي ذات عدوانيةٍ مشهورةٍ","ومع الشعوب كرامِهِنَّ تشاجرتْ",46,"ت",1,0],["هي ذلك الجَبَلُ الّذي","يَرْوي حِكَايَةَ مَجْدِنَا",47,"ن",2,0],["هي ذي الشمس يشرئبُّ سناها","حاملاً لؤلؤاً يرشّ الوجودا",48,"د",2,0],["هي ذلة نحيا لها","فعلام نحيا كلنا؟",49,"ن",2,0],["هيَ ذي الضريبةُ إن أرت فكن لها","حصنٌ تسامى يلعن الجُهلاء",50,"ا",2,0],["هِيَ ذِي ؟ أُسَائِلُ خَافِقاً مُتَرَنِّحاً","مِن خَمرِ عَينَيهَا ، كَوَتهُ النَّارُ",51,"ر",1,0],["هِيَ ذِي ؟ نَعَمْ ! جَاوَبتُنِي ، حَتَّى وإِنْ","وَارَى مُحَيَّاهَا البَهِيَّ خِمَارُ",51,"ر",1,0],["هي ذي أرض العذابْ","لا غَدٌ آتٍ ولا ريحٌ تُضيءُ",52,"ي",2,1]]}