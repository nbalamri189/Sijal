ى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[440,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[442,"أودع من لا أستطيع وداعه","https://www.aldiwan.net/poem14325.html","الطويل"],[442,"أعيدي بديع النوح ويك أعيدي","https://www.aldiwan.net/poem14453.html","الطويل"],[442,"رضى بما قدر الباري وألزمنا","https://www.aldiwan.net/poem14486.html","البسيط"],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[459,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[459,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[462,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[462,"ترفعت عن مدح الرجال وقادني","https://www.aldiwan.net/poem15117.html","الطويل"],[462,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[462,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[462,"بقيت لكل مكرمة وبأس","https://www.aldiwan.net/poem15428.html","الوافر"],[462,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[462,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[465,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[465,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[465,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[465,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[478,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[483,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[516,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[552,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[552,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[552,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[552,"متى يبدي الكثيب لنا غزاله","https://www.aldiwan.net/poem47314.html","الوافر"],[552,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[552,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[552,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[559,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[576,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[576,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"]],"verses":[["فَلا مَرحَباً بِالبَيتِ لا فيهِ مَفزَعٌ","لِلاجٍ وَلا لِلمُستَجِنُّ عِمادُ",0,"د",1,0],["فَلامَ عَلى حُبٍّ يَلُفُّ جَوانِحي","عَلى كَمَدٍ وَالشَّوقُ تَغلي مَراجِلُهْ",1,"ل",2,0],["فَلا مَلَلٌ أَلُفُّ عليه قَلْباً","ولا غَدْرٌ أَخيطُ عليهِ جِلْدي",2,"د",2,0],["فَلا مَجْدَ إلا ما حَوَيْتَ وقد بَنى","سِواكَ عُلاً لكنْ على جُرُفٍ هارِ",3,"ر",1,0],["فَلا مَشرَبي لِقِلاهُ أَمَرَّ","وَلا مَضجَعي لِنَواهُ أَقَضّ",4,"ض",1,0],["فَلا مِثلُهُ فيهِم وَلا كانَ قَبلَهُ","وَلَيسَ يَكونُ الدَهرَ ما دامَ يَذبُلُ",5,"ل",1,0],["فَلا مَجدَ لِلإِنسانِ ما كانَ ضِدُّهُ","يُشارِكُهُ في الدَهر بالنَهي وَالأَمرِ",6,"ر",1,0],["فَلا مَجدَ في الدُنيا لِمَن قَلَّ مالُهُ","وَلا مالَ في الدُنيا لِمَن قَلَّ مَجدُهُ",7,"د",2,0],["فَلا مُشادٌ وَلا مَشيدٌ حَمى","وَلا مَشيدٌ أَغنى وَلا شائِد",8,"د",1,0],["فَلا مُبالٍ وَلا مُداجٍ وَلا","وانٍ وَلا عاجِزٌ وَلا تُكَلَه",9,"ل",2,0],["فَلا مَوتَ إِلّا مِن سِنانِكَ يُتَّقى","وَلا رِزقَ إِلّا مِن يَمينِكَ يُقسَمُ",10,"م",1,0],["فلا مولىً يُصيخُ إِلى نِدائي","ولا خِلٌّ يَرِقُّ لسوءِ ما بي",11,"ب",2,0],["فَلا مُلِّيَ الباقي تُراثَ الَّذي مَضى","وَلا حَمَلَت ذاكَ الدُعاءَ مَنابِرُه",12,"ر",2,0],["فَلا مَعقِلٌ إِلّا حَوَتهُ سُيوفُهُ","وَلا مَغنَمٌ إِلّا حَجَتهُ جَحافِلُه",13,"ل",2,0],["فَلا مَلومٌ عَلى دَنيأَتِهِ","عَمّا سَمَت لِإِدِّراكِهِ فِطَنُه",14,"ن",2,0],["فَلا ما نَأى مِنهُ مِنَ الشَرِّ نازِحٌ","وَلا ما دَنا مِنهُ مِنَ الخَيرِ جالِبُه",15,"ب",2,0],["فَلا مُطِرَ المَروانِ بَعدَكَ قَطرَةً","وَلا اِبتَلَّ بِالمَروَينِ بَعدَكَ عودُ",16,"د",1,0],["فَلَأَمدَحَنَّ بَني حَنيفَةَ مِدحَةً","بِالحَقِّ أَهلَ رَواجِحِ الأَحلامِ",17,"م",1,0],["فلا ماءُ عينيَ من حُرقَةٍ","يَغيضُ ولا نومُها يَطرُقُ",18,"ق",1,0],["فَلا مُستَكرَهونَ لِما مَنَعتُم","وَلا تُعطونَ إِلّا أَن تَشاؤوا",19,"ا",1,0],["فَلا مَعانيهِ في الحُسنى مُغَلغَلَةٌ","وَلا بِأَلفاظِهِ في البِرِّ تَعقيدُ",20,"د",1,0],["فَلا مَلِكٌ فَردُ المَواهِبِ وَاللُهى","يُجاوِزُ بي عَنهُ وَلا رَشَأٌ فَردُ",21,"د",1,0],["فَلا مَرحَباً بِالشامِتينَ بِهَجرِنا","وَلا زَمَنٍ أَضحى بِنا قَد تَقَلَّبا",22,"ب",2,0],["فَلا مَرحَباً بِالشامِتينَ بِهَجرِنا","وَلا زَمَنٍ أَمسى بِنا قَد تَقَلَّبا",23,"ب",2,0],["فَلا مَلَكُ المَوتِ المُريحِ يُريحُني","وَلا أَنا ذو عَيشٍ وَلا أَنا ذو صَبرِ",24,"ر",1,0],["فلا مرحباً بالسّبتِ إن حانِ حينُه","فذلك يومٌ أغبرُ الوجهِ كالحُ",25,"ح",1,0],["فَلا مَجدَ لِلأَوطانِ حَتّى يَزورَها","كَتائِبُ تُزجيها لِقَومي كَتائِبُ",26,"ب",1,0],["فَلا مِنَّةً رَبّوا وَلا بِكُفىً جَزَوا","وَفي زُهدِهِ ما يَرفِدَنَّكَ ذو الزُهدِ",27,"د",1,0],["فَلا مَرحَباً بِالشامِتينَ بِهَجرِها","وَلا زَمَنٍ أَمسى بِها قَد تَقَلَّبا",28,"ب",2,0],["فَلَأمَ شَملي بَعدَ ما شُتَّ حِقبَةً","بِهِنَّ وَذُو الأَضغانِ عَنهُنَّ هاجِدُ",29,"د",1,0],["فَلا ما وَقالا جِداءٌ قَليلٌ","سُؤالُكَ رَبعاً مُحِيلاً وَقاعا",30,"ع",2,0],["فلا مُهْجَةٌ في الأرضِ منكَ مَنيعَةٌ","ولو قطَرَتْ من رِيقِ أرقطَ أرقَم",31,"م",1,0],["فلا مِثْلَ أيّامٍ لَنا ذَهَبِيّةٍ","قصيرةِ أعْمارِ البَقاءِ قلائلِ",32,"ل",1,0],["فلا منزِلاً ضَنكاً تَحُلُّ ركائبي","ولا عَقَداً وَعْثاً ولا سَبْسَباً قُفّا",33,"ف",2,0],["فَلامَكَ فيهِ أَقوامٌ","فَقَد جاروا وَقَد ظَلَموا",34,"م",3,0],["فَلا مَذهَبٌ عَنكُم لَهُ شَطَّ أَو دَنا","سِواكِ وَفي الأَرضِ العَريضَةِ مَذهَبُ",35,"ب",1,0],["فلا منزلٌ للقوم يرصدُ أفقهُ","بفكرِي ولا والله بابٌ مجرَّب",36,"ب",1,0],["فَلا مَلامَ عَلَى مَا كَانَ مِنْ حَدَثٍ","فَكُلُّنَا بِيَدِ الأَقْدَارِ مُرْتَهَنُ",37,"ن",1,0],["فَلا مُجِيبَ يَرُدُّ الْقَوْلَ عَنْ نَبَإٍ","وَلا سَمِيعَ إِذَا نَادَيْتَ يَسْتَمِعُ",38,"ع",1,0],["فَلاَ مَلِيكٌ نَالَ مِنْهُ الَّذِي","نِلْتَ وَلاَ غَازٍ كَمَا عُدْتَ عَادْ",39,"د",1,0],["فَلاَ مُنَادَاةٌ وَلاَ صَيْحَةٌ","وَلاَ بُكَاءٌ هَهُنَا أَوْ وَجِيبْ",40,"ب",1,0],["فلا مِلكٌ تناسلَ من «أمونٍ»","ولا عرشٌ يباركُهُ «فِتاحُ»",41,"ح",1,0],["فلا مذهبٌ عنكم له شطَّ أو دنا","سواك وف الأرض العريضة مذهبُ",42,"ب",1,0],["فَلا مُبالٍ وَلا مُداجٍ وَلا","فانٍ وَلا عاجِزٌ وَلا تُكَلَةْ",43,"ل",2,0],["فَلا مَلُومٌ عَلَى دَنِيئِتهِ","عَمَّا سَمَتْ لادِّرَاكِهِ فِظَنُهْ",44,"ن",2,0],["فَلا مَن كَساهُ الدَهر ثَوباً كَمَن غَدا","عَلَيهِ لِثَوب مُستَعار مُرَقَعا",45,"ع",2,0],["فلا مثلها فيفا فيافٍ ولا يفي","من القرِّ فيها البرد لو يتخيّما",46,"م",2,0],["فَلا مَاءٌ يُذَاقُ بِها نَهَاراً","ولاَ فِيهَا يُذَاقُ المَاءُ لَيلا",47,"ل",2,0],["فلا ملامة تعروني بصبوتهم","فقد أقمت على شجواي أعذارا",48,"ر",2,0],["فَلَأَملَأَنَّ الخافِقينَ غَرائِباً","مَوسومَةً بِكَ مِثلُها ما قيلا",49,"ل",2,0],["فَلآ مَدحَ أَزكى مِنهُ في العَقلِ وَالشَرعِ","فَدونَكَ فاِجهَد نَفسَكَ الدَهرَ مُثنياً",50,"ي",2,0],["فَلا مِقوَلٌ يَجفووَلا راحَةٌ تَسطو","إِلى الحَقِّ مِن دارِ المُحالِ مُفَرَّغُ",51,"غ",1,0],["فلا ملك إلا ما بهب اكتسب الفتى","ثناء وذكراً لا يموت ولا يبلى",52,"ل",2,0],["فلا ملك إلا مثل ملكك رحمة","من الله لا يشقى بها غير مجرم",53,"م",1,0],["فلا مقلةً إِ لها فيك حيرةٌ","ولا مهجة إلا بحبك تكلفُ",54,"ف",1,0],["فلا من ذوى أرض تحاشى ولا سما","ولا رده عن سهوه زجر ذي زجر",55,"ر",1,0],["فَلا مَلِكٌ إِلّا عَلِيُّ بنُ ماجِدٍ","جَميلُ المُحَيّا وَالإِنابَةِ وَالذِكرِ",56,"ر",1,0],["فَلا مِثلِى يُعَلَّلُ بِالأَمانِى","وَلا يُسقَى بِكأسِ المُترَفِينَا",57,"ن",2,0],["فلا ملكٌ إلا وجاءتْك رُسْلُه","يُدَارِي بها عن نفسِه ويُصانع",58,"ع",1,0],["فلا ما مضى أشفى فؤادي ولا الذي","يحي بعد موتي في الهوى نافع بعدي",59,"ي",1,0],["فلا ما مضى يشفي فؤادي ولا الذي","يجي بعد موتي في الهوى نافع بعدي",60,"ي",1,0],["فلا مصعد عنها ولا متسلق","إلى فوقها إلا مداه بعيد",61,"د",1,0],["فلأمت في سبيلهم ناعم البا","ل لعلّي أرتاح تحت التراب",62,"ب",1,0],["فلا ما بنى كسرى ولا قصرُ جعفرٍ","ولا قصرُ غمدانَ ولا للبرامكِ",63,"ك",1,0],["فلا مجدَ إلا دونَ ما هو فاعلٌ","ولا فخرَ يبقى للبُرى والمُرعَّثُ",64,"ث",1,0],["فلا ما مضى فيها من العيش عائد","ولا النفس عنها بالبعاد تسلت",65,"ت",1,0],["فَلا ما كَستُهُ وَزناً","وَلا هُوَ كائِلاً بَخسا",66,"س",2,0],["فَلاَ مُقْلَتِي تَسْتَهِلُّ دَماً","وَلاَ كَبِدِي تَتَدَاعَى فُطُورَا",67,"ر",2,0],["فَلاَ مُدْنِفٌ إِلاَّ الذِي شَفَّهُ النَّوَى","فَقَلْبُهُ خَفَّاقٌ وَجَفْنُهُ هَامِلُ",68,"ل",1,0],["فلا مرتع يكفيهم بنباته","ولا مورد إلا من الورد ينضب",69,"ب",1,0],["فلا منزلٌ ترضينَهُ بعد منزلٍ","قريبٍ بعيدٍ عنكِ مأتمُهُ عرس",70,"س",1,0],["فلا مؤمنٌ إلا الذي هو معربٌ","وهذا كتابُ اللهِ بالعربية",71,"ه",1,0],["فلا منعةٌ إلا بجيشٍ منظّمٍ","يجمّعُ أبناءَ البلادِ كإخوة",71,"ه",1,0],["فَلا مِنّةٌ إلا لَهُ في تخَلصي","بِيُمْن مَساعيهِ الكِرَام ولا يَدُ",72,"د",1,0],["فَلأمْنَحَنَّكَ ذا الثَّناءَ مُحَبَّباً","ما دامَ مَدْحُ الْباخِلِينَ مُبَغَّضا",73,"ض",2,0],["فَلا مَحامِدَ إِلّا مِن مَكارِمِهِ","ولا مَحاسِنَ إِلّا عَن سَجاياهُ",74,"ا",2,0],["فَلا مَلِكٌ سِوى موسى وَعيسى","وَسَيفِ الدينِ وَاِنقَطَعَ الكَلامُ",75,"م",1,0],["فَلا مَدحَ يَحسُنُ عِندَ المُلو","كِ إِلا وَكُنتَ لَهُ المُستَحِقّا",76,"ق",2,0],["فلا مرحباً ولا سهلاً بهم","وأهلاً وسهلاً بحزب الرشاد",77,"د",1,0],["فلا ماء إلا بعض فيض مدامعي","ولا نار إلا دون أنفاس زفرتي",78,"ي",1,0],["فَلامِرا في أَنَّ سيماءَهُ","مِن مُفسِدٍ في قَومِهِ أَصلَحُ",79,"ح",1,0],["فَلا مُغازلة الغزلان تَمنعني","عَن بيضها الدَولَتان البيض وَالسمرُ",80,"ر",1,0],["فَلا مَكر لَهُم عَنّي بِخاف","وَلا سرٌّ لَهُم عِندي بِبادي",81,"د",2,0],["فَلا ماضي الزَمان بِمستعادٍ","وَلا ما فات مِنهُ بِمُستَفادِ",81,"د",1,0],["فلامَني فيكَ أقوامٌ وهل عَجَبٌ","إنّ الحُطيئةَ يُطْرِي آلَ شَمّاس",82,"س",1,0],["فلا مطَرتْ إلاّ لليْلَى عِهادها","ولا سُقيَتْ إلاّ بَدْمعيِ عُهودها",83,"د",3,0],["فلأمنحنَّك يا مبيدَ نَواله","ما لا أظنُّك تستطيعُ تُبيدُهُ",84,"د",2,0],["فلا ميْتٌ مع الموتى","ولا حيٌّ مع الأحيا",85,"ي",2,0],["فلأمتي من دينها قِمَمٌ","تبْقَى بها مرفوعةَ الرَّأسِ",86,"س",1,0],["فلا مدحت وصلا لليلى وزينب","ولا هي ذمت هجر سعدى ولا هند",87,"د",1,0],["فلا مَوردٌ إلاّ يُمازِجهُ دمٌ","ولا مرتَعٌ إلاّ رعته المَناسِمُ",88,"م",1,0],["فَلَأُمطِرَنَّكِ من دُمو","عِيَ ما ينوبُ عَنِ الغَوادِي",89,"د",2,0],["فَلا مَجد في الأَرض لَم يَبنِهِ","وَلا غايَةً فيهِ لَم يَأتِها",90,"ت",3,0],["فلا منعت من الدُّنيا مجاني","مكارمه على مَرِّ السِّنين",91,"ن",1,0],["فلا ماء هاتيك المدامع ناضب","ولا حرّ هاتيك الأَضالع خامد",92,"د",1,0],["فلام ولم يُصِب باللّوم رشداً","وكان العذر أهدى للصواب",93,"ب",1,0],["فلا معدّ ولا عبس ولا مضر","نالوا الذي قد بلغنا من تهانينا",94,"ن",2,0],["فَلأَمْتَ شَعْبَهُمَا بسوقِ ولِيمَةٍ","راح الثَّرى بدمائِها مَمْطُورا",95,"ر",2,0],["فلا مُؤْنِسٌ إِلّا شهيقٌ وزَفْرةٌ","ولا مُسعِدٌ إِلّا دُموعٌ وأَجفانُ",96,"ن",1,0],["فَلا مُحِيَتْ أَفْخَاذُهَا مِنْ سِمَاتِكُمْ","ولا عَرِيت من ناصِرِيكُمْ ظُهُورُها",97,"ر",3,0],["فلا مانع عما قضى اللَه في امرئٍ","فقد تهدم الأقدار عنه امتناعه",98,"ع",2,0],["فلا مهجة إِلا كواها لظى الأَسى","ولا دمع إِلا مندب بخدود",99,"د",1,0],["فلا محا اللَه هذا الحُزن عنك ولا","عني ولا بسوى ما كان أمعننا",100,"ن",2,0],["فلا ماءَ إلا في الحسود مرقرَقٌ","ولا نارَ إلا في المحبِّ تضرَّمُ",101,"م",1,0],["فلا مات عِرض المرء وهو ابن حرّةٍ","وفي الأرض دينارٌ يعيش ودرهمُ",101,"م",1,0],["فلا مشهدٌ للمعالي يزار","ولا كعبةٌ للندى تُستلَمْ",102,"م",1,0],["فلا مَدَّت لنعمتك الليالي","يداً طُولى ولا ظُفراً عَلوقا",103,"ق",2,0],["فلا محفِلٌ إلا وفيهم صدورهُ","ولا جحفَلٌ إلا وفيهم قلوبُهُ",104,"ب",2,0],["فلا موضعٌ إلا مُخيضُ ركابهِ","ولا واضعٌ إلا فُويْقَ المناقِعِ",105,"ع",1,0],["فلا مدحَ إلا مفخرٌ وبَسالةٌ","ولا منشدٌ إلا المليكُ المحجَّبُ",106,"ب",1,0],["فلا مالَ إلا مُستفادٌ بعزَّةٍ","ولا بذْلَ إلا جالبٌ لثناءِ",107,"ا",2,0],["فلا مَعْلقٌ اِلا أنابيشُ مِحْدَجٍ","ولا بللٌ اِلا المسيحُ الجُراجِرُ",108,"ر",1,0],["فلا منْزلٌ اِلا فِناءُ مُحمَّدٍ","ولا كافلٌ بالجودِ اِلا العُراعِرُ",108,"ر",1,0],["فلا محلُ السنين يحلُّ أرضاً","ألَمَّ بها ولا غَسقُ الظَّلامِ",109,"م",1,0],["فلا مالَ اِلا مِنحةٌ وابْتذالُها","ولا ذُخر اِلا مِدْحةٌ ودوامُها",110,"م",3,0],["فلا مِجْمَرٌ إلا وموقِدُ معْركٍ","ولا قُطرٌ إلاَّ وهامةُ عَبْهَلِ",111,"ل",1,0],["فلا مسلمُ الداعي ولا عادل الظبى","ولا ممهل العادي ولا جائر القسم",112,"م",1,0],["فلا منحنَّك كل ناصعةٍ كأنَّ","الحسنَ توَّجها النُّضارَ الأحمرا",113,"ر",2,0],["فلأمنحنك كلَّ باقيةٍ إذا","نفدَ النّضار وجدتها لم تنفد",114,"د",1,0],["فلا مفاريحُ إن نالت رماحهم","ولا مجازيع في البأساء إن نيلوا",115,"ل",3,0],["فلا ماءَ إلا ما جفونُكَ سحبُه","ولا نارَ إلا في ضلوعِكَ تُضْرَمُ",116,"م",1,0],["فلا منزع إلا لطه ببابه","تناخ المطايا والرواحل تبرد",117,"د",1,0],["فلا ماء الفرات بمورد لي","ولا أكناف دجلة من رحابي",118,"ب",2,0],["فلا مَطَلتْك الرّاهماتُ برحمةٍ","فما كنت يوماً في ندىً بمماطلِ",119,"ل",1,0],["فلا مُفزِعٌ أبداً مُفزِعي","ولا هائلٌ أبداً هائلي",120,"ل",2,0],["فلامَحوا الغَدرَ لمّا أن بعُدتَ ومذْ","رِيعوا بقربك أغضوا عنه بالمُقَلِ",121,"ل",1,0],["فلا مَلَلٌ لقلبي منك دهراً","وحاشا اللَّهَ قلبي من مَلالَهْ",122,"ل",2,0],["فلا مِعْصَمٌ فيه سِوارٌ مُعَطَّنٌ","ولا مَفْرِقٌ يَعلوه تاجٌ مُرَصَّعُ",123,"ع",1,0],["فلا مَطعمٌ فينا يطيبُ لطاعمٍ","ولا مشربٌ منّا يَلَذّ لشاربِ",124,"ب",1,0],["فلا مُطمِعٌ من سائر النّاس مُطمِعِي","ولا رائبٌ من بَنْوةِ الدّهر رائبي",125,"ب",2,0],["فلا مخلوق في حس وعقل","يشابه ربنا أبداً محالا",126,"ل",2,0],["فلا معروف إلا الله لكن","تنزه إذ تشبه واستطالا",126,"ل",2,0],["فلا مُلتجٍ إِلا عليه اتِّكالُه","ولا مُرتَجٍ إِلا إليه مَآبُه",127,"ب",2,0],["فلا مَنْطِقٌ إِلاَّ لِقَوْلِي مَشْرقٌ","ولا مِسْمَعٌ إِلاَّ لِقوليَ مَغْرب",128,"ب",1,0],["فلا موضعٌ قد كانَ بالأَمسِ مُجْدباً","بنأْيِك إِلاَّ وهْو في اليومِ مُخْصب",128,"ب",1,0]]}