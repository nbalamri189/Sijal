{"poems":[[70,"يا أيها الناكث في عهده","https://www.aldiwan.net/poem42889.html","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[108,"الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=34732",""],[80,"هنّ الحسانُ وحربها الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=3217",""],[115,"مروءتنا في شأن قارع بابنا","https://www.aldiwan.net/poem41711.html","الطويل"],[397,"فخار للكنانة أن تكوني","https://www.aldiwan.net/poem10958.html","عموديه"],[464,"خصرك هذا المخطف","https://www.aldiwan.net/poem3240.html","عموديه"]],"verses":[["وا أَسَفي اليَومَ عَلى صُحبَةٍ","يَتعَبُ فيها القَلبُ وَالخاطِرُ",0,"ر",1,0],["واأسفاً هذا سجلٌّ كُتِب","خَطَّتهُ كفُّ القدَر المحتجب",1,"ب",1,0],["وآآه لاغ من ذكرت كل له نصيب","وآآه لامنّي ذكرت إن على وجهك قناع",2,"ع",1,0],["وأاركِ قد حاولتِ نَقْلَ خُطى","ً فَقَصَرِتْهَا وعلا بكِ البُهْر",3,"ر",1,0],["وا النرحو الحفظ دهرا أبا حمد","من الخطب والبلوى وكل المهالك",4,"ك",1,0],["وآانت في الحياة سبيل صدق","لينتصف الضعيف من القوي",5,"ي",1,0],["واأسفي واأسفي لو","كان يغني الأسف",6,"ف",1,0]]}