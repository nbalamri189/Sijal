{"poems":[[72,"يا أيها الناكث في عهده","https://www.aldiwan.net/poem42889.html","السريع"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[112,"الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=34732",""],[82,"هنّ الحسانُ وحربها الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=3217",""],[119,"مروءتنا في شأن قارع بابنا","https://www.aldiwan.net/poem41711.html","الطويل"],[402,"فخار للكنانة أن تكوني","https://www.aldiwan.net/poem10958.html","عموديه"],[469,"خصرك هذا المخطف","https://www.aldiwan.net/poem3240.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122713","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77586","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64888","المجتث"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56572","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93124","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48988","الخفيف"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36163","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28476","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61014","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131452",""],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112657","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112626","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89095","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62914","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86311","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138647",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138567",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138529",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91286","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92023","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4683,"عصر شبابي في الهوى عذبا صفا","https://www.poetsgate.com/ViewPoem.aspx?id=166757",""],[4755,"مأساة سهيل اليماني كاملة","https://www.poetsgate.com/ViewPoem.aspx?id=211329",""],[4788,"وجدي على الراحه وجود ام الضنى","https://www.poetsgate.com/ViewPoem.aspx?id=132265",""],[4797,"دكتور العيون","https://www.poetsgate.com/ViewPoem.aspx?id=29433",""],[4578,"بروح العلا بالسعد أبدت سماؤها","https://www.poetsgate.com/ViewPoem.aspx?id=49341",""],[4869,"لاتضحك عليا","https://www.poetsgate.com/ViewPoem.aspx?id=151558",""],[4929,"مَيَلانُ الموازين. (من بحر المنسرح)","https://www.poetsgate.com/ViewPoem.aspx?id=207997",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5317,"قالب عسل","https://www.poetsgate.com/ViewPoem.aspx?id=177085",""],[5344,"إلتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=180697",""],[5370,"يا كثر شعري","https://www.poetsgate.com/ViewPoem.aspx?id=85525",""],[5611,"كل امرىء وسط التراب يكون","https://www.poetsgate.com/ViewPoem.aspx?id=165153",""],[5790,"فض فم نعى لنا","https://www.poetsgate.com/ViewPoem.aspx?id=112079",""],[5848,"سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=50626",""],[5956,"منطق العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=192221",""],[5956,"أوطان الحب","https://www.poetsgate.com/ViewPoem.aspx?id=192320",""],[5956,"انفتح يا سجن","https://www.poetsgate.com/ViewPoem.aspx?id=192340",""],[6056,"دلعهن عالي المستوى","https://www.poetsgate.com/ViewPoem.aspx?id=130337",""],[6056,"مجاريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=130501",""]],"verses":[["وا أَسَفي اليَومَ عَلى صُحبَةٍ","يَتعَبُ فيها القَلبُ وَالخاطِرُ",0,"ر",1,0],["واأسفاً هذا سجلٌّ كُتِب","خَطَّتهُ كفُّ القدَر المحتجب",1,"ب",1,0],["وآآه لاغ من ذكرت كل له نصيب","وآآه لامنّي ذكرت إن على وجهك قناع",2,"ع",1,0],["وأاركِ قد حاولتِ نَقْلَ خُطى","ً فَقَصَرِتْهَا وعلا بكِ البُهْر",3,"ر",1,0],["وا النرحو الحفظ دهرا أبا حمد","من الخطب والبلوى وكل المهالك",4,"ك",1,0],["وآانت في الحياة سبيل صدق","لينتصف الضعيف من القوي",5,"ي",1,0],["واأسفي واأسفي لو","كان يغني الأسف",6,"ف",1,0],["وا أسَفأً يَسبِقُ الزَّمانُ بِنا","وَما التَقَى قاتِلٌ وَمَقتُولُ",7,"ل",1,0],["وا أَسَفاه كرت النُسور","وَطارَ مِنهُما واحِدٌ جَسور",8,"ر",1,0],["وآأْنَسْ بطائفةِ الح","قِّ دونَ كلِّ الطَّوائِفْ",9,"ف",1,0],["وا أسفاً يا زمان وا أسفاً","أفنيت ظلماً رجالنا ففنوا",10,"ن",3,0],["وا إماماً بالظبى أمسى صريع","رأسه في صارم الشمر قطيع",11,"ع",1,0],["وا أماماً حرن الفؤاد","في ظبى قوم يزيد وزياد",11,"د",1,0],["واْالتَوتْ بعدهُ قناةُ ذويهِ","فعَصى الدَّاءَ في نواهُ الدواء",12,"ا",2,0],["وَا أَسفي عَلى الحِمى","وَأَهلِه وَا أَسَفا",13,"ف",2,0],["واأسفي من رمنٍ باخلٍ","يُمِرُّ للمرءِ ولا يُحْلي",14,"ل",2,0],["وا أَسَفي مِن غُربَةٍ طَوَّحَت","فيها إِلى الرُّومِ الأَعارِيبُ",15,"ب",1,0],["وا أحمداه وأَبا بكرٍ وواعمراه","صوتٌ يجود بفيضه يَروي الصدى",16,"د",2,0],["وا إماماه ماله من نصير","وا إماماه ماله من محام",17,"م",1,0],["وا إماماه إذ يودع أهليه","ويومي بطرفه للخيام",17,"م",1,0],["وا أنا أفديك بروحي وما في الروح حساب","وانت أبقى لما جا وما راح",18,"ح",1,0],["وا أسفاهُ حمَلوا عَلَيه","من كلّ جانبٍ أتوا إليهِ",19,"ه",1,0],["وا أبتاهُ وا محمّداهُ","ووا علياهُ ووا أخاهُ",20,"ه",1,0],["واأْلَفِ السقمَ إلفةَ العذلِ فيه","حيثما كان مطربي عَوَّادَك",21,"ك",1,0],["وا أَسفي كيف لم أَصُنْهُ عن ال","قصدِ بقصدي لو كانَ بي رَمَقُ",22,"ق",1,0],["وااسف عَلى عَهد تقضى باكِياً","عَلَّ البُكاءَ يُزيلُ بَعض جَواكا",23,"ك",2,0],["وا اماماً أفجع الملة في","موته والمصطفى أبكى دما",24,"م",2,0],["وا اسفاً يمسي يزيد قارعاً","ثغر ابن طه شامتاً مرتجزا",25,"ز",2,0],["وأارك اصطبرت والقوم آذوا","فاطماً في عشيها والبكور",26,"ر",1,0],["وَاأنس بذي الآجام وَاهجُرْ أَربُعاً","بكناسها أَنِسَت مهاةُ وَريم",27,"م",1,0],["وَاأْسَفْ عَلى جَمعٍ يقولُ حزينُهُ","أَمست عَلى قفر الديار وَحيده",28,"د",2,0],["وا أعز البنين وا هكطورا","كم رعتك الأرباب حيّاً قريرا",29,"ر",2,0],["وَإأِلّا فَإِن تَجبُنوا في الكِفاح","فَفَجرُ اِنتِصارِ الطَراوِدِ لاح",30,"ح",1,0],["وا أَسَفا الشَبابُ وَلّى وَمَضى","وَالبَأسُ وَالإِقدامُ عَنّي أَعرَضا",31,"ض",2,0],["وا أَسَفا يا زُبدَةَ الأَغارِقِ","أَتُهلِكَنَّكُم ظُبى المَخافِقِ",31,"ق",1,0],["وأُامَ هَدَّامُ المَدائنِ أُوذِسٌ","بِعَصا السِّيادَةِ واقِفاً بِعَزيمةِ",32,"ه",1,0],["وأأُبى دُفار الترهاتِ وما بها","ولذّاتها صارت لديَّ كغصةِ",33,"ه",1,0],["واأسفا عليك يا حشاشتي","عليك يا حشاشتي واأسفا",34,"ف",2,0],["واااا غُربَتَاهُ.. أَمَا لِي مَن يُقَاسِمُني","شَوقَ الصُّعُودِ كَريمًا، كان مَن كانا",35,"ن",2,0],["وآآ نفسي اللي ما تطعّم زادها","كثر الصبر في ضيقها ما فادها",36,"د",3,1],["وااشوف ناس ٍ فالقفا ما يرحمون","اما وقفت لصاحبي والا مشيت",37,"ت",1,0],["وا اكتفت الدنيا بطلعة وجه","فعد من النوع البدع اكتفاؤها",38,"ا",3,0],["وآآآه لو تدري بحالي كان مآتطلب اجيلك","ترمي الدنيا ورآك والوطن تلقآآآه فيّا",39,"ي",2,0],["وا أسفاهُ عليكَ يا وطني","شاختْ حروفيْ في دمعِكَ الهَمِرِ",40,"ر",1,0],["وا أسفاهُ عليكَ وا أسفا","يا وطني مِن تآمرٍ قَذِر ِ!",40,"ر",1,0],["وَا ..! إخوَتِي .. رِفقًا بِقَلبِي مَا بِكُم!","مَا كُنتُ أرضّى أن أُهَانَ وأخضَعَا",41,"ع",2,0],["وآآآآه منك آآآه يأاحلى غزال","يرتع بكثبان قلبي والسهل",42,"ل",1,0],["وآآخ ليته ما يفرَّق عاشقين،","لن والله عيشت الفرقا صَلَف",43,"ف",1,0],["واا جرحي اللي من الأفكار يتسارح","واا قلبي اللي من الأوهام حمّلته",44,"ت",2,0],["واأسفاً للوعظ مات بموت من","قد كان منه للجهاد عيونُ",45,"ن",1,0],["وا أسفي من بعده","على العلى وا أسفا",46,"ف",2,0],["وآآه من ثقل السهر واللحظة المخنوقة","في خفايا دمعتي وغيابها وغيابي !",47,"ب",2,0],["وآآآه من فرحة زمانٍ سارقة مسروقة !","علمتني كيف اعيش الحلم خلف ابوابي",47,"ب",2,0],["وآآآآه من حزنٍ على عمري تميل عذوقه","شايله لا ينكشف لمرايتي واصحابي !",47,"ب",2,0],["وا أسا قلبي على حِلف الأذى","منهمُ البربر كانوا أطيَبا",48,"ب",2,0],["وا أسانا كيف شاركناهمو","حقّنا في خيرنا دون حذارْ؟؟",49,"ر",1,0],["وَا أساهم حرَّفوا توراتَهم","زيفوا بالمكرِ آياتَ السماءْ",50,"ا",2,0],["وآآآهني الذي عمره ، تمنّى ، ونال","مرة ٍ في حياته ، أدرك اللي نوى",51,"و",2,0],["وآآهني اللي فؤاده بالهوى دايم خلي","ما بلاه الله وراسه شاب من قبل المشيب",52,"ب",1,0]]}