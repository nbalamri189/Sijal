{"poems":[[50,"بعفوك بل بجودك عذت لا بل","https://www.aldiwan.net/poem66130.html","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116951","الرمل"],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[310,"ربيع من جبينك قد أطلا","https://www.aldiwan.net/poem56437.html","الطويل"],[370,"خليل لم أهبه من قلاه","https://www.aldiwan.net/poem44480.html","الوافر"],[447,"أيا رباه دعوة مستغيث","https://www.aldiwan.net/poem14358.html","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65129","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121683","الرمل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117024","الطويل"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130866","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146758","الطويل"],[4843,"يا أمةَ العربِ الأمجادِ في القدمِ","https://www.poetsgate.com/ViewPoem.aspx?id=142690",""],[6093,"عَلى أَطْلالِ بَعْضِيَ قَامَ بَعْضِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=191508",""]],"verses":[["بِعَفوِكَ بَل بِجودِكَ عُذتُ لا بَل","بِفَضلِكَ يا أَميرَ المُؤمِنينا",0,"ن",2,1],["بعفافٍ وكفافٍ","وقُنُوع وصلاح",1,"ح",1,0],["بعفة ورأفة جملنا","ولسواك رب لا تكلنا",2,"ن",2,0],["بِعفوكَ قَد قَصَرنا من ثناءٍ","رَأَينا طولهُ عيّاً وجَهلا",3,"ل",2,0],["بِعُفروسٍ تُبادِرُهُ يَدَاهُ","وَصَمصامٍ يُصَمِّمُ في العِظامِ",4,"م",1,0],["بعفوك إن قبلت النوب مني","وإن لم تعف عني من نبيثي",5,"ث",2,0],["بعفو لا إله إلا اللّه","وعفو أسمائك عجل المدد",6,"د",1,0],["بعفّة عن مناهي الشّرع لو نُشرت","بين الورى ما تجد إثما على رجُل",7,"ل",1,0],["بعَفِيفِ الجَيْبِ لَدْنٍ ناعمٍ","لم يُعانِقْهُ سِوَى حُلَّتِهِ",8,"ه",1,0],["بعفو وغفران وحسن عواقب","وخاتمة بالخير وهو يوحد",9,"د",1,0],["بعفوٍ وإن أبقيت في دار غربة","فقد شرح الرحمن من فضله صدرى",10,"ر",2,0],["بعفو بلا كدٍّ وصفو بلا قذى","ونقد بلا وعد ووعد بلا مطل",11,"ل",1,0],["بعفّةٍ في الهوى العذريّ قد عرفوا","وفي العفافِ كمالُ السادةِ القدمِ",12,"م",1,0],["بِعَفْوِ الطَّبْعِ يُنْشِدُ كُلَّ سَهْلٍ","وَيَأْتِي بالتَّأَمُّلِ بِالهِضَابِ",13,"ب",1,0]]}