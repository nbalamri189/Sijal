{"poems":[[55,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[55,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[55,"وفى ذا السرور بتلك الكرب","https://www.aldiwan.net/poem30751.html","المتقارب"],[79,"أخذت وأمواج الردى متلاطمة","https://www.aldiwan.net/poem36100.html","الطويل"],[79,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[79,"أبا قاسم لازلت للفضل قاسما","https://www.aldiwan.net/poem36445.html","الطويل"],[53,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[80,"أبا قاسم قد كنت دنيا صحبتها","https://www.aldiwan.net/poem14162.html","الطويل"],[47,"أبا قسم حان الرحيل ولا أرى","https://www.aldiwan.net/poem63582.html","الخفيف"],[46,"أبا قدامة قد قدمت لي قدما","https://www.aldiwan.net/poem30329.html","البسيط"],[47,"أبَا قَاسِمٍ حَانَ الرّحيلُ، ومَا أرَى","https://www.poetsgate.com/ViewPoem.aspx?id=31265",""],[53,"حليفُ سُهادٍ ليلُهُ كنهاره","https://www.poetsgate.com/ViewPoem.aspx?id=29231",""],[164,"ألا قللا ما بي تقر عيونها","https://www.aldiwan.net/poem58783.html","الطويل"],[170,"وسقت الركائب حتى أنخن","https://www.aldiwan.net/poem46823.html","المتقارب"],[240,"أماطت لثاما وأبدت هلالا","https://www.aldiwan.net/poem31610.html","المتقارب"],[371,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[411,"أبا قاسم كم ظالم متعجرف","https://www.aldiwan.net/poem49444.html","الطويل"],[412,"محل العلى أني حللت محلها","https://www.aldiwan.net/poem50133.html","الطويل"],[412,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[412,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[463,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[463,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[463,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[473,"أبا قاسم إن أنت عاودت بعدها","https://www.aldiwan.net/poem59650.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126768","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126862","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126827","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122651","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122608","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16843","الطويل"],[1085,"","https://poetry.dctabudhabi.ae/diwan/poem/124799","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101986","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132879","الطويل"],[1431,"","https://poetry.dctabudhabi.ae/diwan/poem/198161","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49594","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143014","الوافر"],[2286,"","https://poetry.dctabudhabi.ae/diwan/poem/143207","الطويل"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27111","الطويل"],[2704,"","https://poetry.dctabudhabi.ae/diwan/poem/146613","الطويل"],[3616,"","https://poetry.dctabudhabi.ae/diwan/poem/147696","المتقارب"],[3906,"","https://poetry.dctabudhabi.ae/diwan/poem/199410","الطويل"],[4024,"","https://poetry.dctabudhabi.ae/diwan/poem/203807","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86443","المتقارب"],[4471,"","https://poetry.dctabudhabi.ae/diwan/poem/73013","المتقارب"],[5213,"أبا محسن طال التباعد والهجر","https://www.poetsgate.com/ViewPoem.aspx?id=170470",""]],"verses":[["أَبا قاسِمٍ حَلّاكَ بِالشِعرِ ماجِدٌ","عَلَيكَ لَهُ حَتّى المَماتِ رَصائِعُ",0,"ع",1,0],["أَبا قاسِمٍ هَذا الَّذي كُنتُ راجِياً","لِأُرغِمَ أَعداءً وَأَكبِتَ حُسَّدا",1,"د",2,0],["أَبا قاسِمٍ جاءَت إِلَيكَ قَلائِدٌ","تُقَلِّدُ أَعناقَ الكَرامِ مَناقِبا",2,"ب",2,0],["أَبا قاسِمٍ كانَ هَذا البِعادُ","إِلى طُرُقِ القُربِ أَقوى سَبَب",3,"ب",1,0],["أَبَا قَاسِم لاَزلْتَ لِلْفُضلِ قَاسِماً","ظُبَاكَ لِظَهْرِ الْجَوْرِ وَالظُّلْمِ قَاصِمَهْ",4,"م",2,0],["أَبَا قَاسِمٍ خُذْهَا إِلَيْكَ كَأَنَّهَا","حُسَامٌ يُروعُ النَّاقِدِينَ صَقِيلُ",5,"ل",1,0],["أبا قاسِمٍ لازِلْتَ للفضْلِ قاسِماً","بميزانِ عدْلٍ ينْصُرُ الحقَّ مَنْ نَصَرْ",6,"ر",1,1],["أبا قاسمٍ كم قد هفا لك لبُّهُ","على فضلة من حلمه ووقاره",7,"ر",2,0],["أبا قاسِمٍ قَد كُنتَ دُنيا صَحِبتها","قَليلاً كَذا الدُنيا قَليل مَتاعُها",8,"ه",2,1],["أَبا قَسِمٍ حانَ الرَحيلُ وَلا أَرى","لِبائِيَّتي فيكُم نَوالاً وَلا أَجرا",9,"ر",2,1],["أَبا قُدامَةَ قَد قَدَّمتَ لي قَدَماً","مِنَ المَكارِمِ صِدقاً غَيرَ ما مَينِ",10,"ن",1,1],["أبَا قَاسِمٍ حَانَ الرّحيلُ، ومَا أرَى","لبائيتي فيكُمْ نَوَالاً وَلا أجْرَا",11,"ر",2,1],["أبا قاسمٍكم قد فالك لُبُّهُ","على فضلة من حلمه ووقاره",12,"ر",2,0],["أبا قاسم كم مدّ عبدك بالدعا","يميناً وكم أُخرى باخرى تعينها",13,"ن",3,0],["أبا قاسمٍ يا قَسيمَ السّخاءِ","إذا جَفَّ ضَرعُ الغَمام الحبِيِّ",14,"ي",1,0],["أَبا قَلبُهُ أَن يُطيقَ السُلُوَّ","وَعَثرَتُهُ في الهَوى أَن تُقالا",15,"ل",2,0],["أَبا قُرب النَعِيِّ مِنَ البَشيرِ","وَيا لَيلَ المُصيبَةِ مِن سَميري",16,"ر",2,1],["أبا قاسِمٍ كمْ ظالِمٍ مُتَعَجْرِفٍ","نضالي حَدَّيْ سَيفِهِ وسِنانِهِ",17,"ن",2,1],["أَبا قاسم إِن تَستَجِد وصف مِدَحتي","فمنك مَعانيها وَأَنتَ مَحَلُّها",18,"ل",3,0],["أَبا قاسم قلدتني مِنكَ أَنعُماً","أُقصِّرُ عَن شُكري لَها حينَ أَطنَبُ",19,"ب",1,0],["أَبا قاسِم حزت صَفوٍ الكلامِ","وغادَرَت ما بَعدِهِ للعَرَب",20,"ب",1,0],["أبا قاسم لبَّيت لو كنتَ سامعا","غراما بصوتي وارتياحا إلى لَحني",21,"ن",2,0],["أبا قاسمٍ زعمَ المجدُ لا","أَخيبُ وأنتَ بأمري زعيمي",22,"م",2,0],["أبا قاسم دعوةً من فتىً","وِصالُ الندى فيه وَصلُ الرَّحِمْ",23,"م",1,0],["أَبا قاسِمٍ إِن أَنتَ عاوَدتَ بَعدَها","سُؤالَكَ لي في أَمرِ مَن أَنتَ عالِمُه",24,"م",2,1],["أَبا قيس قصَدتَ ديارَ مصر","فَها أنا ذا أهنّي فيك مصرا",25,"ر",2,0],["أبا قيسٍ رعاكَ اللّه شهماً","لهُ في قومهِ خلق كريمُ",26,"م",1,0],["أبا قيسٍ إذا ما جنّ ليلٌ","فنحنُ بظلّه نقضي الليالي",27,"ل",2,1],["أبا قاسمٍ إن أعِش لَم أخُنكَ","إذا خانَ عَهدَكَ أهلُ الغَشَش",28,"ش",1,1],["أبا قاسمٍ إن كانَ للحشرِ روعةٌ","فسيّان عند الناسِ يَومُك والحشر",29,"ر",1,0],["أَبا قاسِمٍ فَخراً عَلى المَجدِ وَالعُلا","فَإِنَّ العُلا رَوضٌ وَأَنتَ بِهِ زَهرُ",30,"ر",1,0],["أبا قطن إني أراك حزيناً","وإن العجول لا تبالي خدينا",31,"ن",2,1],["أبا قاسم أصمى ولم يدر قبله","لعمري وقد أصمى حشا دين أحمد",32,"د",1,0],["أبا قاسم ما للحِجى عند معدِلُ","ولا للعُلى إلا عليك مُعَوَّلُ",33,"ل",1,1],["أبا قاسم أنفقت عمرك كلّه","فلا تك مغتراً بما ترجف المنى",34,"ن",2,1],["أبا قاسمٍ خُذها عتابَ تَذُّللٍ","وَرُبَّتمَا كانتء عتابَ تَبَرُّم",35,"م",1,0],["أبَا قاسمٍ هاكَ الثَّنَاءَ وَإنما","هُوَ الشّوْقُ أرْمِيهِ إليكَ وَيَرْتَمي",35,"م",2,0],["أبا قيس، \"أبا ليلى القوافي\"","أجرنا فالفواجع في زحام",36,"م",1,0],["أبا قاسمٍ لا زلت فينا عطيّة","من الله لا أمست يد الدهر مجذوذه",37,"ذ",2,1],["أَبا قَطَرِيٍّ لا تُصارِع فَإِنَّني","أَرى قِرنَكَ الأَعلى وَإِيّاكَ أَسفَلا",38,"ل",2,1],["أبا قاسم لولاك في مرو ناقداً","لضاعت وما باعت بها كلماتي",39,"ت",2,0],["أبا قاسم والهوى جنة","وهأنا من مسه لم أفقْ",40,"ق",1,1],["أَبا قاسمٍ شَكْوَى امرىءٍ لك نُصْحُهُ","تَفَكَّرَ فيها خُطَّةً فَتَحيَّرا",41,"ر",2,1],["أبا قاسم والفضل فيك سجية","وأنت بكل المعلوات خليق",42,"ق",1,1],["أبا قاسم أنت نعم الخليل","وإن حلت عن ودنا الصادق",43,"ق",1,0],["أَبا قاسِمٍ وَالهَوى جنَّةٌ","وَهَا أَنا مِن مَسِّهِ لَم أُفِق",44,"ق",1,1],["ابا قاسم خذها على البعد مدحة","أبت من سواكم ان يساق لها مهر",45,"ر",1,0]]}