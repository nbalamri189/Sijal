oetsgate.com/ViewPoem.aspx?id=198867",""],[5431,"زرياب وآلته ...","https://www.poetsgate.com/ViewPoem.aspx?id=205152",""],[5458,"حتى يقال وقد قيل","https://www.poetsgate.com/ViewPoem.aspx?id=113377",""],[5458,"ملكة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=72162",""],[5537,"نقاش أمن قومي","https://www.poetsgate.com/ViewPoem.aspx?id=207782",""],[5616,"يمن","https://www.poetsgate.com/ViewPoem.aspx?id=203463",""],[5674,"مأسور ويعشق آسره","https://www.poetsgate.com/ViewPoem.aspx?id=190017",""],[5732,"قالو تتوب وقلت بالطرف مصيوب","https://www.poetsgate.com/ViewPoem.aspx?id=177872",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[5736,"في هدأة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=203907",""],[5781,"قولي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=176234",""],[5781,"حبُّكَ...في الأول من نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=212813",""],[5853,"((القضاة الأربعة ؟ )))","https://www.poetsgate.com/ViewPoem.aspx?id=175665",""],[192,"قالوا ترى","https://www.poetsgate.com/ViewPoem.aspx?id=9856",""],[5939,"خان الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=178583",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[5977,"أمة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=212755",""],[6142,"يا فاتحا مغلق الأمصار أجمعها","https://www.poetsgate.com/ViewPoem.aspx?id=155743",""],[6167,"على شط الأربعين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85485&r=&rc=14",""],[6300,"كلمات في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82851&r=&rc=22",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""]],"verses":[["قالوا بَلى قُلتُ فَما","أَحدَثَ قالوا غَفَرا",0,"ر",2,0],["قالوا بك الورد والأيام شاهدة","بأنّ غيرك فيه الورد معطار",1,"ر",1,0],["قالوا بهِ عارضٌ وعَيْنُ","قلتُ وبي عارضٌ وعينُ",2,"ن",1,0],["قالوا بدا الشَّعرُ أما تشعرُ","قلتُ مِنَ الواجبِ أنْ تعذروا",3,"ر",3,1],["قالوا بِمَرَّ اليَومَ ثُمَّ مَبيتَهُم","ضَحيانُ أُو عُسفانُ إِن هُم أَسرَعوا",4,"ع",3,0],["قالوا بَلى فَأَطَعنا سادَةً بَطَروا","وَغَرَّنا طولُ هَذا العَيشِ وَالعُمُرُ",5,"ر",1,0],["قالوا بِمَن لا تَرى تَهذي فَقُلتُ لَهُم","الأُذنُ كَالعَينِ تُؤتي القَلبَ ما كانا",6,"ن",2,0],["قَالوا بِسَلمى تَهذي وَلَم تَرَها","يا بُعدَ ما غاوَلَت بِكَ الفِكَر",7,"ر",1,0],["قالوا بَنو عَمِّكُم مِن حَيثُ نَنصُرُكُم","قَولُ الرَسولِ وَهَذا قَولُ صُدّادِ",8,"د",1,0],["قالوا بأن حي","له على عرشه ثبوت",9,"ت",1,1],["قالوا: بنو العباس، قلنا: أيْنَ هُمُ","ليروا جمالاً في الزمان الحاضر؟",10,"ر",1,0],["قالوا: بلاد الزيت، قل","ت: بلادُ أبطال الرجال",11,"ل",1,0],["قالوا بحبك قد اسرفت في ولهي","والحب اشرفه يا ريم اسرفه",12,"ف",2,0],["قالوا بوادي الشتا لاحت مكحلة","فما عليك ارعوى من خدها القاني",13,"ن",2,0],["قالوا بخلتِ وما بخلتِ وإنما","وصلُ المليحةِ في الجفاءِ ثمينُ",14,"ن",1,0],["قالوا به قد فتنت دهرا","وجار فاعدل الى سواه",15,"ا",2,0],["قالوا بهِ حولٌ يُشانُ بهِ","حُسنُ محيّاه أيّما شينِ",16,"ن",1,1],["قالوا بِقَلبِكَ مِنهُ شَيءٌ قَلتُ لا","بَل إِنَّ فيهِ لَعَمرُكُم أَشياءَ",17,"ا",2,0],["قالوا بياض الشيب نور ساطع","يكسو الوجوه مهابة وضياء",18,"ا",2,1],["قالوابإصرارهم للمسْتخفِّ بهم:","إن كنت ريحاً فقد لاقيتَ إعصارا",19,"ر",2,0],["قالوا بحاجب من صابيتها أثرٌ","فقلت مهلاً فلي من ذاك صدق خبر",20,"ر",1,1],["قالوا بهِ رمدٌ ينهى لواحظهُ","فلا تخافُ على قلبٍ ولا كبدٍ",21,"د",1,1],["قالوا بكيت دماً والعيس سائرة","بكل خالٍ به في الحي مشغول",22,"ل",1,0],["قالوا بأنك جامع للمال لا","تلوي على شيء ولست رحيما",23,"م",2,0],["قالوا بأنك في وعودك مخلف","راجيك فيهم لم يزل محروما",23,"م",2,0],["قالُوا بلَى يَخطبُ بِنتا عندَنَا","قُلتُ دعُوا المزَاحَ عنكُم واذهبُوا",24,"ب",3,0],["قالوا بلى نفعل قال انطلقوا","من فوركم هذا إذا فحلقوا",25,"ق",3,0],["قالوا بذاك أمر الإمام","قالا فقوموا نحوه فقاموا",25,"م",3,0],["قالوا بَنو ثُعِل نَفَستِ مَكارِماً","تُعزى لِحاتِمِها فَقُلتُ وَما عَسى",26,"س",2,0],["قالوا بدا اليرقانُ ملءَ جُفُونه","وَبَدُونِهِ يدْنُو سُلُوُّ الأَنْفُسِ",27,"س",1,1],["قالوا بانك خير من اصفى الولا","فاجبتهم ان لم يكن حسن فمن",28,"ن",1,0],["قالوا بكيت صبابة","فأجبت هذا ما جرى",29,"ر",2,0],["قالوا بساطُ الريح وهمٌ كاذبٌ","فإذا بهم قد شاهدوهُ عيانا",30,"ن",2,0],["قالوا بطيب المسك يعبق نفحهُ","اني وطيب المسك منه يعبق",31,"ق",1,0],["قالوا بمن تصح حال الأنام","قلت إذا ساد الكرام اللئام",32,"م",1,1],["قالوا بمن نقوى على سده","قلت ابذروا في الشعب حب الوئام",32,"م",1,0],["قالوا بَلغت المُنى بِالمَدح في حسنِ","ربِّ المَعارف وَالإقبال وَالفطنِ",33,"ن",1,1],["قَالُوا بِمُقلتِهِ احمرارٌ شانَها","هَيْهات عِنْدي عِلْمُ ما لَمْ تَعلموا",34,"م",3,1],["قالوا به زُرْقَةٌ فقلتُ لهم","بذاك تَمَّتْ خصالُه البَهْجَهْ",35,"ه",1,1],["قَالُوا بِمَا تَلْقَى الإلَ","هَ وَأنْتَ عَاصٍ مُعْتَدِ",36,"د",1,1],["قالوا بدا نبتُ خديهِ فخذ بدلاً","عنه فقلتُ لهم حاشاه حاشاه",37,"ه",1,1],["قالوا بَدا في خَدِّهِ الشَعرُ","وَأَنتَ لا عَقلٌ وَلا صَبرُ",38,"ر",1,1],["قالوا: بكيت دماً؟ فقل","ت: مسحت من خدي خلوقا",39,"ق",2,1],["قالوا به عين فقلت نعم وبي","ثغر حمته البيض وهي غوار",40,"ر",1,0],["قالوا به خورُ الخِلال لِحِلمِه","وَلدى السَّفيه الحِلمُ شيءٌ مزدرى",41,"ر",2,0],["قالوا بعينيه في إبصاره وَطَف","قالوا به كحلٌ قالوا به دَعَجُ",42,"ج",1,0],["قَالُوا بِأنَّ اللهَ حَقًّا لَم يَزَل","مُتَكَلِّماً بِمَشِيئَةٍ وَبَيَانِ",43,"ن",1,0],["قَالُوا بِأنَّ الجِسمَ مِنهُ مَرَكَّبٌ","وَلَهُم خِلاَفٌ وَهوَ ذُو ألوَانِ",43,"ن",1,0],["قالوا بأن مجيئها","لا شك في نفع وخير",44,"ر",1,0],["قالوا بقطرك للتحف","ز بحر آمال يمور",44,"ر",1,0],["قالوا بأَنكِ تُبتِ قلتُ لك الهنا","أَلذنبُ تغسله دموعٌ تسفح",45,"ح",1,0],["قالوا بكيت دماً ونحن مَدَامعاً","قُولوا لهم ما الدمعُ يشبهه الدم",46,"م",1,0],["قالوا بعيد يرى فينا بلا سببٍ","كلا ولكنني فيهم بلا نشب",47,"ب",1,0],["قالوا بوجه الذي أحببته كلفٌ","فقلت بدرٌ وما يخلو من الكلف",48,"ف",1,1],["قالوا بعينيك يا عين المها حول","فقلت مه حَيلٌ في العين لا حول",49,"ل",1,0],["قالوا بليت بأعرجٍ فأجبتهم","العيب يحدث في غصون البان",50,"ن",1,1],["قالوا براه سُرىً أدمى حشاشته","فعاد منه طريحاً نضو أسفار",51,"ر",1,0],["قالوا به صُفرةٌ عابت محاسَنه","فقلتُ ما ذاك من داء به نَزلا",52,"ل",2,1],["قالوا بِهِ شامَةٌ في ثَ