"الخفيف"],[561,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[561,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[570,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[570,"من تراه ينصفني من خليل","https://www.aldiwan.net/poem69533.html","الخفيف"],[570,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[578,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[578,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[589,"كيف يلحى على هواك الكئيب","https://www.aldiwan.net/poem17414.html","الخفيف"],[589,"من لي به رق معنى فيه رونقه","https://www.aldiwan.net/poem17619.html","البسيط"],[700,"","https://poetry.dctabudhabi.ae/diwan/poem/20869","الرمل"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/18988","البسيط"]],"verses":[["يا أُخْتَ سَعْدٍ وسَعْدٌ خَيْرُ مَنْ جَذَبَتْ","إِلى العُلا ضَبْعَهُ الأشياخُ منْ حَذَفِ",0,"ف",1,0],["يا أُخْتَ مُعتَقِلِ الأرْماحِ يتْبَعُهُ","إِلى وقائِعِهِ نَسْرٌ وسِرْحانُ",1,"ن",1,0],["يا أخْتَ مُقتَحِمِ الأسنّةِ في الوَغى","لَولا مُراقَبَةُ العِدا لَم تُهْجَري",2,"ر",2,0],["يا أُختَ مُقتَنِصِ الكُماةِ بمَوقِفٍ","للنَّسْرِ تحتَ عَجاجِهِ تَرنِيقُ",3,"ق",1,0],["يا إِخوَتي إِنّي لَمَوضِعُ رَحمَةٍ","لَو أَنَّ مَن يُشكى إِلَيهِ رَحيمُ",4,"م",1,1],["يا أَخا البَدرِ سَناءً وَسَناً","حَفِظَ اللَهُ زَماناً أَطلَعَك",5,"ك",1,0],["يَا آخِذِينَ الصِّغَارِ لَقَدْ","صُنْتُمْ مَرَابِعَكُمْ مِنْ أَكْبَرِ المِحَنِ",6,"ن",1,0],["يا أَخي قَد وَهَبتُ ذَنبَ زَمانٍ","طَرَقَتني صُروفُهُ بِالمَهالِك",7,"ك",1,1],["يا أَخي يا أَبا زُهَيرٍ أَلي عِن","دَكَ عَونٌ عَلى الغَزالِ الغَريرِ",8,"ر",1,0],["يا أُختَ آلِ فِراسٍ إِنَّني رَجُلٌ","مِن مَعشَرٍ لَهُمُ في المَجدِ بُنيانُ",9,"ن",1,1],["يا أختَ أقمارِ السماءِ محاسناً","والشمسِ نوراً والنجومِ مناسبا",10,"ب",2,0],["يا أخا الفضل لا يعطل في با","بك جيدٌ ومسمعٌ من عقود",11,"د",1,0],["يا أخا العلم والمكارم والبا","س وجمع الثنا وبثّ الصنيع",12,"ع",1,0],["يا أخي أين رَيْعُ ذاك اللِّقاءِ","أين ما كان بيننا من صفاءِ",13,"ا",2,1],["يا أخي هَبْكَ لم تهبْ ليَ من سَع","يك حظاً كسائر البُخلاءِ",13,"ا",2,0],["يا أخي يا أخا الدَّماثة والرق","قَة والظَّرف والحِجا والدهاءِ",13,"ا",2,0],["يا أخاً حَلَّ في المكارم والسؤْ","دَدِ أعلى مَحَلِّ أهل السَّناءِ",14,"ا",2,0],["يا أخي يا أبا الحُسَيْ","ن صَرِيخَ المصوِّتِ",15,"ت",1,0],["يا أخَا النَّهْض الذي ما مثله","حين لا تنهض بالقوم الجُدودُ",16,"د",1,0],["يا أخا العدل والذي فضلُهُ المب","سوط فينا وبِشره المنشورُ",17,"ر",1,0],["يا إخوتي إن عيشةً شغلت","بشاغلٍ حقُّ عيشة كدره",18,"ر",2,0],["يا أخيِ يا أبا الحسين وإِلفي","هاكها حكمة كحكمة قُسِّ",19,"س",1,0],["يا آخراً أضحى لأوله","كالسجدة اتصلت بها الركعه",20,"ع",2,0],["يا أخا النحو والمُقَدَّمَ فيه","لَم ترَ اللام أُدغمت في الميم",21,"م",1,0],["يا أخي مِنْ أبي وما كان يَزْني","حاشَ للَّهِ بل صحيحُ التَّقِيَّهْ",22,"ي",2,1],["يا أَخي لا تَمِل بِوَجهِكَ عَنّي","ما أَنا فَحمَة وَلا أَنتَ فَرقَد",23,"د",1,0],["يا أُختَ دارِ الخُلدِ يا أُمَّ القُرى","يا رَبَّةَ الغابات وَالأَنهارِ",24,"ر",1,0],["يا أُختَ ظَبيِ القاعِ لَو أَعطَيتِهِ","لَحظَيكِ صادَ الصائِديهِ أَخوكِ",25,"ك",1,0],["يا أَخا الوَرقاءِ غَنِّ","فَالغِنا شِعرُ السَماء",26,"ا",2,0],["يا آخِذي بَل تارِكي","في لَوعَةٍ هِيَ ماهِيَه",27,"ي",2,0],["يا آخِذاً قَلبي أَما","قَضَيتَ مِنهُ وَطَرَك",28,"ك",1,0],["يا أَخا البدرِ سناء وسنى","حفظ اللَه زماناً أطلَعك",29,"ك",1,0],["يا أَخا النَفسِ في الصِبا","لَذَّةُ الروحِ في الصِغَر",30,"ر",1,0],["يا أَخي وَالذُخرُ في الدُنيا أَخٌ","حاضِرُ الخَيرِ عَلى الخَيرِ أَعانا",31,"ن",2,0],["يا أُختَ أَندَلُسٍ عَلَيكِ سَلامُ","هَوَتِ الخِلافَةُ عَنكِ وَالإِسلامُ",32,"م",1,1],["يا أُختَ خَيرِ أَخٍ يا بِنتَ خَيرِ أَبٍ","كِنايَةً بِهِما عَن أَشرَفِ النَسَبِ",33,"ب",1,1],["يا أُختَ مُعتَنِقِ الفَوارِسِ في الوَغى","لَأَخوكِ ثَمَّ أَرَقُّ مِنكِ وَأَرحَمُ",34,"م",1,0],["يا أَخا الأَزدِ ما حَفِظتَ الإِخاءَ","لِمُحِبٍّ وَلا رَعَيتَ الوَفاءَ",35,"ا",2,1],["يا أَخا الحارِثِ إِنّي","خارِجٌ عِندَ الرَواحِ",36,"ح",1,1],["يا أَخا الشامِ اِمضِ مَكلوءً فَما","جانِبي مِنكَ وَلا ضَلعي مَعَك",37,"ك",1,0],["يا أَخا الحارِثِ بنِ كَعبِ بنِ عَمرٍ","أَشُهوراً تَصومُ أَم أَيّاما",38,"م",2,1],["يا أَخا الفَضلِ وَالنَدى يا أَبا ال","عَبّاسِ زَينَ الكُهولِ وَالشُبّانِ",39,"ن",1,1],["يا أُختَ ناجِبَةَ اِبنِ سامَةَ إِنَّني","أَخشى عَلَيكِ بَنِيَّ إِن طَلَبوا دَمي",40,"م",2,1],["يا أَخي ما أَغَرَّنا بِالمَنايا","في اِتِّخاذِ الأَثاثِ بَعدَ الأَثاثِ",41,"ث",1,0],["يا أَخا المَيتِ الَّذي شَيَّعَهُ","فَحَثا التُربَ عَلَيهِ وَرَجَع",42,"ع",1,0],["يا إِخوَةً خُنّا المُحيطَ بِنا","عِلماً وَأَنفُسَنا الَّتي خُنّا",43,"ن",2,0],["يا إِخوَتي إِنَّ الهَوى قاتِلي","فَيَسِّروا الأَكفانَ مِن عاجِلِ",44,"ل",1,1],["يا أخت هند خبّريها أنني","صبٌّ يعيش بمهجة المتألم",45,"م",1,0],["يا إخوةَ الإصلاح بُورِك سعيُكم","من فِتْيَةٍ زانوا الشَّبابَ وَقارا",46,"ر",2,0],["يا آخِذي المال غَصباً تَرفَعونَ بِهِ","مَيلَ الدَعائِمَ مِن مُلكٍ قَواريرِ",47,"ر",1,0],["يا أَخا الفَضلِ وَيا رَبَّ العُلا","وَالمَعاني الغُرِّ في تِلكَ الفُنون",48,"ن",1,0],["يا إِخوَتي ذا الصَباحُ فَاِصطَبِحوا","فَقَد تَغَنَّت أَطيارُهُ الفُصُحُ",49,"ح",1,1],["يا أخْتَ سعْدٍ مِن حَبيبي جئتِني","بِرِسالةٍ أدّيتِها بِتَلَطّف",50,"ف",1,0],["يا أخا العّذلِ فيمن الحُسْنُ مثلي","هامَ وجْداً به عَدِمْتُ أخاكا",51,"ك",2,0],["يا أخا البلبل شدواً وشعوراً واعتقالا","كلُّنا يدري الذي تلقى كفيناك مقالا",52,"ل",2,0],["يا أَخا الجودِ لَيسَ مِثلُكَ مَوجو","داً وَإِن كانَ بادِياً لِلعَيانِ",53,"ن",1,0],["يَا أُخْتَ آلِ شِهَابٍ هَلْ عَلِمْتِ إِذَا","أَنْسَى الحَرِائِرَ اللَّبْسَةِ الفَزَعُ",54,"ع",1,0],["يا أخا الرُّوحِ دعا الشوقُ بنا","فاسْقِنا من خمرةِ الرَّيْن اسقنا",55,"ن",2,0],["يا أخت طالعة الشموس تطلَّعي","للورد بين مفتَّحٍ وكفيفِ",56,"ف",1,0],["يا أُخْتَ نَضْلَة هل يَسوءُكِ أنّنا","باتَ المَطِيُّ بنا إليكِ يَسُوك",57,"ك",1,0],["يا أُختَ ناجِيَةَ السَلامُ عَلَيكُمُ","قَبلَ الرَواحِ وَقَبلَ لَومِ العُزَّلِ",58,"ل",1,0],["يَا أَخِي سَركِيسُ قُلْ عَنِّي عَلَى","مَلإِ النَّاسِ لِمُصْغٍ بِاعْتِبَارِ",59,"ر",1,0],["يَا أَخَاً الرَّأْيِ لاَ يَطِيشُ إِذَا طَا","شَ لِحِرْصٍ فِي النَّفْسِ رَأْيٌ أَصِيلُ",60,"ل",1,0],["يَا أَخلصَ 