{"poems":[[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[85,"يا من تمد له الملوك أكفها","https://www.aldiwan.net/poem54343.html","الكامل"],[63,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[68,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[82,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[46,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[42,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[54,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54239","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[119,"البرق حاجر ام لبرق الشام","https://www.aldiwan.net/poem40593.html","عموديه"],[173,"سائل ديار الحي من ماوان","https://www.aldiwan.net/poem1687.html",""],[186,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[240,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[266,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[325,"هات اسقني من رائق الصهباء","https://www.aldiwan.net/poem67192.html","الكامل"],[331,"حي المنابر بالسلام","https://www.aldiwan.net/poem44246.html","مجزوء الكامل"],[353,"من كل خواض الغمار بلأمة","https://www.aldiwan.net/poem19818.html","الكامل"],[353,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[463,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[463,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[469,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[469,"إسفك نديم دم الكرى","https://www.aldiwan.net/poem3327.html","عموديه"],[567,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122685","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63938","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70746","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115918","المجتث"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101023","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96492","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96506","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124717","السريع"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100467","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141206","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100274","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135219","الرجز"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32483","المجتث"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""]],"verses":[["من كل خافقة الشراع مصفّقٍ","مها الجناحُ تطير كل مطارِ",0,"ر",1,0],["من كل خافقة الجناح إذا مشت","تبدي اختيال الغادةِ العذراءِ",1,"ا",2,0],["من كلِّ خَضراءِ الذَّوائبِ زُيِّنَتْ","بِثمارِها جيداً لها ومُقَلَّدا",2,"د",2,0],["من كل خالدة المحاسن ما حوت","ذكر امرىء إلا وراح مخلدا",2,"د",2,0],["مِن كُلِّ خَفّاقِ اللِواءِ لابِسٍ","ثَوبَ الفَخارِ مُطَرَّزاً بِالسُؤدَدِ",3,"د",1,0],["من كلّ خودٍ كالغزالةِ قِرْنُها","أسَدٌ أُذِلّ وإنّها لَرَداحُ",4,"ح",1,0],["مِن كُلِّ خَودٍ دَعاها البَينُ فَاِبتَكَرَت","بِكراً وَلَكِن غَدا هِجرانُها نَصَفا",5,"ف",2,0],["مِن كُلِّ خَرعَبَةٍ مُبتَّلَةٍ","صِفرِ الوِشاحِ كَأَنَّها بَدرُ",6,"ر",1,0],["مِن كُلِّ خالِدَةٍ كَسَت","ها النارُ لَوناً أَكلَفا",7,"ف",2,0],["من كلّ خاملِ نفسٍ غيرِ طاهرةٍ","منهم ولابِسِ عِرْضٍ غيرِ قوهيّ",8,"ي",1,0],["مِنْ كلِّ خَمْصَانَةِ الكَشْحَيْنِ ناصِعَةٍ","كأَنّها دُرَّةٌ في جَوْفِ زخّار",9,"ر",1,0],["مِنْ كُلِّ خَطَّارٍ إِلَى غَايَاتهِ","يُزْهَى به الصَّمْصَامُ والْخَطَّار",10,"ر",1,0],["من كل خشف حين تبصر عينه","تلفي من الرمشات حد حسام",11,"م",1,0],["مِن كُلِّ خَرعَبَةٍ تُريكَ إِذا بَدَت","بَدرَ الدُجُنَّةِ فَوقَ غُصنِ البانِ",12,"ن",1,0],["مِن كُلِ خَنَّاسٍ إِذا اِستَقبَلتَهُ","فَإِذا اِنقَلَبَت رَنا بِمُقلةِ شاذرِ",13,"ر",1,0],["مِن كُلِّ خَوّاضِ الغَمارِ مُلَجِّجٍ","مَرنٍ عَلى سَفكِ الدِماءِ مُغامِرِ",14,"ر",1,0],["من كل خل ماجد ما نخلة","وليس فينا خلل وختل",15,"ل",1,0],["من كلّ خوّارٍ يُشَمّر ثوبَه","ويدوسُ أذيالَ الإمامِ الساجد",16,"د",1,0],["مِن كُلِّ خَودٌ بِالجَمالِ تَبَرَّجَت","وَبِظَرفِها اِستَغنَت عَنِ الأَزياءِ",17,"ا",2,0],["مِن كُلِّ خَرقاءِ اليَدَي","نِ عَلى اِنقِضابٍ وَاِنجِذامِ",18,"م",1,0],["مِن كُلِّ خَوَّاضِ الغِمارِ بِلأْمَةٍ","نُسِجَتْ عليهِ مِن حَبابِ الماءِ",19,"ا",2,1],["مِن كُلِّ خَفَّاقِ الجَناحِ أجْدَلِ","كالصَّخرَةِ الصَّمَّاءِ حُطَّتْ مِن عَلِ",20,"ل",1,0],["من كل خير جزيل","والفوز بالدرجات",21,"ت",1,0],["من كل خافقةِ الأحشاء ساكنةٍ","تضاحك الليلَ والأجفانُ تنسجمُ",22,"م",1,0],["من كل خاوي الصدرِ أجوفَ لو رمى","بلعابه الصخرَ الأصمَّ لزلزلا",23,"ل",2,0],["من كل خالدة القوافي أشبهت","نعماك في الإكثار لا إيطائها",24,"ا",3,0],["من كلِّ خاطبةٍ بعودٍ","مخجلٍ ناياً وعودا",25,"د",2,0],["من كلِّ خَزْراءِ عينٍ لا تُخَازِرُها","كحلاءَ ليسَ بها للكُحلِ من أثَرِ",26,"ر",1,0],["مِن كلِّ خَيطَفَةِ اليَدَينِ خِلالُه","سَرحٌ وَمُندَمِجِ الفَقارَةِ خَيطَفِ",27,"ف",1,0],["من كلِّ خالصةِ الجمالِ استأسرتْ","منّا نفوساً ما لهنَّ خَلاص",28,"ص",1,0],["مِنْ كل خَبٍّ خلوبٍ كاذب أشِرٍ","مُمَوَّه القولِ ملعونٍ ومثبور",29,"ر",1,0],["من كلِّ خَطبٍ مَخُوفٍ","وكلِّ داءٍ مُضِرِّ",30,"ر",1,0],["من كل خائنة الحلي","ل تهيم في ظل الخليل",31,"ل",1,0],["من كل خنذيذٍ يرى بلبانه","وقع الظُّباة مع القنا الخطار",32,"ر",1,0],["من كل خطَّار فراسية","جهم المحيا أيدٌ البذم",33,"م",1,0],["من كل خودٍ غضةٍ بضةٍ","مهضومةٍ ذات شوى جدلِ",34,"ل",1,0],["من كل خواض الملاحم عابس","إن كشرت ناب الوغى يتبسم",35,"م",1,0],["من كلِّ خيرٍ وكلِّ شرٍّ","علمت فيه لما جمعتا",36,"ت",2,0],["من كل خود عذبة الألفاظ","تقتل من تشاء بالألحاظ",37,"ظ",1,0],["من كل خرق إلى نهدٍ تقاذف بي","لم تثن عنه عناني النَّهدُ الخود",38,"د",1,0],["من كلِّ خير دهرنا ولو لفخ","كذاك يوم مَلَكٍ صوراً نفخْ",39,"خ",1,0],["مِن كُلِّ خَوفٍ مُخيفٍ","في السِرِّ وَالإِعلانِ",40,"ن",1,0],["مِن كُلِّ خِرقٍ مُنصِفٍ مُتّصِفٍ","بِالعَدلِ ما مارَى امرأً ولا مَرى",41,"ا",1,0],["( من كلِّ خمصانةِ الأحشاءِ، يحرسُها","غَضْبُ الجَنَانِ جرئٌ) يدفعُ المِحَنا",42,"ن",2,0],["من كل خير وكل عارفة","ونعمة تأتهم على نشف",43,"ف",1,0],["من كل خاطفة للقلب مخطفة","بالخصر تمطلني ديني وتكويني",44,"ن",2,0]]}