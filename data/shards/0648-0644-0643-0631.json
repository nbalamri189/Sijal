{"poems":[[50,"شعر ميت أتاك في لفظ حي","https://www.aldiwan.net/poem64418.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20998","الخفيف"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135745","الرجز"]],"verses":[["وَلَكَرَّرتَ طَرفَ عَينِكَ فيمَن","قَد بَراهُ السَقامُ حَتّى تَعَفّى",0,"ف",2,0],["وَلِكَرِّي الكُمَيتَ في حَوَمةش ال","مَوتِ مَكاناً أَقلُّهُم فيهِ ناجِ",1,"ج",1,0],["وَلِكَرِيمٍ وَبَخِيلٍ فُعَلاَ","كَذَا لِمَا ضَاهَاهُماَ قَد جُعِلاَ",2,"ل",2,0],["ولك ربي الحمد خالداً خلودْ","ذاتكَ لا لهُ من الحدِّ حدودْ",3,"د",1,0]]}