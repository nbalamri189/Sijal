522",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108103","الطويل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88546","الوافر"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107504","البسيط"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132186","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28760","المنسرح"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58177","الطويل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99106","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204185",""],[3591,"يا حافظ الشعر ويا شاعراً","https://www.poetsgate.com/ViewPoem.aspx?id=149433",""],[5247,"تاني حذيفة ما مثله","https://www.poetsgate.com/ViewPoem.aspx?id=52906",""],[5431,"حزنا وتطعمه من روحنا سعفا","https://www.poetsgate.com/ViewPoem.aspx?id=188385",""],[5431,"ابتلاء الشوق...","https://www.poetsgate.com/ViewPoem.aspx?id=215616",""],[5790,"لمهيار مصرٍ أسجل الفضل عندنا","https://www.poetsgate.com/ViewPoem.aspx?id=111915",""],[6056,"نار الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=156700",""],[6084,"وليلة بتنا والمدام يديرها","https://www.poetsgate.com/ViewPoem.aspx?id=170860",""],[6125,"كأنَّا بما في هَوَانا ارتَوَينَا","https://www.poetsgate.com/ViewPoem.aspx?id=212881",""],[520,"سرى لك عرف في النسيم الذي سرى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577513",""],[520,"فيا ايها الدست الذي غاب صدره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577592",""],[5555,"مَلاعِبُنَا الأُولَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87420&r=&rc=15",""]],"verses":[["كَأَنَّ أَبا عُبادَةَ شَقَّ فاها","وَقَبَّلَ ثَغرَها الحَسَنُ بنُ هاني",0,"ن",2,0],["كَأَنّا بِنَجدٍ غَداةَ الوَداعِ","نُصادي عُيوناً مِنَ الدَمعِ رُمدا",1,"د",2,0],["كَأَنَّ أَبَاهُ الدَّوْحَ وَرَّدَ خَدَّهَا","بِمَا جَادَهُ النِّيسَانُ مِنْ وَرْدِهِ الْغَضِّ",2,"ض",1,0],["كَأَنَ ابْنَ حُجْرٍ قَدْ عَنَاهُ بِقَولِهِ","كَجُلْمُودِ صَخْرِ حَطَّهُ السَّيْلُ مِنْ عَلِ",3,"ل",1,0],["كأنّا بِتامَسْنا نَجوسُ خِلالَها","ومَمْدودُها في سيْرِنا ليْسَ يَقْصُرُ",4,"ر",1,1],["كَأَنَّ أَبا بَكرٍ الأَسلَمِيَّ","أَجرى عَلَيها فِرَندَ الكَرَم",5,"م",1,0],["كَأَنَّ أَباناً في أَفانينِ وَدقِهِ","كَبيرُ أُناسٍ في بِجادٍ مُزَمَّلِ",6,"ل",1,0],["كَأَنَّ اِبنَ لَيلى حِينَ يَبدو فَتَنجَلي","سُجُوفُ الخِباءِ عَن مَهِيبٍ مُشَمَّتِ",7,"ت",1,0],["كأنّ ابنَ عَمّتِكُمْ حقّاً وضَيفَكُمُ","فيكمْ فلَمْ تَدفَعوا عَنْهُ بإخْفارِ",8,"ر",1,0],["كَأَنَّ اِبنَ عَمروٍ لَم يُصَبَّح لِغارَةٍ","بِخَيلٍ وَلَم يُعمِل نَجائِبَ ضُمَّرا",9,"ر",2,1],["كَأَنَّا بِذَاكَ العَهْدِ بَعْدَ انْقِطَاعِهِ","وطُولِ التَّرَاخِي آبَ مُتَّصِلُ السَّبَبْ",10,"ب",1,0],["كَأَنَّ أَباها نَهشَلٌ أَو كَأَنَّهُم","بِشِقشِقَةٍ مِن رَهطِ قَيسِ بنِ عاصِمِ",11,"م",1,0],["كان أبو الطيّب امرأ قوله","يبتكر الشعر مذكياً شعله",12,"ل",2,1],["كانَ اِبنُ سيسَنَ طاغِياً فَرَدَدتَهُ","رِخوَ الأَخادِعِ في الكُبولِ مُقَيَّدا",13,"د",2,0],["كأنَّ ابنَ آوى مُوثَقٌ تحتَ زَورِها","يُظَفِّرُها طَوراً وَطَورَاً يُنَيِّبُ",14,"ب",1,0],["كَأَنَّ اِبنَةَ القَيسِيِّ في أَخَواتِها","خَذولٌ تُراعيها الظِباءُ الخَواذِلُ",15,"ل",1,0],["كانَ اِبنُ عَمّي إِن عَرا حادِثٌ","كَاللَيثِ أَو كَالصارِمِ الصاقِلِ",16,"ل",1,0],["كانَ اِبنُ عَمّي عالِماً فاضِلاً","وَالدَهرُ لايُبقي عَلى فاضِلِ",16,"ل",1,0],["كانَ اِبنُ عَمّي بَحرَ جودٍ طَمى","لَكِنَّهُ بَحرٌ بِلا ساحِلِ",16,"ل",1,0],["كأن أبيضَ هذا تلو أسوَد ذا","عينُ الزمان الذي ما زاغَ باصره",17,"ر",2,0],["كان ابنُ حربٍ حين جادَ به","لا شك فيه يُريد بي الحَرَبا",18,"ب",2,0],["كأنَّ أباه يوم سمَّاهُ صاعداً","رأى كيفَ يَرْقَى في المعالي ويَصْعدُ",19,"د",1,0],["كأنّ أباه حين واقع أمَّه","أتاها وفي إحليله كُوزُ بَلْغَمِ",20,"م",1,1],["كَأَنَّ اِبنَةَ السَهمِيِّ دُرَّةُ قامِسٍ","لَها بَعدَ تَقطيعُ النُبوحِ وَهيجُ",21,"ج",1,0],["كَأَنَّ اِبنَةَ السَهمِيِّ يَومَ لَقيتُها","مُوَشَّحَةٌ بِالطُرَّتَينِ هَميجُ",21,"ج",1,0],["كَأَنَّ أَبا مَروانَ يُنزَعُ ضِرسُهُ","إِذا القَومُ قالوا مَتِّعونا بِدِرهِمِ",22,"م",1,1],["كَأَنَّ اِبنَةَ الزَيدِيِّ يَومَ لَقيتُها","هُنَيدَةَ مَكحولُ المَدامعِ مُرشِقُ",23,"ق",1,1],["كَأَنَّ إِبريقَهُم ظَبيٌ عَلى شَرَفٍ","مُفَدَّمٌ بِسَبا الكَتّانِ مَلثومُ",24,"م",1,0],["كأن أباه مر بأح","مدَ الهادى يكلمه",25,"م",2,0],["كان إبراهيم يبنى","كعبة للصالحين",26,"ن",1,0],["كانَ اِبنُ داوُدٍ يُقَر","رِبُ في مَجالِسِهِ حَمامَه",27,"م",2,1],["كانَ أَبوكَ قَد رَأى الفَلاحا","في أَن تَكونَ مِثلَهُ فَلّاحا",28,"ح",2,0],["كانَ اِبتِداؤُكَ بِالعَطاءِ عَطِيَّةً","أُخرى وَبَذلُكَ لِلجَسيمِ جَسيما",29,"م",2,0],["كانَ اِبنُ موسى قَد بَنى ذا هَيبَةٍ","صَعبَ الذُرى مُتَمَنِّعَ الأَركانِ",30,"ن",1,0],["كأنَّا بنو هاشمٍ صَولةً","إذا نَفَتِ الهَمَّ أفراحُنا",31,"ن",2,0],["كانَ ابتداؤُكَ شيمَةً عَدَوِيَّةً","تُنبي عن الكَرَمِ التَّليدِ وتُخبِرُ",32,"ر",1,0],["كأنَّ أبراجَه من كلِّ ناحيةٍ","أبراجُها والدُّجى وَحْفٌ غَياهبُه",33,"ب",2,0],["كأنّ ابن يحيى والحيا صنوُ جودِهِ","سقى تُرْبَها صَوْبَ الغوادي الهواطِلِ",34,"ل",1,0],["كانَ ابتداءُ فسادِهِمْ لهُمُ","وَعَلَيهِمُ بِصَلاحِهِ الخبَرُ",35,"ر",1,0],["كانَ ابتِدائي إِلَيه عاطِلاً فغدا","منه بِحَلْيِ الأماني حاليَ الخَبَرِ",36,"ر",1,0],["كَانَ إِبْرَاهِيمُ خَالِي","فِيهِ مَشْهُورَ الْمَقَالَهْ",37,"ل",2,0],["كانَ أَبوها راعياً غاشماً","للذئب لا للحبّ ربّاها",38,"ا",3,0],["كَأَنَّ أَبيَضَهُ مِن فَوقِ أَحمَرِهِ","كَواكِبٌ أَشرَقَت في حُمرَةِ الشَفَقِ",39,"ق",1,0],["كأنّا بنوه أهلُهُ وعَشِيرُهُ","يُرَشِّحُنَا بالمَأثُراتِ الجلائل",40,"ل",1,0],["كَأَنَّ إِبريقَنا إِذا صُفِقَت","في الكَأسِ شَيخٌ مُزَمزِمٌ شَرِقُ",41,"ق",1,0],["كَأَنَّ إِبريقَنا ظَبيٌ عَلى شَرَفٍ","قَد مَدَّ مِنهُ لِخَوفِ القانِصِ العُنُقا",42,"ق",2,0],["كَأَنَّ إِبريقَنا وَالقَطرُ في فَمِهِ","طَيرٌ تَناوَلَ ياقوتاً بِمِنقارِ",43,"ر",1,0],["كَأَنَّ إِباراً في المَفارِقِ خَيَّطَت","بُرودَ المَنايا وَاللَيالي سُلوكُها",44,"ك",3,1],["كان إبليس قائداً للشياطي","ن وإبليسُ حيث كان قدير",45,"ر",1,0],["كانَ ابنُ آشي وَحْدَهُ قَيْناً لها","إذ قَيْنُ كلّ مُفاضَةٍ مَأفوك",46,"ك",1,0],["كأنّ أبا الوَحيدِ وما عَظيمٌ","لأهْلِ الفَضْلِ أن يأتوا عَظيما",47,"م",2,0],["كان ابتداء الوحي في حراء","فاتحة الرسالة الغراء",48,"ا",2,0],["كَانَ أَبْقَى مِنْهُ الْغَرَامُ قَلِيلاً","فَأَذَابَ الصُّدُودُ مَا قَدْ تَبَقَّى",49,"ق",2,0],["كَانَ أَبْقَى الْوَجْدُ مِنِّي رَمَقاً","فَاحْتَوَى الْبَيْنُ عَلَى مَا تَرَكَا",50,"ك",2,0],["كَان أَباً بِرّاً وَأَصْلاً ذَكا","فَرْعٌ لِلْعَلْيَاءِ مَنْ فُرِّعَا",51,"ع",2,0],["كانَ اِبنَ تِسع وَلكِن","في الأَكثَرينَ عَدَدتُه",52,"ت",2,0],["كانَ أَباً بَرّاً يَعافُ الكرَى","لَوْ مَرَّتِ الريحُ عَلَى وُلْدِهِ",53,"د",2,0],["كأن أباه الدوح ورد خدها","بما جاده نيسان من ورده الغض",54,"ض",1,0],["كَأَنّا بَعدَ مَسلَمةَ المُرَجّى","شُروبٌ طَوَّحَت بِهِمُ عُقارُ",55,"ر",1,0],["كان ابتداء أخيكُمُ مِقَةً","ثم استحالت بعدَ ذا حَربا",56,"ب",2,0],["كَأَنَّ أَباهُ كانَ قاتِلَهُ أَبي","وَها أَنا إِن أَوفى بيَ العُمرُ قاتِلُه",57,"ل",2,0],["كَأَنَّ أَبارِيقَ اللُّجَيْنِ إذا انْحَنَتْ","رِقابُ غرَانِيقٍ تَطَلَّعُ مِنْ وَكْرِ",58,"ر",1,0],["كانَ آباؤُكُم إِذا الناسُ حَربٌ","وَهُمُ الأَكثَرونَ كانَ الحُروبُ",59,"ب",1,0],["كأن ابتلاج الصبح في حالك الدجى","لناظره معنى تخيله الفكر",60,"ر",1,0],["كأن ابن سيفاضم جوداً يمينه","واطلعها بيضاء فانصدع الفقر",60,"ر",1,0],["كان ابن مسلم جار الجنب من برع","فكنت من بعد جاري جارك الجنبا",61,"ب",2,0],["كَأَنَّا بِها قد شايَعَتْهَا عَزَائِمٌ","صِحاحٌ لأَشْياعٍ بِوَجْدِهِم مَرْضَى",62,"ض",2,0],["كَأَنّا بِاَبِي الْيُمْنِ","صَحِبْنا الْعُمْرَ مَعْمُورا",63,"ر",2,0],["كأَنَّ أَبا الْغَنائِمِ كانَ مِمَّنْ","تَعُدُّ وَفاتَهُ غُنْماً كَبِيرا",64,"ر",2,0],["كَأَنَّ اِبنَ آوى موثَقٌ تَحتَ غَرضِها","إِذا هُوَ لَم يَكلِم بِنابَيهِ ظَفَّرا",65,"ر",2,0],["كَأَنّا بِالسُرور وَقَد تَدانى","فَمثّل لِلنُهى بَشراً سَويّا",66,"ي",2,0],["كَأَنّا بِبَحرِ الكُفرِ قَد غيضَ ماؤُهُ","إِذا ما اِستَوَت سُفنٌ لَها القُدسُ كَالجودي",67,"د",2,0],["كان ابنُ شَعيا لهُ عَدُوَّاً","فانضافَ شَعيا إلى ابنِ شَعيا",68,"ي",2,0],["كأن أبا الهَيجاءِ لما اكتَنى بها","أبوه أبو الهَيجاءِ حين يُثيرُها",69,"ر",3,0],["كأنَّ أبانا أودَعَ الملكَ الّذي","قصَدْناهُ كَنْزاً لم يَسَعْ ردَّهْ مَطْلُ",70,"ل",1,0],["كان ابن مسعود يوم الوفد صاحبه","وقد رأى من شروط الجن ما زهقا",71,"ق",2,0],["كأن أبصرت ما بي منك من حزن","فاخترت هذا ولا العشار من كضض",72,"ض",1,0],["كأنَّ ابتلاجَ الصبح أحكام سيّدٍ","خبير بتحقيق العويصات عارف",73,"ف",1,0],["كأنَّا بأدغالٍ نعيشُ فلا نرى","صُروحاً لأحرارٍ وحُلماً مُشَّدا",74,"د",2,0],["كأن ابن خطَّاب تجول بطرْسه","عراكُ المذاكي واطِّرادُ الجحافل",75,"ل",1,0],["كأن ابتسام الومض والأفقُ عابسٌ","صحائفُ بيضٌ في جوانبها حبر",76,"ر",1,0],["كَأَنَّ أَباريقَ الشُمولِ عَشيَّةً","إِوَزَّ بِأَعلى الطَفِّ عوجُ المَناقِرِ",77,"ر",1,0],["كَأَنَّ اِبيِضاضَ الماءِ تَحتَ اِحمِرارِهِ","صَفيحَةُ سَيفٍ قَد جَرى فَوقَها دَمُ",78,"م",1,0],["كان ابنُ رشد في مدى غيه","قد وضعَ الدّين بأوضاعه",79,"ع",2,0],["كأن ابن حجر قد عناه بقوله","نحاول ملكاً أو نموت فنعذر",80,"ر",1,0],["كأن أبا الغارات لم ينش غارة","تريك سواد الليل فيه قساطله",81,"ل",2,0],["كأن أبا الفتح المظفر لم يجب","عليك له الحق الذي ليس يجهل",82,"ل",1,0],["كانَ اِبتِهالُكِ جُنَّةً فإذا رمى","جهتي العِدا تَزْوَرّ عنّي الأسهمُ",83,"م",1,0],["كأن ابتسام البرق في حُجراتهِ","مهَّندَةٌ بيض تُشام وتشهرُ",84,"ر",1,0],["كأنَّ أبا أجَلّهُمُ سُهَيلٌ","فَشيمَةُ خيرِهِم عُسرٌ ومَلسُ",85,"س",1,0],["كأنا بابنِ خولةَ عن قريبٍ","وربُّ العرشِ يفعلُ ما يشاءُ",86,"ا",2,0],["كان آبيس عند تيبت رباً","ليس بدعاً ان صرتم اليوم ربّا",87,"ب",2,0],["كأن ابتسامَ البرقِ فيها إذا بدت","سيوفُ علّيٍ بالدماءِ رواعفُ",88,"ف",1,0],["كَأَنَّ أَبا المِغوارِ لَم يوفِ مَرقباً","إِذا ما رَبا القَومَ الغُزاةَ رَقيبُ",89,"ب",1,0],["كَأَنَّ أَبا المِغوارِ ذا المَجدِ لم تجب","بِهِ البيدَ عيسٌ بِالفَلاةِ جَيوبُ",89,"ب",1,0],["كانَ أَبي يَملكها بِالوَضع","وَالآن آلت لي بِإِرثٍ شَرعي",90,"ي",1,0],["كانَ أَبو زَيد مَع الزناتي","مُستَغرِقاً في أَقبَح اللَذاتِ",91,"ت",1,0],["كأنَّ أبا الحُبابِ الى نفيلٍ","حمارٌ عَضَّهُ فَرَسٌ عَذومُ",92,"م",1,0],["كأن أبطاله اسود","تحمل غلبا من الصعادِ",93,"د",1,0],["كَأَنَّ أَبا العَبّاس لَم يَلقَ ضِيفَه","بِبَشَرٍ وَلَم يَرحَل بِجَدواهُ راحِل",