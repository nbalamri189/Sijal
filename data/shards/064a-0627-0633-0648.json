{"poems":[[55,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[75,"يا سؤل نفسي إن أحكم","https://www.aldiwan.net/poem11872.html","مجزوء الكامل"],[95,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[53,"أغصان بان تحتهن وعاث","https://www.aldiwan.net/poem9230.html","الكامل"],[53,"يا ابن أبي الجهم احتقب هذا اللطف","https://www.aldiwan.net/poem65467.html","الرجز"],[53,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[53,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[87,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[87,"سكن الزمان ولانت الأقدار","https://www.aldiwan.net/poem62969.html","الكامل"],[87,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[47,"إن تك عكل في هاشم أخر","https://www.aldiwan.net/poem11427.html","المنسرح"],[47,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[47,"يا سوءتا من طلابي يا أبا الحسن","https://www.aldiwan.net/poem66679.html","البسيط"],[107,"ما لي دعوت فلم أجد","https://www.aldiwan.net/poem42138.html","مجزوء الكامل"],[107,"هي الدراري فأين المطمح العالي","https://www.aldiwan.net/poem43059.html","البسيط"],[107,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[50,"اصبر لمر حوادث الدهر","https://www.aldiwan.net/poem63402.html","الكامل"],[52,"يا سوأة يكثر الشيطان إن ذكرت","https://www.aldiwan.net/poem24513.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[108,"عصبة الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=179423",""],[112,"قطعة الحلوى","https://www.poetsgate.com/ViewPoem.aspx?id=8390",""],[47,"يا سَوءتَا مِنْ رَأيكَ العازِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31568",""],[87,"أَمِنَ البحرِ صائغٌ عَبْقَرِيٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9659&r=&rc=149",""],[124,"أهواك والحب داء أيما داء","https://www.aldiwan.net/poem49314.html","البسيط"],[132,"يا بتعة فاقت ببهجتها","https://www.aldiwan.net/poem50579.html","مجزوء الكامل"],[151,"يا سواد العين يا روح الجسد","https://www.aldiwan.net/poem47646.html","الرمل"],[168,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[173,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[261,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[438,"هل من رفيق رفيق","https://www.aldiwan.net/poem12680.html","المجتث"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77548","الرجز"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47507","السريع"],[1401,"","https://poetry.dctabudhabi.ae/diwan/poem/205798","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128081","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28515","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83232","البسيط"],[2778,"","https://poetry.dctabudhabi.ae/diwan/poem/130324","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204637","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97875","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89201","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206169","البسيط"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67785","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4750,"يآسوريآ عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=180444",""],[4755,"لا شَأنَ لِي","https://www.poetsgate.com/ViewPoem.aspx?id=204158",""],[4888,"فُجْرُ السياسة","https://www.poetsgate.com/ViewPoem.aspx?id=207758",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[5121,"دُرَّةُ الوَفَاء / أختي إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=49549",""],[5401,"سوار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=142367",""],[5465,"يا سوأة للقوم لا كفوا ولا","https://www.poetsgate.com/ViewPoem.aspx?id=98431",""],[5525,"يا سواد العين","https://www.poetsgate.com/ViewPoem.aspx?id=7274",""],[5525,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=847",""],[5848,"يادلعها","https://www.poetsgate.com/ViewPoem.aspx?id=48987",""],[5906,"عَدالة","https://www.poetsgate.com/ViewPoem.aspx?id=188215",""],[5956,"فَرْقُ العمر فرّقنا","https://www.poetsgate.com/ViewPoem.aspx?id=182148",""],[6019,"تهجدٌ في محرابِ جراحاتِك","https://www.poetsgate.com/ViewPoem.aspx?id=151596",""],[6075,"لَا تُخْفِ دَمْعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=201606",""]],"verses":[["يَأَسو وَيَجرَحُ فَالجِراحَةُ عَزمَةٌ","تُصمى وَآسيها النَدى وَالجودُ",0,"د",1,0],["يا سُؤلَ نَفسي إِن أُحَكَّم","وَاختِياري إِن أُخَيَّر",1,"ر",1,1],["يَا سُوءَ دَهْرٍ قَضَتْهُ قَبْلَ نَهْضَتِهَا","مِصْرٌ يُخَيِّمُ فِيهَا الذُّلُّ تَخْيِيمَا",2,"م",2,0],["يَأْسُو وَقَدْ يَقْسُو فَإنْ يَكُ ظَالِماً","فَالدَّاءُ عَنْ ثِقَةٍ هُوَ المَظْلُومُ",3,"م",1,0],["يا سواد العراق بيّضك الده","ر فأشبهت مقلتي يعقوبا",4,"ب",2,0],["يا سوأةً أبداً تُواري سوأة","حتى يواري شخصكَ الأجداث",5,"ث",1,0],["يا سوء كيل وغلاء وحشف","يا نوبة الفقر ويا سنَّ الخرف",6,"ف",1,0],["يا سوءتا للأرض كيف تماسكَتْ","وقد استُزيلَ وحقُّها الزلزالُ",7,"ل",1,0],["يأسُو ويَكْلِمُ غيرَ مَذْ","مومِ الإساءةِ والكُلوم",8,"م",1,0],["يا سِوارَي فَيروزَجٍ وَلُجَينٍ","بِهِما حُلِّيَت مَعاصِمُ مِصرا",9,"ر",2,0],["يا سوءَ سُنَّتِهِم وَقُبحَ غُلُوِّهِم","إِنَّ العَقائِدَ بِالغُلُوِّ تُضارُ",10,"ر",1,0],["يَأسو جِراحَ اليائِسينَ مِنَ الوَرى","وَيُساعِدُ الأَنفاسَ في الأَرماقِ",11,"ق",1,0],["يا سَوءَتا مِن طِلابِ نائِلِهِم","وَمَدحِ رَغثانَ أَزغَبَ الرَقَبَه",12,"ب",2,0],["يَأسو الجِراحَةَ مِن قَومٍ وَقَد دَمِيَت","مِنهُم غَواشِمُ أَنيابٍ وَأَظفارِ",13,"ر",1,0],["يا سَوءَتا مِن طِلابي يا أَبا الحَسَنِ","أَخلَيتُ ظَهري لَهُ مِن مُثقَلِ المِنَنِ",14,"ن",1,1],["يا سُوءَ مُنقلَبِ الرّئي","سِ وحِزبِه الفَرحِ الطّروبْ",15,"ب",1,0],["يا سوءَ ما شَرِبَ الأَقوامُ مِن دَمِها","وَبِئسَ ما طَعِموا مِن عَظمِها البالي",16,"ل",2,0],["يا سوءَ ما حَمَلَ البَريدُ وَيا لَها","مِن نَكبَةٍ تَدَعُ النُفوسَ شَعاعا",17,"ع",2,1],["يا سوءَ ما قَرَؤُوا مِنْ كلِّ مُخْزِيَةٍ","عَلَى جَنَازَتِهِ جَهْرَاً وما هَجَرُوا",18,"ر",3,0],["يا سَوأَتا مِمّا اِكتَسَبتُ وَيا","أَسَفي عَلى ما فاتَ مِن عُمري",19,"ر",2,0],["يا سَوأَةً يُكثِرُ الشَيطانُ إِن ذُكِرَت","مِنها التَعَجُّبَ جاءَت مِن سُلَيمانا",20,"ن",2,1],["يا سَوَادَ العُيُونِ يا حَبَّةَ القَلْبِ","ويا خَالَ كُلِّ خَوْدٍ كَعَابِ",21,"ب",1,0],["يا سودُ، ما أنتم من الأنام","يا جيرةَ الهضاب والآكام",22,"م",1,0],["يا سؤالن..؟ من قبل. يسئل.؟ يجاب..","يعكس. أسلوم .. الردود... بجيم..؟ سين",23,"ن",1,0],["يا سَوءتَا مِنْ رَأيكَ العازِبِ،","وَعَقْلِكَ المُستَهْتَرِ الذّاهِبِ",24,"ب",1,1],["يا سواريْ فيروزجٍ ولجينٍ","بها حليتْ معاصمُ مصرا",25,"ر",2,0],["يا سوء منقلب عن حسن مختبر","كالصبح يعقبه إدجان ظلماء",26,"ا",2,0],["يا سوقَ أهل العدل لس","تُ على نواكِ بمُسْتطَاعِ",27,"ع",1,0],["يا سوادَ العين يا روح الجسد","يا ربيع القلب يا نعم السند",28,"د",1,1],["يا سُوَيدَ بنَ سراةٍ تَرَقَّب","ضَربَةً تَجتَثُّ مِنكَ الصَليفا",29,"ف",2,0],["يا سُوءَ حَظِّ بَني نِزارٍ بَعدَهُ","وَشَقاءَ حاضِرها وَشُؤمَ بُداتِها",30,"ت",3,0],["يا سوء عاقبة التعق","د تمشية الأمور",31,"ر",1,0],["يأسو بعذبٍ رقيقِ","جراح عَضْبِ رقيقِ",32,"ق",1,0],["يا سوء ما سُمِّيتِ هَذا الاسما","قَد وَسموا بِهِ الطُفَيل وَسما",33,"م",2,0],["ياسو اليبوس بما يرَطّبُ يبسه","ويدير التأثير باستحسان",34,"ن",1,0],["يا سوءَ حظ اليمن المحلال","وشؤمَها إن انبرت للفال",35,"ل",1,0],["يا سُوءَ ما جاءَتْ بِهِ الْحالُ","إِنْ كانَ ما قالُوا كما قالُوا",36,"ل",3,1],["يا سواد الفؤاد بنت أثال","طال ليلى بفتنة الرجال",37,"ل",1,1],["يا سوء حظى ياشماتة عذلى","ان كان عذرى سيدى لم يقبل",38,"ل",1,0],["يا سَوادَ الهُموم صِرتَ عَلى الأَي","يامِ لَمّا ضاقَت عَلَيكَ الصُّدورُ",39,"ر",1,0],["يأسو الجِراحَ بِأَخلاقٍ وَطائِلَةٍ","هِيَ المراهِمُ فيها البُرءُ مِن ضَرَرِ",40,"ر",1,0],["يا سوأتا لفتى له أدب","يضحي هواه قاهراً أدبه",41,"ب",2,1],["يا سوريا ما أنت غير خريدة","قد كثر العشاق فيك جمال",42,"ل",1,1],["يا سوء ما قدمته","والنفس مني غافله",43,"ل",2,0],["يا سورة النور البهي وصورةً","نشأت هيولاها من التقديس",44,"س",1,0],["يا سوء ما أبقتَ الدنيا لمُغتبط","على المدامع أجفان المساكين",45,"ن",1,0],["يَا سَوْءَةَ الْقَوْم إنْ تُسْبَى نِسَاؤُهُمْ","وَهُمْ كَثِيرٌ يَرَوْنَ الْخِزْيَ وَالحَرَبا",46,"ب",2,0],["يَأسُو بآلافِ النضارِ كَلمنا","مَن يَحسِبُ القِنطارَ مِنهُ كالمَنا",47,"ا",1,0],["يآسوريآ عذراً ترى المعتصم مآت","وأهل الشھآمة كلھم ميتينآ",48,"ن",2,1],["يآ سوريآ لوذي برب السماوات","الناصر البر المعزّ المعينآ",48,"ن",2,0],["يآسوريآ عذراً ترى المعتصم مآت","ثوري وغير الله لا ترتجينا",48,"ن",2,0],["يا سُورَةَ الشُّعَرَاءِ إِنَّ قَضِيَّتِي","مَرفُوعَةٌ في التِّينِ والزَّيتُونِ",49,"ن",1,0],["يا سَوطَ مصرَ بأي عذر يرتقي","نفرٌ من الأخيارِ من أجلِ السيادة",50,"د",2,0],["يا سَوطَ مصرَ فداكَ جُرحي إن أَرَد","تَ فلا تَخَفْ لعناتِ قلبي أو سوادَه",50,"د",2,0],["يأسو وأجراحُ الزمان دفينةٌ","كسرائرٍ في قلبه لا تنشرُ",51,"ر",1,0],["يا سوء حرب أثارت نار ثورتها","عصابةٌ دينها مالٌ كما قالوا",52,"ل",3,0],["يَا سَوْسَنَ الْبُسْتَانِ يَا بَلَسَانَهُ","جُودَا جِنَاناً وَانْثُرَا بَسْمَاتِهَا",53,"ت",3,0],["ياسوار الليل في معصم سباتي","السهاد الي فرضته فات حينه",54,"ن",2,0],["يا سوأة للقوم لا كفوا ولا","إذ حاربوا كانوا من الأحرار",55,"ر",1,1],["ياسواد العين .. ف عيوني سواد","النظر دخان .. وأنفاسي لهب",56,"ب",1,1],["يا سودة أبها .. خاشري كل شعاق","كبد السما لا شك لدي لي بموق",57,"ق",1,0],["ياسوالفها متى ما طار بي شوقي وجيت","شفت نفسي مالكٍ كل المباني والقصور",58,"ر",1,0],["يا سوط أمَّتِنا الرَّجيم تأدبي","أو تَفصِحي من ذا الذي عَصّاك",59,"ك",1,0],["يا سوءَ أعراف هذا الدهر أجمعِها","ما من تقاليده عقلي بمقتنعِ",60,"ع",1,0],["يا سورةَ اللهِ في قُرآنِ مَنهَجِهِ","ليسَ لها غيرُ هذا النَّزفِ تأويلُ",61,"ل",1,0],["يَا سَوْسَنَ اللُّقْيَا أَلَا","تُهْدِي غَرِيبًا مَوْطِنَا",62,"ن",2,0]]}