wan/poem/198356","الوافر"],[3482,"","https://poetry.dctabudhabi.ae/diwan/poem/140167","الوافر"],[3509,"","https://poetry.dctabudhabi.ae/diwan/poem/124131","البسيط"],[3538,"","https://poetry.dctabudhabi.ae/diwan/poem/204139","الطويل"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116854","الوافر"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45241","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109979","البسيط"],[3687,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18730","الطويل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18765","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59458","الوافر"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2523","الوافر"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88568","الوافر"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88540","الوافر"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88594","الوافر"],[3945,"","https://poetry.dctabudhabi.ae/diwan/poem/130531","الكامل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32449","الوافر"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[3982,"","https://poetry.dctabudhabi.ae/diwan/poem/18403","الطويل"],[3982,"","https://poetry.dctabudhabi.ae/diwan/poem/18400","الطويل"],[4000,"","https://poetry.dctabudhabi.ae/diwan/poem/97822","الوافر"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69291","الطويل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69283","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119632","الوافر"],[4191,"","https://poetry.dctabudhabi.ae/diwan/poem/22603","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94787","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94515","الوافر"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29457","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83132","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18807","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58155","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58093","الطويل"],[4487,"","https://poetry.dctabudhabi.ae/diwan/poem/18782","الطويل"],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145387","الطويل"],[4912,"ألا ليت شعري والتمني خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=181781",""],[2365,"رماك الدّهر بالخطب الجليل","https://www.poetsgate.com/ViewPoem.aspx?id=200653",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5308,"الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=215218",""],[6031,"خَلِيلَيَّ مِنْ علْيَا لُؤيِّ بنِ غَالِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=46401",""],[6031,"بِرغمِ العَوَالِي والمُهَنَّدَةِ البُتْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=46342",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[4478,"ألا أبلغا أهل المخاضة ِ أنّني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59438&r=&rc=12",""]],"verses":[["أَلّا أَبَيتَ وَأَنتَ مِن جَمراتِها","وَمِنَ العَجائِبِ جَمرَةٌ لا تَلفَحُ",0,"ح",1,0],["أَلا أَبلِغا عَنّي المُوَفَّقَ قَولَةً","وَظَنِّيَ أَنَّ الطولَ مِنهُ جَوابُها",1,"ب",3,0],["أَلا أَبلِغ بَني العُشَراءِ عَنّي","عَلانِيَةً فَقَد ذَهَبَ السِرارُ",2,"ر",1,0],["أَلا أَبلِغ أَبا بَحرٍ خَليلي","فَنِعمَ أَخو المَوَدَّةِ وَالخَليلُ",3,"ل",1,1],["أَلا أَبلِغا عَنّي زِياداً رِسالَةً","فَقَد يُبلِغُ الحاجَ الرَسولُ المُغَلغِلُ",4,"ل",1,1],["أَلا أَبلِغ مُعاوِيَةَ بِن حَربٍ","فَلا قَرَّت عيونُ الشامِتينا",5,"ن",2,1],["أَلا أَبلِغا عَنّي حُصَيناً رِسالَةً","فَإِنَّكَ مَردودٌ عَليك خلالُكا",6,"ك",2,1],["أَلا اَبلِغا عَنّي حُصَيناً رِسالَةً","فَإِنَّكَ قَد قَطَّعتَ أُخرى خِلالِكا",7,"ك",2,1],["أَلا أَبلِغا عَنّي زياداً مآلِكاً","رَسولاً إِلَيهِ حَيثُ ما كانَ مِن أَرضِ",8,"ض",1,1],["أَلا أَبلِغا عَنّي حُرَيثاً رِسالَةً","فَإِنَّكَ عَن قَصدِ المَحَجَّةِ أَنكَبُ",9,"ب",1,0],["أَلا أَبلِغا عَنَي بُجَيراً رِسالَةً","فَهَل لَكَ فيما قُلتَ بِالخَيفِ هَل لَكا",10,"ك",2,1],["أَلا أَبلِغا هذا المُعَرِّضِ أَنَّهُ","أَيَقظانَ قالَ القَولَ إِذ قالَ أَم حَلَم",11,"م",1,0],["أَلا أَبلِغا عَنّي سُلَيماً وَرَبَّهُ","فَزيدا عَلَيَّ مِئرَةً وَتَغَضُّبا",12,"ب",2,1],["أَلا أَبلِغِ النُعمانَ عَنّي رِسالَةً","فَمَجدُكَ حَولِيٌّ وَلُؤمُكَ قارِحُ",13,"ح",1,1],["أَلا أَبلِغ بَني جُشَمَ بنِ بَكرٍ","وَتَغلِبَ كُلَّها نَبَأً جُلالا",14,"ل",2,0],["أَلا أَبلِغ بَني الطَمّاحِ عَنّ","وَدُعمِيّاً فَكَيفَ وَجَدتُمونا",15,"ن",2,0],["أَلا أَبلِغا عَنّي سُلَيماً وَعامِراً","وَمَن كانَ مِن عُليا هَوازِنَ شاهِدا",16,"د",2,0],["أَلا اِبكي عَلى صَخرٍ وَصَخرٌ ثِمالُنا","إِذا الحَربُ هَرَّت وَاِستَمَرَّ مَريرُها",17,"ر",3,1],["أَلا اَبلِغ سُلَيماً وَأَشياعَها","بِأَنّا فَضَلنا بِرَأسِ الهُمامِ",18,"م",1,1],["أَلا أَبلِغا عَنّي الإِمامَ رِسالَةً","رِسالَةَ ناءٍ عَن جَنابَيهِ شاحِطِ",19,"ط",1,1],["أَلا أَبلِغِ الفِتيانَ عَنّي رِسالَةً","أَهينوا المَطايا هُنَّ أَهلُ هَوانِ",20,"ن",1,1],["أَلا أَبلِغ بَني أَسَدٍ رَسول","وَما بي أَن أَزُنَّكُمُ بِغَدرِ",21,"ر",1,1],["أَلا أَبلِغا وَهمَ بنَ عَمروٍ رِسالَةً","فَإِنَّكَ أَنتَ المَرءُ بِالخَيرِ أَجدَرُ",22,"ر",1,1],["ألا أبلغ جماعة أهل مرو","على ما كان من ناءٍ وبُعدِ",23,"د",1,1],["ألاَ أَبلغ ذَوِي يَمَن رَسُولا","فَإِيَّاكُم وَعُرَّةَ مُجرِبِينَا",24,"ن",2,0],["أَلا أَبلِغ سَراةَ بَني كِلابٍ","إِذا نَدَبَت نَوادِبُهُم صَباحا",25,"ح",2,1],["أَلا أَبلِغ أَبا سُفيانَ عَنّي","فَأَنتَ مُجَوَّفٌ نَخِبٌ هَواءُ",26,"ا",2,0],["أَلا أَبلِغِ المُستَمِعينَ لِوَقعَةٍ","تَخِفُّ لَها شُمطُ النِساءِ القَواعِدُ",27,"د",1,1],["أَلا أَبلِغ أَبا مَخزومَ عَنّي","وَبَعضُ القَولِ لَيسَ بِذي حَويلِ",28,"ل",1,1],["أَلا أَبلِغِ الضَحّاكَ أَنَّ عُروقَهُ","أَعيَت عَلى الإِسلامِ أَن تَتَمَجَّدا",29,"د",2,1],["أَلا أَبلِغ أَبا قَيسٍ رَسولاً","إِذا أَلقى لَها سَمعاً تُبينُ",30,"ن",1,1],["أَلا أَبلِغ بَني الدِيانِ عَنّي","مُغَلغَلَةً وَرَهطَ بَني قَنانِ",31,"ن",1,1],["أَلا أَبلِغا عَنّي أُسَيداً رِسالَةً","فَخالُكَ عَبدٌ بِالشَرابِ مُجَرَّبُ",32,"ب",1,1],["أَلا أَبلِغ خُزاعِيّاً رَسولاً","فَإِنَّ الغَدرَ يَنقُضُهُ الوَلاءُ",33,"ا",2,1],["أَلا أَبلِغ أَبا سُفيانَ عَنّي","فَإِنَّ اللُؤمَ مَعدِنُهُ حَراكا",34,"ك",2,1],["أَلا أَبلِغ أَبا هِدمٍ رَسولاً","مُغَلغَلَةً تَخُبُّ بِها المَطِيُّ",35,"ي",1,1],["أَلا أُبلِغ أَحِبّائي بَأَنّي","رَكِبتُ البَحرَ وَاِنكَسَر السَفينَه",36,"ه",1,1],["ألا اَبْلغْ لديكَ بني طاهرٍ","أُساةَ الخلافةِ من دائِها",37,"ه",2,1],["إلّا أبا الصقر الذي","أضحى وطالبُهُ حسيرُ",38,"ر",1,0],["ألا أبلغا عني العلاء بن صاعدٍ","رسالة ذي نفسٍ قليلٍ هلوعها",39,"ع",3,0],["إلا أبوك قُصرةً وقد هلكْ","يا ابن البغايا والفراشِ المشتركْ",40,"ك",1,0],["أَلا أَبلِغ بَني شَيبانَ عَنّي","فَما بَيني وَبَينَكُمُ ذُخولُ",41,"ل",1,0],["أَلا أَبلِغ أَبا الدَلماءِ عَنّي","بِأَنَّ عِجانَ شاعِرِكُم قَصيرُ",42,"ر",1,1],["أَلا أَبلِغ أَبا إِسحاقَ تُبلِغ","فَتى الإِحسانِ وَالشِيَمِ الحِسانِ",43,"ن",1,0],["أَلا أَبلِغ لَدَيكَ بَني فُقَيمٍ","ثَلاثَةَ آنُفٍ مِنهُم دَوامِ",44,"م",1,1],["أَلا أَبلِغ لَدَيكَ بَني سُبَيعٍ","وَأَيّامُ النَوائِبِ قَد تَدورُ",45,"ر",1,1],["أَلا أَبلِغ لَدَيكَ بَني تَميمٍ","وَقَد يَأتيكَ بِالخَبَرِ الظَنونُ",46,"ن",1,1],["أَلا أَبلِغ بَني بَكرٍ","رِجالاً مِن بَني ذُهلِ",47,"ل",1,0],["ألا أَبلِغ دَعِيَّ بَني حَرامٍ","قَواضي مَنطِقٍ بَعدَ اِعتِسافِ",48,"ف",1,0],["أَلا أَبلِغ بَني فَهمِ بنِ عَمروٍ","عَلى طولِ التَنائي وَالمَقالَه",49,"ل",2,1],["أَلا أَبلِغا سَعدَ اِبنَ لَيثٍ وَجُندُعا","وَكَلباً أَنيبوا المَنَّ غَيرَ المُكَدَّلِ",50,"ل",1,0],["أَلا أَبلِغ بَني عَوفِ بنِ كَعبِ","وَهَل قَومٌ عَلى خُلُقٍ سَواءُ",51,"ا",2,1],["إِلّا أَبا الحُسَينِ أَعني قاسِما","أَحضَرَ خَلقِ اللَهِ رَأياً حازِما",52,"م",2,0],["إلَّا أبو العبَّاسِ أَوْحَدُ عَصْرِهِ","أكْرِمْ به فِي عَصرِهِ مِنْ أَوْحَدِ",53,"د",1,0],["أَلا أَبلِغ لَدَيكَ أَبا حُرَيثٍ","وَعاقِبَةُ المَلامَةِ لِلمُليمِ",54,"م",1,1],["أَلا أَبلِغا ذُبيانَ عَنّي رِسالَةٍ","فَقَد أَصبَحَت عَن مَنهَجِ الحَقِّ جائِرَه",55,"ر",2,1],["أَلا أَبلِغا عَبدَ الضَلالِ رِسالَةً","وَقَد يُبلِغُ الأَنباءَ عَنكَ رَسولُ",56,"ل",1,0],["أَلا أَبلِغ بَني خَلَفٍ رَسُولاً","أحَقّاً أَنَّ أَخطَلَكُم هَجاني",57,"ن",2,0],["أَلا أَبلِغ بَني شَيبان عَني","فَقَد حَلَبَت صُرامُ لَكُم صَراها",58,"ا",3,0],["أَلا أَبلِغا عَوفاً وَصاحِبَ رَحلِهِ","ومَن يَغوِ لا يَعدَم عَلى الغيِّ لا حيا",59,"ي",2,0],["أَلا أَبلِغ بَني الطَمّاحِ عَنّا","وَدُعمِيّاً فَكَيفَ وَجَدتُمونا",60,"ن",2,0],["أَلاَ أَبْلِغِ الشَّيْخَ الرَّئِيسَ وَصَحْبَهُ","تهَانِيءَ تنْفِي الريْبَ مِنْ حَيْثُ تصْدُرُ",61,"ر",1,0],["أَلاَ ابْلِغْ قُرَيْشاً على نَآيِهَا","اتفخَرُ مِنَّا بما لَمْ تَلِي",62,"ل",2,1],["ألا أَبْلِغَا فِهْراً على نَأْيِ دَارِهَا","وعِنْدَهُمُ من عِلْمِنَا اليومَ مَصْدقُ",63,"ق",1,1],["ألا أَبْلِغْ قُرَيشاً أَنَّ سَلْعاً","وما بينَ العُرَيْضِ إلى الصِّمادِ",64,"د",1,1],["أَلا أَبلِغ بَني أَسَدٍ رَسولاً","وَما بي أَن أَزُنَّكُمُ بِغَدرِ",65,"ر",1,1],["ألا أبلغَ بني عوف بن كعبٍ","فهل قومٌ على خلقٍ سواءُ",66,"ا",2,1],["ألاَ أبْلِغَا سَعْدَ بنِ لَيْثٍ وَجُنْدُعَاً","وَكَلْبَاً أَنِيبُوا الْمَنَّ غَيْرَ المُكَدَّلِ",67,"ل",1,1],["ألا أبلغ بني الطماح عنا","ودُعمياً فكيف وجد يموُنا",68,"ن",2,0],["أَلاَ أَبْلِغِ الأَحْلاَفَ عَنِّى رِسَالَةً","وَذُبْيَانَ هَلْ أَقْسَمْتُمُ كُلَّ مُقْسَمِ",69,"م",1,0],["أَلا أَبلِغ وُشاةَ الناسِ أَنّي","أَكونُ لَهُم عَلى نَفسي دَليلا",70,"ل",2,0],["ألاَ أبلِغ مُحمداً الإِمَامَا","ولا تَعبَأ بِحَاسِدِهِ السَّلاَمَا",71,"م",2,1],["أَلا أَبلِغا عَنّي عَلى ذاتِ بَينِنا","لُؤَيّاً وَخُصّا مِن لُؤَيٍّ بَني كَعبِ",72,"ب",1,1],["أَلا أَبلِغ قُرَيشاً حَيثُ حَلَّت","وَكُلُّ سَرائِرٍ مِنها غُرورُ",73,"ر",1,1],["أَلا أَبلِغا عَنّي لُؤَيّاً رِسالَةً","بِحَقٍّ وَما تُغني رِسالَةُ مُرسِلِ",74,"ل",1,1],["أَلا أَبلِغ أَبا عُثما","نَ عِذرَةَ مُعتِبٍ أَسِفا",75,"ف",2,1],["ألا ابلغا عنّى الذي شكره","صريرُ رحِل الراكب المُوضعِ",76,"ع",1,0],["ألا أبلغ النعمان عني رسالة","فكيف بخطاب الخطوب الأعاظم",77,"م",1,1],["إلا أبا عامرٍ لم يَحْوِ خاطرُه","مذْ كان لفظا ولا معنى فينساه",78,"ا",2,0],["ألا أبقوا الحجابَ على الغواني","قد اشتبهَ الحمائمُ والصقورُ",79,"ر",1,0],["أَلا أَبلِغا عَنّي اِبنَ جِذلٍ","فَكَيفَ طَلَبناكُم بِكُرزٍ وَمالِكِ",80,"ك",1,1],["أَلا أَبلِغا عَمراً عَلى نَأيِ دارِهِ","فَقَد قُلتَ قَولاً جائِراً غَيرَ مُهتَدِ",81,"د",1,1],["ألا أبلغا عنّي أبا المجدِ والعُلا","سلاماً فلا يُحْصَ بوزنٍ ولا عدِّ",82,"د",1,1],["ألا أبلغا عني هلاكاً وما جِداً","هما الباذخانِ الزاكيانِ الأماجدا",83,"د",2,0],["ألا أبلغ بني همدان عني","رسالة ماجد واري الزناد",84,"د",1,1],["أَلا أَبْلِغا القَصْرَيْن فالمَقسَ أنّني","إليهنّ مُذْ فارقتُهن كئيب",85,"ب",1,0],["أَلا أَبلِغ عِمادَ الدينِ عَنّي","وَقَبِّل عِندَ رُؤيَتِهِ التُرابا",86,"ب",2,1],["أَلا أَبلِغ بَني سَعدٍ رَسولاً","وَمَولاهُم فَقَد حُلِبَت صُرامُ",87,"م",1,0],["أَلا أَبلِغ بَني عُدَسِ بنِ زَيدٍ","بِما سَنّوا لِباقِيَةِ الخُتورِ",88,"ر",1,0],["أَلا أَبلِغ بَني لَأمٍ رَسولاً","فَبِئسَ مَحَلُّ راحِلَةِ الغَريبِ",89,"ب",1,0],["أَلا أَبلِغ لَدَيكَ بَني قُرَيمٍ","مُغَلغَلَةً يَجىءُ بِها الخَبيرُ",90,"ر",1,1],["أَلا أَبلِغ لَدَيكَ أَبا حُمَيسٍ","وَعاقِبَةُ المَلامَةِ لِلمُليمِ",91,"م",1,1],["ألا أبلغ لَدَيكَ أبَا دُلامَه","فَلَيسَ مِنَ الكِرامِ وَلا كَرَامَه",92,"م",2,1],["أَلا أَبْلِغْ مُلُوكِ الأَرْضِ أَنِّي","لَبِسْتُ الْعَيْشَ مَجْرُورَ الذُّيُولِ",93,"ل",1,0],["أَلا أَبلِغا أَسماءَ أَنَّ حَلِيلها","قَضى وَطَرا مِن رَوزَبِيِّ الأَعاجِمِ",94,"م",1,0],["أَلا أُبلِغ أُسيداً حيث سارَت وَيَمَّمَت","بِما لَقِيَت مِنّا جُموعُ الزَمازِمِ",95,"م",1,1],["أَلا أَبلِغ مُهَلهِلَ ما لَدَينا","فَأَدمُعُنا كَأَدمُعِهِ غِزارُ",96,"ر",1,1],["أَلا أَبْلِغا عنّي على نَأْيِ دارها","سُلَيْمَى سَلامي وانْظُرا ما تُعِيدان",97,"ن",1,0],["أَلا أَبلِغ لَدَيكَ أَبا عليٍّ","ثَنَاءً من أَخي ثِقَةٍ يَمَاني",98,"ي",1,1],["ألا أَبلغ أميرَ القومِ سعداً","فَقَد كَذَبَت أَلِيَّتُهُ وَجَارا",99,"ر",2,0],["ألا أبلِغنَّ ابْنَ الطُّفَيْلِ وبلِّغَنْ","حُميَدَ بن قيس والرسولُ أمينُ",100,"ن",1,1],["أَلا أبلِغ السلطان عَنِّي نَصيحَةٌ","يئشَيِّعُها وُدَّ ورأْيٌ مُحَنَّك",101,"ك",1,1],["إِلّا أَبو النَصر الَّذي أَنعامه","مُتواتِرٌ يَهمي كَصوب غَمامِ",102,"م",1,0],["ألا أبلِغَا عنّي أٌناساً صحبتُهمْ","فما حَفِظوا عهداً ولا رَاعَوُا الوُدّا",103,"د",2,1],["أَلاَ أبلِغ بَني العَجلاَنِ عَنّي","فَلاَ يُنبِيكَ بِالحَدَثانِ غَيرِي",104,"ر",2,1],["أَلاَ أَبلِغَا هِنداً سَلامِي وَإِن نَأَت","فَقَلبِي بِها مُذ شَطَّتِ الدَّارُ مُدنَفُ",105,"ف",1,1],["ألا أبلغ كمالَ الملك عنّي","وإن يك حيث يسمع أو يراني",106,"ن",2,0],["ألا أبلغْ ملوكَ الأرض أنَّا","على الزوراء في العيش الوفاقِ",107,"ق",1,0],["ألا أبلغ سُرَاقة يا ابن مال","فبئس مقالة الرَّجل الخطيبِ",108,"ب",1,1],["أَلا أَبلِغ سُهَيلاً أَنَّ","ني ما عِشتُ كافيكا",109,"ك",2,1],["أَلا أَبلِغا عَنّي يَزيدَ بنَ عامِرِ","بِأَنّا أُناسٌ لا نُضيعُ لنا ذَحلا",110,"ل",2,0],["إِلّا اِبنُ عجلانَ الَّذي تبلت","هند فَفاتَ بِنَفسِهِ كمدُه",111,"د",2,0],["ألا أبلغ بني شارٍ كلامي","ومن لم يلقهم فهو السعيدُ",112,"د",1,1],["أَلا أَبلِغا عَنّي قُرَيشاً أَلوكَةً","وَلا تَلبِسا فَالحَقُّ لا يَتَلَبَّسُ",113,"س",1,0],["أَلا أَبلِغا تَيمَ بنَ مُرَّةَ وَاِحسِنا","رِسالَةَ لا فَذٍّ وَلا مُتَوانِ",114,"ن",1,0],["أَلا أَبلِغِ الأَقوامَ عَنّي أَلِيَّةً","أَلِيَّةَ بَرٍّ صادِقٍ غَيرِ حانِثِ",115,"ث",1,0],["أَلا أَبلِغا سَعدَ بنَ لَيثٍ وَجُندُعاً","وَكَلباً أَثيبوا المَنَّ غَيرَ المُكَدَّرِ",116,"ر",1,1],["أَلاَ أَبْلِغْ أَبَا بَكْرِ","مَقَالاً مِنْ أَخٍ بَرِّ",117,"ر",1,1],["أَلا أَبلِغا أَفناءَ سَعدِ بنِ مالِكٍ","رِسالَةَ مَن قَد صارَ في الغُربِ جانِبُه",118,"ه",1,1],["ألا أبلغْ أبا كَرِبٍ رسولا","مُغَلْغَلَةً وليستْ بالمُزاحِ",119,"ح",1,1],["أَلا أَبلِغ أَبا إِسحاقَ أَنّي","رَأَيتُ البُلقَ دُهماً مُصمَتاتِ",120,"ت",1,1],["أَلا أَبلِغا عَنّي الأَصَمَّ رِسالَةً","فَإِنَّكَ وَاِبنَ القَرمِ مُختَلِفانِ",121,"ن",1,1],["ألا ابن الكريمين موسى الكريم","ألا السيِّدُ السيِّدُ المنتخب",122,"ب",1,0],["الاَّ ابتغاءَ أمان لن تفوز بها","لذاك تسكتُ حزناً وهي تحتدمُ",123,"م",1,0],["أَلا أَبلِغ أَبا بَكرٍ رَسولا","وَخُصَّ بِها جَميعَ المُلسلِمينا",124,"ن",2,1],["أَلا أَبلِغا عَنّي عَلِيّاً تَحِيَّةً","فَقَد قَبِلَ الصَمّاءَ لَمّا اِستَقَلَّتِ",125,"ت",1,1],["ألا أَبلِغ سَراةَ بني زهيرٍ","وحياً للأخاطِل والخزازِ",126,"ز",1,1],["أَلا أَبلَغ مُعاوِيَة بنَ حَربٍ","فَإِنَّكَ مِن أَخي ثِقَةٍ مُليمُ",127,"م",1,1],["ألا أبلغ خُزاعة أهل مُرّ","وإخوتهمْ كنانةَ عن إياد",128,"د",1,0],["ألا أبلغا الشيخ الأجل رسالةً","تنبئه أن الديار منازل",129,"ل",1,1],["ألا أبلغ بني سعدٍ رسولاً","ودونهم بسيطة فالمعاط",130,"ط",1,1],["ألا أبلغْ أبا بكْرٍ رسولاً","وأَبلغْها بني ناجِ بن سَعْدِ",131,"د",1,1],["ألاَ أَبلِغ أَبَا إسحَاقَ أَنّا","نَزَونَا نَزوَةً كَانَت عَلَينَا",132,"ن",2,1],["ألا أبلغ معاوية بن حرب","وكل الناس يعلم ما أقولُ",133,"ل",1,1],["أَلا أَبلِغ لَدَيكَ بَني سُلَيمٍ","وَعامِرَ وَالقَبائِلَ مِن كِلابِ",134,"ب",1,1],["أَلا أَبلِغا عَنّى قُصَيّاً رِسالَةً","فَأَنتُم سَنامُ المَجدِ مِن آلِ غالبِ",135,"ب",1,1],["أَلا أَبلِغا بُسرَ بِنَ سُفيانَ آَيَةً","يُبَلِّغُها عَنّى الخُبَيرُ المُفرَدُ",136,"د",1,1],["ألا أبلغا عني الربيع رسالة","ربيع بني عبد المدنِ الأكارمِ",137,"م",1,1],["ألا أبلغ ابا حَمَل رسولاً","فقد أَهديتَ فُطرك من بعيد",138,"د",1,1],["أَلا اِبنَ المُعَلّى خِلتَنا وَحَسِبتَنا","صَرارِيَّ نُعطي الماكِسينَ مُكوسا",139,"س",2,0],["ألا أبلغ لديك بني لؤي","على الشنآن والغضب المردي",140,"د",2,1],["أَلا أَبكي الوَليدَ فَتى قُرَيشٍ","وَأَسمَحَها إِذا عُدَّ السِماحُ",141,"ح",1,0],["أَلا أَبلِغا عَنّي فَضالَةَ أَنَّهُ","فَلا يَسمَعا قَولَ الوشاةِ يَخالَكا",142,"ك",2,1],["ألا أبك ونادي المؤرخ قل","لفقد أبي القاسم العرش مال",143,"ل",1,0],["ألا أبلغا شمس الكفاة وما أنا","بمتهم في وده بملوم",144,"م",1,1],["أَلا أَبلِغ بَني عَمرٍو رَسولاً","فَإِنّي في مَوَدَّتِكُم نَفيسُ",145,"س",1,1],["أَلا أَبْلِغا حَيَّىْ نِزارٍ ويَعْرُبٍ","بحيث حَوَتْها يَمْنَةٌ وشآمُ",146,"م",1,0],["أَلا أَبلِغ فَتاةَ بَني زُبَيدٍ","كُبَيشَةَ وَالحَديث لَهُ نَماءُ",147,"ا",2,1],["أَلا أَبلِغ بَني ظَفَرٍ رَسولاً","وَرَيبُ الدَهرِ يَحدُثُ كُلَّ حينِ",148,"ن",1,1],["أَلا أَبلِغا عَنّي الهُمامَ مُحَمَّداً","فَهَل مُبتَغي عُتباكَ راحَ لَيُعتَبا",149,"ب",2,0],["ألا أبلغا عني عراكَ بن مالكٍ","ولا تدَعا أن تثنيا بأبي بكرِ",150,"ر",1,1],["أَلا أَبلِغوا أَهرامَ مِصرَ تَوَجُّعي","وَإِن تَكُ لا تَرثي وَلا تَتَرَحَّمُ",151,"م",1,0],["ألا أبلغا عني عقيلا رسالة","فأنك من حرب علي كريم",152,"م",1,1],["ألا أبلغ همدان ما لقيتها","سلاما فلا يسلم عدو يعيبها",153,"ه",2,1],["ألا أَبْلِغْ بني لُبْنى رَسُولاً