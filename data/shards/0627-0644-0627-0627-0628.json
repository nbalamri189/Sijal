ي رَبيعٍ","فَأَشرارُ البَنين لكُم فِداءُ",180,"ا",2,1],["ألا أبلغ بني أسد رسولاً","فما أَرَ بي إلى شتم الكُمَيتِ",181,"ت",1,1],["ألا أبلغا عني على نأي داره","سعيداً أخا العلياء والفضل والفخر",182,"ر",1,1],["ألا أبلغ بني ذهل رسولاً","فلا شتماً أردت ولا فسادا",183,"د",2,1],["ألاَ أبْلِغْ بني أسَدٍ جميعًا","وهذا الحيَّ من غَطَفَانَ قِيلِي",184,"ل",2,1],["الا أباح له من حسن بهجته","ومن سجايا تجلت في معاليها",185,"ي",3,0],["ألا أبلغوا بشر بن عصمة أنني","شغلت وألهاني الذين أمارس",186,"س",1,1],["ألا أبلغ بني سَلمَى رسولاً","فلم يكُ عندنا مِنهم مُليمُ",187,"م",1,0],["أَلا أَبلِغا صَخراً فَإِنّيَ لَم أَكُن","لِأَقذِفَ صَخراً بِالنِفاقِ وَلا الكُفرِ",188,"ر",1,1],["الا ابنَ آدمَ مَن أَربَت قبائحُهُ","لم يأتِ إلا بأَوساخٍ وادناسِ",189,"س",1,0],["ألا أبلغ أنوشروان عني","مغلغلة فقد حق الوعيد",190,"د",1,0],["أَلا أَبلِغ الأَقياسَ قَيسَ بنَ نَوفَلٍ","وَقَيسَ بنَ أُهبانٍ وَقَيسَ بنَ صابِرِ",191,"ر",1,1],["أَلا أَبلِغ بَني الصَيداءَ عَنّي","عَلانِيَةً وَما يَغني السِرارُ",192,"ر",1,0],["ألا أبلغْ طُغاةَ القومِ أنَّي","وإن اْطرقْتُ حيَّةُ بطنِ وادِ",193,"د",1,0],["أَلا أَبلِغ عُوَيمِرَ عَن زِيادٍ","فَإِنَّ مَظِنَّةَ الجَهلِ الشَبابُ",194,"ب",1,1],["ألا أبلغ معاويةَ بن صخر","أميرَ المؤمنينَ نثا كلامي",195,"ي",1,1],["ألا أبلغ معاوية بن حرب","فقد أبلغتم الحنق الصدورا",196,"ر",2,1],["ألا أبلغ معاوية بن حرب","فقد ضاقت بما يأتي اليدان",197,"ن",1,1],["الا أبيك أخي المكارم وحده","والفيض مطلب أبي الأضياف",198,"ف",1,0],["أَلا اَبلِغ لَدَيكَ أَبا عُمَيرِ","أَراني اللَهُ في اِستِكَ نِصفَ أَيرِ",199,"ر",1,1],["أَلا أَبْلِغْ غُزَيِّلَ حَيْثُ أَضْحى","أَحَقّاً ما أُنَبَّأُ بالفَخارِ",200,"ر",1,0],["أَلا أَبلِغ بَني قَطَنٍ رَسولاً","كَلامَ أَخٍ يُعاتِبُ غَيرَ لاحِ",201,"ح",1,0],["أَلا أَبلِغا عَنّي العُرَيبَ رِسالَةً","فَقَد قَسَمَت فينا فُيوءَ الأَعاجِمِ",202,"م",1,1],["أَلا أَبلِغا عَنّي الخَليفَةَ أَنَّنا","غَلَبنا عَلى نِصفِ السَوادِ الأَكاسِرا",203,"ر",2,1],["أَلا أَبلغ بني بكرٍ رسولا","فَقَد جدّ النفيرُ بعنقفيرِ",204,"ر",1,1],["الا أَبلغ عُبيدَ اللَهِ عَنّي فإِنَّني","رَمَيتُ ابنَ عَوذٍ إِذ بَدَت لي مقاتِلُه",205,"ل",2,1],["أَلا أبلغ يَزيدَ بنَ الخَليفَةِ أَنَّني","لَقيتُ مِن الظُلمِ الأَغرَّ المحجَّلا",206,"ل",2,1],["إلا ابن الكرام وليس فخراً","ويا غوث الأنام ولا نزاعا",207,"ع",2,0],["أَلا أَبلِغ مُعاوِيَةَ بنَ حَربٍ","وَرَجمُ الغَيبِ يَكشِفهُ اليَقينُ",208,"ن",1,0],["ألا أبكي الصِبا في كلما هبَّتِ الصَبا","بلحن الصِبا إنّي على حال صبوةِ",209,"ه",1,0],["ألا أبكي صباها الدهر يا كل مقلةٍ","من الآل وليسقى الضريح قطورُ",210,"ر",1,0],["ألا أبكي أيا ديباج أعطاف بانةٍ","أبى أن يلافيك الزمانَ مُنيرُ",210,"ر",1,0],["أَلا أَبكي يا صروح الحيّ دَهراً","وسحّي عندما يزهو احمرارا",211,"ر",2,0],["ألا أَبلِغا عَنّي جُريحَةَ آيَةً","فَهَل أَنتَ عَن ظُلمِ العَشِيرَةِ مُقصِرُ",212,"ر",1,1],["أَلا أَبلغا شَوقي عَلى نَأيِ دارِهِ","مَقالا كَنَفحِ المِسكِ رَيّاه تُنشَرُ",213,"ر",1,0],["أَلا أَبلغا مُطران أَنّ بَيانَه","خَفيٌّ وَمَعناهُ عَن اللَفظِ أَكبَرُ",213,"ر",1,0],["أَلا أَبلغا العَقّادَ تَعقيدَ لَفظِهِ","وَمَعناهُ مثلُ النَبتِ ذاوٍ وَمُثمِرُ",213,"ر",1,0],["أَلا أَبلِغا أَهلَ المَخاضَةِ أَنَّني","مُقيمٌ بِزَورا آخِرَ الدَهرِ مُعتَمِر",214,"ر",1,1],["ألا أبك دماً مجرى الدموعِ ابن آدمَ","فحكم إلهي فهو ضربة لازمِ",215,"م",1,0],["أَلاَ أبلغْ شموسَ الدِّين منِّي رسالةً","بتوحيدِهم في الفضل إنيَ ناطقُ",216,"ق",1,1],["أَلا أَبلِغا الوركاءَ أَنَّ عَميدَها","رهينَةُ حَشرٍ مِن جيوشِ الزَعافِرِ",217,"ر",1,1],["ألا أبلغا عني الشّريق وأهله","بأني لا أثني عناناً عن الغرب",218,"ب",1,1],["ألا أبشر بما تحظى به حين تجتلي","محيا سديد الدولة الماجد الندب",219,"ب",1,0],["ألا ابك أخاك بالدّمع الهمول","لعلّ الدّمع يبرد من غليل",220,"ل",1,0],["ألا أبلغ الأحباب عني ملامة","ويا ليتهم لم يتركوني بمفردي",221,"د",2,0],["ألا أبْلِغِ الأقْوامَ تُحْفَةَ مُكْرِمِ","رَمَى الجُودَ والإِكرامَ في يَدِ مُعْدِمِ",222,"م",1,1],["ألاّ أبْلِغَا عَنِّي خميسَ بنَ نَاصرٍ","مقالَ امْرئٍ في وِدِّهِ غَيرِ كاذِبِ",223,"ب",1,0],["أَلاَ أبْلِغُوا الحَيين بَكْراً وتَغْلباً","فَمَا الغَوثُ إلاَّ عِندَ تَغْلبَ أو بَكْرِ",224,"ر",1,0],["إلاَّ ابْتِعاداً عن هوًى قاتِلٍ","يَرْمِي به ثَغْرٌ وطَرْفٌ كحِيلْ!",225,"ل",1,0],["ألا أبلغا أهل المخاضة ِ أنّني","مقيمٌ بزوار آخر الدّهر معتمرْ",226,"ر",1,1]]}