l","الكامل"],[517,"لك يبق نوع تقتضيه كرامة","https://www.aldiwan.net/poem12088.html","الكامل"],[553,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[553,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[564,"ذهب الحبيب فيا حشاشة ذوبي","https://www.aldiwan.net/poem52735.html","الكامل"],[564,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[569,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[588,"ما عهدنا كذا تكون الرفاق","https://www.aldiwan.net/poem17612.html","الخفيف"],[851,"","https://poetry.dctabudhabi.ae/diwan/poem/20704","الطويل"]],"verses":[["لِكَي تَعلَموا غِبَّ العَداوَةِ بَينَنا","وَيَعرُكَكُم كَيدُ المَطولِ المُماغِثِ",0,"ث",1,0],["لكَ يا عَليُّ مآثِرٌ في مِثلِها","حُسِدَ الفتى والفَضْلُ للمحسودِ",1,"د",1,0],["لكَ يا أميرَ المؤْمِنينَ تُراثُها","وبِهِ استَتَبَّ لَها إليكَ طَريقُ",2,"ق",1,0],["لِكَي أَعيشَ قَليلاً","يَقوتُني التَعليلُ",3,"ل",1,0],["لَكَ يَا أَصْدَقَ رَاوٍ","لَكَ يَا أَعْدَلَ قَاضِي",4,"ض",2,0],["لِكَيْ تَلُوحَ عَلَيْهِ مِنْ شَمَائِلِه","شَمَائلٌ مِنْ أبيهِ الطَّاهِرِ الشِّيَمِ",5,"م",1,0],["لَكَ يَا أَحْمَدُ بْنُ يُوسُفَ جُبْنَا","كُلَّ قَفْرٍ يُعْيِي أكُفَّ الرِّحَالِ",6,"ل",1,0],["لكَ يا فارِسَ الخُيولِ أُنادي","لكَ يا عَنْتَرَ الصُّفوفِ أُناجي",7,"ج",2,0],["لَكَ يَا أَمِيرَ الْمُسْلِمينَ فَعِمْ بِهَا","وَلِيَ الْهَنَاءُ عَلَى بِنَا أَبْيَاتِهَا",8,"ت",3,0],["لِكَي يَعلَمَ الناسُ أَنّي اِمرُؤٌ","أَتَيتُ المَعيشَةَ مِن بابِها",9,"ب",3,0],["لَكَ يَا يُوسُفُ العَزِيزُ مِثَالٌ","هُوَ رَمْزٌ لِلنُّبْلِ فِي كُلِّ عَينِ",10,"ن",1,1],["لِكِيرَللسِ المِفْضَالِ رَاعِي رُعَاتِنَا","مَنَاقِبُ أَعْلامِ الهُدَى وَأُولِي العَزْمِ",11,"م",1,1],["لك يا ظبية الصريمة طرف","شدّ ما أوسع القلوب غراما",12,"م",2,0],["لك يَبق غير الذي غُلَّت أنامله","إما بأغلال شُحّ أو بإقلال",13,"ل",1,0],["لِكَي ما يَكونَ السَندَرِيُّ نَديدَتي","وَأَجعَلَ أَقواماً عُموماً عَماعِما",14,"م",2,0],["لكَ يا أميرَ الحسن حكمٌ فاقْض بي","ما أنتَ في أهل المحبَّة قاض",15,"ض",1,0],["لك يا مليحة مقلةٌ مع حاجبٍ","للسهمِ عن قوس لقلبي يرشق",16,"ق",1,1],["لك يا نديمي في التألف خطوةً","فاعْهد لها إن أعوز الإمكان",17,"ن",1,1],["لكي نُرْوي نفوساً صادياتٍ","بقربٍ منك للصادي مُصيبِ",18,"ب",1,0],["لكي يُقضِّي أوطاراً مُذمَّمةً","من كل عَرْدٍ ترى في رأسه عُجرا",19,"ر",2,0],["لكي تقولي استمالتهُ بشاشتهُ","لأن مطلب ما بي داحض الغُدَر",20,"ر",1,0],["لكي يعلم النَّظَّام أن سَميَّه","يوافقه في قوله حين يَطفِر",21,"ر",1,0],["لكي لا يرى في وجه حُرٍّ مذلةً","على أنها من يُغض والوجه عابس",22,"س",1,0],["لك يوم من الندى ذو سماء","لم تزل ثرة الفروغ دفوقا",23,"ق",2,0],["لكي ينسلَّ في الليل","بلا علمِ المماليكِ",24,"ك",1,0],["لكيما يقولُ اللَّه والحقُّ والهوى","جميلٌ تقصّى فعلَ كلّ جميلِ",25,"ل",1,0],["لَكَ يا صَديقي بَغلَةٌ","لَيسَت تُساوي خَردَلَه",26,"ل",2,1],["لَكَيما يَقولُ الناسُ ماتَ وَلَم يَمِن","عَلَيكِ وَلَم تَنبَتَّ مِنكِ قُرونُ",27,"ن",1,0],["لك يا سعد من ضريحك مثوى","ثم في قلب كل فرد مقام",28,"م",1,0],["لك يا احمد الامامة في المو","ت كما كنت في الحياة اماما",29,"م",2,0],["لك يا حجة البلاغة شعر","عجزت عن تقليده الشعراء",30,"ا",2,0],["لك يا عشور مكارم","هن الغيوث المظمئه",31,"ا",2,1],["لك يا مرتضى خلال كزهر ال","روض لاقى في ظل آذار مزنا",32,"ن",2,0],["لَكِ يا مَنازِلُ في القُلوبِ مَنازِلُ","أَقفَرتِ أَنتِ وَهُنَّ مِنكِ أَواهِلُ",33,"ل",1,1],["لك يا ابن العصب","المحليّ عرض مستباح",34,"ح",1,1],["لَكَ يا رَبَّ العُيو","نِ القَواتِل",35,"ل",1,0],["لِكَي تُزانَ بِذِكراكُم مَدائِحُنا","فَعِندَما سَمَحَت فيكُم قَرائِحُنا",36,"ن",2,0],["لَكَ يا اِبنَ أُرتُقَ بِالمَكارِمِ نِسبَةٌ","فَلِذاكَ جودُكَ كَاِسمِ جَدِّكَ زائِدُ",37,"د",1,0],["لُكَيزٌ لَها البَحرانِ وَالسَيفُ كُلُّهُ","وَإِن يَأتِها بَأسٌ مِنَ الهِندِ كارِبُ",38,"ب",1,0],["لك يا مَن يموتُ شخصٌ وفَيْءٌ","ثمّ شخصٌ في القبر من غير فَيِّ",39,"ي",1,0],["لك يا ابن يحيى في علائك مُرْتَقى","لم تَرْقَهُ من أكبرٍ قدمانِ",40,"ن",1,0],["لَكَ يَدعو بِمَكَّةَ كُلُّ بَرٍّ","حَولَ بيتِ الإِلهِ ذي الأَستارِ",41,"ر",1,0],["لكَ يا صديقَ الصدقِ مني أنَّةٌ","لا تنقضي وكآبةٌ لا تقلِعُ",42,"ع",1,0],["لِكَي تَعلَمي عِلماً يَقيناً فَتَنظُري","أَيُسراً أُلاقي في طِلابِكِ أَم عُسرا",43,"ر",2,0],["لِكَي تُبتَلى لَيلى بِمِثلِ بَليَّتي","فَيُنصِفَني مِنها فَتَعلَمُ حالِيا",44,"ي",2,0],["لَكَ يا مُحمّدُ في المَفاخرِ رُتبةٌ","مَلكتْ عليَّ الوَصفَ والتِّبيانا",45,"ن",2,0],["لكَ يا محمدُ عند كلِّ موفّقٍ","عهدٌ يُعظِّمه وحقٌّ واجبُ",46,"ب",1,0],["لَكَ يا شهيدَ الحقِّ قَامَ المأتَمُ","وأَراهُ حَقّاً أن يُقامَ الموسِمُ",47,"م",1,1],["لَكِ يا مُنَوِّرَةَ البقاع تَحَيَّةٌ","مِن رائحٍ في نُورِ عِلْمِكِ غادِ",48,"د",1,0],["لك يومَ بدرٍ عند ربّكَ مَشهدٌ","هُوَ للهُدَى والحقِّ عُرسٌ مُمتِعُ",49,"ع",1,0],["لك يا سعدُ لديهِ ولها","من جزاءٍ غيرِ نَزْرٍ ما وعد",50,"د",1,0],["لِكَي تَعلَمي أَنّي أَشَدُّ صَبابَةً","وَأَحسَنُ عِندَ البَينِ مِن غَيرِنا عَهدا",51,"د",2,0],["لك يا نفس من رجائك بالأي","يام صرحٌ جداره متداعي",52,"ع",2,0],["لك يا عراق فلا تكن مستيئساً","بعد المنى مستقبل الأيام",53,"م",1,0],["لكِ يا شاهداتِ حبي أتيتُ الآ","ن أقضي حقَّ الوداعِ الأخيرِ",54,"ر",1,0],["لَكِ يا مَي أَنْ تَتِيهِي كَمَا شِئْتِ","وَلَكِنْ تَرَفَّعِي فِي الدَّلاَلِ",55,"ل",1,1],["لَكَ يَرجُو بِراّ وَعَدْلاً لِتَكْفَى","مَا شَكَتْهُ القُلُوبُ وَالأَحْدَاقُ",56,"ق",1,0],["لَك يَا عَلِيُّ مَآثِرٌ وَطَنِيةٌ","كثُرَتْ وَلكِنْ مِنْكَ لَمْ تُستَكْثرِ",57,"ر",1,0],["لك يَا حَفِيظَة خَالِداتُ مَفَاخِرٌ","تَمْضِي السنونُ وَذِكْرُهَا مُتَجَددُ",58,"د",1,1],["لِكَي أَفوزُ مَع اِبني حَيثُ بَوَّأَهُ","بِرَحمَةٍ مِنهُ أَرجوها وَإِنعامِ",59,"م",1,0],["لك يا ربِّ في الصيام وفي الفط","ر، معانٍ دقَّتْ عن الأفهام",60,"م",1,0],["لكَ، يا صاح، نصفُ أجرِ طوافي","ووقوفي، وإن أبَيْتَ اقتسامه",61,"م",2,0],["لكِ، يا جميلةُ، سِيرةٌ","مثلُ الزهور لها نُفاح",62,"ح",1,0],["لكي تلوح عليه في شمائله","شمائل من أبيه الطاهر الشيم",63,"م",1,0],["لك يا أميرَ المسلمينَ فعِمْ بها","ولي الهناءُ على بناءِ أبياتِها",64,"ت",3,0],["لكي لا تشم الريح أسرار فدفدٍ","ولا تمتطي ركض الرياح الفدافد",65,"د",1,0],["لكي يستعيد الشيخ حمدون جده","ويحيي -أباه في ابنه- الشيخ حامد",65,"د",1,0],["لكي يستهلّ الصبح . من آخر السّرى","يحن إلى الأسى ، ويعمى لكي يرى",66,"ر",2,1],["لكي لا يفيق الميتون ، ليظفروا","بموت جديد .. يبدع الصحو أغبرا",66,"ر",2,0],["لكي ينبت الأشجار يمتد تربة","لكي يصبح الأشجار والخصب والثرى",66,"ر",2,0],["لكي يستهلّ المستحيل كتابه","يمدّ له عينيه ، حبرا ودفترا",66,"ر",2,0],["لكي لا يعود القبر ميلاد ميت","لكي لا يوالي قيصر ، عهد قيصرا",66,"ر",2,0],["لك يا شاهدات حبي أتيتُ الآن","أفضي حقَّ الوداع الأخيرِ",67,"ر",1,0],["لكي ينعُمَ الساداتُ بالحكم ترتوي","بقاعٌ ظِماءٌ من دماءٍ طَواهر",68,"ر",1,0],["لكي تعلمي علماً يقيناً، فتنظري","أيسراً ألاقي من طلابكِ أن عسرا",69,"ر",2,0],["لكي جئت بلا سبب","ردّيني . لست المسؤوله",70,"ل",2,0],["لك يا ظبية َ الصريمة طرفٌ","شدَّ ما اوسع القلوبا غراما",71,"م",2,0],["لَكَ يَهدي نَسيمُها وَرُباها","نَفحات القُرنفل الريحان",72,"ن",1,0],["لك يا علي الأوليا","في القوم معراج على",73,"ل",2,1],["لك يا عين بني الدنيا يد","فعلت في الأرض حكماً والسما",74,"م",2,0],["لك يا ابن سيف سطوة لو صادمتْ","جبلا لأصبح كالكثيبِ السائلِ",75,"ل",1,0],["لك يومَ الهياجِ قلبٌ","يُزْرِى على الخافقيْن وُسْعَا",76,"ع",2,0],["لك يا رأس الخليج المنتهى","في البها إذ للهدي فيك ائتلاق",77,"ق",1,0],["لكي تعلمي أم البنين بأنه","فراقك نار واقترابك من خلد",78,"د",1,0],["لك يا أبا عبدالإله مناقبٌ","تُرضي إلاهك والنبي المرسلا",79,"ل",2,0],["لكيزِيَّةٌ أَنسابُها عامِريَّةٌ","يَلوذُ المُناوي ضَيمُها وَاِعتصابُها",80,"ب",3,0],["لُكَيزِيُّ المَناسِبِ عامِرِيٌّ","مَلِيكٌ لِلمُلُوكِ بِهِ اِعتِصامُ",81,"م",1,0],["لِكَيما يقالَ الشيخُ حرٌّ ضميرهٌ","فَيبلغَ عندَ القومِ مَرتبةً كُبرى",82,"ر",2,0],["لكَ يا بحرُ منكَ أهديتُ درّا","إِن أَنل في جوارِ قبركَ قَبرا",83,"ر",2,0],["لكِ يا طيبةٌ علَينا عهودُ","ذِكرُها في القلوب غضٌّ جديدُ",84,"د",1,1],["لكيمى أنت يا دار التنادى","إلى الهيجاء أو دار التصاري",85,"ي",1,0],["ل كيمى أنت من أيام نوح","توارثك ابنمٌ عن خير آب",85,"ب",1,0],["لِكَيْلا يرومونَ القِراع فيأتهم","كما انْقَضَّ نَجْمٌ للشياطينِ رَاجِمُ",86,"م",1,0],["لكي تقرأوها ثم يغشى سطورَها","سناكم ومعناها يرق ويَدْمَثُ",87,"ث",1,0],["لكي يظن الناس من جهلهم","بأنها أنفاس منتشقِ",88,"ق",1,0],