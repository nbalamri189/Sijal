ف","https://www.poetsgate.com/ViewPoem.aspx?id=161925",""],[3591,"تحكي الإمام اليازجيّ بطلعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=149438",""],[5122,"تّمر","https://www.poetsgate.com/ViewPoem.aspx?id=33179",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5213,"أبا محسن طال التباعد والهجر","https://www.poetsgate.com/ViewPoem.aspx?id=170470",""],[5277,"قطاةُ الكرخ","https://www.poetsgate.com/ViewPoem.aspx?id=187561",""],[5277,"أرملةُ التيجانِ..","https://www.poetsgate.com/ViewPoem.aspx?id=206362",""],[5280,"شآم","https://www.poetsgate.com/ViewPoem.aspx?id=187771",""],[307,"متى نعود أيا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=213657",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5444,"زيتونة المسرى","https://www.poetsgate.com/ViewPoem.aspx?id=205084",""],[2229,"أُعِيدُُها هيفا بربّ الفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=49795",""],[5582,"قِفا صاحِبَيْ نَبْكِ فَقَدْ وَجَبَ البُكا","https://www.poetsgate.com/ViewPoem.aspx?id=187215",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5690,"أن تعظم الأهوال حزمك أعظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=172183",""],[5691,"ليلاي...!","https://www.poetsgate.com/ViewPoem.aspx?id=206654",""],[5758,"خياط الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=214576",""],[5778,"الْمَالُ فِي يَدِهِ كَالْمَاءِ فِي يَدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=205155",""],[5851,"زنبقة من بقايا الصلصال","https://www.poetsgate.com/ViewPoem.aspx?id=175251",""],[5956,"من وحي دود القزّ","https://www.poetsgate.com/ViewPoem.aspx?id=182072",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[5977,"حديث العيون","https://www.poetsgate.com/ViewPoem.aspx?id=213265",""],[6117,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=182777",""],[6201,"لا منطقيون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87482&r=&rc=6",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6259,"هل الوجد الا أن تلوح خيامها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59401&r=&rc=49",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""]],"verses":[["تَحَكُّكَ الجُربِ عَلى ال","أَجذالِ مِن مَضِّ الهَنا",0,"ن",2,0],["تَحكي شَمائلُهُ في طِيبِها زَهَراً","يَفوحُ والرّوضُ مَرهومٌ ومَشمولُ",1,"ل",1,0],["تَحَكَّموا فَاِستَطالوا في تَحَكُّمِهِم","وَعَمّا قَليلٍ كَأَنَّ الأَمرَ لَم يَكُنِ",2,"ن",1,1],["تَحَكّمَ في سُكّانِ أندَلُسَ العِدَى","فلَهفاً على الإسلامِ ما بينَهُمْ لهْفا",3,"ف",2,0],["تَحَكَّكُ بِالوَعيدِ فَإِنَّ قَيساً","نَفَوكُم عَن ضَرِيَّةَ وَالجِنابِ",4,"ب",1,0],["تحكَّم في ودِّي لديه وسلوتي","فأحسن في أحكامه العقد والحلاَّ",5,"ل",2,0],["تحكم في الناس عنسه وردا","حكم ابن أيوب في سطاً وندا",6,"د",2,0],["تحكَّمَتِ الأيامُ في ذات بيننا","فقلَّلْنَ منه بالفِراق نصيبي",7,"ب",2,0],["تُحكَى المكارمُ عنكمْ وهي شاهدةٌ","ليسَتْ بغَيب ولا تُحصى بتعديدِ",8,"د",1,0],["تحكي بحُسْنِ غنائها","تصديقَ جودِكَ للأماني",9,"ن",2,0],["تَحكي المُدامَةَ رِقَّةً وَقَساوَةً","تَحكي المَهاةَ لَواحِظاً وَتَليلا",10,"ل",2,0],["تَحكي صِفاتِكَ في الثَقا","لَةِ وَالمَهانَةِ وَالبَلَه",11,"ل",2,0],["تحكي السماء لعين لا نفوذ لها","روضا كأن الثريا فيه عنقود",12,"د",1,0],["تحكى توابع شمسنا","فتطوف منها في الجوانب",13,"ب",1,0],["تحكى المصابيح حولَيها وبُهرتَها","قلائد الغيد فوضى في تراقيها",14,"ي",3,0],["تَحكُمُهُم راهِبَةً","ذَكّارَةٌ مُغَبِّرَه",15,"ر",2,0],["تَحكُمُ فيهِ قَيصَرَه","في قَومِها مُوَقَّرَه",15,"ر",2,0],["تحكي يميناه يمينَي عابدٍ","ويقولُ إنْ لم أَحْكِهِ لم أُعذَرِ",16,"ر",1,0],["تحكي دُماها غيدُها البيضُ الألى","بلحاظهن فتونُها وفتورُها",17,"ر",3,0],["تَحَكَّمَ فيها القاسِطونَ فَأَصبَحَت","تُقادُ بِأَسبابِ الهَوانِ وَتُوثَقُ",18,"ق",1,0],["تَحَكَّمي يا مِصرُ في كُلِّ الأُمَمْ","تَحَكَّمي فَهيَ عَبيدٌ وَخَدَمْ",19,"م",1,0],["تَحَكَّمَ فينا الداءُ فَاِنحَلَّتِ القُوى","وَآيَةُ داءِ الجَهلِ أَن يَتَحَكَّما",20,"م",2,0],["تَحكي مِنَ السَما خَدّي","يا ختي اِش ذا الحَسَد وَذا القُدرَه",21,"ه",1,0],["تحكُم النَّاس بمستضعفٍ","سرُّ من الأَسرار لا يُدركُ",22,"ك",1,0],["تَحكي ذَوائِبُها في","رَواحِها وَالمَجِيَّه",23,"ي",2,0],["تَحكي حَوافِرُها إِذا وَقَعَت","حُرقاً عَلى قَلبي تُرَضِّضُها",24,"ض",3,0],["تَحَكَّمَ فيهِ البَينُ وَالدَهرُ يَنقَضي","فَلِلَّهِ رَأيٌ ما أَضَلَّت مَناهِجُه",25,"ج",2,0],["تَحكي لَنا الجُلَّنارَ وَجنَتُهُ","إِذا عَلاها تَوَرُّدُ الخَجَلِ",26,"ل",1,0],["تَحَكَّمَ عِلجُها إِذ قُلتُ سُمني","عَلى غَيرِ البَخيلِ وَلا الضَنينِ",27,"ن",1,0],["تحكي العروسَ تَهادَى في تَأوُّدِها","وقد أطافَتْ بها الدّاياتُ والخَوَلُ",28,"ل",1,0],["تَحكى وتُنقل عندها الآراء","يا ربَّ مدنيً من حماك مشنَّف",29,"ف",1,0],["تَحْكِي الْغَزَالَةَ أَلْحَاظَاً إِذَا نَظَرَتْ","وَالْوَرْدَ خَدَّاً وَغُصْنَ الْبَانِ أَعْطَافَا",30,"ف",2,0],["تَحَكَّمَتِ الصَّهْبَاءُ فيهِمْ فَغَيَّرَتْ","شَمَائِلَ مَا يَأْتِي بِهِ الْجِدُّ بِالْهَذْرِ",31,"ر",1,0],["تحكَّكَ مِن حَولِهِ شاعِرٌ","وَما حاكَ في ساعَةٍ حَكَّكا",32,"ك",2,0],["تحكَّم في أرضك المالكون","وشنُّوا الحروب على الأُجراء",33,"ا",2,0],["تحكمت من أصيل الرأي فطنته","كأنها فيه أبصار وآذان",34,"ن",1,0],["تحكموا في ملككم ورزقكم","وكبسوا البئر وقطعوا الرشا",35,"ا",1,0],["تحكم في سكان أندلس العدا","فلهفا على الإسلام ما بينهم لهفا",36,"ف",2,0],["تحكم البرلمانَ من أمم الدنيا","نساءٌ تمثلُ الأقطارا",37,"ر",2,0],["تحكمت فيها الفرنجُ وغادرت","أعلاجها محارب عمروٍ هيكلا",38,"ل",2,0],["تحكم في من معناه حال","ولا بدعا فللعشاق حال",39,"ل",1,0],["تحكمت يا ريم الابيرق بالذي","يمر الدياجي برق ثغرك يرصد",40,"د",1,0],["تحكَّكْ بالرئيِس وفز بشكرى","وحقاً تطلُبُ الجرباءُ جِذْلا",41,"ل",2,0],["تحكى أنابيبُ اليراع بكفّه","فعلَ الرماح تخاطرت في سَمهرِ",42,"ر",1,0],["تحكى الغمامةَ إيماضا مباسمُهم","وليس يحكينها في جَوْدها الهطِلِ",43,"ل",1,0],["تَحَكَّمَ في دارِ الوَكالَةِ فَاِنبَرَت","بِغاراتِهِ قاعاً كَما شاءَ صَفصَفا",44,"ف",2,0],["تحكي الغصون بها الأحباب ناحلة","ما بين مغترف منها ومغتبق",45,"ق",1,0],["تحكى الموازيبُ منها","صوالحَ البلور",46,"ر",1,0],["تحكَّمتَ فيما شئتَ حتى كأنما","لسيفِك أرواحُ الملوكِ وَدائع",47,"ع",1,0],["تحكي نجومَ القذف أنجمُها فإن","مَرَدَتْ شياطينُ الحوادثِ تُرْجَم",48,"م",1,0],["تحكي رُضابَ مُديرِها فكأنَّها","قد مجَّها في الكاسِ منه مفلَّج",49,"ج",1,0],["تحكي عنادلها على اعوادها","خطباء تتلو الوعظ من سجعاتها",50,"ت",3,0],["تَحْكي عذوبةُ رِيقهِ","خَمْراً تُعَلُّ بماءِ طَلّ",51,"ل",1,0],["تحكي قدودَ العذارَى البيض جاذَبها","أردافُها فانثنت من شِدة الصلفِ",52,"ف",1,0],["تحكَّم فيهم كلُّ أنْوَكَ جاهلٍ","ويُغْزَون عَزْواً ليس فيه مَحَاد",53,"د",1,0],["تحكمن بي كالدهر غير مدافع","بأحكامه والبحر غير مداعب",54,"ب",1,0],["تحكَّموا مثلما شاءَت مطامعُهم","وصيّروا بِيننا التهويلَ تهوينا",55,"ن",2,0],["تَحكي الشَحاريرُ رُهباناً صَوامِعُها ال","باناتُ تَتلو زبوراً في أَعاليها",56,"ي",3,0],["تحكي إذا هي حدّثَت","سجع الحمائم في",57,"ي",1,0],["تحكَّمن قسراً في القلوب فلَن تَرى","فؤادَ محبٍّ من هواهنَّ خاليا",58,"ي",2,0],["تحكي نجوم السما أزهارُ تربته","لأن طلعته تحت الثرى قمر",59,"ر",1,0],["تَحكَّمَ في أرواحنا سَيْفُ عَيْنها","ومَن حَكّمتْه دَولةٌ يتَحكَّم",60,"م",1,0],["تَحكي وِشاحاً جائلاً","وكأنّما الآفاقُ خَصر",61,"ر",1,0],["تَحكي رياضَ الأقحوانِ بدَتْ","ومن الشّقائقِ وُسِّطَتْ شَذرا",62,"ر",2,0],["تَحَكَّم بِها ما شِئتَ تَنفي وَتَصطَفي","وَتُقصي وَتُدني ثُمَّ تُحيي وَتَقتُلُ",63,"ل",1,0],["تَحَكَّم كَيفَ شِئتَ بِقَلبِ عَبدٍ","تَحَكَّمَ في المُنى بِكَ كَيفَ شاءَ",64,"ا",2,0],["تحكَّمَ في أموالِهِ كلُّ قاصِدٍ","وحكَّمهُ في شُكرِه فَتَحكَّما",65,"م",2,0],["تَحكي الهَزبر إِذا أَزبأرّت","صورة إِلّا زَئيرَه",66,"ر",2,0],["تحكّم في فنِّ البلاغة فاغتدى","لَه في المعاني الصَّعبةِ النهيُ والأمرُ",67,"ر",1,0],["تُحكَّم في قُصرى الضُلوعِ قِصارُها","وَيَمرُق في صُمِّ العِظامِ عِظامُها",68,"م",3,0],["تَحكي حروفك لا مَعنى مواقعها","وَلَيسَ كل سَواد أَسودَ البصَرِ",69,"ر",1,0],["تَحكِي البروقُ فؤادَه فَضِرَامُها","أشواقُهُ وخُفوقُها خَفقَانُهُ",7