{"poems":[[57,"إنما حبب المسير إلينا","https://www.aldiwan.net/poem26451.html","الخفيف"],[53,"ليس حمد الجفون في مريها النوم","https://www.aldiwan.net/poem7940.html","الخفيف"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[82,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54827","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[203,"يا غريب الدار إن","https://www.aldiwan.net/poem45203.html","مجزوء الرمل"],[208,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[259,"غرور","https://www.aldiwan.net/poem24950.html","مجزوء الرمل"],[275,"طال ليلي من شعرها النضناض","https://www.aldiwan.net/poem35383.html","الخفيف"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[358,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[376,"إنما حامد على الحمد وقف","https://www.aldiwan.net/poem57295.html","الخفيف"],[422,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[484,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122309","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70998","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1274,"","https://poetry.dctabudhabi.ae/diwan/poem/99857","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95514","الخفيف"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128741","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27426","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28045","الخفيف"],[2285,"","https://poetry.dctabudhabi.ae/diwan/poem/31446","الرمل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127388","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48368","الرمل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34712","الخفيف"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"],[4778,"ساجي الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=188196",""],[835,"بات ساجي الطرف والشوق يلح","https://www.poetsgate.com/ViewPoem.aspx?id=40614",""],[5848,"ماغيرها داخل البحرين مملوحة","https://www.poetsgate.com/ViewPoem.aspx?id=48963",""],[5970,"نحن يا أيام أضياف لديك","https://www.poetsgate.com/ViewPoem.aspx?id=130588",""]],"verses":[["إِنَّما حَبَّبَ المَسيرَ إِلَينا","أَنَّنا نَستَطيبُ ما تَستَطيبُ",0,"ب",1,1],["إنما حمدُها إذا هي حالتْ","بين طرفِ العيونِ والبُغَضاءِ",1,"ا",2,0],["إنما حظيَ اللَّفاءُ لديهِ","مَع ما فيهِ بي مِنَ الإعجابِ",2,"ب",1,0],["إنما حكم الذات حاجة مصر","ما لها في حياتها منه بد",3,"د",1,0],["إنّما حِمْيَرُ أُسْدٌ لم تَزَلْ","من قناها ساكناتٍ في أجَم",4,"م",1,0],["إِنَّمَا حَاذِرِ المَنُونَ وَلاَ تَنْسَ","عَرُوساً عَلَيكَ مِنْها غَيُورَا",5,"ر",2,0],["إِنَّمَا حَافِظٌ فَتَاهَا وَمِنْهَا","وَبِهَا فَخْرُهُ عَلَى الأنْدَادِ",6,"د",1,0],["إنما حظُّ الفتى من","هذهِ الدنيا حبيبهْ",7,"ب",2,0],["إنما حسرتي لقلَّة حظي","من حبيب أراه نصب عياني",8,"ن",2,0],["إنما حدسي دليلي","لم يكن في الأمر صنعُ",9,"ع",1,0],["إنما حبُّهُ شفيعٌ إلينا","فعلينا بالغضّ أو بالتغاضي",10,"ض",2,0],["إنّما حظُّ نفسِهِ من هواها","حظُّ آسٍ من قرصةِ الأفعوانِ",11,"ن",1,0],["إِنَّما حسن الفَتى بَينَ الوَرى","بِالنُهى لَيسَ بِتحسين الثِيابِ",12,"ب",1,0],["إنَّما حامدٌ عَلى الحَمدِ وَقفُ","ليسَ بينَ الأنامِ في ذاكَ خُلفُ",13,"ف",1,1],["إنَّما حاولوا أمانيَّ نفسٍ","حَمَلَتهم إذ ذاكَ عبئاً ثقيلا",14,"ل",2,0],["إنما حبّي لشعبي قد ثوى","في الحشا قل هكذا الحب المصان",15,"ن",1,0],["إنما حزبك الموفق حزب ال","صدق أوحى به الثقاة القروم",16,"م",1,0],["انما حال المحبين الكبا","أي فضل لسحاب لا يسح",17,"ح",1,0],["إنما حُشْتُمُ يزيدَ إلى النَّا","رِ كما حاشكُمْ إِليها وحاشا",18,"ش",2,0],["إنما حصنُ التقى أمنعُ لي","من حصونٍ شِّيدَتْ فوق عَلَمْ",19,"م",1,1],["إنّما حبّك أورى في الحَشا","نارَ وجدٍ حرّها قد لذعا",20,"ع",2,0],["إنما حسرتي إذا ما تذكر","ت عنائي بها وطول طلابي",21,"ب",2,0],["إنما حليةُ الفتاة علومٌ","أينَ منها حُليُّها المصقولَه",22,"ل",2,0],["إنما حاتم وان فاض جوداً","هو بالجود من بحارك غارف",23,"ف",1,0],["أنّما حبَّةُ الفؤاد تناهت","ووجوه الأشواق لا تتناها",24,"ا",3,0],["إنما حرَّك الهوى","اهتزاز النواقس",25,"س",1,0],["إنما حبيبي","من أحب حبي",26,"ب",2,0],["إِنَّما حَظُّكَ مِنهُ ذِكرُهُ","لا تَقولَن عَسى لا وَلَعَل",27,"ل",1,0],["إنما حسرتي وحزني ووجدي","ونحيبي وزفرتي واضطرامي",28,"م",2,0],["إن ما حبب للصو","في إيثار الزهادة",29,"د",2,0],["إنما حاشيَتي","فوقَ قُضْبِ الذّهَبِ",30,"ب",1,0],["إِنَّما حُزنُهُ عَلى ثُلُثٍ ك","انَ لِحاجاتِهِ فَغالَتهُ غولُ",31,"ل",1,0],["إنما حيّر فكري عجباً","كونهم قد جرّموا مثلي بري",32,"ي",1,0],["إنما حاتم وأوس وكعب","مثل في الندى له مضروب",33,"ب",1,0],["إنما حبي يكون واحدا","لوحيد فلى التوحيد دين",34,"ن",1,0],["إنَّما حالي وأرباب الهوى","بينهم دوما وبين السُّهْد صلحْ",35,"ح",1,0],["إنما حال المحبين البكا","أيُّ فضلٍ لسحابٍ لا يسحُ",36,"ح",1,0],["إن ما حصل حبها باقنع ب اخوّتها","وان ما حصل شي ! يبلش زايد ب روحه !!",37,"ح",2,0],["إنما حظ الفتي في عيشه","راحة يحظى بها من راحتيك",38,"ك",1,0]]}