{"poems":[[95,"ولوا المدينة وجهكم ودعوني","https://www.aldiwan.net/poem11179.html","الكامل"],[87,"بأبي وروحي الناعمات الغيدا","https://www.aldiwan.net/poem63773.html","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130071","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101372","الكامل"],[5226,"للقدس .. كلام آخر","https://www.poetsgate.com/ViewPoem.aspx?id=27720",""]],"verses":[["وَلُّوا المَدِينَةَ وَجْهَكُمْ وَدَعُونِي","أَنَا فِي هَوَايَ وَعُزْلَتِي وَجُنُونِي",0,"ن",2,1],["وَلّوا إِلَيهِ في الدُروسِ وُجوهَكُم","وَإِذا فَرَغتُمُ وَاِعبُدوهُ هُجودا",1,"د",2,0],["وَلّوا إلى دورِ العلوم وجوهكم","وتعهّدوها بالنصيحةِ واِكتُبوا",2,"ب",3,0],["ولوا الأمور ولو أطاعوا رشدهم","لسعوا وراء الحق سعي ولاة",3,"ه",1,0],["ولّوا إذا ما الجد جد وأدبروا","وغفوا على جرح الهوان وناموا",4,"م",3,0]]}