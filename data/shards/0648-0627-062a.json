4",""],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[38,"مَا بَالُ دَفِّكَ بالْفِرَاشِ مَذِيلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=21222",""],[2,"أمِنْ آلِ لَيلى عَرَفْتَ الطُّلُولا","https://www.poetsgate.com/ViewPoem.aspx?id=5263",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[17,"نطفة ما منيتُ يومَ منيتُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19172&r=&rc=5",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[88,"نزلت تجر إلى الغروب ذيولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19531&r=&rc=34",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["وَإِتلافُ ما لي عَن حَياتي أَلَذُّ لي","وَلا خَيرَ أَن يَبقى وَأُصبِحَ فانِيا",0,"ي",2,0],["وَأَتى الزَمانُ مُهَنِّئاً يَحدو بِهِ","غُلُّ المَشوقِ وَغُلَّةُ اللَهفانِ",1,"ن",1,0],["وَاِتِّشاحُ النُسورِ بَعدَ اِدِّراعِ ال","نَقعِ مِن حُلَّةِ النَجيعِ المُراقِ",2,"ق",1,0],["وَأَتوبُ مِن ذَمِّ الزَمانِ إِذا","عَلِقَت يَدايَ يَدي أَبي سَعدي",3,"ي",1,0],["وَاِتَّهَمَ الخَيلَ فَهوَ يَمتَحِنُ ال","مُهرَةَ قَبلَ الطَرادِ بِالطَرَدِ",4,"د",1,0],["وَأُتعِبُ القَلبَ فيمَن لا وِصالَ لَهُ","يا لِلرِجالِ أَقَلَّ الخُرَّدُ الغيدُ",5,"د",1,0],["وَأَترُكُ سُمرَ الخَطِّ ظَمأى خَلِيَّةً","وَشَرُّ قَناً ما كُنَّ غَيرَ رِواءِ",6,"ا",2,0],["وَأُتبِعُ النَّجمَ يَحكي عِقدَها نَظَراً","وَأَحرِمُ القَمَرَ المألوفَ مِن نَظَري",7,"ر",2,0],["وَأَتَبعتُها أُخرى فَبي مِثلُ ما بِهِ","أَجِلْ ما اسَطَعتَ الطَّرْفَ أُسْعِدْكَ يا سَعدُ",8,"د",1,0],["وأتى الدنيا فقيراً فأتت","نحوه الدنيا وأعطته الزماما",9,"م",2,0],["وَأَتانا عَن الأَراقِمِ أَنبا","ءٌ وَخَطبٌ نُعنى بِهِ وَنُساءُ",10,"ا",2,0],["وَأَتَوهُم يَستَرجِعُونَ فَلَم تَر","جِعُ لَهُم شامَةٌ وَلا زَهراءُ",10,"ا",2,0],["وَاِتِّكالي عَلى الَّذي كُلَّما أَب","صَرَ ذُلّي يَزيدُ في تَعظيمي",11,"م",2,0],["وَاِتَّبَعنا رِضاكَ في كُلِّ وَجهٍ","لَو نُجازى بِمِثلِ ما قَد فَعَلنا",12,"ن",2,0],["وأتلو على كرسي إبداعك الذي","ينزه في إحكامه آية الكرسي",13,"ي",1,0],["وأتْحَفْتَ بالدُرِّ الذي مَنْ يفُزْ بهِ","على كلِّ ذُخْرٍ في الوجودِ قدِ احْتَوى",14,"و",2,0],["وأتَى برَيْحانِ الحَديثِ فكلّما","سمَحَ النّديمُ براحِهِ حَيّاهُ",15,"ي",3,0],["وأُتلِفُ بينَ الخلْقِ والرِّزْقِ فِكْرَتي","ولسْتُ بخَلاّقِ ولسْتُ برَزّاقِ",16,"ق",1,0],["وَأَتَتْ هَدَايَاهَا إِلِيْكَ فَأَكَّدَتْ","بَيْنَ الْقُلُوبِ مَوَدَّةً وَذِمَامَا",17,"م",2,0],["وَأَتَاكَ نَجْلُكَ وَالسَّعُودُ تَحُفَّهُ","وَالْخَلْقُ تَلْثِمُ كَفَّهُ وَتُقَبِّلُ",18,"ل",1,0],["وَأَتَى وَمِنْ قِطَعِ الظَّلاَمِ مَوَاكِبٌ","وَمِنَ الصَّبَاحِ أسِنَّةٌ وَنُصُولُ",19,"ل",1,0],["وأتَتْ محمّلَةَ مُتون أحادِثٍ","فاهَتْ بهنّ مَباسِمُ الأزْهارِ",20,"ر",1,0],["وأتوا خضَمَّ الماءِ يزْخَرُ موْجُهُ","فشَرَوْا بإعدامِ الحَياةِ وُجودا",21,"د",2,0],["وأتتْ على إيواءِ كسْرى رجّةٌ","هدّتْ قواعِدَهُ وكان مَشيدا",21,"د",2,0],["وأتَيْتُ رَبَّ الدّيْرِ في مِحْرابِه","فبَثَثْتُ إفْلاسي إليْهِ وَحاجِي",22,"ي",1,0],["وَأَتَاحَ أَنْدَلُساً بِحَدِّ حُسَامِهِ","قَسْراً فَأحْيَا الأَرْضَ بَعْدَ هَمَاتِهَا",23,"ت",3,0],["وَأَتَيْتَ فَعْلَةَ جَدِّكَ الأَرْضَى التِي","لاَ يَرْتَضِي الْعَلْيَاءَ مَنْ لَمْ يَأَتِهَا",23,"ت",3,0],["وَأَتيتُ في بَحْرِ الْقِرَى أَمَّ الْقُرَى","حَتَّى حَطَطْتُ بِمَرْفَإِ التَّقْرِيبِ",24,"ب",1,0],["وَأَتَوْا وَدِينُ اللهِ لَيْسَ بِأَهْلِهِ","إِلاَّ أَلِيلٌ خَافِتٌ وَذَمَاءُ",25,"ا",2,0],["وَاِترُكهُ واحذَر أَن تَمُرَّ بِبابِهِ","دَهراً وَعِرضُكَ إِن فَعَلتَ سَليمُ",26,"م",1,0],["وَأَتلَعَ يُلوى بِالجَديلِ كَأَنَّهُ","عَسيبٌ سَقاهُ مِن سُمَيحَةَ جَدولُ",27,"ل",1,0],["وَأَتى بِأَقصى ما يَنالُ مُفاوِضٌ","يَسعى بِغَيرِ كَتائِبٍ وَحِرابِ",28,"ب",1,0],["وَأَتى لِمِصرَ وَأَهلِها بِسِيادَةٍ","مَرفوعَةِ الأَعلامِ وَالأَطنابِ",28,"ب",1,0],["وَأَتَيتُم بِالحائِماتِ تَرامى","تَحمِلُ المَوتَ جاثِماً وَالخَرابا",29,"ب",2,0],["وَأَتَوا بِهِندِنبُرجَ مُخ","تَفِياً بِمِصرَ يَقودُهُنَّه",30,"ن",2,0],["وَأَتى يُساوِمُ في القَناةِ خَديعَةً","وَلَوَ اِنَّها تَمَّت لَتَمَّ بِها الشَقا",31,"ق",2,0],["وَأَتَوا بِحاذِقِهِم يَكيدُ لَها بِما","يَثني عَزائِمَها فَكانَت أَحذَقا",31,"ق",2,0],["وَأَتَت تَخطِرُ وَاللَيلُ فَتىً","وَهِلالُ الأُفقِ في الأُفقِ حَبا",32,"ب",2,0],["وَأَتَيتُ يَحدو بي الرَجاءُ وَمَن أَتى","مُتَحَرِّماً بِفِنائِكُم لا يُحرَمُ",33,"م",1,0],["وَأَتَت تَعودُ مَريضَها لا بَل أَتَت","مِنّي تُشَيِّعُ راحِلاً لَو تَعلَمُ",33,"م",1,0],["وَأَتى أَمرُها فَأَضحَت كَأَن لَم","تَكُ بِالأَمسِ زينَةَ البُلدانِ",34,"ن",1,0],["وَأَتَيتُ أَقضي بَعضَ ما أَولَيتَني","وَأَقولُ فيكَ الحَقَّ غَيرَ مُحابي",35,"ب",2,0],["وَأَتى الحُسانُ فَهَنِّئوا مُلكَ النُهى","بِقِيامِ دَولَتِهِ وَعَودِ حُسانِهِ",36,"ن",2,0],["وَأَتى الحُسَينُ يَزورُ قُطبَ زَمانِهِ","يَرعى وَيَحرُسُ رَكبَهُ جِبريلُ",37,"ل",1,0],["وَاِتَّبَعَ الحَقَّ حينَ لاحَ لَهُ","فَجرُ الهُدى مِن دُجُنَّةِ الفَجرِ",38,"ر",1,0],["وَاترُك ظِباءَ التُركِ سانِحَةً","لا تَعتَرِض لِحَبائِلِ الأَجَلِ",39,"ل",1,0],["وَأَتى بِيَ النُعمانَ يَومَ نَعيمِهِ","نَجمٌ تَلَقّى سَعدَهُ الميلادُ",40,"د",1,0],["وَأَتلَعَ بَرّاقٍ كَأَنَّ اِهتِزازَهُ","إِذا اِنتَصَفَت لِلرَوعِ هِزَّةُ مُنصلِ",41,"ل",1,0],["وَأَتبَعتُها عَينَيَّ حَتّى رَأَيتُها","أَلَمَّت بِفِعرى وَالقَنانِ تَزورُها",42,"ر",3,0],["وَآتي بُيوتاً حَولَكُم لا أُحِبُّها","وَأُكثِرُ هَجرَ البَيتِ وَهوَ جَنِيبُ",43,"ب",1,0],["وأتى معجزاته المتنبي","وهي مما أراد شيءٌ يسير",44,"ر",1,0],["وأتوا ضروباً من بدائع حذقهم","خلابةً لم يأتها الأجداد",45,"د",1,0],["وَآتُوا زَكَاتَكُمْ عَنْ رِضاً","تَقِيَّةَ إِيتَائِهَا مُكْرَهِينْ",46,"ن",1,0],["وَآتَتْهُ فَضَائِلَ أَنْزَلَ","تْهُ المَنْزِلَ الأَسْمَى",47,"م",2,0],["وَأَتَاحَ رَبُّكَ لِلَّذِينَ تَكَلَّمُوا","عَنْ مِصْرَ نَصْراً فَوْقَ كُلِّ كَلامِ",48,"م",1,0],["وَآتَوْهَا مَفَاخِرَ أَثَّلُوهَا","تَزِيدُ مَفَاخِرَ الإرْثِ الكَريمِ",49,"م",1,0],["وأَتَّبع القُصَّاصَ كلَّ عشيَّةٍ","رجاءَ ثوابِ اللَّهِ في عَدَدِ الخُطَا",50,"ا",1,0],["وَأَترُكُ القَولَ إِلاَّ في مُرَاجَعَةٍ","حَتَّى يَكُونَ لَهُ مُلحُ وَمُستَمِعُ",51,"ع",1,0],["وأترك أهلي في رضاك إلى الأسى","وأُسلم نفسي في يديك وأسلم",52,"م",1,0],["وأتى وقد شفّ النحولُ هلالَه","ولشوقِهِ للقاء وجهك ينحلُ",53,"ل",1,0],["وأتيت بالذكر الحكيم مُبيِّناً","قد فُصِّلت آياته تفصيلا",54,"ل",2,0],["وأتاك بسحب ذيل سُحب أغدقت","تُغري جفون المزن باستعبارِ",55,"ر",1,0],["وأتتك يا ملك الزمان غريبةٌ","قيد النواظر نزهة الأبصارِ",56,"ر",1,0],["واتارع من بازي الصباح غرابُهُ","لما أطلّ فطار كلَّ مَطارِ",57,"ر",1,0],["واترك سؤالك للرسوم فإنها","مما يزيدك بالسؤال ضلالا",58,"ل",2,0],["وأتت بعدها من الغيد أخرى","يقتفى أثرها الجمال جنيبا",59,"ب",2,0],["وأتى الظلام دنة فدجنّةً","يرخى سدولاً جمّةً فسدولا",60,"ل",2,0],["وأتى المدى يوم السباق مُجَلِّياً","يَجري سَبوح خلفه ورَكُوض",61,"ض",1,0],["وأترع كفّه حَمَأ نَتيناً","ليلطخ وجه من يُبدي خلافه",62,"ف",2,0],["وأترك مجادلة الذين توَهّموا","هَزَج الغناء خلاعة وفُسوقا",63,"ق",2,0],["واتعب له تسترح به أبداً","فراحة المرء من جَنى تعبه",64,"ب",2,0],["وأتعبوا اليوم فعُقبي التعب","راحةٌ مُشبَعة بالتَرَف",65,"ف",1,0],["واتركوا الغرب وأهليه ولا","تسمعوا منهم إلى ما قد يقال",66,"ل",1,0],["وأترك ما قد تشتهي النفس نَيْله","لما تشتهيه قلة في دراهمي",67,"م",2,0],["واتخذت للقدر في عُقبة ال","كرة مبذولة وطائدها",68,"ه",2,1],["وأتلَفَ وَاحدَ النُّعمَان لَمَّا","أراد به الجريرة أَن يشيّنا",69,"ن",2,0],["وَأَترُكُ أَن أَبكي عَلَيكَ تَطَيُّراً","وَقَلبِيَ يَبكي وَالجَوانِحُ تَلطِمُ",70,"م",1,0],["وَأَتبَعُ فِعلَهُ في كُلِّ أَمرٍ","وَأَجعَلُ فَضلَهُ أَبداً إِماما",71,"م",2,0],["وَأَتحَفَني بِكَأسٍ مِن رُضابٍ","وَكَأسٍ مِن جَنى خَدٍّ وَراحِ",72,"ح",1,0],["وَأتِ الرَسولَ فَقُل يا خَيرَ مُؤتَمَنٍ","لِلمُؤمِنينَ إِذا ما عُدِّلَ البَشَرُ",73,"ر",1,0],["وَأَتَيتُهُ يَوماً فَقَرَّبَ مَجلِسي","وَسَقى بِراحَتِهِ مِنَ الخُرطومِ",74,"م",1,0],["وأتى إليَّ اليومَ يفتح حلقَه","فامْنن عليَّ وسدّ هذا البابا",75,"ب",2,0],["وأتى إلى حجر الكرام فطاف في","حجّ الرجاءِ معاوذا ميقاته",76,"ت",2,0],["وأتت بكل جميلة","ما ذي أصابعُ ذي أياد",77,"د",1,0],["وأتعبت نفساً للمعالي كريمةً","وليس العلى والمجد إلاَّ لتعبان",78,"ن",1,0],["وَاِتَّصلِ الوَصلُ بِاِفتِراقٍ","فَصارَ في غَيبَتي حُضوري",79,"ر",2,0],["وأتى طوده الموشح بالنور","وأغفى في ظل غار حراء",80,"ا",2,0],["وأتاني الرسولُ عنها بقولٍ","لم تُبَيّنهُ في سطور الكتابِ",81,"ب",1,0],["وأُتْبعَ أهْلُ الفِسْقِ مِنْ أَوْلِيَائه","فَوَافَاهُ والباقُونَ فَلٌّ مُشَرَّدُ",82,"د",1,0],["واتَّقَى قوْلَ المُسامِينَ له","إنما بالإرْثِ أصبحت تَسُودُ",83,"د",1,0],["وأتركها قصْداً لآمِدَ طائعاً","وقلبي إليها بالهوى جِدَّ قاصِدِ",84,"د",1,0],["واتخذوا الصدق زينةً لهُمُ","كَرهاً على رغمهم وهمْ صَغره",85,"ر",2,0],["وأتتْ قطائف بعد ذاك لطائفَ","تَرْضى اللهاةُ بها ويرضى الحنجر",86,"ر",1,0],["وأتركُ أخلاقَ اللئام لأهلها","وأرفضها مذمومةً أيما رفض",87,"ض",1,0],["واتخِذني جُنّةً بل نَجدةً","لا تجِدني في الملمَّات حَرَض",88,"ض",1,0],["وأتى الأمير لقد جرى فسعى","مسعاه غير مطالعٍ طِلعه",89,"ع",2,0],["وأتى من وفائه بغية النف","س يَمَسُّ العليل مساً فيشفي",90,"ف",2,0],["واترك الحاء على حا","ل فما للحاء مصرف",91,"ف",1,0],["واتسق النظم في النظام به","فائتلف الشمل كل مؤتلف",92,"ف",1,0],["وأتبعت منعك لي بالحجا","ب مهلاً هديت ففي المنع كافي",93,"ي",1,0],["واتّقاني بحق سلطان ودي","قسمةً ما ذممتها وطسوقا",94,"ق",2,0],["واتخذْه على خِوانك أُدْماً","فهو أوْلى بالخِلّ من إخوانِك",95,"ك",1,0],["واتخذْ حشوةً وأعفِ جِعِرّا","ك من الطعن بالأيور قليلا",96,"ل",2,0],["وأتبِع نائلاً بغنىً وشيكٍ","فإنَّ القطر تتبعه السُّيولُ",97,"ل",1,0],["واترٌ ظالمٌ وناقض وتْرٍ","أيُّ هذيْن يستحق الندامَهْ",98,"م",2,1],["وأتتْ فتىً ما سارَ سيرةَ تائهٍ","في حِفْظِ نعمتهِ ولا تَيَّاه",99,"ه",1,0],["وَاِتَّخِذوهُ عَدُوّاً إِنَّ شاهِدَهُ","وَما تَغَيَّبَ مِن أَخلاقِهِ دَعَرُ",100,"ر",1,0],["وَأَتى النُجومَ حَديثُهُ فَتَهافَتَت","لِتَقومَ حُرّاساً لَهُ حُجّابا",101,"ب",2,0],["وَأَتَت شُهورٌ بَعدَها","ساعاتُها مِثلُ الشُهورِ",102,"ر",1,0],["وَأَتى الشِتاءُ فَلَم تَكُن في غَيمِهِ","الباكي وَلا في رَعدِهِ المُتَفَجِّعِ",103,"ع",1,0],["وَأَتى ذَويهِ نَعيُهُ فَتَأَلَّبوا","وَالغيدُ تُعيلُ أَيُّما إِعوالِ",104,"ل",1,0],["وَأَتَتنا رُسُلُ الأَح","بابِ مِنهُم بِالهَدايا",105,"ا",3,0],["وَأَتى سَوادُ مِدادِها","يَحكي سَوادَ المُقلَتَينِ",106,"ن",1,0],["وَأَتى يُعَرِّضُ في الحَدي","ثِ بِرامَةٍ سُقِياً لِرامَه",107,"م",2,0],["وَأَتى الرَسولُ وَلَم أَجِد في وَجهِهِ","بِشراً كَما قَد كُنتُ أُعهَدُ أَوَّلا",108,"ل",2,0],["وَأَترُكُ أَوطاناً ثَراها لِناشِقٍ","هُوَ الطيبُ لاما ضُمَّنَتهُ المَفارِقُ",109,"ق",1,0],["وَأَتى العَذولُ وَقَد سَدَدتُ مَسامِعي","بِهَوىً يَرُدُّ مِنَ العَواذِلِ عَسكَرا",110,"ر",2,0],["وَأَتاني مِنكَ شِعرٌ","كُلُّ بَيتٍ بِقَصيدِ",111,"د",1,0],["وَأَتى البَشيرُ فَلَو يَسوغُ لِواحِدٍ","مِنّا لَقاسَمَهُ لَذيذَ حَياتِهِ",112,"ت",2,0],["وَأَتَوا نِسائَهُمُ بِنيبٍ لَم يَدَع","سوءُ المَحابِسِ تَحتَهُنَّ فَصيلا",113,"ل",2,0],["وَأَتاهُمُ يَحيا فَشَدَّ عَلَيهِمُ","عَقداً يَراهُ المُسلِمونَ ثَقيلا",113,"ل",2,0],["واتلُ للحبِّ والحَيَاةِ أَغاني","كَ وخلِّ الشَّقاءَ تدمَى كُلُومُهْ",114,"م",2,0],["واتبعِيني يا شِياهي","بَيْنَ أَسرابِ الطُّيورْ",115,"ر",1,0],["واتَّخذتُ الحَيَاةْ","معزفاً للنَّغَمْ",116,"م",1,0],["واتركْهُ يقتحِمُ العواصفَ هائماً","في أُفْقِها المتلبِّدِ المقرورِ",117,"ر",1,0],["واتْرُكْ دموعَ الفجرِ في أَوراقِها","حتَّى تُرشِّفَهَا عَرُوسُ النُّورِ",118,"ر",1,0],["وَأَتى صَواحِبُها فَقُلنَ هَذَا الذي","مَنَحَ المَوَدَّةَ غَيرَنَا وَجَفانا",119,"ن",2,1],["واترك حقيقتها فرب حقيقية","يدمى فؤادك فهمها ويخوف",120,"ف",1,0],["واتى المشيب ولم اكن لما اتى","متبوء رأسي له بمرحب",121,"ب",1,0],["واتخذ ختما على أشيائه","إن أشياء الهوى كنز سنى",122,"ا",1,0],["وأتت على الأقلام بعدك فترة","قُطمت وكانت مدمنات مداد",123,"د",1,0],["وأتيح لي داود مز","مارا وحسن ترتل",124,"ل",1,0],["وأتى الغوث","لأهاليها",125,"ه",2,0],["وأتياس الزريبة ليس تدرى","بأن قد حيرت أسدا وذيبا",126,"ا",1,0],["وأتاني محمد أخذ الرب","ع ببأس حلو وعنف جميل",127,"ل",1,0],["وَأَتتِ الدارُ بَني فاطِمَةٍ","وَاِنتَقَلَ البَيتُ إِلَيهُم وَسَعى",128,"ا",1,0],["وَاِتَّخَذَ النَبحَ لَهُ عَلامَه","فَفَهِمَت حَديثَهُ الحَمامَه",129,"ه",1,0],["وَأَتَت لِثالِثِها وَلَم","تَستَحي أَن فضَّت خِتامَه",130,"م",2,0],["وَأَتَت نَبِيَّ اللَهِ وَه","يَ تَقولُ يا رَبِّ السَلامَه",130,"م",2,0],["وَأَتى الغَيطَ وَقَد جَنَّ الظَلام","فَرَأى العِجلَ فَأَهداهُ السَلام",131,"م",1,0],["وَأَتعَبَ الصَغيرُ قَلبَ الأُمِّ","بِالكِبرِ فَاِحتارَت بِما تُسَمّي",132,"ي",1,0],["وَأتِ قاعاً كَرَفرَفِ الخُلدِ طيباً","أَو كَفِردَوسِهِ بَشاشَةَ وادي",133,"ي",1,0],["وَاِتَّخَذَ الصُنّاعُ مِن","شَحمِيَ زَيتاً طَيِّبا",134,"ب",2,0],["وَاِتَّقِ البَردَ فَكَم خَلقٍ قَتَل","مَن تَوَقّاهُ اِتَّقى نِصفَ العِلَل",135,"ل",1,0],["وَاِترُكِ الخَمرَ لِمَشغوفٍ بِها","لا يَرى مَندوحَةً عَن شُربِها",135,"ه",2,0],["وَاِترُك رَعمَسيسَ إِنَّ المُلكَ مَظهَرُهُ","في نَهضَةِ العَدلِ لا في نَهضَةِ الهَرَمِ",136,"م",1,0],["وَأَتَت لَكَ الجُمَعُ الجَلائِلُ مَأتَماً","فَقَعَدنَ فيهِ مَقاعِدَ الأَنواحِ",137,"ح",1,0],["وَأَترُكُ الغَيبَ لِلَّهِ العَليمِ بِهِ","إِنَّ الغُيوبَ صَناديقٌ بِأَقفالِ",138,"ل",1,0],["وَأَتَيتَ صَحراءَ الإِمامِ تَذوبُ مِن","طولِ الحَنينِ لِساكِنِ الصَحراءِ",139,"ا",2,0],["وَأَتى الأَسيرُ يَجُرُّ ثِقلَ حَديدِهِ","أَسَدٌ يُجَرِّرُ حَيَّةً رَقطاءَ",140,"ا",2,0],["وَأَتى يُقَبِّلُ راحَتَيكَ وَيَرتَجي","أَن لايَفوتَكُما الزَمانَ تَلاقِ",141,"ق",1,0],["وَأَتاكَ مَوفورَ النَعيمِ تَخالُهُ","مَلَكاً تَنُمُّ بِهِ السَماءُ مُطَهَّرا",142,"ر",2,0],["وَأَتَتكِ الريحُ تَمشي أَمَةً","لَكِ يا بَلقيسُ مِن أَوفى الإِماء",143,"ا",2,0],["وَأَتَيتَ مِن مِحرابِهِ","بِأَرِسطَطاليسَ العَظيمِ",144,"م",1,0],["وَأَتَيتَنا بِمُفَصَّلٍ","بِالتِبرِ عُلوِيِّ الرَقيمِ",144,"م",1,0],["وَأَتَيتُ يا رَبَّ النَثي","رِ بِما تُحِبُّ مِنَ النَظيمِ",144,"م",1,0],["وَأَتَيتَ قَرنَ التِبرَ ثَمَّ تَحُفُّهُ","تُحَفُ الضُحى مِن جَوهَرٍ وَسُلوكِ",145,"ك",1,0],["وَأَتى الحَضارَةَ بِالصِناعَةِ رَثَّةً","وَالعِلمِ نَزراً وَالبَيانِ مُثَرثِرا",146,"ر",2,0],["وَأَتى الزَمانُ عَلَيهِ يَحمي سُنَّةً","وَيَذودُ عَن نُسُكٍ وَيَمنَعُ مَشعَرا",146,"ر",2,0],["وَاِتَّخَذوا نَقابَةً","لِأَمرِهِم مُسَيَّرَه",147,"ر",2,0],["وَأَتى كُلُّ شامِتٍ مِن عِدا المُل","كِ إِلَيهِم وَاِنضَمَّتِ الأَجزاءُ",148,"ا",2,0],["وَأَتى الدَهرُ تائِباً بِعَظيمٍ","مِن عَظيمٍ آباؤُهُ عُظَماءُ",148,"ا",2,0],["وَاِتَّخَذتِ الأَنوارَ حُجباً فَلَم تُب","صِركِ أَرضٌ وَلا رَأَتكِ سَماءُ",148,"ا",2,0],["وَاِتَّخَذنا الأَسماءَ شَتّى فَلَمّا","جاءَ موسى اِنتَهَت لَكَ الأَسماءُ",148,"ا",2,0],["وَأَتَتهُ العُقولُ مُنقادَةَ اللُب","بِ وَلَبّى الأَعوانُ وَالنُصَراءُ",148,"ا",2,0],["وَأَتى النَسرُ يَنهَبُ الأَرضَ نَهباً","حَولَهُ قَومُهُ النُسورُ ظِماءُ",148,"ا",2,0],["واتّخِذْ ظَهْرَهُ مِنَ الذُّلِّ حِصْناً","نِعْمَ حِصْنُ الكريمِ في الزِّلْزالِ",149,"ل",1,0],["وأتْحَفَتْني خَوَراً ظَاهِراً","وكُنْتُ قبلَ الشّيْبِ عَيْنَ الشُّجاعْ",150,"ع",1,0],["وَأَتعَبُ خَلقِ اللَهِ مَن زادَ هَمُّهُ","وَقَصَّرَ عَمّا تَشتَهي النَفسُ وُجدُهُ",151,"د",2,0],["وَأَتعَبُ مَن ناداكَ مَن لا تُجيبُهُ","وَأَغيَظُ مَن عاداكَ مَن لا تُشاكِلُ",152,"ل",1,0],["وأترُكُ سيفَ الدولَةِ الملِكَ الرضا","كريمَ المحيّا أروعاً وابنَ أروع",153,"ع",1,0],["وأتى الملك بأدهان لهم","في ذكاء المسك من طيب الشذاة",154,"ه",1,0],["وأتعبُ الناسِ ذو مالٍ يرقِّعُها","يدُ التجمُّلِ والإقتارُ يخرِقُهَا",155,"ق",3,0],["وأتَتْنِي في خِفيةٍ وهي تشكُو","رِقْبةَ الحَيّ والمزارَ البعيدا",156,"د",2,0],["وَأَترُكُ لِلثَرى مَن كُنتُ أَخشى","عَلَيهِ العَينَ تومِئُ أَو تَريبُ",157,"ب",1,0],["وَأَتى بِأَبياتٍ لَهُ مَسروقَةٍ","شَتّى النِجارِ وَنِسبَةٍ أَفوافِ",158,"ف",1,0],["وَأَتى العيدُ في دُجونٍ تَتَبَّع","نَ عَليلَ البَطحاءِ حَتّى اِستَبَلّا",159,"ل",2,0],["وَأَترُكُ عِرضُ المَرءِ لَو شِئتُ كانَ لي","وَلِلذَمِّ فيهِ مَسرَحٌ وَمَسامُ",160,"م",1,0],["وَأَتَيتَني بِصَحيفَةٍ مَختومَةٍ","يُخشى عَلَيَّ بِها حِباءُ النِقرِسِ",161,"س",1,0],["وأَتاكَ الهُمامُ ذو النَّظَرِ الشَّزْ","رِ إليها والصِّلُّ ذو الإطراقِ",162,"ق",1,0],["واتَّجَهَت فيه كلُّ كاشِفَةٍ","وَجْهاً بِثَوْبِ الظَّلامِ مُدَّرِعا",163,"ع",2,0],["وأتتكَ مُكْمَلةً محاسنُها","تختالُ في أثوابِ زينتِها",164,"ت",3,0],["وَأَتاها البِلى فَمَرَّ عَلَيها","فَأَبَت أَن تَسيغَ رَدَّ الجَوابِ",165,"ب",1,0],["وَاِترُكا اليَومَ في مُدامي مَلامي","إِنَّ فَرطَ المَلامِ في ذاكَ يُغري",166,"ي",1,0],["وَاِتَّخَذَ التَسهيدُ عَي","ني مَألَفاً لَمّا جَفا",167,"ا",1,0],["وَأَتى يُسَتِّرُ سالِفَيهِ بِفَرعِهِ","حَذَراً فَيَحجُبُ سَبطَها في جَعدِهِ",168,"د",2,0],["وَأَتَت حَليمَةُ وَهيَ تَنظُرُ في اِبنِها","سِرّاً تَحارُ لِوَصفِهِ الأَذهانُ",169,"ن",1,0],["وَأَتَت مَفاتيحُ الكُنوزِ بِأَسرِها","فَنَهاكَ عَنها الزَهدُ وَالعِرفانُ",169,"ن",1,0],["وَأَتَينا مِنَ الخُيولِ بِسيلٍ","سالَ فَوقَ الهِضابِ قَبلَ الوِهادِ",170,"د",1,0],["وأتى النهار على فتى أمسى بما","حمل النهار من الشؤون ملولا",171,"ل",2,0],["وأتت معوّلةً على جيفِ العدى","وحسبنَ سِلْمَكَ بالعجاج قتالا",172,"ل",2,0],["وأَتى العَطاءُ مُفَضضاً ومُذهباً","وأتى الثناءُ مسهّماً ومحبَّرا",173,"ر",2,0],["واتركِ الغادةَ لا تحفلْ بها","تُمْسِ في عزٍّ وتُرْفَعْ وتُجَلْ",174,"ل",1,0],["واتّقِ اللهَ فتقوى اللهِ ما","جاوزَتْ قلبَ امرئٍ إلاّ وصلْ",174,"ل",1,0],["واتركِ الدنيا فمِنْ عاداتِها","تخفضُ العالي وتعلي مَنْ سَفلْ",174,"ل",1,0],["وأتركُ لينَ ملبوسي","إلى الترقيعِ في قُمْصي",175,"ص",2,0],["وَأَتانا وَهوَ مُنخَرِقٌ","وَبِغالُ الحَيِّ لَم تُرحَل",176,"ل",1,0],["وَأَتيتَ الَّذي أَتَيتَ بِعَمدٍ","لَم تَهَبنا لِذاكَ ثُمَّ ظَلَمتا",177,"ت",2,0],["وَأَتَتها طَبَّةٌ مُحتالَةٌ","تَمزُجُ الجِدَّ مِراراً بِاللَعِب",178,"ب",1,0],["وَأَتَتكَ تُسفِرُ عَن وُجوهٍ طَلقَةٍ","وَتَنوبُ مِن لُطفٍ عَن السُفَراءِ",179,"ر",3,0],["وَأُتبِعُ طيبَ الذِكرِ أَنَّةُ موجَعٍ","فَيَنفَحُ هَذا حَيثُ هاتيكَ تَلفَحُ",180,"ح",1,0],["واتَّخِذْها يا ابنَ محمودٍ لها","سُنَناً بِيضاً وآداباً سِماحا",181,"ح",2,0],["وأتى يَقولُ لها دَعيهِ مُضيَّعاً","فلأنتِ في سَعَةٍ وغبطةِ حالِ",182,"ل",1,0],["وَأَتى القَميصُ فَعادَ مِن بَعدِ العَمى","بَصَرٌ لَهُ حَيُّ الضِياءِ حَديدُ",183,"د",1,0],["وَاتْبَعِ الحقَّ فهذا حُكمُهُ","جاء في القُرآنِ كيما تَتبَعَهْ",184,"ع",2,0],["وأتى النجَاشيَّ الكتابُ فلم يكن","مِمّن يَصُدُّ عنِ الصَّوابِ ويَصدِفُ",185,"ف",1,0],["وأتى اليمامةَ بالكتابِ رَسُولُها","فكذاكَ يَهذِي الطّامِحُ المتعَجْرِفُ",185,"ف",1,0],["وأتى قَوْمَهُ يظنُّ بهم خي","راً فمالوا عن السّبيلِ وصَدُّوا",186,"د",3,0],["وأتوا مُذعِنينَ يبغونَ صُلحاً","يَدفعُ الويلَ والخطوبَ الشِّدادا",187,"د",2,0],["وأتى الرّماةُ فجال في أحشائهم","سَهمٌ تظلُّ به السهامُ تُحطَّم",188,"م",1,0],["وأتى قريشاً في مَخِيلَةِ ناصحٍ","يُبدِي الهَوى ويُذيعُ سِرّاً خافيا",189,"ي",2,0],["وأتى حُذيفة في مَدارِع غَيْهَبٍ","ألْقَى على الدنيا حِجاباً ضافيا",189,"ي",2,0],["وأتى صفوانُ ما يبدو له","غيرُ شيءٍ ماثلٍ للنّاظرينْ",190,"ن",1,0],["وأتى ابنُه فدعا أبي أنا خصمه","فدعوه لي إنّي به لَمُكلَّف",191,"ف",1,0],["وأتى ابنُ الخطابِ يُؤمنُ بالَّ","هِ ويختارُ دِينَهُ المأثورا",192,"ر",2,0],["وأَتى بَعدهُ بُريدَةُ يرجو","أن يَنالَ الغِنَى وكان فقيرا",192,"ر",2,0],["وَأتَى لِمَجلِسِ حُكمهِ","وَعَلَيهِ أثَارُ الغُبَار",193,"ر",1,0],["وَأَتى نُطقُهُ بِلَحنٍ فَأَغنى","عَن سَماعِ الغِناءِ وَالتَلحينِ",194,"ن",1,0],["وَأَتوك يَبدون الوِداد وَكُلُهُم","يَزهو بِثَوب بِالخداع مبطن",195,"ن",1,0],["وَأَتاني اليَقينُ أَنّي إِذا مُت","تُ وَإِن رَمَّ أَعظُمي مَبعوتُ",196,"ت",1,0],["وَأَتَتني الأَنباءُ عَن مُلكِ داؤُ","دَ فَقَرَّت عَيني بِهِ وَرَضيتُ",196,"ت",1,0],["وَاِتَّصَلَت بِرَأيِهِ القَوِيِّ","ساقٍ كَغُصنِ الذَهَبِ المَجلِيِّ",197,"ي",1,0],["وَأَتانا أَيلولُ وَهوَ يُنادي","الصَبوحَ الصَبوحَ يا غافِلينا",198,"ن",2,0],["وَأَتبَعُ مِصباحَ اليَقينِ فَإِن بَدا","لِيَ الشَكُّ في شَيءٍ يُريبُ تَناهَيتُ",199,"ت",1,0],["وَأَتَتْ قومَها بأفضلَ مما","حَمَلَتْ قبلُ مريمُ العذراءُ",200,"ا",2,0],["وَأَتَتْ جَدَّهُ وقد فَصَلَتْهُ","وبِهَا مِنْ فِصَالِهِ البُرَحَاءُ",200,"ا",2,0],["وأتاها أن الغمامةَ والسر","حَ أَظَلَّتْهُ منهما أفياءُ",200,"ا",2,0],["وأتاهُ في بيتها جَبْرَئيلٌ","ولِذي اللُّبِّ في الأُمورِ ارْتياءُ",200,"ا",2,0],["وَأتى السَّبيُ فيه أُختُ رَضَاعٍ","وَضَعَ الكُفْرُ قَدْرَهَا وَالسِّبَاءُ",200,"ا",2,0],["وأتى الناسُ يَشْتَكُونَ أذاها","وَرَخَاءٌ يُؤْذِي الأنام غلاءُ",200,"ا",2,0],["وَأَتَيْنا إليكَ أَنْضاءَ فَقْرٍ","حَمَلَتْنا إلى الغِنَى أَنْضاءُ",200,"ا",2,0],["وأتَى عَليٌّ في العُلا يَتْلُوهم","فاختِمْ به سُوَرَ العُلا والسُّؤْدُدِ",201,"د",1,0],["وأتى عليها جُودُه فكأَنّها","لهَوانِهَا في نفسه لم تُوجَدِ",202,"د",1,0],["وأَتَوْا كلُّهُمْ بِقَلْبٍ سَلِيمٍ","وأَتَى غيرُهمْ بِثَوْبٍ نَقيرِ",203,"ر",1,0],["وأَتَمَّ حَظِّي بَعْدَ نُقْصانٍ فَكَمْ","مِنْ عَائِدٍ لِي من نَدَاهُ ومِنْ صِلَهْ",204,"ل",2,0],["وَأَتاهُمْ بِكِتابٍ أُحْكِمَتْ","منه آياتٌ لقَوْمٍ يَعْقِلونا",205,"ن",2,0],["وأَتَتْ أَخْبارُهُ في حِكَمٍ","فَتَأملْها ثِماراً وَفُنُونا",205,"ن",2,0],["وأتَتْ تُجَرِّرُ في ذيولِ قصائدٍ","يكفيكَ عن سِحْرِ البَيان بيانها",206,"ن",3,0],["وأتتْ على عهدِ التّبابعِ مُدّةً","غَضّاً على مَرّ الزّمانِ زمانها",206,"ن",3,0],["وأتَتْ تُزَجّي رِدْفَها بقَوامِها","فتأطَّرَ الأعلى وماجَ الأسْفَلُ",207,"ل",1,0],["وأتَبعُ لْهوي خالعاً ويُطيعُني","شبابٌ رطيبٌ غُصْنُهُ وجنىً يَنْع",208,"ع",1,0],["وَاِترُكَن مَن لامَ فيها","وَأَبى إِلّا نِفارا",209,"ر",2,0],["وَاِتَّخِذِ الفَتكَ إِماماً وَلا","تَبنِ بِنىً إِلّا بآساسِ",210,"س",1,0],["وَأَتاني مَسيرُ سَلمٍ عَنِ النا","سِ أَميراً فَقُلتُ خَيرُ أَميرِ",211,"ر",1,0],["وَاِترُكا لي مِن أَمرِهِ كُلَّ يَومٍ","بِاِقتِصادٍ لَيسَ الهَوى بِاِقتِصادِ",212,"د",1,0],["وَأَتبَعتُ المُنى بِنَجادِ لَيتٍ","وَما يُغني عَنِ الطَّرَباتِ لَيتُ",213,"ت",1,0],["وَأَتوبُ مِمّا تَكرَهينَ لِتَقبَلي","وَاللَهُ يَقبَلُ حُسنَ فِعلِ التائِبِ",214,"ب",1,0],["وَأَتوبُ مِمّا تَعلَمي","نَ كَما يَتوبُ المُذنِبُ",215,"ب",1,0],["وَأَتَت عَلى الأَكوارِ جَمعِ الكَور وَال","كَورِ المُسَرَّحِ هَذِهِ الأَكوارُ",216,"ر",1,0],["وَاِتِّهامِيَ بِالمالِ كَلَّفَ أَن يُط","لَبَ مِنّي ما يَقتَضي التَمويلُ",217,"ل",1,0],["واتْلُوَا النّعْشَ بالقِراءَةِ والتّسْ","بِيحِ لا بالنّحيبِ والتّعْدادِ",218,"د",1,0],["وَأَتلَعُ نَهّاضٌ إِذا صَعَّدَت بِهِ","كَسُكّانِ بوصيٍّ بِدِجلَةَ مُصعِدِ",219,"د",1,0],["وَاِترُكي صِرمَةً عَلى آلِ زَيدٍ","بِالقُطَيباتِ كُنَّ أَو أَورالِ",220,"ل",1,0],["وأَتيتَ آخِرَهُم وشأوُكَ فائتٌ","للآخِرين ومُدرِكٌ للأوَّلِ",221,"ل",1,0],["وأتى آخرٌ بخارقة يه","لكُ في مرة بها جمهور",222,"ر",1,0],["وأتوا ينبشون قبراً حواني","بعد موتي وأوسعوني سبابا",223,"ب",2,0],["وأتى الليلُ ومن أهوالهِ","أن تُرَي بين ظلامٍ وقيود",224,"د",1,0],["وأتَتكَ بالذِّكر الخوالِدِ طاقةً","كأجَلِّ ما جمعَ المحبُّ وهادى",225,"د",2,0],["وأتى النهارُ وسار فيه طارقٌ","يبني لِمُلكِ الشرق أيَّ بناءِ",226,"ا",2,0],["وأتى المنتمي لأمة عثما","ن عليٌّ: من يعرف الأحياء",227,"ا",2,0],["واتُخِذَ المشاغبون آلة","وقيل عثمان يخصّ آله",228,"ه",1,0],["واتخذوا كل القرى أوطانا","وحاسنوا الأهلين والقطانا",229,"ن",2,0],["واتفقوا في الحب والتجله","على اختلاف مذهب ومله",230,"ه",1,0],["وأَتاكَ بالنَّيْرُوزِ شَوْقٌ حافِزٌ","وتَطَلُّعٌ للزَّوْر غِبَّ تَطلعِ",231,"ع",1,1],["وَأَتبَعُ لَيلى حَيثُ سارَت وَوَدَّعَت","وَما الناسُ إِلّا آلِفٌ وَمُوَدِّعُ",232,"ع",1,0],["وَأَترُكُ كُلَّ نائِحَةٍ تُنادي","عَلَيهِم بِالتَفَرُّقِ وَالشَتاتِ",233,"ت",1,0],["وَاتْرُكِ الْحِرْصَ تَعِشْ فِي رَاحَةٍ","قَلَّمَا نَالَ مُنَاهُ مَنْ حَرَصْ",234,"ص",1,0],["وَأَتَتْ بَعْدَهُمْ عَليَّ لَيَالٍ","لا أَرَى في سَمائِهَا مِصَباحَا",235,"ح",2,0],["وَاِترُك مَآثِرَ قَومٍ في بُيوتِهِمِ","وَاِفخَر بِمَكرَمَةٍ في بَيتِ مَخزومِ",236,"م",1,0],["وَأتى مَا لَمْ يَكَدْ يَطْمَ","عُ قِدْماً فِيهِ وَهَمُ",237,"م",1,0],["وَأَتَيْتَ الإِصْلاَحَ مِنْ حَيْثُ يُؤْتَى","فِي الأُمُورِ الجِسَامِ أَوْ في الدِّقَاقَ",238,"ق",1,0],["وَأَتَى عَجَائِبَ فِي بَدِيع دِفَاعِهِ","لَمْ يَأْتِهنَّ أَوَاخِرٌ وَأَوَالِي",239,"ل",2,0],["وأَتى حَافِظٌ فَكَان لِكُلٍّ","قِسْطَهُ فِي افْتِتِاحِ هَذَا العصرِ",240,"ر",1,0],["وَأَتَمَّ الأُنْسَ داعُونَ دَعَوْا","لِلجَوَادِ الشَّيْخِ أَجْلِلْ بِكَ مُهْرَا",241,"ر",2,0],["وَأَتَتْ عَبْقَرِيَّةُ النَّقْشِ وَالرَّقْ","شِ ضُرُوباً مِنْ فِطْنَةٍ وَاجْتِهَادِ",242,"د",1,0],["وَأَتَمَّ النَّعْمَاءَ أَنْ كَانَ فِيهِ","مِثْلَ حَظِّ السَّرَاةِ حَظُّ السَّوَادِ",242,"د",1,0],["واتفق القول فأجررتها","فآل من عسر إلى يسر",243,"ر",1,0],["وَأَتَى المَنِيَّةَ مُعَلِماً في أُسْرَةٍ","نَصَرُوا النبيَّ ومِنْهُمُ المسْتَشْهِدُ",244,"د",1,0],["وأتى الدنيا فرقت طربا","وانتشت من عبقه المنسكب",245,"ب",1,0],["واتصال بأمير","ووزير ذي سماح",246,"ح",1,0],["واتجهنا نحو عابدين التي","أصبحتْ ثالثةً للقبلتينْ",247,"ن",1,0],["وأَتْوا مِنَ الإِعْجَازِ ما تَرَكَ النُّهَى","حَيْرَى فَلمْ تَمْلِكْ سِوَى إِطْرَائه",248,"ا",3,0],["وأتَتْ كلُّ أُمّة ترتجِي مِصْرَ","وِدَاداً وتَنْهَلُ العلم وِرْدا",249,"د",2,0],["واتركوا هذه المعاولَ باللّ","هِ فإني أخشى على البنيان",250,"ن",1,0],["وأَتَتْ كَمَا يأْتِي الشبا","بُ مُبارَكَ النفَحَاتِ ناضِرْ",251,"ر",1,0],["وأتَى هَيْمانَ يشدو واثباً","ليته في يومه لم يثب",252,"ب",1,0],["وأَتَى بَعْدَهُ المجدِّدُ إسْمَا","عِيلُ ذُخرُ المُنَى ثِمَالُ الْجُودِ",253,"د",1,0],["وَأَتَتْ بِكُل جميلَة","مَا ذِي أَصَابِع ذِي أيادي",254,"ي",1,0],["وأتيتُ من سحرِ البيان بمعْجِزٍ","لم يَرْوِه الرَّاوُونَ من أعْرابه",255,"ب",2,0],["واتَّخذْنا حبَّ العروبةِ دينًا","يجمع المرسلين والأديانا",256,"ن",2,0],["وأتمُّ من أنوارها","نُورٌ يَشِعُّ من الأهالي؟",257,"ل",2,0],["وأتانا من الحوادث والأن","باء خطبٌ نعنى به ونساء",258,"ا",2,0],["وأتيناهم بتسعة أملا","كٍ كرامٍ أسلابهم أغلاء",258,"ا",2,0],["وأتوا خضم الماء يزخر مزجه","فشروا بإعدام الحياة وجودا",259,"د",2,0],["وأتت على إيوان كسرى رجة","هدت قواعده وكان مشيدا",259,"د",2,0],["وأتاحَ أندلُساً بحدِّ حسامِ","نصراً فأحيا الأرضَ بعد مَماتِها",260,"ت",3,0],["وآت ببحر المدح فيك لغاية","ترى دونها الأبصار حاسرة الطرف",261,"ف",1,0],["وأتيت رب الدير في محرابه","فبثثت إفلاسي إليه وحاج",262,"ج",1,0],["وأ،ت امرؤ نجّيتي من عظيمة","ٍ مخوفٍ تردَّيها شديدٍ وبالها",263,"ل",3,0],["وأتى الدنيا فقيرا فأتت","نحوه الدنيا وأعتطه الزّماما",264,"م",2,0],["وأتاك بالنيروز شوق حافر","وتطلع للزور غب تطلع",265,"ع",1,1],["واتى الكونَ \" ضيفهُ \" بدويَّ الرعد","يلقاه لا بسجع الحمائِم",266,"م",1,0],["وأتى على عفوٍ فصحَّ نسيجُه","بعضٌ وبعضٌ بالتكلف أمرَضا",267,"ض",2,0],["وأتى الصيفُ فاستفاضت شَِعابٌ","غمرتها الرّبى بماءٍ مَريع",268,"ع",1,0],["وأتى زَمانٌ من مكارِمِ أهلِه","السَجْنُ ، والتشريدُ ، والإِعدام",269,"م",1,0],["وأتتْ في غَيابةِ \" الشَّفَقِ \"الأحمرِ","ما تشتهي مِنَ الألعاب",270,"ب",1,0],["وأتَيْنا من بعدِ ألْفٍ نغني","النفسَ في وصف أكلِهِمْ للثَّريد",271,"د",1,0],["وأتَى العِيدُ في دُجُونٍ تَتَبّعْ","نَ غَلِيلَ البَطْحَاءِ حَتّى استَبَلاَ",272,"ل",2,0],["وَأتَى بأبْياتٍ لَهُ مَسْرُوقَةٍ،","شَتّى النِّجَارِ، وَنِسْبَةٍ أقوَافِ",273,"ف",1,0],["وَأترُكُ للسُّرَى مَن كنتُ أخشَى","عَلَيْهِ العَينَ تُؤمَنُ، أوْ تُرِيبُ",274,"ب",1,0],["وأتى العطاء مفضضاً ومذهباً","وأتى الثناء مسهماً ومحيرا",275,"ر",2,0],["وأتى ذويه نعيه فتألّبوا","والغيد تعول أيّما إعوال",276,"ل",1,0],["وَأَتَوْا نِسَاءَهُمُ بِنِيبٍ لَمْ يَدَعْ","سُوءُ الْمَحَابِسِ تَحْتَهُنَّ فَصِيلاَ",277,"ل",2,0],["وأتاهمُ يحيى فشدَّ عليهمُ","عَقْداً يَرَاهُ الْمُسْلِمُونِ ثَقِيلاَ",277,"ل",2,0],["وأتبعهمُ فيلقاً كالسرا","بِ، جاواءَ، تتبعُ شخباً، ثعولا",278,"ل",2,0],["وأترك خلفى ناقتى وعباءتى","وأمشى .. أنا فى رَقْبة الشمس خِنجرُ",279,"ر",1,0],["وأتاني اليقينُ أني إذا متُّ","مِتُّ أوْ رَمَّ أعْظُمِي مَبْعُوتُ",280,"ت",1,0],["وأتَتْنِي الأنْباءُ عن مُلْكِ دَاوُ","فقرتْ عيني بهِ ورضيتُ",280,"ت",1,0],["وأتت بعدها من الغيب أخرى","يقتفي إثرَها الجمال جنيبا",281,"ب",2,0],["وأتى الظلامُ دُجنة فدجنة","يُرخي سدولاً جمة فسدولا",282,"ل",2,0],["وَأتى يَدُقُّ- كما تَعَوَّدَ- بابَنا","سَيَدُقُّ بابَ السِّجْنِ جَلاَّدانِ",283,"ن",1,0]]}