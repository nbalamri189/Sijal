{"poems":[[83,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[51,"قلت لقوم سادة قادة","https://www.aldiwan.net/poem62869.html","السريع"],[51,"قد ذقت أنواع الطعوم فلم أجد","https://www.aldiwan.net/poem66731.html","البسيط"],[89,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[56,"مولاتنا يا غلام مبتكره","https://www.aldiwan.net/poem58590.html","المنسرح"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[66,"غيري بحبل سواكم يتمسك","https://www.aldiwan.net/poem40111.html","الكامل"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[44,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[31,"هل عند رسم برامة خبر","https://www.aldiwan.net/poem42526.html","المنسرح"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[48,"لولا حذاري من جنان","https://www.aldiwan.net/poem66095.html","مجزوء الكامل"],[50,"غمض الحديد بصاحبيك فغمضا","https://www.aldiwan.net/poem62354.html","الكامل"],[50,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[50,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[46,"أطعت في الأيام سداجي","https://www.aldiwan.net/poem22269.html","السريع"],[46,"أجزاء دهر ينقضين ولم يكن","https://www.aldiwan.net/poem22576.html","الكامل"],[46,"أف لدنيانا وأحزانها","https://www.aldiwan.net/poem23533.html","السريع"],[46,"لم يبق في العالمين من ذهب","https://www.aldiwan.net/poem23566.html","المنسرح"],[1,"يا لك من قبرة بمعمر","https://www.aldiwan.net/poem33996.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39677","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[31,"هَلْ عِنْدَ رَسْمٍ بَرَامَة ٍ خَبَرُ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18875&r=&rc=138",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""],[115,"محجوبة عن ناظري","https://www.aldiwan.net/poem41509.html","مجزوء الرجز"],[115,"لطف طباع الحبيب أوهى","https://www.aldiwan.net/poem41517.html","مخلع البسيط"],[115,"في حالة البعد روحي كنت أرسلها","https://www.aldiwan.net/poem41996.html","البسيط"],[120,"قد ذهب الحول بالربيع وبالصحو","https://www.aldiwan.net/poem49287.html","المنسرح"],[150,"أهلا بغرتك السعيده","https://www.aldiwan.net/poem68462.html","مجزوء الكامل"],[160,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[160,"في الصلح راسل دهر راح غضبانا","https://www.aldiwan.net/poem59080.html","البسيط"],[160,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[185,"لله وافر كمثرى ذكرت به","https://www.aldiwan.net/poem14622.html","البسيط"],[186,"قد ذقت طعم المر والصبر","https://www.aldiwan.net/poem43848.html","السريع"],[204,"عبدك أمرضته فعده","https://www.aldiwan.net/poem53330.html","مخلع البسيط"],[235,"واعجبي وحادث الد","https://www.aldiwan.net/poem32166.html","مجزوء الرجز"],[290,"يا ليالينا بوادي السلط قد","https://www.aldiwan.net/poem11711.html","الرمل"],[303,"يا درة أودعتها في الثرى","https://www.aldiwan.net/poem57680.html","السريع"],[303,"قد ذاب تبر البرق في جو السما","https://www.aldiwan.net/poem57816.html","البسيط"],[366,"قد ذكرنا عهودكم بعد ما طالت","https://www.aldiwan.net/poem17880.html","الخفيف"],[380,"ملكت قلبي ولم أملكه يا سكني","https://www.aldiwan.net/poem48816.html","البسيط"],[380,"قد ذبت من ألم الجوى","https://www.aldiwan.net/poem49226.html","مجزوء الكامل"],[405,"إن الذي مر بنا مسرعا","https://www.aldiwan.net/poem49907.html","السريع"],[416,"قد ذكرناكم على بعد المزار","https://www.aldiwan.net/poem53843.html","الرمل"],[416,"جسد أشبه شيء بالخيال","https://www.aldiwan.net/poem53953.html","الطويل"],[416,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[416,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[416,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[416,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[453,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[500,"قلبي منكم خائف خافق","https://www.aldiwan.net/poem37656.html","السريع"],[513,"يا مت قبلك طال الحزن والأسف","https://www.aldiwan.net/poem67724.html","البسيط"],[515,"قل للمنية شوى","https://www.aldiwan.net/poem12003.html","مجزوء الكامل"],[551,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[558,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[562,"ولى سليم نحو عيسى جده","https://www.aldiwan.net/poem52530.html","البسيط"],[562,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[575,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[575,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"]],"verses":[["قد ذهَبتْ منها العشايا ضعف ما","قد فضَّضَتْ منها المحاسن في السحرْ",0,"ر",1,0],["قد ذُكِّرتْ هذي وقد أُنِّثتْ","هاتيك والتظفير تظفيرها",1,"ر",3,0],["قد ذقتُ أنواعَ الطعوم فلم أجدْ","فيهنَّ طعماً مثل طعم العافيهْ",2,"ف",3,1],["قد ذاق حلو العيش فيه ومره","والمر مثل الحلو للمتعود",3,"د",1,0],["قَدْ ذكرَ الناسُ عن قِيامِهِمُ","ذِكْرَى بِعَقْلي أَصْبَحتْ نَكرَهْ",4,"ر",2,0],["قَد ذُقتُ شِدَّةَ أَيّامي وَلَذَّتَها","فَما حَصَلتُ عَلى صابٍ وَلا عَسَلِ",5,"ل",1,0],["قَد ذَمَمنا مِن دَهرِنا ما حَمِدنا","وَسَخِطنا مِن عَيشِنا ما رَضينا",6,"ن",2,0],["قَد ذُقتُ حُبُّكُمُ فَأَصبَحَ مُهلِكِي","وَمِنَ المَطاعِمِ ما يُذاقُ فَيُهلِكُ",7,"ك",1,0],["قَد ذَمَمنا بُعَيدَ بُعدِكُمُ العَي","شَ فَلَيتَ الحِمامَ كانَ قُبَيلا",8,"ل",2,0],["قَد ذابَ لي في يَدَيكَ ذَوبَ النا","مِ الجَعدِ حَكَّمتَ الرَضفَ في قَمَعِه",9,"ع",2,0],["قَد ذَلَّ شَيطانُ النِفاقِ وَأَخفَتَت","بيضُ السُيوفِ زَئيرَ أُسدِ الغابِ",10,"ب",1,0],["قَد ذَكَّرَتني الدِيارُ إِذ دَرَسَت","وَالشَوقُ مِمّا تَهيجُهُ الذِكَرُ",11,"ر",1,0],["قَد ذُدتِ قَلباً إِلَيكِ مَشرَعُهُ","حَرّانَ يَبغي إِلَيكُمُ السُبُلا",12,"ل",2,0],["قَد ذُدِشَت رِجلاهُ في آباطِهِ","وَخَرَمَ الأُذنَينِ بِاِنتِشاطِهِ",13,"ط",2,0],["قَد ذُبتُ غَيرَ حُشاشَةٍ","في النَفسِ تَحبِسُها الأَماني",14,"ي",1,0],["قَد ذُقتُ أُلفَتَهُ وَذُقتُ فِراقَهُ","فَوَجَدتُ ذا عَسَلاً وَذا جَمر الغَضا",15,"ض",2,0],["قَد ذَكَرتُ الهَوى فَرَقَّ فُؤادي","وَدَعَوتُ اِسمَها فَطارَ جَناحي",16,"ي",1,0],["قَد ذَهَبَت وَالعَيشُ لِلذَهابِ","لَمّا عَرَفناها عَلى الخَرابِ",17,"ب",1,0],["قَد ذُبِحَ الذارِعُ في ساحَةٍ","فَيا لَهُ مِن دَمِ أَوداجِ",18,"ج",1,0],["قَد ذَرَّ قَرنٌ ثُمَّ غابَ فَهَل لَهُ","مَعنىً أَجَل هُوَ لِلنُفوسِ بَوارُ",19,"ر",1,0],["قَد ذَهَبَت عَن ذَهَبٍ صامِتٍ","وَخَلَّفَتهُ عِندَ خُزّانِها",20,"ن",3,0],["قَد ذَهَبَت عادُهُم وَجُرهُمُها","وَهُم عَلى ما عَهِدتُ ما اِنتَبَهوا",21,"ه",3,0],["قَد ذَهَبَ الصَيّادُ عَنكِ فَاِبشِري","لا بُدَّ يَوماً أَن تُصادي فَاِصبِري",22,"ر",2,0],["قَد ذقتُ صاباً في حَيا","تي بالعراق وَذقتُ شهدا",23,"د",2,0],["قد ذبلت وانطلقت","في العاصفِ الشفيفِ",24,"ف",1,0],["قد ذهب العمرُ في جدالٍ","كنَّا لنيرانه وقودا",25,"د",2,0],["قد ذَكَّرَتْها أيادِيكَ التي عَظُمَتْ","مَنَازِلَ العِزِّ في دَاراتِ قَحْطان",26,"ن",1,0],["قد ذكَرَتْنا لياليكِ التي سَطَعَتْ","أفراحَ قَطْرِ النَّدَى والعزَّ والجاها",27,"ا",3,0],["قَدْ ذَكَّرَتْني الدِّيارُ إذْ دَرَسَتْ","وَکلْشَّوْقُ مِما تَهيجُهُ الذِّكَرُ",28,"ر",1,0],["قَدْ ذَبَحْنَا الأَطْفَالَ مِنْ آلِ بَكْرٍ","وَ قهرنا كماتهمْ بالنضالِ",29,"ل",1,0],["قد ذيلت جبينها ال","بدري بليل ساتر",30,"ر",1,0],["قد ذاب لطفاً فدبت لهفاً","كذا كلا الصاحبين ذائب",31,"ب",1,0],["قد ذبت حالاً في لقياك من شغف","فامدد يمينك كي تحظى بها شفتي",32,"ت",2,0],["قد ذهب الحول بالربيع وبالصحو","وجاء الشتاء مرهوبا",33,"ب",2,1],["قد ذاق حطمة عزمه","بدأت وسوف ترى معيده",34,"د",2,0],["قد ذُهلوا لما رأوا منك فلو","يضرب عنقُ بعضهم لم يشعرِ",35,"ر",1,0],["قد ذادني حب نفسي عن موارده","وربما كان حب النفس حرمانا",36,"ن",2,0],["قد ذم ربك قوما كان فعلهم","أخف من فعلكم من مشركي العرب",37,"ب",1,0],["قد ذقتُ من طعمه ما كادَ يَبْلُغ بي","ما ذقتُ من رَشْفِ محبوبٍ على وَجَل",38,"ل",1,0],["قد ذقت طعم المرّ والصبر","وقد لبست الفقر بالأسر",39,"ر",1,1],["قد ذاب لو فتَّشت عليه","يداك في الفرش لم تَجِدهُ",40,"ه",1,0],["قَد ذَهَبَت لَذَّةُ أَي","يامِ الشَبابِ المُذهَبِ",41,"ب",1,0],["قد ذكرناهم على شحط النوى","وحفظناهُم وإن كانوا نسوّنا",42,"ن",2,0],["قد ذاب قلبي فجرى أدمعاً","يغسل من جفني بقايا الكرى",43,"ر",2,0],["قد ذاب تبر البرق في جو السما","وتخلفت عن قطرها الأنواء",44,"ا",2,1],["قَد ذَكَرنا عُهودَكُم بَعدَ ما طا","لَت لَيالٍ مِن بَعدِها وَشُهورُ",45,"ر",1,1],["قَد ذُبت حَتّى قَميصي صارَ يُثقِلُني","وَصارَ يُنكِرُني مَن كانَ يَعرِفُني",46,"ي",1,0],["قَد ذِبتُ مِن أَلَم الجَوى","فَاِستَبقِ بِعضكَ يا فُؤاد",47,"د",1,1],["قد ذُبْتُ من حُبِّكَ حتَّى لقد","خَشِيتُ أنْ أخفى على الناسِ",48,"س",1,0],["قد ذكرناكُم على بُعد المزار","فانتَشينا بمُدام الادّكار",49,"ر",1,1],["قد ذكرنا عهدكم من بعدكم","فتعلَّلْنا بأَنفاس الشّمال",50,"ل",1,0],["قد ذكرنا عهدَكم من بعدكم","فتحرَّقْنا بكاءً وعويلا",51,"ل",2,0],["قد ذكرناكم على شحط النوى","فانثنينا عند ذاك الذكر ميلا",52,"ل",2,0],["قد ذكرنا عهدكم من بعدكم","هل ذكرتم بعدنا للودّ عهدا",53,"د",2,0],["قد ذكرنا بها العصور الخوالي","عهد هندٍ ودار سعدى وسلمى",54,"م",2,0],["قد ذاقَ من نفيي وشا","خَ ودبَّ في نفىٍ دبيبي",55,"ب",2,0],["قد ذكرتكم باطلاً عُصبةٌ","وإنما باطلهم زاهق",56,"ق",1,0],["قد ذلل الشوق قلبي فهو معترفٌ","أن التذلل في حكم الهوى شرف",57,"ف",1,0],["قد ذاب لولا نطقه","ما كان مخلوقاً يرى",58,"ا",1,0],["قد ذَعْذَع الموتُ نُصّاري وحاميتي","وضعضع الموتُ أطوادى وأجبالي",59,"ي",1,0],["قد ذكرناها لرؤيتنا","إنها تخفى على الجهال",60,"ل",1,0],["قد ذاقَ مِن كأسِ الخلاصِ كما اشتهَى","ماءَ الحياةَ مُنَعَّماً في شُربِهِ",61,"ب",2,0],["قد ذُقتَ حُلوَ الطيّبات ولم تَذُقْ","مُرَّ الخبائثِ في الزَّمانِ الأغبرِ",62,"ر",1,0],["قد ذقْتُ من نارِ المرا","شِفِ بَرْدَها وسَلامَهَا",63,"م",3,0],["قد ذقْتُ طعمَ الموتِ من بعده","ذلك مَا قَدْ كُنتُ مِنه أَحِيدْ",64,"د",1,0]]}