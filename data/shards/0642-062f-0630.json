{"poems":[[83,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[51,"قلت لقوم سادة قادة","https://www.aldiwan.net/poem62869.html","السريع"],[51,"قد ذقت أنواع الطعوم فلم أجد","https://www.aldiwan.net/poem66731.html","البسيط"],[89,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[56,"مولاتنا يا غلام مبتكره","https://www.aldiwan.net/poem58590.html","المنسرح"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[66,"غيري بحبل سواكم يتمسك","https://www.aldiwan.net/poem40111.html","الكامل"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[44,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[31,"هل عند رسم برامة خبر","https://www.aldiwan.net/poem42526.html","المنسرح"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[48,"لولا حذاري من جنان","https://www.aldiwan.net/poem66095.html","مجزوء الكامل"],[50,"غمض الحديد بصاحبيك فغمضا","https://www.aldiwan.net/poem62354.html","الكامل"],[50,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[50,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[46,"أطعت في الأيام سداجي","https://www.aldiwan.net/poem22269.html","السريع"],[46,"أجزاء دهر ينقضين ولم يكن","https://www.aldiwan.net/poem22576.html","الكامل"],[46,"أف لدنيانا وأحزانها","https://www.aldiwan.net/poem23533.html","السريع"],[46,"لم يبق في العالمين من ذهب","https://www.aldiwan.net/poem23566.html","المنسرح"],[1,"يا لك من قبرة بمعمر","https://www.aldiwan.net/poem33996.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39677","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[31,"هَلْ عِنْدَ رَسْمٍ بَرَامَة ٍ خَبَرُ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18875&r=&rc=138",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["قد ذهَبتْ منها العشايا ضعف ما","قد فضَّضَتْ منها المحاسن في السحرْ",0,"ر",1,0],["قد ذُكِّرتْ هذي وقد أُنِّثتْ","هاتيك والتظفير تظفيرها",1,"ر",3,0],["قد ذقتُ أنواعَ الطعوم فلم أجدْ","فيهنَّ طعماً مثل طعم العافيهْ",2,"ف",3,1],["قد ذاق حلو العيش فيه ومره","والمر مثل الحلو للمتعود",3,"د",1,0],["قَدْ ذكرَ الناسُ عن قِيامِهِمُ","ذِكْرَى بِعَقْلي أَصْبَحتْ نَكرَهْ",4,"ر",2,0],["قَد ذُقتُ شِدَّةَ أَيّامي وَلَذَّتَها","فَما حَصَلتُ عَلى صابٍ وَلا عَسَلِ",5,"ل",1,0],["قَد ذَمَمنا مِن دَهرِنا ما حَمِدنا","وَسَخِطنا مِن عَيشِنا ما رَضينا",6,"ن",2,0],["قَد ذُقتُ حُبُّكُمُ فَأَصبَحَ مُهلِكِي","وَمِنَ المَطاعِمِ ما يُذاقُ فَيُهلِكُ",7,"ك",1,0],["قَد ذَمَمنا بُعَيدَ بُعدِكُمُ العَي","شَ فَلَيتَ الحِمامَ كانَ قُبَيلا",8,"ل",2,0],["قَد ذابَ لي في يَدَيكَ ذَوبَ النا","مِ الجَعدِ حَكَّمتَ الرَضفَ في قَمَعِه",9,"ع",2,0],["قَد ذَلَّ شَيطانُ النِفاقِ وَأَخفَتَت","بيضُ السُيوفِ زَئيرَ أُسدِ الغابِ",10,"ب",1,0],["قَد ذَكَّرَتني الدِيارُ إِذ دَرَسَت","وَالشَوقُ مِمّا تَهيجُهُ الذِكَرُ",11,"ر",1,0],["قَد ذُدتِ قَلباً إِلَيكِ مَشرَعُهُ","حَرّانَ يَبغي إِلَيكُمُ السُبُلا",12,"ل",2,0],["قَد ذُدِشَت رِجلاهُ في آباطِهِ","وَخَرَمَ الأُذنَينِ بِاِنتِشاطِهِ",13,"ط",2,0],["قَد ذُبتُ غَيرَ حُشاشَةٍ","في النَفسِ تَحبِسُها الأَماني",14,"ي",1,0],["قَد ذُقتُ أُلفَتَهُ وَذُقتُ فِراقَهُ","فَوَجَدتُ ذا عَسَلاً وَذا جَمر الغَضا",15,"ض",2,0],["قَد ذَكَرتُ الهَوى فَرَقَّ فُؤادي","وَدَعَوتُ اِسمَها فَطارَ جَناحي",16,"ي",1,0],["قَد ذَهَبَت وَالعَيشُ لِلذَهابِ","لَمّا عَرَفناها عَلى الخَرابِ",17,"ب",1,0],["قَد ذُبِحَ الذارِعُ في ساحَةٍ","فَيا لَهُ مِن دَمِ أَوداجِ",18,"ج",1,0],["قَد ذَرَّ قَرنٌ ثُمَّ غابَ فَهَل لَهُ","مَعنىً أَجَل هُوَ لِلنُفوسِ بَوارُ",19,"ر",1,0],["قَد ذَهَبَت عَن ذَهَبٍ صامِتٍ","وَخَلَّفَتهُ عِندَ خُزّانِها",20,"ن",3,0],["قَد ذَهَبَت عادُهُم وَجُرهُمُها","وَهُم عَلى ما عَهِدتُ ما اِنتَبَهوا",21,"ه",3,0],["قَد ذَهَبَ الصَيّادُ عَنكِ فَاِبشِري","لا بُدَّ يَوماً أَن تُصادي فَاِصبِري",22,"ر",2,0],["قَد ذقتُ صاباً في حَيا","تي بالعراق وَذقتُ شهدا",23,"د",2,0],["قد ذبلت وانطلقت","في العاصفِ الشفيفِ",24,"ف",1,0],["قد ذهب العمرُ في جدالٍ","كنَّا لنيرانه وقودا",25,"د",2,0],["قد ذَكَّرَتْها أيادِيكَ التي عَظُمَتْ","مَنَازِلَ العِزِّ في دَاراتِ قَحْطان",26,"ن",1,0],["قد ذكَرَتْنا لياليكِ التي سَطَعَتْ","أفراحَ قَطْرِ النَّدَى والعزَّ والجاها",27,"ا",3,0],["قَدْ ذَكَّرَتْني الدِّيارُ إذْ دَرَسَتْ","وَکلْشَّوْقُ مِما تَهيجُهُ الذِّكَرُ",28,"ر",1,0],["قَدْ ذَبَحْنَا الأَطْفَالَ مِنْ آلِ بَكْرٍ","وَ قهرنا كماتهمْ بالنضالِ",29,"ل",1,0]]}