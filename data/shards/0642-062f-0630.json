",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5957,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=27046",""],[5989,"حلمٌ كاذب","https://www.poetsgate.com/ViewPoem.aspx?id=182772",""],[6019,"فَضَحَ الهَوَى سِرِّيْ ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53001",""],[6124,"سينية العشق","https://www.poetsgate.com/ViewPoem.aspx?id=128751",""],[6124,"ذكرت العطر","https://www.poetsgate.com/ViewPoem.aspx?id=174747",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""]],"verses":[["قد ذهَبتْ منها العشايا ضعف ما","قد فضَّضَتْ منها المحاسن في السحرْ",0,"ر",1,0],["قد ذُكِّرتْ هذي وقد أُنِّثتْ","هاتيك والتظفير تظفيرها",1,"ر",3,0],["قد ذقتُ أنواعَ الطعوم فلم أجدْ","فيهنَّ طعماً مثل طعم العافيهْ",2,"ف",3,1],["قد ذاق حلو العيش فيه ومره","والمر مثل الحلو للمتعود",3,"د",1,0],["قَدْ ذكرَ الناسُ عن قِيامِهِمُ","ذِكْرَى بِعَقْلي أَصْبَحتْ نَكرَهْ",4,"ر",2,0],["قَد ذُقتُ شِدَّةَ أَيّامي وَلَذَّتَها","فَما حَصَلتُ عَلى صابٍ وَلا عَسَلِ",5,"ل",1,0],["قَد ذَمَمنا مِن دَهرِنا ما حَمِدنا","وَسَخِطنا مِن عَيشِنا ما رَضينا",6,"ن",2,0],["قَد ذُقتُ حُبُّكُمُ فَأَصبَحَ مُهلِكِي","وَمِنَ المَطاعِمِ ما يُذاقُ فَيُهلِكُ",7,"ك",1,0],["قَد ذَمَمنا بُعَيدَ بُعدِكُمُ العَي","شَ فَلَيتَ الحِمامَ كانَ قُبَيلا",8,"ل",2,0],["قَد ذَبَحنا الأَطفالَ مِن آلِ بَكرٍ","وَقَهَرنا كُماتَهُم بِالنِضالِ",9,"ل",1,0],["قَد ذابَ لي في يَدَيكَ ذَوبَ النا","مِ الجَعدِ حَكَّمتَ الرَضفَ في قَمَعِه",10,"ع",2,0],["قَد ذَلَّ شَيطانُ النِفاقِ وَأَخفَتَت","بيضُ السُيوفِ زَئيرَ أُسدِ الغابِ",11,"ب",1,0],["قَد ذَكَّرَتني الدِيارُ إِذ دَرَسَت","وَالشَوقُ مِمّا تَهيجُهُ الذِكَرُ",12,"ر",1,0],["قَد ذُدتِ قَلباً إِلَيكِ مَشرَعُهُ","حَرّانَ يَبغي إِلَيكُمُ السُبُلا",13,"ل",2,0],["قَد ذُدِشَت رِجلاهُ في آباطِهِ","وَخَرَمَ الأُذنَينِ بِاِنتِشاطِهِ",14,"ط",2,0],["قَد ذُبتُ غَيرَ حُشاشَةٍ","في النَفسِ تَحبِسُها الأَماني",15,"ن",2,0],["قَد ذُقتُ أُلفَتَهُ وَذُقتُ فِراقَهُ","فَوَجَدتُ ذا عَسَلاً وَذا جَمر الغَضا",16,"ض",2,0],["قَد ذَكَرتُ الهَوى فَرَقَّ فُؤادي","وَدَعَوتُ اِسمَها فَطارَ جَناحي",17,"ح",2,0],["قَد ذَهَبَت وَالعَيشُ لِلذَهابِ","لَمّا عَرَفناها عَلى الخَرابِ",18,"ب",1,0],["قَد ذُبِحَ الذارِعُ في ساحَةٍ","فَيا لَهُ مِن دَمِ أَوداجِ",19,"ج",1,0],["قَد ذَرَّ قَرنٌ ثُمَّ غابَ فَهَل لَهُ","مَعنىً أَجَل هُوَ لِلنُفوسِ بَوارُ",20,"ر",1,0],["قَد ذَهَبَت عَن ذَهَبٍ صامِتٍ","وَخَلَّفَتهُ عِندَ خُزّانِها",21,"ن",3,0],["قَد ذَهَبَت عادُهُم وَجُرهُمُها","وَهُم عَلى ما عَهِدتُ ما اِنتَبَهوا",22,"ه",3,0],["قَد ذَهَبَ الصَيّادُ عَنكِ فَاِبشِري","لا بُدَّ يَوماً أَن تُصادي فَاِصبِري",23,"ر",2,0],["قَد ذقتُ صاباً في حَيا","تي بالعراق وَذقتُ شهدا",24,"د",2,0],["قد ذبلت وانطلقت","في العاصفِ الشفيفِ",25,"ف",1,0],["قد ذهب العمرُ في جدالٍ","كنَّا لنيرانه وقودا",26,"د",2,0],["قد ذَكَّرَتْها أيادِيكَ التي عَظُمَتْ","مَنَازِلَ العِزِّ في دَاراتِ قَحْطان",27,"ن",1,0],["قد ذكَرَتْنا لياليكِ التي سَطَعَتْ","أفراحَ قَطْرِ النَّدَى والعزَّ والجاها",28,"ا",3,0],["قد ذبح الملك وهذا دمه","ومدية الذابح في نحر الهدى",29,"ا",1,0],["قَدْ ذَكَّرَتْني الدِّيارُ إذْ دَرَسَتْ","وَکلْشَّوْقُ مِما تَهيجُهُ الذِّكَرُ",30,"ر",1,0],["قد ذيلت جبينها ال","بدري بليل ساتر",31,"ر",1,0],["قد ذاب لطفاً فدبت لهفاً","كذا كلا الصاحبين ذائب",32,"ب",1,0],["قد ذبت حالاً في لقياك من شغف","فامدد يمينك كي تحظى بها شفتي",33,"ت",2,0],["قد ذهب الحول بالربيع وبالصحو","وجاء الشتاء مرهوبا",34,"ب",2,1],["قد ذاق حطمة عزمه","بدأت وسوف ترى معيده",35,"د",2,0],["قد ذُهلوا لما رأوا منك فلو","يضرب عنقُ بعضهم لم يشعرِ",36,"ر",1,0],["قد ذادني حب نفسي عن موارده","وربما كان حب النفس حرمانا",37,"ن",2,0],["قد ذم ربك قوما كان فعلهم","أخف من فعلكم من مشركي العرب",38,"ب",1,0],["قد ذقتُ من طعمه ما كادَ يَبْلُغ بي","ما ذقتُ من رَشْفِ محبوبٍ على وَجَل",39,"ل",1,0],["قد ذقت طعم المرّ والصبر","وقد لبست الفقر بالأسر",40,"ر",1,1],["قد ذاب لو فتَّشت عليه","يداك في الفرش لم تَجِدهُ",41,"ه",1,0],["قَد ذَهَبَت لَذَّةُ أَي","يامِ الشَبابِ المُذهَبِ",42,"ب",1,0],["قد ذكرناهم على شحط النوى","وحفظناهُم وإن كانوا نسوّنا",43,"ن",2,0],["قد ذاب قلبي فجرى أدمعاً","يغسل من جفني بقايا الكرى",44,"ر",2,0],["