{"poems":[[36,"قد قلت للقلب لا لبناك فاعترف","https://www.aldiwan.net/poem4917.html","البسيط"],[87,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[87,"نحن الكشافة في الوادي","https://www.aldiwan.net/poem7926.html","المتدارك"],[107,"سر يا أسامة ما لجيشك هازم","https://www.aldiwan.net/poem43570.html","الكامل"],[107,"وضح اليقين لمن يرى أو يسمع","https://www.aldiwan.net/poem44221.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[92,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[107,"يا رب أصبحنا نخاف العاديا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54943&r=&rc=113",""],[119,"هز منها النسيم خصراً رفيعاً","https://www.aldiwan.net/poem41758.html","الخفيف"],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[228,"قوني يا مقسم الأعباء","https://www.aldiwan.net/poem39725.html","الخفيف"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[382,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[563,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126874","الرمل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126739","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123090","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123091","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84537","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83214","المتدارك"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108257","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125930","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70150","الكامل"],[4767,"أملي","https://www.poetsgate.com/ViewPoem.aspx?id=178880",""],[4906,"يهنيكِ يا بلدةَ المختارِ من مُضَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=173613",""],[5057,"هيئت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=197242",""],[5136,"نم دمعي ولي لسان صموت","https://www.poetsgate.com/ViewPoem.aspx?id=121533",""],[5189,"تبدو العروبةُ","https://www.poetsgate.com/ViewPoem.aspx?id=195164",""],[5338,"أمة العرب قفي واستلهمي","https://www.poetsgate.com/ViewPoem.aspx?id=187618",""],[5356,"نبض","https://www.poetsgate.com/ViewPoem.aspx?id=205793",""],[5363,"اللهُ يا أللهُ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=199946",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5410,"الصبر من صبري اشتكى","https://www.poetsgate.com/ViewPoem.aspx?id=141974",""],[5411,"رَغْوَةُ البُنّ بالتَّكَهُّنِ تَهْذي","https://www.poetsgate.com/ViewPoem.aspx?id=199392",""],[5616,"سيف على لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=205036",""],[5703,"الإستغفار","https://www.poetsgate.com/ViewPoem.aspx?id=213866",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[5956,"كلنا للحب نركعْ","https://www.poetsgate.com/ViewPoem.aspx?id=184835",""],[5956,"اشفها يا ربنا لا تُشْقِها","https://www.poetsgate.com/ViewPoem.aspx?id=192142",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[6097,"أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=186068",""],[5309,"هيئ لنفسك ان تضيء قليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573807",""],[6202,"خواطر صائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86720&r=&rc=21",""],[2588,"شاخصة (هيئة الأمم)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65613&r=&rc=45",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""]],"verses":[["هَيٌّ يَمانونَ وَالبَطحاءُ مَنزِلُنا","هاذا لَعَمرُكِ شَملٌ غَيرُ مُؤتَلِفِ",0,"ف",1,0],["هيئوها لما يليق بمنف","وكريم الآثار والأطلال",1,"ل",1,0],["هيئوها لما أراد على","وتمنى على الظُّبى والعوالى",1,"ل",2,0],["هَيِّئ لَهُم وَلَنا رَشَدا","يا رَبِّ وَخُذ بِيَدِ الوَطَنِ",2,"ن",1,0],["هِيَ يا أخا الشّوقِ المبرِّحِ قُبْلَةً","ما ذَاقَ لذَّتَها مَشُوقٌ هائِمُ",3,"م",1,0],["هِيَ يا أبا لَهَبٍ كَتائِبُ رَبّهُ","نَزلتْ تُذِلُّ الكافرين وتقمعُ",4,"ع",1,0],["هيِّئي الكأس والوَتَرْ","تلك كومو مدى النظَرْ",5,"ر",1,1],["هيِّئ لنا نشءاً كما انصَبَّ الحيا","لُطفاً ، ونشءاَ كالزلازل راعدا",6,"د",2,0],["هيّئت في سريرتي لك ربّي","سدرة المنتهى وطاب النّزول",7,"ل",1,0],["هيئ لنا أمنا وعيشاً راضيا","ولا ترد اليوم منا داعيا",8,"ي",2,0],["هيئة ركبت بخالص حسن","فجلت هيكلاً عظيماً منيعا",9,"ع",2,0],["هيئ لنا الآراب بالسلامه","واحفظ مساعينا من الندامه",10,"ه",1,0],["هيَ يا رَبِّ فِلذَةٌ مِنكَ في الحُ","بِّ جَرَت مِن دُموعِكَ الخَضراءِ",11,"ا",2,0],["هِيَ يَثرِبٌ هِيَ طيبَةٌ هِيَ دارُهُ","حُظِيَت بِمَجدٍ شامِخِ البُنيانِ",12,"ن",1,0],["هي يوماً أرق حسناً ومعنىً","من معانٍ لها النُهى جلباب",13,"ب",1,0],["هيئوا الأكباد منكم","في غدٍ للحسرات",14,"ت",1,0],["هَيئاتُهُم زَيَّنَتها","هَيئاتُ عِزِّ الجَلالِ",15,"ل",1,0],["هيئة قد أُسّسَت غايتُها","لمواليد أبي الزهرا تعظّم",16,"م",1,1],["هيئة بالعسكري اِعتَصَمت","واِستعدّت لمُصابِ العسكري",17,"ي",1,1],["هيئي يا أماه مجلس أنسي","وأعدي الصبوح لي يا جواري",18,"ر",2,0],["هيّئ إذا رُمت أن تلقى الهوى جَلَدا","وأبَ المنام فبئس الحب آبيه",19,"ي",2,0],["هيئت رياحين العذراء سياجه","لأصداغه دبّنت عليه هوام",20,"م",1,0],["هَيىء لَهَا ثَمَنَاً تُبَاعُ بِمِثلِهِ","لاَ تُشتَرَى بِالزَّيفِ مِن أثمَانِ",21,"ن",1,0],["هيىء له المدح واستمسك به سبباً","واقصد له راحة قدما لثمناها",22,"ا",3,0],["هَيِّئ في النَجمِ مَكانَتَهُ","أَو لا هَيِّئ لَكَ مِن كَفَنِ",23,"ن",1,0],["هيىء قوامكَ للطعان فمهجتي","تشنِاق طعنة رمحه المتأوّد",24,"د",1,0],["هيئوا لي في باطن الأرض قبراً","ودعوني أنام تحت التراب",25,"ب",1,1],["هيي بنا حيث الضيوف نقري","وأجلستها طلقة الإيناس",26,"س",1,0],["هيئ مثانيكَ الحسان","واهتف باصوات النشيد",27,"د",1,0],["هيئ لهم ما سار طالبهم","للعلم فليركبْ له ذُلَلا",28,"ل",2,0],["هيِّئْ لنا سببًا في حلِّ عُقدتنا","وفصْمِ عروةِ هذا البؤسِ والضرر",29,"ر",1,0],["هيَّئتُ قلبي كي تُقيمي","وزرعتُ حبَُّكِ في صميمي",30,"م",2,1],["هي يا رب منيتي وعليم","أنت أني بحبها قد منيت",31,"ت",1,0],["هيَ يَقظةٌ في النفسِ تَجمعُ شملنا","لِنكونَ أسياداً على الميدانِ",32,"ن",1,0],["هيئةٌ قامت على الظُّلْمِ فهل","يُرتجى العَدْلُ وحِفْظُ الذّمَمِ؟",33,"م",1,0],["هي يا فتى كقصيدةٍ من خافقٍ","شِعرٌ وسجعٌ في الغرامِ أصيلُ",34,"ل",1,0],["هيّئْ ليَ الأعوانَ في سيري به","وأضئْ سبيلَ الحقِّ يا أللهُ",35,"ل",2,0],["هيئوا العدة وامشوا قدما","إن عهد الإنتداب انصرما",36,"م",2,1],["هيّئ لنا من أمرنا","رشداً فإنّ الشكر لك",37,"ك",1,0],["هَيْئَةُ التِّمْثالِ المُمَوَّهِ تَبْدُو","بَعْدَ بَحْثٍ كَهَيْئَةٍ وَثَنِيَّهْ",38,"ن",3,0],["هيَ يا \"أُمامُ\" حقيقةٌ وهي التي","في كلِّ يومٍ في المساجدِ تُولَدُ.",39,"د",1,0],["هيّىء لها الزاد فالأُخرى هي الدارُ","وَاستغفرِ الله إنّ اللهَ غَفّارُ",40,"ر",1,1],["هي يقظتي في غفوتي فاحسّها","روحي بغرفتها صِباً تمتاحُ",41,"ح",1,0],["هيِّئي لي منك صدراً","من نوانا يتقطَّعْ",42,"ع",1,0],["هيئي لي أي جو","من سلام كي نُمَتَّعْ",42,"ع",1,0],["هَيِّىءْ لها عَوداً حميداً سالماً","واحرس ذويها من أذى وشجونِ",43,"ن",1,0],["هيئتُ نفسي وردة","إن كان مني قد دنا",44,"ا",1,0],["‏هَيِّئ خِضَابَكَ ها قدْ شَابَ أيَّارُ","أُهمِلْتَ وَحْدَكَ والأحبابُ قدْ سَاروا",45,"ر",3,1],["هَيِّئ لِنفسِكَ أَن تضيءَ قَليلا","لَيسَ الظَّلام إلى الكَمالِ سَبيلا",46,"ل",2,1],["هيئ لنا التوفيق يشمل ربعنا","واحفظ لأوطان لنا وحرائر",47,"ر",1,0],["هيئةُ الأمم التي يَرجمُها","بازدواجِ الكيلِ مَن لا عِلْمَ لهْ",48,"ل",2,1],["هي – ياربّ – ضيفةٌ وقِراها","جنةُ الخُلدِ ؛ منحةُ الكُرَماءِ",49,"ا",2,0]]}