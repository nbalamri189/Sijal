7",""],[5045,"لك الله أيها المغوار","https://www.poetsgate.com/ViewPoem.aspx?id=185178",""],[3271,"زفرة على فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=131018",""],[585,"بلغنا من الآمال ما كان قاصيا","https://www.poetsgate.com/ViewPoem.aspx?id=161842",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5213,"خليلي هل يدنو من الحي شاسعه","https://www.poetsgate.com/ViewPoem.aspx?id=170502",""],[5219,"يا غصن بان ....","https://www.poetsgate.com/ViewPoem.aspx?id=198737",""],[5320,"البسمة الصفراء","https://www.poetsgate.com/ViewPoem.aspx?id=43257",""],[5338,"أمة العرب قفي واستلهمي","https://www.poetsgate.com/ViewPoem.aspx?id=187618",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5411,"لست أدري..","https://www.poetsgate.com/ViewPoem.aspx?id=191057",""],[5431,"عهد المحبة راسخ وموثق","https://www.poetsgate.com/ViewPoem.aspx?id=191185",""],[5704,"مسكين أنت يا وطني ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200014",""],[5720,"رسالة إلى ولدي ..","https://www.poetsgate.com/ViewPoem.aspx?id=198971",""],[5736,"نخل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208488",""],[5736,"نخلة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=208865",""],[5829,"في مخيم الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161989",""],[5848,"لا صار خلك عسل","https://www.poetsgate.com/ViewPoem.aspx?id=53365",""],[5853,"((لمن ..أغني ؟))","https://www.poetsgate.com/ViewPoem.aspx?id=175660",""],[5943,"ياإله الكون فاشهدْ","https://www.poetsgate.com/ViewPoem.aspx?id=35153",""],[5956,"بصخرِ العز","https://www.poetsgate.com/ViewPoem.aspx?id=192333",""],[6142,"كلما اغصوصبوا عليه دحاهم","https://www.poetsgate.com/ViewPoem.aspx?id=155706",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[6171,"عَزْفٌ عَلَى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""],[5226,"سِواكِ .. لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82796&r=&rc=89",""]],"verses":[["شُرَّعاً تَفتَرُّ عَن أَعناقِها","قُلَلُ القورِ وَغيطانُ الأَكَم",0,"م",1,0],["شَرَعْتُ لَهُ مِنْ دَمْعِ عَيْنَي مَوْرِداَ","فَكَدَّرَ شُرْبِي بِالْفِرَاقِ وَأَظْمَانِي",1,"ن",2,0],["شرع الهدى ووصفت شارع فضله","أكرمْ بفضليْ مشرعٍ ومشرع",2,"ع",1,0],["شرعت يدا قاضي القضاة محمد","شرع الندَى في كل حال واهي",3,"ي",1,1],["شرعتْ شرائعَ للظُّبا","فيها لها نهْلٌ وعَلُّ",4,"ل",1,0],["شِرْعتي حُبُّكِ العَميقُ وإنِّي","قَدْ تَذَوَّقْتُ مُرَّهُ وقَرَاحَهْ",5,"ح",2,0],["شرعتمو للشباب دينا","كدينهم بيِّنا سواء",6,"ا",2,0],["شَرَعَت حُقوقَ الناسِ في أَوطانِهِم","إِلّا أُباةَ الضَيمِ وَالضُعَفاءَ",7,"ا",2,0],["شَرُّ عَيشِ الرِجالِ ما كانَ حُلماً","قَد تُسيغُ المَنِيَّةَ الأَحلامُ",8,"م",1,0],["شَرَعَ اللهُ فلم يُؤمِنْ به","حَسْبُهُ شَرْعُ السُّكارَى المُدمِنينْ",9,"ن",1,0],["شَرَع التقدُّمَ بالفيالقِ قومُه","فتعلّم الأبطالُ والقُوّادُ",10,"د",1,0],["شَرَعوا لَنا سُبُلَ العَداوَةِ بَينَنا","حَتّى الفَتى وَإِلَهُهُ خَصمانِ",11,"ن",1,0],["شَرَعوا العَداوَةَ بَينَهُم لَم يوصِهِم","دينُ المَسيحِ بِها وَلا الإِسلامُ",12,"م",1,0],["شَرَعَ اليَقينَ لَدى الطِعانِ مُثَقَّفاً","وَاِستَلَّهُ عِندَ الضِرابِ حُساما",13,"م",2,0],["شَرَعتِ لَها وَلِلفِتيانِ ديناً","ضَرَبتِ بِهِ عَلى دينِ الأَوالي",14,"ل",2,0],["شَرَعَ الدِّينَ الذي وَصَّى بهِ","عُمدَةَ الرُّسْلِ وشيخَ الأنبياءْ",15,"ا",2,0],["شَرَعٌ سرابيلُ الحروب وما اكتسى","من سابغاتِ الخيرِ من يتسربلُ",16,"ل",1,0],["شَرَعْتَ للنَّاسِ طُرقاً ما بها عُجَزٌ","يَخَافُ سالِكُها فيها ولا بُجَرُ",17,"ر",1,0],["شَرَعَ المَكارِهَ مَن تَوَجَّهَ غادِياً","يا لَلرِجالِ لِما يَروحُ وَيَغتَدي",18,"د",2,0],["شرعت حراب الهاجمين تنوشه","لِلَّه أحشاءٌ هناك تصاب",19,"ب",1,0],["شَرَعتُ بِقَلبي الصَبرَ عَن حرِّ وَجهِهِ","فَما هُوَ إِلّا أَن أَراهُ فَأدهَشا",20,"ش",2,0],["شَرْعُ النيابة ليس فيه مؤلَّه","آراؤه لا تقبل التفنيدا",21,"د",2,0],["شرعةٌ ظلَّلَتْ بأدواحها مَنْ","حلَّ بيدًا، أو حلَّ قصرًا مَشيدا",22,"د",2,0],["شرعةٌ تكفُلُ الحياتَيْنِ في كلِّ","زمانٍ جديدةٌ لن تَبيدا",22,"د",2,0],["شرعه المجد أن تصارع في المج","د º وتستلّ للصفاح صفاحا",23,"ح",2,0],["شَرَعٌ في الناس والدينُ وعودٌ","عم فيها الخُلْفُ والوعدُ ديون",24,"ن",1,0],["شرع المحبة قاض في حكومته","بصرم خل من الأشجان يرتاح",25,"ح",1,0],["شرعتَ شرائعَ المعروفِ فينا","وقد صرمت من العرفِ الحبالُ",26,"ل",1,0],["شرعُ طهَ مُكتمل","وَهو عدلٌ مُعتدلُ",27,"ل",1,1],["شَرعُهُ البَحرُ والشَرائِعُ تَجري","مِنهُ إِمّا جَداوِلٌ أَو قِناءُ",28,"ا",2,0],["شرعةُ الإسعادِ فينا شرعتُك","وهدى الإشفاق والعطفِ هداك",29,"ك",1,0],["شَرَعَ السَخاءَ فَمِن مَوا","هِبِهِ تَعَلَّمَتِ الغُيومُ",30,"م",1,0],["شَرَعتُ لها رُمحاً أَصَمَّ مقوَّماً","تخرُّ له عند الطِعان الوَلائِدُ",31,"د",1,0],["شرعَ المنجلَ في راحاتهِ","وانبرى يعصف بالنبتِ الحصيد",32,"د",1,0],["شَرعَةُ وَجدي ما لَها نَسخُ","وَعَقدُ عَهدي مالَهُ فَسخُ",33,"خ",1,1],["شرعُه شرع مرتشٍ","يَقرِنُ الكذب بالرُقا",34,"ق",2,0],["شرعةُ الدِّين ومنهاج الهُدى","قائمٌ بالقسط مجريُّ الحدود",35,"د",1,0],["شرعَ الجود مذهباً وأقامَهْ","وعليهِ أجرى لنا أحْكامَهْ",36,"م",2,0],["شرعت للسيف شرعا في رقابهمِ","كما لأكبادهم أشرعت خرصانا",37,"ن",2,0],["شرعوا المحجَّة للرشاد وأرخصوا","ما كان من ثمن البصائر غاليا",38,"ي",2,0],["شرعٌ من العفو انفردتَ بدينه","وفضيلةٌ لسواك لم تَتَقدّمِ",39,"م",1,0],["شرعوا إلى الغاياتِ كلَّ مهفهفٍ","سارٍ على خيلِ الأنامل جائل",40,"ل",1,0],["شرعَ الغَدرَ أخو غِل","لٍ عن الإرثِ زَواكِ",41,"ك",1,0],["شَرَعوا إلى ثُغَرِ الخطوب ذوابلاً","لولا صنيعةُ نفسها ما فُضِّلَتْ",42,"ت",1,0],["شرعوا مذهب السماحة والبأ","س وفيه التحليل والتحريم",43,"م",1,0],["شرعا نؤرخ مولدا","لك في الزمان الغابر",44,"ر",1,0],["شَرَعَت لَهُ نَفسٌ فَطالَعَ هِمَّةً","رَجَعَتهُ مَضموناً ثَناءَ الوُفَّدِ",45,"د",1,0],["شرعك الميزان فاعمل","والذي تعمل زِنه",46,"ن",2,0],["شرعت لنا الدين نمشي به","إليك على ذا الطريق الأمم",47,"م",1,0],["شرعُنا أحكامُ حقٍّ","لمقيمٍ ومسافرْ",48,"ر",1,1],["شَرعُ النَبِيِّ مُ