{"poems":[[65,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[53,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[53,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[60,"لقد كان ذا جد وجد بكفره","https://www.aldiwan.net/poem30926.html","الطويل"],[68,"سألتكم رد جوابي فكم","https://www.aldiwan.net/poem38713.html","السريع"],[18,"جارت بنو بكر ولم يعدلوا","https://www.aldiwan.net/poem23941.html","السريع"],[13,"ترجي نساء الأزد طلعة ثابت","https://www.aldiwan.net/poem2208.html","الطويل"],[77,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[50,"يا من يبادلني عشقا بسلوان","https://www.aldiwan.net/poem66139.html","البسيط"],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[135,"لعمرك ما آسى حراض ابن أمه","https://www.aldiwan.net/poem23983.html","الطويل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[214,"يهنئك المملوك بالشهر والعشر","https://www.aldiwan.net/poem13339.html","الطويل"],[229,"يا مصر سيري على آثارهم وقفي","https://www.aldiwan.net/poem55115.html","البسيط"],[275,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[352,"علمت زكي الدين أني مطالب","https://www.aldiwan.net/poem20716.html","الطويل"],[407,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[433,"سل الخطي والبيض الصقالا","https://www.aldiwan.net/poem40268.html","الوافر"],[441,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[443,"ليهن لك العيد الذي بك يهنينا","https://www.aldiwan.net/poem34859.html","الطويل"],[443,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[464,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[503,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"]],"verses":[["فقُلِّدَ السّيْفَ يومَ الرّوعِ طابِعُهُ","وأعْطيَ القَوْسَ عندَ الرّمْيِ باريها",0,"ي",3,0],["فَقُلِّدتَ ما قُلِّدتَ والعودُ مورق","بجدته والعرق ريانُ قالس",1,"س",1,0],["فقلدوا رأيكم فزهدهم","فيَّ فعِلقي لديهم خلق",2,"ق",1,0],["فَقَلَّدتُهُ بِالسَيفِ ضَربَةَ مَحفظٍ","فَسارَ إِلى قَعرِ الجَحيمِ يُكبَّلِ",3,"ل",1,0],["فَقَلَّدونا مِنَّةً وَاِعجَبوا","مِن سائِلٍ يَقنَعُ بِالرَدَّ",4,"د",1,0],["فَقَلَّدَ الأَمرَ بَنو لَجبَةٌ","مِنهُم رَئيساً كَالحُسامَ العَتيق",5,"ق",1,0],["فَقَلَّدتُ سَوّارَ بنَ عَمرِ بنِ مالِكٍ","بِأَسمَرَ حَشرِ القُذَّتَينِ طَميلِ",6,"ل",1,0],["فقلّدهَا جَمَّ السياسةِ مِدرهاً","إذا شاء رام القصْدَ أو قال أفصَحا",7,"ح",2,0],["فَقَلِّدوها بَني العَبّاسِ إِنَّهُمُ","صِنوُ النَبِيِّ وَأَنتُم غَيرُ صِنوانِ",8,"ن",1,0],["فقلدَ الأمرَ بنو هاجرٍ","مِنْهُمْ رَئِيساً كَالْحُسَامِ الْعَتِيقْ",9,"ق",1,0],["فَقَلَّدَهُ لَمّا تَبَيَّنَ شَخصَهُ","بِضَربَةِ ثَأرٍ لَم تَخُنها العَزائِمُ",10,"م",1,0],["فَقَلَّدَكَ الحُكمَ في مُلكِهِ","كَما قُلِّدَ المَشرَفِيَّ البَطَل",11,"ل",1,0],["فَقَلَّدَكَ الشامَ الَّذي قَلَّدَتكَهُ","ظُباكَ فَشَدَّ الآخِرُ المُتَقَدِّما",12,"م",2,0],["فقلد به مولاي عبدك انعما","فاحسن ما تبدي الغلائل في النحر",13,"ر",1,0],["فَقَلِّدوا الأُمَّةَ الكُبرى وَقد رَكِبَت","مَتنَ الفخارِ وكانَ الجِدُّ حاديها",14,"ي",3,0],["فَقلدسرت مسرى النجوم همومه","وَمضى مضىّ الباترات عزائمه",15,"م",2,0],["فَقلِّدْ صَنِيعاً واغتَنِمْ من مَدائحِي","فَلا بُدَّ ما دنَسَّتُها بِلَئيمِ",16,"م",1,0],["فقلد يا جهول ولا تلمني","ولا تَخَلِ الشوامخ كالأكام",17,"م",1,0],["فقلده المهابة سيف نصر","والبسه من العز الجمالا",18,"ل",2,0],["فقلّدني مهمّا واتخذني","صفيّا إنني نعم الصفيّ",19,"ي",1,0],["فقلَّدَ أَعناقَ الأُسودِ أَساوِداً","وحلَّى أَكُفَّ الدَّارِعينَ ثعابينا",20,"ن",2,0],["فقلَّدْتَهُ سَيفاً لِزَحْفٍ يقُودُهُ","لِخِزْيِ عِدَاكَ أَوْ لزغف يَقدُّهُ",21,"د",2,0],["فقلَّدك الأمرَ الجسيمَ وانما","لِعبء المعالي بازلٌ لم يُجرْجِرُ",22,"ر",1,0],["فَقلِّدِ القومَ يا هذا بسيرَتهِمْ","فكَمْ وكمْ جَرَّ للتَّحقيقِ تَقليدُ",23,"د",1,0],["فَقَلِّدوا أَمرَكُمُ لِلَّهِ دَرُّكُمُ","رَحبَ الذِراعِ بِأَمرِ الحَربِ مُضطَلِعا",24,"ع",2,0]]}