{"poems":[[63,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[58,"لقد كان ذا جد وجد بكفره","https://www.aldiwan.net/poem30926.html","الطويل"],[66,"سألتكم رد جوابي فكم","https://www.aldiwan.net/poem38713.html","السريع"],[13,"ترجي نساء الأزد طلعة ثابت","https://www.aldiwan.net/poem2208.html","الطويل"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[48,"يا من يبادلني عشقا بسلوان","https://www.aldiwan.net/poem66139.html","البسيط"],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[132,"لعمرك ما آسى حراض ابن أمه","https://www.aldiwan.net/poem23983.html","الطويل"],[144,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[144,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[211,"يهنئك المملوك بالشهر والعشر","https://www.aldiwan.net/poem13339.html","الطويل"],[226,"يا مصر سيري على آثارهم وقفي","https://www.aldiwan.net/poem55115.html","البسيط"],[272,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[349,"علمت زكي الدين أني مطالب","https://www.aldiwan.net/poem20716.html","الطويل"],[404,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[430,"سل الخطي والبيض الصقالا","https://www.aldiwan.net/poem40268.html","الوافر"],[438,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[440,"ليهن لك العيد الذي بك يهنينا","https://www.aldiwan.net/poem34859.html","الطويل"],[440,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[447,"جارت بنو بكر ولم يعدلوا","https://www.aldiwan.net/poem23941.html","السريع"],[462,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[501,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"]],"verses":[["فقُلِّدَ السّيْفَ يومَ الرّوعِ طابِعُهُ","وأعْطيَ القَوْسَ عندَ الرّمْيِ باريها",0,"ي",3,0],["فَقُلِّدتَ ما قُلِّدتَ والعودُ مورق","بجدته والعرق ريانُ قالس",1,"س",1,0],["فقلدوا رأيكم فزهدهم","فيَّ فعِلقي لديهم خلق",2,"ق",1,0],["فَقَلَّدتُهُ بِالسَيفِ ضَربَةَ مَحفظٍ","فَسارَ إِلى قَعرِ الجَحيمِ يُكبَّلِ",3,"ل",1,0],["فَقَلَّدونا مِنَّةً وَاِعجَبوا","مِن سائِلٍ يَقنَعُ بِالرَدَّ",4,"د",1,0],["فَقَلَّدتُ سَوّارَ بنَ عَمرِ بنِ مالِكٍ","بِأَسمَرَ حَشرِ القُذَّتَينِ طَميلِ",5,"ل",1,0],["فقلّدهَا جَمَّ السياسةِ مِدرهاً","إذا شاء رام القصْدَ أو قال أفصَحا",6,"ح",2,0],["فَقَلِّدوها بَني العَبّاسِ إِنَّهُمُ","صِنوُ النَبِيِّ وَأَنتُم غَيرُ صِنوانِ",7,"ن",1,0],["فقلدَ الأمرَ بنو هاجرٍ","مِنْهُمْ رَئِيساً كَالْحُسَامِ الْعَتِيقْ",8,"ق",1,0],["فَقَلَّدَهُ لَمّا تَبَيَّنَ شَخصَهُ","بِضَربَةِ ثَأرٍ لَم تَخُنها العَزائِمُ",9,"م",1,0],["فَقَلَّدَكَ الحُكمَ في مُلكِهِ","كَما قُلِّدَ المَشرَفِيَّ البَطَل",10,"ل",1,0],["فَقَلَّدَكَ الشامَ الَّذي قَلَّدَتكَهُ","ظُباكَ فَشَدَّ الآخِرُ المُتَقَدِّما",11,"م",2,0],["فقلد به مولاي عبدك انعما","فاحسن ما تبدي الغلائل في النحر",12,"ر",1,0],["فَقَلِّدوا الأُمَّةَ الكُبرى وَقد رَكِبَت","مَتنَ الفخارِ وكانَ الجِدُّ حاديها",13,"ي",3,0],["فَقلدسرت مسرى النجوم همومه","وَمضى مضىّ الباترات عزائمه",14,"م",2,0],["فَقلِّدْ صَنِيعاً واغتَنِمْ من مَدائحِي","فَلا بُدَّ ما دنَسَّتُها بِلَئيمِ",15,"م",1,0],["فقلد يا جهول ولا تلمني","ولا تَخَلِ الشوامخ كالأكام",16,"م",1,0],["فقلده المهابة سيف نصر","والبسه من العز الجمالا",17,"ل",2,0],["فقلّدني مهمّا واتخذني","صفيّا إنني نعم الصفيّ",18,"ي",1,0],["فقلَّدَ أَعناقَ الأُسودِ أَساوِداً","وحلَّى أَكُفَّ الدَّارِعينَ ثعابينا",19,"ن",2,0],["فقلَّدْتَهُ سَيفاً لِزَحْفٍ يقُودُهُ","لِخِزْيِ عِدَاكَ أَوْ لزغف يَقدُّهُ",20,"د",2,0],["فَقَلَّدَ الأَمرَ بَنو لَجبَةٌ","مِنهُم رَئيساً كَالحُسامَ العَتيق",21,"ق",1,0],["فقلَّدك الأمرَ الجسيمَ وانما","لِعبء المعالي بازلٌ لم يُجرْجِرُ",22,"ر",1,0],["فَقلِّدِ القومَ يا هذا بسيرَتهِمْ","فكَمْ وكمْ جَرَّ للتَّحقيقِ تَقليدُ",23,"د",1,0]]}