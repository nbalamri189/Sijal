r&doWhat=shqas&qid=18986&r=&rc=249",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""]],"verses":[["وَمَوسومَةٍ مَقطوعَةِ العُقلِ لَم تَزَل","شَوارِدَ قَد بالَغنَ في الجَوَلانِ",0,"ن",1,0],["وَمَولىً دَعا غَيري إِلى ما يُريدُهُ","وَلَو أَنَّني مِمَّن يُجيبُ دَعاني",1,"ي",1,0],["وَمَولِدي طاهِرُ الأَثوابِ تَحسَبُني","وُلِدتُ في حِجرِ ذاكَ الحِجرِ وَالحَرَمِ",2,"م",1,0],["وَمَوتُ الفَتى خَيرٌ لَهُ مِن حَياتِهِ","إِذا جاوَرَ الأَيّامَ وَهوَ ذَليلُ",3,"ل",1,0],["وَمَواريثُ مَقاري ال","لَيلِ وَالنارِ العَتيقَه",4,"ق",2,0],["وَمَولىً يُعاطيني الكُؤوسَ تَجَمُّلاً","وَقَد وَدَّ لَو أَنَّ العُقارَ نَجيعُ",5,"ع",1,0],["وَمَواضٍ تُنشَرُ الهامُ لَهُم","هَبَّةَ العاصِفِ تَرمي بِالخَبَط",6,"ط",1,0],["وَمولىً وَرى قَلبي بِلَذعَةِ ميسَمٍ","مِنَ الكَلِمِ العَوراءِ مَضّاً عَلى مَضِّ",7,"ض",1,0],["وَمورِدٌ غَمَراتِ الضَربِ غُرَّتَهُ","جَرَّت إِلَيهِ المَنايا بِالمَصاديرِ",8,"ر",1,0],["وَمَولىً أُدانيهِ عَلى السَخطِ وَالرِضى","وَيَبعَطُ عَنّي وَالقَنا في الحَناجِرِ",9,"ر",1,0],["وَمُؤجَدُ المَتنَينِ إِن","صَمَّمَ لِلعَقرِ عَقَر",10,"ر",1,0],["وَمُؤَلَّلاتٍ كَالرِماحِ تَلَمَّظَت","فيها المَنونُ تَلَمُّظَ المَزؤودِ",11,"د",1,0],["وَمُؤَمَّرٍ نَزَلوا بِهِ في سوقَةٍ","لا شَكلُهُ فيهِم وَلا قُرَناؤُهُ",12,"ا",3,0],["وَموقِفُنا ما بَينَ باكٍ وَضاحِكٍ","وَسالٍ وَمَحزونٍ ووافٍ وَخائِنِ",13,"ن",1,0],["وَمَوقِفٍ زُرتُهُ مِن جانِبي حَضَنٍ","بِحَيثُ يُرخي قِبالَيْ نَعلِهِ الماشي",14,"ي",1,1],["وَمَوْطِيءُ عِيسي صَفْحَةُ اللَّيْلِ وَالسُّرى","كَرِيهٌ إِذا ضاقَتْ عَلَيْها المَبارِكُ",15,"ك",1,0],["ومُواصِلٍ أرَقاً على طَلَبِ العُلا","في مَعْشَرٍ عن نَيْلِهِنَّ رُقودِ",16,"د",1,0],["ومَوقِفٍ ضَجَّ جِيدُ الرّيمِ من غَيَدٍ","فيهِ وأزْرى بألْحاظِ المَها كَحَلُ",17,"ل",1,0],["ومَوضونَةٍ قدْ لاحَكَ السَّردُ نَسْجَهَا","حَكَتْ سَلَخاً ألقاهُ بالقاعِ أرقَمُ",18,"م",1,0],["وَمُوَسَّدٍ تَحتَ التُرابِ وَغَيرُهُ","فَوقَ التُرابِ يَئِنُّ غَيرَ مُوَسَّدِ",19,"د",1,0],["وَمَوكِبٍ خُضتُ أَعلاهُ وَأَسفَلَهُ","بِالضَربِ وَالطَعنِ بَينَ البيضِ وَالأَسَلِ",20,"ل",1,0],["ومولَعٍ بالكُتْبِ يَبْتاعُها","بأرْخَصِ السّوْمِ وأغْلاهُ",21,"ه",1,1],["وَمُوقِدُ نَارِ الْعَدلِ فِي عَلَمِ الْهُدَى","وَمُطْفِئُ نَارِ الْبَغْيِ بَعْدَ اشْتِعَالِهِ",22,"ل",2,0],["وَمُوَسَّدٍ فَوْقَ الأَرَائِكِ رَائِقٍ","يُزْهَى عَلَى مَوْضُوعِهَا مَحْمُولُهُ",23,"ل",2,0],["وموْقِدِ نارٍ يسْتَطيرُ رَمادُهُ","ونُؤْيِ كَما دارَ السِّوارُ على الزَّنْدِ",24,"د",1,0],["وَمُؤتَمَنٍ بِالسِرِّ أَوثَقتُ سِرَّهُ","مَع القَلبِ مَقروناً بِهِ لا يُزايِلُه",25,"ل",2,0],["وَمَوضِعَ طَولِيٍّ وَأَحناءَ قاتِرٍ","يَئِطُّ إِذا ما شُدَّ بِالنَسعِ مِن عَلُ",26,"ل",1,0],["وَمُوَفَّقٍ جَمِّ الصَوابِ إِذا اِلتَوى","داءُ العَليلِ وَحارَتِ الأَفهامُ",27,"م",1,0],["وَمُوَلِّدٍ عَرَفَ الأَجِنَّةُ فَضلَهُ","إِن أَعسَرَت بِوِلادِها الأَرحامُ",27,"م",1,0],["ومَوقِفٍ لكَ بعد المصطفى افَتَرقَت","فيه الصَّحابةُ لمّا غابَ هاديها",28,"ي",3,0],["وَموقِعِ حُرجوجٍ عَلى ثَفِناتِها","صَبورٍ عَلى عَدوى المُناخِ جَموعِ",29,"ع",1,0],["وَمَوْقِعُ الذُّلِّ نَاءٍ عَنْ أَعِزَّتِهَا","كَمَوْقِعِ الظِّلِّ عَنْ هَامَاتِ لُبْنَانِ",30,"ن",1,0],["وَمَوَدَّةٍ تَحنو عَلَيكَ بِها","نَفسي بِلا مَنٍّ وَلا مَلَقِ",31,"ق",1,0],["وَمَوشِيَّةٌ سَحمُ الصَياصي كَأَنَّها","مُجَلَّلَةٌ حوٌ عَلَيها البَراقِعُ",32,"ع",1,0],["وَمَوضِعِ عِرنينٍ كَريمٍ وَجَبهةٍ","إِلى هَدَفٍ مِن مُسرِعٍ غَيرَ فاجِرِ",33,"ر",1,0],["وموسما مشهور","وعيد من الأعياد",34,"د",1,0],["وموردُها ظمأى الكعوب ذوابلاً","ومصدرُها من كل أمْلدَ رَيّانِ",35,"ن",1,0],["ومواقدُ النيران تُذكي حولَها","فينير مَشعَلُها رُباً وسُهُولا",36,"ل",2,0],["ومؤمّراً لم تنتقض بوفاته","في الشعر بيعته على تأميره",37,"ر",2,0],["وَموسى وَعيسى وَالَّذي خَرَّ ساجِداً","فَأَنبَتَ زَرعاً دَمعُ عَينَيهِ أَخضَرا",38,"ر",2,0],["وَمَولى تَميمٍ حينَ يَأوي إِلَيهِمُ","وَإِن كانَ فيهِم ثَروَةُ العِزِّ مُنصِفُ",39,"ف",1,0],["وَمَولىً قَد دَفَعتُ الضَيمَ عَنهُ","وَقَد أَمسى بِمَنزِلَةِ المَضيمِ",40,"م",1,0],["وَمُوَطَّءُ الأَكنافِ غَيرُ مُلَعَّنٍ","في الحَيِّ مَشّاءٌ إِلَيهِ المَجلِسُ",41,"س",1,0],["ومورد خيلنا عكاظ كأنها","بواكير طير باتِ قِيّا عدوّها",42,"ه",2,0],["وَمَوقِفُهُم لأَوَّلِ دَفعَتَيهِم","عَلَينَا فِيهش غَيرُ مُخَالِفِينَا",43,"ن",2,0],["وَمَوتٌ في مَقامِ العِزِّ أَشهى","إِلى الفُرسانِ مِن عَيشٍ بِمَهنَه",44,"ن",2,0],["وَمَوؤودَةٍ مَقرورَةٍ في مَعاوِزٍ","بِآمَتِها مَرسومَةٍ لَم تُوَسَّدِ",45,"د",1,1],["وموحشة المفاوز في رُباها","طغت إبلي وسلن مع البطاح",46,"ح",1,0],["ومورّد الوجناتِ لولا حسنه","لم يجرِ دمعي في هواه موَرَّدا",47,"د",2,0],["ومواهب مثل السحائب برّة","يوم الندى لقريبها وبعيدها",48,"د",3,0],["ومولعٌ بفخاخٍ","يمدُّها وشباك",49,"ك",1,1],["ومواهب مقرونة بمناقبٍ","فالفضل حيث أقامَ والتفضيل",50,"ل",1,0],["ومَوْضُونَةٌ مثل الغدير حصينةٌ","تفُلُّ شباةَ السيفِ ذي المضرب العضبِ",51,"ب",1,0],["ومونقةِ الرواد مهتزة الربا","يحاسنُها سارٍ وغاد ورائحُ",52,"ح",1,1],["ومؤمَّل أغنيته ومؤمِّلٍ","رجَّى غناك لججت في تسويفه",53,"ف",2,0],["ومواثيقُنا بأنْ لستِ تهْوِيْ","نَ سوانا ولا نحبُّ سواك",54,"ك",1,0],["ومولىً يجرُّ الشرَّ لي غيرَ مؤْتَلِ","ويجني فيمضي وهْو عني بمعزلِ",55,"ل",1,1],["ومؤوناتُ بَذرها لا على القَرْ","نان لكن تَحْملُ الإخوانا",56,"ن",2,0],["وَمَوقِعُها ضَخمٌ إِذا هِيَ أُرسِلَت","وَلَو كُفِتَت كانَت يَسيراً كِفاتُها",57,"ت",3,0],["وَمُوَقَّعٍ أَثَرُ السِفارِ بِخَطمِهِ","مِن سودِ عَقَّةَ أَو بَني الجَوّالِ",58,"ل",1,0],["وَموجَعٍ كانَ ذا قُربى فُجِعتُ بِهِ","يَوماً وَأَصبَحتُ أَرجو بَعدَهُ الأَمَلا",59,"ل",2,0],["وَمَوضِعَ أَحطابٍ تَحَمَّلَ أَهلُهُ","وَمَوقِدَ نارٍ كَالحَمامَةِ أَسحَما",60,"م",2,0],["وَمَولىً كَمَولى الزِبرِقان دَمَلتُه","كما دُمِلَت ساقٌ تُهاضُ بِها وَقرُ",61,"ر",1,1],["وَمَواطِنُ الأَرواحِ يَعظُمُ شَأنَها","في النَفسِ فَوقَ مَواطِنِ الأَجسادِ",62,"د",1,0],["وَمَواهِبٌ حَضَرِيَّةٌ سَيّارَةٌ","لايَنقَضي سَفَرٌ لَها وَرَحيلُ",63,"ل",1,0],["وَمَوقِدِ النارِ قَد بادَت حَمامَتُهُ","ما إِن تَبَيَّنَهُ في جُدَّةِ البَلَدِ",64,"د",1,0],["وَمَوالايَ الَّذي مازا","لَ يَسحَبُ حُلَّةَ الحَمدِ",65,"د",1,0],["وَمَولى عَدَتني مُذ نَشأتُ مَكارِمٌ","تَصوبُ بِها مِن راحَتَيهِ سَحابُ",66,"ب",1,0],["وَمَوت إِبراهيم حَتفَ فيهِ","فِدىً لِأَمرِهُم وَحُبّاً فيهِ",67,"ه",1,0],["وَمُوَسَّداً حُفَرَ الثَرى","بَعدَ البِناءِ الأَطوَلِ",68,"ل",1,0],["وَمَواقيتُ لِلأُمورِ إِذا ما","بَلَغَتها الأُمورُ صارَت لِعَكسِ",69,"س",1,0],["وَمَوضِعاً في فِتانِ ناجِيَةٍ","يَحمِلُ في التاجِ هامَةَ العاقِد",70,"د",1,0],["وَمَوالٍ تُحيِيهِمِ مِن يَدَيهِ","نِعَمٌ غَيرُهُم بِها مَقتولُ",71,"ل",1,0],["وموقفُنا في حومةِ البينِ حُسَّراً","من الصبرِ نرضَى بالمنيّةِ مغنما",72,"م",2,0],["ومواقفٍ دُحْضِ العَثار وقفتُها","بين الخصومِ وللعظام قَعاقِعُ",73,"ع",1,0],["وموقفٍ من وراء الرَّملِ آنسنِي","فيه الدجَى وأرادَ الصُّبْحُ إيحاشي",74,"ي",1,1],["ومؤلِّفَ الأضدادِ مجتمعاً","في راحتيهِ الماءُ واللَّهَبُ",75,"ب",1,0],["ومواربٍ أخفَى عَداوتَه","فبدَتْ كما تتفرَّقُ الجُلَبُ",75,"ب",1,0],["وَمُؤَمَّلٍ صارَعتُهُ عَن عُرفِهِ","فَوَجَدتُ قُدسَ مُعَمَّماً بِعَمائِهِ",76,"ا",3,0],["وَمَوتِ الحُقوقِ فَلا يائِسٌ","يَرُدُّ غُلامىً وَلا راغِبُ",77,"ب",1,0],["وَمَواهِبٍ كَعبِيَّةٍ وَهبِيَّةٍ","يُجِبنَ في الإِفضالِ فَوقَ الواجِبِ",78,"ب",1,0],["وَمَولى أَيادٍ مِنكَ بيضٍ مَتى أَقُل","بِآلائِها في مَشهَدٍ لا أُكَذَّبِ",79,"ب",1,0],["وَموضِحٍ لي سَبيلَ الرُشدِ قُلتُ لَهُ","الرُشدُ صابٌ وَبَعضُ الغَيِّ مِن شُهُدِ",80,"د",1,0],["وَمَولاكَ الَّذي مازِلتَ تَرضى","وَتَحمَدُ غَيبَهُ في الاِختِيارِ",81,"ر",1,0],["وَمَواهِبٍ في الخابِطينَ كَأَنَّما","يَطلُعنَ مِن خَلَلِ الرَبيعِ الباكِرِ",82,"ر",1,0],["وَمَواعِظٍ شَفَتِ الصُدورَ مِنَ الَّذي","يَعتادُها وَشِفاؤُها مُتَعَذِّرُ",83,"ر",1,0],["وَمولَعَةٍ بِالهَجرِ يُقلى وَدودُها","وَيُقصى مُدانيها وَيُجفى وَصولُها",84,"ل",3,0],["وَمَواعِداً لَو كُنَّ شَيئاً ظاهِراً","تُفضي إِلَيهِ العَينُ كُنَّ غُيوما",85,"م",2,0],["وَمُوَرِّثوا النارِ العَتيقَةِ لِلقِرى","وَمُشَيِّدو البَيتِ الرَفيعِ الأَقدَمِ",86,"م",1,0],["وَمُؤنِسَتي وَكَيفَ شُهودُ أُنسي","بِها وَاِبنا المُدَبِّرِ غائِبانِ",87,"ن",1,0],["وَموضِعِ خِمسٍ خَفقَةً كُنتَ سادِساً","لَهُنَّ وَقَد حانَ الغُدُوُّ لِمُغتَدي",88,"د",2,0],["ومَوْسُومَةٍ كاساتُها بِفَوارِسٍ","من الفُرْسِ تَطْفُو في المُدامِ وتَغرَقُ",89,"ق",1,0],["ومُوَدِّعٍ ظَفِرَتْ يَداه بمهجتي","فمضَى ونَضْحُ دمي على أظفارِه",90,"ر",2,0],["ومواجهٌ وجهَ العدوِّ بصَعدَةٍ","ينقضُّ كوكبُه على شَحنائِه",91,"ا",3,0],["وَمَولىً قَد رَعَيتُ الغَيبَ مِنهُ","وَلَو كُنتُ المُغَيَّبَ ما قَلاني",92,"ي",1,0],["وَمُؤَشَّرٍ حُمشِ اللِثاتِ كَأَنَّما","شَرِكَت مَنابِتُهُ رَضيضَ الإِثمِدِ",93,"د",1,0],["وَمَوعِدُ كُلِّ ذي عَمَلٍ وَسَعيٍ","بِما أَسدى غَداً دارُ الثَوابِ",94,"ب",1,0],["وَمُوَجَّهاً مُستَرسِلاً","بَينَ الأَحِبَّةِ لِلقَضاءِ",95,"ا",2,0],["وَمُؤَنَّبٍ في الإِنقِطاعِ وَإِن غَدا","مُتَجافِياً خَجَلاً فَلَيسَ بِجافِ",96,"ف",1,0],["وَمَورِدُ اللَهوِ صافٍ مِن تَصافينا","كَم قَد وَرَدنا مِياهُ العِزِّ صافِيَةً",97,"ه",1,0],["وَمُواجِهٍ صَدرَ الحُسامِ وَوَجهُهُ","يُبدي صِقالاً مِثلَ ماءِ فِرِندِهِ",98,"د",2,0],["وموسَّدٌ كالطيفِ صاحٍ ليله","أمسيتُ أرعاه بجفنٍ صاحِ",99,"ح",1,0],["وموفّقُ الأعمالِ تحسبُ رأيَهُ","صُبْحاً يقدّ أديمَ ليلٍ أليْلِ",100,"ل",1,0],["ومواردُ الرّشَفاتِ مُرْوِيَتي","حيثُ المياهُ مثيرةٌ غُلَلي",101,"ل",2,0],["وَمَوسومَةٌ بالبِيضِ وَالسمرِ هُلْهِلَتْ","عَلَيهِنَّ من نَسْجِ العجاجاتِ أجلالُ",102,"ل",1,0],["ومُودع في المَطايا لَسْعَةً حمَّةٍ","فَيُزعِجُ الروحَ تعذيباً مِنَ الجَسَدِ",103,"د",1,1],["وَمَوَدَّةٌ مَطوِيَّةٌ مَنشورَةٌ","فيها إِلى إِنجاحِها مَتَعَلَّلُ",104,"ل",1,0],["وَمُؤَيِّهٍ بي كَي أُفيقَ وَإِنَّني","لَأَصَمُّ عَن ياهٍ وَعَن يَهياهِ",105,"ه",1,0],["وَمَواهِباً مَطلوبَةً مَلحوقَةً","تَذَرُ الشَريفَ بِفَضلِها مَشروفا",106,"ف",2,0],["وَمَوَدَّتي لَكَ لا تُعارُ بَلى إِذا","ما كانَ تامورُ الفُؤادِ يُعارُ",107,"ر",1,0],["وَموقانَ كانَت دارَ هِجرَتِهِ فَقَد","تَوَرَّدتَها بِالخَيلِ أَيَّ تَوَرُّدِ",108,"د",1,0],["وَمَوَدَّةً لا زَهَّدَت في راغِبٍ","يَوماً وَلا هِيَ رَغَّبَت في زاهِدِ",109,"د",1,0],["وَمَوقِفَها وَهناً عَلَينا وَدَمعُها","سَريعٌ إِذا كَفَّت تَحَدُّرَهُ اِتَّسَق",110,"ق",1,0],["وَموقِفَ أَترابٍ لَها إِذ رَأَينَني","بَكينَ وَأَبدَينَ المَعاصِمَ وَالحَدَق",110,"ق",1,0],["وَمَوعِدُكَ البَطحاءُ مَن بَطنِ يَأجَجٍ","أَوِ الشَعبُ ذو المَمروخِ مِن بَطنِ مُغرِبِ",111,"ب",1,0],["وَمَوقِدِ نارٍ حَتّى كَأَنَّما","يَشِبُّ النَدى فيهِ لِساري الدُجى نَدّا",112,"د",2,1],["وَمُوَرَّسِ السِربالِ يَخلَعُ قَدَّهُ","عَن نَجمِ رَجمٍ في سَماءِ غُبارِ",113,"ر",1,0],["وَمُؤثِرَةُ الرِجالِ عَليَّ لَيلى","وَلَم أوثِر عَلى لَيلى النِساءَ",114,"ا",2,0],["وَمُوتا إنّ للقتلى ذُحولا","دُعَاةَ اللاتِ والعُزَّى أنيبوا",115,"ب",3,0],["وَموسى وَلا كُفرانَ لِلَهِ قاتِلي","وَموسى لِقَلبي كَيفَ كانَ حَبيبُ",116,"ب",1,0],["وَمَوت الفَتى تَحني الثمانون ظَهرَه","كَمَوت الفَتى في ميعةِ العُمر أَمرَدا",117,"د",2,0],["وَمَوضِعِ مَشكوكَينِ أَلقَتهُما مَعاً","كَوَطأَةِ ظَبيِ القُلِّ بَينَ الجَعاثِنِ",118,"ن",1,0],["وَمَوضِعِ مَثنى رُكبَتَينِ وسَجدَةٍ","تَوَخّى بِها رُكنَ الحَطيمِ المُيامِنِ",118,"ن",1,0],["وَمَولىً رَمَينا نَحوَهُ وَهوَ مُدغِلٌ","بِأَعراضِنا وَالمُندِياتُ شُروعُ",119,"ع",1,0],["وَمَوقِدِ نيرانِ ثَلاثٍ فَشَرُّها","وَأَلأَمُها أَوقَدتَها غَيرَ عازِبِ",120,"ب",1,0],["وَمَواقِفٌ بِالمشعَرَينِ لَها","وَمَناظِرُ الجَمَراتِ وَالنَحرِ",121,"ر",1,0],["وَمُؤنِسٌ عادَ بِهِ عَلَيهِ","وَغَلَّ مِن ساعَتِهِ يَدَيهِ",122,"ه",1,0],["وَموقَرَةٍ بِثِقلِ الماءِ جاءَت","تَهادى فَوقَ أَعناقِ الرِياحِ",123,"ح",1,1],["وَمَوَّتَّ لِيَ الجَدَّ","فَأَتقَنتَ وَأَحكَمتا",124,"ت",2,0],["وموحشة الأقراب يبدو سرابها","كما قُيِّدت بين الفِحَالَةِ نوق",125,"ق",1,0],["ومَوقِفُ الفَتَياتِ الناسكاتِ ضحىً","يَعْثُرْنَ في حِبَراتِ الفِتيةِ الصِّيدِ",126,"د",1,0],["وَمُوَقَّراتٍ في القُرا","طِقِ وَالخَناجِرُ في الخُصورِ",127,"ر",1,0],["وَمُوَحَّدٍ في الحُسنِ جَلَّلَهُ","بِرِدائِهِ ذو الطولِ وَالقُدسِ",128,"س",1,0],["وَمُؤَزَّرٍ يَدعو الكُهولَ إِلى","خَلعِ الأَعِنَّةِ فيهِ بِالضَمِّ",129,"م",1,0],["وَمُؤاتي الطَرفِ عَفِّ اللِسانِ","مُطمِعِ الإِطراقي عاصي العِنانِ",130,"ن",1,1],["وَمَولىً تَوَلّى عامِداً فَتَرَكتُهُ","وَما غالَهُ إِنَّ العِقابَ لِمَن عَنَد",131,"د",1,0],["وَمُوارٍ بِالدينِ لا يَذكُرُ الدي","نَ إِذا ما خَلا مِنَ الأَرصادِ",132,"د",1,0],["وَمَوضِعُ كَفٍّ خُضِّبَت لِلقائِنا","عَلى كَبِدٍ مَجنونَةِ الهَفَواتِ",133,"ت",1,0],["وَمَولى أَبيكُم فَاِطرَحوهُ لِأَكلُبٍ","وَلا يُدفَنُ الزِنجِيُّ بَينَ رُبوبِ",134,"ب",1,0],["وَمُؤَشَّرٌ أَلمى اللِثا","تِ شَهِيُّ طَعمِ الريقِ عَذبُه",135,"ب",2,0],["وَمَوقِدُ نيرانِهِ في الدُجى","يَرومُ سَناءً بِرَفعِ السَنا",136,"ن",2,0],["وَمَوتُ المَرءِ نَومٌ طالَ جِدّاً","عَلَيهِ وَكُلُّ عيشَتِهِ سُهادُ",137,"د",1,0],["وَمَوتٌ لا تُؤَخَّرُ عَنهُ نَفسٌ","تُهَدَّدُ بَعدَهُ بِصَلاءِ جَمرِ",138,"ر",1,0],["وَمَوَّهَ الناسُ حَتّى ظَنَّ جاهِلُهُم","أَنَّ النُبوَّةَ تَمويهٌ وَتَدليسٌ",139,"س",1,0],["وَمومِساتٌ تُوافيها حَنادِسُها","بِطارِقينَ يُخالونَ البَطاريقا",140,"ق",2,0],["وَمَولِدُ هَذي الشَمسِ أَعياكَ حَدُّهُ","وَخَبَّرَ لُبٌّ أَنَّهُ مُتَقادِمُ",141,"م",1,0],["وَمَولىً جَفَت عَنهُ المَوالِي كَأَنَّما","يُرى وَهُوَ مَطليُّ بِهِ القارُ أَجرَبُ",142,"ب",1,1],["ومورد لي من الأيمان أَغلظها","على سلامة ما ينويه برهانا",143,"ن",2,0],["وموجٌ له أنّة أو وجيف","وريحٌ تنوحُ وليلٌ شفيفُ",144,"ف",1,0],["ومواقف لكمو تشيد بذكرها","دول وراء النار قام رقيبها",145,"ب",3,0],["وموسم السوم والاكتساب","وندوة النداء بالأنساب",146,"ب",1,0],["وَمُوَفِّي قِسْطَ الْبِلاَدوَإِنْ لَمْ يَ","كُ مِنْهَا يُجَلُّ كَابْنِ الْبِلاَد",147,"د",1,0],["وَمُوَفَّقُ الإِيمَاءِ يَسْتَدْنِي بِهِ","مِمَّا تُحِب النَّفْسُ كُلَّ مُبَعَّدِ",148,"د",1,0],["ومواعِظٍ مِنْ رَبِّنا نُهدي بها","بِلسانِ أزهرَ طيّبِ الأثوابِ",149,"ب",1,0],["وموجة الإغماء تحتويني","فقربي مني ولامسيني",150,"ي",1,0],["وموْكِبُ عِزٍ ما رأى النيلُ مثلَه","ولا خطَّه في السابقين كِتابُ",151,"ب",1,0],["ومُوَحِّدو شَمْلِ العُرُوبة، وَهْوَ مِنْ","طُولِ الشِّقاق مُمزَّقُ الأوْصالِ",152,"ل",1,0],["ومؤمِّل مُلكَ الثرى وَلى فما","أَجْرَى دموعًا أو أثار نحيبا",153,"ب",2,0],["وَمَوْقِدُ نِيرَانٍ ثَلاثٍ فَشَرُّهَا","وأَلأمُهَا إذْ قُدْتُهَا غَيْرَ عَازِبِ",154,"ب",1,0],["وموطأ الأكتاف، غير ملعن،","في الحي مشاءٌ إليه المجلسُ",155,"س",1,0],["وموكَّلٍ بالبائعين","وبالدُروب ورشِّهنَّه",156,"ن",2,0],["ومُوَكَّلاً بالدَّهر ، يَزرعُهُ","في شاطئيه ثمَّ يحصُده",157,"د",2,0],["ومؤَّججينَ نفوسَهمْ وقُلوبَهمْ","شُعَلاً يسيرُ على هُدها الساري",158,"ر",2,0],["وموجُ البحرِ يَغسِلُ أخْمَصَيْها","وبالأنواءِ تغتسلُ القِباب",159,"ب",1,0],["ومواطن حدبت على استقلالها","بالسيف ترضعه دم الأكباد",160,"د",1,0],["وَمُؤرِّثُو النّارِ العَتيقَةِ لِلْقِرَى،","وَمُشَيِّدُو البَيْتِ الرّفيعِ الأقْدَمِ",161,"م",1,0],["وَمَوَاهِبٍ كَعْبِيّةٍ وَهْبِيّةٍ يُوجِبْنَ","في الإفْضال فَوْقَ الوَاجبِ",162,"ب",1,0],["ومُولَعَةٍ بالْهَجْرِ يُقْلَى وَدُودُها،","ويُقْصى مُدَانِيها ،ويُخْفَى وَصُولُهَا",163,"ل",3,0],["وموت الحقوق فلا يأس","يرد غلامي ولا راغب",164,"ب",1,0],["وَمُؤمَّرٍ صَارَعْتُهُ عَنْ عَرْفِهِ،","فوَجَدْتُ قُدْسَ مُعَمَّماً بعَمائِهِ",165,"ا",3,0],["ومَوْضِعِ مَشْكُوكَيْنِ أَلْقَتْهُما مَعاً","كوطأة ِ ظبيِ القفِّ بينَ الجعاثنِ",166,"ن",1,0],["وَمَوْرِدُهَا عَذْبٌ عَلَى أَنَّهُ يُصْلِي","تَكَامَلَ فِيهَا الحُسْنُ وَالمَكْر أَجْمَعَا",167,"ع",2,0],["وموقفها وهناً علينا، ودمعها","سَرِيعٌ، إذا كَفَّتْ تَحَدُّرَهُ، کتَّسَقْ",168,"ق",1,0],["وموقفَ أترابٍ لها، إذ رأيتني،","بَكَيْنَ وأَبْدَيْنَ المَعَاصِمَ والحَدَقْ",168,"ق",1,0],["وموت المرء خير من مقام","له بين الذين سقوه هونا",169,"ا",1,0]]}