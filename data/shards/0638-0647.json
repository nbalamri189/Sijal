{"poems":[[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[55,"ظهر الخفاء فقلت إن عاتبتها","https://www.aldiwan.net/poem26201.html","الكامل"],[77,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[77,"حلف الليل بالثلاث يمينا","https://www.aldiwan.net/poem36033.html","الخفيف"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[86,"أيها الوسمي زر نبت الربا","https://www.aldiwan.net/poem10855.html","الرمل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[72,"خدمتك من فلك الثناء الدائر","https://www.aldiwan.net/poem18714.html","الكامل"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[64,"طاب السماع وهبت النسمات","https://www.aldiwan.net/poem67575.html","الكامل"],[64,"دخلت بناسوتي لديك الخلق","https://www.aldiwan.net/poem67621.html","الطويل"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"ظهور الأمور خلاف البطون","https://www.aldiwan.net/poem66401.html","المتقارب"],[91,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[70,"ياغادرين ألم يكن","https://www.aldiwan.net/poem42940.html","مجزوء الكامل"],[89,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[89,"من بعد ما انتظرت حقابا","https://www.aldiwan.net/poem44746.html","مجزوء الكامل"],[89,"لقد كان منك اليك السبيل","https://www.aldiwan.net/poem44883.html","المتقارب"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[62,"أجساد صنعتنا مركبة","https://www.aldiwan.net/poem52142.html","أحذ الكامل"],[45,"إن الظباء غداة سفح محجر","https://www.aldiwan.net/poem63628.html","البسيط"],[61,"ظهر الهوى وتهنكت أستاره","https://www.aldiwan.net/poem51298.html","الكامل"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[66,"جمعت في صفاتك الأضداد","https://www.aldiwan.net/poem41389.html","الخفيف"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[69,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[81,"أسيف الوزارة بوركت من","https://www.aldiwan.net/poem61329.html","المتقارب"],[46,"ظهور الركاب عند اللبيب","https://www.aldiwan.net/poem23059.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85798","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85350","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55043","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54951","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[45,"إنّ الظّبَاءَ، غَداةَ سَفحِ مُحَجَّرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31190",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""]],"verses":[["ظَهرُ صَعبٍ يَقِصُ الرا","كِبَ مِن قَبلِ الرُكوبِ",0,"ب",1,0],["ظَهَرَ الخَفاءُ فَقُلتُ إِن عاتَبتُها","كانَ العِتابُ لِوُدِّنا اِستِهلاكا",1,"ك",2,1],["ظَهيرُ الأمْرِ والقِدْحُ المعَلّى","وأكْرَمُ مَنْ نَضا البِيضَ الرِّقاقَا",2,"ق",2,0],["ظَهَرَت مِنْكَ فِيهِ أَسْرَارُ حُبٍّ","جَمَعَتْ فِي الْكَمَالِ دُنْيا وَدِينَا",3,"ن",2,0],["ظَهَرْتَ وُجُوداً وَاحْتَجَبْتَ لَطَافَةً","كَأَنَّكَ رُوحٌ لاَ يُصَاحِبُهُ جِسْمُ",4,"م",1,0],["ظَهَرَ الفَجرُ وَقَد عَوَّدتَني","أَن تُغَنّيني إِذا الفَجرُ ظَهَر",5,"ر",1,0],["ظَهَرتَ حائِطَهُم لمّا عَلِمتَ بهم","والليلُ مُعتَكِرُ الأرجاءِ ساجيها",6,"ي",3,0],["ظهرت مناقبك الحسان فجئتها","من وصف سؤدد بلفظٍ ظاهر",7,"ر",1,0],["ظهرت وأسكرت العقول فحبذا","بين المحافل خمرة المستنكه",8,"ه",1,0],["ظَهَرَت عَلَيهِم مِن بَواطِنِ سِرِّهِ","كاساتُ بِشرٍ كُلُّها راحَاتُ",9,"ت",1,0],["ظَهَرتَ لِخَلقٍ وَالتَبَستَ لِفِتيَةٍ","فَتاهوا وَضَلّوا وَاِحتَجَبتَ عَنَ الخَلقِ",10,"ق",1,0],["ظهير صدق إذا آخِيَّةٌ ضعفت","وزادها ظهراء السوء إضعافا",11,"ف",2,0],["ظهورُ الأمور خلافُ البطونِ","وغيبُ الصدور خَفِيُّ الكُمُونِ",12,"ن",1,1],["ظَهَرَ المَوتُ لِلعُيونِ جَديداً","أَمسُ في بَطشِه وَفي فَتَكاتِه",13,"ت",2,0],["ظَهَرَت عَلَيهِ مِن عِتابِيَ نَفحَةٌ","رَقَّت حَواشيهِ بِها وَتَعَطَّرا",14,"ر",2,0],["ظَهَرَت وَبانَت لي قَضِيَّ","تُكُم فَما هَذا الجُحودُ",15,"د",1,0],["ظهرت على متن السحاب كأنها","نار تشب على كثيب اسفع",16,"ع",1,0],["ظهرت تباشير له","تبني المنى منها قبابا",17,"ب",2,0],["ظهور وبعد الظهر خفاء","طلوع وبعد الطلوع افول",18,"ل",1,0],["ظهرت على الحوادث وهي جُلى","وأكمدت العدا والشامتينا",19,"ن",2,0],["ظَهَرتَ أَميرَ المُؤمِنينَ عَلى العِدا","ظُهوراً يَسوءُ الحاسِدينَ وَيُتعِبُ",20,"ب",1,0],["ظهر التعادي فيهما عرضاً","فنغاه تدبير له نسقُ",21,"ق",1,0],["ظَهَرَت بِمُنخَرِقِ الشَمالِ وَجاوَرَت","ظُلَلَ الغَمامِ الصَيِّبِ المُستَعزِزِ",22,"ز",1,0],["ظهر الهوى وتهنكت أستاره","والحب خير سبيله إظهاره",23,"ه",1,1],["ظَهَرنَ مِنَ السوبانِ ثُمَّ جَزَعنَهُ","عَلى كُلِّ قَينِيٍّ قَشيبٍ مُفَأَّمِ",24,"م",1,0],["ظِهرِيَةٌ إِن ضامَها أَلَمُ السُرى","حَثَّت مَناسِمَها بُعَيدِ مَظاظِ",25,"ظ",1,0],["ظَهَرَ الحَياءُ بِوَجهِهِ فَتَرى بِهِ","بِشرَ السُرورِ وَهيبَةَ المُغتاظِ",25,"ظ",1,0],["ظَهَرَت مِنكَ لِلوَرى مُعجِزاتٌ","فَأَقَرَّت بِفَضلِكَ الحُسّادُ",26,"د",1,0],["ظهرت تجلوك كف القدر","صورةً أروع ما في الصور",27,"ر",1,0],["ظهرَ الغدر وقلَّ المنصِفُ","ونما الجهلُ وسادَ المقرِفُ",28,"ف",1,0],["ظَهَرتَ عَلَى كُبَرَاءِ الزَّمَانِ","ظُهُورَ اليَقِينِ عَلَى البَاطِلِ",29,"ل",1,0],["ظُهورُ الرِكابِ عِندَ اللَبيبِ","أَولى بِهِ مِن ظُهورِ الطُرُق",30,"ق",1,1],["ظهورٌ وبعد الظهور خفاءٌ","طلوعٌ وبعد الطلوع أفولُ",31,"ل",1,0],["ظهر اللَّئيم عَلى الكَريم بأَرضه","وَسلاحه في حربه البهتان",32,"ن",1,0],["ظَهَرَتْ أَشِعَّتُهَا وَفَضْلُ","مُنَشِّئِيَها غَيْرُ خَافْ",33,"ف",1,0],["ظَهَرَتْ خِلاَلُ مَليكِهْم وَبِلاَدهمْ","في الْمُوفدينَ الْغُرِّ أَرْوَع مَظْهَر",34,"ر",1,0],["ظَهَرَتْ شَمَائِلُ مِصْرُ فِيهِ بِمَا بِهَا","مِنْ رِقَّةٍ وَنُعُومَةٍ وَنَقَاءِ",35,"ا",2,0],["ظَهَرَتْ حَيَاةٌ فِي البِلاَدِ جَدِيدَةٌ","مَلأَتْ جَوَانِبَهَا بِلاَ إِمْهَالِ",36,"ل",1,0],["ظَهري بِهِ مُنقَضٌ وَقَلبي","مُحَرَّقٌ حَشوُهُ شُواظُ",37,"ظ",1,0],["ظَهَرت لكِن رَمَتكَ عَيني","بِأَسهُمٍ ما لَها دِلاظُ",37,"ظ",1,0],["ظَهَرتُ عَلى الحُسّادِ في الفَضلِ إِنَّني","صَميمٌ وَكُلُّ الحاسِدينَ وَشيظُ",38,"ظ",1,0],["ظَهَر الرَّكْبُ والقُلُوبُ حَوَالَيْهِ","تُرَجِّيهِ والنُّفوسُ فِدَاؤُه",39,"ا",3,0],["ظَهْرُ الُليُوثِ وذاكَ أَصْعَبُ مَرْكَبٍ","أَوْفَى وأَكرَمُ مِنْ أَدِيمِ ثَراكِ",40,"ك",1,0],["ظهرتَ بها وجناحُ البيانِ","مهيضٌ ، وأسلوبُه مُحتقر",41,"ر",1,0],["ظَهَرَتْ منُخَرَقِ الشَّمالِ، وَجَاوَرَتْ","ظُلَلَ الغَمَامِ الصيبِ المُستغزَرِ",42,"ر",1,0],["ظَهَرْنَ مِنْ السُّوْبَانِ ثُمَّ جَزَعْنَهُ","عَلَى كُلِّ قَيْنِيٍّ قَشِيْبٍ وَمُفْأَمِ",43,"م",1,0]]}