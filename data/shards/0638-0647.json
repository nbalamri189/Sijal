/www.aldiwan.net/poem34489.html","الطويل"],[561,"ذال الذهاب مقيد طلق الشذا","https://www.aldiwan.net/poem34560.html","الكامل"],[561,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[561,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[561,"عرجا بي على النقا فجياد","https://www.aldiwan.net/poem34617.html","الخفيف"],[561,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[561,"حركات سكنات","https://www.aldiwan.net/poem34707.html","مجزوء الرمل"],[561,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[561,"ظهر الوجود بسائر الأشياء","https://www.aldiwan.net/poem35085.html","الكامل"],[562,"لأخلعن عذارى في محبتكم","https://www.aldiwan.net/poem69347.html","البسيط"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67380","الكامل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20448","الكامل"]],"verses":[["ظَهرُ صَعبٍ يَقِصُ الرا","كِبَ مِن قَبلِ الرُكوبِ",0,"ب",1,0],["ظَهَرَ الخَفاءُ فَقُلتُ إِن عاتَبتُها","كانَ العِتابُ لِوُدِّنا اِستِهلاكا",1,"ك",2,1],["ظَهيرُ الأمْرِ والقِدْحُ المعَلّى","وأكْرَمُ مَنْ نَضا البِيضَ الرِّقاقَا",2,"ق",2,0],["ظَهَرَت مِنْكَ فِيهِ أَسْرَارُ حُبٍّ","جَمَعَتْ فِي الْكَمَالِ دُنْيا وَدِينَا",3,"ن",2,0],["ظَهَرْتَ وُجُوداً وَاحْتَجَبْتَ لَطَافَةً","كَأَنَّكَ رُوحٌ لاَ يُصَاحِبُهُ جِسْمُ",4,"م",1,0],["ظَهَرَ الفَجرُ وَقَد عَوَّدتَني","أَن تُغَنّيني إِذا الفَجرُ ظَهَر",5,"ر",1,0],["ظَهَرتَ حائِطَهُم لمّا عَلِمتَ بهم","والليلُ مُعتَكِرُ الأرجاءِ ساجيها",6,"ي",3,0],["ظهرت مناقبك الحسان فجئتها","من وصف سؤدد بلفظٍ ظاهر",7,"ر",1,0],["ظهرت وأسكرت العقول فحبذا","بين المحافل خمرة المستنكه",8,"ه",1,0],["ظَهَرَت عَلَيهِم مِن بَواطِنِ سِرِّهِ","كاساتُ بِشرٍ كُلُّها راحَاتُ",9,"ت",1,0],["ظَهَرتَ لِخَلقٍ وَالتَبَستَ لِفِتيَةٍ","فَتاهوا وَضَلّوا وَاِحتَجَبتَ عَنَ الخَلقِ",10,"ق",1,0],["ظهير صدق إذا آخِيَّةٌ ضعفت","وزادها ظهراء السوء إضعافا",11,"ف",2,0],["ظهورُ الأمور خلافُ البطونِ","وغيبُ الصدور خَفِيُّ الكُمُونِ",12,"ن",1,1],["ظَهَرَ المَوتُ لِلعُيونِ جَديداً","أَمسُ في بَطشِه وَفي فَتَكاتِه",13,"ت",2,0],["ظَهَرَت عَلَيهِ مِن عِتابِيَ نَفحَةٌ","رَقَّت حَواشيهِ بِها وَتَعَطَّرا",14,"ر",2,0],["ظَهَرَت وَبانَت لي قَضِيَّ","تُكُم فَما هَذا الجُحودُ",15,"د",1,0],["ظهرت على متن السحاب كأنها","نار تشب على كثيب اسفع",16,"ع",1,0],["ظهرت تباشير له","تبني المنى منها قبابا",17,"ب",2,0],["ظهور وبعد الظهر خفاء","طلوع وبعد الطلوع افول",18,"ل",1,0],["ظهرت على الحوادث وهي جُلى","وأكمدت العدا والشامتينا",19,"ن",2,0],["ظَهَرتَ أَميرَ المُؤمِنينَ عَلى العِدا","ظُهوراً يَسوءُ الحاسِدينَ وَيُتعِبُ",20,"ب",1,0],["ظهر التعادي فيهما عرضاً","فنغاه تدبير له نسقُ",21,"ق",1,0],["ظَهَرَت بِمُنخَرِقِ الشَمالِ وَجاوَرَت","ظُلَلَ الغَمامِ الصَيِّبِ المُستَعزِزِ",22,"ز",1,0],["ظهر الهوى وتهنكت أستاره","والحب خير سبيله إظهاره",23,"ه",1,1],["ظَهَرنَ مِنَ السوبانِ ثُمَّ جَزَعنَهُ","عَلى كُلِّ قَينِيٍّ قَشيبٍ مُفَأَّمِ",24,"م",1,0],["ظِهرِيَةٌ إِن ضامَها أَلَمُ السُرى","حَثَّت مَناسِمَها بُعَيدِ مَظاظِ",25,"ظ",1,0],["ظَهَرَ الحَياءُ بِوَجهِهِ فَتَرى بِهِ","بِشرَ السُرورِ وَهيبَةَ المُغتاظِ",25,"ظ",1,0],["ظَهَرَت مِنكَ لِلوَرى مُعجِزاتٌ","فَأَقَرَّت بِفَضلِكَ الحُسّادُ",26,"د",1,0],["ظهرت تجلوك كف القدر","صورةً أروع ما في الصور",27,"ر",1,0],["ظهرَ الغدر وقلَّ المنصِفُ","ونما الجهلُ وسادَ المقرِفُ",28,"ف",1,0],["ظَهَرتَ عَلَى كُبَرَاءِ الزَّمَانِ","ظُهُورَ اليَقِينِ عَلَى البَاطِلِ",29,"ل",1,0],["ظُهورُ الرِكابِ عِندَ اللَبيبِ","أَولى بِهِ مِن ظُهورِ الطُرُق",30,"ق",1,1],["ظهورٌ وبعد الظهور خفاءٌ","طلوعٌ وبعد الطلوع أفولُ",31,"ل",1,0],["ظهر اللَّئيم عَلى الكَريم بأَرضه","وَسلاحه في حربه البهتان",32,"ن",1,0],["ظَهَرَتْ أَشِعَّتُهَا وَفَضْلُ","مُنَشِّئِيَها غَيْرُ خَافْ",33,"ف",1,0],["ظَهَرَتْ خِلاَلُ مَليكِهْم وَبِلاَدهمْ","في الْمُوفدينَ الْغُرِّ أَرْوَع مَظْهَر",34,"ر",1,0],["ظَهَرَتْ شَمَائِلُ مِصْرُ فِيهِ بِمَا بِهَا","مِنْ رِقَّةٍ وَنُعُومَةٍ وَنَقَاءِ",35,"ا",2,0],["ظَهَرَتْ حَيَاةٌ فِي البِلاَدِ جَدِيدَةٌ","مَلأَتْ جَوَانِبَهَا بِلاَ إِمْهَالِ",36,"ل",1,0],["ظَهري بِهِ مُنقَضٌ وَقَلبي","مُحَرَّقٌ حَشوُهُ شُواظُ",37,"ظ",1,0],["ظَهَرت لكِن رَمَتكَ عَيني","بِأَسهُمٍ ما لَها دِلاظُ",37,"ظ",1,0],["ظَهَرتُ عَلى الحُسّادِ في الفَضلِ إِنَّني","صَميمٌ وَكُلُّ الحاسِدينَ وَشيظُ",38,"ظ",1,0],["ظَهَر الرَّكْبُ والقُلُوبُ حَوَالَيْهِ","تُرَجِّيهِ والنُّفوسُ فِدَاؤُه",39,"ا",3,0],["ظَهْرُ الُليُوثِ وذاكَ أَصْعَبُ مَرْكَبٍ","أَوْفَى وأَكرَمُ مِنْ أَدِيمِ ثَراكِ",40,"ك",1,0],["ظهرت منك في الوجود كراما","ت رجوت الامداد من جدواها",41,"ا",3,0],["ظهرتَ بها وجناحُ البيانِ","مهيضٌ ، وأسلوبُه مُحتقر",42,"ر",1,0],["ظَهَرَتْ منُخَرَقِ الشَّمالِ، وَجَاوَرَتْ","ظُلَلَ الغَمَامِ الصيبِ المُستغزَرِ",43,"ر",1,0],["ظَهَرْنَ مِنْ السُّوْبَانِ ثُمَّ جَزَعْنَهُ","عَلَى كُلِّ قَيْنِيٍّ قَشِيْبٍ وَمُفْأَمِ",44,"م",1,0],["ظهرت بهم آثار قدرة ربهم","لما اصطفاهم سادة وأسودا",45,"د",2,0],["ظهور تجليها صباح الرضى وفي","تدلى معاني سرها الليلة الحبلى",46,"ل",2,0],["ظهرت شمائلهم عليهِ ولم تزل","في الشبلِ تظهرُ شيمةُ الضرغامِ",47,"م",1,0],["ظهوره يغنيك عن","ما في بطونِ الصحفِ",48,"ف",1,0],["ظَهَرتَ فَظَلَّت نِعمَتانِ أَظَلَّتا","وَإِن كُنتَ لِلإِمحالِ عَن أَرضِنا أَنفا",49,"ف",2,0],["ظَهَرتَ فينا فَأَقرَرتَ العُيونَ وَما","يَعدو بَقاءَكَ مَن يَدعو وَيَبتَهِلُ",50,"ل",1,0],["ظهرت أسرارهم عن كَدَرٍ","فهي في نوم النّهي ذاتُ انتباه",51,"ا",2,0],["ظَهرتُ بِسِرٍّ فاضَ دَمعي بِشَرحِهِ","وَكم ناطِقٍ حَالاً وما يَتَلَفَّظُ",52,"ظ",1,0],["ظَهيرُ الوَرى في مُعضِلِ الدينِ وَالدُنا","رَؤُفٌ رَحيمٌ غَيرُ قاسٍ وَلا فَظِّ",53,"ظ",1,0],["ظُهورُ رَسولِ اللَهِ أَفحَمُ شُبهَةً","لِشِرذِمَةٍ كادَت تَميزُ مِنَ الغَيظِ",53,"ظ",1,0],["ظَهَرنا بِهِ فَوقَ البَريَّةِ كُلِّها","فَنَحنُ أَحَظُّ الناسِ في شَرَف الأَحظِ",53,"ظ",1,0],["ظَهرَهُ رَسولٌ كَريمٌ قَدَّمَ اللَهُ أَمرَهُ","عَلى كُلِّ نَهيٍ قَد تَقَدَّمَ أَو أَمرِ",54,"ر",1,0],["ظهرت عجائب قدرة الرحمن","وبدا الصباح لمن له عينان",55,"ن",1,1],["ظهرتْ على قممِ البروجِ ثلوجُ","وهوتْ كما يتطايَرُ المَحْلوجُ",56,"ج",1,1],["ظهر القبيح فليس ينكر إن بدا","من فاسق لموثق ومفسّق",57,"ق",1,0],["ظَهرهُ خاتمُ النبوّة فيهِ","أَسفلَ الكتفِ حليةٌ حسناءُ",58,"ا",2,0],["ظهرت والفريق في دعةٍ","بعد أن أرسل الدجى سدلَهُ",59,"ل",2,1],["ظَهَروا فكانوا للعيونِ مَدامِعاً","وخَفُوا فكانوا للنُفوس هُموما",60,"م",2,0],["ظَهَرَت قُصورُ الشامِ مِنهُ بِضَربَةٍ","وَقُصورُ فارِس رَبَّة الإيوانِ",61,"ن",1,0],["ظَهَرَت بِأُخرى ثُمَّ أُخرى أَظهَرَت","يمناً بِضَربَةِ ضامِرٍ سَغبانِ",61,"ن",1,0],["ظَهَرَت عُيوبُهُم لَدَيكَ وَلَيسَتِ ال","حَسناءُ طَبعاً كَالَّتي تَتَصَنَّعُ",62,"ع",1,0],["ظهرت على العشاق أسباب الهوى","سيَّانَ إن كَتَمُوا الهوى أو بامُوا",63,"م",3,0],["ظهروا لنورك وهو شَمسُ ضُحىً","فتضاءلوا كتَضَاؤل الذَّرِّ",64,"ر",1,0],["ظهور رُسولِ اللَه أظهرَ دِيننا","وهيهَات تخفى الشمسُ عمن لهُ الَحظُ",65,"ظ",1,1],["ظُهورٌ أَعادَ الدَهر طُهرا وَفَرحَةٌ","أَعادَتِ بَكايا لَهوِهِ وَهيَ حُفَّل",66,"ل",1,0],["ظهرت على الضفّاتِ بغدادُ التي","فيها لأفلاكِ العُلى مِرصاد",67,"د",1,0],["ظهرت محاسنُهُ وكان ظهورُها","من حُسنِكِ المتبذّل المتستّر",68,"ر",1,0],["ظهرت مطهرةً به فتطهرت","منهُ الشعوبُ وعمَّ فضلُ مُطَهَّر",68,"ر",1,0],["ظَهيرُ الهِدايةِ أهدَى الظهور","إلَيْهَا نَصيباً وَلَمْ يَنْصب",69,"ب",1,0],["ظَهيراك التوكُّل والمَضاء","فَعُمْرُ الكُفْر آن له انْقِضاءُ",70,"ا",2,1],["ظهرت بِمحتدها السّماء وجاوَزَتْ","بِسُرادقاتِ فخارها جوْزاءها",71,"ا",3,0],["ظُهُورٌ ظَهِيرٌ عَلَى الْمَطْلَباتِ","فَكُلُّ عَسِيرٍ لَدَيْها يَسِيرُ",72,"ر",1,0],["ظهرت محاسن ذا الزمان فقابلت","بالبشر والاقبال والخير المزيد",73,"د",1,1],["ظهرت فلما أن بهرت تجليا","بطنت بطوناً كاد يقضي بردتي",74,"ي",1,0],["ظهر لي أن اعتصاما بالكتاب","وبحديث المصطفى هوالصواب",75,"ب",1,0],["ظُهورُ الحَقِّ في العالَمِ","بِالقُدرَةِ وَالعِلمِ",76,"م",1,1],["ظَهَرَت عَلى كُلٍّ بِها وَتَظاهَرَت","أَعلامُ فَصلٍ ما بِها كِتمانُ",77,"ن",1,0],["ظَهَرت دلائلُ لم تَجِد","من دونِ دَولَته ظَهيرا",78,"ر",2,0],["ظهرَت جنايتُها عَلَي","نا للولاةِ على الأمورِ",79,"ر",1,0],["ظهَرَ اللَهُ وَهوَ إِبنُ بَتولٍ","بنت حَوّا وَجَدُّهُ يساءُ",80,"ا",2,0],["ظَهَرنَ بِكِلَّةٍ وَسَدَلنَ رَقماً","وَثَقَّبنَ الوَصاوِصَ لِلعُيونِ",81,"ن",1,0],["ظهرنا للوجود وكلُّ شيءٍ","له بَدْءٌ لعمرك وانتهاء",82,"ا",2,0],["ظهرتم ولا يخفى من الشمس نورها","وحادي انتشار الذكر في ذكركم حدا",83,"د",2,0],["ظهَرتَ لي بجمالٍ","فشُربي ز