iwan.net/poem47986.html","عموديه"],[539,"تشرفت الأحبة بالحضور","https://www.aldiwan.net/poem48189.html","عموديه"],[552,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[552,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[552,"يا طلل الحي بذات النقا","https://www.aldiwan.net/poem47363.html","السريع"],[552,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[552,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[552,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[552,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[559,"فهذه هذه الأبيات أربعة","https://www.aldiwan.net/poem33619.html","البسيط"],[559,"يا طالبا للحجر المكرم","https://www.aldiwan.net/poem34086.html","الرجز"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[562,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[563,"لا تبك ميتا ولا تفرح بمولود","https://www.aldiwan.net/poem52979.html","البسيط"],[564,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[576,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[587,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["فَالحَمدُ يُبقي ذِكرَ كُلِّ فَتىً","وَيُبينُ قَدرَ مَواقِعِ الكَرَمِ",0,"م",1,0],["فَأَلحَمَكَ العِدى حَتّى تَهاوَوا","وَلا دِمَناً تَحِسُّ وَلا ضِبابا",1,"ب",2,0],["فألْحِمْهُمْ سُيوفَكَ إنّ فيها","إذا انْتُضِيَتْ رَغائِبَ تُسْتَفادُ",2,"د",1,0],["فَالحَمدُ لِلَّهِ عَلى ما قَضى","لَم تَدُمِ الدُنيا لِأِنسانِ",3,"ن",1,0],["فَالحَمدُ لِلَّهِ ذي النَعماءِ يا سَكَني","حَمداً كَثيراً لِرَبِّي دائِماً أَبَدا",4,"د",2,0],["فَالحُزنُ إِن سَخَطَت وَالخَوفُ إِن رَضيَت","أَن لا يَتِمَّ الرِضا فَالقَلبُ في تَعَبِ",5,"ب",1,0],["فَالْحَتْفُ فَوْقَ غِرَارِ سَيْفِكَ يَلْتَظِي","وَالرِّزْقُ بَيْنَ بَنَانِ كَفِّكَ يَنْهَمِي",6,"م",2,0],["فَالحَقُّ لا تُلوي بِهِ","تِلكَ السُيوفُ اللامِعَه",7,"ع",2,0],["فَالحَمدُ لِلَّهِ الَّذي قَد رَدَّهُ","مِن بَعدِ غُربَتِهِ إِلى أَوطانِهِ",8,"ن",2,0],["فَالحَمدُ لِلَّهِ شُكراً إِنَّني رَجُلٌ","ما بارَكَ اللَهُ لي إِلّا بِأَضيافي",9,"ي",1,0],["فَالحَمدُ لِلَّهِ لا شَريكَ لَهُ","إِن بَدَأَ الطَولَ مُنعِماً شَفَعَه",10,"ع",2,0],["فَأَلحَقَنا بِالهادِياتِ وَدونَهُ","جَواحِرُها في صَرَّةٍ لَم تُزَيَّلِ",11,"ل",1,0],["فَأَلحَمتَها القَومَ تَحتَ الوَغى","وَأَرسَلتَ مُهرَكَ فيها فَغارا",12,"ر",2,0],["فَأَلحَقنا بِالحَيِّ في رَونَقِ الضُحى","تَغالي المَهارى سَدوُها وَنَسيلُها",13,"ل",3,0],["فالحمد لله على ما به","منَّ علينا من ظهور السنا",14,"ن",2,0],["فَألحَقنَا رَوَافضَهُم ببُبصرَى","حُفَاةً كالرِّئَال ونَاعلينَا",15,"ن",2,0],["فَالحَربُ تَرميني بِبيضِ رِجالِها","وَالدَهرُ يَطرُقُني بِسودِ بَناتِهِ",16,"ت",2,0],["فَاِلحَق بِقَينِكَ قَينِ السوءِ إِنَّ لَهُ","كيراً بِبابِ عَجوزِ السوءِ لَم يَرِمِ",17,"م",1,0],["فالحمد لله على علمك يا","مولايَ إني بشرٌ لا ينقطع",18,"ع",1,0],["فالحبّ عندي وإن طال الملام به","كالجود عند ابن مصري مشرع أمَم",19,"م",1,0],["فالحمدُ لله الذي قدْ صَفَا","مُقَامُنَا من غير واشٍ ولاحْ",20,"ح",1,0],["فالحمد لله ما ينفكُّ من كَمَدٍ","قلبي عليك فقد أودى بيَ الكمدُ",21,"د",1,0],["فالحمد زورٌ عندهمْ","والذمُ من خير الذخائر",22,"ر",1,0],["فالحلم والعلم في أشائبها","والجود والبأس في غرانقها",23,"ق",3,0],["فَالحُبُّ نورٌ خالِدٌ مُتَجَدِّدٌ","لا يَنطَوي إِلّا لِيَسطَعُ نورُ",24,"ر",1,0],["فَالحُبُّ مِنّي فِيَّ وَال","إِعراضُ مِنكُم عَنكُمُ",25,"م",1,0],["فَالحَمدُ لِلَّهِ هَذا","كَ اليَومُ يَومُ السَعادَه",26,"د",2,0],["فالحر من وقود","فالبرد من جليد",27,"د",1,0],["فَاِلحَقِ اليَومَ بِالكِرامِ كَريماً","وَاِلقَهُم بَينَ جَنَّةٍ وَخُلودِ",28,"د",1,0],["فالحَمْدُ لِلّهِ على ما قَدْ حَبَا","لِخَمْسَةِ الأَشْبَاحِ أَصْحابِ العَبَا",29,"ب",2,0],["فالحمدُ للّهِ حَمْداً لا نَفَادَ لَهُ","ما المَرْءُ إلاَّ بِمَا يَحْويْ مِنَ النّسَبِ",30,"ب",1,0],["فَالحَمدُ قَبلُ لَهُ وَالحَمدُ بَعدُ لَها","وَلِلقَنا وَلِإِدلاجي وَتَؤويبي",31,"ب",2,0],["فالحمد لله العلي الذي","من عنده الأفضال والفضلُ",32,"ل",1,0],["فالحبُّ حيثُ العِدَى والأُسدُ رابضَةٌ","نِصالُها بمياه الغَنْجِ والكَحَلِ",33,"ل",1,0],["فالحمدُ مَضروبٌ عليك رِواقُه","والمجدُ مَقْضِيٌّ لديكَ ذِمامُه",34,"م",2,0],["فالحُسْنُ ما يُخْفيهِ من تُفَّاحِه","خَفَراً وما يُبْديه من عُنَّابِه",35,"ب",2,0],["فالحربُ آخذةٌ منكم وتاركةٌ","وإنما حربُ سيفِ الدولةِ الحَرَبُ",36,"ب",1,0],["فَالحُرُّ يَنحَلُ جِسمُهُ إِعدامهُ","وَكَأَنَّهُ مِن جِسمِهِ يُخفيهِ",37,"ي",2,0],["فَالحَمدُ لِلّهِ لا شَريكَ لَهُ","ماليَ قوتٌ وَهَمّيَ الشَرَفُ",38,"ف",1,0],["فَالحَمدُ لِلَّهِ حَمداً لا اِنقِطاعَ لَهُ","ما إِن يُعَظَّمُ إِلّا مَن لَهُ وَرِقُ",39,"ق",1,0],["فَالحَمدُ لِلَّهِ الَّذي","هُوَ لا يَزالُ وَلَم يَزَل",40,"ل",1,0],["فَالحَمدُ لِلَّهِ الَّذي هُوَ دائِمٌ","أَبَداً وَلَيسَ لِما سِواهُ دَوامُ",41,"م",1,0],["فَالحَمدُ لِلَّهِ الَّذي","يَبقى وَيَهلِكُ ما سِواه",42,"ا",2,0],["فَالحَقَّ في أُفُقٍ وَالشُركُ في نَفَقٍ","وَالكُفرُ في فَرَقٍ وَالدينُ في حَرَمِ",43,"م",1,0],["فَالحُسنُ حيثُ وَجَدتُهُ في حَيِّزٍ","هُوَ لي بِأَرسانِ الصَبابَةِ قائِدُ",44,"د",1,0],["فَالحَربُ في لُذَذٍ وَالشِركُ في عَوَذٍ","وَالدينُ في نَشَزٍ وَالكُفرُ في نَفَقِ",45,"ق",1,0],["فَالحِلمُ في بَعضِ المَواطِنِ ذِلَّةٌ","وَالبَغيُ جُرحٌ وَالسِياسَةُ مَرهَمُ",46,"م",1,0],["فَالحُبُّ حَيثُ العِدى وَالأُسدُ رابِضَةٌ","فَلَيتَ أَنّا بِقَدرِ الحُبِّ نَقتَسِمُ",47,"م",1,0],["فالحب آسيه وراءَ عليله","فيهم وبلسمُه على ما يجرحُ",48,"ح",1,0],["فالحَمدُ للَّه مَجرى النورِ من غَسَقٍ","وجاعلِ اللَّيلِ في تَلطيفِ أَحجارِ",49,"ر",1,0],["فالحَظّ فيهِ طَوْعُ كَفّيْ مُظْلِمٍ","بِالجَهلِ مِن نورِ العُلومِ بَلِيدِ",50,"د",1,0],["فَالحَمدُ لِلَّهِ حينَ خَلَّصَني","مِنهُ سَليمَ الأَديمِ مِن نِعَمِه",51,"م",2,0],["فَالحُسنُ مُطَّرَحٌ وَالطيبُ مُفتَضَحٌ","وَالحورُ أَصبَحتَ بَعدَ اللَهِ مَولاها",52,"ا",3,0],["فَأَلحِقِ الروحَ وَجُثمانَهُ","بِوَهدَةِ المُحتَفِرِ اللاحِدِ",53,"د",1,0],["فَالحادِثاتُ بِوَبلِهِ مَصفودَةٌ","وَالمَحلُ في شُؤبوبِهِ مَسجونُ",54,"ن",1,0],["فَالحَمَّةُ البَيضاءُ ميعادٌ لَهُم","وَالقُفلُ حَتمٌ وَالخَليجُ شِعارُ",55,"ر",1,0],["فَالْحُبُّ يُعْمِي عَنِ الْمَسَاوِي","وَالْبُغْضُ يُعْمِي عَنِ الْمَحَاسِنْ",56,"ن",1,0],["فَالْحِلْمُ مَا لَمْ يَكُنْ عَنْ قُدْرَةٍ خَوَرٌ","وَالصَّبْرُ فِي غَيْرِ مَرْضَاةِ الْعُلا نَدَمُ",57,"م",1,0],["فالحسنُ يظهرُ في شيئينِ رونقُهُ","بيتٍ منَ الشعْر أو بيتٍ من الشَّعَرِ",58,"ر",1,0],["فالحكمُ مَتْعَبَةٌ للقلبِ مَغْضَبَةٌ","للربِّ مَجْلَبَةٌ للذنبِ فاجتنبِ",59,"ب",1,0],["فَالحُرُّ مُفتَقِرٌ إِلى عِزِّ الغِنى","فَقرَ الحُسامِ إِلى يَمينِ الفارِسِ",60,"س",1,0],["فَالحِمى مِنهُ حِمى العَرَجِ إِلى","أَظرُبِ الأَحسا إِلى القَصرِ قَمَن",61,"ن",1,0],["فَالحَرجُ لا يَتَناهى","وَالدَخلُ لا يَتَجَزّا",62,"ز",2,0],["فألحَّ الرَّجاء والخوفُ بالقَلْ","بِ ولِلْخَوفِ والرَّجا إِخْفاءُ",63,"ا",2,0],["فالحمدُ للَّهِ فاحْمدُوهُ مَعِي","على خَلاصِي مِنْ هذهِ النِّسْبَهْ",64,"ب",2,0],["فالحُرُّ قد يَقْنى الحَياءَ حفيظَةً","وهو الجَنيبُ إلى الرّدى المملول",65,"ل",1,0],["فَالحُبُّ فيهِ هَناةٌ","مَوصولَةٌ بِهَناةِ",66,"ه",1,0],["فَالحُبُّ ضَيفٌ عَلَيَّ مُعتَكِفٌ","وَالقَلبُ مِن مِحنَةٍ عَلى خَطَرِ",67,"ر",1,0],["فَالحُبُّ ظَهرٌ أَنتَ راكِبُهُ","فَإِذا صَرَفتَ عِنانَهُ اِنصَرَفا",68,"ف",2,0],["فَالحَمدُ لِلَّهِ يا رَفاقَةُ ما","كُلُّ مُحِبٍّ أَيضاً بِمَرزوقِ",69,"ق",1,0],["فَالحُبُّ فَوقي سَحابٌ","وَالحُبُّ تَحتي سُيولُ",70,"ل",1,0],["فَالحَمدُ لِلَّهِ وَإِن كُنتُ لَم","أَحفِل بِقَومٍ نَصَحوا فيهِ",71,"ي",2,0],["فَالحَمدُ لِلّهِ لا شَريكَ لَهُ","لَيسَ بِباقٍ شِيءٌ عَلى الزَمَنِ",72,"ن",1,0],["فَالحَمدُ لِلّهِ لا أُساعِفُ بِال","لَهوِ وَلا أَنتَهي بِمُكتئِبهِ",73,"ب",2,0],["فَالحَمدُ لِلَّهِ عَلى نِعمَةٍ","تُعقِبُ مِن ضَنكٍ وَإِحراجِ",74,"ج",1,0],["فَالحَمدُ لِلَّهِ صابي ما يُزايِلُني","وَلَستُ أَصدُقُ إِن سَمَّيتُهُ شُهُدا",75,"د",2,0],["فَالحَمدُ لِلَّهِ ما نَفسي بِساميَّةٍ","وَلا بَناني عَلى أَيدي العُفاةِ سَدِ",76,"د",1,0],["فَالحَمدُ لِلَّهِ قَلَّ خَيري","وَصارَ قُربي نَظيرَ بُعدي",77,"د",2,0],["فَآلُ حَوّاءَ راعوا الأُسدَ مُخدِرَةً","وَلَم يُنادوا بِسِلمٍ رَبَّةَ الوَجُرِ",78,"ر",1,0],["فَالحَقُّ يَحلِفُ ما عَليٌّ","عِندَهُ إِلّا كَقَنبَر",79,"ر",1,0],["فَالحَمدُ لِلَّهِ ما فارَقتُ سَيِّئَةً","وَكَيفَ لي مِن ضَنى د