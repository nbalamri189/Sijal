275","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89148","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89281","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129364","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109938","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205902",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102959","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86498","الكامل"],[4180,"","https://poetry.dctabudhabi.ae/diwan/poem/144608","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54503","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73396","الخفيف"],[4869,"باقة , الناس للناس","https://www.poetsgate.com/ViewPoem.aspx?id=151580",""],[4875,"حدّ الغماآآم","https://www.poetsgate.com/ViewPoem.aspx?id=141499",""],[5008,"فاقد حنان","https://www.poetsgate.com/ViewPoem.aspx?id=27311",""],[5183,"طائش المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180259",""],[5187,"عيد الجيش","https://www.poetsgate.com/ViewPoem.aspx?id=33001",""],[5431,"على لسان حواء...","https://www.poetsgate.com/ViewPoem.aspx?id=208756",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[402,"اليوم عيد البائس المتألم","https://www.poetsgate.com/ViewPoem.aspx?id=36427",""],[5818,"مُت مثل مَن ماتوا","https://www.poetsgate.com/ViewPoem.aspx?id=180562",""],[5836,"ورزقكم في السماء وماتوعدون","https://www.poetsgate.com/ViewPoem.aspx?id=195163",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[5970,"شيخ بقارعة الطريق معمم","https://www.poetsgate.com/ViewPoem.aspx?id=130663",""],[6201,"كينونة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87476&r=&rc=0",""],[5561,"قل لي من تكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86133&r=&rc=1",""]],"verses":[["مُتَكَلِّفاً أَقتاتُ بِشرَ مَعاشِرٍ","لَهُمُ إِلَيَّ تَشازُرُ الغَيرانِ",0,"ن",1,0],["مُتَكَامِلَ الْوَصْفَيْنِ تَصْ","رِيفِ الأُمُورِ وَالاِفْتِنَانِ",1,"ن",1,0],["مُتَكَلِّفِينِ مِنَ الأُمُورِ أَمَضَّهَا","لِنُفُوسِهِمْ وَنُفُوسُهُمْ لَمْ تَسْأَمِ",2,"م",1,0],["متكفت ضرم السيا","ق إذا تعرضت الجراول",3,"ل",1,1],["مُتَكَرِّماً يَدعو إِلى رَبِّ العُلا","بَذلَ النَصيحَةِ رافِعَ الأَعمادِ",4,"د",1,0],["متكلِّف فوق الطباع مكارماً","سمَّينَه المتكلِّف المطبوعا",5,"ع",2,0],["متَّكلاً فيما بنى وما نظمْ","وما رجا من الأُحاظي والقِسمْ",6,"م",1,0],["متكلِّلاً بالورْدِ ينثرُ للورى","أَوراقَ وردِ اللَّذّةِ المنضُورِ",7,"ر",1,0],["متكفِّئاً لَوْ أنّه جارى الصَّبا","شأواً لَبَاتَ أديمُها مَحْمُوما",8,"م",2,0],["مُتَكَشِّفاً لِعُداتِهِ عَن سَطوَةٍ","لَو حَكَّ مَنكِبُها السَماءَ لَزَعزَعا",9,"ع",2,0],["متكون لونين ذا ذهبٌ","في رمز صبغتنا وذا ورقُ",10,"ق",1,0],["مُتَكَلِّفاً أَجبالَ صاغِرَةٍ بِنا","عَجِلاً يُكَلِّفُنا طِعانَ الأَعلُجِ",11,"ج",1,0],["مُتَكَبِّراتٌ أَن تَكونَ لَهُ قِرىً","وَإِذا بَقينَ بَقينَ لَم تَتَكَبَّرِ",12,"ر",1,0],["مُتَكَرِّمٌ مُتَوَرِّعٌ عَن كُلِّ ما","يَتَجَنَّبُ المُتَكَرِّمُ المُتَوَرِّعُ",13,"ع",1,0],["مُتَكَمِّلاً لَم تَنقَطِع لَكَ سُرَّةٌ","شَرَفاً وَلَم يُطلَق عَلَيكَ خِتانُ",14,"ن",1,0],["متكاملٌ فيها السرورُ لمن بها","يوماً أقامَ كما تكاملَ سورُها",15,"ر",3,0],["متَكَشِّفٌ عن عَزْمَةٍ عَلَوِيّةٍ","للكُفْرِ منها رنّةٌ وعَويل",16,"ل",1,0],["مُتَكَنِّفي جَنبَي عُكاظَ كِلَيهِما","يَدعو بِها وِلدانُهُم عَرعارِ",17,"ر",1,0],["مُتَكَهِّنٌ وَمُنَجِّمٌ وَمُعَزِّمٌ","وَجَميعُ ذاكَ تَحَيُّلٌ لِمَعاشِ",18,"ش",1,0],["مُتَّكِئاً تُقرَعُ أَبوابُهُ","يَسعَى عَلَيهِ العَبدُ بِالكُوب",19,"ب",1,0],["متكرماً يدعو إلى ربّ العلى","بذلَ النصيحةِ رافعَ الأعمادِ",20,"د",1,0],["متكنفي جنبيْ عكاظَ كليهما","، وُفُراً، غَداة َ الرّوعِ والإنفار",21,"ر",1,0],["متكسراً بين الصخور تمُدّهُ","فوقَ الجبال من الثُّلوج طِباق",22,"ق",1,0],["مُتَكَلّفاً أجْيَالَ صَاغِرَةٍ بِنَا،","عَجِلاً، يُكَلّفُنا طِعانَ الأعْلُجِ",23,"ج",1,0],["مُتَّكأي.. خزانتا لآل","وثروتي جواهر وشمعُ",24,"ع",1,0],["مُتَّكِئاً تَخفِقُ أَبوابُهُ","يَسعى عَلَيهِ الغَيدُ بِالكوبِ",25,"ب",1,0],["مت كما شئت فالندامى بلهو","ليس من شأنهم عليك الحداد",26,"د",1,0],["مُتكَورٌ مُسْتوحِشٌ في جُبِّهِ","لَكأنَّهُ عَتْمٌ تفاداهُ السّنا",27,"ن",2,0],["مُتَّكِلا أنَّ له فِطْنةً","تُنِيله العلمَ متى ما طَلَب",28,"ب",1,0],["مُتَكَبِّرٌ عَن أَن يُرى مُتَكَبِّراً","فَلِذاكَ مُكِّنَ في العَلاءِ مَكانُهُ",29,"ن",2,0],["مت كريما في الحب لا تتحمل","لاصطباري البخيل ما عشت منه",30,"ه",1,0],["مُتكلّفاً حفظاً وترتيباً لما","يُلقى على طرزٍ يروق ويمتعُ",31,"ع",1,0],["مُتَكَلِّلاً تاجَ العُلا مُتَجَلِّباً","في مَلبَسِ الإِسعادِ دامَ جَديدُهُ",32,"د",2,0],["مُتَكَفِّنٌ بِمَلابِسٍ حَم","راءَ وَهيَ تَعودُ خَضرا",33,"ر",2,0],["مُت كَتُوماً تَمُت كَريماً فإن بُح","تَ فَسِيَّان بائِحٌ وكَتُومُ",34,"م",1,0],["مُتْ كريماً فالموتُ أجدرُ بالأحرارِ","من عيشِ ذِلّةٍ وهوانِ",35,"ن",1,0],["متكلِّفٌ مَقْتَ النّصيحَةِ مالَهُ","رُشْدُ المحبِّ ولا عليه إن غَوَى",36,"و",2,0],["متكبرٌ يوم الحفيظة والوغى","لكنه في السلم ليس بزاهِ",37,"ا",2,0],["متكفلٌ أَعلى المكارِمِ شِيمَةً","ولَرُبَّما يتكلَّفُ المُتَكَفِّلُ",38,"ل",1,0],["متكَشِّفٌ عن سطوةٍ مذخورَةٍ","للحربِ إِنْ كَشَفَتْ لَهُ عن ساقِها",39,"ق",3,0],["مُتَكَرِّماتٍ أَن يُناطِحَ كَبْكَباً","من كَانَ فِي فَلَكِ المعالِي كوْكبا",40,"ب",2,0],["متكلَّمات بالأنامل أبرز ال","جاديُّ عاطلَها لعينك حاليا",41,"ي",2,0],["مِتْكِينُ بصرَتُنا وأَحمد أَحمدُ","نسعَى إِلى تلك البِقاعِ ونحفَدُ",42,"د",1,1],["مُتكملاً في ذاتِهِ وَصِفاتِهِ","مُتحَققاً في جَمعِهِ بِوَلائِهِ",43,"ا",3,0],["مُتَكَاثِفِ الأَنْوَاءِ مُنْغَدِقِ الحَيَا","هَطِلِ النَّدَى هَزِمِ الرُّعُودِ مُجَلْجِلِ",44,"ل",1,0],["متكبِّرُ الكَرَمِ الذي من كِبْرِه","حَقَر اللُّجَيْنَ وجَاد بالعِقْيان",45,"ن",1,0],["مُت كَمَداً يا عَدُو قاسِم فالغُصَّ","ةُ تَأتي عَلَيكَ والشَّرَق",46,"ق",1,0],["مُتَكَرِّمٌ في حينَ لا مُتَكرِّمٌ","مُتَجَرِّدِّ في حين لا مُتَجَرِّدُ",47,"د",1,0],["متكرر في كل صورة صورة","تكرار باسم اللَه في القرآن",48,"ن",1,0],["متكهلاً عصر الشبا","ب بمنسك الشيخ الكبير",49,"ر",1,0],["متكاتفين على العدى وسلاحهم","ماضي الغرار بقوة الإيمان",50,"ن",1,0],["م