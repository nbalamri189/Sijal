{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[93,"أبدت بواكير الجنان","https://www.aldiwan.net/poem11274.html","مجزوء الكامل"],[93,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[37,"متكفت ضرم السياف","https://www.aldiwan.net/poem7406.html","مجزوء الكامل"],[23,"والله ربي لا نفارق ماجدا","https://www.aldiwan.net/poem21417.html","الكامل"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[51,"حق الأديب لازم لذي الكرم","https://www.aldiwan.net/poem66033.html","الرجز"],[92,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[56,"وأحم من أولاد أعوج عجته","https://www.aldiwan.net/poem58503.html","الكامل"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[62,"أجساد صنعتنا مركبة","https://www.aldiwan.net/poem52142.html","أحذ الكامل"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[45,"مغنى منازلها التي بمشقر","https://www.aldiwan.net/poem63594.html","الكامل"],[45,"شوق إليك تفيض منه الأدمع","https://www.aldiwan.net/poem64712.html","الكامل"],[66,"خمدت لفضل ولادك النيران","https://www.aldiwan.net/poem41545.html","الكامل"],[69,"برية بحرية حزنية","https://www.aldiwan.net/poem29299.html","الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[7,"نبئت زرعة والسفاهة كاسمها","https://www.aldiwan.net/poem1995.html","الكامل"],[46,"أوقدت نارا بإفتكارك أظهرت","https://www.aldiwan.net/poem22867.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20990","السريع"],[23,"واللهِ ربي لا نفارقُ ماجداً","https://www.poetsgate.com/ViewPoem.aspx?id=11419",""],[7,"نبئتَ زرعة َ ، والسفاهة ُ كاسمها","https://www.poetsgate.com/ViewPoem.aspx?id=17567",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[45,"لمْ يَبقَ، في تلكَ الرّسُومِ بمَنْعِجِ","https://www.poetsgate.com/ViewPoem.aspx?id=33107",""],[99,"الى ضفيرتي ماس","https://www.poetsgate.com/ViewPoem.aspx?id=36371",""],[20,"للشرف العود فأَكنافه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69761&r=&rc=2",""],[124,"أين جمشيد ابن كايو كباد","https://www.aldiwan.net/poem23713.html","الخفيف"],[178,"الطريد","https://www.aldiwan.net/poem50688.html","الكامل"],[185,"احفظ ولا تنس فإن لم تكن","https://www.aldiwan.net/poem14105.html","السريع"],[282,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[303,"لا تسل يا فؤاد صبري لأني","https://www.aldiwan.net/poem58098.html","الخفيف"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[320,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[366,"لهفي لمقتول تلا","https://www.aldiwan.net/poem17348.html","مجزوء الكامل"],[371,"ما لريم الكناس ليس يريم","https://www.aldiwan.net/poem57152.html","الخفيف"],[402,"أأطيع العذول في السلوان","https://www.aldiwan.net/poem46429.html","الخفيف"],[409,"بأبي هوى فارقته ولمثله","https://www.aldiwan.net/poem32342.html","الكامل"],[429,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[432,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[439,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[439,"أهلا بمن قهر الملوك ومرحبا","https://www.aldiwan.net/poem34865.html","الكامل"],[458,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[500,"متكين بصرتنا وأحمد أحمد","https://www.aldiwan.net/poem38030.html","الكامل"],[524,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[567,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[575,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"]],"verses":[["مُتَكَلِّفاً أَقتاتُ بِشرَ مَعاشِرٍ","لَهُمُ إِلَيَّ تَشازُرُ الغَيرانِ",0,"ن",1,0],["مُتَكَامِلَ الْوَصْفَيْنِ تَصْ","رِيفِ الأُمُورِ وَالاِفْتِنَانِ",1,"ن",1,0],["مُتَكَلِّفِينِ مِنَ الأُمُورِ أَمَضَّهَا","لِنُفُوسِهِمْ وَنُفُوسُهُمْ لَمْ تَسْأَمِ",2,"م",1,0],["متكفت ضرم السيا","ق إذا تعرضت الجراول",3,"ل",1,1],["مُتَكَرِّماً يَدعو إِلى رَبِّ العُلا","بَذلَ النَصيحَةِ رافِعَ الأَعمادِ",4,"د",1,0],["متكلِّف فوق الطباع مكارماً","سمَّينَه المتكلِّف المطبوعا",5,"ع",2,0],["متَّكلاً فيما بنى وما نظمْ","وما رجا من الأُحاظي والقِسمْ",6,"م",1,0],["متكلِّلاً بالورْدِ ينثرُ للورى","أَوراقَ وردِ اللَّذّةِ المنضُورِ",7,"ر",1,0],["متكفِّئاً لَوْ أنّه جارى الصَّبا","شأواً لَبَاتَ أديمُها مَحْمُوما",8,"م",2,0],["مُتَكَشِّفاً لِعُداتِهِ عَن سَطوَةٍ","لَو حَكَّ مَنكِبُها السَماءَ لَزَعزَعا",9,"ع",2,0],["متكون لونين ذا ذهبٌ","في رمز صبغتنا وذا ورقُ",10,"ق",1,0],["مُتَكَلِّفاً أَجبالَ صاغِرَةٍ بِنا","عَجِلاً يُكَلِّفُنا طِعانَ الأَعلُجِ",11,"ج",1,0],["مُتَكَبِّراتٌ أَن تَكونَ لَهُ قِرىً","وَإِذا بَقينَ بَقينَ لَم تَتَكَبَّرِ",12,"ر",1,0],["مُتَكَرِّمٌ مُتَوَرِّعٌ عَن كُلِّ ما","يَتَجَنَّبُ المُتَكَرِّمُ المُتَوَرِّعُ",13,"ع",1,0],["مُتَكَمِّلاً لَم تَنقَطِع لَكَ سُرَّةٌ","شَرَفاً وَلَم يُطلَق عَلَيكَ خِتانُ",14,"ن",1,0],["متكاملٌ فيها السرورُ لمن بها","يوماً أقامَ كما تكاملَ سورُها",15,"ر",3,0],["متَكَشِّفٌ عن عَزْمَةٍ عَلَوِيّةٍ","للكُفْرِ منها رنّةٌ وعَويل",16,"ل",1,0],["مُتَكَنِّفي جَنبَي عُكاظَ كِلَيهِما","يَدعو بِها وِلدانُهُم عَرعارِ",17,"ر",1,0],["مُتَكَهِّنٌ وَمُنَجِّمٌ وَمُعَزِّمٌ","وَجَميعُ ذاكَ تَحَيُّلٌ لِمَعاشِ",18,"ش",1,0],["مُتَّكِئاً تُقرَعُ أَبوابُهُ","يَسعَى عَلَيهِ العَبدُ بِالكُوب",19,"ب",1,0],["متكرماً يدعو إلى ربّ العلى","بذلَ النصيحةِ رافعَ الأعمادِ",20,"د",1,0],["متكنفي جنبيْ عكاظَ كليهما","، وُفُراً، غَداة َ الرّوعِ والإنفار",21,"ر",1,0],["متكسراً بين الصخور تمُدّهُ","فوقَ الجبال من الثُّلوج طِباق",22,"ق",1,0],["مُتَكَلّفاً أجْيَالَ صَاغِرَةٍ بِنَا،","عَجِلاً، يُكَلّفُنا طِعانَ الأعْلُجِ",23,"ج",1,0],["مُتَّكأي.. خزانتا لآل","وثروتي جواهر وشمعُ",24,"ع",1,0],["مُتَّكِئاً تَخفِقُ أَبوابُهُ","يَسعى عَلَيهِ الغَيدُ بِالكوبِ",25,"ب",1,0],["مت كما شئت فالندامى بلهو","ليس من شأنهم عليك الحداد",26,"د",1,0],["مُتكَورٌ مُسْتوحِشٌ في جُبِّهِ","لَكأنَّهُ عَتْمٌ تفاداهُ السّنا",27,"ن",2,0],["مُتَّكِلا أنَّ له فِطْنةً","تُنِيله العلمَ متى ما طَلَب",28,"ب",1,0],["مُتَكَبِّرٌ عَن أَن يُرى مُتَكَبِّراً","فَلِذاكَ مُكِّنَ في العَلاءِ مَكانُهُ",29,"ن",2,0],["مت كريما في الحب لا تتحمل","لاصطباري البخيل ما عشت منه",30,"ه",1,0],["مُتكلّفاً حفظاً وترتيباً لما","يُلقى على طرزٍ يروق ويمتعُ",31,"ع",1,0],["مُتَكَلِّلاً تاجَ العُلا مُتَجَلِّباً","في مَلبَسِ الإِسعادِ دامَ جَديدُهُ",32,"د",2,0],["مُتَكَفِّنٌ بِمَلابِسٍ حَم","راءَ وَهيَ تَعودُ خَضرا",33,"ر",2,0],["مُت كَتُوماً تَمُت كَريماً فإن بُح","تَ فَسِيَّان بائِحٌ وكَتُومُ",34,"م",1,0],["مُتْ كريماً فالموتُ أجدرُ بالأحرارِ","من عيشِ ذِلّةٍ وهوانِ",35,"ن",1,0],["متكلِّفٌ مَقْتَ النّصيحَةِ مالَهُ","رُشْدُ المحبِّ ولا عليه إن غَوَى",36,"و",2,0],["متكبرٌ يوم الحفيظة والوغى","لكنه في السلم ليس بزاهِ",37,"ا",2,0],["متكفلٌ أَعلى المكارِمِ شِيمَةً","ولَرُبَّما يتكلَّفُ المُتَكَفِّلُ",38,"ل",1,0],["متكَشِّفٌ عن سطوةٍ مذخورَةٍ","للحربِ إِنْ كَشَفَتْ لَهُ عن ساقِها",39,"ق",3,0],["مُتَكَرِّماتٍ أَن يُناطِحَ كَبْكَباً","من كَانَ فِي فَلَكِ المعالِي كوْكبا",40,"ب",2,0],["متكلَّمات بالأنامل أبرز ال","جاديُّ عاطلَها لعينك حاليا",41,"ي",2,0],["مِتْكِينُ بصرَتُنا وأَحمد أَحمدُ","نسعَى إِلى تلك البِقاعِ ونحفَدُ",42,"د",1,1],["مُتكملاً في ذاتِهِ وَصِفاتِهِ","مُتحَققاً في جَمعِهِ بِوَلائِهِ",43,"ا",3,0],["مُتَكَاثِفِ الأَنْوَاءِ مُنْغَدِقِ الحَيَا","هَطِلِ النَّدَى هَزِمِ الرُّعُودِ مُجَلْجِلِ",44,"ل",1,0],["متكبِّرُ الكَرَمِ الذي من كِبْرِه","حَقَر اللُّجَيْنَ وجَاد بالعِقْيان",45,"ن",1,0]]}