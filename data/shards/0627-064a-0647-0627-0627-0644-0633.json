"قل لهند","https://www.poetsgate.com/ViewPoem.aspx?id=195182",""],[5883,"جند حماس","https://www.poetsgate.com/ViewPoem.aspx?id=23878",""],[5916,"أيُّهَا الْسَارِحُ","https://www.poetsgate.com/ViewPoem.aspx?id=190588",""],[5956,"أيها الباخلُ","https://www.poetsgate.com/ViewPoem.aspx?id=192943",""],[5957,"أمل الدُنيا","https://www.poetsgate.com/ViewPoem.aspx?id=22805",""],[5970,"غالبتني في لذة العيش نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=130587",""],[5970,"أيها الثاوي الذي ليس يزار","https://www.poetsgate.com/ViewPoem.aspx?id=130675",""],[6032,"ما على الدهر عتب","https://www.poetsgate.com/ViewPoem.aspx?id=181506",""],[402,"أيها الفرسان رواد السماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53157&r=&rc=9",""],[5001,"أيها الساري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80724&r=&rc=14",""]],"verses":[["أَيُّها السائِلي عَن اِبنَةِ عَوفٍ","لَكَأَنّي مِن شَأنِها مَحزونُ",0,"ن",1,0],["أَيُّها السَيِّدُ الأَجَلُّ عَفيفَ ال","دينِ زينَ الحِجى وَحلفَ الوقارِ",1,"ر",1,0],["أَيُّها السَيِّدُ الَّذي جَعَلَ الشِر","كَ حُطاماً وَشَيَّدَ الإِسلاما",2,"م",2,1],["أيها السابح في بحر الفنون","غائصاً في لُجّها الملتطِم",3,"م",1,0],["أَيُّها السائِلُ عَن قِصَّتِنا","لَو تَرانا لَم تُفَرِّق بَينَنا",4,"ن",2,0],["أيها السائلي به","وضَحَ الصُّبحُ فانبلَجْ",5,"ج",1,0],["أيها السيد الذي ورث السؤ","دد عن كل سيد صندِيدِ",6,"د",1,1],["أيها السائل عن أخلاقه","في الجدا ذوْبٌ وفي الدِّين جُمودُ",7,"د",1,0],["أيها السيدُ الجليل أطال ال","لَهُ في طُولِ مُدَّةٍ تأييدَكْ",8,"ك",1,0],["أيها السيدُ الجليلُ أدامَ ال","لَهُ في طول مدَّةٍ تأييدَكْ",9,"ك",1,1],["أيّها السيدُ الذي اختاره السيْ","يِدُ إلفاً وموضعاً للخِلالِ",10,"ل",1,1],["أيها السيدُ الذي ليس تنفكْ","كُ أياديه عندنا موصولهْ",11,"ل",2,0],["أيها السائلي بجمعِ ابن ليث","لجَّ ذاك النعامُ في الإجفالِ",12,"ل",1,0],["أيها السيد الذي فاق في الجو","دِ وتمَّ الحجا له والوسامُ",13,"م",1,1],["أيُّها السائِلي بها كيفَ حَمْدِي","لجَداها لقيت عندي بيانا",14,"ن",2,0],["أيها السيِّدُ الذي جَلَّ عَنْ شك","رِيَ مَعْروفُه وجاز التَّمنِّي",15,"ن",2,1],["أيها السيدُ المُحَجَّب عني","أنت لي واقفٌ على حالتيكا",16,"ك",2,0],["أَيُّها السائِلُ عَنّي مَن أَنا","أَنا كَالشَمسِ إِلى الشَرقِ اِنتِسابي",17,"ب",2,0],["أَيُّها السائِلُ عَن وَجدي بِها","إِنَّهُ أَعظَمُ مِمّا تَزعُمُ",18,"م",1,0],["أَيُّها السائِلُ عَنّي","مَذهَبي في الحُبِّ مَذهَب",19,"ب",1,0],["أيها السيد لطفى","لست والله جليدا",20,"د",2,1],["أَيُّها الساكِنُ في ظِلِّ المُنى","نَم طَويلاً قَد تَوَسَّدتَ الزَهَر",21,"ر",1,0],["أَيّها السّائلُ عَنِّي","لَسْتَ بِي أَخْبَرَ مِني",22,"ن",2,1],["أَيُّها السائِلُ عَن لَذَّتِنا","لَذَّةُ العَيشِ الرَعابيبُ الخُرُد",23,"د",1,0],["أيُّها السَّيِّدُ الذي راحتاهُ","مُزنَةٌ ما لصَوْبِها إقلاعُ",24,"ع",1,1],["أَيُّها السارِقُ عَقلي","لا تَضِنَّنَّ بِرَدِّه",25,"د",2,0],["أيها الساحر لم تض","رب بقوس بل عصاة",26,"ه",1,0],["أيها الساكن عيني ودمي","أين في الدنيا مكان لست فيه",27,"ه",1,0],["أَيُّها السابِقُ المُسامِحُ في اللَذ","ذاتِ وَالقَصفِ أَينَ ذاكَ الحِرانُ",28,"ن",1,0],["أَيُّها السائِلُنا عَن حُبِّها","تُكثِرُ المَنطِقَ في غَيرِ اِتِّضاح",29,"ح",1,0],["أَيُّها السائر المَجدّ رويداً","وَاخفض الطَرف عِندَها اِجلالا",30,"ل",2,0],["أَيُّها السائِلي عَنِ الحَسَبِ الأَط","يَبِ ما فَوقَهُ لِخَلقٍ مَزيدُ",31,"د",1,0],["أَيُّها السائِلُ عَنها","اِسمَعِ اللَفظَ المُحَلّي",32,"ل",2,0],["أَيُّها السَاقِيانِ صُبّا شَرابي","وَاِسقِياني مِن ريقِ صَفراءَ رودِ",33,"د",1,0],["أَيُّها السائِلي عَنِ الحَزمِ وَالنَج","دَةِ وَالبَأسِ وَالنَدى وَالوَفاءِ",34,"ا",2,0],["أَيُّهَا السَّاهِرُونَ حَوْلَ وِسَادِي","لَسْتُ مِنْكُمْ أَوْ تَذْكُرُوا لِيَ نَجْدَا",35,"د",2,0],["أَيُّها السَّادِرُ قُلْ لِي","أَيْنَ ذَاكَ الْجَبَرُوتُ",36,"ت",1,0],["أَيُّهَا السادَةُ الأُولى اجْتَمَعُوا الْيَوْ","مَ لِمَعْنىً أَوْحَاهُ سَامِي الشُّعُورِ",37,"ر",1,0],["أيُّهَا السِّرْبُ المُوَافِي وَبِهِ","عَن فَقِيدَيْهِ العَزِيزَيْنِ عَزَاءْ",38,"ا",2,0],["أَيُّهَا السَّيِّدَاتُ وَالسَّادَةُ الأَمْ","جَادُ دامَتْ لَهُمْ عُلاهُمْ وَدَامُوا",39,"م",3,0],["أَيُّهَا السُّوقَةُ كُلٌّ مِنْهُمُ","مَلِكٌ قَدْ تَوَّجَتْهُ الهَبَوَاتُ",40,"ت",1,0],["أيها السابقُ المجلِّي، عزاءً","إنْ رأيتَ العرجاء تُحرزُ سبقا",41,"ق",2,0],["أيها السدُّ، ما عَهِدْناك إِلاَّ","مَصْدَرَ اليُمْن، مصدرَ البركات",42,"ت",1,0],["أيها السيِّدُ الذي وهَنَتْ","أنصارُ موالِهِ ولم يَهِن",43,"ن",1,1],["أيها الساحر بالحسن لنا","وعد الدهر لنا أن يخضعك",44,"ك",1,0],["أَيُّها السَّائِلُ عَنِّي","وَهْوَ يَدْرِي سُوءَ حالِي",45,"ل",2,0],["أَيُّهَا السَّيِّدُ المُعَظَّمُ قَدراً","فِي صُدُورٍ وَأَعيُنٍ وَقُلُوبِ",46,"ب",1,1],["أيها السيد استجارت بك الأي","يامُ واستنصرت بك الأشعارُ",47,"ر",1,0],["أيها السيد الذي طاب في المج","د فروعاً كريمة وأصولا",48,"ل",2,1],["أيها السائل عن حا","لي أنا المضروب زيدٌ",49,"د",1,1],["أَيُّها الساقي إِلَيكَ المُشتَكى","قَد دَعَوناكَ وَإِن لَم تَسمَع",50,"ع",1,1],["أيّها السيّد الوزير الّذي قد","خصّه اللّه بالسجايا العذابِ",51,"ب",1,0],["أَيُّها الساقي سَقَتهُ مَزنَةٌ","مِن رَبيعٍ ذي أَهاضيبَ وَطَش",52,"ش",1,0],["أيها الساكن والو","كب بالأقدار يجري",53,"ي",1,0],["أيّها السامرُ الملوّحُ بالنش","وَةِ من سكره بخمر الأغاني",54,"ي",1,0],["أَيُّها السَّائِلُ عَنّي إنَّني","قَد تَحامى الجُود عَنّي واعتَصَمْ",55,"م",1,1],["أَيُّها السادَة هنّئتم فَلقَد","منحَ اللَه لَكُم ما مَنَحا",56,"ح",2,0],["أَيُّها السَيد الشَريف أَتانا","مِنكَ لما أَن سرت عنا كتاب",57,"ب",1,1],["أيُّها السائلُ الحبيبُ، تمهَّلْ","قبل أنْ تُلْبِسَ السُّؤالَ العتابا",58,"ب",2,0],["أيُّها السائل المعاتب، مهل","فوجوه الأحداثِ تبدو غِضَابا",58,"ب",2,0],["أَيُّها السَّائلونَ عنّي مَهْلاً","أنا مِن نَبْعَةِ المليكِ الهُمَامِ",59,"م",1,0],["أيّها السَّائِلُ عَنّي جاهِلاً","أنا مَنْ قد عَلِمَ الناسُ مكاني",60,"ن",2,0],["أيُّها السَّيِّدُ صَبْراً","في المُصيبات المُلِمَّه",61,"م",2,1],["أيُّها السَّاقي وَهَبْ لي قُبلةً","هبةً منك بإحسان وجود",62,"د",1,0],["أيها الساقي أدرها","إن وقت الانس دارك",63,"ك",1,1],["أَيُّها السّائِلُ عن ناظِرِنا","قد نَفَى عَنْهُ عماهُ الرَّمَدَا",64,"د",2,1],["أيها السائق المجد ترفّق","بالمطايا فقد أتيت السماء",65,"ا",2,0],["أيها السارق الحقير الذي","يزهى بمسلوب غيره مطمئنا",66,"ن",2,0],["أيها السائل عن سقمي أفحمت لساني","رؤيتي تنطق عن صمتي لو كنت ت