ttps://poetry.dctabudhabi.ae/diwan/poem/93861","الخفيف"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146349","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101601","الخفيف"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124003","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89258","الخفيف"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103017","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114045","الرمل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136424",""],[4750,"قبة الفرو","https://www.poetsgate.com/ViewPoem.aspx?id=180419",""],[5127,"العامل","https://www.poetsgate.com/ViewPoem.aspx?id=177317",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5461,"طالت القامات","https://www.poetsgate.com/ViewPoem.aspx?id=5039",""],[470,"القافلة","https://www.poetsgate.com/ViewPoem.aspx?id=178094",""],[5739,"برج الهواوي ورادار العشير ..!","https://www.poetsgate.com/ViewPoem.aspx?id=130849",""],[5739,"أرحب يالهلاك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155471",""],[5823,"درب الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=59186",""],[6164,"ماض وحاضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66043&r=&rc=52",""]],"verses":[["بين بني الشام من","باد بهم وحاضر",0,"ر",1,0],["بين بغداد والحديثة يخصمْ","نَ بها الريفَ آمنات الرعالِ",1,"ل",1,0],["بَينَ بَني المَنصورِ وَالكامِلِ ال","أَخلاقِ وَالسَجّادِ وَالحَبرِ",2,"ر",1,0],["بين بيروت وبغداد ترى","منه في الشعر الكريماتِ الحسانا",3,"ن",2,0],["بَينٌ بلا أملِ اللِّقاءِ","وَسَفرَةٌ تَزدادُ سُحقا",4,"ق",2,0],["بين بلُقٍ منه يُغِير بها الصب","حُ وأخرَى دُهْمٍ توافيك وَهْنا",5,"ن",2,0],["بين باغ والرُّمحُ حَشْو حَشاهُ","وعَدُوٍّ وَريدُه مَوْرود",6,"د",1,0],["بين بني العاهات منبوذةً","يزاحم الأعمى بها الأعورا",7,"ر",2,0],["بينَ بيضٍ تحول من دونها ال","بيضُ وسمرٍ حيرَّننا أسمارا",8,"ر",2,0],["بينَ بَيْتَيْ نعيمِهِ ولَظاهُ","أَيُّ بيتٍ أَرادَ فيه دَخَلْنَا",9,"ن",2,0],["بينَ بِطاحِ حَيِّهمْ والأبطحِ","طَرحْتُ روحاً عنهُمُ لم تَبْرَحِ",10,"ح",1,1],["بَيْنَ بان الحِمَى وَبانِ المُصَلَّى","فَاتِناتٍ مِنَ الظِّبَاءِ الجَوازِي",11,"ز",2,1],["بين بساتين ميادينها","من سارق للب أو غاصب",12,"ب",1,0],["بين باب ابرز ونهر المعلى","ظبيات لهن أسرى وقتلى",13,"ل",2,1],["بين بانات ضارج والمصلى","كم خرود زانت بأزهى قدود",14,"د",1,0],["بَينَ بَيَاضِ الظّلمِ مِنهَا وَاللَّمَى","أقولُ والدمعُ يسُحُّ مُسبَلا",15,"ل",2,0],["بينبوع سراسم العليم أمدني","وجل لعقلي كنه كل حقيقة",16,"ه",1,0],["بين بيض إذا رءاهن راء","خال ما تحت ربطهنّ رمالا",17,"ل",2,0],["بين برديه سليل خالص","من نفوس ليس فيها ما يعاب",18,"ب",1,0],["بين بلبالٍ واهوالٍ وبين","ما احتيالي خانئي الصبر وقد",19,"د",1,0],["بين بان اللِّوى وهضب الكثيبِ","مقل أولعت بنهب القلوبِ",20,"ب",1,1],["بين بدر يستضاء به","بين دياجي وعرة السبل",21,"ل",1,0],["بين بيض الظبيى وسمر الأَسنَّه","نالت القصد نفسك المطمئنّه",22,"ن",2,1],["بَينَ بصرَى وَضُمَير عَرَب","يَأمَنُ الخائِفُ فيهِم ما جَنى",23,"ن",2,0],["بَينَ بَني جَحجَبي وَبَينَ بَني","كُلفَةَ أَنّى لِجارِيَ التَلَفُ",24,"ف",1,0],["بَينَ بَحرَي شَهدٍ وَدارا عَلَيها","كَسُوارٍ بِمِعصَمٍ لا يَريمُ",25,"م",1,0],["بين بهار زها وورد","أكليله بالندا تكلل",26,"ل",1,0],["بين بحر عذب وبحر أجاج","يظهر الفرق بين البرهان",27,"ن",1,0],["بين بيضٍ تجُودُ بالمُهَج الحُمْ","ر، وصُفْرٍ تجود بالأبْدان",28,"ن",1,0],["بين برقٍ من الشرارات وما","ضٍ ورعدٍ ملعلعٍ في صياحه",29,"ح",2,0],["بينَ بيضٍ أوانس ناعماتٍ","يستَلِبنَ المواصلينَ العقولا",30,"ل",2,0],["بين برش في أرضهم وحشيش","وذهول يا نفس هلا تفيقي",31,"ق",2,0],["بين بالخلف وعكس الكبرى","وبينوا أيضاً بعكس الصغرى",32,"ر",2,0],["بينٌ براني بري العضب للقلم","وسلّ من جفن عيني صارم الحلم",33,"م",1,1],["بينبوعين من زن","ثٍ تؤم رباهما الحور",34,"ر",1,0],["بين بنتين وهاك نص ما","قالتاه بعد ما اختصر",35,"ر",1,0],["بين بحرين مشتهى ذو صنوف","من ثمار ومن رياحين ساده",36,"د",2,0],["بين بوك وبين بن عوّاد زيزوم السرايا","زاين حظك يا بو تركي وحظ الخال زاين",37,"ن",1,0],["بينَ بردٍ أو غبارٍ أو لهبْ","ساحةُ الجِدِّ تراهُ قد نزلْ",38,"ل",1,0],["بين بحث عن نفسه في ركام","ظل يعلو بما به من خداع",39,"ع",1,0],["بين بارود البنادق والسيوف","بالمحبة عانق الشعب الامير",40,"ر",1,0],["بين بابَيْ مَخافَةٍ ورجاءٍٍ","يرجفُ العمرُ كارتجاف الذُّبالِ!",41,"ل",1,0],["بين برج ٍ للهواوي .. ورادار العشير.","إستلام ٍ للمشاعر وبعض الانظمه.",42,"م",2,0],["بين بير الجوف .... والسر الدفين.","طفل ميثاقٍ شرب حمرة شفاك.",43,"ك",1,0],["بين بوح وأمنيات مضينا","وتجاوزنا قهرنا والصعابا",44,"ب",2,0],["بِيَنْبُوعها الحالي.. بِشَدْوِ طُيُورِها","بِآلائِها من كُلِّ غالٍ ومُمْتِعِ!",45,"ع",1,0]]}