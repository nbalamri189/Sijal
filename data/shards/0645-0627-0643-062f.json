{"poems":[[95,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[29,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[91,"طلعت كقرن الشمس بعد تبرقع","https://www.aldiwan.net/poem44950.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[343,"لا يغلبنك غالب الحرص","https://www.aldiwan.net/poem68745.html","أحذ الكامل"],[353,"ماكدت تكحل أرقدا","https://www.aldiwan.net/poem20747.html","مجزوء الكامل"],[361,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[458,"ما اسكندر اليازجي اليوم أعرفه","https://www.aldiwan.net/poem61793.html","البسيط"],[469,"عج بالحمى مهفهفات غصونه","https://www.aldiwan.net/poem3241.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63894","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77654","المتدارك"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/199360","السريع"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/120174","السريع"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80215","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87840","الكامل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124056","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201710","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205033","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62802","الكامل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141679","الكامل"],[4927,"غيابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29828",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[5183,"روض الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180204",""],[402,"طيبوا قرارا أيها الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=36333",""]],"verses":[["مَا كِدْتَ تَمْكُثُ وَادِعاً فِي مَأْمَنٍ","إِلاَّ وَحَوْلَكَ لِلصُّرُوفِ زِحَامُ",0,"م",1,0],["ما كِدتَ تَعرِفُ هَذا الرَبعَ غَيَّرَهُ","مَرُّ السِنينَ كَما غَيَّرنَ أَجلادي",1,"د",2,0],["ما كدت تنجو يا عذولُ من الهوى","لو كنت يوم بدت سعاد بموضعي",2,"ع",2,0],["ما كدَّرَتْ من روحيَ المشرقِ","تلك الليالي القُلَّبُ المظلماتْ",3,"ت",1,0],["مَا كِدْتُ أَقْرأُ مُعْجِزَ الْ","قُرْآنِ فِي ذَاكَ النِّظَامِ",4,"م",1,0],["ما كِدتُ أَفحَصُ عَن أَخي ثِقَة","إِلّا ذَمَمتُ عَواقِبَ الفَحصِ",5,"ص",1,0],["مَاكِدْتَ تَكحُلُ أَرقداً","خُبْثاً لِتحرِمَهُ الوَسَنْ",6,"ن",1,1],["ما كدرا مجلسا يوماً على أحد","لا في الرضا منهما كلا ولا السخط",7,"ط",1,0],["ما كدت أعرف ألطافاً تَمثَّلها","حتىّ تغيبَّ واستبقاه هاووها",8,"و",3,0],["ما كدت تغلبني جيوش جماله","لولا العذار يمدها بكمينه",9,"ن",2,0],["ما كدتُ أكتمهمْ وجدي بنرجِسهِ","إِلاَّ استدلُّوا على وجدي بأنفاسي",10,"س",2,0],["ما كَدِّبُوهاشِ اللي قالوا","خير تعمل شَرٍّ تلقى",11,"ق",2,0],["ما كدَّر الصفو وغال الوفا","وما لذاك الصّدق في الود مان",12,"ن",1,0],["ما كدر الوصل وغال الوفا","وما لذاك الصدق في الود مان",13,"ن",1,0],["ما كَدَّرتها فِتنَةٌ بادَرتها","في هِمَةٍ تَدعُ الأَبيَّ ذَليلا",14,"ل",2,0],["ما كِدتُ أَنقَهُ مِن تَباريحِ الهَوى","حَتّى أُصِبتُ مِنَ الهَوى بِنُكاسِ",15,"س",1,0],["ما كدت لولا النؤى أعرف رسمها","ومعارف العرصات والقيعان",16,"ن",1,0],["ما كدت أن أقول ما أجملهُ","حتى صرخت قائلاً ما أبشعا",17,"ع",2,0],["ما كدت أخرج سالما من هوة","حتى هويت بهوة وقيود",18,"د",1,0],["ما كِدتُ اعرفُ عيبَ من احببتُهُ","حتى سلوتُ فصرتُ لا أَشْتَاقُ",19,"ق",1,0],["ما كدتُ أُعطي الوصلَ ثِنيَ عِنانِهِ","حتى تغيّر بالجَموحِ حِرانُهُ",20,"ن",2,0],["ما كِد نِظَرتَهْ باهِلٍ فِيْ الطريجِ","مِدَّة زِمانَه فِيْ مِقَرَّه مِضايِج",21,"ج",1,0],["ما كدت أدري رسمه لولا شذا","عرْف إليه كان منه دليلا",22,"ل",2,0],["مَاْ كِدْتُ أَغْفُوْ سُوَيْعَاْتٍ ظَفِرْتُ بِهَاْ","حَتَّىْ أَفَقْتُ عَلَىْ صَوْتِ الْعَصَاْفِيْرِ!",23,"ر",1,1],["ما كدت أدخل بابه حتى رأت","عيناي ما لم تحتسبه ظنوني",24,"ن",2,0],["ما كدت أقرؤها فأملك من","نفسي الطموح وهكذا الذمر",25,"ر",1,0],["ما كدت تمكث وادعا في مأمن","لا وحولك للصروف زحام",26,"م",1,0]]}