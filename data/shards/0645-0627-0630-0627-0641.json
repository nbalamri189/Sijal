{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[102,"أبو تمام وعروبة اليوم","https://www.aldiwan.net/poem23694.html","عموديه"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[108,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[92,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[102,"ليلة فارس الغبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67737&r=&rc=224",""],[228,"مغناك ملتهب وكأسك مترعه","https://www.aldiwan.net/poem41598.html","الكامل"],[275,"سلت مهندها فخف من حده","https://www.aldiwan.net/poem35414.html","الكامل"],[366,"يا أيها الظبي الذي","https://www.aldiwan.net/poem68056.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122607","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77530","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77474","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65029","المجتث"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77336","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102563","الكامل"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120159","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91378","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75680","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107478","الرجز"],[4684,"عود","https://www.poetsgate.com/ViewPoem.aspx?id=201338",""],[4755,"الشَّوقُ كانَ سُؤَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184674",""],[5106,".. إِنَّ النِّفْطَ قَدْ جَبُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=151384",""],[5121,"وَاهٍ لِقَوْلِكَ","https://www.poetsgate.com/ViewPoem.aspx?id=183759",""],[5271,"الحبُ قدْ ولّى","https://www.poetsgate.com/ViewPoem.aspx?id=61559",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5410,"ثورة أنين","https://www.poetsgate.com/ViewPoem.aspx?id=133057",""],[5447,"ريحٌ في العشرين","https://www.poetsgate.com/ViewPoem.aspx?id=208336",""],[5605,"سيدي الأفمي f.m.i","https://www.poetsgate.com/ViewPoem.aspx?id=159737",""],[5674,"الرمش بحر هادر","https://www.poetsgate.com/ViewPoem.aspx?id=185728",""],[5674,"كان صمتك قاتلا","https://www.poetsgate.com/ViewPoem.aspx?id=191748",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[6102,"مَرارَةُ الحَقِيقَة","https://www.poetsgate.com/ViewPoem.aspx?id=182766",""],[6202,"لقاء العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86750&r=&rc=51",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""]],"verses":[["ماذا فَليسَ بِضائِري أَن لَم أَكُن","لَكَ جارَ بَيتٍ أَو رَضيعَ لِبانِ",0,"ن",1,0],["ماذا فعلنا؟ غضبنا كالرجال ولم","نصدُق.. وقد صدق التنجيم والكتب",1,"ب",1,0],["ماذا في الأُفقِ فَقَد وَقَفا","يَتَأَمَّلُ فيهِ وَيَبتَسِمُ",2,"م",1,0],["ماذا فعلتم سِوَى أنْ صَار عالَمُنَا","غابًا تحكَّم فيه مَنْ له الغَلَب؟",3,"ب",1,0],["ماذا فَعَلتَ لقد أتَيتَ عظيمةً","ينبو الأريبُ بها ويَعيَا المِصقَع",4,"ع",1,0],["ماذا فعلت ؟ أردت شغل بطالتي","لكن أردت ، وما عرافت مجالي",5,"ل",2,0],["ماذا فَعَلتِ سُدومُ أَينَ جَواذِبٌ","كانَت عَلى تِلكَ الخُدورِ مجمَّعَه",6,"ع",2,0],["ماذا فعلتِ وأنتِ فوقَ حشيّةٍ","بالقائدِ البطلِ المغيرِ بجنده",7,"د",2,0],["ماذا فَعَلت بِعاشِق","فَلق الحَشى بادى السِقام",8,"م",1,0],["ماذا فَعَلتِ بمُهجَتي يا هذي","تَعِدينَ مَوعِدَ كاذِبٍ مَلاَّذِ",9,"ذ",1,1],["ماذا فَعَلتُ يا غَبيُّ فيكا","حَتّى أَذوق المَوت مِن أَيدِيكا",10,"ك",2,0],["ماذا فَعلت في حَصيدٍ قَد مَضى","قالَ لَها كان زمان وانقضى",11,"ض",2,0],["ماذا فَعَلْتِ بِرُوحي","إِذْ قُلتِ بِالْقَلْبِ هَيَّا",12,"ي",2,0],["ماذا فَعَلتَ بِبَدرٍ إِذ تُمَزِّقُهُم","غادَرتَهُم طُعمَ العُقبانِ وَالرَخَمِ",13,"م",1,0],["ماذا فعال الأكرمين إذا هم","سئلوا ولا ذي شيمة الفضلاء",14,"ا",2,0],["ماذا فهمت من الكنا","ر ومن حديث البلبل",15,"ل",1,0],["ماذا فعلتَ بمهجتي أَو ما كَفى","وَجدٌ يَزيدُ وَشَأنُ جفنٍ يَذرف",16,"ف",1,0],["ماذا فَعلتم به أَوقلتموه فَكَم","حاولته اليَوم أَن يَسعى مَعي فأبى",17,"ب",2,0],["ماذا فعلتَ زمن الحصائد","كنتُ أُغنِّي للورى قصائدي",18,"ي",1,0],["ماذا فعلت بروح صبٍّ حائرٍ","نزقٌ كساه وغفلةٌ وشرودُ",19,"د",1,0],["ماذا فَعَلْتَ بقَلبٍ","صَبٍّ بِحُبِّكَ غَالَى",20,"ل",2,0],["مَاذَا فَعَلْنَا بِأَجْدَاثِ الرَّصِيدِ وَمَا","ذَا قَدْ بَنَىْ ؟ بَشَرَاً ! عَقْلاً ! وَلا بَدَنَا",21,"ن",2,0],["مَاذَا فَعَلْتَ بِنَاعِسَاتِ الطَّرْفِ يَا","بَدْرَاً أَضَاءَ عُيُونَهُنَّ بِذِي الْفَلَكْ",22,"ك",1,0],["ماذا فعلت َصاح ٍ؟هلْ تَجثو لها؟!","هلْ ذاكَ أمر الله أمْ أمرُالصنمْ ؟",23,"م",1,0],["ماذا في البيت سوى المنفى","والقلقُ البنيُ المهمل",24,"ل",1,0],["ماذا في الوقت إذا انحرفت","عنهُ اللحظات ولم يحفلْ؟",24,"ل",1,0],["ماذا في العالم: أوطانٌ","منهكةً تسقط في المرجل",24,"ل",1,0],["ماذا فعلنا وقد راح العدوّ بها","يسبي الحَصانَ ويُقوي الدور والقببا...؟!",25,"ب",2,0],["\"ماذا فعلتُ؟\" وكان الليلُ أسكرَها","قبلَ الهبوبِ فضاق العصفُ بالوجعِ",26,"ع",1,0],["مَاذَا فَعَلْتَ بِنَا يَا سِيِّدِي( الأَفَمِيِ)","حَتَّى تَزَامَنَ جوع البَطنِ بِالأَلَمِ",27,"م",1,1],["ماذا فعلت لعاشقٍ يادرةً","قد كان يعزف صامت الألحانِ",28,"ن",1,0],["ماذا فَعلْتُ ..تَصُدَ عنّي عامِداً","ما خنْتُ عهداً .. ما خضبْتُ جدائلا",29,"ل",2,0],["ماذا فعلتُ لكي أَصْلاكِ في لغتي","شِعرَ العذابِ؟.. أتَغتالينَ لذاتي؟",30,"ت",2,0],["ماذا فعلت أبا الحسين وإنَّما","أنت المجلَّى لم تزل غلاَّبا",31,"ب",2,0],["ماذا فعلتُ له وقد كلَّلْتُهُ","بزهور أشعارٍ شفته من العما ؟",32,"م",2,0],["ماذا فَعَلتُ لِكَي يَختانَنِي زَمَنِي؟","وَمَن لَدَيهِ لِهَذا اللُّغزِ إِيضاحُ؟",33,"ح",1,0],["ماذا فعلنا وشر الناس ترجمه","زورا وما عمدت يوما إلى سبب ؟",34,"ب",1,0],["ماذا فَعَلْتَ بِباقِيْ الحَبِّ يَوْمَ غَزَا","دَبَا الجَرَادِ وما في الجُرْنِ مُدَّخَرُ؟",35,"ر",1,0]]}