{"poems":[[91,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[101,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[226,"ذهب الوفاء فلا ندامه","https://www.aldiwan.net/poem55272.html","مجزوء الكامل"],[226,"ألبست من بعد الوفاء","https://www.aldiwan.net/poem55303.html","مجزوء الكامل"],[406,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145889","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125477","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200039","البسيط"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140160",""],[3241,"","https://poetry.dctabudhabi.ae/diwan/poem/147627","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76504","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125817","الكامل"],[4693,"سيف بكف بارد لا يقطع","https://www.poetsgate.com/ViewPoem.aspx?id=29937",""],[4693,"اهداء الى خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=33403",""],[4693,"نداء الى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=34476",""],[4755,"ما زِلتَ يا وَطَنِي تَنُوحُ, ولَم يَزَل","https://www.poetsgate.com/ViewPoem.aspx?id=183836",""],[4755,"ماذا سَيَصنَعُ شاعِرٌ بِمِدَادِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=197778",""],[4759,"خذي فليس معي","https://www.poetsgate.com/ViewPoem.aspx?id=203999",""],[4852,"رُبَّان","https://www.poetsgate.com/ViewPoem.aspx?id=215211",""],[4908,"\"طَقْطَقة\"!","https://www.poetsgate.com/ViewPoem.aspx?id=212786",""],[4929,"في وصف نبينا صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=199556",""],[4936,"رجلٌ زجاجيّ","https://www.poetsgate.com/ViewPoem.aspx?id=191289",""],[4955,"ماذا سأجني من حصادِ لساني","https://www.poetsgate.com/ViewPoem.aspx?id=188765",""],[4955,"المسجد الأقصى يخطُّ روايةً","https://www.poetsgate.com/ViewPoem.aspx?id=190425",""],[4955,"أعلنتها فلتسمعوا إعلاني","https://www.poetsgate.com/ViewPoem.aspx?id=199644",""],[4955,"إن السعادة سرها الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=201568",""],[5032,"خيال رجائي","https://www.poetsgate.com/ViewPoem.aspx?id=189500",""],[5057,"أرقّ قلوبا","https://www.poetsgate.com/ViewPoem.aspx?id=197518",""],[5057,"أطفئِيْ ظمأيْ","https://www.poetsgate.com/ViewPoem.aspx?id=197541",""],[5072,"نسائم الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=53934",""],[5090,"بيت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=184647",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5111,"تَرَاتيْلُ الْبَتُولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212511",""],[5120,"مِنْ بَعْدِهَا،لَا يَنْتَهِي السَّفَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=181582",""],[5189,"إنّي أحبّك والهوى غدَّارُ","https://www.poetsgate.com/ViewPoem.aspx?id=191636",""],[5190,"العرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179298",""],[5191,"تَدَلُّلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215453",""],[5224,"الأحباب طرقوا باب وصلك","https://www.poetsgate.com/ViewPoem.aspx?id=121311",""],[5268,"المَوتُ والحرِّيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=206993",""],[5277,"من أوراق حمامة بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=185800",""],[5277,"إبرهةٌ آخر","https://www.poetsgate.com/ViewPoem.aspx?id=194364",""],[5277,"أبجديةُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204857",""],[5295,"فجر المنى","https://www.poetsgate.com/ViewPoem.aspx?id=159305",""],[5299,"ارجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210537",""],[5351,"حين أختفى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=202242",""],[5355,"ملح العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190552",""],[5431,"رثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=204906",""],[5431,"باريس ...","https://www.poetsgate.com/ViewPoem.aspx?id=208588",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5561,"سفر الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192757",""],[5612,"ماذا ستفْعَلْ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=181615",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5628,"شر المصائب","https://www.poetsgate.com/ViewPoem.aspx?id=178705",""],[5703,"أميرة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=206077",""],[5720,"أيها العالَم","https://www.poetsgate.com/ViewPoem.aspx?id=200139",""],[5736,"سكينة","https://www.poetsgate.com/ViewPoem.aspx?id=208192",""],[5742,"مولد النور","https://www.poetsgate.com/ViewPoem.aspx?id=206973",""],[5758,"سَفَرٌ بينَ دُموعِ السَّنَابل","https://www.poetsgate.com/ViewPoem.aspx?id=200526",""],[5776,"نبوءةٌ موجزَة","https://www.poetsgate.com/ViewPoem.aspx?id=199451",""],[5842,"أعُوذُ باللهِ / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137108",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5897,"رفقاً بالشاعر العربي","https://www.poetsgate.com/ViewPoem.aspx?id=156129",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5939,"بلاغٌ عن حالة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=180016",""],[5939,"مكرُ الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=185494",""],[5956,"حبي الحلال","https://www.poetsgate.com/ViewPoem.aspx?id=181977",""],[5957,"ما زلت أذكر لوعتي وعذابي","https://www.poetsgate.com/ViewPoem.aspx?id=30136",""],[6027,"مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=187270",""],[6078,"بلقيس شعري","https://www.poetsgate.com/ViewPoem.aspx?id=203024",""],[6218,"عبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65866&r=&rc=20",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[6257,"سامرتُه حلما ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87182&r=&rc=7",""],[6314,"مرثية الطفل العجوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88076&r=&rc=11",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["ماذا سيحكم قاضي الحب بينهما","غداً اذا اجتمع المشكو والشاكي",0,"ي",1,0],["ماذا سأقرأ من شعري ومن أدبي؟","حوافر الخيل داست عندنا الأدبا",1,"ب",2,0],["ماذا سوى مثلِ ما لاقيتَ تأمُلُهُ","شمُ العرانين من جُدْع العرانين",2,"ن",1,0],["ماذا سمعت تحدثي فَقَد اِلتَوت","مني لأجل بكائك الأعصاب",3,"ب",1,0],["ماذا سيحسنه امرؤ","للآن لم يحسن كلامه",4,"م",2,0],["ماذا سيجديني غدا","من بعد أن أقضي العزاء",5,"ا",2,0],["ماذا سأذكرُ من حياةٍ كلُّه","ذكرى ، وذكرى تبعثُ الأشجانا",6,"ن",2,0],["ماذا سأذكر أيُّها الغالي الذي","هجر الطريقَ وفارقَ الميدانا",6,"ن",2,0],["ماذا ستفعَلُ غيرَ أنْ تلظى","ماذا ستفعَلُ غيرَ أنْ تشهَقْ",7,"ق",1,0],["ماذا سمعت أجبني","ملأت رأسي ظنونا",8,"ن",2,0],["ماذا سيبقى جواب القول غير خفي","الله باق وباقي الكون للتلف",9,"ف",1,0],["ماذا سوى ذكراه يا بشراه قد","جاءت تذكر أيما تذكار",10,"ر",1,0],["ماذا سؤالك صم ربع مقفر","لولا ضلالك بالغزال الأعفر",11,"ر",1,1],["ماذا سَيَصنَع ذلك العاري وَقَد جاءَ الشتا","وَالوَيل من ذاكَ المُعاند للمقل اذا اتى",12,"ت",2,0],["ماذا ستكتب عن بلادك","غير ما هو ميئس",13,"س",1,0],["ماذا سأكتب فالهموم كبيرة","جف المداد ولم يكلّ الإصبع",14,"ع",1,0],["ماذا سأكتب عنك اليوم يا وطنا","أخاله هرما يُبنى على هرم",15,"م",1,0],["ماذا سأكتب للتاريخ يا قلمي","وهذه أمتي تلهو وتحتضر",16,"ر",1,0],["ماذا سَأَكتُبُ لِلحَبيبَةِ؟! إنَّها","مَهجُورَةٌ كالوَردَةِ الجَبَلِيَّة",17,"ل",3,0],["ماذا سَأَكتُبُ لِلحَبيبَةِ؟! والهَوَى","رَيحَانَةٌ بِحُقُولِكَ البَصَلِيَّة",17,"ل",3,0],["ماذا سَأَكتُبُ لِلتي نَظَرَاتُهَا","أُمَمِيَّةٌ, وبِلادُهَا شِلَلِيَّة؟!",17,"ل",3,0],["ماذا سَيَصنَعُ شاعِرٌ بِمِدَادِهِ","لِيَشُدَّ ظَهرَ الجُوعِ عَن أولادِهِ؟!",18,"د",2,1],["ماذا سأكتبُ أو ماذا ستمليني","خذي دفاترُكِ هاتي عناويني",19,"ن",2,1],["ماذا سكنتَ، وتحديدًا، سوى مُهجي","حتى تضوعَ عطور المسكِ في رئتي؟",20,"ت",2,0],["ماذا سكبتَ على أكوابِ معتقدي","حتى أراكَ كعصياني ومغفرتي؟",20,"ت",2,0],["ماذا سأكتبُ في هوانا طالما","أخشى نفاقاً أو أكنْ كذابا",21,"ب",2,0],["ماذا سيذكر شعري من لآلئها","وحصرها يُعجزُ الأرقامَ حسبانا",22,"ن",2,0],["ماذا سيضفي مديح المادحين لمن","بمدحه فاهتِ الآياتُ قرآنا",22,"ن",2,0],["ماذا سينفعُ صخرةً هَذا البُكا","ءُ المُرُّ كيفَ سيخشَعُ التِّمثالُ",23,"ل",1,0],["ماذا سأجني من حصادِ لساني","إن كانَ يَزرعُ في ربى الشيطانِ",24,"ن",1,1],["ماذا سأفعل إن طُلبتُ كشاهدٍ","فأشارتِ الأعضاءُ أنِّي الجاني",24,"ن",2,0],["ماذا سنخبرُ ربَّنا في حشرنا","مليارنا قد باءَ بالخسرانِ",25,"ن",1,0],["ماذا ستكسبُ في حياتكَ دلَّني","إمَّا خسرتَ كرامةَ الإنسانِ",26,"ن",1,0],["ماذا ستجني من همومِكَ قُل","أمسك دموعَكَ أيُّها الرَّجلُ",27,"ل",1,0],["ماذا سِوَى صَرَخات الرُّعبِ يُطْلِقُها","عُصْفُورُها بَيْنَ مَنْ ردُّوا ومَنْ قَصَفوا",28,"ف",3,0],["ماذا ستجني بانكسارِ فؤادِهِ","بجفاكَ ؟ والشعرا أرقُّ قلوبا !",29,"ب",2,0],["ماذا سيخسَرُ هذا العصرُ إن كُتِبَتْ","لنا الحياةُ سويّاً فيهِ ؟! سيّدَتيْ",30,"ت",2,0],["ماذا.. سألتُ القوافي وهيَ صامتةً","حَيرى.. تُفَتِّشُ عن أوراقِ مُضْناك",31,"ك",1,0],["ماذا سأكتبُ إن هجرتُكِ ماذا ؟","أنا ليس لي غير القريضِ ملاذا",32,"ذ",2,1],["مَاْذَاْ سَأَكْتُبُ لَوْ غَنَّتْهُ قَاْفِيَتِيْ","هَلْ لِيْ مَلَاْكٌ يَصُبُّ الشَّمْسَ فِيْ كُتُبِيْ",33,"ب",2,0],["ماَذَا سَأنْشِدُ..؟وَالْحَرُوفُ تَعَطَّلَتْ","وَالصَّمْتُ فِيْ مِحْرَابِهِ ..يَتَضَرَّعُ",34,"ع",1,0],["مَاذَا سَيَبْقَى مِنَ الرِّيحِ الشَّرِيدَةِ،إِنْ","بَابًا فَتَحْتِ لَهَا،وَ اسْتَطْرَدَ الْمَطَرُ..؟",35,"ر",1,0],["مَاذَا سَيَبْقَى مِنَ الْقَلْبِ الْغَرِيبِ،إِذَا","رَآكِ،أَوْ لَاحَ مِنْ بَسْمَاتِكِ الْقَمَرُ..؟",35,"ر",1,0],["مَاذَا سَيَبْقَى مِنَ النَّهْرِ الصَّمُوتِ،إِذَا","أَحَبَّ،أَوْ أَيْنَعَتْ مِنْ حَوْلِهِ الثُّمُرُ..؟",35,"ر",1,0],["ماذا سأخفي من صباباتِ الهوى","والعينُ تفضحُ والهوى أشعارُ",36,"ر",1,0],["مَاذَا سَتَكتُبُ أَيُّهَا التَّارِيخُ فِي","سِفرِ الدُّمُوعِ ، وهَل تُرَى سَتُلامُ ؟",37,"م",1,0],["ماذا سأكتبُ؟ والقوافي","حول معصمِها... تُلَفْ ؟",38,"ف",1,0],["ماذا سيكون لو وصلوا إليك","كم بقوا ناظرين خلف الباب",39,"ب",1,0],["ماذا سأكتبُ والحروفُ جريحةٌ","والشِّعرُ مثلَ عواصفٍ شِتويَّةْ",40,"ي",2,0],["ماذا سأُنشدُ للّتي","حزَّت بجيدي بالبواترْ؟",41,"ر",1,0],["ماذا سيُجدي وقدْ أودى بهاالقيلُ","كلّ الكلامِ (مفاعيلنْ مفاعيلُ)",42,"ل",1,1],["ماذا سأكتبُ منْ شعرٍ يعاندني","وكمْ تعاندني في سطرِهِ صحفي",43,"ف",2,0],["ماذا سأنْظِمُ فِيكَ يا فجْر المُنى","وأنا المُشَوَّقُ للسنا أتطلعُ",44,"ع",1,0],["ماذا سأجني مِنْ وراء تجمُّلي","هل بَعد هذا الهجر كحلٌ ينفعُ؟!",45,"ع",1,0],["ماذا سأفعل إنني رجلٌ","لجراحهِ بيد الأسى أثرُ",46,"ر",1,0],["مَاذَا سَأذْكُرُ مِنْ جُرْحٍ وَمِنْ ألَمٍ","وَالْحَالُ يَا أُمَّتِي للقلبِ قد عَصَرَا",47,"ر",2,0],["ماذا سأخبرُ مهجعا فارقته ....","إنْ راح يشكو وحشة ويقاسي!!",48,"س",2,0],["ماذا سأخبر عن أنثى مغنجةٍ","بالورد تُغسلُ بالأطياب باريسُ",49,"س",1,0],["ماذا سيبقى من حدائقه","إن كان زهر شبابه احتطبا",50,"ب",2,0],["ماذا ستكتبُ والحروفُ ظِماءُ","وجعُ السُّطورِ تَخطّه الأعداءُ",51,"ا",2,1],["ماذا ستفْعَلُ ؟ قد ضاقَتْ بِكَ السُّبُلُ","أوَ تُكْمِلُ السّيْرَ أمْ للأمْرِ تمْتَثِلُ ؟",52,"ل",1,1],["ماذا سيحدثُ للدنيا وساكنها","لو انّ شمسك هذي سوف تفتقدُ",53,"د",1,0],["ماذا سأكتبُ عنها ضاقَ بي قلمي","ذرْ عا ومِنْ حوليَ النيرانُ تشتعلُ",54,"ل",1,0],["ماذا سأفعلُ في حبٍّ يُزلزلني","ويتركُ الليلَ أشواقاً وأشجانا؟",55,"ن",2,0],["ماذا سَيحدثُ حينما","ينهالُ عَطفٌ قادمُ",56,"م",1,0],["ماذا سأخبرُ يا صديقي دفتري","ورسائلي مثلي أنا نامت حزينةْ",57,"ن",2,1],["ماذا سيبلغ شعري من مدائحكم","ضاقت عن الوصف مني الضاد والهمم",58,"م",1,0],["مَاذَا سَنَکْتُبُ ، وَالسَّنابِلُ قَمْحُهَا","فِي أَوَّلِ الدَّمْعِ المُهَاجِرِ عَائِقَا",59,"ق",2,0],["ماذا سيأتي؟ ما يكونُ القادمُ","ماذا سيأتي؟ كلُ شيءٍ غائم ُ",60,"م",1,1],["ماذا سيأتي؟ كل شيء جائزٌ","لا حربَ تبقى أو سلامٌ دائمُ",60,"م",1,0],["ماذا سيَختَزِنُ التاريخ غير صدى","يَجني المرارةَ بين العارِ والوَصَمِ",61,"م",1,0],["ماذا ستطعمه؟..ومافي الغرفة","البكماء إلا السقف والأرضية",62,"ي",2,0],["ماذا سيكتب لو رأى أقلامنا","تهدي لنا فوق المصاب مصابا",63,"ب",2,0],["ماذا ستحكي ؟! وماذا قد نقول لها؟!","من مقعد يعربي القهر محتقنِ",64,"ن",1,0],["ماذا سيُجمّلُ أيامي","لو حسنُكِ عن عيني راغْ؟",65,"غ",1,0],["ماذا سيحدثُ حينَها؟","لقد انتظرتُ جوابَها",66,"ب",3,0],["ماذا سأفعل في وُلوعي