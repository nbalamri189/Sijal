{"poems":[[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[94,"يا عذارى الجمال والحب والأحلام","https://www.aldiwan.net/poem38951.html","الخفيف"],[64,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[51,"ما رأيت العيش يصفو لأحد","https://www.aldiwan.net/poem62038.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[226,"أو لم يأن أن يفيق من الغفلة","https://www.aldiwan.net/poem55408.html","الخفيف"],[541,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"]],"verses":[["يرزت تميس كخطرة النشوان","هيفاء مخجلةً غصون البان",0,"ن",1,1],["يرزَحُ القَلْبُ فيه بالألَم المرّ","ويَشقى بعيشِهِ المَنْكودِ",1,"د",1,0],["يرزقه الله من يشاء ولم","يلاقِ فيه بؤساً ولا نصبا",2,"ب",2,0],["يَرزُقُ الأَحمَقَ رِزقاً واسِعاً","وَتَرى ذا اللُبِّ مَحروماً نَكِد",3,"د",1,0],["يرزم الرعد كالمَدافع فيه","وَيوالي إرزامَهُ فَيَطول",4,"ل",1,0],["يرزقُ الكلَّ الكريمُ المُتعال","وهوَ قسّامٌ لجاري رزقهِ",5,"ه",1,0],["يرزق الله من يشاء بمقدا","ر ولا يرزق الحجا والدهاء",6,"ا",2,0],["يَرزُقه التوفيقَ طُولَ الأبدِ","في السَّير في هدي النَّبِي محمَّدِ",7,"د",1,0]]}