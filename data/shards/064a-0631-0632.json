{"poems":[[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[94,"يا عذارى الجمال والحب والأحلام","https://www.aldiwan.net/poem38951.html","الخفيف"],[64,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[51,"ما رأيت العيش يصفو لأحد","https://www.aldiwan.net/poem62038.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[227,"أو لم يأن أن يفيق من الغفلة","https://www.aldiwan.net/poem55408.html","الخفيف"],[543,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77650","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126145","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206239",""],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102131","المنسرح"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85045","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66539","السريع"],[4691,"سجال الإجازة زياد بنجر وظميان غدير","https://www.poetsgate.com/ViewPoem.aspx?id=110553",""],[4816,"ربى العين","https://www.poetsgate.com/ViewPoem.aspx?id=8474",""],[5055,"كل السحايب","https://www.poetsgate.com/ViewPoem.aspx?id=104295",""],[5186,"يا رعى الله ما رعت بكفيا","https://www.poetsgate.com/ViewPoem.aspx?id=156509",""],[5956,"اشتقت إليك، أ لَمْ تشتق؟","https://www.poetsgate.com/ViewPoem.aspx?id=193798",""],[463,"نديمي وما الناسُ إلا السكارى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60053&r=&rc=109",""]],"verses":[["يرزت تميس كخطرة النشوان","هيفاء مخجلةً غصون البان",0,"ن",1,1],["يرزَحُ القَلْبُ فيه بالألَم المرّ","ويَشقى بعيشِهِ المَنْكودِ",1,"د",1,0],["يرزقه الله من يشاء ولم","يلاقِ فيه بؤساً ولا نصبا",2,"ب",2,0],["يَرزُقُ الأَحمَقَ رِزقاً واسِعاً","وَتَرى ذا اللُبِّ مَحروماً نَكِد",3,"د",1,0],["يرزم الرعد كالمَدافع فيه","وَيوالي إرزامَهُ فَيَطول",4,"ل",1,0],["يرزقُ الكلَّ الكريمُ المُتعال","وهوَ قسّامٌ لجاري رزقهِ",5,"ه",1,0],["يرزق الله من يشاء بمقدا","ر ولا يرزق الحجا والدهاء",6,"ا",2,0],["يَرزُقه التوفيقَ طُولَ الأبدِ","في السَّير في هدي النَّبِي محمَّدِ",7,"د",1,0],["يرزقهم مَولاي كُل لَيلَه","مِن فَضله حاشا تَخاف عَيله",8,"ه",1,0],["يرزقنا ونحن نعصي أمره","ما أحد يقدر منا قدره",9,"ه",1,0],["يرزقنا ونحن نعصي أمره","ولانخاف مكره وقهره",9,"ه",1,0],["يرزقنا تودداً إلينا","ونحن لا ندري بما علينا",9,"ن",2,0],["يرزق من يشاء ليس يسأم","سبحانه نعمته تتمم",10,"م",1,0],["يرزف ويا مَ احلى رزيفه","فرحان فِيْ جَوْ السما يدور",11,"ر",1,0],["يرزى به واين","اللَيلُ والاصباح",12,"ح",1,0],["يَرزى الجُمانُ بِثَغرِهِ وَبِقَدِّهِ","غُصنُ النَقا وَالطَرفُ زَهرُ النَرجِسِ",13,"س",1,0],["يُرْزي عَلَى قُبْحِ عُبَوسِ الحَيا","حَياؤُهُ الطَّلْقُ الجَميلُ النَّدِي",14,"د",2,0],["يُرزَق الشعرُ في فؤاد حبيبي","......................بالرِّضا منهُ جنّةً وخلودا",15,"د",2,0],["يرزقك ربي يا عسى قرة العين","وتهنى بدنيا زينها شوف طفله",16,"ل",2,0],["يرزا له الميدان بالحب نهجا","وتصارمت بالسيف يوم الولاجي",17,"ج",2,0],["يرزح الراسيات والقلب يرعى","عبئه في الضلوع، ما دمت حيا",18,"ي",2,0],["يرزقك الخالق من أجلي","أضعافاً عمّا تتدفَّقْ..",19,"ق",1,0],["يرزنَ يخيلنَ للناظرين","صوامعَ من حولها أو منارا",20,"ر",2,0]]}