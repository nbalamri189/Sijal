{"poems":[[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[23,"أجمعت عمرة صرما فابتكر","https://www.aldiwan.net/poem21419.html","الرمل"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[48,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[48,"أما حياتي فما لي عندها فرج","https://www.aldiwan.net/poem23350.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[230,"لهف سارى الدجى لقد أفل البد","https://www.aldiwan.net/poem55084.html","عموديه"],[325,"سكر الظبي واستحد حسامه","https://www.aldiwan.net/poem67208.html","البسيط"],[385,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[385,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[556,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34800","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1668,"","https://poetry.dctabudhabi.ae/diwan/poem/31376","الكامل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114030","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128942","الرجز"],[4755,"حوارية.. ما لم أقُله أنا","https://www.poetsgate.com/ViewPoem.aspx?id=207984",""],[4915,"شقشقة","https://www.poetsgate.com/ViewPoem.aspx?id=211399",""],[5542,"صرخة مرصعة بالإخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=10073",""]],"verses":[["مَنْ يَغْتَفِرْ لِعَدُوِّهِ وَصَدِيقِهِ","ذَنْباً فَتِلْكَ نِهَايَةُ الإحْسَانِ",0,"ن",1,0],["مَن يَغُرُّ الدَهرُ أَو يَأمَنُهُ","مِن قَبيلٍ بَعدَ عَمرٍ وَحُجُر",1,"ر",1,0],["مَن يَغلِبُ اللَهَ أَو يَرمي خَلائِفَهُ","في العالَمينَ بِكَيدٍ أَو بِخِذلانِ",2,"ن",1,0],["مَن يَغتَبِط بِمَعيشَةٍ فَأَمامَهُ","نُوَبٌ تُطيلُ عَناءَهُ فَجَعاتُها",3,"ت",3,0],["مَن يَغنَ يَخدُمهُ أَقوامٌ عَلى طَمَعٍ","وَلا يَرَونَ لِمَن أَخطا الغِنى خَدَما",4,"م",2,0],["مَنْ يَغْرِسِ الصُّنْعَ الْجَميلَ بأُمّةٍ","فَلهُ من الشُّكرِ الْجَمِيلِ ثِمَار",5,"ر",1,0],["مَن يُغيثُ المظلومَ إن بات يَشكو","وَحُسَينٌ عَدَت عليه العوادي",6,"د",2,0],["مَن يُغَرِّر بِنَفسِهِ مَعَ ريمِ","ما عَهِدنا في قُسورِ إِقدامَه",7,"م",2,0],["مَن يَغرس الإِحسان يَجن مَحبة","دون المُسيء المُبعَد المَصروم",8,"م",1,0],["مَن يَغرس العَدل يَجِنّ النَصر عَن ثِقَة","وَالعَدل يُثمر ما لا يُثمر الشَجَرُ",9,"ر",1,0],["مَنْ يَغِبْ عنه ساكنُ الدارِ لا يَس","ألُ إلّا طُلولَها والرّبوعا",10,"ع",2,0],["من يُغالي من الرِّجال بنعل","فَسَوَائي إذاً بهِنّ يُغَالِي",11,"ل",2,0],["من يغفر الذنوب إلا اللّه","بحق لا إله إلا اللّه",12,"ه",1,0],["من يغلبوا يهلِك ومن لا يغلبوا","يلحق بأرضِ ثَمودَ حتى لا يُرى",13,"ا",1,0],["من يَغش حضرته العليَّةَ ينثني","علما ونيلا مُوَقراً وَمُوفَّرا",14,"ر",2,0],["من يغترر في مدح","من خادع مكرره",15,"ر",2,0],["مَن يُغَنِّي (على العَقِيقِ اجتَمَعنا)؟!","(لو خَفَضتُم صُراخَكُم لَاستَمَعنا)",16,"ن",2,1],["مَن يغفُ عَن بلوائِهِ لم تنقضِ","البلواءُ إلا وهوَ رسمٌ دارسُ",17,"س",1,0],["من يغتدي بالخير يجني","أجره عند الرواح",18,"ح",1,0]]}