,"السريع"],[527,"بحمدك لا بحمد الناس أضحي","https://www.aldiwan.net/poem45980.html","الوافر"],[551,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[551,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[551,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[551,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[551,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[551,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[551,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[558,"وجود كوني من تجلي الجواد","https://www.aldiwan.net/poem34632.html","السريع"],[562,"تقارن اليوم طيب السمع والبصر","https://www.aldiwan.net/poem52782.html","البسيط"],[562,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[567,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[567,"تزداد فيك مصيبتي","https://www.aldiwan.net/poem69633.html","مجزوء الكامل"],[567,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[575,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[575,"سلني بالله عن فلان","https://www.aldiwan.net/poem2845.html","مخلع البسيط"],[575,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["وَعِش صافي الغَديرِ مِنَ الرَزايا","بِهِ خالي الأَديمِ مِنَ النُدوبِ",0,"ب",1,0],["وَعِش طالِعاً في العِزِّ كُلَّ ثَنيَّةٍ","عَلَيكَ خِيامٌ لِلعُلى وَقِبابُ",1,"ب",1,0],["وَعِش لِعَرشِ المَعاني","وَدُم لِتاجِ البَيانِ",2,"ن",1,0],["وَعَشِيرَةٌ أَدْمَى مَآقِيَهَا","بِنَوَاهُ أَسْرَاهَا وَأَمْجَدَهَا",3,"د",3,0],["وعشت معيشة الغرباء فيه","لأني اليوم في وطني غريب",4,"ب",1,0],["وَعَشِيَّةَ الحَومانِ أَسلَمَ جُندَهُ","قَيسٌ وَأَيقَنَ أَنَّهُ مَهزومُ",5,"م",1,0],["وَعِشتُ في عِزٍّ وَفي نِعمَةٍ","وَجَدُّكَ المُقتَبِلُ المُقبِلُ",6,"ل",1,0],["وَعِش يا اِبنَ نَصرٍ ما اِستَهَلَّت غَمامَةٌ","تَروحُ إِلى عِزٍّ وَتَغدو عَلى نَصرِ",7,"ر",1,0],["وعش كما شئت مهما شئت ممتدحاً","تثنى بخير لآلٍ خير آلاء",8,"ا",2,0],["وعش مبيحاً لكلِّ مطلب","علماً وجوداً جاآ على نسبه",9,"ب",2,0],["وعشتُ بين بني الأيَّامِ منفرداً","ورُبَّ منفعةٍ في عيشِ منفرد",10,"د",1,0],["وعش يا كثير الندى والثنا","وأجرك من ذا وذا أكبر",11,"ر",1,0],["وعش بين عيدٍ بالحجاز مهنئاً","وعيدٍ على أوطانِ مصر قريرا",12,"ر",2,0],["وعش ذا زمانٍ كله من تنسكٍ","ومن كرمٍ مستقبل الصوم والفطر",13,"ر",1,0],["وعشْ يا ربيب التقى والعلى","لدى أملٍ بالوفا صادق",14,"ق",1,0],["وعش يا ابن يحيى ذا حياة سعيدة","وعيشٍ هنيّ المستطاب مريه",15,"ي",2,0],["وعِشْ عيشَ مغشيِّ الفِناءِ محجَّبٍ","جَدا كفِّه في الناس غيرُ محجَّبِ",16,"ب",1,0],["وعش مائةً موفورةً في سعادةٍ","ونعماءَ لا يغتالُها نحسُ كوكبِ",17,"ب",1,0],["وعِشْ عيْش مَحْبُورٍ بدار إقامة","وأمثالُهَا سَيَّارةٌ فيك شُرَّدُ",18,"د",1,0],["وعِشْ والذي كَنَّيْتَهُ بمحمَّدٍ","ذوي غبطةٍ حتى يشيخ محمّدُ",19,"د",1,0],["وعِش في نماءٍ والوزير كلاكما","وكلُّكم والدهرُ طَوْعٌ مساعدُ",20,"د",1,0],["وعشتم في لَبوسِ عافيةٍ","يقاتل الدهرُ عنكُمُ غِيَرَهْ",21,"ر",2,0],["وعش أبداً في غبطة وسلامة","وأمنٍ إذا راعت سواك الروائع",22,"ع",1,0],["وعش لملوك الناس ما ذر شارقٌ","لترتق في فتق وتفتق في رتق",23,"ق",1,0],["وعشْ عيشَ ثاوٍ خير دار فما لَهُ","على غير زادٍ صالحٍ مُتَلَوَّمُ",24,"م",1,0],["وعشت بمقذىً من عيون شوانئٍ","سعيداً بِمَدْمَىً من أنوفٍ رواغمِ",25,"م",1,0],["وَعِشتُ بَعدَكَ يا مَن","وَدِدتُ لَو عِشتَ بَعدي",26,"ي",1,0],["وعِشْتَ في وَحْشَةٍ تُقاسي","خواطراً كلّها ضرامْ",27,"م",1,0],["وعِشْ كما شاءَتِ اللَّيالي","مِنْ آهَةِ النَّايِ والرَّبَابْ",27,"ب",1,0],["وعِشْتَ على الأَرضِ مثل الجبال","جليلاً رهيباً غريباً وَحيدْ",28,"د",1,0],["وعشت لأمثال أمثاله","إليك الهناء ومنك الجذل",29,"ل",1,0],["وَعِشنا بِها جيلَينِ قُمتَ عَلَيهِما","مُعَلِّمَ نَشءٍ أَو إِمامَ شَبابِ",30,"ب",1,0],["وعِشتُ صحيحاً سالماً بعد يومِها","وحسبيَ داءً أن أصِحَّ وأسلَمَا",31,"م",2,0],["وعِشْ سالماً في باعِ ملككَ بسطةٌ","تدومُ وفي أيامِ عمرِك طُولُ",32,"ل",1,0],["وعِشْ سالماً طولَ الزمان فإِنما","بقاؤك زيَنٌ للزمان وطِيبُ",33,"ب",1,0],["وَعَشائِرٍ غَمَت عَلَيكَ أُمورُهُم","لا أَصدِقاءَ فَيَرفِدوكَ وَلا عِدى",34,"د",2,0],["وَعِش أَبَداً لِلمَكرُماتِ وَلِلعُلا","فَأَنتَ ضِياءُ المَكرُماتِ وَنورُها",35,"ر",3,0],["وَعَشِيَّةَ الجَمَلِ المُجَلَّلِ ضارَبوا","ضَرباً شُؤونَ فِراشِهِ تَتَزَيَّلُ",36,"ل",1,0],["وَعُشرَةِ كاتِبٍ لِلعِلمِ قارٍ","لِحُسنِ الخُلقِ بِالآدابِ قارِن",37,"ن",1,0],["وَعَشِيَّةَ التَلِّ اِنصَرَفتَ وَلِلهُدى","شَوقٌ إِلَيكَ مُداوِرٌ وَحَنينُ",38,"ن",1,0],["وَعَشِيَّةُ التَلَّ الَّذي نَعَشَ الهُدى","أُصُلٌ لَها فَخمٌ مِنَ الآصالِ",39,"ل",1,0],["وَعَشيَّةً حَبَسَت فَلَم تَفتَح فَما","بِكَلامِها مِن كاشِحٍ يَتَنَمَّمُ",40,"م",1,0],["وَعَشِيِّ أُنسٍ أَضجَعَتني نَشوَةٌ","فيهِ تُمَهِّدُ مَضجَعي وَتُدَمِّثُ",41,"ث",1,1],["وَعِش تَتَثَنّى اِنثِناءَ القَضيبِ","سُروراً وَتَسجَعُ سَجعَ الحَمامِ",42,"م",1,0],["وَعَشَّشَ الشِمرُ بِها وَفَرَّخا","ثُمَّ بَنى بِأَرضِها وَرَسَّخا",43,"خ",2,0],["وَعِشرَةٌ لِلقِيانِ في دَعَةٍ","مَع رَشَأٍ عاقِدٍ لِزُنّارِ",44,"ر",1,0],["وَعِشتُ صُنوفَ العَيشِ كَهلاً وَشارِخاً","فَيا لِحَياةٍ كَاليَمانِيِّ المُسَهَّمِ",45,"م",1,0],["وَعِشتُ بِعَيشَينِ إِنَّ المَنونَ","تَلَقّى المَعايِشَ فِيها خِسَاسا",46,"س",2,0],["وَعشت فَلَم يرغد ليَ العيش عندها","وَما خير عيش لَم يكن بِرَغيد",47,"د",1,0],["وعش معيشة حر","قد فك عنه القيودا",48,"د",2,0],["وعُشّ يضمهما في المساءِ","وروضٌ به في الضُّحَى يعبثانْ",49,"ن",1,0],["وعِشْ كما أنتَ معنىً في ضمائرِنا","لا ينتهي وحيهُ يوماً إلى أجلِ",50,"ل",1,0],["وعشقتُ موتَ الخالدين وعِفتُ من","عمري حقارةَ كلِّ يومٍ فاني",51,"ن",2,0],["وَعِشْ فَرْداً فَمَا في الناسِ خِلٌّ","يَسُرُّكَ في بِعَادٍ وَاقْتِرَابِ",52,"ب",1,0],["وَعَشِيرَةٌ لوْ أُحْصِيَتْ بِكِرَامِهَا","كَانَتْ وَلا غَلْوَاءَ جَمْعَ عشَائِرِ",53,"ر",1,0],["وَعِشْ نَابِهاً بِالْعِلْمِ وَالْفَنِّ نَابِغاً","فَخَرُكَ مَوْفُورٌ وَفَضْلُكَ رَابِي",54,"ب",2,0],["وَعِشتُ بِمَغصوبِ المُلوكِ كَأَنَّني","أَموتُ طوىً لَو عفتهُ لِلتَعَفُّفِ",55,"ف",1,0],["وَعِشتُ مَعَ الأَقوامِ بِالفَقرِ وَالغِنى","سَقاني بِكَأسَي ذاكَ كِلتَيهِما دَهري",56,"ي",1,0],["وَعِشْتُ لِلْف