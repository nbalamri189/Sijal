{"poems":[[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[53,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[86,"يا سيدي وإمامي","https://www.aldiwan.net/poem68861.html","المجتث"],[93,"هانت معالم مات سيدها","https://www.aldiwan.net/poem11139.html","أحذ الكامل"],[88,"لهذا اليوم في التأريخ ذكر","https://www.aldiwan.net/poem44990.html","الوافر"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[47,"ياقرح لم يندمل الأول","https://www.aldiwan.net/poem25211.html","السريع"],[47,"ألا ما لمن أمسى يراك وللبدر","https://www.aldiwan.net/poem25254.html","الطويل"],[72,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[72,"قلب ذلول وغادة صعبه","https://www.aldiwan.net/poem18237.html","المنسرح"],[72,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[72,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[72,"تهن به عيدا أجل كبيرا","https://www.aldiwan.net/poem18730.html","الطويل"],[72,"تهن بشهر الصوم يا خير صاحب","https://www.aldiwan.net/poem18876.html","الطويل"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[72,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[51,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[51,"على الطائر الميمون والسعد فاركب","https://www.aldiwan.net/poem8514.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"تجرد من غمدين سيف مهند","https://www.aldiwan.net/poem61940.html","الطويل"],[51,"تعجل مولود ليمهل والد","https://www.aldiwan.net/poem61960.html","الطويل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"رفعت إلى وديك أبصار همتي","https://www.aldiwan.net/poem65396.html","الطويل"],[51,"رجت منك نفسي سبقك الغيث بالندى","https://www.aldiwan.net/poem65500.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[70,"أمسيت في قعر لحد","https://www.aldiwan.net/poem42933.html","المجتث"],[92,"أدركت فجر الحياة أعمى","https://www.aldiwan.net/poem38919.html","مخلع البسيط"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[85,"أنلني يدا خلقت للقبل","https://www.aldiwan.net/poem7351.html","المتقارب"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[62,"بنفسي من أودعتها الترب راغما","https://www.aldiwan.net/poem52284.html","الطويل"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"نصب إلى طيب العراق وحسنها","https://www.aldiwan.net/poem63591.html","الطويل"],[28,"فلئن فخرت بهم لمثل قديمهم","https://www.aldiwan.net/poem5476.html","الكامل"],[66,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[31,"يا صاح قل للربع هل يتكلم","https://www.aldiwan.net/poem41808.html","الكامل"],[74,"وعشي أنس أضجعتني نشوة","https://www.aldiwan.net/poem12877.html","الكامل"],[74,"بما حزته من شريف النظام","https://www.aldiwan.net/poem13262.html","المتقارب"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[48,"أحسن من منزل بذي قار","https://www.aldiwan.net/poem63287.html","البسيط"],[46,"أشد عقابا من صلاة أضعتها","https://www.aldiwan.net/poem23363.html","الطويل"],[8,"لبست أناسا فأفنيتهم","https://www.aldiwan.net/poem21797.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85844","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42506","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54923","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10371","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[45,"مِنْ رِقْبَةٍ، أدَعُ الزّيارَةَ عَامِدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31346",""],[51,"تعجَّل مولودٌ ليُمْهَل والدُ","https://www.poetsgate.com/ViewPoem.aspx?id=28595",""],[74,"وعشيِّ أنسٍ أضجعني نشوة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13971&r=&rc=12",""],[72,"ليلايَ كم ليلة ٍ بالشعر ليلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57646&r=&rc=4",""],[92,"تَبَرَّمْتَ بالعيشِ خوفَ الفناءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14572&r=&rc=17",""]],"verses":[["وَعِش صافي الغَديرِ مِنَ الرَزايا","بِهِ خالي الأَديمِ مِنَ النُدوبِ",0,"ب",1,0],["وَعِش طالِعاً في العِزِّ كُلَّ ثَنيَّةٍ","عَلَيكَ خِيامٌ لِلعُلى وَقِبابُ",1,"ب",1,0],["وَعِش لِعَرشِ المَعاني","وَدُم لِتاجِ البَيانِ",2,"ن",1,0],["وَعَشِيرَةٌ أَدْمَى مَآقِيَهَا","بِنَوَاهُ أَسْرَاهَا وَأَمْجَدَهَا",3,"د",3,0],["وعشت معيشة الغرباء فيه","لأني اليوم في وطني غريب",4,"ب",1,0],["وَعَشِيَّةَ الحَومانِ أَسلَمَ جُندَهُ","قَيسٌ وَأَيقَنَ أَنَّهُ مَهزومُ",5,"م",1,0],["وَعِشتُ في عِزٍّ وَفي نِعمَةٍ","وَجَدُّكَ المُقتَبِلُ المُقبِلُ",6,"ل",1,0],["وَعِش يا اِبنَ نَصرٍ ما اِستَهَلَّت غَمامَةٌ","تَروحُ إِلى عِزٍّ وَتَغدو عَلى نَصرِ",7,"ر",1,0],["وعش كما شئت مهما شئت ممتدحاً","تثنى بخير لآلٍ خير آلاء",8,"ا",2,0],["وعش مبيحاً لكلِّ مطلب","علماً وجوداً جاآ على نسبه",9,"ب",2,0],["وعشتُ بين بني الأيَّامِ منفرداً","ورُبَّ منفعةٍ في عيشِ منفرد",10,"د",1,0],["وعش يا كثير الندى والثنا","وأجرك من ذا وذا أكبر",11,"ر",1,0],["وعش بين عيدٍ بالحجاز مهنئاً","وعيدٍ على أوطانِ مصر قريرا",12,"ر",2,0],["وعش ذا زمانٍ كله من تنسكٍ","ومن كرمٍ مستقبل الصوم والفطر",13,"ر",1,0],["وعشْ يا ربيب التقى والعلى","لدى أملٍ بالوفا صادق",14,"ق",1,0],["وعش يا ابن يحيى ذا حياة سعيدة","وعيشٍ هنيّ المستطاب مريه",15,"ي",2,0],["وعِشْ عيشَ مغشيِّ الفِناءِ محجَّبٍ","جَدا كفِّه في الناس غيرُ محجَّبِ",16,"ب",1,0],["وعش مائةً موفورةً في سعادةٍ","ونعماءَ لا يغتالُها نحسُ كوكبِ",17,"ب",1,0],["وعِشْ عيْش مَحْبُورٍ بدار إقامة","وأمثالُهَا سَيَّارةٌ فيك شُرَّدُ",18,"د",1,0],["وعِشْ والذي كَنَّيْتَهُ بمحمَّدٍ","ذوي غبطةٍ حتى يشيخ محمّدُ",19,"د",1,0],["وعِش في نماءٍ والوزير كلاكما","وكلُّكم والدهرُ طَوْعٌ مساعدُ",20,"د",1,0],["وعشتم في لَبوسِ عافيةٍ","يقاتل الدهرُ عنكُمُ غِيَرَهْ",21,"ر",2,0],["وعش أبداً في غبطة وسلامة","وأمنٍ إذا راعت سواك الروائع",22,"ع",1,0],["وعش لملوك الناس ما ذر شارقٌ","لترتق في فتق وتفتق في رتق",23,"ق",1,0],["وعشْ عيشَ ثاوٍ خير دار فما لَهُ","على غير زادٍ صالحٍ مُتَلَوَّمُ",24,"م",1,0],["وعشت بمقذىً من عيون شوانئٍ","سعيداً بِمَدْمَىً من أنوفٍ رواغمِ",25,"م",1,0],["وَعِشتُ بَعدَكَ يا مَن","وَدِدتُ لَو عِشتَ بَعدي",26,"ي",1,0],["وعِشْتَ في وَحْشَةٍ تُقاسي","خواطراً كلّها ضرامْ",27,"م",1,0],["وعِشْ كما شاءَتِ اللَّيالي","مِنْ آهَةِ النَّايِ والرَّبَابْ",27,"ب",1,0],["وعِشْتَ على الأَرضِ مثل الجبال","جليلاً رهيباً غريباً وَحيدْ",28,"د",1,0],["وعشت لأمثال أمثاله","إليك الهناء ومنك الجذل",29,"ل",1,0],["وَعِشنا بِها جيلَينِ قُمتَ عَلَيهِما","مُعَلِّمَ نَشءٍ أَو إِمامَ شَبابِ",30,"ب",1,0],["وعِشتُ صحيحاً سالماً بعد يومِها","وحسبيَ داءً أن أصِحَّ وأسلَمَا",31,"م",2,0],["وعِشْ سالماً في باعِ ملككَ بسطةٌ","تدومُ وفي أيامِ عمرِك طُولُ",32,"ل",1,0],["وعِشْ سالماً طولَ الزمان فإِنما","بقاؤك زيَنٌ للزمان وطِيبُ",33,"ب",1,0],["وَعَشائِرٍ غَمَت عَلَيكَ أُمورُهُم","لا أَصدِقاءَ فَيَرفِدوكَ وَلا عِدى",34,"د",2,0],["وَعِش أَبَداً لِلمَكرُماتِ وَلِلعُلا","فَأَنتَ ضِياءُ المَكرُماتِ وَنورُها",35,"ر",3,0],["وَعَشِيَّةَ الجَمَلِ المُجَلَّلِ ضارَبوا","ضَرباً شُؤونَ فِراشِهِ تَتَزَيَّلُ",36,"ل",1,0],["وَعُشرَةِ كاتِبٍ لِلعِلمِ قارٍ","لِحُسنِ الخُلقِ بِالآدابِ قارِن",37,"ن",1,0],["وَعَشِيَّةَ التَلِّ اِنصَرَفتَ وَلِلهُدى","شَوقٌ إِلَيكَ مُداوِرٌ وَحَنينُ",38,"ن",1,0],["وَعَشِيَّةُ التَلَّ الَّذي نَعَشَ الهُدى","أُصُلٌ لَها فَخمٌ مِنَ الآصالِ",39,"ل",1,0],["وَعَشيَّةً حَبَسَت فَلَم تَفتَح فَما","بِكَلامِها مِن كاشِحٍ يَتَنَمَّمُ",40,"م",1,0],["وَعَشِيِّ أُنسٍ أَضجَعَتني نَشوَةٌ","فيهِ تُمَهِّدُ مَضجَعي وَتُدَمِّثُ",41,"ث",1,1],["وَعِش تَتَثَنّى اِنثِناءَ القَضيبِ","سُروراً وَتَسجَعُ سَجعَ الحَمامِ",42,"م",1,0],["وَعَشَّشَ الشِمرُ بِها وَفَرَّخا","ثُمَّ بَنى بِأَرضِها وَرَسَّخا",43,"خ",2,0],["وَعِشرَةٌ لِلقِيانِ في دَعَةٍ","مَع رَشَأٍ عاقِدٍ لِزُنّارِ",44,"ر",1,0],["وَعِشتُ صُنوفَ العَيشِ كَهلاً وَشارِخاً","فَيا لِحَياةٍ كَاليَمانِيِّ المُسَهَّمِ",45,"م",1,0],["وَعِشتُ بِعَيشَينِ إِنَّ المَنونَ","تَلَقّى المَعايِشَ فِيها خِسَاسا",46,"س",2,0],["وَعشت فَلَم يرغد ليَ العيش عندها","وَما خير عيش لَم يكن بِرَغيد",47,"د",1,0],["وعش معيشة حر","قد فك عنه القيودا",48,"د",2,0],["وعُشّ يضمهما في المساءِ","وروضٌ به في الضُّحَى يعبثانْ",49,"ن",1,0],["وعِشْ كما أنتَ معنىً في ضمائرِنا","لا ينتهي وحيهُ يوماً إلى أجلِ",50,"ل",1,0],["وعشقتُ موتَ الخالدين وعِفتُ من","عمري حقارةَ كلِّ يومٍ فاني",51,"ن",2,0],["وَعِشْ فَرْداً فَمَا في الناسِ خِلٌّ","يَسُرُّكَ في بِعَادٍ وَاقْتِرَابِ",52,"ب",1,0],["وَعَشِيرَةٌ لوْ أُحْصِيَتْ بِكِرَامِهَا","كَانَتْ وَلا غَلْوَاءَ جَمْعَ عشَائِرِ",53,"ر",1,0],["وَعِشْ نَابِهاً بِالْعِلْمِ وَالْفَنِّ نَابِغاً","فَخَرُكَ مَوْفُورٌ وَفَضْلُكَ رَابِي",54,"ب",2,0],["وَعِشتُ بِمَغصوبِ المُلوكِ كَأَنَّني","أَموتُ طوىً لَو عفتهُ لِلتَعَفُّفِ",55,"ف",1,0],["وَعِشتُ مَعَ الأَقوامِ بِالفَقرِ وَالغِنى","سَقاني بِكَأسَي ذاكَ كِلتَيهِما دَهري",56,"ي",1,0],["وَعِشْتُ لِلْفَنِّ أَحْيَا في بَدَائِعِهِ","بَيْنَ الظِّلالِ وبَيْنَ السَّلْسَلِ الْجَارِي",57,"ر",2,0],["وعشنا بآمالٍ كأطيافِ نائمٍ","يروِّعها من دهرِنا ما يروِّع",58,"ع",1,0],["وعشائر غمت عليك أمورهم","لا أصدقاء فيرفدوك ولا عدا",59,"د",2,0],["وعش في غاءٍ والوزير كلاكما","وكلُّكمُ والدهرُ طوعٌ مساعد",60,"د",1,0],["وعشيِّ أنسٍ أضجعني نشوة ٌ","فيهِ تمهدُ مضجعي وتدمثُ",61,"ث",1,1],["وعش كما شئت ممتدحاً","تثنى بخير لآلٍ خير آلاء",62,"ا",2,0],["وَعِشْتَ على الأرضِ مثل الجبال","جليلاً، غريباً، وَحيد",63,"د",1,0]]}