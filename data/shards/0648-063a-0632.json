w.poetsgate.com/ViewPoem.aspx?id=186596",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5338,"أمة العرب قفي واستلهمي","https://www.poetsgate.com/ViewPoem.aspx?id=187618",""],[5363,"رثاء الشيخ البروفسور إبراهيم الكندي","https://www.poetsgate.com/ViewPoem.aspx?id=199950",""],[5449,"عيناكِ تشرين الكآبة","https://www.poetsgate.com/ViewPoem.aspx?id=189122",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5616,"العقد الفريد","https://www.poetsgate.com/ViewPoem.aspx?id=204588",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5698,"وَغَزالٍ أَعطاهُ مَليكُ الْقُلُوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=202627",""],[5725,"يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=211258",""],[5770,"سلامٌ لغزة","https://www.poetsgate.com/ViewPoem.aspx?id=178253",""],[5922,"صراخ فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=185119",""],[5956,"أقصوصة أنثى سُحاقية","https://www.poetsgate.com/ViewPoem.aspx?id=182690",""],[6048,"معراجُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=197747",""],[4442,"فتح الله للحقيقة بابا","https://www.poetsgate.com/ViewPoem.aspx?id=170992",""],[6134,"رجل الكرامة والوداعة والنهى","https://www.poetsgate.com/ViewPoem.aspx?id=169527",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[6346,"غزة والحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83386&r=&rc=2",""],[572,"أَكْفِنَا يا عَذُولُ شرَّ لسانِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9418&r=&rc=275",""]],"verses":[["وغزَتْ قلْبي ألْحاظُ الظِّبا","بظُباها أيْنَ يا قلْبُ المَفَرْ",0,"ر",1,0],["وَغَزَتْ جَحَافِلُهَا مُغِيراً جَائِحاً","يُفْنِي النَّبَاتَ وَتَرْكُهُ إجْرَامُ",1,"م",1,0],["وغزوتك البكر من غزوة","أباحت حمى الصين والبُتَّم",2,"م",1,1],["وَغَزالٌ فيهِ نِفارٌ وَلا بِد","عَ فَمِن شيمَةِ الظِباءِ النَفارُ",3,"ر",1,0],["وَغَزوَةً يَومَ نَجدٍ ثَمَّ كانَ لَهُم","مَعَ الرَسولِ بِها الأَسلابُ وَالنَفَلُ",4,"ل",1,0],["وَغَزوَةَ القاعِ فَرَّقنا العَدُوَّ بِهِ","كَما تَفَرَّقَ دونَ المَشرَبِ الرَسَلُ",4,"ل",1,0],["وَغَزوَةَ الفَتحِ كانوا في سَرِيَّتِهِ","مُرابِطينَ فَما طاشوا وَلا عَجِلوا",4,"ل",3,0],["وغزالاً لناظريه فتورٌ","تركا القلب كالزناد وريّا",5,"ي",2,0],["وغزالٍ ترى على وَجْنتيهِ","قَطْرَ سَهْمَيْهِ من دماء القلوبِ",6,"ب",1,1],["وغزال ذُو دلالٍ","كُلُّهُ داحٌ وَمَاحُ",7,"ح",1,0],["وَغَزَوتُمُ الآفاقَ لا زادَ لَكُم","إِلّا الصِبا المُتَوَثِّبُ المُتَضَرِّمُ",8,"م",1,0],["وَغَزالاً لِمُقلَتَيهِ بِقَلبي","فَتَكاتٌ كَأَنَّها فَتَكاتي",9,"ت",2,0],["وَغَزَلنا قَبلَ إِدريسَ الكُسا","وَنَسَجنا قَبلَ داوُدَ الزَرَد",10,"د",1,0],["وغزالا يعلق القلب به","فإذا أبصره زان ربخ",11,"خ",1,0],["وغِزلانٌ تُزيلُ الوَشيَ صَوْناً","لوَشْيِ جمالِها الغَضِّ الجديدِ",12,"د",1,0],["وَغَزوٌ فَما يَنفَكُّ في الأَرضِ طاوِياً","تَقَلقَلُ أَفراسٌ بِهِ وَرَواحِلُ",13,"ل",1,0],["وَغَزالٍ غازَلتُهُ بَعدَ بَينِ","أَلَّفَت بَينَهُ المُدامُ وَبَيني",14,"ن",2,1],["وَغَزالٍ مِن بَني ال","تُركِ أَلمى",15,"م",2,0],["وَغَزِيرُ دَمعي مُهتَدٍ","فيهِ وَقَلبي حائِرُ",16,"ر",1,0],["وَغَزالاً كُلَّما مَرَّ","تَمَنَّتهُ القُلوبُ",17,"ب",1,0],["وَغَزوَةٌ سارَ فيها المُصطَفى قُدُماً","إِلى بُواطٍ بِجَمعٍ ساطِعِ القَتَمِ",18,"م",1,0],["وَغَزوَتانِ لِعَبدِ اللَّهِ واجِدَةٌ","إِلى رِفاعَةَ وَالأُخرى إِلى إِضَمِ",18,"م",1,0],["وغزالٍ يغزو القلوبَ بجفنٍ","كمْ لهُ بالبهاءِ منْ مفتونِ",19,"ن",1,0],["وَغَزالٍ مُقَرطَقِ","ذي وِشاحٍ مُمَنطَقِ",20,"ق",1,1],["وَغِزلانِ إِنسٍ قَد طَرَقتُ بِسُدفَةٍ","فَلَم تَكتَحِل أَجفانُهُم بِرُقادِ",21,"د",1,1],["وَغَزالٍ تَشرَهُ النَف","سُ إِلى حَلِّ إِزارِه",22,"ر",2,0],["وَغَزالٍ في الدُجى لَي","ثِ ظَلامٍ ذي فِراسِ",23,"س",1,1],["وَغَزالٍ يَسبي النُفوسَ إِذا هَت","تَكَ مِنهُ مَآزِرَ الإِحرامِ",24,"م",1,0],["وَغَزالٍ يُديرُها بِبَنانٍ","ناعِماتٍ يَزيدُها الغَمزُ لينا",25,"ن",2,0],["وَغَزالٍ عاطَيتُهُ الراحَ حَتّى","فَتَّرَت مِنهُ مُقلَةً وَلِسانا",26,"ن",2,0],["وَغَزالٍ زانَ بِالقا","مَةِ رِدفاً بَربَرِيّا",27,"ي",2,0],["وَغِزلانُ فَرتاجَ اِنتَحَتكَ خِيانَةً","وَآسادُ خِفّانِ الَّتي لا تُغازِلُ",28,"ل",1,0],["وغزير الهدى من الحمد والتو","فيق صيغت لذاته الأسماء",29,"ا",2,0],["وغزال جفونه","سرقت عينك الحور",30,"ر",1,0],["وغزا الشِّراعَ؛ منهزمًا","وكفاه شرَّ الطيِّ والنثر",31,"ر",1,0],["وغزا الدروب فأجفلت قطّاعها","ووجوههم تحمرّ بالصفعات",32,"ت",1,0],["وَغَزال كَناسِهِ المرانُ","ما لِقَلب مِن مُقلَتيهِ أَمانُ",33,"ن",1,1],["وَغَزال للمسك في الفَم مِنهُ","نَفحات تَفوق مسك الغَزال",34,"ل",1,0],["وغز نبال تلك العين منه","بمهجته وتعلم ما النبال",35,"ل",1,0],["وغزيل في الركب اجج اوعتي","منه لطيف المبسم البراق",36,"ق",1,0],["وغزا القلوب بقده واعانه","طرف سبا البابنا سحاره",37,"ر",2,0],["وغزيلي حلو الطباع مجالسي","ومع الوقار سنا الجمال ازاره",37,"ر",2,0],["وغزيل عبث النسيم بطبعه","فمضى يرنحه كشارب راح",38,"ح",1,1],["وغزتني بمقلة تبعتها","في طريق الوغا جيوش الجمال",39,"ل",1,0],["وغزاهم الدينُ الحنيفي الذي","كتبتَ الظهورُ له على الأديانِ",40,"ن",1,0],["وَغَزَالٍ سَعى إِلَيَّ بِرَاحٍ","قَدْ حَكَتْهُ بِالسَّوِيَّةْ",41,"ه",1,1],["وَغَزوانَ فَاِحفَظ وُدَّهُ وَاِحتَفِظ بِهِ","تَجِد سَيفَ عَزمٍ في مَراضِيكَ فاصِلا",42,"ل",2,0],["وَغَزَتْ أرْتالُ بَرْدٍ حَوْزَتي","وسرَتْ سُمًّا بجوفِ الدّسَمِ",43,"م",1,0],["وغزال إذا بدا بجفون","ساحرات زينت بحسن فتور",44,"ر",1,0],["وَغَزالٍ مَنحتَهُ خالِصَ الود","دِ فَجازى بَالصَدِّ وَالاِجتِنابِ",45,"ب",1,1],["وغزا صميمَ الشرقِ جيشُ قُتَيبَةٍ","وتوَغّلَ ابنُ زيادِ في الأسبانِ",46,"ن",1,0],["وغزالٍ ذي اعتدالٍ شَفَّهُ","بعد ما شَفَّ هواهُ الأنفسا",47,"س",2,1],["وغزالين دنا وَصْلُهُما","بعد ما كانَ قصيَّاً غيرَ دانِ",48,"ن",1,1],["وغزلانها قد غازلتنا عيونها","الم تر فيها قد حمدنا التغزلا",49,"ل",2,0],["وغزالة يحكي الغزالة وجهها","ويدير ناظرها الغزال الاهيف",50,"ف",1,0],["وَغزالٍ أَحلى من الأَمنِ يَسعى","بِكئوسِ الغرام وَالصَهباء",51,"ا",2,0],["وَغَزا مريسيعاً فَتَمَّ مُرادُهُ","في آلِ مُصطَلِق بِلا خذلانِ",52,"ن",1,0],["وَغَزالٍ مِن آلِ شَيبانَ قَد أَح","رَمَ عَيني في اللَيلِ طيبَ الرُقادِ",53,"د",1,1],["وَغَزالٍ عَلِقتُهُ","يَومَ دَيرِ الثَعالِبِ",54,"ب",1,1],["وَغَزالٍ بِالحِمى غازَلَني","سُقمُ جَفنَيهِ بَرى جِسمي سَقاما",55,"م",2,0],["وَغُزلانٍ حِسانٍ في","سِواها يَقبُحُ الغَزَلُ",56,"ل",1,0],["وغزالً غزا فؤادي بسهمٍ","وسنانٍ من لحظه الوسنان",57,"ن",1,1],["وَغَزال غَزا القُلوب بِقَدٍّ","وَبِلَحظ فَهزَّ رُمحاً وَنَصلا",58,"ل",2,0],["وَغَزالاً مَتى تَصدّى لِصَدِّي","أَو غَزاني جَفا الرقادُ جُفوني",59,"ن",2,0],["وَغَزالٌ قَد تاهَ وَالقَلب مأواه","أَترى تيهاً اِنثَنى أَم دَلالا",60,"ل",2,0],["وَغَزالاً قَد أَفسَد العَقل عجباً","أَصلَح اللَه بِالمَحاسن حاله",61,"ل",2,0],["وَغَزال سربٍ في الفُؤاد كناسه","يَرعى الحَشاشة آمناً مُستَنفرا",62,"ر",2,0],["وَغَزال قَد غَزا جلدي","طرفه وَالقدُّ أملودُ",63,"د",1,0],["وَغَزال هزّ قَدّ قَنا","فتنَ الأَلباب ناظرُه",64,"ر",2,0],["وَغَزال هزّ قَدّ قَنا","فتنَ الأَلباب ناحلُه",65,"ل",2,0],["وَغَزال هزّ قَدّ قَنا","فتنَ الأَلبابَ حاجبُه",66,"ب",2,0],["وَغَزال هزّ قَدّ قَنا","ذو جَمال زيّن النقبا",67,"ب",2,0],["وَغَزت في الحَشى فَواتك جَفني","ه فَكانَت فَتّاكَة فَتّانَه",68,"ن",2,0],["وَغَزانا بِقامَة وَبِعَين","تِلكَ يَقظانَة وَذي نَعسانَه",68,"ن",2,0],["وغزالٍ مثل الغَزالةِ يَح","كِيها كَمالاً إِلا بِقَلبٍ وودِّ",69,"د",1,1],["وغَزالٍ أغنَّ أغيدَ ساجي الط","طَرفِ مُستَحسنِ الخَليقَةِ ناعِم",70,"م",1,0],["وغزوتَهم بحمائمٍ بقَت ولم","يَسبق نداك إلى العلوج وَعيدُ",71,"د",1,0],["وغَزالَةٍ غازَلْتُها","في المَقْسِ من أولادِ حامِ",72,"م",1,1],["وغَزالٍ كُلُّ مَنْ شبَّهَهُ","بِهلالٍ أو ببَدْرِ ظَلَمَهْ",73,"ه",1,1],["وغَزالٍ في فيه راحٌ ودرُّ","وعقيقٌ رطبٌ ومِسكٌ فتيقُ",74,"ق",1,1],["وغزلاناً لها في القلب مرعًى","ومن عَبرات هذا الطرف شرب",75,"ب",1,0],["وغزال زاد حسنا","بكحيل الطرف يجرح",76,"ح",1,0],["وغزالٍ أغنّ أحوى رخيمٍ","أهيفِ القدّ مخطفِ الكشحِ رُودِهْ",77,"د",2,0],["وغزالٌ أغنُّ مختصرُ الخص","رِ رخيمُ الدلالِ عنّي شَرودُ",78,"د",1,0],["وغزالٍ قضى عليّ غرامي","في هواهُ منه بتركِ التّقاضي",79,"ض",2,0],["وغزال لدنِ المعاطفِ كالخُو","دِ رقيقِ الخدودِ كالجِريالِ",80,"ل",1,0],["وغزال ألحاظُه سحّاره","أشتهي قُرْبَه وأخشى نِفارَهْ",81,"ر",2,1],["وغزا قريشا بالبطاح فلفَّها","بيدٍ وقوَّضَ عزَّها وخيامَها",82,"م",3,0],["وغزوُنا مجمَّعا","وحجُّنا والموس