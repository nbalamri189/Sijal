{"poems":[[55,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[74,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[91,"هاتوا اذكروا لي هاتوا","https://www.aldiwan.net/poem44906.html","المجتث"],[45,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[47,"يزداد في غي الصبا ولعه","https://www.aldiwan.net/poem64662.html","الكامل"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[48,"قد يحج الفتى ويغنى بعرس","https://www.aldiwan.net/poem22640.html","الخفيف"],[48,"أوف ديوني وخل أقراضي","https://www.aldiwan.net/poem22894.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54655","الرمل"],[92,"النفثة!","https://www.poetsgate.com/ViewPoem.aspx?id=179076",""],[47,"يَزْدادُ في غَيّ الصّبا وَلَعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31128",""],[113,"لي حبيب فداه كل حبيب","https://www.aldiwan.net/poem16682.html","الخفيف"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[242,"قسما بمن بالصد قد أضناني","https://www.aldiwan.net/poem19096.html","الكامل"],[255,"أنا في راحة من الآمال","https://www.aldiwan.net/poem15018.html","الخفيف"],[385,"من لولهان كئيب","https://www.aldiwan.net/poem49235.html","مجزوء الرمل"],[385,"مدمع بات يسفح","https://www.aldiwan.net/poem49237.html","مجزوء الخفيف"],[438,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[482,"قولوا لجيران العقيق والنقا","https://www.aldiwan.net/poem15364.html","الرجز"],[534,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[543,"وجمرة الوجنة ذاب","https://www.aldiwan.net/poem47912.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77659","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96742","الرمل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105210","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136145","الخفيف"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31610","المنسرح"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205476","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101024","الخفيف"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107344","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108461","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109285","السريع"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124165","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53044","الرمل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100797","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216550",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216549",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117927","السريع"],[4068,"","https://poetry.dctabudhabi.ae/diwan/poem/206115","الكامل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136875",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72411","المنسرح"],[4691,"كلّما أبصر الجميلة سبّحتُ","https://www.poetsgate.com/ViewPoem.aspx?id=215988",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5472,"مالبرّ الأمير قصّر عنى","https://www.poetsgate.com/ViewPoem.aspx?id=200465",""],[4455,"ما لبث الفَتَيانِ أن عَصفَا بهم","https://www.poetsgate.com/ViewPoem.aspx?id=82302",""],[6003,"أزقة مجنونه","https://www.poetsgate.com/ViewPoem.aspx?id=188917",""],[6115,"ياذميري وصل المكتوبي","https://www.poetsgate.com/ViewPoem.aspx?id=180532",""],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""]],"verses":[["ما لُبثُ مَن يُمسي مَجازاً لِلرَّدى","وَمُعَرَّجَ القَدَرِ المُغَذَّ المُسرِعِ",0,"ع",1,0],["ما لبس من لاقاه يوم الوغى","دروعه بل هي أكفانه",1,"ن",2,0],["مالبر تقطعه كالز","زوابع القطرات",2,"ت",1,0],["ما لَبِسنا فيهِ الأَكاليلَ حَتّى","لَبِسَتها تِلاعُهُ وَوِهادُه",3,"د",2,0],["مالُبَثُ رَيعانِ الشَبابِ إِذا","نُذُرُ المَشيبِ تَلاحَقَت شُروعُه",4,"ع",2,0],["مالَ بي عَن عَيشَةٍ كَرُمَت","عُمُرٌ أَدنى إِلى الهَرَمِ",5,"م",1,0],["ما لِباسُ التَقوى عَلى الناسِ لَكِ","نَّ ثِياباً عَلى الخَنى مَزرورَه",6,"ر",2,0],["ما لِبَني آدَمٍ غَدوا أُمَماً","لَهُم عُروضٌ بِغَيرِ أَعراضِ",7,"ض",1,0],["مَا لَبِثْنَا أَنْ رَأَيْنَاهَا وَقَدْ","هَبَطَتْ عَنْ ذَلِكَ الْعَرْشِ وَبَانَتْ",8,"ت",1,0],["ما لبلادي فظّةٌ روحُها","بعيدة عن هزةِ الارتياح",9,"ح",1,0],["ما لَبْثُ رَيْعَانِ الشّبابِ، إذا","نذر المَشيبِ تَلاَحَقَتْ شُرَعُهْ",10,"ع",2,0],["مال بِالنَوم قَدهُ المَيّال","عَن جُفوني وَزادَني بلبال",11,"ل",1,0],["مالَ بِها سُكرُ الهَوى وَالصِبا","مَيلَ الصَبا بِالغُصُنِ النَضرِ",12,"ر",1,0],["مَالْبُحْتُرِي وَأَبُوفِرَاسٍ وَالْبَهَا","بِأَرَقَّ مِنْكَ وَلاَ الْفَتَى الْهَمَذَانِي",13,"ن",2,0],["ما لباسُ الحرير مما أُرَجِّيهِ","فيُرجَى ولا ركوبُ البغال",14,"ل",1,0],["مالَ بِالإِلباب مِنهُ","ميَل القَد الرَطيب",15,"ب",1,0],["ما لُباب النَجاة في","حُبِهِ لَيسَ يَفتَح",16,"ح",1,0],["ما لِبِكْرِ السرور إن لم تُصبْها","سَورةُ الراحِ من أداةِ افتضاضِ",17,"ض",1,0],["ما لبناتِ العَشْرِ والعَشْرِ في","جدِدّ بني الخمسين من مَلعبِ",18,"ب",1,0],["ما لبقائي بعدَ بعدَ بُعدي عنكمُ","معنًى فاِنْ لقيتكم طابَ البقا",19,"ق",2,0],["ما لُبْسُكَ الدِّيباجَ والتّاجَ مَعْ","رُكُوبِكَ الأَدْهَمَ الأَشْقَرا",20,"ر",2,1],["ما لِبَناتِ الرُّومِ زُر","قَ اللَّحظِ زُهرَ المَرنِ",21,"ن",1,0],["ما لَبِثَ الشاعر أَن ناداهُ","مُستعجِلٌ فَرفعَت يَداه",22,"ه",1,0],["ما لبرقِ الأبرقينِ","هاج لي بيناً ببينِ",23,"ن",1,1],["مال بعطفيه الغرّي فرحا","نشوان في ذكر المليك طربا",24,"ب",2,0],["مالباب الوصول فيها ارتتاج","ليت شعري متى يزول الرتاج",25,"ج",1,0],["مالُ بَخيلٍ يَظَلُّ يَجْمَعُهُ","مِنْ كُلُّ وَجْهٍ ولَيْسَ يَفْتَرِقُ",26,"ق",1,0],["ما لبنيك النجب الأبطال","أضحوا على الأيام والليالي",27,"ل",2,0],["مال بالود حيث مالت رياح","فكفى نفسه الهوى وكفانى",28,"ن",2,0],["ما لباريس لا ترى أهل مصرٍ","بين أهل السلام للعدل أهلا",29,"ل",2,0],["ما لَبيدٌ لديهِ إِلّا بَليدٌ","في المعاني فما بديعُ الزمانِ",30,"ن",1,0],["ما لَبِثا في الفَوزِ يَوماً واحِدا","حَتّى اِستَعاضا مِنهُ جُهداً جاهِدا",31,"د",2,0],["ما لبنتي شُعيبَ عنه تذودا","نِ انكساراً إذ هَزَّ موسى الوفاء",32,"ا",2,0],["ما لبيروتنا الحزينة سلوى","وعزاء ما دمت عنها بعيدا",33,"د",2,0],["ما لبياض الرأس حكم هنا","لكن سواد الحظ قد ألزمك",34,"ك",1,0],["مال بأغصانِ النقا نسيمها","فغار من قوامها قويمها",35,"م",3,1],["ما لبانات الحمى لا جادها","غيث دمعي وذوى منها الرطيب",36,"ب",1,0],["ما لِبنتِ الحسيبِ هامت بوغدٍ","سافلٍ جاهلٍ غويٍّ خؤونِ",37,"ن",1,1],["مِ البنّ ابّا يالخِلْ فِنْيالْ","يَشْفي ارْتِشَافَهْ عِلَّهْ الميتْ",38,"ت",1,1],["مِ البَلَمْ ألْفْ الَمْ حَلَّنْ بي","تِسْلَمْ العَبْرَهْ وراكِبْها",39,"ب",3,0],["ما لَبِثنا يَوماً وَلا بعَض يَوم","بل لَبِثنا السنين رهن جوانا",40,"ن",2,0],["مالبدر الهمدي برغم الممالي","غاب بعد الطلوع في الغبراء",41,"ا",2,0],["مالبحر الندى الذي فاق جوداً","غاض وهو الخضم في البوغاء",41,"ا",2,0],["ما لبغاث الطير في جوّها","تطمع في نيل أذى نسره",42,"ر",2,0],["ما لبّث الفتيان أن عصفا بهم","ولكلّ حصن يسّراً مفتاحا",43,"ح",2,1],["مال بي عن طريق القوم داعي الدعاوي","ثم ذا الحين روتني رياك التراوي",44,"ا",3,0],["ما لبيتي لابساً ثوب السواد","ما لقومي أعلنوا صبغ الحداد",45,"د",1,0],["ما لبس الفخر غير ما سلب إلا","يجاب في حبهم من السلب",46,"ب",1,0],["ما لبدر السماء فضلٌ لعيني","في الليالي وما به ما يسرُّ",47,"ر",1,0],["ما لبغدادَ كاليتيمة ِ تبدو","وعلى رأسِها من الحزن ِ شالُ ؟",48,"ل",1,0],["ما لبيت المجد أهل غيرهم","وسواهم ليس إلا نضدا",49,"د",2,0],["مالبرّ الأمير قصّر عنى","بعد أن لم أكن أرى تقصيرا",50,"ر",2,1],["ما لبث الفَتَيانِ أن عَصفَا بهم","لكُل حِصنٍ يَسرا مفتَاحا",51,"ح",2,1],["مال بال قلبك بالاحزان يشبعني","قلبي الذي من دوامِ البُعدِ ينفطرُ",52,"ر",1,0],["مالبسنا ثوبنا مقلوبي","يوم ناس ثيابهامقلوبه",53,"ب",2,0],["ما لبناتِ العشرِ والعشرِ في","جدّ بني الخمسين من ملعبِ",54,"ب",1,0]]}