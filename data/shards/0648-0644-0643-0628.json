{"poems":[[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199815","المسحوب"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61284","الكامل"],[3832,"","https://poetry.dctabudhabi.ae/diwan/poem/202305","الطويل"],[4797,"ليه المسا","https://www.poetsgate.com/ViewPoem.aspx?id=50255",""]],"verses":[["ولك برفع جزيل الشّكر دامت","لكم لاعياد باسعادٍ هنيّه",0,"ي",2,0],["وَلكبرِ ما نَقَموا عَلَيهِ ضلَّةً","قُربى تُبَرُّ وَهَفوَةٌ تُتغمَّدُ",1,"د",1,0],["ولك بما حازت يداه من الغنى","يصير أميرا للئيم الملطم",2,"م",1,0],["ولك بيرق ٍ فالقلب حبك يهبّه","شامخ ولا هزه من العذل غارات",3,"ت",1,0]]}