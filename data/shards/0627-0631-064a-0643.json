y.dctabudhabi.ae/diwan/poem/120498","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120239","الطويل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[4755,"لِصَمتِكِ وهْو يَقرَؤُنِي استِماعا","https://www.poetsgate.com/ViewPoem.aspx?id=197893",""],[4775,"غربة حرف","https://www.poetsgate.com/ViewPoem.aspx?id=175346",""],[5273,"مُغتَصَبة","https://www.poetsgate.com/ViewPoem.aspx?id=28769",""],[5273,"حديثك","https://www.poetsgate.com/ViewPoem.aspx?id=198355",""],[5323,"من النافذة","https://www.poetsgate.com/ViewPoem.aspx?id=207565",""],[5323,"عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=207566",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5827,"أرى كذباً تلوحُ به وتزهو","https://www.poetsgate.com/ViewPoem.aspx?id=207778",""],[5956,"الغُراب الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=183457",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5973,"تعجلت الرحيل إلي الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=22123",""],[5992,"أرى كلِّ نجمٍ عارياً وعطارِدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=41834",""],[4442,"أبت أن تسيغ العيش ألا بما تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=170991",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[520,"أرى كل جمع بالردى يتفرق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577582",""],[6239,"الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75970&r=&rc=21",""],[463,"أشاقكَ منْ حسناءُ وهنا طروقها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60156&r=&rc=212",""],[6316,"في رثاء الشيخ بن باز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65165&r=&rc=0",""],[6320,"نَشِيجُ الخِضَمّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83635&r=&rc=16",""],[6336,"أشواق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73400&r=&rc=6",""]],"verses":[["أَرى كُلَّ حَيٍّ مِن فُضالاتِ سَيفِهِ","وَها هُوَذا طاغي الغِرارِ صَقيلُ",0,"ل",1,0],["أَرى كُلَّ زادٍ ما خَلا سَدَّ جَوعَةٍ","تُراباً وَكُلُّ الماءِ عِندِيَ آلُ",1,"ل",1,0],["أَرى كُلَّ رُزءٍ دونَ رُزئِكَ قَدرُهُ","فَلَيسَ يُلاقيني لِيَومِكَ ما يُنسي",2,"س",2,0],["أَرى كُلَّ يَومٍ وَالأَعاجيبُ جَمَّةٌ","عَلى وَبَرِ الجَربى وُسومَ الصَحايحِ",3,"ح",1,0],["أَرى كُلَّ حُبٍّ غَيرَ حُبِّكِ زائِلاً","وَكُلَّ فؤادٍ غَيرَ قَلبيَ سالِيا",4,"ي",2,0],["أرى كلَّ مَنْ جَرّبْتُ منهُمْ مُداجِياً","إذا لمْ يُصرِّحْ بالإساءَةِ عَرّضا",5,"ض",2,0],["أرى كُلَّ قَيْسِيٍّ يَنالُ بكَ الغِنى","فَما لخُزَيْمِيٍّ يُحالِفُهُ الفَقْرُ",6,"ر",1,0],["أَرى كُلَّ مَعشوقَينِ غَيري وَغَيرَها","قَدِ اِستَعذَبا طَعمَ الهَوى وَتَمَتَّعا",7,"ع",2,0],["أَرَى كُلّ فَتْكٍ للحاظ انْتِسَابُهُ","وَهَانَ مَضَاءً لَيْسَ فِيهِ لَهَا حَظُّ",8,"ظ",1,1],["أَرى كُلَّ يَومٍ بِالجَرائِدِ مَزلَقاً","مِنَ القَبرِ يُدنيني بِغَيرِ أَناةِ",9,"ه",1,0],["أَرى كُلَّ مُجرٍ أَبا عامِرٍ","يُسَرُّ إِذا في خَلاءٍ رَكَض",10,"ض",1,0],["أَرَى كُلَّ دِينٍ جَاءَ بِالخَيْرِ طَاهِراً","وَلاَ شَيْءَ غَيْرَ الشَّرِّ عِنْدِي مُتْهَمُ",11,"م",1,0],["أرى كنوز المعالي مالأقْفُلِها","غير السماح لعمري من مفاتيح",12,"ح",1,0],["أرى كَبشَين ينتطحان جهلاً","لدى الجزار في دار الضيافه",13,"ف",2,0],["أرى كل ذي فقر لدى كل ذي غنىً","أجيراً له مستخدَماً في عَقاره",14,"ر",2,0],["أرى كل حيّ في الحياة ممُثلاً","رواية رؤيا من كتاب المقادر",15,"ر",1,0],["أرى كل نعمى ذاتَ رَنْقٍ يَشوبها","سوى نعمة الخَلّال قلَّ حسودُها",16,"د",3,0],["أرى كلَّ مدحٍ قيل فيمن سواكمُ","فليست له إلا البيوتَ مَناشدُ",17,"د",1,0],["أرى كل لؤمٍ في اللئام فإنما","عُصارتُهُ من عودك السَّوء تُعصر",18,"ر",1,0],["أرى كل معلوم فبالفحص عِلمُهُ","وفضلُك معلوم بلا فحص فاحص",19,"ص",1,0],["أرى كلَّ ضِدٍّ إلى ضِدِّهِ","من الخير في طبعه السالمِ",20,"م",1,0],["أَرى كُلَّ مَعشوقَينِ غَيري وَغَيرُها","يِلَذّانِ في الدُنيا وَيَغتَبِطانِ",21,"ن",1,1],["أَريكَةُ مولِييرَ فيما مَضى","وَعَرشُ شِكِسبيرَ فيما سَلَف",22,"ف",1,0],["أَرى كُلَّنا يَبغي الحَياةَ لِنَفسِهِ","حَريصاً عَلَيها مُستَهاماً بِها صَبّا",23,"ب",2,0],["أَرى كُلَّ ذي مُلكٍ إِلَيكَ مَصيرُهُ","كَأَنَّكَ بَحرٌ وَالمُلوكُ جَداوِلُ",24,"ل",1,0],["أُريكَ الرِضا لَو أَخفَتِ النَفسُ خافِيا","وَما أَنا عَن نَفسي وَلا عَنكَ راضِيا",25,"ي",2,1],["أَرى كَذِبَ الأَحلامِ صِدقاً وَكَم صَغَت","إِلى خَبَرٍ أُذنايَ غَيرِ صَدوقِ",26,"ق",1,0],["أَرى كُلَّ مُؤذٍ عاجِزاً عَن أَذِيَّتي","إِذا هُوَ لَم يُنصَر عَلَيَّ بِموقِ",26,"ق",1,0],["أَرى كُلَّ حَيٍّ مَيِّتاً فَمُوَدِّعاً","وَإِن عاشَ دَهراً لَم تَنُبهُ النَوائِبُ",27,"ب",1,0],["أَرى كُلَّ أَرضٍ كانَ صَعباً طَريقُها","أُذِلَّ لَكُم بِالمَشرَفِيِّ كَؤودُها",28,"د",3,0],["أَرى كُلُّ قَومٍ وَدَّ أَكرَمُهُم أَباً","إِذا ما اِنتَمى لَو كانَ مِنّا أَوائِلُه",29,"ل",2,0],["أَرى كُلَّ بَحرٍ غَيرَ بَحرِكَ أَصبَحَت","تَشَقَّقُ عَن يَبسِ المَعينِ سَواحِلُه",30,"ل",2,0],["أَرى كُلُّ مَن صَلّى يُصَلّي وَراءَنا","وَكُلُّ غُلامٍ يَنسِلُ العامَ قابِلُه",31,"ل",2,0],["أَرى كُلَّ حَيٍّ لا يَزالُ طَليعَةً","عَلَيهِ المَنايا مِن فُروجِ المَخارِمِ",32,"م",1,0],["أَرى كُلَّ جانٍ مِن تَميمٍ إِذا جَنى","لَهُم حَدَثاً كانَت عَلَيَّ جَرائِمُه",33,"م",2,0],["أَرى كُلَّ حَيٍّ حَيُّكُم فاضِلٌ لَهُ","وَأَمواتُكُم خَيرُ الشُعوبِ الأَقادِمِ",34,"م",1,0],["أَرى كاهِلَي سَعدٍ أَتى مَنكَباهُما","عَلَيَّ وَرامي آلِ سَعدٍ كِلاهُما",35,"م",2,1],["أَرى كُلَّ مَألوفٍ يُعَجَّلُ فَقدُهُ","فَما بالُ فَقدِ الإِلفِ لَيسَ لَهُ فَقدُ",36,"د",1,0],["أَرى كُلَّ مَن يَستَخلِصُ الشُكرَ بَعدَهُم","مِنَ الناسِ نَحراً لا يَليقُ بِهِ عِقدُ",36,"د",1,0],["أَرى كُلَّ ذي داءٍ يُداوى بِضَدِّهِ","وَلَيسَ يُداوى ذو الخُمارِ بِلا خَمرِ",37,"ر",1,0],["أريكِ مشيبَ الفؤادِ الشهيدِ","والشيبُ ما كلَّلَ المفرقَا",38,"ق",2,0],["أَرى كُلَّ قَومٍ يَنظُرونَ إِلَيهِمُ","وَتَقصُرُ عَمّا يَفعَلونَ الذَوائِبُ",39,"ب",1,0],["أَرى كُلَّ قَومٍ قارَبوا قَيدَ فَحلِهِم","وَنَحنُ خَلَعنا قَيدَهُ فَهوَ سارِبُ",39,"ب",1,0],["أَرَى كُلَّ حَيٍّ غَافِلاً عَنْ مَصِيرِهِ","وَلَوْ رَامَ عِرْفَانَ الْحَقِيقَةِ لانْتَمَى",40,"م",2,0],["أَرى كُلَّ أَرضٍ دُستُ فيها وَإِن مَضَت","لَها حِجَجٌ يَزدادُ طيباً تُرابُها",41,"ب",3,1],["أرى كُلَّ مِيراثٍ جَليلٍ مُحبَّباً","ولا مثلَ ميراثِ النبيِّ مُحمَّدِ",42,"د",1,0],["أَرى كُلِّ وَضّاحِ المَقامَةِ نابِهٍ","عَلى خَطَرٍ مِن مُرجِفاتِ المَآلِكِ",43,"ك",1,0],["أَرى كُلَّ نَهّاضٍ إلى المَجدِ صاعِداً","بِعَزمٍ مَتى يَركَب جَناحَيهِ يَعصِفِ",44,"ف",1,0],["أَرى كُلَّ يَومٍ في ظَلامِ مَفارِقي","شِهابَ مَشيبٍ باقِيَ الأَثرِ مُنقَضّا",45,"ض",2,0],["أريكَ به نَهْجَ الخلافة مَهيَعاً","يُبين وأعلامَ الخلافة وُضَّحا",46,"ح",2,0],["أُريكَ بمرآةِ الإمَامَةِ كاسْمها","على كُورِ عَنْسِ والإمامَ المرشَّحا",46,"ح",2,0],["أَرى كُلَّ حَيٍّ هالِكاً وَابنَ هالِكٍ","وَذا نَسَبٍ في الهالِكينَ عَريقِ",47,"ق",1,0],["أُريكَ حربَ بسوسٍ","برهبةٍ وتذعر",48,"ر",1,0],["أَرى كَدراً عَمَّ المَوارِدَ كُلَّها","فَمُت أَو تَجَرَّع مِن خَبيثِ المَوارِدِ",49,"د",1,0],["أَرى كُلَّ مَولودٍ يُناسِبُ والِداً","وَما كُلَّ مَولودِ الأَنامِ بِوالِدِ",50,"د",1,0],["أَرى كُلَّ أُمٍّ عُبرُها غَيرُ مُبطِئٍ","وَما أُمُّ دَفرٍ بِالَّتي بانَ عُبرُها",51,"ر",3,1],["أَرى كَفرَطابٍ أَعجَزَ الماءُ حَفرَها","وَبالِسَ أَغناها الفُراتُ عَنِ الحَفرِ",52,"ر",1,1],["أَرى كُلَّ خَيرٍ في الزَمانِ مُفارِقاً","فَلا تَأسَفَنّ فيها لِقِلَّةِ خَيرِكا",53,"ك",2,1],["أرى كلِّ فَدمٍ قَد تَبحبَحَ في الغِنى","وذُو الظَّرف لا تلْقاهُ غيرَ عَديمِ",54,"م",1,0],["أرى كل فتق سوف يرقع وَهيُهُ","وَلَيسَ عَلى الأيام وهيُكَ يرقع",55,"ع",1,0],["أَرَى كُلَّ شَيءٍ عُرْضَةً لِلتَّغَيُّرِ","فَمَا بَالُنَا بَعْدَ الْحَقِيقَةِ نَمْتَرِي",56,"ي",1,1],["أَرَى كُلَّ شَيءٍ لا يَدُومُ فَمَا الَّذِي","يَنَالُ امْرُؤٌ مِنْ حُبِّ مَا لا يُفِيدُهُ",57,"د",2,0],["أَرَى كُلَّ حَيٍّ ذَاهِبَاً بِيَدِ الرَّدى","فَهَلْ أَحَدٌ مِمَّنْ تَرَحَّلَ رَاجِعُ",58,"ع",1,0],["أَرَى كُلَّ حَيٍّ يَظْلِمُ الدَّهْرَ جُهْدَهُ","وَلَسْتُ أَرَى لِلدَّهْرِ فِي عَمَلٍ ذَنْبَا",59,"ب",2,1],["أريك من أسفي خصما تباعده","والقلب من حبك المكنون ولهان",60,"ن",1,0],["أرى كل شر كان في الفقر وحده","وذو الفقر لا يدرى إلى أين ينفذ",61,"ذ",1,0],["أرى كلَّ مشنوءِ الخليقةِ واصلا","قِصارَ حبال عجزه بحبالى",62,"ل",2,0],["أَرى كُلَّ مُعوَجِّ المَوَدَّةِ يُصطَفى","لَدَيكُم وَيَلقى حَتفَهُ مَن تَقَوَّما",63,"م",2,0],["أرى كل شيءٍ له آيةٌ","وآيةُ هذي الليالي العبرْ",64,"ر",1,0],["أَرَى كلَّ حُرٍّ فيك غيرَ مكرَّمٍ","وكلَّ وضيع في سُعودٍ وإِكرام",65,"م",1,0],["أرى كلّ أَرضٍ لستَ فيها كأنها","عليَ ظلامٌ دامسٌ ماله فجر",66,"ر",1,0],["أرى كل صبر لا يذم أخيره","وصبري على لميا ذميم العواقب",67,"ب",1,0],["أرى كلّ عالٍ بالسّقوطِ مُهدَّداً","وكلَّ صباحٍ قد تلاهُ مساء",68,"ا",2,0],["أرى كلّ جبّار يثلّ وعرشهُ","يُثَلُ ويبقى وجه ربّك ذو العرش",69,"ش",1,0],["أَرى كُلَّ يَوْمٍ مِنَ الْحادِثاتِ","لَنا وَقْعَةً نُصْطَلِي نارَها",70,"ر",3,0],["أَرى كُلَّ يوْمٍ لَنا رَوْعَةً","كَما ذُعِرَ النَّعَمُ السّارِحُ",71,"ح",1,0],["أَرى كُلَّنا يَسعى إِلى حينِ حَينِهِ","وَكَم يَلبَثُ البازُ المُقيمُ بِقُفّازِ",72,"ز",1,0],["أَرى كلَّ ميزانٍ سوى الطبع في الفتى","لما يزيد الشعر في وَزنه خسرا",73,"ر",2,0],["أرى كل ذي سكر سيصحو من الهوى","سواي فصحوي فيك علة سكرتي",74,"ي",1,0],["أَرى كُلَّ ذي مالٍ يَسودُ بِمالِهِ","وَإِن كانَ لا أَصلٌ هُناكَ وَلا فَضلُ",75,"ل",1,0],["أَرى كُلّ مَجدٍ أَنتَ ذروة مَجدِهِ","عَلى أَنَّهُ لَفظ وَكُنت لَهُ مَعنى",76,"ن",2,0],["أَرى كلّاً حَوى أَسرار مَولىً","إِلى أَهل الهُدى أَمسى إِماما",77,"م",2,0],["أَرى كَواكب مَجدٍ في الحِمى طَلعت","مِنها البُدور وَمِنها الأَنجُم الزُهرُ",78,"ر",1,0],["أَرى كَرَم الأَخلاق شَرعاً وَإِنَّما","سَجايا أَبيك الغُرّ هُنَّ مَذاهبُه",79,"ب",2,0],["أَرى كُلَّ عُضوٍ مِنكَ كَالقَلبِ في غَضىً","وَكَالجَفنِ في إِرسالِهِ لُؤلُؤاً رَطبا",80,"ب",2,0],["أَرى كُلَّ ذِكرٍ غَيرَ ذِكرِكَ يَنقَضي","فَدونَ العُلا ما لا يَمَلُّ التَقاضِيا",81,"ي",2,0],["أَرى كلَّ يَومٍ عارِضاً مُتَعرِّضاً","مُقيماً إِذا همَّ العُفاةُ بِه هَما",82,"م",2,0],["أرَى كلَّ من يَهواكَ يلقاكَ قاتِلاً","كأنَّك في بعضِ العيونِ الفَواتِرِ",83,"ر",1,0],["أرى كل شعرٍ في سواك شعيرةً","بَهائمُها تجترُّها وحميرها",84,"ر",3,0],["أرى كلُّنا يهوى الحياةَ لنفسه","حريصاً عليها مستهاماً بها صَبَّاً",85,"ب",2,0],["أرى كلما فيه يدال بضده","لها في بنيها كل آونة أنبا",85,"ب",2,0],["أرى كلّ ضرَّاء شكوناه ضرّها","يزايلها في بأسه فتزول",86,"ل",1,0],["أرى كلّ من يروي ثناءً ومدحةً","ففيك ر