{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[82,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[35,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[72,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[72,"علي ديون من ثنا لم أقم بها","https://www.aldiwan.net/poem19615.html","الطويل"],[64,"ألا أبلغ أحبائي بأني","https://www.aldiwan.net/poem67597.html","الوافر"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[51,"علي دين ثقيل أنت قاضيه","https://www.aldiwan.net/poem66716.html","البسيط"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[45,"فؤاد بذكر الظاعنين موكل","https://www.aldiwan.net/poem65589.html","الطويل"],[28,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[33,"ألا يا غرابا صاح من نحو أرضها","https://www.aldiwan.net/poem25778.html","الطويل"],[33,"لصفراء في قلبي من الحب شعبة","https://www.aldiwan.net/poem25819.html","الطويل"],[33,"أقول لأصحابي وقد طلبوا الصلى","https://www.aldiwan.net/poem25912.html","الطويل"],[48,"على دمنة الدار لا تربع","https://www.aldiwan.net/poem66620.html","المتقارب"],[160,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[232,"على دمع عيني من فراقك ناظر","https://www.aldiwan.net/poem14703.html","الطويل"],[246,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[273,"وجوه الأماني بكم مسفره","https://www.aldiwan.net/poem1309.html",""],[305,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[328,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[432,"إني أبثك حالي","https://www.aldiwan.net/poem12699.html","المجتث"],[437,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[458,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[551,"على دار حللت بها سلامي","https://www.aldiwan.net/poem47213.html","الوافر"],[562,"اذا أعيت مكأفأة الجميل","https://www.aldiwan.net/poem52747.html","الوافر"],[562,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[587,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[587,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["عَلى دِيارِ مَعشَرٍ","خانوا العُهودَ وَالذِمَم",0,"م",1,0],["عَلَيَّ دِماءُ البُدنِ إِن لَم أُثِر بِها","رَعيلاً يَشُقُّ الأَرضَ بَعدَ رَعيلِ",1,"ل",1,0],["عَلى دِيارٍ منَ الإِسلامِ خالِيَةٍ","قَد أَقفَرَت وَلَها بالكُفرِ عُمرانُ",2,"ن",1,0],["عَلَيَّ دِماءُ البُدنِ إِن كانَ حُبُّها","عَلى النَأيِ أَو طولَ الزَمانِ يَريمُ",3,"م",1,0],["على دولة الأملاك كلّ فصوله","ربيع وفي الأعدا سعودٌ ذوابح",4,"ح",1,0],["عليَّ ديون من ثناً لم أقم بها","فيا عجباً لي في ازديادٍ من الفضل",5,"ل",1,1],["عَلى دينِ الصَليبِ يَكونُ مَوتي","وَلا البَطحا أُريدُ وَلا المَدينَه",6,"ه",1,0],["على دنان كأنها جثث","من قوم عاد عظيمة الخلق",7,"ق",1,0],["عليَّ دينٌ ثقيلٌ أنتَ قاضيهِ","يا مَنْ يُحَمِّلني دَيْني رَجائيهِ",8,"ي",2,1],["عَلى دِمنَةٍ فيها لِأُدمانَةِ النَقا","مَحاسِنُ أَيّامٍ تُحَبُّ وَتُعشَقُ",9,"ق",1,0],["عَلى دارِسِ الآياتِ عافٍ تَعاقَبَت","عَلَيهِ صَباً ما تَستَفيقُ وَشَمأَلُ",10,"ل",1,0],["عَلى دينِهِم وَالهِندُ تُزجى فُيولُهُم","وَبِالرومِ في أَفدانِها رومِ قَيصَرا",11,"ر",2,0],["عَلى دِمنَتَي دارٍ لِلَيلى كَأَنَّها","إِزارانِ مِن بُردٍ لَها خَلَقانِ",12,"ن",1,0],["عَلَيَّ دِماءُ البُدنِ إِن كانَ حُبُّها","عَلى النَأيِ في طولِ الزَمانِ يَريمُ",13,"م",1,0],["عَلى دَوحَةٍ يَستَنُّ تَحتَ أُصولِها","نَواقِعُ ماءٍ مَدَّهُ رَصَفُ الصَخرِ",14,"ر",1,0],["على دمنةِ الدار لا تربع","ومن حذَرِ البينِ لا تجزع",15,"ع",1,1],["على دنيا بعيد ان تراها","وان حصلت فما تسوى قلامه",16,"م",2,0],["عَلى دينِنا ساقوا كتائبَ كتبهم","وَفي حَربهِ جاءَت جرائدُهم تترى",17,"ر",2,0],["عَلى دَمعِ عَيني مِن فِراقِكَ ناظِرٌ","يُرَقرِقُهُ إِن لَم تُرِقهُ المَحاجِرُ",18,"ر",1,1],["عليَّ دْماءُ الُبدن إن كانَ زوجُها","يرى لَي ذَنباً غيرَ أنّي أزورُها",19,"ر",3,0],["عليّ ديونٌ وتَصحيفُها","وعندكُم الجود والمَغفِره",20,"ر",2,0],["عَلى دَولةٍ أَسمى وأَعظم بهجةً","مِنَ الدولةِ الوسطى وَصادقها الأسطى",21,"ط",2,0],["على دارك يا جاري","صباح الخير من داري",22,"ي",1,1],["على دَخَنٍ بغياً فضَلَّت عقولها","إلامَ المعالي يملك الرذل رقّها",23,"ه",2,0],["عليّ دينٌ ومالي","شيءُ سوى آمالي",24,"ي",1,0],["على دقّت عن الأفهام حتى آس","توى منها المبلّد والذكيّ",25,"ي",1,0],["على دين الأكارم وهو خِرْق","يعدُّ الحمدَ أولى ما استدامَهْ",26,"م",2,0],["على دارٍ حَللتَ بِها سَلامي","وَجادَتها مغلَّسةُ الغمامِ",27,"م",1,1],["عليَّ ديونُ شكرٍ ليسَ تُقضى","لو قُسمَت على دهرٍ طويلِ",28,"ل",1,0],["عليَّ ديونٌ رُتِّبَتْ لجَلالِهِ","فأصبحتُ مديوناً أخافُ مِن الكَسْرِ",29,"ر",1,0],["على درجات فاعلمن ذكرتها","ثلاث فأولاها بها الآن أبتديد",30,"د",1,0],["على دارس الأطلال بالمتحلب","نسيج الصبا تبكي بدمع كصيب",31,"ب",1,1]]}