226",""],[5431,"من هلوسات الحمى (3)-وشعبي سيغلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=198325",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[5670,"أُحاذر أن يشتَمَّ قلبي عبيرَها","https://www.poetsgate.com/ViewPoem.aspx?id=215260",""],[5683,"برج الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=32346",""],[5727,"الهوى الجنوبي","https://www.poetsgate.com/ViewPoem.aspx?id=205798",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5736,"على دروب انتظاري","https://www.poetsgate.com/ViewPoem.aspx?id=208871",""],[5739,"روس ٍ تمسس في عمايمها ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131547",""],[5823,"بكائية","https://www.poetsgate.com/ViewPoem.aspx?id=59148",""],[5870,"مشوارٌ صَغير","https://www.poetsgate.com/ViewPoem.aspx?id=60862",""],[5870,"بِطَاقَةُ تَقدير","https://www.poetsgate.com/ViewPoem.aspx?id=60863",""],[5952,"وهذي مصر يا عبله","https://www.poetsgate.com/ViewPoem.aspx?id=197107",""],[5957,"الزمن الخرافي","https://www.poetsgate.com/ViewPoem.aspx?id=207667",""],[5975,"في ولاء آل بيت الرسول3","https://www.poetsgate.com/ViewPoem.aspx?id=53468",""],[6056,"كبش الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=156713",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[313,"الحرمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69193&r=&rc=41",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[5080,"أُصرِّف آياتي على سورة النبضِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88131&r=&rc=1",""],[6327,"مَرْثيّةُ الغَريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86570&r=&rc=5",""]],"verses":[["على درب من والى النبي وآله","وميثاق من يُعزى لهم في التبتل",0,"ل",1,0],["عَلى دِيارِ مَعشَرٍ","خانوا العُهودَ وَالذِمَم",1,"م",1,0],["عَلَيَّ دِماءُ البُدنِ إِن لَم أُثِر بِها","رَعيلاً يَشُقُّ الأَرضَ بَعدَ رَعيلِ",2,"ل",1,0],["عَلى دِيارٍ منَ الإِسلامِ خالِيَةٍ","قَد أَقفَرَت وَلَها بالكُفرِ عُمرانُ",3,"ن",1,0],["عَلَيَّ دِماءُ البُدنِ إِن كانَ حُبُّها","عَلى النَأيِ أَو طولَ الزَمانِ يَريمُ",4,"م",1,0],["على دولة الأملاك كلّ فصوله","ربيع وفي الأعدا سعودٌ ذوابح",5,"ح",1,0],["عليَّ ديون من ثناً لم أقم بها","فيا عجباً لي في ازديادٍ من الفضل",6,"ل",1,1],["عَلى دينِ الصَليبِ يَكونُ مَوتي","وَلا البَطحا أُريدُ وَلا المَدينَه",7,"ه",1,0],["على دنان كأنها جثث","من قوم عاد عظيمة الخلق",8,"ق",1,0],["عليَّ دينٌ ثقيلٌ أنتَ قاضيهِ","يا مَنْ يُحَمِّلني دَيْني رَجائيهِ",9,"ي",2,1],["عَلى دِمنَةٍ فيها لِأُدمانَةِ النَقا","مَحاسِنُ أَيّامٍ تُحَبُّ وَتُعشَقُ",10,"ق",1,0],["عَلى دارِسِ الآياتِ عافٍ تَعاقَبَت","عَلَيهِ صَباً ما تَستَفيقُ وَشَمأَلُ",11,"ل",1,0],["عَلى دينِهِم وَالهِندُ تُزجى فُيولُهُم","وَبِالرومِ في أَفدانِها رومِ قَيصَرا",12,"ر",2,0],["عَلى دِمنَتَي دارٍ لِلَيلى كَأَنَّها","إِزارانِ مِن بُردٍ لَها خَلَقانِ",13,"ن",1,0],["عَلَيَّ دِماءُ البُدنِ إِن كانَ حُبُّها","عَلى النَأيِ في طولِ الزَمانِ يَريمُ",14,"م",1,0],["عَلى دَوحَةٍ يَستَنُّ تَحتَ أُصولِها","نَواقِعُ ماءٍ مَدَّهُ رَصَفُ الصَخرِ",15,"ر",1,0],["على دمنةِ الدار لا تربع","ومن حذَرِ البينِ لا تجزع",16,"ع",1,1],["على دنيا بعيد ان تراها","وان حصلت فما تسوى قلامه",17,"م",2,0],["عَلى دينِنا ساقوا كتائبَ كتبهم","وَفي حَربهِ جاءَت جرائدُهم تترى",18,"ر",2,0],["عَلى دَمعِ عَيني مِن فِراقِكَ ناظِرٌ","يُرَقرِقُهُ إِن لَم تُرِقهُ المَحاجِرُ",19,"ر",1,1],["عليَّ دْماءُ الُبدن إن كانَ زوجُها","يرى لَي ذَنباً غيرَ أنّي أزورُها",20,"ر",3,0],["عليّ ديونٌ وتَصحيفُها","وعندكُم الجود والمَغفِره",21,"ر",2,0],["عَلى دَولةٍ أَسمى وأَعظم بهجةً","مِنَ الدولةِ الوسطى وَصادقها الأسطى",22,"ط",2,0],["على دارك يا جاري","صباح الخير من داري",23,"ي",1,1],["على دَخَنٍ بغياً فضَلَّت عقولها","إلامَ المعالي يملك الرذل رقّها",24,"ه",2,0],["عليّ دينٌ ومالي","شيءُ سوى آمالي",25,"ل",2,0],["على دقّت عن الأفهام حتى آس","توى منها المبلّد والذكيّ",26,"ي",1,0],["على دين الأكارم وهو خِرْق","يعدُّ الحمدَ أولى ما استدامَهْ",27,"م",2,0],["على دارٍ حَللتَ بِها سَلامي","وَجادَتها مغلَّسةُ الغمامِ",28,"م",1,1],["عليَّ ديونُ شكرٍ ليسَ تُقضى","لو قُسمَت على دهرٍ طويلِ",29,"ل",1,0],["عليَّ ديونٌ رُتِّبَتْ لجَلالِهِ","فأصبحتُ مديوناً أخافُ مِن الكَسْرِ",30,"ر",1,0],["على درجات فاعلمن ذكرتها","ثلاث فأولاها بها الآن أبتديد",31,"د",1,0],["على دارس الأطلال بالمتحلب","نسيج الصبا تبكي بدمع كصيب",32,"ب",1,1],["على دحيتي من بعد أزكى تحية","فلا تجهلن قدراً أتاك مقدرا",33,"ر",2,0],["عليُّ دنا الفراق فكن","تَ إِذ فارقْتَني خلفي",34,"ف",2,0],["عَلى دَائِمِ الأَوْقَاتِ بِالشُّكْرِ وَالْحَمْدِ","تَرَقى إلَى أَعْلىَ الْمَقَامَاتِ وَانْتَهى",35,"ه",2,0],["عليَّ دينٌ ولديَّ ذمة","فوراً ومثلي من يؤدّي الذمامْ",36,"م",1,0],["على دار سلمى بالعقيقِ سلامي","سقاها ملث مثل دمعي هامي",37,"م",2,1],["عَلَى دِيبَاجِ خَدَّيْ وَجْهِ بِشْرٍ","إِذَا الألْوَانُ خَلَفَتِ الْخُدُودَا",38,"د",2,0],["عَلَيَّ دِماءُ البُدنِ إِن لَم تُفارِقي","أَبا حَردَبٍ يَوماً وَأَصحابَ حَردَبِ",39,"ب",1,0],["عَلى دَموكٍ أَمرُها لِلأَعجَلِ","تَئِطُّ أَحياناً إِذا لَم تَصهَلِ",40,"ل",1,0],["على درجات المصطفين أدلة","وفي ملكوت اللّه للقوم شهرة",41,"ه",1,0],["على دِيْنِ أَيْسوعٍ","فَما أَفْتى وما أَسْرا",42,"ر",2,0],["عَلى دَرجاتِ العِلمِ والحلمِ والتُّقى","فسادَ وفضلُ اللَهِ مَن شاءَ يُؤتِيهِ",43,"ي",2,0],["عَلى داعٍ مِنَ الوَجدِ","فَهَل هَذا مِنَ الرُشدِ",44,"د",1,0],["على دوران أوكار التحايا","تواصل بالغدايا والثنايا",45,"ا",3,1],["على دست الخبيص أخيّه فيها","بحق العيد يا ناس اطرحوني",46,"ن",2,0],["عَلى دينِ سَعدٍ في مَحَبَّةِ أَوطاني","أَموتُ وَيَحيا سَعدُ لِلعلمِ العاني",47,"ن",2,1],["عليّ دين هاهنا وافر","أحرم عيني لذة المرقد",48,"د",1,0],["على دَنجَ دَنجَ حَديثٌ واكد","في الجاهِ بل في مَطلَعِ الفراقِد",49,"د",1,0],["على درج الفردوس في غرف العلا","مع المصطفى صلى الاله على النجي",50,"ج",2,0],["على دافق يلهو وروض أزاهر","بذات المثاني والمثالث والنّقب",51,"ب",1,0],["على دوحها العالي وفوق مروجها","ترف أياديك الكرام حوانيا",52,"ي",2,0],["على دعاء المثاني","وضجة الندمان",53,"ن",1,0],["على دينه فليبك من لم يكن بكى","لرزء الحسين السيد الفارس الكمي",54,"م",2,0],["عَلى دَكِّ إِليونَ إِن تَلِنا","فَعَهدَكَ نوثِقُهُ عَلَنا",55,"ن",2,0],["عَلى دَنِيِّ رُكبَتَيَّ صُغرا