{"poems":[[128,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[186,"قد سار ميخائيل حوا راحلا","https://www.aldiwan.net/poem61135.html","الكامل"],[242,"ما شأن دنيانا سوى الإنذار","https://www.aldiwan.net/poem19781.html","الكامل"],[369,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[469,"قالوا كسا الزقزوق واعظه","https://www.aldiwan.net/poem3238.html","عموديه"],[543,"ما كانت أبزو بلدة مذكورة","https://www.aldiwan.net/poem47540.html","عموديه"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39027","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138131",""],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202089",""],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130625","الكامل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44808","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100445","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53163","الرجز"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82177","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100331","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130383","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138592",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110048","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138862",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""]],"verses":[["حتى ثوى فيه الفؤاد وراعني","بالسلط نعي قد أقض مضاجعي",0,"ع",2,0],["حَتّى ثَوى أَرِّخ بِجَنَّةِ رَبِّهِ","وَهُناكَ ظلَّلهُ جَناحُ سميِّهِ",1,"ي",2,0],["حَتَّى ثَنَتْهُمْ عَنء مَنَاهِجِ قُرْبِهِمْ","مَا ذَاكَ وَصْفُ السَّائِرِينَ لِرَبِّهِمْ",2,"م",1,0],["حتّى ثنَى عنه لِيَنْزلَ عِطْفَهُ","في مَوْقفٍ فيه الجِباهُ تُعفَّر",3,"ر",1,0],["حتى ثنيت بحيث طوَّلَ باعُه","حبلَ الرجاء ووسَّع الآمالا",4,"ل",2,0],["حتى ثنى الزرزور بعد وثير الر","ريش في قشر من السمك",5,"ك",1,0],["حتى ثَوَيتَ بها ففَاوحَ ذِكرُها","طِيبا أَريجَ المِسكِ وهو فَتِيق",6,"ق",1,0],["حَتَّى ثَنَتْها الرَّاحُ طوعَ سَواعِدي","والرَّاحُ تَعْلَمُ كَيفَ أخْذُ الثَّارِ",7,"ر",1,0],["حتى ثويتَ بها فريدا أوحدا","آها عليك وهل تُفيدك آها",8,"ا",3,0],["حتى ثوى في قُدُس","مَثْوَى المُهَانِ المُحْرَج",9,"ج",1,0],["حتى ثوت تحت العجاج كأنها الا","قمار تحجب بالسحاب المظلم",10,"م",1,0],["حَتَّى ثَنيتُ مَعَاطِفِي طَرَباً بِهَا","وَجَرَرتُ أَذيَالِي مِنَ الخُيَلاءِ",11,"ا",2,0],["حتى ثنى عزماً وراح معانقاً","حوراً سررن بوصله أترابا",12,"ب",2,0],["حتى ثنى زرق العدا","مصفرة الأنامل",13,"ل",1,0],["حتى ثنى من بين منجدل","أو هارب لم ينجه الركض",14,"ض",1,0],["حتى ثووا صرعى ترضُّ لهم قرىً","بسنابك الجرد العتاق واضلعُ",15,"ع",1,0],["حتى ثويت رهين النفس في حرم","استودع الله ربي عين الأخوان",16,"ن",1,0],["حتى ثوى بين اطراف الرماح وقد","اراعت الموت منه هيبة العظم",17,"م",1,0],["حتى ثوى في سُمّ لحدٍ ضيِّقٍ","من بعد ما ارداهُ سَمٌّ قاتلُ",18,"ل",1,0],["حتى ثوى معتنقاً حساما","منصلتاً مغتبقاً مداما",19,"م",2,0],["حتى ثووا بالعرا صرعى تكفنهم","أيدي السوافي بأثواب من الترب",20,"ب",1,0],["حتى ثَمِلتُ ولاحَ السِّكرُ فيَّ فنا","جاني السرورُ وغنّاني مُغنّيه",21,"ي",2,0]]}