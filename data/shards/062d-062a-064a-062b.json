{"poems":[[125,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[183,"قد سار ميخائيل حوا راحلا","https://www.aldiwan.net/poem61135.html","الكامل"],[238,"ما شأن دنيانا سوى الإنذار","https://www.aldiwan.net/poem19781.html","الكامل"],[365,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[459,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[465,"قالوا كسا الزقزوق واعظه","https://www.aldiwan.net/poem3238.html","عموديه"],[539,"ما كانت أبزو بلدة مذكورة","https://www.aldiwan.net/poem47540.html","عموديه"]],"verses":[["حتى ثوى فيه الفؤاد وراعني","بالسلط نعي قد أقض مضاجعي",0,"ع",2,0],["حَتّى ثَوى أَرِّخ بِجَنَّةِ رَبِّهِ","وَهُناكَ ظلَّلهُ جَناحُ سميِّهِ",1,"ي",2,0],["حَتَّى ثَنَتْهُمْ عَنء مَنَاهِجِ قُرْبِهِمْ","مَا ذَاكَ وَصْفُ السَّائِرِينَ لِرَبِّهِمْ",2,"م",1,0],["حتّى ثنَى عنه لِيَنْزلَ عِطْفَهُ","في مَوْقفٍ فيه الجِباهُ تُعفَّر",3,"ر",1,0],["حتى ثنيت بحيث طوَّلَ باعُه","حبلَ الرجاء ووسَّع الآمالا",4,"ل",2,0],["حتى ثنى الزرزور بعد وثير الر","ريش في قشر من السمك",5,"ك",1,0],["حتى ثَوَيتَ بها ففَاوحَ ذِكرُها","طِيبا أَريجَ المِسكِ وهو فَتِيق",6,"ق",1,0]]}