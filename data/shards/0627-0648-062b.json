{"poems":[[53,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[88,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[51,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[49,"أنساك محياك المماتا","https://www.aldiwan.net/poem10844.html","مجزوء الكامل"],[81,"عبثت بقلب عميده لحظاته","https://www.aldiwan.net/poem61369.html","عموديه"],[81,"ياحسنه والحسن بعض صفاته","https://www.aldiwan.net/poem61384.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[45,"كَيْفَ بِهِ، وَالزّمانُ يَهْرُبُ بِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31551",""],[120,"كيف به والجفاء يبعد به","https://www.aldiwan.net/poem49347.html","المنسرح"],[128,"يا سائلي عن حصن قريتنا لم","https://www.aldiwan.net/poem50674.html","الطويل"],[135,"الصبر ليس على فراقك يحسن","https://www.aldiwan.net/poem49163.html","الكامل"],[282,"جئت أسعى إلى عروبة حتى","https://www.aldiwan.net/poem32296.html","الخفيف"],[285,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[320,"دع لتيه الدلال واسمح برشفه","https://www.aldiwan.net/poem61700.html","البسيط"],[342,"أؤثر الموت إثرة لا تجارى","https://www.aldiwan.net/poem55377.html","الخفيف"],[366,"أوثق ما كان بأيامه","https://www.aldiwan.net/poem17359.html","السريع"],[443,"يا حزينا يقضي الحياة كئيبا","https://www.aldiwan.net/poem55976.html","عموديه"],[458,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[464,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[567,"جد لي ببركارك الذي صنعت","https://www.aldiwan.net/poem69811.html","المنسرح"]],"verses":[["أَو ثَغرِ مَحزونٍ تَبَسَّمَ سَلوَةً","وَالعَينُ لَمّا يَرقَ بَعدُ سُجومُها",0,"م",3,0],["أوثقوكم بها إِساراً وقالوا","ليس هذا لكم سوى إحسان",1,"ن",1,0],["أوثِقِ العقدةَ إن أنكحتَني","ما تراني كُفْأَه أو لا فَدَع",2,"ع",1,0],["أَوثَقُ مَن تُصطَفى عُراهُ فَإِن","حَلَّ بَعيداً شَرواكَ في حَسَبِه",3,"ب",2,0],["أَوَثِقتَ بِالدُنيا وَأَن","تَ تَرى جَماعَتَها شَتاتا",4,"ت",2,0],["أوثَقتُهُ فِي سَاعِدَيَّ كَأنَّهُ","ظَبيٌ خَشِيتُ عَلَيهِ مِن نَفَرَاتِهِ",5,"ت",2,0],["أَوثَقتُهُ في ساعِدَيَّ لِأَنَّهُ","ظَبيٌ خَشيتُ عَلَيهِ مِن نَفَراتِهِ",6,"ت",2,0],["أوثقته من الذنوب دُيُونٌ","شَدَّدَتْ فِي اقْتِضائِها الغُرَماءُ",7,"ا",2,0],["أَو ثورة كان فيها","للقاهرين اقتلاع",8,"ع",1,0],["أو ثالثَ الحسَنَيْنِ في ال","قُربَى وطيب المحتِد",9,"د",1,0],["أوْثَقُ مَنْ تَصْطَفي عُرَاهُ، فإنْ","حَلّ بَعيداً، شروااكَ في حَسَبِهْ",10,"ب",2,0],["أوثق من تصطفي وأكرم من","تأخذ من عقله ومن أدبه",11,"ب",2,0],["أو ثغرُ غانَيةٍ يروقُ تبسُّماً","سمطين فيه اللؤلؤ المثقوبُ",12,"ب",1,0],["أو ثمَّ قلب لم يمزقه الأسى","أو هل هنالك قوة لا توهنُ",13,"ن",1,0],["أَوثَقوا بِالأَقفالِ مُصحَفَ عُثما","نَ فَخَوفي عَلَيهِ غَير خَفِيِّ",14,"ي",1,0],["أو ثعلب لما بدا","أسد عوى خوفاً وهر",15,"ر",1,0],["أَو ثَقيلٍ يَبغي التَحَشُّرَ فينا","فَتَعالَ نَقضي المَرامَ بِعَطفَه",16,"ف",2,0],["أؤثر الموت إثرة لا تجارى","وارى في الحياة داءً وبيلا",17,"ل",2,1],["أَوثَقَ ما كانَ بَأيّامِهِ","خانَتهُ وَالأَيّامُ خَوّانَه",18,"ن",2,1],["أو ثناء على امرئ بت من ذ","لك شهرا مسهدا مكروبا",19,"ب",2,0],["أوثُق منه عُروَتَيْ مودّةٍ","ما بَرزَ النفاقُ فيهم أو كَمَنْ",20,"ن",1,0],["أوثقوا جامحَ الزمان بلا قيدٍ","وقادوا الدنيا بغيرِ زمامِ",21,"م",1,0],["أوثق مِسمارُهُ وغيِّب عن","نواظر النّاقدينَ تغييبا",22,"ب",2,0]]}