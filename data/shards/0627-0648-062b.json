{"poems":[[53,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[88,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[51,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[49,"أنساك محياك المماتا","https://www.aldiwan.net/poem10844.html","مجزوء الكامل"],[81,"عبثت بقلب عميده لحظاته","https://www.aldiwan.net/poem61369.html","عموديه"],[81,"ياحسنه والحسن بعض صفاته","https://www.aldiwan.net/poem61384.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[45,"كَيْفَ بِهِ، وَالزّمانُ يَهْرُبُ بِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31551",""]],"verses":[["أَو ثَغرِ مَحزونٍ تَبَسَّمَ سَلوَةً","وَالعَينُ لَمّا يَرقَ بَعدُ سُجومُها",0,"م",3,0],["أوثقوكم بها إِساراً وقالوا","ليس هذا لكم سوى إحسان",1,"ن",1,0],["أوثِقِ العقدةَ إن أنكحتَني","ما تراني كُفْأَه أو لا فَدَع",2,"ع",1,0],["أَوثَقُ مَن تُصطَفى عُراهُ فَإِن","حَلَّ بَعيداً شَرواكَ في حَسَبِه",3,"ب",2,0],["أَوَثِقتَ بِالدُنيا وَأَن","تَ تَرى جَماعَتَها شَتاتا",4,"ت",2,0],["أوثَقتُهُ فِي سَاعِدَيَّ كَأنَّهُ","ظَبيٌ خَشِيتُ عَلَيهِ مِن نَفَرَاتِهِ",5,"ت",2,0],["أَوثَقتُهُ في ساعِدَيَّ لِأَنَّهُ","ظَبيٌ خَشيتُ عَلَيهِ مِن نَفَراتِهِ",6,"ت",2,0],["أوثقته من الذنوب دُيُونٌ","شَدَّدَتْ فِي اقْتِضائِها الغُرَماءُ",7,"ا",2,0],["أَو ثورة كان فيها","للقاهرين اقتلاع",8,"ع",1,0],["أو ثالثَ الحسَنَيْنِ في ال","قُربَى وطيب المحتِد",9,"د",1,0],["أوْثَقُ مَنْ تَصْطَفي عُرَاهُ، فإنْ","حَلّ بَعيداً، شروااكَ في حَسَبِهْ",10,"ب",2,0]]}