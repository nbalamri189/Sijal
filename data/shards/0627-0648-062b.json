{"poems":[[55,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[90,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[53,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[47,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[51,"أنساك محياك المماتا","https://www.aldiwan.net/poem10844.html","مجزوء الكامل"],[83,"عبثت بقلب عميده لحظاته","https://www.aldiwan.net/poem61369.html","عموديه"],[83,"ياحسنه والحسن بعض صفاته","https://www.aldiwan.net/poem61384.html","البسيط"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[108,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[47,"كَيْفَ بِهِ، وَالزّمانُ يَهْرُبُ بِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31551",""],[124,"كيف به والجفاء يبعد به","https://www.aldiwan.net/poem49347.html","المنسرح"],[132,"يا سائلي عن حصن قريتنا لم","https://www.aldiwan.net/poem50674.html","الطويل"],[139,"الصبر ليس على فراقك يحسن","https://www.aldiwan.net/poem49163.html","الكامل"],[287,"جئت أسعى إلى عروبة حتى","https://www.aldiwan.net/poem32296.html","الخفيف"],[290,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[325,"دع لتيه الدلال واسمح برشفه","https://www.aldiwan.net/poem61700.html","البسيط"],[347,"أؤثر الموت إثرة لا تجارى","https://www.aldiwan.net/poem55377.html","الخفيف"],[371,"أوثق ما كان بأيامه","https://www.aldiwan.net/poem17359.html","السريع"],[449,"يا حزينا يقضي الحياة كئيبا","https://www.aldiwan.net/poem55976.html","عموديه"],[463,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[572,"جد لي ببركارك الذي صنعت","https://www.aldiwan.net/poem69811.html","المنسرح"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138354",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66743","الرمل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136100","الخفيف"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44815","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79841","الرمل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53133","الخفيف"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106976","الرجز"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113863","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201339","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103522","المديد"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126079","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71332","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88890","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110114","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131221",""],[3920,"","https://poetry.dctabudhabi.ae/diwan/poem/130243","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44891","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125830","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119634","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73090","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4709,"صوت الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=214852",""],[4755,"عُقبَى الحائِرِين","https://www.poetsgate.com/ViewPoem.aspx?id=183683",""],[4578,"عيدٌ أعيد على الأنام مجدُ","https://www.poetsgate.com/ViewPoem.aspx?id=49393",""],[4962,"ماذا أقول؟!!!","https://www.poetsgate.com/ViewPoem.aspx?id=208749",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[585,"لا تلوموا مولعاً مضطربا","https://www.poetsgate.com/ViewPoem.aspx?id=161861",""],[5490,"يادار غزة","https://www.poetsgate.com/ViewPoem.aspx?id=176357",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""],[402,"لم تغن منك شمائل وفضائل","https://www.poetsgate.com/ViewPoem.aspx?id=36019",""],[572,"جُدْلِي ببر كارِكَ الذي صَنَعَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9167&r=&rc=24",""]],"verses":[["أَو ثَغرِ مَحزونٍ تَبَسَّمَ سَلوَةً","وَالعَينُ لَمّا يَرقَ بَعدُ سُجومُها",0,"م",3,0],["أوثقوكم بها إِساراً وقالوا","ليس هذا لكم سوى إحسان",1,"ن",1,0],["أوثِقِ العقدةَ إن أنكحتَني","ما تراني كُفْأَه أو لا فَدَع",2,"ع",1,0],["أَوثَقُ مَن تُصطَفى عُراهُ فَإِن","حَلَّ بَعيداً شَرواكَ في حَسَبِه",3,"ب",2,0],["أَوَثِقتَ بِالدُنيا وَأَن","تَ تَرى جَماعَتَها شَتاتا",4,"ت",2,0],["أوثَقتُهُ فِي سَاعِدَيَّ كَأنَّهُ","ظَبيٌ خَشِيتُ عَلَيهِ مِن نَفَرَاتِهِ",5,"ت",2,0],["أَوثَقتُهُ في ساعِدَيَّ لِأَنَّهُ","ظَبيٌ خَشيتُ عَلَيهِ مِن نَفَراتِهِ",6,"ت",2,0],["أوثقته من الذنوب دُيُونٌ","شَدَّدَتْ فِي اقْتِضائِها الغُرَماءُ",7,"ا",2,0],["أَو ثورة كان فيها","للقاهرين اقتلاع",8,"ع",1,0],["أو ثالثَ الحسَنَيْنِ في ال","قُربَى وطيب المحتِد",9,"د",1,0],["أوْثَقُ مَنْ تَصْطَفي عُرَاهُ، فإنْ","حَلّ بَعيداً، شروااكَ في حَسَبِهْ",10,"ب",2,0],["أوثق من تصطفي وأكرم من","تأخذ من عقله ومن أدبه",11,"ب",2,0],["أو ثغرُ غانَيةٍ يروقُ تبسُّماً","سمطين فيه اللؤلؤ المثقوبُ",12,"ب",1,0],["أو ثمَّ قلب لم يمزقه الأسى","أو هل هنالك قوة لا توهنُ",13,"ن",1,0],["أَوثَقوا بِالأَقفالِ مُصحَفَ عُثما","نَ فَخَوفي عَلَيهِ غَير خَفِيِّ",14,"ي",1,0],["أو ثعلب لما بدا","أسد عوى خوفاً وهر",15,"ر",1,0],["أَو ثَقيلٍ يَبغي التَحَشُّرَ فينا","فَتَعالَ نَقضي المَرامَ بِعَطفَه",16,"ف",2,0],["أؤثر الموت إثرة لا تجارى","وارى في الحياة داءً وبيلا",17,"ل",2,1],["أَوثَقَ ما كانَ بَأيّامِهِ","خانَتهُ وَالأَيّامُ خَوّانَه",18,"ن",2,1],["أو ثناء على امرئ بت من ذ","لك شهرا مسهدا مكروبا",19,"ب",2,0],["أوثُق منه عُروَتَيْ مودّةٍ","ما بَرزَ النفاقُ فيهم أو كَمَنْ",20,"ن",1,0],["أوثقوا جامحَ الزمان بلا قيدٍ","وقادوا الدنيا بغيرِ زمامِ",21,"م",1,0],["أوثق مِسمارُهُ وغيِّب عن","نواظر النّاقدينَ تغييبا",22,"ب",2,0],["او ثار ثائره لامر منكر","أيقنت حقا انه الرئبال",23,"ل",1,0],["أوثقَ الناسِ معاً في نفسِه","عند مكروهٍ إذا الخطبُ وَقَعْ",24,"ع",1,0],["أَوْ ثامِنٍ رِدْنَا عَلَى الوِئَامِ","غُولاً وَأُمَّ الجَذَاعِ الزُنَامِ",25,"م",1,0],["أو ثنيت العنان نحو المعالي","لشهود الحبيب دون الرقيب",26,"ب",1,0],["أَوثَقتُهُ فِي سَاعِدَيَّ لأنَّهُ","ظَبيٌ خَشِيتُ عَلَيهِ مِن فَلَتَاتِهِ",27,"ت",2,0],["أو ثناياه لعيني وصفت","ثغرَها استشفيت فيهنَّ التثاما",28,"م",2,0],["أو ثقال الأرداف أولا ثغور","خالطتها في ظلمها الصهباء",29,"ا",2,0],["أو ثوى فيها ابن برد ليلة","عاد من بعد العمى في المبصرين",30,"ن",1,0],["أوثقتهم والله خزر من الأي","ام لا يفتدى لهن أسير",31,"ر",1,0],["أوثقَها الجهلُ فعادت لُعبةً","ككرةِ الصولَجِ صوبَ مَن دَسا",32,"ا",1,0],["أو ثمر التفاح بين","طاقتي بنفسج",33,"ج",1,0],["أو ثبتم يا لقومي قتلتي","في الهوى شرعا لدى قاضي القضاة",34,"ه",1,0],["أوثقوني بعالم الترب حيّا","وأحالوا الى الممات فكاكي",35,"ك",2,0],["أوثقت للبطش آلته","فكفته السعي في مهنه",36,"ن",2,0],["او ثغر زنجية تفتر ضاحكة","تبدو مشافرها طورا وتنطبق",37,"ق",1,0],["أَوْثَقَتْنَا بِالنَّرْجِسِ الغَضِّ مِنْهَا","أَعْيُنٌ لاَ كَأَعْيُنِ الأَحْبَابِ",38,"ب",1,0],["أو ثقت قلبي بلوعات الغرام وفي","حسن التخلص أرجو سيد الأمم",39,"م",1,0],["أَوثَقَتني مآثمي بقيودٍ","أَشتكيها وهل تُفيدُ الشكايا",40,"ا",3,0],["أو ثعلبٌ قد ألبسوه لبدةً","جعلته يحسب نفسه أسد الشرى",41,"ر",2,0],["أوْثِقُوا غُلِّى هُدِيتُهْم","وأجعلُوا لِلغُلِّ قُفْلاَ",42,"ل",2,0],["أو ثَورةٍ مَجنونةٍ","مِن فاسقٍ مُدرَّبِ",43,"ب",1,0],["أَوْثَقْتُمُ الأُممَ الضعيفةَ باسمها","ولبغيكم بسلاحها إِطلاق",44,"ق",1,0],["أوثقتني وقيدتني بضعف ال","قلب لا يستطاع معه نظام",45,"م",1,0],["أَو ثَوت في الغُمودِ أَسيافُهُ البِي","ضُ فَكَم قَد غَزَت بِهنَّ صِيَالا",46,"ل",2,0],["أوثقوا أيديه في ربط الحبال","خسئت أنفسُكم ليس الكمالْ",47,"ل",1,0],["أوثقُ كلَّ منقبةٍ وأروي","حكاياتٍ لتاريخي التليدِ",48,"د",1,0],["أَو ثائِرٌ بالوَهْمِ يَقسِمُ شَعبَهُ","باسْمِ الوِفَاقِ, و\"سَعْيُهُ مَشْكُورُ\"",49,"ر",1,0],["أو ثغرُ بيروت وجيدُ فخارها","تاريخهُ أبدا به يتنضَّدُ",50,"د",1,0],["أو ثم طرفاً مُنصتاً يرنو إلى","بوح السطور وما عليه يرمَّزُ",51,"ز",1,0],["أو ثائر جرحت نار الرصاص لدى","ميدان (رابعة) في فضّ معتصم",52,"م",1,0],["أوثر الموت على العيش إذا","لم يكن عيشي لذيذاً طيبا",53,"ب",2,0],["أوثِقْ قِماطَ الذي في المهد واهدِ لهُ","وعداً توَلاهُ بالتعقيب والطلبِ",54,"ب",1,0],["أَوْثَقُوهُ وَعَصَّبُوا عَيْنَيْهِ","عَذَّبُوهُ وَلَيْتَهُمْ كَالْيَهُودِ",55,"د",1,0],["أوثت أسرتك الوفية حسرة","راعت بقسوتها وأنت رفيق",56,"ق",1,0],["اوثِقَ مِسْمَارٌ وغُيَّبَ عَنْ","نوَاظِرِالنّاقِدينَ تَغْيِيبا",57,"ب",2,0]]}