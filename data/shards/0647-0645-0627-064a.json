{"poems":[[53,"إن اللسان الذي نسجت به","https://www.aldiwan.net/poem9258.html","المنسرح"],[53,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[30,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[107,"لواء الله بورك من لواء","https://www.aldiwan.net/poem42133.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[216,"ونشوانة غيداء ظامية الحشا","https://www.aldiwan.net/poem37898.html","الطويل"],[484,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[563,"من أين للسعد ما ندري وللرازي","https://www.aldiwan.net/poem34456.html","البسيط"],[568,"أتيجرت هذا النيل بالله خبري","https://www.aldiwan.net/poem13600.html","الطويل"],[1442,"","https://poetry.dctabudhabi.ae/diwan/poem/31554","المتقارب"],[1494,"","https://poetry.dctabudhabi.ae/diwan/poem/97798","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79844","الكامل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68020","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74064","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45802","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90996","الكامل"],[5674,"الأماني التائهات","https://www.poetsgate.com/ViewPoem.aspx?id=185308",""],[6084,"سافر فسوف ترى اللذات في السفر","https://www.poetsgate.com/ViewPoem.aspx?id=170838",""]],"verses":[["همَّاي همَّانِ لستُ مُتَّبِعاً","أولاهما بالخَنا إذا اعْتَلجا",0,"ج",2,0],["هم أير ثَمَّ نومٌ طويلٌ","وهموم است هناك القراع",1,"ع",1,0],["هُمُ أَيَّهوا بي إِذ عَطِيَّةُ قائِمٌ","لِيَنهَقَ خَلفَ الجامِحاتِ الصَلادِمِ",2,"م",1,0],["هُمُ ائْتَمروا بهِ فَتداركوهُ","وَرُدُّوا عنه عاديَة القَضاءِ",3,"ا",2,0],["هم أَيدوا الحكام في تدميرها","فكأَنهم لَو يخجلون أَعادي",4,"د",2,0],["هما يُسعداني إن سَطَتْ بي حَبَوْكَرٌ","إذا لم يجد في العالمينَ مُساعدا",5,"د",2,0],["هم أيدوه كما يروي مؤرخهم","وعرّفوه كما قالوا إلى الدول",6,"ل",1,0],["هما يقولان عن إدراك عقلهما","في الله تقييس بنيان بهنداز",7,"ز",1,0],["هُما يَقذِفانِ النوقَ قَبلَ سُؤالِهِ","وَالأَبحُرُ بَعدَ الغَوصِ إِعطاؤُها السَمكا",8,"ك",2,0],["هُما يَومَ حُمَّ لَهُ يَومُهُ","وَقالَ أَخو فَهمِ بُطلاً وَفالا",9,"ل",2,0],["هُما يلبسانِ المجدَ أحسن لبسةٍ","شَحيحان ما اِسطاعا عليهِ كلاهما",10,"م",2,0],["هم أيكة الشرف التي منها الورى","ثمرُ السماحة ما اجتنوه مرجّبا",11,"ب",2,0],["هما يعدان من المنازل","ومن نجوم الليث فوق الكاهل",12,"ل",1,0],["همُ أيقظوا فكرتي بالوصلِ فانتبهتْ","حَتَّى دَنَتْ بالوفا قالوا لَهَا انصرِفي",13,"ف",2,0],["هُم أَيقظونا بَعدَ ما","سَئمَ الرقاد من الرقاد",14,"د",1,0],["هُم أَيقَظوا عَين الرَدى وَتَناوموا","فَأَيقَظَهُم رَكض الخُيول الصَواهل",15,"ل",1,0],["هم أينما كانوا فها أنا لم أزل","في ظلهم بنعيم عيش ناعم",16,"م",1,0],["هم أيقظوا الوجعَ المقدّسَ في دمي","فجميعُ أوردتي جراحٌ النائباتْ",17,"ت",1,0],["هم آية الله هم ميزان قدرته","لولاهم لم يكن في الكون من بشر",18,"ر",1,0]]}