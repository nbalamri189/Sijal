{"poems":[[58,"واصل مدامك واهجر قالة الناس","https://www.aldiwan.net/poem58572.html","البسيط"],[53,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[469,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[580,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16896","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69353","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65986","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139919","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85279","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35052","الوافر"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4755,"إلى الحُبِّ مِمَّا مَضَى أَبرَأُ","https://www.poetsgate.com/ViewPoem.aspx?id=202247",""]],"verses":[["إلى ثِمَارِ سُرُورٍ في ثَرَى قَدَحٍ","في فِتْيَةٍ غُررٍ ليسوا بأَنكاسِ",0,"س",1,0],["إلى ثُغورٍ عذبة ِ المَناهل","كأُقحوانِ الديم الهواطل",1,"ل",1,0],["أَليثوا بِأَبناءِ المَلاوِثِ رَأيَكُم","فَلَن تَعدموا أَبناءَ شُمٍّ مَلاوِثِ",2,"ث",1,0],["إلى ثامن السبع العلى ثالث الهدى","ومنهجه ثاني الحيا واحد المجد",3,"د",1,0],["إِلى ثَمَّ أَبْعِد يا سروري صبابةً","إِليهم ويا هَمِّي عليهمْ إِلى هُنَا",4,"ن",2,0],["إِلى ثَردَةٍ رَقطاءَ قُطِّعَ فَوقَها","مُقَفَّعَةٌ خَضراءَ في وَرَقٍ خُضرِ",5,"ر",1,0],["إِلى ثِمالٍ فَتى الدُنيا الَّذي يَدُهُ","مِثلُ السَحابِ إِذا اِنهلّت عَزالِيها",6,"ي",3,0],["إلى ثمانين ويأتي المَغرِبُ","دونَ قياساتهمُ مُجَرَّبُ",7,"ب",1,0],["أليثوا بتعميم الرؤوس العمائما","وشدوا جميعاً بالأكف الصوارما",8,"م",2,1],["إلى ثلاث إماء فاثنتان من الس","ودان من وسط العالي من الصُورِ",9,"ر",1,0],["إِلَى ثَلاثَةٍ رَأى وَعَلِمَا","عَدَّوا إِذا صَارَا أرَى وَاعلمَا",10,"م",2,0],["إلى ثلاثمائة سنينا","يخادعون اللَه والذينا",11,"ن",2,0],["إِلى ثِيبَةٍ وَحدَهُ أُرسِلا","سَفِيراَ فَرَاحَ وَما هُوِّلاَ",12,"ل",2,0],["إلى ثغرٍ ترصَّعَ بِاِبتسامٍ","إِلى لَثغات شدوكِ إِن تُجيدي",13,"د",2,0],["إلى ثرى حل في أكناف تربته","محمد فسقاه الري هامره",14,"ر",2,0],["إلى ثالثِ اثنَينِ لاحَا لهُ","كما لاحَ لِلخائفِ المَخبَأُ",15,"ا",1,0]]}