{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103457","المديد"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117984","الخفيف"],[4691,"أمطرها وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=105403",""],[4755,"وكَقَاربٍ تَركُوهُ بعد رُكوبهِ","https://www.poetsgate.com/ViewPoem.aspx?id=183718",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[6320,"أَعْشَابُ المَزَابِل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84363&r=&rc=60",""]],"verses":[["وكَقَطْرَةِ العِطْرِ الّتي كَمْ جَمَّعَتْ","من نَوْرِ أَغْوَارٍ وَزَهْرِ نُجُودِ",0,"د",1,0],["وكقوله في تاج كسرى أنه","لا بد يوضع فوق راس خليفة",1,"ه",1,0],["وَكقَرنِ الظَبي مِنسَرُهُ","في رحابِ الشِدقِ مُنقَعرِه",2,"ر",2,0],["وكقاضي القضاة يحيى الذي أو","تي ما أوتي الخليل ابن أدهم",3,"م",1,0],["وكقطر الندى يبلّ زجاج الوقت","يهدي برقة ٍ أشعارا",4,"ر",2,0],["وكقلب ٍ يشتاق صاحبه حتى","أتاه ُ ببهجة حين زارا",4,"ر",2,0],["وكَقَاربٍ تَركُوهُ بعد رُكوبهِ","مُتأَرجحًا, والبحرُ بعضُ ثُقوبهِ",5,"ب",2,1],["وَكَقَابِ قَوْسَيْنٍ دَنَا مِنْ رَبِّهِ","بِجَلاَلِ عِزٍّ بِالبَهَاءِ مُتَوَّجِ",6,"ج",1,0],["وَكَقَوْمِ هُودٍ إِذْ رَأَوْهُ عَارِضاً","مُسْتَقْبِلَ الوَادِي فَقَالُوا ذَا مَطَرْ",7,"ر",1,0]]}