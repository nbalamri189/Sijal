{"poems":[[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[77,"ما للغواني وهو لون خدودها","https://www.aldiwan.net/poem35896.html","الكامل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[82,"أما ترى حسن هلال الأفق","https://www.aldiwan.net/poem29414.html","الرجز"],[93,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[62,"تأبى صروف الليالي أن تديم لنا","https://www.aldiwan.net/poem52482.html","البسيط"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[66,"إن قصر لفظي فإن طولك قد طال","https://www.aldiwan.net/poem40968.html","السلسلة"],[69,"قالوا بدا الشعر أما تشعر","https://www.aldiwan.net/poem28916.html","السريع"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"إن كنت قد بلغت عني سبة","https://www.aldiwan.net/poem26966.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[46,"عش بخيلا كأهل عصرك هذا","https://www.aldiwan.net/poem23188.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21002","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[67,"عجباً لهم والسَّبْتُ بيعٌ عندهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=14555",""]],"verses":[["أَو خالِعٍ قَصُرَت يَداهُ عَنِ العُلى","بوعٌ لَكُم تَقِصُ الرِقابَ وَأَذرُعُ",0,"ع",1,0],["أو خِلْتُه لمْعَ السّيوفِ ومَنْ يَشِمْ","لمْعَ السّيوفِ علَى المَفارِقِ يفرُقِ",1,"ق",1,0],["أو خافَ طيْرَ الجوِّ منْ سَطَواتِهِ","لفَظَتْهُ عنْ أرْجائِها أوْكارُهُ",2,"ر",2,0],["أو خط نون بمداد ذهب","مترجم على زجاج أزرق",3,"ق",1,0],["أَوْ خَائِضاً بَحْرَ فَيْءٍ","يَشُقُّ شَقّاً عُبَابَهْ",4,"ب",2,0],["أو خلت منه دوره مُوحشاتٍ","فذراها بفضله مأهول",5,"ل",1,0],["أو خاننا القدَر المحتوم فيه فقد","بقَّاكُمُ سَمَراً عفَّى على السمر",6,"ر",1,0],["أو خلا الفجّار منكم","ملأوا الآفاق فسقا",7,"ق",2,0],["أَو خائِفٍ مُتَطَيِّرٍ","أَو صارِخٍ أَو مُستَجيرِ",8,"ر",1,0],["أو خيَّبَتْكَ لدى البأساءِ من فَرَجٍ","يُديلُ منها فكَذِّبْها ولا تَخِبِ",9,"ب",1,0],["أَو خَميسٍ كَأَنَّما طُرِقوا مِن","هُ بِلَيلٍ أَو صُبِّحوا بِنَهارِ",10,"ر",1,0],["أَو خِصامُ الشَهباءِ في يَومِ إِخرا","جِ غُلامي بِها إِلى النَخّاسِ",11,"س",1,0],["أَو خُدودَ الغيدِ ساطِعَةً","أَشرَقَت في فاقِعِ النُقُبِ",12,"ب",1,0],["أَو خَفَّفَ نَهضي جَميلُ صُنعِكَ عِندي","قَد حَمَّلَ ظَهري لِفَرطِ مِنِّكَ أَثقال",13,"ل",1,0],["أو خدُّهُ مرآةُ حُسْنٍ يرى","أهدابَهُ فيها الذي يَنظرُ",14,"ر",1,0],["أَو خالِعٌ لِلعَقدِ كَيما يَغنى","وَذاكَ أَدنى لِلرَدى وَأَدنى",15,"ن",2,0],["أَو خَبَرٍ يُكرَهُ أَو كِتابِ","يَقطَعُ طيبَ اللَهوِ وَالشَرابِ",16,"ب",1,0],["أَو خَيَّلو لَكَ أَنَّ عَهدي أَبتَرٌ","فَالحُرُّ لا يَرضى بِعَهدٍ أَبتَرِ",17,"ر",1,0],["أَو خالَفُوا هارُونَ في ذبحٍ وَفي","عَجْنٍ به لَمْ يُبْدِ عنهُ نُكُولا",18,"ل",2,0],["أوْ خُذوا مِنّيَ ما أبْقَيْتُمُ","لا أُحبُّ الجسْمَ مسْلوبَ الفؤادْ",19,"د",1,0],["أَو خُفافٍ يَرثي رِجالَ سُلَيمٍ","أَو سُحَيمٍ يَحدو مَعَ الرَكبِ إِبلَه",20,"ل",2,0],["أَو خُرَّدٌ بيض الطلى","ينظرن من خلل الستار",21,"ر",1,0],["أو خُطَى إلفينِ في فجرِ الصِّبا","أترَعا كأسَيهما مِنْ ذوبهِ",22,"ه",1,0],["أو خُطُوبٍ تَستَمِرُّ بهِ","فَيصيرُ العُرفُ إنكارا",23,"ر",2,0],["أَوْ خَوْفَ أَنْ تَغْشَى الأَدِلَّةَ رِيبَةٌ","مِنْ زُخْرُفٍ تَبْدُو بِهِ وَصِقَالِ",24,"ل",1,0],["أو خاصموا المحتلَّ خارجَ حكمهم","فإذا تولَّوا بادروا بوَلائه",25,"ا",3,0],["أو خلقَ الإنسانُ من تُرَاب","كأنما أنت هنا أعرابي",26,"ب",2,0],["أو خالفوا هارونَ في ذبحٍ وفي","عَجْنٍ له لَمْ يُبْدِ عنهُ نُكُولا",27,"ل",2,0]]}