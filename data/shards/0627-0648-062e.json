{"poems":[[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[77,"ما للغواني وهو لون خدودها","https://www.aldiwan.net/poem35896.html","الكامل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[82,"أما ترى حسن هلال الأفق","https://www.aldiwan.net/poem29414.html","الرجز"],[93,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[62,"تأبى صروف الليالي أن تديم لنا","https://www.aldiwan.net/poem52482.html","البسيط"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[66,"إن قصر لفظي فإن طولك قد طال","https://www.aldiwan.net/poem40968.html","السلسلة"],[69,"قالوا بدا الشعر أما تشعر","https://www.aldiwan.net/poem28916.html","السريع"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"إن كنت قد بلغت عني سبة","https://www.aldiwan.net/poem26966.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[46,"عش بخيلا كأهل عصرك هذا","https://www.aldiwan.net/poem23188.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21002","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[100,"ذكريات شيخين","https://www.poetsgate.com/ViewPoem.aspx?id=50390",""],[67,"عجباً لهم والسَّبْتُ بيعٌ عندهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=14555",""],[125,"فحم ذكت في حشاه نار","https://www.aldiwan.net/poem4091.html","مخلع البسيط"],[128,"برق أضا من أيمن الجرعاء","https://www.aldiwan.net/poem50683.html","الكامل"],[143,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[150,"أوخطب فرقتكم لدي قليلا","https://www.aldiwan.net/poem68469.html","الكامل"],[169,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[210,"أقسمت من فرقك بالفجر","https://www.aldiwan.net/poem13507.html","السريع"],[211,"مقطعات حسان","https://www.aldiwan.net/poem46612.html","المجتث"],[235,"في كل يوم منك يا دهر","https://www.aldiwan.net/poem31978.html","الكامل"],[298,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[342,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[364,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[364,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[403,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[403,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[403,"وافى نظامك وهو خير نظام","https://www.aldiwan.net/poem33424.html","الكامل"],[403,"لا توردن على سمعي من الكلم","https://www.aldiwan.net/poem33446.html","البسيط"],[403,"لله بحر منك زاخر","https://www.aldiwan.net/poem33894.html","مجزوء الكامل"],[403,"آه من برق إليكم قد روى","https://www.aldiwan.net/poem33915.html","الرمل"],[405,"يا من أراه يمتري بمودتي","https://www.aldiwan.net/poem49930.html","الكامل"],[458,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[458,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[461,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[529,"تكدر القلب من من أمور","https://www.aldiwan.net/poem37234.html","مخلع البسيط"],[538,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[575,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["أَو خالِعٍ قَصُرَت يَداهُ عَنِ العُلى","بوعٌ لَكُم تَقِصُ الرِقابَ وَأَذرُعُ",0,"ع",1,0],["أو خِلْتُه لمْعَ السّيوفِ ومَنْ يَشِمْ","لمْعَ السّيوفِ علَى المَفارِقِ يفرُقِ",1,"ق",1,0],["أو خافَ طيْرَ الجوِّ منْ سَطَواتِهِ","لفَظَتْهُ عنْ أرْجائِها أوْكارُهُ",2,"ر",2,0],["أو خط نون بمداد ذهب","مترجم على زجاج أزرق",3,"ق",1,0],["أَوْ خَائِضاً بَحْرَ فَيْءٍ","يَشُقُّ شَقّاً عُبَابَهْ",4,"ب",2,0],["أو خلت منه دوره مُوحشاتٍ","فذراها بفضله مأهول",5,"ل",1,0],["أو خاننا القدَر المحتوم فيه فقد","بقَّاكُمُ سَمَراً عفَّى على السمر",6,"ر",1,0],["أو خلا الفجّار منكم","ملأوا الآفاق فسقا",7,"ق",2,0],["أَو خائِفٍ مُتَطَيِّرٍ","أَو صارِخٍ أَو مُستَجيرِ",8,"ر",1,0],["أو خيَّبَتْكَ لدى البأساءِ من فَرَجٍ","يُديلُ منها فكَذِّبْها ولا تَخِبِ",9,"ب",1,0],["أَو خَميسٍ كَأَنَّما طُرِقوا مِن","هُ بِلَيلٍ أَو صُبِّحوا بِنَهارِ",10,"ر",1,0],["أَو خِصامُ الشَهباءِ في يَومِ إِخرا","جِ غُلامي بِها إِلى النَخّاسِ",11,"س",1,0],["أَو خُدودَ الغيدِ ساطِعَةً","أَشرَقَت في فاقِعِ النُقُبِ",12,"ب",1,0],["أَو خَفَّفَ نَهضي جَميلُ صُنعِكَ عِندي","قَد حَمَّلَ ظَهري لِفَرطِ مِنِّكَ أَثقال",13,"ل",1,0],["أو خدُّهُ مرآةُ حُسْنٍ يرى","أهدابَهُ فيها الذي يَنظرُ",14,"ر",1,0],["أَو خالِعٌ لِلعَقدِ كَيما يَغنى","وَذاكَ أَدنى لِلرَدى وَأَدنى",15,"ن",2,0],["أَو خَبَرٍ يُكرَهُ أَو كِتابِ","يَقطَعُ طيبَ اللَهوِ وَالشَرابِ",16,"ب",1,0],["أَو خَيَّلو لَكَ أَنَّ عَهدي أَبتَرٌ","فَالحُرُّ لا يَرضى بِعَهدٍ أَبتَرِ",17,"ر",1,0],["أَو خالَفُوا هارُونَ في ذبحٍ وَفي","عَجْنٍ به لَمْ يُبْدِ عنهُ نُكُولا",18,"ل",2,0],["أوْ خُذوا مِنّيَ ما أبْقَيْتُمُ","لا أُحبُّ الجسْمَ مسْلوبَ الفؤادْ",19,"د",1,0],["أَو خُفافٍ يَرثي رِجالَ سُلَيمٍ","أَو سُحَيمٍ يَحدو مَعَ الرَكبِ إِبلَه",20,"ل",2,0],["أَو خُرَّدٌ بيض الطلى","ينظرن من خلل الستار",21,"ر",1,0],["أو خُطَى إلفينِ في فجرِ الصِّبا","أترَعا كأسَيهما مِنْ ذوبهِ",22,"ه",1,0],["أو خُطُوبٍ تَستَمِرُّ بهِ","فَيصيرُ العُرفُ إنكارا",23,"ر",2,0],["أَوْ خَوْفَ أَنْ تَغْشَى الأَدِلَّةَ رِيبَةٌ","مِنْ زُخْرُفٍ تَبْدُو بِهِ وَصِقَالِ",24,"ل",1,0],["أو خاصموا المحتلَّ خارجَ حكمهم","فإذا تولَّوا بادروا بوَلائه",25,"ا",3,0],["أو خلقَ الإنسانُ من تُرَاب","كأنما أنت هنا أعرابي",26,"ب",2,0],["أو خبا الحسّ الذي كنّا به","نطعم الحزن ، ونشتمّ المرح",27,"ح",1,0],["أو خالفوا هارونَ في ذبحٍ وفي","عَجْنٍ له لَمْ يُبْدِ عنهُ نُكُولا",28,"ل",2,0],["أو خَدُّ مَن قد هويتُ لَمّا","أطلّ من فَوقه العِذارُ",29,"ر",1,0],["أو خِلْتَ مَن أهوى لهمت ولم تزل","متحيِّراً في شدَّةٍ ورخاءِ",30,"ا",2,0],["أَو خُروجٌ عَنها فَقَد آنَ لِلمَس","روقِ بَعدَ المِطالِ أَن يُستَعادا",31,"د",2,0],["أوَخَطبُ فُرقَتِكُم لَديّ قليلا","كَلاَّ ولا الصبر الجميل جميلا",32,"ل",2,1],["أَو خَلفُ سُوءٍ مِنَ الأَعرابِ هِمَّتُهُ","ما أَسخَطَ اللَهَ مِن قَولٍ وَمِن عَمَلِ",33,"ل",1,0],["او خادم مال مكبا على","اقدام من رق به شعري",34,"ر",2,0],["أو خاطرات الأماني","يزرن قلب عميد",35,"د",1,0],["أَو خانَني فيهِ الزَمانُ فَقَد","خانَ العَزاءُ عَليهِ وَالصَبرُ",36,"ر",1,0],["أَو خضماً بالجواري أَترعا","تتبارى مسرعاتِ للأَمامِ",37,"م",1,0],["او خيال في فؤاد شاعر","ينبذ الأرض ويعلو القننا",38,"ن",2,0],["أو خَفَّتِ الخيلُ وَقَر","لمّا رأى الإمْرَ احْتَضر",39,"ر",1,0],["أو خفَّتِ الخَيلُ وقَر","مهما رأى الشّرَّ فَغَر",40,"ر",1,0],["أو خليل لخليل كتبا","كلماً فتان",41,"ن",1,0],["أو خيالات من بقايا الرعايا","حيارى كل يحصل زعمه",42,"م",2,0],["أو خد ظبي قد بدا في خده","لام العذار مؤكداً لغرام",43,"م",1,0],["أو خير قول عن الأحباب تنقله","ليس اغتياباً ولا هتكاً لمنكتم",44,"م",1,0],["أو خضت في بحر المعا","رف جاء ما بهر النواظر",45,"ر",1,0],["أو خلا فافتض أبكار العلى","وحبانا كل معنى مبتكر",46,"ر",1,0],["أو خَيَّلُوا لكَ أنَّ عهديَ أبترٌ","فالحُرُّ لا يرضى بعَهدٍ أبترِ",47,"ر",1,0],["أو خبَت الآراءُ من حَيْرة","فرأيه بُلجةُ ليلِ الضلالْ",48,"ل",1,0],["أو خرقَ السبعَ ببي","تيه نسيبٌ فعلا",49,"ل",2,0],["أو خَلَتْ منك قُصورٌ أو حشت","فجنانُ الخُلْدِ ليست بخَوالِ",50,"ل",1,0],["أَوْ خِرْتَ لي بالّذي تَرَاهُ","إمّا بَحَلٍّ أَوْ ارْتِحالِ",51,"ل",1,0],["أو خصَّ بالقولِ ثَناءً لهمُ","فَهوَ بفِعلٍ للثَّنَا مُحَقّقِ",52,"ق",1,0],["أَو خانَ مِيثاقي","فإِنِّي لا أَخونُ المِيثاقْ",53,"ق",1,0],["أَوْ خَاطَبتْك النَّائِبا","تُ فعِنده فصْلُ الخِطابِ",54,"ب",1,0]]}