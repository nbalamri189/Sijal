 رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=200844",""],[5848,"الشماعه","https://www.poetsgate.com/ViewPoem.aspx?id=53102",""],[5848,"السما جردا","https://www.poetsgate.com/ViewPoem.aspx?id=50532",""],[5956,"أجمل جنة في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=184960",""],[5956,"يرجون ميراث أبيهمِ العباس وهو حيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=215975",""],[6045,"قُبلة من فم الأيّام","https://www.poetsgate.com/ViewPoem.aspx?id=125345",""],[6127,"يا ماشياً نحو الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=192767",""],[6152,"دلال أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=202693",""],[6237,"الليل في الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77891&r=&rc=33",""]],"verses":[["أَو خالِعٍ قَصُرَت يَداهُ عَنِ العُلى","بوعٌ لَكُم تَقِصُ الرِقابَ وَأَذرُعُ",0,"ع",1,0],["أو خِلْتُه لمْعَ السّيوفِ ومَنْ يَشِمْ","لمْعَ السّيوفِ علَى المَفارِقِ يفرُقِ",1,"ق",1,0],["أو خافَ طيْرَ الجوِّ منْ سَطَواتِهِ","لفَظَتْهُ عنْ أرْجائِها أوْكارُهُ",2,"ر",2,0],["أو خط نون بمداد ذهب","مترجم على زجاج أزرق",3,"ق",1,0],["أَوْ خَائِضاً بَحْرَ فَيْءٍ","يَشُقُّ شَقّاً عُبَابَهْ",4,"ب",2,0],["أو خلت منه دوره مُوحشاتٍ","فذراها بفضله مأهول",5,"ل",1,0],["أو خاننا القدَر المحتوم فيه فقد","بقَّاكُمُ سَمَراً عفَّى على السمر",6,"ر",1,0],["أو خلا الفجّار منكم","ملأوا الآفاق فسقا",7,"ق",2,0],["أَو خائِفٍ مُتَطَيِّرٍ","أَو صارِخٍ أَو مُستَجيرِ",8,"ر",1,0],["أو خيَّبَتْكَ لدى البأساءِ من فَرَجٍ","يُديلُ منها فكَذِّبْها ولا تَخِبِ",9,"ب",1,0],["أَو خَميسٍ كَأَنَّما طُرِقوا مِن","هُ بِلَيلٍ أَو صُبِّحوا بِنَهارِ",10,"ر",1,0],["أَو خِصامُ الشَهباءِ في يَومِ إِخرا","جِ غُلامي بِها إِلى النَخّاسِ",11,"س",1,0],["أَو خُدودَ الغيدِ ساطِعَةً","أَشرَقَت في فاقِعِ النُقُبِ",12,"ب",1,0],["أَو خَفَّفَ نَهضي جَميلُ صُنعِكَ عِندي","قَد حَمَّلَ ظَهري لِفَرطِ مِنِّكَ أَثقال",13,"ل",1,0],["أو خدُّهُ مرآةُ حُسْنٍ يرى","أهدابَهُ فيها الذي يَنظرُ",14,"ر",1,0],["أَو خالِعٌ لِلعَقدِ كَيما يَغنى","وَذاكَ أَدنى لِلرَدى وَأَدنى",15,"ن",2,0],["أَو خَبَرٍ يُكرَهُ أَو كِتابِ","يَقطَعُ طيبَ اللَهوِ وَالشَرابِ",16,"ب",1,0],["أَو خَيَّلو لَكَ أَنَّ عَهدي أَبتَرٌ","فَالحُرُّ لا يَرضى بِعَهدٍ أَبتَرِ",17,"ر",1,0],["أَو خالَفُوا هارُونَ في ذبحٍ وَفي","عَجْنٍ به لَمْ يُبْدِ عنهُ نُكُولا",18,"ل",2,0],["أوْ خُذوا مِنّيَ ما أبْقَيْتُمُ","لا أُحبُّ الجسْمَ مسْلوبَ الفؤادْ",19,"د",1,0],["أَو خُفافٍ يَرثي رِجالَ سُلَيمٍ","أَو سُحَيمٍ يَحدو مَعَ الرَكبِ إِبلَه",20,"ل",2,0],["أَو خُرَّدٌ بيض الطلى","ينظرن من خلل الستار",21,"ر",1,0],["أو خُطَى إلفينِ في فجرِ الصِّبا","أترَعا كأسَيهما مِنْ ذوبهِ",22,"ه",1,0],["أو خُطُوبٍ تَستَمِرُّ بهِ","فَيصيرُ العُرفُ إنكارا",23,"ر",2,0],["أَوْ خَوْفَ أَنْ تَغْشَى الأَدِلَّةَ رِيبَةٌ","مِنْ زُخْرُفٍ تَبْدُو بِهِ وَصِقَالِ",24,"ل",1,0],["أو خاصموا المحتلَّ خارجَ حكمهم","فإذا تولَّوا بادروا بوَلائه",25,"ا",3,0],["أو خلقَ الإنسانُ من تُرَاب","كأنما أنت هنا أعرابي",26,"ب",2,0],["أو خبا الحسّ الذي كنّا به","نطعم الحزن ، ونشتمّ المرح",27,"ح",1,0],["أو خالفوا هارونَ في ذبحٍ وفي","عَجْنٍ له لَمْ يُبْدِ عنهُ نُكُولا",28,"ل",2,0],["أو خَدُّ مَن قد هويتُ لَمّا","أطلّ من فَوقه العِذارُ",29,"ر",1,0],["أو خِلْتَ مَن أهوى لهمت ولم تزل","متحيِّراً في شدَّةٍ ورخاءِ",30,"ا",2,0],["أَو خُروجٌ عَنها فَقَد آنَ لِلمَس","روقِ بَعدَ المِطالِ أَن يُستَعادا",31,"د",2,0],["أوَخَطبُ فُرقَتِكُم لَديّ قليلا","كَلاَّ ولا الصبر الجميل جميلا",32,"ل",2,1],["أَو خَلفُ سُوءٍ مِنَ الأَعرابِ هِمَّتُهُ","ما أَسخَطَ اللَهَ مِن قَولٍ وَمِن عَمَلِ",33,"ل",1,0],["او خادم مال مكبا على","اقدام من رق به شعري",34,"ر",2,0],["أو خاطرات الأماني","يزرن قلب عميد",35,"د",1,0],["أَو خانَني فيهِ الزَمانُ فَقَد","خانَ العَزاءُ عَليهِ وَالصَبرُ",36,"ر",1,0],["أَو خضماً بالجواري أَترعا","تتبارى مسرعاتِ للأَمامِ",37,"م",1,0],["او خيال في فؤاد شاعر","ينبذ الأرض ويعلو القننا",38,"ن",2,0],["أو خَفَّتِ الخيلُ وَقَر","لمّا رأى الإمْرَ احْتَضر",39,"ر",1,0],["أو خفَّتِ الخَيلُ وقَر","مهما رأى الشّرَّ فَغَر",40,"ر",1,0],["أو خليل لخليل كتبا","كلماً فتان",41,"ن",1,0],["أو خيالات من بقايا الرعايا","حيارى كل يحصل زعمه",42,"م",2,0],["أو خد ظبي قد بدا في خده","لام العذار مؤكداً لغرام",43,"م",1,0],["أو خير قول عن الأحباب تنقله","ليس اغتياباً ولا هتكاً لمنكتم",44,"م",1,0],["أو خضت في بحر المعا","رف جاء ما بهر النواظر",45,"ر",1,0],["أو خلا فافتض أبكار العلى","وحبانا كل معنى مبتكر",46,"ر",1,0],["أو خَيَّلُوا لكَ أنَّ عهديَ أبترٌ","فالحُرُّ لا يرضى بعَهدٍ أبترِ",47,"ر",1,0],["أو خبَت الآراءُ من حَيْرة","فرأيه بُلجةُ ليلِ الضلالْ",48,"ل",1,0],["أو خرقَ السبعَ ببي","تيه نسيبٌ فعلا",49,"ل",2,0],["أو خَلَتْ منك قُصورٌ أو حشت","فجنانُ الخُلْدِ ليست بخَوالِ",50,"ل",1,0],["أَوْ خِرْتَ لي بالّذي تَرَاهُ","إمّا بَحَلٍّ أَوْ ارْتِحالِ",51,"ل",1,0],["أو خصَّ بالقولِ ثَناءً لهمُ","فَهوَ بفِعلٍ للثَّنَا مُحَقّقِ",52,"ق",1,0],["أَو خانَ مِيثاقي","فإِنِّي لا أَخونُ المِيثاقْ",53,"ق",1,0],["أَوْ خَاطَبتْك النَّائِبا","تُ فعِنده فصْلُ الخِطابِ",54,"ب",1,0],["أو خدها والنار فيه توهجت","تصلي ضلوعي أيما أصلاء",55,"ا",2,0],["أَو خاضَ في ذِكرى العَذيبِ تَشابَهَت","أَعطافَ مُستَمَعيهِ مَعَ باناتِهِ",56,"ت",2,0],["أَو خَيَّالٍ في الهيجاتِ","يَستأصل غُصنَ الهاماتِ",57,"ت",1,0],["أو خَطَّ في وَجْنَتَيْ مَيْتٍ لأنشرَهُ","وقامَ للحِينِ في أثوابِه يَثِبُ",58,"ب",1,0],["أو خاصموك على العلى","حسدا لقامت عنك خصما",59,"م",2,0],["أوْ خطِّ زَاجٍ عَلَى سَوَادٍ","أحَاطَ شَكْلاً سنَاهُ أوْقَدْ",60,"د",1,0],["أَو خِلتَها أَخَذَت أَطرافَ خُرَّمَةٍ","فَنَضَّدَتهُ عَلى جِمارَةٍ غَضَّه",61,"ه",1,0],["أو خِفتَ بَعضَ الجَور مِن سُلطَانِهِ","فَدَعه يُنفِذهُ إِلى أوَانِهِ",62,"ه",1,1],["أَوْ خَرِقاً مِنْ طُولِ عَهْدٍ يُبْلِي","تِلْكَ اللَيالِي بِالنَهارِ الوُصْلِ",63,"ل",1,0],["أَوْ خُضْنَ يَوْمَ الكَلِبِ المَغَامِرا","نَهَّضْتَ حَمّالاً بِهِنَّ جاسِرا",64,"ر",2,0],["أَوْ خَارِبٌ وَهْيَ تَغَالى بِالحِزَقْ","فَأَصْبَحَتْ بِالصُلْبِ مِنْ طُولِ الوَسَقْ",65,"ق",1,0],["أو خطرت قال غصن النقا","لله حسبك هذا الدلال",66,"ل",1,0],["أَو خانَهُ الدَّهْرُ فلا يكْتَرثْ","فكلُّ ما فوقَ التُّرابِ تُرابْ",67,"ب",1,0],["أو خبر عن اسم عين أو قسم","جوابه باللام أو لا لام ثم",68,"م",1,0],["أو خَرَعٌ أو جَزَعٌ لِكُربَةٍ","أو لانتِيَابِ أزمةٍ أو لزبةٍ",69,"ه",1,0],["أو خفت من مرّ الزمان فليس في","شرع المحب إذا وفى من مُدة",70,"ه",1,0],["أَو خمر ساقيكم","فالكل أَعياني",71,"ي",1,0],["أو خواتيم أنت جوهر فص","أو قرى أنت مكّة البطحاء",72,"ا",2,0],["أو خلته كان مثالاً","للصراح ما عدا",73,"د",2,0],["أو خرّدٍ نهضت للرقص فاعتنقت","كيلا تجيء برقص غير موزون",74,"ن",1,0],["أو خذ دراهم واتبع ما أردت بها","واستوف حقك منها كلما يهفُ",75,"ف",1,0],["أو خَطرَ الموتُ على بالهِ","لكانَ في شُغلٍ عن الصَّادِح",76,"ح",1,0],["او خيروني في الجنان لانكرت","نفسي عليَّ رضاي باستبداله",77,"ل",2,0],["أو خلتَهُنَّ سماواتٍ تحيطُ بها","أعلى الكواكبِ مَرِّيخٌ وكِيوَانُ",78,"ن",1,0],["أو خال مستن انزال حديقة","من جلناراً والدما أنهارها",79,"ر",3,0],["أو خلت بأن القلب هفا","لسواك بعشق يقصده",80,"د",2,0],["أَو خائِفٌ لَحِماً شاكاً بَراثِنهُ","كَأَنَّهُ قاطِمٌ وَقفَينِ مِن عاجِ",81,"ج",1,0],["أو خاطبت عزمي الخطوب وأرهفت","أسيافها لفللت حد ظباتها",82,"ت",3,0],["أو خائف يحضى بحصن جواركم","متمَنّعاً متدرّعا بأمان",83,"ن",1,0],["أو خَالَفَت هَذَا رَددَنَاهَا عَلَى","مَن قَالَهَا مَن كَان مِنَ إنسَانِ",84,"ن",1,0],["أَو خلق الدرع إِذا","أَبصَرتَها مُشتَبِكَه",85,"ك",2,0],["أو خارجٌ منها ولستَ بعائدٍ","ولكلِّ ناءٍ عودةٌ ولمام",86,"م",1,0],["أو خلوة تندى أحاديثه","فيها على سمعى ندي السحاب",87,"ب",1,0],["أو خدود التفاح من تفوح","خضبتها أنامل العناب",88,"ب",1,0],["أو خَامَ نَكْسٌ عنِ الأمْرٍ الخَطِيرِ فَخَط","ابٌ إلَى الْمجْدِ فِي الأَخْطَارِ وَثَّابُ",89,"ب",1,0],["أو خمر كلواذا إلى بغدان","أو ما نسبناها الى جرجان",90,"ن",1,0],["أو خيمة في سقفها جواهر","من أحمر قان وأبيض يقق",91,"ق",1,0],["أَو خمرة مِن سالف الاعصار","تسكر وَهيَ في يَد العصار",92,"ر",1,0],["أو خوصمَت خصمت أو فوحمت فحمَت","أو كوثِرضت كثَرَت لكن بلا ملل",93,"ل",1,0],["اوخشتَ رَبعاً كنتَ تؤنسهُ فَما","هُوَ بعدَ بُعدِكَ عن حماهُ آهِلُ",94,"ل",1,0],["أو خاض بحر المنايا فاجتنى درراً","وصاغ منها حُلى حسن بها باها",95,"ا",3,0],["أَوْ خُذْ حَدِيثَ غَرَامِي فَاتْخِذْ سَمَراً","فَفِيهِ لِلسَّمْعِ إِسْعَافٌ وَإِسْعَادُ",96,"د",1,0],["أو خائض بدماء القوم مفتخر","بالسفك مستولع بالهتك ولهان",97,"ن",1,0],["او خلفَ فردون التي","تحوي الأسود الرابضين",98,"ن",1,0],["أو خُذاني نحوَ هاتِ