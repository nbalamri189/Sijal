{"poems":[[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[23,"تسائل عن قوم هجان سميدع","https://www.aldiwan.net/poem21268.html","الطويل"],[23,"بكت عيني وحق لها بكاها","https://www.aldiwan.net/poem21606.html","الوافر"],[30,"كم لك يا ابن دحمة من قريب","https://www.aldiwan.net/poem5208.html","الوافر"],[52,"دعيني يا أميرة من سرار","https://www.aldiwan.net/poem63804.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67334","الوافر"],[108,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[119,"روح الوجود بآل المصطفى انتعشت","https://www.aldiwan.net/poem41793.html","البسيط"],[382,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[463,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[484,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138315",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38320","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138794",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70120","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94901","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94889","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104933","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120497","الوافر"],[4778,"على إستحياء","https://www.poetsgate.com/ViewPoem.aspx?id=198848",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4578,"سهم النوائب لا يبقى ولا يذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=49427",""],[5389,"هارون الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=206085",""],[5431,"مصر...والرؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=197044",""],[5533,"عَروسُ المَدائِن","https://www.poetsgate.com/ViewPoem.aspx?id=177401",""],[5595,"عليٌّ أصلهُ نسبُ النبيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=144759",""],[5690,"بني الروم الكاثوليك افتخاراً","https://www.poetsgate.com/ViewPoem.aspx?id=172257",""],[5725,"على استحياء","https://www.poetsgate.com/ViewPoem.aspx?id=180382",""],[5829,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151690",""],[5873,"حصون العز","https://www.poetsgate.com/ViewPoem.aspx?id=215408",""],[6127,"إلى العراق","https://www.poetsgate.com/ViewPoem.aspx?id=199867",""],[6174,"الشِّعر في عُرس النجومِ الخُضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86185&r=&rc=2",""]],"verses":[["عَلى اِستِها خِرقَةٌ مُعلَّقَةٌ","كَطَيلَسانِ اِبنِ مُكتَعِ الحَربي",0,"ب",2,0],["عَلى أَسَدِ اللَهِ الَّذي كانَ مِدرَهاً","يَذودُ عَنِ الإِسلامِ كُلَّ كُفورِ",1,"ر",1,0],["عَلى أَسَدِ الإِلَهِ غَداةَ قالوا","أَحَمزَةُ ذَلِكَ الرَجُلُ القَتيلُ",2,"ل",1,0],["عَلى آساسِ عَبدٍ مِن عُمانٍ","تَقَيَّلَ في رِفاقِ أَبي صِفارِ",3,"ر",1,0],["عَلى أَستاهِ سادَتِهِم كِتابٌ","مَوالي عامِرٍ وَسمٌ بِنارِ",4,"ر",1,0],["على آسانِ أباءٍ كِرامٍ","لهمْ عن كلّ مَكْرُمَةٍ نِضَال",5,"ل",1,0],["عَلَى أَسَدِ الإله غَدَاةَ قالوا","أحمزةُ ذَاكُمُ الرّجُلُ القَتِيلُ",6,"ل",1,0],["على أساسين من: عزمٍ وإيمانٍ","نَبْنيهِ، لا من: جَرانيتٍ وصَوَّانِ",7,"ن",1,1],["على اسف ارثيك والدمع هامل","وقلبي محروق وذهني مكلم",8,"م",1,0],["عليا سيادتهم عن سيد رويت","عن سيد عن إمام عن فتى بطل",9,"ل",1,0],["على إسِّهِم نبني قواعدَ ديننا","كما شيد بالإنجيل هيكل بيعة",10,"ه",1,0],["على اسمك تُحدَى أو بوصفك تُقتضَى","صِعاباً فتعنو في الحبال وتسهُلُ",11,"ل",1,0],["على اساريرهم ما في سريرتهم","باد ونوره فيهم كيف ينكتم",12,"م",1,0],["على اس الصلاح بنى فخارا","وهله يبنى الفخار بغير أس",13,"س",1,0],["عَلى أَسرِهم مِن بَعدِ خَطفِ عُقولِهِم","يُعاوِنُهُ بِالسّحرِ في الجفنِ أَوطفُه",14,"ف",2,0],["عليَّ إسعادهم مهما استطعت فإن","أعجز فللعجز من حالي دِلالاتُ",15,"ت",1,0],["على اسد الغابات أضبعها","وفي الرعاة لها قد عاثت الشاء",16,"ا",2,0],["على أسود الناس أهل الشان","ما كان مثلَ اِبنِ خادمٍ لَهُ",17,"ه",1,0],["على إسكمندر راح يجد","وآخيل في إثره مبتعد",18,"د",1,0],["عَلى اسِّ الصَفا عَلى ذراهُ","فَلا يَخشى عَواصف حاسديهِ",19,"ي",2,0],["على اسم البكر مريمَ قد بناها","بنو عقل لخير بني المتينِ",20,"ن",1,1],["على اسم جرجسَ شهمالدين مذ بدأوا","في ذا المقام فعظّمناهُ تهليلا",21,"ل",2,1],["على اسم رز لا مسمى له","فرام بعض القوم تقويمه",22,"م",2,0],["على اس الوفاء بنيت حبي","وطيدا لن يحول ولن يزولا",23,"ل",2,0],["على إستحياء إذ سُئِلتْ أجابت:","نذود لحين أن يسقي الرِّعَاءُ",24,"ا",2,1],["على أسوة فيه وفيها نهايتي","إليها بها عن غيرها هي تنهاني",25,"ن",2,0],["علي أسعد أكليل الزمان ومن","أثار جدواه في نحر المنى دررُ",26,"ر",1,0],["علي إسمه الذكر وحروفه آيات","علي للحكمه منبعها وأصلهه",27,"ل",3,0],["على أسدٍ تعوي ذئابٌ بفجرها","وماعابه ذئبٌ ولكنه الكلبُ",28,"ب",1,0],["على أَسْوَارِها سَكَنَ الفُؤادُ","وأَشْرقَتْ القَصَائدُ والمِدادُ",29,"د",1,1],["عليٌّ اسمهُ عنوانٌ تليدٌ","لهُ الدّنيا تقومُ في جلال ِ",30,"ل",1,1],["على أسم البكر مريم قد بنوها","لذا حلَّ الإله بها وخيَّمْ",31,"م",1,0],["على استحياء مشيتها الهوينا","كميس الغصن اوّدتِ القدودا",32,"د",2,1],["على اسم الله مبداها ومحياها","وعين الله تحميها وترعاها",33,"ا",3,1],["على إسلامنا صبت رزايا","وأصبح حبنا الدنيا وثاقا",34,"ق",2,0],["على اسمِ اللهِ أرخصْنا دمانا","لتَطْهُرَ تُرْبُةٌ حملتْ وصيّا",35,"ي",2,0],["عَلَى اسْمِكُمْ ... لِجِبَال النَّارِ أُغْنِيَتي","مَعَازِفُ الرَّصْدِ في أَوْتَارِهَا اللَّهَبُ",36,"ب",1,0]]}