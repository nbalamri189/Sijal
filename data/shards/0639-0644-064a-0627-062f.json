{"poems":[[50,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130152","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48645","الرجز"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61088","المتقارب"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143972","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89235","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91077","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81933","الكامل"],[5370,"من الصغر حبه","https://www.poetsgate.com/ViewPoem.aspx?id=87429",""],[5826,"طرف الْكَرِيم عَن الغلياء لم ينم","https://www.poetsgate.com/ViewPoem.aspx?id=190271",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""]],"verses":[["على أدقّ الثيابِ مسبَلةٍ","برّاقةِ اللونِ كلّها جددُ",0,"د",1,0],["عَلِّي أداوِي حَزيناً","فالحزنُ يُمْحَيى بحزن",1,"ن",1,0],["على أدهم رحب الذراع بغرة","يخوض الدياجي فاستعار نهارها",2,"ر",3,0],["عليَّ أدنى المشرقين استعصى","لأُمْضِيَنَّ همتي في الأقصى",3,"ص",2,0],["عَلى أَدهم مصمت ما خَفا","فَكَيف إِذا رَكبَ الأَشقَرا",4,"ر",2,0],["على أدمعٍ منهلةٍ فتأملا","كتابي تبن آثارها في كتابيا",5,"ي",2,0],["على أدمعي مهجتي كم قد تذوب","وذابت على مهجتي أدمعي",6,"ع",2,0],["عَلِّي أُدارِكُ روحاً بالردى فَنيت","أَو أَن أَقوّم نفساً مِن يَد العوج",7,"ج",1,0],["عليّ أدينك أو أدان وأنه","كالمسلجية ضوؤها كلآلى",8,"ل",2,0],["على ادناة شي ازعل على ادناة شي اعيل","أويلاه عقب اليوم يا خفّها نفسي",9,"س",2,0],["عَليّ أَدْرَاك مَا حاولته فَإِذا","حرمت مَا رمت بعد السَّعْي لم ألم",10,"م",1,0],["عَلى أَدنا وَقَيصوم نحر هجينتك","عَلى ماردين وَديار بكر انحار",11,"ر",1,0]]}