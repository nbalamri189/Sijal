{"poems":[[63,"أليلتنا بالحزن عودي فإنني","https://www.aldiwan.net/poem45776.html","الطويل"],[63,"رمتني غداة الخيف ليلى بنظرة","https://www.aldiwan.net/poem45789.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[30,"ذكرت فاهتاج السقام المضمر","https://www.aldiwan.net/poem29590.html","الرجز"],[85,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[33,"وأجهشت للتوباد حين رأيته","https://www.aldiwan.net/poem25776.html","الطويل"],[21,"عرفت الدار قد أقوت سنينا","https://www.aldiwan.net/poem36141.html","الوافر"]],"verses":[["وَأُذري بِهِ دَمعاً يُرَوّي غليلَهُ","فَلَم يَتَحَمَّل بَعدَهُ مِنَّةَ المُزْنِ",0,"ن",1,0],["وَأَذرت بِجَمعٍ فالمُحَصِّبِ عَبرَةً","فَظَلَّتْ بِأَطرافِ البَنانِ تَذودُها",1,"د",3,0],["وَأُذِْر مَهْمَا رِييءَ أَرْضٌ بَعِيدَةٌ","وَبَانَ لَهُ فَضْلٌ وَرَاقَ لَهُ رَقْمُ",2,"م",1,0],["وَأَذرُعٌ تَسدو بِها فَتَمهَرُ","إِذا اِزدَهاها القَرَبُ العَشَنزَرُ",3,"ر",1,0],["واذرف على القلب الدموع فكلكم","في آدم أهل وآدم يجمع",4,"ع",1,0],["وَإِذ راموا مِنَ النارِ اِحتِماءَ","حَمَت أَسيافُنا مِنهُم مِئينا",5,"ا",1,0],["وَأَذرَيتُ دَمعَ العَينِ لَمّا رَأَيتُهُ","وَنادى بِأَعلى صَوتِهِ وَدَعاني",6,"ي",1,0],["وأَذرَتها حَوافِلُ مُعصِفاتٌ","كَما تُذريَ المُلَملِمَةُ الطَحينا",7,"ن",2,0]]}