{"poems":[[63,"أليلتنا بالحزن عودي فإنني","https://www.aldiwan.net/poem45776.html","الطويل"],[63,"رمتني غداة الخيف ليلى بنظرة","https://www.aldiwan.net/poem45789.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[30,"ذكرت فاهتاج السقام المضمر","https://www.aldiwan.net/poem29590.html","الرجز"],[85,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[33,"وأجهشت للتوباد حين رأيته","https://www.aldiwan.net/poem25776.html","الطويل"],[21,"عرفت الدار قد أقوت سنينا","https://www.aldiwan.net/poem36141.html","الوافر"],[127,"تعالي صباحا إلى غرفتي","https://www.aldiwan.net/poem67444.html","المتقارب"],[148,"مديح نبي الله أزكى التعبد","https://www.aldiwan.net/poem68603.html","الطويل"],[209,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[210,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[221,"أسمعيني لحن الردى أسمعيني","https://www.aldiwan.net/poem41621.html","الخفيف"],[233,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[268,"إلام تعالج الأسد القيودا","https://www.aldiwan.net/poem35176.html","الوافر"],[268,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[288,"حننت إلى الوادي إلى مسرح الصبا","https://www.aldiwan.net/poem11678.html","الطويل"],[295,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[296,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[296,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[340,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[362,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[362,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[399,"وا طول حزني في غد وتحسري","https://www.aldiwan.net/poem47004.html","الطويل"],[513,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[549,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[549,"عرفت ويا ليتني ما عرفت","https://www.aldiwan.net/poem47382.html","المتقارب"],[549,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَأُذري بِهِ دَمعاً يُرَوّي غليلَهُ","فَلَم يَتَحَمَّل بَعدَهُ مِنَّةَ المُزْنِ",0,"ن",1,0],["وَأَذرت بِجَمعٍ فالمُحَصِّبِ عَبرَةً","فَظَلَّتْ بِأَطرافِ البَنانِ تَذودُها",1,"د",3,0],["وَأُذِْر مَهْمَا رِييءَ أَرْضٌ بَعِيدَةٌ","وَبَانَ لَهُ فَضْلٌ وَرَاقَ لَهُ رَقْمُ",2,"م",1,0],["وَأَذرُعٌ تَسدو بِها فَتَمهَرُ","إِذا اِزدَهاها القَرَبُ العَشَنزَرُ",3,"ر",1,0],["واذرف على القلب الدموع فكلكم","في آدم أهل وآدم يجمع",4,"ع",1,0],["وَإِذ راموا مِنَ النارِ اِحتِماءَ","حَمَت أَسيافُنا مِنهُم مِئينا",5,"ا",1,0],["وَأَذرَيتُ دَمعَ العَينِ لَمّا رَأَيتُهُ","وَنادى بِأَعلى صَوتِهِ وَدَعاني",6,"ي",1,0],["وأَذرَتها حَوافِلُ مُعصِفاتٌ","كَما تُذريَ المُلَملِمَةُ الطَحينا",7,"ن",2,0],["وأذري الدُموعَ على جُثَتي","وَإِن مال طَرفُكَ عني ازوِرارا",8,"ر",2,0],["وَإِذردَّ مِنها الطَوعَ صادِقُ كُرهِهِ","تَقَدَّمَ وَالبُشرى تَلوحُ بِوَجهِهِ",9,"ه",1,0],["وأذرع الأرض أطويها وأنشرها","كالبرق يجتاز أكواناً لأكوان",10,"ن",1,0],["واذريت ماءً غالياً من مدامعي","ولولا الهوى ما كان يجري ويَنْبِعُ",11,"ع",1,0],["وَاِذرُفي دَمعَةً عَليَّ فَبعد ال","موتِ لا أَستَحلُّ أَن تَبكيني",12,"ي",1,0],["وَأَذري دِماءً وَحشَةً لِفِراقِكُم","وَإِن أَنا لَم أَبكِ الدِماءَ فَما عُذري",13,"ر",2,0],["وأذرفُ أصدقَ الدمعاتِ حتى","غَدَت في جيدِها الباهي عُقودا",14,"د",2,0],["وإذ رأيتُ عروسَ الشعرِ عاريةً","ألبستُها من شغافِ القلبِ جلبابا",15,"ب",2,0],["وآذرف دمع العين إمّا ذكرتُها","وتصبو لها نفسي ويهفو لها قلبي",16,"ب",2,0],["وأَذرَت دُموعاً من لحاظٍ سقيمةٍ","هي الدرُّ لكن ما لمنثوره لَقطُ",17,"ط",1,0],["وإذْ رقصتْ فهزَّتْ غصنَ بانٍ","يأَوِّدُه الهوى وَبه يحيق",18,"ق",1,0],["وَأذريتُ الدموعَ فكا","د طرفُ النجمِ ينهمع",19,"ع",1,0],["واذرفي يا عين من حرق","ادمعاً كالعارض الهتن",20,"ن",1,0],["وإذْ راع منك الاسْمُ فانهزموا له","فكيف رجَوا صَبْراً وشَخْصُك قد بدا",21,"د",2,0],["وأذْرَيت لمّا خانَني الصَّبرُ عَبْرةً","فسالتْ بأعلَى الأبرقّينِ شِعاب",22,"ب",1,0],["واذْري المدامعَ حسرةً وتلهُّفاً","وتغسّلي بمياهِهَا وتطهّري",23,"ي",1,0],["وأذري دماً من مقلتي بعد أدمع","تضرجه في وجنتي عبراتي",24,"ي",1,0],["وأذرُعٍ حاسرةٍ ترمي وقدْ","حان طلوعُ الشّمسِ بالجنادلِ",25,"ل",1,0],["وأذرى الدّموعَ ويا قلّما","يَرُدُّ الفوائتَ دمعٌ ذَرَفْ",26,"ف",1,0],["وأذرُعٍ كسيوفِ الهندِ ضاحيةٍ","يَقذفن في كلِّ يومٍ بالحُصيّاتِ",27,"ت",1,0],["وإذ رأى الحسين ما قد رابه","ناشدهم بالله والقرابة",28,"ه",1,0]]}