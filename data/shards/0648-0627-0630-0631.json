{"poems":[[65,"أليلتنا بالحزن عودي فإنني","https://www.aldiwan.net/poem45776.html","الطويل"],[65,"رمتني غداة الخيف ليلى بنظرة","https://www.aldiwan.net/poem45789.html","الطويل"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[32,"ذكرت فاهتاج السقام المضمر","https://www.aldiwan.net/poem29590.html","الرجز"],[87,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[87,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[35,"وأجهشت للتوباد حين رأيته","https://www.aldiwan.net/poem25776.html","الطويل"],[21,"عرفت الدار قد أقوت سنينا","https://www.aldiwan.net/poem36141.html","الوافر"],[102,"شمسان","https://www.poetsgate.com/ViewPoem.aspx?id=50171",""],[133,"تعالي صباحا إلى غرفتي","https://www.aldiwan.net/poem67444.html","المتقارب"],[154,"مديح نبي الله أزكى التعبد","https://www.aldiwan.net/poem68603.html","الطويل"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[216,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[228,"أسمعيني لحن الردى أسمعيني","https://www.aldiwan.net/poem41621.html","الخفيف"],[240,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[275,"إلام تعالج الأسد القيودا","https://www.aldiwan.net/poem35176.html","الوافر"],[275,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[295,"حننت إلى الوادي إلى مسرح الصبا","https://www.aldiwan.net/poem11678.html","الطويل"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[303,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[303,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[347,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[369,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[408,"وا طول حزني في غد وتحسري","https://www.aldiwan.net/poem47004.html","الطويل"],[520,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[556,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[556,"عرفت ويا ليتني ما عرفت","https://www.aldiwan.net/poem47382.html","المتقارب"],[556,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39030","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130197","الطويل"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104450","البسيط"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124038","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61133","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56204","الطويل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112772","الكامل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31638","الوافر"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82624","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108991","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53130","المنسرح"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202380","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93882","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93818","البسيط"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136961",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87361","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86272","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86258","البسيط"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105764","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66518","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132003","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205681","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131138",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131032",""],[3838,"","https://poetry.dctabudhabi.ae/diwan/poem/105690","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114294","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107518","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86463","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76746","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104894","المتقارب"],[4927,"الباص العذول","https://www.poetsgate.com/ViewPoem.aspx?id=29647",""],[4960,"إلياذة","https://www.poetsgate.com/ViewPoem.aspx?id=210397",""],[5085,"أشاغلُ نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=188401",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5431,"إلى أم الدنيا-الى مصر الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=191005",""],[5626,"جراح العراق","https://www.poetsgate.com/ViewPoem.aspx?id=189537",""],[5674,"قيس وليلى","https://www.poetsgate.com/ViewPoem.aspx?id=189085",""],[5704,"توبة ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200008",""],[5704,"قف بالرِّكابِ ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=202821",""],[5943,"غمد الحريق","https://www.poetsgate.com/ViewPoem.aspx?id=41601",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""]],"verses":[["وَأُذري بِهِ دَمعاً يُرَوّي غليلَهُ","فَلَم يَتَحَمَّل بَعدَهُ مِنَّةَ المُزْنِ",0,"ن",1,0],["وَأَذرت بِجَمعٍ فالمُحَصِّبِ عَبرَةً","فَظَلَّتْ بِأَطرافِ البَنانِ تَذودُها",1,"د",3,0],["وَأُذِْر مَهْمَا رِييءَ أَرْضٌ بَعِيدَةٌ","وَبَانَ لَهُ فَضْلٌ وَرَاقَ لَهُ رَقْمُ",2,"م",1,0],["وَأَذرُعٌ تَسدو بِها فَتَمهَرُ","إِذا اِزدَهاها القَرَبُ العَشَنزَرُ",3,"ر",1,0],["واذرف على القلب الدموع فكلكم","في آدم أهل وآدم يجمع",4,"ع",1,0],["وَإِذ راموا مِنَ النارِ اِحتِماءَ","حَمَت أَسيافُنا مِنهُم مِئينا",5,"ا",1,0],["وَأَذرَيتُ دَمعَ العَينِ لَمّا رَأَيتُهُ","وَنادى بِأَعلى صَوتِهِ وَدَعاني",6,"ن",2,0],["وأَذرَتها حَوافِلُ مُعصِفاتٌ","كَما تُذريَ المُلَملِمَةُ الطَحينا",7,"ن",2,0],["واذر العداة على السفوح وفي الربى","مزقا كما تذرو الرياح رمادا",8,"د",2,0],["وأذري الدُموعَ على جُثَتي","وَإِن مال طَرفُكَ عني ازوِرارا",9,"ر",2,0],["وَإِذردَّ مِنها الطَوعَ صادِقُ كُرهِهِ","تَقَدَّمَ وَالبُشرى تَلوحُ بِوَجهِهِ",10,"ه",1,0],["وأذرع الأرض أطويها وأنشرها","كالبرق يجتاز أكواناً لأكوان",11,"ن",1,0],["واذريت ماءً غالياً من مدامعي","ولولا الهوى ما كان يجري ويَنْبِعُ",12,"ع",1,0],["وَاِذرُفي دَمعَةً عَليَّ فَبعد ال","موتِ لا أَستَحلُّ أَن تَبكيني",13,"ن",2,0],["وَأَذري دِماءً وَحشَةً لِفِراقِكُم","وَإِن أَنا لَم أَبكِ الدِماءَ فَما عُذري",14,"ر",2,0],["وأذرفُ أصدقَ الدمعاتِ حتى","غَدَت في جيدِها الباهي عُقودا",15,"د",2,0],["وإذ رأيتُ عروسَ الشعرِ عاريةً","ألبستُها من شغافِ القلبِ جلبابا",16,"ب",2,0],["وآذرف دمع العين إمّا ذكرتُها","وتصبو لها نفسي ويهفو لها قلبي",17,"ب",2,0],["وأَذرَت دُموعاً من لحاظٍ سقيمةٍ","هي الدرُّ لكن ما لمنثوره لَقطُ",18,"ط",1,0],["وإذْ رقصتْ فهزَّتْ غصنَ بانٍ","يأَوِّدُه الهوى وَبه يحيق",19,"ق",1,0],["وَأذريتُ الدموعَ فكا","د طرفُ النجمِ ينهمع",20,"ع",1,0],["واذرفي يا عين من حرق","ادمعاً كالعارض الهتن",21,"ن",1,0],["وإذْ راع منك الاسْمُ فانهزموا له","فكيف رجَوا صَبْراً وشَخْصُك قد بدا",22,"د",2,0],["وأذْرَيت لمّا خانَني الصَّبرُ عَبْرةً","فسالتْ بأعلَى الأبرقّينِ شِعاب",23,"ب",1,0],["واذْري المدامعَ حسرةً وتلهُّفاً","وتغسّلي بمياهِهَا وتطهّري",24,"ر",2,0],["وأذري دماً من مقلتي بعد أدمع","تضرجه في وجنتي عبراتي",25,"ت",2,0],["وأذرُعٍ حاسرةٍ ترمي وقدْ","حان طلوعُ الشّمسِ بالجنادلِ",26,"ل",1,0],["وأذرى الدّموعَ ويا قلّما","يَرُدُّ الفوائتَ دمعٌ ذَرَفْ",27,"ف",1,0],["وأذرُعٍ كسيوفِ الهندِ ضاحيةٍ","يَقذفن في كلِّ يومٍ بالحُصيّاتِ",28,"ت",1,0],["وإذ رأى الحسين ما قد رابه","ناشدهم بالله والقرابة",29,"ه",1,0],["وإذْ رياضُ المُنَى تُجْلَى زَواهِرُها","قد أُلْبِسَتْ مِن حُلى أزهارها خَالا",30,"ل",2,0],["وإذ ركعت فوق السروج فوارس","فخلنا ظهور الخيل ساحة مسجد",31,"د",1,0],["وأذرع القفرة البيدا لتبلغني","عبد الحسين المفدى أنيق بزل",32,"ل",1,0],["وإذ ريئت الحيطان من قصر قيصر","واذ راع كسرى من بنيّتهِ الكسر",33,"ر",1,0],["وأذرت جفون السحب عبرة مزنها","وقد حان من تلك النجوم غروب",34,"ب",1,0],["وَإِذ رمقي في عُنفُوان شَبابه","وَعُمري للذات عمر مقسم",35,"م",1,0],["وإذ رام من بعد التمهد عودةً","تجدّد فيها حادث وهو مخطرُ",36,"ر",1,0],["واذرع اديم فلاتها بمناسم","ما نالها وجه الصعيد مسيسا",37,"س",2,0],["واذر المدامع فالبكا من أجلهم","يحلو ويصفو بل وأنواع المحن",38,"ن",1,0],["وآَذَرْيونَهُ قَدْ شَبَّهوهُ","بِتَشْبيهٍ صَحيحٍ في المَعاني",39,"ن",2,0],["وَإِذ رفعتَ عَلى الأَعداءِ بي سَبَبا","أَخسُّ يَومَيَّ فيهِ يَوم أَنتَصِفُ",40,"ف",1,0],["واذرِ الدموع على طبيب حاذقٍ","ما كان مغلول اليدين ولا سمج",41,"ج",1,0],["وإذ رِشاق القدود يثقلها","أردافها والخصور تُخْتَصَر",42,"ر",1,0],["واذرعت في سكانها القتل كي يروا","بأني أحميها وأني أريبها",43,"ب",3,0],["وإذ رآه المؤمنون نسوا الذي","هم فيه مما نالت العينان",44,"ن",1,0],["وإذ رفعت لواء العز قال لقد","أرخت يا رافعي بشراك بالنصر",45,"ر",1,0],["وإذ راته الصكوك جاءت","مبسوطة الكف تستعين",46,"ن",1,0],["واذرفوا يا بني الجزيرة دمعا","مات من كان في الملمات قرما",47,"م",2,0],["وإِذ رأَيتُ الثريّا ضمن مبسمِهِ","قلتُ المَجرَّةُ فَبِهِ ماؤُها الخَصِرُ",48,"ر",1,0],["واذْرِفي الدمعَ بالتَّعقل واهْمِي","ماءَ حزنٍ بوجنتَيكِ انسِجاما",49,"م",2,0],["وَاذ رَآهُ مَليكَ العَصرِ ذا همم","عَلَيهِ في مُشكِلات الخَطبِ يُرتَكَن",50,"ن",1,0],["وَاذ رَآهُ الخِديوي مِثل والِدَهُ","لَم يَألُ في كَسبِ حَمد فَرط مَجهوداً",51,"د",2,0],["وآذَرَيُونٍ مثلِ خدِّ مُتَيَّمٍ","لأحشائه خوفَ الفراق وجيبُ",52,"ب",1,1],["وأذريت دمعي من جفوني كأنّه","من الدرّ سلك لم يثقبه ناظمه",53,"ه",1,0],["وأذرف دموعك أين شئت فكلها","أطلال مجد قد طوته الأعصر",54,"ر",1,0],["واذرفي هذه المدامع غزراً","هل يضير البكاء عينَ الصبيِّ",55,"ي",1,0],["وإذ رأت ما بي ولم ترث لي","حسبتها أيضا بلا قلب",56,"ب",1,0],["وإذ رأى الأم للازياء ضاحكة","وطفلها مهمل يبكي وينتحب",57,"ب",1,0],["واذري الدموع وخلني ولواعج","وحشاشتي وزفيرها الوقاد",58,"د",1,0],["وأذرت من الأجفُن الفاتراتِ","دموعاً على وجنةٍ كالدَّمِ",59,"م",1,0],["وَإِذ رَنَا قَالَ ظَبيُ الفَقرِ مِن دَهَشٍ","وَلَحظُهُ لِلظَّبَاءِ وَالمَهَا شَرَكُ",60,"ك",1,0],["وأَذرَستُ شَبَّت تُغِيرُ الخُيُول","بهِ جامحاتٍ بِتِلكَ السُّهُول",61,"ل",1,0],["وأَذرَستِ للأَرضِ مُذ صُرِعا","إِزاءَ مَحالاتِها وَقَعا",61,"ع",2,0],["وإذ روضُ الصبا غضٌّ أَنيقٌ","وأَوقاتُ الصفا صرعى تمرُّ",62,"ر",1,0],["وأذرف من جفني القريح مدامعاً","تصوب كصوب المعصرات الهواطل",63,"ل",1,0],["وإذْ راقتِ الأَبصارُ حُسنى حسانهِ","وأَطربتِ الأَسماع نجوى سميرِهِ",64,"ر",2,0],["واذ رنا للريح طرف شاخص","واحمر خدّ للحسام أسيل",65,"ل",1,0],["وأذرت على الخد در الدموع","كعقد وهي سالكاً فانتثر",66,"ر",1,0],["وَأَذْرَعُ الأَرْضَ كَالصَّيَّاْدِ مُقْتَفِياً","آثَاْرَ عَفْرَاْءَ فِي السَّاْحَاْتِº وَالسُّبُلِ",67,"ل",1,0],["وإذ راوَدتنيْ الريح عنيْ صددتها","فقُدّ قميصيْ من أمام ومن وَرا",68,"ر",2,0],["وَأذْرِفُ مِنْ عَيْنٍ عَزِيْزاً أجوْدُهُ","وَأذْكرُ خِلّاً مِنْ زَمَانٍ سَلانِيَا",69,"ي",2,0],["وإذ رفعت عنها الخمار خديجة","لتعلم ذاك الوحي حقاً أم الأغما",70,"م",2,0],["وإذ رام من جبريل أحمد صحبة","ببطن الحمى عن حظر جبريل لم يحما",70,"م",2,0],["وأذرف دمعه في كل سطر","وأهديه الفؤاد اليه نحرا",71,"ر",2,0],["وَأَذرِفُ مِنْ دُموعِ العَينِ بَحْراً","لِيَغْرقَ في مَهاويهِ الفَضاءُ",72,"ا",2,0],["وأذرف ما تواري من دموعي","وأحلامي على اللقيا تمورُ",73,"ر",1,0],["واذرف دموع الخوف معتذرا","واطلب جميل الصفح عن زلل",74,"ل",1,0],["واذرف دموعك في ربع الهوى سجَمًا","وأعزف بيَاتًا على الاوتار تلحينا",75,"ن",2,0],["واذرفْ دموعًا بالدماءِ نزيفُها","حُرقًا تؤجِّجُها بكَ الأحزانُ",76,"ن",1,0],["وأذرفت دمعة العشَّاق عن جلدٍ","وأدركُ الحبُّ بالإنكار إعصارا",77,"ر",2,0],["وإذ رآنا لم نلق خدمة","له اصطفى حورا وولدانا",78,"ن",2,0],["وإذْ رَآنا لُرَنْسٌ لا عُقولَ لنا","أتى بِكُوْفِيَّةِ الأَعرابِ مُعْتَجِرَا",79,"ر",2,0]]}