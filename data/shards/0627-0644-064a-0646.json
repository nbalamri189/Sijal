{"poems":[[53,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[23,"ألين إذا لان العشير فإن تكن","https://www.aldiwan.net/poem21400.html","الطويل"],[72,"بدت في رداء الشعر باسمة الثغر","https://www.aldiwan.net/poem18703.html","الطويل"],[85,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[28,"سما لك شوق من نوار ودونها","https://www.aldiwan.net/poem1233.html",""],[28,"وركب كأن الريح تطلب عندهم","https://www.aldiwan.net/poem1244.html",""],[28,"ألا سلت الله ابن سلتى كما نعى","https://www.aldiwan.net/poem5280.html","الطويل"],[69,"إلينا لا عدمناكم إلينا","https://www.aldiwan.net/poem28600.html","الوافر"],[31,"لقد أرسلت حولا قلبا","https://www.aldiwan.net/poem42224.html","المتقارب"],[31,"أرقت فلم أنم طربا","https://www.aldiwan.net/poem42646.html","مجزوء الوافر"],[105,"ركدت وهبت لوعة الحزن تدأب","https://www.aldiwan.net/poem42108.html","الطويل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[15,"ألين إذا لان الغريم وألتوي","https://www.aldiwan.net/poem45249.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85494","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42728","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[109,"بكر..بكر","https://www.poetsgate.com/ViewPoem.aspx?id=36880",""],[109,"سابع المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=36761",""],[28,"لئن صبر الحجاج ما من مصيبة","https://www.poetsgate.com/ViewPoem.aspx?id=2459",""],[161,"أعن ملل خيالك لا يطيف","https://www.aldiwan.net/poem58766.html","الوافر"],[166,"إذا فارقت ثعلبة بن سعد","https://www.aldiwan.net/poem731.html",""],[211,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[264,"إذا ذكرت أمامة فرط حولٍ","https://www.aldiwan.net/poem449.html",""],[271,"تنفست الظبية النافره","https://www.aldiwan.net/poem35370.html","المتقارب"],[283,"يا صاح أيقظ راقد العود","https://www.aldiwan.net/poem32809.html","السريع"],[291,"حننت إلى الوادي إلى مسرح الصبا","https://www.aldiwan.net/poem11678.html","الطويل"],[299,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[301,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[305,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[323,"ألا طرقتنا بالقرينين موهنا","https://www.aldiwan.net/poem56343.html","الطويل"],[350,"يمثل هوى قلبي يليق التبهرج","https://www.aldiwan.net/poem15556.html","الطويل"],[350,"إلى نار سوى نار","https://www.aldiwan.net/poem15743.html","الهزج"],[378,"نفس غدت قد عصاك أسهلها","https://www.aldiwan.net/poem59283.html","المنسرح"],[380,"ترعى الى جد لها مكين","https://www.aldiwan.net/poem4587.html","الرجز"],[417,"أما والعين تبكيها طلول","https://www.aldiwan.net/poem53867.html","الوافر"],[438,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[450,"الجود والمجد","https://www.aldiwan.net/poem973.html",""],[459,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[459,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[459,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[459,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[462,"الين لداود الحديد كرامة","https://www.aldiwan.net/poem15338.html","الطويل"],[465,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[501,"محمد مثالها الفرداني","https://www.aldiwan.net/poem37767.html","الرجز"],[507,"إلينا اقصدوا يا معشر الركب إننا","https://www.aldiwan.net/poem2384.html","الطويل"],[515,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[537,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[552,"سلام على العمل الصالح","https://www.aldiwan.net/poem47889.html","المتقارب"],[565,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[576,"يا غصن بان إن لي غصن آس","https://www.aldiwan.net/poem2927.html","السريع"],[587,"ألين فيقسو ثم أرضى فيحقد","https://www.aldiwan.net/poem17480.html","الطويل"]],"verses":[["أَلينُ عَن ذِلَّةٍ وَمِثلِيَ مَن","وَلّى المَقاديرَ جانِباً خَشِنا",0,"ن",2,0],["أَلينُ لِصَعبِ الخُلقِ قاسٍ فُؤادُهُ","وَأُعتِبُهُ لَو يَرعَوي مَن يُعاتَبُ",1,"ب",1,0],["إِلى نَضوَةٍ عَوجاءَ وَاللَيلِ مُغبِشٌ","مَصابيحَهُ مِثلَ المَها وَاليَعافِرِ",2,"ر",1,0],["أَلينُ إِذا لانَ العَشيرُ فَإِن تَكُن","بِهِ جِنَّةٌ فَجِنَّتي أَنا أَقدَمُ",3,"م",1,1],["إلى ناصرٍ من ناصرٍ وكذا على","مدى جدّه المنصور مسترسل النصر",4,"ر",1,0],["أَلينُ مِن صَمصامةٍ وَأَقطَعُ","لا يَعرِفُ الرَحمَةَ حِينَ يُقطَعُ",5,"ع",1,0],["إِلَينا فَباتَت لا تَنامُ كَأَنَّها","أُسارى حَديدٍ أُغلِقَت بِدِمائِها",6,"ا",3,0],["إِلى نارِ ضَرّابِ العَراقيبِ لَم يَزَل","لَهُ مِن ذُبابَي سَيفِهِ خَيرُ حالِبِ",7,"ب",1,0],["إِلَينا بِمَختومٍ عَلَينا مُؤَجَّلاً","لِيُبلِغَناها عاشَ في الناسِ أَجدَعا",8,"ع",2,0],["إلينا لا عدمناكُم إلينا","فمملكةُ الشمالِ بلا يمينِ",9,"ن",1,1],["إِلَينا عِشاءً بِأَن قِف لَنا","نُسَلِّم فَإِنَّ وُقوفاً طَفيفُ",10,"ف",1,0],["إِلى نَفسي وَأَوجَهِهِم","وَإِن أَمسى قَدِ اِحتَجَبا",11,"ب",2,0],["إلينا شَبابَ النّيلِ لا تَعْدِلوا بنا","فلا القاعُ غَرّارٌ ولا البرقُ خُلَّبُ",12,"ب",1,0],["إلينا إن نَقِمتِ الغَدرَ منهم","وأنكرتِ التَّجهُّم والصُّدودا",13,"د",2,0],["أَلينُ إِذا لانَ الغَريمُ وَأَلتَوي","إِذا اِشتَدَّ حَتّى يُدرِكَ الدَينَ قاتِلي",14,"ي",1,1],["إلينا اِلتفت يوماً من الدهر واِبتسم","بأوجهنا يا علم فالجهل عابِس",15,"س",1,0],["إِلَى نِسْوَةٍ مِثْلِ الْجُمَانِ تَنَاسَقَتْ","فَرَائِدُهُ حُسْنَاً وَأَلَّفَهُ الشَّمْلُ",16,"ل",1,0],["إِلى نُجُومٍ عَزَّ إِحْصَاؤُهَا","مِنْ قَادَةٍ غُرٍ وَمِنْ عَسْكَرِ",17,"ر",1,0],["إِلَى نِهَايَةِ مَا فِي الجِسْمِ مِنْ رَمَقٍ","كَافَحْتِ فِي جَلَدٍ عَنْهَا وَفِي دَأَبِ",18,"ب",1,0],["الين صرنا بس \"فضاضة نزاع","نفكر نعيش..ونموت بلافكر",19,"ر",1,0],["ألين جت ليله عن ألفين ليله","وصارت حكايه غير كل الحكايات",20,"ت",1,0],["ألَيْنَا بِمَخْتُومٍ عَلَيْها مُؤجَّلاً","ليُبْلِغَناها، عاشَ في الناسِ أجدَعا",21,"ع",2,0],["الين لها وأخفض من عتابي","وحظي عندها الخلق العنيفُ",22,"ف",1,0],["إلى نسب كريم غير دغل","وحي من كارم كل حيّ",23,"ي",1,0],["الى نحوه فاعطف اذا رمت نائلا","ودع عنك زيد في الانام ودع عمرا",24,"ر",2,0],["ألينُ لهُم وأفديهم بِنَفسي","مقارشةَ الرِّماحِ إذا لقيتُ",25,"ت",1,0],["إلى نزهةٍ ذهبت بكرةً","فما أجملَ المعصرَ الباكره",26,"ر",2,0],["إِلى نَداهُ وَإِلى مَدحِهِ","نَضرِبُ آباطَ المَقاحيدِ",27,"د",1,0],["إلى نسمات الروض تعبق في الدجى","وتحمل عطر الزهر للهالئم الصبّ",28,"ب",1,0],["إلى نغم الشادي يغني بليلة","منعّمَةٍ لحن الصبابة والحب",28,"ب",1,0],["إلى نادٍ يضمُّ دمى وعينا","وإذْ أَنَّ السُّرى منّا عنيق",29,"ق",1,0],["إِلى نِسوَةٍ مَنَّينَها بِمُثَقَّبٍ","أَمانِيَّ لا يُجدينَ عَنكَ حَبَربَرا",30,"ر",2,0],["إلى نور إسلام وعلم وحكمة","ويمن وإيمان وخير الأوامر",31,"ر",1,0],["أَلِينُ لِمَن صادَقتُ مِن حُسنِ شيمَتي","وَأَكحَلُ مِن عاديتُ بِالكُحُلِ المَض",32,"ض",1,0],["إِلى نَجدِهِ أَمسَيتُ بِالوَجدِ عارَجاً","وَفي المُنحَنى العُذالُ بِالغَورِ عَرَّجوا",33,"ج",3,0],["إِلى نارٍ سِوى نارِ","كَ ذو العَينَينِ لا يَعشو",34,"ش",2,1],["إلى نعيمٍ يزين موردُه","جمالَها والجمال مُجمِلُها",35,"ل",3,0],["الى نقاوى أمعز الدفين","متى ينازعهن في الأرين",36,"ن",1,0],["ألينُ وأشتكي منها فتقسو","فكم تقسو عليَّ وكم ألين",37,"ن",1,0],["إلى نوالك أضحى منتهى أملى","يقودني وإلى علياك مقصودي",38,"د",2,0],["إلى نخيل وأشجار وفاكهة","قطوفها التين والأعناب والرطب",39,"ب",1,0],["إلى ناصر الدين امتطى كاهلَ المنى","خليقٌ بغايَات النجاح قمينُ",40,"ن",1,0],["ألينُ وتُغري بالإباء كأنما","تبَرُّ بهجراني أليَّة حالفِ",41,"ف",1,0],["أُلينَ عليك مُعجَمُها المُعاصِي","وخَفَّ إليك مجلسُها الوقورُ",42,"ر",1,0],["إلى نادٍ تفوه به وتغشَى","وسامرةٍ يُشَبُّ لها وَقودُ",43,"د",1,0],["اُلِينَ لداود الحديدُ كرامةً","يقدِّر منه السَّرد كيف يريد",44,"د",1,1],["إلى ندى هبةِ الله ارتمت هممٌ","هيمٌ إلى مننٍ ما شأنها منن",45,"ن",1,0],["إلى نَسيقِ ميمِ مَجراها الَّذي","طافَ بمرساها على الأَكْوانِ",46,"ن",1,0],["إلينا اقصدوا يا معشر الركب إننا","نرى العار أن نمسي بغير وفود",47,"د",1,1],["إلى نخلِ النّخيل تحنّ شوقاً","وترزُمُ تحتَنا خوصُ الرِّكابِ",48,"ب",1,0],["إِلى نارٍ مُسَعَّرَةٍ","يُعالِجُ غُلَّها القَمِلا",49,"ل",2,0],["إلى نِعَمٍ ليس كالأعْطياتِ","ونافحُها ليس كالنافحِ",50,"ح",1,0],["إلينا بدت في بعثه لم تزل بها","إلى العالم الأخبار تروى وتنقل",51,"ل",1,0],["أَلينُ عطْفاً منك معْ خُضْرةٍ","فيه وأَنفاسٌ كأَنفاسِ كَاسْ",52,"س",1,0],["أَلينُ فَيَقْسُو ثُمَّ أَرْضَى فَيحْقِدُ","وَأَشْكُو فَلا يُشْكَى وأَدْنُو فَيبْعِدُ",53,"د",1,1]]}