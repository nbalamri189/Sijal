om/ViewPoem.aspx?id=180552",""],[4849,"مشكور يا أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=53502",""],[4860,"لأول مره بكتبها","https://www.poetsgate.com/ViewPoem.aspx?id=32387",""],[4869,"جووووز","https://www.poetsgate.com/ViewPoem.aspx?id=151636",""],[4869,"الحشيمه","https://www.poetsgate.com/ViewPoem.aspx?id=151642",""],[5031,"خيمة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=165140",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[592,"هو الله معبود الورى فله الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=128841",""],[5344,"ربعي بني وايل ( قبيلة عنزه )..","https://www.poetsgate.com/ViewPoem.aspx?id=180837",""],[5431,"مصر...والرؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=197044",""],[5431,"لقد آنس الأرواح حزنٌ مقعرُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198970",""],[5455,"في خاطري كلمتين","https://www.poetsgate.com/ViewPoem.aspx?id=34366",""],[5652,"لا ترتجي للي قضى ف ابن عمه !!","https://www.poetsgate.com/ViewPoem.aspx?id=177736",""],[5652,"حب الرعاييب","https://www.poetsgate.com/ViewPoem.aspx?id=206702",""],[5727,"الهوى الجنوبي","https://www.poetsgate.com/ViewPoem.aspx?id=205798",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5848,"سيجارة فوق طفايه","https://www.poetsgate.com/ViewPoem.aspx?id=48904",""],[5893,"جدة مآآآآسي غير","https://www.poetsgate.com/ViewPoem.aspx?id=141386",""],[5956,"وداعاً لعهد وداد العيون ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181956",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6113,"احلام","https://www.poetsgate.com/ViewPoem.aspx?id=12874",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6213,"بحار الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85491&r=&rc=94",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""],[463,"يزوِّرُ عنْ حسناءَ زورة َ خائفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60142&r=&rc=198",""],[557,"أحزان مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67203&r=&rc=65",""],[4222,"أجيران جيرون مالي مجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52786&r=&rc=78",""],[5567,"ناسكة الأسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81812&r=&rc=62",""],[6359,"عمّان البلد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69088&r=&rc=2",""]],"verses":[["أَلينُ عَن ذِلَّةٍ وَمِثلِيَ مَن","وَلّى المَقاديرَ جانِباً خَشِنا",0,"ن",2,0],["أَلينُ لِصَعبِ الخُلقِ قاسٍ فُؤادُهُ","وَأُعتِبُهُ لَو يَرعَوي مَن يُعاتَبُ",1,"ب",1,0],["إِلى نَضوَةٍ عَوجاءَ وَاللَيلِ مُغبِشٌ","مَصابيحَهُ مِثلَ المَها وَاليَعافِرِ",2,"ر",1,0],["أَلينُ إِذا لانَ العَشيرُ فَإِن تَكُن","بِهِ جِنَّةٌ فَجِنَّتي أَنا أَقدَمُ",3,"م",1,1],["إلى ناصرٍ من ناصرٍ وكذا على","مدى جدّه المنصور مسترسل النصر",4,"ر",1,0],["أَلينُ مِن صَمصامةٍ وَأَقطَعُ","لا يَعرِفُ الرَحمَةَ حِينَ يُقطَعُ",5,"ع",1,0],["إِلَينا فَباتَت لا تَنامُ كَأَنَّها","أُسارى حَديدٍ أُغلِقَت بِدِمائِها",6,"ا",3,0],["إِلى نارِ ضَرّابِ العَراقيبِ لَم يَزَل","لَهُ مِن ذُبابَي سَيفِهِ خَيرُ حالِبِ",7,"ب",1,0],["إِلَينا بِمَختومٍ عَلَينا مُؤَجَّلاً","لِيُبلِغَناها عاشَ في الناسِ أَجدَعا",8,"ع",2,0],["إلينا لا عدمناكُم إلينا","فمملكةُ الشمالِ بلا يمينِ",9,"ن",1,1],["إِلَينا عِشاءً بِأَن قِف لَنا","نُسَلِّم فَإِنَّ وُقوفاً طَفيفُ",10,"ف",1,0],["إِلى نَفسي وَأَوجَهِهِم","وَإِن أَمسى قَدِ اِحتَجَبا",11,"ب",2,0],["إلينا شَبابَ النّيلِ لا تَعْدِلوا بنا","فلا القاعُ غَرّارٌ ولا البرقُ خُلَّبُ",12,"ب",1,0],["إلينا إن نَقِمتِ الغَدرَ منهم","وأنكرتِ التَّجهُّم والصُّدودا",13,"د",2,0],["أَلينُ إِذا لانَ الغَريمُ وَأَلتَوي","إِذا اِشتَدَّ حَتّى يُدرِكَ الدَينَ قاتِلي",14,"ي",1,1],["إلينا اِلتفت يوماً من الدهر واِبتسم","بأوجهنا يا علم فالجهل عابِس",15,"س",1,0],["إِلَى نِسْوَةٍ مِثْلِ الْجُمَانِ تَنَاسَقَتْ","فَرَائِدُهُ حُسْنَاً وَأَلَّفَهُ الشَّمْلُ",16,"ل",1,0],["إِلى نُجُومٍ عَزَّ إِحْصَاؤُهَا","مِنْ قَادَةٍ غُرٍ وَمِنْ عَسْكَرِ",17,"ر",1,0],["إِلَى نِهَايَةِ مَا فِي الجِسْمِ مِنْ رَمَقٍ","كَافَحْتِ فِي جَلَدٍ عَنْهَا وَفِي دَأَبِ",18,"ب",1,0],["الين صرنا بس \"فضاضة نزاع","نفكر نعيش..ونموت بلافكر",19,"ر",1,0],["ألين جت ليله عن ألفين ليله","وصارت حكايه غير كل الحكايات",20,"ت",1,0],["ألَيْنَا بِمَخْتُومٍ عَلَيْها مُؤجَّلاً","ليُبْلِغَناها، عاشَ في الناسِ أجدَعا",21,"ع",2,0],["الين لها وأخفض من عتابي","وحظي عندها الخلق العنيفُ",22,"ف",1,0],["إلى نسب كريم غير دغل","وحي من كارم كل حيّ",23,"ي",1,0],["الى نحوه فاعطف اذا رمت نائلا","ودع عنك زيد في الانام ودع عمرا",24,"ر",2,0],["ألينُ لهُم وأفديهم بِنَفسي","مقارشةَ الرِّماحِ إذا لقيتُ",25,"ت",1,0],["إلى نزهةٍ ذهبت بكرةً","فما أجملَ المعصرَ الباكره",26,"ر",2,0],["إِلى نَداهُ وَإِلى مَدحِهِ","نَضرِبُ آباطَ المَقاحيدِ",27,"د",1,0],["إلى نسمات الروض تعبق في الدجى","وتحمل عطر الزهر للهالئم الصبّ",28,"ب",1,0],["إلى نغم الشادي يغني بليلة","منعّمَةٍ لحن الصبابة والحب",28,"ب",1,0],["إلى نادٍ يضمُّ دمى وعينا","وإذْ أَنَّ السُّرى منّا عنيق",29,"ق",1,0],["إِلى نِسوَةٍ مَنَّينَها بِمُثَقَّبٍ","أَمانِيَّ لا يُجدينَ عَنكَ حَبَربَرا",30,"ر",2,0],["إلى نور إسلام وعلم وحكمة","ويمن وإيمان وخير الأوامر",31,"ر",1,0],["أَلِينُ لِمَن صادَقتُ مِن حُسنِ شيمَتي","وَأَكحَلُ مِن عاديتُ بِالكُحُلِ المَض",32,"ض",1,0],["إِلى نَجدِهِ أَمسَيتُ بِالوَجدِ عارَجاً","وَفي المُنحَنى العُذالُ بِالغَورِ عَرَّجوا",33,"ج",3,0],["إِلى نارٍ سِوى نارِ","كَ ذو العَينَينِ لا يَعشو",34,"ش",2,1],["إلى نعيمٍ يزين موردُه","جمالَها والجمال مُجمِلُها",35,"ل",3,0],["الى نقاوى أمعز الدفين","متى ينازعهن في الأرين",36,"ن",1,0],["ألينُ وأشتكي منها فتقسو","فكم تقسو عليَّ وكم ألين",37,"ن",1,0],["إلى نوالك أضحى منتهى أملى","يقودني وإلى علياك مقصودي",38,"د",2,0],["إلى نخيل وأشجار وفاكهة","قطوفها التين والأعناب والرطب",39,"ب",1,0],["إلى ناصر الدين امتطى كاهلَ المنى","خليقٌ بغايَات النجاح قمينُ",40,"ن",1,0],["ألينُ وتُغري بالإباء كأنما","تبَرُّ بهجراني أليَّة حالفِ",41,"ف",1,0],["أُلينَ عليك مُعجَمُها المُعاصِي","وخَفَّ إليك مجلسُها الوقورُ",42,"ر",1,0],["إلى نادٍ تفوه به وتغشَى","وسامرةٍ يُشَبُّ لها وَقودُ",43,"د",1,0],["اُلِينَ لداود الحديدُ كرامةً","يقدِّر منه السَّرد كيف يريد",44,"د",1,1],["إلى ندى هبةِ الله ارتمت هممٌ","هيمٌ إلى مننٍ ما شأنها منن",45,"ن",1,0],["إلى نَسيقِ ميمِ مَجراها الَّذي","طافَ بمرساها على الأَكْوانِ",46,"ن",1,0],["إلينا اقصدوا يا معشر الركب إننا","نرى العار أن نمسي بغير وفود",47,"د",1,1],["إلى نخلِ النّخيل تحنّ شوقاً","وترزُمُ تحتَنا خوصُ الرِّكابِ",48,"ب",1,0],["إِلى نارٍ مُسَعَّرَةٍ","يُعالِجُ غُلَّها القَمِلا",49,"ل",2,0],["إلى نِعَمٍ ليس كالأعْطياتِ","ونافحُها ليس كالنافحِ",50,"ح",1,0],["إلينا بدت في بعثه لم تزل بها","إلى العالم الأخبار تروى وتنقل",51,"ل",1,0],["أَلينُ عطْفاً منك معْ خُضْرةٍ","فيه وأَنفاسٌ كأَنفاسِ كَاسْ",52,"س",1,0],["أَلينُ فَيَقْسُو ثُمَّ أَرْضَى فَيحْقِدُ","وَأَشْكُو فَلا يُشْكَى وأَدْنُو فَيبْعِدُ",53,"د",1,1],["إِلَى نَهْيَان نِسْبَتُهُ تَنَاهَتْ","وَمِنْ نَهْيَانَ مَكْرُمَةٌ وَلُودُ",54,"د",1,0],["إلى نجل إبراهيم من طاب عنصراً","وفاق صفاء عن أصول تكدرت",55,"ت",1,0],["إلينا يا ابن توفيقٍ إلينا","حميد العود مرجوَّ الأناة",56,"ه",1,0],["ألينُ ويقسو مثلَ ما لنتُ كُلَّما","قَسَتْ عن قبولِ الماءِ مَلْمُومَةُ الصَّخْر",57,"ر",1,0],["إِلى نَجدَةِ العَلياءِ يَسطو بِصارِمٍ","تَعَوَّدَ في الآسادِ للقَطِّ والقَدِّ",58,"د",1,0],["إلى نَهْيان يُنْسَبُ كل فخرٍ","ولا عَجَبٌ طَريف عن تلادِ",59,"د",1,0],["إلَى نَحْوِ مَنْ فَوْقَ السَّموَاتِ قَدْ سَمَا","وَلَوْلاَهُ مَا اشْتَقْتُ الْحَطِيمَ وَزَمْزَمَا",60,"م",2,0],["إلى نَحْوِ مَنْ فَازَتْ بِهِ خَيْرُ أُمَّةٍ","لَقَدْ خَصَّهُ الْمَولى بِعِزِّ وَرِفْعَةٍ",61,"ه",1,0],["إلَى نَحْوِ مَنْ أَرْجُو بِهِ حَلَّ عَاقَتي","ذَخَرْتُ مَدِيحِي فِيهِ يَبْقى لِفَاقَتي",62,"ي",1,0],["إلىَ نَحْوِ وَادِي الْخَيْفِ تَرْنُو عُيُونُهَا","قَوَائِمُهَا تَشْكُو الْوَجى وَجُفُونُهَا",63,"ه",2,0],["إلى نصر الإله وأن يكونوا","متى يدعون أنصار الإِمام",64,"م",1,0],["إِلى ناعم البردىِّ وسط عيونه","علاجيمُ جونٌ بين صُدٍّ ومحفلِ",65,"ل",1,0],["أَلينة عطفا وَقاسية قَلبا","وَناطِقة قرطا وَصامِتَة قَلبا",66,"ب",2,1],["إِلى نَبعَةٍ فَرعُها في السَّماء","ومَغرِسُها سُرَّةُ الأبطَحِ",67,"ح",1,0],["الينا فقد طال التعدي من العدا","جناني مكسور وحالي في ردا",68,"د",2,0],["ألينُ له إن جفا","وأعذره إن غدر",69,"ر",1,0],["إلى نظرة الرحمن تحت جماله","أبث اضطراراً طارقاتي وشقوتي",70,"ي",1,0],["إِلى نَجيبٍ في بَيتِ مَملَكَةٍ","يَكنُفُهُ سادَةٌ مَناجيبُ",71,"ب",1,0],["الى نيل العلى قومى نهوضاً","فقد طال احتمالكم الأذيه",72,"ي",2,0],["إلى نافِعٍ لا نَرتجي ما أَصابَنا","تحومُ عَلَينا السانِحاتُ وتبرَحُ",73,"ح",1,0],["الى نسب لهم بلغوا ادعاء","به اذواء حمير او نزارا",74,"ر",2,0],["إِلى نَصرٍ وَأَيُّ فَتىً كَنَصرِ","إِذا حَلَّت بِمَغناه الرِكابُ",75,"ب",1,0],["إِلى نَبيٍّ رأى ما لا رأى مَلِكٌ","وَقامَ حَيثُ أَمينُ الوَحي لَم يَقُمِ",76,"م",1,0],["ألينُ فيقسو ثم أدنو فينْتوي","وأشكو له حُزني فيفترُّ جذلانا",77,"ن",2,0],["ألينُ فتقسو يا ظَلومُ جوانحاً","وأدنو فتنأى ثمَّ أرضى فتَغضَبُ",78,"ب",1,0],["إِلى نَهرِ عيسى حَيثُ حَلَّت رِكابُهُم","وَحَيثُ الخِيامِ البيضِ مِن جانِبِ الفَمِ",79,"م",1,0],["إلى نخله فاحكم بتضمين آمر","وإن كان ذا عقل كبيرا فلا بدي",80,"د",2,0],["إِلى نادِرَةِ العَصرِ","وعِلمِ النّظمِ والنَثر",81,"ر",1,1],["إلى نحوها حملته نسمة الصبا","لتكسب وصفا من شذا ذلك الوصف",82,"ف",1,0],["إلى نحوى أشارت بالسلام","فاعثرت اللسان عن الكلام",83,"م",1,1],["إلى نضدٍ من عبد شمس كأنهم","هضاب أجاً أركانها لم تقصف",84,"ف",1,0],["أَلينُ لِذي القُربى مِراراً وَتَكتَوي","بِأَعناقٍ أَعدائي حِبالٌ تَمَرَّسُ",85,"س",1,0],["الى نزعها أسعى حثيثاً وإن أكن","أحسُّ بنزع الروح ساعة نزعها",86,"ع",3,0],["إلى نادي الذينَ إذا يُنادى","بهم لبِسوا القلوبَ على الدّروع",87,"ع",1,0],["إِلى ناصِرِ الدينِ البَهائي شَيخِنا","إِلى مُكرِمِ الوُفّادِ في زَمَنِ القَحطِ",88,"ط",1,0],["الى نجوم صور الجنوب","فنذكر الكل على الترتيب",89,"ب",1,0],["إِلى ناعِجٍ أَما أَعالي عِظامِهِ","فَشُمٌّ وَسُفلاها عَلى الأَرضِ تَمهَرُ",90,"ر",1,0],["إِلَى نيلِ العُلى كم من رسومِ","قَطَعْنا بالسُّرَى ولكَم تَخُومِ",91,"م",1,1],["إِلى ناريهِما وَهُما قَريبٌ","تَشوقانِ المُحِبَّ وَتوقَدانِ",92,"ن",1,0],["ألِينُ على منافسةِ المُصَافي","وليسَ يروقُني مَلَقُ المُداجي",93,"ج",2,0],["إِلى نهضة بالشعب قبل مماته","إِلى قطع أَسباب الهَلاك المهدد",94,"د",1,0],["أَلينُ إِذا اِشتَدَّ الغَريمُ وَالتَوى","اذا لانَ حَتّى يُدرِكَ الدينَ قابِلي",95,"ل",2,0],["إِلى نَفَرٍ حَولَ النَبيِّ بُيوتُهم","مَكاريمُ لِلعافي رِقاقُ المآزِرِ",96,"ر",1,0],["إلى نجاة الروح فهو المهدي","ثم الصلاة والسلام الأسنى",97,"ن",2,0],["إلى نارها مذ عشت مقلتي","وغبت عن الحس في حضرتي",98,"ي",1,0],["إلى ناسِ باناس ليس صَبْوةٌ","لها الوجدُ داعٍ وذكرى مُثيرُ",99,"ر",1,0],["إِلى نَدوة كَمَطيف الرَجاء","منضرة كَبَليغ الكلم",100,"م",1,0],["ألينُ لأحبابي وأخضع طالباً","رضاها وبي يعتاضُ ضيفي عن العبد",101,"د",1,0],["إلينا آتى من دار هجرته إلى","ديارٍ له فيها أعدَّت ممالك",102,"ك",1,0],["إلى نبأ في البرايا عظيمٍ","وكلُّ عظيم عظيمُ النَّبا",103,"ب",2,0],["إلى نضارة أرواح لنا اتسختْ","من بعدِ نضرتها فيها الضنى اتقدا",104,"د",2,0],["الين قلبي للخطر دق ناقوس","والفكر كنه يلحسه بالملاحيس",105,"س",1,0],["إلى نردين بستانه ونيزك جوّه المخروت","إلى السلوان من بعده إلى الدعوة إلى التسميت",106,"ت",1,0],["الين قدهم نقطتين بالانظار","نقبض اغترنا لا تطيح بيدينا .",107,"ن",2,0],["إلين صار الصمت أربع جهاتي","بالذات لامن صرت مع واحد أغليه",108,"ي",2,0],["ألين اليوم يوم إني تجارت ضدي أسيوفي","تذكرتك أيا عزوه على غيري توزعها",109,"ع",3,0],["ألين صآر البعد يازين مايجوز","ولايجوز بيني وبين روحك مسآفه",110,"ف",2,0],["ألين ما صبح الغلا داخلك مآع","واطفيت هالدنيا بهرج اللئيمه",111,"م",2,0],["إلِى نَخلَةٍ فِي الدَّارِ كَانَتْ تُظِلُّني","تَلألأ في رُوْحي وَفِي عِذْقِها التَّمْرُ",112,"ر",1,0],["إلي نور مجد الدين والسيد الذي","إليه يؤول المجد حيث يؤول",113,"ل",1,0],["إلي ناصر الإسلام إن تبد عثرة","به فهو من دون الأنام مقيل",113,"ل",1,0],["إلينا يداً بل لو تزيل بعضهم","لأبصرنا من بين أيديهمو تعد",114,"د",1,0],["إلين صرنا بالأراضي كما الناب","في فك سبعن تعجز فهود صده",115,"د",2,0],["الى نجمها أرنو سليل حضارة","أنيرت به الأكوان دهرا ولن يكبو",116,"ب",2,0],["إلينا أبا الزهراء غيثا ورحمة","لقد آنس الأرواح حزنٌ مقعرُ",117,"ر",1,0],["إلين ما أوحيت لي صوت يناديني","صوت أعرفه مثل ما أجهل وش خلافي",118,"ف",2,0],["الي نوى للفايده ياخذ فلوس","بكرا يطيح ،،،، ولا لقى من يلمه !!",119,"م",2,0],["ألين حظي ممتلي به عذاريب","متعومسن مايوم