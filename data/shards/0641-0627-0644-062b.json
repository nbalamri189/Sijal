{"poems":[[53,"أعانقها والنفس بعد مشوقة","https://www.aldiwan.net/poem66429.html","الطويل"],[93,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[93,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[64,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[46,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[77,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1312","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[96,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[96,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[234,"شغلت بخلسة المقل","https://www.aldiwan.net/poem50846.html","مجزوء الوافر"],[236,"رعى الله بالبطحاء أيامنا التي","https://www.aldiwan.net/poem44565.html","الطويل"],[240,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[275,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[287,"قد أجمد الخمر كانون بكل قدح","https://www.aldiwan.net/poem32821.html","البسيط"],[302,"مثال نعل رسول الله ذي الكرم","https://www.aldiwan.net/poem33178.html","البسيط"],[308,"يا سيدا رب العلا","https://www.aldiwan.net/poem57736.html","مجزوء الرجز"],[422,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[438,"هذا زمان عليه","https://www.aldiwan.net/poem12676.html","المجتث"],[447,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[447,"أذاب فؤادي ذكر ليلى ومن لها","https://www.aldiwan.net/poem14324.html","الطويل"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[505,"جرد لبر الشرق همة زائر","https://www.aldiwan.net/poem38011.html","الكامل"],[505,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[556,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138219",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87216","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44558","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62596","المجتث"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96629","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80029","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49586","البسيط"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128777","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123114","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28574","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106901","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128228","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91255","الوافر"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199030","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86524","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114430","الوافر"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107493","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136917",""],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127242","الرمل"],[4392,"","https://poetry.dctabudhabi.ae/diwan/poem/101564","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104515","الرمل"],[4858,"صبراً أحبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=35641",""],[4898,"يوم عاصف .","https://www.poetsgate.com/ViewPoem.aspx?id=35812",""],[585,"يا وامض البرق بالأنباء تبتدر","https://www.poetsgate.com/ViewPoem.aspx?id=161890",""],[5085,"قالت لنا","https://www.poetsgate.com/ViewPoem.aspx?id=188399",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5198,"قلادة","https://www.poetsgate.com/ViewPoem.aspx?id=136232",""],[5376,"كلٌّ يغني على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188474",""],[5410,"وَكُوْنِي سِرَّ العَطا الزاخِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=152250",""],[5616,"إلى ممثلة","https://www.poetsgate.com/ViewPoem.aspx?id=205251",""],[5701,"تلاقينا وكان أخا بيان","https://www.poetsgate.com/ViewPoem.aspx?id=164658",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[5956,"عَبِّرْ","https://www.poetsgate.com/ViewPoem.aspx?id=184477",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""],[6189,"أحزان جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83596&r=&rc=63",""],[463,"سقى أيَّامَ رامة َ بل سقاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60273&r=&rc=329",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[422,"بوادي الغضا للمالكية أرْبُعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22255&r=&rc=11",""]],"verses":[["فألثمُ فاها كي تموتَ حزازتي","فيشتد ما ألقى من الهيمان",0,"ن",1,0],["فَاِلثُم بِروحِكَ أَرضَها تَلثُم عُصوراً","لِلعُلى سَكَنَت حَصى وَتُرابا",1,"ب",2,0],["فَاِلثُمي كُلَّ زَهرَةٍ فيهِ إِنّي","كُنتُ أَهوى زُهورَهُ وَغُصونَه",2,"ن",2,0],["فالثمْ ثرى جَيَّ إنْ وافيتَها سَحَراً","واقْرَأْ سلامي على أهلي وجيراني",3,"ن",2,0],["فَالثَغرُ وَالساكِنوهُ لا يَؤودُهُمُ","ما عِشتَ فيهِم أَطارَ الدَهرُ أَم دَرَجا",4,"ج",2,0],["فالثِّقْلُ للبازلِ في سِنّهِ","والقَتَبُ الهَفْهَافُ للحِقِّ",5,"ق",1,0],["فَالثِقلُ لَيسَ مُضاعَفاً لِمَطِيَّةٍ","إِلّا إِذا ما كانَ وَهماً بازِلا",6,"ل",2,0],["فَالثَواب قالَ غَداً","تَشتَفي بِمنظَرِها",7,"ر",3,0],["فالثُكْلُ والعَيْشُ السَويُّ سَويةٌ","ودَمُ الضحايا والحياةُ تُؤام",8,"م",1,0],["فالثم ثراه فقد لثمت خميلة","للمكرمات وقد شممت عبيرا",9,"ر",2,0],["فالثم ثراه فقد لثمتَ خميلةً","للمكرمات وقد نشقتَ عبيرا",10,"ر",2,0],["فألثَمَني حَصَى بَرَدٍ","تَفَجَّرَ مِن جَنَى عسل",11,"ل",1,0],["فألثم إجلالا ثراها وأجتلي","شموسي في أرجائها وأهلتي",12,"ت",2,0],["فَاِلثِم ثَراهُ مُعَفِّراً","خَدَّيكَ في تِلكَ المَواقِفِ",13,"ف",1,0],["فالثغرُ من لُبنانَ يحكي نورَهُ","والخدُّ يحوي وردةً من تونُس",14,"س",1,0],["فَالثَلجُ قُطنٌ عَلَيكِ السُّحبُ تَحلُجُهُ","وَالجَوُّ نَدّافُهُ وَالقَوسُ قَوسُ قُزَح",15,"ح",1,0],["فاِلثمهُ لثم محبٍّ لم يفُز بِلقا","حَبيبه فرأى الآثارَ للقدَمِ",16,"م",1,0],["فالثلث منه سورةٌ","آياتها مشرفه",17,"ف",2,0],["فألثم أقدام الوزير التي لها","إلى غاية الغايات ممشًى ومهيع",18,"ع",1,0],["فالثغْرُ قد عاد مِصْراً","ويوسُفُ المَلْكُ يوسُفْ",19,"ف",1,0],["فالثور يحمل هذي الأرض وهو على","صخر على الحوب فوق الماء ما غرقا",20,"ق",2,0],["فألثم خديها وأرشف ظلمها","وألزم عطفيها وأمسح خدها",21,"ه",2,0],["فألثِمُ في السِّرار تريبتيها","ومن لي لو تكون الأذنُ فاها",22,"ا",3,0],["فالثِمْ ثَرى تِلكَ البِقاعِ تأدُّباً","وقُلِ السَّلامُ على الشَّريفِ الطَّاهِرِ",23,"ر",1,0],["فالْثِمِ الأَعتابَ وادخلْ خاشِعاً","حضرَةَ الغَوْثِ الكبيرِ القُطُبِ",24,"ب",1,0],["فالثِّقْلُ لا يسطيعه من شارفٍ","كوماءِ إلّا غاربٌ وسنامُ",25,"م",1,0],["فالثابتون لحرها ولهيبها","يغدون بعد النار إبريزاً وهج",26,"ج",1,0],["فَالثم مع الإقبال راحته الَّتي","شادَت عَلى متن العُلا بنيانيه",27,"ن",3,0],["فَالثَوبُ يَنفُذُ صِبغُهُ","فيما يَليهِ مِنَ الثِيابْ",28,"ب",1,0],["فالثور يصب إن يَلْ","قَ في النطاح وقاذا",29,"ذ",2,0],["فَاِلثم بساطَ الدست بي","نَ يديهِ واِخضع واِسجدِ",30,"د",1,0],["فالثلم والتشعيث مثل الخرم","في صدره وغيرها في الختم",31,"م",1,0],["فالثرى يُنبتُ ورداً طيبا","وصريماً ليس بالمنتشق",32,"ق",1,0],["فالثاكل الدينُ والمثكولُ شخصك وال","ناعي الهُدى والمعزِّي خاتمُ العلما",33,"م",2,0],["فالثمْ أنَامِلَهُ عنْ خاطِري وَفَمي","واشكرْهُ عنّي وعنْ إحسانه قِبَلي",34,"ل",2,0],["فالثرى من دم الجفون نديٌّ","وفؤَادي من خده في شواظ",35,"ظ",1,0],["فالثغر كأس والرضاب رحيقه","والخال مسك خِتامه العبّاق",36,"ق",1,0],["فَأَلثَمَني وَاللَّيلُ بَيني وَبَينَهُ","غُروبُ أَقاحٍ ظُلمُهُنَّ شَمولُ",37,"ل",1,0],["فالثم ما استرخى عليَّ وأنثني","وبي من غوالي نشره سكرات",38,"ت",1,0],["فالثم الأرض خاضعاً فلقد","نلت والله خير إسعاد",39,"د",1,0],["فالثم الأرض خاضعاً ولهاً","واخلع النعل انّه الوادي",39,"د",2,0],["فَأَلثم حين تَأتي الأَرض بشراً","وَأَقنع في المَحبة بافتضاحي",40,"ح",2,0],["فالثغر الأعلى ثار فيه منذر","ثم ابن هود بعد فيما يذكر",41,"ر",1,0],["فالثغر يلقي في الهلاك قرينه","والمضر يلحق ذاهب الأمصار",42,"ر",1,0],["فألثمها فتمنع فاستنبنا","مكانَ الوردِ ثغرَ الاقحوانِ",43,"ن",1,0],["فألثمُ ذيّاك الثرى متأدباً","وأجثو لديه خاشعاً مترحما",44,"م",2,0],["فالثم ما شئت لكن بعدّ","ونقد فليست تبيع بدين",45,"ن",1,0],["فالثم الترب أيا برق لدى","حضرة المولى وبلغه السلام",46,"م",1,0],["فالثاء سينٌ أبدلت والذال زا","والوقف لا تسئل عن الخلطاء",47,"ا",2,0],["فالثنايا الكاس والريقة راح","عد بها مصطبحا أو مغتبق",48,"ق",1,0],["فالثّلجُ فوقَكمُ، والجوعُ عضّكُمُ","والريحُ تَخفِقُ في بيتٍ من الوَبَرِ",49,"ر",1,0],["فالثَّلْجُ يُزْجي طَيْرَ سِحْ","رٍ أو خَيَالٍ لا يُحَدّْ",50,"د",1,0],["فالثم يميناً براها الله طاهرةً","واخشع لدى ملك في برده عمر",51,"ر",1,0],["فالثَّغرُ منها كالجِّنى وأسيلُها","زَهْرُ الرُّبى في رِقةٍ مَصْقولُ",52,"ل",1,0],["فالثبات الثبات حتى يضيق ال","موج ذرعا وتقهر الدأماء",53,"ا",2,0],["فالثلث الآخر تسّتحب المناجاة","ومغادر فراش الدفى والوسادة",54,"د",2,0],["فألثمت ثوبا عليها بعطفٍ","كأنَّ بثوبٍ يرومُ نزيلا",55,"ل",2,0],["ِفألثم ثغركِ حتى لَنغدو","كلانا كملحمةِ الثائرِ",56,"ر",1,0],["فَالثَّلْجُ آتٍ سَوْفَ يَأْكُلُهُ","وَالثَّلْجُ تَحْتَ بَيَاضِهِ الذُّعْرُ",57,"ر",1,0],["فألثم تارة خدا وثغرا","وألثم تارة نهدا ونحرا",58,"ر",2,0],["فالثور تلو الثور يؤكل بينما","تهوى الخوار بقية الثئران",59,"ن",1,0],["فالثائرون تعشَّقوا من صَرَّحوا","لم يعشقوا متمرِّسي الكِتمانِ",60,"ن",1,0],["فَالثَّرَى عِندَما تَمُرِّينَ يَقفُو","وَقعَ رِجلَيكِ؛ لَيتَنِي اليَومَ أَعرَجْ",61,"ج",1,0],["فالثَمِيها ؛ إِذا رَأَيتِ حُرُوفِي","وَ الثَمِينِي , وَ رَدِّدِي : ( هَيتَ ؛ أَهلَا )",62,"ل",2,0],["فَأَلثُمُ الخَدَّ , وَ العَينانِ تَرقُبُنِي","كَأَنَّنِي - بِجُنُونِ اللَّثمِ - مُدمِنُها",63,"ن",3,0],["فألثم جُرحي أنكفي في قصائدي","وأمضي إلى قصدي وفي القلب مصحف",64,"ف",1,0],["فألثمُ في السِّرار تربيتيها","ومن لي لو تكون الأذنُ فاها",65,"ا",3,0],["فأَلْثَمُ القَاعَ مأخوذًا بِمَوكِبَها","تَظَفَّرَ الزَّحْفُ لَمْ يَهْدَا ولَمْ يَقِفِ",66,"ف",1,0],["فألثم أقدام الوزير التي لها","إلى غابة الغابات ممشى ً ومهيع",67,"ع",1,0]]}