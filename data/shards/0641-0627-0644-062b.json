{"poems":[[51,"أعانقها والنفس بعد مشوقة","https://www.aldiwan.net/poem66429.html","الطويل"],[91,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[44,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1312","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[94,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[227,"شغلت بخلسة المقل","https://www.aldiwan.net/poem50846.html","مجزوء الوافر"],[229,"رعى الله بالبطحاء أيامنا التي","https://www.aldiwan.net/poem44565.html","الطويل"],[233,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[268,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[280,"قد أجمد الخمر كانون بكل قدح","https://www.aldiwan.net/poem32821.html","البسيط"],[295,"مثال نعل رسول الله ذي الكرم","https://www.aldiwan.net/poem33178.html","البسيط"],[301,"يا سيدا رب العلا","https://www.aldiwan.net/poem57736.html","مجزوء الرجز"],[413,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[429,"هذا زمان عليه","https://www.aldiwan.net/poem12676.html","المجتث"],[438,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[438,"أذاب فؤادي ذكر ليلى ومن لها","https://www.aldiwan.net/poem14324.html","الطويل"],[456,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[498,"جرد لبر الشرق همة زائر","https://www.aldiwan.net/poem38011.html","الكامل"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[549,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"]],"verses":[["فألثمُ فاها كي تموتَ حزازتي","فيشتد ما ألقى من الهيمان",0,"ن",1,0],["فَاِلثُم بِروحِكَ أَرضَها تَلثُم عُصوراً","لِلعُلى سَكَنَت حَصى وَتُرابا",1,"ب",2,0],["فَاِلثُمي كُلَّ زَهرَةٍ فيهِ إِنّي","كُنتُ أَهوى زُهورَهُ وَغُصونَه",2,"ن",2,0],["فالثمْ ثرى جَيَّ إنْ وافيتَها سَحَراً","واقْرَأْ سلامي على أهلي وجيراني",3,"ي",1,0],["فَالثَغرُ وَالساكِنوهُ لا يَؤودُهُمُ","ما عِشتَ فيهِم أَطارَ الدَهرُ أَم دَرَجا",4,"ج",2,0],["فالثِّقْلُ للبازلِ في سِنّهِ","والقَتَبُ الهَفْهَافُ للحِقِّ",5,"ق",1,0],["فَالثِقلُ لَيسَ مُضاعَفاً لِمَطِيَّةٍ","إِلّا إِذا ما كانَ وَهماً بازِلا",6,"ل",2,0],["فَالثَواب قالَ غَداً","تَشتَفي بِمنظَرِها",7,"ر",3,0],["فالثُكْلُ والعَيْشُ السَويُّ سَويةٌ","ودَمُ الضحايا والحياةُ تُؤام",8,"م",1,0],["فالثم ثراه فقد لثمت خميلة","للمكرمات وقد شممت عبيرا",9,"ر",2,0],["فالثم ثراه فقد لثمتَ خميلةً","للمكرمات وقد نشقتَ عبيرا",10,"ر",2,0],["فألثَمَني حَصَى بَرَدٍ","تَفَجَّرَ مِن جَنَى عسل",11,"ل",1,0],["فألثم إجلالا ثراها وأجتلي","شموسي في أرجائها وأهلتي",12,"ي",1,0],["فَاِلثِم ثَراهُ مُعَفِّراً","خَدَّيكَ في تِلكَ المَواقِفِ",13,"ف",1,0],["فالثغرُ من لُبنانَ يحكي نورَهُ","والخدُّ يحوي وردةً من تونُس",14,"س",1,0],["فَالثَلجُ قُطنٌ عَلَيكِ السُّحبُ تَحلُجُهُ","وَالجَوُّ نَدّافُهُ وَالقَوسُ قَوسُ قُزَح",15,"ح",1,0],["فاِلثمهُ لثم محبٍّ لم يفُز بِلقا","حَبيبه فرأى الآثارَ للقدَمِ",16,"م",1,0],["فالثلث منه سورةٌ","آياتها مشرفه",17,"ف",2,0],["فألثم أقدام الوزير التي لها","إلى غاية الغايات ممشًى ومهيع",18,"ع",1,0],["فالثغْرُ قد عاد مِصْراً","ويوسُفُ المَلْكُ يوسُفْ",19,"ف",1,0],["فالثور يحمل هذي الأرض وهو على","صخر على الحوب فوق الماء ما غرقا",20,"ق",2,0],["فألثم خديها وأرشف ظلمها","وألزم عطفيها وأمسح خدها",21,"ه",2,0],["فألثِمُ في السِّرار تريبتيها","ومن لي لو تكون الأذنُ فاها",22,"ا",3,0],["فالثِمْ ثَرى تِلكَ البِقاعِ تأدُّباً","وقُلِ السَّلامُ على الشَّريفِ الطَّاهِرِ",23,"ر",1,0],["فالْثِمِ الأَعتابَ وادخلْ خاشِعاً","حضرَةَ الغَوْثِ الكبيرِ القُطُبِ",24,"ب",1,0],["فالثِّقْلُ لا يسطيعه من شارفٍ","كوماءِ إلّا غاربٌ وسنامُ",25,"م",1,0]]}