{"poems":[[65,"إيها فكم تهصر أغصان الضال","https://www.aldiwan.net/poem46152.html","الرجز"],[65,"نظرت خلال الركب والمزن هطال","https://www.aldiwan.net/poem46217.html","الطويل"],[9,"يا لقيس لما لقينا العاما","https://www.aldiwan.net/poem21985.html","الخفيف"],[32,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[32,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[32,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[39,"بمستذلق حشرات الأكا","https://www.aldiwan.net/poem7096.html","المتقارب"],[53,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[53,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[31,"عفا الجو من سلمى فبادت رسومها","https://www.aldiwan.net/poem6053.html","الطويل"],[93,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[47,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[47,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[30,"فقلت للنفس هذي منية صدقت","https://www.aldiwan.net/poem5099.html","البسيط"],[30,"ومطروفة العينين قد قدت للصبا","https://www.aldiwan.net/poem5565.html","الطويل"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[22,"عفا مسحلان من سليمى فحامره","https://www.aldiwan.net/poem21639.html","الطويل"],[50,"أسير الهم نائي الصبر عان","https://www.aldiwan.net/poem65309.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[22,"عَفَا مُسْحَلانُ عن سُلَيْمَى فَحَامِرُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=19750",""],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[132,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[185,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[190,"إذا ما عابني أبناء جنسي","https://www.aldiwan.net/poem43601.html","الوافر"],[216,"بمسجد الباغ حوض فيه ميزاب","https://www.aldiwan.net/poem37917.html","البسيط"],[236,"لكرب بني العباس سفاحهم جلا","https://www.aldiwan.net/poem44601.html","الطويل"],[369,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[369,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[447,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[457,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[466,"يا مودع السر سر الله خص به","https://www.aldiwan.net/poem16266.html","البسيط"],[534,"أجزتك في فنون العلم طرا","https://www.aldiwan.net/poem37263.html","الوافر"],[534,"أجزتك أيها المولى بما في","https://www.aldiwan.net/poem37478.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138239",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104622","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104579","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104564","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120058","المجتث"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96584","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1171,"","https://poetry.dctabudhabi.ae/diwan/poem/79378","الطويل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130253","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93100","الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35735","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79826","الوافر"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96346","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26463","الطويل"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104434","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89549","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53211","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109408","البسيط"],[2288,"","https://poetry.dctabudhabi.ae/diwan/poem/144271","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93885","المتقارب"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67590","المتقارب"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121627","الرجز"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104303","المديد"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62797","البسيط"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35900","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135664","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111518","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70098","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70055","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70165","الوافر"],[5136,"أهواه كالغصن في تثنيه","https://www.poetsgate.com/ViewPoem.aspx?id=121781",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[5526,"البل والخيل","https://www.poetsgate.com/ViewPoem.aspx?id=198790",""],[5758,"إلى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200527",""],[5956,"‏ بم سوف تشعر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=185413",""],[5956,"بم سوف تشعر؟","https://www.poetsgate.com/ViewPoem.aspx?id=194848",""],[6068,"هل تارك روحي لنصح العاذل","https://www.poetsgate.com/ViewPoem.aspx?id=181693",""],[6126,"النَّخْلة","https://www.poetsgate.com/ViewPoem.aspx?id=190002",""]],"verses":[["بمَسْرَحِ العُفْرِ ومَرْعى الأوْعالْ","ارْمِ بِها والليلُ ضافي الأذْيالْ",0,"ل",1,0],["بِمُستَمطِراتٍ مِن أكُفٍّ كَريمَةٍ","تَزاحَمُ آجالٌ علَيها وآمالُ",1,"ل",1,0],["بِمَساميحَ في الشِتاءِ يَخالو","نَ عَلى كُلِّ فالِجٍ إِطعاما",2,"م",2,0],["بِمُستَحكِمٍ جَزلِ المُروءَةِ مُؤمِنٍ","مِنَ القَومِ لا يَهوى الكَلامَ اللَواغِيا",3,"ي",2,0],["بِمُستَرجَفِ الأَرطى كَأَنَّ عَجاجَهُ","مِنَ الصَيفِ أَعرافُ الِهجانِ الأَوارِكِ",4,"ك",1,0],["بِمَسفوحَةِ الآباطِ طاحَ اِنتِقالُها","بِأَطراقِها وَالعيسُ باقٍ ضَريرُها",5,"ر",3,0],["بِمُستَشعِرٍ داءَ الهَوى عَرَّضَت لَهُ","سَقاماً مِنَ الأَسقامِ صاحِبَةُ الخِدرِ",6,"ر",1,0],["بمستذلق حشرات الأكا","م يمنع من ذي الوِجار الوِجارا",7,"ر",2,1],["بمسنَّع ظلت محاسنه","تخفي بها بدراً وتطلعه",8,"ع",2,0],["بمستمعٍ طوراً وطوراً بمنظرٍ","يرى من رآه أنه كان حالما",9,"م",2,0],["بِمُستَأسِدٍ يَجري النَدى في رِياضِهِ","سَقَتهُ أَهاضيبُ الصَبا فَمُديمُها",10,"م",3,0],["بِمَ سَمَرُ الإِخوانِ في كُلِّ لَيلَةٍ","وَصاحِبُهُم في اللَحدِ غَيرُ مُسامِرِ",11,"ر",1,0],["بِمَساعٍ مَنظومَةٍ أَلبَسَتهُنَّ","اللَيالي قَلائِداً وَعُقودا",12,"د",2,0],["بِمَسيرِ إِبراهيمَ يَحمِلُ جودَهُ","جودُ الفُراتِ فَرائِعٌ وَمَروعُ",13,"ع",1,0],["بِمُستَطيعٍ نَدى بِشرٍ عُبابُهُما","وَلَو أَعانَهُما الزابُ إِذا اِنحَدَرا",14,"ر",2,0],["بِمُستَأنِسٍ بِالقَفرِ فَردٍ تَقاذَفَت","عَلى الأَرضِ دَيموماتُها وَحُزومُها",15,"م",3,0],["بِمُستَرجَفِ الأَرطى كَأَنَّ جُروسَهُ","تَداعي حَجيجٍ رَجعُهُ غَيرُ مُفصِحِ",16,"ح",1,0],["بِمُستَأسِدِ القُريانِ حُوٍّ نَباتُهُ","فَنَوّارُهُ ميلٌ إِلى الشَمسِ زاهِرُه",17,"ر",2,0],["بِمُسمِعَةٍ إِذا غَنَّت بِصَوتٍ","أَجابَتها المَثالِثُ وَالمَثاني",18,"ن",2,0],["بِمَسْمَعِهِ عَنْ قَالَةِ السُّوءِ نَبْوَةٌ","وَيُرْهِفُهُ مَا شَاءَ لِلحَقِّ وَالعَدْل",19,"ل",1,0],["بمَسكَنَةٍ سَأَلتُ فَقُل","لِمُشتاقٍ تَمَسكَنَ ها",20,"ن",3,0],["بمُسْتَأْسِدِ القُرْيانِ حُوٍّ تِلاعُهُ","فَنُوَّارُهُ مِيلٌ إلى الشمس زاهِرُهْ",21,"ر",2,0],["بمسك وكافور وري القرنفل","تفوح ثيابُ اللَّمسِ منه تنسّما",22,"م",2,0],["بمساعيرَ في الجلادِ خفاف","مَعْ حُلوم تميلُ بالأطْوادِ",23,"د",1,0],["بِمُستَعجِلاَتٍ لُحَّقٍ لاَ قَوَاطِفٍ","بأَيدٍ وَلا الأَيدِى لَها بالقَواطِفِ",24,"ف",1,0],["بمسقعة ودين واختيال","وراموا العزّ من ذلّ حنيف",25,"ف",1,0],["بمسجدِ الباغِ حَوْضٌ فيه مِيزابُ","يفرِّغُ الماءَ صَبَّاً وهو سَكَّابُ",26,"ب",1,1],["بمستنجد والمستضيء وناصر","وظاهر والمستنصر اجل مقفلا",27,"ل",2,0],["بمَسْحِ يَمينِ اللّهِ زِدْتَ ميامِناً","فأصبحْتَ من جَوْرِ الزّمانِ تُجير",28,"ر",1,0],["بمُستَرشدٍ باللهش مُستَخلَفٍ له","مليكٍ يُريكَ اللهُ طاعتَه رُشْدا",29,"د",2,0],["بمسمع طاهر من نية خلصت","في منطق صادق في منظر غضض",30,"ض",1,0],["بمستشرق للغوطتين وما حوت","من الحسن مما راح يعجزنا شرحا",31,"ح",2,0],["بمُسْتَضيءٍ مُحَيَّاهُ وراحَتُهُ","يُجلِّيانِ كُروبَ الظُّلْم والظُّلَم",32,"م",1,0],["بِمَسْمُوعي ومَقْرُوئي ومِنْها","وِجَادَاتِي وذَاكَ هُوَ الأَقَلُّ",33,"ل",1,0],["بِمَسْمُوعِي ومَقْروئِي عَلَى مَنْ","أَنافُوا في العُلُومِ وفي الصَّلاحِ",34,"ح",1,0],["بمسجد جاورته الدهر مدرسة","أرضى زكيٌّ رقيباً عفوه ارتقبا",35,"ب",2,0],["بمسرة وصفاً أتاك العيد","عبد الحميد وأنت فيه سعيد",36,"د",1,1],["بمسبقٍ صخبِ الجلاجلِ أجدلٍ","يرتاحُ رائيهِ الى تقليبهِ",37,"ب",2,0],["بمستعصمٍ باللَه منتصرٍ له","بِحزمِ التأني لا بحزم التسرُّعِ",38,"ع",1,0],["بمستنصريِّ النّحرِ مُستنجديّهِ","رشيديّهِ مهديّهِ هاشميّهِ",39,"ي",2,0],["بمستميح ضربك","منّا وعافٍ فقيرِ",40,"ر",1,0],["بمسقِيَّةِ الأَجفانِ أَنفَدَ دَمعَها","مقاربةُ الأُلاَّفِ ثُمّ زيالُها",41,"ل",3,0],["بِمُسْنَفاتٍ تَخْبِطُ الشَسِيسا","مِنَ الصُوَى وَالأَخْشَبَ الشَريسا",42,"س",2,0],["بِمُسْفِرَاتٍ تَكْشِفُ النُحُوسا","إِذا شَكَوْنَا سَنَةً حَسُوسا",42,"س",2,0],["بمُسْتحصِفِ الآريّ يستَنُّ حوله","له نَسَبٌ بين الجُدَيْدِ ولازمِ",43,"م",1,0],["بمَسْمُومةٍ ممّا تخيَّرت العِدَى","صِيَابٍ شَبَاها خالط السَّمَّ مُنْقَعَا",44,"ع",2,0],["بمستن العجاجة والمنايا","تنافثها أنابيب الرماح",45,"ح",1,0],["بِمُستَقبلٍ في مُلكِهِ وَشَبابِهِ","أَنافَ بِهِ العِزُّ المُؤَيَّدُ وَالقَدرُ",46,"ر",1,0],["بمسبلة المساء على صباحٍ","ومطلعةِ الصباح من المساءِ",47,"ا",2,0],["بمستوي من ردى الدوي ليس به","للقوم الاسرى البيض المتاهيم",48,"م",1,0],["بِمُستَروِحاتٍ سابِحاتٍ بُطونُها","عَلى الأَرضِ أَمثالَ السِهامِ الزَوالِجِ",49,"ج",1,0],["بمسر بلين من الدروع سوابغا","ومن الصوارم والرماح حرارها",50,"ر",3,0],["بِمُستَوحشٍ من شبهِ آرامِ عينهِ","تَناوَحُ فيه الهوجُ بداءاً وَرُجّعا",51,"ع",2,0],["بمستهل الودق طامي الحيا","كأنه جود مجير الأنام",52,"م",1,0],["بمسمع الجود صاح المال من يده","فأيقظ الطرف منه بعدما رقد",53,"د",1,0],["بمستتر، والصائن العرض سالم","وربتما لم يعدم الذم والقذفا",54,"ف",2,0],["بمسك الختام يطيبان نشرا","إلى نشر من كان في طي رمس",55,"س",1,0],["بمُستَورِدٍ من حِياضِ الرَّدى","رحيبٍ تضايَقَ عنه الصَّدَرْ",56,"ر",1,0],["بِمَسِّ أقْدامِ النَّبِيِّ قد حَوَتْ","طَيْبَةُ فخراً حَلَّ في أرْجائِهَا",57,"ه",2,1],["بمساعٍ أنت عاقدها","في حباها أو مناطقها",58,"ق",3,0],["بمُسْبَلٍ فوقَ ظهرِ الأرضِ مُنسَحِبٍ","ومن ترائبها والنّحر مختضِبِ",59,"ب",1,0],["بِمَسكَن مِن آلِ كِسرى طَلَل","عَفَتهُ الرَوامِسُ حَتّى مَحَل",60,"ل",1,1],["بمسائي ثم الصباح أنالُ","أخذتني هاءٌ ونونٌ ودالُ",61,"ل",1,1],["بمسدٍ دق عليها علقا","حمامةً برجلها قد أوثقا",62,"ق",2,0],["بِمَسعى الشَهم قَيسَ وَمَن تَساموا","ببذل المكرماتِ عَلى علاها",63,"ا",3,0],["بِمَسعى حبرنا الدحداح ارّخ","لِغادٍ تمَّ وَصلُ القاطِعينِ",64,"ن",1,0],["بَمسعاهُ حَكى موسى","كليم اللَهِ في القفر",65,"ر",1,0],["بمس خدي شقيق وجنته","وهو يعيد الفؤاد قاصيه",66,"ي",2,0],["بمسجده الأسنى فقد خالف الذي","أراد به المعصوم في القصد بالشد",67,"د",1,0],["ب مسوبع ً فايع به البن والهيل","يبري الجروح النازفات العطيبات",68,"ت",1,0],["\"بِمَسافةٍ أخْرى تشُدُّ مسَافةً\"","في إِثْرهَا لغةُ الهَوَى تَنْسَاقُ",69,"ق",1,1],["بِمَ سوف تشعر لو شهِدْتَ مشيبي","من بَعد طول البُعدِ والتعذيبِ ؟",70,"ب",1,1],["بِمَ سوف تشعر لو رأيتَ مشيبي","من بَعد طول البُعدِ والتعذيبِ؟",71,"ب",1,1],["بمساحة خضراء نلقي ميلنا","ملقى المسافر رحله بمنازل",72,"ل",1,0],["بمسائها قد أرْطبَتْ وتَهصَّرت","تحلو مذاقاً كالشِّفاه العاشقة",73,"ق",2,0]]}