{"poems":[[55,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[79,"الأصيل ارتدى بثوب شحوب","https://www.aldiwan.net/poem35698.html","الخفيف"],[74,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[87,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[60,"ألا صاحب الذنب لا تقنطن","https://www.aldiwan.net/poem30959.html","المتقارب"],[46,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[33,"أخطأت أنت بدأت بالصرم","https://www.aldiwan.net/poem41327.html","الكامل"],[76,"ألا صمت الأجداث عني فلم تجب","https://www.aldiwan.net/poem12876.html","الطويل"],[8,"رأيت البكر بكر بني ثمود","https://www.aldiwan.net/poem21845.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39392","الكامل"],[131,"ألا صرمت من سلمى الزماما","https://www.aldiwan.net/poem24260.html","الوافر"],[136,"الأصل في الخبر أن لا يقترن","https://www.aldiwan.net/poem54662.html","الرجز"],[151,"ماذا على ساداتنا أهل الوفا","https://www.aldiwan.net/poem47643.html","الكامل"],[164,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[190,"الأرض تنفعها العماره","https://www.aldiwan.net/poem43733.html","مجزوء الكامل"],[203,"الأصدقاء قليل","https://www.aldiwan.net/poem45550.html","المجتث"],[246,"ألا راية للعدل في مصر تخففق","https://www.aldiwan.net/poem45772.html","الطويل"],[315,"أبى الطيف أن يعتاد إلا توهما","https://www.aldiwan.net/poem59514.html","الطويل"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[422,"عرفت صبابة هذي النياق","https://www.aldiwan.net/poem53927.html","المتقارب"],[463,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[475,"ألست أبا حفص هديت مخبري","https://www.aldiwan.net/poem4810.html","الطويل"],[543,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38221","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70653","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67835","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61135","الوافر"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56708","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87898","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127947","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53147","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33878","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27440","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2389,"","https://poetry.dctabudhabi.ae/diwan/poem/146454","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60998","المنسرح"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105407","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75923","البسيط"],[3051,"","https://poetry.dctabudhabi.ae/diwan/poem/95781","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62811","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117912","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90874","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94789","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117217","الطويل"],[4502,"","https://poetry.dctabudhabi.ae/diwan/poem/75854","الوافر"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105481","الطويل"],[4750,"علموا اللي كل يوم","https://www.poetsgate.com/ViewPoem.aspx?id=180440",""],[4811,"زهراء","https://www.poetsgate.com/ViewPoem.aspx?id=198695",""],[4916,"قصة احساس","https://www.poetsgate.com/ViewPoem.aspx?id=135373",""],[4955,"نعم ضاقت ولكنا","https://www.poetsgate.com/ViewPoem.aspx?id=211017",""],[4987,"ماهى اول غلا","https://www.poetsgate.com/ViewPoem.aspx?id=49570",""],[5285,"باقة ورد","https://www.poetsgate.com/ViewPoem.aspx?id=203581",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5564,"ياللْه يا كافي الأمور الشدايد","https://www.poetsgate.com/ViewPoem.aspx?id=186845",""],[5582,"أَلا هَلْ نَفَتْ عَنْكَ طِيبَ الرُّقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=186965",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5739,"حالب النمله ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155467",""],[5848,"ياللي تدور خير","https://www.poetsgate.com/ViewPoem.aspx?id=53193",""],[5956,"الحب العاقرُ","https://www.poetsgate.com/ViewPoem.aspx?id=182020",""],[5956,"يا ليت","https://www.poetsgate.com/ViewPoem.aspx?id=185663",""],[6102,"غُفران ..","https://www.poetsgate.com/ViewPoem.aspx?id=184542",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[5190,"أين الوفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85064&r=&rc=139",""]],"verses":[["أَلا صَديقٌ في الزَمانِ ماجِدٌ","أَشكو إِلَيهِ عُجَري وَبُجَري",0,"ر",2,0],["الأصيل ارتدى بثوب شحوب","وتحلى برقة واصفرار",1,"ر",1,1],["الأصل ريَّانٌ فلا عجبٌ إذا","ما الفرع فاء على الورَى بظلال",2,"ل",1,0],["ألا صاحبٌ يبكي لمصرع صاحبٍ","وإنْ كان لم يُكْلَمْ برمحٍ ولا نصلِ",3,"ل",1,0],["الأَصلُ في كُلِّ بِنايَةٍ حَجَر","وَإِن زَهَت بِالشُرُفات وَالحُجَر",4,"ر",1,1],["أَلا صاحِبَ الذَنبِ لا تَقنُطَنَ","فَإِنَّ الإِلَهَ رَؤوفٌ رَؤوفُ",5,"ف",1,1],["أَلا صَنَعَ البَينُ الَّذي هُوَ صانِعُ","فَإِن تَكُ مِجزاعاً فَما البَينُ جازِعُ",6,"ع",1,1],["إِلّا صَبابَةَ عاشِقٍ لَكُمُ","أَورَثتِهِ سُقماً عَلى سُقمِ",7,"م",1,0],["أَلا صُمَّتِ الأَجداثُ عَنّي فَلَم تُجِب","وَلَم يُغنِني أَنّي رَفَعتُ لَها صَوتي",8,"ت",2,1],["أَلاَ صَلَّى إِلهُكُمُ عَلَيكُم","وَلاَ صَلَّى عَلى الأُمَراءِ فِينا",9,"ن",2,0],["الأصبح الأفصح في المجامع","الحلو في العيون والمسامع",10,"ع",1,0],["إلّا صَقيلَ المتْنِ مَلمومَ القُوَى","حُدَّتْ لَهازِمُهُ وشُقَّ المَفْرِقُ",11,"ق",1,0],["أَلا صَرَّمت مِن سَلمى الزِماما","وَلَم تُنجِد لِما يَبغي قِواما",12,"م",2,1],["الأصلُ في الخَبرِ أن لاَ يَقتِرَن","بِالفَا لأنَّ نِسبَةَ الخَبرِ مِن",13,"ن",1,1],["إلا صبابته وجسما قد غدا","ملقى كشنّ بالفلا لن يخصفا",14,"ف",2,0],["الأصل رأسٌ والفروع مع السما","فقديمُكم وحديثُكم سيّانِ",15,"ن",1,0],["إلا صعود الكركدَنّ إلى","الأذان على المناره",16,"ر",2,0],["الأصدقاءُ قليلُ","والحرُّ فيهم أقلُّ",17,"ل",1,1],["ألا صدمةٌ للجور توقف سيره","فيجبر ذاك الكسرُ والفتقُ يرتقُ",18,"ق",1,0],["ألا صنع الشوق الذي هو صانع","فحبي مقيم أقصر الشوق أو سما",19,"م",2,0],["ألا صُبْحٌ يُتاحُ لنا مُضيء","أَلا لَيلٌ يُتاحُ له مُضيّ",20,"ي",1,0],["ألا صبَّح الغيث تلك الدِّيار","وحيَّى منازلَ أحيائها",21,"ا",3,0],["ألا صاحبٌ كالسيفِ حلوٌ شمائلُهْ","رداءُ الهوى مثلي على الشيبِ شاملُهْ",22,"ل",2,1],["أَلا صِلَةُ الأَرحامِ أَدنى إِلى التُقى","وَأَظهَرُ في أَكفائِهِ لَو تَكَرَّما",23,"م",2,0],["الأصدقاء تُحِبُّه وتهابهُ","وعداهُ إن كانت هُناكَ عِداهُ",24,"ه",1,0],["أَلا صِلْني وَأَنتَ بِلا عِذارٍ","فَوَجهُك حُسنُهُ يَأبى العِذارا",25,"ر",2,1],["ألا صلوا عليه وسل","موا في الحين والوقت",26,"ت",1,0],["ألاَ صَبَا نَجْدٍ إذَا جُزْتِ غُدْوَةً","صِفِي كَلَفِي إنْ أنْتِ صَادَفَتِ خَلْوَةً",27,"ه",1,0],["الأصعد الأرقى النذير المقتضى","الأمجد الأهدى الإمام الأفضل",28,"ل",1,0],["أَلا صف لي مَعاهد أَم عمرو","وَدَع عَنكَ الرصافة وَالغَميما",29,"م",2,1],["ألا صدقت هذا العبرات","وقد كنت أحسبها كاذبة",30,"ب",2,0],["الأصلُ في الإعراب للأسماء","والأصل في الإخبار بالأسماء",31,"ا",2,0],["الأَصل والفصل والأَخلاق أَفضلُها","تُبنى على تلك فالبنيان مقترحُ",32,"ح",1,0],["الآصفى اللو ذعى الالم","عى في دياجى المشكلات عليم",33,"م",1,0],["ألا صلى الإله على نفوس","أجابت ربها في الذاهبينا",34,"ن",2,0],["ألا صلى الإله على نفوس","ترى في الحق مصرعها لزاما",35,"م",2,0],["ألا صاحب كالسيف يمضي إذا نبا","زمان فيسعى في مرامي ويسعف",36,"ف",1,0],["الأَصدقاءُ مكانهُ","ويغبِطُني الأَدنى بِهِ والأباعِدُ",37,"د",1,0],["الأصل قد يثبتُه فرعُه","والفرعُ لا يثبته الأصلُ",38,"ل",1,1],["الأصلُ لا أصل له فاعتبر","قدر الذي ليس له أصلُ",38,"ل",1,0],["الأصلُ مَعقُولٌ وَلَفظُ الوَحي مَع","زُولٌ وَنَحنُ وأنتُمُ صِنوَانِ",39,"ن",1,0],["ألا صاحبٌ يَلْحى على الغيِّ صاحباً","لقد عُدِمَ العذَّالُ مذ عَمَّتِ الشَّكوى",40,"و",2,0],["الأصلُ أصلي فكيف أقطعه","والأنفُ أنفي فكيف أجدعُه",41,"ه",1,1],["الأصيد القرم الذي ضربت له","في قنة المجد الأثيل خيام",42,"م",1,0],["الأَصبَحِيُّ وَنُعمانٌ فَلا بَرِحا","يَسقِي ضَريحَهُما الرَحمَنُ مِدرارا",43,"ر",2,0],["إلّا صِياحاً وَنَفض كُمٍّ","وَنَظم لالا وول لم لم",44,"م",1,0],["ألا صارمٌ قد هذّبَ القينُ نَصلَه","ألا صَعْدَةٌ فيها سِنانُ مؤمَّرُ",45,"ر",1,0],["الآصفيّ أرومة أزكى المنا","بت عنصراً وأجل من قاد الجنود",46,"د",1,0],["الآصفي الماجد الأجداد من","أحفاد صديق الحبيب المجتبى",47,"ب",2,0],["الاصفي إذا قضى أمرا مضى","والاحنفي إذا عفا وتوددا",48,"د",2,0],["ألا صادحات الحي حيي على الصبا","عساها تناجينا ببعض الجوائبِ",49,"ب",1,0],["ألا صرحوا في حبّه بوداده","فليس محباً من بوجد يلوح",50,"ح",1,0],["أَلا صَرَمت حَبائِلَنا جَنوبُ","فَفَرَّعنا وَمالَ بِها قَضيبُ",51,"ب",1,1],["ألا صرف الرحمن عنك صروفه","وأولاك عيشاً صافياً لن يكدرا",52,"ر",2,0],["الأصايل كل يوم تلافح بالكعوب","والردي لا عيّن اللي يهينه قدّره",53,"ر",2,0],["إلا صدىً بين جنبّيهِ يصيح دُجى","أستغفر الله والزهراء والقدرا",54,"ر",2,0],["الاصيله مالها غير الاصيل","تحفظه فالضيق والا فالسعه",55,"ع",2,1],["ألا صبرًا ولو طالت","ليالٍ زادُها السَّقمُ",56,"م",1,0],["الاصايل يجنّك مثل أهلهن أصايل","والوكاد إنّها منهن بليّا كلام",57,"م",1,0],["الأصلُ نجمٌ في السماءِ مكانه","ما كان يعرفُ كالنجومِ أُفولا",58,"ل",2,0],["الأصل مكةُ، والمهاجَرُ طَيْبةٌ","والقدسُ رَوْضُ عَراقةٍ فَينانُ",59,"ن",1,0],["الأصل ياسيٍّ وْمن شفْ زايد","ان كان قرّاب الجماعه يباها",60,"ا",3,0],["أَلا صَرِّحْ المَدْحَ فِيهِ ونادِ","لَهُ بِالمَفاخِرِ فِي كُلِّ نادِ",61,"د",1,0],["إلا صبراً بني الخوري جميلاً","كما صبرت على الضر الكرمُ",62,"م",1,0],["الاصاله .... بين حافين ورعاه.","والبلا ..! من حيةٍ في كمها.",63,"م",3,0],["الاصل ضاع وباقي عقبه فروع","متفرده بالنفع وتدوّر الضر",64,"ر",1,0],["الأصلُ غيرُك وهو دائرةُ الرَّحَى","وأنا الهوامشُ والذباب الطائرُ",65,"ر",1,0],["الأصل باقٍ كما القيّوم أنشأهُ","والله أصلُ جميع الحَيِّ والرِّمَمِ",66,"م",1,0],["إِلَّا صَرِيحَ العَفوِ فِي كِلماتِها :","( إِنَّي صَفَحتُ عَنِ الإِساءَةِ وَ الزَّلَلْ",67,"ل",1,0],["إلاّ (صديقي) لا يزالُ مُرَدِّداً","بالشِّعِرِ جئتُ متاجراً أَتَكَسَّبُ",68,"ب",1,0],["الأصدقاءُ كأنَّما أَودَت بِهِم","رِيحُ الغُرورِ ، وقبضةُ الخُيَلاءِ",69,"ا",2,0]]}