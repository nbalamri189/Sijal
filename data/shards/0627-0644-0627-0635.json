{"poems":[[53,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[77,"الأصيل ارتدى بثوب شحوب","https://www.aldiwan.net/poem35698.html","الخفيف"],[72,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[85,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[58,"ألا صاحب الذنب لا تقنطن","https://www.aldiwan.net/poem30959.html","المتقارب"],[44,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[31,"أخطأت أنت بدأت بالصرم","https://www.aldiwan.net/poem41327.html","الكامل"],[74,"ألا صمت الأجداث عني فلم تجب","https://www.aldiwan.net/poem12876.html","الطويل"],[8,"رأيت البكر بكر بني ثمود","https://www.aldiwan.net/poem21845.html","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39392","الكامل"],[128,"ألا صرمت من سلمى الزماما","https://www.aldiwan.net/poem24260.html","الوافر"],[133,"الأصل في الخبر أن لا يقترن","https://www.aldiwan.net/poem54662.html","الرجز"],[148,"ماذا على ساداتنا أهل الوفا","https://www.aldiwan.net/poem47643.html","الكامل"],[161,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[187,"الأرض تنفعها العماره","https://www.aldiwan.net/poem43733.html","مجزوء الكامل"],[200,"الأصدقاء قليل","https://www.aldiwan.net/poem45550.html","المجتث"],[242,"ألا راية للعدل في مصر تخففق","https://www.aldiwan.net/poem45772.html","الطويل"],[311,"أبى الطيف أن يعتاد إلا توهما","https://www.aldiwan.net/poem59514.html","الطويل"],[365,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[417,"عرفت صبابة هذي النياق","https://www.aldiwan.net/poem53927.html","المتقارب"],[459,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[471,"ألست أبا حفص هديت مخبري","https://www.aldiwan.net/poem4810.html","الطويل"],[539,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"]],"verses":[["أَلا صَديقٌ في الزَمانِ ماجِدٌ","أَشكو إِلَيهِ عُجَري وَبُجَري",0,"ر",2,0],["الأصيل ارتدى بثوب شحوب","وتحلى برقة واصفرار",1,"ر",1,1],["الأصل ريَّانٌ فلا عجبٌ إذا","ما الفرع فاء على الورَى بظلال",2,"ل",1,0],["ألا صاحبٌ يبكي لمصرع صاحبٍ","وإنْ كان لم يُكْلَمْ برمحٍ ولا نصلِ",3,"ل",1,0],["الأَصلُ في كُلِّ بِنايَةٍ حَجَر","وَإِن زَهَت بِالشُرُفات وَالحُجَر",4,"ر",1,1],["أَلا صاحِبَ الذَنبِ لا تَقنُطَنَ","فَإِنَّ الإِلَهَ رَؤوفٌ رَؤوفُ",5,"ف",1,1],["أَلا صَنَعَ البَينُ الَّذي هُوَ صانِعُ","فَإِن تَكُ مِجزاعاً فَما البَينُ جازِعُ",6,"ع",1,1],["إِلّا صَبابَةَ عاشِقٍ لَكُمُ","أَورَثتِهِ سُقماً عَلى سُقمِ",7,"م",1,0],["أَلا صُمَّتِ الأَجداثُ عَنّي فَلَم تُجِب","وَلَم يُغنِني أَنّي رَفَعتُ لَها صَوتي",8,"ت",2,1],["أَلاَ صَلَّى إِلهُكُمُ عَلَيكُم","وَلاَ صَلَّى عَلى الأُمَراءِ فِينا",9,"ن",2,0],["الأصبح الأفصح في المجامع","الحلو في العيون والمسامع",10,"ع",1,0],["إلّا صَقيلَ المتْنِ مَلمومَ القُوَى","حُدَّتْ لَهازِمُهُ وشُقَّ المَفْرِقُ",11,"ق",1,0],["أَلا صَرَّمت مِن سَلمى الزِماما","وَلَم تُنجِد لِما يَبغي قِواما",12,"م",2,1],["الأصلُ في الخَبرِ أن لاَ يَقتِرَن","بِالفَا لأنَّ نِسبَةَ الخَبرِ مِن",13,"ن",1,1],["إلا صبابته وجسما قد غدا","ملقى كشنّ بالفلا لن يخصفا",14,"ف",2,0],["الأصل رأسٌ والفروع مع السما","فقديمُكم وحديثُكم سيّانِ",15,"ن",1,0],["إلا صعود الكركدَنّ إلى","الأذان على المناره",16,"ر",2,0],["الأصدقاءُ قليلُ","والحرُّ فيهم أقلُّ",17,"ل",1,1],["ألا صدمةٌ للجور توقف سيره","فيجبر ذاك الكسرُ والفتقُ يرتقُ",18,"ق",1,0],["ألا صنع الشوق الذي هو صانع","فحبي مقيم أقصر الشوق أو سما",19,"م",2,0],["ألا صُبْحٌ يُتاحُ لنا مُضيء","أَلا لَيلٌ يُتاحُ له مُضيّ",20,"ي",1,0],["ألا صبَّح الغيث تلك الدِّيار","وحيَّى منازلَ أحيائها",21,"ا",3,0],["ألا صاحبٌ كالسيفِ حلوٌ شمائلُهْ","رداءُ الهوى مثلي على الشيبِ شاملُهْ",22,"ل",2,1],["أَلا صِلَةُ الأَرحامِ أَدنى إِلى التُقى","وَأَظهَرُ في أَكفائِهِ لَو تَكَرَّما",23,"م",2,0],["الأصدقاء تُحِبُّه وتهابهُ","وعداهُ إن كانت هُناكَ عِداهُ",24,"ه",1,0]]}