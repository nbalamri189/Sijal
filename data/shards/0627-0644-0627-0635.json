{"poems":[[53,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[77,"الأصيل ارتدى بثوب شحوب","https://www.aldiwan.net/poem35698.html","الخفيف"],[72,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[85,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[58,"ألا صاحب الذنب لا تقنطن","https://www.aldiwan.net/poem30959.html","المتقارب"],[44,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[31,"أخطأت أنت بدأت بالصرم","https://www.aldiwan.net/poem41327.html","الكامل"],[74,"ألا صمت الأجداث عني فلم تجب","https://www.aldiwan.net/poem12876.html","الطويل"],[8,"رأيت البكر بكر بني ثمود","https://www.aldiwan.net/poem21845.html","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39392","الكامل"]],"verses":[["أَلا صَديقٌ في الزَمانِ ماجِدٌ","أَشكو إِلَيهِ عُجَري وَبُجَري",0,"ي",1,0],["الأصيل ارتدى بثوب شحوب","وتحلى برقة واصفرار",1,"ر",1,1],["الأصل ريَّانٌ فلا عجبٌ إذا","ما الفرع فاء على الورَى بظلال",2,"ل",1,0],["ألا صاحبٌ يبكي لمصرع صاحبٍ","وإنْ كان لم يُكْلَمْ برمحٍ ولا نصلِ",3,"ل",1,0],["الأَصلُ في كُلِّ بِنايَةٍ حَجَر","وَإِن زَهَت بِالشُرُفات وَالحُجَر",4,"ر",1,1],["أَلا صاحِبَ الذَنبِ لا تَقنُطَنَ","فَإِنَّ الإِلَهَ رَؤوفٌ رَؤوفُ",5,"ف",1,1],["أَلا صَنَعَ البَينُ الَّذي هُوَ صانِعُ","فَإِن تَكُ مِجزاعاً فَما البَينُ جازِعُ",6,"ع",1,1],["إِلّا صَبابَةَ عاشِقٍ لَكُمُ","أَورَثتِهِ سُقماً عَلى سُقمِ",7,"م",1,0],["أَلا صُمَّتِ الأَجداثُ عَنّي فَلَم تُجِب","وَلَم يُغنِني أَنّي رَفَعتُ لَها صَوتي",8,"ي",1,1],["أَلاَ صَلَّى إِلهُكُمُ عَلَيكُم","وَلاَ صَلَّى عَلى الأُمَراءِ فِينا",9,"ن",2,0],["الأصبح الأفصح في المجامع","الحلو في العيون والمسامع",10,"ع",1,0],["إلّا صَقيلَ المتْنِ مَلمومَ القُوَى","حُدَّتْ لَهازِمُهُ وشُقَّ المَفْرِقُ",11,"ق",1,0]]}