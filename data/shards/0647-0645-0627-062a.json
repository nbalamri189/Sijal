{"poems":[[95,"هنيئا لكم أن تسمعوا شعر حافظ","https://www.aldiwan.net/poem11190.html","الطويل"],[30,"سأجزيك من سوآت ما كنت سقتني","https://www.aldiwan.net/poem5526.html","الطويل"],[107,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[107,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[107,"يمينا ما لمدين من قرار","https://www.aldiwan.net/poem43993.html","الوافر"],[107,"منايا القوم في جلد البعير","https://www.aldiwan.net/poem44061.html","الوافر"],[107,"خزاعة أبشري بالعهد سمحا","https://www.aldiwan.net/poem44065.html","الوافر"],[280,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[556,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115755","الكامل"]],"verses":[["هُمَا تُحْفَتَا دَهْرٍ ضَنِينٍ ظَفِرْتُمَا","بِكِلْتَيْهِمَا مِنْ مُسْعِفٍ غَيْرِ ضَنَّانِ",0,"ن",1,0],["هُما تَفَلا في فِيَّ مِن فَمَوَيهِما","عَلى النابِحِ العاوي أَشَدُّ رِجامِ",1,"م",1,0],["هُمُ اتّخذوا حقَّ الكنانةِ معقلاً","فما يطمعُ الأعداءُ أن يتهدَّما",2,"م",2,0],["همُ اتّخذوا الشّرائعَ مُسرجَاتٍ","مُذلَّلةَ الغواربِ للرّكوبِ",3,"ب",1,0],["هُمُ اتخذوا الشُّعوبَ لهم عَبيداً","وعاثوا في الممالكِ مُفسِدينا",4,"ن",2,0],["همُ اتّخذُوا الهَوَى رَبّاً وسَارُوا","من العهدِ القديمِ على غِرارِ",5,"ر",1,0],["هُمُ اتّخذوا الخِداعَ لهم سبيلاً","وكانوا أهلَ بُهتانٍ وَزُورِ",6,"ر",1,0],["هُمُ اتَّبعُوا الأُلى انقلبوا بِقَرْحٍ","فزادوهم بما اقترفوهُ قَرْحا",7,"ح",2,0],["هُمُ اتَّخَذُوا فيها الكَنَائِس ضِلَّةً","وَهُمْ جَعَلوا للَّهِ فيما افْتَرَوْهُ ابْنا",8,"ن",2,0],["هُمُ أتْكَوْا مرافقكمْ وأعطَوْا","جنوبَكُمُ النّمارقَ والنِّماطا",9,"ط",2,0],["هُمُ أتقى بَني الدُنيا جَميعاً","وَأَنقاهم وَأَطهرهم رِداءا",10,"ا",3,0],["هم أتهموني بالسل","وّ لأجل ذلك أتهموا",11,"م",3,0]]}