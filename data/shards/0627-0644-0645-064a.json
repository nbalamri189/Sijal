ر",1,1],["ألَم يكُ فيما خاطَبَتكُم سُيوفُهُ","بهِ قبلَ هَذا حُجَّةٌ للمُسَلِّمِ",215,"م",1,0],["ألم يَكُ داعي النوى أخرَساً","ففَهَّمَنا دَعوةَ الأخرَسِ",216,"س",1,0],["ألم يأتها أن قد صحوت عن الصبا","وآلت إِلى أكرومةٍ وتدين",217,"ن",1,0],["ألم يُدْفَنْ أبي وأبوكَ فيها","وفي عَيْنَيْهِمَا دمعٌ صَبِيبُ؟!",218,"ب",1,0],["ألم يأنِ أن تَسْتَقيلَ العثارَا","وتُمْعِنَ ممّا جَنَيتَ الفِرارَا",219,"ر",2,1],["ألم يكفني أن الزمان يظنني","له كرة يرمي بها كل ديماس",220,"س",1,0],["ألم يعلموا أني على حفظ وُدِّهم","مقيم ولو غُيِّبْتُ في باطن الترب",221,"ب",1,0],["ألم يعلموا أن ادِّكار ودادهم","ألذ على قلبي من البارد العذب",221,"ب",1,0],["ألم يعلموا أني أكاد لذكرهم","أطير ولكن لا جناح لذي جنب",221,"ب",1,0],["ألم يعلموا أنا اتحدنا عقيدة","فما أنا جهميُّ ولا أنا بالكسب",221,"ب",1,0],["أَلَم يَكفِهِ أَنَّ ثوب الحَياةِ","ضاق عَلَيهِ أَلَم يَكفِهِ",222,"ف",2,0],["ألَمياءُ إِن شَطَّت بِنَا الدّارُ عَنوةً","فَدارَاكِ أَجفاني القريحَةُ والخِلبُ",223,"ب",1,1],["أَلَم يكْفِ العواذلَ مِنكَ هجري","وقلبَكَ ما يُجنُّ مِنَ التّجنّي",224,"ن",2,0],["أَلَم يَأتِ هِنداً كَيفَما صُنعُ قَومِه","بَني عَامِر إِذا جَاءَ يَسعَى نَذِيرُهَا",225,"ر",3,0],["آل ميّ وللمحبّ حقوق","هل عَرَفْتُم من بعدهن الذمارا",226,"ر",2,0],["ألم يَدْر أنَّ المُلك أُهمل بعده","ليس سوى فهد له من مدبر",227,"ر",1,0],["ألم يحزن الآبي رؤوس تطامنت","وفاخر رأس القوم فيها ذنابه",228,"ب",2,0],["أَلَم يَرَ قَومي كَيفَ أوسِرَ مَرَّة","وَأُعسِرُ حَتّى تَبلُغَ العُسرَةُ الجَهدا",229,"د",2,0],["ألم ينتَهِ الجفنُ السقيمُ وإنه","لناهٍ لجسمي لو قبِلتَ وناهكُ",230,"ك",1,0],["ألم يَدْرِ أني آخرٌ في ضلوعه","فؤادُ أبى أن يرتَضي لحظَ أولِ",231,"ل",1,0],["ألَمْ يَكُ لَوْ أنابَ إليك طَوْعاً","ينالُ منَ العلا فوقَ المُرادِ",232,"د",1,0],["أَلَمْ يَتنَاهَ غُرُوبُ الغَرِيبِ","إِلَى مَطْلِعِ الشَّمْسِ فِي الانْتِهاءِ",233,"ا",2,0],["أَلَمْ يَرَ عبدَ المليكِ المليكَ","مجيبَ الرَّجاءِ ومُعْطِي الجَزيلِ",234,"ل",1,0],["ألم يفلحوا ما أحدثوا في عدوهم","ألم يراغموا أنف الخبيث المخنزِ",235,"ز",1,0],["ألم يبق بين الناس شهم منزة","يدوي له صوت وبالحق يجرؤ",236,"ا",1,0],["ألم يحن أن تَعافَ الناسَ معتزلاً","فقلتُ كلاّ فخلَّى كُّل إنسانِ",237,"ن",1,0],["ألم يكفهم يوم رجوه فخيبوا","ويوم وعام جربوه وعامُ",238,"م",1,0],["ألم يك في التجريبِ وعظٌ فيُنتهَى","إليه ولا للحزم وعظٌ فيُقبَلُ",239,"ل",1,0],["ألم يكفِهِ غدرُ كرَّاته","به وتقلّبُ أطوارِهِ",240,"ر",2,0],["ألم يكفِها أنّ غصنَ الصِّبا","ذَوى واستردَّ الشبابَ المعيرُ",241,"ر",1,0],["ألم يأتِه أنّه لا يُجَس","سُ غَوري ولا يطَّبيني الغؤور",241,"ر",1,0],["ألمِّي بها في السّحب ثم تَحفَّلي","فسُحبي تحيّاتي بأنضرِ ساحِ",242,"ح",1,0],["ألم يعلموا أن العذاب مغلظ","على من عصى الرحمن عمداً مجاهدا",243,"د",2,0],["ألم يأن أن ننكفّ عما يضرنا","وننقى عرض طال ما قد تقذرا",243,"ر",2,0],["ألمياءُ فيكِ لبستُ السّقا","م وأصبح فيك عذاري خليعاً",244,"ع",2,0],["ألَم يَكُنْ مِنهُ أفواهٌ مُمَزَّ قَةٌ","تَمُجُّ والدَّمَ بَيْتا ًمِنكَ مُلتَهِبا ؟!",245,"ب",2,0],["ألم يجد في سواكم سَعة","ممن يسوَّى برأسهِ ذنبه",246,"ب",2,0],["ألم يكن غرة إخواننا","ألم يكن واسطة العقد",247,"د",1,0],["ألم يك في خمس وعشرين حجة","تسنَّمتها هاد لمُثلى الطرائق",248,"ق",1,0],["ألمْ يعلمِ الفطيمُ أنّي أديمُها","وصاحُبها أقفو المنونَ فِداها؟",249,"ا",3,0],["ألم يكْفِ هذا الدّهرُ ما صنعَتْ بنا","ليالِيه حتّى ساعدَتْها الغَدائِرُ",250,"ر",1,0],["ألم يعف عنهم قادراً بعدما غدوا","فريقين منهم قائم وحصيد",251,"د",1,0],["ألم يك في قلبي من الهم والجوى","وحر الأسى شغل عن الشعر شاغله",252,"ل",2,0],["أَلَمْ يَنِصَّ عَلَى شَرْطِ اجْتِهادِ فَتىً","سَمَا إلى الْمَنْصِبِ الأَعْلَى مِنَ الرُّتَبِ",253,"ب",1,0],["أَلَم يَعلَموا أَن قَد أَتى بِصَلاحِهِم","وَرَدِّ أُمورٍ قَد خَلَونَ مَشاعِثِ",254,"ث",1,0],["ألمى تَأَلَّق طلعةً مِن لُطفِه","رقَّت لوَصف جَمالِه الأشعارُ",255,"ر",1,0],["ألم ينظرُوا بينَ الأنامِ مقامَهُم","فيا قَلبَهُم لو كانَ عندَهُمُ قَلبُ",256,"ب",1,0],["ألم يقل الداعي لكم أنا ربكم","وأنتم له قلتم بلا شبهة بلى",257,"ل",2,0],["ألم يكن أوجد ما لم يكن","مني بإيجاد جواد كريم",258,"م",1,0],["ألم يصلهم أن دين الهدى","كالبحر أو كالوابل الهامع",259,"ع",1,0],["المَيْتُ لا يَدري بحالةِ قائمٍ","والحَيُّ لا يَدرِي بحالِ مُوَسَّدِ",260,"د",1,0],["