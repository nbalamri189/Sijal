467,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[497,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[497,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[497,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[507,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"],[516,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[517,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[517,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[531,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[538,"عرفت دياراً بالحمى فشرائث","https://www.aldiwan.net/poem23857.html","الطويل"],[540,"لما استقام ولم يفز بمرامه","https://www.aldiwan.net/poem48130.html","عموديه"],[540,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[560,"تمسك بغيب الغيب واترك سواه لا","https://www.aldiwan.net/poem33575.html","الطويل"],[560,"أشكو من الله إلى خلقه","https://www.aldiwan.net/poem34072.html","السريع"],[560,"نحن ضياء الغارب الطالع","https://www.aldiwan.net/poem34396.html","السريع"],[564,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[564,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[572,"ألم يبلغك والأنماء تنمي","https://www.aldiwan.net/poem59475.html","الطويل"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216881","الوافر"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/18194","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/124800","الطويل"],[730,"","https://poetry.dctabudhabi.ae/diwan/poem/199903","الطويل"],[781,"","https://poetry.dctabudhabi.ae/diwan/poem/97623","الطويل"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10464","الوافر"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10462","الوافر"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10465","الوافر"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18054","الطويل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/117824","الطويل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/117837","الطويل"],[1153,"","https://poetry.dctabudhabi.ae/diwan/poem/116628","الطويل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/18791","الوافر"],[1174,"","https://poetry.dctabudhabi.ae/diwan/poem/26703","الطويل"]],"verses":[["أَلَم يَشرَبِ الصَبرُ قَلبي وَلا اِن","ثَنى مَرَحاً وَالعَوالي ظَوامي",0,"م",2,0],["أَلَم يُقنِعكَ بِالأَهوازِ مِنهُ","قِطارٌ غَيمُ عارِضِهِ القَتامُ",1,"م",1,0],["أَلَم يَنهَكُم رَشُّ شُؤبوبِهِ","بِوابِلِ ذي بَرَدٍ وَاِنسِجالِ",2,"ل",1,0],["أَلَم يَأتِهِ أَنّي تَفَرَّدتُ بَعدَهُ","رَوابِيَ لِلعَلياءِ جاشَ لَها نَهضي",3,"ض",2,0],["أَلمى الظَلالِ إِذا ما القَيظُ جَلَّلَهُ","تَراكَضَت في حَواشي رَوضِهِ الغُدُرُ",4,"ر",1,0],["أَلَم يَأنِ يا لِلناسِ هَبَّةُ نائِمٍ","رَأى سيرَةَ الأَيّامِ أَوجَدَ لاعِبِ",5,"ب",1,0],["أَلم يَكُ في عثمانَ للناسِ عِبرَةٌ","فَلا تُرخِصوهُ ضِلَّة إِنَّه يغلو",6,"ل",2,0],["ألَمْ يَعلَموا أني تبوّأْتُ مَنزِلاً","يُطَنِّبُ فوقَ النَّيِّرَيْنِ خِيامي",7,"م",2,0],["أَلَم يَأنِ أَن تَشفي الَّذي قَد تَرَكتِهِ","يُقاسي طَوالَ اللّيلِ مِن حُبِّكِ الجُهدا",8,"د",2,0],["أَلَم يَكفِكُم أَن قَد مَنَعتُم عَرينَكُم","كَما مَنَعَ الغيلَ الأُسودُ النَواهِتُ",9,"ت",1,0],["أَلَم يَكُن صَبرُكَ في بُعدِها","يَربو عَلى شُكرِكَ في قُربِها",10,"ه",2,0],["أَلَم يَكُن لِبَني مِصرٍ وَقَد دُهِموا","مِن ساسَةِ الغَربِ مِثلَ المَعقِلِ الأَشِبِ",11,"ب",1,0],["أَلَم يَجِئها نَبَأٌ جاءَنا","بِأَنَّ مِصراً حُرَّةٌ تَمرَحُ",12,"ح",1,0],["أَلَم يَكفِنا أَنّا سُلِبنا ضِياعَنا","عَلى حينِ لَم نَبلُغ مِنَ الفِطنَةِ المَدى",13,"د",2,0],["أَلَم يَأنِ أَن يَبكي الغَمامُ عَلى مِثلي","وَيَطلُبَ ثَأري البَرقُ مُنصَلَتَ النَصلِ",14,"ل",1,1],["أَلَم يَأتيكَ وَالأَنباءُ تَنمي","بِما لاقَت سَراةُ بَني العُبَيدِ",15,"د",1,1],["أَلَم يَأنِ لي يا قَلب أَن أَترُكَ الجَهلا","وَأَن يُحدِثَ الشَيبُ المُلِمُّ لِيَ العَقلا",16,"ل",2,0],["أَلَم يَحزُنكَ يومَ غَدَت حُدوجُ","لِعَزَّةَ إِذ أَجَدَّ بِها الخُروجُ",17,"ج",1,1],["ألَمْ يَكُ الشَّرْقُ مَهْدَ الفَجْرِ أجْمَعِهِ","فِي كُلِّ فَنِّ أَخْذَنَاهُ وَعِرْفَانِ",18,"ن",1,0],["أَلمْ يَكُ الشَّرْقُ مَهْدَ الفَخْرِ أَجْمَعِهِ","فِي كُلِّ فَنٍّ أَخَذْنَاهُ وَعِرْفَانِ",19,"ن",1,0],["أَلَمْ يَحِنْ وَالعَهْدُ قَدْ طَالَ أَنْ","تُنْجِزَ وَعْدَ المُلْهَمِينَ الْكِرَامْ",20,"م",1,0],["أَلَم يَأنِ لِلسَفَرِ الَّذينَ تَحَمَّلوا","إِلى وَطَنٍ قَبلَ المَماتِ رُجوعُ",21,"ع",1,0],["أَلَم يَأتِها أَنّي تَلَبَّستُ بَعدَها","مُفَوَّفَةً صَوّاغُها غَيرُ أَخرَقِ",22,"ق",1,0],["ألم يُبصروا للعدل غير طريقهم","فإن طريق العدل من أوضح الطرق",23,"ق",1,0],["أَلَم يَكُن في وُسومٍ قَد وَسَمتُ بِها","مَن حانَ مَوعِظَةٌ يا حارِثَ اليَمَنِ",24,"ن",1,1],["أَلَم يُنهَ عَنّي الناسُ أَن لَستُ ظالِماً","بَرِيّاً وَأَنّي لِلمُتاحينَ مِتيَحُ",25,"ح",1,0],["أَلَم يَأتِهِم أَنَّ الأُخَيطَلَ قَد هَوى","وَطَوَّحَ في مَهواةِ قَومٍ تَطَوُّحُ",25,"ح",1,0],["أَلَم يَكُ في ثَلاثِ سِنينَ هَجرٌ","فَقَد طالَ التَجَنُّبُ وَالصُدودُ",26,"د",1,0],["أَلَم يَنهَكُم أَنّي رَمَيتُ مُجاشِعاً","بِأَسهُمِ رامٍ لا أَشَلَّ وَلا عَمي",27,"م",2,0],["أَلَم يَكُ لا أَبا لَكَ شَتمُ تَيمٍ","بَني زَيدٍ مِنَ الحَدَثِ العَظيمِ",28,"م",1,1],["ألَم يَتَدَبَّر آيةً فَتَدُلُّه","على تَركِ ما يأتي أو القَلبُ مُقفَلُ",29,"ل",1,0],["أَلَم يَنهَكِ الشَيبُ الَّذي حَلَّ نازِلاً","وَلِلشَيبِ بَعدَ الجَهلِ لِلمَرءِ رادِعُ",30,"ع",1,0],["أَلَم يَرَ هَذا الناسُ غَيرِيَ فاضِلاً","وَلَم يَظفَرِ الحُسّادُ قَبلي بِماجِدِ",31,"د",1,0],["أَلَم يَكُ فيكُم ذا بَلاءٍ وَمَصدَقٍ","وَأَوفاكُمُ عَهداً لَدى كُلِّ مَشهَدِ",32,"د",1,0],["أَلَم يَقتُلوا عَمراً وَعُتبَةَ وَاِبنُهُ","وَشَيبَةَ وَالحَجّاجَ وَاِبنَ حَبيبِ",33,"ب",1,0],["ألم يُرْض أرض الواديين بحفّل","من السحبِ إلا أنهنَّ أنامل",34,"ل",1,0],["ألم يكفك اللحظ الذي صال وانتشى","فلم يخل في الحالين من صفة الإثم",35,"م",1,0],["ألم يكن قدرُ حقي أن توفِّيَهُ","إلّا أُعَيْوِرَ لا يُهدَى لتوقيتِ",36,"ت",1,0],["ألم يُلْحقْكَ أوشكَ ما لحاقٍ","بإخوتك المسوخ من القرودِ",37,"د",1,0],["ألم ير أن الأمر في الأرض أَمره","وأن الذي يعصيه ليس بخالدِ",38,"د",1,0],["ألم يكن واجباً عليك له","ذاك بحقٍّ إنْ صُحِّحَ النظر",39,"ر",1,0],["ألم يَرني الأمير حبستُ شعري","عليه ولم أُذِله بمدح جِبس",40,"س",1,0],["ألم يبن هاشمُكم مجدَكم","وعبد منافكمُ في النياف",41,"ف",1,0],["ألم يتجهمْكُمْ بمدحٍ كأنه","شَبا الحدّ أسَرى في البقاعِ من النملِ",42,"ل",1,0],["ألم يكفِها أن المشيبَ أفاتني","نصيبيَ من وصل الحسانِ العطائلِ",43,"ل",1,0],["أَلَم يَكُ في يَومِ القَناةِ ثَباتُهُ","دَليلاً عَلى أَن لَيسَ توهى مَرائِرُه",44,"ر",2,0],["أَلمَ يَكُن يَكمُلُ هَذا الوَرى","إِلّا إِذا أَوجَدتَني في فَساد",45,"د",1,0],["أَلَم يوقِظكَ مَن ذَكَّ","رَ بِاللَهِ وَمَن سَبَّح",46,"ح",1,0],["أَلَم يَأتِ عَمرواً وَالمَفاوِزُ دونَهُ","مَصارِعُ ساداتِ الأَراقِطِ وَالنَمرِ",47,"ر",1,0],["أَلَم يَأتِ حَيّاً بِالجَريبِ مَحَلُّنا","وَحَيّاً بِأَعلى غَمرَةٍ فَالأَباتِرِ",48,"ر",1,0],["أَلَم يَسأَلِ الرَكبُ الدِيارَ العَوافِيا","بِوَجهِ نَوى مِن حَلَّها أَو مَتى هِيا",49,"ي",2,1],["ألم يبرحوا سارين أم تركوا السرى","وحلوا بسهل بعد ذلك أم صعبِ",50,"ب",1,0],["ألم يمش الثرى قحة عليها","وكان ركابها نحو الثريا",51,"ي",2,0],["أَلَم يَقُل مَن قَولُهُ الصَوابُ","ما عِندَنا لِسائِلٍ جَوابُ",52,"ب",1,0],["أَلَم يَكُ بَينَنا بَلَدٌ بَعيدٌ","فَصَيَّرَ طولَهُ عَرضَ النِجادِ",53,"د",1,0],["أَلَم يَحذَروا مَسخَ الَّذي يَمسَخُ العِدا","وَيَجعَلُ أَيدي الأُسدِ أَيدي الخَرانِقِ",54,"ق",1,0],["ألمْ يَرَ هذا اللّيْلُ عَيْنَيْكِ رُؤيَتي","فَتَظْهَرَ فيهِ رِقّةٌ وَنُحُولُ",55,"ل",1,0],["أَلَم يَسأَلِ الوَبلُ الَّذي رامَ ثَنيَنا","فَيُخبِرَهُ عَنكَ الحَديدُ المُثَلَّمُ",56,"م",1,0],["ألَم يُلفِكَ الشرفُ اليعرُبيّ","وأنتَ غريبَةُ أهل الزَمَن",57,"ن",1,0],["ألم يزجُرِ الأعداءَ عنك عوائدٌ","من اللّهِ فيهن اعتبارٌ وتأديبُ",58,"ب",1,0],["ألم يستبينوا أن بُقياكَ رحمةٌ","وحِلمَكَ تأديبٌ وعفوَكَ تثريبُ",58,"ب",1,0],["أَلَم يوسِعكَ مِن غُرَفٍ","تَخالُ جِفانَها جُوَبا",59,"ب",2,0],["أَلَم يَأتِ مِنّا رَبُّ كُلِّ قَبيلَةٍ","بِحَيثُ جِمارُ القَومِ يُلقى حِصابُها",60,"ب",3,0],["أَلَم يَكُ جَهلاً بَعدَ سَبعينَ حِجَّةً","تَذَكُّرُ أُمَّ الفَضلِ وَالرَأسُ أَشيَبُ",61,"ب",1,1],["أَلَم يَكُ جَهلاً بَعدَ سِتّينَ حِجَّةً","تَذَكُّرُ أُمِّ الفَضلِ وَالرَأسِ شَيبُ",62,"ب",1,1],["أَلَم يَكُ لِلبَرشاءِ هادٍ يُقيمُها","عَلى الحَقِّ إِذ كانَت بِها الأَزدُ ضَلَّتِ",63,"ت",1,1],["أَلَم يَكفِني مَروانُ لَمّا أَتَيتُهُ","نِفاراً وَرَدُّ النَفسِ بَينَ الشَراسِفِ",64,"ف",1,0],["أَلَم يَأتِ بِالشَأمِ الخَليفَةَ أَنَّنا","ضَرَبنا لَهُ مَن كانَ عَنهُ يُخالِفُ",65,"ف",1,1],["أَلَم يَكُ مِمّا يُرعِدُ الناسَ أَن تَرى","كُلَيباً تَغَنّى بِاِبنِ لَيلى تُناضِلُه",66,"ل",2,0],["أَلَم يَأتِهِ أَنّي تَخَلَّلُ ناقَتي","بِنَعمانَ أَطرافَ الأَراكِ النَواعِمِ",67,"م",1,0],["أَلَم يَكُ في الإِسلامِ مِنّا وَمِنكُمُ","حَواجِزُ أَركانٍ عَزيزٍ مَرامُها",68,"م",3,0],["أَلَم يَكُ قَتلُ عَبدِ القَيسِ ظُلماً","أَبا حَفصٍ مِنَ الحُرَمِ العِظامِ",69,"م",1,1],["أَلَم يَكُن مُؤمِنٌ فيهِم فَيُنذِرَهُم","عَذابَ قَومٍ أَتَوا لِلَّهِ عِصيانا",70,"ن",2,0],["ألمَّ يُتحِفُهُ بالوَرْدِ من خَفَرٍ","في وجنتَيْهِ وبالصهَّباءِ من شَنَبِ",71,"ب",1,0],["أَلَم يَأنِ لي يا نَفسُ أَن أَتَنَبَّها","وَأَن أَترُكَ اللَهوَ المُضِرَّ لِمَن لَها",72,"ه",2,1],["أَلَم يَكُ في وَجدي وَبَرحِ تَلَدُّدي","نِهايَةُ نَهيٍ لِلعَذولِ المُفَنِّدِ",73,"د",1,1],["أَلَم يَقولوا بِأَنَّ الشُهبَ خالِدَةٌ","طَبعاً فَأَينَ شِهابُ الدينِ مَحمودُ",74,"د",1,0],["ألمي محا ذنبي إليك وكفّرا","هبني أسأت ألم يحن أن تغفرا",75,"ر",2,1],["ألم يسبِ جيشُ الغزو منهم نواعِماً","فَمن ثيِّبٍ تُقْتادُ في إثرها بِكرُ",76,"ر",1,0],["أَلَم يَأنِ تَركي لا عَلَيَّ وَلا لِيا","وَعَزمي عَلى ما فيهِ إِصلاحُ حالِيا",77,"ي",2,1],["أَلَم يَهزُزكَ قَولُ فَتىً يُصَلّي","لِما يُثني عَلَيكَ بِهِ الثَناءُ",78,"ا",2,0],["أَلَم يُختَرَم عَمرٌو وَعَمرٌو فَوَدَّعا","وَلاقى الحُوَيّانِ المَنايا وَماتِعُ",79,"ع",1,0],["أَلَم يَكُ أَقتَلَهُم لِلأُسودِ","صَبراً وَأَوهَبَهُم لِلظِباءِ",80,"ا",2,0],["أَلَم يَجلِبِ الخَيلَ مِن بابِلٍ","شَوازِبَ مِثلَ قِداحِ السَراءِ",80,"ا",2,0],["أَلَم يُقنِعكِ فيهِ الهَجرُ حَتّى","بَكَلتِ لِقَلبِهِ هَجراً بِبَينِ",81,"ن",1,0],["أَلَم يَأنِ أَن تَروى الظِماءُ الحَوائِمُ","وَأَن يَنظِمَ الشَملَ المُشَتَّتَ ناظِمُ",82,"م",1,1],["أَلَمْ يَأْنِ أَنْ يَرْضَى عَنِ الدَّهْرِ مُغْرَمُ","أَمِ الْعُمْرُ يَفْنَى وَالْمَآرِبُ تُعْدَمُ",83,"م",1,1],["ألمْ يكُ فيكمُ رجلٌ رشيدٌ","يرى سجنَ الإمامِ فيُستشاطُ",84,"ط",1,0],["أَلَم يُسلِني نَأيُ المَزارِ صَبابَتي","إِلى أُمِّ عَبدِ اللَهِ وَالنَأيُ قَد يُسلي",85,"ل",2,1],["أَلَم يُسَقِّيَني سُلافَةَ ريقِهِ","وَطَوراً يُحَيِّني بِآسِ عِذارِ",86,"ر",1,1],["أَلَم يَأنِ لِلدَهرِ أَن يَزدَجِرْ","فَقَد أَتعَبَ الناسَ ما يَأتَمِرْ",87,"ر",1,0],["أَلَم يَئنِ مِن قَومي إِلى عُلوَ نَهضَةٌ","لِإِجلاءِ عِقبانٍ عَلى مِصرَ حُوَّمِ",88,"م",1,0],["أَلَم يَكُ ظِلَّ اللَهِ بِالأَمسِ بَينَنا","نَلوذُ بِهِ وَالخَطبُ ضَنكٌ مَذاهِبُه",89,"ب",2,0],["أَلَم يَقضِ مِنها لَيلَةً نازعَ الكَرى","مَخافَةَ عادٍ يُفزِعُ المُلكَ واثِبُه",89,"ب",2,0],["أَلَم يَستَطِر يَوماً لِخَطبٍ مُساوِرٍ","مُحافَظَةً مِن أَن تَسوءَ عَواقِبُه",89,"ب",2,0],["أَلَم يَئنِ أَن تَزَعَ الجاهِلينَ","فَنَحيا وَنَأمَنَ ما نَرهَبُ",90,"ب",1,0],["أَلم يَدرِ أَنّ الصدقَ أَهدى طَريقَةً","وَأَجدى وَأَنّ الحَقَّ أَقوى وَأَقوَمُ",91,"م",1,0],["ألم يَكُ في المعشرِ القاعدين","فماذا عراهُ وما أَقْدَمَهْ",92,"م",2,0],["ألم يكُ أهلُ الأرضِ مَوْتَى فجاءهم","رَسُولُ حياةٍ دِينُهُ البَعْثُ والنَّشْرُ",93,"ر",1,0],["ألم ير هنداً يرحم السَّيفُ ضعفَها","فَيَصدف عنها وافِرَ البرِّ وافيا",94,"ي",2,0],["ألم يَسمعْ فريقُكَ حين نادى","أطيعوا الله واتّبعوا الرسولا",95,"ل",2,0],["ألم يكن أخذَ الميثاقَ من قِدَمٍ","فما المقامُ على كُفرٍ وإنكارِ",96,"ر",1,0],["ألم يكنْ في قومِه كوكباً","لاحَ ليمحو نورُه الغيهبا",97,"ب",2,0],["أَلم يَعلَمُوا لا بُرِكُوا أَنَّ قَلبَهُ","عَصى قَبلَهُم فيها العِدى فَهُوَ مُبهَلُ",98,"ل",1,0],["أَلم يُنسِ لَيلى عَهدُكَ المُتَباعِدُ","وَدَهرٌ أَتى بَعدَ الَّذي زَلَّ فاسِدُ",99,"د",1,1],["أَلَم يَكُ في شَرطِ السُقاةِ عَلَيكُما","بِأَنَّ النَدامى تَترُكُ العَقلَ واهِيا",100,"ي",2,0],["ألم يُبْدِ سِرَّ الحُبّ أنّ منَ الضّنى","رقيباً وإنْ لم يهتِكِ السترَ هاتِك",101,"ك",1,0],["ألَمْ يأتِها أنّا كَبُرْنا عنِ الصِّبَى","وأنّا بَلينا والزّمانُ جَديدُ",102,"د",1,0],["أَلَم يَنهَكَ الزِنجِيُّ عَنّي وَصِيَّةً","وَقالَ اِحذَرِ الرِئبالَ إِنَّكَ مُعوِرُ",103,"ر",1,0],["أَلَم يَبلُغ أَبا العَبّاسِ أَنّا","وَتَرناهُ وَلَيسَ بِهِ اِتّئارُ",104,"ر",1,0],["أَلَم يَأنِ أَن تَسلى مَوَدَّةَ مَهدَدا","فَتَخلُفَ حِلماً أَو تُصيبَ فَتَرقُدا",105,"د",2,1],["أَلَم يَتَبَيَّنوا الخَطبَ المُوارى","بِجَهلٍ أَم قَضاءُ اللَهِ يُعشي",106,"ي",1,0],["المَينُ أَهلَكَ فَوقَ الأَرضِ ساكِنِها","فَما تَصادَقَ في أَبنائِها الشِيَعُ",107,"ع",1,1],["أَلَم يَرَ أَفعالَكَ الشارِقُ","وَكَوكَبُ لَيلَتِكَ الطارِقُ",108,"ق",1,1],["أَلَم يَكُ هَذا الشرق من قبل أَعصرٍ","مضت لك أستاذاً كبيراً يعلم",109,"م",1,0],["ألم يغط جسمك الشعر","وبعده الزغب",110,"ب",1,0],["أَلَم يجدوا في باطن الأرض مرقداً","كما وجدوا في ظاهر الأرض مرقدا",111,"د",2,0],["ألم يَتَغَيَّرْ بها الحاكمون","ألم تَتَبَدَّلْ من الحال حالا",112,"ل",2,0],["ألم يضربا موعدا للقاء","على صخرة بين رمل وماء",113,"ا",2,0],["ألمْ يَنسِمِ الخُلدَ من عطرها","ألمْ يعْبدِ الحسنَ في زهرِها",114,"ه",2,0],["ألم يقبسِ النورَ من فجرها","ألم يسرقِ الفنَّ من سحرِها",114,"ه",2,0],["المين من أترابه والدين من","أضدادها والهم من حلفائها.",115,"ا",3,0],["ألم يَبْلُغْكَ فَتْكي بالمَواضي","وسُخْري بالأسِنّةِ والزُّجاجِ",116,"ج",1,1],["ألم يأتِكُمْ أني تَفَرّدْتُ بَعْدَكمْ","عن الإنس مَن يشْرَبْ من العِدّ يَنْقَع",117,"ع",1,0],["ألم يك التاريخ ظل العالم","وأقدم الأعلام والمعالم",118,"م",1,0],["أَلَم يَشِفيَنكَ أَنَّ نَومي مُسَهَّدٌ","وشَوقي إلى ما يَعتَريني وتَسهالي",119,"ي",1,0],["أَلم يَحزنَكَ أَنَّ أَبَاكَ عانٍ","وأنتَ مُغَيَّبٌ غالَتكَ غُولُ",120,"ل",1,0],["أَلَمْ يَأن لِلأَيَّامِ أَنْ تُبْصِرَ الْهُدَى","فَتَخْفِضَ مَأْفُوناً وَتَرْفَعَ جهْبذَا",121,"ذ",2,0],["أَلَمْ يَرَوْا كَيْفَ مَضَتْ قَبْلَهُمْ","مِنْ أُمَمٍ لَيْسَ لَهَا ذَاكِرُ",122,"ر",1,0],["أَلَمْ يَتَبَيَّنْ سُوَْ مَا تُضْمِرُ الدُّجَى","وَاَسْتَارُهَا فِي الصُّبْحِ مُنْتَهِكَاتُ",123,"ت",1,0],["أَلَمْ يَمْنحِ الآدَابَ وَالعِلْمَ عَوْنَهُ","وَمَا يَبْتِغي مِنْ غَيْرِ خالِقِهِ أَجْرَا",124,"ر",2,0],["أَلَمْ يَرْعَ شَأْنَ المُسْتَمِدِّينَ رِزْقَهُم","مِنَ الكَدِّ زُرَّاعاً يَكُونُونَ أَوْ تَجْرَا",124,"ر",2,0],["أَلَمْ يُعْطِ بِالبَذْلِ الْوَجَاهَةَ حَقَّهَا","وَكمْ يَتَناسَى الحَقَّ مَنْ أَعْطِيَ الوَفْرا",124,"ر",2,0],["أَلَمْ يَكُ فِي سَمَاءِ العَصْرِ نَجْماً","فَبَعْدَ شُرُوقِهِ زَمَناً غُرُوبُ",125,"ب",1,0],["أَلَمْ يَكُنْ أَوْحَدَهَا مُنْتَهَى","أُمْنِيةِ النَّاجِلِ أَنْ يَنْجُلاَ",126,"ل",2,0],["أَلَم يَعلَمِ الذُلّانُ أَنَّ بَني الوَغى","كَذاكَ سَليبٌ بِالرِماحِ وَسالِبُ",127,"ب",1,0],["ألَم يَكُن مِن دَراريِّ العُلا قَمَراً","لَهُ إِذا غابَتِ الأَقمارُ إِشراقُ",128,"ق",1,0],["أَلَم يَقتَنِص مِنكَ الرَدى فَرخ أَجدلٍ","يَرد البزاةَ الشُهبَ أَغرِبَةً بُقعا",129,"ع",2,0],["ألم يأنِ لي منكَ أن ترحما","وتعصى العواذِلَ واللوّما",130,"م",2,1],["أَلَم يَحزُنكَ أَنَّ بَني زِيادٍ","أَصابوا بِالتِراثِ بَني النَبِيِّ",131,"ي",1,0],["أَلَمْ يُعْلِ صَرْحَ العِلْمِ شُمّاً قِبَابُه","تُطَالِعُهَا زُهْرُ الكواكِبِ حُسَّدَا",132,"د",2,0],["ألم يحوِّلْ شعاعُ الشمس ماءَك من","ملْح أجاج إلى عذب من الدِّيم؟",133,"م",1,0],["ألم يجدوا للشَّيْبِ مصلاً يُزيلُه؟","ألم يجدوا منه طَبيبًا مُدَاويا؟",134,"ي",2,0],["ألم يبلغ أبا العباس أنا","وَتَرْنَاهُ ولَيْسَ بهِ کتّئَارُ",135,"ر",1,0],["ألمْ يدرِ هذا \" الكوكب ! \" الفذ أنه","كما كان حُرّاً كان كلُّ امرئٍ حرّا",136,"ر",2,0],["ألمْ يحزنكَ أنَّ بني زيادٍ","* أَصَابُوا بالتِّراتِ بني النبيّ",137,"ي",1,0],["ألم يبق في الناس إلاالمكروالملق","شوك،إذا لمسوا،زهر إذا رمقوا",138,"ق",3,1],["ألمْ يأنِ لي يا قلبُ أن أترك الجهلا","وأن يُحدِثَ الشّيبُ المُلِيمُّ لِيَ العَقْلا",139,"ل",2,0],["ألَمْ يَكُ جَهْلاً بَعْدَ سِتّينَ حِجّةً","تَذَكُّرُ أُمِّ الفَضْلِ وَالرّأسُ أشْيَبُ",140,"ب",1,1],["ألَمْ يأتِهِ أنَّني تَخَلّلُ نَاقَتي","بنعْمَانَ أطْرَافَ الأرَاكِ النّوَاعِمِ",141,"م",1,0],["ألمْ يأتِ عمرًا والمفاوزُ دونهُ","مصارعُ ساداتِ الأراقطِ والنّمرِ",142,"ر",1,0],["الم يذكر لنا ود قديم","ولم تذكر ليالينا القدام",143,"م",1,0],["المى الثغير يفوح عاطر مسكه","وبفاض معنى السكر من جرياله",144,"ل",2,0],["الم يكف ان العرب منا اعاجما","غدت وجفاة العجم صارت اعاربا",145,"ب",2,0],["ألم يدر أني للنبي وآله ان","تمائي وقد عقدت حبلي بحبله",146,"ل",2,0],["ألم يخبرك يا حبيبي","تهضم الوجه والنحول",147,"ل",1,0],["ألم يبلغك واأسفا","ه أني ابن خمسينه",148,"ن",2,0],["ألم يتلُ النبيُّ عليك قولا","من القرآن ذكراً يا كَفُورَا",149,"ر",2,0],["ألم يان ارعواءك حين آنا","مشيبك والتحلم آن لآنا",150,"ن",2,0],["ألَم يَأنِ أن تَجفُو الصِّبَا وتَحَلَّمَا","وتَأنَفُ عَن صَهبَا لَمَى رَبَّةِ اللَّمَى",151,"م",2,1],["أَلَم يَكُن زَينَ أَهلِ الأَرضِ كُلِّهِم","وَعِصمَةَ الخَلقِ مِن عادٍ وَمِن أرِمِ",152,"م",1,0],["ألم يكفِها ما قد جنتهُ شموسُها","على القلب حتى ساعدتها بدورُها",153,"ر",3,0],["ألم يأن تلفي لبينك غايةً","فتُدرَكُ آمال وتَحسُن حال",154,"ل",1,0],["ألَم يأنِ أَن يَروى فؤادُ مُتَيَّمٍ","تفيضُ مَاقي جَفنهِ وَهوَ يَظمَأُ",155,"ا",1,1],["أَلَم يُقسِمِ الرَحمَنُ بِالنَجمِ إِذ هَوى","عَلى أَنَّهُ ما ضَلَّ قَطُّ وَما غَوى",156,"غ",3,0],["ألم يقل التوحيد اثبات وحدة","بها كل مربوب لديه مرتب",157,"ب",1,0],["ألم يبدها صلى عليه إلهنا","لكم سنة بيضاء لا تتسخب",157,"ب",1,0],["أَلَم يَجلِبِ الجُردَ العِتاقَ شَوازِباً","مِنَ الخَطِّ تَتلُوها المَطايا المَراسِلُ",158,"ل",1,0],["أَلَم يَكُ أَمضاها جَناناً وَصارِماً","وَأَطوَلَها إِذ ذاكَ باعاً وَذابِلا",159,"ل",2,0],["أَلَم يَأتِ مِن أَرضِ الشَواجِنِ يَختَطي","حَرابِيَّ أَجوَازِ الفَلا وَالخمائِلا",159,"ل",2,0],["أَلَم يَأنِ أَن تَنسى عَسى وَلَعَلَّما","وَتَترُكَ لَيتاً لِلمُعَنّى وَرُبَّما",160,"م",2,1],["أَلَم يَكُ أَمضاها جَناناً وَصارِماً","وَلِلبيضِ وَقعٌ في الطُلا وَالجَماجِمِ",161,"م",1,0],["أَلم يَلقَ الرَدى مِنهُ بِقَلبٍ","عَلى الأَهوالِ أَثبتَ مِن أَبانِ",162,"ن",1,0],["أَلَم يُخلِ أَرضَ السَيبِ بِالسَيفِ مِنهُما","وَكانا بِغَيرِ الحَقِّ قَد عَمَراها",163,"ا",3,0],["ألم يعمروا الدنيا ألم يبتنوا العلى","ألم ينعموا فيها وللطير رفرف",164,"ف",1,0],["أَلَم يَشرحِ الرحمنُ صدرَ مُحمّدٍ","وَأَكّد أنّ العسرَ يَستصحبُ اليُسرا",165,"ر",2,0],["أَلَم يبلغكَ ما فعلَت رقاهُ","بِطرفِ قتادةٍ إذ سالَ سيلا",166,"ل",2,0],["ألم يأن لها أن","ترحم المجنون أم بعد",167,"د",1,0],["ألم يكفِ أن كانتْ خدودكِ فتنةً","لنا فتزينينَ الخدودَ بيشمقِ",168,"ق",1,0],["ألم يكن عمرُ يرعى المخاضَ فهل","ترى العلا بطنَ وادٍ فيه آبالُ",169,"ل",1,0],["أَلَم يَكُ مِنّا الجَارَ فيكُم فَتَغضَبوا","لَما نيلَ مِنَ عِرضٍ وَمالٍ مُنهَّكِ",170,"ك",1,0],["ألم يكفني ما نالني في هواكمُ","إلى أن طفقتم بين لاهٍ وضاحكِ",171,"ك",1,1],["ألم يكف في بغداد ما الحبّ صانعٌ","وأخطر ما يرمى القلوب هو الحب",172,"ب",1,0],["الم يأتهم أن النجوم إذا هوت","تصير رجوماً لا تنهنه بالزجر",173,"ر",1,0],["ألم يثقل على حكماء قومى","وقد عاقرتها وزر اغتيابي",174,"ب",2,0],["ألم يهب الشاء الكثيرة عدادها","لعافٍ أتاه يعتريه ويقنع",175,"ع",1,0],["أَلَم يَملَأ بَسيطَ الأَرضِ مَدحي","وَأَقطارَ السَماءِ لَكُم دُعاءِ",176,"ا",2,0],["ألم يمنعونا عن شعائر ديننا","كما صد عنها القرمطي المخرب",177,"ب",1,0],["ألمى رشيق القدّ أرجو الري من","معسوله وأخاف من عسّالهِ",178,"ل",2,0],["أَلَم يَأتِها أَنَّ الدُموعَ نَطافَةٌ","لِعَينٍ يُوافي في المَنامِ حَبيبُها",179,"ب",3,0],["ألم يرضك الرحمن في سورة الضحى","وما بعدها إذ كنت أنت المقرّب",180,"ب",1,0],["ألم يأن من هذا الزمان افاقة","وما آن أن يمحو الضلالة رشده",181,"د",2,0],["ألم يزجر الأعداء يوم شهدته","على كلس ما بين تلك الكتائب",182,"ب",1,0],["ألم يقرعوا بالحق سمعك قل بلى","وذكرت بالآيات لو تنفع الذكرى",183,"ر",2,0],["أَلَمْ يَعْلَمُوا أَنَّ العَوائِقَ دُونَهُم","قَلائِلُ فِي عُقْبَى إِبادَةِ مَنْ عَقَّا",184,"ق",2,0],["أَلَمْ يَخْلَعوا زُهْداً وحِرْصاً عَلَى الهُدَى","ومِن عَجَبٍ أنْ يُعْضَدَ الزُّهْدُ بالْحِرْصِ",185,"ص",1,0],["ألَم يُورِدِ الأَعداء مُستَفظَع الرَّدى","لِعِيشَةِ مُغتَمٍّ بِمِيتَةِ مُغتَصِّ",186,"ص",1,0],["ألَمْ يَسُمْه غُرابُ الغَرْبِ يا أَسَفا","ما عادَ فيهِ جُمانُ الدَّمْعِ مرْجانا",187,"ن",2,0],["ألَمْ يَكُ لِلآمالِ كَعْبَةَ حِجِّها","وكان لذي الأوْجالِ في حِجرِهِ حِجرا",188,"ر",2,0],["أَلَمْ يغْنِنِي بَحْرٌ جُودِكَ زاخِرٌ","أَلَمْ يَحْمِنِي طَوْدٌ بِعِزِّكَ شاهِقُ",189,"ق",1,0],["أَلَمْ يَكُ لِي مِنْ حُسْنِ رَأْيِكَ صارِمٌ","لِهامِ الْعِدى والْفَقْرِ وَالدَّهْرُ فالِقُ",189,"ق",1,0],["ألم يعدِ الله الكريمُ بفضله","مع العسر يسراً ينجح السعي والقصدا",190,"د",2,0],["ألم يكفك النصر المقهقر خسة","فلا حول ما هذا التملق كالقرد",191,"د",1,0],["أَلَم 