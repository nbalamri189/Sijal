oetsgate.com/ViewPoem.aspx?id=27063",""],[5864,"يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=190488",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""],[199,"يتبعنَ ناجية ً كأنَّ بدفها","https://www.poetsgate.com/ViewPoem.aspx?id=22436",""],[520,"قدك مثل الغصن في اعتداله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577613",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""],[2220,"إنّ لله عباداً كلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11457&r=&rc=331",""],[2220,"الحمدُ للهِ الذي أفضلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11602&r=&rc=476",""],[6359,"عمّان البلد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69088&r=&rc=2",""]],"verses":[["يَتبَعنَ قُلَّةَ رَأسِهِ وَكَأَنَّهُ","حِدجٌ عَلى نَعشٍ لَهُنَّ مُخَيَّمِ",0,"م",1,0],["يَتَبادَرونَ فِنائَهُ","قَبلَ الشُروقِ وَبِالأَصائِل",1,"ل",1,0],["يتبعها المحشي من كوسى يحب","ومن كوارع وأوراق عنب",2,"ب",1,0],["يَتبَعنَ شَأوَ عَلَنداةٍ مُذَكَّرَةٍ","خَطّارَةٍ حُرَّةٍ إِحدى المَماهيرِ",3,"ر",1,0],["يتبؤأون به وإِنْ بعد المدى","من جاهك الأعلى أعزَّ جوارِ",4,"ر",1,0],["يتبادرن بالرواء من الشرب","أمام القلوب عيراً فعيرا",5,"ر",2,0],["يَتَبارَينَ في الدُعاءِ إِلى اللَ","هِ وَكُلُّ الدُعاءِ لِلشَيطانِ",6,"ن",1,0],["يتبارى إليه مُنْتجعُو العُرْ","فِ فيلقوْنَ مُزهِر الأرواض",7,"ض",1,0],["يتبعها ردف لها راجحٌ","يثوخ فيها أكثرُ الإصبع",8,"ع",1,0],["يتبارى إليهِ وفدانِ شتّى","وفدُ شكرٍ يحثُّ وفدَ سؤالِ",9,"ل",1,0],["يُتْبع النفسَ كلَّ بيضاءَ شالتْ","من دماءِ الرجال ذاتَ انتقالِ",10,"ل",1,0],["يُتبِعُ وسمِيّه الولِيَّ وقد","أغنى جديب البقاع إن وسما",11,"م",2,0],["يتبرأون من الجُلو","د لمنْ هَوُوْا ومن اللحومِ",12,"م",1,0],["يَتبَعُهُ مِثلُ هُدّابِ المُلاءِ لَهُ","مِنها أَعاصيرُ مَقطوعٌ وَمَوصولُ",13,"ل",1,0],["يَتبَعنَ مائِرَةَ اليَدَينِ شِمِلَّةً","أَلقَت بِمُختَرَقِ الرِياحِ سَليلا",14,"ل",2,0],["يتبسمان بشاشة واليوم قد","ذهبت بشاشات الأحبة أجمع",15,"ع",1,0],["يَتبَعُهُ حَيثُ مَشى خِنزيرُ","في جيدِهِ قِلادَةٌ تُنيرُ",16,"ر",1,0],["يَتَبَسّمْنَ قائِمَاتٍ صُفُوفاً","فإذا ما رَكَعْنَ قَهْقَهْنَ ضِحْكا",17,"ك",2,0],["يُتَبِّعُ هُرّابَ الرِجالِ مُرادُهُ","فَمَن فَرَّ حَرباً عارَضَتهُ الغَوائِلُ",18,"ل",1,0],["يَتبَعُ تَأميلَهُ الثَراءُ كَما","أَتبَعُ غُزراً مِن ديمَةٍ عُشُبُه",19,"ب",2,0],["يَتَبَسَّمنَ عَن شَتيتٍ أَراهُ","أُقحُواناً مُفَصَّلاً أَو فَريدا",20,"د",2,0],["يُتبِعُ الوَعدَ بِنُجحٍ عاجِلاً","فَسَواءٌ مِنهُ أَعطى أَو وَعَد",21,"د",1,0],["يَتَبَسَّمنَ مِن وَراءِ شُفوفِ ال","رَيطِ عَن بَردِ أُقحُوانِ الثُغورِ",22,"ر",1,0],["يَتَبَغّى العَدُوُّ فيهِ مَناصاً","يَتَوَقّى بِهِ وَأَنّى مَناصُه",23,"ص",2,0],["يَتبَعُ النَهجَ الأَشَطَّ المُنتَوى","في مَعالي الأَمرِ وَالفِعلِ الأَشَق",24,"ق",1,0],["يَتبَعنَ مَنصورَةً تَروى إِذا لَقِيَت","بِقانِئٍ مِن دَمِ الأَجوافِ مَغصوبِ",25,"ب",1,0],["يَتَباشَرونَ بِمَوتِهِ وَوَراءَهُم","مِنّي لَهُم قِطَعُ العَذابِ المُرسَلِ",26,"ل",1,0],["يَتبَعنَهُم سَلَفاً عَلى حُمُراتِهِم","أَعداءَ بَطنِ شُعَيبَةِ الأَوشالِ",27,"ل",1,0],["يَتَبايَعونَ إِذا اِنتَشَوا بِبَناتِكُم","عِندَ الإِيابِ بِأَوكَسِ الأَثمانِ",28,"ن",1,0],["يَتَبارَونَ في السِباحِ فَهُم مِن","بَينِ ناجٍ مِنهُم وَبَينِ غَريقِ",29,"ق",1,0],["يَتبَع هَواهُ وَلا لَقاحَ لِرَهطِهِ","بَسلٌ وَلَيسَت أَرضُهُ بِحَرامِ",30,"م",1,0],["يتبسّمُ الإِسلامُ في نظراتِه","بَيْنَا يراه النّاظرون عَبوسا",31,"س",2,0],["يَتَبَرّكُ الرّوحُ الزّكيُّ بقُرْبِهِ","نُسْكاً ويُرْوي مُهجَةَ الهَيمانِ",32,"ن",1,0],["يَتَبَسَّمونَ إلى الوغى فشِفاهُهُمْ","هُدْلٌ إلى أقْرانِهِمْ لم تَقْلِص",33,"ص",1,0],["يَتبَعنَ مائِرَةَ المِلاطِ كَأَنَّما","تَرنو بِعَينَي مُقلِتٍ لَم تَفرَقِ",34,"ق",1,0],["يَتبَعنَ مَخذولاً وَأَشياعَهُ","بِالعَينِ فَالرَوحاءَ فَالمَرقَبِ",35,"ب",1,0],["يَتَبارَيانِ وَيَسلُكا","نِ إِلى الوَرى ضيقَ المَسالِك",36,"ك",1,0],["يتبع الجاهل الغويُّ أخاه","مثلما يتبع الضريرَ الضريرُ",37,"ر",1,0],["يَتَباين عند مزاحمة","عقل الإنسان وَمحتده",38,"د",2,0],["يَتْبَعْنَ مِنْ عَارِكٍ بِيضٍ سَلاَئِقُهُ","بَعْضَ الَّذِي كانَ مِنْ عَادِاتِهِ سَلَفِا",39,"ف",2,0],["يَتَبَارَوْنَ رِجَالاً بِالنَّدَى","وَنِسَاءً ذَلِكُمْ نِعْمَ التَّبَارِي",40,"ر",2,0],["يَتَبَارَى فِيهِ القصِيدُ جَمَالاً","وَافْتِنَاناً فِي وَصْفِ رَبِّ القَصِيدِ",41,"د",1,0],["يتبرّكُ الوادي بلَثْم بنانِهِ","فيعودُ وهو المعْشِب المُخْضَوضِرُ",42,"ر",1,0],["يُتْبعُ القولَ بالفعال، وكم من","قائلٍ تَنْقُص الفعال كلامَه",43,"م",2,0],["يَتْبَعْنَ قُلَّةَ رأْسِهِ وكأَنَّهُ","حَرَجٌ على نَعْشٍ لَهُنَّ مُخَيَّمِ",44,"م",1,0],["يتبادلانِ أساهُما","شَكوى الغريبِ إلى الغريب",45,"ب",1,0],["يتبجَّحُونَ بأنَّ موجاً طاغياً","سَدُّوا عليهِ مَنافذاً ومَساربا",46,"ب",2,0],["يتبع الوعد بنجح عاجل","فسواء منه أعطى أو وعد",47,"د",1,0],["يَتَبَغّى العَدُوُّ فيه مَنَاصاً،","يتَوَقّى بهِ، وَأيْنَ مَنَاصُهْ",48,"ص",2,0],["يَتْبَعْنَ مَنصُورَةً تَرْوى إذا لَقِيَتْ","بقانىءٍ من دَمِ الأجوَافِ مَغصُوبِ",49,"ب",1,0],["يُتبعُ بالفرائض النوافلا","أصاب حقاً أم أصاب باطلا",50,"ل",2,0],["يتبعها ردفٌ لها راجح","ينوخ فيها أكثرُ الإصبع",51,"ع",1,0],["يَتبَعنَ هُماماً صَولَتُهُ","تَسطُو بِالأَرعَنِ ذِي الشَمَمِ",52,"م",1,0],["يتبّوا منزلا شعثا","شرّ منه ضيق ملتحده",53,"د",2,0],["يَتبَعنَ ناجِيَةً كَأَنَّ بِدَفِّها","مِن غَرضَ نَسعَيها عُلوبَ مَواسِمِ",54,"م",1,0],["يتبوأون مواقعاً","للحرب مركزها متين",55,"ن",1,0],["يَتبدَّى للَعينِ حَبّاً ويُخفي","عَسَلاً في ظُروفه مختوما",56,"م",2,0],["يُتْبعها الزّمرُ حنِيناً كما","ناح القَمَارِيّ على الرَّنّد",57,"د",1,0],["يُتبِعُ القَولَ بِالفِعالِ لِراجي","هِ وَما كُلُّ قائِلِ فَعّالُ",58,"ل",1,0],["يَتبَعُ ما اِستَنَّ لَهُ في النَدى","آباؤُهُ الحُمسُ الصَناديدُ",59,"د",1,0],["يَتَبَرَّكونَ بِلَثمِ تُربَةِ خَيرِ مَن","قَهَرَ الضَلالَ وَأَظهَرَ التَوحيدا",60,"د",2,0],["يَتبَعُ الناسُ ذلك النورَ أرسا","لاً كما يتبعُ الخميسُ اللّواءَ",61,"ا",2,0],["يتبارَين في النَعيم ويصُببنَ","خِلالَ القرونِ مِسكاً ذكيّا",62,"ي",2,0],["يَتبَعنَ وَخدَ شِمِلَّةٍ","وَجَناءَ تُفسِحُ في الزِمامِ",63,"م",1,0],["يَتبَعنَ ذَيّالاً كَسَرحانِ الغَضا","إِذا سَمَت حَلائِلٌ لَهُ سَما",64,"ا",1,0],["يَتبعُ من فَضلهِ أباهُ","إذا أماتَ الزَّمانُ أحيا",65,"ي",2,0],["يتبرقع الإنسانُ فيها بالعَمى","وعمى البصيرة مشبهٌ لعَماءِ",66,"ا",2,0],["يتبعها ترعية غير ورع","ليس بفان كبراً ولا ضرع",67,"ع",1,0],["يَتبَعُهُ في إِثرِهِ واصِلٌ","مِثلُ رِشاءِ الخُلُبِ الأَجرَدِ",68,"د",1,0],["يتبع طريق السلف الأوائل","مثل الصحابة كل كامل",69,"ل",1,0],["يَتَباهى بِبخلِهِ دون وَصلي","وَهوَ سمح عَلى بُعادي مُنيلُ",70,"ل",1,0],["يَتبَعُني في الهَوى وأَتبَعه","أَكرِم بِهِ تابِعاً وَمُتَّبَعا",71,"ع",2,0],["يَتبَع الرُمح أَمرَهُ إِنَّ عِشر","نَ ذِراعاً بِالرأي تَخدِمُ شبرا",72,"ر",2,0],["يَتبَعنَ ناجِيَةً يَهُزُّ مِراحُها","بَعدَ النُحولِ تَليلَها وَقَذالِها",73,"ل",3,0],["يتّبِعُ السلطانُ أغراضَهُ","فردّهُ الحاكمُ فيما أرادْ",74,"د",1,0],["يتبارون في العلوم ورحنا","نتبارى وعلمنا التلبيس",75,"س",1,0],["يتبارى والمال في قهره الخلق","وإن كان لم يلوث بعيب",76,"ب",1,0],["يتبادرنَ مُروقا من فمِي","فكأنْ لم يتقيَّدن بوزنِ",77,"ن",1,0],["يتباحثون طِلابَ عائرةٍ","عَصَدَتْ على القرطاس من نبلي",78,"ل",2,0],["يتْبَعُ العُرْفَ بعُذْرٍ واسِعٍ","فإذا جادَ كأنْ لم يَجُدِ",79,"د",1,0],["يَتباريانِ فعَزْمُهُ وحُسامُه","سِيَّانِ حِذْقُهُما بعلْمِ مَقاتِل",80,"ل",1,0],["يتبعُهُ أشباهُهُ","على الجيادِ الجُرْدِ",81,"د",1,0],["يتبادلان أساهما","فتحوم حولهما الشجون",82,"ن",1,0],["يتباهى بذكركم فإذا فا","ه بمعناه عطِّرت أردانه",83,"ن",2,0],["يتبع فيه كامل مقلداً","أبا علي وهو من أقياله",84,"ل",2,0],["يَتبَعنَ أَفياءَهُ طَوراً وَمَوقِعَهُ","يَلَغنَ في عَلَقٍ مِنهُ وَتَجسيدِ",85,"د",1,0],["يتبدَّى من رَاحتَيْهِ بكاسٍ","وَيُثنِّي منْ مُقلتيه بكاس",86,"س",1,0],["يتْ بالخفا بالرّاضه","بين النَّحر والثوب",87,"ب",1,0],["يتبوعون وتمتطي أيديهم","في كل معطية الجذاب نتور",88,"ر",1,0],["يتبعها خالص الدعاء شج","هابط حظ وهمه صاعد",89,"د",1,0],["يَتَباكَى ظَالِمًا مَحْبُوبَهُ","كَيْفَ يَبْكي نَاهِبًا مُغْتَصِبا؟",90,"ب",2,