{"poems":[[55,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[73,"سألت السديد الفاضلي وقد بدا","https://www.aldiwan.net/poem3764.html","الطويل"],[32,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[23,"ألا أبلغ أبا هدم رسولا","https://www.aldiwan.net/poem21635.html","الوافر"],[53,"رأيتك لم تحسن ثوابي ولم تجب","https://www.aldiwan.net/poem64016.html","الطويل"],[53,"لما تؤذن الدنيا به من شرورها","https://www.aldiwan.net/poem65430.html","الطويل"],[53,"رأيت التقاط جنى نخلة","https://www.aldiwan.net/poem65521.html","المتقارب"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[87,"أنا إن بذلت الروح كيف ألام","https://www.aldiwan.net/poem63020.html","الكامل"],[47,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[30,"إن يظعن الشيب الشباب فقد ترى","https://www.aldiwan.net/poem1267.html",""],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[63,"تأبى الصبابة أن تصيخ لعاذل","https://www.aldiwan.net/poem51494.html","الكامل"],[33,"أتاني كتاب منك فيه تعتب","https://www.aldiwan.net/poem41859.html","الطويل"],[107,"أعندك أنا لم ندع بعدك الوجدا","https://www.aldiwan.net/poem41928.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[107,"هنا يا سراة الأزد حطوا رحالكم","https://www.aldiwan.net/poem44006.html","الطويل"],[41,"لمن ديار بهذا الجزع من ربب","https://www.aldiwan.net/poem53814.html","البسيط"],[17,"لم يقض من حاجة الصبا أربا","https://www.aldiwan.net/poem1189.html",""],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16679","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[102,"استنطاق","https://www.poetsgate.com/ViewPoem.aspx?id=206345",""],[92,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[124,"أخا ثقتي كما ثارت النفس ثورة","https://www.aldiwan.net/poem49365.html","الطويل"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[230,"أغرتك الغراء أم طلعة البدر","https://www.aldiwan.net/poem55246.html","الطويل"],[242,"كم ذا تقرطسني بسمر نبالها","https://www.aldiwan.net/poem18851.html","الكامل"],[266,"أكناس ريم أم عرين غضنفر","https://www.aldiwan.net/poem38278.html","الكامل"],[358,"تحت الغلائل بانة تترنح","https://www.aldiwan.net/poem40408.html","الكامل"],[359,"أكنت تحسبُ أنى قابل غيراً","https://www.aldiwan.net/poem713.html",""],[368,"أبيت اللعن والراعي متى ما","https://www.aldiwan.net/poem1693.html","الوافر"],[370,"أكنت تراني يابن ظالم نهزة","https://www.aldiwan.net/poem44371.html","الطويل"],[376,"أتاني ما طربت له سرورا","https://www.aldiwan.net/poem57431.html","الكامل"],[463,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[463,"رضيت وما من طاعة كل من رضي","https://www.aldiwan.net/poem56148.html","الطويل"],[463,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[463,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[475,"يا معمر يا ابن زيد حين تنكحها","https://www.aldiwan.net/poem4671.html","البسيط"],[505,"يقولون يا هذا الشيوخي كم تهم","https://www.aldiwan.net/poem37726.html","الطويل"],[518,"هبني أطيع ملام الكاشحين ولا","https://www.aldiwan.net/poem67690.html","الطويل"],[569,"سلاماً وأهلاً أيها السيد الشهم","https://www.aldiwan.net/poem891.html",""],[580,"لو كان سقم حبيب القلب في بدني","https://www.aldiwan.net/poem2990.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83258","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122668","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37889","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145944","البسيط"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96385","الوافر"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77975","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100473","السريع"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77429","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137161",""],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10416","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65985","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202713","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203485","المتقارب"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97894","الوافر"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/7","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62895","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62808","الوافر"],[3645,"","https://poetry.dctabudhabi.ae/diwan/poem/99288","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216529","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95352","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75690","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133160","الطويل"],[4471,"","https://poetry.dctabudhabi.ae/diwan/poem/73013","المتقارب"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18811","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120509","المتقارب"],[4718,"ضاقت بي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=137245",""],[4984,"تَسْعَى إِلَى الْجَاهِ","https://www.poetsgate.com/ViewPoem.aspx?id=201287",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5358,"أعاصير ومنافي","https://www.poetsgate.com/ViewPoem.aspx?id=21863",""],[5358,"تظلُّ عزيزاً","https://www.poetsgate.com/ViewPoem.aspx?id=201849",""],[5460,"زعمت قرينة أن حبك بادا","https://www.poetsgate.com/ViewPoem.aspx?id=200725",""],[5493,"كل له ظله","https://www.poetsgate.com/ViewPoem.aspx?id=197568",""],[5616,"أغرِّد بالقصيدة كلَّ يومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205220",""],[5732,"لزيت نفسي مير عيت تلزا","https://www.poetsgate.com/ViewPoem.aspx?id=177849",""],[3856,"كَم زَفرةٍ أوشَكَتْ أن تُرمِدَ الحَطَبا","https://www.poetsgate.com/ViewPoem.aspx?id=215915",""],[5776,"البُردةُ اليمانيةُ الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=199545",""],[5970,"تمجلت في عهد الشباب إلى القبر","https://www.poetsgate.com/ViewPoem.aspx?id=130674",""]],"verses":[["أَكُنُّ ثَنائي وَاِبنُ فَعلاءَ مُعرِضٌ","لَئِن أَنتَ لَم تَسمَع فَعِرضُكَ سامِعُ",0,"ع",1,0],["أَكُنُّ غَليلي بِالضُلوعِ وَلَم أَجِد","لِقَلبي وَراءَ الهَمِّ مُذ غابَ مَطلَعا",1,"ع",2,0],["أَكُنتَ مُعَنِّفي لَمّا التَقَينا","عَلى وَطَرٍ مِنَ الدِمَنِ الدُثورِ",2,"ر",1,0],["أَكَنِّهِمُ لِلمَراميلِ ظِلّاً","وَأَثقَبِهِم لِلمَطاريقِ زَندا",3,"د",2,0],["أَكُنتَ مَريضاً قالَ كَلّا وَإِنَّما","تَخَيَّرَني عَبدُ الرَحيمِ لِسِرِّهِ",4,"ر",2,0],["أَكُن مِثلَ ذي الأُلّافِ لُزَّت كُراعُهُ","إِلى أُختِها الأُخرى وَوَلّى صَواحِبُه",5,"ب",2,0],["أَكُنتُ وَلِيَّكُم في كُلِّ كُرهٍ","وَغَيري في الرَخاءِ هُوَ الوَلِيُّ",6,"ي",1,0],["أكنتُ خسيس القدر لم حِصتَ حيصةً","عن الفضل أعدتك الخساسة في القدر",7,"ر",1,0],["أكنت حسبت الله ويحك لم يكن","تعالى اسمه إلا بصنعك يصنعُ",8,"ع",1,0],["أكَنَّ لكفك من شوكها","وإن هي لم توفها حقها",9,"ق",3,0],["أكنتَ ظننت سهوي عن حقوقي","أم استيقنتَ جبني وانخذالي",10,"ل",2,0],["أكنتُ قذاةَ العين دونَ الألى دُعوا","أم السوءةَ السوآء في ذلك الحفلِ",11,"ل",1,0],["أَكُنتُ أَعلَمُ وَالحَوادِثُ جَمَّةٌ","أَنَّ الحَوادِثَ مُقلَةٌ وَقَوامُ",12,"م",1,0],["أَكُنتَ مُعَنِّفي يَومَ الرَحيلِ","وَقَد لَجَّت دُموعي في الهُمولِ",13,"ل",1,1],["أَكُن كَالَّذي صابَ الحَيا أَرضَهُ الَّتي","سَقاها وَقَد كانَت جَديباً جَنابُها",14,"ب",3,0],["أَكُنتُم ظَنَنتُم رِحلَتي تَنثَني بِكُم","وَلَم يَنقُدِ الإِدلاجُ طَيَّ العَمائِمِ",15,"م",1,0],["أُكْنِي عن البلدِ البعيدِ بغيرِه","وأَردُّ عنه عِنانَ قلبٍ مائلِ",16,"ل",1,0],["أَكُن كَالَّذي أَسدى إِلى غَيرِ شاكِرٍ","يَداً لَم يُثَب فيها بِحَمدٍ وَلا بَذلِ",17,"ل",1,0],["أكنت رسول العبقرية جاءنا","بإنجيلها ثم انثنى يطلب اللحدا",18,"د",2,0],["أكنتم أمةً خُلِقتْ سُيوفاً","تعالى اللهُ خيرُ الخالقينا",19,"ن",2,0],["أكنتَ ترى الخلافةَ جُحرَ ضَبٍّ","غداة تُطيعُ أمرَ المُجحِرينا",19,"ن",2,0],["أَكُنتَ خليفةً أم كنتَ شاةً","تولّتْ تتبعُ الذّئبَ اللّعينا",19,"ن",2,0],["أكنتم كما ظنّوا تخافونَ بأسَهُمْ","ألم يَكْفِهِمْ أن يُضحِكوا السَّيْفَ والدَّما",20,"م",2,0],["أَكنافُهُ خَلَقٌ مِن دونِهِ خَلَقُ","كَالرَيطِ نَشَّرتَهُ ذي الزِبرِجِ الهَدِبِ",21,"ب",1,0],["أَكنافُها كُلُّ فارِسٍ بَطَلٍ","أَغلَبَ كَاللَيثِ عادِياً حَرِبا",22,"ب",2,0],["أَكني بِغيرِ اِسمِها وَقَد عَلِمَ","اللَهُ خَفِيّاتِ كُلِّ مُكتَتَمِ",23,"م",1,0],["أكُنتَ غيرَ الفدى في غير تضحيةٍ","إن هم عليكَ بسربٍ للردى حاموا",24,"م",3,0],["أكُنْتَ قَطَاةً مَرّةً فظَنَنْتَهَا","جَنى الكَحْصِ مُلْقىً في سَرارَةِ واد",25,"د",1,0],["أَكْنِي بِزَهْرِ الرَّوْضِ عَنْ أَخْلاقِهِ","وَبِنَشْرِهِ عَنْ فَضْلِهِ الْمَرْغُوبِ",26,"ب",1,0],["أكنت صبياً قبل أن ينبت الثرى؟","وبعد مشيب الأرض هل أنت راشد؟",27,"د",1,0],["أكنت و\" بابلاً \" بلداً سواء","فللملكَينِ باقٍ فيك سحر",28,"ر",1,0],["أَكنتَ وعدتني خطأ فأَصغي","إلى الإخلاف عَزْمٌ منك عمْدُ",29,"د",1,0],["أكن غليلي في فؤادي ولا أرى","سبيلاً إلى إطفاء حر جوى الصدر",30,"ر",1,0],["أَكُن أَحوَذِىَّ الصَّرمِ إِمّا لِخُلَّةٍ","سِوَاكِ وَإِمّا أَرعَوِى فَأتُوبُ",31,"ب",1,0],["أكنت جنيت والدنيا مجال","لمفروض الثواب أو العقاب",32,"ب",1,0],["أكنى إذا ما قيل لي من تحبه","بغيرك صوناً للغرام عن الجهر",33,"ر",1,0],["أَكْنِفْهُ حَيْثُ ثَوَى وَعَجِّلْ أَوْبَهُ","وَامْنَحْهُ مِنْ فَيْضِ الْغِنَى بِسِجَالِهَا",34,"ل",3,0],["أكناس ريم أم عرين غضنفر","هذا اللوى وربي الكثيب الأعفر",35,"ر",1,1],["أَكنى عَن القَمَر المُنير بِوَجهِها","وَسَناه بِالسرّ المَصون يصرّحُ",36,"ح",1,0],["أكنت تحسَبُ أنّى قابلٌ غِيَراً","من مالك لا وربِّ الحِلِّ والحَرمِ",37,"م",1,1],["أَكُنّا بِاليَمامَةِ أَو لَكُنّا","مِنَ المُتَحَدِّرينَ عَلى جَنابِ",38,"ب",1,0],["أَكنتَ تراني يابنَ ظالِمَ نُهزَةً","يَجيءُ بها في أَوّلِ اللَّيلِ فارسُ",39,"س",1,1],["أكنتَ منجِّماً يا دهرُ حتى","أبَنتَ بها على ما في ضَميري",40,"ر",2,0],["أكنتَ مع الركب طاوين عنه","مَطا كلِّ مطّردٍ جائلِ",41,"ل",1,0],["أكنتَ بصحراء الأبيرق صارفي","بعذلك عن بثّ الهوى أم محرّضي",42,"ض",2,0],["أكنتَ بسمعي أو أظنُّك سامعاً","بأعجب من أبيات قومك في أمري",43,"ر",2,0],["أكنتَ معي بعينٍ أم بقلبٍ","برامةَ والعيونُ إليَّ صُورُ",44,"ر",1,0],["أَكُنتَ تَجهَلُ حَزماً حينَ تَنكِحُها","أَم خِفتَ لا زِلتَ فيها جائِعَ الكَبِدِ",45,"د",1,0],["أُكَنِّي أُوَرِّي أرْمُزُ السِّرَّ مُخْبِراً","وقَولي صَريحٌ والضَّمينُ التِّهامِيُّ",46,"ي",1,0],["أكنت أصغي لشعر وزنه خطأ","وقد ترادف فيه اللحن والكذب",47,"ب",1,0],["أكنيك إجلالاً أبا خالد الثنا","ومن اسمه لفاتح أسبانيا اسم",48,"م",1,0],["أَكني ولست أُسَمِّي من كَلِفْتُ به","وإِن كنيتُ فمَحْبُوبي من العَرب",49,"ب",1,0],["أَكنَهتُ بِالأَقدامِ سِرَّ ضَميرِهِ","وَحَلَّلتَ بِالأَقدامِ قَلبَ المَصنَعِ",50,"ع",1,0],["أكَنَّ نِقابُها قَمَراً وشَمساً","وأطلَعَ ثَغرُها حَبَباً وطَلعا",51,"ع",2,0],["أُكني بِلَيلى عَن حَبيبي قاصِداً","صَوْنَ اِسمِهِ عَن ذِكرِهِ بِلِساني",52,"ن",2,1],["أكنتَ ترصدُ هذي الأرضَ كم صمدتْ","كِبراً وهذا عراقُ اللهِ كم صمدا",53,"د",2,0],["أكُنَّا الايمنينَ اذا اتجهنا","بأيدينا الصوارمُ للنجازِ",54,"ز",1,0],["أَكنت لدار الخلد تَختار أَم لها","أَجني هداك اللَه أَم أَنتَ أَبكم",55,"م",1,0],["أكناف كوفان قد استبشرت","دامت لها البشرى دوام السنين",56,"ن",1,1],["أَكَنَّت أَفاعيها الوُكورُ وَأَطرَقَت","بِهاماتِها مِنهُ الجِبالُ الشَواهِقُ",57,"ق",1,0],["اكنار يوهي بعض ما حملتنا","بعد الفراق من الاسى ثهلانا",58,"ن",2,0],["أَكُنتُم تَحسَبونَ قِتالَ قَومي","كَأَكلِكُمُ الفَغايا وَالهَبيدا",59,"د",2,0],["أكنت بصفين فشاهدت غسلهم","أأم بقديد كنت إذ رمت مكلما",60,"م",2,0],["أكنت بيقظة فشهدت هذا","أم أني كنت في حلم ومسّ",61,"س",1,0],["أكنت دميماً فلم تستطيعي","لذلك رؤية وجهي اللعين",62,"ن",1,0],["أكن فلا الشماتة من عدوي","ولا تلك الأسافة من نصيري",63,"ر",2,0],["أَكَنَّوا خُطوباً قَد بَدَت صَفَحاتُها","وَأَفئِدَةً لَيسَت عَلَيَّ بِأَرآفِ",64,"ف",1,0],["أَكُنْ لكَ أَحلى بُعيدَ الكَلاَلِ","مِنَ النومِ في أعينِ النُّعَّسِ",65,"س",1,0],["أكنتَ تظُنُّني أردُ الهُوينا","ويشرعُ في الهُوينا كلُّ وانِ",66,"ن",1,0],["أكنتُ عدوَّ أهلِكَ يومَ أحموا","عيونَهُم وحَيّوا بالوُجومِ",67,"م",1,0],["أكني بليلى ولبنى حين أذكره","صوناً له وبحالي يعلم الله",68,"ه",1,0],["أكنت حسبتها الورقاء هبّت","لقد والله جدَّ بك المزاح",69,"ح",1,0],["أكنى عن الدنيا ودع ما كَدِرا","بكسرة الدال كذاك ذُكِرا",70,"ر",2,0],["أَكُنتَ يا زَفسُ خَدّاعاً وَكَيفَ أَرى","قَومَينِ فَذَّينِ لَم نَبلُغهُما أَمَدا",71,"د",2,0],["أَكنافه جمعت أَمناً إِلى أدب","كالروض يَجمع بَينَ الظل وَالثمر",72,"ر",1,0],["اكننته وفيك يجلى كنهه","فإن تكن تعلم ما أظنه",73,"ه",1,0],["أكني عن التصريح صوناً لاسمه","وأرمز إلهاماً لدى شامتٍ غمر",74,"ر",1,0],["أَكُنتَ الخَليلَ أَكُنتَ الكَليمَ","أَمِنتَ الحَريقَ أَمِنتَ الغَرَق",75,"ق",1,0],["أَكُنتِ أَبخَلَ مَن كانَت مَواعِدُهُ","دَيناً إِلى أَجَلٍ يُرجى وَيُنتَظَرُ",76,"ر",1,0],["اكنتم رجالا وكنا نساء","لحمل اغتيال لكم واختيال",77,"ل",1,0],["اكن في صدري ولاشقت واشتقت","تعبت واتعبت القدم مادروبي",78,"ب",2,0],["أكنت لو زال عنك الجاه منتظرا","وفاء من مكثوا عهدا على الرشد",79,"د",1,0],["أكنت بجنبنا والحال سر","مصون لا يلوح له منار",80,"ر",1,0],["أكنّيها الحبيبةَ من بلادي","وفيها الوشمُ بالحناءِ إسْمُ",81,"م",1,0],["أكنتَ عراقِيّا ً ؟ تكونُ الأضاحِيا","وكنتَ جنوبيّا ً تكونُ الأغانِيا",82,"ي",2,0],["أكُنْتَ عراقِيّاً تكونُ المُضَحِّيا","وكنتَ جنوبيّاً تكونُ الأغانِيا",83,"ي",2,0],["اكنى بغيرك والهوى بك مفصح","عجبا لذاك تفاوتا وبعادا",84,"د",2,0],["أَ كنتُ ذنبًا فتابَتْ منهُ أضْلعُهُ","وظَلَّ في أضْلعِي وِزْرًا ولمْ أتُبِ",85,"ب",1,0],["أُكنِّي فيكِ أسماءً وأخشَى","إذا ما بُحْتُ يَفضحُني بُواحِي",86,"ح",2,0],["اكنها ولها بصدري موزا","اخاف يقضب غيبتي كل لماز",87,"ز",1,0],["أُكِنُّ يا قلمي ما لن تُطيقَ لهُ","حَملًا، وضاقَ بِه صدري بما رَحُبا",88,"ب",2,0],["أكنتَ مابين أسماءٍ يعلّمها","لآدمٍ ربُنا..أم كنتَ أسماها",89,"ا",3,0],["أكنت ترى أن الحياة ذميمة","وهل أنت مسرور أني قصر العمر",90,"ر",1,0]]}