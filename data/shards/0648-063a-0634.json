{"poems":[[79,"أبيتم دعوتي إما لبأو","https://www.aldiwan.net/poem35919.html","الوافر"],[88,"جاز بي عرفها فهاج الغراما","https://www.aldiwan.net/poem68932.html","الخفيف"],[73,"ذراها إذا رامت معاجاً إلى الحمى","https://www.aldiwan.net/poem4002.html","الطويل"],[87,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[48,"ذممتك أم دفر فاسمعيني","https://www.aldiwan.net/poem23527.html","الوافر"],[226,"يلومني كل وقت","https://www.aldiwan.net/poem55252.html","المجتث"],[310,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[447,"لولا مخافة بيع قائد الغبن","https://www.aldiwan.net/poem14431.html","البسيط"],[449,"صراع السيف والقلم","https://www.aldiwan.net/poem55927.html","عموديه"],[519,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53730","الهزج"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56351","الكامل"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100685","البسيط"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49592","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124737","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110332","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137927",""],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124773","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101724","الطويل"],[2575,"","https://poetry.dctabudhabi.ae/diwan/poem/142561","السريع"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132061","الوافر"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111315","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4858,"ومن المساجد ينبع الظفر","https://www.poetsgate.com/ViewPoem.aspx?id=37236",""],[4858,"ألا ياربِّ فارحمْ مِن فقدنا","https://www.poetsgate.com/ViewPoem.aspx?id=148456",""],[5956,"أ تأتي الإمارات يا صالح؟","https://www.poetsgate.com/ViewPoem.aspx?id=194595",""],[6031,"ولَيلٍ أشَبْنَا طُرَّتَيْهِ بِأَوجُهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46305",""],[6142,"لا تسل ما جرى بميلاده الأز","https://www.poetsgate.com/ViewPoem.aspx?id=155704",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""]],"verses":[["وغِشْيانُ المَنازِلِ لاخْتبارِ","يُطالِبُ بالجَليلةِ والدّقيقَهْ",0,"ق",2,0],["وَغَشينا دِيارَكُم حَيثُ شِئنا","فَلَقينا طَلاقَةً وَاِبتِساما",1,"م",2,0],["وَغَشّى عَلى عَينَيَّ مِنها غِشاوَةٌ","فَلا أَنظُرُ الأَشياءَ إِلّا تَوَهُّما",2,"م",2,0],["وَغَشيناكَ ساعَةً تَنبُشُ الما","ضِيَ نَبشاً وَتَقتُلُ الأَمسَ فِكرا",3,"ر",2,0],["وَغِشيانُ النِساءِ إِذا تَقَضَّت","لِسُلطانِ المَنِيَّةِ كَالمُعينِ",4,"ن",1,0],["وغش غيري فإني","لا أستحي في الحقائق",5,"ق",1,0],["وَغَشى من طيبهِ عَرفَ الصباح","وَغَدا يحجبُ أنوارَ الشهب",6,"ب",1,0],["وغش غيري فقادته خلائقه","لنعمة ودعي يا خير مؤتمن",7,"ن",1,0],["وغش تلو تضليل","وفوز الزور والتهم",8,"م",1,0],["وغشَتْ في شُعاعِها الأرضَ طُرّاً","فجرى ذَوْبُ لَعلِها في البُحورِ",9,"ر",1,0],["وغشَّاها من الشجرا","ء كي لا ينتشي ريحَهْ",10,"ه",1,0],["وَغَشاه في وَقعة بَعد أُخرى","وَهُوَ لا يَستَطيع يحمي أَخاه",11,"ا",2,0],["وغشا المعامع فوق سابقة علت","همماً وهزّ بكفه عسّالا",12,"ل",2,0],["وغشيت صفحات الأرض معدلة","فالأسد تنفر عن مرعى به غنم",13,"م",1,0],["وغشى بما غشى أشعة نوره","حذاراً بأن يغشى العيون فتذهبا",14,"ب",2,0],["وَغَشُوم وإنما يَتَجافى الدهرُ","عن صَفوِهِ بكلِّ غشوم",15,"م",1,0],["وغشيانها بعد الطهارة فاسدٌ","إذا هي لم تغسل من الدم فاعلم",16,"م",1,0],["وغشيت الرياض في ساحل المت","ن وكم لي بظلها من عهود",17,"د",1,0],["وغشته القنابل من ثغور ال","مدافع فاتحاتٍ فيه ثغرا",18,"ر",2,0],["وغش إمام للرعية بعده","وقوع على العجما البهيمة يفسد",19,"د",1,0],["وغشى ضياء الشمس أسود حالك","من النقع معقود بأقتم أسحم",20,"م",1,0],["وغشت الوحدة عيني فما","يؤنس عيني كل هذا البشر",21,"ر",1,0],["وغشى البدر من فرق وذعر","خسوف للتوعد لا سرار",22,"ر",1,0],["وغشاهم من نور وجهك ساطع","لذاك عن الحق المبين تنكبوا",23,"ب",3,0],["وغشى الألمعيَّ بها ذهولٌ","فعمَّ ضياءَ فكرتِه سِرار",24,"ر",1,0],["وغشاها ظلام من دخان","فكم حلل بها في الصبح سود",25,"د",1,0],["وَغَشِيْتُم أَرْضِي وَمَقْدِسَهَا","وَيَمُدَّكُمْ مَنْ مِثْلكُم كَفَرُوا",26,"ر",3,0],["وغشّاكَ الظّلامُ بكلّ دربٍ","فكيف تشاهدُ الأُفق المبينا ؟",27,"ن",2,0],["وغشك في الكهرباء ورحت","تُعينه وهو الفتى الكالحُ",28,"ح",1,0],["وغشَّيْنَ بالوَشْيِ الجسُومَ وإنَّمَا","سَدَلْنَ على ذَوْبِ النُّضَارِ بُرُودَا",29,"د",2,0],["وغشاء الإيوان والماء والنا","ر بثلمٍ وعورةٍ وخمود",30,"د",1,0],["وغشاه روع الموت ، والموت روعة","تغشى فيعنو كل نِكس وقادر؟",31,"ر",1,0]]}