ل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75686","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127234","الكامل"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107133","الكامل"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105478","الكامل"],[4755,"لا غائِمٌ أُفُقِي, ولا صَحْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=202891",""],[4767,"استئثار","https://www.poetsgate.com/ViewPoem.aspx?id=185275",""],[4791,"عند اللقا","https://www.poetsgate.com/ViewPoem.aspx?id=37118",""],[4980,"يا قاتلي","https://www.poetsgate.com/ViewPoem.aspx?id=194510",""],[5277,"يا سيّدَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188104",""],[5616,"قصب","https://www.poetsgate.com/ViewPoem.aspx?id=203436",""],[5616,"قصب","https://www.poetsgate.com/ViewPoem.aspx?id=206709",""],[5660,"مَن لَم يُعَزِّز عِشقَهُنَّ ذَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23711",""],[5674,"يا نشيد صلاتي","https://www.poetsgate.com/ViewPoem.aspx?id=195126",""],[5674,"نبضتي متوقده","https://www.poetsgate.com/ViewPoem.aspx?id=198686",""],[5720,"رسالةُ حُب","https://www.poetsgate.com/ViewPoem.aspx?id=207170",""],[5956,"بِظِلال نخلهما أنخُّ رواحلي","https://www.poetsgate.com/ViewPoem.aspx?id=193693",""],[5956,"الطبيبة النجيبة عنايات محمد صامولي","https://www.poetsgate.com/ViewPoem.aspx?id=196798",""],[6106,"سيدنا الإمام علي رضي الله عنه وكرم وجهه","https://www.poetsgate.com/ViewPoem.aspx?id=6659",""],[6108,"مع سبق الإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=192751",""],[6127,"يا نونُ ... يا قلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188718",""],[6198,"مُدّي حضوركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79319&r=&rc=93",""],[6198,"عيناكِ أسطورتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79269&r=&rc=43",""]],"verses":[["لَوْلاَ عَسَى وَلَعَلَّ بَانَ تَجَلُّدِي","وَبَرِئْتُ مِنْ صَبْرِي وَمِنْ كِتْمَانِي",0,"ن",2,0],["لَولا عِظامُ تَريفٍ ما غَفَرتُ لَكُم","يَومي بِأودَ وَلا أَنسَأتُكُم غَضَبي",1,"ب",2,0],["لَولا عَدِيٌّ وَلَستُم شاكِرينَ لَهُم","لَم تَدرِ تَيمٌ بِأَيِّ القُنَّةِ الحَفَرُ",2,"ر",1,0],["لولا عليّ ابن فضل الله ما استبقت","سفائن العيس في لجِّ الفلا الطامي",3,"م",2,0],["لولا عِلاجُ الناسِ أخلاقَهُم","إذاً لفاح الجمأُ اللازبُ",4,"ب",1,0],["لولا عجائبُ لُطفِ اللَّه ما نبتتْ","تلك الفضائلُ في لحمٍ وفي عَصَبِ",5,"ب",1,0],["لولا عبيدُ الله قلْ","ت ولم أخف رَهَق الجُناحِ",6,"ح",1,1],["لولا عَمَى نَاظِرَيْهِ عنه","لَذابَ حتى يَخِفَّ رُوحُه",7,"ح",2,0],["لولا عمارتكم للملك دولتَهُ","لأصبح الملك في بيداءَ مِقفار",8,"ر",1,0],["لولا عليُّ العُلا ومِنّتُهُ","غادرني الدهرُ بعض أحراضه",9,"ض",2,0],["لَولا عُيونٌ مِنَ الواشينَ تَرمُقُني","وَما أُحاذُرهُ مِن قَول حُرّاسي",10,"ي",1,1],["لولا علاقات هنالك جمة","للحب لم تتعانق الاغصان",11,"ن",1,0],["لَولا عَوادي النَفيِ أَو عَقَباتُهُ","وَالنَفيُ حالٌ مِن عَذابِ جَهَنَّمِ",12,"م",1,0],["لَولا عَلِيُّ بنَ مُرٍّ لَاِستَمَرَّ بِنا","خِلفٌ مِنَ العَيشِ فيهِ الصابُ وَالصَبِرُ",13,"ر",1,0],["لَولا عَطِيَّةُ لَاِجتَدَعتُ أُنوفَكُم","مِن بَينِ أَلأَمِ آنِفٍ وَسِبالِ",14,"ل",1,0],["لَولا عَداوَةُ أَصلٍ فة طِباعِهِمُ","كانَت مَساجِدَ مَقروناً بِها البِيَعُ",15,"ع",1,0],["لَوْلاَ عُفَاةٌ جَهَرُوا بِالَّذِي","كَتَمْتَ لَمْ نَسْمَعْ لَهُ جَرَسَا",16,"س",2,0],["لولا عطاك الطنان","به دمشق تزدان",17,"ن",1,0],["لولا علاقات هوى تحكمت","في رمق عاش على مثل الصلا",18,"ا",1,0],["لولا عِلاجُ الناسِ أخلاقَهُم","ما نفل الملاَّحُ والقاربُ",19,"ب",1,0],["لولا عُيونٌ مِنَ الواشينَ تَرمُقُني","وَما أُحاذُرهُ مِن قَول حُرَّاسِ",20,"س",1,1],["لَولا عَوائق دَهري لَم أَكُن رَجُلا","عَن لَثم أَعتاب أَبواب لَكُم صِبرا",21,"ر",2,0],["لَولا عِبارَتُكَ القَبي","حَةُ عَن زِيارَتِكَ الجَميلَه",22,"ل",2,0],["لَولا عَلائقُ بَيْنٍ مِنْكِ تَعْلَقُ بي","لَقُلْتُ إِنَّ اقتِرابي مِنْكِ تَبعيدُ",23,"د",1,0],["لولا عواذِله أقام مآتما","يبكين من لأفات منه تندبُ",24,"ب",1,0],["لولا عواطفُ رايةٍ رَضَويّة","عَقدتْ حُباهُ على دمٍ مَحْقونِ",25,"ن",1,0],["لولا عقيدةُ إيماني لما اتّجهتْ","إلا إليه صَلاتي لا ولا نسكي",26,"ك",2,0],["لَولا عِياذُ بَني الجَرّاحِ مِنهُ بِهِ","لَصاحَبَت دَهمَشاً أَو أُلحِقَت دَرِما",27,"م",2,0],["لَولا عِمادُ الدينِ لَم تَظفَر يَدٌ","مِن حَربِهِم وَنِزالِهِم بِمَرامِ",28,"م",1,0],["لَولا عَلِيٌّ ذو النَدى ما نَهَضَت","أُمُّ العَلاءِ عَن سَليلٍ طاهِرِ",29,"ر",1,0],["لَولا عَلى الاهدل السامي الذرا","ما افتر نور جواهر الاكوان",30,"ن",1,0],["لولا عناية ربه","لكان بطالاً ضلول",31,"ل",1,0],["لولا عنايتك التي أوليتني","ما كنت أعنى بعدها بطروس",32,"س",1,0],["لولا عناية عين الر","حمن حين تجلّى",33,"ل",2,0],["لَولا عَوائِدُهُم في النَصرِ خِلتَهُمُ","مِن اِحتِقارِهِمُ الأَعداءَ قَد غُلِبَوا",34,"ب",3,0],["لولا عِذارُكَ لم أُصبِحْ حليفَ هَوىً","وما غدوْتُ بقَلبٍ هائمٍ شَارِ",35,"ر",1,0],["لولا علاقتنا بمدحك سيِّدي","لتعلَّقت آمالنا بمحال",36,"ل",1,0],["لولا عوائد من نعماك تنشُلني","وإن أتت في قبيلِ الطارق الطاري",37,"ر",2,0],["لولا عُيونٌ وقاماتٌ بنا فتكَتْ","لم نَخْشَ من وقْعِ ما سَلّوا وما قتَلوا",38,"ل",3,0],["لولا عزائمه وشد رأسه","أضحت قوى الإسلام غير شداد",39,"د",1,0],["لَولا عَلاماتُ شَيبٍ لَو أَتَت وَعَظَت","لَقَد صَحَوتُ وَلَكِن سَوفَ تَأتيني",40,"ن",2,0],["لولا علي ما بدا ديننا","ولا سما العلم على الجهل",41,"ل",1,0],["لولا عقاب الصحف منك بطيها","يقضي عليها الدهر عنك كسادا",42,"د",2,0],["لولا عليم به شمس الهدى بزغت","ما رمت لا وأبيكم عند سلوانا",43,"ن",2,0],["لولا علي لم تجد في كل ذي","روح لها كفوءا مدى احقابها",44,"ب",3,0],["لو لا عُيونُ الجَآذِرْ","ما حَلَّ بي ما أُحاذِرْ",45,"ر",1,1],["لولا عجائبُ فيهِ مِنْ مكارمِهِ","ما قيلَ عِشْ رجباً كيما ترى عَجَبا",46,"ب",2,0],["لولا عطاياه وجناته","أبوابه باتت بلا طارق",47,"ق",1,0],["لولا عوائق تقصيري سعيتُ له","سَعياً على الرأس لا سعياً على القدمِ",48,"م",1,0],["لولا عسى عشت بأي بلد","كأنني فيه على جمر الغضى",49,"ا",1,0],["لولا عطاياك يا عليُّ لنا","لأصبح الجود مابه رمَقُ",50,"ق",1,0],["لولا علمت عزيز النصح وقتئذٍ","قالت وهيهات ان يعتاضه اللهف",51,"ف",1,0],["لولا عَليٌّ ما اهْتَدى في مُشْكِلٍ","عُمَرٌ ولا أبْدى جواباً لِصَوابِ",52,"ب",1,0],["لولا عنايته وبعد مرامه","لعب البلى برسومها فأحالها",53,"ل",3,0],["لولا علي ذو العلى السامي على","هام السما في كل معروف ذكر",54,"ر",1,0],["لولا عوارفه لم ي