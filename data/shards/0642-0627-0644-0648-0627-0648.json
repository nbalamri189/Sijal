4433",""],[5493,". جراح الأمس .","https://www.poetsgate.com/ViewPoem.aspx?id=197040",""],[470,"يا صبر أيوب","https://www.poetsgate.com/ViewPoem.aspx?id=19912",""],[5672,"حكاية","https://www.poetsgate.com/ViewPoem.aspx?id=206557",""],[5672,"من ادب الاخوانيات","https://www.poetsgate.com/ViewPoem.aspx?id=213893",""],[5732,"اخترت بعد الدار عن قرب الانجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177853",""],[5732,"وحيد","https://www.poetsgate.com/ViewPoem.aspx?id=177838",""],[5790,"عذلوا عليك فأكثروا","https://www.poetsgate.com/ViewPoem.aspx?id=112043",""],[5809,"على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=205932",""],[5809,"لا عليك","https://www.poetsgate.com/ViewPoem.aspx?id=205935",""],[5853,"((رسالة الى بياض الثلج ))","https://www.poetsgate.com/ViewPoem.aspx?id=175648",""],[5855,"الله أعلم أن الروح قد تلفت","https://www.poetsgate.com/ViewPoem.aspx?id=205588",""],[5909,"إني هجرت الجبَّ بعد تولِّهم","https://www.poetsgate.com/ViewPoem.aspx?id=210604",""],[5915,"فاجأتها كالظبي فِي سربه","https://www.poetsgate.com/ViewPoem.aspx?id=189108",""],[5943,"يابنتَ خيرِ النَّاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=11256",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[6093,"مهما سَمِعْتُ عنِ الحياة (مجزوء الكامل المذيل )","https://www.poetsgate.com/ViewPoem.aspx?id=181713",""],[6189,"السابحون في منطقة انعدام الوزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83549&r=&rc=16",""],[5957,"رفقا بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82586&r=&rc=128",""],[406,"عندما يحزن العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63264&r=&rc=75",""]],"verses":[["قالوا وَرَأيُ المَرءِ مِن عَقلِهِ","وَيَذهَبُ الرَأيُ عَنِ العاقِلِ",0,"ل",1,0],["قالوا وَقَد فُجِؤوا بِنَعشِكَ سائِراً","مَن مَيَّلَ الجَبَلَ العَظيمَ فَمالا",1,"ل",2,0],["قالوا وَقَد قُرِّبَت رَكائِبُنا","وَالقَلبُ يَظما بِهِم وَلا يَرِدُ",2,"د",1,0],["قالوا وَما أُنكِرُها قَولَةً","مِن مائِقٍ في الغَيِّ مُنقادِ",3,"د",1,0],["قالوا وقدْ عظُمَتْ مَبَرّةُ خالِدٍ","قاري الضّيوفِ بطارِفٍ وبتالِدِ",4,"د",1,1],["قالوا وَلائِمُ موْلانا مَجالِسُها","عِشْرونَ منْ ضَحْوَةٍ للّيْلِ مَعْدودَةْ",5,"ه",1,1],["قالوا وَقَد أَبصَروا الرُغفانَ زاهِيَةً","هَذا الدَواءُ فَهَل عالَجتَهُ فَأَبى",6,"ب",2,0],["قالوا وَقَد خاطَ النُعاسُ جُفونَهُم","أَينَ المُناخُ فَقُلتُ جدوا في السُّرى",7,"ر",2,0],["قالوا وصولات الورَى حصلت لهم","ونراكَ لم تظفر لها بحصول",8,"ل",1,1],["قالوا وقد ملكت رقي غلام","عاشق هذا ما عليه ملام",9,"م",1,1],["قالوا وقد زدتني برًّا وتكرمةً","يا خير من لندَى كفّ أناديهِ",10,"ه",1,1],["قالوا وَما تَتَمَنّى قُلتُ مُبتَدِراً","يا لَيتَني طائِرٌ أَو زَهرَةٌ فيها",11,"ي",3,0],["قالوا وهبت ولم تهب","للعروة الوثقى مئه",12,"ا",2,0],["قالوا ولم يكذبوا ولا صدقوا","قولاً خفيَّ الرموز مضطربا",13,"ب",2,0],["قالوا ولا غرو أنهم علموا","إذ عرفوا الأصل فيه والسببا",13,"ب",2,0],["قالوا وقد لمحوكَ فوقَ عيونِهمْ","ما هكذا تتفاوتُ الفِتيانُ",14,"ن",1,0],["قالوا وفي رأسي بقيّةُ نَشْوَةٍ","ماذا دهاك فقلت جورُ الساقي",15,"ق",2,0],["قالوا وقد بكَرُوا لعذلِيَ إذْ رأَوا","أني بَقِيتُ بلا صديقٍ فارِدا",16,"د",2,1],["قالوا وحَظِّيَ محدودٌ ولو نظروا","رأوا تشابُهَ محدودٍ ومبخُوتِ",17,"ت",1,0],["قالوا وَرَدنا نَداهُ قُلتُ عادَتُهُ","قالوا وَجادَت يَداهُ قُلتُ ما بَرِحَت",18,"ت",1,0],["قالوا وَقَد وَجَدوا لِبَأسِكَ رَهبَةً","وَمَخافَةً تَذَرُ الفَصيحِ بَليدا",19,"د",2,0],["قالوا وتهوى البياضَ قلتُ لهمْ","في الوجهِ والمعصمينِ والعنقِ",20,"ق",1,0],["قالوا وتهوى البياضَ قلتُ نعمْ","في الوجه والمعصمينِ والعنقِ",21,"ق",1,0],["قالوا وجَدْنَاهُ مِثْلَ الكَرْمِ في كَرَمٍ","يَفِيءُ منه علينا الظِّلُّ والثَّمَرُ",22,"ر",1,0],["قالوا وَقَد أَنكَروا مُراوَغَتي ال","كَأسِ وَقَتلي بِبَثِّيَ الطَرَبا",23,"ب",2,0],["قالوا وَقُلنا دَعاوٍ ما تُفيدُ لَنا","إِلّا الأَذى وَاِختِصاماً في المُداعاةِ",24,"ه",1,0],["قالوا وَآدَمُ مِثلُ أَوبَرَ وَالوَرى","كَبَناتِهِ جَهِلَ اِمرُؤٌ ما أَوبَرُ",25,"ر",1,0],["قالوا وَلي يُراعي الوقت ملتزماً","وَالحزم ذلك يأَتيه الألى حصفوا",26,"ف",3,0],["قَالَوا وَمَصْدَاقُ ما قَالَوا فَعَائِلُهُمْ لاشَ","أنَ فِي العَيْشِ لِلْضُعْفَى الرَّعَادِيدِ",27,"د",1,0],["قالوا ولائم مولانا مجالسها","عشرون من ضحوة الليل معدودة",28,"ه",1,1],["قالوا وقلنا، دَعاوٍ ما تُفيدُ لنا","إلا الأذى واختصاماً في المُداعات",29,"ت",1,0],["قالوا ولعت بشيخون وليس بها","سوى التراب يثير العج في الطرق",30,"ق",1,1],["قالوا وزيرانِ هوَى نجمُ ذا","ونجمُ هذا قد علا طالعا",31,"ع",2,1],["قالوا وقد شنُّوا عليه غارةً","أصِلاتُ جودٍ أم قضاءُ ديونِ",32,"ن",1,0],["قَالوا: وَ فِيكِ الأمَانُ شَفْرَتُهُ","فقْهٌ لَدَى حُفَّاظِ الهُدَى هَدْيَا",33,"ي",2,0],["قالوا وأن اسخطتنا لم تنتفع","برضاه عنك وان بلغت به الذرا",34,"ر",2,0],["قالوا ولو صحَّ ما قالوا لفُزتُ به","مَن لي بتصديق ما قالوا بتكذيبِ",35,"ب",1,1],["قالوا وَقَد بَصروا بخدّ","ي مِن دُموعي يُستدرُّ",36,"ر",1,0],["قالوا ولو عاينوكِ كاسمِكِ ما","أصبح في ذاكِ بينهمْ جَدَل",37,"ل",1,0],["قالوا وَما أَعَزَّهُ","قُلتُ وَما أَذَلَّني",38,"ن",2,0],["قالوا وَهَل تُمطِرُ الأَرضُ السَماءَ فَطِب","نَفساً وَكُن بِالَّذي أوتيتَ مُقتَنِعا",39,"ع",2,0],["قالوا وقد غَطّى القدر","للسَمعِ منهم والبَصَر",40,"ر",1,0],["قالوا وقد أبهموا إِنّا لنرغبُ أَن","نَراكَ من إِضم لحماً على وَضمِ",41,"م",1,0],["قالوا وقد زخرفوا قَولاً بموجبه","فهِمتَ قُلتُ هيامَ الصبِّ ذي اللَممِ",41,"م",1,0],["قالوا وَفي الدين بونٌ دونَ وَحدتِنا","إلى متى باسم هذا الدينِ تقتسم",42,"م",1,0],["قالوا وقد مادت كغصن النقا","أسرفت في العشق بلا فائده",43,"ه",1,1],["قالوا وشى الحلى بها إذ مشت","إليك من قبل ابتسام الصباح",44,"ح",1,1],["قَالُوا وقد ضَاعَتْ جَميعُ مَصَالحي","لِهمُومِ نَفْسٍ ليتَ لا حُمِّلتُها",45,"ه",2,1],["قالوا وَقَد شاهَدوا تحولي","وَما بِجِسمي من السِقام",46,"م",1,1],["قالوا وَأَقلامُ كَفِّهِ عَصَبٌ","قُلتُ كَذَبتُم أَقلامُها عُصُبُ",47,"ب",1,0],["قالوا ومن عبد الحجارة قد","أضحى بما يأتي له الفضل",48,"ل",1,0],["قالوا ومن شرب الخمور ومن","يأتي الذكور ففعله حل",48,"ل",1,0],["قالوا وإني بالمنا","م وما يواصله رقوده",49,"د",2,0],["قالُوا وضيعٌ سَلا عن حظِّه ورأى","أنَ النَّبيهَ هوَ المُستحْقَرُ النَّبِهُ",50,"ه",1,0],["قالوا وباتوا عليها فوق أرجلها","مثل البرود بأكوار سباريقا",51,"ق",2,0],["قالوا وقد شاهدوا نزفي وعضَّ يدى","من العقوقِ لإيماني وإحساني",52,"ن",2,1],["قالوا وأصغيتم ومن","يسمعُ فيَّ مُسمِعي",53,"ع",2,0],["قالوا وما كل المقال نافذٌ","صدقٌ ولا كل السيوف مخدم",54,"م",1,0],["قالوا وكم من قولةٍ مطرودةٍ","عن جانبِ الأسماع لا تُتَقَبَّلُ",55,"ل",1,0],["قالوا وجود حادث هذا وفي","غيب الغيوب وجودُ حق ثاني",56,"ن",2,0],["قالوا ولكن واجب مفروض","على العباد بعده النهوض",57,"ض",1,0],["قالوا وجدنا الجود قلنا كيف لا","ومن الأمير همي كمنهل السحب",58,"ب",1,0],["قالوا ومات اللفظ مشنوقا على شفتى اللهب","هزتك ثرثرة الشفاه وخاب صمتي وانتحب",59,"ب",1,0],["قالوا وما الباذر بين لنا","قلت ذوو العلم وأهل الذمام",60,"م",1,0],["قالوا وقد نبتَ العِذارُ بخدِّهِ","مِل عن محبّتهِ وخالصِ ودِّهِ",61,"د",2,1],["قالوا وقد عَدَتِ المنونُ عليهم","في فارسٍ طولُ البقاءِ بجعفر",62,"ر",1,0],["قالَ وَأَولادي وَحَقِّ صُحبَتي","إِني لَطائِرٌ وَذي أَجنِحَتي",63,"ي",1,0],["قالوا وَمَن يوصله الجَوابا","فَبَرَزَ الأَرنَب وَاِستَجابا",64,"ب",2,0],["قالوا وقد نَفَرَ مني طائشٌ","ليس له في حُمقِه مِن ثانِ",65,"ن",1,1],["قالوا وفوق الصياصي بارقاتُ ظُباً","هذي الثّنايا وهاتيك الثّنياتُ",66,"ت",1,0],["قالوا وَقَد ناهَزونا إِنه خرف","والكل عقلهم لَم يبلغ الحلُما",67,"م",2,0],["قالوا وَينظمُ فارِسَينِ بِطَعنَةٍ","يَومَ اللقاءِ وَلا يَراهُ جَليلا",68,"ل",2,0],["قالوا وتلك حِنْطةٌ قد كانت","من قَبلُ عَزَّتْ ثم بعدُ هانت",69,"ت",1,0],["قالوا وَقارٌ قُلتُ واوٌ أُقحِمَت","ما تُبصِرُ الحَسناءُ إِلا قارا",70,"ر",2,0],["قالوا وقال ولكن كان مقوله","ما بين أقوالهم روحا بأبدان",71,"ن",1,0],["قالوا وَلَم يلعبِ الزَمان بِبَغ","داد وَتعثُر بِها عَواثرُها",72,"ر",3,1],["قالوا وأي شيءٍ أشدّ ضرورةً","من كلما قد يقتنيه البيتُ",73,"ت",1,1],["قالوا وَلِم قال فُلان العَدل","أَرادَ في بُستانه أَن يَخلوا",74,"ل",3,0],["قالوا ولكن الفتى عاقل","وعقله يظهر من فعله",75,"ل",2,0],["قالوا وَقَد طالَ بي مَدى خطئِي","وَلَم أَزَل في تَجَرُّمي ساهِي",76,"ي",1,1],["قالوا ولا حسان هذا إذاً","قلت فذو الرمة غيلان",77,"ن",1,0],["قالوا ويزعم أنه بك مغرم","فسررت لما قلت قد صدفته",78,"ت",2,0],["قالوا وجاءت إليه سرحةٌ ستَرَت","وجه النبيّ بأغصان لها هدل",79,"ل",1,0],["قالوا وقد بليت غلالته","ما كان أسرع عودها قطعا",80,"ع",2,1],["قالوا وحيد فقلنا اللَه ناصره","وسوف يعضده باللَه أنجال",81,"ل",1,0],["قالوا ولو كان أمضاه وتممهُ","فالترك أحرى فما في تركه أسفُ",82,"ف",1,0],["قالوا وليس لِرَبِّنَا سَمعٌ وَلاَ","بَصَرٌ وَلاَ وَجهٌ فَكَيفَ يدان",83,"ن",1,0],["قَالُوا وإقرَارُ العِبَادِ بِأنَّه","خلاَّقُهُم هُوَ مُنتهَى الإيمَانِ",83,"ن",1,0],["قًالُوا وَمَا عَبَدُوا سِوَاهُ وإنَّمَا","ضَلُّوا بِمَا خَصُّوا مِنَ الأعيَانِ",83,"ن",1,0],["قَالُوا وَلَم يَكُ كافِراً فِي قَولِهِ","أنَا رَبُّكُم فِرعَونُ ذُو الطُّغيَانِ",83,"ن",1,0],["قَالُوا وَلَم يَكُ مُنكِراً مُوسَى لِمَا","عَبَدُوهُ مِن عِجلٍ لِذِي الخَوَرانِ",83,"ن",1,0],["قَالوا وَصَارَ كَلامهُ بإضَافَةِ التَّ","شرِيفِ مِثلَ البيتِ ذِي الأركَانِ",83,"ن",1,0],["قَالُوا وَلَم يُنصِف خُصُومٌ جَعجَعُوا","وَأتَوا بتَشنِيعٍ بِلاَ بُرهَانِ",83,"ن",1,0],["قَالُوا وَهَذَا مِثل قَولِ النَّاسِ فِي","ذَهَبٍ يُرَى مِن خَالِص العِقيَانِ",83,"ن",1,0],["قَالُوا وَإيرَادُ السِّيَاقِ يُبَيِّن ال","مَضمُونَ مِنهُ بِأوضَحِ التِّبيَانِ",83,"ن",1,0],["قَالُوا وَمَا كَانَت إشَارَتُهُ إلَى","غَيرِ الشَّهِيدِ مُنَزِّلِ الفُرقَانِ",83,"ن",1,0],["قَالُوا وَتِلكَ أدِلَّةٌ لَفظِيَّةٌ","لَسنَا نُحَكِّمُهَا عَلَى الإِيقَانِ",83,"ن",1,0],["قَالوا وأنتَ رَقِيبُنَا وَشَهِيدُنَا","مِن فَوقِ عَرشِكَ يَا عظِيمَ الشَّانِ",83,"ن",1,0],["قَالُوا وألجأنَا إلَى ذَا خَشيَةُ التَّ","ركِيبِ وَالتَّجسِيمِ ذِي البُطلاَنِ",83,"ن",1,0],["قَالوا وَظَاهِرُهُ هُوَ التَّشبِيهُ وَالتَّ","جسِيمُ وَالتَّمثِيلُ حَاشَا ظَاهِرَ القُرآنِ",83,"ن",1,0],["قالوا وتلك ظواهر لفظية","لم تغن شيئا طالب البرهان",83,"ن",1,0],["قالوا ولم يحصل لنا منه يقي","ن فهو معزول عن الايقان",83,"ن",1,0],["قالوا وأنتم والذي أنشأكم","قد زدتم حسنا على الاحسان",83,"ن",1,0],["قالوا ولولا ذاك لم يثبت لنا","رب لأجل تسلسل الأعيان",83,"ن",1,0],["قالوا وجسمك يوم البين صفه عسى","نعوده قلت يا كل المنى عودوا",84,"د",3,0],["قالوا ونى سيره نهرا فقلت بلى","سليله جعفر يمشي على مهل",85,"ل",1,0],["قالوا وقد نعتوا الدنيا وان له","قدرا وشأنا واصلا قد علا حسبا",86,"ب",2,0],["قالوا وداد أبي العلاء يحول","كالظل يقصر مرة ويطول",87,"ل",1,1],["قالوا وكيف تعيش مع","هذا؟ فقلت من العجيب",88,"ب",1,0],["قالوا وهل احد أقر بفضله","فأجبتهم كل الورى حتى العدا",89,"د",2,0],["قالوا وهل سمح الزمان بمثله","فأجبتهم ولمثله ما أوجدا",89,"د",2,0],["قالوا وَفَدتَ مِن البَيتِ الحَرامِ وَمِن","زِيارَةِ المُصطَفى للعَودِ مُختارا",90,"ر",2,1],["قالوا وما فعلوا لِبُخلٍ فيهم","فكأنّهمْ كانوا همُ الشُّعراءُ",91,"ا",2,0],["قالوا وقالوا لا تعبئي بهمُ","فلم يقولوا سوى أباطيل",92,"ل",1,0],["قالوا وانت فقلت ذاك أميركم","فأنا الأمير لأُمة لم تُخلق",93,"ق",1,0],["قالوا وقد أبصروا الكآبة بي","أشاعرُ البؤس قلت شاعرُكم",94,"م",1,0],["قالوا وقالوا لم يُسمعوا أحداً","ولم يصل قولهم إلى لُبّ",95,"ب",1,1],["قالوا وقد لاح مثل البدر في غسق","مهفهفٌ مائلُ الأعطاف ذُو خجل",96,"ل",1,1],["قالوا وقد فلّسوا في الكبل دينهمُ","يقضون والدّين بالتّفليس قد بطلا",97,"ا",1,0],["قالوا وكان ذا بيومِ العشر","بأربعين ولداً قد أكرما",98,"م",2,0],["قالوا وقالوا كل شيءٍ مفترى","املت به الاحقاد والاوغار",99,"ر",1,0],["قالوا وليس بهم الا نفاسته","انافع ذا من الاقتار والعدم",100,"م",1,0],["قالوا وجدنا السماء الآن قد ملئت","آفاقها حرسا مملوءة شهبا",101,"ب",2,0],["قالوا وصف جبينه","فقالت ذاك واضح",102,"ح",1,0],["قالوا وبنتُ الدنّ قد شَعشَعَت","اشرب فتمسي في رياضِ النعيم",103,"م",1,0],["قالوا والصدر يسامره","إسكندر والشيخ الخضر",104,"ر",1,0],["قالوا وقد وافيت لله ما","أشفقَ مولانا وما أرحما",105,"م",2,0],["قالوا وَقَد شاموا الرَشا","بِالحُسنِ وافى مِن سَفَر",106,"ر",1,0],["قالوا: ونودي يومًا","ما تشتهي في يديكا",107,"ك",2,0],["قالوا ولم يمعنوا سر العدوّ بما","أصابها وأسرّ البشر شانيها",108,"ي",3,0],["قالوا وقد خطا القدر","للسمع منهم والبصر",109,"ر",1,0],["قالوا وقد مات محبوب فجعت","به وبالصبا وأرادوا عنه سلواني",110,"ي",1,1],["قالوا وأنت الفتى ترجى مودّته","فات يحسب صدق الود خسرانا",111,"ن",2,0],["قالوا وأنت أنوف من مصانعة","فراح يبدي من التمويه الوانا",111,"ن",2,0],["قالوا وانك بالايمان معتصم","فارتدا اضعف خلق الله ايمانا",111,"ن",2,0],["قالوا ولست بشرّاب كؤوس طلا","فصار يقضي طويل الوقت نشوانا",111,"ن",2,0],["قالوا وأنت بديع الحسن مشرقة","فراح يختال طلق الوجه جذلانا",111,"ن",2,0],["قالوا وأنت رشيق القد مائسه","فظنهم يصفون الرند والبانا",111,"ن",2,0],["قالوا وقد شردت في البيد ناقته","يدرى السماء وأمر الأرض مجهول",112,"ل",1,0],["قالوا وقد أدهشهم ما قد راوا","تعجبا هذا وما فكيف لو",113,"و",1,0],["قالُوا وقد سَالَت عَلى وَجَنَاتِهِم","حُمُرُ الدُمُوعِ كَأَنَّهُنَّ العندَمُ",114,"م",1,0],["قالوا وَلَهُ فيك قَوافٍ قالَت","أَنشدنيَ فَهيَ ضالّةُ العُشّاقِ",115,"ق",1,0],["قالوا وحمامكم مرقوف رقاف","يشهد بهذا ابن الذريره والنصيف",116,"ف",1,0],["قالوا وَارجفت النُفوس وَأَوجفت","هَلَعاً وَهاجَ وَماجَ قُسور غابه",117,"ب",2,0],["قالوا وَهَل لَكَ وَصلٌ مِن حَبيبك قل","قُلتُ الخَيالُ مَع الأَسحار يَكفِيني",118,"ن",2,0],["قالوا وَقَد أَكثَروا في حَبِّهِ عَذَلي","لَو لَم تَهِم بِمُذالِ القَدرِ مُبتَذَلِ",119,"ل",1,1],["قالوا - وقد شطّ المزارُ - جفَوتنا","قلنا معاذ اللهِ نجفو وُلدَنا",120,"ن",2,1],["قالوا - وقد طال الفراق - لقد قسا","قلب المفارقِ واستعاض بغيرنا",120,"ن",2,0],["قالُواْ ولوْلا زوْجُ آدمَ ما نزلْ","نَا،قلْتُ:لوْلاها الْورى مَا أَيْنَعَا",121,"ع",2,0],["قالوا ولم يكملوا , حتّى كفيتَهُمُ","بالمعجزاتِ فبدرٌ يفلقُ البَدرا",122,"ر",2,0],["قالوا وَوَيْلَهُمُ : الْحَدْباءُ قَدْ سَقَطَتْ","دَعْ قَولَهُمْ إِنَّما الْحَدْباءُ تَبْتَهِلُ",123,"ل",1,0],["قالوا وكان اسمي ما بينها","مردد في الورد والنرجس",124,"س",1,0],["قالوا وإحداهن قالت وقد","بات على رشف الطلا مؤنسي",124,"س",2,0],["قالوا وصال بياضٍ للسواد فلا","تنكر فإنهما يا حسن ما اختلطا",125,"ط",2,0],["قالوا وعودك بالرجوع خديعة","فالأرض تمنع قربها الأسوار",126,"ر",1,0],["قَالُوا ومَارِيَةٌ حَكَتْ في نَعتِهَا","وَهِيَ الحَكِيمَةُ طَبْعُهَا التَّحوِيسُ",127,"س",1,0],["قالوا وما قلتهُ يوماً وقد صدقوا","الحبُّ ينطقهُ حرفُ الهوى وفمُ",128,"م",1,0],["قالوا وقدْ ضحكوا: \"أينَ العراقُ تُرى؟\".","لمْ يعلموا أنَّهُ بالجبِّ ينصقلُ",129,"ل",1,0],["قالوا وعيني بالدموع تسيلُ","رفقاً بقلبٍك فالسبيلُ طويلُ",130,"ل",1,1],["قالوا : \"و ذيك هيّ الأوله والأخيره ؟","\"قلت : \"ما ادري.. او ادري بس ما ابغى اقول\"..!",131,"ل",1,0],["قالوا وقالوا فليت القول ينفعهم","من لم يذقْ جُرحَه بالقولِ منشغلُ",132,"ل",1,0],["قالوا وظلَّ.. ولم تشعر به الإبلُ","يمشي، وحاديهِ يحدو.. وهو يحتملُ..",133,"ل",1,1],["قالوا وقدْ ناجى السميرُ سميرَهُ:","\"لنراكَ بعدَ رحيلِهمْ كالبالي؟\"",134,"ل",2,0],["قالوا: \"ومن ذا؟\" قلتها:","\"هذا حسامُ أبو تميمِ\".",135,"م",1,0],["قالوا وحيد وقلت ماعندي اوناس","وقالوا غريب وقلت بأرض بعيدة",136,"د",2,1],["قالوا: وحيد وقلت: ما عندي أوناس","قالوا: غريب وقلت: بأرضٍ بعيده",137,"د",2,1],["قالوا وقد نظروك بع","د الشمس هذا أكبر",138,"ر",1,0],["قالوا : وماحالُ شوقٍ كنتَ تحملُهُ","مِن بعدِ رؤياك مَن تهوى فقلتُ: عَلا",139,"ل",2,1],["قالوا وماذا سيجني العاشقون به","إن كان يتلفهم وجدا فقلتُ :بِلى",140,"ل",2,0],["قالوا وقلتُ الرؤى في داخلي أملٌ","بالحبِّ نرقى وبالأحقاد ننهزمُ",141,"م",1,0],["قالوا:ونحن بوادٍ ما به عشبٌ","ولا طعام ٌ ولا ماءُ فنسقيها",142,"ي",3,0],["قالوا وقد تركوا هناك بقيةً","مني وعاثوا في الفؤاد يقينا",143,"ن",2,0],["قَالُوا وَقد دلههم حبها","من طوق البلار بالعندم",144,"م",1,0],["قالوا :ومالي في المقالةِ مأربٌ","حدثٌ لعمرُك بيِّنُ الأضغانِ",145,"ن",1,0],["قالوا وقالوا والتعجبُ طبعهم","فأجاب إني الليل أجتنب الكرى",146,"ر",2,0],["قَالوا وقالوا: إِنَّهَا","دارٌ تَغرُّ ولا تُغَرّْ",147,"ر",1,0],["قالوا : وكم قالوا ، وما ضرَّه","من يا نقي الصوت يمحو الهدى",148,"د",2,0],["قالوا وقالوا ما بدا لهمُ","حتى تغير حرفها العذبُ",149,"ب",1,0],["قالوا وقد وجهوا نحوي حديثهمو","هذا الذي وجه للبشر عنوان",150,"ن",1,0]]}