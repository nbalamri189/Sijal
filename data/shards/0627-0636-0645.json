دِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5582,"شَمْسٌ تَجَلَّتْ لَنا مِنْ بَيْنِ سِجْفَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=63582",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5664,"دعوة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=46525",""],[5732,"والله مالوم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177906",""],[5747,"لوعة التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=61615",""],[5939,"رسالة إلى أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=178589",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6023,"يا إماماً له الفضائل تُعزى","https://www.poetsgate.com/ViewPoem.aspx?id=123885",""],[6093,"سَرِيْرَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202607",""],[6125,"فُؤادِي جَذوَةٌ وَهَوَاكِ زَيتُ","https://www.poetsgate.com/ViewPoem.aspx?id=207909",""],[6127,"تدور مدار العشق","https://www.poetsgate.com/ViewPoem.aspx?id=188376",""],[6127,"القلب قد وافاك","https://www.poetsgate.com/ViewPoem.aspx?id=191277",""],[463,"أجيراننابالغور والركبُ متهمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60323&r=&rc=379",""],[5567,"كل البلاد أنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69063&r=&rc=3",""]],"verses":[["أَضُمُّ عَلَيهِ الرَاحَتَينِ تَعَلُّقاً","وَقَد نَزَعَتهُ مِشَنُ يَدَيَّ نَزوعُ",0,"ع",1,0],["أضُمُّ جُفوني دونَ بارِقَةِ المُنى","وأحْمَدُ مُرَّ العَيْشِ وهْوَ ذَميمُ",1,"م",1,0],["اضّمنه معنى الحقيقة عارياً","فيحسّبه جُهالها منطقاً هُجرا",2,"ر",2,0],["أَضمَرتُ حُبَّكَ وَالدُموعُ تُذيعُهُ","وَطَوَيتُ وَجدَكَ وَالهَوى في نَشرِهِ",3,"ر",2,0],["أضُمُّهُ بعد لثْم فيهِ","إلى حشاً حشوُهُ الغرام",4,"م",1,0],["أَضِماً وَهَزَّلَهُنَّ رُمحَي رَأسِهِ","أَن قَد أُتيحَ لَهُنَّ مَوتٌ أَحمَرُ",5,"ر",1,0],["أَضُمُّ عَلَيهِ جَفنَ عَيني تَعَلُّقاً","بِهِ عِندَ إِجلاءِ النُعاسِ المُرَنِّقِ",6,"ق",1,0],["أضمُّهُ كلَّما ينادي","ما أحسنَ الضمَّ في النِدا",7,"د",2,0],["أَضمَرتَتهُ عِشرينَ يَوماً وَنيلَت","حينَ نيلَت يَعارَةً في عِراضِ",8,"ض",1,0],["أضُمُّ عليْهَا أضْلُعي وكأنّهَا","من الذُّعْرِ نَشْوَى أو تطَرّقَها لَمَم",9,"م",1,0],["أُضمِرُ في البُعدِ عِتاباً لَهُ","فَإِن دَنا أُنسيتُ مِن هَيبَتِه",10,"ت",2,0],["أَضمَرتُ لِلنيلِ هِجراناً وَمَقلِيَةً","مُذ قيلَ لي إِنَّما التِمساحُ في النيلِ",11,"ل",1,1],["أَضمِرِ الخيفَةَ وَاِضمِر قَلَّما","أَحرَزَ الطَرفُ المَدى حَتّى ضَمَر",12,"ر",1,0],["أضم إلى صدري صَغيريَ واجِداً","وأسعى إلى فزان ركضاً وأهرع",13,"ع",1,0],["أَضَمَّ الوَرى إِذ نُعي","فَقُل أَيَّ سُمٍّ نَفَث",14,"ث",1,0],["اِضمَحَلَّ السُرورُ يَومَ اِضمَحَلّا","يا فُؤادُ الشَجي لَهُ إِض مَحَلّا",15,"ل",2,1],["اضم إلى نشج السموات عبرتي","إذا استرجعت غب النشيج تعود",16,"د",1,0],["أضمنتم أمن جيرتِكُم","ثم ما آمنتُمُ السُبُلا",17,"ل",2,0],["أضم إلى صدري حشاشة نفسه","وأملأ قلبي منه بعد النواظر",18,"ر",1,0],["أضمُه وجيوشُ الشوقِ تُسعدني","والعَتْبُ قَرْظه والقلبُ في تعب",19,"ب",1,0],["أَضُمُّ عَلى الداءِ الدَفينِ جَوانِحي","وَأُظهِرُ مِن خَوفِ الرَقيبِ بَشاشَتي",20,"ت",2,0],["أُضَمِّنُ شَكوايَ القَوافي تَعِلَّةً","وَقَد صُنتُها عَن صاحِبٍ وَخَليلِ",21,"ل",1,0],["أَضُمُّ بِكِلتا راحَتَيَّ عَلى الحشا","إِذا هِيَ صاحَت سُحرَةً وَأَصيحُ",22,"ح",1,0],["أَضُمُّ جَفني عليه حينَ يَطْرُقُنُي","كما يُضَمُّ على وَحشيَّةٍ شَرَك",23,"ك",1,0],["أَضُمُّ على قلبي يَديَّ من الوَجْدِ","إذا ما سَرى وَهْناً نسيمُ صَبا نَجْدِ",24,"د",1,1],["أضمَرَ ليلُ النّقْعِ صُغْراهُما","وضاقَ بالأكبرِ ذرْعاً فَباح",25,"ح",1,0],["أَضمَّكَ لَمّا بانَ غِربانُ بَينِهِ","فَتِلكَ النَواعي لِلفَسادِ النَواعِبُ",26,"ب",1,0],["أضمُّ فمي صمتاً عليه وبينه","وبين انسكابٍ ريثما أتكلَّمُ",27,"م",1,0],["أُضمُمْ يداً على الحبيب ما وفَى","ضميرُه واصلَ أو تَصرَّما",28,"م",2,0],["أضمُّ صرامةً جنبيَّ منه","على أضعافِ ما تسعُ الضلوعُ",29,"ع",1,0],["أضمُّ القوافي لي تفيءُ عليهِمُ","وليس وراء الخِدر إلا نُفورُها",30,"ر",3,0],["أضمُّ جفنيَّ عليه فَرَقاً","من الصباح وعلى ذاك أنجلى",31,"ا",1,0],["أضمُّ قضيب البان في ورق الصّبا","وألثمُ بدر التمِّ في سحب اللُّثمِ",32,"م",1,0],["أَضمَرتُ ذاكَ زَماناً ثُمَّ بُحتُ بِهِ","فَزادَني سَقماً بوحي وَإِضمارِي",33,"ر",2,0],["أَضمُّ حشىً قَد أَنهش السيرُ بُرْدَها","إلى مَنْ حَشاه مطمئنٌّ منعَّمُ",34,"م",1,0],["أضمّ عليه ساعديَّ إلى الحشا","وأُفرشُهُ ما بين سَحْرِي إلى نحري",35,"ر",2,0],["أَضُمَّ إِلَى جَسَدِي مَا ضَمَمْ","تُ مِنْهُ وَأَلْزَمُهُ مُعْتَنِقْ",36,"ق",1,0],["أَضُمُّها مُعتَنِقاً لاثِماً","إِذا ذَكَّرتُ خَدَّ مَن أَهوى",37,"ه",3,0],["أَضْمَرْتُموا هَجْراً وأَمْرَضْتُمْ حَشىً","مِنّي وأَضْرَمَتُمْ بِنارٍ أَضْلُعَا",38,"ع",2,0],["أضمرَ الشوقَ وأخفى وجدَه","بالحشَا خوفَ عدوٍّ يتجنّى",39,"ن",2,0],["أَضُمُّها وَبَياضُ الصُّبحِ يُعجِلُها","عَنّي فَتُبعِدُني حيناً وتُدنيني",40,"ن",2,0],["أَضُمُّ إليَّ بالعَضُدَينِ غُصنا","يُجاذِبُ خَصرَهُ كَفَلاً رَداحا",41,"ح",2,0],["اضمنْهمُ لم تلق إلا محسناً","من محسن من محسن لضمين",42,"ن",1,0],["أَضمَرَ القَلبُ اِسمَهُ عَن","كلّ لاحٍ ورَقيبِ",43,"ب",1,0],["أضُمُّ مِنْهُ كَما أهْوى لِغَيْرِ نوىً","رَيْحانَةً في شَذاها الطِّيبُ مَجْموعُ",44,"ع",1,0],["اضمني لي استماعَ أخبارِ قومي","بعد موتي عن نكبة الأشعار",45,"ر",1,0],["اضمر الدهر لنا","الصلح فلم يبق غضوب",46,"ب",1,0],["أَضَمِنْتَ لي وَحَسِبْتَني","غِرَّاً رأى غرّاً فَغَرَّرْ",47,"ر",1,0],["أضمُّها وهيَ طوعاً ما تُدافِعُني","مِن حيثُ عانَقتُها إلّا بِنهدينِ",48,"ن",1,0],["أضمنُ كل بيتٍ فيه معنى","فشعري نصفُه من شعرِ غيري",49,"ي",1,0],["إضمار كامل كسالم الرجز","والوقص خبن جزله طي برز",50,"ز",1,0],["إضمارهم في كامل التحرك","إسكان ثاني جزئه المحرك",50,"ك",1,0],["أَضُمُّ شَيئاً إِلى شَيءٍ فَاِذخَرُهُ","مِما أجمعُ مِن ثَمرٍ وَمِن كِسرِ",51,"ر",1,0],["أضمير غيب الله كيف لك القنا","نفذت وراءَ حجابه المخزون",52,"ن",1,0],["أضمرت في القلب هوى شادن","مشتغل في النحو لا ينصف",53,"ف",1,1],["أضمَرتُ مِنْ حُبِّهِ مَا لَوّ أحَاطَ بِهِ","جَهْمُ الطَّبِيعَةِ عِلماً صُمَّ فِي الحِينِ",54,"ن",1,0],["أضم من القد غصن الأراك","وأجني من الخد ورد الخفرْ",55,"ر",1,0],["أضم غصن البان عن","قوامه تَعِلَّه",56,"ل",2,0],["أضمرت حقده صدور رجال","حاولت فرصة لبث العداء",57,"ا",2,0],["أضم عنه قمراً مشرقاً","بالأنس أذ نمن ضجيعان",58,"ن",1,0],["أضم عنه قمراً مشرقاً","يبسم عن در ومرجان",58,"ن",1,0],["أضُمُّ لِسَعدٍ شارِدَ المَجدِ وَالعُلى","وَسَعدٌ يَراني بِالتَّشاوُسِ وَالشَّزرِ",59,"ر",1,0],["أَضمَرتَ عَزماً في طِلابِهِمُ","فَمَضى يُسابِقُ سَيفَكَ القَدَرُ",60,"ر",1,0],["أضمّه مجرداً","منك إلى مجرد",61,"د",1,0],["أضمه يرتج مثل","الزيبق المرجج",62,"ج",1,0],["أَضُمُّهُما وَاللَيلُ داجٍ كَأَنَّما","هُما نُقطَتا ياءٍ وَجِسمي هُوَ الياءُ",63,"ا",2,0],["أضمُّ على قلبي يديَّ تشوُّقاً","وألوي حيازيمي عليك تحرُّقاً",64,"ق",2,1],["أضمرت كيدا فما تقنع أخذا","من أعاليها ولا تقبل ردا",65,"د",2,0],["أضم كفي على قلبي مخافة أن","تطير منه شظاياه التي تجب",66,"ب",1,0],["اضمر الحب كاتماً ثم اظهر","وهوى النفس ظاهر غير مضمر",67,"ر",1,1],["اضمر اسرار الغرام كاتما","فبات من داء الملام سالما",68,"م",2,1],["أَضْمَرَ غَدْراً فَعَادَ عُذْراً","إذْ رُفِعَتْ للمُحِبِّ حُجْبُ",69,"ب",1,0],["أضُمُّ على قلبي يديَّ مخافةً","إذا لاحَ لي بَرقٌ من الشّرقِ لامِعُ",70,"ع",1,0],["أَضمّ غُصن البان من قدّه","وَأَلثمُ الوَجنات كَالجلّنارْ",71,"ر",1,0],["أضمر الشر للنساء حقوداً","وأبى الحقد أن يكون رشيدا",72,"د",2,1],["أضمه كله وأرشفه","في قبلة كوثرية السكرِ",73,"ر",1,0],["أضّمد جرحي باليدين وفيهما","جراح يغشيها النجيع المسلسل",74,"ل",1,0],["أضمرت هندُ لي جزاءً وفاءً","وانثنى السعد لي مطيعاً وفاء",75,"ا",2,1],["أضمر الغدر في الضمير وولى","وهو من غيظه يعض الشفاها",76,"ه",2,0],["أضمُّهُ والحسُودُ الندلُ أتركُهُ","في غمِّهِ ميتاً من علةِ الحَسَدِ",77,"د",1,0],["أضمُمُ إِلَيكَ جَنَاحاً ذَا مُرَافَقَةٍ","مُبدٍ مُفَارَقَةَ الآثَامِ وَانزَعِج",78,"ج",1,0],["أضمرت لي أن صارا","معناه ضمّ وحالا",79,"ل",2,0],["أَضُمُّها ضَمَّ مُشتاقٍ بِهِ خَبَلٌ","قَد رامَ كَتمَ هَوى أَحبابِهِ فَنَسا",80,"س",2,0],["أضمروا لي وداً ولا تظهروه","يهده منكم إلى الضمير",81,"ر",1,1],["أضمر تبكيتي لدى كل الملا","ضمير خفض لازم قد جعلا",82,"ل",2,0],["أَضمرتُ في حبِّكم إضمارَ معتقدٍ","قد جلَّ عن كلِّ إخلاصٍ وإضمار",83,"ر",1,0],["اضمر الشوق الغضا من اجلها","في فؤادٍ جفَّ حتى احترقا",84,"ق",2,0],["أَضمَرتُ مِنكَ اليَأسَ حينَ رَأَيتَني","وَقُوى حِبالِكَ مِن قوايَ تقضَّبُ",85,"ب",1,0],["إضمارُ سُوءٍ ثم خُبْثُ النِّيَّهْ","والظلمُ للأعوانِ والرعيَّهْ",86,"ه",1,0],["أضم الفيافي والفيافي تضمني","ولم اخش يوما من سموم العقارب",87,"ب",1,0],["أَضُمَّكْ طَيفْ فِي فَرشِي","وأَتْسَاقَطْ شَجَرْ وَاْعشَاشْ",88,"ش",1,0],["أضمك بين أحلامي وبيني","فأصحو لم أجدك، وكم بكيتُ",89,"ت",1,0],["أضمه بين أحلامي وبيني","فأصحو لم أجده، وكم بكيتُ",90,"ت",1,0],["أضمرتْ اِبطاهُ شرّاً مُستطيراً","يدّعي ظلماً من الأمرِ نصيفَهْ",91,"ف",2,0],["أُضمُّ الشعرَ من وجعي عليهِ","ويحبسُ دمعَهُ وجعًا عليَّا",92,"ي",2,0],["أضم الركب لشّعار أكيد وللدرر غطاس","وهذا الحاذق الماهر يجاري موكب الترقيم",93,"م",1,0],["أضمُّ الضَّوءَ سلوانًا وأمضي","وأوصِدُ بابَ ذاكرتي وراها",94,"ا",3,0],["أَضُمُّهُ وشَذَا الفِردَوْسِ يَعبَقَهُ","والحُورُ تَصحَبُهُ ، والعِزُّ والجَاهُ",95,"ا",2,0],["اضمم بكفك كفا طالما عشقت","تلك الأنامل لم تعرف لها بدلا",96,"ل",2,1],["أضمها ولها كفي تلوذ بها","يعتادها جسدي حتى غدا طللا",96,"ل",2,0],["أضمرت حقدها له وهو حي","فغدت في اخيه تشفي جواها",97,"ا",3,0],["أضَمِّدُ جُرْحَ اشتهائي بِشِعري","إذا ما رَمَتني بِرِمْشِ الكَسَلْ",98,"ل",1,0],["أَضُمُّكِ بينَ أَوْرِدَتِي وقَلْبِي","أُخَبِّئُ كَنْزِيَ المَكنونَ فِيَّا",99,"ي",2,0],["أضمخْ بنا كفنَ الأمواتِ أطيابا","فلم أجدْ لحياةِ الذلِ أسبابا",100,"ب",2,1],["أضمّكَ بين جفنيَّ احتمالاً","إذا كلّتْ لدى اللقيا الذراعُ",101,"ع",1,0],["اضمم اليك حبيبا في تولهه","يطيرُ رقصا وقد أودى به الألمُ",102,"م",1,0],["أُضمّن الحرفَ لغزا فيه أجوبتي","علّ القلوب ترى في كنه توريتي",103,"ي",1,1],["أُضَمِّدُ جُرْحَ القلبِ في ليلِ غُربتي","بقولٍ من (المجنونِ) زادَ اشتياقِيا:",104,"ي",2,0],["اضمن لي ان البحر ما فيه حوريّه","وأضمن لك انه يكون حكاية المينا",105,"ن",2,1],["\"اضمن لي ان البحر ما فيه حوريّه","واضمن لك انه يظل حكاية المينا\"",105,"ن",2,0],["آضَ مِثْلَ الرَّوْضِ لَمَّا أَنْ وَفا","جَفَّ مِنْ بَعْدِ ابْتِهاجٍ وَهَمَدْ",106,"د",1,0],["أَضُمُّها وَهيَ طَوْعٌ ما تُدافِعُنِي","مِنْ حَيْثُ عانَقْتُها إِلاَّ بِنَهْدَيْنِ",107,"ن",1,0],["أضمُّ عليه اِشفاقاً يميني","مِنَ الذكرى فينَفُضُها الخفوقُ",108,"ق",1,0],["اضمك في يديني لاتجي وتقول انا بر