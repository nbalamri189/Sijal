{"poems":[[53,"وليس نسيم المسك ريح حنوطه","https://www.aldiwan.net/poem65487.html","الطويل"],[68,"وليس صديقا من إذا قلت لفظة","https://www.aldiwan.net/poem38568.html","الطويل"],[48,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[463,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39109","الرجز"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32397","الطويل"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36074","الوافر"],[5725,"اما تستحي عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=207331",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""]],"verses":[["وليس صرير النعش ما تسمعونه","ولكنه أصلاب قوم تقصَّفُ",0,"ف",1,0],["وَلَيسَ صَديقاً مَن إِذا قُلتَ لَفظَةً","يُحاوِلُ في أَثناءِ مَوقِعِها أَمراً",1,"ر",2,1],["وليس صِبا يُفادُ وراء شيْبٍ","بأعْوَزَ مِن أخي ثِقَةٍ يُفادُ",2,"د",1,0],["وَلَيسَ صَعاليكُ العُرَيبِ كَيوسُفٍ","تَعالَوا نُباهِ الحَقَّ وَالحَقُّ أَوضَحُ",3,"ح",1,0],["وليس صَدْرُ الدِّينِ من شَكْلِهم","فَيقْتَضي قَوْليَ حاشاه",4,"ا",2,0],["وليس صديقيَ غيرَ الحزين","ليوم الحسين وغيرَ الأسوفِ",5,"ف",1,0],["وليس صيام الغيم يوماً بواجب","ولا مستحب في الصحيح المويد",6,"د",1,0],["وليسَ صِبْغاً فِيهِ لكنَّهُ","عَكْسُ شُعاعِ ذلكَ الخَدِّ",7,"د",1,0],["وَلَيسَ صَديقٌ يَرتَضي لِوَصِيَّةٍ","وَأَدعو لِدائي بِالشَرابِ فَما أَسقى",8,"ق",2,0],["وَلَيسَ صَنيعُهُ في الرَوعِ إِلّا","كَرَأيِكَ إِنّه العَضبُ الصَنيعُ",9,"ع",1,0],["وليس صريع الحب من جاء شاكيا","ولكنّ من يأتيك مضنى مقطّعا",10,"ع",2,0],["وليس صديقي ذا القرابة إنما","صديقي لما دون الحمام حميم",11,"م",1,0],["وليس صحابُ السجن إلَّا أذلةً","مثيلي ومدفونين عَبْرَ الغياهبِ",12,"ب",1,0]]}