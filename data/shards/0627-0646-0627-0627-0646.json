tsgate.com/ViewPoem.aspx?id=182762",""],[6108,"أحتاج بعدك","https://www.poetsgate.com/ViewPoem.aspx?id=192589",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[5075,"سأظلُ أملأ بالهنَا أقدَاحِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82755&r=&rc=1",""],[1583,"يا قمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73059&r=&rc=16",""],[6213,"هل تحيين بعدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79465&r=&rc=67",""],[6247,"غريبٌ أنا أم زماني غريبُ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80262&r=&rc=1",""],[6248,"رجع الخاصرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86024&r=&rc=1",""],[454,"يارنج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82663&r=&rc=27",""],[6289,"فَجْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81676&r=&rc=3",""],[6291,"عتاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87668&r=&rc=1",""],[6335,"خطاب لن يصل ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65402&r=&rc=0",""],[6341,"ذات غائبة..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87276&r=&rc=5",""],[5567,"كن بي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81765&r=&rc=33",""]],"verses":[["أَنا إِن لَم يُدافِعِ اللَهُ عَنّي","مَيِّتٌ مِن هَواكَ يا إِنسانُ",0,"ن",1,1],["أَنا إِن عِشتُ لَستُ أَعدَمُ قوتاً","وَإِذا مُتُّ لَستُ أَعدَمُ قَبرا",1,"ر",2,0],["أَنا إِن قَدَّرَ الإِلَهُ مَماتي","لا تَرى الشَرقَ يَرفَعُ الرَأسَ بَعدي",2,"د",2,0],["أَنا إِن لَم أُحسِنِ الرَميَ وَلَم","تَستَطِع كَفّايَ تَقليبَ الظُبا",3,"ب",2,0],["أَنا إِن جُدتِ بِوَصلٍ","أَحسَنُ العالَمِ حالا",4,"ل",2,0],["أنا إن لوى عني عذاراً أخضراً","في جنة المعهود عبد لاوي",5,"ي",1,0],["أَنا أَنتَ بِلا شَكٍّ","فَسُبحانُكَ سُبحاني",6,"ن",2,1],["أنا إن مِتُّ لا أشْك","كُ قتيلٌ لنائلكْ",7,"ك",1,0],["أنا إنْ لم تذدْ يميناك عني","غيرُ شكٍّ فريسةٌ مأكولهْ",8,"ل",2,0],["أَنا إِن شَكَوتُ إِلَيكَ مِن","كَ وَسالَ في كُتُبي العِتاب",9,"ب",1,0],["أَنا أَنتُم إِن ضَحِكتُم لِأَمرٍ","ضَحِكتُ وَأَدمُعُكُم أَدمُعي",10,"ع",2,0],["أَنا إِن أَغمَضَ الحَمامُ جُفوني","وَدَوى صَوتُ مَصرَعي في المَدينَه",11,"ن",2,1],["أَنا إِن مُتُّ بِفَرطِ ال","حُبِّ فيهِ لا أُلامُ",12,"م",1,0],["انا ان فرحت فكل لون ابيض","واذا يئست فكل لون اسود",13,"د",1,0],["انا ان سكت عن الذي قد غمني","فدمي الذي اهرقته يتكلم",14,"م",1,0],["انا ان هلكت فليس ما","آوى اليه سوى حفيره",15,"ر",2,0],["أنا إن جعلتك في نضا","ر بالحرير مجلل",16,"ل",1,0],["أَنا إِن أَهَنتُكَ في ثَراهُمُ فَالهَوى","وَالعَهدُ أَن يُبكَوا بِدَمعٍ جاري",17,"ر",2,0],["أَنا إِن بَذَلتُ الروحَ كَيفَ أُلامُ","لَمّا رَمَت فَأَصابَتِ الآرامُ",18,"م",1,1],["أَنا إِن عَجِزتُ فَإِنَّ في","بُردَيَّ أَشعَرَ مِن جَرير",19,"ر",1,0],["أَنا إِنْسانٌ بَراني اللّهُ","في صُورَةِ جِنِّي",20,"ن",2,0],["أنا إن راحَ أو غَدا لفِراقٍ","في رَواحٍ من الحِمامِ ومَغْدَى",21,"د",2,0],["أنا إن قلتُ للجمالِ سلاماً","فقليلٌ لذا الجمالِ سلامي",22,"م",2,0],["أنا إِن ضَاقَت بيَ الدنيا أفِئ","لثَوانٍ رحبةٍ قد وَسِعَتنا",23,"ن",2,0],["أنا إن ضاقت بي الدينا أفىء","لثوانٍ رحبةٍ قد وسعتنا",24,"ن",2,0],["إنّا أُناسٌ بما نُثني عليك به","نُهدي إليك رياضاً نوّرَتْ كَلِما",25,"م",2,0],["أنا إنْ سلوتُهم فما عُذْري","لا أَدْمُعي نفدَتْ ولا صبري",26,"ي",1,1],["أنا إن سافرتُ عنكمْ","لا يصرْ عندَكَ صورهْ",27,"ه",1,1],["إنّا انطلقنا صاعِدينَ لغايةٍ","للمجد مُنطلَقٌ بها وسَراحُ",28,"ح",1,0],["أَنا أَنتَ بَعد المَوت لا مُستعبد","حرّاً فَأَحقره وَلا مُستعبَد",29,"د",1,0],["أَنا إِن يَدروا بِحتفي ملتقِ","وَغَداً يَهدأ روعي",30,"ي",1,0],["أَنا إِن زُلتُ عَن مَقامي لِأَمرٍ","رابَني تَحتَ أَخمَصي ما يَضُرُّ",31,"ر",1,0],["أَنا إِن لَم أَمُت بِذاكَ فَإِنّي","مَيِّتٌ مِن مَخافَتي ذاكَ رُعبا",32,"ب",2,0],["أَنا أَنت يا شعري وأَنت أَنا فمن","يقرأك يقرأ سيرتي وشعوري",33,"ر",2,0],["أنا، إن قضيت هوى، فلا طلعت","شمس الضحى بعدي على أحد",34,"د",1,0],["أنا إن قتلتك كيف تحفظني","إن صح زعمك، حقظ مقتصد",34,"د",1,0],["أنا إن أعف قتلتها فعلام","لا تحيا بماء تعففي المهراق",35,"ق",1,0],["أنا إن أطلتُ القول في شمس الضحى","وصفاتها، ما قلت غيرَ مُعاد",36,"د",1,0],["أنا إِن أَطلتُ القول في أَمثاله","ما خفتُ من طول المقال ملاما",37,"م",2,0],["أنا إن لم أبْعَثْ إليك قريضي","فَلاَّنِّي يَخْشَى حَصَايَ جُمَانك",38,"ك",1,0],["أنا إن عَذَرْتُ، فإن جيلاً بعدكم","يا قوم، من أبنائكم لَنْ يَعْذُرا",39,"ر",2,0],["أنا إن غَفَرْتُ، فليس للتاريخ إنْ","يَكْتُبْ لعصر مقبل أن يَغْفرا",39,"ر",2,0],["أنا إن لم يكن قريني كريما","في مجال السباق عفت السباقا",40,"ق",2,0],["أنا إنْ عَدُّوا عليكم عثرة","قلت : أيُ الناس من لم يعثُر",41,"ر",1,0],["أنا إنْ كنت مُرهقاً في شبابي","مُثقلاً بالهموم والأوصابِ",42,"ب",1,1],["أنا إنْ بُلِّغتُ عنكم ريبةً","قلت : شكراً لهم مني وحمدا",43,"د",2,0],["أنا إن غصصتُ بما أحسُّ ففي فمي","ماء وبين جوانجي إيقاد",44,"د",1,0],["أنا إن بسمت ، وقد رأيتك مقبلا","فكما يهشّ لعائديه عليل",45,"ل",1,0],["أنا أن أغمض الحمام جفوني","ودودي صوت مصرعي في المدينة",46,"ن",2,1],["أنا.. أنا.. بانفعالاتي وأخيلتي","ترابُ نهديكِ قد حوّلتُهُ ذَهَبا...",47,"ب",2,0],["انا ان اعتم ذنبي ناظري","نور عيني اسد الله علي",48,"ل",2,0],["أَنا إن أَصمت فصمتي حسبه","إنه صوت الأَرقاء الأَبح",49,"ح",1,0],["أَنا إِن سكرت وما صح","وت فلا ألام ولن ألام",50,"م",1,0],["أنا إن هُمُ الذخائر دونهم","وهُمُ إذا عدّوا الفضائلَ دونى",51,"ن",2,0],["أَنَا أُنسٌ لِقَعُودٍ","أَنَا شُربٌ لِوُرُودِ",52,"د",1,1],["انا إن عشِقتُ ركبتُ أحلام الرؤى","لأهيمَ صبّا لا أعي، لا أدرِكُ",53,"ك",1,0],["أنا إن متُّ أفيكُم يا شباب","شاعرٌ يرثي شبابَ العسكَرِ",54,"ر",1,0],["أنا إن قلتُ أنا","عبدُ هذا السيدِ",55,"د",1,1],["انا ان سلوت فلا يعاودني الكرى","كلا ولا زار الخيال وسادي",56,"د",2,0],["انا ان احسنت وان هي اسائت","ليس دمعي برقا على من اساله",57,"ل",2,0],["انا ان سطا بسنان ذابل طرفه","لا طاقة لي بالعدو الازرق",58,"ق",1,0],["أنا إن شئت بذذت الشعراء","مثلما ذرّدت نوم الكاتبين",59,"ن",1,0],["أنا إن متّ مات روح مصوغ","من وفاء ورحمة ويقين",60,"ن",1,0],["أنا إِن طالَ في العِبادَةِ لَيلى","قَصَّرَت حلقَةُ الدروس نهاري",61,"ر",2,0],["أنا إنْسِيَّةٌ ولكنَّ حسني","حُسْن حُورِيّةٍ بجنَّة خُلْد",62,"د",1,0],["أنا إنسانٌ أليفٌ ذاكرٌ","إنما الإنسانُ من قد ذكرا",63,"ر",2,0],["أَنا إِنْ جُهلت لديك في ذلِّ الهوى","ما زلتُ أَعرف بالعزيزِ الأَروع",64,"ع",1,0],["أَنا إِنْ أَوجستُ منه خيفةً","خافه قبلي أَميرُ المؤمنين",65,"ن",1,0],["أنا إن كنت قد أسأت فإني","بشرٌ أصل خلقه من تراب",66,"ب",1,0],["أنا إن متُّ مات فنٌّ رفيعٌ","وهو إن مات طين وماء",67,"ا",2,0],["أنا إن لم أبذل الروح لم","وأفدى بطريفي وتليدي",68,"د",2,0],["أَنا أَنهاهُ ما اِستَطَعتُ فَإِن لَج","جَ أَعَرتُ الفُؤادَ يَأساً مُريحا",69,"ح",2,0],["أنا ان قضيت ليلي ساهراً","أقضهِ في عبث او عمل",70,"ل",1,0],["أَنا اِن لَم أَهو غزلان البَقا","أَيّ فَرق بَينَ قَلبي وَالجَماد",71,"د",1,0],["أنا أنت فيه ونحن أنت وأنت هو","والكل في هو هو فسل عمن وصل",72,"ل",1,0],["إنّا أُناسٌ سابِقون إلى العُلى","قَدْ صَدَّقَتْ أفعالُنا أقوالَنا",73,"ن",2,1],["أَنا إِن نَظَمْتُ الشعرَ فيه ساحِرٌ","حقًّا ولكنْ في سِواه ساخِرُ",74,"ر",1,0],["أنا إن لم أصف الوداد فبدّل","ت عن المرتضى بحبّ عتيق",75,"ق",1,0],["أنا إن أفاخر بالقديم فإنم","من نروه تتكسب الأنوار",76,"ر",1,0],["أنا أنا وأنت أنت","ما هي إلا شعاع أنت",77,"ت",1,0],["أَنا إنْ أَشجُو ففيهِمْ شَجَني","ولئنْ أَبكي فدَمْعي لَهُمُ",78,"م",1,0],["أَنا إنْ مُزِّقَ بعضي في الهَوَى","سَتَراهُ ساهِراً ما قدْ بَقي",79,"ق",2,0],["أنا إن زرت أو تخلفت عبد","بل ولي صفا وحقك وده",80,"د",2,0],["أنا أنَا شاعِرُه","أذودُ عن حِمَاه",81,"ا",2,0],["أَنا أَنتمُ وَأَنتمُ أَنا كالأَي","دِي رِفَاقِي شِمَالُهَا بِيَمِينِي",82,"ن",2,0],["أنا إِنْ مِتُّ في هَواكم قتيلاً","بدُموعِي بحقِّكم غسِّلوني",83,"ن",2,0],["أَنا إِن شَكَكتُ وَجَدتُموني جازِماً","وَإِذا جَزَمتُ فَإِنَّني لَم أَجزِمِ",84,"م",1,0],["إنا إن لم تَرَ التجوُّزَ في الحك","م وأَنْصَتَ أوّلُ الأصحابِ",85,"ب",1,0],["أَنا أَنْثَني عنها لِئَلاَّ أَرْتَوي","أَتَظُنُّ أَنِّ أَشْتَهي أَنْ أَشْتَفي",86,"ف",2,0],["أنا إن جئت في القيامة ما لي","غيركم يا بني الهدى الأنجادِ",87,"د",1,0],["أنا إن نطقت بمدحكم في مكة","فكأن قسا في عكاظ يخطب",88,"ب",1,0],["أنا إن غضبت وإن رضيت حبيب","وعلي تعداد الذنوب ذنوب",89,"ب",1,1],["إنا إِن أَستَنِشْهُمُ العزَّ في الدن","يا وفي الدينِ واجدٌ مستَناشا",90,"ش",2,0],["أنا إِنْ تخرَّمَتِ الحوادثُ شِرَّتي","فمضى حِرَاني واضمحلَّ شماسي",91,"س",2,0],["أنّا اِنتَقَلت مِن جِوارِها إِلى","أَخلاط قَوم عُلما وَنُبلا",92,"ل",2,0],["أنا.. أنا مثلما شاءتْ مُكابرتي","بالي طويلٌ كدربي حينَ أمشيهِ",93,"ه",1,0],["أنا أنت الضاربي مبتدأ","عدَد الأَخبارَ فيه مَن عنى",94,"ن",2,1],["أنا إن زار في ربيع من الوص","ل ومن حر هجره في هجيرِ",95,"ر",1,0],["أنا إن رمت سلوّاً","عنك يا قرة عيني",96,"ن",2,1],["أنا إن عتبت فأين مجال","العتاب عليك وأين مجالي",97,"ل",2,0],["أنا إن غبتُ يا حبيبةُ ينهدّ","شروقي غداً وَيفنى طموحي",98,"ح",2,0],["أنا إن غلوت تشاوفا بك فاتئد","ما أنت دياني ولا أنا ملحد",99,"د",1,0],["أَنا إِن قاومته جرعني","غصص المَوت كَريهات المَذاق",100,"ق",1,0],["إِنّا أُناسٌ مِن سَجِيَّتِهِم","صِدقُ الحَديثِ وَرَأيُهُم حَتمُ",101,"م",1,0],["أنا ان اعتب فلي العتبى","لم يبق لخيلي من مركض",102,"ض",1,0],["أنا إن نزعتُ عن الغوايةِ والصبا","فلطالما استهوتني الآثامُ",103,"م",1,1],["أَنا إِنَّما أَبكي الذُنوبَ وَأَسرِها","وَمُنايَ في الشَكوى مَنالُ فَكاكي",104,"ك",2,0],["أنا إن أشك صاحبي فقديما","لم أجد في الصحاب من أشكانى",105,"ن",2,0],["أنا إن أبت موثقا في يديها","بقيود الهوى وذلّ الجفاء",106,"ا",2,0],["أنا إن شعرتُ فليس لي","فضلٌ وفيكَ الصخر شاعر",107,"ر",1,0],["أنا ان شئت أدعو الكون يرقص","باذن اللَه واسكُن دَع جدال",108,"ل",1,0],["أنا إن قلت فيك ماقلته فالنظم","فيه كلالة واطاله",109,"ل",2,0],["أنا إن هويت فما أريد سوى العلا","غرضاً ولا غير الفخار طلابا",110,"ب",2,0],["أنا إن همتُ صبوةً بالعذار","في الغرام العذريّ صح اعتذاري",111,"ر",2,1],["أنا إن عشتُ لا أغيِّر عهدي","وإذا متُّ سوفَ يحيا غرامي",112,"م",2,0],["إنا أناس إذا زرنا ذوي كرم","قد غصّ مجلسهم بالسادة الغرر",113,"ر",1,1],["أنا إن امسيتُ يوماً عدماً","فاذكروا سر وجودي واذكرون",114,"ن",1,0],["أَنا أَنتمُ أَم أَنتمُ أَنا بَيِّنُوا","حقيقةَ ما أَعني فقد خَفِيَتْ عنِّي",115,"ن",2,1],["انا اناس برغم الدهر طاب لنا","ورد العلى من أنابيب العوالي",116,"ي",1,0],["أنا إن شئتُ شئتُ منل إلا","أنا إن شئتُ شاء من لا يشاءُ",117,"ا",2,1],["أنا إن تعذب زهرتي","في الصيف أرياح النجف",118,"ف",1,0],["إنّا أناسٌ لم نَدع نهجَ الهُدى","إن كثَّر الساعي بنا أو قَلّلا",119,"ل",2,0],["أنا إن أبكِ كثيراً","ينضب الدمع وينفد",120,"د",