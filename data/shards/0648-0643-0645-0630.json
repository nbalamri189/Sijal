{"poems":[[88,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[74,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[74,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[74,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[74,"تعشقته غصنا ناضرا","https://www.aldiwan.net/poem20572.html","المتقارب"],[72,"أفدي حبيبا لساني ليس يذكره","https://www.aldiwan.net/poem42418.html","البسيط"],[45,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[45,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[47,"أعن سفه يوم الأبيرق أم حلم","https://www.aldiwan.net/poem65673.html","الطويل"],[101,"إلى رجل","https://www.aldiwan.net/poem6618.html","عموديه"],[83,"لك العذر إن لم أعد زورة","https://www.aldiwan.net/poem61509.html","المتقارب"],[54,"لمن دار وربع قد تعفى","https://www.aldiwan.net/poem27164.html","الوافر"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[119,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[173,"تجاف عن العتبى فما الذنب واحد","https://www.aldiwan.net/poem1614.html",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[275,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[303,"تعالى المبدع القدس","https://www.aldiwan.net/poem36858.html","عموديه"],[309,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[353,"وكم ذدت آمالي وقد ذبت خجلة","https://www.aldiwan.net/poem20657.html","الطويل"],[369,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[408,"إلى كم تغضون من قدرنا","https://www.aldiwan.net/poem46452.html","المتقارب"],[409,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[445,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[447,"سلوا هل تروا خلقا وإن عز باقيا","https://www.aldiwan.net/poem14491.html","الطويل"],[463,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[469,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[527,"لسائل الدمع عن بغداد أخبار","https://www.aldiwan.net/poem1307.html",""],[556,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[556,"ألا لا تصدني بإطماعة","https://www.aldiwan.net/poem47312.html","المتقارب"],[556,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[556,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[556,"رأيتكم تجنون ما قد غرستم","https://www.aldiwan.net/poem47392.html","الطويل"],[556,"أمنت حذاري منكم وكفيتكم","https://www.aldiwan.net/poem47765.html","الطويل"],[556,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[556,"إلى كم أقود قوما","https://www.aldiwan.net/poem47833.html","المضارع"],[556,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[556,"أرى عزة من بين أثناء ذلة","https://www.aldiwan.net/poem48027.html","الطويل"],[580,"فراق قضى للهم والقلب بالجمع","https://www.aldiwan.net/poem3053.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83265","المتقارب"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67832","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121116","الطويل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75731","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112782","الطويل"],[1308,"","https://poetry.dctabudhabi.ae/diwan/poem/95821","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144007","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6767","الوافر"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113645","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93091","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101013","الطويل"],[1995,"","https://poetry.dctabudhabi.ae/diwan/poem/141717","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101717","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60948","المتقارب"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87760","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2613,"","https://poetry.dctabudhabi.ae/diwan/poem/144622","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100393","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100262","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100424","المتقارب"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109798","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204735","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200130","المتقارب"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112502","الطويل"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124294","الطويل"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136894","البسيط"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105626","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109898","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131960","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91499","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91283","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102747","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94631","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57986","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76726","الطويل"],[4717,"صريع ٌ بعرضِ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=199577",""],[5005,"محاولة..","https://www.poetsgate.com/ViewPoem.aspx?id=201100",""],[5038,"ظبية النهرين","https://www.poetsgate.com/ViewPoem.aspx?id=195421",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5121,"يَعيشُ الحَرْفُ","https://www.poetsgate.com/ViewPoem.aspx?id=214863",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5277,"مِن تهجّدات البدوي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=208837",""],[5327,"حزبُ الضِّرار","https://www.poetsgate.com/ViewPoem.aspx?id=147708",""],[2079,"إلى كم أداري والحبيب نفور","https://www.poetsgate.com/ViewPoem.aspx?id=123849",""],[5459,"سكر دون راح","https://www.poetsgate.com/ViewPoem.aspx?id=198866",""],[5582,"أَهاجَ لَكَ التَّذْكارَ وَالوَجْدَ بارِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187213",""],[5616,"إلى من كان صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=205215",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[5689,"محيط الليالي كلنا بك نسبح","https://www.poetsgate.com/ViewPoem.aspx?id=143407",""],[5880,"ليلة المزرعة","https://www.poetsgate.com/ViewPoem.aspx?id=208586",""],[6079,"أيُبكيكَ رَسمٌ في الشآم عليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207850",""],[6251,"أنتَ الأمَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76468&r=&rc=8",""],[5126,"فكره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87793&r=&rc=8",""],[5190,"هو الشعر أرقى فنون الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78296&r=&rc=9",""]],"verses":[["وَكَم ذا بِمِصرَ مِنَ المُضحِكاتِ","كَما قالَ فيها أَبو الطَيِّبِ",0,"ب",1,0],["وكم ذي كتابٍ في الورى وكتيبةٍ","غدَا داخِلاً من موته تحت مكتوب",1,"ب",1,0],["وكم ذابحٍ للصبِّ يومَ تحملوا","بأخبيةٍ غنى بها للسرى سعد",2,"د",1,0],["وكم ذابل في العيون التي","سناها بسهدٍ لها ماحق",3,"ق",1,0],["وكم ذا أدور على خصرهِ","وما وقعت ليَ عينٌ عليه",4,"ي",2,0],["وَكَم ذَكَرتُ مُسَمّىً لا اِكتِراثَ بِهِ","حَتّى يَجُرَّ إِلى ذِكراكَ ذِكراهُ",5,"ا",2,0],["وَكَم ذَنبٍ مُوَلِّدُهُ دَلالٌ","وَكَم بُعدٍ مُوَلِّدُهُ اِقتِرابُ",6,"ب",1,0],["وَكَم ذَدتَ عَنهُم رَدىً بِالرَدى","وَكَشَّفتَ مِن كُرَبٍ بِالكُرَب",7,"ب",1,0],["وَكَم ذُدتَ عَنّي مِن تَحامُلِ حادِثٍ","وَسَورَةِ أَيّامٍ حَزَزنَ إِلى العَظمِ",8,"م",1,0],["وكم ذهبت لوعد لا وجود له","وكم حلمت بأثواب سأشريها",9,"ي",3,0],["وَكَم ذاقَ جَمراً أَخوكَ النُضارُ","وَمُشبِهُكَ المَشرَفِيُّ الذَكَر",10,"ر",1,0],["وَكَم ذَمٍّ لَهُم في جَنبِ مَدحٍ","وَجِدٍّ بَينَ أَثناءِ المُزاحِ",11,"ح",1,0],["وَكَمْ ذَخائِرَ ما عِنْدَ المُلُوكِ لَها","مِثْلٌ فَمِنْ مُودَعٍ سَقْفاً وَمَدفُونِ",12,"ن",1,0],["وكم ذكرياتٍ لها عَذْبَةٍ","أعيش عليها وأحيا بها",13,"ه",2,0],["وَكَم ذا العِراكُ أَلَم يَكفِني","مُصابي في وَلَدي مَعرَكا",14,"ك",2,0],["وكم ذلة عمت بنا وبسره","أزيلت ولطفاً بدلت الرضى نصرا",15,"ر",2,0],["وَكَم ذا أُناجي هِمَّةً دونَ هَمّها","نُجومُ الثُرَيّا وَالسُهى وَالفَراقِدُ",16,"د",1,0],["وَكَم ذا رَأَينا في الأُلى يدّعونه","تُيوساً وكَم ذا قَد رَأينا بهم حُمرا",17,"ر",2,0],["وَكَم ذا منَ الأعرابِ وافاه جاهلٌ","كَوحشِ الفَلا قد أشبهَ الذئبَ والنِمرا",18,"ر",2,0],["وَكَم ذا على الرَمضاءِ ألقَوا ضعافهم","عَلى الظهرِ ظُهراً واصلَ الفجر والعصرا",18,"ر",2,0],["وَكَم ذا رَأينا عاقلاً منهمُ صحا","وَكانَ بخمرِ الكُفرِ مُمتلئاً سكرا",18,"ر",2,0],["وَكَم ذا مِن مَريضٍ قد شفاهُ","وَلو شلّت جوارحهُ وسلّا",19,"ل",2,0],["وَكَم ذَلَّلتَ مِن مُلكٍ عَزيزٍ","وَكَم دَوَّختَ مِن حَيٍ لَقّاح",20,"ح",1,0],["وكم ذاتِ أطفالٍ على العري والطَّوى","تعيشُ لئلا تفقدَ الشَّرفَ الأطهر",21,"ر",1,0],["وكم ذا طأْطأَتْ هامٌ","وذَلَّتْ آنفٌ عطس",22,"س",1,0],["وكم ذا تركنين إلى الدنايا","وكم تتقاعدين عن المعالي",23,"ل",2,0],["وَكمْ ذُدْتُ آمالي وَقَدْ ذُبتُ خَجلةً","وإحسانُكَ الدَّاعِي لإفْراطِ إذْلالي",24,"ي",1,1],["وكم ذا تُرى يَبْقَى سَوادِي بحالِه","إذا اختلفَتْ بِيضُ اللّيالي وسُودها",25,"د",3,0],["وكم ذَا تهينونَ أعراضنا","ونحنُ لأَعْراضِكم نكْرِم",26,"م",1,0],["وكم ذا عسى أمليه من عَدِّ فضله","ومن رام عدَّ الشُّهْبِ لم يتيسر",27,"ر",1,0],["وكم ذَكَّرَتْ منكَ أَيَّامُهُ","مقاماً كريماً وفِعلاً حَميدا",28,"د",2,0],["وكم ذي ثراء صار في هامد الثرى","ويرحل عنها أصغر الكف عاريا",29,"ي",2,0],["وكم ذكرتَ روضَه وغُدْرَه","والعَمَمَ الملتفَّ والمَعِينا",30,"ن",2,0],["وكم ذَابلٍ يَنمي بجوهرِ نفسِه","فيُرعَى ووافي النبت وهو وخيمُ",31,"م",1,0],["وكم ذي شارةٍ معناه رثٌّ","وأشعثَ بين طِمْريه أُسامَهْ",32,"م",2,0],["وكم ذبّ عن عرضي ذبابُ لسانهِ","قذاعَ حسودٍ يشبهُ النارَ في اللفح",33,"ح",1,0],["وكم ذخائر أضحت وهي شائعة","من النهاب وقد حازته كفار",34,"ر",1,0],["وكم ذا أعدتَ لهمْ مُلكَهمْ","وقد صار في كُفّةِ الحابلِ",35,"ل",1,0],["وكم ذا فرجتُ لهمْ ضيّقاً","وكم ذا كفيتُ لهمْ مُعضِلا",36,"ل",2,0],["وكم ذا لنا والهجرُ ملتبسٌ بنا","نلاقي ضميراً والهوى متواصلُ",37,"ل",1,0],["وكم ذا نُعير المُطمعات عيونَنا","ونُدنِي إلى ريح الغرورِ المناشقا",38,"ق",2,0],["وكم ذا أُرِيدَتْ بالهَوانِ بيوتُكمْ","فلَمْ تجعلوا من دونهنَّ سِجافا",39,"ف",2,0],["وَكَم ذا نَفضتُ الكفّ من نَصر أُسرتي","عَلى خُطّةٍ خشناءَ واللَّهُ ناصري",40,"ر",2,0],["وَكَم ذا خَشيتُ الأمرَ قبلَ هجومِهِ","وسُرْبِلتُه كُرْهاً فلم يكُ ضائرِي",40,"ر",2,0],["وَكَم ذا صحبنا لأكل التّراب","أناساً ثَوَوْا يلبسون الحريرا",41,"ر",2,0],["وكم ذا أجود دهرِي","لمن ليس بالجوادِ",42,"د",1,0],["وَكَم ذا رَأَينا عيوناً بكي","نَ عند الرّزايا بلا مُسعِدِ",43,"د",1,0],["وَكَم ذا رَأينا والعَجائب جمّةٌ","زجاجةَ سعدٍ صَدّعتْ نحسَ صخرةِ",44,"ه",1,0],["وكَمْ ذَابَ من جَمْر التَّعانُقِ بَيْننا","قلائدُها حتى افْتَرقْنا مِن اللَّذْع",45,"ع",1,0],["وَكَم ذا بِجَسرَينِ مِن لَيلَةٍ","عَلى مِثلِ جَمرِ الغَضا في الضَرَم",46,"م",1,0],["وَكَمْ ذَا أُنَادِي حَوْلَ كَاظِمَةِ اللِّوى","لَحَى الله مَنْ يَلْحى الْمُحِبِّينَ فِي الْهَوى",47,"ه",3,0],["وكم ذا يحملني الهوى فوق طاقتي","ويسعد لاحٍ بالملامة والقدح",48,"ح",1,0],["وَكَم ذا خلونا في الرياض وَبيننا","حَديث لنا في شرب راووقه حث",49,"ث",1,0],["وكم ذل كم ارد اطغاة وكم سقى","لاهل الهنا أهنا شراب ومورد",50,"د",1,0],["وكم ذا تعلّل لي وَيحها","بعلّ وسوف وكم تَمطُل",51,"ل",1,0],["وكم ذا أؤمِّل طول البَقاء","وأغفُل والموتُ لا يَغفل",51,"ل",1,0],["وكم ذنَبٍ قد صار رأساً وجبهةٍ","تودّ اضطراراً أنها في الأخامِصِ",52,"ص",1,0],["وَكَم ذيبٍ نُجاوِرَهُ وَلَكِن","رَأَيتُ الذِئبَ أَسلَمَ مِن فَقيهِ",53,"ي",2,0],["وكم ذا أقاسي سورة البين والأسى","ولا يرحم العذَّال منِّي توجُّعا",54,"ع",2,0],["وكم ذلت لسطوتهم صعاب","حذاراً وانقياد الصعب صعب",55,"ب",1,0],["وكم ذلّ للمحبوب من متعَزّز","وهان لاحكام الهوى من تصعّبا",56,"ب",2,0],["وكم ذا وكم من باطل يدَّعونه","ترى الطفلَ عن أمثاله يترفَّع",57,"ع",1,0],["وكم ذدت عنها من يروم هجاءها","بصمصامة عبلى الرقاب قرابها",58,"ب",3,0],["وكم ذا تجور وجفني يجود","بدمع يزيد الضنى والعلل",59,"ل",1,0],["وكم ذاك تُقْفر منه الرسومُ","وكم ذاك توحِشُ منه الطلولُ",60,"ل",1,0],["وَكَم ذُقت طَعم المَوت في البَحر عِندَما","عَصَفنَ بِنا فيهِ عَواصفه النُكب",61,"ب",1,0],["وكم ذاب قلب من جواه وحزنه","وكم ضربة من هولها شابت الولد",62,"د",1,0],["وكم ذي يَراعٍ راضَ شامسَ فِتنةٍ","فلانتْ ولم يُصحَبْ بجيشٍ عَرَمْرَمِ",63,"م",1,0],["وكم ذا اشيم العين خلّب بارق","واسجر نعَّاباً من الطير اشأما",64,"م",2,0],["وكم ذا وقلبُ الدين صادٍ غليله","تُلثم عرنينَ المهنّدِ بالصدِّ",65,"د",1,0],["وكم ذا اكتِّم اسراريه","اما آن يظهر اعلانيه",66,"ي",2,0],["وكم ذكر المحب به حبيباً","وكم نسي الخدين به خدين",67,"ن",1,0],["وكم ذم شعري عند الحضور","وراسل بالذم بعد السفر",68,"ر",1,0],["وكم ذا أمدّ مدى الأصطبار","فان زدت في مدّه يقطع",69,"ع",1,0],["وكم ذا وقاني البرد في جنح ليلة","بها الموت من كل المواجع شاف",70,"ف",1,0],["وكم ذا ثوت من ذات دعد معاقلا","عقائل أترابٍ وصيدٌ فوارسُ",71,"س",1,0],["وكم ذوات خدور قد برزن بها","مهتكات بلا ستر ولا حجب",72,"ب",1,0],["وكم ذا أرى فيء النبي مقسما","برغم حماة الدين بين ذوي الغدر",73,"ر",1,0],["وَكَم ذَليل عارٍ وَلا برد","أَلبسته بردة الأَعزّاءِ",74,"ا",2,0],["وكم ذي ضَنىً أَبرَى ثراهُ ومُدنَفٍ","ومن رِبَقَات العجز قد حلَّ مُقعَدا",75,"د",2,0],["وكم ذَوَى منكِ يا ريحَ السَمُوم فتىً","غَضُّ الشبيبةِ يزهو بالصِبا الرَطِبِ",76,"ب",1,0],["وكم ذي فطنة أخنت عليه","وعاش منعما فيها البليد",77,"د",1,0],["وَكَم ذا أَنوحُ وَلم يُجدِ نَوحٌ","وَأَكتمُ وَالحالُ بالسرّ فاشي",78,"ش",2,0],["وَكَم ذا الصَبر وَالدُنيا تُعادي","لَقَد أَوسعتُ دُنياي اِحتِمالا",79,"ل",2,0],["وكم ذي زهو افترست سباع ال","فناء وخانه الأمل المديد",80,"د",1,0],["وكم ذي صغارٍ ناحلين يراهم","يموتون جوعاً وهو لهفان ساغب",81,"ب",1,0],["وكم ذل أقوام لعزة دينه","وكم خطمت بالحق للشرك آنف",82,"ف",1,0],["وكم ذكت بمهجتي","من خده نيرانه",83,"ن",2,0],["وكم ذكر الأخدان في السُبر سُربَنا","كما غادر الألبابُ ذِكرى الحماقيسِ",84,"س",1,0],["وكم ذاق جمعُ الناس أمناً وراحة","وكمْ ذاق هذا الخلق شر البليات",85,"ت",1,0],["وكم ذر لي من أفق بشرك شارق","والليل القطع من اونه قطعاً كذا",86,"ذ",2,0],["وكم ذَا بمصرٍ من أخٍ لو رأيتَهُ","كسيراً ... وأعباءُ الحياة تزاحمُهْ",87,"م",2,0],["وكم ذا أتقن الأحزان قوم","ولكن للعذابات احتراف",88,"ف",1,0],["وَكَمْ ذَكَرْتُ الْأُلى في غَيرِ قافِيَةٍ","كَأنَّني بِهِمُ أَرْقى إِلى الشُّهُبِ",89,"ب",1,0],["وكم ذي دوىً عاف الدواء وذي سرى","بقوس سراءٍ حب فهو صباء",90,"ا",2,0],["وَكَمْ ذُقْنَا مِنَ الآهَاتِ فِكْراً","وَلَمْ يَلْقَ الأَمَانِي فِيهِ عَقْلُ",91,"ل",1,0],["وكم ذادت عن الحمة العجوز55","وندت خوف خاتلها العجوز56",92,"ز",1,0],["وكم ذا قد قصدتُكَ في أُموري","فعُدتُ بِنُجحِ أمري أستنيلُ",93,"ل",1,0],["وَكَم ذِى لِحيَةٍ بالزُّورِ تنمو","يُخادِعُ بالتديُّنِ تابعيهِ",94,"ي",2,0],["وكم ذا ترى أصبو بحب مهفهف","هواه لأشجان الغرام يثير",95,"ر",1,0],["وكم ذا غرّني وجهٌ مليح","وعَيبُ الغر تصديقُ الملاح",96,"ح",1,0],["وَكَمْ ذُقْتُ مِنْ تِرْشافِ رِيقَةِ ثَغْرِها","جَنَىً لَمْ يَذُقْهُ قَبْلُ فِي النَّاسِ ذائِقُ",97,"ق",1,0],["وكمْ ذا نسجْنا الكلامَ الأليفَ","وكم ذا لَبِسْناه بُرْدا زَهيَّا",98,"ي",2,0],["وكم ذا قد شفينا من غليل","لشعب كان في حال السجين",99,"ن",1,0],["وكم ذر من نجم ولكن نوره","وراء الدياجي قد يبيت ويصبح",100,"ح",1,0],["وكم ذكرةٍ سنحت في الفؤادِ","تجدِّد آهاتِه الموجِعَهْ!",101,"ع",2,0],["وكم ذاق هذا القلب من ماء علقمٍ","ولم يُشفَ منهُ بالبكاء غليلُ",102,"ل",1,0],["وُكَمْ ذَريْنَا دَمْعَ أَجْفَانَنَا","لَعَلَّهِنْ مِنْ مَاءَهَا يَسْتَقَيْنْ",103,"ن",1,0],["وَكمْ ذِكْرَيَاتٍ قَدْ أتَتْ وتَصَرَّمَتْ","فَتُنْسَى أوَالِيْها وَتُنْسَى التَّوَالِيَا",104,"ي",2,1],["وكم ذا ببيتٍ يُبيدُ الطغاةَ","ويدحرُ من قوةٍ غازيهْ",105,"ي",2,0]]}