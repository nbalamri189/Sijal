{"poems":[[86,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[72,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[72,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[72,"تعشقته غصنا ناضرا","https://www.aldiwan.net/poem20572.html","المتقارب"],[70,"أفدي حبيبا لساني ليس يذكره","https://www.aldiwan.net/poem42418.html","البسيط"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[43,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[45,"أعن سفه يوم الأبيرق أم حلم","https://www.aldiwan.net/poem65673.html","الطويل"],[99,"إلى رجل","https://www.aldiwan.net/poem6618.html","عموديه"],[81,"لك العذر إن لم أعد زورة","https://www.aldiwan.net/poem61509.html","المتقارب"],[52,"لمن دار وربع قد تعفى","https://www.aldiwan.net/poem27164.html","الوافر"],[67,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[115,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[169,"تجاف عن العتبى فما الذنب واحد","https://www.aldiwan.net/poem1614.html",""],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[189,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[252,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[270,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[298,"تعالى المبدع القدس","https://www.aldiwan.net/poem36858.html","عموديه"],[304,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[348,"وكم ذدت آمالي وقد ذبت خجلة","https://www.aldiwan.net/poem20657.html","الطويل"],[364,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[402,"إلى كم تغضون من قدرنا","https://www.aldiwan.net/poem46452.html","المتقارب"],[403,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[439,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[441,"سلوا هل تروا خلقا وإن عز باقيا","https://www.aldiwan.net/poem14491.html","الطويل"],[458,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[458,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[458,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[464,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[522,"لسائل الدمع عن بغداد أخبار","https://www.aldiwan.net/poem1307.html",""],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"ألا لا تصدني بإطماعة","https://www.aldiwan.net/poem47312.html","المتقارب"],[551,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[551,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[551,"رأيتكم تجنون ما قد غرستم","https://www.aldiwan.net/poem47392.html","الطويل"],[551,"أمنت حذاري منكم وكفيتكم","https://www.aldiwan.net/poem47765.html","الطويل"],[551,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[551,"إلى كم أقود قوما","https://www.aldiwan.net/poem47833.html","المضارع"],[551,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[551,"أرى عزة من بين أثناء ذلة","https://www.aldiwan.net/poem48027.html","الطويل"],[575,"فراق قضى للهم والقلب بالجمع","https://www.aldiwan.net/poem3053.html","الطويل"]],"verses":[["وَكَم ذا بِمِصرَ مِنَ المُضحِكاتِ","كَما قالَ فيها أَبو الطَيِّبِ",0,"ب",1,0],["وكم ذي كتابٍ في الورى وكتيبةٍ","غدَا داخِلاً من موته تحت مكتوب",1,"ب",1,0],["وكم ذابحٍ للصبِّ يومَ تحملوا","بأخبيةٍ غنى بها للسرى سعد",2,"د",1,0],["وكم ذابل في العيون التي","سناها بسهدٍ لها ماحق",3,"ق",1,0],["وكم ذا أدور على خصرهِ","وما وقعت ليَ عينٌ عليه",4,"ي",2,0],["وَكَم ذَكَرتُ مُسَمّىً لا اِكتِراثَ بِهِ","حَتّى يَجُرَّ إِلى ذِكراكَ ذِكراهُ",5,"ا",2,0],["وَكَم ذَنبٍ مُوَلِّدُهُ دَلالٌ","وَكَم بُعدٍ مُوَلِّدُهُ اِقتِرابُ",6,"ب",1,0],["وَكَم ذَدتَ عَنهُم رَدىً بِالرَدى","وَكَشَّفتَ مِن كُرَبٍ بِالكُرَب",7,"ب",1,0],["وَكَم ذُدتَ عَنّي مِن تَحامُلِ حادِثٍ","وَسَورَةِ أَيّامٍ حَزَزنَ إِلى العَظمِ",8,"م",1,0],["وكم ذهبت لوعد لا وجود له","وكم حلمت بأثواب سأشريها",9,"ي",3,0],["وَكَم ذاقَ جَمراً أَخوكَ النُضارُ","وَمُشبِهُكَ المَشرَفِيُّ الذَكَر",10,"ر",1,0],["وَكَم ذَمٍّ لَهُم في جَنبِ مَدحٍ","وَجِدٍّ بَينَ أَثناءِ المُزاحِ",11,"ح",1,0],["وَكَمْ ذَخائِرَ ما عِنْدَ المُلُوكِ لَها","مِثْلٌ فَمِنْ مُودَعٍ سَقْفاً وَمَدفُونِ",12,"ن",1,0],["وكم ذكرياتٍ لها عَذْبَةٍ","أعيش عليها وأحيا بها",13,"ه",2,0],["وَكَم ذا العِراكُ أَلَم يَكفِني","مُصابي في وَلَدي مَعرَكا",14,"ك",2,0],["وكم ذلة عمت بنا وبسره","أزيلت ولطفاً بدلت الرضى نصرا",15,"ر",2,0],["وَكَم ذا أُناجي هِمَّةً دونَ هَمّها","نُجومُ الثُرَيّا وَالسُهى وَالفَراقِدُ",16,"د",1,0],["وَكَم ذا رَأَينا في الأُلى يدّعونه","تُيوساً وكَم ذا قَد رَأينا بهم حُمرا",17,"ر",2,0],["وَكَم ذا منَ الأعرابِ وافاه جاهلٌ","كَوحشِ الفَلا قد أشبهَ الذئبَ والنِمرا",18,"ر",2,0],["وَكَم ذا على الرَمضاءِ ألقَوا ضعافهم","عَلى الظهرِ ظُهراً واصلَ الفجر والعصرا",18,"ر",2,0],["وَكَم ذا رَأينا عاقلاً منهمُ صحا","وَكانَ بخمرِ الكُفرِ مُمتلئاً سكرا",18,"ر",2,0],["وَكَم ذا مِن مَريضٍ قد شفاهُ","وَلو شلّت جوارحهُ وسلّا",19,"ل",2,0],["وَكَم ذَلَّلتَ مِن مُلكٍ عَزيزٍ","وَكَم دَوَّختَ مِن حَيٍ لَقّاح",20,"ح",1,0],["وكم ذاتِ أطفالٍ على العري والطَّوى","تعيشُ لئلا تفقدَ الشَّرفَ الأطهر",21,"ر",1,0],["وكم ذا طأْطأَتْ هامٌ","وذَلَّتْ آنفٌ عطس",22,"س",1,0],["وكم ذا تركنين إلى الدنايا","وكم تتقاعدين عن المعالي",23,"ل",2,0],["وَكمْ ذُدْتُ آمالي وَقَدْ ذُبتُ خَجلةً","وإحسانُكَ الدَّاعِي لإفْراطِ إذْلالي",24,"ي",1,1],["وكم ذا تُرى يَبْقَى سَوادِي بحالِه","إذا اختلفَتْ بِيضُ اللّيالي وسُودها",25,"د",3,0],["وكم ذَا تهينونَ أعراضنا","ونحنُ لأَعْراضِكم نكْرِم",26,"م",1,0],["وكم ذا عسى أمليه من عَدِّ فضله","ومن رام عدَّ الشُّهْبِ لم يتيسر",27,"ر",1,0],["وكم ذَكَّرَتْ منكَ أَيَّامُهُ","مقاماً كريماً وفِعلاً حَميدا",28,"د",2,0],["وكم ذي ثراء صار في هامد الثرى","ويرحل عنها أصغر الكف عاريا",29,"ي",2,0],["وكم ذكرتَ روضَه وغُدْرَه","والعَمَمَ الملتفَّ والمَعِينا",30,"ن",2,0],["وكم ذَابلٍ يَنمي بجوهرِ نفسِه","فيُرعَى ووافي النبت وهو وخيمُ",31,"م",1,0],["وكم ذي شارةٍ معناه رثٌّ","وأشعثَ بين طِمْريه أُسامَهْ",32,"م",2,0],["وكم ذبّ عن عرضي ذبابُ لسانهِ","قذاعَ حسودٍ يشبهُ النارَ في اللفح",33,"ح",1,0],["وكم ذخائر أضحت وهي شائعة","من النهاب وقد حازته كفار",34,"ر",1,0],["وكم ذا أعدتَ لهمْ مُلكَهمْ","وقد صار في كُفّةِ الحابلِ",35,"ل",1,0],["وكم ذا فرجتُ لهمْ ضيّقاً","وكم ذا كفيتُ لهمْ مُعضِلا",36,"ل",2,0],["وكم ذا لنا والهجرُ ملتبسٌ بنا","نلاقي ضميراً والهوى متواصلُ",37,"ل",1,0],["وكم ذا نُعير المُطمعات عيونَنا","ونُدنِي إلى ريح الغرورِ المناشقا",38,"ق",2,0],["وكم ذا أُرِيدَتْ بالهَوانِ بيوتُكمْ","فلَمْ تجعلوا من دونهنَّ سِجافا",39,"ف",2,0],["وَكَم ذا نَفضتُ الكفّ من نَصر أُسرتي","عَلى خُطّةٍ خشناءَ واللَّهُ ناصري",40,"ي",1,0],["وَكَم ذا خَشيتُ الأمرَ قبلَ هجومِهِ","وسُرْبِلتُه كُرْهاً فلم يكُ ضائرِي",40,"ي",1,0],["وَكَم ذا صحبنا لأكل التّراب","أناساً ثَوَوْا يلبسون الحريرا",41,"ر",2,0],["وكم ذا أجود دهرِي","لمن ليس بالجوادِ",42,"د",1,0],["وَكَم ذا رَأَينا عيوناً بكي","نَ عند الرّزايا بلا مُسعِدِ",43,"د",1,0],["وَكَم ذا رَأينا والعَجائب جمّةٌ","زجاجةَ سعدٍ صَدّعتْ نحسَ صخرةِ",44,"ه",1,0],["وكَمْ ذَابَ من جَمْر التَّعانُقِ بَيْننا","قلائدُها حتى افْتَرقْنا مِن اللَّذْع",45,"ع",1,0]]}