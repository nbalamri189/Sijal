غ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[461,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[461,"نكبا صمتي وخافا صخبي","https://www.aldiwan.net/poem15144.html","الرمل"],[461,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[464,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[464,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[464,"عيون المها مالي بسحرك من يد","https://www.aldiwan.net/poem3556.html","عموديه"],[468,"ووضيع يقاوم الشرفاء","https://www.aldiwan.net/poem60515.html","الخفيف"],[475,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[479,"انظر على جبل المنار غزالا","https://www.aldiwan.net/poem37065.html","الكامل"],[479,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[479,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[495,"إن لله عبيدا في زوايا الأرض غبرا","https://www.aldiwan.net/poem9859.html","مجزوء الرمل"],[500,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[500,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[500,"سقط الفحول عن الأرائك","https://www.aldiwan.net/poem38102.html","مجزوء الكامل"],[505,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[514,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[515,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[538,"ألحمد لله زال الخوف والوجل","https://www.aldiwan.net/poem47987.html","عموديه"],[551,"أيها الشيخ إن من ثور الصيد","https://www.aldiwan.net/poem47261.html","الخفيف"],[551,"يا طالب الدنيا على ذل بها","https://www.aldiwan.net/poem47304.html","الكامل"],[551,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[551,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[558,"كل مصنوع بمن قد صنعه","https://www.aldiwan.net/poem34365.html","الرمل"],[562,"لك الهناء بما أوتيت معتذرا","https://www.aldiwan.net/poem52962.html","البسيط"],[564,"يأتي على الناس إصباح وامساء","https://www.aldiwan.net/poem822.html",""],[567,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[575,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[585,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["ذَلِكَ وِردُ قَذىً لِسابِقِنا","وَالآنَ يُجلى القَذى لِلاحِقِنا",0,"ن",2,0],["ذَلِّل رِكابَكَ أَينَ سِرتَ كَأَنَّما","وَصّى المَطِيَّ بِكَ الجَديلُ وَداعِرُ",1,"ر",1,0],["ذَليلٌ لِرَيبِ الدَهرِ مَن كانَ حاضِراً","وَحَربٌ لَدى الأَيّامِ مَن يَتَغَرَّبُ",2,"ب",1,0],["ذُلُلٌ رِكابي حَيثُ شِئتُ مُشايِعي","لُبّي وَأَحفِزُهُ بِأَمرٍ مُبرَمِ",3,"م",1,0],["ذَلَّ الأُلى اِحتالوا عَلَيَّ وَأَصبَحو","يَتَشَفَّعونَ بِسَيفِيَ الفَتّاكِ",4,"ك",1,0],["ذَلِكَ مِن أَشباهِ قَتلَةَ أَو","قَتلَةُ مِنهُ سافِراً أَجمَل",5,"ل",1,0],["ذُلُلٌ مَسالِكُهُ فَأَنّى جِئتَهُ","أَلفَيتَ نَفسَكَ في فَسيحِ رِحابِ",6,"ب",1,0],["ذَلولُ الدَماثَةِ صَعبُ الإِباء","ثَقيفُ العَزيمِ إِذا ما اِعتَزَم",7,"م",1,0],["ذلك ما أعطاكه منعم","يعطى متى شاء بلا حصر",8,"ر",1,0],["ذَلِكَ المِعْجَمُ الزِّرَاعِيُّ قَدْ كَانَ","رَجَاءً حَقَّقَتْهُ فِي أَوَانِهْ",9,"ن",2,0],["ذَلِكَ الحُسْنُ سَالَ مِنْ مَنْبَعِ الحُسْ","نِ نَقِيّاً مُنَزَّهاً تَنْزِيهَا",10,"ي",3,0],["ذَلِكَ قَوْلِي أَعدْتُهُ اليَوْمَ","بَعْدَ عَشرٍ مِنَ السِّنِينَا",11,"ن",2,0],["ذَلِكَ الوُدُّ قَديمٌ زَادَهُ","كُلَّ يَوْمٍ سَبَبٌ مِنْكِ مَتِينْ",12,"ن",1,0],["ذَلِكُمْ مَبْعَثُ الفَرِيضِ وَمَجْرَى","أَعْذَبِ القَوْلِ مِنْ فِيُوضِ الجَنَانِ",13,"ن",1,0],["ذَلِكُمْ شَأْنُ مِصْرَ شَرْقاً وَغَرْباً","وَهْوَ مَا لا يَهُونُ إِنْ سَاءَ عُقْبَى",14,"ب",2,0],["ذَلِكَ الرُّزْءُ فِي الصَّدِيقِ الْكَرِيمِ","كَانَ سَهْماً أَصَابَنِي فِي الصَّمِيمِ",15,"م",1,1],["ذَلِكَ الشَّأْنُ وَهْوَ أَرْفَعُ شَأْنٍ","أَثَرَ الجَدِّ وَالمَسَاعِي الجِسَامِ",16,"م",1,0],["ذَلِكَ فَضْلُ اللهِ يُؤْتِيهُ مَنْ","نَاطَ بِهِ إِصْلاحَ شَأْنِ الأَنَامْ",17,"م",1,0],["ذَلِكُمْ أَنَّ فِي سَمَاءِ عُلاكُمْ","كُلَّ شَمسٍ تَخْبُو تَلِيها نُجُومُ",18,"م",1,0],["ذلك الماجد الذي أدرك المج","د بأيدٍ إلى العلاء سوام",19,"م",1,0],["ذَلَّت رِقابُ بَني النَجّارِ كُلِّهِمُ","وَكانَ أَمراً مِنَ اِمرِ اللَهِ قَد قُدِرا",20,"ر",2,0],["ذلَّت لعزَّتها الفرائد في الحلى","عجزاً ولا عجبٌ لذلّ يتامى",21,"م",2,0],["ذِلتَ الصحابة والصحابة لم تزل","بحراً لها متدفق وغمام",22,"م",1,0],["ذَلّوا بِغَيرِ اِقتِدارٍ عِندَما وَلِهوا","إِنَّ الأَعِزّا إِذا اِتاقوا أَذِلاءُ",23,"ا",2,0],["ذلك السيدُ الذي قتل اليأ","سَ بأفضاله وأحيا الرجاءَ",24,"ا",2,0],["ذلك الخائبُ الشقي وإن كا","ن يُرى أنّهُ من السُّعداءِ",25,"ا",2,0],["ذلكَ العُودُ قاسمٌ كَرُمَ العُو","دُ ومَرْسى العُرُوقِ غير الصَّلُودِ",26,"د",1,0],["ذلك أشهى إليك من نغم ال","شدو تناغيه غُنّةُ الوتَر",27,"ر",1,0],["ذلك فضل الإله يمنحُهُ","من شاء لا ذاك حظ من نَفِسَهْ",28,"س",2,0],["ذلك عرس الدهر من أجله","حَنّ غدٌ والتَفَت الأمس",29,"س",1,0],["ذُلّي لزهوك أرضُ","ولي هوىً فيك محْضُ",30,"ض",1,1],["ذلك عرض أبيت لا بل أبى ال","لَه له أن يمسه طَبَع",31,"ع",1,0],["ذلك الشؤمُ يا بني أمّ شيخٍ","يُمكنُ القائلين فيه المقالُ",32,"ل",1,0],["ذلّل الخيل حين شمَّرتْ للحر","بِ فما زادها سوى الأثقالِ",33,"ل",1,0],["ذلَّلت أنفهُ فكيفَ أرادَتْ","صرَفتْهُ كالكودَنِ المخْطوم",34,"م",1,0],["ذلك الصوتُ في المسامِع يحكي","ذلك الغصنَ في العيون الرواني",35,"ن",2,0],["ذلَّ في عزه لملبسه العِزْ","زةَ شكراً لمِنة المنّان",35,"ن",1,0],["ذُلَّ قَلْبي","مَاتَ حُبِّي",36,"ي",1,0],["ذُلٌّ وَفَقرٌ أَزالا عِزّةً وَغِنىً","نُعمى اللَيالي مِنَ البَلوى عَلى كثبِ",37,"ب",1,0],["ذلكم حقها قد انتزعوه","وهي اليوم أو غدا تسترد",38,"د",1,0],["ذلك يا قوم جزاء امرئ","كم غَيَّر الحق وكم بدّله",39,"ل",2,0],["ذَلِكَ الحَقُّ لا الَّذي زَعَموهُ","في قَديمٍ مِنَ الحَديثِ مُعادِ",40,"د",1,0],["ذَلِكَ الداخِلُ لاقى مُظلِمات","لَم يَكُن يَأمُلُ مِنها مَخرَجا",41,"ج",2,0],["ذَلِكَ الناشِئُ في خَيرِ الأُمَم","سادَ في الأَرضِ وَلَم يُخلَق يُساد",41,"د",1,0],["ذَلِكَ المَجدُ وَهَذي سُبلُهُ","بَيِّنٌ فيها سُبلُ المُعتَذِر",42,"ر",1,0],["ذَلِكَ أَمسي ما بِهِ ريبَةٌ","وَيَومِيَ القُبَّةُ ذاتُ العِماد",43,"د",1,0],["ذَلِكَ يَوْمٌ لَمْ تَرْمِ جَائحَةٌ","بِمِثْلِهِ الْمُصْطَفَى ولَمْ تُصِبِ",44,"ب",1,0],["ذَلَّ مَن يَغبِطُ الذَليلَ بِعَيشٍ","رُبَّ عَيشٍ أَخَفُّ مِنهُ الحِمامُ",45,"م",1,0],["ذَليلُ الأَيرِ وَالحاجاتُ تُقضى","وَمَعفورُ التَرائِبِ بِالتُرابِ",46,"ب",1,0],["ذَليلٌ مَن يَعِزُّ بَنو زِيادٍ","وَهُم كانوا أَذَلَّ مِنَ السَواني",47,"ي",1,0],["ذَليلَةِ أَطرافِ العِظامِ رَقيقَةٍ","تَلَقَّمُ أَوصالَ الجَزورِ كَما هِيا",48,"ي",2,0],["ذَلَلْتَ ذِلَّةَ ذي جهلٍ وقد كُثرَتْ","في أخدعَيكَ وفي اليافوخِ ذِلاّتي",49,"ي",1,0],["ذلوا لنا من بعد فرط عزة","وطاوعوا العشاق صاغرينا",50,"ن",2,1],["ذَلَّت بِكُم روحي وَكُنتُ مُمَنَّعاً","في صَفوِ عَيشٍ عِزَّهُ لَم يُفلَذِ",51,"ذ",1,0],["ذُلٌّ عَلاني وَالعُداةُ عَزيزَةٌ","لَو لَم يَكُن جودُ اِبنِ أَرتَقَ مُنقِذي",51,"ي",1,0],["ذَلِقُ الفَضائِلِ هَكَذا فَضلُ التُقى","غَدِقُ البِنانِ عَلى الفَصاحَةِ قَد غُذي",51,"ي",1,0],["ذَلَّلتَ أَعناقَ الطُغاةِ بِصارِمٍ","بِسِوى الجَماجِمِ حَدُّهُ لَم يُشحَذِ",51,"ذ",1,0],["ذَلَّ النَضارُ كَما عَزَّ النَظيرُ لَهُم","بِالفَضلِ وَالبَذلِ في عِلمٍ وَفي كَرَمِ",52,"م",1,0],["ذَلِكَ الرَتبَةُ الَّتي قَصَّرَت دو","نَ عُلاها النِسرانِ وَالفَرقَدانِ",53,"ن",1,0],["ذَلَّت صُروفُ الدَهرِ لَمّا عايَنَت","دونَ الأَنامِ تَعَلُّقي بِحِبالِهِ",54,"ل",2,0],["ذَلّوا بِأَسيافِنا طولَ الزَمانِ فَمُذ","تَحَكَّموا أَظهَروا أَحقادَهُم فينا",55,"ن",2,0],["ذلك الشاعرُ الذي","باتَ في خاطر الظُّلم",56,"م",1,0],["ذلك الشاعرُ الذي","روحه الآن بينكم",56,"م",1,0],["ذلك الغاب رائع الحسن والصم","ت مثال الجلال والكبرياءِ",57,"ا",2,0],["ذلك القول وهو جدّ عجيب","أيها الخالد الآسي كيف قلته",57,"ه",1,0],["ذلك الجرح وما أفدحه","ما عليه لو إلى السلوى عبر",58,"ر",1,0],["ذل السجين وقسوة السجان","فتطلعا نحو السماء وحلقا",59,"ق",2,0],["ذلك الشاعر قد واساكمُ","وبكى آلامكم كل البكاء",60,"ا",2,0],["ذلك الشاعرُ قد غناكمُ","صادحاً في أيككم بشرى الهناء",60,"ا",2,0],["ذُلُّ السُؤالِ شَجىً في الحَلقِ مُعتَرِضُ","مِن دونِهِ شَرَقٌ مِن خَلفِهِ جَرَضُ",61,"ض",1,1],["ذَلَّ الحِمى مُذ أوطِئَت تِلكَ الرُبا","وَالغابُ مُذ أَخلاهُ ذاكَ الضَيغَمُ",62,"م",1,0],["ذَلَّت بِهِم عُنُقُ الخَليطِ وَرُبَّما","كانَ المُمَنَّعَ أَخدَعاً وَصَليفا",63,"ف",2,0],["ذُلُلٌ رَكائِبُهُ إِذا ما اِستَأخَرَت","أَسفارُهُ فَهُمومُهُ أَسفارُ",64,"ر",1,0],["ذَلَّلْتُ مِنْهُ غَوَارِبَاً لا تُمْتَطَى","وَخَطَمْتُ مِنْهُ مَوَارِنَاً لَمْ تُخْطَمِ",65,"م",1,0],["ذلكَ طلسمٌ على مطلبٍ","أو حببٌ دارَ على الخدرِ",66,"ر",1,0],["ذَلَّ للهِ فعزَّتْ نفسُهُ","كلُّ مَنْ عزَّ بغيرِ اللهِ ذَلْ",67,"ل",1,0],["ذَلِكَ الجِدُّ فَذوقي مُرَّهُ","وَخُذيهِ مِن أَكُفِّ اللاعِبينْ",68,"ن",1,0],["ذَلِكَ البَعثُ لِقَومٍ فاتَهُم","مِن حَياةٍ غَضَّةٍ ما أَمَلّوا",69,"ل",3,0],["ذلت يهود فما يرجى لها خطرٌ","على يدي من نهى فيها ومن أمرا",70,"ر",2,0],["ذَلَّتْ يَهودٌ بعد أن لم تكن","تَظُنُّ أن تُغلَبَ أو تُقْهَرَا",71,"ر",2,0],["ذلكم بَيتُكم فَصَلُّوا وطُوفُوا","لا تخافُنَّ مُشرِكاً أو كفورا",72,"ر",2,0],["ذلك العملاق ما أبشعه","في الدُّجى .. يغتال عُصفوراً رقيقا",73,"ق",2,0],["ذُلُّ الهَوى وَعِزَّةُ ال","حُسنِ حَديثٌ عُرِفا",74,"ف",2,0],["ذُلُلٌ مَواهِبُهُ وَلَكِن دَمعُهُ","في الحادِثاتِ أَعَزُّ ما يُستامُ",75,"م",1,0],["ذَلِكَ الفُلكُ الَّذي يحمله","مثلَه مُنذُ جَرى لَم يَحملِ",76,"ل",1,0],["ذَلِكَ السَيف الَّذي جَرَّده","فَضحتهُ عَينُ هَذا الصيقلِ",76,"ل",1,0],["ذَلِكَ المُنشِىءُ الحِجارَةَ","وَالموتى وَأَحيِاهُمُ وَكانَ قَديرا",77,"ر",2,0],["ذُلٌّ عَلى مَلِكٍ يُجَر","رِعُ كَأسَهُ بِقَذاةِ",78,"ه",1,0],["ذُلُّ المَآخيرِ عَمَلَّساتُها","تَسمَعُ في الآثارِ مِن وَحاتِها",79,"ت",3,0],["ذُلِّلَت تِلكَ الفِجاجُ لَهُ","فَهوَ مُختارٌ عَلى بَصَرِه",80,"ر",2,0],["ذَلِكَ يَومٌ يَجِلُّ عَن خَطَري","فَما لِمِثلي هُناكَ مِن أَمَلِ",81,"ل",1,0],["ذلك يومٌ يجلّ عن خطري","فما لمثلي هناكَ من عمَل",82,"ل",1,0],["ذَلِلتُ حَتّى دَنانيرٌ إِلى كَتَدٍ","وَإِنَّما ذاكَ مِن حُبِّ الدَنانيرِ",83,"ر",1,0],["ذَلِكَ خَيرٌ مِن شِوارٍ لَها","وَمِن عَطايا والِدٍ أَجزَلا",84,"ل",