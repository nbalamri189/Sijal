[5725,"ياقلب رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=178058",""],[5736,"من أجل عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=203897",""],[5795,"عفَى الديارَ ديارَ الحُكْم والحَكَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=167916",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[463,"على أيّ لائمة ٍ أربعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60121&r=&rc=177",""],[5555,"راقصة الجاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87419&r=&rc=14",""]],"verses":[["فَلَأَرحَلَنَّ رَحيلَ لا مُتَلَهِّفٍ","لِفِراقِكُم أَبَداً وَلا مُتَلَفِّتِ",0,"ت",1,0],["فَلا رأَت عَلَمَيْ نَجدٍ عُيونُكُما","وَلا رَعى بِالحِمى نِضواكُما أَبَدا",1,"د",2,0],["فَلا رَفَعتُ لِساري اللَيلِ نارَ قِرى","تَكادُ تَرمي جَبينَ النَّجمِ بالشُعَلِ",2,"ل",1,0],["فلا رَعى اللهُ لِئاماً وَهَبوا","نَزْراً وقد شِيبَ بمَنٍّ وأذى",3,"ا",1,0],["فلا رِعْيَ عِندي حتى يُباحَ","بأطْرافِها البَلَدُ المُعْشِبُ",4,"ب",1,0],["فلا راعَ منْها السِّرْبَ للدّهْرِ رائِعٌ","ولا نالَ منْها جِدّةَ السّعْدِ إخْلاقُ",5,"ق",1,0],["فَلاَ رَاعَ تِلْكَ الذَّاتِ لِلضُّرِّ رَائِعٌ","وَلاَ وُسِمَتْ بِالسُّقْمِ غُرَّ خِلاَلِهَا",6,"ه",2,0],["فَلا رَاعَنَا بَيْنَ الأَمِينِ وَكُلُّنَا","يَجِدُّ إِلَيْهِ وَالهُمُومُ رَواحِلُهْ",7,"ل",2,0],["فَلا رَغبَتِي فيهم تَغِيضُ لأهبَةٍ","ولا عُقدَتِي في حُبِّهِم تَتَحَلَّلُ",8,"ل",1,0],["فَلا راذانُ تُدعى فيهِ قَيسٌ","وَلا القاطولُ وَاِقتَنَصوا الوِبارا",9,"ر",2,0],["فَلا رِماحٌ هُناكَ مُشرَعَةٌ","وَلا سُيوفٌ هُناكَ تُمتَشَقُ",10,"ق",1,0],["فَلا رَدَّها رَبّي إِلى مَرجِ راهِطٍ","وَلا أَصبَحَت تَمشي بِسَكّاءَ في وَحلِ",11,"ل",1,0],["فلا رِزقَ إلّا من نوالكَ مُجتَنَى","ولا عُمْرَ إلّا من عطاياكَ محسوبُ",12,"ب",1,0],["فَلا رَفَعَت إِن كُنتُ قُلتُ الَّتي رَوَوا","عَلَيَّ رِدائي حينَ أَلبَسُهُ يَدي",13,"د",2,0],["فَلا رُزءَ إِلّا الدينَ أَعظَمُ مِنهُما","غَداةَ دَعا ناعيهِما ثُمَّ أَسمَعا",14,"ع",2,0],["فلا راكباً في ظُلمَةِ اللَّيلِ سائراً","مطيَّتُه بحرٌ من الخَوفِ زَاخِرُ",15,"ر",1,0],["فَلا رَحِمَ الرَحمَنُ خائِنَةَ النِسا","وَيَحرِقُ كُلَّ الخائِناتِ بِنارِهِ",16,"ر",2,0],["فَلا رَحِمَ الرَحمَنُ مَن فَوقَ تَحتِهِ","وَلا مَن غَدا يَسري أَمامَ وَرائِهِ",17,"ا",3,0],["فَلا رَوضَةٌ إِلّا استَعارَت لِشُكرِهِ","لسانَ صَباً تَسْري مُطَيَّبَةَ النَّشرِ",18,"ر",1,0],["فَلا رَحِمَ اللَّهُ يَوْماً جَرَى","عَلَيَّ بِهِ طَائِرَاً أَشْأَمَا",19,"م",2,0],["فلا رَعى اللهُ يوماً دسَّ بينهما","وَقيعَةً، ورَعى يَوْمَيْهِما ووَقى",20,"ق",2,0],["فلا رأيُه راجحٌ حازمٌ","ولا حُكمُه صالحٌ عادلُ",21,"ل",1,0],["فَلا رَحِمَ اللَهُ إِلّا اِمرَأً","يُجيبُ نِداءَ العُلا إِذ يُنادى",22,"د",2,0],["فلا رَحْبُ القصور غداً بباقٍ","لساكنها ولا ضيق الخصاصِ",23,"ص",1,0],["فَلا رَبُّ المَنِيَّةِ يَأمَنَنها","وَلا الجِنِيُّ أَصبَحَ يُستَتابُ",24,"ب",1,0],["فلا راحَ مَعنِيّاً بِمَدْحِيَ حاتِمٌ","ولا عُنِيَتْ هند بِحبِّي ولا دَعْدُ",25,"د",1,0],["فلا راجِعٌ باللأمِ غيرَ مُبتَّكٍ","ولا بحَبيكِ البَيضِ غيرَ مُهَدَّم",26,"م",1,0],["فلا رأيُه في حالةٍ يَتْبَعُ الهوَى","ولا سَمْعُهُ مُستَوْقِفٌ للنّمائم",27,"م",1,0],["فَلا رَيبَ أَنَّ الَّذي تُحبِيا","نِ أَفضَلُ مِنُ الَّذي تَحبُوانِ",28,"ن",1,0],["فَلا رَحِمَ اللَّهُ امْرَأً بَاعَ دِينَهُ","بِدُنْيَا سِوَاهُ وَهْوَ لِلْحَقِّ رَامِقُ",29,"ق",1,0],["فَلا رَحِمَ اللهُ الْمَشِيبَ وَعَصْرَهُ","وَإِنْ كَانَ فِي أَثْنَائِهِ الْحِلْمُ أَجْمَعُ",30,"ع",1,0],["فَلا رَأْيَ إِلَّا أَنْ تَكُونَ بِنَجْوَةٍ","فَإِنَّكَ مَقْصُودُ الْمَكَانَةِ واضِحُ",31,"ح",1,0],["فَلا رَفِيقٌ تَسُرُّ النَّفْسَ طَلْعَتُهُ","وَلا صَدِيقٌ يَرَى ما بِي فَيَكْتَئِبُ",32,"ب",1,0],["فَلاَ رِقٌّ وَلاَ ظُلمٌ","وَلاَ مَوْلَى وَلاَ عَبْدا",33,"د",2,0],["فلا ريحٌ لها فيه هُبوبٌ","ولا سُحُب لها فيه انهمَار",34,"ر",1,0],["فلا رَحمًا رعَيْت، ولا حقوقًا","مقدَّسَةً بِهَا يَقْضِيَ الجِوَارُ!",34,"ر",1,0],["فلأرجع ، حسنا لا أدري","أرجوعي أم تيهي أغبن ؟",35,"ن",1,0],["فلا راعى الله يوماً دسّ بينهما","وقيعة ورعى يوميهما ووقا",36,"ق",2,0],["فلا رمقتهُ عينُ اللحظِ إلاّ","بلحظ في جوانبهِ ازورارُ",37,"ر",1,0],["فلا رعبَ الا ما بقلب عدوهِ","إِذا لم يجد للسلم هادٍ يدلُّه",38,"ل",2,0],["فلأ ركبن من المطامع خطة","حتى رضاك ببعضها يستحلب",39,"ب",1,0],["فَلأَرحَلَن عَنها رَحيلَ مُفارِقٍ","وَلَأَزجُرَنَّ النَّفسَ عَن لَفَتاتِها",40,"ت",3,0],["فَلا رَعى اللَهُ أَرضاً لا أَكونُ بِها","سُمّاً لِمُستَنكِفٍ غَيثاً لِمُنتَجِعِ",41,"ع",1,0],["فلا رجلين تحملني فأمشي","ولا مال فيحملني بعير",42,"ر",1,0],["فلا رفق ولا عطف","ولا عهد ولا وعد",43,"د",1,0],["فلا روحٌ بلا دينٍ ومن ذا","رأى راحاً تُصَبُّ بلا حبابِ",44,"ب",1,0],["فلا راحةٌ تغشى عداه بدهره","ولا شقوةٌ منه لقاها صديقُ",45,"ق",1,0],["فَلا رَقَتِ الدُموعُ وَقَد تَوَلَّت","رِكابُهُم وَلا بَرُدَ الغَليلُ",46,"ل",1,0],["فَلَأَرفَعَنَّ عَلى شُرَيحٍ قَدرَهُ","وَلَأَبهَجَنَّ بِهِ عَلى سَوّارِ",47,"ر",1,0],["فَلا رَعاها اللَهُ مِن حالَةٍ","ثالِثَةٍ لِلشَيبِ وَالفَقرِ",48,"ر",1,0],["فَلا رَقَأَت غُزرُ الدُموعِ وَقَد نَأَت","وَلا بَرِحَ القَلبَ الغَرابُ المُبَرِّحُ",49,"ح",1,0],["فلا رقَّةٌ للقلبِ من خَصرِها الذي","يذوبُ من الأنفاسِ والزفرات",50,"ت",1,0],["فلا رأينا من الأحداقِ زرقَتها","لا شَهِدنا من الصهبِ العثانينا",51,"ن",2,0],["فَلا رُزْءَ مِنْ هذا أَعَمُّ مُصِيبَةً","وَلا خَطْبَ مِنْ هذا أَمَرُّ وَأَفْدَحُ",52,"ح",1,0],["فَلا رَأسَ إِلّا فيهِ بِالضَربِ صارِمٌ","وَلا صَدرَ إِلّا فيهِ بِالطَعنِ عامِلُ",53,"ل",1,0],["فَلا راحةٌ إن قوبل الذنبُ بالجفا","وَلا سُؤددٌ إن جُوزي الذنبُ بالذنبِ",54,"ب",1,0],["فلا رقدة تغدو علي بفترةٍ","ولا يقظة تغدو علي بغفلة",55,"ه",1,0],["فلا رفع بل لا خفض إلّا لديهم","ولا نصب في أيدي سواهم ولا جزما",56,"م",2,0],["فَلا رَعى اللَه فيكَ قَلبي","فَكَم بِهِ قَد بَلَغت قَصدك",57,"ك",1,0],["فَلا رائِعٌ طَرفي وَلا مالِئٌ يَدي","وَلا شارِحٌ صَدري وَلا مُسنِدٌ ظَهري",58,"ر",2,0],["فَلا رَوَّحَ اللَهُ مِن قُربِكُم","فُؤادي بِخَطرَةِ يَأسٍ مُريحَه",59,"ح",2,0],["فلا ريب أن اللَه يبلوه بغتةً","بتجربةٍ تُبقيه للدهر باكيا",60,"ي",2,0],["فلأرثينَّكمُ بكل قصيدةٍ","ولأندبنَّكم بكل نظام",61,"م",1,0],["فلا رسولٌ ولا نبيٌّ","ولا شهيدٌ على الصواب",62,"ب",1,0],["فلا رفَع المهيمنُ لي مناراً","ولا نِلْتُ المرامَ من العُلوّ",63,"و",1,1],["فلا رَحمَ الله من قد غدا","لأرحامِ خيرِ الوَرى قَاطِعَا",64,"ع",2,0],["فلا رنداً تشمّ ولا تماماً","وأين الرّند منها والثّمام",6