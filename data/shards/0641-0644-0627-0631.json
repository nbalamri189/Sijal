ps://www.aldiwan.net/poem35583.html","الطويل"],[268,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[278,"أحتى إلى العلياء يا خطب تطمح","https://www.aldiwan.net/poem60783.html","الطويل"],[280,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[303,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[311,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[354,"ألمت بنا أهلا وسهلا","https://www.aldiwan.net/poem24532.html","الطويل"],[359,"والله لا استطيع صدك","https://www.aldiwan.net/poem68117.html","مخلع البسيط"],[364,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[364,"وليل بطيء طلوع الصباح","https://www.aldiwan.net/poem17865.html","المتقارب"],[374,"دع راهبا لا يخدم الله ربه","https://www.aldiwan.net/poem59165.html","الطويل"],[374,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[374,"ما أحسن الروض في الروابي","https://www.aldiwan.net/poem66927.html","مخلع البسيط"],[399,"فلا رفع المهيمن لي منارا","https://www.aldiwan.net/poem46949.html","الوافر"],[399,"أغير أبي السبط للمصطفى","https://www.aldiwan.net/poem46961.html","المتقارب"],[413,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[413,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[436,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[451,"ما اسكندر اليازجي اليوم أعرفه","https://www.aldiwan.net/poem61793.html","البسيط"],[456,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[456,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[459,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[459,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[462,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[466,"تحاجبت عني واستترت ولم يكن","https://www.aldiwan.net/poem59781.html","الطويل"],[466,"لم يصف عيسى بن مرقس لأخ","https://www.aldiwan.net/poem59990.html","المنسرح"],[466,"لا فتح الله على فتح","https://www.aldiwan.net/poem60258.html","السريع"],[480,"إذا ما بدا بأي عين أراه","https://www.aldiwan.net/poem24492.html","عموديه"],[527,"ما كنت أعلم أن العلم عندهم","https://www.aldiwan.net/poem37247.html","البسيط"],[527,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[551,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"]],"verses":[["فَلَأَرحَلَنَّ رَحيلَ لا مُتَلَهِّفٍ","لِفِراقِكُم أَبَداً وَلا مُتَلَفِّتِ",0,"ت",1,0],["فَلا رأَت عَلَمَيْ نَجدٍ عُيونُكُما","وَلا رَعى بِالحِمى نِضواكُما أَبَدا",1,"د",2,0],["فَلا رَفَعتُ لِساري اللَيلِ نارَ قِرى","تَكادُ تَرمي جَبينَ النَّجمِ بالشُعَلِ",2,"ل",1,0],["فلا رَعى اللهُ لِئاماً وَهَبوا","نَزْراً وقد شِيبَ بمَنٍّ وأذى",3,"ا",1,0],["فلا رِعْيَ عِندي حتى يُباحَ","بأطْرافِها البَلَدُ المُعْشِبُ",4,"ب",1,0],["فلا راعَ منْها السِّرْبَ للدّهْرِ رائِعٌ","ولا نالَ منْها جِدّةَ السّعْدِ إخْلاقُ",5,"ق",1,0],["فَلاَ رَاعَ تِلْكَ الذَّاتِ لِلضُّرِّ رَائِعٌ","وَلاَ وُسِمَتْ بِالسُّقْمِ غُرَّ خِلاَلِهَا",6,"ه",2,0],["فَلا رَاعَنَا بَيْنَ الأَمِينِ وَكُلُّنَا","يَجِدُّ إِلَيْهِ وَالهُمُومُ رَواحِلُهْ",7,"ل",2,0],["فَلا رَغبَتِي فيهم تَغِيضُ لأهبَةٍ","ولا عُقدَتِي في حُبِّهِم تَتَحَلَّلُ",8,"ل",1,0],["فَلا راذانُ تُدعى فيهِ قَيسٌ","وَلا القاطولُ وَاِقتَنَصوا الوِبارا",9,"ر",2,0],["فَلا رِماحٌ هُناكَ مُشرَعَةٌ","وَلا سُيوفٌ هُناكَ تُمتَشَقُ",10,"ق",1,0],["فَلا رَدَّها رَبّي إِلى مَرجِ راهِطٍ","وَلا أَصبَحَت تَمشي بِسَكّاءَ في وَحلِ",11,"ل",1,0],["فلا رِزقَ إلّا من نوالكَ مُجتَنَى","ولا عُمْرَ إلّا من عطاياكَ محسوبُ",12,"ب",1,0],["فَلا رَفَعَت إِن كُنتُ قُلتُ الَّتي رَوَوا","عَلَيَّ رِدائي حينَ أَلبَسُهُ يَدي",13,"د",2,0],["فَلا رُزءَ إِلّا الدينَ أَعظَمُ مِنهُما","غَداةَ دَعا ناعيهِما ثُمَّ أَسمَعا",14,"ع",2,0],["فلا راكباً في ظُلمَةِ اللَّيلِ سائراً","مطيَّتُه بحرٌ من الخَوفِ زَاخِرُ",15,"ر",1,0],["فَلا رَحِمَ الرَحمَنُ خائِنَةَ النِسا","وَيَحرِقُ كُلَّ الخائِناتِ بِنارِهِ",16,"ر",2,0],["فَلا رَحِمَ الرَحمَنُ مَن فَوقَ تَحتِهِ","وَلا مَن غَدا يَسري أَمامَ وَرائِهِ",17,"ا",3,0],["فَلا رَوضَةٌ إِلّا استَعارَت لِشُكرِهِ","لسانَ صَباً تَسْري مُطَيَّبَةَ النَّشرِ",18,"ر",1,0],["فَلا رَحِمَ اللَّهُ يَوْماً جَرَى","عَلَيَّ بِهِ طَائِرَاً أَشْأَمَا",19,"م",2,0],["فلا رَعى اللهُ يوماً دسَّ بينهما","وَقيعَةً، ورَعى يَوْمَيْهِما ووَقى",20,"ق",2,0],["فلا رأيُه راجحٌ حازمٌ","ولا حُكمُه صالحٌ عادلُ",21,"ل",1,0],["فَلا رَحِمَ اللَهُ إِلّا اِمرَأً","يُجيبُ نِداءَ العُلا إِذ يُنادى",22,"د",2,0],["فلا رَحْبُ القصور غداً بباقٍ","لساكنها ولا ضيق الخصاصِ",23,"ص",1,0],["فَلا رَبُّ المَنِيَّةِ يَأمَنَنها","وَلا الجِنِيُّ أَصبَحَ يُستَتابُ",24,"ب",1,0],["فلا راحَ مَعنِيّاً بِمَدْحِيَ حاتِمٌ","ولا عُنِيَتْ هند بِحبِّي ولا دَعْدُ",25,"د",1,0],["فلا راجِعٌ باللأمِ غيرَ مُبتَّكٍ","ولا بحَبيكِ البَيضِ غيرَ مُهَدَّم",26,"م",1,0],["فلا رأيُه في حالةٍ يَتْبَعُ الهوَى","ولا سَمْعُهُ مُستَوْقِفٌ للنّمائم",27,"م",1,0],["فَلا رَيبَ أَنَّ الَّذي تُحبِيا","نِ أَفضَلُ مِنُ الَّذي تَحبُوانِ",28,"ن",1,0],["فَلا رَحِمَ اللَّهُ امْرَأً بَاعَ دِينَهُ","بِدُنْيَا سِوَاهُ وَهْوَ لِلْحَقِّ رَامِقُ",29,"ق",1,0],["فَلا رَحِمَ اللهُ الْمَشِيبَ وَعَصْرَهُ","وَإِنْ كَانَ فِي أَثْنَائِهِ الْحِلْمُ أَجْمَعُ",30,"ع",1,0],["فَلا رَأْيَ إِلَّا أَنْ تَكُونَ بِنَجْوَةٍ","فَإِنَّكَ مَقْصُودُ الْمَكَانَةِ واضِحُ",31,"ح",1,0],["فَلا رَفِيقٌ تَسُرُّ النَّفْسَ طَلْعَتُهُ","وَلا صَدِيقٌ يَرَى ما بِي فَيَكْتَئِبُ",32,"ب",1,0],["فَلاَ رِقٌّ وَلاَ ظُلمٌ","وَلاَ مَوْلَى وَلاَ عَبْدا",33,"د",2,0],["فلا ريحٌ لها فيه هُبوبٌ","ولا سُحُب لها فيه انهمَار",34,"ر",1,0],["فلا رَحمًا رعَيْت، ولا حقوقًا","مقدَّسَةً بِهَا يَقْضِيَ الجِوَارُ!",34,"ر",1,0],["فلا راعى الله يوماً دسّ بينهما","وقيعة ورعى يوميهما ووقا",35,"ق",2,0],["فلا رمقتهُ عينُ اللحظِ إلاّ","بلحظ في جوانبهِ ازورارُ",36,"ر",1,0],["فلا رعبَ الا ما بقلب عدوهِ","إِذا لم يجد للسلم هادٍ يدلُّه",37,"ل",2,0],["فلأ ركبن من المطامع خطة","حتى رضاك ببعضها يستحلب",38,"ب",1,0],["فَلأَرحَلَن عَنها رَحيلَ مُفارِقٍ","وَلَأَزجُرَنَّ النَّفسَ عَن لَفَتاتِها",39,"ت",3,0],["فَلا رَعى اللَهُ أَرضاً لا أَكونُ بِها","سُمّاً لِمُستَنكِفٍ غَيثاً لِمُنتَجِعِ",40,"ع",1,0],["فلا رجلين تحملني فأمشي","ولا مال فيحملني بعير",41,"ر",1,0],["فلا رفق ولا عطف","ولا عهد ولا وعد",42,"د",1,0],["فلا روحٌ بلا دينٍ ومن ذا","رأى راحاً تُصَبُّ بلا حبابِ",43,"ب",1,0],["فلا راحةٌ تغشى عداه بدهره","ولا شقوةٌ منه لقاها صديقُ",44,"ق",1,0],["فَلا رَقَتِ الدُموعُ وَقَد تَوَلَّت","رِكابُهُم وَلا بَرُدَ الغَليلُ",45,"ل",1,0],["فَلَأَرفَعَنَّ عَلى شُرَيحٍ قَدرَهُ","وَلَأَبهَجَنَّ بِهِ عَلى سَوّارِ",46,"ر",1,0],["فَلا رَعاها اللَهُ مِن حالَةٍ","ثالِثَةٍ لِلشَيبِ وَالفَقرِ",47,"ر",1,0],["فَلا رَقَأَت غُزرُ الدُموعِ وَقَد نَأَت","وَلا بَرِحَ القَلبَ الغَرابُ المُبَرِّحُ",48,"ح",1,0],["فلا رقَّةٌ للقلبِ من خَصرِها الذي","يذوبُ من الأنفاسِ والزفرات",49,"ت",1,0],["فلا رأينا من الأحداقِ زرقَتها","لا شَهِدنا من الصهبِ العثانينا",50,"ن",2,0],["فَلا رُزْءَ مِنْ هذا أَعَمُّ مُصِيبَةً","وَلا خَطْبَ مِنْ هذا أَمَرُّ وَأَفْدَحُ",51,"ح",1,0],["فَلا رَأسَ إِلّا فيهِ بِالضَربِ صارِمٌ","وَلا صَدرَ إِلّا فيهِ بِالطَعنِ عامِلُ",52,"ل",1,0],["فَلا راحةٌ إن قوبل الذنبُ بالجفا","وَلا سُؤددٌ إن جُوزي الذنبُ بالذنبِ",53,"ب",1,0],["فلا رقدة تغدو علي بفترةٍ","ولا يقظة تغدو علي بغفلة",54,"ه",1,0],["فلا رفع بل لا خفض إلّا لديهم","ولا نصب في أيدي سواهم ولا جزما",55,"م",2,0],["فَلا رَعى اللَه فيكَ قَلبي","فَكَم بِهِ قَد بَلَغت قَصدك",56,"ك",1,0],["فَلا رائِعٌ طَرفي وَلا مالِئٌ يَدي","وَلا شارِحٌ صَدري وَلا مُسنِدٌ ظَهري",57,"ي",1,0],["فَلا رَوَّحَ اللَهُ مِن قُربِكُم","فُؤادي بِخَطرَةِ يَأسٍ مُريحَه",58,"ح",2,0],["فلا ريب أن اللَه يبلوه بغتةً","بتجربةٍ تُبقيه للدهر باكيا",59,"ي",2,0],["فلأرثينَّكمُ بكل قصيدةٍ","ولأندبنَّكم بكل نظام",60,"م",1,0],["فلا رسولٌ ولا نبيٌّ","ولا شهيدٌ على الصواب",61,"ب",1,0],["فلا رفَع المهيمنُ لي مناراً","ولا نِلْتُ المرامَ من العُلوّ",62,"و",1,1],["فلا رَحمَ الله من قد غدا","لأرحامِ خيرِ الوَرى قَاطِعَا",63,"ع",2,0],["فلا رنداً تشمّ ولا تماماً","وأين الرّند منها والثّمام",64,"م",1,0],["فلا راعت الأَيَّام قوماً ولا خَلَتْ","ديارٌ بها من آلِ بيتك عامر",65,"ر",1,0],["فلا رَجَعَتْ عَنكَ الأَمانِي حَسِيرَةً","ولا فُزِّعَتْ مِنَّا لَدَيْكَ التَّمائِمُ",66,"م",1,0],["فلا راعها خَطْبٌ وسيفُكَ أُنْسُهَا","ولا رامها ضيمٌ وأَنتَ مُجيرُهَا",67,"ر",3,0],["فلا رسائل تُحييني ينمقها","ولا مجالس تشدوني وأشدوها",68,"و",3,0],["فلا ربعةٌ زادُها مشبِعٌ","يغذِّي ولا نهلةٌ تنقعُ",69,"ع",1,0],["فلأركبنَّ إلى السلامة غاربَىْ","عَوْد إذا وخَدَ المهارى أوقصا",70,"ص",2,0],["فلا راحةٌ الا افْتراعُ مُنيفةٍ","واِنْ ضُمِّن الأخطار منها خطيرها",71,"ر",3,0],["فلا راكِضٌ إِلا ويَتْلوهُ طائرٌ","ولا طاعِنٌ إِلاَّ ويتْلوهُ ناسِرُ",72,"ر",1,0],["فلا رقّ بعدي نسيمُ الصّبا","ولا خاض طيفُ خيالٍ هزيعاً",73,"ع",2,0],["فَلا رَحَلَت مِنّي إِلى المَجدِ هِمَّةٌ","مَتى أَنا يَوماً ما دَخَلتُ إِلَيكا",74,"ك",2,0],["فَلا رَعا اللَهُ مَن يَكونُ كَذا","أَخلاقَهُ تَمرَةٌ وَزَنبورُ",75,"ر",1,0],["فَلا رَعاهُ اللَهُ مِن ساقِطٍ","لا يَعرِفُ الهَجوَ مِنَ المَدحِ",76,"ح",1,0],["فلا راحة في الحب ترجى وإنما","تقطع أوصال الذي يتمناه",77,"ا",2,0],["فلا رَعَى اللهُ عَصْراً سادَ مِثْلُكُمُ","في مِثْلِهِ فجَهِلْتُمْ حَقَّ فاضِلِهِ",78,"ه",1,0],["فَلا رَفَعَتْ يَداكَ إليكَ سَوْطاً","ولا نَقَلَتْكَ مُسْرِعَةُ الخُطاءِ",79,"ا",2,0],["فَلا رُبَّ حَربٍ لِلمُدامِ أَثَرتُها","وَقَصطَلُها جادِيُّها وَالقَرَنفُلُ",80,"ل",1,0]]}