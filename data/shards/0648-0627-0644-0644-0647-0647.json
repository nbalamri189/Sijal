{"poems":[[409,"يا قوم فرض الهجرتين بحاله","https://www.aldiwan.net/poem33398.html","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82827","الكامل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[5122,"(( الشعر ))","https://www.poetsgate.com/ViewPoem.aspx?id=23975",""],[5956,"صبرُ إيهاب دريع","https://www.poetsgate.com/ViewPoem.aspx?id=193102",""]],"verses":[["واللّه هذا شطر دين اللّه والتح","كيم للمختار شطر ثاني",0,"ن",2,0],["وَاللهِ هَذِي رِيبَةٌ لاَ يَختَفِي","مَضمُونُهَا إلاَّ عَلَى الثِّيرَانِ",1,"ن",1,0],["والله هذا شطر دين الله","والتحيكم للمختار شطر ثان",1,"ن",1,0],["وَاللَهُ هذا لا يَليق","لا سِيَّما من مثلنا",2,"ن",2,0],["والله هذبه طفلا وأدبه","فلم يحل هدبه الزاكي ولم يرم",3,"م",1,0],["والله هو اللي كون الكون تكوين","والارواح زرع(ن)..للمنايا محصوده",4,"د",2,0],["والله هذا الصبر لا يأتي سوى","من صاحبِ التقوى وحُسْنِ التربيةْ",5,"ي",2,1]]}