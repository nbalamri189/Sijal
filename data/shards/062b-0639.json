{"poems":[[77,"جعسوس ثعلب مكر","https://www.aldiwan.net/poem36084.html","المجتث"],[77,"ثعبان نهر راعنا قده","https://www.aldiwan.net/poem36414.html","السريع"],[51,"يا ليت شعري حين فارقتكم","https://www.aldiwan.net/poem66085.html","السريع"],[14,"ما بي من عار إخال علمته","https://www.aldiwan.net/poem38309.html","الطويل"],[45,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[46,"لا تصحبن يد الليالي فاجرا","https://www.aldiwan.net/poem22573.html","الكامل"],[46,"ثعالة حاذر من أمير وسوقة","https://www.aldiwan.net/poem23502.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[14,"مابي من عار إخال علمته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17399&r=&rc=10",""],[212,"بروق وأمطار فيا هول ما أرى","https://www.aldiwan.net/poem46624.html","الطويل"],[212,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[283,"هذا الحمى ورنده وبانه","https://www.aldiwan.net/poem32404.html","الرجز"],[283,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[369,"هل بالديار أن تجيب صمم","https://www.aldiwan.net/poem1879.html","السريع"],[459,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"]],"verses":[["ثَعَالِبِيُّ انْتِمَاءٍ","مُخَلِّفٌ لِيَتِيمَهْ",0,"م",2,0],["ثُعْبانُ نهْرٍ راعَنا قَدُّهُ","لمّا أتى ينْسابُ منْ جُحْرِهِ",1,"ه",1,1],["ثعالبٌ أطمعها حَتْفُها","في قَسْورٍ لَحْظَتُه تُصْمي",2,"م",2,0],["ثَعالِبُ في الحَربِ العَوانِ فَإِن تَبُخ","وَتَنفَرِجِ الجُلّى فَإِنَّهُمُ الأُسدُ",3,"د",1,0],["ثَعَلَت بَغدادُ شَوقي عَن قُراً","عِندَ مَيشاءَ وَعُرضٍ وَأَرَك",4,"ك",1,0],["ثُعبانُ بَحْرٍ عَضُّهُ بِنَواجذٍ","خُلِعَتْ عَلَيهِ مِنَ الحديدِ حِدادِ",5,"د",1,0],["ثُعَلُ بنُ عَمرٍو ما حَماهُ شامِخٌ","صَعبٌ وَلا ثُعَلَ الوُحوشُ وِجارُ",6,"ر",1,0],["ثُعالَةُ حاذِر مِن أَميرٍ وَسَوقَةٍ","فَمِن لَفظِ صَيدٍ لَفظُ الصَيادِنِ",7,"ن",1,1],["ثَعْلَبٌ يَضْغُو وَفهْدٌ ضَاغِبٌ","وَغُرَابٌ نَاغِبٌ عَشْراً فَعَشْرَا",8,"ر",2,0],["ثعالب في الحرب العوان فإن تنج","وتَنفرِجِ الجُلّى ، فإنّهمُ الأُسْدُ",9,"د",1,0],["ثعابين أرآها فماذا تريدهُ","وأشبال اساد فررن من المهد",10,"د",1,0],["ثعالب في سياسيتهم موات","وموت الثعلبان له ضروب",11,"ب",1,0],["ثَعلَبُ عسّالِكَ في يَومِ الوَغى","يولِغُهُ دَمَ العِدا سِنانُهُ",12,"ن",2,0],["ثَعالِبُ أَطرافِ الرِماحِ بَلَغنَ في","أَضى الزَّرَدِ الضافي عَلى الأُسد مَلبوسا",13,"س",2,0],["ثَعْلَبُ ضَرّابُ القَوانِسِ بالس","يْفِ وهادِي القَوم إِذْ أَظْلَمْ",14,"م",1,0],["ثعالبٌ تتعاوى ساقَها وَعِلٌ","لضيغمٍ لم تزعزعه زعازعُهُ",15,"ع",2,0]]}