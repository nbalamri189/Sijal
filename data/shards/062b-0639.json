{"poems":[[79,"جعسوس ثعلب مكر","https://www.aldiwan.net/poem36084.html","المجتث"],[79,"ثعبان نهر راعنا قده","https://www.aldiwan.net/poem36414.html","السريع"],[53,"يا ليت شعري حين فارقتكم","https://www.aldiwan.net/poem66085.html","السريع"],[14,"ما بي من عار إخال علمته","https://www.aldiwan.net/poem38309.html","الطويل"],[47,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[82,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[48,"لا تصحبن يد الليالي فاجرا","https://www.aldiwan.net/poem22573.html","الكامل"],[48,"ثعالة حاذر من أمير وسوقة","https://www.aldiwan.net/poem23502.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[14,"مابي من عار إخال علمته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17399&r=&rc=10",""],[215,"بروق وأمطار فيا هول ما أرى","https://www.aldiwan.net/poem46624.html","الطويل"],[215,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[287,"هذا الحمى ورنده وبانه","https://www.aldiwan.net/poem32404.html","الرجز"],[287,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[373,"هل بالديار أن تجيب صمم","https://www.aldiwan.net/poem1879.html","السريع"],[463,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39032","الكامل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101213","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70978","البسيط"],[373,"","https://poetry.dctabudhabi.ae/diwan/poem/20841","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100963","الطويل"],[1982,"","https://poetry.dctabudhabi.ae/diwan/poem/206294","الكامل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53220","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53076","الرمل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112602","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132727","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132574","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89109","المتدارك"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117890","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114117","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135073","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4847,"قل هو الحب وطن","https://www.poetsgate.com/ViewPoem.aspx?id=175537",""]],"verses":[["ثَعَالِبِيُّ انْتِمَاءٍ","مُخَلِّفٌ لِيَتِيمَهْ",0,"م",2,0],["ثُعْبانُ نهْرٍ راعَنا قَدُّهُ","لمّا أتى ينْسابُ منْ جُحْرِهِ",1,"ه",1,1],["ثعالبٌ أطمعها حَتْفُها","في قَسْورٍ لَحْظَتُه تُصْمي",2,"م",2,0],["ثَعالِبُ في الحَربِ العَوانِ فَإِن تَبُخ","وَتَنفَرِجِ الجُلّى فَإِنَّهُمُ الأُسدُ",3,"د",1,0],["ثَعَلَت بَغدادُ شَوقي عَن قُراً","عِندَ مَيشاءَ وَعُرضٍ وَأَرَك",4,"ك",1,0],["ثُعبانُ بَحْرٍ عَضُّهُ بِنَواجذٍ","خُلِعَتْ عَلَيهِ مِنَ الحديدِ حِدادِ",5,"د",1,0],["ثُعَلُ بنُ عَمرٍو ما حَماهُ شامِخٌ","صَعبٌ وَلا ثُعَلَ الوُحوشُ وِجارُ",6,"ر",1,0],["ثُعالَةُ حاذِر مِن أَميرٍ وَسَوقَةٍ","فَمِن لَفظِ صَيدٍ لَفظُ الصَيادِنِ",7,"ن",1,1],["ثَعْلَبٌ يَضْغُو وَفهْدٌ ضَاغِبٌ","وَغُرَابٌ نَاغِبٌ عَشْراً فَعَشْرَا",8,"ر",2,0],["ثعالب في الحرب العوان فإن تنج","وتَنفرِجِ الجُلّى ، فإنّهمُ الأُسْدُ",9,"د",1,0],["ثعابين أرآها فماذا تريدهُ","وأشبال اساد فررن من المهد",10,"د",1,0],["ثعالب في سياسيتهم موات","وموت الثعلبان له ضروب",11,"ب",1,0],["ثَعلَبُ عسّالِكَ في يَومِ الوَغى","يولِغُهُ دَمَ العِدا سِنانُهُ",12,"ن",2,0],["ثَعالِبُ أَطرافِ الرِماحِ بَلَغنَ في","أَضى الزَّرَدِ الضافي عَلى الأُسد مَلبوسا",13,"س",2,0],["ثَعْلَبُ ضَرّابُ القَوانِسِ بالس","يْفِ وهادِي القَوم إِذْ أَظْلَمْ",14,"م",1,0],["ثعالبٌ تتعاوى ساقَها وَعِلٌ","لضيغمٍ لم تزعزعه زعازعُهُ",15,"ع",2,0],["ثُعَليَّةُ الألحاظِ أصْمَتْ مُهْجَتي","بِظُبا سِهامٍ لا عَدِمْتُ نُدوبَها",16,"ب",3,0],["ثعلي اللحاظ أبهر عيني","فبعيني لحظه الثعليا",17,"ي",2,0],["ثعالبُ الغدرِ لولا عادةٌ لهمُ","إنْ قاتلوا قُتلوا من حيث ما ثابوا",18,"ب",3,0],["ثَعْلَبُ ضَرّابُ القَوانِسِ بالس","سَيْفِ وهادِي القَوم إِذْ أَظْلَمْ",19,"م",1,0],["ثعلي الجفن لا من ثعل","راش بالأهدابِ سهمَ المُقلِ",20,"ل",1,0],["ثُعليَّةٌ لكن لها من حاجبٍ","قوسٌ غدا أهلُ الهوى أهدافَها",21,"ف",3,0],["ثعالب لاقت خِلسةً فتزاءرت","فيا عجباً من زائر وهو ثعلب",22,"ب",1,0],["ثعل مخاتله تخبر أنه","في الناس من نطف الجميع مشبك",23,"ك",1,0],["ثعلب تذكرنا راحته","كف قابيل أخي الراي الغبين",24,"ن",1,0],["ثعلب ليلٍ ونهاراً جيفه","تخفق رايات حشاه خيفه",25,"ه",1,0],["ثعالبها في قلوب الأسود تبحث","عن كل حقد وضغن",26,"ن",1,0],["ثعلب في صلّ رمح ما له","عَسَلاَنٌ في سوى نحر وهاد",27,"د",1,0],["ثعالب وذئاب في حقيقتهم","وفي تنكرهم شاء وحملان",28,"ن",1,0],["ثعالب قد عاثت بغابة ضيغهم","وهل يتقى كيد الثعالب ضيغم",29,"م",1,0],["ثعلي الجفون كم من قتيل","قد رماه بنبلهن فاقصد",30,"د",1,0],["ثعباناً يلقف ما صنعوا","من تخييل أو تصوير",31,"ر",1,0],["ثعاب كل ذي كرم إذا ما","إليه نسبته ونداه غيث",32,"ث",1,0],["ثُعَالِبُ مِنهُمُ لِثَورٍ تَتَابَعَت","بِزِيِّ رِجَالٍ فانثَنَت وَهِيَ الخُنثَى",33,"ث",2,0],["ثعبان شكل وسنا","وعقرب بلا يد",34,"د",1,0],["ثُعَليَّةُ الألحاظِ لما إن رَنتْ","أَصْمَتْ فؤاداً لم يُطِقْ إصماءها",35,"ا",3,0],["ثَعَالِبُ النَّارِ لا زَالُوا بِأَقبِيَتِي","أَسرَى وقَلبِي بِوحيِ الحُبِّ مَبهُورُ",36,"ر",1,0]]}