w.poetsgate.com/ViewPoem.aspx?id=187957",""],[2598,"عاهَدَتْ زَوْجَهَا وَقَدْ قَالَ إنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=20767",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5732,"حل الفرقا","https://www.poetsgate.com/ViewPoem.aspx?id=177903",""],[5748,"وأدهم لولا سنا غرّة","https://www.poetsgate.com/ViewPoem.aspx?id=26151",""],[5790,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.poetsgate.com/ViewPoem.aspx?id=111995",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"انكسار","https://www.poetsgate.com/ViewPoem.aspx?id=215552",""],[5970,"الليل جن فأسرعا","https://www.poetsgate.com/ViewPoem.aspx?id=130586",""],[5997,"ريمٌ شرودٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215170",""],[6046,"فراغ في الصورة","https://www.poetsgate.com/ViewPoem.aspx?id=35242",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""],[6152,"أراقب جوها","https://www.poetsgate.com/ViewPoem.aspx?id=213145",""],[5001,"الرسم بالحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80718&r=&rc=8",""]],"verses":[["تُلهِبُ نَضّاً زَعزَعاً","أَو قَرَباً عَمَرَّدا",0,"د",2,0],["تَلهو لِداتُكَ بِالصِبا","لَهواً وَأَنتَ بِمَعزِلِ",1,"ل",1,0],["تَلهو وَتَعبَثُ بِالرِيا","حِ عَلى المَفاوِزِ وَالبِحارِ",2,"ر",1,0],["تَلهو فَتَختَضِعُ المَطِيُّ أَمامَها","وَتَخِبُّ هَروَلَةَ الظَليمِ النافِرِ",3,"ر",1,1],["تلهج بالشتم لهم لاذعاً","وتُكثِر الضحك بهم ساخره",4,"ر",2,0],["تلهمه حياته","ان الحياة تلهم",5,"م",1,0],["تلهّبَ فيه البرقُ حتى كأنَّه","حريقٌ على أثباجِ ليلٍ تلهَّبا",6,"ب",2,0],["تَلهو وَلِلمَوتِ مُمسانا وَمُصبِحُنا","مَن لَم يُصَبِّحهُ وَجهُ المَوتِ مَسّاهُ",7,"ا",2,0],["تَلهو بِعاجِلِ حُسنِها وَتَعُدُّها","عِلقاً لِأَعجازِ الزَمانِ نَفيسا",8,"س",2,0],["تَلَهَّبَ البَأسُ إِذ خَفَّت عَقائِلُها","بَينَ الأَساوِرِ مِنها وَالخَلاخيلِ",9,"ل",1,0],["تلهَّبَ واسْتطارَ فيا لنفسٍ","طَغَتْ حِيناً فأدركها الخمودُ",10,"د",1,0],["تَلهو بِذَوبِ اللُجَينِ مُطَّرِداً","فيهِ وَذَوبُ النُضارِ في الكَأسِ",11,"س",1,0],["تُلهِيكَ صَلْصَلَةُ العوالي كلما","ألهت أولئك قينة وشمول",12,"ل",1,0],["تُلهيكَ أَطيارُها عَن كُلِّ مُلهِيَةٍ","إِذا تَرَنَّمَ في تَرجيعِ تَصويتِ",13,"ت",1,0],["تَلَهَّبُ فِيهِ النَّارُ وَالْمَاءُ سَافِحٌ","فَلا الْمَاءُ يُطْفِيهَا وَلا النَّارُ تَضْعُفُ",14,"ف",1,0],["تلهَّفُ أمُّ المُسْبحينَ عَلَى","جَيْشِ ابنِ حربٍ بالحَرّةِ الفَشِلِ",15,"ل",1,1],["تلهم المليون لا يشبعها","ومتى تطعم أخاه تأكل",16,"ل",1,0],["تلهو بتصويرك الآمال مغتبطا","وبين جنبيك ما يلهي عن الأمل",17,"ل",1,0],["تلهو بها وإذا ما شئتَ تَطْرَحُها","موقوفةً بين تَبعيدٍ وتقريب",18,"ب",1,0],["تلهو بحَوْذان العراق ركائبى","وعزائمى ترعَى رياضَ الشامِ",19,"م",1,0],["تلهو وقوس الموت تخ","ترم النفوس بنبلها",20,"ل",3,0],["تُلْهِي المُحدِّثَ عن أَوْلَى الحديثِ به","كأنها لعقولِ الناس أَمْراس",21,"س",1,0],["تلهَّبَتِ الأرضُ مِنْ عَدْوِهِ","فأورى بزند الصّفا الصلدِ نارا",22,"ر",2,0],["تلهو ولا من شغلٍ","وكلُّنا ذو شُغُلِ",23,"ل",1,0],["تلهو بهِ غطبلةٌ خاذلٌ","وقد بكتْ عطبولةٌ خاذلُ",24,"ل",1,0],["تلهوا السماك به في كل آونة","لهو الثعابين في أجواف صحراء",25,"ا",2,0],["تلهو وتلعب لا تدري مدى شغفي","برائع وجهه راح وريحان",26,"ن",1,0],["تَلهوالعيون بمذهب وَمفضض","من حسنها وَمنظم وَمنضد",27,"د",1,0],["تُلهِيكَ عَنْ زُخرفِ الدُّنيا زَخارِفُها","وَعَن أَغانِي الغَوانِي وُرقها الهُتُفُ",28,"ف",1,0],["تُلْهِيهِ عَنْ عَدْنٍ وَعن أنْهارِها","بَعْدَ الأَشُدِّ خَمائلٌ وجداوِلُ",29,"ل",1,0],["تَلهو عَلى غُصونِها وَمُهجَتي","تَصبو إِلى تلك القُدودِ المُلدِ",30,"د",1,0],["تلهى عن الأخرى ولا تبقى ولا","تصفوا بحال فاجتنبها أودع",31,"ع",1,0],["تُلْهِي بِجَوْهرِهَا وَجَوْهَرِ لفْظهِ","ثَغْرَ المَلِيحَةِ عَن حَبَابِ الكاسِ",32,"س",1,0],["تُلَهوِجُ نَارُها لحمِي طَعاماً","وَتَشْرَبُ مِن دَمي صِرْفَ المُدامِ",33,"م",1,0],["تَلهُو وتَلعبُ والأشواقُ لاعِيةٌ","بنا إِليكَ وتُزهَى حينَ تَلقانا",34,"ن",2,0],["تَلهو بِتَعذيبي وَتَلتذ بِهِ","مالك مِنهُ أَبَداً مِن بَد",35,"د",1,0],["تُلَهّي المَرءَ بِالحُدثانِ لَهواً","وَتَحدِجُهُ كَما حُدِجَ المُطيقُ",36,"ق",1,0],["تلهّبتِ الصَّهباء في وَجَناته","بظلماء ألفَينا لهيبَ ضرام",37,"م",1,0],["تَلَهُّفَ قلبٍ لَيْسَ يشفي غليلَهُ","سوابِقُ دمعٍ لاعِجُ الحزنِ يحدوهُ",38,"و",2,0],["تلهو ببعض خزعبلا","ت والتسر منك ظاهر",39,"ر",1,0],["تَلهَّفُ نفسي أن أحوز أقلها","فأزجرها وهو المبيحُ تلهفي",40,"ف",2,0],["تُلهى الحليمَ فتستقلُّ وقارَه","وتجرُّ حبلَ عُرامه البطَّالا",41,"ل",2,0],["تُلهِبُ نارُ الغيظ في ضلوعه","جمراً يقول حرُّها لا بَرَدا",42,"د",2,0],["تُلهيكَ مِنهُم نَغمَةُ القَماري","عَن نَغَماتِ النايِ وَالأَوتارِ",43,"ر",1,0],["تلهو وقد جدَّ بي ما قد علمتَ بهِ","اِنَّ الأحبَّةَ اعوانٌ على الضَّرَرِ",44,"ر",1,0],["تُلهي النَّدمانَ إذا ما فاه","به الركبانُ عنِ السُّكُرِ",45,"ر",1,0],["تلهيت بالخضرا عن الموت صابرا","تفكر في مسجونها هكذا الصبر",46,"ر",1,0],["تُلهي العُيونَ رُقومُهُ فَكَأَنَّها","قَد أُلبِسَت ساحاتُها ديباجا",47,"ج",2,1],["تلَّهب مَاءُ الخدِّ أَو سَالَ جَمْرَةً","فيا ماءُ ما أَذْكَى ويَا جَمْرُ مَا أَنْدَى",48,"د",2,0],["تَلهُو بِزَهرَتِها وَكَم مِن شائِدٍ","قَصراً وَظِلُّ أَراكِهِ تَكفيهِ",49,"ي",2,0],["تَلْهُو وأَحْزَنُ مثل ما حَكَمَ الهَوَى","لا يَسْتَوِي المسرورُ والمَحْزُوْنُ",50,"ن",1,0],["تلهيك عن ذكرى حبيب","في هوى ابن ابي دؤاد",51,"د",1,0],["تلهيه عن صفحاتِ الغيد صفحته","وعن قُدود الغواني مَتنٌ خطأر",52,"ر",1,0],["تلهبت وجنتها محْمَرّةً","وقام منها في حشا الصب ضرامْ",53,"م",1,0],["تلهيك عن قطع الجنا","ن إذا نظرت جنانُهُ",54,"ن",2,0],["تلهى العقول الرصينات البناء بها","عن الشموس التي يغرين في الكلل",55,"ل",1,0],["تلهب حتى صار جمراً بوجنتي","وذاب إِلى أن صار كحلا بمقلتي",56,"ي",1,0],["تلهو بجنات خلد أزلفت كرما","للمحسنين الألى لاذوا بربهم",57,"م",1,0],["تلهي وَذا الخلق لاهون","عَن وصفها أَي وصف",58,"ف",1,0],["تلهَّم نصفَ كرٍّ من طعام","وكوماءَ العريكة أو شُنونا",59,"ن",2,0],["تلهيه عن أهليه منصرفاً إلى ال","أوهام في حزبيّةٍ صافاها",60,"ا",3,0],["تلهب الحمّى ضلوعي والأسى","كامن والداء يشوي الصّدر شيّا",61,"ي",2,0],["تلهيكَ في الخلوةِ أبياتُها","وَرُبَّما هَزَّتْكَ في الحَقْل",62,"ل",1,0],["تلهو ومغناك فيها","خاوٍ من الأنس خالي",63,"ل",2,0],["تلهب من فؤادي كل وادٍ","واعشب من دموعي كل مغنا",64,"ن",2,0],["تلهو هنا بسامة وهنا","نشوى فلا تلوى على أحد",65,"د",1,0],["تلهُّفي حيث لا أحظى بجنَّتها","عن التألم وهو المؤلم الحاضرُ",66,"ر",1,0],["تُلهي مُسامِرَها تُذكي مَجامِرَها","تَغدو غَدائِرها بِالمِسك وَالبانِ",67,"ن",1,0],["تَلهو بدُرّاجها عن صَوت صَنّاجِها","أَو طيبِ بَهراجِها أَو نَوح وِرشانِ",67,"ن",1,0],["تلهب الجمر في رضراض وجنتها","وثغرها طافح بالبارد الشبم",68,"م",1,0],["تلهو وتلعب بالنهى أشعاره","فكأنها قد ناولتنا قرقفا",69,"ف",2,0],["تَلهى تلقونه تَلظى تربصو","ن رد وَلا تَعارفوا تميز تكملا",70,"ل",2,0],["تلهو وتلعبُ بالزهو","ر وبالنفوس وبالضرام",71,"م",1,0],["تُلهي العيونَ وصارتْ","تُزَوِّلُ الأمراضا",72,"ض",2,0],["تلهو السِّنون بها في أمرهنَّ كما","يلهو بقلب الفتى في يومه الأملُ",73,"ل",1,0],["تلهم الريحَ عن ظمأ بدل الماء","لتُروَى والقلب يزداد جمرا",74,"ر",2,0],["تلهو وتمرح لا تح","س بحبسها بين الصخور",75,"ر",1,0],["تلهمينَ الرعاة شعراً فيأتي","مُحكَمَ الوزن خالي التعقيد",76,"د",1,0],["تلهيهِ فتنةُ ذا عن العمر الذي","قد بات في كلل البعاد يغيب",77,"ب",1,0],["تَلهب وَجد لا تَقُلُّ أَقله","جِبال وَإِن كانَت تَجل وَتَعظم",78,"م",1,0],["تلهيتَ عني ذاهل الفكر حائراً","وهل يذهل الظمآن عن طلب القطر",79,"ر",1,0],["تُلهيك رِيقتُه عن طيب خمرته","سقيا لذاك جنى من ريقِ خَمَّارِ",80,"ر",1,0],["تلهو السيوف بهم ملهى أغيلمة","في ملعب شرق باللهو أنسيّ",81,"ي",1,0],["تَلْهُو وَتَلعَب بالعُقُو","ل عيونُ أبناء الخَفَرْ",82,"ر",1,0],["تَلهَثُ عَيّاً وَتَسيلُ عَرَقاً","هالِعَةً مِن هَولِ ذاكَ المُلتَقى",83,"ق",2,0],["تلهو بأَلبابِ الرِّجالِ جُفونُها ال","مَرضى وَتَلعبُ بالنُّهى أَطرابُها",84,"ب",3,0],["تلهب الأحشاء وجداً كلما","مر بالطيف خيال منه أوعن",85,"ن",1,0],["تلهف الفؤاد يوم ظعنهم","والقلب فيهم اشتكى تلهفا",86,"ف",2,0],["تلهف السبط على مهجته","وما على سواه قد تلهفا",86,"ف",2,0],["تلهو النّفوس السّوء في هلَكاتها","حبّ الحياة وحبّها لَغرور",87,"ر",1,0],["تلهى عن فقيرٍ جاء يسعى","إليه وهو يخشى أن يردا",88,"د",2,0],["تلهبت في يديه لكن","بوجنتيه السنا توقد",89,"د",1,0],["تلهو به الأرزاءُ في ريْعَانِها","ويَسُوطُهُ الإِجرامُ سوطَ عَذابِ",90,"ب",1,0],["تَلْهُوْ وَتَعْبَثُ وَالْحَيَاةُ قَصِيرَةٌ","هَيْهَاتَ تَلْحَقُ إِنْ بَقِيْتَ كَمَا أَرَى",91,"ر",2,0],["تَلَهَّبَ شَوْقِيْ لَظَىً فِيْ هَوَاكْ","وَنَايِيْ زَفِيْرٌ سَرَى فِيْ لَظَاكْ",92,"ك",1,1],["تلَهَّبَ الجرحُ في أعمَاقِ خَاطرَتيْ","حتَّى تأجَّجَ فيْ آنائهِ الصَّهَدُ",93,"د",1,0],["تلهو بغفلة ليلتي الأوهام","والناي والقيثار والأحلام",94,"م",1,1],["تلهو على عتباتِه ذكرى الذي","نسجَ الشجونَ بما تبقىَ من غزلْ",95,"ل",1,0],["تلهو وتلعبُ لم تسلمْ غوايتَها","لذاتُها إن علتْ فالموتُ هادمُها",96,"م",3,0],["تلهو به الأحلام ممطرةً","حقلَ الخيال الخصب، تبتكر",97,"ر",1,0],["تلهو بأطرافِ الموائدِ كُلَّما","نكَصوا على أعقابِهم تَعطيلا",98,"ل",2,0],["تلهو بزورقِهِ الرّياحُ وتسْتبي","أيامَهُ في الغربتينِ خطوبُ !",99,"ب",1,0],["تلهو بزورقهِ الرياحُ وتَستبي","أيامَهُ أنّى أقامَ خطوبُ",100,"ب",1,0],["تلهو الرياح بجفن أشرعتي","وتغلّ دون الطالب الطّلبا",101,"ب",2,0],["تلهو بغربتك الأوهامُ عاصفةً","وتدّعي الزّهوَ والإكبارَ والنصرا",102,"ر",2,0],["تلهو بنا في مهبِّ الريحِ شرذمةٌ","جاؤوا على كفِّ مَن كانوا لنا ذَنَبا",103,"ب",2,0],["تلهو بما يسع الأضداد أشرعتي","وتستحث خطاها إثر ما أجد",104,"د",1,1],["تَلَّها لِلْجَبِينِ ثُمَّ امْتَطَاهَا","عَالِمَ ... أفْحَجَ الحَالِبَيْنِ",105,"ن",1,0],["تلهي البرية في ذرى تمثيلها","بفنونها الأسياد والأغنام",106,"م",1,0],["تلْهو بالعالَمِ في يَدِها","والسّادَةُ أجْمَعُهُمْ خَلْفُ",107,"ف",1,0],["تله بعسر وناعم العود مطفوق","ومن سبته يا عمير ظن عتاقي",108,"ق",2,0],["تلهّبت الأرض من عدوه","فأروى بزند الصّفا الصلد ناراً",109,"ر",2,0],["تلهب ماءُ الخد أو سال جمرهُ","فيا جمر ما اذكى ويا ماء ما أندى",110,"د",2,0],["تلهيك عند سماعها","عن كل لهوٍ أو طرب",111,"ب",1,0],["تلهو بيَ الأيام ما شاءت كما","تلهو بيَ الأنفاسُ في عمق البؤرْ",112,"ر",1,0],["تلهب ملذتها فما","لذاتها إلا نهابا",113,"ب",2,0],["تلهو مع الْفجرِ فيْ غُنجٍ وعاشقها","بلهفةٍ عضَّ طرْفَ الحبِّ مبتسما",114,"م",2,0],["تلْهو بماءِ الطَّيفِ في ألوانِهِ","لتَصوغَهُ صُوَراً لها إيماءُ",115,"ا",2,0],["تلهى ذوات الحمل في وضع الأحمال","والمرضعة تذهل لشيب الولايد",116,"د",1,0],["تلهو على مَهَلٍ، كُثْرٌ يشاغلها","ويبتغيها بطرف العينِ مضطربا",117,"ب",2,0],["تلهّى كل مشتاق لينسى","ولم تسترعِ قلبي الملهياتُ",118,"ت",1,0],["تلهو بنا أيامنا ويذيبنا","حزن يطول ودمعة تُغتال",119,"ل",1,0]]}