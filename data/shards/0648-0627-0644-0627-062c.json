{"poems":[[55,"ما أسرع الأيام في طينا","https://www.aldiwan.net/poem29723.html","السريع"],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[74,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[104,"مجد البلاد","https://www.aldiwan.net/poem32907.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[108,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[164,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[409,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[458,"عصابة من لصوص أمنها خطر","https://www.aldiwan.net/poem61283.html","البسيط"],[520,"إلى كم أحوك الشعر في الذم والمدح","https://www.aldiwan.net/poem12053.html","الطويل"],[534,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138191",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126891","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70761","المجتث"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1425,"","https://poetry.dctabudhabi.ae/diwan/poem/124280","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49982","المديد"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67417","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108931","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21650","البسيط"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45267","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91676","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118001","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125808","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125810","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94724","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83127","البسيط"],[4677,"في ساحة الشهر الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=204596",""],[4767,"سر الكون","https://www.poetsgate.com/ViewPoem.aspx?id=204763",""],[5397,"خضعت لعزة ذاتك الدول","https://www.poetsgate.com/ViewPoem.aspx?id=157897",""],[5688,"الجيش الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=213689",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5956,"إلا إلى السُّودان أخلصِ موطن","https://www.poetsgate.com/ViewPoem.aspx?id=193792",""],[5956,"هل حاتم الطيىء نحو الأرض قد عادا؟","https://www.poetsgate.com/ViewPoem.aspx?id=194010",""],[520,"إلى كم احوك الشعر في الذم والمدح","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577463",""]],"verses":[["وَالأَجرُفي الأولى وَإِن أَقلَقَت","وَرُبَّما نَستَقبِحُ الإِحسَنا",0,"ن",2,0],["وَإِلّا جَنَيتُ الأُنسَ مِن وَحشَةِ النَوى","وَهَولِ السُرى بَينَ المَطِيَّةِ وَالرَحلِ",1,"ل",1,0],["والأجر كم جائع عار يقولُ لقد","أصلحتَ باطنَ ملهوفٍ وظاهره",2,"ر",2,0],["وَالاجتهاد","لِلعُلى نَهجٌ مُبين",3,"ن",1,0],["وَالأجَلُّ الأجَلُّ مِنْهُم زَرِيٌّ","وَالأعَزُّ الأعزُّ مِنهُم ذَلِيلُ",4,"ل",1,0],["والأجنبي يدير الحربَ عن كَثَب","في مصرَ، وهْوَ قريرُ العين جذلان",5,"ن",1,0],["والأجر يكتب والخطايا تنمحي","وانسب إلى قد امرئ حسناتهِ",6,"ت",2,0],["وَالأَجَلُ المَقضِيَّ وَالسِيَر وَما","آنَسَ فَوقَ الطورِ مِن عَليا الشَجَر",7,"ر",1,0],["والأجدرية للكليم لأنه","لخليله قد أكثر التثقيلا",8,"ل",2,0],["والأجنبي على علاته رحم","متى يقاس بهم في شر ما أمروا",9,"ر",3,0],["وإلا جواداً مثل ورد تسوقها","سجاياه بالإكرام والخلق السحج",10,"ح",2,0],["والإجْتِهادُ غدا في كُتْبِ فِقْهِكُمُ","شَرْطَ الإمامِ فإِنْ تَعْدُوهُ لم يَجِبِ",11,"ب",1,0],["والأجر عند الله فيض مراحم","للقائمين بنصرة الضعفاء",12,"ا",2,0],["وَالأجنبيّ يحطّ فيها رحلَهُ","ولهُ يمهّد منزلٌ ومكانُ",13,"ن",1,0],["والأجرُ فيه يوفَّي","والسيئاتُ تكفَّر",14,"ر",1,0],["وَالأَجْرُ وَالمَعْرُوفُ كَنْزٌ تَغْنَمُهْ","وَالدَهْرُ ما قارَبَ أَمْراً أَمَمُهْ",15,"م",2,0],["وَالأجَلُ المَحتُومُ يَتلُو هَل أَتَى","وَلا يُبقي مَن عَنا وَمَن عَتَا",16,"ت",2,0],["والا جلوسا ركبةً فوق ركبة","وما عندنا الا القرائحُ تنظم",17,"م",1,0],["والأجلَّ ابنَ أبي عُمَرا","والمجيدَ الفعلَ والنَّظَرا",18,"ر",2,0],["وَالأجْبَهُ بْنُ نُمَيْرٍ فَوقَ مُفْرَشَةٍ","يَرْنُو إلى أحْوَرِ الْعَيْنَيْنْ ذِي عُكَنِ",19,"ن",1,0],["والأجر بين شقائق النعمان ري","قتها التي أفتى بها النعمان",20,"ن",1,0],["والأجرُ للوزن والمكيال مجتنبٌ","والنائحات فدع ما كان مجتنبا",21,"ب",2,0],["وَالأَجبَهُ بِنُ نُمَيرٍ فَوقَ مِفرِشِهِ","يَرنو إِلى أَحوَرِ العَينَينِ ذي غَنَنِ",22,"ن",1,0],["وَإِلّا جِئتُ نُعنُعَها بِقَولٍ","يُصَيِّرهُ ثَماناً في ثَمانِ",23,"ن",1,1],["وَإِلا جُزتَ بالصحب الخوالي","فَهَذا النفحُ من تلك النَواحي",24,"ح",2,0],["والاجتماع أجل حصن رادع","عبث الخصوم وسَورة العدوان",25,"ن",1,0],["والأجنبي له السيادة كلُّها","قد وُطدت بمكائد وتلاعب",26,"ب",1,0],["والأجنبي صديقُه وحميمه","جهلا ومن أعدائه جاراته",27,"ت",2,0],["وإلّا جئتَ في قولٍ بخلفٍ","كلام الليل يمحوهُ النهارُ",28,"ر",1,0],["وَالاجتِهادُ بِغَيرِ الذَوقِ مَضيَعةٌ","ذُو الجهد إِن لَم يُعِنهُ الذَوقُ مُحتَطِبُ",29,"ب",1,0],["والأجر ضعف وضعف لا مثيل له","فيما سواك ... بكل الدهر يختلف",30,"ف",1,0],["والأجودَ الكفِّ التي بحرها","قد كان للمُبحِر مُستعذَبا",31,"ب",2,0],["والأجدل الغطريف يسبقه","عند النهوض لصيده الحجل",32,"ل",1,0],["وَالأَجْرُ مِنْ رَبِّ السَّمَاءِ مُضَاعَفٌ","لَا نَقْصَ فِيهِ بَلْ عَلَيْهِ يُزَادُ",33,"د",1,0],["والأجنبي والسري أو من لهم نسبوا","والغر والتيس والملقي علي فيه",34,"ي",2,0],["والأجنبيُّ من الحلال دخولُه","في أرض يعربَ حيث شاء تَفَيَّا..",35,"ي",2,0],["والأجر عند إله الناس محتشد","حتى يكافئه بالحقِ مرصادا",36,"د",2,0],["وإلا جواداً مثل وردٍ تسوقها","سجاياه بالإكرام والخلق السجح",37,"ح",1,0]]}