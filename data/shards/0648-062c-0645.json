"],[1048,"","https://poetry.dctabudhabi.ae/diwan/poem/45522","الوافر"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18731","الطويل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2565","الوافر"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/79619","الكامل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[1145,"","https://poetry.dctabudhabi.ae/diwan/poem/31513","الوافر"]],"verses":[["وَجَمالُ وَجهِكَ لي بِنَي","لِ جَميعِ ما أَرجو ضَمينُ",0,"ن",1,0],["وَجَمعٍ إِذا هَزّوا اللِواءَ تَجاوَبَت","جَوانِبَهُ مِن أَزمَلٍ وَزَمازِمِ",1,"م",1,0],["وَجَمِيعُ مَنْ في الأَرْضِ لَيْسَ بِمُنْكِرٍ","أَنَّ الوَرَى ذَنَبٌ وَنَحْنُ الرّاسُ",2,"س",1,0],["وجمّعْتَ أسْباطَ المَكارِمِ والعُلى","ونادَيْتَ لا تَثْرِيبَ إذْ أنْتَ يوسُفُ",3,"ف",1,0],["وَجَمَاعَةٌ رَكِبُوا الْمَفَازَةَ دَائِماً","عَثَرُوا عَلَى أَثَرٍ فَشَطَّ الْمَنْزِلُ",4,"ل",1,0],["وجُمْلَةُ الأمْرِ أنّهُ وطَنٌ","في غيْرِ عُلْياكَ ما لهُ وطَرُ",5,"ر",1,0],["وجمَّ لكَ المرْعى وأذْعَنَتِ الصّوى","ولمْ تَفْتَقِدْ ظِلاً ظَليلاً ولا وِرْدا",6,"د",2,0],["وجَمَّعَ فيكَ اللّهُ مُفْتَرِقَ العُلى","وشتّى المَعاني الغُرِّ في عَلَمٍ فَرْدِ",7,"د",1,0],["وَجَمَالِ مَرْأَى فِي رِدَاءِ مَهَابَةٍ","كَالسَّيْفِ مَصْقُولِ الْفِرنْدِ مهِيبِ",8,"ب",1,0],["وَجَميعُ ثَعلَبَةَ بنِ سَع","دٍ بَعدُ حَولَ قِبابِها",9,"ب",3,0],["وَجَمرَةٍ لَهُم في الشَرقِ ما هَمَدَت","وَلا عَلاها رَمادُ الخَتلِ وَالكَذِبِ",10,"ب",1,0],["وَجَمَعتَ شَعبَكَ كُلَّهُ في قَبضَةٍ","إِن لَم تَكُن لانَت فَسَوفَ تَلينُ",11,"ن",1,0],["وَجَمَعتَ بِالدُستورِ حَولَكَ أُمَّةً","شَتّى المَذاهِبِ جَمَّةَ الأَضغانِ",12,"ن",1,0],["وَجَمَّعَ مِن أَنوارِ مَدحِكَ طاقَةً","يُطالِعُها طَرفُ الرَبيعِ فَيُطرَفُ",13,"ف",1,0],["وَجَمَالِ نَفْسٍ حُرَّةٍ مَا عَابَها","إِلاَّ تَنَزُّهُهَا عَنِ البُهْتَانِ",14,"ن",1,0],["وَجَمِيلُ ذِكْرٍ لَمْ يُفِدْ فِي دَفْعِ مَا","يَتَبَشَّعُ التَّحْوِيلُ فِي الجُثْمَانِ",15,"ن",1,0],["وَجَمِيلِ سَعِيٍ يُسْتَمَدُّ مَعُونَةً","لِيَتِيمَةٍ مَنْبُوذَةٍ أَوْ أَيِّمِ",16,"م",1,0],["وَجَميعُ أَملاكِ السَما لَكِ تُنجِدُ","هَذَا حَبيبُكِ بِالنُصولِ مُقَطَّعٌ",17,"ع",1,0],["وَجَمعٌ وَبَطحاءُ البِطاحِ الَّتي بِها","لَنا مَسجِدُ اللَهِ الحَرامُ المُطَهَّرُ",18,"ر",1,0],["وَجَمعاً حَيثُ كانض يقال أَشرِق","ثَبِيرٌ أَتا لدفعه وَاقفِينَا",19,"ن",2,0],["وَجُمهانٌ تَجافَت عَنهُ بيضٌ","عَدَلنَ عَنِ الصَريحِ إِلى المَوالي",20,"ل",2,0],["وَجَمرَةُ عارٌ لَكُم ثابِتٌ","فَقَلبُكَ مِن ذِكرِها واجِمُ",21,"م",1,0],["وجمَّل دنيانا ببثّ جميلةٍ","وغطى على مكروهها والقبائح",22,"ح",1,0],["وجملت فيك الشعر حتى نظمتهُ","فما البيتُ إلا مثل قصرٍ مشيدِ",23,"د",1,0],["وجمعْ في زمانك كلّ عصرٍ","كجمع العام أفراد الشهور",24,"ر",1,0],["وجَمَّش القُرُّ فيه الجلدَ فائتلفتْ","من الضَّجيعينِ أحشاءٌ وأحشاءُ",25,"ا",2,0],["وجمالاً مُنَمَّقاً وجلالاً","ووفاءً مُحقَّقاً وصفاءَ",26,"ا",2,0],["وجميلُ المقالِ فيكم وحظي","من جَداكم مما أراه سَواءَ",27,"ا",2,0],["وجمالهنّ وما لَبِسْ","نَ من الحبير معاً حَبيرُ",28,"ر",1,0],["وجميعُ الشراب مما سِواها","غيرُ لذٍّ إلا لدى الظمآنِ",29,"ن",1,0],["وجمالَ وجهِكَ إنَّه","مِنْ كُلِّ مَحْذورٍ أماني",30,"ن",2,0],["وجِمالٍ تُقادُ من بَعْدِ إخلا","قٍ ومُهْرٍ يَطْوي على كفِّ تِبنِ",31,"ن",1,0],["وَجَميلٌ فِكرَةٌ هائِمَةٌ","وَأَمينٌ أَمَلٌ مُخضَوضِرُ",32,"ر",1,0],["وَجَمَت فَأَمسى كُلُّ شَيءٍ واجِماً","النور وَالأَظلال وَالدَيجورُ",33,"ر",1,0],["وَجُملَةُ الأَمرِ وَلا أُطيلُ","هُوَ الرَصاصُ بارِدٌ ثَقيلُ",34,"ل",1,0],["وَجُملَةٌ مِن لَآلٍ","وَجَوهَرٍ شَفّافِ",35,"ف",1,0],["وَجُملَةُ الأَمرِ وَتَفصيلُهُ","أَن صِرتُ لا دُنيا وَلا آخِرَه",36,"ه",1,0],["وجمالَ الظَّلامِ يعبقُ بالأَح","لامِ والحُبِّ فابْسِمِي والثُمِيني",37,"ن",2,0],["وجمالهِ قبساً أَضاءَ ظلامي","فرأيتُ أَلوانَ الحَيَاةِ نضيرةً",38,"ه",1,0],["وَجُمّعت فيكَ خِصال الوَرى","وَحُزتَ آراءً وَإِقداما",39,"م",2,0],["وجميل من العنادل شدو","وقبيح من الغراب النعيب",40,"ب",1,0],["وجمال الخط للكا","تب زَينٌ فوق زين",41,"ن",1,0],["وجموع عُزَّل ما أكترثت","لجموع بالمواضي معلنين",42,"ن",1,0],["وجمعت السعادتين فباتت","فيك دنيا الصلاح للدين خِدنا",43,"ن",2,0],["وَجَمَعوا الناسَ عَلى خَليفَةٍ","مِن وَلَد العَباسِ لا أَمرَ وَلا",44,"ا",1,0],["وَجَمالُ الأَرضِ وَحليَتُها","وَطَلائِعُ أَفراحِ المُدُنِ",45,"ن",1,0],["وَجُملَةُ المَقالِ","هُوَ الحَبيبُ الغالي",46,"ي",1,0],["وَجَمعٍ تَآلَفَ بَعدَ الخِلافِ","وَصافى وَصوفِيَ بَعدَ الضَغَن",47,"ن",1,0],["وَجَمالُ يوسُفَ لا يَزالُ لِواؤُهُ","حَولَيكَ في أُفُقِ الجَلالِ يُرَنَّقُ",48,"ق",1,0],["وَجَميعُ أُمَّةِ أَحمَدٍ يَرجونَكُم","لِدِفاعِ ما رَهِبوا وَفَكِّ المُقرَمِ",49,"م",1,0],["وَجَميعُ ما حَصَّلتَهُ وَجَمَعتَهُ","حَقّاً يَقيناً بَعدَ مَوتِكَ يُنهَبُ",50,"ب",1,0],["وَجَمَّعتَ ما لا يَنبَغي لَكَ جَمعُهُ","وَقَصَّرتَ عَمّا يَنبَغي وَتَوانَيتا",51,"ت",2,0],["وَجَميعُ ما لِلمَرءِ مِن عَمَلٍ","فَالمَرءُ يَحصِدُهُ وَيَزرَعُهُ",52,"ع",2,0],["وَجَميعُ ما هُوَ كائِنٌ","يَجري بِسابِقِ عِلمِهِ",53,"م",2,0],["وَجَميعُ ما نَلهو بِهِ مَرَحاً","مِن لَذَّةٍ فَالمَوتُ هادِمُهُ",54,"م",2,0],["وَجَمرَةِ حَربٍ أَجَّجَ الشَوسُ وَقَدها","وَبيضُ الظُبى وَالعادِياتُ الضَوابِحُ",55,"ح",1,0],["وَجَمعُ هَمدانَ لَهُم لَجبَةٌ","وَرايَةٌ تَهوي هُوِيَّ الأَنوق",56,"ق",1,0],["وجمانُ ثغرِكِ رفّ من لمَعَانِهِ","وعقيقُ خَدّكِ رائقٌ شَفّافُ",57,"ف",1,0],["وَجَمَعتُ بَينَ المَشرَفِيِّ وَبَينَهُ","فَتَلاقَتِ الأَشباهُ وَالأَشكالُ",58,"ل",1,0],["وَجَمعتم فيهِ من أشياعِكم","كُلَّ غاوٍ يجعلْ السُّوآى شِعَارَا",59,"ر",2,0],["وَجَمَعتُ في آذارَ بَينَكُما فَما","أَحلاك في قَلبي وَما أَحلاها",60,"ا",3,0],["وَجَمعٍ سَقَينا أَرضَهُ مِن دِمائِهِ","وَلَو كانَ عافانا قَبِلنا العَوافِيا",61,"ي",2,0],["وَجَمعٍ سارَ يَقدُمُهُ لِواءٌ","كَفَضلِ عَمامَةِ الرَجُلِ الطَويلِ",62,"ل",1,0],["وَجَمِيعُ كُتبِهِمُ على عِلَّاتِها","نَطَقَت بِذِكر مُحَمَّدٍ تَعلِيلا",63,"ل",2,0],["وجَمَعتَ شَملَ المُتَّقينَ على الهدى","وتألّفَتْ بكَ أنفُسُ الحيوانِ",64,"ن",1,0],["وَجُمِّشَت بِخَفِيِّ اللَحظِ فَاِنجَمَشَت","وَجَرَّتِ الوَعدَ بَينَ الصِدقِ وَالكَذِبِ",65,"ب",1,0],["وَجَميعُهُم لِيَ حينَ أَقعُدُ بَينَهُم","بِتَذَلُّلٍ وَتَهَيُّبٍ مَوسومُ",66,"م",1,0],["وجمّاشٍ يلومُ على اللواط","له وجهٌ كمَرمرَةِ البلاط",67,"ط",1,1],["وَجَمالٌ وَدَلالٌ","مِثلُ دَلِّ القاصِراتِ",68,"ت",1,0],["وجَمالُ الأوانِ عَقْبُ جُدودٍ","كلُّ جدّ منهمْ جَمالُ أوانِ",69,"ن",1,0],[