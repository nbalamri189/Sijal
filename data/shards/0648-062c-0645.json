,[559,"لم يفه يا ذا الوجه فم","https://www.aldiwan.net/poem34084.html","المديد"],[559,"صدق الكتاب لمن به يتمسك","https://www.aldiwan.net/poem34273.html","الكامل"],[559,"كل مصنوع بمن قد صنعه","https://www.aldiwan.net/poem34365.html","الرمل"],[559,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[559,"عيني لغير جمالكم لا تنظر","https://www.aldiwan.net/poem34479.html","الكامل"],[559,"يا بديع الحسن بالصور","https://www.aldiwan.net/poem34536.html","المديد"],[559,"دارنا هذه هي الأشجار","https://www.aldiwan.net/poem34537.html","الخفيف"],[559,"لا رؤية ولا شهود","https://www.aldiwan.net/poem34577.html","مجزوء الرجز"],[559,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[559,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[559,"إن الوجود الحق شيء واحد","https://www.aldiwan.net/poem34654.html","الكامل"],[559,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[559,"ظهر الوجود بسائر الأشياء","https://www.aldiwan.net/poem35085.html","الكامل"],[559,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[559,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[576,"يأيها الغصن الذي قد ذوى","https://www.aldiwan.net/poem2769.html","السريع"],[576,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"],[576,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[577,"أعاذل إن المرء رهن مصيبة","https://www.aldiwan.net/poem1799.html","الطويل"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَجَمالُ وَجهِكَ لي بِنَي","لِ جَميعِ ما أَرجو ضَمينُ",0,"ن",1,0],["وَجَمعٍ إِذا هَزّوا اللِواءَ تَجاوَبَت","جَوانِبَهُ مِن أَزمَلٍ وَزَمازِمِ",1,"م",1,0],["وَجَمِيعُ مَنْ في الأَرْضِ لَيْسَ بِمُنْكِرٍ","أَنَّ الوَرَى ذَنَبٌ وَنَحْنُ الرّاسُ",2,"س",1,0],["وجمّعْتَ أسْباطَ المَكارِمِ والعُلى","ونادَيْتَ لا تَثْرِيبَ إذْ أنْتَ يوسُفُ",3,"ف",1,0],["وَجَمَاعَةٌ رَكِبُوا الْمَفَازَةَ دَائِماً","عَثَرُوا عَلَى أَثَرٍ فَشَطَّ الْمَنْزِلُ",4,"ل",1,0],["وجُمْلَةُ الأمْرِ أنّهُ وطَنٌ","في غيْرِ عُلْياكَ ما لهُ وطَرُ",5,"ر",1,0],["وجمَّ لكَ المرْعى وأذْعَنَتِ الصّوى","ولمْ تَفْتَقِدْ ظِلاً ظَليلاً ولا وِرْدا",6,"د",2,0],["وجَمَّعَ فيكَ اللّهُ مُفْتَرِقَ العُلى","وشتّى المَعاني الغُرِّ في عَلَمٍ فَرْدِ",7,"د",1,0],["وَجَمَالِ مَرْأَى فِي رِدَاءِ مَهَابَةٍ","كَالسَّيْفِ مَصْقُولِ الْفِرنْدِ مهِيبِ",8,"ب",1,0],["وَجَميعُ ثَعلَبَةَ بنِ سَع","دٍ بَعدُ حَولَ قِبابِها",9,"ب",3,0],["وَجَمرَةٍ لَهُم في الشَرقِ ما هَمَدَت","وَلا عَلاها رَمادُ الخَتلِ وَالكَذِبِ",10,"ب",1,0],["وَجَمَعتَ شَعبَكَ كُلَّهُ في قَبضَةٍ","إِن لَم تَكُن لانَت فَسَوفَ تَلينُ",11,"ن",1,0],["وَجَمَعتَ بِالدُستورِ حَولَكَ أُمَّةً","شَتّى المَذاهِبِ جَمَّةَ الأَضغانِ",12,"ن",1,0],["وَجَمَّعَ مِن أَنوارِ مَدحِكَ طاقَةً","يُطالِعُها طَرفُ الرَبيعِ فَيُطرَفُ",13,"ف",1,0],["وَجَمَالِ نَفْسٍ حُرَّةٍ مَا عَابَها","إِلاَّ تَنَزُّهُهَا عَنِ البُهْتَانِ",14,"ن",1,0],["وَجَمِيلُ ذِكْرٍ لَمْ يُفِدْ فِي دَفْعِ مَا","يَتَبَشَّعُ التَّحْوِيلُ فِي الجُثْمَانِ",15,"ن",1,0],["وَجَمِيلِ سَعِيٍ يُسْتَمَدُّ مَعُونَةً","لِيَتِيمَةٍ مَنْبُوذَةٍ أَوْ أَيِّمِ",16,"م",1,0],["وَجَميعُ أَملاكِ السَما لَكِ تُنجِدُ","هَذَا حَبيبُكِ بِالنُصولِ مُقَطَّعٌ",17,"ع",1,0],["وَجَمعٌ وَبَطحاءُ البِطاحِ الَّتي بِها","لَنا مَسجِدُ اللَهِ الحَرامُ المُطَهَّرُ",18,"ر",1,0],["وَجَمعاً حَيثُ كانض يقال أَشرِق","ثَبِيرٌ أَتا لدفعه وَاقفِينَا",19,"ن",2,0],["وَجُمهانٌ تَجافَت عَنهُ بيضٌ","عَدَلنَ عَنِ الصَريحِ إِلى المَوالي",20,"ل",2,0],["وَجَمرَةُ عارٌ لَكُم ثابِتٌ","فَقَلبُكَ مِن ذِكرِها واجِمُ",21,"م",1,0],["وجمَّل دنيانا ببثّ جميلةٍ","وغطى على مكروهها والقبائح",22,"ح",1,0],["وجملت فيك الشعر حتى نظمتهُ","فما البيتُ إلا مثل قصرٍ مشيدِ",23,"د",1,0],["وجمعْ في زمانك كلّ عصرٍ","كجمع العام أفراد الشهور",24,"ر",1,0],["وجَمَّش القُرُّ فيه الجلدَ فائتلفتْ","من الضَّجيعينِ أحشاءٌ وأحشاءُ",25,"ا",2,0],["وجمالاً مُنَمَّقاً وجلالاً","ووفاءً مُحقَّقاً وصفاءَ",26,"ا",2,0],["وجميلُ المقالِ فيكم وحظي","من جَداكم مما أراه سَواءَ",27,"ا",2,0],["وجمالهنّ وما لَبِسْ","نَ من الحبير معاً حَبيرُ",28,"ر",1,0],["وجميعُ الشراب مما سِواها","غيرُ لذٍّ إلا لدى الظمآنِ",29,"ن",1,0],["وجمالَ وجهِكَ إنَّه","مِنْ كُلِّ مَحْذورٍ أماني",30,"ن",2,0],["وجِمالٍ تُقادُ من بَعْدِ إخلا","قٍ ومُهْرٍ يَطْوي على كفِّ تِبنِ",31,"ن",1,0],["وَجَميلٌ فِكرَةٌ هائِمَةٌ","وَأَمينٌ أَمَلٌ مُخضَوضِرُ",32,"ر",1,0],["وَجَمَت فَأَمسى كُلُّ شَيءٍ واجِماً","النور وَالأَظلال وَالدَيجورُ",33,"ر",1,0],["وَجُملَةُ الأَمرِ وَلا أُطيلُ","هُوَ الرَصاصُ بارِدٌ ثَقيلُ",34,"ل",1,0],["وَجُملَةٌ مِن لَآلٍ","وَجَوهَرٍ شَفّافِ",35,"ف",1,0],["وَجُملَةُ الأَمرِ وَتَفصيلُهُ","أَن صِرتُ لا دُنيا وَلا آخِرَه",36,"ه",1,0],["وجمالَ الظَّلامِ يعبقُ بالأَح","لامِ والحُبِّ فابْسِمِي والثُمِيني",37,"ن",2,0],["وجمالهِ قبساً أَضاءَ ظلامي","فرأيتُ أَلوانَ الحَيَاةِ نضيرةً",38,"ه",1,0],["وَجُمّعت فيكَ خِصال الوَرى","وَحُزتَ آراءً وَإِقداما",39,"م",2,0],["وجميل من العنادل شدو","وقبيح من الغراب النعيب",40,"ب",1,0],["وجمال الخط للكا","تب زَينٌ فوق زين",41,"ن",1,0],["وجموع عُزَّل ما أكترثت","لجموع بالمواضي معلنين",42,"ن",1,0],["وجمعت السعادتين فباتت","فيك دنيا الصلاح للدين خِدنا",43,"ن",2,0],["وَجَمَعوا الناسَ عَلى خَليفَةٍ","مِن وَلَد العَباسِ لا أَمرَ وَلا",44,"ا",1,0],["وَجَمالُ الأَرضِ وَحليَتُها","وَطَلائِعُ أَفراحِ المُدُنِ",45,"ن",1,0],["وَجُملَةُ المَقالِ","هُوَ الحَبيبُ الغالي",46,"ي",1,0],["وَجَمعٍ تَآلَفَ بَعدَ الخِلافِ","وَصافى وَصوفِيَ بَعدَ الضَغَن",47,"ن",1,0],["وَجَمالُ يوسُفَ لا يَزالُ لِواؤُهُ","حَولَيكَ في أُفُقِ الجَلالِ يُرَنَّقُ",48,"ق",1,0],["وَجَميعُ أُمَّةِ أَحمَدٍ يَرجونَكُم","لِدِفاعِ ما رَهِبوا وَفَكِّ المُقرَمِ",49,"م",1,0],["وَجَميعُ ما حَصَّلتَهُ وَجَمَعتَهُ","حَقّاً يَقيناً بَعدَ مَوتِكَ يُنهَبُ",50,"ب",1,0],["وَجَمَّعتَ ما لا يَنبَغي لَكَ جَمعُهُ","وَقَصَّرتَ عَمّا يَنبَغي وَتَوانَيتا",51,"ت",2,0],["وَجَميعُ ما لِلمَرءِ مِن عَمَلٍ","فَالمَرءُ يَحصِدُهُ وَيَزرَعُهُ",52,"ع",2,0],["وَجَميعُ ما هُوَ كائِنٌ","يَجري بِسابِقِ عِلمِهِ",53,"م",2,0],["وَجَميعُ ما نَلهو بِهِ مَرَحاً","مِن لَذَّةٍ فَالمَوتُ هادِمُهُ",54,"م",2,0],["وَجَمرَةِ حَربٍ أَجَّجَ الشَوسُ وَقَدها","وَبيضُ الظُبى وَالعادِياتُ الضَوابِحُ",55,"ح",1,0],["وجمانُ ثغرِكِ رفّ من لمَعَانِهِ","وعقيقُ خَدّكِ رائقٌ شَفّافُ",56,"ف",1,0],["وَجَمَعتُ بَينَ المَشرَفِيِّ وَبَينَهُ","فَتَلاقَتِ الأَشباهُ وَالأَشكالُ",57,"ل",1,0],["وَجَمعتم فيهِ من أشياعِكم","كُلَّ غاوٍ يجعلْ السُّوآى شِعَارَا",58,"ر",2,0],["وَجَمَعتُ في آذارَ بَينَكُما فَما","أَحلاك في قَلبي وَما أَحلاها",59,"ا",3,0],["وَجَمعٍ سَقَينا أَرضَهُ مِن دِمائِهِ","وَلَو كانَ عافانا قَبِلنا العَوافِيا",60,"ي",2,0],["وَجَمعٍ سارَ يَقدُمُهُ لِواءٌ","كَفَضلِ عَمامَةِ الرَجُلِ الطَويلِ",61,"ل",1,0],["وَجَمِيعُ كُتبِهِمُ على عِلَّاتِها","نَطَقَت بِذِكر مُحَمَّدٍ تَعلِيلا",62,"ل",2,0],["وجَمَعتَ شَملَ المُتَّقينَ على الهدى","وتألّفَتْ بكَ أنفُسُ الحيوانِ",63,"ن",1,0],["وَجُمِّشَت بِخَفِيِّ اللَحظِ فَاِنجَمَشَت","وَجَرَّتِ الوَعدَ بَينَ الصِدقِ وَالكَذِبِ",64,"ب",1,0],["وَجَميعُهُم لِيَ حينَ أَقعُدُ بَينَهُم","بِتَذَلُّلٍ وَتَهَيُّبٍ مَوسومُ",65,"م",1,0],["وجمّاشٍ يلومُ على اللواط","له وجهٌ كمَرمرَةِ البلاط",66,"ط",1,1],["وَجَمالٌ وَدَلالٌ","مِثلُ دَلِّ القاصِراتِ",67,"ت",1,0],["وجَمالُ الأوانِ عَقْبُ جُدودٍ","كلُّ جدّ منهمْ جَمالُ أوانِ",68,"ن",1,0],["وَجُمجُمَةٌ مِثلُ العَلاةِ كَأَنَّما","وَعى المُلتَقى مِنها إِلى حَرفِ مِبرَدِ",69,"د",1,0],["وَجُموعَ غَسّانَ المُلو","كَ أَتَينَهُم وَقَدِ اِنطَوَينا",70,"ن",2,0],["وَجَمعَ غَسّانَ لَقيناهُمُ","بِجَحفَلٍ قَسطَلُهُ ذائِلُ",71,"ل",1,0],["وَجمَّعتُ بَزّي فَوقَهُ فَدَفَعتُهُ","وَوَزَّعتُ مِنهُ رَهبَةً أَن يُكَسَّرا",72,"ر",2,0],["وَجمَّعتُ بَزّي فَوقَهُ ودَفعتُهُ","وَنَأنَأتُ مِنهُ خَشيةَ أَن يُكَسَّرا",73,"ر",2,0],["وجَمَّعَ العُدَّةَ والعَدِيدا","وكَثَّفَ الأَجْنادَ والحُشودا",74,"د",2,0],["وجميع الحصباء درٌّ وياقو","تٌ وماسٌ شعاعه مستطير",75,"ر",1,0],["وجماعاتٌ غيرهم كلُّهم جل","دٌ على نارها وكلٌّ صبور",75,"ر",1,0],["وجمّل العيش للحزانى","فكل حالٍ به تطيب",76,"ب",1,0],["وجمالِ أسحارٍ وطيبِ أصائلٍ","بالذِّكرياتِ روائحٍ وغَوَادي",77,"د",2,0],["وجمت وكانت الموت فوق ظلالها","تست