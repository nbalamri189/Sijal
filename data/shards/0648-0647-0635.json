{"poems":[[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[109,"هب يجلو الراح في كاس اللجين","https://www.aldiwan.net/poem16521.html","الرمل"],[115,"سلام الذ من السلسبيل","https://www.aldiwan.net/poem41130.html","عموديه"],[166,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[197,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[237,"رب من صادني وبرحبي","https://www.aldiwan.net/poem18047.html","الخفيف"],[275,"هنيئا لوفد الغرب من صفوة العرب","https://www.aldiwan.net/poem25623.html","الطويل"],[363,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[402,"وا طول حزني في غد وتحسري","https://www.aldiwan.net/poem47004.html","الطويل"],[429,"قالت وقد جاذبتها وتمنعت","https://www.aldiwan.net/poem40282.html","الكامل"]],"verses":[["وَهَصَرتُ أَغصانَ المَطالِبِ مُيَّساً","وَمَرَيتُ أَخلافَ المَواهِبِ حُفَّلا",0,"ل",2,0],["وهَصورٌ يَفرِسُ القِرْنُ إِذا","جَرّدَ المُرهفَ فَوقَ الأَجرَدِ",1,"د",1,0],["وَهَصرنا القَد غُصناً يانِعاً","وَجَنيناً وَردهُ بِالناظِرين",2,"ن",1,0],["وهصر الخصور ولمس العيون","وكسر الجفون وضم القدود",3,"د",1,0],["وهَصري غُصنَ ذابلةِ التثنِّي","وقَطْفي وردَ ناضِرِةِ الجَمالِ",4,"ل",1,0],["وهَصَرتُ بانةَ قدّهِ","فحَسا الصبوحَ على اهتِصاري",5,"ي",1,0],["وَهَصَرْتُ مِنْ قَدِّهِ غُصُناً","مُثْمِراً بِالْهِلاَلِ وَالشُّهُبِ",6,"ب",1,0],["وهَصْرٌ لأفنانِ الأماني أفادَهُم","أفانينَ حصْبِ الجُودِ بالرَّفْهِ والخِصْبِ",7,"ب",1,0],["وَهَصنَ الحَصى حَتّى كَأَنَّ رُضاضَهُ","ذُرى بَرَدٍ مِن وابِلٍ مُتَحَلَّبِ",8,"ب",1,0],["وهَصَرتُ غُصْنَ اللَّهوِ في روضِ الهوى","بيدِ البطالَةِ لَيْتَني لم أَهْصِرِ",9,"ر",1,0],["وهصرتها قالت دلالاً لم أكن","من بعد ذا بحبيبك المعهودِ",10,"د",1,0]]}