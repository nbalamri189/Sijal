{"poems":[[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[82,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[113,"هب يجلو الراح في كاس اللجين","https://www.aldiwan.net/poem16521.html","الرمل"],[119,"سلام الذ من السلسبيل","https://www.aldiwan.net/poem41130.html","عموديه"],[170,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[201,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[242,"رب من صادني وبرحبي","https://www.aldiwan.net/poem18047.html","الخفيف"],[280,"هنيئا لوفد الغرب من صفوة العرب","https://www.aldiwan.net/poem25623.html","الطويل"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[408,"وا طول حزني في غد وتحسري","https://www.aldiwan.net/poem47004.html","الطويل"],[435,"قالت وقد جاذبتها وتمنعت","https://www.aldiwan.net/poem40282.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119947","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59247","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80233","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77251","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107008","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94516","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94786","الطويل"],[4984,"حلم المنتهى","https://www.poetsgate.com/ViewPoem.aspx?id=175748",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[6131,"مَا بينَ نُقطَتينْ","https://www.poetsgate.com/ViewPoem.aspx?id=189221",""]],"verses":[["وَهَصَرتُ أَغصانَ المَطالِبِ مُيَّساً","وَمَرَيتُ أَخلافَ المَواهِبِ حُفَّلا",0,"ل",2,0],["وهَصورٌ يَفرِسُ القِرْنُ إِذا","جَرّدَ المُرهفَ فَوقَ الأَجرَدِ",1,"د",1,0],["وَهَصرنا القَد غُصناً يانِعاً","وَجَنيناً وَردهُ بِالناظِرين",2,"ن",1,0],["وهصر الخصور ولمس العيون","وكسر الجفون وضم القدود",3,"د",1,0],["وهَصري غُصنَ ذابلةِ التثنِّي","وقَطْفي وردَ ناضِرِةِ الجَمالِ",4,"ل",1,0],["وهَصَرتُ بانةَ قدّهِ","فحَسا الصبوحَ على اهتِصاري",5,"ر",2,0],["وَهَصَرْتُ مِنْ قَدِّهِ غُصُناً","مُثْمِراً بِالْهِلاَلِ وَالشُّهُبِ",6,"ب",1,0],["وهَصْرٌ لأفنانِ الأماني أفادَهُم","أفانينَ حصْبِ الجُودِ بالرَّفْهِ والخِصْبِ",7,"ب",1,0],["وَهَصنَ الحَصى حَتّى كَأَنَّ رُضاضَهُ","ذُرى بَرَدٍ مِن وابِلٍ مُتَحَلَّبِ",8,"ب",1,0],["وهَصَرتُ غُصْنَ اللَّهوِ في روضِ الهوى","بيدِ البطالَةِ لَيْتَني لم أَهْصِرِ",9,"ر",1,0],["وهصرتها قالت دلالاً لم أكن","من بعد ذا بحبيبك المعهودِ",10,"د",1,0],["وهصرت قد هزة","سكر الصبا فثملت سكرا",11,"ر",2,0],["وَهَصَرْنَا مِنَ القدُودِ غُصُونًا","طَارَحَتْهَا بَلاَبِلُ الأشْوَاقِ",12,"ق",1,0],["وَهَصرتُ خَصركِ فَإِنثَنى مُتطائِراً","مني كَأَني قابِضٌ بالزَيبَقِ",13,"ق",1,0],["وَهَصَرتُ غُصنَ قَوامِهِ","وَحَلَلتُ عقدَ نِطاقِهِ",14,"ق",2,0],["وهصرتها فتمايلت غصناً على","دعصين ليس هما سوى ردفيها",15,"ي",3,0],["وهصَّر أحشائي بعضبٍ من القِلا","وصمصامهُ أضحى لِقَلبي ملاعبا",16,"ب",2,0],["وهصَّرت من روض الصِبا قنس دوحةٍ","فناحت مع القَيسوم عبهَرَه الرندِ",17,"د",1,0],["وهصور لاذ بالصحراء لا","يعلم الدرب إلى أين يؤول",18,"ل",1,0],["وهصورٍلمْ يُغْمدالسيفَ يوماً","قبل قهرالأعداءِ وهْومَكينُ",19,"ن",1,0],["وَ هَصَرتُ منْ بِرَكِ الشُّعورِ قصيدَتي","فَرَقَتْ ( لُغاتيْ ) حِكْمةً وَ خيَالا",20,"ل",2,0]]}