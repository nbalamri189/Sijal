{"poems":[[31,"أتنكر الدار أم عرفان منزلة","https://www.aldiwan.net/poem6042.html","البسيط"],[33,"حي المنازل قد تركن خرابا","https://www.aldiwan.net/poem42631.html","الكامل"],[259,"أمل","https://www.aldiwan.net/poem24947.html","مجزوء الرمل"],[325,"أشكر الله يا محمد وأحمد","https://www.aldiwan.net/poem67196.html","الخفيف"],[563,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[580,"يا ليلة مرت لنا حلوه","https://www.aldiwan.net/poem2949.html","السريع"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75741","الخفيف"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20414","البسيط"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119238","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[1824,"أيها الأوحد الفريد سلام","https://www.poetsgate.com/ViewPoem.aspx?id=170048",""],[5425,"شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ","https://www.poetsgate.com/ViewPoem.aspx?id=207511",""]],"verses":[["بِالثَنيِ تَضرِبُ عَنهُ الناسَ شُرطَتُهُ","كَاللَيثِ تَحتَ ظِلالِ الغابَةِ الضَرِمِ",0,"م",1,0],["بِالثَنيِ مِن مَلِكانِ غَيَّرَ رَسمَها","مَرُّ السَحابِ المُعقِباتِ سَحابا",1,"ب",2,0],["بالثواني، في كؤوسي","في طقوسي، شاركيني",2,"ن",2,0],["بِالثُلاثي مِنَ المَراتِبِ واسا","كَ قَريباً مِن حَيثُ لَم تَكُ طالِبِ",3,"ب",1,0],["بالثنا أحسنت لما أحسنوا","واللهَى من شأنها فتح اللهيّ",4,"ي",1,0],["بالثَّملِ الطرف بمن ريقُه","أَسْكَر حتى أَسكر الخَمَرهْ",5,"ر",2,0],["بالثغور الصباح وَالطَرَر الليلا","ء جلبن الإِهداء وَالإِضلالا",6,"ل",2,0],["بِالثَنيِ أَسفَلَ مِن جَمّاء لَيسَ لَهُ","إِلّا بِنِيه وَإِلّا عِرسَهُ شِيَعُ",7,"ع",1,0],["بالثغر قاض قال هل لك حاجة","عندي فقلت له بحد تبسمِ",8,"م",1,1],["بِالثَنا تارة أَعلّي رُؤوسا","وَالهجا تارة أَنكس رُوسا",9,"س",2,0],["بالثلج في الصيف وفي الشتاء","يلتمس النار بلا استحياء",10,"ا",2,0],["بالثنا فاللسان فاه وقلبي","باشتعال من النوى واحتراق",11,"ق",1,0],["بَالثَلْجِ واللَّيْمونِ هَمْسَكِ أَحتَسيْ","وَأَضُمُّ دِفْأَهُ بِالظُلوعِ فَتَنْفِضُ",12,"ض",1,0]]}