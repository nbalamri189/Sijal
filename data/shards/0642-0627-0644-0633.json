{"poems":[[87,"مرت على الخفاش","https://www.aldiwan.net/poem8037.html","مجزوء الرجز"],[71,"وشادن سألته يعرب لي","https://www.aldiwan.net/poem28368.html","الرجز"],[33,"سائلا الربع بالبلي وقولا","https://www.aldiwan.net/poem41839.html","الخفيف"],[33,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19030&r=&rc=293",""],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[325,"قال سعد الدين يكفيني الرضا","https://www.aldiwan.net/poem67193.html","الرمل"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[463,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[505,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202072","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46518","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46519","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141306","الرمل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20387","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27255","الرمل"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111702","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94139","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118771","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206143","السريع"],[3826,"","https://poetry.dctabudhabi.ae/diwan/poem/84994","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111459","الخفيف"],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""],[5409,"قال شيخ لو أن عصر شبابي","https://www.poetsgate.com/ViewPoem.aspx?id=155275",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""],[6023,"مَذْ قمر السّنَةِ والعرس بدا","https://www.poetsgate.com/ViewPoem.aspx?id=123858",""],[6102,"فواتير","https://www.poetsgate.com/ViewPoem.aspx?id=184556",""]],"verses":[["قالَ سَأَلتِ فيهِ","أَصدَقَ واصِفيهِ",0,"ه",1,0],["قالَ سَبَتْ ملاحتي عقولَكم","فعلٌ وفاعلٌ ومفعولٌ بهِ",1,"ه",1,0],["قالَ ساروا بِأَجمَعٍ فَاِستَقَلّوا","وَبِرُغمي لَوِ اِستَطَعتَ سَبيلا",2,"ل",2,0],["قَالَ: سارُوا بِأَجْمعٍ، فَکسْتَقَلُّوا،","وبرغمي، لو استطعتُ سبيلا",3,"ل",2,0],["قالَ سوفَ تغلو بِمدح علاهُ","قُلت علّي أوفي به وعساني",4,"ن",2,0],["قالَ سَعدُ الدينِ يَكفيني الرِضا","أَن أَرى لِلدينِ سَعداً طالِعا",5,"ع",2,1],["قال سمعاً اذن سيآتي غريبٌ","في غدٍ فاقتلوه نحراً وصلبا",6,"ب",2,0],["قال سَفاهٌ ذكرُ ما قد مضى","وظَنَّ أنَّ اللومَ تأديبُ",7,"ب",1,0],["قال سعدٌ لما رأى فيضَ جفني","ليتَ شعري ما حدثته البروق",8,"ق",1,0],["قال ساقيهمْ خُذِ الكأَسَ ومُتْ","رَشقوا فوقَ التُّرابِ الحَبَبَا",9,"ب",2,0],["قالَ سَمعت أَن ثُعباناً جَرى","مِن كَثرَةِ البَرد الشَديدِ سَكِرا",10,"ر",2,0],["قالَ سَلاهُ هَلْ سَلا لمَّا رَحَلْ","واسْتَخْبِرَا عَمَّا بِهِ الدَّهْرُ فعلْ",11,"ل",1,1],["قالَ سَلام يا أَبا زِياد","وَبِالوِداد تخدَع الأَعادي",12,"ي",1,0],["قالَ سَمعتُ أن ذئباً أَبصرا","غَزالة ترضع خَشفاً أَحوَرَا",13,"ر",2,1],["قالَ سَمعت أن طاووساً سَعى","في طَلَب القوت المشوم فرعى",14,"ع",2,1],["قال سمعاً إننّي جدت على","قلبك المضنى بأمرٍ مفرد",15,"د",1,0],["قالَ سيروا إِنَّ السُرى نُهزَةُ الأَك","ياسِ وَالغَزوَ لَيسَ بِالتَمهيدِ",16,"د",1,0],["قال سجني قال مت واعلمن","أنّ في السجنِ بلوغَ الأمل",17,"ل",1,0],["قال سلطانُ حبّه","أنا لا أقبلُ الرشا",18,"ش",2,1],["قال سفير الحظ في تاريخه","بلغ عباس به مناه",19,"ه",1,0],["قال سعيد الحنبليّ الكرمي","وفّقه الله لنشر العلمِ",20,"م",1,1],["قال سبحانك يا مولى الموالي","وتعاليت ولسنا نعتلي",21,"ي",1,0],["قال سَيُوفي زائرًا في غد","يا لغد كيف غدٌ يشرق",22,"ق",1,0],["قال سعدٌ لذا الإمامِ وسعدٌ","في الذي قالَهُ حقيقٌ ظَلُومُ",23,"م",1,1],["قالَ سَرفِيدُونٌ ومَيَّزَهُ الغَي","ظُ نَعم بالحَديثِ قَد أَنبأُ وني",24,"ن",2,0],["قال سمعاً سيدي فلقد","آن لي الإصحار عن شيمي",25,"م",2,0],["قالَ ساقي العيسِ لما نزلوا","ما نرى عندكَ من سُقيا ورَيْ",26,"ي",1,0],["قال سمعاً بني إن بلائي","كله من إطاعتي لضميري",27,"ر",2,0],["قال سمْعي كان يا ما كان شاعر هو سمين","عاشق(ن)اكل المهلب والمهلب في برادي",28,"د",2,0],["قال سعود الدّهر تاريخهما","قران سعدٍ قدره مُجّدا",29,"د",2,0],["قالَ : ( سَدِّدْ مُقَدَّمًا ؛ ثُمَّ عارِضْ","وَ إِذا شِئتَ فالتَجِئْ لِلقَضاءِ",30,"ا",2,0]]}