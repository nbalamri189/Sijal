{"poems":[[85,"مرت على الخفاش","https://www.aldiwan.net/poem8037.html","مجزوء الرجز"],[69,"وشادن سألته يعرب لي","https://www.aldiwan.net/poem28368.html","الرجز"],[31,"سائلا الربع بالبلي وقولا","https://www.aldiwan.net/poem41839.html","الخفيف"],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19030&r=&rc=293",""],[306,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[321,"قال سعد الدين يكفيني الرضا","https://www.aldiwan.net/poem67193.html","الرمل"],[454,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[459,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[465,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[501,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"]],"verses":[["قالَ سَأَلتِ فيهِ","أَصدَقَ واصِفيهِ",0,"ه",1,0],["قالَ سَبَتْ ملاحتي عقولَكم","فعلٌ وفاعلٌ ومفعولٌ بهِ",1,"ه",1,0],["قالَ ساروا بِأَجمَعٍ فَاِستَقَلّوا","وَبِرُغمي لَوِ اِستَطَعتَ سَبيلا",2,"ل",2,0],["قَالَ: سارُوا بِأَجْمعٍ، فَکسْتَقَلُّوا،","وبرغمي، لو استطعتُ سبيلا",3,"ل",2,0],["قالَ سوفَ تغلو بِمدح علاهُ","قُلت علّي أوفي به وعساني",4,"ن",2,0],["قالَ سَعدُ الدينِ يَكفيني الرِضا","أَن أَرى لِلدينِ سَعداً طالِعا",5,"ع",2,1],["قال سمعاً اذن سيآتي غريبٌ","في غدٍ فاقتلوه نحراً وصلبا",6,"ب",2,0],["قال سَفاهٌ ذكرُ ما قد مضى","وظَنَّ أنَّ اللومَ تأديبُ",7,"ب",1,0],["قال سعدٌ لما رأى فيضَ جفني","ليتَ شعري ما حدثته البروق",8,"ق",1,0],["قال ساقيهمْ خُذِ الكأَسَ ومُتْ","رَشقوا فوقَ التُّرابِ الحَبَبَا",9,"ب",2,0]]}