{"poems":[[53,"يظلم الناس يعلم الله أفرى","https://www.aldiwan.net/poem62879.html","الخفيف"],[93,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[107,"طاف بالقوم يحيي المؤمنين","https://www.aldiwan.net/poem43102.html","الرمل"],[107,"مت لتحيا ولا تردها حياة","https://www.aldiwan.net/poem43410.html","الخفيف"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[92,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[164,"ليتهم كانوا يهودا","https://www.aldiwan.net/poem59208.html","مجزوء الرمل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58369","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89056","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114534","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83202","الرجز"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139286","الرمل"],[3591,"حسنات الفقير عند نبي الدّن","https://www.poetsgate.com/ViewPoem.aspx?id=149471",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""]],"verses":[["شرُّ ماءٍ صراه في شر صُلب","شرُّ فحلٍ قراه في شرِّ مَقْرَى",0,"ر",2,0],["شَرٌّ مِنَ الخَصمِ اللَدودِ عَلى الفَتى","الصاحِبُ المُتَذَبذِبُ الخُوّارُ",1,"ر",1,0],["شَرُّ مَعبودٍ تَرَدّى حَولَهُ","مِن بَني فِرعَونَ شَرُّ العابِدينْ",2,"ن",1,0],["شَرُّ ما تَجلِبُ الخُطوبُ عَلَيهِ","أَن يَرى شَعبَهُ الأَمينَ مَروعا",3,"ع",2,0],["شرُّ ما تُبتلى به نفسُ حرٍّ","غربةُ الحرِّ، وهْو في الأوطان",4,"ن",1,0],["شَرٌّ من الأمَلِ المكذوبِ بارقُه","ان تحمِلَ الهمَّ والتأميلَ والهَلَعَا",5,"ع",2,0],["شر ما اعتاض من اع","تاض من الجنة نارا",6,"ر",2,0],["شَرْمٌ كُفِينا الشَّرَّ فيه ومن يَجُزْ","حَدَّ الصِّراطِ مُبَشَّرٌ بالجَنَّةِ",7,"ه",1,0],["شَرماحٌ لِشَرِّمَاحِ مِصر","متى جاءَتْ بِخَيْرٍ فَهْوَ بِدْعُ",8,"ع",1,0],["شرمي أفندي عز من","يعزى إلى شرمي أفندي",9,"د",2,0],["شرٌّ مكاناً من عمٍ","وأضلُّ سبلاً بالحقيقه",10,"ق",2,0],["شَرٌّ مِن المُكاشِحِ","مَن زانَ لي قَبائِحي",11,"ي",1,0],["شر ما يأتي الفتى","مدحه لو فطنا",12,"ن",2,0],["شرّ ما نغّص المكارم أن يق","صد مجدٍ مجداه بالإذلال",13,"ل",1,0],["شر ما يقتل العروبة أوثان","...نربي طغيانها في المهود",14,"د",1,0]]}