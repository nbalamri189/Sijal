{"poems":[[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[83,"كابن نصر تراه في الحرب ليثا","https://www.aldiwan.net/poem54329.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"إنفاق أيام الحياة على","https://www.aldiwan.net/poem64031.html","أحذ الكامل"],[51,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[45,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"إن الأمير أبا علي أصبحت","https://www.aldiwan.net/poem65628.html","الكامل"],[66,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[48,"نفس لا ترجعي عن الآثام","https://www.aldiwan.net/poem66607.html","الخفيف"],[46,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[76,"كآبة الذل في كتابي","https://www.aldiwan.net/poem39485.html","مخلع البسيط"],[76,"ما أقرب اليأس من رجائي","https://www.aldiwan.net/poem39504.html","مخلع البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[45,"لأخي الحُبّ عَبرَةٌ ما تَجِفُّ","https://www.poetsgate.com/ViewPoem.aspx?id=32543",""],[45,"لا يَرِمْ رَبْعَكَ السّحابُ يَجُودُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31418",""],[122,"خوفي على العرب من قوم تضللهم","https://www.aldiwan.net/poem23794.html","البسيط"],[179,"كأبواء منت نفسها البرء بعدما","https://www.aldiwan.net/poem58806.html","الطويل"],[195,"صديان يغلي في حشاه المرجل","https://www.aldiwan.net/poem39876.html","الكامل"],[233,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[257,"أفدي الذي فتن العقول بحسنه","https://www.aldiwan.net/poem35553.html","الكامل"],[259,"كل من جد ساعيا في معاليه","https://www.aldiwan.net/poem38107.html","الخفيف"],[268,"هذا البنفسج فيه قد لمع الندى","https://www.aldiwan.net/poem35297.html","الكامل"],[296,"ومعهد بأس زرت والليل دامس","https://www.aldiwan.net/poem36255.html","عموديه"],[347,"يعن لطالب الدنيا ثلاث","https://www.aldiwan.net/poem15943.html","الوافر"],[369,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[400,"لقد سار الإِمام أبو المعالي","https://www.aldiwan.net/poem33478.html","الوافر"],[413,"بوخز القنا والمرهفات البواتر","https://www.aldiwan.net/poem54013.html","الطويل"],[413,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[426,"يهنيك يا ذا المجد والافضال","https://www.aldiwan.net/poem40999.html","الكامل"],[456,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[456,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[462,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[468,"كآبائنا كنا وكل أرومة","https://www.aldiwan.net/poem4753.html","الطويل"],[477,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[560,"أفراقا حسبتها أم لقاء","https://www.aldiwan.net/poem52986.html","الخفيف"]],"verses":[["كَابَدَا فِي الحَيَاةِ مَا كَابَدَِاهُ","وَاسْتَقَرَّا يُدْنِيهِمَا الرَّمْسَانِ",0,"ن",1,0],["كَابْن نصرٍ تراه في الحرب ليثاً","وهو بدر الندى وغيث السماح",1,"ح",1,1],["كأبي القاسم الذي كلُّ ما يم","لكُ للمعتفينَ والخُلطاءِ",2,"ا",2,0],["كأبي سهلٍ المُسَهِّلِ مأتَى","كلِّ عُرْفٍ وفاتحِ الأبوابِ",3,"ب",1,0],["كابن عمارٍ الذي تركتْهُ","حَمَقَاتُ الزمان كالمُرتابِ",3,"ب",1,0],["كابن الوزير فإنه رَجلٌ","لا يُستقلُّ بأن يُرَى شُكْرُ",4,"ر",1,0],["كأبي المهند إنه","كيقينِ راجيه وحدسه",5,"س",2,0],["كابَدَتهُ الأُمورُ فيها فَلاقَت","قُلَّبِيَّ التَصويبِ وَالتَصعيدِ",6,"د",1,0],["كَأَبي الصَقرِ حينَ أَشياخُ بَكرٍ","فارِطوهُ إِلى العُلا وَوُفودُه",7,"د",2,0],["كِاِبنِ بَدرٍ وَأَينَ ثانٍ فَنَثي","إِصبَعاً بِاِعتِقادِهِ لِاِبنِ بَدرِ",8,"ر",1,0],["كَأَبي الفَضلِ حينَ يَتَّسِعُ الإِف","ضالُ مِنهُ في الطالِبينَ وَيَضفو",9,"ف",2,0],["كَأَبي نُمَيرٍ إِذ تَتابَعَ غُيُّهُ","وَغَلا بِهِ مِن فَرطِ بَغيٍ ما غَلا",10,"ل",2,0],["كا بَدتُ هَولَ السُرى في البيدِ مُكتَسِباً","مالاً وَما كُنتُ أَبغي المالَ لَولاكِ",11,"ك",1,0],["كَاِبنِ قَفرٍ أَصابَ غَيثاً خَلاءً","جادَهُ صَوبُ وابِلٍ وَسَمِيُّ",12,"ي",1,0],["كابنِ خردادَ إذ بدا يتثنّى","أوحديُّ الجلوسِ فَردُ القيامِ",13,"م",1,0],["كأبْوابِ الأراقِمِ مَزّقَتْها","فخَاطَتْها بأعْيُنِهَا الجَرَادُ",14,"د",1,0],["كآبَةُ الذُّلِّ في كتابي","وَنَخْوَةُ الْعزِّ في جَوابي",15,"ب",2,1],["كآبَةُ الذُّلِّ في كِتابي","وَنَخْوَةُ العِزَّ في الجَوَاءِ",16,"ا",2,0],["كابدتُ فيه كُلوحَ الليل والغسقا","حتى رأَيتُ ضياء للدجى خرقا",17,"ق",2,0],["كآبةٌ تحجبُ أُفقَ الحياهْ","سحابةً تخنقُ ضوءَ القمرْ",18,"ر",1,0],["كابن الوليد موئل الاعلام","سيف الاله أسد الإسلام",19,"م",1,0],["كابدت دربها الى العودة الجذلى","وأدمت شوط الصراع الشريف",20,"ف",1,0],["كأبي الفَضْلِ حينَ يَتّسعُ الإفْ","ضَالُ فيه في الطّالبينَ، وَيَضْفُو",21,"ف",2,0],["كأبي الصّقْرِ حينَ أشياخُ بَكْرٍ","فَارَطُوهُ إلى العُلَى، وَوُفُودُهْ",22,"د",2,0],["كإبن خاقان في عهد مضى وقضى","وكابن برمك فافهمني ولاتهم",23,"م",1,0],["كَأَبوَاءَ مَنَّت نَفسَها البُرءَ بَعدَما","حَسَت مِن فُضُولِ الغُدرِ نَقعَ الهَمائِمِ",24,"م",1,1],["كابن الملوح لا يفرّ قراره","أبدا إلى ليلى يحنّ ويسال",25,"ل",1,0],["كَاِبتِسامِ الرَوضَةِ الغَن","ناءِ عَن نورِ الأَقاحي",26,"ح",2,0],["كابدت فيه من الجوى ما لم يدع","أرباً لقلبي في هويّ هيامِ",27,"م",1,0],["كأبي مصطفى محمد الندب","الأجل ابن قاسم الحموي",28,"ي",1,0],["كأبي نؤاسٍ والوليدِ ومُسلِمٍ","محبوبُها وبهم تشبَّهَ واقتدى",29,"د",2,0],["كآبةُ حزنٍ تشعر النفسَ وحشةً","وَتملأُها رعباً وَتفقدها العزما",30,"م",2,0],["كَآبَةُ خائِبٍ وَعَناءُ ساعٍ","وَحَسرَةُ خاسِرٍ ما في اليَدَينِ",31,"ن",1,0],["كَأَبي الخَصيبِ وأنتَ مَرزوقٌ بِه","تَدعوهُ عِندَ ندائِه مَرزوقا",32,"ق",2,0],["كإبراهيم تلميذ القشاشي","كذلك شيخه بحر اللآلي",33,"ل",2,0],["كابرُ يعطون الرئاسة حقَّها","ومعروفهم يُسدى لبَرٍّ وفاجر",34,"ر",1,0],["كأبي القدر المعلى والهدى","والندى والعلم مرفوع الذُّرا",35,"ر",2,0],["كابيه جاء وليس بدعا كونه","متشبها بأبيه في الأحوال",36,"ل",1,0],["كأبي طالبَ طود من كثيبٍ","فرَعَ الأصلَ وشمس من هلالِ",37,"ل",1,0],["كابراً عن كابرٍ يبتدر ال","مجدَ منهم مُقبلٌ بعد مُوَلّْ",38,"ل",1,0],["كابن حمّادٍ ولا مِثلَ له","هل تَرى للبدر فرداً من ضِريبِ",39,"ب",1,0],["كابن الظهير ظهيراً عند حادثة","تعرو وكهفاً لمزرود من الزمن",40,"ن",1,0],["كَآبائِنا كُنّا وَكُلُّ أَرومَةٍ","عَلى أَصلِها ما تَنبُتَنَّ فُروعُها",41,"ه",2,1],["كابن خلدون وكم","مثله في العلما",42,"م",2,0],["كَأَبيها وشيخنا ابن الشرابيْ","يِ الذي صحَّ أنَّ فيهِ الشِفاءَ",43,"ا",2,0]]}