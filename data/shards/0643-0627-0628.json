6","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62898","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86258","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138518",""],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104858","المتقارب"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66490","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118765","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117947","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117984","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34668","المنسرح"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44914","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76721","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120530","الكامل"],[4691,"أمطرها وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=105403",""],[4691,"طفلة اسمها (ليان)","https://www.poetsgate.com/ViewPoem.aspx?id=114274",""],[4740,"قصة بلا أبطال","https://www.poetsgate.com/ViewPoem.aspx?id=198271",""],[4755,"إلة المعتقل إبراهيم الحمادي","https://www.poetsgate.com/ViewPoem.aspx?id=183557",""],[5026,"فراشة سكرى","https://www.poetsgate.com/ViewPoem.aspx?id=210477",""],[5183,"معنى الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=186497",""],[5183,"الهمة الوثابة","https://www.poetsgate.com/ViewPoem.aspx?id=185637",""],[5273,"حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=28767",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5703,"قمرٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=211788",""],[5776,"عامُ الأبابيلِ اليمانية...","https://www.poetsgate.com/ViewPoem.aspx?id=203647",""],[402,"يا ابن لبنان عد إلى لبنان ط","https://www.poetsgate.com/ViewPoem.aspx?id=36536",""],[5804,"العربيّ المحطّم","https://www.poetsgate.com/ViewPoem.aspx?id=190682",""],[5956,"طول عمري وجهادي لم أشاهدْ","https://www.poetsgate.com/ViewPoem.aspx?id=193357",""],[5956,"أوعى لواء","https://www.poetsgate.com/ViewPoem.aspx?id=214092",""],[5969,"طفقنا من تراتيل الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=199265",""],[463,"لكِ الغرامُ وللواشي بكِ التعبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59983&r=&rc=39",""],[6250,"بأبي من زارني مُكتَتِماً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14626&r=&rc=1",""],[572,"كَابَدَني دَهْرِيَ في طُرَّتِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9262&r=&rc=119",""]],"verses":[["كَابَدَا فِي الحَيَاةِ مَا كَابَدَِاهُ","وَاسْتَقَرَّا يُدْنِيهِمَا الرَّمْسَانِ",0,"ن",1,0],["كَابْن نصرٍ تراه في الحرب ليثاً","وهو بدر الندى وغيث السماح",1,"ح",1,1],["كأبي القاسم الذي كلُّ ما يم","لكُ للمعتفينَ والخُلطاءِ",2,"ا",2,0],["كأبي سهلٍ المُسَهِّلِ مأتَى","كلِّ عُرْفٍ وفاتحِ الأبوابِ",3,"ب",1,0],["كابن عمارٍ الذي تركتْهُ","حَمَقَاتُ الزمان كالمُرتابِ",3,"ب",1,0],["كابن الوزير فإنه رَجلٌ","لا يُستقلُّ بأن يُرَى شُكْرُ",4,"ر",1,0],["كأبي المهند إنه","كيقينِ راجيه وحدسه",5,"س",2,0],["كابَدَتهُ الأُمورُ فيها فَلاقَت","قُلَّبِيَّ التَصويبِ وَالتَصعيدِ",6,"د",1,0],["كَأَبي الصَقرِ حينَ أَشياخُ بَكرٍ","فارِطوهُ إِلى العُلا وَوُفودُه",7,"د",2,0],["كِاِبنِ بَدرٍ وَأَينَ ثانٍ فَنَثي","إِصبَعاً بِاِعتِقادِهِ لِاِبنِ بَدرِ",8,"ر",1,0],["كَأَبي الفَضلِ حينَ يَتَّسِعُ الإِف","ضالُ مِنهُ في الطالِبينَ وَيَضفو",9,"ف",2,0],["كَأَبي نُمَيرٍ إِذ تَتابَعَ غُيُّهُ","وَغَلا بِهِ مِن فَرطِ بَغيٍ ما غَلا",10,"ل",2,0],["كا بَدتُ هَولَ السُرى في البيدِ مُكتَسِباً","مالاً وَما كُنتُ أَبغي المالَ لَولاكِ",11,"ك",1,0],["كَاِبنِ قَفرٍ أَصابَ غَيثاً خَلاءً","جادَهُ صَوبُ وابِلٍ وَسَمِيُّ",12,"ي",1,0],["كابنِ خردادَ إذ بدا يتثنّى","أوحديُّ الجلوسِ فَردُ القيامِ",13,"م",1,0],["كأبْوابِ الأراقِمِ مَزّقَتْها","فخَاطَتْها بأعْيُنِهَا الجَرَادُ",14,"د",1,0],["كآبَةُ الذُّلِّ في كتابي","وَنَخْوَةُ الْعزِّ في جَوابي",15,"ب",2,1],["كآبَةُ الذُّلِّ في كِتابي","وَنَخْوَةُ العِزَّ في الجَوَاءِ",16,"ا",2,0],["كابدتُ فيه كُلوحَ الليل والغسقا","حتى رأَيتُ ضياء للدجى خرقا",17,"ق",2,0],["كآبةٌ تحجبُ أُفقَ الحياهْ","سحابةً تخنقُ ضوءَ القمرْ",18,"ر",1,0],["كابن الوليد موئل الاعلام","سيف الاله أسد الإسلام",19,"م",1,0],["كابدت دربها الى العودة الجذلى","وأدمت شوط الصراع الشريف",20,"ف",1,0],["كأبي الفَضْلِ حينَ يَتّسعُ الإفْ","ضَالُ فيه في الطّالبينَ، وَيَضْفُو",21,"ف",2,0],["كأبي الصّقْرِ حينَ أشياخُ بَكْرٍ","فَارَطُوهُ إلى العُلَى، وَوُفُودُهْ",22,"د",2,0],["كإبن خاقان في عهد مضى وقضى","وكابن برمك فافهمني ولاتهم",23,"م",1,0],["كَأَبوَاءَ مَنَّت نَفسَها البُرءَ بَعدَما","حَسَت مِن فُضُولِ الغُدرِ نَقعَ الهَمائِمِ",24,"م",1,1],["كابن الملوح لا يفرّ قراره","أبدا إلى ليلى يحنّ ويسال",25,"ل",1,0],["كَاِبتِسامِ الرَوضَةِ الغَن","ناءِ عَن نورِ الأَقاحي",26,"ح",2,0],["كابدت فيه من الجوى ما لم يدع","أرباً لقلبي في هويّ هيامِ",27,"م",1,0],["كأبي مصطفى محمد الندب","الأجل ابن قاسم الحموي",28,"ي",1,0],["كأبي نؤاسٍ والوليدِ ومُسلِمٍ","محبوبُها وبهم تشبَّهَ واقتدى",29,"د",2,0],["كآبةُ حزنٍ تشعر النفسَ وحشةً","وَتملأُها رعباً وَتفقدها العزما",30,"م",2,0],["كَآبَةُ خائِبٍ وَعَناءُ ساعٍ","وَحَسرَةُ خاسِرٍ ما في اليَدَينِ",31,"ن",1,0],["كَأَبي الخَصيبِ وأنتَ مَرزوقٌ بِه","تَدعوهُ عِندَ ندائِه مَرزوقا",32,"ق",2,0],["كإبراهيم تلميذ القشاشي","كذلك شيخه بحر اللآلي",33,"ل",2,0],["كابرُ يعطون الرئاسة حقَّها","ومعروفهم يُسدى لبَرٍّ وفاجر",34,"ر",1,0],["كأبي القدر المعلى والهدى","والندى والعلم مرفوع الذُّرا",35,"ر",2,0],["كابيه جاء وليس بدعا كونه","متشبها بأبيه في الأحوال",36,"ل",1,0],["كأبي طالبَ طود من كثيبٍ","فرَعَ الأصلَ وشمس من هلالِ",37,"ل",1,0],["كابراً عن كابرٍ يبتدر ال","مجدَ منهم مُقبلٌ بعد مُوَلّْ",38,"ل",1,0],["كابن حمّادٍ ولا مِثلَ له","هل تَرى للبدر فرداً من ضِريبِ",39,"ب",1,0],["كابن الظهير ظهيراً عند حادثة","تعرو وكهفاً لمزرود من الزمن",40,"ن",1,0],["كَآبائِنا كُنّا وَكُلُّ أَرومَةٍ","عَلى أَصلِها ما تَنبُتَنَّ فُروعُها",41,"ه",2,1],["كابن خلدون وكم","مثله في العلما",42,"م",2,0],["كَأَبيها وشيخنا ابن الشرابيْ","يِ الذي صحَّ أنَّ فيهِ الشِفاءَ",43,"ا",2,0],["كأب شفيق ليس يهدأ قبلما","لبنيه تصفو بالسعادة اكؤس",44,"س",1,0],["كأبت على رمد ألم بضيفنا","منا القلوب وحقها أن تكتئب",45,"ب",1,0],["كابدت بل ضحيت فيه مجاهدا","فغدا لك الشرف الأثم الاعظم",46,"م",1,0],["كابرت عدل صبوتي","في الدمع حين تحدرا",47,"ر",2,1],["كأبيه لا يقبل الضيم والاذ","لال بالرغم من حسود وخصم",48,"م",1,0],["كَأبيك القامع للأممِ","وَالفاتح قَبلك للحرمِ",49,"م",1,0],["كَأبيه ذي الرَأي السَديدْ","رَب الشَهامة في الأُمورْ",50,"ر",1,0],["كآبةُ الكِذْب في مَدِيحي","ورَوْنَقُ الصِّدْقِ في هِجَائِي",51,"ي",1,0],["كابروا في مداك أم أكبروه","وأبوا ما صنعت أم تبعوه",52,"و",2,1],["كابدت بينكمُ وجد الغريب وما","فارقت أهلي ولا هاجرت لي وطنا",53,"ن",2,0],["كأبن آوى يعوي","ورايء وكالكلب ينبحُ",54,"ح",1,0],["كابرتَ إذ أعيتكَ قسوتُها","كمْ أرهَقتكَ وأنتَ لا تُرهَقْ",55,"ق",1,0],["كابدت فيه عظيم همَّ مؤلم","ورجعت فيه إلى فؤاد موجع",56,"ع",1,0],["كابَرْتَ أَهْلَ الجاهِ وَالأَحْزامِ","بِأَعْبُدٍ عَبَّدْتَهُمْ لِئَامِ",57,"م",1,0],["كابَرَ أَوْ سَرَّحَ عَنْهُ لَهْجَمُهْ","وَمَدَّهُ دَفّاعُ سَيْلٍ يَطْحَمُهْ",58,"م",2,0],["كابدتُ في الدهر أنواع الخطوب وقد","غدوت من شدة الأهوال كالعدمِ",59,"م",1,0],["كابدت ضرباً وسباً وسبا","والردى فرقها أيدي سبا",60,"ب",2,0],["كأبي المعالي طابَ أصلُ جدوده","وَصفت خلائقه وفاض نوالُهُ",61,"ل",2,0],["كأَبيه حلمُه من هُضبِها","فالورى في شرقِها أو غربِها",62,"ه",2,0],["كأَبي الهادي ذي الفضل ومَن","في معاليه لهم كان قسيما",63,"م",2,0],["كابَدتُهُ بِاللَيلِ أَعسِفُهُ","في ظُلمَةٍ بِسَواهِمٍ حُدبِ",64,"ب",1,0],["كابي الرَمادِ عَظيمُ القِدرِ جَفنَتُهُ","عِندَ الشِتاءِ كَحَوضِ المَنهَلِ اللَقِفِ",65,"ف",1,0],["كابت الحاسدين عليك اعتزازي","وابتهاجا نما بطول بقاء",66,"ا",2,0],["كابدت من أبناء دهري شدة","هي فوق ما كابدت من إملاقي",67,"ق",2,1],["كآبةً وجوىً من ميِّ نامية","لصادقِ الحبِّ صَبٍّ غير أفَّاكِ",68,"ك",1,0],["كابدت من لأوائها الجهد الذي","أعي على الأفكار والأفهام",69,"م",1,1],["كابدت من إخوان دهري شدة","هي فوق ما كابدت من إملاق",70,"ق",1,0],["كَأَبيه يَرفد مَن أَتى مسترفداً","وَيشد عَزمة مَن أَتاه مُضاما",71,"م",2,0],["كابدتها عرباً وروماً ليتَني","إذا جزتُ صعبَ صراطها لا أطرَدُ",72,"د",1,0],["كابروا فيه وقالوا","إننا نحن الأكابر",73,"ر",1,0],["كَآبَةَ الْفاقِدِ الْحَبيبِ قَريبا","بِدُموعٍ تَصُبُّ صَبَّ الْعِهادِ",74,"د",1,0],["كابن الرفاعى وزين الدين سيدهم","عنيت كيلانهم أي قطب غوثهم",75,"م",1,0],["كَابَدتُ مِن ضُرِّهِ مَا لَو أنَاخَ على","رَضوى لأصبحَ مِنهُ وَهوَ أشطارُ",76,"ر",1,0],["كأبيه يشنّ في كلّ آن","غارة من صروفه شَعواءِ",77,"ا",2,0],["كابنِ قاضى القُضاةِ وهو عن التَّع","ريفِ أَغنى من وابلٍ عن ذَنُوبِ",78,"ب",1,0],["كأَبى على يوم جار قَضَاؤُه","ورمى سخينةَ في عُباب الاخضَرِ",79,"ر",1,0],["كابَرَهُ حتى بَرَعْ","لا نالَ خَلْقٌ ما مَنَعْ",80,"ع",1,0],["كَاِبنِ الشَوارِبي من قَد جَل مَرتَبة","بِطالِع لاحَ في العَلياءِ مَسعودا",81,"د",2,0],["كابدت ما كابدت من أجله","إذ أرادت قتله ظلماً عداه",82,"ا",2,0],["كأبعد من كان منه ابتعادا","فجرب إذا اخترت أهل الوفاء",83,"ا",2,0],["كابنِ المُسَيِّبِ وَالعَلاءِ وَمالِكٍ","وَاللَيثِ وَالزُهريِّ أَو سُفيانِ",84,"ن",1,0],["كابدتُ هولَ السرى في البيد مكتسباً","جاهاً لعلّي به أحظى بلقياكِ",85,"ك",1,0],["كابن عونٍ وأين مَن كابن عونٍ","شرفاً باذخاً وعلماً وجاها",86,"ا",3,0],["كابن عيسى المهاجر الملتقي","عن أبيه العلوم والأسرارا",87,"ر",2,0],["كابدت من ألم النوى وضنى الهوى","غصصاً ضعفت لها وشاب المفرق",88,"ق",1,0],["كابن زين إذا انتمى علويّ","لُذ به تغن عن سواه وتغنم",89,"م",1,0],["كابرنيكَ الزمان يا حسن","فخاب سهمي وأفلح الزمن",90,"ن",1,1],["كابَدتُ فيكَ مِن الشَقاءِ أَمرَّهُ","وَلَقيتُ مِن جَرّاءِ مَدحِكَ كُلَّ ذَمْ",91,"م",1,0],["كابد الى العزّ الهجير ولا تكن","في الذل ما بين الضلال معّرسا",92,"س",2,0],["كابدت من زمني كوارث جمة","وامرها في مرها ثنتان",93,"ن",1,1],["كابتسامٍ يهلّ بردا علينا","يطفئُ اللومَ بعدما صار نارا",94,"ر",2,0],["كابتسام ٍ يلوّن الوقت ودّا","وكغيث ٍ يهلّ في الوجدان ِ",95,"ن",1,0],["كَآبَةُ قَلْبِي تَمْتَطِي صَهْوَةَ الشِّعْرِ","لِتُلْهِبَ نِيرَانَ الحَشَا .. قَبْضَةُ الأَسْرِ",96,"ر",1,1],["كَابَرْتَنِي .. ورَحَلتَ مُنتَعِلاً","قَلبِي الذي كَم رَامَ مِنكَ يَدَا",97,"د",2,0],["كابُوسُ فَلْسَفَتي يُخنِّقُ فِكْرتي","والعينُ تَلهَثُ في الجُفونِ لكي تَرى",98,"ر",2,0],["( كأبي سرور ) من لمست به","معنى الوفاء ومن هو اللب",99,"ب",1,0],["كأبي الهول وإهراماته","لم تزل تطوي الليالي حُقُبا",100,"ب",2,0],["كابرتُ إلا أنني لم أستطعْ","فشربتُ خمرَ حروفِها حتى الثمَلْ",101,"ل",1,0],["كابتهاج الشمس في رَأدِ الضُّحَى","في نهار الأَمَلِ المنتظَرِ",102,"ر",1,0],["كابدتُ منكَ من الشجونِ تِلالا","من بعدما نجم الغرامِ تَلالا",103,"ل",2,1],["كأبرهةٍ كانوا وأفيالُهم سدى","وكنّا أبابيلاً جحيمًا يمانيا",104,"ي",2,0],["كابدا في الحياة ما كابداه","واستقرا بدنيهما الرمسان",105,"ن",1,0],["كابولُ او بغدادُ او صوماليا","وتحكّموا في أكثرِ الأنحاءِ",106,"ا",2,0],["كأبيه وارثُ النبل جميعاً","(ليس دوماً يطلعُ النجل كوالدْ)",107,"د",1,0],["كأبيه عاش محرِّراً أوطانه","من جهلها ويحطم الأنصابا...",108,"ب",2,0],["كأبيه قاهرُ كل حكمٍ خائنٍ","ويُعاقب الزنديق والكذابا..",108,"ب",2,0],["كآبَةُ مَنْ بِهِ فَقدُ الأَماني","تَوجُسُ مَنْ تَعلّقَ بالكَئيبِ",109,"ب",1,0],["كابها نتسمى قبلَ غدركمُ","فاليومَ كلُّ اسم ودً بيننا لقبُ",110,"ب",1,0],["كابَدَ الأهوالَ في زَوْرَتِهِ","ثمَّ ما سلّمَ حتى ودّعا",111,"ع",2,0],["كَابَدَني دَهْرِيَ في طُرَّتِي","بِشَيْبَة ٍ أَلبَسَتْنِي عَارَهَا",112,"ر",3,1]]}