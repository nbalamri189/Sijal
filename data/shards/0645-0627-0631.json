gate.com/ViewPoem.aspx?id=10032",""],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[45,"عَادَ للصّبّ شَجْوُهُ وَاكْتِئَابُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31581",""],[91,"يا جنتي","https://www.poetsgate.com/ViewPoem.aspx?id=53151",""],[51,"ما راح مغبونا بصفقة خاسر","https://www.poetsgate.com/ViewPoem.aspx?id=30670",""],[51,"منظر فاتن وتُحجَب عنّا","https://www.poetsgate.com/ViewPoem.aspx?id=29205",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[51,"إن تَطُل لحية ٌ عليك وتعرض","https://www.poetsgate.com/ViewPoem.aspx?id=28702",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""],[31,"لِمَنْ الدّارُ كَخَطٍّ بِکلقَلَمْ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19046&r=&rc=309",""],[68,"أوَميضُ بَرْقٍ، بالأُبَيرِقِ، لاحا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15400&r=&rc=6",""]],"verses":[["ما رَأَت عَينِيَ مُذ فارَقتُكُم","يا نُزولَ الحَيِّ شَيئاً حَسَنا",0,"ن",2,0],["ما رابَني مِن أَبعَدي","ما رابَني مِنَ الدُنى",1,"ن",2,0],["ما رَأَينا سِلكَها مِن غَيرِكُم","جَمَعَ النَشرَ وَلا ضَمَّ النِظاما",2,"م",2,0],["ما رَأى حَيُّ نِزارٍ قَبلَها","جَبَلاً سارَ عَلى أَيدي الرِجالِ",3,"ل",1,0],["ما رَقَّعَ الواشونَ فيَّ وَلَفَّقوا","قُل لي فَإِما حاسِدٌ أَو مُشفِقُ",4,"ق",1,1],["ما رُفِّهَت رُكبانُها إِلّا وَفي","جِلدِ الظَلامِ مِنَ الضِياءِ خُروقُ",5,"ق",1,0],["ما راقَبَت غَضَبَ النَبِيِّ وَقَد غَدا","زَرعُ النَبِيِّ مَظَنَّةً لِحَصادِها",6,"د",3,0],["ما رَأَينا كَأَبيهِ ناجِلاً","وَلَدَ الناسَ جَميعاً بِوَلَد",7,"د",1,0],["ما راقَ عَينَيهِ إِلّا ما أَقَرَّهُما","مِنَ المَكارِمِ لا عَينٌ وَلاجيدُ",8,"د",1,0],["ما راعَني إِلّا حَمولَةُ أَهلِه","وَسطَ الدِيارِ تَسَفُّ حَبَّ الخِمخِمِ",9,"م",1,0],["ما رَمى الإِنسانَ في مَخمَصَةٍ","غَيرُ حُسنِ الظَنِّ وَالقَولِ الحَسَن",10,"ن",1,0],["مَا رقّعَ الْوَهْيُ الَّذِي قَدْ مَزَّقُوا","مَا حُلِّيَ الْجِيدُ الَّذِي قَدْ عَطَّلوا",11,"ل",3,0],["مَا رَوْضَةٌ ضَحِكَتْ ثُغُورُ أَقَاحِهَا","طَرَباً وَحَيَّاهَا الْحَيَا فَتَبَاكَى",12,"ك",2,0],["ما رِيءَ مِثْلُكَ في ماضٍ ومُعْتَقَدِي","أنْ لا يُرى الدّهْرُ في حالٍ وفي آتِي",13,"ي",1,0],["ما رأتْ عَيني عَجيباً","كَيراعِي في الدّواةِ",14,"ه",1,1],["ما رِيءَ مِثْليَ في الماضِي ولا الآتِي","فَريدَةً جَمَعتْ ما بَيْنَ أشْتاتِ",15,"ت",1,1],["ما رَوضَةٌ مِن رِياضِ الحَزنِ مُعشَبَةٌ","خَضراءُ جادَ عَلَيها مُسبِلٌ هَطِلُ",16,"ل",1,0],["ما رَوضَةٌ مِن رِياضِ الحَزنِ باكَرَها","بِالنَبتِ مُختلِفِ الأَلوانِ مَمطورُ",17,"ر",1,0],["ما رَماني رامٍ وَراحَ سَليماً","مِن قَديمٍ عِنايَةُ اللَهُ جُندي",18,"ي",1,0],["مَآرِبُ الكُلِّ فيهِ فَهوَ عَصا","موسى لِكُلٍّ مِنهُم إِلَيهِ وَطَر",19,"ر",1,0],["مَآرِبُ الكُلِّ فيهِ تُبصِرُهُم","إِلى لقاهُ في حُرقَةٍ وَضَجَر",19,"ر",1,0],["ما رَأَينا قَبلَ اِبتِسامِكَ بَدرَ ال","تَمِّ يَفتَرُّ عَن نُجومِ الثُرَيّا",20,"ي",2,0],["ما رَأى الناسُ قَبلَهُ بَدرَ لَيلٍ","طافَ في مَجلِسٍ بِشَمسِ نَهارِ",21,"ر",1,0],["ما رايَةٌ رُفِعَت لِأَبعَدِ غايَةٍ","إِلّا تَلَقّاها بِأَطوَلِ باعِ",22,"ع",1,0],["مَا رَأَى النَّاسُ مِثْلَ هذَا وَلاءً","عَنْهُ يَنْبُو سَيْفُ الْحِمَامِ الْفَاصِمْ",23,"م",1,0],["ما رَوضَةٌ إِلّا تَمَنَّت أَنَّها","لَكَ مَضجَعٌ وَلِخَطِّ قَبرِكَ مَوضِعُ",24,"ع",1,0],["ما راجَ مِنها فَإِنَّ اللَهَ يَسَّرَهُ","وَما تَأَخَّرَ مَحمولٌ عَلى القَدَرِ",25,"ر",1,0],["ما رَأَينا وَلا سَمِعنا بِحُشٍّ","قَبلَ هَذا لِبابِهِ إِقليدُ",26,"د",1,0],["ما رمتُ أن أجني الأَقاحَ بثغره","إلاّ وقد سلَّ السيوف من الحورْ",27,"ر",1,0],["ما رءوس الأموال إلا أداة","للمساعي كالحبل للأحمال",28,"ل",1,0],["مارس الأحوال حتى إنه","شاب في إصلاحها منه القذال",29,"ل",1,0],["ما رَدُّكُم ذا لُباناتٍ بِحاجَتِهِ","قَد فاتَ يَومَئِذٍ مِن نَفسِهِ قِطَعُ",30,"ع",1,0],["ما رحّبتهُ القائلون مدائِحاً","إلاَّ وقد شملَ الأكفَّ رغائِبا",31,"ب",2,0],["ما روضة قلدت إحياء سوسنها","من السحابِ عقودٌ لؤلؤيات",32,"ت",1,0],["ما رأينا من قبلِها غيثَ عامٍ","سبقته إلى القدوم الرَّياض",33,"ض",1,0],["ما ردّ سيف الرَّدى سيفُ ابن ذي يزن","ولا نجا تبّع في الزعف والحلق",34,"ق",1,0],["ما رأى الناس قبله قيد رمحٍ","أطلع الشمس في ظلام الليالي",35,"ل",2,0],["ما روى الناس في التواريخ قدماً","ما روَوْا للسّماح في أيامهْ",36,"م",2,0],["ما رأينا المشيب إلا كبلح","أبيض بارد قليل المقام",37,"م",1,0],["ما رأينا كريقه يبرئ الس","مّ إذا اهتزَّ وهو كالثعبان",38,"ن",1,0],["ما رأينا سِواك قِرْناً يُولِّي","وهو يُرْدي فوارس الْهيجاءِ",39,"ا",2,0],["ما رأيتُ المِراء يوجِبُ إلا","فُرقةً ما اعتمدتَ طول المراءِ",40,"ا",2,0],["ما رمتُ بالميْسُورِ مدْحُكَ مرَّةً","إلا رأيْتُ وجُوهَهُ لي سُنَّحا",41,"ح",2,0],["ما رأى العالِمون بالحظِّ حظاً","لكلا الفرقدين في إفرادِهْ",42,"د",2,0],["ما رأتها عين امرئٍ ما رآها","قطُّ إلا أهلَّ بالتكبيرِ",43,"ر",1,0],["مآرب فاته المتاع بها","إلّا افتقاد العهود بالذِّكَرِ",44,"ر",1,0],["مارستَ قِرناً باسلاً لو غدا","قِرناً له الصبر بكى الصّبر",45,"ر",1,0],["ما رآها امرؤ به طائفٌ لل","هَمِّ إلا انكفا بها مسرورا",46,"ر",2,0],["ما رَشَأ الأنس بمستأنِسِ","إلى بياض الشَعَر المُخْلسِ",47,"س",1,1],["مارست شوك القتاد مني بكفْ","فَيك فكُن في احتيال منقاش",48,"ش",1,0],["ما رأى خَلَّة المُحقِّين إلا","خَلَطَ الجُودَ عندها بامتعاض",49,"ض",1,0],["ما رعيُنا عهد كل خائنةٍ","قاسية غير ذات منعطف",50,"ف",1,0],["ما رفعَ اللَّه همةً طمحتْ","تلقاءَ غدرٍ أليَّةً قسما",51,"م",2,0],["ما رأت مثل مهرجانك عينا","أردشيرٍ ولا أنوشروانِ",52,"ن",1,0],["مارأى مثله ابنُ جُدعانَ لا بل","ما رأى مثله بنو الديَّانِ",52,"ن",1,0],["ما رأى اللَّه خناً أطلقه","لا ولا غِلَّ ضميرٍ سجنه",53,"ن",2,0],["ما راح مغبونا بصفقة خاسر","من باع متعةَ فائتٍ بأمانِ",54,"ن",1,1],["ما رأى الناسُ كابنِ هرثمةَ العا","جزِ في فرط جُبْنِهِ مِنْ شبيهِ",55,"ه",1,1],["ما رامَنا مَلِكٌ يُقيمُ قَناتَنا","إِلّا اِستَبَحنا خَيلَهُ وَرِجالَها",56,"ل",3,0],["ما رَوضَةٌ خَضراءَ أَزهَرَ نَورُها","بِالقَهرِ بَينَ شَقائِقٍ وَرِمالِ",57,"ل",1,0],["ما رَأَت مُهجَتُهُ المُنفَطِرَه","لا وَلا أَدمُعُهُ المُنحَدِرَه",58,"ر",2,0],["ما رَغِبَ الناسُ في الفَناءِ","لَكِنَّما ضاعَت الحُلومُ",59,"م",1,0],["ما راعَهُ طَيفُ المَنِيَّةِ مِثلَما","راعَت حَشاهُ فُرقَةُ الخِلّانِ",60,"ن",1,0],["ما راعَني أَنّي طُرِدتُ مِنَ السَما","أَنا قانِطٌ مِن رَحمَةِ الدَيّانِ",61,"ن",1,0],["ما رَأى الناسُ أَنَّهُ","قَطُّ دَرَّت مَكارِمُه",62,"م",2,0],["مارَأى الناسُ مِثلَهُ وَهُوَ طِفلٌ","فاضِلاً عارِفاً ظَريفاً أَديبا",63,"ب",2,0],["ما رأيت الضعاف الا طعاما","لبني عمها الغلاظ الشداد",64,"د",1,0],["ما رزء من يبكي عليه","الشعب أجمع بالخفيف",65,"ف",1,0],["مارسته الأهواء منا إلى أن","تعبت في مراسهِ الأهواء",66,"ا",2,0],["ما رأت في الناس عيني","فاضلاً مثل حسينِ",67,"ن",1,1],["ما رفَع القالة أو حطهم","إلا خيال جامد أو منيل",68,"ل",1,0],["مارستَ كل الحق هل","صادفت غير الموت حقا",69,"ق",2,0],["ما رَأى الناسُ شاعِراً","فاضِلَ الخُلقِ طَيِّبا",70,"ب",2,0],["ما رَأى الناسُ سِواهُ عَلَما","لَم يُرَم في لُجَّةٍ أَي يَبَسِ",71,"س",1,0],["ما رَأَت مِثلَ ذا الَّذي تَبتَني ال","أَقوامُ مَجداً وَلَن يَرى الأَقوامُ",72,"م",1,0],["ما رَأى في العَيشِ شَيئاً سَرَّهُ","وَأَخَفُّ العَيشِ ما ساءَ وَسَر",73,"ر",1,0],["ما رَآها مُكَذِّبُ الرُسلِ إِلّا","صَدَّقَ القَولَ في صِفاتِ البُراقِ",74,"ق",1,0],["ما رَأَينا مُعَلِّماً قَطُّ مَحجو","باً وَلَو أَنَّهُ عَلى مُلكِ كِسرى",75,"ر",2,0],["ما رَأَيتُ السُلطانَ مَيَّلَ في أَن","نَكَ ظُفرُ السُلطانِ أَغنَت وَنابُه",76,"ب",2,0],["ما راعَهُم إِلّا اِمتِراقُكَ مُصلِتاً","مِن مِثلِ بُردِ الأَرقَمِ المُنسابِ",77,"ب",1,0],["ما رَأَينا الحُسَينَ أَلغى صَواباً","مُذ شَرَكتَ الحُسَينَ في التَدبيرِ",78,"ر",1,0],["ما رَأى العائِبونَ قَولاً وَفِعلاً","غَيرَ رائي جَدوى يَدَيهِ وَشُكري",79,"ي",1,0],["مارِقاً مِن جَوانِحِ اللَيلِ يَبغي","عُصبَةً مِن حُماتِهِم مارِقينا",80,"ن",2,0],["ما رابَ رَأيٌ إِلّا جَعَلتُكَ ميزا","ناً عَلَيهِ في الحَزمِ أَمتَحِنُه",81,"ن",2,0],["ماركسيون! والجماهير تشقى","فلماذا لا يشبع الفقراء؟",82,"ا",2,0],["ما راعَ أفئدةَ الدُمى بصدودِه","عنهنَّ إلا وهو من أرَبِ الدُّمى",83,"م",2,0],["ما رأى النَّاسُ شُروباً مثلَنا","شربوا الرَّاحَ على وجهِ الأسَدْ",84,"د",1,0],["ما رُمْتُ إحصاءَ ما أوليتَض من