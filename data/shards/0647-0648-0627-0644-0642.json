ُ المَيمونُ وَالعِصمَةُ الَّتي","أَتى حَقُّها فينا عَلى كُلِّ باطِلِ",123,"ل",1,0],["هو القبس السامى السنىّ فكل ما","أضاء فمن أنواره امتدّ واستضا",124,"ض",2,0],["هو القصد لكن ذا الخلق عن","حقيقة عرفانه أبهم",125,"م",1,0],["هُوَ القَفرُ والإِرقالٌ والسَّيرُّ والدُّجَى","وتَشميرٌ ذَيلِ العَزمِ في كُلَّ مَخرَمِ",126,"م",1,0],["هو القِنديدُ والشُّهدُ المصفَّى","فلا أدَعُ امتصَاصَهُ وارتِشافه",127,"ف",2,0],["هو القرشي الهاشمي محمر","خيار خيار الخلق من عالم الذر",128,"ر",1,0],["هُوَ القَيسُ بَل لَيلاهُ وَهو بُثَينَةٌ","أَجَل بِشرُها وَالخَيفُ وَهوَ الأَجارِعُ",129,"ع",1,0],["هو القاسم السامي إلى كل مفخر","عليه لواء العلم والمجد يخفق",130,"ق",1,0],["هُوَ القَلبُ مِن لَحْمٍ طَرِيٍّ ومِن دَمٍ","ولَم يَجعَلِ الرَّحمنُ في الجَوفِ لِي زَوْجَا",131,"ج",2,0],["هو القرب والاقبال بالحب والرضى","وكشف الغطا عن كل ما كنَّه الجهل",132,"ل",1,0],["هو ( القرآن ) للعليا مُنَاها","( وطوبى للذي به قد بغاها)",133,"ا",3,1],["هو القدر الرئيس إليه تسعى","تقودك نحوه قدم وساق",134,"ق",1,0],["هو القضيبُ بسلمٍ مسقطٌ ثمراً","وفي الوغى مسقطُ البنانِ والغمَمِ",135,"م",1,0],["هو القريبُ وإن شطّتْ مفاتنه","عليه جرمُ النوى من جمرِ عاطفتي",136,"ت",2,0],["هو القطب فينا لو تزيل لاجترى","علينا العدى من كل خصم مشاقق",137,"ق",1,0],["هو القمر الوضاح من آل هاشم","بدا تحت ستر من دجى النقع مشرقا",138,"ق",2,0],["هو القائم المهدي من نور رشده","كومض بروق في ذرى الجو لمع",139,"ع",1,0],["هو القاسم المعطي شبا السيف حقه","وموفي الوغى من غير مطل ذمائما",140,"م",2,0],["هو القطب الذي دارت عليه","رحى الدين القويم بحيث دارا",141,"ر",2,0],["هو القريب كما للروح موقدها","يحيا الحشا سكناً من غير ما ألدُ",142,"د",1,0],["هو (القُدَيسيُّ) قلبٌ مسَّه مَدَدٌ","بمسقطٍ، فعلى شُطآنِها وَسِنا",143,"ن",2,0],["هُوَ القُطْبُ قُطْبُ المُلْكِ وَالمَجْدِ وَالعُلا","وَإِنْ جَمَحَ الباغُونَ فَهوَ لِجامُ",144,"م",1,0],["هو القانون نسبته إليكم","فإن لكم به باعاً طويلا",145,"ل",2,0],["هُوَ القَمَرُ الزَّاهي يَصيفُ بِمُقْلَتي","وَيَشْتو عَلى ثَغْري الشَقِيِّ وَبسْمَتي",146,"ت",2,1],["هو القصدُ الذي إن رامَ عبدٌ","عليه بالتوكّلِ لا يخيبُ",147,"ب",1,0],