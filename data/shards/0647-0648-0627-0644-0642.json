125974",""],[4978,"تشطير لنا القرآن دستورٌ","https://www.poetsgate.com/ViewPoem.aspx?id=178203",""],[4984,"القضاء","https://www.poetsgate.com/ViewPoem.aspx?id=187632",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5277,"هي..وليتها","https://www.poetsgate.com/ViewPoem.aspx?id=190793",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"هو الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=182969",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5690,"أمير المؤمنين سعى إليكم","https://www.poetsgate.com/ViewPoem.aspx?id=170623",""],[5781,"يَبابهُ وربيعي","https://www.poetsgate.com/ViewPoem.aspx?id=202855",""],[5861,"هو الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=188032",""],[5956,"فقاعة متغطرسة","https://www.poetsgate.com/ViewPoem.aspx?id=192425",""],[5969,"شِفاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=204788",""],[6152,"لا عيد بلا حب","https://www.poetsgate.com/ViewPoem.aspx?id=204817",""],[164,"هو القضا فخذ المبوسط مختصرا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607911",""],[520,"لكل مقام في علاك مقال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577597",""],[2220,"الناسُ أولاد حوّاء سواي أنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11456&r=&rc=330",""]],"verses":[["هُوَ القَدَرُ الأَقوى الَّذي يَقصِفُ القَنا","وَيَلوي مِنَ الجَبّارِ جيداً وَأَخدَعا",0,"ع",2,0],["هُوَ القَدَرُ الَّذي خَطَبَت يَداهُ","ثَموداً مِن مَعاقِلِها وَعادا",1,"د",2,0],["هُوَ القَدَرُ المَجلوبُ مِن حَيثُ لا يُرى","وَأَعيا عَلينا رَدُّ تِلكَ الجَوالِبِ",2,"ب",1,0],["هوَ القَدَرُ الآتِي على كُلِّ أمّةٍ","فتُوبُوا سِراعاً قبْلَ أن يَقَع الفَوْتُ",3,"ت",1,0],["هُوَ القَوِيُّ الَّذِي لا يَظْفَرُونَ بِهِ","وَهْوَ الْخَفِيُّ الَّذِي يُفْنِي وَيَهْتَضِمُ",4,"م",1,0],["هُوَ القَينُ وَاِبنُ القَينِ لا قَينَ مِثلُهُ","لِفَطحِ المَساحي أَو لِجَدلِ الأَداهِمِ",5,"م",1,0],["هو القويُّ الأمينُ فارْمِ بهِ","ما شئتَ من معضلٍ يكُن حجره",6,"ر",2,0],["هو القويُ الأمين الكفّ نعلمه","والرأي في كل معلوم ومظنون",7,"ن",1,0],["هُوَ القائِدُ المَيمونُ وَالمُبتَغى بِهِ","ثَباتُ رَحىً كانَت قَديماً تَزَلزَلُ",8,"ل",1,0],["هُوَ القَلْبُ لَمّا حُمَّ يَوْمُ ابنِ أُمِّهِ","وَهَى جانِبٌ مِنْهُ وأُسْقِمَ جانِبُ",9,"ب",1,0],["هُوَ القائِدُ المَيمونُ وَالكاهِلُ الَّذي","يَثوبُ إِلَيهِ الناسُ مِن كُلِّ وافِدِ",10,"د",1,0],["هُوَ القَمَرُ البَدرُ الَّذي يُهتَدى بِهِ","إِذا ما ذَوُو الأَضغانِ جاروا عَنِ السُبلِ",11,"ل",1,0],["هو القَدرُ المحتومُ والسيفُ لم يكنُ","ليُخصَبَ إلا من دماءِ الأفاضلِ",12,"ل",1,0],["هو القدرُ المطبوعُ ما ثمَّ قادِرٌ","سواه فيستعلي ولا ثمَّ طابعُ",13,"ع",1,0],["هُوَ القِسْطَاسُ أُنزلَ مُسْتَقيماً","لِمن يَزِنُ النُّفوسَ أو الدِّماءَ",14,"ا",2,0],["هو القائد الميمونُ ما خاض غمرةً","فغادرها حتَّى يَرى الحقَّ عاليا",15,"ي",2,0],["هُوَ القادَهُ الحامي حَقيقَةَ قَومِهِ","إِذا قيلَ مَن لِلمُحصَناتِ الخَرائِدِ",16,"د",1,0],["هُو القوى وهو أجسام قد اِتصلت","بغيرها وهو الأجسام تنفصل",17,"ل",1,0],["هو القلبُ هو الحبُّ","وما الدنيا لدى الحبِّ",18,"ب",1,0],["هو القلبُ أعظم ما صوّرتْ","يدُ اللّهِ ما نازعتها يَدُ",19,"د",1,0],["هو القَدَرُ الماضي إذا انساب سهمُه","فلن يستطيعَ العالَمون له ردّا",20,"د",2,0],["هُوَ القاسم الأَعمار إِن جَلَّ فاذح","لَدَيهِ فَأَعمار الخُطوب قِصار",21,"ر",1,0],["هو القَرمُ الشديدُ البطشُ جدّاً","إذا تَعْنُو لسطوته القرومُ",22,"م",1,0],["هو القضا فخذ المبسوط مختصرا","وما جرا لا تسائل عنه كيف جرا",23,"ر",2,1],["هو القضاء وقد قالوا لقد صدقوا","ان القضا حين يغشى الطرف يعميه",24,"ي",2,0],["هوَ القَين ما ينفكّ في الكير نافخاً","ممالاً بلفظِ العُجم لا لغةِ العُرب",25,"ب",1,0],["هوَ القديمُ بمعناهُ الحديثُ أتى","وَمِنهما الشرعُ تفريعٌ وتأصيلُ",26,"ل",1,0],["هُوَ القَطبُ الَّذي دارَت عَلَيهِ","رَحى اللَذّاتِ في الزَمَنِ القَديم",27,"م",1,0],["هُوَ القَرمُ الفَحيلُ إِذا قُرَيشٌ","لِيَومٍ حَفيظَةٍ عَدّوا الفِحالا",28,"ل",2,0],["هو القدرُ المحتومُ إن جاءَ مُقدِماً","فلا الغابُ محروسٌ ولا الليث واثب",29,"ب",1,0],["هو ألقى في النارِ فحماً فلما","أجَّ لم يختطفْ سوى الوقّادِ",30,"د",1,0],["هو القول ما قلتم فإن صبابتي","ستبلغ ما لا يبلغ الجمر من وقدِ",31,"د",1,0],["هو أَلقى بِها إِلى دَرَكِ البرُ","صِ فَأَنهَضتُها إِلى آفاقي",32,"ق",2,0],["هُوَ القائِمُ الصَوّامُ وَاللَيلُ صائِفٌ","وَلِلقَيظِ زَندٌ في نَواحيهِ يَقدَحُ",33,"ح",1,0],["هو القلبُ في الآلامِ يطلبُ لذَّةً","ويُطمِعُه الحرمانُ من مُشتهاته",34,"ت",2,0],["هو القلبُ مرآةٌ لدى كلِّ صورةٍ","تراءت على حالَي صفاءٍ وكدرة",35,"ه",1,0],["هُوَ القَمَر المضىء لكل سار","وَملته الصراط المُستَقيم",36,"م",1,0],["هُوَ القَمَرُ الوَضَّاحُ مَا لاحَ لَمْ نُبَلْ","بأَنْ يأْفلَ البَدْرُ الفَياحُ وَيَبْزُغَا",37,"غ",2,0],["هُوَ القائِمُ المَنْصُورُ بِالدِّينِ والدُّنَى","وَصافِيهِما في قَوْمِهِ الصَّفْوَةِ الخُلْصِ",38,"ص",1,0],["هُوَ القائِمُ الهادِي بأيْمَنِ طائِر","فَمَا بِحِمَى الإِسْلام للشرْكِ طائِرُ",39,"ر",1,0],["هُوَ الْقَدَرُ الَّذِي لَمْ تَلْقَ خَلْقاً","عَلَى دَفْعٍ لَهُ أَبَداً قَدِيرا",40,"ر",2,0],["هُوَ القَتيلُ الَّذي لَم تُخطِ مُقلَتُهُ","عَمداً وَقاتِلُهُ لَم يَخشَ مِن قَوَدِه",41,"د",2,0],["هُوَ القَيلُ يَمشي آخِذاً بَطنَ عَرعَرٍ","بِتَجفافِهِ كَأَنَّهُ في سَراوِلِ",42,"ل",1,0],["هو القسيمُ له أَوفى القسيمَ على","نَفي القسيم ولا ترديد في القسمِ",43,"م",1,0],["هو القائم الساجد في غسق الدجى","فسل ورم الأقدام عن خير صابر",44,"ر",1,0],["هو القريب المجيب المستغاث به","قل حسبي اللَه معبودي ومتكلي",45,"ل",2,0],["هُوَ القائد الخيل الجِياد بِهمّةٍ","يَطأنَ بِها كَالترب صُمّ الصَفا الصلدُ",46,"د",1,0],["هو القرم الَّذي افتخرت وباهت","به الأَشرافُ أشراف القروم",47,"م",1,0],["هو القوم يروون المكارم عن أبٍ","وجدّ عريق سيِّداً بعد سيِّد",48,"د",1,0],["هو القطب الذي لا قطب يدعى","سواه في الأنام بلا نزاع",49,"ع",1,0],["هو القَدَرُ المحتومُ من ذا يَرُدُّهُ","وسلطانُ ربِّ العرشِ مَنْ ذا يُغَالِبُهْ",50,"ب",2,0],["هو القائم المهديّ فيها وعصرُه","زمانٌ لإصلاح الأمور وحينُ",51,"ن",1,0],["هو القاسي اذا اشْتَجرَ العَوالي","وعند السَّلْمِ ذو لُطْفٍ رَحيمُ",52,"م",1,0],["هو القاسي إذا اشْتَجرَ العَوالي","وعند السَّلْمِ مأنوسٌ رَحيمُ",53,"م",1,0],["هو القوام في صرات ليل ال","شتاء للصوّام ان وهج المصيف",54,"ف",1,0],["هو القاتلُ الأحداث أعيا خلودها","سواهُ ومحيي النفسُ حمَّ حمامها",55,"م",3,0],["هوَ القَدَرُ المُبْرَمُ اللايُرَدّ ُ","أم خادمُ القَدَرِ المُبْرَمِ ؟ !",56,"م",1,0],["هو القلب بين الكائنات لذاك قد","تقدم صدر الجيش جيش الرساليه",57,"ي",2,0],["هو القلب منه الاستقامة مبعد","هو البال والشتويش صيره البلا",58,"ا",1,0],["هو القاضي وحَسبك من قَضَاءٍ","له بالجَور في الشّرع احتِكام",59,"م",1,0],["هو القاسم السجلين عفواً ونقمة","وحاسم داء الدهر وهو عضال",60,"ل",1,0],["هو ألقى نفسه معتدياً","في المضيقات ولم ينفسح",61,"ح",1,0],["هوَ القمرُ المُنيرُ إِذا تجلَّى","عَلى قلبٍ جَلاهُ مِن سَوادِ",62,"د",1,0],["هو القلب للهجران إن هاجت شجونه","هوالدمع في الخدين سحت شؤنه",63,"ه",1,0],["هُوَ القسوَرُ اليَعروفُ ناظر عائذ","بِهِ مِن مبيرٍ ناكث العَهد ظالم",64,"م",1,0],["هُوَ القائم الهادي لِأُمته الَّذي","محيّاه بَدر في الظَلام مُنير",65,"ر",1,0],["هو القضاء إذا يمضي مقدره","لم يستطع رده ذو الحول والحيل",66,"ل",1,0],["هو القطر إلا انه غير ناضب","هو البحر الا انه غير مزبد",67,"د",1,0],["هو القريبُ ولكن ليس منه لهم","ولا له منهمُ بدٌّ وممتنع",68,"ع",1,0],["هُوَ القَمرُ الَّذي الشَّمسُ اِستَعارَت","لَها مِن فَضلِهِ حُسناً وَنورا",69,"ر",2,0],["هوَ القمَرُ الزّاهي على الشّمسِ نورُهُ","هوَ الأَسدُ المِقدامُ في كلِّ مَقدَمِ",70,"م",1,0],["هُوَ القطب عَبد القادر العارفُ الّذي","لَه وَهوَ في كيلان قَد عَنت الأقَطا",71,"ط",2,0],["هُوَ القُطب الَّذي دارَت عَلَيهِ","نُجوم السَعد لا تَخشى اِضطِرابا",72,"ب",2,0],["هو القائد الضمر الشواذب فوقها","سراحين غاصت في الحديد المسرد",73,"د",1,0],["هو القمر الفرد الذي لروائه","تظل نجوم الأفق لا شك ساجدة",74,"د",2,0],["هو القصد يغني السائلين نواله","هو الحصن يأوي الهاربين وبعصم",75,"م",1,0],["هو القصد إن غنى بمكة منشد","وإلا فما ركن وحجر وزمزم",75,"م",1,0],["هو القدرُ الجاري على الخلقِ كائن","وَلا ينفع الإنسان منه فرارهُ",76,"ر",2,0],["هُوَ القَدَرُ المُتاحُ جَرى عَلَينا","وَمَن يَسطيعُ لِلقَدرِ المُتاحِ",77,"ح",1,0],["هو القاهر الغلاب سيفاً وحجةً","هو المجتبى المختار للأكرمية",78,"ه",1,0],["هو القائم الساطي بعزم مؤيد","هو الفاتح المنصور في كل وجهة",78,"ه",1,0],["هو القطب الذي دارت عليه به","أفلاك أُفق الإفتتاح",79,"ح",1,0],["هو القَيْلُ من آل العتيك أولى العُلى","خلائقُه مشهورةٌ والمآثرُ",80,"ر",1,0],["هُوَ القَاتِلُ الْمَحْلَ لَمَّا دَعَا","فَصَيَّرَ فِي الغَابِرِينَ الغِبَارَا",81,"ر",2,0],["هو القومُ ما للشيخ منهم لكهلهم","وما منهم في كهلهم للمراهق",82,"ق",1,0],["هو القائم المهديّ يُدرك ما مضى","من الثار فليهمل لك الثارَ هاملُ",83,"ل",1,0],["هو القلبُ لمّا أُسكنتْ حَركاتُه","تراختْ له في الخافقينِ المفاصِل",84,"ل",1,0],["هُوَ القَيلُ وَاِبنُ القَيلِ وَالمَعشَرُ الأولى","إِذا غابَ مِنهُم سَيَّدٌ قامَ سَيِّدُ",85,"د",1,0],["هو القَدَرُ الجاري على مُهجِ الورى","إذا شاء من يَعصي لأحكامِهِ أمرا",86,"ر",2,0],["هو القدر الحتم يعمى الفتى","وإن كان بالدهر طباً بصيرا",87,"ر",2,0],["هو القصد إن غنت بنجد حداتنا","وإلا فما نجد وسلع أردناه",88,"ن",3,0],["هو القريض على عرش الجمال سما","وفضله جاوز الجوزاء واجتاسا",89,"س",2,0],["هُوَ القائِدُ الجُردَ العَناجيجَ شَزَّباً","وَكُلَّ فَتىً يَحمي الحَقيقَةَ ضَيغَمِ",90,"م",1,0],["هو القوم كل القوم إلا لديكم","فانهم ما بين بكم ولمد",91,"د",1,0],["هو القمر الوضّاح فيها كمثلِ ما","هو الشمسُ والروضُ المنمنم والرشا",92,"ش",2,0],["هو القوي حين تعطي جوارحنا","من النتائج فانظر فيه وادّكر",93,"ر",1,0],["هو القاهرُ المحمودُ في قهر عبده","ولولا نزاعُ العبد ما قاله الله",94,"ل",2,0],["هو القائم المهدي ذو الوطأة التي","بها يذر الأطواد يرجحها الذر",95,"ر",1,0],["هو القريع ينجي كل قارعة","بسيف بأس ملا سمع الزمان صدى",96,"د",2,0],["هُوَ القُطبُ والأقطابُ أنواعُ جِنسِهِ","وملجأُهُم إن ناب أمرٌ وحادِثُ",97,"ث",1,0],["هُوَ القُطبُ الغطمطمُ شيخنا الشي","ي