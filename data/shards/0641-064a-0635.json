https://www.aldiwan.net/poem12655.html","الكامل"],[440,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[442,"أحسن عزاك فخير الصبر في الجزع","https://www.aldiwan.net/poem14459.html","البسيط"],[459,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[462,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[462,"له عن الشر إعراض ومجتنب","https://www.aldiwan.net/poem16164.html","البسيط"],[462,"تبلج وجه الدهر بعد قطوبه","https://www.aldiwan.net/poem16344.html","الطويل"],[465,"ابن العليمي مخصوص بأربعة","https://www.aldiwan.net/poem3369.html","عموديه"],[480,"هي الأعمار نقص في ازدياد","https://www.aldiwan.net/poem36938.html","الوافر"],[496,"ما عاشق ألوط من قرد","https://www.aldiwan.net/poem9823.html","السريع"],[501,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[516,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[516,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[530,"على العالم البحر خدن الكمال","https://www.aldiwan.net/poem37267.html","المتقارب"],[545,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[559,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[563,"وردا على الخد لا وردا ببستان","https://www.aldiwan.net/poem52759.html","البسيط"],[563,"ألناس في الدهر لفظ أنت معناه","https://www.aldiwan.net/poem52808.html","البسيط"],[563,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[564,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[568,"بأبي أقيك من الحوادث والردى","https://www.aldiwan.net/poem69492.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"يا أقتل الناس ألحاظا وأعذبهم","https://www.aldiwan.net/poem18009.html","البسيط"],[588,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["في صِبيَةٍ لِلمَعالي كانَ أَولَعَهُم","بِالمَكرُماتِ وَأَلقاهُم إِلى الدِيَمِ",0,"م",1,0],["في صَدرِهِ أَرَةٌ عَليكَ مِنَ الجَوى","تُذكى بِأَنفاسِ المُعَنّى الموجَعِ",1,"ع",1,0],["في صِيالِ الأُسودِ إِن نَزَلَ الخَط","بُ عَليهِم وَفي حَياءِ العَذارى",2,"ر",2,0],["في صِبيَةٍ تَفَوَّقوا","مِن حَلَبِ العِزِّ دِرَر",3,"ر",1,0],["فيُصْدِرُها عَنهُمْ رِواءً مُتونُها","وقد وَرَدَ الهَيْجاءَ وهْيَ نِهالُ",4,"ل",1,0],["فيَصيرُ منْها البيْتُ بيْتاً ثانياً","للطّائِفينَ إليْهِ أيَّ بِدارِ",5,"ر",1,0],["فَيُصْرِخُهُ إِنْ ضَاقَ بِالَّروْعِ رُوعُهُ","هُوَ الْقَدَرُ الْمَحْتُومُ حُمَّ وُقُوعُهُ",6,"ه",1,0],["فَيَصقُلُ لَفظِيَ صَقلَ الجُمانِ","وَيَكسوهُ رِقَّةَ أَهلِ الحَضَر",7,"ر",1,0],["فَيُصبِحُ الشَرقُ غَرباً","وَيَستَوي الخافِقانِ",8,"ن",1,0],["فِي صَوْلَةٍ لِلدَّهْرِ تَعْقُبُ صَوْلَةً","مُنْتَابَةً فِي الآنِ بعْدَ الآنِ",9,"ن",1,0],["فِي صَرْحِهِ مِنْ كُلِّ ذُخْرٍ فَاخِرٍ","تَحُفٌ لَهَا تَارِيخُهَا وَرُسُومُ",10,"م",1,0],["في صَحنِ يَهماءَ تَهوي الخامِعاتُ بِها","مِن قِلَّةِ الكَسبِ لِلغُبسِ المَغاويرِ",11,"ر",1,0],["في صَحنِ بَهماءَ يَهتَفُّ السَمامَ بِها","في قَرقَرٍ بِلُعابِ الشَمسِ مَضروجِ",12,"ج",1,0],["في صاحب الوفرا","والخصر بالزنار",13,"ر",1,0],["في صفح صرح بالزجاج مموْهِ","وبجود مولاي الإمام ممهْدِ",14,"د",1,0],["في صامت الليل جرى مفردا","وبين جنبيه حوى عاشقين",15,"ن",1,0],["فيُصبح في أرض ويُمسي بغيرها","وحيداً فما يؤويه غرب ولا شرق",16,"ق",1,0],["فَيُصبِحُ قَومٌ بِالرَجيعِ كَأَنَّهُم","جِداءُ تُيوسٍ هُنَّ غَيرُ دِفاءِ",17,"ا",2,0],["في صدغِهِ الوأوا يجيدُ نسيبه","ولعقل عاذلي انتساب الأبله",18,"ه",1,0],["فيصلٌ للأمور يأتي المعالي","بارتقاء فيها وحُسْن اهتداءِ",19,"ا",2,0],["فَيَصُبُّ الصَّبّابُ في فيه بالكَرْ","نيب من ذلك العذاب المُذابِ",20,"ب",1,0],["فيصبح أفضل الرجلين جسماً","وتصبح أعظم الرجلين جيفه",21,"ه",1,0],["في صدور ساليات","لم يُلَذِّعها الفراق",22,"ق",1,0],["فيصبحُ الناسُ طراً","في نعمة المنْعَامِ",23,"م",1,0],["فَيُصبِحُ كَالخُفّاشِ يَدلُكُ عَينَهُ","فَقُبِّحتَ مِن وَجهٍ لَئيمٍ وَمِن حَجرِ",24,"ر",1,0],["في صورَةٍ تَمَّت وَأُكمِلَ خَلقُها","لِلناظِرينَ كَصورَةِ التِمثالِ",25,"ل",1,0],["فَيَصدُفُ عَنه وَهوَ داجٍ مُقَطَّبٌ","كَأَنَّ عَدُوّاً بِالنَسيمِ يُحاذِرُه",26,"ر",2,0],["في صَدرِها النارُ نارُ الحِقدِ مُضرَمَةً","لَكِنَّما مُقلَتاها تَقذِفُ الشَرَرا",27,"ر",2,0],["في صِحَّةٍ لا يَنتَهي","شَبابُها إِلى هَرَم",28,"م",1,0],["فيُصْبِحُ مَا قَدْ شيَّدَ اللهُ والورى","خراباً كأنَّ الكُلَّ في أَمسهِ وَهْمُ",29,"م",1,0],["في صباحِ الحَيَاةِ ضَمَّخْتُ أَكوابي","وأَترعتُها بخمرَةِ نفسي",30,"س",2,0],["فيُصبحُ منها الوليُّ الحميمُ","ويصبحُ منها العدوُّ الحقُودْ",31,"د",1,0],["في صَدْرِها أملٌ","يحدِّقُ نحوَ هاتيك النُّجومْ",32,"م",1,0],["فيصرخ العود كطفل","دغدغته الخافره",33,"ر",2,0],["فيصل مات فالعروبة ثكلى","مالها للسلو عنه سبيل",34,"ل",1,0],["فيصل قد قضى ففي كل بيت","بالفراتين رنة وعويل",34,"ل",1,0],["فيصل الباني مات فليحى غازي","انه ذو الجلالة المأمول",34,"ل",1,0],["في صوتك الفن قد لاقى سعادته","فانه كل يوم لاثم فاك",35,"ك",1,0],["فيصبح منحنق إله آخر","أقصر فلست هنا ولست هناكا",36,"ك",2,0],["فيصبِحُ السُّقْمُ مَنْقُولاً إلى جَسَدِي","ويَجْعَلُ اللّهُ مِنْهُ البُرْءَ عُقْباهُ",37,"ه",1,0],["فيصير للاجلاد من","هادُ ربَة تعتادُها",38,"د",3,0],["فَيُصبِحُ في أَفناءِ سَعدِ بنِ مالِكٍ","وُجوهٌ مِنَ المَخزاةِ سودٌ خُدودُها",39,"د",3,0],["فيَصدُرُ عن رَاووقِ فِكْرٍ كأنَّه","يُرَوِّقُ جِريالاً من الخَمْرِ عَنْدَما",40,"م",2,0],["فَيَصرَعُ مَن يُصارِعُهُ","وَيَنضُلُ مَن يُناضِلُهُ",41,"ل",2,0],["في صَمُوتٍ أقرّ بالنشر منها","وهوَ تَحتَ الصَّعيدِ نائي القرارِ",42,"ر",1,0],["فَيَصونُ العِرضَ بما بَذَلَتْ","لِلوَفدِ يَداهُ مِنَ الصّفدِ",43,"د",1,0],["في صَدرِهِ مِن هُمومٍ يَعتَلِجنَ بِهِ","وَساوِسٌ فُرَّكٌ لِلخُرَّدِ العُرُبِ",44,"ب",1,0],["في صدغِهِ للحسْنِ آياتٌ تُخَطّ","وقال قومٌ إنها اللامُ فقطْ",45,"ط",1,0],["فيصبغُ أصبغَ مِنْ بَهْتِه","وأشهبُ في عينهِ أبلقُ",46,"ق",1,0],["فَيَصبُغُ الدَرُّ عَقيقاً بِهِ","وَأَصبُغُ النُوّارَ أَزهارا",47,"ر",2,0],["في صُدغِهِنَّ عَقارِبٌ يَلسَعنَنا","ما مَن لَسَعنَ بِواجِدٍ تِرياقِها",48,"ق",3,0],["في صُورةِ الإنسانِ إلا أنَّهم","نَزَلُوا هُناكَ منازلَ الأنعامِ",49,"م",1,0],["في صُورةِ الأقلامِ إلا أنّه","من عفةٍ وطهارةٍ وجَلالِ",50,"ل",1,0],["فَيصلٌ شيّدَ ملكاً لَم يَزَل","بِحِمى اللَه وَغازي يَعتلي",51,"ل",2,0],["فيصدُّني أدبي فأُبعدُ هيبةً","وأودُّ لو أجثو على قدّميها",52,"ي",3,0],["في صَدرِهِ مِن واكِفٍ وَقاطِرِ","كَأَثَرِ الذَرقِ عَلى الكَنادِرِ",53,"ر",1,0],["في صَدرِ هذا العامِ لا يَلوي على","أحَدٍ تلفَّتَ خَلفَهُ وتوقَّفا",54,"ف",2,0],["في صَدرِهِ حِلمٌ وَفي دِرعِهِ","لَيثٌ عَليهِ التاجُ مَزرورُ",55,"ر",1,0],["في صَدرِهِ حِلمٌ وَفي دِرعِهِ","مُظَفَّرُ الحَزمِ كَريمُ المَآب",56,"ب",1,0],["في صَلاهُ أَلَّةٌ حُشُرٌ","وَقَناةُ الرَمحِ مُنقَصِمَه",57,"م",2,0],["فيصبح منك الوجه قد زالَ حسنه","جَميعاً وَمنه الناس أجمع تسخر",58,"ر",1,0],["في صدى الجدولِ الموقّع أنّا","تِ حشاهُ بالجندلِ الجلمودِ",59,"د",1,0],["في صدر قيثارةٍ أودعتَهُ نغَماً","مِزاجُهُ الماءُ والإعصارُ والنارُ",60,"ر",1,0],["فِي صَدْرِهِ الرِّفْقُ جَمِيعاً وَمَا","مِنْ رِيبَةٍ فِي ذلِكَ الصَّدْرِ",61,"ر",1,0],["فِي صُورَة أَشْبَهَ","مَا كَانَتْ بِهِمْ فِي مَحْفِلِ",62,"ل",1,0],["فِي صُورَةِ الحَمَلِ الوَدِيعِ وَرُبَّمَا","أَلْفَيْتَهُ فِي صَوْلَةِ الرِّئْبَالِ",63,"ل",1,0],["فِي صُورَةِ الْفَارُوق أَيَّةِ صُورَةٍ","لِلحُسْنِ صِيغَتْ فِي جَلاَلِ السُّؤْدَدِ",64,"د",1,0],["فِي صُورَةٍ لَمَّاحَةٍ شَرَّفَتْ","يَد الْعلَى فِيهَا الحِجَى وَالجَمَالْ",65,"ل",1,0],["فِي صُورَةِ المَلِكِ الحَبِيبِ المُفْتَدَى","حَامِي الحِمَى فَارُوقُ مِصْرَ الأَوَّلِ",66,"ل",1,0],["فِي صَمْتِهِ الأَبَدِيِّ أَبْلَغِ وَاعِظٍ","لأُلَى النَّهَى بِلِسَانِ أَفْصَحِ خَاطِبِ",67,"ب",1,0],["فِي صَدْرِهِ بَحْرُ فُنُونٍ كُلُّهَا","فَرَائِدٌ لِطَالِبِ التَّحْصِيلِ",68,"ل",1,0],["فِي صَرْحِ يُوسُفَ لِلأَحِبَّةِ لَيْلَةٌ","سَيُعِيدُ ذِكْرَى حُسْنِهَا السُّمَّارُ",69,"ر",1,1],["فِي صُورَتَيْنِ تُجَدِّدَانِ","حَيَاتَنَا جَنْبَاً لِجَنْبِ",70,"ب",1,0],["فِي صُنْعِ وَشْيٍ دَقِيقٍ","لَقِينَ فِيهِ الْعَنَاءَ",71,"ا",2,0],["فيصوغ هينمة النسيم قصائداً","ويرد زمزمة الغدير أغاني",72,"ن",2,0],["فيصلَ العُرْبِ، ما هززناكَ","إلا بالجفونِ المقرَّحات السواجم",73,"م",1,0],["في صدري... ويعصر الفؤادْ","وفجأة...لمحتُ في الشارع حشد المعجبينْ",74,"ن",1,0],["فَيصرعُ ضَرباً وَإِن لَم يَجل","وَيَصرَعُ صَرباً وَإِن أَلمَظا",75,"ظ",2,0],["في صَفَاءٍ مِنَ الطَّبِيعَةِ كَالْحَقِّ","إِذَا لَمْ يَشِنْهُ ثَوْبُ الرِّيَاءِ",76,"ا",2,0],["في صِحَابٍ مِثْلِ الدَّنانِيرِ لا تبْلَى","مَودّاتُهم بطُولِ الصِّحَابِ",77,"ب",1,0],["في صَدْرِه قَلِقُ الْجَوَانِح مُوجَعٌ","مَلَّتْ نُجُومُ الَّليلِ من دَقَّاتِهِ",78,"ت",2,0],["فيصيبُ منها الليثُ لحمًا طيِّبًا","ودمًا يُرَوّى غُلَّة الظمآن",79,"ن",1,0],["في صُدغ كلِّ مهفهفٍ","كالليل فاحمُ شعره",80,"ر",2,0],["فيصنع من ميت التراب عجائبا","كما صنع الإكسير من حجر الطلق",81,"ق",1,0],["فيصدف عنه وهو مقطب","كأنّ عدوّا بالنسيم يحاذرة",82,"ر",2,0],["في صدري تبكي أطيار","عطشى … في جمجمتي شيطان ..",83,"ن",1,0],["في صدره من زمان الصيف وقدته","لكنه مطلخم جد مدجون",84,"ن",1,0],["فيصيرُ الفعلُ طبعاً لازماً","أبداً لا ينجلى مثلُ الكَحَلْ",85,"ل",1,0],["فيصدُّوكَ عنهُمُ أو يصدُّوا","قلبَ من شئته بغيرِ مِراءِ",86,"ا",2,0],["فيصدُّوكَ غيرةً ويصدُّوا","عنك مَن تبتغي بغير امتراءِ",86,"ا",2,0],["فَيُصبِحَ لاَ يخشَى سَبَايَا ولاَقِلىً","ويَجعَلُهُ في كُلِّ أمرِ مُقَدَّمَا",87,"م",2,0],["في صَدرِهِ نَارُ أشجَانٍ مُؤَجَّجَة","إِن لِيمَ حَرَّقَهُ مِن عذعِها الوَقَدُ",88,"د",1,0],["فَيصبِحُ وهوَ ينظرُ في الأعادِى","كَفِيلاً بالوَسِيقَةِ أن يَعُودَا",89,"د",2,0],["فَيُصبِحُ أَهلُ اللَهِ بيضاً كَأَنَّما","كَسَتهُم حَبيراً ريدَةٌ وَمَعافِرُ",90,"ر",1,0],["فَيُصبِحُ آلُ اللَهِ بيضاً كَأَنَّما","كَسَتهُم حَبيراً رَيدَةٌ وَمَعافِرُ",91,"ر",1,0],["في صفحتيْ وجنتيه","وردٌ وفي فيه قرقفْ",92,"ف",1,0],["في صفاتِ البدرِ قد شاركتهم","وأرى كلاً لما لاقاهُ لاقْ",93,"ق",1,0],["فيصبو بها في العيد من ليس صابيا","ويفرح محزون الفؤاد ولا يأسى",94,"س",2,0],["فَيُصبِحُ حاجِلَةً عَينُهُ","لِحِنوِ اِستِهِ وَصَلاهُ غُيوب",95,"ب",1,0],["في صُدْغِهِ عَقْرَبٌ لِلْصُّدْغِ لادِغَةٌ","دِرْياقُ لَدْغَتِها يا قَوْمِ مِنْ فِيهِ",96,"ه",1,0],["في صحن غرته السعود طوالعٌ","في كل يوم لا يخاف أُفولا",97,"ل",2,0],["في صبح ليلتها أصلى ساجداً","لله بين الماء والأطيانِ",98,"ن",1,0],["فَيُ