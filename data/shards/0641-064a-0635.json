وطف على الأقوام","https://www.aldiwan.net/poem42048.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[102,"ما كنت أرغب أن أسمى قاسيا","https://www.aldiwan.net/poem33111.html","الكامل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[50,"يا طير إنا في غد طير","https://www.aldiwan.net/poem63822.html","السريع"],[50,"أفنيت عمري وتقضى الشباب","https://www.aldiwan.net/poem64823.html","السريع"],[8,"إن قومي عز نصرهم","https://www.aldiwan.net/poem21833.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39647","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54700","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55185","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55149","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55158","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54906","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54646","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[106,"ليثان يقتنصان","https://www.poetsgate.com/ViewPoem.aspx?id=179573",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[91,"أيا نيل","https://www.poetsgate.com/ViewPoem.aspx?id=53039",""]],"verses":[["في صِبيَةٍ لِلمَعالي كانَ أَولَعَهُم","بِالمَكرُماتِ وَأَلقاهُم إِلى الدِيَمِ",0,"م",1,0],["في صَدرِهِ أَرَةٌ عَليكَ مِنَ الجَوى","تُذكى بِأَنفاسِ المُعَنّى الموجَعِ",1,"ع",1,0],["في صِيالِ الأُسودِ إِن نَزَلَ الخَط","بُ عَليهِم وَفي حَياءِ العَذارى",2,"ر",2,0],["في صِبيَةٍ تَفَوَّقوا","مِن حَلَبِ العِزِّ دِرَر",3,"ر",1,0],["فيُصْدِرُها عَنهُمْ رِواءً مُتونُها","وقد وَرَدَ الهَيْجاءَ وهْيَ نِهالُ",4,"ل",1,0],["فيَصيرُ منْها البيْتُ بيْتاً ثانياً","للطّائِفينَ إليْهِ أيَّ بِدارِ",5,"ر",1,0],["فَيُصْرِخُهُ إِنْ ضَاقَ بِالَّروْعِ رُوعُهُ","هُوَ الْقَدَرُ الْمَحْتُومُ حُمَّ وُقُوعُهُ",6,"ه",1,0],["فَيَصقُلُ لَفظِيَ صَقلَ الجُمانِ","وَيَكسوهُ رِقَّةَ أَهلِ الحَضَر",7,"ر",1,0],["فَيُصبِحُ الشَرقُ غَرباً","وَيَستَوي الخافِقانِ",8,"ن",1,0],["فِي صَوْلَةٍ لِلدَّهْرِ تَعْقُبُ صَوْلَةً","مُنْتَابَةً فِي الآنِ بعْدَ الآنِ",9,"ن",1,0],["فِي صَرْحِهِ مِنْ كُلِّ ذُخْرٍ فَاخِرٍ","تَحُفٌ لَهَا تَارِيخُهَا وَرُسُومُ",10,"م",1,0],["في صَحنِ يَهماءَ تَهوي الخامِعاتُ بِها","مِن قِلَّةِ الكَسبِ لِلغُبسِ المَغاويرِ",11,"ر",1,0],["في صَحنِ بَهماءَ يَهتَفُّ السَمامَ بِها","في قَرقَرٍ بِلُعابِ الشَمسِ مَضروجِ",12,"ج",1,0],["في صاحب الوفرا","والخصر بالزنار",13,"ر",1,0],["في صفح صرح بالزجاج مموْهِ","وبجود مولاي الإمام ممهْدِ",14,"د",1,0],["في صامت الليل جرى مفردا","وبين جنبيه حوى عاشقين",15,"ن",1,0],["فيُصبح في أرض ويُمسي بغيرها","وحيداً فما يؤويه غرب ولا شرق",16,"ق",1,0],["فَيُصبِحُ قَومٌ بِالرَجيعِ كَأَنَّهُم","جِداءُ تُيوسٍ هُنَّ غَيرُ دِفاءِ",17,"ا",2,0],["في صدغِهِ الوأوا يجيدُ نسيبه","ولعقل عاذلي انتساب الأبله",18,"ه",1,0],["فيصلٌ للأمور يأتي المعالي","بارتقاء فيها وحُسْن اهتداءِ",19,"ا",2,0],["فَيَصُبُّ الصَّبّابُ في فيه بالكَرْ","نيب من ذلك العذاب المُذابِ",20,"ب",1,0],["فيصبح أفضل الرجلين جسماً","وتصبح أعظم الرجلين جيفه",21,"ه",1,0],["في صدور ساليات","لم يُلَذِّعها الفراق",22,"ق",1,0],["فيصبحُ الناسُ طراً","في نعمة المنْعَامِ",23,"م",1,0],["فَيُصبِحُ كَالخُفّاشِ يَدلُكُ عَينَهُ","فَقُبِّحتَ مِن وَجهٍ لَئيمٍ وَمِن حَجرِ",24,"ر",1,0],["في صورَةٍ تَمَّت وَأُكمِلَ خَلقُها","لِلناظِرينَ كَصورَةِ التِمثالِ",25,"ل",1,0],["فَيَصدُفُ عَنه وَهوَ داجٍ مُقَطَّبٌ","كَأَنَّ عَدُوّاً بِالنَسيمِ يُحاذِرُه",26,"ر",2,0],["في صَدرِها النارُ نارُ الحِقدِ مُضرَمَةً","لَكِنَّما مُقلَتاها تَقذِفُ الشَرَرا",27,"ر",2,0],["في صِحَّةٍ لا يَنتَهي","شَبابُها إِلى هَرَم",28,"م",1,0],["فيُصْبِحُ مَا قَدْ شيَّدَ اللهُ والورى","خراباً كأنَّ الكُلَّ في أَمسهِ وَهْمُ",29,"م",1,0],["في صباحِ الحَيَاةِ ضَمَّخْتُ أَكوابي","وأَترعتُها بخمرَةِ نفسي",30,"ي",1,0],["فيُصبحُ منها الوليُّ الحميمُ","ويصبحُ منها العدوُّ الحقُودْ",31,"د",1,0],["في صَدْرِها أملٌ","يحدِّقُ نحوَ هاتيك النُّجومْ",32,"م",1,0],["فيصرخ العود كطفل","دغدغته الخافره",33,"ر",2,0],["فيصل مات فالعروبة ثكلى","مالها للسلو عنه سبيل",34,"ل",1,0],["فيصل قد قضى ففي كل بيت","بالفراتين رنة وعويل",34,"ل",1,0],["فيصل الباني مات فليحى غازي","انه ذو الجلالة المأمول",34,"ل",1,0],["في صوتك الفن قد لاقى سعادته","فانه كل يوم لاثم فاك",35,"ك",1,0],["فيصبح منحنق إله آخر","أقصر فلست هنا ولست هناكا",36,"ك",2,0],["فيصبِحُ السُّقْمُ مَنْقُولاً إلى جَسَدِي","ويَجْعَلُ اللّهُ مِنْهُ البُرْءَ عُقْباهُ",37,"ه",1,0],["فيصير للاجلاد من","هادُ ربَة تعتادُها",38,"د",3,0],["فَيُصبِحُ في أَفناءِ سَعدِ بنِ مالِكٍ","وُجوهٌ مِنَ المَخزاةِ سودٌ خُدودُها",39,"د",3,0],["فيَصدُرُ عن رَاووقِ فِكْرٍ كأنَّه","يُرَوِّقُ جِريالاً من الخَمْرِ عَنْدَما",40,"م",2,0],["فَيَصرَعُ مَن يُصارِعُهُ","وَيَنضُلُ مَن يُناضِلُهُ",41,"ل",2,0],["في صَمُوتٍ أقرّ بالنشر منها","وهوَ تَحتَ الصَّعيدِ نائي القرارِ",42,"ر",1,0],["فَيَصونُ العِرضَ بما بَذَلَتْ","لِلوَفدِ يَداهُ مِنَ الصّفدِ",43,"د",1,0],["في صَدرِهِ مِن هُمومٍ يَعتَلِجنَ بِهِ","وَساوِسٌ فُرَّكٌ لِلخُرَّدِ العُرُبِ",44,"ب",1,0],["في صدغِهِ للحسْنِ آياتٌ تُخَطّ","وقال قومٌ إنها اللامُ فقطْ",45,"ط",1,0],["فيصبغُ أصبغَ مِنْ بَهْتِه","وأشهبُ في عينهِ أبلقُ",46,"ق",1,0],["فَيَصبُغُ الدَرُّ عَقيقاً بِهِ","وَأَصبُغُ النُوّارَ أَزهارا",47,"ر",2,0],["في صُدغِهِنَّ عَقارِبٌ يَلسَعنَنا","ما مَن لَسَعنَ بِواجِدٍ تِرياقِها",48,"ق",3,0],["في صُورةِ الإنسانِ إلا أنَّهم","نَزَلُوا هُناكَ منازلَ الأنعامِ",49,"م",1,0],["في صُورةِ الأقلامِ إلا أنّه","من عفةٍ وطهارةٍ وجَلالِ",50,"ل",1,0],["فَيصلٌ شيّدَ ملكاً لَم يَزَل","بِحِمى اللَه وَغازي يَعتلي",51,"ل",2,0],["فيصدُّني أدبي فأُبعدُ هيبةً","وأودُّ لو أجثو على قدّميها",52,"ي",3,0],["في صَدرِهِ مِن واكِفٍ وَقاطِرِ","كَأَثَرِ الذَرقِ عَلى الكَنادِرِ",53,"ر",1,0],["في صَدرِ هذا العامِ لا يَلوي على","أحَدٍ تلفَّتَ خَلفَهُ وتوقَّفا",54,"ف",2,0],["في صَدرِهِ حِلمٌ وَفي دِرعِهِ","لَيثٌ عَليهِ التاجُ مَزرورُ",55,"ر",1,0],["في صَدرِهِ حِلمٌ وَفي دِرعِهِ","مُظَفَّرُ الحَزمِ كَريمُ المَآب",56,"ب",1,0],["في صَلاهُ أَلَّةٌ حُشُرٌ","وَقَناةُ الرَمحِ مُنقَصِمَه",57,"م",2,0],["فيصبح منك الوجه قد زالَ حسنه","جَميعاً وَمنه الناس أجمع تسخر",58,"ر",1,0],["في صدى الجدولِ الموقّع أنّا","تِ حشاهُ بالجندلِ الجلمودِ",59,"د",1,0],["في صدر قيثارةٍ أودعتَهُ نغَماً","مِزاجُهُ الماءُ والإعصارُ والنارُ",60,"ر",1,0],["فِي صَدْرِهِ الرِّفْقُ جَمِيعاً وَمَا","مِنْ رِيبَةٍ فِي ذلِكَ الصَّدْرِ",61,"ر",1,0],["فِي صُورَة أَشْبَهَ","مَا كَانَتْ بِهِمْ فِي مَحْفِلِ",62,"ل",1,0],["فِي صُورَةِ الحَمَلِ الوَدِيعِ وَرُبَّمَا","أَلْفَيْتَهُ فِي صَوْلَةِ الرِّئْبَالِ",63,"ل",1,0],["فِي صُورَةِ الْفَارُوق أَيَّةِ صُورَةٍ","لِلحُسْنِ صِيغَتْ فِي جَلاَلِ السُّؤْدَدِ",64,"د",1,0],["فِي صُورَةٍ لَمَّاحَةٍ شَرَّفَتْ","يَد الْعلَى فِيهَا الحِجَى وَالجَمَالْ",65,"ل",1,0],["فِي صُورَةِ المَلِكِ الحَبِيبِ المُفْتَدَى","حَامِي الحِمَى فَارُوقُ مِصْرَ الأَوَّلِ",66,"ل",1,0],["فِي صَمْتِهِ الأَبَدِيِّ أَبْلَغِ وَاعِظٍ","لأُلَى النَّهَى بِلِسَانِ أَفْصَحِ خَاطِبِ",67,"ب",1,0],["فِي صَدْرِهِ بَحْرُ فُنُونٍ كُلُّهَا","فَرَائِدٌ لِطَالِبِ التَّحْصِيلِ",68,"ل",1,0],["فِي صَرْحِ يُوسُفَ لِلأَحِبَّةِ لَيْلَةٌ","سَيُعِيدُ ذِكْرَى حُسْنِهَا السُّمَّارُ",69,"ر",1,1],["فِي صُورَتَيْنِ تُجَدِّدَانِ","حَيَاتَنَا جَنْبَاً لِجَنْبِ",70,"ب",1,0],["فِي صُنْعِ وَشْيٍ دَقِيقٍ","لَقِينَ فِيهِ الْعَنَاءَ",71,"ا",2,0],["فيصوغ هينمة النسيم قصائداً","ويرد زمزمة الغدير أغاني",72,"ن",2,0],["فيصلَ العُرْبِ، ما هززناكَ","إلا بالجفونِ المقرَّحات السواجم",73,"م",1,0],["في صدري... ويعصر الفؤادْ","وفجأة...لمحتُ في الشارع حشد المعجبينْ",74,"ن",1,0],["فَيصرعُ ضَرباً وَإِن لَم يَجل","وَيَصرَعُ صَرباً وَإِن أَلمَظا",75,"ظ",2,0],["في صَفَاءٍ مِنَ الطَّبِيعَةِ كَالْحَقِّ","إِذَا لَمْ يَشِنْهُ ثَوْبُ الرِّيَاءِ",76,"ا",2,0],["في صِحَابٍ مِثْلِ الدَّنانِيرِ لا تبْلَى","مَودّاتُهم بطُولِ الصِّحَابِ",77,"ب",1,0],["في صَدْرِه قَلِقُ الْجَوَانِح مُوجَعٌ","مَلَّتْ نُجُومُ الَّليلِ من دَقَّاتِهِ",78,"ت",2,0],["فيصيبُ منها الليثُ لحمًا طيِّبًا","ودمًا يُرَوّى غُلَّة الظمآن",79,"ن",1,0],["في صُدغ كلِّ مهفهفٍ","كالليل فاحمُ شعره",80,"ر",2,0],["فيصنع من ميت التراب عجائبا","كما صنع الإكسير من حجر الطلق",81,"ق",1,0],["فيصدف عنه وهو مقطب","كأنّ عدوّا بالنسيم يحاذرة",82,"ر",2,0]]}