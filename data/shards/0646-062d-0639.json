{"poems":[[51,"خانك الطرف الطموح","https://www.aldiwan.net/poem62028.html","مجزوء الرمل"],[267,"نح عنك الطبيب واسمع لنعتي","https://www.aldiwan.net/poem68222.html","الخفيف"],[1166,"","https://poetry.dctabudhabi.ae/diwan/poem/131353","الخفيف"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101302","الخفيف"],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["نُح عَلى نَفسِكَ يا مِس","كينُ إِن كُنتَ تَنوحُ",0,"ح",1,0],["نَحِّ عَنكَ الطَّبِيبَ وَاسمَع لِنَعتِي","إنَّني ناصِحٌ مِنَ النُّصَّاحِ",1,"ح",1,1],["نحّ عن مدرج الشباب المشيبا","وتجنب ذكر الصبا والنسيبا",2,"ب",2,1],["نح عنا الأفراح إن كنت ترعى","فلقد ساءنا مصاب المحسن",3,"ن",1,0],["نحَّ عن علم القوم لست من أهلهِ","لا تقرَب مال اليتيم ذاك نفسُ البلا",4,"ل",2,0]]}