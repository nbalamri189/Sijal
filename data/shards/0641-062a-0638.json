{"poems":[[64,"دخلت بناسوتي لديك الخلق","https://www.aldiwan.net/poem67621.html","الطويل"],[51,"يا ابن المسيب عشت في نعم","https://www.aldiwan.net/poem8151.html","الكامل"],[91,"حيا الصبا على ربى لبنان","https://www.aldiwan.net/poem62768.html","عموديه"],[89,"من كل زهر قد جمعت قليلا","https://www.aldiwan.net/poem44606.html","الكامل"],[89,"يا مصر فيك الشعر مات اميره","https://www.aldiwan.net/poem44744.html","الكامل"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[61,"سدت سيوفك خلة الثغرين","https://www.aldiwan.net/poem51413.html","الكامل"],[66,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[51,"يا ابنَ المُسَيَّبِ عشت في نِعَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=26845",""],[133,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[236,"قم قبل إسفار الصباح","https://www.aldiwan.net/poem32117.html","مجزوء الكامل"],[378,"الحزن يظلم أنفسا فيضلها","https://www.aldiwan.net/poem59112.html","الكامل"],[378,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[417,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[459,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[462,"لرواة شعري من مدائحه","https://www.aldiwan.net/poem16122.html","أحذ الكامل"],[462,"يبدل الليل ضحى من بشره","https://www.aldiwan.net/poem16156.html","الرمل"],[539,"للأرض شهب كالسما لا يرتجي","https://www.aldiwan.net/poem47988.html","عموديه"],[559,"صدقتم هي الأكوان تطوي وتنشر","https://www.aldiwan.net/poem34495.html","الطويل"],[559,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[568,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"]],"verses":[["فَتَظهَرُ لِلأَلبابِ في الغَربِ تارَةً","وَطَوراً عَنِ الأَبصارِ تَغرُبُ في الشَرقِ",0,"ق",1,0],["فتظلُّ فيه بخير مُصْطَحَبٍ","وكأنها في شرِّ مُصْطَحَبِ",1,"ب",1,0],["فَتَظاهَروا بِالزُهدِ حَتّى أَشَكَت","تَخفى دَخائِلُهُم عَلى اليَقظانِ",2,"ن",1,0],["فتظن أبيضها أشعة كوكب","وتخال أحمرها دما مطلولا",3,"ل",2,0],["فتظن ابيضا اشعة كوكب","وتخال احمرها دما مطلولا",4,"ل",2,0],["فَتَظَلُّ تَحسُدُكَ المُلوكُ الصيدُ بي","وَأَظَلُّ يَحسُدُني بِكَ الشُعَراءُ",5,"ا",2,0],["فتَظَلَّ فَضفاضَ المَواهبِ سَاحباً","بُرْدَيْنِ للنَّعماءِ فَضفاضَيْنِ",6,"ن",1,0],["فَتَظَلُّ تَرقُمُ في الصُخورِ أَهِلَّةً","بِشَبا حَوافِرِها وَإِن لَم تُنعَلِ",7,"ل",1,0],["فَتظَلُّ تَضرِبُ فِي جوَانِبِهِ وَمَا","تُلْقِي إِلى نُذُرِ الحُبُوطِ بِبَالِ",8,"ل",1,0],["فَتَظَلُّ كُلُّ حَقِيقَةٍ","فِيهَا مَحَلاً لاِرْتِيَابْ",9,"ب",1,0],["فتظلُّ فيه بخير مُصْطَحَب","وكأنها في شرِّ مُصْطخَب",10,"ب",1,0],["فتظهر وجنتاه كل فعل","أسر به سريرته حرام",11,"م",1,0],["فَتَظَلُّ ما بَينَ اِغتَبا","قٍ بِالسَعادَةِ وَاِصطِباحِ",12,"ح",1,0],["فتظلُّ تخبط في قنوطٍ موبِقٍ","فتَعافُ أن تقرا وأن تتذكرا",13,"ر",2,0],["فتَظلُّ من أشواقها","تبكي بعينٍ هاميه",14,"ي",2,0],["فتظنّ البروق منها سيوفاً","مذهبات سُلَّت من الأغماد",15,"د",1,0],["فتظلّ طوراً في عنانِ سمائها","صُعُداً وطوراً في الحضيضِ الهامدِ",16,"د",1,0],["فتظلُّ إنْ سُلَّتْ على حَذَرٍ","ألْجَسْرَةُ الوَجْناءُ والبَطَلُ",17,"ل",1,0],["فتظلُّ الشمس تشكو فِعْلَهُ","تحتَ جُنْحِ الليل أو تحت القَنا",18,"ن",2,0],["فتظاهرت شُهبُ السما لَمَّا رَأت","شُهبَ البَسيطةِ نالَها مانالَها",19,"ل",3,0],["فتظهر مثل الشمس لا تتستر","ألا نحن قوم قد عرفنا بهولنا",20,"ن",2,0],["فتظهر أغياراً له وهو عينها","يحس به الذوق السليم المشاهد",21,"د",1,0],["فتظهر في الروح العوالم كلها","عكوس مرادات الإله شوارد",21,"د",1,0],["فَتَظَلُّ مِنْها بِاليَسَارِ لَهُ","قَبْضٌ وَبِالْيمُنَى لَهُ بَسْطُ",22,"ط",1,0]]}