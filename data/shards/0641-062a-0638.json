{"poems":[[66,"دخلت بناسوتي لديك الخلق","https://www.aldiwan.net/poem67621.html","الطويل"],[53,"يا ابن المسيب عشت في نعم","https://www.aldiwan.net/poem8151.html","الكامل"],[93,"حيا الصبا على ربى لبنان","https://www.aldiwan.net/poem62768.html","عموديه"],[91,"من كل زهر قد جمعت قليلا","https://www.aldiwan.net/poem44606.html","الكامل"],[91,"يا مصر فيك الشعر مات اميره","https://www.aldiwan.net/poem44744.html","الكامل"],[47,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[63,"سدت سيوفك خلة الثغرين","https://www.aldiwan.net/poem51413.html","الكامل"],[68,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[53,"يا ابنَ المُسَيَّبِ عشت في نِعَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=26845",""],[136,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[240,"قم قبل إسفار الصباح","https://www.aldiwan.net/poem32117.html","مجزوء الكامل"],[382,"الحزن يظلم أنفسا فيضلها","https://www.aldiwan.net/poem59112.html","الكامل"],[382,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[422,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[463,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[466,"لرواة شعري من مدائحه","https://www.aldiwan.net/poem16122.html","أحذ الكامل"],[466,"يبدل الليل ضحى من بشره","https://www.aldiwan.net/poem16156.html","الرمل"],[543,"للأرض شهب كالسما لا يرتجي","https://www.aldiwan.net/poem47988.html","عموديه"],[563,"صدقتم هي الأكوان تطوي وتنشر","https://www.aldiwan.net/poem34495.html","الطويل"],[563,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[572,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86582","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64090","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50026","المتدارك"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21665","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52062","الكامل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116535","الكامل"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139331",""],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20467","المتقارب"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204906","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204582","الكامل"],[3568,"","https://poetry.dctabudhabi.ae/diwan/poem/116520","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108274","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4830,"وقفات زمنية","https://www.poetsgate.com/ViewPoem.aspx?id=193823",""],[4858,"غفلة وتوبة","https://www.poetsgate.com/ViewPoem.aspx?id=30104",""],[4858,"الطيرُ في بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=33864",""],[4858,"حان الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=139695",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5431,"كليّ معك ...","https://www.poetsgate.com/ViewPoem.aspx?id=199533",""],[5460,"شرب النبيذ على الطعام ثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=200757",""],[5847,"شموخ","https://www.poetsgate.com/ViewPoem.aspx?id=209060",""],[5906,"ملاك","https://www.poetsgate.com/ViewPoem.aspx?id=187982",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6152,"لا دفء لي حماكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203290",""],[463,"هل تحت ليلك بالغضا من رائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60040&r=&rc=96",""]],"verses":[["فَتَظهَرُ لِلأَلبابِ في الغَربِ تارَةً","وَطَوراً عَنِ الأَبصارِ تَغرُبُ في الشَرقِ",0,"ق",1,0],["فتظلُّ فيه بخير مُصْطَحَبٍ","وكأنها في شرِّ مُصْطَحَبِ",1,"ب",1,0],["فَتَظاهَروا بِالزُهدِ حَتّى أَشَكَت","تَخفى دَخائِلُهُم عَلى اليَقظانِ",2,"ن",1,0],["فتظن أبيضها أشعة كوكب","وتخال أحمرها دما مطلولا",3,"ل",2,0],["فتظن ابيضا اشعة كوكب","وتخال احمرها دما مطلولا",4,"ل",2,0],["فَتَظَلُّ تَحسُدُكَ المُلوكُ الصيدُ بي","وَأَظَلُّ يَحسُدُني بِكَ الشُعَراءُ",5,"ا",2,0],["فتَظَلَّ فَضفاضَ المَواهبِ سَاحباً","بُرْدَيْنِ للنَّعماءِ فَضفاضَيْنِ",6,"ن",1,0],["فَتَظَلُّ تَرقُمُ في الصُخورِ أَهِلَّةً","بِشَبا حَوافِرِها وَإِن لَم تُنعَلِ",7,"ل",1,0],["فَتظَلُّ تَضرِبُ فِي جوَانِبِهِ وَمَا","تُلْقِي إِلى نُذُرِ الحُبُوطِ بِبَالِ",8,"ل",1,0],["فَتَظَلُّ كُلُّ حَقِيقَةٍ","فِيهَا مَحَلاً لاِرْتِيَابْ",9,"ب",1,0],["فتظلُّ فيه بخير مُصْطَحَب","وكأنها في شرِّ مُصْطخَب",10,"ب",1,0],["فتظهر وجنتاه كل فعل","أسر به سريرته حرام",11,"م",1,0],["فَتَظَلُّ ما بَينَ اِغتَبا","قٍ بِالسَعادَةِ وَاِصطِباحِ",12,"ح",1,0],["فتظلُّ تخبط في قنوطٍ موبِقٍ","فتَعافُ أن تقرا وأن تتذكرا",13,"ر",2,0],["فتَظلُّ من أشواقها","تبكي بعينٍ هاميه",14,"ي",2,0],["فتظنّ البروق منها سيوفاً","مذهبات سُلَّت من الأغماد",15,"د",1,0],["فتظلّ طوراً في عنانِ سمائها","صُعُداً وطوراً في الحضيضِ الهامدِ",16,"د",1,0],["فتظلُّ إنْ سُلَّتْ على حَذَرٍ","ألْجَسْرَةُ الوَجْناءُ والبَطَلُ",17,"ل",1,0],["فتظلُّ الشمس تشكو فِعْلَهُ","تحتَ جُنْحِ الليل أو تحت القَنا",18,"ن",2,0],["فتظاهرت شُهبُ السما لَمَّا رَأت","شُهبَ البَسيطةِ نالَها مانالَها",19,"ل",3,0],["فتظهر مثل الشمس لا تتستر","ألا نحن قوم قد عرفنا بهولنا",20,"ن",2,0],["فتظهر أغياراً له وهو عينها","يحس به الذوق السليم المشاهد",21,"د",1,0],["فتظهر في الروح العوالم كلها","عكوس مرادات الإله شوارد",21,"د",1,0],["فَتَظَلُّ مِنْها بِاليَسَارِ لَهُ","قَبْضٌ وَبِالْيمُنَى لَهُ بَسْطُ",22,"ط",1,0],["فَتظلّ تصدم بِالجِبال وَجوهها","حَتّى تُرى مَنثورة كَهباء",23,"ا",2,0],["فتظنّوا من صَوْلَةِ ابنِ عليٍّ","فيهمُ أَنَّهُ عليٌّ عاشا",24,"ش",2,0],["فتظلُّ تنطقُ وهي ساكتةٌ","إنَّ الرياضَ سكوتُها نُطْق",25,"ق",1,0],["فتظل تدرْ لنا لبناً","يتميّز من فَرثٍ وَدَمِ",26,"م",1,0],["فَتَظَلُّ تَعرِفُ ما عَرِفتَ تَوَهُّماً","مِنها وَتُنكِرُ واقِفاً أَبدالَها",27,"ل",3,0],["فتظلُّ تُنشِزُ في عظامٍ رَطبَةٍ","حتى تُجَرِّدَها من الديدانِ",28,"ن",1,0],["فَتَظَاهَرُوا بِبَنِي شَقِيقِِ أبِيهِمُ","حَتَّى يَكُونُوا فِي المَآلِ ظَهِيرَا",29,"ر",2,0],["فتظلّمي من ناظرٍ أو ناظرٍ","وتألُّمي من حاجبٍ أو حاجبِ",30,"ب",1,0],["فتظلمُ بغدادُ ويجلوُ لنا الدُجى","بمكة ما حجَوا ثلاثة أقمرٍ",31,"ر",1,0],["فتظن عينك انهم صرعى وهم","في خير دار فارهين رقودا",32,"د",2,0],["فَتُظلَمَ بِالودِّ مِن وَصلِهِ","رَقيقٌ فَتَسفِهِ أَو تَندَما",33,"م",2,0],["فَتَظَلُّ تَنبُتُ منهُ أجسَامُ الوَرَى","وَلُحُومُهُم كَمَنَابِتِ الرَّيحَانِ",34,"ن",1,0],["فَتَظَلُّ تَصعَدُ فِي سَمَاءِ فَوقَهَا","أخرَى إلَى خَلاَّقِهَا الرَّحمنِ",34,"ن",1,0],["فتظل تمطرهم بطيب ما رأوا","شبها له في سالف الأزمان",34,"ن",1,0],["فتظل أنت بجبهتين محارباً","فمع الهوى ومع الورى بتصادم",35,"م",1,0],["فتظل واجمة وليس تجيبه","إلا بزفرة قلبها المتوجع",36,"ع",1,0],["فتظنها من ثم غير عصية","وتخالها من ههنا كالعضلد",37,"د",1,0],["فتظهرَ باريس لديهم جديدةً","فتظهرَ أبهى من قديم وأفخما",38,"م",2,0],["فَتَظهَرُ نَفسُ المَرءِ كامِلَةَ البَها","وَمِن نُسخَةِ الأَكوانِ فيها خَلائِعُ",39,"ع",1,0],["فتظنّهم جمعاً بألسنةٍ","شتَّاً اِذاما حلَّتِ المِحَنُ",40,"ن",1,0],["فتظفر بالشفاعة من رؤوفٍ","بأمته، وغفْران القديْرِ",41,"ر",1,0],["فتظلُّ طيورُكِ في فَزَعٍ","لا تأمنُ حتّى في الحُلُمِ!",42,"م",1,0],["فتظلّ تشرق سمسهم في روضنا","ونظلّ ننشق ريحهم والطّيبا",43,"ب",2,0],["فتظل تستعر استعاراً يأكل الإ","يمان من حب ومن إجلال",44,"ل",1,0],["فتظلم أرجاء البلاد من الشيء","وهذا الفساد المستفاد من الخطل",45,"ل",1,0],["فتظلّ في زخم الحصا","د معانقا من أشبعك",46,"ك",1,0],["فتظلّ بين الضاحكين كبومة","عمياء بين جماعة الغربان",47,"ن",1,0],["فتظنُّ العقولُ بالبحرِ ضعفاً","وهي فيهِ كنقطةٍ في مدارِ",48,"ر",1,0],["فتظن سرَّ الكون تحت جفونها","والسرُّ يكتم بعضه رمشاها",49,"ا",3,0],["فَتَظاهَرتِ بِالبَراءَةِ بَينا","ناهِداكِ البَضَّانِ يَنتَطِحانِ!",50,"ن",1,0],["فتظل مضرمة على أجفاننا","نارا, وتشعل ليلنا أسقاما",51,"م",2,0],["فتظلّ طورا غي عنان سمائها","صعدا وطورا في الحضيض الهامدِ",52,"د",1,0]]}