من الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55748&r=&rc=11",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""],[6243,"بَرَدُ الشمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84435&r=&rc=9",""],[463,"تظنُّ ليالينا عودا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60026&r=&rc=82",""],[6267,"تَمَتَّعْ بها ما ساعَفَتْكَ ولا تَكُنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8354&r=&rc=63",""],[6268,"عَدُّودَةُ الخُروج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82921&r=&rc=7",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""],[6300,"نرجسيّة قلمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82865&r=&rc=36",""],[5567,"عتم الآهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81816&r=&rc=66",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["تَمتَريهِ هَوجاءُ مِن قِبَلِ الغَو","رَين نَزعَ الدِلاءِ بِالأَشطانِ",0,"ن",1,0],["تَمَّت وَتَمَّ الحُسنُ في وَجهِها","فَكُلُ حُسنٍ ما خَلاها مُحال",1,"ل",1,1],["تَمَتَّع بِذا اليَومَ القَصيرَ فَإِنَّهُ","رَهينٌ بِأَيّامِ الشُهورِ الأَطاوِلِ",2,"ل",1,0],["تَمَتَّع بِها ما سَعَفَتكَ وَلا تَكُن","عَلَيكَ شَجاً في الحَلقِ حينَ تَبينُ",3,"ن",1,1],["تمتّعْ فالزّمانُ لَنا كفِيلٌ","بإيجازِ المؤمَّلِ والوعودِ",4,"د",1,0],["تَمَتَّع مِنَ الدُنيا فَإِنَّكَ فاني","مِنَ النَشَواتِ وَالنِساءِ الحِسانِ",5,"ن",1,0],["تَمَتيْتُ لَوْ كُنْتِ فِي حَالَةٍ","وَعَنْ أَحَدٍ مَرَّةً رَاضِيَهْ",6,"ه",1,1],["تمَّت بِرُؤْيَتِكَ المُنى فحكَتْ","حِلماً تَمَتَّعْنَا بِرُؤْيَاهُ",7,"ا",2,0],["تَمَتَّعُوا وَتَمَلَّوا مَا يَطِيبُ لَكُم","وَلا تَزَعْكُمْ مَحَاظِيرٌ وَلا حُرَمُ",8,"م",1,0],["تَمَّتْ فُتُوحٌ مُذْ وَلِيتَ عَزِيزَةٌ","لَمْ تَتَّسِقْ لِمُوَفَّقٍ فِي عَامِ",9,"م",1,0],["تَمَّت مَقابِحُ وَجهِهِ فَكَأَنَّهُ","طَلَلٌ تَحَمَّلَ ساكِنوهُ فَأَوحَشا",10,"ش",2,1],["تَمَّت إِلى حَسَبٍ ما فَوقَهُ حَسَبٌ","مَجداً وَزَيَّنَ ذاكَ الحُسنُ وَالطيبُ",11,"ب",1,0],["تَمَّت جَمالاً وَديناً لَيسَ يَقرَبُها","قَسُّ النَصارى وَلا مِن هَمِّها البِيَعُ",12,"ع",1,0],["تَمَّت تَميمي يا أُخَيطِلُ فَاِحتَجِز","خَزِيَ الأُخَيطِلُ حينَ قُلتُ وَقالا",13,"ل",2,0],["تمتَّع مولانا بعمرة حجَّةٍ","وها نحنُ في نعمائه نتمتَّع",14,"ع",1,0],["تمتعت يا إيري بغانيةٍ لها","أمامٌ وخلفٌ وطيبٌ ملتقاها",15,"ه",2,1],["تمتنع النفسُ إذا فكّرت","فيها من المأكل والمشربِ",16,"ب",1,0],["تُمتِّع الحِدْث من مُلاعَبَةٍ","تنزل بين المجون والحصرِ",17,"ر",1,0],["تمَّت معانيه منه في امرئٍ نصفٍ","زولٍ أطال على الأحوال توقافا",18,"ف",2,0],["تمتَّعْ من أخيك فما أُراهُ","يراكَ ولا تراهُ بعد يومِكْ",19,"ك",1,0],["تَمَّت جُدودُهُمُ وَاللَهُ فَضَّلَهُم","وَجَدُّ قَومٍ سِواهُم خامِلٌ نَكِدُ",20,"د",1,0],["تَمَّت لِمَن نَعَتِ النِساءَ وَأُكمِلَت","ناهيكَ مِن حُسنٍ لَها وَجَمالِ",21,"ل",1,0],["تَمتَدُّ فيه وَفي ثَراهُ عُروقُها","وَيَسيلُ تَحتَ فُروعِها وَيَسيرُ",22,"ر",1,0],["تَمتَدُّ فيهِ بِيَ الكَآبَةُ وَالأَسى","مِثلَ اِمتِدادِ الحَرفِ بِالتَحريكِ",23,"ك",1,0],["تَمَتَّعتُ مِنها يَومَ بانوا بِنَظرَةٍ","وَهَل عاشِقٌ مِن نَظرَةٍ يَتَمَتَّعُ",24,"ع",1,0],["تمتد من شغف لها الانظار من","حسرى تكل من العياء وضلع",25,"ع",1,0],["تمتد في كل الجهات وتملأ","الابعاد حتى ليس يخلو موضع",26,"ع",1,0],["تمتع بلذات الحياة فإنها","إذا ما انقضت يوماً فليس لها بقيا",27,"ي",2,1],["تَمَتّعْ مِنَ الدُّنيا فإنّكَ فاني","وإنّكَ في أَيْدي الحوادِثِ عاني",28,"ن",2,1],["تَمَتّعْ بها ما ساعَفَتْكَ ولا يَكُنْ","عليكَ جَوىً في الصَّدْرِ حينَ تَبينُ",29,"ن",1,1],["تَمَتَّع مِن سُهادِ أَو رُقادٍ","وَلا تَأمُل كَرىً تَحتَ الرِجامِ",30,"م",1,0],["تمتاحُ من قعرِ الثَّرى رِيَّها","أشطانُها عفواً ولم تَجذِبِ",31,"ب",1,0],["تَمَّت لَكَ النُعمى وَدا","مَ لَكَ التَعَلّي وَالتَزَيُّد",32,"د",1,0],["تَمَّت لَكَ النَعماءُ فيهِ مُمَتَّعاً","بِعُلُوِّ هِمَّتِهِ وَوَريِ زِنادِهِ",33,"د",2,0],["تمتَّعْ من اللَّذَّاتِ قبلَ نَفادِها","وبادِرْ فإنّا للخُطوبِ فَرائِسُ",34,"س",1,0],["تَمَتَّع بِها ما ساعفَتكَ وَلا تَكُن","عَلَيكَ شَجَىً في الصَدرِ حينَ تَبينُ",35,"ن",1,1],["تمتعت منه ومن كاسه","بترجيجها وبتشفيفه",36,"ف",2,0],["تَمَّت مَحاسِنُهُ بِحُسنِ خَلاقِهِ","وَسَنا فَزادَ الحُسنُ بِالحَسَناتِ",37,"ت",1,0],["تَمَّت مَعاني الحُسنِ في وَجهِهِ","حَتّى غَدا يُدعى أَميرَ المِلاح",38,"ح",1,0],["تمتحُ بالأَرسانِ أرْماقَهَا","إِلى الرَشيدِ المَلِكِ المُستَماح",39,"ح",1,0],["تَمَتَّع مِن ذَرى هَضَباتِ نَجدٍ","فَإِنَّكَ مُوشِكٌ أَلّا تَراها",40,"ه",2,1],["تَمَتَّع بِلَيلى إِنَّما أَنتَ هامَةٌ","مِنَ الهامِ يَدنو كُلَّ يَومٍ حِمامُها",41,"م",3,0],["تَمَتَّع مِن شَميمِ عَرارِ نَجدٍ","فَما بَعدَ العَشيَّةِ مِن عَرارِ",42,"ر",1,0],["تَمَّت رِوايَتُها الكُبرى وَأَودَعَها","خَزائِنَ الدَهرِ وَالأَجيالِ راويها",43,"ي",3,0],["تَمَّت بِهِم حالٌ لَهُم مِثلُ الرَخا","أَخافَ طَيرَ أَرضِهِ وَدَوَّخا",44,"خ",2,0],["تمتَدُّ ألسِنَةُ الصَّواعقِ فوقَهُ","عن ظُلَّتَيْ مُزْنٍ عليه كنَهْوَر",45,"ر",1,0],["تَمَّت فَلَم يَرَ إِنسانٌ لَها شَبَهاً","فيمَن بَرى اللَهُ مِن عُجمٍ وَمِن عَرَبِ",46,"ب",1,0],["تَمَتَّع مِن شَبابٍ لَيسَ يَبقى","وَصِل بِعُرى الغَبوقِ عُرى الصَبوحِ",47,"ح",1,0],["تَمَّت مَلاويهِ حَتّى خِلتَ خِلقَتَها","أَصابِعاً حُرِّكَت مِن مِفصَلِ جارِ",48,"ر",1,0],["تَمَّت وَتَمَّ الحُسنُ في وَجهِها","فَكُلُّ شَيءٍ ما خَلاها مُحال",49,"ل",1,1],["تمتع بالخمورِ وباللواط","ولا تخشَ المرورَ على الصراط",50,"ط",1,1],["تَمَّت قَواماً وَعَمَّت في مَجاسِدِها","كَأَنَّها مِن جَواري الجَنَّةِ الحورِ",51,"ر",1,0],["تَمَّت لَكَ البُطونُ وَالظُهورُ","كَالبُردِ لَمّا تَمَّ فيهِ النيرُ",52,"ر",1,0],["تَمَتَّع مِنَ اللَذّاتِ وَاِستَبقِ مَنصِباً","فَإِنَّكَ لاقي القَومِ قَد جَفَلوا بَردا",53,"د",2,0],["تَمَّت تَرائِبُها إِلى قَدَمٍ","وَالساقُ مُكمَلَةٌ إِلى العَضُدِ",54,"د",1,0],["تَمَتَّعتُ مِن وُدِّ الشَبابِ الَّذي مَضى","مَعَ البيضِ أُسقى ريقَهُنَّ مَعَ الراحِ",55,"ح",1,0],["تَمَتَّعَ أَبكارُ الزَمانِ بِأَيدِهِ","وَجِئنا بِوَهنٍ بَعدَما خَرِفَ الدَهرُ",56,"ر",1,0],["تَمتَّع بِنَوْمٍ لَمْ تُمَتَّعْ بِمِثْلِهِ","وَأَخْلِ فُؤَاداً طَالَمَا بَاتَ مُشْغَلاَ",57,"ل",2,0],["تَمَتَّعْ بِالْهَوى الْعُذْرِي","وَلُطْفِ الرِّفْقَةِ الغُرِّ",58,"ر",1,1],["تمتص أَفواه الشبيبة روحه","مثل امتصاص النحل للأزهار",59,"ر",1,0],["تمَّت على نَغم القرآن وحدتهُ","كأنما سحَرَ الألباب ساحره",60,"ر",2,0],["تمتع فالزمان لنا كفيل","بإنجاز المؤمل والوعود",61,"د",1,0],["تمتطي كفّها الهدايا ولكنّ","كلّ مهد لا يمتطي منكبيها",62,"ي",3,0],["تمتطي موجة إلى غير مرسى","إن وجدّنا ريحا فقدنا الشراعا",63,"ع",2,0],["تَمَتَّعْتُ مِنْ وُدِّ الشِّبَابِ الذِي مَضَى","مع البيض أسقى رقهن مع الراح",64,"ح",1,0],["تَمَتَّعْتُ في رَغدٍ مُخصِب","وهُذّبتُ في يَبَسٍ مُجدِب",65,"ب",1,0],["تمتصّني أمواج هذا الليل في شّره صموت","وتعيد ما بدأت … وتنوي أن تفوت ولا تفوت",66,"ت",1,1],["تمتع من نسيم بقاع سلع","ونشر المسك من تلك الرياض",67,"ض",1,1],["تمت محاسن أحمدٍ بغرائب","سبق الأوائل نحوهن أواخرُ",68,"ر",1,0],["تَمْتَصُّ أوْجاعاً تفرعن رَوْعُها","والحلمُ ممهورٌ بِنزفٍ مُسْتَبِدْ",69,"د",1,0],["تَمَتَّعتُ مِن أَهلِ الكثِيبِ بنَظَرَةٍ","وقَد قِيلَ ما بَعدض الكثِيبِ كَثِيبُ",70,"ب",1,0],["تَمتّع بِها إِن كنتَ تَهوى محمّداً","وَإلّا لأهليها فَدَعها فَهُم أدرى",71,"ر",2,0],["تَمّت مَحاسنُهُ فَما يُزري بِهِ","مَعَ فَضلِهِ وَسَخائِهِ وَكَمالِهِ",72,"ل",2,1],["تمتَّعْ بالمَسَرَّةِ والشبابِ","فقد بَرز الرَّبيع من الحجاب",73,"ب",1,1],["تَمَّت فَواضِلُهُ عَلى سُؤالِهِ","وَنَمت فَعَمَّت كُلَّ مَن لَم يَسألِ",74,"ل",1,0],["تمتع من الدنيا وَفِ النفسَ حقَّها","وأنتَ لأنواعِ الجمالِ طروب",75,"ب",1,0],["تمتّع من الدُّنيا التي أنا طيبُها","فما نيلُها إِلا بنيلِ جماليا",76,"ل",3,0],["تَمُتُّ بِآمالٍ إِلَيْكَ كَأَنَّها","رِقابُ صَوادٍ يَعْتَرِكْنَ عَلَى وِرْدِ",77,"د",1,0],["تَمَتَّع بِأَنفاسِ الضُحى وَالأَصائِلِ","وَحُثَّ كُؤوسَ الراحِ حُمرَ الغَلائِلِ",78,"ل",1,1],["تمت ضل وهوى","بكبره المعظم",79,"م",1,0],["تمتعت من وجه الحبيب بنظرةٍ","فأصبح في عطفي هزة نشوانِ",80,"ن",1,1],["تمت وصلوا على المختار سيدنا","والآل والصحب قوم حبهم يجب",81,"ب",1,0],["تمت وصلوا على المختار هادي السبيل","والآل والصحب في غدواتها والأصيل",82,"ل",1,0],["تمت وصلوا على رسول","أيد بالنصر في حنين",83,"ن",1,0],["تَمَّت قَصيدَةُ حَقٍّ غَيرَ ذي كَذِبٍ","في حَوكِها مِن كَلامِ الشِعرِ تَأليفُ",84,"ف",1,0],["تَمَتَّع بِمالِكَ قَبلَ المَماتِ","وَإِلّا فَلا مالَ إِن