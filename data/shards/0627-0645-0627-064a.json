5320,"حضارة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=40425",""],[5381,"أعدّ اللهُ للشُّعراءِ ناراً","https://www.poetsgate.com/ViewPoem.aspx?id=214627",""],[5431,"ملكَ القصيدة قبلةً قبلهْ!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200159",""],[5516,"هزي إليك","https://www.poetsgate.com/ViewPoem.aspx?id=212249",""],[5528,"صلاة دافئة في محراب نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=201275",""],[5612,"إلى الرّحمنِ أضْرَعُ في الكُروبِ","https://www.poetsgate.com/ViewPoem.aspx?id=179483",""],[5629,"الحاجه","https://www.poetsgate.com/ViewPoem.aspx?id=184549",""],[5690,"هي التهاني لقطر الشام نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=172191",""],[5690,"أما ينقضي هذا التدلل والصدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=172154",""],[5776,"لوحةٌ رسَمَها دمُ الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=199919",""],[5801,"حُب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188006",""],[5829,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151690",""],[5829,"رحلة في تضاريس الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=181380",""],[5844,"كان لها عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=139719",""],[5848,"الذيابه تعاوي","https://www.poetsgate.com/ViewPoem.aspx?id=53449",""],[5877,"فتل الاشناب","https://www.poetsgate.com/ViewPoem.aspx?id=37471",""],[5939,"شعورُ الحبِّ لا يكفي!","https://www.poetsgate.com/ViewPoem.aspx?id=178603",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5956,"دفاع عن الحظائر *","https://www.poetsgate.com/ViewPoem.aspx?id=183370",""],[5956,"تركتُ البِيدَ عكس ما توخيت","https://www.poetsgate.com/ViewPoem.aspx?id=183701",""],[5956,"أرجو أن تترجِم للغريب","https://www.poetsgate.com/ViewPoem.aspx?id=184257",""],[6056,"ضاع الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=130500",""],[6102,"سمسمة 2","https://www.poetsgate.com/ViewPoem.aspx?id=184414",""],[6125,"أما يَشتاقُ قلبُكِ في اللياليْ","https://www.poetsgate.com/ViewPoem.aspx?id=210955",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""]],"verses":[["أَم أَينَ ذاكَ الرَأيُ في إِبعادِهِ","حَنَقاً وَأَينَ حَمِيَّةُ الغَضبانِ",0,"ن",1,0],["أَما يَحلَمُ الدَهرُ في فِتيَةٍ","أَماتوا المَلامَ بِجَهلِ المُدامِ",1,"م",1,0],["إِمّا يُقالُ سَعى فَأَحرَزَها","أَو أَن يُقالَ مَضى وَلَم يَعُدِ",2,"د",1,0],["أَما يُرهَبُ القَطّاعُ إِلّا مُجَرَّدا","أَما يُتَّقى العَسّالُ إِلّا مُسَدَّدا",3,"د",2,0],["أَما يُمحى عِتابُكَ كُلَّ يَومٍ","أَما يُرجى إِلى وَصلٍ وُصولُ",4,"ل",1,0],["أمَّا يَرَاعَتُهُ فَقُلْ مَا شِئْتَ فِي","لَفْظٍ تَفِيضُ بِدُرِّهِ وَمَعَانِ",5,"ن",1,0],["أَمَا يَشْفَعُ الفَضْلُ فِي فَاضِلٍ","أَمَا يَشْفَعُ الْعِلْمُ فِي عَالِمِ",6,"م",1,0],["أَمَا يُنسيكَ رَوضَةَ شَحطُ دارٍ","وَلا قربٌ إِذَا كَانَت قَريبَا",7,"ب",2,0],["إمّا يفاخرْ بالعتاد ففخْرُه","بالمشرفية والقنا الخطّارِ",8,"ر",1,0],["أم أين بركة زلزل وزُلالها الس","لسال تسرح حوله الظَبيَات",9,"ت",1,0],["أم أين كرخايا تمد مياهُه","نهر الدَجاج فتكثر الغَلاّت",9,"ت",1,0],["أم أين نهر الملك حين سلسلت","فيه المياه وهن مُطَردات",9,"ت",1,0],["أم أين نهر بطاطيا تأتيه من","نهر الدُجَيل مياهه المُجْراة",9,"ه",1,0],["أَما يَدَعُ الزِناءَ أَبو فِراسٍ","وَلا شُربَ الخَبيثِ مِنَ الشَرابِ",10,"ب",1,0],["أَمّا يَزيدُ فَإِنَّ اللَهَ فَهَّمَهُ","حُكماً وَأَعطاهُ مُلكاً واضِحَ النورِ",11,"ر",1,0],["أَمّا يَميني فَهيَ عِندي غالِيَه","وَكَلمَتي مِثلُ يَميني وافِيَه",12,"ه",1,0],["أَما يَردَعُ المَوتُ أَهلَ النُهى","وَيَمنَعُ عَن غِيِّهِ مَن غَوى",13,"ا",1,1],["أما ينفك قدري في نزول","ببلدتكم وفي جسمي طلوع",14,"ع",1,0],["أما يستديمُ المرءُ نعمةَ ربّهِ","بإكرامِ أحرارِ الرجالِ ببابِهِ",15,"ب",2,1],["أما يتذكَّر لي أنني","تخيرت صلعته مقْفَدا",16,"د",2,0],["أما يكفيك أنَّكِ تملكيني","وأن الْخلق كلَّهُمُ عبيدي",17,"د",2,0],["أما يُعفِّي على جرائم ما اس","تقدَمَ منه متابَ منتظرِ",18,"ر",1,0],["أما يرعى جلالَ الحقِّ حُرٌّ","وإن حَجدت بَصيرتُه جلالي",19,"ل",2,0],["أَما يَزيدُ فَإِنّي لَستُ ناسِيَهُ","حَتّى يُغَيِّبَني في الرَمسِ مَلحودُ",20,"د",1,0],["أَما يُكَفْكِفُ هذا الزَّ","مانُ صَوْبَ البَلايا",21,"ي",2,0],["أَما يَخجَلُ المَجدُ أن يُرحِلوك","وَلَم يَصحبوكَ خباءً مُعارا",22,"ر",2,0],["أما يراعك فهو معزو له","ما تم للآداب من إصلاح",23,"ح",1,0],["أما يكفى أباك السبق حتى","أتى بك أطول الشعراء باعا",24,"ع",2,0],["أَما يَستَفيقُ الدَهرُ عَن نَزَقاتِهِ","فَيُصبِحُ مُستَثنىً لَدَيهِ الأَماجِدُ",25,"د",1,0],["أما يتَّقِي قرعى الفِصال استنانها","وقد عَجَّ تحت العبءِ بُزْلٌ مصاعيبُ",26,"ب",1,0],["أما يخافُ بني عمٍّ لنْا غُيُراً","يحمون بالقُضُبِ الهنديةِِ الحَسَبَا",27,"ب",2,0],["أَما يَظفَرُ المَحرومُ عِندَكِ بِالجِدا","وَلا يَطمَعُ المَظلومُ عِندَكِ في النِصفِ",28,"ف",1,0],["أَمّا يَزيدُ فَإِنَّهُ تَأبى لَهُ","نَفسٌ مُوَطَّنَةٌ عَلى المِقدارِ",29,"ر",1,0],["أَم أيُّ وِهْمٍٍ رامَ كُنْهَ صِفاتِه","مُتَحيِّراً فيه فلم يَتحيَّرِ",30,"ر",1,0],["أَم أَيُ شَعبٍ لِاِلتئا","مٍ لَم يُفَرِّقهُ اِنصِداعُهُ",31,"ع",2,0],["أَما يَهولُكَ يَومٌ لا دِفاعَ لَهُ","إِذ أَنتَ في غَمَراتِ المَوتِ مُنغَمِسُ",32,"س",1,0],["أَم أَينَ كِسرى أَزدَشيرُ وَقَيصَرٌ","وَالهُرمُزانِ وَقَبلَهُم سابورُ",33,"ر",1,0],["أَما يَخجَلُ البحرُ الأُجاجُ حُلولَه","ببحرٍ فراتٍ ما للجَّتِهِ عَبرُ",34,"ر",1,0],["أما يتهلّلُ المحزونُ إلا","رمته يدُ الحوادثِ بالشُّحوبِ",35,"ب",1,0],["أَما يَرَونَ بَوادينا سِوى نَعَمٍ","وَلا يُصيبونَ مِنّا غَيرَ قِطعانِ",36,"ن",1,0],["أَمّا يَنهى دُعاةَ السوءِ عَنّا","طَويلُ هَوادَةٍ وَجَميلُ رِفقِ",37,"ق",1,1],["أَما يَسأَلونَ الدَهرَ إِذ نَحنُ أُمَّةٌ","نَسوسُ الوَرى ساداتِهِم وَالمَوالِيا",38,"ي",2,0],["أَما يرضيكَ عَمَّن عَقَّ مِنّا","رِجالٌ بِالوَفاءِ لَها اِتِّسامُ",39,"م",1,0],["أما يَنبغِي لكِ أن تَعرفِي","شُيوخَ الحُروبِ وأطفالها",40,"ل",3,0],["أما يفنى الطّعينُ ولا الضَّرِيبُ","لِواءٌ ليس يحملهُ عَسِيبُ",41,"ب",1,0],["أَم أَيّ راعٍ بِلا ذئبٍ يُجاوره","إِن لَم تَجد راعياً شَراً مِن الذيبِ",42,"ب",1,0],["أما يُرَى لَكَ فيما سَرَّ مِنْ عَمَلٍ","يَوْماً نَشاطٌ وعَمَّا ساءَ تَكسِيلُ",43,"ل",1,0],["أَما يَسُرُّكَ أَنَّ الرَرضَ زَهراءُ","وَالخَمرُ مُمكِنَةٌ شَمطاءُ عَذراءُ",44,"ا",2,1],["أَما يَتَفَكَّرُ أَحيائُها","فَيَعتَبِرونَ بِأَمواتِها",45,"ت",3,0],["أَما يَفنى حَديثُكَ عَن جِنانِ","وَلا تُبقي عَلى هَذا اللِسانِ",46,"ن",1,1],["أَما يَنهاكَ يا حَمّا","دُ ذِكرُ المَوتِ وَالقَبرُ",47,"ر",1,0],["أَما يَنفَعُني عِندَ","كِ قَولٌ مُعجِبٌ قُلتُه",48,"ت",2,0],["أَما يَرى الإِنسانُ في نَفسِهِ","آياتِ رَبٍّ كُلُّها غُرُّ",49,"ر",1,0],["أَما يُعطي ذَوي الحاجاتِ حَقّاً","وَفَوقَ شَواتِهِ السَيفُ السِقاطُ",50,"ط",1,0],["أَما يقيني فآت عن مشاهدة","وَفي الشهادة علم دونه الخبر",51,"ر",1,0],["إِمّا يُدَل مِنكَ بِالمَوتِ العِدى فَبِما","دارَت عَلَيهِم بِلا مَوتٍ لَكَ الدُوَلُ",52,"ل",1,0],["أما يرى ذلك الصَّبِيَّا","يُؤلّب البحرَ والظلاما",53,"م",2,0],["أما يفيق المرء من سكره","مجتهداً في سيره والسرى",54,"ر",2,1],["أما يمشي عبادُ الله هَوْنًا","كما في آية الذِّكْرِ الحكيم؟",55,"م",1,0],["أما يحرككم أن قال ناصحكم","الأصل كاس وفرع الأصل عريان",56,"ن",1,0],["أما يسألون الدهر إذ نحن أمة ٌ","نسوس الورى ساداته والمواليا",57,"ي",2,0],["أما يسُرُّكَ أنَّ الأرضَ زَهْراءُ","والخمرُ ممكنتٌ، شمْطاءُ عذْراءُ",58,"ا",2,1],["ام اين نهر الملك حين تسلسلت","فيه المياه وهنَّ مطردات",59,"ت",1,0],["أما يجل حديث عن مهازلة","ولا يدرك عنها قحمة العقل",60,"ل",1,0],["أما يثقل هذا الدهر أرجله","أليس في الدهر أروادٌ وإمعان",61,"ن",1,0],["أما يرى غايتي في الشعر واحدةً","وإن تباين أوزانٌ وأوزان",61,"ن",1,0],["إما يصيبُ جازئا","من قُوته أو أجدَلا",62,"ل",2,0],["أَم أَيَّ يَومِ وَغىً شَهِدتَ فَلَم يَكُن","يَوماً أَغَرَّ مُحَجَّلاً مَشهودا",63,"د",2,0],["أما يختشي من أن يكون مخدّدا","ويدخل في من حاز أفظع قولة",64,"ه",1,0],["أما يمين محمد","ويساره فهما سماء",65,"ا",2,1],["أما يستحي من يدعي ذاك منكم","ويوجع ضربا بالعصا ويغرب",66,"ب",1,0],["أَما يَستَفِيقُ القَلبُ إِلاّ انبَرى لَهُ","تَوَهُّمُ صَيفٍ مِن سُعادِ وَمَربَعِ",67,"ع",1,1],["أَما يَستحقُّ الذمَّ يا قوم والدٌ","أَعزُّ بنيهِ لا يشدُّ به أزرا",68,"ر",2,0],["أَما يُنصِفونَ القومَ فالأمر واحدٌ","كِلاهم عنِ الدينِ القويم قد اِزورّا",68,"ر",2,0],["أَما يَستحيلُ اللَحمُ والدمُ في الحشا","إِلى قَذرٍ لا أَستحبُّ لَه ذكرا",68,"