{"poems":[[55,"ونمى إلي من العجائب أنه","https://www.aldiwan.net/poem29657.html","الكامل"],[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[55,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[75,"عذيري من خليل يستطيل","https://www.aldiwan.net/poem11907.html","الوافر"],[95,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[95,"لقد فدح الخطب في قاسم","https://www.aldiwan.net/poem11334.html","المتقارب"],[43,"أبت بالشام نفسي أن تطيبا","https://www.aldiwan.net/poem42381.html","الوافر"],[85,"لولا تألق بارق التذكار","https://www.aldiwan.net/poem54296.html","الكامل"],[90,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[29,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[29,"حي الديار على سفي الأعاصير","https://www.aldiwan.net/poem5763.html","البسيط"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[49,"أما يردع الموت أهل النهى","https://www.aldiwan.net/poem25384.html","المتقارب"],[74,"أبثك يا أخا العلياء أني","https://www.aldiwan.net/poem19250.html","الوافر"],[53,"أما يستديم المرء نعمة ربه","https://www.aldiwan.net/poem8532.html","الطويل"],[53,"هجاني حفيص ولم أهجه","https://www.aldiwan.net/poem61875.html","المتقارب"],[53,"أرى ماء وبي عطش شديد","https://www.aldiwan.net/poem61969.html","الوافر"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[31,"بانت سعاد ففي العينين تسهيد","https://www.aldiwan.net/poem6030.html","البسيط"],[94,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[80,"هم أوقدوا بين جنبيك نارا","https://www.aldiwan.net/poem14207.html","المتقارب"],[91,"الزهر أكبر مصرع الصداح","https://www.aldiwan.net/poem44607.html","الكامل"],[87,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[64,"قالت وقد سمعت أني نسبت بها","https://www.aldiwan.net/poem52491.html","البسيط"],[47,"ومهتزة الأعطاف نازحة العطف","https://www.aldiwan.net/poem65147.html","الطويل"],[30,"لأمدحن بني المهلب مدحة","https://www.aldiwan.net/poem5176.html","الكامل"],[63,"غنت تحاوره بطرف أحور","https://www.aldiwan.net/poem51605.html","الكامل"],[60,"قصر الجديد إلى بلى","https://www.aldiwan.net/poem30968.html","مجزوء الكامل"],[51,"ما يدفع الموت أرصاد ولا حرس","https://www.aldiwan.net/poem62122.html","البسيط"],[68,"خفض همومك فالحياة غرور","https://www.aldiwan.net/poem40119.html","الكامل"],[82,"خيالك للأجفان مثله الفكر","https://www.aldiwan.net/poem31436.html","الطويل"],[107,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[107,"أما ينهى دعاة السوء عنا","https://www.aldiwan.net/poem43378.html","الوافر"],[107,"ألا لا أرى في مصر إلا دعاويا","https://www.aldiwan.net/poem43396.html","الطويل"],[107,"سلام أيها الملك الهمام","https://www.aldiwan.net/poem43407.html","الوافر"],[107,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[104,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"أما يسرك أن الررض زهراء","https://www.aldiwan.net/poem10403.html","البسيط"],[50,"رضيت لنفسك سوآتها","https://www.aldiwan.net/poem62479.html","المتقارب"],[50,"أما يفنى حديثك عن جنان","https://www.aldiwan.net/poem66094.html","الوافر"],[52,"أبا الحشفان آتيك","https://www.aldiwan.net/poem63799.html","الهزج"],[52,"ألا يا خاتم الملك","https://www.aldiwan.net/poem64747.html","الهزج"],[48,"إصبر فمن حيث أهين الحصى","https://www.aldiwan.net/poem22595.html","السريع"],[48,"وجدت الناس عمهم سقوط","https://www.aldiwan.net/poem22904.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85520","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1314","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147475","السريع"],[108,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[107,"ألا لا أرى في مصر إلا دعاويا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54862&r=&rc=32",""],[50,"أما يسُرُّكَ أنَّ الأرضَ زَهْراءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24835&r=&rc=5",""],[90,"بغدادُ حسبكِ رقدة وسبات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19515&r=&rc=18",""],[123,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[123,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[145,"قلت لعمرو جذلا","https://www.aldiwan.net/poem58372.html","مجزوء الرجز"],[146,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[150,"أقول لقوم لا تقيد نصيحتي","https://www.aldiwan.net/poem47676.html","الطويل"],[153,"أما يمين محمد","https://www.aldiwan.net/poem68458.html","مجزوء الكامل"],[163,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[184,"أما يستفيق القلب إلا انبرى له","https://www.aldiwan.net/poem58744.html","الطويل"],[192,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[201,"أرض منمنمة وظل سجسج","https://www.aldiwan.net/poem51974.html","الكامل"],[202,"عزمت على التجنب أم تدل","https://www.aldiwan.net/poem45603.html","الوافر"],[215,"أمالئة الحجلين ذبت بحبكم","https://www.aldiwan.net/poem37868.html","الطويل"],[238,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[283,"تحراني الزمان بكل خطب","https://www.aldiwan.net/poem60740.html","الوافر"],[301,"أما ينفك قلبك مستطارا","https://www.aldiwan.net/poem36826.html","عموديه"],[334,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[374,"تعود أن يحول وأن يخونا","https://www.aldiwan.net/poem57082.html","الوافر"],[380,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[396,"دمن عفون بذي الأراك","https://www.aldiwan.net/poem53665.html","مجزوء الكامل"],[403,"أمام حجرة عائشة رضي الله عنها","https://www.aldiwan.net/poem6772.html","عموديه"],[440,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[440,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[442,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[460,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[460,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[465,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[467,"يا نائي الدار","https://www.aldiwan.net/poem36226.html","عموديه"],[470,"أبو إسحاق إبراهيم ممن","https://www.aldiwan.net/poem59667.html","الوافر"],[540,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[542,"إما يزال قائل أبن أبن","https://www.aldiwan.net/poem56624.html","الكامل"],[544,"أرى ماء وبي عطش شديد","https://www.aldiwan.net/poem34021.html","الوافر"],[553,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17735","البسيط"]],"verses":[["أَم أَينَ ذاكَ الرَأيُ في إِبعادِهِ","حَنَقاً وَأَينَ حَمِيَّةُ الغَضبانِ",0,"ن",1,0],["أَما يَحلَمُ الدَهرُ في فِتيَةٍ","أَماتوا المَلامَ بِجَهلِ المُدامِ",1,"م",1,0],["إِمّا يُقالُ سَعى فَأَحرَزَها","أَو أَن يُقالَ مَضى وَلَم يَعُدِ",2,"د",1,0],["أَما يُرهَبُ القَطّاعُ إِلّا مُجَرَّدا","أَما يُتَّقى العَسّالُ إِلّا مُسَدَّدا",3,"د",2,0],["أَما يُمحى عِتابُكَ كُلَّ يَومٍ","أَما يُرجى إِلى وَصلٍ وُصولُ",4,"ل",1,0],["أمَّا يَرَاعَتُهُ فَقُلْ مَا شِئْتَ فِي","لَفْظٍ تَفِيضُ بِدُرِّهِ وَمَعَانِ",5,"ن",1,0],["أَمَا يَشْفَعُ الفَضْلُ فِي فَاضِلٍ","أَمَا يَشْفَعُ الْعِلْمُ فِي عَالِمِ",6,"م",1,0],["أَمَا يُنسيكَ رَوضَةَ شَحطُ دارٍ","وَلا قربٌ إِذَا كَانَت قَريبَا",7,"ب",2,0],["إمّا يفاخرْ بالعتاد ففخْرُه","بالمشرفية والقنا الخطّارِ",8,"ر",1,0],["أم أين بركة زلزل وزُلالها الس","لسال تسرح حوله الظَبيَات",9,"ت",1,0],["أم أين كرخايا تمد مياهُه","نهر الدَجاج فتكثر الغَلاّت",9,"ت",1,0],["أم أين نهر الملك حين سلسلت","فيه المياه وهن مُطَردات",9,"ت",1,0],["أم أين نهر بطاطيا تأتيه من","نهر الدُجَيل مياهه المُجْراة",9,"ه",1,0],["أَما يَدَعُ الزِناءَ أَبو فِراسٍ","وَلا شُربَ الخَبيثِ مِنَ الشَرابِ",10,"ب",1,0],["أَمّا يَزيدُ فَإِنَّ اللَهَ فَهَّمَهُ","حُكماً وَأَعطاهُ مُلكاً واضِحَ النورِ",11,"ر",1,0],["أَمّا يَميني فَهيَ عِندي غالِيَه","وَكَلمَتي مِثلُ يَميني وافِيَه",12,"ه",1,0],["أَما يَردَعُ المَوتُ أَهلَ النُهى","وَيَمنَعُ عَن غِيِّهِ مَن غَوى",13,"ا",1,1],["أما ينفك قدري في نزول","ببلدتكم وفي جسمي طلوع",14,"ع",1,0],["أما يستديمُ المرءُ نعمةَ ربّهِ","بإكرامِ أحرارِ الرجالِ ببابِهِ",15,"ب",2,1],["أما يتذكَّر لي أنني","تخيرت صلعته مقْفَدا",16,"د",2,0],["أما يكفيك أنَّكِ تملكيني","وأن الْخلق كلَّهُمُ عبيدي",17,"د",2,0],["أما يُعفِّي على جرائم ما اس","تقدَمَ منه متابَ منتظرِ",18,"ر",1,0],["أما يرعى جلالَ الحقِّ حُرٌّ","وإن حَجدت بَصيرتُه جلالي",19,"ل",2,0],["أَما يَزيدُ فَإِنّي لَستُ ناسِيَهُ","حَتّى يُغَيِّبَني في الرَمسِ مَلحودُ",20,"د",1,0],["أَما يُكَفْكِفُ هذا الزَّ","مانُ صَوْبَ البَلايا",21,"ي",2,0],["أَما يَخجَلُ المَجدُ أن يُرحِلوك","وَلَم يَصحبوكَ خباءً مُعارا",22,"ر",2,0],["أما يراعك فهو معزو له","ما تم للآداب من إصلاح",23,"ح",1,0],["أما يكفى أباك السبق حتى","أتى بك أطول الشعراء باعا",24,"ع",2,0],["أَما يَستَفيقُ الدَهرُ عَن نَزَقاتِهِ","فَيُصبِحُ مُستَثنىً لَدَيهِ الأَماجِدُ",25,"د",1,0],["أما يتَّقِي قرعى الفِصال استنانها","وقد عَجَّ تحت العبءِ بُزْلٌ مصاعيبُ",26,"ب",1,0],["أما يخافُ بني عمٍّ لنْا غُيُراً","يحمون بالقُضُبِ الهنديةِِ الحَسَبَا",27,"ب",2,0],["أَما يَظفَرُ المَحرومُ عِندَكِ بِالجِدا","وَلا يَطمَعُ المَظلومُ عِندَكِ في النِصفِ",28,"ف",1,0],["أَمّا يَزيدُ فَإِنَّهُ تَأبى لَهُ","نَفسٌ مُوَطَّنَةٌ عَلى المِقدارِ",29,"ر",1,0],["أَم أيُّ وِهْمٍٍ رامَ كُنْهَ صِفاتِه","مُتَحيِّراً فيه فلم يَتحيَّرِ",30,"ر",1,0],["أَم أَيُ شَعبٍ لِاِلتئا","مٍ لَم يُفَرِّقهُ اِنصِداعُهُ",31,"ع",2,0],["أَما يَهولُكَ يَومٌ لا دِفاعَ لَهُ","إِذ أَنتَ في غَمَراتِ المَوتِ مُنغَمِسُ",32,"س",1,0],["أَم أَينَ كِسرى أَزدَشيرُ وَقَيصَرٌ","وَالهُرمُزانِ وَقَبلَهُم سابورُ",33,"ر",1,0],["أَما يَخجَلُ البحرُ الأُجاجُ حُلولَه","ببحرٍ فراتٍ ما للجَّتِهِ عَبرُ",34,"ر",1,0],["أما يتهلّلُ المحزونُ إلا","رمته يدُ الحوادثِ بالشُّحوبِ",35,"ب",1,0],["أَما يَرَونَ بَوادينا سِوى نَعَمٍ","وَلا يُصيبونَ مِنّا غَيرَ قِطعانِ",36,"ن",1,0],["أَمّا يَنهى دُعاةَ السوءِ عَنّا","طَويلُ هَوادَةٍ وَجَميلُ رِفقِ",37,"ق",1,1],["أَما يَسأَلونَ الدَهرَ إِذ نَحنُ أُمَّةٌ","نَسوسُ الوَرى ساداتِهِم وَالمَوالِيا",38,"ي",2,0],["أَما يرضيكَ عَمَّن عَقَّ مِنّا","رِجالٌ بِالوَفاءِ لَها اِتِّسامُ",39,"م",1,0],["أما يَنبغِي لكِ أن تَعرفِي","شُيوخَ الحُروبِ وأطفالها",40,"ل",3,0],["أما يفنى الطّعينُ ولا الضَّرِيبُ","لِواءٌ ليس يحملهُ عَسِيبُ",41,"ب",1,0],["أَم أَيّ راعٍ بِلا ذئبٍ يُجاوره","إِن لَم تَجد راعياً شَراً مِن الذيبِ",42,"ب",1,0],["أما يُرَى لَكَ فيما سَرَّ مِنْ عَمَلٍ","يَوْماً نَشاطٌ وعَمَّا ساءَ تَكسِيلُ",43,"ل",1,0],["أَما يَسُرُّكَ أَنَّ الرَرضَ زَهراءُ","وَالخَمرُ مُمكِنَةٌ شَمطاءُ عَذراءُ",44,"ا",2,1],["أَما يَتَفَكَّرُ أَحيائُها","فَيَعتَبِرونَ بِأَمواتِها",45,"ت",3,0],["أَما يَفنى حَديثُكَ عَن جِنانِ","وَلا تُبقي عَلى هَذا اللِسانِ",46,"ن",1,1],["أَما يَنهاكَ يا حَمّا","دُ ذِكرُ المَوتِ وَالقَبرُ",47,"ر",1,0],["أَما يَنفَعُني عِندَ","كِ قَولٌ مُعجِبٌ قُلتُه",48,"ت",2,0],["أَما يَرى الإِنسانُ في نَفسِهِ","آياتِ رَبٍّ كُلُّها غُرُّ",49,"ر",1,0],["أَما يُعطي ذَوي الحاجاتِ حَقّاً","وَفَوقَ شَواتِهِ السَيفُ السِقاطُ",50,"ط",1,0],["أَما يقيني فآت عن مشاهدة","وَفي الشهادة علم دونه الخبر",51,"ر",1,0],["إِمّا يُدَل مِنكَ بِالمَوتِ العِدى فَبِما","دارَت عَلَيهِم بِلا مَوتٍ لَكَ الدُوَلُ",52,"ل",1,0],["أما يرى ذلك الصَّبِيَّا","يُؤلّب البحرَ والظلاما",53,