9,"فاءٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188821",""],[5472,"إنى إذا ما صاحبي تعدّى","https://www.poetsgate.com/ViewPoem.aspx?id=200474",""],[5493,". ربيع الشعر .","https://www.poetsgate.com/ViewPoem.aspx?id=197946",""],[5574,"آياتُ الدجى وهواجسُ عاشقٍ أدمن الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206012",""],[5628,"أوهام امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=178479",""],[5660,"إِنَّ البُكاءَ لَدى التَّفَرُّقِ أَجمَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=24647",""],[5909,"إني إذا رحَلتْ إليكَ شجوني","https://www.poetsgate.com/ViewPoem.aspx?id=210415",""],[5909,"هلّا بقيِتَ وفي الحبيب عزاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210580",""],[5956,"شكراً على الاستدفاء بنيرانكم","https://www.poetsgate.com/ViewPoem.aspx?id=192365",""],[5956,"من أين تأتي الطيبة العصماءُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=206925",""],[5977,"ستار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213264",""],[5977,"بوحي فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=214580",""],[6024,"الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=186351",""],[6031,"عُجْ بالمَطِيِّ علَى مَعَالمِ بُورِي","https://www.poetsgate.com/ViewPoem.aspx?id=46320",""],[3986,"لا تحبسيني في الهوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502414",""],[6167,"معركة الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85480&r=&rc=9",""]],"verses":[["إِنّي إِذا ما لَم أَجِد","إِلّا الهَوانَ مَورِدا",0,"د",2,0],["إِنّي إِذا قُلتُ بَيتاً ماتَ قائِلُهُ","وَمَن يُقالُ لَهُ وَالبَيتُ لَم يَمُتِ",1,"ت",1,0],["إني إذا جَد المقال بموقف","فضّلت مُجمَله على تفصيله",2,"ل",2,0],["إني إذا كنتِ في حِداد","إليك أهدي حسن العزاء",3,"ا",2,0],["إِنّي إِذا خَطَرَت وَرائي خِندِفي","لا يَقشَعِرُّ مِنَ الوَعيدِ جَناني",4,"ن",2,0],["إِنّي إِذا مُضَرٌ عَلَيَّ تَحَدَّبَت","لاقَيتَ مُطَّلَعَ الجِبالِ وَعورا",5,"ر",2,0],["إِنّي إِذا الشاعِرُ المَغرورُ حَرَّبَني","جارٌ لِقَبرٍ عَلى مَرّانَ مَرموسِ",6,"س",1,0],["إِنّي إِذا بَسَطَ الرُماةَ لِغَلوِهِم","عِندَ الحِفاظِ غَلَوتُ كُلَّ مَغالي",7,"ل",2,0],["إِنّي إِذا كَرِهَ الرِجالُ حَلاوَتي","كُنتُ الذُعافَ مُقَشَّباً بِسِمامِ",8,"م",1,0],["إِنّي إِذا عاقَبتُ ذو عِقابِ","بِصارِمٍ مُذَكَّرِ الذُبابِ",9,"ب",1,0],["إنِّي إذا آنست همًّا طارقاً","عاجلت باللّذَّات قطع طريقه",10,"ه",1,1],["إنِّي إذا الْتبس البيان وجدْتني","أضعُ العمامةَ عن جبين أجلّهِ",11,"ه",1,0],["إني إذا خلط الإخوانُ صالحَهم","بِسَيِّئِ الفعلِ جِدّاً كان أو عبثا",12,"ث",2,0],["إنِّي إذاً إن كانَ ذاكَ لَكالذي","لاقى بمُبْتسمٍ وأضمر مكلَحا",13,"ح",2,0],["إنّي إذاً إن فعلت ذلكُمُ","لَبائع المُثمِنات بالوُكس",14,"س",1,0],["إنّي إذا ما الخصمُ في الغيِّ ابترَكْ","ولجَّ في غربِ السفاهِ ومحَكْ",15,"ك",1,1],["إني إذا ما الصديقُ أكرمني","ثم غدا يستردّ إكْرامي",16,"م",2,1],["إِنّي إِذا حَلَبُ الغَلباءِ قاطِبَةً","حَولي وَبَكرٌ وَعَبدُ القَيسِ وَالنَمِرُ",17,"ر",1,0],["إِنّي إِذا نَزَلَ البَلاءُ بِصاحِبي","دافَعتُ عَنهُ بِناجِذي وَبِمِخلَبي",18,"ب",2,0],["إِنّي أُذَكِّرُهُ بِذَيّاكَ الحِمى","وَجَمالِهِ وَإِخالَني أُنسيهِ",19,"ي",2,0],["اني اذا حادثة غيرت","حقيقة غيرت اقوالي",20,"ي",1,1],["اني اذا كان ربي لم يضع رشدي","فليس الا بحبل اللَه معتصمي",21,"م",2,0],["إني إذا بخل الربيع فما سقى","تلك الربوع سقيتها من أدمعي",22,"ع",2,0],["إنّي إِذا انثالَ البيانُ على فمي","ما إن أمَلُّ ولا يمَلُّ السامعُ",23,"ع",1,0],["إِنّي إِذا مُضَرٌ عَلَيَّ تَعَطَّفَت","سامَيتُ مَجرى الشَمسِ حينَ تَسيرُ",24,"ر",1,0],["إِنّي إِذا البابُ تاهَ حاجِبُهُ","لَم يَكُ عِندي في هَجرِهِ نَظِرَه",25,"ر",2,0],["إِنّي إِذاً مِثلُ الَتي لَم تَزَل","دائِبَةً في طَحنِها كُدسَها",26,"س",3,0],["إِنّي إِذا لَم يَكُن أَخي ثِقَةً","قَطَّعتُ مِنهُ حَبائِلَ الأَمَلِ",27,"ل",1,0],["إِنّي إِذا حَمِيَ الوَطيسُ وَأَوقَدَت","نيرانَها لِلحَربِ نارُ كَريهَةٍ لَم أَنكُلِ",28,"ل",1,0],["إِنّي إِذا خُلَّةٌ ضَنَّت بِنائِلِها","وَأَمسَكَت بِضَعيفِ الوَصلِ أَحذاقِ",29,"ق",1,0],["إِنّي إِذا ما المَرءُ بَيَّنَ شَكَّهُ","وَبَدَت عَواقِبُهُ لِمَن يَتَأَمَّلُ",30,"ل",1,1],["إِنّي إِذا فَطِنَ الزَمانُ لَناطِقٌ","وَسَكَتُّ حينَ رَأَيتُ دَهراً أَبلَها",31,"ه",2,0],["إِنّي إِذاً لَصَبورٌ إِن بَقيتُ وَقَد","قالوا الرَحيلَ وَإِن لَم يَرحَلوا أَبَدا",32,"د",2,0],["إِنّي إِذا الحَربُ راحَت غَيرَ قاعِدَةٍ","آتي الهُوَينى وَأَغدو غَيرَ مَهدودِ",33,"د",1,0],["إِنّي إِذا شَغَلَت قَوماً فِقاحُهُمُ","رَحبُ المَسالِكِ نَهّاضٌ بِبَزلاءِ",34,"ا",2,0],["إني إذا ما دَعاني ال","هزار كنت سميعا",35,"ع",2,0],["إني إذا خالفتها","كانَت لي الخصم الألدا",36,"د",2,0],["إنّي إذا دَلَكَتْ بَرَاحِ قَبَضْتُها","بالرَّاحِ كيْما لا يَكونَ دُلُوك",37,"ك",1,0],["إِنِّي إِذَا ما الْخِلُّ خَاسَ بِعَهْدِهِ","بَعدَ الوِدادِ فَلَسْتُ مِنْ أَصْحَابِهِ",38,"ه",1,1],["إِنِّي إِذَنْ بِعِيْنِهِ مُعَايِنُ","وَبِفُؤَادِهِ لِسَانِي يَشْدُو",39,"و",1,0],["إِنّي إِذا سُرَّ النَديمُ بِكَأسِهِ","طافَت عَليّ مِنَ الغَرامِ كُؤوسُ",40,"س",1,0],["إِنِّي إِذا آنست هما طَارِقًا","عجلت باللذات قطع طَرِيقه",41,"ه",1,1],["إنِّي إِذَا حَمِيَ الوَطِيسُ وَأُوْقِدَتْ","لِلْحَرْبِ نَارُ كَرِيهَةٍ لَمْ أَنْكُلِ",42,"ل",1,1],["إني إذا شَغَل الغرامُ متَبَّلاً","فانا الذي ببلادِه مشغول",43,"ل",1,0],["إني إذا نزل البلاء بصاحبي","دافعت عنه بناجذي وبمخلي",44,"ي",1,0],["إني إذا خلط الإخوانُ صالحهم","بسيّىء ِ الفعلِ جِدّاً كان أو عبثا",45,"ث",2,0],["اني اذا سامني ضيم الوذ به","ولي بنجدته البيضاء ايمان",46,"ن",1,0],["إِنّي إِذا عاطَيتُهُ مُزَةً","ظَلتُ بيومِ الفَرَحِ الجاذِلِ",47,"ل",1,0],["إِنّي إِذا شِئتُ أَن يَرتاحَ ذو كَرَمٍ","أَدَرتُ راحاً أَبوها الفِكرُ لا العِنَبُ",48,"ب",1,0],["إِنّي إِذا عَدَّ الرِجالُ قَديمَهُم","وَرَأَيتُ كُلّاً ذاكِراً ما أَسلَفا",49,"ف",2,0],["إنى إذا ما الوصلُ أَمْكَنني","نَزَّهتُه عن ريبةٍ أَنَفا",50,"ف",2,0],["إِنّي إِذاً كَالقدحِ يُجعَلُ مغزَلاً","يَكسو المَعاشِرَ وَهوَ أَجرَدُ عارِ",51,"ر",1,0],["إِنّي إِذا ما لَم تَصلِني خُلَّتي","وَتَباعَدَت عَنّي اِغتَفَرتُ بِعادَها",52,"د",3,0],["إني إذا رقصَ القوا","مُ ومالَ تحتَ السندسِ",53,"س",1,0],["إني إذا أرهفتُ حدَّ يراعتي","لم تلقَ في الشعراءِ غيريَ مبدعا",54,"ع",2,0],["إني إذا شئت كان حب","يفوق في النار ما عهدتم",55,"م",1,0],["إني أذوبُ علىالعذَارى كلما","حنَّت مطوَّقةٌ فصرتُ حنونا",56,"ن",2,0],["اني اذا غرد القمرى في سحر","بذى الاراكة أَسهاني وَأَلهاني",57,"ن",2,0],["إِنّي إِذا لاحَ البَريقُ يَماني","لأَهيمُ مِن طَربٍ إِلى نَعمانِ",58,"ن",1,1],["إني إذا ما شاعر هاجانيه","ولج في القول له لسانيه",59,"ه",1,1],["إِني إِذاً خنتُ الصبا","بةَ والغرامَ وجئتُ إِدّا",60,"د",2,0],["إِنّي إِذا مَلَكتُ قوتَ غَدٍ","فَلَيسَ بي فاقَةٌ إِلى أَحَدِ",61,"د",1,1],["إِنّي إِذا ما جِئتُكُم أُمَّ خالِدٍ","لَذو حاجَةٍ عَنها اللِسانُ كَليلُ",62,"ل",1,1],["إِني إِذا لَم استَقِ الماءَ مِن","مَنبَعهِ استَسقَيتُ من يَستَقي",63,"ق",2,0],["إنِّي إذا ما نارُ عَزمٍ خبَت","فلم ترَ العينُ لها نورا",64,"ر",2,0],["إني إذا خلي جفا","أو ملني أو مال شبرا",65,"ر",2,0],["إِنّي إِذا نبذ المُحِبُّ عِنانَهُ","بِيَدِ الحَبيبِ قبضت ثني عِناني",66,"ن",2,0],["إني إذَن بِشُؤون عينيَ بَاخِلٌ","وبِعَهْدِ مَن سَكن المنازلَ غَادرُ",67,"ر",1,0],["إِنِّي إِذَنْ لَكَفُورُ أَنْعُمِكَ الَّتِي","صَرَمَتْ حبالَ الذلِّ مِنِّي فانصرمْ",68,"م",1,0],["أني إذا أمر الإل","ه فدونكم لا أحنس",69,"س",1,0],["انى اذا بالغت كنت مقصرا","في مدحكم فلزوم عجزى أسلم",70,"م",1,0],["إِنّي إِذا خَفِيَت نارٌ لِمُرمِلَةٍ","أُلفَى بِأَرفَعِ تَلٍّ رافِعاً نارِي",71,"ر",2,0],["إِنّي إِذا قُلتُ استَقامَ يَحُطُّهُ","خُلفٌ كَما نَظَرَ الخِلافَ الأَقبَلُ",72,"ل",1,0],["إِنّي إِذا خَفِيَ اللِئامُ رَأَيتَني","كَالشَّمسِ لا تَخفى بِكُلِّ مَكانِ",73,"ن",1,0],["إني إذا اصطحباني أرض منطقة","البروج أحسبه بالوصل يحترق",74,"ق",1,0],["إنِّي إِذا ادَّعيتُ يوماً حُبَّهُم","لِعبءِ وِزْري يا هُذَيْمُ اسْتَحي",75,"ح",2,0],["إني إذا قلت البديهة قلتها","عجلاً وطبعك عند طبعي يرفق",76,"ق",1,0],["إِنّي إذا صَالَ أَقْيالُ الجِدالِ فَتىً","لا يُصْطَلَى لي بِنارٍ في الْكَرِيهاتِ",77,"ت",1,1],["إِنّي إِذا ما امرُؤٌ خَفَّت نَعامَتُهُ","إِلَيِّ وَاِستُحصَدت مِنه قوى الوَذَمِ",78,"م",1,0],["إِنّي إِذا ما البَخيلُ آمَنَها","باتَت ضَموزاً مِنّي عَلى وَجَلِ",79,"ل",1,0],["إِنّي اذا الجارُ لَم تُحفَظ مَحارُمُهُ","وَلَم يُقَل دونَه هَيدٍ وَلا هادِ",80,"د",1,0],["إني إذا ظلمة الأيام تدهمني","اهدي بلألائها في ظلمة الزمن",81,"ن",1,0],["إِني إِذاً لَبَطلٌ ذو عصبه","كَأَنَّ في يَدي اليَمينِ حَربه",82,"ه",1,0],["إني إذا عاقبتُ ذو عقابِ","وإنْ تشاغِبْني فذو شِغابِ",83,"ب",1,1],["إني إذا بعدت عني","شيء كئيب هنا غريب",84,"ب",1,0],["إِنِّي إِذَا لَمْ تَرَنِي كَأَنَّنِي","أَراكَ بِالغَيْبِ وَإِنْ لَمْ تَرَنِي",85,"ن",2,0],["أَنِّيَ إِذَا مَا اشْتَدَّتِ الهَبَائِثُ","أَرْجُوك إِذ أَغْبَطَ جَهْدٌ والِثُ",86,"ث",1,0],["إِنّي إِذا حَلَّ أَهلي مِن دِيارِهِمُ","بَطنَ العَقيقِ وَأَمسَت دارَها بَرَدُ",87,"د",1,0],["إني إذا ما عدت يوماً خايباً","لي لعنة منه كلعنة مَن سلفْ",88,"ف",1,0],["اني إذا ذكرت منازل سادتي","كادت دموع العين ان تجري دما",89,"م",2,0],["إني إذا ما حدث ألما","أقول يا اللهم يا اللهما",90,"م",2,0],["إني أذكر مولاي الأمير وما","أظنه ناسي العهد الذي ذكرا",91,"ر",2,1],["أَني إِذا ما النَوى جَيشُ الأَسى لي ساق","أَقول ها لَحظُهُ لي ساقم لي ساق",92,"ق",1,0],["إني إذا ذكت الهَواجرُ والتظت","نارُ الصّياهدَ في الحَصَى الرَضراضِ",93,"ض",1,0],["اني إذا جاش بحر الشعر من أدبي","قذفته لؤلؤاً رطباً ومرجاناً",94,"ن",2,0],["إِنّي إِذا نادى المُنادي لَيلَةً","إِحدى لَيالي الدَهرِ لَم أَتَغَفَّلِ",95,"ل",1,0],["إني إذا مَعْشَرٌ كَانَتْ عَدَاوَتُهُمْ","فِي الصَّدْر أوْ كانَ مِن أبْصَارِهِمْ خَزَرُ",96,"ر",1,0],["إنّي إذا لأكون وحشاً ضاريا","بفمي أمزق مهجة الفتّاك",97,"ك",1,0],["إني إذا بلغَ العدُوُّ حَمِيَّتِي","فبرزْتُ أمشي مِشْيَةَ المتبخْتِرِ",98,"ر",1,0],["إِنّي إِذا المَرءُ هَمَّت بي غَوائِلُهُ","أَورَثَتهُ الداءَ أَو أَورَثَتهُ الحُزنا",99,"ن",2,0],["إني إذا الخل ولى","وليته ما تولى",100,"ل",2,0],["إني إذا حضرتني ألف محبرة","تقول أخبرني هذا وحدثني",101,"ي",1,1],["إِنّي إِذَاً لَأَخو الدَناءَةِ وَالَّذي","عَفَّت عَلى عِرفانِهِ جَهَلاتُهُ",102,"ت",2,0],["إني أذعت لك العلمَ الغريبَ وما","أنا بصاحبِ إفشاءٍ وإيذاع",103,"ع",1,0],["اني إذا ما خلت سلوته","يوماً يكذبني به الفكر",104,"ر",1,0],["إنى إذا رجل دبت عقاربه","سقيتهُ سم حياتي فلم يعد",105,"د",1,0],["إِنّي إِذا ما الخَليلُ أَحدَثَ لي","صرماً وَمَلَّ الصَّفاءَ أَو قَطَعا",106,"ع",2,1],["إني إذا هاب الزيارة وامقٌ","يدلي يدعوى في المجبة زورِ",107,"ر",1,0],["إني إذا خطرت تحتي مسوّمة","مثل السراة إذا تمشي وتطرد",108,"د",1,0],["إني إذا لخصت سحر بيانهم","زانت معانيه بديع ملخصي",109,"ص",2,0],["اني إذا هبَّ النسيم","أشمّ منه نيسم وردِك",110,"ك",1,0],["إني إِذا رُمت مِن شَوقي أَقتلها","في حالة البُعد روحي كُنت أَرسلها",111,"ه",2,0],["اني إذا ما نزلت شدة","ادعو بنصر الملك القادر",112,"ر",1,1],["إنِّي إذا ما الْهَمُّ وَافَى إلىَ","مَضاجِعٍ شَرَّدَ عنها المَنَامْ",113,"م",1,1],["اني اذا ابكي لوقع مصيبةٍ","ابكي على دَمعٍ سفكتُ واندبُ",114,"ب",1,0],["إِنّي إِذا أَطنَبَ مُدّاحَهُ","قَصَدتُ في القَولِ فَلَم أُطنَبِ",115,"ب",1,0],["إِني إِذا أَطنَبت في تَمجيده","أَبصرت إِجمال المقصّر أَجمَلا",116,"ل",2,0],["إني إذا نافستُ لا أرعوي","لأنني نجلُ أبي اليسرِ",117,"ر",1,0],["إني إذا المرء شانته خليقته","ألفيتني جلدتي بيضاء براقه",118,"ق",2,0],["إِني اذا القاك انسى الذي","لاقيتُ من دهري ومن قسوته",119,"ت",2,0],["إني إذا ما حضرت في ملأ","عددت من بعض آلة الفرح",120,"ح",1,1],["إِني إِذا ذُكر الغَرامُ وَأَهلُه","كان الهَوى كَأسي وَكُنتُ الساقي",121,"ق",2,0],["إِنّي أَذُمُّكَ يا سَعيدُ وَإِنَّما","بِالمَجدِ مِنكَ إِذا فَخُرتُ أماجِدُ",122,"د",1,0],["إِنّي إِذا استَخفى الجَبانُ بِالخَدَر","وَكانَ بِالكَفِّ شِهابٌ كالشَرَر",123,"ر",1,1],["إني إذا التقت الجحافلُ لم أزل","أسطو على روح الكمبّي الصائلِ",124,"ل",1,0],["إني إذا مني الذنوب تكاثرت","أرجو بك الغفران حقاً يستقل",125,"ل",1,0],["إِنّي إِذا اِنتَتَرَت أَصِرَّةُ أُمَّكُم","مِمَّن يُقالُ لَهُ تَسَربَل فَاِركَبِ",126,"ب",1,1],["إِنّي إِذا جِئتُ ذَنباً","أَسومُكَ الصَّفح عَنّي",127,"ن",2,0],["اني اذا أتممت فيك النظرا","رأيت حسنا لم يكن قبل يرى",128,"ر",2,0],["إِنّي إِذا ما الخَد صَدَّ بِوَجهِهِ","عَنّي وَقابَلَني بِفَرطِ مَلالِه",129,"ل",2,1],["إني إذا أم السفيح وأهله","ركب العراق فمهجتي في ركبه",130,"ب",2,0],["إني إذا ذكر السفيح وأهله","وفد الجوى نحوي بسائر جنده",131,"د",2,0],["إني إذا خفت الهوا","ن مشيع دلل ركابه",132,"ب",2,0],["إني إذا ما الخل خادعه","عني الزمان فحال عن عهدي",133,"ي",1,1],["إني إذا أصبحت في بلد العدا","فالنَبْل مشطي والظبَى مرآتي",134,"ي",1,1],["إني إذا ركب الرجال رأيتني","أغشى الحتوف وكل آت آتي",134,"ي",1,0],["إني إذا اشتدَّ الطراد تخالني","جَبَلاً لهُ فوق الجيوش حُدورُ",135,"ر",1,0],["إني إذا سمحوا يوماً بقربهم","فلست أفكر فيمن شح أو منعا",136,"ع",2,0],["إني إذا العُيونُ أعدت مُهجتي","فأصبح السقمُ عليها قَد عَدَا",137,"ا",1,0],["إنِّي إذا لم أجِد شَخصاً لأُرسلهُ","وضاقَ بي مُنتَهى أمري وملتَمسِي",138,"ي",1,1],["إِنّي إِذا ما الأَمرُ بَيَّنَ شَكَّهُ","وَبَدَت بَصائِرُهُ لِمَن يَتَأَمَّلُ",139,"ل",1,1],["إني إذا شبت في كلمي","شيخ لعهد شبابه ادكرا",140,"ر",2,0],["اني اذا استلأمت متقيا به","اصبحت فارس حملة وطراد",141,"د",1,0],["اني اذا خالت يوما صاحبا","لا ابتغي عن وده متحولا",142,"ل",2,0],["إني إذا الشعر أدناني إليكَ","فقد آمنتُ حقاً بأنَّ الله أوحاهُ",143,"ا",2,0],["إني إذا جاءت تقدم عذرَها","ذكَّرتها بمحاسنِ الإيثار",144,"ر",1,0],["‏‎إنّي إذا فتحَ المدى أبوابَه","للقائنا أشعلتُه أشواقا",145,"ق",2,1],["إنّي إذا ما متُّ أرحلُ للذي","يعطيكِ أجراً إن صبرتِ مع العملْ",146,"ل",1,0],["إنِّي إذا انتابَهُ في حضنِكُم أجَلٌ","ما كان للموتِ في أحضانِكُم أَلَمُ",147,"م",1,0],["إني إذا ما رأيت فرخ زنى","فليس يخفى على جوهره",148,"ه",1,1],["إنّي إذا اشتقتُ في ليلي لرؤيتها","يردُّني في هدوءِ الليلِ تَذكارُ",149,"ر",1,0],["إنِّي أذوبُ إذا اقتربتُ إليهِ","فالحبُّ مَمْلكةٌ على شفتيهِ",150,"ي",2,1],["إني أذوبُ معَ الورودِ بغيرةٍ","إنْ غارَوردُ الرَّوضِ من خديهِ",150,"ي",2,0],["إني أذوبُ من اشْتياقي للَّتي","قالتْ لقلبي:فيكَ مِنْ بعدي البقا؟",151,"ق",2,0],["إنِّي إذا طيفُ الحبيبِ يزورني","لو كنتُ أشقاهمْ أصيرُ الأسعَدا",152,"د",2,0],["إني إذا جن داجي الليل ينقلني","لجانب بنسيم الليل ملتحف",153,"ف",1,0],["إنّي إذا رُحْتُ مَعْصُوماً لِعاصِمَةٍ","أصبحتُ سَهْواً إلى بغدادَ أنْعَطِفُ",154,"ف",1,0],["إني إذا عضّني سهم الضنى فأنا","من بعض مَن حسبهم أن يخرقوا الحُجُبا",155,"ب",2,0],["إنّي إذا سافَرْتُ في حُلُمي","أزهو بما لم يُعْطَه البَشَر",156,"ر",1,0],["إني إذا سددته هدفا","من عقمه المشؤوم يرتد",157,"د",1,0],["إنِّي إذا قلتُ الحروفَ جميعَها","دهراً أصومُ عن الكلامِ وأُفطَمُ",158,"م",1,0],["إنى إذا ما صاحبي تعدّى","في اللّوم والعذل علي جدّا",159,"د",2,1],["إنِّي إذَا نثرَ الربيعُ زهورَا","أرسلتُ من قوسِ الصباحِ عطورَا",160,"ر",2,1],["١- إنّي إذا ما الليلُ أرخى سِترَهُ","أقضي الهزيعَ يُريقُ نبْضي سِرَّهُ",161,"ر",2,1],["إنّي إذا اشتدّتْ الآلامُ بي عزَفَتْ","قيثارتي لحْنَها وانتابني الطّرَبُ",162,"ب",1,0],["إِنّي إِذا ضَنَّ الصَّديقُ بِوُدِّهِ","أَو ظَنَّ عَنّي السّوءَ ما أَتَحَمَّلُ",163,"ل",1,1],["إني إذا رحَلتْ إليكَ شجوني","سامرتها وحياً فزاد مجوني",164,"ن",2,1],["إني إذا لاح الضياءُ بخيطهِ","لاحت بقلبي حُرقةٌ وبكاءُ",165,"ا",2,0],["إني إذاً أحد الخوائن للورى","تبَّت يداي بما خيالي يبتكرْ",166,"ر",1,0],["إني إذاَ مِن أسعد البشرِ الألى","صبروا وقد ركعتْ ليَ الأرزاءُ",167,"ا",2,0],["إني إذا ما الليل أرخى ستره \"","أشرعت باب القلب للحب النقي",168,"ق",2,1],["إني إذا جارت الدنيا لك \"أمل\"","أعوذ بالله من شر الملمّاتِ",169,"ت",1,0],["إني إذا ضيعت عمري باطلا","غرر علي بأن أراه يضيع",170,"ع",1,0],["إنِّي إذَا هَابَ الزِّيارةَ وَامِقٌ","يُدْلي بدَعوَى في المحبَّةِ زُورِ",171,"ر",1,0],["إِنّي إِذا خِفتُ الهَوا","نَ مُشَيَّعٌ ذُلُلٌ رِكابُه",172,"ب",2,0],["إني إذا اشتعلَ الزمانُ وأُضرِمتْ","تلك المشاعرُ باللظى المترامِي",173,"م",2,1],["إني إذا اتَّزر العناءُ سعادتي","وتوسَّدَ البؤسُ اللعينُ عظامي",173,"م",2,0],["إني إذا اشتملَ الشقاءُ طلاقتي","واْعتلَّ جِسمٌ واستحالَ مُرامي",173,"م",2,0]]}