ا)","https://www.poetsgate.com/ViewPoem.aspx?id=210429",""],[5055,"حمر البيارق","https://www.poetsgate.com/ViewPoem.aspx?id=102727",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5206,"أرض الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=187396",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5277,"خادعتُ نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=187602",""],[5356,"أحلامنا المنصوبة","https://www.poetsgate.com/ViewPoem.aspx?id=204489",""],[5582,"سَرَتْ الحُدُوجُ يَزِينُها الأَفْزازُ","https://www.poetsgate.com/ViewPoem.aspx?id=187152",""],[5582,"هَلاَّ شَجِيتَ لِلَحْنِ الشَّادِنِ الغَنِجِ","https://www.poetsgate.com/ViewPoem.aspx?id=63475",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5660,"واهٍ لِقَلبِكَ إِن رُميتَ بِدائي","https://www.poetsgate.com/ViewPoem.aspx?id=25120",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[402,"سل مالكا متمكنا","https://www.poetsgate.com/ViewPoem.aspx?id=35715",""],[5790,"يضرب في رمله بكف","https://www.poetsgate.com/ViewPoem.aspx?id=112088",""],[5853,"الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=175698",""],[6056,"اقول معصي","https://www.poetsgate.com/ViewPoem.aspx?id=130136",""],[6056,"نار الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=156700",""],[469,"وليلة بات بدر التم ساقينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574848",""],[469,"كفي كؤوسك فالمدامة ما سقت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574769",""],[469,"لله يوم النيرين ووجهه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574761",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[2220,"غادروني بالأثيلِ والنَّقَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19273&r=&rc=815",""]],"verses":[["حَمراءُ جاهِلَةُ الشَرارِ مَهولَةٌ","لِلناظِرينَ لَها دُخانٌ أَدهَمُ",0,"م",1,0],["حُمرُ الكُعوبِ كَأَنَّما أَلوى بِها","نَضخٌ مِنَ الشَيّانِ وَالعُلّامِ",1,"م",1,0],["حَمَّرَت نَجدَةٌ وَلَيسَ بِذِمرٍ","في الوَغى كُلِّ أَرمَدِ الحِملاقِ",2,"ق",1,0],["حُمرٌ عَلى نَظَرِ العَدُوِّ كَأَنَّما","بِدَمٍ يَخُطُّ بِهِنَّ لا بِمِدادِ",3,"د",1,0],["حُمرٌ حَواصِلُها كَالمَغدِ قَد كُسِيَت","فَوقَ الحواجِبِ مِمّا سَبَّدَت شَعَفا",4,"ف",2,0],["حمرتها من دماءِ ما قتلتْ","والدم في النصلِ شاهد عجب",5,"ب",1,0],["حمرٌ مدامعنا صفرٌ مناظرنا","سودٌ مذاهبنا بيضٌ نواصينا",6,"ن",2,0],["حُمرتُها من دماءِ من قَتَّلَتْ","والدمُ في النَّصلِ شاهدٌ عَجَبُ",7,"ب",1,0],["حمراءُ في يد أحمر ال","وجنات مَلْثمُهُ مَهيرُ",8,"ر",1,0],["حَمراءَ أَو صَفراءَ إِنَّ كَريمَها","كَالغيدِ كُلُّ مَليحَةٍ بِمَذاقِ",9,"ق",1,0],["حَمراءُ في الأَحواضِ إِلّا أَنَّها","بَيضاءُ في عُنُقِ الثَرى تَتَأَلَّقُ",10,"ق",1,0],["حمرة مستجنّة في بياض","أخرجتها النيران بالتقديرِ",11,"ر",1,0],["حُمرُ السُيوفِ كَأَنَّما دَرَبَت لَهُم","أَيدي القُيونِ صَفائِحاً مِن عَسجَدِ",12,"د",1,0],["حُمْرَ القَواعدِ والقِبابِ كأنَّما","أُشْرِبْنَ رَقْراقَ الخَلوقِ الرَّائقِ",13,"ق",1,0],["حمراءُ لم تَكذِبْ ولم تَصدُقِ","لها لِسانٌ قَطُّ لم يَنْطِقِِ",14,"ق",1,1],["حُمراً تَلوحُ خِلالَها بِيضٌ كما","فصَّلْتَ بالكافورِ سِمْطَ عَقيقِ",15,"ق",1,0],["حُمرٌ على أيديهمُ بوارُها","فصرَّعَت مَوشِيَّةً أطمارُها",16,"ر",3,0],["حمراءَ كالياقوتِ صافيةً","ومعظِّمُ الياقوتِ أحمرُه",17,"ر",2,0],["حَمراءُ لَو تَرَكَ السُقاةُ مِزاجَها","أَمسَت لَنا عِوَضاً عَنِ المِصباحِ",18,"ح",1,0],["حُمرٌ عَلى سودِ الشُعورِ كَأَنَّها","شَفَقٌ عَلى بَحرِ الدُجُنَّةِ طافِ",19,"ف",1,0],["حَمراءُ لِنورِها وَميضٌ","يُجلى بِشُعاعِهِ الظَلامُ",20,"م",1,0],["حَمرَ الأَديمِ صَقيلاتٍ مَلابِسُها","كَأَنَّها في دَمِ الأَبطالِ قَد سَبَحَت",21,"ت",1,0],["حمراءَ تشربُ بالأنوف سُلافها","لُطْفاً وبالأسْماع والأحداقِ",22,"ق",1,0],["حمراءُ مشمولةٌ لها عُمُرٌ","في طَرَفٍ منه دَهْرُهَا غَرِقُ",23,"ق",1,0],["حمراءَ يُسْلي شربُها وبشربها","تُنْسَى الهموم وتُذْكَرُ الأفراحُ",24,"ح",1,0],["حَمراءُ في صُفرَةٍ عُلَّت بِغالِيَةٍ","كَأَنَّما قُطِفَت مِن خَدِّ مُهديها",25,"ي",3,0],["حَمْرَاءُ دَارَ بِهَا الْحَبَابُ فَصَوَّرَتْ","فَلَكاً تَحُفُّ سَمَاءَهُ الأَجْرَامُ",26,"م",1,0],["حمراءَ مِنْ حللِ الصِّبا فضفاضةً","ذهبيةً أوصافُها تتنوَّع",27,"ع",1,0],["حمراءُ ساطعةُ الذوائبِ في الدجى","ترمي بكلِّ شرارةٍ كطرافِ",28,"ف",1,1],["حَمراءُ صافِيَةٌ تَطيبُ بِنَفسِها","وَغِنائِها وَخَلائِقِ النُدَماءِ",29,"ا",2,0],["حَمراءُ نازَعَتِ الرِياحَ رِداءَها","وَهناً وَزاحَمَتِ السَماءَ بِمَنكِبِ",30,"ب",1,0],["حمراء أوردها الدماءَ حفاظهم","كدراء لم تنفض غبار جهاد",31,"د",1,0],["حمراءُ صرفاً ألبسوها أحمرا","قد أنصفوه فخلتهُ ملآنا",32,"ن",2,1],["حَمراءُ صَفراءُ عِندَ المَزجِ تَحسَبُها","كَالدُرِّ طَوَّقَها نَظمٌ مِنَ الحَبَبِ",33,"ب",1,0],["حَمراءُ عَلَّقَها بِالماءِ شارِبُها","تُفتَضُّ عُذرَتُها في بَطنِ رَحراحِ",34,"ح",1,0],["حَمراءُ تَصفَرُّ إِذا شُعشِعَت","أَلطَفُ في الشارِبِ مِن روحِه",35,"ح",2,0],["حُمراً وَبيضاً يَجتَنَينَ وَأَصفَراً","وَمُلَوَّناً بِبَدائِعِ الأَلوانِ",36,"ن",1,0],["حمراءُ كالنار ولكنّها","قُبلةُ أحبابٍ ميامين",37,"ن",1,0],["حُمْرُ الثيابِ تخالُ أنهمو","يَفِدونَ من حانوت قصّابِ",38,"ب",1,0],["حُمرَةٌ خَلطُ صُفرَةٍ في بَيَاضٍ","مِثلَ ما حاكَ حائكٌ دِيَباجا",39,"ج",2,1],["حَمْرَاءُ تُلْقِي بِلَحَاظِ الْفَتَى","صِبْغَاً بِهِ يَعْتَرِفُ النَّاكِرُ",40,"ر",1,0],["حَمْرَاءُ دارَ بها الْحَبابُ كأَنَّها","شَفَقٌ بَدَتْ فِيهِ نُجُومُ سَماءِ",41,"ا",2,0],["حَمْرَاءَ سَلْسَلَهَا الإِبْرِيقُ فِي قَدَحٍ","كَشُعْلَةٍ لَفَحَتْ في ثَلْجَةٍ نَصَحَتْ",42,"ت",1,0],["حُمْرُ اللِّحاظِ تَخَالُهَا","وَرْيَ المِيضِ المُسْتَطِيرْ",43,"ر",1,0],["حَمراءَ مِن جَمرِ الخُطوبِ وَطِئتَها","فَلَبِستَ فيها الصَبرَ أَيَّ لِباسِ",44,"س",1,0],["حمراءُ سحنتُه، بيضاءُ لحيتُه","لكنَّ صفحته سوداءُ كالقار",45,"ر",1,0],["حُمْرُ السّيُوفِ، كأنّما ضربت لهمْ","أيدي القُيُونِ صَفائحاً مِن عَسجَدِ",46,"د",1,0],["حَمرَاءَ دَوَّرَهَا البَارِى ونَوَّرَهَا","تُنسِيكَ طَعمَ عُقَارٍ خَالَطَت شَبما",47,"م",2,0],["حُمراً وَخُضراً كساها اللهُ زُخرُفَهُ","كَما اكتَسَى بالنَّباتِ العَازِبِ الزَّهَرُ",48,"ر",1,0],["حمراءَ صافيةً كأنَّ شعا