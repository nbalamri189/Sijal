{"poems":[[91,"لاقى اسامة وهو الضيغم الضاري","https://www.aldiwan.net/poem44740.html","البسيط"],[47,"بعينيك إعوالي وطول شهيقي","https://www.aldiwan.net/poem65197.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[90,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[139,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[382,"سل أنت ذاتك إن تود حقيقة","https://www.aldiwan.net/poem59296.html","الكامل"],[409,"خليلي هل من موقف فيه أشتكي","https://www.aldiwan.net/poem33463.html","الطويل"],[463,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83297","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122689","المتقارب"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205627","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49049","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108537","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100414","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100358","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140034","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92330","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[4912,"سلاني وليس لباس السلو","https://www.poetsgate.com/ViewPoem.aspx?id=181782",""],[4119,"إن الألى جمعتهم والنوى دار","https://www.poetsgate.com/ViewPoem.aspx?id=16140",""],[5491,"أنت علمتني بألا أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=215041",""],[5912,"هاج.الأنين","https://www.poetsgate.com/ViewPoem.aspx?id=205004",""],[1546,"يا ناظرَ اللَيثِ الهصورِ برسمهِ","https://diwany.org/%D9%8A%D8%A7-%D9%86%D8%A7%D8%B8%D8%B1%D9%8E-%D8%A7%D9%84%D9%84%D9%8E%D9%8A%D8%AB%D9%90-%D8%A7%D9%84%D9%87%D8%B5%D9%88%D8%B1%D9%90-%D8%A8%D8%B1%D8%B3%D9%85%D9%87%D9%90/","الكامل"]],"verses":[["سل ان شككت رجال العلم يعترفوا","بما اقول وما ذو الجهل كالداري",0,"ر",2,0],["سَلا نُوَبَ الأَيّامِ ما بالَها أَبَت","تَعَمَّدُ إِلّا جَفوَتي وَعُقوقي",1,"ق",2,0],["سَلْ أَنْ يُثَبّتَكَ الذَّي","فِي فِلْذَةِ الكَبِدِ ابْتَلاَك",2,"ك",1,0],["سلانيك الفتاة حوت ثراءً","بهم فقضت عن الوطن الديونا",3,"ا",1,0],["سلاني هجره لما سلاني","بلا سبب سلاه أو سلاني",4,"ن",2,0],["سل أنتَ ذاتَك إن تودَّ حقيقةً","تهديك علماً نحو غاية من سلكْ",5,"ك",1,1],["سل أنت فيما أبتغيه مراسلي","فكم في الهوى قد أرسلوني أمثالا",6,"ل",2,0],["سلاني به فالجمال اسمه","ومعناه مَفسدةٌ للعفيفِ",7,"ف",1,0],["سل إن عراك الشك عن أقلامه","يجبرك عنهن الظبى والأسل",8,"ل",1,0],["سَلاني هَل عَلى بُعدي سَلاني","وَهَل كانَ المَغيبُ سِوى العَيانِ",9,"ن",1,1],["سَلانيَ عَمَّن مَضَى يا شُجاعُ","لِعِلمي أنَّكَ خَيرُ السَّلَف",10,"ف",1,0],["سل إن أردت النيل عن آلامنا","تسمع لديه جواب كل سؤال",11,"ل",1,0],["سَلْ إن جهلتَ حسامَه في كفِّه","والسيفُ أَفصحُ ناطقٍ يتكلمُ",12,"م",1,0],["سل إن أردت عن القوم الذين لهم","دورٌ وماشية من أين ما كسبوا",13,"ب",3,0],["سل إن عرفت الدار عن سكانها","وانشد بها قلباً رهين ضمانها",14,"ن",3,1],["سل إن جهلت نداه سائله","كم راح يسأل بعد ما يسلُ",15,"ل",1,0],["سلاني عن أخباره إنني بها","كفيلٌ فأجلوها ولا لبسَ من لبْس",16,"س",1,0],["سلانكُ أَغماتٌ وشخصي مردّدٌ","حكيتُ ابنَ عبادٍ وفي خانها سجني",17,"ي",1,0],["سلاني من أحب وواصلتني","أناس كان قطعهم مرادي",18,"د",2,0],["سلاني وليس لباس السلو","يناسب حسن سمات النفيس",19,"س",1,0],["سلا نسيم الصبا النجدي نفحته","هل عنده من ظباء الرمل أخبار",20,"ر",1,0],["سل أنيني وزفرتي وعويلي","عن غمامات سوطك المتوالي",21,"ل",2,0],["سلاني نديم الفؤاد كما","معين هتون غدا ينضب",22,"ب",1,0],["سَلْ إن جهلتَ حسامَه في n:leftِه","والسيفُ أَفصحُ ناطقٍ يتكلمُ",23,"م",1,0]]}