{"poems":[[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[53,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[68,"تاب الزمان من الذنوب فوات","https://www.aldiwan.net/poem38499.html","الكامل"],[52,"أخداش أنت ابن الثلاثة","https://www.aldiwan.net/poem64722.html","مجزوء الكامل"],[30,"ستبلغ عني غدوة الريح أنها","https://www.poetsgate.com/ViewPoem.aspx?id=20997",""],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[567,"ما زلت أسمع ذكر عبد القادر","https://www.aldiwan.net/poem52770.html","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70907","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120011","المنسرح"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69403","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102155","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93824","الكامل"],[3476,"","https://poetry.dctabudhabi.ae/diwan/poem/98036","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205682","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111389","الخفيف"],[5136,"يا رب يا الله يا عالماً","https://www.poetsgate.com/ViewPoem.aspx?id=121740",""],[6008,"المكوك","https://www.poetsgate.com/ViewPoem.aspx?id=61067",""]],"verses":[["تَمَّمتَ عَلَيها فَأَتمَمتَها","وَتَمَّ بِأَمرِكَ إِكمالُها",0,"ل",3,0],["تمِّمْ وإلا كان بِرّاً أعرجا","إنك إن تمَّمتَ برّاً هَمْلَجَا",1,"ج",2,0],["تَمِّم بِها نَقصَ السُرورِ فَإِنَّها","عِندَ الكِرامِ تَميمَةُ اللَذّاتِ",2,"ت",1,0],["تَمِّم بِفَضلِ يَدٍ يَداً","إِنَّ التَمامَ لَهُ وِراثَه",3,"ث",2,0],["تَمِمياً، إذا مرّتْ عَليَها منَ الذي","جَرَى جَرْيَ مَرْقُومٍ قَصِيرِ القَوائِمِ",4,"م",1,0],["تمم لنا بسعينا الإفاده","وعمنا بالخير والزياده",5,"ه",1,0],["تَمَّ مِنهُ قَوامُهُ وَاِعتِدالُ ال","خَلقِ وَالرَأيُ بِالأُمورِ الثِقالِ",6,"ل",1,0],["تمَّمْتَ سَعيكَ في تِجارةِ قانِتٍ","بالحجِّ توسيعاً لرِبْحِ التَّاجِرَ",7,"ر",1,0],["تمَّ ما قدْ ضَّيعتَه مِنْ شبابٍ","بارْتكابِ الفحشا وسوءِ الفِعالِ",8,"ل",1,0],["تمم فعال الإحسان وأخلد","ما خلدت هضبتا ثبيرِ",9,"ر",1,0],["تَمِّم جَميلَكَ بِاستاعِ غَرائِبي","إِنَّ الجَميلَ جَمالُهُ بِتَمامِهِ",10,"م",2,0],["تمَّمَ اللَهُ به نعمتهُ","وجلا الغمَّ وزاح الكربا",11,"ب",2,0],["تممت فيك مدائحاً","يزري بها بدر التمام",12,"م",1,0],["تمّ ميعادكُ يومَ الحشرِ في","جنّةِ الخلدِ إنِ اللَّه رَحِم",13,"م",1,0],["تمَّ منها شوقٌ، ورفُّ شفاه","وهوى نيةٍ وخفقة صدر",14,"ر",1,0],["تَمَّ مَا شَاءِ زَفسُ مِن يَومَ شَبَّت","فِتنَةٌ بِالشِّقَاقِ تُنذِرُ أُولى",15,"ل",2,0],["تمم بها الإحسان والفضل","مفضل يا مجمل يا محسن",16,"ن",1,0],["تمم الواجب لو الانذال كرهوك","من جاك عزه ولي ماجاك ماغلاك",17,"ك",1,0]]}