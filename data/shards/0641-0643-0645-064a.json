{"poems":[[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[88,"صونوا يراع علي في متاحفكم","https://www.aldiwan.net/poem10487.html","البسيط"],[95,"سبرت نهاية الإخلاص خوفاً","https://www.aldiwan.net/poem9783.html","عموديه"],[93,"جلست وقد هجع الغافلون","https://www.aldiwan.net/poem8802.html","عموديه"],[63,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[76,"فيا لشجا قلب من الصبر فارغ","https://www.aldiwan.net/poem13267.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9991","الوافر"],[173,"ألا رحلت نعم وأقفر نعمان","https://www.aldiwan.net/poem1683.html",""],[358,"أرى نفسي أبت طلب التمني","https://www.aldiwan.net/poem40183.html","الوافر"],[369,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[369,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[369,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[422,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[438,"لو لم يحرم على الأيام إنجادي","https://www.aldiwan.net/poem12352.html","البسيط"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[469,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[469,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[482,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[541,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[580,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[591,"وما فيه من حسن سوى أن طرفه","https://www.aldiwan.net/poem17481.html","الطويل"],[591,"سرى لأرض الكرى فما وصلا","https://www.aldiwan.net/poem17662.html","المنسرح"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198611","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122751","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70749","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120041","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119870","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56204","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136201","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56582","الكامل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31595","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79809","المتقارب"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109320","الوافر"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111096","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53078","الوافر"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67919","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204626","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130057","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89401","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103842","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86301","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91509","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91126","الوافر"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33140","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86573","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111053","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78193","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[5075,"نَايَاتِي مُعَطَّلَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187692",""],[5376,"وهل للهجر قرب ما أنابا","https://www.poetsgate.com/ViewPoem.aspx?id=189753",""],[5691,"طغى الجوْر","https://www.poetsgate.com/ViewPoem.aspx?id=206098",""],[5781,"عَبِقٌ بأوجاعِي يا عِطْر","https://www.poetsgate.com/ViewPoem.aspx?id=212823",""],[5785,"متى متى يا قرة النواظر","https://www.poetsgate.com/ViewPoem.aspx?id=131564",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5957,"أرى الآتي كما الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=14224",""],[5355,"حديث فخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87206&r=&rc=31",""],[422,"وميضُ البرق هيَّج منك وجدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22245&r=&rc=1",""]],"verses":[["فَكَم يَومٍ كَيَومِكَ قُدتَ فيهِ","عَلى الغُرَرِ المَقانِبِ وَالرِكابا",0,"ب",2,0],["فَكَم يَراعِ حَكيمٍ في مَشارِعِهِ","قَدِ اِلتَقى بِيَراعِ الكاتِبِ الأَرِبِ",1,"ب",1,0],["فَكَمْ يا رَبُّ فِيهِ مِنْ نُبُوغٍ","فَتُخْتَرَمُ النُّبُوغَ بِلا حِسَابِ",2,"ب",1,0],["فَكَم يَقتُلُ الجَحفَلَ الجَحفَلُ","وَيَفتُكُ بِالأَروَعِ الأَروَعُ",3,"ع",1,0],["فكم يَدٍ لكَ لم تُخلِقْ صَنائِعُها","عندَ العُفاةِ وأخرى جَدَّدَتْ نِعَما",4,"م",2,0],["فَكَم يَومِ لَهوٍ قَد أَدَرنا بِأُفقِهِ","نُجومَ كُؤوسٍ بَينَ أَقمارِ نَدمانِ",5,"ن",1,0],["فَكَم يَشكو كَريمٌ مِن لَئيمٍ","وَكَم يَلقى هِجانٌ مِن هَجينِ",6,"ن",1,0],["فَكَم يَومِ لَهوٍ قَد شَهِدتُ وَلَيلَةٍ","وَلَيسَ عَلَينا لِلعَواذِلِ سُلطانُ",7,"ن",1,0],["فَكَم يَعرو الفَقيرَ بِهم خبالٌ","وَقَد تَلقى الغَنيّ لَهُ جَلالٌ",8,"ل",1,0],["فكم يَخافُ الفتى مَن كان يَأْملُه","وكم يُرجّي الفتَى مَن كان يَخْشاه",9,"ا",2,0],["فكم يا أيُّها المَولَى تُراني","أُعاني للحوادثِ ما أُعاني",10,"ن",2,0],["فَكَم يا فُرقَةَ الأَحبا","بِ جَيبي مِنكَ يَنعَطُّ",11,"ط",1,0],["فكم يولي الجميل أبو جميلٍ","ونوليه به شكراً وحمدا",12,"د",2,0],["فكم يُصَعَّرُ خَدٌّ غيرُ مُنْعَفِرٍ","وكم يَخِرُّ جبينٌ غيرُ سَجَّادِ",13,"د",1,0],["فكم يَحملُ الثقلَ الضعيفُ وكم تَرَى","يُقِلُّ وُسوقَ البعدِ جنبٌ مندَّبُ",14,"ب",1,0],["فكم يدٍ لم تجدْ أيداً يقومُ بها","ومنّةٍ ضعفْ عن حملها المنن",15,"ن",1,0],["فكم يوم جودٍ كنت بشراً بوجهه","ولا خيرَ في وجهٍ إذا لم يكن بشر",16,"ر",1,0],["فكم يسعى بيَ الواشونَ ظلماً","إليكِ وسقمُ جسمي مِن شهودي",17,"د",2,0],["فَكَم يَحظى بِغانِيَةٍ","وَكَم يَستَخوِلُ الخَوَلا",18,"ل",2,0],["فَكَمْ يَعِزُّ وشيطاني يَذِلُّ به","وكم يجور وسُلْطَاني أَبُو الْحَسَنِ",19,"ن",1,0],["فَكَمْ يَتَجَافَى خَصْرُهُ وَهْوَ نَاحِلٌ","وَكَمْ يَتَحَالَى رِيقُهُ وَهْوَ بارِدُ",20,"د",1,0],["فَكَمْ يُراعي وَكَمْ يُرَاعُ لَقَدْ","جَارَ عليهِ الغَرامُ مُذْ عَدَلا",21,"ل",2,0],["فَكَمْ يَتيِمٍ يُعَانِي الْفَقْرَ مَظْهَرُهُ","بَادِي الْمُعَانَاةِ فِي فَقْرٍ وَمِنْ عَدَمِ",22,"م",1,0],["فَكَم يَخفي الهَوَى كَبِدٌ كَتُومُ","يَبُوحُ بِسِرِّهِ دَمعٌ نَمُومُ",23,"م",1,0],["فكمْ يتمنَّى هذه يا ابنَ ناصرِ","يروحُ ويغدوُ لابْنةِ المجدِ خاطبا",24,"ب",2,0],["فكم يا بحر جود بحر خوف","مهول خضت مقتحما غماره",25,"ر",2,0],["فكم يوم جمعت الشمل فيه","بمر الهجر معسول الشمائل",26,"ل",1,0],["فكم يممته من جنوس عشاير","فحازوا ونالوا منه ما قد تخيروا",27,"ر",3,0],["فكم يقوم الوفا من عين مشهده","بوصف حق صفا عن شوب اكداره",28,"ر",2,0],["فكم يكتّم من سرّ تطالعه","وتحتهُ من خفايا الدهر أسرارُ",29,"ر",1,0],["فَكَمْ يا غَراماً جَائِراً تَرْشُقُ الحَشا","بِأَسْهُمِ وَجْدٍ مِنْ فِراقٍ ومِنْ هَجْرِ",30,"ر",1,0],["فكم يَنحت الهمُّ أحشاءَنا","وكم تستطيل يدُ الجائرِ",31,"ر",1,0],["فكم يوم يعز على الفوالي","به مني فراق المفرقين",32,"ن",1,0],["فكم يسر أتى من بعد عسر","وكم للدهر يوماً من آثاره",33,"ر",2,0],["فكم يا سعد من رجل عتل","زنيم يدعي صدق العفاف",34,"ف",1,0],["فكم يوم لنصرك مثل بدر","ملائكة السماء له جنود",35,"د",1,0],["فكم يومٍ أدَمتَ القتلَ فيهِ","بقوسي حاجبيكَ وسهمِ طرفِكْ",36,"ك",1,0],["فكم يدوم ويبقى الجذع من شجر","وكم يجف ويفنى فيه من فنن",37,"ن",1,0],["فكم يا سعد أخّرت التصافي","ولو أَسعفتَ وادينا لطابا",38,"ب",2,0],["فكم يثني على زمن","بها أهدَى له الزمن",39,"ن",1,0],["فكم يوم رأينا فيه صحواً","وأسمعنا بآخره الرعودا",40,"د",2,0],["فَكَم يُقاسي بِشَوق في البِعادِ جَوىً","اِذا الزَمانُ اِراهُ في الرَحيلِ عنىً",41,"ن",2,0],["فكم يوم بدر صال بدر واشرقت","بوارقه ما بين هام وأكيد",42,"د",1,0],["فَكَم يقال جنونٌ في الفنون وَكَم","لا يجزعون إِذا جار الهَوى وَبغى",43,"غ",2,0],["فَكَم يَسرٍ أتي مِن بَعد عسر","كَما عسرٌ أَتى مِن بَعد يسر",44,"ر",1,0],["فَكَم يَرقُبونَ الحُرَّ يَبغونَ وَصمَةً","وَكَم يَجلِبونَ الضَرَّ لِلبَيِّنِ النَفعِ",45,"ع",1,0],["فكم ينكر المرء الصديق لدى الرخا","ويعرفه من بعدها وهو مكروب",46,"ب",1,0],["فكم يد لك في الأيام باسمة","ساهلت فيها فذلت صعبة الدول",47,"ل",1,0],["فَكَم يَتبَع زَلال فاض من يَدِه","أَروي الاِوام وَأَسقى مِنهُ كُل ظَمىء",48,"م",3,0],["فكم يوم حتف أعقب الفتح إذ غدزوا","صيود أسود لم يزلن ضواريا",49,"ي",2,0],["فَكَم يَنابِيعَ مِن هَدْيٍ وَمِن رَشَدٍ","رَوَتْ بِرَيِّقِها المُخْضَلِّ قَلْبَ صَدٍ",50,"د",1,0],["فَكَمْ يَفِيضُ الهَوَى فِي وَاحَتِي أَدَبًا","لَفْظٌ يُرَاقِصُ أَلْفَاظًا وَ يَخْتَالُ",51,"ل",1,0],["فكم يشقو الفؤاد بعاد إلف","كأن هيامه يهوى العذابا",52,"ب",2,0],["فكمْ يعْرُبيٍّ كانَ سيِّدَ قوْمِهِ","وكانَ معَ الأعْداءِ في الظَّهْرِ خِنْجَرا !",53,"ر",2,0],["فَكَمْ يَعْسِلُ الحرفُ الجَميلُ على فمي","يُريقُ سُلافًا في كؤوسٍ منَ الوَجْدِ",54,"د",1,0],["فكم يقاسي فيك كم يخاطر","وكم يلاقي في هواك أخطار",55,"ر",1,0],["‏ ‏فكم يقتل الإنسانُ أحلى حياتِهِ","‏ ‏ فداء التداري في لباس المظاهرِ",56,"ر",1,0],["فكم يهمي مع الأحلام طيفي","ليرسمَ للورى أملا جميلا",57,"ل",2,0],["فكم يلقون في شعري رياضا","تعانق زهرها شطرًا فشطرا",58,"ر",2,0],["فكم يولي الجميل أبو جميل","بجدوى أنبتت شيحاً ورندا",59,"د",2,0]]}