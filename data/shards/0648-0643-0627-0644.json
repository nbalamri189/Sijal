oem.aspx?id=176792",""],[463,"لعلَّ الركبَ أن خلصوا نجيَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60283&r=&rc=339",""]],"verses":[["وَكَآلِ جَفنَةَ أَزعَجَتهُم نَبوَةٌ","نَقَلَت قِبابَهُمُ عَنِ الجَولانِ",0,"ن",1,0],["وَكَالثُغورِ أَقاحيها إِذا غَرَبَت","شَمسُ النَهارِ وَأَلقَت صِبغَها الأُصُلُ",1,"ل",1,0],["وَكالرَّوضِ يَرفَضُّ النَّدى مِن عِذارِهِ","غَدا يَرتَوي مِن فَيضِ عَبرَتِها الخَدُّ",2,"د",1,0],["وَكَالوَرَقِ الخِفافِ وَذاتُ غَربٍ","تَرى فيها عَنِ الشِرَعِ اِزوِرارا",3,"ر",2,0],["وكالضيف أستقريه في سنة الكرى","وهل تنقعُ الأحلام غلّةَ ظمآنِ",4,"ن",1,0],["وكالحُولاء مراعي المسيم","عندك والرئة المنهلُ",5,"ل",1,1],["وكالغيث إلا أن نوءَ نجومها","تخالف أنواءَ الكواكب في النَّزْلِ",6,"ل",1,1],["وكالهلال حبى طهر السلام إلى","بدرٍ فيا حسن مهلول ومكتمل",7,"ل",1,0],["وكالطبيب أبى إسحاقَ إن لهُ","نفعاً مبيناً إذا ما أجحف الضرر",8,"ر",1,0],["وكالنّطيف نزيف إنه لهبٌ","ذاكٍ له حركات كلها شَرَر",8,"ر",1,0],["وَكَالفَضاءِ الرَحبِ في حِلمِهِ","يَضطَرِبُ البازي بِه وَالقُطاة",9,"ه",1,0],["وَكَالنَقعِ في جَوفِ الدَواةِ أَوِ الدُجى","وَكَالهِندِواني بَينَ أَنمُليَّ الخَمسِ",10,"س",1,0],["وَكَالسَيفِ إِن لايَنتَهُ لانَ مَسُّهُ","وَحَدّاهُ إِن خاشَنتَهُ خَشِنانِ",11,"ن",1,0],["وَكَالقَضيبِ اللَدنِ قَد","طاوَعَ في الشَكلِ اليَدا",12,"د",2,0],["وَكالسِراجِ في يَدِ الري","حِ أَضاءَ وَخَبا",13,"ب",2,0],["وَكَالإِمامِ إِذا ما فَضَّ مُزدَحِماً","بِمَدمَعٍ في مَآقي القَومِ مُزدَحِمِ",14,"م",1,0],["وكالشمسِ تغشى الناظرينَ بنورِها","وليس إليها للأكُفِّ سَبيلُ",15,"ل",1,0],["وَكَالبَدرِ وافَتهُ لِتِمٍّ سُعودُهُ","وَتَمَّ سَناهُ وَاِستَقَلَّت مَنازِلُه",16,"ل",2,0],["وَكَالعَيلَمِ الدُنيا افتَدى بَعضُ أَهلِهِ","بِبَعضٍ فَأَمسوا بَينَ غَرقَى وَعُوَّمِ",17,"م",1,0],["وَكَاللَيثِ شَدَّ عَلى قِرنِهِ","وَكَالغَيثِ جادَ وَكَالبَدرِ لاحا",18,"ح",2,0],["وَكَالصَِراطِ وكالمِيزانِ مَعْدِلَةً","فالقِسْطُ مِنْ غَيرها في الناسِ لَمْ يَقُمِ",19,"م",1,0],["وكالسَّنانِ الذي يهتَزُّ في يَدِهِ","ومثلَ أجدَلِهِ الصّقرِ القُطامي",20,"ي",1,0],["وكالمَشرَفيِّ العَضْبِ يَفري غِرارُهُ","وكالعارضِ الوسميِّ يَنهَلُّ مُغدِقُه",21,"ق",2,0],["وكالكوكبِ الدُّرّيِّ يُحمدَ في الوغى","تألُّقُ بِيضِ المُرهَفاتِ تألُّقُه",21,"ق",2,0],["وَكَالسَيفِ إِن لايَنتَهُ لانَ مَتنُهُ","وَحدّاهُ إِن خاشَنتَهُ خَشِنانِ",22,"ن",1,1],["وكالنّارِ الحَيَاةُ فمِنْ رَمادٍ","أواخِرُهَا وأوّلُها دُخانُ",23,"ن",1,0],["وكالطفل غدا الكهل","فما للكهل لا يقمط",24,"ط",1,0],["وكالحلم جئتي .. وكالحلم غبتي","وأصبحت أنفض منك اليدا",25,"د",2,1],["وكالثّلج فوق احتضار الطيّور","تراخت على مقلتها العشايا",26,"ا",3,0],["وكالنّظيف نزيف إنه لهبٌ","ذاك له حركات كلها شَرَر",27,"ر",1,0],["وكالعيلم الدنيا افتدى بعض أهله","ببعضٍ فأمسوا بن غرقي وعوم",28,"م",1,0],["وكالناشري الحبر أحمد ذي النقا","ملكت بما آذيته كل ناشري",29,"ر",2,0],["وَكَالنارِ في يَبسِ الهَشيمِ مَقالُهُم","أَلا إِنَّ أَصلَ العودِ مِن حَيثُ يُقضَمُ",30,"م",1,0],["وكالنّسْرين في ثَغْرِ الأقاحي","يَفوحُ الطِّيبُ منها بانْسيابِ",31,"ب",1,0],["وكالبئرِ يَنْزِفُها الماتحون","وفي الحال من نَزْفِها تَسْتَجِم",32,"م",1,0],["وكالقمرين حسنٌ في وفاء","فصيح اللفظ ينطق عن بيان",33,"ن",1,0],["وكالسيف متناه تلين للامس","وحدّاه فيها الموت والموت قاضب",34,"ب",1,0],["وكالشمس والبدر المضيئة في الضحى","إذا ازدحمت في جانبيه المواكب",34,"ب",1,0],["وَكالعناكبِ قد فازت بنصرتهِ","وُرقُ الحمائمِ والطير الأبابيلُ",35,"ل",1,0],["وَكَالمُبتَلى لَيلهِ بِالسقامِ","يُراعي الصَباح وَيَرجُو الطَبيبا",36,"ب",2,0],["وَكَالخَيالِ لِسانٌ يُستَفَزُّ بِهِ","شَعبٌ أَبِيٌّ إِلى تَجديدِ بُنيانِ",37,"ن",1,0],["وكالسيفِ إن قاومتَه حدُّ عَزْمه","وأَحْلَى من الإنصَافِ حين يُجامل",38,"ل",1,0],["وكالسكرانِ لا يَدْري","بما يَفْعله سُكْرا",39,"ر",2,0],["وكالتارك ما يَجني","وكالجاهل ما يَقْرا",39,"ر",2,0],["وَكَالأَساريعِ مِن بَنانِ يَدٍ","بِالدَمِ لا بِالحِنّاءِ مَخضوبِ",40,"ب",1,0],["وَكَالتِي نَجَبَتْ بِهِ","وَبِالْحُسَيْنِ أُخَيِّهِ",41,"ي",2,0],["وكاللآلئِ والمرجان أنمُلُها","فليسَ يحملُ عقداً مثلها العنق",42,"ق",1,0],["وَكالغمام اذا استمطرته كرما","وَكالصبا خلقا ان رق مهواه",43,"ا",2,0],["وَكَالشُهدِ بِالراحِ أَخلاقُهُم","وَأَحلامُهُم مِنهُما أَعذَبُ",44,"ب",1,0],["وَكَالمِسكِ تُربُ مَقاماتِهِم","وَرَيّا قُبورِهِمُ أَطيَبُ",44,"ب",1,0],["وكالرودِ لم تعطِفْ عَلَى غير مُعربٍ","وَلم تتخذْ غيرَ الفصيح لها خدرا",45,"ر",2,0],["وكالمسك نشراً إذ يمر بطيبة","نسيمات وادي المنحنى حي هبت",46,"ه",3,0],["وَكالمَيتِ حَيٌّ دامَ في الذُلِّ راغِباً","عَنِ العِزِّ بِالعَيشِ الَّذي حُلوُهُ مُرُّ",47,"ر",1,0],["وَكَالثَمَرِ الَّذي يَبدو مَريراً","وَيَحلو فيهِ عَقبَ الصَبرِ يَحلو",48,"ل",2,0],["وَكَالإِقدامِ في خَوضِ المَنايا","إِلى العَلياءِ فيهِ الجَهلُ عَقلُ",48,"ل",1,0],["وكالصُّبحِ مُبْيْضاً له الرَّأيُ يُنتضَى","إذا ما أظَلَّ الخَطْبُ كاللّيلِ مُسوّدا",49,"د",2,0],["وكالشّمس ما إن تُضرَبُ الحُجْبُ دونه","ولكن بفَضْلِ النّورِ عنه حِجاب",50,"ب",1,0],["وكالبرقِ في ميزانِ شوقي ولهفتي","يَلُوحُ سريعاً للعيون ويَرْحَلُ",51,"ل",1,0],["وكالشبابِ الشَّيبُ لا مِيزةٌ","بينهُما عندَ المجَانِينِ",52,"ن",1,0],["وكالنجوم من القرناس ظاهرةٍ","بيض مواضٍ عراضٍ زهر ناضرة",53,"ه",1,0],["وكالنُهى والمُنى فيمن شَدَدتَ به","للملكِ عِصْمَةَ مشدودٍ بِهِ عُصُمُكْ",54,"ك",1,0],["وكالجَيشِ إذ أعلقْتهُ مِنكَ نِسبَةً","بِعِزَّتها تعلُو الجيوشُ وتجتاحُ",55,"ح",1,0],["وكالغصن ريان بماء حياته","فإن مات أضحى مسحتاً أَي مسحت",56,"ت",1,0],["وكآل العباس إِذ كان عبد الل","ه يقضي طوع المنى أَوطارهْ",57,"ر",2,0],["وكالظبيات أعطافاً عطاشا","إذا ضُمَّتْ وأردافا رُوِيَّا",58,"ي",2,0],["وكالدُّمى من ظَبيَاتِ حاجرٍ","كوالئاً يُصلحن من أحوالها",59,"ل",3,0],["وكالة الله فيكُمُ لي","حسبي رعتكم عينُ الوكيلِ",60,"ل",1,0],["وكالراح أخلاقاً إذا امتزجت به","ولكنه للكأس غيرُ صريعِ",61,"ع",1,0],["وكالشجا قافيةٌ أسغتُها","لو عارضت حنجرةَ البازِلِ أطّْ",62,"ط",1,0],["وكالمُهَراتِ في فَتَياتِ حيٍّ","حَكيْنَ رماحَه فخطَرنَ سُمرا",63,"ر",2,0],["وكالظبي يُظلمَ باسم الجِمال","فيطغَى إباءً ويُغضِي اغتفارا",64,"ر",2,0],["وكالسماء عِمّةٌ صِبْغَتُها","قد جاءها من الزمان وافدُ",65,"د",1,0],["وكالرقمِ يحسَبه من قرا","ويُعرَفُ ممَّنْ إذا مَن كُتِبْ",66,"ب",1,1],["وكالئةٍ ترعَى الشخوصَ كأنّها","أخو ليلةٍ بات الربيئةَ يرقُبُ",67,"ب",1,0],["وكاليث يُرْدي كلَّ قرْنٍ مُنازلٍ","وكالغيث يُحْيي كلَّ أغْبرَ هامِد",68,"د",1,0],["وكالبدر في ليلِ الذ