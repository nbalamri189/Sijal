{"poems":[[53,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[63,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[3,"حولي تنفض اِستُكَ مذرويه","https://www.aldiwan.net/poem95.html",""],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[37,"وكالحولاء مراعي المسيم","https://www.aldiwan.net/poem7393.html","البسيط"],[37,"وكالغيث إلا أن نوء نجومها","https://www.aldiwan.net/poem7474.html","الطويل"],[72,"سلوت لكن قلبي يا سعاد سلي","https://www.aldiwan.net/poem19470.html","البسيط"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[91,"أقص عليكم ما جرى لي بالأمس","https://www.aldiwan.net/poem8975.html","عموديه"],[38,"كريم يغض الطرف فضل حيائه","https://www.aldiwan.net/poem7870.html","الطويل"],[85,"لولا التقى لقلت لم يخلق سواك","https://www.aldiwan.net/poem7931.html","مجزوء الرجز"],[85,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[62,"تصدى وللحي الجميع رحيل","https://www.aldiwan.net/poem52316.html","الطويل"],[45,"هب الدار ردت رجع ما أنت قائله","https://www.aldiwan.net/poem65535.html","الطويل"],[105,"بني مصر ما للطامعين وما لكم","https://www.aldiwan.net/poem43152.html","الطويل"],[52,"لقد شد ملك بني هاشم","https://www.aldiwan.net/poem27156.html","المتقارب"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[50,"وكالسيف إن لاينته لان متنه","https://www.aldiwan.net/poem24455.html","الطويل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147495","الهزج"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199493","المتقارب"],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[51,"لا يغْضَبنّ لعمرو من له خطرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=29233",""],[105,"بني مصر ما للطامعين وما لكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54908&r=&rc=78",""],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[165,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[179,"إلى عمان","https://www.aldiwan.net/poem50694.html","الوافر"],[186,"وإني لأعجب من شائب","https://www.aldiwan.net/poem14653.html","المتقارب"],[187,"بعبد الواحد استعصمت لما","https://www.aldiwan.net/poem43203.html","الوافر"],[187,"ليالي الصبا درت عليك السحائب","https://www.aldiwan.net/poem44142.html","الطويل"],[190,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[194,"كتبت إليك ولي مقلة","https://www.aldiwan.net/poem12829.html","المتقارب"],[224,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[230,"فتى مثل ضوء الشمس نور جبينه","https://www.aldiwan.net/poem50870.html","الطويل"],[230,"إذا لم تعرف الخيرا","https://www.aldiwan.net/poem51010.html","الهزج"],[236,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[238,"إدريس نجل سميه","https://www.aldiwan.net/poem19754.html","مجزوء الكامل"],[271,"أزنبق كفك البيضاء فالعبق","https://www.aldiwan.net/poem35444.html","البسيط"],[272,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[288,"أبلغ ضبيعة أن البلاد","https://www.aldiwan.net/poem1919.html","المتقارب"],[299,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[305,"سلام على إخواننا والأحبة","https://www.aldiwan.net/poem16830.html","الطويل"],[350,"طليق دموع لا يفك له أسر","https://www.aldiwan.net/poem15720.html","الطويل"],[350,"حرام دمي لمن أهواه حل","https://www.aldiwan.net/poem15859.html","الوافر"],[365,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[365,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[401,"في جوف الكعبة","https://www.aldiwan.net/poem6711.html","عموديه"],[410,"أحببتها في عنفوان الصبا","https://www.aldiwan.net/poem32520.html","السريع"],[430,"للصيد فضل لدى أهل العلى ظهرا","https://www.aldiwan.net/poem40507.html","البسيط"],[440,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[440,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[442,"عزاء فما نفس على الموت عزت","https://www.aldiwan.net/poem14440.html","الطويل"],[453,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[459,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[459,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[459,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[459,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[459,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[459,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[459,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[459,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[459,"وكالرقمِ يحسبه من قرا","https://www.aldiwan.net/poem56269.html","المتقارب"],[459,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[462,"إذا شئت أن تلقى المناقب والعلى","https://www.aldiwan.net/poem16218.html","الطويل"],[465,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[530,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[539,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[552,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[574,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"]],"verses":[["وَكَآلِ جَفنَةَ أَزعَجَتهُم نَبوَةٌ","نَقَلَت قِبابَهُمُ عَنِ الجَولانِ",0,"ن",1,0],["وَكَالثُغورِ أَقاحيها إِذا غَرَبَت","شَمسُ النَهارِ وَأَلقَت صِبغَها الأُصُلُ",1,"ل",1,0],["وَكالرَّوضِ يَرفَضُّ النَّدى مِن عِذارِهِ","غَدا يَرتَوي مِن فَيضِ عَبرَتِها الخَدُّ",2,"د",1,0],["وَكَالوَرَقِ الخِفافِ وَذاتُ غَربٍ","تَرى فيها عَنِ الشِرَعِ اِزوِرارا",3,"ر",2,0],["وكالضيف أستقريه في سنة الكرى","وهل تنقعُ الأحلام غلّةَ ظمآنِ",4,"ن",1,0],["وكالحُولاء مراعي المسيم","عندك والرئة المنهلُ",5,"ل",1,1],["وكالغيث إلا أن نوءَ نجومها","تخالف أنواءَ الكواكب في النَّزْلِ",6,"ل",1,1],["وكالهلال حبى طهر السلام إلى","بدرٍ فيا حسن مهلول ومكتمل",7,"ل",1,0],["وكالطبيب أبى إسحاقَ إن لهُ","نفعاً مبيناً إذا ما أجحف الضرر",8,"ر",1,0],["وكالنّطيف نزيف إنه لهبٌ","ذاكٍ له حركات كلها شَرَر",8,"ر",1,0],["وَكَالفَضاءِ الرَحبِ في حِلمِهِ","يَضطَرِبُ البازي بِه وَالقُطاة",9,"ه",1,0],["وَكَالنَقعِ في جَوفِ الدَواةِ أَوِ الدُجى","وَكَالهِندِواني بَينَ أَنمُليَّ الخَمسِ",10,"س",1,0],["وَكَالسَيفِ إِن لايَنتَهُ لانَ مَسُّهُ","وَحَدّاهُ إِن خاشَنتَهُ خَشِنانِ",11,"ن",1,0],["وَكَالقَضيبِ اللَدنِ قَد","طاوَعَ في الشَكلِ اليَدا",12,"د",2,0],["وَكالسِراجِ في يَدِ الري","حِ أَضاءَ وَخَبا",13,"ب",2,0],["وَكَالإِمامِ إِذا ما فَضَّ مُزدَحِماً","بِمَدمَعٍ في مَآقي القَومِ مُزدَحِمِ",14,"م",1,0],["وكالشمسِ تغشى الناظرينَ بنورِها","وليس إليها للأكُفِّ سَبيلُ",15,"ل",1,0],["وَكَالبَدرِ وافَتهُ لِتِمٍّ سُعودُهُ","وَتَمَّ سَناهُ وَاِستَقَلَّت مَنازِلُه",16,"ل",2,0],["وَكَالعَيلَمِ الدُنيا افتَدى بَعضُ أَهلِهِ","بِبَعضٍ فَأَمسوا بَينَ غَرقَى وَعُوَّمِ",17,"م",1,0],["وَكَاللَيثِ شَدَّ عَلى قِرنِهِ","وَكَالغَيثِ جادَ وَكَالبَدرِ لاحا",18,"ح",2,0],["وَكَالصَِراطِ وكالمِيزانِ مَعْدِلَةً","فالقِسْطُ مِنْ غَيرها في الناسِ لَمْ يَقُمِ",19,"م",1,0],["وكالسَّنانِ الذي يهتَزُّ في يَدِهِ","ومثلَ أجدَلِهِ الصّقرِ القُطامي",20,"ي",1,0],["وكالمَشرَفيِّ العَضْبِ يَفري غِرارُهُ","وكالعارضِ الوسميِّ يَنهَلُّ مُغدِقُه",21,"ق",2,0],["وكالكوكبِ الدُّرّيِّ يُحمدَ في الوغى","تألُّقُ بِيضِ المُرهَفاتِ تألُّقُه",21,"ق",2,0],["وَكَالسَيفِ إِن لايَنتَهُ لانَ مَتنُهُ","وَحدّاهُ إِن خاشَنتَهُ خَشِنانِ",22,"ن",1,1],["وكالنّارِ الحَيَاةُ فمِنْ رَمادٍ","أواخِرُهَا وأوّلُها دُخانُ",23,"ن",1,0],["وكالطفل غدا الكهل","فما للكهل لا يقمط",24,"ط",1,0],["وكالحلم جئتي .. وكالحلم غبتي","وأصبحت أنفض منك اليدا",25,"د",2,1],["وكالثّلج فوق احتضار الطيّور","تراخت على مقلتها العشايا",26,"ا",3,0],["وكالنّظيف نزيف إنه لهبٌ","ذاك له حركات كلها شَرَر",27,"ر",1,0],["وكالعيلم الدنيا افتدى بعض أهله","ببعضٍ فأمسوا بن غرقي وعوم",28,"م",1,0],["وكالناشري الحبر أحمد ذي النقا","ملكت بما آذيته كل ناشري",29,"ر",2,0],["وَكَالنارِ في يَبسِ الهَشيمِ مَقالُهُم","أَلا إِنَّ أَصلَ العودِ مِن حَيثُ يُقضَمُ",30,"م",1,0],["وكالنّسْرين في ثَغْرِ الأقاحي","يَفوحُ الطِّيبُ منها بانْسيابِ",31,"ب",1,0],["وكالبئرِ يَنْزِفُها الماتحون","وفي الحال من نَزْفِها تَسْتَجِم",32,"م",1,0],["وكالقمرين حسنٌ في وفاء","فصيح اللفظ ينطق عن بيان",33,"ن",1,0],["وكالسيف متناه تلين للامس","وحدّاه فيها الموت والموت قاضب",34,"ب",1,0],["وكالشمس والبدر المضيئة في الضحى","إذا ازدحمت في جانبيه المواكب",34,"ب",1,0],["وَكالعناكبِ قد فازت بنصرتهِ","وُرقُ الحمائمِ والطير الأبابيلُ",35,"ل",1,0],["وَكَالمُبتَلى لَيلهِ بِالسقامِ","يُراعي الصَباح وَيَرجُو الطَبيبا",36,"ب",2,0],["وَكَالخَيالِ لِسانٌ يُستَفَزُّ بِهِ","شَعبٌ أَبِيٌّ إِلى تَجديدِ بُنيانِ",37,"ن",1,0],["وكالسيفِ إن قاومتَه حدُّ عَزْمه","وأَحْلَى من الإنصَافِ حين يُجامل",38,"ل",1,0],["وكالسكرانِ لا يَدْري","بما يَفْعله سُكْرا",39,"ر",2,0],["وكالتارك ما يَجني","وكالجاهل ما يَقْرا",39,"ر",2,0],["وَكَالأَساريعِ مِن بَنانِ يَدٍ","بِالدَمِ لا بِالحِنّاءِ مَخضوبِ",40,"ب",1,0],["وَكَالتِي نَجَبَتْ بِهِ","وَبِالْحُسَيْنِ أُخَيِّهِ",41,"ي",2,0],["وكاللآلئِ والمرجان أنمُلُها","فليسَ يحملُ عقداً مثلها العنق",42,"ق",1,0],["وَكالغمام اذا استمطرته كرما","وَكالصبا خلقا ان رق مهواه",43,"ا",2,0],["وَكَالشُهدِ بِالراحِ أَخلاقُهُم","وَأَحلامُهُم مِنهُما أَعذَبُ",44,"ب",1,0],["وَكَالمِسكِ تُربُ مَقاماتِهِم","وَرَيّا قُبورِهِمُ أَطيَبُ",44,"ب",1,0],["وكالرودِ لم تعطِفْ عَلَى غير مُعربٍ","وَلم تتخذْ غيرَ الفصيح لها خدرا",45,"ر",2,0],["وكالمسك نشراً إذ يمر بطيبة","نسيمات وادي المنحنى حي هبت",46,"ه",3,0],["وَكالمَيتِ حَيٌّ دامَ في الذُلِّ راغِباً","عَنِ العِزِّ بِالعَيشِ الَّذي حُلوُهُ مُرُّ",47,"ر",1,0],["وَكَالثَمَرِ الَّذي يَبدو مَريراً","وَيَحلو فيهِ عَقبَ الصَبرِ يَحلو",48,"ل",2,0],["وَكَالإِقدامِ في خَوضِ المَنايا","إِلى العَلياءِ فيهِ الجَهلُ عَقلُ",48,"ل",1,0],["وكالصُّبحِ مُبْيْضاً له الرَّأيُ يُنتضَى","إذا ما أظَلَّ الخَطْبُ كاللّيلِ مُسوّدا",49,"د",2,0],["وكالشّمس ما إن تُضرَبُ الحُجْبُ دونه","ولكن بفَضْلِ النّورِ عنه حِجاب",50,"ب",1,0],["وكالبرقِ في ميزانِ شوقي ولهفتي","يَلُوحُ سريعاً للعيون ويَرْحَلُ",51,"ل",1,0],["وكالشبابِ الشَّيبُ لا مِيزةٌ","بينهُما عندَ المجَانِينِ",52,"ن",1,0],["وكالنجوم من القرناس ظاهرةٍ","بيض مواضٍ عراضٍ زهر ناضرة",53,"ه",1,0],["وكالنُهى والمُنى فيمن شَدَدتَ به","للملكِ عِصْمَةَ مشدودٍ بِهِ عُصُمُكْ",54,"ك",1,0],["وكالجَيشِ إذ أعلقْتهُ مِنكَ نِسبَةً","بِعِزَّتها تعلُو الجيوشُ وتجتاحُ",55,"ح",1,0],["وكالغصن ريان بماء حياته","فإن مات أضحى مسحتاً أَي مسحت",56,"ت",1,0],["وكآل العباس إِذ كان عبد الل","ه يقضي طوع المنى أَوطارهْ",57,"ر",2,0],["وكالظبيات أعطافاً عطاشا","إذا ضُمَّتْ وأردافا رُوِيَّا",58,"ي",2,0],["وكالدُّمى من ظَبيَاتِ حاجرٍ","كوالئاً يُصلحن من أحوالها",59,"ل",3,0],["وكالة الله فيكُمُ لي","حسبي رعتكم عينُ الوكيلِ",60,"ل",1,0],["وكالراح أخلاقاً إذا امتزجت به","ولكنه للكأس غيرُ صريعِ",61,"ع",1,0],["وكالشجا قافيةٌ أسغتُها","لو عارضت حنجرةَ البازِلِ أطّْ",62,"ط",1,0],["وكالمُهَراتِ في فَتَياتِ حيٍّ","حَكيْنَ رماحَه فخطَرنَ سُمرا",63,"ر",2,0],["وكالظبي يُظلمَ باسم الجِمال","فيطغَى إباءً ويُغضِي اغتفارا",64,"ر",2,0],["وكالسماء عِمّةٌ صِبْغَتُها","قد جاءها من الزمان وافدُ",65,"د",1,0],["وكالرقمِ يحسَبه من قرا","ويُعرَفُ ممَّنْ إذا مَن كُتِبْ",66,"ب",1,1],["وكالئةٍ ترعَى الشخوصَ كأنّها","أخو ليلةٍ بات الربيئةَ يرقُبُ",67,"ب",1,0],["وكاليث يُرْدي كلَّ قرْنٍ مُنازلٍ","وكالغيث يُحْيي كلَّ أغْبرَ هامِد",68,"د",1,0],["وكالبدر في ليلِ الذوائب طالعٌ","وكالغصن في ظلِّ الصّبا يترنَّحُ",69,"ح",1,0],["وكَالسّاعِي إلى الظَّلْما بِجَهْدٍ","ونُورُ الشَّمْسِ في رَأي الْعِيانِ",70,"ن",1,0],["وكالمَدَافِع خلفَ البابِ سُعلَتُه","يهتَزُّ مِنها جِدَار المطعم البلدي",71,"د",2,0],["وكالفٍ بالحربِ لو أنّه","أُطعِمَ يومَ السِّلمِ لم يطعمِ",72,"م",1,0],["وَكَالصَقرِ فَوقَ السابِقاتِ اِغتَضَت بِهِ","أَعالِيَ أَعوادِ مِنَ النَعشِ فَاِرجَحَن",73,"ن",1,0]]}