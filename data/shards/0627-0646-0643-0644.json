{"poems":[[57,"ظلوم يا منية مولاها","https://www.aldiwan.net/poem26037.html","السريع"],[90,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[74,"غازلتني سمراء في حلية المر","https://www.aldiwan.net/poem18765.html","الخفيف"],[91,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[87,"الحيوان خلق له عليك حق","https://www.aldiwan.net/poem7932.html","مجزوء الرجز"],[47,"لولا تعنفني لقلت المنزل","https://www.aldiwan.net/poem65578.html","الكامل"],[30,"إنك لاق بالمحصب من منى","https://www.aldiwan.net/poem5233.html","الطويل"],[99,"نار من الشوق إثر نار","https://www.aldiwan.net/poem24922.html","مجزوء البسيط"],[71,"يقول أرمد عين","https://www.aldiwan.net/poem29109.html","المجتث"],[107,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[13,"إنك لا بزاً منعت ولا يداً","https://www.aldiwan.net/poem2220.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54798","الخفيف"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12784","المنسرح"],[53,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[133,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[211,"إنك لم تك كابن الشريد","https://www.aldiwan.net/poem27897.html","المتقارب"],[305,"إنك لو رأيتني والقسرا","https://www.aldiwan.net/poem45487.html","الرجز"],[382,"أقوت عهودهم فأين ذمامي","https://www.aldiwan.net/poem59264.html","الكامل"],[534,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[543,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"],[556,"أبي الزمان سوى ما يكره الشرف","https://www.aldiwan.net/poem47404.html","البسيط"],[563,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87018","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53895","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48648","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77528","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77617","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77586","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119907","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119912","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[1318,"","https://poetry.dctabudhabi.ae/diwan/poem/145326","المنسرح"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101580","الرمل"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31493","الطويل"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105293","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42481","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113029","الخفيف"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113038","الخفيف"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111148","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121199","البسيط"],[2486,"","https://poetry.dctabudhabi.ae/diwan/poem/122167","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205081","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204470","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204455","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200141","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204578","الخفيف"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67591","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132782","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100787","البسيط"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70361","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126281","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104378","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86539","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135933","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102968","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76455","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54373","الكامل"],[4582,"","https://poetry.dctabudhabi.ae/diwan/poem/97788","الوافر"],[4785,"لبنان مل","https://www.poetsgate.com/ViewPoem.aspx?id=129734",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5376,"مناجاةُ أسير","https://www.poetsgate.com/ViewPoem.aspx?id=188264",""],[5956,"فلسطين أرض العرب*","https://www.poetsgate.com/ViewPoem.aspx?id=182863",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""]],"verses":[["إِنَّكَ لَو أَبصَرتَها مَرَّةً","أَجلَلتَها أَن تَتَمَنّاها",0,"ا",3,0],["أن كلّفَتْني السكاري شُربَ خمرتهم","شربت لكن دخاناً من سكاراتي",1,"ت",2,0],["إن كلِّي يحبُّ كلّك إلا","إن قلبي يحبُّ من فيك أكثر",2,"ر",1,0],["ان كل اعتمادنا","لعلي العلم والعلم",3,"م",1,0],["إِن كَلَّ دَعهُ يَستَرِح","وَداوِهِ إِذا جُرِح",4,"ح",1,0],["إِن كَلَّ صَرفُ الدَهرِ لَم يَكلِل وَإِن","غَفَلَ الرَبيعُ فَجودُهُ لا يَغفُلُ",5,"ل",1,0],["إِنَّكَ لاقٍ بِالمُحَصَّبِ مِن مِنىً","فَخاراً فَخَبِّرني بِمَن أَنتَ فاخِرُ",6,"ر",1,1],["إنك لي مبدأ وَعَودٌ","منك إلى صدرِك الفِرار",7,"ر",1,0],["إنْ كَلَّ سيفُ جفوني","فذا عذاري مسِنِّي",8,"ي",1,0],["إنَّ كلَّ الخيرِ يا صَفوانُ في","مَهلكِ القومِ فلا تَعْدُ الرَّشادا",9,"د",2,0],["إِنَّكَ لا بَزّاً مَنَعتَ وَلا يَداً","وَإِنَّ السُيوفَ بِالأَكُفِّ شَوارِعُ",10,"ع",1,1],["إن كلاً منهنَّ يَجري من الغَر","ب إِلى الشرق حولها في زَهاء",11,"ا",2,0],["إنّ كُلَيْباً كان لَيْثَ الثَّرَى","والهِجْرِسَ الخادِرَ من غيرِ فَيْل",12,"ل",1,0],["إِنَّ كَلْباً بَيْنَ البُيُوتِ طَلِيقاً","لَهْوَ خَيْرٌ مِنْ ضَيْغَمِ فِي الْحَدِيدِ",13,"د",1,0],["إِنَّكِ لا تَعرِفينَ ما الهَمُّ وَال","غَمُّ وَلا تَعلَمينَ ما الأَرَقُ",14,"ق",1,1],["أنَّكَ لمَّا هَرَّهُ الطَّغامُ","ونَبَحَتْ في وجههِ اللئامُ",15,"م",1,0],["إِنَّ كلَّ الناس أشباهٌ","إذا زِحتَ السُتور",16,"ر",1,0],["إِنَّكَ لَم تَكُ كَاِبنِ الشَريدِ","وَلَكِن أَبوكَ أَبو سالِمِ",17,"م",1,1],["إِنَّكَ لَو رَأَيتَني وَالقَسرا","مُجَشَّرَينِ قَد رَعَينا شَهرا",18,"ر",2,1],["إن كَلَّموا كَلَموا فؤادَ محبِّهم","أو سلَّموا ثَلَموا بغير كلام",19,"م",1,0],["أنَّ كِلا الْقَوْلَيْن","نابٍ بِغَيْرِ مَيْنِ",20,"ن",1,0],["إن كلِّيةَ ابنِ يُوسُفَ قِدماً","مَنبَعٌ لِلفُنون منذُ قُرُون",21,"ن",1,0],["إنْ كل أطلق فيك الدّهرُ منطقَه","فقد دعاك لسانٌ حشوُهُ كَفَفُ",22,"ف",1,0],["إن كلي قد شف عنها جهاراً","فاعرفوها في أرجلي والأيادي",23,"د",2,0],["إنكليزية كَريمة أَصل","بَينَ أَهل الجَمال تدعى بَبايل",24,"ل",1,0],["إِنَّكَ لم تُبْقِ في الإِنسانِ جارحةً","إلاّ تمنَّتْ مكاناً جانبَ الأُذُنِ",25,"ن",1,0],["إنك لا تبغين غير الرزقِ","ليقتل الجوع جميع الخلقِ",26,"ق",1,0],["إِنكِ لَو غرست تَحتَ رجلي","أَو كُنتِ فارَقتِ الحِمى مِن أَجلي",27,"ي",1,0],["إِنَّكَ لا تُؤخذ مثلي للشَوا","دَع عَنكَ تَعنيفي وَذُق طَعمَ الهَوا",28,"ه",3,0],["إِنَّك لَن تَهدي الَّذي أَحببتا","وَقُل لِلبُغاةِ إِن أَعجَبتا",29,"ت",2,0],["إنّك لوطيٌّ ولكنَّما","تفرُغُ يا أخزى الورى مِن وَرا",30,"ر",2,0],["أنك لا تقرب أبوابه","يوما إلى أن يقع المنجل",31,"ل",1,0],["إن كلموا بمواضيعهم وألسنهم","فإنهم بلغاء أحكموا الحكما",32,"م",2,0],["أنك للأولى بذاك المقام","مثلك لا يهنأ فوق الرغام",33,"م",1,0],["إن كلام أبي أحمد الحسن","أسا كلام الهموم والحزن",34,"ن",1,1],["إن كل اللُطف والظرف لقَد","جمعا في ذلك الجنس العجيب",35,"ب",1,1],["إِنَّكِ لَو أَبصَرتِ مَصرَعَ خالِدٍ","بِجَنبِ السِتارِ بَينَ أَظلَمَ فَالحَزمِ",36,"م",1,1],["إن كلمونا تكلمنا وان سكتوا","عنا سكتنا بلاعيّ ولا حصر",37,"ر",1,0],["إن كُلُّ جودٍ في الأنامِ مقسَّمٌ","فله إليه من الورى إيماءُ",38,"ا",2,0],["إِنَّ كُلَّ العَدلِ يَستَأهِلهُ","عامِلٌ عَن نَفعِكُم لَم يَعدِلِ",39,"ل",1,0],["إن كلَّ الحياة كأسٌ مدارٌ","ونديمٌ وشادنٌ من سقاتك",40,"ك",1,0],["إنَّ كلَّ الحياة كأسٌ مدارٌ","ونديمٌ حلوٌ وساقٍ كريمُ",41,"م",1,0],["ان كل عزمهم بالجري مدهم","أغر نال لغايات العلوم مدى",42,"د",2,0],["ان كل نعل غيري خيله ذهبا","وربما كان ممن دأبه الفند",43,"د",1,0],["إنَّك لاقٍ غداً غُواةَ بني","عمي فانظر ما أنت مُزدَهِفُ",44,"ف",1,0],["ان كلموني أعيا عن جوابهم","بمنطق لي يرضيهم ويرضيني",45,"ن",2,0],["أنكّل بالأرواح حتى أذيبها","فتأتي وقد سهلت دربك تسهيلا",46,"ل",2,0],["ان كل الفنون مثل فقاقيع","ببحر النفس الغريب الشئون",47,"ن",1,0],["إن كل الاغلال في يد حرّ","لا تساوي في موثق الفكر غلا",48,"ل",2,0],["إن كل الحياة عندي يوم","طرفاه ولادة وفنّاء",49,"ا",2,0],["إنَّكَ لا تسطيعُ نهضاً متى","حطَّت بأفنائكَ أثقاليه",50,"ل",3,0],["انكليزية تروق وتسبى","عاشقيها بوجنة ورديه",51,"ي",2,1],["ان كل قنبلة ترمى بذي وهج","كالشمس ان غربت حمراء تلتهب",52,"ب",1,0],["إن كلتِ النجبُ الركائبُ تارةً","فأعِدْ لَهَا ذكر الحَبيب مُكَررا",53,"ر",2,0],["ان كل الملا تروم عطاء","واجل العطا لها أن تراكا",54,"ك",2,0],["أن كل حد السيف جرد","للمنايا السود عزمه",55,"م",2,0],["إنك لله ولي في الورى","فالحكم في العالم لله ولك",56,"ك",1,0],["إن كلموه لم يجاوب سائلاً","عما جرى مع أنه مسؤول",57,"ل",1,0],["إنك لا تهدي لمن أحببتَ","أبعدت ذاك الشخصَ أو قرَّبتَ",58,"ت",1,0],["إن كلفتني السقم سود محاجر","فلقد شفتني منه بيض خدود",59,"د",1,0],["ان كل القَوم في","سكرات المَوت في زهو وَفَن",60,"ن",1,0],["إن كلّفوكَ غرامةً","فابْتَعْ لشيخ القومِ مِقوَدْ",61,"د",1,0],["إنك لو وألت إلى هشام","أمنت وكنت في حرم مقيم",62,"م",1,1],["إن كَلَّ زندٌ لن تكِلَّ إرادةٌ","والعزمُ في الأرواح لا الأجسام",63,"م",1,0],["ان كلمت لخصام كنت مقولها","وان سطت كنت حد المرهف الذرب",64,"ب",1,0],["إن كلْتني للناسِ حسبيَ أنَّهم","قد أغمضوا عيناً لِما نلقاهُ",65,"ا",2,0],["إن كلْتني ولبؤسهمْ وحياضهمْ","اإنِّي خسرْتُ البيعَ يا ربَّاهُ",65,"ا",2,0],["إنْ كلُّ أرضٍ للذي فيها سكنْ","مِن أوّلٍ، فالعُرْبُ أوّلُ مَن سكنْ",66,"ن",1,1],["إن كلمت صباً بنبل لحاظها","كان السفاء له بعذب الماء",67,"ا",2,0]]}