{"poems":[[55,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[29,"يا صاحبي هل الصباح منير","https://www.aldiwan.net/poem5778.html","الكامل"],[29,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[29,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[93,"ولقد ذكرتك بعد يأس قاتل","https://www.aldiwan.net/poem8721.html","عموديه"],[80,"أزف الصيام وزار نور النرجس","https://www.aldiwan.net/poem14052.html","الكامل"],[91,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[45,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[68,"ولقد ذكرتك حين أنكرت الظبى","https://www.aldiwan.net/poem39938.html","الكامل"],[68,"ولقد ذكرتك والجماجم وقع","https://www.aldiwan.net/poem39939.html","الكامل"],[68,"ولقد ذكرتك والعجاج كأنه","https://www.aldiwan.net/poem40094.html","الكامل"],[68,"ولقد ذكرتك والسيوف مواطر","https://www.aldiwan.net/poem40095.html","الكامل"],[68,"وقيت حادثة الليالي","https://www.aldiwan.net/poem40946.html","مجزوء الكامل"],[33,"هل عرفت اليوم من شن","https://www.aldiwan.net/poem41331.html","مجزوء الرمل"],[33,"يا ليلة قطع الصباح نعيمها","https://www.aldiwan.net/poem41334.html","الكامل"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16659","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[108,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[139,"لقياك مطلبي وغاية مقصدي","https://www.aldiwan.net/poem48912.html","الكامل"],[139,"ولقد ذكرتك والرياح عواصف","https://www.aldiwan.net/poem49073.html","الكامل"],[139,"ولقد ذكرتك والطبيب بجانبي","https://www.aldiwan.net/poem49075.html","الكامل"],[159,"ولقد ذكرتك والنجوم كأنها","https://www.aldiwan.net/poem55491.html","الكامل"],[234,"عذلوا وما عدلوا ولا نصحوا","https://www.aldiwan.net/poem51183.html","أحذ الكامل"],[242,"ولقد ذكرتك بالربى من لمطة","https://www.aldiwan.net/poem18110.html","الرمل"],[308,"ولقد ذكرتكتم بحرب ينثني","https://www.aldiwan.net/poem58212.html","الكامل"],[382,"ولقد ذكرتك يا وداعة عندما","https://www.aldiwan.net/poem59447.html","الكامل"],[409,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[409,"ولقد ذكرتك بعد أن جد النوى","https://www.aldiwan.net/poem33651.html","الكامل"],[422,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[422,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[469,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[478,"يا من به أنا مغرم","https://www.aldiwan.net/poem4119.html","مجزوء الكامل"],[556,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[567,"طال النوى حتى تقطعت المنى","https://www.aldiwan.net/poem52987.html","الكامل"],[580,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138980",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86940","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48888","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38436","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38394","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38393","الكامل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105460","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216900",""],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130873","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47408","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47438","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118102","الكامل"],[1440,"","https://poetry.dctabudhabi.ae/diwan/poem/147069","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1776,"","https://poetry.dctabudhabi.ae/diwan/poem/84765","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114771","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201718","الرمل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47201","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28491","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75987","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100257","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58277","الكامل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28860","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74077","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101238","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131971","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46018","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91146","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91695","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91172","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90045","الرمل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59455","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102927","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102982","الكامل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139439",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52146","الكامل"],[4690,"أَرْماقُ الوداد","https://www.poetsgate.com/ViewPoem.aspx?id=181350",""],[4778,"العنزة الجرباء","https://www.poetsgate.com/ViewPoem.aspx?id=190332",""],[4961,"خمس دقائق قبل وصول العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=33331",""],[4978,"تشطير ولقد ذكرتك","https://www.poetsgate.com/ViewPoem.aspx?id=178205",""],[5136,"ولقد ذكرتك والعيون شواخص","https://www.poetsgate.com/ViewPoem.aspx?id=121536",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5213,"هذا العذيب فأين سرب رئامه","https://www.poetsgate.com/ViewPoem.aspx?id=170537",""],[5660,"سَقَطَ السَريرُ تَكَسَّرَت أَضلاعُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=23782",""],[5751,"ليالي سَجاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=214792",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5790,"ولقد ذكرتك والصوارم لمع","https://www.poetsgate.com/ViewPoem.aspx?id=111909",""]],"verses":[["وَلَقَد ذَمَمتُ الناسَ قَبلَكَ كُلَّهُم","فَالآنَ طُرَّقَ لي إِلى المَحمودِ",0,"د",1,0],["وَلَقَد ذَكَرتُكِ بِاليَمامَةِ ذَكرَةً","إِنَّ المُحِبَّ لِمَن يُحِبُّ ذَكورُ",1,"ر",1,0],["وَلَقَد ذَكَرتُكِ وَالمَطِيُّ خَواضِعٌ","وَكَأَنَّهُنَّ قَطا فَلاةٍ مَجهَلِ",2,"ل",1,0],["وَلَقَد ذَكَرتُكِ وَالمَطِيُّ خَواضِعٌ","مِثلُ الجُفونِ بِبُرقَتَي أَرمامِ",3,"م",1,0],["وَلَقَد ذَكَرتُكِ بَعدَ يَأسٍ قاتِلٍ","في ضَحوَةٍ كَثُرَت بِها الأَنواءُ",4,"ا",2,1],["وَلَقَد ذَكرتُ فُرادَ عَيني قُرّةً","هول السبال وَخِزي رَبّ البُرنُسِ",5,"س",1,0],["ولقد ذل من تقا","عس واعتز من عزم",6,"م",1,0],["وَلَقَد ذَخَرتُ لِكُلِّ أَرضٍ ساعَةً","تَستَجفِلُ الضِرغامَ عَن أَشبالِهِ",7,"ل",2,0],["وَلَقَد ذَكَرتُكِ حينَ أَنكَرَتِ الظُبى","أَغمادَها وَتَعارَفَت في الهامِ",8,"م",1,1],["وَلَقَد ذَكَرتُكِ وَالجَماجِمُ وُقَّعٌ","تَحتَ السَنابِكِ وَالأَكُفِّ تَطيرُ",9,"ر",1,1],["وَلَقَد ذَكَرتُكِ وَالعَجاجُ كَأَنَّهُ","ظِلَّ الغَنِيِّ وَسوءُ عَيشِ المُعسِرِ",10,"ر",1,1],["وَلَقَد ذَكَرتُكِ وَالسُيوفُ مُواطِرٌ","كَالسُحبِ مِن وَبلِ النَجيعِ وَطَلِّهِ",11,"ه",1,1],["وَلَقَد ذَكَرتُ القُربَ مِن","كَ وَطيبَ أَيّامي الخَوالي",12,"ل",2,0],["وَلَقَد ذَكَّرَني الرَب","عُ شُؤُوناً لَن تَريما",13,"م",2,0],["وَلَقَد ذَكَرتُكِ يا بَهيَّةُ بَعدَما","ذَهَبَ الكَرى بِمُجالِسي وَنَديمي",14,"م",2,0],["ولقد ذممْتُ قصيرَ ليلي في الهوى","وحَمِدتُ من مَتْنِ القناةِ طويلا",15,"ل",2,0],["ولقد ذُعِرْتُ بما رأيْتُ فغودرَتْ","تلك المهنَّدَةُ الرِّقاقُ فُلُولا",15,"ل",2,0],["وَلَقَد ذُعَرتُ الوَحشَ يَحمِلُني","مُتَقارِبُ التَقريبِ قَد قَرِحا",16,"ح",2,0],["ولقد ذكرْتُكِ يا أمامَةُ بَعْدَما","نَزَلَ الدّليلُ إلى التّرابِ يسُوفُه",17,"ف",2,0],["ولقد ذَهَبَتْ نُعْمَى عَيْشِي","وطريفُ المالِ ومُتْلَدهُ",18,"د",2,0],["ولقد ذكرتك فادَّكَرْتُ طفولتي","وتمائمي، طوبى لمهدك طوبى!",19,"ب",2,0],["ولقد ذكرتك والخطوب دوائر","حولي كما دارَ السوار على اليدِ",20,"د",1,0],["ولقد ذكرتكَ والرياحُ عواصفٌ","والبحرُ يعلو بالسفين ويهبطُ",21,"ط",1,1],["ولقد ذكرتكِ والطبيبُ بجانبي","والحسمُ فوق فراشهِ مطروحُ",22,"ح",1,1],["وَلَقدْ ذَكَرْتُكِ وَالنُّجُومُ كَأَنَّها","دُرٌّ عَلى أَرْضٍ مِنَ الفَيْرُوزَجِ",23,"ج",1,1],["ولقد ذَعَرتُ الوحشَ يَحْمِلني","قَلقُ العِنان مُشَذَّب مَرِحُ",24,"ح",1,0],["وَلَقَدْ ذَكَرْتُكَ بِالرُّبَى مِنْ لَمْطَةٍ","وَنَسِيمُهَا يُهْدِي إِلَيَّ أَرِيجَا",25,"ج",2,1],["ولقد ذكرتكتم بحربٍ ينثني","عن بأسها الليث الهزبر الأغلب",26,"ب",1,1],["ولقد ذكرتك يا وَداعةُ عندما","شِمْتُ العدوَّ مجرِّداً سيفَ الردى",27,"د",2,1],["ولقد ذكرنا في الجواب نفائساً","وفوائداً في حلك التنزيلا",28,"ل",2,0],["ولقد ذكرتك بعد أن جدَّ النوى","والصحب بين مودع ومشيع",29,"ع",1,1],["ولقد ذكرتك والهموم","تمرُّ بي عكساً وطردا",30,"د",2,0],["ولقد ذكرت العيش وهو كأنَّما","برزت محاسنه بروض ناضر",31,"ر",1,0],["ولقد ذَعَرتُ عن الرجال سَوامَهُ","ورفعتُه عن كلِّ بيتٍ نازلِ",32,"ل",1,0],["ولقد ذكرتهمُ وأعناق الفلا","يشفقنَ من عنقٍ بها ووخيد",33,"د",1,0],["ولقد ذكرتُ زمانَنا","والشَملُ عقدٌ يُنظَم",34,"م",1,0],["ولقد ذكرتُ على تقادم عهده","عيشاً لنا بالأنْعَمين أنيقا",35,"ق",2,0],["ولقد ذكرتُكَ فاضطربتُ مهابةً","وطَرِبتُ فاشتُقَّ النُواحُ من الغِنا",36,"ن",2,0],["ولقد ذَوى غُصني ووجْدي ما ذَوى","ولقد بليتُ ضنىً وعشقي مَا بَلي",37,"ل",2,0],["ولقد ذكرتك والوفود بمكة","كل إلى الله المهيمن يرغب",38,"ب",1,0],["وَلَقد ذكرتك مرتين وَلَم أَحل","عَن ذكر مَن يُحيي هَشيم غراسي",39,"س",2,0],["ولقد ذكرتك بعد نعيك مشفقاً","ذكر المحب لأفضل الأحباب",40,"ب",1,0],["وَلَقَد ذَكَرتكِ وَالصُّفوفُ تَلاحمَت","وَتَبَارَزَ الفُرسانُ لِلفُرسانِ",41,"ن",1,1],["وَلَقَد ذَكَرتُكَ وَالصّوارمُ قَطّعَت","مِنّي الوَريدَ بِضَربِ عاتٍ ظالمِ",42,"م",1,1],["وَلَقَد ذَكَرتُكَ حينَ جُدت بِمُهجَتي","وَقَدِ اِحتَضَرت لَدى دُنوِّ وَفاتي",43,"ي",1,1],["ولقد ذكرتك والرياح لوافح","والأرض من حر الهجير تفور",44,"ر",1,0],["ولقد ذُعرتُ بناتِ عمّ","المُرشقاتِ لها بَصابِصْ",45,"ص",1,1],["ولقد ذكرت وما افاد تذكرى","حتى استفاضت بالدموع شؤوني",46,"ن",2,0],["وَلَقَدْ ذَكَرْتُكِ في السَّفينَةِ والرَّدى","مُتَوَقَّعٌ بِتَلاطُمِ الأَمْواجِ",47,"ج",1,1],["وَلَقَدْ ذَكَرْتُكِ وَالطَّبِيبُ مُعَبِّسٌ","وَالْجُرْحُ مُنْغَمِسٌ بِهِ الْمِسْبارُ",48,"ر",1,1],["ولقد ذكرت على الصراة مراميا","تنسى بحسن وجوهها الأقمارا",49,"ر",2,0],["ولقد ذعرت الوحش وهي كوانسٌ","بوثيق أوظفة اليدين إذا ارتمى",50,"م",2,1],["ولقد ذاق ولكن ما درى","مهجتي من حرّ شوقي تحترق",51,"ق",1,0],["وَلَقَد ذَكَرتُ زَمانَنا","وَالشَملُ مُجتَمِعُ الطَرائِقِ",52,"ق",1,0],["ولقد ذكرتُكَ والهُمومُ تُنوشني","سَهَراً يُذكِّرُني بوَقعِ السَّمهَرِي",53,"ر",2,0],["ولقد ذاب حشاها كمدًا","فجرى من عينها كالعندم",54,"م",1,0],["ولقد ذكرته فالسّؤالُ جوابُه","ما فيه من خلطٍ ولا إلْباسِ",55,"س",1,0],["وَلَقَد ذَكَرنَا أربَعِينَ طِرِيقَةً","قَد أبطَلَت هَذَا بِحُسنِ بَيَانِ",56,"ن",1,0],["وَلَقَد ذَكَرتُكَ في عقابِ هِرَقلَةٍ","وَجِبال نيقِيَّةٍ وَثَلجِ الحِمَّةِ",57,"ه",1,0],["وَلَقَد ذَخَرتُكَ لِلنَوائبِ عُدّةً","وَوثِقتُ مِنك بِألمَعِيٍّ أَروَعِ",58,"ع",1,1],["ولقد ذكرت من الجبال أجلها","واعزها لمنافع مشهورة",59,"ه",1,0],["ولقد ذكرتك راعياً","للعهد حين نسيت عهدا",60,"د",2,0],["وَلَقَدْ ذكرتُكَ في مواطنِ لذَّتي","مُتشَوِّقاً لجميلِ ذاكَ المنظَرِ",61,"ر",1,0],["وَلَقَد ذَكرتُكِ وَالخُصومُ يَلُفُّهُمْ","بابٌ يُقارِبُهُم عَلى الأَوتارِ",62,"ر",1,0],["وَلَقَد ذكرت وَما ذكرت سِوى الصبا","وَهَوى بريعان الصبا أَصباني",63,"ن",2,0],["ولقد ذكرتك والكتاب على يدي","متفكراً ببيانه المطبوع",64,"ع",1,1],["ولقد ذكرتك والأسود زئيرها","ملأ الفضاء وأذهل الشجعانا",65,"ن",2,1],["وَلَقَد ذَكَرتُك وَالخُطوبُ تَعِلُّني","غُبراً أصبنَ دَمَ الفُؤادِ فَسالا",66,"ل",2,0],["وَلَقد ذكرتك وَالرياح عَواصف","قَد كحّلت بالرمل عَينَ الباكي",67,"ك",2,1],["وَلَقد ذكرتُ ودادَ ناسٍ هاجرٍ","أَلِفَ النَوى وَفديتُه من هاجر",68,"ر",1,0],["وَلَقَد ذَكرتك وَالمطيّ عَلى طوى","وَمقامنا لا يَستقرّ لنا بنا",69,"ن",2,1],["ولقد ذقتُ بكاسات الهوى","عَسَلاّ طوراً وطورا علقما",70,"م",2,0],["ولقد ذكرتُ به تَبسُّم رَايةٍ","والعيشُ عذْبٌ والزَّمان مصالحُ",71,"ح",1,0],["ولقد ذكرت بذي الأراكة منزلا","نشرت جناحيها به السراء",72,"ا",2,0],["ولقد ذكرت الخيل يوم طرادها","والشمس تلتثم القتام الأكدرا",73,"ر",2,0],["ولقد ذعرت بها الظلا","مَ فبت في شمسِ وظل",74,"ل",1,0],["ولقد ذكرتك والحوادث جمَّة","والحربُ ملءُ العين والآذانِ",75,"ن",1,0],["\" ولَقدْ ذكَرْتك \" والشّجونُ طوالِعُ","ودُموعُ قَلبي كالثّقالِ هَوامِعُ",76,"ع",1,1],["ولقد ذكرتك والعواصف أقبلت","يا أمة سارت بها الغوغاء",77,"ا",2,1],["ولقد ذكرتُكَ عندَ كلِّ خليِّةٍ","والحبُّ بينَ شعاع ِ ذكرِكَ زاهرُ",78,"ر",1,0],["ولَقدْ ذكَرْتك \" والشّجونُ طوالِعُ","( وقوافل الذكرى إليّ رواجعُ)",79,"ع",1,1],["ولقد ذكرتك والعيون شواخص","بسفينة لعبت بها الأمواج",80,"ج",1,1],["ولقد ذكرت خزعبلات جمة","لفقتها في نظمك المتبدد",81,"د",1,0],["ولقد ذهبن سوالفا أيامه","فكأنها الاضغاث من أحلامه",82,"م",2,0],["وَلَقَد ذَكَرتُكَ يا قَويّاً ناعِماً","فَتَرَكتُ في صَدري فُؤاداً مُغرَما",83,"م",2,0],["وَلَقَدْ ذَكَرْتُكِ والنَّهارُ مُدَجَّجٌ","بالخائبينَ ، وكُلِّ أغْبَرَ أشْأَمِ",84,"م",1,0],["ولقد ذَوَتْ مِن قَبلِ ذاكَ ونالَها","يَبَسٌ وكانَت لاتَني تتَقَعقَعُ",85,"ع",1,0],["ولقد ذكرتك والصوارم لمع","من حولنا والسمهرية شرع",86,"ع",1,1]]}