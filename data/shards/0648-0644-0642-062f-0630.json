{"poems":[[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[27,"يا صاحبي هل الصباح منير","https://www.aldiwan.net/poem5778.html","الكامل"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[27,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[91,"ولقد ذكرتك بعد يأس قاتل","https://www.aldiwan.net/poem8721.html","عموديه"],[78,"أزف الصيام وزار نور النرجس","https://www.aldiwan.net/poem14052.html","الكامل"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[43,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[66,"ولقد ذكرتك حين أنكرت الظبى","https://www.aldiwan.net/poem39938.html","الكامل"],[66,"ولقد ذكرتك والجماجم وقع","https://www.aldiwan.net/poem39939.html","الكامل"],[66,"ولقد ذكرتك والعجاج كأنه","https://www.aldiwan.net/poem40094.html","الكامل"],[66,"ولقد ذكرتك والسيوف مواطر","https://www.aldiwan.net/poem40095.html","الكامل"],[66,"وقيت حادثة الليالي","https://www.aldiwan.net/poem40946.html","مجزوء الكامل"],[31,"هل عرفت اليوم من شن","https://www.aldiwan.net/poem41331.html","مجزوء الرمل"],[31,"يا ليلة قطع الصباح نعيمها","https://www.aldiwan.net/poem41334.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[48,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16659","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[136,"لقياك مطلبي وغاية مقصدي","https://www.aldiwan.net/poem48912.html","الكامل"],[136,"ولقد ذكرتك والرياح عواصف","https://www.aldiwan.net/poem49073.html","الكامل"],[136,"ولقد ذكرتك والطبيب بجانبي","https://www.aldiwan.net/poem49075.html","الكامل"],[156,"ولقد ذكرتك والنجوم كأنها","https://www.aldiwan.net/poem55491.html","الكامل"],[230,"عذلوا وما عدلوا ولا نصحوا","https://www.aldiwan.net/poem51183.html","أحذ الكامل"],[238,"ولقد ذكرتك بالربى من لمطة","https://www.aldiwan.net/poem18110.html","الرمل"],[304,"ولقد ذكرتكتم بحرب ينثني","https://www.aldiwan.net/poem58212.html","الكامل"],[378,"ولقد ذكرتك يا وداعة عندما","https://www.aldiwan.net/poem59447.html","الكامل"],[404,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[404,"ولقد ذكرتك بعد أن جد النوى","https://www.aldiwan.net/poem33651.html","الكامل"],[417,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[417,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[459,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[465,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[474,"يا من به أنا مغرم","https://www.aldiwan.net/poem4119.html","مجزوء الكامل"],[552,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[563,"طال النوى حتى تقطعت المنى","https://www.aldiwan.net/poem52987.html","الكامل"],[576,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"]],"verses":[["وَلَقَد ذَمَمتُ الناسَ قَبلَكَ كُلَّهُم","فَالآنَ طُرَّقَ لي إِلى المَحمودِ",0,"د",1,0],["وَلَقَد ذَكَرتُكِ بِاليَمامَةِ ذَكرَةً","إِنَّ المُحِبَّ لِمَن يُحِبُّ ذَكورُ",1,"ر",1,0],["وَلَقَد ذَكَرتُكِ وَالمَطِيُّ خَواضِعٌ","وَكَأَنَّهُنَّ قَطا فَلاةٍ مَجهَلِ",2,"ل",1,0],["وَلَقَد ذَكَرتُكِ وَالمَطِيُّ خَواضِعٌ","مِثلُ الجُفونِ بِبُرقَتَي أَرمامِ",3,"م",1,0],["وَلَقَد ذَكَرتُكِ بَعدَ يَأسٍ قاتِلٍ","في ضَحوَةٍ كَثُرَت بِها الأَنواءُ",4,"ا",2,1],["وَلَقَد ذَكرتُ فُرادَ عَيني قُرّةً","هول السبال وَخِزي رَبّ البُرنُسِ",5,"س",1,0],["ولقد ذل من تقا","عس واعتز من عزم",6,"م",1,0],["وَلَقَد ذَخَرتُ لِكُلِّ أَرضٍ ساعَةً","تَستَجفِلُ الضِرغامَ عَن أَشبالِهِ",7,"ل",2,0],["وَلَقَد ذَكَرتُكِ حينَ أَنكَرَتِ الظُبى","أَغمادَها وَتَعارَفَت في الهامِ",8,"م",1,1],["وَلَقَد ذَكَرتُكِ وَالجَماجِمُ وُقَّعٌ","تَحتَ السَنابِكِ وَالأَكُفِّ تَطيرُ",9,"ر",1,1],["وَلَقَد ذَكَرتُكِ وَالعَجاجُ كَأَنَّهُ","ظِلَّ الغَنِيِّ وَسوءُ عَيشِ المُعسِرِ",10,"ر",1,1],["وَلَقَد ذَكَرتُكِ وَالسُيوفُ مُواطِرٌ","كَالسُحبِ مِن وَبلِ النَجيعِ وَطَلِّهِ",11,"ه",1,1],["وَلَقَد ذَكَرتُ القُربَ مِن","كَ وَطيبَ أَيّامي الخَوالي",12,"ل",2,0],["وَلَقَد ذَكَّرَني الرَب","عُ شُؤُوناً لَن تَريما",13,"م",2,0],["وَلَقَد ذَكَرتُكِ يا بَهيَّةُ بَعدَما","ذَهَبَ الكَرى بِمُجالِسي وَنَديمي",14,"م",2,0],["ولقد ذممْتُ قصيرَ ليلي في الهوى","وحَمِدتُ من مَتْنِ القناةِ طويلا",15,"ل",2,0],["ولقد ذُعِرْتُ بما رأيْتُ فغودرَتْ","تلك المهنَّدَةُ الرِّقاقُ فُلُولا",15,"ل",2,0],["وَلَقَد ذُعَرتُ الوَحشَ يَحمِلُني","مُتَقارِبُ التَقريبِ قَد قَرِحا",16,"ح",2,0],["ولقد ذكرْتُكِ يا أمامَةُ بَعْدَما","نَزَلَ الدّليلُ إلى التّرابِ يسُوفُه",17,"ف",2,0],["ولقد ذَهَبَتْ نُعْمَى عَيْشِي","وطريفُ المالِ ومُتْلَدهُ",18,"د",2,0],["ولقد ذكرتك فادَّكَرْتُ طفولتي","وتمائمي، طوبى لمهدك طوبى!",19,"ب",2,0],["ولقد ذكرتك والخطوب دوائر","حولي كما دارَ السوار على اليدِ",20,"د",1,0],["ولقد ذكرتكَ والرياحُ عواصفٌ","والبحرُ يعلو بالسفين ويهبطُ",21,"ط",1,1],["ولقد ذكرتكِ والطبيبُ بجانبي","والحسمُ فوق فراشهِ مطروحُ",22,"ح",1,1],["وَلَقدْ ذَكَرْتُكِ وَالنُّجُومُ كَأَنَّها","دُرٌّ عَلى أَرْضٍ مِنَ الفَيْرُوزَجِ",23,"ج",1,1],["ولقد ذَعَرتُ الوحشَ يَحْمِلني","قَلقُ العِنان مُشَذَّب مَرِحُ",24,"ح",1,0],["وَلَقَدْ ذَكَرْتُكَ بِالرُّبَى مِنْ لَمْطَةٍ","وَنَسِيمُهَا يُهْدِي إِلَيَّ أَرِيجَا",25,"ج",2,1],["ولقد ذكرتكتم بحربٍ ينثني","عن بأسها الليث الهزبر الأغلب",26,"ب",1,1],["ولقد ذكرتك يا وَداعةُ عندما","شِمْتُ العدوَّ مجرِّداً سيفَ الردى",27,"د",2,1],["ولقد ذكرنا في الجواب نفائساً","وفوائداً في حلك التنزيلا",28,"ل",2,0],["ولقد ذكرتك بعد أن جدَّ النوى","والصحب بين مودع ومشيع",29,"ع",1,1],["ولقد ذكرتك والهموم","تمرُّ بي عكساً وطردا",30,"د",2,0],["ولقد ذكرت العيش وهو كأنَّما","برزت محاسنه بروض ناضر",31,"ر",1,0],["ولقد ذَعَرتُ عن الرجال سَوامَهُ","ورفعتُه عن كلِّ بيتٍ نازلِ",32,"ل",1,0],["ولقد ذكرتهمُ وأعناق الفلا","يشفقنَ من عنقٍ بها ووخيد",33,"د",1,0],["ولقد ذكرتُ زمانَنا","والشَملُ عقدٌ يُنظَم",34,"م",1,0],["ولقد ذكرتُ على تقادم عهده","عيشاً لنا بالأنْعَمين أنيقا",35,"ق",2,0],["ولقد ذكرتُكَ فاضطربتُ مهابةً","وطَرِبتُ فاشتُقَّ النُواحُ من الغِنا",36,"ن",2,0],["ولقد ذَوى غُصني ووجْدي ما ذَوى","ولقد بليتُ ضنىً وعشقي مَا بَلي",37,"ل",2,0]]}