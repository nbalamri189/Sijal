{"poems":[[91,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[66,"انصح صديقك مرتين","https://www.aldiwan.net/poem38563.html","مجزوء الكامل"],[52,"يا حادي الأظعان أين تريد","https://www.aldiwan.net/poem27096.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[236,"يا ابن عبد الكريم كلفتنا المش","https://www.aldiwan.net/poem31806.html","الخفيف"],[378,"يا غافلا عن نفسه","https://www.aldiwan.net/poem59302.html","مجزوء الكامل"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[465,"شم لأثيلات الحمى وضاله","https://www.aldiwan.net/poem3426.html","عموديه"],[469,"يا أبا نصر يا بديع المعاني","https://www.aldiwan.net/poem59584.html","الخفيف"]],"verses":[["لَو ظَلَّ فيما بَينَنا صامِتاً","لَم تَسمَعِ الآذانُ مَكروها",0,"ه",2,0],["لَو ظَنَّ صِدقَكَ ما عَصى","وَأَبى وَأَظهَرَ فُحشَهُ",1,"ه",1,0],["لَو ظَلَّ يَملِكُ حاتَماً أَعطاكَهُ","هِبَةً وَلَم يَرَ أَنَّ ذَلِكَ جودُ",2,"د",1,0],["لَوْ ظَنَّهُ بِالرَّأْيِ بَالِغَ أَمْرِهِ","لَمْ يَبْغِهِ بِمُقَطَّعِ الأَوْصَالِ",3,"ل",1,0],["لَو ظَفِرنا فيهِ بِمَرعىً وَريقِ","لَعَذَرناكَ أَو بَمَرأى أَنيقِ",4,"ق",1,0],["لو ظل بطرس صامتاً","لم ينتحب والليلُ حالك",5,"ك",1,0],["لو ظلَّ مني أملٌ أنشِدُه","إليك من دون الأنام لاهتدى",6,"ا",1,0],["لو ظفرتْ كفٌّ ببترٍ زهره","أثرتْ بما تجنيه من إطلاله",7,"ل",2,0],["لَو ظَفِرنا بِمَن يَكونُ نَصيرا","حاذِقاً بِالطَبيحِ لِلرُهبانِ",8,"ن",1,0]]}