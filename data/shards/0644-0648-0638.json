{"poems":[[93,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[68,"انصح صديقك مرتين","https://www.aldiwan.net/poem38563.html","مجزوء الكامل"],[54,"يا حادي الأظعان أين تريد","https://www.aldiwan.net/poem27096.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[240,"يا ابن عبد الكريم كلفتنا المش","https://www.aldiwan.net/poem31806.html","الخفيف"],[382,"يا غافلا عن نفسه","https://www.aldiwan.net/poem59302.html","مجزوء الكامل"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[469,"شم لأثيلات الحمى وضاله","https://www.aldiwan.net/poem3426.html","عموديه"],[473,"يا أبا نصر يا بديع المعاني","https://www.aldiwan.net/poem59584.html","الخفيف"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119353","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46569","الرجز"],[1664,"","https://poetry.dctabudhabi.ae/diwan/poem/123786","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35918","المجتث"],[4978,"هجمت عليه شجونه أرتالا","https://www.poetsgate.com/ViewPoem.aspx?id=177169",""],[5225,"شوف تأثيرك","https://www.poetsgate.com/ViewPoem.aspx?id=25796",""],[5956,"يا أيها البحر الذي بي استمسكا","https://www.poetsgate.com/ViewPoem.aspx?id=183258",""]],"verses":[["لَو ظَلَّ فيما بَينَنا صامِتاً","لَم تَسمَعِ الآذانُ مَكروها",0,"ه",2,0],["لَو ظَنَّ صِدقَكَ ما عَصى","وَأَبى وَأَظهَرَ فُحشَهُ",1,"ه",1,0],["لَو ظَلَّ يَملِكُ حاتَماً أَعطاكَهُ","هِبَةً وَلَم يَرَ أَنَّ ذَلِكَ جودُ",2,"د",1,0],["لَوْ ظَنَّهُ بِالرَّأْيِ بَالِغَ أَمْرِهِ","لَمْ يَبْغِهِ بِمُقَطَّعِ الأَوْصَالِ",3,"ل",1,0],["لَو ظَفِرنا فيهِ بِمَرعىً وَريقِ","لَعَذَرناكَ أَو بَمَرأى أَنيقِ",4,"ق",1,0],["لو ظل بطرس صامتاً","لم ينتحب والليلُ حالك",5,"ك",1,0],["لو ظلَّ مني أملٌ أنشِدُه","إليك من دون الأنام لاهتدى",6,"ا",1,0],["لو ظفرتْ كفٌّ ببترٍ زهره","أثرتْ بما تجنيه من إطلاله",7,"ل",2,0],["لَو ظَفِرنا بِمَن يَكونُ نَصيرا","حاذِقاً بِالطَبيحِ لِلرُهبانِ",8,"ن",1,0],["لو ظل أعوج في المضي يرومه","لكبا بمهمه همه لما هميى",9,"م",3,0],["لَو ظَل كُل شاعر","وَناظم وَناثر",10,"ر",1,0],["لو ظِلُّ أنفاسٍ لرِقَّةِ خدِّه","يبدو لناظِره على مرآتِهِ",11,"ه",1,0],["لو ظَهَرَ الموتُ بها لم يَنَل","ترى بها الواضحَ كالمُشْتَكلِ",12,"ل",1,0],["لَو ظِلتَ في كُلِّ يَومٍ","مُصَلِّياً أَلفَ رَكعَه",13,"ع",2,0],["لو ظلّ في عمُري لوصلك ساعةٌ","خصّصتها فلتطمئنّي بالا",14,"ل",2,0],["لو ظمّيه حدّها حرّ الوهيج","توّها ع مورد المسقى دنوق",15,"ق",1,0],["لو ظل لونك أزرقا متكاملا‎","لعدلتُ عن رأيي وتبْتُ لِربِّكا‎",16,"ك",2,0]]}