{"poems":[[88,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[95,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[76,"أما واعتزاز السيف والضيف والندى","https://www.aldiwan.net/poem12964.html","الطويل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[445,"بشير يوم بملك دهر","https://www.aldiwan.net/poem34907.html","مخلع البسيط"],[466,"سألت إلهي أن يعيش بغبطة","https://www.aldiwan.net/poem16424.html","الطويل"],[505,"رعى الزمان فرأى العجائبا","https://www.aldiwan.net/poem37663.html","الرجز"],[505,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77616","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48945","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137066",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205021","الخفيف"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126057","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103037","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119618","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119655","الوافر"],[4953,"شوق إلىٰ بيوت الله!!","https://www.poetsgate.com/ViewPoem.aspx?id=214066",""],[5129,"خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=125752",""],[5145,"ويح المعالي فقد شالت نعامتها","https://www.poetsgate.com/ViewPoem.aspx?id=108050",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""],[5690,"أن تعظم الأهوال حزمك أعظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=172183",""],[402,"لذكراك يا حفني في النفس أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=36492",""],[5943,"يابنتَ خيرِ النَّاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=11256",""],[6102,"هي .. هي","https://www.poetsgate.com/ViewPoem.aspx?id=185304",""]],"verses":[["فَحَفِظتُم وَشَكَرتُم صُنعَنا","وَبَنو الرومانِ أَولى مَن شَكَر",0,"ر",1,0],["فَحِفْنِيُّ كَانَ الكاتِبَ الأَوْحَدَ الَّذِي","خَلَتْ قَبْلَ أَنْ تَحْظَى بِهِ مِصْرُ أَزْمَانُ",1,"ن",1,0],["فَحِفْنِيُّ مِنْطِيقُ المَعَارِفِ وَالنُّهَى","هُنَاكَ وَصَوتٌ لِلكِنَانَةِ رَنَّانُ",1,"ن",1,0],["فَحَفَّت بِها ريحٌ بَليلٌٍ وَرَبوَةٌ","بِمَسرى غَمامٍ جادَها مُتَبَجِّسِ",2,"س",1,0],["فحفَّها بالخيْلِ والرُّماةِ","وجُملةِ الحُماةِ والكُماةِ",3,"ه",1,0],["فَحُفَّ بدرُ السماءِ منه","بِأَنْجُمٍ للسعود زُهْرِ",4,"ر",1,0],["فحِفْظُ العُلى والمَأثُراتِ بحِفْظِهِ","يُصَرِّفُها ما بينَ حَزْمٍ ونائلِ",5,"ل",1,0],["فحفظ الناس على علاتهم","وما رأى سوى الحفيظ صاحبا",6,"ب",2,0],["فحَفَفْتُهُ منِّي بنفحَةِ جدِّهِ","وطَوَيْتُ فيه عُذَيْبَ أَشرفِ منهَلِ",7,"ل",1,0],["فحفظت منه شواردا ونوادرا","عن كل مملكة وعن سواس",8,"س",1,0],["فَحفظ الغلام حَتّى اِشتدا","وَبَلغ الإِدراك وَالأَشُدّا",9,"د",2,0],["فَحَفَروا الحَمام تَحتَ رجله","فَوَجَدوا ما قَد بَغى لأَجله",10,"ه",1,0],["فحفرتُ حتى شام طرفي زهرةً","ذبلت بُعيدَ الثلج والإعصار",11,"ر",1,0],["فحف الى تخفيف بلواه راحماص","بعزم به افعالك الغر تشهد",12,"د",1,0],["فحفيف الغصون شاب خرير ال","ماء لحنا فألفا جوقتين",13,"ن",1,0],["فحفظا اله العرش مع خير عودة","الى معهد ما زال مرعى الأوائل",14,"ل",1,0],["فحفرت قبرك ثم قلت دفنته","ونفضت كفى من ثرى المقبور",15,"ر",1,0],["فحفتك البشائر منه حتى","أضاءت من أشعتها البوادي",16,"د",2,0],["فَحَفَّ بِهِ البَفلَغونُ ذَووهُ","وَبَينَ أَكُفِّهِم رَفَعوهُ",17,"ه",1,0],["فحفت عيسي ومن بعد الحفا","لم تجد بالربع غير الدمن",18,"ن",1,0],["فحفوا به والشهب منه تزايدت","وحاصوا عليه ساعةً فَتَسَوَّروا",19,"ر",3,0],["فحفظي عهدهم طبعي كما قد","جعلتُ ولاء عبد الله ديني",20,"ن",2,0],["فَحِفظُ النَّفسِ أَعظمُ عِندي رَبّي","مِن المِحْرَابِ، أَوْ لَمسِ الصِّحابِ",21,"ب",1,0],["فَحفيفُ آمالٍ قَطفْتِ ثِمارَها","إذْ صاغَ للدُّنيا قَصائِدَ منْ جَمالْ",22,"ل",1,0],["فحفّها من أعاديها دجىً فهوت","والشمس تهوى إذا آبت دياجيها",23,"ي",3,0],["فحفظناه في الصدور ففز","نا ورتلنا آياته ترتيلا",24,"ل",2,0],["فحفظت شأن الدولة العليا التي","هي شأنها الشرف الرفيع الأعظمُ",25,"م",1,0],["فحفني منطيق المعارف والنهى","هناك وصوت للكنانة رنا",26,"ن",2,0],["فحفظتِ من هدي النبوةِ منهجاً","يبقى لنا شرعاً لكلِ أوانِ",27,"ن",1,0],["فَحَفَفنَنا ؛ وَالتَّوقُ يَدفَعُنِي إِلَى","تَقبِيلِها ؛ وَالعَقلُ يَردَعُ ناهِيا",28,"ه",3,0]]}