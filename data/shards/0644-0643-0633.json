{"poems":[[53,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[87,"هالة للهلال فيها اعتصام","https://www.aldiwan.net/poem62829.html","الخفيف"],[51,"أفنيت عمرك باغترارك","https://www.aldiwan.net/poem62119.html","مجزوء الكامل"],[77,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54265","الكامل"],[108,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[230,"لكسرة من رغيف خبز","https://www.aldiwan.net/poem55141.html","مخلع البسيط"],[275,"يا من تلطخ بالمداد ولاثا","https://www.aldiwan.net/poem35069.html","الكامل"],[287,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[357,"الحبيب الشرود","https://www.aldiwan.net/poem950.html",""],[358,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[366,"سيدي بالذي اصطفاك وحيدا","https://www.aldiwan.net/poem68134.html","الخفيف"],[408,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[466,"نعمت صباحا ما تغنت حمامة","https://www.aldiwan.net/poem16155.html","الطويل"],[469,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[519,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[567,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62498","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119999","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96654","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96663","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6770","الخفيف"],[1509,"","https://poetry.dctabudhabi.ae/diwan/poem/73900","الخفيف"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11169","الكامل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199631","المسحوب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93642","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75989","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200092",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86269","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66558","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86505","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133278","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95372","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[357,"الحبيب الشرود","https://www.poetsgate.com/ViewPoem.aspx?id=6325",""],[5038,"أسحار الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=195420",""],[5102,"عين العيون","https://www.poetsgate.com/ViewPoem.aspx?id=14098",""],[5121,"رُبّان","https://www.poetsgate.com/ViewPoem.aspx?id=215582",""],[5190,"عزلة","https://www.poetsgate.com/ViewPoem.aspx?id=153691",""],[5225,"بك هلا","https://www.poetsgate.com/ViewPoem.aspx?id=27615",""],[5302,"يا عجولا","https://www.poetsgate.com/ViewPoem.aspx?id=201222",""],[5409,"فقد الناس فيك ثبتاً إماماً","https://www.poetsgate.com/ViewPoem.aspx?id=155481",""],[5431,"لك سحنة الخنزير حين تباغتُ","https://www.poetsgate.com/ViewPoem.aspx?id=194352",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5480,"صوغ الألماس","https://www.poetsgate.com/ViewPoem.aspx?id=29629",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[5582,"أَسْيانُ نارُ غَرامِهِ تَتَسَعَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187103",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5596,"عودة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=205675",""],[5739,"الشريط ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127064",""],[5861,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190610",""]],"verses":[["لك سلطانٌ عزيزٌ فإذا","أنت لم تعفُ عن الجاني وَهَن",0,"ن",1,0],["لَكَ سَيفٌ إِلى اليَتامى بَغيضٌ","وَحَنانٌ يُحِبُّهِ الأَيتامُ",1,"م",1,0],["لَكَ ساعَةٌ تَأتيكَ مِن","ساعاتِ لَيلِكَ أَو نَهارِك",2,"ك",1,0],["لكسْرتُ دُمْلُجَها بضيق عناقِها","ورشفتُ من فيها البَرودِ رُضابا",3,"ب",2,0],["لَكَ ساحَةٌ عَلَوِيَّةٌ","ما أَمَّها أَمَلٌ وَخاب",4,"ب",1,0],["لَكَ سِيرَةٌ كَصَحِيفَةِ الأَ","بْرَارِ طَاهِرَةٌ نَقِيَّهْ",5,"ي",2,0],["لك سيرةٌ يتلو الشبابُ فصولَها","كالآي من «ياسينَ»، و«الأحقاف»",6,"ف",1,0],["لَكِسرةٌ من رَغيفِ خُبزٍ","تُؤدمُ بالمِلح وَالكرامَه",7,"ه",1,1],["لكسرتُ أقلامي ودستُ صحائفي","حنقاً وطلَّقتُ الدواةَ ثلاثا",8,"ث",2,0],["لَكَ ساقٍ حَزمٌ وَشاديكَ عَزمٌ","وَالتُقى وَالكِتابُ فيك نَديمُ",9,"م",1,0],["لك سيرت وفودي","أملا ان ترافا",10,"ف",2,0],["لِكسب المَجد ما مَلَكت يَداه","أَفاد كَأَنَّما يَقضي ديونا",11,"ن",2,0],["لكَ سنّ يُحكي اللالي اِنتِظاما","غَير أَن النِظام لغرك أَسبك",12,"ك",1,0],["لِكَسْب العُلَى فاجْعَلْ هُمومَك تُحْمَدِ","وتَجْنِ ثمار الشكرِ من روضِها النَّدي",13,"د",2,1],["لكسر بني الحاجاتِ بالجود جابرٌ","وللجحفل الجرَّار بالكَيْس كاسر",14,"ر",1,0],["لكسوتها حبر السماح فاخجلت","كفاك ما صنعت يدا صنعائها",15,"ا",3,0],["لِكَسْبِ الثّنا خُضْتَ الحُتوفَ وإنّما","يخوضُ عُبابَ البحرِ مَنْ يطلُب الدُّرّا",16,"ر",2,0],["لكَ سِرٌّ مقيَّدٌ وثناءٌ","سائرٌ في جَوانبِ الأرضِ مُطلَقْ",17,"ق",1,0],["لَك سَيفٌ يومَ الكُماةِ ويومَ ال","كَوم في شَفرَتَيهِ يَومٌ عَصيبُ",18,"ب",1,0],["لك سيئاتٌ يا زمان كَفَرْتَها","بمُعقِّباتٍ في الجميل صوالحِ",19,"ح",1,0],["لك سيرة محمودة الأثر","وعلى ثراها بالفخار ثري",20,"ر",2,1],["لَك ساعدٌ زانَ السوادَ بحسنهِ","فكأنّما هو للسوار سوارُ",21,"ر",1,0],["لكَ سيرةٌ لم نظر أملاك الورى","إلّا وأنتَ بها أجلّ وأكبرُ",22,"ر",1,0],["لَكَساني بِمَجدِهِ ثَوبَ فَخرٍ","طالَ حَتّى جَرَرتُهُ مِن وَرائي",23,"ا",2,0],["لَكَ سَمعٌ وَناظِرٌ","وَفُؤادٌ فَقُلتُ لا",24,"ل",2,0],["لَكَسَوتُ عُقبَةَ كِسوَةً مَشهورَةً","تَرِدُ المَناهِلَ مَن كَلامٍ عائِرِ",25,"ر",1,0],["لك سلامي وحبي والصفا والأدب","صنت فيهم ودادي وفاح مسك الختام",26,"م",1,0],["لَكَ سرفرقان إذعت مَصونه","وَيَطيب سر العلم حين يذاع",27,"ع",1,0],["لكَسَوتَني بُردَ الفَخارِ مُفَوَّفاً","أَضحَت بِهِ صَنعاءُ غَيرَ صَناعِ",28,"ع",1,0],["لك سكْر لا ينتهي أبداً","وانتهى الخمر وانتهى الجام",29,"م",1,0],["لِكسب الثَنا يَشتاقُ مِنهُ فُؤادُهُ","فَدَوماً لِقَصاد يحنُّ حَنينا",30,"ن",2,0],["لَكَ سِيْرَةٌ مَعَ عَدْلِها","بَأْسٌ فَمَنْ كِسْرَى وَقَيْصَرْ",31,"ر",1,0],["لك سطوةٌ مرهوبة","تغني عن الجيش اللهام",32,"م",1,0],["لك ساحة عنت الملوك ببابها","وسموا بزورتها على الأطواد",33,"د",1,0],["لك سطوة الليث الغضو","ب ورحمة البر الرؤوف",34,"ف",1,0],["لكسرِ كل يتيمٍ","إسعافُ بركَ جبرُ",35,"ر",1,0],["لك سلم التطبيق إذ رقيته","أومى إلى الابعاد أن تتناهى",36,"ا",3,0],["لك سيرت وفودي....أملا ان ترافا","لا تشمت بي حسودي.....عد لدربي منصفا",37,"ف",2,0],["لَكَ سَيِّدي هذي الْعِبادُ تَلَهَّفَتْ","مِنْها الْجِباهُ تَعَفَّرَتْ إِجْلالا",38,"ل",2,0],["لك سيدي أهدوا زهور ربيعهمْ","أنت الربيع والروضة الفيحاءُ",39,"ا",2,0],["لَكَ سِحْرٌ إِذَا ارتمَىَ بِحُرُوفٍ","سَلَّطَ الضّوْءَ صَارِخاً بِالحَوايَا",40,"ا",3,0],["لَكَ سِفرُ ، وقَهوَةٌ ، ويَرَاعٌ","يَرسُمُ اللَّحنَ كَيفَ شِئتَ قَصِيدَا",41,"د",2,0],["لك سلامي عدّ ما غنّا","عاشقٍ واضنا به البينا",42,"ن",2,0],["لك سعي لكنه حاد شيئا","عن طريق واغتال جهدا وفنا",43,"ن",2,0],["لك سفر تركته كهلالٍ","كان لولا القضاء بدراً تماما",44,"م",2,0],["لك سحنة الخنزير حين تباغتُ","وعلى خطاك مزابلٌ تتهافتُ",45,"ت",1,1],["لك سيقت غمائم الله تترى","لك هلّت سماؤه بالدعاء",46,"ا",2,0],["لك سيدي قدر ٍموثّق على ساس","ما ناله الناصي عظيم العمادي",47,"د",2,0],["لكَ سِحْرٌ يفوقُ ما لوُرودٍ","وَ جمَالٌ تَغارُ منْهُ النُّجومُ",48,"م",1,0],["لَكَ سِيرَةٌ لَمْ تُطْرَ أَمْلاكُ الوَرَى","إِلاَّ وَأَنْتَ بِها أَجَلُّ وَأَكْبَرُ",49,"ر",1,0],["لَكِ ساعِدٌ زانَ السِّوارَ بِحُسْنِهِ","فَكَأَنَّما هوَ لِلسِّوارِ سِوارُ",50,"ر",1,0],["لك سيفان بين حُكمٍ وحِلمٍ",". واقتدارٌ في خنجرٍ من وُثوب",51,"ب",1,0],["لك سؤال ٍ يركض ايام وشهور.","كيف قلبك مايحس ولا يحيط.؟",52,"ط",1,0],["لكَ سحرُ عينٍ في الفؤادِ يقيمُ","سكنُ الهوى في القلبِ وهو نديمُ",53,"م",1,1]]}