{"poems":[[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[85,"هالة للهلال فيها اعتصام","https://www.aldiwan.net/poem62829.html","الخفيف"],[49,"أفنيت عمرك باغترارك","https://www.aldiwan.net/poem62119.html","مجزوء الكامل"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54265","الكامل"],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[226,"لكسرة من رغيف خبز","https://www.aldiwan.net/poem55141.html","مخلع البسيط"],[271,"يا من تلطخ بالمداد ولاثا","https://www.aldiwan.net/poem35069.html","الكامل"],[283,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[353,"الحبيب الشرود","https://www.aldiwan.net/poem950.html",""],[354,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[362,"سيدي بالذي اصطفاك وحيدا","https://www.aldiwan.net/poem68134.html","الخفيف"],[403,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[462,"نعمت صباحا ما تغنت حمامة","https://www.aldiwan.net/poem16155.html","الطويل"],[465,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[515,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[563,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"]],"verses":[["لك سلطانٌ عزيزٌ فإذا","أنت لم تعفُ عن الجاني وَهَن",0,"ن",1,0],["لَكَ سَيفٌ إِلى اليَتامى بَغيضٌ","وَحَنانٌ يُحِبُّهِ الأَيتامُ",1,"م",1,0],["لَكَ ساعَةٌ تَأتيكَ مِن","ساعاتِ لَيلِكَ أَو نَهارِك",2,"ك",1,0],["لكسْرتُ دُمْلُجَها بضيق عناقِها","ورشفتُ من فيها البَرودِ رُضابا",3,"ب",2,0],["لَكَ ساحَةٌ عَلَوِيَّةٌ","ما أَمَّها أَمَلٌ وَخاب",4,"ب",1,0],["لَكَ سِيرَةٌ كَصَحِيفَةِ الأَ","بْرَارِ طَاهِرَةٌ نَقِيَّهْ",5,"ي",2,0],["لك سيرةٌ يتلو الشبابُ فصولَها","كالآي من «ياسينَ»، و«الأحقاف»",6,"ف",1,0],["لَكِسرةٌ من رَغيفِ خُبزٍ","تُؤدمُ بالمِلح وَالكرامَه",7,"ه",1,1],["لكسرتُ أقلامي ودستُ صحائفي","حنقاً وطلَّقتُ الدواةَ ثلاثا",8,"ث",2,0],["لَكَ ساقٍ حَزمٌ وَشاديكَ عَزمٌ","وَالتُقى وَالكِتابُ فيك نَديمُ",9,"م",1,0],["لك سيرت وفودي","أملا ان ترافا",10,"ف",2,0],["لِكسب المَجد ما مَلَكت يَداه","أَفاد كَأَنَّما يَقضي ديونا",11,"ن",2,0],["لكَ سنّ يُحكي اللالي اِنتِظاما","غَير أَن النِظام لغرك أَسبك",12,"ك",1,0],["لِكَسْب العُلَى فاجْعَلْ هُمومَك تُحْمَدِ","وتَجْنِ ثمار الشكرِ من روضِها النَّدي",13,"د",2,1],["لكسر بني الحاجاتِ بالجود جابرٌ","وللجحفل الجرَّار بالكَيْس كاسر",14,"ر",1,0],["لكسوتها حبر السماح فاخجلت","كفاك ما صنعت يدا صنعائها",15,"ا",3,0],["لِكَسْبِ الثّنا خُضْتَ الحُتوفَ وإنّما","يخوضُ عُبابَ البحرِ مَنْ يطلُب الدُّرّا",16,"ر",2,0],["لكَ سِرٌّ مقيَّدٌ وثناءٌ","سائرٌ في جَوانبِ الأرضِ مُطلَقْ",17,"ق",1,0]]}