لى لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[416,"متى لاح رسم الدار من طلل قفر","https://www.aldiwan.net/poem54144.html","الطويل"],[429,"بروحي من أجفانها قد فتنني","https://www.aldiwan.net/poem40093.html","الطويل"],[429,"للصيد فضل لدى أهل العلى ظهرا","https://www.aldiwan.net/poem40507.html","البسيط"],[429,"أخا الانس هل أبصرت صبا مولعا","https://www.aldiwan.net/poem41392.html","الطويل"],[432,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[439,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[441,"عظمت فلا شيء سواك عظيم","https://www.aldiwan.net/poem14293.html","الطويل"],[453,"وسائلة هل تقرض الشعر فطر","https://www.aldiwan.net/poem61792.html","الطويل"],[458,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[458,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[458,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[461,"أظل مريضا بالصدى دون وردكم","https://www.aldiwan.net/poem15923.html","الطويل"],[461,"تقيل نوشروان بعد ذهابه","https://www.aldiwan.net/poem16034.html","الطويل"],[464,"أرى الغيث في الآفاق خرقاء كفه","https://www.aldiwan.net/poem3347.html","عموديه"],[464,"أمالك ودي وهو ملك مخيس","https://www.aldiwan.net/poem3367.html","عموديه"],[493,"صفحت لهذا الدهر عن سيئاته","https://www.aldiwan.net/poem67407.html","الطويل"],[500,"ولما دعينا والدجا في غلالة","https://www.aldiwan.net/poem37936.html","الطويل"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[515,"ولما دنا عالي ركابك هزني","https://www.aldiwan.net/poem12152.html","الطويل"],[515,"فؤاد بجمر الشوق والوجد يحرق","https://www.aldiwan.net/poem12190.html","الطويل"],[515,"ألا قل لعز الدين لا زال جده","https://www.aldiwan.net/poem12206.html","الطويل"],[529,"يا علم لم أطلبك للنكر","https://www.aldiwan.net/poem37405.html","السريع"],[538,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[551,"عمدت إلي فآيستني","https://www.aldiwan.net/poem47697.html","المتقارب"],[551,"لدارك من قلبي كقلبي كرامة","https://www.aldiwan.net/poem47768.html","الطويل"],[551,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[551,"حملتم كما شئتم على الهوى","https://www.aldiwan.net/poem48044.html","الطويل"],[551,"وفي النفر الغادين وجه أحبه","https://www.aldiwan.net/poem48095.html","الطويل"],[551,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[567,"أبى الدهر إلا فعالا خسيسا","https://www.aldiwan.net/poem69635.html","المتقارب"],[575,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"]],"verses":[["وَلَم أَدنُ مِن وُدٍّ وَقَد غاضَ وِدُّهُ","وَلَكِنَّني داوَيتُهُ بِبِعادِيا",0,"ي",2,0],["وَلَم أَدرِ ما جَمعٌ وَما جَمرَتا مِنىً","وَلَم أَلقَ في اللاقينَ حَيّاً يَمانِيا",1,"ي",2,0],["وَلَم أَدرِ أَنَّ الدَهرَ يَخفِضُ أَهلَهُ","إِذا سَكَنَت فيهِم نُفوسُ الضَراغِمِ",2,"م",1,0],["ولَم أدْرِ مَنْ أدنى إِلى الغَدْرِ صاحِبي","أمِ الدّهْرُ أم مَهْضومَةُ الكَشْحِ مِكْسالُ",3,"ل",1,0],["وَلَمَّا دَعَا بالْبَدْرِ شُقَّ لِحِينهِ","وَأَقْبَلَ مِنْهُ الشِّقُّ يَهْوِي إِلَى الْكُمِّ",4,"م",1,0],["ولمّا دَعا بالجِذْعِ أقبَلَ خاضِعاً","إلَيْهِ وشقّ البدْرَ واسْتَنْطَقَ الصّلْدا",5,"د",2,0],["ولَمّا دَعانِي داعِي الهَوى","وأخْلَفَ ما كُنْتُ أمّلْتُهُ",6,"ه",1,1],["وَلَم أَدرِ أَنَّ الأَرمَنِيَّةَ ظِئرُهُ","وَفي الأَرمَنِيّاتِ النَجاسَةُ وَالبُخلُ",7,"ل",1,0],["وَلَم أَدرِ أَنَّ الوَصلَ مِنك خلابَةٌ","كَجاري سَرابٍ رَقرَقَتهُ الصَحاصِحُ",8,"ح",1,0],["وَلَمْ أَدْرِ ذَنْباً إِلَيْكَ اقْتَرَفْتُهُ","فَقُلْ يَا فَدَتْكَ النَّفْسُ مَاذَا جَرَى مِنِّي",9,"ي",1,0],["ولما دعوتَ الناس نحو صنيعه","أجابوا لهم من جانب الغور داعيا",10,"ي",2,0],["ولم أدرِ لما استبهمت اخرياته","أ أطمع أم أستشعر اليأس مضطرّاً",11,"ر",2,0],["وَلَمّا دَعَوتَ العَنبَرِيَّ بِبَلدَةٍ","إِلى غَيرِ ماءِ لا قَريبٍ وَلا أَهلِ",12,"ل",1,0],["وَلَم أَدرِ أَنَّ الدَهرَ في عَدَدِ العِدى","وَأَنَّ المَنايا السودَ يَرمَينَ عَن يَدِ",13,"د",1,0],["ولم أدرِ هل تسطو عليَّ لحاظها","بسود جفونٍ أم ببيض نصال",14,"ل",1,0],["ولما دعاني للمثوبة سيّدٌ","يرى المدح عاراً قبل بَذْل المثَاوبِ",15,"ب",1,0],["ولم أدعْ في كلّ ما زانها","فلسفةً إلا تفلسفْتُها",16,"ت",3,0],["ولما دموع العين راجعة","ما عشت وصلاً فات مرجعه",17,"ع",2,0],["ولمَا دَهَتْنِي دون عيني عينُها","لكنَّ غِبَّ النظرتيْن وخيم",18,"م",1,0],["وَلَمّا دَرَت أَنّي مُحِبٌّ مُتَيَّمٌ","بَكَت وَبَكاني كُلُّ ضاحِكٍ مُفتَرِ",19,"ر",1,0],["وَلَم أَدرِ مَن أَلقَ عَلَيهِ رِداءَهُ","سِوى أَنَّهُ قَد سُلَّ عَن ماجِد محضِ",20,"ض",1,1],["وَلَمّا دَبَّرَ الدُنيا اِستَعاضَت","جَوانِبُها الصَلاحَ مِنَ الفَسادِ",21,"د",1,0],["وَلَمّا دَعا الداعونَ وَاِنشَقَّتِ العَصا","وَلَم تَخبُ نيرانُ العَدُوِّ المُقاذِفِ",22,"ف",1,1],["وَلَمّا دَنا رَأسُ الَّتي كُنتُ خائِفاً","وَكُنتُ أَرى فيها لِقاءَ لِزامِ",23,"م",1,1],["وَلَمّا دَعا الداعونَ أَينَ اِبنُ غالِبٍ","لِصَدعِ ثَأىً يُخشى لَهُم مُتَفاقِمُه",24,"م",2,0],["وَلَمّا دَعَوتُ اِبنَ المَراغَةِ لِلَّتي","رَهَنتُ لَها اِبنَي أَيُّنا لِلعَظائِمِ",25,"م",1,0],["وَلَمّا دَعاني وَهوَ يَرسُفُ لَم أَكُن","بَطيئاً عَنِ الداعي وَلا مُتَوانِيا",26,"ي",2,0],["وَلَم أَدرِ أَنَّكَ مِن قَبلِها","تُحِبُّ السِياطَ بِأَثمارِها",27,"ر",3,0],["وَلَمّا دَعاني البَينُ وَلَّيتُ إِذ دَعا","وَلَمّا دَعاها طاوَعَتهُ وَلَبَّتِ",28,"ت",1,0],["وَلَم أَدرِ مانَبكي أَرَسمَ شَبيبَةٍ","عَفا أَم مَصيَفاً مِن سُلَيمى وَمَربَعا",29,"ع",2,0],["وَلَم أَدرِ ما أَشجى وَأَدعى إِلى الهَوى","أَخَفقَهُ بَرقٍ أَم غِناءُ حَمامِ",30,"م",1,0],["وَلَمّا دَخَلتُ الحَيَّ خَلَّفتُ موقِدي","بِسِلسِلَةٍ أَسعى أَجُرُّ رِدائِيا",31,"ي",2,0],["ولَم أدرِ أنَّ الجُود صبُّ بِآمِلٍ","وأنَّ النَّدى فِيمَن يُرجِّيهِ هَائِمُ",32,"م",1,0],["وَلَم أدرِ أنَّ الشَّمسَ قَبلَكَ صُورَةٌ","لشَخصٍ وَلاَ أنَّ النُّجُومَ شَمَائِلُ",33,"ل",1,0],["وَلَم أَدرِ أَنَّ البانِ يُغرَسُ في النَقا","وَلا أَنَّ شَمساً في الظَلامِ تَطوفُ",34,"ف",1,0],["وَلَمّا دَفَنّا جِسمَهُ في تُرابِهِ","جَعَلتُ صَميمَ القَلبِ مِنّي لَهُ قَبرا",35,"ر",2,1],["ولم أدْرِ إذ بَثّتْ حنيناً مُرَتَّلاً","أشَدْوٌ على غُصْنِ الأراكةِ أم سَجْع",36,"ع",1,0],["وَلَمّا دَعَونا بِاسمِهِ طارَ ذُعرُهُ","وَأَيقَنَ أَنَّ الرَحلَ مِنهُ خَصيبُ",37,"ب",1,0],["وَلَم أَدرِ مَن هُم غَيرَ ماشَهِدَت بِهِ","بِشَرقَيِّ ساباطَ الدِيارُ البَسابِسُ",38,"س",1,0],["وَلَم أَدَع زينَةً حَتّى لَبِستُ لَها","مِنَ الجَديدِ لِكَي أُلمِم بِهِنَّ غَدا",39,"د",2,0],["ولمّا دالَتِ العَرَبُ اغْتِصَاباً","وأضْحَتْ جُلُّ طاعتِها دِهانُ",40,"ن",1,0],["وَلَمّا دَخَلنا تَحتَ فَيءِ رِماحِهِم","خَبَطتُ بِكَفّي أَطلُبُ الأَرضَ بِاللَمسِ",41,"س",1,0],["وَلَم أَدرِ أني راحل لمحلة","بها الفضل مجذوم الذراعين أقطع",42,"ع",1,0],["ولما دنس يوماً هيكلي","ولما جشمني أثقاله",43,"ه",1,0],["وَلَمّا دَهاني الدَهرُ وَاِبني وَأُمّه","بِحَربَينِ بِكرٍ مرَّةٍ وَعَوانِ",44,"ن",1,0],["وَلَم أَدرِ كَيفَ الصَبرُ حينَ تَقَلَّصَت","لَهُ شَفَتانِ طالَما شَفَتاني",44,"ن",2,0],["ولما دعت مصرُ، اشرأبَت قبابُهُ","وكادَت مغانيه تصيخُ إلى الندا",45,"د",2,0],["ولمّا دنا الحيّ ضجّت (سعاد)","أضاع (حسين) الخروف الأغر",46,"ر",1,0],["ولم أدرِ مِن طيبِ إغفائها","على الذُّلِّ ، أيَّ خيالٍ تَرى",47,"ا",1,0],["ولم أدرِ كيفَ يكونُ الزعيمُ","إذا لم يكنْ لاصقاً بالثرى",47,"ا",1,0],["ولم أدرهِها عِظَةً مُرَّةً","بأني متى أحَترِسْ أُغلَب",48,"ب",1,0],["ولمْ أدرِ أنَّ الدهرَ في عددِ العدا","º وأنَّ المنايا السودَ يرمينَ عنْ يدِ",49,"د",1,0],["ولمّا درت أنّي محبّ متيّم","بكت وبكائي كلّ ضاحك مفتر",50,"ر",1,0],["ولم ادر ما يبدو بشأني وما الذي","يكون اذا وافى الركائب في غد",51,"د",1,0],["ولما دنا منه الحمام ورنقت","منيته نادى الصفي المصافيا",52,"ي",2,0],["وَلَم أَدرِ مَن أَلقى عَلَيهِ رِدائَهُ","عَلى أَنَّهُ قَد سُلَّ عَن ماجِدٍ مَحضِ",53,"ض",1,1],["ولما دهى من سحرِ فرعونَ ما دهى","أتيحت عصا موسى له وهي ثعبانُ",54,"ن",1,0],["ولما دَحَت قُود الهضاب وراءَها","ورنّحها طولُ القيادِ لها سُكرا",55,"ر",2,0],["وَلَمّا دَعَت مِنكَ العَواصِمُ غَوثَها","أَجَبتَ بِلاداً قَد تَمادى بِها الجَهدُ",56,"د",1,0],["وَلَمّا دَجا لَيلُ الشُجونِ وَعَسَعسا","وَلَم أَرَ للإِصباحِ فيهِ تَنَفُّسا",57,"س",2,0],["ولم ادر ما لاقيت من كل معجبٍ","ولو قلت ادري كنتُ والله أكذبُ",58,"ب",1,0],["ولم أدر أَن اللحظ تفري سهامه","وجلدة من تفريه ملساً كما هيا",59,"ي",2,0],["ولمّا دَعا الهادي لإعرازِ دينهِ","أَتى عُمَرٌ يَسعى لِحَضرته حضرا",60,"ر",2,0],["وَلَم أدَّخر كَنزاً سواكِ وإنّما","جَعلتُ ثَباتي في محبّتكِ الذخرا",60,"ر",2,0],["ولم أدر أن القوم من عظم بخلهم","أعدوا لوجهي ألسنا من مبارد",61,"د",1,0],["ولما دحا الأرض اقتدارا وحكمة","على الماء أرسى الشم في أثر الدحو",62,"و",1,0],["ولما دنا منه سراقةُ طالباً","على فرس كادت له الأرض تبلع",63,"ع",1,0],["ولما دعا بالصحو أقلع غيها","وأجفل أجفال النعام المفذد",64,"ذ",2,0],["وَلَم أَدرِ ما الأَحزانُ حَتّى بَعدتم","فَقَلبِيَ مَوقوفٌ عَلى حَسَراتِهِ",65,"ت",2,0],["وَلَم أَدرِ قَبلَ البَينِ أَنَّ مِنَ الهَوى","قُدوداً وَمِن بيضِ الصَوارِمِ أَحداقا",66,"ق",2,0],["ولما دعا داعي النفير أجبنه","كتائب في أبطالها تتكتب",67,"ب",1,0],["ولما درى بالأمر عض بنانه","كما غص قبلُ الخائن المتذبذب",67,"ب",1,0],["ولم أدّعي أني أنبتُ وأنَّني","لأَسعَد خلقِ اللَه إن صحَّت الدَّعوى",68,"و",2,0],["ولم أدن أذني للأغاني ولا لغنى","يقرب مني الغانيات الكواعبا",69,"ب",2,0],["وَلَم ادر ما اثنىعليها لانها","كلؤلؤة الغوّاص يجمع حسنها",70,"ه",2,0],["وَلَمْ أَدْرِ فِي هَصْرِي لِميَّادِ قَدِّها","أَرُمَّانَةً فِي النَّحْرِ أَقْطِفُ أَمْ ثَدْيَا",71,"ي",2,0],["وَلَمّا دَعَتْهُ عَنْ دِمَشْقَ عَزِيمَةٌ","أَبى أَنْ يُخِلَّ الْبَدْرُ فِيها بِقُطْبِهِ",72,"ب",2,0],["وَلَمْ أَدْرِ أَنَّ مَرامِي الْقَضا","ءِ قَدْ حُلْنَ بَيْنِي وبَيْنَ الْمَرامِ",73,"م",1,0],["ولما دنوا نودوا هنياً وأقبلوا","إلى الركن من كل الفجاج أدراجا",74,"ج",2,0],["وَلَمّا دَعى داعي النَوى بِفِراقِنا","كَأَنّي إِلى شُربِ الحمامِ دُعيتُ",75,"ت",1,0],["وَلَمّا دَنت منّي حللتُ لها الحُبى","وَبادرتُ إِعظاماً لها بقيامِ",76,"م",1,0],["وَلَم أَدرِ ما أَهداه لي حسنُ سجعها","أَرنَّةَ شادٍ أَم هديلَ حَمامِ",76,"م",1,0],["ولم أدن يوما مع من دنا","للثم المحيا وشرب المدام",77,"م",1,0],["وَلَم أدرِ منهم كلّ شهمٍ مُنطّق","أَرَجماً ثَنى عضب الحراسةِ أَم سقطا",78,"ط",2,0],["وَلَمّا دَعاها مِن أَباطِحِ واسِطٍ","دَوائِرُ لَم تُضرَب عَلَيها الجَرامِزُ",79,"ز",1,0],["وَلَمْ أَدْرِ إلا عِندَ أَخذِيَ مَضْجَعي","وَقَد سَدَّ لَيلي دُونَ أَبوابِكَ السُّبْلا",80,"ل",2,1],["وَلَم أَدخُل الحَمّامَ سَاعَةَ بَينِهِم","طلابَ نَعِيمٍ قَد رَضِيتُ بِيُوسِي",81,"ي",1,1],["ولم أدْعُ للجُلَّى أخاً فأجابَني","ولم أرضَ خِلاًّ للوِدادِ فأرْضاني",82,"ي",1,0],["وَلَمّا دُعيتَ لِدينِ الهُدى","نِظاماً عُنِيَت بِهِ فَاِنتَظَم",83,"م",1,0],["ولم أدَّخرْ للدّهرِ غَيركَ صاحِباً","ويُرجَعُ عند الاِفتقارِ إلى الذُّخر",84,"ر",1,0],["ولمّا دَنتْ والسِتْرُ مُرخىً ودونَها","غَيارَى غدَتْ تَغْلِي صدورُهُم حِقدا",85,"د",2,0],["وَلَم أَدرِ لِلبَلور يَنسب جيدُهُ","أَم الياسَمين الغَض أَم زَهر سَوسان",86,"ن",1,0],["ولم أدرِ إذ زمَّتُ ركائب بينِكُمْ","وقد خانني في ذلك الموقف الصّبرُ",87,"ر",1,0],["ولم أدْرِ لمّا رَنا طرفُه","عدوٌ رمَى أم حبيبٌ رمق",88,"ق",1,0],["ولم أدبِّجْ ذا ولم أسجع","ولم أعدد قول كل مبدع",89,"ع",1,0],["ولما دخلنا في رياض نظامها","رأينا الذي قد كان للعجز يفرض",90,"ض",1,0],["ولم أدْرِ كيفَ طريقُ النّجاةِ","ومِنْ أينَ يُقصَدُ بابُ الأمانِ",91,"ن",1,0],["ولم أدَّخِر للدَّهرِ إن نابَ أو نَبا","وللخَطبِ إلاّ صارِمي وسِناني",92,"ي",1,0],["ولم أدر حين ذكرت الألى","دموعاً أرقتَ لها أمْ نجيعا",93,"ع",2,0],["ولم أدرِ يوم الجزع في ذلك الحمى","فَقَدْنَ حَبيباً أم فقدن قلوبا",94,"ب",2,0],["ولم أدْنُ من أشياء ممَّا تَشينُني","ولو قُطِّعَتْ منِّي لذلك أوصال",95,"ل",1,0],["ولما دعاك الأصلُ يوماً لفرعه","وَرَدْتَ فما أبقيتَ للناس موردا",96,"د",2,0],["ولم أدرِ ما هاجَ الحمامَ بنَوْحه","فهيَّجَ أشجان الفؤاد ولا يدري",97,"ر",2,0],["ولما دهاها حبها أن تزورني","بلا موعدٍ زارت وقالت سحرتني",98,"ن",2,0],["ولم أدع حبها السامي وصحبتها","فزد غراماً بها واستجل طلعتها",99,"ه",2,0],["ولما دعاني البين صبرا أجبته","ولبيته لما دعاني تطوّعا",100,"ع",2,0],["ولمَّا دعَا داعِي النَّوى حَمِّلُوا غَدًا","رفعتُ بصَوْتِي لاتَ حينَ أَوانِ",101,"ن",1,0],["ولم أدَّخِرْ من راحَتَيْكَ وسائلاً","رضيتُ بِهَا كُفءاً عن المالِ والأَهْلِ",102,"ل",1,0],["ولم أدر هذا الشهر ودع بالرضا","وما راح عني فهو لي فخصيم",103,"م",1,0],["ولم أدّخره للسموّ بأمتي","وآصرتي بل للسمو بإيماني",104,"ي",1,0],["ولم أدرِ أن الموتَ فيه مُراصدي","يقرِّفُ ما آسو ويهدِمُ ما أبني",105,"ي",1,0],["ولم أدر أن الله أخّر آيةً","له بك في إظهار معجزها سرُّ",106,"ر",1,0],["ولم أدرِ والشكُّ يَنفِي اليَقينَ","إلى أيِّ شِقَّيْ طريقي أصيرُ",107,"ر",1,0],["ولم أدرِ أنَّ القربَ عينٌ حفيظةٌ","عليّ ولا أن الوصالَ رقيبُ",108,"ب",1,0],["ولما دنتْ داري اليكم تعرَّضتْ","موانعُ قَرْبي عندها عُدَواءُ",109,"ا",2,0],["ولم أدْرِ أنَّ الموتَ اِثْرَ محمدٍ","يُساوقُ أعْناقَ الصَّبا والجنائبِ",110,"ب",1,0],["ولما دنا التوديع حلَّ عيابه","وأسعفَ فعل الظَّاعن المتودّد",111,"د",1,0],["ولَّما دعتني للوداع نوازعٌ","من الشوق أنَّ الشوق تدعو نوزعه",112,"ع",2,0],["ولما دجا الليل استعاد سنا الضحى","براح نأت بالليل عن ظلماته",113,"ت",2,0],["ولمَّا دُعينا والدُّجا في غَلالَةٍ","إلى الحضْرَةِ البيضاءِ من واسِطِ الشَّرْقِ",114,"ق",1,1],["ولم أدْرِ قبلَ الحبِّ أن يبعثَ القضا","إليّ المنايا الحُمرَ وهي خُدودُ",115,"د",1,0],["ولما دنا عالي ركابك هزني","إليك اشتياق ضاع في جنبه صبري",116,"ر",2,1],["ولم أدر لما زار طيفك في الكرى","أغار علينا أم أغار التفرق",117,"ق",1,0],["ولم أدر هل بين السطور شمائل","بعثت بها أم بينهن شمول",118,"ل",1,0],["ولَمْ أُدَنَسْ مِنْكَ عِرْضاً بما","يُؤْخَذُ في نَشْرِكَ منْ أجرْ",119,"ر",1,0],["ولما دَرَى ما لم يَكن له دارياً","وأيقنَ يومَ الرَّوعِ أنَّهُمُ هُمُ",120,"م",1,0],["ولم أدرِ أنّك ممّا يضرّ","إِذا لم تكنْ لِيَ ممّن نَفَعْ",121,"ع",1,0],["وَلَم أَدرِ ما في يومنا غيرَ أنّنا","قُطِعْنا بقَطْرٍ لا يدوم عن القَطْرِ",122,"ر",1,0],["ولمّا دعوتَ القولَ منِّي سمعته","وكان لمنْ يبغيه نَسْراً وفَرقدا",123,"د",2,0],["وَلمَّا دَخَلتمْ بِالهَوى في جَوانِحي","بِما جَنَت العَينان لانَ لَكُم صعبي",124,"ي",1,0],["وَلمّا دَعاني للغرامِ أَجبتُه","وَما كانَ قَلبي للغرامِ يجيبُ",125,"ب",1,0],["ولَمّا دُوينا بِفَقدِ الإمامِ","عَجِلتَ إلينا فكنت الدَّوا",126,"ا",1,0],["وَلَمْ أَدِرِ الكَأسَ في فِتْيَةٍ","نُبَاكِرُهَا قَهْوَةً خَنْدَرِيْسَا",127,"س",2,0],["ولم أُدْمِ ذَاكَ الخدَّ باللحظ إِنَّما","عَمِلْتُ خَلُوقاً حين أَبْصَرْتُ عَسْجداً",128,"د",2,0]]}