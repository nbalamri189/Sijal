tps://www.poetsgate.com/ViewPoem.aspx?id=131029",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[5338,"أرى أدمعي منها السحائب تستجدي","https://www.poetsgate.com/ViewPoem.aspx?id=187912",""],[5376,"كلٌّ يغني على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188474",""],[5582,"أَخُنْسَ مَهاً أَمْ أَنْجُمٌ وَدَرارِ","https://www.poetsgate.com/ViewPoem.aspx?id=187012",""],[5582,"أَغِزْلانَ رِيمٍ فِي الهَوادِجِ أَمْ دُمَى","https://www.poetsgate.com/ViewPoem.aspx?id=63578",""],[1680,"أيا نفحة الألطاف من لطف ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=108882",""],[5689,"ترى أنت تهوي غير نفسك في ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=143396",""],[5725,"لك ياحلوتي في القلب ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=192578",""],[402,"حببت نساء ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=36134",""],[5809,"رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=205283",""],[5906,"رسول وآل","https://www.poetsgate.com/ViewPoem.aspx?id=188071",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[6142,"جاءنا بالشريعة السهلة الس","https://www.poetsgate.com/ViewPoem.aspx?id=155701",""],[6185,"قصة الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86941&r=&rc=1",""],[6248,"تراتيل العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86018&r=&rc=4",""],[572,"أَبى الدَّهرُ إِلاَّ فعالاً خسيسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9344&r=&rc=201",""]],"verses":[["وَلَم أَدنُ مِن وُدٍّ وَقَد غاضَ وِدُّهُ","وَلَكِنَّني داوَيتُهُ بِبِعادِيا",0,"ي",2,0],["وَلَم أَدرِ ما جَمعٌ وَما جَمرَتا مِنىً","وَلَم أَلقَ في اللاقينَ حَيّاً يَمانِيا",1,"ي",2,0],["وَلَم أَدرِ أَنَّ الدَهرَ يَخفِضُ أَهلَهُ","إِذا سَكَنَت فيهِم نُفوسُ الضَراغِمِ",2,"م",1,0],["ولَم أدْرِ مَنْ أدنى إِلى الغَدْرِ صاحِبي","أمِ الدّهْرُ أم مَهْضومَةُ الكَشْحِ مِكْسالُ",3,"ل",1,0],["وَلَمَّا دَعَا بالْبَدْرِ شُقَّ لِحِينهِ","وَأَقْبَلَ مِنْهُ الشِّقُّ يَهْوِي إِلَى الْكُمِّ",4,"م",1,0],["ولمّا دَعا بالجِذْعِ أقبَلَ خاضِعاً","إلَيْهِ وشقّ البدْرَ واسْتَنْطَقَ الصّلْدا",5,"د",2,0],["ولَمّا دَعانِي داعِي الهَوى","وأخْلَفَ ما كُنْتُ أمّلْتُهُ",6,"ه",1,1],["وَلَم أَدرِ أَنَّ الأَرمَنِيَّةَ ظِئرُهُ","وَفي الأَرمَنِيّاتِ النَجاسَةُ وَالبُخلُ",7,"ل",1,0],["وَلَم أَدرِ أَنَّ الوَصلَ مِنك خلابَةٌ","كَجاري سَرابٍ رَقرَقَتهُ الصَحاصِحُ",8,"ح",1,0],["وَلَمْ أَدْرِ ذَنْباً إِلَيْكَ اقْتَرَفْتُهُ","فَقُلْ يَا فَدَتْكَ النَّفْسُ مَاذَا جَرَى مِنِّي",9,"ي",1,0],["ولما دعوتَ الناس نحو صنيعه","أجابوا لهم من جانب الغور داعيا",10,"ي",2,0],["ولم أدرِ لما استبهمت اخرياته","أ أطمع أم أستشعر اليأس مضطرّاً",11,"ر",2,0],["وَلَمّا دَعَوتَ العَنبَرِيَّ بِبَلدَةٍ","إِلى غَيرِ ماءِ لا قَريبٍ وَلا أَهلِ",12,"ل",1,0],["وَلَم أَدرِ أَنَّ الدَهرَ في عَدَدِ العِدى","وَأَنَّ المَنايا السودَ يَرمَينَ عَن يَدِ",13,"د",1,0],["ولم أدرِ هل تسطو عليَّ لحاظها","بسود جفونٍ أم ببيض نصال",14,"ل",1,0],["ولما دعاني للمثوبة سيّدٌ","يرى المدح عاراً قبل بَذْل المثَاوبِ",15,"ب",1,0],["ولم أدعْ في كلّ ما زانها","فلسفةً إلا تفلسفْتُها",16,"ت",3,0],["ولما دموع العين راجعة","ما عشت وصلاً فات مرجعه",17,"ع",2,0],["ولمَا دَهَتْنِي دون عيني عينُها","لكنَّ غِبَّ النظرتيْن وخيم",18,"م",1,0],["وَلَمّا دَرَت أَنّي مُحِبٌّ مُتَيَّمٌ","بَكَت وَبَكاني كُلُّ ضاحِكٍ مُفتَرِ",19,"ر",1,0],["وَلَم أَدرِ مَن أَلقَ عَلَيهِ رِداءَهُ","سِوى أَنَّهُ قَد سُلَّ عَن ماجِد محضِ",20,"ض",1,1],["وَلَمّا دَبَّرَ الدُنيا اِستَعاضَت","جَوانِبُها الصَلاحَ مِنَ الفَسادِ",21,"د",1,0],["وَلَمّا دَعا الداعونَ وَاِنشَقَّتِ العَصا","وَلَم تَخبُ نيرانُ العَدُوِّ المُقاذِفِ",22,"ف",1,1],["وَلَمّا دَنا رَأسُ الَّتي كُنتُ خائِفاً","وَكُنتُ أَرى فيها لِقاءَ لِزامِ",23,"م",1,1],["وَلَمّا دَعا الداعونَ أَينَ اِبنُ غالِبٍ","لِصَدعِ ثَأىً يُخشى لَهُم مُتَفاقِمُه",24,"م",2,0],["وَلَمّا دَعَوتُ اِبنَ المَراغَةِ لِلَّتي","رَهَنتُ لَها اِبنَي أَيُّنا لِلعَظائِمِ",25,"م",1,0],["وَلَمّا دَعاني وَهوَ يَرسُفُ لَم أَكُن","بَطيئاً عَنِ الداعي وَلا مُتَوانِيا",26,"ي",2,0],["وَلَم أَدرِ أَنَّكَ مِن قَبلِها","تُحِبُّ السِياطَ بِأَثمارِها",27,"ر",3,0],["وَلَمّا دَعاني البَينُ وَلَّيتُ إِذ دَعا","وَلَمّا دَعاها طاوَعَتهُ وَلَبَّتِ",28,"ت",1,0],["وَلَم أَدرِ مانَبكي أَرَسمَ شَبيبَةٍ","عَفا أَم مَصيَفاً مِن سُلَيمى وَمَربَعا",29,"ع",2,0],["وَلَم أَدرِ ما أَشجى وَأَدعى إِلى الهَوى","أَخَفقَهُ بَرقٍ أَم غِناءُ حَمامِ",30,"م",1,0],["وَلَمّا دَخَلتُ الحَيَّ خَلَّفتُ موقِدي","بِسِلسِلَةٍ أَسعى أَجُرُّ رِدائِيا",31,"ي",2,0],["ولَم أدرِ أنَّ الجُود صبُّ بِآمِلٍ","وأنَّ النَّدى فِيمَن يُرجِّيهِ هَائِمُ",32,"م",1,0],["وَلَم أدرِ أنَّ الشَّمسَ قَبلَكَ صُورَةٌ","لشَخصٍ وَلاَ أنَّ النُّجُومَ شَمَائِلُ",33,"ل",1,0],["وَلَم أَدرِ أَنَّ البانِ يُغرَسُ في النَقا","وَلا أَنَّ شَمساً في الظَلامِ تَطوفُ",34,"ف",1,0],["وَلَمّا دَفَنّا جِسمَهُ في تُرابِهِ","جَعَلتُ صَميمَ القَلبِ مِنّي لَهُ قَبرا",35,"ر",2,1],["ولم أدْرِ إذ بَثّتْ حنيناً مُرَتَّلاً","أشَدْوٌ على غُصْنِ الأراكةِ أم سَجْع",36,"ع",1,0],["وَلَمّا دَعَونا بِاسمِهِ طارَ ذُعرُهُ","وَأَيقَنَ أَنَّ الرَحلَ مِنهُ خَصيبُ",37,"ب",1,0],["وَلَم أَدرِ مَن هُم غَيرَ ماشَهِدَت بِهِ","بِشَرقَيِّ ساباطَ الدِيارُ البَسابِسُ",38,"س",1,0],["وَلَم أَدَع زينَةً حَتّى لَبِستُ لَها","مِنَ الجَديدِ لِكَي أُلمِم بِهِنَّ غَدا",39,"د",2,0],["ولمّا دالَتِ العَرَبُ اغْتِصَاباً","وأضْحَتْ جُلُّ طاعتِها دِهانُ",40,"ن",1,0],["وَلَمّا دَخَلنا تَحتَ فَيءِ رِماحِهِم","خَبَطتُ بِكَفّي أَطلُبُ الأَرضَ بِاللَمسِ",41,"س",1,0],["وَلَم أَدرِ أني راحل لمحلة","بها الفضل مجذوم الذراعين أقطع",42,"ع",1,0],["ولما دنس يوماً هيكلي","ولما جشمني أثقاله",43,"ه",1,0],["وَلَمّا دَهاني الدَهرُ وَاِبني وَأُمّه","بِحَربَينِ بِكرٍ مرَّةٍ وَعَوانِ",44,"ن",1,0],["وَلَم أَدرِ كَيفَ الصَبرُ حينَ تَقَلَّصَت","لَهُ شَفَتانِ طالَما شَفَتاني",44,"ن",2,0],["ولما دعت مصرُ، اشرأبَت قبابُهُ","وكادَت مغانيه تصيخُ إلى الندا",45,"د",2,0],["ولما دعاك الله لبيت أمره","فأصبحت جار الله والجار يكرم",46,"م",1,0],["ولمّا دنا الحيّ ضجّت (سعاد)","أضاع (حسين) الخروف الأغر",47,"ر",1,0],["ولم أدرِ مِن طيبِ إغفائها","على الذُّلِّ ، أيَّ خيالٍ تَرى",48,"ا",1,0],["ولم أدرِ كيفَ يكونُ الزعيمُ","إذا لم يكنْ لاصقاً بالثرى",48,"ا",1,0],["ولم أدرهِها عِظَةً مُرَّةً","بأني متى أحَترِسْ أُغلَب",49,"ب",1,0],["ولمْ أدرِ أنَّ الدهرَ في عددِ العدا","º وأنَّ المنايا السودَ يرمينَ عنْ يدِ",50,"د",1,0],["ولمّا درت أنّي محبّ متيّم","بكت وبكائي كلّ ضاحك مفتر",51,"ر",1,0],["ولم ادر ما يبدو بشأني وما الذي","يكون اذا وافى الركائب في غد",52,"د",1,0],["ولما دنا منه الحمام ورنقت","منيته نادى الصفي المصافيا",53,"ي",2,0],["وَلَم أَدرِ مَن أَلقى عَلَيهِ رِدائَهُ","عَلى أَنَّهُ قَد سُلَّ عَن ماجِدٍ مَحضِ",54,"ض",1,1],["ولما دهى من سحرِ فرعونَ ما دهى","أتيحت عصا موسى له وهي ثعبانُ",55,"ن",1,0],["ولما دَحَت قُود الهضاب وراءَها","ورنّحها طولُ القيادِ لها سُكرا",56,"ر",2,0],["وَلَمّا دَعَت مِنكَ العَواصِمُ غَوثَها","أَجَبتَ بِلاداً قَد تَمادى بِها الجَهدُ",57,"د",1,0],["وَلَمّا دَجا لَيلُ الشُجونِ وَعَسَعسا","وَلَم أَرَ للإِصباحِ فيهِ تَنَفُّسا",58,"س",2,0],["ولم ادر ما لاقيت من كل معجبٍ","ولو قلت ادري كنتُ والله أكذبُ",59,"ب",1,0],["ولم أدر أَن اللحظ تفري سهامه","وجلدة من تفريه ملساً كما هيا",60,"ي",2,0],["ولمّا دَعا الهادي لإعرازِ دينهِ","أَتى عُمَرٌ يَسعى لِحَضرته حضرا",61,"ر",2,0],["وَلَم أدَّخر كَنزاً سواكِ وإنّما","جَعلتُ ثَباتي في محبّتكِ الذخرا",61,"ر",2,0],["ولم أدر أن القوم من عظم بخلهم","أعدوا لوجهي ألسنا من مبارد",62,"د",1,0],["ولما دحا الأرض اقتدارا وحكمة","على الماء أرسى الشم في أثر الدحو",63,"و",1,0],["ولما دنا منه سراقةُ طالباً","على فرس كادت له الأرض تبلع",64,"ع",1,0],["ولما دعا بالصحو أقلع غيها","وأجفل أجفال النعام المفذد",65,"ذ",2,0],["وَلَم أَدرِ ما الأَحزانُ حَتّى بَعدتم","فَقَلبِيَ مَوقوفٌ عَلى حَسَراتِهِ",66,"ت",2,0],["وَلَم أَدرِ قَبلَ البَينِ أَنَّ مِنَ الهَوى","قُدوداً وَمِن بيضِ الصَوارِمِ أَحداقا",67,"ق",2,0],["ولما دعا داعي النفير أجبنه","كتائب في أبطالها تتكتب",68,"ب",1,0],["ولما درى بالأمر عض بنانه","كما غص قبلُ الخائن المتذبذب",68,"ب",1,0],["ولم أدّعي أني أنبتُ وأنَّني","لأَسعَد خلقِ اللَه إن صحَّت الدَّعوى",69,"و",2,0],["ولم أدن أذني للأغاني ولا لغنى","يقرب مني الغانيات الكواعبا",70,"ب",2,0],["وَلَم ادر ما اثنىعليها لانها","كلؤلؤة الغوّاص يجمع حسنها",71,"ه",2,0],["وَلَمْ أَدْرِ فِي هَصْرِي لِميَّادِ قَدِّها","أَرُمَّانَةً فِي النَّحْرِ أَقْطِفُ أَمْ ثَدْيَا",72,"ي",2,0],["وَلَمّا دَعَتْهُ عَنْ دِمَشْقَ عَزِيمَةٌ","أَبى أَنْ يُخِلَّ الْبَدْرُ فِيها بِقُطْبِهِ",73,"ب",2,0],["وَلَمْ أَدْرِ أَنَّ مَرامِي الْقَضا","ءِ قَدْ حُلْنَ بَيْنِي وبَيْنَ الْمَرامِ",74,"م",1,0],["ولما دنوا نودوا هنياً وأقبلوا","إلى الركن من كل الفجاج أدراجا",75,"ج",2,0],["وَلَمّا دَعى داعي النَوى بِفِراقِنا","كَأَنّي إِلى شُربِ الحمامِ دُعيتُ",76,"ت",1,0],["وَلَمّا دَنت منّي حللتُ لها الحُبى","وَبادرتُ إِعظاماً لها بقيامِ",77,"م",1,0],["وَلَم أَدرِ ما أَهداه لي حسنُ سجعها","أَرنَّةَ شادٍ أَم هديلَ حَمامِ",77,"م",1,0],["ولم أدن يوما مع من دنا","للثم المحيا وشرب المدام",78,"م",1,0],["وَلَم أدرِ منهم كلّ شهمٍ مُنطّق","أَرَجماً ثَنى عضب الحراسةِ أَم سقطا",79,"ط",2,0],["وَلَمّا دَعاها مِن أَباطِحِ واسِطٍ","دَوائِرُ لَم تُضرَب عَلَيها الجَرامِزُ",80,"ز",1,0],["وَلَمْ أَدْرِ إلا عِندَ أَخذِيَ مَضْجَعي","وَقَد سَدَّ لَيلي دُونَ أَبوابِكَ السُّبْلا",81,"ل",2,1],["وَلَم أَدخُل الحَمّامَ سَاعَةَ بَينِهِم","طلابَ نَعِيمٍ قَد رَضِيتُ بِيُوسِي",82,"ي",1,1],["ولم أدْعُ للجُلَّى أخاً فأجابَني","ولم أرضَ خِلاًّ للوِدادِ فأرْضاني",83,"ن",2,0],["وَلَمّا دُعيتَ لِدينِ الهُدى","نِظاماً عُنِيَت بِهِ فَاِنتَظَم",84,"م",1,0],["ولم أدَّخرْ للدّهرِ غَيركَ صاحِباً","ويُرجَعُ عند الاِفتقارِ إلى الذُّخر",85,"ر",1,0],["ولمّا دَنتْ والسِتْرُ مُرخىً ودونَها","غَيارَى غدَتْ تَغْلِي صدورُهُم حِقدا",86,"د",2,0],["وَلَم أَدرِ لِلبَلور يَنسب جيدُهُ","أَم الياسَمين الغَض أَم زَهر سَوسان",87,"ن",1,0],["ولم أدرِ إذ زمَّتُ ركائب بينِكُمْ","وقد خانني في ذلك الموقف الصّبرُ",88,"ر",1,0],["ولم أدْرِ لمّا رَنا طرفُه","عدوٌ رمَى أم حبيبٌ رمق",89,"ق",1,0],["ولم أدبِّجْ ذا ولم أسجع","ولم أعدد قول كل مبدع",90,"ع",1,0],["ولما دخلنا في رياض نظامها","رأينا الذي قد كان للعجز يفرض",91,"ض",1,0],["ولم أدْرِ كيفَ طريقُ النّجاةِ","ومِنْ أينَ يُقصَدُ بابُ الأمانِ",92,"ن",1,0],["ولم أدَّخِر للدَّهرِ إن نابَ أو نَبا","وللخَطبِ إلاّ صارِمي وسِناني",93,"ن",2,0],["ولم أدر حين ذكرت الألى","دموعاً أرقتَ لها أمْ نجيعا",94,"ع",2,0],["ولم أدرِ يوم الجزع في ذلك الحمى","فَقَدْنَ حَبيباً أم فقدن قلوبا",95,"ب",2,0],["ولم أدْنُ من أشياء ممَّا تَشينُني","ولو قُطِّعَتْ منِّي لذلك أوصال",96,"ل",1,0],["ولما دعاك الأصلُ يوماً لفرعه","وَرَدْتَ فما أبقيتَ للناس موردا",97,"د",2,0],["ولم أدرِ ما هاجَ الحمامَ بنَوْحه","فهيَّجَ أشجان الفؤاد ولا يدري",98,"ر",2,0],["ولما دهاها حبها أن تزورني","بلا موعدٍ زارت وقالت سحرتني",99,"ن",2,0],["ولم أدع حبها السامي وصحبتها","فزد غراماً بها واستجل طلعتها",100,"ه",2,0],["ولما دعاني البين صبرا أجبته","ولبيته لما دعاني تطوّعا",101,"ع",2,0],["ولمَّا دعَا داعِي النَّوى حَمِّلُوا غَدًا","رفعتُ بصَوْتِي لاتَ حينَ أَوانِ",102,"ن",1,0],["ولم أدَّخِرْ من راحَتَيْكَ وسائلاً","رضيتُ بِهَا كُفءاً عن المالِ والأَهْلِ",103,"ل",1,0],["ولم أدر هذا الشهر ودع بالرضا","وما راح عني فهو لي فخصيم",104,"م",1,0],["ولم أدّخره للسموّ بأمتي","وآصرتي بل للسمو بإيماني",105,"ن",2,0],["ولم أدرِ أن الموتَ فيه مُراصدي","يقرِّفُ ما آسو ويهدِمُ ما أبني",106,"ن",2,0],["ولم أدر أن الله أخّر آيةً","له بك في إظهار معجزها سرُّ",107,"ر",1,0],["ولم أدرِ والشكُّ يَنفِي اليَقينَ","إلى أيِّ شِقَّيْ طريقي أصيرُ",108,"ر",1,0],["ولم أدرِ أنَّ القربَ عينٌ حفيظةٌ","عليّ ولا أن الوصالَ رقيبُ",109,"ب",1,0],["ولما دنتْ داري اليكم تعرَّضتْ","موانعُ قَرْبي عندها عُدَواءُ",110,"ا",2,0],["ولم أدْرِ أنَّ الموتَ اِثْرَ محمدٍ","يُساوقُ أعْناقَ الصَّبا والجنائبِ",111,"ب",1,0],["ولما دنا التوديع حلَّ عيابه","وأسعفَ فعل الظَّاعن المتودّد",112,"د",1,0],["ولَّما دعتني للوداع نوازعٌ","من الشوق أنَّ الشوق تدعو نوزعه",113,"ع",2,0],["ولما دجا الليل استعاد سنا الضحى","براح نأت بالليل عن ظلماته",114,"ت",2,0],["ولمَّا دُعينا والدُّجا في غَلالَةٍ","إلى الحضْرَةِ البيضاءِ من واسِطِ الشَّرْقِ",115,"ق",1,1],["ولم أدْرِ قبلَ الحبِّ أن يبعثَ القضا","إليّ المنايا الحُمرَ وهي خُدودُ",116,"د",1,0],["ولما دنا عالي ركابك هزني","إليك اشتياق ضاع في جنبه صبري",117,"ر",2,1],["ولم أدر لما زار طيفك في الكرى","أغار علينا أم أغار التفرق",118,"ق",1,0],["ولم أدر هل بين السطور شمائل","بعثت بها أم بينهن شمول",119,"ل",1,0],["ولَمْ أُدَنَسْ مِنْكَ عِرْضاً بما","يُؤْخَذُ في نَشْرِكَ منْ أجرْ",120,"ر",1,0],["ولما دَرَى ما لم يَكن له دارياً","وأيقنَ يومَ الرَّوعِ أنَّهُمُ هُمُ",121,"م",1,0],["ولم أدرِ أنّك ممّا يضرّ","إِذا لم تكنْ لِيَ ممّن نَفَعْ",122,"ع",1,0],["وَلَم أَدرِ ما في يومنا غيرَ أنّنا","قُطِعْنا بقَطْرٍ لا يدوم عن القَطْرِ",123,"ر",1,0],["ولمّا دعوتَ القولَ منِّي سمعته","وكان لمنْ يبغيه نَسْراً وفَرقدا",124,"د",2,0],["وَلمَّا دَخَلتمْ بِالهَوى في جَوانِحي","بِما جَنَت العَينان لانَ لَكُم صعبي",125,"ب",2,0],["وَلمّا دَعاني للغرامِ أَجبتُه","وَما كانَ قَلبي للغرامِ يجيبُ",126,"ب",1,0],["ولَمّا دُوينا بِفَقدِ الإمامِ","عَجِلتَ إلينا فكنت الدَّوا",127,"ا",1,0],["وَلَمْ أَدِرِ الكَأسَ في فِتْيَةٍ","نُبَاكِرُهَا قَهْوَةً خَنْدَرِيْسَا",128,"س",2,0],["ولم أُدْمِ ذَاكَ الخدَّ باللحظ إِنَّما","عَمِلْتُ خَلُوقاً حين أَبْصَرْتُ عَسْجداً",129,"د",2,0],["وَلَم أَدرِ أَنَّ الصَبرَ تَفَنّى دُروعُهُ","إِذا أَن قَضى وَالعَزمُ تَفري مَغافِرُه",130,"ر",2,0],["ولما دنا الرحمن في رفع حجبه","له حشر الأشهاد في عين غيبه",131,"ه",1,0],["وَلَم أَدرِ يوم الطعن في كل فارس","قناتك أَم طير الردى فيك أَطمع",132,"ع",1,0],["وَلَم أَدرِ ما حالَ الَّذين تَركتهم","بِبَيت خليّ لَيسَ فيهِ ذَخائر",133,"ر",1,0],["وَلَم أَدَع لَحظةً تَمضي بِلا تَعبٍ","يَعود بِالنَفع لِلأَوطان مِن قِبَلي",134,"ل",2,0],["ولمَّا دعا الشيطانُ في الخيلِ حزبَهُ","وأقبل حزبُ الله فوق خيوله",135,"ل",2,0],["ولما دنوا من قبره خير بقعةٍ","بها لحد البدرَ المتممَ لاحدُ",136,"د",1,0],["ولمَا دفعتُ الى صحابةِ معشَرٍ","سيانِ فضلٌ عندَهُم وفُضلوُ",137,"ل",2,0],["ولم ادع الا النجيب المجيب","ولم أدع الا الأعز الأغرا",138,"ر",2,0],["وَلَم أَدرِ مِن قَبل الهَوى كَسر جَفنِهِ","غَدا عامِلاً في جفنِ عَيني لِلفَتحِ",139,"ح",1,0],["وَلَم أَدُم أَن مَرَّ بي كِتابُ","في يَد شَيخٍ صَدَّهُ الشَبابُ",140,"ب",1,0],["وَلَمّا دَوّخ المَولى النَصارى","وَأَلبَسَهُم مِن الذُلّ الثِيابا",141,"ب",2,0],["وَلما دَهى أَهلَ المَكارِم وَالعلا","وَرَماهم من سالف بقرار",142,"ر",1,0],["ولما دعاه اللضه للخلد أرخوا","على محاذي ف النعيم محمدا",143,"د",2,0],["ولما دعا داعي الوادع وفجعت","غرابيب بين نعيهن نعيب",144,"ب",1,0],["وَلَمْ أدْرِ هَلْ تَسْطُو عَلَيَّ لِحَاظُهَا","بِسُودِ جفُونٍ أمْ بِيِضِ قَوَاضِبِ",145,"ب",1,0],["ولما دعاني اليك الهوى","أجبتُ دعاء الهوى الآمر",146,"ر",1,0],["وَلَم أدرِ إن قبّلت قبّلتُ مبسماً","منَ الثغرِ أم قبّلت درّا منظّما",147,"م",2,0],["ولم أدعِ النايات فيها مجيبة","أغانيَ أغصان تميسُ بها خضرا",148,"ر",2,0],["ولما دعاني وارد الحب والهوى","إلى كشف ستري قلت لا ارتضيه قط",149,"ط",1,0],["ولم ادري هل انكار ذاك تغافل","وحمق ام الود القديم قد اختلف",150,"ف",1,0],["ولم ادر هل في الوقت ادراك فرصة","يعود بها من قادم العصر ما انصرف",150,"ف",1,0],["وَلَمّا دَنَت أَرض الحَبيب تَرجَّلُوا","وَأَظهَرَتِ الأَشواقُ ما كانَ خافيا",151,"ي",2,0],["ولم أدر بدراً قبلها عض في الدجى","على عنم بالأقحوان المفلج",152,"ج",1,0],["وَلَمْ أَدْخُلِ الْحَمَّامَ ساعَةَ بَيْنِهِمْ","لأِجْلِ نَعيمٍ قَدْ رَضِيتُ بِبُوسي",153,"ي",1,1],["ولما دجى الليل استعاد سنا الضحى","بوجه جميع الحسن بعض صفاته",154,"ت",2,0],["ولم أدر أن الصبح كان مراقباً","لنا من وراء الليل حتى تطلعا",155,"ع",2,0],["ولم أدر ضوءاً بِتُّ فيه أُقيمُهُ","أضوء ثنايا الخودِ أم ذا سنى البدر",156,"ر",1,0],["ولم أدر وشك البين حتى تحملوا","وسارت بهم أَيد القلاص البهازر",157,"ر",1,0],["ولما دعوتك اعزلا متوسدا","بل بالمهند جئت فوق حصاني",158,"ن",2,0],["ولما دعاني الشَّوقُ لَبَّيتُ واغتدى","أمامي عزمٌ عالمٌ بالمراشدِ",159,"د",1,0],["ولم أدرِ بالشكوى التي عَرَضت له","ونُعمَاهُ حتى أقبَلَ المجدُ يَستَعدي",160,"د",2,0],["ولم أدرِ إلاَّ أَنَّما مُحْسنٌٌ","إذا لك طبعٌ فيه أَم مُتعوّدُ",161,"د",1,0],["وَلَمَّا دَنَا وَقْتُ الوِلاَدَةِ أَبْصَرَتْ","عَجَائِبَ لَمْ تَطْرُقْ جَنَاباً لأَذْهَانِ",162,"ن",1,0],["وَلَمَّا دَعَا بِالْغَيْثِ لَبَّاهُ مُتْحِفاً","بِنَوْرٍ وَنُورٍ ذَاكَ يُهْدَى وَذَا يَهْدِي",163,"د",2,0],["ولم أدرِ ما مقدارُ أيام وصلِهِ","ولا طيبَ ذاك العيشِ جهلاً بقدرِهِ",164,"ر",2,0],["ولم أدرِ أنَّ الخطب يجمع وثبة","وأن عشار الموت بالثكل مقرب",165,"ب",1,0],["ولم أدر حتَّى زار شخصك ناظري","بأن التقى في الأرض شخصٌ مصور",166,"ر",1,0],["ولم أدر أَنَّ الهَوى ظالمٌ","كفرعون يهدمُ أركانَها",167,"ن",3,0],["وَلَم أَدرِ مِن أَلقى عَلَيهِ رِداءَهُ","وَلكِنَّهُ قَد سُلَّ مِن ماجِدٍ مَحضِ",168,"ض",1,0],["ولم أدر بين العذل والعدل مهملا","ولا العذب والتعذيب في المد والقصر",169,"ر",1,0],["ولم أدع الركاب إليه تهوى","هويّ الدلو أسلمت الرشاء",170,"ش",3,0],["ولما دعاني القلب قط لريبة","ولما مشت بي نحوها اقدامي",171,"م",2,0],["ولما دنا ما خطه حادث الردى","ثووا للثرى صعرى فنالوا المحامدا",172,"د",2,0],["ولمّا دهتني الحادثات ولم أجد","لها وزراً أقبلت نحوك أعتدي",173,"د",2,0],["ولم أدر ذا وحيٌ عن الله جاءكم","حديثاً ولم تدرك مداه الأوائل",174,"ل",1,0],["ولم أدر في الأبصار في غيهم عمى","فلم يبصروا أم أبصروا وتغافلوا",174,"ل",3,0],["ولما دنا منه القضا شام سيفه","وليس لما قد خطه الله من رد",175,"د",1,0],["ولم أدع لعالم تحبيرا","إلا وقد ظَلت بها خبيرا",176,"ر",2,0],["ولم أدر هل بان على كُثُبِ النقا","هفا بفؤادي أم قدود وأكفال",177,"ل",1,0],["ولما دعوتك والنائبات","يسرعن نحوي تراجعن عني",178,"ن",2,0],["ولم أدع بعدها تلك اليمين فتى","من أشيب من ذوى أسنانهم وصبي",179,"ب",2,0],["ولم أدر أنَّ الحدَّ يشملُ كونه","وكوني إذا كانت هويته خلقي",180,"ق",2,0],["ولم أدر أني خاتم ومعينٌ","إلى أربع منها بفاس وفي بدر",181,"ر",1,0],["ولما در في فضل معن مدخل","وأبان سحبان الفصاحة باقلُ",182,"ل",1,0],["ولما دعوتُ الله غيرةَ مؤمنٍ","على من تعدَّى في الشريعة واعتدى",183,"د",2,0],["ولم أدر ما هذا ولا ينجلي لنا","مقالته فيه والشفع والوترِ",184,"ر",1,0],["ولما دنونا للوداع وطرفها","يشير صريحاً أنها تكره البعدا",185,"د",2,1],["ولم أدرِ لِم دلَّت على صدق قولهم","إذا لم يكن للعقل نهي ولا أمر",186,"ر",1,0],["ولما دَعاه اليه القضاء","لبى بحيث القضا منه لابا",187,"ب",2,0],["ولم أدر لم انكرت كون اختفائه","بأمر الذي يعيا بحكمته الفكر",188,"ر",1,0],["ولما دجى ليل الخطوب وقد بدت","بدور صدور من غلايل خرد",189,"د",1,0],["وَلما دَعاه الله لبّى لِأَمره","مُطيعاً رَحيب الصدر وَالجأش طامن",190,"ن",1,0],["وَلما دَنَت آجالهم رَحبوا بِها","كَأَن لَهُم بِالمَوت بلغة آمل",191,"ل",1,0],["ولم أدر أن الشمس يسترها ثرىً","ولا الفلك الأعلى يغيبه لحد",192,"د",1,0],["ولما دعوا يا عروة بن ملهل","ضربت جموع الفرس حتى تولت",193,"ت",1,0],["وَلَمّا دارَتِ الكَأسُ","أَدَرنا بَينَنا لَحنا",194,"ن",2,0],["ولما دعاه الله لبى دعاءه","وأصبح في جنات عدن يخلد",195,"د",1,0],["ولما دعاه الله لبى دعاءه","ليحرز سعدا في النعيم مؤزرا",196,"ر",2,0],["ولما درى قاضي الهوى قول عاذلي","وكاد على الحكم أن يتقررا",197,"ر",2,0],["ولم ادر بعد العقد ما كان بيننا","أخلع بران أم طلاق كطالق",198,"ق",1,0],["ولما دعاها أسرعت بمسيرها","فجاءت كما شاء الهوى تسرع الخطوى",199,"و",2,0],["ولما دخلتُ الريّ قلت لرفقتي","خذوا حِذركم من داغر وخؤون",200,"ن",1,1],["ولم ادرِ اذا وهبتك الروح صفقة","ملكت حياتي ام مماتي ام معا",201,"ع",2,0],["ولم ادر اذ هبَّ الشمال بذكركم","شربت شمولاً ام شربت شمائلا",202,"ل",2,0],["ولم أدرِ أنى استقرُّ لأنني","أفرُّ بإحساسي إلى حيث لا أدري",203,"ي",1,0],["ولم أدر اذ عقّني أنّه","حمارٌ ويرفس من يطعمه",204,"م",2,0],["ولم أدر ما ذا قد دعاهم لقوله","إذا لم يكن في النفس منهم له داعي",205,"ع",2,0],["ولم أدر من ألقى عليه رداءه","سوى أنه قد سل عن ماجدٍ محض",206,"ض",1,1],["وَلَم أَدرِ قَبل الحُب نَجلاء طفلة","تَصيد فُؤاد اللَيث وَالأسد الوَرد",207,"د",1,0],["وَلَم أَدرِ قَبلَ البين أَن يفجع العلى","بِدرة خدر طالَما صانَها الخدر",208,"ر",1,0],["ولم أدر ما حظ الألى يهدمونني","سوى أنهم يبغون ذبح صريع",209,"ع",1,0],["ولما دعاه الحق جل جلاله","ليوليه تقريباً بما لم يشاكل",210,"ل",1,0],["ولما دعت للعلم لبيت طالباً","وخلفت من أهوى وما كنت أطلب",211,"ب",1,0],["ولما دهى المولى الحسين وآله","كتب التلهف مجملاً ومفصلا",212,"ل",2,0],["ولما دعوتُ الكأس تؤنسُ وحشتي","لبعدك زادتني اشتياقاً إلى القربِ",213,"ب",1,1],["وَلم أدر إِذْ زموا الهوادج بالضحى","أطرفي أعمى أم نهاري مظلم",214,"م",1,1],["ولم أدرِ أنّ الضّيمَ يومَ أتيتكم","تخيرتُه في بعض ما أتَخَيَّرُ",215,"ر",1,0],["ولمّا دعاهُ الموتُ قال لأهلِهِ","صِلوا حبلَ قومٍ بالوفاءِ متيمِ",216,"م",1,0],["ولمّا دعا الابطالُ يالَ مقاعسٍ","تقاعسَ عنا مالكٌ وبنو عَمْرو",217,"ر",2,0],["ولم ادر علمي نافعي أم جهالتي","ألا رب جهل كأن أنفع من علم",218,"م",1,0],["وَلما دَهاني الدَهرُ بِالبَين موحِياً","وَلَم أَرَ لي مِن ذا الفُراقُ مُنجِيا",219,"ي",2,0],["ولم ادر خير الرسل سر قدومها","له فأهني باللقا حيث قدرا",220,"ر",2,0],["ولم أدرِ أن السقم يجمل قبل أن","يتيه بجفنيه بعز دلاله",221,"ل",2,0],["وَلما دَعوتَ الكُل حيّ عَلى النَدى","سَعيتُ كَأَني قَد سَمعت بلالا",222,"ا",1,0],["وَلَم أُدبِر عَن الأَدنَينِ إِنّي","نَآني الأَكرَمونَ وَما نَأَيتُ",223,"ت",1,0],["ولم أدر من فرط الضنى بمزارها","ولو أنني انفقت في حبها عمري",224,"ر",2,0],["وَلم أَدرِ ما أَبكي أَعهداً وَقَد مَضى","وَمَغنىً وَقَد أَمسى كَبيداءِ بلقع",225,"ع",1,0],["وَلما دَرى درعَ اصطباري يصونني","تلبَّس من بادي الضيا أَزرقَ الزَرَد",226,"د",1,0],["ولم أدر هل نالتك في القبر يقظٌ","قعدت إلى همٍ قديمٍ وبلبالِ",227,"ل",1,0],["ولم أدر قبل جفاء المليحة","كيف يكون جنون الكدر",228,"ر",1,0],["ولم أدر لولاها بأن الهوى هدى","ولا عاد كفري بالمحبة إيمانا",229,"ن",2,0],["ولما دعت رفعت إلى ما","يلي سيناتها كفَّاً خضيبا",230,"ب",2,0],["وَلَمّا دَخَلتُ السِجنَ يا أُمِّ مالِكٍ","ذَكَرتُكِ والأَطرافُ في حَلَقٍ سُمرِ",231,"ر",1,1],["ولما دنت يوم الرحيل وأسفرت","تخيلت شمساً قد تضاعف نورها",232,"ر",3,1],["وَلَمّا دَعاني الخَبيري أَجَبتُهُ","بِأَبيَضَ مِن ماءِ الحَديدِ صَقيلِ",233,"ل",1,1],["ولمّا دارت الهيجاءُ ضَرباً","على قُطبٍ وحان قضا الدُّيونِ",234,"ن",1,0],["ولم أدع في مقلتي حِثاثا","بالفتح والكسر فكن بحّاثا",235,"ث",2,0],["ولما دعا داعي الهدى قلت أرّخوا","أجبت ابن موسى صادق الحزم جعفر",236,"ر",1,0],["وَلَم أَدرِ ما المَكرُ الَّذي أَزمَعوا بِنا","فَأَحذَرَهُ حَتّى أمرَّ المَرائِرُ",237,"ر",1,0],["وَلَمّا دَعا الْمُخْتَارُ لِلثَّأْرِ أقْبَلَت","كَتائِبٌ مِنْ أشْياعِ آلِ مُحَمَّدِ",238,"د",1,1],["وَلَم أَدرِ أَنّ بناتَ العُقو","لِ تَفعَلُ فعل بَنات الدّنانِ",239,"ن",1,0],["وَلما درينا الواجب اليوم ظننا","بنو الغرب ذاك الواجب اليوم لا نَدري",240,"ر",2,0],["وَلما دنا الاثنان مني جعلت من","مَكانيهما بين الانام مَكاني",241,"ي",1,0],["ولم أُدرِكِ الأَمرَ الذِي جِئتُ أبتَغي","وَأَزوَاجُنا لا زِلنَ عَنَّا نوَائِيا",242,"ي",2,0],["ولما دنا آن حلِّ الثيار","ومالت فجند الأأخاء ارتمت",243,"ت",1,0],["وَلَم ادعم عَلى رملٍ","وَلَو بَيتاً مِن الشعرِ",244,"ر",1,0],["ولما دنا يوم الزواج وآذنت","بتحقيق احلام الهوى ليلة الوصل",245,"ل",1,0],["ولما دنا التوْديعُ قلتُ لصاحبي","حنانَيْك سِرْ بي عن مُلاحظة السِّرب",246,"ب",1,0],["ولم أدر أن الطيف كالزور زوره","واسماره مثل الأماني خدائع",247,"ع",1,0],["وَلَمّا دَعاني لَم أُجِبهُ لِأَنَّني","خَشيتُ عَلَيهِ وَقعَةً مِن مُصَمِّمِ",248,"م",1,0],["ولمَّا دنا التعريش منها فركتها","من الحلة الفيحاء حتى تركتها",249,"ه",2,0],["ولم أدر أنّ الدمعَ يصبحُ واشياً","فينشرُ ما تُطوى عليه الأضالع",250,"ع",1,0],["وَلمّا دَهاني مثل أيوب ما دَهى","وَلَم يَبقَ لي جَنبٌ يُقالُ لَهُ جَنبُ",251,"ب",1,0],["ولم أدر بعد غد ما يكون","مهلهلة هي أم صائحه",252,"ه",1,0],["ولم أدرِ أن الأمر قد حلَّ بي ولا","بغيري فربِّي عالمٌ لا مشارِكُ",253,"ك",1,0],["ولم أدرِ ما جهدُ الهوى وبلاؤهُ","وشدتهُ حتى وجدتك في قلبي",254,"ي",1,1],["ولم أدرِ أن الدمو","عَ تهتِكُ ما أسترُ",255,"ر",1,0],["ولم أدرِ أن القلب والعين والحشا","سواءٌ وأنّ الدمع حزنٌ مصعدُ",256,"د",1,0],["ولما دعاه اللَه لباه مسرعا","فسارع فيما قد دعاه تشوقا",257,"ق",2,0],["ولّما دجى ليلٌ وسارتْ رواحلُ","ولفّتنيَ الظلماء والنجمُ آفل",258,"ل",1,1],["ولم أدرِ هل فاضت من الشوق أدمعي","أم الروح فاضت أدمعاً وبواكيا",259,"ي",2,0],["ولَمَّا دَنَا المَوتُ مِنَّا بَدَت","رُؤَانا كَمَن نَفسَهُ هاجَمَا",260,"م",2,0],["ولما دوى في الحيّ صوت نعيّه","جرى الدّمع من فرط التّفجّع داميا",261,"ي",2,0],["ولم أدر بيشوناً ولم أر وجهه","ولكن روى عن قلبه يتفق الدّر",262,"ر",1,0],["ولما دنا الركب من يثربِ","أضاء السنى حالك الغيهبِ",263,"ب",1,1],["وَلَمّا دَعَاهُ الْمَوْتُ نَصْراً لِدينِهِ","أراهُمْ مِنَ الإقدامِ إِحْدَىٰ العَجايِبِ",264,"ب",1,0],["وَلَمّا دعاهمْ يَوْمَ خُمٍّ نَبِيُّهُم","يُنَاديهِمُ وَالِبيدُ تُمْلَأُ بِالْحَشْدِ",265,"د",1,0],["ولما دَفِئْتِ بثوبِ اعتناقي","دعوتُ السحابَ يزيدُ همولا",266,"ل",2,0],["[ وَلَمْ أَدْرِ أَنَّ الدِّعْصَ يَسْعَى بِهِ إِذاً","قَضِيبٌ مِنَ الأَغْصانِ حَشْوُ إِزارِ ]",267,"ر",1,0],["وَلَمْ أَدْرِ إِذْ زايَلْتُ بُرْقُعَ وَجْهِها","أَوَجْهٌ بَدا لِي مِنْهُ أَمْ قَمَرُ السَّمَا",268,"م",2,0],["وَلَمْ أَدْرِ إِذْ قَبَّلْتُ قَبَّلْتُ مَبْسِماً","مِنَ الثَّغْرِ أَمْ قَبَّلْتُ دُرًّا مُنَظَّمَا",268,"م",2,0],["ولما دهاني الحال واشتد خطبه","شكوت إلى رحماك يا رب من ضر",269,"ر",1,0],["ولم أدر من ذا الحب ما يبتغي القضا","لذل الكون من نفع ونجمك قد ولى",270,"ل",2,0],["ولم ادر الوفاء شذاه جرح","لنزف العاشقين وما جبنتِ",271,"ت",1,0],["ولم أدرك على أن","تلقي لأمري بالا",272,"ل",2,0],["ولما دنا وقتُ الرحيلِ وايقَنوا","بأنَّ النوى كالموتِ امرٌ محتَّمُ",273,"م",1,1],["وَلَمْ أَدْرِ حَتّى إذا ما انْتَهتْ","أتَصلُحُ في ذِكرِ أهلِ الحَسَبْ",274,"ب",1,0],["ولم أدر لا والبيت حلفة صادق","جلينا قرابا أم جلونا له قبرا",275,"ر",2,0],["ولم أدرِ ، هل أبدو كأصدق كاذبٍ","ببسمةِ عيدي أم كأذب صادقِ",276,"ق",1,0],["ولما دب عقرب الشر ليلاً","وسعى في النهار صل الحقود",277,"د",1,0],["ولم أدر إذْ مرتْ أمامي أكوكبٌ","أضاءَ أم النهرانِ حولي تدفقا",278,"ق",2,0],["ولم أدرِ هل في الريح علّقتُ أضلعي","وقد ينقض الإنسانُ ما ظلّ يعقدُ",279,"د",1,0],["ولَمْ أَدِرِ الكأَسَ في فتية ٍ","تباكرُهَا قهوة ً خندَريسا",280,"س",2,0]]}