,"راقبتني العيون فيك فأشفق","https://www.aldiwan.net/poem60549.html","الخفيف"],[480,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[501,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[506,"خيال الحقل","https://www.aldiwan.net/poem27894.html","مجزوء الوافر"],[516,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[516,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[516,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[516,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[516,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[525,"هذا الحبيب وصفوة الجبار","https://www.aldiwan.net/poem13289.html","الكامل"],[539,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[559,"إنما نحن للإله شئون","https://www.aldiwan.net/poem33829.html","المديد"],[559,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[559,"عالم الحكمة هذا","https://www.aldiwan.net/poem34558.html","مجزوء الرمل"],[559,"تب منك حين تقول يا فتاح","https://www.aldiwan.net/poem34679.html","الكامل"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[568,"تزداد فيك مصيبتي","https://www.aldiwan.net/poem69633.html","مجزوء الكامل"]],"verses":[["فَتَملَّيتُهُنَّ في عيشَةٍ خَضْ","راءَ تَندى كَروَضَةٍ غَنّاءِ",0,"ا",2,0],["فَتَمنَعُني إِذا يَمَّمت وَصلاً","بُحورٌ دونَ وَصلِكِ أَو وُحولُ",1,"ل",1,0],["فَتَمَنَّيتُ أَن يُغَشِّيَني اللَ","هُ نُعاساً لَعَلَّ عَيني تَراكِ",2,"ك",1,0],["فَتَمادى القَلبُ في بَحرِ الهَوى","يَركَبُ التَغريرَ حَتّى غَرِقا",3,"ق",2,0],["فتُمْرِضُها بألحاظٍ مِراضٍ","وتُسْهِرُها بأجفانٍ رُقودِ",4,"د",1,0],["فَتَمَّ عَلى مَعشوقَةٍ لا يَزيدُها","إِلَيهِ بَلاءُ الشَوقِ إِلّا تَحَبُّبا",5,"ب",2,0],["فَتَماسَكنا فَكانَت قُوَّةٌ","زَلزَلَت رُكنَ اللَيالي فَاِنهَدَم",6,"م",1,0],["فَتَمَلمَلَت جَزَعاً وَقالَت حامِلٌ","لَم تَدرِ طَعمَ الغَمضِ مُنذُ لَيالي",7,"ل",2,0],["فَتَمَلَّ في فُرشِ الكَرامَةِ ناعِماً","وَاِعقِد بِمَرتَبَةِ السُرورِ حُباكا",8,"ك",2,0],["فَتَمَلُّها في العِزَّةِ ال","قَعساءِ وَالعُمُرِ الطَويل",9,"ل",1,0],["فتملياها في نعيم دائمٍ","وترديا حلل السعادة وارفلا",10,"ل",2,0],["فَتَمَنْطَقْتَ بِالسِّلاحِ وَلَكِنْ","لا لِمَا تَطْبَعُ السِّلاحَ القُيُونُ",11,"ن",1,0],["فتمشّت تخلّعاً وتثنّت","وتلوّت كأنها خيزرانه",12,"ن",2,0],["فتمضي في الفضاء مضيّ سهم","عن القوس الضروح له ارتماء",13,"ا",2,0],["فَتَمَّت في الهَنيءِ جِنانُ دُنيا","فَقالَ الحاسِدونَ هِيَ الخُلودُ",14,"د",1,0],["فتمارى بنبأة من خفي","بين حقفين كلفته البكورا",15,"ر",2,1],["فتمسَّكْ به ولا تَدَعنْهُ","فتراه خَصماً من الخُصماءِ",16,"ا",2,0],["فتمايلنَ باهتزازِ غصونٍ","ناعمَاتٍ وبارتجاج روابي",17,"ب",2,0],["فتملَّ معتلياً سلامة ما","قُلِّدته وهَناك مَكرعه",18,"ع",2,0],["فتمدحُهُ بالفَهم والجودِ صامتاً","ولم يحتفلْ ذو منطق كاحتفالكا",19,"ك",2,0],["فتمطَّيْتَ قيسَ باعٍ تمامٍ","وتناولْتَ من قفاك بخَمْسِكْ",20,"ك",1,0],["فتمنحني عيالك منحَ سَمْحٍ","إذا نيكتْ حليلتُه ونيكا",21,"ك",2,0],["فتمَّتْ نعمةٌ المولى عليكم","ولا قرن الفناءُ إلى التمامِ",22,"م",1,0],["فَتُمسينَ لِلأَقذارِ فيكِ مَلاعِبٌ","وَفي صَفحَتَيكِ لِلنِعالِ ضُروبُ",23,"ب",1,0],["فَتَمَنَّيتُ لَو تُساعِفُني الدُنيا","فَأَقضي في العيدِ بَعضَ رِغابي",24,"ب",2,0],["فَتَمَنّى الصُبحُ تَغدو شَمسَهُ","وَتَمَنّى اللَيلُ تَغدو قَمَرَه",25,"ر",2,0],["فَتَمَتَّع بِالصُبحِ ما دُمتَ فيهِ","لا تَخَف أَن يَزولَ حَتّى يَزولا",26,"ل",2,0],["فَتَمَنّى كُلُّ قَبرٍ","حينَ أَودى لَو حَواه",27,"ه",1,0],["فتَمَطَّى الزَّهرُ والطَّيْرُ","وأَمواجُ المياهْ",28,"ه",1,0],["فتَمَايلتِ في الوُجُودِ كلحنٍ","عبقريِّ الخيالِ حلوِ النَّشيدِ",29,"د",1,0],["فَتَمَايَلَتْ سَكْرَى إلى","كَهْفِ الحَياةِ ولَمْ تُفِقْ",30,"ق",1,0],["فتمثل الدور الذي","قد مرّ خير ممثل",31,"ل",1,0],["فتمشيت فوقه وهي تحتي","تتراءى حمراء ذات اتقاد",32,"د",1,0],["فَتَمليكُ دِلَّيرٍ وَتَعظيمُ قَدرِهِ","شَهيدٌ بِوَحدانِيَّةِ اللَهِ وَالعَدلِ",33,"ل",1,0],["فتُمسي البُغاثُ الكُدْرُ وهي جوارحٌ","وتُضحي اللّقاحُ الخُورُ وهي فحولُ",34,"ل",1,0],["فَتَمِّمِ النُعمى الَّتي لَم يَزَل","مِثلُكَ يُسديها لِأَمثالي",35,"ل",2,0],["فتملها غراء تسفه حاسدي","إن هم في ميدانها بلحاق",36,"ق",1,0],["فتَمَلَّ السُّرورَ ما عِشْتَ فيه","باصطباحٍ من لَذَّةٍ واغتباقِ",37,"ق",1,0],["فتمَّمْ بنا السرورَ إليه","إن يَومَ السُّرورِ يومٌ قصيرُ",38,"ر",1,0],["فتمَّ لهم بذلك يومُ لَهْوٍ","غريبِ الحُسْنِ عذْبٍ مُستطابِ",39,"ب",1,0],["فتمنحُه صفوَ مكنونِها","وتَكتُمُه جُلَّ أقذائِها",40,"ا",3,0],["فَتَمَّ بِهِ عَليَّ سُرورِ يَومي","وَكادَ بِأَن يُعيدَ سُرورَ أَمسي",41,"س",2,0],["فَتَمَنَّيتُ لَو أَقا","مَ وَقامَت قِيامَتي",42,"ت",2,0],["فتمنّعت وأنا ألحّ سدىً","بالقول أُغريها وأَعتذر",43,"ر",1,0],["فَتَمَتَّعتُ مِن غَزالٍ وَحاشى","ذَلِكَ الشَخصَ أَن يَكونَ غَزالا",44,"ل",2,0],["فَتُمسي في سَوابِغَ مُحكَماتٍ","وَتُمسي في السُروجِ وَفي اللُبودِ",45,"د",1,0],["فتماسكوا فغدٌ قريبٌ فَجْرُهُ","منكم . وكلُّ مُؤمَّلٍ لَقَريب",46,"ب",1,0],["فَتَمارَت بِهِ قُرَيشٌ فَلَمّا","أَن رَأَت لَم تَشُكَّ فيهِ لِواها",47,"ا",3,0],["فَتَمَطّى لَهُ بِأَهزَعَ ماضٍ","موقَدِ النَصلِ مَتنُهُ مَبرِيُّ",48,"ي",1,0],["فَتَمَّ فَما في الحُسنِ شَيءٌ يُريدُهُ","لِسانٌ وَلا قَلبٌ بِقَولٍ وَلا فِكرِ",49,"ر",1,0],["فتَمْشونُ في وَشيِ الدّروعِ سوابغاً","ويمَشونَ في وَشيِ الُبرودِ المُنَمنَم",50,"م",1,0],["فتَمسّحَتْ لِمَمٌ بهِ شُعْثٌ وقد","جِئْنا نُقبّل ركْنَه الممسوحا",51,"ح",2,0],["فَتَمَشَّت في مَفاصِلِهِم","كَتَمَشّي البُرءِ في السَقَمِ",52,"م",1,0],["فَتَمَنَّيتُ وَقَلبي","لِلهَوى في زَفرَتَينِ",53,"ن",1,0],["فَتَمَطّى زَمخَريٌّ وارِمٌ","مِن ربِيعٍ كُلَّما خَفَّ هَطَل",54,"ل",1,0],["فتمَّ صُنعُ اللَّهِ للإسلامِ","وعَمَّنا سرورُ ذاكَ العامِ",55,"م",1,0],["فتمنحها عَن طيب نفس مجالساً","نيابيةً فيها العدالة تحكم",56,"م",1,0],["فتموت سلمى في الشبا","ب وزينب وتموت سعدي",57,"د",2,0],["فتَمَهَّلْ تسعدِ الرُّوحُ بما","وَهِمَتْ أو تطربِ النفسُ سماعا",58,"ع",2,0],["فَتَمَلَّ النَّعِيمَ أَنْتَ بِهِ مِنْ","أَجْلِ مَا قَدَّمَتْ يَدَاكَ حَقِيقُ",59,"ق",1,0],["فَتَمَلَّ النِعُمَاءَ خَالِدَةً فِي","جَنَّةٍ صُبْحُهَا بِغَيْرِ مَسَاءِ",60,"ا",2,0],["فَتَمَثَّلَتْ وَ كَأَنَّهَا","فِي الإِنْسِ مِنْ حُورِ الْجِنَانِ",61,"ن",1,0],["فَتَمَادَيْنَ فِي المَسِيرِ يَمِيناً","وَشِمَالاً وَمَا شَعَرْنَ بِكَدِّ",62,"د",1,0],["فتَمَادَى قَالَ فِي التَّصْوِيرِ لِي","غُرَرٌ قَالَتْ وَتُؤْتِي الرَّسْمَ عُمْرَا",63,"ر",2,0],["فَتَمَثَّلتَ لَهُمْ فِي صُورَةٍ","مَا رَأَتْ أَرْوَعَ مِنْهَا عَيْنُ رَاءْ",64,"ا",2,0],["فَتَمَلَّوْهُ لِقَاءً","واغَنَمُوا الْعَيشَِ الرَّغِيدا",65,"د",2,0],["فتمنيت أن نكون","في سما الحب نجمتين",66,"ن",1,0],["فتمضي من دجى ضاف","إلى أدجى إلى أضفى",67,"ف",2,0],["فتُمْسِكُ جَنْبك ذُعراً تخافُ","قَناها وتَرْهَبُ بتَّارها",68,"ر",3,0],["فتمتَم الذئب في أذْنيه: أنتَ على","رأس القطيع أميرٌ نافذ الكَلِم",69,"م",1,0],["فتمضي القوارب مقلوبة","وتأتي وينسى المحيط الصخب",70,"ب",1,0],["فتملاها مليّاَ وارتدى","جوّ عينيه، أصيلاً من صفاءِ",71,"ا",2,0],["فتمنّى قتل الألوف ولكن","مغيه صعبه القياد عسيره",72,"ر",2,0],["فتمتعْ به وعِشْ في سرورٍ","ألفَ عامٍ ولستُ أرضى بألف",73,"ف",1,0],["فَتَمّ عَلى مَعْشُوقَة ٍ، لا يَزِيدُهَا","إليهِ، بلاءُ الشّوقِ، إلا تحبنُّبا",74,"ب",2,0],["فتمسين للأقذار فيك ملاعب","وفي صفحتك للنعال ضروب",75,"ب",1,0],["فتمايلت تيهاً وراحت تنثني","عجباً وقد نظرت بنظرة معبس",76,"س",1,0],["فتمرح النفس في رياض هوىً","حوافل بالثمار والزهر",77,"ر",1,0],["فتملها يا ابن الكرام قَوافياً","مثل الجواهر فاقَتِ الأشعاَرَا",78,"ر",2,0],["فتَملَّ العلياءَ وابلُ الليالي","وأذلَّ الغاوى وأغنِ الوفودا",79,"د",2,0],["فَتَمَنَّيتُ سُلَيمى إِنَّها","بِنتُ عَمّي مِن لَهاميمِ العَرَب",80,"ب",1,0],["فَتَمَلَّ مِن وَشي القَريضِ مَلابِساً","طَرَّزتَها بِجَلالَةٍ وَعَلاءِ",81,"ا",2,0],["فَتَمَلَّ داراً بَلَّغَتكَ سُعودُها","أَقصى المُنى وَإِخالُها لَن تَقنَعا",82,"ع",2,0],["فَتَمَلْمَلْتُ، ثُمَّ قُمْتُ، وَأَلْقَيْ","تُ إِلَيْهِ طَوْعًا وَكَرْهًا زِمَامِي",83,"م",2,0],["فتمم الفضل واجعل ما تجود به","لله فيهم ولا تنظر إلى العلق",84,"ق",1,0],["فتم لها منك الفخار وما بقى","لتلك لديها ما تقيم به وزنا",85,"ن",2,0],["فتَمِيسُ الغصون زَهْوا إذا غَنْ","نَتْ عليهن مُطْرِباتُ الطيورِ",86,"ر",1,1],["فتمايلت أغصانُه من فوقه","وترجرجت أمواجُه من خلفِهِ",87,"ف",2,0],["فتمَثّلت ف