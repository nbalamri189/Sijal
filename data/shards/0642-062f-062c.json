","https://www.aldiwan.net/poem63811.html","البسيط"],[50,"يا رام قومي اصبحينا غير تصريد","https://www.aldiwan.net/poem63869.html","البسيط"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[46,"هل قبلت من ناصح أمة","https://www.aldiwan.net/poem23534.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85561","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85312","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19173","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54700","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67353","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23583","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[50,"يَا رَامَ قُومِي کصْبَحِينَا غَيْرَ تَصْرِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=22570",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[45,"لا دِمنَةٌ بلِوَى خَبتٍ، وَلا طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32200",""],[51,"ياليت شعري حين فارقتكم","https://www.poetsgate.com/ViewPoem.aspx?id=30453",""],[86,"يارَئيسَ الشِّعرِ قُل لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13059&r=&rc=14",""],[30,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""],[31,"يا خيليلّ، إذا لمْ تنفعا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18949&r=&rc=212",""],[31,"يَا أَيُّها العَاذِلُ في حُبِّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19007&r=&rc=270",""],[85,"أخذتْ نعشكِ مصرُ باليمينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9630&r=&rc=120",""],[85,"وقفَ الهُدْهُدُ في با","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9694&r=&rc=184",""],[85,"لا يقيمنَّ على الضَّيمِ الأسدْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9643&r=&rc=133",""]],"verses":[["قَد جاءَتِ النَفثَةُ الغَرّاءُ ضامِنَةً","ما يوبِقُ النَفسَ مِن عُجبٍ وَمِن دَرَنِ",0,"ن",1,0],["قَد جاءَ عيدٌ وَعيدُ المَرءِ لَذَّتُهُ","وَأَنتَ فيهِم عَظيمُ القَدرِ مَحمودُ",1,"د",1,0],["قَد جَرَّبوهُ فَما لا نَت شَكيمَتُهُ","وَحَمَّلوهُ فَما أَعيا وَلا رَزَحا",2,"ح",2,0],["قَد جَفَّ ريقُ لِسانِهِ","وَالنَفسُ يُجهِدُها صَداها",3,"ا",3,0],["قَد جَمَّعَ اللَهُ لِي شَملي بِقُربِكُمُ","مِن بَعدِ ما كانَ يا نَفسي الفِدا بَدَدَا",4,"د",2,1],["قد جَفاني النّوْمُ منْ بعدِهِمُ","مَنْ رَسولٌ بيْنَ جفْني وكَراهُ",5,"ا",2,0],["قد جعَلْنا وسيلَةً تُرْبَكَ الزّا","كِي زُلْفى إلى العَليمِ السّميعِ",6,"ع",1,0],["قَدْ جَدَّدَتْ زِينَةَ الدُّنْيَا بَرَامِكَةٌ","مِنْكُمْ مَكَارِمُهَا لَمْ تَرْضَ بِالدّوُنِ",7,"ن",1,0],["قَد جَلا سَيفَ عَزمِهِ صَقيلُ النَف","يِ فَأَربى عَلى السُيوفِ الصِقالِ",8,"ل",1,0],["قَد جازَ تَيهاءَ الأُمورِ وَلَم يَكُن","في وَعرِها وَكُؤودِها بِالكابي",9,"ب",2,0],["قَد جَمَعتَ الأَحزابَ حَولَكَ صَفّاً","وَنَظَمتَ الشُيوخَ وَالنُوّابا",10,"ب",2,0],["قَد جَعَلتَ الأَنامَ زادَكَ في الدَه","رِ وَقَد آذَنَ الوَرى بِالنَفادِ",11,"د",1,0],["قَد جَرى النيلُ تَحتَهُ بِخُشوعٍ","وَاِنكِسارِ وَهابَهُ الفَتَيانِ",12,"ن",1,0],["قَد جاءَ موسى بِالعَصا وَأَتَيتَنا","بِالعودِ يَشدو في يَدَيكَ وَيَنطِقُ",13,"ق",1,0],["قَد جاءَهُ يَسعى إِلَيهِ وَحَولَهُ","أَعلى وَأَكرَمُ مَن سَقاهُ النيلُ",14,"ل",1,0],["قَد جاءَ يَومُهُمُ هُنا وَأَمامَهُم","بَعدَ النُشورِ هُناكَ يَومٌ ثاني",15,"ن",2,0],["قد جئتُ دارك محسناً ومؤملاً","مُتعت بالحسنى وعقبى الدارِ",16,"ر",1,0],["قد جعلوا الجهل صواناً لها","من كل ما يدعو إلى المَأثمه",17,"م",2,0],["قد جَفتَنا الدنيا فهلاّ اعتصمنا","من جفاء الدنيا بحبل وِداد",18,"د",1,0],["قَد جَرَّبَت عَرَكي في كُلِّ مُعتَرَكٍ","غُلبُ الأُسودِ فَما بالُ الضَغابيسِ",19,"س",1,0],["قَد جَرَّبَ الناسُ قَبلَ اليَومِ أَنَّهُمُ","لا يَفزَعونَ إِذا ما قُعقِعَ الحَجَفُ",20,"ف",1,0],["قَد جَرَّبَت مِصرُ وَالضَحّاكُ أَنَّهُمُ","قَومٌ إِذا حارَبوا في حَربِهِم فُحُمُ",21,"م",1,0],["قَد جَحَدتَ الهَوى وَلَكِن أَقَرَّت","سيمِياءُ الهَوى وَلَحظُ المُريبِ",22,"ب",1,0],["قدْ جدْت بالقطرِ حتى زدتّ في طمعٍ","وأوَّلُ الغيث قطرٌ ثم ينسكب",23,"ب",1,0],["قد جاء ما جاء من رأيٍ ومن رشدٍ","وزال ما زال من غيٍّ ومن زَللِ",24,"ل",1,0],["قد جعلناك حاكماً فاقض بالحق","قِ وما زلتَ حاكم الظرفاءِ",25,"ا",2,0],["قد جادت الأرضُ بإنباتِهِ","فجُدْ لنا أنت بإهدائِهِ",26,"ا",3,0],["قد جلَّ عن أن يمسَّه نصبٌ","مخافةُ اللَّه وحدَها نَصَبُهْ",27,"ب",2,0],["قد جرّب الناسُ قبل اليوم أنَّهُمُ","مُعَوَّدُونَ إذا ما حاربوا الغلبا",28,"ب",2,0],["قَدْ جلاك الدهر للأعْ","يُنِ يا خير ولاتِهْ",29,"ت",2,0],["قد جعلنا الكؤوس فيها نجوماً","وجَعلنا الأكُفَّ كالأبراجِ",30,"ج",1,0],["قد جفتْ عيناه غمْضَهما","والخليُّ القلب قد رقدا",31,"د",2,0],["قد جرَّبَتْ منّي الوقائع باسلاً","أبقى الزَمانُ به نُدوبَ عِضاض",32,"ض",1,0],["قد جف واديه من تنفسه","فما به في الربيع مُرتَبع",33,"ع",1,0],["قد جعل الله الذي سبَّني","شيخاً يتمياً وأبى يتمي",34,"م",2,0],["قد جُدْتُمُ لي بالرضا","واللَّهُ يشكُرُ ما فعلتُمْ",35,"م",1,0],["قد جرى الغيثُ على عاداته","في الموافاة إذا وافيتَنا",36,"ن",2,1],["قد جُنَّ جُلُّ الناسِ في دهرنا","فعُدَّني بعضَ مجانينه",37,"ن",2,0],["قَد جُبتُها لَمّا تَوَقَّدَ حَرُّها","إِنّي كَذاكَ عَلى الأُمورِ هَجومُ",38,"م",1,0],["قَد جِئتَ تَحمِلُ رَأساً غَيرَ مُلتَئِمٍ","كَما تَحامَلَ فَوقَ القُنَّةِ الأَمَرُ",39,"ر",1,0],["قَد جَرى حُبُّ العُلى مَجرى دَمي","فَهيَ سُؤلي وَالوَفا مِن مَشرَبي",40,"ي",1,0],["قَد جَمَعتَ المَوتَ في صَدرِك وَالعَيشَ الجَميلا","لَيتَ شِعري أَنتَ مَهدٌ أَم ضَريحٌ لَستُ أَدري",41,"ي",1,0],["قَد جاءَ مَن يَمنَعُ الضَعفى وَيُرغِمُكُم","إِن تَحمِلوا عَنهُمُ النيرَ الَّذي حَمَلوا",42,"ل",3,0],["قَد جَدَّدَ البُعدُ قُرباً في الفُؤادِ لَهُم","حَتّى كَأَنَّهُمُ يَومَ النَوى وَصَلوا",43,"ل",3,0],["قَد جَمَعَت حُسناً بِهِ","أَلبابُنا تَفَرَّقَت",44,"ت",1,0],["قَدْ جرى زَوْرَقي","في الخِضَّمِ العَظيمْ",45,"م",1,0],["قَد جَعَل الرَحمان مِن لُطفِهِ","حَياتَها في القَطع لِلرأسِ",46,"س",1,0],["قد جحدوا جماله","كأنهم عنه عموا",47,"م",3,0],["قد جنى من اغراسه الناس ورداً","وهو منهن قد جنى اشواكا",48,"ك",2,0],["قد جاء يا أم وقت فوتي","ولم يجئ آه بعد صبري",49,"ي",1,1],["قد جاء هيا نتقى","جنونه وهوسه",50,"ه",1,0],["قَد جَنى الهُدهُدُ ذَنباً","وَأَتى في اللُؤمِ فَعلَه",51,"ل",2,0],["قَد جِئتُ أَبكيها وَآخُذُ عِبرَةً","فَوَقَفتُ مُعتَبِراً بِها مُستَعبِرا",52,"ر",2,0],["قَد جَنى ما قَلَّ مِن زَهرِ الرُبا","ثُمَّ أَعطى بَدَلَ الزَهرِ الشُهُد",53,"د",1,0],["قَد جَرَت لِغايَتِها","عَبرَةٌ لَها أَمَدُ",54,"د",1,0],["قَد جَرَت أَلسُنُهُم صافِيَةً","جَرَيانَ الماءِ في أَصلِ العُشُب",55,"ب",1,0],["قَد جَمَّلوكِ فَصِرتِ زَنبَقَةَ الثَرى","لِلوافِدينَ وَدُرَّةَ الدَأماءِ",56,"ا",2,0],["قَد جاءَ مِن سِحرِ الجُفونِ فَصادَني","وَأَتَيتُ مِن سِحرِ البَيانِ فَسُدتُهُ",57,"ت",2,0],["قَد جَعَلَتهُ تاجَها","وَعِزَّها وَالسُؤدُدا",58,"د",2,0],["قَد جاءَها الفاتِحُ في عُصبَةٍ","مِنَ الأُسودِ الرُكَّعِ السُجَّدِ",59,"د",1,0],["قد جاءنا في حكمة مكنونة","كتمانها لذوي النهى إفصاح",60,"ح",1,1],["قَد جاءَ نَصرُ اللَهِ وَالفَتحُ","وَشَقَّ عَنّا الظُلمَةَ الصُبحُ",61,"ح",1,1],["قَد جِئتَهُ فَنَزَلتَ أَيمَنَ مَنزِلٍ","وَرَأَيتَهُ فَرَأَيتَ أَحسَنَ مَنظَرِ",62,"ر",1,0],["قَد جَعَلَ اللَهُ إِلى جَعفَرٍ","حِياطَةَ الدينِ وَقَمعَ النِفاق",63,"ق",1,0],["قَد جُدتَ بِالطَرفِ الجَوادِ فَثَنِّهِ","لِأَخيكَ مِن أُدَدٍ أَبيكَ بِمُنصِلِ",64,"ل",1,0],["قَد جارَ موسى وَجارى حَتفَ مُهجَتِهِ","فَإِن يَكُن جائِراً فَالرُمحُ مُعتَدِلُ",65,"ل",1,0],["قَد جَرَّبَ الأَعداءُ مِن وَقعاتِهِ","ما كَفَّ غَربَ الخالِعينَ وَنَكَّلا",66,"ل",2,0],["قَد جاءَكَ الحُبُّ بي عَبداً بِلا ثَمَنِ","إِن خانَكَ الناسُ لَم يَغدُر وَلَم يَخُنِ",67,"ن",1,1],["قد جَرى نَيْلُه فكانَ غَماماً","ومَضى عَزمُه فكانَ حَريقا",68,"ق",2,0],["قَد جَعَلَ المُبتَغونَ الخَيرَ في هَرِمٍ","وَالسائِلونَ إِلى أَبوابِهِ طُرُقا",69,"ق",2,0],["قَد جاءَنا اللَهُ بِذا اليَتيم","مَن يَرحَم اليَومَ فَهُوَ رَحيم",70,"م",1,0],["قَد جِئتُكُم أَرومُ مِنها قَبَساً","نوديتُ أَن بورِكَ مَن في النارِ",71,"ر",1,0],["قَد جَرَّدَ الشوسُ فيهِ قُضبَ أَلسِنَةٍ","في مَعرَكٍ يَومُهُ المَشهورُ مَشهودُ",72,"د",1,0],["قَد جاءَ في حُسنِهِ","عَلى قَدَرِ",73,"ر",1,0],["قَد جُمِّعَت جَمعَ تَصحيحٍ جَوانِبُها","وَالماءُ يُجمَعُ فيها جَمعَ تَكسيرِ",74,"ر",1,0],["قد جَمَمْتُ العزمَ ما بينهما","بالسّرى والنجم بالليلِ البهيم",75,"م",1,0],["قَد جَرى في مُتونِهِنَّ مِنَ الإِف","رِندِ ماءٌ نَظيرُ ماءِ الشَبابِ",76,"ب",1,0],["قَد جاءَ مِن وَصفِكَ التَفسيرُ مُعتَذِراً","بِالعَجزِ إِن لَم يُغِثني اللَهُ وَالجُمَلُ",77,"ل",1,0],["قَد جَرَّبَتهُ تَغلِبُ اِبنَةُ وائِلٍ","لا خاتِراً غُدَراً وَلا نَكّاثا",78,"ث",2,0],["قَد جاءَنا الرَشَأُ الَّذي أَهدَيتَهُ","خَرِقاً وَلَو شِئنا لَقُلنا المَركَبُ",79,"ب",1,0],["قَدْ جمَّلَ المولى حماةَ بفضلِهِ","فدمشقُ تحسدُها على تمكينها",80,"ه",2,1],["قَد جَرَّتِ الريحُ بِها ذَيلَها","وَاِستَنَّ في أَطلالِها الوابِلُ",81,"ل",1,0],["قَد جَرى بِالبَينِ مِنها طائِرٌ","رَفَّ بِالفُرقَةِ ثُمَّ اِرتَفَعا",82,"ع",2,0],["قَد جَمَّعَت خِلَلَ الهُدى أَخلاقُهُ","جَمعاً عَلَيهِ يَنبَني التَوحيدُ",83,"د",1,0],["قَد جاءَ في الأَمثالِ قَولٌ سائِرٌ","لِمُهَذَّبٍ وَزَنَ الكَلامَ وَقَوَّما",84,"م",2,0],["قَد جَرَّبَ الحُروبَ حَتّى شابا","فَإِن دَعاهُ حادِثٌ أَجابا",85,"ب",2,0],["قَد جاءَنا العيدُ يا مُعَذِّبَتي","لا تَجعَليهِ هَمّاً وَأَحزانا",86,"ن",2,1],["قَد جُمِعَ الحُسنُ وَالمَلاحَةُ في","وَجهٍ مِنَ العاشِقينَ مَنحوتِ",87,"ت",1,1],["قد جئتُ أَسْتَسْقِي مكارِمَكَ التي","يَحْيا بها القَلْبُ المواتُ ويُخصِبُ",88,"ب",1,0],["قد جاءَ أمْرُ اللّهِ واقترَب المَدَى","من كُلّ مُطَّلَعٍ وحانَ الحين",89,"ن",1,0],["قد جُدْتَ حتى أمَّلَتْكَ أُمَيّةٌ","لو أنّ وِتْراً لم يُضِعْ تأميلا",90,"ل",2,0],["قد جاوروا أجَمَ الضّواري حولهم","فإذا همُ زأروا بها لم تَزأرِ",91,"ر",1,0],["قد جالتِ الأوهام فيك فدقّتِ ال","أفكارُ عنكَ فجَلّتِ الآلاء",92,"ا",2,0],["قَد جَعَلَ اللَهُ في أَنامِلِ إِب","راهيمَ ر