{"poems":[[55,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[79,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[95,"جاءوا وكانوا أربعه","https://www.aldiwan.net/poem11132.html","مجزوء الرجز"],[23,"مستشعري حلق الماذي يقدمهم","https://www.aldiwan.net/poem21266.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[79,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[146,"تظن فراقا أن تثار حمول","https://www.aldiwan.net/poem58376.html","الطويل"],[146,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[164,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[290,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[315,"قدحت يد الأشواق من زندي","https://www.aldiwan.net/poem59518.html","أحذ الكامل"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[458,"عيدان عيد تحرر وتفاؤل","https://www.aldiwan.net/poem61377.html","الكامل"],[469,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38203","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120022","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56266","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136350","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112856","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112764","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69365","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123165","الكامل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113746","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131690",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74236","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112672","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133217","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111490","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127357","الكامل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136495",""],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127924","الكامل"],[4755,"قَلَقٌ.. ولا أَدري لِمَ القَلَقُ!","https://www.poetsgate.com/ViewPoem.aspx?id=184210",""],[4778,"دخان من غير نار","https://www.poetsgate.com/ViewPoem.aspx?id=193782",""],[4869,"ضيق حالي","https://www.poetsgate.com/ViewPoem.aspx?id=151667",""],[4981,"نجوى إلى الحَجِيج","https://www.poetsgate.com/ViewPoem.aspx?id=190676",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5431,"بحبي هل أشفعه؟","https://www.poetsgate.com/ViewPoem.aspx?id=190400",""],[5442,"نمت ولم يجف كراك الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=114769",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5725,"أقات الموت","https://www.poetsgate.com/ViewPoem.aspx?id=208791",""]],"verses":[["وَأَفوَهَ بادَرتَهُ بِالمَقالِ","وَقَد لَجَّجَ الذَرِبُ القائِلُ",0,"ل",1,0],["وافَوا للّهِ ما عاهَدُو","هُ ما كَذبُوهُ إذْ صدَقا",1,"ق",2,0],["وَافَوْا وَقَدْ جَعَلُوا الدُّرُوعَ ضَرَاعَةً","إذا لم يكن غير الخضوع وفاء",2,"ا",2,0],["وَافَوا إِلَى سَاحَةِ جُوْ","دٍ نَزَلُوهَا عَنْ سِعَهْ",3,"ع",2,0],["وافٍ وَماضٍ شِهابٌ يُستَضاءُ بِهِ","بَدرٌ أَنارَ عَلى كُلِّ الأَماجيدِ",4,"د",1,0],["وَافَوْا لِيَقْضُوهُ الوَدَاعَ فَمَا تَرَى","إِلاَّ وُفُودٌ تَلْوَهُنَّ وُفُودُ",5,"د",1,0],["وافوا وقد جعلوا الدُّروعَ ضراعة","ً إذ لم يكنْ غيرَ الخضوع وِقاءُ",6,"ا",2,0],["وأفورُ قِدح قِدحُ خِلٍّ رِشاؤه","بحاجاتِنا في الأبعدين كفيلُ",7,"ل",1,0],["وأفوهَ طارده بالجدال","فخرّ بغير العوالى طعينا",8,"ن",2,0],["وافوه خوفاً منغضين رؤوسهم","وعلى الأنوفِ مذلةٌ وصَغارُ",9,"ر",1,0],["وَأفوزَ بِالغفران في أحبابهِ","فيقولَ لي قَد فُزتَ إنّك منهمُ",10,"م",1,0],["وافوا مليك يحف النصر رايته","والعدل راحته والفضل قد نشرا",11,"ر",2,0],["وافوك أنضاء تقلبهم","أيدي السرى بالغور والنجد",12,"د",1,0],["وافوا يخبِّرُنا بِضَعفِ عُقولِهم","أَنَّ المُدَبِّرَ ثَمَّ رَبَّةُ مَحمِلِ",13,"ل",1,0],["وأفوت للتاريخ ذكري هاديا","إن فات هذا الجيل حق جهادي",14,"د",2,0],["وافٍ ولم يعطِ العهودُ فكيف أن","أخذت عليهِ وصادقٍ لم يخلف",15,"ف",1,0],["وَأُفولٍ عَنِ الوَرى وَزَوالٍ","عَن ذُرى الحُسنِ وَالجَمالِ المنيفِ",16,"ف",1,0],["وافوا على خوص برتهن البرى","فرأيت أنضاء على أنضاءِ",17,"ا",2,0],["وأفوز في تقبيل ذيل مليكنا","وتقرّ مني في لقاه عيونُ",18,"ن",1,0],["وافوز في العقبى برؤية وجهه","ورضاه عني في اجل مكان",19,"ن",1,0],["وافوز بالشرب الهنيء من الشريعة","والمحبة والةياة منجدي",20,"د",2,0],["وافوز بالرضوان والتقريب من","ملك الملوك اللَه مولينا الاحد",21,"د",1,0],["وافَوا وَقَد عَقَدُوا عَقداً فَما ظَفِرُوا","بِما أَرادُوا وَحَلَّ اللَهُ ما عَقَدُوا",22,"د",3,0],["وافوا يهنّنونا بمولود سما","قمر السماء وفاقه تبجيلا",23,"ل",2,0],["وأفوزُ بكلِّ خيرَ إذا ما","قيلَ لي ذاكَ حَجُّهُ مَبرورُ",24,"ر",1,0],["وافوك من بعد الأنيس واصبحوا","يرضون بعد العين بالاثار",25,"ر",1,0],["وافوج انا مقصدي هبه","إلى ربا مخجل البانه",26,"ن",2,1],["وَأَفوق الصحب في نَيل الحمى","وَأَرى عَيشاً حَميداً رَغدا",27,"د",2,0],["وافوا إلها بعيونِ عبرى","وحرِ أشجان تُذيبُ الصَخرا",28,"ر",2,0],["وأفوز منك بلمحة","فيها العناية والرضا",29,"ض",2,0],["وإِفُوقُناً مِن آلِ رِيسُوسٍ وَمُر","شِدَقَومِهِ في الحَالِ نَبَّهَ يُجزِعُ",30,"ع",1,0],["وافوا بفنجان نقي ابيض","كالبدر فيه من الجمال صنوف",31,"ف",1,1],["وافوا إلى حافير الزمرد","واللَه خير حافظ ومسعد",32,"د",1,0],["وافوا إلى مكة في خشوع","بأعين ترفض بالدموع",32,"ع",1,0],["وافوا إلى مكة محرمينا","طافوا ببيت اللَه أجمعينا",32,"ن",2,0],["وأفُوزَ منها بالوداعِ","قُبيلَ ساعات الرحَيل",33,"ل",1,0],["وافوز في لقياكمُ متمتعاً","بنعيم ارض بحرُ نعماها طمى",34,"م",2,0],["وأَفُوحُ ثانِيةً.. أَفُوحُ وبي","حُزنُ الرَّمَادِ, وليسَ بي عَبَقُ",35,"ق",1,0],["وأفواهٌ حبالى بالرزايا","مكممة وليس لها معين",36,"ن",1,0],["وافوّح الأطيآب لآ فآحت اطيآب","واهدي لقلبي .. رآحه تعز بآلي",37,"ل",2,0],["وأفوزُ لو صلّيتُ في حَرَمِ الهدى","لَقِبَاءُ مسجدُ مُسلِمِينا الأوّلُ",38,"ل",1,0],["وافوا دمشق فظنوا انها جدة","ففارقوها وفي أيديهم العدم",39,"م",1,0],["وأفوا يلبونه طوعاً فقابلهم","مع الهدى منه ترحيب وتأهيل",40,"ل",1,0],["وأفواهٌ إذا اتحدت","إلى النيران تدفعه",41,"ع",2,0],["وأفوا ووفاهم كفيل المني","ما كان في ذمته من ديون",42,"ن",1,0],["وأفواهٌ يُمَجُّ اليَّ منها","على ظَمَئي بها مسكٌ فتيقُ",43,"ق",1,0],["وأفواه الردى رهباً تأنّت","فما لاكتْ نواجذها رفاتهْ",44,"ت",2,0]]}