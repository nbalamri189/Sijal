{"poems":[[65,"إذا غار عزمي في البلاد وأنجدا","https://www.aldiwan.net/poem45920.html","الطويل"],[79,"أيوسف دم للملك تعلي بناءه","https://www.aldiwan.net/poem35699.html","الطويل"],[79,"لمن علم في هضبة الملك خفاق","https://www.aldiwan.net/poem35918.html","الطويل"],[53,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[93,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[51,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[89,"ومسرح لسوام العين ليس له","https://www.aldiwan.net/poem8203.html","البسيط"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[92,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[119,"اطل مدة الهجر ان ما شئت وارفض","https://www.aldiwan.net/poem40918.html","عموديه"],[139,"من بعد حمزة يحمي حوزة الأدب","https://www.aldiwan.net/poem49177.html","البسيط"],[190,"خذوا حديثي وما ألقاه من حنفي","https://www.aldiwan.net/poem43812.html","البسيط"],[214,"ثبوت حسنك لي فيه شهادات","https://www.aldiwan.net/poem13336.html","البسيط"],[226,"الصفو مثل الكمال","https://www.aldiwan.net/poem55249.html","المجتث"],[275,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[287,"هذي الرياض وأنفاس الرياحين","https://www.aldiwan.net/poem32365.html","البسيط"],[466,"تفر صنوف العيب عن نيل مجده","https://www.aldiwan.net/poem16118.html","الطويل"],[556,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[563,"رفعنا إلى أوج العلاء رؤسنا","https://www.aldiwan.net/poem34942.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83296","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39021","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137620",""],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137641",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59685","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62535","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46517","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78026","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128000","البسيط"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114711","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109317","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93738","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205778","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100274","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58258","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200736","المتقارب"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112538","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123528","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136907",""],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[5010,"كن جميلا تجد معنى الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=190723",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5186,"فتاة السترة استمعي لنصحي","https://www.poetsgate.com/ViewPoem.aspx?id=156502",""],[5385,"عهدنا بغرب مطلع البدر مشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=144220",""],[5491,"الشعر الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=215329",""],[5518,"توسلت بالمختار أرجى الوسائل","https://www.poetsgate.com/ViewPoem.aspx?id=190036",""],[5561,"أُمُّ الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=192738",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""]],"verses":[["وَلِلْغَايَةِ القُصْوَى سَمَتْ بِيَ هِمَّتي","فَلا بُدَّ مِنْ نَيْلي المَعالي أَو الرَّدَى",0,"د",2,0],["وللغيث ينبوعاً وللشمس مطلعا","وللظبي والضرغام غلبا ومكنسا",1,"س",2,0],["وللغَيْثِ إمْساكٌ وفي الأرضِ رَجّةٌ","وللدّينِ والدُنْيا وُجومٌ وإطْراقُ",2,"ق",1,0],["وللغُروس المثمرات غارسه","غاذيةً أطفالَهنّ كانسه",3,"س",2,0],["وَلِلغَرَندَقِ رَأيٌ مِثلُ صارِمِهِ","يَزُلُّ عَن صَفحَتَيهِ الحادِثُ الجَلَلِ",4,"ل",1,0],["وَلِلغِيِّ أَحياناً سَبيلٌ مُشَبَّهٌ","وَلَكِن سَبيلُ الرُشدِ أَهدى وَأَبهَجُ",5,"ج",1,0],["وَلِلْغَمَائِمِ بَيْنَ الأُفْقِ مُنْسَحَبٌ","وَلِلنَّسَائِمِ نَحْوَ الرَّوْضِ مُتَّجَهُ",6,"ه",1,0],["وَلِلغُلامِ ضَجرَةٌ وَهَمهَمَه","وَشَتمَةٌ في صَدرِهِ مُجَمجَمَه",7,"ه",1,0],["ولَلْغَرَضُ الموصومُ أعلى محلةً","من المرءِ منبوذاً علته الأسافل",8,"ل",1,0],["وللغير بحر من عطائك زاخر","يضيع سدى فيما نرى لم يعوض",9,"ض",1,0],["وللغرائب تأتي في رسائلهُ","طوعاً وتعنو له في الشعر والخطب",10,"ب",1,0],["وللغزالة وقعٌ في حميّتها","والجو يشرق في أثوابه الخضر",11,"ر",1,0],["وللغصون على تلك الدفوف اذا","ما شبب الريح رقصات وميلات",12,"ت",1,0],["وللغرائز حكم","ماض على أي حال",13,"ل",1,0],["وللغاب والوادي الخشوعَينِ تحتَهُ","زفيرٌ وهمسٌ عنهما الشّعرُ قد قصّر",14,"ر",1,0],["وَلِلغُصونِ اِهتِزازٌ بِالنَسيمِ كَما","هَزَّ النَصارى سُروراً وَصفُ شَمعونِ",15,"ن",1,0],["وللغدْرِ عهدٌ لا تَحُلُّ عُقودهُ","موانعُ من أيامِهِ وشَواغِلُهْ",16,"ل",2,0],["وللغيب حِفظُ الغائبين كأنما","مُعادِيهِ في ظَهْرِ المغيبِ مُخاللُهْ",16,"ل",2,0],["وللغرام وإنْ بِتْنا نكتّمُهُ","عن أعينِ النّاس آياتٌ وعنوانُ",17,"ن",1,0],["وللغير لم نحتج به أن يسوسنا","أيا ربة الألحان ديري كؤسنا",18,"ن",2,0],["وَلِلُغَةِ الفُصحى يَصونُ ذِمارُها","وَتَملَأُ فيها الخافِقينَ مَآثِرُه",19,"ر",2,0],["وللغُصونِ اعتِناقٌ تحتَ ذَيل صَبا","نَسيمها كاعِتناق اللّامِ والألِفِ",20,"ف",1,0],["وللغاز والكهرباء ازدحام","لخدمة أرباب كل مقام",21,"م",1,1],["وللغاز والكهرباء شريط","بتلك المنازل طرا يحيط",22,"ط",1,1],["وللغارة الشعواء من أنجم الدجى","ملاحم في آفاقها وهزائم",23,"م",1,0],["وللغبرة الخضراء حصن متى سخت","به كوفئت بالصّفح عن أهلها الحشمْ",24,"م",1,0],["وللغصن ساق بالخليج مخلخل","وللنور جيد بالرذاذ منظم",25,"م",1,0],["وللغصن ما زرت عليه ثيابها","وللزهر ما أخفاه عنا التلثم",25,"م",1,0],["وِللغذاء كُلما اشتَد القرم","جَميعكم لا سيما جنس الغَنَم",26,"م",1,0],["وَلِلغَير لا أَشكو وَإِن سامَني الرَدى","وَفَصَّلَ فَصّالَ المَنايا مَفاصِلي",27,"ل",2,0],["وللغصون اضطراب حين حدثها","رواى الصبا من أحاديث لحا",28,"ح",2,0],["وَلِلغيدِ دولاتٌ تدولُ وَتَنقَضي","إِذا وَلَّت الأَيّامُ بِالحِبرِ وَالسِبر",29,"ر",1,0],["وللغنى ومن لم تحص كثرته","تفريق عشرٍ على من كان ذا عيلِ",30,"ل",1,0],["وللغربة في الحرِّ","فعالُ النار في التّبر",31,"ر",1,0],["وللغرب الخوارِ عيصٌ مؤشبٌ","يُصانُ بما فيه ابتذالٌ لمن فَطَن",32,"ن",1,0],["وللغارات ربّتنا الغيارى","وحضَّتنا على الصبر الحواضن",33,"ن",1,0],["وَلِلغَرام هَداني صُبحُ غرته","وَجعدُهُ قَد أَضلتني لَياليه",34,"ي",2,0],["وللغدير على ترجيعه نغم","من الخرير له ضرب وأوزان",35,"ن",1,0],["وللغزال قميص منه فوَّفهُ","وللغزالة جيب منه مقدود",36,"د",1,0],["وَللْغَيْثِ رشٌّ بالرَّذاذِ وَمِثْلُه","سحائبُ نيلٍ والصّريخُ رُعودُها",37,"د",3,0],["وللغرب سرت وعنه نَمَوْت","إلى أن نمَوت عن العالم",38,"م",1,0],["وللغواني اضطراب كلما نظرت","عيونهن إلى عينيى وتحديق",39,"ق",1,0],["وللغزال فدى والذبح منه وقى","في قصة الجمل المشهور في الرسم",40,"م",1,0],["ولِلْغوانِي فتنةٌ أشدُّ مِن","قَتْلِ النفوسِ والفَتَى مَن ارْعَوَى",41,"ا",1,0],["وللغيوم بكاء في اصائله","وللبروق افترار في دياجيه",42,"ي",2,0],["وللغزلة تسليم به اشتركت","مع التي هي ترعى نرجس الظلم",43,"م",1,0],["وَلِلْغُرُوْبِ جَمَالٌ لَسْتُ أُنكِرُهُ","فِيْهِ الْهُدُوْءُ ، وَيَرْوِي الرُّوْحَ إِرْوَاءَ",44,"ا",2,0],["وللغاية القصوى بقصواء شمرا","فما بكسا زهوٍ ينال كساء",45,"ا",2,0],["وللغادات بلبال وبال","وأعدلهن أهدأهن بالا",46,"ل",2,0],["وللغرب أصل الفضل إذ هو مطلع","وإن يك ذاك البدر في الشرق أشرقا",47,"ق",2,0],["وللغصن في حقويك ميسٌ ورقةٌ","ومن ضفة الأغصان تحلو المنابعُ",48,"ع",1,0],["وللغير لا أشكو وإن سامني الدهر","وفصل فصال المنايا مفاصلي",49,"ل",2,0],["وللغير في كهف الزمان مكانهُ","وإن ظنَّ زعما أنّهُ سيّدٌ فينا",50,"ن",2,0],["وللغاصبين أكون خدوما","أبيع البلاد عبادا ودورا",51,"ر",2,0]]}