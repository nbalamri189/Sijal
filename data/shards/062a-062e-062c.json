{"poems":[[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[447,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79864","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104675","الرمل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104676","الخفيف"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123899","المنسرح"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85004","الطويل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138917",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5582,"دَعاهُ يَعُجْ فِي حُبِّهِ لِمَعاجِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63476",""]],"verses":[["تُخْجِلُ الدُّرَّ واليواقيتَ من نَوْ","رِ رُباها البَيْضَاءُ والحَمراءُ",0,"ا",2,0],["تخْجَلُ السُّحْبُ إذا ما وازَنَتْ","مَرَّةً بَيْنَ نَداهُ وَنَداها",1,"ا",3,0],["تخجل الخيل بالذليل إذا صالت","ويشقى سرج ويشكو عنان",2,"ن",1,0],["تخجل النيل أو بحر البحيرة أو","بحر الفرات وغادي المزن راحته",3,"ت",2,0],["تَخجَلُ البَدرَ طَلعَةً حينَ تَبدو","تَفضَحُ البَرقَ مَبسِمُها حينَ تَفتَر",4,"ر",1,0],["تُخجِلُ العِقدَ وهو مُلتَهِبُ النَّو","رِ وتُزري بالبُردِ وهو قَشيبُ",5,"ب",1,0],["تخجلُ المزنُ إذا ساجلَها","بيدٍ أرطبَ منهنَّ أديما",6,"م",2,0],["تخجل الورد وجنتاه فيبدو","منهما فيه حمرة الحجال",7,"ل",1,0],["تَخجَلُ الشَمسُ لِلُقياهُ وَلا","يَحكِهِ البَدرُ إِذا ما تُمِّما",8,"م",2,0],["تخجل الشمس للقياهن بل","يستعير البدر منهن التماما",9,"م",2,0],["تَخجَلُ الشَمسُ مِنهُ","وَالحَيا السَكبُ عَنهُ",10,"ه",1,0],["تُخجِلْ شمس الضحى إذا انتقبت","والقمرَ التمّ غير منتقبهْ",11,"ب",2,0],["تَخجَلُ بَدرَ التَمِّ مِن حُسنِ وَجهِهِ","وَمِن حُزنِهِ تَبكي عَلَيهِ غَمائِمُه",12,"م",2,0],["تخجل الشمس أذاما","بزغت رأد ضحاها",13,"ا",3,0],["تخجل الشاكين إذ تب","كي حياء وانكسارا",14,"ر",2,0],["تُخَجِّلُ مِنْ جَدْواكَ مُزْنَ الحَيا وَإِنْ","تَبَعَّجَ وَانْهَلَّ الحَيا بِانْبِعاجِهِ",15,"ج",2,0]]}