أَنَّ الجَبانَ إِذا سَرى لَم يوغِلِ",1,"ل",1,0],["مُتَوَسِّدينَ عَلى الخُدودِ كَأَنَّما","كَرَعوا عَلى ظَمَإٍ مِنَ الصَهباءِ",2,"ا",2,0],["مُتَوقِّدُ العَزَماتِ لو رُمِيَتْ بِها","زُهْرُ النُّجومِ لآذَنَتْ بخُمودِ",3,"د",1,0],["متَوَشِّحاً بالمَشْرَفيِّ يُقِلُّهُ","أسَدٌ مَخالِبُهُ الحُسامُ القاصِلُ",4,"ل",1,0],["مُتَوَّجُ أعلى قِمَّةِ الرّأسِ ساحِبٌ","جَناحَيْهِ في العَصْبِ اليَماني مُرَعَّثُ",5,"ث",1,0],["مُتَّ وِالناسُ عَن مُصابِكَ وَشُغ","لٍ بِجُرحِ الرَئيسِ حامي الحُماةِ",6,"ه",1,0],["مُتَواضِعانِ وَلا أَرى مُتَكَبِّراً","غَيرَ الجَهولِ مُدَنَّساً بِالعابِ",7,"ب",1,0],["مُتَوَضِّحٌ حَيثُ الحتوف كَوالِحٌ","مَحشودَةٌ بِصَفائِحٍ وَرِماحِ",8,"ح",1,0],["مُتَوَسِّداً عَضباً مَضارِبُهُ","في مَتنِهِ كَمَدَبَّةِ النَملِ",9,"ل",1,0],["مُتَوِّجِي كُلِّ مَا جَاؤُوا بِمَحْمَدَةٍ","وَمُخْرِجِي كُلِّ مَا شَاؤُوا بِإِتْقَانِ",10,"ن",1,0],["مُتَوَخِّيَاً منْ دُونِها أُمْنِيَّةٌ","لَمْ يُوهِ وَحْدَتَهَا شَتِيتُ أَمَانِي",11,"ن",2,0],["مُتَوَقِّدٌ فَطِناً سَبُوقٌ هِمَّةً","مُتَبَصِّرٌ مُتَهَوِّرٌ مِقْدَامُ",12,"م",1,0],["متوقِّدٌ لهب الحديد بجوه","تصلى به الأعداء لفح أوارِ",13,"ر",1,0],["متوشحاً عزّ الشهامة جاعلاً","كزعيمه حبّ المواطن دّيْدنا",14,"ن",2,0],["مُتَوَسِّداً حُرَّ الجَبينِ مُعَفَّراً","قَد عُرَّ مارِنُ أَنفِهِ بِقُيوحِ",15,"ح",1,0],["مُتَوَشِّحٌ بِمعَاذتين يخيفُهُ","ما لا يُخاف وقد سبى مَنْ قد سبى",16,"ب",2,0],["مُتوشٍّ باصفرار","وبياض واحمرار",17,"ر",1,0],["متوقد الحركات تحسب أمره","لمعان برق أو حفيف بُراق",18,"ق",1,0],["متواضعاً أبداً وقدرُك يَعتلي","متضائِلاً أبداً وأمرُك يعبُلُ",19,"ل",1,0],["متوخياً حظي بذاك مؤدياً","فرضاً لخيرِ الطاهريّة لازما",20,"م",2,0],["متواضعاً أبداً وأنت بربوةٍ","مُتضائِلاً أبدا وأنت عظيمُ",21,"م",1,0],["مُتَوافِقونَ عَلى التَبا","يُنِ كَالقَبيلِ أَوِ العَشيرِ",22,"ر",1,0],["مُتُّ وَجداً وَلَوعَةً","فَاِسقِنيها لَعَلَّني",23,"ي",1,0],["مُتَواتِراتٍ بِالإِكامِ إِذا","جَلَفَ العَزازَ جَوالِبُ النُكبِ",24,"ب",1,0],["مُتَوَضِّحَ الأَقرابِ فيهِ شُهبَةٌ","نَهِشَ اليَدَينِ تَخالُهُ مَشكولا",25,"ل",2,0],["مُتَوَسِّدونَ عَلى الحِياضِ لُحاهُمُ","يَرمونَ عَن فُضَلائِها فُضلانا",26,"ن",2,0],["مُتَوَرِّدَ الوجناتِ سَكرانَ الخطى","يهتزُّ من مَرَحٍ وفَرْطِ حُبورِ",27,"ر",1,0],["متَوشِّحاً بالسِّحْرِ ينفُخُ نايَهُ","المشبوبَ بَيْنَ خمائلٍ وغديرِ",27,"ر",1,0],["متوحِّداً بِعَواطفي ومَشاعِري","وخَواطري وكَآبَتي وسُروري",28,"ر",2,0],["مُتَواضِعاً لِلَّهِ بَينَ عِبادِهِ","وَاللَهُ يُبغِضُ عَبدَهُ المُتَكَبِّرا",29,"ر",2,0],["مُتَوَجِّعٌ يَتَمَثَّلُ اليَومَ الَّذي","ضَجَّت لِشِدَّةِ هَولِهِ الأَقدامُ",30,"م",1,0],["مُتَواضِعٌ وَاللَهُ شَرَّفَ قَدرَهُ","بِالشَمسِ نِدّاً وَالكَواكِبِ آلا",31,"ل",2,0],["مُتَوَدِّدٌ عِندَ الكَمالِ تَخالُهُ","في راحَتَيكَ وَعَزَّ ذاكَ مَنالا",31,"ل",2,0],["متوجعاً لي من شَكاةِ أذىً","هَدَّتْ قُوايَ وأَغمضت جَرسي",32,"ي",1,0],["مُتَوَقِّعينَ لِأَمرِ أَغلَبَ لَم يَزَل","جُرحُ الضَلالِ عَلى يَدَيهِ رَحيبا",33,"ب",2,0],["مُتَواضِعٌ وَأَقَلُّ ما يَعتَدُّهُ","في المَجدِ يوجِبُ نَخوَةَ المُتَكَبِّرِ",34,"ر",1,0],["مُتَوَجِّسٌ بِرَقيقَتَينِ كَأَنَّما","تُرَيانِ مِن وَرَقٍ عَلَيهِ مُوَصَّلِ",35,"ل",1,0],["مُتَوَقِّدٌ يَبري بِأَوَّلِ ضَربَةٍ","ما أَدرَكَت وَلَوَ اَنَّها في يَذبُلِ",35,"ل",1,0],["مُتَوَجِّهاً تُحدى بِهِ بَصرِيَّةٌ","خُشنُ الأَزِمَّةِ ما لَهُنَّ نُسوعُ",36,"ع",1,0],["مُتوشِّحاً فيه دماً","كَحمائلِ البِيْضِ الرِّقاقِ",37,"ق",1,0],["متوشِّحينَ بكلِّ أبيضَ مُرهَفٍ","نِيطَتْ حَمائِلُهُ بأبيضَ أزهَرِ",38,"ر",1,0],["متواتراتٍ لا تغُبُّكما وهل","للصُّبحِ راعي الليلِ من إغبابِ",39,"ب",1,0],["مُتَوَقَّعُ الإِغضاءِ عَن تَقصيرِهِ","مَن ذا يُوازِنُ فَضلَكُم وَيُوازي",40,"ي",1,0],["متوثبين يميل صفهم","متطلع الأعناق يتقدُ",41,"د",1,0],["متوسّدين بها عبابَ دروعهم","إنّ الدروع وسائدُ الشُجعانِ",42,"ن",1,0],["مُتَواطِّئو عَقِبَيكَ في طَلَبِ العُلا","وَالمَجدُ ثُمَّت تَستَوي الأَقدامُ",43,"م",1,0],["مُتَوَقِّدٌ مِنهُ الزَمانُ وَرُبَّما","كانَ الزَمانُ بآخَرينَ بَليدا",44,"د",2,0],["مُتَوَاضِعٌ لِلْقَوْمِ تَحْسَبُ أَنَّهُ","مَوْلىً لَهُمْ فِي الدَّارِ وَهْوَ هُمَامُ",45,"م",1,0],["مُتَوَسِّدينَ بِها التُرابَ كَأَنّهُم","لَم يَرتَعوا في زَهرَةِ النَعماءِ",46,"ا",2,0],["مُتَوَلِّدٌ عَن خاطِرٍ مُتَوَقِّدٌ","لَهَباً وَطَبعٍ سَلسَلٍ دَفّاقِ",47,"ق",1,0],["مُتَوَثِّبٍ مِن خَلفِهِ وَأَمامِهِ","مُتَأَلِّبٍ يَلقاهُ كُلَّ أَوانِ",48,"ن",1,0],["متواري الحسن في الغيم الكَثيف","يا فُؤادي أَينَ أَيام الهَوى",49,"ه",3,0],["مُتَوَقِّدينَ مِنَ الحَديدِ إِذا","ما صَرَموا بَأسَ العِدى نَكَصا",50,"ص",2,0],["مُتَوَقِّرينَ كَلامُهُم ما بَينَهُم","وَمُزَمزِمينَ خَفائُهُم مَفهومُ",51,"م",1,0],["مُتَوَرِّدُ الخَدَّينِ أَمّا مَسُّهُ","فَنَدٍ وَأَمّا قَلبُهُ فَمَتينُ",52,"ن",1,0],["مُتَوازِرونَ عَلى المَحامِدِ وَالنَدى","لا يَحسَبونَ غِنىً يُديمُ خُلودا",53,"د",2,0],["مُتَوَّجٌ بِالمَعالي فَوقَ مَفرِقِهِ","وَفي الوَغى ضَيغَمٌ في صورَةِ القَمَرِ",54,"ر",1,0],["مُتَوافِقينَ عَلى المَظالِمِ رُكِّبَت","فينا وَقارَبَ شَرَّنا أَزكانا",55,"ن",2,0],["متوخَّى الأمة مختلف","ولعل الرزء يوحده",56,"د",2,0],["متوسّداً شوكَ الطريق مُلَثَّماً","بجراحِهِ مثل الشهيد الطاهرِ",57,"ر",1,0],["مُتواضعاً مترفِّعاً ترقَى الذُّرى","في مثل صمتِ الكوكبِ الوقّادِ",58,"د",1,0],["متوحِّداً في غُرْبةٍ متوقِّداً","بصبابةٍ متفرِّداً بسقامِ",59,"م",1,0],["مُتَوَشِّحٌ بِالنَّيِّرَاتِ كَبَاسِلٍ","مِنْ نَسْلِ حَامٍ بِاللُّجَيْنِ مُدَرَّعِ",60,"ع",1,0],["مُتَوَخِّياً إِعْتَاقَ مِصْرَ كِلاَهُمَا","وَكِلاَهُمَا لأَخِيهِ خَيْرُ مُبَارِ",61,"ر",1,0],["مُتَوَرِّداً سِفْرَيْهِ أُسْ","قى الرَّاحَ فِي جَامٍ فجَامِ",62,"م",1,0],["مُتَوَخِّياً إِنْصَافَهُمْ وَمُهَيِّئاً","لَهُمُ وَلِلأَبْنَاءِ خَيْرَ مَآلِ",63,"ل",1,0],["مُتَوَخِّينَ بِالتَّشَاوُرِ إِصْلاحاً","لِمَا أَحْدَثَتْ يَدُ الإِفْسَاد",64,"د",1,0],["مُتَوَغَّلاً في الْغَمْرِ غَيْرَ مُحَاذِرٍ","يَحِدُ الرَّدَى أَمَماً وَلَيْسَ بِنَاكِبِ",65,"ب",1,0],["متواثبينِ كطائرَينِ تشابَكا","وتضاربَ المنقاد بالمنقادِ",66,"د",1,0],["مُتوَّجٌ من جُذام ماتَ له","ثلاثةٌ فليعِشْ له عَشَرَه",67,"ر",2,0],["مُتَوَثِّباً نحوَ المُحِيط كأنَّه","صَقْرُ الفلاةِ بِكفّة الصَّيّاد",68,"د",1,0],["متواضعٌ ما قام يُعل","نُ ذات يومٍ عن جَنَابه",69,"ب",2,0],["متوقِّدًا، مثلَ الشهاب ذكاؤهُ","متوثِّبًا، ما قال إلا أبرما",70,"م",2,0],["متواضع بين الجنو","د، يلين إذ يقسو القساة",71,"ا",2,0],["مُتَوَاضِع، وأقَلُّ ما يَ