{"poems":[[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115301","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28491","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202369",""],[4984,"الْعَهْدُ الْجَدِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=209104",""]],"verses":[["حتى أثار الدهر من حظها","فجاءها يسعى على مركبِ",0,"ب",1,0],["حتى اثنينا ونور الشمس يطرده","جنح من الليل في جيش من الظلم",1,"م",1,0],["حَتّى أَثيرَ عَلَيكَ مِنها فِتنَةً","تُنسيكَ يَومَ خَزانَةِ الصُّوفِيَّةِ",2,"ه",1,0],["حتى أثرنَ على العِراقِ عَجاجةً","بنتِ السنابكُ تربَها بجَنادلِ",3,"ل",1,0],["حتى أثير عجاجة","تدع النهار الجون أسفع",4,"ع",1,0],["حتى أثار الثائرين نوفمبر","ليزيل عن نزغ العقول خبالها",5,"ل",3,0]]}