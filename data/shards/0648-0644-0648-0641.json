{"poems":[[75,"في جواركم الذليل","https://www.aldiwan.net/poem11933.html","الوافر"],[29,"أرسم الحي إذ نزلوا الإيادا","https://www.aldiwan.net/poem5724.html","الوافر"],[29,"لقد سرني أن لا تعد مجاشع","https://www.aldiwan.net/poem5768.html","الطويل"],[29,"ألا أيها القلب الطروب المكلف","https://www.aldiwan.net/poem5922.html","الطويل"],[53,"أرى العصفور يعبث بالفخاخ","https://www.aldiwan.net/poem9440.html","الوافر"],[53,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[53,"مدحت أبا المغيرة ذات يوم","https://www.aldiwan.net/poem66051.html","الوافر"],[53,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[45,"نسيت وما أنسى عتابا على الصد","https://www.aldiwan.net/poem9558.html","الطويل"],[64,"لعمرك ما أغبك عن فتور","https://www.aldiwan.net/poem52324.html","الوافر"],[47,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[101,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[68,"لو عاينت مقلته دخنة","https://www.aldiwan.net/poem38602.html","السريع"],[83,"تبسم عن لما در نظيم","https://www.aldiwan.net/poem61310.html","البسيط"],[42,"تعدد نفسي من سليمى عدادها","https://www.aldiwan.net/poem42278.html","الطويل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[77,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[50,"أتشتم خير ذي حكم ابن سعد","https://www.aldiwan.net/poem62611.html","الوافر"],[52,"شهدت على الزيدي أن نساءه","https://www.aldiwan.net/poem62384.html","السريع"],[48,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29355","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55169","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[108,"دواوين","https://www.poetsgate.com/ViewPoem.aspx?id=179554",""],[92,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[92,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[53,"أرى العصفُورَ يعبثُ بالفِخَاخ","https://www.poetsgate.com/ViewPoem.aspx?id=27434",""],[131,"ألا قل لذى حمق تسربل بالغدر","https://www.aldiwan.net/poem50593.html","الطويل"],[146,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[146,"بنصرك يدرك الفتح المبين","https://www.aldiwan.net/poem11833.html","الوافر"],[163,"إلى كم تمادى في غرور وغفلة","https://www.aldiwan.net/poem59149.html","الطويل"],[169,"كالمشرفي إذا أغمدت في فرشي","https://www.aldiwan.net/poem46851.html","البسيط"],[192,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[202,"إِليك غصوني يا طيور الحقائق","https://www.aldiwan.net/poem45162.html","الطويل"],[214,"خطابك لا أسميه خطابا","https://www.aldiwan.net/poem46267.html","الوافر"],[214,"وما كانت الآداب إلا طرائفا","https://www.aldiwan.net/poem46293.html","الطويل"],[232,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[255,"أوجدي كذا أم هكذا كل من يهوى","https://www.aldiwan.net/poem1420.html",""],[264,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[273,"قضى الدهر أن أهواك غير ممتع","https://www.aldiwan.net/poem35621.html","الطويل"],[278,"عجبت لمن يستوثر الفرش مترفا","https://www.aldiwan.net/poem25388.html","الطويل"],[323,"أكذب طريفي فيك والطرف صادق","https://www.aldiwan.net/poem61752.html","الطويل"],[405,"ملكتم فؤادا ليس يدخله العذل","https://www.aldiwan.net/poem46985.html","الطويل"],[495,"يقابلنا البدر من برده","https://www.aldiwan.net/poem67382.html","المتقارب"],[517,"صحت بدولتك الأيام من سقم","https://www.aldiwan.net/poem12269.html","البسيط"],[553,"كم ذا تطيش سهام الموت مخطئة","https://www.aldiwan.net/poem47169.html","البسيط"],[553,"أقول لزيد كفكف الخيل عنوة","https://www.aldiwan.net/poem47178.html","الطويل"],[553,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[589,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["وَلَو فَقَدوكَ لا فَقَدوا حَواهُم","مَرادٌ مِن زَمانِهِمِ وَبيلُ",0,"ل",1,0],["وَلَو فَرَّجتَ قَصَّ مُجاشِعِيٍّ","لِتَنظُرَ ما وَجَدتَ لَهُ فُؤادا",1,"د",2,0],["وَلَو في رِياحٍ حَلَّ جارُ مُجاشِعٍ","لَما باتَ رَهناً لِلقَليبِ المُغَوَّرِ",2,"ر",1,0],["وَلَو في بَني سَعدٍ نَزَلتَ لَما عَصَت","عَوانِدُ في جَوفِ الحَوارِيِّ نُزَّفُ",3,"ف",1,0],["وَلَوْ في بيتِه نِيكَتْ جِهَاراً","لكان كأنه رَجُلٌ بِخَاخِ",4,"خ",1,0],["ولو في است التي ولدتك مني","هربت أتتك بائقةُ النشيدِ",5,"د",1,0],["ولو فَطِنوا لقالوا قد نَفَرْنا","لأنَّك قد رجَعْتَ وأنت سالمْ",6,"م",1,0],["ولو فَطنتُ لكان الذنبُ حينئذٍ","ذنْبين لا شك إلا عند من أفِنا",7,"ن",2,0],["وَلَو فارَقَت نَفسي إِلَيكَ حَياتَها","لَقُلتُ أَصابَت غَيرَ مَذمومَةِ العَهدِ",8,"د",1,0],["ولو فتشتَ عن مكنونِ سِرِّي","نظرتَ فلم تجدْ فيه سِواكا",9,"ك",2,0],["وَلَو فاتَني المَقدورُ مِمّا أَرومُهُ","بِسَعيٍ لَأَدرَكتُ الَّذي لَم يُقَدَّرِ",10,"ر",1,0],["ولو فتحتم شراييني بمديتكم","سمعتم في دمي أصوات من راحوا",11,"ح",3,0],["وَلو فَلاها بَعدَهُ ناقِدٌ","لَم يَرَ فيها أَثَرَ الكَسرِ",12,"ر",1,0],["ولَو فَجَر الحُمَيَّا من لَمَاهِ","لأسكَرتِ الحُمَيَّا بِالشَّمِيمِ",13,"م",1,0],["وَلَو فارَقَت جَوفي لَصادَفتُ راحَةً","وَلَكِنَّما في الجَوفِ مِنّي مُرادُها",14,"د",3,0],["وَلَو فَتَحَت أَبْوابَها لَتَبَادَرَتْ","مِنَ الدُّرِّ وِلدانٌ إلَيْهِ وحُورُ",15,"ر",1,0],["ولو فصل الله الحكومةَ فصلَه","لما اختلفت بالمشكلات الأقاول",16,"ل",1,0],["ولو فارَقَ البدرُ أفلاكَه","لَقَبّلَ بين يَديْكَ الثّرى",17,"ا",1,0],["وَلَو في غَيرِ مِصرَ سَبَبتَ ظِلّي","لَقُلتُ اِبنَ الخَبيثَةِ كُن رَمادا",18,"د",2,0],["وَلو فارَقوا ما فيهِمُ مِن دَعارَةٍ","لَما عَرَفَتهُم أُمُّهُم حينَ تَنظُرُ",19,"ر",1,0],["وَلَو فَرَيتَ أَديمي فَريَ مُلتَمِسٍ","نَفَعاً لَما آلَمَت نَفسي أَشافيكا",20,"ك",2,0],["ولو في بني الثرماء حلت تحدبوا","عليها بأرماح طوال الحدائد",21,"د",1,0],["وَلَوْ فدَاهُمْ مَا بِهَا أَرْخَصَتْ","دُونَهُمُ مِن عَيشِهَا مَا غلا",22,"ل",2,0],["وَلَو فَهِمت مَعنى الزَمانِ بهيمَةٌ","لَأَعرَضَ خَوفَ النَسلِ عَن شاتِنا الكَبشُ",23,"ش",1,0],["ولو فتشوا عما حوته جيوبُهُ","لما اغترَّ مغترٌّ بتلك المناصب",24,"ب",1,0],["ولو فتّشوا قلبي رأوا في صميمه","خلاصةَ هذا العالمِ المتألِّم",25,"م",1,0],["ولو فتَّشوا منه السَّبالينِ شاهدوا","خلالَهما العاهاتِ محشورةً حشرا",26,"ر",2,0],["وَلَوْ في بيتِه...جِهَاراً","لكان كأنه رَجُلٌ بِخَاخِ",27,"خ",1,0],["ولو فكروا في أمرهم لتدبَّرُوا","ولكنهم حَمْقَى تعَاموا عن الفِكرِ",28,"ر",1,0],["وَلَو فُرِّقَت هَذي العَزائِمُ في الوَرى","إِذاً عَطَّلوا ما يَطبَعُ الهِندُ وَالهِندا",29,"د",2,0],["وَلَو في غَيرِ بَحرِكَ غُصتُ عاماً","لَأَعوَزَ فيهِ ذا الدُرُّ الثَمينُ",30,"ن",1,0],["ولو فعل الأعدا بنفسك بعض ما","فعلت لمستهم بها بعض رحمة",31,"ه",1,0],["ولو فَشا خبرٌ ممّا مُنيتُ بِهِ","بأرضِ خيبرَ ظَلتْ منهُ في مِحَنِ",32,"ن",1,0],["وَلَو فَعلوا هذا لما كانَ كافياً","إِذا لَم يكُ الرحمنُ في دينِهم وِترا",33,"ر",2,0],["وَلَو فَعَلوا هَذا وذاكَ لَما نجَوا","إِذا لَم يَدينوا دينَ ملّتنا الغرّا",33,"ر",2,0],["وَلو فارَقتني لَحظةً ذبتُ حسرةً","وَلَم أُلف في وُسعي على بُعدِها صَبرا",33,"ر",2,0],["ولو فتحت فاها الملائكُ عندها","لكانت رأَت فيهِ جريمة سارقِ",34,"ق",1,0],["ولو في غير دهري كان عيشى","لما عانيت أتعاب الديون",35,"ن",1,0],["ولو فقه النيل المبارك كنهها","لحول ذيّاك المزيج إلى خمر",36,"ر",1,0],["ولو فاخرتْك جميعُ الملوكِ","لكانوا الظلامَ وكنتَ السّنا",37,"ا",1,0],["وَلَو فَضَّه عِبدُ الحَميد لردَّهُ","يَذُمُّ الَّذي قَد كانَ سَدَّد أَو سَوّى",38,"و",2,0],["ولو فدنا العرض المذل","وعندنا العرض المصون",39,"ن",1,0],["ولو فزتُ قبلَ الموتِ منكَ بنظرةٍ","لكانت عزاءً لي على غيرِ مقنع",40,"ع",1,0],["ولو فكّر المغرور في بطشة الردى","لكفّ يدا معتادة العدو والبطش",41,"ش",1,0],["وَلَو فَرَّقتَ أَجزاءَ حُبّي عَلى الوَرى","فَأَيسِرهُ يَجزي وَأَدناهُ مَقنَعُ",42,"ع",1,0],["ولَو في سواكم أهلَ بيت محمدٍ","غرامي لكَانَ العَدْلُ عندي هو الْعَدْلُ",43,"ل",1,0],["وَلَو فَخرَ المَجدُ لَم تَلقَهُ","فَخوراً بِشَىءٍ سِوى مَجدِهِ",44,"ه",1,0],["ولو فتحت فمي يوماً بذمهم","لم يرض فضلك إلا أن يسد فمي",45,"م",2,0],["ولو فطنْتُ وقد أردَى الزّمانُ فتىً","عَلِمتُ أنّ الّذي أصماه أصماني",46,"ن",2,0],["ولو فهموا عنّا مَقالَ سيوفنا","لعلّمَهمْ فحواه أنْ يقرعوا سِنّا",47,"ن",2,0],["وَلَو فَطنَ الناسُ كنتَ السّوا","دَ مِن كلِّ طرفٍ مَكان المُقا",48,"ا",1,0],["ولو فرقت إذا هي لم تكن","على سنة المعصوم أفضل فاضل",49,"ل",1,0]]}