"الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100185","الطويل"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139075",""],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28857","الطويل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127826","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202343","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40162","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69949","الوافر"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101356","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94798","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94787","الطويل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123457","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18830","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35451","الوافر"],[408,"ملكتم فؤادا ليس يدخله العذل","https://www.poetsgate.com/ViewPoem.aspx?id=6981",""],[4767,"خير الناس","https://www.poetsgate.com/ViewPoem.aspx?id=179651",""],[4862,"عجوز في التلوي كالأفاعي","https://www.poetsgate.com/ViewPoem.aspx?id=55622",""],[5038,"أنا أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=195430",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5061,"انين الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=147428",""],[585,"إني عييت بمخلوقٍ عجبت له","https://www.poetsgate.com/ViewPoem.aspx?id=161974",""],[5205,"أما وإشراق وحبه منك بدري","https://www.poetsgate.com/ViewPoem.aspx?id=120989",""],[5264,"سلام","https://www.poetsgate.com/ViewPoem.aspx?id=181728",""],[5288,"أنا ماني بلعبه","https://www.poetsgate.com/ViewPoem.aspx?id=1191",""],[5582,"أَمُوسِعَةً بِمُهْجَتِيَ الصُّدُوعا","https://www.poetsgate.com/ViewPoem.aspx?id=187177",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5587,"أيا سهرتي","https://www.poetsgate.com/ViewPoem.aspx?id=198718",""],[5596,"الى الشيخ الصوّافي","https://www.poetsgate.com/ViewPoem.aspx?id=206689",""],[5606,"تذكرني وطالع لروحك فالمرايه","https://www.poetsgate.com/ViewPoem.aspx?id=194354",""],[5653,"لقد سَامَني هُوناً وَخَسْفاً هوَاكُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=26393",""],[5764,"مولاي","https://www.poetsgate.com/ViewPoem.aspx?id=176472",""],[5792,"يحبونه","https://www.poetsgate.com/ViewPoem.aspx?id=180355",""],[5939,"الرجل الحديدي","https://www.poetsgate.com/ViewPoem.aspx?id=188441",""]],"verses":[["وَلَو فَقَدوكَ لا فَقَدوا حَواهُم","مَرادٌ مِن زَمانِهِمِ وَبيلُ",0,"ل",1,0],["وَلَو فَرَّجتَ قَصَّ مُجاشِعِيٍّ","لِتَنظُرَ ما وَجَدتَ لَهُ فُؤادا",1,"د",2,0],["وَلَو في رِياحٍ حَلَّ جارُ مُجاشِعٍ","لَما باتَ رَهناً لِلقَليبِ المُغَوَّرِ",2,"ر",1,0],["وَلَو في بَني سَعدٍ نَزَلتَ لَما عَصَت","عَوانِدُ في جَوفِ الحَوارِيِّ نُزَّفُ",3,"ف",1,0],["وَلَوْ في بيتِه نِيكَتْ جِهَاراً","لكان كأنه رَجُلٌ بِخَاخِ",4,"خ",1,0],["ولو في است التي ولدتك مني","هربت أتتك بائقةُ النشيدِ",5,"د",1,0],["ولو فَطِنوا لقالوا قد نَفَرْنا","لأنَّك قد رجَعْتَ وأنت سالمْ",6,"م",1,0],["ولو فَطنتُ لكان الذنبُ حينئذٍ","ذنْبين لا شك إلا عند من أفِنا",7,"ن",2,0],["وَلَو فارَقَت نَفسي إِلَيكَ حَياتَها","لَقُلتُ أَصابَت غَيرَ مَذمومَةِ العَهدِ",8,"د",1,0],["ولو فتشتَ عن مكنونِ سِرِّي","نظرتَ فلم تجدْ فيه سِواكا",9,"ك",2,0],["وَلَو فاتَني المَقدورُ مِمّا أَرومُهُ","بِسَعيٍ لَأَدرَكتُ الَّذي لَم يُقَدَّرِ",10,"ر",1,0],["ولو فتحتم شراييني بمديتكم","سمعتم في دمي أصوات من راحوا",11,"ح",3,0],["وَلو فَلاها بَعدَهُ ناقِدٌ","لَم يَرَ فيها أَثَرَ الكَسرِ",12,"ر",1,0],["ولَو فَجَر الحُمَيَّا من لَمَاهِ","لأسكَرتِ الحُمَيَّا بِالشَّمِيمِ",13,"م",1,0],["وَلَو فارَقَت جَوفي لَصادَفتُ راحَةً","وَلَكِنَّما في الجَوفِ مِنّي مُرادُها",14,"د",3,0],["وَلَو فَتَحَت أَبْوابَها لَتَبَادَرَتْ","مِنَ الدُّرِّ وِلدانٌ إلَيْهِ وحُورُ",15,"ر",1,0],["ولو فصل الله الحكومةَ فصلَه","لما اختلفت بالمشكلات الأقاول",16,"ل",1,0],["ولو فارَقَ البدرُ أفلاكَه","لَقَبّلَ بين يَديْكَ الثّرى",17,"ا",1,0],["وَلَو في غَيرِ مِصرَ سَبَبتَ ظِلّي","لَقُلتُ اِبنَ الخَبيثَةِ كُن رَمادا",18,"د",2,0],["وَلو فارَقوا ما فيهِمُ مِن دَعارَةٍ","لَما عَرَفَتهُم أُمُّهُم حينَ تَنظُرُ",19,"ر",1,0],["وَلَو فَرَيتَ أَديمي فَريَ مُلتَمِسٍ","نَفَعاً لَما آلَمَت نَفسي أَشافيكا",20,"ك",2,0],["ولو في بني الثرماء حلت تحدبوا","عليها بأرماح طوال الحدائد",21,"د",1,0],["وَلَوْ فدَاهُمْ مَا بِهَا أَرْخَصَتْ","دُونَهُمُ مِن عَيشِهَا مَا غلا",22,"ل",2,0],["وَلَو فَهِمت مَعنى الزَمانِ بهيمَةٌ","لَأَعرَضَ خَوفَ النَسلِ عَن شاتِنا الكَبشُ",23,"ش",1,0],["ولو فتشوا عما حوته جيوبُهُ","لما اغترَّ مغترٌّ بتلك المناصب",24,"ب",1,0],["ولو فاز أي بموهوبة","فأم القضاء له والده",25,"د",2,0],["ولو فرضنا انحصار العلم في بشر","وقصده غير وجه الله ما نفعا",26,"ع",2,0],["ولو فكرت في أصلها ومصيره","لدافع داء الكبر منها التواضع",27,"ع",1,0],["ولو فتّشوا قلبي رأوا في صميمه","خلاصةَ هذا العالمِ المتألِّم",28,"م",1,0],["ولو فتَّشوا منه السَّبالينِ شاهدوا","خلالَهما العاهاتِ محشورةً حشرا",29,"ر",2,0],["وَلَوْ في بيتِه...جِهَاراً","لكان كأنه رَجُلٌ بِخَاخِ",30,"خ",1,0],["ولو فوديت نفس فديناك طيبة ً","ولكنها الاجال تمضي الى البلى",31,"ل",2,0],["ولو فكروا في أمرهم لتدبَّرُوا","ولكنهم حَمْقَى تعَاموا عن الفِكرِ",32,"ر",1,0],["وَلَو فُرِّقَت هَذي العَزائِمُ في الوَرى","إِذاً عَطَّلوا ما يَطبَعُ الهِندُ وَالهِندا",33,"د",2,0],["وَلَو في غَيرِ بَحرِكَ غُصتُ عاماً","لَأَعوَزَ فيهِ ذا الدُرُّ الثَمينُ",34,"ن",1,0],["ولو فعل الأعدا بنفسك بعض ما","فعلت لمستهم بها بعض رحمة",35,"ه",1,0],["ولو فَشا خبرٌ ممّا مُنيتُ بِهِ","بأرضِ خيبرَ ظَلتْ منهُ في مِحَنِ",36,"ن",1,0],["وَلَو فَعلوا هذا لما كانَ كافياً","إِذا لَم يكُ الرحمنُ في دينِهم وِترا",37,"ر",2,0],["وَلَو فَعَلوا هَذا وذاكَ لَما نجَوا","إِذا لَم يَدينوا دينَ ملّتنا الغرّا",37,"ر",2,0],["وَلو فارَقتني لَحظةً ذبتُ حسرةً","وَلَم أُلف في وُسعي على بُعدِها صَبرا",37,"ر",2,0],["ولو فتحت فاها الملائكُ عندها","لكانت رأَت فيهِ جريمة سارقِ",38,"ق",1,0],["ولو في غير دهري كان عيشى","لما عانيت أتعاب الديون",39,"ن",1,0],["ولو فقه النيل المبارك كنهها","لحول ذيّاك المزيج إلى خمر",40,"ر",1,0],["ولو فاخرتْك جميعُ الملوكِ","لكانوا الظلامَ وكنتَ السّنا",41,"ا",1,0],["وَلَو فَضَّه عِبدُ الحَميد لردَّهُ","يَذُمُّ الَّذي قَد كانَ سَدَّد أَو سَوّى",42,"و",2,0],["ولو فدنا العرض المذل","وعندنا العرض المصون",43,"ن",1,0],["ولو فزتُ قبلَ الموتِ منكَ بنظرةٍ","لكانت عزاءً لي على غيرِ مقنع",44,"ع",1,0],["ولو فكّر المغرور في بطشة الردى","لكفّ يدا معتادة العدو والبطش",45,"ش",1,0],["وَلَو فَرَّقتَ أَجزاءَ حُبّي عَلى الوَرى","فَأَيسِرهُ يَجزي وَأَدناهُ مَقنَعُ",46,"ع",1,0],["ولَو في سواكم أهلَ بيت محمدٍ","غرامي لكَانَ العَدْلُ عندي هو الْعَدْلُ",47,"ل",1,0],["وَلَو فَخرَ المَجدُ لَم تَلقَهُ","فَخوراً بِشَىءٍ سِوى مَجدِهِ",48,"ه",1,0],["ولو فتحت فمي يوماً بذمهم","لم يرض فضلك إلا أن يسد فمي",49,"م",2,0],["ولو فطنْتُ وقد أردَى الزّمانُ فتىً","عَلِمتُ أنّ الّذي أصماه أصماني",50,"ن",2,0],["ولو فهموا عنّا مَقالَ سيوفنا","لعلّمَهمْ فحواه أنْ يقرعوا سِنّا",51,"ن",2,0],["وَلَو فَطنَ الناسُ كنتَ السّوا","دَ مِن كلِّ طرفٍ مَكان المُقا",52,"ا",1,0],["ولو فرقت إذا هي لم تكن","على سنة المعصوم أفضل فاضل",53,"ل",1,0],["ولو فَخُرت نزارُ على سِواها","بِفَخرِ محمَّدٍ ما ظَلَّ ثارا",54,"ر",2,0],["ولو في الحِدادِ البِيْضِ حِدَّةُ ذِهْنِهِ","لَمَا صَاغَ داودُ الدِّلاَصَ المُسَرَّدَا",55,"د",2,0],["ولو فنيتُ وقالوا","دعِ الهوى وتولّى",56,"ل",2,0],["وَلَو فَنيت وَقالوا","خافَ الهَوى فَتَولّى",57,"ل",2,0],["وَلَو فَوقَ الأَميرِ تَكونُ فيها","سُمُوّاً وَاِفتِخاراً كُنتَ أَنتا",58,"ت",2,0],["ولو فرقوا بين الضلالة والهدى","لما قبلوا إلا اناملك العشرا",59,"ر",2,0],["ولو فاز رأي بموهوبة","فأم القضاء له والده",60,"د",2,0],["ولوفدهم من رِفدهم","في وجدهم ديمٌ غزائِرْ",61,"ر",1,0],["وَلَوْ فَاضَ حِسًّا كَمَا فَاضَ مَعْنىً","نَدَاهُ لَفَاقَ الْبِحَارَ انْفِجَارَا",62,"ر",2,0],["وَلَو فَقَدَتكَ قيسٌ يا فَتاها","إِذاً لَتَضَعضَعَت مِنها المُتونُ",63,"ن",1,0],["ولو فتحت فاهاً ومصت حبابه","لطاب وأضحت لا تلام ولا تلحى",64,"ح",2,0],["ولو في المسلمين اليوم حر","يفك الامر او يحصى الذمارا",65,"ر",2,0],["وَلَو فَقَدَت رَضوى الذين فَقَدتُهُم","أراحَ تداعيها أُناساً من الظِّنَن",66,"ن",1,0],["ولو فتحت قلوب العرب قاطبة","فالحب حبك فيه قد سما شانا",67,"ن",2,0],["ولو فاتني وفد ذاك النس","يم لأفنيت ترب ثراه التثاما",68,"م",2,0],["وَلَو في قَلبه القاسي اِتقينا","لَأَمكَن أَن يَكُون لَنا وقاءا",69,"ا",3,0],["وَلَو فرَّ بابيٌّ مَدى العُمر هارِباً","لَقالَت لَهُ أَقلامهم خَلفك القَتل",70,"ل",1,0],["ولو في ذاك حاولت ازدياداً","إذاً ما اسطعت فيه على ازدياد",71,"د",1,0],["ولو فنيت رعوناتي وحظي","لعدمت رويتي عن شرح حالي",72,"ل",2,0],["ولو فلجوا ثم اعترفت بفلجهم","لعدت وعادوا في العهود الوثائق",73,"ق",1,0],["ولو فكروا بعقول لهم","ولم يقفوا فكرهم عند حدْ",74,"د",1,0],["ولو في الجبال الشّمّ أنفذ عزمهُ","لعادت جبالُ الأرض من عزمه جُرزا",75,"ز",2,0],["وَلَوْ فُزْتَ مِنْ ذَاكَ الجَمْالِ بِنَظْرَةٍ","لأَصْبَحَ مِنْكَ العَقْلُ يُسْبىَ وَيُسْلَبُ",76,"ب",1,0],["ولو في الكرى مر النسيم بطيفها","سرى أبداً من طيفها وهو عاطر",77,"ر",1,0],["ولو في ملكه ما لم يُرده","لكان لنعت عزته انتقالا",78,"ل",2,0],["وَلَو فارَقتْ رِجلي القُيودَ وَجدتُني","رَفيقاً بِنَصِّ العيسِ في البَلَدِ القَفْرِ",79,"ر",1,0],["ولوفده قول المؤرخ قد بدا","سلِمَ سليمُ ودُم بعيشك راضيا",80,"ي",2,0],["ولو فعلت به ما ظل يفعله","سيف المتوّج من قحطان في القمم",81,"م",1,0],["وَلَو فَدَتْ أَرضٌ سَماءً ساقَتِ ال","مُلوكَ في فِدائِكَ الأَمصارُ",82,"ر",1,0],["ولو فريام أدى تق","ل جسمك عسجداً صرفا",83,"ف",2,0],["وَلَو في برجِ بابل كانَ يَوماً","لخاطب كل مَجموع الرِجالِ",84,"ل",1,0],["وَلَو فَرَضنَا مِنهُمُ إيقَاعَه","لانقَلَبُ المُنهِىُّ عَينَ الطَّاعَه",85,"ه",1,0],["ولو فاضت بدجلة بنت كرم","لقلت لدجلة بحشاي غيضي",86,"ض",2,0],["ولو فاخرت كل العباد بحسنها","لقرّوا وكلٌّ قال أنتِ مليكتي",87,"ي",1,0],["ولو فُدِّيَت بالمال والروح والنُهى","ووافى إليَّ بالقبول بشيرُ",88,"ر",1,0],["ولو فزتما بالوصلِ يوما لجئِتما","بأخبثَ مِن نسلِ اللعينِ وألأم",89,"م",1,0],["وَلَو فَقِهَت ما يَفقَهُ الناسُ أَصبَحَت","خَواشِعَ أَعلامُ الفَلاةِ وَعينُها",90,"ن",3,0],["وَلَو فَهِموا دَقائِقَ حُبِّ لَيلى","كَفاهُم في صَبابَتِهِ اِختِبارا",91,"ر",2,0],["ولو في سواكم أهل بيت محمد","غرامي لكان العذل عندي هو العدل",92,"ل",1,0],["ولو فَتَّشتَ في التاريخِ حيناً","وجدتَ السوءَ في عُمقِ الجذورِ",93,"ر",1,0],["ولو فكرت أن تصغي إليها","ستبقى طول عمرك في اكتئابِ",94,"ب",1,0],["ولو فكّرْتُ يوماً فيك طيفاً","أُراوِدُهُ لقلْتَ إليكَ عنّي",95,"ن",2,0],["ولو في الملأ رمت الملاء حللت في","رجاه إذا ما صح منك رجاء",96,"ا",2,0],["ولو فرحتي لعيونه اليوم زاحت","ليته يعود ايام بس ويروحي",97,"ح",2,0],["ولو فهمت من الصرصور قصته","لقلت جاء من الصرصور منبثقا",98,"ق",2,0],["ولو فشا بين أرباب النهي خبري","ولوعني بقياس أو سماعي",99,"ي",1,0],["ولو ف بعدك نتوجع","نسأل عليك احمد حسين",100,"ن",1,0],["ولو في البعد أنا بشقى محال انك بتلقيني","اجي أترجى لغفرانك .. أقول لك آسف وحاضر",101,"ر",1,0],["وَلَوْ فِي غَيْرِها أَسْرِي لأَضْحَى","أَبُو العَرَبِ بنُ سُلطانٍ شَفِيعا",102,"ع",2,0],["وَلَوْ فِي السَّما مَسْكَنٌ لامْرِئٍ","لَخُوِّلْتَ أَعْلَى السَّماواتِ دارا",103,"ر",2,0],["وَ لَوْ فَارَقَتْ نَفْسِي المَنَامَ فَإِنَّنِي","وَجَدْتُ بِهَا رُؤْيَاكَ فِي القُرْبِ وَ البُعْدِ",104,"د",1,0],["18- ولو فطنت لما جهلت بعلمٍ","بأن الفضل كل الفضل علم",105,"م",1,0],["ولو في يوم حنيت للي بيننا فات","تذكرني وطالع لروحك فالمرايه",106,"ا",3,0],["ولو في الحداد حده ذهنه","لما صاغ داود الدلاص المسردا",107,"د",2,0],["ولو فعلاً اني ببتعد .. ماذكرتك !","ولا نطقت اسمك بصمتي ودعواي",108,"ا",2,0],["ولو فكرت اغيب عنك لحظه","اشوف الكون يسعى في عنادي",109,"د",2,0],["ولو في وجنتيكِ جرَتْ دمائي","ستزدهرانِ في خجلٍ شديدِ",110,"د",1,0]]}