em332.html",""],[68,"ما جئت مني أبغي قرى كالضيف","https://www.aldiwan.net/poem1511.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42659","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42556","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54531","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54940","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54896","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54585","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2241","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[95,"النسر","https://www.poetsgate.com/ViewPoem.aspx?id=706",""],[106,"ذكرى فنان!","https://www.poetsgate.com/ViewPoem.aspx?id=179489",""],[106,"وحي العيد","https://www.poetsgate.com/ViewPoem.aspx?id=179512",""],[19,"يا عينُ جودي على عمرو بنِ مسعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=13189",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"تنويمة الجياع","https://www.poetsgate.com/ViewPoem.aspx?id=647",""],[45,"أطنبت في اللوم فلا تكثري","https://www.poetsgate.com/ViewPoem.aspx?id=31204",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""]],"verses":[["وَالوارِداتُ مِياهَ القاعِ سانِحَةٌ","عَلى جَوانِبِها الحَوذانُ وَالنَفَلُ",0,"ل",1,0],["وَالوَجدُ يَغصِبُني قَلباً أَضَنُّ بِهِ","وَالدَمعُ يَمنَعُ عَيني لَذَّةَ النَظَرِ",1,"ر",1,0],["وَأَلوى بِجِدَّةِ أَيّامِهِ","فَأَصبَحَ مَقذىً لِعَينِ الكَعابِ",2,"ب",1,0],["وَالوَرْدَ مِنْ وَجْنَتِهِ أَجْتَني","وَالرّاحَ مِنْ رِيقَتِهِ أَرْتَشِفْ",3,"ف",1,0],["وَأَلْويَةُ الصُّبْحِ مُذْ فُصِمَتْ","عُرا اللَّيْلِ مُنْتَشِراتُ العَذَبْ",4,"ب",1,0],["وألْوي إِلى الأترِ جيدي فلا الندى","قَليلٌ ولا أمُّ الوَفاءِ عَقيمُ",5,"م",1,0],["وألْوى بمَنْ جاراهُ حتى كأنّهُ","مُعنّىً يُداني خَطْوَهُ في إسارِهِ",6,"ر",2,0],["وألْوي إليكِ الجِيدَ حتى كأنني","لفَرْطِ التِفاتي نَحو يَبْرينَ أَصْوَرُ",7,"ر",1,0],["والوائِليّونَ يَسْري في عُيونِهِمُ","كَرًى هوَ الغُنْجُ في لَحْظِ الرّعابيبِ",8,"ب",1,0],["وألْوي عِنانَ الطّرْفِ عنهُ إذا دَعا","سِوايَ إِلى الرِّيِّ الذّليلِ أُوامُهُ",9,"م",2,0],["وَالْوَعْدُ حَقٌّ وَالْوَرَى فِي غفْلَةٍ","قَدْ خُودِعُوا بِعَاجِلٍ وَضُلِّلُوا",10,"ل",3,0],["وَالْوَاصلُونَ هُمُ الْقَلِيلُ وَكَيْفَ لاَ","قَفرٌ وَمَسْبَغَةٌ وَلَيْلٌ أَلْيَلُ",11,"ل",1,0],["والوقت فيه لِلْقَبُولِ مَظِنَّةٌ","وَبِسَاطُ حَالِ الوَقْتِ عَنْهُ يُعْرِبُ",12,"ب",1,0],["وَالوَجهُ يُشرُقُ في الظَلامِ كَأَنَّهُ","بَدرٌ مُنيرٌ وَالنِساءُ نُجومُ",13,"م",1,0],["وَأَلواحَ رَهبٍ كَأَنَّ النُسو","عَ أَبَنَّ في الدَفِّ مِنها سِطارا",14,"ر",2,0],["وَأَلوَت بِكَفٍّ في سِوارٍ يَزينُها","بَنانٌ كَهُدّابِ الدِمَقسِ المُفَتَّلِ",15,"ل",1,0],["وَالوَردُ وَالرَيحانُ في","ذاكَ النَهارِ سِلاحُهُنَّه",16,"ن",2,0],["وَالوَحشُ تَبكي شَجوَها","لَمّا أَتى عَنهُ الخَبَر",17,"ر",1,0],["والوجود دولته","أرضنا بها عمل",18,"ل",1,0],["وَالوَافِدِينَ إِليَّ مِنْ أَوْطَانِهِمْ","يُولُونَنِي فَضْلاً بِذَاكَ عُظَامَا",19,"م",2,0],["وَالوَقْتُ تَمْلِكُهُ فَأَنْتَ بِفَضْلِهِ","مُثْرٍ وَتَتْرُكُهُ فَأَنْتَ عَدِيمُ",20,"م",1,0],["وَالوَدقُ يَستَنُّ عَن أَعلى طَريقَتِهِ","حَولَ الجُمانِ جَرى في سِلكِهِ الثُقَبُ",21,"ب",1,0],["والوقت للفرح ما صلح","والحسن هو اوفبه ظهر",22,"ر",1,0],["والورق الخضر عن كلكل","والزهر في عطفها حلل",22,"ل",1,0],["والورد فاح وتعطّار","على الغنا والمزمار",23,"ر",1,0],["والوجود كل كصفحا","بقلام القدر يمشق",24,"ق",1,0],["والوجه أن كان الحياء نقابه","أغنى فتاة الحيّ أن تتنَقّبا",25,"ب",2,0],["والوجه أعجب ما رأيت وإنه","لَيَحارُ في سحنائه المتوسّم",26,"م",1,0],["وآلوا الأمور واحناءَها","فلم يُبْهِلوها ولم يُهْمِلوا",27,"ل",3,1],["والوُلاَةِ الكُفَاةِ للأَمر ان طَرَّ","ق يَتناً بِمُجهَضٍ أو تَمَامِ",28,"م",1,0],["والوَصِيُّ الذي أمَالَ التَّجُو","بِيُّ بِهِ عَرشَ أُمَّةٍ لانهِدَامِ",28,"م",1,0],["والوَصِيُّ الوَلِيُّ والفارِسُ المُع","لِمُ تَحتض العَجَاجِ غَيرُ الكَهامِ",28,"م",1,0],["والوَحشُ بَعدَ الأنِيسِ قَاطِنَةٌ","لِكُلِّ دَارٍ من أهلِهَا عُقَبُ",29,"ب",1,0],["والوَازِعُونَ المُقرِبُونَ من ال","أمرِ وأهلُ الشِغَابِ أن شُغِبُوا",29,"ب",3,0],["والوحش بعد الانيس قاطنه","لكل دار اهلها عقب",30,"ب",1,0],["وَأَلومُ عادِيَةَ الفِرا","قِ وَبَينَ أَحشائي أَلَم",31,"م",1,0],["وَالوَحشُ في أَرجائِهِ تُسابِقُه","كَأَنَّها مُجفَلَةٌ وَسائِقُه",32,"ق",2,0],["وَالواهِبُ البازِلُ يَوماً إِذا","ما ضاقَ بِالعُرفِ صُدورُ اللِئام",33,"م",1,0],["والوصف ملتمع النجوم يجل أن","يحصى وإن شئت الحديث فألمع",34,"ع",1,0],["والواضح الفضل الذي لم يلق في","علياه لا لبساً ولا تشكيكا",35,"ك",2,0],["والواضحين وفي البدورِ تكلّف","والثابتين وفي الحيا تبديل",36,"ل",1,0],["والوقت أغيد في أعطافِه ميد","والعز أصيد في عرنينه شمم",37,"م",1,0],["والوجه ريَّان من ماءيْ حياً وضياً","حتَّى يكاد على الأعطاف ينسجم",37,"م",1,0],["والوارث الفضل ممنوعٌ لسؤدده","مع العلوّ على السادات رجحان",38,"ن",1,0],["والوَشيجُ الخَطِّيُّ وهو رِشاءُ ال","موتِ يومَ الزلزال والبأساءِ",39,"ا",2,0],["والورد لو فتشت فردٌ في اسمه","ما في الملاح له سميٌّ واحدُ",40,"د",1,0],["والورد أصبح في الروائح عبدَه","والنرجس النِّيليُّ خادمُ عبدِهِ",41,"د",2,0],["والوجه بَرٌّ بغير ماءٍ","والطِيز بحر بلا جزيرَه",42,"ر",2,0],["والوارثُ المجدَ الطويلَ مِقْيَسا","والباعَ والعِزَّ التَّليدَ الأقعسا",43,"س",2,0],["والودُّ حقٌ ما رأيتُ أداءَهُ","مُتَيَسِّراً لمطالبٍ بتقاضي",44,"ض",2,0],["والوعاءُ الذي وَعَى الوفْرَ والذَّمْ","مَ خليطين فارغٌ مشحونُهْ",45,"ن",2,0],["والوزير الحق إن لم تنصفوا","لتُصكنَّ شكاتي أُذُنَه",46,"ن",2,0],["وَالوَردُ يَردي بِعُصمٍ في شَريدِهِمِ","كَأَنَّهُ لاحِبٌ يَسعى بِمِئجارِ",47,"ر",1,0],["وَأَلومُ نَفسي قَبلَهُ إِن أَخطَأَت","وَإِذا أَساءَ إِلَيَّ لَم أَتَعَتَّبِ",48,"ب",1,0],["وَالوَردُ عَلى الخُدودِ غَضٌّ","وَالنَرجِسُ في العُيونِ ذابِل",49,"ل",1,0],["وَأَلوفٌ فَلَو أُفارِقُ بُؤساً","لَتَوالَت لِفَقدِهِ حَسَراتي",50,"ي",1,0],["وَالواضِحِ الغُرِّ مَصقولٍ عَوارِضُهُ","وَالفاحِمِ الرَجِلِ المُستَورِدِ الداجي",51,"ج",2,0],["والوُجُودُ العظيم أُقْعِدَ في الما","ضي وما أَنْتَ رَبُّهُ فَتُقِيمُهْ",52,"م",2,0],["والوردةِ البيضاءِ تَعْبُقُ","في غيابَاتِ الأَصيلْ",53,"ل",1,0],["والوُجودُ الرحيبُ كالقَبْرِ لولا","مَا تُجَلِّينَ من قُطوبِ الوُجودِ",54,"د",1,0],["والوُرودُ العِذابُ في ضفّة الجَدول","شَوْكٌ مُصَفَّحٌ بالحديدِ",54,"د",1,0],["والوم من مردوا فلم","يبغوا عن السفه اجتنابا",55,"ب",2,0],["والورد للصيداح بعد","الوعد منه يماطل",56,"ل",1,0],["والورد من جذب النسيم تشققت","منه الجبوب الخضر والاردان",57,"ن",1,0],["وَالوَحيُ يَقطُرُ سَلسَلاً مِن سَلسَلٍ","وَاللَوحُ وَالقَلَمُ البَديعُ رُواءُ",58,"ا",2,0],["وَالوَحشُ تَنفُرُ في السُهو","لِ وَتارَةً تَثِبُ الحُزون",59,"ن",1,0],["وَالوَجدُ يَقوى كَما تَقوى النَوى أَبَداً","وَالصَبرُ يَنحَلُ في جِسمي كَما نَحِلا",60,"ل",2,0],["وَالوَجهُ أَزهَرُ وَالفُؤادُ مُشَيَّعٌ","وَالرُمحُ أَسمَرُ وَالحُسامُ مَصَمِّمُ",61,"م",1,0],["والوَدْقُ منها فِضَّةٌ","بيضاءُ والبَرْقُ ذَهَبْ",62,"ب",1,0],["وَالوَعدُ فيهِ مِنكَ لي مُتَقَدِّمٌ","فَاِمنُن عَلَيَّ بِأَن تُخِفَّ أَدائي",63,"ي",1,0],["وَالوَعدُ كَالوَرَقِ النَضيرِ تَأَوَّدَت","فيهِ الغُصونُ وَنُجحُها أَن يُثمِرا",64,"ر",2,0],["وَالوَجهُ مِنها حينَ أَبصَرتُهُ","يَكِلُّ عَنهُ الوَصفُ فَاِستَبصِرِ",65,"ر",1,0],["والوِرْدُ نوعانِ من عَفْوٍ ومن نِعَمٍ","والوَفدُ ضَربانِ من عُرْبٍ ومن عَجَمِ",66,"م",1,0],["والوجوهَ الرِّقاقَ داميةَ الأَبْ","شَارِ في مَعْرَكِ الوُجوهِ الصِّفاقِ",67,"ق",1,0],["وَالوَردُ في أَعلى الغُصونِ كَأَنَّهُ","مَلِكٌ تَحُفُّ بِهِ سَراةُ جُنودِهِ",68,"د",2,0],["وَالوُرقُ مِن فَوقِ الغُصونِ قَد حَكَت","بِشَدوِها المُطرِبَ صَوتَ مَعبَدِ",69,"د",1,0],["وَالوَحشُ تُعلِنُ أَنَّها مِن رَهطِهِ","وَالطَيرُ تَدعو أَنَّها مِن وَفدِهِ",70,"د",2,0],["والوعود التي وعدتِ فؤادي","لا أراني أعيش حتى تؤدى",71,"د",2,0],["والوَاصِفونَ عُلاكَ مِنّا قَرِّبوا","ما تَرجَموا لِلنَّاسِ عَنهُ وعَبَّروا",72,"ر",3,0],["وَالواهِبَ الصَمّامَةَ السَيفَ الَّذي","يَجري زُعافُ المَوتِ في إِسطامِهِ",73,"م",2,0],["وَالوَقتُ بَسّامٌ يُخَبِّرُ أَنَّهُ","مِن خَيرِ عُضوٍ في الزَمانِ وَمَفصِلِ",74,"ل",1,0],["والولاياتُ وإنْ طابتْ لمَنْ","ذاقَها فالسمُّ في ذاكَ العسلْ",75,"ل",1,0],["والواحمينَ ومن دمائِكِ","يرتوي شَرَهُ الوِحَامِ",76,"م",1,0],["والوَعْيُ سَيْفٌ يُبْتَلَى","يومَ التَّقَارُعِ ﺑﭑنْثِلامِ",76,"م",1,0],["وَأَلوي ضُلوعي أَندُبُ المَجدَ وَالنَدى","بِأَفصَحِ دَمعٍ تَحتَ أَخرَسِ مَنطِقِ",77,"ق",1,0],["وَالوَردُ مِثلُ الخُدودِ قَد دَمِيَت","مِن نَرجِسٍ حَدَّقَت لَها المُقَلا",78,"ل",2,0],["وَالوَجه وَالصَدر بادِيان سِوى","ما اِنثالَ مِن فرعها يَخمرها",79,"ر",3,0],["وَالوَيل يا وَطَني لِمَن","أَضحى يصرّ عَلى العِناد",80,"د",1,0],["وَالوَعدُ دَينٌ وَالعَطا","مُستَعيَبٌ تَسويفُهُ",81,"ف",2,0],["وَالوَردُ يَضحَكُ مِن نَواظِرِ نَرجِسٍ","فُدِيَت وَآذَنَ حُبُّها بِمَماتِ",82,"ت",1,0],["والوحشُ آمِنَةٌ لَدَيهِ كَأَنَّها","حُشِرَتْ إلى حَرمٍ بأَوَّلِ مَسْجِدِ",83,"د",1,0],["والوَصْفُ يُمكِنُ فيهِ إلاّ أنّهُ","لا يُطْلَقُ التّشبيهُ والتّمثيل",84,"ل",1,0],["والوشيُ والعَصْبُ والخيماتُ يَضربُها","بالبدو حيث التقى الركبان والطُّرُق",85,"ق",1,0],["والوحيِ والتّأويلِ والتَّحريمِ وال","تحليلِ لا خُلْفٌ ولا إنكار",86,"ر",1,0],["وَأَلواحُ السَريرِ وَمَن تَنَمّى","عَلى أَلواحِهِ تِلكَ الخِيارُ",87,"ر",1,0],["وَالوالِدُ الغَمرُ وَالعَمُّ المُعاذُ بِهِ","لَم يَرضَيا دونَ إِفراعٍ وَإِصعادِ",88,"د",1,0],["وَالوَعدُ مِن دَينِ الكِرامِ","فَما تَرى فيما وَعَدتا",89,"ت",2,0],["وَالوَقتُ مامَرَّ إِلّا","وَحَلَّ في العُمرِ أُربَه",90,"ب",2,0],["وَالوَعدُ يُرقَبُ وَالنَجاحُ لِمِثلِنا","أَن يَستَمِرَّ بِمَطلِهِ المَوعودُ",91,"د",1,0],["وَالوَقتُ لا يَفتَأُ في مَرِّهِ","مُقَرِّباً مِن أَجَلٍ بُعدَه",92,"د",2,0],["وَالوَحشُ في الفَلَواتِ أَجمَلُ عِشرَةٍ","لِلمَرءِ مِن أَهليهِ في الأَمصارِ",93,"ر",1,0],["وَالوَقتُ لِلَّهِ وَالدُنِّيا مُخَلَّفَةٌ","مِنَ بَعدِنا وَتَساوى الهامُ وَالزَمَعُ",94,"ع",1,0],["وَالوِردِ يَكفيكَ مِنهُ شُربَةٌ حُمِلَت","في الرَكبِ إِن مَنَعَتكَ الأَرضُ جَدوَلَها",95,"ل",3,0],["والواحِدُ المُفرَدُ في حَتْفِهِ","كالحاشِدِ المُكْثِرِ من حَشدِهِ",96,"د",2,0],["وَالواهِبُ المِئَةَ المِعكاءَ يَشفَعُه","يَومَ النِضالِ بِأُخرى غَيرَ مَجهودِ",97,"د",1,0],["والوَصْلُ يَقيناً فيكَ ما يقنِعُني","هيهاتِ فَدَعْني من مُحَالِ الطّيفِ",98,"ف",1,0],["وَالورد شبه عروس","جلته أيدي الرياح",99,"ح",1,0],["والورد خداً والظبا","عيناً وخُوط البان قدا",100,"د",2,0],["وَالوَصل بالنَوى","وَالصفو بالكدر",101,"ر",1,0],["والوهم في حالاتها كالعِيان","والحبُّ والكره بها توأمان",102,"ن",1,0],["والوُدُّ غَرّارٌ ونَجْوى علِيّ","ولدَيْهِ غيرُ نَجْوَى كُمَيْل",103,"ل",1,0],["والوتدُ المَفروقُ والمَجموعُ","كِلاهُما في حَشْوِهِ مَمْنوعُ",104,"ع",1,0],["والوتدُ المَفروقُ من هذينِ","مُسكَّنٌ بينَ مُحَرَّكَينِ",104,"ن",1,0],["والوافرُ الذي مَدارُ الثانيهْ","عليهِ قَد تَعيهِ أُذْنٌ واعيَهْ",104,"ه",1,0],["وَأَلْوَتْ بِالْمُضَلَّلِ وَاسْتَمَالَتْ","عِمَادَ الشَّنْفَرَى وَهَوَتْ بِقُسِّ",105,"س",1,0],["وَا لَوْعَةَ الْقَلْبِ مِنْ غِزْلانِ أَخْبِيَةٍ","تَكَادُ تَسْكَرُ مِنْ أَحْدَاقِهَا الرَّاحُ",106,"ح",1,1],["وَالوَافِدُونَ يُشَيِّعُونَ عَزِيزَهُمْ","حَشْدٌ بِهِ الطُّرُقَاتُ ضِقْنَ رِحَابَا",107,"ب",2,0],["وَالوَصِيفَاتُ فِي اقْتِفَاءِ خُطَاهَا","نُسَّقٌ مِنْ نَضَارَةٍ وَبَهَاءِ",108,"ا",2,0],["وَالوَجَاهَاتُ لاَ تَكُونُ وَجَاهَا","تٍ صِحَاحاً حَتَّى يَقُومَ الدَّلِيلُ",109,"ل",1,0],["وَالْوَرْدُ أَزْهَى مَا زَهَا وَرْدُهُ","وَعِطْرُهُ الذَّاكِي هُوَ الْعِطْرُ",110,"ر",1,0],["وأَلْوَى علَيْهِ يُوسُفٌ خَيْرُ مُجْتَبىً","مِنَ اللّه لِلأَمْرِ الَّذي جَلَّ مِنْ أَمْرِ",111,"ر",1,0],["وَالوَفاءُ المَصْدُوقُ قَوْلاً وَفِعْلاً","لِلْحِمَى إِذْ يَعِزُّ فِي القَوْمِ وَافِ",112,"ف",1,0],["وَالْوجْهُ كَالْجَنَّةِ حُسْناً فَإِنْ","ظَنَنْتَ عَدْناً قَدْ تَرَاءَتْ فَهَبْ",113,"ب",1,0],["وَأَلْوَى عَليْك فَأَدْمَى وَأَصلَى","وَصالَ وطالَ وَمَا أَقْصَرَا",114,"ر",2,0],["وَالواهِبُ المِئَةَ المِعكاءَ يَشفَعُها","يَومَ النِضالِ بِأُخرى غَيرَ مَجهودِ",115,"د",1,0],["والوردة البيضاء أو قل نهدها","كأنه من خيلاء يسكر",116,"ر",1,0],["وَالوَيلُ مِمّا يَتَّقيهِ لَهُ غَداً","إِن غابَ عَنهُ وَجهكَ المَرغوسُ",117,"س",1,0],["والوَرْدُ يَزْهُو ناضِراً فَوْقَ الرُّبَا","ويَعُودُ حِيناً وهو شَوْكُ قَتَأدِ",118,"د",1,0],["والوجهُ لليأْسِ به نَظْرَةٌ","يَقذِفُها الْحِقْدُ على دَهْرِه",119,"ر",2,0],["والوقار الذي يشيع عليه","فضلة الإرث من سحيق الدهور",120,"ر",1,0],["والوحش يأنس بالأنغام نافره","والخل إن صدَّ بالألحان تصيبه",121,"ي",3,0],["وا لوعتي إن كان برقك خلَّبًا","ما فيه غيرُ تجهُّم ورعود!",122,"د",1,0],["والواهِبُ المائة َ المِعْكاءَ يَشْفَعُهَا","يوْمَ النّضالِ بِأُخْرى غيرَ مجْهودِ",123,"د",1,0],["وألواحُها \" الألواحُ \" لولا \" رسالةٌ \"","على \" قُرَشيٍّ \" لم تُرِدْ عينُه الربَّا",124,"ب",2,0],["والوانٌ من \" التعذيب\"! تَهدي","سجلَّ \" الثورة \" الكبرى شُعاعا",125,"ع",2,0],["والوَيْلُ للماضينَ في أحلامِهم","إن فرَّ عن \" حُلمٍ \" يَروع منَام",126,"م",1,0],["والوَعْيُ سَيْفٌ يُبْتَلَى","يومَ التَّقَارُعِ انْثِلامِ",127,"م",1,0],["والوجه منها حين بصرته","يكل عنه الوصف، فاستبصر",128,"ر",1,0],["والولدُ الصالح والأعمامُ","رياضة ً أيسرُها الإحكامُ",129,"م",1,0]]}