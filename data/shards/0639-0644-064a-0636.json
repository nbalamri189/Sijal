{"poems":[[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[72,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85701","المجتث"],[298,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[353,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[441,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[441,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[458,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[477,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[477,"حالي غدا عاطلا من وصلك الحالي","https://www.aldiwan.net/poem15264.html","البسيط"],[479,"بنورك يا مولاي لا زلت أهتدي","https://www.aldiwan.net/poem37046.html","الكامل"],[479,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[486,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[586,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem17639.html","الطويل"]],"verses":[["عَلى ضُمَّرٍ هيمٍ فَراوٍ وَعائِفٌ","وَنائِلُ شَيءٍ سَيِئُ الشُربِ قاصِبُه",0,"ب",2,0],["على ضيِّق العينين تسفحُ مقلتي","ويطربني لا زينبٌ ورباب",1,"ب",1,0],["عَلى ضالَةٍ فَرعٍ كَأَنَّ نَذيرَها","إِذا لَم تُخَفِّضهُ عَنِ الوَحشِ عازِفُ",2,"ف",1,0],["عَلى ضَريح جَديد","يضم لَيلى ارتميتُ",3,"ت",1,1],["عَلَى ضفافِ جدولٍ","مياهُهُ مثرثره",4,"ر",2,0],["عَلى ضامر لا وَصف يُدرك شَأوه","وَهَل توصف الأَسرار وَهيَ ضَميرُ",5,"ر",1,0],["على ضعفاء المسلمين فإنها","من الوالد الساعي أبر وأشفق",6,"ق",1,0],["على ضريح الفتى الزاكي أبي سند","سحائب لم تزل عطفاً مهاطيلا",7,"ل",2,0],["على ضَرِمِ القوائم أعوجيّ","تكاذيبُ الشخوص عليه صدقُ",8,"ق",1,0],["عليَّ ضَوافٍ من سوالفِ طَوْلهِ","يجرِّرُ أذيالَ السحاب سَحوبُها",9,"ب",3,0],["على ضامرٍ أودى الكَلالُ بِنَيَّهِ","يَصِرُّ مِنَ الاِعياءِ والجَهدِ بازلُه",10,"ل",2,0],["على ضِرامٍ لنيرانِ الهوى صالِ","ما بين ناشدِ قلبٍ ضلَّ من وَلَهٍ",11,"ه",1,0],["على ضجة التهليل ساروا بشيخهم","جموعا رعاها الله سارت بمفرد",12,"د",1,0],["على ضفة الوادي بقتّة شاهق","تشامخ صرح بين تلك الحدائق",13,"ق",1,1],["عَلى ضُمَّرٍ في الميسِ يَنفُخنَ في البُرى","إِذا شابَكَت أَنيابُها اللَجنَ تَصرِفِ",14,"ف",1,0],["عَليَّ ضَمانٌ أَنَّ طَرْفَكَ لا يَرى","مِن الحُسْنِ شَيْئاً عِنْدَ غَيْرِكَ يَجْمُلُ",15,"ل",1,0]]}