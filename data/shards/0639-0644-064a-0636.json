{"poems":[[32,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[74,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85701","المجتث"],[303,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[358,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[447,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[447,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[482,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[482,"حالي غدا عاطلا من وصلك الحالي","https://www.aldiwan.net/poem15264.html","البسيط"],[484,"بنورك يا مولاي لا زلت أهتدي","https://www.aldiwan.net/poem37046.html","الكامل"],[484,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[491,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[591,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem17639.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138316",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83264","الطويل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137340",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100581","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25323","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64856","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112766","الرجز"],[1430,"","https://poetry.dctabudhabi.ae/diwan/poem/101928","الطويل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1673,"","https://poetry.dctabudhabi.ae/diwan/poem/119059","الطويل"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138026","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71063","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89524","الطويل"],[2254,"","https://poetry.dctabudhabi.ae/diwan/poem/83255","المتقارب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28603","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101694","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87731","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87733","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126965","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108103","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132112","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117846","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131018",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111401","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119625","الطويل"],[4750,"كرمة ودمت","https://www.poetsgate.com/ViewPoem.aspx?id=180404",""],[4778,"على ضفة الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=188191",""],[4888,"معراج عشقي .. (في حب الرسول)","https://www.poetsgate.com/ViewPoem.aspx?id=207773",""],[4908,"في حَضْرَةِ النيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=207378",""],[5151,"عراقٌ وبعضُ المدحِ ذمٌ لغيرهِ","https://www.poetsgate.com/ViewPoem.aspx?id=185032",""],[5431,"ولم يبقَ غير الحب اسطورةً كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=197493",""],[5431,"فراسة...","https://www.poetsgate.com/ViewPoem.aspx?id=198451",""],[5431,"رقص سوريالي!!","https://www.poetsgate.com/ViewPoem.aspx?id=200445",""],[5516,"على ضفة النهر","https://www.poetsgate.com/ViewPoem.aspx?id=212479",""],[5596,"اليحمدي","https://www.poetsgate.com/ViewPoem.aspx?id=206710",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"على ضفّة","https://www.poetsgate.com/ViewPoem.aspx?id=192404",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6160,"غَزَالةُ المَجَازاتِ البَعِيْدَة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87085&r=&rc=2",""],[6193,"براءة بر في برآء المحرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55428&r=&rc=4",""]],"verses":[["عَلى ضُمَّرٍ هيمٍ فَراوٍ وَعائِفٌ","وَنائِلُ شَيءٍ سَيِئُ الشُربِ قاصِبُه",0,"ب",2,0],["على ضيِّق العينين تسفحُ مقلتي","ويطربني لا زينبٌ ورباب",1,"ب",1,0],["عَلى ضالَةٍ فَرعٍ كَأَنَّ نَذيرَها","إِذا لَم تُخَفِّضهُ عَنِ الوَحشِ عازِفُ",2,"ف",1,0],["عَلى ضَريح جَديد","يضم لَيلى ارتميتُ",3,"ت",1,1],["عَلَى ضفافِ جدولٍ","مياهُهُ مثرثره",4,"ر",2,0],["عَلى ضامر لا وَصف يُدرك شَأوه","وَهَل توصف الأَسرار وَهيَ ضَميرُ",5,"ر",1,0],["على ضعفاء المسلمين فإنها","من الوالد الساعي أبر وأشفق",6,"ق",1,0],["على ضريح الفتى الزاكي أبي سند","سحائب لم تزل عطفاً مهاطيلا",7,"ل",2,0],["على ضَرِمِ القوائم أعوجيّ","تكاذيبُ الشخوص عليه صدقُ",8,"ق",1,0],["عليَّ ضَوافٍ من سوالفِ طَوْلهِ","يجرِّرُ أذيالَ السحاب سَحوبُها",9,"ب",3,0],["على ضامرٍ أودى الكَلالُ بِنَيَّهِ","يَصِرُّ مِنَ الاِعياءِ والجَهدِ بازلُه",10,"ل",2,0],["على ضِرامٍ لنيرانِ الهوى صالِ","ما بين ناشدِ قلبٍ ضلَّ من وَلَهٍ",11,"ل",2,0],["على ضجة التهليل ساروا بشيخهم","جموعا رعاها الله سارت بمفرد",12,"د",1,0],["على ضفة الوادي بقتّة شاهق","تشامخ صرح بين تلك الحدائق",13,"ق",1,1],["عَلى ضُمَّرٍ في الميسِ يَنفُخنَ في البُرى","إِذا شابَكَت أَنيابُها اللَجنَ تَصرِفِ",14,"ف",1,0],["عَليَّ ضَمانٌ أَنَّ طَرْفَكَ لا يَرى","مِن الحُسْنِ شَيْئاً عِنْدَ غَيْرِكَ يَجْمُلُ",15,"ل",1,0],["على ضريح فقيد العلم إلياس","نثرت زهراً من النسرين والآس",16,"س",1,1],["عَلى ضَوئِها سارَ الأَئِمَةِ قَبلَنا","وَهَزّوا عَلى الأَملاكِ أَلوِيَةً حَمرا",17,"ر",2,0],["على ضَفَّتيهِ الدَّوحُ مدَّ ظلالهُ","لهُ نفحاتٌ أَينَ منها شذا العِطر",18,"ر",1,0],["على ضحك الهزاراتِ","على نَوْحِ الشَّفافين",19,"ن",1,0],["على ضربِ الرواشينِ","وترجيع الوَرَاشين",19,"ن",1,0],["على ضمر مثل القسي تعطفاً","سواهم وأمثال السهام من الوجف",20,"ف",1,0],["عَلَى ضَفَّتَيها الكَرمُ مَرجٌ سِجَافُهُ","فَهَا هِيَ عَن شَمسِ الظَّهيرَةِ في سِترِ",21,"ر",1,0],["عَلَى ضَحُوكِ النَقْبِ مُصْمَعِدِّ","يَعْدِلُ عِنْدَ رَعْنِ كُلِّ صُدِّ",22,"د",1,0],["على ضامِرِ ظامٍ كَأَنَّ لُغامَهُ","تفاريقُ شَيْبٍ في مَفارِقِ أَقْرَعِ",23,"ع",1,0],["على ضمان وأما","ن ورضا وذا كفا",24,"ف",2,0],["على ضوء ذا القنديل سارت ركايب","خماص الحشى تهوي إلى خير مرقد",25,"د",1,1],["على ضلول الهوى تشتدُّ حِدَّتُهُ","يَنكي ضلول الهوى يسطو على أشرٍ",26,"ر",1,0],["على ضربة أبدت سناسن ظهره","وأخرى أمالت شقّه فهو عادله",27,"ل",2,0],["عَليٌّ ضارِبٌ بِضُباً كَشُهْبٍ","مضِيفٌ في جِفانٍ كالجوابي",28,"ب",2,0],["على ضَوْءِ شَمْسٍ للهداية لم تزل","لها أَبَداً في مشرق الدين مَطْلَعُ",29,"ع",1,0],["عَلى ضُمَّرٍ بَينَ الوَجيهِ وَلاحِقٍ","تُعارِضُ ما أَبقى الجَديلُ وَشَدقَمُ",30,"م",1,0],["عَلى ضَجَّة الطير في الأَيك سكرى","بِبغيتها في وُصول القَرار",31,"ر",1,0],["عَلَى ضُمُرٍ بارَيتُهُم بِحَنينِها","غَراماً وَبارَها سَقاماً حَنينُها",32,"ن",3,0],["على ضوء مسنون الغرارين صارم","اذا سل في الظلماء أغنى عن الفجر",33,"ر",1,0],["عَلى ضُمَّرٍ قُبِّ البُطون كَأَنَّها","وَقَد أُطلِقَت عِقبان صارة مَرّت",34,"ت",1,0],["عَلى ضمَّر قُبٍّ إِذا ما بَعثتها","تَقدَّمها المَوت الزؤام فَخلتها",35,"ه",2,0],["على ضمر كالريح تعدو بكم وقد","نشرتم عليها للكفاح بنودا",36,"د",2,0],["على ضمةٍ من ذلك الخصر بعدها","أقول لهذا الدهر خني ولا تف",37,"ف",1,0],["على ضريحك من حرّان مغتربٍ","نثر الرياحين من حمد وإجلالِ",38,"ل",1,0],["على ضمر تأتم في حومة الوغى","بيحمومه أو ذي الجناح المحوم",39,"م",1,0],["على ضفتيه تنظر الأثل ناميا","يعانق من صفصافه أغصنا ملدا",40,"د",2,0],["عليَّ ضَنَّ بنَذر المَجدِ حيثُ أَغا","مَمنُونُ في طَولِهِ يَسطُو على قِسَمي",41,"م",2,0],["على ضوء هاتيك الثنايا زاهياً","اطالع صحفاً من عناوينها المجد",42,"د",1,0],["على ضامر شوهاء تعدو بضيغم","لرؤيته تبدي الخفيَّ الغمائر",43,"ر",1,0],["على ضو الكلام اللي كشف عنا ستار الصمت","عرفت اني تحت برق الامل في روض الاحلامي",44,"م",2,0],["على ضفة الحلم تاهت خطاي","وحاقت بقلبي رياح السموم",45,"م",1,1],["على ضِفافِ العُلا تَخْتالُ عِتْرَتُهُ","وتَسْتَقي المَجْدَ من يَنْبُوعِهِ الرَّغِدِ",46,"د",1,0],["على ضفافِ القلوبِ السمرِ ها أنا ذا","ترسو سفينيَّ لا خوفٌ ولا خَطَرُ",47,"ر",1,0],["على ضَرْعِها الموءود أردتك أُمةٌ","تُحابي ثَمُوداً مُذ رأت فيك صالِحا",48,"ح",2,0],["على ضفتي روحي طيورٌ لها شدت","فنهري انجيلٌ ونخلي لها السحابْ",49,"ب",1,0],["على ضفتي جرْفٍ تعيشُ مهددا","إلى أن يغور الماء في قعره مصا",50,"ص",2,0],["على ضوء الوجوه رأيتُ حزنا","وأوجاعا بها الأنفاس تُطوى",51,"و",2,0],["على ضفة النهر أرسلتُ روحي","لعمانَ حيث الهوى والظلالْ",52,"ل",1,1],["على ضفاف قلوب كالسما كرما","وكالشموس سناءً والنجوم سما",53,"م",2,1],["على ضمر قصر الأعادي مبيتهم","إذا ما تمطى الوهن ظهر الأريكةِ",54,"ه",1,0],["على ضفّةٍ ما منَ الشارع","أطاحوا بحمدي بلا وازعِ",55,"ع",1,1],["عَلَى ضِفَافِ النَّخِيْلِ الشَّمْسُ قَدْ بَاحَتْ","سِرًّا كَتُوماً بِأَنَّ الحَقَّ صَيْخُوْدُ",56,"د",1,0],["على ضِفَّةِ السَّاعَاتِ أَطلقْتُ مَوعِدَا","وأَغلَقْتُ في غَيْمِ المَسَافَاتِ مَشْهَدَا",57,"د",2,1],["على ضمر تأتم في حومة الوغى","بيحمومه أو ذي الجناح المحموم",58,"م",1,0]]}