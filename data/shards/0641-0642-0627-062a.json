{"poems":[[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[45,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[82,"أرسلت طرفي يقتضي طرفها","https://www.aldiwan.net/poem31312.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42636","الطويل"],[369,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[447,"فدونك من جزء الضياء مسائلاً","https://www.aldiwan.net/poem14413.html","الطويل"],[534,"لا زالت السحب على مشرعه","https://www.aldiwan.net/poem37322.html","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80035","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79959","الطويل"],[2015,"","https://poetry.dctabudhabi.ae/diwan/poem/198290","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40120","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[5277,"ضميرٌ منفصل","https://www.poetsgate.com/ViewPoem.aspx?id=203966",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""]],"verses":[["فَقاتَلَت في ظِلالِ الرَوعِ وَاِعتَكَرَت","إِنَّ المُحامِيَ بَعدَ الرَوعِ يَعتَكِرُ",0,"ر",1,0],["فقاتِل الشُّحَّ بجند النّدى","يُنْصَرْ عليه إلبُكَ الآلبُ",1,"ب",1,0],["فَقاتَلَ عَن حَريمِهِمِ وَفَرّوا","نَدى كَفَّيكَ وَالنَسَبُ القُرابُ",2,"ب",1,0],["فقاتلي طرفيَ لا طَرْفُهَا","والجَفْنُ من جرحِ الحشا دامِ",3,"م",1,0],["فَقَاتِلَةُ الْعُرْجُونِ لِلْفَاقِدِ النَّدَى","وَصَافِيَةُ الْعُنْقُودِ لِلْمَاجِدِ الْغَمْرِ",4,"ر",1,0],["فقاتَلُوا البِيدَ وانتضَوا أيدي ال","عيسِ لِلَبّاتِها تَوَجُّؤها",5,"ا",3,0],["فقاتل حرّ مؤمن متعمدا","ومن هو للطهر النبي مضلل",6,"ل",1,0],["فَقَاتُها قُوتُ الْقُلُوب الّتي","لِرِقَّةِ الطَّبْعِ بِهِ مُولَعَهْ",7,"ع",2,0],["فقأت بسهمك يسراهما","وسرعان ما قد فقأت اليمينا",8,"ن",2,0],["فقاتلُ أهل الضغن بالبطش لم يكن","كقاتل أهل الضغن بالبطش والصفح",9,"ح",1,0],["فقاتل حِفاظاً أو فمُتْ موتَ فارس","فللموت في أمثال هاتيك أكرمُ",10,"م",1,0],["فَقاتَلتَهُ بِاللَّه ثمَّ بِعَزمةٍ","تصُكُّ قلوبَ العاشقين بما تسلي",11,"ل",2,0],["فقاتل أرغوص هام بها","وفي ذروة القصر فيها احتجب",12,"ب",1,0],["فقأتُ عينَ نجومٍ لا ضياءَ بها","وكم تماديتُ في جَدّي وفي لعبي",13,"ب",2,0],["فقاتل من قد دان بالكفر واعتدى","وكف أكف المسلمين ذوي الرشد",14,"د",1,0]]}