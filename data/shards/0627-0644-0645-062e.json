{"poems":[[55,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[57,"أهاجك صوت قمري ينوح","https://www.aldiwan.net/poem26434.html","الوافر"],[9,"ألم خيال من قتيلة بعدما","https://www.aldiwan.net/poem21981.html","الطويل"],[32,"ألا حي المنازل بالسلام","https://www.aldiwan.net/poem29530.html","الوافر"],[29,"ألم خيال هاج من حاجة وقرا","https://www.aldiwan.net/poem5745.html","الطويل"],[34,"ألم خيال من بثينة طارق","https://www.aldiwan.net/poem27778.html","الطويل"],[45,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[30,"ألم خيال من علية بعدما","https://www.aldiwan.net/poem5318.html","الطويل"],[63,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[99,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[33,"ألم خيال من سليمى فأرقا","https://www.aldiwan.net/poem42215.html","الطويل"],[33,"طرب الفؤاد هل له من مطرب","https://www.aldiwan.net/poem42608.html","الكامل"],[22,"يا دار هند عفت إلا أثافيها","https://www.aldiwan.net/poem22028.html","البسيط"],[19,"ألمً خيال موهِناً من تُماضرا","https://www.aldiwan.net/poem337.html",""],[8,"ألا ديار الحي بين محجر","https://www.aldiwan.net/poem21793.html","الطويل"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[33,"طربَ الفؤادُ وهل له من مطربِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18795&r=&rc=58",""],[33,"أَلَمَّ خَيالٌ مِنْ سُلَيْمَى فَأَرَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18969&r=&rc=232",""],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[233,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[239,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[239,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[239,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[253,"ألا ظعن الخليط غداة ريعوا","https://www.aldiwan.net/poem2107.html","الوافر"],[253,"أمسى سمير قد بان فانقطعا","https://www.aldiwan.net/poem2108.html","المنسرح"],[308,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[330,"بايع هارون إمام الهدى","https://www.aldiwan.net/poem44253.html","السريع"],[353,"كم صرعت من أسد العرين","https://www.aldiwan.net/poem15976.html","الرجز"],[361,"يا خيل محيي ملة الإسلام","https://www.aldiwan.net/poem4147.html","الكامل"],[368,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[369,"ألم خيال من أميمة موهنا","https://www.aldiwan.net/poem44360.html","الطويل"],[395,"يا سعد قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem54478.html","عموديه"],[410,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[441,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[461,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[464,"ورب قوم عدى قد فل غربهم","https://www.aldiwan.net/poem15670.html","البسيط"],[551,"ألم خيال من أمية بالركب","https://www.aldiwan.net/poem1173.html",""],[554,"ألم خيال من أميمة طارق","https://www.aldiwan.net/poem47373.html","الطويل"],[707,"","https://poetry.dctabudhabi.ae/diwan/poem/31552","البسيط"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10421","الوافر"],[1027,"","https://poetry.dctabudhabi.ae/diwan/poem/20542","المتقارب"],[901,"ألَمَّ خَيَالٌ مِنْ أُمَيْمَة َ مَوْهِناً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27417&r=&rc=21",""]],"verses":[["أَلَمَّ خَيالُ العامِريَّةِ بَعدَما","تَبَطَّنَنا جَفنٌ مِنَ اللَيلِ أَوطَفُ",0,"ف",1,0],["أَلَمَّ خَيالُ فَوزٍ وَالثُرَيّا","قُبَيلَ الصُبحِ غائِرَةٌ جَنوحُ",1,"ح",1,0],["أَلَمَّ خَيالٌ مِن قُتَيلَةَ بَعدَما","وَهى حَبلُها مِن حَبلِنا فَتَصَرَّما",2,"م",2,1],["أَلَمَّ خَيالُ مَيَّةَ بَعدَ وَهنٍ","بِظامي الآلِ خاشِعَةِ السَنامِ",3,"م",1,0],["أَلَمَّ خَيالٌ هاجَ مِن حاجَةٍ وَقرا","عَلَيكَ السَلامُ ما زِيارَتُكَ السَفرا",4,"ر",2,1],["أَلَمَّ خَيالٌ مِن بُثَينَةَ طارِقُ","عَلى النَأيِ مُشتاقٌ إِلَيَّ وَشائِقُ",5,"ق",1,1],["المُخفِرينَ بِكُلِّ أَبيَضَ صارِمٍ","ذِمَمَ الدُروعِ عَلى ذَوي التيجانِ",6,"ن",1,0],["أَلَمَّ خَيالٌ مِن عُلَيَّةَ بَعدَما","رَجا لِيَ أَهلي البُرءَ مِن داءِ دانِفِ",7,"ف",1,1],["أَلَمَّ خَيالُها والعِيسُ حَسْرى","مَرافِقُها وسائدُ للرِّفاقِ",8,"ق",1,0],["المخلصُ الوافي إذا","عَزَّ المنادم والرفيق",9,"ق",1,0],["أَلَمَّ خَيالٌ مِن سُلَيمى فَأَرَّقا","هُدوءً وَلَم يَطرُق هُنالِكَ مَطرَقا",10,"ق",2,1],["أَلمُخبِري إِنّي أُحِبُّ مُصاقِباً","داني المَحَلِّ وَنازِحاً لَم يَصقَبِ",11,"ب",1,0],["المُخلِفُ الأَلفَ بَعدَ الأَلفِ يُتلِفُها","وَالوَاهِبُ المِئَةَ المِعكى وَراعيها",12,"ي",3,0],["أَلَمَّ خَيالٌ مَوهِناً مِن تُماضِرا","هُدُوّاً وَلَم يَطرُق مِنَ اللَيلِ باكِرا",13,"ر",2,1],["أَلَمَّ خَيالٌ مِن أُمَيمَةَ مُوهِناً","طُروقاً وأَصحابِي بِدارَةِ خَنزَرِ",14,"ر",1,0],["أَلَمَّ خَيالٌ هاجَ وَقراً عَلى وَقرِ","فَقُلتُ ما حَيَّيتُمُ زائِرَ السَفرِ",15,"ر",1,1],["أَلْمُخْبِرِي: إنِّي أُحِبُّ مُصَاقِباً","داني المحلّ، ونازحاً لم يقصب",16,"ب",1,0],["أَلَمَّ خَيالٌ مِنْ سُلَيْمَى فَأَرَّقا","هُدوءاً وَلَمْ يَطْرُقْ هُنَالِكَ مَطْرَقَا",17,"ق",2,1],["المخبرُ المشاور الخبيرُ","الذاكرُ التذكرةُ المذكورُ",18,"ر",1,0],["المخجلُ الغيثَ راحتاه إذا","جاد بِغيثين مِرزميَّيْنِ",19,"ن",1,0],["المُخلِفاتُ كَأَنَّهُنَّ","خُلِقنَ مِن وَعدٍ وَمَينِ",20,"ن",1,0],["المُخمِدِ الحَربَ العَوا","نَ وَنارُ جاحِمِها تَوَقَّد",21,"د",1,0],["المُخمِدُ الحَربَ إِذا","شَبَّ لَظاها وَلَفَح",22,"ح",1,0],["أَلَمَّ خَيالُها بِلِوى حُبَيٍّ","وَصَحبي بَينَ أَرحُلِهِم هُجوعُ",23,"ع",1,0],["المُخلِفَ المُتلِفَ المُفيدَ إِذا","قالَ فَلا عائِبٌ لِما صَنَعا",24,"ع",2,0],["المخلصون الصادقون الأبرار","الطيبون الطاهرون الأخيار",25,"ر",1,0],["المُخلِفُ المُتلِفِ أَموالَهُ","وَالضامِنِ الأَثقالِ لِلحامِلِ",26,"ل",1,0],["أَلمُخجِلاتُ الشَمسِ نوراً وَالمَعيرا","تُ اِعتِدالَ القَدِّ لِلغُصونِ",27,"ن",1,0],["المُخمِدونَ بجدّهِم وَحَديدِهِم","في الحَرب جَمرَة عُبّدِ الأصنَامِ",28,"م",1,0],["المُخرِجاتِ من الحريرِ تَحيّةً","أَطرافَ دُرٍّ بالعَقيقِ مُقمَّع",29,"ع",1,0],["أَلَمَّ خيالٌ من أُمَيمَةَ مَوهِناً","وقد جَعَلَت أُولى النُجومِ تَغورُ",30,"ر",1,1],["المخلصون الصادقون الأبرار","التائبون العابدون",31,"ن",1,0],["أَلَمَّ خاليَها بَعد الهُجوعِ","فَعادَت إِذ رأَت سيفي ضَجيعي",32,"ع",2,1],["المخجل صوب المزن فما","يوليه يفوت عن العددِ",33,"د",1,0],["المِخذَمُ البَتّارُ أُسقِطَ من يدي","والغيثُ أقلَعَ عنِّيَ المِدرارُ",34,"ر",1,0],["المخجل الغيث اِن جاشتْ مكارمُه","والهازمُ اللَّيثَ انْ عنَّت بوادرهُ",35,"ر",2,0],["أَلَمَّ خَيالٌ مِن أُمَيَّةَ بِالرَكبِ","وَهُنَّ عِجالٌ عَن نُيالٍ وَعَن نَقبِ",36,"ب",1,1],["ألَمَّ خيالٌ من أُمَيْمَةَ طارقٌ","ومن دونَ مسراه اللّوى والأبارِقُ",37,"ق",1,1],["المُخرِجُ الكاعِبَ الحَسناءَ مُذعِنَةً","في السَبيِ يَنفَحُ مِن أَردانِها الطيبُ",38,"ب",1,0],["أَلَمَّ خَيالُ لَيلى أُمِّ عَمروِ","وَلَم يُلمِم بِنا إِلّا لِأَمرِ",39,"ر",1,1],["أَلَمَّ خَيالُ عَشاءً فَطافا","وَلَم يَكُ إِذ طافَ إِلَّا اختِطافا",40,"ف",2,1],["ألَمَّ خَيَالٌ مِنْ أُمَيْمَة َ مَوْهِناً","فَلَمْ أغْتَمِضْ لَيلَ التِّمامِ تهجُّدا",41,"د",2,1]]}