{"poems":[[93,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[93,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[124,"كفنوني إن مت في ورق الزهر","https://www.aldiwan.net/poem49341.html","الخفيف"],[133,"كفنوه وادفنوه أسكنوه","https://www.aldiwan.net/poem67458.html","الرمل"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[475,"رام قلبي السلو عن أسماء","https://www.aldiwan.net/poem4621.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122566","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38559","الطويل"],[985,"","https://poetry.dctabudhabi.ae/diwan/poem/111242","الرمل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128267","الخفيف"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124707","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109106","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48988","الخفيف"],[1583,"","https://poetry.dctabudhabi.ae/diwan/poem/142510","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77215","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200416","الخفيف"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147337","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88977","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62913","الخفيف"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139372",""],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125870","الرمل"],[4755,"كَفِنجانِ ماءٍ بارِدٍ كَفُّها غَفَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=184080",""],[5121,"كفن الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=37445",""],[5295,"أنين","https://www.poetsgate.com/ViewPoem.aspx?id=171625",""],[5436,"كفّن الموت / زاحم محمود خورشيد","https://www.poetsgate.com/ViewPoem.aspx?id=177683",""],[5747,"لا تقصر الفنجال","https://www.poetsgate.com/ViewPoem.aspx?id=61659",""],[5848,"المعقول واللا معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53187",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6093,"يذكر النَّاس ُ كلَّ مَيْتٍ بخيرٍ ( الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=176024",""],[6093,"شهيدٌ من القنفذة (الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=181456",""],[243,"شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68161&r=&rc=153",""],[6300,"بقايا الزمن المرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82864&r=&rc=35",""],[6300,"نزيف الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82846&r=&rc=17",""]],"verses":[["كَفَّنتُ أَحلامي وَقُلتُ لَها","نامي فَإِنَّ الحُبَّ قَد رَقَدا",0,"د",2,0],["كَفَّنتُ في نيويوركَ أَحلامَ الصِبا","وَطَوَيتُها وَحَسَبتُها لَن تُنشَرا",1,"ر",2,0],["كَفَّنوها حُرَّةً عُلوِيَّةً","كَسَتِ المَوتَ جَلالاً وَكَساها",2,"ا",3,0],["كُفِّنتِ في لَيلِ الزَفافِ بِثَوبِهِ","وَدُفِنتِ عِندَ تَبَلُّجِ الإِصباحِ",3,"ح",1,0],["كفن بالدمع لم يغتسل","وإذا الخندق أمسى منزلاً",4,"ل",2,0],["كفّنوا الشمسَ بريحانٍ ووَرسِ","يا لشمسٍ آذنت من عبد شمسِ",5,"س",1,1],["كفِّنوا العقادَ في أسفاره","وادفنوا المِرْقَم والطِّرْس معه",6,"ع",2,0],["كفنوني إن مت في ورق الزه","ر ورشوا ثراي بالصهباء",7,"ا",2,1],["كفّنوهُ وادفنوهُ أسكنوهُ","هوَّةَ اللحد العميق",8,"ق",1,1],["كَفَّني الحِلمُ وَالمَشِيبُ وَعَقلي","وَنُهى اللَهِ عَن سَبيلِ الضَلالِ",9,"ل",1,0],["كفَّنِي جودُهمُ أن أجتدى","وأبى عزّهُمُ لي أن أُضاما",10,"م",2,0],["كَفِّناني إِن مِتُّ في دِرع أَروى","وامتَحا لي مِن بِئرِ عُروَةَ مائي",11,"ا",2,0],["كُفّ نوماً أما ترى الصُّبحَ قد قَدَّ","قَميصَ الظَّلامِ والديكُ صاحا",12,"ح",2,0],["كَفُنجانِ ياقوتٍ بِكَفّ زُمرُّدٍ","تضمّ وَصبَّت فيهِ نقطةَ قَهوةِ",13,"ه",1,0],["كف نجوم وخمراً","من لماها صيرتني",14,"ن",2,0],["كفِّنوهُ بالوَرْدِ فهوَ أخُوهُ","واجْعَلُوا القَبْرَ سَلَّة من نُضارِ",15,"ر",1,0],["كفّنوني بالورد والياسمين","واجلسوا عند هامتي في سكون",16,"ن",1,1],["كفنٌ أبيض عليه زهورٌ","برزت فوقه من الأوراقِ",17,"ق",1,1],["كفنٌ من دَمِ القلوبِ ورمسٌ","في الحَشا حفَّهُ الأَسى والولاء",18,"ا",2,0],["كفَّن اليقظةَ بالرؤيا وتاه","شاعرٌ كلُّ المنى بعض مُناه",19,"ا",2,1],["كفَّنته بثوبها العلياء","غسلته الدموع وهي لآل",20,"ا",2,0],["كَفِّنوني بِالوَردِ وَالرَيحانِ","وَاِدفِنوني في سُرَّةِ البُستانِ",21,"ن",1,1],["كفّنوا الميت بالثياب جزافا","ربّ حيّ أحقّ بالتكفين",22,"ن",1,0],["كَفَّنْتمُ الأكْبَادَ أسْبَابَ الفَنَى","فَقُلُوبُ عُذرَةَ بالسَّمَاْءِ ستَخْفِقُ",23,"ق",1,0],["كفناً يسر الناظرين صينعه","مما وشته لعرسها صنعاء",24,"ا",2,0],["كَفَّنُوهُ وما حَبوهُ بشيءٍ","غير حَثْوِ الثَّرى على الاكْفَانِ",25,"ن",1,0],["كفناني إن مت في درع أروى","واسقياني من بئر عروةَ مائي",26,"ي",1,1],["كفنوه بجفوني","واغسلوه بدموعي",27,"ع",2,1],["كَفِنجانِ ماءٍ بارِدٍ كَفُّها غَفَتْ","بكَفِّيْ, وقالت لِي: حبيبي, وأَرهَفَتْ",28,"ت",1,1],["كَفَّنَ الْحُزْنُ احْتِرَاقِي بِالْتَّجَنِّي","مِثْلَ جَمْرٍ شَبَّ مَسْعُورًا بِحُضْنِي",29,"ن",2,1],["كفنوا الأحلامَ في عينِ الصغارْ","واكتبوا التاريخَ من حبرِ الدمارْ",30,"ر",1,1],["كفّن الموتٓ لم تمتْ ياعراقُ","واسرج الغيم صهوةً يابراقُ",31,"ق",1,1],["كفنتني من جور وقتٍ هنالك","قبرتني في صالي الجمر بيداك",32,"ك",1,0],["كفن أبيض وتنهيده ودمعة حزن حرّاقه","تكفي في زمن فيه اللحى بالذل محلوقه",33,"ق",2,0],["كفني جثث الصغار, ثم صلّي","واطلبي الجيش ليعلنها نصيب.",34,"ب",1,0],["كفَّنوهُ بَلْ كفَّنوا الظُّرف ، ويلي!","قبروا الحبَّ والصَّفَا وابتِسَامَا",35,"م",2,0],["كَفِّنُوا المِقْدَامَ في ثوبِ الوطَنْ","عَلمِ التَّوحيد يَا خَيْرَ كَفَنْ",36,"ن",1,1],["كفن بالأوراق آهاته","وارتد يرثيها بآياته",37,"ت",2,1],["كفَّن الحُزْنُ حياتي بالأسى","فدمي قبرٌ وأشواقِي عَدَم ْ",38,"م",1,0],["كفّن البينُ مهجتي بالمآسي","فأقَامتْ جنازتي الأشواق ُ",39,"ق",1,0]]}