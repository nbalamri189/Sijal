{"poems":[[87,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[47,"خيال يعتريني في المنام","https://www.aldiwan.net/poem65653.html","الوافر"],[30,"أعبد الله أنت أحق ماش","https://www.aldiwan.net/poem5162.html","الوافر"],[82,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[107,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85327","المتقارب"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[168,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[280,"نفوس العالمين لك الفداء","https://www.aldiwan.net/poem25644.html","الوافر"],[303,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[366,"أقول له وقد عاينت منه","https://www.aldiwan.net/poem68078.html","الوافر"],[370,"فلولا سراة الحي من آل مالك","https://www.aldiwan.net/poem44490.html","الطويل"],[422,"أتانا عنك مولانا البشير","https://www.aldiwan.net/poem53895.html","الوافر"],[422,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[422,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[447,"سلوا هل تروا خلقا وإن عز باقيا","https://www.aldiwan.net/poem14491.html","الطويل"],[519,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[580,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99990","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79864","الرمل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76803","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89529","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204580","المجتث"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74203","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145537","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86375","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127212","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139530",""],[5145,"أتنكر أني بكم مغرم","https://www.poetsgate.com/ViewPoem.aspx?id=108229",""],[5498,"توبة","https://www.poetsgate.com/ViewPoem.aspx?id=216043",""],[6184,"من القدس الى الفرات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78623&r=&rc=15",""]],"verses":[["هُم أَقسَموا لِتَدينَنَّ السَماءُ لَهُم","وَاليَومَ قَد صَدَّقوا في قَبرِهِم قَسَما",0,"م",2,0],["هُما قَمَرانِ هَمّا أَن يَتِمّا","لِنَفيِ الظُلمِ أَجمَعَ وَالظَلامِ",1,"م",1,0],["هُما قَمَرا السَماءِ وَأَنتَ بَدرٌ","بِهِ بِاللَيلِ يُدلِجُ كُلُّ سارِ",2,"ر",1,0],["هم أقاموا زَيْغَ العدى بذكورٍ","تَكتَسي بِالدِّماءِ وهيَ عَوَارِ",3,"ر",1,0],["هم أقاموا مُشاغبين مُكبِّي","نَ على الظُّلمِ أربعين طوالا",4,"ل",2,0],["هُمْ أقَرُّوا جانبَ الدَّهرِ وهُمْ","أصْلحوا الأيّامَ من بعدِ الفَساد",5,"د",1,0],["هما قوتان تخالفتا","فَذَلك يبني وَذا يهدم",6,"م",1,0],["هم أقدموا ارتجرد السراحيب لها","تعطش الصادى الى نار الوغى",7,"ا",1,0],["هما قَدَران من رزقٍ وموْتٍ","إذا عزما فما لهما مَرَدُّ",8,"د",1,0],["هُمُ اِقتَضَبوا الأَمثالَ صَعباً قِيادها","فَذَلَّ لَهُم مِنها الشَريسُ الغَشَمشَمُ",9,"م",1,0],["هُم اقْتَرحوا بَقَاءك لِلْمَعالي","لِيَهْنِئَهم بِدَوْلَتِك البَقاء",10,"ا",2,0],["هما قد دافتالي كأْس ذكرى","جرى دمعي لها وهفا جناني",11,"ن",2,0],["هما قَد حَدّثا في المَهد عما","لاصلهما مِنَ المَجدِ المعلى",12,"ل",2,0],["هما قَد شمرا لِلمَجد باعا","لِيَكتَسِبا بِذاكَ الباعِ فَضلا",12,"ل",2,0],["هما قارَعا عن بَيضَةِ العِزّ بالقَنا","ذُؤابةَ حيٍّ والرِّماحُ تَهَزَّعُ",13,"ع",1,0],["هما قمرا سماوات المعالي","إذا ما يأْفُلُ القمر المنير",14,"ر",1,0],["هما قمرا مجد وإن قلتُ فرقدا","سماءٍ فكلٌّ منهما هو فرقد",15,"د",1,0],["هم أقاموا عَمَدَ الدِّين وهم","أوضحوا في الحقِّ للخلق المنارا",16,"ر",2,0],["هما قتلا حر النهار وأحييا","بصوم وإخلاص القيام الدياجيا",17,"ي",2,0],["همْ أقرَضوا سَمعي الجُمانَ وطالبوا","فيهِ مَسيلَ الدّمعِ منْ مُرجانهِ",18,"ن",2,0],["هُم أَقامُوا خِباءَه بعدمَا ما","لَ عمودٌ له ورثَّت حِبالُه",19,"ل",2,0],["هُمَا قَمَرَا الزَّمَانِ وَغُرَّتَاهُ","مُرِيحاً الْمُلْكِ مِنْ عَارٍ وَشَيْنِ",20,"ن",1,0],["هم أقاموا عمدَ العليا وهم","شرعوا فيها الصراط المستقيما",21,"م",2,0],["هما قرتا عين الرسول وسيدا","شباب الورى في جنة الخلد في غد",22,"د",1,0],["هُمُ أَقاموا شِعارَ الدينِ وَاِرتَفَعَت","بِهِم مَعالِمُهُ إِذ قَد وَهى وَمَحا",23,"ح",2,0],["هما قديمان عاشا","معي وحلاّ فنائي",24,"ي",1,0],["هُما قرتا عين البتول وَحَيدر","فَيا عَجَباً هَل كَيف غالهما الدَهر",25,"ر",1,0],["هما قاتلا فرعون أمة أحمد","برغم معد والرماح الشوارع",26,"ع",1,0],["هما قد شرقا سيراً فخصا","مسيلاً لم تسل منه الفلاة",27,"ه",1,0],["هما قمر وافق المعالي وناظرا","غواني المعاني مسمعا القول بالفصل",28,"ل",1,0],["هما قمرا سعدٍ أضاء شبابُه","وكلٌّ تراه في الدجنَّة ثاقبا",29,"ب",2,0],["هما قمراه ومن بعدذا","كواكبها كلها منهم",30,"م",1,0],["هم أقنعوكَ لكي تطولَ جدائلا","هم أرجؤوكَ لكي تموتَ عذابا",31,"ب",2,0],["هما قِبلتانا ، المجد والدين فيهما","فان ضاعتا ضعنا وبعثَرَنا العذل",32,"ل",1,0]]}