{"poems":[[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[66,"هو اجتباني وأدناني وشرفني","https://www.aldiwan.net/poem67625.html","البسيط"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[47,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[47,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[30,"أقول لمنحوض أعالي عظامها","https://www.aldiwan.net/poem5461.html","الطويل"],[48,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[92,"بين النجف وأمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=178944",""],[96,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=15628",""],[139,"إزي حال صدقي وحال بور سعيد","https://www.aldiwan.net/poem48845.html","المواليا"],[699,"","https://poetry.dctabudhabi.ae/diwan/poem/104492","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87743","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200626","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204491","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203011","الوافر"],[3227,"","https://poetry.dctabudhabi.ae/diwan/poem/143348","السريع"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145544","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21414","الطويل"],[4680,"على نَغَمات الريح","https://www.poetsgate.com/ViewPoem.aspx?id=190640",""],[4764,"تحسس شوفني يمكن","https://www.poetsgate.com/ViewPoem.aspx?id=28974",""],[4797,"من لابتي مّره الى جدي افطيس","https://www.poetsgate.com/ViewPoem.aspx?id=71831",""],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[5431,"والله يبسط في المحبة أمنه","https://www.poetsgate.com/ViewPoem.aspx?id=191997",""],[5648,"هواجيس الجفا","https://www.poetsgate.com/ViewPoem.aspx?id=154840",""],[5732,"لا وا عشيري","https://www.poetsgate.com/ViewPoem.aspx?id=177921",""],[5776,"فراغُ الفهارس","https://www.poetsgate.com/ViewPoem.aspx?id=199333",""],[5837,"بعيد الشبح","https://www.poetsgate.com/ViewPoem.aspx?id=179316",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""]],"verses":[["هَواجِرُ الأَيّامِ في","ظِلالِكُم أَصائِلُ",0,"ل",1,0],["هُوَ اِجتِباني وَأَدناني وَشَرَّفَني","وَالكُلّ بِالكُلِّ أَوصاني وَعَرَّفَني",1,"ي",1,1],["هو أجلى عن الخليفةِ لمَّا","سلَّت السيفَ فتنةُ الجُهَّالِ",2,"ل",1,0],["هَواجِرُ شَوقٍ لَو تَشاءُ يَدُ النَوى","لَجادَت بِمَن نَهوى فَعادَت أَصائِلا",3,"ل",2,0],["هُوَ أَجنى بِما يُنَوِّلُ مِن أَن","يَتَعَدّى لاحيهِ أَو يَتَجَنّى",4,"ن",2,0],["هَواجِرُ يَحلُبنَ الحَميمَ وَماكِدٌ","مِنَ السَيرِ لَم تَطعَم مُنَدّىً وَمَنزِلا",5,"ل",2,0],["هَواجِرُ في التَيَقُظِ أَو عَواصٍ","وَفي طَيفِ الكَرى مُتَعَهِّداتُ",6,"ت",1,0],["هواجس تدني إليك المنى","ولولا المنى قط لم اهجس",7,"س",1,0],["هواجسي فيك إيمان وغالية","وأنجم وفراش تعبد اللّهبا",8,"ب",2,1],["هواجس أنت دنياها ومعدنها","فكيف تبدع إلاّ النّور والطربا",8,"ب",2,0],["هوّا جرا لعقلك خلل يا عبيط","حتى تسلم لحيتك للمره",9,"ه",1,0],["هواجس لو يبث البعض منها","لضاق بوجدها الصدر الرحيب",10,"ب",1,0],["هواجسٌ ملأ المستبشرون بها","نفوسهم وتعداها الخليونا",11,"ن",2,0],["هَواجس النَفس ما تنفكُّ ثائِرة","وَطُول ضَربيَ أَخماساً لِأَسداس",12,"س",1,0],["هواجس شعري في نواك تسلسلت","كأني منها واقعٌ وسْط تيار",13,"ر",1,1],["هواجس في فكري تصادم بعضها","فتصبح منها النفس ذاهلة حيرى",14,"ر",2,0],["هواجس هن توقظني بوخزٍ","كأني قد رقدت على قتاد",15,"د",1,0],["هُوَ اجتباه واجتوى غيره","ومَن هوى العودَ نفى العَرْفَجا",16,"ج",2,0],["هواجس أوطار أنا بين موجها","كذي البحر إذ حط الشراع فسيبا",17,"ب",2,0],["هَواجِرُ لَو يُشوى بِها النَيُّ أَنضَجَت","مُتونَ المَها مِن طَبخِهِنَّ شَواسِفُ",18,"ف",1,0],["هواجسه من صاخب الموج مدُّها","يفيض بها جمُّ الهوى متلاطمُه",19,"م",2,0],["هواجس من رحل طيفك ابد ما فارقت بابك","تمني نفسها شوفك بعد غيبه يدفيها",20,"ي",3,0],["هواجرٍ لاجات قدهي مقاويس","ركب الضيوف امن السرا والقوايل",21,"ل",1,0],["هوَ اجتباهُ ، خِتاماً لا خِتامَ لهُ","مؤيداً فاستوتْ أبهى معانيهِ",22,"ي",2,0],["هو أجمل الأوطان في رحم الضيا","حيث التقت فيه القلوب أجنّه",23,"ن",2,0],["هو أجمل الأشعار في ملكوتها","برياض خير وافرٍ بالمِنّه",23,"ن",2,0],["هواجيس الجفا بالفكر تشغل راحة البالي","تهد الحيل والعاشق صبر ايوب مامله",24,"ل",2,0],["هواجسي يمه خفاف وهرب","وذكراه للقلب المعذب متوعي",25,"ع",2,0],["هواجسُ مَنْ يمضغون الأماني","أتحرقُ ويلاً.. وتبني الفرادسْ؟",26,"س",1,0],["هواجيس يمّي واردة بين ركض ودبح","مثل جيش متقدِّم وبالمعركة ظافر",27,"ر",1,0],["هواجسي بعضَ أحيانٍ تناوئني","وتستثير دعاءاتي وتفكيري",28,"ر",2,0]]}