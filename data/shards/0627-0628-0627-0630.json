{"poems":[[53,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[107,"أبا ذر رحلت على بعير","https://www.aldiwan.net/poem44025.html","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116948","الخفيف"],[135,"أبا ذفافة من للخيل إذطردت","https://www.aldiwan.net/poem24000.html","البسيط"],[520,"أباذل صوب الجود غير رشاش","https://www.aldiwan.net/poem12166.html","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103555","الكامل"],[6142,"إذا غرب سيف أم هلال المحرم","https://www.poetsgate.com/ViewPoem.aspx?id=155752",""],[520,"أباذل صوب الجود غير رشاش","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577565",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["أبٌ إذا بَرَّ أبلانا وأهْرمَنا","قُبْحاً له من أبٍ بالذَّمِّ ملسون",0,"ن",1,0],["أبا ذرٍّ رَحلتَ على بعيرٍ","لو اَنَّ الذَّرَّ يَلْمَسُهُ لَهدَّهْ",1,"د",2,1],["أبإذنٍ نزلتَ بي يا مشيبُ","أيُّ عيش وقد نزلتَ يطيبُ",2,"ب",1,1],["أَبا ذُفافَةَ مَن لِلخَيلِ إِذطُرِدَت","فَاِضطَرَّها الطَعنُ في وَعثٍ وَإِرجافِ",3,"ف",1,1],["أباذل صوب الجود غير رشاش","وموقد نر المكرمات لعاش",4,"ش",1,1],["أبإذن من هو مبصري صمم","أم قلب من هو سامعي حجر",5,"ر",1,0],["أباذلها لله نفساً أبية","تصعر خدا عن مذلة مرغم",6,"م",1,0],["أباذل صوب الجود غير رشاش","وموقد نار المكرمات لعاش",7,"ش",1,1],["أبا ذر الغفاري قد نسينا","طريق السابقين طريق صيد",8,"د",1,0]]}