حكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[466,"ستائر الأوراق منصوبة","https://www.aldiwan.net/poem59807.html","السريع"],[466,"الجو في مصمته وخزه","https://www.aldiwan.net/poem59964.html","الرجز"],[466,"والروض في أعلامه وطرزه","https://www.aldiwan.net/poem59969.html","البسيط"],[466,"الجو يلمع برقه","https://www.aldiwan.net/poem59993.html","مجزوء الكامل"],[466,"الجو قد جلت الثريا نفسها","https://www.aldiwan.net/poem60504.html","الكامل"],[480,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[480,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[493,"يا آل عصم أنتم أولو العصم","https://www.aldiwan.net/poem10276.html","مشطور الرجز"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[527,"الجواب الحق في هذا بلا","https://www.aldiwan.net/poem37268.html","الرمل"],[527,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[527,"الجواب الذي أراه صوابا","https://www.aldiwan.net/poem37448.html","الخفيف"],[536,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[536,"الويل ثم الويل للبياز","https://www.aldiwan.net/poem48010.html","عموديه"],[536,"في بذلة النوم قد تبدى","https://www.aldiwan.net/poem48249.html","عموديه"],[549,"لعمرك إنني فارقت نجدا","https://www.aldiwan.net/poem47181.html","الوافر"],[551,"الجود أخشن مسا يابني مطر","https://www.aldiwan.net/poem68349.html","البسيط"],[551,"يا عين جودي بدمع منك مدرار","https://www.aldiwan.net/poem68400.html","البسيط"],[562,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[573,"الجن قد طرقت بأعينها","https://www.aldiwan.net/poem2703.html","أحذ الكامل"]],"verses":[["الجِدُّ لا يَقتَضي إِسماعَ مُلهِيَةٍ","وَالهَزلُ يَكمُنُ في الأَوتارِ وَالنَغَمِ",0,"م",1,0],["الجودُ يَنهاهُ وَيَأمُرهُ","وَالدَهرُ يَرجوهُ وَيَفرَقُهُ",1,"ق",2,0],["أَلجاهُ قَطرٌ وَشَفّانٌ لِمُرتَكِمٍ","مِنَ الأَميلِ عَلَيهِ البَغرُ إِكثابا",2,"ب",2,0],["الجابِرُ العَظمَ الكَسيرَ","مِنَ المُهاصِرِ وَالمُمانِح",3,"ح",1,0],["أَلْجَاعِلِي بَيْرُوتَ وَهْ","يَ الثَّغْرُ لِلْعَلْيَاءِ بَابَا",4,"ب",2,0],["الجَهْلُ وَالبُؤْسُ تعقبتهما","وَقَدْ أَزَالاَ الخُلقَ الشَّرْقِيَّا",5,"ي",2,0],["أَلجَانِيَاتِ الوَرْدَ رَامَتْ حَظَّهَا","فِي كُلِّ مَرْمَى مِن رَصَاصِ الجَانِي",6,"ن",2,0],["أَلجُوْعُ قُبِّحَ مِنْ كُفْرٍ وَإِنْ وَلَدَتْ","مِنْهُ أَعَاجِيبَهَا الغَارَاتُ وَالْقُحَمُ",7,"م",1,0],["الجَهلُ بَعدَ الأَربَعينَ قَبيحُ","فَزَعِ الفُؤادَ وَإِن ثَناهُ جُموحُ",8,"ح",1,1],["الجاعِلينَ لِمارَ سَرجِسَ حَجَّهُم","وَحَجيجُ مَكَّةَ يُكثِرُ التَكبيرا",9,"ر",2,0],["الجامِعينَ إِذا ما عُدَّ سَعيُهُمُ","جَمعَ الكِرامِ وَلا يوعَونَ ما جَمَعوا",10,"ع",3,0],["الجتهم مباعدة وكانوا","بني الهوان في الظلم المصول",11,"ل",1,0],["ألَجُّوا ولَجُّوا في بعاد وَبِغضَةٍ","فَقَد نَشِبُوا في حَبل غَيٍّ وانشَبُوا",12,"ب",3,0],["الجود ملءُ والعلم ملء","مسامع والعز ملءُ قلوب",13,"ب",1,0],["الجائدِين بما نالت عزائمهم","والطاعنين الأعادي بالقنا السلبِ",14,"ب",1,0],["أَلجَمَ الدهرَ لي وكان خليعاً","فمشى بي في القَصدِ بعد اعتراض",15,"ض",1,0],["ألجم الظلم فأدمى","حنكاً منه وشدقا",16,"ق",2,0],["الجامع الشملَ بعدَ فرقته","والواصلِ الحبلَ بعد منْبتكهْ",17,"ك",2,0],["الجَمالُ الحَقُّ ما يَعبُدُهُ","وَالجَمالُ الزورُ ما لا يُبصِرُ",18,"ر",1,0],["الجاهِلِيَّةُ آهِ مِن أَصنامِها","بورِكتَ يا مَن جَدَّ في تَحطيمِها",19,"م",3,0],["الجُودُ أَحلى عَلى قَلبي مِنَ الظَفرِ","وَمِن مَنال قَصيّ السؤلِ وَالوَطَرِ",20,"ر",1,1],["الجرح يبرأ حين يلقي ضامداً","ويفز حين يعز ذاك الضامد",21,"د",1,0],["الجيش طاردها وبدد شملها","والخيل دامية من المهماز",22,"ز",1,0],["الجامع العرشين في واحد","واللابس التاجين في المحفل",23,"ل",1,0],["الجاعل الأمة من عدله","والفضل بين الظل والمنهل",23,"ل",1,0],["الجامِعُ الأَزهرُ باقٍ عامِرٌ","وَهَذِهِ القاهِرَةُ الَّتي بَنى",24,"ا",1,0],["الجِنُّ في جَنَباتِها مَطروقَةٌ","بِبَدائِعِ البَنّاءِ وَالحَفّارِ",25,"ر",1,0],["الجيزَةُ الفَيحاءُ هَزَّت مَنكِباً","سُبِغَ النَوالُ عَلَيهِ وَالإِنعامُ",26,"م",1,0],["الجَهلُ لا تَحيا عَلَيهِ جَماعَةٌ","كَيفَ الحَياةُ عَلى يَدَي عِزريلا",27,"ل",2,0],["الجِدُّ غايَةُ كُلِّ لاهٍ لاعِبٍ","عِندَ المَنِيَّةِ يَجزَعُ المِفراحُ",28,"ح",1,0],["الجَلالُ قُبَّتُهُ","وَالسَنا لَهُ طُنُبُ",29,"ب",1,0],["الجَهلُ لا يَلِدُ الحَياةَ مَواتُهُ","إِلّا كَما تَلِدُ الرِمامُ الدودا",30,"د",2,0],["الجائِبُ الصَخرَ العَتيدَ بِحاجِرٍ","دَبَّ الزَمانُ وَشَبَّ في أَسرابِهِ",31,"ب",2,0],["الجَوُّ أَضيَقُ ما لاقاهُ ساطِعُها","وَمُقلَةُ الشَمسِ فيهِ أَحيَرُ المُقَلِ",32,"ل",1,0],["الجَيشُ جَيشُكَ غَيرَ أَنَّكَ جَيشُهُ","في قَلبِهِ وَيَمينِهِ وَشِمالِهِ",33,"ل",2,0],["الجسد البالغ في لينه","تعشقه الروح ولا تفركه",34,"ك",2,1],["الجسم منه مفرد ومركب","والماء منه مركب وبسيطُ",35,"ط",1,1],["الجاعِلينَ عَلى عِلّاتِ دَهرِهِمُ","كَرائِمَ المالِ في الإِنعامِ وَالصَفَدِ",36,"د",1,0],["أَلِجُرمٌ جَنَيتُ حَرَّمتِ وَصلي","أَم لِذَنبٍ أَتَيتُ حَلَّلتِ هَجري",37,"ي",1,0],["الجودُ لا يَنفَكُّ حامِدُهُ","وَالبُخلُ لا يَنفَكُّ لائِمُهُ",38,"م",2,1],["الجَيشُ الحَيا في مَأقَظِ الرَوضِ مَعرَكٌ","كَأَنَّ لَهُ ثائِراً عَلى الأَرضِ يُدرَكُ",39,"ك",1,1],["الجو ملك النسر يغشاه على","ما يشتهي والغاب للآسادِ",40,"د",1,0],["الجامُ يبكي لوعةً أم أنا","جامي غريبٌ وفؤادي غريب",41,"ب",1,0],["الجراحات التي عانيتها","لم تدع أرواحنا إلا ذماء",42,"ا",2,0],["الجَوُّ أَكلَفُ وَالجَنابُ لِفَقدِهِ","مَحلٌ وَذاكَ الشِقُّ شِقٌّ مُظلِمُ",43,"م",1,0],["الجِدُّ وَالهَزلُ في تَوشيعِ لُحمَتِها","وَالنُبلُ وَالسُخفُ وَالأَشجانُ وَالطَرَبُ",44,"ب",1,0],["الجِدُّ شيمَتُهُ وَفيهِ فُكاهَةٌ","سُجُحٌ وَلا جِدٌّ لِمَن لَم يَلعَبِ",45,"ب",1,0],["الجُندُ سَمحٌ والخليفةُ صَالحٌ","والأمرُ وَافٍ ما بهِ نُقْصانُ",46,"ن",1,0],["الجِنُّ مِلءُ الأرضِ زَالَ حِجَابُهم","فَلَهُمْ بها بَعدَ الخَفاءِ ظهورُ",47,"ر",1,0],["الجهادُ الحرُّ يقضي حقَّه","سُؤددُ العُربِ ويحميهِ العلَمْ",48,"م",1,0],["الجيشُ صَعبُ البأس وال","أسطولُ مَرهوبُ الوُثوبْ",49,"ب",1,0],["الجلاءَ الجلاءَ يا أمّةَ السك","سونِ عن مصرَ والزِّيالَ الزّيالا",50,"ل",2,0],["الجَوُّ يَهتِفُ لِلمَلائِكِ خاشِعاً","وَالأَرضُ تَشهَدُ صَولَةَ الجِنّانِ",51,"ن",1,0],["الجُندُ مَعقودُ اللِواءِ لِفَيصَلٍ","بَينَ الظُبى وَعَوامِلِ المُرّانِ",51,"ن",1,0],["الجاهليةُ قد عفَت