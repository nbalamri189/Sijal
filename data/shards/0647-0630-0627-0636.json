{"poems":[[93,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[186,"هذا ضريح كريم قوم فوقه","https://www.aldiwan.net/poem61132.html","الكامل"],[186,"هذا ضريح طبيبنا الشهم الذي","https://www.aldiwan.net/poem61189.html","الكامل"],[189,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[227,"ما حيلة المفئود في حساده","https://www.aldiwan.net/poem41924.html","الكامل"],[241,"هذا ضريحك يا أبا غالب","https://www.aldiwan.net/poem18054.html","الكامل"],[241,"هذا ضريح خديمأهل وزان","https://www.aldiwan.net/poem19292.html","البسيط"],[241,"هذا ضريحك يا عياض","https://www.aldiwan.net/poem19302.html","مجزوء الكامل"],[274,"يا أيها العربي في التاريخ","https://www.aldiwan.net/poem34998.html","الكامل"],[324,"هذا ضريح أخي علا","https://www.aldiwan.net/poem61610.html","مجزوء الكامل"],[324,"هذا ضريح أخي المحامد والتقى","https://www.aldiwan.net/poem61617.html","الكامل"],[433,"هذا ضريح تقي كان ذا عمل","https://www.aldiwan.net/poem39844.html","البسيط"],[482,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[503,"نحن الرفاعية الأعلام ما برحت","https://www.aldiwan.net/poem38016.html","البسيط"],[565,"هذا ضريح للشهاب أميرنا","https://www.aldiwan.net/poem52646.html","الكامل"],[565,"هذا ضريح كريمة قد هاجرت","https://www.aldiwan.net/poem52647.html","الكامل"],[565,"هذا ضريح الفاضل الشهم الذي","https://www.aldiwan.net/poem52650.html","الكامل"],[565,"هذا ضريح الذي ما زال من قدم","https://www.aldiwan.net/poem52666.html","البسيط"],[565,"هذا ضريح كريم قوم فاضل","https://www.aldiwan.net/poem52692.html","الكامل"],[565,"هذا ضريح فتى بنعمة ربه","https://www.aldiwan.net/poem52698.html","الكامل"],[565,"هذا ضريح لابن خياط به","https://www.aldiwan.net/poem52704.html","الكامل"]],"verses":[["هَذا ضَلالٌ مِنَ القَضاءِ","فَلا تَلُمني إِذا أَلومُ",0,"م",1,0],["هذا ضميرُ النّشأةِ الأولى الّتي","بَدَأ الإلهُ وغَيبُها المكنون",1,"ن",1,0],["هذا ضياءُ العدل بدّد ظلمهم","كالليل بدّدهُ الضُّحَى بمنارِهِ",2,"ر",2,0],["هَذا ضَريحُ كَريمِ قَومٍ فَوقَهُ","تُتلَى المَراحمُ في ضُحىً وأَصيلِ",3,"ل",1,1],["هَذا ضَريحُ طَبيبِنا الشَهمِ الَّذي","قَصَفَت شَبيبتَهُ يَدُ الأَقدارِ",4,"ر",1,1],["هذا ضياءُ اللهِ والمعنى الذي","تتَفاضلُ العلماءُ في تعليله",5,"ل",2,0],["هذا ضَعيفٌ لا يَميلُ بِهِ الهَوى","إِلّا وَيعزفه عَلى أَعوادِهِ",6,"د",2,0],["هَذَا ضَريحُكَ يَا أَبا غَالِبْ","شَاهِدُ سِرِّكَ فيه لاَ غائِبْ",7,"ب",1,1],["هَذَا ضَرِيحُ خَدِيِمأَهْلِ وَزَّانِ","أَعْيَانِ سَادَاتِنَا سَادَاتِ أَعْيَانِ",8,"ن",1,1],["هَذَا ضَرِيحُكَ يَا عِيَاضُ","يَا مَنْ شِفَاهُ شِفَا الْمِرَاضْ",9,"ض",1,1],["هذا ضميرُكَ صارخٌ فأصخ إلى","صوتِ الضميرِ وخَف من التوبيخ",10,"خ",1,0],["هَذا ضَريحُ أَخي عَلا","جَمعِ المَحامِدِ وَالفَخارِ",11,"ر",1,1],["هَذا ضَريحُ أَخي المَحامِدِ وَالتُقى","مَن كانَ فَذا في المُروءَةِ أوجِدا",12,"د",2,1],["هذا ضريح تقي كان ذا عملٍ","يرضي البرية من راءٍ ومستمعِ",13,"ع",1,1],["هذا ضريحك بالجلاز مقتبس","أنوار صاحبه الحامي مريديه",14,"ي",2,0],["هذا ضَمانٌ قَديمٌ خُطَّ في صُحُفٍ","غَيْبِيَّةٍ ولها المُخْتارُ سَبَّارُ",15,"ر",1,0],["هذا ضريحٌ للشِّهابِ أميرِنا","سَلمانَ قد أمسَى يُكلّلُهُ النَّدَى",16,"د",2,1],["هذا ضريحُ كريمةٍ قد هاجَرَت","دراَ الحُسينِ سُلالةِ البربيرِ",17,"ر",1,1],["هذا ضريحُ الفاضلِ الشَّهمِ الذي","قد فازَ بالمجدِ الذي لا يُوصَفُ",18,"ف",1,1],["هذا ضريح الذي ما زالَ من قدَمٍ","بالصَّبرِ والفضلِ والآدابِ مُشتَهِرا",19,"ر",2,1],["هذا ضريحُ كريمِ قومٍ فاضلٍ","فَقَدتْ بنُو الدَّهَّانِ صبراً إذ فُقِدْ",20,"د",1,1],["هذا ضريحُ فتىً بنعمةِ ربِّهِ","ولَّى فأعطاهُ نعيمَ سماءِ",21,"ا",2,1],["هذا ضريحٌ لابنِ خيَّاطٍ بهِ","قد غابَ عنَّا كوكبٌ تحتَ الثَّرَى",22,"ر",2,1]]}