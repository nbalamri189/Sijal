{"poems":[[93,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[186,"هذا ضريح كريم قوم فوقه","https://www.aldiwan.net/poem61132.html","الكامل"],[186,"هذا ضريح طبيبنا الشهم الذي","https://www.aldiwan.net/poem61189.html","الكامل"],[189,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[228,"ما حيلة المفئود في حساده","https://www.aldiwan.net/poem41924.html","الكامل"],[242,"هذا ضريحك يا أبا غالب","https://www.aldiwan.net/poem18054.html","الكامل"],[242,"هذا ضريح خديمأهل وزان","https://www.aldiwan.net/poem19292.html","البسيط"],[242,"هذا ضريحك يا عياض","https://www.aldiwan.net/poem19302.html","مجزوء الكامل"],[275,"يا أيها العربي في التاريخ","https://www.aldiwan.net/poem34998.html","الكامل"],[325,"هذا ضريح أخي علا","https://www.aldiwan.net/poem61610.html","مجزوء الكامل"],[325,"هذا ضريح أخي المحامد والتقى","https://www.aldiwan.net/poem61617.html","الكامل"],[435,"هذا ضريح تقي كان ذا عمل","https://www.aldiwan.net/poem39844.html","البسيط"],[484,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[505,"نحن الرفاعية الأعلام ما برحت","https://www.aldiwan.net/poem38016.html","البسيط"],[567,"هذا ضريح للشهاب أميرنا","https://www.aldiwan.net/poem52646.html","الكامل"],[567,"هذا ضريح كريمة قد هاجرت","https://www.aldiwan.net/poem52647.html","الكامل"],[567,"هذا ضريح الفاضل الشهم الذي","https://www.aldiwan.net/poem52650.html","الكامل"],[567,"هذا ضريح الذي ما زال من قدم","https://www.aldiwan.net/poem52666.html","البسيط"],[567,"هذا ضريح كريم قوم فاضل","https://www.aldiwan.net/poem52692.html","الكامل"],[567,"هذا ضريح فتى بنعمة ربه","https://www.aldiwan.net/poem52698.html","الكامل"],[567,"هذا ضريح لابن خياط به","https://www.aldiwan.net/poem52704.html","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110477","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110457","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110471","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86993","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86709","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48666","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38146","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38282","المجتث"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59780","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109231","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109188","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109258","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49087","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49084","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109018","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108994","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52049","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52042","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52095","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110342","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109497","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109493","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109530","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109478","السريع"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47141","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47124","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137152",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94210","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109865","الكامل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147329","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46029","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132161","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122293","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114145","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29302","المجتث"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70011","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91041","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45055","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45058","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45066","المجتث"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136437",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52200","الكامل"],[4702,"انتي عن اربع وبعدك يحرم الطاري","https://www.poetsgate.com/ViewPoem.aspx?id=155324",""],[4935,"هذا ضريح فيه حلت فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=129522",""],[5956,"ابتهال","https://www.poetsgate.com/ViewPoem.aspx?id=192509",""]],"verses":[["هَذا ضَلالٌ مِنَ القَضاءِ","فَلا تَلُمني إِذا أَلومُ",0,"م",1,0],["هذا ضميرُ النّشأةِ الأولى الّتي","بَدَأ الإلهُ وغَيبُها المكنون",1,"ن",1,0],["هذا ضياءُ العدل بدّد ظلمهم","كالليل بدّدهُ الضُّحَى بمنارِهِ",2,"ر",2,0],["هَذا ضَريحُ كَريمِ قَومٍ فَوقَهُ","تُتلَى المَراحمُ في ضُحىً وأَصيلِ",3,"ل",1,1],["هَذا ضَريحُ طَبيبِنا الشَهمِ الَّذي","قَصَفَت شَبيبتَهُ يَدُ الأَقدارِ",4,"ر",1,1],["هذا ضياءُ اللهِ والمعنى الذي","تتَفاضلُ العلماءُ في تعليله",5,"ل",2,0],["هذا ضَعيفٌ لا يَميلُ بِهِ الهَوى","إِلّا وَيعزفه عَلى أَعوادِهِ",6,"د",2,0],["هَذَا ضَريحُكَ يَا أَبا غَالِبْ","شَاهِدُ سِرِّكَ فيه لاَ غائِبْ",7,"ب",1,1],["هَذَا ضَرِيحُ خَدِيِمأَهْلِ وَزَّانِ","أَعْيَانِ سَادَاتِنَا سَادَاتِ أَعْيَانِ",8,"ن",1,1],["هَذَا ضَرِيحُكَ يَا عِيَاضُ","يَا مَنْ شِفَاهُ شِفَا الْمِرَاضْ",9,"ض",1,1],["هذا ضميرُكَ صارخٌ فأصخ إلى","صوتِ الضميرِ وخَف من التوبيخ",10,"خ",1,0],["هَذا ضَريحُ أَخي عَلا","جَمعِ المَحامِدِ وَالفَخارِ",11,"ر",1,1],["هَذا ضَريحُ أَخي المَحامِدِ وَالتُقى","مَن كانَ فَذا في المُروءَةِ أوجِدا",12,"د",2,1],["هذا ضريح تقي كان ذا عملٍ","يرضي البرية من راءٍ ومستمعِ",13,"ع",1,1],["هذا ضريحك بالجلاز مقتبس","أنوار صاحبه الحامي مريديه",14,"ي",2,0],["هذا ضَمانٌ قَديمٌ خُطَّ في صُحُفٍ","غَيْبِيَّةٍ ولها المُخْتارُ سَبَّارُ",15,"ر",1,0],["هذا ضريحٌ للشِّهابِ أميرِنا","سَلمانَ قد أمسَى يُكلّلُهُ النَّدَى",16,"د",2,1],["هذا ضريحُ كريمةٍ قد هاجَرَت","دراَ الحُسينِ سُلالةِ البربيرِ",17,"ر",1,1],["هذا ضريحُ الفاضلِ الشَّهمِ الذي","قد فازَ بالمجدِ الذي لا يُوصَفُ",18,"ف",1,1],["هذا ضريح الذي ما زالَ من قدَمٍ","بالصَّبرِ والفضلِ والآدابِ مُشتَهِرا",19,"ر",2,1],["هذا ضريحُ كريمِ قومٍ فاضلٍ","فَقَدتْ بنُو الدَّهَّانِ صبراً إذ فُقِدْ",20,"د",1,1],["هذا ضريحُ فتىً بنعمةِ ربِّهِ","ولَّى فأعطاهُ نعيمَ سماءِ",21,"ا",2,1],["هذا ضريحٌ لابنِ خيَّاطٍ بهِ","قد غابَ عنَّا كوكبٌ تحتَ الثَّرَى",22,"ر",2,1],["هذا ضريحُ الفاضلِ الشهمِ الذي","أَودى بغُصنِ صِباهُ بينٌ ظالمٌ",23,"م",1,1],["هذا ضريحٌ لابن بدران الذي","أجرَى الدموعَ لفقدهِ كالعندَمِ",24,"م",1,1],["هذا ضريحٌ للدمشقيّ الذي","أبكى بني الشاميّ دمعاً قد هَمَى",25,"م",2,1],["هَذا ضَريح كَريمة مَرحومة","سَلَكَت بِدُنياها طَريق الحَقِّ",26,"ق",1,1],["هَذا ضَريح النَقشبندي الَّذي","هُوَ في التُقى بَينَ البَرية أَوحَدُ",27,"د",1,1],["هذا ضياء الدين شرَّفَ أرضَكم","فاستقبلوه اليوم محتفلينا",28,"ن",2,0],["هَذا ضَريحُ العالمِ الن","نِحريرِ ذي الطّبعِ السليمِ",29,"م",1,1],["هَذا ضَريحُ عليّ","يبدو كرَوضٍ بهيِّ",30,"ي",1,1],["هذا ضريح حله متوسد","مذخورة لجزائه الحسنات",31,"ت",1,0],["هذا ضريح رأفةُ الرب اقتضت","أن تنعم الأعضاء وهي رفات",31,"ت",1,0],["هذا ضريح الطيب السرائر","الطاهر بن الطاهر بن الطاهر",32,"ر",1,1],["هذا ضريح الوالدين فقف به","متخشعاً وقل السلام عليكما",33,"م",2,1],["هذا ضريح فتى تخوف ربُّه","فيه تحاسد خلقه فاختاره",34,"ر",2,0],["هذا ضريحُ فتى الشجاعة والندى","مَن رسمه طيّ القلوب دفينُ",35,"ن",1,1],["هذا ضريحُ فتى الشجاعةِ والنَّدى","وكفته نسبتُه إلى الطُّرشانِ",36,"ن",1,1],["هذا ضريح ابن الكحيل الذي","جرَّبه اللَه بداءٍ أليم",37,"م",1,1],["هذا ضريح الذي كانت مكارمه","للمبتلى بسموم الفقر درياقا",38,"ق",2,1],["هَذا ضَريحٌ لِلهُمَامِ الأمجَدِ","نَجمِ المُلوكِ السَّيدِ ابنِ السَّيِّدِ",39,"د",1,1],["هَذا ضَرِيحُ مُحَمَّدِ الورَغِي الذي","فِي كُلّ فَنّ فَضْلُهُ لا يُجْحَدُ",40,"د",1,1],["هذا ضريحٌ قد حوَى منْ حَصّلَتْ","بالقول وَالفعلِ الجمِيلِ مَرَامَهَا",41,"م",3,0],["هذا ضيائك امسينا نضارعه","سقماً فنحن وأنت اليوم آثار",42,"ر",1,0],["هذا ضريح نفيسة المجد التي","قضت الحياة تعفُّفاً وتَدَيُّنا",43,"ن",2,1],["هذا ضريح محمد الدبس الذي","عند الإله له الثوابُ جزيلُ",44,"ل",1,1],["هذا ضريح كروض فوقه صدحت","بلابل العفو من رب السما كرما",45,"م",2,1],["هذا ضريحٌ حله فارسٌ","كما تحل الشمسُ برجَ الحمَل",46,"ل",1,1],["هذا ضريحٌ حَلَّهُ شاكِيرُ مَنْ","هصر المنى والعزّ غُصْناً مُثْمِرَا",47,"ر",2,0],["هذا ضريحٌ يَا لَهُ من مشهدٍ","غَربَتْ به شمسُ البشيرِ محمّدِ",48,"د",1,1],["هذا ضَمير العالم المَوجود عَن","عَدم وَسرّ وجوده المستودع",49,"ع",1,0],["هذا ضريح نسيب باشا من الى","اجداده الشرف الاثيل قد انتسب",50,"ب",1,1],["هذا ضريح للمحدث الإمام","الليث أحمد بن سعد الهمام",51,"م",1,1],["هذا ضريح ضم لوسيا التي","لاقت سميتها بدار نعيم",52,"م",1,1],["هَذَا ضُحَايَ يُرَبِّي الشَّمْسَ مُحْتَرِفًا","بِإِبْرَةِ الضَّوْءِ نَسَّاجًا شَذَا سُحُبِيْ",53,"ب",2,0],["هذا ضَريحُ ابن الشّهابِ ذَوى بِهِ","غُصنُ الشَّبابِ غَريق بَحر زاخِر",54,"ر",1,1],["هذا ضريح فرنسوا الأمّ التي","تركت كأفراخ القطا أولادها",55,"د",3,1],["هذا ضريح للشهيد السامي","للدين نور ناصر الإسلام",56,"م",1,1],["هَذَا ضَرِيحُ أبِي الرَّبِيعِ شَمسِ ضُحًى","لَهُ بِبَيتِ نُبُوَّةٍ شَمَاريخُ",57,"خ",1,1],["هذا ضَجيجُ اللَيالي","سُدَّت بِهِ أُذُناكا",58,"ك",2,1],["هَذا ضَريح الفَتى المَفقود عَن صغرٍ","مِن بَيت يوسف مَن طالَت مَناحتهُ",59,"ت",2,1],["هذا ضريح ضم خير سمبة","لخديجة زوج النبي العدناني",60,"ن",2,1],["هَذا ضَريحٌ قَد حَوى","رَوضات جَناتٍ نَضيرَه",61,"ر",2,0],["هَذا ضَريحُ مُحَمَّدٍ بنِ عُزَيِّزٍ","مَحمودِ ذي المَجدِ الأَصيلِ النابِهِ",62,"ب",2,0],["هَذا ضَريحٌ لَدَيهِ","تَعَجبي يَستَمِر",63,"ر",1,0],["هذا ضريح ضمنه سيدٌ","لآل فتح الله ينمي شريف",64,"ف",1,1],["هذا ضريح الطيّبين فقِف بِهِ","وانثُرْ عليه طيّيباتِ زهورِ",65,"ر",1,1],["هذا ضمان المحبة جاك بختومه","والا المنية بعلم الخالق الباري",66,"ر",2,0],["هذا ضريح فيه حلت فاطمة","من بالتقى لله كانت قائمة",67,"م",2,1],["هذا ضياؤك في قلبي وفي رئتي","غذاءُ روحي وإيماني مدى الحِقَبِ",68,"ب",1,0]]}