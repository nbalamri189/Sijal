{"poems":[[47,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[63,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[71,"بأيمن جرعاء الكثيب خيام","https://www.aldiwan.net/poem28765.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[47,"لَنَا أبَداً بَثٌّ نُعانيهِ من أرْوَى","https://www.poetsgate.com/ViewPoem.aspx?id=31686",""],[119,"لي قلب على المحبة قد شب","https://www.aldiwan.net/poem40874.html","عموديه"],[154,"أروح على ذكر النبي وأغتدي","https://www.aldiwan.net/poem68602.html","الطويل"],[173,"أراه الهوى ما لم يكن في حسابه","https://www.aldiwan.net/poem1608.html",""],[266,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[409,"ما المنحنى قصده ورامه","https://www.aldiwan.net/poem33422.html","مخلع البسيط"],[463,"صديق يداري الحزن عنك مماذق","https://www.aldiwan.net/poem56103.html","الطويل"],[469,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[469,"إلا يا دار لا أوحشت يوماً","https://www.aldiwan.net/poem3402.html","عموديه"],[556,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44594","الوافر"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130208","الطويل"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19937","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20467","المتقارب"],[2286,"","https://poetry.dctabudhabi.ae/diwan/poem/143200","المتقارب"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144430","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85040","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136612",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52192","البسيط"]],"verses":[["سَلا عَن عَقابيلِ الشَبابِ وَفَوتِها","أَطارَت بِها العَنقاءُ أَم سَبَقَت جَلوى",0,"و",2,0],["سَلاّ عليه سيوفَ البَغْيِ مُصْلَتةً","في جَحْفَلٍ من شَنيعِ الظُّلْمِ جرَّارِ",1,"ر",1,0],["سلا عنْ فؤادٍ ما سلا لكنِ انسلى","أصابتهُ عنْ قوسِ الفراقِ سهامُ",2,"م",1,0],["سَلا عُلَماءَ الجانِبَينِ وفِتْيَةً","أبَنّوهُما حتى مَفارِقُهمْ شُمْطُ",3,"ط",1,0],["سَلاَ عَنْ عَقابيلِ الشّبابِ وَفَوْتِهَا،","أطارَتْ بِهِ العَنْقَاءُ أمْ سَبَقَتْ جَلوَى",4,"و",2,0],["سلا عن حبيبه فافاقا","اين هذا وفي القلوب اما كن",5,"ن",1,0],["سَلا عَن هَوى دُنياهُ أَقطَعَ سَلوَةٍ","فَأَدرَكَ مِن مَولاهُ أَرفَعَ حُظوَةٍ",6,"ه",1,0],["سَلا عَنهُ غِزلانُ القُرَيَّةِ أَيُّها","غَدا بِبقايا لُبِّهِ في نهابِهِ",7,"ب",2,0],["سلا عن ربي سلع فأعين عينها","تجرد بيض الهند سود جفونها",8,"ن",3,1],["سَلا عَنْ سَلا مذْ ظلَّها العَارِضُ الذِي","أَطَلَّ عَلَى مَرَّاكش يحْمِلُ الصعْقَا",9,"ق",2,0],["سلا عن الغانيات قلب","إن السلو في الهوى سلامه",10,"م",2,0],["سلا عنه في أيّ المفاوز فاتني","وطرفي له راعٍ وطِرفِيَ سابقُ",11,"ق",1,0],["سلا عنك قلبي بعد ما قيل لا يسلو","فلا طل دمعي للطول ولا الوبل",12,"ل",1,1],["سلا عني ولما أسلُ عنهُ","فواقلقي لثاوٍ مطمئنٍ",13,"ن",1,0],["سلا عنّا المنازلَ لِمْ بَلينا","ولا سَقَمٌ بهنّ ولا هَوِينا",14,"ن",2,1],["سَلا عَن حُبِّكَ القَلبُ المَشوقُ","فَما يَصبو إِلَيكَ وَلا يَتوقُ",15,"ق",1,1],["سلا عن عهود سالفات قديمة","وأهنا ليال بالسرور تقضت",16,"ت",1,1],["سلاعبد الأعلى حيث أوفى عشيةً","خزازي ومد الطرف هل آنس النجدا",17,"د",2,0],["سَلا عَن تَذَكُّرِهِ تُكتَما","وَكانَ رَهيناً بِها مُغرَما",18,"م",2,1],["سلا عن هواه فلما رأى","سلاسل أصداغه ما سلا",19,"ل",2,0],["سلا عن بانةَ الطَّلَلَ اليبابا","بحيث يقابلُ البرقُ الهضابا",20,"ب",2,1],["سَلا عَنّي فَإِنّي مُستَهامٌ","وَسَيِّرا بي فَقَد طالَ المَقامِ",21,"م",1,1],["سلا عن حبيب القلب هل قرَّ عيشهُ","غداةَ نوانا واستلذَّ المَناهلا",22,"ل",2,0],["سلا عُهودَ الهوى وباحا","أيَّ هوىً ويحَهُ أباحا",23,"ح",2,1]]}