{"poems":[[74,"زحفت بيض الظبا لما رنا","https://www.aldiwan.net/poem20619.html","الرمل"],[94,"أنت يا شعر فلذة من فؤادي","https://www.aldiwan.net/poem38953.html","الخفيف"],[87,"منك يا هاجر دائي","https://www.aldiwan.net/poem63683.html","مجزوء الرمل"],[46,"داب عيني البكاء والحزن دابي","https://www.aldiwan.net/poem30320.html","الخفيف"],[104,"أنشدي يا صبا","https://www.aldiwan.net/poem32974.html","المتدارك"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202706",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54531","الخفيف"],[347,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[484,"فيك يحلو الغزل","https://www.aldiwan.net/poem36917.html","مجزوء الرمل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83320","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123285","الدوبيت"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103729","الرمل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97872","الرمل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126926","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216530","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128895","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95358","المديد"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95357","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73284","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136675",""],[5199,"اذكرينى","https://www.poetsgate.com/ViewPoem.aspx?id=145548",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5431,"أجمل القول ماارتضته العقولُ","https://www.poetsgate.com/ViewPoem.aspx?id=198172",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5631,"نَوَّاتُ الحَنينِ","https://www.poetsgate.com/ViewPoem.aspx?id=211085",""],[5853,"تباريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175697",""],[6102,"فواتير","https://www.poetsgate.com/ViewPoem.aspx?id=184556",""]],"verses":[["فيكَ يا أشهلُ عبدُ الأشهلِ","آه ما أكثرَ فيكَ المللا",0,"ل",2,0],["فيكَ يبدو خريفُ نَفْسي مَلُولاً","شاحِبَ اللَّوْنِ عاريَ الأُمْلودِ",1,"د",1,0],["فيكَ يمشي شتاءُ أَيَّاميَ البا","كي وتُرغي صَوَاعقي ورُعُودي",1,"د",2,0],["فيكَ يا راحَةَ روحي","طالَ بِالواشي عَنائي",2,"ا",3,0],["فيكَ يا أَحمَدَ بنَ هارونَ خَصَّت","ثُمَّ عَمَّت رَزيئَتي وَمُصابي",3,"ب",2,0],["فيك يا وَردَتي","قَد حَلا لي الجُنون",4,"ن",1,0],["فيك يا شعر أَنا","قد صرفت العمرا",5,"ر",2,0],["فيكِ يا مَهبِطَ الجَمالِ فُنونٌ","لَيسَ فيها عَنِ الكَمالِ قُصورُ",6,"ر",1,0],["فيك يا راحة روحي","طال بالوشي عَنائي",7,"ا",3,0],["فِيكَ يَا لَيْلُ كَمْ تَرَى العَيْنُ","آياتِ جَمَالِ مُجْدٍ وَرَوَاءِ",8,"ا",2,0],["فيك يا ربة الجمال معاني","كل ما في المكان جمعاً وفردا",9,"د",2,0],["فيكَ يا دهرُ مُقْعدي ومُقيمي","أمَلٌ جامحٌ وحَظٌّ حَرون",10,"ن",1,0],["فيك يحلو الغزل","فيك يلغى العذل",11,"ل",1,1],["فيكَ يَأتي القَريضُ مُنتَظِماً عَف","واً وَتَنسابُ وَحدَها الأَقلامُ",12,"م",1,0],["فيك يا كُريما عنيقيد عالي ما أوصله","حامض وحش ما استوى أفّو على شكله",13,"ه",1,1],["فيك يلتذُ ارتياح","أبد الدهر وسكر",14,"ر",1,0],["فيك يحلو لي سُهادي","ووفائي بالعهود",15,"د",1,0],["فيك يا بضمة خير الأنبياء","أنني من عللي أرجو الشفاء",16,"ا",2,0],["فيك يا حب كل هذا فبعداً","لك داءً ترياقه ممنوع",17,"ع",1,0],["فيك يا ليل كل شيء عجيب","أنت يا ليل سينماء الحياة",18,"ه",1,0],["فيك يا أغلوطة الفكر","تاه عقلي وانقضى عمري",19,"ر",2,1],["فيك يا أعجوبة الكون","غدا الفكر كليلا",20,"ل",2,1],["فيكَ يا كُلَّ الأَماني","مُجمَلُ الحُسنِ مُفَصَّل",21,"ل",1,0],["فيكَ يُشفى العَليل من كل داءٍ","إن أعانَ القضاءُ والأقدار",22,"ر",1,0],["فيك يامن لجل خاطرك أحتفاء","بروح ياقوتك وبحساس الشهد",23,"د",1,0],["في كيان موحَّدٍ مُتنامٍ","كبناءٍ علا بغيرِ شُقوق",24,"ق",1,0],["فيك يسري مؤججا باشتعالٍ","واقتحامٍ لنشوةٍ قد تطولُ",25,"ل",1,0],["فيك يوم بألف شهرٍ عظيمٌ","سُبحة الروح وِرْده الفتّانُ",26,"ن",1,0],["في كِيسها طنٌّ من الآهاتِ والدَّ","مْعاتِ.. تغرِفُ منهُ لي وتوزِّعُ",27,"ع",1,0],["فيكِ يا قدسُ تباريحُ الهوى","كيف تُخفى دمعةُ الأقصى وتُحجبْ؟؟",28,"ب",1,0],["فَيَكِيلُونَ لَكمَهُمْ بِالتِذاذٍ","وَ يُطِيلُونَ لَطمَهُمْ بِانتِشاءِ !",29,"ا",2,0]]}