{"poems":[[95,"سلام عليكم والفواد المسلم","https://www.aldiwan.net/poem11363.html","الطويل"],[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[49,"لي صديق على الزمان صديقي","https://www.aldiwan.net/poem25219.html","الخفيف"],[74,"لي صاحب ترك المليح وعاد في","https://www.aldiwan.net/poem18749.html","الكامل"],[74,"لي صنان أعاذك الله منه","https://www.aldiwan.net/poem19149.html","الخفيف"],[74,"أبكيك للحسنين الخلق والخلق","https://www.aldiwan.net/poem19356.html","البسيط"],[74,"لي صديق سيد سند","https://www.aldiwan.net/poem19450.html","المديد"],[74,"لي صديق يسوءني","https://www.aldiwan.net/poem20019.html","مجزوء الخفيف"],[53,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"لي صديق إذا رأت","https://www.aldiwan.net/poem62008.html","مجزوء الخفيف"],[53,"لي صديق جاهلي","https://www.aldiwan.net/poem65826.html","مجزوء الرمل"],[53,"لي صديق صامتي","https://www.aldiwan.net/poem65960.html","مجزوء الرمل"],[53,"لي صديق إذا تنوول عرضي","https://www.aldiwan.net/poem66511.html","الخفيف"],[93,"لي صاحب دخل الغرور فؤاده","https://www.aldiwan.net/poem8722.html","عموديه"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[72,"لي صاحب غاب عني","https://www.aldiwan.net/poem42384.html","المجتث"],[72,"لي صاحب غبت عنه","https://www.aldiwan.net/poem42678.html","المجتث"],[87,"أنا بنت البر أم الفقرا","https://www.aldiwan.net/poem7749.html","الرمل"],[47,"لي صاحب ليس يخلو","https://www.aldiwan.net/poem62727.html","المجتث"],[47,"غلس الشيب أو تعجل ورده","https://www.aldiwan.net/poem62743.html","الخفيف"],[47,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[63,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[68,"لي صديق لا يعرف الصدق في القو","https://www.aldiwan.net/poem38619.html","الخفيف"],[68,"لي صاحب إن خانني دهري وفى","https://www.aldiwan.net/poem40947.html","الكامل"],[82,"لي صديق محض النصيحة كالمر","https://www.aldiwan.net/poem31345.html","الخفيف"],[46,"قل للأمير الأريحي الذي","https://www.aldiwan.net/poem30521.html","السريع"],[71,"لي صديق صنان إبطيه صعب","https://www.aldiwan.net/poem28429.html","الخفيف"],[71,"لي صاحب وهو نحوي له ذهب","https://www.aldiwan.net/poem28675.html","البسيط"],[71,"لي صاحب واسمه سراج","https://www.aldiwan.net/poem28935.html","مخلع البسيط"],[83,"لي صاحب ترك النساء تظرفا","https://www.aldiwan.net/poem61474.html","الكامل"],[104,"حبذا لو يصوم منا زعيم","https://www.aldiwan.net/poem33022.html","البسيط"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[77,"لي صارم وهو شيعي كحامله","https://www.aldiwan.net/poem69043.html","البسيط"],[50,"لي صاحب أثقل من أحد","https://www.aldiwan.net/poem62607.html","السريع"],[50,"يا معرضا نفسي الفداء","https://www.aldiwan.net/poem64363.html","مجزوء الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9542","الرجز"],[108,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[108,"أنف كبير","https://www.poetsgate.com/ViewPoem.aspx?id=179740",""],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[175,"لي صديق غدا وإن كان لاينطق","https://www.aldiwan.net/poem4260.html","الخفيف"],[190,"لي صديق من بني ال","https://www.aldiwan.net/poem43342.html","مجزوء الرمل"],[190,"لي صاحب دغل على علاته","https://www.aldiwan.net/poem43479.html","الكامل"],[190,"لي صديق صدقاته نفر السب","https://www.aldiwan.net/poem43565.html","الخفيف"],[190,"لي صديق يلومني في انفرادي","https://www.aldiwan.net/poem43842.html","الخفيف"],[190,"لي صديق بلدي","https://www.aldiwan.net/poem44115.html","مجزوء الرمل"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[245,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[245,"وملك وإن طال المدى سيبيد","https://www.aldiwan.net/poem45773.html","الطويل"],[260,"لي صديق جنى علي","https://www.aldiwan.net/poem48563.html","مجزوء الخفيف"],[265,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[275,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[301,"عتبت على دهري بأفعاله التي","https://www.aldiwan.net/poem33158.html","الطويل"],[307,"لي صاحب يتمنى لي الرضا أبدا","https://www.aldiwan.net/poem57588.html","البسيط"],[307,"لي صاحب في مصر يركب بغلة","https://www.aldiwan.net/poem57751.html","الكامل"],[309,"هذا بمصنعة الحفصية انسبكا","https://www.aldiwan.net/poem56439.html","البسيط"],[324,"لي صاحب عدمته","https://www.aldiwan.net/poem61689.html","مجزوء الرجز"],[375,"لي صاحب كلما ذكرت له","https://www.aldiwan.net/poem56986.html","المنسرح"],[381,"جلا مذ تجلى أعينا فيك تدمع","https://www.aldiwan.net/poem59341.html","الطويل"],[381,"ها مريم مولودة بعجيبة","https://www.aldiwan.net/poem59439.html","الرجز"],[413,"لي صديق أفضي إليه بسري","https://www.aldiwan.net/poem32321.html","الخفيف"],[441,"لي صديق من أبر الناس","https://www.aldiwan.net/poem2510.html","مجزوء الرمل"],[445,"أيا قاطع الحبل الذي إن قطعته","https://www.aldiwan.net/poem14468.html","الطويل"],[471,"لي صاحب حر من الأصحاب","https://www.aldiwan.net/poem60376.html","الكامل"],[482,"لي صاحب في كل ف","https://www.aldiwan.net/poem36987.html","مجزوء الكامل"],[509,"لي صديق خسرت فيه ودادي","https://www.aldiwan.net/poem2450.html","الخفيف"],[570,"لي صاحب لا يجتني","https://www.aldiwan.net/poem69668.html","مجزوء الكامل"],[578,"لي صاحب أضحى لودي محرزا","https://www.aldiwan.net/poem2706.html","الكامل"],[578,"لي صاحب أفديه من صاحب","https://www.aldiwan.net/poem2810.html","السريع"]],"verses":[["لِيَصْدُرْ هُدىً عَنْكُمْ يَعُمُّ بِلادَكُمْ","فَقَدْ آنَ لِلنُّزَّاقِ أَنْ يَتَحَمَّلُوا",0,"ل",3,0],["لِيَصُنْهُ مَنْ وَلاَّهُ وَلْيَكُ عَهْدُهُ","مِنْهُ الحَمِيدُ وَلَيْسَ فِيهِ ذَمِيمُ",1,"م",1,0],["لي صَديقٌ عَلى الزَمانِ صَديقي","وَرَفيقٌ مَعَ الخُطوبِ رَفيقي",2,"ق",2,1],["لي صاحب ترك المليح وعاد في","حبّ المليحة من ذوي الأقدار",3,"ر",1,1],["لي صنانٌ أعاذك الله منه","كم أواري إبطي به وأغطي",4,"ي",1,1],["ليصنع الدمع والتسهيد ما صنعا","فإن ذلك محمول على الحدق",5,"ق",1,0],["لي صديقٌ سيدٌ سندٌ","بيننا الآداب مشتركه",6,"ه",1,1],["لي صديقٌ يسوءني","ما يقاسي من الألم",7,"م",1,1],["لي صاحبٌ قد كنتُ آمُلُ نفعَهُ","سَبقتْ صواعقُهُ إليَّ صبيبَهُ",8,"ب",2,1],["لي صديقٌ إذا رأى لي طعاماً","لم يكد أن يجودَ لي بالشرابِ",9,"ب",1,0],["لي صديقٌ إذا رأت","وجهَهُ العينُ سرَّها",10,"ر",3,1],["لي صديقٌ جاهليٌّ","أخنقُ الناسِ لديكِ",11,"ك",1,1],["لي صديقٌ صامتيٌّ","قحطبيٌّ باحتيالِهْ",12,"ل",2,1],["لي صديقٌ إذا تُنوول عِرضي","أو رأى يوم نَوْبتي ذَبّ عني",13,"ن",2,1],["لِيَ صاحِبٌ دَخَلَ الغُرورُ فُؤادَهُ","إِنَّ الغُرورَ أُخَيَّ مِن أَعدائي",14,"ي",1,1],["لي صورَةُ الناسِ وَحاجاتِهِم","مِن مَطعَمٍ أَو مَشرَبٍ أَو رُقاد",15,"د",1,0],["لي صاحِبٌ غابَ عَنّي","فَقُلتُ أَمشي إِلَيهِ",16,"ي",2,1],["لي صاحِبٌ غِبتُ عَنهُ","وَلَستُ أَذكُرُ مَن هو",17,"ن",3,1],["لي صغار كلهم في المكتب","يتلقون به العلم المبين",18,"ن",1,0],["لي صاحِبٌ لَيسَ يَخلو","لِسانُهُ مِن جِراحِ",19,"ح",1,1],["لي صَديقٌ أَعدَدتُهُ لِصُروفٍ","مِن زَمانٍ يُربي عَلى مَن يُعِدُّه",20,"د",2,0],["لَيُصبِحَنَّ الرومُ جَيشٌ مُغمِدٌ","لِلصُبحِ في رَهَجانِهِ المُتَلَفِّفِ",21,"ف",1,0],["لِيَصْدُرَ عنكَ الشِّعرُ مالاً مسوَّماً","إذا نحنُ أوردناه دُرّاً مُثَقَّبا",22,"ب",2,0],["لي صَديقٌ لا يَعرِفُ الصِدقَ في القَو","لِ وَليسَ الصَديقُ إِلّا الصَدوقُ",23,"ق",1,1],["لي صاحِبٌ إِن خانَني دَهري وَفى","وَإِذا تَكَدَّرَتِ المَناهِلُ لي صَفا",24,"ف",2,1],["لي صديقٌ محْضُ النصيحة كالمر","آه إذ لا تريك منها اختلالا",25,"ل",2,1],["لي صاحِبٌ قَد كانَ لي مُؤنِساً","وَمَألَفاً في الزَمَنِ الغابِرِ",26,"ر",1,0],["لي صديقٌ صِنانُ إبْطيْهِ صَعْبٌ","عملَهُ تحتَ إبْطِهِ حيثُ مَرَّا",27,"ر",2,1],["لي صاحبٌ وهُو نحويٌّ لهُ ذهبٌ","يقولُ حينَ يرى في البخلِ عُذَّلَهُ",28,"ه",1,1],["لي صاحبٌ واسمهُ سراجٌ","ما قرَّ لي عندَهُ قرارُ",29,"ر",1,1],["لي صاحِبٌ تَرَكَ النِساءَ تَظَرُّفاً","مِنهُ وَمالَ إِلى هَوى الغِلمانِ",30,"ن",1,1],["لِيَصُمْ عنْ مبيعِه الأرضَ يحفظْ","بقعةً تستريحُ فيها عظامُهْ",31,"م",2,0],["لي صاحِبٌ قَد لامَني وَزادا","في تَركِيَ الصَبوحَ ثُمَّ عادا",32,"د",2,1],["لِي صاحِبٌ سَرَقَ اللُّصُوصُ ثِيابَهُ","لَيْلاً فباتَ بِبَيْتِهِ مَحْبُوسا",33,"س",2,0],["لي صارمٌ وهو شيعيٌّ كحامِلِهِ","يكادُ يسبِقُ كَرّاتي إلى البَطَلِ",34,"ل",1,1],["لي صاحِبٌ أَثقَلُ مِن أُحدِ","قَرينُهُ ما عاشَ في جَهدِ",35,"د",1,1],["لي صَبوَةٌ وَلَهُ السُلُو","وُ إِذا سَهِرتُ وَغَمَّضا",36,"ض",2,0],["لي صاحِبٌ مُختَلِفُ الأَلوانِ","مُتَّهَمُ الغَيبِ عَلى الإِخوانِ",37,"ن",1,1],["لي صاحبٌ واف، يزور مبكِّرًا","وتطول زورته سنين، وأشهرا",38,"ر",2,1],["لي صاحبٌ ظله خفيفُ","لأنفه دانت الأنوف",39,"ف",1,1],["ليصحب المرء في امريه منصرة","من اليقين بان الحال تنتقل",40,"ل",1,0],["لي صديقٌ غدا وإن كان لا","ينطق إلا بغيبةٍ أو محال",41,"ل",1,1],["لي صديق من بني ال","فياض ساءتني خلاله",42,"ل",2,1],["لي صاحبٌ دغل على علاته","متودّد ويقول ما لا يفعل",43,"ل",1,1],["لي صديق صدقاتهُ نفرُ السب","ت وأهل الكفور والتعليق",44,"ق",1,1],["لي صديق يلومني في انفرادي","وانقباضي عن زوجة وعشير",45,"ر",1,1],["لي صديق بلديّ","وجهه غيظ وكرب",46,"ب",1,1],["ليصنع زماني ما أراد فلن يرى","سوى ساعد يلقاه بالبأس مستد",47,"د",1,0],["ليصبح شملُ الأمرِ وهو منظمٌ","لسلطاننا المنصور وهو حميد",48,"د",1,0],["ليصبح شملُ الأمرِ وهو منظمٌ","ويصبحَ عنه الظلمُ وهو طريدُ",49,"د",1,0],["لي صديق جنى عل","ي مراراً فأكثرا",50,"ر",2,1],["ليصدق فيك الظن من غير ريبة","واكثر ما تلقي الظنون كواذبا",51,"ب",2,0],["لي صاحب يَشكو الديون فقضها","عنه وِبلغه الَّذي يَهواه",52,"ا",2,0],["ليصرِفَ عنّي فادِحاتِ نوائبٍ","أَضاقَ بِها ذَرعي وأَضنى بها جِسمي",53,"م",2,0],["لي صاحبٌ يتمنى لي الرضا أبداً","كأنما يختشى صدي وهجراني",54,"ي",1,1],["لي صاحبٌ في مصر يركب بغلةً","من غبنها ما صح قط ولا صحا",55,"ح",2,1],["لِيصعقَ الجورَ أَنشاهُ فأرّخهُ","صُورٌ بِقالبِ نصرِ الحقّ قَد سُبِكا",56,"ك",2,0],["لي صاحِبٌ عَدِمتُهُ","أَقبَحَ مِن رِجسٍ وَخَمرِ",57,"ر",1,1],["لي صاحِبٌ كلَّما ذكرتُ لهُ","بينَ حَبيبٍ تَفيضُ عَيناهُ",58,"ه",1,1],["ليصدُقَ فيهم نصُّ من جاء صادقاً","به أنَّ آذاناً لهم ليس تَسمع",59,"ع",1,0],["ليصدَّقَ الراوي بأن قد وُلِّدَت","بِكرٌ بلا نسلٍ مُقامٍ من أحدْ",60,"د",1,0],["لي صديقٌ أُفضِي إليهِ بسرّي","وخبَايا صَدري ومكنونِ قَلبي",61,"ب",2,1],["لي صديق من أبر الن","اس بي في الخلوان",62,"ن",1,1],["ليصبح حبلي عالقاً بحبالكا","ويرجع نقصي كاملاً بكمالكا",63,"ك",2,0],["لي صاحِبٌ حُرٌّ مِنَ الأَصحابِ","جَذَعُ التَواضُعِ قارِحُ الإِعجابِ",64,"ب",1,1],["لي صاحب في كل ف","ن من فنون العلم ناجح",65,"ح",1,1],["لي صديقٌ خسِرت فيه ودادي","حين صَارَت سلامتي منه ربحا",66,"ح",2,1],["لي صاحِبٌ لا يَجْتَني","منه مصاحبُهُ ثَمَرْ",67,"ر",1,1],["لي صاحبٌ أَضحى لودِّي مُحْرزَاً","ولكلِّ مل يهواه قَلْبي مُنْجِزا",68,"ز",2,1],["لي صاحبٌ أَفْديه من صاحبٍ","حُلْوُ التأَنِّي حسَنُ الإِحتيال",69,"ل",1,1]]}