etsgate.com/ViewPoem.aspx?id=856",""],[5564,"يالله يا فكّاك حبل المناشيب","https://www.poetsgate.com/ViewPoem.aspx?id=186843",""],[5732,"يبعد هموم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177894",""],[5732,"عين العنود","https://www.poetsgate.com/ViewPoem.aspx?id=177928",""],[5751,"امتحانُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=214724",""],[402,"سلام عليكم والفؤاد المسلم","https://www.poetsgate.com/ViewPoem.aspx?id=36305",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5848,"أروح اصور معك في المنتدى العام","https://www.poetsgate.com/ViewPoem.aspx?id=48845",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[5956,"جمالك بات يسقيني الهوانا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182530",""],[5956,"النِّيلُ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=184947",""],[5956,"طمئنّي عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194621",""],[5976,"شفته مع الصبيان","https://www.poetsgate.com/ViewPoem.aspx?id=32095",""],[6093,"كظل المستقيم على المدرج","https://www.poetsgate.com/ViewPoem.aspx?id=204220",""],[6093,"تقصير لفظ","https://www.poetsgate.com/ViewPoem.aspx?id=206279",""],[6102,"أَ...هَرِمنا؟!","https://www.poetsgate.com/ViewPoem.aspx?id=186308",""]],"verses":[["لِيَصْدُرْ هُدىً عَنْكُمْ يَعُمُّ بِلادَكُمْ","فَقَدْ آنَ لِلنُّزَّاقِ أَنْ يَتَحَمَّلُوا",0,"ل",3,0],["لِيَصُنْهُ مَنْ وَلاَّهُ وَلْيَكُ عَهْدُهُ","مِنْهُ الحَمِيدُ وَلَيْسَ فِيهِ ذَمِيمُ",1,"م",1,0],["لي صَديقٌ عَلى الزَمانِ صَديقي","وَرَفيقٌ مَعَ الخُطوبِ رَفيقي",2,"ق",2,1],["لي صاحب ترك المليح وعاد في","حبّ المليحة من ذوي الأقدار",3,"ر",1,1],["لي صنانٌ أعاذك الله منه","كم أواري إبطي به وأغطي",4,"ي",1,1],["ليصنع الدمع والتسهيد ما صنعا","فإن ذلك محمول على الحدق",5,"ق",1,0],["لي صديقٌ سيدٌ سندٌ","بيننا الآداب مشتركه",6,"ه",1,1],["لي صديقٌ يسوءني","ما يقاسي من الألم",7,"م",1,1],["لي صاحبٌ قد كنتُ آمُلُ نفعَهُ","سَبقتْ صواعقُهُ إليَّ صبيبَهُ",8,"ب",2,1],["لي صديقٌ إذا رأى لي طعاماً","لم يكد أن يجودَ لي بالشرابِ",9,"ب",1,0],["لي صديقٌ إذا رأت","وجهَهُ العينُ سرَّها",10,"ر",3,1],["لي صديقٌ جاهليٌّ","أخنقُ الناسِ لديكِ",11,"ك",1,1],["لي صديقٌ صامتيٌّ","قحطبيٌّ باحتيالِهْ",12,"ل",2,1],["لي صديقٌ إذا تُنوول عِرضي","أو رأى يوم نَوْبتي ذَبّ عني",13,"ن",2,1],["لِيَ صاحِبٌ دَخَلَ الغُرورُ فُؤادَهُ","إِنَّ الغُرورَ أُخَيَّ مِن أَعدائي",14,"ي",1,1],["لي صورَةُ الناسِ وَحاجاتِهِم","مِن مَطعَمٍ أَو مَشرَبٍ أَو رُقاد",15,"د",1,0],["لي صاحِبٌ غابَ عَنّي","فَقُلتُ أَمشي إِلَيهِ",16,"ي",2,1],["لي صاحِبٌ غِبتُ عَنهُ","وَلَستُ أَذكُرُ مَن هو",17,"ن",3,1],["لي صغار كلهم في المكتب","يتلقون به العلم المبين",18,"ن",1,0],["لي صاحِبٌ لَيسَ يَخلو","لِسانُهُ مِن جِراحِ",19,"ح",1,1],["لي صَديقٌ أَعدَدتُهُ لِصُروفٍ","مِن زَمانٍ يُربي عَلى مَن يُعِدُّه",20,"د",2,0],["لَيُصبِحَنَّ الرومُ جَيشٌ مُغمِدٌ","لِلصُبحِ في رَهَجانِهِ المُتَلَفِّفِ",21,"ف",1,0],["لِيَصْدُرَ عنكَ الشِّعرُ مالاً مسوَّماً","إذا نحنُ أوردناه دُرّاً مُثَقَّبا",22,"ب",2,0],["لي صَديقٌ لا يَعرِفُ الصِدقَ في القَو","لِ وَليسَ الصَديقُ إِلّا الصَدوقُ",23,"ق",1,1],["لي صاحِبٌ إِن خانَني دَهري وَفى","وَإِذا تَكَدَّرَتِ المَناهِلُ لي صَفا",24,"ف",2,1],["لي صديقٌ محْضُ النصيحة كالمر","آه إذ لا تريك منها اختلالا",25,"ل",2,1],["لي صاحِبٌ قَد كانَ لي مُؤنِساً","وَمَألَفاً في الزَمَنِ الغابِرِ",26,"ر",1,0],["لي صديقٌ صِنانُ إبْطيْهِ صَعْبٌ","عملَهُ تحتَ إبْطِهِ حيثُ مَرَّا",27,"ر",2,1],["لي صاحبٌ وهُو نحويٌّ لهُ ذهبٌ","يقولُ حينَ يرى في البخلِ عُذَّلَهُ",28,"ه",1,1],["لي صاحبٌ واسمهُ سراجٌ","ما قرَّ لي عندَهُ قرارُ",29,"ر",1,1],["لي صاحِبٌ تَرَكَ النِساءَ تَظَرُّفاً","مِنهُ وَمالَ إِلى هَوى الغِلمانِ",30,"ن",1,1],["لِيَصُمْ عنْ مبيعِه الأرضَ يحفظْ","بقعةً تستريحُ فيها عظامُهْ",31,"م",2,0],["لي صاحِبٌ قَد لامَني وَزادا","في تَركِيَ الصَبوحَ ثُمَّ عادا",32,"د",2,1],["لِي صاحِبٌ سَرَقَ اللُّصُوصُ ثِيابَهُ","لَيْلاً فباتَ بِبَيْتِهِ مَحْبُوسا",33,"س",2,0],["لي صارمٌ وهو شيعيٌّ كحامِلِهِ","يكادُ يسبِقُ كَرّاتي إلى البَطَلِ",34,"ل",1,1],["لي صاحِبٌ أَثقَلُ مِن أُحدِ","قَرينُهُ ما عاشَ في جَهدِ",35,"د",1,1],["لي صَبوَةٌ وَلَهُ السُلُو","وُ إِذا سَهِرتُ وَغَمَّضا",36,"ض",2,0],["لي صاحِبٌ مُختَلِفُ الأَلوانِ","مُتَّهَمُ الغَيبِ عَلى الإِخوانِ",37,"ن",1,1],["لي صاحبٌ واف، يزور مبكِّرًا","وتطول زورته سنين، وأشهرا",38,"ر",2,1],["لي صاحبٌ ظله خفيفُ","لأنفه دانت الأنوف",39,"ف",1,1],["ليصحب المرء في امريه منصرة","من اليقين بان الحال تنتقل",40,"ل",1,0],["لي صديقٌ غدا وإن كان لا","ينطق إلا بغيبةٍ أو محال",41,"ل",1,1],["لي صديق من بني ال","فياض ساءتني خلاله",42,"ل",2,1],["لي صاحبٌ دغل على علاته","متودّد ويقول ما لا يفعل",43,"ل",1,1],["لي صديق صدقاتهُ نفرُ السب","ت وأهل الكفور والتعليق",44,"ق",1,1],["لي صديق يلومني في انفرادي","وانقباضي عن زوجة وعشير",45,"ر",1,1],["لي صديق بلديّ","وجهه غيظ وكرب",46,"ب",1,1],["ليصنع زماني ما أراد فلن يرى","سوى ساعد يلقاه بالبأس مستد",47,"د",1,0],["ليصبح شملُ الأمرِ وهو منظمٌ","لسلطاننا المنصور وهو حميد",48,"د",1,0],["ليصبح شملُ الأمرِ وهو منظمٌ","ويصبحَ عنه الظلمُ وهو طريدُ",49,"د",1,0],["لي صديق جنى عل","ي مراراً فأكثرا",50,"ر",2,1],["ليصدق فيك الظن من غير ريبة","واكثر ما تلقي الظنون كواذبا",51,"ب",2,0],["لي صاحب يَشكو الديون فقضها","عنه وِبلغه الَّذي يَهواه",52,"ا",2,0],["ليصرِفَ عنّي فادِحاتِ نوائبٍ","أَضاقَ بِها ذَرعي وأَضنى بها جِسمي",53,"م",2,0],["لي صاحبٌ يتمنى لي الرضا أبداً","كأنما يختشى صدي وهجراني",54,"ي",1,1],["لي صاحبٌ في مصر يركب بغلةً","من غبنها ما صح قط ولا صحا",55,"ح",2,1],["لِيصعقَ الجورَ أَنشاهُ فأرّخهُ","صُورٌ بِقالبِ نصرِ الحقّ قَد سُبِكا",56,"ك",2,0],["لي صاحِبٌ عَدِمتُهُ","أَقبَحَ مِن رِجسٍ وَخَمرِ",57,"ر",1,1],["لي صاحِبٌ كلَّما ذكرتُ لهُ","بينَ حَبيبٍ تَفيضُ عَيناهُ",58,"ه",1,1],["ليصدُقَ فيهم نصُّ من جاء صادقاً","به أنَّ آذاناً لهم ليس تَسمع",59,"ع",1,0],["ليصدَّقَ الراوي بأن قد وُلِّدَت","بِكرٌ بلا نسلٍ مُقامٍ من أحدْ",60,"د",1,0],["لي صديقٌ أُفضِي إليهِ بسرّي","وخبَايا صَدري ومكنونِ قَلبي",61,"ب",2,1],["لي صديق من أبر الن","اس بي في الخلوان",62,"ن",1,1],["ليصبح حبلي عالقاً بحبالكا","ويرجع نقصي كاملاً بكمالكا",63,"ك",2,0],["لي صاحِبٌ حُرٌّ مِنَ الأَصحابِ","جَذَعُ التَواضُعِ قارِحُ الإِعجابِ",64,"ب",1,1],["لي صاحب في كل ف","ن من فنون العلم ناجح",65,"ح",1,1],["لي صديقٌ خسِرت فيه ودادي","حين صَارَت سلامتي منه ربحا",66,"ح",2,1],["لي صاحِبٌ لا يَجْتَني","منه مصاحبُهُ ثَمَرْ",67,"ر",1,1],["لي صاحبٌ أَضحى لودِّي مُحْرزَاً","ولكلِّ مل يهواه قَلْبي مُنْجِزا",68,"ز",2,1],["لي صاحبٌ أَفْديه من صاحبٍ","حُلْوُ التأَنِّي حسَنُ الإِحتيال",69,"ل",1,1],["لي صاحب في حديثه البَركهْ","يزيد عند السكون والحركهْ",70,"ه",1,1],["ليصبح لاعقاً ودكا عليه","تعلق من يدي عمرو وزيد",71,"د",1,0],["لي صاحِبٌ أخطأتُ في وُدِّهِ","وَلَيسَ يَخلو بَشرٌ مِن غَلَط",72,"ط",1,1],["لي صديق لا يلمس الدن حتى","يملأ الفار خبزه تفريخا",73,"خ",2,1],["لي صَديقٌ أَرومُ حينَ أَراهُ","أَنَّني مِنْ دونِ البريَّةِ أَعمَى",74,"م",2,1],["ليصبح الدين في عز وفي دعة","ويغتدي الشرك في ذل وحيرات",75,"ت",1,0],["ليصبح الدين تجلوه اسرته","ويغتدي الملك تعلوه المهابات",76,"ت",1,0],["ليَصْغُرَ في عَيْني عَظيمُ ذُنوبِهَا","ويَعْظُمَ في عَيْنيَّ نائِلُها النَّزْرُ",77,"ر",1,0],["لي صُروفٌ مِنْ راتبي لم تُنغَّصْ","بانْتِقاصٍ يَوماً ولا بانْتِقاضِ",78,"ض",1,0],["لي صاحب لا يُسمَّى","بين الورى إنسانا",79,"ن",2,1],["ليصفو بامتداح علاك عيشي","ومن جدوى يديك يطيب كسبي",80,"ب",2,0],["لى صبر به أمنّ على الدهر","اذا ما علىّ طال جفاكا",81,"ك",2,0],["ليصنع الدّهر ما أراد فما","أحفل من بعدكم بما صنعا",82,"ع",2,0],["لي صديق في وده لي صدوق","وبرعي الحقوق مني حقيق",83,"ق",1,1],["لي صارِمٌ ما شامَهُ مِن غمده","أَحَدٌ فَأَفلَت وَهُوَ ذو سَرّاء",84,"ا",2,0],["لي صاحبان أدام الله ظلَّهما","من بحر فضلهما ما زلت مغترفا",85,"ف",2,1],["ليصيد من شَرَك العقولِ صيودها","بشريعةٍ جلتْ عن المتطاولِ",86,"ل",1,0],["لِيَصِيرَ مَعرُوفاً لَنَا بِصِفَاتِهِ","وَيَصِيرَ مَذكُوراً لَنَا بِجَنَانِ",87,"ن",1,0],["لي صَديقٌ يَرَى حُقوقي عَليهِ","نافِلاتٍ وحَقَّهُ الدَهرَ فَرضا",88,"ض",2,1],["لي صديق مناقضى في أموري","هي لي شيمة ومنه سجيّه",89,"ه",1,1],["لي صاحب خفيت عليّ شؤونه","حركاته مجهولة وسكونه",90,"ن",2,1],["لي صبر إلا عن صد","وفؤادٌ كدت أوقعه",91,"ع",2,0],["لَي صاحبٍ فِيْ الحبْ زَعْلان","وِبْلا سِبَبْ يا ذي عجُوبه",92,"ب",2,0],["لَي صاحِبٍ يَمْشي عَلى خَطّ","طَلْمَسْ عَلى قلبي بْطِلْماس",93,"س",1,0],["لي صبي