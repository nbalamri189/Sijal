Poem.aspx?id=183657",""],[6102,"فرادة","https://www.poetsgate.com/ViewPoem.aspx?id=184552",""],[6108,"خطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=192749",""],[2575,"ليتني ماشفت","https://www.poetsgate.com/ViewPoem.aspx?id=24772",""],[6152,"ليس في الشوق من عار","https://www.poetsgate.com/ViewPoem.aspx?id=203705",""],[454,"ربيع العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82642&r=&rc=6",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""],[5126,"أعَاذلتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87835&r=&rc=49",""],[6355,"حطِّم سيوفك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66619&r=&rc=79",""],[6360,"عَطَشُ السَّنَابِلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87601&r=&rc=3",""]],"verses":[["أتحتج في صوم اليهود بعاشرٍ","وليس لهم شهرٌ يسمى مُحرما",0,"م",2,0],["أَتَحَدّى بِهِ الرَدى","في ظُهورِ السَوابِقِ",1,"ق",1,0],["أَتَحَنُّناً بَعدَ الرُقادِ وَقُسوَةً","أَيّامَ أُصفيكِ الوِدادَ وَأُمذَقُ",2,"ق",1,0],["أَتَحسِبُ سوءَ الظَنِّ يَجرَحُ في فِكري","إِذاً فَاِحتَوي بي العَجزَ مِن كَنَفِ الصَبرِ",3,"ر",1,1],["أتَحْسَبُ تلكَ العامِريّةُ أنني","أَذِلُّ ويأبى المَجْدُ أن أتَذَلّلا",4,"ل",2,0],["أَتَحتَ التُرابِ يُضامُ الكَريمُ","وَيَشقى الحَليمُ وَيَخفى القَمَر",5,"ر",1,0],["أَتَحتَ التُرابِ تُساقُ الشُعوبُ","بِسَوطِ العُبودَةِ سَوقَ البَقَر",5,"ر",1,0],["أَتَحتَ السَماءِ وَبَدرِ السَماءِ","وَبَينَ الرِياضِ وَبَينَ الخَلا",6,"ا",1,0],["أَتَحيا أَنفُسُ الآمالِ فيكُم","وَلي أَثناءَها أَمَلٌ قَتيلُ",7,"ل",1,0],["أَتَحْرِمُهَا الفُصْحَى وَقَدْ فَتَحَتْ لَكُمْ","مَغَالِقَ فِيَها كُلُّ مَدَّخَرٍ عَجَبْ",8,"ب",1,0],["أَتحَفَنِي مِنْهُ بِقَارُورةٍ","تُوشِكُ أَنْ تَرْفُضَ إِلهَامَا",9,"م",2,0],["أَتَحْرِمُ الرِّفْدَ جِيرَاناً يُضَوِّرُهُمْ","جُوعٌ وَتَنْكَرُ قَتْلَى الْحَرْبِ إِنْ رُحِمُوا",10,"م",3,0],["أتَحِينُ فِي هَذِي النَّضَارَةِ وَالصِّبَا","مَنْ يَبْكِ مِنْ أَسَفٍ فَلَيْسَ مَلُوما",11,"م",2,1],["أتحسب هاتيك الديار وقد خَلَت","من الجند تخلو من ضراغمة غُلْب",12,"ب",1,0],["أَتَحكُمُ لِلقُيونِ كَذَبتَ إِنّا","وَرِثنا المَجدَ قَبلَ تُراثِ عادِ",13,"د",1,0],["أَتَحسِبُ فَلسَ أُمِّكَ كانَ مَجداً","وَجَذَّكُمُ عَنِ النَقدِ الجُفالا",14,"ل",2,0],["أَتَحمِلُ مَحزونَ الفُؤادِ قَوادِمٌ","عَلى غُصُنٍ نائي المَسافَةِ عالِ",15,"ل",1,0],["أَتُحِبُّ يُهدانَ الحِجازَ وَدينَهُم","كَبِدَ الحِمارِ وَلا تُحِبُّ مُحَمَّدا",16,"د",2,0],["اِتَّحَدَ المَعشوقُ بِالعاشِقِ","اِنقَسَمَ المَوموقُ لِلوامِقِ",17,"ق",1,1],["أتحرُمني لأني مستقِلٌّ","وأني لستُ كالرَّزْحى السِّغابِ",18,"ب",1,0],["أتحسِبُني زهاك الحظ عندي","فَحَشوُ جوانحي حسدٌ شديدُ",19,"د",1,0],["أتحسُدني تجويد رَيْطٍ نسجتُهُ","لتلبسه يا للعجيب من الأمرِ",20,"ر",1,0],["أتحسب ما تأتي من الخزي خافياً","على الناس لا تُكذَب نهارُك أنهَر",21,"ر",1,0],["أتحرمني الجدوى وأطريك كاذباً","فتحظَى وأشقَى بالذي أنا وازر",22,"ر",1,0],["أتحسبُني أدللتُ إدلالَ جاهلٍ","عليْك بمدْحٍ لا يخالطُهُ إفْكُ",23,"ك",1,0],["أتحْدِثُ أمراً مثلَ أَمرِك جامعاً","فأُخرَج منه مخرجَ الساقط النذلِ",24,"ل",1,0],["أتحرمُني وقد أُعطيتَ كُلّاً","عطا مُفْضِل خَضِل البنان",25,"ن",1,0],["أتحقِرُ مَنْ غَدا منهنَّ قِرني","مَنى لك مثلَ ذاك القِرن ماني",26,"ن",2,0],["أَتُحِبّينَني إِذا","زالَ مَجدي وَسُؤدُدي",27,"د",2,0],["أتحسَّاهُ في الصبَّاحِ لأنسى","مَا تقضَّى في أمسيَ المَفْقودِ",28,"د",1,0],["أَتُحجَبُ عَنّي وَالفؤادُ يُحِبُّها","لَقَد عَزَّ مَحجوبٌ تَمَنَّاهُ حاجِبُ",29,"ب",1,0],["أتحاولون بلا جهاد خطة","لم يستطعها الترك بعد جهاد",30,"د",1,0],["اِتَّحِدوا ضِدَّ العَدُوِّ الجافي","فَالاتِّحادُ قُوَّةُ الضِعافِ",31,"ف",1,0],["أَتَحسَبُ شَهِدا إِناءَ الزَمانِ","وَطينَتُهُ الصابُ وَالحَنظَلُ",32,"ل",1,0],["أَتَحلِفُ لا تُكَلِّفُني مَسيراً","إِلى بَلَدٍ أُحاوِلُ فيهِ مالا",33,"ل",2,1],["أَتَحسِبُ بيضُ الهِندِ أَصلَكَ أَصلَها","وَأَنَّكَ مِنها ساءَ ما تَتَوَهَّمُ",34,"م",1,0],["أَتَحجُبُ طاقَةُ إِبرَيسَمٍ","هَوى الصَبِّ مِنهُم عَنِ الصَبَّه",35,"ب",2,0],["أَتُحسِنُ إِصفادي فَأَشكُرَ نَيلَها","وَإِن كانَ نَزراً أَو تَحُلُّ صِفادي",36,"د",2,0],["أَتَحسِبُ مِصرٌ أَنَّ قَلبي يُحِبُّها","وَقَد جَرَّعَتني فيكَ ما جَرَّعَت مِصرُ",37,"ر",1,0],["أَتَحسِبُ قَلبي خارِجاً مِن حِجابِهِ","إِذا دُفُّ عَبّادٍ أَرَنَّت جَلاجِلُه",38,"ل",2,0],["أَتحسبني أنْسَى وما زلت ذاكِراً","خِيانةَ دَهري أو خيانةَ صَاحبي",39,"ب",2,0],["أتحلفُ لا تنوبُ لمنْ سواهُ","فقلتُ نعمْ وغلَّظْتُ اليمينا",40,"ن",2,0],["أَتَحذَرُ وَشكَ البَينِ أَم لَستَ تَحذَرُ","وَذو الحَذَرِ النَحريرُ قَد يَتَفَكَّرُ",41,"ر",1,1],["أَتُحارِبونَ اللَهَ في جَبَروتِهِ","أَم تَمكُرونَ بأُمَّةٍ ما تُخدَعُ",42,"ع",1,1],["أتحسَبونَ رسولَ اللَّهِ يَجهلُها","مَكيدةً فَضَحَتْ أسرارَها السُّجُفُ",43,"ف",1,0],["أَتَحسَبُ يا اِبنَ يَشكُرَ أَنَّ شِعري","كَلَفتِ المُرتَدي طَرَفَ العِطافِ",44,"ف",1,0],["أَتَحصُرُ قَوماً أَن يَجودوا بِمالِهِم","فَهَلّا قَتيلَ الهُرمُزانِ تُحاصِرُه",45,"ر",2,0],["أُتِحتُ لَهُ فَأَيقَنَ إِذ رَآني","بِقانونِ الحُكومَةِ وَالخِطابِ",46,"ب",1,0],["أَتَحسَبُني باكَرتُ بَعدَكَ لَذَّةً","أَبا الفَضلِ أَو رَفَّعتُ عَن عاتِقٍ خِدرا",47,"ر",2,1],["أَتَحمِلُني إِلى الغُفرانِ عيسٌ","عَلى نَصِّ الوَجيفِ مُؤَجَّداتُ",48,"ت",1,0],["أَتَحمِلُكَ الحَصانُ وَأَنتَ خالٍ","وَفي الهَيجاءِ يَحمِلُكَ الحِصانُ",49,"ن",1,1],["أَتَحسَبينَ العُمرَ عِلماً بِهِ","لا بَل تَعيشينَ وَلا تَحسَبين",50,"ن",1,0],["أَتَحسَبينَ الدَهرَ ذا غَفلَةٍ","هَيهاتَ ما الأَمرُ كَما تَحسَبين",50,"ن",1,0],["أتحسب أن الكون قد كان عاطلاً","فلا أرضنا تسعى ولا الشمس تشرق",51,"ق",1,1],["أَتحسب الغي رشداً","وَتحسب الرشد غيّا",52,"ي",2,0],["أَتُحِدُّ بعد خرابها ال","مظنون للعمران عهدا",53,"د",2,0],["أتحلمُ بالأرضِ مخمورةً","من الدمِ راقصةً في اللهبْ",54,"ب",1,0],["أتَحْسِسَبُ أنّ البدْر لَيْسَ بناطقٍ","فَصِيحٍ وأنَّ الشَّمْسَ لا تَتكَلَّمُ",55,"م",1,1],["أتحرقين فؤاداً قد حللت به","بنار حبك عمداً وهو واراك",56,"ك",1,0],["أَتَحسِبُ قَيسٌ أَنَّني بَعدَ طَردِهِم","أَخافُ الأَعادي أَو أَذِلُّ مِنَ الطَردِ",57,"د",1,0],["أَتَحْسَبُ أَنَّ الظَّنَّ يُدْرِكُ بَعْضَ مَا","تُحَاوِلُهُ وَالظَّنُّ لِلْمَرْءِ مُوبِقُ",58,"ق",1,0],["أَتحْرُثُ أَرْضاً فِي ابْتِغَاءِ نَبَاتِهَا","تُكَابِدُ ما يُشْقِي مِن البرْد وَالحَرِّ",59,"ر",1,0],["أَتُحِسُّ فِي هذَا الثَّرَى","نَبَضَانَ قلْبٍ مُوجَعِ",60,"ع",1,0],["أَتَحْفِزُنَا فِعَالُكَ أَنْ نقُولاَ","وَيُعْجِزُنَا مَجَالُكَ أَنْ نَجُولاَ",61,"ل",2,1],["أَتْحَفْتَنِي بِبَيَانٍ صِغْتَه عَجَباً","وَلِي بِهِ وَلِمَنْ أَهْدَاهُ تَخْلِيدُ",62,"د",1,0],["أَتَحْسَبُ أولاَدُ اللّقِيطَةِ أنَّنَا","على الخَيْلِ لَسْنَا مثلَهُمْ في الفوارِسِ",63,"س",1,1],["أَتَحسَبُ ذاتَ الخالِ راجِيَةً رَبّا","وَقَد قَتَلَت صَبّاً يُجَنُّ بِها حُبّا",64,"ب",2,1],["أَتحقَّقتْ آمالُكم في دولةٍ","تمتَدُّ عَرْضًا في البلاد وطولا؟",65,"ل",2,0],["أتحبس خيل الله عن خيل خصمه","وسبعون ألفا فوقهن هصور",66,"ر",1,0],["أتحصرُ أقواماً يجودوا بمالهم","فلولا قبيل الهرمزانِ تحاصرهْ",67,"ر",2,0],["أتحتَ الماءِ غاصوا حين جازوا","عليه أم فُوَيقَ الماءِ مرّوا",68,"ر",3,0],["أتحجب طاقة إبريسم","هوى الصب منهم على الصبه",69,"ب",2,0],["أتحقِرُ مَنْ غَدا منهنَّ قِرني","من لك مثلَ ذاك القِرن ماني",70,"ن",2,0],["أتُحنا على الدنيا سعيدا مملكا","جمالا نرى اجماله لم يبعّض",71,"ض",1,0],["اتحفنا القرب وكل الرضا","مباركا والضد في صد",72,"د",1,0],["أتحفوني بالوعد لكن أعدوا","وعدهم لي بلية وملالا",73,"ل",2,0],["أَتَحْلِفُ بِاللهِ الّذي أنتَ عَبْدُهُ","بأنَّكَ لم تَغْدِرْ، ولم تَتَمَتَّعِ؟!",74,"ع",1,0],["أتحسب كثبان المهامه يا فتى","جناناً بها أيك السعادة مفرع",75,"ع",1,0],["أتحسبُ أنَّ البعدَ يسلى قلوبنا","وننساكم لا والإلهِ المصوِّرِ",76,"ر",1,0],["أَتحولُ دونكما حَياه","لو كان يبلوها الإله",77,"ه",1,0],["أتَحسَبُ لِي في الشِّعرِ شِبهاً ألَم تَكُن","نَظَرتَ إِلَى مَروِيِّهِ فِي المَهَارِقِ",78,"ق",1,0],["أتحسب جهلا أنَّ عذرك واضح","بتقليد زنديق على الله يكذب",79,"ب",1,0],["أتحسب يا مسكين قول زعانف","تجمعهم من كل أرض وتجلب",79,"ب",1,0],["أتحمد من يقول صنعت ربي","عليه لعنة الله المدامه",80,"م",2,0],["أَتَحرِمُني ما أَنتَ مُعطيهِ كاشِحاً","عَدُوّاً طوالَ الدَّهرِ تَسري عَقارِبُهْ",81,"ب",2,0],["أَتُحرِقُنى يا رَبَّ إِن عُجتُ عَوجَةً","عَلَى رَخصَةِ الأطرافِ طَيِّبةِ النَّشرِ",82,"ر",1,0],["أتحسب أن المجد سهل طلابه","فتطلبه باللؤم ويلك والكبر",83,"ر",1,0],["أَتَحتَرِمُ الحُقوقَ وَفي فَضاها","من الأَحقادِ زَوبَعَةٌ وَبَرقُ",84,"ق",1