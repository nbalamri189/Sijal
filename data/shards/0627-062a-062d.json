ldiwan.net/poem33393.html","الوافر"],[403,"عذل العذول لباب السمع ما ولجا","https://www.aldiwan.net/poem34095.html","البسيط"],[403,"وحرمة ما بيني وبينك من حب","https://www.aldiwan.net/poem34138.html","الطويل"],[416,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[429,"سألت بديع النظم لما تمثلت","https://www.aldiwan.net/poem40241.html","الطويل"],[449,"ربيع العمر","https://www.aldiwan.net/poem1014.html",""],[453,"تمهل يا قطار علام تجري","https://www.aldiwan.net/poem61365.html","الوافر"],[458,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[458,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[461,"على مهل يا ابن الحسين فانما","https://www.aldiwan.net/poem15464.html","الطويل"],[468,"أيا من هو الماء الزلال الذي يجري","https://www.aldiwan.net/poem60085.html","الطويل"],[470,"ألا لا تلمه اليوم أن يتبلدا","https://www.aldiwan.net/poem4657.html","الطويل"],[500,"تدوس بساط الله والقلب فاقد","https://www.aldiwan.net/poem37566.html","الطويل"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[513,"بعينيك ما ألقى إذا كنت حاضرا","https://www.aldiwan.net/poem67739.html","الطويل"],[527,"فإن ردني دهري عليك طريدة","https://www.aldiwan.net/poem45958.html","الطويل"],[558,"إن الغني إلى المولى من افتقرا","https://www.aldiwan.net/poem34492.html","البسيط"],[562,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"]],"verses":[["أَتَحَدّى بِهِ الرَدى","في ظُهورِ السَوابِقِ",0,"ق",1,0],["أَتَحَنُّناً بَعدَ الرُقادِ وَقُسوَةً","أَيّامَ أُصفيكِ الوِدادَ وَأُمذَقُ",1,"ق",1,0],["أَتَحسِبُ سوءَ الظَنِّ يَجرَحُ في فِكري","إِذاً فَاِحتَوي بي العَجزَ مِن كَنَفِ الصَبرِ",2,"ر",1,1],["أتَحْسَبُ تلكَ العامِريّةُ أنني","أَذِلُّ ويأبى المَجْدُ أن أتَذَلّلا",3,"ل",2,0],["أَتَحتَ التُرابِ يُضامُ الكَريمُ","وَيَشقى الحَليمُ وَيَخفى القَمَر",4,"ر",1,0],["أَتَحتَ التُرابِ تُساقُ الشُعوبُ","بِسَوطِ العُبودَةِ سَوقَ البَقَر",4,"ر",1,0],["أَتَحتَ السَماءِ وَبَدرِ السَماءِ","وَبَينَ الرِياضِ وَبَينَ الخَلا",5,"ا",1,0],["أَتَحيا أَنفُسُ الآمالِ فيكُم","وَلي أَثناءَها أَمَلٌ قَتيلُ",6,"ل",1,0],["أَتَحْرِمُهَا الفُصْحَى وَقَدْ فَتَحَتْ لَكُمْ","مَغَالِقَ فِيَها كُلُّ مَدَّخَرٍ عَجَبْ",7,"ب",1,0],["أَتحَفَنِي مِنْهُ بِقَارُورةٍ","تُوشِكُ أَنْ تَرْفُضَ إِلهَامَا",8,"م",2,0],["أَتَحْرِمُ الرِّفْدَ جِيرَاناً يُضَوِّرُهُمْ","جُوعٌ وَتَنْكَرُ قَتْلَى الْحَرْبِ إِنْ رُحِمُوا",9,"م",3,0],["أتَحِينُ فِي هَذِي النَّضَارَةِ وَالصِّبَا","مَنْ يَبْكِ مِنْ أَسَفٍ فَلَيْسَ مَلُوما",10,"م",2,1],["أتحسب هاتيك الديار وقد خَلَت","من الجند تخلو من ضراغمة غُلْب",11,"ب",1,0],["أَتَحكُمُ لِلقُيونِ كَذَبتَ إِنّا","وَرِثنا المَجدَ قَبلَ تُراثِ عادِ",12,"د",1,0],["أَتَحسِبُ فَلسَ أُمِّكَ كانَ مَجداً","وَجَذَّكُمُ عَنِ النَقدِ الجُفالا",13,"ل",2,0],["أَتَحمِلُ مَحزونَ الفُؤادِ قَوادِمٌ","عَلى غُصُنٍ نائي المَسافَةِ عالِ",14,"ل",1,0],["أَتُحِبُّ يُهدانَ الحِجازَ وَدينَهُم","كَبِدَ الحِمارِ وَلا تُحِبُّ مُحَمَّدا",15,"د",2,0],["اِتَّحَدَ المَعشوقُ بِالعاشِقِ","اِنقَسَمَ المَوموقُ لِلوامِقِ",16,"ق",1,1],["أتحرُمني لأني مستقِلٌّ","وأني لستُ كالرَّزْحى السِّغابِ",17,"ب",1,0],["أتحسِبُني زهاك الحظ عندي","فَحَشوُ جوانحي حسدٌ شديدُ",18,"د",1,0],["أتحسُدني تجويد رَيْطٍ نسجتُهُ","لتلبسه يا للعجيب من الأمرِ",19,"ر",1,0],["أتحسب ما تأتي من الخزي خافياً","على الناس لا تُكذَب نهارُك أنهَر",20,"ر",1,0],["أتحرمني الجدوى وأطريك كاذباً","فتحظَى وأشقَى بالذي أنا وازر",21,"ر",1,0],["أتحسبُني أدللتُ إدلالَ جاهلٍ","عليْك بمدْحٍ لا يخالطُهُ إفْكُ",22,"ك",1,0],["أتحْدِثُ أمراً مثلَ أَمرِك جامعاً","فأُخرَج منه مخرجَ الساقط النذلِ",23,"ل",1,0],["أتحرمُني وقد أُعطيتَ كُلّاً","عطا مُفْضِل خَضِل البنان",24,"ن",1,0],["أتحقِرُ مَنْ غَدا منهنَّ قِرني","مَنى لك مثلَ ذاك القِرن ماني",25,"ن",2,0],["أَتُحِبّينَني إِذا","زالَ مَجدي وَسُؤدُدي",26,"ي",1,0],["أتحسَّاهُ في الصبَّاحِ لأنسى","مَا تقضَّى في أمسيَ المَفْقودِ",27,"د",1,0],["أَتُحجَبُ عَنّي وَالفؤادُ يُحِبُّها","لَقَد عَزَّ مَحجوبٌ تَمَنَّاهُ حاجِبُ",28,"ب",1,0],["أتحاولون بلا جهاد خطة","لم يستطعها الترك بعد جهاد",29,"د",1,0],["اِتَّحِدوا ضِدَّ العَدُوِّ الجافي","فَالاتِّحادُ قُوَّةُ الضِعافِ",30,"ف",1,0],["أَتَحسَبُ شَهِدا إِناءَ الزَمانِ","وَطينَتُهُ الصابُ وَالحَنظَلُ",31,"ل",1,0],["أَتَحلِفُ لا تُكَلِّفُني مَسيراً","إِلى بَلَدٍ أُحاوِلُ فيهِ مالا",32,"ل",2,1],["أَتَحسِبُ بيضُ الهِندِ أَصلَكَ أَصلَها","وَأَنَّكَ مِنها ساءَ ما تَتَوَهَّمُ",33,"م",1,0],["أَتَحجُبُ طاقَةُ إِبرَيسَمٍ","هَوى الصَبِّ مِنهُم عَنِ الصَبَّه",34,"ب",2,0],["أَتُحسِنُ إِصفادي فَأَشكُرَ نَيلَها","وَإِن كانَ نَزراً أَو تَحُلُّ صِفادي",35,"د",2,0],["أَتَحسِبُ مِصرٌ أَنَّ قَلبي يُحِبُّها","وَقَد جَرَّعَتني فيكَ ما جَرَّعَت مِصرُ",36,"ر",1,0],["أَتَحسِبُ قَلبي خارِجاً مِن حِجابِهِ","إِذا دُفُّ عَبّادٍ أَرَنَّت جَلاجِلُه",37,"ل",2,0],["أَتحسبني أنْسَى وما زلت ذاكِراً","خِيانةَ دَهري أو خيانةَ صَاحبي",38,"ب",2,0],["أتحلفُ لا تنوبُ لمنْ سواهُ","فقلتُ نعمْ وغلَّظْتُ اليمينا",39,"ن",2,0],["أَتَحذَرُ وَشكَ البَينِ أَم لَستَ تَحذَرُ","وَذو الحَذَرِ النَحريرُ قَد يَتَفَكَّرُ",40,"ر",1,1],["أَتُحارِبونَ اللَهَ في جَبَروتِهِ","أَم تَمكُرونَ بأُمَّةٍ ما تُخدَعُ",41,"ع",1,1],["أتحسَبونَ رسولَ اللَّهِ يَجهلُها","مَكيدةً فَضَحَتْ أسرارَها السُّجُفُ",42,"ف",1,0],["أَتَحسَبُ يا اِبنَ يَشكُرَ أَنَّ شِعري","كَلَفتِ المُرتَدي طَرَفَ العِطافِ",43,"ف",1,0],["أَتَحصُرُ قَوماً أَن يَجودوا بِمالِهِم","فَهَلّا قَتيلَ الهُرمُزانِ تُحاصِرُه",44,"ر",2,0],["أُتِحتُ لَهُ فَأَيقَنَ إِذ رَآني","بِقانونِ الحُكومَةِ وَالخِطابِ",45,"ب",1,0],["أَتَحسَبُني باكَرتُ بَعدَكَ لَذَّةً","أَبا الفَضلِ أَو رَفَّعتُ عَن عاتِقٍ خِدرا",46,"ر",2,1],["أَتَحمِلُني إِلى الغُفرانِ عيسٌ","عَلى نَصِّ الوَجيفِ مُؤَجَّداتُ",47,"ت",1,0],["أَتَحمِلُكَ الحَصانُ وَأَنتَ خالٍ","وَفي الهَيجاءِ يَحمِلُكَ الحِصانُ",48,"ن",1,1],["أَتَحسَبينَ العُمرَ عِلماً بِهِ","لا بَل تَعيشينَ وَلا تَحسَبين",49,"ن",1,0],["أَتَحسَبينَ الدَهرَ ذا غَفلَةٍ","هَيهاتَ ما الأَمرُ كَما تَحسَبين",49,"ن",1,0],["أتحسب أن الكون قد كان عاطلاً","فلا أرضنا تسعى ولا الشمس تشرق",50,"ق",1,1],["أَتحسب الغي رشداً","وَتحسب الرشد غيّا",51,"ي",2,0],["أَتُحِدُّ بعد خرابها ال","مظنون للعمران عهدا",52,"د",2,0],["أتحلمُ بالأرضِ مخمورةً","من الدمِ راقصةً في اللهبْ",53,"ب",1,0],["أتَحْسِسَبُ أنّ البدْر لَيْسَ بناطقٍ","فَصِيحٍ وأنَّ الشَّمْسَ لا تَتكَلَّمُ",54,"م",1,1],["أتحرقين فؤاداً قد حللت به","بنار حبك عمداً وهو واراك",55,"ك",1,0],["أَتَحسِبُ قَيسٌ أَنَّني بَعدَ طَردِهِم","أَخافُ الأَعادي أَو أَذِلُّ مِنَ الطَردِ",56,"د",1,0],["أَتَحْسَبُ أَنَّ الظَّنَّ يُدْرِكُ بَعْضَ مَا","تُحَاوِلُهُ وَالظَّنُّ لِلْمَرْءِ مُوبِقُ",57,"ق",1,0],["أَتحْرُثُ أَرْضاً فِي ابْتِغَاءِ نَبَاتِهَا","تُكَابِدُ ما يُشْقِي مِن البرْد وَالحَرِّ",58,"ر",1,0],["أَتُحِسُّ فِي هذَا الثَّرَى","نَبَضَانَ قلْبٍ مُوجَعِ",59,"ع",1,0],["أَتَحْفِزُنَا فِعَالُكَ أَنْ نقُولاَ","وَيُعْجِزُنَا مَجَالُكَ أَنْ نَجُولاَ",60,"ل",2,1],["أَتْحَفْتَنِي بِبَيَانٍ صِغْتَه عَجَباً","وَلِي بِهِ وَلِمَنْ أَهْدَاهُ تَخْلِيدُ",61,"د",1,0],["أَتَحْسَبُ أولاَدُ اللّقِيطَةِ أنَّنَا","على الخَيْلِ لَسْنَا مثلَهُمْ في الفوارِسِ",62,"س",1,1],["أَتَحسَبُ ذاتَ الخالِ راجِيَةً رَبّا","وَقَد قَتَلَت صَبّاً يُجَنُّ بِها حُبّا",63,"ب",2,1],["أَتحقَّقتْ آمالُكم في دولةٍ","تمتَدُّ عَرْضًا في البلاد وطولا؟",64,"ل",2,0],["أتحصرُ أقواماً يجودوا بمالهم","فلولا قبيل الهرمزانِ تحاصرهْ",65,"ر",2,0],["أتحتَ الماءِ غاصوا حين جازوا","عليه أم فُوَيقَ الماءِ مرّوا",66,"ر",3,0],["أتحجب طاقة إبريسم","هوى الصب منهم على الصبه",67,"ب",2,0],["أتحقِرُ مَنْ غَدا منهنَّ قِرني","من لك مثلَ ذاك القِرن ماني",68,"ن",2,0],["أتُحنا على الدنيا سعيدا مملكا","جمالا نرى اجماله لم يبعّض",69,"ض",1,0],["اتحفنا القرب وكل الرضا","مباركا والضد في صد",70,"د",1,0],["أتحفوني بالوعد لكن أعدوا","وعدهم لي بلية وملالا",71,"ل",2,0],["أَتَحْلِفُ بِاللهِ الّذي أنتَ عَبْدُهُ","بأنَّكَ لم تَغْدِرْ، ولم تَتَمَتَّعِ؟!",72,"ع",1,0],["أتحسب كثبان المهامه يا فتى","جناناً بها أيك السعادة مفرع",73,"ع",1,0],["أتحسبُ أنَّ البعدَ يسلى قلوبنا","وننساكم لا والإلهِ المصوِّرِ",74,"ر",1,0],["أَتحولُ دونكما حَياه","لو كان يبلوها الإله",75,"ه",1,0],["أتَحسَبُ لِي في الشِّعرِ شِبهاً ألَم تَكُن","نَظَرتَ إِلَى مَروِيِّهِ فِي المَهَارِقِ",76,"ق",1,0],["أتحسب جهلا أنَّ عذرك واضح","بتقليد زنديق على الله يكذب",77,"ب",1,0],["أتحسب يا مسكين قول زعانف","تجمعهم من كل أرض وتجلب",77,"ب",1,0],["أتحمد من يقول صنعت ربي","عليه لعنة الله المدامه",78,"م",2,0],["أَتَحرِمُني ما أَنتَ مُعطيهِ كاشِحاً","عَدُوّاً طوالَ الدَّهرِ تَسري عَقارِبُهْ",79,"ب",2,0],["أَتُحرِقُنى يا رَبَّ إِن عُجتُ عَوجَةً","عَلَى رَخصَةِ الأطرافِ طَيِّبةِ النَّشرِ",80,"ر",1,0],["أتحسب أن المجد سهل طلابه","فتطلبه باللؤم ويلك والكبر",81,"ر",1,0],["أَتَحتَرِمُ الحُقوقَ وَفي فَضاها","من الأَحقادِ زَوبَعَةٌ وَبَرقُ",82,"ق",1,0],["أَتْحَفَنَا بِكِتَابٍ قَدْ حَوَى دُرَراً","جَلِيلَةً عَنْ نَفِيسِ الدُّرِّ تُغْنِينَا",83,"ن",2,0],["أتُحارِبينَ الأعزلينِ بجَحفَلٍ","جَمَّعتِ فيهِ حديدَ حدّاديك",84,"ك",1,0],["أَتحب مسئلة بغير جَواب","فاذا دَعَوت دعوت غير جاب",85,"ب",1,1],["أَتُحْصِي مَا لَدَيْكَ منَ المَعَالي","وقَدْ أرْبَتْ عَلَى قَطْرِ الغَمامِ",86,"م",1,0],["أَتَحسَبونَ غَربَ أَجفانِيَ جَف","بَعدَ النَوى لا وَضريحٍ بِالنَجَف",87,"ف",1,1],["أتحكمنا الأَعلاجُ في عقْرِ دارِنا","فيا لإباءِ العربِ من ذلِّ أعجمي",88,"م",2,0],["أتحرقني بنفطي في بلادي","وَتورثُها الصعاليك الجوالي؟",89,"ل",2,0],["أتحب أن تشمت على عواذلي","وحواسدي ومعاندي ومناكري",90,"ي",1,0],["أَتحرمُنا يا أكرمَ الأكرمينَ إذ","دَعوناكَ مُضطرّينَ في بيتكَ الأسنى",91,"ن",2,0],["أَتحَفتني بِصحيفةٍ مسطورةٍ","بِمآثرِ الفضلِ الّذي لا يسترُ",92,"ر",1,0],["أَتِح لَنا اللَهمّ مَن في قَلبه","مِن أَثر الرَحمة ما فيهِ النَجا",93,"ا",1,0],["أَتَحسَبُني بَعدَ السُلُوِّ مُتَيَّماً","وَأَنَّ ولوعي بِالغَرامِ ولوعي",94,"ع",2,1],["أَتَحسَبُ أَنّي لِلمَواهِبِ كاتِمٌ","أَما قيلَ إِنَّ الأَرضَ مُخرِجَةُ السِرِّ",95,"ر",1,0],["أَتَحسَبُها ماءً جَرى في زُجاجَةٍ","وَما هِيَ إِلّا النارُ ذابَت بِأَنفاسي",96,"س",2,0],["أَتَحسَب أَن قَتل النَفس","يابأ مِن الأَجر",97,"ر",1,0],["أتحسَبُ أنّي بَعْدَ بُعدِك سالياً","يطيبُ مَعَاشي أو يَلذّ رقادي",98,"ي",1,0],["أتحسب في سمرقند مقامي","أو أني قد نزلت بشاهجان",99,"ن",1,0],["أتحسب العذل شعراً قد أتى وإلى","مسامع القلب قد وافى بغير حجا",100,"ج",2,0],["أتحسبني أنسى المودة والإِخا","وطيب اللقا دهراً لمنزلك الرحب",101,"ب",1,0],["أتحصي المادحون له كمالاً","ومن ذا عدّ في الأرض الرم