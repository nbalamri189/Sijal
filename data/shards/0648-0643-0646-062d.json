{"poems":[[79,"مولاي ياذا الجلال الباهر العالي","https://www.aldiwan.net/poem36349.html","البسيط"],[90,"إذا شئت أن تسري بكافرة الصوى","https://www.aldiwan.net/poem44444.html","الطويل"],[60,"ترد رداء الصبر عند النوائب","https://www.aldiwan.net/poem31184.html","الطويل"],[35,"ألا يا حمامات الحمى عدن عودة","https://www.aldiwan.net/poem25791.html","الطويل"],[60,"تَرَدَّ رِدَاْءَ الصَّبْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=10076",""],[90,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""],[35,"ألاَ يَا حَمَامَاتَ الحِمَى عُدْنَ عَوُدَة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14157&r=&rc=91",""],[242,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[275,"إن السعادة وعد دون إنجاز","https://www.aldiwan.net/poem35068.html","البسيط"],[396,"يا طالبا جنة الدنيا وراحتها","https://www.aldiwan.net/poem54544.html","عموديه"],[396,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[396,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[396,"محمد إن شئت تلحق بالرجال","https://www.aldiwan.net/poem54591.html","عموديه"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[505,"من رام جمع الناس في مذهب","https://www.aldiwan.net/poem38005.html","السريع"],[563,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103084","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87163","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71032","المجتث"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112956","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132259","الطويل"],[2031,"","https://poetry.dctabudhabi.ae/diwan/poem/140123",""],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96024","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124783","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124785","الوافر"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124782","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102541","المتقارب"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65972","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145140","الطويل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140285",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85239","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57964","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4675,"المرجان في وصف الخلان","https://www.poetsgate.com/ViewPoem.aspx?id=201394",""],[5219,"الرحمة المزجاة","https://www.poetsgate.com/ViewPoem.aspx?id=194855",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5431,"وعرّشت في الأعماق نبعا وماجفّا","https://www.poetsgate.com/ViewPoem.aspx?id=198714",""],[5550,"يا ابن الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=211770",""],[6152,"لا ترض من خان","https://www.poetsgate.com/ViewPoem.aspx?id=203180",""],[6152,"كن جابرا للقلوب","https://www.poetsgate.com/ViewPoem.aspx?id=213151",""]],"verses":[["وَكُنْ حَذُوراً وَلاَ تُغْفِلَ مَكِيدَة مَنْ","يَدْنُو إِلَيْكَ وَيَنْوِي فَتْكَ مُغْتَالِ",0,"ل",1,0],["وكن حائداً عنهم جميعاً فإنما","يضلىّ امرؤٌ عن غيّهم غير حائد",1,"د",1,0],["وَكُن حافِظاً عَهدَ الصَديقِ وَراعِياً","تَذُق مِن كَمالِ الحِفظِ صَفوَ المَشارِبِ",2,"ب",1,0],["وُكُن حافِظاً لِلوالِدَينِ وَناصِراً","لِجارِكَ ذي التَقوى وَأَهلِ التَقارُبِ",2,"ب",1,0],["وَكُنَّ حَماماتٍ جَميعاً بِعَيطَلٍ","فَأَصبَحنَ شَتّى ما لَهُنَّ قَرينُ",3,"ن",1,0],["وكن حافظاً عهد الصديق وراعياً","تذق من كمال الحفظ سمو المشارب",4,"ب",1,0],["وكن حائداً عنهم جميعاً فانما","يضل امروء عن غيهم غير حائد",5,"د",1,0],["وكن حمامات جميعاً بعطيل","فأصبحن شتى ما لهن قرين",6,"ن",1,0],["وَكُنْ حِصْنِي وَكُنْ حِرْزِي","وَكُنْ مَالِي وَكُنْ كَنْزِي",7,"ز",2,0],["وكُن حكيماُ قويّاً في إرادتِهِ","لا عاجزاً وَكِلاً يَمشي بإيعاز",8,"ز",1,0],["وكن حليف التقى والعلم فاعن به","والعلم بوباخلاص وأعمال",9,"ل",1,0],["وكن حلسا لبيتك امتثالا","لأمر المصطفى في جملة أخبار",10,"ر",1,0],["وكن حامد وشاكر","لرب العرش الأمجد",11,"د",1,0],["وكن حليف التقى في كل حال","بالقلب والفعل والقول السديد",12,"د",1,0],["وكن حافظ كلامك","لتظفر بالشفاعات",13,"ت",1,0],["وكنْ حَكيماً صابِراً ذاكِراً","فالخيرُ يُعْطاهُ الفتَى الذَّاكِرُ",14,"ر",1,0],["وكن حاكياً للأمر والنهي مخلصاً","لربك وارفع عن تحكمك اليدا",15,"د",2,0],["وكن حافظاً عهد الورى غير عاذر","فمن شرع حكم الحب يستقبح العذر",16,"ر",1,0],["وَكُن حَنوناً عَلى صَبٍّ بِهِ فتكت","صَوارمُ اللَحظ في مضمار هجران",17,"ن",1,0],["وكن حليفَ احتمالٍ","يُعْظمْ لكَ اللهُ أَجْرا",18,"ر",2,0],["وكن حذرا مما يردى وخاشعا","وواظب سؤال اللَه في العسر واليسر",19,"ر",1,0],["وكن حصننا في كل خوف وأمننا","ومعقلنا أنت المؤمل والوزر",20,"ر",1,0],["وكن حاذقا ذا فطنة وتدبر","لتحذر لحفا في الخفاء وفي السر",21,"ر",1,0],["وكن حاضري عند احتضاري وناصري","إذا ما أتاني منكر وهو مغضب",22,"ب",1,0],["وكن حافظا أن النساء ودائعٌ","عوان لدينا احفظ وصيّة مرشد",23,"د",1,0],["وكن حسن الخلائق ذا حياء","طليق الوجه لا شكسا قطوبا",24,"ب",2,0],["وكن حذرا عن مجلس في الطريق قد","نهي عنه إلا مع شروط تعدد",25,"د",1,0],["وكن حافظاً له وكن حارساً","وكن ناصراً له وكن له معين",26,"ن",1,0],["وكن حيث ما كان الخليل فإنه","عزيز عزيز الدين يا نجل مالك",27,"ك",1,0],["وكن حريصا على الأنفاس جميعها","فمطلوبها كلا بفكر ونظرة",28,"ه",1,0],["وكن حذرا من خلطة الناس إن ترد","سلامة دين إن فيهم أبالسا",29,"س",2,0],["وكن حليما ولا تغضب على أحدٍ","فالحلم فيه لأهل الحلم إسرار",30,"ر",1,0],["وكن حافظاً لله فيمن رعيته","وناصحهم في القول والفعل جاهدا",31,"د",2,0],["وكن حازماً ذا همة متيقظاً","وانشر إلى العلياء منك مخالبا",32,"ب",2,0],["وكن حكما على ولي فاني","اسير الحق بالحكم الصريح",33,"ح",1,0],["وكن حذرا ذكيا ذا تأنٍّ","عساك الدهر تنجو بالذكاء",34,"ا",2,0],["وكن حجتي يوم المنية إن دنت","وغطت عظامي صخرة وتراب",35,"ب",1,0],["وكن حذراً في كل أمر وحادث","فما نيل بالمكروه من كان ذا حذر",36,"ر",1,0],["وكن حقل ألغامي وفجّر منابعي","وأحرق غصون الحزن لاتُبْقها خوفا",37,"ف",2,0],["وَ كنْ حَذرًا منَ القوْمِ اللئامِ","فإنَّ الغدْرَ منْ طَبْع اللئام",38,"م",1,0],["وكن حريصا وحاذر من مكائدها","ولا تُؤمن لمُحتال ومِلحاح",39,"ح",1,0],["وكن حليماً ؛ فإن الحلم منقبة","وكن إذا أخطأ الأحباب مِعذارا",40,"ر",2,0]]}