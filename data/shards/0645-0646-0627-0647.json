{"poems":[[110,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[49,"سلام رائح غاد","https://www.aldiwan.net/poem25317.html","الهزج"],[53,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[63,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[107,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[107,"إلى العزى فقد بلغت مداها","https://www.aldiwan.net/poem44038.html","الوافر"],[104,"أمامك أيها العربي يوم","https://www.aldiwan.net/poem32951.html","الوافر"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"وفتية كمصابيح الدجى غرر","https://www.aldiwan.net/poem62458.html","البسيط"],[48,"من عير الخيل إنسانا فقد خبلا","https://www.aldiwan.net/poem23161.html","البسيط"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[168,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[193,"برئت من عقيدة الأشرار","https://www.aldiwan.net/poem35101.html","الرجز"],[305,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[361,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[369,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[422,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[422,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[482,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[487,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[505,"كتبت غيبا على ما قام في الأزل","https://www.aldiwan.net/poem37814.html","البسيط"],[543,"شعراء مغربنا وأنت إمامهم","https://www.aldiwan.net/poem48175.html","عموديه"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138189",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83321","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126843","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86737","الطويل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110735","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63833","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38969","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38136","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38207","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37775","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67843","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67844","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72329","الكامل"],[1151,"","https://poetry.dctabudhabi.ae/diwan/poem/204383","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64954","المديد"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105210","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109123","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110684","السريع"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128714","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118417","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89549","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60955","السريع"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87784","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100484","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204855","المتقارب"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103455","المجتث"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216356","الكان كان"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112650","الرجز"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52991","الطويل"],[3495,"","https://poetry.dctabudhabi.ae/diwan/poem/111161","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86252","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66431","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114530","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135235","الطويل"],[4011,"","https://poetry.dctabudhabi.ae/diwan/poem/45534","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86484","السريع"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36422","الدوبيت"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117275","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117218","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133098","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4859,"تسيّد الجبناء!","https://www.poetsgate.com/ViewPoem.aspx?id=187405",""],[5102,"المعلم رمز الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=12869",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[5410,"عبق الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=152400",""],[5431,"تستوي الهامات عزّا ومنحى ....","https://www.poetsgate.com/ViewPoem.aspx?id=211306",""],[5495,"منو بحالنه","https://www.poetsgate.com/ViewPoem.aspx?id=175423",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""]],"verses":[["مِن أهلِ بيتٍ بلا جرحٍ حَديثُهُمُ","يُعزى إلى المصطفى مَتنًا ومُستَنَدا",0,"د",2,0],["مَناهُ خَيرُ آباءٍ","نَمَتهُم خَيرُ أَجدادِ",1,"د",1,0],["من أهل بيت ساسة راضة","لديهم السم ودرياقه",2,"ق",2,0],["مِن أَهل بِيتِهِ وَلَكن فَزِعَت","مِن جَورِهم وَفِسقِهم أُمُّ القُرى",3,"ا",1,0],["مِن أَهل صَنعاءَ وَدُونَ عَزمِهِ","ما صَنَعت مِن كُلِّ ماضٍ يُنتَضى",3,"ا",1,0],["مُناهدةٌ إن باتَ مثلُكَ طيَّها","تَنفَّسَ مجروحَ الحشا أو تنهَّدا",4,"د",2,0],["مناهلُ تُنكِرُ الوُرّادَ إلا","إذا شربوا الرَّدى عالين صيدا",5,"د",2,0],["مَناةُ مَنَاةُ مالَكِ من بقاءٍ","وأيُّ شَقِيَّةٍ بَلغتْ مُناها",6,"ا",3,0],["مناهجُ للابادة واضحاتٌ","وبالحسنى تنفَّذُو الرصاصِ",7,"ص",1,0],["من أهْلِ بَهرامَ جُورٍ في مناسِبِهِ","ما شِئْتَ من فارسيٍّ نَوبَهاريّ",8,"ي",1,0],["مِنْ أهْلِ بَيْتٍ لم يَنالوا سَعْيَهُم","من فاضِلٍ عَدَلوا به مفضولا",9,"ل",2,0],["مِن أَهلِ هيتٍ سَخِيِّ الجَرمِ ذي أَدَبٍ","لَهُ أَقولُ مِزاحاً هاتِ يا هيتي",10,"ت",2,0],["مَنِ اِهتَدى بِسِوى المَعقولِ أَورَدَهُ","مَن باتَ يَهديهِ ماءً طالَما تَبَلا",11,"ل",2,0],["مِن أَهل ألْيون وبَنبلونَهْ","وأَهلِ أَرنيط وبَرْشلُونَهْ",12,"ه",1,0],["مَناهِجُ فيها لِلهُدى مُتَصَرَّفٌ","مَوارِدُ فيها لِلرَشادِ شَرائِعُ",13,"ع",1,0],["مِن أهلِ بدعة وأهل كفرِ","وَاِحفظهُ بالأنجادِ والأغوارِ",14,"ر",1,0],["مِن أَهلِ بَيتٍ هُمُ لِلَهِ خالِصَةٌ","قَد صَعَدوا بِزِمامِ الأَمرِ وَاِنحَدَروا",15,"ر",3,0],["مناهما بمنى والمروتين وفي","أم القرى خير موطوء هناك وطى",16,"ط",2,0],["مِن أهلِ بيتِ شفاعتَينِ أُعدّتا","لليومِ واحدةٌ وأُخرَى للغَد",17,"د",1,0],["من أَهل هِندٍ وَزيا","دٍ انَّهُم قُرَضُ الحَدائِد",18,"د",1,0],["مناهلُه للظامئين مواردٌ","فلا نَضِبَتْ في الجود تلك الموارد",19,"د",1,0],["مناها إذا ما حانَ يوماً نزالها","هي المجد أو ما يعجب المجد حالها",20,"ه",2,0],["مناهله شرعة الواردين","بحيث النوال وحيث الكرم",21,"م",1,0],["مناهمُ منه ما أصبحتُ أنظِمُهُ","فالقومُ في غُمَّةٍ من حسرةٍ ومُنى",22,"ن",2,0],["من أهل البوادي ليس يجهل شأنهم","بظلم وعدوان وحالة غافل",23,"ل",1,0],["من أَهْلِ بيتٍ لَهُمْ في كلِّ زاوِيَةٍ","سِرٌّ خَفِيٌّ وشأْنٌ كالصَّباحِ جَلي",24,"ل",2,0],["من أهلِ ميدانِ التَفَيهُقِ إنهم","كانوا من الشُّعرَاءِ قوماً بُورا",25,"ر",2,0],["مِن أَهلِهِ وِباطِنٍ وَجَلَلِ","فَقالَ للاِمامِ هَذا قِبَلي",26,"ل",2,0],["مناهله كالسلسبيل عذوبة","بفيّ وباقي الماء إن ذقته مرّ",27,"ر",1,0],["مَناهِلَ الطافِ وَأَعيُنَ حِكمَةٍ","تَظَلُّ عَلى رَوضِ المَعارِفِ تَغدَقُ",28,"ق",1,0],["مِن أهلِ بيتٍ زانهم","كرمٌ ومعروفٌ وحِشمه",29,"م",2,0],["مَناهل أُنسٍ صافِياتُ وَرودِ","وَأَنقى خُدُود زاهيات وُرودِ",30,"د",1,1],["من أهني بعرسه من أهني","غير بدر الهدى وطود الرشاد",31,"د",1,0],["مُناها على ربِّها نائكٌ","له فيشةٌ ضخمةٌ وافره",32,"ر",2,0],["مَن أُهلِكوا خَنقاً وَفي البَحرِ قَد","أُلقُوا وَقَد أَبدى الحَشا بُغضَهم",33,"م",1,0],["مِن أَهلِ بَيتٍ طَرِبوا في الوَرى","واللَّهُ عَنهُم أَذهَبَ الرّجسا",34,"س",2,1],["مِن أَهلِ بَيتٍ طُهِّروا في الورى","وَاللَّه عَنهُم أَذهَبَ الرِّجسا",34,"س",2,0],["مِن أَهلِ عِزٍّ في الأَنامِ مُوطَّدٍ","مِن أَهلِ أَصلٍ في الأَنامِ مفضَّلِ",35,"ل",1,0],["مِن أَهلِ بَحرٍ كاملينَ أكابرِ","خُدّامُه ذا الدَّهرِ لَم يُحزِنهُمُ",36,"م",1,0],["مِن أَهلِ مِكناس وَهُم جَماعَه","الفَضل وَالتَّقى لَهم بِضاعَه",37,"ه",1,0],["مِن أَهل مِكناس وَفاسَ زُمرَه","عشرتُهم كَالزبد فَوقَ التَمره",37,"ه",1,0],["مِن أَهلِ مِصر ساقَه لَها الَّذي","أَنشَأَها مُحتَسِباً لِلمأخذِ",37,"ذ",1,0],["مِن أَهلِ بَغداد أَتَوا لِلشّام","لِما لَهُم لَدَيهِ مِن مَرامِ",37,"م",1,0],["مُنَاهُ بِأنْ يَجْنِي الْمُنى مِنْ ثِمَارِكُمْ","هُبُوبُ الصًّبَا يَحْيى بِهَا مِنْ دِيَارِكُمْ",38,"م",1,0],["مُنَاهَا بِأَنْ تَحْظَى بِزَوْرَةِ سَيِّدٍ","وَلي هِمَّةٌ تَسْمُو بِمَدْحِ مُحَمَّدِ",39,"د",1,0],["من أهل بيت لم يزالوا","في البرية محسنينا",40,"ن",2,0],["من اهتدى بهداهم مهتد وهمُ","نجاة من بعدهم من غمرة الفتن",41,"ن",1,0],["مَنْ أَهانَ المالَ عزَّ ومن","حُرِم التَّقْوَى فقد حَرِما",42,"م",2,0],["مناهل قد عذبت موارداً","لذا لسان المدح فيهم عذبا",43,"ب",2,0],["مِن أَهل بَيت الملك وَالإِماره","وَخَلفه عَساكر جَراره",44,"ه",1,0],["من أهل جاهٍ يطردون فقيرهم","بكلابهم وكذا يكون الجاه",45,"ا",2,0],["مناهل الرجا إليه مترعه","وسبل السؤل إليه مشرعه",46,"ه",1,0],["من أهل بيت أذن اللَه أن","يرفع في محكم تبيان",47,"ن",1,0],["مناهل اشربت في القلب حبا","وموردها الرويّ العذب شربي",48,"ب",2,0],["من أهل وداد ودهم في قلوبنا","ابر وارسى واستطاب له السنى",49,"ن",2,0],["مُناهُم بِجَدعِ الأَنفِ لَو أَن جارَهم","يلاقي من الأرزاءِ نَكباءَ زَعزَعا",50,"ع",2,0],["مناه عود المطايا لو تعود له","بما تحملن من ورد ومن عنم",51,"م",1,0],["من أهل طَسم ويسين بل","من أهل حمّ وطهِ ونون",52,"ن",1,0],["مَناهج الحَق أَمست فيهِ واضِحة","لا نَشتَكي مَعَها ضَيماً وَلا ضَرَعا",53,"ع",2,0],["من أهل بيت تقي زانت أصالتهم","ذؤابة فرعها ينمي إلى كعب",54,"ب",1,0],["من أهلها اقتبست سناها إذ هم","النور الذي لا يعتريه خفاء",55,"ا",2,0],["مناهن في الجوّ تحليقة","وحبٌ قليل وماء وظل",56,"ل",1,0],["مُناها ومن لي لو يَعود نظيرها","وَلِلَّه لَيلات الصفا دام ذِكرُها",57,"ه",2,0],["مُناهِضٍ للبَوازي","مغالبٍ للصُقورِ",58,"ر",1,0],["من أهلكه تخليطه","ما يلتزم بو طبيب",59,"ب",1,0],["من اهتدى لطاعةِ الإلهِ","فذاك ممتازٌ عن الاشباه",60,"ه",1,0],["من اهلك ان صلح يراد بكم","فالله قد ولي التوفيق من قدم",61,"م",1,0],["من أهلِ بَيت طُهّروا تَطهيرا","بجَنبِ عرشِ اللَهِ كانوا نورا",62,"ر",2,0],["مناهجُه في حكمه مستقيمةٌ","ملأ الكونَ بِشراً عدله واعتداله",63,"ل",2,0],["من أهل بيت سقفه وجداره","للمستظل به حمي للجار",64,"ر",1,0],["مناهِلُهُ تَحلو لِورد أَحبة","وَلكِنَّها لِلكاشِحينَ عَلاقِم",65,"م",1,0],["من أهل بيت أتى في الذكر مدحهمُ","قد طهّروا من مساوي الرّجس تطهيرا",66,"ر",2,0],["من اهتدى حققت إن كنتَ مستمعاً","ما أنت لاقيهِ في أخراكَ تحقيقا",67,"ق",2,0],["مناهل مجدٍ للركائب مكرعٌ","وليس لورّادٍ صدورٌ كوارع",68,"ع",1,0],["مَنّاهُمُ مُنيةً كانت لهم كَذِباً","إنَّ المنى إنَّما يوجدن كالحُلُمِ",69,"م",1,0],["من أهيف الخصر هضيم الحشا","تقعده الأرداف عند القيام",70,"م",1,0],["مِن آهَةِ وَجدي وَدُموعي أَخشى","أَن تَمحوكِ الرِياحُ وَالأَمطارُ",71,"ر",1,0],["من آهنا ود