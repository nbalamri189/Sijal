{"poems":[[47,"سلام رائح غاد","https://www.aldiwan.net/poem25317.html","الهزج"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[105,"إلى العزى فقد بلغت مداها","https://www.aldiwan.net/poem44038.html","الوافر"],[102,"أمامك أيها العربي يوم","https://www.aldiwan.net/poem32951.html","الوافر"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[48,"وفتية كمصابيح الدجى غرر","https://www.aldiwan.net/poem62458.html","البسيط"],[46,"من عير الخيل إنسانا فقد خبلا","https://www.aldiwan.net/poem23161.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[164,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[189,"برئت من عقيدة الأشرار","https://www.aldiwan.net/poem35101.html","الرجز"],[300,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[356,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[364,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[393,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[416,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[416,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[477,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[482,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[500,"كتبت غيبا على ما قام في الأزل","https://www.aldiwan.net/poem37814.html","البسيط"],[538,"شعراء مغربنا وأنت إمامهم","https://www.aldiwan.net/poem48175.html","عموديه"],[561,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"]],"verses":[["مَناهُ خَيرُ آباءٍ","نَمَتهُم خَيرُ أَجدادِ",0,"د",1,0],["من أهل بيت ساسة راضة","لديهم السم ودرياقه",1,"ق",2,0],["مِن أَهل بِيتِهِ وَلَكن فَزِعَت","مِن جَورِهم وَفِسقِهم أُمُّ القُرى",2,"ا",1,0],["مِن أَهل صَنعاءَ وَدُونَ عَزمِهِ","ما صَنَعت مِن كُلِّ ماضٍ يُنتَضى",2,"ا",1,0],["مُناهدةٌ إن باتَ مثلُكَ طيَّها","تَنفَّسَ مجروحَ الحشا أو تنهَّدا",3,"د",2,0],["مناهلُ تُنكِرُ الوُرّادَ إلا","إذا شربوا الرَّدى عالين صيدا",4,"د",2,0],["مَناةُ مَنَاةُ مالَكِ من بقاءٍ","وأيُّ شَقِيَّةٍ بَلغتْ مُناها",5,"ا",3,0],["مناهجُ للابادة واضحاتٌ","وبالحسنى تنفَّذُو الرصاصِ",6,"ص",1,0],["من أهْلِ بَهرامَ جُورٍ في مناسِبِهِ","ما شِئْتَ من فارسيٍّ نَوبَهاريّ",7,"ي",1,0],["مِنْ أهْلِ بَيْتٍ لم يَنالوا سَعْيَهُم","من فاضِلٍ عَدَلوا به مفضولا",8,"ل",2,0],["مِن أَهلِ هيتٍ سَخِيِّ الجَرمِ ذي أَدَبٍ","لَهُ أَقولُ مِزاحاً هاتِ يا هيتي",9,"ت",2,0],["مَنِ اِهتَدى بِسِوى المَعقولِ أَورَدَهُ","مَن باتَ يَهديهِ ماءً طالَما تَبَلا",10,"ل",2,0],["مِن أَهل ألْيون وبَنبلونَهْ","وأَهلِ أَرنيط وبَرْشلُونَهْ",11,"ه",1,0],["مَناهِجُ فيها لِلهُدى مُتَصَرَّفٌ","مَوارِدُ فيها لِلرَشادِ شَرائِعُ",12,"ع",1,0],["مِن أهلِ بدعة وأهل كفرِ","وَاِحفظهُ بالأنجادِ والأغوارِ",13,"ر",1,0],["مِن أَهلِ بَيتٍ هُمُ لِلَهِ خالِصَةٌ","قَد صَعَدوا بِزِمامِ الأَمرِ وَاِنحَدَروا",14,"ر",3,0],["مناهما بمنى والمروتين وفي","أم القرى خير موطوء هناك وطى",15,"ط",2,0],["مِن أهلِ بيتِ شفاعتَينِ أُعدّتا","لليومِ واحدةٌ وأُخرَى للغَد",16,"د",1,0],["من أَهل هِندٍ وَزيا","دٍ انَّهُم قُرَضُ الحَدائِد",17,"د",1,0],["مناهلُه للظامئين مواردٌ","فلا نَضِبَتْ في الجود تلك الموارد",18,"د",1,0],["مناها إذا ما حانَ يوماً نزالها","هي المجد أو ما يعجب المجد حالها",19,"ه",2,0],["مناهله شرعة الواردين","بحيث النوال وحيث الكرم",20,"م",1,0],["مناهمُ منه ما أصبحتُ أنظِمُهُ","فالقومُ في غُمَّةٍ من حسرةٍ ومُنى",21,"ن",2,0],["من أهل البوادي ليس يجهل شأنهم","بظلم وعدوان وحالة غافل",22,"ل",1,0],["من أَهْلِ بيتٍ لَهُمْ في كلِّ زاوِيَةٍ","سِرٌّ خَفِيٌّ وشأْنٌ كالصَّباحِ جَلي",23,"ل",2,0],["من أهلِ ميدانِ التَفَيهُقِ إنهم","كانوا من الشُّعرَاءِ قوماً بُورا",24,"ر",2,0],["مِن أَهلِهِ وِباطِنٍ وَجَلَلِ","فَقالَ للاِمامِ هَذا قِبَلي",25,"ل",2,0]]}