{"poems":[[88,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[53,"يا ابن التي لم تزل تجاري","https://www.aldiwan.net/poem66486.html","مخلع البسيط"],[199,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[415,"حتى إذا يئست دعت زفراتها","https://www.aldiwan.net/poem32449.html","الكامل"],[447,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[549,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[4759,"مولودة العام","https://www.poetsgate.com/ViewPoem.aspx?id=204044",""],[4759,"ما بين قوسين","https://www.poetsgate.com/ViewPoem.aspx?id=204048",""],[5277,"صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا","https://www.poetsgate.com/ViewPoem.aspx?id=200675",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""]],"verses":[["حَتّى إِذا يَئِسَ الطَبيبُ وَجاءَها","أَنّي تَلِفتُ تَنَدَّمَت وَتَنَدَّموا",0,"م",3,0],["حَتّى إِذا يَئِسَت وَأَسحَقَ حالِقٌ","لَم يُبلِهِ إِرضاعُها وَفِطامُها",1,"م",3,0],["حَتّى إِذا يَئِسَ الرُماةُ وَأَرسَلوا","غُضفاً دَواجِنَ قافِلاً أَعصامُها",1,"م",3,0],["حتى إذا يومُها أتاها","أوْصَت بنيها خَزُوا بنينا",2,"ن",2,0],["حَتّى إِذا يَئِسَت وَأَسحَقَ ضَرعُها","وَرَأَت بِقِيَّةَ شَلوِهِ فَشَجاها",3,"ا",3,0],["حتّى إذا يئسْتُ دعتْ زَفراتُها","فَيضَ المَدامِعِ بالشّجا المتَعرِّضِ",4,"ض",1,1],["حتى إذا يئس العدو لطيبة","قصد اقتضاء محقق نياته",5,"ت",2,0],["حتى إذا يوم الاخاء تفصَّمت","حلقاته وسطت عليه العقرب",6,"ب",1,0],["حَتَّى إِذا يَئست مِن حَياتي","وَلَم يَبن لي سَبب النجاة",7,"ه",1,0],["حتى إذا يئست حبال تعلقي","ورجعت بالذكرى لما أ تصور",8,"ر",1,0],["حتى إذا يئست عيني تشوفها","وفي متاها تها أدركت. إغراقي",9,"ق",2,0],["حتى إذا يئِسِ النجاةَ على الفلا","داناهُ نورٌ حاطَ في أفقِ المدى",10,"د",2,0],["حَتَّى إذَا يَئِسَتْ وَأَسْحَقَ حَالِقٌ","ورأت بقية فشجاها",11,"ا",3,0],["حتى إذا يُتِّمَ الأطفالُ أو سُحِقَتْ","عظامُهُمْ ، ظنَّ إبليسٌ أن انتصرا",12,"ر",2,0]]}