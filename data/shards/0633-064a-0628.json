id=66160&r=&rc=10",""],[6346,"أغالب قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83393&r=&rc=9",""]],"verses":[["سَيَبعَدُ عَنكُم عَلى حَسرَةٍ","طَويلُ جَوى القَلبِ أَسوانُهُ",0,"ن",2,0],["سَيَبلو مِنكَ هَذا الصَومُ خِرقاً","رَحيبَ الباعِ فَضفاضَ الرِداءِ",1,"ا",2,0],["سَيْبٌ وَسَيْفٌ ضُمِّنَا فِي رَاحَةٍ","ضَمِنَتْ حَيَاةً لِلْوَرَى وَهَلاكاَ",2,"ك",2,0],["سَيَبْقَى عَلَى الأَيَّامِ مَجْدُكَ كَامِلاً","بِرَغْمِ العَوَادِي لَيْسَ يَعْزَوهُ نُقْصَانُ",3,"ن",1,0],["سَيَبكي البَمُّ مِن جَزَعٍ عَلَيهِ","وَتَبكيهِ المَثالِثُ وَالمَثاني",4,"ي",1,1],["سَيَبقى لَكُم إِلا تَزالَ قَصيدَةٌ","إِذا اِسحَنفَرَت أُخرى قَضيبٌ أَروضُها",5,"ض",3,0],["سيبكيه في كلية العلم منبر","ويرثيه من أبنائها النظم والنثر",6,"ر",1,0],["سيبقى على الأيام ذكرك خالداً","به صحف التأريخ قاطبةً تعنى",7,"ن",2,0],["سيبقى له الذِكر الجميل مؤّبداً","تَمُرّ به الأيام حالية الأيدي",8,"د",2,0],["سَيُبكي صَداً في قَبرِ سَلمى ابنِ جَندَلِ","نِكاحُ أَبي الدَهماءِ بِنتَ سَعيدِ",9,"د",1,1],["سَيَبلُغُها خَيري وَيَرجِعُ بَعلُه","إِلَيها وَلَم يُقصَر عَلَيَّ سُتورُها",10,"ر",3,0],["سيبريه شعري حسبَ ما كان راشهُ","ولا خير في شعرٍ يَريش ولا يبري",11,"ر",2,0],["سيبهُ عُقرُ مالهِ","وهْو يُدْعَى فواضلا",12,"ل",2,0],["سَيُبقي لَكَ التاريخُ ذِكراً مُخَلَّداً","فَقَد كُنتَ خَيرَ الناسِ في خَيرِ أُمَّةِ",13,"ه",1,0],["سَيَبلى الصِبا مَهما حَرِصتَ عَلى الصِبا","فَدَعهُ يَذوقُ الحُبَّ مِن قَبلِ أَن يَبلى",14,"ل",2,0],["سيبقى نهار الناس ابيض مبصرا","وان حال دون الشمس سد من السحب",15,"ب",1,0],["سيبقى على جهله جيلنا","ومن بعد ذلك جيل فجيل",16,"ل",1,0],["سيبقى شقائي بقاء حياتي","فان هي زالت فهذا يزول",16,"ل",1,0],["سَيَبعُدُ في التَعَقُّبِ كُلُّ ماضٍ","وَيَقرُبُ بِالتَقَرُّبِ كُلُّ آتِ",17,"ت",1,0],["سَيَبلُغُ ما جَزَيتُكَ مِن ثَنائي","بِمَكَّةَ مَن أَقامَ بِها وَسارا",18,"ر",2,0],["سَيَبلُغُ ما لاقَت مِنَ الشَرِّ جَعفَرٌ","تِهامَةَ مِن رُكبانِها مَن يَغورُها",19,"ر",3,0],["سَيَبلُغُ عَنّي حاجَتي غَيرُ عامِلٍ","بِها مِن ذَوي الحاجاتِ فَيجٌ مُسَرِّعُ",20,"ع",1,0],["سَيَبلُغُ عَنّي غَدوَةَ الريحِ أَنَّها","مَسيرَةُ شَهرٍ لِلرِياحِ الهَواجِمِ",21,"م",1,1],["سَيُبلِغُهُنَّ وَحيُ القَولِ عَنّي","وَيُدخِلُ رَأسَهُ تَحتَ القِرامِ",22,"م",1,0],["سَيُبلِغُ عَنّي الأَخطَلَينِ اِبنَ غالِبٍ","وَأَخطَلَ بَكرٍ حينَ عَبَّ عُبابُها",23,"ب",3,0],["سَيَبتَعِثُ الرِكابَ وَراكِبيها","فَتىً كَالسَيفِ هَجعَتُهُ غِرارُ",24,"ر",1,0],["سيُبدل من صدى نغمٍ شقيٍ","بأنغام المنى وترٌ سعيد",25,"د",1,0],["سَيبسطُ دِينُ اللهِ في الأرضِ ظِلَّهُ","ويحكمُ من ساداتِها كُلَّ حاكم",26,"م",1,0],["سيبقَى السّلاحُ بعيدَ المكانِ","لِيأمنَ مِن قومِنا مَن ذُعِرْ",27,"ر",1,0],["سَيَبقى بَقاءَ الدَهرِ ماقُلتُ فيكُمُ","وَأَمّا الَّذي قَد قِلتُموهُ فَريحُ",28,"ح",1,0],["سَيَبْقَى بِهِ ذِكْرِي عَلَى الدَّهْرِ خَالِداً","وذِكْرُ الْفَتَى بَعْدَ الْمَمَاتِ خُلُودُهُ",29,"د",2,0],["سَيَبْقَى ذَلِكَ النَّثْرُ المُصَفَّى","ويَبْقَى ذَلِكَ الشِّعْرُ الجَمِيلُ",30,"ل",1,0],["سَيَبْقَى الذِّكْرُ جيلاً بَعْدَ جِيلٍ","وَسَعْدُ اللهِ حَيٌّ لاَ يَمُوتُ",31,"ت",1,0],["سَيَبلُغُها خَيري وَيَرجِعُ بَعلُها","إِلَيها وَلَم يُقصَر عَلَيَّ سُتورُها",32,"ر",3,0],["سيبكيه في زاهيه والزاهر الندى","وطلابه , والعرف ثم نكير",33,"ر",1,0],["سيُبْلى زمانُك حتى الحديد َ","ويُبليه هذا النسيجُ الرقيق",34,"ق",1,0],["سَيَبدُو أنَّ قَاضِينَا الأمِينَا","أمِينٌ لَن يَمِيلَ ولَن يَمِينَا",35,"ن",2,1],["سَيَبينُ خَوفُكَ في أَسِرَّةِ وَجهِهِ","فَليَنظُراهُ كُلَّما ذَكَراكا",36,"ك",2,0],["سَيَبقى ولا يَبلى ويَخفى ولا يُرى","فَما عَلِموا من أَمرِنَا بِبَيَانِ",37,"ن",1,0],["سيّبَ السبيَ للرضاعِ وفازت","بأياديهِ أختهُ الشيماءُ",38,"ا",2,0],["سيبقى صباب من حنيني أديره","لقلب من الأشواق والوجد ينهل",39,"ل",1,0],["سَيبينُ الخداعُ في الحُبِّ يَوماً","إِنَّ في مُقلَتَيكِ سِرّاً رَهيبا",40,"ب",2,0],["سَيَبلوا وَشيكاً مِنهُما لَيثُ غابَةٍ","تُمَزِّقُ أَشلاءَ الأَعادي أَظافِرُه",41,"ر",2,0],["سَيَبقى الَّذي حبَّرتُه مِنِ مَدائِحي","وَيَفنى الَّذي أَعطَيتَه وَيَروح",42,"ح",1,0],["سَيَبلُغ بَغداداً فَيهجم قائِلٌ","أَقِم يا حُسامي في صَوائِل واهجم",43,"م",1,0],["سيبويه العصر من هذبه","أدب العلم فأروى من ورد",44,"د",1,0],["سَيَبلغ صيتُ دولتكَ الثريّا","وَيأوي مجدَها ركنٌ شديدٌ",45,"د",1,0],["سَيبٌ مِنَ اليَمِّ أَو سَيلٌ مِنَ العَرَمِ","وَكَم وَكَم آيَةً مِنهُ لَقَد بَهَرَت",46,"ت",1,0],["سَيبْقَى ويَفْنَى الناظِرون وتنقضي","قبائلُ حتّى ينقضي وشعوب",47,"ب",1,0],["سَيَبْلغُ ما أمّلتَ فيهِ من العُلَى","ويَلْبَسُ بُرداً للسَعادةِ لا يَبْلَى",48,"ل",2,0],["سيبكي عليه الليل والشمس والضحى","ويبكي عليه الفجر والعصر والظهر",49,"ر",1,0],["سيبكي عليه كل محراب مسجد","ويلبس سربالاً من الظلمات",50,"ت",1,0],["سيبدلك اجتماعا بعد بي","فعقبى كل تحريك سكون",51,"ن",1,0],["سيبكي عليك الدَهر يا ابن ربيعة","خلافك لا عيش هنيّ ولا دهر",52,"ر",1,0],["سيبكي عليه العلم والحلم والتقى","وإن كن عنه للمهيمن قربانا",53,"ن",2,0],["سَيبٌ على سَيب كما تقطَّعتْ","أوكية المزن وحُلَّت عُصُمُهْ",54,"م",2,0],["سيبعِدُ خَطوَه فيها","غداً ويوسِّع القَدَما",55,"م",2,0],["سيُبصر مستقرِباً من دعا","ك موضعَ تفريطِه مُبعَدا",56,"د",2,0],["سيبرأ كل منكم من خليله","إذا بعث الموتى وقاموا من الثَرى",57,"ر",2,0],["سيبقى مليكاً مهيباً رهيباً","سعيداً رشيدا مجداً مجيدا",58,"د",2,0],["سيبسطُ لي هذا البساطُ مرونقاً","بعزٍّ تمسُّ الباب منه الفراقدُ",59,"د",1,0],["سيبُزُّ في طيِّ الرَّقائِقِ جَوْهراً","ويَفيضُ في حالِ الغُيوبِ كواكِبَا",60,"ب",2,0],["سيبكيك عصر كنت خير ثقاته","وأيام ملك كنت أكفي كفايته",61,"ت",2,0],["سيبلى على قرب جديد فعالكم","وتبقى على مر الجديدين أقوالي",62,"ل",2,0],["سيُبرِدُ قَلَبَكَ الحَرّانَ ظلمِي","وَيَروِي شوقَكَ الظّامِي زُلالي",63,"ل",2,0],["سَيُبدي لكم مِمّا يُعيدُ فَوائِداً","فلمّا رآنا لا أَعادَ وَلا أَبدا",64,"د",2,0],["سَيَبكيكَ مرنانُ العَشيِّ يُجيبُهُ","لَطيفُ بِنانِ الكَفِّ دَرمٌ مَرافِقُهْ",65,"ق",2,0],["سيبدي القوم حباً واحتفالا","بمقدمها وحمداً وامتثالا",66,"ل",2,0],["سيبكى علىَّ الفَضلُ والعلم إنْ رمتْ","بمثلى يَدُ الدَّهْر العسُوفِ المراميا",67,"ي",2,0],["سَيْبُكَ عيش للموالي كما","مَوْتُ العِدَى من سيْفكَ الباِتر",68,"ر",1,0],["سَيْبُكِ ذاتَ العِقْدِ وَالسُيُوفِ","بِمُقْلَتَيْ مَكْحُولَةِ الذَرِيفِ",69,"ف",1,0],["سَيْباً وَدُفّاعاً كَسَيْل الأَصْبَغِ","يَغْمِسْنَ مَنْ غَمَسْنَهُ فِي الأَهْيَغِ",70,"غ",1,0],["سيبدي العرض مني يوم حشر","أموراً خائفٌ منها افتضاحا