{"poems":[[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[77,"هلم فما بيني وبينك ثالث","https://www.aldiwan.net/poem36673.html","الطويل"],[93,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11135.html","المتقارب"],[30,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[88,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[27,"أربت بعينيك الدموع السوافح","https://www.aldiwan.net/poem5699.html","الطويل"],[72,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[91,"أقامت لدى مرآتها تتأمل","https://www.aldiwan.net/poem9057.html","عموديه"],[91,"إلى حيث ألقت يا زمان المظالم","https://www.aldiwan.net/poem62715.html","عموديه"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[45,"إني تركت الصبا عمدا ولم أكد","https://www.aldiwan.net/poem63458.html","البسيط"],[46,"لا يعجبن الفتى بفضل","https://www.aldiwan.net/poem22473.html","مجزوء البسيط"],[46,"إذا وفت لتجار الهند فائدة","https://www.aldiwan.net/poem22616.html","البسيط"],[46,"لقد جاء قوم يدعون فضيلة","https://www.aldiwan.net/poem22949.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54868","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[77,"هلُمَّ فما بيني وبينَكَ ثالثُ","https://www.poetsgate.com/ViewPoem.aspx?id=33656",""],[144,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[144,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[161,"كما كان إسماعيل يحيى به يحيا","https://www.aldiwan.net/poem58823.html","الطويل"],[161,"تألق نور العدل وانطفأ الظلم","https://www.aldiwan.net/poem58882.html","الطويل"],[182,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[236,"دار الهوى بين اللوى وشراف","https://www.aldiwan.net/poem31818.html","الكامل"],[260,"عليك سلام الله في الحي يا يحيى","https://www.aldiwan.net/poem35732.html","الطويل"],[282,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[306,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[349,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[365,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[367,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[381,"بدا البرق مشتاقا فباتت سيوفه","https://www.aldiwan.net/poem48839.html","الطويل"],[417,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[435,"إذا ما خففت كعهد الصبا","https://www.aldiwan.net/poem25695.html","المتقارب"],[442,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[442,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[453,"فأبرزتها عذراء في زي غادة","https://www.aldiwan.net/poem13699.html","الطويل"],[459,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[462,"قل للمجاهد قولا عن أخي ثقة","https://www.aldiwan.net/poem15159.html","البسيط"],[465,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[483,"فتنت بشمس الحسن لما تسترت","https://www.aldiwan.net/poem24278.html","الطويل"],[483,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[483,"وأعلم حقا أن بعدي عنكم","https://www.aldiwan.net/poem24416.html","عموديه"],[501,"تلألأ في الأكوان نور محيانا","https://www.aldiwan.net/poem37752.html","الطويل"],[552,"رأينا بوادي الرمث ظبي صريمة","https://www.aldiwan.net/poem47874.html","الطويل"],[559,"لمن أشتكي ما بي وما بي هو الله","https://www.aldiwan.net/poem33587.html","الطويل"],[559,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[559,"ثلاث عليها يدور","https://www.aldiwan.net/poem34506.html","مجزوء المتقارب"],[559,"دوائر أوهام بها شغل الفكر","https://www.aldiwan.net/poem34532.html","الطويل"],[565,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""]],"verses":[["وَما ثَنى الدَهرُ عَزمي عَن مُهاجَمَةٍ","وَخَوضِ مَعمَعَةٍ في السَهلِ وَالجَبَلِ",0,"ل",1,0],["وما ثَمَّ غيْرُ الكأسِ والآسِ والهَوى","وغَيْرُ المَثاني ساعَدَتْها المَثالِثُ",1,"ث",1,0],["وَمَا ثُمَّ عَيبٌ نُعَابُ بِهِ","مَعاذٌ صَبَابَتِنَا الطَّاهِرَهْ",2,"ر",2,0],["وَما ثَغَبٌ باتَت تُصَفِّقُهُ الصَبا","قَرارَةُ نِهيٍ أَتأَقَتهُ الرَوائِحُ",3,"ح",1,0],["وماثَلَّة قد أهملتها رُعاتها","بمأسدة جاعت لعشرٍ أسودها",4,"د",3,0],["وَما ثَغَبٌ باتَت تُصَفِّقُهُ الصَبا","بِصَرّاءِ نِهيٍ أَتأَقَتهُ الرَوايِحُ",5,"ح",1,0],["وماثل ريق النحل لذة ريقه","فقال اللّمى ما أخجل المتنحّلا",6,"ل",2,0],["وَما ثَمَّ مِن أَمرٍ عَويصٍ وَإِنَّما","ضَعيفُ النُهى في وَهمِهِ السَهلِ مُعضِلُ",7,"ل",1,0],["وَما ثَمَّ غَيرُ البَغيِ وَالظُلمِ وَالأَذى","فَقُبِّحتَ مِن عَصرٍ كَثيرِ السَخائِمِ",8,"م",1,0],["وَما ثَناكَ كَلامُ الناسِ عَن كَرَمٍ","وَمَن يَسُدُّ طَريقَ العارِضِ الهَطِلِ",9,"ل",1,0],["وَما ثَنى مُستَهاماً عَن صَبابَتِهِ","مِثلُ الزَماعِ وَوَخدِ العِرمِسِ الأَجَدِ",10,"د",1,0],["وَما ثَنى الحادِثاتُ مَعداً","مَن مِثلَ بِسطامَ وَاِبنَ مَعدي",11,"د",2,0],["وَما ثَعالِبُ في قَيسٍ وَلا يَمنٍ","إِلّا ثَعالِبُ دُجنٌ تَنفُضُ الوَبَرا",12,"ر",2,0],["وَما ثَبَّتوا مِن شاهِدٍ يُهتَدى بِهِ","فَإِن لَزَموا دَعواهُمُ فَاِلزَموا الدَفعا",13,"ع",2,0],["وَمَآثِرٌ سَطعَتْ كَبَعْضِ شُعَاعِهَا","هَذي الشُّمُوسُ وَهَذِهِ الأَقْمُارُ",14,"ر",1,0],["وَمَا ثَقَّفَ الأَلْبَابَ مِثْلُ بَيَانِهِ","وَما شَرَّفَ الآدَابَ وَالأُدَبَاءَ",15,"ا",2,0],["وما ثَمَّ غيرُ الكاس والآسي والهَوى","وغيرُ المثاني ساعَدَتْها المثالثُ",16,"ث",1,0],["وَما ثَناها وَإِن أَغمادُها خَلِقَت","صَوارِمٌ حُلِّيَت أَغمادُها ذَهَبا",17,"ب",2,0],["وَما ثَبَتَت إِلّا لَهُ حُجَجُ العُلى","وَلا أَقلَعَت إِلّا بِهِ الحِجَجُ الغُبرُ",18,"ر",1,0],["وما ثم إلا من يشق نحورهم","بأيديكم فيهم ويلويهم لَيّا",19,"ي",2,0],["وما ثم شيءْ غير هذا فووخذوا","بأعمالهم حتى يتوبوا وينزموا",20,"م",3,0],["وماثِلاً مِن مَغَانِى الدّارِ قَد لعِبَت","هُوجُ الرِّياحِ بباقِى رَسمِهِ حِقَبَا",21,"ب",2,0],["وَما ثمَّ مَن يَدري حقيقةَ رَبّهِ","وَفي العجزِ مثلُ العقلِ أرفعُها قدرا",22,"ر",2,0],["وَما ثمّ إِصلاح سِوى دين أحمدٍ","وَقَد عَزفوا لكنّهم كابروا كبرا",22,"ر",2,0],["وَمَآثِرٌ نَبَوِيَّةٌ حيزَت وِرا","ثَتُها عَنِ الأَجدادِ وَالأَسلافِ",23,"ف",1,0],["وما ثمّ من ذاتٍ سوى الذات تنجلي","بأسما صفاتِ الحقّ قامت بها الأشيا",24,"ي",2,0],["ومآثر لم يتبع","آثارها أحد فضل",25,"ل",1,0],["وَمآثر عفّت عَلى أثرِ الألى","وَخصالُ فضلٍ حُزنَ خصل رهانِ",26,"ن",1,0],["وَمَا ثَنَتِ الصَّرائمُ منهُ رَأْساً","وَلا رَدَّتْهُ حَاشاكَ المَقَاوِدْ",27,"د",1,0],["وما ثار ذو شِبلَيْنِ من دونِ غِيلِه","بعَينَيْنِ كالمَقْدودَتَينِ منَ الجَمر",28,"ر",1,0],["وَما ثَمَّ مِمّا أَرجَفونا وَأَرجَفوا","بِهِ غَيرُ أَمواجٍ تَطيشُ وَتَستَبُّ",29,"ب",1,0],["وَما ثُمَّ ثَوب كَالقَناعة ساتِرٌ","كَما لا يَزين الزُهد إِلّا التَنَسُك",30,"ك",1,0],["وما ثبّت الله من دولة","بغير عدالة سلطانها",31,"ن",3,0],["وَما ثَقُلَتْ كِبَراً وَطْأَتي","وَلَكِنْ أجُرُّ وَرائي السِّنينا",32,"ن",2,0],["وَمآثر الآباء لا تعدوكما","فالحمد نهج مآثر الآباء",33,"ا",2,0],["ومآثر ومفاخر وعمائر","عمّرتها وعشائر بك رُوّعوا",34,"ع",3,0],["وما ثمَّ إِلاّ نبعَة الشعر نبعة","يرنّ بها طيرُ الفصاحة والنبل",35,"ل",1,0],["وما ثهلانُ تشرف قُنَّتاه","بأحملَ للنوائب من فؤادي",36,"د",2,0],["وما ثناك عن الحقِّ الخفيِّ هَوىً","ولا أطَّباكَ إلى مذمومةٍ طمعُ",37,"ع",1,0],["ومآثر أثلتموها يا بني أيوب","كل العد عن إحصائها",38,"ا",3,0],["وما ثم من يقوى لقرص شعاعها","كفاحا على أن ليس ثم نقاب",39,"ب",1,0],["وما ثم من شيء إلا كنت أساسه","لأني نسخت الكل من فتح خوختي",40,"ي",1,0],["وما ثم غير في الحقيقة ظاهر","لمن دق أو قد ران بين الضمائر",41,"ر",1,0],["وما ثَمَّ بابٌ للرَّسولِ وآلِهِ","بكلِّ مَفازاتِ الوُجوداتِ إِلاَّنا",42,"ن",2,0],["وَما ثغرُهُ إلّا حَصىً من غمامةٍ","وَما فَرعه في العينِ إلّا أساودُ",43,"د",1,0],["وما ثم إلا جنةٌ وجهنم","فجنتنا الله التي قل هو الله",44,"ل",2,0],["وما ثم توليدٌ وليس مناسباً","لها ذاك بل وصفٌ إليها له ضم",45,"م",1,0],["وما ثم غير الذي","له الأمر وهو الأمور",46,"ر",1,0],["وما ثمَّ إلا الوهم قوة حضرة","إلهية عنها بدا السر والجهر",47,"ر",1,0],["وما ثم إلا راكع ومهلل","وتالٍ كتاب الله والسنة الغرا",48,"ر",2,0]]}