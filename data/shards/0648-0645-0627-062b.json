{"poems":[[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[77,"هلم فما بيني وبينك ثالث","https://www.aldiwan.net/poem36673.html","الطويل"],[93,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11135.html","المتقارب"],[30,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[88,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[27,"أربت بعينيك الدموع السوافح","https://www.aldiwan.net/poem5699.html","الطويل"],[72,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[91,"أقامت لدى مرآتها تتأمل","https://www.aldiwan.net/poem9057.html","عموديه"],[91,"إلى حيث ألقت يا زمان المظالم","https://www.aldiwan.net/poem62715.html","عموديه"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[45,"إني تركت الصبا عمدا ولم أكد","https://www.aldiwan.net/poem63458.html","البسيط"],[46,"لا يعجبن الفتى بفضل","https://www.aldiwan.net/poem22473.html","مجزوء البسيط"],[46,"إذا وفت لتجار الهند فائدة","https://www.aldiwan.net/poem22616.html","البسيط"],[46,"لقد جاء قوم يدعون فضيلة","https://www.aldiwan.net/poem22949.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54868","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[77,"هلُمَّ فما بيني وبينَكَ ثالثُ","https://www.poetsgate.com/ViewPoem.aspx?id=33656",""]],"verses":[["وَما ثَنى الدَهرُ عَزمي عَن مُهاجَمَةٍ","وَخَوضِ مَعمَعَةٍ في السَهلِ وَالجَبَلِ",0,"ل",1,0],["وما ثَمَّ غيْرُ الكأسِ والآسِ والهَوى","وغَيْرُ المَثاني ساعَدَتْها المَثالِثُ",1,"ث",1,0],["وَمَا ثُمَّ عَيبٌ نُعَابُ بِهِ","مَعاذٌ صَبَابَتِنَا الطَّاهِرَهْ",2,"ر",2,0],["وَما ثَغَبٌ باتَت تُصَفِّقُهُ الصَبا","قَرارَةُ نِهيٍ أَتأَقَتهُ الرَوائِحُ",3,"ح",1,0],["وماثَلَّة قد أهملتها رُعاتها","بمأسدة جاعت لعشرٍ أسودها",4,"د",3,0],["وَما ثَغَبٌ باتَت تُصَفِّقُهُ الصَبا","بِصَرّاءِ نِهيٍ أَتأَقَتهُ الرَوايِحُ",5,"ح",1,0],["وماثل ريق النحل لذة ريقه","فقال اللّمى ما أخجل المتنحّلا",6,"ل",2,0],["وَما ثَمَّ مِن أَمرٍ عَويصٍ وَإِنَّما","ضَعيفُ النُهى في وَهمِهِ السَهلِ مُعضِلُ",7,"ل",1,0],["وَما ثَمَّ غَيرُ البَغيِ وَالظُلمِ وَالأَذى","فَقُبِّحتَ مِن عَصرٍ كَثيرِ السَخائِمِ",8,"م",1,0],["وَما ثَناكَ كَلامُ الناسِ عَن كَرَمٍ","وَمَن يَسُدُّ طَريقَ العارِضِ الهَطِلِ",9,"ل",1,0],["وَما ثَنى مُستَهاماً عَن صَبابَتِهِ","مِثلُ الزَماعِ وَوَخدِ العِرمِسِ الأَجَدِ",10,"د",1,0],["وَما ثَنى الحادِثاتُ مَعداً","مَن مِثلَ بِسطامَ وَاِبنَ مَعدي",11,"ي",1,0],["وَما ثَعالِبُ في قَيسٍ وَلا يَمنٍ","إِلّا ثَعالِبُ دُجنٌ تَنفُضُ الوَبَرا",12,"ر",2,0],["وَما ثَبَّتوا مِن شاهِدٍ يُهتَدى بِهِ","فَإِن لَزَموا دَعواهُمُ فَاِلزَموا الدَفعا",13,"ع",2,0],["وَمَآثِرٌ سَطعَتْ كَبَعْضِ شُعَاعِهَا","هَذي الشُّمُوسُ وَهَذِهِ الأَقْمُارُ",14,"ر",1,0],["وَمَا ثَقَّفَ الأَلْبَابَ مِثْلُ بَيَانِهِ","وَما شَرَّفَ الآدَابَ وَالأُدَبَاءَ",15,"ا",2,0],["وما ثَمَّ غيرُ الكاس والآسي والهَوى","وغيرُ المثاني ساعَدَتْها المثالثُ",16,"ث",1,0]]}