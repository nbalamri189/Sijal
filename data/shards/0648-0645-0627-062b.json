etsgate.com/ViewPoem.aspx?id=201289",""],[5136,"بما أكافيك يا ابن الشم يا ملك","https://www.poetsgate.com/ViewPoem.aspx?id=121642",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5431,"في صداقة الدكتور ناصر أبو عون...","https://www.poetsgate.com/ViewPoem.aspx?id=202127",""],[5660,"رَأَتها تَنحَني عَينايَ حَتّى","https://www.poetsgate.com/ViewPoem.aspx?id=27725",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[6056,"فخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=156699",""],[2220,"ولما رأيت الكونَ يعلو ويسفلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11635&r=&rc=509",""],[6355,"هلال رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66597&r=&rc=57",""]],"verses":[["وَما ثَنى الدَهرُ عَزمي عَن مُهاجَمَةٍ","وَخَوضِ مَعمَعَةٍ في السَهلِ وَالجَبَلِ",0,"ل",1,0],["وما ثَمَّ غيْرُ الكأسِ والآسِ والهَوى","وغَيْرُ المَثاني ساعَدَتْها المَثالِثُ",1,"ث",1,0],["وَمَا ثُمَّ عَيبٌ نُعَابُ بِهِ","مَعاذٌ صَبَابَتِنَا الطَّاهِرَهْ",2,"ر",2,0],["وَما ثَغَبٌ باتَت تُصَفِّقُهُ الصَبا","قَرارَةُ نِهيٍ أَتأَقَتهُ الرَوائِحُ",3,"ح",1,0],["وماثَلَّة قد أهملتها رُعاتها","بمأسدة جاعت لعشرٍ أسودها",4,"د",3,0],["وَما ثَغَبٌ باتَت تُصَفِّقُهُ الصَبا","بِصَرّاءِ نِهيٍ أَتأَقَتهُ الرَوايِحُ",5,"ح",1,0],["وماثل ريق النحل لذة ريقه","فقال اللّمى ما أخجل المتنحّلا",6,"ل",2,0],["وَما ثَمَّ مِن أَمرٍ عَويصٍ وَإِنَّما","ضَعيفُ النُهى في وَهمِهِ السَهلِ مُعضِلُ",7,"ل",1,0],["وَما ثَمَّ غَيرُ البَغيِ وَالظُلمِ وَالأَذى","فَقُبِّحتَ مِن عَصرٍ كَثيرِ السَخائِمِ",8,"م",1,0],["وَما ثَناكَ كَلامُ الناسِ عَن كَرَمٍ","وَمَن يَسُدُّ طَريقَ العارِضِ الهَطِلِ",9,"ل",1,0],["وَما ثَنى مُستَهاماً عَن صَبابَتِهِ","مِثلُ الزَماعِ وَوَخدِ العِرمِسِ الأَجَدِ",10,"د",1,0],["وَما ثَنى الحادِثاتُ مَعداً","مَن مِثلَ بِسطامَ وَاِبنَ مَعدي",11,"د",2,0],["وَما ثَعالِبُ في قَيسٍ وَلا يَمنٍ","إِلّا ثَعالِبُ دُجنٌ تَنفُضُ الوَبَرا",12,"ر",2,0],["وَما ثَبَّتوا مِن شاهِدٍ يُهتَدى بِهِ","فَإِن لَزَموا دَعواهُمُ فَاِلزَموا الدَفعا",13,"ع",2,0],["وَمَآثِرٌ سَطعَتْ كَبَعْضِ شُعَاعِهَا","هَذي الشُّمُوسُ وَهَذِهِ الأَقْمُارُ",14,"ر",1,0],["وَمَا ثَقَّفَ الأَلْبَابَ مِثْلُ بَيَانِهِ","وَما شَرَّفَ الآدَابَ وَالأُدَبَاءَ",15,"ا",2,0],["وما ثَمَّ غيرُ الكاس والآسي والهَوى","وغيرُ المثاني ساعَدَتْها المثالثُ",16,"ث",1,0],["وَما ثَناها وَإِن أَغمادُها خَلِقَت","صَوارِمٌ حُلِّيَت أَغمادُها ذَهَبا",17,"ب",2,0],["وَما ثَبَتَت إِلّا لَهُ حُجَجُ العُلى","وَلا أَقلَعَت إِلّا بِهِ الحِجَجُ الغُبرُ",18,"ر",1,0],["وما ثم إلا من يشق نحورهم","بأيديكم فيهم ويلويهم لَيّا",19,"ي",2,0],["وما ثم شيءْ غير هذا فووخذوا","بأعمالهم حتى يتوبوا وينزموا",20,"م",3,0],["وماثِلاً مِن مَغَانِى الدّارِ قَد لعِبَت","هُوجُ الرِّياحِ بباقِى رَسمِهِ حِقَبَا",21,"ب",2,0],["وَما ثمَّ مَن يَدري حقيقةَ رَبّهِ","وَفي العجزِ مثلُ العقلِ أرفعُها قدرا",22,"ر",2,0],["وَما ثمّ إِصلاح سِوى دين أحمدٍ","وَقَد عَزفوا لكنّهم كابروا كبرا",22,"ر",2,0],["وَمَآثِرٌ نَبَوِيَّةٌ حيزَت وِرا","ثَتُها عَنِ الأَجدادِ وَالأَسلافِ",23,"ف",1,0],["وما ثمّ من ذاتٍ سوى الذات تنجلي","بأسما صفاتِ الحقّ قامت بها الأشيا",24,"ي",2,0],["ومآثر لم يتبع","آثارها أحد فضل",25,"ل",1,0],["وَمآثر عفّت عَلى أثرِ الألى","وَخصالُ فضلٍ حُزنَ خصل رهانِ",26,"ن",1,0],["وَمَا ثَنَتِ الصَّرائمُ منهُ رَأْساً","وَلا رَدَّتْهُ حَاشاكَ المَقَاوِدْ",27,"د",1,0],["وما ثار ذو شِبلَيْنِ من دونِ غِيلِه","بعَينَيْنِ كالمَقْدودَتَينِ منَ الجَمر",28,"ر",1,0],["وَما ثَمَّ مِمّا أَرجَفونا وَأَرجَفوا","بِهِ غَيرُ أَمواجٍ تَطيشُ وَتَستَبُّ",29,"ب",1,0],["وَما ثُمَّ ثَوب كَالقَناعة ساتِرٌ","كَما لا يَزين الزُهد إِلّا التَنَسُك",30,"ك",1,0],["وما ثبّت الله من دولة","بغير عدالة سلطانها",31,"ن",3,0],["وَما ثَقُلَتْ كِبَراً وَطْأَتي","وَلَكِنْ أجُرُّ وَرائي السِّنينا",32,"ن",2,0],["وَمآثر الآباء لا تعدوكما","فالحمد نهج مآثر الآباء",33,"ا",2,0],["ومآثر ومفاخر وعمائر","عمّرتها وعشائر بك رُوّعوا",34,"ع",3,0],["وما ثمَّ إِلاّ نبعَة الشعر نبعة","يرنّ بها طيرُ الفصاحة والنبل",35,"ل",1,0],["وما ثهلانُ تشرف قُنَّتاه","بأحملَ للنوائب من فؤادي",36,"د",2,0],["وما ثناك عن الحقِّ الخفيِّ هَوىً","ولا أطَّباكَ إلى مذمومةٍ طمعُ",37,"ع",1,0],["ومآثر أثلتموها يا بني أيوب","كل العد عن إحصائها",38,"ا",3,0],["وما ثم من يقوى لقرص شعاعها","كفاحا على أن ليس ثم نقاب",39,"ب",1,0],["وما ثم من شيء إلا كنت أساسه","لأني نسخت الكل من فتح خوختي",40,"ي",1,0],["وما ثم غير في الحقيقة ظاهر","لمن دق أو قد ران بين الضمائر",41,"ر",1,0],["وما ثَمَّ بابٌ للرَّسولِ وآلِهِ","بكلِّ مَفازاتِ الوُجوداتِ إِلاَّنا",42,"ن",2,0],["وَما ثغرُهُ إلّا حَصىً من غمامةٍ","وَما فَرعه في العينِ إلّا أساودُ",43,"د",1,0],["وما ثم إلا جنةٌ وجهنم","فجنتنا الله التي قل هو الله",44,"ل",2,0],["وما ثم توليدٌ وليس مناسباً","لها ذاك بل وصفٌ إليها له ضم",45,"م",1,0],["وما ثم غير الذي","له الأمر وهو الأمور",46,"ر",1,0],["وما ثمَّ إلا الوهم قوة حضرة","إلهية عنها بدا السر والجهر",47,"ر",1,0],["وما ثم إلا راكع ومهلل","وتالٍ كتاب الله والسنة الغرا",48,"ر",2,0],["وَمَآثِراً في الخافِقينَ حَديثَها","وَمَعالِياً رَنَت حَلى وَحُجولا",49,"ل",2,0],["وَمآثر الملك السَعيد محمد","تَقضي بِأَن نُثني عَلَيهِ وَنَشكره",50,"ر",2,0],["وماثَل عِلْماً سيبويهٍ وشيخَهُ","إذا ما عَروضُ الشّعرِ والنحوُ قَدْ عُدّا",51,"د",2,0],["وما ثأرُ خصم عند خصمٍ تريده","ولكنه حقٌّ على القَرْم للقرم",52,"م",1,0],["وَمَأثِرَةٌ عادِيَّةٌ لَن تَنالَها","وَبَيتٌ رَفيعٌ لَم تَخُنهُ القَواعِدُ",53,"د",1,0],["وما ثار فوق المرء غبرة محنة","إذا استصعبت إلا وحرص يثيرها",54,"ر",3,0],["وَمآثِرٍ كَانَت لَهُم مَعلُومَةٍ","فِى الصَّالِحِينَ وَسُؤدُدٍ لَم يُنحَلِ",55,"ل",1,0],["وَمَآثِرٌ في اللاذِقِية جَمَّةٌ","يَثنى عَلَيكَ بِها بِأَخلَص نَيَّةٍ",56,"ه",1,0],["ومآثر نطقت بحمد محمَّدٌ","في كل قطر كالخَطيب المُصَقّعِ",57,"ع",1,0],["وَمَآثِراً مَأْثُورةً أَحْكَامُهَا","عَضَدَ المُحَقِّقُ نَصَّهَا بِقِيَاسِ",58,"س",1,0],["وَمَا ثَمَّ إِلاَّ اللَّهُ هَادٍ وَنَاصِرٌ","وَإنْ تَكُ قَدْ أَحْبَبْتَ إنَّكَ لاَ تَهْدِي",59,"د",2,0],["ومآثر قد خلدت فكأنها","غرر وعزم مثل حد غرار",60,"ر",1,0],["ومآثرٌ غراءُ بادرةٌ","لم يحصها عدٌّ ولاحصرُ",61,"ر",1,0],["ومآثراً عُمريَّةً بقليلها","كثرت عداد الشهبِ لا بكثيرها",62,"ر",3,0],["ومآثرٍ بزغت بزوغ الشمس لا","تخفى ولا عن مقلةٍ عمياء",63,"ا",2,0],["وما ثنى عزمَهُ عن بيت خالقه ال","عام الذي بنحوسٍ عمَّتِ اِتُّهِمَا",64,"م",2,0],["ومآثرٌ للدين والدنيا بها","تتحدث الأغوار والأنجاد",65,"د",1,0],["وما ثوى بلداً إلا أقام به","من الهداية ركناً غير مهدود",66,"د",1,0],["وما ثَنَى رَثيَانٌ مِنهُمُ غَضَبى","ولا بَنو قُنفُذ فَسوُ العصافيرِ",67,"ر",1,1],["ومآثِراً ومَفاخِراً وشَمائلاً","وفَواضِلاً وفضائلاً وإِباءَ",68,"ا",2,0],["ومآثر شهد العدو بفضلها","والحق ابلج والسيوف عواري",69,"ر",2,0],["وما ثَم إلاَّ الحقُّ ما ثَم غيره","ولكنهم قالوا محققٌ ومُبطلُ",70,"ل",1,0],["وما ثم سترٌ غير أني فرضته","ومَنْ يقبلِ النقصانَ قد يقبل المشا",71,"ش",2,0],["وما ثمّ إلا قائمٌ متحيرٌ","بأعراضِه فانظر لعلك تبلغ",72,"غ",1,0],["وما ثم أقوالٌ تُعاد بعينها","إلا كلُّ ما في الكونِ لله له بداء",73,"ا",2,0],["وما ثَم ذات تستحق لعينها","وجود مديح أو هجاء بلا فعل",74,"ل",1,0],["وما ثَمَّ لفظَ يدركُ السمعَ حرفُه","وأدري بأني ناطقٌ ومكلِّم",75,"م",1,0],["وما ثَم صوتٌ لا ولا ثم أحرف","كما قال قبلي ناظمٌ متقدِّم",75,"م",1,0],["وما ثم تصريحٌ لذاك عيوننا","إذا ما عجزنا بالدموعِ ذوارف",76,"ف",1,0],["وما ثم إلا سالك ومسلك","بذا قالتِ الأسلاف منا السوالف",76,"ف",1,0],["وما ثَم إلا ما ذكرتُ فحققوا","ولا تك من أهلِ التحكم والظلمِ",77,"م",1,0],["وما ثم عينٌ تدرك العينَ ذاته","فيخلو عن الكيف المحكم والكمِّ",78,"م",1,0],["وما ثم إلا أخذ إحسان ظالم","فإن تفن عن مظلومه حمل الردي",79,"د",2,0],["ومأثرات لم يطق عدادها","ومن ترى يحصي الدراري عددا",80,"د",2,0],["وَما ثُمَّ ريب في حَياتي وَمَوته","فَأَعجَب بِمَيت كَيفَ لا يَدفنونَه",81,"ن",2,0],["وَما ثمدٌ بادي الحَصاةِ بِمُشبِهٍ","لِبَحرٍ زَخورٍ بِالمَعارفِ مُتأَقِ",82,"ق",1,0],["وما ثقتي أن قمت إن زارعقوتي","وقمت بثقل الخطب وهو بليد",83,"د",1,0],["وما ثوبُ عرض الحرّ لّطخ الخنا","به غير مطليّ به يتحتّمُ",84,"م",1,0],["وَما ثمَّ بُرهانٌ فكُلُّ كُراتِكم","من العاج إِن تُغفَل وان تتخضَّبِ",85,"ب",1,0],["وَمآثِرٌ غَرّآءُ نذكر بعضها","وَبِهِ الغنى عن كلِّها متعددا",86,"د",2,0],["ومآثر لم يجرها من قبله","ملك ولا ما طال عنه يذكر",87,"ر",1,0],["وَمآثر لَو كانَ يمكن عدّها","لِعددتها لكنّها لَم تعددِ",88,"د",1,0],["وما ثَنائي الاَّ لمحتجبٍ","يرفع بَيني وبينَه الحُجبَا",89,"ب",2,0],["وَما ثَبَتوا إِلّا قَليلاً وَزَلزلوا","وَأَبطالَكُم ما بَينَ ضار وَضارب",90,"ب",1,0],["وَما ثنانيَ عَن سُمرِ الطوال وَلا","سود القصار كمال العارف الدَرِب",91,"ب",1,0],["وما ثروة الموئل المُفتَدَى","سوى ثروة الوائل المُفتدِي",92,"د",2,0],["وما ثم غير باعتبار ظهورها","فدعها بنا تبقى ودعنا بها نفنى",93,"ن",2,0],["وما ثاكل فقدت إلفها","فلم يدع الشجو فيها قرارا",94,"ر",2,0],["وما ثنته عن التحصيل متربة","ولا اعتراه فتور حال إقلال",95,"ل",1,0],["وما ثنته عن الترحال متربة","في خدمة الشرع أو أقصاه إحجام",96,"م",1,0],["وما ثم إلا زفير كماه","ونقعٌ يخضب وجه المياه",97,"ه",1,0],["ومآثر ومفاخرٌ مقصورة","يا ابن الكرام عليك بالتعيين",98,"ن",1,0],["وما ثم من يجدي ويقري ويقتني","ثنائي سوى المحيي الكريم الموفّقِ",99,"ق",1,0],["وما ثوب المهانة من ثيابي","ولكنْ ساقَ قلبي الأحوَرَانُ",100,"ن",1,0],["وما ثم إلا الشوق تصلى لهيبه","وقد أجّجته في العروق المشاعر",101,"ر",1,0],["وَمَا ثَمَّ مَا تَرْتَجِي غَيْرَ صَبْرٍ","فَقَدْ أَصْبَحَ الصَّبْرُ فِيهَا شِعَارَا",102,"ر",2,0],["وما ثمَّ إمكانات إنشاء واقع","جديد بلا شيء بمحض التطوع",103,"ع",1,0],["وما ثم مأوى ترتجيه لدى السرى","ولا من محطات ارتياح على الحصر",104,"ر",1,0],["وما ثناك أخوك الغيث عنه وقد","سدت سباسبه الإرجاء والحبك",105,"ك",1,0],["وما ثم إلاه لذا العرش خلة","وليس لتلك السوق إلاه من ولي",106,"ل",2,0],["وما ثمرُ الأصالة بالتمني","ولكنّ الثمار حصادُ هامه",107,"م",2,0],["وَما ثَقُلَت عَلى الأَرضينَ خَطوا","كَأَنما يَحوي التُّرابُ قُبورا",108,"ر",2,0],["وما ثم شيء في البرية قد يرى","ويسمع إلا عن سماعي وريتي",109,"ي",1,0],["وماثناني ، عن أوصافه وتفنيده","إلا خوفي تصيبه ، عين حسادي",110,"د",2,0],["وما ثَم إلاَّ الحقُّ ما ثَم غيره","ولكنهم قالوا محقٌّ ومُبطِلُ",111,"ل",1,0],["وما ثنى عطفَه بلْ قال محتسباً","يا رب يا ربُّ رُحْمى إنهم بشَرُ",112,"ر",1,0]]}