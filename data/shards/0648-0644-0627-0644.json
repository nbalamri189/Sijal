ldiwan.net/poem54601.html","عموديه"],[393,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[409,"من مبلغ المعتر والقانع","https://www.aldiwan.net/poem31879.html","السريع"],[416,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[416,"تبارك من براك ابن المبارك","https://www.aldiwan.net/poem54012.html","الوافر"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[429,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[432,"سارت مطيهم بهم تمطو","https://www.aldiwan.net/poem12799.html","أحذ الكامل"],[439,"هو البدر في فلك المجد دارا","https://www.aldiwan.net/poem34793.html","المتقارب"],[458,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[458,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[458,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[461,"إذا ما سنى ملقاكم فات ناظري","https://www.aldiwan.net/poem16160.html","الطويل"],[477,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[479,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[482,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[482,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[513,"رعى الله دهرا فات لم أقض حقه","https://www.aldiwan.net/poem67786.html","الطويل"],[515,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[515,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[529,"يا علم لم أطلبك للنكر","https://www.aldiwan.net/poem37405.html","السريع"],[529,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[538,"وجمرة الوجنة ذاب","https://www.aldiwan.net/poem47912.html","عموديه"],[540,"سرى ثوبه عنك الصبا المتخايل","https://www.aldiwan.net/poem56720.html","الطويل"],[551,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[551,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[551,"أمن شعر في الرأس بدل لونه","https://www.aldiwan.net/poem47834.html","الطويل"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[551,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[558,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[558,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[558,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[561,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَلا لَذَّةٌ إِلّا الحَديثُ كَأَنَّهُ","لَآلٍ عَلى جَيداءَ واهٍ جُمانُها",0,"ن",3,0],["وَلا لَجَّ الصَهيلَ مُسَوَّماتٌ","مَجَجنَ دَماً عَلى عَلِكِ الشَكيمِ",1,"م",1,0],["وَلا لَكُم في ثَنايا الجودِ مُطَّلَعٌ","وَلا لَكُم في ظُهورِ المَجدِ مُرتَدَفُ",2,"ف",1,0],["وَلا لِلغَوادي مُذ فُقِدتَ مُزايدٌ","وَلا لِلمَعالي مُذ عُدِمتَ قَريعُ",3,"ع",1,0],["وَلَأَلمَعَنَّ بِكُلِّ بَيتٍ شارِدِ","لَمعَ المُهَنَّدِ في يَمينِ المُصلِتِ",4,"ت",1,0],["وَلا لَقيتُ يَداً لِلدَهرِ جارِحَةً","إِذا بَقيتَ وَلا أَلقى لَها السَبَبا",5,"ب",2,0],["وَلا لَوْمَ لِي فِي العَجْزِ عَنْ نَيْل فَائِتٍ","فَإِنَّ الذِي أعْيَ البَرِيَّةَ أَعْيَانِي",6,"ي",1,0],["وَلاَ لِليْلِيَ مِنْ صُبْحٍ أُطَالِعُهُ","كَأَنَّ هَمِّيَ قَدْ مَدَّ الدُّجُنَّةَ لِي",7,"ي",1,0],["وَلَأَلبسَنَّ مِنَ التَجَلُّدِ نَثرَةً","حَصداءَ تَهزَأُ مِن سَوابِغَ تُبَّعِ",8,"ع",1,0],["وَلا لِحَاظِ لَدَاتِي","وَقَدْ وَدَدْنَ مَكَانِي",9,"ي",1,0],["وَلا لِلضَيفِ إِن طَرَقَت بِلَيلٌ","بِأَفنانِ العِضاهِ وَبِالهَشيمِ",10,"م",1,0],["ولا لقاحهم إلا معودة","ذل الكلاب وإن لا تسمن الفُصُلُ",11,"ل",1,1],["وَلا لَكُم مِثلُهُم في المَجدِ مُتَّصِلٌ","وَلا لِجَدِّكُمُ مَسعاةُ جَدِّهِمُ",12,"م",1,0],["وَلا لِعِرقِكُمُ مِن عِرقِهِم شَبَهٌ","وَلا نَفيلَتُكُم مِن أُمِّهِم أَمَمُ",12,"م",1,0],["ولآلٍ نظمتها","بركات ضمن سبحه",13,"ح",2,0],["ولا لعصا الجوزاء في الشهبِ آية","مجرّ النّجى من تحتها يتفجر",14,"ر",1,0],["ولا لفكريَ من شمسٍ ومن قمر","سوى جبيني في صبحي وإظلامي",15,"م",2,0],["ولا لجاَجٍ ولا ضِجاجٍ","ولا حِرانٍ ولا جماحِ",16,"ح",1,0],["ولا ليروضَ نفْساً ذاتَ شُحٍّ","ولا ليفكَّ عزماً ذا صفادِ",17,"د",1,0],["ولا لَهُ دون عليٍّ عاكسه","أشهمُ من نجم السماء الخامسه",18,"س",2,0],["ولا لذنب جئتُهُ موجبٍ","ردِّي إذا جئت ولم أُدْعه",19,"ع",2,0],["ولا لأن أخلفني وعده","لكن لإيماني وتصديقي",20,"ق",2,0],["ولا لراعي مَعالٍ","سواه راعي ذِمامِ",21,"م",1,0],["ولا لِقوة شعواء تُلحم فرخها","خداريَّةٌ شمَّاء في شاهق أشَمْ",22,"م",1,0],["ولا لَؤُمَتْ نفسي ولا ساء عهدُها","ولكنها جُنَّ الزمانُ فجُنَّتِ",23,"ت",1,0],["وَلا لَكَ صَوتٌ مِثلَهُ يَصدَعُ الدُجى","وَتَهتِفُ فيهِ الذِكرَياتُ إِذا هَتَف",24,"ف",1,0],["ولا لفها الورقاء في","فنن البشام تساجل",25,"ل",1,0],["ولا له من بورى","يُسمع سالسبورى",26,"ر",2,0],["ولا له من أمة","تنجده في الغمة",26,"ه",1,0],["ولا له من دولة","تمدّه بالصولة",26,"ه",1,0],["ولا له ولا له","لله ما أجله",26,"ه",1,0],["وَلا لُغَةٌ غَيرَ صَوتٍ شَجِيٍّ","كَرَوضٍ بَلابِلُهُ تَصفِرُ",27,"ر",1,0],["وَلَألَأَتِ الجِبالُ فَضاءَ سَفحٍ","يَسُرُّ الناظِرينَ وَنارَ رَأسُ",28,"س",1,0],["وَلا لَيلٌ أَجَنَّ وَلا نَهارٌ","وَلا خَيلٌ حَمَلنَ وَلا رِكابُ",29,"ب",1,0],["وَلا لَيلَةً قَصَّرتُها بِقَصورَةٍ","أَطالَت يَدي في جيدِها صُحبَةَ العِقدِ",30,"د",1,0],["وَلا لِحُبّيها وَلَكِنَّني","أَمسَيتُ أَرجوكَ وَأَخشاكا",31,"ك",2,0],["وَلِّ السَلاطينَ مَن تَوَلّاها","وَاِلجَأ إِلَيهِ تَكُن حُدَيّاها",32,"ا",3,0],["ولا ليَ إِلّا في ولائِكَ مَسرْحٌ","ولا ليَ إِلّا في هواك مَسَامُ",33,"م",1,0],["ولا لُبانةُ عيشٍ","عند الفتاةِ الكَعَابِ",34,"ب",1,0],["وَلا لِمِثلي في القَولِ مِنكَ رِضاً","وَالقَولُ في المَجدِ غَيرُ مَحسوبِ",35,"ب",1,0],["وَلا لِيَ تَميِيزٌ وَلَستُ بِمُهتَدٍ","سَبيلاً يُؤَدّي في التَصافي إِلى القَصدِ",36,"د",1,0],["وَلا لِاِبنِ سَيّارٍ مِنَ الأَمرِ بَعدَها","خِيارٌ إِذا اِختارَ القَسيمُ وَلا نِصفُ",37,"ف",1,0],["وَلا لِاِمرِئٍ آتى المُضِلّينَ بَيعَةً","رَأى الحَربَ أَبدَت عَن نَواجِذِها العُصلِ",38,"ل",1,0],["ولا لطائرِ قلبٍ أن يقَرَّ ولا","لموكبٍ فَزِعٍ في الشطِّ إرساءُ",39,"ا",2,0],["ولا لطائر قلب أن يقر ولا","لمركب فزع في الشط إرساءُ",40,"ا",2,0],["ولا لوعدكِ إنجازٌ أفوزُ بهِ","وكيف يُرْوي غليلاً آلُ بيداءِ",41,"ا",2,0],["وَلَأُلبِسَنَّكَ كُلَّ بَيتٍ مُعلَمٍ","يُسدى وَيُلحَمُ بِالثَناءِ المُعجَبِ",42,"ب",1,0],["وَلا لَيلَ إِلّا بِالثَوِيَّةِ أَقمَرٌ","تَنَفَّسَ في السُكرُ عَن نَفحَةِ الشُكرِ",43,"ر",1,0],["وَلا لي رَثَت لَمّا شَكَوتُ صَبابَتي","وَلا أَطفَأَت ناراً يُشَبُّ زَفيرُها",44,"ر",3,0],["ولا لك مصرفٌ عما يُريدُ","أليس لِحمزةَ البأسُ الشديدُ",45,"د",1,0],["وَلا لَغوَ وَلا تَأثيمَ فيها","وَلا غَولٌ وَلا فيها مُليمُ",46,"م",1,0],["وَلا لِنَيْلِ مُرادٍ","ولا لِبَذلِ المَكارِمْ",47,"م",1,0],["ولا لاتّقادٍ مِن سَناهَا عَقَدْتَها","ولكن لأمْرٍ ما وغْيبٍ مُكتَّم",48,"م",1,0],["وَلا لِأَيِّ الطُلولِ أَندُبُها","لِلريحِ وَالرُقشِ مِن قَرانِبِها",49,"ب",3,0],["ولا لابساً تقديمَ شمسٍ وكوكب","ليعرفَ إحياءَ العلوّ من أسفل",50,"ل",1,0],["وَلا لَونَ لِلماءِ فيما يُقالُ","وَلَكِن تَلَوُّنُهُ بِالأَواني",51,"ن",2,0],["وَلا لاِمْرِئٍ أَلْهَمْتَهُ الرُّشْدَ خَاذلٌ","وَلا لاِمْرِئٍ أَوْرَدْتَهُ الْغَيَّ نَاصِرُ",52,"ر",1,0],["وَلآلِ لُطِفِ اللهِ مِنهُ كَرَامَةٌ","سَتَظَلُّ فِي الأَحْفادِ وَالأَبْنَاءِ",53,"ا",2,0],["ولا : لا تقل : أين منّي غد ؟","فلا لم تسمّر يداك الفلك",54,"ك",1,0],["ولا ، لا تقل معك الحبّ بل","جريمته والخطايا معي",55,"ع",2,0],["ولألحانه، شفاه صبايا","وعيون، تخضر فيها الإثارة",56,"ر",2,0],["ولا لُترى مواطِنُها خراباً","ولا ليبيتَ أهلوها جِياعاً",57,"ع",2,0],["ولا لتكونَ للغربيِّ عوناً","يهدَّدُ فيه للشرقِ اجتماعا",57,"ع",2,0],["وَلا لامرِىءٍ آتَى المُضِلّينَ بَيْعَةً،","رَأى الحرْبَ أبدتْ عن نوَاجذها العُصْلِ",58,"ل",1,0],["ولا لساناً سيفُه حُسامُ","عادته التكْذابُ والتأثامُ",59,"م",1,0],["ولا لضيفٍ عندهم ذمامُ","بَشَّ به منك فتى بسامُ",59,"م",1,0],["ولا لنعماءِ مُجِلٍ جاحدا","ولا تدع حراً حميَّاً حاقدا",60,"د",2,0],["ولا لذيذاً يشبه البواردا","لكن مسيخاً يشبه الجوامدا",60,"د",2,0],["ولا لثم الحصباء فيها متيّم","يشمّ الهوى من عطرها فيهيم",61,"م",1,0],["وَلاَ لاِمْرِىء ٍ أَلْهَمْتَهُ الرُّشْدَ خَاذِلٌ","وَلاَ لامْرِى ٍء أَورَدْتَهُ الْغَيَّ نَاصِرُ",62,"ر",1,0],["ولا لزبد وبكر طأطوا كتفا","لدرهم ولهم آه وأنات",63,"ت",1,0],["ولا لدار ولا حي نشأت به","ولا لعمر ولا زيد من الأمم",64,"م",1,0],["ولا لرهط ولا حزب ولا فرق","ولا لطفل ولا ألوى لذي رحم",64,"م",1,0],["ولاَ لاَقَوا مِنَ الرَّحمنِ رحمَى","ولاَ وَجَدُوا السَّلاَمَ مِنَ السَّلاَمِ",65,"م",1,0],["ولا لَبونى بالأسى حافلا","ولا عِشارى بالمنى مُخَّضا",66,"ض",2,0],["وَلا لَهُ في يَمينٍ بَرَّةٍ صَدَقَت","قَولٌ وَلا بِيَمينٍ بَرَّةٍ عَمَلُ",67,"ل",1,0],["وَلا لَومَ في كَسبِ الثَناءِ لِمَن صَبا","إِلَيهِ وَلَكِنَّ المَلامَ لِمَن سَلا",68,"ل",2,0],["ولا لي مثل غيري حين أخفا","فؤاد ينتهي عمن يود",69,"د",1,0],["ولا لي قوة تنهي اشتياقي","ولا قلبي على الأهواء جلد",69,"د",1,0],["ولا لاطفوا الاكفا ولكن تعاظموا","تعاظم أهل الملك واحتقروا الكلا",70,"ل",2,0],["وَلا لُمتُ نَفسي في اِجتِهادِ نَصيحَةٍ","لَكُم في قَديمٍ قَبلَ هذا وَحادِثِ",71,"ث",1,0],["وَلا لَومَ في شاني عَلَيهِم لِأَنَّني","لَأَلوي بِهِ أَو أَجعَل الآلَ مَنهَلا",72,"ل",2,0],["ولا لاهِياً يَوماً إِلَى اللّيلِ كُلِّهِ","بِبِيضٍ لَطِيفَاتِ الخُصُورِ غَوانِى",73,"ن",2,0],["ولاَ لاَهِياً يَوماً إِلَى اللَّيلِ كُلِّهِ","بِبيضٍ لَطيفاتِ الخُصُورِ رَوانى",74,"ن",2,0],["ولآلىء الوجدان ظلم","أن تصاغ لغير ناقد",75,"د",1,0],["ولا لغليلِ البرْحِ بعدكَ ناضحٌ","ولو نشأَتْ بين الضلوعِ سحائب",76,"ب",1,0],["ولا لمحتُ من الآمالِ بارقةً","إلا تقحّمتُ ما تجتاز من قُنَن",77,"ن",1,0],["ولا لمحت من الآمالِ بارقةً","إلا تقحّمتُ ما تجتاز من فنَنِ",78,"ن",1,0],["ولا لوى لي عنقاً في الفلا","عيسٌ إذا جدّ السرى العنق",79,"ق",1,0],["ولا لهاني برق في أبارقه","كأنه صارم في متنه زبد",80,"د",1,0],["وَلا لي لِلعَزمِ مِن نَهضَةٍ","يَكونُ سَميري بِها الفَرقَدُ",81,"د",1,0],["ولا لي غلامٌ فأدعوا به","سوى من أبوه أخو عمت