أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[541,"وجمرة الوجنة ذاب","https://www.aldiwan.net/poem47912.html","عموديه"],[543,"سرى ثوبه عنك الصبا المتخايل","https://www.aldiwan.net/poem56720.html","الطويل"],[554,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[554,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[554,"أمن شعر في الرأس بدل لونه","https://www.aldiwan.net/poem47834.html","الطويل"],[554,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[554,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[561,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[561,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[561,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[564,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[902,"","https://poetry.dctabudhabi.ae/diwan/poem/79630","الرجز"],[1104,"","https://poetry.dctabudhabi.ae/diwan/poem/20891","البسيط"],[1176,"","https://poetry.dctabudhabi.ae/diwan/poem/98073","الطويل"]],"verses":[["وَلا لَذَّةٌ إِلّا الحَديثُ كَأَنَّهُ","لَآلٍ عَلى جَيداءَ واهٍ جُمانُها",0,"ن",3,0],["وَلا لَجَّ الصَهيلَ مُسَوَّماتٌ","مَجَجنَ دَماً عَلى عَلِكِ الشَكيمِ",1,"م",1,0],["وَلا لَكُم في ثَنايا الجودِ مُطَّلَعٌ","وَلا لَكُم في ظُهورِ المَجدِ مُرتَدَفُ",2,"ف",1,0],["وَلا لِلغَوادي مُذ فُقِدتَ مُزايدٌ","وَلا لِلمَعالي مُذ عُدِمتَ قَريعُ",3,"ع",1,0],["وَلَأَلمَعَنَّ بِكُلِّ بَيتٍ شارِدِ","لَمعَ المُهَنَّدِ في يَمينِ المُصلِتِ",4,"ت",1,0],["وَلا لَقيتُ يَداً لِلدَهرِ جارِحَةً","إِذا بَقيتَ وَلا أَلقى لَها السَبَبا",5,"ب",2,0],["وَلا لَوْمَ لِي فِي العَجْزِ عَنْ نَيْل فَائِتٍ","فَإِنَّ الذِي أعْيَ البَرِيَّةَ أَعْيَانِي",6,"ن",2,0],["وَلاَ لِليْلِيَ مِنْ صُبْحٍ أُطَالِعُهُ","كَأَنَّ هَمِّيَ قَدْ مَدَّ الدُّجُنَّةَ لِي",7,"ل",2,0],["وَلَأَلبسَنَّ مِنَ التَجَلُّدِ نَثرَةً","حَصداءَ تَهزَأُ مِن سَوابِغَ تُبَّعِ",8,"ع",1,0],["وَلا لِحَاظِ لَدَاتِي","وَقَدْ وَدَدْنَ مَكَانِي",9,"ن",2,0],["وَلا لِلضَيفِ إِن طَرَقَت بِلَيلٌ","بِأَفنانِ العِضاهِ وَبِالهَشيمِ",10,"م",1,0],["ولا لقاحهم إلا معودة","ذل الكلاب وإن لا تسمن الفُصُلُ",11,"ل",1,1],["وَلا لَكُم مِثلُهُم في المَجدِ مُتَّصِلٌ","وَلا لِجَدِّكُمُ مَسعاةُ جَدِّهِمُ",12,"م",1,0],["وَلا لِعِرقِكُمُ مِن عِرقِهِم شَبَهٌ","وَلا نَفيلَتُكُم مِن أُمِّهِم أَمَمُ",12,"م",1,0],["ولآلٍ نظمتها","بركات ضمن سبحه",13,"ح",2,0],["ولا لعصا الجوزاء في الشهبِ آية","مجرّ النّجى من تحتها يتفجر",14,"ر",1,0],["ولا لفكريَ من شمسٍ ومن قمر","سوى جبيني في صبحي وإظلامي",15,"م",2,0],["ولا لجاَجٍ ولا ضِجاجٍ","ولا حِرانٍ ولا جماحِ",16,"ح",1,0],["ولا ليروضَ نفْساً ذاتَ شُحٍّ","ولا ليفكَّ عزماً ذا صفادِ",17,"د",1,0],["ولا لَهُ دون عليٍّ عاكسه","أشهمُ من نجم السماء الخامسه",18,"س",2,0],["ولا لذنب جئتُهُ موجبٍ","ردِّي إذا جئت ولم أُدْعه",19,"ع",2,0],["ولا لأن أخلفني وعده","لكن لإيماني وتصديقي",20,"ق",2,0],["ولا لراعي مَعالٍ","سواه راعي ذِمامِ",21,"م",1,0],["ولا لِقوة شعواء تُلحم فرخها","خداريَّةٌ شمَّاء في شاهق أشَمْ",22,"م",1,0],["ولا لَؤُمَتْ نفسي ولا ساء عهدُها","ولكنها جُنَّ الزمانُ فجُنَّتِ",23,"ت",1,0],["وَلا لَكَ صَوتٌ مِثلَهُ يَصدَعُ الدُجى","وَتَهتِفُ فيهِ الذِكرَياتُ إِذا هَتَف",24,"ف",1,0],["ولا لفها الورقاء في","فنن البشام تساجل",25,"ل",1,0],["ولا له من بورى","يُسمع سالسبورى",26,"ر",2,0],["ولا له من أمة","تنجده في الغمة",26,"ه",1,0],["ولا له من دولة","تمدّه بالصولة",26,"ه",1,0],["ولا له ولا له","لله ما أجله",26,"ه",1,0],["وَلا لُغَةٌ غَيرَ صَوتٍ شَجِيٍّ","كَرَوضٍ بَلابِلُهُ تَصفِرُ",27,"ر",1,0],["وَلَألَأَتِ الجِبالُ فَضاءَ سَفحٍ","يَسُرُّ الناظِرينَ وَنارَ رَأسُ",28,"س",1,0],["وَلا لَيلٌ أَجَنَّ وَلا نَهارٌ","وَلا خَيلٌ حَمَلنَ وَلا رِكابُ",29,"ب",1,0],["وَلا لَيلَةً قَصَّرتُها بِقَصورَةٍ","أَطالَت يَدي في جيدِها صُحبَةَ العِقدِ",30,"د",1,0],["وَلا لِحُبّيها وَلَكِنَّني","أَمسَيتُ أَرجوكَ وَأَخشاكا",31,"ك",2,0],["وَلِّ السَلاطينَ مَن تَوَلّاها","وَاِلجَأ إِلَيهِ تَكُن حُدَيّاها",32,"ا",3,0],["ولا ليَ إِلّا في ولائِكَ مَسرْحٌ","ولا ليَ إِلّا في هواك مَسَامُ",33,"م",1,0],["ولا لُبانةُ عيشٍ","عند الفتاةِ الكَعَابِ",34,"ب",1,0],["وَلا لِمِثلي في القَولِ مِنكَ رِضاً","وَالقَولُ في المَجدِ غَيرُ مَحسوبِ",35,"ب",1,0],["وَلا لِيَ تَميِيزٌ وَلَستُ بِمُهتَدٍ","سَبيلاً يُؤَدّي في التَصافي إِلى القَصدِ",36,"د",1,0],["وَلا لِاِبنِ سَيّارٍ مِنَ الأَمرِ بَعدَها","خِيارٌ إِذا اِختارَ القَسيمُ وَلا نِصفُ",37,"ف",1,0],["وَلا لِاِمرِئٍ آتى المُضِلّينَ بَيعَةً","رَأى الحَربَ أَبدَت عَن نَواجِذِها العُصلِ",38,"ل",1,0],["ولا لطائرِ قلبٍ أن يقَرَّ ولا","لموكبٍ فَزِعٍ في الشطِّ إرساءُ",39,"ا",2,0],["ولا لطائر قلب أن يقر ولا","لمركب فزع في الشط إرساءُ",40,"ا",2,0],["ولا لوعدكِ إنجازٌ أفوزُ بهِ","وكيف يُرْوي غليلاً آلُ بيداءِ",41,"ا",2,0],["وَلَأُلبِسَنَّكَ كُلَّ بَيتٍ مُعلَمٍ","يُسدى وَيُلحَمُ بِالثَناءِ المُعجَبِ",42,"ب",1,0],["وَلا لَيلَ إِلّا بِالثَوِيَّةِ أَقمَرٌ","تَنَفَّسَ في السُكرُ عَن نَفحَةِ الشُكرِ",43,"ر",1,0],["وَلا لي رَثَت لَمّا شَكَوتُ صَبابَتي","وَلا أَطفَأَت ناراً يُشَبُّ زَفيرُها",44,"ر",3,0],["ولا لك مصرفٌ عما يُريدُ","أليس لِحمزةَ البأسُ الشديدُ",45,"د",1,0],["وَلا لَغوَ وَلا تَأثيمَ فيها","وَلا غَولٌ وَلا فيها مُليمُ",46,"م",1,0],["وَلا لِنَيْلِ مُرادٍ","ولا لِبَذلِ المَكارِمْ",47,"م",1,0],["ولا لاتّقادٍ مِن سَناهَا عَقَدْتَها","ولكن لأمْرٍ ما وغْيبٍ مُكتَّم",48,"م",1,0],["وَلا لِأَيِّ الطُلولِ أَندُبُها","لِلريحِ وَالرُقشِ مِن قَرانِبِها",49,"ب",3,0],["ولا لابساً تقديمَ شمسٍ وكوكب","ليعرفَ إحياءَ العلوّ من أسفل",50,"ل",1,0],["وَلا لَونَ لِلماءِ فيما يُقالُ","وَلَكِن تَلَوُّنُهُ بِالأَواني",51,"ن",2,0],["وَلا لاِمْرِئٍ أَلْهَمْتَهُ الرُّشْدَ خَاذلٌ","وَلا لاِمْرِئٍ أَوْرَدْتَهُ الْغَيَّ نَاصِرُ",52,"ر",1,0],["وَلآلِ لُطِفِ اللهِ مِنهُ كَرَامَةٌ","سَتَظَلُّ فِي الأَحْفادِ وَالأَبْنَاءِ",53,"ا",2,0],["ولا لاحرار الكلام عندهم","تكرمة ولا لحر مستوى",54,"ا",1,0],["ولا : لا تقل : أين منّي غد ؟","فلا لم تسمّر يداك الفلك",55,"ك",1,0],["ولا ، لا تقل معك الحبّ بل","جريمته والخطايا معي",56,"ع",2,0],["ولألحانه، شفاه صبايا","وعيون، تخضر فيها الإثارة",57,"ر",2,0],["ولا لُترى مواطِنُها خراباً","ولا ليبيتَ أهلوها جِياعاً",58,"ع",2,0],["ولا لتكونَ للغربيِّ عوناً","يهدَّدُ فيه للشرقِ اجتماعا",58,"ع",2,0],["وَلا لامرِىءٍ آتَى المُضِلّينَ بَيْعَةً،","رَأى الحرْبَ أبدتْ عن نوَاجذها العُصْلِ",59,"ل",1,0],["ولا لساناً سيفُه حُسامُ","عادته التكْذابُ والتأثامُ",60,"م",1,0],["ولا لضيفٍ عندهم ذمامُ","بَشَّ به منك فتى بسامُ",60,"م",1,0],["ولا لنعماءِ مُجِلٍ جاحدا","ولا تدع حراً حميَّاً حاقدا",61,"د",2,0],["ولا لذيذاً يشبه البواردا","لكن مسيخاً يشبه الجوامدا",61,"د",2,0],["ولا لثم الحصباء فيها متيّم","يشمّ الهوى من عطرها فيهيم",62,"م",1,0],["وَلاَ لاِمْرِىء ٍ أَلْهَمْتَهُ الرُّشْدَ خَاذِلٌ","وَلاَ لامْرِى ٍء أَورَدْتَهُ الْغَيَّ نَاصِرُ",63,"ر",1,0],["ولا لزبد وبكر طأطوا كتفا","لدرهم ولهم آه وأنات",64,"ت",1,0],["ولا لدار ولا حي نشأت به","ولا لعمر ولا زيد من الأمم",65,"م",1,0],["ولا لرهط ولا حزب ولا فرق","ولا لطفل ولا ألوى لذي رحم",65,"م",1,0],["ولاَ لاَقَوا مِنَ الرَّحمنِ رحمَى","ولاَ وَجَدُوا السَّلاَمَ مِنَ السَّلاَمِ",66,"م",1,0],["ولا لَبونى بالأسى حافلا","ولا عِشارى بالمنى مُخَّضا",67,"ض",2,0],["وَلا لَهُ في يَمينٍ بَرَّةٍ صَدَقَت","قَولٌ وَلا بِيَمينٍ بَرَّةٍ عَمَلُ",68,"ل",1,0],["وَلا لَومَ في كَسبِ الثَناءِ لِمَن صَبا","إِلَيهِ وَلَكِنَّ المَلامَ لِمَن سَلا",69,"ل",2,0],["ولا لي مثل غيري حين أخفا","فؤاد ينتهي عمن يود",70,"د",1,0],["ولا لي قوة تنهي اشتياقي","ولا قلبي على الأهواء جلد",70,"د",1,0],["ولا لاطفوا الاكفا ولكن تعاظموا","تعاظم أهل الملك واحتقروا الكلا",71,"ل",2,0],["وَلا لُمتُ نَفسي في اِجتِهادِ نَصيحَةٍ","لَكُم في قَديمٍ قَبلَ هذا وَحادِثِ",72,"ث",1,0],["وَلا لَومَ في شاني عَلَيهِم لِأَنَّني","لَأَلوي بِهِ أَو أَجعَل الآلَ مَنهَلا",73,"ل",2,0],["ولا لاهِياً يَوماً إِلَى اللّيلِ كُلِّهِ","بِبِيضٍ لَطِيفَاتِ الخُصُورِ غَوانِى",74,"ن",2,0],["ولاَ لاَهِياً يَوماً إِلَى اللَّيلِ كُلِّهِ","بِبيضٍ لَطيفاتِ الخُصُورِ رَوانى",75,"ن",2,0],["ولآلىء الوجدان ظلم","أن تصاغ لغير ناقد",76,"د",1,0],["ولا لغليلِ البرْحِ بعدكَ ناضحٌ","ولو نشأَتْ بين الضلوعِ سحائب",77,"ب",1,0],["ولا لمحتُ من الآمالِ بارقةً","إلا تق