ٌ ولا قدرٌ يرى",130,"ر",2,0],["ولا لأجل امتثال الأمر أوغرض","له تعالى ولا منع وإعطاء",131,"ا",2,0],["وَلا لِبَيتِ جارَتي خَتّالا","بَعدَ المَنامِ أَبتَغي الأَدغالا",132,"ل",2,0],["ولا له من خلقه وزير","ولا شريك لا ولا ظهير",133,"ر",1,0],["ولا لنا حاَم ولا بحِيره","وشيَّبَ العارِضَ والغديره",134,"ر",2,0],["ولا لساني على الأدنى بمنطلقٍ","بالمنكرات ولا فتكي بمأمون",135,"ن",1,0],["وَلا لا بَلَغتم حيث وجّهتم له","وَنغّصتم لذّات كلّ طعامِ",136,"م",1,0]]}