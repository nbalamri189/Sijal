{"poems":[[53,"سقاها وإن لم يرو قلبي بيانها","https://www.aldiwan.net/poem29650.html","الطويل"],[53,"لعمر الطير يوم ثوى ابن ليلى","https://www.aldiwan.net/poem29808.html","الوافر"],[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[53,"أظن الليالي بعدكم ستريع","https://www.aldiwan.net/poem30150.html","الطويل"],[53,"قد قلت للنفس الشعاع أضمها","https://www.aldiwan.net/poem30669.html","الكامل"],[53,"لأشكرنك ما ناحت مطوقة","https://www.aldiwan.net/poem30750.html","البسيط"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[77,"برئت لله من حولي ومن حيلي","https://www.aldiwan.net/poem36340.html","البسيط"],[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[93,"ما أنس من طيب عيشي","https://www.aldiwan.net/poem11193.html","المجتث"],[4,"رأتني قد شحبت وسل جسمي","https://www.aldiwan.net/poem21198.html","الوافر"],[37,"ولا لقاحهم إلا معودة","https://www.aldiwan.net/poem7328.html","البسيط"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[72,"مرحبا بالنظم يأتي","https://www.aldiwan.net/poem18489.html","مجزوء الرمل"],[72,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"غصن من البان في وشاح","https://www.aldiwan.net/poem9396.html","مخلع البسيط"],[51,"أقول لسائلي بك يا ابن يحيى","https://www.aldiwan.net/poem61900.html","الوافر"],[51,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"سائل أبا الصقر إذا جئته","https://www.aldiwan.net/poem65723.html","السريع"],[51,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[51,"عزمت على تطليق عرسي لعسرتي","https://www.aldiwan.net/poem66518.html","الطويل"],[91,"ألا أيها الإبريق ما لك والصلف","https://www.aldiwan.net/poem8983.html","عموديه"],[89,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[85,"تحية شاعر يا ماء جكسو","https://www.aldiwan.net/poem63712.html","الوافر"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[43,"نسيت وما أنسى عتابا على الصد","https://www.aldiwan.net/poem9558.html","الطويل"],[43,"لم تر من نادمت إلاكا","https://www.aldiwan.net/poem9752.html","السريع"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[62,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[62,"أفنى الليالي شبابي","https://www.aldiwan.net/poem52489.html","المجتث"],[45,"كم من حنين إليك مجلوب","https://www.aldiwan.net/poem11046.html","المنسرح"],[45,"تعست فما لي من وفاء ولا عهد","https://www.aldiwan.net/poem63524.html","الطويل"],[45,"خطته فلم تحفل به الأعين الوطف","https://www.aldiwan.net/poem65143.html","الطويل"],[28,"قضيت قضاء في الخلافة ثابتا","https://www.aldiwan.net/poem5465.html","الطويل"],[97,"لا القوم راحوا بأخبارٍ ولا جاؤوا","https://www.aldiwan.net/poem24349.html","البسيط"],[97,"لا القوم راحوا بأخبار ولا جاءوا","https://www.aldiwan.net/poem24993.html","البسيط"],[80,"إلى متى منكم هجري وإقصائي","https://www.aldiwan.net/poem31577.html","البسيط"],[44,"أما وقد ألحقتني بالموكب","https://www.aldiwan.net/poem30575.html","الكامل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[33,"فما رحمت يوم التفرق مهجتي","https://www.aldiwan.net/poem25919.html","الطويل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[67,"ما في الزمان جواد","https://www.aldiwan.net/poem18105.html","المجتث"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"لست بدار عفت وغيرها","https://www.aldiwan.net/poem62428.html","البسيط"],[48,"خليلي أقعد للصبوح ولا تقل","https://www.aldiwan.net/poem66601.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42643","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54511","الكامل"],[100,"أثيم الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50095",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[90,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[28,"سلوت عن الدهر الذي كان معجبا","https://www.poetsgate.com/ViewPoem.aspx?id=22069",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[87,"لكَ الحَمدُ ، إنَّ الخيرَ مِنكَ ، وإنَّنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23976&r=&rc=238",""]],"verses":[["وَلا لَذَّةٌ إِلّا الحَديثُ كَأَنَّهُ","لَآلٍ عَلى جَيداءَ واهٍ جُمانُها",0,"ن",3,0],["وَلا لَجَّ الصَهيلَ مُسَوَّماتٌ","مَجَجنَ دَماً عَلى عَلِكِ الشَكيمِ",1,"م",1,0],["وَلا لَكُم في ثَنايا الجودِ مُطَّلَعٌ","وَلا لَكُم في ظُهورِ المَجدِ مُرتَدَفُ",2,"ف",1,0],["وَلا لِلغَوادي مُذ فُقِدتَ مُزايدٌ","وَلا لِلمَعالي مُذ عُدِمتَ قَريعُ",3,"ع",1,0],["وَلَأَلمَعَنَّ بِكُلِّ بَيتٍ شارِدِ","لَمعَ المُهَنَّدِ في يَمينِ المُصلِتِ",4,"ت",1,0],["وَلا لَقيتُ يَداً لِلدَهرِ جارِحَةً","إِذا بَقيتَ وَلا أَلقى لَها السَبَبا",5,"ب",2,0],["وَلا لَوْمَ لِي فِي العَجْزِ عَنْ نَيْل فَائِتٍ","فَإِنَّ الذِي أعْيَ البَرِيَّةَ أَعْيَانِي",6,"ي",1,0],["وَلاَ لِليْلِيَ مِنْ صُبْحٍ أُطَالِعُهُ","كَأَنَّ هَمِّيَ قَدْ مَدَّ الدُّجُنَّةَ لِي",7,"ي",1,0],["وَلَأَلبسَنَّ مِنَ التَجَلُّدِ نَثرَةً","حَصداءَ تَهزَأُ مِن سَوابِغَ تُبَّعِ",8,"ع",1,0],["وَلا لِحَاظِ لَدَاتِي","وَقَدْ وَدَدْنَ مَكَانِي",9,"ي",1,0],["وَلا لِلضَيفِ إِن طَرَقَت بِلَيلٌ","بِأَفنانِ العِضاهِ وَبِالهَشيمِ",10,"م",1,0],["ولا لقاحهم إلا معودة","ذل الكلاب وإن لا تسمن الفُصُلُ",11,"ل",1,1],["وَلا لَكُم مِثلُهُم في المَجدِ مُتَّصِلٌ","وَلا لِجَدِّكُمُ مَسعاةُ جَدِّهِمُ",12,"م",1,0],["وَلا لِعِرقِكُمُ مِن عِرقِهِم شَبَهٌ","وَلا نَفيلَتُكُم مِن أُمِّهِم أَمَمُ",12,"م",1,0],["ولآلٍ نظمتها","بركات ضمن سبحه",13,"ح",2,0],["ولا لعصا الجوزاء في الشهبِ آية","مجرّ النّجى من تحتها يتفجر",14,"ر",1,0],["ولا لفكريَ من شمسٍ ومن قمر","سوى جبيني في صبحي وإظلامي",15,"م",2,0],["ولا لجاَجٍ ولا ضِجاجٍ","ولا حِرانٍ ولا جماحِ",16,"ح",1,0],["ولا ليروضَ نفْساً ذاتَ شُحٍّ","ولا ليفكَّ عزماً ذا صفادِ",17,"د",1,0],["ولا لَهُ دون عليٍّ عاكسه","أشهمُ من نجم السماء الخامسه",18,"س",2,0],["ولا لذنب جئتُهُ موجبٍ","ردِّي إذا جئت ولم أُدْعه",19,"ع",2,0],["ولا لأن أخلفني وعده","لكن لإيماني وتصديقي",20,"ق",2,0],["ولا لراعي مَعالٍ","سواه راعي ذِمامِ",21,"م",1,0],["ولا لِقوة شعواء تُلحم فرخها","خداريَّةٌ شمَّاء في شاهق أشَمْ",22,"م",1,0],["ولا لَؤُمَتْ نفسي ولا ساء عهدُها","ولكنها جُنَّ الزمانُ فجُنَّتِ",23,"ت",1,0],["وَلا لَكَ صَوتٌ مِثلَهُ يَصدَعُ الدُجى","وَتَهتِفُ فيهِ الذِكرَياتُ إِذا هَتَف",24,"ف",1,0],["ولا لفها الورقاء في","فنن البشام تساجل",25,"ل",1,0],["ولا له من بورى","يُسمع سالسبورى",26,"ر",2,0],["ولا له من أمة","تنجده في الغمة",26,"ه",1,0],["ولا له من دولة","تمدّه بالصولة",26,"ه",1,0],["ولا له ولا له","لله ما أجله",26,"ه",1,0],["وَلا لُغَةٌ غَيرَ صَوتٍ شَجِيٍّ","كَرَوضٍ بَلابِلُهُ تَصفِرُ",27,"ر",1,0],["وَلَألَأَتِ الجِبالُ فَضاءَ سَفحٍ","يَسُرُّ الناظِرينَ وَنارَ رَأسُ",28,"س",1,0],["وَلا لَيلٌ أَجَنَّ وَلا نَهارٌ","وَلا خَيلٌ حَمَلنَ وَلا رِكابُ",29,"ب",1,0],["وَلا لَيلَةً قَصَّرتُها بِقَصورَةٍ","أَطالَت يَدي في جيدِها صُحبَةَ العِقدِ",30,"د",1,0],["وَلا لِحُبّيها وَلَكِنَّني","أَمسَيتُ أَرجوكَ وَأَخشاكا",31,"ك",2,0],["وَلِّ السَلاطينَ مَن تَوَلّاها","وَاِلجَأ إِلَيهِ تَكُن حُدَيّاها",32,"ا",3,0],["ولا ليَ إِلّا في ولائِكَ مَسرْحٌ","ولا ليَ إِلّا في هواك مَسَامُ",33,"م",1,0],["ولا لُبانةُ عيشٍ","عند الفتاةِ الكَعَابِ",34,"ب",1,0],["وَلا لِمِثلي في القَولِ مِنكَ رِضاً","وَالقَولُ في المَجدِ غَيرُ مَحسوبِ",35,"ب",1,0],["وَلا لِيَ تَميِيزٌ وَلَستُ بِمُهتَدٍ","سَبيلاً يُؤَدّي في التَصافي إِلى القَصدِ",36,"د",1,0],["وَلا لِاِبنِ سَيّارٍ مِنَ الأَمرِ بَعدَها","خِيارٌ إِذا اِختارَ القَسيمُ وَلا نِصفُ",37,"ف",1,0],["وَلا لِاِمرِئٍ آتى المُضِلّينَ بَيعَةً","رَأى الحَربَ أَبدَت عَن نَواجِذِها العُصلِ",38,"ل",1,0],["ولا لطائرِ قلبٍ أن يقَرَّ ولا","لموكبٍ فَزِعٍ في الشطِّ إرساءُ",39,"ا",2,0],["ولا لطائر قلب أن يقر ولا","لمركب فزع في الشط إرساءُ",40,"ا",2,0],["ولا لوعدكِ إنجازٌ أفوزُ بهِ","وكيف يُرْوي غليلاً آلُ بيداءِ",41,"ا",2,0],["وَلَأُلبِسَنَّكَ كُلَّ بَيتٍ مُعلَمٍ","يُسدى وَيُلحَمُ بِالثَناءِ المُعجَبِ",42,"ب",1,0],["وَلا لَيلَ إِلّا بِالثَوِيَّةِ أَقمَرٌ","تَنَفَّسَ في السُكرُ عَن نَفحَةِ الشُكرِ",43,"ر",1,0],["وَلا لي رَثَت لَمّا شَكَوتُ صَبابَتي","وَلا أَطفَأَت ناراً يُشَبُّ زَفيرُها",44,"ر",3,0],["ولا لك مصرفٌ عما يُريدُ","أليس لِحمزةَ البأسُ الشديدُ",45,"د",1,0],["وَلا لَغوَ وَلا تَأثيمَ فيها","وَلا غَولٌ وَلا فيها مُليمُ",46,"م",1,0],["وَلا لِنَيْلِ مُرادٍ","ولا لِبَذلِ المَكارِمْ",47,"م",1,0],["ولا لاتّقادٍ مِن سَناهَا عَقَدْتَها","ولكن لأمْرٍ ما وغْيبٍ مُكتَّم",48,"م",1,0],["وَلا لِأَيِّ الطُلولِ أَندُبُها","لِلريحِ وَالرُقشِ مِن قَرانِبِها",49,"ب",3,0],["ولا لابساً تقديمَ شمسٍ وكوكب","ليعرفَ إحياءَ العلوّ من أسفل",50,"ل",1,0],["وَلا لَونَ لِلماءِ فيما يُقالُ","وَلَكِن تَلَوُّنُهُ بِالأَواني",51,"ن",2,0],["وَلا لاِمْرِئٍ أَلْهَمْتَهُ الرُّشْدَ خَاذلٌ","وَلا لاِمْرِئٍ أَوْرَدْتَهُ الْغَيَّ نَاصِرُ",52,"ر",1,0],["وَلآلِ لُطِفِ اللهِ مِنهُ كَرَامَةٌ","سَتَظَلُّ فِي الأَحْفادِ وَالأَبْنَاءِ",53,"ا",2,0],["ولا ، لا تقل معك الحبّ بل","جريمته والخطايا معي",54,"ع",2,0],["ولألحانه، شفاه صبايا","وعيون، تخضر فيها الإثارة",55,"ر",2,0],["ولا لُترى مواطِنُها خراباً","ولا ليبيتَ أهلوها جِياعاً",56,"ع",2,0],["ولا لتكونَ للغربيِّ عوناً","يهدَّدُ فيه للشرقِ اجتماعا",56,"ع",2,0],["وَلا لامرِىءٍ آتَى المُضِلّينَ بَيْعَةً،","رَأى الحرْبَ أبدتْ عن نوَاجذها العُصْلِ",57,"ل",1,0],["ولا لساناً سيفُه حُسامُ","عادته التكْذابُ والتأثامُ",58,"م",1,0],["ولا لضيفٍ عندهم ذمامُ","بَشَّ به منك فتى بسامُ",58,"م",1,0],["ولا لنعماءِ مُجِلٍ جاحدا","ولا تدع حراً حميَّاً حاقدا",59,"د",2,0],["ولا لذيذاً يشبه البواردا","لكن مسيخاً يشبه الجوامدا",59,"د",2,0],["وَلاَ لاِمْرِىء ٍ أَلْهَمْتَهُ الرُّشْدَ خَاذِلٌ","وَلاَ لامْرِى ٍء أَورَدْتَهُ الْغَيَّ نَاصِرُ",60,"ر",1,0]]}