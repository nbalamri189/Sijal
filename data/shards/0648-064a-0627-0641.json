60","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100986","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101015","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96175","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114791","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69324","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69333","المنسرح"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123070","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88657","الرجز"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110631","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101717","المتقارب"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70349","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137411",""],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84856","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76037","السريع"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141224","المتقارب"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83211","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65950","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136995",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100326","المتقارب"],[3077,"","https://poetry.dctabudhabi.ae/diwan/poem/113634","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130050","الوافر"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126245","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104313","السريع"],[3378,"","https://poetry.dctabudhabi.ae/diwan/poem/143867","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112336","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91927","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91211","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132133","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199024","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85166","البسيط"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111055","الوافر"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131649",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45082","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33662","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72850","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139629",""],[4679,"هو البشرُ للفؤاد فيطربُ","https://www.poetsgate.com/ViewPoem.aspx?id=142759",""],[4693,"سلام الله يا شعب العراق","https://www.poetsgate.com/ViewPoem.aspx?id=30098",""],[5111,"أرجُ اللقاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=212130",""],[5183,"رد التهنئة","https://www.poetsgate.com/ViewPoem.aspx?id=180229",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5790,"خذوا قودي من أسير الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112120",""],[5845,"تجلتْ لوحدانية ِ الحقِّ أنوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=15448",""],[5937,"الأوركيديّة","https://www.poetsgate.com/ViewPoem.aspx?id=211800",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"أنا والجمال حكاياتُ حُبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=181885",""],[6106,"هم الطهارة ( سادتنا أهل البيت )","https://www.poetsgate.com/ViewPoem.aspx?id=6304",""]],"verses":[["ويا فارس الدنيا ويا خاطر الورى","ويا من به ذلّت لطه الشدائد",0,"د",1,0],["وَيا فَرطَ بَأوي إِذا ما طَلَعتَ","فَقُمتُ أُقَبِّلُ تِلكَ اليَدا",1,"د",2,0],["وَيَا فَتَاةً حَكَتْ مُهَاةً","بِكُلِّ حُسْنٍ لَهَا اتِّسَامُ",2,"م",1,0],["ويا فتى العلم إنْ أعيتكَ مشكلةٌ","هذا حماه المرجّى والهدايات",3,"ت",1,0],["ويا فتى القصد يروي عن غمام يدٍ","فلك الذي كان ترويه ويرويكا",4,"ك",2,0],["وَيا فَتى الحَيِّ إِن غَنّيتَ لي طَرَباً","فَغَنّنّي واسِفاً مِن قَلبِكَ القاسي",5,"س",2,0],["وَيا فَقيراً يَتَمَنّى الغِنى","هَلّا تَمَنَّيتَ غِنى المَكرُمات",6,"ت",1,0],["وَيا فَرَحَ القَلبِ بِالناشِئينَ","فَفي هَأُلاءِ جَمالُ الحَياة",7,"ه",1,0],["وَيا فُقَراءُ لِماذا التَشَكّي","أَلا تَستَحونَ أَلا تَخجَلون",8,"ن",1,0],["وَيا فِراقَ الأَميرِ الرَحبِ مَنزِلُهُ","إِن أَنتَ فارَقتَنا يَوماً فَلا تَعُدِ",9,"د",1,0],["ويا فرحَ اليهودِ بما فعلتم","فإنَّ الضدَّ يعجبُهُ الخباطُ",10,"ط",1,0],["وَيَا فِتْيَانَهُ إِنْ أَخْطَأَتْنِي","مَبَرَّتُكُمْ فَإِنَّ الثُّكْلَ ثَكْلِي",11,"ل",2,0],["وَيَا فَرَحاً بَعْدَ الْغِيَابِ بِعَائِدٍ","دَنَا فَغَدَا مِنا بِمَرْأىً وَمَلْمَسِ",12,"س",1,0],["وَيَا فِكْرَهُ كمْ نَشَدْتَ العُلَى","بَلَغْتَ مَدَاهَا فَمَاذَا تَرَى",13,"ر",2,0],["و\" يافا \" والغُيومُ تَطوفُ فيها","كحالِمةٍ يُجلِّلُها اكتئاب",14,"ب",1,0],["ويا فرح القلب بالناشئين","ففي هؤلاء جمال الحياة",15,"ه",1,0],["ويافطنة قد سد نافذها الهوى","بها الجمر من كل الجوانب ينفخ",16,"خ",1,0],["ويا فاتر الجفن ماذا الجفا","أمَا آنَ باللَهِ أن تعطفا",17,"ف",2,0],["وَيا فَجرُ لا تَطلع عَلَيَّ فَفي الدُجى","مَدافِنُ فيها تَستكنُّ شَواعِري",18,"ر",2,0],["ويا فوارط أيامي بخيف منىً","لو كان يُفدى زمانٌ كنت أفديكي",19,"ك",2,0],["وَيا فالق الاصباح وَالحب وَالنوى","وَيا باعِث الاشباح في الحشر تنسل",20,"ل",1,0],["وَيا فرقة الاحباب بالرغم لا الرضا","لعل بلطف اللَه تجمعنا الدار",21,"ر",1,0],["وَيا فَخْرِي وَفَخْرُ الْمُلْكِ مُثْنٍ","عَلَيَّ لَقَدْ جَرَيْتُ بِلا رَسِيلِ",22,"ل",1,0],["ويا فؤادي الذي قد ذاب من وله","صبرا فإنك ما استسمنت ذا ورم",23,"م",1,0],["ويا فرح الأنام له بعيد","ولكن السلامة منك عيد",24,"د",1,0],["ويا فجيعة دهري بالخليل ويا","جند العزاء على قلبي الشجيّ قفوا",25,"ف",3,0],["ويا فرحتي لا تكتفي بفريدة","من الشعر بل كوني لها الأمل الجما",26,"م",2,0],["ويا فقرا صبرا على الحالة التي","أصبتم بها يا فوز من كان صابرا",27,"ر",2,0],["ويا فقهاء انتم أدلاء قادة","وحلاّل عقد المشكلات إذا طرا",27,"ر",2,0],["ويا فوز سعي العين في طلب العلى","إذا ما أفادت لذّة العين والقلب",28,"ب",1,0],["ويا فُنونَ قَلَقي بوَجدِهِمْ","على لَظى الغَرامِ قَلِّبينِي",29,"ن",2,0],["ويافُعنا المُجسّدُ ماتَ طفلا","وأمّا الطفلُ قدْ ماتَ جنينا",30,"ن",2,0],["وَيَا فَتِحَ أَقْفالِ","قُلُوبٍ ثُمَّ أَسْماعِ",31,"ع",1,0],["ويا فجرَ رأسي هل إلى ليلةِ المُنى","سبيلٌ وكرّاتِ المواضي القوائمِ",32,"م",1,0],["ويا فارجاً ظُلُماتِ الخطوبِ","وليس سبيلٌ إلى الفُرجةِ",33,"ه",1,0],["ويا فؤادي تقطع واحترق بلظى","على كريم عظيم القدر مرتحل",34,"ل",1,0],["ويا فتنةَ مَن يُفتَنُ","مِن حَوَرٍ ومِن لَعس",35,"س",1,0],["ويا فاروقُ بينَ الحقِّ","والباطلِ في المصدَرْ",36,"ر",1,0],["ويا فلذةَ القلب الجريح الذي مَضَى","بهِ خاطفُ الأَقدار يستعجل الخَطوا",37,"و",2,0],["ويا فؤَادي تفتَّت بعد مصرعهِ","فإن سيف المنايا سابقُ العَذَل",38,"ل",1,0],["وَيا فَوزَنا مِن حَيث حلَّ رِكابُه","بِساحتنا مِن بَعد ما مَسَّنا الضر",39,"ر",1,0],["وَيا فَوز مِن وافى حياض محمد","فَتلك زلال لا سراب هَجير",40,"ر",1,0],["ويا فتى النحو الذي لا تني","لاماتُنا في ميمِه مُولَغَه",41,"غ",2,0],["ويا فِطْرُ ويا أضحى","ويا عيدَ الشعانين",42,"ن",1,0],["ويا فتاة الكريم الح","ر العفيف الأبيِّ",43,"ي",1,0],["ويا فؤاديَ صبراً إن جَزِعت عسى","تحظى فتُضْحِى بهذا بالغا أَمَلَكْ",44,"ك",1,0],["ويا فوْزَ من أنضى حسام اجتهادِه","ولم يدْر ليلاً ما وثيرُ مِهادِه",45,"ه",1,0],["وَيَا فُتُوراً بلحظيْهَا وَهُدْبِهِمَا","مَنْ خَيَّرَ الظَّبْيَ بَيْنَ الغَنْجِ وَالْوَطَفِ",46,"ف",1,0],["وَيَا فُؤَادِيَ أظهرْ حبَّهُ وَأقِمْ","وَيَا لسَانِيَ حَرّرْ مدحَهُ وَصِفِ",46,"ف",1,0],["ويا فَخارَ اسْمِهِ وكُنَيتِهِ","حينَ نكنيهِ أَو نُسمِّيهِ",47,"ي",2,0],["ويا فوز من يهوى جنابك آملا","أياديك كم أغنت فقيراً وكم هدت",48,"ت",1,0],["ويا فوز مشغوف الفؤاد بحبه","ومجرى دموع الحب بالصدق كالمطر",49,"ر",1,0],["ويا فريد ذوي الألباب قاطبة","عفواً فمثلك من يعفو عن الجاني",50,"ن",2,0],["ويا فاطراً رتق السموات منزلاً","بأمرك جنس الروح والملكية",51,"ه",1,0],["ويا فاطراً للأرض مخرج نبتها","وأجسامنا من عالم البرزخية",51,"ه",1,0],["ويا فاطراً لم تفطر الكون عابثاً","ولكنه آيات حكم وحكمة",51,"ه",1,0],["ويا فاطر الأشياء فطرة قادر","تقدس في انشائها عن معونة",51,"ه",1,0],["ويا فاطراً للخير والشر قاضياً","لكسبهما منا اتباع المشيئة",51,"ه",1,0],["ويا فاطر الأشياء كيف أرادها","وقدرها في عالم الصورية",51,"ه",1,0],["ويا فاطر الأعراض حسب اختلافها","وتطبيقها في قالب الجسدية",51,"ه",1,0],["ويا فاطر اجعل فطرتي أبداً على","سبيلك واعصمني فلن أتحولا",52,"ل",2,0],["ويا فتنى الله التي فتن الورى","بها وبها اذرا خبيثا وطيبا",53,"ب",2,0],["ويافؤادي إذا أطعت الصبا","فاحتمل الوجد ولا تضجر",54,"ر",1,0],["ويا فُلكُ باسم اللَه مجراك أقلعي","فإما الردى أو يُنصف النيل مُنصف",55,"ف",1,0],["وَيافِثٌ في نَسلِهِ عَجائِبُ","يَأجوجُ وَالأَتراكُ وَالصَقالِبُ",56,"ب",1,0],["ويا فوز نفسي لو بلغت زمانه","وبغيته دنيا وفي يدي الدنيا",57,"ا",1,0],["ويا فرطي إنّي ذخرتُك لي غنىً","ليومٍ يَعُودُ الأغنياءُ به فقرا",58,"ر",2,0],["وَيا فَتىً ناجِزَةٌ وَعُودُه","عِندَكَ يَلقى الخَيرَ مَن يُريدُه",59,"د",2,0],["وَيا فَتىً كَفُّهُ إِذا مَطَرَت","أَرضاً غَنينا بِهِ عَنِ المَطَرِ",60,"ر",1,0],["ويا فؤادي ويا طرفي الهنا لكما","في الروض بالكأس والساقي فطب وطب",61,"ب",1,0],["ويا فوز سعيي إن ترسمت رسمها","ونعمى لعيني حين أسعى بها حفدا",62,"د",2,0],["وَيافعا جرى بكل حلبة","فجازَ بالجري وحاز القصب",63,"ب",1,0],["ويا فتى العلم قم أرخ بدمع دم","أبكى العلوم كتابا فقد باقرها",64,"ر",3,0],["ويا فاتنا بالجمال العقول","ويا سالب الظبي سحر المقل",65,"ل",1,0],["ويا فراق كم ترى","أنت بنا موكل",66,"ل",1,0],["ويا فتى العزم في حزم الكهول ويا","بدر أضاءت به أرجاء نادينا",67,"ن",2,0],["وَيا فَهيم لَكَ العَليا مهنئة","بِخَير نَجل سَيحيا في العُلا أَبَدا",68,"د",2,0],["وَيا فُؤادي لا تني هائِماً","في حُبِّه حَتّى تُلاقي ثَواك",69,"ك",1,0],["ويا فلك نوح ونار الكليم","وسر البساط الذي فيه سارا",70,"ر",2,0],["وَيا فَرَحي إِذا قابَلتُ ناياً","وَحورُ الحَيِّ تَصدَحُ مُقبِلاتِ",71,"ت",1,0],["ويا فارس إني عليك معول","فقم عجلاً واطلب إلى الحق مسعدا",72,"د",2,0],["ويا فارس قل للرعاع إذا أتوا","إليك وقالوا قم بثارك مصعدا",72,"د",2,0],["ويا فتى كان ملء النفس منطقه","له الشباب اجتباه البأس والخفر",73,"ر",1,0],["ويافعةٍ من بنات الغوير","ولكن تحلُّ بنجد يفاعا",74,"ع",2,1],["ويا فاتكاً عيناه قد طلًتا دمي","وأسلمتا قلبي إلى نوب الدَّهرِ",75,"ر",1,0],["ويا فتيات مصر لكنَّ بُشرى","يُحقِّقها لنا المولى تعالى",76,"ل",2,0],["ويافخرنا الحداد ياعلم الهدى","ومن سار في نهج الطريق السوية",77,"ه",1,0],["ويا فؤادي كنت ذا قوة","فيوم بأن الحي ماركك",78,"ك",1,0],["ويا فتىً باهتْ به","شِيراز بين الأمم",79,"م",1,0],["ويا فُؤاداً خافقاً بالجوَى","خفتُ عَلَيهِ يعتريهِ السّكون",80,"ن",1,0],["وَيا فالق الهامات مِن دون جُنده","وَللأَسد مِن تَحت العَجاج زَئير",81,"ر",1,0],["وَيا فَتى الحُب إِن شَطَّ المَزارُ به","ارفق بنفسك قَد حمّلتها شَططا",82,"ط",2,0],["وَيا فَتى الجدّ وَالجاري عَلى سننٍ","من الفتوّة لا تَنبو رويته",83,"ت",2,0],["ويا فتى الأرز لو نالت رباه يدي","لاخترت من باسفات الأرز أجنيها",84,"ي",3,0],["ويافث فالنسل منهم كائن","تحويهم الآفاق والمدائن",85,"ن",1,0],["ويا فتاة البها يا خير غانية","يحلو لنا الصبر إلّا عن تلاقيها",86,"ي",3,0],["ويا فرد المكارم قد فقدنا","بفقدك من جحاجحها قبيلا",87,"ل",2,0],["ويافع أطلعوا فينا قصايد","وجوب من قد انا سعد شملان",88,"ن",1,0],["ويافا وأَرسوفٌ وتُبنَى وغزَّةٌ","تَخِذْتَ بها بين الطُّلى والظُّبى عُرْسا",89,"ر",3,0],["وَيا فَخرَ أَهلِ الغَربِ يا مَن مَحَلّهُ","مِنَ اللطفِ مِثلُ الخالِ في عَطفَة الصدغِ",90,"غ",1,0],["ويا فِكري اعتامي اللآلئ وانتقي","وفي لبَّة العلياء أبكارَها نُصي",91,"ص",2,0],["وَيا فارِساً يُزري بمن كانَ راجِلاً","يَصول عَلى متنِ الخُيولِ الأصايلِ",92,"ل",1,0],["وَيا فِتنةً عِندَ أَهلِ الفُتونِ","وَيا محنةَ اللَه للمتقينا",93,"ن",2,0],["ويا فضائلَهُ لا زلتِ هامية","كما نراك ويا أوقاتَه إئتلقي",94,"ق",2,0],["ويا فلكاً دارت على قطب مجده ال","مناقب طراً والعلى والمحامد",95,"د",1,0],["ويا فرط ما عانى من الهم والأسى","لدن طال عن أرجاه منك التغيبُ",96,"ب",1,0],["ويا فلوجة الأبطال صبرا","فنحن نراك من مسرى البراق",97,"ق",1,0],["وَيَافِكْرًا تَوَهَّجَ فِِيْ مَدَايَا","تَرَاقَصَ فِيْ جُفُونِي وَاسْتَراحَا",98,"ح",2,0],["ويا فواغي الأماني في خمائلها","سقياً لغصنك بين اللطف والشبم",99,"م",1,0],["ويا فالق الإصباح والحب والنوى","ومن هو للسبع السموات قد فطر",100,"ر",1,0],["ويا فرحة الظبي لما غدا","شبيها له في اللمى والكحل",101,"ل",1,0],["ويا فرنة َ الأحبابِ بالرغمِ لا الرضا","لعلَّ بلطفِ اللهِ تجمعنا الدارُ",102,"ر",1,0],["ويا فتنةً عبرَتْ فوق عيني","عُبورَ زكاةٍ على فُقَرَاءْ",103,"ا",2,0],["ويأفل الليل بسلطانه","ولا يرى من مظلم داجر",104,"ر",1,0],["ويا فرحتي إن أفزْ بالثمَرْ","ويا ترحتي إنْ أفز بالحجَر..",105,"ر",1,0],["ويا فؤادي أفض فالحب مملكة","ملوكها الآل والأحباب كالحشم",106,"م",1,0]]}