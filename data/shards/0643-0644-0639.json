يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[515,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[538,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[558,"ربنا من لطفه لا يدرك","https://www.aldiwan.net/poem33505.html","الرمل"],[558,"صح قولي إن السماع دواء","https://www.aldiwan.net/poem33528.html","الخفيف"],[558,"مهجة ناظراك قد فتناها","https://www.aldiwan.net/poem33674.html","الخفيف"],[558,"إن عين الوجود ليس تنام","https://www.aldiwan.net/poem34186.html","الخفيف"],[558,"كل مصنوع بمن قد صنعه","https://www.aldiwan.net/poem34365.html","الرمل"],[558,"إن للكفر ظلمة في الوجود","https://www.aldiwan.net/poem34652.html","الخفيف"],[562,"ماذا التعلل في دنياك بالأمل","https://www.aldiwan.net/poem52780.html","البسيط"]],"verses":[["كُلَّ عَقلٍ ضاعَ مِن يَقظٍ","فَهوَ في الكاساتِ حَيرانُ",0,"ن",1,0],["كُلُّ عَينٍ قَريحَةٍ تَتَلَقّا","هُ بَوادٍ مِن دَمعِها مَلآنِ",1,"ن",1,0],["كُلُّ عَظيمٍ مِنهُمُ مُحَجَّبٌ","تَأذَنُ أَبوابُ الغِنى إِذا أَذِن",2,"ن",1,0],["كُلُّ عُذَيقٍ في العُلى مُرَجَّبٍ","عِزاً وَعودٍ في العُلى مُجَرجِرِ",3,"ر",1,0],["كُلُّ عَلاةٍ تَتَّقي ال","سَوطَ بِمَجدولٍ مُمَرّ",4,"ر",1,0],["كُلَّ عامٍ يَمُدُّني بِجَمومٍ","عِندَ وَضعِ العِنانِ أَو بِنَجيبِ",5,"ب",1,0],["كُلَّ عامٍ يَقودُ خَيلاً إِلى خَي","لٍ دِفاقاً غَداةَ غِبِّ الصِقالِ",6,"ل",1,0],["كُلُّ عَقْدٍ وَإِنْ تَعَايَى عَلَى الحَ","لِّ بِهِ رَأْيُهُ الحَصِيفُ زَعِيمُ",7,"م",1,0],["كلّ عُرفٍ يروق حسناً وإني","أرتجي أن تكون عرفاً وعاده",8,"ه",1,0],["كلُّ عضوٍ من جِسمها فيه فرجٌ","يقتضيها الزنا اقتضاءَ الغريم",9,"م",1,0],["كُلُّ عَيشٍ غَيرَ ذاكَ ال","عَيشِ في العالَمِ زورُ",10,"ر",1,0],["كل عليها زائل","لا شيء غير الله يبقى",11,"ق",2,0],["كل عام تتجلى ليلتي","ليلة الأيتام عين البائسين",12,"ن",1,0],["كل عال أو كابر أو نبيل","أو وجيه من النجوم فداكا",13,"ك",2,0],["كُلُّ عَصرٍ دارُها إِن صادَفَت","مَنزِلاً رَحباً وَأَهلاً وَجَنابا",14,"ب",2,0],["كُلُّ عَيشٍ ما لَم تُطَبهُ حِمامٌ","كُلُّ شَمسٍ ما لَم تَكُنها ظَلامُ",15,"م",1,0],["كُلُّ عيدٍ لَهُ اِنقِضاءٌ وَكَفّي","كُلَّ يَومٍ مِن جودِهِ في عيدِ",16,"د",1,0],["كُلُّ عُذرٍ مِن كُلِّ ذَنبٍ وَلَكِن","أَعوَزَ العُذوُ مِن بَياضِ العَذارِ",17,"ر",1,0],["كُلُّ عانٍ يُتَرَجّى فَكُّهُ","وَلِذاتِ الخالِ عانٍ ما يُفَكُّ",18,"ك",1,0],["كل عامٍ نأتي لسوق عكاظٍ","وعلينا العمائم الخضراء",19,"ا",2,0],["كل عامٍ نأتي.. فهذا جريرٌ","يتغنى.. وهذه الخنساء",19,"ا",2,0],["كُلٌّ عَلى الدُنيا لَهُ حِرصٌ","وَالحادِثاتُ أَناتُها عَفصُ",20,"ص",1,1],["كلُّ عطرٍ في ثناياه سَرَى","كان سِرّاً مُضمراً فيه فباح",21,"ح",1,0],["كلّ عذراءَ عجوز قد علا","رأسَها في الدنّ شيبُ القُمُّحان",22,"ن",1,0],["كُلُّ عَتْبٍ سَمِعتَ مِنها وَمِنِّي","فهو منها دَلٌّ ومنّيَ ذُل",23,"ل",1,0],["كلّ عَضبٍ يحسبُ الناظرُ في","مَتْنِهِ للنار بالماءِ وقود",24,"د",1,0],["كلٌّ عَبثتَ به وكلٌّ يشتكِي","ما ذاقَ باسْمِكَ من سِهامِ الرّامي",25,"م",2,0],["كُلُ عَيشٍ وَإِن تَطاوَلَ دَهراً","مُنتَهى أَمرُهُ إِلى أَن يَزولا",26,"ل",2,1],["كُلٌّ عَلى مَن يُريدُ نَفعَهُمُ","لَكِنَّهُم مِنهُ في جِناياتِ",27,"ت",1,0],["كلُّ عَذْرَاءَ ما تُرَدُّ مِنَ الكف","ءِ بِعَيْبِ وَلا زَوالِ بَكارَهْ",28,"ر",2,0],["كلُّ عَدْلٍ مُضايِقِ في وُصولٍ","كَعَذُولٍ مُضايِقِ في وِصالِ",29,"ل",1,0],["كَلَّ عَن حَملِهِ السِلاحَ إِلى الحَر","بِ فَأَوصى المُطيقَ أَلّا يُقيما",30,"م",2,0],["كَلَّ عِلمُ الطَبيبِ عَن مَرَضِ المَو","تِ وَقَد نابَ فيهِ كُلَّ مَنابِ",31,"ب",1,0],["كُلٌّ عَلى مَكروهِهِ مُسبَلُ","وَحازِمُ الأَقوامِ لا يُنسِلُ",32,"ل",1,1],["كلُّ عنقودٍ دموعٌ جَمَدَتْ","وقلوبٌ فَنيتْ فيها شعاعا",33,"ع",2,0],["كُلُّ عروضٍ يَعتزي إليها","وإنَّما مَدارُهُ عليها",34,"ه",2,0],["كُلُّ عُمْرٍ إِلَى خِتَامٍ وَلَكِنْ","رَاعَ فِيكَ القُلُوبَ هَذَا الخِتَامُ",35,"م",1,0],["كُلُّ عَيْنٍ مِنْهُ تَصِبُّ صَبِيباً","كَالأَتِيِّ المُجَلْجَلِ المَحْدُورِ",36,"ر",1,0],["كلٌّ عَلى قَدَرٍ يَكِدُّ لِرِزْقِهِ","وَيَقِلُّ لِلصَّحَفِيِّ أَجْرُ الآجِرِ",37,"ر",1,0],["كُلُّ عَصْرٍ لَوْ خَيَّرَتْهُ المَعَالِي","لَتَمَنَّى لوْ أَنَّهُ لَكَ عَصْرُ",38,"ر",1,0],["كُلُّ عِلْمٍ كَأَنَّهُ لَكَ عِلْمٌ","كُلُّ خُبْرٍ كَأَنَّهُ لَكَ خُبْرَ",38,"ر",1,0],["كُلُّ عِلْمٍ وَكُلُّ فَنٍّ لَهُ مِنْهُ","التِفَاتٌ عَالٍ وَفَضْلٌ رَابِ",39,"ب",1,0],["كُلُّ عِلمٍ وَكُلُّ فَنٍّ مُصِيبٌ","فِي ذَرَاهُ حَظّاً مِنَ الإِمْدَادِ",40,"د",1,0],["كُلُّ عُمرٍ مُوَقَّتٌ","في كِتابٍ مُؤَرَّخِ",41,"خ",1,0],["كلُّ عيشٍ قد اراهُ نكداً","غيرَ رُكن الرمح في ظل الفرَس",42,"س",1,1],["كُلُّ عامٍ كأنَّهُ خُطْوَةُ الْجَبارِ","أو وَثْبَةُ الأُسُودِ الغِضاب",43,"ب",1,0],["كُلُّ عام كأنَّه عَلَمُ النَصْرِ","بِكَفِّ المُظَفَّرِ الغَلاَّب",43,"ب",1,0],["كُلُّ عَامٍ كَطَالِعِ السَعِدْ شِمْنَا","هُ عَلَآ طُولِ غَيْبةٍ وَاْحِتجاب",43,"ب",1,0],["كُلُّ عامٍ كالفَجْرِ يَهْزِمُ لَيْلا","نَابِغِيَّ الهُمُومِ والأَوْصاب",43,"ب",1,0],["كُلُّ عامٍ كأنَّهُ الأَمَلُ الضَا","حِكُ وافاكَ بعدَ طُولِ ارْتقابِ",43,"ب",1,0],["كُلُّ عامٍ كَوَافِدِ الْغَيْثِ تَلْقَا","هُ وُجُوهُ الرِّياضِ بالترْحابِ",43,"ب",1,0],["كلٌّ علينا ساخِطٌ","في قَبْرِهِ، والكلُّ ساخر",44,"ر",1,0],["كلُّ عُذْرٍ من كلّ ذنبٍ، ولكِنْ","أُعْوِزَ العُذْرُ مِنْ بَياضِ العِذارِ",45,"ر",1,0],["كُلُّ عامٍ كَطَالِعِ السَعِدْ شِمْنَا","هُ عَلَى طُولِ غَيْبة ٍ وَاحْتِجاب",46,"ب",1,0],["كُلُ عَضو مِني بِمَدحك مُغرى","مُستَهاماً بِحُسن ذِكر صِفاتك",47,"ك",1,0],["كُل عَيش يَمضي فَعنهُ بَديل","عِندَ رَب الوَقار وَالإِجلال",48,"ل",1,0],["كُل عار يَعدّهُ الناس عاراً","صارَ فَخراً وَالعار في الإِفلاس",49,"س",1,0],["كل عال يرى السفيه وضيعا","وكذا حكم شرعة الاسلام",50,"م",1,0],["كل عين من حسنه تتلقاه","بوبلٍ من دمعها هتان",51,"ن",1,0],["كلُّ عضوٍ يأتي إلىَّ بأمرٍ","فتحيرتُ في عظيمِ اشْتغالِ",52,"ل",1,0],["كلُّ على أصلِه يجرى وعادتُه","حتى تحولَه الأسبابُ والعِللُ",53,"ل",1,0],["كُلُّ عافٍ يَنتابُ فَضلَكَ قَد أَص","بَحَ يَنتابُ فَضلَهُ كُلُّ عافِ",54,"ف",1,0],["كل عذاب يبتلى الصب به","يطيقه إلا عذاب الهجر",55,"ر",1,0],["كُلُّ عَينٍ تَحتَ الظَلامِ وَلَكن","بَدَّلَ الحلمُ ما أَجنَّ الظَلامُ",56,"م",1,0],["كلّ على طبعه تجري فضائله","من الأكارم والأحرار والنبل",57,"ل",1,0],["كلٌّ عُدولٌ وكلٌّ عادلونَ وما","فيهِم فتىً عن طريقِ الحقّ معدولُ",58,"ل",1,0],["كلُّ علمٍ في العالمين فمنهُ","عنهُ فيه لهُ عليهِ اِرتقاءُ",59,"ا",2,0],["كلُّ عِلمٍ يكونُ أَو كان مع ما","أَنتَجتهُ الأفكار والآراءُ",59,"ا",2,0],["كلُّ علمٍ في الناسِ قَد فاضَ منهم","هُم بحورُ العلوم والأنواءُ",59,"ا",2,0],["كلَّ عامٍ عيدٌ لَديها وبالمش","عَرِ للعيدِ ليلةٌ قمراءُ",59,"ا",2,0],["كُلّ عامٍ يقولُ كِدنا وكانَ ال","وَصلُ يَدنو وَما لكادَ اِنتهاءُ",59,"ا",2,0],["كلُّ عينٍ سهرتْ فيهِ ولمْ","تكُ من قبلِ الهوى بالساهرةْ",60,"ر",2,0],["كلُّ عذري إليك عندك ذنبٌ","فأنا الدهرَ في اعتذارٍ لعذري",61,"ر",2,0],["كل عصر به ظلام وصبح","وظباء تسطو عليها أسود",62,"د",1,0],["كُلَّ عَذراءَ عَلى قَيثارِها","هَجَعَت وَالشعرُ بَينَ المُقلِ",63,"ل",1,0],["كلُّ عضو منّي إليكم مَشُوقٌ","زائد تُوْقُه على الإبعاد",64,"د",1,0],["كُلَّ عامٍ تُجِدُّها لَكَ نُعما","كَ فَلا أَخلَفَت عُلاكَ السِنينُ",65,"ن",1,0],["كُلٌّ عَلى الآباءِ أَو","وَلُهُم بِآخِرِهِم يُعابُ",66,"ب",1,0],["(كل على ليلاه أضناه الهوى)","وأنا الهوى بمحمّد ترياقي",67,"ي",1,0],["كلّ عاصً يلوذ في ذيلها الطا","هر طوعاً لم يلق وصمة ذنب",68,"ب",1,0],["كل عيش لا ينقضي بهناء","فبنقصانه يكون المزيد",69,"د",1,0],["كل عليه حَفيظ","وَسائق وَشَهيد",70,"د",1,0],["كلّ على أعراضِها متهالكٌ","إن لم يشافَه بالقبيح يُشافه",71,"ه",1,0],["كُلٌّ علَى التَّوْكِيدِ قَوْلَتُهُ","مَقْصورَةٌ مَا أعْوَزَ الْبَدَلُ",72,"ل",1,0],["كُلُّ عَميدٍ مَدّ يُمنَى عامِد","يَبْأى بوَسمي حامد وحافِدِ",73,"د",1,0],["كُلُّ عَلَيْهِ بِما جَشَّمْتَهُ أبْداً","كِلاءةُ الدين واليُمنُ يُكلِّئُهُ",74,"ا",2,0],["كُلٌّ عَلى ذَمِّ اللَّيالِي مُقْبِلٌ","ما دامَ عَنْهُ الْحَظُّ فِيها مُعْرِضا",75,"ض",2,0],["كل عضوٍ لهما عاد مشاعا","فله من نهدها مستندُ",76,"د",1,0],["كُلُّ عَيشٍ وَلَذَّةٍ وَنَعيمٍ","وَحَياةٍ تودي كَفيءِ الظِلالِ",77,"ل",1,0],["كلُّ عبدٍ فيها إلهٌ صغيرٌ","يتسامى ما جدّ في الأسباب",78,"ب",1,0],["كُلٌّ علَى إنسانٍ عَيْني عَطَفَتْ","كَأَنَّ إنْسَاني لَدَيْها وَلَدُ",79,"د",1,0],["كُلّ عيدٍ بِالناس يشري تَهاني","كَ هَناءً فَلَيسَ بِالمَغبونِ",80,"ن",1,0],["كُلٌّ على أَقصى الأَماني يوفي","لَكانَ دونَ قَدرِهِ المُنيفِ",81,"ف",1,0],["كُلُّ عُلُوٍّ فيه له قِدَمٌ","وكُلُّ علْمٍ فيه له قَدَم",82,"م",1,0],["كُلٌّ عَنِ النَهجِ القَويمِ خَوارِجٌ","فَلِمَ الأَزارِقِ خَصّ