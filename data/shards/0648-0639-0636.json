{"poems":[[55,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[55,"لم يبق عندي من الإباء سوى","https://www.aldiwan.net/poem30700.html","المنسرح"],[79,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[29,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[30,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[63,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[68,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[82,"وذي أربع كخوافي العقاب","https://www.aldiwan.net/poem31532.html","المتقارب"],[33,"لعمري لو أبصرتني يوم بنتم","https://www.aldiwan.net/poem42042.html","الطويل"],[35,"فلو زرت بيت الله ثم رأيتها","https://www.aldiwan.net/poem25814.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[79,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[119,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[147,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[164,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[164,"بنى السيف علياه وشيدها الندى","https://www.aldiwan.net/poem58906.html","الطويل"],[190,"وعضوين في الإنسان لا عظم فيهما","https://www.aldiwan.net/poem43929.html","الطويل"],[266,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[287,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[409,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[422,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[438,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[445,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[463,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[466,"فخرت بك الأزمان والحقب","https://www.aldiwan.net/poem16420.html","أحذ الكامل"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[520,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[556,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[556,"حلفت بمن لاذت قريش ببيته","https://www.aldiwan.net/poem47812.html","الطويل"],[572,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[580,"يا قوم ما أغير قوم الذي","https://www.aldiwan.net/poem2920.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63945","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119314","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120081","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25316","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25340","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64775","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106713","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118440","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144754","الطويل"],[2316,"","https://poetry.dctabudhabi.ae/diwan/poem/200311","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82184","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106980","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65976","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100265","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100222","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/13","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74081","المتقارب"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103837","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21512","الطويل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99238","الطويل"],[4299,"","https://poetry.dctabudhabi.ae/diwan/poem/203768","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105515","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115321","المتقارب"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146763","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83119","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57956","الوافر"],[5145,"رقدت ودهرك لا يرقد","https://www.poetsgate.com/ViewPoem.aspx?id=108069",""],[5156,"أشارت بأطراف البنان المخضب","https://www.poetsgate.com/ViewPoem.aspx?id=99123",""],[5277,"مدرسةُ العظام","https://www.poetsgate.com/ViewPoem.aspx?id=194482",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[3469,"غشيت منازلاً من آل هندٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19194&r=&rc=12",""],[572,"أمَرَّ عيشٌ وَحَالَ خفضُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9361&r=&rc=218",""]],"verses":[["وَعَضَضتُ مِن نابي عَلى","جِذمٍ وَنَجَّذَني الشُؤونُ",0,"ن",1,0],["وَعَضِّ كَفّي عَلى الزَمانِ مِنَ ال","غَيظِ وَشَكوى وَقائِعِ النُوَبِ",1,"ب",1,0],["وعَضَدْتَ دينَ اللهِ يا ابْنَ نَصيرِهِ","حتّى سَما فوْقَ السّماءِ عَمودُهُ",2,"د",2,0],["وَعَضَّ اِبنَ ذي الجَدَّينِ حَولَ بُيوتِنا","سَلاسِلُهُ وَالقِدُّ حَولاً مُجَرَّما",3,"م",2,0],["وَعَضُّ زَمانٍ يا اِبنَ مَروانَ لَم يَدَع","مِنَ المالِ إِلّا مُسحَتاً أَو مُجَرَّفُ",4,"ف",1,0],["وعَضَّ السَّيفُ منّي كُلَّ عُضْوٍ","جَديرٍ بالكَرامَةِ لا الهَوانِ",5,"ن",1,0],["وَعَضبٌ كَأَنَّ المَوتَ عاهَدَ حَدَّهُ","وَصالَ فَأَفنى جِرمُهُ كُلَّ ذي جِرمِ",6,"م",1,0],["وعضبٍ لأنْفُس أُسْدِ الكِفاح","معاطبُ تكمنُ في سلته",7,"ت",2,0],["وَعَضَّت عَلى إِبهامِها وَتَنَكَّبَت","قَريباً وَقالَت إِنَّ شَرَّكَ مُلحِقُ",8,"ق",1,0],["وَعَضَّت عَلى إِبهامِها ثُمَّ أَومَأَت","أَخافُ عُيوناً أَن تَهُبَّ نِيامُها",9,"م",3,0],["وَعض أَبوها للندامة كفه","وَما إن له هذي الندامة تنفع",10,"ع",1,0],["وعضوا عليها بالنواخذ جهدكم","ففيها بدايات الهدى والخواتم",11,"م",1,0],["وعضدت دين الله بابن نصيره","حتى سما فوق السماء عموده",12,"د",2,0],["وعضده صدقا بمجموع ماله","وراح ولم يعبأ بطارقة الفقر",13,"ر",1,0],["وَعَضَدتَ بِاِسمِكَ أَهلَ دينِكَ قاهِراً","أَنصارَ عيسى مُذ نَصَرتَ مُحَمَّدا",14,"د",2,0],["وعضضتُ كفّى نادماً من مخرجي","والليل باقٍ والكواكبُ ركَّدُ",15,"د",1,0],["وعضوا عليها نادمين أكفهم","وأصبح راويها ملاما مفندا",16,"د",2,0],["وعضوين في الإنسان لا عظم فيهما","هما سببا إصلاحه وفساده",17,"ه",1,1],["وعضبك من طلا الأعداء ماح","كما يمحو من الشك اليقين",18,"ن",1,0],["وَعَضَّهُ بِالدَّرَدِ الأَقوى وَأَل","قى بَركَهُ عَلَيهِ ظُلماً وَعَرَك",19,"ك",1,0],["وعضوا عليه بالنواجذ واصبروا","عليه ولو لم يبق في الفم ناب",20,"ب",1,0],["وعضبٌ صارم الحدَّين ماضٍ","ولا كالصَّارم السَّيفُ الكَهام",21,"م",1,0],["وعضْبِ جدالٍ فلّلَ الدهرُ حدَّهُ","وما كان إلا قاضب الجدِّ قاضيا",22,"ي",2,0],["وَعَضْبٍ يَمَانٍ قَدْ تَعَرَّفْتَ يُمْنَهُ","وإِنْ يَنْتَسِبْ تَعْطِفْ عَلَيْكَ مَنَاسِبُهْ",23,"ب",2,0],["وعضَّتْ بضروس الجد","بِ أعوامٌ تواليْنا",24,"ن",2,0],["وعَضدْتَه والسَّيْفُ ذو جَزعٍ","فشَدَدْتَ منهُ وصُدِّقَ اللَّقَب",25,"ب",1,0],["وعضك ضيم الدهر مما تضاءلت","قواك له من دائرات انفعاليه",26,"ي",2,0],["وعضلتموها عند خطبة غيركم","حتى انجلت وهي المهم المعضل",27,"ل",1,0],["وَعَضيهةٍ جاءتك من عَبِقٍ بها","أزرى عليك فلم يجُزه كلامُهُ",28,"م",2,0],["وَعُضو الفَتى إن شلّ ليس بعضوهِ","وليس لربّ السّرب سربٌ مُنَفَّرُ",29,"ر",1,0],["وَعَضَّنِي فِيْهِمُ بِنَابٍ","وَالدًّهْرُ مُودٍ بِمَنْ يَعَضُّ",30,"ض",1,0],["وعضةٌ أَمْحُو بها غُضَّةً","وقبلةٌ أَمْحُو بِها عَضَّهْ",31,"ض",2,0],["وَعَضَضنَ عنك جُفُونهنَّ ورَّبما","قلَّبنَ أَحداقاً إليك مراضا",32,"ض",2,0],["وعضت بدر عنذما غب ان سقت","من النرجس الوسمي ورداً تمتعا",33,"ع",2,0],["وعضت الفا مثله آلفا","لبذل جود وسماح غزير",34,"ر",1,0],["وعضت سواه نجائب الشيم التي","ألقت إلى يده مقادة طبع",35,"ع",1,0],["وَعَضَّ بِي إِذْ عَضَّتِ المَغَارِثُ","عِدْلانِ مِنْ دَيْنٍ وَرِدْءٌ ثالِثُ",36,"ث",1,0],["وَعَضَّ عَض الأَدْرَدِ المُثَغْثِغِ","بَعْدَ أَفَانِينِ الشَبابِ البُرْزُغِ",37,"غ",1,0],["وعَضَّ وردٌ بَخدَّيْهِ لعِزَّتِهِ","لمْ يُجْنَ إلاَّ بِأَسْماعٍ وأَبصارِ",38,"ر",1,0],["وعضبهم وشترهم ثم الجمم","في أول وخامس له وتم",39,"م",1,0],["وعضضتُ البنانَ غيظاً ولكن","لا يفيد المكلوم عضُّ البنان",40,"ن",1,0],["وَعضلى صَحابَتِهِ الكِرامِ وَآلِهِ","أَكرِم بِهِم مِن سادةٍ فُضَلاءِ",41,"ا",2,0],["وعضب اذا هب الرياح انتضيته","وليس له من غيرها ابدا غمد",42,"د",1,0],["وعضت بدر الثغرِ فِضَّة معصم","لها كادَ يثنيه السوارُ عَلَى بالي",43,"ل",2,0],["وعضت بنو بكر شفاها وكلحت","بنو تغلب بعد الطعان تغشمرا",44,"ر",2,0],["وعض مجهودنا الأقصى وحمله","من المظالم ما لا يحمل الفيل",45,"ل",1,0],["وعضة على أدي","م خدك الموّرد",46,"د",1,0],["وعض على يديه فتى ظلوم","وفكر كيف أوبقه الخذول",47,"ل",1,0],["وعضَّت نيوب الدهر غرابَ مُطرد","يشلُّ بنات الدهر شل الطرائدِ",48,"د",1,0],["وعضت بادردها أنملاً","تمير الرحاب وتروي الهضابا",49,"ب",2,0],["وعضباً صقيلاً بيوم القراع","بضرب الطلى لا يمل الضرابا",49,"ب",2,0],["وعضها في إستها لما فرغْ","ونال كشف الستر عنها إذ بلغْ",50,"غ",1,0],["وَعَضَّ عَلى أَنامِلِهِ لَهيفاً","وَلاقى يَومَهُ أَسَفاً وَغِيّا",51,"ي",2,0],["وَعَضّ عَلى الوَجدِ منه البنان","وَأَدمى من العضّ أَظفارهُ",52,"ر",2,0],["وعضو بعير فيه الوزن ضعف ما","تقدره في الحدى فاغص الذي لحا",53,"ح",2,0],["وَعَضَّت قُرَيشٌ بَالأَنامِلِ بُغَضَةً","وَمِن قَبلُ ما عُضَّت عَلَينا الأَباهِمُ",54,"م",1,0],["وعَضْباً صقيلاً مازجَ النارَ ماؤُه","عليه فلم تَخْمَدْ ولم تَتَوقَّدِ",55,"د",1,0],["وعضب رشوم شيع في شِيَع الورى","وما ريء يوما بعد ما شيم مغمدا",56,"د",2,0],["وعضُّ ظفْرٍ بأسنانٍ على زَمنٍ","قد عضَّ أَو قَرعُ أسنانٍ بأَظفار",57,"ر",1,0],["وعضباً به يشتد ساعد عزمتي","من الهند مصقول الغرارين مخذما",58,"م",2,0],["وعضب الضريبة يلقى الخطوبَ","بجدٍّ عن الدهر لا ينكلُ",59,"ل",1,0],["وعضّت بدرّ الثغر فضّة معصم","يكاد يثنيه من الذهب القلب",60,"ب",1,0],["وَعُضالُ الأَسقامِ أَذواهُ حَتّى","لا تُحسَّ الأُساةُ إِلا أَنينَه",61,"ن",2,0],["وعضَّ على يديه فتى ظلومٌ","فواحسراته يوم اللقاء",62,"ا",2,0],["وعضل نظم تلاميذه","وميره الأرفع الأمجد",63,"د",1,0],["وعضت على تفاحة في يمينها","بذي اشر عذب المذاقة أشنب",64,"ب",1,0],["وعض الناجذاتِ على مسيرٍ","بلا زادٍ على درب التسامي",65,"م",2,0],["وعَضْباً ثَنَتْ أيدي النوائِبِ حَدَّهُ","فهلاَّ اعتراها من مضاربِهِ عَقْرُ",66,"ر",1,0],["وعَضْبٌ أَغَبَّتْهُ الغُمودُ ويُنتَضى","لإدراكِ ثَارَاتٍ سبقنَ وأَوْتَارِ",67,"ر",1,0],["وعضّ على أنامله لهفياً","ولاقى يومه أَسَفاً وغيّا",68,"ي",2,0],["وَعَضَّنِي منهمُ بنابٍ","والدَّهْرُ مَودٍ لِمَنْ يَعَضُّ",69,"ض",1,0]]}