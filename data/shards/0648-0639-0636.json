{"poems":[[55,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[55,"لم يبق عندي من الإباء سوى","https://www.aldiwan.net/poem30700.html","المنسرح"],[79,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[29,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[30,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[63,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[68,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[82,"وذي أربع كخوافي العقاب","https://www.aldiwan.net/poem31532.html","المتقارب"],[33,"لعمري لو أبصرتني يوم بنتم","https://www.aldiwan.net/poem42042.html","الطويل"],[35,"فلو زرت بيت الله ثم رأيتها","https://www.aldiwan.net/poem25814.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[79,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[119,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[147,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[164,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[164,"بنى السيف علياه وشيدها الندى","https://www.aldiwan.net/poem58906.html","الطويل"],[190,"وعضوين في الإنسان لا عظم فيهما","https://www.aldiwan.net/poem43929.html","الطويل"],[265,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[286,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[407,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[420,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[436,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[443,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[461,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[464,"فخرت بك الأزمان والحقب","https://www.aldiwan.net/poem16420.html","أحذ الكامل"],[485,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[518,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[554,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[554,"حلفت بمن لاذت قريش ببيته","https://www.aldiwan.net/poem47812.html","الطويل"],[570,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[578,"يا قوم ما أغير قوم الذي","https://www.aldiwan.net/poem2920.html","السريع"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/200311","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/13","الوافر"],[1021,"غشيت منازلاً من آل هندٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19194&r=&rc=12",""]],"verses":[["وَعَضَضتُ مِن نابي عَلى","جِذمٍ وَنَجَّذَني الشُؤونُ",0,"ن",1,0],["وَعَضِّ كَفّي عَلى الزَمانِ مِنَ ال","غَيظِ وَشَكوى وَقائِعِ النُوَبِ",1,"ب",1,0],["وعَضَدْتَ دينَ اللهِ يا ابْنَ نَصيرِهِ","حتّى سَما فوْقَ السّماءِ عَمودُهُ",2,"د",2,0],["وَعَضَّ اِبنَ ذي الجَدَّينِ حَولَ بُيوتِنا","سَلاسِلُهُ وَالقِدُّ حَولاً مُجَرَّما",3,"م",2,0],["وَعَضُّ زَمانٍ يا اِبنَ مَروانَ لَم يَدَع","مِنَ المالِ إِلّا مُسحَتاً أَو مُجَرَّفُ",4,"ف",1,0],["وعَضَّ السَّيفُ منّي كُلَّ عُضْوٍ","جَديرٍ بالكَرامَةِ لا الهَوانِ",5,"ن",1,0],["وَعَضبٌ كَأَنَّ المَوتَ عاهَدَ حَدَّهُ","وَصالَ فَأَفنى جِرمُهُ كُلَّ ذي جِرمِ",6,"م",1,0],["وعضبٍ لأنْفُس أُسْدِ الكِفاح","معاطبُ تكمنُ في سلته",7,"ت",2,0],["وَعَضَّت عَلى إِبهامِها وَتَنَكَّبَت","قَريباً وَقالَت إِنَّ شَرَّكَ مُلحِقُ",8,"ق",1,0],["وَعَضَّت عَلى إِبهامِها ثُمَّ أَومَأَت","أَخافُ عُيوناً أَن تَهُبَّ نِيامُها",9,"م",3,0],["وَعض أَبوها للندامة كفه","وَما إن له هذي الندامة تنفع",10,"ع",1,0],["وعضوا عليها بالنواخذ جهدكم","ففيها بدايات الهدى والخواتم",11,"م",1,0],["وعضدت دين الله بابن نصيره","حتى سما فوق السماء عموده",12,"د",2,0],["وعضده صدقا بمجموع ماله","وراح ولم يعبأ بطارقة الفقر",13,"ر",1,0],["وَعَضَدتَ بِاِسمِكَ أَهلَ دينِكَ قاهِراً","أَنصارَ عيسى مُذ نَصَرتَ مُحَمَّدا",14,"د",2,0],["وعضضتُ كفّى نادماً من مخرجي","والليل باقٍ والكواكبُ ركَّدُ",15,"د",1,0],["وعضوا عليها نادمين أكفهم","وأصبح راويها ملاما مفندا",16,"د",2,0],["وعضوين في الإنسان لا عظم فيهما","هما سببا إصلاحه وفساده",17,"ه",1,1],["وعضبك من طلا الأعداء ماح","كما يمحو من الشك اليقين",18,"ن",1,0],["وَعَضَّهُ بِالدَّرَدِ الأَقوى وَأَل","قى بَركَهُ عَلَيهِ ظُلماً وَعَرَك",19,"ك",1,0],["وعضوا عليه بالنواجذ واصبروا","عليه ولو لم يبق في الفم ناب",20,"ب",1,0],["وعضبٌ صارم الحدَّين ماضٍ","ولا كالصَّارم السَّيفُ الكَهام",21,"م",1,0],["وعضْبِ جدالٍ فلّلَ الدهرُ حدَّهُ","وما كان إلا قاضب الجدِّ قاضيا",22,"ي",2,0],["وَعَضْبٍ يَمَانٍ قَدْ تَعَرَّفْتَ يُمْنَهُ","وإِنْ يَنْتَسِبْ تَعْطِفْ عَلَيْكَ مَنَاسِبُهْ",23,"ب",2,0],["وعضَّتْ بضروس الجد","بِ أعوامٌ تواليْنا",24,"ن",2,0],["وعَضدْتَه والسَّيْفُ ذو جَزعٍ","فشَدَدْتَ منهُ وصُدِّقَ اللَّقَب",25,"ب",1,0],["وعضك ضيم الدهر مما تضاءلت","قواك له من دائرات انفعاليه",26,"ي",2,0],["وعضلتموها عند خطبة غيركم","حتى انجلت وهي المهم المعضل",27,"ل",1,0],["وَعَضيهةٍ جاءتك من عَبِقٍ بها","أزرى عليك فلم يجُزه كلامُهُ",28,"م",2,0],["وَعُضو الفَتى إن شلّ ليس بعضوهِ","وليس لربّ السّرب سربٌ مُنَفَّرُ",29,"ر",1,0],["وَعَضَّنِي فِيْهِمُ بِنَابٍ","وَالدًّهْرُ مُودٍ بِمَنْ يَعَضُّ",30,"ض",1,0],["وعضةٌ أَمْحُو بها غُضَّةً","وقبلةٌ أَمْحُو بِها عَضَّهْ",31,"ض",2,0],["وعضت بنو بكر شفاها وكلحت","بنو تغلب بعد الطعان تغشمرا",32,"ر",2,0],["وَعَضَّ عَلى أَنامِلِهِ لَهيفاً","وَلاقى يَومَهُ أَسَفاً وَغِيّا",33,"ي",2,0],["وعضّ على أنامله لهفياً","ولاقى يومه أَسَفاً وغيّا",34,"ي",2,0]]}