{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"لم يبق عندي من الإباء سوى","https://www.aldiwan.net/poem30700.html","المنسرح"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[27,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[28,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[66,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[80,"وذي أربع كخوافي العقاب","https://www.aldiwan.net/poem31532.html","المتقارب"],[31,"لعمري لو أبصرتني يوم بنتم","https://www.aldiwan.net/poem42042.html","الطويل"],[33,"فلو زرت بيت الله ثم رأيتها","https://www.aldiwan.net/poem25814.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[116,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[144,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[161,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[161,"بنى السيف علياه وشيدها الندى","https://www.aldiwan.net/poem58906.html","الطويل"],[187,"وعضوين في الإنسان لا عظم فيهما","https://www.aldiwan.net/poem43929.html","الطويل"],[262,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[283,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[404,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[417,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[433,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[440,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[459,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[462,"فخرت بك الأزمان والحقب","https://www.aldiwan.net/poem16420.html","أحذ الكامل"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[516,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[552,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[552,"حلفت بمن لاذت قريش ببيته","https://www.aldiwan.net/poem47812.html","الطويل"],[568,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[576,"يا قوم ما أغير قوم الذي","https://www.aldiwan.net/poem2920.html","السريع"]],"verses":[["وَعَضَضتُ مِن نابي عَلى","جِذمٍ وَنَجَّذَني الشُؤونُ",0,"ن",1,0],["وَعَضِّ كَفّي عَلى الزَمانِ مِنَ ال","غَيظِ وَشَكوى وَقائِعِ النُوَبِ",1,"ب",1,0],["وعَضَدْتَ دينَ اللهِ يا ابْنَ نَصيرِهِ","حتّى سَما فوْقَ السّماءِ عَمودُهُ",2,"د",2,0],["وَعَضَّ اِبنَ ذي الجَدَّينِ حَولَ بُيوتِنا","سَلاسِلُهُ وَالقِدُّ حَولاً مُجَرَّما",3,"م",2,0],["وَعَضُّ زَمانٍ يا اِبنَ مَروانَ لَم يَدَع","مِنَ المالِ إِلّا مُسحَتاً أَو مُجَرَّفُ",4,"ف",1,0],["وعَضَّ السَّيفُ منّي كُلَّ عُضْوٍ","جَديرٍ بالكَرامَةِ لا الهَوانِ",5,"ن",1,0],["وَعَضبٌ كَأَنَّ المَوتَ عاهَدَ حَدَّهُ","وَصالَ فَأَفنى جِرمُهُ كُلَّ ذي جِرمِ",6,"م",1,0],["وعضبٍ لأنْفُس أُسْدِ الكِفاح","معاطبُ تكمنُ في سلته",7,"ت",2,0],["وَعَضَّت عَلى إِبهامِها وَتَنَكَّبَت","قَريباً وَقالَت إِنَّ شَرَّكَ مُلحِقُ",8,"ق",1,0],["وَعَضَّت عَلى إِبهامِها ثُمَّ أَومَأَت","أَخافُ عُيوناً أَن تَهُبَّ نِيامُها",9,"م",3,0],["وَعض أَبوها للندامة كفه","وَما إن له هذي الندامة تنفع",10,"ع",1,0],["وعضدت دين الله بابن نصيره","حتى سما فوق السماء عموده",11,"د",2,0],["وعضده صدقا بمجموع ماله","وراح ولم يعبأ بطارقة الفقر",12,"ر",1,0],["وَعَضَدتَ بِاِسمِكَ أَهلَ دينِكَ قاهِراً","أَنصارَ عيسى مُذ نَصَرتَ مُحَمَّدا",13,"د",2,0],["وعضضتُ كفّى نادماً من مخرجي","والليل باقٍ والكواكبُ ركَّدُ",14,"د",1,0],["وعضوا عليها نادمين أكفهم","وأصبح راويها ملاما مفندا",15,"د",2,0],["وعضوين في الإنسان لا عظم فيهما","هما سببا إصلاحه وفساده",16,"ه",1,1],["وعضبك من طلا الأعداء ماح","كما يمحو من الشك اليقين",17,"ن",1,0],["وَعَضَّهُ بِالدَّرَدِ الأَقوى وَأَل","قى بَركَهُ عَلَيهِ ظُلماً وَعَرَك",18,"ك",1,0],["وعضوا عليه بالنواجذ واصبروا","عليه ولو لم يبق في الفم ناب",19,"ب",1,0],["وعضبٌ صارم الحدَّين ماضٍ","ولا كالصَّارم السَّيفُ الكَهام",20,"م",1,0],["وعضْبِ جدالٍ فلّلَ الدهرُ حدَّهُ","وما كان إلا قاضب الجدِّ قاضيا",21,"ي",2,0],["وَعَضْبٍ يَمَانٍ قَدْ تَعَرَّفْتَ يُمْنَهُ","وإِنْ يَنْتَسِبْ تَعْطِفْ عَلَيْكَ مَنَاسِبُهْ",22,"ب",2,0],["وعضَّتْ بضروس الجد","بِ أعوامٌ تواليْنا",23,"ن",2,0],["وعَضدْتَه والسَّيْفُ ذو جَزعٍ","فشَدَدْتَ منهُ وصُدِّقَ اللَّقَب",24,"ب",1,0],["وعضك ضيم الدهر مما تضاءلت","قواك له من دائرات انفعاليه",25,"ي",2,0],["وعضلتموها عند خطبة غيركم","حتى انجلت وهي المهم المعضل",26,"ل",1,0],["وَعَضيهةٍ جاءتك من عَبِقٍ بها","أزرى عليك فلم يجُزه كلامُهُ",27,"م",2,0],["وَعُضو الفَتى إن شلّ ليس بعضوهِ","وليس لربّ السّرب سربٌ مُنَفَّرُ",28,"ر",1,0],["وَعَضَّنِي فِيْهِمُ بِنَابٍ","وَالدًّهْرُ مُودٍ بِمَنْ يَعَضُّ",29,"ض",1,0],["وعضةٌ أَمْحُو بها غُضَّةً","وقبلةٌ أَمْحُو بِها عَضَّهْ",30,"ض",2,0]]}