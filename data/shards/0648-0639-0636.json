{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"لم يبق عندي من الإباء سوى","https://www.aldiwan.net/poem30700.html","المنسرح"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[27,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[28,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[66,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[80,"وذي أربع كخوافي العقاب","https://www.aldiwan.net/poem31532.html","المتقارب"],[31,"لعمري لو أبصرتني يوم بنتم","https://www.aldiwan.net/poem42042.html","الطويل"],[33,"فلو زرت بيت الله ثم رأيتها","https://www.aldiwan.net/poem25814.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""]],"verses":[["وَعَضَضتُ مِن نابي عَلى","جِذمٍ وَنَجَّذَني الشُؤونُ",0,"ن",1,0],["وَعَضِّ كَفّي عَلى الزَمانِ مِنَ ال","غَيظِ وَشَكوى وَقائِعِ النُوَبِ",1,"ب",1,0],["وعَضَدْتَ دينَ اللهِ يا ابْنَ نَصيرِهِ","حتّى سَما فوْقَ السّماءِ عَمودُهُ",2,"د",2,0],["وَعَضَّ اِبنَ ذي الجَدَّينِ حَولَ بُيوتِنا","سَلاسِلُهُ وَالقِدُّ حَولاً مُجَرَّما",3,"م",2,0],["وَعَضُّ زَمانٍ يا اِبنَ مَروانَ لَم يَدَع","مِنَ المالِ إِلّا مُسحَتاً أَو مُجَرَّفُ",4,"ف",1,0],["وعَضَّ السَّيفُ منّي كُلَّ عُضْوٍ","جَديرٍ بالكَرامَةِ لا الهَوانِ",5,"ن",1,0],["وَعَضبٌ كَأَنَّ المَوتَ عاهَدَ حَدَّهُ","وَصالَ فَأَفنى جِرمُهُ كُلَّ ذي جِرمِ",6,"م",1,0],["وعضبٍ لأنْفُس أُسْدِ الكِفاح","معاطبُ تكمنُ في سلته",7,"ت",2,0],["وَعَضَّت عَلى إِبهامِها وَتَنَكَّبَت","قَريباً وَقالَت إِنَّ شَرَّكَ مُلحِقُ",8,"ق",1,0],["وَعَضَّت عَلى إِبهامِها ثُمَّ أَومَأَت","أَخافُ عُيوناً أَن تَهُبَّ نِيامُها",9,"م",3,0],["وَعض أَبوها للندامة كفه","وَما إن له هذي الندامة تنفع",10,"ع",1,0],["وعضدت دين الله بابن نصيره","حتى سما فوق السماء عموده",11,"د",2,0]]}