sgate.com/ViewPoem.aspx?id=193709",""],[5227,"ملت وأيم الله نَفسِي نَفسِي","https://www.poetsgate.com/ViewPoem.aspx?id=187510",""],[5281,"واااوطناه","https://www.poetsgate.com/ViewPoem.aspx?id=199750",""],[5320,"آه على الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=41642",""],[5351,"الكرار من جديد","https://www.poetsgate.com/ViewPoem.aspx?id=202211",""],[5362,"يا من تفرد بالجمال وصبه","https://www.poetsgate.com/ViewPoem.aspx?id=170377",""],[5388,"أفديك لولا الرّدى","https://www.poetsgate.com/ViewPoem.aspx?id=206907",""],[5409,"هكذا من حقه من نام ضاعا","https://www.poetsgate.com/ViewPoem.aspx?id=155288",""],[5431,"للدار أنت مودِعٌ وموَدّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=196999",""],[5431,"تبارك الله أحسن الخالقين...","https://www.poetsgate.com/ViewPoem.aspx?id=203151",""],[5464,"يا هند","https://www.poetsgate.com/ViewPoem.aspx?id=6842",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5490,"من أغضب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176263",""],[5660,"حالُ الأَحِبَّةِ لِلأَحِبَّةِ باكي","https://www.poetsgate.com/ViewPoem.aspx?id=35560",""],[5674,"أنت الآمره","https://www.poetsgate.com/ViewPoem.aspx?id=203943",""],[5701,"أهلا بمقدمك العظيم وأكرم","https://www.poetsgate.com/ViewPoem.aspx?id=164676",""],[5736,"أين المفر","https://www.poetsgate.com/ViewPoem.aspx?id=203876",""],[402,"روعتني ذكرى الخسارة لما","https://www.poetsgate.com/ViewPoem.aspx?id=36447",""],[5851,"دمعة طفل عربي","https://www.poetsgate.com/ViewPoem.aspx?id=175299",""],[5873,"المدلة بالجمال","https://www.poetsgate.com/ViewPoem.aspx?id=215918",""],[5897,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=162002",""],[5923,"في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=146240",""],[5943,"رقصَ العقالُ","https://www.poetsgate.com/ViewPoem.aspx?id=52930",""],[5956,"مَن العاهر؟","https://www.poetsgate.com/ViewPoem.aspx?id=181857",""],[5956,"ترجوني ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181967",""],[5956,"الله وحدَهُ فاطرُ الأكوانِ","https://www.poetsgate.com/ViewPoem.aspx?id=183100",""],[5956,"يا بسمةَ الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=183998",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[5956,"كم قال لي المثَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=193006",""],[5956,"خلَفٌ أتانا طاهراً مثل السّلفْ","https://www.poetsgate.com/ViewPoem.aspx?id=193487",""],[5956,"من حقكم","https://www.poetsgate.com/ViewPoem.aspx?id=193711",""],[5997,"يا جاحداً","https://www.poetsgate.com/ViewPoem.aspx?id=214228",""],[6045,"هدية يوم الأم","https://www.poetsgate.com/ViewPoem.aspx?id=125354",""],[6291,"المجدُ والتاريخ ُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87684&r=&rc=18",""],[5190,"الحسناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78290&r=&rc=4",""]],"verses":[["أَوَلَسْتُمْ الشُّهُبَ الأُولَى مَا غَيَّرُوا","مِنْ بَعْدِ بُعْدِ نَبِيِّهِمْ أَوْ بَدَّلُوا",0,"ل",3,0],["أوَ لَسْتُ مَنْ لاكَ الكَلامَ وصاغَهُ","قيْدَ الرِّكابِ وطُرْفَةَ الأسْمارِ",1,"ر",1,1],["أوَ لَسْتَ الشّمْسَ دونَ امْتِراءٍ","حلّ في بُرْجِكَ سهْمُ السّعادَهْ",2,"ه",1,0],["أَوْ لَسْتَ الَّذِي لَهُ كُلَّ يَوْمٍ","حَسَنَاتٌ نَعُدُّهَا بِالمِئِينَا",3,"ن",2,0],["أَوْ لَسْتَ الَّذِي عَلَى غَدَرَاتِ الصَّحْبِ","يَبْقَى الأخَ الأَمِينَا",3,"ن",2,0],["أَوَلَسْتَ قد أوليتَ كلَّ خليفة","شرقاً وغرْباً أصوب الآراءِ",4,"ا",2,0],["أولست غرس ندى يديه فكيف لا","يحيى الغراس بوابل هطّال",5,"ل",1,0],["أَو لَستُم أَبناءَ مَن سارَت بِهِم","في المَكرُماتِ رَوائِعُ الأَمثالِ",6,"ل",1,0],["أَوَ لَستُمُ كَالناسِ أَهلَ حَفائِظٍ","أَم أَنتُمُ لَستُم مِنَ الحَيانِ",7,"ن",1,0],["أَوَ لَستَ رُسطاليس إِن","ذُكِرَ الفَلاسِفَةُ الأَكابِرْ",8,"ر",1,0],["أَوَ لَستَ تَذكُرُ وَقتَ لَو","رقة وَقَلبُك ثَمَّ طائِرْ",8,"ر",1,0],["أَوَلَسَتَ الَّذي إِنتَحَلتُ لَكَ الوُد","دَ وَأَصفَيتُكَ المَحَبَّةَ مَحضا",9,"ض",2,0],["أوَ لستَ أوّلَ مُسلمٍ من حِمْيَرٍ","وَرَدَ الهُدى وَمَضى بِصَفْوِ مَعينِهِ",10,"ه",1,0],["أوَ لَستِ هِنداً قلتِ في خَجَلٍ بَلَى","لا تخجلي فاللّهُ قد عَافاكِ",11,"ك",1,0],["أوَ لستُمُ النفر الذين بنورهم","يجد السَّبيلَ الحائرُ المتعسّف",12,"ف",1,0],["أو لسنا الشعبَ الذي قهر الفرس","قديمًا، ودوَّخ الرومانا؟",13,"ن",2,0],["أولست صديقا تعرفني","هذي الحجرات المملولة !؟",14,"ل",2,0],["أوَلَسْتُ الَّذي انْتَحلْتُ لك الْوُدَّ،","وأَصْفيْتُكَ المَحَبَّةَ مَحْضَا",15,"ض",2,0],["أو لستم كالنّاس أهل حفائظ","أم أنتم لستم من الحيوان؟",16,"ن",1,0],["أَولَستَ مِن قَوم إِذ ذُكِرَ العُلى","كانوا لَهُ مِن أَشرَف الأَحلاف",17,"ف",1,0],["أوَ لَستَ البَلِيغَ في الشِّعرِ مُولَى","قَصَبَ السَّبقِ مَن يُجزِ الخَصِيمَا",18,"م",2,0],["أوَ لَستَ الفَتَى المَجَلَّى في السَّبقِ","فَلاَ تَرضَ أن تَكُونَ لَطِيمَا",18,"م",2,0],["أَو لست من كسرى وما ضربوا به","بأَحقَّ يابن الأَكرمين وأَجدرا",19,"ر",2,0],["أَوَلَستُمُ العربَ الكِرا","مَ وَمَن هُمُ الشمَّ المَعاطِسْ",20,"س",1,0],["أَوَلَسنا في يَقظَةٍ تَخطُفُ الغِب","طَةُ فيها القُلوبَ وَالأَجفانا",21,"ن",2,0],["أَوَلَستَ تَسمَعُ كَيفَ يُنشَد مثخنٌ","تَتَصاعدُ الزَفراتُ مِن إِنشادِهِ",22,"د",2,0],["أَوَلَسنا وَرّاثَ أَقدَم مجدٍ","في يَدينا صَليلُهُ وَالصَريرُ",23,"ر",1,0],["أَوَلَسنا وَرّاثَ شَعبٍ أُنيرَت","بِتَعاليمُه الهداةِ العصورُ",23,"ر",1,0],["أَوَلَستَ تَعلَمُ أَنَّها شُرِيَت","وَاِبنُ الجَليبِ مُضايقٌ سَرِقَه",24,"ق",2,0],["أوَ لستَ تَعلمُ إنني سلطانةٌ","إن لم يكن دَمُ عاشِقي لي يُسفح",25,"ح",1,0],["أولست ذا وجهين وجه باسم","لهم ووجه بارز الانياب",26,"ب",1,0],["أوَ لسْتُ سابقَ حَلْبةِ الشِّعْرِ الّذي","أرضاكَ منه منَ المديحِ صَهيل",27,"ل",1,0],["أو لستُ رب فضائل لو جاز","أدناها وما أزرهي به غيري زُهي",28,"ه",2,0],["أَوَ لَست صَفوةَ اللَ","هِ عَلى الخَلقِ اِصطَفاها",29,"ا",3,0],["أَوَ لَسْنا أهلاً نرى ما تَوارى","عن سوانا، ونعرف الأَقربينا؟",30,"ن",2,0],["أولست تبصر في الفضائيات م","يلقي عليّ من الهموم ثقالها",31,"ل",3,0],["أو لستَ الآن من بعدهم","قبساً من ذلك النور أنارا",32,"ر",2,0],["أولست فاتنها المليك وطالما","جملتها بنفائس التيجان",33,"ن",1,0],["أَوَلستَ ولّاجاً على حَذرٍ","تكفيه خرّاجاً مِنَ القَهرِ",34,"ر",1,0],["أَولستَ يا مَوْلى الملو","ك تُطاعُ في شَرقٍ وغَرْب",35,"ب",1,0],["أَولستَ أَكرمَ مَنْ بَرا","ه اللهُ من عُجْمٍ وعُرْبِ",35,"ب",1,0],["أوَ لستَ تحسبها وقد طاروا بها","كالبرق آناً والسهام أَوانا",36,"ن",2,0],["أَوَلَستم ضربتم بيت مجد","قالَت الشمس ليتَني فيه أمسي",37,"س",2,0],["أَو لسعي بَينَ الوَرى بِنَميم","أَو لغشٍّ يأباه كل همام",38,"م",1,0],["أو لست يا رب العلى","محي الفرائض والسنن",39,"ن",1,0],["أَوَلستُ أَطوَلَها فروعاً في العلى","وأمدَّها في المكرمات عروقاً",40,"ق",2,0],["أو لست ناظم كل بيت سائر","لعلاك تنتشر النجوم إذا انتظم",41,"م",1,0],["أولست أوفى من وفى","بوعوده وبما وعد",42,"د",1,0],["أو لست رحمة ربه العظمى التي","عمت جميع الخلق حر أو لئيم",43,"م",1,0],["أو لست آية ربه الكبرى التي","بهرت عقول الخلق غمر أو فيهم",43,"م",1,0],["أو لست نعمته التي امتدت على","كل العوالم من عليم أو هضيم",43,"م",1,0],["أو لست من باهى الإله به الملا","وأحله في ذروة الشرف الجسيم",43,"م",1,0],["أو لست من سبق الورى في جلبة","أمسيت يا مختار فارسها الزعيم",43,"م",1,0],["أو لست من قد عز يوم الست","ت وامتطا العلا في ليلة الإسرا الوسيم",43,"م",1,0],["أو لست من ركب البراق وقد رقى الس","سبع الطباق وشاهد الوجه الكريم",43,"م",1,0],["أو لست من قد خص بالرؤيا التي","ما نالها إذ رامها موسى الكليم",43,"م",1,0],["أو لست من صلى بأملاك السما","والأنبيا والرسل اللباري العظيم",43,"م",1,0],["أو لست من نال الذي ما ناله","إلاه في الدارين من فضل عظيم",43,"م",1,0],["أو لست من داس البساط بنعله","في حضرة التقديس والمجد الصميم",43,"م",1,0],["أو لست من قرن آسمه مع اسمه","وبعمره قد أقسم البر العظيم",43,"م",1,0],["أو لست من ناداه قل يسمع وسل","واشفع تشفع في العصاة من الجحيم",43,"م",1,0],["أو لست من خلق الوجود لأجله","ولأجله أنشأه مولاه الحكيم",43,"م",1,0],["أو لست من لولاه ما اعتقب الضيا","ولا الظلام ولا الرطيب ولا الهشيم",43,"م",1,0],["أو لست من لولاه ما كان الوها","د ولا السماء ولا النعيم والا الجحيم",43,"م",1,0],["أو لست من لولاه ما كان العلا","والعرش والكرسي واللوح الرقيم",43,"م",1,0],["أو لست من لولاه ما هام السرى","إذ زمزم الحادي بزمزم والحطيم",43,"م",1,0],["أو لست من لاذ به الإرسال وال","أملاك يوم العرض والهول العظيم",43,"م",1,0],["أو لست من حاز الشفاعة في غد","عند الكريم المقسط الحكم الحكيم",43,"م",1,0],["أو لست من قال الإله لنوره","كن يا حبيب فكنت محبوب الكريم",43,"م",1,0],["أو لسيت من نجى عليا إذ اشتكى","من حادث الرمد الملم به الأليم",43,"م",1,0],["أو لست من أرجعت عين قتادة","من بعد قلع يا شفا الداء السقيم",43,"م",1,0],["أو لست من جل العمى وروى الظما","ونفى الطوى وكفى الأذى وشفى السقيم",43,"م",1,0],["أو لست تعلم سيدي إني لكم","صابٍ صبوّاً فائق الأعداد",44,"د",1,0],["أولست في برج المسرة كنت لي","طير السعود وساعدا وسعيدا",45,"د",2,0],["أو لست أصدق سيدٍ ومجاهدٍ","في خدمة الإنسان والأوطان",46,"ن",1,0],["أولستم بني الأولى ابتنوا الاه","رام واستأثروا بحس القيل",47,"ل",1,0],["أولستم بني الأولى ملكوا الأر","ض بحد المهند المسلول",47,"ل",1,0],["أو لستَ تعقله فأنتَ مخلط","دَرك ولا درك فأين المعرفه",48,"ف",2,0],["أو لستُ في زمنٍ أنا من أهله","وهُمُ أولو العِلاّتِ والأدواءِ",49,"ا",2,0],["أوَلستم المتجاوزي","ن بمجدِكم جوزاءها",50,"ا",3,0],["أوَلستَ بالسيفِ الذي","أمِنت مرجّوهُ نُبوَّه",51,"و",2,0],["أَوَلستُ من أوفى طيورك كلما","غردتُ جاءت حكمتي في سَجعتي",52,"ي",1,0],["أو لست تنظر أضلعي","بزفير نارك توقد",53,"د",1,0],["أوَلستَ مِمَّا أَنبَتَت آلاؤُهُ","فأَثِب صَنائعَهُ ثوابَ المثمِرِ",54,"ر",1,0],["أوَلَستَ تَسمَعُ قَولَ كُلِّ مُوَحِّدٍ","يَا دَائِم المَعرُوفِ وَالسُّلطَانِ",55,"ن",1,0],["أو لست تسمع ما تقول سكينة","عماه يوم الأسر من يحميني",56,"ن",2,0],["أو لستَ قد أنجيتَ من طُوفانِه","نوحاً وقد لاقى ابنه إحدى الكُبر",57,"ر",1,0],["أَولست أَنتَ الجَوهر الفَرد الَّذي","مِن دُونه الأَجناس وَالأَنواع",58,"ع",1,0],["أو لست تدرى ما الذي أضحى به","صفو الزمان على الملا يتجدد",59,"د",1,0],["أو لست الأديب في كل معنى","من معاني الكمال والعرفان",60,"ن",1,0],["أو لسنا القوم الاولى ملكوا المد","ن ودانت لديهم الغبراء",61,"ا",2,0],["أولست تدرى أن دونك أمة","تهوى الرفات وتعشق الأحجارا",62,"ر",2,0],["أولست من شعب المليك","فأستظل وأجتلي",63,"ل",2,0],["أولُ سابق إلى الشهادَه","من قادة هم للبَرايا سادَه",64,"ه",1,0],["أو لست تنظرني وقد هتك العدى","خدري وهدمت الطغاة حصوني",65,"ن",2,0],["أوَلست أمّا للجمي","عِ فلِم شُغفت بأغنيائك",66,"ك",1,0],["أَو لست أَوّل مَن دَعا","فَصَغى إِلَيهِ السامِعونا",67,"ن",2,0],["أَوَلَستَ الَّذي جنود اللَيالي","إِن رأَته تَراجَعَت أَشلاءَ",68,"ا",2,0],["أوَ لسْتَ يا ملكَ الهُدَى من أسرةٍ","قد أوْرَثَتْ شيَم العُلى أبناءَها",69,"ا",3,0],["او لست للسلطان كنت أمينه","ويمينه للبطش بالأعداء",70,"ا",2,0],["أولست موصيهم وصاة مؤسس","ذهب الوصي وخاب في إيصائه",71,"ا",3,0],["او لست من بشر تردك رقة ال","اخوين للاخوين عن غلظاتها",72,"ت",3,0],["أَوَ لَستمُ أَدرى بِما كُنتُم بِهِ","تعدونني وَمَتى يَكون أَداءُ",73,"ا",2,0],["أَوَلَستِ بِالأَمسِ الأَواهل بِالَّذي","نَرجو وَنَهوى وِدّها وَنريدها",74,"د",3,0],["أولست أنت القائل البيت الذي","تصلى به وهج السعير المؤصد",75,"د",1,0],["أولسن زينة هذه الد","نيا وأطيب ما يراح",76,"ح",1,0],["أولست تخشى من ملام","والزهر فيه سامعه",77,"ه",1,0],["أولستم أبناء من خلد التا","يخ أفعالهم بحسن ثناء",78,"ا",2,0],["أولستم أبناء من بذلوا المال","لكسب الثنا ونيل العلاء",78,"ا",2,0],["أو لست تنظر دمعة في ناظر","منها وتبصر لمعة في ناظر",79,"ر",1,0],["أوَ لَستَ شَاعِرَ وَقتِنَا وَوَحِيدَهُ","وَالقَطعُ عِندَكَ جَائِزٌ فِي الكَامِلِ",80,"ل",1,0],["أو لست داحي بابها ومزلزلا","من كل ارض أعظم الأطواد",81,"د",1,0],["أو لست معطي كل نفس أمنها","يوم القيامة من أذى الميعاد",81,"د",1,0],["أولست ساقيها غدا من كوثر","والماء ممتنع على الوراد",81,"د",1,0],["أَوَ لَسْتَ مِن قَومٍ إِذا هَزُّوا القَنا","فَتَلوا مَعاصِمَهم لَها تَسويرا",82,"ر",2,0],["أَوَلَسْتَ مَن مَلَأ البَسيطةَ عدلُهُ","واجْتَبَّ بالمعروفِ أَنفَ المُنكرِ",83,"ر",1,0],["أَو لَستَ مِن قَوم رَأَوا كَسبَ الثَنا","بِنُفوسِهِم وَنَفيس مال مُغنَما",84,"م",2,0],["أولستَ عزمي صاحبَ العزمِ الذي","يذرُ الحزونَ من الصعابِ سهولا",85,"ل",2,0],["أَولَستَ من أبناء يعربَ","والدماءِ الزاكية",86,"ه",1,0],["أَو لستُ الأميرَ قالوا جميعاً","وإمامٌ لكُلِّ مَن قال شعرا",87,"ر",2,0],["أو لست البدر لما انسدلا","فوق متن الليل ثوب السدف",88,"ف",1,0],["أو لست الذي إذا ما مهيب","هب للحرب لم تكن هيابا",89,"ب",2,0],["أَوَلست أَنت إلى القتال دعوتَنا","وَجميعنا لكَ قَد أَجاب نداءَ",90,"ا",2,0],["أوَلَستُ الشهيدَ ان متُّ فيهم","فاغسلاني بدمع جفني اغسلاني",91,"ن",2,0],["أوَ لست الذي إذا شئت حكماً","د