اذهب إليها أبا الدرداء مصطحبا","أبا هريرة ترغيبا وتوجيها",197,"ي",3,0],["اذهب وبلغ أيا مبعوث خالقنا :","أن العبادة دون الله ذا كفر",198,"ر",1,0],["اذهلتني يوم صوبي مقبله","شفت موتي بين غدران وظلال",199,"ل",1,1],["إذهبْ إلى اللهِ ربِّ العرشِ معتقداً","بأنَّهُ غافرُ الزلَّاتِ والوزْرِ",200,"ر",1,0],["إذهبْ بغيّكِ لا أريدُ فضاضةً","ودعِ الهوى فالشيبُ منّي استمكنا",201,"ن",2,0],["أَذهَلَتْ خُطوَتِي.. وطَافَ بنفسي","رعشةٌ حرُّها يُذِيبُ الجَلِيدا",202,"د",2,0],["أذهبتَ من عيني البريقَ وطالما","هطلتْ دموعي بالحروفِ وبالجُملْ",203,"ل",1,0],["اذهب فإني رفيق الأنس أصحبه","من حيث شئت فما بالبؤس أنتصر",204,"ر",1,0],["اذهبْ اليهم خنيعا لا تسالمنا","فالموتُ آتيك فينا الظفْرُ والنصْرُ",205,"ر",1,0],["إذْ هرّ شعرٌ في درب عودتنا","فالتمّ نملٌ لمّا على الرطبِ",206,"ب",1,0],["إذ هبطوا أرضاً أوة مض بارق","تروض من سح الدموع ثراها",207,"ا",3,0],["اذهب لأبعد ما تراه من المدى","ولسوف يقتلك النوى في لمح عينْ",208,"ن",1,0],["أذْهبَ الحبْرُ بياضَ الورقِ","بعباراتِ اليَراعِ الغيْدَقِ",209,"ق",1,1],["أذْهلتْ سطوة ُالضراغِم ِ( ديّانُ )","فكادتْ تستًسلمُ الحيْزبونُ",210,"ن",1,0],["اذ هزّني مثل خيط الشمس مضطربا","ذاك الفراق وهذا الخافق الدنفُ",211,"ف",1,0],["اذْهب ودع حبُّنا الأيامَ تذْبَحَه","وتلك تضْحيةٌ ما بعدها ثانِ",212,"ن",1,0],["اذهب بحفظ الله دون صداقةٍ","فقدِ اقتنعتُ بأن أعيش مُضاما",213,"م",2,0],["اذهب عقابُك أن تحسَّ بحالتي","مِن بعدها أرجو إليك سلاما",213,"م",2,0],["اذهب بحفظ الله إنني آسفٌ","لم أرضَ إلا أن أسوق مَلاما",213,"م",2,0],["اذهب إلى الشغلِ المقدس إنه","أَوْلى من المظلومِ فهو البورُ",214,"ر",1,0],["اذهب بحفظِ الله واكسب نعمة","لجميعِ أهلك إنهم لك نورُ..",214,"ر",1,0],["أذهلْتني بمكارمِ الأخلاقِ يا","إيهابُ يا رمز الهدى والتضحيةْ",215,"ي",2,0],["اذهب لمصنعك الجميل مهللا","ومكبّراً سترى انتصارك مذهلا",216,"ل",2,1],["اذهبْ تذكَّرْ أنّ أمّك ترتجي","منك انعطافاً طارداً عنك القِلى",216,"ل",2,0],["اذهب بعيداً عن هنا","ما فاز إلا الأبعَدُ",217,"د",1,0],["اذهب فإنك بالطبو","لِ وبالبصاقِ تُمَجَّدُ",217,"د",1,0],["اذهب لأحمدَ وارجُ منه مطلباً","يغمرك خيراً لا تعود حزينا",218,"ن",2,0],["إذ هبت (فرقك) في جز الشعور فهل","غنيت في فرق مادون الهمايين",219,"ن",1,0],["أذهَبتِ عَنِّي العَقلَ حَتَّى أنَّنِي","سَكَرًا غَفَوتُ كَأنَّكِ الصَّهبَاءُ",220,"ا",2,0],["إذهب واسلك دربا يهوي","من أعطاف الجفن الدامع",221,"ع",1,0],["أذهبت رونق ماء الصبح في العذل","فاربع فلستَ بمعصوم من الزلّل",222,"ل",1,1]]}