poetsgate.com/ViewPoem.aspx?id=192385",""],[5956,"صبرُ إيهاب دريع","https://www.poetsgate.com/ViewPoem.aspx?id=193102",""],[5956,"اذهب لمصنعك الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=193166",""],[5956,"وجهك المنحوس","https://www.poetsgate.com/ViewPoem.aspx?id=193525",""],[5956,"بعدالةٍ من أحمد الطعمينا","https://www.poetsgate.com/ViewPoem.aspx?id=194285",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[6125,"تُدمِي بقلبي هِجرَةٌ وجَفَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208593",""],[6213,"نهر الأحلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76256&r=&rc=13",""],[6259,"أذهبت رونق ماء الصبح في العذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59394&r=&rc=42",""]],"verses":[["أَذهَلَني اِستِواؤُها في غَيِّها","مُطيعَها أَعذُلُ أَو مُطاعَها",0,"ع",3,0],["إِذهَب بِسَبّي إِن سَبَبتُكَ فاخِراً","قَد نَوَّهَت بِكَ ضَربَةٌ مِن باتِرِ",1,"ر",1,0],["اِذهَب وَلا تَبعَدَنَّ مِن رَجُلٍ","إِنَّ كِرامَ الرِجالِ قَد ذَهَبوا",2,"ب",3,1],["أَذهَبتُهُ بِمَهامِهٍ مَجهولَةٍ","لا يَهتَدي بُرتٌ بِها أَن يَقصِدا",3,"د",2,0],["إِذ هِيَ الهَمُّ وَالحَديثُ وَإِذ تَع","صي إِلَيَّ الأَميرَ ذا الأَقوالِ",4,"ل",1,0],["إِذ هِيَ تَصطادُ الرِجالَ وَلا","يَصطادُها إِذا رَماها الأَبَلّ",5,"ل",1,0],["إِذ هُنَّ أَقساطٌ كَرِجلِ الدَبى","أَو كَقَطا كاظِمَةَ الناهِلِ",6,"ل",1,0],["إِذ هُنَّ في غَلَسِ الظَلامِ قَوارِبٌ","أَعدادَ عَينٍ مِن عُيونِ أَثالِ",7,"ل",1,0],["إِذهَب حَريباً جَزاكَ اللَهُ جَنَّتَهُ","عَنّا وَخُلِّدتَ في الفِردَوسِ تَخليدا",8,"د",2,0],["إِذهَب فَلا يُبعِدَنكَ اللَهُ مِن رَجُلٍ","لاقى الَّذي كُلُّ حَيٍّ بَعدَهُ لاقي",9,"ق",2,0],["إِذْهَبْ ذَهُبْتَ مُوَفَّقاً وَتَمَلَّهُ","خُلْداً هُنَالِكَ مُونِقاً وَنَعِيمَا",10,"م",2,0],["أذهبت من صفح الوجود كيانَها","ومحوتَها إِلاَّ من التّذكارِ",11,"ر",1,0],["إذ هو مذ ألقى به ناظره","من بعد ما ثغر الصباح ابتسم",12,"م",1,0],["إذ هاتف في السماء يهتِف بي","كأنه في الغمام مُحتَجِب",13,"ب",1,0],["أذ هم على الشرّ في الأخلاق قد جبلُوا","فلا احتياج لهمّاز وخنّاس",14,"س",1,0],["إذ هن لأخُضُعُ الحدي","ث ولا تكشفت المفاضِلْ",15,"ل",1,1],["إِذ هُم بِمَعرَكَةٍ تُخاضُ دِمائُهُم","تَصلى الخُدودُ بِذِلَّةٍ وَقُبوحِ",16,"ح",1,0],["اذهبْ فإنك بعدَها","كهفُ اليتامَى والأراملْ",17,"ل",1,0],["إِذهَب فَما لَكَ في السَما مِن مَوضِعٍ","يا أَيُّها الرَجُلُ الأَثيمُ الجاني",18,"ن",2,0],["اذهب فان قلوب الشعب دامية","ما ان لها من سلو فيك يا عيد",19,"د",1,0],["اذهبي يا كعاب فالموت","لا يورث الضجر",20,"ر",1,0],["اذهبوا فيه وجيئوا إخوة","بعضهم خِدن لبعض وخليل",21,"ل",1,0],["إِذهَب إِلَيكَ فَلا مُحظىً بِعارِفَةٍ","وَلا مُصيباً بِما حاوَلتَ إِمكانا",22,"ن",2,0],["أَذهَلَ العَقلَ رُزؤُهُ فَتَرى النا","سَ سَكارى وَما هُمُ بِسَكارى",23,"ر",2,0],["أذهبتُ الحزن بمُذْهَبَةٍ","وبها ذَهّبْتُ لُجَيْنَ يدي",24,"د",2,0],["إِذهَب فَلَم أَجزَع عَلَيكَ وَرُبَّما","صَبَّرتُ عَنكَ حَشاشَةً لَم تَصبِرِ",25,"ر",1,0],["أَذُهلَ بنَ شَيبانَ ذُهلَ الفَخارِ","وَذُهلَ النَوالِ وَذُهلَ العَلاءِ",26,"ا",2,0],["إِذهَب وَقُل لِلَّتي لامَت وَقَد عَلِمَت","أَن لَم تَنَل في ثَوابي طائِلاً تَدَعِ",27,"ع",1,1],["اِذهَب فَدَيتُكَ غَيرَ مُبتَعِدٍ","لا كانَ هَذا آخِرَ العَهدِ",28,"د",1,0],["اِذهَبي في كِلاءَةِ الرَحمَنِ","أَنتِ مِنّي في ذِمَّةٍ وَأَمانِ",29,"ن",1,1],["إِذ هِيَ أَمسَت مَنبِتُ الرَبعِ دونَها","وَدونَكِ أَرطىً مُسهِلٌ وَأَلاءُ",30,"ا",2,0],["اذهبي ما أنتِ من شانِ الأُلَى","أوردوا قومَكِ ذَاكَ الموَرِدا",31,"د",2,0],["اذهب خراشُ إلى قريشٍ ناصحاً","فلعلّها تبغي الصَّوابَ فتفهم",32,"م",1,0],["اذهبْ حُيَيُّ مُذمماً مشؤوما","أَحَشَدْتَ إلا جمعَكَ المهزوما",33,"م",2,1],["إذهبْ لكَ الويلاتُ من مُتَمَرِّدٍ","عادَى الإِلهَ ولجَّ في آثامه",34,"م",2,0],["إذ هُوَ يَوماً غَابَ عَنِّي سَاعَةً","كَانَتِ السَّاعَةُ أدهَى وَأمَر",35,"ر",1,0],["أَذهَبتَ عَنّي الجَدبَ حَتّى خِفتُ أَن","أُنمى إِلى الأَدَبِ اِنتِماءَ المُلصَقِ",36,"ق",1,0],["أَذهل عَنها وَرُبَما ذَهلت","عَني وَقَد جئت بي تَذكّرها",37,"ر",3,0],["إِذهَبوا في البِلاد طولاً وَعَرضاً","وَاِنظُروا ما لِخَصمكم مِن جُهودِ",38,"د",1,0],["إِذهَب إِلى بَيتِ عَذرَه","وَمَتِّعِ النَفسَ قَطرَه",39,"ر",2,1],["إذْ همُ اسْتَقْرَؤُوا البَداءَ وكم سا","قَ وَبَالاً إِليهم اسْتِقْرَاءُ",40,"ا",2,0],["إذهَبْ فلا يَعْدمك أبيضُ صارمٌ","تَسْطو به قِدْماً وأسمَرُ ذابل",41,"ل",1,0],["إِذهَب نَجَوتَ مِنَ الهِجاءِ وَلَذعِهِ","وَأَما وَلَثغَةِ رَحمَةَ اِبنِ نَجاحِ",42,"ح",1,1],["اِذهَب فَما أَنتَ كَالَّذي ذَكَروا","أَنتَ وَرَبّي مُعارِكٌ أَشِرُ",43,"ر",1,0],["أَذَهَبتَ يَوماً فَلَم تَعدُدهُ مَرزِيَةً","وَعُدَّ ذاهِبُ مالٍ مِن رَزاياكا",44,"ك",2,0],["أَذِهنِيَ طالَ عَهدُكَ بِالصِقالِ","وَماجَ الناسُ في قيلٍ وَقالِ",45,"ل",1,1],["إِذهَب إِلَيكَ فَإِنّي مِن بَني أَسَدٍ","أَهلِ القِبابِ وَأَهلِ الجُردِ وَالنادي",46,"د",2,0],["إِذ هُمُ مِن خَيرِ حَيِّ سُوقَةً","وَطِىءَ الأَرضَ بِسَهلٍ أَو جَبَل",47,"ل",1,0],["أَذهب صَبري اطراد دَهري","وَربما أَوجب اِنتحاري",48,"ر",2,0],["إذ هاجَموا يوم الوغى","غلب المدافع بالصفائح",49,"ح",1,0],["إذهبْ إِليها ودعْ ذمامي","فديتُكَ اسْلَمْ على التنائي",50,"ي",1,0],["اِذهَبوا فيهِ وَجيئوا إِخوَةً","بَعضُكُم خِدنٌ لِبَعضٍ وَخَليل",51,"ل",1,0],["إذهَبي إنَّ كُلَّ دُنيَا ضلالٌ","والأَمانِيُّ عُقرهُا لِلتَّبَابِ",52,"ب",1,1],["إذ هِيَ تَسبي النَّاظرِينَ وتَج","لُو واضِحاً كَالأُقحُوانِ رَتِل",53,"ل",1,0],["اذْهَبْ فَلَيْسَ يَضِيرُ غَيْرَ","قُلُوبِنَا هذَا الذِّهَابْ",54,"ب",1,0],["اِذهَب لَكَ اللَهُ جارُ","وَجَنَّةُ الخُلدِ دارُ",55,"ر",1,1],["اِذهَب بِحُسنِ عَزائي","فَلَيسَ عَنكَ اِصطِبارُ",55,"ر",1,0],["اِذهَب إِلى النارِ وَالعَذابِ فَما","خِلتُكَ إِلّا مِنَ الشَياطينِ",56,"ن",1,0],["إذهبي .. إذهبي إليه .. فبعدي","لن تعيش الدفلى ، ولا الجلنار",57,"ر",1,0],["أَذهَلتَني عَن أَن أَقومَ بِحَقِّها","يا واسِمي بِالعَجزِ حينَ يَجودُ",58,"د",1,0],["أَذهَلتَني عَن أَن أَقولَ وَإِنَّما","نابَت هِباتُكَ عَن لِساني فَاِسمَعِ",59,"ع",1,0],["إِذ هامُهُم كَالطَيرِ لاقَت مَشرَعاً","بَعضٌ مُحَلِّقَةٌ وَبَعضٌ وُقَّعُ",60,"ع",1,0],["إذ هم عبيد وأتباع سواسية","لا يرجعون إلى عقل ولا أدب",61,"ب",1,0],["أَذهبَ اللَّه رِجسهم فهم مِن","كلِّ عَيبٍ عاب الورى أبرياءُ",62,"ا",2,0],["اذهب وهبتُك للذين اخترتَهم","هبةَ الكريم فإنه لا يرجعُ",63,"ع",1,1],["اذهب فلستَ بنائلٍ ما رمتَه","حتى تُغَيَّب في الثرى مرموسا",64,"س",2,0],["إ