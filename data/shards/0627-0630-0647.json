{"poems":[[53,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[53,"اذهب ولا تبعدن من رجل","https://www.aldiwan.net/poem30731.html","المنسرح"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[0,"يا دار ماوِية بالحائلِ","https://www.aldiwan.net/poem65.html",""],[35,"إربع فحي معارف الأطلال","https://www.aldiwan.net/poem39096.html","الكامل"],[10,"عيني جودا بدمع منكما جودا","https://www.aldiwan.net/poem21074.html","البسيط"],[10,"ما بال عينك منها الدمع مهراق","https://www.aldiwan.net/poem21118.html","البسيط"],[93,"أتحين في هذي النضارة والصبا","https://www.aldiwan.net/poem11406.html","الكامل"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[88,"أن بليلا من نسيم السحر","https://www.aldiwan.net/poem44414.html","الرجز"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[88,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[37,"إذ هن لأخضع الحديث","https://www.aldiwan.net/poem7596.html","مجزوء الكامل"],[23,"خابت بنو أسد وآب غزيهم","https://www.aldiwan.net/poem21469.html","الكامل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[91,"مازال يمشي في الأمور بفكره","https://www.aldiwan.net/poem62771.html","عموديه"],[89,"قد عدت بعد ذهاب منك يا عيد","https://www.aldiwan.net/poem44645.html","البسيط"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[45,"أعن جوار أبي إسحاق تطمع أن","https://www.aldiwan.net/poem66813.html","البسيط"],[66,"صال فينا الردى جهارا نهارا","https://www.aldiwan.net/poem40126.html","الخفيف"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[44,"أغزال قولي للغزال الأحور","https://www.aldiwan.net/poem30038.html","الكامل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[31,"إذهب وقل للتي لامت وقد علمت","https://www.aldiwan.net/poem42241.html","البسيط"],[31,"يا صاحبي تصدعت كبدي","https://www.aldiwan.net/poem42574.html","الكامل"],[33,"اذهبي في كلاءة الرحمن","https://www.aldiwan.net/poem25771.html","الخفيف"],[33,"فواكبدا من حب من لا يحبني","https://www.aldiwan.net/poem26032.html","الطويل"],[105,"جرد السيف أبا بكر فما","https://www.aldiwan.net/poem43579.html","الرمل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[105,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[81,"دنت الساعة وانشق القمر","https://www.aldiwan.net/poem61346.html","الرمل"],[81,"يا واحدا في الفضل حالفني ندى","https://www.aldiwan.net/poem61454.html","الكامل"],[102,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[102,"أيها الموت أي مجلس أنس","https://www.aldiwan.net/poem32933.html","الخفيف"],[52,"إذهب إلى بيت عذره","https://www.aldiwan.net/poem26979.html","المجتث"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[48,"إذهب نجوت من الهجاء ولذعه","https://www.aldiwan.net/poem62528.html","الكامل"],[50,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[46,"شفاء ما بك أعياني وأعياكا","https://www.aldiwan.net/poem23092.html","البسيط"],[46,"أذهني طال عهدك بالصقال","https://www.aldiwan.net/poem23230.html","الوافر"],[15,"طاف الخيال علينا ليلة الوادي","https://www.aldiwan.net/poem45273.html","البسيط"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19262","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21009","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21081","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54651","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10208","المنسرح"],[99,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[144,"ما الحسان فما لهن عهود","https://www.aldiwan.net/poem11745.html","الكامل"],[144,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[144,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[161,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[205,"اذهب وهبتك للذين اخترتهم","https://www.aldiwan.net/poem53036.html","الكامل"],[205,"ولقد دخلت الدير أطلب شخصه","https://www.aldiwan.net/poem53128.html","الكامل"],[224,"كم قد رأيتك والظلام مخيم","https://www.aldiwan.net/poem41871.html","الكامل"],[230,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[230,"رأيت في البستان إنسانة","https://www.aldiwan.net/poem51250.html","السريع"],[260,"الحمد للإله هادي الناسك","https://www.aldiwan.net/poem35806.html","الرجز"],[282,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[288,"إذ هي كالرشإ المخروف زينها","https://www.aldiwan.net/poem1891.html","البسيط"],[305,"نسمات الحي وهنا إذ سرت","https://www.aldiwan.net/poem16846.html","الرمل"],[343,"يا خليلي متع الطر","https://www.aldiwan.net/poem55311.html","مجزوء الرمل"],[346,"قالت أنيسة دع بلادك والتمس","https://www.aldiwan.net/poem4466.html","الكامل"],[364,"هل حبل شماء قبل البين موصول","https://www.aldiwan.net/poem1715.html","البسيط"],[403,"غير مستنكر من الأيام","https://www.aldiwan.net/poem46973.html","الخفيف"],[404,"وعلى نظم وقفنا رائق","https://www.aldiwan.net/poem33596.html","الرمل"],[407,"أذهبت رونق ماء النصح في العذل","https://www.aldiwan.net/poem50137.html","البسيط"],[410,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[440,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[449,"حبذا والحال داجي الظلم","https://www.aldiwan.net/poem53777.html","الرمل"],[454,"أمسائل القدر العتي محيرا","https://www.aldiwan.net/poem61571.html","الكامل"],[469,"يوم الفراق لقد أمت فريقا","https://www.aldiwan.net/poem59822.html","الكامل"],[469,"أذهبت فضة خده بعتابي","https://www.aldiwan.net/poem60438.html","الكامل"],[478,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[496,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[516,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[539,"طلع الحسن من جبينك شمسا","https://www.aldiwan.net/poem48230.html","عموديه"],[552,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[559,"طلع امبدر في دياجي امظلام","https://www.aldiwan.net/poem33869.html","الخفيف"],[559,"عالم النطق عالم الأنفاس","https://www.aldiwan.net/poem34442.html","الخفيف"],[574,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[576,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[585,"شفيت من حمزة نفسي بأحد","https://www.aldiwan.net/poem69388.html","الرجز"]],"verses":[["أَذهَلَني اِستِواؤُها في غَيِّها","مُطيعَها أَعذُلُ أَو مُطاعَها",0,"ع",3,0],["إِذهَب بِسَبّي إِن سَبَبتُكَ فاخِراً","قَد نَوَّهَت بِكَ ضَربَةٌ مِن باتِرِ",1,"ر",1,0],["اِذهَب وَلا تَبعَدَنَّ مِن رَجُلٍ","إِنَّ كِرامَ الرِجالِ قَد ذَهَبوا",2,"ب",3,1],["أَذهَبتُهُ بِمَهامِهٍ مَجهولَةٍ","لا يَهتَدي بُرتٌ بِها أَن يَقصِدا",3,"د",2,0],["إِذ هِيَ الهَمُّ وَالحَديثُ وَإِذ تَع","صي إِلَيَّ الأَميرَ ذا الأَقوالِ",4,"ل",1,0],["إِذ هِيَ تَصطادُ الرِجالَ وَلا","يَصطادُها إِذا رَماها الأَبَلّ",5,"ل",1,0],["إِذ هُنَّ أَقساطٌ كَرِجلِ الدَبى","أَو كَقَطا كاظِمَةَ الناهِلِ",6,"ل",1,0],["إِذ هُنَّ في غَلَسِ الظَلامِ قَوارِبٌ","أَعدادَ عَينٍ مِن عُيونِ أَثالِ",7,"ل",1,0],["إِذهَب حَريباً جَزاكَ اللَهُ جَنَّتَهُ","عَنّا وَخُلِّدتَ في الفِردَوسِ تَخليدا",8,"د",2,0],["إِذهَب فَلا يُبعِدَنكَ اللَهُ مِن رَجُلٍ","لاقى الَّذي كُلُّ حَيٍّ بَعدَهُ لاقي",9,"ق",2,0],["إِذْهَبْ ذَهُبْتَ مُوَفَّقاً وَتَمَلَّهُ","خُلْداً هُنَالِكَ مُونِقاً وَنَعِيمَا",10,"م",2,0],["أذهبت من صفح الوجود كيانَها","ومحوتَها إِلاَّ من التّذكارِ",11,"ر",1,0],["إذ هو مذ ألقى به ناظره","من بعد ما ثغر الصباح ابتسم",12,"م",1,0],["إذ هاتف في السماء يهتِف بي","كأنه في الغمام مُحتَجِب",13,"ب",1,0],["أذ هم على الشرّ في الأخلاق قد جبلُوا","فلا احتياج لهمّاز وخنّاس",14,"س",1,0],["إذ هن لأخُضُعُ الحدي","ث ولا تكشفت المفاضِلْ",15,"ل",1,1],["إِذ هُم بِمَعرَكَةٍ تُخاضُ دِمائُهُم","تَصلى الخُدودُ بِذِلَّةٍ وَقُبوحِ",16,"ح",1,0],["اذهبْ فإنك بعدَها","كهفُ اليتامَى والأراملْ",17,"ل",1,0],["إِذهَب فَما لَكَ في السَما مِن مَوضِعٍ","يا أَيُّها الرَجُلُ الأَثيمُ الجاني",18,"ن",2,0],["اذهب فان قلوب الشعب دامية","ما ان لها من سلو فيك يا عيد",19,"د",1,0],["اذهبي يا كعاب فالموت","لا يورث الضجر",20,"ر",1,0],["اذهبوا فيه وجيئوا إخوة","بعضهم خِدن لبعض وخليل",21,"ل",1,0],["إِذهَب إِلَيكَ فَلا مُحظىً بِعارِفَةٍ","وَلا مُصيباً بِما حاوَلتَ إِمكانا",22,"ن",2,0],["أَذهَلَ العَقلَ رُزؤُهُ فَتَرى النا","سَ سَكارى وَما هُمُ بِسَكارى",23,"ر",2,0],["أذهبتُ الحزن بمُذْهَبَةٍ","وبها ذَهّبْتُ لُجَيْنَ يدي",24,"د",2,0],["إِذهَب فَلَم أَجزَع عَلَيكَ وَرُبَّما","صَبَّرتُ عَنكَ حَشاشَةً لَم تَصبِرِ",25,"ر",1,0],["أَذُهلَ بنَ شَيبانَ ذُهلَ الفَخارِ","وَذُهلَ النَوالِ وَذُهلَ العَلاءِ",26,"ا",2,0],["إِذهَب وَقُل لِلَّتي لامَت وَقَد عَلِمَت","أَن لَم تَنَل في ثَوابي طائِلاً تَدَعِ",27,"ع",1,1],["اِذهَب فَدَيتُكَ غَيرَ مُبتَعِدٍ","لا كانَ هَذا آخِرَ العَهدِ",28,"د",1,0],["اِذهَبي في كِلاءَةِ الرَحمَنِ","أَنتِ مِنّي في ذِمَّةٍ وَأَمانِ",29,"ن",1,1],["إِذ هِيَ أَمسَت مَنبِتُ الرَبعِ دونَها","وَدونَكِ أَرطىً مُسهِلٌ وَأَلاءُ",30,"ا",2,0],["اذهبي ما أنتِ من شانِ الأُلَى","أوردوا قومَكِ ذَاكَ الموَرِدا",31,"د",2,0],["اذهب خراشُ إلى قريشٍ ناصحاً","فلعلّها تبغي الصَّوابَ فتفهم",32,"م",1,0],["اذهبْ حُيَيُّ مُذمماً مشؤوما","أَحَشَدْتَ إلا جمعَكَ المهزوما",33,"م",2,1],["إذهبْ لكَ الويلاتُ من مُتَمَرِّدٍ","عادَى الإِلهَ ولجَّ في آثامه",34,"م",2,0],["إذ هُوَ يَوماً غَابَ عَنِّي سَاعَةً","كَانَتِ السَّاعَةُ أدهَى وَأمَر",35,"ر",1,0],["أَذهَبتَ عَنّي الجَدبَ حَتّى خِفتُ أَن","أُنمى إِلى الأَدَبِ اِنتِماءَ المُلصَقِ",36,"ق",1,0],["أَذهل عَنها وَرُبَما ذَهلت","عَني وَقَد جئت بي تَذكّرها",37,"ر",3,0],["إِذهَبوا في البِلاد طولاً وَعَرضاً","وَاِنظُروا ما لِخَصمكم مِن جُهودِ",38,"د",1,0],["إِذهَب إِلى بَيتِ عَذرَه","وَمَتِّعِ النَفسَ قَطرَه",39,"ر",2,1],["إذْ همُ اسْتَقْرَؤُوا البَداءَ وكم سا","قَ وَبَالاً إِليهم اسْتِقْرَاءُ",40,"ا",2,0],["إذهَبْ فلا يَعْدمك أبيضُ صارمٌ","تَسْطو به قِدْماً وأسمَرُ ذابل",41,"ل",1,0],["إِذهَب نَجَوتَ مِنَ الهِجاءِ وَلَذعِهِ","وَأَما وَلَثغَةِ رَحمَةَ اِبنِ نَجاحِ",42,"ح",1,1],["اِذهَب فَما أَنتَ كَالَّذي ذَكَروا","أَنتَ وَرَبّي مُعارِكٌ أَشِرُ",43,"ر",1,0],["أَذَهَبتَ يَوماً فَلَم تَعدُدهُ مَرزِيَةً","وَعُدَّ ذاهِبُ مالٍ مِن رَزاياكا",44,"ك",2,0],["أَذِهنِيَ طالَ عَهدُكَ بِالصِقالِ","وَماجَ الناسُ في قيلٍ وَقالِ",45,"ل",1,1],["إِذهَب إِلَيكَ فَإِنّي مِن بَني أَسَدٍ","أَهلِ القِبابِ وَأَهلِ الجُردِ وَالنادي",46,"د",2,0],["إِذ هُمُ مِن خَيرِ حَيِّ سُوقَةً","وَطِىءَ الأَرضَ بِسَهلٍ أَو جَبَل",47,"ل",1,0],["أَذهب صَبري اطراد دَهري","وَربما أَوجب اِنتحاري",48,"ر",2,0],["إذ هاجَموا يوم الوغى","غلب المدافع بالصفائح",49,"ح",1,0],["إذهبْ إِليها ودعْ ذمامي","فديتُكَ اسْلَمْ على التنائي",50,"ي",1,0],["اِذهَبوا فيهِ وَجيئوا إِخوَةً","بَعضُكُم خِدنٌ لِبَعضٍ وَخَليل",51,"ل",1,0],["إذهَبي إنَّ كُلَّ دُنيَا ضلالٌ","والأَمانِيُّ عُقرهُا لِلتَّبَابِ",52,"ب",1,1],["إذ هِيَ تَسبي النَّاظرِينَ وتَج","لُو واضِحاً كَالأُقحُوانِ رَتِل",53,"ل",1,0],["اذْهَبْ فَلَيْسَ يَضِيرُ غَيْرَ","قُلُوبِنَا هذَا الذِّهَابْ",54,"ب",1,0],["اِذهَب لَكَ اللَهُ جارُ","وَجَنَّةُ الخُلدِ دارُ",55,"ر",1,1],["اِذهَب بِحُسنِ عَزائي","فَلَيسَ عَنكَ اِصطِبارُ",55,"ر",1,0],["اِذهَب إِلى النارِ وَالعَذابِ فَما","خِلتُكَ إِلّا مِنَ الشَياطينِ",56,"ن",1,0],["إذهبي .. إذهبي إليه .. فبعدي","لن تعيش الدفلى ، ولا الجلنار",57,"ر",1,0],["أَذهَلتَني عَن أَن أَقومَ بِحَقِّها","يا واسِمي بِالعَجزِ حينَ يَجودُ",58,"د",1,0],["أَذهَلتَني عَن أَن أَقولَ وَإِنَّما","نابَت هِباتُكَ عَن لِساني فَاِسمَعِ",59,"ع",1,0],["إِذ هامُهُم كَالطَيرِ لاقَت مَشرَعاً","بَعضٌ مُحَلِّقَةٌ وَبَعضٌ وُقَّعُ",60,"ع",1,0],["إذ هم عبيد وأتباع سواسية","لا يرجعون إلى عقل ولا أدب",61,"ب",1,0],["أَذهبَ اللَّه رِجسهم فهم مِن","كلِّ عَيبٍ عاب الورى أبرياءُ",62,"ا",2,0],["اذهب وهبتُك للذين اخترتَهم","هبةَ الكريم فإنه لا يرجعُ",63,"ع",1,1],["اذهب فلستَ بنائلٍ ما رمتَه","حتى تُغَيَّب في الثرى مرموسا",64,"س",2,0],["إِذهب لكوخِك فَالسَلامُ مجسَّمٌ","فيهِ وَما ذا الوُجودِ سَلامُ",65,"م",1,0],["إِذهب إِلَيهِ فَسَوف تَأتي ساعَةٌ","فيها تَعُضُّ بنانها الظلّامُ",65,"م",1,0],["أَذهَلْنَني حتَّى ظَلِلتُ كأنّني","وأنا صريُع هَوىً صريعُ مُدام",66,"م",1,0],["أَذْهب ماءُ الحسن تَفْضِيضَها","فَجوَّد الخالق إذهابَه",67,"ب",2,0],["إذ هم لذي الجلال كانوا عَرَفَهْ","قلوبهم دوماً له مزدلفهْ",68,"ه",1,0],["أذهب سليماً ودعني آلفاً شجَني","فإن مثلي للأشجانِ من ألِفا",69,"ف",2,0],["إِذ هِيَ كَالرَشَإِ المَخروفِ زَيَّنَها","مُكَردَسٌ كَطِلاءِ الخَمرِ مَنظومُ",70,"م",1,1],["أذهبت غما وكرباً خيما","وأقاما في صدور حصرت",71,"ت",1,0],["اذهلاني عن حياتي","فغدوت في اضطراب",72,"ب",1,0],["إِذ هُنَّ عَن حَسَبي مَذاوِدُ كُلَّما","نَزَلَ الظَلامُ بِعُصبَةٍ أَغتامُ",73,"م",1,0],["إِذ هِيَ أَحوى مِنَ الرِبعِيِّ حاجِبُهُ","وَالعَينُ بِالإِثمِدِ الحارِيِّ مَكحولُ",74,"ل",1,0],["أذهَب الله عَنهمُ الرّجسّ حَتَّى","طُهّروا من بواطنِ الآثام",75,"م",1,0],["إذ هم قد حرموا تقليدنا","في الأصولين فعنه انعزل",76,"ل",1,0],["أَذهبت رونق ماء النُصحِ في العَذلِ","فاربَعَ فلستَ بِمَعصومِ عَن الزَلَلِ",77,"ل",1,1],["أذْهَبَتْ تَالِدي وطارِفِيَ الطَّا","ري فَضَاعَ المورُوثُ والمكسوبُ",78,"ب",1,0],["أَذْهَلْتَهَا بِعُلاكَ عَمَّا أَوْرَثَتْ","من مُلكِها آباؤُهَا وجدُودُها",79,"د",3,0],["اذهبت انوارها ذاك الدجى","وأعادت روح تلك الرمم",80,"م",1,0],["إذهب إلى دنيا الخيال ودع لنا","ما افتنّ شعرك شامخا بجلاله",81,"ل",2,0],["أَذهَبتَ دَمعي إِذ أَتاكَ مُفَضَّضاً","وَتَرَكتَ مِنهُ الأُقحُوانَ شَقيقا",82,"ق",2,0],["أَذهَبتُ فِضَّةَ خَدِّهِ بِعِتابي","وَنَثَرتُ دُرَّ دُموعِهِ بِخِطابي",83,"ب",2,1],["اِذ هبَّ معتلُّ النسيمِ عنِ الحمى","وشاقتكَ أسحارٌ وراقتكَ آصالُ",84,"ل",1,0],["اذهب الكاس فعرْف ال","فجر قد كاد يلوح",85,"ح",1,1],["أذهلتنا وكأن يقظتنا كرى","أبصارنا بخياله تتخيل",86,"ل",1,0],["أذهلَ العاشقينَ منها قَوامٌ","ما حَكى الغُصنُ في تَثنِّيه قَدَّا",87,"د",2,0],["اِذهبْ فزادك إنعامٌ ملكتَ به","رِقَّ الرّجال وقد زوّدتني حُرَقا",88,"ق",2,0],["أذهب امكفرَ بامهدايةِ فينا","وبه امنورُ لاح بعد امظلام",89,"م",1,0],["إذ هو الحي والعوالم موتى","يدّعون الحياة بالوسواس",90,"س",1,0],["أَذهَلتِ عَن عُقبى النَدى إِنَّ النَدى","لَيَرُدَّ وَحشِيَّ المُنى مَتَأَنِّسا",91,"س",2,0],["اذهَبْ طريقَك لستَ من أَرْبَابها","وارْجع وراءَك لسْتَ مِنْ أَصْحَابِها",92,"ب",3,0],["أذهب عني ذاك ما كنت أجد","من لذعة الحزن الشديد المعتمد",93,"د",1,0]]}