{"poems":[[65,"لك المجد لا ما تدعيه الأوائل","https://www.aldiwan.net/poem46184.html","الطويل"],[88,"بلغتك لم أنسب ولم أتغزل","https://www.aldiwan.net/poem68961.html","الطويل"],[74,"فديت محيا في مسائله ينمي","https://www.aldiwan.net/poem19669.html","الطويل"],[53,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[58,"أما والذي أصفاك مني مودة","https://www.aldiwan.net/poem58574.html","الطويل"],[45,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[30,"ويوم ترى جوزاؤه من ظلامه","https://www.aldiwan.net/poem5281.html","الطويل"],[82,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[46,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[107,"لئن ظهرت لنا رغبات قوم","https://www.aldiwan.net/poem42137.html","الوافر"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[147,"تسد إذا حم الحمام المذاهب","https://www.aldiwan.net/poem11729.html","الطويل"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[302,"ألا هل درت من أقصدت أسهم الهلك","https://www.aldiwan.net/poem33202.html","الطويل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[422,"متى أرى هذه الأيام مسعفة","https://www.aldiwan.net/poem54090.html","البسيط"],[443,"دعا عذلي لم يبق عقلا ولا لبا","https://www.aldiwan.net/poem2607.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[592,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63907","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63875","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49969","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109022","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108802","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75860","الطويل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46734","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65272","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89267","الوافر"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17667","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117844","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59477","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135617","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125818","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136577",""],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66102","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139553",""],[4940,"سطوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=205547",""],[5246,"لينظر في طلابه وهي عادة","https://www.poetsgate.com/ViewPoem.aspx?id=187049",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5353,"برقية عاجلة","https://www.poetsgate.com/ViewPoem.aspx?id=215398",""],[5480,"(( يا علي ))","https://www.poetsgate.com/ViewPoem.aspx?id=1588",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5790,"ألية بفتور الأعين النجل","https://www.poetsgate.com/ViewPoem.aspx?id=112116",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[6193,"فقا وانثرا دمعاً على التراب أحمرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55426&r=&rc=2",""]],"verses":[["لَئِنْ ظَهَرَتْ منهُ خَديعةُ ماكِرٍ","فسَيْفُكَ لا تَخفى عليه المَقاتِلُ",0,"ل",1,0],["لَئِن ظَفِرَ الإِفتاءُ مِنكَ بِفاضِلٍ","لَقَد ظَفِرَ الإِسلامُ مِنكَ بِأَفضَلِ",1,"ل",1,0],["لئن ظنّ ساعٍ أن ينالك في العلى","لقد حقّ عندي ذلك الظنّ بالرّجم",2,"م",1,0],["ليَ نظُم الثناء فيكم ولكن","لكُمُ الدرُّ منه والياقوتُ",3,"ت",1,0],["ليُنْظَمَ فيه ذلك الدرُّ سُلّكَتْ","مريرتُه والدرُّ في السلك يُنظَمُ",4,"م",1,0],["لَئِنْ ظَلَّ لي مِنْ فَقْدِ وَجْهِكَ مُوحِشٌ","لَقَدْ ظَلَّ لي مِنْ طُولِ ذِكْرِكَ مُؤْنِسُ",5,"س",1,0],["لَئِن ظَهَرَت فينا عَلَيهِ كَآبَةٌ","لَقَد ظَهَرَت في حَدِّ كُلِّ قَضيبِ",6,"ب",1,0],["لِيَنظُرنَ ما تَقضي الأَسِنَّةُ بَينَهُم","وَكُلُّ حُسامٍ غِمدُهُ قَد تَسَعسَعا",7,"ع",2,0],["لَئِن ظَفِرت تِلكَ الكِلابُ بأَكلِها","فبعد سكونٍ للعروقِ الضوارِبِ",8,"ب",1,0],["لَئِن ظَمِئَت أَجفانُ عَيني إِلى البُكا","لَقَد شَرِبَت عَيني دَماً فَتَرَوَّتِ",9,"ت",1,0],["لئن ظهرت لنا رَغَباتُ قومٍ","لقد ضاقَ التحفّظُ بالبقايا",10,"ا",3,1],["لئن ظَنُّوا بجالينوسَ شرّاً","لقد عَرفوا النَّطاسيَّ الأمينا",11,"ن",2,0],["لَئِن ظَعَنَ الأَحبابُ يا أُمَّ مالِكٍ","فَما ظَعَنَ الحُبُّ الَّذي في فُؤادِيا",12,"ي",2,0],["لَئِن ظَفِرَت أَيدي الخُطوبِ بِبُغيَةٍ","فَما زِلتَ تَفري وَالخُطوبُ الدَرائِبُ",13,"ب",1,0],["لئِن ظلَّ يوْمَ الحرْبِ للسيْفِ شَاهِراً","لَقَدْ بَاتَ لَيْل السلم والطّرْفُ سَاهِرُ",14,"ر",1,0],["لئن ظَلَّ صَبري عنك مُنفَصم العُرى","فَقَلبي من الأَحزان ليس بمُنفَكِّ",15,"ك",1,0],["لينظر فيها الناظرون فيعلموا","بها قدرة المنشئ لها خير قادر",16,"ر",1,0],["لئِنْ ظفرتُ بمحمودٍ وإخوته","ظَفِرْت من هذه الدُّنيا بمقصودي",17,"د",2,0],["لئن ظهرت آي ابن عمران في العصا","فآيات هذا في عذار له دبا",18,"ب",2,0],["لينظرا في اختلاف القول","واجعلوا الموعد رأس الحول",19,"ل",1,0],["لينظروا الحكم عل المجاز","وفرقة سارت إلى الأهواز",19,"ز",1,0],["لئن ظهرت منا عليه كآبةٌ","وحل بنا خطبٌ من الرزء شاجيا",20,"ي",2,0],["لئن ظلَّ عندي من صدودكَ مأتمٌ","لما زِلْتُ دهراً من وصالِكَ في عرس",21,"س",1,0],["لئن ظلَّ من وجده مُثْرياً","لقد ظلَّ من صبرِه مُفْلِسا",22,"س",2,0],["لئن ظفرتْ كفّايَ من فضل ما لهم","فأعراضهم يا صاح من مدَحيّ صفْرُ",23,"ر",1,0],["لينظر مليك الروس حال بلاده","ويحكم حكماً لا يكذِّبه النقل",24,"ل",1,0],["لينظر ذوو الإنصاف حالَ بلادهِ","ويأتوا بحكمٍ لا يكذِّبه النقل",25,"ل",1,0],["لَئِن ظَهَرت في مُقلةِ الحب حُمرَةٌ","فَما ذاكَ داءٌ يُختشى مِن بَقائِهِ",26,"ه",1,1],["لَئِن ظَلَّ عَبدُكَ فيها الغَريق","فَجودُكَ من قَبلِ ذا أَغرَقَه",27,"ق",2,0],["لئن ظهرت بالجسم منك طوالعُ","ففيها ذليلٌ عن كمالك قاطعُ",28,"ع",1,1],["لئن ظهرت نكايتهم بحصر","ففتحك عنوة بالسيف أنكى",29,"ك",2,0],["لَئِن ظَفِرِتُم بِشَيخٍ مِن مَشايِخِنا","لا يَحمِلُ الرُمحَ وَالصَمصامَةَ الذَكَرا",30,"ر",2,1],["لئن ظفروا من هذه الدار بالذي","أرادوا فإن المرء يحصد ما ذرا",31,"ر",2,0],["لئن ظعنتْ بالأمس راية إني","لنفسي على آثارِ رايةَ باخعُ",32,"ع",1,0],["لينظر ما هو الشمس المنيرُ","مع الصدق الضياء المستبينُ",33,"ن",1,0],["لئن ظهرت للشرق فينا ممالك","فمن حوله دارت عظامُ المصاعب",34,"ب",1,0],["لئن ظنَ السوء فيّ رَفيبه","فشأني عمّا ظَن أعلى وأرفَع",35,"ع",1,0],["لَئِنْ ظَلْتُمُ شَتَّى القُلوبِ تَهِيضُكُمْ","مَذاهِبُ تَرْمِي الوِفاقِ المَرامِيا",36,"ي",2,0],["لئن ظفرت فيه يد الموت وانثنى ال","ردى من دماه وهو دامى المخالب",37,"ب",1,0],["لي نظرةُ الموتِ في يوم الوداعِ ولي","حقائبُ الحبِ في أوصالها اللَّهفُ",38,"ف",1,0],["لينظر في طلابه وهي عادة","له كل عام ليس ينفك آتيا",39,"ي",2,0],["لئن ظنَّ فيكَ الخائبون ستنطوي","فأنت كتابُ الله مازال موعدا",40,"د",2,0],["لئن ظن َّ فيك الأقربون ستنثني","وكنتَ انتصرتَ لهم رواحاً ومغتدى",41,"د",2,0],["لي نظرته فذيك لأسفاري","شل عقلي والقلب تله",42,"ل",2,0],["لينظر الحكيم في تعليمه","وفيلسوف العلم ثم ليحكم",43,"م",1,0],["لئن ظفرت بلقياكم وفزت به","ما استشرفت بعدها نفسي إلى أمل",44,"ل",1,0],["لئن ظلتمُ حزبَ القطيعةِ والنّوى","فإنّ الجوى والشّوقَ أمسى لنا حزبا",45,"ب",2,0],["لئن ظفروا من هذه الدار بالذي","أرادوا فإن المرء يحصد ما ذروا",46,"ر",3,0]]}