لهَا أنّي بِهَا مُغرَمٌ صَبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=31583",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[91,"ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=53271",""],[51,"أحمدُ اللَّه مُبدِئاً ومُعيد","https://www.poetsgate.com/ViewPoem.aspx?id=27043",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[29,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""],[20,"لمن الدار تعفت بخيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70000&r=&rc=22",""],[20,"سما صقر فأشعل جانبيها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69762&r=&rc=3",""],[88,"نجيت بالسد بغداداً من الغرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19538&r=&rc=41",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""]],"verses":[["وَثَبوها وَغَيرُهُم","صَعِدوها مَراقِيا",0,"ي",2,0],["وَثِلَّةِ حَيٍّ قَد أَضَبَّ بِأَرضِها","ذُؤالَةُ إِضبابَ الغَريمِ المُدايِنِ",1,"ن",1,0],["وَثَنَتهُم بَعدَ الجِماحِ المَنايا","في عِنانِ التَسليمِ وَالإِذعانِ",2,"ن",1,0],["وَثَمَّ أَوعِيَةُ الإِحسانِ مُكفَأَةٌ","فَوارِغٌ وَوِعاءُ الشَرِّ مَلآنُ",3,"ن",1,0],["وَثَنايا اليَومِ يُضحِكُها","مِن قُدومِ العيدِ تَقبيلُ",4,"ل",1,0],["وَثَمَّ الحُماةُ الذائِدونَ عَنِ الحِمى","عَشيَّةَ لا يَحمي النِساءَ بُعولُها",5,"ل",3,0],["وَثَاروا إِلى نِضْوي يُفَدُّونَ فَوْقَهُ","أُشَيْعِثَ يُدْعَى لِلندى فَيُجيبُ",6,"ب",1,0],["وثاروا إِلى رَحْلي تَحُلُّ نُسوعَهُ","أنامِلُ صِيغَتْ للظُّبا والمَواهِبِ",7,"ب",1,0],["وَثَمانونَ مَن تَميمٍ بِأيدي","هم رِماحٌ صُدُورُهُنَّ القَضاءُ",8,"ا",2,0],["وَثَنى لَهُ تَحتَ الغُبارِ يَجُرُّهُ","جَرَّ المُفاشِغِ هَمَّ بِالإِرآمِ",9,"م",1,0],["وثقّفْتَ منْ سُمْرِ الرِّماحِ ذَوابِلاً","بأقْلامِها فِيهِمْ تُخَطُّ الوَقائِعُ",10,"ع",1,0],["وثامِنُ أمْلاكِ الجِهادِ أقامَني","فألْبَسَني عِزّاً ورفّعَ لي قَدْرا",11,"ر",2,0],["وثامِنُ أمْلاكِ الجِهادِ أقامَني","مطيَّةَ سِلْمٍ في مَحَلِّ جِهادِ",12,"د",1,0],["وَثَنى الكَفَّ عَلى ذي عَتَبٍ","يَصِلُ الصَوتَ بِذي زيرٍ أَبَح",13,"ح",1,0],["وَثَديانِ كَالرُمّانَتَينِ وَجيدُها","كَجيدِ غَزالٍ غَيرَ أَن لَم يُعَطَّلِ",14,"ل",1,0],["وَثَمانينَ عِشارٌ كُلُّها","آرِكاتٌ في بَريمٍ وَحَضَن",15,"ن",1,0],["وَثُغوراً هِيَ أَبهى مَنظَراً","مِن ثُغورِ الغيدِ يُبدينَ اِبتِساما",16,"م",2,0],["وَثُلَّت عُروشٌ وَاِستَقَرَّت مَمالِكٌ","وَلَو أَنَّ ذا القَرنَينِ فيها يُناصِبُه",17,"ب",2,0],["وَثِقَت بِكَ الثِقَةَ الَّتي لَم يَنفَرِج","لِلرَيبِ فيها وَالشُكوكِ سَبيلُ",18,"ل",1,0],["وَثَلَّةٍ صَبَّحَها بَأسُهُ","أَعدمَها الوِردَ وَرعيَ الكَلا",19,"ل",2,0],["وَثابِتُ الرَأيِ أَغنَت أَلمَعِيَّتُهُ","عَن أَن يُشارِكَهُ في رَأيِهِ الوُزَرا",20,"ر",2,0],["وَثَناءٌ أَرسَلتُهُ سَلوَةَ الظاعِنِ","عَن شَوقِهِ وَلَهوَ المُقيمِ",21,"م",1,0],["وَثَناءَ مُحتَفِلٍ كَأَنَّ ثَناءَهُ","مِسكٌ بِأَردانِ المَحافِلِ صاكا",22,"ك",2,0],["وَثَدياً مِثلَ حُقِّ العاجِ رَخص","حَصاناً مِن أَكُفِّ اللامِسينا",23,"ن",2,0],["وَثَعلَبَةُ الرَوعِ قَد عايَنوا","خُيولاً عَلَيها أُسودُ الأَجامِ",24,"م",1,0],["وثوب إلى كشف الظلامات ساكن","إلى بأسه في حين لا تأمن الأسد",25,"د",1,0],["وَثَالِثَةٌ لاَحَ تَخْطِيطُهَا","وَتَشْيِيدُهَا غير نَائِي الأَوَانِ",26,"ن",1,0],["وَثَوَى رَهِينَ قَرَارَةٍ مَيَّادَةٍ","لا يَسْتَقِرُّ بِهَا الدَّفِينُ النَّائِمُ",27,"م",1,0],["وَثَغْرٌ كَمَا شَفَّتْ عَنِ الرَّاحِ كَأْسُهَا","يُتَوِّجُهَا رُدُّ الْحَبَابِ مُنَظَّمَا",28,"م",2,0],["وَثَنَى الأَمِيرُ فَقَالَ مَا تَأْوِيلُهَا","أَكَذَا مِزَاحُ الصَّائِمِينَ القُوَّمِ",29,"م",1,0],["وَثَبَ الزَمانُ بِكُم فَشَتَّ","تَ مِنكُمُ ما أُلِّفا",30,"ف",2,0],["وَثالِثَةٌ تَهوي مِنَ الشامِ حَرجَفٌ","لَها سَنَنٌ فَوقَ الحَصى بِالأَعاصيرِ",31,"ر",1,0],["وَثبَ المُسَحَّجِ مِن عاناتِ مَعقُلَة","كَأَنَّه مُستَبانُ الشَكِّ أَو جَنِبُ",32,"ب",1,0],["وثلمة السدّ كالمهواة واسعة","يهوي بها السيل من فوق إلى العمق",33,"ق",1,0],["وثرتم أسوداً في الوغى يعرُبيّةً","غدا كل سيف في براثنها ظُفرا",34,"ر",2,0],["وثقّفوهم بتدريب وتبصِرة","ثقافة تجعل المُعوَجّ معتدلا",35,"ل",2,0],["وثغور الضلال مبتسمات","ووجوه الهدى عليها مُحول",36,"ل",1,0],["وَثَغرٍ قَد شَهِدتَ فَلَم تُضِعهُ","وَلَولا ما شَهِدتَ لَكانَ ضاعا",37,"ع",2,0],["وَثِنتانِ في الحَجّاجِ لا تَركُ ظالِمٍ","سَوِيّاً وَلا عِندَ المُراشاةِ نائِلُ",38,"ل",1,0],["وَثِقنا بِالنَجاحِ إِذا بَلَغنا","إِمامَ العَدلِ وَالمَلِكَ الهُماما",39,"م",2,0],["وَثَلاثٌ يُرِدنَ تَيماءَ رَهو","وَثَلاثٌ يُغرَرنَ بِالإِعجابِ",40,"ب",1,0],["وَثَوبٍ كُنتُ أَلبَسُهُ أَنيقٍ","أُجَرِّرُ ذَيلَهُ بَينَ الجَواري",41,"ر",2,0],["وَثانِيَ اِثنَينِ في الغارِ المُنيفِ وَقَد","طافَ العَدُوُّ بِهِ إِذ صَعَّدَ الجَبَلا",42,"ل",2,0],["وثناه عن عذلِ العواذِل في الندى","رأيٌ يرى أن السماح رباح",43,"ح",1,0],["وثغرٌ يتيم الدّرّ سلّمَ مهجتي","فأتلفها من قبل ما ثبت الرّشد",44,"د",1,0],["وثنايا أخذْنَ في ريقها الخم","ر وأعطين العقول الخمارا",45,"ر",2,0],["وثغرك يشهد مسواكه","فأعدِلْ به شاهداً يسكر",46,"ر",1,0],["وثنا أشغل الشفاهَ بذكرا","هُ فما لامرئٍ من الذكر نبزه",47,"ز",2,0],["وثقت بتنكيد الفراق فأسبلت","جفوني وعجلت الذي أتوقع",48,"ع",1,0],["وثناً يشفّ ضياؤه فكأنما","في أعين الأعداءِ منه أشافي",49,"ف",2,0],["وثغر يعير الجوهريّ صحاحه","ووجه له من رائق الحسن مجمل",50,"ل",1,0],["وثابت الودّ لديغ الحشا","يأتي إلى الله بقلبٍ سليم",51,"م",1,0],["وثقوا أن غدوا ضيوفاً لإبرا","هيمَ أن النجاح حول مقامهْ",52,"م",2,0],["وثناً يقيد بالمدائح ذكره","فتراه ينجد في البلاد ويتهم",53,"م",1,0],["وثنى للعلى عزائم أضحت","فوق ما يطنب البليغ ويثني",54,"ي",1,0],["وثقت بجودِهِ فرأيتُ مالا","أرى من غيره وكنزت مالا",55,"ل",2,0],["وثبتْ تَستقربُ النجم مجالا","وتهادتْ تسحبُ الذيلَ اختيالا",56,"ل",2,1],["وثَكِلْتُ الشبابَ بعد رضاعٍ","كان قبلَ الغِذاء قِدْماً غذاءَ",57,"ا",2,0],["وثَبيتُ المَقام في الموقف الدَّح","ض إذا ما أضاق رحبُ الفضاءِ",58,"ا",2,0],["وثب السِّعرُ وثبةً فاستحلّوا","رَجْمَ قاضٍ وكان ذاك عجيبا",59,"ب",2,0],["وثنى إليه عن الخلي","فة وجهَ ممتاح وعَنْسِه",60,"س",2,0],["وثنَى بابنه السفيه المعنَّى","بأساطير أرسطَاطاليس",61,"س",1,0],["وثبَتْ عليه عِصابةٌ كُوفيةٌ","ببوادرٍ من بأسِها وفوارِط",62,"ط",1,0],["وثبوا عليّ سفاهةً فوسْمتُهُم","وسمَ المسطِّع بعد وسم العالط",62,"ط",1,0],["وثنى النيل نحو مسلكه الأر","شد لما اعتدى وجار فسوقا",63,"ق",2,0],["وثُدِيٌّ ناهداتٌ","لم يُخَضِّدها العناقُ",64,"ق",1,1],["وثقيل جليسُه في سباقِ","ساعة منه مثل يوم الفراقِ",65,"ق",1,1],["وثناءُ مثلي غيرُ مُطَّرحٍ","وسؤالُ مثلِك غير مُتَّركِ",66,"ك",1,0],["وثبْتَ على الهزبر وأنت كلبٌ","ولم تحسِبْه ينشطُ لافتراسِكْ",67,"ك",1,0],["وثَّبَ الدهرَ وَثْبَةً جشَّمَتْنِي","سَلَّ سَيْفٍ عَمِرتُ دهراً أصونه",68,"ن",2,0],["وثقيلٌ عليَّ ردُّ القوافي","لا بِوتري ولا بشكرٍ ثمين",69,"ن",1,0],["وثقيلٍ كأنه ثِقْلُ دينِ","تتقذاه طالعاً كلُّ عينِ",70,"ن",1,1],["وَثَبَّتَ الوَطءَ مِنّي عِندَ مُضلِعَةٍ","حَتّى تَخَطَّيتُها مُستَرخِيَ اللَبَبِ",71,"ب",1,0],["وَثَقيلٍ كَأَنَّهُ بَردُ كانو","نٍ قَليلَ الحَياءِ جَمَّ الكَلامِ",72,"م",1,1],["وَثَناهُ الضَعفُ عَن حَملِ القَناة","وَعَنِ السابِقِ في حَلبَتِهِ",73,"ه",1,0],["وَثَقيلٍ إِذا بَدا","أَكثَرَ الناسُ لَعنَهُ",74,"ن",2,1],["وَثَقيلٍ ما بَرِحنا","نَتَمَنّى البُعدَ عَنهُ",75,"ه",1,1],["وَثَقيلٍ كَأَنَّما","مَلَكُ المَوتِ قُربُهُ",76,"ب",2,1],["وَثَوبُ بَشيرٍ إِذا تَخطِرُ","وَذاتِ هَبابٍ صَموتِ السُرى",77,"ر",2,0],["وثارتِ الجنّ والأملاكَ ناقمةً","والبحرُ والبَرُّ والأفلاكُ والعُصرُ",78,"ر",1,0],["وثلوجٍ وضبابٍ عَابرٍ","وأَعاصيرَ وأَمطارٍ تجودْ",79,"د",1,0],["وثناء على فتى عم قوما","قيمةُ العقد حسن بعض اللآلى",80,"ل",2,0],["وثوان أخف منها العوالي","كل عضو ببعضها مقتول",81,"ل",1,0],["وَثار لِلثارات زَيدُ بِن عَلي","بِن الحُسين بِن الوَصيِّ المُرتَضى",82,"ا",1,0],["وَثباً مِن الخَوارجِ الشِدادِ","إِلى بَني أُميَة اللدادِ",83,"د",1,0],["وَثَلاثَةٍ شَبَّ الزَمانُ حِيالَها","شُمٍّ عَلى مَرِّ الزَمانِ كِبارِ",84,"ر",1,0],["وَثِق بِالنَفسِ في كُلِّ الشُؤونِ","وَكُن مِمّا اِعتَقدتَ عَلى يَقينِ",85,"ن",1,0],["وَثَبَت بِقَومٍ يَضمِدونَ جِراحَهُم","وَيُرَقِّدونَ نَوازِيَ الآلامِ",86,"م",1,0],["وَثِمارٍ في يَواقيتِ الرُبى","وَسُلافٍ في أَباريقِ الذَهَب",87,"ب",1,0],["وَثِبوا لِلعِزِّ مِن صَهوَتِها","وَخُذوا المَجدَ عِناناً فَعِنانا",88,"ن",2,0],["وَثاروا فَجُنَّ جُنونُ الرِياحِ","وَزُلزِلَتِ الأَرضُ زِلزالَها",89,"ل",3,0],["وَثَنَيتَ عَن كَدَرِ الحِياضِ عِنانَهُ","إِنَّ الأَديبَ مُسامِحٌ وَمُداري",90,"ر",2,0],["وَثِقتُم وَاِتَّهَمتُم في اللَيالي","فَلا ثِقَةً أَدَمنَ وَلا اِتِّهاما",91,"م",2,0],["وَثَبنا يَضيقُ السَهلُ عَن وَثَباتِنا","وَتَقدُمُنا نارٌ إِلى الرومِ أَوثَبُ",92,"ب",1,0],["وَثِقْتَ بالكَأْسِ وشُرَّابِها","وحَتْفُ أَمْثالِكَ في الكاسِ",93,"س",1,0],["وَثِقنا بِأَن تُعطي فَلَو لَم تَجُد لَنا","لَخِلناكَ قَد أَعطَيتَ مِن قُوَّةِ الوَهمِ",94,"م",1,0],["وثلَّمتُ سيفي في رؤوسٍ وأذرُعٍ","وحطّمتُ رمحي في نحورٍ وأضلُع",95,"ع",1,0],["وثالثها فرد وإن جلّ ذكره","ولا بد للاثنين من ذلك الفردِ",96,"د",1,0],["وَثابَ إِلَيهِم رَأيُهُم فَتَبَيَّنوا","عَلى حالِ فَوتٍ أَنَّ مَركَبَهُم صَعبُ",97,"ب",1,0],["وَثَنى خَدَّهُ إِلَيَّ عَلى خَو","فٍ فَقَبَّلتُ جُلَّناراً وَوَردا",98,"د",2,0],["وَثَنى مُعلَماً إِلى طَبِرِستا","نَ بِخَيلٍ يَمرَحنَ تَحتَ اللُبودِ",99,"د",1,0],["وَثَنينَ نَحوَ قُصورِ يَثرِبَ آخِذاً","مِنهُنَّ سَيرُ مُغَلِّسٍ وَمُهَجِّرِ",100,"ر",1,0],["وَثَوى أَخوكَ وَقَد تَوافى عِندَهُ","كَرَمُ الكِرامِ وَبَأسُ أَهلِ الباسِ",101,"س",1,0],["وَثُغورٌ كَأَنَّها اللُؤلُؤُ الرَط","بُ أَوِ الأُقحُوانُ يَهتَزُّ غَضّا",102,"ض",2,0],["وَثَنى العُداةَ إِلَيهِ عَفوٌ لَو وَنى","لَثَنَتهُمُ غَصباً إِلَيهِ سُيوفُهُ",103,"ف",2,0],["وَثِقتُ بِنُعماهُ وَلَم تَجتَمِع بِها","يَدي وَرَأَيتُ النُجحَ قَبلَ سُؤالِهِ",104,"ل",2,0],["وَثاوٍ بَكَتهُ المَكرُماتُ وَإِنَّما","تُبَكّي عَلى الثاوي النِساءُ الثَواكِلُ",105,"ل",1,0],["وَثُكلٌ لَوَ اَنَّ الشَمسَ تُمنى بِحَرِّهِ","لَأَحرَقَها في جانِبِ الأُفقِ جاحِمُه",106,"م",2,0],["وَثُكلُ اِبنِهِ موفٍ عَلى ثُكلِ نَفسِهِ","فَما كانَ إِلّا صَبرُهُ وَعَزائِمُه",106,"م",2,0],["وَثَنى إِلى عُلوِ الجَزيرَةِ خَيلَهُ","مُتَمَطِّراتٍ في العَجاجِ الأَقتَمِ",107,"م",1,0],["وَثَلاثَةٌ تَغشاكَ إِمّا زُرتَهُ","إِرفادُهُ وَالبِرُّ وَالإِكرامُ",108,"م",1,0],["وَثَلاثَةٌ قَد جانَبَت أَخلاقُهُ","مِنها البَذا وَالزورُ وَالآثامُ",108,"م",1,0],["وَثَلاثَةٌ في الغُرِّ مِن أَفعالِهِ","تَدبيرُهُ وَالنَقضُ وَالإِبرامُ",108,"م",1,0],["وَثِقتُ بِسَعدٍ فَما أَفلَحَت","أَمانَةُ سَعدٍ وَلا خَونُهُ",109,"ن",2,1],["وَثَغرٍ تَحاماهُ العَدُوُّ كَأَنَّهُ","مِنَ الخَوفِ ثَأرٌ لا تَنامُ مَقانِبُه",110,"ب",2,0],["وَثِقتُ إِذا لاقَت بِلالاً مَطِيَّتي","لَها بِالغِنى إِن لَم تُصِبها شَعوبُها",111,"ب",3,0],["وَثِقتُ لَهُ بِالخِزيِ لَمّا رَأَيتُهُ","عَلى البَغلِ مَعدولاً ثِقالاً فَرازِلُه",112,"ل",2,0],["وَثارَ بِقَتلِ اِبنِ المُهَلَّبِ خالِدٌ","وَفينا بَقِيّاتُ الهُدى وَإِمامُها",113,"م",3,0],["وَثالِثُهُنَّ المُهتَدى بِبَياضِهِ","إِلى الخَيرِ في لَيلٍ وَساريهِ مُظلِمُ",114,"م",1,0],["وثَقَّبَ للأَعناقِ دُرّاً مُفَصَّلاً","ونَشَّرَ للأعطافِ وَشْياً مُسَهَّما",115,"م",2,0],["وَثَنى خيلَه إلى الغَربِ سَعياً","لا بساتٍ من العَجاجِ جِلاَلا",116,"ل",2,0],["وثَناءً زُفَّتْ إليكَ عَذارا","هُ فليسَت مَرُوعةً بِطَلاقِ",117,"ق",1,0],["وثَنَى الجِيادَ يَشُقُّ جَيْبَ عَجاجِها","ومضَى السُّيوفَ فينثني مَشقوقا",118,"ق",2,0],["وثَقيلُ حِلمٍ منه أصبحَ كامِناً","في حَدِّ مَصقولِ الذُّباب خَفيفِ",119,"ف",1,0],["وثانيةٌإنَّ ابنَ عمِّكَ شافعي","ولو ناشدَ الغَيْثَ استهَلَّ فأسرَعا",120,"ع",2,0],["وثَنى الرَّجاءُ إلى ابنِ فَهْدٍ عِطْفَه","فغدا على رَبْعِ المكارمِ رابِعا",121,"ع",2,0],["وثَنَتْ إليهم أَوجُه النْ","كَبَاتِ باسلةً عَوابِسْ",122,"س",1,0],["وثَرىً يَشهَدُ بالطِّيبِ له","عَبَقٌ حالفَ أطرافَ الأُزُر",123,"ر",1,0],["وثَنَيْتَ الخيلَ عنه لابِساً","حُلَّةَ النَّصْرِ مُحلٍّى بالظَّفَر",123,"ر",1,0],["وثَرىً كأنَّ رُباه تَنشُرُ حَلْيَها","ما بينَ حُرِّ تِلاعِه ووِهادِه",124,"د",2,0],["وثَبْتٌ إذا ما اللَّيالي انبرَتْ","بريحٍ سمائمُها الجِرِبْياءِ",125,"ا",2,0],["وَثاروا بِها مِن جانِبَيها كِلَيهِما","وَجالَت وَإِن يُجشِمنَها الشَدَّ تَجهَدِ",126,"د",1,0],["وَثِقلٌ عَلى الأَعداءِ لا يَضَعونَهُ","وَحَمّالُ أَثقالٍ وَمَأوى المُطَرَّدِ",126,"د",1,0],["وَثُلثُ النِصفِ آمالٌ وَحِرصٌ","وَشُغلٌ بِالمَكاسِبِ وَالعيالِ",127,"ل",1,0],["وَثِقلُ الحَقِّ أَحياناً","كَمِثلِ الجَبَلِ الراسي",128,"س",2,0],["وَثِقتُ بِأَيّامي عَلى غَدَراتِها","وَلَم تُعطِني الأَيّامُ مِنهُنَّ مَوثِقا",129,"ق",2,0],["وَثَوبُ الثَرى بِالزَعفَرانِ مُعَطَّرٌ","وَلِلريحِ ذَيلٌ بِالرِياضِ مُمَسَّكُ",130,"ك",1,0],["وَثِق أَنَّ رَبَّ العَرشِ جَلَّ جَلالُهُ","غَفورٌ رَحيمٌ لِلسَرائِرِ مُدرِكُ",130,"ك",1,0],["وَثَنوا قُدوداً رَخصَةً فَكَأَنَّما","هَزّوا غُصوناً فَوقَهُنَّ بُدورُ",131,"ر",1,0],["وَثِقتَ بِأَنَّ قَلبي مِن حَديدٍ","وَفيهِ عَلى الهَوى بَأسٌ شَديدُ",132,"د",1,1],["وَثَعلَبُ الصُبحِ وافى فاغِراً فَمَهُ","إِذ قابَلَتهُ الثُرَيّا شِبهَ عُنقودِ",133,"د",1,0],["وثارت حيرتي الهوجا","ء بين الفجر والعفه",134,"ه",1,0],["وثارت آه من ثور","ة هذي اللهفة الحرّى",134,"ر",2,0],["وثكالى يَنْدُبْنَ منك بحزْنٍ","خَيْرَ نَدْبٍ مُهَذَّبٍ ألمَعِيِّ",135,"ي",1,0],["وثنى الجريحُ عنانه فكأنّما","خُلِعَتْ عليه معاطف النشوانِ",136,"ن",1,0],["وثارَ بركضِ شُزَّبِها قَتامٌ","خَلَعْنَ به الصريمَ على الصريمِ",137,"م",1,0],["وثابِتَةِ الوَقفَينِ جَوّالَةِ القُرْطِ","أصَبْتُ رشَادي في هواها ولم أُخطْي",138,"ي",1,1],["وثنايا يضاحكُ الشمسَ منها","في مُحَيّاكِ كوكبٌ يستنيرُ",139,"ر",1,0],["وثَنى الرَّدى عنهُ الرَّدى جَزَعاً","وسَعَتْ على غيراتهِ غِيَرُ",140,"ر",1,0],["وثمارٌ نَطَقَتْ أوصافها","بإِشاراتٍ إِلى صُغرِ النُهود",141,"د",1,0],["وَثَنَت مَليحَاتُ التَلَفُّتِ سَلْوَةً","عَن شَخصِه الألحاظَ والأَجيادَا",142,"د",2,0],["وَثَلاثَةِ الشَجَرِ الجَنِيِّ تَكافَأَت","أَفنانُها وَثِمارُها وَأَرومُها",143,"م",3,0],["وَثَلاثَةِ الدَلوِ اِستُجيدَ لِماتِحٍ","أَعوادُها وَرِشاؤُها وَأَديمُها",143,"م",3,0],["وَثَلاثَةِ القِدرِ اللَواتي أَشكَلَت","أَأَخيَرُها ذو العِبءِ أَم قَيدومُها",143,"م",3,0],["وَثَنائي مِن قَبلِ هَذا وَمِن بَع","دُ وَشُكري غَضٌّ لِعَبدِ السَلامِ",144,"م",1,0],["وَثَوى الرَبيعُ بِها فَلَيسَ يُقِلُّهُ","عَنها نَئيحُ سَمومِ قَيظٍ مُعصِفِ",145,"ف",1,0],["وَثَناياكِ إِنَّها إِغريضُ","وَلِآلٍ تومٌ وَبَرقٌ وَميضُ",146,"ض",1,1],["وَثَمودُ لَو لَم يُدهِنوا في رَبِّهِم","لَم تَدمَ ناقَتُهُ بِسَيفِ قُدارِ",147,"ر",1,0],["وَثَنَوا عَلى وَشيِ الخُدودِ صِيانَةً","وَشيَ البُرودِ بِمُسجَفٍ وَمُمَهَّدِ",148,"د",1,0],["وَثارَ نَقعُ المَنايا في مَعُونَةَ مِن","بَني سُلَيمٍ بِأَهلِ الفَضلِ وَالحِكَمِ",149,"م",1,0],["وثغرُكَ جوهريُّ النظمِ يُعزى","غريبُ الحسنِ فيهِ إلى الصحاحِ",150,"ح",1,0],["وثغرُ الأقاحيَ مستضحكٌ","لهمْ فيهمُ قسمة العادلِ",151,"ل",1,0],["وَثَنى صَبابَةَ قَلبِهِ بَعدَ البِلى","وَرَقاءُ ظَلَّت في الغُصونِ تَرَنَّمُ",152,"م",1,0],["وَثيراتُ أَعجازٍ دِقاقٌ خُصورُها","طَويلاتُ أَعناقٍ ثِقالُ الرَوادِفِ",153,"ف",1,0],["وَثَنايا يَكرَعُ المَل","هوفُ فيهِنَّ كُروعا",154,"ع",2,0],["وَثَغرٍ واضِحٍ رَتِلٍ","تَرى في خَدِّهِ أَشَرا",155,"ر",2,0],["وثِقِي بربِّكِ إنّه لكِ ناصرٌ","ما مِثلُه من ناصرٍ أو والِ",156,"ل",1,0],["وثب العدلُ يُوالِي صَيْدَهُ","وهو ظُلمٌ فاتِكٌ إن لم يَصِدْ",157,"د",1,0],["وَثَغرٌ ما أَرى أَم نَظمُ دُرٍّ","وَلَحظٌ ما حَوى أَم صارِمانِ",158,"ن",1,0],["وَثَنائي حَدائِقٌ وَعُلاهُ","هَضَباتٌ وَجودُهُ أَنهارُ",159,"ر",1,0],["وَثمَ رمانة قَد اِضطَرَبَت","وَاِقتَرَبَت تربُها تَحذّرها",160,"ر",3,0],["وَثَغرٌ عَلَيهِ الظُلمُ يَجري كَأَنَّهُ","إِذا اِبتَسمَت مِن كَثرَةِ الماءِ يَنطفُ",161,"ف",1,0],["وَثَغرٍ لا يُقامُ بِهِ كَفَوكُم","وَلَم يَكُ دونَهُم فيكُم كِفاءُ",162,"ا",2,0],["وَثابِتٍ إِلى الأَمامِ يَعدو","وَذُلُّهُ مِن قَبلِهِ أَشَدُّ",163,"د",1,0],["وَثَلاثٌ حَنَّت لِنَوءِ رَمادٍ","يَأكُلُ الصُبحُ جَمرَهُ وَالعَشِيُّ",164,"ي",1,0],["وَثَبتَ إِلَيهِ وَثبَةً أَسَدِيَّةً","طَوَت خَبَراً وَاِستَأثَرَت بِعُلومِ",165,"م",1,0],["وَثَنَيتُ أَعناقَ الحَوى نَحوَ العُلى","وَرَأَيتُ شَأوَ العاشِقينَ طَويلا",166,"ل",2,0],["وَثَنى أَعِنَّتَهُ وَلَو حَضَرَ الوَغى","كانَت دِمائُهُمُ كَنَفثَةِ باصِقِ",167,"ق",1,0],["وَثَنَاءٌ قَدَّمْتَ بينَ يَدَيْ نَجْ","وَايَ إذْ لم يكن لَديَّ ثَراءُ",168,"ا",2,0],["وثَغْرُ مُعَمِّرٍ عُمراً طويلاً","تُوُفّي وهوَ مَنْضُودٌ شَنيبُ",169,"ب",1,0],["وَثَنَوْا أَعِنَّتَهُمْ وقد تَرَكُوا العِدا","بالطَّعْنِ بَيْنَ مُجَدَّلٍ ومُقَدَّدِ",170,"د",1,0],["وَثَنَّتْ بأخبارِ النبيِّ رُواتها","وكلّ بأخْبَارِ النبيِّ خَبِيرُ",171,"ر",1,0],["وثَلَّثَ يدعو اللَّهَ فيها مُوَحِّدٌ","ذَكُورٌ لِنَعْمَاءِ الإِلهِ شَكُورُ",171,"ر",1,0],["وثَنَتْ إلى الدنيا بأُخرى مثلِها","فتقسَّمَتْ في النّاسِ وهي نَوافل",172,"ل",1,0],["وثار بِرَيّا المندليِّ غبارُهُ","ونُشِّرَ فيه الروضُ والروضُ مُوقِع",173,"ع",1,0],["وثمارُها من عِظْلِمٍ أو أيْدَعٍ","يَنَعٍ فليس لها سواه ثِمار",174,"ر",1,0],["وثُقِّفَ ثَثْقيفَ الرُّدَيْنيِّ قبلَهَا","وما الطِّرْفُ إلاّ أن يُهذِّبَهُ الضُّمر",175,"ر",1,0],["وثنَّيْتَها بالكُتْبِ من كلِّ مُدْرَجٍ","كأنَّ جميعَ الخيرِ في طَيّهِ سَطْر",175,"ر",1,0],["وثلاثةٌ لم تجتمِعْ في مجلِسٍ","إلاّ لمثلِكَ والأديبُ أريبُ",176,"ب",1,1],["وثغْرٌ بأطرافِ الشآمِ مضَيَّعٌ","وتفريقُ أهواءٍ مِراضٍ وتخريب",177,"ب",1,0],["وَثِيابي تَجُرُّ مِنّي عِظاماً","لا سُكونٌ لَها وَلا حَرَكاتُ",178,"ت",1,0],["وَثَنّى لآلافِها الغادِراتِ","فَكَمَّلَ عَشراً بِها العِدَّه",179,"د",2,0],["وَثِقتُ بِعَفوِ اللَهِ عَن كُلِّ مُسلِمٍ","فَلَستُ عَنِ الصَهباءِ ما عِشتُ مُقصِرا",180,"ر",2,0],["وَثانِياً إِن قُلتَ إِنّي الَّذي","أَسلاكَ إِن شَطَّت بِكَ الدارُ",181,"ر",1,0],["وَثَنى يُغَنِّنا مُعارِضَهُ","لِمَنِ الدِيارُ بِجانِبَي لَجسِ",182,"س",1,0],["وَثُلثا ثُلثِ ما يَبقى","وَثُلثُ الثُلثِ لِلساقي",183,"ي",1,0],["وَثِقالُ الأَعجازِ قَطَّعنَ قَلبي","بِحَديثٍ لَذٍّ وَدَهرٍ قَصيرِ",184,"ر",1,0],["وَثَغرٍ كَأَفواهِ الأُسودِ سَدَدتَهُ","بِسُمرِ القَنا وَالبيضِ وَالقُرَّحِ الجُردِ",185,"د",1,0],["وَثارَ بِأَرجاءِ المَدينَةِ عالِماً","بِأَقدامِهِ أَو دَولُ زَينِ المُناجِدِ",186,"د",1,0],["وَثَقيلَةِ الأَردافِ مُخطَفَةِ الحَشا","مِثلِ الغَزالَةِ مُقلَتَينِ وَجيدا",187,"د",2,0],["وَثَديٌ لِرُؤيَتِهِ سَجدَةٌ","يَدينُ لَهُ الناسِكُ الأَجلَحُ",188,"ح",1,0],["وَثَغرٌ إِذا ذُقتَهُ لَم تَمُت","وَطابَ لَكَ العَيشُ وَالمَسرَحُ",188,"ح",1,0],["وَثَقالُ الأَردافِ مَهضومَةُ الكَش","حِ كَغُصنِ الرَيحانِ يَهتَزُّ رَطبا",189,"ب",2,0],["وَثَغرٌ بارِدٌ عَذبٌ","جَرى فيهِ الأَعاجيبُ",190,"ب",1,0],["وَثَناهُما عَن رَحلِهِ","دَمعٌ يَبُلُّ الجَيبَ سَكبُه",191,"ب",2,0],["وَثَقالُ الأَوصالِ سَربَلَها الحُسنُ","بَياضاً وَالرَوقَةُ البَيضاءُ",192,"ا",2,0],["وَثِقتُ لَهُ بِالنَصرِ إِذ قيلَ قَد غَزَت","كَتائِبُ مِن غَسّانَ غَيرُ أَشائِبِ",193,"ب",1,0],["وَثُرَيّا النُجومِ تَلقى حِماماً","كَالثُرَيّا في رَهطِها القِرشِيَه",194,"ش",3,0],["وثقَّفَ سهمَ الدِّينِ بالعدلِ والتُّقَى","فهذا لهُ نصلٌ وذلك فُوقُ",195,"ق",1,0],["وثُلْثُهُ إن زالَ مِنْ قَلْبِهِ","وجَدْتَهُ طَيراً شجيَّ النّغَمْ",196,"م",1,0],["وثُلْثُهُ نِصْفٌ ورُبْعٌ لهُ","ورُبْعُهُ ثُلْثَاهُ حينَ انقَسَمْ",196,"م",1,0],["وثياباً لبستها فاخرات","جدداً وانتزعتها أسمالا",197,"ل",2,0],["وَثاروا بإغراء العَميد فخانهم","فَكان عَميد القوم غير عَميد",198,"د",1,0],["وَثار الكميُّ عَلى قرنه","وأزبد للغيظ منه الفم",199,"م",1,0],["وثورةُ الشاكين من طحنها","نوحُ الشظايا وعتابُ الغُبار",200,"ر",1,0],["وثنى بأخرى مثلها فأرادهم","وأتى الزمان على بني ماهان",201,"ن",1,0],["وثم صوتٌ عابر","منَ السنينِ الغوابر",202,"ر",1,0],["وثَبنَ في موكب الطبيعَه","وثوب غزلانها الوديعه",203,"ع",2,1],["وَثَدياً مِثلَ حُقِّ العاجِ رَخصاً","حَصاناً مِن أَكُفِّ اللامِسينا",204,"ن",2,0],["وثوْبي أضاةٌ إنْ شكا الظِّمْءَ تحتها","كَمِيُّ هِياجٍ فهْوَ ظمْآنُ سابِح",205,"ح",1,0],["وثانِيةٌ نُهىً تُوفي بقُدْسٍ","وثالِثَةٌ يُنِيلُ ولا يُنال",206,"ل",1,0],["وثمّ ما يسأل عنه الله","وصاحب الدين ومن تلاه",207,"ه",1,0],["وثاب أقوام إلى الأوثان","وقام غاو وتلاه ثان",208,"ن",1,0],["وثار للثارات زيد بن علي","ابن الحسين ابن الوصيّ المرتضى",209,"ا",1,0],["وَثِق بِاللَهِ رَبِّكَ ذي المَعالي","وَذي الآلاءِ وَالنِّعَم الجِسامِ",210,"م",1,0],["وثنٌ يُعبدُ في رَوضةٍ","صِيغَ مِن دُرّ مَرْجانِ",211,"ن",1,0],["وثَوى في دُجُنَّةِ النَّفْس وَمْضٌ","لم يَزَل بَيْنَ جيئَةٍ وذُهوبِ",212,"ب",1,0],["وثَبنَ لَدَى الثَّويَّةِ مُلجَمَاتٍ","وصَبَّحنَ العِبادَ وهُنَّ شِيبُ",213,"ب",1,0],["وثَلاثٍ كَالحمَامَاتِ بها","عِندَ مَجثَاهُنَّ تَوشيمُ الفَحَم",214,"م",1,0],["وَثنايا كَالأُفُحوانِ عِذابٌ","لا قِصارٌ كُسرٌ ولا هُنَّ رُوقُ",215,"ق",1,0],["وَثِقِي بِكِتْمَانِ الْحَدِيثِ فإِنَّمَا","شَفَتاي خَتْمٌ والْفُؤادُ وِعاءُ",216,"ا",2,0],["وَثِقَاتهِ المُتَزَودِي","ينَ مِنَ الْفَضَائِلِ خَيْرَ زَادْ",217,"د",1,0],["وَثُقُوبِ فِكْرٍ فِي","التَّوَجُّهِ وَاخْتِيَارِ المَنْجَعِ",218,"ع",1,0],["وَثُغَاءً غَدَا هَزِيماً فَأْلْقَى","رُعْبَهُ فِي مَرابِضِ الاسَادِ",219,"د",1,0],["وَثَبَتْ بِهِ فِي أَوْجِهِ ال","أسْنَى فَغَالَتْهُ شَعُوبُ",220,"ب",1,0],["وَثِياباً مِنْ كُلِّ لَوْنٍ وَنَقْشٍ","مِلْءَ عَيْنِ البَديعِ طَيّاً وَنَشرا",221,"ر",2,0],["وَثنى الأَعْيَانَ فِي نَدْوَتِهِمْ","طوْعَ كفَّيْهِ أَأَحْلى أَم أَمَرَّا",222,"ر",2,0],["وَثُغَيْرٌ حَلاَوَةُ الظَّلْمِ تَجْرِي","ثَنَايَاهُ فَوْقَ أَعْدَلِ جِيدِ",223,"د",1,0],["وَثَابِرْ تُصِبْ فَوْزاً فَمَا الفَوْزُ لِلْفَتَى","بِإِسْرَافِهِ فِي الجُهْدِ بَلْ بِاقْتِصَادِهِ",224,"د",2,0],["وَثَوَى ابْنُهَا ويَدَاهُ مِلْؤُهُمَا حصىً","مَلْسَاءُ يَلْعَبُ فِي مَكَانٍ صَاقِبٍ",225,"ب",1,0],["وثوبُ الحسن أحمرُ وهو لمّا","تردّى ألبسَ الحسن التماما",226,"م",2,0],["وثنَتْ إِلَى مثلِ الكَثِيبِ يدِي","فأجبْتُها نِعْم الأَريكةُ ذي",227,"ي",1,0],["وَثَوبُ التُقى في عَينِ كُلِّ حَقيقَةٍ","بِهِ الشَيخُ أَبهى مِن فَتىً مُتظَرِّفِ",228,"ف",1,0],["وَثاكِلٌ قُلتُ لَهُ في الدُجى","قَد أَطفَأَ الشَمعَةَ من قَطّا",229,"ط",2,0],["وَثَناني عَن وَفاةٍ","سَلَبَتني اِبني عنوا",230,"و",2,0],["وَثَبَّتَ مَن فيها مُقيماً مُرابِطاً","فَما إِن أَرى عَنها لَهُ مُتَحَوَّلا",231,"ل",2,0],["وثب الخيالُ إلى لقاك","وردّ وثبته العيانْ",232,"ن",1,0],["وَثَلاثٌ يُرِدنَ تَيماءَ رَهواً","وَثَلاثٌ يُغرَرنَ بِالإِعجابِ",233,"ب",1,0],["وثقت فيكم بغدر الدهر إن لهُ","غدراً وفيّاً وقِدْماً كان غدارا",234,"ر",2,0],["وَثَديانِ ثَديٌ كَبَلّوطَةٍ","وَآخَرُ كَالقِربَةِ المُقَهقَه",235,"ق",2,0],["وَثَغرٌ إِذا كَشَرَت خِلتَهُ","تَخالُجَ فانِيَةٍ مُعلَقَه",235,"ق",2,0],["وَثِقتْ بخالِقها القَديِرِ فشمَّرتْ","مَحْمودةَ الإِصْدَار والإِيرَاد",236,"د",1,0],["وثبتْ عَليه من المَنُونِ غوائِلٌ","وعَدَت عليه من الزَّمان عَوادِي",236,"د",2,0],["وثَبَتْ به مِصْرٌ وقد طال الكَرَى","وَمَضَتْ إِلى قَصَب الفَخَارِ تُغَبِّرُ",237,"ر",1,0],["وَثَبَاتٌ يُدْمي جَبِينَ اللَّيَالي","وَيَفُتُّ الصخرَ الأَصَمَّ الصَّلُودا",238,"د",2,0],["وَثَبَتْ وَثْبَتَها دَائِبَةً","كلَّما أَجْهَدَها السَّعْيُ زَجاها",239,"ا",3,0],["وثباتُ الشبابِ في حكمة الشِّي","ب، ورأي المجرِّبين السديد",240,"د",1,0],["وثارت على التُّرَّهَات بقلبٍ","شجاع، وحق لها أن تثورا!",241,"ر",2,0],["وثباتُهُ جيشٌ تمو","ج به الرَّوابِي والبِطاح",242,"ح",1,0],["وثقوا بأنَّا لاحقون بكم غدًا","ولسوف نُعْلِنُهُ جهادًا أكبرا",243,"ر",2,0],["وثبت إليه للعناق فقال لي","بحق الهوى هب لي من الضم تنفيسا",244,"س",2,0],["وثَغْرٍ لا يُقَامُ به كَفَوْكُمْ","ولم يكُ دونهم لكمُ كفاءُ",245,"ا",2,0],["وثقتُ له النصرِ ، إذ قيلَ قد غزتْ","كتائبُ منْ غسانَ ، غيرُ أشائبِ",246,"ب",1,0],["وثمَّ سنامٌ مُستَجدٌّ وغاربٌ","يناديك أن تسعى إليه فتركَبا",247,"ب",2,0],["وثَمَّ سفينٌ من دخانٍ قلوعُه","ونوتيُّهُ رَوح رخيٌّ من الصبا",247,"ب",2,0],["وثِقْ بأن البلادَ اليومَ أجمعَها","لما تُرجيِّه مِن مسعاك تَنتظِر",248,"ر",1,0],["وثَمَّ شِرذِمةٌ الفَتْ لها حُجُباً","من طُولِ صَفحٍ وعَفوٍ فهي تَستَتر",248,"ر",1,0],["وثنَتْ كفَّها إلى مهبِط الأشواقِ","منيّ فمَسحَّت أركانه",249,"ن",2,0],["وثارتْ مُخّيلتي تَدَّعي","بأنَّ التَنزُّلَ مَرعى وبي",250,"ب",2,0],["وثرى صلاح ِالدينِ دِيسَ وأنعلتْ","منه جيوشُ الواغلِين خُيولا",251,"ل",2,0],["وثُرْنَ فظيعاتٍ إذا حُمَّ مَخْرَجٌ","وقُلْنَ ألسنا من نَتاجِ الفظائع",252,"ع",1,0],["وثَدْيانِ: ثَدْيٌ كَبلُّوطة","ٍ وآخرُ كالقربة ِ المدهقهْ",253,"ق",2,0],["وَثَابَ إلَيْهِمْ رَأيُهُمْ، فَتَبَيّنُوا،","على حينِ حال، أنّ مَرْكبَهم صَعبُ",254,"ب",1,0],["وثدياً مثل حُق رخصاً","حصاناً من أكف اللامسينا",255,"ن",2,0],["وثقيل أنّه برد كانو","ن قليل الحياء جمّ الكلام",256,"م",1,1],["وثب الشِّعرُ وثبة ً فاستحلوا","رَجْمَ قاضيٍ وكان ذاك عجيبا",257,"ب",2,0],["وثَوْبٌ عتِيقٌ إِنْ فَشَا مِنْهُ سِرُّهَا","أَبَاحَ لِلنَّوَاظِرِ صَدْرُهَا",258,"ه",2,0],["وثَبّتَ الوَطءَ مِنّي، عندَ مُضْلِعَة ٍ","حتى تخطيتُها، مسترخياً لبتي",259,"ب",3,0],["وَثَلاثٍ كَالحَماماتِ بِها","بَينَ مَجثاهُنَّ تَوشيمُ الحِمَم",260,"م",1,0],["وَثَبن لَدى المَثوبَةِ مُلجَماتٍ","وَصَبَّحنَ العِبادَ وَهُنَّ شيبُ",261,"ب",1,0],["وثلمة السد كالمواة واسعة","يهوي بها السيل من فوق الى العمق",262,"ق",1,0],["وثاروا من مرابضهم أسودا","بصوت الاتحاد مُزمجِرينا",263,"ا",1,0]]}