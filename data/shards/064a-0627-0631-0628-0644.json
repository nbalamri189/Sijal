=61782",""],[5956,"حلُمٌ جميل لا أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=194563",""],[5956,"يا رب كيف أساعد الصنديدا","https://www.poetsgate.com/ViewPoem.aspx?id=194580",""],[5956,"يا رب إني أمدح الصنديدا","https://www.poetsgate.com/ViewPoem.aspx?id=194598",""],[5956,"أرجوك ربي صِلْ فؤاده بي","https://www.poetsgate.com/ViewPoem.aspx?id=204462",""],[5956,"مَن هي جانْسيت قازان (أمِّ خالد)؟","https://www.poetsgate.com/ViewPoem.aspx?id=207236",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[5977,"أجمل صحبة","https://www.poetsgate.com/ViewPoem.aspx?id=213063",""],[5977,"هي الشمس والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=213252",""],[6147,"الدّفق الغامر.. في مدح الرسول الأعظم","https://www.poetsgate.com/ViewPoem.aspx?id=212925",""],[6152,"مناجاة العشر الأواخر","https://www.poetsgate.com/ViewPoem.aspx?id=204735",""],[6152,"ياسمين الشام","https://www.poetsgate.com/ViewPoem.aspx?id=208661",""],[6277,"يا ربّ لا تبقني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64475&r=&rc=38",""],[6325,"صورة أخرى للحرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88018&r=&rc=0",""]],"verses":[["يا ربِّ لا سببٌ أرجو الخلاصَ به","إلا الرسولَ ولطفاً منك إن نفحا",0,"ح",2,0],["يا رُبَّ ليلٍ بطيءِ الصبح بعدكم","قد باتَ فيه صريع الجفن ساهره",1,"ر",2,0],["يا ربَّ ليلٍ بتُّه متنعِّماً","برشيقةٍ تغني بردفٍ مثقل",2,"ل",1,1],["يا رُبَّ لصٍّ ناهبٍ","وهو من الحسن ملء عيني",3,"ن",2,0],["يا ربِّ لا تبعثْ بغيثٍ عَيْثا","فإنه إن حَثَّ غيثٌ غيثا",4,"ث",2,1],["يا رُبَّ لَيلٍ بِلا سَناءِ","كَأَنَّما بَدرُهُ يَتيمُ",5,"م",1,1],["يا رَبِّ لا تَنقُلهُ عَن أُنسِهِ","وَإِنَّما اِنقُلني إِلى الأُنسِ",6,"س",1,0],["يا رب ليل سمرنا الراح فاختلفت","على بنانك للسمار ألحانا",7,"ن",2,0],["يا رب لا غبطة ولا حسد","ولا انتقاد فلست تنتقد",8,"د",1,1],["يا رُبَّ لَيلٍ لَم تَذُق","فيهِ الرُقادَ طَرَبا",9,"ب",2,0],["يا رَبِّ لا تَنسَ رَعاياكَ في","يَومٍ رَعاياكَ الفَريقُ الذَليل",10,"ل",1,0],["يا رُبَّ لُجٍّ جُعِلَت سَفينَهُ","وَعازِبِ الرَوضِ تَوَفَّت عونَهُ",11,"ن",2,0],["يا رَبَّ لا تَبلُ فَتىً عاشِقاً","مِنَ الَّذي يَهوى بِتَفريقِهِ",12,"ق",2,0],["يا رَبِّ لَم نَبكِ مِن زَمانٍ","إِلّا بَكَينا عَلى زَمانِ",13,"ن",1,0],["يا رُبَّ لَيلٍ طَويلٍ بِتُّ أَرقُبُهُ","حَتّى أَضاءَ عَمودُ الصُبحِ فَاِنفَجَرا",14,"ر",2,0],["يا رَبِّ لَو أَنسَيتَنيها بِما","في جَنَّةَ الفِردَوسِ لَم أَنسَها",15,"س",3,0],["يا ربُّ لا يُشْكَى أليمُ عذابِهِ","إلاّ إليكَ فقدْ أخافَ وأرعَبَا",16,"ب",2,0],["يا ربُّ لطفاً بالعبادِ فما لهم","ربٌّ سواكَ يقيهمُ المستعصَبا",16,"ب",2,0],["يا رُبَّ لَيلٍ بِتُّهُ","وَكَأَنَّهُ مِن وَحفِ شَعرِك",17,"ك",1,1],["يا رَبُّ لا تَسلُبَنّي حُبَّها أَبَداً","وَيَرحَمُ اللَهُ عَبداً قالَ آمينا",18,"ن",2,0],["يا رَبِّ لا تَجعَلَنِّي كافِراً أَبداً","واَجعَل سَريرَةَ قَلبي الدَهرَ إِيماناً",19,"ن",2,0],["يا رَبُّ لَيلٍ قاسٍ","كَأَنَّ عَلَيَّ قُرّا",20,"ر",2,0],["يا رُبَّ لَيلٍ قَد نَعِمتُ بِهِ","يَسعى عَلَيَّ بِكَأسِهِ البَدرُ",21,"ر",1,1],["يا رُبَّ لَيلٍ طَرَقنا بَيتَ صاحِبِها","بِفِتيَةٍ كَنُجومِ اللَيلِ أَحرارِ",22,"ر",1,0],["يا رُبَّ لَيلٍ بِتُّ في نِعمَةٍ","عِندَ فَتىً أَبيَضَ بَسّامِ",23,"م",1,1],["يا رَبِّ لا صَبرَ لي عَن قُربِ جارِيَةٍ","تَنأى دَلالاً وَفيها إِن دَنَت غَنَجُ",24,"ج",1,0],["يا رَبِّ لا أَدعوا لَميسَ كَما دَعا","أَوسٌ وَلا دَعوى زُهَيرٍ حارِ",25,"ر",1,1],["يا رب لَو أَنزلت سخطك ناقماً","فجعلته للظالمين نكالا",26,"ل",2,0],["يا رُبَّ ليلٍ دبَّ في أحشائه","منا لفيفٌ سار إثر لفيفِ",27,"ف",1,0],["يَا رُبَّ لَيْلٍ بِتُّ أُسْقَى بِهِ","مَشْمُولَةً صَفْرَاءَ كَالْوَرْسِ",28,"س",1,1],["يا رُبَّ لائِمَةٍ يا فَوزُ قُلتُ لَها","وَاللّومُ فيكِ لَعَمري غَيرُ مُحتَقَرِ",29,"ر",1,0],["يا رَبُّ لَيلٍ سَحَرٌ كُلُّهُ","مُفتَضِحُ البَدرِ عَليلُ النَسيم",30,"م",1,1],["يا رُبَّ ليل بلا فجر، شدوت به","مضى حثيث الخطا، وابيضَّ داجيه",31,"ي",2,0],["يا رُب ليل حالك يُحيونه","بروائع الآداب؛ فهْو نهار",32,"ر",1,0],["يا رب لا تتلاشى أمة نهضت","بدولة الحق لا وهنا ولا سأما",33,"م",2,0],["يا رب لا تجعل الأعداء عادية","على عصابة هذا الدين وانتقما",33,"م",2,0],["يا رَبِّ لا أدعُو لميسَ كما دَعَا","أوْسٌ، ولا دَعْوى زهيرٍ حارِ",34,"ر",1,1],["يا رُبَّ لهفانَ على صنيعَهْ","قصَّر فيها بيدٍ مُضيعَهْ",35,"ع",2,1],["يا رب لا تقطع رجائي منك يا","من من نداه يؤمل الا حسان",36,"ن",1,0],["يا رب ليل لقد أرهقته أرقاً","مما أعانيه من كيد المناكيد",37,"د",1,0],["يا رُبَّ لَيلٍ لَنا كَحاشِيَةِ البُر","دِ وَيَومٍ كَذاكَ لَم يَدُمِ",38,"م",1,0],["يا ربّ لا تترك وضيعاً فيهم","يا رب واشملهم بخير تشمّل",39,"ل",1,0],["يارب لا تبط بفتح فالورى","علموا بحسنِ الصبرِ فيه وجرّبوا",40,"ب",3,0],["يا رب لا تدخّر مجداً ولا شرفاً","إلاَّ وكان ليحيى منهما الخِيَرُ",41,"ر",1,0],["يا رب لا تجعل لدينك ناصراً","ملكاً سوى يحيى على الأديان",42,"ن",1,0],["يا رب لا تخزها وانفذ أوامرها","كمثل عاداتها في العجم والعرب",43,"ب",1,0],["يا رُبَّ لَيلٍ جَمَعَت قُطرَيهِ لي","بِنتُ ثَمانينَ عَروساً تُجتَلى",44,"ا",1,0],["يا رُبَّ لائمةٍ شَجاها أنني","سَمْحٌ بمالي والزمانُ ضَنين",45,"ن",1,0],["يا رُبَّ ليل بتُّه ناعماً","بين رُبا المختار فالجِسْرِ",46,"ر",1,1],["يا ربّ لا تخلينَّ القلبَ من أملٍ","والروضَ من زهَرٍ والأرضَ من بَلل",47,"ل",1,0],["يَارَبِّ لا تُشمِتْ بِنا حَمْزَهْ","وَقَفِّزَ النيلَ لنا قَفْزَهْ",48,"ز",2,1],["يا رَبّ لا تُشمت بِنا الأَعداءَ يا","أَجلَّ مَن يُرجى لِتَبليغ المُنى",49,"ا",1,0],["يا رَبّ لَم يَبق لَنا مِن ناصرٍ","سِواكَ يا ذا البَطش عزّاً والقوى",49,"ا",1,0],["يا رَبّ لا تَجعَل لَنا مِن حاجةٍ","إِلّا إِلَيك وَاِكفِنا شَرّ السِوى",49,"ا",1,0],["يا ربَّ لَيلةِ سَعدٍ باتَ يَطرقُني","فُجاءةً عِند ذي الفَخرينِ مَطلَعُهُ",50,"ع",2,1],["يا رَبِّ لا تَخلني من صنعِك الحَسَنِ","يا رَبِّ حطنيَ في عَبّادٍ الحَسَني",51,"ي",1,1],["يَا ربِّ لا يُقْبَلْ عليهِ وإِن","جَارَ دُعاءُ المُغرَمِ الهَائِمِ",52,"م",1,0],["يا رب ليل طويناه على قلق","ما متعت مقلتي فيه بطيب كرى",53,"ر",2,1],["يا رُبّ ليلٍ زارني","في غفلة المرتَقِب",54,"ب",1,0],["يا رُبّ ليلٍ أشتهي لباسهْ","قد عطّرَ الوصلُ لنا أنفاسَهْ",55,"س",2,1],["يا ربَّ ليلٍ بته","مثل مبيتِ النابغهْ",56,"غ",2,1],["يا رب لا زال وصب واصب سقما","عند الكروب إذا ما استوقدت سرج",57,"ج",1,0],["يا رب لا زال وصب واصب سقما","يذيب نفسي ونفسي تعشق النفج",57,"ج",1,0],["يا رَبِّ لاطِفْ وَلَدِي","وعافِهِ مِنْ أَلَمِهْ",58,"م",2,1],["يا رَبِّ لا تَقْبِضَني قَبْلَ ما","أَنَالُ ما أَرْجُو مِنَ السَّبْقِ",59,"ق",1,1],["يا ربِّ لا تجعل المنظورَ من أجلي","يلقاك بالسّيّءِ المكروهِ من عملي",60,"ل",2,1],["يا ربّ ليلٍ أخذنا فيهِ منيتنا","كأنّ أوّله في ذاك آخرُهُ",61,"ر",2,1],["يا رَبِّ لا أَدري وَأَنتَ الداري","كُلُّ اِمرِئٍ مِنكَ عَلى مِقدارِ",62,"ر",1,0],["يا رب لا تكلن أمري إلى بشرٍ","شر الحوائج ما كانت إلى البشر",63,"ر",1,1],["يا رَب لا اِعتراض في تِلكَ الحِكَم","إِنَكَ عَدلٌ في الأُمور وَحكم",64,"م",1,0],["يا رُبّ ليل أدهم جئتها","فيه على منجرد أشهبِ",65,"ب",1,0],["يا رب لَيل قَد لهوتُ به وَما","مِن طارِق إِلّا الكَواكِب تطرق",66,"ق",1,0],["يا رب ليل جلوت طرته","سهرت أسعد الورى طرا",67,"ر",2,0],["يا رب ليل غاب عن","ني بدره فخلفت بدره",68,"ر",2,0],["يا رب لا تحوج أخا","أمل إلى غير الموفق",69,"ق",1,1],["يا رب لي ظن جميل وافر","قدمته امشي به يسعى معي",70,"ع",2,0],["يا رب لا تتركني","وجملنّي بشكري",71,"ر",2,0],["يا رَبٍّ لا أَقْوى على دَفْعِ الأَذى","وَبِكَ اسْتَعَنْتُ على الضَّعيفِ الْمُوذِي",72,"ي",1,1],["يا رب لا أخزى وأنت اللّه","بحق لا إله إلا اللّه",73,"ه",1,0],["يا ربَّ ليلِ بالسَّرُور انقضى","مشكاتُه من بيننا واقدهُ",74,"د",2,1],["يا رُبَّ ليلٍ نابِغِيٍّ بِتُّهُ","أرعى النجومَ وعاذِلاني نُوَّمُ",75,"م",1,0],["يا رب ليس الذنب ذنب الغلام","يا رب لطفاً بالبريء الصغير",76,"ر",1,0],["يا رب لصّ قد يُسمَّى قاضي","والله من نجواه غير راضِ",77,"ض",1,0],["يا ربّ لا زلت حيّاً","أُصارع الأيّاما",78,"م",2,0],["يا رب ليل جبته","ورداؤه لم يدرج",79,"ج",1,1],["يا ربّ لا أقوى على كلّ الذي","ألْقى ولطفُك خير لُطْف ينتظر",80,"ر",1,0],["يا رب ليل أطال الهجر لذته","فأيأس العمر عن إدراك منتصفه",81,"ه",1,1],["يا رَب لَيلٍ خَلَوت فيهِ بِمن","يَقصر عَن وَصف كَنه وَجدي بِهِ",82,"ه",1,1],["يا رَبِّ لا تُبعِدَن دِيارَ بَني","عُذرَةَ حَيثُ اِنصَرَفتُ وَاِنصَرَفوا",83,"ف",3,0],["يا رب لا تبعث بمعنى رائع","من بعد أو فابعثه لي منظوما",84,"م",2,0],["يا رب لطفا وتأييدا ومغفرة","تمحو بها ظلم الزلات و