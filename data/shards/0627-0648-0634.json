{"poems":[[77,"حي تلمسان الحيا فربوعها","https://www.aldiwan.net/poem36058.html","الكامل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[86,"من لم يذق فقد أليف الصبا","https://www.aldiwan.net/poem10469.html","السريع"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[93,"يا فاقد الولد الوحيد عجبت","https://www.aldiwan.net/poem9850.html","الكامل"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[72,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"سقيا لعيش مضى ما فيه تكدير","https://www.aldiwan.net/poem64040.html","البسيط"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[91,"يا عبيد اللّه لا زلت","https://www.aldiwan.net/poem61853.html","مجزوء الرمل"],[85,"صحوت واستدركتني شيمتي الأدب","https://www.aldiwan.net/poem7890.html","البسيط"],[85,"بات المعنى والدجى يبتلي","https://www.aldiwan.net/poem63022.html","السريع"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[43,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[43,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[97,"إن تجد يا قلب قلباً قد لها","https://www.aldiwan.net/poem24347.html","الرمل"],[97,"قل للذين بكوا على شوقي","https://www.aldiwan.net/poem24774.html","أحذ الكامل"],[97,"أيها الحي وما ضر","https://www.aldiwan.net/poem24930.html","مجزوء الرمل"],[44,"داع دعا بلسان هاد مرشد","https://www.aldiwan.net/poem30532.html","الكامل"],[87,"يا ناعس الطرف إلى كم تنام","https://www.aldiwan.net/poem8287.html","السريع"],[69,"إن ملت لي الوشاة عينا عينا","https://www.aldiwan.net/poem28000.html","الدوبيت"],[81,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[40,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[46,"إلهنا الحق خفف واشف من وصب","https://www.aldiwan.net/poem23395.html","البسيط"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[43,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[90,"بعد المطر","https://www.poetsgate.com/ViewPoem.aspx?id=179092",""]],"verses":[["أَوْ شِئْت مِنْ دِينٍ إِذَا قِدْحُ الهدَى","أَوْرَى وَدُنْيَا لم تَكُن بالدُون",0,"ن",1,0],["أَو شَطبَةٍ جَرداءَ تَض","بِرُ بِالمُدَجَّجِ ذي الغَفارَه",1,"ر",2,0],["أَوشَكَ أَن يُفقِرَهُ جودُهُ","وَمِن صُنوفِ الجودِ ما يُفقِرُ",2,"ر",1,0],["أَوشَكَت تَأكُلُ الهَبيدَ مِنَ الفَق","رِ وَكادَت تَذودُ عَنهُ النِعاما",3,"م",2,0],["أَوشَكَ الديكُ أَن يَصيحَ وَنَفسي","بَينَ هَمٍّ وَبَينَ ظَنٍّ وَحَدسِ",4,"س",1,1],["أو شكت من علم ومن بر به","أن تمطل الأقدار ما استودعته",5,"ت",2,0],["أَو شُبرُمانُ يَهيجُ مِنكَ صَبابَةً","لَمّا تَبَدَّلَ ساكِنٌ وَدِيارُ",6,"ر",1,0],["أو شئت إن غابت يغيب رقيبها","فذكرتُ موصول اللقا وَربابا",7,"ب",2,0],["أو شكل ميزان قتٍّ جانبٌ صَعَدٌ","وجانب ثقَّلوه فهو منحدر",8,"ر",1,0],["أو شهوةً للنفوس ما برحت","تُبدي لنا حسنها لنشهرها",9,"ر",3,0],["أو شدوُ مُحسنةٍ غنَّتْ على طرب","صوتاً تَراطنَ فيه البَمُّ والزيرُ",10,"ر",1,0],["أو شئتَ قلتَ جميلةٌ ما عابها","أنْ لم يقلها المكتنِي بفراس",11,"س",1,0],["أَوشَكوا أَن يَحسِبوني صَنَماً","لَو رَأَوا الأَصنامَ تَخفي كَدَرا",12,"ر",2,0],["أو شبا رمح ابن مَعْد","يٍّ أخي الحرب زُبيْدِ",13,"د",1,0],["أوشكت أتلف أقلامي وتتلفني","وما أنلت بنى مصر الذي طلبوا",14,"ب",3,0],["أَو شِمتَ سَيفاً في جُيوشِ الضُحى","ما كُنتَ لِلأَعداءِ ما أَنتَ لي",15,"ي",1,0],["أَو شَقيقُ وَجنَتِهِ","حينَ لي بِهِ لَعِبُ",16,"ب",1,0],["أَو شاطِرِ المُلكَ العَظيمَ بِلادَهُ","وَسُسِ المَمالِكَ عَرضَها وَالطولا",17,"ل",2,0],["أَو شَدَّ أَصلَ عَقدِهِ","أَو سَدَّهُ أَو قَوَّرَه",18,"ر",2,0],["أَو شَكَّ أَنَّكَ فَردٌ في زَمانِهِمِ","بِلا نَظيرٍ فَفي روحي أُخاطِرُهُ",19,"ر",2,0],["أَو شَهِدوا الحَربَ لاقِحاً أَخَذوا","مِن مُهَجِ الدارِعينَ ما اِحتَكَموا",20,"م",3,0],["أَو شَعافَ الرومِ قَد رُفِعَت","فَوقَ أَطرافِ القَنا الأَشِبِ",21,"ب",1,0],["أَو شَواظاً لِلقِرى رُفِعَت","تَتَراءى في ذُرى كُثُبِ",21,"ب",1,0],["أَو شَقيقَ الرَوضِ مُنتَظِماً","فَوقَ مَجدولٍ مِنَ القَصَبِ",21,"ب",1,0],["أو شريداً يلفحُ القَفرُ دمي","أو طريداً تشربُ الريحُ دموعي",22,"ي",1,0],["أو شُعلة أبصارنا خلبت","ومنارة نُصبَت على عَلَمِ",23,"م",1,0],["أو شعر ذاك لا بل","حجر ينحت نحتا",24,"ت",2,0],["أَو شاهَدَ الحَربَ المُمِرَّ مَذاقُها","لَرَآهُ أَقمَعَ لِلعُتاةِ العُنَّدِ",25,"د",1,0],["أَوْشَكَ هَذَا اللَّيْلُ أَنْ يَنْقَضِي","وَالْعَيْنُ لا تَعْرِفُ طِيبَ الْمَنَامْ",26,"م",1,0],["أو شبَّهكَ الأنامُ غصناً غصنا","في لومهمُ فأنتَ معنى معنى",27,"ن",2,0],["أَو شاطَرَتهُ السُهدَ أَعيُنُنا فَما","زالَت تُعَزُّ بِعَدلِهِ وَتَنامُ",28,"م",1,0],["أَوشَمتَ مُسبَغَةَ الدُروعِ عَلَيهِمُ","أَبصَرتَ أَنهاراً تَضُمُّ أَبحُرا",29,"ر",2,0],["أَو شالُ أَنطِفَةٍ بَقي","نَ بِحَومِ أَرخافٍ قَلائِل",30,"ل",1,0],["أَو شارِبٌ مُدمِنٌ طابَ المُدامُ لَهُ","في المُدمِنينَ فَمِنهُ العَقلُ مُختَلَسُ",31,"س",1,0],["أو شِعابٍ أو هضابٍ أو رُبىً","أو بِطاحٍ أو نِجادٍ أو وِهَاد",32,"د",1,0],["أَو شاءَ تَزويجَ مِثلِ الظَبيِ مُعلَمَةٍ","لِلناظِرينَ بِأَسوارٍ وَعُلّامِ",33,"م",1,0],["أَو شَبَبٌ يَحفِرُ الرُخامى","تَلُفُّهُ شَمأَلٌ هُبوبُ",34,"ب",1,0],["أوشك العامُ أن يمرّ وهذا","موعدٌ للقاء في مصطافكْ",35,"ك",1,0],["أَوْشَكْتُ أَجْزَعُ فانْتهَيْتُ بِأَنَّني","آنَسْتُ فِيكَ مَشِيئَةً لِلبَارِي",36,"ر",2,0],["أَوْ شَاعِرٍ كَأَبِي حُسَيْنٍ آخِذٍ","مِنْ كُلِّ حَالٍ مَأْخَذَ الْحُكَمَاءِ",37,"ا",2,0],["أَوْشَكُوا أَنْ يحْزَنُوا ثُمَّ بَدَا","فَإِذا مَا ظُن مِنْ حُزْنٍ تَسَرَّى",38,"ر",2,0],["أَوْشكُوا أَنْ يُجْمِعُوا رَأْياً عَلى","أَنَّ فِي الَغْيبِ لِذاكَ الهَوْلِ سِرَّا",38,"ر",2,0],["أَوْ شَمْسِهَا تَجْرِي أَشِعَّتُهَا","بِالْبَلْسَمِ الشَّافِي لأَكْبَادِ",39,"د",1,0],["أَوْشَكْتُ فيكَ وَقَدْ نَسَيتُ شَكِيَّتِي","أَنْ أُوسِعَ الأَيَّامَ طِيبَ ثَنَاءِ",40,"ا",2,0],["أو شاهداً ما لقيته استه","إذ ذاك من شق وتخريق",41,"ق",1,0],["أو شهدنا نوراً على الأرض يمشي","الهدى واليقينُ من مشكاتِهْ",42,"ت",2,0],["أو شدا بالربيع، يومًا شَممنا","من قوافيه ريحَ عطر الورود",43,"د",1,0],["أوْ شَبَبٌ يَرْتَعي الرُّخامِي","تَلُطُّهُ شَمْألٌ هَبُوبُ",44,"ب",1,0],["أَو شِئتَ غَرَّقتَ العِدا بِالآلِ","وَلَو جَعَلتَ مَوضِعَ الإِلالِ",45,"ل",1,0],["أوشكتِ القِيعانُ ، إذ فُتّحت","لها السما ، مما عراها تَضيق",46,"ق",1,0]]}