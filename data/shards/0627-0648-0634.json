{"poems":[[77,"حي تلمسان الحيا فربوعها","https://www.aldiwan.net/poem36058.html","الكامل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[86,"من لم يذق فقد أليف الصبا","https://www.aldiwan.net/poem10469.html","السريع"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[93,"يا فاقد الولد الوحيد عجبت","https://www.aldiwan.net/poem9850.html","الكامل"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[72,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"سقيا لعيش مضى ما فيه تكدير","https://www.aldiwan.net/poem64040.html","البسيط"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[91,"يا عبيد اللّه لا زلت","https://www.aldiwan.net/poem61853.html","مجزوء الرمل"],[85,"صحوت واستدركتني شيمتي الأدب","https://www.aldiwan.net/poem7890.html","البسيط"],[85,"بات المعنى والدجى يبتلي","https://www.aldiwan.net/poem63022.html","السريع"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[43,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[43,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[97,"إن تجد يا قلب قلباً قد لها","https://www.aldiwan.net/poem24347.html","الرمل"],[97,"قل للذين بكوا على شوقي","https://www.aldiwan.net/poem24774.html","أحذ الكامل"],[97,"أيها الحي وما ضر","https://www.aldiwan.net/poem24930.html","مجزوء الرمل"],[44,"داع دعا بلسان هاد مرشد","https://www.aldiwan.net/poem30532.html","الكامل"],[87,"يا ناعس الطرف إلى كم تنام","https://www.aldiwan.net/poem8287.html","السريع"],[69,"إن ملت لي الوشاة عينا عينا","https://www.aldiwan.net/poem28000.html","الدوبيت"],[81,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[40,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[46,"إلهنا الحق خفف واشف من وصب","https://www.aldiwan.net/poem23395.html","البسيط"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[43,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[90,"بعد المطر","https://www.poetsgate.com/ViewPoem.aspx?id=179092",""],[107,"لو كنت أطمع بالمنام توهما","https://www.aldiwan.net/poem16185.html","الكامل"],[113,"ألم العشق في فؤادي أثر","https://www.aldiwan.net/poem41682.html","الخفيف"],[118,"أوشك الأصباح أن يمحو الدجى","https://www.aldiwan.net/poem49304.html","الطويل"],[118,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[118,"هل من معين على نجوى ووسواس","https://www.aldiwan.net/poem49348.html","البسيط"],[130,"لعبت بعد ما انقضى الريعان","https://www.aldiwan.net/poem54719.html","الخفيف"],[141,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[184,"شوقي إليك على تفريق بلدتنا","https://www.aldiwan.net/poem43764.html","البسيط"],[195,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[221,"في ربيع الحياة حلو الخصال","https://www.aldiwan.net/poem41611.html","الخفيف"],[235,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[247,"أطلال مية بالتلاع فمثقب","https://www.aldiwan.net/poem2127.html","الكامل"],[255,"لله ما صنع الغرام بقلبه","https://www.aldiwan.net/poem2685.html","الكامل"],[268,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[269,"أمن تذكر أهل البان والبان","https://www.aldiwan.net/poem52124.html","البسيط"],[296,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[296,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[351,"خلياني وصبوتي وشجوني","https://www.aldiwan.net/poem39775.html","الخفيف"],[351,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[351,"أنت هام العز للرتب","https://www.aldiwan.net/poem40773.html","المديد"],[369,"يا دهر لا مرحبا ولا أهلا","https://www.aldiwan.net/poem57187.html","الطويل"],[388,"كف السؤال عن الزمان وأهله","https://www.aldiwan.net/poem54533.html","عموديه"],[400,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[429,"أبا بكر العبدي عاداك ذو الفتك","https://www.aldiwan.net/poem12452.html","الطويل"],[434,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[436,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[436,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[441,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[441,"ما بال قلبك إن جرى","https://www.aldiwan.net/poem56009.html","عموديه"],[447,"لا تخدعنك كثرة الزراع","https://www.aldiwan.net/poem982.html",""],[451,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[451,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[456,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[456,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[456,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[473,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[512,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[512,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[512,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[556,"إنا فهمنا عنه أمثالا لنا","https://www.aldiwan.net/poem34234.html","الكامل"],[556,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[558,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[565,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[584,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["أَوْ شِئْت مِنْ دِينٍ إِذَا قِدْحُ الهدَى","أَوْرَى وَدُنْيَا لم تَكُن بالدُون",0,"ن",1,0],["أَو شَطبَةٍ جَرداءَ تَض","بِرُ بِالمُدَجَّجِ ذي الغَفارَه",1,"ر",2,0],["أَوشَكَ أَن يُفقِرَهُ جودُهُ","وَمِن صُنوفِ الجودِ ما يُفقِرُ",2,"ر",1,0],["أَوشَكَت تَأكُلُ الهَبيدَ مِنَ الفَق","رِ وَكادَت تَذودُ عَنهُ النِعاما",3,"م",2,0],["أَوشَكَ الديكُ أَن يَصيحَ وَنَفسي","بَينَ هَمٍّ وَبَينَ ظَنٍّ وَحَدسِ",4,"س",1,1],["أو شكت من علم ومن بر به","أن تمطل الأقدار ما استودعته",5,"ت",2,0],["أَو شُبرُمانُ يَهيجُ مِنكَ صَبابَةً","لَمّا تَبَدَّلَ ساكِنٌ وَدِيارُ",6,"ر",1,0],["أو شئت إن غابت يغيب رقيبها","فذكرتُ موصول اللقا وَربابا",7,"ب",2,0],["أو شكل ميزان قتٍّ جانبٌ صَعَدٌ","وجانب ثقَّلوه فهو منحدر",8,"ر",1,0],["أو شهوةً للنفوس ما برحت","تُبدي لنا حسنها لنشهرها",9,"ر",3,0],["أو شدوُ مُحسنةٍ غنَّتْ على طرب","صوتاً تَراطنَ فيه البَمُّ والزيرُ",10,"ر",1,0],["أو شئتَ قلتَ جميلةٌ ما عابها","أنْ لم يقلها المكتنِي بفراس",11,"س",1,0],["أَوشَكوا أَن يَحسِبوني صَنَماً","لَو رَأَوا الأَصنامَ تَخفي كَدَرا",12,"ر",2,0],["أو شبا رمح ابن مَعْد","يٍّ أخي الحرب زُبيْدِ",13,"د",1,0],["أوشكت أتلف أقلامي وتتلفني","وما أنلت بنى مصر الذي طلبوا",14,"ب",3,0],["أَو شِمتَ سَيفاً في جُيوشِ الضُحى","ما كُنتَ لِلأَعداءِ ما أَنتَ لي",15,"ي",1,0],["أَو شَقيقُ وَجنَتِهِ","حينَ لي بِهِ لَعِبُ",16,"ب",1,0],["أَو شاطِرِ المُلكَ العَظيمَ بِلادَهُ","وَسُسِ المَمالِكَ عَرضَها وَالطولا",17,"ل",2,0],["أَو شَدَّ أَصلَ عَقدِهِ","أَو سَدَّهُ أَو قَوَّرَه",18,"ر",2,0],["أَو شَكَّ أَنَّكَ فَردٌ في زَمانِهِمِ","بِلا نَظيرٍ فَفي روحي أُخاطِرُهُ",19,"ر",2,0],["أَو شَهِدوا الحَربَ لاقِحاً أَخَذوا","مِن مُهَجِ الدارِعينَ ما اِحتَكَموا",20,"م",3,0],["أَو شَعافَ الرومِ قَد رُفِعَت","فَوقَ أَطرافِ القَنا الأَشِبِ",21,"ب",1,0],["أَو شَواظاً لِلقِرى رُفِعَت","تَتَراءى في ذُرى كُثُبِ",21,"ب",1,0],["أَو شَقيقَ الرَوضِ مُنتَظِماً","فَوقَ مَجدولٍ مِنَ القَصَبِ",21,"ب",1,0],["أو شريداً يلفحُ القَفرُ دمي","أو طريداً تشربُ الريحُ دموعي",22,"ي",1,0],["أو شُعلة أبصارنا خلبت","ومنارة نُصبَت على عَلَمِ",23,"م",1,0],["أو شعر ذاك لا بل","حجر ينحت نحتا",24,"ت",2,0],["أَو شاهَدَ الحَربَ المُمِرَّ مَذاقُها","لَرَآهُ أَقمَعَ لِلعُتاةِ العُنَّدِ",25,"د",1,0],["أَوْشَكَ هَذَا اللَّيْلُ أَنْ يَنْقَضِي","وَالْعَيْنُ لا تَعْرِفُ طِيبَ الْمَنَامْ",26,"م",1,0],["أو شبَّهكَ الأنامُ غصناً غصنا","في لومهمُ فأنتَ معنى معنى",27,"ن",2,0],["أَو شاطَرَتهُ السُهدَ أَعيُنُنا فَما","زالَت تُعَزُّ بِعَدلِهِ وَتَنامُ",28,"م",1,0],["أَوشَمتَ مُسبَغَةَ الدُروعِ عَلَيهِمُ","أَبصَرتَ أَنهاراً تَضُمُّ أَبحُرا",29,"ر",2,0],["أَو شالُ أَنطِفَةٍ بَقي","نَ بِحَومِ أَرخافٍ قَلائِل",30,"ل",1,0],["أَو شارِبٌ مُدمِنٌ طابَ المُدامُ لَهُ","في المُدمِنينَ فَمِنهُ العَقلُ مُختَلَسُ",31,"س",1,0],["أو شِعابٍ أو هضابٍ أو رُبىً","أو بِطاحٍ أو نِجادٍ أو وِهَاد",32,"د",1,0],["أَو شاءَ تَزويجَ مِثلِ الظَبيِ مُعلَمَةٍ","لِلناظِرينَ بِأَسوارٍ وَعُلّامِ",33,"م",1,0],["أَو شَبَبٌ يَحفِرُ الرُخامى","تَلُفُّهُ شَمأَلٌ هُبوبُ",34,"ب",1,0],["أوشك العامُ أن يمرّ وهذا","موعدٌ للقاء في مصطافكْ",35,"ك",1,0],["أَوْشَكْتُ أَجْزَعُ فانْتهَيْتُ بِأَنَّني","آنَسْتُ فِيكَ مَشِيئَةً لِلبَارِي",36,"ر",2,0],["أَوْ شَاعِرٍ كَأَبِي حُسَيْنٍ آخِذٍ","مِنْ كُلِّ حَالٍ مَأْخَذَ الْحُكَمَاءِ",37,"ا",2,0],["أَوْشَكُوا أَنْ يحْزَنُوا ثُمَّ بَدَا","فَإِذا مَا ظُن مِنْ حُزْنٍ تَسَرَّى",38,"ر",2,0],["أَوْشكُوا أَنْ يُجْمِعُوا رَأْياً عَلى","أَنَّ فِي الَغْيبِ لِذاكَ الهَوْلِ سِرَّا",38,"ر",2,0],["أَوْ شَمْسِهَا تَجْرِي أَشِعَّتُهَا","بِالْبَلْسَمِ الشَّافِي لأَكْبَادِ",39,"د",1,0],["أَوْشَكْتُ فيكَ وَقَدْ نَسَيتُ شَكِيَّتِي","أَنْ أُوسِعَ الأَيَّامَ طِيبَ ثَنَاءِ",40,"ا",2,0],["أو شاهداً ما لقيته استه","إذ ذاك من شق وتخريق",41,"ق",1,0],["أو شهدنا نوراً على الأرض يمشي","الهدى واليقينُ من مشكاتِهْ",42,"ت",2,0],["أو شدا بالربيع، يومًا شَممنا","من قوافيه ريحَ عطر الورود",43,"د",1,0],["أوْ شَبَبٌ يَرْتَعي الرُّخامِي","تَلُطُّهُ شَمْألٌ هَبُوبُ",44,"ب",1,0],["أَو شِئتَ غَرَّقتَ العِدا بِالآلِ","وَلَو جَعَلتَ مَوضِعَ الإِلالِ",45,"ل",1,0],["أوشكتِ القِيعانُ ، إذ فُتّحت","لها السما ، مما عراها تَضيق",46,"ق",1,0],["أَو شاءَ أَن يَهب المُلوك لِبَعض ما","في رِقِهِ مُستَحقراً لَتَبَرما",47,"م",2,0],["أو شريداً من حور رضوان بالشم","س تردى وجاءنا يتبختر",48,"ر",1,0],["أوشك الأصباح أن يمحو الدجى","ورفات الأمس لما تدفن",49,"ن",1,1],["أو شئت في ظل أغصان موسوسة","تنأى وتدنو كما يختال نشوان",50,"ن",1,0],["أو شئت في ظل أغصان مهدلة","تحنو على بألوانٍ وأجناس",51,"س",1,0],["أو شَعِيبٌ مَفرِيةٌ لَم يُخَامِر","كُتَبَ الخُرقِ في كُلاَهَا دِهَانُ",52,"ن",1,0],["أَو شَطرَ مُلكِهِمُ تَجِدهُ عَلَيهِمُ","سَهلاً إِذا أَمَّنتَهُم ع