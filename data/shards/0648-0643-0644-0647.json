"وكلّهُم على الضلال صمّموا","صمّوا عَموا على الهدى وأُبكِموا",210,"م",3,0],["وكل هذا تولى","إثر الشباب النضير",211,"ر",1,0],["وكل هذي الانجم اللوامع","تعرف بالأعلام والتوابع",212,"ع",1,0],["وكل هذا وآل البيت ما رفعت","لهم عليهم يد والرب ديان",213,"ن",1,0],["وكلّهم من عنصر البخشيه","الا عليّا فهو في العبسيه",214,"ه",1,0],["وكلهّم خلائفٌ اماجد","من بعد واحد يقوم واحد",214,"د",1,0],["وكلهم ثووا بتلك البقعة","وبالتقى نالوا كمال الرفعة",214,"ه",1,0],["وكلهم قد احتووا في المقبره","حف جميعهم عظيم المغفرة",214,"ه",1,0],["وكلهم طوتهم الاراضي","وقد مضوا والله عنهم راضي",214,"ي",1,0],["وكلها موجبةٌ وسالبَه","فهي إذن إلى الثمان آيبَه",215,"ه",1,0],["وَكلّهم طلّاب مجدٍ تَعاوَنوا","عَلى نيله وَالكَون مصغ وَرامِقُ",216,"ق",1,0],["وكلُّهُمُ يذمّ العيشَ فيها","وما فيها لحُبِّ العيشِ قالِ",217,"ل",1,0],["وكل هوىً الاَّ هَواىَ وصالها","يكون وانْ طالَ اللجاجُ الى حَدِّ",218,"د",1,0],["وكُلُّهَا يَلزَمُ بَعدَهُ صِله","عَلَى ضَمِيرٍ لائِقٍ مُشتَمِلَه",219,"ه",1,0],["وكلهم ضلالا قد تواصوا","على إهلاكهم بشباً وسم",220,"م",1,0],["وكل هذا من معائب السلف","قد ابدعوها وتلاهم الخلف",221,"ف",1,0],["وكل هذا لأني","عصوتُ بالاثم ربي",222,"ب",2,0],["وكل همٍّ حاضرٌ","وكل فرحٍ غائبُ",223,"ب",1,0],["وَكلهم تَراه في مَقامٍ","مِن البَلوى وَلا يَدري مَقامه",224,"م",2,0],["وَكلهم يراني ذا ابتسام","إِذا يَبكي العَدوّ لهول قَهري",225,"ر",2,0],["وَكلهم أَلفاه ذا خدعة","أَو لُطف ذي زُور بلا عائد",226,"د",1,0],["وَكُلُّهُم خَيرُهُ ناقِصٌ","وَكُلُّهُم شَرُّهُ زائِدُ",227,"د",1,0],["وكلهم ثقة عدل محبتهم","دين إذ الدين عمّا بلغوا نبغا",228,"غ",2,0],["وكله فان وإن جاء الأجل","أفضت إلى ما قدمت من العمل",229,"ل",1,0],["وكلهم لكلهم شقاءٌ","وبعضهم لبعضهم نكال",230,"ل",1,0],["وكل هذا وبذا طلعة","وعزماتي واريات الزناد",231,"د",1,0],["وكُلُّهُمُ عَلَى عَهدٍ","عَلِمتَ بِهِ بِلاَ غَدرِ",232,"ر",1,0],["وكُلُّهُمُ مُستَحسِنٌ نَسَقًا لَهُ","مُبِينٌ لِمَولانَا فَضِيلَتَهُ الغَرَّا",233,"ر",2,0],["وكلهم وصفه ظاهرٌ","فما وصفونا به وُصفوا",234,"ف",3,0],["وكلهم قد خص بالحمد وارثاً","له الفرع من أصلٍ رفيع مع الغرسِ",235,"س",1,0],["وكلها مختلف في الضعف","وكثرة يعلم ذا ذو كشف",236,"ف",1,0],["وُكُلُّهُما اجتَذَبَ الَّلهذَما","وَحملَقَ يَنظُرُ مُحتدِما",237,"م",2,0],["وكلهم بفائض الدمع جاد","فرق زفسٌ لهم",238,"م",1,0],["وَكُلُّهُم لنصىِ الحقِّ ساعٍ","وَدفعِ البَغيِ بِالعَزمِ الشَديدِ",239,"د",1,0],["وَكُلُهم مِن رَبِّه مُؤَيَّدُ","بِمُعجِزَاتٍ لاَ تَنَالُهَا اليَدُ",240,"د",1,0],["وَكُلُهم مُيَسَّرٌ لِمَا لَهُ فَراجٍ","أمرُهُ وَمُؤتَلِق",240,"ق",1,0],["وَكُلُّهُم عَلَى هُدًى مِن رَبِّهِم","وَفِرقَةَ الجُنَيددِن بِحُبِّهِم",240,"م",1,0],["وكلهن ملاء","بالسعد والاشنان",241,"ن",1,0],["وكلهمُ غَيثٌ إَذا قِحِطَ الوَرى","وَيَعقوبُ منهم للأنامِ رَبيعُ",242,"ع",1,0],["وكلُّهم لا يرتجون سواكمُ","ينادون إن من صوبكم لاح بارق",243,"ق",1,0],["وكلهم قد كان طوع يمينه","وما زال فيهم نافذ النهي والأمر",244,"ر",1,0],["وكلهم قد كان يدعو تضرعا","لكم عند مولاه وأدمعه تجري",244,"ر",2,0],["وكُلُّهُمُ عَدُوٌ غيرُ مُبقٍ","حَدِيثٌ قُرحة يَسعَى بِوِترِ",245,"ر",1,0],["وكُلُّها مُشبِه شيئا على حدة","وقد تخالفَ فيه الفعلُ والصُورُ",246,"ر",1,0],["وكلها للفنا وما عليها كذا","والغاية الجنة أو ملتقى سقر",247,"ر",1,0],["وكلهم فقها إلى النبي","فانظرهم في المشرع الروي",248,"ي",1,0],["وكلُّهم فَرُّوا إلى جنة","من حرِّ نار ولها طارُوا",249,"ر",3,0],["وكلُّهمُ لقد تَابُوا مَتَاباً","سِوَى عبد الإلهِ فتى سَلُول",250,"ل",1,0],["وَكُلُّهُم مِن ذُنوبٍ","بِعِصمَةِ اللَهِ طاهِر",251,"ر",1,0],["وكلهُ بالهوى بديعٌ","في الحُسنِ ما مثلُهُ بَديعُ",252,"ع",1,0],["وَكل هَذا شوقٌ إلى حسنٍ","لم يُرزقا من فَعالهِ الحسنِ",253,"ن",1,0],["وكلها كأنها","منهاهل مستعذبه",254,"ب",2,0],["وكِلها الملا يِرجون فَضلَه إلهنا","فلا رادْ لَه سايِلْ ولا خاب طالبَه",255,"ب",2,0],["وكلهم له داع شكور","يقول رضاه ذخرى او عتادى",256,"د",2,0],["وكلهم كانوا ضيوفا لدى","ابي الندى اكرم من يقرى",257,"ر",2,0],["وكلهم عاد رضيا بما","نال وقد اطنب في الشكر",257,"ر",1,0],["وَكُلُّ هُدىً في العالَمينَ فَإِنَّهُ","هُدايَ وَما لي في الوُجودِ مُنازِعُ",258,"ع",1,0],["وكلهم يسعى على قدر وسعه","فمن مقتر عان ومن واحد مثر",259,"ر",1,0],["وكلها راضعٌ صغيرٌ","له على ضرعها اعتكاف",260,"ف",1,0],["وكلهم مُدّع للدينِ ذو نُسُك","عند الجدالِ ولا فقهٌ ولا سندُ",261,"د",1,0],["وكل هذا وتبون انّا انتخدر","مساكين(ن)رفع عنكم ولينا",262,"ن",2,0],["وكلٍ همّه يشرّف وطنّا","ولا يزعزع وفانا ابن اللذينا",263,"ن",2,0],["وكلهم يحاول منه صيداً","فيدأى لا يثوب إلى صواب",264,"ب",1,0],["وكلهم غفل عما يحيط بهم","وليس ثمة وشم قط أو نقط",265,"ط",1,0],["وكلهم من رسول الله ملتمس","إشراقة تملأ الحيزوم للحُزُم",266,"م",1,0],["وَكُلُّهُمْ في نَواحيْ أهْلِنا أسَدٌ","وَكُلُّهُمْ عِنْدَ بابِ الغَيْرِ رِعْديْدُ",267,"د",1,0],["وكُلُّهم بكؤوسِ الحُبِّ قد شَرِبوا","والحُبُّ للحِبِّ محَبُوبٌ ومَغروزُ",268,"ز",1,0],["وكل همو يرضى بابا","أو يحارب مسلمينو",269,"ن",2,0],["وكلهمُ له دور لتلقى","له البركات يرميها الشريفُ!!",270,"ف",1,0],["وكل هاجس ما يجيب إلا خيالك","سلوتي بالعمر ... في صحوه وغفوه",271,"و",2,0],["وكله على شانك ابجمع شتاتي","وكله على شانك ابمشي للأخير",272,"ر",1,0],["وكلهمْ يرتجي وصلاً بغايتِهِ","بعضُ الوصالِ عذابٌ حينَ يتصلُ",273,"ل",1,0],["وْكُلّْهَا فِيهْ عَلاَشْ تَبْغِيهْ","لَغْرَامْ كْتَابْ وْكُلّْهَا يَقْرَا فَكْتُوبُو",274,"و",1,0],["وكلها حينما تُحصى نزاهتُها","فإنَّ أشرفَ ما فيها أبو لهبِ",275,"ب",1,0],["وكلهم نوابه قد حباهم","من السر ما قد طاش من ذكره اللب",276,"ب",1,0],["وكلهنَّ بريئاتٌ فوا حَزَني","على البرىء الذي بالزور نُذْهِلُهُ",277,"ل",2,0],["وَ كُلُّهُمْ لَمْ يُساوُوا فِي مُعادَلَتي","صِفرًا , وَ فِي إِصبَعي لَمْ يَعدِلُوا ظُفُرا",278,"ر",2,0],["وكلها العقل والدين الحنيف وذو ال","مبدا المقدس عن مغناه يزويها",279,"ي",3,0],["وكلهم نبعة للمصطفى وبه","منها تبارك تفريعٌ وتأصيل",280,"ل",1,0],["وكلهمْ في بخلهمْ صادقٌ","وفي النَّدَى لَيْسَ بأُسْتَاذِ",281,"ذ",1,0]]}