d=52032",""],[5461,"ليه إذا","https://www.poetsgate.com/ViewPoem.aspx?id=8538",""],[5573,"ياكوكب الزهره معاك امنياتي","https://www.poetsgate.com/ViewPoem.aspx?id=204559",""],[5672,"من حديث العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=214661",""],[5749,"كلها يقرا كتوبو","https://www.poetsgate.com/ViewPoem.aspx?id=177041",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[5956,"بسمة ذات إعجاب بموهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182292",""],[6102,"عودة اضطرارية","https://www.poetsgate.com/ViewPoem.aspx?id=184458",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[289,"الصِّدْقُ في أفْوَاهِهِمْ عَلْقَمٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22133&r=&rc=12",""]],"verses":[["وَكُلُّ هافِتَةِ الأَعناقِ يَنحَرُها","لَمعُ البُروقِ عَلى ميثٍ وَأَجراعِ",0,"ع",1,0],["وَكُلُّهُمُ يَجُرّونَ العَوالي","مُحافَظَةً عَلى عُشبِ البِطاحِ",1,"ح",1,0],["وكُلُّ هَوىً نَهْبُ الليالي وحُبُّها","إذا بَلِيَتْ أهواءُ قَوْمٍ تَجدَّدا",2,"د",2,0],["وكُلُّهُمْ يَشْتَكي بَثّاً على كَمَدٍ","بينَ الجَوانِح والأضلاعِ ولاّجِ",3,"ج",1,0],["وكُلّهُمْ شُهُبٌ للدّينِ هادِيَةٌ","فَلا تكُنْ لحُقوقِ النّاسِ بالنّاسِ",4,"س",1,0],["وَكُلُّهَا مُزْهِرٌ فُنُوناً","وَكُلُّهَا مُثْمِرٌ فُنُونَا",5,"ن",2,0],["وكلهم نعم للخلق شاملة","تبارك الله لا تُحْصَى عطاياهُ",6,"ا",2,0],["وكلّهم وقفوا مستسلمين إلى","تنهّدات وآهات وإرنان",7,"ن",1,0],["وَكُلُّهُمُ سَقَيتُ نَقيعَ سَمٍّ","بِبابي مُخدِرٍ ضَرِمِ اللُعابِ",8,"ب",1,0],["وكلهم يَصْدِمُه عامداً","أو تائهَ اللُّبِّ بلا عمدِ",9,"د",1,0],["وكل هلالٍ فهْو غرةُ شهرِهِ","ووجهك فينا غرةُ الشهر والدهر",10,"ر",1,0],["وكلهم كان في مسائله","أعمى عن الصبح وهو منصدع",11,"ع",1,0],["وكلهمْ قائلٌ هنيئاً","لا يرتضى وطأها بمنسمِ",12,"م",1,0],["وَكُلُّهُم كانَ مِن عِشقٍ مَنِيَّتُهُ","وَقَد وَجَدتُ بِها فَوقَ الَّذي وَجَدوا",13,"د",3,0],["وكل هوى بلائمة مشوب","وحبك في الملامة لا يشاب",14,"ب",1,0],["وكلهم عاقل حكيم","وغيره الجاهل السفيه",15,"ه",1,0],["وكلهم قائم بمبدا","ومبدأ الكل ضيعوه",15,"ه",1,0],["وكل هذا هيأه","مكونا منه امرأة",16,"ه",1,0],["وَكُلُّهُمو حَجَرٌ في البِنا","ءِ وَغَرسٌ مِنَ المُثمِرِ المُعقِبِ",17,"ب",1,0],["وكل هذا أصله واحد","منه التراكيب التي ركّبوا",18,"ب",3,0],["وَكُلُّهُمُ أَفضى إِلَيهِ حِمامُهُ","أَميراً عَلى تَدبيرِ جَيشٍ عَرَمرَمِ",19,"م",1,0],["وكُلُّه نَواظِرٌ لا تُطْرِقُ","حتى إذا نَمَّ عليه الفَلَقُ",20,"ق",1,0],["وُكُلَهُمُ يَرجو نَوالَكَ راجياً","لِرَحمَتِكَ العُظمى وَفي الخُلدِ يَطمَعُ",21,"ع",1,0],["وَكُلُّهُمُ عَنّي قَليلٌ غِنائُهُ","إِذا غَلِقَت في الهالِكينَ رُهوني",22,"ن",2,0],["وَكُلُّهُمُ أَعَدَّ اليَأسَ وَقفاً","عَلَيكَ وَنَصَّ راحِلَةَ القُعودِ",23,"د",1,0],["وكلهمُ راضٍ عليَّ وذاكري","بخيري ولكنْ لو عبثتُ لما قرُّوا",24,"ر",3,0],["وَكُلٌّ هُناكَ صَريعٌ بِهِ","يَرى أَنَّ عَيشَتَهُ حَتفُهُ",25,"ف",2,0],["وَكُلُّ هَزيمِ الرَعدِ جَونٍ مُجَلجِلٍ","لَهُ هَيدَبٌ دانٍ مِن الأَرضِ هاطِلِ",26,"ل",1,0],["وَكُلُّهُم قَد كانَ لِصّاً عادِيا","ما زالَ قِدماً يَعمَلُ الدَواهِيا",27,"ي",2,0],["وَكُلُّها في نَعيمٍ","ما كُنتُ بِالمَغدورِ",28,"ر",1,0],["وَكُلُّهُمُ إِن تَصَفَّحتُهُم","صَديقُ العَيانِ عَدُوُّ المَغيبِ",29,"ب",1,0],["وَكلُّهُمْ مِنْ رَسُولِ اللهِ مُلْتَمِسٌ","غَرْفاً مِنَ الْبَحْرِ أَوْ رَشْفاً مِنَ الدِّيَمِ",30,"م",1,0],["وَكَلُّهُمُ عَلَى مَالِ الرُّعايا","وَمالِ رُعاتِهِمْ يتَحيَّلُونا",31,"ن",2,0],["وَكُلُّهُمُ وَإِن طَرمَذتَ فيهِمُ","سَتَترُكُهُ وَشيكاً في يَدَيكا",32,"ك",2,0],["وكُلُّها في شَطرهِ مَوجودُ","منها المُرَفّلُ الّذي يَزيدُ",33,"د",1,0],["وكلُّ هذه السَّتة المَشْطورَهْ","مَعْروفة لأَهلها مَخْبورهْ",33,"ه",1,0],["وَكُلُّهُمُ لبَّى نِدَاءَ ضَمِيرِهِ","سَوَاءٌ فَتَاهُمْ فِي الفِدَى وَالمُعَمِّرُ",34,"ر",1,0],["وَكُلُّهُمُ أَخُ يَلْقَى أَخاهُ","لِمِيثاقٍ يُؤَكِّدُهُ وَأَصْرِ",35,"ر",1,0],["وكلهم أولياء غير مقترف","كبيرة لم يتب منها فمنه بري",36,"ر",2,0],["وكُلُّهُمُ لَم يَدرِ حَرفاً وعِندَهُم","سَفِيهٌ أخُو التَّقَوَى ومَن خَطَّ أَحرُفَ",37,"ف",1,0],["وكلهُمُ يقولَ أَنا المجازى","بشر دونهم وأَنا المفاجا",38,"ج",2,0],["وَكُلُّ هُمامٍ دَيسَميٍّ إِذا سَطا","عَلى الخَيلِ يَوماً قيلَ وافى عَذابُها",39,"ب",3,0],["وَكُلُّهُمُ سامٍ إِليَّ بِطَرفِهِ","يَظُنُّ بِأَنَّ الزارِعَ الخَيرَ حاصِدُ",40,"د",1,0],["وكلهم قد خاله في فؤاده","بأجمعه يحكون ذلك في الشعر",41,"ر",1,0],["وَكلّهمُ رِجسٌ ولَكن دُعاتُهم","نَجاسَتُهم جاءَت مغلّظةً كُبرى",42,"ر",2,0],["وكلُّها أوصافُ مدحٍ بَهرت","وَبعضُها مع شبهها تكرّرَت",43,"ت",1,0],["وكلِّ هادٍ في الوَرى ومهدي","وَبعدُ فاِسمَع أيّها السعيدُ",44,"د",1,0],["وَكلُّهم بنورهِ قَد شرفوا","فإنَّه الدرُّ وكلٌّ صدفُ",44,"ف",1,0],["وكلُّهم تحتَ لواءِ الحمدِ","فَحَمَلت بالشافعِ المشفّعِ",44,"ع",1,0],["وكلهم من جاهلٍ ونابه","يرونَ قدرَ المرءِ في ثيابهْ",45,"ب",2,0],["وكلّ هِرْجابٍ أَمُونٍ أجُدِ","لو سُلِعت في النار لم تَبَلَّد",46,"د",1,0],["وَكُلِّ هَيفاءَ ذاتِ دَلٍّ","يَقتُلُني قَدُّها الرَشيقُ",47,"ق",1,0],["وَكُلِّ هَضيمِ الكَشحِ بَضٍ تَقاذَفَت","بِهِ البيدُ مُزجٍ مِن مَطِيَّتِهِ نِقضا",48,"ض",2,0],["وكلّها حقٌّ أتت من حقِّ","لكنّها تمرّ مثل البرقِ",49,"ق",1,0],["وكلُّ هذا الزهرِ من رَوضِها","وكلُّ هذا النَّشر من زَهرها",50,"ر",3,0],["وكلُّ هذا النورِ من وجهها","وكلُّ هذا الدرِّ من ثغرها",50,"ر",3,0],["وكلُّ هذا الوجد من حبِّها","وكلُّ هذا الشوق من ذكرها",50,"ر",3,0],["وَكُلُّهُمُ القَصيدُ وَأَنتَ بَيتُ ال","قَصيدِ فَعَرفُ عَرفِكَ لَيسَ يُكتَم",51,"م",1,0],["وَكُلُّهُم في بُخلِهِ صادِقٌ","وَفي النَدى لَيسَ بِأَستاذِ",52,"ذ",1,0],["وكل هيفاء رود","تسبي العقول الصحاحا",53,"ح",2,0],["وَكلُّهم قد كادَ يَحكيه مُشبِهاً","ولكنَّ من أَهوى على الكلِّ فائقُ",54,"ق",1,0],["وكله في الأرض أو في السما","وثلثه يسبح في البحر",55,"ر",1,0],["وكل هضبٍ كرأسٍ شاب من كبرٍ","تشينه سبخةٌ في مفرقِ الطرقِ",56,"ق",1,0],["وَكُلُّهُم في ذَروَةِ المَجدِ نازِلٌ","فَشَأنُكُم إِنَّ البَيانَ عَنِ الغَدِ",57,"د",1,0],["وَكُلُّهُم قَد غَنّى بِالمُصطَفى وَهَنى","وَما نَأَت أَو نَبَت عَنهُم مَعونَتُهُ",58,"ت",2,0],["وَكُلُّ هَيقٍ بِها يَسمو لِرِعلَتِهِ","تَحذي بِها نُقَضٌ مِن تَحتِها نُسُفُ",59,"ف",1,0],["وَكُلُّهُنَّ يُباري ثِنيَ مُطَّرِدٍ","كَحَيَّةِ الطَودِ وَلّى غَيرَ مَطرودِ",60,"د",1,0],["وَكُلُّهُم هاموا بِحُبّي وَمَوَّهوا","بِغَيري لِأَغيارِ الغَرامِ وَأَوهَموا",61,"م",3,0],["وكُلُّهمْ خَتَموا أبناءَ جِنْسِهمُ","ختْماً فدوْلَتُهم مَحْسودةُ الدُّول",62,"ل",1,0],["وَكُلُّ هَذا بِيُمنٍ عادَ يَشمَلُني","مِن مَقدَمٍ لِأَمينِ المُلكِ محمودِ",63,"د",1,0],["وكُلُّ هذا والفؤادُ ذاكِرٌ","عهْدَ التَّصابي ما انقضّى وما انقَضَب",64,"ب",1,0],["وكلُّ هذا وهو مستَحسنٌ","مستَعذِبٌ ذلك مُستَمري",65,"ر",2,0],["وكلُّهم في معزلٍ بعيدِ","عن عقد أهل السُّنَةِ السَّديد",66,"د",1,0],["وكل هذا ذاهب","وهو خيال كاذب",67,"ب",1,0],["وكلهم قد آنسوا غربتي","وأسكنوا ودي سويداهم",68,"م",1,0],["وكلُّهم ذو هوىً في الرأيِ متَّهَمُ","كان التحاملُ منهمْ في إشارَتِهِم",69,"م",1,0],["وكلُّهمْ إن أنت كشَّفتَهُم","مثلُ سرابِ القِيعَةِ الّلامِعِ",70,"ع",1,0],["وكلّهمْ وهُمُ الأحياءُ إن بُعِثُوا","على الحياءِ وفعلِ الخيرِ أمواتُ",71,"ت",1,0],["وكلّهُمْ راضٍ وفوقَ الرِّضا","بِبُلْغَةِ الطَّاعِم والكاسي",72,"س",2,0],["وكُلُّهُمُ خاضِعٌ يَستكي","نُ للظُّلمِ أوْ وَالِهٌ يُعوِلُ",73,"ل",1,0],["وكُلُّهُمُ كَيُوسُفَ إِذْ فَدَاهُ","مِنَ القَتْلِ التَّغَرُّبُ والجَلاءُ",74,"ا",2,0],["وكلُّهُمُ نَمِرِيٌّ وإنّي","لكُلٍّ هنالكَ كعبُ بنُ مامَهْ",75,"م",2,0],["وكلَّهُمْ يُزْهى عَلَى الشَّمْسِ فِي الضُّحى","وبَدرِ الدَّياجِي أَنَّهم لَكَ جيرانُ",76,"ن",1,0],["وكلُّ هلالٍ ذو الأراك حجابُهُ","يسرُّ البدورَ الطالعاتِ مَغيبُهُ",77,"ب",2,0],["وكل همام زان مرّة عنفه","كما زان أجسام المهنّدة الأثر",78,"ر",1,0],["وكل هلاليّ يزيد طلاقةً","على شدَّةٍ من دهرهِ وتهلّلا",79,"ل",2,0],["وَكُلُّهُم وُطِئَتْ هاماتُهُم صَلَفا ً","يا سَيِّدي ضَجَّ فينا الظُلمُ والصَّلَفُ",80,"ف",1,0],["وكلَّ هيفاءَ يُبدي البدرُ طلعتَها","وكلَّ أهيفَ مثلِ الغصنِ ميّادِ",81,"د",1,0],["وكل هذا وذاك الحمى","وبعض هذا وبك المستعان",82,"ن",1,0],["وكُلُّهُ دينٌ وذِكرٌ وتُقًى","تَرُدُّ بالأنْوارِ عَزمَ من جَفَا",83,"ف",2,0],["وكلهم مستخدم","مبجل موقر",84,"ر",1,0],["وكُلُّهُمْ مُظْهِرٌ حُبّاً لذي نَشَبٍ","إنْ عادَ يوماً علَيْهمْ ذَلِكَ 