ِيلِهَا","ثَنَاءً عَلَيْهِ وَاحْتِفَاءً بَمَنْ أَهْدَى",81,"د",2,0],["وَتَهُزُّ مَنْكِبَهُ الصَّوَاعِقُ حَيْثُمَا","شَاءَتْ وَلاَ يَهْتَزُّ مِنْهُ المَنْكِبُ",82,"ب",1,0],["وَتهْذِي مِن الحُمَّى بِمَا شَاءَ ثكْلُهَا","وَيَنْهَلُّ مِنْ أَجْفَانِهَا الدَّمْعُ كَالقَطْرِ",83,"ر",1,0],["وَتَهَيَّأَتْ أَسْبَابُ كُلَّ رَفَاهَةٍ","لِبِلاَدِهِ بَعْدَ الجَهَادِ المُجْهَدِ",84,"د",1,0],["وَتهْوِينِ نَفْسٍ لَدَى خَصْمِهَا","بِلاَ طَائِلٍ غيْرَ أَن تَصْغُرَا",85,"ر",2,0],["وتهاووا كالقضاء المقبل","خلت أن النجم في عالمه",86,"ه",1,0],["وتهادى عليه من حلَلِ الريشِ","أفانينُ تأخذُ الأبصارا",87,"ر",2,0],["وتهادَى النيلُ نشوانَ الهوىَ","ينثرُ الأزهارَ فوْق الشاطئينْ",88,"ن",1,0],["وتَهُزُّ أَدْواحَ الرياضِ فَتَنْثَنِي","شَوْقاً إِلَيْكَ بَواسِقُ الأَدْواحِ",89,"ح",1,0],["وتهمةٌ في الشِّعْرِ من جاهلٍ","ما زالَ فيه عاجزاً عن لَحاق",90,"ق",1,0],["وتهاديتي كأني ساحب","مئزري فوق جباه الأنجم",91,"م",1,0],["وتهاوى السفينُ تحتَ جبالٍ","شاهقات الذُّرا غِلاظِ الرِّعَان",92,"ن",1,0],["وتهادى النسيمُ ألين مسًّا","من رفيف النَّدى على غُصنِ بان",93,"ن",1,0],["وتهفو السَّوامُ إليه، كما","هفا الأصدقاء إلى الأصدقاء",94,"ا",2,0],["وتهتف روحه: مالي تراث","أخلفه لكم إلا النِّضال",95,"ل",1,0],["وتهنأ به بناء سعيدا","جاء المعلوات وفق اقتراح",96,"ح",1,0],["وتهادت على الرّبى فتلظّى","في عروق الثلوج ،دفء الصيف",97,"ف",1,0],["وتهادى يرجو المفاز وتغشى","دربه غمرة فيخشى العثارا",98,"ر",2,0],["وتهيّجت فيه الجراح فصدّها","وتستّرت باللّيل كالحشرات",99,"ت",1,0],["وتهجس الأعشاب في خطوه","هجس المجاني لليد القاطفه",100,"ف",2,0],["وتهمس حتّى تعير الصخور","فما شاديا وفؤادا عطوف",101,"ف",1,0],["وتهزّ الخناجر الحمر ... أيد","ترتمي كالنسور في كلّ نحر",102,"ر",1,0],["وتهنا وحكّمنا في المتاه","سباع على خطونا حوّمُ",103,"م",1,0],["وتهادى الزمانُ عن جانبيهِ","أزليَّ الشبابِ نضرَ الكمائم",104,"م",1,0],["وتهضَّمَ النُوتيُّ زورقَه","بالقار، بعد الغِيد، يَحشُده",105,"د",2,0],["وتهجع هانئا جذلا قريرا","وقد هجر الكرى وجفا الوسادا",106,"د",2,0],["وتهشّ عند لقائه ، ويغيب عنك فتشتهيه","لا يرضي أبدا لصاحبه الذي لا يرتضيه",107,"ي",2,0],[