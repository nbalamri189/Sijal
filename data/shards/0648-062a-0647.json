{"poems":[[53,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[63,"نظرت بألحاظ الظباء العين","https://www.aldiwan.net/poem46160.html","الكامل"],[63,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[77,"لمن علم في هضبة الملك خفاق","https://www.aldiwan.net/poem35918.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[86,"كم ذا يكابد عاشق ويلاقي","https://www.aldiwan.net/poem10915.html","الكامل"],[93,"جاءت صفيحتكم ولم أر شكلها","https://www.aldiwan.net/poem11241.html","الكامل"],[93,"مضى عصر الرجال الأعاظم","https://www.aldiwan.net/poem11326.html","الطويل"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[88,"بكت في ظلام الليل تندب أهلها","https://www.aldiwan.net/poem44803.html","الطويل"],[88,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[47,"أراك عصي الدمع شيمتك الصبر","https://www.aldiwan.net/poem25258.html","الطويل"],[72,"حمدت دموعي إذ وفت بوعودها","https://www.aldiwan.net/poem18562.html","الكامل"],[72,"يا عذولي خلني أغنم عمري","https://www.aldiwan.net/poem18701.html","الرمل"],[72,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"يا ابن حرب كسوتني طيلسانا","https://www.aldiwan.net/poem8317.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[26,"يا بيت خثماء الذي يتحبب","https://www.aldiwan.net/poem24099.html","الكامل"],[91,"يا نفس هذا منزل الأحباب","https://www.aldiwan.net/poem8750.html","عموديه"],[91,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[91,"لا لهفة النفس على غابة","https://www.aldiwan.net/poem62811.html","عموديه"],[91,"قالوا ألا تصف الكريم لنا فقلت على البديه","https://www.aldiwan.net/poem62826.html","عموديه"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[70,"آيات مجدك مالها تبديل","https://www.aldiwan.net/poem42766.html","الكامل"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[92,"أقبل الصبح يغني","https://www.aldiwan.net/poem38893.html","مجزوء الرمل"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[92,"يا ليت شعري هل لليل الن","https://www.aldiwan.net/poem38974.html","مجزوء الكامل"],[89,"قد أسمعتك أنينها الأوطان","https://www.aldiwan.net/poem44941.html","الكامل"],[85,"سمعت بأن طاووساً","https://www.aldiwan.net/poem8029.html","مجزوء الوافر"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[45,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[45,"أحجابا بعد المديح ومطلا","https://www.aldiwan.net/poem64640.html","الخفيف"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[28,"بين إذا نزلت عليك مجاشع","https://www.aldiwan.net/poem5311.html","الكامل"],[49,"وإني لمعذور على طول حبحا","https://www.aldiwan.net/poem64192.html","الطويل"],[66,"أمن حجر فؤادك أم حديد","https://www.aldiwan.net/poem41547.html","الوافر"],[80,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[31,"خليلي اربعا وسلا","https://www.aldiwan.net/poem41833.html","مجزوء الوافر"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"يا رب ليل بته","https://www.aldiwan.net/poem12940.html","مجزوء الكامل"],[74,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[33,"ألا ليت ليلى أطفأت حر زفرة","https://www.aldiwan.net/poem25944.html","الطويل"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[102,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"يا غلاما يريد كتما","https://www.aldiwan.net/poem66562.html","مجزوء الخفيف"],[48,"يا رستم بن خداهى","https://www.aldiwan.net/poem66570.html","المجتث"],[50,"عدمتك عاجلا يا قلب قلبا","https://www.aldiwan.net/poem64866.html","الوافر"],[46,"إذا ما عانق الخمسين حي","https://www.aldiwan.net/poem22769.html","الوافر"],[46,"أمل حبيب أدل","https://www.aldiwan.net/poem23279.html","مجزوء المتقارب"],[46,"أريد ليان العيش في دار شقوة","https://www.aldiwan.net/poem23499.html","الطويل"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85590","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42630","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54900","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54700","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50356","السريع"],[95,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=659",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[98,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[91,"الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=53416",""]],"verses":[["وَتَهُزُّ أَحشاءَ البِلادِ بِضُمِّرٍ","يَرِدُ الطِعانَ أَغَرُّها وَبَهيمُها",0,"م",3,0],["وَتَهَنَّ بِالتَحويلِ غَي","رَ مُحَوَّلٍ عَن ذا المَقامِ",1,"م",1,0],["وتَهُزُّ أعْطافَ المُلوكِ كأنّها","ريحُ الشّمالِ تعثّرَتْ بغُصونِ",2,"ن",1,0],["وتَهوي إِلى البَيْتِ العَتيقِ ورَبُّها","إذا غالَ منْ تأويبهِ البيدُ أسْأَدا",3,"د",2,0],["وتَهْتَزُّ مِن شوقٍ إليهِ منابِرٌ","أطالَتْ بِه أعوادُهُنَّ التَّناجِيا",4,"ي",2,0],["وتَهُزُّ أعْطافَ الوَليِّ كأنّها","راحٌ مُشَعْشَعَةٌ براحَةِ ساقِي",5,"ق",2,0],["وتَهْنيكَ يا مَوْلَى المُلوكِ خِلافةٌ","شجَتْها تَباريحٌ إليْكَ وأشْواقُ",6,"ق",1,0],["وَتَهْلِكُ دُونَ الشَّهْدِ شَأَنَ ذُبَابَةٍ","وَمِنْ دُونِ ذَاكَ الشَّهْدِ لَمْ تَشْعُرُ السُّم",7,"م",1,0],["وتَهْوى قُلوبُ المُعْتَفينَ لظِلِّه","فتُعْمَلُ أقْتابٌ إلَيْهِ وأقْتادُ",8,"د",1,0],["وتهنّأْ بِهِ بِناءً سَعيداً","جاءَ للمَعْلُواتِ وِفْقَ اقْتِراحِ",9,"ح",1,0],["وَتَهَشُّ إِن لاقَيتَني وَتَخُصُّني","بِالبِشرِ في ناديكَ وَالتِرحابِ",10,"ب",1,0],["وَتَهُزُّني ذِكرى المُروءَةِ وَالنَدى","بَينَ الشَمائِلِ هِزَّةَ المُشتاقِ",11,"ق",1,0],["وَتَهَلْلَ النِّيلُ الوَقُورُ مُصفِّقاً","طَرَباً وَمَاجَ بِذَائِبِ العُقْيانِ",12,"ن",1,0],["وَتَهْدِي إِلَيْهَا مِنْ مَنَاجِمِ فِكْرِهِ","نَفَائِسَ أَغْلَى مِنْ كُنُوزِ المَنَاجِمِ",13,"م",1,0],["وَتَهجيرَ قَذّافٍ بِأَجرامِ نَفسِهِ","عَلى الهَولِ لاحَتهُ الهُمومُ الهُواجِسُ",14,"س",1,0],["وَتَهجُرُهُ إِلّا اِختِلاساً نَهارَها","وَكَم مِن مُحِبٍّ رَهبَةَ العَينِ هاجِرِ",15,"ر",1,0],["وَتَهجيرُنا وَالمَروُ حامٍ كَأَنَّما","يَطَأنَ بِهِ وَالشَمسُ حامِيَةٌ جَمرا",16,"ر",2,0],["وتهوى النجوم الزهرُ لو ثبتت به","ولم تكُ في أفق السماء جواريا",17,"ي",2,0],["وتَهبو له في ساحل النيل هَبوة","أبو الهول منها واجد وحزين",18,"ن",1,0],["وتهذيب الرجال أجَلّ شرط","لجعل نسائهم متهذّبات",19,"ت",1,0],["وَتَهلِكُ بَينَ الهَزلِ وَالجَدِّ مُهجَةٌ","إِذا ماعَداها البَينُ عَذَّبَها الهَجرُ",20,"ر",1,0],["وتهنّ بالأعوام نزعُ خليقها","مستأنف النعمى ولبس جديدها",21,"د",3,0],["وتهنَّا ألف عيد مثله","في مسرَّاتٍ وفي عزًّ ونصر",22,"ر",1,0],["وتهنى إقبال سيدة الوق","ت وأزكى حمى وأيمن حله",23,"ل",2,0],["وتهتزّ أعواد المنابر فرحةً","فهل رجعتْ للعهد وهي نواعم",24,"م",1,0],["وتهاديت كأني ….. ساحب","مئزري فوق جباه الأنجم",25,"م",1,0],["وتهب الرياحُ في أرض غيري","فتهب الفُزورُ فيه هُبوبا",26,"ب",2,0],["وتهاويلَ غير ذاك من الرَّقْ","م ومن سُندسٍ ومن زِرْيابِ",27,"ب",1,0],["وتهطل الدهرَ فيك ديمتُهُ","لكنها عن سواك تنقشع",28,"ع",1,0],["وتِهتَ أن نِلْتَ رُتبةً وَسطاً","لا شططاً في العُلو بل أَمما",29,"م",2,0],["وَتَهيجُ سارِيَةُ الرِياحِ مِنَ أَرضِكُم","فَأَرى الجَنابَ لَها يُحَلُّ وَيُجنَبُ",30,"ب",1,0],["وَتَهَلَّلي كَالفَجرِ في هَذا الحِمى","وَتَأَلَّقي كَالخَمرِ في الأَكوابِ",31,"ب",1,0],["وَتَهجَعُ هانِئً جَذلاً قَريراً","وَقَد هَجَرَ الكَرى وَجَفا الوِسادا",32,"د",2,0],["وَتَهتِفُ الطيرُ بِها في الرُبى","فَما لَنا نَحنُ نُعَمّيها",33,"ي",3,0],["وَتَهَشُّ عِندَ لِقائِهِ وَيَغيبُ عَنكَ فَتَشتَهيه","لا يَرتَضي أَبَداً لِصاحِبِهِ الَّذي لا يَرتَضيه",34,"ي",2,0],["وَتَهتَزُّ أَعوادُ المَنابِرِ بِاسمِهِ","فَهَل ذَكَرَت أَيّامَها وَهيَ قُضبانُ",35,"ن",1,0],["وَتَهَنَّ عيداً دامَ عيدُكَ عائِداً","وَعَلَيهِ مِنكَ جَلالَةٌ وَقَبولُ",36,"ل",1,0],["وَتَهُزُّ مِنهُ الأَريحِيَّةُ ماجِداً","كَالرُمحِ لَدناً وَالحُسامِ مُجَوهَرا",37,"ر",2,0],["وَتَهُزُّهُ العَلياءُ وَال","هِندِيُّ مَهزوزٌ صَفيحُه",38,"ح",2,0],["وتَهادى النُّورَ في","تِلْكَ الفِجاجِ الدَّامسَهْ",39,"ه",1,0],["وتَهَدَّلَتْ أَغْصانُ أَيَّامي","بلا ثَمَرٍ وزَهْرِ",40,"ر",1,0],["وتهوي الغُصونُ وأوراقُها","وأَزهارُ عهدٍ حبيبٍ نَضِرْ",41,"ر",1,0],["وتهبُّ الحَيَاة سَكرى من العِط","رِ ويدْوي الوُجُودُ بالتَّغريدِ",42,"د",1,0],["وتهادتْ في أُفْق روحِكِ أَوْزانُ","الأَغاني ورِقَّةُ التَّغريدِ",42,"د",1,0],["وتَهلِكُ تِلْكََ النُّجومُ القُدامى","ويهرمُ هذا الزَّمانُ العَهيدْ",43,"د",1,0],["وتَهُدُّ من قلبي الجميلِ","فهلْ لقلبي مِنْ ذُنوبْ",44,"ب",1,0],["وتهاربت منها البقية خشيةً","من أن تنال حياتها النيران",45,"ن",1,0],["وَتَهتَزُّ المُلوكُ لَهُ","إِذا ما هَزَّ عيدانا",46,"ن",2,0],["وَتُهديكَ الثَناءَ الحُرَّ تاجاً","عَلى تاجَيكَ مُؤتَلِقاً عُجابا",47,"ب",2,0],["وتهتُّكٌ وترفرفٌ وتماجُنٌ","ورقى مخادَعةٍ على الغزلانِ",48,"ن",1,0],["وتهدي إليها في النسيمِ إِذا سرَى","لطائمُ تَحوي عنبراً ومَلابَا",49,"ب",2,0],["وَتَهتَزُّ هِزَّةَ غُصنِ الأَرا","كِ عارَضَهُ نَشرُ ريحٍ خَصِر",50,"ر",1,0],["وَتَهاوَنتَ بي لَأَن صِرتَ بِاليُس","رِ سَماءً وَصِرتُ بِالعُسرِ أَرضا",51,"ض",2,0],["وَتَهَلَّلَت لِلراغِبينَ أَسِرَّةٌ","يَضحَكنَ في وَجهٍ كَثيرِ الرَونَقِ",52,"ق",1,0],["وَتَهادَروا بِشَقاشِقٍ أَعناقُها","غُلبُ الرِقابِ قُرومُها لا توزَعُ",53,"ع",1,0],["وَتَهتَزُّ مِن تَحتِ الثِيابِ كَأَنَّها","قَضيبٌ مِنَ الرَيحانِ في وَرَقٍ خُضرِ",54,"ر",1,0],["وَتَهتَزُّ الذَوابِلُ فيهِ عُجباً","كَما اِهتَزَّت مِنَ المَرَحِ القُدودُ",55,"د",1,0],["وتهدي له كفُّ تصولُ على العدا","إلى كفّ ميمون المضاءِ المصمّم",56,"م",1,0],["وتهمي من أنامِلِهِ العَطايا","فتحسبُها غيوماً للغيومِ",57,"م",1,0],["وَتَهُبُّ لي بِعَجاجِ مَوكِبِكَ الصَبا","إِنَّ السَماحَةَ تَحتَ ذاكَ القَسطَلِ",58,"ل",1,0],["وَتَهوانا وَنَهواها","وَنَعصي قَولَ مَن عَذَلا",59,"ل",2,0],["وَتُهوي إِلى لَثمِ البِساطِ وَإِنَّما","تُصَلّي إِلى رُكنِ المَعالي فَتَسجُدُ",60,"د",1,0],["وَتَهُزُّ مِنكِ فَتَنثَني","بِقَضيبِ قَدِّكِ ريحُ سُكرِك",61,"ك",1,0],["وَتُهدي إِلَيكَ الريحُ عَنها تَحِيَّةً","تَفوهُ بِما تَحتَ الضُلوعِ فَتَنطِقُ",62,"ق",1,0],["وَتَهفو صَبا نَجدٍ بِهِ طيبَ نَفحَةٍ","فَيَلقى صَبا نَجدٍ بِما كانَ لاقِيا",63,"ي",2,0],["وَتَهتَزُّ لَيلى العامِريَّةُ فَوقَها","وَلاثَت بِسِبِّ القَزِّ ذا غُدُرٍ جَعدا",64,"د",2,0],["وتهتف باسمك الدنيا فتبقى","ومثلك ليس يدركه الذهاب",65,"ب",1,0],["وَتَهاوى الطُيور عَن شَجر الخل","د تَغَنّى بِأَعذَب الأَلحان",66,"ن",1,0],["وتُهَزُّ ألويَةُ الجنودِ خَوافِقاً","تحتَ العَجاجِ كَواسِراً عِقبانها",67,"ن",3,0],["وتهاديك بالرقا","ع إذا خفتَ من وَشا",68,"ش",2,0],["وتهمةِ المجان","ونخوةِ النشوانِ",69,"ن",1,0],["وَتَهتَجِرُ النِساءَ إِلى هَواها","كَأَنَّكَ ضامِنٌ مِنهُنَّ نَحبا",70,"ب",2,0],["وَتَهزَأُ مِنهُ رَبّاتُ المَغاني","كَما هَزِئَت بِرُؤبَةَ أُمُّ حَمزِ",71,"ز",1,0],["وَتَهلِكُ ذاتُ الكَرا","وَتَهلِكُ ذاتُ الخَدَل",72,"ل",1,0],["وَتَهلِكُ أَعيانُ الرِجالِ وَإِنَّما","مَصارِعُ أَعيارٍ كَمَصرَعِ أَعيانِ",73,"ن",1,0],["وتَهَنَّ النُّعْمى السّنيّةَ والْبَسْ","حُلَلَ المَجْدِ والفَعَالِ الخَطيرِ",74,"ر",1,0],["وتهدي له الريحان ريانَ نافحاً","وما أنضر الريحانَ في البلد الخصب",75,"ب",1,0],["وتهضمتني وآلمت قلبي","بتجرِّيك أيما إيلامِ",76,"م",1,0],["وتهرب الأنجم هذي وَذِي","ويجثم الليل على القاهره",77,"ه",1,0],["وتهادى هنالك الشفَقُ العا","ني ليلقى وساده في الوادي",78,"ي",1,0],["وَتَهَنَّ بِالْمُلْكِ الَّذِي أَلْبَسْتَهُ","شَرَفاً بِمِثْلِ رِدَائِهِ لَمْ يَرْتَدِ",79,"د",1,0],["وَتَهَلَّلَتْ بِقُدُومِهِ","فَرَحاً أَسِرَّةُ عَصْرِهِ",80,"ر",2,0],["وَتهْدِي إِلى الأُرْدُنِّ أَلْطافَ نِيلِهَا","ثَنَاءً عَلَيْهِ وَاحْتِفَاءً بَمَنْ أَهْدَى",81,"د",2,0],["وَتَهُزُّ مَنْكِبَهُ الصَّوَاعِقُ حَيْثُمَا","شَاءَتْ وَلاَ يَهْتَزُّ مِنْهُ المَنْكِبُ",82,"ب",1,0],["وَتهْذِي مِن الحُمَّى بِمَا شَاءَ ثكْلُهَا","وَيَنْهَلُّ مِنْ أَجْفَانِهَا الدَّمْعُ كَالقَطْرِ",83,"ر",1,0],["وَتَهَيَّأَتْ أَسْبَابُ كُلَّ رَفَاهَةٍ","لِبِلاَدِهِ بَعْدَ الجَهَادِ المُجْهَدِ",84,"د",1,0],["وَتهْوِينِ نَفْسٍ لَدَى خَصْمِهَا","بِلاَ طَائِلٍ غيْرَ أَن تَصْغُرَا",85,"ر",2,0],["وتهاووا كالقضاء المقبل","خلت أن النجم في عالمه",86,"ه",1,0],["وتهادى عليه من حلَلِ الريشِ","أفانينُ تأخذُ الأبصارا",87,"ر",2,0],["وتهادَى النيلُ نشوانَ الهوىَ","ينثرُ الأزهارَ فوْق الشاطئينْ",88,"ن",1,0],["وتَهُزُّ أَدْواحَ الرياضِ فَتَنْثَنِي","شَوْقاً إِلَيْكَ بَواسِقُ الأَدْواحِ",89,"ح",1,0],["وتهمةٌ في الشِّعْرِ من جاهلٍ","ما زالَ فيه عاجزاً عن لَحاق",90,"ق",1,0],["وتهاديتي كأني ساحب","مئزري فوق جباه الأنجم",91,"م",1,0],["وتهاوى السفينُ تحتَ جبالٍ","شاهقات الذُّرا غِلاظِ الرِّعَان",92,"ن",1,0],["وتهادى النسيمُ ألين مسًّا","من رفيف النَّدى على غُصنِ بان",93,"ن",1,0],["وتهفو السَّوامُ إليه، كما","هفا الأصدقاء إلى الأصدقاء",94,"ا",2,0],["وتهتف روحه: مالي تراث","أخلفه لكم إلا النِّضال",95,"ل",1,0],["وتهنأ به بناء سعيدا","جاء المعلوات وفق اقتراح",96,"ح",1,0],["وتهادت على الرّبى فتلظّى","في عروق الثلوج ،دفء الصيف",97,"ف",1,0],["وتهادى الزمانُ عن جانبيهِ","أزليَّ الشبابِ نضرَ الكمائم",98,"م",1,0],["وتهضَّمَ النُوتيُّ زورقَه","بالقار، بعد الغِيد، يَحشُده",99,"د",2,0],["وتهشّ عند لقائه ، ويغيب عنك فتشتهيه","لا يرضي أبدا لصاحبه الذي لا يرتضيه",100,"ي",2,0]]}