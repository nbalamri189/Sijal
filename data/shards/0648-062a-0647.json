tps://www.aldiwan.net/poem14351.html","الهزج"],[441,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[452,"يحن الحبيب إلى رؤيتي","https://www.aldiwan.net/poem13947.html","المتقارب"],[453,"الجلاء الجلاء رددت الأصداء","https://www.aldiwan.net/poem61259.html","الخفيف"],[458,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[461,"لقد علم القبائل من معد","https://www.aldiwan.net/poem15160.html","الوافر"],[461,"جلا سدف المفارق نور شيب","https://www.aldiwan.net/poem15444.html","الوافر"],[461,"يظن الهوى العذري وجدي بمجده","https://www.aldiwan.net/poem15650.html","الطويل"],[461,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[464,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[464,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[464,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[468,"اسحب أبا عبد الإله","https://www.aldiwan.net/poem59532.html","مجزوء الكامل"],[500,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[500,"بالله يا ريح الصبا","https://www.aldiwan.net/poem38042.html","مجزوء الرجز"],[514,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[515,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[529,"ألا قل لمولانا الإمام مناخنا","https://www.aldiwan.net/poem37138.html","الطويل"],[538,"سال بالسحر منك خير يراع","https://www.aldiwan.net/poem47556.html","عموديه"],[538,"أيها القائد المفدى بروحي","https://www.aldiwan.net/poem47595.html","عموديه"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[538,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[544,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[551,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[551,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[551,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[558,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[558,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[558,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[567,"وتهتز في مشيها مثل ما","https://www.aldiwan.net/poem69512.html","المتقارب"],[567,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[575,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[575,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[575,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[575,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"],[575,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[575,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[575,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"]],"verses":[["وَتَهُزُّ أَحشاءَ البِلادِ بِضُمِّرٍ","يَرِدُ الطِعانَ أَغَرُّها وَبَهيمُها",0,"م",3,0],["وَتَهَنَّ بِالتَحويلِ غَي","رَ مُحَوَّلٍ عَن ذا المَقامِ",1,"م",1,0],["وتَهُزُّ أعْطافَ المُلوكِ كأنّها","ريحُ الشّمالِ تعثّرَتْ بغُصونِ",2,"ن",1,0],["وتَهوي إِلى البَيْتِ العَتيقِ ورَبُّها","إذا غالَ منْ تأويبهِ البيدُ أسْأَدا",3,"د",2,0],["وتَهْتَزُّ مِن شوقٍ إليهِ منابِرٌ","أطالَتْ بِه أعوادُهُنَّ التَّناجِيا",4,"ي",2,0],["وتَهُزُّ أعْطافَ الوَليِّ كأنّها","راحٌ مُشَعْشَعَةٌ براحَةِ ساقِي",5,"ق",2,0],["وتَهْنيكَ يا مَوْلَى المُلوكِ خِلافةٌ","شجَتْها تَباريحٌ إليْكَ وأشْواقُ",6,"ق",1,0],["وَتَهْلِكُ دُونَ الشَّهْدِ شَأَنَ ذُبَابَةٍ","وَمِنْ دُونِ ذَاكَ الشَّهْدِ لَمْ تَشْعُرُ السُّم",7,"م",1,0],["وتَهْوى قُلوبُ المُعْتَفينَ لظِلِّه","فتُعْمَلُ أقْتابٌ إلَيْهِ وأقْتادُ",8,"د",1,0],["وتهنّأْ بِهِ بِناءً سَعيداً","جاءَ للمَعْلُواتِ وِفْقَ اقْتِراحِ",9,"ح",1,0],["وَتَهَشُّ إِن لاقَيتَني وَتَخُصُّني","بِالبِشرِ في ناديكَ وَالتِرحابِ",10,"ب",1,0],["وَتَهُزُّني ذِكرى المُروءَةِ وَالنَدى","بَينَ الشَمائِلِ هِزَّةَ المُشتاقِ",11,"ق",1,0],["وَتَهَلْلَ النِّيلُ الوَقُورُ مُصفِّقاً","طَرَباً وَمَاجَ بِذَائِبِ العُقْيانِ",12,"ن",1,0],["وَتَهْدِي إِلَيْهَا مِنْ مَنَاجِمِ فِكْرِهِ","نَفَائِسَ أَغْلَى مِنْ كُنُوزِ المَنَاجِمِ",13,"م",1,0],["وَتَهجيرَ قَذّافٍ بِأَجرامِ نَفسِهِ","عَلى الهَولِ لاحَتهُ الهُمومُ الهُواجِسُ",14,"س",1,0],["وَتَهجُرُهُ إِلّا اِختِلاساً نَهارَها","وَكَم مِن مُحِبٍّ رَهبَةَ العَينِ هاجِرِ",15,"ر",1,0],["وَتَهجيرُنا وَالمَروُ حامٍ كَأَنَّما","يَطَأنَ بِهِ وَالشَمسُ حامِيَةٌ جَمرا",16,"ر",2,0],["وتهوى النجوم الزهرُ لو ثبتت به","ولم تكُ في أفق السماء جواريا",17,"ي",2,0],["وتَهبو له في ساحل النيل هَبوة","أبو الهول منها واجد وحزين",18,"ن",1,0],["وتهذيب الرجال أجَلّ شرط","لجعل نسائهم متهذّبات",19,"ت",1,0],["وَتَهلِكُ بَينَ الهَزلِ وَالجَدِّ مُهجَةٌ","إِذا ماعَداها البَينُ عَذَّبَها الهَجرُ",20,"ر",1,0],["وتهنّ بالأعوام نزعُ خليقها","مستأنف النعمى ولبس جديدها",21,"د",3,0],["وتهنَّا ألف عيد مثله","في مسرَّاتٍ وفي عزًّ ونصر",22,"ر",1,0],["وتهنى إقبال سيدة الوق","ت وأزكى حمى وأيمن حله",23,"ل",2,0],["وتهتزّ أعواد المنابر فرحةً","فهل رجعتْ للعهد وهي نواعم",24,"م",1,0],["وتهاديت كأني ….. ساحب","مئزري فوق جباه الأنجم",25,"م",1,0],["وتهب الرياحُ في أرض غيري","فتهب الفُزورُ فيه هُبوبا",26,"ب",2,0],["وتهاويلَ غير ذاك من الرَّقْ","م ومن سُندسٍ ومن زِرْيابِ",27,"ب",1,0],["وتهطل الدهرَ فيك ديمتُهُ","لكنها عن سواك تنقشع",28,"ع",1,0],["وتِهتَ أن نِلْتَ رُتبةً وَسطاً","لا شططاً في العُلو بل أَمما",29,"م",2,0],["وَتَهيجُ سارِيَةُ الرِياحِ مِنَ أَرضِكُم","فَأَرى الجَنابَ لَها يُحَلُّ وَيُجنَبُ",30,"ب",1,0],["وَتَهَلَّلي كَالفَجرِ في هَذا الحِمى","وَتَأَلَّقي كَالخَمرِ في الأَكوابِ",31,"ب",1,0],["وَتَهجَعُ هانِئً جَذلاً قَريراً","وَقَد هَجَرَ الكَرى وَجَفا الوِسادا",32,"د",2,0],["وَتَهتِفُ الطيرُ بِها في الرُبى","فَما لَنا نَحنُ نُعَمّيها",33,"ي",3,0],["وَتَهَشُّ عِندَ لِقائِهِ وَيَغيبُ عَنكَ فَتَشتَهيه","لا يَرتَضي أَبَداً لِصاحِبِهِ الَّذي لا يَرتَضيه",34,"ي",2,0],["وَتَهتَزُّ أَعوادُ المَنابِرِ بِاسمِهِ","فَهَل ذَكَرَت أَيّامَها وَهيَ قُضبانُ",35,"ن",1,0],["وَتَهَنَّ عيداً دامَ عيدُكَ عائِداً","وَعَلَيهِ مِنكَ جَلالَةٌ وَقَبولُ",36,"ل",1,0],["وَتَهُزُّ مِنهُ الأَريحِيَّةُ ماجِداً","كَالرُمحِ لَدناً وَالحُسامِ مُجَوهَرا",37,"ر",2,0],["وَتَهُزُّهُ العَلياءُ وَال","هِندِيُّ مَهزوزٌ صَفيحُه",38,"ح",2,0],["وتَهادى النُّورَ في","تِلْكَ الفِجاجِ الدَّامسَهْ",39,"ه",1,0],["وتَهَدَّلَتْ أَغْصانُ أَيَّامي","بلا ثَمَرٍ وزَهْرِ",40,"ر",1,0],["وتهوي الغُصونُ وأوراقُها","وأَزهارُ عهدٍ حبيبٍ نَضِرْ",41,"ر",1,0],["وتهبُّ الحَيَاة سَكرى من العِط","رِ ويدْوي الوُجُودُ بالتَّغريدِ",42,"د",1,0],["وتهادتْ في أُفْق روحِكِ أَوْزانُ","الأَغاني ورِقَّةُ التَّغريدِ",42,"د",1,0],["وتَهلِكُ تِلْكََ النُّجومُ القُدامى","ويهرمُ هذا الزَّمانُ العَهيدْ",43,"د",1,0],["وتَهُدُّ من قلبي الجميلِ","فهلْ لقلبي مِنْ ذُنوبْ",44,"ب",1,0],["وتهاربت منها البقية خشيةً","من أن تنال حياتها النيران",45,"ن",1,0],["وَتَهتَزُّ المُلوكُ لَهُ","إِذا ما هَزَّ عيدانا",46,"ن",2,0],["وَتُهديكَ الثَناءَ الحُرَّ تاجاً","عَلى تاجَيكَ مُؤتَلِقاً عُجابا",47,"ب",2,0],["وتهتُّكٌ وترفرفٌ وتماجُنٌ","ورقى مخادَعةٍ على الغزلانِ",48,"ن",1,0],["وتهدي إليها في النسيمِ إِذا سرَى","لطائمُ تَحوي عنبراً ومَلابَا",49,"ب",2,0],["وَتَهتَزُّ هِزَّةَ غُصنِ الأَرا","كِ عارَضَهُ نَشرُ ريحٍ خَصِر",50,"ر",1,0],["وَتَهاوَنتَ بي لَأَن صِرتَ بِاليُس","رِ سَماءً وَصِرتُ بِالعُسرِ أَرضا",51,"ض",2,0],["وَتَهَلَّلَت لِلراغِبينَ أَسِرَّةٌ","يَضحَكنَ في وَجهٍ كَثيرِ الرَونَقِ",52,"ق",1,0],["وَتَهادَروا بِشَقاشِقٍ أَعناقُها","غُلبُ الرِقابِ قُرومُها لا توزَعُ",53,"ع",1,0],["وَتَهتَزُّ مِن تَحتِ الثِيابِ كَأَنَّها","قَضيبٌ مِنَ الرَيحانِ في وَرَقٍ خُضرِ",54,"ر",1,0],["وَتَهتَزُّ الذَوابِلُ فيهِ عُجباً","كَما اِه