www.aldiwan.net/poem34862.html","الوافر"],[444,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[444,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[454,"يحن الحبيب إلى رؤيتي","https://www.aldiwan.net/poem13947.html","المتقارب"],[455,"الجلاء الجلاء رددت الأصداء","https://www.aldiwan.net/poem61259.html","الخفيف"],[460,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[460,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[460,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[463,"لقد علم القبائل من معد","https://www.aldiwan.net/poem15160.html","الوافر"],[463,"جلا سدف المفارق نور شيب","https://www.aldiwan.net/poem15444.html","الوافر"],[463,"يظن الهوى العذري وجدي بمجده","https://www.aldiwan.net/poem15650.html","الطويل"],[463,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[466,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[466,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[466,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[470,"اسحب أبا عبد الإله","https://www.aldiwan.net/poem59532.html","مجزوء الكامل"],[502,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[502,"بالله يا ريح الصبا","https://www.aldiwan.net/poem38042.html","مجزوء الرجز"],[516,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[516,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[517,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[531,"ألا قل لمولانا الإمام مناخنا","https://www.aldiwan.net/poem37138.html","الطويل"],[540,"سال بالسحر منك خير يراع","https://www.aldiwan.net/poem47556.html","عموديه"],[540,"أيها القائد المفدى بروحي","https://www.aldiwan.net/poem47595.html","عموديه"],[540,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[540,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[546,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[553,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[553,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[553,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[560,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[560,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[560,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[569,"وتهتز في مشيها مثل ما","https://www.aldiwan.net/poem69512.html","المتقارب"],[569,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[577,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[577,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[577,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[577,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[577,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"],[577,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[577,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[577,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[955,"","https://poetry.dctabudhabi.ae/diwan/poem/28238","البسيط"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/22630","الطويل"]],"verses":[["وَتَهُزُّ أَحشاءَ البِلادِ بِضُمِّرٍ","يَرِدُ الطِعانَ أَغَرُّها وَبَهيمُها",0,"م",3,0],["وَتَهَنَّ بِالتَحويلِ غَي","رَ مُحَوَّلٍ عَن ذا المَقامِ",1,"م",1,0],["وتَهُزُّ أعْطافَ المُلوكِ كأنّها","ريحُ الشّمالِ تعثّرَتْ بغُصونِ",2,"ن",1,0],["وتَهوي إِلى البَيْتِ العَتيقِ ورَبُّها","إذا غالَ منْ تأويبهِ البيدُ أسْأَدا",3,"د",2,0],["وتَهْتَزُّ مِن شوقٍ إليهِ منابِرٌ","أطالَتْ بِه أعوادُهُنَّ التَّناجِيا",4,"ي",2,0],["وتَهُزُّ أعْطافَ الوَليِّ كأنّها","راحٌ مُشَعْشَعَةٌ براحَةِ ساقِي",5,"ق",2,0],["وتَهْنيكَ يا مَوْلَى المُلوكِ خِلافةٌ","شجَتْها تَباريحٌ إليْكَ وأشْواقُ",6,"ق",1,0],["وَتَهْلِكُ دُونَ الشَّهْدِ شَأَنَ ذُبَابَةٍ","وَمِنْ دُونِ ذَاكَ الشَّهْدِ لَمْ تَشْعُرُ السُّم",7,"م",1,0],["وتَهْوى قُلوبُ المُعْتَفينَ لظِلِّه","فتُعْمَلُ أقْتابٌ إلَيْهِ وأقْتادُ",8,"د",1,0],["وتهنّأْ بِهِ بِناءً سَعيداً","جاءَ للمَعْلُواتِ وِفْقَ اقْتِراحِ",9,"ح",1,0],["وَتَهَشُّ إِن لاقَيتَني وَتَخُصُّني","بِالبِشرِ في ناديكَ وَالتِرحابِ",10,"ب",1,0],["وَتَهُزُّني ذِكرى المُروءَةِ وَالنَدى","بَينَ الشَمائِلِ هِزَّةَ المُشتاقِ",11,"ق",1,0],["وَتَهَلْلَ النِّيلُ الوَقُورُ مُصفِّقاً","طَرَباً وَمَاجَ بِذَائِبِ العُقْيانِ",12,"ن",1,0],["وَتَهْدِي إِلَيْهَا مِنْ مَنَاجِمِ فِكْرِهِ","نَفَائِسَ أَغْلَى مِنْ كُنُوزِ المَنَاجِمِ",13,"م",1,0],["وَتَهجيرَ قَذّافٍ بِأَجرامِ نَفسِهِ","عَلى الهَولِ لاحَتهُ الهُمومُ الهُواجِسُ",14,"س",1,0],["وَتَهجُرُهُ إِلّا اِختِلاساً نَهارَها","وَكَم مِن مُحِبٍّ رَهبَةَ العَينِ هاجِرِ",15,"ر",1,0],["وَتَهجيرُنا وَالمَروُ حامٍ كَأَنَّما","يَطَأنَ بِهِ وَالشَمسُ حامِيَةٌ جَمرا",16,"ر",2,0],["وتهوى النجوم الزهرُ لو ثبتت به","ولم تكُ في أفق السماء جواريا",17,"ي",2,0],["وتَهبو له في ساحل النيل هَبوة","أبو الهول منها واجد وحزين",18,"ن",1,0],["وتهذيب الرجال أجَلّ شرط","لجعل نسائهم متهذّبات",19,"ت",1,0],["وَتَهلِكُ بَينَ الهَزلِ وَالجَدِّ مُهجَةٌ","إِذا ماعَداها البَينُ عَذَّبَها الهَجرُ",20,"ر",1,0],["وتهنّ بالأعوام نزعُ خليقها","مستأنف النعمى ولبس جديدها",21,"د",3,0],["وتهنَّا ألف عيد مثله","في مسرَّاتٍ وفي عزًّ ونصر",22,"ر",1,0],["وتهنى إقبال سيدة الوق","ت وأزكى حمى وأيمن حله",23,"ل",2,0],["وتهتزّ أعواد المنابر فرحةً","فهل رجعتْ للعهد وهي نواعم",24,"م",1,0],["وتهاديت كأني ….. ساحب","مئزري فوق جباه الأنجم",25,"م",1,0],["وتهب الرياحُ في أرض غيري","فتهب الفُزورُ فيه هُبوبا",26,"ب",2,0],["وتهاويلَ غير ذاك من الرَّقْ","م ومن سُندسٍ ومن زِرْيابِ",27,"ب",1,0],["وتهطل الدهرَ فيك ديمتُهُ","لكنها عن سواك تنقشع",28,"ع",1,0],["وتِهتَ أن نِلْتَ رُتبةً وَسطاً","لا شططاً في العُلو بل أَمما",29,"م",2,0],["وَتَهيجُ سارِيَةُ الرِياحِ مِنَ أَرضِكُم","فَأَرى الجَنابَ لَها يُحَلُّ وَيُجنَبُ",30,"ب",1,0],["وَتَهَلَّلي كَالفَجرِ في هَذا الحِمى","وَتَأَلَّقي كَالخَمرِ في الأَكوابِ",31,"ب",1,0],["وَتَهجَعُ هانِئً جَذلاً قَريراً","وَقَد هَجَرَ الكَرى وَجَفا الوِسادا",32,"د",2,0],["وَتَهتِفُ الطيرُ بِها في الرُبى","فَما لَنا نَحنُ نُعَمّيها",33,"ي",3,0],["وَتَهَشُّ عِندَ لِقائِهِ وَيَغيبُ عَنكَ فَتَشتَهيه","لا يَرتَضي أَبَداً لِصاحِبِهِ الَّذي لا يَرتَضيه",34,"ي",2,0],["وَتَهتَزُّ أَعوادُ المَنابِرِ بِاسمِهِ","فَهَل ذَكَرَت أَيّامَها وَهيَ قُضبانُ",35,"ن",1,0],["وَتَهَنَّ عيداً دامَ عيدُكَ عائِداً","وَعَلَيهِ مِنكَ جَلالَةٌ وَقَبولُ",36,"ل",1,0],["وَتَهُزُّ مِنهُ الأَريحِيَّةُ ماجِداً","كَالرُمحِ لَدناً وَالحُسامِ مُجَوهَرا",37,"ر",2,0],["وَتَهُزُّهُ العَلياءُ وَال","هِندِيُّ مَهزوزٌ صَفيحُه",38,"ح",2,0],["وتَهادى النُّورَ في","تِلْكَ الفِجاجِ الدَّامسَهْ",39,"ه",1,0],["وتَهَدَّلَتْ أَغْصانُ أَيَّامي","بلا ثَمَرٍ وزَهْرِ",40,"ر",1,0],["وتهوي الغُصونُ وأوراقُها","وأَزهارُ عهدٍ حبيبٍ نَضِرْ",41,"ر",1,0],["وتهبُّ الحَيَاة سَكرى من العِط","رِ ويدْوي الوُجُودُ بالتَّغريدِ",42,"د",1,0],["وتهادتْ في أُفْق روحِكِ أَوْزانُ","الأَغاني ورِقَّةُ التَّغريدِ",42,"د",1,0],["وتَهلِكُ تِلْكََ النُّجومُ القُدامى","ويهرمُ هذا الزَّمانُ العَهيدْ",43,"د",1,0],["وتَهُدُّ من قلبي الجميلِ","فهلْ لقلبي مِنْ ذُنوبْ",44,"ب",1,0],["وتهاربت منها البقية خشيةً","من أن تنال حياتها النيران",45,"ن",1,0],["وَتَهتَزُّ المُلوكُ لَهُ","إِذا ما هَزَّ عيدانا",46,"ن",2,0],["وَتُهديكَ الثَناءَ الحُرَّ تاجاً","عَلى تاجَيكَ مُؤتَلِقاً عُجابا",47,"ب",2,0],["وتهتُّكٌ وترفرفٌ وتماجُنٌ","ورقى مخادَعةٍ على الغزلانِ",48,"ن",1,0],["وتهدي إليها في النسيمِ إِذا سرَى","لطائمُ تَحوي عنبراً ومَلابَا",49,"ب",2,0],["وَتَهتَزُّ هِزَّةَ غُصنِ الأَرا","كِ عارَضَهُ نَشرُ ريحٍ خَصِر",50,"ر",1,0],["وَتَهاوَنتَ بي لَأَن صِرتَ بِاليُس","رِ سَماءً وَصِرتُ بِالعُسرِ أَرضا",51,"ض",2,0],["وَتَهَلَّلَت لِلراغِبينَ أَسِرَّةٌ","يَضحَكنَ في وَجهٍ كَثيرِ الرَونَقِ",52,"ق",1,0],["وَتَهادَروا بِشَقاشِقٍ أَعناقُها","غُلبُ الرِقابِ قُرومُها لا توزَعُ",53,"ع",1,0],["وَتَهتَزُّ مِن تَحتِ الثِيابِ كَأَنَّها","قَضيبٌ مِنَ الرَيحانِ في وَرَقٍ خُضرِ",54,"ر",1,0],["وَتَهتَزُّ الذَوابِلُ فيهِ عُجباً","كَما اِهتَزَّت مِنَ المَرَحِ القُدودُ",55,"د",1,0],["وتهدي له كفُّ تصولُ على العدا","إلى كفّ ميمون المضاءِ المصمّم",56,"م",1,0],["وتهمي من أنامِلِهِ العَطايا","فتحسبُها غيوماً للغيومِ",57,"م",1,0],["وَتَهُبُّ لي بِعَجاجِ مَوكِبِكَ الصَبا","إِنَّ السَماحَةَ تَحتَ ذاكَ القَسطَلِ",58,"ل",1,0],["وَتَهوانا وَنَهواها","وَنَعصي قَولَ مَن عَذَلا",59,"ل",2,0],["وَتُهوي إِلى لَثمِ البِساطِ وَإِنَّما","تُصَلّي إِلى رُكنِ المَعالي فَتَسجُدُ",60,"د",1,0],["وَتَهُزُّ مِنكِ فَتَنثَني","بِقَضيبِ قَدِّكِ ريحُ سُكرِك",61,"ك",1,0],["وَتُهدي إِلَيكَ الريحُ عَنها تَحِيَّةً","تَفوهُ بِما تَحتَ الضُلوعِ فَتَنطِقُ",62,"ق",1,0],["وَتَهفو صَبا نَجدٍ بِهِ طيبَ نَفحَةٍ","فَيَلقى صَبا نَجدٍ بِما كانَ لاقِيا",63,"ي",2,0],["وَتَهتَزُّ لَيلى العامِريَّةُ فَوقَها","وَلاثَت بِسِبِّ القَزِّ ذا غُدُرٍ جَعدا",64,"د",2,0],["وتهتف باسمك الدنيا فتبقى","ومثلك ليس يدركه الذهاب",65,"ب",1,0],["وَتَهاوى الطُيور عَن شَجر الخل","د تَغَنّى بِأَعذَب الأَلحان",66,"ن",1,0],["وتُهَزُّ ألويَةُ الجنودِ خَوافِقاً","تحتَ العَجاجِ كَواسِراً عِقبانها",67,"ن",3,0],["وتهاديك بالرقا","ع إذا خفتَ من وَشا",68,"ش",2,0],["وتهمةِ المجان","ونخوةِ النشوانِ",69,"ن",1,0],["وَتَهتَجِرُ النِساءَ إِلى هَواها","كَأَنَّكَ ضامِنٌ مِنهُنَّ نَحبا",70,"ب",2,0],["وَتَهزَأُ مِنهُ رَبّاتُ المَغاني","كَما هَزِئَت بِرُؤبَةَ أُمُّ حَمزِ",71,"ز",1,0],["وَتَهلِكُ ذاتُ الكَرا","وَتَهلِكُ ذاتُ الخَدَل",72,"ل",1,0],["وَتَهلِكُ أَعيانُ الرِجالِ وَإِنَّما","مَصارِعُ أَعيارٍ كَمَصرَعِ أَعيانِ",73,"ن",1,0],["وتَهَنَّ النُّعْمى السّنيّةَ والْبَسْ","حُلَلَ المَجْدِ والفَعَالِ الخَطيرِ",74,"ر",1,0],["وتهدي له الريحان ريانَ نافحاً","وما أنضر الريحانَ في البلد الخصب",75,"ب",1,0],["وتهضمتني وآلمت قلبي","بتجرِّيك أيما إيلامِ",76,"م",1,0],["وتهرب الأنجم هذي وَذِي","ويجثم الليل على القاهره",77,"ه",1,0],["وتَهْوِى إِذَا العِيسُ العِتَاقُ تَفَاضَلَتْ","هُوِيَّ قَدُومِ القَيْنِ