{"poems":[[88,"قالوا صدقت فكان الصدق ما قالوا","https://www.aldiwan.net/poem68960.html","البسيط"],[74,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[53,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[72,"قالوا النبيه فقلت أه","https://www.aldiwan.net/poem43002.html","مجزوء الكامل"],[64,"قالوا صبرت على المكروه من نفر","https://www.aldiwan.net/poem52427.html","البسيط"],[82,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[33,"ما كنت أشعر إلا مذ عرفتكم","https://www.aldiwan.net/poem42519.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[119,"قالوا صبرت وقد أوذيت قلت لهم","https://www.aldiwan.net/poem41743.html","البسيط"],[168,"قالوا صحوت فقلت تأبى لوعة","https://www.aldiwan.net/poem67857.html","الكامل"],[190,"قالوا صديقك والرفيق معا","https://www.aldiwan.net/poem43633.html","الكامل"],[215,"قالوا صحيح فقلت كلا","https://www.aldiwan.net/poem46352.html","مخلع البسيط"],[463,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130162","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48767","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145807","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138142",""],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16847","الكامل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111177","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26676","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118973","الكامل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132927","الكامل"],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[5135,"قالوا : صدَدْتَ !!","https://www.poetsgate.com/ViewPoem.aspx?id=201845",""],[5186,"قالوا: صناعاتنا بارت، فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=156496",""],[5444,"رسالةٌ إلى نجم آفل","https://www.poetsgate.com/ViewPoem.aspx?id=205071",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["قالوا صَدَقتَ فَكانَ الصِدقَ ما قالوا","ما كُلُّ مُنتَسِبٍ لِلقَولِ قَوّالُ",0,"ل",1,1],["قالوا صغيراً قلت إنَّ وربما","كانت به الحسرات غير صغار",1,"ر",1,0],["قالوا صديقك سيدٌ","بادي النباهةِ غيرُ خاملْ",2,"ل",1,0],["قالوا صَديقُكَ قُلتُ أَع","رِفُهُ الصَديقَ المُجتَبى",3,"ب",2,0],["قالوا صبرتَ على المكروهِ من نَفَرٍ","لو شئتَ حكَّمْتَ فيهمْ كفَّ مُنتَصِرِ",4,"ر",1,1],["قالوا صَبَا يا مَن رأى مستهامْ","حِجاهُ كهْلٌ وَهَوَاهُ غُلامْ",5,"م",1,1],["قالوا صَبَوتَ فَلَم أُكذِب مَقالَتَهُم","وَلَيسَ يَنسى الصِبى إِن والِهٌ كَبِرا",6,"ر",2,0],["قالوا صَغير لا يعد","دُ من الفحول وَلَن يعدّا",7,"د",2,0],["قالوا صبرت وقد أوذيت قلت لهم","صبرت والصبر للخيرات مفتاح",8,"ح",1,1],["قالوا صَحَوتَ فَقُلتُ تَأبى لَوعَةٌ","في القَلبِ يَلذَعُ جَمرُها بَل يَحرِقُ",9,"ق",1,1],["قالوا صديقك والرفيق معا","يتوليانك في الشدائد أجمعا",10,"ع",2,1],["قالوا صحيحٌ فقلت كلا","ما صحّ من رشده قليل",11,"ل",1,1],["قالوا صحوتَ من الجنونِ به","من ردَّ جِنّتَه على عقلي",12,"ل",2,0],["قالوا صحبت المرد مكرا لكي","تنهيهم عن خسة النفس",13,"س",1,1],["قالوا صديق للعدو وما لهم","بك عنده عادوا إلى الأعداء",14,"ا",2,0],["قالوا صَدِئتِ ومعذورون َلوْ صَدِئَت","سُعَيفة ٌصاح َفيها جَذعُها التمِعِي",15,"ع",2,0],["قالوا صمتَّ وكنت الطائر الغردا","حتى كأنك لم تُشج الورى أبدا",16,"د",2,1],["قالوا صَبَرتَ وَما صَبَرتُ جَلادَةً","لَكِن لِقِلَّةِ حيلَتي أَتَصَبَّرُ",17,"ر",1,1],["قالوا صدور لنا وأخشى","تشهد بالمدعى المبين",18,"ن",1,0],["قالوا صَدَقت المال قالَ ذَلِكا","لَولاه ما كُنت لرشدٍ تارِكا",19,"ك",2,0],["قالوا صحا وأدال الغيَّ بالرَّشَدِ","من لي بذاك الصِّبا في ذلك الفَنَدِ",20,"د",1,1],["قالوا صبا فأجبتهم","هيا إِلى الرشأ الرخيم",21,"م",1,0],["قالوا صَحَا قَلبُ المُحبِّ وما صَحَا","ومحا العِذارُ سَنَا الحبيبِ وما محا",22,"ح",2,1],["قالوا صدقت فما عبناك من كذبٍ","أنت الأمين وخير الناس كلهم",23,"م",1,0],["قالوا صدَدْتَ وما منْ طبْعك الصَّدُّ","قلْتُ ارْحَمُوْني فصبْري ليْس يمْتَدُّ",24,"د",1,1],["قالوا: صناعاتنا بارت، فقلت لهم:","لا بل يروج بأهليها الصناعات",25,"ت",1,1],["قالوا صلاحُ الدينِ يلمعُ سيفُه","ويثيرُ نقعَ الفاتحين خيولا",26,"ل",2,0],["قالوا صبأت أيا محمد فارتجع","إن تذكر الأصنام سوف تبيد",27,"د",1,0],["قالوا صحيح الربع ملان مدهم","وَمد انتلا لا بُد ما يَنهال",28,"ل",1,0]]}