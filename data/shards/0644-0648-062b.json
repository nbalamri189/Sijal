{"poems":[[53,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[92,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[143,"صبحها الدمع ومساها الأرق","https://www.aldiwan.net/poem58425.html","الرجز"],[196,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[459,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[459,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"]],"verses":[["لَوثُ خِمارِ الصُبحِ في رَأسِ العَلَم","نَفسَكَ إِنَّ الخَيلَ بِالقَومِ زِيَم",0,"م",1,0],["لوَّثَتْهُ الحَيَاةُ ثمَّ استمرَّتْ","تبذُرُ العالَمَ العَريضَ شُرورا",1,"ا",1,0],["لو ثبتَ السهمُ الذي أرسلتِه","في القلبِ وافقتُكِ لكن قد مرَقْ",2,"ق",1,0],["لَو ثَوى لا يَريمُها أَلفُ حَولٍ","لَم يَطُل عِندَها عَلَيهِ الثَواءُ",3,"ا",2,0],["لو ثنى لي راجعاً من عِطفه","لا ولكن ساعةٌ منه أنيقَهْ",4,"ق",2,0],["لو ثاقلوك به وأُلقِيَ يَذبُلٌ","معه لكانت قِسمةً ما عُدّلتْ",5,"ت",1,0]]}