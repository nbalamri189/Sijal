{"poems":[[55,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[94,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[146,"صبحها الدمع ومساها الأرق","https://www.aldiwan.net/poem58425.html","الرجز"],[199,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[463,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126649","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77232","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201033","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216556",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143832","البسيط"],[5032,"حال شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=191236",""],[5193,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=213571",""],[5431,"مفتاح باب الخلد أحجيتي","https://www.poetsgate.com/ViewPoem.aspx?id=199777",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5952,"مَايا","https://www.poetsgate.com/ViewPoem.aspx?id=202877",""],[6056,"أبجدية حروفك","https://www.poetsgate.com/ViewPoem.aspx?id=130326",""]],"verses":[["لَوثُ خِمارِ الصُبحِ في رَأسِ العَلَم","نَفسَكَ إِنَّ الخَيلَ بِالقَومِ زِيَم",0,"م",1,0],["لوَّثَتْهُ الحَيَاةُ ثمَّ استمرَّتْ","تبذُرُ العالَمَ العَريضَ شُرورا",1,"ا",1,0],["لو ثبتَ السهمُ الذي أرسلتِه","في القلبِ وافقتُكِ لكن قد مرَقْ",2,"ق",1,0],["لَو ثَوى لا يَريمُها أَلفُ حَولٍ","لَم يَطُل عِندَها عَلَيهِ الثَواءُ",3,"ا",2,0],["لو ثنى لي راجعاً من عِطفه","لا ولكن ساعةٌ منه أنيقَهْ",4,"ق",2,0],["لو ثاقلوك به وأُلقِيَ يَذبُلٌ","معه لكانت قِسمةً ما عُدّلتْ",5,"ت",1,0],["لو ثلّثت ربت وثمّت إنما","مع شبهها ومنه ذو سبع نما",6,"م",2,0],["لوثوا عرضهم فهم لا يبالو","ن إذا قيل عرضكم صار قذرا",7,"ر",2,0],["لَوَثِقتِ أَنَّ هَواكِ أَو","فى بي عَلى القدرِ المُتاحِ",8,"ح",1,0],["لو ثبتت سكنتُ في بعضها","وطاب لي عيش بها أرغد",9,"د",1,0],["لو ثاروا اخوالي ولعمام","دَمّي برايَه فِيْ الهوى يضيع",10,"ع",1,0],["لوثت جوهري الشريف به الأق","ذار منه وزادت الاكدار",11,"ر",1,0],["لو ثار ما اقتدحته النفس من هممي","لصكَّ ناصية الجوزاء ملتهبا",12,"ب",2,1],["لو ثُرتُ حتى في السّكوتِ فَثَوْرتي","في داخلي نوعٌ مِنْ\"الأفيونِ\"",13,"ن",1,0],["لوّثتْ طُهرَكِ الطّهورَ أفاع ٍ","حشوُها الحقدُ والردى والعذابُ",14,"ب",1,0],["لو ثعرك الولهان يُنصفني","لو أنّه يحفى بأمنيتي",15,"ت",2,0],["لوَّثَ الماءَ والغذاءَ فصرنا","ننظرُ اليوم للبديل اصْطِناعا !",16,"ع",2,0],["لو ثَوَتْ في (الأزدِ) قال (الشنفرى)","\" لا تقيموا مِنْ صدورٍ للمَطايا \"",17,"ا",3,0],["لوثبت حبي الصادق ، بواقع كشوفك","ما سهرت آتوجد ، يالغزال ، الفريد",18,"د",1,0]]}