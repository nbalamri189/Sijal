{"poems":[[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[53,"إذا حاولت تطفيلا","https://www.aldiwan.net/poem61986.html","الهزج"],[190,"أغذى بخبز الأرض ما دمت فوقها","https://www.aldiwan.net/poem43667.html","الطويل"],[482,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[545,"أغذو تلادا من الأشعار أصلحها","https://www.aldiwan.net/poem56705.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122607","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201943","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201055","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200778","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202949","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202905","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200079","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26977","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132125","الوافر"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102755","الطويل"],[4978,"أغذ سيري لوعد فيه مرآكا","https://www.poetsgate.com/ViewPoem.aspx?id=177362",""],[5219,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[5431,"وما الكره إلا هلاك سعى!!....","https://www.poetsgate.com/ViewPoem.aspx?id=199939",""],[5956,"أغذي الناس بالشَّجَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=185732",""],[5956,"أُغذي الجسم يا ربي لأقوى","https://www.poetsgate.com/ViewPoem.aspx?id=192645",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""]],"verses":[["أَغَذَّ بِها الإِدلاجَ كُلُّ شَمَردَلٍ","مِنَ القَوم ضَربِ اللَحمِ عاري الأَشاجِعِ",0,"ع",1,0],["أغذَّ السير من آمُ","لَ للتطفيل إغذاذا",1,"ذ",2,0],["أغذّى بخبز الأرض ما دمت فوقها","مقيما فإن أقبر تغذّى بيَ الأرض",2,"ض",1,1],["أُغذُّ ومِن تحتِ الرفاقِ أيانِقٌ","لواغبُ يتبعنَ النجيبَ المزممَّا",3,"م",2,0],["أَغذو تِلاداً مِن الأَشعارِ أُصلِحُها","صَلاحَ ذي الحَزمِ لِلحاجاتِ وَالرِتَلِ",4,"ل",1,1],["أغذَذتَ في دَرَج السُّمُوّ وعاقَهُم","بُخلٌ فثَبَّطَهم عَنِ الإغذاذ",5,"ذ",1,0],["أغذو العقول بالعلوم الشافيه","لكي تنال في المعاد العافية",6,"ه",1,0],["أُغذّي الشِعر من روحي وقلبي","وإن كان الغِذاءُ لي القَصيدا",7,"د",2,1],["أُغذّي قريضي من فظائع رفقتي","وأنعش شعري من أساي وأكداري",8,"ي",1,1],["أغذّي جليسي من وساوس فكرتي","وأسكن ضيفي في بيوت من الشّعر",9,"ر",1,0],["أغذّي بربّ الفن روحي ولم أملْ","إلى غيره إلا إذا اضطرّني الجسمُ",10,"م",1,0],["أغذّي الحب وهو غذاءُ روحي","ويعبدني وأعبده الجمال",11,"ل",1,0],["أغذّيه من جهدي فيزداد ضعفه","وأوسعه عزاً فيوسعني خفضا",12,"ض",2,0],["أَغُذُّ السُرى فيها إِذا الشَربُ أَنكَروا","وَرَهنِيَ عِندَ العِلجِ ثَوبي مِنَ الفِجرِ",13,"ر",1,0],["أغذّ إلى صميم القلب حتى","كأن الصدر ليس به عظام",14,"م",1,0],["أغذوا السرى يبغون خير بنية","أعدت لوفد اللَه أمنا ومعقلا",15,"ل",2,0],["أغذ سيري لوعد فيه مرآكا","تكاد تخرج روحي قبل ألقاكا",16,"ك",2,1],["أغذ السير لا ألوي عنانا","ولا أخشى حسيبا أو رقيبا",17,"ب",2,0],["أُغذّي بشعري احتياج النُهى","وأطعمُ حرفي لمن جُوّعا",18,"ع",2,0],["أغذِّي الناس بالشَّجَنِ","كما لو كان من مؤنِ",19,"ن",1,1],["أُغذي الجسم يا ربي لأقوى","على رد الوفاء إليك حلْوا..",20,"و",2,1],["أُغذِّي الناس من فكري لأني","حباني الله روحاً أرْيحيَّةْ",21,"ي",2,0],["أُغَذِّيهِ مِن رُوحِي ، وأَسقِيهِ مِن دَمِي","فَلا تَعذُلِي شِعراً ، لِجَدبِي هُوَ القَطرُ",22,"ر",1,0]]}