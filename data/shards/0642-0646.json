5",""],[5009,"بنت قنا","https://www.poetsgate.com/ViewPoem.aspx?id=24371",""],[5010,"الحقيقة تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=189862",""],[5026,"منبطحون على رصيف الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=211278",""],[585,"ليتني كنت شارداً أجنبياً","https://www.poetsgate.com/ViewPoem.aspx?id=161850",""],[5145,"نعم حلب العين اعتراف الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=108071",""],[5152,"من وحيها","https://www.poetsgate.com/ViewPoem.aspx?id=186231",""],[5268,"باسمِكِ أستنيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206994",""],[5388,"قناديل الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=206919",""],[5401,"أنا القمر","https://www.poetsgate.com/ViewPoem.aspx?id=85473",""],[5431,"الحسين -سبط رسول الله-","https://www.poetsgate.com/ViewPoem.aspx?id=199897",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[351,"وسِرْبٍ كَعَيْنِ الدِّيكِ مَيلٍ إلى الصّبا","https://www.poetsgate.com/ViewPoem.aspx?id=4529",""],[5458,"الاخلاق قبل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=72160",""],[5464,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=772",""],[5516,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=213989",""],[5525,"بالي","https://www.poetsgate.com/ViewPoem.aspx?id=843",""],[5536,"براءة ً وفضولا!!","https://www.poetsgate.com/ViewPoem.aspx?id=19890",""],[5618,"قطرات من مطر وعطر","https://www.poetsgate.com/ViewPoem.aspx?id=208934",""],[5756,"الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=5179",""],[5776,"ذو المعصم الواحدة","https://www.poetsgate.com/ViewPoem.aspx?id=199400",""],[5794,"هلا يا صاح","https://www.poetsgate.com/ViewPoem.aspx?id=80283",""],[5831,"بيت جالا","https://www.poetsgate.com/ViewPoem.aspx?id=20387",""],[5848,"عطني زايد","https://www.poetsgate.com/ViewPoem.aspx?id=48809",""],[5956,"قناديل عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182182",""],[5977,"حب طويل الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=213082",""],[6102,"وطن ولا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=182752",""],[520,"أيا اذن الأيام ان قلت فاسمعي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577575",""],[6189,"خميرة الممكنات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83561&r=&rc=28",""],[6225,"غزة ليستْ أوّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80805&r=&rc=160",""],[463,"سلْ أبرقَ الحنَّانِ واحبسْ بهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60166&r=&rc=222",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""]],"verses":[["قَنا آلِ فِهرٍ لا قَنا غَطَفانِ","حَمَت أَهلَها مِن طارِقِ الحَدَثانِ",0,"ن",1,1],["قَناةٌ نَحنُ أَملَسُها وَأَنتُم","مَكانُ العابِ مِنها وَالوُصومِ",1,"م",1,0],["قَنَصتُ بِجَمعٍ شادِناً فَرَحَمتُهُ","وَأَخفَقَ قَنّاصٌ يَكونُ رَحيما",2,"م",2,0],["قَنابِلٌ تَحفِزُها","إِلى الرَدى قَنابِلُ",3,"ل",1,0],["قَنِعتُ فَعِندي كُلُّ مَلكٍ نُزولُهُ","عَنِ العِزِّ وَالعَلياءِ مِثلُ رُكوبِهِ",4,"ب",2,0],["قَنِعْتُ وَرَيْعانُ الشَّبابِ بِمائِهِ","وَلَمْ يَتَبَسَّمْ وافِدٌ الشَّيْبِ في الرَّاسِ",5,"س",1,1],["قَنِعْتُ بطَيْفٍ منْ خَيالِكِ طارِقٍ","وأيُّ خَيالٍ يَهْتَدي لخَيالِ",6,"ل",1,0],["قَنَعتُ بِالقوتِ مِن زَماني","وَصُنتُ نَفسي عَنِ الهَوانِ",7,"ن",1,1],["قنِعْتُ وحظّي منْ زَماني ووُدِّكُمْ","هَباءٌ ومثْلي ليسَ يقْنَعُ بالنّزْرِ",8,"ر",1,0],["قَنواءُ في حُرَّتَيها لِلبَصيرِ بِها","عِتقٌ مُبينٌ وَفي الخَدَّينِ تَسهيلُ",9,"ل",1,0],["قَنِعتُ بِالقُطنِ في الوِسادِ","وَفي الحَشِيّاتِ وَالغِطاء",10,"ا",2,0],["قَناةُ الأَلأَمينَ قَناةُ تَيمٍ","مُبَيَّنَةُ القَوادِحِ وَالوُصومِ",11,"م",1,0],["قناةُ حُشٍّ غدتْ ظُلماً تُكلفني","سَدِّي ببعضيَ ما فيها من الثُّقَبِ",12,"ب",1,0],["قِني يا إلهي شحَّ نفسي فإنني","أرى الجودَ لي حظاً وشيمتي البخلُ",13,"ل",1,1],["قنَّعَ الرأسَ ثم لثَّم وجهي","وكفى بالقِناع دونَ اللثام",14,"م",1,0],["قَنواءَ نَضّاخَةِ الذِفرى مُفَرَّجَةٍ","مِرفَقُها عَن ضُلوعِ الزَورِ مَفتولُ",15,"ل",1,0],["قِني البَأس وَاِمنَع شَعبَكَ الضَعفَ يَتَّقي","وَيُنصِفُهُ مِن حُسّادِهِ مَن يُناكِرُه",16,"ر",2,0],["قَنِعتُ بَأَنّي في ضَميرِكَ حاضِرٌ","وَأَنَّكَ لي بَعضَ الأَحايِينِ ذاكِرُ",17,"ر",1,0],["قَناةٌ مِنَ المُرّانِ ما فَوقَ حَقوِها","وَما تَحتَهُ مِنها نَقاً يَتَهَيَّلُ",18,"ل",1,0],["قَناةٌ مِنَ المُرّانِ ما فَوقَ حَقوِها","وَما تَحتَهُ مِنها نَقاً يَتَقَصَّفُ",19,"ف",1,0],["قَنَّعوا بِالتُرابِ وَجهاً كَريماً","كانَ مِن رُفعَةِ الحَياءِ قِناعُه",20,"ع",2,0],["قَنِعتُ عَلى كَرهٍ وَطَأطَأتُ ناظِري","إِلى رَنقِ مَطروقٍ مِنَ العَيشِ حَشرَجِ",21,"ج",1,0],["قَنِعتُ وَجانَبتُ المَطامِعَ لابِساً","لِباسَ مُحِبِّ لِلبَراءَةِ مُؤثِرِ",22,"ر",1,0],["قَناعَةٌ تَتبَعُها هِمَّةٌ","مُشتَبِهٌ فيها الغِنى وَالقُنوع",23,"ع",1,0],["قَنيتُ عَزاءً عَن شُجونٍ أُضيفُها","إِلَيَّ وَعَن أَسرابِ دَمعٍ أُجيلُها",24,"ل",3,0],["قَنِعوا بِمَيسورِ الفَعالِ وَأوهِموا","أَنَّ المَكارِمَ عِفَّةٌ وَقُنوعُ",25,"ع",1,0],["قَنافِذُ دَرّامونَ خَلفَ جِحاشِهِم","لِما كانَ إِيّاهُم عَطِيَّةُ عَوَّدا",26,"د",2,0],["قَنواءُ حَصّاءُ المُقَوَّسِ نَبعَةٌ","مِثلُ السَبيكَةِ إِذ تُمَلُّ وَتُشسَبُ",27,"ب",1,0],["قَنِّعِ النَفسَ بِالكِفافِ وَإِلّا","طَلَبَت مِنكَ فَوقَ ما يَكفيها",28,"ي",3,0],["قَنى الحَمدَ ثَوباً لِلفَذخارِ وَإِنَّهُ","عَلى جِدَّةِ الأَيّامِ لَم يَتَخَرَّقِ",29,"ق",1,0],["قَناعَةُ المَرءِ بِما عِندَهُ","مَملَكَةٌ ما مِثلُها مَملَكَه",30,"ه",1,1],["قَنِعتُ بِالوُدِّ مِنهُم","إِنَّ القَناعَةُ مُلكُ",31,"ك",1,0],["قَنَعتُ بِالطيفِ لَمَّا صَدَّ صاحبُهُ","وَالطيبُ إِن غابَ أَبقى عِندَكَ العبقا",32,"ق",2,0],["قناةٌ من الشّمْعِ مَرْكوزةٌ","لها حَرْبَةٌ طُبِعَتْ من لهب",33,"ب",1,1],["قنعتُ والقتعُ يعزُّ الفتى","لما رأيتُ الحرصَ ذلَّ الكرامْ",34,"م",1,0],["قنعتُ فخلتُ النجمَ دوني رتبةً","وهيهاتَ خوفُ الفقرِ عندَ الغنى فقرُ",35,"ر",1,0],["قَنعنا بالرّوايةِ وانكفأنا","نُهيبُ بقومِنا في القاعدينا",36,"ن",2,0],["قَنِيصةُ نافذِ الأظفارِ ضَارٍ","له في كلِّ ذي ظُفُرٍ شَباةُ",37,"ه",1,0],["قنعتُ بالشِّعرِ أغزو المشرِكينَ به","فلم أُصِبْ فيه آمالي ولم أنلِ",38,"ل",1,0],["قَنِعتُ عَلى رُغمي بِذِكرِكَ وَحدَهُ","أُديرُ عَلَيهِ الخَمرَ وَالأَدمُعَ الحُمرا",39,"ر",2,0],["قُنِّعَ الأَنصافُ مِنها العُلى","فَهيَ غُرٌّ بِالخَنيفِ الشَآم",40,"م",1,0],["قُنَّعَ الرَأسُ مَشيباً","وَاِكتَسى لَونَ الشَمَط",41,"ط",1,1],["قَنِعتُ إِذ نِلتُ مِن أَحبابِيَ النَظَرا","وَقُلتُ يا رَبِّ ما أَعطَيتَ ذا بَشَرا",42,"ر",2,1],["قَنفاءُ ذاتُ عَذَبٍ نَوايِسِ","يَهوعُ فوها كَهُواعِ القالِسِ",43,"س",1,0],["قُنِيُّ فَوارِسٍ ما كانَ مِنهُم","فَوارِسُ رَحرَحانَ وَلا النِسارِ",44,"ر",1,0],["قَنِعْتُ فخِلْتُ أنّ النجْمَ دوني","وسِيّانِ التّقَنّعُ والجِهادُ",45,"د",1,0],["قَنَعَ الصوفيُّ منها بالحَبابْ","وهيَ تنهلُّ بكأسِ الشاعرِ",46,"ر",1,0],["قُنْفُذٌ أَوْقَد مِن أَشْوَاكِهِ","شِكَّةً لاحَتْ بِهَا الأَلْوَانُ كُثْرَا",47,"ر",2,0],["قَناتي عَلى ما تَعهَدانِ صَليبَةٌ","وَعودي عَلى ماتَعلَمانِ صَليبُ",48,"ب",1,1],["قنص الفتاة بفقرها وشقائها","وبما تكابد من أسى وتلاقي",49,"ق",2,0],["قَنعتُ بِالطَيفِ وَاِنتِحابي","يَمنَعُ مِن طَيفِكَ الطَروقِ",50,"ق",1,0],["قَنِعتُ بِوَصلِ الطَيفِ إِن قادَهُ الكَرى","وَكَيفَ رُقادي وَالمَدامِعُ ما ترقى",51,"ق",2,0],["قَنِعْنا بما دُونَ القَليلِ ولَمْ تَكُنْ","بِغَيْرِ جَلِيلاتَ المَطَالب تَقْنَع",52,"ع",1,0],["قَنَصَتْ بَنَاتُ الدَّهْرِ واحِدَ دَهْرِهِ","ورَمَتْهُ مِنْ أَدْوائِها بعُضَال",53,"ل",1,0],["قنعوا بالحياة شمسا ومرعى","واطمأنوا للماء والغدران",54,"ن",1,0],["قناعه المرء بما يمنى له","من حظه في عيشه خير المنى",55,"ا",1,0],["قنديل يسهو كالغافي","ويعي كغبي يتفطّن",56,"ن",1,0],["قنعت بالنواح منك فلّما","زال عاشت بذكريات نواحك",57,"ك",1,0],["قنعا بِما قَسم الإِل","ه وَما بِهِ قَد أَحسَنا",58,"ن",2,1],["قنك افنى الهجر طوق كله","آماله من ناره امان",59,"ن",1,0],["قنعت فيه ولا قنعت ذا كبدٍ","حَرَّا ولا أقنَعَنْ بغير ما الرَّتَلِ",60,"ل",1,0],["قناديل خلق من مصابيح قلبه","حياة لروح الروح حقاً وواضحا",61,"ح",2,0],["قَناً تَمضي مُصَمِّمَةً فَتَقضي","لِسَكرانِ الغَوايَةِ أَن يُفيقا",62,"ق",2,0],["قَناً جَدَّلَ الفُرسانَ قَبلَ اِنحِطامِهِ","وَنابَت سُيوفُ الهِندِ لَمّا تَحَطَّما",63,"م",2,0],["قَنِعتُ بَجمرٍ لَم يَلُح لِيَ سِرُّهُ","وللنَّارِ إشراقٌ وللسَّيفِ رَونَقُ",64,"ق",1,0],["قناة العز في تلك الرماح","وبين مضارب البيض الصفاح",65,"ح",1,1],["قناعةُ المرءِ كيمياءٌ","صَحَّتْ وكنزٌ وأيُّ كنز",66,"ز",1,0],["قناديلٌ مُشرِّفة الأَعالي","تشبُّ بهن ألسنةُ الذُّبال",67,"ل",1,0],["قنعت من الدنيا بأدنى معيشة","تقاصر عنّي مرّة وتطول",68,"ل",1,1],["قنعت مضطرا لضعف القوى","عن نيل ما يدركه الساعي",69,"ع",2,0],["قنوع من الدنيا بثوب وشبعة","وذلك خير عن شكرت كثير",70,"ر",1,0],["قَناً لَقىً وقِسيٌّ غَيرُ موتَرَةٍ","وَالخَيلُ عازِبَةٌ تَرعى مَع الهَمَلِ",71,"ل",1,0],["قنصت عقول أَولى النهي بحبائل","الصبوات لا بِحَبائل الصياد",72,"د",1,0],["قَنَاعَةُ عِزٍّ لاَ طَمَاعَةُ ذِلَّةٍ","تُزَهِّدُ في نَيْلِ الْغِنى كُل رَاغِبِ",73,"ب",1,0],["قَناتُهُ لَم تَلِن يَوماً لِغامِزِها","لَكِنَّها في فُؤادِ الخَصمِ تَنحَطِمُ",74,"م",1,0],["قَناةٌ أَنابيبُها ظامِئاتٌ","بِها ثَعلَبٌ مِن دَمِ الأُسدِ يُسقى",75,"ق",2,0],["قنعت بالعود إلى منزلي","وذاك دأب المرء في خيبته",76,"ه",1,1],["قَنوعاً بِما أَعطاكَ مُستَغنِياً بِهِ","لَهُ حامِداً في حالي اليُسرِ وَالعُسرِ",77,"ر",1,0],["قنابل من قحطان لم يرَ مثلهم","إذا الصدع أعبا رأيه كل شاعب",78,"ب",1,1],["قَنْطَرَةٌ قَدْ بُنِيَتْ","وَصُوِّرَتْ مِن المُلَحْ",79,"ح",1,1],["قَنَوات كَأَنَّها الزَرد المَن","ظوم وَقت الهَيجاء تَحتَ اللِواء",80,"ا",2,0],["قناةُ ظَلْماءَ ما تَنْفَكُّ يأكُلها","سِنانُها طُولَ طَعْنٍ أو يُشَظّيها",81,"ي",3,0],["قَنَصٌ طَرْفُه أَشدُّ سهاماً","حين تَلْقاهُ من يَدِ القَنّاص",82,"ص",1,0],["قنَأْتُ حَيائي لها واصطَبرت","وطالَ قيامي لها والقُعود",83,"د",1,0],["قنعت بمصدرها وحلت أربُعاً","ومنازلاً بفراقها لم تَقنع",84,"ع",1,0],["قنع المُشتاق مِن طَي","فك بِالوَعد الكَذوب",85,"ب",1,0],["قنديل تسبيحها يا ليل يسعده","وصيته عندها من أفضل الرسل",86,"ل",1,0],["قنعتم بأخذ السحتِ منهم وبالرُّشَا","ودافعتم عنهم بسيف المعاذر",87,"ر",1,0],["قنوعاً من الدنيا كفاه كفافُهَا","تَسَرْبَلَ فيها بالقناعة والزهد",88,"د",1,0],["قنص الفؤاد من الحليم بمقلةٍ","سحارةٍ قنصت رشا عسفان",89,"ن",1,0],["قَناعَةُ المَرْءِ الرِّضَى","وَحِرْصُهُ أَقْصى الْعَدَمْ",90,"م",1,1],["قنعت به والحر إن عز مطلب","سيغنيه عن ذل السؤال قنوعه",91,"ع",2,0],["قَنَّعْتُها الصَّبْرَ الجَميلَ فأَسْفَرَتْ","فِي آلِ يَحْيى عن جميلِ عواقِبِ",92,"ب",1,0],["قني يا رب لطفاً شح نفسي","ورضها في رضاك يكن رضاه