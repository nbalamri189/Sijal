net/poem56091.html","السريع"],[456,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[456,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[456,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[459,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[462,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[466,"قنوعي بدون الدون لا نقص همة","https://www.aldiwan.net/poem59918.html","الطويل"],[466,"قنوعي بدون الدون لا نقص همة","https://www.aldiwan.net/poem59932.html","الطويل"],[475,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[475,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[475,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[502,"أباهي بوجد قد تمكن في الحشا","https://www.aldiwan.net/poem38408.html","الطويل"],[512,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[513,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[527,"قني شر أوهامي ومن تفضلا","https://www.aldiwan.net/poem37146.html","الطويل"],[549,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[549,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[551,"وقال رجال لو تعرضت للغنى","https://www.aldiwan.net/poem68312.html","الطويل"],[556,"قف ههنا بين العذيب وبارق","https://www.aldiwan.net/poem33539.html","الكامل"],[565,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"]],"verses":[["قَنا آلِ فِهرٍ لا قَنا غَطَفانِ","حَمَت أَهلَها مِن طارِقِ الحَدَثانِ",0,"ن",1,1],["قَناةٌ نَحنُ أَملَسُها وَأَنتُم","مَكانُ العابِ مِنها وَالوُصومِ",1,"م",1,0],["قَنَصتُ بِجَمعٍ شادِناً فَرَحَمتُهُ","وَأَخفَقَ قَنّاصٌ يَكونُ رَحيما",2,"م",2,0],["قَنابِلٌ تَحفِزُها","إِلى الرَدى قَنابِلُ",3,"ل",1,0],["قَنِعتُ فَعِندي كُلُّ مَلكٍ نُزولُهُ","عَنِ العِزِّ وَالعَلياءِ مِثلُ رُكوبِهِ",4,"ب",2,0],["قَنِعْتُ وَرَيْعانُ الشَّبابِ بِمائِهِ","وَلَمْ يَتَبَسَّمْ وافِدٌ الشَّيْبِ في الرَّاسِ",5,"س",1,1],["قَنِعْتُ بطَيْفٍ منْ خَيالِكِ طارِقٍ","وأيُّ خَيالٍ يَهْتَدي لخَيالِ",6,"ل",1,0],["قَنَعتُ بِالقوتِ مِن زَماني","وَصُنتُ نَفسي عَنِ الهَوانِ",7,"ن",1,1],["قنِعْتُ وحظّي منْ زَماني ووُدِّكُمْ","هَباءٌ ومثْلي ليسَ يقْنَعُ بالنّزْرِ",8,"ر",1,0],["قَنواءُ في حُرَّتَيها لِلبَصيرِ بِها","عِتقٌ مُبينٌ وَفي الخَدَّينِ تَسهيلُ",9,"ل",1,0],["قَنِعتُ بِالقُطنِ في الوِسادِ","وَفي الحَشِيّاتِ وَالغِطاء",10,"ا",2,0],["قَناةُ الأَلأَمينَ قَناةُ تَيمٍ","مُبَيَّنَةُ القَوادِحِ وَالوُصومِ",11,"م",1,0],["قناةُ حُشٍّ غدتْ ظُلماً تُكلفني","سَدِّي ببعضيَ ما فيها من الثُّقَبِ",12,"ب",1,0],["قِني يا إلهي شحَّ نفسي فإنني","أرى الجودَ لي حظاً وشيمتي البخلُ",13,"ل",1,1],["قنَّعَ الرأسَ ثم لثَّم وجهي","وكفى بالقِناع دونَ اللثام",14,"م",1,0],["قَنواءَ نَضّاخَةِ الذِفرى مُفَرَّجَةٍ","مِرفَقُها عَن ضُلوعِ الزَورِ مَفتولُ",15,"ل",1,0],["قِني البَأس وَاِمنَع شَعبَكَ الضَعفَ يَتَّقي","وَيُنصِفُهُ مِن حُسّادِهِ مَن يُناكِرُه",16,"ر",2,0],["قَنِعتُ بَأَنّي في ضَميرِكَ حاضِرٌ","وَأَنَّكَ لي بَعضَ الأَحايِينِ ذاكِرُ",17,"ر",1,0],["قَناةٌ مِنَ المُرّانِ ما فَوقَ حَقوِها","وَما تَحتَهُ مِنها نَقاً يَتَهَيَّلُ",18,"ل",1,0],["قَناةٌ مِنَ المُرّانِ ما فَوقَ حَقوِها","وَما تَحتَهُ مِنها نَقاً يَتَقَصَّفُ",19,"ف",1,0],["قَنَّعوا بِالتُرابِ وَجهاً كَريماً","كانَ مِن رُفعَةِ الحَياءِ قِناعُه",20,"ع",2,0],["قَنِعتُ عَلى كَرهٍ وَطَأطَأتُ ناظِري","إِلى رَنقِ مَطروقٍ مِنَ العَيشِ حَشرَجِ",21,"ج",1,0],["قَنِعتُ وَجانَبتُ المَطامِعَ لابِساً","لِباسَ مُحِبِّ لِلبَراءَةِ مُؤثِرِ",22,"ر",1,0],["قَناعَةٌ تَتبَعُها هِمَّةٌ","مُشتَبِهٌ فيها الغِنى وَالقُنوع",23,"ع",1,0],["قَنيتُ عَزاءً عَن شُجونٍ أُضيفُها","إِلَيَّ وَعَن أَسرابِ دَمعٍ أُجيلُها",24,"ل",3,0],["قَنِعوا بِمَيسورِ الفَعالِ وَأوهِموا","أَنَّ المَكارِمَ عِفَّةٌ وَقُنوعُ",25,"ع",1,0],["قَنافِذُ دَرّامونَ خَلفَ جِحاشِهِم","لِما كانَ إِيّاهُم عَطِيَّةُ عَوَّدا",26,"د",2,0],["قَنواءُ حَصّاءُ المُقَوَّسِ نَبعَةٌ","مِثلُ السَبيكَةِ إِذ تُمَلُّ وَتُشسَبُ",27,"ب",1,0],["قَنِّعِ النَفسَ بِالكِفافِ وَإِلّا","طَلَبَت مِنكَ فَوقَ ما يَكفيها",28,"ي",3,0],["قَنى الحَمدَ ثَوباً لِلفَذخارِ وَإِنَّهُ","عَلى جِدَّةِ الأَيّامِ لَم يَتَخَرَّقِ",29,"ق",1,0],["قَناعَةُ المَرءِ بِما عِندَهُ","مَملَكَةٌ ما مِثلُها مَملَكَه",30,"ه",1,1],["قَنِعتُ بِالوُدِّ مِنهُم","إِنَّ القَناعَةُ مُلكُ",31,"ك",1,0],["قَنَعتُ بِالطيفِ لَمَّا صَدَّ صاحبُهُ","وَالطيبُ إِن غابَ أَبقى عِندَكَ العبقا",32,"ق",2,0],["قناةٌ من الشّمْعِ مَرْكوزةٌ","لها حَرْبَةٌ طُبِعَتْ من لهب",33,"ب",1,1],["قنعتُ والقتعُ يعزُّ الفتى","لما رأيتُ الحرصَ ذلَّ الكرامْ",34,"م",1,0],["قنعتُ فخلتُ النجمَ دوني رتبةً","وهيهاتَ خوفُ الفقرِ عندَ الغنى فقرُ",35,"ر",1,0],["قَنعنا بالرّوايةِ وانكفأنا","نُهيبُ بقومِنا في القاعدينا",36,"ن",2,0],["قَنِيصةُ نافذِ الأظفارِ ضَارٍ","له في كلِّ ذي ظُفُرٍ شَباةُ",37,"ه",1,0],["قنعتُ بالشِّعرِ أغزو المشرِكينَ به","فلم أُصِبْ فيه آمالي ولم أنلِ",38,"ل",1,0],["قَنِعتُ عَلى رُغمي بِذِكرِكَ وَحدَهُ","أُديرُ عَلَيهِ الخَمرَ وَالأَدمُعَ الحُمرا",39,"ر",2,0],["قُنِّعَ الأَنصافُ مِنها العُلى","فَهيَ غُرٌّ بِالخَنيفِ الشَآم",40,"م",1,0],["قُنَّعَ الرَأسُ مَشيباً","وَاِكتَسى لَونَ الشَمَط",41,"ط",1,1],["قَنِعتُ إِذ نِلتُ مِن أَحبابِيَ النَظَرا","وَقُلتُ يا رَبِّ ما أَعطَيتَ ذا بَشَرا",42,"ر",2,1],["قَنفاءُ ذاتُ عَذَبٍ نَوايِسِ","يَهوعُ فوها كَهُواعِ القالِسِ",43,"س",1,0],["قُنِيُّ فَوارِسٍ ما كانَ مِنهُم","فَوارِسُ رَحرَحانَ وَلا النِسارِ",44,"ر",1,0],["قَنِعْتُ فخِلْتُ أنّ النجْمَ دوني","وسِيّانِ التّقَنّعُ والجِهادُ",45,"د",1,0],["قَنَعَ الصوفيُّ منها بالحَبابْ","وهيَ تنهلُّ بكأسِ الشاعرِ",46,"ر",1,0],["قُنْفُذٌ أَوْقَد مِن أَشْوَاكِهِ","شِكَّةً لاحَتْ بِهَا الأَلْوَانُ كُثْرَا",47,"ر",2,0],["قَناتي عَلى ما تَعهَدانِ صَليبَةٌ","وَعودي عَلى ماتَعلَمانِ صَليبُ",48,"ب",1,1],["قنص الفتاة بفقرها وشقائها","وبما تكابد من أسى وتلاقي",49,"ق",2,0],["قَنعتُ بِالطَيفِ وَاِنتِحابي","يَمنَعُ مِن طَيفِكَ الطَروقِ",50,"ق",1,0],["قَنِعتُ بِوَصلِ الطَيفِ إِن قادَهُ الكَرى","وَكَيفَ رُقادي وَالمَدامِعُ ما ترقى",51,"ق",2,0],["قَنِعْنا بما دُونَ القَليلِ ولَمْ تَكُنْ","بِغَيْرِ جَلِيلاتَ المَطَالب تَقْنَع",52,"ع",1,0],["قَنَصَتْ بَنَاتُ الدَّهْرِ واحِدَ دَهْرِهِ","ورَمَتْهُ مِنْ أَدْوائِها بعُضَال",53,"ل",1,0],["قنعوا بالحياة شمسا ومرعى","واطمأنوا للماء والغدران",54,"ن",1,0],["قنعت بالنواح منك فلّما","زال عاشت بذكريات نواحك",55,"ك",1,0],["قنعا بِما قَسم الإِل","ه وَما بِهِ قَد أَحسَنا",56,"ن",2,1],["قنك افنى الهجر طوق كله","آماله من ناره امان",57,"ن",1,0],["قنعت فيه ولا قنعت ذا كبدٍ","حَرَّا ولا أقنَعَنْ بغير ما الرَّتَلِ",58,"ل",1,0],["قناديل خلق من مصابيح قلبه","حياة لروح الروح حقاً وواضحا",59,"ح",2,0],["قَناً تَمضي مُصَمِّمَةً فَتَقضي","لِسَكرانِ الغَوايَةِ أَن يُفيقا",60,"ق",2,0],["قَناً جَدَّلَ الفُرسانَ قَبلَ اِنحِطامِهِ","وَنابَت سُيوفُ الهِندِ لَمّا تَحَطَّما",61,"م",2,0],["قَنِعتُ بَجمرٍ لَم يَلُح لِيَ سِرُّهُ","وللنَّارِ إشراقٌ وللسَّيفِ رَونَقُ",62,"ق",1,0],["قناة العز في تلك الرماح","وبين مضارب البيض الصفاح",63,"ح",1,1],["قناعةُ المرءِ كيمياءٌ","صَحَّتْ وكنزٌ وأيُّ كنز",64,"ز",1,0],["قناديلٌ مُشرِّفة الأَعالي","تشبُّ بهن ألسنةُ الذُّبال",65,"ل",1,0],["قنعت من الدنيا بأدنى معيشة","تقاصر عنّي مرّة وتطول",66,"ل",1,1],["قنعت مضطرا لضعف القوى","عن نيل ما يدركه الساعي",67,"ع",2,0],["قنوع من الدنيا بثوب وشبعة","وذلك خير عن شكرت كثير",68,"ر",1,0],["قَناً لَقىً وقِسيٌّ غَيرُ موتَرَةٍ","وَالخَيلُ عازِبَةٌ تَرعى مَع الهَمَلِ",69,"ل",1,0],["قنصت عقول أَولى النهي بحبائل","الصبوات لا بِحَبائل الصياد",70,"د",1,0],["قَنَاعَةُ عِزٍّ لاَ طَمَاعَةُ ذِلَّةٍ","تُزَهِّدُ في نَيْلِ الْغِنى كُل رَاغِبِ",71,"ب",1,0],["قَناتُهُ لَم تَلِن يَوماً لِغامِزِها","لَكِنَّها في فُؤادِ الخَصمِ تَنحَطِمُ",72,"م",1,0],["قَناةٌ أَنابيبُها ظامِئاتٌ","بِها ثَعلَبٌ مِن دَمِ الأُسدِ يُسقى",73,"ق",2,0],["قنعت بالعود إلى منزلي","وذاك دأب المرء في خيبته",74,"ه",1,1],["قَنوعاً بِما أَعطاكَ مُستَغنِياً بِهِ","لَهُ حامِداً في حالي اليُسرِ وَالعُسرِ",75,"ر",1,0],["قنابل من قحطان لم يرَ مثلهم","إذا الصدع أعبا رأيه كل شاعب",76,"ب",1,1],["قَنْطَرَةٌ قَدْ بُنِيَتْ","وَصُوِّرَتْ مِن المُلَحْ",77,"ح",1,1],["قَنَوات كَأَنَّها الزَرد المَن","ظوم وَقت الهَيجاء تَحتَ اللِواء",78,"ا",2,0],["قناةُ ظَلْماءَ ما تَنْفَكُّ يأكُلها","سِنانُها طُولَ طَعْنٍ أو يُشَظّيها",79,"ي",3,0],["قَنَصٌ طَرْفُه أَشدُّ سهاماً","حين تَلْقاهُ من يَدِ القَنّاص",80,"ص",1,0],["قنَأْتُ حَيائي لها واصطَبرت","وطالَ قيامي لها والقُعود",81,"د",1,0],["قنعت بمصدرها وحلت أربُعاً","ومنازلاً بفراقها لم تَقنع",82,"ع",1,0],["قنع المُشتاق مِن طَي","فك بِالوَعد الكَذوب",83,"ب",1,0],["قنديل تسبيحها يا ليل يسعده","وصيته عندها من أفضل الرسل",84,"ل",1,0],["قنعتم بأخذ السحتِ منهم وبالرُّشَا","ودافعتم عنهم بسيف المعاذر",85,"ر",1,0],["قنوعاً من الدنيا كفاه كفافُهَا","تَسَرْبَلَ فيها بالقناعة والزهد",86,"د",1,0],["قنص الفؤاد من الحليم بمقلةٍ","سحارةٍ قنصت رشا عسفان",87,"ن",1,0],["قَناعَةُ المَرْءِ الرِّضَى","وَحِرْصُهُ أَقْصى الْعَدَمْ",88,"م",1,1],["قنعت به والحر إن عز مطلب","سيغنيه عن ذل السؤال قنوعه",89,"ع",2,0],["قَنَّعْتُها الصَّبْرَ الجَميلَ فأَسْفَرَتْ","فِي آلِ يَحْيى عن جميلِ عواقِبِ",90,"ب",1,0],["قني يا رب لطفاً شح نفسي","ورضها في رضاك يكن رضاها",91,"ا",3,0],["قِني الشرَّ منها أو أقِلْني عثارَها","لعلَّك تلقَى مثلَها فتَوَقَّاها",92,"ا",3,0],["قنِعتُ به من الدنيا","وجُلُّ الشيء يُقنعني",93,"ي",1,0],["قَناعةٌ صانت لوجهي ماءَه","كم من حريصٍ لم يجُدْ ولم يصنْ",94,"ن",1,0],["قنصناهنّ دون مِنىً","ولم نتحرَّج الحَرَما",95,"م",2,0],["قناةٌ من المجد التّليد صليبةٌ","لها مركز في المكرماتِ صميمُ",96,"م",1,0],["قُنوطاً بني الحاجات إن نجاحها","بلا كافلٍ بعدَ الحسين ولا والي",97,"ي",1,0],["قناعة أعتقَ عزِّي بها","عُنْقي وعبدُ الحرص لم يُعتَق",98,"ق",1,0],["قنعتُ منها بما بلَّ الصدَى كِبَراً","من همّتي ظنَّ قومٌ أنه صِغَرُ",99,"ر",1,0],["قناةٌ أنت عاملُها شروعاً","إلى نحر السما وهم الكعوبُ",100,"ب",1,0],["قَناعةٌ رَغِبتْ بي عن زيارة مس","دولِ الستورِ وعن تأميلِ محتجبِ",101,"ب",1,0],["قَنوتٌ له منْ صومِه وصَلاتِهِ","شَهيدانِ ليلٌ باردٌ وهواجِرُ",102,"ر",1,0],["قنعتُ بيوم لقاءٍ يسرُّ وما","كنت منك بعام قنوعا",103,"ع",2,0],["قَنوعي بِدونِ الدونِ لا نَقصُ هِمَّةٍ","وَلَكِنَّهُ شَيءٌ أَصونُ بِهِ عِرضي",104,"ي",1,1],["قَنوعي بِدونِ الدونِ لا نَقصُ هِمَّةٍ","وَلَكِنَّهُ شَيءٌ أَصونُ بِهِ نَف