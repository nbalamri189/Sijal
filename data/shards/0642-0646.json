{"poems":[[53,"قنا آل فهر لا قنا غطفان","https://www.aldiwan.net/poem29661.html","الطويل"],[53,"أبا مطر وجذمك من معد","https://www.aldiwan.net/poem29789.html","الوافر"],[53,"تذكرت بين المأزمين إلى منى","https://www.aldiwan.net/poem29824.html","الطويل"],[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"هل الطرف يعطي نظرة من حبيبه","https://www.aldiwan.net/poem30742.html","الطويل"],[63,"قنعت وريعان الشباب بمائه","https://www.aldiwan.net/poem45944.html","الطويل"],[63,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[57,"قنعت بالقوت من زماني","https://www.aldiwan.net/poem24630.html","مجزوء البسيط"],[77,"بعثت بشيء كالجفاء وإنما","https://www.aldiwan.net/poem36426.html","الطويل"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[86,"ببابك النحس والسعود","https://www.aldiwan.net/poem68833.html","مخلع البسيط"],[27,"ألم يك لا أبا لك شتم تيم","https://www.aldiwan.net/poem6008.html","الوافر"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"قني يا إلهي شح نفسي فإنني","https://www.aldiwan.net/poem65989.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[29,"بانت سعاد ففي العينين ملمول","https://www.aldiwan.net/poem6024.html","البسيط"],[91,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[70,"لعمري قد أحسنت لي وجبرتني","https://www.aldiwan.net/poem42879.html","الطويل"],[32,"ألا من لقلب لا يمل فيذهل","https://www.aldiwan.net/poem27814.html","الطويل"],[32,"أمن منزل قفر تعفت رسومه","https://www.aldiwan.net/poem27818.html","الطويل"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[45,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[45,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[45,"لديك هوى النفس اللجوج وسولها","https://www.aldiwan.net/poem65582.html","الطويل"],[45,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[28,"رأى عبد قيس خفقة شورت بها","https://www.aldiwan.net/poem5050.html","الطويل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[49,"من أحب الدنيا تحير فيها","https://www.aldiwan.net/poem63186.html","الخفيف"],[66,"قفي ودعينا قبل وشك التفرق","https://www.aldiwan.net/poem38481.html","الطويل"],[66,"قناعة المرء بما عنده","https://www.aldiwan.net/poem38586.html","السريع"],[66,"للترك مالي ترك","https://www.aldiwan.net/poem39673.html","المجتث"],[80,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[80,"قناة من الشمع مركوزة","https://www.aldiwan.net/poem31557.html","المتقارب"],[69,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[69,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[81,"أموسى ولم أهجرك والله إنما","https://www.aldiwan.net/poem61513.html","الطويل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[52,"قنع الرأس مشيبا","https://www.aldiwan.net/poem26868.html","مجزوء الرمل"],[48,"قنعت إذ نلت من أحبابي النظرا","https://www.aldiwan.net/poem63320.html","البسيط"],[48,"قد أغتدي قبل مذاذ الخامس","https://www.aldiwan.net/poem64349.html","الرجز"],[46,"تخيم يا ابن آدم في ارتحال","https://www.aldiwan.net/poem22695.html","الوافر"],[46,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/870","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43854","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43650","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[91,"دمعة على جبران جبران","https://www.poetsgate.com/ViewPoem.aspx?id=52997",""]],"verses":[["قَنا آلِ فِهرٍ لا قَنا غَطَفانِ","حَمَت أَهلَها مِن طارِقِ الحَدَثانِ",0,"ن",1,1],["قَناةٌ نَحنُ أَملَسُها وَأَنتُم","مَكانُ العابِ مِنها وَالوُصومِ",1,"م",1,0],["قَنَصتُ بِجَمعٍ شادِناً فَرَحَمتُهُ","وَأَخفَقَ قَنّاصٌ يَكونُ رَحيما",2,"م",2,0],["قَنابِلٌ تَحفِزُها","إِلى الرَدى قَنابِلُ",3,"ل",1,0],["قَنِعتُ فَعِندي كُلُّ مَلكٍ نُزولُهُ","عَنِ العِزِّ وَالعَلياءِ مِثلُ رُكوبِهِ",4,"ب",2,0],["قَنِعْتُ وَرَيْعانُ الشَّبابِ بِمائِهِ","وَلَمْ يَتَبَسَّمْ وافِدٌ الشَّيْبِ في الرَّاسِ",5,"س",1,1],["قَنِعْتُ بطَيْفٍ منْ خَيالِكِ طارِقٍ","وأيُّ خَيالٍ يَهْتَدي لخَيالِ",6,"ل",1,0],["قَنَعتُ بِالقوتِ مِن زَماني","وَصُنتُ نَفسي عَنِ الهَوانِ",7,"ن",1,1],["قنِعْتُ وحظّي منْ زَماني ووُدِّكُمْ","هَباءٌ ومثْلي ليسَ يقْنَعُ بالنّزْرِ",8,"ر",1,0],["قَنواءُ في حُرَّتَيها لِلبَصيرِ بِها","عِتقٌ مُبينٌ وَفي الخَدَّينِ تَسهيلُ",9,"ل",1,0],["قَنِعتُ بِالقُطنِ في الوِسادِ","وَفي الحَشِيّاتِ وَالغِطاء",10,"ا",2,0],["قَناةُ الأَلأَمينَ قَناةُ تَيمٍ","مُبَيَّنَةُ القَوادِحِ وَالوُصومِ",11,"م",1,0],["قناةُ حُشٍّ غدتْ ظُلماً تُكلفني","سَدِّي ببعضيَ ما فيها من الثُّقَبِ",12,"ب",1,0],["قِني يا إلهي شحَّ نفسي فإنني","أرى الجودَ لي حظاً وشيمتي البخلُ",13,"ل",1,1],["قنَّعَ الرأسَ ثم لثَّم وجهي","وكفى بالقِناع دونَ اللثام",14,"م",1,0],["قَنواءَ نَضّاخَةِ الذِفرى مُفَرَّجَةٍ","مِرفَقُها عَن ضُلوعِ الزَورِ مَفتولُ",15,"ل",1,0],["قِني البَأس وَاِمنَع شَعبَكَ الضَعفَ يَتَّقي","وَيُنصِفُهُ مِن حُسّادِهِ مَن يُناكِرُه",16,"ر",2,0],["قَنِعتُ بَأَنّي في ضَميرِكَ حاضِرٌ","وَأَنَّكَ لي بَعضَ الأَحايِينِ ذاكِرُ",17,"ر",1,0],["قَناةٌ مِنَ المُرّانِ ما فَوقَ حَقوِها","وَما تَحتَهُ مِنها نَقاً يَتَهَيَّلُ",18,"ل",1,0],["قَناةٌ مِنَ المُرّانِ ما فَوقَ حَقوِها","وَما تَحتَهُ مِنها نَقاً يَتَقَصَّفُ",19,"ف",1,0],["قَنَّعوا بِالتُرابِ وَجهاً كَريماً","كانَ مِن رُفعَةِ الحَياءِ قِناعُه",20,"ع",2,0],["قَنِعتُ عَلى كَرهٍ وَطَأطَأتُ ناظِري","إِلى رَنقِ مَطروقٍ مِنَ العَيشِ حَشرَجِ",21,"ج",1,0],["قَنِعتُ وَجانَبتُ المَطامِعَ لابِساً","لِباسَ مُحِبِّ لِلبَراءَةِ مُؤثِرِ",22,"ر",1,0],["قَناعَةٌ تَتبَعُها هِمَّةٌ","مُشتَبِهٌ فيها الغِنى وَالقُنوع",23,"ع",1,0],["قَنيتُ عَزاءً عَن شُجونٍ أُضيفُها","إِلَيَّ وَعَن أَسرابِ دَمعٍ أُجيلُها",24,"ل",3,0],["قَنِعوا بِمَيسورِ الفَعالِ وَأوهِموا","أَنَّ المَكارِمَ عِفَّةٌ وَقُنوعُ",25,"ع",1,0],["قَنافِذُ دَرّامونَ خَلفَ جِحاشِهِم","لِما كانَ إِيّاهُم عَطِيَّةُ عَوَّدا",26,"د",2,0],["قَنواءُ حَصّاءُ المُقَوَّسِ نَبعَةٌ","مِثلُ السَبيكَةِ إِذ تُمَلُّ وَتُشسَبُ",27,"ب",1,0],["قَنِّعِ النَفسَ بِالكِفافِ وَإِلّا","طَلَبَت مِنكَ فَوقَ ما يَكفيها",28,"ي",3,0],["قَنى الحَمدَ ثَوباً لِلفَذخارِ وَإِنَّهُ","عَلى جِدَّةِ الأَيّامِ لَم يَتَخَرَّقِ",29,"ق",1,0],["قَناعَةُ المَرءِ بِما عِندَهُ","مَملَكَةٌ ما مِثلُها مَملَكَه",30,"ه",1,1],["قَنِعتُ بِالوُدِّ مِنهُم","إِنَّ القَناعَةُ مُلكُ",31,"ك",1,0],["قَنَعتُ بِالطيفِ لَمَّا صَدَّ صاحبُهُ","وَالطيبُ إِن غابَ أَبقى عِندَكَ العبقا",32,"ق",2,0],["قناةٌ من الشّمْعِ مَرْكوزةٌ","لها حَرْبَةٌ طُبِعَتْ من لهب",33,"ب",1,1],["قنعتُ والقتعُ يعزُّ الفتى","لما رأيتُ الحرصَ ذلَّ الكرامْ",34,"م",1,0],["قنعتُ فخلتُ النجمَ دوني رتبةً","وهيهاتَ خوفُ الفقرِ عندَ الغنى فقرُ",35,"ر",1,0],["قَنعنا بالرّوايةِ وانكفأنا","نُهيبُ بقومِنا في القاعدينا",36,"ن",2,0],["قَنِيصةُ نافذِ الأظفارِ ضَارٍ","له في كلِّ ذي ظُفُرٍ شَباةُ",37,"ه",1,0],["قنعتُ بالشِّعرِ أغزو المشرِكينَ به","فلم أُصِبْ فيه آمالي ولم أنلِ",38,"ل",1,0],["قَنِعتُ عَلى رُغمي بِذِكرِكَ وَحدَهُ","أُديرُ عَلَيهِ الخَمرَ وَالأَدمُعَ الحُمرا",39,"ر",2,0],["قُنِّعَ الأَنصافُ مِنها العُلى","فَهيَ غُرٌّ بِالخَنيفِ الشَآم",40,"م",1,0],["قُنَّعَ الرَأسُ مَشيباً","وَاِكتَسى لَونَ الشَمَط",41,"ط",1,1],["قَنِعتُ إِذ نِلتُ مِن أَحبابِيَ النَظَرا","وَقُلتُ يا رَبِّ ما أَعطَيتَ ذا بَشَرا",42,"ر",2,1],["قَنفاءُ ذاتُ عَذَبٍ نَوايِسِ","يَهوعُ فوها كَهُواعِ القالِسِ",43,"س",1,0],["قُنِيُّ فَوارِسٍ ما كانَ مِنهُم","فَوارِسُ رَحرَحانَ وَلا النِسارِ",44,"ر",1,0],["قَنِعْتُ فخِلْتُ أنّ النجْمَ دوني","وسِيّانِ التّقَنّعُ والجِهادُ",45,"د",1,0],["قَنَعَ الصوفيُّ منها بالحَبابْ","وهيَ تنهلُّ بكأسِ الشاعرِ",46,"ر",1,0],["قُنْفُذٌ أَوْقَد مِن أَشْوَاكِهِ","شِكَّةً لاحَتْ بِهَا الأَلْوَانُ كُثْرَا",47,"ر",2,0],["قَناتي عَلى ما تَعهَدانِ صَليبَةٌ","وَعودي عَلى ماتَعلَمانِ صَليبُ",48,"ب",1,1],["قنص الفتاة بفقرها وشقائها","وبما تكابد من أسى وتلاقي",49,"ق",2,0],["قَنعتُ بِالطَيفِ وَاِنتِحابي","يَمنَعُ مِن طَيفِكَ الطَروقِ",50,"ق",1,0],["قَنِعتُ بِوَصلِ الطَيفِ إِن قادَهُ الكَرى","وَكَيفَ رُقادي وَالمَدامِعُ ما ترقى",51,"ق",2,0],["قَنِعْنا بما دُونَ القَليلِ ولَمْ تَكُنْ","بِغَيْرِ جَلِيلاتَ المَطَالب تَقْنَع",52,"ع",1,0],["قَنَصَتْ بَنَاتُ الدَّهْرِ واحِدَ دَهْرِهِ","ورَمَتْهُ مِنْ أَدْوائِها بعُضَال",53,"ل",1,0],["قنعوا بالحياة شمسا ومرعى","واطمأنوا للماء والغدران",54,"ن",1,0],["قنعت بالنواح منك فلّما","زال عاشت بذكريات نواحك",55,"ك",1,0]]}