{"poems":[[95,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[91,"أي قدس يضم هذا البناء","https://www.aldiwan.net/poem44981.html","الخفيف"],[30,"يا ابن الحمارة للحمار وإنما","https://www.aldiwan.net/poem5235.html","الكامل"],[46,"قال الوشاة بدا في الخد عارضه","https://www.aldiwan.net/poem30287.html","البسيط"],[48,"إستنبط العرب لفظا وانبرى نبط","https://www.aldiwan.net/poem22204.html","البسيط"],[189,"صحة في سلامة ونعيم","https://www.aldiwan.net/poem14656.html","الخفيف"],[286,"أمشرفي بصفاته وحلاه","https://www.aldiwan.net/poem1400.html",""],[362,"كلمته فاصفر من خجل","https://www.aldiwan.net/poem4158.html","السريع"],[422,"شفها السير والأسى والغرام","https://www.aldiwan.net/poem53960.html","الطويل"],[563,"كلمتني من كل عقل وحس","https://www.aldiwan.net/poem34452.html","الخفيف"],[572,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96974","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96642","الرمل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72344","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78180","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111794","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126651","الخفيف"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11137","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52096","الرمل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84532","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58261","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109796","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48296","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48293","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61285","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144494","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85248","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116874","الخفيف"],[4728,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=176976",""],[4748,"الخط شغّال","https://www.poetsgate.com/ViewPoem.aspx?id=4436",""],[4866,"خيرك وخيرك","https://www.poetsgate.com/ViewPoem.aspx?id=204631",""],[5136,"ما له ذاب لوعة وغراما","https://www.poetsgate.com/ViewPoem.aspx?id=121660",""],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5273,"مدرِّسة","https://www.poetsgate.com/ViewPoem.aspx?id=184341",""],[5608,"كلمتي وحده","https://www.poetsgate.com/ViewPoem.aspx?id=33326",""],[5621,"السحر المطلق","https://www.poetsgate.com/ViewPoem.aspx?id=24568",""],[5739,"أرحب يالهلاك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155471",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5903,"لي هوىً","https://www.poetsgate.com/ViewPoem.aspx?id=124149",""],[5943,"كفكف دموعكَ","https://www.poetsgate.com/ViewPoem.aspx?id=11276",""],[5956,"وصلتْ إليّ رسالةٌ من درِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193810",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["كَلَّمَتْهُ فِي الطورِ آثَارُ مَجْدٍ","خَرِسَتْ بَعْدَ أَنْ تَوَلَّى الكَلِيمُ",0,"م",1,0],["كلّمتنا منك المباني كلاماً","فيه منها فصاحة خرساء",1,"ا",2,0],["كَلَمَت مُروءَتُكَ الَّتي تُعنى بِها","لَو جادَ سَرجُكَ وَاِستَجَدَّ عِذارا",2,"ر",2,0],["كَلَّمتُهُ بِجُفونٍ غَيرِ ناطِقَةٍ","فَكانَ مِن رَدِّهِ ما قالَ حاجِبُهُ",3,"ب",2,0],["كَلَّمتُ بِاللَحنِ أَهلَ اللَحنِ أَنفُسَهُم","لِأَنَّ عَيبِيَ عِندَ القَومِ إِعرابي",4,"ب",2,0],["كلمْته سعادةُ الآمِر المُحْ","ي بجَدْواهُ كلَّ بالٍ رَميم",5,"م",1,0],["كلم تخيَّرها على علمٍ بها","من ترتضي العلماء ما يرضاه",6,"ا",2,0],["كَلَّمتُهُ فَاصفَرَّ مِن خَجَلٍ","حَتَّى اكتَسَى بِالعَسجَدِ الوَرِقُ",7,"ق",1,1],["كلَّمتنا الديار وهي سكوتٌ","إنَّ بعضاً من السكوت كلام",8,"م",1,0],["كلمتني من كل عقل وحسِّ","ودعتني من كل نوع وجنسِ",9,"س",1,1],["كَلَمَتْ تَرَائِيَهُ فَبَانَ كَلاَمُهُ","لِلسَّمْعِ مِنْ جَسَدٍ خَفِيْفِ المَحْمَلِ",10,"ل",1,0],["كلمت قلب كليم اللَه فانبجست","عيناه دمعاً دماً كالغيث منهمعا",11,"ع",2,0],["كَلّمتهُ ظبيةُ الصائدِ وه","يَ معَ الصائدِ مرساة بِيَد",12,"د",1,0],["كلم تكسب المعاطف والتيجان","هزأ إن أنشدت في الندي",13,"ي",1,0],["كَلَّمتُ الحاظه قَلبي وَما","فَهت حَتّى سَلَبت مني الحشي",14,"ي",1,0],["كلَّمت افئدةَ الرجالِ بصارمٍ","تقوى بهِ الدعوى وان لم ينطقِ",15,"ق",1,1],["كلمت مقلتاه منها رسوماً","شاخصات وليس ثمة واع",16,"ع",1,0],["كَلَّمَتني وَذاكَ مانِلتُ مِنها","إِنَّ سُعدى تَرى الكَلامَ رَبيحا",17,"ح",2,0],["كَلَمَتْ قَلبِي بِلَحظٍ فَاتِرٍ","تركتني في الدُّجى أرعَى السُّها",18,"ه",2,0],["كلمت بموسى اللحظ قَلبي فَلَم يَزَل","عَلى طور شوق سامِعاً لندائك",19,"ك",1,0],["كلّمتهم بالسّبِّ ألسِنَةُ النّا","رِ بما تَقْشَعِرًّ مِنْهُ الجلودُ",20,"د",1,0],["كلمتها همساً فما نطقت","الا بلحظ ان رنا فتنا",21,"ن",2,0],["كلّمْتَ يا ملِكَ الأمْلاكِ من كثَبٍ","عبْداً يُناديكَ من بُعْدٍ فتسْمَعُهُ",22,"ع",2,0],["كلّمتَ عبْدَك يا موْلَى المُلوكِ فما","بالنّظمِ والنّثْر وفّى بعضَ ما يجِبُ",23,"ب",1,0],["كَلِمٌ تسحَّبَ في الفَصاحة دَوحها","كَالبُرد مِنهُ مُسهَّمٌ وَمنضَّدُ",24,"د",1,0],["كلَّمتَ قلبي حينما كلَّمتَني","ختلاً فقلبي من كلامك مكُلَمُ",25,"م",1,0],["كلم تسمع من أيسرها","حكماً فيهن للدر احتقارُ",26,"ر",1,0],["كلمتها من بعد تكليم الحشا","يا هند إن لم تسمحي لم أصبر",27,"ر",1,0],["كَلَّمَتهُ الأحجَارُ جَاءَت لِعَرضِ","لِسَلاَمٍ مُؤَدِّيَاتٍ لفَرضِ",28,"ض",1,0],["كلمتني فقلت درّ سقيط","فتأملت عقدها هل تناثر",29,"ر",1,1],["كلّمتها واحسّ في صوتها همّ","وتقول: شوقي لك سبب كلّ همّي",30,"م",2,1],["كلمتكم والخط شغّال","يابعد عمري ليش ماترد",31,"د",1,1],["كلمتهم عنّك وما صدّقوني","هم يحسبونك \"عابِرة\" مثل غيرك",32,"ك",1,1],["كلمتني وللنسيم كلام","علمته المتيم المستهاما",33,"م",2,0],["كلم تود الخود لو بسمت به","ثغراً يهيم له العميد المولع",34,"ع",1,0],["كلمتني، فكلمت ما","مني، بحبك، قد وجب",35,"ب",1,0],["كلمتُها, قالت: لديَّ مشاغلٌ","بعضُ الدّروسِ تزيدُ في إرهاقي",36,"ق",2,0],["كلمتي وحده .. ولا فيها نظر","ما تراجع .. حتى لو قلتي بخيل",37,"ل",1,0],["كلَّمْتُها وقد غَفَتْ في الضُّحى","نَبَّهْتُها مِنْ حُلْمِها الشَّيِّقِ",38,"ق",1,0],["كلمتي وحده ولا هي كلمتين.","من عشقته عاش بعيوني ملاك.",39,"ك",1,0],["كلّمتُها بالعينِ قبلَ تكلُّمي","بمقالةٍ فأبَتْ على أستحياءِ",40,"ا",2,0],["كلَّمتْني هاؤُها","هائمٌ في عشقها",41,"ا",1,0],["كلَّمتُهم باللينِ لكنْ لمْ أجدْ","إلاالعداءَ فجلُّهمْ لايفقهونْ",42,"ن",1,0],["كلَّمْتني في كل يوم طالما","هاتفتني للشامِ تشكر شِعري",43,"ر",2,0],["كلمتها يا عين قرين واهجعي","خايف عَلى نورك يروح اعدام",44,"م",1,0],["كلمتها يا دار بِاللَه هوني","مَعي لجنابك قصة وَخبار",45,"ر",1,0],["كلمتها يا نار قرين واهجَعي","أَما تشفقي عاللي زَمان بَلاه",46,"ا",2,0]]}