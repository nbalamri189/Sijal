دد","https://www.aldiwan.net/poem63884.html","الوافر"],[46,"تناهبت العيش النفوس بغرة","https://www.aldiwan.net/poem22182.html","الطويل"],[46,"إن النسك وأصحابه","https://www.aldiwan.net/poem22300.html","المتقارب"],[46,"لسان الفتى يدعى سنانا وتارة","https://www.aldiwan.net/poem23030.html","الطويل"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30435","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43917","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[95,"اقرئيها (أوراق ميت )","https://www.poetsgate.com/ViewPoem.aspx?id=718",""],[100,"حيث التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=50147",""],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[45,"إنْ تَرْجُ طُولَ عُبَيدِالله لا تَخِبِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31530",""],[45,"قُلْ للوَزِيرِ الذي مَناقِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31291",""],[51,"مُسْتَقْبِلٌ خَائِفَهُ الصَّفْحُ","https://www.poetsgate.com/ViewPoem.aspx?id=27407",""],[51,"فقدُتك يا ابن أبي طاهرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29047",""],[105,"أترى الكنانة كيف تعبث بالدم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54977&r=&rc=147",""],[31,"إحرجي وتأثمي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19045&r=&rc=308",""]],"verses":[["وَإِنَّ قُعودي أَرقُبُ اليَومَ أَو غَداً","لَعَجزٌ فَما الإِبطاءُ بِالنَهَضانِ",0,"ن",1,0],["وَإِنَّ قَنا العِدا لَيَرِدنَ مِنهُ","دَماً لَم يَجرِ في عِرقٍ لَئيمِ",1,"م",1,0],["وَإِن قُسِمَت بُيوتُ المَجدِ حازوا","فِناءَ البَيتِ ذي العَمَدِ الطِوالِ",2,"ل",1,0],["وَإِنَّ قَوافي الشِعرِ ما لَم أَكُن لَها","مُسَفسَفَةٌ فيها عَتيقٌ وَمُقرِفُ",3,"ف",1,0],["وَإِنَّ قِوامَ الدينِ مِن دونِ ثَغرِها","لَهُ ناظِرٌ يَقظانُ وَالنَجمُ ناعِسُ",4,"س",1,0],["وَأَنقُلُ بَيتي في البِلادِ مُجاوِراً","بُيوتَ المَخازي قَد ضَلَلتُ إِذا جَدّا",5,"د",2,0],["وَإِنَّ قِوامَ الدينِ قَد عَبَّ بَحرُهُ","وَعيداً أَقامَ الخالِعينَ وَأَقعَدا",6,"د",2,0],["وإِن قُلتمُ هَلّا سلَوتَ ظَلمتُمُ","إِذا كانَ قَلبي عندَكم فَمتى أَسلو",7,"و",1,0],["وانْقَرَضَتْ شَبيبةٌ كأنّها","سَبيبَةٌ في دِمنَةِ الحَيِّ لَقى",8,"ا",1,0],["وانقَشَعَ الجَهْلُ فأخْبى نارَهُ","لَمْعُ قَتيرٍ بثَّ أنْوارَ الحِجى",8,"ا",1,0],["وَإِن قيلَ في الأَسفارِ ذُلٌّ وَمِحنَةٌ","وَقَطعُ الفَيافي وَاِكتِسابُ الشَدائِدِ",9,"د",1,0],["وإنْ قرّبَتْني المُلوكُ الكِرامُ","يُقَلِّدُ آخرُها الأُوَلا",10,"ل",2,0],["وَإِنْ قِيلَ قَدْرُ الْمَرْء مَا هُوَ مُحْسِنٌ","فَصنْعَةُ نَظْمِ الْقَوْلِ أَرْفَعُهُ شَانَا",11,"ن",2,0],["وَأَنْقَذَهُمْ مِنْ حَيْرَةِ التِّيهِ بَعْدَمَا","تَقَطَّعَتِ الاسْبَابُ وَانْتَثَرَ النَّظْمُ",12,"م",1,0],["وإنْ قلْتُ للأقْمارِ أسْعَدُ مَطْلَعٍ","صَدَعْتُ بمَحْضِ الحقِّ دونَ عِنادِ",13,"د",1,0],["وإنْ قامَ الغَمامُ بِها خَطيباً","تَرى الإبْريقَ يُسْرِعُ في السّجودِ",14,"د",1,0],["وإنْ قَعَدوا منْ دونِ مبْلَغِ غايةٍ","تَدانَى لهُ منْ كلِّ قَصْدٍ بَعيدُهُ",15,"د",2,0],["وَإِن قُلتَ في شَيءٍ نَعَم فَأَتِمَّهُ","فَإِنَّ نَعَم دَينٌ عَلى الحُرِّ واجِبُ",16,"ب",1,0],["وَإِن قالَ قَولاً لَم يَكُن ذا حَقيقَةٍ","وَإِن قُلتَ خَيراً رَدَّهُ مِن فَعالِكا",17,"ك",2,0],["وَإِن قيلَ أَودى بِالأُلوفِ أَجابَهُم","مُجيبٌ لَقَد أَحيا المَلايينَ فَاُنظُروا",18,"ر",3,0],["وَإِن قُلتَ أَصغَت مُلوكُ الكَلامِ","وَمالَت إِلَيكَ بِأَبصارِها",19,"ر",3,0],["وَإِنَّ قَريباً لا يُرَجّى لِقاؤُهُ","بَعيدٌ تَناءَى وَالمَدى مُتَقارِبُ",20,"ب",1,0],["وَأَن قَد أَصَبتِ القَلبَ مِنّي بِغُلَّةٍ","وَحُبٍّ لَهُ في أُسوَدِ القَلبِ قادِحُ",21,"ح",1,0],["وأنقع فيها ما يعادل ثلثها","من المكر بل ما قد يزيد على الثلث",22,"ث",1,0],["وأن قلم الأديب عراه زَيْغ","تلافي زيغه سيف الشجاع",23,"ع",1,0],["وَإِن قالَ العَواذِلُ قَد شَجاهُ","مَحَلُّ الحَيِّ مِن لَبَبِ الأَميلِ",24,"ل",1,0],["وإن قِيلَ لم أحفِل وَليسَ مُبَالِياً","لَمُحتَمِلٌ ضَبًّا أُبَالِي وأَحفِلُ",25,"ل",1,0],["وَأَنقَذَ مِن مَسِّ الحَديدِ وَثِقلِهِ","أَبا وائِلٍ وَالدَهرُ أَجدَعُ صاغِرُ",26,"ر",1,0],["وَإِن قُتِلوا لَم توفِ مِنهُم دِمائُهُم","بَلى إِنَّ قَتلَ القاتِلينَ شِفائي",27,"ا",2,0],["وَإِن قالَ في يَومٍ مَقالَةَ غائِبٍ","فَتَصديقُهُ في اليَومِ أَو في ضُحى الغَدِ",28,"د",1,0],["وانقصف الغصن فكم طائر","ناح عليه بعد ما قد صدح",29,"ح",1,0],["وأنقذنا بالبرِّ من وهج حادثٍ","يذوبُ بهِ من كلِّ عانٍ جليده",30,"د",2,0],["وإن قصرت عن بارعِ الحمد قدرتي","فوالله ما قصَّرت عن نافع الدعا",31,"ع",2,0],["وإن قيل دون القلتين مكانه","فما فيّ دون القلتين ولا دمعي",32,"ي",1,0],["وانْقضَّ من بعض الجبال النّسر","له بأبراج النجوم وكرُ",33,"ر",1,0],["وإن قعودي عنهُ خيفةَ نكبةٍ","لَلؤمُ مَهَزٍّ وانثناءُ مَضاربِ",34,"ب",1,0],["وآنَقُ من عِقْد العقِيلةِ جيدُهَا","وأحسنُ من سِرْبالِهَا المُتَجرّدُ",35,"د",1,0],["وإنّ قِسيِّي لموتورةٌ","بكل أمين القُوى حادر",36,"ر",1,0],["وانقلب المصطافُ في شهرنا","مرتبَعاً من جودك الدافق",37,"ق",1,0],["وأنقذ منا العُفْرَ والرُّبْدَ ميلُنا","إلى العينِ والحُقْب التي هي أوسمُ",38,"م",1,0],["وانقطاعي إذا هُمُ خاصموني","وتولَّى النبيُّ عنهُمْ خصامي",39,"م",2,0],["وآن قصْدُكَ مُمْتاحاً ومُمْتدَحاً","من كلِّ آنٍ لجدوى كفِّهِ آن",40,"ن",1,0],["وانقضتْ كلُّ حسرةٍ لك إلا","حسرتي للمغيب عن ناظريكا",41,"ك",2,0],["وَاِنقَبَضَ النَهرُ عَنِ الهِياجِ","وَكانَ مِثلَ الزاخِرِ العَجّاجِ",42,"ج",1,0],["وَإِن قامَرتَ أَو راهَنتَ في النادي أَوِ الدارِ","فَأَنتَ الرَجُلُ الآثِمُ عِندَ الناس وَالباري",43,"ي",1,0],["وَإِن قُلتَ إِذَن فَالعَيشُ أَوزارٌ بِأَوزارِ","وَإِنَّ المَوتَ أَشهى لي إِذا لَم أَقضِ أَوطاري",43,"ي",1,0],["وَإِنَّ قَومي طُيورٌ غَيرُ كاسِرَةٍ","سَطَت عَلَيها شَواهينٌ وَعُقبانُ",44,"ن",1,0],["وَإِن قيلَ لي هَذا رَخيصٌ تَرَكتُهُ","وَلا أَرتَضي إِلّا بِكُلِّ ثَمينِ",45,"ن",1,0],["وَإِن قَصَّرَت عَن بَعضِ ماتَستَحِقُّهُ","فَمِثلِكَ مَن أَولى الجَميلَ لِمَن أَسا",46,"س",2,0],["وَإِن قُلتُ واشَوقاهُ لِلبانِ وَالحِمى","فَإِنِّيَ عَنكُم بِالكِنايَةِ رامِزُ",47,"ز",1,0],["وَاِنقَضى عُمُري وَحالي","هُوَ حالي ماتَغَيَّر",48,"ر",1,0],["وَإِن قُلتُمُ أَهوى الرَبابَ وَزَينَباً","صَدَقتُم سَلوا عَنّي الرَبابَ وَزَينَبا",49,"ب",2,0],["وانقُرْ على دَفِّ الهَوَى لحنَهُ","وارقُصْ مَعَ النُّورِ الضَّحوكِ الوسيمْ",50,"م",1,0],["وانقضى الفجرُ فانحدرتُ منَ","الأُفْقِ تراباً إلى صميمِ الوادي",51,"ي",1,0],["وانقضَّ مضْطَغِناً عليه كأنَّه","سَوْطُ القضاءِ ولعنةُ الأربابِ",52,"ب",1,0],["وَإِن قَعُدَت بي عِلَّةٌ عَن طِلابِها","فَإِنَّ اِجتِهادي في الطِلابِ لَقائِمُ",53,"م",1,0],["وان قصرت الفاظه عن مراده","فليس من استحقاقه غير اهمال",54,"ل",1,0],["وانقضى الدهر بين زغردة العُر","س وحثوا التراب والإعوال",55,"ل",1,0],["وَاِنقَضَّ في الحالِ عَلى الضَعيفِ","يَأكُلُهُ بِالمِلحِ وَالرَغيفِ",56,"ف",1,0],["وَاِنَقضى الداءُ بِاليَقينِ مِنَ الحا","لَينِ فَالمَوتُ مُنتَهى إِقصارِهِ",57,"ر",2,0],["وَاِنقادَتِ الدُنيا إِلَيكَ فَحَسبُها","عُذراً قِيادٌ أَسلَسَت وَزِمامُ",58,"م",1,0],["وَاِنقَضى الدَهرُ بَينَ زَغرَدَةِ العُر","سِ وَحَثوِ التُرابِ وَالإِعوالِ",59,"ل",1,0],["وَاِنقُل رُكابَ القَوافي في جَوانِبِها","لا في جَوانِبِ رَسمِ المَنزِلِ البالي",60,"ل",2,0],["وإن قَدَرتِ على تشويشِ طُرَّتِه","فشوِّشِيها ولا تُبقي ولا تَذَرِي",61,"ر",2,0],["وَاِنقَلَبَت تَهبِطُ في حُدورِها","تَصَوّبَ الطَيرِ إِلى وكورِها",62,"ر",3,0],["وَأَنقَذَهُم مِن سِجنِ كِسرى بنِ هُرمُزٍ","وَقَد يَئِسَت أَنفارُها مِن نِسائِها",63,"ا",3,0],["وإن قَدَّمَت يومَه النَّائِباتُ","فلستُ أُسَرُّ بمَنْ أخِّرا",64,"ر",2,0],["وَإِن قامَ فيهِم حامِلٌ قالَ قاعِدٌ","رَشَدتَ فَلا غُرمٌ عَلَيكَ وَلا خَذلُ",65,"ل",1,0],["وَإِن قَسَتِ الأَخلاقُ مِنكَ فَطالَما","أَلَنتَ لِيَ الأَيّامَ حَتّى اِختَشَت مِنّي",66,"ي",1,0],["وَإِن قامَتِ الحَربا تُوَسِّدُ شَعرَها","أَصيلاً أَذابَ الطَرفَ مِنها هَجيرُها",67,"ر",3,0],["وَإِن قَصَّروا عَن طولِ طَولِهِمُ يَدي","فَما أَمِنوا في عَرضِ عِرضِهِمُ رَكضي",68,"ي",1,0],["وإن قَصّرَتْ عن غايةٍ فلعلّها","تصيّرُ تحجيلاً لغرِّ الفضائِلِ",69,"ل",1,0],["وَأَنقَذَها مِن غَمرَةِ المَوتِ أَنَّهُ","صُدودُ فِراقٍ لا صُدودُ تَعَمُّدِ",70,"د",1,0],["وَاِنقَضَّ لَيلاً عُمَيرٌ بِالحُسامِ عَلى","عَصماءَ حَتّى سَقاها عَلقَمَ العَدَمِ",71,"م",1,0],["وإنْ قلتُ توبلْ خبزَنا قالَ لا تكنْ","مخالفَ ما يعتادُهُ السلفُ الصدرُ",72,"ر",1,0],["وإنْ قلتُ طيِّبْ مطعمي قالَ قد مضتْ","أماثلُ ما للأكلِ عندهمُ قَدْرُ",72,"ر",1,0],["وإنْ قلتُ جمِّلْ بيتنا قالَ كلُّ ذا","فضولٌ وفي أشباهِهِ لمْ يلِقْ فكرُ",72,"ر",1,0],["وإنْ قلتُ قدِّمْ للوضوءِ مسينتي","يقولُ إذا لمْ تستعِنْ يكملُ الطهرُ",72,"ر",1,0],["وإنْ قلتُ قدِّمْ شربةَ الماءِ هزَّها","بغيظٍ رجاءَ أَنْ يكدِّرَها العكرُ",72,"ر",1,0],["وإنْ قلتُ باشرْ بعضَ ما قدْ أهمَّني","يقولُ إذا باشرْتَ أنتَ لكَ الأجرُ",72,"ر",1,0],["وإنْ قلتُ صوِّل قمحَنا قالَ بدعةٌ","أصوِّلُ للهادي وأصحابِهِ البرُّ",72,"ر",1,0],["وإنْ قلتُ في الحمامِ حكَّ رجيلتي","يقولُ ليَ اخشوشِنْ فقد يُبتلى الحرُّ",72,"ر",1,0],["وإنْ قلتُ حقّ الطيبِ قدمْهُ لي يقلْ","قبيحٌ بمنْ لا يخْلُدُ الطيبُ والعطرُ",72,"ر",1,0],["وإنْ قلتُ فاصقلْ ثم فرِّكْ ثيابنا","يقولُ أتفريكٌ لِمَنْ خلفَهُ القبرُ",72,"ر",1,0],["وإنْ قلتُ فانظر في الطعامِ هل استوى","يقولُ افتقدتُ الملحَ فانكبتِ القدرُ",72,"ر",1,0],["وإنْ قلتُ مَنْ بالبابِ قالَ مفوِّلاً","على البابِ عزرائيلُ وانفصلَ الأمرُ",72,"ر",1,0],["وإنْ قلتُ ما الأخبارُ قالَ رديئةٌ","سعَوا فيك أو ماتَ امرؤٌ أو غلا السعرُ",72,"ر",1,0],["وإنْ قلتُ لا تسرقْ ففي المالِ ضيقةٌ","يقولُ أحرْصاً بعدما ذهبَ العمرُ",72,"ر",1,0],["وإنْ قلتُ لا تسألْ منَ الناسِ نفتضحْ","يقولُ فموسى استطعمَ الناسَ والخضرُ",72,"ر",1,0],["وإنْ قلتُ لا تفعلْ أو افعلْ يقولُ قد","بُليتُ بكمْ حتى متى النهْيُ والأمرُ",72,"ر",1,0],["وانقبضْ عنْ كلِّ فانٍ","قبلَ أنْ يُقبضَ عنكا",73,"ك",2,0],["وإنْ قالَ هل ترعى عذاري مُوَرِيَّاً","أقولُ لهُ إيْ والذي أخرجَ المرعى",74,"ع",2,0],["وانقطعَ البحثُ ورالَ المرا","فقدموا الناقصَ والأجهلا",75,"ل",2,0],["وإنْ قاصدٌ منكمْ أتاني فانثنى","كما انتفضَ العصفورُ بللهُ القطرُ",76,"ر",1,0],["وَإِن قاسَمَت في وُدِّهِ ذَهَبَت بِهِ","جَميعاً وَلَم يَرجِع بِشَيءٍ قَسيمُها",77,"م",3,0],["وَأَنقَدُ طَوعاً لِلَّذي أَنتَ أَهلُهُ","عَلى غِلظَةٍ مِنكُم لَنا وَتَجَهُّمِ",78,"م",1,0],["وَاِنقَضى اللَيلُ كُلُّهُ","تِلكَ إِحدى المَصائِبِ",79,"ب",1,0],["وَإِن قَرُبَت داراً بَكَيتُ وَإِن نَأَت","كَلِفتُ فَلا لِلقُربِ أَسلو وَلا البُعدِ",80,"د",1,0],["وَإِن قالَ يا رَبِّ أَينَ القُلوبَ","أَجابَ الوَعيدُ وَهاجَ الغَضَبْ",81,"ب",1,0],["وَانْقضَّ أصحابُه يَلْقونَ من معهُ","مِن قومِهِ فاستحرَّ القتلُ وَاسْتَعَرا",82,"ر",2,0],["وانقضَّ يضربُهُ فيا لكَ مُسلِماً","في اللَّهِ يُضربُ من أبيهِ ويُلْطَمُ",83,"م",1,0],["وإنّ قضاءَ ربّكِ لن يحولا","أراد فما لِوَحْشِيٍّ مَحيدُ",84,"د",1,0],["وَإِن قالَ عاوٍ مِن تَنوخَ قَصيدَةً","بِها جَرَبٌ عُدَّت عَلَيَّ بِزَوبَرا",85,"ر",2,1],["وَإِن قالَ مَولاهُم عَلى جُلِّ حادِثٍ","مِنَ الدَهرِ رُدّوا فَضلَ أَحلامِكُم رَدّوا",86,"د",3,0],["وَإِن قالَ مَولاهُم عَلى جُلِّ حادِثٍ","مِنَ الأَمرِ رُدّوا فَضلَ أَحلامِكُم رَدّوا",86,"د",3,0],["وَاِنقَضَّ إِسماعيلُ مِن بِلادِهِ","إِلَيهِ حَتّى صارَ في قِيادِهِ",87,"ه",1,0],["وَإنْ قَصُرتْ عَنْ شَأْوِهَا كلُّ فِكْرَةٍ","فَلَيْسَتْ يَدٌ للأنْجُمِ الزُّهْرِ تَمْتَدُّ",88,"د",1,0],["وَإِن قُلنا اِقتُلوا عَنكُم","يُباكِر شَربُها الخَمَرا",89,"ر",2,0],["وَإِن قالوا حَرامٌ قُل حَرامٌ","وَلَكِنَّ اللَذاذَةُ في الحَرامِ",90,"م",1,0],["وَإِنَّ قَوماً رَجَوا إِبطالَ حَقَّكُمُ","أَمسَوا مِنَ اللَهِ في سُخطٍ وَعِصيانِ",91,"ن",1,0],["وإن قيلَ الحنيفُ حمّى وعزّاً","يقل ديني تجنّبهُ كسوسِ",92,"س",1,0],["وَإِنَّ قَولاً يَروقُ الخالِدَينِ مَعاً","لَمُسكِتٌ مُخرِسٌ عَن كُلِّ تَحبيرِ",93,"ر",1,0],["وَإِن قَصَدَت دَلَّت عَلى مُتَنَصِّبٍ","ذَليلِ القَرى لا شَيءَ يَفري كَما تَفري",94,"ي",1,0],["وَاِنقَبَضَ اللَيلُ وَلاحَ النورُ","شَمَّرتُ وَالحَزمُ لَهُ تَشميرُ",95,"ر",1,0],["وَإِن قيلَ صَلِّ فَقَد أَذَّنوا","زَمَعتَ كَما يَزمَعُ المُقعَدُ",96,"د",1,0],["وَإِن قامَتِ الحَربُ عَرّاضَةً","قَعَدتَ وَحَرَّضتَ مَن يَقعُدُ",96,"د",1,0],["وَإِنَّ قُطوفَ الساعِ فيما عَلِمتُهُ","أَحَثُّ مُروراً مِن وَساعِ السَلاهِبِ",97,"ب",1,0],["وَإِن قَرَعَ البابَ غاوٍ عَلَي","كَ فَزِدهُ وِثاقاً وَلا تَفَتَحِ",98,"ح",1,0],["وَأَنقى سَوادَ الرَأسِ دَهرٌ وَغاسِلٌ","لِباساً فَأَمّا سوءُ طَبعٍ فَما أَنقى",99,"ق",2,0],["وَاِنقَضَّ كَالدِرّيءِ يَتبَعُهُ","نَقعٌ يَثورُ تَخالُهُ طُنُبا",100,"ب",2,0],["وَإِن قالَ لي ماذا تَرى يَستَشيرُني","يَجِدني اِبنَ عَمٍّ مِخلَطَ الأَمرِ مِزيَلا",101,"ل",2,0],["وانقاد للظلم الصريح ولم يكن","فيما مضى للظلم بالمنقاد",102,"د",1,0],["وإن قَضَت السياسة لي سقوطاً","فَكَم ينقض في ليل شهاب",103,"ب",1,0],["وانقعْ من الغُلّة الأُوارا","واقطفْ من اللّذة الثّمرْ",104,"ر",1,0],["وأنقذيها مِنَ الجوى","يا عاشقاتي على الزَّمانِ",104,"ن",1,0],["وأنقذن هذا الغرامَ الشهيدَ","فقد كادتِ النارُ أن تَلقفَهْ",105,"ه",1,0],["وَإِن قُلتُ رُدّي بَعضَ عَقلي أَعِش بِهِ","تَوَلَّت وَقالَت ذاكَ مِنكَ بَعيدُ",106,"د",1,0],["وإنّ قَميصاً جالَ في الظّنّ أنّه","يَذُودُ الرّزايا لا يُقالُ له غال",107,"ل",1,0],["وانْقَطَعْنَا لِواعِظَاتِ مَشِيبٍ","آذَنَتْنَا حَيَاتُهَا بذَهابِ",108,"ب",1,0],["وَإِنَّ قَوْماً جَاؤُوا لِيُفْنوا","أُمَّتَهَا بُغْيَةَ النُّضَارْ",109,"ر",1,0],["وَإِنْ قِيلَ حُسْنٌ فِي جَلِيبٍ مُنَوَّعٍ","فَقُلْ كُلُّ حُسْنٍ فِي الأَصِيلِ المُجَنَّسِ",110,"س",1,0],["وَانْقَضَتْ تِلْكَ النُحُوسُ ال","دُّكْنُ بَلْ عَادَتْ سُعُودَا",111,"د",2,0],["وإن قلتُ غيرَ الحقِّ لم يرضَ لي به","وأَوْضَح للفكر الّذي هُوَ لائقُ",112,"ق",1,0],["وأَنَّ قَضَاء اللّهِ حُمَّ فمَا لَنَا","مَحِيصٌ ولا مِمَّا قَضَى اللّهُ مَفْزَع",113,"ع",1,0],["وأنقذوا الطفْلَ فما ذَنْبُه","إِنْ جَمَحَ الوالدُ في خُسْرِه",114,"ر",2,0],["وأنقذتَ الكِنانة من فناءٍ","وكنتَ لقومك الركنَ الأشدّا",115,"د",2,0],["وانقلي الخطو باتئاد فقد يجفل","منك الغبار والعنكبوت",116,"ت",1,0],["وانقضى صفو التلاقي وذوت","في صبا الحبّ أمانيه الجسام",117,"م",1,0],["وأنقذني بياض الصبح منها","لقد أنقذت من شر كبير",118,"ر",1,0],["وانقضَّ فوقَك كالعُقابِ وأنَّه","لسواكَ عن المامةٍ يترَففَّع",119,"ع",1,0],["وإن قال رِّفةْ عن حياتي فرأفةٌ","وإن قال دع لي فرجةً لا تضيِّق",120,"ق",1,0],["وَإنْ قَصَدْتَ ابتِغاءَ البُرْءِ من سَقَمٍ،","فقَدْ أرَقْتَ دماً يَشفي من الكَلَبِ",121,"ب",1,0],["وَإنْ قَضَى الله أنْ تَبينَ، فَقَدْ","كانَتْ، فبانَتْ من أهلِها البَصَرَهْ",122,"ر",2,0],["وإنْ قَدَحْتَ النارَ من فِكْرِهِ","في ليلٍ خَطْبٍ أثْقَبَ القَدْحُ",123,"ح",1,0],["وإنّ قِسيَّ لموتورة ٌ","بكل أمين القُوى حادر",124,"ر",1,0],["وانقض همومك عن فؤادك إننا","نلقى الهموم بكل أغلب أضخم",125,"م",1,0],["وَأَنْقَادُ طَوْعاً لِلَّذي أَنْتِ أَهْلُهُ","على غلظة ٍ منكم لنا، وتجهم",126,"م",1,0]]}