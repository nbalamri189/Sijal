ل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[15,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem45262.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140883",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202684","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[90,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[31,"قل للمنازلِ بالظهرانِ قد حانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19127&r=&rc=389",""],[88,"اما آن ان يغشى البلاد سعودها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19509&r=&rc=12",""],[88,"وظبي جاء يطلب جلنارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19547&r=&rc=50",""]],"verses":[["وَقَد مالَ جُلُّ الدُجى وَالصَباح","كَشَقراءَ في جُدُدٍ عادِيَه",0,"ي",2,0],["وَقَد مَدَّ مِن باعِ المَجَرَّةِ فَاِنثَنى","كَأَنَّ الثَرَيّا فيهِ كَفٌّ تُقارِعُ",1,"ع",1,0],["وَقَد مَلَأوا مِنها الأَكُفَّ وَأَهلَها","فَما مَلَأوا مِنها لَحاظَ النَواظِرِ",2,"ر",1,0],["وَقِدماً طالَهُ الخَوفُ","مَطالَ المَخضِ لِلوَطبِ",3,"ب",1,0],["وَقَدَّمَ مِن أَهلِهِ عُصبَةً","لِئامَ الجُدودِ قِباحَ الفِعالِ",4,"ل",1,0],["وَقَدْ مَزَجَتْ ظَمْياءُ بالرّيقِ راحَها","فَلَمْ أَدْرِ مِنْ أَيِّ المُدامَيْنِ أَرْشُفُ",5,"ف",1,0],["وقد مَلأَتْ عُرْضَ السّماوةِ أينُقٌ","تلُفُّ خُزامى رَوضِها بِعَرارِهِ",6,"ر",2,0],["وقَدْ مُحيَتْ آثارُها بذُيولِها","سِوى ما أعارَتْهُ التّرابَ منَ النَّشْرِ",7,"ر",1,0],["وقد مَرَّ عَصْرٌ لم أفُزْ فيهِ بالمُنى","فما لِيَ إلا زَفرَةُ المُتَندِّمِ",8,"م",1,0],["وقدْ مُلِئَتْ أسِرَّتُها حَياءً","وأُلْبِسَتِ المَهابَةَ والجَلالا",9,"ل",2,0],["وَقَد مُلِّيَت لينَ الشَبابِ كَأَنَّها","قَضيبٌ مِنَ الرَيحانِ رَيّانُ أَخضَرُ",10,"ر",1,0],["وقدْ مُزِجَتْ أمْواهُها بدِمائِها","فإنْ ظمِئَتْ لا رِيَّ إلاّ الرّدَى صِرْفا",11,"ف",2,0],["وَقَدْ مَدَحتُكَ فَارْحَمْنِي وَجُدْ فَعَسَى","مِنْ هَوْلِ يَوْمِ اللِّقَا وَالْحَشْرِ تُنْجِينِي",12,"ي",1,0],["وَقَدِمْتَ فِي يَوْمِ الْهِيَاجِ بِفتْيَةٍ","لَمْ تَدْرِ إِلاَّ الْبَطْشَ وَالإِقْدَامَا",13,"م",2,0],["وقد مُدَّ سِتْرُ التِّبْرِ فوقي وأرسَلَتْ","يدُ اليُمْنِ والتّوْفيقِ منْ تحْتِهِ سِتْرا",14,"ر",2,0],["وقدْ مدَدْتُ لإذْنٍ منْ عُلاكَ يَدي","فاسْمَحْ بِها دُمْتَ أعْلى العالَمينَ يَدا",15,"د",2,0],["وقد ماسَتْ غُصونُ البانِ سُكْراً","منَ الأوْراقِ في خُضْرِ البُرودِ",16,"د",1,0],["وَقَد مَلَأَت بَكرٌ وَمَن لَفَّ لَفَّها","نُباكاً فَأَحواضَ الرَجا فَالنَواعِصا",17,"ص",2,0],["وَقَد مَضَيتُ إِلى أَقصى الَّذي ذَكَروا","وَجِئتُ أَرعَنَ وَالشَلّاقُ في عُنُقي",18,"ي",1,0],["وَقَد ماتَتِ الآمالُ عِندي وَإِنَّما","إِلى شَرَفِ الدينِ المَليكِ نُشورُها",19,"ر",3,0],["وَقِدماً أَقَلتَ المُسيءَ العِثارَ","وَأَحسَنتَ بِالصَفحِ عَمّا اِجتَرَم",20,"م",1,0],["وَقِدماً شَكا حَملَ التَمائِمِ يافِعاً","لِيَحمِلَ رَقراقَ الفِرِندِ مُهَنَّدا",21,"د",2,0],["وَقَد مَرَّت عَلى تُرَبانَ تُحدى","لها بالنَعفِ مِن مَللٍ وَسيجُ",22,"ج",1,0],["وَقَد مالَتِ الجَوزاءُ حَتّى كَأَنّها","صِوارٌ تَدَلّى مِن أَميلٍ مُقابِلِ",23,"ل",1,0],["وقد مَثَلَتْ زهرُ النجوم بأفقه","حباباً على نهر المجرة طافيا",24,"ي",2,0],["وقد ملك الإسلام خير خليفة","من البدر أبهى بل من الشمس أشْرَف",25,"ف",1,0],["وقد مَرِصت أرواحنا في انتظارها","فما ضرّها والهفتا لو تعودها",26,"د",3,0],["وَقَد مَلأَت عَلَيكَ الأرض قَيسٌ","وَخِندِفُ دَعوَةَ المُتَمَضِّرِينَا",27,"ن",2,0],["وَقَدَّمتُ نُذري أَن يَقولوا غَدَرتَنا","وَأَقبَلتُ لَم أُرهِق وَلَم أَتَحَيَّلِ",28,"ل",1,0],["وقدَّمت آباءً ونسلاً فكيف لي","بباقيةٍ والأصلُ والفرعُ قد غدا",29,"د",2,0],["وقدّم دمعي قصة في رسومه","فوقّع فيها الوجد يجري على الرسم",30,"م",1,0],["وقدمتني على الأقران ذو نعم","حتَّى جدعت به أنف ابن جدعانِ",31,"ن",1,0],["وقد مضى الصوم ولي مقلة","ما نظرت قطراً سوى دمعها",32,"ه",2,0],["وقد مكَّنتكَ من العارفاتِ","جُدودٌ توليتَ أحسابَها",33,"ب",3,0],["وقِدْماً إذا استبعِد المستقَى","أطال الرِّشاءَ له الماتحُ",34,"ح",1,0],["وقد مات من لا يخلُف الدهر مثلهُ","عليك من الأسلاف والحقُّ يبهر",35,"ر",1,0],["وقدْماً فاز من سمَّ","حَ بالجذر وبالمهر",36,"ر",1,0],["وقدما مضتْ أسيافكم ورماحكم","بأعراقكم دون الظُبا والمخارص",37,"ص",1,0],["وقدماً وددتم وعوديتمُ","وهيهات من ضُرَّ ممن نُفع",38,"ع",1,0],["وقد مُكّنْتَ من دَرَجٍ وِثاقٍ","فلا تَجْبُن من الرُّتَب العوالي",39,"ي",1,0],["وقِدماً علمتُ إذا ما علم","ت من جوهر المرءِ ما المعدنُ",40,"ن",1,0],["وَقَد ماتَت وَصَلَّينا","عَليها وَدَفَنّاها",41,"ا",3,0],["وَقَد منحتُك نَزراً","لا حَقَّكَ المَفروضا",42,"ض",2,0],["وقدم البعض حتى نال بغيته","تزلف لم تمارسه وأدهان",43,"ن",1,0],["وقدّمنا بوارجنا فداء","على الأمواج تضطرم اضطراما",44,"م",2,0],["وَقِدماً دَنَت يونانُ مِنها وَفارِسٌ","وَروما فَحَلّوا في فَسيحِ رِحابِ",45,"ب",1,0],["وَقَد مِتنا ثَباتاً وَاِستَماتوا","وَما البُسَلاءُ كَالمُستَبسِلينا",46,"ا",1,0],["وَقِدماً أَحاطَت بِأَهلِ الأُمورِ","مُيولُ النُفوسِ وَأَضغانُها",47,"ن",3,0],["وَقَد مَزَّقتَ ثَوبَ الغَيِّ عَنهُم","وَقَد أَلبَستُهُم ثَوبَ الرَشادِ",48,"د",1,0],["وَقَد مُنيتُ بِحُسّادٍ أُحارِبُهُم","فَاِجعَل نَداكَ عَلَيهِم بَعضَ أَنصاري",49,"ي",1,0],["وَقَد مُتُّ أَمسِ بِها مَوتَةً","وَلا يَشتَهي المَوتَ مَن ذاقَهُ",50,"ق",2,0],["وَقَد مَدَّتِ الخَيلُ العِتاقُ عُيونَها","إِلى وَقتِ تَبديلِ الرِكابِ مِنَ النَعلِ",51,"ل",1,0],["وقدّم الخيرات واسهر لها","ليلك إنّ الموعد الساهره",52,"ر",2,0],["وقدَّمَ طبَّاخُنَا رُزَّةً","عليها لِثامٌ من السُّكَّرِ",53,"ر",1,0],["وقد مَعَجتْ ريحُ الصَّبَا وتخاوصتْ","نجومٌ لها في طُرَّةِ الغرب تصويبُ",54,"ب",1,0],["وَقِدماً زَجَرتُ النَفسَ عَنها فَخالَفَت","إِلَيها عَلى قُربٍ مِنَ الدارِ أَو بُعدِ",55,"د",1,0],["وَقَد مُلِّيَت فَخراً رَبيعَةُ أَن سَعى","لَها مِن سِوى بَكرِ بنِ وائِلِها بَكرُ",56,"ر",1,0],["وَقَدَّمتَ سَعياً صالِحاً لَكَ ذُخرُهُ","وَكُلُّ الَّذي قَدَّمتَ مِن صالِحٍ ذُخرُ",57,"ر",1,0],["وَقَدِماً لَم أَزَل في حُبِّها","شارِدَ السَمَعِ عَنِ القَولِ الأَرَك",58,"ك",1,0],["وَقِدماً عَصيتُ العاذِلاتِ وَلَم أُطِع","طَوالِعَ هَذا الشَيبِ إِذ جِئنَ لُوَّما",59,"م",2,0],["وَقَد مَدَّ حَولي مِنَ المالِكَي","نِ أَواذِيُّ ذي حَدَبٍ مُزبِدِ",60,"د",1,1],["وَقَد مَرَّ حَولٌ بَعدَ حَولٍ وَأَشهُرٌ","عَلَيهِ بِبُؤسٍ وَهوَ ظَمآنُ جائِعُ",61,"ع",1,0],["وَقَد مُنِيَت مِنّي كُلَيبٌ بِضَيغَمٍ","ثَقيلٍ عَلى الحُبلى جَريرٍ كَلاكِلُه",62,"ل",2,0],["وَقَد ماتَ خَيراهُم فَلَم يُهلِكاهُمُ","عَشِيَّةَ بانا رَهطَ كَعبٍ وَحاتِمِ",63,"م",1,0],["وَقَد ماتَ بِسطامُ اِبنُ قَيسٍ وَعامِرٌ","وَماتَ أَبو غَسّانَ شَيخُ اللَهازِمِ",63,"م",1,0],["وقد مَرِيَ الحَمامُ بها وكانت","على الأفنانِ لا يُغني مَراها",64,"ا",3,0],["وَقَدِّم لِذاكَ فَإِنَّ الفَتى","لَهُ ما يُقَدِّمُ لا ما يَذَر",65,"ر",1,0],["وَقَد مَّدَحتُ بِما تَمَّ البَديعُ بِهِ","مَعَ حُسنِ مُفتَتَحٍ مِنهُ وَمُختَتَمِ",66,"م",1,0],["وَقَدِمتَ نَحوَ دِيارِ بَكرٍ مُظهِراً","عَدلاً يُمَهِّدُ أَرضَها تَمهيدا",67,"د",2,0],["وقدمته للديك وهو كأنما","يطير إليه واثبا متلهفا",68,"ف",2,0],["وقد محا صبغَ الدّياجي قَمَرٌ","دينارُهُ في كَفّةِ الغَرْبِ رَجَح",69,"ح",1,0],["وَقَدَّموا مِنكَ إِن هُم خاطَبوا ذَرِباً","وَرادَسوا حَضرَمِيَّ الصَخرِ رِدّيسا",70,"س",2,0],["وَقَد مَضَت حِجَجٌ مِن بَعدُ أَربَعَةٌ","وَأَشهُرٌ وَاِنتَقَصنا العامَ شَعبانا",71,"ن",2,0],["وَقَد مَسَحَ الصُبحُ كُحلَ الظَلامِ","وَأَطلَعَ فَودُ الدُجى أَشيَبا",72,"ب",2,0],["وَقَد مَلَأتُ سَوادَ العَينِ مِن وَضَحٍ","فَقَرَّطِ السَمعَ قِرطَ الأُنسِ مِن سَمَرِ",73,"ر",1,0],["وَقَد ماتَ قَبلي أَوَّلُ الحُبِّ فَاِنقَضى","فَإِن مِتُّ أَضحى الحُبُّ قَد ماتَ آخِرُه",74,"ر",2,0],["وَقَد مَلَكَ الآفاقَ نَسرٌ مُحَلِّقٌ","يَطوفُ بِأَكنافِ السُهى يَتَصَيَّدُ",75,"د",1,0],["وَقَد مَدَحتُكُمُ عَمداً لِأُرشِدَكُم","كَيما يَكونَ لَكُم مَتحي وَإِمراسي",76,"ي",1,0],["وَقَد مَكَثوا في البَرِّ عُمراً مُجَدَّداً","يُغَذِّيهِمِ العالي بِخَيرِ المَآكِلِ",77,"ل",1,0],["وَقَد مالَت إِلى الغَربِ الثُرَيّا","كَما أَصغى إِلى الحِسِّ الفَروقِ",78,"ق",1,0],["وَقَدَّمَ لِلأَضيافِ فَوهاءَ لَم تَزَل","تُجاهِرُ غَيظاً كُلَّما راحَ رائِحُ",79,"ح",1,0],["وَقِدماً حَمَى مِنْ صاحِبِ الفيلِ بَيْتَهُ","ولمَّا أَتى الحَجَّاجُ أَمْكَنَهُ الهَدُّ",80,"د",1,0],["وَقَدَّمتْكَ جَميعُ الأنبياءِ بِها","والرُّسْلِ تَقْدِيمَ مَخُدُومٍ عَلَى خَدَمِ",81,"م",1,0],["وَقَدَّمَهُ الَّذِينَ لَهُمْ وُصُولٌ","فَتَمَّمَ نَقْصَهُ صِلَةُ اللذينا",82,"ن",2,0],["وقَدّمَ بَكْراً سعيُها قبل تغلبٍ","وقالا لشَيبانٍ جميعاً تَقَدَّمي",83,"ي",1,0],["وقد مُلِئَتْ شُهْباً فلمّا تمرّدَتْ","حَوالَيْه أعداءُ الهدى أحدثتْ قَذفا",84,"ف",2,0],["وقد مارَت البُزلُ القناعيسُ أجبُلاً","وقد ماجَتِ الجُرْدُ العناجيجُ أبحُرا",85,"ر",2,0],["وَقَد مَضى عَنكَ ظَلامُ الدُجى","وَانكَشَفَت أَستارُ أَثوابِهِ",86,"ب",2,0],["وَقَد مَلَكَت بِالجَمالِ الأَنامَ","وَرِقَّ الأَميرِ أَبي الأَزهَرِ",87,"ر",1,0],["وَقَد مُلِئتَ لِعَيني","شُحّاً عَلَيَّ وَبُخلا",88,"ل",2,0],["وَقَدَّمنا مَكانَ النَب","لِ وَالمِطرَدِ رَيحانا",89,"ن",2,0],["وَقَد مَلأتُ البِلادَ ما بَينَ يَع","بورَ إِلى القَيرَوانِ فَاليَمَنِ",90,"ن",1,0],["وَقَد مَضَت لِشانِها المُنقادِ","وَما لِدَمعِ العَينِ مِن نَفادِ",91,"د",1,0],["وَقِدماً ذاكَ ما زالَ","مَحَلَّ اللَهوِ في القُربِ",92,"ب",1,0],["وَقَد مَنَعَت مِنّي زِيارَتَها الَّتي","إِذا كَرُبَت نَفسي شَفَيتُ بِها كَربي",93,"ي",1,0],["وَقَد ماتَ مِن بَعدِ التَغَشمُرُ جَهلُها","فَغُيَّبَ إِلّا أَنَّ هامَتَها القَبرُ",94,"ر",1,0],["وَقِدماً وَجَدنا مُبطِلَ القَومِ يَعتَدي","فَيُنصَرُ وَالغادي مَعَ الحَقِّ يُخذَلُ",95,"ل",1,0],["وَقَد مَلَلتُ زَماناً شَرُّهُ لَهَبٌ","إِذا انا لِخُبُوٍّ عادَ فَاِحتَدَما",96,"م",2,0],["وَقَد مَنّوا بِرِزقِ اللَهِ جَهلاً","كَأَنَّهُمُ لِباغٍ سَبَّبوهُ",97,"ب",3,0],["وَقَد ماجَتِ الأَنساعُ وَاِستَأخَرَت بِها","مَعَ الغَرزِ أَحناءٌ لَهُنَّ دُحوضُ",98,"ض",1,0],["وقَدَّم القائدُ ألفَ راسِ","مِن الجَلاليق ذَوي العمَاسِ",99,"س",1,0],["وقد مت أمس بها موتةً","وما يشتهي الموت من ذاقه",100,"ق",2,0],["وقدِّمي التوبةَ واستمطري","بين يَدْيهِ عبراتِ الندمْ",101,"م",1,0],["وقدم المُعبِّر المبينا","تجده في مظلمة مبينا",102,"ن",2,0],["وَقدَّمت أَعْذارِي وذُلِّي وخشيتي","وجئتُ بضَعْفي شَافِعًا وشَكاتي",103,"ي",1,0],["وقَدَّمَتِ الأَديمَ لِراهِشَيِه","وأَلفَى قَولَها كَذِباً ومَينا",104,"ن",2,0],["وَقَدْ مَالَ لِلْغَرَبِ الْهلالُ كَأَنَّهُ","بِمِنْقَارِهِ عَنْ حَبَّةِ النَّجْمِ يَفْحَصُ",105,"ص",1,0],["وَقَدْ مَاجَتِ الأَغْصَانُ بَيْنَ يَدِ الصَّبا","كَمَا رَفْرَفَتْ طَيْرٌ بِأَجْنِحَةٍ خُضْرِ",106,"ر",1,0],["وقد مَلأَ الأُنْسُ الوجوهَ فأشْرَقتْ","من البِشْرِ حتى كادَ يَقْطُرُ سَائلُهْ",107,"ل",2,0],["وقد مدت الأوتار فيه لحكمة","فجاء بديع الخلق مستحسن النطق",108,"ق",1,0],["وقد مرت نحوسٌ واستمرت","وذلُ القوم نحسٌ مستمر",109,"ر",1,0],["وَقَدْ مَضَتْ حِجَجٌ مِنْ بَعْدُ، أَرْبَعَة ٌ،","وَأَشْهُرٌ وَکنْتَفَضْنا کلْعَامَ شَعْبَانا",110,"ن",2,0],["وقد مرضت أرواحنا في انتظارها","فما ضرها والهفتا لو تعودها",111,"د",3,0],["وقد ملك الخلائقَ ملك أسْر","وأوثقَ في قلوبهم الإسارا",112,"ر",2,0]]}