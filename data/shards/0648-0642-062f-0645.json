,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[461,"خليفة الله مالي كلما بسطت","https://www.aldiwan.net/poem15280.html","البسيط"],[464,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[468,"ألا رب ضيف تقنصته","https://www.aldiwan.net/poem59725.html","المتقارب"],[479,"سماط أمد إلى الظرفا","https://www.aldiwan.net/poem37187.html","المتقارب"],[479,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[479,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[490,"فسائل جمعنا عنا وعنهُم","https://www.aldiwan.net/poem665.html",""],[495,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[500,"رأت أطلال سلما بعد بعد","https://www.aldiwan.net/poem37688.html","الوافر"],[500,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[500,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[515,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[515,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[515,"مضى بدر فأغنى عنه طي","https://www.aldiwan.net/poem12237.html","الوافر"],[515,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[551,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[551,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[551,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[551,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[551,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[551,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[551,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[551,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[551,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[558,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[558,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[558,"علت بي كعبة الذات البديعه","https://www.aldiwan.net/poem34368.html","الوافر"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"هو الله ربي هو المبتدا","https://www.aldiwan.net/poem34598.html","المتقارب"],[567,"يا هند لا تنكري في الأرض مضطربي","https://www.aldiwan.net/poem69560.html","البسيط"],[569,"وقد مات شماخ ومات مزرد","https://www.aldiwan.net/poem52029.html","الطويل"],[575,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[575,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"],[575,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[587,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"]],"verses":[["وَقَد مالَ جُلُّ الدُجى وَالصَباح","كَشَقراءَ في جُدُدٍ عادِيَه",0,"ي",2,0],["وَقَد مَدَّ مِن باعِ المَجَرَّةِ فَاِنثَنى","كَأَنَّ الثَرَيّا فيهِ كَفٌّ تُقارِعُ",1,"ع",1,0],["وَقَد مَلَأوا مِنها الأَكُفَّ وَأَهلَها","فَما مَلَأوا مِنها لَحاظَ النَواظِرِ",2,"ر",1,0],["وَقِدماً طالَهُ الخَوفُ","مَطالَ المَخضِ لِلوَطبِ",3,"ب",1,0],["وَقَدَّمَ مِن أَهلِهِ عُصبَةً","لِئامَ الجُدودِ قِباحَ الفِعالِ",4,"ل",1,0],["وَقَدْ مَزَجَتْ ظَمْياءُ بالرّيقِ راحَها","فَلَمْ أَدْرِ مِنْ أَيِّ المُدامَيْنِ أَرْشُفُ",5,"ف",1,0],["وقد مَلأَتْ عُرْضَ السّماوةِ أينُقٌ","تلُفُّ خُزامى رَوضِها بِعَرارِهِ",6,"ر",2,0],["وقَدْ مُحيَتْ آثارُها بذُيولِها","سِوى ما أعارَتْهُ التّرابَ منَ النَّشْرِ",7,"ر",1,0],["وقد مَرَّ عَصْرٌ لم أفُزْ فيهِ بالمُنى","فما لِيَ إلا زَفرَةُ المُتَندِّمِ",8,"م",1,0],["وقدْ مُلِئَتْ أسِرَّتُها حَياءً","وأُلْبِسَتِ المَهابَةَ والجَلالا",9,"ل",2,0],["وَقَد مُلِّيَت لينَ الشَبابِ كَأَنَّها","قَضيبٌ مِنَ الرَيحانِ رَيّانُ أَخضَرُ",10,"ر",1,0],["وقدْ مُزِجَتْ أمْواهُها بدِمائِها","فإنْ ظمِئَتْ لا رِيَّ إلاّ الرّدَى صِرْفا",11,"ف",2,0],["وَقَدْ مَدَحتُكَ فَارْحَمْنِي وَجُدْ فَعَسَى","مِنْ هَوْلِ يَوْمِ اللِّقَا وَالْحَشْرِ تُنْجِينِي",12,"ي",1,0],["وَقَدِمْتَ فِي يَوْمِ الْهِيَاجِ بِفتْيَةٍ","لَمْ تَدْرِ إِلاَّ الْبَطْشَ وَالإِقْدَامَا",13,"م",2,0],["وقد مُدَّ سِتْرُ التِّبْرِ فوقي وأرسَلَتْ","يدُ اليُمْنِ والتّوْفيقِ منْ تحْتِهِ سِتْرا",14,"ر",2,0],["وقدْ مدَدْتُ لإذْنٍ منْ عُلاكَ يَدي","فاسْمَحْ بِها دُمْتَ أعْلى العالَمينَ يَدا",15,"د",2,0],["وقد ماسَتْ غُصونُ البانِ سُكْراً","منَ الأوْراقِ في خُضْرِ البُرودِ",16,"د",1,0],["وَقَد مَلَأَت بَكرٌ وَمَن لَفَّ لَفَّها","نُباكاً فَأَحواضَ الرَجا فَالنَواعِصا",17,"ص",2,0],["وَقَد مَضَيتُ إِلى أَقصى الَّذي ذَكَروا","وَجِئتُ أَرعَنَ وَالشَلّاقُ في عُنُقي",18,"ي",1,0],["وَقَد ماتَتِ الآمالُ عِندي وَإِنَّما","إِلى شَرَفِ الدينِ المَليكِ نُشورُها",19,"ر",3,0],["وَقِدماً أَقَلتَ المُسيءَ العِثارَ","وَأَحسَنتَ بِالصَفحِ عَمّا اِجتَرَم",20,"م",1,0],["وَقِدماً شَكا حَملَ التَمائِمِ يافِعاً","لِيَحمِلَ رَقراقَ الفِرِندِ مُهَنَّدا",21,"د",2,0],["وَقَد مَرَّت عَلى تُرَبانَ تُحدى","لها بالنَعفِ مِن مَللٍ وَسيجُ",22,"ج",1,0],["وَقَد مالَتِ الجَوزاءُ حَتّى كَأَنّها","صِوارٌ تَدَلّى مِن أَميلٍ مُقابِلِ",23,"ل",1,0],["وقد مَثَلَتْ زهرُ النجوم بأفقه","حباباً على نهر المجرة طافيا",24,"ي",2,0],["وقد ملك الإسلام خير خليفة","من البدر أبهى بل من الشمس أشْرَف",25,"ف",1,0],["وقد مَرِصت أرواحنا في انتظارها","فما ضرّها والهفتا لو تعودها",26,"د",3,0],["وَقَد مَلأَت عَلَيكَ الأرض قَيسٌ","وَخِندِفُ دَعوَةَ المُتَمَضِّرِينَا",27,"ن",2,0],["وَقَدَّمتُ نُذري أَن يَقولوا غَدَرتَنا","وَأَقبَلتُ لَم أُرهِق وَلَم أَتَحَيَّلِ",28,"ل",1,0],["وقدَّمت آباءً ونسلاً فكيف لي","بباقيةٍ والأصلُ والفرعُ قد غدا",29,"د",2,0],["وقدّم دمعي قصة في رسومه","فوقّع فيها الوجد يجري على الرسم",30,"م",1,0],["وقدمتني على الأقران ذو نعم","حتَّى جدعت به أنف ابن جدعانِ",31,"ن",1,0],["وقد مضى الصوم ولي مقلة","ما نظرت قطراً سوى دمعها",32,"ه",2,0],["وقد مكَّنتكَ من العارفاتِ","جُدودٌ توليتَ أحسابَها",33,"ب",3,0],["وقِدْماً إذا استبعِد المستقَى","أطال الرِّشاءَ له الماتحُ",34,"ح",1,0],["وقد مات من لا يخلُف الدهر مثلهُ","عليك من الأسلاف والحقُّ يبهر",35,"ر",1,0],["وقدْماً فاز من سمَّ","حَ بالجذر وبالمهر",36,"ر",1,0],["وقدما مضتْ أسيافكم ورماحكم","بأعراقكم دون الظُبا والمخارص",37,"ص",1,0],["وقدماً وددتم وعوديتمُ","وهيهات من ضُرَّ ممن نُفع",38,"ع",1,0],["وقد مُكّنْتَ من دَرَجٍ وِثاقٍ","فلا تَجْبُن من الرُّتَب العوالي",39,"ي",1,0],["وقِدماً علمتُ إذا ما علم","ت من جوهر المرءِ ما المعدنُ",40,"ن",1,0],["وَقَد ماتَت وَصَلَّينا","عَليها وَدَفَنّاها",41,"ا",3,0],["وَقَد منحتُك نَزراً","لا حَقَّكَ المَفروضا",42,"ض",2,0],["وقدم البعض حتى نال بغيته","تزلف لم تمارسه وأدهان",43,"ن",1,0],["وقدّمنا بوارجنا فداء","على الأمواج تضطرم اضطراما",44,"م",2,0],["وَقِدماً دَنَت يونانُ مِنها وَفارِسٌ","وَروما فَحَلّوا في فَسيحِ رِحابِ",45,"ب",1,0],["وَقَد مِتنا ثَباتاً وَاِستَماتوا","وَما البُسَلاءُ كَالمُستَبسِلينا",46,"ا",1,0],["وَقِدماً أَحاطَت بِأَهلِ الأُمورِ","مُيولُ النُفوسِ وَأَضغانُها",47,"ن",3,0],["وَقَد مَزَّقتَ ثَوبَ الغَيِّ عَنهُم","وَقَد أَلبَستُهُم ثَوبَ الرَشادِ",48,"د",1,0],["وَقَد مُنيتُ بِحُسّادٍ أُحارِبُهُم","فَاِجعَل نَداكَ عَلَيهِم بَعضَ أَنصاري",49,"ي",1,0],["وَقَد مُتُّ أَمسِ بِها مَوتَةً","وَلا يَشتَهي المَوتَ مَن ذاقَهُ",50,"ق",2,0],["وَقَد مَدَّتِ الخَيلُ العِتاقُ عُيونَها","إِلى وَقتِ تَبديلِ الرِكابِ مِنَ النَعلِ",51,"ل",1,0],["وقدّم الخيرات واسهر لها","ليلك إنّ الموعد الساهره",52,"ر",2,0],["وقدَّمَ طبَّاخُنَا رُزَّةً","عليها لِثامٌ من السُّكَّرِ",53,"ر",1,0],["وقد مَعَجتْ ريحُ الصَّبَا وتخاوصتْ","نجومٌ لها في طُرَّةِ الغرب تصويبُ",54,"ب",1,0],["وَقِدماً زَجَرتُ النَفسَ عَنها فَخالَفَت","إِلَيها عَلى قُربٍ مِنَ الدارِ أَو بُعدِ",55,"د",1,0],["وَقَد مُلِّيَت فَخراً رَبيعَةُ أَن سَعى","لَها مِن سِوى بَكرِ بنِ وائِلِها بَكرُ",56,"ر",1,0],["وَقَدَّمتَ سَعياً صالِحاً لَكَ ذُخرُهُ","وَكُلُّ الَّذي قَدَّمتَ مِن صالِحٍ ذُخرُ",57,"ر",1,0],["وَقَدِماً لَم أَزَل في حُبِّها","شارِدَ السَمَعِ عَنِ القَولِ الأَرَك",58,"ك",1,0],["وَقِدماً عَصيتُ العاذِلاتِ وَلَم أُطِع","طَوالِعَ هَذا الشَيبِ إِذ جِئنَ لُوَّما",59,"م",2,0],["وَقَد مَدَّ حَولي مِنَ المالِكَي","نِ أَواذِيُّ ذي حَدَبٍ مُزبِدِ",60,"د",1,1],["وَقَد مَرَّ حَولٌ بَعدَ حَولٍ وَأَشهُرٌ","عَلَيهِ بِبُؤسٍ وَهوَ ظَمآنُ جائِعُ",61,"ع",1,0],["وَقَد مُنِيَت مِنّي كُلَيبٌ بِضَيغَمٍ","ثَقيلٍ عَلى الحُبلى جَريرٍ كَلاكِلُه",62,"ل",2,0],["وَقَد ماتَ خَيراهُم فَلَم يُهلِكاهُمُ","عَشِيَّةَ بانا رَهطَ كَعبٍ وَحاتِمِ",63,"م",1,0],["وَقَد ماتَ بِسطامُ اِبنُ قَيسٍ وَعامِرٌ","وَماتَ أَبو غَسّانَ شَيخُ اللَهازِمِ",63,"م",1,0],["وقد مَرِيَ الحَمامُ بها وكانت","على الأفنانِ لا يُغني مَراها",64,"ا",3,0],["وَقَدِّم لِذاكَ فَإِنَّ الفَتى","لَهُ ما يُقَدِّمُ لا ما يَذَر",65,"ر",1,0],["وَقَد مَّدَحتُ بِما تَمَّ البَديعُ بِهِ","مَعَ حُسنِ مُفتَتَحٍ مِنهُ وَمُختَتَمِ",66,"م",1,0],["وَقَدِمتَ نَحوَ دِيارِ بَكرٍ مُظهِراً","عَدلاً يُمَهِّدُ أَرضَها تَمهيدا",67,"د",2,0],["وقدمته للديك وهو كأنما","يطير إليه واثبا متلهفا",68,"ف",2,0],["وقد محا صبغَ الدّياجي قَمَرٌ","دينارُهُ في كَفّةِ الغَرْبِ رَجَح",69,"ح",1,0],["وَقَدَّموا مِنكَ إِن هُم خاطَبوا ذَرِباً","وَرادَسوا حَضرَمِيَّ الصَخرِ رِدّيسا",70,"س",2,0],["وَقَد مَضَت حِجَجٌ مِن بَعدُ أَربَعَةٌ","وَأَشهُرٌ وَاِنتَقَصنا العامَ شَعبانا",71,"ن",2,0],["وَقَد مَسَحَ الصُبحُ كُحلَ الظَلامِ","وَأَطلَعَ فَودُ الدُجى أَشيَبا",72,"ب",2,0],["وَقَد مَلَأتُ سَوادَ العَينِ مِن وَضَحٍ","فَقَرَّطِ السَمعَ قِرطَ الأُنسِ مِن سَمَرِ",73,"ر",1,0],["وَقَد ماتَ قَبلي أَوَّلُ الحُبِّ فَاِنقَضى","فَإِن مِتُّ أَضحى الحُبُّ قَد ماتَ آخِرُه",74,"ر",2,0],["وَقَد مَلَكَ الآفاقَ نَسرٌ مُحَلِّقٌ","يَطوفُ بِأَكنافِ السُهى يَتَصَيَّدُ",75,"د",1,0],["وَقَد مَدَحتُكُمُ عَمداً لِأُرشِدَكُم","كَيما يَكونَ لَكُم مَتحي وَإِمراسي",76,"ي",1,0],["وَقَد مَكَثوا في البَرِّ عُمراً مُجَدَّداً","يُغَذِّيهِمِ العالي بِخَيرِ المَآكِلِ",77,"ل",1,0],["وَقَد مالَت إِلى الغَربِ الثُرَيّا","كَما أَصغى إِلى الحِسِّ الفَروقِ",78,"ق",1,0],["وَقَدَّمَ لِلأَضيافِ فَوهاءَ لَم تَزَل","تُجاهِرُ غَيظاً كُلَّما راحَ رائِحُ",79,"ح",1,0],["وَقِدماً حَمَى مِنْ صاحِبِ الفيلِ بَيْتَهُ","ولمَّا أَتى الحَجَّاجُ أَمْكَنَهُ الهَدُّ",80,"د",1,0],["وَقَدَّمتْكَ جَميعُ الأنبياءِ بِها","والرُّسْلِ تَقْدِيمَ مَخُدُومٍ عَلَى خَدَمِ",81,"م",1,0],["وَقَدَّمَهُ الَّذِينَ لَهُمْ وُصُولٌ","فَتَمَّمَ نَقْصَهُ صِلَةُ اللذينا",82,"ن",2,0],["وقَدّمَ بَكْراً سعيُها قبل تغلبٍ","وقالا لشَيبانٍ جميعاً تَقَدَّمي",83,"ي",1,0],["وقد مُلِئَتْ شُهْباً فلمّا تمرّدَتْ","حَوالَيْه أعداءُ الهدى أحدثتْ قَذفا",84,"ف",2,0],["وقد مارَت البُزلُ القناعيسُ أجبُلاً","وقد ماجَتِ الجُرْدُ العناجيجُ أبحُرا",85,"ر",2,0],["وَقَد مَضى عَنكَ ظَلامُ الدُجى","وَانكَشَفَت أَستارُ أَثوابِهِ",86,"ب",2,0],["وَقَد مَلَكَت بِالجَمالِ الأَنامَ","وَرِقَّ الأَميرِ أَبي الأَزهَرِ",87,"ر",1,0],["وَقَد مُلِئتَ لِعَيني","شُحّاً عَلَيَّ وَبُخلا",88,"ل",2,0],["وَقَدَّمنا مَكانَ النَب","لِ وَالمِطرَدِ رَيحانا",89,"ن",2,0],["وَقَد مَلأتُ البِلادَ ما بَينَ يَع","بورَ إِلى القَيرَوانِ فَاليَمَنِ",90,"ن",1,0],["وَقَد مَضَت لِشانِها المُنقادِ","وَما لِدَمعِ العَينِ مِن نَفادِ",91,"د",1,0],["وَقِدماً ذاكَ ما زالَ","مَحَلَّ اللَهوِ في القُربِ",92,"ب",1,0],["وَقَد مَنَعَت مِنّي زِيارَتَها الَّتي","إِذا كَرُبَت نَفسي شَفَيتُ بِها كَربي",93,"ي",1,0],["وَقَد ماتَ مِن بَعدِ التَغَشمُرُ جَهلُها","فَغُيَّبَ إِلّا أَنَّ هامَتَها القَبرُ",94,"ر",1,0],["وَقِدماً وَجَدنا مُبطِلَ القَومِ يَعتَدي","فَيُنصَرُ وَالغادي مَعَ الحَقِّ يُخذَلُ",95,"ل",1,0],["وَقَد مَلَلتُ زَماناً شَرُّهُ لَهَبٌ","إِذا انا لِخُبُوٍّ عادَ فَاِحتَدَما",96,"م",2,0],["وَقَد مَنّوا بِرِزقِ اللَهِ جَهلاً","كَأَنَّهُمُ لِباغٍ سَبَّبوهُ",97,"ب",3,0],["وَقَد ماجَتِ الأَنساعُ وَاِستَأخَرَت بِها","مَعَ الغَرزِ أَحناءٌ لَهُنَّ دُحوضُ",98,"ض",1,0],["وقَدَّم القائدُ ألفَ راسِ","مِن الجَلاليق ذَوي العمَاسِ",99,"س",1,0],["وقد مشينا وراء الغرب نقبس من","ضيائه فأصابتنا شظاياه",100,"ا",2,0],["وقد مت أمس بها موتةً","وما يشتهي الموت من ذاقه",101,"ق",2,0],["وقدِّمي التوبةَ واستمطري","بين يَدْيهِ عبراتِ الندمْ",102,"م",1,0],["وقدم المُعبِّر المبينا","تجده في مظلمة مبينا",103,"ن",2,0],["وَقدَّمت أَعْذارِي وذُلِّي وخشيتي","وجئتُ بضَعْفي شَافِعًا وشَكاتي",104,"ي",1,0],["وقَدَّمَتِ الأَديمَ لِراهِشَيِه","وأَلفَى قَولَها كَذِباً ومَينا",105,"ن",2,0],["وَقَدْ مَالَ لِلْغَرَبِ الْهلالُ كَأَنَّهُ","بِمِنْقَارِهِ عَنْ حَبَّةِ النَّجْمِ يَفْحَصُ",106,"ص",1,0],["وَقَدْ مَاجَتِ الأَغْصَانُ بَيْنَ يَدِ الصَّبا","كَمَا رَفْرَفَتْ طَيْرٌ بِأَجْنِحَةٍ خُضْرِ",107,"ر",1,0],["وقد مَلأَ الأُنْسُ الوجوهَ فأشْرَقتْ","من البِشْرِ حتى كادَ يَقْطُرُ سَائلُهْ",108,"ل",2,0],["وقد مدت الأوتار فيه لحكمة","فجاء بديع الخلق مستحسن النطق",109,"ق",1,0],["وقد مرت نحوسٌ واستمرت","وذلُ القوم نحسٌ مستمر",110,"ر",1,0],["وَقَدْ مَضَتْ حِجَجٌ مِنْ بَعْدُ، أَرْبَعَة ٌ،","وَأَشْهُرٌ وَکنْتَفَضْنا کلْعَامَ شَعْبَانا",111,"ن",2,0],["وقد مرضت أرواحنا في انتظارها","فما ضرها والهفتا لو تعودها",112,"د",3,0],["وقد ملك الخلائقَ ملك أسْر","وأوثقَ في قلوبهم الإسارا",113,"ر",2,0],["وَقَد مَلئَت مِنا القُلوب لِفَقدِهِ","مُصاباً وَأَضحى مَجلس العلم خاليا",114,"ي",2,0],["وقد مح بالاسقام جسما فلم يبن","اذا السقم عن لحظ العوائد اخفاه",115,"ا",2,0],["وقد مر الثناءُ بمعطفَيه","كما مَرَّ النسيمُ على القضيبِ",116,"ب",1,0],["وقدم غبي قد رفعت على الورى","فسالت عليه بالبلاء شعاب",117,"ب",1,0],["وقد مزج السحرَ من بدعهَ","شَفا الغى داء بها واشتفي",118,"ف",2,0],["وقَدَّمَ عَنهُ في الإمَامَةِ غَيرَهُ","تَبَيَّنتُ أنَّ الشَّرعَ لَيسَ بِمُتَّبَع",119,"ع",1,0],["وقِدما عصرتُ وجوهَ الرجالِ","فلم أر فيهنَّ وجها بماءِ",120,"ا",2,0],["وَقَدَّمتَ ميقاتَ المَسيرِ لِيَأمَنوا","بِيُمنِكَ سَيراً طالَما كانَ مُعجَلا",121,"ل",2,0],["وَقَد مَرَنَت عَلى قَذعٍ وَجَدعٍ","مَوارِنُ قَطُّ ما عَرَفَت خِطاما",122,"م",2,0],["وَقَدِمتَ مَنصوراً فَزالَت غُمَّةٌ","وَحَلَلتَ مِن بَعضِ القُنوطِ غَماما",123,"م",2,0],["وقد ملأ البلاد عليك رُعباً","إمامٌ خلفه الجيش اللهام",124,"م",1,0],["وقدّمت أسباب العقوق وإنها","لمثمرة في الحشر شرّ مسبب",125,"ب",1,0],["وَقَد مَرَّ ما قالَ النَبيونَ وَالكُتبُ","نَبيٌّ بِغَيرِ الوَحي لا يَتَصَرَّفُ",126,"ف",1,0],["وقدموا وآخروا عوائد","في مدتي تغيرت مدرستي",127,"ت",2,0],["وقد مسها تلك الأكف فديتها","أكفا فما أحلى مكارمها تجنا",128,"ن",2,0],["وقد ملئت منك القولب محبة","وأنت إليها لا تمل التوددا",129,"د",2,0],["وقد مُدّتِ الأيدي وللعفوِ والرضا","من الله سحبٌ بالنوالِ يجودُ",130,"د",1,0],["وقد ملئت تلك القلوب محبة","لهم فيك تنشى بالحيا والتحشم",131,"م",1,0],["وقد ملأت طول البلاد وعرضها","حواليك أشبال الضراغمة الغلب",132,"ب",1,0],["وقدم سعيا صالحا قد شهدتم","على بعضه مرب على الحمد والشكر",133,"ر",1,0],["وقد ملات عرض الفيافي جنوده","وطبقت الدنيا خيولا مواكبه",134,"ب",2,0],["وقدمت خيراً لا تقدم مثله","وقابلت فضل الله بالحمد والشكر",135,"ر",1,0],["وقد مَلَكتْني شيمةٌ ملكيّةٌ","وَهَمِّيَ جِنِّيٌّ الغرامِ مَرِيدُ",136,"د",1,0],["وَقَد مَصَّ مُخَّ العَظمِ حَتّى إِزارهُ","وَبَدَّلَهُ مِن نِيِّهِ بِهُزالِ",137,"ل",1,0],["وَقَد مُلِئتُ بِما عاينتُهُ عَجَبَاً","ما ضَرَّ سَهمَ الرَزايا لَو تَخَطَّانا",138,"ن",2,0],["وَقَد مُنِحَت عَينِى القَذَى لِفِرَاقِكُم","وَعادَ لَها تَهتانُها فَهىَ تَسجُم",139,"م",1,0],["وَقَدَّمنا كَتائِبَها فَجَاسَت","مَواخِيرَ الفُجُورِ المُشركينَا",140,"ن",2,0],["وقد مضى في مثل قد جرى","لحازم لم يخط في دهره",141,"ر",2,0],["وقد مدّ الظلام بجانبيه","وحرّف عن مطالعه السعود",142,"د",1,0],["وَقَد ملكَت خيرَ البلادِ جدودُهم","وَما رَهبوا قتلاً وما رَهبوا أسرا",143,"ر",2,0],["وَقَد مَلكوا الدُنيا بأيسرِ مدّةٍ","فَما فَقَدوا يُسرا ولا وجدوا عسرا",144,"ر",2,0],["وَقَد مُسِخَت مِنهم خنازيرُ جمّةٌ","وَبَعضٌ غدا قرداً وبعضٌ غدا فأرا",144,"ر",2,0],["وقدمُ الصدقِ وخير الخلقِ","مِن كلِّ خلقِ اللَّه أعلى قَدَما",145,"م",2,0],["وَقُدِّمتُ قَبلَكَ نَحوَ الحِمامِ","وَبَعدَ مَماتي فَعِش أَنتَ حِينا",146,"ن",2,0],["وَقَد مَنَعوا سَبتاً مِنَ الدَهرِ لَقحَةً","تَدُرُّ بِرُسلٍ فاضِلٍ ثُمَّ تَصدُرُ",147,"ر",1,0],["وَقَد ماتَ شماخ ومات مزرَّد","واي عزيز لا ابالك يمنعُ",148,"ع",1,0],["وقد ماتَ ذوو الكافا","تِ والندمانُ والقصفُ",149,"ف",1,0],["وقد مدَّت حواجبها شراكاً","وطيرُ الروحِ دانيةُ الوقوعِ",150,"ع",1,0],["وقد مرت الأيام مرا كأنها","خواطر قلب هام في طلعة الفجر",151,"ر",1,0],["وقد منّ الحميد به علينا","فما عذر اللبيب عن التواني",152,"ي",1,0],["وقد مَدَّ في النِّيلِ بدرُ الدُّجَى","صفيحةَ سَيْفٍ صَقِيلٍ يَمانِ",153,"ن",1,0],["وقد مزجنا اعتناقاً","مِزاجَ ماء بخمر",154,"ر",1,0],["وق