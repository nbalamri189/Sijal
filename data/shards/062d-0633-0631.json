.ae/diwan/poem/130553","الرمل"],[4732,"المرأ يحسب أنه مأمون","https://www.poetsgate.com/ViewPoem.aspx?id=173334",""],[4978,"حسبيَ الله ونعم الوكيل","https://www.poetsgate.com/ViewPoem.aspx?id=177363",""],[4984,"منبع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175804",""],[5002,"شوكة الأوجاع....","https://www.poetsgate.com/ViewPoem.aspx?id=205730",""],[5026,"ثقب في كفن الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=210851",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5186,"يا رعى الله ما رعت بكفيا","https://www.poetsgate.com/ViewPoem.aspx?id=156509",""],[5219,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=194428",""],[5338,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[402,"حسرة أي حسرة أن تبيني","https://www.poetsgate.com/ViewPoem.aspx?id=36466",""],[5997,"لا تخشي","https://www.poetsgate.com/ViewPoem.aspx?id=214204",""],[4442,"ما بال جفنك لا يدر","https://www.poetsgate.com/ViewPoem.aspx?id=171226",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""]],"verses":[["حَسَرَ الدُجى فَنَصَبتَ أَعناقَ العِدا","قُبَلاً لِنَيلِ رَواكِعِ الشَريانِ",0,"ن",1,0],["حَسَرى تَجاوَبُ بِالبُكاءِ عُيونُها","وَتَعُطُّ بِالزَفَراتِ في أَبرادِها",1,"د",3,0],["حَسرَةٌ عِندَ أَنَّةٍ عِندَ آهٍ","تَحتَها زَفرَةٌ تُذيبُ الصِلابا",2,"ب",2,0],["حَسرى تَكادُ تُعيدُ فَحمَةَ لَيلِها","ناراً بِأَنّاتٍ ذَكَينَ طِوالِ",3,"ل",1,0],["حَسْرَةٌ أيُّ أنْ تَبِينِي","وَأَرَانِي فِي مَوْقِفِ التَّأْبِينِ",4,"ن",1,1],["حَسْرَةٌ للِضِّعَافِ أنَّ يَداً","نَصَرَتْهُمُ تُغَلُّ فِي كفَنِ",5,"ن",1,0],["حسرتي مع ذا ومع ذا فأنا","معهمُ مع بعدهم في معمَعه",6,"ع",2,0],["حسرتي للطرَاء في حُلَّتيهِ","لهفتي للشباب في قُوَّادِهْ",7,"د",2,0],["حَسَرتْ غمرةُ الغوايةِ عنّي","ولقد خُضْتُها مع الخُوّاض",8,"ض",1,0],["حسرتي للورقِ المك","ت