{"poems":[[47,"ألمت وهل إلمامها لك نافيع","https://www.aldiwan.net/poem64706.html","الطويل"],[147,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[189,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[240,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[343,"إذا أعطاك قتر حين يعطي","https://www.aldiwan.net/poem68832.html","الوافر"],[438,"يا مثلا في فضله سائرا","https://www.aldiwan.net/poem12353.html","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71027","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119865","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59279","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108529","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100254","السريع"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58463","السريع"],[4988,"سيرة بطل راحت معاه الكرامه","https://www.poetsgate.com/ViewPoem.aspx?id=186507",""],[5725,"مسّيته بدرا","https://www.poetsgate.com/ViewPoem.aspx?id=178243",""]],"verses":[["يُبَخِّلُ إِجلالاً وَيُكبَرُ هَيبَةً","أَصيلُ الحِجى فيهِ تُقىً وَتَواضُعُ",0,"ع",1,0],["يُبِخِّلُ الدِيمَةَ الوَطفاءَ مُختَصِراً","وَيَسبِقُ الحَرجَفَ النَكباءَ مُتَّئِدا",1,"د",2,0],["يُبخِّل جودُه دِيَمَ الغَوادِي","ويُخجِل وجهُه بدر التَّمام",2,"م",1,0],["يُبَخِّلُ جودُهُ صَوبَ ال","حَيا الساري إِذا رَجَسا",3,"س",2,0],["يبخل إِن جدبٌ عَرا","ولا يجودُ بالقِرى",4,"ر",2,0],["يُبَخِّلُ رَبَّهُ سَفَهاً وَظُلماً","وَيَعذِرُ نَفسَهُ فيما يَشاءُ",5,"ا",2,0],["يبخَلُ بالماءِ على أَنَّه","مُنْغَمِسٌ في وَسَطِ النِّيل",6,"ل",1,0],["يَبْخل بالزاد على الرفيقِ","ويُكثر الطيش على الصديقِ",7,"ق",1,0],["يبخل حاتم كرما لديه","ويحببن عنده زيد وعمرو",8,"ر",2,0],["يَبْخَلُ بِالْوَصْلِ وَالسَّلاَمِ وَمَا","أرِيدُ إلاَّ وَصْلَهُ وَالسَّلاَمْ",9,"م",1,0],["يبخ على قلوب الناس ناراً","أصار الورد في الدنيا لهيبا",10,"ب",2,0],["يبخل بالريقِ ويسخوبه","فطارداً حيناً وحيناً طرد",11,"د",1,0],["يبخَل باللحمِ ولكنّه","يَسْمَحُ لِلغلمانِ",12,"ن",1,0],["يبخصهم اللي عاين وعنده المام","في مكرهم والليل طوّل ظلامه",13,"م",2,0],["يبخل في سقاي من خده","ومن نداه البحر فيضا جرى",14,"ر",2,0]]}