{"poems":[[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[63,"تراءت لنا والبدر وهنا على قدر","https://www.aldiwan.net/poem46189.html","الطويل"],[55,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[77,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[42,"أنت الفتى وابن الفتى وأخو الفتى","https://www.aldiwan.net/poem50283.html","الطويل"],[86,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[86,"قصر الدبارة هل أتاك حديثنا","https://www.aldiwan.net/poem10693.html","الكامل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[5,"نكرُ بنات حلابٍ عليهم","https://www.aldiwan.net/poem313.html",""],[35,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[54,"أتيت ابن عمرو فصادفته","https://www.aldiwan.net/poem27410.html","المتقارب"],[54,"غصبت عجلا على فرجين في سنة","https://www.aldiwan.net/poem28546.html","البسيط"],[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[88,"نكب الشارع الكبير ببغداد","https://www.aldiwan.net/poem44426.html","الخفيف"],[88,"هلم إلى ذوق طعم الأدب","https://www.aldiwan.net/poem44429.html","المتقارب"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[27,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[23,"كبرت كذاك المرء ما عاش يكبر","https://www.aldiwan.net/poem21567.html","الطويل"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[51,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"ويلك يا قد البرستوجه","https://www.aldiwan.net/poem9242.html","السريع"],[51,"إن المنية لا تبقي على أحد","https://www.aldiwan.net/poem10865.html","البسيط"],[51,"لا تسقرط يا أبا يحيى","https://www.aldiwan.net/poem64536.html","مجزوء الرمل"],[51,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[51,"ما نكهت في مجلس شنطف","https://www.aldiwan.net/poem64597.html","البسيط"],[51,"رب هيفاء رداح","https://www.aldiwan.net/poem64963.html","مجزوء الرمل"],[51,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"دهر علا قدر الوضيع به","https://www.aldiwan.net/poem65442.html","أحذ الكامل"],[51,"نكهت شنطف ففاح كنيف","https://www.aldiwan.net/poem65728.html","الطويل"],[51,"أقرضته أيرا فرد لسانا","https://www.aldiwan.net/poem66469.html","الكامل"],[51,"أيها الشاتمي في كل حين","https://www.aldiwan.net/poem66532.html","الخفيف"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[62,"ما للظباء غداة سائفة النقا","https://www.aldiwan.net/poem52335.html","الكامل"],[45,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[45,"ما لها أولعت بقطع الوداد","https://www.aldiwan.net/poem63473.html","الخفيف"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"يا أبا جعفر غدونا حديثا","https://www.aldiwan.net/poem64636.html","الخفيف"],[45,"نكتم وديعة أردشير ولم يكن","https://www.aldiwan.net/poem65150.html","الكامل"],[45,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[28,"أعياش قد برذنت خيلك كلها","https://www.aldiwan.net/poem1254.html",""],[28,"نكفي الأعنة يوم الحرب مشعلة","https://www.aldiwan.net/poem1282.html",""],[66,"زوج الماء بابنة العنقود","https://www.aldiwan.net/poem40987.html","الخفيف"],[80,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[44,"نكست رأسي بين جلاسي","https://www.aldiwan.net/poem30032.html","الكامل"],[44,"لامته لام عشيرها وحميمها","https://www.aldiwan.net/poem30348.html","الكامل"],[31,"أشارت إلينا بالبنان تحية","https://www.aldiwan.net/poem41307.html","الطويل"],[105,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[105,"مكسويني كتبت للناس درسا","https://www.aldiwan.net/poem43079.html","الخفيف"],[105,"ما للسحاب تدفقت أخلافه","https://www.aldiwan.net/poem43119.html","الكامل"],[105,"يا بني سعد بن بكر مرحبا","https://www.aldiwan.net/poem43987.html","الرمل"],[105,"يا بني الحارث بن كعب سلام","https://www.aldiwan.net/poem44004.html","الخفيف"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[48,"لم يبق لي في غيرها لذة","https://www.aldiwan.net/poem63290.html","السريع"],[48,"نك ابن العم ذا القربى","https://www.aldiwan.net/poem66212.html","الهزج"],[48,"نكنا رسول عنان","https://www.aldiwan.net/poem66220.html","المجتث"],[48,"نك من لقيت من الصباح","https://www.aldiwan.net/poem66610.html","مجزوء الكامل"],[48,"نك من لقيت من الظبا","https://www.aldiwan.net/poem66614.html","مجزوء الكامل"],[48,"نك بني الدنيا ولا تعف أخاكا","https://www.aldiwan.net/poem66615.html","الرمل"],[48,"نك ابن العمة الأمرد","https://www.aldiwan.net/poem66617.html","الهزج"],[48,"جاهر بنفسك واهتك السترا","https://www.aldiwan.net/poem66621.html","الكامل"],[48,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[46,"تستروا بأمور في ديانتهم","https://www.aldiwan.net/poem23052.html","البسيط"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[76,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43654","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[45,"يا أبا جَعْفَرٍ! غَدَوْنَا حَديثاً","https://www.poetsgate.com/ViewPoem.aspx?id=31133",""],[28,"يا ظمي ويحك إني ذو محافظة","https://www.poetsgate.com/ViewPoem.aspx?id=22024",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[105,"أترى الكنانة كيف تعبث بالدم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54977&r=&rc=147",""],[105,"مكسويني كتبت للناس درساً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54981&r=&rc=151",""]],"verses":[["نَكَصَت أَسِنَّتُهُ وَأَحجَمَ جُندُه","جَزعاً لَمَطلَعِ ذَلِكَ الأَمرِ",0,"ر",1,0],["نَكَصْنَ على الأعقابِ دونَ ارتيابِهِ","تَعَثّرُ في أذيالِهنَّ على صُغْرِ",1,"ر",1,0],["نَكُبُّ وَنَبزُلُ مِثلَ الغَزا","لِ لَم تَحمِلِ الرَأسُ مِنهُ قُرونا",2,"ن",2,0],["نَكَثُ الْعُهُودَ وَغَرَّهُ شَيْطَانُهُ","وَرَأَى الْوَفَاءَ بِمَا وَفَيْتَ حَرَامَا",3,"م",2,0],["نُكَلِّفُ رَسْمَ الدَّارِ رَجْعَ جَوَابِنَا","وَذَلِكَ شَيْءٌ مَا إِلَيْهِ سَبِيلُ",4,"ل",1,0],["نُكُولٌ عَن الجَلّى وَقُربٌ مِنَ الخَنا","وَبُخلٌ عَن الجَدوى وَأَنَّكَ تُبَّعُ",5,"ع",1,0],["نُكِبَ الطِبُّ فيهِ يَومَ تَوَلّى","وَأُصيبَت رَوائِعُ الآدابِ",6,"ب",1,0],["نُكِبوا وَأَقفَرَتِ المَنازِلُ بَعدَهُم","لَو كُنتَ حاضِرَ أَمرِهِم لَم يُنكَبوا",7,"ب",3,0],["نَكادُ حينَ تُناجيكُم ضَمائِرُنا","يَقضي عَلَينا الأَسى لَولا تَأَسّينا",8,"ن",2,0],["نَكرُ بَناتِ حَلّابٍ عَلَيهِم","وَنَزجُرُهُنَّ بَينَ هلّاً وَهابَ",9,"ب",1,1],["نَكونُ بَعيري ذِي غِنىً فَيُضِيعُنا","فَلا هُوَ يَرعانا وَلا نَحنُ نُطلَبُ",10,"ب",1,0],["نِكَايَةُ الدَّهْرِ لا يَفْنَى لَهَا لَعِبٌ","بِالنَّاسِ تَلْعَبُهُ فِي اللَّهْوِ وَالأَلَمِ",11,"م",1,0],["نَكَثتَ مَرايِرَ ذاكَ المَدي","حِ جَهلاً فَقُلِّدتُ أَنكاثَها",12,"ث",3,0],["نِك مَن هَويتَ وَنَل ما شِئتَ مِن نَسَبٍ","أَنتَ اِبنُ زِريابَ مَنسوباً إِلى نَشَبِك",13,"ك",1,0],["نَكُرُّ عَلَيهِمُ وَالخَيلُ تَردي","تَرى فِيها مِن الطَعنِ أَزوِرارا",14,"ر",2,0],["نكّب الشارع الكبير ببغدا","د ولا تمش فيه إلا اضطرارا",15,"ر",2,1],["نكاد إذا هي غنّت نطي","ر إليها بأجنحة من طرب",16,"ب",1,0],["نكن لكم حلف صدق في سياستكم","نمشي إلى الموت من جرّائكم زمرا",17,"ر",2,0],["نَكُرَّ الخَيلَ عائِدَةً عَلَيهِم","تَوَطَّأُ مِنهُمُ قَتلى لِئاما",18,"م",2,0],["نَكِل لَهُمُ بالصَّاعِ من ذاكَ أصُوعاً","ويَأتِيهُم بالسَّجلِ من َذاكَ أَسجَلُ",19,"ل",1,0],["نَكونُ زِمامَ القائِدينَ إِلى الوَغى","إِذا الفَشِلُ الرِعديدُ لَم يَتَقَدَّمِ",20,"م",1,0],["نَكُبُّ الكُماةَ الشوسَ عِندَ اِصطِلائِها","قَتَلنا وُلاةَ الشُركِ مَن كانَ يَكفُرُ",21,"ر",1,0],["نكادُ نلقاك بالذكرى إذا خطرت","كأنما اسمك يا سُعدى مسمَّاك",22,"ك",1,0],["نكهةٌ عذبةٌ وطعم لذيذٌ","سَاعدا نَعمةً إلى نَعْماءَ",23,"ا",2,0],["نَكِّلْهُ إن أناساً قبله ركبوا","بدون ما قد أتاهُ باسقَ الخَشبِ",24,"ب",1,0],["نِكنا فنكنا منك دُرَّاعةً","مِنْ قُبْلِها والدُّبْرُ مفروجَهْ",25,"ج",2,0],["نَكَأْتَ منهم كُلُوماً كان يَكلِمُها","رَيْبُ الزمان فتأسوها بخَيْرِ يَدِ",26,"د",1,0],["نِكْ عجوزاً أو فتاةً","إنما الفاتك فائز",27,"ز",1,0],["نكَّب هُدِيتَ من الرجا","ل يُوقَّ جدُّك جُلَّ تعسه",28,"س",2,0],["نكهتُها تقتلُ جُلاسها","لقرب مَفساها في المحسَى",29,"س",2,0],["نِكْتُها بين يديه","وافترقنا عن تراضي",30,"ي",1,0],["نكيرٌ لئن كانت ودائع مثلها","حقائبَ أمثالي ويذهبن ضُيَّعا",31,"ع",2,0],["نكحتم بلا مهر قوافيَ لستمُ","بأكفائها فاللائعات تلوعها",32,"ع",3,0],["نِكْل العدوِّ يرى به أسفاً","جهماً عبوساً موحشاً كنفه",33,"ف",2,0],["نكهت شنطف ففاح كنيفٌ","وأتاها امرؤ فصاح الغريقا",34,"ق",2,1],["نكتُ العجوزَ فظل يشتم سادراً","وقرُونه يصرعنَه ألوانا",35,"ن",2,0],["نِكت أُمَّيهما وما زلتُ قدماً","بالأعادي مظفَّر الجُرذان",36,"ن",1,0],["نَكادُ نَفتَرِشُ الثَرى وَبِأَرضِنا","لِلأَجنَبِيِّ مَوائِدٌ وَكَراسي",37,"ي",1,0],["نكباء تقلع كل شيء","تلتقيه او تطر",38,"ر",1,0],["نَكَدٌ خالِدٌ وَبُؤسٌ مُقيمٌ","وَشَقاءٌ يَجُدُّ مِنهُ شَقاءُ",39,"ا",2,0],["نَكِرتُكَ حَتّى طالَ مِنكَ تَعَجُّبي","وَلا عَجَبٌ مِن حُسنِ ما اللَهُ خالِقُ",40,"ق",1,0],["نكسٌ من الداءِ القديمِ أجَدَّ بِي","يأساً وكنتُ طمِعتُ في الإفراقِ",41,"ق",1,0],["نَكَباتٌ عَضَضنَ حُرّاً كَريماً","طابَ فَاِستَعذَبَتهُ عَضّاً نُكوبُ",42,"ب",1,0],["نَكَرتِني فَقُلتُ لا تَنكِريني","لَم أَحُل عَن خَلائِقي وَإِعتِيادي",43,"ي",1,0],["نَكَّلتَ بِالرُؤَساءِ مِنهُم جَهرَةً","كَي ما تُسَكِّنَ شِرَّةَ الرَجّاسِ",44,"س",1,0],["نِك غُلامي إِذا اِتَّخَذتُ غُلاماً","وَاِعفُ إِنَّ المَعروفَ كانَ قُروضا",45,"ض",2,0],["نِكتُم وَديعَةَ أَردَشيرَ وَلَم يَكُن","في الحَقِّ نَيكُ وَدائِعِ الأَشرافِ",46,"ف",1,1],["نُكَرِّرُ بَيعَ الوَشيِ بِالخَزِّ مُثمِناً","وَقَيضَ البُرودِ عِندَنا بِالمَطارِفِ",47,"ف",1,0],["نَكرَهُ العاجِزَ الضَعيفَ إِذا جا","ءَ وَكُنتَ القَوِيَّ فينا الأَمينا",48,"ن",2,0],["نُكِستَ عَنِ التَشبيبِ قِرداً وَلَم تَكُن","لِتُشبِهَ عِندَ السِنِّ حَزناً وَتَغلِبا",49,"ب",2,0],["نَكفي الأَعِنَّةَ يَومَ الحَربُ مُشعَلَةٌ","وَاِبنُ المَراغَةُ خَلفَ العيرِ مَضروبُ",50,"ب",1,1],["نَكَبَت مَرتَعَ الشَآمِ وَأَمَّت","نَحوَ مَرعىً أَحوى وَظِلٍّ مَديدِ",51,"د",1,0],["نَكّبْتُ عن ذِكْرِ الهوى والمها","ونفيها للشيخِ غير الهوان",52,"ن",1,0],["نَكَّستُ رَأسي بَينَ جُلّاسي","وَنَحنُ مِن ساقٍ وَمِن حاسي",53,"س",2,1],["نَكِرَت فَتىً أَذرى بِنَضرَةِ وَجهِهِ","وَبِمائِهِ نَكَدُ الخُطوبِ وَلومُها",54,"م",3,0],["نُكَذِّبُ مَن قَد ظَنَّ أَنّا سَنَلتَقي","وَنَأمَنُ مَن في صَدرِهِ شَنَآنُ",55,"ن",1,0],["نُكِبَ الحجيجُ وبات كلُّ موحِّدٍ","قلِق الهمومِ مُسهَّد الآلامِ",56,"م",1,0],["نَكبَةٌ زُلزِلَت لَها دَولَةُ الحَق","قِ وَلِلحَقِّ دَولَةٌ مِن حُماتِهْ",57,"ت",2,0],["نُكِبوا بِأَيّامٍ تَتابَعَ نَحسُها","فَلِكُلِّ قَومٍ يَومُهُم وَالمَهلِكُ",58,"ك",1,0],["نكبةُ التَّمرِ فلولا شؤمُه","لم يَذُقْ آلامَهَا من نُكِبا",59,"ب",2,0],["نَكرهُ الشَّرَّ قادرِينَ ونأبا","هُ وللشَّرِّ في النُّفوسِ اضْطِرامُ",60,"م",1,0],["نكص الشِّركَ على أعقابِهِ","وَهَوَى القائِمُ من أنصابِهِ",61,"ه",1,0],["نَكهَتُها أَطيَبُ مِن فارَةٍ","مَملوءَةٍ مِسكاً لِعَطّارِ",62,"ر",1,0],["نِك ابنَ العمّ ذا القربى","وجارَ الجنبِ بالشُفعه",63,"ع",2,1],["نِكنا رسولَ عنانٍ","والرأي فيما فعلنا",64,"ن",2,1],["نك مَن لقيتَ من الصباح","ولا تفكّر في افتضاح",65,"ح",1,1],["نِك من لقيتَ من الظبا","واشرب محرّمةَ الشرابِ",66,"ب",1,1],["نِك بني الدنيا ولا تعفُ أخاكا","لا ولا ضيفاً كريما إن أتاكا",67,"ك",2,1],["نِك ابنَ العمّة الأمرَ","دَ وابنَ الخالِ والخالَه",68,"ه",1,1],["نِك مَن لقيتَ فإنّني لكَ ناصحٌ","واشرب وإن حرِمَت أخي الخمرا",69,"ر",2,0],["نك مَن لقيتَ من البَشر","واعذر أخاكَ إذا فجَر",70,"ر",1,1],["نَكىً زادَهُ بِالمُلحِدينَ فَأَصبَحوا","خَبيئاً كَمَن تَحتَ الثَرى أَو مُجَرَّدا",71,"د",2,0],["نُكَذِّبُ العَقلَ في تَصديقِ كاذِبِهِم","وَالعَقلُ أَولى بِإِكرامٍ وَتَصديقِ",72,"ق",1,0],["نَكَّبتُها مائَهُم لَمّا رَأَيتَهُمُ","صُهبَ السِبالِ بِأَيديهِم بَيازيرُ",73,"ر",1,0],["نَكصتْ ضَلالَتُهمْ على أعقابِها","وانصاعَ كفرُهمُ على الأدراجِ",74,"ج",1,0],["نُكِبَت بِكُم وَأَصابَها مِن ظُلمِكُم","بَطشُ العَسوفِ وَغَضبَةُ المُتَهَضِّمِ",75,"م",1,0],["نكاد نُحِسُّ اختلاجَ النجوم","ونسمع مُضْطرباً في الرياحْ",76,"ح",1,0],["نَكّسْتِ قُرْطَيْكِ تَعذيباً وما سَحَرا","أخِلْتِ قُرْطَيْكِ هاروتاً وماروتا",77,"ت",2,0],["نَكبةُ الشَّرْقِ مُحْدِثونَ حَقِيقو","نَ بِأَنْ تَرجَح الدّبى وَيَشِيلُو",78,"ل",2,0],["نَكَأنَ قُروحي لَو أَعَنَّ على الأَسى","بِدَمعٍ أَلا إِنَّ الحَزينَ يُعانُ",79,"ن",1,0],["نكَثُوا جُرْحَها فسالتْ دِمَاهَا","قَطَرَاتٍ تَجْرِي إِلى قَطَرَاتِ",80,"ت",1,0],["نُكَرِّرُ الشكْرَ مُخْلِصِينَا","لِمَنْ أَعَادَ الْحَيَاةَ فِينا",81,"ن",2,0],["نُكذب مَوْته، ونشكُّ فيه","ولا شكُّ، هناك ولا احتمال",82,"ل",1,0],["نكب القوم للأذقان صرعى","ونأخذ بالترائب والصدور",83,"ر",1,0],["نَكِروا النفوسَ وفجَّروا اعراقَها","صَمْتاً ، فلا صَخَبٌ ، ولا إرزام",84,"م",1,0],["نُكرٌ لو استَعلى ، لما استَعْلَت يَدٌ","بالعُروة الوثْقى لها استِعصام",84,"م",1,0],["نُكافحُ دهراً ويستَسْلِمُ","ونُغلبُ طَوراً ونَسْتَسلِم",85,"م",1,0],["نِك غُلاَمي إذا اتَّحَذْتُ غُلاماً","واعْفُ، إنَّ المَعرُوف كان قُرُضا",86,"ض",2,0],["نَكَادُ آذانُهَا في المَاءِ يَقْصِفُهَا","بِيضُ المَلاغِيمِ أمْثَالُ الخَواتِيمِ",87,"م",1,0],["نكصت عن لقائك الأقوام","فإذا أنت الواثب الهجام",88,"م",1,0],["نكيت بكم وأصابها من ظلمكم","بطش العسوف وغضبة المتهضم",89,"م",1,0],["نكبة ٌ زلزلت لها دولة الحق","وللحق دولة ٌ من حماته",90,"ت",2,0]]}