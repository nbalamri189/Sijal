يرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[371,"نك سيبويه ونك أبا تمام","https://www.aldiwan.net/poem57107.html","الكامل"],[371,"نكرت معرفتي لما حكم","https://www.aldiwan.net/poem57166.html","الرمل"],[371,"لمن العيس أصبحت مستقله","https://www.aldiwan.net/poem57189.html","الخفيف"],[371,"هذا وكم مترشح","https://www.aldiwan.net/poem57444.html","مجزوء الكامل"],[371,"أرأيت ما صنع القريب النائي","https://www.aldiwan.net/poem57539.html","الكامل"],[377,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[377,"إلام إلام ظلما يا حسود","https://www.aldiwan.net/poem59453.html","البسيط"],[377,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[393,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[393,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[393,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[396,"ألا حي سلمى في الخليط المُفارق","https://www.aldiwan.net/poem602.html",""],[403,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[406,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[409,"نكست في الخلق وحطتني","https://www.aldiwan.net/poem31943.html","السريع"],[416,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[432,"يا نجم دين الله حي","https://www.aldiwan.net/poem12503.html","مجزوء الكامل"],[439,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[441,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[458,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[458,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[458,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[458,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[461,"نكبا صمتي وخافا صخبي","https://www.aldiwan.net/poem15144.html","الرمل"],[461,"ان الوزارة وهي معتلج العلى","https://www.aldiwan.net/poem15592.html","الكامل"],[461,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[461,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[477,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[477,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[493,"صحبت الدهر في سهل وحزن","https://www.aldiwan.net/poem67313.html","الوافر"],[495,"ما كان ليلي ليلا","https://www.aldiwan.net/poem9881.html","المجتث"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[515,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[523,"وقالوا من نكحت فقلتُ خيراً","https://www.aldiwan.net/poem715.html",""],[540,"نكس لما أتيت سائله","https://www.aldiwan.net/poem56804.html","المنسرح"],[544,"حديقة بلا غناء","https://www.aldiwan.net/poem67250.html","عموديه"],[551,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["نَكَصَت أَسِنَّتُهُ وَأَحجَمَ جُندُه","جَزعاً لَمَطلَعِ ذَلِكَ الأَمرِ",0,"ر",1,0],["نَكَصْنَ على الأعقابِ دونَ ارتيابِهِ","تَعَثّرُ في أذيالِهنَّ على صُغْرِ",1,"ر",1,0],["نَكُبُّ وَنَبزُلُ مِثلَ الغَزا","لِ لَم تَحمِلِ الرَأسُ مِنهُ قُرونا",2,"ن",2,0],["نَكَثُ الْعُهُودَ وَغَرَّهُ شَيْطَانُهُ","وَرَأَى الْوَفَاءَ بِمَا وَفَيْتَ حَرَامَا",3,"م",2,0],["نُكَلِّفُ رَسْمَ الدَّارِ رَجْعَ جَوَابِنَا","وَذَلِكَ شَيْءٌ مَا إِلَيْهِ سَبِيلُ",4,"ل",1,0],["نُكُولٌ عَن الجَلّى وَقُربٌ مِنَ الخَنا","وَبُخلٌ عَن الجَدوى وَأَنَّكَ تُبَّعُ",5,"ع",1,0],["نُكِبَ الطِبُّ فيهِ يَومَ تَوَلّى","وَأُصيبَت رَوائِعُ الآدابِ",6,"ب",1,0],["نُكِبوا وَأَقفَرَتِ المَنازِلُ بَعدَهُم","لَو كُنتَ حاضِرَ أَمرِهِم لَم يُنكَبوا",7,"ب",3,0],["نَكادُ حينَ تُناجيكُم ضَمائِرُنا","يَقضي عَلَينا الأَسى لَولا تَأَسّينا",8,"ن",2,0],["نَكرُ بَناتِ حَلّابٍ عَلَيهِم","وَنَزجُرُهُنَّ بَينَ هلّاً وَهابَ",9,"ب",1,1],["نَكونُ بَعيري ذِي غِنىً فَيُضِيعُنا","فَلا هُوَ يَرعانا وَلا نَحنُ نُطلَبُ",10,"ب",1,0],["نِكَايَةُ الدَّهْرِ لا يَفْنَى لَهَا لَعِبٌ","بِالنَّاسِ تَلْعَبُهُ فِي اللَّهْوِ وَالأَلَمِ",11,"م",1,0],["نَكَثتَ مَرايِرَ ذاكَ المَدي","حِ جَهلاً فَقُلِّدتُ أَنكاثَها",12,"ث",3,0],["نِك مَن هَويتَ وَنَل ما شِئتَ مِن نَسَبٍ","أَنتَ اِبنُ زِريابَ مَنسوباً إِلى نَشَبِك",13,"ك",1,0],["نَكُرُّ عَلَيهِمُ وَالخَيلُ تَردي","تَرى فِيها مِن الطَعنِ أَزوِرارا",14,"ر",2,0],["نكّب الشارع الكبير ببغدا","د ولا تمش فيه إلا اضطرارا",15,"ر",2,1],["نكاد إذا هي غنّت نطي","ر إليها بأجنحة من طرب",16,"ب",1,0],["نكن لكم حلف صدق في سياستكم","نمشي إلى الموت من جرّائكم زمرا",17,"ر",2,0],["نَكُرَّ الخَيلَ عائِدَةً عَلَيهِم","تَوَطَّأُ مِنهُمُ قَتلى لِئاما",18,"م",2,0],["نَكِل لَهُمُ بالصَّاعِ من ذاكَ أصُوعاً","ويَأتِيهُم بالسَّجلِ من َذاكَ أَسجَلُ",19,"ل",1,0],["نَكونُ زِمامَ القائِدينَ إِلى الوَغى","إِذا الفَشِلُ الرِعديدُ لَم يَتَقَدَّمِ",20,"م",1,0],["نَكُبُّ الكُماةَ الشوسَ عِندَ اِصطِلائِها","قَتَلنا وُلاةَ الشُركِ مَن كانَ يَكفُرُ",21,"ر",1,0],["نكادُ نلقاك بالذكرى إذا خطرت","كأنما اسمك يا سُعدى مسمَّاك",22,"ك",1,0],["نكهةٌ عذبةٌ وطعم لذيذٌ","سَاعدا نَعمةً إلى نَعْماءَ",23,"ا",2,0],["نَكِّلْهُ إن أناساً قبله ركبوا","بدون ما قد أتاهُ باسقَ الخَشبِ",24,"ب",1,0],["نِكنا فنكنا منك دُرَّاعةً","مِنْ قُبْلِها والدُّبْرُ مفروجَهْ",25,"ج",2,0],["نَكَأْتَ منهم كُلُوماً كان يَكلِمُها","رَيْبُ الزمان فتأسوها بخَيْرِ يَدِ",26,"د",1,0],["نِكْ عجوزاً أو فتاةً","إنما الفاتك فائز",27,"ز",1,0],["نكَّب هُدِيتَ من الرجا","ل يُوقَّ جدُّك جُلَّ تعسه",28,"س",2,0],["نكهتُها تقتلُ جُلاسها","لقرب مَفساها في المحسَى",29,"س",2,0],["نِكْتُها بين يديه","وافترقنا عن تراضي",30,"ي",1,0],["نكيرٌ لئن كانت ودائع مثلها","حقائبَ أمثالي ويذهبن ضُيَّعا",31,"ع",2,0],["نكحتم بلا مهر قوافيَ لستمُ","بأكفائها فاللائعات تلوعها",32,"ع",3,0],["نِكْل العدوِّ يرى به أسفاً","جهماً عبوساً موحشاً كنفه",33,"ف",2,0],["نكهت شنطف ففاح كنيفٌ","وأتاها امرؤ فصاح الغريقا",34,"ق",2,1],["نكتُ العجوزَ فظل يشتم سادراً","وقرُونه يصرعنَه ألوانا",35,"ن",2,0],["نِكت أُمَّيهما وما زلتُ قدماً","بالأعادي مظفَّر الجُرذان",36,"ن",1,0],["نَكادُ نَفتَرِشُ الثَرى وَبِأَرضِنا","لِلأَجنَبِيِّ مَوائِدٌ وَكَراسي",37,"ي",1,0],["نكباء تقلع كل شيء","تلتقيه او تطر",38,"ر",1,0],["نَكَدٌ خالِدٌ وَبُؤسٌ مُقيمٌ","وَشَقاءٌ يَجُدُّ مِنهُ شَقاءُ",39,"ا",2,0],["نَكِرتُكَ حَتّى طالَ مِنكَ تَعَجُّبي","وَلا عَجَبٌ مِن حُسنِ ما اللَهُ خالِقُ",40,"ق",1,0],["نكسٌ من الداءِ القديمِ أجَدَّ بِي","يأساً وكنتُ طمِعتُ في الإفراقِ",41,"ق",1,0],["نَكَباتٌ عَضَضنَ حُرّاً كَريماً","طابَ فَاِستَعذَبَتهُ عَضّاً نُكوبُ",42,"ب",1,0],["نَكَرتِني فَقُلتُ لا تَنكِريني","لَم أَحُل عَن خَلائِقي وَإِعتِيادي",43,"ي",1,0],["نَكَّلتَ بِالرُؤَساءِ مِنهُم جَهرَةً","كَي ما تُسَكِّنَ شِرَّةَ الرَجّاسِ",44,"س",1,0],["نِك غُلامي إِذا اِتَّخَذتُ غُلاماً","وَاِعفُ إِنَّ المَعروفَ كانَ قُروضا",45,"ض",2,0],["نِكتُم وَديعَةَ أَردَشيرَ وَلَم يَكُن","في الحَقِّ نَيكُ وَدائِعِ الأَشرافِ",46,"ف",1,1],["نُكَرِّرُ بَيعَ الوَشيِ بِالخَزِّ مُثمِناً","وَقَيضَ البُرودِ عِندَنا بِالمَطارِفِ",47,"ف",1,0],["نَكرَهُ العاجِزَ الضَعيفَ إِذا جا","ءَ وَكُنتَ القَوِيَّ فينا الأَمينا",48,"ن",2,0],["نُكِستَ عَنِ التَشبيبِ قِرداً وَلَم تَكُن","لِتُشبِهَ عِندَ السِنِّ حَزناً وَتَغلِبا",49,"ب",2,0],["نَكفي الأَعِنَّةَ يَومَ الحَربُ مُشعَلَةٌ","وَاِبنُ المَراغَةُ خَلفَ العيرِ مَضروبُ",50,"ب",1,1],["نَكَبَت مَرتَعَ الشَآمِ وَأَمَّت","نَحوَ مَرعىً أَحوى وَظِلٍّ مَديدِ",51,"د",1,0],["نَكّبْتُ عن ذِكْرِ الهوى والمها","ونفيها للشيخِ غير الهوان",52,"ن",1,0],["نَكَّستُ رَأسي بَينَ جُلّاسي","وَنَحنُ مِن ساقٍ وَمِن حاسي",53,"س",2,1],["نَكِرَت فَتىً أَذرى بِنَضرَةِ وَجهِهِ","وَبِمائِهِ نَكَدُ الخُطوبِ وَلومُها",54,"م",3,0],["نُكَذِّبُ مَن قَد ظَنَّ أَنّا سَنَلتَقي","وَنَأمَنُ مَن في صَدرِهِ شَنَآنُ",55,"ن",1,0],["نُكِبَ الحجيجُ وبات كلُّ موحِّدٍ","قلِق الهمومِ مُسهَّد الآلامِ",56,"م",1,0],["نَكبَةٌ زُلزِلَت لَها دَولَةُ الحَق","قِ وَلِلحَقِّ دَولَةٌ مِن حُماتِهْ",57,"ت",2,0],["نُكِبوا بِأَيّامٍ تَتابَعَ نَحسُها","فَلِكُلِّ قَومٍ يَومُهُم وَالمَهلِكُ",58,"ك",1,0],["نكبةُ التَّمرِ فلولا شؤمُه","لم يَذُقْ آلامَهَا من نُكِبا",59,"ب",2,0],["نَكرهُ الشَّرَّ قادرِينَ ونأبا","هُ وللشَّرِّ في النُّفوسِ اضْطِرامُ",60,"م",1,0],["نكص الشِّركَ على أعقابِهِ","وَهَوَى القائِمُ من أنصابِهِ",61,"ه",1,0],["نَكهَتُها أَطيَبُ مِن فارَةٍ","مَملوءَةٍ مِسكاً لِعَطّارِ",62,"ر",1,0],["نِك ابنَ العمّ ذا القربى","وجارَ الجنبِ بالشُفعه",63,"ع",2,1],["نِكنا رسولَ عنانٍ","والرأي فيما فعلنا",64,"ن",2,1],["نك مَن لقيتَ من الصباح","ولا تفكّر في افتضاح",65,"ح",1,1],["نِك من لقيتَ من الظبا","واشرب محرّمةَ الشرابِ",66,"ب",1,1],["نِك بني الدنيا ولا تعفُ أخاكا","لا ولا ضيفاً كريما إن أتاكا",67,"ك",2,1],["نِك ابنَ العمّة الأمرَ","دَ وابنَ الخالِ والخالَه",68,"ه",1,1],["نِك مَن لقيتَ فإنّني لكَ ناصحٌ","واشرب وإن حرِمَت أخي الخمرا",69,"ر",2,0],["نك مَن لقيتَ من البَشر","واعذر أخاكَ إذا فجَر",70,"ر",1,1],["نَكىً زادَهُ بِالمُلحِدينَ فَأَصبَحوا","خَبيئاً كَمَن تَحتَ الثَرى أَو مُجَرَّدا",71,"د",2,0],["نُكَذِّبُ العَقلَ في تَصديقِ كاذِبِهِم","وَالعَقلُ أَولى بِإِكرامٍ وَتَصديقِ",72,"ق",1,0],["نَكَّبتُها مائَهُم لَمّا رَأَيتَهُمُ","صُهبَ السِبالِ بِأَيديهِم بَيازيرُ",73,"ر",1,0],["نَكصتْ ضَلالَتُهمْ على أعقابِها","وانصاعَ كفرُهمُ على الأدراجِ",74,"ج",1,0],["نُكِبَت بِكُم وَأَصابَها مِن ظُلمِكُم","بَطشُ العَسوفِ وَغَضبَةُ المُتَهَضِّمِ",75,"م",1,0],["نكاد نُحِسُّ اختلاجَ النجوم","ونسمع مُضْطرباً في الرياحْ",76,"ح",1,0],["نَكّسْتِ قُرْطَيْكِ تَعذيباً وما سَحَرا","أخِلْتِ قُرْطَيْكِ هاروتاً وماروتا",77,"ت",2,0],["نَكبةُ الشَّرْقِ مُحْدِثونَ حَقِيقو","نَ بِأَنْ تَرجَح الدّبى وَيَشِيلُو",78,"ل",2,0],["نَكَأنَ قُروحي لَو أَعَنَّ على الأَسى","بِدَمعٍ أَلا إِنَّ الحَزينَ يُعانُ",79,"ن",1,0],["نكَثُوا جُرْحَها فسالتْ دِمَاهَا","قَطَرَاتٍ تَجْرِي إِلى قَطَرَاتِ",80,"ت",1,0],["نُكَرِّرُ الشكْرَ مُخْلِصِينَا","لِمَنْ أَعَادَ الْحَيَاةَ فِينا",81,"ن",2,0],["نُكذب مَوْته، ونشكُّ فيه","ولا شكُّ، هناك ولا احتمال",82,"ل",1,0],["نكب القوم للأذقان صرعى","ونأخذ بالترائب والصدور",83,"ر",1,0],["نَكِروا النفوس