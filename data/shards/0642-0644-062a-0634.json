{"poems":[[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[47,"إن شعري سار في كل بلد","https://www.aldiwan.net/poem63530.html","البسيط"],[71,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[50,"يا عارم الطرف حيثما نظرا","https://www.aldiwan.net/poem63292.html","المنسرح"],[52,"خاط لي عمرو قبا","https://www.aldiwan.net/poem64881.html","مجزوء الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43828","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[208,"وعروس من بنات الكرم","https://www.aldiwan.net/poem53300.html","مجزوء الرمل"],[214,"زاد وجدي واصطباري ذهبا","https://www.aldiwan.net/poem13495.html","الرمل"],[457,"ونديم طارحته بعض ما بي","https://www.aldiwan.net/poem13635.html","الخفيف"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73990","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26522","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53063","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203023","الخفيف"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107063","الخفيف"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107072","الخفيف"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32383","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85205","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32413","الرمل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28631","الخفيف"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22799","الرمل"],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[463,"إن كنتَ ممّن يلجُ الوادي فسلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60240&r=&rc=296",""]],"verses":[["قلتُ شاءٌ مجنَّباتٌ لأُسدٍ","عُوّدتْ جرَّها إلى الأشبالِ",0,"ل",1,0],["قلت شعراً فكاد يأكل لما","سمعوه كالنار قلب الحسود",1,"د",1,0],["قُلتُ شِعراً في الغَواني حَسَناً","تَرَكَ الشِعرَ سِواهُ قَد كَسَد",2,"د",1,0],["قلتُ شويتَ القلبَ مني بما","جئتَ فاستوصِ بي مُجمِلا",3,"ل",2,0],["قُلتَ شُعاعٌ فَكَيفَ أَشرَبُها","لَو كانَ خَمراً لَأَبرَزَت كَدَرا",4,"ر",2,0],["قُلتُ شِعراً لَيسَ يَدري","أَمَديحٌ أَم هِجا",5,"ج",2,0],["قُلتُ شَكا قالوا أَلَي","سَ صابِراً قُلتُ بَلى",6,"ل",2,1],["قلتَ شعراً فلم يكنْ غيرَ بحرٍ","من دُموعٍ طفا بتفْعيلاتِه",7,"ت",2,0],["قلتَ شمسٌ تتلالا","طلعت في كفِّ بدرِ",8,"ر",1,0],["قلت شوقا عند ما قبلته","ألف أهلا من حبيبي مرحاب",9,"ب",1,0],["قلت شَنّفْ مسامعي وتمنى","قال بنت الكروم وابن السحاب",10,"ب",1,0],["قلتِ شكا فأين دعوى صبره","كُرِّي اللحاظَ واسألي عن الخَبلْ",11,"ل",1,0],["قلت شمس الضحى اشد ابتذالاً","وهي محبوبةٌ إلى كل طبع",12,"ع",1,0],["قُلتُ شَيبٌ وَلَيسَ عَيباً فَأَنَّت","أَنَّةً يَستَثيرُها المَهمومُ",13,"م",1,0],["قلت شاه ارمن موسى دونكم","فردوا صفو الغمام المستماح",14,"ح",1,0],["قلت شأني إرسال شعريَ سيلا","ما عليّ التنسيق للأنهار",15,"ر",1,0],["قلت شعراً تظن بغداد أني","رمت فيه جوائزاً ذهبيه",16,"ي",2,0],["قلت شعراً وقلت شعراً فميز","أي شعر أحق بالأولويه",17,"ه",1,1],["قُلتُ شَيخُ كَما تَرَينَ كَبيرَ","لَم يُرِد قَطُّ لِلغَواني اِتِّباعا",18,"ع",2,0],["قلت شتان بين سحر حلال","بين أجفانه وسحر حرام",19,"م",1,0],["قُلتَ شَمسٌ يَومَ دَجنٍ","حَسَرَت عَنها السَحابا",20,"ب",2,0],["قُلتُ شَيء حُرِمتُه","لَيسَ لي ما حُرِمتُه",21,"ت",2,0],["قُلتُ شِعراً يُنزِلُ الأَع","صَمَ مِن رَأسِ الصِياصي",22,"ص",2,0],["قُلْتُ شِعْراً زَادَهُ الإحْ","سَاسُ عِزّاً فَاسْتَقَرَّا",23,"ر",2,1],["قلت: شتانَ بين شدْوٍ رقيق","ونعيبٍ مذُمَّمٍ ونَهيق",24,"ق",1,0],["قلتِ شكا فأين دعوى صبره","كرِّي اللحاظَ واسئلي عن الخبلْ",25,"ل",1,0]]}