{"poems":[[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[72,"بروحي من قد زارني وهو خائف","https://www.aldiwan.net/poem42941.html","الطويل"],[72,"يحدثني زيد عن البان والحمى","https://www.aldiwan.net/poem43015.html","الطويل"],[80,"يا غيم عيني أقوى منك تهتانا","https://www.aldiwan.net/poem14211.html","البسيط"],[87,"أحوم على حسنكم ما أحوم","https://www.aldiwan.net/poem7760.html","المتقارب"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[119,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[202,"لمغناك سح المزن أدمع باك","https://www.aldiwan.net/poem51909.html","الطويل"],[230,"أغرتك الغراء أم طلعة البدر","https://www.aldiwan.net/poem55246.html","الطويل"],[237,"محاجر الظبيات الحاجريات","https://www.aldiwan.net/poem14719.html","البسيط"],[358,"فدى لك ذا العبد مع ما ملك","https://www.aldiwan.net/poem40009.html","المتقارب"],[376,"كأن هواكم كان لي فيكم عذلا","https://www.aldiwan.net/poem57188.html","الطويل"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[556,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[556,"ألا ليت عيشا ماضيا عنك بالحمى","https://www.aldiwan.net/poem47878.html","الطويل"],[616,"","https://poetry.dctabudhabi.ae/diwan/poem/204391","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110415","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38422","الطويل"],[1655,"","https://poetry.dctabudhabi.ae/diwan/poem/130742","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49559","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118337","الوافر"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83224","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130081","الطويل"],[3372,"","https://poetry.dctabudhabi.ae/diwan/poem/198805",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48289","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66329","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91430","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216757","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216825","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131210",""],[3838,"","https://poetry.dctabudhabi.ae/diwan/poem/105689","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135763","الرجز"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29323","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94790","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136604",""],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198187","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57982","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33366","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[5090,"أغنية للحب","https://www.poetsgate.com/ViewPoem.aspx?id=186814",""],[5277,"صفعةُ القرن","https://www.poetsgate.com/ViewPoem.aspx?id=204495",""],[5539,"الشتا","https://www.poetsgate.com/ViewPoem.aspx?id=193390",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5660,"أَرى في عُيوني وُجوهاً كَثيرَه","https://www.poetsgate.com/ViewPoem.aspx?id=23973",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5969,"ذَكرتُ خيالَ من أمسى هلالا","https://www.poetsgate.com/ViewPoem.aspx?id=198735",""],[557,"أحزان مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67203&r=&rc=65",""]],"verses":[["ويا زاجري الأظعانِ وهي ضوامِرٌ","دعُوها تردْ هيماً عطاشاً على نَجْدِ",0,"د",1,0],["وَيازائِراً قَد زارَ مِن غَيرِ مَوعِدٍ","وَحَقِّكَ إِنّي شاكِرٌ لَكَ حامِدُ",1,"د",1,0],["وَيا زَيدُ زِدني مِن حَديثِكَ إِنَّهُ","حَديثٌ عَجيبٌ كُلُّهُ وَغَريبُ",2,"ب",1,0],["وَيا زَيدُ لَقَد زادَ الرَجا بِكُما","أَن يَشفَعَ اللَهُ بِالاحسان إِحسانا",3,"ن",2,0],["ويا زهر لا حسدتك القلوب","فشملك في العاشقين النظيم",4,"م",1,0],["ويا زعيماً بأن لم يأته خبرٌ","عمّا يُنشَّرُ من تلك الدواوين",5,"ن",1,0],["وَيَا زَهْرَةَ الْحُبِّ الَّتِي بِذُبُولِهَا","ذُبُولُ فُؤَادِي النَّاشِيءِ المُتَرَعْرِعِ",6,"ع",1,0],["ويا زَهرةً من رياض الخُلود","تَغوَّلها عاصفٌ مُرزِم",7,"م",1,0],["وَيَا زَمَناً قَالُوا بِهِ الرِّقُّ حُرمَا","عَلامَ أُبِيحَ الطِّفْلُ لِلْجُوعِ وَالظَّمَا",8,"م",2,0],["ويا زاكي الأخلاق يا وافر الثنا","ويا عزتي الطبع يا من سما قدرا",9,"ر",2,0],["ويا زهرةً أذوى الحمامُ رياضَها","لقد فجعتْ كفُّ الحِمامِ رباكِ",10,"ك",1,0],["وَيا زينَةَ الدُنيا وَإِنسان عينِها","تَهَنَّأ بما تَهواهُ يا مُفرَدَ العَصر",11,"ر",1,0],["وَيا زَمانَ عَشِياتِ الحِمى قَسَماً","إلّا أَعَدت لَنا تِلكَ العَشِيّاتِ",12,"ت",1,0],["وَيا زينة الدَهر دُم سالِماً","مَدى الدَهر وَالدَهر كَالعَبد لَك",13,"ك",1,0],["ويا زَمنَ العُشَّاقِ خُذها بِثارِهم","فَقَد أكثرَت في أهلِكَ الأسرَ والقَتلا",14,"ل",2,0],["ويا زَفْرَتِي هَلْ فِي وَقُودِكِ جَذْوَةٌ","تُنِيرُ لَنَا صُبْحاً ثَنَاهُ الأَسى مُسْيا",15,"ي",2,0],["ويا زائري من غير أن أستزيرهُ","كما زِيرَ حَيْزومُ الفتى باللّهاذِمِ",16,"م",1,0],["ويا زَوْرَنا لمّا سمحتَ بزَوْرةٍ","سمحتَ بها وهْناً ونحنُ هُجُودُ",17,"د",1,0],["ويأزر إيمان البلاد إليهم","إذا ظهرت فيها الهنات الفظائع",18,"ع",1,0],["ويا زَهرُ فلتَذبُل ويا زُهرُ فاغرُبي","على من كزهر الروض كانت وكالزُهرِ",19,"ر",1,0],["وَيا زَهرَةً مِن نَرجسٍ شمتها زَهت","وَقَد نَفَحت في الرّوضِ أَعطَرَ نَفحةِ",20,"ه",1,1],["ويا زمانُ لحا عُودي مُماطلةً","رفِّه عليَّ لحاكَ اللَه من زَمَنِ",21,"ن",1,0],["ويا زُهْرُ يا كلّ الحياة وبعضُهُمْ","وحاشاك نار لا أقول حرور",22,"ر",1,0],["ويا زين الاباعد والاداني","ويا زين المحافل والنوادي",23,"د",2,0],["وَيا زَهوَ نَفسي حينَ أَسمَعُ مِدحَتي","فَأَزداد نَظماً مِن جَواهِر جَعبَتي",24,"ت",2,0],["ويا زبيري كذبت فاغتدى","وجهك ما بين البرايا اسودا",25,"د",2,0],["ويا زوجة الشهم الأبيِّ تجلّداً","وإن عزَّ في هذا المصاب التجلّدُ",26,"د",1,0],["ويا زايد الفكر والمنجزات","ويا مصلح البين.. يوم النزاعِ",27,"ع",1,0],["ويا زمناً للرّضَى قد مضى","لعلّكَ ممّا مضَى ثمّ عادْ",28,"د",1,0],["ويا زماني تقضّى","ما كان أعذب وردك",29,"ك",1,0],["وَيا زُمرُّدَ ذيّاك العذار لَقَد","أَنبتَّ في ورد ذاك الخدّ نسرينا",30,"ن",2,0],["ويا زمناً سارياً هل تعود","وإني ملبّ بها خادر",31,"ر",1,0],["ويا زائراً قبري محا الليل بُعْدَنا","فما بيننا إلا الصفائح والعمر",32,"ر",1,0],["ويا زيد لا يخدعك خب مصانعٌ","لئيم السجايا فاسد القلب والفم",33,"م",1,0],["ويازعماء الدين لا تتفيئوا","ضلالا وفي الشمس الحسين بلا ثوب",34,"ب",1,0],["ويا زكيُّ فأكمِلنْ مرادي","في كل ما أريدُ في البلادِ",35,"د",1,0],["وَيا زَهرَةً في شاطيءِ الحُزنِ أَينَعَت","وَقَد أَتحَفَت مِنها الخَريفَ بَواكِرُ",36,"ر",1,0],["ويا زهر ذيّاك الخزام فهل ترى","عبيراًوهل للعرف عُرفٌ بطيبةِ",37,"ه",1,0],["ويا زفيرَ الشوق ذابت كبدي","وأنت عن أحشاي لا ترتحل",38,"ل",1,0],["ويا ((زائِداً))قَدْ حازَ شَعْبُكَ وَازْدَهَى","بإِسمِكَ في الدُنيا عَلاءاً وَسُؤْدَدَا",39,"د",2,0],["ويا زمني هل رفعةٌ بعد حِطَّةٍ","وهل راجعٌ شيئاً لنا أنتَ سالبُهْ",40,"ب",2,0],["ويا زهرةَ الدنيا وبهجةَ حسنِها","ومن أنا منهُ بالأماني قانِعُ",41,"ع",1,0],["وَيا زَفَراتي اِصعَدي وَتَنفَّسي","فَقَد هَمَلت مِن فَيضِ جَفني المَدامِعُ",42,"ع",1,0],["ويا زمني هكذا ترتضي","بموتِ الأماني ووأد القيمْ",43,"م",1,0],["ويا \"زبيدةَ\" نادي غيمةً غربتْ","كانتْ تصيخُ إلى أخبارِ \"هارونِ\"",44,"ن",1,0],["ويازين ذاك البن مع مقدم الضيف","بن يسوونه حشام ن حبايب",45,"ب",1,0],["ويازين صحبة طيب الناس والملا","ومغنيك عن كل المخلايق قاطبه",46,"ب",2,0],["وَ يا زورَ عِشقٍ وَ يا طولَ وَهمٍ","وَ هَذي الحَياةُ أَراها حَقيرَه",47,"ر",2,0],["ويا زين مشيّه وهو بين البعاريني","في مهمهاً توها تنبت نواويره",48,"ر",2,0],["ويا زَهرَ الحَديقَةِ كُل صُبحٍ","يُعطرُنا فَيمنَحُنا جَمالا",49,"ل",2,0],["ويا زهرة عانقتنا رؤاها","ومنها رأينا الأسى والعزاء",50,"ا",2,0]]}