www.poetsgate.com/ViewPoem.aspx?id=179685",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"من يد الرئيس","https://www.poetsgate.com/ViewPoem.aspx?id=179357",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[86,"الاسكندريه","https://www.poetsgate.com/ViewPoem.aspx?id=10627",""],[96,"من الأعماق","https://www.poetsgate.com/ViewPoem.aspx?id=15722",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[90,"فطار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178939",""],[90,"يا شعب","https://www.poetsgate.com/ViewPoem.aspx?id=178937",""],[90,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[91,"شكوى","https://www.poetsgate.com/ViewPoem.aspx?id=53033",""],[91,"شاعر الدير","https://www.poetsgate.com/ViewPoem.aspx?id=14221",""],[99,"من مفكرة عاشق دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=568",""],[99,"من مفكرة عاشق دمشقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=308&r=&rc=41",""],[88,"إذا انقضى مارْتُ فاكسر خلفه الكوزا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""]],"verses":[["يا شامِتاً بِالسَيفِ أُغمِدَ غَربُهُ","كَم هَبَّ مُندَلِقُ الغِرارِ وَصالا",0,"ل",2,0],["يا شافِيَ الأَدواءِ كَيفَ جَهِلتَهُ","داءً رَماكَ بِهِ الزَمانُ عُضالا",0,"ل",2,0],["يا شَقيقي وَالقَنا يُغ","ضِبُ في العَدلِ شَقيقَه",1,"ق",2,0],["يا شاةَ ما قَنَصٍ لِمَن حَلَّت لَهُ","حَرُمَت عَلَيَّ وَلَيتَها لَم تَحرُمِ",2,"م",1,0],["يا شَمسَ بَغدادَ إِنَّني دَنِفُ","إِذ ماتَ مِنكِ الوِدادُ وَاللَطَفُ",3,"ف",1,1],["يا شُغلَ نَفسي عَنِ الدُنيا وَبَهجَتِها","ما تَأمُرينَ بِصَبِّ القَلبِ مَعمودِ",4,"د",1,0],["يَا شَمْسَ فَضْلٍ سَنَاهَا لَيْسَ يَحْتَجِبُ","وَالشَّمْسُ تُسْفِرُ أَحْيَاناً وَتَنْتَقِبُ",5,"ب",1,1],["يا شَهيدَ الإِصلاحِ غادَرتَ مِصراً","وَهيَ تَجتازُ هَولَ دَورِ اِنتِقالِ",6,"ل",1,0],["يا شُجاعاً وَما الشَجاعَةُ إِلّا ال","صَبرُ لا الخَوضُ في صُدورِ الصِعابِ",7,"ب",1,0],["يا شاعِرَ الشَرقِ اِتَّئِد","ماذا تُحاوِلُ بَعدَ ذاك",8,"ك",1,1],["يا شاعِراً أَلغَزَ لي","مِن شِعرِهِ بَديعُهُ",9,"ه",1,1],["يَا شِقيقَ الفقِيدِ صَبْراً عَلَى رُزْ","ئيْك فَهْوَ الشَّقِيقُ وَهْوَ الخَدِينُ",10,"ن",1,0],["يَا شَاعِرَ العَرَبِ الَّذِي آثَارُهُ","جَمَعَتْ عُيونَ الشِّعْرِ فِي دِيوَانِ",11,"ن",1,0],["يَا شَاعِرَ النِّيلِ جَارِ النِّيلَ بِالشِّيَمِ","وَحَاكَ أَطْيَارَهُ بِالشَّدْوِ وَالنَّغَمِ",12,"م",1,1],["يَا شَاعِرَ الوَحْي وَنورَ التقَى","أَلاَ لِقَاءٌ قَبْلَ يَوْمِ الحِمَامْ",13,"م",1,0],["يَا شَقِيقَيْهِ إِنَّ بَيْتَ سُلَيْمَا","نَ بِأَنْ تَبْقَيَا مَتِينُ الدِّعَامِ",14,"م",1,0],["يَا شَمْسُ لَمْ يَكْملْ نَهارُكِ","كَيْف فَاجَأَكِ الزَّوَالْ",15,"ل",1,0],["يا شقة النفي من هوانِ","لَجَّجَ في أبحر الهوانِ",16,"ن",1,0],["يا شافع الرسل الكرام ومن به","يرجون في يوم الحساب قَبولا",17,"ل",2,0],["يا شهر أيار ما أن أنت أيار","وإنما أنت في وقتَيك عيّار",18,"ر",1,1],["يا شيخ روما ومَن لرايته","وتاجه ينتمي وينتسب",19,"ب",1,0],["يا شباب العراق هُبّوا إليه","وتوخَوْا بجمعه البركات",20,"ت",1,0],["يا شباب القوم لولاكم لما","ساغ لي العذب وما أن لذّ لي",21,"ي",1,0],["يا شباب القوم هُبّوا للبِراز","فبِكم يَبسم ثغر الوطن",21,"ن",1,0],["يا شَبَّ قَد ذَكَرَت قُرَيشٌ غَدرَكُم","بَينَ المُحَصَّبِ مِن مِنىً وَثَبيرِ",22,"ر",1,0],["يا شَبَّ إِنَّ الحُبارى لَن يُناظِرَها","مُستَلحِمٌ أَسفَعُ الخَدَّينِ مِبكارُ",23,"ر",1,0],["يا شَبَّ لَن يَستَطيعَ الحَربَ إِذ حَمِيَت","عَظمٌ خَريعٌ وَفيهِ المُخَّةُ الرارُ",23,"ر",1,0],["يا شَبَّ ما زالَ في قَيسٍ لِئانُفِكُم","رَغمٌ وَرَغمٌ وَأَوتارٌ وَأَوتارُ",23,"ر",1,0],["يا شَبَّ وَيحَكَ لا تَكفُر فَوارِسَنا","يَومَ اِبنُ كَبشَةَ عاتي المُلكِ جَبّارُ",23,"ر",1,0],["يا شبيهَ الغصون رفقاً بصبٍّ","نائحٍ في الهوى مع الورقاء",24,"ا",2,0],["يا شاكيَ الدهرِ يممهُ وقدْ غُفرتْ","من حوْلِ أبوابهِ للدَّهرِ زَلاَّت",25,"ت",1,0],["يا شمسَ فضلٍ واضحٍ لي حسَّدٌ","بولاية المُجدِي كانوا كالشُّمت",26,"ت",1,1],["يا شهدُ لا والله اق","نع أن أعاودَ قُبلَتك",27,"ك",1,1],["يا شاهر اللحظ حبي فيك مشهور","وكاسر الطَّرف قلبي منك مكسور",28,"ر",1,1],["يا شارعَ الأمر في جودٍ وعادله","فجودهُ حاضرٌ والعدلُ محظور",29,"ر",1,0],["يا شائدَ الحرمين بالهمم التي","ملأ الحديث بها لسان الذاكر",30,"ر",1,0],["يا شعرات المشيب أعدمني","هناءَ عيشي بياضك الراسي",31,"ي",1,0],["يا شيخ علم وشيخ علم","فمن عيانٍ ومن سماع",32,"ع",1,1],["يا شيخ أهل العلم والزهد في","سادات أهل الرفق والرفقهْ",33,"ه",1,1],["يا شائد البيت النظيم الذي","على التقى أسَّس بنيانه",34,"ن",2,0],["يا شَمسُ يا بَدرُ يا نَهارُ","أَنتَ لَنا جَنَّةٌ وَنارُ",35,"ر",1,1],["يا شاعراً يهجو نُسَيَّةَ خالدٍ","عنك الهجاءَ كفاك بالأسماءِ",36,"ا",2,0],["يا شاعرَ العَجَم الكرامِ كما","أنَّ ابنَ حُجْرٍ شاعرُ العربِ",37,"ب",1,0],["يا شبابي وأين مني شبابي","آذنتني حِبالُهُ بانقضابِ",38,"ب",1,1],["يا شبابي أبو الحسين زعيمٌ","ونداه بأن تُميد مُميدَكْ",39,"ك",1,0],["يا شمسَ زُهر الشموس يا قمر ال","أقمار حسناً يا زهرة الزُّهَرِ",40,"ر",1,0],["يا شيخ عَدِّ عن الجلوسْ","أوجعتَ ضرباً بالقُلوسْ",41,"س",1,1],["يا شُقَّة النفس لا إمرارَ ينفعُني","لديك ما عارضَ الإمرارَ تنقيضُ",42,"ض",1,0],["يا شريفاً لقرنه إشرافُ","وطريفاً له بناتٌ طرافُ",43,"ف",1,1],["يا شاعراً يرْعوي لدِمنته","هلّا جعلتَ الصديق من دِمَنك",44,"ك",1,0],["يا شبيه البدرِ في الحس","نِ وفي بُعد المنالِ",45,"ل",1,1],["يا شاعراً أمسَى يَحُوكُ مديحَهُ","في شَرِّ جيل شرِّ أهل زمانِ",46,"ن",1,1],["يا شقيقَ النَّدَى وتِرْبَ المعالِي","وسراجَ الهُدَى بكل مكان",47,"ن",1,0],["يا شامتاً أبدى الشماتة لا تَزلْ","تَصْلَى بمرمَضَة أشدَّ صُلِيِّ",48,"ل",2,0],["يا شاعِرَ اَلدَيرِ كَم هَلهَلتَ قافِيَةً","غَنّى الرُواةُ بِها وَاِختالَتِ الكُتُبُ",49,"ب",1,0],["يا شاعِراً حُلوَ المَوَدَّةِ","في الحُضور وَفي الغِيابِ",50,"ب",1,1],["يا شاعِرَ الحُسنِ هَذي رَوعَةُ العي