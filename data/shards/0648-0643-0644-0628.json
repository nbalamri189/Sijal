ttps://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101351","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130867","الطويل"],[4418,"","https://poetry.dctabudhabi.ae/diwan/poem/95772","المجتث"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121288","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72349","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116059","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139662",""],[4778,"مات الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=198135",""],[4578,"عينا بمنشور الهوى جيت والياً","https://www.poetsgate.com/ViewPoem.aspx?id=49614",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5064,"رقصة هدب على إيقاع رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=199160",""],[585,"عليك وإلا ما عقدت رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=161913",""],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[3591,"يا حافظ الشعر ويا شاعراً","https://www.poetsgate.com/ViewPoem.aspx?id=149433",""],[5216,"إهداء لأبي القاسم الشابي","https://www.poetsgate.com/ViewPoem.aspx?id=186824",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5237,"مرادي من المولى وغاية آمال","https://www.poetsgate.com/ViewPoem.aspx?id=113106",""],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[5471,"وكل بناء قد أقيم أساسه","https://www.poetsgate.com/ViewPoem.aspx?id=186822",""],[5493,"الآن قد خانني الإلهام.","https://www.poetsgate.com/ViewPoem.aspx?id=205969",""],[5616,"حصار","https://www.poetsgate.com/ViewPoem.aspx?id=203228",""],[5662,"لبيت تخفق الأرواح فيه","https://www.poetsgate.com/ViewPoem.aspx?id=195026",""],[5719,"وكل بني العاصي حمدت عطاءه","https://www.poetsgate.com/ViewPoem.aspx?id=186659",""],[5956,"نجم ليس يأتي لي بنور","https://www.poetsgate.com/ViewPoem.aspx?id=192989",""],[5997,"وصايا","https://www.poetsgate.com/ViewPoem.aspx?id=214221",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[463,"شواردُ حظًّ لا يقرُّ نفورها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60057&r=&rc=113",""],[6308,"وتسألُ الدار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87722&r=&rc=0",""]],"verses":[["وَكُلُّ باكٍ عَلى شَيءٍ يُفارِقُهُ","قَسراً فَيَقتَصُّ مِن ضِحكٍ وَمِن جَذَلِ",0,"ل",1,0],["وَكُلِّ بِجاوِيٍ يَجُرُّ زِمامَهُ","إِذا ما تَراخَت في أَزِمَّتِها النُجبُ",1,"ب",1,0],["وَكُلُّ بِدَايَةٍ فَإِلَى انْتِهَاءٍ","وَكُلُّ إِقَامَةٍ فَإِلَى ارْتِحَالِ",2,"ل",1,0],["وَكُلُّ بُكاءِ رَبعٍ أَو مَشيبٍ","نُبَكّيهِ فَهُنَّ بِهِ عُنينا",3,"ن",2,0],["وَكُلُّ بَني الوَليدِ أَسَرَّ حُزناً","وَكُلُّ القَومِ مُحتَسِبٌ صَبورُ",4,"ر",1,0],["وَكَلبٌ غَداةَ اِستَعصَموا بِحِبالِهِم","رَماهُم بِها شُعثاً شَوازِبَ ضُمَّرا",5,"ر",2,0],["وكلُّ باديةٍ في الحجب قلنَ لها","يا أختَ خير أخٍ يا بنتَ خير أب",6,"ب",1,0],["وكلبِ خصبٍ زهاه الحظ قلت له","لا تستوي والأسود السود غُضّافا",7,"ف",2,0],["وَكَلبٌ إِذا حالَت قُرى الشامِ دونَها","إِلى النيلِ هُرّاباً وَإِن أَجدَبَت مِصرُ",8,"ر",1,0],["وَكُلُّ بَيتٍ وَإِن طالَت إِقامَتُهُ","عَلى دَعائِمِهِ لابُدَّ مَهدومُ",9,"م",1,0],["وَكُلُّ بَعيدٍ مِنَ المَكرُماتِ","كَأَنَّكَ تَأخُذُهُ مِن كَثَب",10,"ب",1,0],["وَكُلُّ بُنيانِ قَومٍ لا يَقومُ عَلى","دَعائِمَ العَصرِ مِن رُكنَيهِ مُنصَدِعُ",11,"ع",1,0],["وَكُلُّ بِساطِ عَيشٍ سَوفَ يُطوى","وَإِن طالَ الزَمانُ بِهِ وَطابا",12,"ب",2,0],["وَكُلُّ بابٍ لِلنَدى مُغلَقٍ","فَإِنَّما مِفتاحُهُ الفَتحُ",13,"ح",1,0],["وَكُلٌّ بِهِ جاءَ نَصُّ الكِتابِ","وَأَوضَحَ فيهِ دَليلاً مُبينا",14,"ن",2,0],["وَكُلُّ بَني الدُنيا يُعَلِّلُ نَفسَهُ","بِمَرِّ شُهورٍ وَهيَ لِلعُمرِ آفاتُ",15,"ت",1,0],["وَكُلُّ بَني الدُنيا عَلى غَفَلاتِهِ","تُواجِهُهُ الأَقدارُ حَيثُ تَوَجَّها",16,"ه",2,0],["وَكُلُّ بَني الدُنيا وَلَو تاهَ تائِهٌ","قَدِ اعتَدَلوا في الضَعفِ وَالنَقصِ وَاستَوَوا",17,"و",2,0],["وَكَلبٌ لَها خَبتٌ فَرَملَةُ عالِجٍ","إِلى الحَرَّةِ الرَجلاءِ حَيثُ تُحارِبُ",18,"ب",1,0],["وكلُّ بيْتٍ حَكى بَيْتَ العَرُوضِ لهُ","بالبِيضِ والسُّمْرِ تَقْطِيعٌ وتَفْصِيلُ",19,"ل",1,0],["وكل بناء أسس البغي أسه","يتاح له من كفّ بانيه هادم",20,"م",1,0],["وَكَلباً وَلَخماً لَم نَزَل مُنذُ أَحمَضَت","يُحَمِضُنا أَهلُ الجَنابِ وَخيبَرا",21,"ر",2,0],["وكلّ بعيد حجّ للبيت أو هفا","إليه- وإن شطّ المزار  قريبي",22,"ب",2,0],["وكل بلاد يلفظ الضاد أهلها","بلادي وإن كانت بمثلي تظلع",23,"ع",1,0],["وكلُّ بحمدٍ اللهٍ جامعُ شملِهم","إمام البرايا سيدُ العرب والعجمِ",24,"م",1,0],["وكل بيت حجرٌ قد هوى","عليه من أحجار سجيلِ",25,"ل",1,0],["وَكُلُّ بِناءٍ بَنَتهُ المُلوكُ","حَديثٌ عَلا وَقَديمٌ دَثَر",26,"ر",1,0],["وَكُلُّ بِقاعِ الأَرضِ قَد جُعِلَت لَهُ","حَلالاً فَيُعطي مَن يَشاءُ وَيَحرِمُ",27,"م",1,0],["وَكُلَّ بَني عَمٍّ سِوانا وَضِيمَةً","يُعَدُّ لَدى النُسّابِ أَصلاً مُخَضرَما",28,"م",2,0],["وَكُلّ باكٍ هَشيم الوَجهِ بَعدَ فَتىً","بِالدُّودِ باتَ هَشيماً وَجهَهُ النَضِرُ",29,"ر",1,0],["وكلّ بحمد الله قد رام هدمَه","فأعياهمُ ما تَبْتَني وتَشِيد",30,"د",1,0],["وكلُّ بازٍ معه فتاه","حتى سَقَاها المُرَّ من جَناه",31,"ا",2,0],["وكل بمدحي فيه غيرك فاخر","واني بمدحي فيك استملك الفخرا",32,"ر",2,0],["وَكَلُبّي إِذ لَداعي الشَو","قِ ما زالَ يُلَبّي",33,"ب",2,0],["وكل بديع فيه لم ير مثله","من الطير والنينان والتمر والقمري",34,"ر",2,0],["وَكل بناء بِالقِياس لحسنه","شَمال وَهذا في القِياس يَمين",35,"ن",1,0],["وكُلُّ بخيلٍ حالفَ البُخْلُ كفَّه","ولم يَدْرِ أنّ المالَ يُخْلَفُ بالبَذْل",36,"ل",1,0],["وَكُلُّ بَحرٍ صادِرُ وُرّادُهُ","إِذا سَقى فَاصدُر عَزيزاً أَو رِدِ",37,"د",1,0],["وكلٌّ بأثواب الندامة مكتسٍ","على السعي إلّا التام في السر والجهر",38,"ر",1,0],["وكل بياض سودته محابر","بآرائها فهو الديار بلاقع",39,"ع",1,0],["وَكُلٌّ بِما قالَهُ آثِمٌ","سيقرا الَّذي قالَ في صُحفِهِ",40,"ف",2,0],["وكلٌّ بما أثنى أجادَ وأحسنا","فخرب من الدانين إذ ذاك أعلنا",41,"ن",2,0],["وكلٌ بين جانحتَيْهِ قلبٌ","له خفقَانُ أجنحةِ الحَمامِ",42,"م",1,0],["وكلٌّ بأثمارِ الحياةِ مُهَدَّلٌ","وبالعطفِ مَيَّاسٌ وبالعُرفِ مَيَّاحُ",43,"ح",1,0],["وكلٌّ بالنحول على ال","شكايةِ غيرُ مُتَّهمِ",44,"م",1,0],["وكلّ بياضٍ فضلةٌ لا يليقُها","إذا لم يكن إلا السواد يَضيرُها",45,"ر",3,0],["وكلُّ بلائي عند قلبي ولمْ أبُحْ","بشكوى الذي ألْقى ولا ظَهر السرُّ",46,"ر",1,0],["وكلُّ بيوت غيرهُ صادحٌ بها","بيوتٌ غرابُ البين فيهمَّ يشجج",47,"ج",1,0],["وكلٌ بات ذا وطنٍ وأهل","وليس به سوى فضلي غريبا",48,"ب",2,0],["وُكُلُّ بَعيدٍ قَرَّبَ الحَينَ نَحوُهُ","سَلاهِبُكَ الجُردُ الجِيادُ قَريبُ",49,"ب",1,0],["وَكَلبُكَ اِرأف بِالزائِرينَ","من الاِم بِاِبنَتِها الزائِرَه",50,"ر",2,0],["وكلٌّ بالدَّليلِ أتى لِتَقضي","وتَنظرَ قبلُ في حُجَجِ الخُصومِ",51,"م",1,0],["وكل باب إلى الل","ه غير ذاك فمسدود",52,"د",1,0],["وَكُلُّ بَني أُمِّ سَيُمسونَ لَيلَةٌ","وَلَم يَبقَ مِن أَعيانِهِم غَيرُ واحِدِ",53,"د",1,0],["وكلُّ بيتٍ خَرَاب بَعدَ جِدَّتِه","ومن وراء الشبابِ المَوتُ والكِبَرُ",54,"ر",1,0],["وكل بكلي في كثيري وواحدي","أهيم بوجدي في وجود تواجدي",55,"ي",1,0],["وكل بعيدٍ للحياة مقرب","إذا ما حدت فيه الليالي جمالها",56,"ل",3,0],["وَكُلٌّ بِإِخلاصٍ تَمنَّى بَقاءه","بِدَولته ما لاحَ بَدر تَمام",57,"م",1,0],["وكل بكل له عمل","من البدء حتى انتها الدهر داما",58,"م",2,0],["وكلٌّ به مِن حُبِّ صاحبهِ لظىً","وهل يُطفأ الجمر المُضرّمُ بالجمرِ",59,"ر",1,0],["وكلّ بَني الصوّافِ لا شكّ كامِل","وَأَحمَدُهم شَهمٌ أجلُّ وأمجدُ",60,"د",1,1],["وَكُلُّ باغ شَأنه التَعدّي","وَإِنَّهُ لَواقع مِن بَعدي",61,"ي",1,0],["وَكَلْبٍ إذَا مَا قَصَّ جُرَّةَ صْيدِهِ","وأدْركَه سَبْقًا وأوْهَلَه صرْعَا",62,"ع",2,1],["وَكلبهمُ لديهم وهو ملقٍ","ذِراعيه بناحية الوصيدِ",63,"د",1,0],["وكل بيتٍ بها تبدي عواجمه","تاريخ عهدٍ به جادت بلقياها",64,"ا",3,0],["وكلّ بظراء حمراء فرجها","كعرف ديك أفرق أشهب",65,"ب",1,1],["وكل بلاء غير عدلك نعمة","وإن سئمت منه نفوس البرية",66,"ه",1,0],["وكُلُّ بِلاَدِ اللَّهِ طُرّ بِفَارِسٍ","سَتَسْعَدُ يَوْماً مَثْلَ مَا سَعَدَتْ أَمْسَا",67,"س",2,0],["وكلُّ بعيدِ الدَّارِ تُنسَى عُهودُهُ","وليس على طُول البعادِ عهودُ",68,"د",1,0],["وَكُلُّ بَذلٍ زَكَت مَناسِبُهُ","فَهوَ إِلى البَرمَكِيِّ مَنسوبُ",69,"ب",1,0],["وكلٌّ بروضِ المنى سارحٌ","كثيرُ الخَيالِ قليلُ العَمَل",70,"ل",1,0],["وكُلُّ بَيتٍ منُ أمِّ المؤمنينَ خَلا","أمسى خلاءَ وأمسى أهلُهُ احتمَلا",71,"ل",2,0],["وَكُلُ بِلاَدِ اللهِ مُلْكِي حَقِيقَةً","وَأَقْطَابُهَا مِنْ تَحْتِ حُكْمِي وَطَاعَتِي",72,"ي",1,0],["وكلبهم لمصر أخٌ نصوح","لها ثقةٌ به ولها انتصاح",73,"ح",1,0],["وكُلّ بعيدِ المُستَغَاثِ مُدَفَّعِ","من اللَهِ في تلكَ المَواطن يَقرُبُ",74,"ب",1,0],["وكل بكأس الوصل منا قد ارتوى","ولما اجتمعنا والقلوب من النوى",75,"ن",3,0],["وكلُّ باشا وإن جلّت مكانتُه","فليس غير فتىً في الرقّ مصفود",76,"د",1,0],["وَكُلُّ بِناءٍ في يَدِ اللَهِ رُكنُهُ","فَلَيسَ لَهُ في العالَمينَ مُخَرِّبُ",77,"ب",1,0],["وكل بثلاث من أصابع جالسا","ومع قائم فاكرهما وممدد",78,"د",1,0],["وكل بكاء ليس معه نياحة","ولا ندب الآتي به غير معتد",79,"د",1,0],["وكل بحسب منه يسعى لشابه","ويعرف في عقبى الأمور ذوي القدر",80,"ر",1,1],["وَكل بُؤسي وَنعمي","سَيَفنَيانِ سَريعا",81,"ع",2,0],["وَكُل بَليغ لَيسَ يَذكر بَعده","وَأَيامه بِالفَضل لا شَك تَشهد",82,"د",1,0],["وكل بات في نكد","وأصبح جائش الجاش",83,"ش",1,0],["وَكُلّ بناءٍ لَقَد أَحضَرَه","بَل هُوَ أَيضاً فَوقَ بُرج مَعه",84,"ه",1,0],["وَكُلُّ بَغّاء به أبنةٌ","مُبادِلٌ أبغى من الابره",85,"ر",2,0],["وكل بازٍ يمسهُ هرمٌ","تخرى على رأسه العصافير",86,"ر",1,0],["وكل بضرس وطا الأنام بظلف","تأت حزماً وتحكم العملا",87,"ل",2,0],["وَكُلُّ بَعْضِكَ خَيْلُ اللهِ تَحْرِسُهُ","فَكَيْفَ جُرْجِرْتَ بِالأَثْقَالِ فِي سَقَرِ!",88,"ر",1,0],["وكل به من شدة الخوف سكرة","ومن هول ما قاسى وليس بذي سكر",89,"ر",1,0],["وكلّ بنيك مصريٌّ صميم","فلا وسط ولا متطرفونا",90,"ن",2,0],["وكل باب اعظم في البلده","موكل بهم اهالي النوبه",91,"ه",1,0],["وكل بفضل له لم يزل","على نفسه قد أقرَّ وأشهد",92,"د",1,0],["وكلٌّ بطاعَتِهِ مُذْعِنٌ","وكلٌّ على طَبْعِهِ قد غَلَبْ",93,"ب",1,0],["وكلبٌ ببيداءِ السَّماوةِ فَارِكٌ","لعورتها صُمُّ الرِّماحِ سُتُورُ",94,"ر",1,0],["وَكل بِاصوات المَسَرة هاتِف","اِلى اللَهِ يَدعو اِن يُطيل لَكَ العُمرا",95,"ر",2,0],["وَكُل بَدءٍ لَهُ لا شَكَّ آخِرَة","وَكُل امر لَهُ حد وَميزانُ",96,"ن",1,0],["وَكُلٌّ بَتَرديد المَدائح صادح","يَرجَع في تَمجيد