{"poems":[[53,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[53,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[63,"أروم العلا والدهر يزجي خطوبه","https://www.aldiwan.net/poem45918.html","الطويل"],[73,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[93,"يا بالغ الستين من عمره","https://www.aldiwan.net/poem11163.html","السريع"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[91,"روض إذا زرته كئيبا","https://www.aldiwan.net/poem8761.html","عموديه"],[78,"يا غرة تسخر بالبدر","https://www.aldiwan.net/poem14249.html","السريع"],[85,"صفعنا روحه بيد المعاني","https://www.aldiwan.net/poem7535.html","الوافر"],[85,"الله في الخلق من صب ومن عانى","https://www.aldiwan.net/poem7881.html","البسيط"],[85,"عفيف الجهر والهمس","https://www.aldiwan.net/poem8074.html","الهزج"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[58,"ألا قد أرى والله أن لست منكم","https://www.aldiwan.net/poem30890.html","الطويل"],[49,"لشتان ما بين المخافة والأمن","https://www.aldiwan.net/poem63156.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"أعيدوا الحق واتخذوه عهدا","https://www.aldiwan.net/poem42104.html","الوافر"],[52,"أغار عليك من قلبي إذا ما","https://www.aldiwan.net/poem26774.html","الوافر"],[52,"ومنطقة شدت بخصر معذبي","https://www.aldiwan.net/poem26965.html","الطويل"],[48,"نك ابن العم ذا القربى","https://www.aldiwan.net/poem66212.html","الهزج"],[48,"لأشهى من ركوب الخيل عندي","https://www.aldiwan.net/poem66582.html","الوافر"],[48,"أحسن مما تضمن العطن","https://www.aldiwan.net/poem66595.html","المنسرح"],[50,"أعاذل قد نهيت فما انتهيت","https://www.aldiwan.net/poem64749.html","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[109,"ومن طينة كل الجسوم تكونت","https://www.aldiwan.net/poem16545.html","الطويل"],[115,"كنز المقل سلاح الخائف الوجل","https://www.aldiwan.net/poem40858.html","عموديه"],[128,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[154,"قيود الأحرار","https://www.aldiwan.net/poem932.html",""],[160,"قناة العز في تلك الرماح","https://www.aldiwan.net/poem58967.html","الوافر"],[160,"تدارك من زمانك ما افدتا","https://www.aldiwan.net/poem59135.html","الوافر"],[169,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[186,"بلوت المسلمين بكل أرض","https://www.aldiwan.net/poem43946.html","الوافر"],[186,"إذا شئت أن تلقى من الناس صادقا","https://www.aldiwan.net/poem43958.html","الطويل"],[199,"ألا لا تلمه اليوم أن يتألما","https://www.aldiwan.net/poem45633.html","الطويل"],[204,"ومن طاعتي إياه أمطر ناظري","https://www.aldiwan.net/poem53026.html","الطويل"],[210,"هناء به شمل المعاني تنظما","https://www.aldiwan.net/poem13324.html","الطويل"],[212,"أبا سيدي ما زلت بالدهر باقيا","https://www.aldiwan.net/poem37907.html","الطويل"],[229,"جزالة شعرك في لفظه","https://www.aldiwan.net/poem50911.html","المتقارب"],[229,"حشوا بفراقهم نارا حشاه","https://www.aldiwan.net/poem51261.html","الوافر"],[235,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[237,"سهام الردى تخطي الذي قصد الهبطي","https://www.aldiwan.net/poem18843.html","الطويل"],[271,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[271,"دمى طلل بين الطلول بحا جر","https://www.aldiwan.net/poem52110.html","الطويل"],[271,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[303,"ومنطقي يشتكي علة","https://www.aldiwan.net/poem57631.html","السريع"],[322,"ما الناس إلا في رماق وصالح","https://www.aldiwan.net/poem56355.html","الطويل"],[348,"ترهبت لما أن غدا اللحم غاليا","https://www.aldiwan.net/poem20380.html","الطويل"],[349,"رشا عجبي منه وقد راح قاضيا","https://www.aldiwan.net/poem15742.html","الطويل"],[353,"تنزه عن بني الدنيا وعاد","https://www.aldiwan.net/poem40384.html","الوافر"],[361,"محبك يا شقيق الروح يرجو","https://www.aldiwan.net/poem68102.html","الوافر"],[364,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[364,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[371,"أبى الدمع إلا أن يسح ويسجما","https://www.aldiwan.net/poem57121.html","الكامل"],[377,"حواسك يا بتولة مرتضيه","https://www.aldiwan.net/poem59163.html","الوافر"],[380,"أمن بعد ما بان الفريق وأدلجا","https://www.aldiwan.net/poem48769.html","الطويل"],[432,"تغير عن مودته وحالا","https://www.aldiwan.net/poem12316.html","الوافر"],[439,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[439,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[441,"أيا ليلى ويا ليت التلاقي","https://www.aldiwan.net/poem14315.html","الوافر"],[458,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[458,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[461,"تبرع نصر بالزيارة والندى","https://www.aldiwan.net/poem16048.html","الطويل"],[461,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[477,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[479,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[482,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[493,"ومن طلب الأعداء بالمال والظبى","https://www.aldiwan.net/poem67322.html","الطويل"],[493,"نداك إذا ضن الغمام غمام","https://www.aldiwan.net/poem67326.html","الطويل"],[495,"أإن كنت ذا عاهة ساقطا","https://www.aldiwan.net/poem10275.html","المتقارب"],[506,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[515,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[551,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[551,"ألا إن قلبي من بعدكم","https://www.aldiwan.net/poem47260.html","المتقارب"],[567,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[575,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[587,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["وَمَن طُعمُهُ مِن سَيفِهِ كَيفَ يَتَّقي","وَمَن يَطلُبُ العَلياءَ كَيفَ يَقيلُ",0,"ل",1,0],["وَمَن طَوَّحَكَ اليَومَ","بِدارِ الأُسُدِ الغُلبِ",1,"ب",1,0],["وَمَنْ طَلَبَ العَلْياءَ لَمْ يَخَفِ الرَّدى","فَمِنْ دونِ ما يَبْغِيهِ حَزُّ الغَلاصِمِ",2,"م",1,0],["وَمِن طَرَبٍ عادَ نَحوَ البُرو","قِ أَجهَشتُ لِلبَرقِ حينَ اِبتَسَم",3,"م",1,0],["وَمِنْ طَوَايَا النَّاسِ تُبْدِي بِمَا","خَبْرْتَ مِنْهُمْ كُلَّ كَنْزٍ دَفِينْ",4,"ن",1,0],["ومنطق لو أراد الفخر غايته","لبات بالريِّ يشكو بارح الغلل",5,"ل",1,0],["وَمِن طُيورٍ إِذا تَغَنَّت","عادَ المُعَنّى بِها طَروبا",6,"ب",2,0],["وَمَنطَقا أَثبَتَ مِن سِحرِهِ","أَحَرَّ في قَلبي مِنَ الجَمرِ",7,"ر",1,0],["ومن طل الإقالة من شجاع","وأشفق من مضاربه أقيلا",8,"ل",2,0],["ومنطق يرث التاريخ جوهره","عن الزمان وعن عباسه الثاني",9,"ي",1,0],["وَمَن طَهَّرَهُ اللَهُ","مِنَ الريبَةِ وَالرِجسِ",10,"س",1,0],["وَمَن طَلَبَ الخُلقَ مِن كَنزِهِ","فَإِنَّ العَقيدَةَ كَنزٌ عَتيد",11,"د",1,0],["وَمَن طَلَبَ الفَتحَ الجَليلَ فَإِنَّما","مَفاتيحُهُ البيضُ الخِفافُ الصَوارِمُ",12,"م",1,0],["ومن طولِ إِلْفِي في الهَوى ورياضتي","لنفسي على قُربِ الأحِبَّةِ والبُعْدِ",13,"د",1,0],["وَمُنطَلِقٌ مِنكُم بِغَيرِ صِحابَةٍ","وَتابِعُ إِخواني الَّذينَ مَضوا قَبلي",14,"ي",1,0],["وَمَن طابَ لي نَفساً بِقُربٍ قَبِلتُهُ","وَمَن ضاقَ عَن قُربي فَفي أَوسَعِ الإِذنِ",15,"ن",1,0],["ومنطقٌ ليس بالفصحى فتفهمُه","يوماً وما هو من حسٍ بملحون",16,"ن",1,0],["وَمن طلبَ الحياةَ طِلابَ حُرٍّ","فليس يَرى من الإقدامِ بُدّا",17,"د",2,0],["وَمِن طَرَفِ القَضيبِ مِنَ الإِراكِ","إِذا أَعطَيتِهِ يا شُرَّ فاكِ",18,"ك",1,0],["وَمَنطِقَةٍ شُدَّت بِخَصرِ مُعَذِّبي","وَقالَت لِهَذا الشُدِّ لَستُ أَحورُ",19,"ر",1,1],["ومَن طأطأ فاركبهُ","ولو في ليلةِ الجُمُعَه",20,"ع",2,0],["ومن طعنِ الرماحِ ونعتِ حربٍ","وصبر عند تجريد الحسامِ",21,"م",1,0],["ومن طلولٍ طالَ الزمانُ بها","يطول فيها البكاءُ والحزنُ",22,"ن",1,0],["وَمِن طَرَبي إِلَيكِ خَشَعتُ فيهِم","كَما يَتَخَشَّعُ الفَرَسُ السُكَيتُ",23,"ت",1,0],["ومَنْ طَلَب المَجْدَ المَنِيعَ فَما له","سِوَى سِيرَةِ الأَبْطَالِ في النَّاس مَهْيَعُ",24,"ع",1,0],["وَمِن طينةٍ كُل الجُسوم تَكوَّنَت","فَيَعلَم هَذا حاذق وَخَبيرُ",25,"ر",1,1],["ومنطق فيه طور المصطفى انتسقت","آياته وله خرس اولن الجدل",26,"ل",1,0],["وَمَنْ طَغى وعَصى الرحمنَ خالقَه","فليس تنفعهُ الآياتُ والنذُرُ",27,"ر",1,0],["ومن طبع الحرائر أن تراه","تحيل النقع لحنا سامريا",28,"ي",2,0],["ومن طلب المعالي بالعوالي","إقامته على درك النجاح",29,"ح",1,0],["ومن طلب العلى سهر الليالي","وطلق لذة الراحات بتا",30,"ت",2,0],["وَمَن طَلَبَ العَلياءَ جَرَّدَ سَيفَهُ","وَخاضَ بِهِ بَحرَ الرَدى غَيرَ وَاجِمِ",31,"م",1,0],["ومن طل بالتحفّظ من صديق","لقى في عيشه جهدا جهيدا",32,"د",2,0],["ومن طالب منّي شهودا على الذي","ذكرت لأكفى الجحد من كل جاحد",33,"د",1,0],["ومن طامحٍ للأفقِ حتى كأنهُ","على العدمِ يستجدي من الأفقِ أنجما",34,"م",2,0],["ومن طاعتي إياه أمطر ناظري","له حين يُبدي من ثناياه لي برقا",35,"ق",2,1],["ومنطقه من نحوه الدر يجتلي","ومنه المعاني عقدها قد تنظما",36,"م",2,0],["ومن طبعه المعروفُ والبِشرُ والسَخا","وها هو للتقوى وللأجرِ شابث",37,"ث",1,0],["ومُنطاعُه لك يحكي لنا","بأن هواك هوىً صادقُ",38,"ق",1,0],["ومن طول المَواعد ليس سُؤْلي","وحظّي منه إلاّ أن أراه",39,"ا",2,0],["وَمَنطِقٌ إِفحاشُهُ","تَخبُثُ مِنهُ الأَندِيَه",40,"ي",2,0],["وَمَنْ طَرَّزَتْ أَنْوَارُهُ حُلَّةَ الْهُدَى","كَمَا طَرَّزَ الْقِرْطَاسَ مُسْتَبْدَعُ الْخَطِّ",41,"ط",1,0],["ومن طافَ بالبَيت المعظم ناسِكا","وَشاهد من أَنوار تلك المشاهد",42,"د",1,0],["وَمن طاف تعظيما وهرول ساعيا","وَكرر أَذكار الصفا وَالمَشاعِر",43,"ر",1,0],["وَمنطق ظبية وَخطاب ضب","وَفي الرمضاء ظللت الغيوم",44,"م",1,0],["ومنطقي يشتكي علةً","وهو على طول المدى يولجُ",45,"ج",1,1],["وَمِن طالِبٍ حَقّاً بِفَحشٍ يَفوتُهُ","وَمُدرِكِهِ بِالحَقِّ وَهوَ سَتيرُ",46,"ر",1,0],["وَمِن طَرَفَيْها تَشتْهِي اللَّحْمَ شَهْوَةً","وَلِلنِيِّ والمَطْبوخِ مِنّي تَعَذُّرُ",47,"ر",1,0],["وَمَن طَرَفَهُ أَنّي بِبيضِ سَوادِهِ","يَقُدُّ وَلَم يُخدَشُ بِهِ الجِسمُ في الحَشا",48,"ش",2,0],["وَمَن طَلَب المَفاخر وَالمَعالي","يَهيم بِحُبِّها في كُلّ وادي",49,"ي",1,0],["وَمنطقة البَديع وَما اِبن هاني","لَدَيهِ وَما مَقامات الحَريري",50,"ر",2,0],["ومنطقُ خالدٍ ودهاءُ عَمْروٍ","ونجدةُ عامرٍ وسَخاءُ حاتِم",51,"م",1,0],["ومَنْطِقٌ حُسْنُه","يَزيدُ بالانتِقاد",52,"د",1,0],["ومَن طاوَلَ العَلياءَ بالشِّعرِ إنَّما","يَرومُ بِما يَأتي مُطاولَةَ السَّما",53,"م",2,0],["ومنطقك المرتِّل في الليالي","تسابيحُ الملائكة العليه",54,"ي",2,0],["وَمِن طول أَلف الجفن لِلسُهد لَو رَأى","حُروف الكَرى مَرقومة لِتحرجا",55,"ج",2,0],["ومن طَلَبَ الوفاءَ مِنَ الليالي","على عِلاَّتِها طَلَبَ المُحَالا",56,"ل",2,0],["ومن طَرَقَتْ خَيْلُ الخطوبِ حَرِيمَهُ","فأوَّلُ دعواهُ إليهِ انْتِصارُهُ",57,"ر",2,0],["ومن طيب نفحٍ بنَوْر الرِّياضِ","تَلظِّيَ لفحٍ بنار المَقيلِ",58,"ل",1,0],["ومن طلب الحبيب فلا يبالي","بإقحام الخطير ولا اغتراق",59,"ق",1,0],["ومنطقٌ يُفصِح ما","شاء ولا يُحسِن لا",60,"ل",2,0],["ومن طامعٍ في الموَلَّى عليه","ولو سيس بالعدل لم يطمَعِ",61,"ع",1,0],["ومُنطَّقٍ ظنَّ البلاغةَ آيةً","نُصِبتْ له علَماً وشخصً صُوِّرتْ",62,"ت",1,0],["ومن طال عن خُبرِ الأخلاَّء بحثُهُ","ليبلُوَهم لم يخلُ مما يريبُهُ",63,"ب",2,0],["ومن طلب الإحسان من غير كُلفةٍ","ولا طلبٍ فالصَّمتُ عن مدحه كفر",64,"ر",1,0],["ومَنْ طابَتْ مَاسعِيهِ","كما طابَتْ أوائلُهُ",65,"ل",2,0],["ومُنطمِسٍ للعيسٍ والركبِ عندَه","حنينٌ على بالي الرسومِ واِعوالُ",66,"ل",1,0],["ومن طلب الإصلاح لم يأت منكرا","ومن طلب الإنصاف لم يخش مزلقا",67,"ق",2,0],["ومن طاب عيش الفرع إلا بأصله","وكيف وأنتم من عصارة عدناني",68,"ن",2,0],["وَمَن طَلَبَ الأَعداءَ بِالمالِ وَالظُبى","وَبِالسَعدِ لَم يَبعُد عَلَيهِ مُرامُ",69,"م",1,1],["وَمن طَلَب الأَعداء بِالمالِ وَالظُبا","وَبِالسَعدِ لَم يَبعُد عَلَيهِ مُرامُ",70,"م",1,0],["ومن طافت النار في زرعه","تمنى احتراق زروع الأنامْ",71,"م",1,0],["ومن طرب الركب حثَّ الخطى","اليها ونادى البِدار البِدارا",72,"ر",2,0],["ومن طال شرح المادحين لفضله","فما ضره أن مات مختصر العمر",73,"ر",1,0],["ومن طَمَعٍ أُخادع مِنْ يقينِي","على عَمْدٍ وأُكذِبُ من عِياني",74,"ي",1,0],["ومن طمعٍ للفتى خائبٍ","ومن أَمَلٍ في الغنى حائلِ",75,"ل",1,0],["وَمَنْطِقٌ فَاتِنٌ لِمْ يَلْقَ جِيْشَ نُهًى","إِلاَّ سَبَاهُ بِسٍحْرِ اللَّفْظِ أَوْ خَلَّهْ",76,"ل",2,0],["ومِنْ طبعِها ذاك العفافُ وكسْبُها","وما أَحسَن الطبعَ الذِي زِيدَ بالكسْبِ",77,"ب",1,0],["ومنطقها يسبي الحليم بنغمة","تزيد على الأوتار للمتطرب",78,"ب",1,0]]}