{"poems":[[53,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[53,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[63,"أروم العلا والدهر يزجي خطوبه","https://www.aldiwan.net/poem45918.html","الطويل"],[73,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[93,"يا بالغ الستين من عمره","https://www.aldiwan.net/poem11163.html","السريع"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[91,"روض إذا زرته كئيبا","https://www.aldiwan.net/poem8761.html","عموديه"],[78,"يا غرة تسخر بالبدر","https://www.aldiwan.net/poem14249.html","السريع"],[85,"صفعنا روحه بيد المعاني","https://www.aldiwan.net/poem7535.html","الوافر"],[85,"الله في الخلق من صب ومن عانى","https://www.aldiwan.net/poem7881.html","البسيط"],[85,"عفيف الجهر والهمس","https://www.aldiwan.net/poem8074.html","الهزج"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[58,"ألا قد أرى والله أن لست منكم","https://www.aldiwan.net/poem30890.html","الطويل"],[49,"لشتان ما بين المخافة والأمن","https://www.aldiwan.net/poem63156.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"أعيدوا الحق واتخذوه عهدا","https://www.aldiwan.net/poem42104.html","الوافر"],[52,"أغار عليك من قلبي إذا ما","https://www.aldiwan.net/poem26774.html","الوافر"],[52,"ومنطقة شدت بخصر معذبي","https://www.aldiwan.net/poem26965.html","الطويل"],[48,"نك ابن العم ذا القربى","https://www.aldiwan.net/poem66212.html","الهزج"],[48,"لأشهى من ركوب الخيل عندي","https://www.aldiwan.net/poem66582.html","الوافر"],[48,"أحسن مما تضمن العطن","https://www.aldiwan.net/poem66595.html","المنسرح"],[50,"أعاذل قد نهيت فما انتهيت","https://www.aldiwan.net/poem64749.html","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"]],"verses":[["وَمَن طُعمُهُ مِن سَيفِهِ كَيفَ يَتَّقي","وَمَن يَطلُبُ العَلياءَ كَيفَ يَقيلُ",0,"ل",1,0],["وَمَن طَوَّحَكَ اليَومَ","بِدارِ الأُسُدِ الغُلبِ",1,"ب",1,0],["وَمَنْ طَلَبَ العَلْياءَ لَمْ يَخَفِ الرَّدى","فَمِنْ دونِ ما يَبْغِيهِ حَزُّ الغَلاصِمِ",2,"م",1,0],["وَمِن طَرَبٍ عادَ نَحوَ البُرو","قِ أَجهَشتُ لِلبَرقِ حينَ اِبتَسَم",3,"م",1,0],["وَمِنْ طَوَايَا النَّاسِ تُبْدِي بِمَا","خَبْرْتَ مِنْهُمْ كُلَّ كَنْزٍ دَفِينْ",4,"ن",1,0],["ومنطق لو أراد الفخر غايته","لبات بالريِّ يشكو بارح الغلل",5,"ل",1,0],["وَمِن طُيورٍ إِذا تَغَنَّت","عادَ المُعَنّى بِها طَروبا",6,"ب",2,0],["وَمَنطَقا أَثبَتَ مِن سِحرِهِ","أَحَرَّ في قَلبي مِنَ الجَمرِ",7,"ر",1,0],["ومن طل الإقالة من شجاع","وأشفق من مضاربه أقيلا",8,"ل",2,0],["ومنطق يرث التاريخ جوهره","عن الزمان وعن عباسه الثاني",9,"ي",1,0],["وَمَن طَهَّرَهُ اللَهُ","مِنَ الريبَةِ وَالرِجسِ",10,"س",1,0],["وَمَن طَلَبَ الخُلقَ مِن كَنزِهِ","فَإِنَّ العَقيدَةَ كَنزٌ عَتيد",11,"د",1,0],["وَمَن طَلَبَ الفَتحَ الجَليلَ فَإِنَّما","مَفاتيحُهُ البيضُ الخِفافُ الصَوارِمُ",12,"م",1,0],["ومن طولِ إِلْفِي في الهَوى ورياضتي","لنفسي على قُربِ الأحِبَّةِ والبُعْدِ",13,"د",1,0],["وَمُنطَلِقٌ مِنكُم بِغَيرِ صِحابَةٍ","وَتابِعُ إِخواني الَّذينَ مَضوا قَبلي",14,"ي",1,0],["وَمَن طابَ لي نَفساً بِقُربٍ قَبِلتُهُ","وَمَن ضاقَ عَن قُربي فَفي أَوسَعِ الإِذنِ",15,"ن",1,0],["ومنطقٌ ليس بالفصحى فتفهمُه","يوماً وما هو من حسٍ بملحون",16,"ن",1,0],["وَمن طلبَ الحياةَ طِلابَ حُرٍّ","فليس يَرى من الإقدامِ بُدّا",17,"د",2,0],["وَمِن طَرَفِ القَضيبِ مِنَ الإِراكِ","إِذا أَعطَيتِهِ يا شُرَّ فاكِ",18,"ك",1,0],["وَمَنطِقَةٍ شُدَّت بِخَصرِ مُعَذِّبي","وَقالَت لِهَذا الشُدِّ لَستُ أَحورُ",19,"ر",1,1],["ومَن طأطأ فاركبهُ","ولو في ليلةِ الجُمُعَه",20,"ع",2,0],["ومن طعنِ الرماحِ ونعتِ حربٍ","وصبر عند تجريد الحسامِ",21,"م",1,0],["ومن طلولٍ طالَ الزمانُ بها","يطول فيها البكاءُ والحزنُ",22,"ن",1,0],["وَمِن طَرَبي إِلَيكِ خَشَعتُ فيهِم","كَما يَتَخَشَّعُ الفَرَسُ السُكَيتُ",23,"ت",1,0],["ومَنْ طَلَب المَجْدَ المَنِيعَ فَما له","سِوَى سِيرَةِ الأَبْطَالِ في النَّاس مَهْيَعُ",24,"ع",1,0]]}