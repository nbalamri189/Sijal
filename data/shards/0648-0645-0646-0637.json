,[5956,"لبتر أسباب الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=194895",""],[6093,"سَمِعْتُ بِكِمْ وَ صَوَّرَكُمْ خَيَالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190722",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[563,"جميع الكون في عيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56278&r=&rc=8",""],[158,"قيود الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84689&r=&rc=13",""],[463,"أهفو لعلويَّ الرياح إذا جرتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59997&r=&rc=53",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["وَمَن طُعمُهُ مِن سَيفِهِ كَيفَ يَتَّقي","وَمَن يَطلُبُ العَلياءَ كَيفَ يَقيلُ",0,"ل",1,0],["وَمَن طَوَّحَكَ اليَومَ","بِدارِ الأُسُدِ الغُلبِ",1,"ب",1,0],["وَمَنْ طَلَبَ العَلْياءَ لَمْ يَخَفِ الرَّدى","فَمِنْ دونِ ما يَبْغِيهِ حَزُّ الغَلاصِمِ",2,"م",1,0],["وَمِن طَرَبٍ عادَ نَحوَ البُرو","قِ أَجهَشتُ لِلبَرقِ حينَ اِبتَسَم",3,"م",1,0],["وَمِنْ طَوَايَا النَّاسِ تُبْدِي بِمَا","خَبْرْتَ مِنْهُمْ كُلَّ كَنْزٍ دَفِينْ",4,"ن",1,0],["ومنطق لو أراد الفخر غايته","لبات بالريِّ يشكو بارح الغلل",5,"ل",1,0],["وَمِن طُيورٍ إِذا تَغَنَّت","عادَ المُعَنّى بِها طَروبا",6,"ب",2,0],["وَمَنطَقا أَثبَتَ مِن سِحرِهِ","أَحَرَّ في قَلبي مِنَ الجَمرِ",7,"ر",1,0],["ومن طل الإقالة من شجاع","وأشفق من مضاربه أقيلا",8,"ل",2,0],["ومنطق يرث التاريخ جوهره","عن الزمان وعن عباسه الثاني",9,"ن",2,0],["وَمَن طَهَّرَهُ اللَهُ","مِنَ الريبَةِ وَالرِجسِ",10,"س",1,0],["وَمَن طَلَبَ الخُلقَ مِن كَنزِهِ","فَإِنَّ العَقيدَةَ كَنزٌ عَتيد",11,"د",1,0],["وَمَن طَلَبَ الفَتحَ الجَليلَ فَإِنَّما","مَفاتيحُهُ البيضُ الخِفافُ الصَوارِمُ",12,"م",1,0],["ومن طولِ إِلْفِي في الهَوى ورياضتي","لنفسي على قُربِ الأحِبَّةِ والبُعْدِ",13,"د",1,0],["وَمُنطَلِقٌ مِنكُم بِغَيرِ صِحابَةٍ","وَتابِعُ إِخواني الَّذينَ مَضوا قَبلي",14,"ل",2,0],["وَمَن طابَ لي نَفساً بِقُربٍ قَبِلتُهُ","وَمَن ضاقَ عَن قُربي فَفي أَوسَعِ الإِذنِ",15,"ن",1,0],["ومنطقٌ ليس بالفصحى فتفهمُه","يوماً وما هو من حسٍ بملحون",16,"ن",1,0],["وَمن طلبَ الحياةَ طِلابَ حُرٍّ","فليس يَرى من الإقدامِ بُدّا",17,"د",2,0],["وَمِن طَرَفِ القَضيبِ مِنَ الإِراكِ","إِذا أَعطَيتِهِ يا شُرَّ فاكِ",18,"ك",1,0],["وَمَنطِقَةٍ شُدَّت بِخَصرِ مُعَذِّبي","وَقالَت لِهَذا الشُدِّ لَستُ أَحورُ",19,"ر",1,1],["ومَن طأطأ فاركبهُ","ولو في ليلةِ الجُمُعَه",20,"ع",2,0],["ومن طعنِ الرماحِ ونعتِ حربٍ","وصبر عند تجريد الحسامِ",21,"م",1,0],["ومن طلولٍ طالَ الزمانُ بها","يطول فيها البكاءُ والحزنُ",22,"ن",1,0],["وَمِن طَرَبي إِلَيكِ خَشَعتُ فيهِم","كَما يَتَخَشَّعُ الفَرَسُ السُكَيتُ",23,"ت",1,0],["ومَنْ طَلَب المَجْدَ المَنِيعَ فَما له","سِوَى سِيرَةِ الأَبْطَالِ في النَّاس مَهْيَعُ",24,"ع",1,0],["وَمِن طينةٍ كُل الجُسوم تَكوَّنَت","فَيَعلَم هَذا حاذق وَخَبيرُ",25,"ر",1,1],["ومنطق فيه طور المصطفى انتسقت","آياته وله خرس اولن الجدل",26,"ل",1,0],["وَمَنْ طَغى وعَصى الرحمنَ خالقَه","فليس تنفعهُ الآياتُ والنذُرُ",27,"ر",1,0],["ومن طبع الحرائر أن تراه","تحيل النقع لحنا سامريا",28,"ي",2,0],["ومن طلب المعالي بالعوالي","إقامته على درك النجاح",29,"ح",1,0],["ومن طلب العلى سهر الليالي","وطلق لذة الراحات بتا",30,"ت",2,0],["وَمَن طَلَبَ العَلياءَ جَرَّدَ سَيفَهُ","وَخاضَ بِهِ بَحرَ الرَدى غَيرَ وَاجِمِ",31,"م",1,0],["ومن طل بالتحفّظ من صديق","لقى في عيشه جهدا جهيدا",32,"د",2,0],["ومن طالب منّي شهودا على الذي","ذكرت لأكفى الجحد من كل جاحد",33,"د",1,0],["ومن طامحٍ للأفقِ حتى كأنهُ","على العدمِ يستجدي من الأفقِ أنجما",34,"م",2,0],["ومن طاعتي إياه أمطر ناظري","له حين يُبدي من ثناياه لي برقا",35,"ق",2,1],["ومنطقه من نحوه الدر يجتلي","ومنه المعاني عقدها قد تنظما",36,"م",2,0],["ومن طبعه المعروفُ والبِشرُ والسَخا","وها هو للتقوى وللأجرِ شابث",37,"ث",1,0],["ومُنطاعُه لك يحكي لنا","بأن هواك هوىً صادقُ",38,"ق",1,0],["ومن طول المَواعد ليس سُؤْلي","وحظّي منه إلاّ أن أراه",39,"ا",2,0],["وَمَنطِقٌ إِفحاشُهُ","تَخبُثُ مِنهُ الأَندِيَه",40,"ي",2,0],["وَمَنْ طَرَّزَتْ أَنْوَارُهُ حُلَّةَ الْهُدَى","كَمَا طَرَّزَ الْقِرْطَاسَ مُسْتَبْدَعُ الْخَطِّ",41,"ط",1,0],["ومن طافَ بالبَيت المعظم ناسِكا","وَشاهد من أَنوار تلك المشاهد",42,"د",1,0],["وَمن طاف تعظيما وهرول ساعيا","وَكرر أَذكار الصفا وَالمَشاعِر",43,"ر",1,0],["وَمنطق ظبية وَخطاب ضب","وَفي الرمضاء ظللت الغيوم",44,"م",1,0],["ومنطقي يشتكي علةً","وهو على طول المدى يولجُ",45,"ج",1,1],["وَمِن طالِبٍ حَقّاً بِفَحشٍ يَفوتُهُ","وَمُدرِكِهِ بِالحَقِّ وَهوَ سَتيرُ",46,"ر",1,0],["وَمِن طَرَفَيْها تَشتْهِي اللَّحْمَ شَهْوَةً","وَلِلنِيِّ والمَطْبوخِ مِنّي تَعَذُّرُ",47,"ر",1,0],["وَمَن طَرَفَهُ أَنّي بِبيضِ سَوادِهِ","يَقُدُّ وَلَم يُخدَشُ بِهِ الجِسمُ في الحَشا",48,"ش",2,0],["وَمَن طَلَب المَفاخر وَالمَعالي","يَهيم بِحُبِّها في كُلّ وادي",49,"د",2,0],["وَمنطقة البَديع وَما اِبن هاني","لَدَيهِ وَما مَقامات الحَريري",50,"ر",2,0],["ومنطقُ خالدٍ ودهاءُ عَمْروٍ","ونجدةُ عامرٍ وسَخاءُ حاتِم",51,"م",1,0],["ومَنْطِقٌ حُسْنُه","يَزيدُ بالانتِقاد",52,"د",1,0],["ومَن طاوَلَ العَلياءَ بالشِّعرِ إنَّما","يَرومُ بِما يَأتي مُطاولَةَ السَّما",53,"م",2,0],["ومنطقك المرتِّل في الليالي","تسابيحُ الملائكة العليه",54,"ي",2,0],["وَمِن طول أَلف الجفن لِلسُهد لَو رَأى","حُروف الكَرى مَرقومة لِتحرجا",55,"ج",2,0],["ومن طَلَبَ الوفاءَ مِنَ الليالي","على عِلاَّتِها طَلَبَ المُحَالا",56,"ل",2,0],["ومن طَرَقَتْ خَيْلُ الخطوبِ حَرِيمَهُ","فأوَّلُ دعواهُ إليهِ انْتِصارُهُ",57,"ر",2,0],["ومن طيب نفحٍ بنَوْر الرِّياضِ","تَلظِّيَ لفحٍ بنار المَقيلِ",58,"ل",1,0],["ومن طلب الحبيب فلا يبالي","بإقحام الخطير ولا اغتراق",59,"ق",1,0],["ومنطقٌ يُفصِح ما","شاء ولا يُحسِن لا",60,"ل",2,0],["ومن طامعٍ في الموَلَّى عليه","ولو سيس بالعدل لم يطمَعِ",61,"ع",1,0],["ومُنطَّقٍ ظنَّ البلاغةَ آيةً","نُصِبتْ له علَماً وشخصً صُوِّرتْ",62,"ت",1,0],["ومن طال عن خُبرِ الأخلاَّء بحثُهُ","ليبلُوَهم لم يخلُ مما يريبُهُ",63,"ب",2,0],["ومن طلب الإحسان من غير كُلفةٍ","ولا طلبٍ فالصَّمتُ عن مدحه كفر",64,"ر",1,0],["ومَنْ طابَتْ مَاسعِيهِ","كما طابَتْ أوائلُهُ",65,"ل",2,0],["ومُنطمِسٍ للعيسٍ والركبِ عندَه","حنينٌ على بالي الرسومِ واِعوالُ",66,"ل",1,0],["ومن طلب الإصلاح لم يأت منكرا","ومن طلب الإنصاف لم يخش مزلقا",67,"ق",2,0],["ومن طاب عيش الفرع إلا بأصله","وكيف وأنتم من عصارة عدناني",68,"ن",2,0],["وَمَن طَلَبَ الأَعداءَ بِالمالِ وَالظُبى","وَبِالسَعدِ لَم يَبعُد عَلَيهِ مُرامُ",69,"م",1,1],["وَمن طَلَب الأَعداء بِالمالِ وَالظُبا","وَبِالسَعدِ لَم يَبعُد عَلَيهِ مُرامُ",70,"م",1,0],["ومن طافت النار في زرعه","تمنى احتراق زروع الأنامْ",71,"م",1,0],["ومن طرب الركب حثَّ الخطى","اليها ونادى البِدار البِدارا",72,"ر",2,0],["ومن طال شرح المادحين لفضله","فما ضره أن مات مختصر العمر",73,"ر",1,0],["ومن طَمَعٍ أُخادع مِنْ يقينِي","على عَمْدٍ وأُكذِبُ من عِياني",74,"ن",2,0],["ومن طمعٍ للفتى خائبٍ","ومن أَمَلٍ في الغنى حائلِ",75,"ل",1,0],["وَمَنْطِقٌ فَاتِنٌ لِمْ يَلْقَ جِيْشَ نُهًى","إِلاَّ سَبَاهُ بِسٍحْرِ اللَّفْظِ أَوْ خَلَّهْ",76,"ل",2,0],["ومِنْ طبعِها ذاك العفافُ وكسْبُها","وما أَحسَن الطبعَ الذِي زِيدَ بالكسْبِ",77,"ب",1,0],["ومنطقها يسبي الحليم بنغمة","تزيد على الأوتار للمتطرب",78,"ب",1,0],["وَمَن طَلَبَ الصَوابُ وَلَم يَقابِل","وُجوهَ الأَمرِ أَعجَزَهُ الطِلابُ",79,"ب",1,0],["وَمَن طَلَبَ السَّماحَةَ مِن سِواهُم","فَقَد طَلَبَ الوِلادَةَ مِن عَقيمِ",80,"م",1,0],["ومن طرب فيه المزاهر هلهلت","وغنى نداماه الهزار المغرد",81,"د",1,0],["ومن طاف حولك فهو الرشيد","ومن جد خلفك فهو البطل",82,"ل",1,0],["ومن طلب الاحباب حرصا على البقا","فما رام بين الناس الا ضياعه",83,"ع",2,0],["وَمِن طالِعٍ كَالسّهمِ مِن جَوفِ شَرقِهِ","وَمِن غارِبٍ في الغَربِ وَالغَربُ قَد أَخفى",84,"ف",2,0],["ومِنْ طِمراتها ألفٌ معوّدة","للحرب يا شِقوة الأعداءِ لو علِموا",85,"م",3,0],["ومنطقُ المرء يُنْبِى عن سجيته","وعقلِه إنْ أبان النطقَ أو رمزا",86,"ز",2,0],["ومن طلب العلاء بلا محل","أعادته مطالبه لركسِ",87,"س",1,0],["ومن طلب القرار بأرض قوم","يُطابِع دهرهم حُلْواً ومُرّا",88,"ر",2,0],["ومن طول التواضع ما","يُريكَ الذلَّ والعنفا",89,"ف",2,0],["وَمِنْ طَائِرٍ يَشْدُو على كُلّ بَانَةٍ","فَأعْرَبَ بِالتَّلْحِينِ أغْرَبَ غُنَّةِ",90,"ه",1,0],["ومن طويلع رقم السَّفح قد دثرت","طمساً معاهده من بعدِ قحطانِ",91,"ن",1,0],["وَمِن طيبِ العَبيرِ حِقاقُ تِبرٍ","وَأَرخَصَ كُلَّ غالِيَةٍ شَذاها",92,"ا",3,0],["وَمن طالع الأخرى فقد ضلَّ عقلُها","وتحسبُ أنَّ الناس طُرّاً عبيدُها",93,"د",3,0],["ومن طوى لسانه 