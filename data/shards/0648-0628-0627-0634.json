{"poems":[[53,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[45,"لقد حازني وجد بمن حازه بعد","https://www.aldiwan.net/poem9544.html","الطويل"],[47,"يا ابن من طاب في المواليد حرا","https://www.aldiwan.net/poem66862.html","الخفيف"],[30,"وجاء قريع الشول قبل إفالها","https://www.aldiwan.net/poem5338.html","البسيط"],[51,"كأن المنايا قد قرعن صفاتي","https://www.aldiwan.net/poem10835.html","الطويل"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[47,"يا بْنَ مَنْ طَابَ في المَوَالِيدِ حُرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=31683",""],[132,"وقلت له لقياك خير علالة","https://www.aldiwan.net/poem50574.html","الطويل"],[196,"خر غراب البين من حالق","https://www.aldiwan.net/poem27575.html","السريع"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[325,"كم أطنب الناس في وصف العذار وكم","https://www.aldiwan.net/poem61685.html","البسيط"],[371,"تدب دبيب النار والهم فحمها","https://www.aldiwan.net/poem17727.html","الطويل"],[411,"وباشرت أمري واعتنيت بحاجتي","https://www.aldiwan.net/poem49468.html","الطويل"],[463,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[483,"لوركا","https://www.aldiwan.net/poem2292.html","عموديه"],[505,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[520,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[520,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[520,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[572,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[857,"","https://poetry.dctabudhabi.ae/diwan/poem/73721","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77606","الرجز"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44992","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53137","الرجز"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121918","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27299","الخفيف"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27108","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107183","الرجز"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68158","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74213","الوافر"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127912","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48290","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66486","الوافر"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36112","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85136","الخفيف"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33126","الطويل"],[4692,"شدي على الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=214543",""],[5189,"كنْ يا أخي","https://www.poetsgate.com/ViewPoem.aspx?id=190549",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5582,"هَلْ قَدْ أَضاءَتْ شُمُوسٌ فِي المَحارِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186670",""],[5656,"قل للإمام الذي ترجى فضائله","https://www.poetsgate.com/ViewPoem.aspx?id=121950",""],[5968,"سميت بالله من ياني الخبر جدام","https://www.poetsgate.com/ViewPoem.aspx?id=175413",""],[6142,"جاء في مثل ما به جاءت الر","https://www.poetsgate.com/ViewPoem.aspx?id=155702",""]],"verses":[["وباشرتَ فيه كل لينٍ وشدةٍ","وجاهدتَ عنه فوق جَهْد المجاهدِ",0,"د",1,0],["وَباشَرَ أَبكارَ المَكارِمِ أَمرَداً","وَكانَ كَذا آباؤُهُ وَهُمُ مُردُ",1,"د",1,0],["وَبِأَشياخِكَ الكِرامِ أَولي ال","أَفضالِ موسى اِبنِ جَعفَرٍ وَبَنيهِ",2,"ي",2,0],["وَباشَرَ راعيها الصِلا بِلَبانِهِ","وَكَفَّيهِ حَرَّ النارِ ما يَتَحَرَّفُ",3,"ف",1,0],["وَباشَرتُ أَطباقَ الثَرى وَتَوَجَّهَت","بِنَعيِي إِلى مَن غِبتُ عَنهُ نُعاتي",4,"ت",2,0],["وباشرتك هبات الله دائبة","بعارض من عظيم الفضل منهطل",5,"ل",1,0],["وَبأَشيَاخِكَ الكرَامِ أُولِي الْ","أَفضَالِ مُوسى بن جَعْفَرٍ وبَنِيهِ",6,"ي",2,0],["وباشرْ إذا مرّتْ بك الدهرَ فرصةٌ","فإن لم تباشرْها فإنك آسفُ",7,"ف",1,0],["وَباشِقِ الحُبِّ نَصَبنا لَهُ","بِبَلبَلِ الصِدقِ فَصَدناهُ",8,"ن",3,0],["وبأشعث أغبر ذي ثوبٍ","خلِقٍ لا يرغب في الترف",9,"ف",1,0],["وَباشِرِ اللَحظَ تَنفيذَ القَضا عِجلاً","وَحاجِباهُ عَلى قَهري تُعاوِنُهُ",10,"ن",2,0],["وَباشَرَ أَسرارَ النُفوسِ كَبيرُها","عَلى حالَتَيهِ إِذا تَذوبُ وَتَجمُدُ",11,"د",1,0],["وباشرْت أمري واعتنَيْتَ بحاجَتي","وأخَّتَ لا عَنِّي وقَدَّمْت لي نَعَمْ",12,"م",1,1],["وباشرتَ الخلافةَ فاطمأنَّتْ","على أمرٍ ومطلبُه عسيرُ",13,"ر",1,0],["وبأشعارك يا لوركا , يلم الصدقات","من عيون البؤساء !",14,"ا",2,0],["وبأَشْجانٍ سَرَيْنا","وبِنا ثارَ الغَرامْ",15,"م",1,0],["وباشرت أحكام المظالم حسبة","لك الله فيها بالثواب حسيب",16,"ب",1,0],["وباشرتها جهراً بنفس كريمة","تصان وتفدى بالنفوس الكرائم",17,"م",1,0],["وباشر عند نصرتها المنايا","مباشرة اصطلاء واصطلام",18,"م",1,0],["وَبَاشِقِ ذِي نَخْوَةٍ","عَلَى الطُّيُورِ ذُ سَخَطْ",19,"ط",1,0],["وَبِأَشهَبٍ شُهبَ البِغالِ رَكِبتُمُ","وَبِأَصبَغ صُبِغَت لَكُم في العالَمِ",20,"م",1,0],["وَباشر الإِصطبل طُرّا فَرَأى","بَينَ الرُؤوس رَأسَ وَحشٍ فَنَأى",21,"ا",2,0],["وَبِأَشياخِكَ الكِرامُ إِلى السُؤ","دُدِ موسى بنُ جَعفَر وَأَبيه",22,"ي",2,0],["وباشر الصبح النجوم فانثنت","في أفقها مثل العيون النعس",23,"س",1,0],["وباشر مراما هامة الشمس دونه","وبدر الدجا ما بين كفيه خادم",24,"م",1,0],["وبأشياء جمعةٍ تتعالى","كعلومِ دليلها في عيانِ",25,"ن",1,0],["وَباشَرَ مَعمورَ الكِناسِ بِكَفِّهِ","إِلى أَن يَكونَ الظِلُّ أَصَرَ مِن شِبرِ",26,"ر",1,0],["وباشِيُ الشَّولَة إليكَ الوَصفُ","في غير ذا النوَّ اصبَعٌ ونصف",27,"ف",1,0],["وباشِيُ الصَّرفَةِ ضدُّ هذا","ذا هادمُ البَاسِي وهذا شاذَا",27,"ذ",2,0],["وَباشِرِ المُسلِمَ بِالتَّحِيَّه","أَو كَلِماتٍ عِندَهُ مَرضِيّه",28,"ه",1,0],["وبأشواقنا الحمائم هاجت","فغناءٌ على الربا وانتحاب",29,"ب",1,0],["وَباشرها النَسيم فَفاحَ مِنها","شَذا عطر أَلَم بِنا وَغالى",30,"ل",2,0],["وباشروا قتلهم بما بدا لهم","فبعضهم ذابح والبعض طعان",31,"ن",1,0],["وباشرْتَ بالنّفسِ الكريمةِ أمْرَهُ","وذلكَ فخْرٌ ليسَ يَبْلى جديدُهُ",32,"د",2,0],["وباشرت الطعان بكل لدنٍ","شككت به كلا الأبطال شكا",33,"ك",2,0],["وَباشَرتَ أَمري وَاِعتَنَيتَ بِحاجَتي","وَأَخَّرتَ لا عَنّي وَقَدَّمتَ لي نَعَم",34,"م",1,0],["وبإشراقها وما حل فيها","من لآل وبهجة والتهاب",35,"ب",1,0],["وبأشهى اللقى بعد التجافي","بالتراضي من الملاح الغضاب",35,"ب",1,0],["وَباشَرَهُ بِالقَتلِ وَسطِ جَنابِهِ","وَعايَنَهُ الكِندُ المَليكُ فَأَرعَدا",36,"د",2,0],["وباشريني بحضن يانعٍ فأنا","ذبلت كالورد ياااا.. عمري ولست معي",37,"ي",1,0],["وباشرْ بِدعوى إلى الله دوماً","وكنْ في طريقِ الهُدى واليقينْ",38,"ن",1,0],["وَباشَرَتْها مِنَ الأَرْياحِ سَجْسَجُها","وَغَيَّرَتْ رَسْمَها المَعْهُودَ صَرْصَرُها",39,"ر",3,0],["وَباشَرَتْنِي بِشاراتُ السُّرُورِ بِهِ","وَكانَ شِعْرِي لَدَيْهِ غَيْرَ مَنْسُوبِ",40,"ب",1,0],["وباشر العلج ما كانت تضن به","على الحلال بوافي المهر والقهب",41,"ب",1,0],["وباشهد انه غلَّق في الظمام","وبْعدها غنيمة يومن محدّ اجتلت",42,"ت",1,0],["وبإشباعه الكثير من النا","سِ المساغيب من ذراع فريد",43,"د",1,0]]}