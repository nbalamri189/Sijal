{"poems":[[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[91,"أنا فيما أبديته من مقال","https://www.aldiwan.net/poem45103.html","الخفيف"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[42,"حمل القلب من حميدة ثقلا إن","https://www.aldiwan.net/poem42297.html","الخفيف"],[48,"عنسي في الدنيا سوى الراهي","https://www.aldiwan.net/poem23594.html","السريع"],[189,"عن سيف دين الله سل أرناطا","https://www.aldiwan.net/poem14806.html","الكامل"],[197,"خير ما استعصمت به الكف يوما","https://www.aldiwan.net/poem13105.html","الخفيف"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[342,"ولقد قطعت الخرق تحمل نمرقي","https://www.aldiwan.net/poem45330.html","الكامل"],[396,"أنني لمقصر","https://www.aldiwan.net/poem54595.html","عموديه"],[441,"جرر على القمرين ذيل التيه","https://www.aldiwan.net/poem2652.html","الكامل"],[447,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[457,"يا سائلا عن نجاح معنى","https://www.aldiwan.net/poem13903.html","مخلع البسيط"],[505,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[581,"من مبلغ الشعراء عن أخويهم","https://www.aldiwan.net/poem1773.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138194",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66736","السريع"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110478","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86708","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84507","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78171","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113954","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113963","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108859","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69349","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109388","البسيط"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216582",""],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106972","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106973","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74234","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89360","المتدارك"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53007","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108346",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3719,"","https://poetry.dctabudhabi.ae/diwan/poem/111113","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131070",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76457","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86362","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90793","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45131","الرمل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33064","المديد"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72829","البسيط"],[4737,"سورة الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=213331",""],[4883,"هزيمه تنتصر","https://www.poetsgate.com/ViewPoem.aspx?id=48367",""],[4899,"أجمل عناويني","https://www.poetsgate.com/ViewPoem.aspx?id=177011",""],[4932,"عهدي به والبين ليس يروعه","https://www.poetsgate.com/ViewPoem.aspx?id=187279",""],[4978,"الجرح ممتد","https://www.poetsgate.com/ViewPoem.aspx?id=177135",""],[5005,"مرورعلى شرفة الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=189347",""],[5038,"جيش العراق","https://www.poetsgate.com/ViewPoem.aspx?id=195220",""],[5145,"من رأى البرق تعالى وسنا","https://www.poetsgate.com/ViewPoem.aspx?id=108060",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5298,"هَلْ حَبْلُ خَوْلَةَ بَعْدَ الهَجْرِ موصولُ","https://www.poetsgate.com/ViewPoem.aspx?id=183371",""],[5376,"بلقيس ألقت جمالا من خمائلها","https://www.poetsgate.com/ViewPoem.aspx?id=189751",""],[5425,"لَمْ تُدرِكِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=199167",""],[5431,"ميحانةٌ...ميحانه...أغنية","https://www.poetsgate.com/ViewPoem.aspx?id=200018",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5732,"اعلل النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177939",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5790,"لا نرى أحسن منكم منظرا","https://www.poetsgate.com/ViewPoem.aspx?id=112051",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""]],"verses":[["عَنسٌ مُذَكَّرَةٌ قَد شُقَّ بازِلُها","لَأياً تَلاقى عَلى حَيزومِها العُقَدُ",0,"د",1,0],["عن سبيل الرشد حدت فارجعني","إلهي إلى سبيل الرشاد",1,"د",1,0],["عَنسَلٍ تُلوي إِذا أَبشَرَت","بِخَوافي أَخدَرِيٍّ سُخام",2,"م",1,0],["عَن سِواها فَلا تَظُنَّنَّ أُنثى","أَنَّ في القَلبِ عَن حُمَيدَةَ فَضلا",3,"ل",2,0],["عَنسِيَ في الدُنِّيا سِوى الراهي","طَلَّقتُها تَطليقَ إِكراهِ",4,"ه",1,1],["عن سيفِ دينِ اللهِ سَلْ أَرْناطا","حيث المنيةُ كأسُها يُتعاطَى",5,"ط",2,1],["عَن سُؤالِ اللِئام مغنٍ","وَفي العَظمِ مُغن وَلِلمَنايا رَسولُ",6,"ل",1,0],["عن سِرب طيرٍ سارب","من الحَمام الراعبي",7,"ي",1,0],["عَنسٌ مُذَكَّرَةٌ كَأَنَّ ضُلوعَها","أُطُرٌ حَناها الماسِخِيُّ بِيَثرِبِ",8,"ب",1,0],["عن سؤالك والدعا","لست عن ذين أبرح",9,"ح",1,0],["عَن سِحرِ هارُوتٍ يُحدِّثُ لَحظُهُ","وَجَمالُهُ عَن يُوسُفٍ يَروِيه",10,"ي",2,0],["عن سوف أو حتى متى وعسى","منزهٌ وإذاً أو حيث كيف بقى",11,"ق",2,0],["عن سماع الافك أو شيء أمر","ورأى الشمس إلى الغرب هوت",12,"ت",1,0],["عن سادةٍ كلّهم سَرَاةٌ","وكلُّهمقادَةٌ كِرامُ",13,"م",1,0],["عن سرِّ حكمك قد تفرَّع كلُّ ذا","وعليه جيشٌ من جلالك عاقدُ",14,"د",1,0],["عَنسٌ إِذا ضَمَرَت تَعَزَّزَ لَحمُها","وَإِذا تُشَدُّ بِنِسعِها لا تَنبِسُ",15,"س",1,0],["عنست كواعبنا فأين مصيرها","إن عم ذاك الفسق في الأنحاء",16,"ا",2,0],["عن سيّد الناس أبي جعفرٍ","فلم يقلْ صِدقاً ولم يبرُرِ",17,"ر",1,0],["عن سنّ أَربع ولَّت عن بَني كَرَمٍ","وغادَرَت مَدمعَ الاَجفان مُنسكَبا",18,"ب",2,0],["عَن سِواهُم تَمَيزّوا بِعُلوم","وَفُنُون مَنظومة كَالعُقود",19,"د",1,0],["عن سيبويه المرتضى شيخ الملا","عن الخليل ثم عن نجل العلا",20,"ل",2,0],["عَن سَحر بابل أَعرَبَت أَلفاظُها","وَلَكُم نَحا هاروتها مِن ساحر",21,"ر",1,0],["عَنساً تُعارِضُ بالعَشِيِّ نواجِياً","مِن كُلِّ موجَدَةٍ القرا شرواطِ",22,"ط",1,0],["عَنسٍ تعارِضُ مجنوبَ الجهامِ إذا","تكسو الظهيرَةُ ظُهرانَ المَلا سَرَقا",23,"ق",2,0],["عن سؤَالٍ عنهُ السؤَال جوابُ","تمَّ ما رمتُ والزمان وفى لي",24,"ي",1,0],["عن سادة مثل الرياض بشاشة","غر الوجوه أفاضلٍ أعلام",25,"م",1,0],["عَنَّ سِربٌ لَنا يَفيضُ بِهِ الفج","ج وَيَرمي بِنا إِلَيهِ الفَضاءُ",26,"ا",2,0],["عن سورة النصر يروي لحظه خبرا","لنا فتأتي له الأرواحُ سلسالا",27,"ل",2,0],["عن سورة النصر يروي لحظه خبرا","من فعل أجفانه حذفاً وايصالا",27,"ل",2,0],["عَنْ سفركم بكتبها خيره","لين أفكّك هاي لِمْصيبه",28,"ب",2,0],["عنس تبارى ذئاب الدو ضامئة","لم تدر ما الماء في المسرى ولا العشب",29,"ب",1,0],["عنس تهادى في السراب بمجهل","قفر به ضلّ القطا المسروب",30,"ب",1,0],["عَنسٌ كَأَنَّ عِظامَها مَوصولَةٌ","بِعِظامِ أُخرى في الزِّمامِ سَعومُ",31,"م",1,0],["عن سوى مدحهِ وذكرِ عُلاهُ","قد أبت لي قريحتي وبياني",32,"ن",2,0],["عَن سَاحِلِ الأخوَار مِنَ الأزوَامِ","نَيِّف وَثَلثِينَ فَخُذ كَلامِي",33,"ي",1,0],["عن سعد أخبية يقول مقدم","وموخر أن الرشا في الخيمة",34,"ه",1,0],["عَن سَيدي الشَيخ بَدر الدين أَوحدهم","مُحمد العادلي العارف النائي",35,"ا",2,0],["عن سمة التكييف والتحديد","وعن صفات النقص والتقييد",36,"د",1,0],["عن سيد أرباب العليا","والقطب الفرد الرباني",37,"ن",2,0],["عن سعدِها قد أرختُ","بالسعد بَختي طالع",38,"ع",1,0],["عن سائر الاهواء نزه طرفه","بالمكرمات غدا يهيم ويعشق",39,"ق",1,0],["عن سفاحٍ محرَّمٍ ولِواطٍ","وبدالٍ وغُبَّرٍ ونِفاقِ",40,"ق",1,0],["عَنسٍ تُشيرُ بِقِنوانٍ إِذا زُحِرَت","مِن خَصبَةٍ بَقِيَت فيها شَعاليلُ",41,"ل",1,0],["عنساً هجاناً وبزلاء مذكرة","طعامها في السرى التسنيم والجرر",42,"ر",1,0],["عن سرب طير سارب","عن الحمام الراعب",43,"ب",1,0],["عن سناها يشف صدري فلوح","دق بالعين ناظر لرآها",44,"ا",3,0],["عَن سِهام النَظرات","تِلكَ امال لها عَن",45,"ن",1,0],["عنس كتيس القاع جفالة","في دوها إجفال ظلمان",46,"ن",1,0],["عنس كتيس القاع أرسل شارداً","أو كالظليم مذعراً إجفيلا",47,"ل",2,0],["عن سروحي ذي قوي","عمن على العرش استوى",48,"ت",3,0],["عَن سِواكُم ما نَزَعنا","وَعَلَيكُمُ لا نَحول",49,"ل",1,0],["عَن سَماءٍ لَهُم كُلَّ يَومٍ","ديمَةٌ مِنهُ وَوَبلٌ وَطَلُّ",50,"ل",1,0],["عن سابق العصرِ نظمي جاء بشكركم","باللفِّ والنشرِ مبسوطا بمدرجِ",51,"ج",1,0],["عنْ ساقِها لعيونِ الماءِ لو كَشَفتْ","لأصبحتْ لَبَناً يَشفي منَ العِللِ",52,"ل",1,0],["عن ستاير تزاحم كل شبّاك غرفة","لا انفتح باب ..خلفه باب ماهو نظيف!",53,"ف",1,0],["عن سر ليلي وليلك بس حاكيني","وعن خيل الإحساس والتعبير والصورة",54,"ر",2,0],["عن ساكن الوادي سقته مدامعي","حدث حديثا طاب لي مسموعه",55,"ع",2,0],["عن سر عزتها ونبع وجودها","رغبت عن المولى إلى الأصنام",56,"م",1,0],["عن ساعة فيها يزور مدينتي","دفء.. ويهدي للصغار أمانا",57,"ن",2,0],["عَنْ سِرِّ جَيشٍ في أَعاصيرِ الْوَغى","عَزَّ الْبِلادَ وَأَكْرَمَ الْإِنْسانا",58,"ن",2,0],["عنست بكر العلى إذ لم تجد","في بسيط الأرض زوجاً فمنا",59,"ن",2,0],["عن سوسن الجيد والصهبا تميل به","عن قامة البان والأهواء تثنيها",60,"ي",3,0],["عن سوسن الجيد قضبانا مجردة","عن قامة كاد خوط البان يلويها",60,"ي",3,0],["عَنْسٍ تُشِيرُ بِقِنْوَانٍ إِذا زُجِرَتْ","مِن خَصْبَةٍ بَقيَتْ فيها شَمالِيلُ",61,"ل",1,0],["عن ساقها كشفت ظنا بمأمنها","ما أنبست شفة في فيه عاذلها",62,"ل",3,0],["عَنْ سَاهِرٍ غَرَسَ اليَبَابَ نَدَاوةً","ثُمَّ اخْتَفَىْ كَالطَارِقِ المُتَلَثِّمِ",63,"م",1,0],["عن سرّ خلدٍ دائمٍ","يُبقي له سلطانه",64,"ن",2,0],["عن سادة سكنوا حيناً وقد رحلوا","وخلّفوا عاطر الأذكار للآتي",65,"ت",2,0],["عن سهم طرفك لذت يا زين بحمالك","باسم الذي سواك ترحم دخيلك",66,"ك",1,1],["عن سواها فرقها بالقمر والنجوم","وكل عذرى تباها بالجمال انزحت",67,"ت",1,0],["عن سقفِ محرابٍ يُراودُ راهباً","عن ذئبِ بئرٍ ما يُلاطفُ معتقلْ",68,"ل",1,0],["عن سرى منكم نسيمٌ عابق","كان كل الصيد في جوف الفرا",69,"ر",2,0],["عن سجدة لا تملكين سوى","أن تغرقي فيها وتبتهلي",70,"ل",2,0]]}