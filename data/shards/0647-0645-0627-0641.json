{"poems":[[65,"سقى الله رملي كوفن صيب الحيا","https://www.aldiwan.net/poem45877.html","الطويل"],[56,"رأيت من الكبائر قاضيين","https://www.aldiwan.net/poem27370.html","الوافر"],[30,"على المتردفات بكل خرق","https://www.aldiwan.net/poem5155.html","الوافر"],[21,"اقترب الوعد والقلوب إلى","https://www.aldiwan.net/poem36191.html","المنسرح"],[48,"عجبت لملبوس الحرير وإنما","https://www.aldiwan.net/poem23128.html","الطويل"],[8,"ومن أيامنا يوم عجيب","https://www.aldiwan.net/poem21805.html","الوافر"],[92,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[186,"بكى ابن عبيد يوسف إذ أتاه","https://www.aldiwan.net/poem61184.html","الوافر"],[266,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[366,"أقول له وقد عاينت منه","https://www.aldiwan.net/poem68078.html","الوافر"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[435,"تجلت لدينا في محاسنها مصر","https://www.aldiwan.net/poem40262.html","الطويل"],[447,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107258","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126683","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96979","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130153","الطويل"],[543,"","https://poetry.dctabudhabi.ae/diwan/poem/124975",""],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31638","الوافر"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26653","الوافر"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96332","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27751","البسيط"],[2442,"","https://poetry.dctabudhabi.ae/diwan/poem/198632","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137213",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74206","الطويل"],[3071,"","https://poetry.dctabudhabi.ae/diwan/poem/34875","الوافر"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31687","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129419","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117878","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127155","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139782",""],[6106,"بين نهرين : د . جهاد ، د . سمير","https://www.poetsgate.com/ViewPoem.aspx?id=6314",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[2220,"يا مَنزلاً ما له نظير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11444&r=&rc=318",""]],"verses":[["هُمُ أَفْسَدوا إِذْ صَاهَرُونا أُصُولَنا","وَكَمْ صَالِحٍ شَانَتْهُ صُحْبَةُ فَاسِدِ",0,"د",1,0],["هُما فَألُ الزَمانِ بِهُلكِ يَحيى","إِذ اِفتَتَحَ القَضاءَ بِأَعوَرَينِ",1,"ن",1,0],["هُما في راحَتَيكَ إِذا تَلاقى","عُبابُهُما إِلى حَلَبٍ غَزيرِ",2,"ر",1,0],["هُما فَريقانِ فِرقَةٌ تَدخُلُ","الجَنَةَ حُفَّت بِهِم حَدائِقُها",3,"ق",3,0],["هُما فَتَيا دَهرٍ يَمُرّانِ بِالفَتى","فَلَو عُدَّ هَضبٌ غَيَّرَتهُ زَلازِلُه",4,"ل",2,0],["هُما فَتنَانِ مَقضِيٌّ عليهِ","لِساعَتِهِ فَآذَنَ بِالوَداعِ",5,"ع",1,0],["هم افترشوا خد الذليل وأوطئت","لأقدامهم تلك الخدود الضوارع",6,"ع",1,0],["هُما فَرعا جَمالٍ يُوسُفِيٍّ","قَد اِنقَصَفا أَمامَ رِياحِ بينِ",7,"ن",1,0],["هم افترعوا العلياء بكراً وليس من","يحاول عوناً مثل ومن وطيء البكرا",8,"ر",2,0],["هما فرعان طابا حينَ طابَت","أُصولُهُما وَجلا حينَ جَلا",9,"ل",2,0],["هُمُ افتتَحوها ثمَّ حلُّوا نِجادَها","وما الليثُ عمّا صادَه بمُهَيَّج",10,"ج",1,0],["هما فرقدا أوج اليراعة والنهى","وأبناءُ بيتٍ مهده النظم والنثر",11,"ر",1,0],["هما فقد بغضا الأوطان مذ عشقا","لقاك فوز أمرئ للوصل قد عشقا",12,"ق",2,0],["هما في الحياة الناصراك وبعدما","لقيت الردى قاما مقامك في الفتوى",13,"و",2,0],["هُما فجرانِ أبيضُ مستطيرٌ","ولم يمدُد بلَهزَمَتَيهِ باعَه",14,"ع",2,0],["هُما فدّك مِن مُؤمن متقرّب","ولي له عمّن تباعد من قربِ",15,"ب",1,0],["هما في بيان النون والعلمية","فلا ممكن عن حيطة العقل خارج",16,"ج",1,0],["هم أفضل الشهداء والقتلى الألى","مدحوا بوحي في الكتاب مبين",17,"ن",1,0],["هما في بني عثمان سيف ودولة","من الملك أخشى ثغره لهما غمد",18,"د",1,0],["هُما في سماءِ المَجدِ نَجماً سَعادَةٍ","ومِن فَرعِ غُصنٍ طَاهرٍ عبِقاً زَهرا",19,"ر",2,0],["هُما في صِحَّةٍ وبَديعِ لَفْظٍ","كَما قُرِنَ الجُمانُ معَ الجُمانِ",20,"ن",1,0],["هما فخارتا راح وريح","تكسرتا فاشقاف وجيفه",21,"ه",1,1],["هما فتيا الناس اللذا لم ينلهما","رئيس ولا الاقيال من آل حميرا",22,"ر",2,0],["هما فتمُ بذاك قدراً","على المقاصير والقصورِ",23,"ر",1,0],["هما فرسا ذاك الرهان تقدما","وجاءا قراناً من أمام السلاهب",24,"ب",1,0],["هما فرعا ابن قد كان يرضي","بما يجريه مريم والمسيحا",25,"ح",2,0],["هُما فَرَسا سَبق لِكُل فَضيلة","بجيدهِما الوضاح تَزهو عُقودها",26,"د",3,0],["هُما فَألُ الزَمانِ بِهُلكِ يَحيى","إِذا اِفتُتِحَ القَضاءُ بِأَعوَرَينِ",27,"ن",1,0],["هُما في عَسْكَرِ الأَنْوارِ هَذا","مَقْدمة يسيرُ وذاكَ ساقَهْ",28,"ق",2,0],["هما فرقدا علم وجود كلاهما","فذا فاضل فينا وذا متفضل",29,"ل",1,0],["هما فرسا الرهان هما رضيعا","لبان المجد فادعهما يجيبا",30,"ب",2,0],["هما فرقدا أفق الفخار وقاهما","آله السما الرحمن من نكبة الطمس",31,"س",1,0],["هما فرقدا مجدٍ بأفق مكارمٍ","أضاءا وكلٌّ طاهر الذات ناسك",32,"ك",1,0],["هما في موكب الأحباب رادا","وفي حسنيهما وجب الحضور",33,"ر",1,0],["هم أفسدوا لشعوب بعدما فجروا","وأودعونا لأشرار وكفار",34,"ر",1,0],["هما فتسمو بذاكَ قدراً","على المقاصير والقصورِ",35,"ر",1,0]]}