{"poems":[[55,"جاء بها قالصة عن ساق","https://www.aldiwan.net/poem29930.html","الرجز"],[55,"أكافينا النصيح بقي","https://www.aldiwan.net/poem30631.html","مجزوء الوافر"],[55,"يا آمن الأقدار بادر صرفها","https://www.aldiwan.net/poem30664.html","الطويل"],[74,"الكأس في كف غادة رود","https://www.aldiwan.net/poem18573.html","المنسرح"],[53,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[72,"وركب كالنجوم على نجوم","https://www.aldiwan.net/poem42795.html","الوافر"],[64,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[47,"ضمان على عينيك أني لا أسلو","https://www.aldiwan.net/poem65536.html","الطويل"],[63,"عصى الرشاد فقد ناداه من حين","https://www.aldiwan.net/poem51409.html","البسيط"],[63,"نطوي الليالي علما أن ستطوينا","https://www.aldiwan.net/poem51410.html","البسيط"],[46,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[54,"وقد ألاقي بأس العداة على","https://www.aldiwan.net/poem27132.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[422,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[1047,"","https://poetry.dctabudhabi.ae/diwan/poem/122943","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96760","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3662,"","https://poetry.dctabudhabi.ae/diwan/poem/45553","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4578,"سليم فؤادي لا تظن سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=49521",""],[231,"الإنسان الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=186167",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5956,"حكيماً كان سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=192635",""]],"verses":[["تَحثو عَلى نَجدٍ ثَرى العِراقِ","كَأَنَّها بَعضُ الهَبابِ الباقي",0,"ق",2,0],["تَحُثُّ إِلى العُلى قَدَماً","وَتَبسُطُ بِالنَوالِ يَدا",1,"د",2,0],["تَحثو عَلى عَيبِ الغَني يَدُ الغِنى","وَالفَقرُ عَن عَيبِ الفَتى بِحّاثُ",2,"ث",1,0],["تحثُّها بالغناء غانيةٌ","تعرب فيه عن لحن داود",3,"د",1,0],["تحثُّ الحسانُ المُحسِناتُ كؤوسَهُ","بِمَدْحٍ له قد سار جمَّ المسالِك",4,"ك",1,0],["تَحُثُّ مَطِيَّنا الأَشواقُ مِنّا","وَنَقطَعُ بِالأَحاديثِ الطَريقا",5,"ق",2,0],["تحثُّ والشمسُ في حوض الدُّجَى كرعتْ","وتَنْتَحي وظلام الليل يؤويكا",6,"ك",2,0],["تَحُثُّهُمُ البيضُ الرِقاقُ وَضُمَّرٌ","عِتاقٌ وَأَحسابٌ بِها يُدرَكُ التَبلُ",7,"ل",1,0],["تَحُثُّ أَقْدَاحَهُمْ بِيضُ السَّوَالِفِ في","حُمْرِ الغَلائِلِ في خُضْرِ البَسَاتِينِ",8,"ن",1,0],["تَحُثُّ حمراءَ يَلقاها المِزاجُ كما","أَلقيتَ فَوقَ جَنِيِّ الوَردِ نِسرينا",9,"ن",2,0],["تَحثو إِذا حَثَّ العِتاقَ الوَخدُ في","غُرَرِ العِتاقِ النَقعَ بِالتَوحيدِ",10,"د",1,0],["تَحُثُّهُ نَفسُهُ إِذا حُثَّتِ ال","خَيلُ وَطارَت بِهِ رِجلٌ وَيَدُ",11,"د",1,0],["تحثو التراب عَلى جوانب رأسها","وَتَصيح من قلب لها حران",12,"ن",1,0],["تحُثّ جَناحاً مِن حِذارِ مُغاوِرٍ","صَباحاً فقَبْضٌ يجْمَعُ الرّيشَ أو بَسْطُ",13,"ط",1,0],["تحثُّ السَّير مسرعةً تهادى","إلى علياك من فجٍّ عميق",14,"ق",1,0],["تحث جيوش الفكر في الصدر تقتفي","لمية آثارا بقلبي طروسها",15,"س",3,0],["تَحثو بِقادمتي حمامة أيكةٍ","برد أشفّ لثاثه بالأثمدِ",16,"د",1,0],["تَحُثُّ على الصلوةِ وقد تَراها","وساعتُها تنوط بالفِ عامِ",17,"م",1,0],["تَحُثُّكَ لَمّا اِستَلحَمَت أُخرَياتُهُم","وَأُدرِكَ ريعانُ السَوامِ المُجَرَّبِ",18,"ب",1,0],["تَحثي السَّفَى عِندَ المَصيفِ فوقَها","كُلُّ عَصُوفٍ قد سَفَت فيهِ الحَثى",19,"ا",1,0],["تحث على حفظ الوداد أخا هوى","يرى حل عقد للمحب حراما",20,"م",2,0],["تحث خطاها موكبا إثر موكبٍ","وقد جاورت فيها المآسي البشائرُ",21,"ر",1,0],["تحثّيني على الخير ِ","أراكِ فأنتشي يا ربْ :",22,"ب",1,0],["تحثُّ على التدبر والتفاني","لمحو الجهل من كل العقولِ",23,"ل",1,0]]}