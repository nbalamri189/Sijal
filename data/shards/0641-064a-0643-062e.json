{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110735","الخفيف"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47519","السريع"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134080","السريع"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134081","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58157","السريع"],[5944,"عنيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213101",""]],"verses":[["فِيكَ خَطْبُ الْعُلَى فَدَحْ","إِذْ تَوَلَّيْتَ يَا فَرَحْ",0,"ح",1,1],["فيك خود الهنا تروح وتغدو","فهي فيه روائح وغوادي",1,"د",2,0],["فيكَ خِلافٌ لِخِلافِ الذي","فيهِ خِلافٌ لِخِلافِ الْجَميلْ",2,"ل",1,1],["فيك خلاف لخلاف الذي","في كل فضل منه قصد نبيل",3,"ل",1,1],["فيك خلاف لخلاف الذي","ليس له في فضله من مثيل",4,"ل",1,1],["فيكَ خطايانا لقد كُفِّرَتْ","فيكَ مساوينا لقد غُفِرَتْ",5,"ت",1,0],["19- فيكِ خريفٌ زاهرٌ","ما اسطاعَ حُزْنٌ يُذبِلَهْ",6,"ل",2,0]]}