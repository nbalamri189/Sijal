{"poems":[[90,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[72,"عشق تجدد ثانيه","https://www.aldiwan.net/poem42395.html","مجزوء الكامل"],[63,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[107,"نهض الغزاة فأين تمضي العير","https://www.aldiwan.net/poem43998.html","الكامل"],[107,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[48,"هي غربتان فغربة من عاقل","https://www.aldiwan.net/poem23250.html","الكامل"],[203,"ذات ملك طغت بها عزة الملك","https://www.aldiwan.net/poem45619.html","الخفيف"],[228,"وقفا بميروبا على أطلالها","https://www.aldiwan.net/poem41619.html","الكامل"],[280,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[369,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[469,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[484,"سعيا لأجلك في الرعيل المهتدي","https://www.aldiwan.net/poem36956.html","الكامل"],[487,"هي لؤلؤ تفتر عن درّ بدا","https://www.aldiwan.net/poem24469.html","عموديه"],[487,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[505,"لله أن يختار من أحبابه","https://www.aldiwan.net/poem38096.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110414","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48674","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145971","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128702","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202557",""],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71036","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110253","الخفيف"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101398","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89059","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107538","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66164","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72350","الخفيف"],[4680,"قمرٌ يُطلّ بوجهه ويغيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=192912",""],[4578,"حكم العيون من الظماء الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49401",""],[4852,"الطور والتشرين","https://www.poetsgate.com/ViewPoem.aspx?id=214364",""],[5005,"موائد الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=208146",""],[5174,"اللغةُ الخالدة","https://www.poetsgate.com/ViewPoem.aspx?id=199658",""],[5219,"إلى أرض الفرات","https://www.poetsgate.com/ViewPoem.aspx?id=194989",""],[5277,"غيرة","https://www.poetsgate.com/ViewPoem.aspx?id=191030",""],[5285,"خالد","https://www.poetsgate.com/ViewPoem.aspx?id=204393",""],[5616,"سيف على لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=205036",""],[5638,"ديمة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=197900",""],[5848,"أخت القمر","https://www.poetsgate.com/ViewPoem.aspx?id=53377",""],[6093,"ما بَعدَ مكة َ والمدينةِ والتي","https://www.poetsgate.com/ViewPoem.aspx?id=179793",""],[6093,"حلوية عربية","https://www.poetsgate.com/ViewPoem.aspx?id=215567",""],[6198,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79295&r=&rc=69",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""]],"verses":[["هي غمّازة اللحاظ لعوب","ذات دلّ ظريفة لحّانه",0,"ن",2,0],["هِيَ غَلطَةٌ كانَت وَلا","وَاللَهِ تَرجِعُ ثانِيَه",1,"ي",2,0],["هِيَ غَدرَةٌ للدَّهرِ غادَرَتِ الهَوى","بعدَ الوفاءِ مكدَّراً مَطروقا",2,"ق",2,0],["هِيَ غارةُ البَطَلِ المُظَفَّرِ مالكم","مِنه إذا خَاضَ الغِمَارَ مُجيرُ",3,"ر",1,0],["هي غرتهم فضلوا وعتوا","واستحبوا الكُفرَ بَغياً وعِنادا",4,"د",2,0],["هِيَ غُربَتانِ فَغُربَةٌ مِن عاقِلٍ","ثُمَّ اِغتِرابٌ مِن مُحَكِّمِ عَقلِهِ",5,"ل",2,1],["هي غصنُ الرياضِ والزهرِ والور","دِ قواماً ونفحةً وخدودا",6,"د",2,0],["هيَ غادَةٌ في كسروانَ مقيمَةٌ","تَصطادُ أَربابَ الهَوى بِحِبالِها",7,"ل",3,0],["هيَ غايَةُ الشّرف التي ما بَعْدَها","أمَدٌ فَيَصْمِدُهُ الرّجاءُ ولا مَدى",8,"د",2,0],["هي غُرَّةٌ في وَجْهِ عَسْكَرِ مُكْرَمٍ","فُقِدَتْ فشانَتْ حُسْنَه المَقْبولا",9,"ل",2,0],["هي غنية الغزل الطروب وبغيةُ ال","خود الكعوب ومنية المتعطف",10,"ف",1,0],["هي غرس ذاك الملجأ الخيري الذي","فيه لذي الإعواز أيسر مورد",11,"د",1,0],["هي غادة سلبت قليب كئيبها","قد رصعت درر الحيد فضائله",12,"ل",2,0],["هي غادة تختال في ديجورها","بين المنابر في سنا إنسان",13,"ن",1,0],["هي غادة تختال في ديجورها","تسطو على العشاق بالتيهان",13,"ن",1,0],["هي غيبَةٌ ضمنَ الحِجابِ لغافِلٍ","ووراءها بعدَ المَماتِ لِقاءُ",14,"ا",2,0],["هي غادة بثيابها الخضراء قد","ماست تقربها عيون الرائي",15,"ا",2,0],["هي غصن دَوحة آل عثمان الأُلَى","شادوا فخاراً ليس بالمتهدمِ",16,"م",1,0],["هي غاية الآمال شتى سبْلُها","طوبى لمن جعل السلام سبيلا",17,"ل",2,0],["هِيَ غيرُ كلِ الأرضِ أرضُكَ","لمْ تدَعْ لِفمٍ سُؤالا",18,"ل",2,0],["هي غارة لكنها","دارت على رأس المغير",19,"ر",1,0],["هي غصن أم كثيب أم نقا","أم هلال أم مهاة أم ظبي",20,"ي",1,0],["هي غيظُ الحسود لم تجل إلاَّ","زادَ أهلُ الكمالِ فيها ابتهارا",21,"ر",2,0],["هي غزلان النقا سحبت","أم جوارى الحى غزلان",22,"ن",1,0],["هي غاية الغَرَض الذي يرقى لها","مُتَطاوِلاً من ذاته المُتَطاوِلُ",23,"ل",1,0],["هي غيرُ التي عرفنا وكانت","تتغنى لنا كما نتغنى",24,"ن",2,0],["هي غادة برزت جمالا واختفت","لطفاً وزفت في الوجود ببرقع",25,"ع",1,0],["هي غابة أخنى بها أسد الشرى","فاغتال منها من بها يستأسد",26,"د",1,0],["هي غرّة ميمونة بزكائها","تجلى بطلعتها الهموم فتنجلي",27,"ل",2,0],["هي غادةُ لو شامها بدرُ الدُجى","لسعى إليها من ذرى عليائِهِ",28,"ا",3,0],["هِيَ غُصْنٌ في رَوْضَةِ الحُسنِ مَياسٌ","تَلَقَّى الدَّلاَلَ عن عِطْفَيْها",29,"ي",3,0],["هي غمد لذي فقار بطين","من سيوف الله العلي صقيل",30,"ل",1,0],["هي غيث لكل عام محيل","جئت أشكو اليه بثي وحزني",30,"ي",1,0],["هي غاب ثوى به أسد ال","له علي بصدر أشرف غيل",31,"ل",1,0],["هي غربة الأرواح مذ وقع الهوى","وهوى فؤادٌ عن هواه غريبُ",32,"ب",1,0],["هي غادة تبدي لعاني حبها","ألحاظ غزلان وفتك أسودِ",33,"د",1,0],["هي ..غادةُ الرَّبعِ الفسيحِ .. تأنَّقتْ ..","سرُّ الأناقةِ بالإباءِ .. مصونُ",34,"ن",1,1],["هي غُصَّةُ المسجونِ إذ رُصِفِتْ","في مُقلتَيهِ موائدُ الصُّوَرِ",35,"ر",1,0],["هي غادةٌ رقصَ البيانُ لحسنِها","ألَقًا، وطَافَ الحبُّ بالألوانِ",36,"ن",1,0],["هي غربة طالت وطال زمانها","كالنار تسعر في الحشا تكويه",37,"ي",2,0],["هي غيرةٌ تجتاحُنا حتى إذا","تطغى بنا...ما إن تكادُ تغيضُ",38,"ض",1,1],["هي غيرةٌ... موجُ البحارِ بوسْطِها","إنّ البحارَ ( منَ الغيورِ ) تفيضُ",38,"ض",1,0],["هي غيرةٌ تودي بنا...فكأنَّها","نابٌ على جسدِ الفؤادِ عضوضُ",38,"ض",1,0],["هي غيرةٌ لا تنتهي خطواتُها","فيراضُ فيها القلبُ...وهي تروضُ",38,"ض",1,0],["هيَ غربةٌ حمقاءُ قد سلبتْ","منكَ الشبابَ فعدتَ تُبكيهِ",39,"ي",2,0],["هي غفوةٌ قد تنتهي سكراتُها","ولسوفَ يصحو الغافلونَ الهجَّدُ",40,"د",1,0],["هِيَ غُنْوَةٌ كُتِبَتْ بِقَلْبِي لَحْنُهَا","شَوْقُ الْحَنَايَا نَغْمَةٌ لَمْ تُسْمَعِ",41,"ع",1,0],["هي غير حتى لو زعل مني الغير","ما غيرها لو غيرها جا ب اثرها",42,"ر",3,0],["هِيَ غَادَةُ الغَادَاتِ دُوْنَ مُنَازِعٍ","وقلوبُ أَرْبَابِ الهَوى خُطَّابُ",43,"ب",1,0],["هي غادة الغادات دون منازع","فيها المحاسن كلها محوية",44,"ي",2,0],["هي غيمةٌ.. قد مسّ برقٌ جفنها","فبكت.. لتشعل بالربيع حقولا",45,"ل",2,0],["هي غيّرت مني نواميسي وما","أبقت على فتر من الأفتار",46,"ر",1,0]]}