{"poems":[[95,"دع الخمر نصح أخ إنها","https://www.aldiwan.net/poem11112.html","المتقارب"],[68,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[46,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[164,"سطوت بسلطان الجمال على الصب","https://www.aldiwan.net/poem58871.html","الطويل"],[287,"أسامة قد سموت على البرايا","https://www.aldiwan.net/poem32300.html","الوافر"],[374,"قدمت فلم أترك لذي قدم حكما","https://www.aldiwan.net/poem4315.html","الطويل"],[385,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[408,"لخالقنا سبحانه الحل والعقد","https://www.aldiwan.net/poem46991.html","الطويل"],[422,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[520,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48727","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64470","الطويل"],[1425,"","https://poetry.dctabudhabi.ae/diwan/poem/124279","الوافر"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89627","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27986","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27525","الرجز"],[2298,"","https://poetry.dctabudhabi.ae/diwan/poem/203466","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201069","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89069","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110005","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109981","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132156","الوافر"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115315","الطويل"],[5110,"تعظيم .. سلام","https://www.poetsgate.com/ViewPoem.aspx?id=49634",""]],"verses":[["تُعَظِّمُ عَنْ سَفَهٍ نَفْعَها","وَتَرْفَعُ مِنْ ضَعَةٍ شَأْنَهَا",0,"ن",3,0],["تُعَظَّمُ قَدرَ كُلَّ سَليمِ طَبعٍ","وَتُصغِرُ قَدرَ أَهلِ الكِبرِياءِ",1,"ا",2,0],["تَعَظَّمتَ عَن ذاكَ التَعَظُّمِ مِنهُمُ","وَأَوصاكَ نُبلُ القَدرِ أَلّا تَنَبَّلا",2,"ل",2,0],["تُعظِّمُ من شكر الصديق حقيره","وتَحقرُ من جدواك غير حقير",3,"ر",1,0],["تعظم دين الله بالسعي مخبتاً","لسنة عيد الفطر بالذكرِ للربِّ",4,"ب",1,0],["تُعَظِّمُهُ المُلوكُ بِكُلِّ عَصرٍ","كَأَنَّهُمُ لَهُ فيهِ رَعايا",5,"ا",3,0],["تعظَّم إِلا عن عظيم مخلَّد","يعظّم ما فيه من الحكمة العظمى",6,"م",2,0],["تَعظيمُهُ العلم عَن فَضل وَمَعرِفَة","ما عظم العلم إِلّا مَن بِهِ خَطَرُ",7,"ر",1,0],["تُعَظِّمُ ربَّ العَرشِ جلّ جلالُه","وتعلَمُ أنّ الله ليسَ له نِدّ",8,"د",1,0],["تعظّمه الخطوب ويزدَريها","وليسَ له بمعظمها احتفال",9,"ل",1,0],["تعظم عند نفسها","وقدرها محتقر",10,"ر",1,0],["تعظ الحجيج مؤلِّفاً وموفقاً","وتوحد الآمال والأفكارا",11,"ر",2,0],["تعظمت يا حق الربوبية التي","تجلت بقهر واقتدار ورحمة",12,"ه",1,0],["تعظمه الأباعد والأقاصي","تسالمهُ العقارب والافاعي",13,"ع",2,0],["تُعَظَّمُ نَدوَتي فيهم وأَثني","مودَّتَهم بأَخلاقٍ رِماقِ",14,"ق",1,0],["تعظيمُ ربِّكَ في تعظيمِ ما شرعا","فاصدع فإنَّ سعيدَ القومِ من صدعا",15,"ع",2,1],["تعظيمه منزَّه مقدَّس","من كلِّ ما يحدثه دور الفلكْ",16,"ك",1,0],["تعظيم أمر الله جل جلاله","والسعى في إصلاح ذات البين",17,"ن",1,0],["تعظيمنا الشخصَ يهوى بالعقول الى ال","حضيض حتى على التمييز لا يُبقي",18,"ي",1,1],["تعظيمهم فرضٌ على من له","سيادة برغم أهل العناد",19,"د",1,0],["تعظَّمت واستَرَقَت","بالنجهِ والمُصالَقه",20,"ق",2,0],["تعظمت بُرهةً لكنَّها اندرست","واصبحَ الكُفرُ فيها شرَّ مندرسِ",21,"س",1,0],["تعظّم بي من الآداب قدراً","ستعلم بالذي صنعت معد",22,"د",1,0],["تُعَظِمُه الأوهامُ قبلَ عِيانهِ","ويَصدُر عنه الطَرفُ والطرفُ حاسِرُ",23,"ر",1,0],["تعظيم.. سلام يا وطن","يا أعظم الألقاب",24,"ب",1,1],["تعظيم .. سلام يا وطن","للى بيصون التراب",24,"ب",1,0],["تعظيم .. سلام يا وطن","للى عمره ما غاب",24,"ب",1,0]]}