{"poems":[[86,"لله آثار هناك كريمة","https://www.aldiwan.net/poem10679.html","الكامل"],[93,"أمرتني وبهذا الأمر تسعدني","https://www.aldiwan.net/poem11261.html","البسيط"],[88,"نعمت الدار للنفيض دارا","https://www.aldiwan.net/poem44999.html","الخفيف"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[85,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[85,"هل تهبط النيرات الأرض أحيانا","https://www.aldiwan.net/poem63732.html","الطويل"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[100,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[116,"يا غائبا في القلب حاضر","https://www.aldiwan.net/poem41074.html","عموديه"],[170,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[199,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[200,"كفى صدودا فما أبقى تجافينا","https://www.aldiwan.net/poem45565.html","البسيط"],[230,"هممي أنافت بي على الهمم","https://www.aldiwan.net/poem50827.html","أحذ الكامل"],[255,"في الهوى لست وحدي","https://www.aldiwan.net/poem25017.html","مجزوء الرمل"],[276,"ضن السماح عليه بالترحال","https://www.aldiwan.net/poem25539.html","الكامل"],[283,"هل شرب البان شمولا فمال","https://www.aldiwan.net/poem32636.html","السريع"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[378,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[459,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[539,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[552,"هل شافع لي إلى نعم وسيلتها","https://www.aldiwan.net/poem47879.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["هَل شِدتَ في بِرلينَ غَيرَ مُعَسكَرٍ","قامَت عَلَيهِ مَعاقِلٌ وَحُصونُ",0,"ن",1,0],["هَلْ شَاعِرُ القَوْمِ إِلاَّ صَادِحٌ غَرِدٌ","إِنْ شَاقَهُ فَنَنٌ غَنَّى عَلَى الفَنَنِ",1,"ن",1,0],["هل شددنا الرحال في الأرض للأس","فار إلا لنكتُب الأسفارا",2,"ر",2,0],["هل شجاع القوم إلا شجاعٌ","أبداً ينساب فيه شجاع",3,"ع",1,0],["هل شعور الفنان الاكسيل","زاخر في واد بعيد القرار",4,"ر",1,0],["هَل شَجاكُم في ثَرى أَهرامِها","ما أَرَقتُم مِن دُموعٍ وَدِماء",5,"ا",2,0],["هَل شَيَّعَ النَشءُ رَكبَ العِلمِ وَاِكتَنَفوا","لِعَبقَرِيَّةٍ أَحمالاً وَأَظعانا",6,"ن",2,0],["هل شَجَاهم أنَّنا شعبٌ صحا","من كَرَاهُ بعد أن طال كراهْ؟",7,"ا",2,0],["هَلْ شَمَّتْ نَافِذَةٌ شَبَحَاً","يُقْرِيْ خَبَرَاً، أَوْ يَسْتَقْرِيْ؟",8,"ر",2,0],["هل شمت ضوءا لم يكن","لغلاغل الظلمات صائر",9,"ر",1,0],["هَل شَدَّ عَقدَ التاجِ بَعدَ مُقَدَّمٍ","إِلّا فَتى قَومي وَسِلكُ نِظامي",10,"م",2,0],["هل شيَّدَ العلياءَ إلا فتىً","راقَ به المَحْفَلُ والمركبُ",11,"ب",1,0],["هل شاغلتكِ عواد ما تشاغلنا","وباتَ يلهيكَ أنسٌ ليسَ يلهينا",12,"ن",2,0],["هل شُمُّ أطوادِ الجبال سِوَى","حِلْمي وهل عَضْبٌ سِوى كَلِمي",13,"م",2,0],["هل شُغِلتِ اليوم عني","أم ترين الأمر سهلا",14,"ل",2,0],["هَلْ شَرْبَةٌ مِنْ أَبْحُرِ الجَدْوَى سِوَى","ثَمَدٍ يَفِيضُ لِرَأسِ كُلِّ هِلالِ",15,"ل",1,0],["هَل شَرِبَ البانُ شَمولاً فَمال","أَم هَزَّهُ مُرُّ نَسيمِ الشَمال",16,"ل",1,1],["هَل شافِعٌ في زَمَني بِمِثلِها","فَإِنَّها وَتَرُ المَدى الَّذي غَبَر",17,"ر",1,0],["هل شقوتي تُفضي إلى هذا العمى","حتى إِخالَ النورَ كالظلماء",18,"ا",2,0],["هل شَعَرٌ بُدِّلتُهُ بِشَعَرٍ","مُبدِّلِي من أربٍ لي أربا",19,"ب",2,0],["هل شِمتَ يا حَميمي","بَدراً مِن النجُوم",20,"م",1,0],["هَلْ شافعٌ لِي إلى نَعْمٍ وسيلتُها","وَلا وَسيلةَ إلّا السَّقْمُ والجُهُدُ",21,"د",1,1],["هل شهد الذين ضمت طيبة","فضلا عن الذين هم بالغيبة",22,"ه",1,0]]}