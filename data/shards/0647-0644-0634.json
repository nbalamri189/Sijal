{"poems":[[88,"لله آثار هناك كريمة","https://www.aldiwan.net/poem10679.html","الكامل"],[95,"أمرتني وبهذا الأمر تسعدني","https://www.aldiwan.net/poem11261.html","البسيط"],[90,"نعمت الدار للنفيض دارا","https://www.aldiwan.net/poem44999.html","الخفيف"],[53,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[91,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[87,"هل تهبط النيرات الأرض أحيانا","https://www.aldiwan.net/poem63732.html","الطويل"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[119,"يا غائبا في القلب حاضر","https://www.aldiwan.net/poem41074.html","عموديه"],[173,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[203,"كفى صدودا فما أبقى تجافينا","https://www.aldiwan.net/poem45565.html","البسيط"],[234,"هممي أنافت بي على الهمم","https://www.aldiwan.net/poem50827.html","أحذ الكامل"],[259,"في الهوى لست وحدي","https://www.aldiwan.net/poem25017.html","مجزوء الرمل"],[280,"ضن السماح عليه بالترحال","https://www.aldiwan.net/poem25539.html","الكامل"],[287,"هل شرب البان شمولا فمال","https://www.aldiwan.net/poem32636.html","السريع"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[543,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[556,"هل شافع لي إلى نعم وسيلتها","https://www.aldiwan.net/poem47879.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87194","البسيط"],[1113,"","https://poetry.dctabudhabi.ae/diwan/poem/101183","البسيط"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73495","الرمل"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104404","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78016","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127989","الخفيف"],[1757,"","https://poetry.dctabudhabi.ae/diwan/poem/203605","السريع"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104815","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53218","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110627","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101814","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100353","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58260","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200787","البسيط"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79719","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126256","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82813","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114377","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102956","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86362","السريع"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36513","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36418","الدوبيت"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97079","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94580","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83135","المديد"],[4755,"اصفَع قَفَاكَ بلعنةٍ يا هادي","https://www.poetsgate.com/ViewPoem.aspx?id=209001",""],[4830,"بين جدران الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=195193",""],[4852,"هل شيء يخفي بالفتاة حنينها","https://www.poetsgate.com/ViewPoem.aspx?id=214694",""],[4980,"أشتَاقُهَا","https://www.poetsgate.com/ViewPoem.aspx?id=191089",""],[585,"تحية تملأ الدنيا وتمجيد","https://www.poetsgate.com/ViewPoem.aspx?id=161886",""],[5106,"لا تَقُلْ لِيْ قَدْ تَعِبْنَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150039",""],[5120,"معركة وادي أنوال الخالدة","https://www.poetsgate.com/ViewPoem.aspx?id=185808",""],[5185,"الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=70900",""],[5271,"قد خاب ظني","https://www.poetsgate.com/ViewPoem.aspx?id=65380",""],[5363,"رثاء الشيخ البروفسور إبراهيم الكندي","https://www.poetsgate.com/ViewPoem.aspx?id=199950",""],[5672,"يا غيم","https://www.poetsgate.com/ViewPoem.aspx?id=206504",""],[402,"أمرتني وبهذا الأمر تسعدني","https://www.poetsgate.com/ViewPoem.aspx?id=36476",""],[5829,"بالعشقِ أغراني","https://www.poetsgate.com/ViewPoem.aspx?id=214655",""],[5956,"شكراً غفرتِ تطاولي الهمجِيَّا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181976",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""]],"verses":[["هَل شِدتَ في بِرلينَ غَيرَ مُعَسكَرٍ","قامَت عَلَيهِ مَعاقِلٌ وَحُصونُ",0,"ن",1,0],["هَلْ شَاعِرُ القَوْمِ إِلاَّ صَادِحٌ غَرِدٌ","إِنْ شَاقَهُ فَنَنٌ غَنَّى عَلَى الفَنَنِ",1,"ن",1,0],["هل شددنا الرحال في الأرض للأس","فار إلا لنكتُب الأسفارا",2,"ر",2,0],["هل شجاع القوم إلا شجاعٌ","أبداً ينساب فيه شجاع",3,"ع",1,0],["هل شعور الفنان الاكسيل","زاخر في واد بعيد القرار",4,"ر",1,0],["هَل شَجاكُم في ثَرى أَهرامِها","ما أَرَقتُم مِن دُموعٍ وَدِماء",5,"ا",2,0],["هَل شَيَّعَ النَشءُ رَكبَ العِلمِ وَاِكتَنَفوا","لِعَبقَرِيَّةٍ أَحمالاً وَأَظعانا",6,"ن",2,0],["هل شَجَاهم أنَّنا شعبٌ صحا","من كَرَاهُ بعد أن طال كراهْ؟",7,"ا",2,0],["هَلْ شَمَّتْ نَافِذَةٌ شَبَحَاً","يُقْرِيْ خَبَرَاً، أَوْ يَسْتَقْرِيْ؟",8,"ر",2,0],["هل شمت ضوءا لم يكن","لغلاغل الظلمات صائر",9,"ر",1,0],["هَل شَدَّ عَقدَ التاجِ بَعدَ مُقَدَّمٍ","إِلّا فَتى قَومي وَسِلكُ نِظامي",10,"م",2,0],["هل شيَّدَ العلياءَ إلا فتىً","راقَ به المَحْفَلُ والمركبُ",11,"ب",1,0],["هل شاغلتكِ عواد ما تشاغلنا","وباتَ يلهيكَ أنسٌ ليسَ يلهينا",12,"ن",2,0],["هل شُمُّ أطوادِ الجبال سِوَى","حِلْمي وهل عَضْبٌ سِوى كَلِمي",13,"م",2,0],["هل شُغِلتِ اليوم عني","أم ترين الأمر سهلا",14,"ل",2,0],["هَلْ شَرْبَةٌ مِنْ أَبْحُرِ الجَدْوَى سِوَى","ثَمَدٍ يَفِيضُ لِرَأسِ كُلِّ هِلالِ",15,"ل",1,0],["هَل شَرِبَ البانُ شَمولاً فَمال","أَم هَزَّهُ مُرُّ نَسيمِ الشَمال",16,"ل",1,1],["هَل شافِعٌ في زَمَني بِمِثلِها","فَإِنَّها وَتَرُ المَدى الَّذي غَبَر",17,"ر",1,0],["هل شقوتي تُفضي إلى هذا العمى","حتى إِخالَ النورَ كالظلماء",18,"ا",2,0],["هل شَعَرٌ بُدِّلتُهُ بِشَعَرٍ","مُبدِّلِي من أربٍ لي أربا",19,"ب",2,0],["هل شِمتَ يا حَميمي","بَدراً مِن النجُوم",20,"م",1,0],["هَلْ شافعٌ لِي إلى نَعْمٍ وسيلتُها","وَلا وَسيلةَ إلّا السَّقْمُ والجُهُدُ",21,"د",1,1],["هل شهد الذين ضمت طيبة","فضلا عن الذين هم بالغيبة",22,"ه",1,0],["هَل شَمسُ حسنٍ تَجلت في مَغانيها","أَم رَوضةٌ أَينَعَت تَدنو مَجانيها",23,"ي",3,1],["هل شبه السيف يوماً بالعصا أحد","أو قاس يوماً بصافي اللؤلؤ الصدفا",24,"ف",2,0],["هَل شَكَوتُم مِن سقامٍ","أَو جَلَسنا لِلصحاحِ",25,"ح",1,0],["هل شملنا بعد التفرق جامع","فأرى بعيد الوصل غير بعيد",26,"د",1,0],["هل شمت بارق جنة في سوحها","لك جيرة وكواعب أتراب",27,"ب",1,0],["هل شعار الكرام ان وقف السا","ئل مستجديا يرد ويطرد",28,"د",1,0],["هل شاهدت عيناك من عاشق","هداه قلبي مثل هذا الكلام",29,"م",1,0],["هَل شافٍعٌ تَرتَجِيهِ إِلاّ","مَولَى المَوَالِى هَوَ المُجِيبُ",30,"ب",1,0],["هل شجى الوُرْق على أفنانها","ذكر نجد وهوى كثبانها",31,"ه",2,1],["هل شرفت بمحمد أرخ بلى","شرفت مناسك حجها بمحمد",32,"د",1,0],["هل شاهداك مجاهداً هل شاهدا","ك مجدلا هل شاهداك محطما",33,"م",2,0],["هل شاهدت بالطف مهرك طالبا","خيم النسا بادي الصهيل محمحما",33,"م",2,0],["هل شاقك ابن الطوق يوم تحملو ال","حي الحلال به ابنة الاطواقِ",34,"ق",1,0],["هل شاهدوا من قبل ذلكَ جمعةً","طلعت عليهم بالقتال خَميسا",35,"س",2,0],["هل شبت يا دهر حتى صرت ذا خرف","أو لم يزل عقلك المعهود عقل صبي",36,"ب",2,0],["هل شيعوك كما يشيع طفلهم","أم هل بكتك قرائح الشعراء",37,"ا",2,0],["هل شمت من نحو الأحبة بارقا","مبتسما يخفى سناه ويظهر",38,"ر",1,0],["هل شِمتَ مِنّي ما حَدا لست بِآثم","حاشايَ آتى ما تَراهُ يَعيبُ",39,"ب",1,0],["هل شِمتَ فيهِ غيرَ قابضِ لِمَّةٍ","أو قارعاً أسنانهُ في خَمسِهِ",40,"س",2,0],["هل شهدت الجيش في هول الفرار","أو رأيت الطير راعتها الديِم",41,"م",1,0],["هل شمتَ أحسنَ من حسينٍ زاره","حسنٌ أخوهُ مؤنساً يا ما افخما",42,"م",2,0],["هل شغل أفئدة العوالم كلها","وبسرها وجدوا المقيم المقعدا",43,"د",2,0],["هل شاقك الحي الذي شاقني","حلوا بأعلى رمل نعمان",44,"ن",1,0],["هَل شُدَّ نِطاقُه بحقويهِ يُناط","إِلّا وَعَلى الرؤوسِ تاه الأَوساط",45,"ط",1,1],["هَل شُقَّ جُيوبُ هَذِهِ الأَزهارِ","إِلّا طَرَباً لِنَغمَةِ الأَطيارِ",46,"ر",1,1],["هل شفها فتك الردى بأحبةٍ","كانوا ليومٍ كريهة أسد الشرى",47,"ر",2,0],["هل شيمت النار في الأفلاك مسعرةً","من دون امداد اسعارٍ يساعرهُ",48,"ر",2,0],["هَل شَفى بَعضَ الَّذي أَجِدُ","طارِقٌ مِن بَعدِ ما رَقَدُوا",49,"د",3,1],["هل شَارَكَ الإعدادُ في تَسخيرِهِم؟","أَم بَالَغَ الصّاروخُ بالأَعدادِ؟!",50,"د",1,0],["هل شطَّ بي قدري فأوردني الشجى","أم عادَ قيدُ السجنِ والسّجّانِ",51,"ن",1,0],["هل شيء يُخفي بالفتاة حنينها","لو بات في أحماضها النوويهْ!؟",52,"ي",2,0],["هَل شَاهَدَت نُورٌ فَتًى إن مَضَى","أسقَى الجَوَى كَأسًا مِنَ التَّوقِ",53,"ق",1,0],["هل شد مثلك أزر العرب من رجلٍ","محض الرجولة فيه البأس والجود",54,"د",1,0],["هَلْ شَرِبْنَاْ الماْءَ مِنَّاْ وارْتَوَيْنَاْهُ زُلالْ","هَلْ فَتِيْتُ الشُّهْدِ فُتَّتْ فِيْ يَدِيْ أَوْ مَاْءُ سَالْ",55,"ل",1,0],["هَلْ شَيَاطِينٌ فَوْقَهَا،أَمْ رُجُومٌ","حَامَ مِنْ حَوْلِهَا الرَّدَى،وَ اسْتَطَالَا؟",56,"ل",2,0],["هل شيعوك وصمتهم متثاقل ؟","أم شيعوك وكلهم شعراء؟",57,"ا",2,0],["هَلْ شَوقُنَا أَضحى سَرَابًا","أَمْ قَطرةً منْ سيلِ مُزنِ؟",58,"ن",1,0],["هل شاهدت عيناك خطبا نازلا","يذر العيون كما الغمام هواطلا",59,"ل",2,1],["هل شاقكَ الملقى وقد برقتَ","تشكو النوى للروض والحجرِ",60,"ر",1,0],["هل شاعر القوم غلا صادح غرد","إن شاقه فنن غنى على الفنن",61,"ن",1,0],["هل شفًّك الوجدُ أم في بحرِهِ غرقَتْ","فيكَ المراكبُ حتى قلتً أغواني",62,"ن",2,0],["هل شاعرٌ إلا لديه جِنّةٌ","ما إن يرى فتّانة يتهيّا؟..",63,"ي",2,0],["هل شَهِدْتَ الجَحْشَ يوماً راكباً من","فَوْقِهِ الحَمَّارُ بالسَّيْرِ الوئيدِ ؟",64,"د",1,0]]}