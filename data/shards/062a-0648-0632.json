{"poems":[[55,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[93,"ما طائر كان فيبيداء موحشة","https://www.aldiwan.net/poem62778.html","عموديه"],[46,"وراءك عن شاك قليل العوائد","https://www.aldiwan.net/poem30605.html","الطويل"],[107,"نفرن أصيلا كسرب المها","https://www.aldiwan.net/poem43157.html","المتقارب"],[107,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[111,"بصائرنا في القضا خامدة","https://www.poetsgate.com/ViewPoem.aspx?id=522",""],[93,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[203,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[302,"أما والهوى حلفا ولست بحانث","https://www.aldiwan.net/poem33311.html","الطويل"],[543,"وأبيض بلورى لون تخاله","https://www.aldiwan.net/poem47542.html","عموديه"],[556,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48667","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48757","البسيط"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/204353","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204446","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205003","الوافر"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140311",""],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[5123,"التجار","https://www.poetsgate.com/ViewPoem.aspx?id=23978",""],[5190,"فاقرأني على مهل","https://www.poetsgate.com/ViewPoem.aspx?id=129791",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""]],"verses":[["تَوَزَّعَ لَحمي في عَواجِمَ جَمَّةٍ","وَبانَ عَلى جَنبَيَّ وَسمُ التَجارِبِ",0,"ب",1,0],["تُوَزِّعُ صُرّادَ الشَمالِ جِفانُهُم","إِذا أَصبَحَت نَجدٌ تَسوقُ الأَفائِلا",1,"ل",2,0],["تُوَزِّعُ السِحرَ شَطراً في مَغارِسِها","وَآخَرَ في لِحاظِ الخُرَّدِ العينِ",2,"ن",1,0],["تَوَزَّعَ بَينَ النَجمِ وَالدَمعِ طَرفُهُ","بِمَطروفَةٍ إِنسانُها غَيرُ راقِدِ",3,"د",1,0],["تَوَزَّعنَ أَشطارَ هَذا الفُؤادِ","فَشَطرٌ هُناكَ وَشَطرٌ هُنا",4,"ا",1,0],["تَوزّعوه فلو أبصرتَ مَصرعَهُ","أبصرتَ في اللّهِ منه مَنظراً عجبا",5,"ب",2,0],["تؤز الصياخيد أهوالها","فما بال أكبادنا الكابده",6,"د",2,0],["توزّع السحر شطرا في مغارسها","ولآخر في لحاظ الخرّد العين",7,"ن",1,0],["تَؤُزُّهُ كبِدٌ حرَّىن مُعَلَّقَةٌ","من الاضالع في اعوادِ نيرانِ",8,"ن",1,0],["توزَّعَ قَلبي بين خَدٍّ مُضرَّجٍ","وَجَفنٍ كَليلِ الطَرفِ بالسِحر نافِثِ",9,"ث",1,0],["تُوزِّعُ فيما بينَكم نَظراتِهَا","فَتدرِكُ أنَّ الكُلَّ منكُم أخو عِشقِ",10,"ق",1,0],["توزّعَهُ عَبْرُ الرّبا فكأنّهُ","مُلاءٌ رحيضٌ بالفَلاةِ مُطرّحُ",11,"ح",1,0],["توزَّع قلبي حبُّكم وهو غالبٌ","وحقدٌ على أعدائكم يتسعَّر",12,"ر",1,0],["توزعتنيَ آمالٌ هنالك في","أسر الليالي وآلام تزيد هنا",13,"ن",2,0],["توزعوا الدولة والملك وال","حضرة والإسلام والدنيا",14,"ن",3,0],["توزع عطفيها كثيب وبانة","وحل بجفنيها غزال وضيغم",15,"م",1,0],["توزع لمحتي للأفق ليلاً","لزهر الأفق ألف هوى مقيم",16,"م",1,0],["توزع فيك قلبي دون حد","لما تحوين من حسن عميم",17,"م",1,0],["توزعوها كما يهوون فامتلكوا","شطراً وشطر غدا ملكاً لصهيون",18,"ن",1,0],["توزَّعوا منزعين العجز وانتزعوا","باعلزبوبَ وعدواهُ بعزمهمِ",19,"م",1,0],["توزعوا منزعين العجز وانتزعوا","باعِلزَبولاً وعزَّتهُ بعزمهم",20,"م",1,0],["توزعوا في فِجاجِ الأرضِ يرفِدُهم","عَزمُ النبيينَ إذْ صاروا حواريهِ",21,"ي",2,0],["توزنها تطلع بسعر اللحم ف الأقاليم","ولمونه واحده بشلم / خضره تقول برسيم",22,"م",1,0],["تُوَزِّعُ العِطرَ أَنوَاراً عَلَى أُفُقٍ","رَحبٍ ، بِسَاحَتِهِ خَيلُ الرُّؤَى تَعدُو",23,"د",2,0],["تؤزُّ عليه مَنْ يُغريهِ برقٌ","من الآمالِ، يعصِرُها ضنينا",24,"ن",2,0]]}