{"poems":[[74,"أي شيء يا سيدي يبلغ النا","https://www.aldiwan.net/poem20208.html","الخفيف"],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[119,"للنبي صاحب البراق نحا","https://www.aldiwan.net/poem42007.html","المديد"],[173,"أيدي الحوادث في الأيام والأمم","https://www.aldiwan.net/poem1667.html",""],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[458,"خادم آمر كفيل بكتبي","https://www.aldiwan.net/poem61301.html","الخفيف"],[580,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136211","الخفيف"],[1296,"","https://poetry.dctabudhabi.ae/diwan/poem/178093","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137956",""],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77438","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130751","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93907","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93827","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94305","الخفيف"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136974",""],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9617","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85083","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123503","المديد"],[4935,"إن باري الخلق غافر","https://www.poetsgate.com/ViewPoem.aspx?id=129274",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5205,"أي عين بت محتجباً","https://www.poetsgate.com/ViewPoem.aspx?id=120997",""]],"verses":[["وهو ذو حافرٍ يسير ويسري","كلّ وقت وليس كالحيوان",0,"ن",1,0],["وهو ذا العِرضُ فهل تبغي وقاةً","مثلَهم أو مثل ذا تبغي وقاء",1,"ا",2,0],["وهو ذخري في الخطوب ولي","خير مأمول ونعم ولي",2,"ل",2,0],["وَهَوذَةَ بنَ عَلِيٍّ حَطَّ مُنتَزِعاً","عَن رَأسِهِ التاجَ عَمداً غَيرَ مُحتَشِمِ",3,"م",1,0],["وهْو ذو ألسُنٍ ولكنَّه أَخْ","رَسُ إلاّ ما استَنْطقَتْه اليَدان",4,"ن",1,0],["وهو ذاك العفيف لا شيء يرضاه","سوى نفع غيره دون كسب",5,"ب",1,0],["وهْوَ ذِئْبٌ إِن حَضَرْتُ وإِن","غِبْتُ عنه صار كَالأَسد",6,"د",1,0],["وهو ذخري وعدتي واعتمادي","وشفيعي إليك والمستجار",7,"ر",1,0],["وهو ذو الفضائل والمعالي قدره","والجود موطنه وفيه يُخلَّدُ",8,"د",1,0],["وهو ذيَّالك المشار اليهِ","أنهُ الطفُ الورى بالبنانش",9,"ن",2,0],["وَهوَ ذاكَ النَبِيُّ يَسأَلُ في الإِن","جيلِ يَحيى عَنهُ فَأَينَ الخَفاءُ",10,"ا",2,0],["وهو ذكرى عهد ماض شائق","من حياة أومضت كالبارق",11,"ق",1,0],["وهو ذو المجد أحمد الأزبكاوي","يُ الهمام الذي حماه يهاب",12,"ب",1,0],["وهو ذو نهى وأمر","والعلى تنهى وتؤمر",13,"ر",1,0],["وهو ذو عفة وزهد وتقوى","وصلاح وفعل خير وطاعات",14,"ت",1,0],["وهو ذو العزم والمضاء وذو","الفضل المرجى والهمة الشماء",15,"ا",2,0],["وَهَوذَةَ نَجّى بَعدَ ما مالَ رَأسُهُ","يَمانٍ إِذا ما خالَطَ العَظمَ مِخدَبُ",16,"ب",1,0],["وهو ذكر الحبيب خير البرايا","من سما في الأنام شكراً وحمدا",17,"د",2,0],["وهو ذلول بيّن المذله","والذُلّ والذلة قالوا مثله",18,"ه",1,0],["وهو ذو نفس رميت بها","في الردى منها القوى درسا",19,"س",2,0],["وهو ذو فضل جزيل","وندى جدواه وافر",20,"ر",1,0],["وهو ذو عيلة وفيها فتي","وفتاة ومرضع وفطيم",21,"م",1,0],["وهو ذو وشوق لشهدته","يحتسي منها الذي عذبا",22,"ب",2,0]]}