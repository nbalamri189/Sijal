{"poems":[[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[354,"ما الحكم في الناس إلا","https://www.aldiwan.net/poem15886.html","المجتث"],[500,"وشاكية تكذب تئن ولا تتعب","https://www.aldiwan.net/poem9771.html","مجزوء المتقارب"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117767","السريع"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135729","الرجز"],[4764,"اضربه في مقتلن ثم اكسره","https://www.poetsgate.com/ViewPoem.aspx?id=34053",""],[5573,"ياخيال البرق","https://www.poetsgate.com/ViewPoem.aspx?id=200318",""],[5749,"يا طاري الجفا","https://www.poetsgate.com/ViewPoem.aspx?id=29661",""],[5776,"حربُ الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=207245",""]],"verses":[["مُؤَخَرُها في الحُسنِ مِثلُ المُقدَمِ","يَظُنُّها الطَيرُ لَهُ نَطعَ الدَمِ",0,"م",1,0],["مؤخر أخر ركب ضدي عن المنى","ويا أول اختم لي بحسن أنتها عمري",1,"ر",2,0],["مُؤَخِّرَ فيهِ ما","حَثَّهُ عَلى تَقديمِه",2,"م",2,0],["مؤخرها محرج","مقدَّمها سبسبُ",3,"ب",1,0],["مؤخرُها والعنقُ قد أوقعا","قلبَ الأعادي في العريضِ الطويل",4,"ل",1,0],["مُؤَخَّرُ المَجلِسِ مِثلُ صَدرِهِ","لِمَن صَفا فِي الفَضلِ نُورُ بَدرِهِ",5,"ه",1,0],["مؤخِّرٌ محيي مميتُ منتقمْ","أخِّرْ عِدايَ منهمْ ربي فانتقمْ",6,"م",1,0],["مؤخرٌ يا أولٌ يا آخرُ","يردُّ عنّي بك رب الجائرُ",7,"ر",1,0],["مو خطاي ان كان لي قلبٍ ندي","كم تمنى الخير كم هو يبذره",8,"ر",2,0],["موخره رعاد يرجف من صداه المقدم","وارتخت من فوق روس النايفات امزونه",9,"ه",1,0],["مو خابر شلون اخفي وشلون صروفي","جار علي هواه وحد الله بينه وبيني",10,"ن",2,0],["مؤخرة البوارج إن رأته","فما تدري أتهرب أم تبولُ",11,"ل",1,0]]}