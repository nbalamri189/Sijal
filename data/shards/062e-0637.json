ابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"الى الخاتون المسبل","https://www.poetsgate.com/ViewPoem.aspx?id=179039",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"على حدود فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179015",""],[90,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[45,"يا عَارِضاً مُتَلَفّعاً بِبُرُودِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31608",""],[45,"للهِ ما تَصْنَعُ الأَجْيادُ والمُقَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32071",""],[45,"أتَرَاكَ تَسْمَعُ، للحَمَامِ الهُتَّفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32843",""],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[99,"قطرة الندى","https://www.poetsgate.com/ViewPoem.aspx?id=570",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[51,"لجَّ الفؤادُ فليس يلذعه","https://www.poetsgate.com/ViewPoem.aspx?id=29595",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[20,"إِن للدهرِ صولة فاحذرنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69769&r=&rc=10",""],[85,"سَل يَلدِزًا ذاتَ القُصورِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86372&r=&rc=243",""]],"verses":[["خَطَبتُم إِلى شُمسِ الخُدورِ فَوارِكٍ","طَوالِقَ مِن حَبلِ اللِئامِ بَوائِنِ",0,"ن",1,0],["خَطَروا وَالخَمرُ تَنفُضُهُم","وَذُيولُ القَومِ أَردانُ",1,"ن",1,0],["خُطَطٌ يُجَبِّنَّ المُشَ","جَّعَ أَو يُسَفِّهنَ الحَليما",2,"م",2,0],["خُطَّةٌ إِمّا عَلاءً أَو رَدىً","مُعجِلي أَن أَقرَعَ السِنَّ النَدَم",3,"م",1,0],["خُطوبٌ لا أُجِمُّ لَها جَوادي","وَعَزمٌ لا أَحُطُّ لَهُ لِثامي",4,"م",2,0],["خَطَرٌ مِنَ الدُنيا يَجُلُّ وَسورَةٌ","تَعلو وَقَدرٌ زائِدٌ يَتَقَدَّمُ",5,"م",1,0],["خُطِمَ الأَوَّلُ وَالآ","خِرُ يَبغيهِ الخِطامُ",6,"م",1,0],["خَطِلُ المَناكِبِ لا يَميلُ بِهِ","مَوجٌ وَمِن نَعتِ القَنا الخَطَلُ",7,"ل",1,0],["خَطَوا تَحتَهُ حُمرَ الدُروعِ كَأَنَّما","تَرَدَّوا بِمَوّارِ الدِماءِ الصَوائِكِ",8,"ك",1,0],["خَطيبُ مَجمَعَةٍ تَغلي شَقاشِقُهُ","إِذا رَموهُ بِأَبصارٍ وَأَسماعِ",9,"ع",1,0],["خَطَموا أُنوفَ الخالِعينَ وَذَلَّلوا","أُمَماً مِنَ الأَعداءِ بَعدَ شِماسِ",10,"س",1,0],["خَطبٌ يُهَدِّدُني بِالبُعدِ عَن وَطَني","وَما خُلِقتُ لِغَيرِ السَرجِ وَالكورِ",11,"ر",1,0],["خَطَوتَ فيها غَيرَ مُستَكبِرٍ","خَطوَ السُها في خِلَعِ الفَجرِ",12,"ر",1,0],["خَطَوتُ وَفي كَفّي خِطامُ نَجيبَةٍ","مُدَفَّعَةٍ مِن كُلِّ قُربٍ إِلى بُعدِ",13,"د",1,0],["خَطَبتُ إِلَيكَ الوُدَّ لا شَيءَ غَيرَهُ","وَوُدُّ الفَتى كَالبِرِّ يُعطى وَيُجتَدى",14,"د",2,0],["خَطَبَتَني الدُنيا فَقُلتُ لَها اِرجِعي","إِنّي أَراكِ كَثيرَةَ الأَزواجِ",15,"ج",1,0],["خَطَونَ إِلَينا الخَيلُ وَالبيضُ وَالقَنا","فَما مَنَعَت عَنّا القَنا وَالقَواضِبُ",16,"ب",1,0],["خِطابٌ مِثلُ ماءِ المُزنِ تَبري","مَواقِعُهُ العَليلَ مِنَ القُلوبِ",17,"ب",1,0],["خُطوبٌ يُعِنَّ الشَيبَ في كُلِّ لِمَّةٍ","وَيُنسينَ أَيّامَ الصِبا وَلِعابَها",18,"ب",3,0],["خَطَبتَ شِعري إِلى قَلبٍ يَضِنُّ بِهِ","إِلّا عَلَيكَ فَباشِر خَيرَ مَخطوبِ",19,"ب",1,0],["خُطوبٌ لا يُقاوِمُها البَقاءُ","وَأَحوالٌ يَدِبُّ لَها الضَراءُ",20,"ا",2,1],["خَطَرَتْ لِذِكرِكِ يا أُمَيمَةُ خَطرَةٌ","بِالقَلبِ تَجلِبُ عَبرَةَ المُشتاقِ",21,"ق",1,1],["خُطوبٌ لِلقُلوبِ بِها وَجيبُ","تَكادُ لَها مَفارِقُنا تَشيبُ",22,"ب",1,1],["خَطا فوقَ أعناق الأعادي إِلى عُلاً","لَها بَينَ أطرافِ القَنا مَسْلَكٌ وعْرُ",23,"ر",1,0],["خَطّارَةٌ غِبَّ السُرى زَيّافَةٌ","تَطِسُ الإِكامَ بِوَخذِ خُفٍّ ميثَمِ",24,"م",1,0],["خَطَرَت فَقُلتُ قَضيبُ بانٍ حَرَّكَت","أَعطافَهُ بَعدَ الجَنوبِ صَباءُ",25,"ا",2,0],["خطْبٌ أصابَ بَني البَلاغَةِ والحِجا","شَبَّ الزّفيرُ بهِ عنِ الأطْواقِ",26,"ق",1,0],["خطَبْتُ عُلاكَ قبلَ اليوْمِ وُدّاً","بذَلْتُ منَ الوَفاءِ لهُ صَداقا",27,"ق",2,0],["خُطباءُ الأقْوالِ يوْمَ جِدالٍ","وكُماةُ الأبْطالِ يومَ الجِلادِ",28,"د",1,0],["خَطَبْناها وكانَ الأُنْسُ مَهْراً","وألْحانُ القِيانِ منَ الشُّهودِ",29,"د",1,0],["خَطْبٌ أَلَمَّ فَأَذْهَبَ الأَخَ وَالأَبَا","رَغْمَاً لأَنْفٍ شَاءَ ذَلِكَ أَوْ أَبَا",30,"ب",2,1],["خَطْبٌ تأَوَّبَنِي يَضِيقُ لِهَوْلِهِ","رَحْبُ الفَضَا وَتَهِي لِمَوْقِعِهِ الرُّبَا",30,"ب",2,0],["خَطّارَةٌ بَعدَ غِبِّ الجَهدِ ناجِيَةٌ","لا تَشتَكي لِلحَفا مِن خُفِّها رَقَقا",31,"ق",2,0],["خَطبُ الكِنانَةِ في فَقي","دِكُمُ لِخَطبِكُمُ يُشيب",32,"ب",1,0],["خَطّوا بِأَدمُعِهِم عَلى وَجهِ الثَرى","لِلحُزنِ أَسطاراً عَلى أَسطارِ",33,"ر",1,0],["خَطَرَ اللَيثُ في فِنائِكَ يا قَص","رُ وَقَد كُنتَ مَسرَحاً لِلحِسانِ",34,"ن",1,0],["خَطّا بِمُقتَطَفِ العُلومِ بَدائِعاً","وَرَوائِعاً بَقِيَت عَلى الأَحقابِ",35,"ب",1,0],["خَطَرَت فَعَطَّرَتِ المَشارِقَ عِندَما","هَبَّت نَسائِمُها مِنَ البَلقانِ",36,"ن",1,0],["خطيةِ الخطواتِ يَثني قَدَّها","مَرحٌ فَيَهزَأُ بِالوَشيجِ الذُبَّلِ",37,"ل",1,0],["خَطابَةٌ كُلُّها خُطوبٌ","وَبَعضُها لِلوَرى مُنَفِّر",38,"ر",1,0],["خَطَرَت بِمِثلِ الرُمحِ مُعتَدِلٍ","وَرَنَت بِمِثلِ الصارِمِ الصَقِلِ",39,"ل",1,0],["خَطبَ الهَزارُ عَلى مَنابِرِها","فَاعجَب لِأَعجَمَ مُفصِحٍ غَزَلِ",39,"ل",1,0],["خَطَرٌ يَقتَضي الكَمالَ بِنَوعَي","خُلُقٍ بارِعٍ وَخَلقٍ وَسيمِ",40,"م",1,0],["خَطيبٌ إِذا ما قالَ يوماً بِحِكمَةٍ","مِنَ القولِ مغشيُ الرَواقِ مَهيبُ",41,"ب",1,0],["خَطّابُ مَحفِلَةٍ فَرّاجُ مَظلَمَةٍ","إِن هابَ مُعضِلَةً سَنّى لَها بابا",42,"ب",2,0],["خطب بجانبه يشح وإن جرى","متداركاً سح الرباب الهامر",43,"ر",1,0],["خطب جليل في الذبائح لا تفي","لتقيد منه جلائل الأنوار",44,"ر",1,0],["خُطَّتْ بِمَا قَطَرَتْ قُلُوبُ شَبَابِهَا","وَبِمِثْلِهِ قَطَرَتْ عُقولُ رِجَالِهَا",45,"ل",3,0],["خَطْبُ العُرُوبَةِ فِي أَبِي إِقْبَالِهَا","قَدْ عَزَّ فِيهِ الصَّبْرُ وَالسُّلْوَانُ",46,"ن",1,0],["خَطْبُكَ لَيْسَ الخَطْبُ تَعْلُو بِهِ","رَنَّاتُ أشْجَانٍ وَأَحْزَانِ",47,"ن",1,0],["خَطْبٌ أَرَانَا فِي مَجَالاَتِ الفِدَى","وَالصِّدْقِ كَيْفَ مَصَارِعُ الشُّجْعَانِ",48,"ن",1,0],["خَطِيبٌ حَلاَ أَسْلُوبُهُ وَتَنَوَّعَتْ","فُكَاهَاتُهُ لُطْفاً لِمَا هُوَ رَائِمُ",49,"م",1,0],["خط يدّك اللّه يعلّيه","للهنا يفتح بويّب",50,"ب",1,0],["خط الردى منها سطوراً نصها","لا بدّ أنك للفَناء مُلاقِ",51,"ق",1,0],["خطُّ يُمناك ينادي","صحَّ هذا صحَّ هذا",52,"ذ",2,0],["خطّ سفراً به ابتغى","غنية الروح بالرغى",53,"غ",2,0],["خطرت والجمال يخطر منها","في حشا القوم جيئةً وذهوبا",54,"ب",2,0],["خطاب يهودا قد دعانا إلى الفكر","وذكَّرنَا ما نحن منه على ذُكر",55,"ر",1,1],["خطبنا ودّهم فتقبّلونا","بعاطفة كعاطفة الفروك",56,"ك",1,0],["خطفت عمرك المنون اختلاساً","كاختلاس المنى يد الأوهام",57,"م",1,0],["خُطاهُم بِالسُيوفِ إِلى الأَعادي","بِوَصلِ سُيوفِهِم يَومَ الضِرابِ",58,"ب",1,0],["خُطِبَت بِحَدِّ السَيفِ حَتّى زُوِّجَت","كَرهاً وَكانَ صَداقُها لِلمَقسِمِ",59,"م",1,0],["خطفت عمامتِي فسكتّ عنها","وزدت لجاجةً فخَطفت ثوبي",60,"ي",1,0],["خطبت بالشامِ لما أن خطِبتَ له","فاهنأ بمتفق اللفظين مزْدَوِج",61,"ج",1,0],["خطبته وزارةٌ وجدته","في اكتساب العلى أجدَّ وأجدى",62,"د",2,0],["خطَّافةٌ لبّ رائيه براعته","ووجهُ حاسدها بالرَّوع مخطوف",63,"ف",1,0],["خطَّ ريحانه على ماءِ خدٍّ","كادَ يجري في نضرةٍ ونعيم",64,"م",1,0],["خطاب كذوْب الشهد في فمِ ذائقٍ","ولكنه في مهجة الضدّ خطبانُ",65,"ن",1,0],["خطه والكلام حلوان لكن","هو يوم الوغى من المرَّان",66,"ن",1,0],["خطّ على الخدِّ الشريق فحبذا","ياقوت ذاك الخطّ أو ريحانه",67,"ن",2,0],["خطبته مناصب الدِّين والدن","يا كما قد نرى فكانَ الكفيّا",68,"ي",2,0],["خطيبٌ عَصاه الرمحُ والسيفُ لم يزل","وآباؤُه يُبْلُون خيرَ بلاءِ",69,"ا",2,0],["خطب السؤالَ إلى العُفاة ولم يكن","لو لا مكارمُه السؤال ليُخطبَا",70,"ب",2,0],["خطرتْ بها كفَّاهُ دون إمامِه","في ظلِّ يوْمٍ للأكفِّ مُطيحِ",71,"ح",1,0],["خطبت شريفاً طاهراً وتنزهت","عن أدنياءَ علمتُهم أرجاس",72,"س",1,0],["خطبتك إذ وافقت خطبتها","وسواك أقصاه تسرُّعه",73,"ع",2,0],["خطٌّ إذا قابلته العينُ قابلها","روضُ الربيع إذا ما طُلَّ أو وُبلا",74,"ل",2,0],["خُطَّ غُفْلَ الحُروفِ يقرؤه الأُمْ","مِيُّ كالصبح غير ذي استعجام",75,"م",1,0],["خَطّها في القَرا وفي الذَّنَبِ الزَّا","ئلِ قِسْمَيْنِ أعدلُ القُسَّام",75,"م",1,0],["خُطبةٌ لو كظمتُها كانَ أوْلى","بي ولكنْ مرةٌ مكظومه",76,"م",2,0],["خطَّ ولدانُكم أفانينَ فيها","أو رجالٌ كأنَّهُمْ وِلدانُ",77,"ن",1,0],["خُطوبٌ يَراها الوَرى مِثلَها","لِذَلِكَ أَشفَقَ أَن تُكتَبا",78,"ب",2,0],["خَطيبُ بِلادِ النيلِ مالَك ساكِناً","وَقَد كُنتَ تُلقي خُطبَةً إِثرَ خُطبَةِ",79,"ه",1,0],["خَطرانِ مِن جَهلٍ وَفَقرٍ ما الرَدى","غَيرُ اِجتِماعِ الجَهلِ وَالإِقلالِ",80,"ل",1,0],["خطواتٌ سكرانةٌ بالأَناشيد","وصوتٌ كَرَجْعِ نايٍ بعيدِ",81,"د",1,0],["خَطَبتُ قُرطبةَ الحَسناء إِذ مَنَعَت","من جاءَ يَخطُبُها بالبيض وَالأَسَلِ",82,"ل",1,0],["خطر كله الظلام ولاكن","لا تبالي النسور بالاخطار",83,"ر",1,0],["خطبت تؤبنك الدموع","ومشت تشيعك الجموع",84,"ع",1,1],["خطلي بعد ان ظللت سبيلي","هو اني ارى الهدى في ضلالي",85,"ي",1,0],["خطونا في الجهاد خطى فساحا","وهادنّا ولم نلق السلاحا",86,"ح",2,1],["خطوا المضاجع في التراب لفارس","جنباه مضطجع من الأطواد",87,"د",1,0],["خطَواتها التقوى فلا مزهوَّة","تمشى الدلال ولا بذات نِفَار",88,"ر",1,0],["خطبك هذا أجل خطب","فخذ له الصبر باليمين",89,"ن",1,0],["خَطَرَت فَوقَهُ المِهارَةُ تَعدو","في غُبارِ الآباءِ وَالأَجدادِ",90,"د",1,0],["خَطَّت يَداكَ الرَوضَةَ الغَنّاءَ","وَفَرَغتَ مِن صَرحِ الفُنونِ بِناءَ",91,"ا",2,1],["خَطَرَ النَعشُ عَلى الأَرضِ بِها","يَحسِرُ الأَبصارَ في النَعشِ سَناها",92,"ا",3,0],["خَطَطتَ لِلدينِ وَالدُنيا عُلومَهُما","يا قارِئَ اللَوحِ بَل يا لامِسَ القَلَمِ",93,"م",1,0],["خَطَرَت في مِحجَرَيها وَمَشَت","بِعُيونِ المُلكِ في بَحرٍ وَبَر",94,"ر",1,0],["خَطبانِ قاما بِالفَناءِ عَلى الصَفا","ما كانَ بَينَهُما الصَفاءُ لِيَعمُرا",95,"ر",2,0],["خُطَبٌ لا صَوتَ إِلّا دونَها","في صَداها الخَيلُ تَجري وَالسِنين",96,"ن",1,0],["خَطَّ النَبِيُّ بِراحَتَيهِ خَندَقاً","وَمَشى يُحيطُ بِهِ قَناً وَسِهامُ",97,"م",1,0],["خَطَبتَ فَكُنتَ خَطباً لا خَطيباً","أُضيفَ إِلى مَصائِبِنا العِظامِ",98,"م",1,0],["خَطَبتَ عَلى الشَبيبَةِ غَيرَ دارٍ","بِأَنَّكَ مِن مَشيبِكَ في مَنامِ",98,"م",1,0],["خَطبُ الإِمامِ عَلى النَظي","مِ يَعُزُّ شَرحاً وَالنَشير",99,"ر",1,0],["خُطاكَ في الحَقِّ كانَت كُلُّها كَرَماً","وَأَنتَ أَكرَمُ في حَقنِ الدَمِ السَرِبِ",100,"ب",1,0],["خِطبَةٌ لِلحِمامِ لَيسَ لَه