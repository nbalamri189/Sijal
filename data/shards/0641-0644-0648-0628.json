{"poems":[[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[56,"إن ابن زيات له قينة","https://www.aldiwan.net/poem27611.html","السريع"],[74,"أيا حسنا قد هوى شائبا","https://www.aldiwan.net/poem19606.html","المتقارب"],[74,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[87,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[30,"أفاطم لا أنسى نعاس ولا سرى","https://www.aldiwan.net/poem5545.html","الطويل"],[46,"أعتبة إن تطاولت الليالي","https://www.aldiwan.net/poem30024.html","الوافر"],[89,"أطعت الغي في حب الغواني","https://www.aldiwan.net/poem8233.html","الوافر"],[71,"بأيمن جرعاء الكثيب خيام","https://www.aldiwan.net/poem28765.html","الطويل"],[22,"لعمرك ما ذمت لبوني ولا قلت","https://www.aldiwan.net/poem21705.html","الطويل"],[52,"ألا يا حبذا والله من","https://www.aldiwan.net/poem63881.html","الهزج"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16642","الطويل"],[96,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=15628",""],[136,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[164,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[208,"قد كنت فزت بمن أهوى وآنسني","https://www.aldiwan.net/poem53127.html","البسيط"],[214,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[214,"جوار الله خير من جواري","https://www.aldiwan.net/poem13514.html","الوافر"],[234,"أنعم من العيش بما تشتهي","https://www.aldiwan.net/poem51135.html","السريع"],[242,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[310,"وروضة حسن بات ينشقنا الصبا","https://www.aldiwan.net/poem56422.html","الطويل"],[331,"بموت أمير المؤمنين محمد","https://www.aldiwan.net/poem44231.html","الطويل"],[447,"ألا من لصب بالحجاز غريب","https://www.aldiwan.net/poem14297.html","الطويل"],[463,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[520,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110742","الوافر"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96353","الوافر"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134230","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79910","المتقارب"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123032","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71074","البسيط"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34956","الطويل"],[2147,"","https://poetry.dctabudhabi.ae/diwan/poem/73697","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102544","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118797","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74269","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65332","السريع"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99313","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62811","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123918","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66446","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85238","الطويل"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18549","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131268",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40110","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139452",""],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101388","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78339","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127312","الطويل"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96074","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139622",""],[5136,"أهواه كالغصن في تثنيه","https://www.poetsgate.com/ViewPoem.aspx?id=121781",""],[5136,"ما ضركم أيها الغضابا","https://www.poetsgate.com/ViewPoem.aspx?id=121499",""],[5224,"سماء الناس للعشاق أرض","https://www.poetsgate.com/ViewPoem.aspx?id=121299",""],[5582,"بَدَتْ عَنْ وَجْهِها سَحَراً فَلاحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186791",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5691,"عكاظُ الفيسِبوك...!","https://www.poetsgate.com/ViewPoem.aspx?id=207585",""],[5781,"لا سيّداتي نحنُ لسنا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=202846",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[520,"لياليك من بشر نهش وتبسم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577648",""],[463,"بطرفِّكَ والمسحورُ يقسمُ بالسَّحرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60085&r=&rc=141",""]],"verses":[["فَلَو بَخِلَ السَحابُ عَلى ثَراها","لَذابَت فَوقَها قِطَعُ السَرابِ",0,"ب",1,0],["فَلَو بَدَت حاسِرَةً في الضُحى","لَاِسوَدَّ مِنها فَلَقُ الصُبحِ",1,"ح",1,0],["فلو بتُّما عند قدريكما","لبتُّ وأعلا كما الأسفل",2,"ل",1,0],["فلو بكت سور القرآن من أسفٍ","لانْهلَّ جفن النسا ممَّا تكاتمه",3,"م",2,0],["فلو بودلتُ بالدنيا جميعاً","علقتُكَ وانحرفتُ عن البِدال",4,"ل",1,0],["فَلوبيلُ مُمسِكَةٌ مَوزَراً","وَلوبيلُ تُمسِكُها مَوزَرُ",5,"ر",1,0],["فَلَو بِعتِني نَفسي الَّتي قَد تَرَكتِها","تَساقَطُ تَترى لَاِفتَداها سَوامُها",6,"م",3,0],["فَلَو بُدِّلتُهُ وَجهاً إِذَن لَم","أُصَلِّ بِهِ نَهاراً في جَماعَه",7,"ع",2,0],["فَلَوْ بَرَزَ الْحِمَامُ إِلَيَّ شَخْصَاً","دَلَفْتُ إِلَيْهِ بِالسَّيْفِ الْيَمَانِي",8,"ن",2,0],["فلو بكَ ما بي كنتَ تعذرُ عاشقاً","لهُ البينُ خصمٌ والغريمُ غرامُ",9,"م",1,0],["فَلَو بَلَغَت عَوّا السِماكِ قَبيلَةٌ","لَزادَت عَلَيها نَهشَلٌ وَتَعَلَّتِ",10,"ت",1,0],["فَلَو بِتنا بِهِ لَيلاً","مَعَ الأَسفاطِ وَالوَردِ",11,"د",1,0],["فلو بانَ عَضْدي ما تأسّفَ مَنْكِبي","ولو ماتَ زَنْدي ما بَكَتْه الأنامل",12,"ل",1,0],["فلو بخلت بنعماء العذاب لما","نشدت عندك إلاّ جمره أربا",13,"ب",2,0],["فلو برأت نفوسكمُ علمتم","بأَن دواءَ دائكمُ لَدَانا",14,"ن",2,0],["فلو بت في البيدا وجدت لكم يدا","تمهد ما القي على ظهره الجنبا",15,"ب",2,0],["فلو بدا حسنُهم في حسن مجلسهم","لشاربٍ مُرقِداً دهراً لما نعسا",16,"س",2,0],["فلو بالروح يفدى او بمال","لجدت وكنت اسمح بالفداء",17,"ا",2,0],["فلو بالروح او بالمال تفدى","فدبت وقد بسطت لك اعتذاري",18,"ر",2,0],["فلو بدا كِسْرَى له لم يكن","متَّخِذاً إيوانَه مَقعَدا",19,"د",2,0],["فَلَوْ بُلَغَاءُ الْعَصْرِ عَدُّوا خِصالَهُ","لَمَا بَلَغُوا مِنْهَا وَلَوْ كَثُرُوا عُشْرَا",20,"ر",2,0],["فَلو بينَ وردٍ والقرنفل حكّمت","نَسيمُ الصّبا جاءَت بريّا القرنفلِ",21,"ل",1,0],["فلو بكت الأيّام ميتاً بكَت له","سوالفُها والباقيات الغوابِر",22,"ر",1,0],["فلو بعض أشواقي عسيب بلي بها","لذاب مذاب الشمع ركن عسيب",23,"ب",1,0],["فلو بَقيَ الماضون منهم تمثّلوا","بملكك في مُلكٍ وعصرِك في عصرِ",24,"ر",1,0],["فلو بلغَتْ تلك البلاغة وائلاً","لما بجحتْ يوماً بسحبانَ وائلُ",25,"ل",1,0],["فلو بلغت نحو السماء بلاغة","لباتت لك الشعري مع الشعر تنظم",26,"م",1,0],["فلو برزت ما بينهم وهم هم","فهل أنت فيهم ضامن لصفاء",27,"ا",2,0],["فلو بعث الإله بكل عصر","نبيا كنت أنت لنا نبيا",28,"ي",2,0],["فلو بيدي سواك غَداةَ زَلَّت","بيَ القدمانِ لم أرجُ اطِّلاعا",29,"ع",2,0],["فَلَو بَكَت الدَما عَيناكَ خَوفاً","لِذَنبِكَ لَم أَقُل لَكَ قَد أَمِنتا",30,"ت",2,0],["فلو بيع أشري منه بالعمر ليلة","واني لفي ربح عظيم بما أشري",31,"ر",2,0],["فلو بمُذهَّبها قُلِّدت","لزان مفضَّض أجيادها",32,"د",3,0],["فلو برك الغماد قصدت كنا","له من دون شخصك سائرينا",33,"ن",2,0],["فلو بلغ الأماني كلَّ راش","لباتَ لثغر وصلك وهو راشف",34,"ف",1,0],["فلَوْبكم رُمْتُ سُوءاً غيرَ ما كَذِبٍ","لكُنْتُ حقّاً عليكم أَيَّ مُقْتَدِرِ",35,"ر",1,0],["فَلَو بُعِثَت بَعضُ اليَهودِ عَلَيهِمُ","يَؤُمُّهُم أَو بَعضُ مَن قَد تَنَصَّرا",36,"ر",2,1],["فَلَو بَلَغَت شُهبُ السَّماءِ بُلوغَنا","لِتَقبيلِها ظَلَّت تُزاحِمُنا الشُّهبُ",37,"ب",1,0],["فلو بذلت طريف المال عن طرف","مع التلير لما باليت يا جاري",38,"ر",2,0],["فلو بدا وجه من أهوى سجدت له","لكن حُجِبتَ وفضلاً منه أدنانِ",39,"ن",1,0],["فَلو بشرت من بِالغَرب فيهِ","لأَعطوك الَّذي صَلوا وَصاموا",40,"م",3,0],["فلو به احتجّ على مُدّعي","قسمته لا نقطع الخصمُ",41,"م",1,0],["فلو بدا ما بدا إلى الورى جملة","لأفنى وجودهم في أسرع لمحة",42,"ه",1,0],["فلو بصرت عين الوزير بشاعر","على مركب قد شانه الله مركبا",43,"ب",2,0],["فلو بعبيدِ اللهِ لبستُ أحبُلي","أمرَّ قُواها المشرفيُّ المُذَكَّرُ",44,"ر",1,0],["فلو بقيت لي مهجة لافتديتهم","ولكن غداة البين قالوا لها ذوبي",45,"ب",2,0],["فلو بصر الزرقاء حدّق طالباً","لإدراك شأوٍ منك لارتد عاشيا",46,"ي",2,0],["فلو برزت يوماً لغيلان لم يهم","بمي ولم يبد القريض لمنشد",47,"د",1,0],["فَلَو بِكَ ما بي لا يَكُن بِكَ لاغتَدى","إِلَيكَ وَراحَ البرُّ بي وَالتقرُّبُ",48,"ب",1,1],["فلو بات من ظمءٍ أخو الفقر مشرفاً","على الموت لم توهب له قطرات",49,"ت",1,0],["فلو بَصْرتَ به يصغي وأنشدهُ","قلت النواسِيّ يَشجو قَلبَ عذريِّ",50,"ي",1,0],["فلو بقيت ببطن البحر قاطنةً","ما نلت من إنس أهل الأرض ضيمهم",51,"م",1,0],["فلو بذلتُ دمي أبغي رضاك به","والمالَ حتى أسلَّ النعلَ من قدمي",52,"م",2,0],["فلو بلغ الفريق بناسراها","لأوقفنا على مغنى الرفيق",53,"ق",1,0],["فَلَو بَكت مُقلَتي لِلحَشر ما غَلت","ذُنوبُ يَوم تُقضى في الجَهالات",54,"ت",1,0],["فلو بيع ذياك الزمان شريته","بعقلي وروحي والحياة وماليا",55,"ل",3,0],["فلو ببني شيبان حلّت ركائبي","لكانَ قِراهم راهناً حين أنزل",56,"ل",1,0],["فلو بِفِناه الناسُ لاذت من الفَنا","لكفَّ الفنا عنهم ورد يدَ الردى",57,"د",2,0],["فلو برى الله مثله بشراً","وصاغه في الجمال يحكيه",58,"ي",2,0],["فلو به راحكم مزجتم","لأرقص الراح والشرابا",59,"ب",2,0],["فلو بذل الدراهم فرض قوم","فبذل الروح للعشاق فرض",60,"ض",1,0],["فَلَوْ بارَى الرِّياحَ بِهِ رِهاناً","لَعَقَّبَ فِي تَبارِيهِ الرِّياحَا",61,"ح",2,0],["فلو بالدمع للموتى حيوةٌ","لا جريناه بحراً فيهِ عاموا",62,"م",3,0],["فلوْ بُعِثَتْ لقيْصَرَ فيسِبوكّاً","لَتَمَّ بدونِ ناقِلِها الوُصولُ",63,"ل",1,0],["فلَوْ بَتَرَ الأَعْداءُ مَجْدَكِ عُنْوَةً","فَها هُوَ ذا التَّاريخُ يَنْفي ويُنْكِرُ",64,"ر",1,0],["فلو بيننا حلَّ اللقاءُ تمائمَ ال","عيون.. ِلما أرهَقْت ُ باسمِكِ ديواني",65,"ن",2,0],["فلو بلغت نحو السماء بلاغةٌ","لكانت لك الشعرى مع الشعر تنظم",66,"م",1,0],["فلو بقى الماضونَ منهمْ تمثَّلوا","مملككَ في ملكٍ وعصركَ في عصرِ",67,"ر",1,0]]}