dctabudhabi.ae/diwan/poem/205653","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132087","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117913","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36714","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114187","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102977","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69906","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97071","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81296","المنسرح"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83448","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28683","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83124","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83190","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72428","البسيط"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102014","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102016","الرمل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[4727,"لعل الدّهر مدّخر ثوابا","https://www.poetsgate.com/ViewPoem.aspx?id=208810",""],[4732,"مضيت وخلفت القذى بمحاجري","https://www.poetsgate.com/ViewPoem.aspx?id=173333",""],[4781,"مقامه والمشعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=107155",""],[5055,"ثارت الفتنة","https://www.poetsgate.com/ViewPoem.aspx?id=101192",""],[5055,"رفيق الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=104394",""],[5843,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=51289",""],[5897,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=162002",""],[5956,"أطفالي","https://www.poetsgate.com/ViewPoem.aspx?id=194840",""],[5975,"السير في نهج البردة","https://www.poetsgate.com/ViewPoem.aspx?id=58777",""],[5986,"زماني من مصائبه دعاني","https://www.poetsgate.com/ViewPoem.aspx?id=162961",""],[520,"الشعر يعلم ان قدرك اكبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577504",""]],"verses":[["ذَخَرتُ لَكَ الغُرَرَ السائِراتِ","يُعَبِّرُ عَنها الفُؤادُ الكَئيبُ",0,"ب",1,0],["ذَخَرَت لَنا الذِكرَ الجَميلَ إِذا اِنقَضى","ما يَذخَرُ الآباءُ لِلأَبناءِ",1,"ا",2,0],["ذَخَرتُ لَهُ في الصَدرِ مِني مَوَدَّةً","وَخَلَّيتُ عَنهُ مُهمَلاً لا أُعاتِبُه",2,"ب",2,0],["ذَخِيرَة أيَّامِي وَوُسْطَى قِلاَدتي","وَنُكْتَةُ إِخْلاَصِي وَحِكْمَةُ دِيوَانِي",3,"ن",2,0],["ذَخَرُوكَ لِلأِسْلاَمِ نَدْباً أَرْوَعاً","سَحَّ النَّدَى ضَخْمَ الْهُمُومِ هُمَامَا",4,"م",2,0],["ذَخِيرَتِي حِينَ خَانَنِي زَمَنِي","وَعُدَّتِي فِي اشْتِدَادِ أَهْوَالِ",5,"ل",1,0],["ذخَرَتْكَ أحْكامُ الإلاهِ لنَصْرِهِ","ونمَتْكَ منْ هَذا الأنامِ خِيارُهُ",6,"ر",2,0],["ذَخيرَةَ رَملٍ دافَعَت عَقِداتُهُ","أَذى الشَمسِ عَنها بِالرُكامِ العَقَنقَلِ",7,"ل",1,0],["ذَخَرتُ أَبا عَمرٍو لِقَومِكَ كُلِّهِمِ","بَقاءَ اللَيالي عِندَنا أَحسنَ الذُخرِ",8,"ر",1,0],["ذخرنا نداه في الورى وَوَلاءهُ","ليومِ حياةٍ أو ليومِ ممات",9,"ت",1,0],["ذَخيرَةُ الراهِبِ كَي يَجعَلَها","إِذا أَتَت أَعيادُهُ قُربانا",10,"ن",2,0],["ذَخَرتُ لَهُم لُطفَ الإِلَهِ وَيوسُفاً","وَوَاللَهِ لا ضاعوا وَيوسُفُ يوسُفُ",11,"ف",1,0],["ذَخِرَ الحَقيبَةِ ما تَزالُ قُلوصُهُ","بَينَ الخَوارِجِ هِزَّةً وَذَويلا",12,"ل",2,0],["ذُخري أَبا الجَيشِ هَل يُقضى اللِقاءُ لَنا","فَيَشتَفي مِنكَ جَفنٌ أَنتَ ناظِرُهُ",13,"ر",2,0],["ذخرتُكما يا صاحبيَّ لشدةٍ","فإِن لم تُعينا فاذهَبا ودعاني",14,"ن",2,0],["ذَخائِرُ آبائِكَ الأَوَّلينَ","أَتوَيتَها في مُهورِ اللَعَب",15,"ب",1,0],["ذَخائِرُ تَنهى النَفسَ عَمّا تَجَشَّمَت","وَما اِستَحسَنَت مِن عُذرِها وَاِستَحَلَّتِ",16,"ت",1,0],["ذَخائِرُ ذيدَ الحَقُّ عَنها وَأُرتِجَت","عَليها مَغاليقُ الصُدورِ الشَحائِحِ",17,"ح",1,0],["ذَخَرَ الثَّناءَ وفرَّقَتْ","يُمناه مُجتمَعَ الذَّخائر",18,"ر",1,0],["ذَخَرَت خَزائِنُهُ فَقالَ لَها اِنفِدي","وَذَكَت عَزائِمُهُ فَقالَ لَها اِنفُذي",19,"ذ",2,0],["ذُخرٌ لَنا في النائِباتِ وَمَلجَأٌ","مَن لَم يَلُذ بِجَنابِهِ لَم يَنفُذِ",19,"ذ",1,0],["ذَخرِ الزَميلِ عِدَّةُ المُقاوِلِ","وَبَينَهُم حِملٌ بِلا تَحامُلِ",20,"ل",1,0],["ذُخْرُ الدُّهورِ فإن تَكُنْ من مِرْيةٍ","بالقومِ فَهْيَ أمانةُ الأجيالِ",21,"ل",1,0],["ذُخْرُ البلادِ أضاعه أبناؤُها","فمضى يُشِّيعهُ أسىً ونُواحُ",22,"ح",1,0],["ذَخائِركُم يا قومُ شتّى حِسانُها","فَثُوبوا إلى الحُسنى وصُونوا الذّخائرا",23,"ر",2,0],["ذَخائِرُ سُؤدُدٍ وَتُراثُ عِزٍّ","وَمُلكٌ لِلكِنانَةِ لا يَبيدُ",24,"د",1,0],["ذُخرُها الأَوفى إِذا ما فَزِعَت","لَوعَةٌ حَرّى وَدَمعٌ مُنهَمِرْ",25,"ر",1,0],["ذُخرُ البَنينَ نَصونُ مِن مَوروثِهِ","ما صانَ آباءٌ لَنا وَجدودُ",26,"د",1,0],["ذَخَرتُ دَمعي لِأَبكي المَكرُماتِ بِهِ","فَلَستُ أَبذُلُهُ حُزناً لِمَلحودِ",27,"د",1,0],["ذَخائِرُ كِسرى لِأَولادِهِ","وَغَرسُ كِرامِ بَني الأَصفَرِ",28,"ر",1,0],["ذَخيرَةُ نوحٍ في الزَمانِ الَّذي اجتَنى","فَأَدخَلَها في الفُلكِ إِذ رَكِبَ الفُلكا",29,"ك",2,0],["ذُخِرَت لِآدَمَ قَبلَ خِقَتِهِ","فَتَقَدَّمَتهُ بِخَطوَةِ القَبلِ",30,"ل",1,0],["ذَخيرَةُ دَهقانٍ حَواها لِنَفسِهِ","إِذا مَلِكٌ أَوفى عَلَيهِ وَسيمُ",31,"م",1,0],["ذخرت لهذا أدمعي ولمثله","فواخجلي في الرزء إن نفد الذخر",32,"ر",1,0],["ذخائرُ الوطن الغالي يُرَتِّلُها","على مسامع أجيالٍ وأزمانِ",33,"ن",1,0],["ذخيرَةُ كَهْلٍ مِن كُهولٍ كأنّهمْ","إذا كان هَيْجٌ يَلْبَسونَ السَّوابيا",34,"ي",2,0],["ذُخْرَانِ نَرْجُو اللهَ أَنْ يَرْعَاهُمَا","فَهُمَا العَزَاءُ لِكُل قَلْبٍ وَامِقِ",35,"ق",1,0],["ذَخْيرَةُ قَوْمٍ فُوجئُوا بضِيَاعهَا","فَمَا دَفَعَ الحرْصُ القَضَاءَ وَمَا فَدَى",36,"د",2,0],["ذَخَائِرُ مُؤْذِنَاتٌ بِانْقِرَاضٍ","تذَكِّرُنَا غَوَابِرَهَا البَوَاقِي",37,"ق",2,0],["ذَخِيرةُ مَصْرَ جَامِعَةُ حَقِيقٍ","بِهَا رِفَقُ الوِلاةِ وَالاعْتِنَاءُ",38,"ا",2,0],["ذُخري فَخري حَبيب قَلبٍ","قُرَّةَ عَيني أَما تُحاذى",39,"ذ",2,0],["ذَخِيرةُ الأمة أبناؤها","ماذا أفادَ النيلُ من ذُخْرِه",40,"ر",2,0],["ذخرتك أحكام الإله لنصره","ونمتك من هذا الأنام خياره",41,"ر",2,0],["ذخيرة دهقان حواها لنفسه","إذا ملك أوفى إليه وسيم",42,"م",1,0],["ذخيرةُ شعبٍ مستضامٍ تَحُوطُهُ","وإن لم يكنْ حِصْنٌ لديه ومَعْقِل",43,"ل",1,0],["ذُخِرَتْ لأيامِ السرورِ فلائلٌ","نَزلتْ على الأوطانِ شرَّ عِيال",44,"ل",1,0],["ذَخَرتُ لأحداثِ الزّمانِ يَراعا","يُجيد نِضالاً دونَها وقِراعا",45,"ع",2,1],["ذخائر آبائك الأولينا","أتويتها في مهور اللعب",46,"ب",1,0],["ذَخرتْهُ لك العواقبُ عندي","يتخطاه كلُّ حينٍ وحتف",47,"ف",1,0],["ذخائرهم يا قوم شتى حسانها","فثوبوا إلى الحسنى وصونوا الذخائرا",48,"ر",2,0],["ذَخائر لا يَسخو الزَمان بِمِثلِها","ثَلاثة أَمجاد كَأَنَّهُمُ عقد",49,"د",1,0],["ذخرنا عبد الحميد المرتضى","لحمى الاسلام والدين المبين",50,"ن",1,0],["ذخري مقبل راحة الهادي التي","سحت ببحر المكرمات الهامي",51,"م",2,0],["ذخري حبيب الله نور الهدى","الهاشمي الانجب الامجد",52,"د",1,0],["ذخري ابو البركات فياض الندى","علم الطريقة كوكب الاسياد",53,"د",1,0],["ذخري الرفاعي الكير المرتجى","لحصول كل غنمة ونجاح",54,"ح",1,0],["ذخري الامام ابو علي ندبة ال","حلهوف اذ تتخالف الاراء",55,"ا",2,0],["ذخر الزمانُ من الفتوحِ غرائباص","لزمانهِ المتهللِ البسامِ",56,"م",1,0],["ذخرَ الأملاكُ وأنتَ أبا","يعقوبَ تجودُ بما تجدُ",57,"د",1,0],["ذُخرٌ أَغارَ عَلَيهِ الدَهرُ مُستَلِباً","فَلَم يَدَعُ بَعدَهُ غَيرَ الأَسى عِوَضا",58,"ض",2,1],["ذَخيرةٌ تَلِفت في الأَرضِ ذاهِبةً","فَما وَفَتْها مِن المَحزونِ عَبْرَتُهُ",59,"ت",2,0],["ذُخرٌ لَنا الدَّهرُ أَبقاهُ يَلوذُ بِهِ","مَن لَم تَدَع غَيرَهُ ذَخراً لَهُ النّوَبُ",60,"ب",1,0],["ذخرت له الطعام فلم يجئني","وجاء الليل يؤذن باهتمام",61,"م",1,0],["ذخيرة الدمع يوم البين أنفقها","فقد التجمّل من فرد ومزدوج",62,"ج",1,0],["ذَخَرَتها لَكَ اللَيالي وَكَم حا","مَت عَلَيها مِن قَبلِكَ الخُلَفاءُ",63,"ا",2,0],["ذخرتُ مديحي في النبي محمَّد","ليوم به أهلُ الكبائرِ تُجبذُ",64,"ذ",1,1],["ذُخِرَتْ وِتْراً وشَفْعاً لَكُمُ","فاقْتَضُوا مِنْ غُرِّها ما ذُخِرا",65,"ر",2,0],["ذَخَرْتُ لَكَ الْمَدْحُ الشَّرِيفَ وَإِنَّما","عَلَى قَدْرِ فَضْلِ الزَّنْدِ قِيمَةُ قُلْبِهِ",66,"ب",2,0],["ذخري عمادي عتادي عدتي وزري","ترى الأساطير تدني والأساطيل",67,"ل",1,0],["ذُخْرانِ مَوْروثانِ قد بَقيا له","حَمْدٌ ومَجدٌ طال فَرْعُ بنائهِ",68,"ا",3,0],["ذِخِرَت مُقلَتي كُنوزَ دُموعِ","فَاِجهَدي يا هُمومُ في الإِنفاقِ",69,"ق",1,0],["ذُخْرُ المَجوسِ فرَبعُ وَح","شتِهِمْ بِها أبَداً مَجوسُ",70,"س",1,0],["ذخيرةُ أَملاكٍ وعِلْقُ تَبابِعٍ","وصفوةُ أَذْواءٍ وميراثُ أَقْيالِ",71,"ل",1,0],["ذخائرٌ لَكَ مِمَّنْ أَنتَ فاقِدُهُ","ووارثُ الملكِ عنهُ غَيْرُ مُفْقِدِهِ",72,"د",2,0],["ذخرتك من شيء أخاف نزوله","فحملتني ما لم أطق من نزالكا",73,"ك",2,0],["ذخيرة منه تواصَوا بها","خلَّفها ظاعنُهم للمقيمْ",74,"م",1,0],["ذخيرةٌ عند غدٍ دولتُها","صائرةٌ منك إلى نظامِها",75,"م",3,0],["ذَخَر الزمانُ لعصر ملكك كنزَها","حتى تكونَ منيرةً بالأنعمِ",76,"م",1,0],["ذخرتُهُ لي في الحيا","ةِ والمماتِ موئلا",77,"ل",2,0],["ذُخِرتُ لهم كنزاً مواريثَ قومهم","فمن رامني من غيرهم فهو يَغصِبُ",78,"ب",1,0],["ذخيرةُ أنسي يومَ يوحشني أخي","وبابي إذا سُدّتْ عليَّ مذاهبي",79,"ب",2,0],["ذُخرُه الحمدُ اذا ما غَيْرُهُ","جعلَ الذُّخْرَ لُجَيْناً ونُضارا",80,"ر",2,0],["ذخرت أبي نصر لحظ أناله","فبلغني أقصى المنى ببني نصر",81,"ر",1,1],["ذُخري أَبو العَبَّاسِ أَحمدُ من سَما","شَرَفاً وفاقَ برِقَّةٍ ومَعَانِ",82,"ن",1,0],["ذُخري أَبو العَلَمَيْنِ شِبلُ ذوي الكِسا","صَمْصامُ ثائرَةِ الوَحا رَبُّ اليَدِ",83,"د",1,0],["ذخر الأئمة من خلائف هاشم","ووسيلة لهم تصان وتذخر",84,"ر",1,0],["ذخر الأئمة كافل الخلفاء من","نسل الهداة الخمسة الأطهار",85,"ر",1,0],["ذخر الأئمة والمؤهل مذ نشا","لكفالة الخلفاء والحكام",86,"م",1,0],["ذَخِيرَةُ أَخْبارِ الجَزِيرَة قَدْ غَدَتْ","لَدَيَّ وَهَلْ مِثْلُ الذَّخِيرَةِ مِنْ ذُخْرِ",87,"ر",1,1],["ذخروا النُّضارَ لهمْ ولم تكُ ذاخراً","إلّا ثَوابَ لُهاً وشكرَ أيادِ",88,"د",1,0],["ذَخرتك لي في النّائباتِ ومنْ يكنْ","صديقاً صدوقاً فهْوَ ذُخرُ النّوائبِ",89,"ب",1,0],["ذخائرٌ لي من الأشعار أرفعها","إلى مليك سما شأناً وإيوانا",90,"ن",2,0],["ذخائر انفردت فخراً محاسنها","عن غيرها وبها لب الفتى كلفا",91,"ف",2,0],["ذخر الغني نضاره لم يكترث","لسواه حتى جل عن إحصاء",92,"ا",2,0],["ذخائر كنز الذات في كل مبعث","عقول لها منها قديم تشبث",93,"ث",1,0],["ذخرنا البرّ من لطف النظام","ومال برأينا سحر الكلامِ",94,"م",1,1],["ذخر الشفاعة جدكم لكبائري","فيها على أهل الوعيد أصول",95,"ل",1,0],["ذَخرْتُ آمالي لوقتِ امرىءٍ","حُرٍّ فهذا وقتهُ والسلامْ",96,"م",1,1],["ذخيرة من لَباب الملك مَحتدُها","سريرة