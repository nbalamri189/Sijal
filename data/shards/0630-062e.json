.html","الطويل"],[115,"ملك الدنيا امام المسلمين","https://www.aldiwan.net/poem40477.html","عموديه"],[115,"البرق حاجر ام لبرق الشام","https://www.aldiwan.net/poem40593.html","عموديه"],[115,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[115,"احيا الطريق ونوبة الصياد","https://www.aldiwan.net/poem41147.html","عموديه"],[115,"سر الغيوب افاض اللارواح","https://www.aldiwan.net/poem41185.html","عموديه"],[115,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[133,"شاء الإله حماية الإسلام","https://www.aldiwan.net/poem4216.html","الكامل"],[133,"ببسيط العالم تعتضد","https://www.aldiwan.net/poem4239.html","المتدارك"],[182,"ذخر أغار عليه الدهر مستلبا","https://www.aldiwan.net/poem66928.html","البسيط"],[182,"اليوم طابت ليوحنا مسرته","https://www.aldiwan.net/poem66993.html","البسيط"],[182,"إلى معاليك ينمى المجد والحسب","https://www.aldiwan.net/poem67083.html","البسيط"],[186,"ولي هر رميت به خبيث","https://www.aldiwan.net/poem43306.html","الوافر"],[186,"نهاية الشوق ما يأتي على المهج","https://www.aldiwan.net/poem44086.html","البسيط"],[235,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[250,"ذخرت مديحي في النبي محمد","https://www.aldiwan.net/poem15062.html","الطويل"],[275,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[280,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[281,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[364,"يرمي فؤادي وهو في سودائه","https://www.aldiwan.net/poem58720.html","الكامل"],[366,"ليس في الأرض ما يفوق سوى الشام","https://www.aldiwan.net/poem17892.html","الخفيف"],[405,"قم هاتها عذراء تصبغ","https://www.aldiwan.net/poem49546.html","مجزوء الكامل"],[439,"سلام على الأيام تسليم إقبال","https://www.aldiwan.net/poem34847.html","الطويل"],[439,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[441,"أيا قاطع الحبل الذي إن قطعته","https://www.aldiwan.net/poem14468.html","الطويل"],[458,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[458,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[458,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[458,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[461,"أمنع الأحياء بأسا وحمى","https://www.aldiwan.net/poem15489.html","الرمل"],[493,"ذخرت أبي نصر لحظ أناله","https://www.aldiwan.net/poem67281.html","عموديه"],[500,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[500,"لله موقفنا بأم عبيدة","https://www.aldiwan.net/poem38028.html","الكامل"],[515,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[515,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[515,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[529,"ذخيرة أخبار الجزيرة قد غدت","https://www.aldiwan.net/poem37368.html","الكامل"],[551,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[551,"أيا صاحبي إن لم تكن في شديدتي","https://www.aldiwan.net/poem48062.html","الطويل"]],"verses":[["ذَخَرتُ لَكَ الغُرَرَ السائِراتِ","يُعَبِّرُ عَنها الفُؤادُ الكَئيبُ",0,"ب",1,0],["ذَخَرَت لَنا الذِكرَ الجَميلَ إِذا اِنقَضى","ما يَذخَرُ الآباءُ لِلأَبناءِ",1,"ا",2,0],["ذَخَرتُ لَهُ في الصَدرِ مِني مَوَدَّةً","وَخَلَّيتُ عَنهُ مُهمَلاً لا أُعاتِبُه",2,"ب",2,0],["ذَخِيرَة أيَّامِي وَوُسْطَى قِلاَدتي","وَنُكْتَةُ إِخْلاَصِي وَحِكْمَةُ دِيوَانِي",3,"ي",1,0],["ذَخَرُوكَ لِلأِسْلاَمِ نَدْباً أَرْوَعاً","سَحَّ النَّدَى ضَخْمَ الْهُمُومِ هُمَامَا",4,"م",2,0],["ذَخِيرَتِي حِينَ خَانَنِي زَمَنِي","وَعُدَّتِي فِي اشْتِدَادِ أَهْوَالِ",5,"ل",1,0],["ذخَرَتْكَ أحْكامُ الإلاهِ لنَصْرِهِ","ونمَتْكَ منْ هَذا الأنامِ خِيارُهُ",6,"ر",2,0],["ذَخيرَةَ رَملٍ دافَعَت عَقِداتُهُ","أَذى الشَمسِ عَنها بِالرُكامِ العَقَنقَلِ",7,"ل",1,0],["ذَخَرتُ أَبا عَمرٍو لِقَومِكَ كُلِّهِمِ","بَقاءَ اللَيالي عِندَنا أَحسنَ الذُخرِ",8,"ر",1,0],["ذخرنا نداه في الورى وَوَلاءهُ","ليومِ حياةٍ أو ليومِ ممات",9,"ت",1,0],["ذَخيرَةُ الراهِبِ كَي يَجعَلَها","إِذا أَتَت أَعيادُهُ قُربانا",10,"ن",2,0],["ذَخَرتُ لَهُم لُطفَ الإِلَهِ وَيوسُفاً","وَوَاللَهِ لا ضاعوا وَيوسُفُ يوسُفُ",11,"ف",1,0],["ذَخِرَ الحَقيبَةِ ما تَزالُ قُلوصُهُ","بَينَ الخَوارِجِ هِزَّةً وَذَويلا",12,"ل",2,0],["ذُخري أَبا الجَيشِ هَل يُقضى اللِقاءُ لَنا","فَيَشتَفي مِنكَ جَفنٌ أَنتَ ناظِرُهُ",13,"ر",2,0],["ذخرتُكما يا صاحبيَّ لشدةٍ","فإِن لم تُعينا فاذهَبا ودعاني",14,"ي",1,0],["ذَخائِرُ آبائِكَ الأَوَّلينَ","أَتوَيتَها في مُهورِ اللَعَب",15,"ب",1,0],["ذَخائِرُ تَنهى النَفسَ عَمّا تَجَشَّمَت","وَما اِستَحسَنَت مِن عُذرِها وَاِستَحَلَّتِ",16,"ت",1,0],["ذَخائِرُ ذيدَ الحَقُّ عَنها وَأُرتِجَت","عَليها مَغاليقُ الصُدورِ الشَحائِحِ",17,"ح",1,0],["ذَخَرَ الثَّناءَ وفرَّقَتْ","يُمناه مُجتمَعَ الذَّخائر",18,"ر",1,0],["ذَخَرَت خَزائِنُهُ فَقالَ لَها اِنفِدي","وَذَكَت عَزائِمُهُ فَقالَ لَها اِنفُذي",19,"ي",1,0],["ذُخرٌ لَنا في النائِباتِ وَمَلجَأٌ","مَن لَم يَلُذ بِجَنابِهِ لَم يَنفُذِ",19,"ذ",1,0],["ذَخرِ الزَميلِ عِدَّةُ المُقاوِلِ","وَبَينَهُم حِملٌ بِلا تَحامُلِ",20,"ل",1,0],["ذُخْرُ الدُّهورِ فإن تَكُنْ من مِرْيةٍ","بالقومِ فَهْيَ أمانةُ الأجيالِ",21,"ل",1,0],["ذُخْرُ البلادِ أضاعه أبناؤُها","فمضى يُشِّيعهُ أسىً ونُواحُ",22,"ح",1,0],["ذَخائِركُم يا قومُ شتّى حِسانُها","فَثُوبوا إلى الحُسنى وصُونوا الذّخائرا",23,"ر",2,0],["ذَخائِرُ سُؤدُدٍ وَتُراثُ عِزٍّ","وَمُلكٌ لِلكِنانَةِ لا يَبيدُ",24,"د",1,0],["ذُخرُها الأَوفى إِذا ما فَزِعَت","لَوعَةٌ حَرّى وَدَمعٌ مُنهَمِرْ",25,"ر",1,0],["ذُخرُ البَنينَ نَصونُ مِن مَوروثِهِ","ما صانَ آباءٌ لَنا وَجدودُ",26,"د",1,0],["ذَخَرتُ دَمعي لِأَبكي المَكرُماتِ بِهِ","فَلَستُ أَبذُلُهُ حُزناً لِمَلحودِ",27,"د",1,0],["ذَخائِرُ كِسرى لِأَولادِهِ","وَغَرسُ كِرامِ بَني الأَصفَرِ",28,"ر",1,0],["ذَخيرَةُ نوحٍ في الزَمانِ الَّذي اجتَنى","فَأَدخَلَها في الفُلكِ إِذ رَكِبَ الفُلكا",29,"ك",2,0],["ذُخِرَت لِآدَمَ قَبلَ خِقَتِهِ","فَتَقَدَّمَتهُ بِخَطوَةِ القَبلِ",30,"ل",1,0],["ذَخيرَةُ دَهقانٍ حَواها لِنَفسِهِ","إِذا مَلِكٌ أَوفى عَلَيهِ وَسيمُ",31,"م",1,0],["ذخرت لهذا أدمعي ولمثله","فواخجلي في الرزء إن نفد الذخر",32,"ر",1,0],["ذخائرُ الوطن الغالي يُرَتِّلُها","على مسامع أجيالٍ وأزمانِ",33,"ن",1,0],["ذخيرَةُ كَهْلٍ مِن كُهولٍ كأنّهمْ","إذا كان هَيْجٌ يَلْبَسونَ السَّوابيا",34,"ي",2,0],["ذُخْرَانِ نَرْجُو اللهَ أَنْ يَرْعَاهُمَا","فَهُمَا العَزَاءُ لِكُل قَلْبٍ وَامِقِ",35,"ق",1,0],["ذَخْيرَةُ قَوْمٍ فُوجئُوا بضِيَاعهَا","فَمَا دَفَعَ الحرْصُ القَضَاءَ وَمَا فَدَى",36,"د",2,0],["ذَخَائِرُ مُؤْذِنَاتٌ بِانْقِرَاضٍ","تذَكِّرُنَا غَوَابِرَهَا البَوَاقِي",37,"ق",2,0],["ذَخِيرةُ مَصْرَ جَامِعَةُ حَقِيقٍ","بِهَا رِفَقُ الوِلاةِ وَالاعْتِنَاءُ",38,"ا",2,0],["ذُخري فَخري حَبيب قَلبٍ","قُرَّةَ عَيني أَما تُحاذى",39,"ذ",2,0],["ذَخِيرةُ الأمة أبناؤها","ماذا أفادَ النيلُ من ذُخْرِه",40,"ر",2,0],["ذخرتك أحكام الإله لنصره","ونمتك من هذا الأنام خياره",41,"ر",2,0],["ذخيرة دهقان حواها لنفسه","إذا ملك أوفى إليه وسيم",42,"م",1,0],["ذخيرةُ شعبٍ مستضامٍ تَحُوطُهُ","وإن لم يكنْ حِصْنٌ لديه ومَعْقِل",43,"ل",1,0],["ذُخِرَتْ لأيامِ السرورِ فلائلٌ","نَزلتْ على الأوطانِ شرَّ عِيال",44,"ل",1,0],["ذَخَرتُ لأحداثِ الزّمانِ يَراعا","يُجيد نِضالاً دونَها وقِراعا",45,"ع",2,1],["ذخائر آبائك الأولينا","أتويتها في مهور اللعب",46,"ب",1,0],["ذَخرتْهُ لك العواقبُ عندي","يتخطاه كلُّ حينٍ وحتف",47,"ف",1,0],["ذخائرهم يا قوم شتى حسانها","فثوبوا إلى الحسنى وصونوا الذخائرا",48,"ر",2,0],["ذَخائر لا يَسخو الزَمان بِمِثلِها","ثَلاثة أَمجاد كَأَنَّهُمُ عقد",49,"د",1,0],["ذخرنا عبد الحميد المرتضى","لحمى الاسلام والدين المبين",50,"ن",1,0],["ذخري مقبل راحة الهادي التي","سحت ببحر المكرمات الهامي",51,"م",2,0],["ذخري حبيب الله نور الهدى","الهاشمي الانجب الامجد",52,"د",1,0],["ذخري ابو البركات فياض الندى","علم الطريقة كوكب الاسياد",53,"د",1,0],["ذخري الرفاعي الكير المرتجى","لحصول كل غنمة ونجاح",54,"ح",1,0],["ذخري الامام ابو علي ندبة ال","حلهوف اذ تتخالف الاراء",55,"ا",2,0],["ذخر الزمانُ م