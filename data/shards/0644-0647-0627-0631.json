{"poems":[[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[74,"لبست من المدائح ثوب مجد","https://www.aldiwan.net/poem20332.html","الوافر"],[53,"مخففة مثقلة تراها","https://www.aldiwan.net/poem7972.html","الوافر"],[53,"بني صامت قد أصبحت دار خالد","https://www.aldiwan.net/poem64049.html","الطويل"],[31,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[63,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[63,"وأزهر وضاح يروق عيوننا","https://www.aldiwan.net/poem51626.html","الخفيف"],[33,"غشيت بأذناب المغمس منزلا","https://www.aldiwan.net/poem42465.html","الطويل"],[35,"شكوت إلى سرب القطا إذ مررن بي","https://www.aldiwan.net/poem25928.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42553","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54584","البسيط"],[33,"غَشِيتُ بأذْنَابٍ المَغَمَّسِ مَنْزِلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18933&r=&rc=196",""],[125,"لقد لاح من هند هدى راح لائحاً","https://www.aldiwan.net/poem23819.html","الطويل"],[132,"إذا ما بدا برق بنعمان لامع","https://www.aldiwan.net/poem50583.html","الطويل"],[136,"مختار هذا إن أتى","https://www.aldiwan.net/poem54876.html","مجزوء الرجز"],[189,"بكم آل وحي الله يفتخر المجد","https://www.aldiwan.net/poem14508.html","الطويل"],[203,"هو الدهر آتيك أو ذاهب","https://www.aldiwan.net/poem45358.html","المتقارب"],[214,"قتيل هواك ليس يروم ثاره","https://www.aldiwan.net/poem13365.html","الوافر"],[214,"تريك الصبح في الليل البهيم","https://www.aldiwan.net/poem13402.html","الوافر"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[240,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[305,"ألم تسأل بفاضحة الديارا","https://www.aldiwan.net/poem45488.html","الوافر"],[325,"بروحي هيفاء المعاطف حلوة","https://www.aldiwan.net/poem61751.html","البسيط"],[333,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[385,"ترى عندكم في الحب بعض الذي عندي","https://www.aldiwan.net/poem49198.html","الطويل"],[412,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[466,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[503,"مشت كالغصن يثنيه النسيم","https://www.aldiwan.net/poem3706.html","الوافر"],[556,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[590,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126733","الوافر"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104081","الطويل"],[743,"","https://poetry.dctabudhabi.ae/diwan/poem/45273","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104567","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96355","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56390","الطويل"],[266,"","https://poetry.dctabudhabi.ae/diwan/poem/129598","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53195","السريع"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110637","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116518","الطويل"],[2820,"","https://poetry.dctabudhabi.ae/diwan/poem/29509","الطويل"],[2863,"","https://poetry.dctabudhabi.ae/diwan/poem/142684","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58358","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132577","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62824","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102384","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132011","الوافر"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116880","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4491,"","https://poetry.dctabudhabi.ae/diwan/poem/95747","الوافر"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143607","الوافر"],[4935,"تمثل لي خيالك في المنام","https://www.poetsgate.com/ViewPoem.aspx?id=129386",""],[307,"عاشق الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=213651",""],[5459,"هدنة على دخن","https://www.poetsgate.com/ViewPoem.aspx?id=201393",""],[5582,"أَلا ما لِدَمْعِكَ يَجْرِي طَلَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=187236",""],[5582,"إِلَى التِّيهِ مالَتْ لَها أَنْ تَمِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=187262",""],[6243,"أكان يصعُبُ !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84431&r=&rc=5",""]],"verses":[["لَها رَقَصاتٌ في الذَوائِبِ وَالشَوى","تَرُدُّ جَبانَ القَومِ نَدباً مُشَيَّعا",0,"ع",2,0],["لَها رَقَصاتٌ بِالدِماءِ كَأَنَّما","تَشَقَّقُ عَن أَعرافِ أَحصِنَةٍ شُقرِ",1,"ر",1,0],["لَهُ أَربَةٌ في حَزمِهِ وَفِعالِهِ","وَإِن كانَ مِنّا حازِمَ الرَأيِ حُوَّلا",2,"ل",2,0],["لها ردنان من نظمٍ ونثرٍ","ألا حييت عنا يا رُدَينا",3,"ن",2,0],["لها ريقٌ تَشِفُّ له الثنايا","وتَروِي عنه لا مِنه الظِّماءُ",4,"ا",2,0],["لها رب سوءٍ مثلُها خُلِقت له","وفاقاً وكان الأمرُ يُقْدر للأمر",5,"ر",1,0],["لَها رِداءانِ نَسجُ العَنكَبوتِ وَقَد","لُفَّت بِآخَرَ مِن ليفٍ وَمِن قارِ",6,"ر",1,0],["له أربٌ بين الأسِنَّةِ والظُّبَا","إِذا لم يساعدْهُ الحُبَى والوسائِدُ",7,"د",1,0],["له أَرَجٌ يُحَيِّي السِّرْبَ وَهْناً","بأنفاسٍ مُطَيَّبَةٍ رِقاقِ",8,"ق",1,0],["له أربعٌ تأبى السُّرى غيرَ أنَّها","تُصافِحُ وجهَ الأرضِ مثلَ الحوافرِ",9,"ر",1,0],["لَها رَشَأٌ تَحنو عَلَيهِ بِجيدِها","أَغَنُّ أَحَمُّ المُقلَتَينِ مُوَلَّعُ",10,"ع",1,0],["لَها رُفقَةٌ يُسعِدنَها فَكَأَنَّما","تَعاطَينَ كَأساً بَينَهُنَّ تَدورُ",11,"ر",1,0],["لَها رَوَابِطُ لا تَنْفَكُّ آخِذَةً","بِعُرْوَةِ الْقَلْبِ إِنْ جَدَّتْ وَإِنْ مَزَحَتْ",12,"ت",1,0],["لَهَا رِسَالَتُهَا العُلْيَا تُنِيرُ بِهَا","سُبْلَ الحَيَاةِ وَكَيْفَ النُّورُ فِي الحُجُبِ",13,"ب",1,0],["لَهَا رَشَأٌ تَحْنُو عَلَيْهِ بِجيدِها","أَغَنُّ أَجَمُّ المُقْلَتَيْنِ مُوَلَّعُ",14,"ع",1,0],["له إرث نور النور وهو محمد","له الحمد محمود وللحمد ناصحا",15,"ح",2,0],["لها ريقةٌ أحلى من الشهدِ طعمُها","ووجهٌ بأوصافِ المحاسن رائعُ",16,"ع",1,0],["له ارتضيتُ نَكشَةً","لما دَعوهُ نكشَتَا",17,"ت",2,0],["له أَرْبَعٌ في الناس نِيطَتْ بأَرْبعٍ","فما لامرىءٍ عنها فكاكٌ ولا بُدّ",18,"د",1,0],["لها رقةٌ كدبيبِ الكرى","فلا غروَ أن يحلمَ الشاربُ",19,"ب",1,0],["لها ردف تقاعد عن وصالي","وأثقله النهوض عن الزياره",20,"ر",2,0],["لها ردف الكثيب وقد غصن","وسالف شادن ولحاظ ريم",21,"م",1,0],["لها رُوح وليس لها","كما لِلرُّوحِ جُثْمان",22,"ن",1,0],["لَها رِقَّةٌ في قُوَّةٍ وَجَزالَةٌ","هِيَ الماءُ مَقطوبٌ بِسَلسالِهِ الخَمرُ",23,"ر",1,0],["لَها رِطلٌ تَكيلُ الزَيتَ فيهِ","وَفَلّاحٌ يَسوقُ لَها حِمارا",24,"ر",2,0],["لَها ريقَةٌ تُشفي الصَدى وَمَراشِفٌ","تَكادُ لا رَواحَ المُحِبّينَ تَشرَبُ",25,"ب",1,0],["لها روحان حائرتا","ن ما بينهما سبب",26,"ب",1,0],["له أَرقَمٌ ما انفَكَّ يَرقُمُ أحرُفاً","بها الدِّينُ ناهٍ للعِبادِ وآمِر",27,"ر",1,0],["لها رُمْحُ قّدٍ كلّما هَزَّه الصِّبا","تَلَقّاهُ من بُعْدٍ فؤادُ المُدَجَّج",28,"ج",1,0],["لَها رِقة الجسم الَّذي شَفهُ الضَنا","مِن الشَوق وَالتِذكار وَالبُعد وَالصَد",29,"د",1,0],["لَها ريقة أَستغفر اللَهَ إِنَّها","أَلَذُّ وَأَشهى في النُفوسِ مِنَ الخَمرِ",30,"ر",1,0],["لها رَسَنٌ في يمين الشَّمال","إذا ضل قائفُ أرضٍ هَدَى",31,"د",2,0],["لها رنين إذا ما أنْبضتْ زجِلٌ","كما أرنَّ أبيُّ النفسِ مجهود",32,"د",1,0],["لها ريقةٌ لولا التقى ما حظرتها","ولولا الهوى ما حلّ عندي مدامها",33,"م",3,0],["لها رِدفٌ تعلّق في لطيفٍ","وذاك الردفُ لي ولها ظلومُ",34,"م",1,0],["لَها رَتَكٌ في جميعِ البلادِ","كما أرْتَكَتْ جائلاتُ النّعامِ",35,"م",1,0],["لها رَحِمٌ مثلُ حبل العِقال","إِذا ما دنوت إِليه رَشَح",36,"ح",1,0],["له أرضُ الحجاز بكَت ومصر","لهُ أضحَت بعبرتها تجودُ",37,"د",1,0],["لها رنّةٌ في إثرهِ بعد فَقدهِ","فتَحسبُها تبكي عليهِ من الثَّكلِ",38,"ل",1,0],["لَهُ أَرَجٌ مِن مَجمَرِ الهِندِ ساطِعٌ","تَطلَّعُ رَيَّاهُ مِنَ الكَفراتِ",39,"ت",1,0],["لها رونقُ المعنى الذي دَقّ غورُه","فجلَّ عن اللُّبِّ المهذّبِ فَهمُهُ",40,"م",2,0],["لها رأسٌ إذا تُطْلِ","عُهُ في هيئةِ الطَّلْع",41,"ع",1,0],["لها رَوضَةٌ في القَلبِ لم يَرعَ مثلَها","فَروكٌ ولا المستعبراتُ الصلائِفُ",42,"ف",1,0],["لها رونقٌ أرخت زاهٍ ببابها","يقول ألم نشرح مقالاً محققا",43,"ق",2,0],["لها راحة تولى العنا بغنائها","فمن كان منها خاسراً كان رابحا",44,"ح",2,0],["لها رضاع من جسوم بها","يعود للأرواح منها فطام",45,"م",1,0],["لها رونق في السمع راق وإنما","أفاض عليها نور مدحك رونقا",46,"ق",2,0],["له اربع تبدو المسامع بينها","وما زاد في شيب على السبع والعشر",47,"ر",1,0],["لَها رَبِذاتٌ بِالنَجاءِ كَأَنَّها","دَعائِمُ أَرزٍ بَينَهُنَّ فُروجُ",48,"ج",1,0],["لها رونق لا يخمد الدهر نوره","منقحة من كل عيب مشذبه",49,"ب",2,0],["لهُ أَرَجٌ كلما رامَ أنْ","يزورَ المحبَّ عليهِ وَشى",50,"ش",2,0],["لها ريق على ما","شهد المسواك من شهد",51,"د",1,0],["لهُ أرجٌ بنفحتِ تُحَيّا","عرانينُ المكارمِ والمَعالي",52,"ل",2,0],["لهُ أرجٌ من طِيبِ ما تلتقي بهِ","لأينَعَ يندى من أراكٍ ومن سِدرِ",53,"ر",1,0],["لها رغم الحيا طرف سقيم","ولكن كم رماني بالنبال",54,"ل",1,0],["لها ريح محبوب وقسوة قلبه","ولون محب حلة السقم مكتسي",55,"س",2,0],["لَها رَأسُ لَيثٍ على ذَيلِ أَفعى","عَلى جِسمِ تَيسٍ مِنَ المَعزِ يَرعى",56,"ع",2,0],["لَهَا رُسُغٌ مُكرَبٌ أَيِّدٌ","فَلا العَظمُ وَاهٍ وَلا العِرقُ فَارَا",57,"ر",2,0],["لها رِدفٌ تعلَّق من لَطيف","وذاكَ الرِدفُ لي ولها ظلومُ",58,"م",1,1],["لها ريح إذا بُزِلَتْ","كعَرْف المسكِ إذْ راحا: من الرّيح",59,"ح",1,0],["له أرسلت من طرف خفي","رسول محبة تنمي غرامي",60,"م",2,0],["لها ربٌّ يُتوِّجُها بِنُورٍ","هُوَ النُّورُ الإلهِيُّ المُضَاءُ",61,"ا",2,0],["لها رؤوسٌ هي الأذنابُ ..ما نطقتْ","يومًا بغير رضا المستعمر العَفِنِ ..!",62,"ن",1,0],["لَها رِيقَةٌ بارِدٌ رَشْفُها","كَماءِ الغَمامِ وَمَزْجِ العَسَلْ",63,"ل",1,0],["لَها رِيقَةٌ سائِغٌ رَشْفُها","كأَنَّ بِرِيقَتِها الزَّنْجَبِيلا",64,"ل",2,0],["لهارب منْ شتاء ظل يرْدِمُهُ","من رعشة العُمْر من قيظ التجاعيد",65,"د",1,0]]}