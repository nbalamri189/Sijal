{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[73,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"أبا حسن لم أمس من حال بالكم","https://www.aldiwan.net/poem66724.html","البسيط"],[91,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[91,"السحب تركض في الفضاء ركض الخائفين","https://www.aldiwan.net/poem62795.html","عموديه"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[45,"أقم علها أن ترجع القول أو علي","https://www.aldiwan.net/poem65594.html","الطويل"],[45,"عناني من صدودك ما عناني","https://www.aldiwan.net/poem66682.html","الوافر"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[102,"وجه القضية من جهادك مشرق","https://www.aldiwan.net/poem32989.html","الكامل"],[52,"بخلا بهذا الدهر لست أراك","https://www.aldiwan.net/poem26770.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199491","البسيط"],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[130,"أبعد الشيب تبكى بالديار","https://www.aldiwan.net/poem54834.html","الوافر"],[141,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[167,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[210,"ما بال قلبك لا ينفك من سقم","https://www.aldiwan.net/poem37833.html","البسيط"],[219,"ذهب الوفاء فلا ندامه","https://www.aldiwan.net/poem55272.html","مجزوء الكامل"],[227,"جادك الغيث من محلة دار","https://www.aldiwan.net/poem51068.html","الخفيف"],[259,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[269,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[273,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[283,"ما بالكم لم تفوا بالعهد وانفصلت","https://www.aldiwan.net/poem39336.html","البسيط"],[295,"يا نسيم الصبا متى جزت نجدا","https://www.aldiwan.net/poem33288.html","الخفيف"],[351,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[359,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[362,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[377,"أحريق أم غرام","https://www.aldiwan.net/poem48801.html","مجزوء الرمل"],[399,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[413,"جاء الربيع بورده وبهاره","https://www.aldiwan.net/poem54045.html","الكامل"],[429,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[429,"أندى وجه وسيم","https://www.aldiwan.net/poem12425.html","مجزوء الرمل"],[429,"لست أدري أتحفة تتهادى","https://www.aldiwan.net/poem12431.html","الخفيف"],[429,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[450,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[549,"شاقك البرق اليماني","https://www.aldiwan.net/poem47375.html","مجزوء الرمل"],[562,"أأنت على عهد المحبة ماكث","https://www.aldiwan.net/poem830.html",""]],"verses":[["أَمُبَلِّغي ما أَطلُبُ الغَزَلُ","أَم لا فَتُنجِدُني القَنا الذُبُلُ",0,"ل",1,1],["أَم بِرِّكِ العَذبِ الجَمامِ","وَبِشرِكَ الغَضِّ الجَميم",1,"م",1,0],["أَم بِالبَدائِعِ كَاللَآلِئِ","مِن نَثيرٍ أَو نَظيم",1,"م",1,0],["أَمْ بِأَيْرٍ أتى الخِصَاءُ عليه","غَيْرَ مُبْقٍ فاجْتِيحَ أيَّ اجْتِياحِ",2,"ح",1,0],["أم بقَدٍّ كأنه قَدُّ زِقِّ","زِيدَ عرضاً ببطنك المُنْدَاحِ",2,"ح",1,0],["أمبتورةٌ عندي صنيعةُ كامل","وقد شَهِدَتْ آراؤه بكماليا",3,"ل",3,0],["أَم بَعدَ هَذا يَقظَةٌ حُلوَةٌ","يَنسى بِها المَرءُ الشَقا وَالسُقام",4,"م",1,0],["أَم بِالعَصافيرِ الَّتي تَعدو إِلى وَكَناتِها","أَم بِالمَسا إِنَّ المَسا يَخفي المَدائِنَ كَالقُرى",5,"ر",2,0],["أَم بِساطُ الريحِ رَدَّتهُ النَوى","بَعدَ ما طَوَّفَ في الدَهرِ وَساح",6,"ح",1,0],["أَم بِعَينَيهِ إِذا ما جالَتا","تَكشِفانِ الجَوَّ غَيثاً أَم جَهاما",7,"م",2,0],["أَم بِأَظفارٍ إِذا شَبَّكَها","نَفَذَت في الريحِ دَفعاً وَاِستِلاما",7,"م",2,0],["أَم بِالتَكاتُفِ حَولَ الحَقِّ في بَلَدٍ","مِن أَربَعينَ يُنادي الوَيلَ وَالحَرَبا",8,"ب",2,0],["أَمُبلِغَتي أَيدي الرَواسِمِ جَعفَراً","فَأَحمَدَ في قَولٍ وَيُحمَدَ في فِعلِ",9,"ل",1,0],["أَمُبهِجَتي العِراقُ وَلَيسَ فيها","عَقيدايَ اللَذانِ تَكَنَّفاني",10,"ي",1,0],["أَم بِأَعلى ذي الأَراكِ لَهُم","مَربَعٌ قَد جادَهُ المَطَرُ",11,"ر",1,0],["أَم بثُّك الشَكوى تَظن بَيانَها","سحراً وَحجَّتها الضحى يَتَأَلَقُ",12,"ق",1,0],["أَم بَردُ ظِلِّكَ ذي العُيونِ وَذي الحَيا","أَم أَرضُكِ المَيثاءُ أَم رَيّاكِ",13,"ك",1,0],["أم بدا للإِلهِ في ذَبْحِ إِسْحَا","قَ وقد كان الأمر فيه مَضاءُ",14,"ا",2,0],["إمبراطورُك في هَمٍّ وسُهدِ","صائحاً في ليلهِ لو كان يُجْدي",15,"ي",1,0],["أمْ بِعْتِهَا تَبْتَغِينَ مَصْلَحَةً","في سَنَةٍ والسماءُ لم تَغِمِ",16,"م",1,0],["أَمْ بِآدَابٍ وَأَلْحَانٍ يَهِي","مَعَهَا العَزْمُ وَتَقْوَى الشَّهَوَاتُ",17,"ت",1,0],["أم بالحياةِ التي ولَّتْ نضارتُها؟","أم بالعزيمةِ أصمت قلبَها العِلَلُ؟",18,"ل",1,0],["أم بالرفاقِ الأحباءِ الأُلى ذهبوا","وخلَّفوني لعيشٍ أُنسُه مَلَلُ؟",18,"ل",1,0],["أم بين دَوحِكِ -ليت شعري- دوحةٌ","أخرى تشاهدُ بيعةَ الأنْصار؟",19,"ر",1,0],["أمبترِداتٌ بالخُمورِ تثلَّجَتْ","وبالماءِ يَغلي بالعُطورِ الفواغِم",20,"م",1,0],["أمُبيَضَّ العِذَارِ دَعِ العَذَارَى","فَمَالَكَ مِن نَصِيبٍ في العَذَارِي",21,"ي",1,0],["أَم بَذلِ عَفوِكَ وَالذُنوبُ كَثيرَةٌ","أَم قَطعِ عَزمِكَ وَالسُيوفُ نَوابِ",22,"ب",1,0],["أَم بِناهُ لِجامِعٍ لَم يَدَع لل","قَولِ مَعنىً في وَصفِ ذاتِ العِمادِ",23,"د",1,0],["أَم بِنا السُورِ الَّذي صارَ مُذ تَم","مَ قَذىً في عُيونِ أَهلِ الفَسادِ",23,"د",1,0],["أم بارقٌ لاحَ نجديِّاً بِسَاريةٍ","يَجْتَاحُ في عَرْضِها كالصارمِ الخَذِمِ",24,"م",1,0],["أم بالجدود وأنتم ال","آن الصعاليك اللمامه",25,"م",2,0],["أم بإرث ورِثتموه فإنا","نحن أهلُ الآثارِ والأخطار",26,"ر",1,0],["أم بسهو أخرتني عن رحيلي","واعتقادي ما غال فهمك سهو",27,"و",1,0],["أَم باتَ يرقب نارا بالحمى وَقدت","يا موقد النار لا عذبت بالنار",28,"ر",1,0],["أمبتسم الأضحَى ومَطلع الفِطرِ","أم الدّولَة الغَراء وَضاحَة البشرِ",29,"ر",1,1],["ام بدلت بالرضا سخطا نفوسكم","وبالتحية والتسليم ما اشتغلت",30,"ت",1,0],["أَم بِلَيلى عَرَّجتَ لَيلاً فَقَبَّل","تَ ثُغَيراً منها وَعانقتَ قَدّا",31,"د",2,0],["أَم بِبَديع الطِرس قَد سطّرت","رِسالة مَحكمة الإِنسِجام",32,"م",1,0],["أَم بَرق نُعمان لما","بَدا من النورِ أَوهَم",33,"م",1,0],["أمُبَلِّغي ما قد رَجَوْتُ ولم أسَلْ","ما لو غَدوتَ مُحكِمي لم يَزدَد",34,"د",1,0],["أَم بُكائي كُلَّما لا","حَ مِن البَرق اِبتِسام",35,"م",1,0],["أَمُبلّغَ الأَملِ الطَّويل ووارثَ","المجدِ الأَثيل وملجأَ القُصَّادِ",36,"د",1,0],["أمبادرَ اللّذّات أَيَّةَ آية","أجرى بسعي منادمٍ وبداره",37,"ر",2,0],["أَمُبيدَ العدوِّ كَسْراً وأَسْراً","ومُفِيدَ الوَليِّ مالاً وآلا",38,"ل",2,0],["أَم بُنَيَّاتُ كريمٍ","لا بُنَيَّاتُ كروم",39,"م",1,0],["أَم بياضُ الخدودِ نَشْرَ طِرْساً","وسوادُ الأَصداغِ سالَ مِدادا",40,"د",2,0],["أم باكرتْهُ يدُ الهَوى بمُدامةٍ","صِرْفٍ فباتَ لها صريعَ خُمارِ",41,"ر",1,0],["أمْ بنتُ فكر زفها الودُّ لمن","راحَ بطيب الوصل منها طامعا",42,"ع",2,0],["أم بانَ سُكَّانٌ فأملحَ لي","ما كان قبلَ البين أستحلي",43,"ل",2,0],["أم بطاحُ الشّجرِ الغَرْ","بيِّ في الدَّوِّ حريقُ",44,"ق",1,0],["أمبتدعاً في الحب ثبتاً فإنني","أتيتك عن علم بهذا اباحث",45,"ث",1,0]]}