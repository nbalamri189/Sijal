em/111489","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136912",""],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127145","السريع"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90882","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94374","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135087","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136665",""],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101285","الخفيف"],[4584,"","https://poetry.dctabudhabi.ae/diwan/poem/141862","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141685","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120480","الكامل"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105489","الخفيف"],[242,"حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","https://www.poetsgate.com/ViewPoem.aspx?id=38124",""],[4852,"حوت البلاء","https://www.poetsgate.com/ViewPoem.aspx?id=214334",""],[4988,"من هبس انا إيه !","https://www.poetsgate.com/ViewPoem.aspx?id=213920",""],[4988,"رحيل ومحطات","https://www.poetsgate.com/ViewPoem.aspx?id=215968",""],[5102,"لاهية","https://www.poetsgate.com/ViewPoem.aspx?id=12886",""],[5183,"ثورة العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185645",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[5493,"إعدام أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=197210",""],[5561,"تركوها","https://www.poetsgate.com/ViewPoem.aspx?id=192910",""],[5596,"الكيذاوي","https://www.poetsgate.com/ViewPoem.aspx?id=206478",""],[5894,"أبسحر عينك قد وصلت بكائي","https://www.poetsgate.com/ViewPoem.aspx?id=131410",""],[242,"حبل الدنا يا مبتغيه رث","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563804",""]],"verses":[["أَمُبَلِّغي ما أَطلُبُ الغَزَلُ","أَم لا فَتُنجِدُني القَنا الذُبُلُ",0,"ل",1,1],["أَم بِرِّكِ العَذبِ الجَمامِ","وَبِشرِكَ الغَضِّ الجَميم",1,"م",1,0],["أَم بِالبَدائِعِ كَاللَآلِئِ","مِن نَثيرٍ أَو نَظيم",1,"م",1,0],["أَمْ بِأَيْرٍ أتى الخِصَاءُ عليه","غَيْرَ مُبْقٍ فاجْتِيحَ أيَّ اجْتِياحِ",2,"ح",1,0],["أم بقَدٍّ كأنه قَدُّ زِقِّ","زِيدَ عرضاً ببطنك المُنْدَاحِ",2,"ح",1,0],["أمبتورةٌ عندي صنيعةُ كامل","وقد شَهِدَتْ آراؤه بكماليا",3,"ل",3,0],["أَم بَعدَ هَذا يَقظَةٌ حُلوَةٌ","يَنسى بِها المَرءُ الشَقا وَالسُقام",4,"م",1,0],["أَم بِالعَصافيرِ الَّتي تَعدو إِلى وَكَناتِها","أَم بِالمَسا إِنَّ المَسا يَخفي المَدائِنَ كَالقُرى",5,"ر",2,0],["أَم بِساطُ الريحِ رَدَّتهُ النَوى","بَعدَ ما طَوَّفَ في الدَهرِ وَساح",6,"ح",1,0],["أَم بِعَينَيهِ إِذا ما جالَتا","تَكشِفانِ الجَوَّ غَيثاً أَم جَهاما",7,"م",2,0],["أَم بِأَظفارٍ إِذا شَبَّكَها","نَفَذَت في الريحِ دَفعاً وَاِستِلاما",7,"م",2,0],["أَم بِالتَكاتُفِ حَولَ الحَقِّ في بَلَدٍ","مِن أَربَعينَ يُنادي الوَيلَ وَالحَرَبا",8,"ب",2,0],["أَمُبلِغَتي أَيدي الرَواسِمِ جَعفَراً","فَأَحمَدَ في قَولٍ وَيُحمَدَ في فِعلِ",9,"ل",1,0],["أَمُبهِجَتي العِراقُ وَلَيسَ فيها","عَقيدايَ اللَذانِ تَكَنَّفاني",10,"ن",2,0],["أَم بِأَعلى ذي الأَراكِ لَهُم","مَربَعٌ قَد جادَهُ المَطَرُ",11,"ر",1,0],["أَم بثُّك الشَكوى تَظن بَيانَها","سحراً وَحجَّتها الضحى يَتَأَلَقُ",12,"ق",1,0],["أَم بَردُ ظِلِّكَ ذي العُيونِ وَذي الحَيا","أَم أَرضُكِ المَيثاءُ أَم رَيّاكِ",13,"ك",1,0],["أم بدا للإِلهِ في ذَبْحِ إِسْحَا","قَ وقد كان الأمر فيه مَضاءُ",14,"ا",2,0],["إمبراطورُك في هَمٍّ وسُهدِ","صائحاً في ليلهِ لو كان يُجْدي",15,"ي",1,0],["أمْ بِعْتِهَا تَبْتَغِينَ مَصْلَحَةً","في سَنَةٍ والسماءُ لم تَغِمِ",16,"م",1,0],["أَمْ بِآدَابٍ وَأَلْحَانٍ يَهِي","مَعَهَا العَزْمُ وَتَقْوَى الشَّهَوَاتُ",17,"ت",1,0],["أم بالحياةِ التي ولَّتْ نضارتُها؟","أم بالعزيمةِ أصمت قلبَها العِلَلُ؟",18,"ل",1,0],["أم بالرفاقِ الأحباءِ الأُلى ذهبوا","وخلَّفوني لعيشٍ أُنسُه مَلَلُ؟",18,"ل",1,0],["أم بين دَوحِكِ -ليت شعري- دوحةٌ","أخرى تشاهدُ بيعةَ الأنْصار؟",19,"ر",1,0],["أم بانقيادك عزما خلف أشعثها","يفري أديمك لا يألو بلا ظفر",20,"ر",1,0],["أم بعد اعجالها الأبرار تنسفهم","نسف الزعازع ننهاها عن العجل",21,"ل",1,0],["أمبترِداتٌ بالخُمورِ تثلَّجَتْ","وبالماءِ يَغلي بالعُطورِ الفواغِم",22,"م",1,0],["أمُبيَضَّ العِذَارِ دَعِ العَذَارَى","فَمَالَكَ مِن نَصِيبٍ في العَذَارِي",23,"ر",2,0],["أَم بَذلِ عَفوِكَ وَالذُنوبُ كَثيرَةٌ","أَم قَطعِ عَزمِكَ وَالسُيوفُ نَوابِ",24,"ب",1,0],["أَم بِناهُ لِجامِعٍ لَم يَدَع لل","قَولِ مَعنىً في وَصفِ ذاتِ العِمادِ",25,"د",1,0],["أَم بِنا السُورِ الَّذي صارَ مُذ تَم","مَ قَذىً في عُيونِ أَهلِ الفَسادِ",25,"د",1,0],["أم بارقٌ لاحَ نجديِّاً بِسَاريةٍ","يَجْتَاحُ في عَرْضِها كالصارمِ الخَذِمِ",26,"م",1,0],["أم بالجدود وأنتم ال","آن الصعاليك اللمامه",27,"م",2,0],["أم بإرث ورِثتموه فإنا","نحن أهلُ الآثارِ والأخطار",28,"ر",1,0],["أم بسهو أخرتني عن رحيلي","واعتقادي ما غال فهمك سهو",29,"و",1,0],["أَم باتَ يرقب نارا بالحمى وَقدت","يا موقد النار لا عذبت بالنار",30,"ر",1,0],["أمبتسم الأضحَى ومَطلع الفِطرِ","أم الدّولَة الغَراء وَضاحَة البشرِ",31,"ر",1,1],["ام بدلت بالرضا سخطا نفوسكم","وبالتحية والتسليم ما اشتغلت",32,"ت",1,0],["أَم بِلَيلى عَرَّجتَ لَيلاً فَقَبَّل","تَ ثُغَيراً منها وَعانقتَ قَدّا",33,"د",2,0],["أَم بِبَديع الطِرس قَد سطّرت","رِسالة مَحكمة الإِنسِجام",34,"م",1,0],["أَم بَرق نُعمان لما","بَدا من النورِ أَوهَم",35,"م",1,0],["أمُبَلِّغي ما قد رَجَوْتُ ولم أسَلْ","ما لو غَدوتَ مُحكِمي لم يَزدَد",36,"د",1,0],["أَم بُكائي كُلَّما لا","حَ مِن البَرق اِبتِسام",37,"م",1,0],["أَمُبلّغَ الأَملِ الطَّويل ووارثَ","المجدِ الأَثيل وملجأَ القُصَّادِ",38,"د",1,0],["أمبادرَ اللّذّات أَيَّةَ آية","أجرى بسعي منادمٍ وبداره",39,"ر",2,0],["أَمُبيدَ العدوِّ كَسْراً وأَسْراً","ومُفِيدَ الوَليِّ مالاً وآلا",40,"ل",2,0],["أَم بُنَيَّاتُ كريمٍ","لا بُنَيَّاتُ كروم",41,"م",1,0],["أَم بياضُ الخدودِ نَشْرَ طِرْساً","وسوادُ الأَصداغِ سالَ مِدادا",42,"د",2,0],["أم باكرتْهُ يدُ الهَوى بمُدامةٍ","صِرْفٍ فباتَ لها صريعَ خُمارِ",43,"ر",1,0],["أمْ بنتُ فكر زفها الودُّ لمن","راحَ بطيب الوصل منها طامعا",44,"ع",2,0],["أم بانَ سُكَّانٌ فأملحَ لي","ما كان قبلَ البين أستحلي",45,"ل",2,0],["أم بطاحُ الشّجرِ الغَرْ","بيِّ في الدَّوِّ حريقُ",46,"ق",1,0],["أمبتدعاً في الحب ثبتاً فإنني","أتيتك عن علم بهذا اباحث",47,"ث",1,0],["أم بالبهاء شموس العز قد سطعت","تجلو أشعتها من بؤسنا الظلما",48,"م",2,0],["امبان اول منشئ لبقاعها","بل في جميع المنشئات الاول",49,"ل",1,0],["أَم بذات الغضا ركائب نجد","عارضته فهيجت منه داءا",50,"ا",3,0],["أَم بَدر أُنس بَدَت أَنواره فَجلت","مِن المحاسن ما تَزهو مَعانيها",51,"ي",3,0],["أَم بكبر وَقَسوة وَعناد","أَم بِكُفر ومسخة وَتَعامي",52,"م",2,0],["أَم بشرّ للعالمين وَشرك","أَم بظلم لحوز قائمّقام",52,"م",1,0],["أمبْتُوتَةً تَهْوَى الرّجوعَ لِزوجِها","عليكَ بقاضي بسطةَ ابِن مُفَضَّلِ",53,"ل",1,1],["أم بعد باريس أرضى","في قرية كل هم",54,"م",1,0],["أم بعد ما أمن الأعادي ليلة","يأبى على الخلصاء أن يتكلموا",55,"م",3,0],["ام بدور طوالع مسفرات","ام شموس ليلا ترينا الهلالا",56,"ل",2,0],["أَم بَريقُ الثَّغرِ مِن ذاكَ اللوى","قَد تَبَدّى لائِحاً تَحتَ اللِّثامِ",57,"م",1,0],["أم بماذا أدلي وما لي عذر","غير أني اسأت فعلا وقيلا",58,"ل",2,0],["أم بالرسل والملائك لما","أرسل الله خلفه جبريلا",58,"ل",2,0],["أم بالرسل والأملاك طرا","في مقام الإجلال والتوقير",59,"ر",1,0],["أم بالأملاك في سماء","والرسل طرا على انفراد",60,"د",1,0],["أم بليلي فتة أم برباب","أم بسلمى شغفت أم بسعاد",61,"د",1,0],["أم بالرسل والأملاك جمعا","في مقام حباه بالأفراد",61,"د",1,0],["أَم بُرودٌ طَرَّزَتها","في الرُبى أَيدي السَحائِب",62,"ب",1,0],["أَمْ بأْسُهُ المُتَصَدِّي في الوَغى قِبَلاً","أَم عَدْلُهُ المُتَبَدي للْوَرى قَبْلَهْ",63,"ل",2,0],["أم باب إبراهيمَ أقصدُهُ","هيهاتَ خاب الظّنُّ والحدْسُ",64,"س",1,0],["أم بانقيادك عزماً خلف أشعثها","يفري أديمك لا يألوا بلا ظفر",65,"ر",1,0],["أم بقولي إن الزمان لئيم","طبعه الغدر بالأديب اللبيب",66,"ب",1,0],["أم براعيمُ سندسٍ قد أحاطت","بخدودٍ يذكى عليها الحياءُ",67,"ا",2,1],["أمّ بالأنبياء والرسل جمعا","ثم أنهى صلاته وقيامه",68,"م",2,0],["أَم بِعَبدٍ فَأَنتِ أَهلٌ لِعَبدٍ","أَم بُدونٍ فَأَنتَ أَهلٌ لِدونِ",69,"ن",1,0],["أم بدر حسن طالع","من حسنه الأقمار غارت",70,"ت",1,0],["أم بات فيك من الشّقا عللٌ","قل لي لعلّي أدفع العللا",71,"ل",2,0],["أمباري الرشأ الغرير","ومحاكي الغصن النضير",72,"ر",1,1],["أم بَطِرتُنَّ إِذ بَشِمتُنَّ يوماً","من فُروعٍ منَ البَشامِ لِدَانِ",73,"ن",1,0],["أَم بِحلٍّ في كُلِّ فَصلٍ بِقُطرٍ","وَبُطونُ الثَرى مَحَطُّ رِحالِك",74,"ك",1,0],["أَم بِأَصلٍ مِنَ الحَضيضِ حَقيرٍ","كُلَّ يَومٍ تَدوسُهُ بِنِعالِك",74,"ك",1,0],["أم بأمر يصبو إلى دعواه","وبأمر يصبوا إلى دعواها",75,"ا",3,0],["أم بان عن أوطانه","قسراً وغُول الدهر غاله",76,"ل",2,0],["أمبدي الندى ومبيد العدا","فإن شاء ساء وإن شاء سَرّ",77,"ر",1,0],["أمبيح قتل العاشقين بفاتر","وسنان يهزأ بالقلوب مضاؤه",78,"ا",3,0],["أمبارز الدين انتهزها فرصة","في حق من يثني عليك ويشكر",79,"ر",1,0],["أمبارز الدين الذي اعتلقت يدي","منه بأوكد ذمة لم تخفر",80,"ر",1,0],["أَم بَعيدٌ أَن يُظمِئونا فَنردَى","بَينَ ذاوي الرِياضِ فَهيَ القُبورُ",81,"ر",1,0],["أم بانتقالك من مجاورة العنا","والهمِّ نحو الروح والريحان",82,"ن",1,0],["آمُبيحَها فَضلَ الأَزِمَّةِ قُصَّرِ","فَمَعَ الصَّباحِ تَحِيَّةٌ مِن عَرعَرِ",83,"ر",1,1],["أَم بِهِ أُخذَةٌ فَقَد","تُطلِقُ الأُخذَةُ النُشَر",84,"ر",1,0],["أم بروج السماء قد لاح فيها","لدراري زهر النجوم مطالع",85,"ع",1,0],["أم بروق لوامع تتجلى","أم ثغور أم عقد در منضد",86,"د",1,0],["امبلغ العلياء بغيتها","بلغ العلى بعلاك ما بلغا",87,"غ",2,0],["أم بقاع البحر أم بال","جو أم بين الرعود",88,"د",1,0],["أمّ بالزهو مهرجانَ المعرّي","وزراءٌ ففرَّ من مهرجانه",89,"ن",2,0],["أمبشر يهدي العباد لدينه","أم ضيفن مذق اللسان محاب",90,"ب",1,0],["أم بعبدٍ وأنتِ أهلٌ لعبدٍ","أم بدوُنٍ وأنتِ أهلٌ لدون",91,"ن",1,0],["ام بدر تم هاويا من افقه","ام صارما في الترب اصبح ثاويا",92,"ي",2,0],["أم بانشِقَاقِ البدرِ وفقَ الذي أتي","مِنهُ علَى شَرطِ الَّذي يَتَوَهَّمُ",93,"م",1,0],["أم بالأسَالِيبِ التي بِيَمينِهَا","سَيفُ البَلاَغَةِ وهوَ عَضبٌ مِحذَمُ",93,"م",1,0],["أم بلبل البشر استهل بروضةٍ","أهدت لنُور الزُهر نَور الزَهر",94,"ر",1,0],["أم بلبل البشرى غدا قائلاً","تهنَى البلاد بابن خير العب