{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[73,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"أبا حسن لم أمس من حال بالكم","https://www.aldiwan.net/poem66724.html","البسيط"],[91,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[91,"السحب تركض في الفضاء ركض الخائفين","https://www.aldiwan.net/poem62795.html","عموديه"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[45,"أقم علها أن ترجع القول أو علي","https://www.aldiwan.net/poem65594.html","الطويل"],[45,"عناني من صدودك ما عناني","https://www.aldiwan.net/poem66682.html","الوافر"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[102,"وجه القضية من جهادك مشرق","https://www.aldiwan.net/poem32989.html","الكامل"],[52,"بخلا بهذا الدهر لست أراك","https://www.aldiwan.net/poem26770.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199491","البسيط"],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""]],"verses":[["أَمُبَلِّغي ما أَطلُبُ الغَزَلُ","أَم لا فَتُنجِدُني القَنا الذُبُلُ",0,"ل",1,1],["أَم بِرِّكِ العَذبِ الجَمامِ","وَبِشرِكَ الغَضِّ الجَميم",1,"م",1,0],["أَم بِالبَدائِعِ كَاللَآلِئِ","مِن نَثيرٍ أَو نَظيم",1,"م",1,0],["أَمْ بِأَيْرٍ أتى الخِصَاءُ عليه","غَيْرَ مُبْقٍ فاجْتِيحَ أيَّ اجْتِياحِ",2,"ح",1,0],["أم بقَدٍّ كأنه قَدُّ زِقِّ","زِيدَ عرضاً ببطنك المُنْدَاحِ",2,"ح",1,0],["أمبتورةٌ عندي صنيعةُ كامل","وقد شَهِدَتْ آراؤه بكماليا",3,"ل",3,0],["أَم بَعدَ هَذا يَقظَةٌ حُلوَةٌ","يَنسى بِها المَرءُ الشَقا وَالسُقام",4,"م",1,0],["أَم بِالعَصافيرِ الَّتي تَعدو إِلى وَكَناتِها","أَم بِالمَسا إِنَّ المَسا يَخفي المَدائِنَ كَالقُرى",5,"ر",2,0],["أَم بِساطُ الريحِ رَدَّتهُ النَوى","بَعدَ ما طَوَّفَ في الدَهرِ وَساح",6,"ح",1,0],["أَم بِعَينَيهِ إِذا ما جالَتا","تَكشِفانِ الجَوَّ غَيثاً أَم جَهاما",7,"م",2,0],["أَم بِأَظفارٍ إِذا شَبَّكَها","نَفَذَت في الريحِ دَفعاً وَاِستِلاما",7,"م",2,0],["أَم بِالتَكاتُفِ حَولَ الحَقِّ في بَلَدٍ","مِن أَربَعينَ يُنادي الوَيلَ وَالحَرَبا",8,"ب",2,0],["أَمُبلِغَتي أَيدي الرَواسِمِ جَعفَراً","فَأَحمَدَ في قَولٍ وَيُحمَدَ في فِعلِ",9,"ل",1,0],["أَمُبهِجَتي العِراقُ وَلَيسَ فيها","عَقيدايَ اللَذانِ تَكَنَّفاني",10,"ي",1,0],["أَم بِأَعلى ذي الأَراكِ لَهُم","مَربَعٌ قَد جادَهُ المَطَرُ",11,"ر",1,0],["أَم بثُّك الشَكوى تَظن بَيانَها","سحراً وَحجَّتها الضحى يَتَأَلَقُ",12,"ق",1,0],["أَم بَردُ ظِلِّكَ ذي العُيونِ وَذي الحَيا","أَم أَرضُكِ المَيثاءُ أَم رَيّاكِ",13,"ك",1,0],["أم بدا للإِلهِ في ذَبْحِ إِسْحَا","قَ وقد كان الأمر فيه مَضاءُ",14,"ا",2,0],["إمبراطورُك في هَمٍّ وسُهدِ","صائحاً في ليلهِ لو كان يُجْدي",15,"ي",1,0],["أمْ بِعْتِهَا تَبْتَغِينَ مَصْلَحَةً","في سَنَةٍ والسماءُ لم تَغِمِ",16,"م",1,0],["أَمْ بِآدَابٍ وَأَلْحَانٍ يَهِي","مَعَهَا العَزْمُ وَتَقْوَى الشَّهَوَاتُ",17,"ت",1,0],["أم بالحياةِ التي ولَّتْ نضارتُها؟","أم بالعزيمةِ أصمت قلبَها العِلَلُ؟",18,"ل",1,0],["أم بالرفاقِ الأحباءِ الأُلى ذهبوا","وخلَّفوني لعيشٍ أُنسُه مَلَلُ؟",18,"ل",1,0],["أم بين دَوحِكِ -ليت شعري- دوحةٌ","أخرى تشاهدُ بيعةَ الأنْصار؟",19,"ر",1,0],["أمبترِداتٌ بالخُمورِ تثلَّجَتْ","وبالماءِ يَغلي بالعُطورِ الفواغِم",20,"م",1,0]]}