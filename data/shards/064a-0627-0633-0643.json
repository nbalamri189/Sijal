{"poems":[[51,"المرء مستأثر بما ملكا","https://www.aldiwan.net/poem62203.html","المنسرح"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[33,"يا سكن قد والله رب محمد","https://www.aldiwan.net/poem42470.html","الكامل"],[102,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=50183",""],[154,"لاح وقد فاح بهار النهار","https://www.aldiwan.net/poem68475.html","السريع"],[303,"ثكلت مقلته طيب الكرى","https://www.aldiwan.net/poem36847.html","عموديه"],[309,"أنتم للعين والأثر","https://www.aldiwan.net/poem16825.html","المديد"],[309,"أنتم أنتم أحبة لقلبي","https://www.aldiwan.net/poem16894.html","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120049","المنسرح"],[1311,"","https://poetry.dctabudhabi.ae/diwan/poem/145434","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100410","الرجز"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118792","المديد"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4702,"سكرة الموج","https://www.poetsgate.com/ViewPoem.aspx?id=155104",""],[5111,"لوْ... لاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=212322",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[5830,"يا ظبية تختال ما بين الربى","https://www.poetsgate.com/ViewPoem.aspx?id=200690",""],[5848,"عود ثقاب","https://www.poetsgate.com/ViewPoem.aspx?id=53325",""],[5848,"الله يخليك","https://www.poetsgate.com/ViewPoem.aspx?id=48823",""],[5939,"لَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=185495",""],[5974,"ياسكون الليل","https://www.poetsgate.com/ViewPoem.aspx?id=215958",""],[5991,"يا ألمي منك إليك الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=116385",""],[161,"السُّكَّرُ والسُّكَّرِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=157685",""]],"verses":[["يا سَكرَةَ المَوتِ قَد نَصَبتِ لِهَ","ذا الخَلقِ في كُلِّ مَسلَكٍ شَرَكا",0,"ك",2,0],["يا سَكرَةَ المَوتِ أَنتِ واقِفَةٌ","لِلمَرءِ في أَيِّ آيَةٍ سَلَكا",0,"ك",2,0],["يا سكتةَ الموتِ، يا إعصارَ زوبعةٍ","يا خنجرَ الغدرِ، يا أغصانَ زيتون",1,"ن",1,0],["يا سُكنَ قَد وَاللَهِ رَبِّ مُحَمَّدٍ","أَقصَدتِ قَلبِي بِالدَلالِ فَعَوِّضي",2,"ض",2,1],["يا سُكنَ لَستُ وَإِن نَأَت بِكِ دارُكُم","بِالسالِ عَنكِ وَلا المَلولِ المُعرِضِ",2,"ض",1,0],["يا سُكنَ كَم مِمَن تَوَدَّدَ عِندَنا","أُقصي وَكَم مِن كاشِحٍ مُتَعَرِّضِ",2,"ض",1,0],["يا سُكنَ حُبُّكِ إِذ كَلِفتُ بِحُبِّكُم","غَرَضاً أَراهُ وَرَبِّ مَكَّةَ مُمرِضي",2,"ض",2,0],["يا سُكنَ كانَ العَهدُ فيما بَينَنا","وَيَمينُ صَبرٍ مِنكِ أَن لا تَنقُضي",2,"ض",2,0],["يا سكرة ابن الشعر هذا يومه","نغم يبعثره السنى ويلملمُ",3,"م",1,0],["يا سكَّن الله فؤادي بهم","فما له بَعدَهُمُ من قرار",4,"ر",1,0],["يا سكونَ الليل كم هيّجتَ من","لوعةٍ وَثابةٍ بين الحشا",5,"ا",1,0],["يا سكوناً في السريرة من","سر سرى لا من النظر",6,"ر",1,0],["يا سكوناً في مهجتي وفؤادي","لا بغور ولا بنجد وكثيب",7,"ب",1,0],["يا سكنا أزعج الفؤاد خف الل","ه وسكن غليل منزعجِ",8,"ج",1,0],["يا سكراً قبل أن ذقناه أسكرنا","ودرة نثرت في نطقها دررا",9,"ر",2,0],["يا سكن العشاق لولاك لما","كان هوى القلب ولا كان سكن",10,"ن",1,0],["يا سكوناً في ربي خلدي","وفوؤادي لا بذي سلمِ",11,"م",1,0],["يا سكرة لابد منها فانتبه","يا صاح هذا للجميع مصير",12,"ر",1,0],["يا سكرة الموج غاب العقل بك وانسرق","وجه القمر قبْل ضوّه حدْر ما بعثره",13,"ر",2,1],["يَا سَكْرَةَ الْقَمَرِ المَخْمُورِ فِيْ لُغَتِي","أوَّاهُ.. يَا قَمَرِي ْأوَّاهُ.. عَيْنَاكِ",14,"ك",1,0],["ياسكارى بغداد نهب سيوفٍ","فاناخت لطعنها الحدباءُ",15,"ا",2,0],["يَا سَكْرَةَ الحُبِّ البَدِيعِ تَرَفَّقِي","فَالسُّكْرُ خَمْرُكِ فَاقَ كُلَّ شَبِيهِ",16,"ي",2,0],["يا سكونٍ ما قدرت القى قراره","للفراش حكايته وسط الحديقه",17,"ق",2,0],["ياسك : أملك إنك تحقق أمانيك","أملك : ياسك ف ابتسامة محيّاك",18,"ك",1,0],["يا سُكّري المرشوشَ حُل","مًا فوقَ كَعْكَاتِ الألمْ",19,"م",1,0],["ياسكون الليل ..أتعبني السهر","والهوى والشوق ..هيج لي شجون",20,"ن",1,1],["يا سكن القلب من الاضطراب","يا سكن الروح من الاضطرار",21,"ر",1,0],["يا سكنى اهد لمن فيك هام","يا المي اهد لمن فيك جار",21,"ر",1,0],["يَا سُكرًا هَلْ تُرَى بِالفَاْلُ تُذْكَرُ أمْ","مِنْ هَمْسَةٍ ،يَسْتَعيذُ النَّاسُ إٍن ذُكِرَا",22,"ر",2,0]]}