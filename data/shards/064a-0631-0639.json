{"poems":[[55,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[65,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[57,"عبث الحبيب وكان منه صدود","https://www.aldiwan.net/poem26371.html","الكامل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[88,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[0,"الما على الربع القديم بِعسعسا","https://www.aldiwan.net/poem62.html",""],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[95,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[95,"ملك العراق تجلة وسلام","https://www.aldiwan.net/poem11313.html","الكامل"],[4,"ولدت بنو حرثان فرخ محرق","https://www.aldiwan.net/poem21146.html","الكامل"],[49,"هل تعطفان على العليل","https://www.aldiwan.net/poem25175.html","مجزوء الكامل"],[53,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[31,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[31,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[93,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[87,"سر يا صليب الرفق في ساح الوغى","https://www.aldiwan.net/poem63731.html","الطويل"],[45,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[47,"مغنيك للبغض فيه سمه","https://www.aldiwan.net/poem66635.html","البسيط"],[47,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[63,"درجني الحرف أي تدريج","https://www.aldiwan.net/poem51376.html","المنسرح"],[82,"حمى حمى الملك منه صارم ذكر","https://www.aldiwan.net/poem31408.html","البسيط"],[82,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[82,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[89,"ليس الصديق الذي تعلو مناسبه","https://www.aldiwan.net/poem8353.html","البسيط"],[71,"صبرا لصرف زمان قاطع الحجج","https://www.aldiwan.net/poem28921.html","البسيط"],[107,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[107,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[107,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[41,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[41,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[54,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[77,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[52,"راجعت دينك أم عنت لك الذكر","https://www.aldiwan.net/poem63829.html","البسيط"],[48,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54528","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54838","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[108,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[87,"ريم على القاع بين البان والعلم","https://www.poetsgate.com/ViewPoem.aspx?id=481",""],[41,"أعرفتَ ربعاً غيرَ آهلْ","https://www.poetsgate.com/ViewPoem.aspx?id=4267",""],[164,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[164,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[179,"أعلنت في حب جمُلٍ أي إعلان","https://www.aldiwan.net/poem393.html",""],[186,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[199,"إنا رضينا وإن غابت جماعتها","https://www.aldiwan.net/poem54374.html","البسيط"],[215,"مضت أسابيع والهتاف محتجب","https://www.aldiwan.net/poem46764.html","البسيط"],[233,"لم يخل قلبي من ذكر العزيز وإن","https://www.aldiwan.net/poem51109.html","البسيط"],[239,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[239,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[301,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[309,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[368,"يرعى الرجاء بنو أبيه فبينه","https://www.aldiwan.net/poem61011.html","الكامل"],[384,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[400,"أبني نُجيح إن أمكم","https://www.aldiwan.net/poem554.html",""],[409,"يا من يؤمل أن يفوز بصاحب","https://www.aldiwan.net/poem49413.html","الكامل"],[413,"حتى متى يا قلب لا تستفيق","https://www.aldiwan.net/poem32561.html","السريع"],[433,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[445,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[461,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[461,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[461,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[461,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[461,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[464,"لا أرهب الغدر ممن بات يضمره","https://www.aldiwan.net/poem15964.html","البسيط"],[469,"أمسى الشباب مودعا محمودا","https://www.aldiwan.net/poem50445.html","الكامل"],[503,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[517,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[518,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[518,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[519,"لأني لاخشى من قلاص ابن محرز","https://www.aldiwan.net/poem48602.html","الطويل"],[554,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[561,"جئنا إلى الحسن المعروف بالراعي","https://www.aldiwan.net/poem34367.html","البسيط"],[565,"يا أرض بيروت بشرانا وبشراك","https://www.aldiwan.net/poem52776.html","البسيط"],[565,"العلم فوق المال في إرشاده","https://www.aldiwan.net/poem52802.html","الكامل"],[565,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[565,"صدر به سعة وشوق أوسع","https://www.aldiwan.net/poem52989.html","الكامل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216845","السريع"]],"verses":[["يَرعَينَ أَثمارَ القُلوبِ تَوارِكاً","مَرعى رَبيعٍ بِاللَوى وَخَريفِ",0,"ف",1,0],["يَرعى النّجومَ إذا اسْتَرابَ بطَيفِهِ","هَلاّ اسْتَرابَ بطَرْفِهِ اليَقظانُ",1,"ن",1,0],["يَرعَينَ عَهدي ما شَهِدتُ فَإِن أَغِب","يَوماً فَما لي عِندَهُنَّ عُهودُ",2,"د",1,0],["يَرعى إِلى قَولِ ساداتِ الرِجالِ إِذا","أَبدَوا لَهُ الحَزمَ أَو ما شاءَهُ اِبتَدَعا",3,"ع",2,0],["يَرعى الأَراكَ ذا الكَباثِ وَذا ال","مَردِ وَزَهراً نَبتُهُنَّ خَضِل",4,"ل",1,0],["يَرعى لِموسى وَالمَسيحِ وَأَحمَدٍ","حَقَّ الوَلاءِ وَحُرمَةَ الأَديانِ",5,"ن",1,0],["يَرُعنَ إِلى صَوتي إِذا ما سَمِعنَهُ","كَما تَرعَوي عيطٌ إِلى صَوتِ أَعيَسا",6,"س",2,0],["يَرْعَى مَزَارَكَ بِالرُّوحِ الأَمِينِ وَلاَ","تَنْأَى بِهِ السُّبْلُ عَنْ أَعْقَابِكَ النُّجُبِ",7,"ب",1,0],["يَرْعَى الْطَّوَائِفَ شَتَّى فِي مَذَاهِبَهَا","وفي هَوَى مِصْرَ شَعْباً غَيْرَ مَنْشَعِبِ",8,"ب",1,0],["يَرْعَى كَرَامَتَهُ وَيَحْذَرُ كُلَّ مَا","يُزْرِي بِجَانِبِهَا الرَّفِيعِ الشَّانِ",9,"ن",1,0],["يَرْعَاكَ غَازِي مِنْ عُلاهُ وَ فَيْصَلٌ","وَيُعِزُّكِ الأَخْوَالُ وَالأَعْمَامُ",10,"م",1,0],["يَرعَونَ مُنخَرِقَ اللَديدِ كَأَنَّهُم","في العِزِّ أُسرَةُ حاجِبٍ وَشِهابِ",11,"ب",1,0],["يَرعى النُجومَ السائِرا","تِ مِنَ الطُلوعِ إِلى الأُفولِ",12,"ل",1,0],["يرعى عليهمْ أمورَ مملكةٍ","قامتْ بإخَلاله وإحماضه",13,"ض",2,0],["يُرعِي العفاةَ رياضَ العُرف مؤتنفاً","بهم ويرعى رياض الحمد مئنافا",14,"ف",2,0],["يَرعَينَ عَهدَكَ ما رَأَينَكَ شاهِداً","وَإِذا مَذِلتَ يَصِرنَ عَنكَ مِذالا",15,"ل",2,0],["يَرعى بِخَينَفَ أَحياناً وَتُضمِرُهُ","أَرضٌ خَلاءٌ وَماءٌ سائِلٌ غَلَلا",16,"ل",2,0],["يَرعى صَحارِيَ حامِزٍ أَصيافَها","وَلَهُ بِخَينَفَ مُنتَأىً وَتَخومُ",17,"م",1,0],["يَرعى نُجومَ اللَيلِ لَيسَ بِهِ هَوى","وَيَخالُهُ كَلِفاً بِهِنَّ الرائي",18,"ا",2,0],["يُرَعنَ لِلبَصَرِ السامي وَمِن عَجَبٍ","إِذا أَشَرنَ أَسَرنَ اللَيثَ بِالغَنَمِ",19,"م",1,0],["يَرعى كَرامَتَها وَيَمنَعُ حَوضَها","جَيشٌ يَعافُ البَغيَ وَالعُدوانا",20,"ن",2,0],["يُرعيكَ سَمعاً فيهِ اِستِماعٌ إِلى الد","داعي وَفيهِ عَنِ الخَنا صَمَمُ",21,"م",1,0],["يُرَعِّشُ لَحيَيهِ عِندَ الغِناءِ","كَأَنَّ بِهِ النافِضَ المُؤلِمَه",22,"م",2,0],["يَرِعنَ مِنكَ إِلى وَجهٍ يَرَينَ لَهُ","جَلالَةً يُكثِرُ التَسبيحَ رائيها",23,"ي",3,0],["يرعد تحتي ضعفا كسنبلة","بين مهب العواصف الهوج",24,"ج",1,0],["يرعى الرّعايا بعينٍ من حفيَظتِهِ","ويبسطُ العدلَ منه ليّنٌ قاسِ",25,"س",1,0],["يَرعَفُ اللَهذَمُ في راحَتِهِ","كُلَّما شَمَّ قُلوبَ الأُسُدِ",26,"د",1,0],["يرعى الفلا بفمٍ وترعى نحضَهُ","من منْسَمٍ للمَروِ ذي تشذيبِ",27,"ب",1,0],["يَرْعَاكَ فِي حَالَتَيْ بُعْدٍ وَمَقْرَبَةٍ","وَلا تُغِبُّكَ مِنْ خَيْرٍ فَوَاضِلُهُ",28,"ل",2,0],["يرعى اللئامَ ويغتالُ الكرامَ ولا","يخشى الملامَ بقلبٍ غيرِ مختلِجِ",29,"ج",1,0],["يَرْعَى الذِّمامَ إذا تَنكَّرَ غيرُه","ومَضَى بعافيةٍ كَأنْ لم يأثَمِ",30,"م",1,0],["يَرْعَى الضِّعافَ بهِ ويَمْلِكُ أَمْرَهُمْ","غَرثانُ يَلتهمُ الممالكَ صادِ",31,"د",1,0],["يَرُعْنَ مسابحَ العِقبانِ فيه","ويُفزِعْنَ الغياهِبَ والدُّجونا",32,"ن",2,0],["يَرعاهُ في شَرْخِ الصِّبى ومَشيبهِ","ويَصونُه للجيلِ بعدَ الجيلِ",33,"ل",1,0],["يَرعى هَواديها وَيُل","حِقُ بالِيَ الخُذلِ الزَوامِل",34,"ل",1,0],["يَرِعنَ لِمَسرابِ الضُحى مُتَأَنِّفٍ","ضَواحي رُباً تَحنو لَهُنَّ ضُلوعُ",35,"ع",1,0],["يَرعَمُ الشَمسَ أَن تَميل بِمِثل ال","جَبءِ جَأبٌ مُقَذَّفٌ بِالنِحاضِ",36,"ض",1,0],["يَرعى مَساقِطَ وابِلٍ","بِالدَيرِ وَالمَحَلاتِ",37,"ت",1,0],["يَرْعَوْنَ أَمْوَالَ الرَّعِيَّةِ بالأَذَى","لو يُحْلَبُونَ لأَشْبَهُوا الجامُوسا",38,"س",2,0],["يَرعاكَ والأرضُ الأريضَةُ دونَهُ","من بِيدِهِ وسُهولِهِ وحُزونه",39,"ن",2,0],["يَرعى الشِفاءَ وَأَهوالاً تُرَوِّعُهُ","دونَ الشِفاءِ فَلا يَأتي وَلا يَذُرُ",40,"ر",1,0],["يَرُعنَكَ إِن خَدَمَن بِغَيرِ فَنٍّ","إِذا رُحنَ العَشيَّ مُخَدَّماتِ",41,"ت",1,0],["يَرعاه شعب يستقل","لُ وأمة تتحرر",42,"ر",1,0],["يرعى على الأُفقِ المُرصَّع قريةً","أعظِمْ بها للغزو من ميناءِ",43,"ا",2,0],["يَرْعَى الْحُقُوقَ كَمَا يُعَلِّمُهَا","بِخُلُوصِ وَافى الرَّأْيِ مُسْتَدِّ",44,"د",1,0],["يَرْعَى مَدَارِسَهَا وَيَكْلأُ نِشْأَهَا","وَالنِّشْءُ لِلْعَهْدِ الجَدِيِدِ بِنَاءُ",45,"ا",2,0],["يَرْعى العَلِيلَ الَّذِي عُزَّتْ سَلاَمَتُهُ","وَالطِّفْلُ فِي المهْدِ وَالشَّيْخُ الَّذِي دَلَفَا",46,"ف",2,0],["يَرْعَاهُمَا وَيَسِيرُ فِي نَهْجِ الهُدَى","قَصْداً وَيَخْشَى اللهَ إِنْ هُوَ جَارَا",47,"ر",2,0],["يَرْعَى خُطَى حُفَدَائِهَا وَيُعِيذُهُمْ","فِي كُلِّ نُقْلَةِ خُطْوَةٍ بِدُعَاءِ",48,"ا",2,0],["يرعى الوداد، وما رأي","ت من الأنام فتىً رعاه",49,"ا",2,0],["يُرَعنَ لِلبَصَرِ السامي وَمِن عَجَبٍ","إِذا أَشَرنَ أَسَرنَ اللَيثَ بِالعَنَمِ",50,"م",1,0],["يَرْعَى هَوَادِيهَا، ويُلْ","فُ تناسخِ الحججِ النَّواسلْ",51,"ل",1,0],["يرعى الرعية من عذاب واقع","وأنامهم امنا على ممهود",52,"د",1,0],["يرعى القياس وما تقضى العقول به","من أن من لم يقدر راكب خطرا",53,"ر",2,0],["يَرعى المَوَدَّةَ وَالقَرابَةَ لا كَمَن","إِن قُمتَ نامَ وَإِن تُسَكِّتهُ حَدا",54,"د",2,0],["