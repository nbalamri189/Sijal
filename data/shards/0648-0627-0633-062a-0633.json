"https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[484,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107239","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48654","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62584","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96718","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96656","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104812","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53191","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53031","الكامل"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140242",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60825","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67976","الكامل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45236","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129374","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117949","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73117","السريع"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73366","الدوبيت"],[4859,"محيط مرامي","https://www.poetsgate.com/ViewPoem.aspx?id=197032",""],[4927,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=12986",""],[4927,"الغزال العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=29621",""],[4927,"الْحَبِيْبُ الْمُخْلِص","https://www.poetsgate.com/ViewPoem.aspx?id=29734",""],[5019,"يا أيها العارف المحكول ناظره","https://www.poetsgate.com/ViewPoem.aspx?id=157050",""],[5183,"مُلغِزَه رق293م","https://www.poetsgate.com/ViewPoem.aspx?id=186399",""],[5183,"وَقَارُ الحَوَادِثُ","https://www.poetsgate.com/ViewPoem.aspx?id=186446",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5187,"درس في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29792",""],[5365,"مالم تقلهُ زرقاءُ اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=190408",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5605,"من وحي رمضان 1436 ه","https://www.poetsgate.com/ViewPoem.aspx?id=177651",""],[5829,"اعلان حب هام","https://www.poetsgate.com/ViewPoem.aspx?id=150261",""],[6093,"قاصرة على شفة طريق","https://www.poetsgate.com/ViewPoem.aspx?id=198539",""],[6102,"حالة استسلام","https://www.poetsgate.com/ViewPoem.aspx?id=183613",""],[2575,"يا ناعس الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=10276",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[463,"بلوتُ هذا الدَّهرَ أطوارهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60087&r=&rc=143",""]],"verses":[["وَاِستَسلَمَ القَلبُ كَما اِستَسلَمَت","نَفسُكَ لِليَأسِ المَخوفِ الرَهيب",0,"ب",1,0],["واستسلفتْ ماءً وجادتْ بهِ","مُدامةً كالقبَسِ المُلهَبِ",1,"ب",1,0],["واستسلمي للحادثاتِ","المشفقاتِ على النِّيَامِ",2,"م",1,0],["وَاِستَسقِ مِنهُ إِن ظَمِئتَ غَمامَةً","يَخضَرُّ عَنها كُلُّ عودٍ يابِسِ",3,"س",1,0],["واسْتَسْلَمَ الوَحْشُ المَرُوعُ لِصَيْدِهِ","جُوعاً وصرَّ مِنَ الحَرورِ الجُنْدُبُ",4,"ب",1,0],["وَاسْتُسْمِعَتْ بَعْدَ الشْوَادِي فِي رُبَى","مِصْرٍ وَفِي الْوَادِي لُيُوثُ دِحَالِِ",5,"ل",1,0],["واستسلمتْ نفسي لاحلامِ الصبا","ولمَسْت طيف خيالها يقظانا",6,"ن",2,0],["واستسلموا طوع جبارين ما غضبوا","إلا أطاع من الجنان عاصيها",7,"ي",3,0],["واستسلموا إذ لم يروا تحت الثرى","نفقاً ولا فوقَ الثريا مصعداً",8,"د",2,0],["وَاِستَسقِ لِلدِمَنِ الخَوالي بِالحِمى","غُرَّ السَحائِبِ وَاِعتَذِر عَن أَدمُعي",9,"ع",2,0],["واستسلبتْ منهنَّ أيام العدى","لما رمينَ بعمره الهيجاءِ",10,"ا",2,0],["واستسلموا للموت هذا واقع","عقرت قوائمه وهذا يعقر",11,"ر",1,0],["واستسلمتْ صِيدُ الملوكِ وأيقنتْ","إنْ لم تُطِعْه أطاعَت الخِرصانا",12,"ن",2,0],["وَاسْتَسْلَمُوا لِلدَّنَايَا وَهْيَ تُقْذِعُهُمْ","مِنْ حُبِّ أَوْلاَدٍ أَوْ مِنْ حُبِّ أَزْوَاجِ",13,"ج",1,0],["واستسلموا لرجالاتِ الوغى فعفتْ","عن النفوسِ وَقد عَفَّتْ عن السلب",14,"ب",1,0],["وَأَستَسقي سَقيطَ المُز","نِ كَي يَروى بِهِ السِقطُ",15,"ط",1,0],["واستسملوا بعد القتال فإِنَّما","يَتَربَّقونَ تَرَبُّقَ الحُملانِ",16,"ن",1,0],["واستَسقَت الأَرضُ فَمِن حِرصِه","ألقَى عَلَيها الغَيثَ والسَّيلا",17,"ل",2,0],["واستسق خير القَطر","ورد ذوب القِطر",18,"ر",1,0],["واستسق خِلْفَيْهما وأهوِنْ","إذا استهلّا بالمرِزمَينِ",19,"ن",1,0],["واستسبغا من رأيه نَثْلةً","ضافيةَ الأذيالِ جرّارَهْ",20,"ر",2,0],["واستسلُّوا لفخرهم من لساني","صارماً غَربُهُ الكلامُ الغزيرُ",21,"ر",1,0],["واستُسقِيَتْ لظَمايَ ريقَتها","فاستشهدتْ بالآي في الخمرِ",22,"ر",1,0],["واستسهلَ الوعرَ المُشِقَّ فما","يخْشى ولو عَنَّتْ مخاوفُهُ",23,"ف",2,0],["واستسلموا لقضائه","فقضاؤه لا يدفع",24,"ع",1,0],["واستسلمت لندن للأمر صاغرة","واستتبع الرأس في لأواه بالذنب",25,"ب",1,0],["واستسعدوا بجبين وجهك فاغتدوا","يستفتحون بك الرجاء المقفلا",26,"ل",2,0],["واستَسقِ وَسمِيَّ الغَمامِ وَوَليَهُ","سحّاً عليها ما جرى المَلَوانِ",27,"ن",1,0],["واستسلموا لدولة الأوهامِ","وغادروا النور إلى الظلامِ",28,"م",1,0],["واستسلمت دول الدنيا لدولته","وهي التي رستِ الدنيا بها عمقا",29,"ق",2,0],["وَاِستَسلموا وهم ما بينَ منطرحٍ","يخورُ في دمه منهم ومنهزمِ",30,"م",1,0],["وَاِستَسلموا بعدما حمّ الردى فعفا","عَنهم وَعادتهُ يَعفو إِذا اِقتَدرا",31,"ر",2,0],["وَاسْتَسْلَمَ المُؤَيِّلُونَ السِرْبا","والمَحْلُ يَبْرِي وَرَقاً وَنَجْبا",32,"ب",2,0],["واستسلم الجسد الطهور وفوقه","سمة القبول تشعُّ من سكناتهِ",33,"ت",2,0],["واستسلم الناس اذ حل العدو بهم","فما لامرهم ورد ولا صَدَر",34,"ر",1,0],["وَاسْتَسهَلَ الصَّعبَ في تَحصِيلِ وَاجِبِهِ","حَتَّى قَضَى فِي المَعَالي كلَّمَا يَجِبُ",35,"ب",1,0],["واستسلَم الناسُ لِلباري وَعِزَّتِهِ","وَهُدَّتِ اللاتُ والعُزّاءُ لِلثّارِ",36,"ر",1,0],["واستسلمت قسراً وأية صعبة","خشناء تغزوها ولا تستسلم",37,"م",1,0],["واستسق وابله وحل بنجدةٍ","تنجيك إن هطلت عليك سماء",38,"ا",2,0],["واستسهل الصعب كي تحظى بكل منى","فربما حفت الآلاء بالمحن",39,"ن",1,0],["وأسْتَسِمجُ اللّيلَ القصير ورآءه","وسِيّانِ ليلُ المستهامِ وعَامُه",40,"م",2,0],["واِستسمح الصدق أَن يُنبى مصارحة","ماذا رأى منهم في كل مصطَدم",41,"م",1,0],["واستسلِمي فِي راحَتَيْه فإنما","حبلُ الأمانِ بكَفِّه مَعْقود",42,"د",1,0],["وَاِستَسلَمَ الناسُ إِذ حَلَّ العَدُوُّ بِهِم","فَلا رَبيعَتُهُم تُرجى وَلا مُضَرُ",43,"ر",1,0],["واستسلمت بغداد بعد تمنع","لمؤيد حامي الحفيظة ظافر",44,"ر",1,0],["واستسقها العذب الزلال فإنما","يروي الأوام معينها الدفاق",45,"ق",1,0],["وَاِستَسلّا مِنّي المُهنَّد ظنّاً","أَن تَكون اللُّحُودُ من أَجفاني",46,"ن",2,0],["واستسقِ من تلكَ الرُّبَا عارِضاً","يروى حديثَ الشَّيحش عن مُقَلتي",47,"ي",1,0],["واستسقِ سِوى دمُوعِ عيني لَهُمُ","يَكفيني ما عِندي مِنَ الأَسقامِ",48,"م",1,0],["واستسلمتْ لجنونِ حبّك أضلعٌ","كانت إذا حضرَ الغرامُ ضرامي",49,"م",2,0],["وَاسْتَسْلَمَ الْفُرْسُ الْمَجُوْسُ، وَطَأْطَؤُوْا","كَالرُّوْمِ حِيْنَ تَأَخَّرَّ الإِرْفَاْدُ",50,"د",1,0],["وَاسْتَسْعَلَتْ حَتَّىْ رَأَىْ بِسُعَاْلَهَاْ","خَطَراً، وَ شَقَّتْ صَدْرَهُ الأَضْغَاْنُ",51,"ن",1,0],["وَاسْتَسْهَلَ الأَهْوَاْلَ فِيْ بَحْرِ الْهَوَىْ","بِالْحُبِّ لِلْحُبِّ الَّذِيْ لَمْ يَنْكِصِ",52,"ص",1,0],["واستسلى لقضاء الله واحتسبي","واستكثري طاعة المولى لارضاء",53,"ا",2,0],["واستسق مزنك فيها للبريِّ بها","فإن ثم له بالري ميعاد",54,"د",1,0],["واستسلمت ويد الأقدار تأخذها","عن عنف مستكبر في طيشه بَطَر",55,"ر",1,0],["واستساغ الذهول كالشهد حتى","مات فيه روما وحيَّ مراما",56,"م",2,0],["واستسلمي لأناملي ويَديْ","حتى تزولَ معالمُ الخجلِ",57,"ل",1,0],["واستسلمَ الحقُّ حين الجمعُ فارقَهُ","وازّيّنَ السجنُ في عينيه كان دُنا",58,"ن",2,0],["واستساغت أن تشرب الدم نهلاً","واستطابت أن تأكل اللحم نيا",59,"ي",2,0],["وَاستَسهَلَ النَّاسُ بِالتَّرغِيبِ أَمرَهم","وَلَم يَعُد مَبدَأُ التَرهِيبِ يَنتَصِرُ",60,"ر",1,0],["واستسلمت عيني لنوم هادئ","قد منّه طيف الفتاة تكرما",61,"م",2,0],["واستسلمت والفقر أحكم رأيه","والمال حل من الفتاة ثيابها",62,"ب",3,0],["وَ استَسلَمَ المَتنُ لِلضَّربَاتِ تَقصِمُهُ","وَ خَارَتِ الرُّوحُ لَمَّا الشَّوقُ دَحرَجَها",63,"ج",3,0],["واستسلمت لظلام اليأس انفسنا","إلا العلالات من ذكرى تلاقينا",64,"ن",2,0],["واستسلمت أنجمه لم تُطقْ","رداً لموج الظلمة الهادرِ",65,"ر",1,0],["واستسبغا منْ رأيهِ نثلة ً","ضافية َ الأذيلِ جرَّاره",66,"ر",2,0]]}