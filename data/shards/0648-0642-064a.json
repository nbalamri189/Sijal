اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[39,"إن تختلف مضر تتبع عدوهم","https://www.aldiwan.net/poem53772.html","البسيط"],[52,"لقد صاح بالبين الحمام النوائح","https://www.aldiwan.net/poem27141.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[48,"لست بدار عفت وغيرها","https://www.aldiwan.net/poem62428.html","البسيط"],[48,"وقيت بي الردى زدني قيودا","https://www.aldiwan.net/poem62602.html","الوافر"],[48,"أحسن من رمي برعادة","https://www.aldiwan.net/poem66590.html","البسيط"],[50,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[46,"كأن منجم الأقوام أعمى","https://www.aldiwan.net/poem22837.html","الوافر"],[46,"سقيا لشوهاء ما همت بفاحشة","https://www.aldiwan.net/poem23162.html","البسيط"],[8,"وأخرج من تحت العجاجة صدره","https://www.aldiwan.net/poem21819.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202527","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54984","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54792","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43815","المنسرح"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116964","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[106,"جهلويه","https://www.poetsgate.com/ViewPoem.aspx?id=179750",""],[90,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[45,"عَهْدِي بِرَبْعِكَ مُثَّلاً آرَامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32042",""],[45,"رَأتْ وَخْطَ شيْبٍ من عذاري، فصَدّت","https://www.poetsgate.com/ViewPoem.aspx?id=33105",""]],"verses":[["وَقيذينَ قَد مالَ النُعاسُ بِهامِهِم","كَما أَرعَشَت أَيدي المُعاطينَ قَرقَفُ",0,"ف",1,0],["وَقَيَّدَني مَرُّ الحِفاظِ بِدارِكُم","وَأَطلَقَ غَيري مِن حَبالِكُمُ العُذرُ",1,"ر",1,0],["وَقِيادِ مُخطَفَةِ الخُصورِ كَأَنَّها ال","عِقبانُ تَحتَ مُجَلجِلٍ دَلّاحِ",2,"ح",1,0],["وَقَيسٌ تَدارَكَ بَكرَ العِراقِ","وَتَغلِبَ مِن شَرِّها الأَعظَمِ",3,"م",1,0],["وقيِّدْ بشُكْرِ اللهِ أنعُمُهُ التي","أوابِدُها تأبى سِوى الشُّكْر منْ قَيْدِ",4,"د",1,0],["وَقَيَّدَني الشِعرُ في بَيتِهِ","كَما قَيَّدَ الآسِراتُ الحِمارا",5,"ر",2,0],["وَقيلُ رِجالٍ لا يُبالونَ شَأنَنا","غَوى أَمرُ كَعبٍ ما أَرادَ وَما اِرتَأى",6,"ا",1,0],["وقيل : خالَفتَ يا فاروقُ صاحِبَنا","فيه وقد كان أعطى القَوسَ باريها",7,"ي",3,0],["وَقُيِّضَ لِلفَرَنْسِيِّينَ نَصْرٌ","أتَاهُمُ فَوْقَ مَا ظَنُّوا وَرامُوا",8,"م",3,0],["وقيل رقيبُك في غفلةٍ","فقلت أخاف الإله الرقيبُ",9,"ب",1,0],["وقياسُ سعدك في مرامك كلَّه","يقضي مُقَدَّمُهُ بصدق التالي",10,"ل",2,0],["وَقَيسٌ وَالخَليفَةُ مِن بَنيهِ","وَصاحِبُ عَهدِهِ المُتَخَيَّرانِ",11,"ن",1,0],["وَقَيسٌ يا فَرَزدَقُ مِن تَميمٍ","مَكانَ الساعِدَينِ مِنَ البَنانِ",11,"ن",1,0],["وَقَيسٌ هُمُ الفَضلُ الَّذي نَستَعِدُّهُ","لِفَضلِ المَساعي وَاِبتِناءِ المَكارِمِ",12,"م",1,0],["وَقَيسٌ هُمُ الكَهفُ الَّذي نَستَعِدُّهُ","لِدَفعِ الأَعادي أَو لِحَملِ العَظائِمِ",12,"م",1,0],["وَقَيسٌ أَذاقوكَ الهَوانَ وَقَوَّضوا","بُيوتَكُمُ في دارِ ذُلٍّ وَمَحرَبِ",13,"ب",1,0],["وَقَيسٌ يا فَرَزدَقُ لَو أَجاروا","بَني العَوامِ ما اِفتُضِحَ الجِوارُ",14,"ر",1,0],["وَقَيسٌ هُمُ قَيسُ الأَعِنَّةِ وَالقَنا","وَقَيسٌ حُماةُ الخَيلِ تَدمى نُحورُها",15,"ر",3,0],["وَقَيتَ الحَتفَ مِن عَرَضِ المَنايا","وَلُقَّيتَ التَحيَّةَ وَالسَلاما",16,"م",2,0],["وَقَيسٌ رَهطُ آلَ أَبي أُسَيمٍ","فَإِن قايَستَ فَاِنظُر ما تُفيدُ",17,"د",1,0],["وَقَيسِ بنِ جَزءٍ يَومَ نادى صِحابَهُ","فَعاجوا عَلَيهِ مِن سَواهِمُ ضُمَّرِ",18,"ر",1,0],["وَقَيساً وَمَن لَفَّت تَميمٌ وَمَذحِجاً","وَكِندَةَ إِذ وافَت عَلَيكِ المَنازِلا",19,"ل",2,0],["وَقِيلَ أفرَطَّتَ بل قَصَدتُ ولو","عَنَّفَنِي القَائِلونَ أو ثَلَبُوا",20,"ب",3,0],["وَقيلَ لَها سَيفُ الهُدى قُلتُ إِنَّهُ","لَيَفعَلُ خَيرُ الفاعِلينَ وَيُكرَمُ",21,"م",1,0],["وُقّيتَ في الآخِرِ مِن صَرفِها ال","جائِرِ ما جَرَّعَكَ الأَوَّلُ",22,"ل",1,0],["وقَّى الدِّين والدُّنيا ليهلك ملحدٌ","لديهِ وينجو راشدٌ مع من نجا",23,"ج",2,0],["وقيَّدني إحسانها بذوائبٍ","ومن وجد الإحسان قيداً تقيدا",24,"د",2,0],["وقيل عُبيّةٌ فحلفت أني","وكلٌّ العالمين لها فقير",25,"ر",1,0],["وقيلَ هل من دقيق معنى","فقال لهفي على الدقيق",26,"ق",1,0],["وقيل أسماءُ في أفعالها عنتٌ","فالحزن ما بين أسماءٍ وأفعال",27,"ل",1,0],["وقيل هل أجدى المديح الذي","حبرته في مجدِهِ العالي",28,"ل",2,0],["وقيل عيِّن لها اسماً","فقلت ستِّي بخيلهْ",29,"ه",1,0],["وقيل أحسنها ماذا فقلت لهم","وما محاسن شيء كله حسنُ",30,"ن",1,0],["وقينةٍ أبردُ من ثلجَهْ","تظلُّ منها النفسُ في ضجَّهْ",31,"ج",2,1],["وَقينةٍ إن مُنِحْتَ رؤيتَها","رَضِيتَ مسموعَها ومنظرها",32,"ر",3,0],["وقِيل مُرجّي قاسمٍ ووليُّهُ","ونافسني في ربح صَفْقَتيَ البَحْر",33,"ر",1,0],["وقيل ما هذا فأبرزته","وقلت ذا بعض المساويك",34,"ك",1,0],["وقيانٍ كأنها أمهاتٌ","عاطفاتٌ على بنيها حواني",35,"ن",2,0],["وقيل وإن كان ذا حكمةٍ","أصابته طائفةٌ من جُنون",36,"ن",1,0],["وَقَيسَ عَيلانَ حَتّى أَقبَلوا رَقَصاً","فَبايَعوكَ جِهاراً بَعدَ ما كَفَروا",37,"ر",3,0],["وَقَيسٌ تَمَنّاني وَتُهدي عَوارِماً","وَلَمّا يُصِب مِنّي بَني عامِرٍ ظُفرُ",38,"ر",1,0],["وَقَيِّمٍ أَمدَرِ الجَنبَينِ مُنخَرِقٍ","عَنهُ العَباءَةُ قَوّامٍ عَلى الهَمَلِ",39,"ل",1,0],["وقيل تلميذ الإمام مرا","يا مرحبا به وألف هورّا",40,"ر",2,0],["وقيل زعيمهم ولى الفرارا","وفي بلبيس قد ساق القطارا",41,"ر",2,0],["وَقيل كانَ يَدّعي العباسا","وَيَرتَدي لِهاشِمٍ لِباسا",42,"س",2,0],["وَقيلَ لِلسُلطانِ هَذي الَّتي","بِالأَمسِ آذَت عالِيَ المسمَعِ",43,"ع",1,0],["وَقيلَ كُلُّ نَبِيٍّ عِندَ رُتبَتِهِ","وَيا مُحَمَّدُ هَذا العَرشُ فَاِستَلِمِ",44,"م",1,0],["وَقيلَ مَعالِمُ التاريخِ دُكَّتْ","وَقيلَ أَصابَها تَلَفٌ وَحَرقُ",45,"ق",1,0],["وَقيلَ تَوَلّى الشَيخُ في الأَرضِ هائِماً","وَقيلَ بِدَيرِ الراهِباتِ أَسيرُ",46,"ر",1,0],["وَقيلَ قَضى لَم يُغنِ عَنهُ طَبيبُهُ","وَلِلطِبِّ مَن بَطشِ القَضاءِ عَذيرُ",46,"ر",1,0],["وَقِيامَ النَخيلِ ضَفَّرنَ شِعراً","وَتَجَرَّدنَ غَيرَ طَوقٍ وَسَلسِ",47,"س",1,0],["وَقيلَ أَكثَرَ ذِكرَ القَتلِ ثُمَّ أَتَوا","ما لَم تَسَعهُ خَيالاتٌ وَأَنباءُ",48,"ا",2,0],["وَقى الأَرضَ شَرَّ مَقاديرِهِ","لَطيفُ السَماءِ وَرَحمانُها",49,"ن",3,0],["وَقيلَ شَطَطتَ في الكُفرانِ حَتّى","أَرَدتَ المُنعِمينَ بِالاِنتِقامِ",50,"م",1,0],["وَقيلَ الثَغرُ فَاِتَّأَدَت فَأَرسَت","فَكانَت مِن ثَراكَ الطُهرِ قابا",51,"ب",2,0],["وَقَيِّماً مِن ثَناءٍ لا كِفاءَ لَهُ","إِلّا التَعَجُّبُ مِن أَصحابِكَ النُجُبِ",52,"ب",1,0],["وُقِيَ الأَميرُ هَوى العُيونِ فَإِنَّهُ","ما لا يَزولُ بِبَأسِهِ وَسَخائِهِ",53,"ا",3,0],["وَقَيَّدتُ نَفسي في ذَراكَ مَحَبَّةً","وَمَن وَجَدَ الإِحسانَ قَيداً تَقَيَّدا",54,"د",2,0],["وَقيلَ عَدَوتَ عَلى العالَمي","نَ بَينَ وِلادي وَبَينَ القُعودِ",55,"د",1,0],["وقيل فِراقٌ لا تلاقِيَ بعدَهُ","ولا زادَ إلّا حسرةٌ وتَحرُّقُ",56,"ق",1,0],["وَقَيناكَ صَرفَ الدَهرِ بِالأَنفُسِ الَّتي","تُبَجِّلُ لا نَألوكَ أُمّاً وَلا أَبا",57,"ب",2,0],["وَقيدَت عِتاقُ الخَيلِ حَتّى تَلَفَّتَت","بِأَعطافِها مُختالَةً وَتَقَدَّتِ",58,"ت",1,0],["وَقِيامِنا بِالاِعتِقادِ وَنَصرِنا","لِلحَقِّ إِن نَصَرَ الضَلالَ مُعانِدُ",59,"د",1,0],["وَقِيامُهُ دوني إِذا اِلتَقَتِ العِدى","قَصدي وَإِذ لَجَإِ الحَريزُ قِيامُهُ",60,"م",2,0],["وَقيلَ اُنجُ مِن غَمّائِها فَأَبَت لَهُ","سَجِيَّةُ شَكسٍ في اللِقاءِ حَرونِ",61,"ن",1,0],["وَقى كَتِفَيهِ وَالرِماحُ شَوارِعٌ","بِثُغرَةِ نَحرٍ واضِحٍ وَجَبينِ",61,"ن",1,0],["وَقَيناكَ المَنونَ وَإِنَّ حَظّاً","لَنا في أَن نُوَقّيكَ المَنونا",62,"ن",2,0],["وَقيتَ الحِمامَ بِمَثنى النُفوسِ","مِنَ الحاسِدينَ وَوُحدانِها",63,"ن",3,0],["وَقيلُكَ هَل مَعروفُها راجِعٌ لَنا","وَلَيسَ لِشَيءٍ قَد تَفاوَتَ مَطلَبُ",64,"ب",1,0],["وَقيلي لِأَصحابي أَلَمّا تَبَيَّنوا","هَوى النَفسِ قَد يَبدو لَكُم مِن أَمامِيا",65,"ي",2,0],["وقِيانٌ مَنَعْنَ أسماعَنا الحظْ","ظَ وَوَفَّرْنَه على الأَحْداقِ",66,"ق",1,0],["وقى اللهُ من شكوى الصبابةِ خُلَّةً","شكوتُ الذي أُلقى فأضعفَ في الشكوى",67,"ا",1,0],["وَقَيتُ بِنَفسي خَيرَ مَن وَطِئَ الحَصى","وَمَن طافَ بِالبَيتِ العَتيقِ وَبِالحَجَرِ",68,"ر",1,1],["وَقَينَتي خَلفَ كُتبِ الصِحاحِ","تَحتَ الجِرارِ إِلى جانِبي",69,"ب",2,0],["وُقَّيتَ حادِثَةَ اللَيالي","وَحُرِستَ مِن عَينِ الكَمالِ",70,"ل",1,1],["وَقَيتَ جلالَ الخطب ما جلّ خَطبُهُ","وقمتَ كريمَ النّفسِ من دونه سدّا",71,"د",2,0],["وَقيلَ أَحمَدُها بَل قيلَ أَمجَدُها","بَل قيلَ أَنجَدُها إِن فُرَّتِ النُجُدُ",72,"د",1,0],["وقيل هل يَرْشُدُ قلبٌ غوى","والرشدُ غَيٌّ في الصِّبا المقبلِ",73,"ل",1,0],["وَقَيسُ عَيلانَ لَولا حُسنُ طاعَتِهِم","أَلوى بِجِذمِ تَميمٍ حُشَّرٌ شُطُرُ",74,"ر",1,0],["وَقَيَّدَها بِالنَصلِ خِرقٌ كَأَنَّهُ","إِذا جَدَّ لَولا ما جَنى السَيفُ مازِحُ",75,"ح",1,0],["وَقِيلَ لَهُمْ دُعاءٌ مُسْتَجابٌ","وَقَدْ مَلَئُوا مِنَ السُّحْتِ البُطُونا",76,"ن",2,0],["وَقَيسُ عَيلانَ لا أُريدُ لَها","مِنَ المَخازي سِوى مَحارِبِها",77,"ب",3,0],["وُقيتَ بِيَ الرَدى زِدني قُيودا","وَثَنِّ عَلَيَّ سَوطاً أَو عَمودا",78,"د",2,1],["وقينةٌ تشدو على صنجِها","تعطيكَ أسبابَ اللذاذات",79,"ت",1,0],["وَقَيصَرٌ خالي إِذا","عَدَدتُ يَوماً نَسَبي",80,"ب",2,0],["وَقِيانُهُ الغُرُّ النَواصِفُ أَهلُها","وَقِيامُ غاشيهِ عَلى أَبوابِهِ",81,"ب",2,0],["وَقيلَ نُفوسُ الناسِ تَسطيعُ فِعلَها","وَقالَ رِجالٌ بَل تَبَيَّنَ جَبرُها",82,"ر",3,0],["وَقيلَ يَجيءُ دينٌ غَيرُ هَذا","وَأَودى الناسُ بَينَ غَدٍ وَأَمسِ",83,"س",1,0],["وَقيلَ لابَعثَ يُرجى لِلثَوابِ وَما","سَمِعتَ في ذاكَ دَعوى مُبطِلٍ هَزُلا",84,"ل",2,0],["وَقى اِبنُ زِيادٍ وَهوَ عُقب