{"poems":[[65,"أقسم بالجرد السراحيب","https://www.aldiwan.net/poem45908.html","السريع"],[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[87,"قد مثلوا في صورة مزوقة","https://www.aldiwan.net/poem7907.html","الرجز"],[119,"بعلي الكرار والحسن ابنه","https://www.aldiwan.net/poem41957.html","الكامل"],[154,"لا تجزعن لمكروه تصاب به","https://www.aldiwan.net/poem68510.html","البسيط"],[510,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[563,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86582","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63766","السريع"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104478","الرجز"],[935,"","https://poetry.dctabudhabi.ae/diwan/poem/146455","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84477","البسيط"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131335","الرجز"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106972","البسيط"],[3252,"","https://poetry.dctabudhabi.ae/diwan/poem/105715","المواليا"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117043","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52976","المتدارك"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135742","الرجز"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/145916","الكامل"],[4767,"روائع الأيات","https://www.poetsgate.com/ViewPoem.aspx?id=178557",""],[5582,"لِمَنْ تِلْكَ الهَوادِجُ وَالحُدُوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=186779",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5873,"رنق العيش","https://www.poetsgate.com/ViewPoem.aspx?id=215357",""]],"verses":[["وَالعُسْرُ قَيْدُ المَرْءِ لكِنَّني","أَقْرَعُ للْمَجْدِ ظَنابِيبي",0,"ب",2,0],["وَالعَسقَلانِيُّ في عَمامَتِهِ","دَلائِلٌ عَن سَخافَةٍ تُنبي",1,"ب",2,0],["والعسكري إنني أحميكم","والسائل المكدود أستعطيكم",2,"م",1,0],["والعسكري وأمامنا المولى التقى","وعلى الرضى عوني إذا ضاق الفضا",3,"ض",2,0],["والعسر يتلوه يسر إن صبرت له","ضدان هذا وهذا عندنا عرض",4,"ض",1,0],["والعسرُ صائدُنا واليُسرُ مُطلِقنا","والموتُ مُنقذنا لوْ كان قدْ قبِلا",5,"ل",2,0],["والعسر ليسر يعقبه","فاخرج عن ضيقك والحرج",6,"ج",1,0],["وَالعَسكر المَنصور جَيشك دائِماً","يَقتص في الهَيجا مِن الغرماء",7,"ا",2,0],["والعسليِّ الذي ارتديت به","كما تردَّى القضيبُ بالزَّهْر",8,"ر",1,0],["والعسكري وابنه خاتمهم","قائمهم فينا بأمر ذي العلى",9,"ل",2,0],["والعسكر الزنجي رمح سماكه","قان وعضب الفجر لم يتجرد",10,"د",1,0],["وَالعُسرُ وَاليُسرُ مَصروفان مِن يَده","ذا لِلمُحِبِّ وَذا لِلفاجِر الخَصمِ",11,"م",1,0],["والعَسَلُ النَّحْلُ به والسُّكّرُ","والقَطْرُ بالأمطارِ لَيْسَ يُحْصَرُ",12,"ر",1,0],["وألعس كوثري الثغر ذا فلج","يجري بلؤلؤه التسنيم والضرب",13,"ب",1,0],["والعسر الأكشر علي في جيوشه حال","والغانمه هي لكم من دور أب وجد",14,"د",1,0],["والعسكر المنصور كل مخلص","في نصحنا وجميعهم فرسان",15,"ن",1,0],["والعسجدُ هلا ينسبك","إلا بمقاومة النيران",16,"ن",1,0],["والعس من لبن أروى به ملأ","وحيس أم سليم فيه تحفيل",17,"ل",1,0],["والعسرَ يسِّرْ واصلحِ الأسبابا","والكسبَ باركْ فيه والثّوابا",18,"ب",2,0],["والعسر قبل دخوله بالمهر لم","يثبت خيار الفسخ عن ذات الزجج",19,"ج",1,0],["والعسكريَّ فقدميهِ مُقوِّماً","ما اعوجَّ في درب المضل العاتي",20,"ت",2,0],["وَأَلْعَسَ لَمْ أَزَلْ أَبَداً عَلَيْهِ","أَعُوجُ وَإِنْ يَكُنْ لِي لا يَعُوجُ",21,"ج",1,0],["والعسكري بعده وبعده ال","مهدي اثنى عشر لذ بهم",22,"م",1,0],["والعسف والإرهاب صنعة فكرهم","وجنى العداء لزارع مردود",23,"د",1,0],["والعسر إن قد أطال الظلم مدّته","فاليسر آتٍ به ما شاد ينسحقُ",24,"ق",1,0]]}