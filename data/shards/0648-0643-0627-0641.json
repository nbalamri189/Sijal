{"poems":[[79,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[95,"وارحمتاه لقوم فارقوا النعما","https://www.aldiwan.net/poem11304.html","البسيط"],[74,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[74,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[74,"لنجم هلال الدولة الحسن عسكر","https://www.aldiwan.net/poem20190.html","الطويل"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[63,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[51,"ألم يك في وجدي وبرح تلددي","https://www.aldiwan.net/poem63543.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1946","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[257,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[358,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[376,"خلا طرفه بالسقم دوني يلازمه","https://www.aldiwan.net/poem57103.html","الطويل"],[422,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[519,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[520,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[543,"مع الأيام تلتئم الجراح","https://www.aldiwan.net/poem48250.html","عموديه"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96993","الطويل"],[702,"","https://poetry.dctabudhabi.ae/diwan/poem/202243","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63970","الهزج"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100581","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62608","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137851",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50040","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80012","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124717","السريع"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100448","الطويل"],[1983,"","https://poetry.dctabudhabi.ae/diwan/poem/200914","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71040","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27475","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27822","البسيط"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110616","المتقارب"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120679","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120680","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93720","السريع"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82965","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76030","الطويل"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3357,"","https://poetry.dctabudhabi.ae/diwan/poem/105648","المتقارب"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132920","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126963","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36775","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102969","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77125","البسيط"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145315","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4709,"من أين لي بحروف أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214868",""],[4927,"الْعُشَّاْقُ وَ الطُّغَاْةُ","https://www.poetsgate.com/ViewPoem.aspx?id=29728",""],[4927,"أنوار العدالة","https://www.poetsgate.com/ViewPoem.aspx?id=80804",""],[5186,"رفعت إلى أوج العلى راية الهند","https://www.poetsgate.com/ViewPoem.aspx?id=156480",""],[5193,"من وحي العزّة","https://www.poetsgate.com/ViewPoem.aspx?id=213569",""],[5550,"أرى القلبَ","https://www.poetsgate.com/ViewPoem.aspx?id=210923",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[4442,"نظرت فخانني حدسي وفكري","https://www.poetsgate.com/ViewPoem.aspx?id=171205",""]],"verses":[["وَكَافَأَ اللهُ أَشْيَاخِي بِرَحْمَتِهِ","وَمَنْ أَعَانَ وَمَنْ أَمْلَى وَمَنْ كَتَبَا",0,"ب",2,0],["وكافٌ وكَفكافٌ وكَفِّي بِكَفِّهَ","وكافٌ كَفُوفُ الوَدقِ مِن كَفِّها انهَمل",1,"ل",1,0],["وَكَافَأَ الحَمْدُ أُمَّ المُحْسِنِينَ بِمَا","أَولَتْ فَأَغْلَتْ فَرَاعَ العُرْبَ وَالعَجَمَا",2,"م",2,0],["وكافي كفاة ما ابن عبَّاد صائد","لديه ولا القاضي الملقَّب أفضل",3,"ل",1,0],["وكافل أمر الملك حتَّى كأنما","هو الروح والملك المحرّك جثمان",4,"ن",1,0],["وكافور جسم فيه للحسن ثروةٌ","فليس الغواني عندهُ بغواني",5,"ن",2,0],["وكافأتموه بالذي أستحقُّهُ","من البرّ والإحسانِ والعطفِ والوصلِ",6,"ل",1,0],["وكافأ إحساناً بسوءٍ ولم يَزَلْ","يُراجِمُ بالمكروه من لا يراجمُ",7,"م",1,0],["وكافوريَّةِ البُنيانِ تُثني","على من خَطَّها أو مَن بَناها",8,"ا",3,0],["وَكافي كُفاةٍ مُستَقِلٍّ بِعِبئِهِم","مَتى يَهزِلوا في مُعظَمِ الأَمرِ يَجدُدِ",9,"د",1,0],["وَكافحت أَياماً بها وَليالياً","تكرّان من بيض هناك وَسود",10,"د",1,0],["وكافٌ وكَفكافٌ وكَفِّي بِكَفِّهَا","وكافٌ كَفُوفُ الوَدقِ مِن كَفِّها انهَمل",11,"ل",1,0],["وكافحتم عن عزة الدين خصمها","فعزت وأس العز تلك الملاحم",12,"م",1,0],["وكافِى الجميلَ بأمثاله","وإلا فبالشكر والإهتمام",13,"م",1,0],["وَكافلاً لكَ الغنى وكافيا","كُن واعِياً له وكن لي داعيا",14,"ي",2,0],["وَكافِلٌ لَكَ كافٍ ما تُحاوِلُهُ","عِزٌّ وَعَزمٌ وَبأسٌ غير مُنتَحلِ",15,"ل",1,0],["وَكافر خالٍ حَلَّ جَنّة خَدِّها","مَتى اِنسابَ فَحل العيس في مثقب الإبرَه",16,"ر",2,0],["وكافلُها رأيَ الرَّئيسِ فَلم تَضع","لأنَّ كفيلَ الشَّيءِ إن ضاعَ غارِمُه",17,"م",2,0],["وكآفاق العُلى ما أطْلَعَتْ","كشهاب الدِّين فينا كوكبا",18,"ب",2,0],["وكافأتَ بالإحسانِ من ساءَ فعلُه","إليكَ فحُزْتَ الفضلَ وهو حَميدُ",19,"د",1,0],["وكافا أبا النجم الهمام وخصه","بأفضل ما يجزى امرؤ متفضل",20,"ل",1,0],["وكافِح في الحَياة جيوشَ همٍّ","فإنَّ العيشَ في الدنيا كِفاحُ",21,"ح",1,0],["وكافل أيتام لهم وأرامل","وهادي محبيهم سواء المذاهب",22,"ب",1,0],["وكافحت الأمور وكافحتني","فلم أحفل بمعضلة كؤود",23,"د",1,0],["وكافحنا زماناً مش","بهاً زنبقُهُ نَفْطَه",24,"ط",2,0],["وكافلها زين العباد مغلل","وأنى لمغلول الأكف من الكف",25,"ف",1,0],["وكاف كفافٍ كفَّ عنّيَ فاقتي","وخَلوة خَوْد وهي من أجمل النِسَا",26,"س",2,0],["وكاف على المعروف واسمح لمن اسا","وصل من جفا واكرم جليسك تكرم",27,"م",1,0],["وكاف تشبيه كقول من سبق","لواحق الإقراب فيها كالمقق",28,"ق",1,0],["وكافحه في كل حين كأنه","رآه طراديّا فرام طراده",29,"د",2,0],["وكافة منك بالحُسنَى فمن جبر","الكافي المناصح واستكفاه كفاهُ",30,"ا",2,0],["وكافورةٍ للحسنِ أضحت بزعمهم","تعطّر بالكافورِ وهي له عطرُ",31,"ر",1,0],["وكافرٌ من شك في ذا وقد","قامت عليهِ حجةُ العقلِ",32,"ل",1,0],["وكافلها السجاد قد شفه الضنا","ياقسي من الأعداء قيداً وقائدا",33,"د",2,0],["وكافورُ المشيبِ أجلُّ عندي","وفي فوديَّ من مِسْكِ الشبابِ",34,"ب",1,0],["وكافاكِ عنَّا بالذي لكِ عندنا","إِلهٌ لديه تُضْعَفُ الحَسناتُ",35,"ت",1,0],["وكاف ها يا يربُعهن عين","إلى صاد تطأطأ للسجود",36,"د",1,0],["وكافرٍ قد أبى نصراً فكان له","التبُّ من سورة الإخلاص يأتيه",37,"ي",2,0],["وكافلها يشتكي في السبا","كبولا وللسقم يشكو شحوبا",38,"ب",2,0],["وكافأ اللهُ بالحُسنَى مُعَلِّمَنا","فإنه أحسَنَ التَّعلِيمَ واجتهدا",39,"د",2,0],["وكافأ اللهُ أستاذي فإنَّ لَهُ","حَقاً عَظِيماً كما قد جاء في الخبرِ",40,"ر",1,0],["وَكافحت مِن هاشم فتيةٌ","تَمنعها الأحساب أَن تَجبنا",41,"ن",2,0],["وَكافِ ذوي الإِجرامِ بِالصَّفحِ عنهُم","وَقل لهمُ إِمّا لقيتَهُم أَهلا",42,"ل",2,0],["وَكافيّةُ ابنِ الحاجبِ اِحتجبَت فَما","تُرى وَهيَ نَزرٌ ما أَقلَّ وَأَغلَقا",43,"ق",2,0],["وكافر من أعان المفتنين ومن","رضى بفتنتهم والكل قد خزلا",44,"ل",2,0],["وكافل شرعة خير الورى","ونائب من عن عداه توارى",45,"ر",2,0],["وَكَافر بالمَعَادِ أَمسَى","يَخلُبنُي قولهُ الخلُوبُ",46,"ب",1,1],["وكافلها العليل يقاد مضنى","فيال اللّه للمضنى المقاد",47,"د",1,0],["وَكَّافَةٌ ذَرّافَةٌ","جَرافَةٌ بِالهَيدَبِ",48,"ب",1,0],["وكافور خد فوقه خال عنبر","كأبيض ما في العين زين بأسود",49,"د",1,0],["وَكافِئَنَّ ذَوي المَعروفِ ما صَنَعوا","إِنَّ الصَنائِعَ بِالأَحرارِ كَالمَطَرِ",50,"ر",1,0],["وكافر نعم الاحسان في عذل","كظلمة الليل عن ذا المعنوي عمي",51,"م",2,0],["وكافر قبحت في العين خلقته","وذكره بين أهل الفضل ما جملا",52,"ل",2,1],["وكافل أهل الجود إن عز كافل","تساوى بنعماء مقيم وراحل",53,"ل",1,0],["وكافٍ كفاني بأنك نبضي","ونبضُ الفؤادِ بخلِّي لَحوحُ",54,"ح",1,0],["وَكَاْفِحْ فِيْ سَبِيْلِ الْحُبِّ حَتَّىْ","تُوَاْفِيْكَ الْحَبِيْبَةُ فِي الرِّيَاْغِ",55,"غ",1,0],["وَكَاْفَحَ مَظْلُوْمٌ ضَعِيْفُ مُسَاْلِمٌ","وَأَجْرَمَ ثُؤْرُوْرٌ[2] خَبِيْثٌ وَقَاْمِعُ",56,"ع",1,0],["وكافحت غول النهم بالسلم صآئما","فأرديت أو كدت الأذى والأسى تردي",57,"د",2,0],["وكافيءْ بالثواب ِ لكُلِّ مسعى","نبيلٍ منهُ ، إنْ وَضُحَ الصوابُ",58,"ب",1,0],["وكافحْ ولا ترْض عيْشًا مريضًا","لتبْلغَ مجْدًا رفيعَ البناء",59,"ا",2,0],["وكافحت حتى حطم الدهر صارمي","ومزق مني القلب رميا بنبله",60,"ل",2,0],["وكافحت النوائب إذ أناخت","بكاها علي فميل صبري",61,"ر",2,0]]}