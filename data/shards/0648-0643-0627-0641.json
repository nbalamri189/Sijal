{"poems":[[79,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[95,"وارحمتاه لقوم فارقوا النعما","https://www.aldiwan.net/poem11304.html","البسيط"],[74,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[74,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[74,"لنجم هلال الدولة الحسن عسكر","https://www.aldiwan.net/poem20190.html","الطويل"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[63,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[51,"ألم يك في وجدي وبرح تلددي","https://www.aldiwan.net/poem63543.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1946","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[256,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[357,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[375,"خلا طرفه بالسقم دوني يلازمه","https://www.aldiwan.net/poem57103.html","الطويل"],[420,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[517,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[518,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[541,"مع الأيام تلتئم الجراح","https://www.aldiwan.net/poem48250.html","عموديه"],[607,"","https://poetry.dctabudhabi.ae/diwan/poem/202243","الوافر"]],"verses":[["وَكَافَأَ اللهُ أَشْيَاخِي بِرَحْمَتِهِ","وَمَنْ أَعَانَ وَمَنْ أَمْلَى وَمَنْ كَتَبَا",0,"ب",2,0],["وكافٌ وكَفكافٌ وكَفِّي بِكَفِّهَ","وكافٌ كَفُوفُ الوَدقِ مِن كَفِّها انهَمل",1,"ل",1,0],["وَكَافَأَ الحَمْدُ أُمَّ المُحْسِنِينَ بِمَا","أَولَتْ فَأَغْلَتْ فَرَاعَ العُرْبَ وَالعَجَمَا",2,"م",2,0],["وكافي كفاة ما ابن عبَّاد صائد","لديه ولا القاضي الملقَّب أفضل",3,"ل",1,0],["وكافل أمر الملك حتَّى كأنما","هو الروح والملك المحرّك جثمان",4,"ن",1,0],["وكافور جسم فيه للحسن ثروةٌ","فليس الغواني عندهُ بغواني",5,"ن",2,0],["وكافأتموه بالذي أستحقُّهُ","من البرّ والإحسانِ والعطفِ والوصلِ",6,"ل",1,0],["وكافأ إحساناً بسوءٍ ولم يَزَلْ","يُراجِمُ بالمكروه من لا يراجمُ",7,"م",1,0],["وكافوريَّةِ البُنيانِ تُثني","على من خَطَّها أو مَن بَناها",8,"ا",3,0],["وَكافي كُفاةٍ مُستَقِلٍّ بِعِبئِهِم","مَتى يَهزِلوا في مُعظَمِ الأَمرِ يَجدُدِ",9,"د",1,0],["وَكافحت أَياماً بها وَليالياً","تكرّان من بيض هناك وَسود",10,"د",1,0],["وكافٌ وكَفكافٌ وكَفِّي بِكَفِّهَا","وكافٌ كَفُوفُ الوَدقِ مِن كَفِّها انهَمل",11,"ل",1,0],["وكافحتم عن عزة الدين خصمها","فعزت وأس العز تلك الملاحم",12,"م",1,0],["وكافِى الجميلَ بأمثاله","وإلا فبالشكر والإهتمام",13,"م",1,0],["وَكافلاً لكَ الغنى وكافيا","كُن واعِياً له وكن لي داعيا",14,"ي",2,0],["وَكافِلٌ لَكَ كافٍ ما تُحاوِلُهُ","عِزٌّ وَعَزمٌ وَبأسٌ غير مُنتَحلِ",15,"ل",1,0],["وَكافر خالٍ حَلَّ جَنّة خَدِّها","مَتى اِنسابَ فَحل العيس في مثقب الإبرَه",16,"ر",2,0],["وكافلُها رأيَ الرَّئيسِ فَلم تَضع","لأنَّ كفيلَ الشَّيءِ إن ضاعَ غارِمُه",17,"م",2,0],["وكآفاق العُلى ما أطْلَعَتْ","كشهاب الدِّين فينا كوكبا",18,"ب",2,0],["وكافأتَ بالإحسانِ من ساءَ فعلُه","إليكَ فحُزْتَ الفضلَ وهو حَميدُ",19,"د",1,0],["وكافا أبا النجم الهمام وخصه","بأفضل ما يجزى امرؤ متفضل",20,"ل",1,0],["وكافِح في الحَياة جيوشَ همٍّ","فإنَّ العيشَ في الدنيا كِفاحُ",21,"ح",1,0],["وكافحت الأمور وكافحتني","فلم أحفل بمعضلة كؤود",22,"د",1,0]]}