{"poems":[[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[53,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[93,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[47,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[68,"أجرد كي أجرد سيف مدحي","https://www.aldiwan.net/poem41350.html","الوافر"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[92,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[128,"سكينة عندها دعد","https://www.aldiwan.net/poem23778.html","مجزوء الوافر"],[132,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[226,"جف ورد الجميل في اللحد","https://www.aldiwan.net/poem55295.html","الخفيف"],[228,"هذه القصة لا شأن لها","https://www.aldiwan.net/poem41916.html","الرمل"],[333,"يا رفيقي وأنت موحى قصيدي","https://www.aldiwan.net/poem54935.html","الخفيف"],[347,"آه نفسي إلى متى أتألم","https://www.aldiwan.net/poem55336.html","الخفيف"],[382,"شدتي أعظم شده","https://www.aldiwan.net/poem66874.html","مجزوء الرمل"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[510,"حبّ الدّنيا","https://www.aldiwan.net/poem61089.html","البسيط"],[556,"هذي المصيبة ما أبقت لنا أبدا","https://www.aldiwan.net/poem47865.html","البسيط"],[592,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143291","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48748","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38066","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59714","المديد"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144031","المديد"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53056","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27954","الرمل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26148","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83227","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127389","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201664","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200046","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89406","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92034","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91054","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132141","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86463","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45150","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45050","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35465","الرمل"],[4929,"ضياع عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=202178",""],[4984,"وقع الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=180120",""],[5111,"شَاعرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212326",""],[5376,"يا ليل أني قد سمعت نحيبا","https://www.poetsgate.com/ViewPoem.aspx?id=198980",""],[5670,"بُشْرَيَاتْ!","https://www.poetsgate.com/ViewPoem.aspx?id=211207",""],[4623,"ذكر فان النفع في التذكار ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146607",""],[5858,"استعطفي البدر","https://www.poetsgate.com/ViewPoem.aspx?id=188026",""],[5906,"سُكَّر","https://www.poetsgate.com/ViewPoem.aspx?id=188224",""],[6125,"يا أوَّل الغيثِ","https://www.poetsgate.com/ViewPoem.aspx?id=210902",""],[6189,"وصية حرام بن ملحان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83557&r=&rc=24",""],[6225,"صلاة ودعاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80906&r=&rc=175",""]],"verses":[["فإنْ أفْخَرْ بِآبائِي فإنّي","أراهُمْ أشْرَفَ الثَّقَلَيْنِ آلا",0,"ل",2,0],["فأناف متناه على ثبج","طلعت على الترهيف أضلعه",1,"ع",2,0],["فَأَنا فيهِ مُستَقِلٌّ طَليقٌ","وَكَأَنّي أَدُبُّ في سِردابِ",2,"ب",1,0],["فَإِن أَفقِدِ العَيشَ الَّذي فاتَ بِاللَوى","فَقِدماً فَقَدتُ الظِلَّ عِندَ انتِقالِهِ",3,"ل",2,0],["فَإِن أَفعَل تَأَلَّمَتِ المَعالي","وَإِن أَنكُل تَظَلَّمَتِ المَعاني",4,"ن",2,0],["فَإن أفَارِقكَ دَوحاً فِيهِ قَد سَجَعَت","وَرقَاءُ حَمدِيَ بِالأبكَأرِ وَالأصُلِ",5,"ل",1,0],["فَإِن أَفاقَ لَقَد طالَت عَمايَتُهُ","وَالمَرءُ يُخلِقُ طَوراً بَعدَ أَطوارِ",6,"ر",1,0],["فأنا فيك أطرحُ الآن آلا","مي وعبءَ الحياة والأحقابِ",7,"ب",1,0],["فَإِنْ أَفَادَ رَاحَةً","أَوْ سَلوَةً مِنَ الضَّجَرْ",8,"ر",1,0],["فان افاتك سوء الجد صالحة","فحد همك في ادراكها بدل",9,"ل",1,0],["فانا في انقِباضةٍ وانبساطٍ","تارةً وانفراجةٍ واصطكِاك",10,"ك",1,0],["فإنا في ربى البلقاء","لا شام ولا نجد",11,"د",1,0],["فأنا في قيدِ دلٍّ وإسَارِ","عفوك اللهم يا رب الأنام",12,"م",1,0],["فإن افتر ثغره عبست","ونفته لساحة الوجد",13,"د",1,0],["فَأَنا في سَردِها أَصدقُ إِذ","إِنَّها قَد حَدَثَت في مَنزِلي",14,"ي",1,0],["فأنا ف الذي تحسّ وتبلو","أنت رغم ابتعادنا في الوجود",15,"د",1,0],["فأنا في الحياة بين مرج","مستحيلاً او يائس يتظلم",16,"م",1,0],["فأنا في الدهر وحدي","وعدوي الدهرُ وحده",17,"د",2,0],["فإن أفاض كاتباً ظننتَه","بالقلَم الجاري الضلوعَ طعَنا",18,"ن",2,0],["فإن أفقتُ فما أفاقَ من هرمٍ","مُسْقيكَ إيّاه غيرُ ميّتٍ لُحِدا",19,"د",2,0],["فإنْ أفَقْتُ فعندي كلّ قافيةٍ","تَتْرى وقد ضَمِنَ الإنجازَ من وعدا",20,"د",2,0],["فإن أفل البدر الفريد وأصبحت","ربوع ذوي الإسلام منه خواتليا",21,"ي",2,0],["فإن أفزع فكهف علاه حرزي","وإن أعطش فبحر نداه وردي",22,"د",2,0],["فإن افترقتم عنده","كنتم جميعكم فريقه",23,"ق",2,0],["فَإِنَّ اِفتِخارَ المَرءِ في فعلِ غَيرِهِ","يَعدّونَهُ مِثلَ اِفتِخارِ الخصيِّ",24,"ي",1,0],["فأنا في كفهِ","حتف مَنْ عاندني",25,"ي",1,0],["فأنا في جانبِ البيت نِضْوٌ","ما أطيقُ الخطْوَ إلا قِصارا",26,"ر",2,0],["فأنا فيك بين دمع طليق","وفؤادٍ في عَقْلَةِ الاكتئابِ",27,"ب",1,0],["فأنا فردٌ وحيدٌ","وأنا الكلُّ بذاتي",28,"ت",2,0],["فَإِن أَفحَمَتنا هَيبَةٌ عُمَرِيَّةٌ","لَدَيكَ لَها في الشِعرِ كَسرٌ وَإِقواءُ",29,"ا",2,0],["فَإِن أَفَضتُ مَديحي في شَمائِلِهِ","وَاِستَبدَلَ الجَفنُ حُلوَ النَومِ بِالسَهَرِ",30,"ر",1,0],["فأنا في حبها محتضر","وشفائي قبلة واحزني",31,"ن",2,0],["فان أَفقتٌ مريضاً","فالجوّ مثلي مريض",32,"ض",1,0],["فإن أفقنا عدنا لسيرتنا","في الدرس نفني العقول إفناء",33,"ا",2,0],["فأنا في غاية الجهد مذ غا","ب وقطني قد كان قطناً نضيرْ",34,"ر",1,0],["فإنا في هواك عبيد رقٍ","على حبٍ وما كنا سُبينا",35,"ن",2,0],["فأنا في مأتم وَالقَومُ في","عيدِهم وَالحورُ تستجلي العروس",36,"س",1,0],["فَأَنا في زَمهرير أَو أَنا","في سَعيرٍ بَينَ نار وَبَرد",37,"د",1,0],["فأنا فيه أشعر الناس طراً","كل نور أمام نوري ضئيل",38,"ل",1,0],["فإن أفول النجم ليس بضائرٍ","لمسترشد والبدر ليس بآفل",39,"ل",1,0],["فَأَنا في الهَوى شَهيدٌ وَحَسبي","رَبَّةُ التاجِ وَالحُسامِ المُحَلّى",40,"ل",2,0],["فَأَنا في الوَفاءِ مِثلُ يَزيدٍ","حينَ لاموه في هَواهُ سَلامَه",41,"م",2,0],["فَأَنا في الكَونِ وَحدي","مالِكُ الجَمعَين",42,"ن",1,0],["فأنا في جنونِ عشقِك أُمسي","بين طيف الكرى وعَينيَّ سَدُّ",43,"د",1,0],["فإن أفلتت منك الظنون لغاية","جموحا فما النجوى إذا قُيِّدت تعتو",44,"ت",2,0],["فَأنَا فِي ْالرَّوْضِ نَفْحٌ","رَاحَ يَشْدُو للسَعَاده ْ",45,"د",2,0],["فانا فلسطيني الهوى ولجاجتي","بالعود أني لن أعيش غريبا",46,"ب",2,0],["‏فأنا في سحرها مرتهنٌ","‏بخيالاتي غدوًّا وأصيلا",47,"ل",2,0],["فانا فقير يا محمد فلتجد","لي بالمنى وانظر إلى إقتار",48,"ر",1,0],["فإن أفل لا تلومي البدر إن له","ميعاد عودته لا يخطىء الزمنا",49,"ن",2,0],["فأنا في بيتي لي ملكة","للنحل ونهر للكوثر",50,"ر",1,0],["فإنْ أفيقَ علىٰ صوتٍ فيُطرِبني","وإنْ أعيشَ فقد أشْعَلْتِ مِشْكَاتي",51,"ت",2,0],["فأنا في النّوى وفي كل ساقٍ","حفظته للنائبات العروق",52,"ق",1,0],["فأنا في مُلكِ الله أرى","سعدي في ظلِّ القرآن",53,"ن",1,0]]}