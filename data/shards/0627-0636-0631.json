=199259",""],[4929,"مئذنة الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=199511",""],[4968,"طوق الحرير","https://www.poetsgate.com/ViewPoem.aspx?id=208082",""],[4988,"ريق الفخر يحتاج كفواً يبّله","https://www.poetsgate.com/ViewPoem.aspx?id=180840",""],[5030,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=215790",""],[5100,"بسطة في الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=207704",""],[5122,"غريب طبعك","https://www.poetsgate.com/ViewPoem.aspx?id=18651",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5147,"أضر بجسمي عرق النسا","https://www.poetsgate.com/ViewPoem.aspx?id=166690",""],[5168,"ماسنجر النت","https://www.poetsgate.com/ViewPoem.aspx?id=33624",""],[2365,"قفا صاحبيّ نحىّ الطلل","https://www.poetsgate.com/ViewPoem.aspx?id=200654",""],[5325,"هل يعلم الدهر من أردت فوادحه","https://www.poetsgate.com/ViewPoem.aspx?id=171973",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5376,"أيها الغاصب ....إنها القدس","https://www.poetsgate.com/ViewPoem.aspx?id=188543",""],[5431,"ثغره النهم","https://www.poetsgate.com/ViewPoem.aspx?id=183254",""],[5431,"يامنية الروح","https://www.poetsgate.com/ViewPoem.aspx?id=185125",""],[5431,"السيجارة تتكلم ...(كأنني الأمُ ضمّت حبها الأبدي)","https://www.poetsgate.com/ViewPoem.aspx?id=198689",""],[5431,"على لسان شاعر!...","https://www.poetsgate.com/ViewPoem.aspx?id=205607",""],[5436,"فجّر الثورة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35273",""],[5459,"دوح النهى","https://www.poetsgate.com/ViewPoem.aspx?id=198288",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5616,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=203475",""],[5626,"الله اكبر رايةً نختارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189693",""],[5660,"فَالوَصلُ وَ الصَّدُ في أَيامِنا دُوَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23914",""],[5704,"ما نال قلبي من وصالك سؤله...","https://www.poetsgate.com/ViewPoem.aspx?id=202955",""],[5732,"يا سيفنا القطاع","https://www.poetsgate.com/ViewPoem.aspx?id=177833",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[5781,"هاتها نصفَ وسادةٍ وقلب","https://www.poetsgate.com/ViewPoem.aspx?id=202834",""],[5907,"رحلة الامس !","https://www.poetsgate.com/ViewPoem.aspx?id=176270",""],[5956,"اخضعي لي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182616",""],[5957,"في ذكرى الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=177637",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[6003,"منفى وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=201021",""],[6031,"بِرغمِ العَوَالِي والمُهَنَّدَةِ البُتْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=46342",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6097,"المرأة والحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=190696",""],[406,"صرخة في زمن الهمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63267&r=&rc=78",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""],[6300,"نشوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82840&r=&rc=11",""],[5190,"اصمد وقاوم أيها اللبناني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78289&r=&rc=3",""],[5190,"انتفاضة الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78346&r=&rc=59",""]],"verses":[["أَضَرُّ الأَنامِ لِيَ الأَقرَبون","وَأَعدى الوَرى لِيَ جيرانِيَه",0,"ي",2,0],["أَضَرّاً وَلُؤماً لا أَباً لِأَبيكُمُ","سَفاهاً لِرَأيِ العاجِزينَ سَفاها",1,"ا",3,0],["أَضرَمَتها بَيضاءُ تَهتَزُّ كَالغُص","نِ إِذا ما اِنثَنى بِمَرِّ النَسيمِ",2,"م",1,0],["أضْرَمْتَ قلْبي ناراً","يا مالِكَ بْنَ نوَيْرَةْ",3,"ه",1,0],["أضْرَمَ النّارَ في فُؤادي وهَلْ تُنْ","كَرُ نارٌ تولّدَتْ عنْ سِراجِ",4,"ج",1,0],["أَضْرَمَ النَّارَ فِي الْحَشَائِشِ يَحْيَى","مِثْلَمَا تُضْرِمُ الْحَشيش بِقَلْبِهْ",5,"ه",1,1],["أَضَرَّت بِهِ الأولى فَهامَ بِأُختِها","فَإِن ساءَتِ الأُخرى فَوَيلاهُ مِنهُما",6,"م",2,0],["أَضَرَّ بِها الإِدلاجُ حَتّى كَأَنَّها","مِنَ الأَينِ خِرصانٌ نَحاها مُقيمُها",7,"م",3,0],["أَضَرَّت بِها الأَنواءُ وَالريحُ وَالنَدى","وَغَيَّرَ مَغناها الضُحى وَالأَصائِلُ",8,"ل",1,0],["أَضَرَّ بِها عَلقُ السُّرَى كُلَّ لَيلَةٍ","إِليكَ فإِسآدي ضُحىً كُلَّ صَيهَبِ",9,"ب",1,0],["أَضَرَّ بِهِم إِرثُ النَبِيِّ فَأَصبَحوا","يُساهِمُ فيهِم ميتَةٌ وَمَنونُ",10,"ن",1,0],["اِضرِب بِهِ نَحرَ العَدُوِّ فَإِنَّهُ","جَيشٌ مِنَ الطاعونِ وَالبِرسامِ",11,"م",1,0],["اِضرِب نَدى طَلحَةَ الطَلحاتِ مُبتَدِئاً","بِلُؤمِ مُطَّلِبٍ فينا وَكُن حَكَما",12,"م",2,1],["أَضَرَّت بِها الأَرواحُ أَو كُلُّ ذَبلَةٍ","دَروجٍ مَتى تَعصِف بِها الريحُ تَرسُمِ",13,"م",1,0],["أضرّ بعفّ الذيل حتى أمضّه","ولم يلتفت منه إلى واضح الغدر",14,"ر",1,0],["أَضَرَّ بِمِسحاجٍ قَليلٍ فُتورُها","يَرِنُّ عَلَيها تارَةً وَيَصومُ",15,"م",1,0],["أَضَرَّ بِجِسمِيَ مَرُّ الدُهورِ","وَخانَ قِراعَ يَدي الأَكحَلُ",16,"ل",1,1],["أضرمْتني ثم حِلتَ تُطفئني","هلا تضرعتَ قبل إكماشي",17,"ش",2,0],["أضرستنا مُدامةٌ منه تحكي","ضجرةً تعتريك من ضِيفانِك",18,"ك",1,0],["أضربُ من يضربُني سادراً","وتارةً أرمي الذي يرمي",19,"م",2,0],["أَضَرَّ بِأَخفافِ البُغَيلَةِ أَنَّها","حِذارَ اِبنِ رِبعِيٍّ بِهِنَّ رُجومُ",20,"م",1,1],["أَضَرَّ بِها التَهجيرُ حَتّى كَأَنَّها","بَقايا سُلالٍ لَم يَدَعها سُلالُها",21,"ه",2,0],["أُضرِيَ بِالشَمِّ لِساني وَمَرَد","أَقودُ مَن شِئتُ وَصَعبٌ لَم أُقَد",22,"د",1,0],["أَضَرَّت بِها النَكباءُ كُلَّ عَشِيَّةٍ","وَنَفخُ الصَبا وَالوابِلُ المُتَبَعِّقُ",23,"ق",1,0],["اِضرِبِ العودَ تَفُه أَوتارُهُ","بِالَّذي تَهوى وَتَنطِقُ ما تَشاء",24,"ا",2,0],["أَضرَت شَجاعَتُهُ أَقصى كَتائِبِهِ","عَلى الحِمامِ فَما مَوتٌ بِمَرهوبِ",25,"ب",1,0],["أضرَّ به جُوعٌ طويلٌ فشَفَّهُ","وأبقى له جِلداً رقيقاً وأعظُما",26,"م",2,0],["أضرَّ به حُبُّ الجَماجمِ والطُّلَى","فغادَرهُ نِضواً نحيلَ المضاربِ",27,"ب",1,0],["أَضَرَّت بِضَوءِ البَدرِ وَالبَدرُ طالِعٌ","وَقامَت مَقامَ البَدرِ لَمّا تَغَيَّبا",28,"ب",2,0],["أَضَرَّ بِها التِرحالُ حَتّى تَحَوَّلَت","مِنَ الأَينِ سوداً بَعدَ عيدِيَّةٍ صُهبِ",29,"ب",1,0],["أَضَرَّ بِهِنَّ البُعدُ مِن كُلِّ مَطلَبٍ","وَحاجاتُ زَجّالٍ ذَواتُ هُمومِ",30,"م",1,0],["أضريحه حييت من ديم الحيا","بمؤرق الأجفان ليس براقي",31,"ق",2,0],["أضرَمْتَ نارَ المَنايا في النُّفوسِ بِه","ضَرماً وأَخْمَدْتَ من نيرانِهِ ضَرَما",32,"م",2,0],["أَضرِبُ السَيفِ عَلى المغافِرِ","مَعَ النَبيِّ المُصطَفى المُهاجِرِ",33,"ر",1,0],["أَضرَّ بِجِسمِهِ سَهَرُ اللَيالي","فَصارَ الجِسمُ مِنهُ كَالقَضيبِ",34,"ب",1,0],["اِضرِب بِطَرفِكَ حَيثُ شِئتَ فَأَنتَ في","عِبَرٍ لَهُنَّ تَدارُكٌ وَتَوالِ",35,"ل",1,0],["إِضرِب بِطَرفِكَ حَيثُ شِئ","تَ فَلا تَرى إِلّا بَخيلَ",36,"ل",1,0],["أَضرَبتَ صَفحاً إِذ أَتَتكَ صَحيفَتي","فَطَوَيتَ كَشحاً عِندَ رَدَّ رَسائِلي",37,"ي",1,1],["أضرَمْتَ قلبي فارتمى بشرارةٍ","وَقَعَتْ بخدّكَ فانطَفَتْ من مائِهِ",38,"ه",1,0],["إِضرِب لَنا أَجَلاً نَعُدُّ لَهُ","إِخلافُ موعِدِهِ تَقاطُعُنا",39,"ن",2,0],["أَضَرَّ بِكُنَّ العامَ نَوءُ سَحابَةٍ","وَمَحلٌ فَما تَجري لَكُنَّ عُيونُ",40,"ن",1,0],["اضربْ لنا مَثَلَ الجهادِ وسِرْ بنا","نَغْشَى الوقائعَ فالحياةُ صِدامُ",41,"م",1,0],["أَضَرُّ الناسِ ذو تاجٍ تَوَلّى","فَما نَفَعَ البِلادَ وَلا أَفادا",42,"د",2,0],["اضربْ رسولَ اللهِ كم من صخرةٍ","لم تألُها صدعاً ولا تحطيما",43,"م",2,0],["أَضرموا النارَ وَصَبّوا فَوقَها","دَمَهُم حُرّاً أَبيّاً يَغتلي",44,"ل",2,0],["أَضراسها تُؤلِمُها لَيتَني","أَشكو الَّذي سَبّب شَكواها",45,"ا",3,0],["أَضرم الذكريات بي ثُمَ وَلى","لا رَماكَ الصَياد أَسرفت جدا",46,"د",2,0],["أَضَرَّت بِهِ الأَرواحُ كُلَّ عَشِيَّةٍ","وَكُلُّ هَزِيمِ الرَعدِ بِالماءِ مُرهَمِ",47,"م",1,0],["أَضَرَّ بِهِ بَعدَ الأُلى عَمَرُوا بِهِ","تَقادُمُ أَرواحٍ وَمَرُّ دُهُورِ",48,"ر",1,0],["أَضَرَّ بِهِ صَوبٌ مِنَ المُزنِ وابِلٌ","وَكَشفُ رِياحٍ ذارِياتٍ دَوارِجُه",49,"ج",2,0],["أَضرَمتَ نارَ الحُبِّ في قَلبي","ثُمَّ تَبَرَّأتَ مِنَ الذَنبِ",50,"ب",1,1],["أَضَرَّت بِهِ الأَيّامُ حَتّى كَأَنَّهُ","عِنانٌ لَواهُ بِاليَدَينِ رَفيقُ",51,"ق",1,0],["أَضَرَّ بِجَرداءِ النُسالَةِ سَمحَجٍ","يُقَلِّبُها إِذ أَعوَزَتهُ الحَلائِلُ",52,"ل",1,0],["أَضَرُّ لِمَن تَوَدُّ مِنَ الأَعادي","وَأَسرَقُ لِلمَقالِ مِنَ الزَبابِ",53,"ب",1,0],["أَضَرُّ مِن جُدَرِيٍّ شانَ حامِلَهُ","بِحَملِهِ جَدِرِيٌّ جاءَ مِن جَدَرِ",54,"ر",1,0],["أَضَرَّت بِالصَفا وَتَخَوَّنَتهُ","وَمَرَّت بِالصَفاءِ فَرَنَّقَتهُ",55,"ت",2,0],["أضرمتَ حولكَ في الأرض التُّخوما","تقتفي شيطانكَ الفظّ الغَشوما",56,"م",2,0],["أضْرِبُ الضّرْبَةَ الفَريغَ كفِي البا","زِلِ أحْيا له المُرارُ مَرِيرا",57,"ر",2,0],["اضربْ وَليدكَ تَأديباً على رَشدٍ","ولاَ تَقُلْ هُوَ طِفلٌ غيرُ مُحتلم",58,"م",1,1],["أَضَرَّ بِأَعْنَاقِ النَّعَائِمِ حَمْلُهُ","فَأَلْقَتْ بِهِ عَنْ ظَهْرِهَا فَهْوَ يَرْسُفُ",59,"ف",1,0],["أَضْرَمْتَ ثَوْرَتَكَ الهَوْجاءَ فَالتَهَمتْ‏‏‏","مِنَ القَريضِ الهَشيمَ الغَثَّ وَالخَشَبا‏‏‏",60,"ب",2,0],["أَضَرَّ بِمُقلَتَيَّ هُمولُ دَمعي","وَسُهدُهُما فَهَب لَهُما غِماضا",61,"ض",2,0],["أضرت بحزبيْها وإن تم نصرُها","لحزب وقاسى ذلَّ خِذلانها حزب",62,"ب",1,0],["أضرم النار في الحشيشِ يحيى","مثلما تضرِمُ الحشيش بِقلبه",63,"ه",1,1],["أضرّ بجرداءِ النسالة ِ ، سمحج","، يقبلها ، إذْ أعوزتهُ الحلائلُ",64,"ل",1,0],["اضَرِبْ بِهِ جيشَ العَدُوِّ فَوَجْهُهُ","جَيْشٌ مِنَ الطَّاعونِ والبِرْسامِ",65,"م",1,0],["أضرَّ بمسحاجٍ فُتُورُهَا","يَرِنُّ عَليها تَارة ً وَيَصُومُ",66,"م",1,0],["اضرني جفاك يا فلان","ومهجتي رصعها السنان",67,"ن",1,1],["أضر عيني عليك البكا","ارفق بيعقوبك يا يوسف",68,"ف",1,0],["أضربي الكتمان حتى عددتني","خليلاً من التبريح والوجد خاليا",69,"ي",2,0],["أضراسُها لؤلؤٌ والدُّرُّ منطقها","ووجهها قمرٌ والقدُّ سمراءُ",70,"ا",2,0],["اضربْ بسيفِ العزم أَعناق الكرى","وانظم شتات الأرض في سلك السرى",71,"ر",2,1],["أضرم في قلبي بهجرانه","نيرانه فضرما ضرّما",72,"م",2,0],["أَضَرَّ بهِ الأَوامُ فَحامَ وَهناً","عَلَى الوِردِ المُرَوِّي للشِّفاهِ",73,"ه",1,0],["أضرب بالجاذوف من غدوة","وأكرع الماء بغيب الشفق",74,"ق",1,0],["أَضرّت بِهم أنوارُ دين محمّدٍ","فَهرّت منَ الأنوارِ أكلبهم هرّا",75,"ر",2,0],["أَضرَمَ الوَجدُ نارَهُ بِحَشاهُم","وَلِثِقلِ الغَرامِ ناحوا وَناؤُوا",76,"ا",1,0],["أَضَرَّ بها حَرُّ الهَجِير فلَمْ تَجِدْ","لِغُلتَّها مِنْ بارِدِ الماءِ شافِيا",77,"ي",2,0],["أَضْرَى بَنِيه عَلى ضُرِّ العِباد فَقُلْ","في زُمْرَةٍ هَدَجَتْ لِلظُّلْمِ ظِلْمَانا",78,"ن",2,0],["أضَرّتْ بِها شَمسُ الضُحى ضَرّةً لها","فأطفأَها الإصْباحُ حِينَ تبلّجا",79,"ج",2,0],["أضرمت نار فؤادي والحشاءَ معاً","أوليتني في الورى حزناً على حزن",80,"ن",1,0],["أَضرَم الأَحشاء وَجداً وأَسىً","وَسَبى العَقلَ غَراماً وَسَبَه",81,"ب",2,0],["أَضرَّ بغادةٍ هيفاءَ رود","طوىً بحياتِها قَدْ كادَ يودي",82,"د",2,1],["أضرمَ النَّارَ في الحنايا لهيباً","مثلَ ليلٍ أضاءَ فيهِ شِهاب",83,"ب",1,0],["أَضَرَّ بِهِ التَعداءُ حَتّى كَأَنَّهُ","مَنيحُ قِداحٍ في اليَدَينِ مَشيقُ",84,"ق",1,0],["أَضَرَّ بِمِقلاةٍ كَثيرٍ لُغوبُها","كَقَوسِ السَراءِ نَهدَةِ الجَنبِ ضَمعَجِ",85,"ج",1,0],["اضرم النيران ما دام الحديد","حامياً واضرمه من غير ملال",86,"ل",1,0],["أَضرَّ بِمُقلَتي السَهَر الطَويلُ","وَقَرح جِفنَها الدَمع الهَمول",87,"ل",1,1],["أَضرمت نار اِشتياق لَم تَكُن خَمَدَت","فَاِنهل وَاكف دَمع لَم يَكُن جمدا",88,"د",2,0],["أضر بأسناني وكانت كلؤلؤ","يثور على رغمي من العقد منسل",89,"ل",1,0],["أضرَّ بي نَاظِرٌ تَدْمَى مَحَاجِرُهُ","وخَاطرٌ مُذْ نأوْا حيرانُ مُنْشَدِهُ",90,"ه",1,0],["أضَرَّ بها يا هُذيم الهوى","وها هي تشكوكَ من ضرِّها",91,"ر",3,0],["أضَرَّ بنا فَدَتْك النَّفس جوع","ويعجبنا مربّى الزنجفيل",92,"ل",1,0],["أضَرَّ بك الهوى لا باختيار","وما كانَ الهوى إلاَّ اضطرارا",93,"ر",2,0],["أضرِبْ به لا بمنهل الحَيا مثلاً","ما الماءُ والمالُ في الأزمانِ مِثْلانِ",94,"ن",1,0],["أضرمت في كبدي لبعدك لوعة","حنتِ الضلوعَ على جوى متوقّد",95,"د",1,0],["أضرّ بي إذا جدّ في كعبه","ظبي غدا والفؤاد من سلبه",96,"ب",2,1],["أضرّ بي الدهر فالايام لا جدة","حصّلتُ فيها ولا مال ولا ولد",97,"د",1,0],["أضَرَبتْ أسدادُ جوٍّ غيرَها","على المطيّ أم على الأرض طَبقْ",98,"ق",1,0],["أضرَّت بنا وهي المنى وأضلّنا","بها الحبُّ عن نهج الهدى وهي أنجم",99,"م",1,0],["أضرَّ بعيني دمعُها وانسكابُهُ","على طللٍ أعيا عليَّ جوابُهُ",100,"ب",2,1],["اضربي الصفح عن سلوي فاني","لست أسلوك لا ابتغيت السلوا",101,"و",2,0],["أضرموها لنصرة الحق حربا","فأضلّوا السبيل في ملتقاه",102,"ا",2,0],["أَضرَمَ الماءُ بِالشَقيقِ بِها النا","رُ وَعَهدي بِالماءِ ضِدَّ النارِ",103,"ر",1,0],["أضرَّ بِها التَهجيرُ حَتّى كَأَنَّ