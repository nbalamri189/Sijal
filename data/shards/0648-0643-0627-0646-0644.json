tps://www.aldiwan.net/poem55831.html","الطويل"],[456,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[456,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[456,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[456,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[456,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[462,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[463,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[466,"وظبي بدا الشعر في خده","https://www.aldiwan.net/poem59825.html","المتقارب"],[475,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[503,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[513,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[513,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[536,"دعوني فإني لا أطيق التكلما","https://www.aldiwan.net/poem47949.html","عموديه"],[549,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[549,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[549,"ألم تسأل الطلل الدارسا","https://www.aldiwan.net/poem47752.html","المتقارب"],[549,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[549,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[551,"لولا سيوف أبي الزبير وخيله","https://www.aldiwan.net/poem68423.html","الكامل"],[557,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[560,"تنبهوا يا عباد الله واعتبروا","https://www.aldiwan.net/poem52799.html","البسيط"],[565,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"فارقت من كنت له مالكاً","https://www.aldiwan.net/poem2700.html","السريع"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[573,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[573,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[582,"أعيني جوادا بدمع سرب","https://www.aldiwan.net/poem69391.html","المتقارب"]],"verses":[["وَكانَ لَنا أَمامَكَ كُلُّ نَقصٍ","يَكونُ مِنَ الرَدى وَلَكَ التَمامُ",0,"م",1,0],["وكانَ لهُ سَوادُ الليلِ جاراً","وبئْسَ الجارُ للبَطلِ السّوادُ",1,"د",1,0],["وكانَ لِسانيَ سيْفاً صَقيلاً","وكانَتْ يَراعي قَناً ذُبَّلا",2,"ل",2,0],["وَكانَ لَها في سالِفِ الدَهرِ خُلَّةٌ","يُسارِقُ بِالطَرفِ الخِباءَ المُسَتَّرا",3,"ر",2,0],["وَكانَ لِزازَ الحَربِ عِندَ شُبوبِها","إِذا شَمَّرَت عَن ساقِها وَهيَ ذاكِيَه",4,"ي",2,0],["وكان لا ينكر منا إذا","قلنا غداة الفخر نحن الأولى",5,"ل",2,0],["وَكَانَ لِلعَقْلِ تَاجٌ","يَزِينُ مِنْهَا الْجَبِينَا",6,"ن",2,0],["وَكَأَنَّ لَيلي مِن تَذَكَّرِيَ الهَوى","لَيلٌ بِأَطوَلِ لَيلَةٍ مَوصولُ",7,"ل",1,0],["وَكانَ لَنا خَرجٌ مُقيمٌ عَلَيهِمُ","وَأَسلابُ جَبّارِ المُلوكِ وَجامِلُه",8,"ل",2,0],["وكان لبيت الفشعة الهِدم والصبا","أحاديث منها عاليات الأراودِ",9,"د",1,1],["وَكانَ لِباثُكَ عَن صاحِبَيكَ","كَمُلجِمِ طَرفٍ وَلَم يُسرَجِ",10,"ج",1,0],["وكانَ لي جدّ سعيد فيَا","لهفِي على جدَّين قد ماتا",11,"ت",2,0],["وكان للَّه غيبٌ فيه يَحْجُبُهُ","عنَّا وعنه مع الغيب الذي حَجَبا",12,"ب",2,0],["وكان لي بينهم وعندهمُ","مضطرب واسع ومرتفقُ",13,"ق",1,0],["وكأن لهوتَك التي تعطى لُهىً","وكأنَّ سَجلكَ في المعاطِش أسجُلُ",14,"ل",1,0],["وكان لنا في كلّ حقّ وباطلٍ","جُنوحٌ إلى الشأن الذي هو أفخمُ",15,"م",1,0],["وكان لي أُنساً لدَى وَحْشتي","وكان لي رَوْحاً وريحانا",16,"ن",2,0],["وَكانَ لَهُ في الدَهرِ بَطشٌ وَصَولَةٌ","فَأَمسَت عَلَيهِ الحادِثاتُ تَصولُ",17,"ل",1,0],["وَكانَ لَهُ أَلفا خَليلٍ وَصاحِبٍ","فَأَعوَزَهُ عِندَ البَلاءِ خَليلُ",17,"ل",1,0],["وَكانَ لي أَمَلٌ إِذا كانَ لي وَطَنٌ","فيهِ لِنَفسي لُباناتٌ وَخِلّانُ",18,"ن",1,0],["وَكانَ لِلسِحرِ تَأثيرٌ فَأَبطَلَهُ","بِالسِحرِ يَجري حَلالاً في قَوافيهِ",19,"ي",2,0],["وَكانَ لَنا في الكُتبِ عَونٌ عَلى الأَسى","وَفي البَرقِ ما يُدني المَدى المُتَرامِيا",20,"ي",2,0],["وَكانَ لَهُ نَشرٌ يَفوحُ وَبَهجَةً","كَما اِفتَرَّ عَن زَهرِ الرِياضِ كَمائِمُه",21,"م",2,0],["وَكانَ لَها في أَوَّلِ الدَهرِ فارِسٌ","إِذا ما رَأى قَيدَ المِئينَ يُعانِقُه",22,"ق",2,0],["وكان لجيش الحق في مصر قائدا","فخر وظل الجيش من غير قائد",23,"د",1,0],["وكان لما ناله","بالسهم غير كاذب",24,"ب",1,0],["وكأن لم أوافها وكأن لم","تك بيني وبينها أشياءُ",25,"ا",2,0],["وكان لنا بلاء في كريد","بيوم ثائر الهيجا شديد",26,"د",1,0],["وَكانَ لِقَومِهِ نَفعاً وَفَخراً","وَلَو تَرَكوهُ كانَ أَذىً وَعابا",27,"ب",2,0],["وكان له خبرة بالدواء","وانعقاده ويجراله",28,"ل",2,0],["وَكانَ لِتَقويمِ الأُمورِ إِذا التَوَت","عَلَيهِ وَتَدبيرِ الحُروبِ اللَواقِحِ",29,"ح",1,0],["وَكانَ لَنا اسمُ الجودِ حَتّى جَعَلتُمُ","تَغَضّونَ مِنّا بِالخِلالِ الكَرائِمِ",30,"م",1,0],["وَكانَ لا يَهدِمُني وَأَهدِمُه","أَيّامَ لي مُبشَرُهُ وَمُؤدَمُه",31,"م",2,0],["وَكانَ لَهُم حَبلاً قَدِ اِستَكرَبوا بِهِ","عَراقِيَ دَلوٍ كانَ فاضَ ذَنوبُها",32,"ب",3,0],["وَكانَ لَهُم لَمّا عَوى الكَلبُ دونَهُم","جَريرٌ عَلَيهِم مِثلَ راغِيَةَ السَقبِ",33,"ب",1,0],["وَكانَ لَهُ النَهرُ المُبارَكُ فَاِرتَمى","بِمِثلِ الزَوابي مُزبِداتٍ حَواشِدِ",34,"د",1,0],["وَكانَ لَهُم كَبَكرِ ثَمودَ لَمّا","رَغا ظُهراً فَدَمَّرَهُم دَمارا",35,"ر",2,0],["وَكانَ لَنا شَيخانِ ذو القَبرِ مِنهُما","وَشَيخٌ أَجارَ الناسَ مِن كُلِّ مَقبَرِ",36,"ر",1,0],["وَكانَ لِمَن رَدَّ الحَياةَ وَنَفسُهُ","عَلَيها بَواكٍ بِالعُيونِ الذَوارِفِ",37,"ف",1,0],["وَكانَ لَها ماءُ الكَواظِمِ غُرَّةً","وَحَربُ تَميمٍ ذاتُ خَبلٍ مِنَ الخَبلِ",38,"ل",1,0],["وَكانَ لَهُم يَومانِ كانا عَلَيهِمُ","كَأَيّامِ عادِن بِالنُحوسِ الرَشائِمِ",39,"م",1,0],["وكأنَّ لا بِسَها يُعاينُ جَوهراً","من لَفْظِها أو يَستَشِفُّ شُفوفا",40,"ف",2,0],["وكَأَنَّ للكاساتِ حُمْرَ غلائلٍ","أزرارها دُرَرٌ على الأطواقِ",41,"ق",1,0],["وكأنّ لَوْمَكَ رافضِيٌّ مَيِّتٌ","وكأَنَّ سَمعي إِذ نَعاهُ بقيعهُ",42,"ع",2,0],["وكأنّ للياقوتِ ماءً مزبداً","فالدرُّ فيه بكأسها سَبّاحُ",43,"ح",1,0],["وكأنّ ليلة عزمهم زَنْجِيّةٌ","زِينَتْ بِحلْيِ نجومها فتحلّتِ",44,"ت",1,0],["وكان لهم جَذْبُ الأصابِعِ لم يَكُن","رواجبُ منها حانياتِ رواجِبِ",45,"ب",1,0],["وَكانَ لَهُم غَيثاً وَعِلماً فَمُعدِمٍ","فَيَسأَلُهُ أَو باحِثٍ فَيُسائِلُه",46,"ل",2,0],["وَكانَ لَها جبرٌ أَميناً وَحامياً","إِذا ما بَغى الباغي عَلَيها أَو اِعتَدى",47,"د",2,0],["وَكانَ لَها الجودِيُّ نِهياً وَغايَةً","وَأَصبَحَ عَنهُ مُوجُهُ مُتَراخِيا",48,"ا",1,0],["وَكانَ لا يَحمِلُ مِن أَموالِها","شَيئاً وَيَستَقصي عَلى اِستِئصالِها",49,"ه",2,0],["وَكَأَنَّ لَحيَهُ","مُفتِحاتٌ سَفَطا",50,"ط",2,0],["وَكانَ لِواحِدٍ حَتّى","يَضُمُّكَ في الهَوى رَحِمُ",51,"م",1,0],["وَكَأَنَّ لِلذَهَبِ المَذوبِ بِكَأسِها","بَحراً يَجيشُ بِأَعيُنِ الحيتانِ",52,"ن",1,0],["وَكَأَنَّ لِلساعاتِ أَجنِحَةً","فَإِخالُهُنَّ بِها قَطاً حُذّا",53,"ذ",2,0],["وَكانَ لَكُم حِرصٌ عَلى العَيشِ بَيِّنٌ","فَما لَكُم حِمتُم عَلى ضِدِّهِ حِرصا",54,"ص",2,0],["وَكانَ لَها جارانِ قابوسُ مِنهُما","وَعَمروٌ وَلَم أَستَرعِها الشَمسَ وَالقَمَر",55,"ر",1,0],["وَكانَ لَهُ الحَينُ المُتاحُ حَمولَةً","وَكُلُّ اِمرِئٍ رَهنٌ بِما قَد تَحَمَّلا",56,"ل",2,0],["وَكانَ له زوج وكان ركونُه","إليها كَثيراً فهي تنهى وَتأمر",57,"ر",1,0],["وكانَ له منها فتاة جَميلةٌ","قَد اِشتَهَرَت واسم الجَميلةِ دلبر",57,"ر",1,0],["وَكانَ لذعر فيه يرجف جسمه","كأَنَّ به حمَّى لعطفيه تنفض",58,"ض",1,0],["وَكانَ لَدى الهَيجاءِ يَحمي ذِمارَها","وَيَطعَنُ عِندَ الكَرِّ كُلِّ طِعانِ",59,"ن",1,0],["وَكَأَنَّ لُؤْلُؤَةً بِقَائِمِ سَيْفِهِ","عَيْنٌ تَعُدُّ عَلَيْهِمُ الآجَالاَ",60,"ل",2,0],["وَكَأّنَّ لَيْلَى بَيْنَهُمْ","مَلَكٌ تَكَفَّل بِالعَزَاءْ",61,"ا",2,0],["وَكَأَنَّ لأَلاَءِ المَسِيحِ بِوَجْهِهِ","إِذْ تَنْجَلي عَنْ وَجْهِهِ الأَسْتَارُ",62,"ر",1,0],["وَكَانَ لَهُ وَذَاكَ دُعَاءُ مِصْرٍ","عَلَى آيَاتِ هِمَّتِهِ مُثِيبَا",63,"ب",2,0],["وَكَانَ لَنَا النّبيُّ وَزِيرَ صِدْقٍ","بِهِ نَعْلُو البَرِيَّة أجْمَعِينَا",64,"ن",2,0],["وَكانَ لي وَلِفِهر","بِمُنتَماك اِفتِخارُ",65,"ر",1,0],["وكان لها رمزَ الحياة فأشرقتْ","كما هز أفنانَ الخمائل صَيِّبُ",66,"ب",1,0],["وكان لنا -إذْ نحن عُزْلٌ- ذخيرةً","نصُدُّ بها الجيشَ الذي جاء غازيا",67,"ي",2,0],["وكان لا يصحو ، ولا يرتوي","من دفء هذي الثروة الحاشده",68,"د",2,0],["وكان لنا منهم سلاحٌ فأصبحوا","سلاحاً علينا بين حين وآخر",69,"ر",1,0],["وكان له الدّهر بطش وصولة","فأعوزه، عند البلاء، خليل",70,"ل",1,0],["وكانَ لَهُمْ حَبلٌ قَدِ استكرَبوا بِهِ","عَرَاقيَ دَلْوٍ كانَ فاضَ ذَنُوبُها",71,"ب",3,0],["وكأن لهوتَك التي تعطى لُهاً","كأنَّ سَجلكَ في العاطِش أسجُلُ",72,"ل",1,0],["وكان لزاماً أن تتمَّ سيادةٌ","عليه لأبناءِ \" الذوات \" الأطايب",73,"ب",1,0],["وكان لزاماً أن تُقادَ جموعُه","حفاةً عراةً مهطعينَ \" لراكب \"",73,"ب",1,0],["وكان لزاماً أن تحاكَ دسائسٌ","له تحت أستار الخِداع الكواذب",73,"ب",1,0],["وكان لزاماً أن تعطَّل صنعةٌ","وأن يُصبحَ التوظيفُ أغلى المكاسب",73,"ب",1,0],["وكان له فيمن تقدم زاجرٌ","ولكن ذوُو الأهواءِ صُمٌّ وعميانُ",74,"ن",1,0],["وَكانَ لَنا حَوضُ السِقايَةِ فيهِم","وَنَحنُ الذُرى مِنهم وَفَوقَ الكَواهِلِ",75,"ل",1,0],["وَكانَ لَمّا اِلتَقى الجَمعانِ بَينَهُما","ضَربٌ بِهِ حَلَقُ الماذِيِّ يَنتَثِرُ",76,"ر",1,0],["وكان لنا الزمان بكم ضحوكا","فصار لنا بفقدكم عبوسا",77,"س",2,0],["وكان لنا دوام الدهر ذكرٌ","بذا نطق الكتاب ولا يزال",78,"ل",1,0],["وكان لآمالي بسوحك منهل","ومرعى خصيب لم تزل ثمره تجنا",79,"ن",2,0],["وكان لديهم مركب فيه بلغة","فظلوا به يسقون أموالهم سقيا",80,"ي",2,0],["وكان لكم في ذا وفيما لقيته","بيوسف الصديق أحسن اسوه",81,"ه",1,0],["وكانَ لنا وقد وافى طبيباً","وصارَ لنا وقد ولّى حبيبا",82,"ب",2,0],["وكان لحاتم قالوا قدور","بإحداهن للشاة انطباخ",83,"خ",1,0],["وكان لهم فيما يقال حشيمة","فذلوا وضاحت حرمة المال والأهل",84,"ل",1,0],["وكان له جنات نخل وأعنب","فاسرف حتى استبدل الأثل والخمطا",85,"ط",2,0],["وكانَ لنا دعاؤك في صُعودٍ","فكيفَ انحطَّ من تحتِ الصّعيدِ",86,"د",1,0],["وَكانَ لَهُم بِالحَزمِ يَومٌ عَصَبصَبٌ","وَقَد حَشَدَت لِلحَربِ تِلكَ القَبائِلُ",87,"ل",1,0],["وكان له محاشيّ مليح","خلاسيّ إذا ما حزّ رن",88,"ن",1,0],["وَكانَ لدى الحاجاتِ يدعوه يا أخي","يُلاطفهُ إِن راحَ يسأله أمرا",89,"ر",2,0],["وَكانَ لهُ فتح الفتوحِ لأنّه","بهِ نصَبَ الإسلامُ رايتهُ الكُبرى",89,"ر",2,0],["وكانَ له حزبٌ ضعيفٌ فعندما","أَحاطَ بهِ أعداؤهُ للرَدى فرّا",89,"ر",2,0],["وَكان لصحبهِ الأبطال حصناً","حَصيناً في الوغا والسلم ظلّا",90,"ل",2,0],["وَكَأَنَّ لَيلي حينَ تَغرُبُ شَمسُهُ","بِسَوادِ آخِرَ مِثلِهِ مَوصولُ",91,"ل",1,0],["وكأن ليلة إذ تقابلني","بعدَ التمنعِ ليلةُ القدرِ",92,"ر",1,0],["وكان لي قبل الهوى خاتمٌ","فالآن لو شئتُ تمنطقتُ بِهْ",93,"ب",2,0],["وكأنَّ لي في كلِّ عضوٍ واحدٍ","قلباً يحنُّ وناظراً ما يطرفُ",94,"ف",1,0],["وكان له صدر وسيع ومنكب","فلا بعد ذا بعد ولا قبل ذا قبل",95,"ل",1,0],["وَكانَ لِلنّاسِ آمالٌ مُحَبَّرَةٌ","تَفَكَّكَت عَن كَلاليبٍ وَأَرسانِ",96,"ن",1,0],["وكان له حسن التواضع شيمةً","حباه به الرحمن لا يتصنع",97,"ع",1,0],["وكان له صهراً وصلّى وراءه ال","نبي صلاة الصبح والصحب أجمع",97,"ع",1,0],["وكان له خالاً وأول من رمى","بسهم له في عصبة الشرك موقع",97,"ع",1,0],["وَكانَ لي قَلبٌ فَلَمّا زارَني","وَهَبتُهُ لِحُسنِهِ اِستِبشارا",98,"ر",2,0],["وَكانَ لَنا دُنوٌّ وَاِقتِرابٌ","لَديهِ فَمُنذُ قَدَّمَهُ بَعُدنا",99,"ن",2,0],["وَكانَ لا يَسمَحُ لي","بِالنَظَرِ المُستَرَقِ",100,"ق",1,0],["وكان له في آل عثمان مطمع","تقاصر عنه في المطامع أشعب",101,"ب",1,0],["وكان لي في قُريْشٍ أسْوَةٌ وكفى","مع النّجاشيِّ تَرْضاها الألِبّاءُ",102,"ب",3,0],["وَكانَ لكلٍّ نفعهُ وغناؤهُ","بِنفس جميعِ العالمين جنودُها",103,"د",3,0],["وكان لها شَرْقٌ وغَرْبٌ تَطرَّفا","وواسطةٌ فيها تُقامُ المَقاوِم",104,"م",1,0],["وكان لنا بُرءاً غِياثُك عاجِلاً","ويُمنُك نَرجو منه أَلاّ نَرى نِكْسا",105,"س",2,0],["وكان لَيلِي كأنّه نَفَسٌ","فصار لَيلي كأنّه نَفَسي",106,"ي",1,0],["وكأنّ لِحْيتَهُ هشيمٌ ماحِلٌ","وكأنّ أيدي القوم رِيحٌ صَرْصَر",107,"ر",1,0],["وَكانَ لِيَ الدَهرُ الغَشومُ مُحارِباً","وَقَد وَضَعَت أَوزارَها عِندَكَ الحَربُ",108,"ب",1,0],["وكانَ له في القُربِ صَبر على النَّوى","فأسلَمَهُ في البُعدِ للجَزَعِ الصَّبرُ",109,"ر",1,0],["وَكانَ لِسانُهُ الحاليّ يَشكو","إِلى نَظَر يُلاحظهُ اِحتياجا",110,"ج",2,0],["وَكان لهُ فيما أفادَ حلائِلٌ","عَجَلنَ إذا لاقينهُ قُلنَ مرحبا",111,"ب",2,0],["وكان لي جسدٌ أودَى السّقامُ به","فها أنا اليوم لا روحاً ولا جسدا",112,"د",2,0],["وكان لنا فيما يزيد مساعداً","ويا حبذا دهر بما شئت يسعد",113,"د",1,0],["وكان لها رب السموات ناصراً","لما ظفروا منها بأدنى مضرة",114,"ه",1,0],["وكانَ لأعشار قلبي بهِ","وحقِّ ودادِكَ ألفا رِيابِ",115,"ب",1,0],["وَكانَ لَهُم مِن جودِ كَفَّيه أَوَلٌ","فَصارَ لَهُم مِن جودِ كَفَّيك آخِرُ",116,"ر",1,0],["وكان لنا فيما روى عنك نشوةً","من السّكر ما يغني النديم عن الخمر",117,"ر",1,0],["وكان للحرمين الأشرفين على","براعة ترجمان القول والعمل",118,"ل",1,0],["وكان لقا الحبيب يزيد شوقاً","لرؤياه فكيف وغاب عنا",119,"ن",2,0],["وكانَ لي رَبٌّ صَلاتِي لَهُ","فانْقَسَمَتْ فيكُمْ لأَرْبابِ",120,"ب",1,0],["وكان لي الملك المنصور أعظم من","يعلي محلي ويدني مسرعا أملي",121,"ل",2,0],["وَكَانَ لَهَا الفِصْحُ الأَجَلُّ فأَصْبَحَتْ","لنارِكَ فِصْحاً مَا لَهَا بَعْدَهُ فِصْحُ",122,"ح",1,0],["وكان لها العينَ البصيرةَ إذ عَمُوا","فشكّوا على عَوصائها وتيقَّنا",123,"ن",2,0],["وكان لكُمْ من عِثار الزمانِ","لعاً يومَ يعثُر بالغافلينا",124,"ن",2,0],["وكان لسهمها ما شا","ء من قلبي وما احتكما",125,"م",2,0],["وكان لي عندَ حظّي قبلَ ودِّكمُ","ثأرٌ فقمتُ بكم كالسيف أثَّئِرُ",126,"ر",1,0],["وكان للأمريْن منه جُنَّةً","مسرودةً وصارماً مجرّدا",127,"د",2,0],["وكان لي حيثُ لا جفنٌ لناظرِهِ","حفظاً وصَوناً ولا تحمِي الظُّبا القُرُبُ",128,"ب",1,0],["وكان لي أملٌ في الغمض بعدهمُ","والغمض كالصبر بل كالغيد غدّار",129,"ر",1,0],["وكأنْ لم يَكُنْ هنا مَطَرٌ","دَمُهُ عِدْلَ بَرقِهِ يَلِفُ!",130,"ف",1,0],["وَكانَ لُجَينا فَكَم حُرقَةٍ","أَذابَت فُؤادِيَ مُذ أُحرِقا",131,"ق",2,0],["وكانَ لي في نطقِها راحةٌ","لو نطقتْ أرسُمها الهُمَّدُ",132,"د",1,0],["وكان لهُم أخٌ يدعو","إلى اللهِ وما لانا",133,"ن",2,0],["وكان لبيت الله في كل موسم","عويل على زواره ونحيب",134,"ب",1,0],["وكان لي من ملوك النيل قبلكم","مكانة عرفتها العرب والعجم",135,"م",1,0],["وكان لسانُ الحالِ منها مُخاطِبي","ألا عم صباحاً يا غريبُ وأَنعِما",136,"م",2,0],["وكان لساحات الجرائم طاوياً","صَفوحاً وساعات العثار مُقيلا",137,"ل",2,0],["وكأنّ لَمْعَ بروقِهِ هِنْدِيّةٌ","مسلولةٌ جُنْحَ الدُّجى لقِراعِ",138,"ع",1,0],["وكان لعينِي الصّباحَ المنير","فَقوموا اِنظُروا ليلِيَ الدّامسا",139,"س",2,0],["وَكانَ لَكم منّي جَميعي فَلَم يَزلْ","قبيحكُمُ حتَّى زوى عنكُمُ شطري",140,"ي",1,0],["وكان لي جَلَدٌ قبلَ الغرامِ به","فَالآن أفنَى اِصطباري وَجْدُهُ ومَحا",141,"ح",2,0],["وَكَأَنَّ لَيثَ الغابِ في إِقدامِهِ","يَوماً رَآكَ تُريدُهُ فَحَكاكا",142,"ك",2,0],["وكان لِذِي القرْنينِ عوناً على الذي","تبدَّى له وهُو الذي طلَب العَيْنا",143,"ن",2,0],["وكان لذات النَّفرِي مولِّهَا","يخاطبُ بالتَّوحيد صَيَّره خِدْنا",143,"ن",2,0],["وكانَ للنَّاسِ حَظٌّ من غِناهُ فقد","كانَ الغِنَى عندَهُ غُصناً لهُ ثَمَرُ",144,"ر",1,0],["وَكَأَنَّ لَمْعَ البَرْقِ مِنْ جَنَبَاتِهِ","كَفُّ الشُّجَاعِ تَهُزُّ مَتْنَ المُنْصُلِ",145,"ل",1,0],["وكان لما قام بالإمامة","عندكم يؤمه أسامة",146,"ه",1,0],["وكان لما أن رأى حمامه","قاربه دعا لهم أسامة",146,"ه",1,0],["وكان للناس به سمات","تشهد فيه أنها آيات",146,"ت",1,0],["وكان للحسن في ولايته","كبعض من يكون تحت رايته",146,"ه",1,0],["وكان لا يعلم بالتصحيح","قالوا له بمذهب صحي",146,"ي",1,0],["وكان لي عقد سرُورٍ فَقَدْ","نَثَرْت ذَاكَ العِقْد من سِلْكِهِ",147,"ك",2,0],["وكان لَو لَمْ يَدْعه","يُدَعّ كاليتيمِ",148,"م",1,0],["وكان للغيثِ يدٌ عِنْدهم","لأَنَّه مِنك لَهُم قَدْ أَجَارْ",149,"ر",1,0],["وكان لي جَنَّةَ النَّعِيمِ فَما","بَالِي رأَيْتُ النَّعِيمَ قَدْ نَفَدَا",150,"د",2,0],["وكان لِي والدٌ وكانَ بِه","عيشِي مِنْ بعد أَنْ غَدا رَغَدا",150,"د",2,0],["وكانَ لي في جوانح القلبِ إِذ","كنتُ له في فؤادِه الكَبِدا",150,"د",2,0],["وكان لنا جبلاً راسياً","جميل المراة كثير العشب",151,"ب",1,0]]}