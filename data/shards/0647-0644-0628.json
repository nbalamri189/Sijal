{"poems":[[63,"هل بالنقا عن سليمى مذ نأت خبر","https://www.aldiwan.net/poem45696.html","البسيط"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[93,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[93,"قالوا لنابليون ذات عشية","https://www.aldiwan.net/poem11345.html","الكامل"],[93,"هكذا هكذا نبوغ الرجال","https://www.aldiwan.net/poem11470.html","الخفيف"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[88,"للمسلمين على نزورة وفرهم","https://www.aldiwan.net/poem44431.html","الكامل"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[72,"هل بعد وجهك للرجاء نجاح","https://www.aldiwan.net/poem18487.html","الكامل"],[51,"هل بالديار سوى صداك مجيب","https://www.aldiwan.net/poem8320.html","الكامل"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42695","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54936","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54574","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[116,"لله في طي هذا الكون آيات","https://www.aldiwan.net/poem41202.html","عموديه"],[129,"بحر الفصاحة غاض يا إخواني","https://www.aldiwan.net/poem50494.html","الكامل"],[132,"هل بالحوادث والأيام من عجب","https://www.aldiwan.net/poem24174.html","البسيط"],[136,"شفيق مضى والدهر خانك يا مصر","https://www.aldiwan.net/poem49167.html","الطويل"],[144,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[158,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[226,"هل بالخيرات عام مشرق","https://www.aldiwan.net/poem55235.html","الرمل"],[230,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[271,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[271,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[272,"ما ضر وجد الهوى العذرى لوهانا","https://www.aldiwan.net/poem52061.html","البسيط"],[276,"أحسنوا العطف عليها مهجا","https://www.aldiwan.net/poem25608.html","الرمل"],[291,"نزح الرقيب وغارد اللاحي","https://www.aldiwan.net/poem11674.html","الكامل"],[321,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[365,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[365,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[365,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[367,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[369,"هل بالديار أن تجيب صمم","https://www.aldiwan.net/poem1879.html","السريع"],[372,"أترى بثار أم بدين","https://www.aldiwan.net/poem57099.html","مجزوء الكامل"],[397,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[410,"يا عجبا من وشك بين ما رغت","https://www.aldiwan.net/poem32182.html","الرجز"],[444,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[459,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[459,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[466,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[478,"أعيا العواذل ما عندي من الكلف","https://www.aldiwan.net/poem15214.html","البسيط"],[478,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[478,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[478,"دمع على عرصات الربيع مسكوب","https://www.aldiwan.net/poem15258.html","البسيط"],[478,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[500,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[501,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[516,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[568,"يا معرضا عني بوجه مدبر","https://www.aldiwan.net/poem69540.html","الكامل"]],"verses":[["هَل بِالنَّقا عَن سُلَيمَى مُذ نأَتْ خَبَرٌ","فَكُلُّ ذي صَبوَةٍ يَرتاحُ لِلخَبَرِ",0,"ر",1,1],["هَلْ بِلاَ وُلْدٍ يَعِزُّ بِهِمْ","مَنْ لَهُ وُلْدٌ بِلاَ حَسْبِ",1,"ب",1,0],["هَلْ بُغْيَةُ العُرْبِ إِلاَّ صَوْنُ غِزَّتِهِمْ","بِالاِئْتِلافِ وَإِلاَّ دَرْءُ عُدَوَانِ",2,"ن",1,0],["هَلْ بَعْثَةُ الدُّسْتُورِ إلاَّ وَحْيُهُ","مُتَنَزِّلاً كَتَنَزُّلِ الْفُرْقَانِ",3,"ن",1,0],["هَلْ بِعَالِي الذُّرَى مَكَانُ اعْتِصَامِ","بَعْدَ مَهْوَاكَ يَا رَفِيعَ المَقَامِ",4,"م",1,1],["هَلْ بَعْدَ فَتْحِ الأَرْضِ مِنْ أُمْنِيَةٍ","فَأَجَابَ أَنْظُرُ كَيْفَ أَفْتَتِحُ السَّمَا",5,"م",2,0],["هَلْ بَلَغْتَ الَّذِي تَمَنَّيْتَ إِلاَّ","بِالثَّبَاتِ العَجِيبِ فِي كُلِّ حَالِ",6,"ل",1,0],["هل بانُه من بعدنا متأوّدٌ","متجاوبٌ مترنم الأطيارِ",7,"ر",1,0],["هل بين شرط الواقفين وكل ما","نفع العموم تناقض وتنافي",8,"ف",2,0],["هَل بِالنَقيعَةِ ذاتِ السِدرِ مِن أَحَدٍ","أَو مَنبِتِ الشيحِ مِن رَوضاتِ أَعيارِ",9,"ر",1,0],["هل بعد وجهك للرجاءِ نجاح","أو بعدَ شخصك في الحياة صلاح",10,"ح",1,1],["هل بالديار سوى صَداكَ مُجيبُ","أم هل بهِنَّ على بُكاكَ مُثيبُ",11,"ب",1,1],["هَل بِكَ يا نَجمُ مِثلُ كَربي","أَم أَنتَ مِن طَبعِكَ السَهَر",12,"ر",1,0],["هَل بَينَهُنَّ جَوامِداً","فَرقٌ وَبَينَ المومِياتِ",13,"ت",1,0],["هلْ بعدَ يس وطه مدحةٌ","في الهاشميِّ وآلِهِ سفنِ النجا",14,"ج",2,0],["هَل بِالدَيارِ الغَداةَ مِن صَمَمِ","أَم هَل بِرَبعِ الأَنِيسِ مِن قِدَمِ",15,"م",1,1],["هَل بعين الشعرى الغميضاء لَيلاً","أَخبروني قذى من الأقذاء",16,"ا",2,0],["هَلْ بِالْحِمَى عَنْ سَريرِ الْمُلْكِ مَنْ يَزَعُ","هَيهَاتَ قَدْ ذَهَبَ الْمَتْبُوعُ وَالتَبَعُ",17,"ع",1,1],["هَلْ بُحَّ صَوَتُ فَخَارِنَا وَكَلامُهُ","فِي كُلِّ قَوْمٍ فَوْقَ كُلِّ كَلاَمِ",18,"م",1,0],["هَلْ بَيْنَ أَقْطَابِ الفَصَاحَةِ مِثْلُهُ","سَبَّاقُ غَايَاتٍ بِكُلِّ مَجَالِ",19,"ل",1,0],["هَلْ بِالكِنَانِة حَاجَةٌ لَمْ يَقْضِها","لِرُقِيِّهَا فِي مَخبَرٍ أَوْ مَظْهَرِ",20,"ر",1,0],["هَلْ بَينَ أَضْلاَعِكِ مِنْ خَافقٍ","تَحْتَ الَّتي تَخْفُقُ في الصَّدْرِ",21,"ر",1,1],["هَلْ بَعْدَ مَعْرِفَة الجُمُوعِ بِحَقِّهَا","يَرْتَاضُ سَاغِبُهَا لِغَيْرِ السَّاغِبِ",22,"ب",1,0],["هَلْ بَعْدَ رَائِعَةِ الأَهْرَامِ رَائِعَةٌ","فَمَنْ يَعِبْهَا لِبَعْضِ الشَّيْءِ فَلْيَعِبِ",23,"ب",1,0],["هل بين مؤتمرِ الأساةِ مجرِّبٌ","شافٍ لأدواءِ الصبابةِ ماحي",24,"ح",2,0],["هل بين مَنْ قهروا الصلي","بيين للصِّهْيَوْنِ قاهر؟",25,"ر",1,0],["هل بالدراهم يعلو عرق ذي سفل","عن قومه السود قد تحكى الحكايات",26,"ت",1,0],["هل بعدك الدنيا تطيب لهمْ وهم","كالرأسِ أحياءٌ بغيرِ لسانِ",27,"ن",1,0],["هَل بِالحَوادِثِ وَالأَيامِ مِن عَجَبِ","أَم بِاِبنِ جُدعانَ عَبدِ اللَهِ مِن كَلَبِ",28,"ب",1,1],["هل بَعد بُعدكَ يا شفيقَ يَروقُ","عيشٌ لصبّ قلبهُ محروقُ",29,"ق",1,0],["هَل بَعدَ فَتحِكَ ذا لِباغٍ مَطمَعُ","لِلَّهِ هَذا العَزمُ ماذا يَصنَعُ",30,"ع",1,1],["هَلْ بَيَّضَتْ يَدًا وَهَلْ","تَجْتَازُ أَمْ تَعَثَّرَتْ",31,"ت",1,0],["هَلَّ بِالخَيراتِ عامٌ مُشرِقٌ","أَصبَحَت أَنوارُه في مِصرَ كُبرى",32,"ر",2,1],["هل بعد طَيّ العُمْر إلا البِلَى","وهل وراءَ الشيب إلا البوَارْ",33,"ر",1,0],["هل بعد هذا البأسِ بأسٌ باذخٌ","أو بعد هذا العزِّ عزٌ قعسر",34,"ر",1,0],["هل بعد هذا نرجِّي منكَ صالحةً","لهم ونرقُبُ نجماً في سمائهم",35,"م",1,0],["هل بعد غزوتها ونكبةِ أهلِها","للمُسلمينَ سَلامةٌ وسلام",36,"م",1,0],["هل بعد ذلكَ نكبةٌ أو حطَّةٌ","أو فاقةٌ أو ذلِّةٌ أو ذام",36,"م",1,0],["هَل باكرته الغواديوَهي مثقلة","بالري تسقى الاراك الغض البانا",37,"ن",2,0],["هلْ بَكَى إلا بَكَيْنَا مَعَه","وَسَلَكنا في الأَسَى ما نَهَجا",38,"ج",2,0],["هل بعد أقمار بعاليةٍ","يهفو الفؤاد لوصل أشباح",39,"ح",1,0],["هَل بَينَ عُرقوبَ وَبَينَكَ نِسبَةٌ","حاشاكَ عَن زورٍ وَعَن بُهتانِ",40,"ن",1,0],["هل بعدَ إصباحِ لَيلِ الرّأسِ من عُذُرٍ","ألا أرَى هادياً للسُّبْلِ مُهْتَديا",41,"ي",2,0],["هل بعدَ هذا منتظَر","أم آن أن يُجنَى ثَمَر",42,"ر",1,0],["هل بعد قولِ رسولِ اللّهِ من رِيَبٍ","أم هل كصِدقِ رسول اللّه في خَبَر",43,"ر",1,0],["هل بعدَ حقٍ إذا صحَّتْ دلائلُه","إلاّ ضلالٌ فخُذْ إنْ شِئْتَ أو فَذَر",43,"ر",1,0],["هَل بِتَّ في لَيلِ هَوىً راكِدٍ","يَقظانَ وَالكَوكَبُ وَسنانُ",44,"ن",1,0],["هلْ بالدِّيارِ أنْ تُجِيبَ صَمَمْ","لو كانَ رَسْمٌ ناطِقاً كلَّمْ",45,"م",1,1],["هَل بعدَ بَينِكِ مَن يُعَر","رِفُني النُّضارَ من اللُّجَينِ",46,"ن",1,0],["هَل بالمنازِل إن كلّمتها خَرسُ","أم ما بيانُ أثاف بينَها قَبَسُ",47,"س",1,1],["هل بِزّنِي الخطبُ سِوى وفْرِي الذي","كان مُباحاً للنَّوالِ والنَّدَى",48,"د",2,0],["هل بيننا من يقول ذا وطني","بالروح أفديه ليس بالورق",49,"ق",1,0],["هل بعد مفترَق الأظعانِ مجتمَعُ","أم هل زمانٌ بهم قد فات يُرتَجَعُ",50,"ع",1,1],["هل بالديار على لومي ومعذرتي","عَدْوَى تقامُ على وجدي وتَذكاري",51,"ر",2,0],["هل بعده غير أن نبري أظافرنا","بري السكاكين إن ضاقت بنا الحيل؟!",52,"ل",1,0],["هل بعدَ أن بانَ أحبابي وبدَّلني","بُعدُ الحبائبِ ذاكَ القربَ بالشَّظَفِ",53,"ف",1,0],["هل بعدَ بينكِ مِن جوىً لمودَّعِ","ذهبَ اللقاءُ فهل له مِن مَرجِعِ",54,"ع",1,1],["هل بعدَ وصالِكَ مِن وَطَرِ","أم بعدَ فراقِكَ مِنْ حَذَرِ",55,"ر",1,1],["هل بعدَ بُعْدِكَ مِن شيءٍ أراعُ به","هذا وحبُّكَ قبلَ اليومِ محسوبُ",56,"ب",1,0],["هل بعدَ تَرحالِ المطيَّ عنِ الحِمى","صبرٌ على ألَمِ النوى وقرارُ",57,"ر",1,0],["هَلْ بَانَ قَلْبُكَ مِنْ سُلَيْمَى فَاشْتَفَى","ولَقَدْ غَنِيْتَ بِحُبِّهَا فِيْمَا مَضَى",58,"ا",1,1],["هل بانَ نُعمانٍ وهذا الأَجرَعُ","وهل خَميرُ حاجِرٍ ولَعْلَعُ",59,"ع",1,1],["هل بعد عبادان تعلم قرية","أو يرتجى ملك وأنت الأفضل",60,"ل",1,0],["هَلْ بَعْدَ حَالِكَ هَذِهِ مِنْ حَالَةٍ","أَوْ غَايَةٍ إِلاَّ انْحِطَاطُ المَنْزِلَهْ",61,"ل",2,0]]}