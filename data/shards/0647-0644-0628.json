 يوما لامرئٍ رحّالة","https://www.poetsgate.com/ViewPoem.aspx?id=164631",""],[5717,"لم تحي بامرء في سمع وفي بصر","https://www.poetsgate.com/ViewPoem.aspx?id=170587",""],[5725,"عيناك يابغداد تسكنني","https://www.poetsgate.com/ViewPoem.aspx?id=181642",""],[402,"عيد تجدد فيه مجد عدنان","https://www.poetsgate.com/ViewPoem.aspx?id=36469",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[402,"تلك المنارة في المكان العالي","https://www.poetsgate.com/ViewPoem.aspx?id=36215",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5943,"قاوم، جاهد، اِصبر، صابرْ","https://www.poetsgate.com/ViewPoem.aspx?id=45281",""],[5956,"النقود الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=184581",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6127,"يا ماشياً نحو الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=192767",""],[5309,"لو كان ينجح مصلح بلسانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573850",""],[6185,"يانفس !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87023&r=&rc=9",""],[572,"يا مُعرِضاً عنّي بوجهٍ مدبرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9432&r=&rc=289",""]],"verses":[["هَل بِالنَّقا عَن سُلَيمَى مُذ نأَتْ خَبَرٌ","فَكُلُّ ذي صَبوَةٍ يَرتاحُ لِلخَبَرِ",0,"ر",1,1],["هَلْ بِلاَ وُلْدٍ يَعِزُّ بِهِمْ","مَنْ لَهُ وُلْدٌ بِلاَ حَسْبِ",1,"ب",1,0],["هَلْ بُغْيَةُ العُرْبِ إِلاَّ صَوْنُ غِزَّتِهِمْ","بِالاِئْتِلافِ وَإِلاَّ دَرْءُ عُدَوَانِ",2,"ن",1,0],["هَلْ بَعْثَةُ الدُّسْتُورِ إلاَّ وَحْيُهُ","مُتَنَزِّلاً كَتَنَزُّلِ الْفُرْقَانِ",3,"ن",1,0],["هَلْ بِعَالِي الذُّرَى مَكَانُ اعْتِصَامِ","بَعْدَ مَهْوَاكَ يَا رَفِيعَ المَقَامِ",4,"م",1,1],["هَلْ بَعْدَ فَتْحِ الأَرْضِ مِنْ أُمْنِيَةٍ","فَأَجَابَ أَنْظُرُ كَيْفَ أَفْتَتِحُ السَّمَا",5,"م",2,0],["هَلْ بَلَغْتَ الَّذِي تَمَنَّيْتَ إِلاَّ","بِالثَّبَاتِ العَجِيبِ فِي كُلِّ حَالِ",6,"ل",1,0],["هل بانُه من بعدنا متأوّدٌ","متجاوبٌ مترنم الأطيارِ",7,"ر",1,0],["هل بين شرط الواقفين وكل ما","نفع العموم تناقض وتنافي",8,"ف",2,0],["هَل بِالنَقيعَةِ ذاتِ السِدرِ مِن أَحَدٍ","أَو مَنبِتِ الشيحِ مِن رَوضاتِ أَعيارِ",9,"ر",1,0],["هل بعد وجهك للرجاءِ نجاح","أو بعدَ شخصك في الحياة صلاح",10,"ح",1,1],["هل بالديار سوى صَداكَ مُجيبُ","أم هل بهِنَّ على بُكاكَ مُثيبُ",11,"ب",1,1],["هَل بِكَ يا نَجمُ مِثلُ كَربي","أَم أَنتَ مِن طَبعِكَ السَهَر",12,"ر",1,0],["هَل بَينَهُنَّ جَوامِداً","فَرقٌ وَبَينَ المومِياتِ",13,"ت",1,0],["هلْ بعدَ يس وطه مدحةٌ","في الهاشميِّ وآلِهِ سفنِ النجا",14,"ج",2,0],["هَل بِالدَيارِ الغَداةَ مِن صَمَمِ","أَم هَل بِرَبعِ الأَنِيسِ مِن قِدَمِ",15,"م",1,1],["هَل بعين الشعرى الغميضاء لَيلاً","أَخبروني قذى من الأقذاء",16,"ا",2,0],["هَلْ بِالْحِمَى عَنْ سَريرِ الْمُلْكِ مَنْ يَزَعُ","هَيهَاتَ قَدْ ذَهَبَ الْمَتْبُوعُ وَالتَبَعُ",17,"ع",1,1],["هَلْ بُحَّ صَوَتُ فَخَارِنَا وَكَلامُهُ","فِي كُلِّ قَوْمٍ فَوْقَ كُلِّ كَلاَمِ",18,"م",1,0],["هَلْ بَيْنَ أَقْطَابِ الفَصَاحَةِ مِثْلُهُ","سَبَّاقُ غَايَاتٍ بِكُلِّ مَجَالِ",19,"ل",1,0],["هَلْ بِالكِنَانِة حَاجَةٌ لَمْ يَقْضِها","لِرُقِيِّهَا فِي مَخبَرٍ أَوْ مَظْهَرِ",20,"ر",1,0],["هَلْ بَينَ أَضْلاَعِكِ مِنْ خَافقٍ","تَحْتَ الَّتي تَخْفُقُ في الصَّدْرِ",21,"ر",1,1],["هَلْ بَعْدَ مَعْرِفَة الجُمُوعِ بِحَقِّهَا","يَرْتَاضُ سَاغِبُهَا لِغَيْرِ السَّاغِبِ",22,"ب",1,0],["هَلْ بَعْدَ رَائِعَةِ الأَهْرَامِ رَائِعَةٌ","فَمَنْ يَعِبْهَا لِبَعْضِ الشَّيْءِ فَلْيَعِبِ",23,"ب",1,0],["هل بين مؤتمرِ الأساةِ مجرِّبٌ","شافٍ لأدواءِ الصبابةِ ماحي",24,"ح",2,0],["هل بين مَنْ قهروا الصلي","بيين للصِّهْيَوْنِ قاهر؟",25,"ر",1,0],["هل بالدراهم يعلو عرق ذي سفل","عن قومه السود قد تحكى الحكايات",26,"ت",1,0],["هل بعدك الدنيا تطيب لهمْ وهم","كالرأسِ أحياءٌ بغيرِ لسانِ",27,"ن",1,0],["هَل بِالحَوادِثِ وَالأَيامِ مِن عَجَبِ","أَم بِاِبنِ جُدعانَ عَبدِ اللَهِ مِن كَلَبِ",28,"ب",1,1],["هل بَعد بُعدكَ يا شفيقَ يَروقُ","عيشٌ لصبّ قلبهُ محروقُ",29,"ق",1,0],["هَل بَعدَ فَتحِكَ ذا لِباغٍ مَطمَعُ","لِلَّهِ هَذا العَزمُ ماذا يَصنَعُ",30,"ع",1,1],["هَلْ بَيَّضَتْ يَدًا وَهَلْ","تَجْتَازُ أَمْ تَعَثَّرَتْ",31,"ت",1,0],["هَلَّ بِالخَيراتِ عامٌ مُشرِقٌ","أَصبَحَت أَنوارُه في مِصرَ كُبرى",32,"ر",2,1],["هل بعد طَيّ العُمْر إلا البِلَى","وهل وراءَ الشيب إلا البوَارْ",33,"ر",1,0],["هل بعد هذا البأسِ بأسٌ باذخٌ","أو بعد هذا العزِّ عزٌ قعسر",34,"ر",1,0],["هل بعد هذا نرجِّي منكَ صالحةً","لهم ونرقُبُ نجماً في سمائهم",35,"م",1,0],["هل بعد غزوتها ونكبةِ أهلِها","للمُسلمينَ سَلامةٌ وسلام",36,"م",1,0],["هل بعد ذلكَ نكبةٌ أو حطَّةٌ","أو فاقةٌ أو ذلِّةٌ أو ذام",36,"م",1,0],["هَل باكرته الغواديوَهي مثقلة","بالري تسقى الاراك الغض البانا",37,"ن",2,0],["هلْ بَكَى إلا بَكَيْنَا مَعَه","وَسَلَكنا في الأَسَى ما نَهَجا",38,"ج",2,0],["هل بعد أقمار بعاليةٍ","يهفو الفؤاد لوصل أشباح",39,"ح",1,0],["هَل بَينَ عُرقوبَ وَبَينَكَ نِسبَةٌ","حاشاكَ عَن زورٍ وَعَن بُهتانِ",40,"ن",1,0],["هل بعدَ إصباحِ لَيلِ الرّأسِ من عُذُرٍ","ألا أرَى هادياً للسُّبْلِ مُهْتَديا",41,"ي",2,0],["هل بعدَ هذا منتظَر","أم آن أن يُجنَى ثَمَر",42,"ر",1,0],["هل بعد قولِ رسولِ اللّهِ من رِيَبٍ","أم هل كصِدقِ رسول اللّه في خَبَر",43,"ر",1,0],["هل بعدَ حقٍ إذا صحَّتْ دلائلُه","إلاّ ضلالٌ فخُذْ إنْ شِئْتَ أو فَذَر",43,"ر",1,0],["هَل بِتَّ في لَيلِ هَوىً راكِدٍ","يَقظانَ وَالكَوكَبُ وَسنانُ",44,"ن",1,0],["هلْ بالدِّيارِ أنْ تُجِيبَ صَمَمْ","لو كانَ رَسْمٌ ناطِقاً كلَّمْ",45,"م",1,1],["هَل بعدَ بَينِكِ مَن يُعَر","رِفُني النُّضارَ من اللُّجَينِ",46,"ن",1,0],["هَل بالمنازِل إن كلّمتها خَرسُ","أم ما بيانُ أثاف بينَها قَبَسُ",47,"س",1,1],["هل بِزّنِي الخطبُ سِوى وفْرِي الذي","كان مُباحاً للنَّوالِ والنَّدَى",48,"د",2,0],["هل بيننا من يقول ذا وطني","بالروح أفديه ليس بالورق",49,"ق",1,0],["هل بعد مفترَق الأظعانِ مجتمَعُ","أم هل زمانٌ بهم قد فات يُرتَجَعُ",50,"ع",1,1],["هل بالديار على لومي ومعذرتي","عَدْوَى تقامُ على وجدي وتَذكاري",51,"ر",2,0],["هل بعده غير أن نبري أظافرنا","بري السكاكين إن ضاقت بنا الحيل؟!",52,"ل",1,0],["هل بعدَ أن بانَ أحبابي وبدَّلني","بُعدُ الحبائبِ ذاكَ القربَ بالشَّظَفِ",53,"ف",1,0],["هل بعدَ بينكِ مِن جوىً لمودَّعِ","ذهبَ اللقاءُ فهل له مِن مَرجِعِ",54,"ع",1,1],["هل بعدَ وصالِكَ مِن وَطَرِ","أم بعدَ فراقِكَ مِنْ حَذَرِ",55,"ر",1,1],["هل بعدَ 