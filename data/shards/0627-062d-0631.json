"من أين يستنفع الفتى بفتى","https://www.aldiwan.net/poem59856.html","المنسرح"],[479,"تذكرت من أهوى وما كنت ناسيا","https://www.aldiwan.net/poem37062.html","الطويل"],[500,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[500,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[514,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[515,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[515,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[515,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[538,"قد سمعت الرثاء نظما ونثرا","https://www.aldiwan.net/poem48193.html","عموديه"],[553,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[558,"أحرف في سكونها الإعدام","https://www.aldiwan.net/poem33863.html","الخفيف"],[559,"هل لكم في شرب صهبا مزجت","https://www.aldiwan.net/poem69360.html","الرمل"],[562,"العلم فوق المال في إرشاده","https://www.aldiwan.net/poem52802.html","الكامل"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"]],"verses":[["أَحرَجتَني فَهاكَها","بِنتَ عِناقٍ وَالرَقَم",0,"م",1,0],["أَحرَزتُها مُتَوَغِّلاً غاياتِها","وَالمَجدُ مَلءُ يَدِ الَّذي يَتَوَغَّلُ",1,"ل",1,0],["أَحرَزتَها دونَ الأَنامِ وَإِنَّما","خَلَعَ العَجاجَةَ سابِقٌ لَم يَذهَلِ",2,"ل",1,0],["أُحرِزُ المالَ لِلعَطا","ءِ بِجَرِّ الفَيالِقِ",3,"ق",1,0],["أحْرَزَتْ أجْرَ شهيدٍ","نالَهُ الطّعْنُ وناشَهْ",4,"ش",2,0],["أَحرَقوا الدورَ اِستَحَلّوا كُلَّ ما","حَرَّمَت لاهايُ في العَهدِ اِحتِراما",5,"م",2,0],["أَحرَجَ الغَيبَ إِلى أَن بَزَّهُ","سِرَّهُ بَزّاً وَلَم يَخشَ اِنتِقاما",6,"م",2,0],["أَحرَجوا صَدرَ أُمِّهِ فَأَراهُم","بَعضَ ما أَضمَرَت مِنَ البُرَحاءِ",7,"ا",2,0],["احرزت فالأرض شهرا","به تشرّف الأعصار",8,"ر",1,0],["أحرّيتي إني اتخذتكِ قِبلةً","أوجّه وجهي كل يوم لها عشرا",9,"ر",2,0],["احرزتَ فضل النضال في مَهَل","فكل يوم بكفك القَصَبُ",10,"ب",1,0],["أحرزت من عَشرها تسعاً وواحدة","فلا العمى لك من رامٍ ولا شللُ",11,"ل",1,0],["أَحرُفٌ أَربَعٌ بِها هامَ قَلبي","وَتَلاشَت بِها هُمومي وَفِكري",12,"ر",2,1],["أحَرْبُنا حين أسَغْتَ الشَّجا","وحِزْبُنا إذ ضافَك الحازبُ",13,"ب",1,0],["أحرجْتُهُ فهجاني غيرَ منتصرٍ","لا سابقٌ من مجاراتي ولا ثان",14,"ن",1,0],["أَحرَزتَ سرو السَجايا ثُمَّ قارَنهُ","ظَرفَ اللِسان اِقتِرانَ الكأس بِالوَتَرِ",15,"ر",1,0],["احرصي يا حياة ان لا تموتي","فلك الكارثات بالمرصاد",16,"د",1,0],["أحررها تذاكر ليس تحُصى","وما من ذاك شئ في يديا",17,"ي",2,0],["أَحرامٌ عَلى بَلابِلِهِ الدَو","حُ حَلالٌ لِلطَيرِ مِن كُلِّ جِنسِ",18,"س",1,0],["أَحرَزَ الغايَةَ نَصراً غالِياً","لِفَرَنسا وَحَوى الفَتحَ الثَمين",19,"ن",1,0],["أحرقنها بالنا حتى عودت","مما طيور الجو من أطراقها",20,"ق",3,0],["إحراقنا البالغ في أول ال","تكليس روح ثابت لا يطير",21,"ر",1,1],["أَحرَزتَ ميراثَ الرَسو","لِ بِسُهمَةِ العَبّاسِ جَدِّك",22,"ك",1,0],["أَحَرامٌ أَن يُنجَزَ المَوعودُ","مِنكِ أَو يَقرُبَ النَوالُ البَعيدُ",23,"د",1,1],["أَحرى الخُطوبِ بَأَن يَكونَ عَظيماً","قَولُ الجَهولِ أَلا تَكونُ حَليما",24,"م",2,1],["أَحرى العُيونِ بِأَن تَدمى مَدامِعُها","عَينٌ بَكَت شَجوَها مِن مَنظَرٍ حَسَنِ",25,"ن",1,0],["أحرزَ ما رُمناه من آرامِه","فما رُزِقْناه فَمِنْ إنعامِه",26,"م",2,0],["أَحُرِمْتَ نَشرَ العَنبرِ ال","وَردِ الذي منه انْتَشر",27,"ر",1,0],["أحرقتها ورميت قل","بي في صميم ضرامها",28,"م",3,0],["أحرَقْتُ فضلَةَ مِسْوَاكٍ لها حَسَداً","له على لثم دُرٍّ في اللمى يَقَقِ",29,"ق",1,1],["أَحرَزتُ مِن جَدواكَ أَكثَرَ مُحرَزٍ","في ظاهِرٍ وَأَقَلَّهُ في حاصِلِ",30,"ل",1,0],["أَحرَمتُ دونَكَ خَوفَ النائِباتِ فَما","شَكَكتُ إِذ قُمتَ دوني أَنَّكَ الحَرَمُ",31,"م",1,0],["أَحرَزَ آباؤُهُ الفَصيلَةَ مُذ","تَفَرَّسَت في عُروقِها الفُرسُ",32,"س",1,0],["أَحرَزتَ خَصلَيهِ إِلَيكَ وَأَقبَلَت","آراءُ قَومٍ خَلفَ رَأيِكَ تُجنَبُ",33,"ب",1,0],["احرصْ على إخمالِ ذكرِكَ في غنى","وتملَّ بالأورادِ والأذكارِ",34,"ر",1,0],["أَحَرُّ الوَغَى أن يَطْرُقَ الحيَّ طارِقٌ","ويَربَعَ من شَوقٍ على الدّارِ رابعُ",35,"ع",1,0],["أَحَرُّ الجَوى ما جاوَزَ القَلبَ فَاِرتَقى","وَأَصفى الهَوى ما ذابَ في العَينِ فَاِنهَمى",36,"م",2,0],["احرسوا الخندقَ وَارْمُوا دُونه","لا تخافوا كلَّ غاوٍ مُجرِمِ",37,"م",1,0],["أحرارنَا قد كشفتم عن بطولتكم","غظاءَ ها يوم توقيع الكفالاتِ",38,"ت",1,1],["أَحرَقَنا أَيلولُ في نارِهِ","فَرَحمَةُ اللَهِ عَلى آبِ",39,"ب",1,1],["أُحَرِّكُهُ إِذا قاموا","وَأَلمِسُهُ إِذا قَعَدوا",40,"د",3,0],["أَحرَمتُ رَيحانَ بُستانٍ وَناضِرَهُ","حَتّى أَشُمَّكِ يا رَيحانَةَ البَلَدِ",41,"د",1,0],["أحرارُ مملكةٍ أَرْسَوْا دعائمها","على أساسٍ من الشُّورى وأركانِ",42,"ن",1,0],["أحرارُ مملكة في الرأي ما أثموا","سمَّاهمو الغاصبُ الظَّلَّام ثُوّارا",43,"ر",2,0],["أحرقتهنَّ آهِ لم يَبْقَ منهنْ","نَ سوى ذلك الرَّماد برأسي",44,"ي",1,0],["أحرارُ دهر همو المستيقظون لها","ومن غفوا فهمو الموتى الأرقَّاءُ",45,"ا",2,0],["أحرزها الوالدان خوفاً","والقبر حرز لها حريز",46,"ز",1,0],["أحراس تخم وحماة حدّ","وحاطة الأطراف من تعدّ",47,"د",1,0],["أَحرَقَتني نارُ الجَوى وَالبُعادِ","بَعدَ فَقدِ الأَوطانِ وَالأَولادِ",48,"د",1,1],["أُحرَمُ مِنكُم بِما أَقولُ وَقَد","نالَ بِهِ العاشِقونُ مَن عَشِقوا",49,"ق",3,0],["أَحْرَى بمَنْ وَهَبَ الْحَياةَ لِقَوْمِهِ","أَلاَّ تُمَسَّ حَياتُهُ بزَوَال",50,"ل",1,0],["أحرقت من خلفي جميع مراكبي","إن الهوى ألا يكون إياب",51,"ب",1,0],["أحرزْتَ في نجران نصرًا باهرًا","وغدًا سَتُتْبعُه بنصر باهر",52,"ر",1,0],["أحرى الورى بالهم والدةٌ","تلقى العقوقَ من ابنها البَر!",53,"ر",1,0],["أحرار مملكة في الرأي ما أثموا","سمّاهمو الغاصب الظّلاّما ثوّارا",54,"ر",2,0],["أحرار دهر همو المستيقظون لها","ومن عفوا فهمو الموتى الأرقاء",55,"ا",2,0],["أحرف يستمطرُ الكونُ بها","إنعتاقاً وازدهاراً وإخاء",56,"ا",2,0],["أحرزتَ مجداً ليس ينفدَ ذكرهُ","طولَ المدى وبذلتَ كنزاً نافِدا",57,"د",2,0],["احرقت جسما كله لوعة","فتكت في اجزائه فاكتفي",58,"ي",1,0],["أحرقتْهم حرارة الحقد في الصدْ","رِ فصاروا بحقدهم كالرماد",59,"د",1,0],["أَحرَّرتُمونا لِتَستَعبِدوا","أيسترهِنُ العبدَ من أعتَقه",60,"ق",2,0],["أَحرَزتَهُ بِالنَدى لَم تُبقِ ذا عَدَمٍ","وَبِالحُروبِ الَّتي أَلوَت بِمَن عَنَدا",61,"د",2,0],["أَحرَزتَ ما أَعيا المُلوكُ مُصابِراً","غَيرَ الحَوادِثِ وَاِحتِمالَ المَغرَمِ",62,"م",1,0],["أَحرَقَهُ اللَهُ بِنِصفِ اِسمِهِ","وَصَيَّرَ الباقي صُراخاً عَلَيه",63,"ي",2,0],["أُحرِزُ الشَّأو فِي نِظامٍ وَنَثرٍ","ثُمَّ أَثنِي وفي العِنَانِ جِماحُ",64,"ح",1,0],["أَحَرَّها الوقّاد حتى غدا","من أجلها للروح مثل الشقيق",65,"ق",1,0],["أحرّم ما يصحّ به مزاجي","وينفي الهمّ عن قلب مهان",66,"ن",1,0],["أَحرَقت شُهبُهم عتاةَ قريشٍ","وَلهيبُ الحريقِ تلك الدماءُ",67,"ا",2,0],["أُحَرِّجُ مالي يا جُوَينَ بنَ مَعبَدٍ","عَلَيكَ بِذاتِ اللَهِ إِن كُنتَ مُسلِما",68,"م",2,0],["أحرامٌ يا نفسُ أم أحفظَ الودَّ","إذا ما أضاعهُ من هويتِ",69,"ت",1,0],["أحرق القلب شواظٌ من نواك","بالهوى قل لي متى يوم اللقاء",70,"ا",2,0],["أحرامٌ قتل روحي أم حلال","إنني أعشقُ ذيّاك الضلال",71,"ل",1,0],["أَحرَزتَ يا عبّاسِ كلَّ فضيلَةٍ","وَبَلغتَ شَأواً في العُلا لا يُحلَقُ",72,"ق",1,0],["أحرَّ من وَقفْة الودَاع ومِن","دمعٍ تقاضتْه روَعة البَينْ",73,"ن",1,0],["أحرزت غاية كل مجد كامل","وزكت أصول الفضل فيك وأثمرت",74,"ت",1,0],["أَحْرُفٌ أَرْبَعٌ ذَهَبْنَ بِضُرِّي","وَحَسَمْنَ أَمْدَادَ مُوقِدِ جَمْرِ",75,"ر",1,1],["أَحْرُفٌ أرْبَعٌ شَفَتْ دَاءَ صَدْرِي","وَأَنَارَتْ بِإِذْنِ رَبِّيَ فِكْرِي",76,"ي",1,1],["أحرامٌ لو زُرتَ في طلب الأج","رب حبيباً مصافياً أو بَغيضاً",77,"ض",2,0],["أحرق جثامين البغاة ورجسها","وأنثر على أشلائهم (بترولا)",78,"ل",2,0],["أحراحهم بيض العنا","فق واللحى سود المباعر",79,"ر",1,0],["أحرز السرّ منك نظرة عطفٍ","من عيونٍ لغادة الأنس دُعج",80,"ج",1,0],["أحْرَزَ السؤْدَدَ عَنْ آبائِهِ","واقْتَفَاهُم أكْبَراً فَأكْبَرا",81,"ر",2,0],["احرقتها لإثمها ألسُنُ الناس","ومن في الأنام يقبَلُ عذرا",82,"ر",2,0],["اِحرص على سُرورهم","بالبَسطِ في حضورِهم",83,"م",1,0],["أَحرزَ السهمَ المُعَلّى إِذ دَنا","قابَ قَوسين ولم يُقرع سِهاما",84,"م",2,0],["احرص على سبق المدى في العلا","واجهد على أن ترتقى غايته",85,"ه",1,1],["أُحُرِس الأقربين يحرسُك اللَّ","هُ رواعِ الأهلينَ والأبناءَ",86,"ا",2,0],["أحرقوه فليس أخطر منه","ودعوا الشمس كي تسد فراغه",87,"ه",1,0],["أَحرَمت تَسعى بِالتَعفُّف وَالتُقى","لا زِلت مُكتَسِياً تُقىً وَتَعفُّفا",88,"ف",2,0],["أَحَرْفُ مِراةٍ من خلالِ غِشائها","بَدا أَم هلالٌ لاحَ لل