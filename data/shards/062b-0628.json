oem60940.html","البسيط"],[367,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[404,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[410,"ذكر الوفاء خيالك المنتاب","https://www.aldiwan.net/poem32619.html","الكامل"],[411,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[417,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[433,"دعته المثاني وادعته المثالث","https://www.aldiwan.net/poem12374.html","الطويل"],[438,"أفنيت صبري في الهوى وتجلدي","https://www.aldiwan.net/poem2581.html","الكامل"],[438,"حيا بكاس السرى سا في الأغاريد","https://www.aldiwan.net/poem2596.html","البسيط"],[440,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[462,"ظل الأسنة لا جيران بغداد","https://www.aldiwan.net/poem15126.html","البسيط"],[462,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[462,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[462,"طرب الزمان وأنجمت أشجانه","https://www.aldiwan.net/poem15145.html","الكامل"],[462,"مشمر للهول غير زمل","https://www.aldiwan.net/poem15400.html","الرجز"],[462,"تخشى الصوارم بأسه","https://www.aldiwan.net/poem16138.html","مجزوء الكامل"],[462,"غنمتها والكريم غنام","https://www.aldiwan.net/poem16267.html","المنسرح"],[462,"ثبت الحبى لا يستفز أناته","https://www.aldiwan.net/poem16361.html","الكامل"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[465,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[480,"دع الأيام تخطي أو تصيب","https://www.aldiwan.net/poem37044.html","الوافر"],[501,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[501,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[506,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[516,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[539,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[541,"ثبت إذا كان الخطيب كأنه","https://www.aldiwan.net/poem56793.html","الكامل"],[552,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[559,"ثمرات على غصون الحوادث","https://www.aldiwan.net/poem33556.html","الخفيف"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[563,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[576,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"]],"verses":[["ثَبتٌ لِهَجهَجَةِ الخُطوبِ كَأَنَّما","جاءَت تُقَعقِعُ بِالشِنانِ لِيَذبُلِ",0,"ل",1,0],["ثَبَّتَّ فيها وِطاءَهُ وَوَراءَهُ","جَزَعٌ يُقَلقِلُ مِن قُلوبِ الجَندَلِ",0,"ل",1,0],["ثَبْت الْجَنَانِ إِذَا الْخُطُوبُ تَعَاظَمَتْ","مُتَبَسِّمٌ فِي الْحَادِثِ الْمُتَجَهِّمَ",1,"م",1,0],["ثَبتٍ إِذا قيلَ لَهُ يُعاطي","أَخرَجَ حُضراً غَيرَ ذي نِياطِ",2,"ط",1,0],["ثَبِّت فُؤادَكَ يا قَليلَ تَصَبُّري","وَاِشرَح لِآلِ أَباظَةٍ بُرَحائي",3,"ا",2,0],["ثَبتُ الجَنانِ لَهُ حلمٌ يُوَقِّرُهُ","إِن خامَرَ الطَيشُ رُكني يَذبُلٍ وِحرا",4,"ر",2,0],["ثَبتُ الجَنانِ لَهُ حُلمٌ يَوَقِّرُهُ","إِذا هَفا بِحَلومِ السادَةِ الغَضَبُ",5,"ب",1,0],["ثَبتُ الجَنانِ إِذا الجِبالُ تَزَعزَعَت","حامي الحَقيقَةِ حامِلٌ ما أَتعَبا",6,"ب",2,0],["ثَبتُ الجنانِ تُراعُ مِن وَثَباتِهِ","يَومَ الوَغى وَثَباته أُسدُ الشَرى",7,"ر",2,0],["ثَبتُ السَكينَةِ في النَدِيِّ كَأَنَّما","تِلكَ الحُبا ليثَت بِهَضبِ مَتالِعِ",8,"ع",1,0],["ثَبْتٌ عَلَى كُلِّ حَالٍ فِي مَبَادِئِهِ","سِيَّانَ مِنْهَا لَدَيْهِ اليُسْرُ وَالْعُدُمُ",9,"م",1,0],["ثُبتُ الحُلومِ فَإِن سُلَّت حَفائِظُهُم","سَلّوا السُيوفَ فَأَردَوا كُلَّ ذي عَنَتِ",10,"ت",1,0],["ثَبجاءَ مُجفَرَةٍ سَطعاءَ مُفَرَّعَةٍ","في خَلفِها مِن وَراءِ الرَحلِ تَنضيدُ",11,"د",1,0],["ثبّتّ عزمك في أمر يذلّ به","عزم الحصيف لما يحوي من الزلق",12,"ق",1,0],["ثبتٌ تمرّ عليه أقوالُ العدى","مرّ الرّياح على الأشم الراسي",13,"س",2,0],["ثبت الجوانب والدنيا مزلزلةٌ","وصائل الرأي والقرضاب لم يصل",14,"ل",1,0],["ثبتتْ لكم أعراقُكُمْ","حتى ثويتم في المعاركْ",15,"ك",1,0],["ثبَّتَ اللَّهُ دولةً لك أضْحت","كلُّ بلوى بَعدلها معدولهْ",16,"ل",2,0],["ثَبَتَ الجِنانِ قَوِيُّهُ عَفَّ الإِزا","رِ نَقِيُّهُ ما خانَ قَطُّ خَليلا",17,"ل",2,0],["ثَبجاءَ دَفواءَ مَبنيٍّ مَرافِقُها","عَلى حَصيرَينِ في دَفَّيهِما جُدَدُ",18,"د",1,0],["ثبتوا عند عبرهم لتقاهم","في متون الأكباش كالأوتاد",19,"د",1,0],["ثبتوا على عهد البلاد بموقف","ناب الثبات به عن الأجناد",20,"د",1,0],["ثبتت أواسى العرش في محرابه","وأوت إليه أمة وديار",21,"ر",1,0],["ثِب إِلىالنَجمِ وَزاحِم رُكنَهُ","وَاِمتَلِئ مِن خُيَلاءٍ وَمِراح",22,"ح",1,0],["ثَبَتَّ مُؤَمِّلاً مِنكَ الثَباتُ","تُوافيكَ الرَسائِلُ وَالسُعاةُ",23,"ا",2,0],["ثَبْتٌ إذا قَدَمَا سِوا","هُ في المَهَاوِي زَلّتَا",24,"ت",2,0],["ثَبْتُ الجَنانِ فإنْ تلسَّنَ بارِقٌ","بذراكَ مادَ بشجوهِ متململا",25,"ل",2,0],["ثَبتُ العَزيمَةِ مُصمَتُ الأَحشاءِ في","أَهوالِ ذاكَ العارِضِ المُتَكَشِّفِ",26,"ف",1,0],["ثَبتِ الأَناةِ إِذا اِستَبَدَّ بِرَأيِهِ","وَفّاكَ حَقّا النَقضِ وَالإِبرامِ",27,"م",1,0],["ثَبَتَت تَحتَ الحَشا آخِيَةٌ","مِنهُ لا يَنزِعُها المُهرُ الأَرِنّ",28,"ن",1,0],["ثَبَّتَ اللَهُ وَطأَةً لَكَ أَمسَت","جَبَلاً راسِياً عَلى المُشرِكينا",29,"ن",2,0],["ثَبَتوا إلى أجدارِها فكأنَّهم","والطَّعْنُ يَقتَلِعُ الكُماةَ جدارُها",30,"ر",3,0],["ثَبُتَت مَغارِسُ حُبِّكُم في خاطِري","فَهُوَ القَديمُ وَكُلُّ حُبٍّ مُحدَثُ",31,"ث",1,0],["ثَبتُ الجَنانِ يَكادُ يُبعَثُ مُرسَلاً","لَو أَنَّ بَعدَ مُحَمَّدٍ مَن يُبعَثُ",31,"ث",1,0],["ثِب لِلعُلى وَاِستَخدِمِ الدَهرَ الَّذي","إِن تَدعُهُ لِمُلِمَّةٍ لا يَلبَثُ",31,"ث",1,0],["ثُبنا إِلَيكَ عَلى هِجانٍ ضُمَّرٍ","شِبهِ القِسِيِّ إِلى حِماكَ تُحَثَّتُ",31,"ث",2,0],["ثَبُتَت وَلَو حَلَفَت بِأَنَّكَ ناعِشٌ","بِنَوالِكَ الأَرواحَ لَم تَكُ تَحنَثُ",31,"ث",1,0],["ثُب إِلى اللَذّاتِ فَالعُمرُ قَصيرُ","وَحَياةُ المَرءِ في الدُنيا غُرورُ",32,"ر",1,1],["ثَبتُ الجَنانِ مَريرُ الرَأيِ صائِبُهُ","إِذا تَقاعَسَ صَرفُ الدَهرِ أَو جَمَحا",33,"ح",2,0],["ثبوتٌ إذا ما أقْبَلَ الموتُ فاغراً","يُرَدّد في الأسْماعِ جرْجرَةَ القَرْمِ",34,"م",1,0],["ثبتَتْ رصانةُ حِلْمِهِ فكأنّما","أرساهُ خالقُهُ بِهَضْبَةِ يَذْبُلِ",35,"ل",1,0],["ثبتتْ قواعدُ مُلْكِهِ فكأنّما","أرساهُ ربّ العرشِ بالأطوادِ",36,"د",1,0],["ثَبتُ المَقامِ يَرى القَبيلَةَ واحِداً","وَيُرى فَيَحسَبُهُ القَبيلُ قَبيلا",37,"ل",2,0],["ثَبتُ البَيانِ إِذا تَحَيَّرَ قائِلٌ","أَضحى شِكالاً لِلِّسانِ المُطلَقِ",38,"ق",1,0],["ثَبتُ الجَنانِ إِذا اِصطَكَّت بِمُظلِمَةٍ","في رَحلِهِ أَلسُنُ الأَقوامِ وَالرُكَبُ",39,"ب",1,0],["ثبِّتْ على الإسلامِ قلبي واهدني","للحقِّ وانصرني على الشيطانِ",40,"ن",1,0],["ثبِّتْ على الحقِّ المبينِ قُلوبَنا","في المتّقينَ وزلزلِ الفُجّارا",41,"ر",2,0],["ثَبَتوا بِمُعتركِ الحُتوفِ مَعاقِلاً","ورَسَوْا بِمُصطَدَمِ الصُّفوفِ جبالا",42,"ل",2,0],["ثُبتُ مِنها وَالبَدرُ يُسفِرُ في الأُف","قِ حَسوداً وَالنَجمُ يَهفو غَيورا",43,"ر",2,0],["ثِب مِن طِمارٍ إِذا لَم تَستَطِع سَرَباً","وَثِب شَبيهَ التَميمِيِّ الَّذي طَمَرا",44,"ر",2,0],["ثَبَتَا في قَميصِهِ ليَجيءَ الحَشْ","رَ مُسْتَعْدِياً إلى الرّحْمنِ",45,"ن",1,0],["ثَبَتَت وَكانَ ثَباتُها","يَدعو إِلى العَجَبِ العُجاب",46,"ب",1,0],["ثَبَتَت لِأَنَّ لَها إِلى","أَعتابِ مَولانا اِنتِساب",46,"ب",1,0],["ثَبتُ الطِعانِ إِذا الكُماةُ أَذَلَّها","عَرَقُ المُتونِ يَجُلنَ بِالأَلبادِ",47,"د",1,0],["ثبِّتْ لعبدِ اللَّهِ حُسنَ نيَّته","واعطفه بالفضل على رعيَّته",48,"ه",1,0],["ثَبَتَتْ فِيهِ خَالِدَاتُ المَعَانِي","وَانْتَفَى مَا أَعَارَهُنَّ الرَّغَامُ",49,"م",1,0],["ثَبْتاً إِذَا مَا الرَّاسِخونَ تَقَلْقَلُوا","مُتَوَافِقَ الإِعْلاَنِ وَالإِسْرَارِ",50,"ر",1,0],["ثَبَاتِي مِنَ السُّقْمِ المُقِيمِ أَفَدْتُهُ","وَصَبْرِيَ مَمَّا أَكْسَبَتْنِي المَتَاعِبُ",51,"ب",1,0],["ثَبْتاّ وَعَزْمُكَ مُسْتَزِيدٌ قُوَّةً","مِنْ طارِىءِ الإِدْبَارِ لِلإقْبَالِ",52,"ل",1,0],["ثَبْتُ الفُؤَادِ لأَبْعَدِ","الْغَايَاتِ طَلاَّبٌ فَمُدْرِكْ",53,"ك",1,0],["ثبوتاً عَلى العَهدِ الَّذي كانَ بَينَنا","إِذا غَيَّرَ الأَحبابَ صَرفُ الحَوادِثِ",54,"ث",1,0],["ثَبَتَت حباهُ فَدونَهُنَّ يلملمٌ","وَسَمَت علاهُ فَدونَها البِرجيسُ",55,"س",1,0],["ثَبَّتُّ في النائِباتِ قَلبي","حَتّى طَوَت مَن بِهِ اِشتِباثي",56,"ث",2,0],["ثَبَّطكَ اللَهُ لَستَ تُبقي","عَلى بُزاةٍ وَلا بُغاثِ",56,"ث",1,0],["ثَبَتَا لِحُكْمِ اللّه جَلَّ جَلاَلهُ","والْخطْبُ يَلْقَاه الكِرَامُ كِرَاما",57,"م",2,0],["ثباتاً يا دِمَشقُ على الرزايا","وتوطيناً وإن ضاق الخناق",58,"ق",1,0],["ثبت وحسب المرء فخراً ثباته","\" كما ثبتت في الراحتين الأصابع \"",59,"ع",1,0],["ثَبْتِ الأنَاةِ، إذا اسْتَبَدّ برَأيِهِ","وَفّاكَ حَقَّ النّقْضِ والإبْرَامِ",60,"م",1,0],["ثبتٌ إذا زُلزلت الأقدام","ُ بحجة اللَّه له رِجَامُ",61,"م",1,0],["ثبّت عزمك في أمر يذِلّ به","عزم الحصيف لما يحوي من الزاق",62,"ق",1,0],["ثبت عليه حين زل رجاحةً","أيخرج عن أثناء هالته البَدرُ",63,"ر",1,0],["ثبتَ اللهُ ملككم وارتضاكم","واصطفاكم على جميعِ العبادِ",64,"د",1,0],["ثَبْتُ الجَنانِ كأنّما في بُرده","يومَ الزعازع يذبُلٌ ويلَملَمُ",65,"م",1,0],["ثَبَتَّ ثَباتاً لَم يَكُن لِابنِ مُسلِمٍ","وَأوتيتَ صَبراً لَم يَنَلهُ المُهَلَّبُ",66,"ب",1,0],["ثَبَتَت بِأَفئِدَةِ العِدى لَكَ هَيبَةٌ","سَتَزولُ مِن إِلبابِها أَلبابُها",67,"ب",3,0],["ثَبتُ الجَنانِ بِحَيثُ الصَبرُ يُلجِئُهُ","إِلى مَوارِدَ يَحلو عِندَها الصَبِرُ",68,"ر",1,0],["ثَبَتَّ فَلَمّا أَوضَحَ الرَأيُ نَهجَهُ","طَفَوتَ عَلى البَحرِ المُحيطِ وَقَد طَما",69,"م",2,0],["ثَبَّتَّ وَطأَةَ دينِ اللَهِ مُعتَصِماً","بِاللَهِ مِن بَعدِ ما زَلَّت بِهِ القَدَمُ",70,"م",1,0],["ثَباتي عَلَى هَذا الهَوى غَيرُ مُمكِنٍ","ومِثلِي عَلى مِثلِ الهَوى لَيسَ يَمكُثُ",71,"ث",1,0],["ثَبَتُّ عَلى الإِطنابِ في مُعجِزاتِهِ","أُباحِثُ عَنها ما اِستَطَعَتُ وَأَبحَثُ",72,"ث",1,0],["ثَباتيَ عَنهُ حَيثُ لَم يُقضَ قُربُهُ","ثَباتُ بَعيدِ الدارِ عَمَّن يُحِبُّهُ",72,"ه",1,0],["ثَبيتُ مَناطِ القَلبِوَالجَوُّ أَغبَر","كَريمُ مَنالِ الكَفِّ وَالرَوضُ عَثعَثُ",72,"ث",1,0],["ثبته رب السما بخلقه","كرماني في دينه مرتبك",73,"ك",1,0],["ثَبتَت رَوَاسِيها وَزَانَ فُرُوعَها","فَضلٌ يمنّعُ مِن تَعَاطِى الحاصِلِ",74,"ل",1,0],["ثبوت حسنك لي فيه شهادات","وللعذار على هذا سجلات",75,"ت",1,1],["ثبتا قوياً في الجهاد مؤيداً","ثقة أميناً في البلاغ نصاحا",76,"ح",2,0],["ثَبتٌ إِذا غَشيَ الوَغى مُتَأَيَّدٌ","عَجِلٌ إِذا سُئِلَ النَدى مُتَسَرِّعُ",77,"ع",1,0],["ثَبَتَت لِبَأسِكَ في القُلوبِ مَهابَةٌ","تَرَكَت مَخا