{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[9,"لا فشل في ولا سقاط","https://www.aldiwan.net/poem21950.html","الرجز"],[86,"لا والأسى وتلهب الأحشاء","https://www.aldiwan.net/poem10498.html","الكامل"],[71,"عجبت للطيف يا لمياء حين سرى","https://www.aldiwan.net/poem4012.html","البسيط"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[71,"ملك إذا ما الوفد حل ببابه","https://www.aldiwan.net/poem4019.html","الكامل"],[71,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[73,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[30,"يا دار مية لم يترك لنا علما","https://www.aldiwan.net/poem29601.html","البسيط"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[72,"يا ناسيا عهدي ولست بناسي","https://www.aldiwan.net/poem19017.html","الكامل"],[72,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[51,"بأبي وأمي أنتم","https://www.aldiwan.net/poem65831.html","مجزوء الكامل"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[91,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[89,"أنا لولا الرحمن والعفو منه","https://www.aldiwan.net/poem45102.html","الخفيف"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[56,"شرفي محبة معشر","https://www.aldiwan.net/poem58627.html","مجزوء الكامل"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[45,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[45,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[61,"مرضت جفونك والحتوف شعارها","https://www.aldiwan.net/poem51680.html","الكامل"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[66,"ثب إلى اللذات فالعمر قصير","https://www.aldiwan.net/poem39046.html","الرمل"],[66,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[80,"بني الثغر لستم في الوغى من بني أمي","https://www.aldiwan.net/poem31307.html","الطويل"],[80,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[69,"يا رب بالهادي البشير محمد","https://www.aldiwan.net/poem28352.html","الكامل"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[81,"زار ليلا فظلت من فرحتي أحسب","https://www.aldiwan.net/poem61512.html","الخفيف"],[46,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1661","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54587","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55101","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43633","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[90,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[45,"أتَرَى الزّمَانَ يُعَيدُ لي أيّامي","https://www.poetsgate.com/ViewPoem.aspx?id=32037",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[88,"نجيت بالسد بغداداً من الغرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19538&r=&rc=41",""]],"verses":[["ثَبتٌ لِهَجهَجَةِ الخُطوبِ كَأَنَّما","جاءَت تُقَعقِعُ بِالشِنانِ لِيَذبُلِ",0,"ل",1,0],["ثَبَّتَّ فيها وِطاءَهُ وَوَراءَهُ","جَزَعٌ يُقَلقِلُ مِن قُلوبِ الجَندَلِ",0,"ل",1,0],["ثَبْت الْجَنَانِ إِذَا الْخُطُوبُ تَعَاظَمَتْ","مُتَبَسِّمٌ فِي الْحَادِثِ الْمُتَجَهِّمَ",1,"م",1,0],["ثَبتٍ إِذا قيلَ لَهُ يُعاطي","أَخرَجَ حُضراً غَيرَ ذي نِياطِ",2,"ط",1,0],["ثَبِّت فُؤادَكَ يا قَليلَ تَصَبُّري","وَاِشرَح لِآلِ أَباظَةٍ بُرَحائي",3,"ا",2,0],["ثَبتُ الجَنانِ لَهُ حلمٌ يُوَقِّرُهُ","إِن خامَرَ الطَيشُ رُكني يَذبُلٍ وِحرا",4,"ر",2,0],["ثَبتُ الجَنانِ لَهُ حُلمٌ يَوَقِّرُهُ","إِذا هَفا بِحَلومِ السادَةِ الغَضَبُ",5,"ب",1,0],["ثَبتُ الجَنانِ إِذا الجِبالُ تَزَعزَعَت","حامي الحَقيقَةِ حامِلٌ ما أَتعَبا",6,"ب",2,0],["ثَبتُ الجنانِ تُراعُ مِن وَثَباتِهِ","يَومَ الوَغى وَثَباته أُسدُ الشَرى",7,"ر",2,0],["ثَبتُ السَكينَةِ في النَدِيِّ كَأَنَّما","تِلكَ الحُبا ليثَت بِهَضبِ مَتالِعِ",8,"ع",1,0],["ثَبْتٌ عَلَى كُلِّ حَالٍ فِي مَبَادِئِهِ","سِيَّانَ مِنْهَا لَدَيْهِ اليُسْرُ وَالْعُدُمُ",9,"م",1,0],["ثُبتُ الحُلومِ فَإِن سُلَّت حَفائِظُهُم","سَلّوا السُيوفَ فَأَردَوا كُلَّ ذي عَنَتِ",10,"ت",1,0],["ثَبجاءَ مُجفَرَةٍ سَطعاءَ مُفَرَّعَةٍ","في خَلفِها مِن وَراءِ الرَحلِ تَنضيدُ",11,"د",1,0],["ثبّتّ عزمك في أمر يذلّ به","عزم الحصيف لما يحوي من الزلق",12,"ق",1,0],["ثبتٌ تمرّ عليه أقوالُ العدى","مرّ الرّياح على الأشم الراسي",13,"س",2,0],["ثبت الجوانب والدنيا مزلزلةٌ","وصائل الرأي والقرضاب لم يصل",14,"ل",1,0],["ثبتتْ لكم أعراقُكُمْ","حتى ثويتم في المعاركْ",15,"ك",1,0],["ثبَّتَ اللَّهُ دولةً لك أضْحت","كلُّ بلوى بَعدلها معدولهْ",16,"ل",2,0],["ثَبَتَ الجِنانِ قَوِيُّهُ عَفَّ الإِزا","رِ نَقِيُّهُ ما خانَ قَطُّ خَليلا",17,"ل",2,0],["ثَبجاءَ دَفواءَ مَبنيٍّ مَرافِقُها","عَلى حَصيرَينِ في دَفَّيهِما جُدَدُ",18,"د",1,0],["ثبتوا عند عبرهم لتقاهم","في متون الأكباش كالأوتاد",19,"د",1,0],["ثبتوا على عهد البلاد بموقف","ناب الثبات به عن الأجناد",20,"د",1,0],["ثبتت أواسى العرش في محرابه","وأوت إليه أمة وديار",21,"ر",1,0],["ثِب إِلىالنَجمِ وَزاحِم رُكنَهُ","وَاِمتَلِئ مِن خُيَلاءٍ وَمِراح",22,"ح",1,0],["ثَبَتَّ مُؤَمِّلاً مِنكَ الثَباتُ","تُوافيكَ الرَسائِلُ وَالسُعاةُ",23,"ا",2,0],["ثَبْتٌ إذا قَدَمَا سِوا","هُ في المَهَاوِي زَلّتَا",24,"ت",2,0],["ثَبْتُ الجَنانِ فإنْ تلسَّنَ بارِقٌ","بذراكَ مادَ بشجوهِ متململا",25,"ل",2,0],["ثَبتُ العَزيمَةِ مُصمَتُ الأَحشاءِ في","أَهوالِ ذاكَ العارِضِ المُتَكَشِّفِ",26,"ف",1,0],["ثَبتِ الأَناةِ إِذا اِستَبَدَّ بِرَأيِهِ","وَفّاكَ حَقّا النَقضِ وَالإِبرامِ",27,"م",1,0],["ثَبَتَت تَحتَ الحَشا آخِيَةٌ","مِنهُ لا يَنزِعُها المُهرُ الأَرِنّ",28,"ن",1,0],["ثَبَّتَ اللَهُ وَطأَةً لَكَ أَمسَت","جَبَلاً راسِياً عَلى المُشرِكينا",29,"ن",2,0],["ثَبَتوا إلى أجدارِها فكأنَّهم","والطَّعْنُ يَقتَلِعُ الكُماةَ جدارُها",30,"ر",3,0],["ثَبُتَت مَغارِسُ حُبِّكُم في خاطِري","فَهُوَ القَديمُ وَكُلُّ حُبٍّ مُحدَثُ",31,"ث",1,0],["ثَبتُ الجَنانِ يَكادُ يُبعَثُ مُرسَلاً","لَو أَنَّ بَعدَ مُحَمَّدٍ مَن يُبعَثُ",31,"ث",1,0],["ثِب لِلعُلى وَاِستَخدِمِ الدَهرَ الَّذي","إِن تَدعُهُ لِمُلِمَّةٍ لا يَلبَثُ",31,"ث",1,0],["ثُبنا إِلَيكَ عَلى هِجانٍ ضُمَّرٍ","شِبهِ القِسِيِّ إِلى حِماكَ تُحَثَّتُ",31,"ث",2,0],["ثَبُتَت وَلَو حَلَفَت بِأَنَّكَ ناعِشٌ","بِنَوالِكَ الأَرواحَ لَم تَكُ تَحنَثُ",31,"ث",1,0],["ثُب إِلى اللَذّاتِ فَالعُمرُ قَصيرُ","وَحَياةُ المَرءِ في الدُنيا غُرورُ",32,"ر",1,1],["ثَبتُ الجَنانِ مَريرُ الرَأيِ صائِبُهُ","إِذا تَقاعَسَ صَرفُ الدَهرِ أَو جَمَحا",33,"ح",2,0],["ثبوتٌ إذا ما أقْبَلَ الموتُ فاغراً","يُرَدّد في الأسْماعِ جرْجرَةَ القَرْمِ",34,"م",1,0],["ثبتَتْ رصانةُ حِلْمِهِ فكأنّما","أرساهُ خالقُهُ بِهَضْبَةِ يَذْبُلِ",35,"ل",1,0],["ثبتتْ قواعدُ مُلْكِهِ فكأنّما","أرساهُ ربّ العرشِ بالأطوادِ",36,"د",1,0],["ثَبتُ المَقامِ يَرى القَبيلَةَ واحِداً","وَيُرى فَيَحسَبُهُ القَبيلُ قَبيلا",37,"ل",2,0],["ثَبتُ البَيانِ إِذا تَحَيَّرَ قائِلٌ","أَضحى شِكالاً لِلِّسانِ المُطلَقِ",38,"ق",1,0],["ثَبتُ الجَنانِ إِذا اِصطَكَّت بِمُظلِمَةٍ","في رَحلِهِ أَلسُنُ الأَقوامِ وَالرُكَبُ",39,"ب",1,0],["ثبِّتْ على الإسلامِ قلبي واهدني","للحقِّ وانصرني على الشيطانِ",40,"ن",1,0],["ثبِّتْ على الحقِّ المبينِ قُلوبَنا","في المتّقينَ وزلزلِ الفُجّارا",41,"ر",2,0],["ثَبَتوا بِمُعتركِ الحُتوفِ مَعاقِلاً","ورَسَوْا بِمُصطَدَمِ الصُّفوفِ جبالا",42,"ل",2,0],["ثُبتُ مِنها وَالبَدرُ يُسفِرُ في الأُف","قِ حَسوداً وَالنَجمُ يَهفو غَيورا",43,"ر",2,0],["ثِب مِن طِمارٍ إِذا لَم تَستَطِع سَرَباً","وَثِب شَبيهَ التَميمِيِّ الَّذي طَمَرا",44,"ر",2,0],["ثَبَتَا في قَميصِهِ ليَجيءَ الحَشْ","رَ مُسْتَعْدِياً إلى الرّحْمنِ",45,"ن",1,0],["ثَبَتَت وَكانَ ثَباتُها","يَدعو إِلى العَجَبِ العُجاب",46,"ب",1,0],["ثَبَتَت لِأَنَّ لَها إِلى","أَعتابِ مَولانا اِنتِساب",46,"ب",1,0],["ثَبتُ الطِعانِ إِذا الكُماةُ أَذَلَّها","عَرَقُ المُتونِ يَجُلنَ بِالأَلبادِ",47,"د",1,0],["ثبِّتْ لعبدِ اللَّهِ حُسنَ نيَّته","واعطفه بالفضل على رعيَّته",48,"ه",1,0],["ثَبَتَتْ فِيهِ خَالِدَاتُ المَعَانِي","وَانْتَفَى مَا أَعَارَهُنَّ الرَّغَامُ",49,"م",1,0],["ثَبْتاً إِذَا مَا الرَّاسِخونَ تَقَلْقَلُوا","مُتَوَافِقَ الإِعْلاَنِ وَالإِسْرَارِ",50,"ر",1,0],["ثَبَاتِي مِنَ السُّقْمِ المُقِيمِ أَفَدْتُهُ","وَصَبْرِيَ مَمَّا أَكْسَبَتْنِي المَتَاعِبُ",51,"ب",1,0],["ثَبْتاّ وَعَزْمُكَ مُسْتَزِيدٌ قُوَّةً","مِنْ طارِىءِ الإِدْبَارِ لِلإقْبَالِ",52,"ل",1,0],["ثَبْتُ الفُؤَادِ لأَبْعَدِ","الْغَايَاتِ طَلاَّبٌ فَمُدْرِكْ",53,"ك",1,0],["ثبوتاً عَلى العَهدِ الَّذي كانَ بَينَنا","إِذا غَيَّرَ الأَحبابَ صَرفُ الحَوادِثِ",54,"ث",1,0],["ثَبَتَت حباهُ فَدونَهُنَّ يلملمٌ","وَسَمَت علاهُ فَدونَها البِرجيسُ",55,"س",1,0],["ثَبَّتُّ في النائِباتِ قَلبي","حَتّى طَوَت مَن بِهِ اِشتِباثي",56,"ث",2,0],["ثَبَّطكَ اللَهُ لَستَ تُبقي","عَلى بُزاةٍ وَلا بُغاثِ",56,"ث",1,0],["ثَبَتَا لِحُكْمِ اللّه جَلَّ جَلاَلهُ","والْخطْبُ يَلْقَاه الكِرَامُ كِرَاما",57,"م",2,0],["ثباتاً يا دِمَشقُ على الرزايا","وتوطيناً وإن ضاق الخناق",58,"ق",1,0],["ثبت وحسب المرء فخراً ثباته","\" كما ثبتت في الراحتين الأصابع \"",59,"ع",1,0],["ثَبْتِ الأنَاةِ، إذا اسْتَبَدّ برَأيِهِ","وَفّاكَ حَقَّ النّقْضِ والإبْرَامِ",60,"م",1,0],["ثبتٌ إذا زُلزلت الأقدام","ُ بحجة اللَّه له رِجَامُ",61,"م",1,0],["ثبّت عزمك في أمر يذِلّ به","عزم الحصيف لما يحوي من الزاق",62,"ق",1,0]]}