ل","https://www.aldiwan.net/poem56067.html","الرجز"],[460,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[460,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[460,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[463,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[479,"دعني من العذل يا من بات يلحاني","https://www.aldiwan.net/poem15203.html","البسيط"],[481,"من كل قلب لو تشا لك منزل","https://www.aldiwan.net/poem36870.html","الكامل"],[481,"كم من ليال قضيناها وكم نهر","https://www.aldiwan.net/poem36901.html","البسيط"],[484,"لما يرى حبها فؤادي","https://www.aldiwan.net/poem24552.html","عموديه"],[509,"أبلغ لديك أبا خليد وائلاً","https://www.aldiwan.net/poem2135.html","الكامل"],[516,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[516,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[516,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[516,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[517,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[517,"يا سيداً في أوصافه","https://www.aldiwan.net/poem12111.html","مجزوء الكامل"],[517,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[531,"إن اللقا أفضل إن كان في","https://www.aldiwan.net/poem37164.html","السريع"],[531,"يا رب لا تقبضني قبل ما","https://www.aldiwan.net/poem37294.html","السريع"],[531,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[531,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[531,"متى أرى الحق فوق باطلهم","https://www.aldiwan.net/poem37493.html","البسيط"],[540,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[540,"يا طيب الإسم والأفعال والشيم","https://www.aldiwan.net/poem47937.html","عموديه"],[540,"ألحمد لله زال الخوف والوجل","https://www.aldiwan.net/poem47987.html","عموديه"],[542,"يا ابن الفواطم خير الناس كلهم","https://www.aldiwan.net/poem56823.html","البسيط"],[553,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[553,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[553,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[560,"إن قلت لم أقدر ولم أستطع","https://www.aldiwan.net/poem33824.html","السريع"],[560,"إن قلت إن الوجود نفس","https://www.aldiwan.net/poem34238.html","مخلع البسيط"],[564,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[589,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"],[607,"","https://poetry.dctabudhabi.ae/diwan/poem/76778","الكامل"]],"verses":[["أوقِظُهُم وَلِلكَرى","فيهِم خَبالٌ وَلَمَم",0,"م",1,0],["أَو قابِضينَ عَلى الأَزَمَّةِ وَالكَرى","يَغشى أَكُفَّهُمُ النُعاسُ فَتَمرُقُ",1,"ق",1,0],["أَوقَدَتها بَينَ العَقيقِ فَشَخصَي","نِ بِعودٍ كَما يَلوحُ الضِياءُ",2,"ا",2,0],["أَوقَعَ بِيَ الحُبَّ قَولُ واصِفَةٍ","يا لَيتَها لَم تَقُل وَلَم تَصِفِ",3,"ف",1,0],["أوْ قَامَ فِي نَادِي الْمُلُوكِ خَطِيبُهُمْ","خَرُّوا لَهُ رَهَباً عَلَى الأَذْقَانِ",4,"ن",1,0],["أوْقَحُ القَوْمِ ضَجَّتِ الأَرْضُ مِنْهُمْ","نَبَذُوا كُلَّ حِشْمَةٍ وَحَيَاءِ",5,"ا",2,0],["أَو قيلَ في الشَمسِ لِلراجينَ مُنتَجَعٌ","مَدّوا لَها سَبَباً في الجَوِّ وَاِنتَدَبوا",6,"ب",3,0],["أَو قالَ نَثراً فَرَوحٌ","يَجتازُنا غِبَّ مُزنِ",7,"ن",1,0],["أو قلت إن الشمس قد عقدت","تاجاً لها من مذهب الشعر",8,"ر",1,0],["أو قلت إن الروض ألبسها","أزهى لبوس الأغصن النضر",8,"ر",1,0],["أو قلت إن الطير علمها","غرد الهزار وخفة القمري",8,"ر",2,0],["أَوْقَعَ الذُّعْرَ حَيْنُهُ فِي نُفُوسٍ","خِلْنَ مَنْ ذَاكَ عَزْمُهُ لا يَحِينُ",9,"ن",1,0],["أَوْقَدَ الصَّيْفُ فِي الصَّعيدِ لَظَاهُ","فَأَجَفَّ الحُقُولَ والآجَامَا",10,"م",2,1],["أو قَصَّروا يوم الطعان رماحَهم","وصَلُوا بها الخَطْوَ الوَسَاعَ طويلا",11,"ل",2,0],["أوقدوا فيه للسرور سراجاً","عمّ من نوره البلاد ظلام",12,"م",1,0],["أو قيل إن نهاركم","ليل فقولوا مُظلم",13,"م",1,0],["أو قيل إن ثِمادكم","سَيل فقولوا مُفعَم",13,"م",1,0],["أو قيل إن بلادكم","يا قوم سوف تُقسَّم",13,"م",1,0],["أَو قُلتَ إِنَّ حِمامَ المَوتِ آخِذُكُم","أَو تُلجِموا فَرَساً قامَت بَواكيها",14,"ي",3,0],["أَوقِد فَإِنَّ اللَيلَ لَيلٌ قَرُّ","وَالريحَ يا موقِدُ ريحٌ صِرُّ",15,"ر",1,1],["أوقفتَ بالرسم المُحيل الدارس","بين الذنائب فالبراقِ فراكسِ",16,"س",1,1],["أوقات أنسكما في ضوءِ كلِّ دجىً","يا نور شمعيَ أو يا صفو جلاسي",17,"س",2,0],["أوقفني ودِّيَ مع هاجرٍ","يبخل بالدّرج وبالوصل",18,"ل",1,1],["أوقات سبقي أن أكون مصلياً","فعليّ أن أقضي صلاتي كلَّما",19,"م",2,0],["أو قال إني قَريعُ الناسِ كلِّهِمِ","في الشعر وهو سقيم الشعر والنسبِ",20,"ب",1,0],["أو قَرعةِ القَصَّارِ أو بَيْضَةٍ","لِلهَيْق في داويّةٍ سَبْسبِ",21,"ب",1,0],["أو قيل من تهوين قالت فتى","أَصلع في يافوخه شجهْ",22,"ج",2,0],["أوقد الحسْنُ نارَه من وحيدٍ","فوق خدٍّ ما شَانَهُ تخْدِيدُ",23,"د",1,0],["أو قل لعبدك كيف يص","نع إنه لك مستشيرُ",24,"ر",1,0],["أو قصّروا فتناولوا بأكفهم","قمرَ السماء وكلّ نجم ساري",25,"ر",2,0],["أوقح الناس كلهم ليس يخفى","ذاك في جلد وجهها المدبوغ",26,"غ",1,0],["أو قلتُ قولاً لست أجهل أنه","فيه لصدرِ مُرجِّم تخشين",27,"ن",1,0],["أَو قارِبٌ بِالعُرى هاجَت مَراتِعُهُ","وَخانَهُ موثِقُ الغُدرانِ وَالثَمَدُ",28,"د",1,0],["أَوقَعَ الرُعبَ في قُلوبِ الضَواري","فَاِستَكانَت كَأَنَّها في قُيودِ",29,"د",1,0],["او قسور حمارس","سطا على ثعالب",30,"ب",1,0],["أو قد رميت أسهما","فما أصابت أسهمي",31,"م",2,0],["أَو قَناطيرُهُ تَأَنَّقَ فيها","أَلفُ جابٍ وَأَلفُ صاحِبِ مَكسِ",32,"س",1,0],["أَو قِصَّةٍ كَكِتابِ الدَهرِ جامِعَةٍ","كِلاهُما فيهِ إِضحاكٌ وَإِبكاءُ",33,"ا",2,0],["أو قَذِيَتْ مقلتي فلا عَجَبٌ","فقد حَثَوا تربَها على بَصَرِي",34,"ر",2,0],["أَوقَدَ اللَهُ في ضَريحِ أَبي الفَت","حِ ضِراماً إِذا تَقَضّى يَعودُ",35,"د",1,0],["أَوَقارٌ مِنهُ فَمِن نَقصِ حَظّي","حِلمُهُ دونَ بُغيَتي وَوَقارُه",36,"ر",2,0],["أَوقَعتَ بِالبَلَدِ المُشَرِّقِ وَقعَةً","أَمسَت بِكُلِّ بِلادِ قَومٍ تُشهَرُ",37,"ر",1,0],["أوقعني في معفر خلق","قد ضاع فيه رفوي وتقبيجي",38,"ج",2,0],["أُوقِظُه بالعَزفِ أو","يُوقِظُني إذا صدَح",39,"ح",1,0],["أَو قُلتُ أَينَ تُرى المُؤَيَّدُ قالَ لي","أَينَ المُظَفَّرُ قَبلُ وَالمَنصورُ",40,"ر",1,0],["أَو قِياناً مِن ذَوائِبِها","شَفَقٌ لِلشَمسِ لَم يَغِبِ",41,"ب",1,0],["أَو قُلتُ أَتلَفتَ الفُؤادَ أَجابَني","دَعني فَما أَخرَبتُ إِلّا مَسكَني",42,"ن",2,0],["أَو قُلتُ يا دُنيايَ قالَ فَإِن أَكُن","دُنياكَ لِم أَنكَرتَ فَرطَ تَلَوَّني",42,"ن",2,0],["أَو قيلَ جُز فَوقَ الصِراطِ مُسارِعاً","لَمَشى عَليهِ مِشيَةَ السَرَطانِ",43,"ن",1,0],["أَوقَعتَ في أَبرَشتَويمَ وَقائِعاً","أَضحَكنَ سِنَّ الدينِ وَهوَ حَزينُ",44,"ن",1,0],["أَوقَدتَ مِن دونِ الخَليجِ لِأَهلِها","ناراً لَها خَلفَ الخَليجِ شَرارُ",45,"ر",1,0],["أَو قَدَّمَتكَ السِنُّ خِلتُ بِأَنَّهُ","مِن لَفظِكَ اِشتُقَّت بَلاغَةُ خالِدِ",46,"د",1,0],["أُوقِعَ فِي أَشْرَاكِهِ","لِكُلِّ حَيٍّ مَا نَوَى",47,"و",2,0],["أو قلتُ ريقُكِ ثلجٌ","قالتْ تشبِّهُ باردْ",48,"د",1,0],["أو قارنٍ بأسمه خُبثاً وملأمةً","مَن ليس يوماً بضْبِعَيْهِ بمقرون",49,"ن",1,0],["أَوقَفتُ مِن طَلَلٍ عَلى رَسمِ","بِلِوى العَقيقِ يَلوحُ كَالوَشمِ",50,"م",1,1],["أو قطوبٌ تخيب منه المساعي","وابتسامٌ تذوب فيه المبادي",51,"د",2,0],["أَو قُلت في شَكواي واهاً سرت","وَرَدد الوادي صَدى آها",52,"ا",3,0],["أوَ قَد جَهِلتَ مِنَ الحَدِيثِ رِوايَةً","أمْ قد نسيتَ مِنَ الكتاب نُزُولا",53,"ل",2,0],["أو قَرقَفٍ ممّا تنشّى الرّومَ لا","نَشَواتُها ذُمّتْ ولا نَشوانُها",54,"ن",3,0],["أَو قُلتَ ما تَقولُ قالَ شَرّا","أَصلاهُ رَبّي لَهَباً وَجَمرا",55,"ر",2,0],["أَو قائِلٍ يُخبِرُها حالِفاً","أَن لَيسَ مِنها بِيَ مِن باسِ",56,"س",1,0],["أَو قُبلَةٌ في خِلالِ ذاكَ وَلا","بَأَسَ إِذا لَم تُحلَّلِ الأُزُرُ",57,"ر",1,0],["أَوقاتُ عاجِلَةٍ كَأَنَّ مُضِيَّها","وَمضُ البُروقِ خَواطِفاً لَمَعاتُها",58,"ت",3,0],["أَوقَدتَ ناراً بِإِفتِكارَكَ أَظهَرَت","نَهجاً وَأَنتَ عَلى سَناها عاشِ",59,"ش",1,1],["أَو قيلَ لِلنارِ خُصّي مَن جَنى أَكَلَت","أَجسادَهُم وَأَبَت أَكلَ السَرابيلِ",60,"ل",1