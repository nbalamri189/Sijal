{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[55,"ماذا تقولين في فتى كلف","https://www.aldiwan.net/poem26232.html","المنسرح"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[77,"سيدي أنت عمدتي فاحتملني","https://www.aldiwan.net/poem36788.html","الخفيف"],[86,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[93,"قد قلدوك قلائد الدرر","https://www.aldiwan.net/poem9844.html","أحذ الكامل"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[93,"أوقد الصيف في الصعيد لظاه","https://www.aldiwan.net/poem11417.html","الخفيف"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[88,"أطربتهم بلحنها الأنغام","https://www.aldiwan.net/poem44463.html","الخفيف"],[88,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[27,"قد غلبتني رواة الناس كلهم","https://www.aldiwan.net/poem4428.html","البسيط"],[11,"أوقد فإن الليل ليل قر","https://www.aldiwan.net/poem251.html",""],[37,"أوقفت بالرسم المحيل الدارس","https://www.aldiwan.net/poem7205.html","الكامل"],[72,"إذا نزلت حماكم يا بني حجر","https://www.aldiwan.net/poem19038.html","البسيط"],[72,"أوقفني ودي مع هاجر","https://www.aldiwan.net/poem19651.html","السريع"],[72,"إن أخرتني عن مديحك فترة","https://www.aldiwan.net/poem20044.html","الكامل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"وقينة أبرد من ثلجه","https://www.aldiwan.net/poem9259.html","السريع"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[51,"قبلته فمج في جوف فيها","https://www.aldiwan.net/poem65434.html","الخفيف"],[51,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[89,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[85,"أعلى الممالك ما كرسيه الماء","https://www.aldiwan.net/poem63727.html","الكامل"],[62,"قد كذب الظن صادق الخبر","https://www.aldiwan.net/poem52383.html","المنسرح"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[45,"أطلب النوم كي يعود غراره","https://www.aldiwan.net/poem63577.html","الخفيف"],[28,"أهلي فداؤك يا وكيع إذا بدا","https://www.aldiwan.net/poem5231.html","الكامل"],[61,"درجني الحرف أي تدريج","https://www.aldiwan.net/poem51376.html","المنسرح"],[61,"إن عن لهو أو سنح","https://www.aldiwan.net/poem51734.html","مجزوء الرجز"],[66,"خفض همومك فالحياة غرور","https://www.aldiwan.net/poem40119.html","الكامل"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[66,"إني ليطربني العذول فأنثني","https://www.aldiwan.net/poem41355.html","الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[44,"هي فرقة من صاحب لك ماجد","https://www.aldiwan.net/poem30554.html","الكامل"],[87,"ويلاه من نار الهوى","https://www.aldiwan.net/poem8195.html","مجزوء الرجز"],[69,"إن قلت قدك غصن","https://www.aldiwan.net/poem29114.html","المجتث"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[31,"أوقفت من طلل على رسم","https://www.aldiwan.net/poem41324.html","الكامل"],[102,"ليت لي من جماعة السار قوما","https://www.aldiwan.net/poem32968.html","الخفيف"],[102,"كم قائل لو كنت تلقاها","https://www.aldiwan.net/poem33025.html","السريع"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"قولا لإبراهيم قولا هترا","https://www.aldiwan.net/poem63381.html","الرجز"],[48,"قل لنداماي وجلاسي","https://www.aldiwan.net/poem64317.html","السريع"],[50,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[46,"أوقدت نارا بإفتكارك أظهرت","https://www.aldiwan.net/poem22867.html","الكامل"],[46,"مضى الزمان ونفس الحي مولعة","https://www.aldiwan.net/poem23227.html","البسيط"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39547","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202539","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39491","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42683","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[106,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""]],"verses":[["أوقِظُهُم وَلِلكَرى","فيهِم خَبالٌ وَلَمَم",0,"م",1,0],["أَو قابِضينَ عَلى الأَزَمَّةِ وَالكَرى","يَغشى أَكُفَّهُمُ النُعاسُ فَتَمرُقُ",1,"ق",1,0],["أَوقَدَتها بَينَ العَقيقِ فَشَخصَي","نِ بِعودٍ كَما يَلوحُ الضِياءُ",2,"ا",2,0],["أَوقَعَ بِيَ الحُبَّ قَولُ واصِفَةٍ","يا لَيتَها لَم تَقُل وَلَم تَصِفِ",3,"ف",1,0],["أوْ قَامَ فِي نَادِي الْمُلُوكِ خَطِيبُهُمْ","خَرُّوا لَهُ رَهَباً عَلَى الأَذْقَانِ",4,"ن",1,0],["أوْقَحُ القَوْمِ ضَجَّتِ الأَرْضُ مِنْهُمْ","نَبَذُوا كُلَّ حِشْمَةٍ وَحَيَاءِ",5,"ا",2,0],["أَو قيلَ في الشَمسِ لِلراجينَ مُنتَجَعٌ","مَدّوا لَها سَبَباً في الجَوِّ وَاِنتَدَبوا",6,"ب",3,0],["أَو قالَ نَثراً فَرَوحٌ","يَجتازُنا غِبَّ مُزنِ",7,"ن",1,0],["أو قلت إن الشمس قد عقدت","تاجاً لها من مذهب الشعر",8,"ر",1,0],["أو قلت إن الروض ألبسها","أزهى لبوس الأغصن النضر",8,"ر",1,0],["أو قلت إن الطير علمها","غرد الهزار وخفة القمري",8,"ر",2,0],["أَوْقَعَ الذُّعْرَ حَيْنُهُ فِي نُفُوسٍ","خِلْنَ مَنْ ذَاكَ عَزْمُهُ لا يَحِينُ",9,"ن",1,0],["أَوْقَدَ الصَّيْفُ فِي الصَّعيدِ لَظَاهُ","فَأَجَفَّ الحُقُولَ والآجَامَا",10,"م",2,1],["أو قَصَّروا يوم الطعان رماحَهم","وصَلُوا بها الخَطْوَ الوَسَاعَ طويلا",11,"ل",2,0],["أوقدوا فيه للسرور سراجاً","عمّ من نوره البلاد ظلام",12,"م",1,0],["أو قيل إن نهاركم","ليل فقولوا مُظلم",13,"م",1,0],["أو قيل إن ثِمادكم","سَيل فقولوا مُفعَم",13,"م",1,0],["أو قيل إن بلادكم","يا قوم سوف تُقسَّم",13,"م",1,0],["أَو قُلتَ إِنَّ حِمامَ المَوتِ آخِذُكُم","أَو تُلجِموا فَرَساً قامَت بَواكيها",14,"ي",3,0],["أَوقِد فَإِنَّ اللَيلَ لَيلٌ قَرُّ","وَالريحَ يا موقِدُ ريحٌ صِرُّ",15,"ر",1,1],["أوقفتَ بالرسم المُحيل الدارس","بين الذنائب فالبراقِ فراكسِ",16,"س",1,1],["أوقات أنسكما في ضوءِ كلِّ دجىً","يا نور شمعيَ أو يا صفو جلاسي",17,"ي",1,0],["أوقفني ودِّيَ مع هاجرٍ","يبخل بالدّرج وبالوصل",18,"ل",1,1],["أوقات سبقي أن أكون مصلياً","فعليّ أن أقضي صلاتي كلَّما",19,"م",2,0],["أو قال إني قَريعُ الناسِ كلِّهِمِ","في الشعر وهو سقيم الشعر والنسبِ",20,"ب",1,0],["أو قَرعةِ القَصَّارِ أو بَيْضَةٍ","لِلهَيْق في داويّةٍ سَبْسبِ",21,"ب",1,0],["أو قيل من تهوين قالت فتى","أَصلع في يافوخه شجهْ",22,"ج",2,0],["أوقد الحسْنُ نارَه من وحيدٍ","فوق خدٍّ ما شَانَهُ تخْدِيدُ",23,"د",1,0],["أو قل لعبدك كيف يص","نع إنه لك مستشيرُ",24,"ر",1,0],["أو قصّروا فتناولوا بأكفهم","قمرَ السماء وكلّ نجم ساري",25,"ر",2,0],["أوقح الناس كلهم ليس يخفى","ذاك في جلد وجهها المدبوغ",26,"غ",1,0],["أو قلتُ قولاً لست أجهل أنه","فيه لصدرِ مُرجِّم تخشين",27,"ن",1,0],["أَو قارِبٌ بِالعُرى هاجَت مَراتِعُهُ","وَخانَهُ موثِقُ الغُدرانِ وَالثَمَدُ",28,"د",1,0],["أَوقَعَ الرُعبَ في قُلوبِ الضَواري","فَاِستَكانَت كَأَنَّها في قُيودِ",29,"د",1,0],["او قسور حمارس","سطا على ثعالب",30,"ب",1,0],["أو قد رميت أسهما","فما أصابت أسهمي",31,"ي",1,0],["أَو قَناطيرُهُ تَأَنَّقَ فيها","أَلفُ جابٍ وَأَلفُ صاحِبِ مَكسِ",32,"س",1,0],["أَو قِصَّةٍ كَكِتابِ الدَهرِ جامِعَةٍ","كِلاهُما فيهِ إِضحاكٌ وَإِبكاءُ",33,"ا",2,0],["أو قَذِيَتْ مقلتي فلا عَجَبٌ","فقد حَثَوا تربَها على بَصَرِي",34,"ر",2,0],["أَوقَدَ اللَهُ في ضَريحِ أَبي الفَت","حِ ضِراماً إِذا تَقَضّى يَعودُ",35,"د",1,0],["أَوَقارٌ مِنهُ فَمِن نَقصِ حَظّي","حِلمُهُ دونَ بُغيَتي وَوَقارُه",36,"ر",2,0],["أَوقَعتَ بِالبَلَدِ المُشَرِّقِ وَقعَةً","أَمسَت بِكُلِّ بِلادِ قَومٍ تُشهَرُ",37,"ر",1,0],["أوقعني في معفر خلق","قد ضاع فيه رفوي وتقبيجي",38,"ج",2,0],["أُوقِظُه بالعَزفِ أو","يُوقِظُني إذا صدَح",39,"ح",1,0],["أَو قُلتُ أَينَ تُرى المُؤَيَّدُ قالَ لي","أَينَ المُظَفَّرُ قَبلُ وَالمَنصورُ",40,"ر",1,0],["أَو قِياناً مِن ذَوائِبِها","شَفَقٌ لِلشَمسِ لَم يَغِبِ",41,"ب",1,0],["أَو قُلتُ أَتلَفتَ الفُؤادَ أَجابَني","دَعني فَما أَخرَبتُ إِلّا مَسكَني",42,"ي",1,0],["أَو قُلتُ يا دُنيايَ قالَ فَإِن أَكُن","دُنياكَ لِم أَنكَرتَ فَرطَ تَلَوَّني",42,"ي",1,0],["أَو قيلَ جُز فَوقَ الصِراطِ مُسارِعاً","لَمَشى عَليهِ مِشيَةَ السَرَطانِ",43,"ن",1,0],["أَوقَعتَ في أَبرَشتَويمَ وَقائِعاً","أَضحَكنَ سِنَّ الدينِ وَهوَ حَزينُ",44,"ن",1,0],["أَوقَدتَ مِن دونِ الخَليجِ لِأَهلِها","ناراً لَها خَلفَ الخَليجِ شَرارُ",45,"ر",1,0],["أَو قَدَّمَتكَ السِنُّ خِلتُ بِأَنَّهُ","مِن لَفظِكَ اِشتُقَّت بَلاغَةُ خالِدِ",46,"د",1,0],["أُوقِعَ فِي أَشْرَاكِهِ","لِكُلِّ حَيٍّ مَا نَوَى",47,"و",2,0],["أو قلتُ ريقُكِ ثلجٌ","قالتْ تشبِّهُ باردْ",48,"د",1,0],["أو قارنٍ بأسمه خُبثاً وملأمةً","مَن ليس يوماً بضْبِعَيْهِ بمقرون",49,"ن",1,0],["أَوقَفتُ مِن طَلَلٍ عَلى رَسمِ","بِلِوى العَقيقِ يَلوحُ كَالوَشمِ",50,"م",1,1],["أو قطوبٌ تخيب منه المساعي","وابتسامٌ تذوب فيه المبادي",51,"ي",1,0],["أَو قُلت في شَكواي واهاً سرت","وَرَدد الوادي صَدى آها",52,"ا",3,0],["أوَ قَد جَهِلتَ مِنَ الحَدِيثِ رِوايَةً","أمْ قد نسيتَ مِنَ الكتاب نُزُولا",53,"ل",2,0],["أو قَرقَفٍ ممّا تنشّى الرّومَ لا","نَشَواتُها ذُمّتْ ولا نَشوانُها",54,"ن",3,0],["أَو قُلتَ ما تَقولُ قالَ شَرّا","أَصلاهُ رَبّي لَهَباً وَجَمرا",55,"ر",2,0],["أَو قائِلٍ يُخبِرُها حالِفاً","أَن لَيسَ مِنها بِيَ مِن باسِ",56,"س",1,0],["أَو قُبلَةٌ في خِلالِ ذاكَ وَلا","بَأَسَ إِذا لَم تُحلَّلِ الأُزُرُ",57,"ر",1,0],["أَوقاتُ عاجِلَةٍ كَأَنَّ مُضِيَّها","وَمضُ البُروقِ خَواطِفاً لَمَعاتُها",58,"ت",3,0],["أَوقَدتَ ناراً بِإِفتِكارَكَ أَظهَرَت","نَهجاً وَأَنتَ عَلى سَناها عاشِ",59,"ش",1,1],["أَو قيلَ لِلنارِ خُصّي مَن جَنى أَكَلَت","أَجسادَهُم وَأَبَت أَكلَ السَرابيلِ",60,"ل",1,0],["أَو قُل هُمُ قاتَلُوا شَهباءَ مُضلِعَةً","قَد قَذَفَت في قُلُوبِ الناسِ أَهوالا",61,"ل",2,0],["أوقوفاً إلى الصباح ببابي","شدَّ ما جِئتِهِ غباءً وجهلا",62,"ل",2,0],["أو قيّم الدين ولا أحابي","وقيّم الدنيا من الصحاب",63,"ب",1,0],["أَو قلتُ بدراً رأيتُ البدرَ مُنْتقصاً","فقلتُ شَتَّانَ ما بينَ البُدَيرينِ",64,"ن",1,0],["أَوْقَعْتَ نَفْسَكَ فِي حَبَائِلِ خُدْعَةٍ","لا تُسْتَقَالُ فَخُذ لِنَفْسِكَ أَوْ دَعِ",65,"ع",1,0],["أَوَقَفْتَ تَعْجَبُ مِنْ صَنِيعِ اللهِ فِي","لبْنانَ بيْنَ شَوَامِخٍ وَوِهَادِ",66,"د",1,0],["أَوْ قَلَمٍ كَاتِبٍ وَصَوْتٍ","مُرَدِّدٍ مَا إِلَيْكَ أُوحِي",67,"ح",2,0],["أو قيل: إنَّ العالمين عناصرٌ","فهمو همو حسبًا، وطيبَ نِجار",68,"ر",1,0],["أو قوام كأنه الغصنُ لدْنٌ","أو فتور في جفنها الوسنان",69,"ن",1,0],["أوقفتَ للصَّرعى نهاراً دائبا","وسهِرْتَ ليلاً \" نابِغيّاً \" ناصبا",70,"ب",2,0],["أو قلتَ مثل الشمس لم تُعادِل","مُهتزَّة ٍ فوق كثيبٍ هائِل",71,"ل",1,0]]}