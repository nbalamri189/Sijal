َرتْ في المحلِ أيديهُمُ","بانت بها آثارُ بُخل الغيومْ",169,"م",1,0],["أو قَصُرتْ بُوعُ قناها نُطْتَها","بساعدٍ يَذرَع في تمامِها",170,"م",3,0],["أو قائلٍ في الدين فَعّالٍ إذا","قال المفقّه فيه ما لم يفعل",171,"ل",1,0],["أوقرت المزنُ العيابَ وسرت","فوضعتْ حُمولَها بحَوْمَلِ",172,"ل",1,0],["أوقصُ يبغي طلعةً","على قُصاص الأتلعِ",173,"ع",1,0],["أو قلتُ معتاضاً بجارٍ مثله","جارٌ ولا بالدار بعدك دارُ",174,"ر",1,0],["أوقِدْ بذي السَّمُراتِ لي","فقد استغمَّ مُنارُها",175,"ر",3,0],["أوْقَرُ من نادمني عِندها","ذو سَفهٍ من شأنه الهُجرُ",176,"ر",1,0],["أوقاتُ لهوٍ حميداتٌ سَعِدْتُ بها","بفاترِ الجفنِ ساجي اللحظِ فتّانِ",177,"ن",1,0],["أوقفت نفسك للبلاد وأهلهما","لهفي عليك كذا الرجال الكمل",178,"ل",1,0],["أو قرتها ما تميد الشاهقات به يسري","بها الرتل أو يشدو بها الحادي",179,"د",2,0],["أوقدت فينا ألوان نار","وقلت إياك أن تبوح",180,"ح",1,0],["أَو قارِحاً مِثلَ القَناةِ طِمِرَّةً","شَوهاءَ تَعتَبِطُ المُدِلَّ الأَحقَبا",181,"ب",2,0],["أو قِيلَ للمِقدارِ أين سهامُه","كانت إشارتُه إلى آرائهِ",182,"ا",3,0],["أوقاتُ أنسٍ كالعرائِسِ بهجةً","يا ليتَها بالبَيْنِ لا تتزوّجُ",183,"ج",1,0],["أوقاتُ أُنْس كأنّ الدهرَ أغفلَها","أو من صُروفِ الليالي ما عرَفْناها",184,"ا",3,0],["أوقاتُ أُنسٍ كسَتْ وجهَ الزّمانِ سنىً","كأنّما هُنّ أقمارٌ بظُلمتِهِ",185,"ت",2,0],["أوقرته بالبر بل وقرته","حتى اشتكى ثقل التقى فقاره",186,"ر",2,0],["أوقعت نفسي جاهلاً","في دار سعد الافتخاري",187,"ر",2,0],["أوقات فكري كلها مشغولة","بمدحه ولست من أشغاله",188,"ل",2,0],["أَوْ قُرْبَةٍ في الدّينِ أو مَقْصدٍ","يَأْتيكَ بَعْد الموت بالمغْنَمِ",189,"م",1,0],["أو قُدْرَة يُمْكِنُني عِنْدَها","أنْ أَحْمِلَ الْخَلْقَ على الْحَقِّ",190,"ق",1,0],["أَو قُلْ بِقَوْلِ الحازِمِي","فَذَاكَ أَيُّ جازِمِ",191,"م",1,0],["أو قُلْتَ دَعْوَى الاِجْتِهادِ سَقِيمَةٌ","فَسَلِ المعارِفَ لا أبا لَكَ تَرْشُدِ",192,"د",1,0],["أَوْقَاتُهُمْ ذَهَبَتْ في غَيْرِ مَكْرُمَةٍ","فاسْتَبْشروا قَدْ أَتَاكُمْ طِيبُ أَوْقاتِي",193,"ت",2,0],["أو قيلَ مَن غَريقُ بَحرِ جُودِه","لَصَاح كلٌّ كلُّنا ذُو غَرَق",194,"ق",1,0],["أو قدَمٍ لم تزل لِلمَجدِ ساعيةً","هيهاتَ يُغبَنُ فيها المَجدُ مِن قَدَمِ",195,"م",1,0],["أو قَدَمٍ لم تَزَل للمَجدِ ساعيَةً","إن دمِلتُ فَقُلوبُ الناسِ تَندَمِلُ",196,"ل",1,0],["أَو قطَّعَ الأَكحَل المغترّ قاطِعهُ","أعذرتُ فيهِ وَلَم أَحفَل لِتَغريرِ",197,"ر",1,0],["أوقَدْتَه حتّى اِستَطار شرارُه","وغمرتَ فيه فَيْلقاً في فَيْلَقِ",198,"ق",1,0],["أَوْقَدتها بعدَ الخبوِّ فما لها","أَبَدَ الزّمانِ تطامنٌ وخمودُ",199,"د",1,0],["أَو قوّمتْ أيّامُهُ خِبْرَتِي","فبالّذي طَأْطأ من صَعْدَتِي",200,"ي",1,0],["أو قلتَ ذا صعب على همتي","فأنت في كذب وبهتان",201,"ن",1,0],["أو قلت إن الوجود غير ال","موجود والغير غير أصل",202,"ل",1,0],["أُوقِدَت يا كُلَيبُ بعدَك نارٌ","سالَ منها في الحيِّ قلبُ الجَمادِ",203,"د",1,0],["أو قال كل واحد منهم أنا","أحق بالإمرة ممن ههنا",204,"ن",2,0],["أو قال قوم فهلموا نقترع","وقال قوم نحن لسنا ننتزع",204,"ع",1,0],["أو قد رأى كل امرئ ممن حضر","رأيا فما تأتي وما الذي تذر",204,"ر",1,0],["أو قبل يوم العيد أو من بعده","أو حد في الآذان غير حده",204,"ه",1,0],["أَوقد الحسنُ فوقَ خدَّيكِ نارا","وأَطارَ الدُّموعَ مِنِّي شَرارَا",205,"ر",2,1],["او قهقه الرعد في هدباء مدحته","أو ناح طير على الأغصان أزمانا",206,"ن",2,0],["أَو قائِلٍ يا فارِسا","ماذا رُزئتُ مِنَ الفَوارِس",207,"س",1,0]]}