],["أَو قيلَ مَوسِمُ عِزٍّ وَسِمِّهِ حَسَنِ","في وَجنَةِ الدَهرِ لا يَعروهُ تَغبيرِ",131,"ر",1,0],["أو قرّبي الخطوا","من ظلمة الرمس",132,"س",1,0],["أو قطعة من لهيب بن أردية","من الرماد شبيهات باسمال",133,"ل",1,0],["أَوقَعَ القَلبَ في حِبالِكَ بِالإِقدا","مِ طَرفٌ إِلى المَلاحِ جَموحُ",134,"ح",1,0],["أَوقُلتَ في وَفي سِوا","يَ حَصَرتَهُ في أَينِهِ",135,"ن",2,0],["أَو قُلتَ عَيني عَينُهُ","فَالعَجزُ بُؤتَ بِبَينِهِ",135,"ن",2,0],["أَوقات أنسٍ إِذا ما بتّ أَذكُرُها","ألفَيت مِنها خَيالاً لُبّيَ اِختَطَفا",136,"ف",2,0],["أَو قام داعي التَهاني وَهوَ يُنشدهُ","ليهن ورقَ الحِمى في الأيك تَغريدُ",137,"د",1,0],["أَو قُلتُ فَرع زَكّى","فَالاِصل تاج مُكَرّم",138,"م",1,0],["أَو قارِحٌ في الغُرابِيّاتِ ذُو نَسَبٍ","وَفي الجِراءِ مِسَحُّ الشَدِّ إِجفيلُ",139,"ل",1,1],["أو قامَ لنَصْرِ مُخالِفه","فالجَدُّ الخاذِلُ يُقْعِده",140,"د",2,0],["أَو قُلتُ يَحكونَ الظِبا","ءِ فَلَم أُرِد إِلّا النُفورا",141,"ر",2,0],["أَو قُلتَ ريقَتُها المُدا","مُ فَلَم تَذُق مِنها الثُغورا",141,"ر",2,0],["أَوقَفتَ مِن خَطَراتِهِ بِمِنى المُنى","أَفَما تَخافُ هُناكَ رَميَ الجَمرَةِ",142,"ه",1,0],["أَوقَدَ نارَينِ القِرى وَالوَغى","فَهَذِهِ تُغشى وَذي تُخشى",143,"ش",2,0],["أَوقَعتَهُ لِلحينِ في يَدِ قائِفِ","لا يُلحِقُ الأَنسابَ بِالتَمويهِ",144,"ه",1,0],["أو قَطَّبَ الدَّهرُ فابنُ بِشرٍ","يَلقاكَ من وَجههِ أبُوهُ",145,"و",2,0],["أو قبلَ أن يروي بسيبِ يَمينِه","عَطَشي ويَملأ بعدَ ذاكَ حياضي",146,"ض",2,0],["أو قلت قد خضعوا فتَصدِقُ إنهم","خضعوا ولكن للشقِيْ المسكين",147,"ن",1,0],["أو قلت بدراً فالخسوف يَشينه","أما سناكِ فكلَّ يومٍ يُضرَم",148,"م",1,0],["أو قلت نجماً فالكواكب كلها","تجثو لديكِ بإحتشامٍ يَكرُم",148,"م",1,0],["أو قلت كاروبيمَ عرشِ إلهِنا","فسموُّهم بسمو شانك يُهضَم",148,"م",1,0],["أو قلت ساروفيمَ طُغماتِ السما","لولا وليدُك ما سموا وتعظموا",148,"م",3,0],["أو قلت جبرائيلَ بين جنوده","فنراه نحوك بالرسالة يَخدِم",148,"م",1,0],["أو قلت مخائيلَ يوم قِراعِه","إبليسَ لكن من علاك يترجم",148,"م",1,0],["أو قلت طُغماتِ الملائك كلهم","لكن سناهم مع بهائك مظلم",148,"م",1,0],["أو قال إن الممات مركبها","أجبت