{"poems":[[53,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[46,"قل للأمير الأريحي الذي","https://www.aldiwan.net/poem30521.html","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60844","الكامل"],[6178,"قبلة ماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85528&r=&rc=4",""]],"verses":[["ذا ثراء مُبذَّرٍ في العطايا","دون عِرض موفَّرٍ مجموع",0,"ع",1,0],["ذا ثَروَةٍ يَطلُبُ مِن سائِلٍ","وَمُفحَماً يَأخُذُ مِن شاعِرِ",1,"ر",1,0],["ذَا ثَابتٌ عَن مَالِكٍ مَن رَدَّهُ","فَلَسَوفَ يَلقَى مَالِكاً بِهَوَانِ",2,"ن",1,0],["ذا ثالث القمرين هذا ثالث العمرين","هذا أعظمُ العظماء",3,"ا",2,0],["ذا ثغرها المرسوم نهر تورد","كالموعد الموشوح بالحمراء",4,"ا",2,0],["ذا ثغرك العفوي ثغر طفولة","لغة تشبّ وفكرة استقصاء",4,"ا",2,0]]}