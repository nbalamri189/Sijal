{"poems":[[75,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[62,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[93,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[93,"بات والكأس في الظلام","https://www.aldiwan.net/poem62746.html","عموديه"],[87,"بالله يا نسمات النيل في السحر","https://www.aldiwan.net/poem63666.html","البسيط"],[45,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[64,"أصالة الرأي صانتني ( لامية العجم )","https://www.aldiwan.net/poem52315.html","البسيط"],[46,"لا آكل التفاح دهري ولو","https://www.aldiwan.net/poem30260.html","السريع"],[71,"سبحان من سخر لي حاسدي","https://www.aldiwan.net/poem28777.html","السريع"],[107,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[52,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147462","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[62,"","https://poetry.dctabudhabi.ae/diwan/poem/76205","البسيط"],[92,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[92,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[215,"يا جنة الخلد كيف يشقى","https://www.aldiwan.net/poem46558.html","مخلع البسيط"],[303,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[325,"كانت دمنهور لنا","https://www.aldiwan.net/poem61672.html","مجزوء الكامل"],[412,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[422,"نبهت للنأي عيون الرفاق","https://www.aldiwan.net/poem53892.html","السريع"],[435,"ما للمعالي تفيض الدمع مدرارا","https://www.aldiwan.net/poem38732.html","البسيط"],[438,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[443,"أمّا الخليط فبان غير مودع","https://www.aldiwan.net/poem2555.html","الكامل"],[454,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[487,"ظبي خزّ بلحاظه","https://www.aldiwan.net/poem24369.html","عموديه"],[487,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122573","البسيط"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/79627","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38412","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59239","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96739","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64670","البسيط"],[1335,"","https://poetry.dctabudhabi.ae/diwan/poem/198670","السريع"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205623","البسيط"],[215,"","https://poetry.dctabudhabi.ae/diwan/poem/116165","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108614","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101592","المنسرح"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45440","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53238","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77327","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106854","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68020","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34661","المنسرح"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133249","البسيط"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44902","البسيط"],[4021,"","https://poetry.dctabudhabi.ae/diwan/poem/143119","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101374","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33293","السريع"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119553","البسيط"],[4755,"مِلْ أَيُّها المَاءُ واكْبَح سَوْرَةَ الحُطَمَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=197775",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5183,"إلى الباكستان","https://www.poetsgate.com/ViewPoem.aspx?id=185671",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5921,"يا قاتلي ظلما بلا زلة ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=188705",""],[5956,"محبوبُ القطرين","https://www.poetsgate.com/ViewPoem.aspx?id=193589",""],[6045,"وجمة غضب ونغمة طرب","https://www.poetsgate.com/ViewPoem.aspx?id=162864",""],[6108,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192747",""],[454,"يئس الصغار من الكبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82661&r=&rc=25",""]],"verses":[["لا أَكؤُسُ الراحِ تُبدي مِن شَمائِلِنا","سِيَما اِرتِياحٍ وَلا الأَوتارُ تُلهينا",0,"ن",2,0],["لا أَكُذب اللَهَ ثوبُ الصَبرِ مُنخَرقٌ","عَنّي بِفُرقَتِهِ لَكِن أَرَقِّعُهُ",1,"ع",2,0],["لا أَكتَفي وَأَخافُ أَنّي أَكتَفي","فَكَأَنَّما في الاِكتِفاءِ حِمامي",2,"م",2,0],["لا اِكتِئابٌ وَلا رِضى","لا بُكاءٌ وَلا اِبتِسام",3,"م",1,0],["لا أَكذِبُ اللَهَ كانَ النَجمُ رابِعَنا","لَو يُذكَرُ النَجمُ بَعدَ البَدرِ في خَبَرِ",4,"ر",1,0],["لا أَكسِبُ الذِكرَ إِلّا مِن مَضارِبِهِ","أَو مِن سِنانٍ أَصَمِّ الكَعبِ مُعتَدِلِ",5,"ل",1,0],["لا أكرهُ الطعنةَ النجلاءَ قد شُفِعَتْ","برشقةٍ من نِبالِ الأعيُنِ النُّجُلِ",6,"ل",1,0],["لا آكُلُ التُفاحَ دَهري وَلَو","جَنَيتَهُ لي مِن جِنانِ الخُلودِ",7,"د",1,1],["لا أكرهُ الغيبةَ منْ حاسدٍ","يفيدني الشهرةَ والأجرا",8,"ر",2,0],["لا أكفُرُ اللهَ بعضُ البُؤسِ مَنقبةٌ","للفاضلينَ وبعضُ الرزقِ حرمانُ",9,"ن",1,0],["لا أَكتُمُ الناسَ حُبَّ قاتِلَتي","لا لا وَلا أَكرَهُ الَّذي ذَكَروا",10,"ر",3,0],["لا أَكبر الأشياءَ لَي","ست في العَواقِب تثمر",11,"ر",1,0],["لا آكل الحيوان الدهر مأثرة","أخاف من سوء أعمالي وآمالي",12,"ل",2,0],["لا أكذب الله قد أضحت كنوزكم","لصرح طغيانه الأركان والعمدا",13,"د",2,0],["لا أكذب الله من أموالكم صقلت","خناجر طعنت حريّتي ومدى",13,"د",2,0],["لا أَكُذبث اللَهَ ثوبُ الصَبرِ مُنخَرقٌ","عَنّي بِفُرقَتِهِ لَكِن أَرَقِّعُهُ",14,"ع",2,0],["لا أكذبَنّكِ إنّني بَشَرٌ","جَمُّ المساوي آثِمٌ أشِرُ",15,"ر",1,1],["لا أكتفي بالروحِ أُزْهِقُها","عُذرا اليكِ فكيف أعتذر",15,"ر",1,0],["لا أكذبنَّكَ إنَّ الحُبَّ متَّهمٌ","بالجَور يأخذ مِنَّا فوقَ ما وَهبا",16,"ب",2,0],["لا أكؤسُ الحب دائرتٌ","ولا عيون المها تحيب",17,"ب",1,0],["لا أَكذب اللهَ فما","في عيشِنا من أَرب",18,"ب",1,0],["لا أَكونُ أَوَّلَ آمِنٍ","وَأَكونُ آخِرَ مَن يُجازِفِ",19,"ف",1,0],["لا أَكفُرُ الطَيف نُعمى اِنشرَت رَمَماً","مِنا كَما تَفعَل الأَرواح بِالرِمَمِ",20,"م",1,0],["لا اكتحلت أَجفانكم بالكرى","ولا تَصَدَّيْتُم إلى غير شاق",21,"ق",1,0],["لا أكتفي بالبكا حولاً كمعتذر","لكن سأبكيهِ أحوالاً واعصارا",22,"ر",2,0],["لا أكفُرُ الليلَ وإحسانِهُ","وإن دعاهُ الناسُ بالكافرِ",23,"ر",1,0],["لا اكفر النعماء منك وإنما","قابلتها بقصائد لم تسمع",24,"ع",1,0],["لا أكتم العذراء أن جماله","أورى زناد قريحة المتواري",25,"ر",2,0],["لا أكتفي بوصاله","لو دار دهر الدهر زائر",26,"ر",1,0],["لا أكتفي لا أكتفي","بوصاله دهري معان",27,"ن",1,0],["لا أكذبُ اللهَ في نَفسي مَحَبَّتُهُم","عني أأجحدُ شيئا ليس يَنجحِد",28,"د",1,0],["لا آكُلُ المَيْتَةَ ما عَمَّرَتْ","نفسي وإن أبرحَ إِمْلاقِي",29,"ي",1,1],["لا أَكرَهُ المَوتَ حتّى ذاكَ يَمنَعُني","وَكَيفَ أَرهَبُ لَمحَ البيض في الكللِ",30,"ل",1,0],["لا أَكتُمُ العشقَ كَيفَ العِشق أَكتُمُهُ","وَبي شُهودُ الهَوى وَالعِشق تَفضَحُني",31,"ن",2,0],["لاَ أكْذِبُ اللَّهَ ثَوْبُ الصَّبْرِ مُنْقَطِعٌ","لَكِنْ أرَقِّعُهُ إنْ جَادَ بِالْعَطْفِ",32,"ف",1,0],["لا أكتمُ الحبّ إنّ الحبّ مذهبهُ","مصرّح لَم يغالب فيه كتمانُ",33,"ن",1,0],["لا أَكذبنَّكَ في رأيٍ أُشيرُ به","حاشا وكلاَّ ولا رأيَ لمكذوبِ",34,"ب",1,0],["لا آكل المرقاس دهري لتأ","ويل الورى فيه قبيح العيان",35,"ن",1,1],["لا أكذب الله كم فينا ذوو شمم","إذا أريدت بهم مكروهة فزعوا",36,"ع",3,0],["لا أكذب الله قد قاموا وقد أجهروا","بالحق لو أن صوت الحق يستمع",36,"ع",1,0],["لا أكؤسُ الحب دائراتٌ","ولا عيون المها تجيب",37,"ب",1,0],["لا أكذبنك يا عزيزة فاتني","زمن الصبا وعرا الشباب همود",38,"د",1,0],["لا أكذب اللَه إن لي شيما","تحمي فمي من شوائب الملق",39,"ق",1,0],["لا أُكثِرُ القَولَ فيما يَنهَضونَ بِهِ","مِنَ الكَلامِ قَليلٌ مِنهُ يَكفيني",40,"ن",2,0],["لا أكف الكرام تهمي في","رتاد حياها ولا الوجوه حييّه",41,"ي",2,0],["لا أَكذِبُ الوَصفَ بَدرُ التَمِّ يَعشَقُهُ","وَالشَمسُ رَأدَ الضُحى مِن أَطوَعِ الخَدَمِ",42,"م",1,0],["لا أكذبُ اللَه فقدتُ الرمقا","ولاشت الأيامُ قلبي النزقا",43,"ق",2,1],["لا أَكذِب اللهَ مَا فِي الأرض من ملكٍ","إِلاَّ وعن جودِه بالعجز معترِف",44,"ف",1,0],["لا أكفرُ السيلحين أزمنةً","مُطيعةً بالنعيم والنِّعَم",45,"م",1,0],["لا أكذب الله قلبي بالنقا ولع","مهما بعدت فإني لست أنساه",46,"ا",2,0],["لا أكذب الله شوقى نحو طيبته","لا أستطيع مدى الأيام إضماره",47,"ر",2,0],["لا أَكذِبُ اللَهَ قَد اَسرفتُ في طَمَعي","وَقَد أَمَنتُكَ إِذ قَدَّمتَ لي يَدكا",48,"ك",2,0],["لا أكذِبُ الله ما لي غير حِبّكُمُ","والاستزادةِ من وجدٍ بكم شُغُلُ",49,"ل",1,0],["لا أكثر اللَه من قومي ولا عددي","إن لم يكونوا لدى دفع الخطوب يدي",50,"د",2,1],["لا أكذبُ الله ولكنني","آخِذُ من حسادهِ حذري",51,"ر",2,0],["لا أكذبُ اللّه ما نفسي بسالية","ولا خليقةُ أهل الغدر من خلقي",52,"ق",2,0],["لا أَكتُبُ الشِّعرَ إِلَّا باكِيًا فإذا","كَتَبتُهُ غَيرَ باكٍ زَادَنِي عَتَمَة",53,"م",2,0],["لا أكتم ُ السر َّ قاطعْنا بضاعَتَهم","وراح َ يضحك ُ منّا الخوف ُ والرّهَب ُ",54,"ب",1,0],["لا أكذب الجد لكني أغالطه","أن الأصالة شئ من معانيه",55,"ي",2,0],["لا أكتمنك حد المغرب انعقدت","حولى ظلالك تغرينى وتعتصم",56,"م",1,0],["لا أكذبنَّكَ إني كنتُ ذا شَغَفٍ","بالغِيدِ أجهَلُ مافيهنَّ مِن نظرِ",57,"ر",1,0],["لا أكذبنك أني مجهض شجناً","ولهفةً وانكساراتٍ بها وبِلا",58,"ل",2,0],["لا اكتحلت عيناي إن أبصرت","غيرك في العالم إلا عمى",59,"م",2,0],["لا أكذب إلا لعدوّ","ينوي تخريبَ القطرينْ..",60,"ن",1,0],["لا أكذب الله في الأيام مقتبل","من الأماني ولمّا نعدم النجبا",61,"ب",2,0],["لا أكره الدنيا ولستُ أحبّها","وألومُ نفسي كي أظلّ سَويّا",62,"ي",2,0],["لا أكتم العذراء أن جمالها","أورى زناد قريحة المتواري",63,"ر",2,0]]}