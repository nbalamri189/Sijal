ViewPoem.aspx?id=214721",""],[5851,"ضوء قراح","https://www.poetsgate.com/ViewPoem.aspx?id=175304",""],[5897,"صبراً .. دمّاج","https://www.poetsgate.com/ViewPoem.aspx?id=156532",""],[5956,"حديث الورود","https://www.poetsgate.com/ViewPoem.aspx?id=182337",""],[6019,"نبضاتٌ في حضرة الأمير (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=53829",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5724,"مآتم الظلم تتلوهن أعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55142&r=&rc=9",""],[6190,"في موكب العطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87009&r=&rc=15",""],[6233,"إعلام ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78460&r=&rc=23",""],[463,"يا وحشة َ المجدِ ثقي بالأنسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60105&r=&rc=161",""],[5126,"مُوجز حياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87813&r=&rc=28",""],[5190,"غيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78340&r=&rc=53",""],[147,"بقيتَ وَلا عزتْ عليكَ المطالبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27439&r=&rc=6",""]],"verses":[["وَحُطّوا بِهِ رَحلَ المَكارِمِ وَالعُلى","وَكُبّوا الجِفانَ عِندَهُ وَالمقارِيا",0,"ي",2,0],["وَحُطّا لِجامي في قَذالِ طِمِرَّةٍ","كَأَنَّ بِها مِن مَيعَةِ الشَدِّ أَولَقا",1,"ق",2,0],["وَحُطَّ بِهِنَّ الرَحلُ تَدمى صِفاحُهُ","كَما أَفرَدَ الحَيُّ الأَجَبَّ المُوَقَّعا",2,"ع",2,0],["وَحُطَّا لَهَا بَيْنَ الْحَطِيمِ وَزَمْزِمٍ","رِحَالاَ مِنَ الْبُشْرَى مِلاَءَ الْحَقَائِبِ",3,"ب",1,0],["وَحَطَّ وُحوشَ صاحَةَ مِن ذُراها","كَأَنَّ وُعولَها رُمكُ الجِمالِ",4,"ل",1,0],["وحططت للكندِي تاج تملك","عن جبهةٍ من قبلها لا تجبه",5,"ه",1,0],["وَحَطَّتكَ روحي بَينَ جِلدي وَأَعظُمي","فَكَيفَ تُراني إِن فَقَدتُكَ أَصنَعُ",6,"ع",1,0],["وَحَطَّه وَالشَمسُ في الأَبراجِ","لَكِنَّهُ مِنهُ عَلى الزُجاجِ",7,"ج",1,0],["وَحَطَّمتُ أَقداحي وَلَمّا أَرتَوِ","وَعَفَفتُ عَن زادي وَلَمّا أَشبَعِ",8,"ع",1,0],["وحُطَّت بساحاتي ابتغاء رسومها","بضائع للتجار تشقى الأهاليا",9,"ي",2,0],["وحَطَطْتُ مَنزِلَةَ العَدُوِّ بِمِقْوَلٍ","كشَبا الأَسِنَّةِ رافعٍ حَطَّاطِ",10,"ط",1,0],["وَحَطَّهُ بَعدَ سُمُوٍّ بِهِ","قَسراً إِلى أَخبَثِ أَحوالِهِ",11,"ل",2,0],["وَحُطتَ بِالعَدلِ أَهلَ الأَرضِ كُلَّهُمُ","كَأَنَّما الناسُ أَبناءٌ وَأَنتَ أَبُ",12,"ب",1,0],["وحططنا رحلنا في واحةٍ","زادُنا فيها الأماني والذكر",13,"ر",1,0],["وَحَطَّ النَدى في الصامِتِيّينَ رَحلَهُ","وَكانَ زَماناً في عَدِيِّ بنِ أَخزَما",14,"م",2,0],["وَحَطَّ رِداءَ الغَيمِ عَن مَنكِبِ الصَبا","وَنَمَّ عَلى ذَيلُِ الدُجى نَفسُ الزَهرِ",15,"ر",1,0],["وَحَطَطتُ عَن بِنتِ الزِنادِ قِناعَها","لَيلاً لِسارٍ تَحتَهُ مَتَنَوِّرِ",16,"ر",1,0],["وَحَطَّ قِناعَ الصَبرِ وَاللَيلُ عاكِفٌ","فَأَفصَحَ دَمعٌ كانَ بِالأَمسِ أَعجَما",17,"م",2,0],["وَحَطّوا رَجائي في رَجا زَمزَمَ الصَفا","وَخَلّوا المُنى تَجمَع غَليلاً وَناقِعا",18,"ع",2,0],["وحَطَّمَ النَّباتَ والزُّروعا","وهَتكَ الرِّباع والرُّبوعا",19,"ع",2,0],["وَحَطّم بُنيانَ آماله","بِكَفّي لَئيمٍ خؤون رَهيب",20,"ب",1,0],["وَحُطّا عَلى الرَمضاءِ رَحلي فَإِنَّها","مَقيلي وَإِخفاقُ البُنودِ خِيامي",21,"م",2,0],["وحطّمتِ السلْمَ الْحُسامَ فلَم تَدَعْ","به بعدَ طولِ الفتكِ غيرَ الحمائلِ",22,"ل",1,0],["وحطّمتَ أغلالَ الإسارِ وقد لوتْ","يَدُ الدهرِ واستعصتْ طويلاً على الحَطْمِ",23,"م",1,0],["وحَطُّوا على جسر المنيَّة رَحلةُ","ومالوا به بُرجًا منيعًا مُشيَّدًا",24,"د",2,0],["وحُطَّ لها بين الحَطيمِ وزمزمِ","رجالا من البُشْرى مِلآء الحقائبِ",25,"ب",1,0],["وَحُطّ الأموالَ إذا ما كَثُرت","واجبُر كُسورَها إذا ما قَصُرَت",26,"ت",1,0],["وَحَطَّطَ أَحمَرَ بِالدَونَكَينِ","يغشَينَ مُعتَصِماتٍ تِعارا",27,"ر",2,0],["وحطَّمَ فَيدَه حَنَقاً","وطارَ مُيمَّما عَدنا",28,"ن",2,0],["وَحُط مَن أَتى بِالحَقِّ مِن عِندِ رَبِّهِ","بِصِدقٍ وَعَزمٍ لا تَكُن حَمزَ كافِرا",29,"ر",2,0],["وَحَطمهمُ سُمر الرِماحِ مَعَ الظبا","وَإِنفاذُهُم ما يَتَّقي كلُّ نابِلِ",30,"ل",1,0],["وحطتهُ من أعين ال","عالم بالسبعِ السور",31,"ر",1,0],["وَحططتُ أثقالي على أعتابهِ","وَلَزمتُ بعدَ اللَّه وجهة بابهِ",32,"ه",1,0],["وحُطْتَ مُلكَك حتى اشتدّ مَعقِلُه","عِزّا وطالت به في عصرِك الطِوَل",33,"ل",1,0],["وَحُطْتَ عِرْضِيَ بِسِتْرٍ مُسْبَلِ","وَكُنْتَ لِي يَا مَوْئِلِي نِعْمَ الْوَلِي",34,"ل",2,0],["وَحُطْنِي وَأَهْلِي مِنْ عِدَاتِكَ وَاسْقِنَا","بِسَجْلٍ مِنَ الإِحْسَانِ مُتَّسِعِ الْفَرْغِ",35,"غ",1,0],["وَحط بأسكَ عَن عَلياهُ مُرتَفِعاً","وَعزَّ جَيشُكَ قَهراً عِزّ طرخان",36,"ن",1,0],["وحططنا رحالنا في رحابٍ","ونهجنا سبل الحمى المنهوج",37,"ج",1,0],["وَحَطَطنا الرِحالَ في بابِ عِزٍّ","وَرَمَينا الأَثقالَ في خَيرِ فيِّ",38,"ي",1,0],["وَحطت بي الآمال في خير منزل","لَدى خير من يأوى اليه اديب",39,"ب",1,0],["وَحَطَت ببحبوح المَكارِم وَالرضا","لَدى سيد منه المَكارِم توهب",40,"ب",1,0],["وَحَطَّتْ بكَ اليَوم المَريةُ رَحْلَها","فَأَقْطَعَها رَغْداً مِنَ العَيْشِ أهْيَغَا",41,"غ",2,0],["وَحَطَّ يَفاعاً شامخَ الأنفِ رحلَهُ","عَلى الجَبلِ الراسي من الفخرِ لا الصَخرِ",42,"ر",1,0],["وَحَطَّ عَليَّ الدَّهْرُ أَثْقالَ لُؤْمِهِ","وَتِلْكَ الَّتِي يَعْيَا بِها الثَّقَلاَنِ",43,"ن",1,0],["وحط لثاما حجب اللثم عن فمي","فلا خير في اللذات من دونها سترُ",44,"ر",1,0],["وحط الرحل في حماها","في خير ربع وخير نادي",45,"د",2,0],["وحطاما قد عَضعَضَته الرزايا","يتنزّى مدامعا وأنينا",46,"ن",2,0],["وحططتَ عزم الدهر حتى قال لي","أن ليس لي نهجٌ لبأسك سالكا",47,"ك",2,0],["وحطّم أحلام الصفاء ولم يدع","لهم حُلُماً عذباً إذا طار رفرفا ؟",48,"ف",2,0],["وحَطِّي رحالَ الشكرِ عنِّي بِبابِهِ","بحيثُ اعْتِدا الآمالِ في المالِ حاكِمُ",49,"م",1,0],["وحُطّ رأسك واستغفر بلا سببٍ","وقُم على قدم الإنصافِ معتذِرا",50,"ر",2,0],["وحطَّ رَحْلَ الوغى عن ظهرِ صائِفَةٍ","شابَتْ رؤوسُ الأَعَادِي من وقائِعِها",51,"ع",3,0],["وحَطِّيَ رَحْلِي مِنْكَ بَيْنَ مَكارِمٍ","يُمَزِّقْنَ عَنِّي راكِدَ الظُّلَمِ الطُّمْسِ",52,"س",1,0],["وحط من مكوث عن","بلاد ثقلها أوهى",53,"ا",1,0],["وحطكم بين أعمال مخلّدة","وتضحيات لأبطال وشجعان",54,"ن",1,0],["وحطّ ظهرُ الشعر في","كم إصرَهُ وكَلَّهْ",55,"ل",2,0],["وحطَّت فادحَ الأثقال منه","بذي جنبين يحملها مطيقا",56,"ق",2,0],["وحطَّموا وَدَّاً وخلو هُبَلاً","مبدّلين بالعتيق الأملسِ",57,"س",1,0],["وحطمتَ آمالي فهنّ ضعائفٌ","وقَصَرتَ من هممي فهنّ صِغارُ",58,"ر",1,0],["وحُطْتَني أمناً وقد ثارَ لي","بالشرِّ صِلُّ الرملةِ الواقبُ",59,"ب",1,0],["وحطَّا على الرمضاء رحلي فإنها","مَقيلي وخفَّاقُ البنود خيامي",60,"م",2,0],["وحطوا على هضب السمك رحالهم","وحاطوا عقود المكرمات من الفصم",61,"م",1,0],["وحططت رحلي في رحابك علَّ أن","أمحو بحرمةِ جاهك الأوزارا",62,"ر",2,0],["وحطت به عن ذمة بن فليتة","وذمة أهل الأبطحين ذنوب",63,"ب",1,0],["وحَطْمُ اللدانِ وَوَخْزُ السّنانِ","وَلَيُّ الْعِنانِ وَرَكْضُ الْمِهارا",64,"ر",2,0],["وحَطباً بِمَرعى الآسفِي عُشبَ وَقدِه","فإن تَحتَ طِب طِب عيشةٌ حُلوُها مُرُّ",65,"ر",1,0],["وَحَطَّ العُصمَ يُهوِيها","ثجُوجٌ غَيرُ نَشّاحِ",66,"ح",1,0],["وحطمتُ في دفعي رداك أسنَّةً","فوق الجياد الضُّمَّراتِ السُّبَّقِ",67,"ق",1,0],["وحطامُ رزقك وهو جِدُّ مُصَرَّدٌ","في كلِّ يومٍ مِن محبٍّ كالفِ",68,"ف",1,0],["وحطّهمْ قَدَرٌ من بعد أن رُفعِتْ","منهمْ إلى قُلّةِ العلياءِ أقدارُ",69,"ر",1,0],["وحطَّ الرّجالَ الشُمَّ مِن كلِّ شامخٍ","يُلاقون بِالأيدي منَ الأرضِ جِلْدَها",70,"د",3,0],["وحطَّينا بسلطاني","يَةٍ علياء تجلو الغمّْ",71,"م",1,0],["وحطيمٌ محبُّها بغرام","صبّ ميزابه بفرط جلال",72,"ل",1,0],["وحُطَّ به رَحْلَ العنايةِ بُرْهةً","من الدّهرِ تَظْفَرْ بالنَّدى والتَكرُّمِ",73,"م",1,0],["وَحَطَّه وَالبَبَغاء في قَفَص","لِيلعَبا مَعاً وَيَنهَزا الفُرَص",74,"ص",1,0],["وَحَطَّ في الغيط بِأَعلى شَجره","وَاِجتَمَع الطَيرُ بِهِ لِتنظره",75,"ه",1,0],["وَحَط في عَينه تَعصير","وَادعا لَهُمُ عِندَ رَبَّه",76,"ه",1,0],["وحُطّ ذنوبي يا إلهي وأوزارِي","وأسألُك التوفيق في الدار والدارِ",77,"ر",1,0],["وحطا رحال البين بين رسومها","عسى أنني أقضي بها بعض أوطاري",78,"ر",2,0],["وحط واكلأ ولي العهد والطف","به واحرسه من كيد وعين",79,"ن",1,0],["وحط به حوزة الإسلام واحم به","معاقل الملك واهزم جيش أعداه",80,"ا",2,0],["وحط معانيه من عين الكمال فقد","تجمعت للمعالي فيه أشتات",81,"ت",1,0],["وحط المسلمين منك يعفو","بشمل المذنبين والأبرارا",82,"ر",2,0],["وَحَطَّ بِها أَكوارَ خوصٍ لَواغِبٍ","يُقلِلُ إِكثارُ الذَميلِ ذَميلَها",83,"ل",3,1],["وحطمت من سجون الشعب أنكرها","وضمخت بعبير النصر دنيانا",84,"ن",2,0],["وَحَطَبُ النارِ ثِقالٌ حُزَمُهْ","فَلمْ تَزَلْ تَرْأَبُهُ وَتَحْسِمُهْ",85,"م",2,