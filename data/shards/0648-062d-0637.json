{"poems":[[53,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[53,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[77,"ألا حدثاها فهي أم العجائب","https://www.aldiwan.net/poem36775.html","الطويل"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[64,"مكانك من قلبي هو القلب كله","https://www.aldiwan.net/poem67629.html","البسيط"],[91,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[89,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[61,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[49,"من جعل الدهر على باله","https://www.aldiwan.net/poem63091.html","السريع"],[66,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[97,"يا حبيب الروح يا روح الأماني","https://www.aldiwan.net/poem24800.html","الرمل"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[81,"تنازعني الآمال كهلا ويافعا","https://www.aldiwan.net/poem61463.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/70287","المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[77,"ألا حدِّثاها فهي أمُّ العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=33313",""],[112,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[128,"ألا تلك عرسي إذا أمعرت","https://www.aldiwan.net/poem24263.html","المتقارب"],[130,"ترى ما انت ماذا فيك","https://www.aldiwan.net/poem67445.html","مجزوء الوافر"],[135,"صبراً أبا يعلى على دين أحمد","https://www.aldiwan.net/poem21005.html","الطويل"],[135,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[161,"حصنت ذا الوجه الأغر","https://www.aldiwan.net/poem58781.html","مجزوء الرجز"],[190,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[230,"ما استحسن الحب حتى استقبح العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[238,"إني سألتك بخير مرسل","https://www.aldiwan.net/poem18868.html","الرجز"],[238,"لئن كان ورد الخد أبدع في الصبغ","https://www.aldiwan.net/poem19495.html","الطويل"],[253,"هذا هو السعي لا ما يدعي الواني","https://www.aldiwan.net/poem1430.html",""],[260,"شمس سعدي لاحت بسعد البروج","https://www.aldiwan.net/poem35954.html","الخفيف"],[260,"هزنا الشوق للمقام السني","https://www.aldiwan.net/poem35969.html","الخفيف"],[272,"إلى صارم الدين الفتى ابن محمد","https://www.aldiwan.net/poem52060.html","الطويل"],[272,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[276,"هو الفتح بعد الفتح يأتي مسوغا","https://www.aldiwan.net/poem25482.html","الطويل"],[276,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[281,"لك الخير قد أنحى علي زماني","https://www.aldiwan.net/poem60787.html","الطويل"],[304,"ألا فاسقني من ريقة لذ طعمها","https://www.aldiwan.net/poem57834.html","الطويل"],[305,"ما طاب قلبي ولا فؤادي","https://www.aldiwan.net/poem16779.html","مخلع البسيط"],[329,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[378,"أذكرت مسكا من مديحك صائكا","https://www.aldiwan.net/poem59303.html","الكامل"],[401,"وماذا لو تمادى ؟؟","https://www.aldiwan.net/poem6736.html","عموديه"],[410,"إذا ضاق بالخطي معترك الوغى","https://www.aldiwan.net/poem32163.html","الطويل"],[422,"ما لذة العيش إلا صحبة الفقرا","https://www.aldiwan.net/poem46403.html","البسيط"],[440,"قد عادت الشمس في أعلى مطالعها","https://www.aldiwan.net/poem34798.html","البسيط"],[440,"سلام على مستودع الروح والنفس","https://www.aldiwan.net/poem34839.html","الطويل"],[444,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[454,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[459,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[459,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[459,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[462,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[465,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[501,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[516,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[530,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[539,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[541,"ألم تأرق لضوء البرق","https://www.aldiwan.net/poem56864.html","الهزج"],[552,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[552,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[552,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[552,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"كعبة الحسن أسفرت بالجمال","https://www.aldiwan.net/poem34228.html","الخفيف"]],"verses":[["وَحُطّوا بِهِ رَحلَ المَكارِمِ وَالعُلى","وَكُبّوا الجِفانَ عِندَهُ وَالمقارِيا",0,"ي",2,0],["وَحُطّا لِجامي في قَذالِ طِمِرَّةٍ","كَأَنَّ بِها مِن مَيعَةِ الشَدِّ أَولَقا",1,"ق",2,0],["وَحُطَّ بِهِنَّ الرَحلُ تَدمى صِفاحُهُ","كَما أَفرَدَ الحَيُّ الأَجَبَّ المُوَقَّعا",2,"ع",2,0],["وَحُطَّا لَهَا بَيْنَ الْحَطِيمِ وَزَمْزِمٍ","رِحَالاَ مِنَ الْبُشْرَى مِلاَءَ الْحَقَائِبِ",3,"ب",1,0],["وَحَطَّ وُحوشَ صاحَةَ مِن ذُراها","كَأَنَّ وُعولَها رُمكُ الجِمالِ",4,"ل",1,0],["وحططت للكندِي تاج تملك","عن جبهةٍ من قبلها لا تجبه",5,"ه",1,0],["وَحَطَّتكَ روحي بَينَ جِلدي وَأَعظُمي","فَكَيفَ تُراني إِن فَقَدتُكَ أَصنَعُ",6,"ع",1,0],["وَحَطَّه وَالشَمسُ في الأَبراجِ","لَكِنَّهُ مِنهُ عَلى الزُجاجِ",7,"ج",1,0],["وَحَطَّمتُ أَقداحي وَلَمّا أَرتَوِ","وَعَفَفتُ عَن زادي وَلَمّا أَشبَعِ",8,"ع",1,0],["وحُطَّت بساحاتي ابتغاء رسومها","بضائع للتجار تشقى الأهاليا",9,"ي",2,0],["وحَطَطْتُ مَنزِلَةَ العَدُوِّ بِمِقْوَلٍ","كشَبا الأَسِنَّةِ رافعٍ حَطَّاطِ",10,"ط",1,0],["وَحَطَّهُ بَعدَ سُمُوٍّ بِهِ","قَسراً إِلى أَخبَثِ أَحوالِهِ",11,"ل",2,0],["وَحُطتَ بِالعَدلِ أَهلَ الأَرضِ كُلَّهُمُ","كَأَنَّما الناسُ أَبناءٌ وَأَنتَ أَبُ",12,"ب",1,0],["وحططنا رحلنا في واحةٍ","زادُنا فيها الأماني والذكر",13,"ر",1,0],["وَحَطَّ النَدى في الصامِتِيّينَ رَحلَهُ","وَكانَ زَماناً في عَدِيِّ بنِ أَخزَما",14,"م",2,0],["وَحَطَّ رِداءَ الغَيمِ عَن مَنكِبِ الصَبا","وَنَمَّ عَلى ذَيلُِ الدُجى نَفسُ الزَهرِ",15,"ر",1,0],["وَحَطَطتُ عَن بِنتِ الزِنادِ قِناعَها","لَيلاً لِسارٍ تَحتَهُ مَتَنَوِّرِ",16,"ر",1,0],["وَحَطَّ قِناعَ الصَبرِ وَاللَيلُ عاكِفٌ","فَأَفصَحَ دَمعٌ كانَ بِالأَمسِ أَعجَما",17,"م",2,0],["وَحَطّوا رَجائي في رَجا زَمزَمَ الصَفا","وَخَلّوا المُنى تَجمَع غَليلاً وَناقِعا",18,"ع",2,0],["وحَطَّمَ النَّباتَ والزُّروعا","وهَتكَ الرِّباع والرُّبوعا",19,"ع",2,0],["وَحَطّم بُنيانَ آماله","بِكَفّي لَئيمٍ خؤون رَهيب",20,"ب",1,0],["وَحُطّا عَلى الرَمضاءِ رَحلي فَإِنَّها","مَقيلي وَإِخفاقُ البُنودِ خِيامي",21,"م",2,0],["وحطّمتِ السلْمَ الْحُسامَ فلَم تَدَعْ","به بعدَ طولِ الفتكِ غيرَ الحمائلِ",22,"ل",1,0],["وحطّمتَ أغلالَ الإسارِ وقد لوتْ","يَدُ الدهرِ واستعصتْ طويلاً على الحَطْمِ",23,"م",1,0],["وحَطُّوا على جسر المنيَّة رَحلةُ","ومالوا به بُرجًا منيعًا مُشيَّدًا",24,"د",2,0],["وحُطَّ لها بين الحَطيمِ وزمزمِ","رجالا من البُشْرى مِلآء الحقائبِ",25,"ب",1,0],["وَحُطّ الأموالَ إذا ما كَثُرت","واجبُر كُسورَها إذا ما قَصُرَت",26,"ت",1,0],["وَحَطَّطَ أَحمَرَ بِالدَونَكَينِ","يغشَينَ مُعتَصِماتٍ تِعارا",27,"ر",2,0],["وحطَّمَ فَيدَه حَنَقاً","وطارَ مُيمَّما عَدنا",28,"ن",2,0],["وَحُط مَن أَتى بِالحَقِّ مِن عِندِ رَبِّهِ","بِصِدقٍ وَعَزمٍ لا تَكُن حَمزَ كافِرا",29,"ر",2,0],["وَحَطمهمُ سُمر الرِماحِ مَعَ الظبا","وَإِنفاذُهُم ما يَتَّقي كلُّ نابِلِ",30,"ل",1,0],["وحطتهُ من أعين ال","عالم بالسبعِ السور",31,"ر",1,0],["وَحططتُ أثقالي على أعتابهِ","وَلَزمتُ بعدَ اللَّه وجهة بابهِ",32,"ه",1,0],["وحُطْتَ مُلكَك حتى اشتدّ مَعقِلُه","عِزّا وطالت به في عصرِك الطِوَل",33,"ل",1,0],["وَحُطْتَ عِرْضِيَ بِسِتْرٍ مُسْبَلِ","وَكُنْتَ لِي يَا مَوْئِلِي نِعْمَ الْوَلِي",34,"ل",2,0],["وَحُطْنِي وَأَهْلِي مِنْ عِدَاتِكَ وَاسْقِنَا","بِسَجْلٍ مِنَ الإِحْسَانِ مُتَّسِعِ الْفَرْغِ",35,"غ",1,0],["وَحط بأسكَ عَن عَلياهُ مُرتَفِعاً","وَعزَّ جَيشُكَ قَهراً عِزّ طرخان",36,"ن",1,0],["وحططنا رحالنا في رحابٍ","ونهجنا سبل الحمى المنهوج",37,"ج",1,0],["وَحَطَطنا الرِحالَ في بابِ عِزٍّ","وَرَمَينا الأَثقالَ في خَيرِ فيِّ",38,"ي",1,0],["وَحطت بي الآمال في خير منزل","لَدى خير من يأوى اليه اديب",39,"ب",1,0],["وَحَطَت ببحبوح المَكارِم وَالرضا","لَدى سيد منه المَكارِم توهب",40,"ب",1,0],["وَحَطَّتْ بكَ اليَوم المَريةُ رَحْلَها","فَأَقْطَعَها رَغْداً مِنَ العَيْشِ أهْيَغَا",41,"غ",2,0],["وَحَطَّ يَفاعاً شامخَ الأنفِ رحلَهُ","عَلى الجَبلِ الراسي من الفخرِ لا الصَخرِ",42,"ر",1,0],["وَحَطَّ عَليَّ الدَّهْرُ أَثْقالَ لُؤْمِهِ","وَتِلْكَ الَّتِي يَعْيَا بِها الثَّقَلاَنِ",43,"ن",1,0],["وحط لثاما حجب اللثم عن فمي","فلا خير في اللذات من دونها سترُ",44,"ر",1,0],["وحط الرحل في حماها","في خير ربع وخير نادي",45,"د",2,0],["وحطاما قد عَضعَضَته الرزايا","يتنزّى مدامعا وأنينا",46,"ن",2,0],["وحططتَ عزم الدهر حتى قال لي","أن ليس لي نهجٌ لبأسك سالكا",47,"ك",2,0],["وحطّم أحلام الصفاء ولم يدع","لهم حُلُماً عذباً إذا طار رفرفا ؟",48,"ف",2,0],["وحَطِّي رحالَ الشكرِ عنِّي بِبابِهِ","بحيثُ اعْتِدا الآمالِ في المالِ حاكِمُ",49,"م",1,0],["وحُطّ رأسك واستغفر بلا سببٍ","وقُم على قدم الإنصافِ معتذِرا",50,"ر",2,0],["وحطَّ رَحْلَ الوغى عن ظهرِ صائِفَةٍ","شابَتْ رؤوسُ الأَعَادِي من وقائِعِها",51,"ع",3,0],["وحَطِّيَ رَحْلِي مِنْكَ بَيْنَ مَكارِمٍ","يُمَزِّقْنَ عَنِّي راكِدَ الظُّلَمِ الطُّمْسِ",52,"س",1,0],["وحط من مكوث عن","بلاد ثقلها أوهى",53,"ا",1,0],["وحطكم بين أعمال مخلّدة","وتضحيات لأبطال وشجعان",54,"ن",1,0],["وحطّ ظهرُ الشعر في","كم إصرَهُ وكَلَّهْ",55,"ل",2,0],["وحطَّت فادحَ الأثقال منه","بذي جنبين يحملها مطيقا",56,"ق",2,0],["وحطَّموا وَدَّاً وخلو هُبَلاً","مبدّلين بالعتيق الأملسِ",57,"س",1,0],["وحطمتَ آمالي فهنّ ضعائفٌ","وقَصَرتَ من هممي فهنّ صِغارُ",58,"ر",1,0],["وحُطْتَني أمناً وقد ثارَ لي","بالشرِّ صِلُّ الرملةِ الواقبُ",59,"ب",1,0],["وحطَّا على الرمضاء رحلي فإنها","مَقيلي وخفَّاقُ البنود خيامي",60,"م",2,0],["وحطوا على هضب السمك رحالهم","وحاطوا عقود المكرمات من الفصم",61,"م",1,0],["وحططت رحلي في رحابك علَّ أن","أمحو بحرمةِ جاهك الأوزارا",62,"ر",2,0],["وحطت به عن ذمة بن فليتة","وذمة أهل الأبطحين ذنوب",63,"ب",1,0],["وحَطْمُ اللدانِ وَوَخْزُ السّنانِ","وَلَيُّ الْعِنانِ وَرَكْضُ الْمِهارا",64,"ر",2,0],["وحَطباً بِمَرعى الآسفِي عُشبَ وَقدِه","فإن تَحتَ طِب طِب عيشةٌ حُلوُها مُرُّ",65,"ر",1,0],["وَحَطَّ العُصمَ يُهوِيها","ثجُوجٌ غَيرُ نَشّاحِ",66,"ح",1,0],["وحطمتُ في دفعي رداك أسنَّةً","فوق الجياد الضُّمَّراتِ السُّبَّقِ",67,"ق",1,0],["وحطامُ رزقك وهو جِدُّ مُصَرَّدٌ","في كلِّ يومٍ مِن محبٍّ كالفِ",68,"ف",1,0],["وحطّهمْ قَدَرٌ من بعد أن رُفعِتْ","منهمْ إلى قُلّةِ العلياءِ أقدارُ",69,"ر",1,0],["وحطَّ الرّجالَ الشُمَّ مِن كلِّ شامخٍ","يُلاقون بِالأيدي منَ الأرضِ جِلْدَها",70,"د",3,0],["وحطَّينا بسلطاني","يَةٍ علياء تجلو الغمّْ",71,"م",1,0],["وحطيمٌ محبُّها بغرام","صبّ ميزابه بفرط جلال",72,"ل",1,0]]}