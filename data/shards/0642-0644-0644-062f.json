{"poems":[[47,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[54,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122566","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63861","الخفيف"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122922","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49086","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92024","الرمل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34615","الرمل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117207","الخفيف"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117173","الخفيف"],[4423,"","https://poetry.dctabudhabi.ae/diwan/poem/124240","الخفيف"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119564","الخفيف"]],"verses":[["قُل لِداعي الغَمامِ لَبَّيكَ وَاِحلُل","عُقَلَ العيسِ كَي تُجيبَ الدُعاءَ",0,"ا",2,0],["قُل لِدُنيايَ قَد تَمَكَّنتِ مِنّي","فَاِفعَلي ما أَرَدتِ أَن تَفعَلي بي",1,"ب",2,0],["قل لدمع من الحماسة خلو","لست بين الدموع الا دعيا",2,"ي",2,0],["قُل لِدهري إنَّ اطِّراحَك حَقّي","ليس حَقّا فَجانِبِ الإطّراحا",3,"ح",2,0],["قلْ لداعي أبي الحسينِ لخطبٍ","قد رماه بذلَّةٍ بعد عِزَّه",4,"ز",2,0],["قل لداعي الصلاة أخر قليلا","قد قضينا حق الصلاة طويلا",5,"ل",2,1],["قلُ لدنْ أَرَّخُوا سناهُ مضيئاً","مدفنٌ للبدورِ من آلِ شمس",6,"س",1,0],["قُل لدنيانا كَفى ما قَد جَرى","صح أن الغي غَي الحاسد",7,"د",1,0],["قُل لدنيا أصبحَت تلعبُ بي","سلطَ اللَه عليكِ الآخرَه",8,"ه",1,1],["قُل لدُنيا باللَهِ لا تقطَعينا","واذكُرينا في بعضِ ما تَذكُرينا",9,"ن",2,1],["قُل لدُنيا إن لم تُجِبكَ لما بي","رطبَةٌ من دموعِ عَينَيَّ كُتبي",10,"ب",2,0],["قل لدنياي أبعدي وتولي","ان تريني فإنني لا أراك",11,"ك",1,1],["قل لداعي الفراق أخر قليلا","قد قضينا حق الصلاة طويلا",12,"ل",2,1]]}