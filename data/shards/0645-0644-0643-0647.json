{"poems":[[87,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[47,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[51,"كل امرئ فكما يدين يدان","https://www.aldiwan.net/poem63132.html","الكامل"],[71,"ملك هذا حبيبي أم ملك","https://www.aldiwan.net/poem28704.html","المتقارب"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[104,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55002","البسيط"],[159,"لحاظه تجلب الحتوفا","https://www.aldiwan.net/poem55624.html","مخلع البسيط"],[240,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[374,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[382,"ورد الله الرحيم","https://www.aldiwan.net/poem59269.html","مجزوء الرمل"],[415,"فئتي ألتجي إليه من الخطب","https://www.aldiwan.net/poem32208.html","الخفيف"],[438,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[463,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2445","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2452","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66809","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65015","الكامل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95075","الرجز"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84534","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204903","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115537","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101595","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121749","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112689","الرجز"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109944","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117895","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85166","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35651","المتدارك"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136927",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4583,"","https://poetry.dctabudhabi.ae/diwan/poem/130725","الكامل"],[4869,"ادف الليل","https://www.poetsgate.com/ViewPoem.aspx?id=151545",""],[463,"لله ساعٍ بلَّغتهُ قدمهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60179&r=&rc=235",""]],"verses":[["مُلكُ هَذا الجَوِّ في مَنعَتِهِ","طالَما لِلنَجمِ وَالطَيرِ اِستَقاما",0,"م",2,0],["مَلِكٌ هَصَرنا العَيشَ في جَنَباتِهِ","غَضَّ المَكاسِرِ لَيِّنَ الأَفنانِ",1,"ن",1,0],["مَلِكٌ هُوَ المَلِكُ الَّذي مِن حِلمِهِ","يُعصى بِحُسنِ بَلائِهِ وَيُخانُ",2,"ن",1,0],["مَلَكٌ هذا حبيبي أمْ ملكْ","أيُّ مَنْ هامَ بهذينِ هلكْ",3,"ك",1,1],["مُلكٌ هَوى بَينَ الكُؤوسِ جَنازَةً","وَمَضى عَلى نَعشٍ مِنَ الرَيحانِ",4,"ن",1,0],["مَلكة عرشها المشارق وَالتا","ج سَناها أَعظِم بِها شَرقيَّه",5,"ه",1,0],["مُلْكٌ هُوَ العَرَبِيُّ الْفَذُّ لَيْسَ لَه","صِنْوٌ وَفِيهِ شَتِيت الفَخْرِ مَجْمُوعُ",6,"ع",1,0],["مَلَّكَهُ حُبُّهُ قِيادِي","فَصَارَ في مُلْكِهِ عَنِيفا",7,"ف",2,0],["مَلَّكَهُ اللَهُ أَمرَ أُمَّتِهِ","وَكَفَّ عَنها بَوائِقَ النِقَمِ",8,"م",1,0],["مَلَّكَهُ الدُنيا فَفي كَفِّهِ","نِيابَةً عَنهُ المَقاليدُ",9,"د",1,0],["ملك همام حازم يقظ رضى","بحر غمام عالم ندسٌ نهي",10,"ه",2,0],["مُلكُهُ ملكُ نعيمٍ","وبه ثُلَّ الجحيم",11,"م",1,0],["مُلكُهُ ملْكُ رَحمةٍ وقضايَا","هُ بما جاءَنا بهِ التَّنزيلُ",12,"ل",1,0],["ملك هَزَّ عَزْمَهُ مُذْ تَوَلَّى","فَعَدُوٌّ وَلَّى وفَتْحٌ توالى",13,"ل",2,0],["ملَّكه السوددَ أصلٌ فارعٌ","فيها ورأيٌ بارعٌ يُتمِّمُهْ",14,"م",2,0],["ملكُه عنْ أَبِيه قَدْ أَكَّدت فيه","عَليهم عُقودُه وعُهودُه",15,"د",2,0],["مُلكُهُ مُلكُ قُوَّةٍ لَيسَ فيهِ","جَبَروتٌ وَلا بِهِ كِبرِياءُ",16,"ا",2,0],["مُلكُهُم صالِحٌ وَدَهرُهُمُ دَه","رٌ نَقِيٌّ وَشَرُّهُم غَيرُ عالي",17,"ل",2,0],["مُلكهمُ خمسونَ معدودةُ","برغمِ أنف الحاسدِ الراغمِ",18,"م",1,0],["مَلِكٌ هُمامٌ مِدْرَهٌ وَرثَ السُّطَا","والجودَ مِنْ مَلِكٍ هُمامٍ مِدْرَهِ",19,"ه",1,0],["ملكةٌ تَملكُ عُشَّاقاً لها","ولَم تَزَل بحُسنِها تأمُرُهُم",20,"م",1,1],["ملك هَذا الزَمان فخر البَرايا","أَحمد الرشد مالك الأَحكام",21,"م",1,0],["ملكها الأرض والفضاء فتبقى","حيث شاءت وحيث شاءت تطير",22,"ر",1,0],["ملكٌ هو البحر في هولٍ وفي كرم","طلقُ المحيّا حليمٌ عند قدرته",23,"ر",3,0],["ملكهُ ركنه الهواء وما أق","واهُ ركناً قام الخلود بدعمه",24,"م",2,0],["مَلَّكه الحُسْنُ قلوبَ الوَرى","واللّهُ يُؤْتِي مُلْكَه مَن يَشَا",25,"ش",2,0],["ملكه أمر رقاب الأمه","فزاد ذاك وزره وإثمه",26,"ه",1,0],["ملكه الله الزمان كله","ولا أزال ملكه وظله",27,"ه",1,0],["مَلكةُ الأَرضِ والسماواتِ أُمُّ اللَهِ","يحلو بمدحِها إِنشادي",28,"د",2,0],["ملك هو المأمون في آرائه","وعلى العدى المنصور والسفاح",29,"ح",1,0],["ملكة قدها عدل وناظرها الس","سفاح بالجور في العشاق يغريها",30,"ي",3,0],["مَلَكَة المرء يقال قد تنالْ","في حدّة الطبع الذي منه تنالْ",31,"ل",1,0],["مَلكُ هَطلت كَفّاه لَنا","بِحيا الجُودِ الجَود الهَتنِ",32,"ن",1,0],["ملكة إِثر ملكة تتهادى","ارايتَ الطاووس يمشي الهوينا",33,"ن",2,0],["ملكَهُ الحُسنُ القُلوبَ واعتَنَى","مِن بَسطَةِ المُلكِ لهُ بما اعتَنَى",34,"ا",1,0],["ملكٌ همامُ رأيهُ وسماحُهُ","بحرٌ وشمسٌ تطرُدُ الإظلاما",35,"م",2,0],["ملكة الخآفق وصآرت مفآتيحه هي احدآقي","واحسد بالعلن ربعك وكل من جلسته يمّك",36,"ك",1,0],["ملَّكه السوددَ أصلٌ فارعٌ","فيها وأيٌ بارعٌ يتمِّمهْ",37,"م",2,0]]}