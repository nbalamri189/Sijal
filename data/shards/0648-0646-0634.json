الصباح","https://www.aldiwan.net/poem67400.html","الخفيف"],[501,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[501,"رأت أطلال سلما بعد بعد","https://www.aldiwan.net/poem37688.html","الوافر"],[501,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[501,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[506,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[515,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[516,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[552,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[559,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[559,"رفعت ولم أرفع إلى غير منزلي","https://www.aldiwan.net/poem34215.html","الطويل"],[559,"أنا الخلق الجديد","https://www.aldiwan.net/poem34582.html","مجزوء الوافر"],[562,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[563,"نعاتب حيث لا نرجو الجوابا","https://www.aldiwan.net/poem52805.html","الوافر"],[568,"ما أبصرت عيني ولا عين أحد","https://www.aldiwan.net/poem69706.html","الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[576,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"]],"verses":[["وَنَشقَةٌ مِن نَسيمِ البانِ فاحَ بِها","جِنحٌ مِنَ اللَيلِ تَجري في العَرانينِ",0,"ن",1,0],["وَنَشاجَةٌ تَحتَ الضُلوعِ مُرِشَّةٌ","كَما هاعَ مَملوءٌ مِنَ الخَمرِ قالِسُ",1,"س",1,0],["وَنَشوانَ مِن خَمرِ النُعاسِ ذَعَرتُهُ","وَطَيفُ الكَرى في العَينِ يَطفو وَيَرسُبُ",2,"ب",1,0],["ونشقَةٍ مِن عَرارٍ هزَّ لِمَّتَهُ","رُوَيحَةٌ في سُراها مَسَّها لَغَبُ",3,"ب",1,0],["ونَشَدْتُ قَلبي حينَ عزَّ مَرامُهُ","إذ ضلَّ بينَ مَحاجِرٍ وعُيونِ",4,"ن",1,0],["ونَشْوانَةِ الأعْطافِ منْ تَرَفِ الصِّبَا","تُغيرُ وِشاحَيْها الخَلاخِيلُ والقُلْبُ",5,"ب",1,0],["ونَشوانَةِ الألْحاظِ يَمْرَحْنَ بالصِّبا","مِراضاً فإنْ ولّى خَلَقْنَ التّصابيا",6,"ي",2,0],["وَنَشَرتُ راياتِ المَذَلَّةِ فَوقَهُم","وَقَسَمتُ سَلبَهُمُ لِكُلِّ غَضَنفَرِ",7,"ر",1,0],["ونشَرْتَ رايَةَ عزِّهم منْ بعْدِما","دالَ الزّمانُ فسامَها تنْكيسا",8,"س",2,0],["وَنَشرَبُ إِن وَرَدنا الماءَ صَفو","وَيَشرَبُ غَيرُنا كَدَراً وَطينا",9,"ن",2,0],["وَنَشرَبُ حَتّى نَحسِبَ الخَيلَ حَولَن","نِقاداً وَحَتّى نَحسِبَ الجَونَ أَشقَرا",10,"ر",2,0],["وَنَشْءِ المَدارِسِ وَالقَائِمُونَ","بِنَشْرِ الفُنُونِ بِهَا وَالعُلُومِ",11,"م",1,0],["وَنَشوانَ مِن طولِ النُعاسِ كَأَنَّهُ","بِحَبلَينِ مِن مَشطونَةٍ يَتَرَجَّحُ",12,"ح",1,0],["ونشاط منه لبيض المساعي","مثل أشراعه لسمر العوالي",13,"ل",2,0],["وَنَشرُ ثَناءٍ لايَغِبُّ كَأَنَّما","بِهِ نَشَرَ العَصبَ اليَمانِيَّ ناشِرُ",14,"ر",1,0],["وَنَشرَبُها فَتَترُكُنا مُلوكاً","وَأُسداً ما يُنَهنِهُنا اللِقاءُ",15,"ا",2,0],["ونشرها من طيبها لم يفح","فاعْجب لسوءِ الطي والنشر",16,"ر",1,0],["ونشكر والأعضاء ألسنة ندى","يديك وندعو والزمان مواف",17,"ف",1,0],["ونشتكي الطير نعَّاباً بفرقتنا","وما طيور النوى إلاَّ مطاياك",18,"ك",1,0],["ونشيطةٌ الأعطاف إلا أنها","بجفونها لثياب سقمي تغزُّل",19,"ل",1,1],["ونشره نشرك لكنّهُ","دونك في الأصل وفي المَغرِس",20,"س",1,0],["ونشرت ميت العدل من جدث","قد كان فيه طال مهجعه",21,"ع",2,0],["وَنَشَقتُ مِن فَودَيكِ نَدّاً عاطِراً","لَمّا مَشَت كَفّاكِ في فَودَيكِ",22,"ك",1,0],["وَنَشَرتُمُ الأَحقادَ فَهيَ مَدافِعٌ","وَقَذائِفٌ وَأَسِنَّةٌ وَنُصولُ",23,"ل",1,0],["ونشرتُ القلاعْ","فالوَداعْ الوداعْ",24,"ع",1,0],["وَنشيجٍ مُضرّمٍ من فتاةٍ","أَبْهَظَتْها قَوارِعُ الأَيَّامِ",25,"م",1,0],["ونَشيدُ في الأُفُقِ المخَضَّبِ","مِنْ أَمانينا قُصورْ",26,"ر",1,0],["ونشهدُ أشكالَ هذي الوجوهِ","وفيها الشَّقيُّ وفيها السَّعيدْ",27,"د",1,0],["ونَشيدٍ وفَواحٍ","وانقِباضٍ وانْشِراحِ",28,"ح",1,0],["ونشدت قبر العندليب فلم يكن","في الروض يجمعني به النشدان",29,"ن",1,0],["ونشأت بين الطاهرين سرائرا","والطاهرات الصالحات العاد",30,"د",1,0],["وَنَشَرنا مِن طَيِّهِنَّ اللَيالي","فَلَمَحنا مِنَ الحَضارَةِ فَجرا",31,"ر",2,0],["وَنَشرٌ مِنَ النَدِّ لَكِنَّما","مَجامِرُهُ الآسُ وَالنَرجِسُ",32,"س",1,0],["وَنَشوَةُ الحُبِّ إِذا أَفرَطَت","بِالصَبِّ جازَت نَشوَةَ الخَمرِ",33,"ر",1,0],["وَنَشَرتُ أَردِيَةَ الدُجى وَطَوَيتُها","وَالعيسُ بَينَ وَجيفِها وَذَميلِها",34,"ل",3,0],["ونش السمك المقل","وبالقرب فسبحنا",35,"ن",2,0],["ونَشَرْنَ مَطْوِيَّ المحاسنِ للنَّوى","فَأرَيْننا عُرْساً بذاك ومَأتَما",36,"م",2,0],["ونَشَّرَ من شمائلِ أرْيَحيٍّ","كما جرَتِ الشِّمالُ على الشَّمولِ",37,"ل",1,0],["ونشتري منه رخيصاً به","كأنه للرُّخصِ موهوبُ",38,"ب",1,0],["وَنَشَرتَ في أَقصى البِلادِ فَضائِلاً","غُرّاً رَزَأتَ بِهِنَّ ذِكرَ الرازي",39,"ز",2,0],["وَنَشرُكِ شافٍ لِلَّذي بي مِنَ الجَوى","وَذِكرُكِ مُلتَذٌ عَلى القَلبِ طارِفُ",40,"ف",1,0],["وَنَشوانَ غَنَّتهُ حَمامَةُ أَيكَةٍ عَلى","حينَ طَرفُ النَجمِ قَد هَمَّ أَن يَكرى",41,"ر",2,1],["وَنَشرَبُ رَنقَ الماءِ مِن دونِ سُخطِكُم","وَلا يَستَوي الصافي مِنَ الماءِ وَالكَدِر",42,"ر",1,0],["ونَشَرْنَا عن رِداءَيْهِ لهُ","صارِماً يُذكى ورُمْحاً يَطَّرِد",43,"د",1,0],["وَنَشرَبُ الماءَ بِراحاتِنا","إِن لَم يَكُن ما بَينَنا جُنبُلُ",44,"ل",1,0],["وَنشرنَ شعراً للرزية صاغراً","وَخمشنَ خداً ذل للحدثان",45,"ن",1,0],["ونشقُّ الأرض عن وجهِ السَّما","حيث نورُ الشمسِ أو ضوءُ القمرْ",46,"ر",1,0],["ونشيدٌ مثَّلتْ ألحانُهُ","همساتِ النجم في أُذْن الغسقْ",47,"ق",1,0],["وَنَشرَبُ إِن وَرَدنا الماءَ صَفواً","وَيَشرَبُ غَيرُنا كَدَراً وَطينا",48,"ن",2,0],["ونشبت جائحة الدهور","عدوة القاهر والمقهور",49,"ر",1,0],["ونشِيدُ مَا شَاءَ السَّخَا","ءُ منَ المَعَاهِدِ والمَنائِرْ",50,"ر",1,0],["وَنَشِيشُهُ فِي الأُذْنِ منْحَدِراً","حَتَّى يَحُطَّ بِصَوْتِ رَعَّادِ",51,"د",1,0],["ونشدنا ولم نزل","حلم الحب والشباب",52,"ب",1,0],["ونشرت أنجمه على","بغداد من كفن المغيب",53,"ب",1,0],["ونشرناها على الدنيا","جناحا وجناحا",54,"ح",2,0],["وَنَشوانُ إِن كانَت بيُمناهُ أَكِلة","كَأَعلاهُ كانَت بِالشمالِ شَمولُ",55,"ل",1,0],["وَنَشرَبُ حَتّى نَحسِبَ الخَيلَ حَولَنا","نِقاداً وَحَتّى نَحسِبَ الجَونَ أَشقَرا",56,"ر",2,0],["ونشيد خنقت في","كبريائي تنهده",57,"د",2,0],["ونشيجٌ أقضَّ من مَضْجَعِ اللّيْلِ","وماجتْ له الكواكِبُ سُهْدا",58,"د",2,0],["ونشأتُ في ظلِّ النخيل يَهُزُّني","شوقٌ إلى أفيائِها وغرام",59,"م",1,0],["ونشيد في الأفق المخضب من امانينا قصور","لا نسأم اللهو الجميل وليس يدركنا الفتور",60,"ر",1,0],["ونشربُ رزقَ الماء من دون سخطكم","ولا يستوي الصافي من الماء والكَدِرْ",61,"ر",1,0],["ونشائدا جرحى اللّحون كأنّها","من رقّة الشكوى قلوب يتامى",62,"م",2,0],["ونشيدا أفرغت فيه أحاسيسي","وذاتي وخافقي والسرائر",63,"ر",1,0],["ونشيد في وطن العروبة وحدة","فوق الثريا خلف أفق \" المشتري \"",64,"ر",2,0],["وَنَشَأت وَالمَجدَ المؤَثل وَالعُلا","في حَجر كُل ممجد غَطريف",65,"ف",1,0],["وَنَشا مَصوناً ما لَهُ مِن زاجر","إِلّا الهِداية وَالتُقى مِن ناهي",66,"ي",1,0],["ونشر في السريرة من هواكم","له في طي مضمرها نظام",67,"م",1,0],["ونشكو لكم بثا وحزنا اضرنا","واثقال هم عبؤها محق القلبا",68,"ب",2,0],["ونشر عبير شذا ذكرهم","تجسم في الكون رغم الجحود",69,"د",1,0],["ونشرت أحلامي وقلت لها","زفي لنفسك ويحك البشرى",70,"ر",2,0],["ونشرت شوقاً كنت أحس","بني لقد أَحسنت طيه",71,"ي",2,0],["ونشكو الرسوم المقويات الذي بنا","عسى ولعل البث بالشجو يذهب",72,"ب",1,0],["وَنَشَّفتُ الزَّوافِرَ منهُ حَتّى","خَشِيتُ على الزَّواخِيرِ الذُّبُولا",73,"ل",2,0],["ونَشِقتُ خفّاقَ النسيم فما شفا","دائى وهل يشفِى العليلَ عليلُ",74,"ل",1,0],["وَنَشَرتَ مِن كَشفِ المَظالِمِ مَيتَةً","ما كانَ يَأمُلُ آمِلٌ أَن تُنشَرا",75,"ر",2,0],["وَنَشوانُ مِن خَمرِ المَكارِمِ لَم يُفِق","فُواقاً وَلَولاهُنَّ لَم يَدرِ ما السُكرُ",76,"ر",1,0],["ونشرت ما بين الخليل","من الأئمة وابن سيده",77,"د",2,0],["ونشقت عرفا خلت حين نشقته","أن النسيم يهب عن دارين",78,"ن",1,0],["ونشا بعدهم أناس ولكن","حصلت فيهم نفوس الكلاب",79,"ب",1,0],["ونشرنا وطوينا صفحات","وسخرنا من أراجيف الوشاة",80,"ه",1,0],["ونشرت حُرَّ ثنائه فكأنما","عاطيت منه السامعين شمولا",81,"ل",2,0],["ونشرت ذكرا في ذرى العليا لهم","لا ينطوي ابدا ولا يتصرم",82,"م",1,0],["ونشهد من عرائسه","وعود العين والحاجب",83,"ب",1,0],["ونشوانةِ الأعطافِ غرثاءَ بضةٍ","وقامتُها غُصْنٌ على حِقِفِ الرَّمْلِ",84,"ل",1,1],["ونَشْرُه يملأ الآفاقَ نفحتُه","وشمُّسها يُرجعُ العُميان بالبَصَرِ",85,"ر",1,0],["ونشوانة غيداء ظامية الحش