7210.html","الخفيف"],[404,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[404,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[417,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[417,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[440,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[454,"عيدان عيد تحرر وتفاؤل","https://www.aldiwan.net/poem61377.html","الكامل"],[454,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[459,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[465,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[469,"يا موقظ العتب الذي هو راقد","https://www.aldiwan.net/poem60254.html","الكامل"],[478,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[501,"ساعة تولى المعنى أنسكم","https://www.aldiwan.net/poem37705.html","الرمل"],[514,"أيا زاعما أني له غاير خالص","https://www.aldiwan.net/poem67737.html","الطويل"],[515,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[516,"سأعذركم وأحفظ ما أضعتم","https://www.aldiwan.net/poem12256.html","الوافر"],[539,"أرسم حبيبي زدت قلبي تشوقا","https://www.aldiwan.net/poem47547.html","عموديه"],[539,"قدمي لا عشت لي من قدم","https://www.aldiwan.net/poem47597.html","عموديه"],[539,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[552,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[552,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[552,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[564,"سقى دمن الحي الحيا المتفائض","https://www.aldiwan.net/poem13605.html","الطويل"],[568,"يا معرضا عني بوجه مدبر","https://www.aldiwan.net/poem69540.html","الكامل"],[568,"ونديم مخالف","https://www.aldiwan.net/poem69628.html","مجزوء الخفيف"],[568,"عجبي ممن تعالت حاله","https://www.aldiwan.net/poem69813.html","الرمل"],[576,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"],[576,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"]],"verses":[["سَأُعطيكِ الرِضا وَأَموتُ غَماً","وَأَسكُتُ لا أَغُمُّكِ بِالعِتابِ",0,"ب",1,1],["سَاعَةٌ أَولَى مِنَ اللَّيْلِ انْقَضَتْ","شَرَعَتْ شَرْعَ الرِّضَى وَافْتَرَضَتْ",1,"ت",1,1],["ساعَدَتْني بعْدَ المِطالِ اللّيالي","واسْتَقامَ الزّمانُ بعْدَ اعْوِجاجِ",2,"ج",1,0],["ساعَةً أَكبَرَ النَهارِ كَما شَل","لَ مُخيلٌ لِنَوئهِ أَغناما",3,"م",2,0],["ساعَةً ثُمَّ اِنتَحاها وابِلٌ","ساقِطُ الأَكنافِ واهٍ مُنهَمِر",4,"ر",1,0],["ساعَةً ثُمَّ قالَ هُنَّ بَدادِ","بَينَكُم غَيرَ سُمعَةِ الإِختِلاطِ",5,"ط",1,0],["ساع بتتويج ملوك الهدى","وباسط البرّ بتعميم",6,"م",1,0],["سأَعصِي إليها اللَّومَ في بطنِ روضةٍ","كساها الحيا نَوْراً كأرديةِ العَصْبِ",7,"ب",1,0],["سأُعْرض عما أعرضَ الدهرُ دونَه","وأشربُها صِرْفاً وإن لامَ لُوَّمُ",8,"م",1,0],["ساعةً ثم قلتَ قد هلك الهُلْ","كُ فأشْفي غيظي وأُمضي هُمومي",9,"م",2,0],["ساعياتٌ إلى رجالٍ قُعودٍ","سارياتٌ إلى أناسٍ نيامِ",10,"م",1,0],["سأُعلى مراتب أمثالها","بما رفع اللَّهُ من شانها",11,"ن",3,0],["ساعَةٌ في الخَلاءِ خَيرٌ مِنَ الأَع","وامِ تُقضى في القَصرِ وَالأَحقابِ",12,"ب",1,0],["ساعَدَكَ الدَهرُ عَلى لَأمِها","وَرَشفِ ما خَلفَ اللَهيبِ العَجيب",13,"ب",1,0],["سَأَعتُبُ بَعضَ الناسِ إِن كانَ سامِعاً","وَأَنتَ الَّذي أَعني وَما مِنكَ مَكتَمُ",14,"م",1,0],["سَأُعرِضُ عَمَّن راحَ عَنِّيَّ مُعرِضاً","وَأُعلِنُ سُلواني لَهُ وَأَشيعُهُ",15,"ع",2,1],["سَأعيشُ رَغْمَ الدَّاءِ والأَعداءِ","كالنَّسْر فوقَ القِمَّةِ الشَّمَّاءِ",16,"ا",2,1],["ساعة للسرور من وقتك الحا","ضر خير من الف ماض وآت",17,"ت",1,0],["ساعد المالك المهيمن","شعبا بلا وزر",18,"ر",1,0],["ساعة ثم طبق الارض ماءاً","فكأن الاتي قد جاء وثبا",19,"ب",2,0],["ساعاتُه خُلَسٌ ولذَّتُهُ","مسروقَةٌ ونعيمُه نَهْبُ",20,"ب",1,0],["سَأَعُدُّ ما أَلقى فَإِن كَذَّبتِني","فَسَلي الدُموعَ فَإِنَّها لا تَكذِبُ",21,"ب",1,0],["ساعَدَتكَ الأَيّامُ مِنها بِأَيّا","مِ سُعودٍ مَوصولَةٍ بِسُعودِ",22,"د",1,0],["ساعِد وَإِن كُنتَ اِمرَأً مِن هاشِمٍ","وَدَعِ التَهَشُّمَ يَومَنا وَتَفَرَّسِ",23,"س",1,0],["ساعَدَتهُ عَلى البُكا عَبَراتٌ","ساعَدَتها في فَيضِها الآماقُ",24,"ق",1,0],["ساعاتُ لَهوٍ ما تَجَدَّدَ ذِكرُها","إِلّا تَجَدَّدَ عِندَ ذاكَ غَرامي",25,"م",2,0],["سأعيدُ بسطَ القولِ في أعراضِكم","والجَوْرُ للسُّفهاءِ خيرُ بساطِ",26,"ط",1,0],["سأُعفي الدهرَ من تكديرِ عَذلي","فأَعذِرُهُ وإنْ خلعَ العِذارا",27,"ر",2,0],["سأُعْلِمُ نَفسي بالسَّماحةِ عالماً","بأنَّ بلادَ التَّغلبِيِّ بِلادي",28,"د",2,0],["ساعاتُ لَيلِكَ وَالنَهارِ كِلَيهِما","رُسُلٌ إِلَيكَ وَهُنَّ يُسرِعنَ الخُطا",29,"ا",1,0],["ساعة نبكي على الكأس","ونشكو من سقانا",30,"ن",2,0],["ساعة أغفر فيها","لك أجيال امتناع",31,"ع",1,0],["سأُعْطي بشيراً قال لي قد تجمّعوا","ثوابَ صلاتي طائعاً وصيامي",32,"م",2,0],["سأعتسِفُ القفارَ بِمُرْقِلاتٍ","تجاوزني سباسِبَها انتهابا",33,"ب",2,0],["ساعاتُ شُكرٍ غَذاهُنَّ البَقاءُ بِهِ","فَهُنَّ أَطوَلُ أَعماراً مِنَ الأَبَدِ",34,"د",1,0],["سَأَعتِبُ عُتبَةً بِمُقَفَّياتٍ","سَواءٌ هُنَّ وَالصابُ الجَديحُ",35,"ح",1,0],["ساعَةً لَو تَشاءُ بِالنِصفِ فيها","لَمَنَعتَ البِطاءَ خَصلَ الجِيادِ",36,"د",1,0],["ساعَةً ثُمَّ إِنَّها لِيَ قالَت","وَيلَتا قَد عَجِلتَ يا اِبنَ الكِرامِ",37,"م",1,0],["سَاعَفَتْكَ المُنى وطاب لك العي","شُ ألا هكذا تُواتِي الجُدودُ",38,"د",1,0],["ساعَةً ثُمَّ إِنَّها بَعدُ قالَت","وَيلَتا قَد عَجلتَ يا بنَ الكِرامِ",39,"م",1,0],["ساعَدتَهُنَّ بِنَوحَةٍ وَتَفَجُّعٍ","وَغَلَبتُهُنَّ تَفَجُّعاً وَدُموعا",40,"ع",2,0],["ساعٍ بِكَأسٍ إِلى ناشٍ عَلى طَرَبي","كِلاهُما عَجَبٌ في مَنظَرٍ عَجَبِ",41,"ب",1,1],["سَأُعطيكَ ما يُعطي الفَتى مِن تِلادِهِ","بِعَضدٍ وَإِن كانَت فُضوحَ ذُنوبي",42,"ب",2,0],["سَأُعتِبُ خُلّاني وَأَعذِرُ صاحِبي","بِما غَلَبَتهُ النَفسُ وَالغُلَواءُ",43,"ا",2,0],["ساعاتُنا كَذِئابِ الخَتلِ إِن غَبَسَت","في اللَيلِ فَالذِئبُ في أَلوانِهِ الغَبَسُ",44,"س",1,0],["ساعاتُنا تَحتَ النُفوسِ نَجائِبٌ","وَخَدَت بِهِنَّ بَعيدَةَ الإِطلاقِ",45,"ق",1,0],["ساعِد بِأَرضٍ إِذا كُنتَ بِها","وَلا تَقُل إِنَّني غَريبُ",46,"ب",1,0],["ساعدي بالطّيف إن عَزّتْ مُنىً","قِصَرٌ عن نَيْلِها في ساعدَي",47,"ي",1,0],["ساعَةٌ مِنهُ تُهلِكُ الحَرثَ وَالنَس","لَ وَتَمحو ما سَطَّرَتهُ الدُهورُ",48,"ر",1,0],["سأُعْرِضُ إنْ ناجَيْتُ من غيرِكم فتىً","وأجعَلُ زوًّ ا مِن بَنانيَ في سَمْعي",49,"ع",2,0],["ساعِدْ بذاكَ ودَعْ مَقالَ مَعاشِرٍ","بَخِلُوا فنالُوا خُطَّةَ البُخَلاءِ",50,"ا",2,0],["سَاعَةً يَغْلُبُ التَّأَسِّي فَتُلْفَى","وَجَلِيلُ الأُمُورِ مِثْلُ الصَّغِيرِ",51,"ر",1,0],["سَاعَةُ خَيْرٍ لَكِ آثرْتِهَا","سَوْدَاءَ هَلْ في اللَّونِ منْ شَرِّ",52,"ر",1,0],["سَاعَتُكِ البَيْضَاءُ لاَ سَاعَةً","سَوْدَاءَ إِلاَّ سَاعَةُ الْهَجْرِ",52,"ر",1,0],["سَأُعِيدُ المَعْنَى عَلَيْكُمْ وَإِنْ كَا","نَتْ مَعَانِيهِ جِدَّ مُخْتَلِفَاتِ",53,"ت",1,0],["سَاعَةَ سَعْدٍ يَوْدَّ شَاهِدُهَا","لَوْ وَقَفَتْ زُهْرُهَا فَلاَ تَسْرِي",54,"ر",2,0],["سَاعَاتُهُ وَنَدَى يَدَيْكِ","مُسَلْسَلاَتٌ بِاتصَالِ",55,"ل",1,0],["ساعدوا الحربَ والجرادَ علينا","نحن نحيا بمعجزات السماء",56,"ا",2,0],["ساعفي آمالَ أنضاءِ الهوى","يقتل الداء إذا عزّ الدواء",57,"ا",2,0],["ساعِدْ بِأرضٍ إنْ كُنتَ فيها","ولا تَقُلْ إنَّني غَريبُ",58,"ب",1,0],["ساعٍ لما يرضى كثيرُ الحيل","وإن دعا حاسدُهُ بالويل",59,"ل",1,0],["سأَعْصِي إليها اللَّومَ في بطنِ روضة","ٍ كساها الحيا نَوْراً كأدرية ِ العَصْبِ",60,"ب",1,0],["ساعدك الدّهر على لثمها","ورشف ما خلف اللّهيب العجيب",61,"ب",1,0],["سَاعِد بِأَرضٍ تَكُونُ فِيهَا","وَلا تَقُل إِنَّنِي غَريبُ",62,"ب",1,0],["ساعرض عمن راح عني معرضا","ولو لاح في برج الثريا طلوعه",63,"ع",2,1],["ساعاتُ العُمْرِ تُناشِدُها","وأُناشِدُها بالله قِفِي",64,"ي",1,0],["سَأَعودُ عَن كَثَبٍ وَإِن لَم تُبقِ لي","فَعَلاتُكَ الحُسنى إِلَيها مَرجِعا",65,"ع",2,0],["ساعٍ بِكَأْسٍ بين نُدْماءِ","كالغُصنِ المعصَّرِ الماءِ",66,"ا",2,1],["ساعَدَت عَينُهُ الفُؤادَ فَجادَت","فَهيَ غَرقى وَنورُها مَطموسُ",67,"س",1,0],["ساعَةً ثُمَّ اِستَغَثنَّ بِعَذبٍ","جُلِحَت عَن فَراضِهِ القَصباءُ",68,"ا",2,0],["سأُعمِل العيسَ والظلماءُ عاكفةٌ","لعلَّ معسورَ ما أرجوهُ ميسور",69,"ر",1,0],["ساعةٌ مرّت وفي القلب هواك","ساحر النغمة خفّاقَ الجناح",70,"ح",1,0],["سأعدو وللعدوان مني عواقبٌ","يصاولها الحصن الأشمّ فينهدّ",71,"د",1,0],["سأعصم روحي من هواك فإنني","عصام لنفسي من زماني ومن حالي",72,"ي",1,0],["سأعصر روحي يوم أرجع ظافراً","وفي الروح أكوابٌ من المجد تختالُ",73,"ل",1,0],["ساعة في العمر لا أذكرها","مذ مضت الا بقلب وجل",74,"ل",1,0],["ساعة وصالك وأربك","أغلى من العمر عندي",75,"ي",1,0],["ساعةَ البَينِ قِطعَةٌ أَنتِ فُدَّت","لِلمُحِبّينَ من عذابِ السَعير",76,"ر",1,0],["ساعِفي آمالَ أنضاءِ الهَوى","بِقبولٍ من سجاياكِ رُخاء",77,"ا",2,0],["ساعةٌ من جني حديثك ما بي","ن سماع الغِنَا وشُرْب العُقَار",78,"ر",1,0],["سَأُعْطِيكَ عَهْداً لاَ أَخُونُكَ بَعْدَمَا","تُطَهِّرُهَا مِنْ رِجْسِ أَهْلِ الْفَوَاحِشِ",79,"ش",1,0],["ساعة قيل الوزير منحدرٌ","أسرع دمعي وفاض منحدرا",80,"ر",2,0],["ساعِدْ مباعِدَها واحْذَرْ مَكَايِدَهَا","إنَّ الفِطامَ علَى آثارِ مَنْ رَضَعا",81,"ع",2,0],["سَأُعْوِلُ بِالْبُكاءِ وَأَيُّ خَطْبٍ","يَقُومُ بِهِ بُكاءٌ أَوْ عَوِيلُ",82,"ل",1,0],["ساعَةَ البَينِ إِنَّما أَنتِ كَالسا","عَةِ تَأِتي وَمالها مِن فُواقِ",83,"ق",1,0],["ساعَةً ثَمَّتَ جازوا","عَن هَوايَ في خِلافِ",84,"ف",1,0],["ساعة تعدل شهراً عندنا","فمتى يا هل ترى نيل الامل",85,"ل",1,0],["ساعة تحكي فؤاداً","خافقاً يهفو إليكِ",86,"ك",1,1],["ساعدٌ يسعد، عونٌ يُرتجى،","خلفٌ تحيا به إِنْ حانَ حين",87,"ن",1,0],["سَأَعني مَن عَنى قَومي بِسوءٍ","وَلا يَبلى إِذا رَجَمتُ خَدشي",88,"ش",2,0],["ساعة ما شوفه قريب مني","أحسد فؤادي على حبي",89,"ي",1,0],["سأعيش الحياةَ عبداً لذكرا","ك وأحيى رفاتها ببكائي",90,"ي",1,0],["ساعةً تعدل أحلامي","وعمري ورغابي",91,"ي",1,0],["ساعات كنا نناجي","الا أنوار طيّ الغلال",92,"ل",1,0],["ساعات همت وهامت","بك السنين الخوالي",92,"ل",2,0],["سَأَعرض عن ذكر البِلاد وَأَهلها","وَأَروى بِماء النيل مهجَتي الحرّا",93,"ر",2,0],["ساعِد عَلى الراحِ وَلا تُبالِ","وَالناسَ لا تُخطِرُهُم بِبالِ",94,"ل",1,0],["ساعِدْ أخاك إذا دعاكَ لخُطّةٍ","وإذا أردتَ مُساعِداً لكَ فادْعُنا",95,"ن",2,0],["سأعيشُ فرداً ما أُريدُ مُساعِداً","مِمّا أَرى أهْلَ الوفاء قليلا",96,"ل",2,0],["ساعٍ سِواهُ الفاتِرُ اِجتِهادُهُ","إِذا اِرتَقى إِلى بُلوغِ الأَمَدِ",97,"د",1,0],["ساعِدْ بعَضْبٍ مُصْلَتٍ وساعد","فالنَصرُ