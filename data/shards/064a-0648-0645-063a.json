{"poems":[[107,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[15,"يا خليلي اربعا واستخبرا المنزل","https://www.aldiwan.net/poem45251.html","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[443,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[498,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[519,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2427","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83282","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35358","البسيط"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100545","الرمل"],[2558,"","https://poetry.dctabudhabi.ae/diwan/poem/200322","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132606","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125803","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139585",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[709,"بزَغَتْ بِالظَّلاَمِ شَمْسُ الدُّيُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=2878",""],[5756,"الفيصلي","https://www.poetsgate.com/ViewPoem.aspx?id=5382",""],[5848,"يافؤادي لا تسلني","https://www.poetsgate.com/ViewPoem.aspx?id=51956",""],[6006,"قيامة","https://www.poetsgate.com/ViewPoem.aspx?id=214147",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""]],"verses":[["يَومَ غابَ الحُماةُ وَاِستَصرَخَت مِص","رُ تُنادي الرِجالَ وَالأَبطالا",0,"ل",2,0],["يَومَ غادَرنا عَدِيّاً بِالقَنا ال","ذُبَّلِ السُمرِ صَريعاً في المَجالِ",1,"ل",1,0],["يوْمٌ غَدَا بين الدُّهورِ مُمَلَّكاً","يُوما إِليه مَهَابةً ويُشَار",2,"ر",1,0],["يوم غدا دونه يوم الكلاب فلا","عمرو رأى مثله يوما ولا عمر",3,"ر",1,0],["يَومٌ غَذا فيهِ سَماحُكَ يَعتِقُ ال","أَسرى وَمَنَّكَ يَأسُرُ الأُمراءَ",4,"ا",2,0],["يومَ غازَتْ جِيادُهُ آلَ فَضْلٍ","بِلُهامٍ على الكُماةِ قَديرِ",5,"ر",1,0],["يَومَ غابَت بَنو أُمَيَّةَ عَنّي","وَالبَهاليلُ مِن بَني عَبدِ شَمسِ",6,"س",1,0],["يَومَ غَدا في كُلِّ دارٍ مَأتَماً","فينا وَفي الفِردَوسِ يَومَ العيدِ",7,"د",1,0],["يَومٌ غَدَت كُلُّها ساعاتُهُ غُرَراً","في جَبهَةِ الدَهرِ لَم تكسف عَلى الأَبَدِ",8,"د",1,0],["يوم غشى الملأ الأعلى سرور","قرع السمع نداء كندا",9,"د",2,0],["يوم غادرت هزيما ثاويا","وسنان الرمح فيه منقصف",10,"ف",1,0],["يوم غدا في جبين الدهر غرته","فالدهر طلق منير الوجه زاهره",11,"ر",2,0],["يوم غل الرقاب محدودب الظهر","كما غلّ أسرها مأسورا",12,"ر",2,0],["يوم غدا بك للرعية","كلها يوماً مسرا",13,"ر",2,0],["يوم غديرٍ وردهُ مذ صفا","سَرحُ الهدى فيه رأى مسرحا",14,"ح",2,0],["يَوْمَ غَطَّتْ فِي سَبَاتٍ","رَجْفَةُ الأَشْواقِ قَسْرَا",15,"ر",2,0],["يَوْمَ غَازَتْ جِيَادُهُ آلَ فَضْلٍ","كُلَّمَا سَارَ بالظُّبَى وَالْعَوَالِي",16,"ي",1,0],["يوم غيرك عن عطى يمناه ما تقوى شماله","انت طبعك بالعطايا كل كفينك يمين",17,"ن",1,0],["يوم غبت وغابت الحلوة ماهي فزورة !","كلنا كنا نعاني بين جرح وغِيرة",18,"ر",2,0],["يوم غابت محبوبتي كالقيامة","أنكرتني الدنيا وولى زماني",19,"ن",2,1],["يوم غنَّى للرشيدِ به","وانثنى ما شاء إدْلالا",20,"ل",2,0]]}