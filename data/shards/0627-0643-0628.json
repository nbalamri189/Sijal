56,"أهدي امتناني لفضلكم","https://www.poetsgate.com/ViewPoem.aspx?id=194738",""],[4442,"أكبروه أن يمشي في الصف قدما","https://www.poetsgate.com/ViewPoem.aspx?id=170996",""],[6100,"اقفيت لكن دمعك سال","https://www.poetsgate.com/ViewPoem.aspx?id=52553",""],[6115,"أذا نظمت القصيد ابدع بيوت جزال","https://www.poetsgate.com/ViewPoem.aspx?id=196456",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[231,"ناحتُ الصخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79149&r=&rc=23",""],[6307,"اعتراف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79013&r=&rc=1",""]],"verses":[["أَكبَحُ النَفسَ إِن جَمَح","تُ إِلى غايَةٍ بِها",0,"ه",2,1],["أَكَبَّ عَلَيهِ مِصقَلَتَيهِ يَوماً","أَبو عَجلانَ يَشحَذُهُ فَتانا",1,"ن",2,0],["أكبروني ولست أكبر نفسي","أنا في الفن مستفيد صغير",2,"ر",1,0],["أكبرت منك نهى وعاج خبرةً","أن تزمع السفر الذي أزمعته",3,"ت",2,0],["أَكْبر أَهْلُ البَيْتِ فِي أُنْسِيَةٍ","طَافَتْ بِهِ إِلمَامهَا العلَوِيَّا",4,"ي",2,0],["أَكْبَرْتُ مِنْكَ نُهىً وَعَاجِلَ خِبْرَةٍ","أَنْ تُزْمِعَ السَّفَرَ الَّذِي أَزْمَعْتَهُ",5,"ت",2,0],["أَكْبِرْ بِرَمْسِيسَ مَيْتاً لَنْ يُلِمَّ بِهِ","مَوْتٌ وَأَكْبِرْ بِهِ حَيّاً إِلَى الآنِ",6,"ن",1,0],["َأَكْبَرْتُ فيكَ الخَطْبُ حَتَّى إِنَّنِي","لأَرَى الثَّرَى يَحْنُو عَلَيْكَ رَحِيمَا",7,"م",2,0],["أَكْبَرْتُ فِيكَ خِصَالَ أرْوَعَ مَاجِدٍ","يَسْتَصْغِرُ الأَحْدَاثَ وَهْيَ جِسَامُ",8,"م",1,0],["أَكْبِرْ بِمَا تَأْتِي النِّقَابَةُ خِدْمَةً","كَيْفَ الجَمَاعَةُ وَالرَّئِيسُ هُمَامُ",8,"م",1,0],["أكبر من أكبر القريض به","وأكبر القاتلين من قتله",9,"ل",2,0],["أكبّ على الخِوان وكان خِفّا","فلمّا قام أثقله القيام",10,"م",1,1],["أكْبَرَ الحسْنُ قاسماً إذ رآه","بَدْره فوق غُصْنِه الأمْلودِ",11,"د",1,0],["أَكبَرُ الإِثمِ قَولَةُ المَرءِ هَ","ذا الأَمرُ إِثمٌ وَهَذِهِ فَحشاءُ",12,"ا",2,0],["أَكبَرَ مِنهُ أَنَّني زاهِدٌ","ما زَهِدَ الزاهِدُ في زُهدِهِ",13,"د",2,0],["أَكبَرَ مِنّي ذا وَأَكبَرتُ أَن","يَطمَعَ أَن أَطمَعَ في رَفدِهِ",13,"د",2,0],["أَكبادُنا خَفّاقَةٌ وَعُيونُنا","لا تَستَطيعُ مِنَ البُكا أَن تَرمُقا",14,"ق",2,0],["أَكبادُهُم مَقروحَةٌ كَجُفونِهِم","وَزَفيرُهُم بِأَنينِهِم مَوصولُ",15,"ل",1,0],["أكبر بيومك إنه يوم به","قد فجر الحزن العميق عيونا",16,"ن",2,0],["اكبر الفضل ما تقدره الاجيال","من بعد اهله والدهور",17,"ر",1,0],["اكبر بما تهدين من","نور ومن كهارب",18,"ب",1,0],["أكبر بفيصل من مليك حازم","وبنجله فخر الإمارة غازي",19,"ز",2,1],["اكبر بما انت قد احرزت من خلق","قد اسند الله في نعت له العظما",20,"م",2,0],["اكبر بفيصل ملكا طاهر النسب","يرى بلوغ العلى في وحدة العرب",20,"ب",1,0],["اكبر باصلاح اقام مناره","يهدي به والجهل في طغيانه",21,"ن",2,0],["اكبر بيوسف ثم اكبر انه","في فنه ببراعة يتصرف",22,"ف",1,0],["اكبرت اذ فشا نعيك فيهم","امم الارض امره اجمعينا",23,"ن",2,0],["اكبر الضيم ما تقا","سيه انثى من الذكر",24,"ر",1,0],["اكبر بنفس قد رأت لابائها","ان البقاء على الشقاء هوان",25,"ن",1,0],["أَكبَرتُ مِن حَسَنَينٍ هِمَّةً طَمَحَت","تَروُم ما لا يَرومُ الفِتيَةُ القُنُعُ",26,"ع",1,0],["أَكبَرُ العَيبِ عِندَهُ البُخلُ وَالطَع","نُ عَلَيهِ التَشبيهُ بِالرِئبالِ",27,"ل",1,0],["أَكَبَّ عَلى الوَزيرِ يُريدُ قَولاً","فَأَرسَلَ ضَرطَةً لَمّا أَكَبّا",28,"ب",2,0],["أَكبَرَت نَفسي وَكَرهاً أَكبَرَت","أَن تَلَقّى النَيلَ مِن كَفِّ الأَشَل",29,"ل",1,0],["أَكَبَّ بَنو الدُنيا عَلَيها وَإِنَّهُم","لَتَنهاهُمُ الأَيّامُ عَنها لَوِ انتَهَوا",30,"و",2,0],["أكبرتُ رُزءكَ حتّى ما تُجاوِرُني","خضراءُ إلا ذَوَتْ مِن حرِّ أنفاسي",31,"س",2,0],["أَكبَروهُ وَلَم تُقَطَّع أَكُفٌّ","بِمُدىً بَل قُلوبُهُم بِجُفونِ",32,"ن",1,0],["أَكبَرُ الأَشياءِ عَن أَص","غَرِ عَفوِ اللَهِ أَصغَر",33,"ر",1,0],["أَكَبَّ عَلى فَأسٍ يُحِدَّ غُرابَها","مُذَكَّرَةٍ مِنَ المَعاوِلِ باتِرَه",34,"ر",2,0],["أكبر بحاجتها إلى","إنشاء مكتبة تناسب",35,"ب",1,0],["أكبَّ نَعيم باكياً فوق قبرها","وَقالَ فأبكَى كل من كانَ يَسمَع",36,"ع",1,0],["أَكبرت لَيلة الرَشيد اللَيالي","وَمَضت في إكبارها الأيام",37,"م",1,0],["أكبر بها من نكبةٍ سوداء قد","أَخنت عَلى الآباء والولدانِ",38,"ن",1,0],["أَكبِرْ بحرٍّ يَقول الحق ينصره","وَلا يُبالي أَسرّاً قال أَم علنا",39,"ن",2,0],["أَكُبَيْشَ مَا يُدْرِيكِ أَنْ رُبْ مَنْهَلٍ","يَرْمِي ِبَعْرمَضِهِ عَلَى الأَجْوَالِ",40,"ل",1,0],["أَكُبَيْشَ مَا يُدْرِيكِ أَنْ رُبْ خَلَّةٍ","لَيْسَتْ بِشَوْشَاةٍ ولاَ شِمْلالِ",40,"ل",1,0],["أكبَّ على كأسه وانتحى","صدى الليلِ في اللحظات الأُخَرْ",41,"ر",1,0],["أَكْبَرَ الدَّهْرُ وَثْبَةً وَثَبَتْهَا","مِصْرُ مُفْتَكَّةً مِنَ الأصْفَادِ",42,"د",1,0],["أَكْبِرْ بِذَاكَ افْتِرَاءً","عَلَى الْعُلَى وَاجْتِرَاءَ",43,"ا",2,0],["اكبر الهم أن نجوز امتحانا","آخر الشهر أو نؤلف سطرا",44,"ر",2,0],["أَكبَرُ البَنينِ أَرا","هُ الفِدا لَأَصغَرِها",45,"ر",3,0],["أكبرَ ابنُ الحُسين أهرامَ مصرٍ","وشَدا البُحْتُرِيُّ بالإيوانِ",46,"ن",1,0],["أكبرتُ قدرك -يا بن عبد الله- عن","تأليف أوزان، ونحتِ قواف",47,"ف",1,0],["أكبرتُ في القَرَوِيِّ حدة عزمهِ","وحسبتُه في صبره «أيوبا»",48,"ب",2,0],["أكْبَرْتُ ميسورَ حالٍ أستشِفُّ بها","إذ لم يكن ما أُرجّيهِ بميسورِ",49,"ر",1,1],["أكبرتُ شاعرَ جعفرٍ ، وشعورُهُ","يستوجبُ الاكبارَ والترفيعا",50,"ع",2,0],["أكبرت شعري أنْ تُهينَ كريمَهُ","غُفْلٌ تضيق بها الرُّعاةُ سَوام",51,"م",1,0],["أكبر شهوده ساع مابيع.iأجحدوه","وأغلا شموعه يوم قفّا؟ ماعته",52,"ت",2,0],["اكبرته اخلاقه حين حاكى","حاله حال جده العدناني",53,"ن",2,0],["أكبرت شأنه الخلائق حتى","عبدوه في غابر الأزمان",54,"ن",1,0],["أكبير دولتنا أَتيتك شاكياً","نفراً من الاعراب قد ضربوني",55,"ن",2,0],["أَكَبَّ عَلَيها كاتِبٌ بِدَواتِهِ","يُقيمُ يَدَيهِ تارَةً وَيُخالِفُ",56,"ف",1,0],["أكبَ يرى لهُ كبداً تنزى","زجاجتها منوعةُ الصدوعِ",57,"ع",1,0],["أكبرُ الآدابِ فيمن حازها","مَن إذا حُدِّث بالشيءِ نَصَتْ",58,"ت",1,1],["أكبرت حتى لا ترى","لكبيرنا منك احتفاء",59,"ا",2,0],["أكبوا على القرآن يتلون آيه","وكلهم يقرا الحديث ويكتب",60,"ب",1,0],["أكبّوا على حملِ السلاح تمرُّناً","فإن تمرسوا يصبح كلهوٍ وعادة",61,"ه",1,0],["أكبرُ الأشياءِ لم أرضَ بها","وتراني أرتضي أصغرَ شي",62,"ي",1,0],["أَكَبَّت عَلَيها الهالِكِيَّةُ مُسلَماً","هُوَيلَةُ حَتّى زَيَّنَتهُ بِميشَمِ",63,"م",1,0],["أَكبّ على العلومِ بلا فتورٍ","وَكانَ لَه بِها فهمٌ حديدُ",64,"د",1,0],["أكبرت عيدك هجرة المختار","عن كل ما أزجيه من أشعار",65,"ر",1,1],["أَكبيتَ حينَ تقصَّدتك سِهامهم","قَد كُنتُ عَن أَمثالها أَنهاكا",66,"ك",2,0],["أكبتّ حسَّادي بنعمتك التي","أمستْ تذلّ لها الخطوب وتخضع",67,"ع",1,0],["أكبّتْ فالحُزونُ لها سهولٌ","وشبّتْ فالسهولُ لها حُزونُ",68,"ن",1,0],["أكبَرتُ مَغناكَ أن يَذوي كَمَغنانا","يا شاديَ الأيكِ عُمرَ الأيكِ ما هانا",69,"ن",2,1],["أَكَبَّ في الأُفقِ مِنهُ قادِحٌ عَمِلٌ","يَنقَدُّ ثَوبُ الدُّجَى عَن زَندِهِ الوارِي",70,"ر",2,0],["أكبرُ مُعجِزاتِه كما تَرَى","إيجَادُه شَخصِيَةً لم تُسبَقِ",71,"ق",1,0],["أكبِّرها عني ومن تكبَّرت","علي وجادت بالتواضع ذاتها",72,"ت",3,0],["أكبرت قدرك أن يحابا","واجل مجدك أن يهابا",73,"ب",2,1],["أكبادكم للغيظ أوعيةٌ","بالطف الفيم لها نفضا",74,"ض",2,0],["أكبادهم بلهيب الشوق محرقةٌ","ماذا لأكبادهم للشوق من حرق",75,"ق",1,0],["أكبروا الأسرة التي أنجبته","علماً في جلاله وبيانه",76,"ن",2,0],["أكبرته شكساً في جاهليته","ومسلماً في سجايا الحاضر البادي",77,"د",2,0],["أكبرتَ عشقهمُ وعفتهم ومن","يأبى الشرابَ وفي حشاه النارُ",78,"ر",1,0],["أكبرت كل زعيم بين شيعته","تختاره لك معواناً وتنتخب",79,"ب",1,0],["أكبرت شأنه الملوكُ فجاءت","تسبقُ البرق كتبُهمْ والبريدا",80,"د",2,0],["أكبرت خطبك والخطوب عظامُ","والأرض سيلٌ والسماء ضرامُ",81,"م",1,1],["أكبرت للشعب الأمين جهاده","ورعى أمانة من أنال وأحسنا",82,"ن",2,0],["أكبرتم نعمى أخ ونعيذكم","أن تجهلوا نعمى أخ أو تنكروا",83,"ر",3,0],["اكبوا على نعماك في العيد فالتقى","على بابك الفوجان مثر ومعدم",84,"م",1,0],["أكبَرتُ فيكِ المعَالي في مراقيها","يَا هَامةً ما انحَنتْ إلاّ لبَاريها",85,"ي",3,1],["أكبَرتُ عِزَّتَكِ الشَماءَ بَاذِلَةً","بِيْضٌ سَرَائِرُهَا بِيْضٌ أيَادِيهَا",85,"ي",3,0],["أكبرتك العقول فالبعض منها","ضل لو لم يُدركه منك اهتداءُ",86,"ا",2,0],["أكَبَّ عضّاً عليها بالنواجِذ لا","يلوي على فاتِنٍ منهُم ومُفتَتِنِ",87,"ن",1,0],["أكبرتُ نَعيَ جلالِهِ فنفيتُهُ","وهو الجليّةُ ما عليه خفاء",88,"ا",2,0],["أكبّ يخدم أهليه وموطنه","فوق الذين بمضمار الهدى جالوا",89,"ل",3,0],["أكبر وغره عزته في العصيان","مع السلامه وانطراد اموره",90,"ر",2,0],["أكبرتها عمن سواك","فانت منها أكبر",91,"ر",1,0],["أكبى المجاري دون غايته","في سفحها وسما إلى القُلَل",92,"ل",1,0],["أكبرت فينا ضربةَ الدهر","لما رُ