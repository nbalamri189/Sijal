//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78613&r=&rc=5",""],[6189,"غنائية لجبين القبلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83590&r=&rc=57",""],[6259,"سقى دمعي الأحبَّة َ حيث ساروا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59414&r=&rc=62",""],[6285,"أحبك يا تبوك ولا أبالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86822&r=&rc=15",""],[6302,"هنيئاً للشَّمالِ .. هُناك عيدُ!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86213&r=&rc=11",""],[5064,"ما لم تستطعه المحابر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87512&r=&rc=7",""]],"verses":[["لِعَينِكَ تِلكَ العيرُ حَتّى تَغَيَّبَت","وَحَتّى أَتى مِن دونِها الخُبُّ أَجمَعُ",0,"ع",1,0],["لِعَينيكَ مِنها يومَ حَزمِ مَبَرَّةٍ","شَريجانِ مِن دَمعٍ نَزيعٌ وَسافِحُ",1,"ح",1,0],["لِعَيْنَيْكِ مِنْ جَارَةٍ جَائِرَهْ","شَقائِي وَآمَالِي العَاثِرَهْ",2,"ر",2,1],["لعيون الورى بخدَّيه وردٌ","طالما عاقبَ السهادُ جناته",3,"ت",2,0],["لعينيكَ ما يفعلْنَ غيرَ مُكاتم","وما ذاك إلا من هَوان سِبالكا",4,"ك",2,0],["لعيْني مُراعي شخصِه فيه مأنسٌ","وملْهىً وللمستطعمِ الصيدِ مَطعمُ",5,"م",1,0],["لِعَيني كُلَّ يَومٍ مِنكَ حَظٌّ","تَحَيَّرُ مِنهُ في أَمرٍ عُجابِ",6,"ب",1,1],["لِعَينَيكِ ما يَلقى الفُؤادُ وَما لَقي","وَلِلحُبِّ مالَم يَبقَ مِنّي وَما بَقي",7,"ق",2,1],["لِعُيونِ الخُطوبِ بَعدُ شِماسٌ","وَلِقَلبِ الزَمانِ مِنها وَجيبٌ",8,"ب",1,0],["لِعَينَيكِ وَالثَغرُ الَّذي خِلتُ أَنَّهُ","تَحَدَّرَ مِن غَرّاءَ بيضٍ غَمامُها",9,"م",3,0],["لعينيكَ احتملنا ما احتملنا","وبالحرمانِ والذلِّ ارتضينا",10,"ن",2,1],["لعينِهِ الزرقاءِ في","قلبي سهمٌ مطلقُ",11,"ق",1,1],["لَعَيبُكَ لي وَقَولُكَ خَلِّ عَنهُ","أَشَدُّ عَلَيَّ مِن وَقعِ السِياطِ",12,"ط",1,0],["لِعَيْنَيْكِ أَرْضى بِالْحَيَاةِ بَغِيضَةً","عَلَيَّ فَإِنْ عُوجِلْتِ بِالْبَيْنِ أَتْبَعِ",13,"ع",1,0],["لعينيك سامحتُ هذا الزمانَ","..وكنتُ عليه طويلَ العتبْ",14,"ب",1,0],["لعينيكِ في الخَلق ملكٌ اذا","ما رآه الرشيدُ إعتَرتهُ الريَّب",14,"ب",1,0],["لعيني ( أم بلقيس )","فتوحاتي وراياتي",15,"ت",2,0],["لعينيك نغّمت قيثارتي","وأنطقتها النغم الأخلدا",16,"د",2,0],["لعيد النحر أيامٌ قصارٌ","تلم بنا اجتيازاً كل عامِ",17,"م",1,0],["لعينَينِ مثل الفرقدينِ تفتّحت","سماءُ فؤادٍ للهُدى نورُهُ ظهر",18,"ر",1,0],["لِعَينَيهِ عَلى العُشّاقِ إِمرَهْ","وَلَيسَ لَهُم إِذا ما جارَ نُصرَهْ",19,"ر",2,1],["لعينيك من جارة جائره","شقائي ومالي العاثره",20,"ر",2,1],["لعينيك قد ذلَّ أختَ المها","فهان وكانَ عزيزاً جليلا",21,"ل",2,0],["لعينيك في الأحشاء ما نَفَث السِحْرُ","وللحب في الألباب ما فعل الخَمر",22,"ر",1,1],["لعيونهنّ علامةٌ سحريَةٌ","عندي فما بال الظباء تغُشُّني",23,"ن",2,0],["لعينيكَ يبدو وهْو قلبُ حَبيبِه","ويَلقى الأعادي وهْو سيفٌ مصمِّمُ",24,"م",1,0],["لعينِك منها يوم زالتْ حمولُها","وإنْ لم تُنِلْ تَذْرافُها وهُمولُها",25,"ل",3,1],["لِعينِكَ يا غزالَ الرَّقَمتينِ","غليلُ صبابتي وسُهادُ عيني",26,"ن",2,1],["لِعَينِكَ يا سعيدُ عُيُونُ قومٍ","سَفَكنَ منَ الجُفُونِ دَماً حَلالا",27,"ل",2,0],["لِعَينكِ يا أُميَّةُ ما برأسي","وما في مُقلتَيَّ وفي فُؤادي",28,"د",2,0],["لِعَينِكَ في مُحاسِنِهِ شَرابٌ","وَسَمعُكَ مِن مَحامِدِه طَعامُ",29,"م",1,0],["لِعيصِه أَعْياصُ مُلْتَفٍّ شَوِكْ","مِنَ العِضاهِ وَالأَراكِ المُؤْتَرِكْ",30,"ك",1,0],["لعَيْني كلَّ يومٍ مِنهُ عَبْرَهْ","تُصيِّرُني لأهلِ العشقِ عِبْرَهْ",31,"ر",2,1],["لِعَيني رَبيعٌ دائمٌ في ربُوعِهَا","وإنْ كانَ في قَلْبي مِنَ الوَجْدِ ناجِرُ",32,"ر",1,0],["لعيون ريم الحي صغْت القوافي","بالمفردات النادره في المناشيدْ",33,"د",1,1],["لعيون من خاله على خدّ مفضوح","ما تحجب انواره غلاظ الملابيس",34,"س",1,0],["لعينك إذ سار الخليط المغوّر","على كل واد دمعة تتحدر",35,"ر",1,1],["لعينٍ داؤها أعي المداوي","تصب فتخجل الغيث السماوي",36,"ي",1,0],["لعَيني في مَحاسِنه","رِياضُ محاسِنٍ أَنقه",37,"ق",2,0],["لعينيكَ ما أخفى المحبُّ وما ابدى","من الحبّ ان الحبَّ صيَّرهُ عبدا",38,"د",2,1],["لَعِينَ رَسُولِ اللهِ مَالَكَ ذِمَّةٌ","وَمَالَكَ مِنْ دِينِ وَمَالَكَ مَحْرَمُ",39,"م",1,0],["لعينيك بستانيّنا نحن عصبةٌ","مهذّبة الوجدان مشحوذة القضب",40,"ب",1,0],["لعينيك يا ذات العلاء فما ليا","سواك حبيب أفتديه بماليا",41,"ي",2,1],["لعينيك يا روح المعاني ومصدر ال","بيان ونورا المنطق المتلاليا",41,"ي",2,0],["