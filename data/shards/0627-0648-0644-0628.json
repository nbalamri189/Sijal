{"poems":[[53,"دابر أوطاره إلى الذكر","https://www.aldiwan.net/poem62983.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[445,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101017","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3325,"","https://poetry.dctabudhabi.ae/diwan/poem/115035","الرمل"],[5344,"لا تعجّل بالحُكم ..","https://www.poetsgate.com/ViewPoem.aspx?id=155070",""]],"verses":[["أولُ بدءِ المشيب واحدةٌ","تُشعِل ما جاورتْ من الشعر",0,"ر",1,0],["أوَّلُ بانٍ أنتَ بعد الذي","شيَّدهُ فرعونُ في الأوَّلينْ",1,"ن",1,0],["أَوْ لُبسِ دِرْعٍ أَوْ تَهَادِي سابِحٍ","أَوْ مَدِّ رُمْحٍ أَوْ بريقِ حُسامِ",2,"م",1,0],["أولبس فيما قد مضى من عبرة","لبني أبي والأسر ليس بخافي",3,"ف",2,0],["اول بما قدرت نفس عليه وان","قد كان لا يقبل التأويل فاتهم",4,"م",1,0],["أو لبيب استوى حُنَّكَة","مُوفيَ المرَّةِ مأمونَ العُقَد",5,"د",1,0],["أول بدايات العلاقات بإعجاب","وتحس بأحساس المحبه وتشتاق",6,"ق",1,1]]}