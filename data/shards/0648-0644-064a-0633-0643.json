702,"","https://poetry.dctabudhabi.ae/diwan/poem/91536","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85261","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33122","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114252","البسيط"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103541","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88544","الوافر"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143839","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123505","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83202","الرجز"],[4929,"غثاء الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=208719",""],[4984,"العسس","https://www.poetsgate.com/ViewPoem.aspx?id=180561",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5191,"حَوَتْ كلّي","https://www.poetsgate.com/ViewPoem.aspx?id=214053",""],[5409,"على جهلنا في كل يوم دلائل","https://www.poetsgate.com/ViewPoem.aspx?id=155305",""],[5411,"(مَدَد)","https://www.poetsgate.com/ViewPoem.aspx?id=186138",""],[5431,"قارورة عطر...","https://www.poetsgate.com/ViewPoem.aspx?id=202545",""],[5431,"العراق -انتفاضة الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=207055",""],[5431,"يكاد يُضيئ...","https://www.poetsgate.com/ViewPoem.aspx?id=214558",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5628,"زهور ذابلة","https://www.poetsgate.com/ViewPoem.aspx?id=178513",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5956,"مقارنة معاصِرةٌ بين حالة الطير ‏ والكلاب في البلد العربي وفي البلد الأجنبي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183408",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[6068,"#مصر‬ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=177017",""],[6093,"فيلم هندي","https://www.poetsgate.com/ViewPoem.aspx?id=198954",""],[6164,"ماض وحاضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66043&r=&rc=52",""],[6259,"صددت إذ عادَ روضُ الرأس ذا زهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59373&r=&rc=21",""]],"verses":[["وليس كمثل الشيخ صب إذا هوى","ولكنه صب تعذر خاطبه",0,"ب",2,0],["وليس كُلُّ قليلٍ شَحَّ باذِلُهُ","وليس كل كثيرٍ في العطاءِ نَدى",1,"د",2,0],["وَلَيسَ كُلُّ ظَلامٍ دامَ غَيهَبُهُ","يَسُرُّ خابِطَهُ إِن يَطلَعَ القَمَرُ",2,"ر",1,0],["وَلَيسَ كَهائِبٍ يَلقى","الرَدى وَالسَيفُ زاجِرُه",3,"ر",2,0],["وَلَيسَ كَثيرٌ أَلفُ خِلٍّ لِعاقِلٍ","وَإِنَّ عَدوّاً واحِداً لَكَثيرُ",4,"ر",1,0],["وَلَيسَ كَمَن دونَ ماعونِهِ","خَواتِمُ بُخلٍ وَأَقفالُها",5,"ل",3,0],["وَلَيسَ كَقَومِهِم في الغَربِ قَومٌ","مِنَ الأَخلاقِ قَد نَهِلوا وَعَلّوا",6,"ل",3,0],["وليس كإغْذاذ المسير وحثِّه","لتقريب لُقْيان الصديق الأباعدِ",7,"د",1,0],["وليسكِّنْ جواك إذ حلقَتْهُ","أنْ سيدمي خُصاهُمُ التشويك",8,"ك",1,0],["وليس كون ماله","من اول مكونا",9,"ن",2,0],["وَلَيسَ كَبَحرِ الماءِ يَشتَقُّ قَعرَهُ","إِلى حَيثُ يَفنى الماءُ حوتٌ وَضِفدَعُ",10,"ع",1,0],["وَلَيسَ كَمَسبوتِ الضُحى مِن خُمارِهِ","إِذاراحَ كانَت لِلمُدامِ أَصائِلُه",11,"ل",2,0],["وَلَيسَ كَريمٌ لِلخُرَيبَينِ ذائِقاً","قِرىً بَعدَما نادى زَبابٌ فَأَسمَعا",12,"ع",2,0],["وَلَيسَ كَثيراً أَلفُ خِلٍّ وَصاحِبٍ","وَإِنَّ عَدّوا واحِداً لَكَثيرُ",13,"ر",1,1],["وَليسَ كَريماً مَن يَجودُ بِمَوعِدٍ","وَيَمطُلُ حَتّى يُقتَضى بِعِتابِ",14,"ب",1,1],["وليس كمثلِها جَيشٌ يُرامُ","قضاها اللّهُ فَهْيَ له ذِمامُ",15,"م",1,0],["وَليسَ كُلُّ وَقتٍ","يُطفِئُ ماءٌ جَمرا",16,"ر",2,0],["وليس كما قالوا المنيّةُ كاسمِها","ولكنّها في كفّهِ اليومَ صارم",17,"م",1,0],["وليسَ كما أبْقَتْ ضُبَيْعَةُ أضْجَمٍ","وليسَ كما شادَتْ قبائلُ جُرْهُم",18,"م",1,0],["ولي سَكَنٌ تأتي الحوادثُ دونهُ","فيبعُدُ عن عيني ويقرُبُ من فِكري",19,"ر",2,0],["وَلَيسَ كَجَدَّتَيهِ أُمِّ موسى","إِذا نُسِبَت وَلا كَالخَيزُرانِ",20,"ن",1,0],["وَلَيسَ كمثل العلم للمال حافظ","وَلَيسَ كمثل الجهل للمال طامس",21,"س",1,0],["ولَيْسَ كمَنْحُوسٍ مِن القَوْمِ مُنْحِسٍ","تَعاظَمَ حتى قِيلَ لَيْسَ يُنالُ",22,"ل",1,0],["وَليْسَ كَظِيمَ الغَيْظِ لَكِنَّهُ إِذَا","شَفَاهُ بعَتْبٍ لَمْ يَضِقْ بِأَخٍ صَدْرَا",23,"ر",2,0],["وَلَيْسَ كَأَيْكِهَا أَيْكٌ يُغَنِّي","وَلاَ كَدِحَالِهَا زَأَرَتْ دِحَالُ",24,"ل",1,0],["ولَيسَ كَريماً مَن يَخونُ صَديقَهُ","وَلكِنَّما الحُرُّ الكَريمُ الَّذي يَفي",25,"ف",2,0],["ولَيسَ كَلاَمُ القَومِ يُدرِكُ كُنهَهُ","مُجَانِبُه إِذ لَيسَ فِيهِ لَهُ طَمَع",26,"ع",1,0],["وَلَيسَ كَمِثلِ اليَأسِ يَدفَعُ صَبوةً","وَلاَ كَفُؤَادِ الصَّبِّ صادَفَ مَطمَعَا",27,"ع",2,0],["وليس كُثَيْرٌ هامَ مِثْلي بِعَزَّةٍ","وليس بِبُثْنى هام مثلي جَمِيلُها",28,"ل",3,0],["وَلَيسَ كَالفَألِ في الآدابِ داعِيَةٌ","لِهَديِ حَيرانَ أَو تَنبيهِ وَسنانِ",29,"ن",1,0],["وليس كبير الذنب مخلد مؤمن","بنار بلى فيه النبي مشفع",30,"ع",1,0],["وَلَيسَ كَما ظَنّوهُ مَركوبَ زينَةٍ","وَلَكِنَّهُ مَركوبُ عِزٍّ وَإِجلالِ",31,"ل",1,0],["وليس كبير المدح يجدي وإنّه","هو الأكبريُّ الأبهري صاحب الوقت",32,"ت",1,0],["وَليس كُلُّ وَقتِ","يضلُّ عقلُ الثَبتِ",33,"ت",1,0],["وَلَيسَ كَمَن يُغيرُ عَلى المَعاني","فَإِن ظَهَرَ اِدَّعى بِالنَقدِ غِرَّه",34,"ر",2,0],["وليس كنورٍ حاملٍ كلَّ حُجَّةٍ","كما يزعُمُ الغزيُّ وهو المُضيِّع",35,"ع",1,0],["وَلي سَكَن أَشهى إِلَيَّ حَديثُهُ","مِن القرقف المَمزوج بِالبارد العَذب",36,"ب",1,0],["وَلَيسَ كل بَياض بصَّ أَسوَدِهِ","فيما سِوى العينِ مَعدوداً مِنَ الحورِ",37,"ر",1,0],["وَلَيسَ كَلامك إِلّا النُجومَ","علون فَناثرتها من كَثب",38,"ب",1,0],["وليس كمثل الشعر للحب واصفٌ","دقائق ما يبدي المحب ويكتم",39,"م",1,0],["وليسَ كلُّ شفَةٍ مبلولةً","وإن سخَتْ بمائها الغمائمُ",40,"م",1,0],["ولي سكرٌ يجنبني رقادي","فما أدري الغدو من الرواح",41,"ح",1,0],["وليسَ كَثيراً يا شَبابِي إذا جَرَى","عليكَ سَخِينا دَمعُ عينِىَ نَائِيا",42,"ي",2,0],["وَلَيسَ كَقومي في ندىً وسماحةٍ","ولا معشرٌ في يوم رَوْعٍ كمعشري",43,"ر",2,0],["وليس كل الكلام إلا","حروفه بي لها انتشاء",44,"ا",2,0],["وَلَيسَ كَمَفقودٍ تَقادَمَ عَهدُهُ","وَغَطّى عَلَيهِ مَسحَنا وَمَشيبُ",45,"ب",1,0],["وليس كالقبرِ قبرٌ قد حللتَ به","وإِنما هو مِشكاةٌ لأَنْوَارِ",46,"ر",1,0],["وليس كلاماً في الحقيقة مبطلاً","من النفخ في النص الأكيد المؤكد",47,"د",1,0],["وَلَيسَ كَمَن باتَ التَمَدُّنُ يَدَّعي","مَقاوِلُهُ قَد كَذَّبَتها مَفاعِلُه",48,"ل",2,0],["وَلَيسَ كُلُّ أَخٍ تَأتي مُنيَتُهُ","عَلى رُؤوسِ ذَويهِ دَكَّ بُنيانِ",49,"ن",1,0],["وَلَيسَ كَفُّكَ مَقبُوضاً عَلى ذَهَبٍ","مِن أين يُمسِكُ جَريَ الماءَ غِربال",50,"ل",1,0],["وليس كمثل من أهواه مثل","عزيز لا سمعت ولا رأيت",51,"ت",1,0],["وليس كأم حماد خليل","اذا ما لامر جلّ عن الخطاب",52,"ب",1,0],["وليس كذا فلا تَعْذُلْ","خليلَكَ عَذْلَ منكمش",53,"ش",1,0],["وَلَيسَ كِرامُ الناسِ إِلّا كَواكِباً","عَلى صَفحَتَي لَيلٍ وَأَنتَ لَهُم بَدرُ",54,"ر",1,0],["وليس كذاك فخبرهم","قياماً بعذري أو عذره",55,"ر",2,0],["وَلَيسَ كُل يَكسو","ما المَجد إِلا النَفس",56,"س",1,0],["وَلَيسَ كُل سَمَكه","تُصبح رَهن الشَّبكه",57,"ه",1,0],["وليس كعلج من ثمود بكفه","من الجود والمعروف حزم مطوحج",58,"ح",2,0],["ولي سَكَنٌ ينأى ويدنو وحبُّهُ","بِصَبْريَ مُوْدٍ أو لِسِرِّيَ هاتك",59,"ك",1,0],["وليس كما خِلتَهُ إنما","هو الموتُ أَبْهَمَهُ أو أَبانا",60,"ن",2,0],["ولي سكن بالحسن يشعب خلّتي","ويصدع قلبي بالتجنب والعتب",61,"ب",1,0],["وليس كمثل الله شيءٌ وإنما","هنا الكاف حشوٌ للكلامِ لكي يتم",62,"م",1,0],["وليس كما قال الجهول بأنه","بتفريقِ دينارِ تحلُّ ودرهم",63,"م",1,0],["وليس كما لن الشواني شماتة","فاضحت به مسرورة كل شانيه",64,"ي",2,0],["وليس كمثلها وزر للاق","من الدهر ازورا والجادين",65,"ن",1,0],["وليس كشكري كلما أيقظ الندى","لواحظه ألقيته وهو هاجع",66,"ع",1,0],["وليس كلُّ الناس يدري بها","إلا السليمُ العينِ غير الرئس",67,"س",1,0],["وليس كسوف النيرين بموجب","لأمر سوى تخويفنا والتهدّد",68,"د",1,0],["وليس كفضل العفو فضل ومفخر","ولا سيما من قادر متحكم",69,"م",1,0],["وليس كما قال الجهول تقسمت","فبعض إلى غصن وبعض إلى حقف",70,"ف",1,0],["وليس كثيرا بعثهم لي كعهدهم","على الله يبدي خالقاً ويعيد",71,"د",1,0],["وليس كشانئ إن سيل عرفاً","يقلب مقلة فيها اعورار",72,"ر",1,1],["وليس كمثل هذا اليوم يوم","فقد جاؤا بقاصمة الظهور",73,"ر",1,0],["وليس كمال المرء أن يُدرِكَ الغَنِى","ولكنَّه تجريبُهُ والتأدُّبُ",74,"ب",1,1],["وليس كدائي من غرام كدائِها","وقد كاد يودي بالفؤاد كديدها",75,"د",3,0],["وليسَ كلُّ الدلاءِ راجعَةً","بالنصفِ من ملئِها إلى الوَذَمِ",76,"م",1,0],["وَلَيسَ كمن في الدَهر ميتٌ خطوبُه","مقيمٌ بدار الخلد بين الخَرائد",77,"د",1,0],["وَلَيسَ كُلُّ عُيونٍ دَمعُها هدرٌ","وَلَيسَ كلُّ فؤادٍ وَجدُه لَهَف",78,"ف",1,0],["وَلَيسَ كُلُّ فَتى يَبكي بِهِ شغفٌ","وَإِنَّما بِالدُموع المرء يُتَّهم",79,"م",1,0],["وليس كل وقت","يزول عقل الثبت",80,"ت",1,0],["وليس كمثل اللَه شيءٌ وما له","شبيهٌ ولا ند بربك يعدل",81,"ل",1,0],["وَلَيسَ كَفَتحِ القُدسِ مُنيَةَ قادِرٍ","وَما أَن تَلَقّاها سِوى يوسُفَ جَزَما",82,"م",2,0],["وَلَيسَ كُلُّ خِلاَفٍ جَاءَ مُعتَبَراً","إِلاَّ خِلاَفٌ لَهُ حَظٌّ مِنَ النَّظَرِ",83,"ر",1,0],["ولي سكن أغرى بي الحزنَ حسنُه","جريءٌ على قتل المحب مُقيتُ",84,"ت",1,0],["وليس كحرصنا حرص عليها","ولا غوص يكون كما تغوص",85,"ص",1,0],["وليس كلُّ ابتسامٍ من أخي كرم","بشراً، ولا كلُّ تقريبٍ بإيناس",86,"س",1,0],["وليس كتقصيرى أرى في الورى ولا","كنومى عن الطاعات نوم على الفرش",87,"ش",1,0],["وليس كمثلها حسناء يعزى","إليها الحسن من عم وخال",88,"ل",1,0],["وَلَيسَ كَالأَيادي","أَجلبَ لِلودادِ",89,"د",1,0],["وليس كلام خارج العقل اجوف","ومن قاله لم يدر ماهو قاله",90,"ل",2,0],["وليس كما زعموا معجما","أحاط به الفكر لما همس 1",91,"س",1,0],["وليس كريما بالحقيقة غير من","ببنت كروم الأكرمين تكرما",92,"م",2,0],["وليس كذي جربا بجرباء ماكثٍ","قريب الكدا فالوصل منه كداء",93,"ا",2,0],["وليسَ كمثلِ عينيها.. عيونٌ","ولا وردٌ ولا حسنٌ علاها",94,"ا",3,0],["وليس كمثل العلم للشمل جامعٌ","وليس كداء الجهل للمرء قاتلُ",95,"ل",1,0],["وَلَيْسَ كَمِثلكَ شَيءٌ تَجلَّى","فَطَرْتَ السَّماءَ خَلَقْتَ الْبِحارا",96,"ر",2,0],["وليسَ كريح الحبّ ريح أُلذّها","وليس كريح الأم عطرٌ إذا عبق",97,"ق",1,0],["وليس كبركان الشعوب إذا ابتدا","وليس كنفس الحرّ إنْ ذُلّ مقصلُ",98,"ل",1,0],["وليس كمثل مدعيّ ظلوم","أخسّ من الأبالسة انحلالا",99,"ل",2,0],["وليس كمثل الله شيء ولا له","شبيه تعالى ربنا أن تجدا",100,"د",2,0],["وليسَ كلانا كما تدّعينّ","فقولي الذي شئْتِ لّنْ أقْبَلهْ",101,"ل",2,0],["وليس كحب المجد أكشف للذي","تسر من الكيد النساء ومن مين",102,"ن",1,0],["وليس كطُعْمٍ كما يفعلونَ","هناك بأرض بني ثعلبِ ‏",103,"ب",1,0],["وليس كرامةُ الإنسان إلا","بنشرٍ للتسامحِ والحُبورِ",104,"ر",1,0],["وليس كل حبيب ضره وله","وفي غرامك ضرّ ما له ندم",105,"م",1,0],["وَلَيْسَ كَأَفْلامِ الهُنُودِ غَرَامُنَا","بِمَا تَشْتِهي النُّظَّارُ يُؤْتَى بِمَخْتَمِ",106,"م",1,0],["ولَيْسَ كَمِثْلِ الهَجْرِ لِلْحُرِّ قاتِلٌ","ولَيْس كمِثْلِ النَّأْي لِلْمُتَفَجِّع..!",107,"ع",1,0],["وليس كل سوادٍ بصّ أسودهُ","فيما سوى العين معدوداً من الحورَ",108,"ر",1,0]]}