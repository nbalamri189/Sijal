{"poems":[[65,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[87,"سلام من صبا بردى أرق","https://www.aldiwan.net/poem24321.html","عموديه"],[63,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[113,"لقد شبهت بالفلك اعتبارا","https://www.aldiwan.net/poem16652.html","الوافر"],[164,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[164,"تدارك من زمانك ما افدتا","https://www.aldiwan.net/poem59135.html","الوافر"],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[376,"فشرقت أبغي مطلع الشمس بالغنى","https://www.aldiwan.net/poem57457.html","الطويل"],[385,"أعند الحر للأيام ثار","https://www.aldiwan.net/poem48783.html","الوافر"],[409,"علام يلام القلب إن ظل حيرانا","https://www.aldiwan.net/poem33375.html","الطويل"],[463,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[534,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[563,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[572,"هنيئا لأصحاب السيوف بطالة","https://www.aldiwan.net/poem69507.html","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109126","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124337",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122027","المتقارب"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101585","الوافر"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76610","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198888","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137925",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87335","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65989","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65995","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204714","الطويل"],[3156,"","https://poetry.dctabudhabi.ae/diwan/poem/34722","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87364","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21513","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111457","الخفيف"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130866","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136410",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5615,"رسالة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=187951",""]],"verses":[["ولكنَّ ذِكْراها إذا الليلُ نُشِّرَتْ","غَدائِرُهُ تُملي عليَّ الأغانِيا",0,"ي",2,0],["وَلَكِن ذادَةٌ وَقُراةُ ضَيفٍ","كَيَنبوعِ الصَفا خَشُنوا وَرَقُّوا",1,"ق",3,0],["ولكنَّ ذا القُربى أحقُّ بمنطِقٍ","إذا كان ذو القُربى إلى الحمدِ أقرَبا",2,"ب",2,0],["وَلَكن ذاكَ مفتضح هِلالاً","وَمُستَتر هِلالي في ضَميري",3,"ي",1,0],["ولكن ذباب السيف أعظم هيبة","إذا كان مسلولا من السيف في الغمد",4,"د",1,0],["ولكن ذاك رد بعد أخذ","وبين الرد والتأخاذ شتا",5,"ت",2,0],["وَلَكِنَّ ذا عَزمٍ إِذا هَمَّ لَم يُبَل","أَوَسَّدَ ذا الطَعن الثَرى أَم تَوَسَّدا",6,"د",2,0],["ولكنَّ ذا عذب المواردِ آمن ال","مقاصد معمور المشاهِد بالشكرِ",7,"ر",1,0],["وَلَكن ذاكَ مِن قَلبٍ كَريم","لَهُ شَغف بِمثلِكَ وَاِفتِخار",8,"ر",1,0],["ولكن ذنوبي أحرمتني ورودها","وكنت إلى تلك المواقف ظمآنا",9,"ن",2,0],["ولكنْ ذُنَاباها تطولُ رقابَها","وأرجلُها مرفوعةٌ فوق هامِها",10,"م",3,0],["ولكنْ ذاكَ ذَنْبٌ لَيْسَ كُفراً","ولا فسْقاً فَهَلْ في ذَا رُدودُ",11,"د",1,0],["ولكن ذوو الطغيان والجهل والعمى","حيارى من الإنكار للحق والغدر",12,"ر",1,0],["وَلَكِنْ ذَوُو الأَقْلاَمِ فِي كُلِّ سَاعَةٍ","سُيُوفُهُمُ لَيْسَتْ تَجِفُّ مِنَ الدَّمِ",13,"م",1,0],["ولكن ذا نوم وهذه منية","وقد غدَت الأخرى براحته أحرى",14,"ر",2,0],["ولكِن ذلكَ القاضي سُلَيمى","فلا عَجَبٌ علَيها أن تَميلا",15,"ل",2,0],["وَلَكِنْ ذُنُوبِي أَطَلْنَ انْتِزَاحِي","وَصَيَّرْنَ أَيَّامَ أُنْسِي قِصَارَا",16,"ر",2,0],["ولكن ذا النهى غوث لكل","وغيث لا يكف له انصباب",17,"ب",1,0],["ولكن ذاك الظل أندى غضارة","لضاح وذاك البرق أوفى لشائم",18,"م",1,0],["ولكن ذنبي حال بيني وبينه","متى توبتي تقضى وينحو التقى نحوي",19,"ي",1,0],["ولكن ذودهُ عن مونس يوماً","ارى الدنيا قليل العد كثرا",20,"ر",2,0],["ولكنَّ ذا القياسَ قد غابَ وقتُهُ","يُقَاسُ ولا ينقاسُ إلاّ بشُبهَةِ",21,"ه",1,0],["ولكن ذا مما دنا واستحاله","بفلك من التدبير يجري به الفهم",22,"م",1,0],["ولكن ذا الآلاء بالغ أمره","وكم قد قبلت مهجة من عثارها",23,"ر",3,0],["ولكن ذاك الروح باقٍ كعهده","وان كان منه الجسم شبه هباء",24,"ا",2,0],["وَلَكِنَّ ذا لَجَّ في كَوثَرٍ","وَلَم يَشفِ هَذا دُعاسُ الحَمير",25,"ر",1,0],["ولكن ذَري مني بقيَّةَ فِكرَةٍ","فاني بها عن كل ذلك قانِعُ",26,"ع",1,0],["وَلَكِنَّ ذا القُربى الَّذي يَستَخِفُّهُ","أَذاكَ وَمن يَرمي العَدُوَّ الَّذي تَرمي",27,"م",2,0],["وَلَكِنذَ فوليدَماسَ سَبَق","فَصاحَ بِهَكطورَ بَينَ الفِرَق",28,"ق",1,0],["ولكن ذِيُومِيذُ الإِلاهُ لَهُ انجَلى","فَأَحجَمَ كَرَّاتِ الإلاهِ يُحاذِرُ",29,"ر",1,0],["ولكن ذنب يكنت منه مشردا","سأغسله إن عشت في السرو والجهر",30,"ر",1,0],["ولكن ذا الفضل الجزيل محسد","وان كان محض الخير للناس يصنع",31,"ع",1,0],["ولكن ذا ينفي الذي قد زعمتمو","وبالعلم حزناً رتبة الفضل والمجد",32,"د",1,0],["وَلكنْ ذَوقُهُ صَدَّ الأَماني","وأَلقَى فَوقَ سَاحتِهِ ظِلَالَهْ",33,"ل",2,0]]}