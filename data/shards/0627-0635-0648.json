],[5758,"خيال امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=200511",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5851,"ويهتفون بحياة الرداءة","https://www.poetsgate.com/ViewPoem.aspx?id=175276",""],[5853,"(( ورثتُ الحسنَ))","https://www.poetsgate.com/ViewPoem.aspx?id=175666",""],[5883,"ثلة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=22793",""],[5883,"تجربة","https://www.poetsgate.com/ViewPoem.aspx?id=24071",""],[5906,"سَماحة","https://www.poetsgate.com/ViewPoem.aspx?id=188070",""],[5956,"عصفور هطلَ على ماء بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=183461",""],[5956,"شِباكُ الشِّعر","https://www.poetsgate.com/ViewPoem.aspx?id=183742",""],[5956,"الحمد لله أعطانا أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=192130",""],[5956,"خوفي تحقق","https://www.poetsgate.com/ViewPoem.aspx?id=194821",""],[5957,"لماذا عدتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=55378",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""],[6001,"روحي تحبك","https://www.poetsgate.com/ViewPoem.aspx?id=406",""],[6011,"لعمر أبيك إني ذبت وجدا","https://www.poetsgate.com/ViewPoem.aspx?id=169338",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6070,"أصولُ الأرضِ تهتفُ والقوافي","https://www.poetsgate.com/ViewPoem.aspx?id=193901",""],[6088,"بكى الرسم","https://www.poetsgate.com/ViewPoem.aspx?id=207594",""],[6100,"هياكل أوادم","https://www.poetsgate.com/ViewPoem.aspx?id=52556",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6125,"رَسَمَتْ عيونكِ في الظَّلامِ بُدوري","https://www.poetsgate.com/ViewPoem.aspx?id=212869",""],[6152,"ولدت مسافرا","https://www.poetsgate.com/ViewPoem.aspx?id=204435",""],[5377,"إلي وطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79564&r=&rc=20",""],[6242,"الخبزُ يا أمّنا ما عاد يكفينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87568&r=&rc=15",""],[463,"عجبتُ لمرّ النفسِ كيف يضامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60327&r=&rc=383",""],[6285,"أحبك يا تبوك ولا أبالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86822&r=&rc=15",""],[2220,"أنا انتا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11225&r=&rc=99",""],[572,"أثابَ فأعداني إلى ظُلمِهِ الدَّهْرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9330&r=&rc=187",""]],"verses":[["أَصونُ عَنِ الرِجالِ فُضولَ قَولي","وَأَبذُلُ لِلرِجالِ فَضولَ مالي",0,"ل",2,0],["أَصونُ تُرابَ الأَرضِ كانوا حُلولُها","وَأَحذَرُ مِن مَرّي عَلَيها وَأُشفِقُ",1,"ق",1,0],["أَصونُ عَلى الأَطْماعِ وَجْهاً لِبِشْرِهِ","إِذا عَبَسَ الدَّهْرُ الخَؤونُ وَبيصُ",2,"ص",1,0],["أَصولُ عَلى أَبناءِ جِنسي وَأَرتَقي","وَيُعجِمُ فيَّ القائِلونَ وَأُعرِبُ",3,"ب",1,0],["أَصونُكِ عَن بَعضِ الأُمورِ مَضَنَّةً","وَأَخشى عَلَيكِ الكاشِحينَ الأَعادِيا",4,"ي",2,0],["أَصونُكِ مِن لَحَظاتِ الظُنونِ","وَأُعليكِ عَن خَطَراتِ الفِكَر",5,"ر",1,0],["أصُولُ الضَّادِ طَيِّبَةُ الأُرُومِ","تَفَرَّعُ كُلَّ تَفْريعٍ مَرُومِ",6,"م",1,1],["أصوغ بها حُرّ الكلام لخزعل","مديحاً كعِقد اللؤلؤ المتناسق",7,"ق",1,0],["أَصونُ الهَوى مِن رَهبَةٍ أَن تَعُزَّها","عُيونٌ وَأَعداءٌ مِنَ القَومِ كُشَّحُ",8,"ح",1,0],["أَصونُ عِرضي بِمالي لا أُدَنِّسُهُ","لا بارَكَ اللَهُ بَعدَ العِرضِ بِالمالِ",9,"ل",1,0],["أصوغ على الدُّرِّ اليتيم مدائحاً","أُعدُّ بها من صاغةِ الشعراء",10,"ا",2,0],["أصوغ بسيطاً في الثناءِ وكاملاً","على وافرٍ من جوده وسريع",11,"ع",1,0],["أصوغ له منها وألحق نسله","فأجمع مدح الجد والأب والنجل",12,"ل",1,0],["أصوغ له مدائح لم يصغها","على سيف العلى نجل الحسين",13,"ن",1,0],["أصونُ بها المَقاتلَ من زمانٍ","على الأحرار عَداَّءٍ وَثوبِ",14,"ب",1,0],["أصْوَر نحو العلى ترى أبداً","إلى نواحي وجوهِها صَوَره",15,"ر",2,0],["أُصولُها قَد رُوِّيَت","مِن ريقِهِ بِالعَذِرَه",16,"ر",2,0],["أَصواتُ الأَمسِ تُعَذِّبُهُ","وخيالُ الموتِ يُهَدِّدُهُ",17,"د",2,0],["أَصونُ سِرِّكِ في قَلبي وَأَحفَظهُ","إِذا تَضايَقَ صَدرُ الضَيِّقِ الباعِ",18,"ع",1,0],["اصوم يومي وحسبي ان يكون على","دم عبيط لظبي صدت افطاري",19,"ر",2,0],["أصوم إظهاره لا أفطرُ","وإن علمت إنّ روحي تهدرُ",20,"ر",1,0],["أَصونُ نَفساً لا أَرى بَذلَها","حَظّاً وَأَخلاقاً سَمَت مُصعِدَه",21,"د",2,0],["أَصولُ عَلى دَهري كَصَولَةِ فَضلِهِ","عَلى عَدَمِ الراجينَ بِالبَذلِ وَالرِفدِ",22,"د",1,0],["أصونُ حزني لك حتى اللقا","وأحبِسُ الفرحَةَ حتى أراك",23,"ك",1,0],["أُصَوِّتُ بِالدُنيا وَلَيسَت تُجيبُني","أُحاوِلُ أَن أَبقى وَكَيفَ بَقائِيا",24,"ي",2,0],["أصونُ الذي عُلِّمته عنْ مذلةٍ","فللعزِّ في الدارينِ قد كنتُ أتعبُ",25,"ب",1,0],["أَصومُ إِذا تَصومُ عُثَيمَ نَفسي","وَأُفطِرُ حينَ تُفطِرُ لا أَصومُ",26,"م",1,0],["أُصَوِّرُ صورَةً في التُربِ مِنها","وَأَبكي إِنَّ قَلبي في عَذابِ",27,"ب",1,1],["أَصونُ أَحِبَّتي ما الحُبُّ إِلّا","أَمانَةُ فاضِلٍ وَوَفاءُ حُرِّ",28,"ر",1,0],["أَصواتُ رُهبانِ دَيرٍ في صَلاتِهِمُ","سودِ المَدارِعِ نَعّارينَ في السَحَرِ",29,"ر",1,0],["أَصومُ يَوماً فَأَرقا مِن تَذَكُّرِها","وَلا أُصَلّي الضُحى إِلّا بِعَدّادِ",30,"د",1,0],["أَصونُ عَنِ اللِئامِ لُبابَ وُدّي","وَأَختَصُّ الأَكارِمَ بِاللُبابِ",31,"ب",1,0],["أُصولٌ قَد بُنَينَ عَلى فَسادٍ","وَتَقوى اللَهِ سوقٌ لا تَبورُ",32,"ر",1,0],["أَصْوَاتُ نِسْوَانِ أَنْبَاطٍ بِمَصْنَعَةٍ","بَجَّدْنَ لِلنَّوْحِ واجْتَبْنَ التَّبَابِينَا",33,"ن",2,0],["أصون ديني عن جعل أؤمله","إذا تعبد أقوام بأجعال",34,"ل",1,0],["أَصَوَّحَتْ شَجَرَاتُ الْمَجْدِ أَمْ نَضَبَتْ","غُدْرُ الْحَمِيَّةِ حَتَّى لَيْسَ مِنْ رَجُلِ",35,"ل",1,0],["أصول عَلى الأَيّامِ مِنكَ بِواحِدٍ","نَمَتهُ فُروعٌ لِلعُلا وَأُصولُ",36,"ل",1,0],["أَصُوغُ قَوَامَكَ مِن كُلِّ حُسنٍ","وأَكسُوكَ ضَوءًا ولَونًا وعَرفْ",37,"ف",1,0],["أصون ودادى أن يدنسه الهوى","وأحفظ عهد الحب أن يتثلما",38,"م",2,0],["اصول مجد زهت منها الفروع بما","حازت من النسب الوضاح والحسب",39,"ب",1,0],["أصومُ وما ماؤكم للورودِ","وأعشو وما ناركُم للصِّلاءِ",40,"ا",2,0],["أُصولُكُمُ شامِخاتُ الفُروعِ","وَأَيّامُكُم شاذِخاتُ الغُرَر",41,"ر",1,0],["أصونُ هُدْب ردائي ليسَ يجذبُهُ","إلا فَتىً يبذلُ الإنصافَ إن صافى",42,"ف",2,1],["أصون دراهمي وأذُبّ عنها","لأنّ دراهمي سيفي وترسي",43,"س",2,1],["أصون نفسيَ عن لعب الوشاة بها","وإن تلاعبتِ الأسقام في جسدي",44,"د",2,0],["أصورتكم هذي وأنتم بروضةٍ","يموج بها التفاح والاس والورد",45,"د",1,0],["أصوغُ وحيَ فؤادٍ أنت ملهمُه","حتى غدا من جواهُ خير فنّان",46,"ن",1,0],["أصوغ شعري حنيناً كي ترقّ له","من بعد صدّ وهجرانٍ وعصيان",46,"ن",1,0],["أصولُ بقرعِ البمّ والزيرِ بعده","إذا قرعوا عند الصلاة النواقيسا",47,"س",2,0],["أصونُ أبشارَ خدود الدُمَى","وأمنع الغاوي من النظره",48,"ه",1,1],["أَصومُ لِصَومِكُم خَمسينَ يَوماً","وَأَهجُرُ كُلَّ مَحظورٍ حَرامِ",49,"م",1,0],["أَصونُ بِهِ عِرضي وَأَمنَعُ جانِبي","وَمِثلُ جَلالِ الدينِ مَن صانَ أَمثالي",50,"ل",2,0],["أَصونُ عَنِ الجُهّالِ شِعري تَرَفُّعاً","وَأُشفِقُ مِن مَدحِ البَخيلِ عَلى فَضلي",51,"ل",2,0],["أَصوغُ لَهُ حَليَ المَديحِ وَلَم تَكُن","لِتَحسُنَ إِلّا في عُلاهُ جَواهِرُه",52,"ر",2,0],["أَصَوتَ مُنادٍ مِن رُمَيلَةَ تَسمَعُ","بِغَولٍ وَدوني بَطنُ فَلجٍ فَلَعلَعُ",53,"ع",1,1],["أَصوم عَن الاغيار قطعا وَذكركم","لصوصي سحور في الهَوى وَفطور",54,"ر",1,0],["أَصُونُ لِسانِي وَالْجَنانُ يُذالُ","وَأَقْصِرُ بَثِّي وَالشُّجُونُ طِوالُ",55,"ل",1,1],["أَصُونُ جَمالَهُ وَأُجِلُّ مِنْهُ","جَبِينَ الْبَدْرِ أَنْ يُمْسِي عَفِيرا",56,"ر",2,0],["أَصول بِقَلبٍ لوذعيٍّ ومِقوَلٍ","يفلُّ شَباه المشرفيَّ اليمانيا",57,"ي",2,0],["أصوم عن الفحشاء جهراً وخفيةً","عفافاً وإفطاري بتقديس فاطري",58,"ر",2,0],["أَصواتُ عُجمٍ إِذا قاموا بِقُربَتِهِم","كَما تُصَوِّتُ في الصُبحِ الخَطاطيفُ",59,"ف",1,0],["أَصونُ سَمعَك عن شَكْوايَ إجْلالاً","وقد لَقِيتُ من الأيّامِ أَهْوالا",60,"ل",2,1],["أصونُ عن الأَرذال عزَّ نفسي","وَصَوْنُ النفس من شِيَم الغيور",61,"ر",1,0],["أصول زكت وفروع نمت","فمدّت من الفخر أقوى سبَب",62,"ب",1,0],["أصون لساني عن الغادري","ن صونَ طِلابي عن الباخلينا",63,"ن",2,0],["أصولٌ لها قصرُ المدائن خُطَّةٌ","وفرعٌ بها بالأبطحين خيامُ",64,"م",1,0],["أصولهُمُ منصورةٌ بفروعهم","إذا قام منهم آخرٌ كان أوّلا",65,"ل",2,0],["أصولُ مجدٍ ما بها","فقر إلى مفرِّعِ",66,"ع",1,0],["أصولُ علاً منصورةٌ بفروعها","إذا غاب مُمسٍ منهُمُ هبَّ صابحُ",67,"ح",1,0],["أُصولُكُم وأجدرُ إذ شهدتم","مقامَ علائهم أَلا يغيبوا",68,"ب",3,0],["أصوبُ غمامٍ أمْ نوالُ مُعَذَّلٍ","أسالَ من النَّعم