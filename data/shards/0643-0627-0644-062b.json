{"poems":[[55,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[53,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[190,"للورد ريح عبق","https://www.aldiwan.net/poem43552.html","مجزوء الرجز"],[305,"إني وجدت بني سهم وجاملهم","https://www.aldiwan.net/poem45477.html","الطويل"],[572,"قم قد أتى ضوء الصباح المسفر","https://www.aldiwan.net/poem69462.html","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64086","الرمل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132252","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87576","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125838","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120300","الكامل"],[4767,"الأمل المعلق","https://www.poetsgate.com/ViewPoem.aspx?id=215856",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5704,"من ثغره لاح السنا ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=197402",""],[5978,"تجليات من وحي الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=191711",""],[6102,"الحب في الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=182875",""],[572,"قُمْ قَدْ أَتَى ضوءُ الصَّبَاحِ المُسْفِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9302&r=&rc=159",""]],"verses":[["كَالثائِرِ الضِرغامِ إِن","لَبِسَ الوَغى دَقَّ الرَعيلا",0,"ل",2,0],["كالثائرِ الطَّالبِ بالطوائلِ","فلمْ يُرع عن دِمنٍ ذلائلِ",1,"ل",1,0],["كالثوب في جدّته","حتّى إذا صار خلق",2,"ق",1,0],["كَالثَعلَبِ الرائِحِ المَمطورِ ضَبعَتُهُ","شُلَّ الحَوامِلُ مِنهُ كَيفَ يَنبَقِعُ",3,"ع",1,0],["كَالثَّلْجِ بَرْدَاً فِي صَفَاءِ التَّبْرِ فِي","رِيْحِ العَبِيْرِ وَفَوْقَ طَعْمِ السُّكَّرِ",4,"ر",1,0],["كالثنايا الغرِّ والط","لُّ الذي فيها كريق",5,"ق",1,0],["كالثلج بردا والزلال عذابه","عذب ويرمي لفحه بشرار",6,"ر",1,0],["كالثَغر تَنسيقاً ونَكهتهِ شَذاً","وَزُلالهُ لأَخي الهوى ترياقُ",7,"ق",1,0],["كالثَّور ثار من الهياج فَهَ","دَّؤوهُ وما هدا",8,"د",2,0],["كالثعلب النكر ازدرى ما طاب من","عنب بغى اذ آب عنه يئوسا",9,"س",2,0],["كالثوبِ حين يضيقُ مِن","جِسمٍ به يتمزق",10,"ق",1,0],["كالثريا جنانها قد تدانت","بجناها وحَليها وحُلاها",11,"ا",3,0],["كالثلج أمسى ناصعا ببياضه","من ثغر من أهوى يلوح رشيقا",12,"ق",2,0],["كالثلج إن لاح الغروبُ بأفقه","وعباءةَ الشفقِ الحزينِ قد اكتسا",13,"س",2,0],["كَالثُّرَيَّاتِ شَعَّتِ الأضواءُ","عِندَما بِنتِ , وَ استَطالَ البَهاءُ",14,"ا",2,1],["كالثَّلجِ بَرْداً في اصفِرَارِ التبرِ في","ريحِ العبيرِ وفوقَ طعمِ السكَّرِ",15,"ر",1,0]]}