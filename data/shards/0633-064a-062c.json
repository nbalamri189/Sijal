{"poems":[[90,"أدرنة مهلا فإن الظبى","https://www.aldiwan.net/poem44466.html","المتقارب"],[74,"سيج ورد الخدود بالآس","https://www.aldiwan.net/poem19018.html","المنسرح"],[53,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[53,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[53,"أبا بكر لك المثل المعلى","https://www.aldiwan.net/poem65904.html","الوافر"],[53,"أقول لما رأيت عرسي","https://www.aldiwan.net/poem66512.html","مخلع البسيط"],[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[94,"ألا أيها الظالم المستبد","https://www.aldiwan.net/poem38895.html","المتقارب"],[87,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[47,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[30,"وأطلس عسال وما كان صاحبا","https://www.aldiwan.net/poem5628.html","الطويل"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[52,"وقوم ينظرون إلي شزرا","https://www.aldiwan.net/poem62228.html","البسيط"],[48,"كأنك عن كيد الحوادث راقد","https://www.aldiwan.net/poem22318.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[92,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[93,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[121,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[401,"سيجرح جراح وأعقل ضيمه","https://www.aldiwan.net/poem568.html",""],[458,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[458,"ذكرى يرددها الزمان الوافي","https://www.aldiwan.net/poem61693.html","الكامل"],[463,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[484,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[534,"نصر وتأييد من الرحمن","https://www.aldiwan.net/poem37106.html","الكامل"],[543,"إن تشا تحيى سعيدا","https://www.aldiwan.net/poem48212.html","عموديه"],[567,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48753","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64076","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56664","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56621","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64634","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78042","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52072","الطويل"],[2370,"","https://poetry.dctabudhabi.ae/diwan/poem/121518","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137270",""],[447,"","https://poetry.dctabudhabi.ae/diwan/poem/96823","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94096","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109848","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132541","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130107","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130092","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145055","الهزج"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68015","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74104","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66355","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21495","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131007",""],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139841",""],[4221,"","https://poetry.dctabudhabi.ae/diwan/poem/132504","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139759",""],[4692,"سيجف ما في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=196828",""],[4699,"إلى باكية","https://www.poetsgate.com/ViewPoem.aspx?id=154104",""],[4755,"المُخَلِّص","https://www.poetsgate.com/ViewPoem.aspx?id=184721",""],[5090,"بيت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=184647",""],[5093,"رؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=145831",""],[5119,"النرد","https://www.poetsgate.com/ViewPoem.aspx?id=196606",""],[5278,"قِف... لا تَبِعْ ما ليسَ لَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=202801",""],[5281,"المثلُ الأعظم","https://www.poetsgate.com/ViewPoem.aspx?id=201367",""],[5295,"جَبَّارَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=177365",""],[5302,"لقاء بعد غياب","https://www.poetsgate.com/ViewPoem.aspx?id=215673",""],[5431,"الناي يشدو مسمعا عذره","https://www.poetsgate.com/ViewPoem.aspx?id=196785",""],[5444,"شمسُ الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=205079",""],[5616,"إلى ممثلة","https://www.poetsgate.com/ViewPoem.aspx?id=205251",""],[5622,"مليون يتم","https://www.poetsgate.com/ViewPoem.aspx?id=210323",""],[5640,"شامية","https://www.poetsgate.com/ViewPoem.aspx?id=206110",""],[5688,"سيجمعني بك الرحمان يوما","https://www.poetsgate.com/ViewPoem.aspx?id=200761",""],[5691,"شمعة للجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=206854",""],[5809,"يوم آخر","https://www.poetsgate.com/ViewPoem.aspx?id=205658",""],[5818,"دموع وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193070",""],[5956,"سيجيء يوم ما","https://www.poetsgate.com/ViewPoem.aspx?id=193994",""],[5956,"أمضي للقيا متعب ووليدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194150",""],[5956,"كمُنتَظِر النسائم أن تهبّا","https://www.poetsgate.com/ViewPoem.aspx?id=194389",""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[5956,"وتعاونوا على البِرِّ والتقوَى","https://www.poetsgate.com/ViewPoem.aspx?id=194825",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[6152,"يفتح الله بعد الضيق أبوابا","https://www.poetsgate.com/ViewPoem.aspx?id=213184",""],[406,"إلى ياسر عرفات ( بعها )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=840&r=&rc=31",""],[6332,"خجل الصّحوُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65172&r=&rc=1",""]],"verses":[["سيجري لك الشكر لن يَنضُبا","ويجري الزمان به مُغْرقا",0,"ق",2,0],["سيَّج ورد الخدود بالآس","فما لجرحي عليه من آسي",1,"س",2,1],["سيجعل اللَّهُ لكلٍّ مَخرجا","ويعْرُجُ البرُّ إليهِ مَعْرَجا",2,"ج",2,0],["سيجري على مثل مجراكمُ","أخو ثقتي جري لا نازع",3,"ع",1,0],["سيجزي اللَّهُ ما أوليتموني","لكم صاعٌ بصاعِكُمُ مَكيل",4,"ل",1,0],["سيجعلُ الله بعد عُسرٍ","يُسراً بجدوَى أبي الحُسَيْنِ",5,"ن",1,0],["سَيَجزيهُمُ عَنِ البُؤَساءِ رَبٌّ","يُكافِئُ بِالجَميلِ المُحسِنينا",6,"ن",2,0],["سيجرُفُكَ السَّيْلُ سَيْلُ الدِّماءِ","ويأْكُلُكَ العَاصِفُ المشتَعِلْ",7,"ل",1,0],["سَيَجمَعُني بِكِ التاريخُ يَوماً","إِذا ظَهَرَ الكِرامُ عَلى اللِئامِ",8,"م",1,0],["سَيَجبُرُ كَسري المَصقَلِيّونَ إِنَّهُم","بِهِم تُدفَعُ الجُلّى وَيُجتَبَرُ الكَسرُ",9,"ر",1,0],["سَيَجزي وَكيعاً بِالجَماعَةِ إِذ دَعا","إِلَيها بِسَيفٍ صارِمٍ وَسِنانِ",10,"ن",1,0],["سيجلو دُجى الدين الحنيفِ سُرادقٌ","من الشمس فوق البّر والبحر مضروب",11,"ب",1,0],["سَيُجدي حِلمُهُم أَو يَنكُروني","فَإِنَّ تَقَدُّمي قَبلَ اِنتِقامي",12,"ي",1,0],["سَيَجري عَلى نيرانِ فارِسَ طارِقٌ","فَتَخمُدُ وَالمِرّيخُ في العَينِ راقِدُ",13,"د",1,0],["سيجني شباب الشام منه فوائداً","وَعلماً لهم والعلم أَحسن ما يُجنى",14,"ن",2,0],["سيُجْريهِ ما شاءَتْ مطامعُ قومِهِ","ويحبسُهُ ما شاءَ خَلْفَ سدودِ",15,"د",1,0],["سيجلِدُهم إلى أنْ يُقنِعوه","بأنهم أناسٌ أبرياء..!",16,"ا",2,0],["سيُجازُ شَهرٌ بالعَناء وآخَرٌ","ويُخاضُ عامٌ بالدماء وعام",17,"م",1,0],["سيجزيهم عم البؤساء ربّ","يكافيء بالجميل المحسنينا",18,"ن",2,0],["سَيُجِيبُ طَبْعُ الزُّورِ تَحتَ جُلُودِكُمْ","صَدَّامُ في جَبَرُوتِهِ العَرَّابُ",19,"ب",1,0],["سَيجرحُ جُراحُ وأعقلُ ضَيمهُ","إذا كان مَخشياً من الضلع المُبدي",20,"ي",1,1],["سيجيء عهد نحتفي شرفا به","كالشمس والجوزاء غب غيومنا",21,"ن",2,0],["سيجئ يومٌ للحسابِ قُضاتُهم","تِلكَ العِظامُ بِغضبةِ الإنصافِ",22,"ف",1,0],["سيجمعها وإن طُفْتُ انتشاراً","عظيمٌ لا يروَّعُ بالعظيمِ",23,"م",1,0],["سيجذب مسحوبا على حُرّ وجهه","فاتعس به شخصا نحيسا مجرجرا",24,"ر",2,0],["سيجت أنهاجه من قضبها","وعليها ذلك النور السني",25,"ي",1,0],["سَيَجْعَلُ الرَّحْمنُ لي سُلْطانا","يَكُونُ مِنْ لَدَيْهِ لي مِعْوانا",26,"ن",2,0],["سَيُجَازَى بِالمُنى عن","بَذلِه أقصَى الجُهُود",27,"د",1,0],["سيَجبُرُ اللهُ قَلباً باتَ مُنكسراً","وليسَ يَترُكُ جَمْراً كانَ يَضطِرمُ",28,"م",1,0],["سيجلو عن الأرض جبّارها","ويلبث فيها كريم الشيم",29,"م",1,0],["سيجيزني بحرَ الأسى مَنْ كَفُّهُ","بحرٌ بحارُ الأرضِ فيه تَغْرَق",30,"ق",1,0],["سيجزيك عن آلامه بدعائه","ويرجو لك الإسعاد وهو يعذب",31,"ب",1,0],["سيجارتي مشعلة في فمي","والطرس محمول على أنملي",32,"ي",1,0],["سيجدي الأسى لو أن في الموت ما يجدي","فخل فصيح الدمع يبدي الذي يبدي",33,"د",2,1],["سيجلي بنزعة يقصر الته","ذيب عنها وسوف يبدو الجلاء",34,"ا",2,0],["سَيَّج الوَرد بِها آس العذار","عِندَما عَمَ الشَقيق السوسَنا",35,"ن",2,0],["سَيَجْمَعُكُمْ فِي قَبْضَةٍ وَيَجُزُّكُمْ","كَمَا جُزَّ مِنْ أصْلِ النَّبَاتِ فَصِيلُ",36,"ل",1,0],["سيجشمون من العقاب أمره","إن تجمعوا أمرا لكم أو تصمموا",37,"م",3,0],["سيجني بها الشرق زهر المنى","ويقطف منها ثمار الوئام",38,"م",1,0],["سيجمعنا داعي المنون ببلقع","بعيد عن الأهلين والمال والصحب",39,"ب",1,0],["سيج الآس روض ورد تورد","أم نضار مرصع بزبرجد",40,"د",1,1],["سيجزيك عني الشعر ان ثناءه","كرفدك عندي لا بطئ ولا نزر",41,"ر",1,0],["سيجيئك النصر الذي","ترجو فتبسم عن كثب",42,"ب",1,0],["سيجلّ تعليمَ البنات مليكُنا","ويساعد الضعفاء ذاك الضيغَمُ",43,"م",1,0],["سيجعله الرحمنُ فاروق أمرنا","يفرّق عنّا ما نخاف ونحذرُ",44,"ر",1,0],["سيجزي سعيه التاري","خ ما لم يجزه جاز",45,"ز",1,0],["سيَجْمعُنا بعدَ التفرق مَجْمَعُ","تَظلُّ بِهِ وُرْقُ البشائرِ تَسْجَعُ",46,"ع",1,1],["سَيَجمَع منّا الشَمل في كلّ مجمعٍ","مصادره تَحلو لَنا وَالمَوارِدُ",47,"د",1,0],["سيجزى على بنيانه من الهنا","جزاء له يوم الجزاء وفور",48,"ر",1,0],["سَيَجعَلُ جَنّاتِ النَعيمِ لِباسَكُم","إِذا ما التَقَيتُم أَيُّكُم كانَ أَسعدا",49,"د",2,0],["سيجعله الأملاك للسلم مدفنا","عليه تماثيل المطامع توضع",50,"ع",1,0],["سيجعل الله من ضيق البلا فرجا","وربنا راحم من عز راحمه",51,"م",2,0],["سيجمعُ الله ما بينَ الخصومِ غداً","ويدفعُ المجرمَ الجاني إِلى سَقَرا",52,"ر",2,0],["سيجعل اللهُ بعد العسر ميسرةً","لنا بكم ورضانا في مراضيه",53,"ي",2,0],["سيجف ما في القلب ثم سيذهب","ويعود إحساسي الذي لا ينضب",54,"ب",1,1],["سيجيء اليوم ويجمعنا","بيتٌ وتضمكِ أجفاني",55,"ن",2,0],["سَيَجيئُ مِن رَحِمِ الأذِلَّةْ","طِفلٌ تُنَضِّجُهُ الأهِلَّةْ",56,"ل",2,1],["سَيَجيئُ يَرفَعُ رايَةً","في كُلِّ مُنْعَطَفٍ مُطِلَّةْ",56,"ل",2,0],["سيجنُ عقلي والفؤادُ وخاطري","هذا مصيري إن هجرتك هذا",57,"ذ",2,0],["سيجمع الشمل يا قلبي فلا ألمٌ","إن لم يكن في غدٍ لا بدَّ بعد غدِ",58,"د",1,0],["سيجارةُ واسْتَحتْ أنثى ومنضدةٌ","تراقب ال كان في الفنجانِ يرثِيها",59,"ي",3,0],["سيُجيبُ فوراً ، إِنَّها","تقْوَى الذي قد عدّلَكْ",60,"ك",1,0],["سيجعلُ اللهُ بعدَ العُسرِ مَيسرةً","وَعدًا عليهِ، وذاكَ الوَعدُ يكتملُ",61,"ل",1,0],["سيجوبُ في دُنيا العذابِ مُرَنِّما","بالروحِ يا كُل المُنى أَفْديكِ",62,"ك",1,0],["سيجمع الله من غابوا ويسعدهم","بموعد فيه صحب كالضيا طلعوا",63,"ع",3,0],["سيجيئ جُنْح الليل يخبره","أن العقوبة في الهوى مرّه",64,"ر",2,0],["سيُجيبُ كَهلٌ ظلَّ يحلبُ شاتَه","وكأنَّه حلبَ الزمانَ أمانا",65,"ن",2,0],["سيُجيبُ ذِميٌ يقول لإبنه","لنْ تلقَ مثل سلوكِهم أديانا",65,"ن",2,0],["سَيَجِفُّ عُشْبُ النَّهْرِ - سَيِّدَتِي -","وَيَجِفُّ عِنْدَ خَرِيفِهِ النَّهْرُ",66,"ر",1,0],["سيجارةٌ وبقايا هيكلٍ... رِممُ","ما للوجوه التي يغتالُها العدمُ",67,"م",1,1],["سَيُجيبُ صَمْتُكَ والرِّجالُ مَواقِفٌ","إنّي غريبٌ عابِرٌ وسأرْحَلُ",68,"ل",1,0],["سيجمعني بك الرحمان يوما","عساه بهذه يقضي عساه",69,"ا",2,0],["سيَّجوا الأرضَ بالشهادةِ حتى","أرْجَعوا مجدَ أمتي العربيَّهْ!",70,"ي",2,0],["سيجيء يومٌ بعدَ يومِك ذا بهِ.","تبكي على هذا أسىً لو يرجعُ",71,"ع",1,1],["س يجري الماءُ في البيداءِ يومًا","كما تجرينَ في مجرى الدماءِ",72,"ا",2,0],["سيجيء يوم ما بلادي تستقي","من شعريَ الإلهام كالأدواءِ",73,"ا",2,0],["سيجنّ بي من فور أن أصل الحِمى","ويطير بي لكواكبٍ من جودِهِ",74,"د",2,0],["سيجزيكم تعالى خيرَ أج