لمَغاوِرِ",1,"ر",1,0],["جَزَروا جَزرَ الأَضاحي نَسلَهُ","ثُمَّ ساقوا أَهلَهُ سَوقَ الإِما",2,"ا",1,0],["جَزاءُ أَميرِ المُؤمِنينَ ثَنائي","عَلى نِعَمٍ ما تَنقَضي وَعَطاءِ",3,"ا",2,1],["جَزى اللَهُ الأَغَرَّ جَزاءَ صِدقٍ","إِذا ما أوقِدَت نارُ الحُروبِ",4,"ب",1,1],["جَزى اللَهُ الجَوادَ اليَومَ عَنّي","بِما يَجزي بِهِ الخَيلَ العِتاقا",5,"ق",2,0],["جَزى الرَحمَنُ أَفضَلَ ما يُجازى","عَلى الإِحسانِ خَيراً مِن صَديقِ",6,"ق",1,1],["جَزِعتُ عَلَيها لَو أَرى لِيَ مَجزَعاً","وَأَفنَيتُ دَمعَ العَينِ لَو كانَ فانِيا",7,"ي",2,0],["جَزَتْنيَ غَرْناطَةٌ بعْدَ ما","جَلَوْتُ مَحاسِنَه بالجَلا",8,"ل",2,1],["جزْلُ العَطاءِ لوْ أنّ البَحْرَ نائِلُهُ","لقَلّ في جودِهِ الفَيّاضِ ما بَذَلا",9,"ل",2,0],["جَزَيْنَا صَنِيعَ اللَّهِ شَرَّ جَزَائِهِ","فَلَمْ نَرْعَ مَا مِنْ سَابِقِ الْفَضْلِ أَوْلاَنَا",10,"ن",2,0],["جَزَى اللَّهُ يُوسُفاً خَيْرَ مَا جَزَى","مُلُوكَ بَنِي نَصْرٍ عَنِ الدِّينِ وِالْعِلْمِ",11,"م",1,0],["جَزَى اللهُ عَهْدَ الْقُرْبِ خَيْرَ جَزَائِهِ","بِأَعْظَمَ مَا يُجْزِي بِهِ حَقُّ مُنْعِمِ",12,"م",1,0],["جُزْ عَلَى إِجْرَعِ الْحِمَى لاَ مَحَالَهْ","وَتَعَرَّضْ لِرَائِدِ الرَّحَّالَهْ",13,"ل",2,0],["جُزِيتَ يَاابْنَ رَسُولِ اللَّهِ أَفْضَلَ مَا","جَزَى الإِلَهُ شَرِيفَ الْبَيْتِ يَوْمَ جَزَى",14,"ز",2,1],["جَزاكَ الذي سَنّى مقامَكَ عِصْمَةً","يُفَكُّ بِها عانٍ ويُنْعَشُ مُضْطَرُّ",15,"ر",1,0],["جَزَى اللهُ عنّا الدّهْرَ خيْرَ جَزائِه","وإنْ سَبَقَتْ منْهُ خُطوبٌ كَوارِثُ",16,"ث",1,0],["جَزى رَبُّهُ عَنّي عَديَّ بِن حاتِمٍ","جَزاءَ الكِلابِ العاوياتِ وَقَد فَعَل",17,"ل",1,1],["جَزى اللَهُ رَبُّ الناسِ خَيرَ جَزائِهِ","أَبا ماعِزٍ مِن عامِلٍ وَصَديقِ",18,"ق",1,1],["جَزى اللَهُ شَرّاً كُلَّ مَن نالَ سَوءَةً","وَينَحَلُ مِنها الرَبَّ في عُذرِهِ الرِدا",19,"ا",1,0],["جَزاكَ اللَهُ ما يَجزي كَذوباً","أَثيماً قالَ بُهتاناً عَظيما",20,"م",2,0],["جَزى الإِلَهُ إِياساً خَيرَ نِعمَتِهِ","كَما جَزى المَرءَ نوحاً بَعدَما شابا",21,"ب",2,0],["جَزى اللَهُ فيما بَينَنا شَيخَ مِسمَعٍ","جَزاءَ المُسيءِ حَيثُ أَمسى وَأَشرَقا",22,"ق",2,0],["جَزى اللَهُ تَيماً مِن أَخٍ كانَ يَتَّقي","مَحارِمَ تَيمٍ ما أَخَفَّ وَأَرهَقا",22,"ق",2,0],["جُزتَ سَبعينَ حِجَّةً لا تُبالي","بِشِهادٍ تَعاقَبَت أَم بِصابِ",23,"ب",1,0],["جَزِعَ الشَرقُ كُلُّهُ لِعَظيمٍ","مَلَأَ الشَرقَ كُلَّهُ إِعجابا",24,"ب",2,0],["جَزَعَ الهِلالِ عَلَيكَ يَومَ تَرَكتَهُ","ما بَينَ حَرِّ أَسىً وَحَرِّ أُوارِ",25,"ر",1,0],["جُزتَ يَوماً بِنا وَنَحنُ عَلى الجِس","رِ قِيامٌ وَاللَيلُ لَيلُ التَمامِ",26,"م",1,0],["جَزَّت غَدائِرَ شِعرٍ سَرَّحَت سُفُناً","وَاِستَنقَذَت وَطَناً وَاِستَرجَعَت نَشَبا",27,"ب",2,0],["جَزَزتَ لِمَّتَه لمّا أُتِيتَ به","ففاقَ عاطِلُها في الحُسنِ حاليها",28,"ي",3,0],["جَزاءَ ما رَفَّهَ شُربَ المُنى","وَأَذَّنَ السَعيُ بِوَشكِ النَجاح",29,"ح",1,0],["جَزى اللَهُ الأَغَرَّ يَزيدَ خَير","وَلَقّاهُ المَسَرَّةَ وَالجَمالا",30,"ل",2,0],["جَزَعتُ وَلَم أَجزَع مِنَ البَينِ مَجزَع","وَعَزَّيتُ قَلباً بِالكَواعِبِ مولَعا",31,"ع",2,1],["جُزنَ وادي المِياهِ مُحتَضِراتٍ","مَدرَجَ العَرجِ سالِكاتِ الخلالِ",32,"ل",1,0],["جَزى اللَهُ حَيّاً بالموقر نَضرَةً","وَجادَت عَلَيهِ الرائِحاتُ الهَواتِكُ",33,"ك",1,0],["جَزى اللَهُ خَيراً خِندِقاً مِن مَكافِئ","وَصاحِبِ صِدقٍ ذي حِفاظٍ وَمِصدَقِ",34,"ق",1,0],["جَزَتكَ الجَوازِي عَن صَدِيقُكَ نَضرَةً","وَأَدناكَ رَبِّي في الرَّفيقِ المُقَرَّبِ",35,"ب",1,1],["جَزَزنا نَواصِيَ فُرسانِها","وَكانوا يَظُنّونَ أَن لا تُجَزّا",36,"ز",2,0],["جزت الحقيقة في السناء وفي السنى","تنأى لطفاً كالخيال العابر",37,"ر",1,0],["جَزَاهُمُ اللهُ خَيْراً عَنْ أَخٍ رَفَقَتْ","بِهِ الحياةُ وَقَدْ قَامُوا بِجَانِبِهِ",38,"ب",2,0],["جَزَاهُمُ اللهُ خَيْراً بِالَّذِي صَنَعُوا","وَيَصْنَعُونَ وَلا رِيعُوا بِحِدْثَانِ",39,"ن",1,0],["جِزِّينُ فِي هَذِي الحِلَى مَوْفُورَةٌ","نَعْمَاؤُهَا مَرْفُوعَةُ البُنْيَانِ",40,"ن",1,0],["جَزِعَتْ فِلَسْطِينُ وَقَبْلَ رَدَاهُ لَمْ","يَجْزِعْ لِرُزْءٍ قَوْمُهَا الشُّجْعَانُ",41,"ن",1,0],["جَزَعُ المَحَابِرِ وَالمَنَابِرِ أَنَّهَا","قَدْ بُدِّلَتْ مِنْ عِزِّهَا بِهَوَانِ",42,"ن",1,0],["جَزِعَا لِهَذا البَيْنِ حَتَّى كَانَ لا","يَلْهُو بِشَيْءٍ ذَانِكَ الفَتَيانِ",43,"ن",1,0],["جَزِعَ الصَّبُورُ وَقَدْ سَكَنْتِ لِمَا دَهَى","تِلْكَ العَزِيمَةَ فِي فَتَى الْفِتَيَانِ",44,"ن",1,0],["جُزِيتِ كُلَّ الخَيْرِ يَا زَعِيمَةً","بِهَا يُبَاهِي قَوْمُهَا الأَقْوَامَا",45,"م",2,0],["جَزَاءٌ وِفَاقاً يَسْتَوِي النَّاسُ عِنْدَهُ","وَمَا يَسْتَوِي فِيهِ شَحِيحٌ وَمُنْعِمُ",46,"م",1,0],["جَزِعَ الْهِلالُ عَلَى مُعِزِّ لِوَائِهِ","وَبَكَى أَشَدَّ حُمَاتِهِ الإِسْلامُ",47,"م",1,0],["جَزَعاً لِلفراقِ يَومَ تَوَلَّت","حَسِبيَ الله ذو المَعَارجِ حَسبِي",48,"ب",2,0],["جَزى اللَهُ البَراقِعَ مِن ثِيابٍ","عَنِ الفِتيانِ شَرّاً ما بَقينا",49,"ن",2,1],["جزى الله ذاك العهدّ عَوْداً فطالما","أعاد على ربعي الظباء الجوازيا",50,"ي",2,0],["جزيت به كلاًّ على حال سعيه","فما غرسَتْ يمناهُ أصبح جانيا",50,"ي",2,0],["جُزوها عقوقاً وهي أمٌ كريمة","والأم أبناء الكريمة من عقّا",51,"ق",2,0],["جَزى اللَهُ زيقاً وَاِبنَ زيقٍ مَلامَةً","عَلى أَنَّني في وُدِّ شَيبانَ راغِبُ",52,"ب",1,0],["جَزى اللَهُ لَيلى في جُبَيرٍ مَلامَةً","وَقَبَّحَ قَيناً بِالفَرَزدَقِ أَعوَرا",53,"ر",2,0],["جُزيتِ أَلا تَجزينَ وَجداً يَشُفُّني","وَإِنِّيَ لا أَنساكِ إِلّا عَلى ذُكرِ",54,"ر",1,0],["جَزى اللَهُ يَربوعاً مِنَ السيدِ قَرضَها","وَما في شِيَيمٍ مِن جَزاءٍ وَلا شُكرِ",54,"ر",1,0],["جَزَعاً بَكيتُ عَلى الشَبابِ وَشاقَني","عِرفانُ مَنزِلَةٍ بِجِزعَي ساجِرِ",55,"ر",1,0],["جُزيتَ الطَيِّباتِ أَخاً لِقَومٍ","أَخاً يا عُروَ كُنتَ لَهُم جِماعا",56,"ع",2,1],["جَزِعتَ اِبنَ ذاتِ الفَلسِ لَمّا تَدارَكَت","مِنَ الحَربِ أَنيابٌ عَلَيكَ وَكَلكَلُ",57,"ل",1,0],["جَزِعتُم إِلى صَنّاجَةٍ هَرَوِيَّةٍ","عَلى حينِ لا يَلقى مَعَ الجِدِّ باطِلُه",58,"ل",2,0],["جَزُّ ذِي الصُّوفِ وانتِقَاءٌ","لِذِي المُخَّةِ وانعَق وَدَعدَعاً بالبِهَامِ",59,"م",1,0],["جَزَيتُ سَفيهَهُم سوءً بِسوءٍ","فَلا حَرَجاً أَتَيتُ وَلا جُناحا",60,"ح",2,0],["جَزى اللَهُ مَخزوماً بِأَسوَا صَنيعِها","أَبى غَيرَ لُؤمٍ كَهلُها وَوَليدُها",61,"ه",2,1],["جَزَعاً عَلى المَهدِيِّ أَصبَحَ ثاوِياً","يا خَيرَ مَن وَطِئَ الحَصى لا تَبعُدِ",62,"د",1,0],["جزل الندى والبأس لو لمس الصفا","لجرى ولو لمس الحديد لفلذَّا",63,"ذ",2,0],["جزيت عن الإسلام خيراً فطالما","خبا شرَرٌ عنه بعزمِك أو شرّ",64,"ر",1,0],["جزل العطا والبأس حينَ خبرته","كالسيف