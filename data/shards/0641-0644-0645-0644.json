{"poems":[[88,"فتى الشعر هذا موطن الصدق والهدى","https://www.aldiwan.net/poem10691.html","الطويل"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[45,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[47,"على مثل رأسك زال السرور","https://www.aldiwan.net/poem10902.html","المتقارب"],[47,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[69,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[208,"وفيت وما لك إلا الوفا","https://www.aldiwan.net/poem53244.html","المتقارب"],[240,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[303,"حماة الديار","https://www.aldiwan.net/poem36297.html","عموديه"],[308,"تجمع في عاقل شملنا","https://www.aldiwan.net/poem58195.html","المتقارب"],[369,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[369,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[408,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[438,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[473,"غناء شحارير وزمر بلابل","https://www.aldiwan.net/poem59566.html","الطويل"],[482,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[487,"سلام كما حيتك عاطرة النشر","https://www.aldiwan.net/poem24379.html","عموديه"],[580,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102039","الطويل"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/107099","المتقارب"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145628","الرجز"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100134","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16883","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56183","الوافر"],[1351,"","https://poetry.dctabudhabi.ae/diwan/poem/130686","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49992","الطويل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146085","الوافر"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106727","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100461","المتقارب"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144620","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143016","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53066","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65955","الطويل"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96434","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74028","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48339","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141528","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78358","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119659","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93303","المتقارب"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4680,"قيثارة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=185069",""],[4858,"ضعيفاً قد خُلِقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=155356",""],[5319,"تذكر عزيز ليالينا","https://www.poetsgate.com/ViewPoem.aspx?id=189016",""],[5431,"وأفضل الفعل حب الله والناس","https://www.poetsgate.com/ViewPoem.aspx?id=194507",""],[5621,"السحر المطلق","https://www.poetsgate.com/ViewPoem.aspx?id=24568",""],[5674,"إني آسف آسف","https://www.poetsgate.com/ViewPoem.aspx?id=207877",""],[5842,"إلى بشار الأسد بعد خطابه الثاني ( ثائر على الأسد )","https://www.poetsgate.com/ViewPoem.aspx?id=62445",""],[5881,"وهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=183798",""]],"verses":[["فَلِم لا نَرى الأَهرامَ يا نيلُ مُيَّداً","وَفِرعَونُ عَن واديكَ مُرتَحِلٌ غَدا",0,"د",2,0],["فَلِم لا نَرتَجيكَ لَهُم وَكُلٌّ","يَعيشُ بِأَن تَعيشَ وَأَن تَدوما",1,"م",2,0],["فَلِم لا تُلومُ الَّذي لامَها","وَما فَصُّ خاتَمِهِ يَذبُلُ",2,"ل",1,0],["فَلِم لا تُعَدُّ مِنَ الأَجوَدي","نِ وَمُلكُ خُراسانِ مِمّا تَهَب",3,"ب",1,0],["فَلِم لَم تَزَعهُ الوازِعاتُ وَيَجتَنِب","عَداوَةَ مَنصورِ اليَدَينِ عَلى العِدى",4,"د",2,0],["فلِمْ لا شاطَرُوا فيما اسْتَفادوا","كما كانَ الصَّحابَةُ يَفْعَلُونا",5,"ن",2,0],["فلِم لا أُواصِل مَن لو جفا","لكدَّر من عيشتي ما صفا",6,"ف",2,0],["فَلِمُلكِهِ رَأدَ الضُحى تَثقيفُهُ","وَلِرَبِّهِ جُنحَ الدُجى إِخباتُهُ",7,"ت",2,0],["فَلِمْ لا نسودُ","وَلِمْ لا نشيد",8,"د",1,0],["فلم لا أجحن إذا ما بدت","سلاسلُ برقٍ على عاقلِ",9,"ل",1,0],["فلِمْ لا تَرِقُّ لأشباهها","عيونٌ مِراضٌ كعُشَاقها",10,"ق",3,0],["فلِمْ لا يَعْتلي فيفوقُ مَدْحٌ","بمَمْدوح لأهْلِ الأرضِ فاقا",11,"ق",2,0],["فَلِمْ لاَ تَمُورُ الأَرض حُزْناً وكَيْفَ لاَ","من الفَلكِ الدوَّارِ تهوي كَواكبُهْ",12,"ب",2,0],["فلِم لغيرِ زلةٍ هجرْتَني","ذاك لفرطِ الحب والتدلّلِ",13,"ل",1,0],["فَلِمَ لا يَرانا الرَوضُ في سوقِهِ الَّتي","بِها كُلَّ أَنواعٍ وَكُلُّ فُنونِ",14,"ن",1,0],["فلمْ لا يُراعيني وقد أسهلَ الهوى","بغيري وطُرْقي فيه أمسينَ أوعارا",15,"ر",2,0],["فلم لا تصحبونا في الركب","وابشر فقد جئت المقام بلا فخر",16,"ر",1,0],["فلِمْ لا نهيتَ الثَّغْر أَن يَعْذُبَ اللَّمى","ولِمْ لا أَمَرْتَ الصَّدرَ أَنْ يَكْتُمَ النَّهْدا",17,"د",2,0],["فلم لي إذا ما الشعريان تجارتا","دموع جرت شعراً تبل شعاري",18,"ر",2,0],["فلِم لا أكون ضنيناً بها","وأجعلها في صلاح وطاعه",19,"ه",1,0],["فَلَمْلَمَتْ جِرَاحَها","وَفَجْوَةَ التَّشَقُّقِ",20,"ق",1,0],["فلم لا ناله صرف الليالي","وكان لصرفهن هو العمادا",21,"د",2,0],["فَلِمَ لَم تَكُن فيهِم فَيَكمَلَ حُسنُهُم","أَيا ظالِماً أَخلى النُجومَ مِنَ البَدرِ",22,"ر",1,0],["فلم لا تنقضي يا عمر قبلاً","ولم لا كنتِ يا روحي فداهُ",23,"ا",2,0],["فلم لا أرجّي فيك يا غاية المنى","حماً مانعاً إذ صحّ هذا من العرب",24,"ب",1,0],["فلمْ لا أرى لي قائلاً عند نعمةٍ","هَنيئاً ولا إن عارَضت عثْرةٌ لَعَا",25,"ع",2,0],["فلم لا ينتهي ويكفَّ عني","عقابك بعد ما انتهت الذنوب",26,"ب",1,0],["فَلِم لا تَجُرُّ الذَيلَ فَخراً وَقَد سَمَت","بِهِ حَيثُ لَم تَسمُ شُموسٌ وَأَنجَمُ",27,"م",1,0],["فلم لا أقالك صرف الزمان","وكنت المقيل إذا ما استقال",28,"ل",1,0],["فلم ليلة بتنا ضجيعين لم أخف","رقيبا ولم أحفل بما قال قاذف",29,"ف",1,0],["فلملمي الشمل حرّاً","لا يقبل المستبدَّا",30,"د",2,0],["فلم لا أملأ الآفاق طيباً","بما أتلو عليك من امتداح",31,"ح",1,0],["فلم لامني من لام إِذ صرت مبغضاً","لقربك أم ما فيك خلد لخالد",32,"د",1,0],["فلمل صدرنا عن زبالة وارتمت","ببنا العيسُ فيها منقلاً ثم منقلا",33,"ل",2,0],["فَلم لا أَخض تيّار كلّ عَظيمةٍ","بكلّ جَواد لجّة الخطب خائضِ",34,"ض",1,0],["فلِمْ لا أوَفّي العهْدَ والفضْلُ شيمَتي","وأنّ وفائِي لا يُروَّعُ بالغَدْرِ",35,"ر",1,0],["فلِم لا تَرعَوِي ياغُمرُ حتى","اضعتَ العُمرَ في غُمَر الأَثامِ",36,"م",1,0],["فلمْ لي وحدي ألف فرعون في الورى","ولي ألف نمرودٍ وألف أبو جهلِ",37,"ل",1,0],["فَلَم لا أَنعى بِالحَسراتِ حالي","وَتَعلو زفرتي لِلفرقَدين",38,"ن",1,0],["فلم لا بقيتِ يا ابنة الروح عندنا","طعامك ممزوج حليبٌ وسُكّرُ",39,"ر",1,0],["فَلِمْ لا أَتيه على العالمين","وفَوقي جَوادٌ وتحتي جَواد",40,"د",1,0],["فلم لا يقول الحق في سيد سما","وناجاه رب بالجلال تفردا",41,"د",2,0],["فلملميني من المجهول إنَّ صدى","جرحي يناديكِ يا غوثي ومنقذتي",42,"ت",2,0],["فلِمْ لا تَصلُحُ الأعمالُ منّا","ونُحْسِنُ عِشْرَةً لذوي الخِلال ؟",43,"ل",1,0],["فلم لا تشمر عن ساعد","وتضرب بالسيف في المغربين",44,"ن",1,0],["فلملم الحزن سيل الحزن مهلكنا","إن نمتطي الصبر لن يرقى بإمساسِ",45,"س",1,0],["فلَمْلَمَتْ في ثوبِها عُرْيَها","وأطْرَقَتْ تحْتجُّ منْ منطِقي",46,"ق",2,0],["فَلَمْلِمِ الوَقْتَ حَتّى لا يَضيعَ سُدى","زَمانُها الغَضُّ في نَهْرِ الهَوى الجارِفْ",47,"ف",1,0],["فلمْلِمْ بقاياكَ قبلَ احتراقٍ","بنارِ المذلّةِ , ما مِنْ بديلِ",48,"ل",1,0],["فلملم أوجاع الهوى في حقيبةٍ","وهاجر يطويه المدى والحرائق",49,"ق",1,0]]}