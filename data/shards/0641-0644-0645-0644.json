{"poems":[[86,"فتى الشعر هذا موطن الصدق والهدى","https://www.aldiwan.net/poem10691.html","الطويل"],[85,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[43,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[45,"على مثل رأسك زال السرور","https://www.aldiwan.net/poem10902.html","المتقارب"],[45,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[204,"وفيت وما لك إلا الوفا","https://www.aldiwan.net/poem53244.html","المتقارب"],[235,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[298,"حماة الديار","https://www.aldiwan.net/poem36297.html","عموديه"],[303,"تجمع في عاقل شملنا","https://www.aldiwan.net/poem58195.html","المتقارب"],[364,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[364,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[402,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[432,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[468,"غناء شحارير وزمر بلابل","https://www.aldiwan.net/poem59566.html","الطويل"],[477,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[482,"سلام كما حيتك عاطرة النشر","https://www.aldiwan.net/poem24379.html","عموديه"],[575,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"]],"verses":[["فَلِم لا نَرى الأَهرامَ يا نيلُ مُيَّداً","وَفِرعَونُ عَن واديكَ مُرتَحِلٌ غَدا",0,"د",2,0],["فَلِم لا نَرتَجيكَ لَهُم وَكُلٌّ","يَعيشُ بِأَن تَعيشَ وَأَن تَدوما",1,"م",2,0],["فَلِم لا تُلومُ الَّذي لامَها","وَما فَصُّ خاتَمِهِ يَذبُلُ",2,"ل",1,0],["فَلِم لا تُعَدُّ مِنَ الأَجوَدي","نِ وَمُلكُ خُراسانِ مِمّا تَهَب",3,"ب",1,0],["فَلِم لَم تَزَعهُ الوازِعاتُ وَيَجتَنِب","عَداوَةَ مَنصورِ اليَدَينِ عَلى العِدى",4,"د",2,0],["فلِمْ لا شاطَرُوا فيما اسْتَفادوا","كما كانَ الصَّحابَةُ يَفْعَلُونا",5,"ن",2,0],["فلِم لا أُواصِل مَن لو جفا","لكدَّر من عيشتي ما صفا",6,"ف",2,0],["فَلِمُلكِهِ رَأدَ الضُحى تَثقيفُهُ","وَلِرَبِّهِ جُنحَ الدُجى إِخباتُهُ",7,"ت",2,0],["فَلِمْ لا نسودُ","وَلِمْ لا نشيد",8,"د",1,0],["فلم لا أجحن إذا ما بدت","سلاسلُ برقٍ على عاقلِ",9,"ل",1,0],["فلِمْ لا تَرِقُّ لأشباهها","عيونٌ مِراضٌ كعُشَاقها",10,"ق",3,0],["فلِمْ لا يَعْتلي فيفوقُ مَدْحٌ","بمَمْدوح لأهْلِ الأرضِ فاقا",11,"ق",2,0],["فَلِمْ لاَ تَمُورُ الأَرض حُزْناً وكَيْفَ لاَ","من الفَلكِ الدوَّارِ تهوي كَواكبُهْ",12,"ب",2,0],["فلِم لغيرِ زلةٍ هجرْتَني","ذاك لفرطِ الحب والتدلّلِ",13,"ل",1,0],["فَلِمَ لا يَرانا الرَوضُ في سوقِهِ الَّتي","بِها كُلَّ أَنواعٍ وَكُلُّ فُنونِ",14,"ن",1,0],["فلمْ لا يُراعيني وقد أسهلَ الهوى","بغيري وطُرْقي فيه أمسينَ أوعارا",15,"ر",2,0],["فلم لا تصحبونا في الركب","وابشر فقد جئت المقام بلا فخر",16,"ر",1,0],["فلِمْ لا نهيتَ الثَّغْر أَن يَعْذُبَ اللَّمى","ولِمْ لا أَمَرْتَ الصَّدرَ أَنْ يَكْتُمَ النَّهْدا",17,"د",2,0]]}