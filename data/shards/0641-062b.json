تم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[475,"أرقت من بارق بالجزع لماع","https://www.aldiwan.net/poem15184.html","البسيط"],[475,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[493,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[512,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[513,"يا أكرم الحاضر والبادي","https://www.aldiwan.net/poem12096.html","السريع"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[536,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[536,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[536,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[549,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[549,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[549,"أفي كل يوم لي حميم أفارقه","https://www.aldiwan.net/poem47369.html","الطويل"],[549,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[549,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[556,"يا عابدا ربا بتصويره","https://www.aldiwan.net/poem34459.html","السريع"],[556,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[584,"أنعم إلي سريعا","https://www.aldiwan.net/poem17542.html","المجتث"],[584,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem17714.html","الطويل"]],"verses":[["فَثَمَّ الغَيثُ مَعقودُ النَواصي","وَليثُ الغابِ مَحلولُ الزَئيرِ",0,"ر",1,0],["فَثَمَّ بِشرٌ أَصفى مِنَ الغَدِقِ ال","عَذبِ وَجودٌ أَندى مِنَ السُحُبِ",1,"ب",1,0],["فَثِبْ وَثْبَةً فَيها المَنايَا أَوِ المُنى","فكلُّ مُحِبٍّ لِلْحَياةِ ذَليلُ",2,"ل",1,0],["فثِبْ يا عُبَيدَ اللهِ وثْبَةَ ماجِدٍ","أُعيرَ المَضاءَ السّيْفُ منْ عَزَماتِهِ",3,"ت",2,0],["فثمَّ عَرارٌ يُسْتَطابُ شَميمُهُ","وسِلٌّ كخيطانِ الأراكِ صَفيقُ",4,"ق",1,0],["فَثَوى يَمُدُّ رِشاءَها","وَالنَفسُ تَجهَدُ مِن لَظاها",5,"ا",3,0],["فثَوى تُقَلِّبُهُ الأَكُفُّ مُلَقَّفاً","وَلَهُ تُشَدُّ وَتوضَعُ الأَكوارُ",6,"ر",1,0],["فَثَبَتَّ مُجْمَعَ الْفُؤَادِ بِهَفْوَةٍ","خُذِلَ النَّصِيرُ بِهَا وَخَانَ الْمَعْقِلُ",7,"ل",1,0],["فَثِقْ بالَّذي أَرْعَاكَ أَمْر عِبَادِهِ","وَسَلْ فَضْلَهُ فَاللهُ أَكْرَمُ وَاهِبِ",8,"ب",1,0],["فَثَنَيتُ جيدَ غَريرَةٍ","وَلَمَستُ بَطنَ حِقابِها",9,"ب",3,0],["فَثاروا وَثُرنا وَالمَنِيَّةُ بَينَنا","وَهاجَت عَلَينا غَمرَةٌ فَتَجَلَّتِ",10,"ت",1,0],["فَثَداهُ رَيَمانُ خُفِّها","ذا رَنينٍ صَحِلَ الصَوتِ أَبَح",11,"ح",1,0],["فَثابَرَ بِالرُمحِ حَتّى نَحا","هُ في كَفَلٍ كَسَراةِ المِجَن",12,"ن",1,0],["فَثَلَلتَ العُروشَ عَرشاً فَعَرشاً","وَصَبَغتَ الصَعيدَ بَعدَ الصَعيدِ",13,"د",1,0],["فَثَمَّ مَصايِبُ لا تُتَّقى","لُزومُ الصَلاةِ وَقَصُّ السِبالِ",14,"ل",1,0],["فَثِقي مِنّي بِعَهدٍ ثابِتٍ","وَضَميرٍ خالِصِ المُعتَقَدِ",15,"د",1,0],["فَثِق بِهِزَبرِ الشِعرِ وَاِصفَح عَنِ الوَرى","فَإِنَّهُمُ إِلّا الأَقَلَّ ذُبابُ",16,"ب",1,0],["فَثَوى دونَكَ مَثوى قَلِقٍ","يَشتَكي مِن لَيلِهِ مَطلَ السَحَر",17,"ر",1,0],["فَثارَت تُباري أَعوَجِيّاً مُصَدَّراً","طَويلَ عِذارِ الخَدِّ جُؤجُؤُهُ رَحبُ",18,"ب",1,0],["فَثَوَى قَرِيرَ العَيْنِ مَوْفُورَ الرِّضَا","بِثَوَابِ مَا عَانَى مِنَ الآلامِ",19,"م",1,0],["فثناءً للرافدين وشكراً","وسلاماً عليك يا فَلّوجه",20,"ج",2,0],["فَثَوى وَلَم يوجَع وَلَم","يوصَب وَكانَ هُوَ الفَقيدا",21,"د",2,0],["فَثَنَيتُ كَفّي وَالقُرابَ وَنُمرُقي","وَمَكانَهُنَّ الكورُ وَالنِسعانِ",22,"ن",1,0],["فَثَلاثٌ مِنَ السَراةِ إِلى الحُل","بُطِ لِلخَيلِ جاهِداً وَالرِكابِ",23,"ب",1,0],["فثناني العسر والأو","لاد لا أملكُ فسحه",24,"ح",2,0],["فثنى الملام وقال دونك والأسى","هذي مضايق لست أدخل فيها",25,"ه",2,0],["فَثَلَبْتَ معنى مُحسِنٍ وكلامَهُ","ثلباً جعلتَ كَبَدْيِهِ تعقيبَهُ",26,"ب",2,0],["فثِب إلى عُثنونه ناتفاً","فأْتِ عليه شعرة شعرَه",27,"ر",2,0],["فثِقْ بالذي ترجوه وأْمَنْ من الذي","تُحاذرُهُ قد أخطأتاك الموارطُ",28,"ط",1,0],["فثاروا إلى آلاتهم فتقلدوا","خرائط حمراً تحمل السمَّ مُنقَعا",29,"ع",2,0],["فثواب مثلك صفع أخدعه","بل بصقة في الوجه بل نخعه",30,"ع",2,0],["فثنوْا أعنَّتهم بعزْ","زٍ باذخٍ لا يستذلُّ",31,"ل",1,0],["فثنوا أعنّةَ راجعين بخيبةٍ","كرجوعهم أيامَ ساقوا الفيلا",32,"ل",2,0],["فثوى هامُهم بمثوى هوانٍ","ليس فيه سوى الرياحِ فوالي",33,"ل",2,0],["فَثَنَوا سؤدد الأمير وعَدُّوا","فيه آلاءه بكل لسان",34,"ن",1,0],["فثنت عنكُمُ النُّهى مِنْ عناني","وأمامي مَمَدُّ شأوٍ بطين",35,"ن",1,0],["فَثنوا أرجُلَ النزولِ وحلُّوا","في المقاصير لابسينَ أمانا",36,"ن",2,0],["فَثَمَّ قَرَّت عُيونُ الثائِرينَ بِهِ","وَأَدرَكوا كُلَّ تَبلٍ عِندَهُ قَوَدُ",37,"د",1,0],["فَثِنتانِ مَهما تُعطَيا تَرضَيا بِهِ","وَأَسماءُ ما تَرضى بِثُلثٍ وَلا شَطرِ",38,"ر",1,0],["فَثَمَّ تَناهَينا كِلانا عَنِ الصِبا","وَلا شَيءَ خَيرٌ مِن تُقى اللَهِ وَالصَبرِ",38,"ر",1,0],["فَثَمَّ جَلالٌ يَملَءُ النَفسَ هَيبَةً","وَثَمَّ جَلالٌ يَملَءُ العَينَ باهِرُه",39,"ر",2,0],["فَثاروا إِلَينا في السَوادِ فَهَجهَجوا","وَصَوَّتَ فينا بِالصَباحِ المُثَوَّبُ",40,"ب",1,0],["فثقل من صفع بسجع وما درى","بأن أجل السجع ما خف في السمع",41,"ع",1,0],["فَثارَ إِبراهيمُ لِلثاراتِ","وَأَزعَج المَنصورَ بِالغاراتِ",42,"ت",1,0],["فَثِق فَعَسى الَّذينَ اِرتَبتَ فيهِم","عَلى الأَيّامِ إِخوانٌ ثِقاتُ",43,"ت",1,0],["فَثَبَّتَ الشورى وَشَدَّ عَقدَها","وَقَلَّدَ الجيلَ السَعيدَ عَهدَها",44,"د",3,0],["فَثَمَّ جَلالَةٌ قَرَّت وَرامَت","عَلى مَرِّ القُرونِ الأَربَعينا",45,"ن",2,0],["فَثِب واثِقاً بِاللَهِ وَثبَةَ ماجِدٍ","يَرى المَوتَ في الهَيجا جَنى النَحلِ في الفَمِ",46,"م",1,0],["فثابتٌ في الخَلاصِ منسبِكٌ","وطائرٌ في الخلاصِ منهزِمُ",47,"م",1,0],["فثِقْ باعتقادي في ولائِكَ وارعَ بي","زِمامَ العُلَى إِني بحبلِكَ مُعْصِمُ",48,"م",1,0],["فَثَنوا عَنكَ أَعيُناً وَقُلوباً","لَم يَرُدّوا إِلّا حَسيراً كَليلا",49,"ل",2,0],["فَثِنتانِ مَجدُ الجاهِلِيَّةِ فيهِمُ","وَهُم قَبلَ هَذا الناسِ لِلَّهِ أَسلَموا",50,"م",3,0],["فَثَوى وَغادَرَ فيكُمُ بِصَنيعَةٍ","خَيرَ البُيوتِ وَأَحسَنَ البُنيانِ",51,"ن",1,0],["فثَنى الأرضَ منه محمرَّةَ الأرْ","جاءِ والأفقُ حالكُ الجِلبابِ",52,"ب",1,0],["فَثِق بِمَولاكَ الكَريمِ فَإِنَّهُ","بِالعَبدِ أَرأَفَ من أَبٍ بِبَنيهِ",53,"ي",2,0],["فثالث الشهر مذموم وخامسه","وثالث العشرة الوسطى وسادسها",54,"س",3,0],["فَثَنَينا بِالهَطلِ بَل فَثُنينا","فَمَكَثنا وَنابَتِ الأَشعارُ",55,"ر",1,0],["فَثُب نَحوَ صَحبٍ لَم تَزَل مُتَفَضِّلاً","عَلَيهِمُ وَكانَ الأَفضَلَ المَتَفَضِّلُ",56,"ل",1,0],["فَثُب كُلَّ يَومٍ إِلى قَهوَةٍ","تُشاكَلُ كاساتُها في الصَفاءِ",57,"ا",2,0],["فثقي بأنك قِبلتي أبداً","وصلاةُ روحي حيثما كنتِ",58,"ت",1,0],["فثوبُ الجوّ مُغْبَرُّ الحواشي","ووجهُ الأرض مُحمرُّ الأديمِ",59,"م",1,0],["فَثِقْ بِهِ وَلا يَكُنْ","لغيرِهِ تَضَرُّعُك",60,"ك",1,0],["فَثَناني مِن رَوضِ حُسنِك عَنها","نَرجِسٌ ذابِلٌ وَوردٌ نَضيرُ",61,"ر",1,0],["فثُرتُ وثارتْ معيْ هِمّةٌ","قيامي لَها فارعٌ مِنْ قعودِ",62,"د",1,0],["فَثَقَّلتُ بِالتَخفيفِ عَنكَ وَبَعضُهُم","يُخَفِّفُ في الحاجاتِ حَتّى يُثَقِّلا",63,"ل",2,0],["فَثَمَّ الجودُ مَشدودَ الأَواخي","وَثَمَّ المَجدُ مَضروبَ القِبابِ",64,"ب",1,0],["فَثَوَيتُ جاراً لِلحَضيضِ وَهِمَّتي","قَد طُوِّقَت بِكَواكِبِ الجَوزاءِ",65,"ا",2,0],["فَثِقْ بِذِمَّةِ عَهْدٍ فِيكَ صَادِقَةٍ","فَلَيْسَ كُلُّ خَلِيلٍ صَادِقَ الذِّمَمِ",66,"م",1,0],["فثغرُهُ والشعرُ في خدِّهِ","هذا سُنيناتٌ وهذا نباتْ",67,"ت",1,0],["فَثَنَوا هِزَّةَ المَطيِّ وَقالوا","كَيفَ نَرجو مِن عَرصَةٍ تَكليما",68,"م",2,0],["فَثَنى مَطيَّتَهُ عَلَيَّ وَقالَ لي","إِسأَل وَكَيفَ يَبينُ رَسمٌ أَعجَمُ",69,"م",1,0],["فَثَنائي عَلَيكِ خَيرُ ثَناءٍ","إِن تَقَرَّبتِ أَو نَأَت بِكِ دارُ",70,"ر",1,0],["فَثِق بِاللَهِ وَاِنظُر كَيفَ يَهدي","شُعوبَ الشَرقِ إِذ ضَلّوا السَبيلا",71,"ل",2,0],["فَثابَتِ النَفسُ وَاِرتَدَّ اليَقينُ بِها","وَاِنجابَ ما كانَ مِن ظَنٍّ وَتخييلِ",72,"ل",1,0],["فَثَلَّثت واحداً فَرداً نُوَحِّدُهُ","وَلِلبَصَائِرِ كالأَبْصَارِ تَخْيِيلُ",73,"ل",1,0],["فَثَناءُ واحِدِهمْ ثَناءُ جَمِيعِهِمْ","في الفَضْلِ لِلتَّفْخِيمِ وَالإدْغامِ",74,"م",1,0],["فَثَراهُ وَحَصَاهُ أبَداً","يَفْضُلانِ المِسْكَ وَالدُّرَّ الثَّمينا",75,"ن",2,0],["فثقف حتى ليس فيه تأوّد","وطهر حتى ليس فيه فسوق",76,"ق",1,0],["فثَمّ زَمانٌ كالشّبيبَةِ مُذْهَبٌ","وثَمّ لَيالٍ كالقدودِ نواعِمُ",77,"م",1,0],["فثَمّ مصابيحُ الظّلام وشيعةُ ال","إمامِ وأُسْدُ المأزِقِ المُتَلاحم",78,"م",1,0],["فَثَمَّ أَدري أَشَرَّ قَلبٍ","أَنَّكَ تَأسى عَلى الحَبيبِ",79,"ب",1,0],["فَثَنى عَلَيهِ لَواحِظاً نَطَقَت","مِنهُ بِمِثلِ نَواطِقِ المَسِّ",80,"س",1,0],["فثق بذلك منّي","يا ابنَ الكريم المركّب",81,"ب",1,0],["فَثَوَّرَت بَقَراً ما مِثلُهُم بَقَرٌ","إِن قُمتَ قاموا وَإِن قُلتَ اِقعُدوا قَعَدوا",82,"د",3,0],["فَثَناهُ عَنِ العِبا","دَةِ وَجدٌ بِكاعِبِ",83,"ب",1,0],["فَثَرَائي مِن ثَراهُ كان لو","عادَ لي عفّرْتُ فيه وجنَتَي",84,"ي",1,0],["فثبتّ حين تذبذبوا وَتنكبوا","وَرحبت لما بالنوائب ضاقوا",85,"ق",3,0],["فَثَمَّ جَنَابٌ لا يُراعُ نَزِيلُهُ","بِنَائِرَةٍ لَوْلا عُيُونُ الْكَوَاعِبِ",86,"ب",1,0],["فَثِقِي بِمَا تُمْلِيهِ أَلْسِنَةُ الْهَوَى","وَهْيَ الدُّمُوعُ فَحَقُّهَا لَمْ يُدْفَعِ",87,"ع",1,0],["فَثَمَّ عُلُومٌ لَمْ تُفَتَّقْ كِمَامُهَا","وَثَمَّ رُمُوزٌ وَحْيُهَا غامِضُ السِّرِّ",88,"ر",1,0],["فثأَرْتَ لِلقتلى بِصَوْنِهِمْ","مِنْ أَنْ يُضَيعَ مَجْدُهمْ هَدْرَا",89,"ر",2,0],["فَثوَيْتُ بَيْنَ مَناطِقٍ وَقَرَاطِقٍ","وَمَبَاسِمٍ وَمَا عَاصِمٍ وَنُهُودِ",90,"د",1,0],["فَثَوَيْتَ فِي الْيَومِ المُنَ","جِّي وَاسْمُهُ اليَوْمَ الْعَصِيبُ",91,"ب",1,0],["فَثَويْتَ أَظْهَرَ مَا تَكُونُ عَلَى عِدَى","مِصْرٍ بِعُقْبَى دَائِكَ المُغْتَالِ",92,"ل",1,0],["فثَوْبكَ مِنِّي سُلَّ يا أسَدَ الشَّرَى","وطَرْفكِ عنِّي يا مَهاةَ النَّقَى غُضِّي",93,"ض",2,0],["فَثَرْوَةٌ مِنْ سَريِّ العِلْمِ وَاسِعَةٌ","وَثَرْوَةٌ مِنْ سريِّ الْجَاهِ وَالنَّشَبِ",94,"ب",1,0],["فثُلّتْ عُروشٌ واستطارتْ أسِرّةٌ","من الذُّعر في أعوادِها والزلازل",95,"ل",1,0],["فثوىَ في خيرِ غمدٍ آمناً","صَارِمٌ أرهفَهُ طولُ الكِفَاح",96,"ح",1,0],["فثق