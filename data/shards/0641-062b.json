,[45,"ذاك وادي الأراك فاحبس قليلا","https://www.aldiwan.net/poem65580.html","الخفيف"],[28,"حلفت برب الجاريات إذا جرت","https://www.aldiwan.net/poem5560.html","الطويل"],[28,"نام الخلي وما أغمض ساعة","https://www.aldiwan.net/poem5624.html","الكامل"],[61,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[58,"لا تعتبن على العباد فإنما","https://www.aldiwan.net/poem30802.html","الكامل"],[66,"توق سبعة أيام قد اطردت","https://www.aldiwan.net/poem38421.html","البسيط"],[66,"حسدت جود كفك الأمطار","https://www.aldiwan.net/poem38683.html","الخفيف"],[66,"أجلك إن يسخ الزمان وتبخل","https://www.aldiwan.net/poem39062.html","الطويل"],[66,"أيا ملكا ربعه للعفاة","https://www.aldiwan.net/poem39068.html","المتقارب"],[97,"إن كنت عارفة وواثقة","https://www.aldiwan.net/poem24908.html","أحذ الكامل"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[80,"بيتك فيه مصرعك","https://www.aldiwan.net/poem31347.html","مجزوء الرجز"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[80,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[44,"سلام الله عدة رمل خبت","https://www.aldiwan.net/poem30572.html","الوافر"],[44,"قدك اتئب أربيت في الغلواء","https://www.aldiwan.net/poem30592.html","الكامل"],[87,"سبقت بالفضل فاسمع ما وحاه فمي","https://www.aldiwan.net/poem8258.html","البسيط"],[69,"معذر عشت بتقبيله","https://www.aldiwan.net/poem28257.html","السريع"],[31,"ذكرتني الديار شوقا قديما","https://www.aldiwan.net/poem41805.html","الخفيف"],[31,"يا صاح قل للربع هل يتكلم","https://www.aldiwan.net/poem41808.html","الكامل"],[31,"أبهجر يودع الأجوار أم","https://www.aldiwan.net/poem42534.html","الخفيف"],[105,"نزيل النيل أين تركت ملكا","https://www.aldiwan.net/poem43074.html","الوافر"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[75,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[48,"يا قلب يا خائن الحبيب","https://www.aldiwan.net/poem10820.html","مجزوء البسيط"],[48,"اربع على الطلل الذي انتسفت","https://www.aldiwan.net/poem63433.html","الكامل"],[48,"حمدان مالك تغضب","https://www.aldiwan.net/poem66558.html","المجتث"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[50,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42683","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42606","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54955","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[58,"لا تعتبنَّ على العباد فإنما","https://www.poetsgate.com/ViewPoem.aspx?id=22741",""],[80,"هفا القلبُ عن وَصلِ هِيفِ القدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=3072",""],[91,"أيا نيل","https://www.poetsgate.com/ViewPoem.aspx?id=53039",""],[91,"الفتى الافضل","https://www.poetsgate.com/ViewPoem.aspx?id=53212",""]],"verses":[["فَثَمَّ الغَيثُ مَعقودُ النَواصي","وَليثُ الغابِ مَحلولُ الزَئيرِ",0,"ر",1,0],["فَثَمَّ بِشرٌ أَصفى مِنَ الغَدِقِ ال","عَذبِ وَجودٌ أَندى مِنَ السُحُبِ",1,"ب",1,0],["فَثِبْ وَثْبَةً فَيها المَنايَا أَوِ المُنى","فكلُّ مُحِبٍّ لِلْحَياةِ ذَليلُ",2,"ل",1,0],["فثِبْ يا عُبَيدَ اللهِ وثْبَةَ ماجِدٍ","أُعيرَ المَضاءَ السّيْفُ منْ عَزَماتِهِ",3,"ت",2,0],["فثمَّ عَرارٌ يُسْتَطابُ شَميمُهُ","وسِلٌّ كخيطانِ الأراكِ صَفيقُ",4,"ق",1,0],["فَثَوى يَمُدُّ رِشاءَها","وَالنَفسُ تَجهَدُ مِن لَظاها",5,"ا",3,0],["فثَوى تُقَلِّبُهُ الأَكُفُّ مُلَقَّفاً","وَلَهُ تُشَدُّ وَتوضَعُ الأَكوارُ",6,"ر",1,0],["فَثَبَتَّ مُجْمَعَ الْفُؤَادِ بِهَفْوَةٍ","خُذِلَ النَّصِيرُ بِهَا وَخَانَ الْمَعْقِلُ",7,"ل",1,0],["فَثِقْ بالَّذي أَرْعَاكَ أَمْر عِبَادِهِ","وَسَلْ فَضْلَهُ فَاللهُ أَكْرَمُ وَاهِبِ",8,"ب",1,0],["فَثَنَيتُ جيدَ غَريرَةٍ","وَلَمَستُ بَطنَ حِقابِها",9,"ب",3,0],["فَثاروا وَثُرنا وَالمَنِيَّةُ بَينَنا","وَهاجَت عَلَينا غَمرَةٌ فَتَجَلَّتِ",10,"ت",1,0],["فَثَداهُ رَيَمانُ خُفِّها","ذا رَنينٍ صَحِلَ الصَوتِ أَبَح",11,"ح",1,0],["فَثابَرَ بِالرُمحِ حَتّى نَحا","هُ في كَفَلٍ كَسَراةِ المِجَن",12,"ن",1,0],["فَثَلَلتَ العُروشَ عَرشاً فَعَرشاً","وَصَبَغتَ الصَعيدَ بَعدَ الصَعيدِ",13,"د",1,0],["فَثَمَّ مَصايِبُ لا تُتَّقى","لُزومُ الصَلاةِ وَقَصُّ السِبالِ",14,"ل",1,0],["فَثِقي مِنّي بِعَهدٍ ثابِتٍ","وَضَميرٍ خالِصِ المُعتَقَدِ",15,"د",1,0],["فَثِق بِهِزَبرِ الشِعرِ وَاِصفَح عَنِ الوَرى","فَإِنَّهُمُ إِلّا الأَقَلَّ ذُبابُ",16,"ب",1,0],["فَثَوى دونَكَ مَثوى قَلِقٍ","يَشتَكي مِن لَيلِهِ مَطلَ السَحَر",17,"ر",1,0],["فَثارَت تُباري أَعوَجِيّاً مُصَدَّراً","طَويلَ عِذارِ الخَدِّ جُؤجُؤُهُ رَحبُ",18,"ب",1,0],["فَثَوَى قَرِيرَ العَيْنِ مَوْفُورَ الرِّضَا","بِثَوَابِ مَا عَانَى مِنَ الآلامِ",19,"م",1,0],["فثناءً للرافدين وشكراً","وسلاماً عليك يا فَلّوجه",20,"ج",2,0],["فَثَوى وَلَم يوجَع وَلَم","يوصَب وَكانَ هُوَ الفَقيدا",21,"د",2,0],["فَثَنَيتُ كَفّي وَالقُرابَ وَنُمرُقي","وَمَكانَهُنَّ الكورُ وَالنِسعانِ",22,"ن",1,0],["فَثَلاثٌ مِنَ السَراةِ إِلى الحُل","بُطِ لِلخَيلِ جاهِداً وَالرِكابِ",23,"ب",1,0],["فثناني العسر والأو","لاد لا أملكُ فسحه",24,"ح",2,0],["فثنى الملام وقال دونك والأسى","هذي مضايق لست أدخل فيها",25,"ه",2,0],["فَثَلَبْتَ معنى مُحسِنٍ وكلامَهُ","ثلباً جعلتَ كَبَدْيِهِ تعقيبَهُ",26,"ب",2,0],["فثِب إلى عُثنونه ناتفاً","فأْتِ عليه شعرة شعرَه",27,"ر",2,0],["فثِقْ بالذي ترجوه وأْمَنْ من الذي","تُحاذرُهُ قد أخطأتاك الموارطُ",28,"ط",1,0],["فثاروا إلى آلاتهم فتقلدوا","خرائط حمراً تحمل السمَّ مُنقَعا",29,"ع",2,0],["فثواب مثلك صفع أخدعه","بل بصقة في الوجه بل نخعه",30,"ع",2,0],["فثنوْا أعنَّتهم بعزْ","زٍ باذخٍ لا يستذلُّ",31,"ل",1,0],["فثنوا أعنّةَ راجعين بخيبةٍ","كرجوعهم أيامَ ساقوا الفيلا",32,"ل",2,0],["فثوى هامُهم بمثوى هوانٍ","ليس فيه سوى الرياحِ فوالي",33,"ل",2,0],["فَثَنَوا سؤدد الأمير وعَدُّوا","فيه آلاءه بكل لسان",34,"ن",1,0],["فثنت عنكُمُ النُّهى مِنْ عناني","وأمامي مَمَدُّ شأوٍ بطين",35,"ن",1,0],["فَثنوا أرجُلَ النزولِ وحلُّوا","في المقاصير لابسينَ أمانا",36,"ن",2,0],["فَثَمَّ قَرَّت عُيونُ الثائِرينَ بِهِ","وَأَدرَكوا كُلَّ تَبلٍ عِندَهُ قَوَدُ",37,"د",1,0],["فَثِنتانِ مَهما تُعطَيا تَرضَيا بِهِ","وَأَسماءُ ما تَرضى بِثُلثٍ وَلا شَطرِ",38,"ر",1,0],["فَثَمَّ تَناهَينا كِلانا عَنِ الصِبا","وَلا شَيءَ خَيرٌ مِن تُقى اللَهِ وَالصَبرِ",38,"ر",1,0],["فَثَمَّ جَلالٌ يَملَءُ النَفسَ هَيبَةً","وَثَمَّ جَلالٌ يَملَءُ العَينَ باهِرُه",39,"ر",2,0],["فَثاروا إِلَينا في السَوادِ فَهَجهَجوا","وَصَوَّتَ فينا بِالصَباحِ المُثَوَّبُ",40,"ب",1,0],["فثقل من صفع بسجع وما درى","بأن أجل السجع ما خف في السمع",41,"ع",1,0],["فَثارَ إِبراهيمُ لِلثاراتِ","وَأَزعَج المَنصورَ بِالغاراتِ",42,"ت",1,0],["فَثِق فَعَسى الَّذينَ اِرتَبتَ فيهِم","عَلى الأَيّامِ إِخوانٌ ثِقاتُ",43,"ت",1,0],["فَثَبَّتَ الشورى وَشَدَّ عَقدَها","وَقَلَّدَ الجيلَ السَعيدَ عَهدَها",44,"د",3,0],["فَثَمَّ جَلالَةٌ قَرَّت وَرامَت","عَلى مَرِّ القُرونِ الأَربَعينا",45,"ن",2,0],["فَثِب واثِقاً بِاللَهِ وَثبَةَ ماجِدٍ","يَرى المَوتَ في الهَيجا جَنى النَحلِ في الفَمِ",46,"م",1,0],["فثابتٌ في الخَلاصِ منسبِكٌ","وطائرٌ في الخلاصِ منهزِمُ",47,"م",1,0],["فثِقْ باعتقادي في ولائِكَ وارعَ بي","زِمامَ العُلَى إِني بحبلِكَ مُعْصِمُ",48,"م",1,0],["فَثَنوا عَنكَ أَعيُناً وَقُلوباً","لَم يَرُدّوا إِلّا حَسيراً كَليلا",49,"ل",2,0],["فَثِنتانِ مَجدُ الجاهِلِيَّةِ فيهِمُ","وَهُم قَبلَ هَذا الناسِ لِلَّهِ أَسلَموا",50,"م",3,0],["فَثَوى وَغادَرَ فيكُمُ بِصَنيعَةٍ","خَيرَ البُيوتِ وَأَحسَنَ البُنيانِ",51,"ن",1,0],["فثَنى الأرضَ منه محمرَّةَ الأرْ","جاءِ والأفقُ حالكُ الجِلبابِ",52,"ب",1,0],["فَثِق بِمَولاكَ الكَريمِ فَإِنَّهُ","بِالعَبدِ أَرأَفَ من أَبٍ بِبَنيهِ",53,"ي",2,0],["فثالث الشهر مذموم وخامسه","وثالث العشرة الوسطى وسادسها",54,"س",3,0],["فَثَنَينا بِالهَطلِ بَل فَثُنينا","فَمَكَثنا وَنابَتِ الأَشعارُ",55,"ر",1,0],["فَثُب نَحوَ صَحبٍ لَم تَزَل مُتَفَضِّلاً","عَلَيهِمُ وَكانَ الأَفضَلَ المَتَفَضِّلُ",56,"ل",1,0],["فَثُب كُلَّ يَومٍ إِلى قَهوَةٍ","تُشاكَلُ كاساتُها في الصَفاءِ",57,"ا",2,0],["فثقي بأنك قِبلتي أبداً","وصلاةُ روحي حيثما كنتِ",58,"ت",1,0],["فثوبُ الجوّ مُغْبَرُّ الحواشي","ووجهُ الأرض مُحمرُّ الأديمِ",59,"م",1,0],["فَثِقْ بِهِ وَلا يَكُنْ","لغيرِهِ تَضَرُّعُك",60,"ك",1,0],["فَثَناني مِن رَوضِ حُسنِك عَنها","نَرجِسٌ ذابِلٌ وَوردٌ نَضيرُ",61,"ر",1,0],["فثُرتُ وثارتْ معيْ هِمّةٌ","قيامي لَها فارعٌ مِنْ قعودِ",62,"د",1,0],["فَثَقَّلتُ بِالتَخفيفِ عَنكَ وَبَعضُهُم","يُخَفِّفُ في الحاجاتِ حَتّى يُثَقِّلا",63,"ل",2,0],["فَثَمَّ الجودُ مَشدودَ الأَواخي","وَثَمَّ المَجدُ مَضروبَ القِبابِ",64,"ب",1,0],["فَثَوَيتُ جاراً لِلحَضيضِ وَهِمَّتي","قَد طُوِّقَت بِكَواكِبِ الجَوزاءِ",65,"ا",2,0],["فَثِقْ بِذِمَّةِ عَهْدٍ فِيكَ صَادِقَةٍ","فَلَيْسَ كُلُّ خَلِيلٍ صَادِقَ الذِّمَمِ",66,"م",1,0],["فثغرُهُ والشعرُ في خدِّهِ","هذا سُنيناتٌ وهذا نباتْ",67,"ت",1,0],["فَثَنَوا هِزَّةَ المَطيِّ وَقالوا","كَيفَ نَرجو مِن عَرصَةٍ تَكليما",68,"م",2,0],["فَثَنى مَطيَّتَهُ عَلَيَّ وَقالَ لي","إِسأَل وَكَيفَ يَبينُ رَسمٌ أَعجَمُ",69,"م",1,0],["فَثَنائي عَلَيكِ خَيرُ ثَناءٍ","إِن تَقَرَّبتِ أَو نَأَت بِكِ دارُ",70,"ر",1,0],["فَثِق بِاللَهِ وَاِنظُر كَيفَ يَهدي","شُعوبَ الشَرقِ إِذ ضَلّوا السَبيلا",71,"ل",2,0],["فَثابَتِ النَفسُ وَاِرتَدَّ اليَقينُ بِها","وَاِنجابَ ما كانَ مِن ظَنٍّ وَتخييلِ",72,"ل",1,0],["فَثَلَّثت واحداً فَرداً نُوَحِّدُهُ","وَلِلبَصَائِرِ كالأَبْصَارِ تَخْيِيلُ",73,"ل",1,0],["فَثَناءُ واحِدِهمْ ثَناءُ جَمِيعِهِمْ","في الفَضْلِ لِلتَّفْخِيمِ وَالإدْغامِ",74,"م",1,0],["فَثَراهُ وَحَصَاهُ أبَداً","يَفْضُلانِ المِسْكَ وَالدُّرَّ الثَّمينا",75,"ن",2,0],["فثقف حتى ليس فيه تأوّد","وطهر حتى ليس فيه فسوق",76,"ق",1,0],["فثَمّ زَمانٌ كالشّبيبَةِ مُذْهَبٌ","وثَمّ لَيالٍ كالقدودِ نواعِمُ",77,"م",1,0],["فثَمّ مصابيحُ الظّلام وشيعةُ ال","إمامِ وأُسْدُ المأزِقِ المُتَلاحم",78,"م",1,0],["فَثَمَّ أَدري أَشَرَّ قَلبٍ","أَنَّكَ تَأسى عَلى الحَبيبِ",79,"ب",1,0],["فَثَنى عَلَيهِ لَواحِظاً نَطَقَت","مِنهُ بِمِثلِ نَواطِقِ المَسِّ",80,"س",1,0],["فثق بذلك منّي","يا ابنَ الكريم المركّب",81,"ب",1,0],["فَثَوَّرَت بَقَراً ما مِثلُهُم بَقَرٌ","إِن قُمتَ قاموا وَإِن قُلتَ اِقعُدوا قَعَدوا",82,"د",3,0],["فَثَناهُ عَنِ العِبا","دَةِ وَجدٌ بِكاعِبِ",83,"ب",1,0],["فَثَرَائي مِن ثَراهُ كان لو","عادَ لي عفّرْتُ فيه وجنَتَي",84,"ي",1,0],["فثبتّ حين تذبذبوا وَتنكبوا","وَرحبت لما بالنوائب ضاقوا",85,"ق",3,0],["فَثَمَّ جَنَابٌ لا يُراعُ نَزِيلُهُ","بِنَائِرَةٍ لَوْلا عُيُونُ الْكَوَاعِبِ",86,"ب",1,0],["فَثِقِي بِمَا تُمْلِيهِ أَلْسِنَةُ الْهَوَى","وَهْيَ الدُّمُوعُ فَحَقُّهَا لَمْ يُدْفَعِ",87,"ع",1,0],["فَثَمَّ عُلُومٌ لَمْ تُفَتَّقْ كِمَامُهَا","وَثَمَّ رُمُوزٌ وَحْيُهَا غامِضُ السِّرِّ",88,"ر",1,0],["فثأَرْتَ لِلقتلى بِصَوْنِهِمْ","مِنْ أَنْ يُضَيعَ مَجْدُهمْ هَدْرَا",89,"ر",2,0],["فَثوَيْتُ بَيْنَ مَناطِقٍ وَقَرَاطِقٍ","وَمَبَاسِمٍ وَمَا عَاصِمٍ وَنُهُودِ",90,"د",1,0],["فَثَوَيْتَ فِي الْيَومِ المُنَ","جِّي وَاسْمُهُ اليَوْمَ الْعَصِيبُ",91,"ب",1,0],["فَثَويْتَ أَظْهَرَ مَا تَكُونُ عَلَى عِدَى","مِصْرٍ بِعُقْبَى دَائِكَ المُغْتَالِ",92,"ل",1,0],["فثَوْبكَ مِنِّي سُلَّ يا أسَدَ الشَّرَى","وطَرْفكِ عنِّي يا مَهاةَ النَّقَى غُضِّي",93,"ض",2,0],["فَثَرْوَةٌ مِنْ سَريِّ العِلْمِ وَاسِعَةٌ","وَثَرْوَةٌ مِنْ سريِّ الْجَاهِ وَالنَّشَبِ",94,"ب",1,0],["فثُلّتْ عُروشٌ واستطارتْ أسِرّةٌ","من الذُّعر في أعوادِها والزلازل",95,"ل",1,0],["فثوىَ في خيرِ غمدٍ آمناً","صَارِمٌ أرهفَهُ طولُ الكِفَاح",96,"ح",1,0],["فثق بمولاك الكريم فإنه","بالعبد أرأف على أبٍ ببنيه",97,"ه",1,0],["فثرت وثارتْ معيْ هِمَّة","ٌ قيامي لَها فارغٌ مِنْ قعود",98,"د",1,0],["فثمّ جلال يملأ النفس هيبة","وثمّ جلال يملأ العين باهره",99,"ر",2,0],["فثابر بجدّ على نيلها","فليس يخيب الذي يعمل",100,"ل",1,0]]}