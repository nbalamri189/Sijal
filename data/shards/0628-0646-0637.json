{"poems":[[354,"بنطق سمعي جرى لساني","https://www.aldiwan.net/poem15963.html","مخلع البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140312",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139665",""],[5273,"سحر الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=191944",""]],"verses":[["بِنُطقِ سَمعي جَرى لِساني","وَعَن فُؤادي رَوى عَياني",0,"ن",2,1],["بنطاق الجوزا توشحت حسناً","وتقرطت زينة بالثريا",1,"ي",2,0],["بنطاقٍ لما انتطقنَ الدراري","منه فيه أجوجها قد أنارا",2,"ر",2,0],["بنطالُها مثلي ينوءُ صَبابَةً","لكنّني بِصَبابَتي أفنى سُدى",3,"د",2,0]]}