{"poems":[[55,"سليمان دلتني يداك على الغنى","https://www.aldiwan.net/poem29869.html","الطويل"],[55,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[53,"يسائلني فرخ الزنا فيم عمتي","https://www.aldiwan.net/poem64555.html","الطويل"],[91,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[87,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[70,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[201,"يا نديمي في صبايا","https://www.aldiwan.net/poem39869.html","مجزوء الرمل"],[276,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[280,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[358,"بلغا عني ربوع الصالحيه","https://www.aldiwan.net/poem39576.html","الرمل"],[409,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[435,"ماست فازرت غصون البان بالميل","https://www.aldiwan.net/poem41419.html","البسيط"],[443,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[563,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100982","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52054","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76654","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137938",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137373",""],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144496","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131299",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35092","الكامل"],[4680,"قدرٌ هواك","https://www.poetsgate.com/ViewPoem.aspx?id=185018",""],[5136,"يا لها من قبة أنوارها","https://www.poetsgate.com/ViewPoem.aspx?id=121554",""],[5147,"من عاذلي ومن البلية","https://www.poetsgate.com/ViewPoem.aspx?id=166725",""],[5273,"سقط الوشاح","https://www.poetsgate.com/ViewPoem.aspx?id=178564",""],[5277,"صريخُ القوافي..","https://www.poetsgate.com/ViewPoem.aspx?id=206053",""],[5285,"إشارة خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=203516",""],[5631,"عَلى تَقاسِيمِ البَياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=210481",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[4623,"حدثوني حديث من أهواه ( المدئح )","https://www.poetsgate.com/ViewPoem.aspx?id=146685",""],[5770,"طار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178360",""]],"verses":[["وَعَلَّيتَني حَتّى ظَنَنتُ بِأَنَّني","سَأَعبُرُ مِن عَرضِ المَجَرَّةِ جَدوَلا",0,"ل",2,0],["وَعَلَيَّ تَضميرُ الجِيادِ لِغارَةٍ","فيها خَضيبٌ بِالدِماءِ وَخاضِبُ",1,"ب",1,0],["وعلَّيْته لما حللت عقالَهُ","بأصفرَ من أقذار بطنك وارس",2,"س",1,0],["وعلى توابعها تدو","ر توابع أخرى صواحب",3,"ب",1,0],["وعلى تغنى النفس في وجدانها","خلت العشىّ ومرت الأبكار",4,"ر",1,0],["وعلى تَفَنّنِ واصِفيهِ بِحُسْنِهِ","يَفنى الزّمانُ وفيه ما لم يُوصف",5,"ف",1,0],["وعلى تلكم الأسرة حورٌ","في حليٍّ لها ونعمَ الحور",6,"ر",1,0],["وعلى تلك وهذي","في ليالينا الأخيره",7,"ه",1,0],["وَعَلى تمام الاربعين سَتَنجَلي","شمس النبوّة لِلنَبي المرسل",8,"ل",1,0],["وَعَلى تَدْبيرِه اعْتَمَدَتْ","في أبابيلِ الأباطيلِ",9,"ل",1,0],["وَعَلى تِلكَ المَغاني عَرّجا","وَاِشهدا تِلكَ المَعاني العَبقريّه",10,"ي",2,0],["وعلى تذكُّر ما مضى فلنا","بحث على الأيام لو يُجْدِي",11,"د",2,0],["وعلى تقضى وعود بتّ أرقبها","وإن يحالف بين القول والعمل",12,"ل",1,0],["وعلى تقدير ذنب شنيع","اين عفو منك ما زال بظلا",13,"ل",2,0],["وعلى تلك الربى النور استبان","بعد ما اردية الليل انطوت",14,"ت",1,0],["وعليَّ تستعلي الرّجالُ وما","يبدو لعينِي منهمُ رجلُ",15,"ل",1,0],["وعلى تشبيهه حذرٌ","خائفٌ منّا عليه ظمي",16,"م",2,0],["وعلى تهامة من بشاشته","سبغ الندى والعيشة الرغد",17,"د",1,0],["وعَلِيُّ تَكْثُرُ وارِدَاتُ نَوالِهِ","فَهِي الخِيارُ وأنتَ بَعدُ مُخَيَّرُ",18,"ر",1,0],["وعلى تظاهرنا الضمان بقلة ال","أعداء ثم بكثرة الحساد",19,"د",1,0],["وعلى ترنسلفانيا ما أبطأت","أَن جرَّدت للزحف جيشاً خضرما",20,"م",2,0],["وعلى تقى الرحمن نشأتها التي","قد أكسبتها نعمة الرحمن",21,"ن",1,0],["وعلى تغلب ويعرب دوما","حرمت أن تبيت في اغفاء",22,"ا",2,0],["وعلى تيمر وقيت من الخط","ب فقف بي بالله عند الوقيه",23,"ي",2,0],["وعلى تليد المجد شدت طريفه","فبدا على زهر الكواكب يشرف",24,"ف",1,0],["وَعَلَيَّ تَوفيةُ الثَناءِ مُخَلَّداً","إِن كانَ يُقنِعُكَ الثَناءُ مُخَلَّدا",25,"د",2,0],["وعلى تخوم ثراك تنهمر الرؤى","ويلوح خلف الداجيات ضبابُ",26,"ب",1,0],["وعلى تقوى من الله على","شأنه تأسيسها قد شيدا",27,"د",2,0],["وعلى تجردها قبول","كيانها الأضداد دلا",28,"ل",2,0],["وعلى تُخُومِ الصَّدْرِ أرْهَقَني","سِرٌّ تَخَبَّأ خَلْفَهُ الشَّبَقُ",29,"ق",1,0],["وعلى تخومِ الشامِ نوْءٌ راعدٌ","يتحيّنَ الضعفَ المميتَ ويمكرُ",30,"ر",1,0],["وعلى تراتيلِ الضياعِ تركتني","كالزهرِ ينمو حاملاً أشواكا",31,"ك",2,0],["وعلى \"تَقاسيمِ البَياتِ\" تبعثَرتْ","أمشاطُها في حَقلِ \"قانُونٍ\" وَلُوعْ",32,"ع",1,0],["وعلى تزْييفِ الحقائِق ِكي","يَطْمِسَ حقّي وإرثِيَ التَّوْطينُ",33,"ن",1,0],["وعلى تابعيك ما قال عبد","ربي الله لا اله سواه",34,"ا",2,0],["وعلى تُخوم القرنِ خيمتُهمْ","قد ركّزوا الأعواد والطُنُبا",35,"ب",2,0]]}