{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[63,"سرى البرق والمزن مرخى العزالي","https://www.aldiwan.net/poem45700.html","المتقارب"],[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[3,"دع ما مضى لك في الزمان الأول","https://www.aldiwan.net/poem196.html",""],[55,"عيناي شامت دمي والشؤم في النظر","https://www.aldiwan.net/poem26366.html","البسيط"],[86,"أكثرتم التصفيق في موطن","https://www.aldiwan.net/poem10472.html","السريع"],[86,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[73,"أفدتني من نفائس الدرر","https://www.aldiwan.net/poem11981.html","المنسرح"],[82,"عللاني بذكر تلك الليالي","https://www.aldiwan.net/poem29397.html","الخفيف"],[35,"أقوى وأقفر من ماوية البرق","https://www.aldiwan.net/poem39126.html","البسيط"],[10,"يؤرقني التذكر حين أمسي","https://www.aldiwan.net/poem21102.html","الوافر"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[88,"هي المنى كثغور الغيد تبتسم","https://www.aldiwan.net/poem44833.html","البسيط"],[88,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[72,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[51,"ذريني قسطنطين آكل شهوتي","https://www.aldiwan.net/poem64951.html","الطويل"],[51,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"أبدر السماء وغيث السماء","https://www.aldiwan.net/poem66000.html","المتقارب"],[51,"يا من عكفنا عليه لائذين به","https://www.aldiwan.net/poem66386.html","البسيط"],[92,"كان الربيع الحي روحا حالما","https://www.aldiwan.net/poem38969.html","الكامل"],[89,"تذكرت يا سلمى ليالينا التي","https://www.aldiwan.net/poem44943.html","الطويل"],[85,"كان لسلطان نديم واف","https://www.aldiwan.net/poem8052.html","الرجز"],[43,"لئن كان أحسن في وصفها","https://www.aldiwan.net/poem9755.html","المتقارب"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"رحلوا فأية عبرة لم تسكب","https://www.aldiwan.net/poem10645.html","الكامل"],[49,"بكى شجوه الإسلام من علمائه","https://www.aldiwan.net/poem10316.html","الطويل"],[49,"أكثر موسى غيظ حساده","https://www.aldiwan.net/poem64169.html","البسيط"],[66,"في نشوة الحمراء والخضراء","https://www.aldiwan.net/poem38638.html","الكامل"],[66,"ملكت ببعض برك رق شكري","https://www.aldiwan.net/poem38795.html","الوافر"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[66,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[44,"ما أنت إلا المثل السائر","https://www.aldiwan.net/poem30047.html","السريع"],[87,"قد عاقني الشك في أمر أضعت له","https://www.aldiwan.net/poem8227.html","البسيط"],[87,"أحبب بهن معاهداً ومعانا","https://www.aldiwan.net/poem8235.html","الكامل"],[105,"تجيب بعثت الوفد أما سبيله","https://www.aldiwan.net/poem44001.html","الطويل"],[52,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[48,"ما هوى إلا له سبب","https://www.aldiwan.net/poem10784.html","المديد"],[48,"باكر صبوحك فهو خير عتاد","https://www.aldiwan.net/poem62550.html","الكامل"],[48,"حسبي جوى إن ضاق بي أمري","https://www.aldiwan.net/poem63317.html","السريع"],[48,"وأنمر الجلدة صيرته","https://www.aldiwan.net/poem64451.html","السريع"],[50,"إن أمس منقبض اليدين عن الغنى","https://www.aldiwan.net/poem24572.html","الكامل"],[50,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[50,"يا رام قومي اصبحينا غير تصريد","https://www.aldiwan.net/poem63869.html","البسيط"],[50,"أصبح القلب بالنحيلة صبا","https://www.aldiwan.net/poem64813.html","الخفيف"],[46,"أصبحت غير مميز من عالم","https://www.aldiwan.net/poem22562.html","الكامل"],[46,"تحفظ بدينك يا ناسكا","https://www.aldiwan.net/poem22753.html","المتقارب"],[46,"ذهاب عيني صان الجسم آونة","https://www.aldiwan.net/poem22833.html","البسيط"],[46,"ناديت حتى بدا في المنطق الصحل","https://www.aldiwan.net/poem23129.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85570","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16670","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42563","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12549","الكامل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2902","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8890","الوافر"],[50,"يَا رَامَ قُومِي کصْبَحِينَا غَيْرَ تَصْرِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=22570",""],[93,"فتاة الجبل","https://www.poetsgate.com/ViewPoem.aspx?id=12714",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[51,"يا مَن عكفْنا عليهِ لائذينَ بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30570",""]],"verses":[["فَاِكفُف سَماحَكَ وَاِثنِ مِن غُلَوائِهِ","إِنَّ الغِنى في بَعضِ ما أَعطاني",0,"ي",1,0],["فَأَكثِر بِما طَلَّ تِلكَ الدِماءَ","وَأَعظِم بِما جَرَّ بَدراً وَأُحدا",1,"د",2,0],["فَأَكرِم بِمَن كانَ أَعمامُهُ","قُرَيشاً وَأَخوالُهُ مِن هِلالِ",2,"ل",1,0],["فأكْرِمْ بآباءٍ هُمُ في اشْتِهارِهمْ","بُدورٌ وأبناءٍ يُعالُونَ أنْجُما",3,"م",2,0],["فَاكفُف وَدَع عَنكَ الإِطالَةَ وَاِقتَصِر","وَإِذا اِستَطَعتَ اليَومَ شَيئاً فَاِفعَلِ",4,"ل",1,0],["فَأَكثِروا أَو أَقِلّوا مِن مَلامِكُمُ","فَكُلُّ ذَلِكَ مَحمولٌ عَلى القَدَرِ",5,"ر",1,0],["فَأَكرِموا صَبري بِإِنصاتِكُم","وَليُعذَرِ الدَمعُ إِذا صَفَّقا",6,"ق",2,0],["فَاِكتَسِبوا الأَجرَ وَلا تَبتَغوا","شِراءَهُ بِالثَمَنِ البَخسِ",7,"س",1,0],["فَاِكتُبوا في سَماءِ رُدجو وَمِسّي","نا وَكالَبرِيا بِكُلِّ لِسانِ",8,"ن",1,0],["فَاِكتَفِ مِنهُ بِنَظرَةٍ عَنَنٍ","لا حَظَّ فيهِ لِكَرَّةِ النَظَرِ",9,"ر",1,0],["فاكتسى النهر لامة منه لما","ان رمى القطر نحره بالنبال",10,"ل",1,0],["فَآكُمُ النَعفِ وَحشٌ لا أَنيسَ بِها","إِلّا القَطا فَتِلاعُ النَبعَةِ العُمُقُ",11,"ق",1,0],["فَأَكرَمَهُ وَآمَنَهُ فَأَمسى","خَلِيّاً بالُهُ مِن كُلِّ بُؤسِ",12,"س",1,0],["فاكتسبوا لو في بريّا","قل هو اللّه ألف مرا",13,"ر",2,0],["فأكثر القوم من ذلّ ومَسكَنة","تلقى الذباب على آنافهم يَنِم",14,"م",1,0],["فأكرم بلبنان مَقَرّاً لِنابهٍ","ومأوىً لمنكودٍ ومَهدىً لحائر",15,"ر",1,0],["فأكرم الدمع ما سحَّت بوادره","من الوفاء وما انْهلَّت سواجمه",16,"م",2,0],["فاكتب الكُتْبَ وابعث الرسْلَ في حا","جة راجيك إنّ في ذاك مجدا",17,"د",2,0],["فاكفُفْ سِهامَك عن أخيك فإنما","آسفتَه فرمَاك بالمِعراض",18,"ض",1,0],["فأكثرُ ما ألقى من الزادِ كَظَّةٌ","مَدَى يومها واليومُ أسرعُ ماضِي",19,"ي",1,0],["فاكمل بحيث ترى فيه نقيصته","فالبدر وافٍ بحيث الشهر منصوف",20,"ف",1,0],["فاكفنا بردَ قردةٍ","تتشاجى فتسخُف",21,"ف",1,0],["فأكبرتُ ذاك وأعظمْتُه","وإنْ كان فيما تسدّي قليلا",22,"ل",2,0],["فاكسُ ابنَ شكرِك ما يَبْلَى على ثِقةٍ","أنْ سوفَ يكسوكَ ما يبقَى على الزمنِ",23,"ن",1,0],["فاكبحْ عواطفكَ الجوامحَ إنّها","شَرَدَتْ بلُبِّكَ واستمعْ لخطابي",24,"ي",1,0],["فأكرم بهاتيك الليالي لياليا","وأكرم بحزوى عندها من محلة",25,"ه",1,0],["فَأَكَلَ السُلطانُ مِنهُ ما أَكَل","وَقالَ هَذا في المَذاقِ كَالعَسَل",26,"ل",1,0],["فَأَكثَرُ مِن جَريِها ما وَهَبتَ","وَأَكثَرُ مِن مائِها ما سَفَك",27,"ك",1,0],["فَأَكبَروا فِعلَهُ وَأَصغَرَهُ","أَكبَرُ مِن فِعلِهِ الَّذي فَعَلَه",28,"ل",2,0],["فأكنافُهم للمستميحينَ مرتَعٌ","وأسيافُهمْ في المستبيحينَ رُتَّعُ",29,"ع",1,0],["فَأَكونُ طَوراً مَشرِقاً لِلمَشرِقِ ال","أَقصى وَطَوراً مَغرِباً لِلمَغرِبِ",30,"ب",1,0],["فَأَكثَرُهُم مُستَقبِحٌ لِصَوابِ مَن","يُخالِفُهُ مُستَحسِنٌ لِخَطائِهِ",31,"ا",3,0],["فَاكتَسَتِ الأَرضُ بِهِ بَهجَةً","وَاستَبشَرَ المَلكُ بِميلادِهِ",32,"د",2,0],["فَاِكسُر بِفَترَةِ تِلكَ شِرَّةَ هَذِهِ","وَاِعجَب لِحُسنِ تَلاؤُمِ الأَجزاءِ",33,"ا",2,0],["فَأَكسَبَ كُلَّ شَهرٍ خَرجَ يَومٍ","وَأُخرِجَ كُلَّ يَومٍ كَسبَ شَهرِ",34,"ر",1,0],["فَاِكتَسَتِ الأَرضُ بِها جَلابِبا","فَأَظهَرَت أَزهارَها عَجائِبا",35,"ب",2,0],["فَأَكُفُّهُم يَومَ السَماحِ جَداوِلٌ","وَقُلوبُهُم يَومَ الكِفاحِ جَلامِدُ",36,"د",1,0],["فاكِهَةٌ ضُيِّعَ بُستانُها","فَاِنتابَها الوارِدُ وَالصادِرُ",37,"ر",1,0],["فَاكْشِفْ لَنَا عَنْ قِنَاعِ الشَّكِّ نَحْيَ بِهِ","إِمَّا وِصَالاً وَإِمَّا مَحْضَ هِجْرَانِ",38,"ن",1,0],["فَاكْوِ الْحَسُودَ بِنَاظِرَيْهِ وَقُلْ لَهُ","إِنْ كُنْتَ تَجْهَلُنَا فَكَيْفَ تَرَانَا",39,"ن",2,0],["فأكرمَ مثواهم وأعلى مكانَهم","رَسولٌ لِمَنْ يَبغِي المحجَّةَ ناصِحُ",40,"ح",1,0],["فَاِكتُمِ السِرَّ حَبيباً وَعَدوّاً","فَهوَ مِن هَذا وَهَذاكَ يَشيعُ",41,"ع",1,0],["فاكْحَلْ بِطيْفٍ منه طَرْفاً جَفْنُه","بِدُمُوعِهِ حتى يَرَاهُ قَرِيحُ",42,"ح",1,0],["فأَكْرِمْ بِيَوْمٍ فيه أَكْرَمُ مَوْلِدٍ","لأَكْرَمِ مَوْلُودٍ نَمَتْهُ حُجُورُ",43,"ر",1,0],["فأكْدَيْتُ لمّا بَلَغْتُ المَدى","وعُرّيتُ لمّا لَبِستُ النُّهى",44,"ا",1,0],["فَاِكتَسَت مِنهُ طَرائِفَهُ","وَاِستَزادَت فَضلَ ما تَهِبُ",45,"ب",1,0],["فَأَكيلُ قُلنا بَعدَ خُبرٍ إِنَّنا","لا نَشتَري سَمَكاً بِبَطنِ الوادي",46,"ي",1,0],["فَأَكونُ قَد سَبَّبتُ فُرقَتَنا","وَحَطَطتُ مُجتَهِداً عَلى ظَهري",47,"ي",1,0],["فَاِكتَسَبا مَن يَدَّعي ذا وَذا","قَلائِداً تَبقى وَأَطواقا",48,"ق",2,0],["فَاِكحَل بِعَبدَةَ مُقلَتَيكَ مِنَ القَذى","وَبِوَشكِ رُؤيَتِها مِنَ الهَمَلانِ",49,"ن",1,0],["فَاِكتَسِب ناقِلَةً مِن وُدِّهِ","عَزَّ مَن وَدَّ اِبنُ سَلمٍ وَنُصِر",50,"ر",1,0],["فَاِكسِب مِنَ المالِ ما تَبني بِهِ شَرَقاً","أَو عِش بِرَغمٍ قَصِيّاً غَيرَ مَعدودِ",51,"د",1,0],["فَاِكشِفي ما بِنا وَعودي عَلَينا","قَد لَقينا إِلَيكِ في الحُبِّ حَسبا",52,"ب",2,0],["فَاِكفُف لِسانَكَ أَن تُعَيِّرَ وَاِعلَمَن","أَن لَيسَ يَأمَنُ ما يَعيبُ مُعَيِّرُ",53,"ر",1,0],["فَأَكرِه عَلى الخَيرِ مَجبولَةً","عَلى غَيرِهِ في عِلانٍ وَسِر",54,"ر",1,0],["فَاِكتُم حَديثَكَ لا يَشعُر بِهِ أَحدٌ","مِن رَهطِ جِبريلَ أَو مِن رَهطِ إِبليسِ",55,"س",1,0],["فَاِكفِف بِسَيرِكَ ذَيلَ الخَطبِ مُبتَدِراً","فَالخَلقُ أَمرَهُ أَو فيهِ الدُجى كَحلُ",56,"ل",1,0],["فأكرم بقوم ناضلوا عن حقوقهم","وأَشجع بقوم لا يروعهمُ الذعر",57,"ر",1,0],["فاِكتَسى حكم الذات رأساً وصدراً","بعد أَن كان نطفة أَمشاجا",58,"ج",2,0],["فأَكبرْ بشعرٍ كان حراً كربِّه","وأَكبرْ بحرٍّ لا يَكون مقيدا",59,"د",2,0],["فاكْفُفْ جفونَكَ عن غَرائرِ فارِسٍ","فالضّرْبُ يَثْلِمُ في غِرَارِ الصارم",60,"م",1,0],["فاكتَنِت لا تَكُ عَبداً طائراً","واحذَرِ الأَقتالَ مِنَّا والثَّوَر",61,"ر",1,0],["فَأَكْثَرُ مَنْ لاقَيْتُ لَمْ يَصْفُ قَلْبُهُ","وَأَصْدَقُ مَنْ وَالَيْتُ لَمْ يُغْنِ وُدُّهُ",62,"د",2,0],["فَأَكْبَرَ كُلُّهُمُ أَنَّهُ","رَآهُ تَجَلَّى وَلَمْ يَسْجُدِ",63,"د",1,0],["فَأَكونَ قَد أُسقيتُ مِنها ريقَها","وَأُنِلتُ حُسنَ بَنانِها وَخِضابِها",64,"ب",3,0],["فَأَكونَ لا أَنحَلُّ عَنها ساعَةً","دونَ الثيابِ مُجاوِراً لِحِقابِها",64,"ب",3,0],["فَأَكرِم بِمَن فيها عَلى اللَهِ نازِلاً","وَأَكرِم بِعَبّادانِ داراً وَمَنزِلا",65,"ل",2,0],["فَإِكرَع فاهَ في بَردٍ وَخَمرٍ","فَقُل ما شِئتَ في شُربٍ وَطيبِ",66,"ب",1,0],["فاكسب من المال ما تبني به شرفاً","أَوْ عِشْ بِرغْم قَصِيّاً غَيْرَ مَعْدُودِ",67,"د",1,0],["فاكبره كلهم انه","راه تجلى ولم يسجد",68,"د",1,0],["فأكرِهْها وقُل سيري بسَوطٍ","يُدَمِّي من أبَى سَيْراً وطاعا",69,"ع",2,0],["فاكسُ ابنَ شكرِك ما يَبْلي على ثِقة ٍ","أنْ سوفَ يكسوكَ ما يقي على الزمن",70,"ن",1,0]]}