ق النفس منا","واحْيِ منا ميْتَ الهوى بحياتك",168,"ك",1,0],["فاكشف حجاب سواك عن","أياك وانزع ثوب حدسك",169,"ك",1,0],["فاكشف ولا تخترع ما أنت فيه تفز","بدين طه وداود وجرجيس",170,"س",1,0],["فاكشف بعقلك عما أنت فيه وكن","من التباس أمور النفس في حذر",171,"ر",1,0],["فاكتبوا بالنضار يا أهل ودي","في لجين الخدود والأوداج",172,"ج",1,0],["فاكتُبْ على قبرِهِ يا مَن يُؤَرِّخُهُ","قد غابَ عنا شِهابٌ في السَّما طَلَعَا",173,"ع",2,0],["فاكتنفوهم ومضوا في ضيق","حتى أتوا بهم إلى عتيق",174,"ق",1,0],["فأكلوا حتى انتهوا للوسق","ثم سقاهم لبنا في فرق",174,"ق",1,0],["فاكفُف ملامَك عنِّي حين أَلْثُمُه","فما شككتُ بأَنِّي قد لثمتُ فَمَا",175,"م",2,0],["فأكرم به نظماً بديعاً مروقاً","وألفاظه أحلى من المتحلب",176,"ب",1,0]]}