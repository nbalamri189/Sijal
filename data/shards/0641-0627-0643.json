https://www.aldiwan.net/poem34546.html","البسيط"],[556,"قد أتينا الحمى على منهاج","https://www.aldiwan.net/poem34688.html","الخفيف"],[560,"أعطى الأمير المجيد اليوم تربته","https://www.aldiwan.net/poem52526.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[585,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["فَاِكفُف سَماحَكَ وَاِثنِ مِن غُلَوائِهِ","إِنَّ الغِنى في بَعضِ ما أَعطاني",0,"ي",1,0],["فَأَكثِر بِما طَلَّ تِلكَ الدِماءَ","وَأَعظِم بِما جَرَّ بَدراً وَأُحدا",1,"د",2,0],["فَأَكرِم بِمَن كانَ أَعمامُهُ","قُرَيشاً وَأَخوالُهُ مِن هِلالِ",2,"ل",1,0],["فأكْرِمْ بآباءٍ هُمُ في اشْتِهارِهمْ","بُدورٌ وأبناءٍ يُعالُونَ أنْجُما",3,"م",2,0],["فَاكفُف وَدَع عَنكَ الإِطالَةَ وَاِقتَصِر","وَإِذا اِستَطَعتَ اليَومَ شَيئاً فَاِفعَلِ",4,"ل",1,0],["فَأَكثِروا أَو أَقِلّوا مِن مَلامِكُمُ","فَكُلُّ ذَلِكَ مَحمولٌ عَلى القَدَرِ",5,"ر",1,0],["فَأَكرِموا صَبري بِإِنصاتِكُم","وَليُعذَرِ الدَمعُ إِذا صَفَّقا",6,"ق",2,0],["فَاِكتَسِبوا الأَجرَ وَلا تَبتَغوا","شِراءَهُ بِالثَمَنِ البَخسِ",7,"س",1,0],["فَاِكتُبوا في سَماءِ رُدجو وَمِسّي","نا وَكالَبرِيا بِكُلِّ لِسانِ",8,"ن",1,0],["فَاِكتَفِ مِنهُ بِنَظرَةٍ عَنَنٍ","لا حَظَّ فيهِ لِكَرَّةِ النَظَرِ",9,"ر",1,0],["فاكتسى النهر لامة منه لما","ان رمى القطر نحره بالنبال",10,"ل",1,0],["فَآكُمُ النَعفِ وَحشٌ لا أَنيسَ بِها","إِلّا القَطا فَتِلاعُ النَبعَةِ العُمُقُ",11,"ق",1,0],["فَأَكرَمَهُ وَآمَنَهُ فَأَمسى","خَلِيّاً بالُهُ مِن كُلِّ بُؤسِ",12,"س",1,0],["فاكتسبوا لو في بريّا","قل هو اللّه ألف مرا",13,"ر",2,0],["فأكثر القوم من ذلّ ومَسكَنة","تلقى الذباب على آنافهم يَنِم",14,"م",1,0],["فأكرم بلبنان مَقَرّاً لِنابهٍ","ومأوىً لمنكودٍ ومَهدىً لحائر",15,"ر",1,0],["فأكرم الدمع ما سحَّت بوادره","من الوفاء وما انْهلَّت سواجمه",16,"م",2,0],["فاكتب الكُتْبَ وابعث الرسْلَ في حا","جة راجيك إنّ في ذاك مجدا",17,"د",2,0],["فاكفُفْ سِهامَك عن أخيك فإنما","آسفتَه فرمَاك بالمِعراض",18,"ض",1,0],["فأكثرُ ما ألقى من الزادِ كَظَّةٌ","مَدَى يومها واليومُ أسرعُ ماضِي",19,"ي",1,0],["فاكمل بحيث ترى فيه نقيصته","فالبدر وافٍ بحيث الشهر منصوف",20,"ف",1,0],["فاكفنا بردَ قردةٍ","تتشاجى فتسخُف",21,"ف",1,0],["فأكبرتُ ذاك وأعظمْتُه","وإنْ كان فيما تسدّي قليلا",22,"ل",2,0],["فاكسُ ابنَ شكرِك ما يَبْلَى على ثِقةٍ","أنْ سوفَ يكسوكَ ما يبقَى على الزمنِ",23,"ن",1,0],["فاكبحْ عواطفكَ الجوامحَ إنّها","شَرَدَتْ بلُبِّكَ واستمعْ لخطابي",24,"ي",1,0],["فأكرم بهاتيك الليالي لياليا","وأكرم بحزوى عندها من محلة",25,"ه",1,0],["فَأَكَلَ السُلطانُ مِنهُ ما أَكَل","وَقالَ هَذا في المَذاقِ كَالعَسَل",26,"ل",1,0],["فَأَكثَرُ مِن جَريِها ما وَهَبتَ","وَأَكثَرُ مِن مائِها ما سَفَك",27,"ك",1,0],["فَأَكبَروا فِعلَهُ وَأَصغَرَهُ","أَكبَرُ مِن فِعلِهِ الَّذي فَعَلَه",28,"ل",2,0],["فأكنافُهم للمستميحينَ مرتَعٌ","وأسيافُهمْ في المستبيحينَ رُتَّعُ",29,"ع",1,0],["فَأَكونُ طَوراً مَشرِقاً لِلمَشرِقِ ال","أَقصى وَطَوراً مَغرِباً لِلمَغرِبِ",30,"ب",1,0],["فَأَكثَرُهُم مُستَقبِحٌ لِصَوابِ مَن","يُخالِفُهُ مُستَحسِنٌ لِخَطائِهِ",31,"ا",3,0],["فَاكتَسَتِ الأَرضُ بِهِ بَهجَةً","وَاستَبشَرَ المَلكُ بِميلادِهِ",32,"د",2,0],["فَاِكسُر بِفَترَةِ تِلكَ شِرَّةَ هَذِهِ","وَاِعجَب لِحُسنِ تَلاؤُمِ الأَجزاءِ",33,"ا",2,0],["فَأَكسَبَ كُلَّ شَهرٍ خَرجَ يَومٍ","وَأُخرِجَ كُلَّ يَومٍ كَسبَ شَهرِ",34,"ر",1,0],["فَاِكتَسَتِ الأَرضُ بِها جَلابِبا","فَأَظهَرَت أَزهارَها عَجائِبا",35,"ب",2,0],["فَأَكُفُّهُم يَومَ السَماحِ جَداوِلٌ","وَقُلوبُهُم يَومَ الكِفاحِ جَلامِدُ",36,"د",1,0],["فاكِهَةٌ ضُيِّعَ بُستانُها","فَاِنتابَها الوارِدُ وَالصادِرُ",37,"ر",1,0],["فَاكْشِفْ لَنَا عَنْ قِنَاعِ الشَّكِّ نَحْيَ بِهِ","إِمَّا وِصَالاً وَإِمَّا مَحْضَ هِجْرَانِ",38,"ن",1,0],["فَاكْوِ الْحَسُودَ بِنَاظِرَيْهِ وَقُلْ لَهُ","إِنْ كُنْتَ تَجْهَلُنَا فَكَيْفَ تَرَانَا",39,"ن",2,0],["فأكرمَ مثواهم وأعلى مكانَهم","رَسولٌ لِمَنْ يَبغِي المحجَّةَ ناصِحُ",40,"ح",1,0],["فَاِكتُمِ السِرَّ حَبيباً وَعَدوّاً","فَهوَ مِن هَذا وَهَذاكَ يَشيعُ",41,"ع",1,0],["فاكْحَلْ بِطيْفٍ منه طَرْفاً جَفْنُه","بِدُمُوعِهِ حتى يَرَاهُ قَرِيحُ",42,"ح",1,0],["فأَكْرِمْ بِيَوْمٍ فيه أَكْرَمُ مَوْلِدٍ","لأَكْرَمِ مَوْلُودٍ نَمَتْهُ حُجُورُ",43,"ر",1,0],["فأكْدَيْتُ لمّا بَلَغْتُ المَدى","وعُرّيتُ لمّا لَبِستُ النُّهى",44,"ا",1,0],["فَاِكتَسَت مِنهُ طَرائِفَهُ","وَاِستَزادَت فَضلَ ما تَهِبُ",45,"ب",1,0],["فَأَكيلُ قُلنا بَعدَ خُبرٍ إِنَّنا","لا نَشتَري سَمَكاً بِبَطنِ الوادي",46,"ي",1,0],["فَأَكونُ قَد سَبَّبتُ فُرقَتَنا","وَحَطَطتُ مُجتَهِداً عَلى ظَهري",47,"ي",1,0],["فَاِكتَسَبا مَن يَدَّعي ذا وَذا","قَلائِداً تَبقى وَأَطواقا",48,"ق",2,0],["فَاِكحَل بِعَبدَةَ مُقلَتَيكَ مِنَ القَذى","وَبِوَشكِ رُؤيَتِها مِنَ الهَمَلانِ",49,"ن",1,0],["فَاِكتَسِب ناقِلَةً مِن وُدِّهِ","عَزَّ مَن وَدَّ اِبنُ سَلمٍ وَنُصِر",50,"ر",1,0],["فَاِكسِب مِنَ المالِ ما تَبني بِهِ شَرَقاً","أَو عِش بِرَغمٍ قَصِيّاً غَيرَ مَعدودِ",51,"د",1,0],["فَاِكشِفي ما بِنا وَعودي عَلَينا","قَد لَقينا إِلَيكِ في الحُبِّ حَسبا",52,"ب",2,0],["فَاِكفُف لِسانَكَ أَن تُعَيِّرَ وَاِعلَمَن","أَن لَيسَ يَأمَنُ ما يَعيبُ مُعَيِّرُ",53,"ر",1,0],["فَأَكرِه عَلى الخَيرِ مَجبولَةً","عَلى غَيرِهِ في عِلانٍ وَسِر",54,"ر",1,0],["فَاِكتُم حَديثَكَ لا يَشعُر بِهِ أَحدٌ","مِن رَهطِ جِبريلَ أَو مِن رَهطِ إِبليسِ",55,"س",1,0],["فَاِكفِف بِسَيرِكَ ذَيلَ الخَطبِ مُبتَدِراً","فَالخَلقُ أَمرَهُ أَو فيهِ الدُجى كَحلُ",56,"ل",1,0],["فأكرم بقوم ناضلوا عن حقوقهم","وأَشجع بقوم لا يروعهمُ الذعر",57,"ر",1,0],["فاِكتَسى حكم الذات رأساً وصدراً","بعد أَن كان نطفة أَمشاجا",58,"ج",2,0],["فأَكبرْ بشعرٍ كان حراً كربِّه","وأَكبرْ بحرٍّ لا يَكون مقيدا",59,"د",2,0],["فاكْفُفْ جفونَكَ عن غَرائرِ فارِسٍ","فالضّرْبُ يَثْلِمُ في غِرَارِ الصارم",60,"م",1,0],["فاكتَنِت لا تَكُ عَبداً طائراً","واحذَرِ الأَقتالَ مِنَّا والثَّوَر",61,"ر",1,0],["فَأَكْثَرُ مَنْ لاقَيْتُ لَمْ يَصْفُ قَلْبُهُ","وَأَصْدَقُ مَنْ وَالَيْتُ لَمْ يُغْنِ وُدُّهُ",62,"د",2,0],["فَأَكْبَرَ كُلُّهُمُ أَنَّهُ","رَآهُ تَجَلَّى وَلَمْ يَسْجُدِ",63,"د",1,0],["فَأَكونَ قَد أُسقيتُ مِنها ريقَها","وَأُنِلتُ حُسنَ بَنانِها وَخِضابِها",64,"ب",3,0],["فَأَكونَ لا أَنحَلُّ عَنها ساعَةً","دونَ الثيابِ مُجاوِراً لِحِقابِها",64,"ب",3,0],["فَأَكرِم بِمَن فيها ع