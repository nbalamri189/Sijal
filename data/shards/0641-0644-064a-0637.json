{"poems":[[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[68,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[46,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[147,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[147,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[411,"أبا العباس لا تحسب بأني","https://www.aldiwan.net/poem49928.html","الوافر"],[438,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61031","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56695","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110769","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103026","الكامل"],[5127,"وقفتْ ومدمعُها على اﻷجفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=177316",""],[5136,"أودى بحمد الله عامر","https://www.poetsgate.com/ViewPoem.aspx?id=121599",""]],"verses":[["فليَطِرْ معشرٌ ويعلوا فإني","لا أراهم إلا بأسفل قابِ",0,"ب",1,0],["فليطلهم بالصالحاتِ البواقي","وليطولوهُ بالعظامِ البوالي",1,"ل",2,0],["فليطلْ رغمَ حاسديه على الفض","لِ طُوالاً يجوز حدّ الطّوالِ",1,"ل",1,0],["فَليَطُل بَعدَهُ عَلى الدَهرِ عَتبي","رُبَّ ذَمٍّ مُلَقَّبٍ بِعِتابِ",2,"ب",1,0],["فَليَطُل عُمرُهُ فَلَو ماتَ في مَر","وَ مُقيماً بِها لَماتَ غَريبا",3,"ب",2,0],["فَلَيطْلُعنَّ إِلَيْك مِن زَهرِ الحِجا","أَبْكَارُ شُكْرٍ لُحْن في إِبّانِهَا",4,"ن",3,0],["فَلْيَطِبُ فِي جِوَارِ مَوْلاَهُ شِيرينُ","وَيَأْخُذْ مِنْ فَضْلِهِ بِخَلاَقِ",5,"ق",1,0],["فَليَطلُبِ الصَبواتِ غَيرُكَ صاحِباً","ماذا العَزوفُ لِصَبوَةٍ مُستَصحِبُ",6,"ب",1,0],["فَليَطلُبوا لِلضَيمِ جَنباً لَيِّناً","حاشاكَ مِمّا أَمَّلوا حاشاكا",7,"ك",2,0],["فَليَطلُبِ الرومُ الأَمانَ فَقَد بَدَت","لَهُمُ خُشونَةُ صارِمٍ وَلَيانُهُ",8,"ن",2,0],["فلي طبعٌ كسَلسالٍ مَعينٍ","زُلالٍ من ذُرا الأحجارِ جارِ",9,"ر",1,0],["فليُطِلْ بعدَها الفَخارَ فقد را","حَ طليقاً لبعضِكُم حيثُ راحا",10,"ح",2,0],["فَليَطلبوا الأَمن مِن إِمام","في كَفهِ الصفح وَالعِقاب",11,"ب",1,0],["فليطب قوم كرام سلفوا","أنهم قد خلفوا قوماً كراما",12,"م",2,0],["فليطلق أو يقف حتى يرى","أنها قد بلغت أقصى الأمد",13,"د",1,0],["فليطب أرجاء قبر زارها","إنها حاكته في حسن الرجا",14,"ج",2,0],["فليطمئن الكون منك براحة","كانت أناملها رقى الأكوان",15,"ن",1,0],["فليطمئنَّ لكِ الفؤادُ فإنَّهُ","ﻻكَ الكماةَ بجرعةِ اﻷشجانِ",16,"ن",1,0],["فليطمهم طماً ببحر","وغى تلاطم بالعساكر",17,"ر",1,0]]}