{"poems":[[39,"لو قيل للجود من حليفك ما","https://www.aldiwan.net/poem6420.html","المنسرح"],[14,"إن تأخذوا أسماء موقف ساعة","https://www.aldiwan.net/poem38316.html","الطويل"],[60,"ضربته بالسيف فوق الهامه","https://www.aldiwan.net/poem30871.html","الرجز"],[46,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[234,"أيها الماجد الذي لم يقصر","https://www.aldiwan.net/poem51050.html","الخفيف"],[240,"يا عماد الدين يا أك","https://www.aldiwan.net/poem32195.html","مجزوء الرمل"],[255,"أنا في راحة من الآمال","https://www.aldiwan.net/poem15018.html","الخفيف"],[408,"أي سيف نضته لي جفناكا","https://www.aldiwan.net/poem46729.html","الخفيف"],[438,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[563,"أيها البرق اللموع","https://www.aldiwan.net/poem34383.html","مجزوء الرمل"],[567,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87828","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126647","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60891","المتدارك"],[4915,"فجرُ العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=211262",""],[5809,"جمر وخوف","https://www.poetsgate.com/ViewPoem.aspx?id=205396",""],[5956,"ابتسم للكون يمنحْك ابتساما","https://www.poetsgate.com/ViewPoem.aspx?id=194582",""]],"verses":[["أنت أخوه وأنت صورته","والرأس منه وغيرك الذنبُ",0,"ب",1,0],["إِن تَأخُذوا أَسماءَ مَوقِفَ ساعَةٍ","فَمَأخَذُ لَيلى وَهيَ عَذراءُ أَعجَبُ",1,"ب",1,1],["أَنتَ أَخي وَمَعدَنُ الكَرامَه","وَمَن لَهُ مِن بَعديَ الإِمامَه",2,"م",2,0],["أَنتَ أَخونا وَسَيِّدٌ مَلِكٌ","نَخلَعُ ما نَستَزيدُ مِن خَلَعِه",3,"ع",2,0],["إن تأخذَوا سَبعين من أبطالهم","رَهناً يَكُنْ حَزماً ورأياً شافيا",4,"ي",2,0],["أنت أخْرسْتَني عن الدهر بالجو","د ولولا الحسين كنت أُزَنِّي",5,"ن",2,0],["إن تأخّرتُ باختيار زماني","عنك فاعلم أن الدنّو اختياري",6,"ر",2,0],["إِن تَأَخَّرتُ فَقَد قَد","دَمتُ في اللَيلِ دُعائي",7,"ي",1,0],["إن تأخَّرتُ قيل ملَّ وإن لا","زَمتُ أُدعَى من جُملَةِ الأثقَالِ",8,"ل",1,0],["أنتَ أخفيتني نحولاً فقل لي","كيف أقوى على احْتمال جفاكا",9,"ك",2,0],["إِن تَأَخَّرْتَ فالمُحَرَّمُ عُطْلٌ","من حِلَى العيد وَهْوَ في شَوَّالِ",10,"ل",1,0],["أنت إخلاصي وزهدي","أنت صبري والخضوع",11,"ع",1,0],["إنْ تأخَّرتَ مُدةً فالقَوافي","آخِرُ الشِّعرِ وَهْيِ أعلاهُ قَدْرا",12,"ر",2,0],["أَنتِ أَخرَستِ بي هَزاراً طَروباً","كانَ لَولاكِ دائِمَ التَلحينِ",13,"ن",1,0],["أنت أخرت أرمنا بوشاة","هي عين التزوير والبهتان",14,"ن",1,0],["أنت أخت الظبي بلا حرج","وسهيل الشيخ أخو الكرم",15,"م",1,0],["أنتَ أخرجتَني لتُشرقَ ذاتي","من جديدٍ ، فأنتَ للفجرِ بشرى",16,"ر",2,0],["أَن تأخذَ الجيمَ قسراً ثم تُبدِلهُ","بالخاءِ منها ،فيَشقى من عواقبِها",17,"ه",2,0],["إنْ تأخرتُ بتنفيذ وفائي","ليَ منك العذر يا ستر الأيامى",18,"م",2,0]]}