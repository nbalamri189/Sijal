{"poems":[[108,"هوينك بالغيور من الرجال","https://www.shoaraa.com/p13817",""],[55,"خلوتم بأنواع السرور هناكم","https://www.aldiwan.net/poem26064.html","الطويل"],[86,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[51,"بليت بفلتة فضحكت فلته","https://www.aldiwan.net/poem8706.html","الوافر"],[51,"لما حق من صد عن مشرب","https://www.aldiwan.net/poem65400.html","المتقارب"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[29,"شفى النفس قتلى من كليب وعامر","https://www.aldiwan.net/poem6094.html","الطويل"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[91,"وقائلة هجرت الشعر حتى","https://www.aldiwan.net/poem62775.html","عموديه"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[62,"أتسعى هكذا أبدا","https://www.aldiwan.net/poem52452.html","مجزوء الوافر"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[28,"وصيابة السعدين حولي قرومها","https://www.aldiwan.net/poem5074.html","الطويل"],[61,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[61,"لنا من الدهر خصم لا نغالبه","https://www.aldiwan.net/poem51782.html","البسيط"],[66,"هو الدهر مغرى بالكريم وسلبه","https://www.aldiwan.net/poem40134.html","الطويل"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[105,"لئن ظهرت لنا رغبات قوم","https://www.aldiwan.net/poem42137.html","الوافر"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[105,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[105,"بني عامر ردوا عن الشر عامرا","https://www.aldiwan.net/poem44014.html","الطويل"],[48,"ألا قل لإسماعيل إنك شارب","https://www.aldiwan.net/poem65264.html","الطويل"],[46,"سألت منجمها عن الطفل الذي","https://www.aldiwan.net/poem22701.html","الكامل"],[46,"يزورني القوم هذا أرضه يمن","https://www.aldiwan.net/poem22795.html","البسيط"],[46,"ألم تر أن جسمي فيه فضل","https://www.aldiwan.net/poem22987.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19209","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42567","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199503","السريع"],[100,"لِعينيكَ يا مَوطني","https://www.poetsgate.com/ViewPoem.aspx?id=183583",""],[94,"اتسألين عن الخمسين ؟","https://www.poetsgate.com/ViewPoem.aspx?id=15626",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[116,"اتسعفني عيني ببذل دموعها","https://www.aldiwan.net/poem40903.html","عموديه"],[133,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[161,"أتسأل عن دم لك فيه حلا","https://www.aldiwan.net/poem58930.html","الوافر"],[161,"من كان يكتب ما الأيام تمليه","https://www.aldiwan.net/poem59160.html","البسيط"],[161,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[161,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[182,"سقى الله الدوافع من حفير","https://www.aldiwan.net/poem58835.html","الوافر"],[187,"وقفت على بائع مرة","https://www.aldiwan.net/poem43269.html","المتقارب"],[212,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[222,"أتستقبل الدهر مستبشرا","https://www.aldiwan.net/poem55293.html","المتقارب"],[230,"يا عذبة الوصل والصدود ويا","https://www.aldiwan.net/poem50759.html","المنسرح"],[236,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[242,"أأهنأ بالدنيا ومولاي واجد","https://www.aldiwan.net/poem45770.html","البسيط"],[253,"أيرجع عصر بالجزيرة رائق","https://www.aldiwan.net/poem1476.html",""],[271,"إلام تناجيني النجوم الزواهر","https://www.aldiwan.net/poem35685.html","الطويل"],[365,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[372,"أتسكن بعد فراق السكن","https://www.aldiwan.net/poem57056.html","المتقارب"],[372,"أتسقي جفونك كأس الهوى","https://www.aldiwan.net/poem57254.html","المتقارب"],[392,"أتسألني ولست لذاك أهلا","https://www.aldiwan.net/poem54616.html","عموديه"],[403,"أتسرقني وأنت أجل خل","https://www.aldiwan.net/poem46503.html","الوافر"],[404,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[404,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[407,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[441,"أیدرك قومي أن بالأرض مغنما","https://www.aldiwan.net/poem68017.html","عموديه"],[442,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[442,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[454,"تمهل أمام الماء حين ابتسامه","https://www.aldiwan.net/poem61235.html","الطويل"],[454,"تمهل يا قطار علام تجري","https://www.aldiwan.net/poem61365.html","الوافر"],[496,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[516,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[529,"لله ما هاج لمع البارق الساري","https://www.aldiwan.net/poem2483.html","البسيط"],[530,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[537,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[539,"أتسمع يا عبداللطيف فإن تكن","https://www.aldiwan.net/poem47466.html","عموديه"],[539,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[552,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[559,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[586,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""]],"verses":[["أتسأل مقولي مدحاً لطه","فيحرم مسمعيك من النوال",0,"ل",1,0],["أَتَستَحسِنونَ الهَجرَ نَفسي فِداؤُكُم","أَلا كُلُّ ما اِستَحسَنتُمُ فَهُوَ الحَسَن",1,"ن",1,0],["أَتَسعى إِلَيَّ حُماةُ القَريضِ","وَتَمشي إِلَيَّ سَراةُ العَرَب",2,"ب",1,0],["أَتَسُوءُ إِخْوَاناً مَلَكْتَ قُلُوبَهُمْ","ظَرْفاً وَكَنْتَ مَسَرَّةَ الإِخْوَانِ",3,"ن",1,0],["أَتَسْتَرِيحُ وَقَدْ كُنْ","تَ ضَامِناً لِلْمَغَارِمْ",4,"م",1,0],["أَتَسمو بِما شادَت أَوائِلُ وائِلٍ","وَقَد غَمَرَت تِلكَ الأَوالي الأَواخِرُ",5,"ر",1,0],["أتُسمِعُني الأذى وتُشِمُّنيهِ","وتَجشِمُني رضَى ما قد فعلتَهْ",6,"ت",2,0],["أتسلمنا للردى ستة","وقد كنت ترحمنا أربعه",7,"ع",2,0],["أتَسْمَح باستِ أمِّك للقوافي","وتبخَلُ بالكفاف على أخيكا",8,"ك",2,0],["أَتَسعى بِيَربوعٍ لِتُدرِكَ دارِماً","وَفيمَ اِبنُ ثُفرِ الكَلبِ مِن بَيتِ حاجِبِ",9,"ب",1,0],["أَتَستَقِرُّ جُنوبٌ في مَضاجِعِها","وَفي مَضاجِعِها الأَرزاءُ وَالغِيَلُ",10,"ل",1,0],["أَتَسكُتُ وَالشَبابُ عَلَيكَ ضافٍ","وَحَولَكَ لِلهَوى جَنّاتُ عَدنِ",11,"ن",1,0],["أَتَستَكثِرونَ لَهُم واحِداً","وَلّى القَديمُ نَصيرَ الحَديد",12,"د",1,0],["أتُسْلِمُ للخَطّيّةِ ابنَكَ هَارِباً","وَيَسْكُنَ في الدّنْيا إلَيكَ خَليلُ",13,"ل",1,0],["أتسعَى هكذا أبَدا","وتأمُلُ عيشةً رغَدَا",14,"د",2,1],["أَتَسومانِني الصُدودَ وَكَالعَل","قَمِ لَو تَعلَمانِ طَعمُ الصُدودِ",15,"د",1,0],["أَتَسَلّى عَنِ الحُظوظِ وَآسى","لِمَحَلٍّ مِن آلِ ساسانَ دَرسِ",16,"س",1,0],["أَتَسأَلُني لَن أَخفِضَ الحَربَ بَعدَما","غَضِبتُ وَشالَت بي قُرومٌ هَوادِرُ",17,"ر",1,0],["أَتُسلِمُني بعدَ أن أوجَدَتْ","على نُوَبِ الدَّهرِ جاراً مُجيرا",18,"ر",2,0],["أَتُستباحُ على قَسْرٍ مَحارِمُه","وتُستَرقُّ على صُغْرٍ كواعبُه",19,"ب",2,0],["أَتَسلُبُهُ الأَعداءُ مِن بَينَ رَهطِهِ","وَتَغتالُهُ الأَيّامُ مِن دونِ صَحبِهِ",20,"ب",2,0],["أَتَسلُبُكَ المَنونُ وَأَنتَ طَودٌ","وَتَرخِصُكَ الكُماةُ وَأَنتَ غالِ",21,"ل",1,0],["أَتسألُ مِصرُ ما حَملَ العميدُ","وهل عند الرُماةِ لها جديدُ",22,"د",1,1],["أتسألُ فيمَ تختلف المساعي","وتَعجبُ كيف تَلتبِسُ القضايا",23,"ا",3,0],["أَتُسلِمُهُم إِلى صَمّاءَ تَثني","فُؤادَ الدَهرِ يَرتَعِدُ اِرتِعادا",24,"د",2,0],["أتُسلِمُ يا ثمامةُ إنّ هذا","وإنْ كَذَّبْتَنا لَهُوَ الأثامُ",25,"م",1,0],["أتسألُه يا ابنَ الطفيلِ خِلافةً","وَتطمعُ أن تُدْعَى الشَّريكَ المُشاطِرا",26,"ر",2,0],["أَتُسمِنُ أَولادَ الطَريدِ وَرَهطَهُ","بِإِهزالِ آلِ اللَهِ مِن نَسلِ هاشِمِ",27,"م",1,0],["أَتُسِرُّ شَيبَكَ عَن جَليسِكَ ضِلَّةً","وَالشَيبُ لَيسَ بِعاجِزٍ عَن جَهرِهِ",28,"ر",2,0],["أَتَسأَلونَ جَهولاً أَن يُفيدَكُمُ","وَتَحلُبونَ سَفيّاً ضَرعُها يَبَسُ",29,"س",1,0],["أَتَسمَعُ أَو تُعايِنُ أَو تُعاني","بِلاءً أَو تَذَوُّقُ أَو تَسوفُ",30,"ف",1,0],["أتسمعينَ الآن في صوتهِ","تَهَدُّجَ الأنَّاتِ من قلبهِ",31,"ه",1,0],["أتسألكَ الأفلاك عني أنا الذي","رمته الدياجي والرعودُ القواصفُ",32,"ف",1,0],["أتسألُ يا قلبي وأنت بجانبي","وكيْفَ ألم تعلم من الخفقانِ",33,"ن",1,0],["أَتَستَكثِرونَ لَهُم واحِداً","وَلّى القَديمُ نَصيرَ الجديد",34,"د",1,0],["أَتَسْأَلُنَا لُبْسَ الجَدِيدِ سَفَاهَةً","وَأَثْوابُنَا ما قَدْ عَلِمْتَ حَدِيدُ",35,"د",1,0],["أَتَسْمَعُهَا فَمَا القُمْرِيُّ يَشْدُو","وَتَشْرَبُهَا فَكَيْفَ السَّلْسَبِيلُ",36,"ل",1,0],["أَتَسْتَهْدِي فَكَيْفَ الصُّبْحُ يَبْدُو","وَقَدْ رُفِعَتْ مِنَ الظَّلْمِ السُّدُولُ",36,"ل",1,0],["اتسئلين القلب عما به","ألستّ تدرين بما قد دهاهْ ؟",37,"ا",2,0],["أَتَسأَلُنِي كيفَ أُعطِيكَ شِعرًا","وأَنتَ تُؤمِّلُ دُورًا وجرفْ",38,"ف",1,0],["أتسألين عن الخمسين ما فعلت","يبلى الشباب ولا تبلى سجاياه",39,"ا",2,1],["أتسأل عن أعمارنا ؟ أنت عمرنا","وأنت لنا المهدىّ .. أنت المحرّرُ",40,"ر",1,0],["أتُسْلمُني وأنتَ أعزُّ جارٍ","لدهرٍ لا يزال عَلَيَّ يعْدو",41,"د",2,0],["اتسعفني عيني ببذل دموعها","وتسعدني نفسي بشق دروعها",42,"ع",3,1],["أتسطاع في حَوكِ القَصَائِدِ شَأوَهُ","إذَا أَبيَضَّ مَعنَاهُ المَرُومُ أو أَحوَى",43,"و",2,0],["أتسأل عن دم لك فيه حلا","وفي القلب الهوى برضاك حلا",44,"ل",2,1],["اتستغيث على من يستغاث به","أم تستغيث على كفو يعاديه",45,"ي",2,0],["أتستلقى الأبوة عنه يوما","وتنتبه القرابة والرحامه",46,"م",2,0],["أتسترون على هذا مقالته","بلا حمية في الباري ولا غضب",47,"ب",1,0],["اتستدل بما قال الحبوش به","عند النبي فلم ينكر ولم يعب",47,"ب",1,0],["أَتَستَسقِى وَأَنتَ بِبَطنٍ قَوٍّ","أَروبَةَ أَرضِ قَومٍ آخَرِينَا",48,"ن",2,0],["أتسرقني ظالما فاغتدى","وأظهر لي بشّه والسلام",49,"م",1,0],["أتسرى معاً فيها كما كان عهدنا","وعهد الهوى أشهى مذاقاً من الشهد",50,"د",1,0],["أتستقبل الدهر مستبشراً","ومن شيمة الدهر أن يغدرَا",51,"ر",2,1],["أتَسْتَحِّلين في الجفا سَقَمي","أم تستَطيبِين في الهوى غَبْني",52,"ن",2,0],["أَتَسَلّى عَنكُم بِحَقفٍ وَغُصنٍ","مُستَهاماً فيكُم بِرِدفٍ وَقَدِّ",53,"د",1,0],["أتسقى الورى غيثاً فلا غصن ذابلٌ","على عهدِكَ الزاهي ولا روض مجدبُ",54,"ب",1,0],["أَتُسليك عَنّا كاذِباتٌ مِن المُنى","وَما خلتُ تُسليك الأَماني الصَوادق",55,"ق",1,0],["أتسهَرُ حتّى تَشهَدَ الزَّهرَ والدُّجى","يُنَوُّرُ مثلَ الزُّهر واللَيلُ سائر",56,"ر",1,0],["أتَسْبي فؤادي لا تُحارَبُ دونه","وكم سُعّرَتْ حتّى سُبيتَ حُروب",57,"ب",1,0],["أتَسكنُ بعد فراقِ السَّكَن","إلى وَسَنٍ لأطعمتَ الوَسَن",58,"ن",1,1],["أتَسقي جُفونَكَ كأسَ الهَوى","وتَمنعُ سكرانَها أَن يفيقا",59,"ق",2,1],["أتسألني ولست لذاك أهلا","وأنت لهذه العلل الطبيب",60,"ب",1,1],["أتسرقُني وأنتَ أجلُّ خِلٍّ","يعزُّ عليّ من حيٍّ وميْتِ",61,"ت",1,1],["أتسأل عن رحيلي يا بن ودي","فخذ تفصيل جملة كل فرد",62,"د",1,1],["أتسقون الفتى الظمآن منكم","إذا استسقى بكأس من سرب",63,"ب",1,0],["أَتَستَغرِب العَلياء أَحمَد ناشِئاً","وَقَد بانَ منه الفَضل قَبلَ فَصالِهِ",64,"ل",2,0],["أتسمع آذان بها الصم والوقر","وهل توقظ الأشعار من ضمه القبر",65,"ر",1,0],["أتسمع ناعي الثقلين حزناً","عليك ففي المدائن والموام",66,"م",1,0],["أتسمعني متى أدعوك شاك","أساي إليك أرجوك الأسيا",67,"ي",2,0],["أتسمعها إني لأسمع شعرها","أغاني من حب لآخر ناء",68,"ا",2,0]