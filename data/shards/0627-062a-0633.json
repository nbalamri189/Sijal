30536",""],[4442,"أناخ على ذكا فخبت ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=171228",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[6102,"قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=184624",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[4983,"أسرى بها الحبُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82961&r=&rc=1",""]],"verses":[["أتسأل مقولي مدحاً لطه","فيحرم مسمعيك من النوال",0,"ل",1,0],["أَتَستَحسِنونَ الهَجرَ نَفسي فِداؤُكُم","أَلا كُلُّ ما اِستَحسَنتُمُ فَهُوَ الحَسَن",1,"ن",1,0],["أَتَسعى إِلَيَّ حُماةُ القَريضِ","وَتَمشي إِلَيَّ سَراةُ العَرَب",2,"ب",1,0],["أَتَسُوءُ إِخْوَاناً مَلَكْتَ قُلُوبَهُمْ","ظَرْفاً وَكَنْتَ مَسَرَّةَ الإِخْوَانِ",3,"ن",1,0],["أَتَسْتَرِيحُ وَقَدْ كُنْ","تَ ضَامِناً لِلْمَغَارِمْ",4,"م",1,0],["أَتَسمو بِما شادَت أَوائِلُ وائِلٍ","وَقَد غَمَرَت تِلكَ الأَوالي الأَواخِرُ",5,"ر",1,0],["أتُسمِعُني الأذى وتُشِمُّنيهِ","وتَجشِمُني رضَى ما قد فعلتَهْ",6,"ت",2,0],["أتسلمنا للردى ستة","وقد كنت ترحمنا أربعه",7,"ع",2,0],["أتَسْمَح باستِ أمِّك للقوافي","وتبخَلُ بالكفاف على أخيكا",8,"ك",2,0],["أَتَسعى بِيَربوعٍ لِتُدرِكَ دارِماً","وَفيمَ اِبنُ ثُفرِ الكَلبِ مِن بَيتِ حاجِبِ",9,"ب",1,0],["أَتَستَقِرُّ جُنوبٌ في مَضاجِعِها","وَفي مَضاجِعِها الأَرزاءُ وَالغِيَلُ",10,"ل",1,0],["أَتَسكُتُ وَالشَبابُ عَلَيكَ ضافٍ","وَحَولَكَ لِلهَوى جَنّاتُ عَدنِ",11,"ن",1,0],["أَتَستَكثِرونَ لَهُم واحِداً","وَلّى القَديمُ نَصيرَ الحَديد",12,"د",1,0],["أتُسْلِمُ للخَطّيّةِ ابنَكَ هَارِباً","وَيَسْكُنَ في الدّنْيا إلَيكَ خَليلُ",13,"ل",1,0],["أتسعَى هكذا أبَدا","وتأمُلُ عيشةً رغَدَا",14,"د",2,1],["أَتَسومانِني الصُدودَ وَكَالعَل","قَمِ لَو تَعلَمانِ طَعمُ الصُدودِ",15,"د",1,0],["أَتَسَلّى عَنِ الحُظوظِ وَآسى","لِمَحَلٍّ مِن آلِ ساسانَ دَرسِ",16,"س",1,0],["أَتَسأَلُني لَن أَخفِضَ الحَربَ بَعدَما","غَضِبتُ وَشالَت بي قُرومٌ هَوادِرُ",17,"ر",1,0],["أَتُسلِمُني بعدَ أن أوجَدَتْ","على نُوَبِ الدَّهرِ جاراً مُجيرا",18,"ر",2,0],["أَتُستباحُ على قَسْرٍ مَحارِمُه","وتُستَرقُّ على صُغْرٍ كواعبُه",19,"ب",2,0],["أَتَسلُبُهُ الأَعداءُ مِن بَينَ رَهطِهِ","وَتَغتالُهُ الأَيّامُ مِن دونِ صَحبِهِ",20,"ب",2,0],["أَتَسلُبُكَ المَنونُ وَأَنتَ طَودٌ","وَتَرخِصُكَ الكُماةُ وَأَنتَ غالِ",21,"ل",1,0],["أَتسألُ مِصرُ ما حَملَ العميدُ","وهل عند الرُماةِ لها جديدُ",22,"د",1,1],["أتسألُ فيمَ تختلف المساعي","وتَعجبُ كيف تَلتبِسُ القضايا",23,"ا",3,0],["أَتُسلِمُهُم إِلى صَمّاءَ تَثني","فُؤادَ الدَهرِ يَرتَعِدُ اِرتِعادا",24,"د",2,0],["أتُسلِمُ يا ثمامةُ إنّ هذا","وإنْ كَذَّبْتَنا لَهُوَ الأثامُ",25,"م",1,0],["أتسألُه يا ابنَ الطفيلِ خِلافةً","وَتطمعُ أن تُدْعَى الشَّريكَ المُشاطِرا",26,"ر",2,0],["أَتُسمِنُ أَولادَ الطَريدِ وَرَهطَهُ","بِإِهزالِ آلِ اللَهِ مِن نَسلِ هاشِمِ",27,"م",1,0],["أَتُسِرُّ شَيبَكَ عَن جَليسِكَ ضِلَّةً","وَالشَيبُ لَيسَ بِعاجِزٍ عَن جَهرِهِ",28,"ر",2,0],["أَتَسأَلونَ جَهولاً أَن يُفيدَكُمُ","وَتَحلُبونَ سَفيّاً ضَرعُها يَبَسُ",29,"س",1,0],["أَتَسمَعُ أَو تُعايِنُ أَو تُعاني","بِلاءً أَو تَذَوُّقُ أَو تَسوفُ",30,"ف",1,0],["أتسمعينَ الآن في صوتهِ","تَهَدُّجَ الأنَّاتِ من قلبهِ",31,"ه",1,0],["أتسألكَ الأفلاك عني أنا الذي","رمته الدياجي والرعودُ القواصفُ",32,"ف",1,0],["أتسألُ يا قلبي وأنت بجانبي","وكيْفَ ألم تعلم من الخفقانِ",33,"ن",1,0],["أَتَستَكثِرونَ لَهُم واحِداً","وَلّى القَديمُ نَصيرَ الجديد",34,"د",1,0],["أَتَسْأَلُنَا لُبْسَ الجَدِيدِ سَفَاهَةً","وَأَثْوابُنَا ما قَدْ عَلِمْتَ حَدِيدُ",35,"د",1,0],["أَتَسْمَعُهَا فَمَا القُمْرِيُّ يَشْدُو","وَتَشْرَبُهَا فَكَيْفَ السَّلْسَبِيلُ",36,"ل",1,0],["أَتَسْتَهْدِي فَكَيْفَ الصُّبْحُ يَبْدُو","وَقَدْ رُفِعَتْ مِنَ الظَّلْمِ السُّدُولُ",36,"ل",1,0],["اتسئلين القلب عما به","ألستّ تدرين بما قد دهاهْ ؟",37,"ا",2,0],["اتسع الخرق على راقعه","من يشعب الوهى ويرتق الثأى",38,"ا",1,0],["أَتَسأَلُنِي كيفَ أُعطِيكَ شِعرًا","وأَنتَ تُؤمِّلُ دُورًا وجرفْ",39,"ف",1,0],["أتسألين عن الخمسين ما فعلت","يبلى الشباب ولا تبلى سجاياه",40,"ا",2,1],["أتسأل عن أعمارنا ؟ أنت عمرنا","وأنت لنا المهدىّ .. أنت المحرّرُ",41,"ر",1,0],["أتُسْلمُني وأنتَ أعزُّ جارٍ","لدهرٍ لا يزال عَلَيَّ يعْدو",42,"د",2,0],["اتسعفني عيني ببذل دموعها","وتسعدني نفسي بشق دروعها",43,"ع",3,1],["أتسطاع في حَوكِ القَصَائِدِ شَأوَهُ","إذَا أَبيَضَّ مَعنَاهُ المَرُومُ أو أَحوَى",44,"و",2,0],["أتسأل عن دم لك فيه حلا","وفي القلب الهوى برضاك حلا",45,"ل",2,1],["اتستغيث على من يستغاث به","أم تستغيث على كفو يعاديه",46,"ي",2,0],["أتستلقى الأبوة عنه يوما","وتنتبه القرابة والرحامه",47,"م",2,0],["أتسترون على هذا مقالته","بلا حمية في الباري ولا غضب",48,"ب",1,0],["اتستدل بما قال الحبوش به","عند النبي فلم ينكر ولم يعب",48,"ب",1,0],["أَتَستَسقِى وَأَنتَ بِبَطنٍ قَوٍّ","أَروبَةَ أَرضِ قَومٍ آخَرِينَا",49,"ن",2,0],["أتسرقني ظالما فاغتدى","وأظهر لي بشّه والسلام",50,"م",1,0],["أتسرى معاً فيها كما كان عهدنا","وعهد الهوى أشهى مذاقاً من الشهد",51,"د",1,0],["أتستقبل الدهر مستبشراً","ومن شيمة الدهر أن يغدرَا",52,"ر",2,1],["أتَسْتَحِّلين في الجفا سَقَمي","أم تستَطيبِين في الهوى غَبْني",53,"ن",2,0],["أَتَسَلّى عَنكُم بِحَقفٍ وَغُصنٍ","مُستَهاماً فيكُم بِرِدفٍ وَقَدِّ",54,"د",1,0],["أتسقى الورى غيثاً فلا غصن ذابلٌ","على عهدِكَ الزاهي ولا روض مجدبُ",55,"ب",1,0],["أَتُسليك عَنّا كاذِباتٌ مِن المُنى","وَما خلتُ تُسليك الأَماني الصَوادق",56,"ق",1,0],["أتسهَرُ حتّى تَشهَدَ الزَّهرَ والدُّجى","يُنَوُّرُ مثلَ الزُّهر واللَيلُ سائر",57,"ر",1,0],["أتَسْبي فؤادي لا تُحارَبُ دونه","وكم سُعّرَتْ حتّى سُبيتَ حُروب",58,"ب",1,0],["أتَسكنُ بعد فراقِ السَّكَن","إلى وَسَنٍ لأطعمتَ الوَسَن",59,"ن",1,1],["أتَسقي جُفونَكَ كأسَ الهَوى","وتَمنعُ سكرانَها أَن يفيقا",60,"ق",2,1],["أتسألني ولست لذاك أهلا","وأنت لهذه العلل الطبيب",61,"ب",1,1],["أتسرقُني وأنتَ أجلُّ خِلٍّ","يعزُّ عليّ من حيٍّ وميْتِ",62,"ت",1,1],["أتسأل عن رحيلي يا بن ودي","فخذ تفصيل جملة كل فرد",63,"د",1,1],["أتسقون الفتى الظمآن منكم","إذا استسقى بكأس من سرب",64,"ب",1,0],["أَتَستَغرِب العَلياء أَحمَد ناشِئاً","وَقَد بانَ منه الفَضل قَبلَ فَصالِهِ",65,"ل",2,0],["أتسمع آذان بها الصم والوقر","وهل توقظ الأشعار من ضمه القبر"