//www.aldiwan.net/poem927.html",""],[464,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[464,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[500,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[500,"أواه من ذاك الغزيل الأغن","https://www.aldiwan.net/poem37569.html","الرجز"],[500,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[500,"ماذا يضر البدر وهو في السما","https://www.aldiwan.net/poem37630.html","الرجز"],[500,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[500,"من رام جمع الناس في مذهب","https://www.aldiwan.net/poem38005.html","السريع"],[500,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[513,"يا قلب قد خان من كلفت به","https://www.aldiwan.net/poem67742.html","المنسرح"],[515,"تيقنوا أن قلبي منهم يجب","https://www.aldiwan.net/poem12032.html","البسيط"],[529,"إذا رضي الله عن عبده","https://www.aldiwan.net/poem37105.html","المتقارب"],[529,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[558,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[562,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[573,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[575,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[575,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[586,"لما رأت عشاقها قد أحدقوا","https://www.aldiwan.net/poem17630.html","الكامل"],[586,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"],[587,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"]],"verses":[["وَأَرجِعُ لَيسَ في كَفَّيَّ مِنهُ","سِوى عَضِّ اليَدَينِ عَلى الحُظوظِ",0,"ظ",1,0],["وَأَرجِعُ لَم أُولِغ لِسانِيَ في دَمي","وَلَم أُدمِ أَعضائي بِنَهشي وَلا عَضّي",1,"ي",1,0],["وَأَرجِعُ عَنهُ جَميلَ العَزاءِ","أَمسَحُ عَن ناظِرَيَّ الغُرُبا",2,"ب",2,0],["وَاِرجِعي ناصِلَةَ الأَظفا","رِ بَيضاءَ النُيوبِ",3,"ب",1,0],["وَأُرجِعُها مَفجوعَةً بِحُجولِها","إِذا اِنتَعَلَت مِن مَأزِقٍ بِدِماءِ",4,"ا",2,0],["وأرجَحُهُمْ إذا قَدَروا حُلُوماً","وأصْدَقُهُمْ إذا افتَخَروا مَقالا",5,"ل",2,0],["وَأَرجو التَداني مِنكِ يا اِبنَةَ مالِكٍ","وَدونَ التَداني نارُ حَربٍ تَضَرَّمُ",6,"م",1,0],["وَاِرجِع إِلى رَبِّ العِبا","دِ فَكُلُّ ما يَأتيكَ مِنهُ",7,"ن",2,0],["وأرْجعُ عُمْري منْ زَماني لِقابِل","كأنّيَ قد أحْصَيْتُ أيّامَهُ عَدّا",8,"د",2,0],["وَأُرَجّيها وَأَخشى ذُعرَها","مِثلَ ما يُفعَلُ بِالقَودِ السَنَن",9,"ن",1,0],["وَاِرجِع إِلى ما أَودَعَت","عِندَ المَجَلّاتِ الكُبَر",10,"ر",1,0],["وَاِرجِع إِلَينا بِالكَرامَةِ كاسِياً","وَعَلَيكَ مِن زَهَراتِها إِكليلُ",11,"ل",1,0],["وَأَرجو أَن تُعيدَ بَياضَ خَدّي","إِلَيَّ فَأَستَريحَ مِنَ الخِضابِ",12,"ب",1,1],["وأرجحهم لدى الجُلّى حلوماً","وأصلبهم لدى الغَمَرات عودا",13,"د",2,0],["وارجُ وعدَ المنى لديه فإسما","عيلُ ما زال معدناً للوفاء",14,"ا",2,0],["وأرجو الخلاص فقرّب به","لباب السلامة باب الفرج",15,"ج",1,0],["وأرجو أن يعاد سقيمُ حظي","لدرجي فهو محتاج العياده",16,"د",2,0],["وأرجو توبةً منكم نصوحاً","وبعضُ القومِ توبتُهُ خُتُولُ",17,"ل",1,0],["وَأَرجو التَلاقي كُلَّما بَخِلَت بِهِ","كَذَلِكَ يُرجى البَرقُ وَالبَرقُ خُلَّبُ",18,"ب",1,0],["وَأَرجو الوَفاء وَتَأبى النُفوسُ","وَأَنّى الوُلاةُ لِلعاقِرِ",19,"ر",1,0],["وارجع إليها فيا لله فاتحها","يوم الإياب ويا لله غازيها",20,"ي",3,0],["وَاِرجِع إِلى سِنِّ الخَلي","قَةِ وَاِتَّبِع نُظمَ الحَياةِ",21,"ه",1,0],["وَأَرَّجَ الفَتحُ أَرجاءَ الحِجازِ وَكَم","قَضى اللَيالِيَ لَم يَنعَم وَلَم يَطِبِ",22,"ب",1,0],["وأرجو كما تُرجى الغمائمُ وَدَّكْمُ","وتأبَوْنَ إِلّا خُلفكم للشوائمِ",23,"م",1,0],["وأرجو صفاءَ الودِّ منكم وعندَكمْ","فأرجو مذاقَ الشهدِ عندَ العلاقمِ",23,"م",1,0],["وأرجعيني إلى أسوار مدرستي","وأرجعي الحبر والطبشور والكتبا",24,"ب",2,0],["وارجعْ إلى الحقِّ والطبعِ السليمِ تجدْ","في طلعةِ الشمسِ ما يغنيكَ عَنْ زُحَلِ",25,"ل",1,0],["وَأُرَجّي أَن يَجمَعَ الدَهرُ شَملاً","بِكِ سَقياً لِذَلِكُم مِن زَمانِ",26,"ن",1,0],["وَاِرجُم بِرَأيِكَ شَدقَ لَيثٍ ضاغِمٍ","طَلَبَ الثَراءَ وَنابَ صِلٍّ ناهِسِ",27,"س",1,0],["وأرجأوهُ إلى إبَّانِ مَوْرِدهِ","يَعُبُّ من سُمِّهِ المُردِي ويَرتشِفُ",28,"ف",1,0],["وَأَرْجُو أن أعِيشَ به سعيداً","وَأَلقاهُ وَليس عَلَيَّ حُوبُ",29,"ب",1,0],["وأرّجَ الحقلَ من أنفاسها عبقٌ","يشوق كل جناحٍ نحوها خفَفا",30,"ف",2,0],["وَأَرجِعُ وَهيَ قَد وَلَّت خِفافاً","مُحَيَّرَةً مِنَ الشَكوى تَكِلُّ",31,"ل",1,0],["وَأَرجِعُ وَالنوقُ مَوقورَةٌ","تَسيرُ الهُوَينى وَشَيبوبُ حادي",32,"ي",1,0],["وَارْجِعْ إِلَى الدَّارِ الَّتِي أَوْحشْتَهَا","عَوْدَ الرَّبِيعِ إِلَى رُبُوعِ الدَّارِ",33,"ر",1,0],["وأرجع عند انسدال المساء","فأحلم أني رميت شقائي",34,"ي",1,0],["وَأَرجو مِن اِبني عَونَهُ بِشَفاعَةٍ","فَرُبَّ مُعانٍ لِلنَّجاةِ مُعانِ",35,"ن",1,0],["وأَرْجلٍ أوْهَنَ من هَمْسةٍ","ومن نسيم الصبح في مَرِّه",36,"ر",2,0],["وأرجو الوفاء وتأبى النفوس","وأنّى الولادة للعاقر",37,"ر",1,0],["وأرجعيني إلى أسوارِ مدرستي","وأرجعيني الحبرَ والطبشورَ والكتبا",38,"ب",2,0],["وارجع إلى الله بالقلب السليم وقف","ببابه وتواليك المسرات",39,"ت",1,0],["وارجع لحب العارفي","ن القدر أرباب الصفا",40,"ف",2,0],["وارجع إلى رأس الوظيفة عاجلاً","واعلم بأنك لست بالمأذون",41,"ن",1,0],["وأَرجُو مِن لَمَاكِ شِفَاءَ ما بي","فَكَم قَد سَاقَ لِى ألَماً لمَاكِ",42,"ك",1,0],["وَأَرجِعَ مَجذوذَ الرَجاءِ مُصَرَّداً","بِتَحلِئَةٍ عَن وِردِ تِلكَ المَناهِلِ",43,"ل",1,0],["وَاِرجِع رُجوعَ اللَيثِ وَهوَ مُظَفَّرٌ","وَالسَيفُ يَقطُرُ مِن غِرارَيهِ الدَمُ",44,"م",1,0],["وأرجاؤه أضحت ظلاماً ويرقه","سيوفا وأصوات المدافع كالرعد",45,"د",1,0],["وارجع وراءكَ عن طُرقٍ مضللة","فليس في كلِّ حين ترشد الطرق",46,"ق",1,0],["وارجع إلى الله واقرع بابَ رحمتِهِ","واصبر فذو الصَّبرِ مضمونٌ له الظفر",47,"ر",1,0],["وارج الغني مهما تمطّت كفه","قلماً وخفها إن تمطت مُرهفا",48,"ف",2,0],["وَأَرجم قبره في كل عام","كرجم الناس قبر أَبي رغالِ",49,"ل",1,1],["وإرجَافُ جَمعٍ بَعدَ جَمع وَغَابَةٍ","صَبَاحَ مَسَاءَ لِلجَنَانِ رَعُوب",50,"ب",1,0],["وأرجف بالكسوف ولست أدري","مكان الميل من وتدِ الكسوف",51,"ف",1,0],["وارجع إلى الياس إذا لم تجد","منصرفاً أقوى من الياس",52,"س",1,0],["وارجمْ شياطينَ الوغى بكواكبٍ","تمحو الضلالَ إذا التقى الجمعان",53,"ن",1,0],["وارجوك في الحشر الصراط تجيزني","جواز جزاء عن اجازة مدحتي",54,"ي",1,0],["وأرجع باسماً أطوى ضلوعي","على قلب بدنياه طعين",55,"ن",1,0],["وَاِرجِع إِلى عاداتِكَ الحُسنى فَما","عَوَّدتَني أَلقاكَ إِلّا مُنعِما",56,"م",2,0],["وارجع لله وفيه فثق","كم أنت كذا لم تصح أفق",57,"ق",1,0],["وأرجو الله تحقيق الأماني","بما ترجوه من جبر الخواطر",58,"ر",1,0],["وارجوه على ظمأ ممضٍ","ايرجو ذو الظما إلا العهادا",59,"د",2,0],["وارجع إلى عهدِ الفتوحِ فإنهُ","أَولى بحفظِ كرامةٍ وحفاظ",60,"ظ",1,0],["وأرجحهم وَزنا وارفعهم ذرا","واطهرهم قَلبا واطولهم يدا",61,"د",2,0],["وَأَرْجُو أَنْ يُسَوِّغَنِي قَبُولاً","بِهِ أُهْدِي المَدِيحَةَ كالهَدِيِّ",62,"ي",1,0],["وأرجو لديه الفضلَ فهو منيلُه","وما خاب لي منه الرجاء ولا الظنُّ",63,"ن",1,0],["وارجع شيعةً لعلا علي","وانزع بانتزاعي منزعين",64,"ن",1,0],["وَأَرجو أَن تَرِقَّ لِعاشِقَيهِ","فَتُقلِعَ عَن صُدودِكَ وَالتَجَنّي",65,"ي",1,0],["وأرجو أن أرى في الاربعاء","خروفا مع خروف معخروف",66,"ف",1,0],["وَأَرجو النَصرَ منكَ على عدوٍّ","متى اِستقبلتُه قَلبَ المِجَنّا",67,"ن",2,0],["وَأَرَّجَ أَرجاءَ الحِمى نشرُ طيبها","فَلَم يُدرَ مسكٌ ما تضوَّع أَم قسطُ",68,"ط",1,0],["وارجع إلى اللَه إذا","مالح خطب أو عصر",69,"ر",1,0],["وَأَرجو الآنَ منكَ ودمتَ تُرجى","كتابَ الطبّ ترسله لراقِ",70,"ق",1,0],["وَأَرجو منَ الرحمنِ حسنُ جزائهِ","وَمِنكم دُعاء مجزي القرض بالقرضِ",71,"ض",1,0],["وَأَرجَحُهم حلماً وَأَهدى سياسة","وأنداهمُ كفّاً وَأَدناهم عتبا",72,"ب",2,0],["وَاِرجُ الهَنا بِجَديدِ عامٍ أَنَّهُ","عامٌ بِما يَرجو جَنابَكَ آتي",73,"ت",2,0],["وأَرجو أَنْ يَعُودَ ضِياءُ عَيني","لَها فَيُمدَّها نُورُ الضِّياءِ",74,"ا",2,0],["وَأَرْجُو صِحَّتي لأراكَ إذْ لا","تُقَابَلُ أَنتَ إلاَّ بِالصَّحِيحِ",75,"ح",1,0],["وَاِرج في ساحة المَكارم مِنهُ","همّة الماجد النَبيل النَبيهِ",76,"ه",1,0],["واِرجُ عزّاً بخفض أَجنحة الذُل","لِ عَسى أَن تَنال رَفع الحِجابِ",77,"ب",1,0],["وأرجع اللَه كسلاناً بحافرةٍ","عنه وأولجَ في الفردوس يقظانا",78,"ن",2,0],["وارجع إلى الله وأخزى اللعين الرجيم","كم ذا وأنا في المخازي والمعاصي أهيم",79,"م",1,0],["وارجع إلى الله بالتوبة وصدق الدخول","في سيرة القوم من قبل القواطع تحول",80,"ل",1,0],["وأرجو خالقي يمنن علىّ","بمطلوبي بمحياي وحشري",81,"ي",1,0],["وأُرجّي ابْتناء بَيت فخارٍ","وهو مُغْرى بهدم ما أنا باني",82,"ي",1,0],["وارجُ الإِلهِ فَلَم يَخِبْ","راجي الإِله عَلا وَجَلْ",83,"ل",1,0],["وأرجو قريباً يبدل البين باللقا","وقبح النوى عنهم بحسن وصال",84,"ل",1,0],["وأرجو بأن يبقى الذي قد نشرته","بها دائماً حتى يدوم إلى الحشر",85,"ر",1,0],["وأرجوه يعفو كل ذنب أتيته","ويغفر لي ما كان في الهزل والجد",86,"د",1,0],["وارج الذي تهواه عن كتب","فالدهر لا يبقي على عهد",87,"د",1,0],["وأرجو من الرحمن نور هداية","تضيء إلى الحق القويم وتُرْشِدُ",88,"د",1,0],["وأرجع أختار الإِقامة خاملاً","حليف الجهول الوغد والحاسد النذل",89,"ل",1,0],["وأرجو أن تُظَفِّرَني سريعاً","عنايَتُه بغايات المرام",90,"م",1,0],["وأُرْجِعُ الحاسدَ الباغِي وقد سَلَكَ الْ","أَضَلاَعَهُ والهَمُّ والأَسَفُ",91,"ف",1,0],["وأرّجَتْ من رَبْع أوصافِه","يانِعَ زهرِ الجنةِ الزاهرِ",92,"ر",1,0],["وأرجّي لكم ما لم يكن","يرتجيه لكم مولى ومولى",93,"ل",2,0],["وأرْجى عَليلٍ لِبُرْءِ السَّقَامِ","عليلٌ تَيَقَّنَ يُمنَ الطَّبيبِ",94,"ب",1,0],["وأرجوك لي حيّاً وأرجو لوارثي","نداك وجسمي في التراب دفينُ",95,"ن",1,0],["وأرجع حين تختلف الليالي","ويصبح ماءُ قوم وهو آلُ",96,"ل",1,0],["وأرْجَحَ حِلْماً من ثَبيرٍ ويَذْبُلٍ","إذا هَفْوَةٌ حَلَّتْ حُبى الحُلماءِ",97,"ا",2,0],["وأرجو أن سادتنا الاجلاّ","بنيهم فيهم خلف عطوف",98,"ف",1,0],["وأرجع عن جدوى بنانك خائباً","وما عدت يوماً عن نداك بخائب",99,"ب",1,0],["وأرجعُ منهُ لو يطول بقاؤهُ","إلى كنز علم يستشار بلا كدح",100,"ح",1,0],["وارجع الأمر للمهيمن واصبر","فإلى الله كلُّ أمرٍ يؤلُ",101,"ل",1,0],["وارجع إلى الله ولا تكن كمن","بوهمه الفاسد يعبد الوثن",102,"ن",1,0],["وارجع إليه بعزم قلبٍ خالصٍ","محق الوجود وشامه القهارا",103,"ر",2,0],["وارجع إلى الله تعالى واسترح","وهو بلطف الصنع يبدي الكرما",104,"م",2,0],["وارجِعْ إلى اللهِ تَعالى مُخلِصاً","فكم أَجارَ بالرِّضا مُقْتَرِفَا",105,"ف",2,0],["وارجِعْ إلى اللهِ وُثوقاً به","فإنْ دَهى ذَنْبٌ هو الغافِرُ",106,"ر",1,0],["وأَرجَعَ بيضَهُ للغِمْدِ حُمراً","وقد مزَجَ البياضَ مع السَّوَادِ",107,"د",1,0],["وارجع إلى اللَه في الأمور فلن","تقدر أن تستجير من قدره",108,"ر",2,0],["وأرجف الناس حتى قال قائلهم","يا رائد الحي لا ماء ولا عشب",109,"ب",1,0],["وَأَرْجو بِأنِّيَ قَدْ نِلْتُهُ","وكَادَ يَكُونُ رَجائي يَقينا",110,"ن",2,0],["وَأَرْجُو أَنَّني في نَشْ","رِهِ في العالَمِ السّاعي",111,"ي",1,0],["وارجع الأمر إليه","ذاتك امْحَقْها فدنه",112,"ن",2,0],["وأرجِعُ إذْ أُراجِعُهُ كأنّي","فَطِنتُ بواحدٍ من بينِ أَلفِ",113,"ف",1,0],["وَأَرجو لَهُ حُبَّ النَبِيِّ مُحَمَّدٍ","فَذَنبُ مُحِبّيهِ بِغُفرانِهِ قَمَن",114,"ن",1,0],["وَأَرجو لِسُقياهُ سِقايَةَ مَورِدٍ","حَلا حَوضُهُ ما بَينَ أَيلَةَ وَاليَمَن",114,"ن",1,0],["وأَرجُو زوالَ النَّقصِ عنيِّ تفاؤُلاً","بنْعتِك حقّاً طَالما صَدق الفَالُ",115,"ل",1,0],["وأَرْجُلُها لو قُطِّعت لسَرتْ بمن","عليها لَهمْ والصِّل يَسْعى بِلاَ رِجْل",116,"ل",1,0],["وَارْجِعْ إلى حُسْنِ الوَفَاءِ فَإِنَّ قُبْ","حَ الغَدْرِ حُجَّةَ سَلْوَةِ المُشْتاقِ",117,"ق",1,0],["وَأَرجو غَيْرَ بابِكَ لي مَراماً","وأَقصِدُ غَيرَ رَبعِكَ لي مَقيلا",118,"ل",2,0],["وأرجأني خمساً وفي كل ليلة","يحاول أوساخاً تزول وتذهب",119,"ب",1,0]]}