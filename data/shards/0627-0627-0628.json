,"","https://poetry.dctabudhabi.ae/diwan/poem/83461","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83436","الطويل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121261","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18798","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141094","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33252","الطويل"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113004","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139735",""],[4691,"بث لأآمال رقايق","https://www.poetsgate.com/ViewPoem.aspx?id=84365",""],[4767,"الغدير","https://www.poetsgate.com/ViewPoem.aspx?id=179578",""],[4823,"شكوى مكلوم","https://www.poetsgate.com/ViewPoem.aspx?id=188850",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[4984,"فَتَلْتَ خُيُوطَ الظَّنِ","https://www.poetsgate.com/ViewPoem.aspx?id=215863",""],[5031,"غريبٌ عن جسد العراق","https://www.poetsgate.com/ViewPoem.aspx?id=165138",""],[4119,"ما هذه الحدث الفواتن","https://www.poetsgate.com/ViewPoem.aspx?id=16246",""],[585,"حياك منهمرُ الغوادي الجون","https://www.poetsgate.com/ViewPoem.aspx?id=161937",""],[5072,"سيبكي الليل","https://www.poetsgate.com/ViewPoem.aspx?id=52560",""],[5145,"ألا بكر السحاب ضحى الخميس","https://www.poetsgate.com/ViewPoem.aspx?id=108074",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5213,"واشم شارع نجدة","https://www.poetsgate.com/ViewPoem.aspx?id=170493",""],[5285,"جسر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203650",""],[5356,"مهر الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=204972",""],[5362,"بدت وهي حمراء مثل الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=170374",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5431,"ركبتُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=182998",""],[5595,"لا لنْ أبيعَ ضمائِري لوشاة","https://www.poetsgate.com/ViewPoem.aspx?id=150627",""],[5596,"فقيد البِرِّ والسخاء","https://www.poetsgate.com/ViewPoem.aspx?id=206382",""],[5700,"تمتمات الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=197305",""],[5790,"أأبا المظفر يوسف بن محمد","https://www.poetsgate.com/ViewPoem.aspx?id=112035",""],[5809,"دموع العين","https://www.poetsgate.com/ViewPoem.aspx?id=205702",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5943,"نزعنا السَّرجَ","https://www.poetsgate.com/ViewPoem.aspx?id=11091",""],[5956,"إلى مَتى ستبقى بَعيداً عَتِيّا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182225",""],[5956,"أنانياتها","https://www.poetsgate.com/ViewPoem.aspx?id=182455",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[6031,"وراءَ كُما إنَّ المُصَابَ جَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46289",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6259,"هبُوا أنّ سجني مانع لوصاله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59393&r=&rc=41",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["أَأَبقى عَلى نِضوِ الهُمومِ كَأَنَّما","سَقَتني اللَيالي مِن عَقابيلِها سُمّا",0,"م",2,1],["أَآبى وَلا حَدُّ أَسطو بِهِ","وَأَينَ الإِباءُ مِنَ الأَعزَلِ",1,"ل",1,0],["أَأَبقى كَذا أَبَداً مُستَقِلّا","يُقَلِّبُني الدَهرُ عِزّاً وَذُلّا",2,"ل",2,1],["أَإِبراهيمُ أَمّا دَمعُ عَيني","عَليكَ فَما يُعَدُّ وَلا يُحَدُّ",3,"د",1,0],["أَأَبلى ثُمَّ يَبدو بِاِصطِناعي","كَفاني ما تَقَدَّمَ مِن بَلائي",4,"ا",2,0],["أَأَبدى سَرائِرَكِ الظاعِنونا","أَقَرّوا عُيوناً وَأَبكَوا عُيونا",5,"ن",2,1],["أَأَبغي صِباً مِن بَعدِ هيلانَةٍ إِذاً","أُرانِيَ مُلغاً مِن وَفاءِ الحَبائِبِ",6,"ب",1,1],["أأبْرَحُ منْ مثْوى السّعادةِ والرِّضى","وحِلْيَتي العُلْيا ومَمْلكَتي القصْرُ",7,"ر",1,0],["أأبْصَرْتَنا كالشُّهْبِ والشّمْسِ فِتيةً","تَهَلَّلَ منّا البَرُّ والبَحْرُ ذو المَوْجِ",8,"ج",1,1],["أَأَبْصَرْتَ مِنِّي فِي الْمَصَانِعِ قُبَّةً","تَأَنَّقَ فِيَّ السَّعْدُ مِنْ كُلِّ جَانِبِ",9,"ب",1,1],["أَأَبَيتُم أَن نَرى يَوماً لَنا","في رُبوعِ العِلمِ شِبراً فَنُسَر",10,"ر",1,0],["أَأَبيعُ خَيْرَ فَتىً بِشَرِّ فَتىً وَفِي","خَلِقِي وَفِي خُلُقِي إِبَاءُ الذَّامِ",11,"م",1,0],["أأبناء المدارس أنّ نفسي","تؤمّل فيكم الأمل الكبيرا",12,"ر",2,0],["أأبناء المدارس هل مصيخٌ","إلى من تسألون به خبيرا",12,"ر",2,0],["أأبكاك بالعُرُفِ المنزلُ","وما أنت والطلل المُحْوِلُ",13,"ل",1,1],["أَأَبا المُرَجّى غَيرُ حُزنِيَ دارِسٌ","أَبَداً عَلَيكَ وَغَيرُ قَلبِيَ سالِ",14,"ل",1,0],["أَأَبا العَشائِرِ لا مَحَلَّكَ دارِسٌ","بَينَ الضُلوعِ وَلا مَكانِكَ نازِحُ",15,"ح",1,1],["أأبقى على عهدي وينكث قاسم","وتفنى أياديه وشكريَ لا يفنى",16,"ن",2,0],["أأبيّ يوسف دعوة المستصغِرِ","ويلَ التي حملتْك تسعةَ أشهرِ",17,"ر",1,1],["أَأُبَيَّ يوسفَ دعوةً من حاقرٍ","مستصغرٍ يأبى دعاءك من علِ",18,"ل",1,0],["أأبكتْكَ المعاهدُ والمغاني","كدأبك قبلَهُنَّ من الغواني",19,"ن",2,1],["أَأَبيتُ أَلهو وَالهُمومُ تُحيطُ بي","وَأَنامُ عَن قَومي وَقَومي في خَطَر",20,"ر",1,0],["أَأَبيعُ عَظمَ أَبي وَلحمَ عَشيرَتي","المَجدُ يَغضَبُ وَالمَروءَةُ تَعتِبُ",21,"ب",1,0],["أابعد عن مثواه في طيرانه","فضل طريق العود من بعد ابعاد",22,"د",1,0],["أَأَبا الحُسَينِ تَحِيَّةً لِثَراكَ مِن","روحٍ وَرَيحانٍ وَعَذبِ نِطافِ",23,"ف",1,0],["أَأَبا البَناتِ رُزِقتَهُنَّ كَرائِماً","وَرُزِقتُ في أَصهارِكَ الكُرَماءِ",24,"ا",2,0],["أَأَبا مُحَمَّدٍ اِتَّئِد في ذا النَوى","وَاِرفُق بِآلِكَ وَاِرحَمِ الأَبناءَ",25,"ا",2,0],["أأبقَى حُطاماً بالياً فوقَ ظهرِها","ومن تحتِها خُرعوبةُ الغُصُنِ النَّضْرِ",26,"ر",1,0],["أَإِبراهيمُ دَعوَةَ مُستَعيدٍ","لِرَأيٍ مِنكَ مَحمودٍ فَقيدِ",27,"د",1,1],["أَأَبي يا أَخي أَبوكَ فَيُهجى","أَو أَبو خُثعَمِيِّكَ الإِسكافِ",28,"ف",1,0],["أَأَبناءَ الطَّريقِ دَعُوا طريقاً","سبقْتُ ذَوي السِّباقِ به جَميعا",29,"ع",2,0],["أَ أَبا شجاعٍ يا عَقيدَ ندىً","كَرْمَتْ أَرومَتُه وعُنصرُه",30,"ر",2,0],["أأبناءَ الصليبِ تواعَدَتْكم","قواضبُ تَنثُرُ الهامَ اقتضابا",31,"ب",2,0],["أأبناؤهُ أنْتمْ سراة أكابرٍ","فكلكمُ من مُكْرَمٍ وابن مكرمِ",32,"م",1,0],["أأبياتُ شعرٍ أنتَ ناظمُ عقدِها","لتجبرَ كسري أمْ سلافٌ وقرقفُ",33,"ف",1,0],["أَأَبا الحُسَينِ وَما دَعَوتُ مُصَغَّراً","بِأَبي الحُسَينِ وَقَد دَعَوتُ كُبارا",34,"ر",2,0],["أَأَبقى أَسيرَ الحُبِّ في أَرضِ غُربَةٍ","وَحاديكُمُ يَحدو بِقَلبِيَ في الرَكبِ",35,"ب",1,0],["أأبيعُ الضُّيوفَ يا عمروُ دَعْها","خُطّةً تجعلُ العزيزَ مَهِينا",36,"ن",2,0],["أأُبيُّ أين العودُ والعَلَفُ الذي","أعددتَهُ وجعلته لطعامِهِ",37,"م",2,0],["أَأَبَو طالِبٍ كَمِثلِ أَبي الفَض","لِ أَما مِنكُمُ بِهَذا عَليمُ",38,"م",1,0],["أأبغي لديه طالباً ما كفيتَهُ","وأسألُهُ السُّقيا ودجلةُ لي تجري",39,"ر",2,0],["أَأَبكاكَ داعٍ في الصَباحِ سَميعُ","وَطَيفٌ سَرى مِن نَهرَوانَ يَريعُ",40,"ع",1,1],["أَأَبجَرُ هَل لِهَذا اللَيلِ صُبحُ","وَهَل بِوِصالِ مَن أَحبَبتُ نُصحُ",41,"ح",1,1],["أَأَبجَرُ قَد هَويتُ فَلا تَلُمني","عَلى كَبِدي مِنَ الهِجرانِ قُرحُ",41,"ح",1,0],["أَأَبجَرُ هَل تَرى بِالنَقبِ عيراً","تَميلُ كَأَنَّها سَلَمٌ وَطَلحُ",41,"ح",1,0],["أأبا بشارةَ لا يَرُعكَ بِعادُهُ","مصرُ اجتَبَتهُ فلا تُرَعْ ببعادِ",42,"د",1,0],["أأبغض حواءَ وهي التي","عرفتُ الحنانَ لها والرِّضى",43,"ض",2,0],["أأبغي لها شَرّاً ولم أرَ مِثْلَها","سَفَايِرَ ليلٍ أو سَفائنَ آل",44,"ل",1,0],["أَأَبْطَالَ الْعُرُوبَةِ إِنْ أَشَادَتْ","بِشُكْرِكُمُ فَمَنْ أَوْلَى بِشُكْرِ",45,"ر",1,0],["أَأَبَا المُروُءَةِ إِنَّ خَطْبَكَ خَطْبُهَا","أَوْ لَمْ تُفَارِقْهَا وَأَنْتَ شَهِيدُ",46,"د",1,0],["أَأَبقى أَخي دَمعاً أَذاقَ كَرىً أَخي","أَآبَ أَخي بَعدي مِنَ الصَبرِ آإِبُ",47,"ب",1,0],["أُأَبِّنُ هائِماً في كُلِّ واد","قَتيلاً ما لَهُ في الدَهرِ وادِ",48,"د",1,1],["أأبرح من مثوى السعادة والرضا","وحليتي العليا ومسكني القصر",49,"ر",1,0],["أأبْصرتَ مني في المصانع قُبَّة ً","تأنَّقَ فيى السَّعْدُ من كُلّ جانب",50,"ب",1,1],["أأبصرتنا كالشهب والشمس فتية","تهلل منا البر والبحر والموج",51,"ج",1,1],["أأبا عزِيزٍ كنتَ تُذكي جذوتي","ويَلَذُّ سَمْعُك مَنطقي وحِواري",52,"ر",2,0],["أأبا عزيزٍ والحديثُ كما رَوَوا","شَجَنٌ ، ومُرُّ القول عذْبٌ جاري",52,"ر",2,0],["أأبا فلاحٍ هل سمعتَ مَنَاحَةً","وَصَلَتْ إلى أسماعِ كلِّ سميع",53,"ع",1,0],["أأبهَجُ من هذا جمالاً و