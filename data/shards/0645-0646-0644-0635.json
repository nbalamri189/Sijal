tabudhabi.ae/diwan/poem/62500","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50033","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115895","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111786","الخفيف"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101825","الرمل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114025","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109346","الرمل"],[2301,"","https://poetry.dctabudhabi.ae/diwan/poem/146273","الخفيف"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105387","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93927","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100291","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118784","المديد"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132685","المديد"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126252","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91475","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117848","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85031","المديد"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85015","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85012","المديد"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34654","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86352","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127242","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73239","المديد"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136574",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83557","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83444","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83134","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72791","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123866","الخفيف"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124112","الرمل"],[5397,"أخذ الريع من دموعي حذاره","https://www.poetsgate.com/ViewPoem.aspx?id=157939",""],[6069,"من لصبٍ مسه فرط الكمد","https://www.poetsgate.com/ViewPoem.aspx?id=105660",""],[242,"بك هذا المكان يا من فراقه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563719",""],[4115,"من لصب لبريق الشام شام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607640",""]],"verses":[["مَنْ لِصَوْغِ المَبْنَى الْبَدِيعِ وَإِخْرَا","جِ المَعَانِي فِي ذَلِكَ التَّقْوِيمِ",0,"م",1,0],["من لصبّ أدنى البعاد وفاته","مذْ عداه وصل الحبيب وفاته",1,"ه",1,1],["مَن لِصَبٍّ أَدنى البُعادُ وَفاتَهُ","إِذ عَداهُ وَصلُ الحَبيبِ وَفاتَه",2,"ت",2,1],["منْ لصرعى الهمومِ بعدَك يا حا","فظُ من للحزينِ من للمعذّبْ",3,"ب",1,0],["مَنْ لصبٍّ دموعُه ليس تَرْفَاً","هَمَلاناً إنْ شَام بالشام بَرْقَا",4,"ق",2,1],["مَن لصَبٍّ تصاعدت حسراتُه","ومُحبٍّ تساقطت عَبَرَاتُه",5,"ت",2,1],["مَن لصبٍّ فوق فَرشِ ضَنىً","أبداً فَبُرؤه يَنتكس",6,"س",1,1],["مَنْ لِصَنْهَاجَةٍ بِوَصْلِ ابْنِ مَسْعُو","دِالإِمَامِ الذِي دَهَى إِشْرَاقُهْ",7,"ق",2,0],["مَن لِصَبٍّ لَم تَخبُ في الحُبِّ نارُهْ","كَيفَ تَخبو وَمُصطَليها اِدِّكارُه",8,"ر",2,1],["من لصب متيّم","في الهوى غير صابر",9,"ر",1,0],["مَن لِصبٍّ شَفَّه جورُ النَوى","كلَّما أَوجعَه التذكارُ أَنّا",10,"ن",2,1],["مَن لِصَبِّ مُتَيَّمٍ مُشتاقِ","قَد بَراهُ الأَسى وَعَزَّ الراقي",11,"ق",2,1],["من لِصَبٍّ صَبا المَعاهد أَشجاه","فَأَحالَت يَد النَوى مِنهُ حالا",12,"ل",2,1],["مَن لِصَبّ لَم يَنَل أَرَبا","مُستهلّ الدَمع هامرُه",13,"ر",2,1],["مَن لِصَبّ لَم يَنَل أَرَبا","مُستهلّ الدَمع هاطلُه",14,"ل",2,1],["مَن لِصَبّ لَم يَنَل أَرَبا","مُستهلّ الدَمع ساكبُه",15,"ب",2,1],["مَن لِصَبّ لَم يَنَل أَرَبا","مُستهام رقَّ وَاِنتَحَبا",16,"ب",2,1],["من لصبٍ أَحشاؤُهُ في التِهابِ","كُلُ يَوم وَدَمعُهُ في اِنسِكابِ",17,"ب",1,1],["مَنْ لصَبٍّ مُسْتَطارِ القَلْب هائمْ","يشتكي المُهْجَةَ من رُمْحٍ وصارِمْ",18,"م",1,1],["مَن لصادٍ ظامي الحشا يتلظَّى","غُلَّةً في فؤاده واضطراما",19,"ا",1,0],["من لصبِّ متَيَّمٍ مستهام","دَنِفٍ من صبابةٍ وغَرامِ",20,"م",1,1],["مَنْ لصبٍّ في هواكم مُستهام","دَنِفٍ نهبَ وُلوعٍ وغَرام",21,"م",1,1],["من لصب بات يبكي قاشلا","عز صبري ولهم طول البقا",22,"ق",2,0],["من لصب متيم ملتاحِ","أخذ العلم عن خدود الملاحِ",23,"ح",1,1],["مَن لِصَبٍّ ذابَ مِن حَرِّ الجَوى","يَسهَرُ اللَّيلَ وَلا يَدري المَنامْ",24,"م",1,0],["من لصبٍّ غيرِ صابرْ","ما له في الحب ناصرْ",25,"ر",1,1],["من لصبٍّ شفَّه طيف حبٍّ","حشو قلبٍ دائم الخفقانِ",26,"ن",1,0],["مَن لِصَبٍّ خانهُ فيك الجَلَد","ولقلبٍ شفَّهُ طولُ الكمد",27,"د",1,1],["مَن لصبٍّ ديونهُ يتقاضى","من اليفٍ عن الوفا يتغاضى",28,"ض",2,1],["من لصب أغرق الطرف بكاه","وعراه من هواكم ما عراه",29,"ا",2,1],["من لصب في الحب قضى شبابه","واحتسى خمرة الصبا والصبابه",30,"ب",2,1],["من لصب كلما حن بكى","وشكى البين بقلب موجع",31,"ع",1,1],["من لصبّ يرعى النجوم صبابه","ضيّع السير في الهموم شبابه",32,"ب",2,1],["من لصب لا يرى عنكم براحا","سامه الدهر الرغم انتزاحا",33,"ح",2,1],["من لصب يرى محياك يوحا","وإليه بسحر عينيك يوحا",34,"ح",2,1],["من لصب متيم القلب عانٍ","مشغل فيك ليله ونهاره",35,"ر",2,0],["من لصبٍّ بات منتظراً","عزَّ عنه وصل منتظره",36,"ر",2,0],["من لصب هائم ارق","بات يرعى انجم الغسق",37,"ق",1,1],["من لصب يراعى النجوم بليل","سرق الشوق للحبيب رقاده",38,"د",2,0],["من لصبٍّ فؤاده في غَرامٍ","يَشتكي سُقمَه وَيَرجو عيادَهْ",39,"د",2,1],["من لصب يصب صيب دمعٍ","مذ صبا نحوها أصابت فواده",40,"د",2,0],["مَن لِصَبٍّ صَبَّ مَدمَعُهُ","ما حَكاهُ المُزنُ في مُطرِهِ",41,"ر",2,0],["مَن لِصَبٍّ شَبَّ الهَوى نيرانُهُ","في حَشاشاتِهِ فَقاسي هَوانِهِ",42,"ن",2,1],["مَن لِصَبٍّ حائِرِ الفِكرِ","صَبَّ دَمعُ العَينِ كَالمَطَرِ",43,"ر",1,1],["من لصبٍّ لا يرعوي لملامِ","نضو كأسين من هوىً ومُدامِ",44,"م",1,1],["من لصب كلما رام لماك","رغبة فيه عن الكأس الدهاق",45,"ق",1,0],["من لصب لبريق الشام شام","فغدا يسفح دمعا كالغمام",46,"م",1,1],["من لصَبٍّ رَمَتْهُ مُقلةُ رئمٍ","حبُّهُ من ضميرهِ غيرُ رائمْ",47,"م",1,0],["من لصبّ فوقهُ الوصَبُ","وبراهث الهمُّ والوصبُ",48,"ب",1,1],["من لصَبٍ ماضي العَزيمة شهمٍ","باتَ يَشكو الجَوى لغير سَميع",49,"ع",1,0],["من لصبٍّ مهيَّم بِجنابه","وَهو كَالطَير في فَسيجِ رحابه",50,"ب",2,1],["من لصبٍّ صُبَّ البَلاءُ عَلَيهِ","وَبراه الأَسى وَقام الوعوثُ",51,"ث",1,0],["مَن لِصَبٍّ غَدَرَ الوا","في بِهِ حَتّى جُفُونُه",52,"ن",2,0],["من لصب بالنوى يوم النوى","ناحت الورقاءُ بالدوحِ فناحا",53,"ح",2,0],["من لِصبٍّ صريعِ لحظٍ شهيدِ","قتَلتهُ الظبا بغيرِ شهودِ",54,"د",1,1],["من لصبّ في الغرام اصطباره","ابعد الصدّ والتجنّي مزاره",55,"ر",2,1],["من لصب غلب الشوق اصطباره","فلذا باح وللحب اماره",56,"ر",2,1],["من لصب ساوت خطوب الليالي","نصب عينيه ليله ونهاره",57,"ر",2,0],["من لصبٍ مسه فرط الكمد","وفؤادٍ خانه فيك الجلد",58,"د",1,1],["مَن لِصَنهاجَةٍ بِوَصلِ اِبنِ مَسعو","دِ الإِمامُ الَّذي دَها إِشراقُهُ",59,"ق",2,0],["من لصب لبريق الشام شام","فغدا يصفح دمعا كالغمام",60,"م",1,1]]}