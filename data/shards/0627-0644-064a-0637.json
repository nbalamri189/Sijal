{"poems":[[73,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[95,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[29,"أواصل أنت سلمى بعد معتبة","https://www.aldiwan.net/poem6007.html","البسيط"],[53,"أمت بجود من وداد ومن شكر","https://www.aldiwan.net/poem64066.html","الطويل"],[93,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[91,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[107,"إلى طيئ يا ابن عم النبي","https://www.aldiwan.net/poem43588.html","المتقارب"],[22,"أفيما خلا من سالف العيش تدكر","https://www.aldiwan.net/poem21656.html","الطويل"],[50,"ألا قل يلحي على حب شاطر","https://www.aldiwan.net/poem66545.html","الطويل"],[52,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[48,"قد بكرت لا يعوقها سبل","https://www.aldiwan.net/poem23272.html","المنسرح"],[22,"افي ما خلا من سالف العيش تدَّكّرْ","https://www.poetsgate.com/ViewPoem.aspx?id=19747",""],[358,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[409,"الحمد لله عظيم الشأن","https://www.aldiwan.net/poem33345.html","الرجز"],[416,"إلى المصطفى المهدي خاضت ركابنا","https://www.aldiwan.net/poem67470.html","الطويل"],[422,"سؤالك هذا الربع أين جوابه","https://www.aldiwan.net/poem54156.html","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67839","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112857","الطويل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26682","الطويل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102146","الوافر"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111093","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53053","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53207","الطويل"],[2443,"","https://poetry.dctabudhabi.ae/diwan/poem/144865","الوافر"],[2443,"","https://poetry.dctabudhabi.ae/diwan/poem/144849","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137450",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65966","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93787","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62966","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108334",""],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124627","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77134","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107483","الرجز"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22072","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35059","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117272","الطويل"],[4806,"ماخنت ابنظر","https://www.poetsgate.com/ViewPoem.aspx?id=190863",""],[5232,"خذي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213007",""],[5431,"أيا خير من صافى وياخير من عفّا","https://www.poetsgate.com/ViewPoem.aspx?id=191456",""],[5573,"البارحه خايلت وصلك سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=213729",""],[5652,"ماكلهم صدّام لو بانو على العالم صِدام ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=180634",""],[5672,"في الحسين عليه السلام","https://www.poetsgate.com/ViewPoem.aspx?id=206429",""],[5732,"يبعد هموم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177894",""],[5732,"بالهرج يعطونك","https://www.poetsgate.com/ViewPoem.aspx?id=177914",""],[5732,"قلبي نهبته","https://www.poetsgate.com/ViewPoem.aspx?id=177915",""],[6056,"مثل الجبل رآسي","https://www.poetsgate.com/ViewPoem.aspx?id=130339",""],[6102,"غيبوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184544",""],[6171,"مدينة الرسول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84675&r=&rc=5",""]],"verses":[["إِلى طاهِرِ الأَنسابِ ما قَعَدَت بِهِ","عَنِ المَجدِ مِن بَعضِ الجُدودِ المَناسِبُ",0,"ب",1,0],["إِلَى طَرَابُلُسَ الدَّارِ الَّتِي دُعِيَتْ","فَيْحَاءَ مِنْ رَحَبٍ فِيهَا بَضِيفَانِ",1,"ن",1,0],["إِلى طَلائِحَ بِالمَوماةِ صادِيَةٍ","فيها عَلى الهَولِ وَالعِلّاتِ تَصميمُ",2,"م",1,0],["إلى طيب الأعراق والسيد الذي","أدالتْ يداه اليسرَ جوداً من العُسر",3,"ر",1,0],["إِلى طَريقٍ واضِحِ الشِجاجِ","أَسلُكُ فيهِ غَيرَ ما اِنزِعاجِ",4,"ج",1,0],["الى طبيب علمه وافر","يعرف سير اداء بالجس",5,"س",1,0],["إلى طَيِّئٍ يا ابنَ عمِّ النبيِّ","إلى معشرٍ يعبدون الصَّنَمْ",6,"م",1,1],["إِلى طَفلَةِ الأَطرافِ زَيَّنَ جيدَها","مَعا الحَليِ وَالطيبِ المَجاسِدُ وَالخُمُر",7,"ر",1,0],["إلى طاهرٍ من كل عيبٍ كأنّما","تردّى على غصن من البان ناضرِ",8,"ر",1,0],["إِلى طارِقاتِ الحَيِّ وَدَّعنَ قَلبَهُ","يَراها رَسيسَ المُغمِزاتِ التَلائِدِ",9,"د",1,0],["إِلى طَبيبٍ عَلى الطَريقِ لِكَي","تَأخُذَ مِن عِندِهِ دَواءَ حَبَل",10,"ل",1,0],["إلى طَفْلَة ِ الأطرافِ زَيَّنَ جِيدَها","مع الحلي والطّيب الجاسدُ والخمرْ",11,"ر",1,0],["إِلى طيبة المُختار وَالطيب بعض ما","لَها اللَه أَبدى مِن صِفاتٍ وَأَبدَعا",12,"ع",2,0],["إلى طريق سنة المختار","أحمد خير صفوة للباري",13,"ي",1,0],["إِلى طاهِرِ الأَخلاقِ ما نالَ مِن رِضاً","وَلا غَضَبٍ مالاً حَراماً وَلا دَما",14,"م",2,0],["إلى طلل أقوى فلم يك بعدها","بمغنيك شيئاً قربه واجتنابه",15,"ب",2,0],["إلَى طَاعَةِ الْمَوْلَى فَطَاعَتُهُ تَكْفِي","دَعِي عَنْكِ ذِكْرَ الْغَانِيَاتِ لِتُحْمَدِي",16,"ي",1,0],["إلى طيبة هاجر تنل خير إحسان","وتحظى بوصل مثل طيب سماني",17,"ن",2,1],["إلى طُرَرٍ تحكي أصائلَ ملكه","تكادُ بأنداء النضار تصوب",18,"ب",1,0],["إلى طنجة بل في ك","ل أرضٍ خيلُنا تسري",19,"ر",2,0],["إلى طه ولي الطلجه","رفَعتُ السول مطلبِ",20,"ب",1,0],["إلى طيبة العليا وبهجتها الغرا","تشوقني نفسي ولي كبد حرا",21,"ر",2,1],["إلى طويل نجادِ السَّيفِ تحسبه","تحتَ اللواء لواء والقنا أُشبُ",22,"ب",1,0],["إلى طود حلم ثابت الهضب شامخ","إلى بحر علم زاخر اللُّجِّ خضرم",23,"م",1,0],["إلى طُرُقِ المحبة يُهْتَدَى بي","ففي الظلماء تُهْدَى بي الطريقُ",24,"ق",1,0],["إلى طُرُقِ المحبة يُهْتَدَى بي","ففي الطلماء تُهْدَى بي الطريق",25,"ق",1,0],["إلى طرق الرشاد هدى كثيرا","وأنقذ آخرين من الضلال",26,"ل",1,0],["إلى طاعة الرحمن يهدى إلى الهدى","ويأبى الردى والضيم للّه طائع",27,"ع",1,0],["إلى طيبة الفيحاء طيبة الأرجا","نحث المطايا رغبة في الحمى الأرجى",28,"ج",2,1],["الى طَفَلٍ ما غيرَ الليلُ لونَه","اِليَّ بَدا الاصباحُ أَصبحَ مغتنَى",29,"ن",2,0],["إلى طلل بال قد انقلب المغنى","غداة اشقا الروح قد رحلوا عنا",30,"ن",2,1],["إلى طيبةَ الغرَّاءِ والزَم سكينةً","إذَا جِئتَهَا في دُورها والمرافق",31,"ق",1,0],["إِلى طيبِ مَلهى العَذارى وَمَلعَبِ","يَحِنُّ فُؤادُ المُستَهامِ المُعَذَّبِ",32,"ب",1,1],["اِلى طَلحَةِ الخَيراتُ تَعزى فُروعَه","فَيا حَبَّذا فَرع الاِصولُ الا طائِب",33,"ب",1,0],["إلى طريقٍ ما جرى","قبلُ عليها الشعرا",34,"ر",2,0],["إِلى طَرَفِ الجِمارِ وَما يَليها","إِلى ذاتِ القَتادةِ مِن ثَبيرِ",35,"ر",1,1],["إلى طوله المعروفِ طولُ يدِ الرَّجا","وفي بحرِ جدواه لآمالنا غَطُّ",36,"ط",1,0],["إِلى طروادة إِن كنت تسعى","فَلا تَنحر لِمعبودي قضيفا",37,"ف",2,0],["إلى طيبة أرض بها خيم العلا","فحُثّ ركاب العزم تعط الرغائبا",38,"ب",2,0],["ال يطبگ باب گلبه شيفتهم عالطير","والبابه جرس مايدري شنهي اچفوف",39,"ف",1,0],["إلى طير ٍ يُزقزقُ في ضياء ٍ","ويَضحكُ في شفاه ٍ من زهور ِ",40,"ر",1,0],["الى طفل آلامي شغافي هدية","فداء له قلبي وأهدي له النزفا",41,"ف",2,0],["الي طواه الياس متعب ركابه","يسهر طوال الليل للصبح مابات",42,"ت",1,0],["الي طلبني للشعر جيته اسوق إله السلام","يلقى قباله شاعرآ ساق البديع إحميّته",43,"ت",2,0],["إلى طفِّكِ البارزِ المُنجلي","إلى وجهِكِ الأطهرِ المُرملِ",44,"ل",1,0],["إلى طرا لي جض قلبي من اقصاه","يكفخ وقلكن يغضبنه مجانيه",45,"ي",2,0],["إلى طلبت ابشر نجيلك محايير","ولجلك نقرب حلة عند حله",46,"ل",2,0],["إلى طرا لي عنقك اللي لويته","اغيب باحلام السعاده بدنياي",47,"ا",2,0],["إلى طرالي قمت مفجوع وأصيح","ياردني بهاجوس ويصدر بهوجاس",48,"س",1,0],["إِلَى طَيرَي قَطَا ؛ انكَمَشَا بِكَفِّي","لَحِقتُهُمَا بِشَوقِي حَيثُ طَارا",49,"ر",2,0],["إلَى \"طَيْبةَ الأطّيَابِ \" يَمَمْتَ نَاظَرَاً","وفي النّفْسِ أشْوَاقٌ مِنْ الشْوقِ تَعْبِق !",50,"ق",1,0]]}