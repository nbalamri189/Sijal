{"poems":[[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[93,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[27,"أواصل أنت سلمى بعد معتبة","https://www.aldiwan.net/poem6007.html","البسيط"],[51,"أمت بجود من وداد ومن شكر","https://www.aldiwan.net/poem64066.html","الطويل"],[91,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[89,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[105,"إلى طيئ يا ابن عم النبي","https://www.aldiwan.net/poem43588.html","المتقارب"],[22,"أفيما خلا من سالف العيش تدكر","https://www.aldiwan.net/poem21656.html","الطويل"],[48,"ألا قل يلحي على حب شاطر","https://www.aldiwan.net/poem66545.html","الطويل"],[50,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[46,"قد بكرت لا يعوقها سبل","https://www.aldiwan.net/poem23272.html","المنسرح"],[22,"افي ما خلا من سالف العيش تدَّكّرْ","https://www.poetsgate.com/ViewPoem.aspx?id=19747",""],[353,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[403,"الحمد لله عظيم الشأن","https://www.aldiwan.net/poem33345.html","الرجز"],[410,"إلى المصطفى المهدي خاضت ركابنا","https://www.aldiwan.net/poem67470.html","الطويل"],[416,"سؤالك هذا الربع أين جوابه","https://www.aldiwan.net/poem54156.html","الطويل"]],"verses":[["إِلى طاهِرِ الأَنسابِ ما قَعَدَت بِهِ","عَنِ المَجدِ مِن بَعضِ الجُدودِ المَناسِبُ",0,"ب",1,0],["إِلَى طَرَابُلُسَ الدَّارِ الَّتِي دُعِيَتْ","فَيْحَاءَ مِنْ رَحَبٍ فِيهَا بَضِيفَانِ",1,"ن",1,0],["إِلى طَلائِحَ بِالمَوماةِ صادِيَةٍ","فيها عَلى الهَولِ وَالعِلّاتِ تَصميمُ",2,"م",1,0],["إلى طيب الأعراق والسيد الذي","أدالتْ يداه اليسرَ جوداً من العُسر",3,"ر",1,0],["إِلى طَريقٍ واضِحِ الشِجاجِ","أَسلُكُ فيهِ غَيرَ ما اِنزِعاجِ",4,"ج",1,0],["الى طبيب علمه وافر","يعرف سير اداء بالجس",5,"س",1,0],["إلى طَيِّئٍ يا ابنَ عمِّ النبيِّ","إلى معشرٍ يعبدون الصَّنَمْ",6,"م",1,1],["إِلى طَفلَةِ الأَطرافِ زَيَّنَ جيدَها","مَعا الحَليِ وَالطيبِ المَجاسِدُ وَالخُمُر",7,"ر",1,0],["إلى طاهرٍ من كل عيبٍ كأنّما","تردّى على غصن من البان ناضرِ",8,"ر",1,0],["إِلى طارِقاتِ الحَيِّ وَدَّعنَ قَلبَهُ","يَراها رَسيسَ المُغمِزاتِ التَلائِدِ",9,"د",1,0],["إِلى طَبيبٍ عَلى الطَريقِ لِكَي","تَأخُذَ مِن عِندِهِ دَواءَ حَبَل",10,"ل",1,0],["إلى طَفْلَة ِ الأطرافِ زَيَّنَ جِيدَها","مع الحلي والطّيب الجاسدُ والخمرْ",11,"ر",1,0],["إِلى طيبة المُختار وَالطيب بعض ما","لَها اللَه أَبدى مِن صِفاتٍ وَأَبدَعا",12,"ع",2,0],["إلى طريق سنة المختار","أحمد خير صفوة للباري",13,"ي",1,0],["إِلى طاهِرِ الأَخلاقِ ما نالَ مِن رِضاً","وَلا غَضَبٍ مالاً حَراماً وَلا دَما",14,"م",2,0],["إلى طلل أقوى فلم يك بعدها","بمغنيك شيئاً قربه واجتنابه",15,"ب",2,0]]}