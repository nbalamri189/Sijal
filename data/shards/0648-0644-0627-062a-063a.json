poetry.dctabudhabi.ae/diwan/poem/83637","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28672","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133071","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133096","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83199","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58063","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58112","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112139","الطويل"],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4755,"أَرَانِي في المَنَامِ لَهَا أقُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=184711",""],[4755,"جَاءَ الذي راحَ أو رَاحَ الذي جَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=190325",""],[4929,"حادي العيس (على نمط الشعر الجاهلي)","https://www.poetsgate.com/ViewPoem.aspx?id=201029",""],[4955,"خفيف الظل كن دوما","https://www.poetsgate.com/ViewPoem.aspx?id=202494",""],[4973,"حكم","https://www.poetsgate.com/ViewPoem.aspx?id=188674",""],[5183,"بين الهوى والتجمل","https://www.poetsgate.com/ViewPoem.aspx?id=180223",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[2365,"ظربت وشاقتك البروق اللوامع","https://www.poetsgate.com/ViewPoem.aspx?id=200652",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5277,"محاورة مع بنت المستكفي","https://www.poetsgate.com/ViewPoem.aspx?id=185412",""],[5320,"من أين هذا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=41630",""],[5442,"الذرك الشيب فهلا أرعويت","https://www.poetsgate.com/ViewPoem.aspx?id=114783",""],[5637,"دع الدّنيا لعاشِقِها","https://www.poetsgate.com/ViewPoem.aspx?id=94756",""],[5648,"طمن خفوقك","https://www.poetsgate.com/ViewPoem.aspx?id=156246",""],[5667,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=214869",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5855,"لا تله عن كسب ود الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=186733",""],[6070,"رحى الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=188815",""],[2220,"ما لي وإياكَ غيرَ اللهِ من سندٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11304&r=&rc=178",""],[572,"ألا فاسترزِقِ الرَّحمنَ خيراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9328&r=&rc=185",""]],"verses":[["وَلاَ تَغْتَرِرْ يَوْماً بِخَادِعِ زُخْرُفٍ","فَإِنَّ وُجُودَ النُّورِ أَضْغَاثُ أَحْلاَمِ",0,"م",1,0],["وَلاَ تُغْفِلاَ مِنْ وَسْمِهَا كُلَّمَا سَرَتْ","صُدُورَ الْقَوَافِي أَوْ صُدُورَ الرَّكَائِبِ",1,"ب",1,0],["وَلا تَغُرَّنكَ أَحقادٌ مُزَمَّلَةٌ","قَد يُركَب الدَّبِرُ الدامي بِأَحلاسِ",2,"س",1,0],["وَلا تَغتَرِر مِن بَعدِها بِحَماقَةٍ","وَإِن عَظُمَت قَد يَظلمُ التَيسَ حالِبُه",3,"ب",2,0],["وَلا تَغضَبَنَّ إِذا ما صُرِفتَ","فَلا عَدلَ فيكَ وَلا مَعرِفَه",4,"ف",2,0],["ولا تغتر أن قيل عصر تمدُّن","فإن الذي قالوه من أكذب الكذب",5,"ب",1,0],["ولا تُغفلْن أمراً وهى منه جانب","فيتبعَه في الوَهْي لاشك سائرُهْ",6,"ه",1,1],["ولا تَغاضبْ لتسفيلِ القريض بها","فكلُّ ما لقيتْ بالأمس تَسفيلُ",7,"ل",1,0],["ولا تَغَنَّيْتُ مأخوذاً ولا عَذُبَتْ","ليَ الحَيَاةُ لدى غَضِّ الرَّياحينِ",8,"ن",1,0],["وَلا تَغُرَّنَّكَ الإِمارَةُ في","غَيرِ أَميرٍ وَإِن بِها باهى",9,"ا",3,0],["ولاتغرنّك الأسماء فهي على آل","ألوان تظهر في أعقابها الأخرِ",10,"ر",1,0],["وَلا تَغفَل عَنِ الإِحسانِ فيها","فَما تَدري السُكونُ مَتى يَكونُ",11,"ن",1,0],["وَلا تَغتَرَّ بِالدُنيا","فَإِنَّ جَميعَها غَرَرُ",12,"ر",1,0],["وَلا تَغتَرَّ بِالدُنيا","فَإِنَّ صَحيحَها يَسقَم",13,"م",1,0],["وَلا تَغتَرِر بِرُكوبِ الكُمَيتِ","وَما تَستَجيدُ مِنَ المَلبَسِ",14,"س",1,0],["وَلا تَغرُركَ مَوعِدَةٌ لِحُبّى","فَإِنَّ عِداتِها أَنزَلنَ جَدبا",15,"ب",2,0],["وَلا تَغُرَّنْكَ فِي الدُّنْيَا مُشَاكَلَةٌ","بَيْنَ الأَنَامِ فَلَيْسَ النَّبْعُ كَالضَّالِ",16,"ل",1,0],["وَلا تَغُرَّنْكَ مِنْ وَجْهٍ بَشَاشَتُهُ","فَالسّمُّ يُوجَدُ فِي نَضْرٍ مِنَ الشَّجَرِ",17,"ر",1,0],["وَلاَ تَغَنَّى فَتَىً في الشَّرْقِ قَافِيَةً","إِلاَّ وَشِعْرُكَ مَا أَوْحَى وَمَا كَتَبَا",18,"ب",2,0],["ولا تُغْنَيْ بِنا إنّا بُكاةٌ","نَمُدُّكِ بالعويل وبالصياح",19,"ح",1,0],["ولا تُغْنَيْ بِنا فالفِعلُ جَوٌّ","مَغِيْمٌ عِندَنا والقولُ صاح",19,"ح",1,0],["ولا تغضبْ إذا خوشنْتَ يوماً","ولا تكُ في أوامرهم هَلُوعَا",20,"ع",2,0],["ولا تغضبْ فأنت رئيسُ قومٍ","وشَاورْهم تكن حصنا منيعَا",21,"ع",2,0],["ولا تغشينْ أسرارهم واخْفِ قولهم","لئلا يجدُّوا في قِلاك ويغضبوا",22,"ب",3,0],["ولا تَغرُركَ شِرذِمَةٌ","لديك فإنَّها لعب",23,"ب",1,0],["ولا تغل في حب وبغض فربما","يحبك من تشنا ويشناك من حبا",24,"ب",2,0],["ولا تغتبط فيها بفرحة ساعة","تعود بأحزان عليك طويلة",25,"ه",1,0],["ولا تغتررْ بالتي خلتَها","تسر الغرامَ بإعلانها",26,"ن",3,0],["ولا تَغرنك منه جُوخَةٌ","فصَّلَها وهوَ عليها نادِمُ",27,"م",1,0],["ولا تغضب لغير الله واترك","هوى الأغراض من نفسٍ وغادر",28,"ر",1,0],["وَلا تغنت بذات الاثل ساجعة","الا وَهيجني سجع وَمأثول",29,"ل",1,0],["وَلا تغلقوا الابواب دوني لزلتي","فنتم كِرام وَالكَريم غفور",30,"ر",1,0],["وَلا تَغْفِرْ لَهُ ذَنْباً فَيَضْرى","فَبَعْضُ الْعَفْوِ أَغْرى لِلْجُناةِ",31,"ه",1,0],["ولا تَغنّى حمامُ الأَيك في فَنَنٍ","إِلّا تذكّرتُ أَيّامي بمغناكِ",32,"ك",1,0],["ولا تغنى بذكر الغانيات شج","إلا جرى الدمع من عيني على النادي",33,"د",2,0],["ولا تغتر بالدنيا وذرها","فما الدنيا بدار للنزيل",34,"ل",1,0],["ولا تغضبن يوماً على سافك دما","ولا سارق مالا لصاحب فاقة",35,"ه",1,0],["وَلا تَغْضَبْ إذا أَنْشَدْتُ يَوماً","سِوَاهُ وَقِيلَ لي هذا الصَّحِيحُ",36,"ح",1,0],["ولا تغنَّت بذات الأيك صادحةٌ","إلاَّ وبدَّل دمع العين منه دما",37,"م",2,0],["ولا تَغتَنمُ الفُرصَ","ة إن أمكنَ إمكانُ",38,"ن",1,0],["ولا تغرَّنْك منها لذةٌ حسُنت","طعماً وذوقاً فإن السم في العسل",39,"ل",1,0],["ولا تغترر بالحظِّ عند وروده","فكم غادرٍ وافى يهُبُّّ رخاؤه",40,"ا",3,0],["ولا تغرك صحتك كم فتى","أصبح صحيحا ثم أمسى سقيم",41,"م",1,0],["ولا تغفل فتندم","وتأتيك العقوبات",42,"ت",1,0],["ولا تَغْترْ بالدُّنيا وحاذِرْ","فقد أودَى بِها بَشَرٌ كثيرُ",43,"ر",1,0],["ولا تَغتَرِر بأُناسٍ رضُوا","مِنَ الدِّينِ بالزور والسَّفسَفَةْ",44,"ف",2,0],["ولا تَغتَررْ بي إذا ما طربْتُ","وأصبَح كاسي مِن الرّاحِ كاسي",45,"ي",1,1],["ولا تغفلوا عن خاطر يوصى به","خلافكم الأعباء حمل ثقلها",46,"ل",3,0],["وَلا تَغُرَنَّكَ أَضغانُ مُزَمِّلِهِ","قَد يَضرِبُ الدُبرَ الدامي بِأَحلاسِ",47,"س",1,0],["ولا تغترر منهم بحسن بشاشة","فأكثر إيماض البوارق خلب",48,"ب",1,0],["وَلا تُغَيِّرُ كَونَهُ الدُهورُ","عَن أَمرِهِ المَيسورُ وَالمَعسورُ",49,"ر",1,0],["ولا تُغمِدِ السيفَ الطَّويلَ نِجادهُ","فليسَ سِواهُ مُرهَمٌ يكشفُ الضُّرَّا",50,"ر",2,0],["وَلا تَغِب عَن نعيمٍ ظَلْتَ تألفُهُ","ولا تَخِبْ عن مُنىً فيه ولا تَهِنِ",51,"ن",1,0],["ولا تغتررْ بالظّاهراتِ من الورى","فكم يَقِقٍ يتلوه أقتَرُ حالكا",52,"ك",2,0],["ولا تُغرِني بالصَّبْرِ وَالصَبرُ ما لَه","طَريقٌ إِلى ما في الحَشا والتّرائبِ",53,"ب",1,0],["ولا تغالط وكن على وجل","منه ودم به جاهلاً وغبي",54,"ب",2,0],["وَلاَ تَغْرُرْكَ أَيَّامٌ طِوَالٌ","تَعُودُ نَدَامَةً وَتَعُودُ ضَيْرَا",55,"ر",2,0],["ولا تُغْلِقَنّ بحمْل الهمو","م بابَ السّرور إِذا ما انفتح",56,"ح",1,0],["ولا تغتدي إلا ومن كل أمة","بها نُزُلٌ يهوونها وضيوف",57,"ف",1,0],["ولا تغرَّنك أثوابٌ وألسنةٌ","إِنَّ الذليلَ متى تحملْ عليه رَغا",58,"غ",2,0],["ولا تغُرَّنْك أثوابٌ على خشُبٍ","تستوجب النار معْ نشر المناشير",59,"ر",1,0],["ولا تغضبوا مما أقولُ فإنما","أَنفْتُ لكم مما تقولُ المعاشرُ",60,"ر",1,0],["ولا تغترر من حالتي غير أنني","لسنة خير الخلق ما زلتُ أتبعُ",61,"ع",1,0],["ولا تغنى حمَامُ الأيْكِ من طرب","إلاّ وأغْنَى عن المِزْمَارِ وَالوَترِ",62,"ر",1,0],["وَلا تَغتَر مِن ذَوي خلة","بِما مَوهُوا لَكَ أَو زَخرَفوا",63,"ف",3,0],["ولا تَغْتَرِرْ بِالخلِّ إِنْ لاحَ بِشْرُهُ","فإِنَّ الأَفاعي لَيِّناتُ الجوانبِ",64,"ب",1,0],["ولا تغلقوا الابواب عني لزلتي","فاني لدى الباب الكريم حقير",65,"ر",1,0],["ولا تغور إلا تحت هاجرة","إذا الشقي ارتقى في العودِ وانتصبا",66,"ب",2,0],["وَلا تُغَرِّد مُستَفزّاً أرِنَا","يَا هَؤُلَيَّا هَل نَشَدتُنَّ لَنَا",67,"ن",2,0],["ولا تغلون فالشأن من ذاك أقرب","فلست بقرع الباب بالصدق تحجب",68,"ب",1,0],["ولا تغضى على غدرٍ وأنا","نقيم على الوفاء فلا نلام",69,"م",1,0],["ولا تغشها في سائل الدم وقت ما","توهم من أقرائها لم تصرم",70,"م",1,0],["ولا تغنى بشعري الركب والتفتت","إلى شوارده آرام عسفان",71,"ن",1,0],["ولا تغضبوا للملك لكن لملّةٍ","هي اليوم شِلْوٌ قد أحاط به الأسد",72,"د",1,0],["ولا تغادر بني جيش واخوتها","بنى جميلة أهل الفضل والأدب",73,"ب",1,0],["ولا تغالط بتعطيلٍ وأقيسَةٍ","وكنْ عن الرأي والتقليد مُنفردا",74,"د",2,0],["ولا تغترر تندم ولاتك طامعاً","تذل ولا تحقر سواك تحقر",75,"ر",1,0],["ولا تغيِّر باقيَ العلومِ","في جملةِ الحساب والرسومٍ",76,"م",1,0],["وَلا تغترر بِالناس عِندَ وَداعهم","فَهُم أُمم راعوا المَودة بِالفَم",77,"م",1,0],["ولا تغازل غزلان الحمى طرباً","ولا ألثت على حصبائك المقل",78,"ل",1,0],["ولا تغنى قبيل اليوم محتشما","اليوم خل رياء الناس وابتهلا",79,"ل",2,0],["ولا تغالط فما الأحوال ملعبة","وليس قلبك هذا غير منقلب",80,"ب",1,0],["ولا تغنمن مال المصلين واستعن","بأوزارهم إن حاربوك وعدرد",81,"د",1,0],["ولا تغفلوا الطفل الفقير وتهملوا","فإن العلى أدرى بأبنائها طرا",82,"ر",2,0],["ولا تغلقوا الأبواب عني لزلتي","فما أنا جلدٌ للجفاء صبور",83,"ر",1,0],["ولا تغفلوا شأن الصغار فإنهم","لمستقبل الأيام خير رجال",84,"ل",1,0],["وَلا تَغضَب عَلَيَّ بِسوءِ فِعلي","فَحِلمُكَ ما لَهُ حَدُّ اِنتِهاءِ",85,"ا",2,0],["ولا تغمرُوا بالحزن صدري بل ارسموا","عليه بأيديكم رسومَ المَحَبّةِ",86,"ه",1,0],["ولا تغرركِ في الآفاقِ بيضٌ","تُعرضُ مثل ساطعةِ الذُّبالِ",87,"ل",1,0],["ولا تُغاثثْ بعتابي على","إغضاءِ وافٍ صالح الوُدِّ",88,"د",1,0],["وَلا تَغتَرر يَوماً بِذي الجَهل حاسِداً","اِلَيهِ عَلى مال وَقَصر مُشيد",89,"د",1,0],["وَلا تَغفَلوا عَن ذِكرِ رَب فَاِنَّهُ","هُوَ العُروَة الوُثقى اِلى الكف وَاليَدِ",89,"د",1,0],["ولا تغتر بالدنيا إذا ما","أتتك وكن على حذر وحزم",90,"م",1,0],["ولا تَغتَرِر بالأَريِ فالشَريُ دُونَهُ","وفي ضَرَبِ الحُلوَى ضُروبُ السمائِمِ",91,"م",1,0],["ولا تغتَرَّ مُنخَدِعاً بامرٍ","جرى يوماً على غير القِياسِ",92,"س",1,0],["ولا تغيّرَ عهدٌ من مودتنا","ولا يَرى عاذلٌ آثار ذلَّتِنا",93,"ن",2,0],["وَلا تَغترر بِالفَخر ما لم تهب بِهِ"