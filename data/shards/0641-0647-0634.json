{"poems":[[88,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[87,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[128,"أهكذا حتى ولا مرحبا","https://www.aldiwan.net/poem23708.html","السريع"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138144",""],[1217,"","https://poetry.dctabudhabi.ae/diwan/poem/143768","المتقارب"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126968","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138702",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22812","الخفيف"],[5183,"ثورة العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185645",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5431,"ومن ياقلب يدرَؤه!","https://www.poetsgate.com/ViewPoem.aspx?id=195436",""]],"verses":[["فَهَشَّ وَهَزَّهُ طَرَبٌ وَشَوقٌ","كَما هَشَّ الحَميمُ إِلى الحَميمِ",0,"م",1,0],["فَهَشَشتَ لي حَتّى كَأَنَّكَ عائِدي","وَأَنا الَّذي هَدَّ السَقامُ كِياني",1,"ن",2,0],["فهش للماضي وقد طالما","بذلك الماضي لقد شببا",2,"ب",2,0],["فهشت له خجلى قد احمر وجهها","ولاحت عليها نضرة ونعيم",3,"م",1,0],["فهش ولكن لمردانه","وقام ولكن على أربع",4,"ع",1,0],["فه شمل الكفر قد عاد نظيم","وبشمل الدين قد صيح بداد",5,"د",1,0],["فهشم الإسنان والوجه وقد","سالت دماه منهما فخضبا",6,"ب",2,0],["فهش لها زفسٌ وقال بمنتدى","بني الخلد لو رأيي ارتأيت مؤبدا",7,"د",2,0],["فهشت ولكن عن جبين مقطبٍ","على سود أجفانٍ بحمر الحمالق",7,"ق",1,0],["فَهِشامٌ مِن وائِلٍ في مَكانٍ","أَنتَ تَرضى بِدونِ ذاكَ المَكانِ",8,"ن",1,0],["فهششت له ونهضت به","وأتيت الظلم تبدِّده",9,"د",2,0],["فهشت إليه قلوب صغت","سقتها المحبة كأس اللمى",10,"م",2,0],["فهش للأمر عبد الله مغتبطا","وقال رملة ما أحلى لياليها",11,"ي",3,0],["فهش للأمر عبد الله واعتنق الح","سين والعين تذري من مآقيها",11,"ي",3,0],["فهشت أفق نجمتها","لُيلقى حيثُ منشؤه",12,"ا",2,0]]}