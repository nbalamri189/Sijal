{"poems":[[66,"طاف وفي راحته كأس راح","https://www.aldiwan.net/poem39642.html","السريع"],[74,"ألا ثل من عرش الشباب وثلما","https://www.aldiwan.net/poem13251.html","الطويل"],[33,"يا صاحبي اللذين اليوم قد أخذا","https://www.aldiwan.net/poem25761.html","البسيط"],[105,"هو الركب غاديه سلام ورائحه","https://www.aldiwan.net/poem42097.html","الطويل"],[46,"تعالى رازق الأحياء طرا","https://www.aldiwan.net/poem22002.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39560","المنسرح"],[183,"هلال في قضيب في كثيب","https://www.aldiwan.net/poem14117.html","الوافر"],[183,"عسى يبلى العذول ببعض ما بي","https://www.aldiwan.net/poem14126.html","الوافر"],[184,"ما أحسن البر بلا شيلم","https://www.aldiwan.net/poem43266.html","السريع"],[187,"حياك يا طيبة حياك","https://www.aldiwan.net/poem35152.html","السريع"],[207,"خطرت تسحب أذيال الرسم","https://www.aldiwan.net/poem26481.html","عموديه"],[220,"فعال البر لا تخفى ولكن","https://www.aldiwan.net/poem55404.html","الوافر"],[221,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[227,"اشرب على ورد الخدو","https://www.aldiwan.net/poem51124.html","مجزوء الكامل"],[233,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[235,"أبناء فاس من يفارقهم","https://www.aldiwan.net/poem19524.html","السريع"],[351,"بادر إلى روضة الآداب مجتنيا","https://www.aldiwan.net/poem39761.html","البسيط"],[351,"هيجت أشجان صب للربوع هفا","https://www.aldiwan.net/poem40141.html","البسيط"],[363,"فاتنا بدر وأحد","https://www.aldiwan.net/poem44375.html","مجزوء الرمل"],[388,"يارب أعنا يامعين","https://www.aldiwan.net/poem54468.html","عموديه"],[388,"ذه عرشه مامثلها عرشه","https://www.aldiwan.net/poem54470.html","عموديه"],[400,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[413,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[450,"قل وحث المدام في إبانه","https://www.aldiwan.net/poem13936.html","الخفيف"],[459,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[462,"أتهويماً وليل الهم داجي","https://www.aldiwan.net/poem3585.html","عموديه"],[475,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[475,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[498,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[556,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[562,"لك الفضل يا من بالمحب تلطفا","https://www.aldiwan.net/poem905.html",""],[573,"عليك سلام الله قبل سلامي","https://www.aldiwan.net/poem3007.html","الطويل"]],"verses":[["وَأَرشَقَ وَأَمشَقَ فَما أَعشَقَ","قَلبي لَهُ في جِدِّهِ وَالمُزاح",0,"ح",1,0],["وَأَرشُفُ نَثرَ الطَلِّ مِن كُلِّ وَردَةٍ","مَكانَ بَياضِ الثَغرِ مِن حُوَّةِ اللَمى",1,"م",2,0],["وَأَرشِداها إِلى خَضراءَ مُعشِبَةٍ","يَوماً وَإِن طَلَبَت إِلفاً فَدُلّاها",2,"ا",3,0],["وأَرشدتَهُ تَبغِي له الجِدَّ خُطَّةً","فأمسكَ غاويهِ وأقصرَ مازِحُهْ",3,"ح",2,0],["وَأَرشَدُ مِنكَ أَجرَبُ تَحتَ عِبءٍ","تَهُبُّ عَلَيهِ ريحٌ جِربِياءُ",4,"ي",3,0],["وأرشفُ القطْرَ من بواكرِهِ","فلا أرودُ الضفافَ ظمآنا",5,"ن",2,0],["وأرشُفُ منه ثَغْرا كالأَقاحِي","وأَلزَم منه قَدّا كالقَضيب",6,"ب",1,0],["وَأرشُفُ سُؤْرَ حَظِّى من شبابٍ","يَجِلُّ عن التَّعوُّضِ والإياب",7,"ب",1,0],["وار شوقي في الأسى كامن","وحرّها من بين ذا العالم",8,"م",1,0],["وَأرشدَ الخلقَ إلى ربّهم","بخُلقٍ عبّاسٍ وضحّاكِ",9,"ك",1,0],["وارشدوا قد ضللنا رشدنا","ووأدنا مجدنا بين الأمم",10,"م",1,0],["وأرشد أحمد الرخصي لمّا","بنى لله مسجده وشاده",11,"د",2,0],["وَاِرشِفي مِرشَفي","وَاِهتُفي نَحنُ في",12,"ي",1,0],["وارشُف ثنايا نظْمُها","أزرى على نظم العُقُود",13,"د",1,0],["وَاِرشَف رُضابَ الثَنايا","ما أَمكَنَتكَ الثُغورُ",14,"ر",1,0],["وَأُرْشِدَ السَّاهِي خِيفَةَ أَنْ","تَطْرُقَهُ يَوْماً طَوَارِقُهُمْ",15,"م",1,0],["وَاِرشف كُوؤس طلا آدابها طَرَباً","فَمجمع الأنس في رَوض السُكر دانِ",16,"ن",1,0],["وَاِرشف كُؤوس سُرورٍ راق منهلهُ","فَيا لَهُ منهلاً عَذباً وَمرتشفا",17,"ف",2,0],["وارشُقوا للقوم رشقاً","بسهامٍ فارسيَّه",18,"ي",2,0],["وارشد وسدد يا كريم","وكن لنا في كل حين",19,"ن",1,0],["وأرشدهم للخير وفقهم","واغمرهم بالفضل والإحسان",20,"ن",1,0],["وإرشاد لنقاد كرام","وإيصال إلى سبل السلام",21,"م",1,0],["وأرشفني لماه العذب ألمى","مراشفه شفاء للسقيم",22,"م",1,0],["وأَرْشُفُ من حَصْباءِ دُرٍّ وجوهَرٍ","رحيقَ مُدَامٍ سُكْرُهُ بِيَ دائِمُ",23,"م",1,0],["وارشفِ الراحَ صِرْفَةً واستلمها","من رشاً يستبيك صبغ بنانِه",24,"ن",2,0],["وأرشف رشَّاح الأداوي ظماءةً","فأرجع موهون الأباء صاديا",25,"ي",2,0],["وأرشفها ثغوراً من أقاحٍ","صوامتَ وهيَ مفصحةُ التناجي",26,"ج",2,0],["وأرشفَ ظَلماًُ مِن مُجاجِكِ بارداً","تفوقُ ثناياهُ على نا صعِ الدُّرَّ",27,"ر",1,0],["وأرشفُ ظلمَ الثغرِ عذباً مُجاجُه","بنفسيَ أفدي ذلكَ الظلمَ والثغرا",28,"ر",2,0],["وارْشُقْنَ بالوعدِ قلبي","من تَجَنِّيكَ سِهَامَا",29,"م",2,0],["واِرشف هنيّاً أيَّ شهدِ مسرّةٍ","شيمٌ تغصُّ بها العُداةُ وتشرقُ",30,"ق",1,0],["وإرشاد لنحو طريق سوء","وإذن في المعاصي للمداني",31,"ي",1,0],["وأرشدته لما غدا متحيرا","فلا زلت في كل الأمور مظفرا",32,"ا",1,0],["وأَرْشَدْتَني بَعْدَ انْسِدَادِ مَذَاهِبي","وأَرْويتَني من بَعْدِ طُولِ أُوَامِي",33,"م",2,0]]}