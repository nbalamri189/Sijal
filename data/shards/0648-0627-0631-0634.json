36799","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135867","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135247","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29303","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40141","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44681","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127241","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127211","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127304","الطويل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123465","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73265","الطويل"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83491","الوافر"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198187","الطويل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139527",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52158","الطويل"],[4853,"سرى ناشداً أنسي قضيب من الآس","https://www.poetsgate.com/ViewPoem.aspx?id=181771",""],[4888,"متشاعرون","https://www.poetsgate.com/ViewPoem.aspx?id=207680",""],[4119,"وأرشف خمره والكأس ثغر","https://www.poetsgate.com/ViewPoem.aspx?id=16119",""],[5106,"أَشرِعَة الجَمَال ..","https://www.poetsgate.com/ViewPoem.aspx?id=151426",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5408,"أدر كأسا","https://www.poetsgate.com/ViewPoem.aspx?id=190870",""],[2079,"إلى كم أداري والحبيب نفور","https://www.poetsgate.com/ViewPoem.aspx?id=123849",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[5497,"معسولة اللمى","https://www.poetsgate.com/ViewPoem.aspx?id=208977",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[5781,"طَعْمُ قبُلاتٍ تراوِحُ مجرى الشِّفاه","https://www.poetsgate.com/ViewPoem.aspx?id=202859",""],[5956,"ألفُ شكر","https://www.poetsgate.com/ViewPoem.aspx?id=182374",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""],[6229,"تفاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82506&r=&rc=41",""]],"verses":[["وَأَرشَقَ وَأَمشَقَ فَما أَعشَقَ","قَلبي لَهُ في جِدِّهِ وَالمُزاح",0,"ح",1,0],["وَأَرشُفُ نَثرَ الطَلِّ مِن كُلِّ وَردَةٍ","مَكانَ بَياضِ الثَغرِ مِن حُوَّةِ اللَمى",1,"م",2,0],["وَأَرشِداها إِلى خَضراءَ مُعشِبَةٍ","يَوماً وَإِن طَلَبَت إِلفاً فَدُلّاها",2,"ا",3,0],["وأَرشدتَهُ تَبغِي له الجِدَّ خُطَّةً","فأمسكَ غاويهِ وأقصرَ مازِحُهْ",3,"ح",2,0],["وَأَرشَدُ مِنكَ أَجرَبُ تَحتَ عِبءٍ","تَهُبُّ عَلَيهِ ريحٌ جِربِياءُ",4,"ي",3,0],["وأرشفُ القطْرَ من بواكرِهِ","فلا أرودُ الضفافَ ظمآنا",5,"ن",2,0],["وأرشف الكأس من عطر ومن غيد","فأسكر المترفين العطر والغيدا",6,"د",2,0],["وأرشُفُ منه ثَغْرا كالأَقاحِي","وأَلزَم منه قَدّا كالقَضيب",7,"ب",1,0],["وَأرشُفُ سُؤْرَ حَظِّى من شبابٍ","يَجِلُّ عن التَّعوُّضِ والإياب",8,"ب",1,0],["وار شوقي في الأسى كامن","وحرّها من بين ذا العالم",9,"م",1,0],["وَأرشدَ الخلقَ إلى ربّهم","بخُلقٍ عبّاسٍ وضحّاكِ",10,"ك",1,0],["وارشدوا قد ضللنا رشدنا","ووأدنا مجدنا بين الأمم",11,"م",1,0],["وأرشد أحمد الرخصي لمّا","بنى لله مسجده وشاده",12,"د",2,0],["وَاِرشِفي مِرشَفي","وَاِهتُفي نَحنُ في",13,"ي",1,0],["وارشُف ثنايا نظْمُها","أزرى على نظم العُقُود",14,"د",1,0],["وَاِرشَف رُضابَ الثَنايا","ما أَمكَنَتكَ الثُغورُ",15,"ر",1,0],["وَأُرْشِدَ السَّاهِي خِيفَةَ أَنْ","تَطْرُقَهُ يَوْماً طَوَارِقُهُمْ",16,"م",1,0],["وَاِرشف كُوؤس طلا آدابها طَرَباً","فَمجمع الأنس في رَوض السُكر دانِ",17,"ن",1,0],["وَاِرشف كُؤوس سُرورٍ راق منهلهُ","فَيا لَهُ منهلاً عَذباً وَمرتشفا",18,"ف",2,0],["وارشُقوا للقوم رشقاً","بسهامٍ فارسيَّه",19,"ي",2,0],["وارشد وسدد يا كريم","وكن لنا في كل حين",20,"ن",1,0],["وأرشدهم للخير وفقهم","واغمرهم بالفضل والإحسان",21,"ن",1,0],["وإرشاد لنقاد كرام","وإيصال إلى سبل السلام",22,"م",1,0],["وأرشفني لماه العذب ألمى","مراشفه شفاء للسقيم",23,"م",1,0],["وأَرْشُفُ من حَصْباءِ دُرٍّ وجوهَرٍ","رحيقَ مُدَامٍ سُكْرُهُ بِيَ دائِمُ",24,"م",1,0],["وارشفِ الراحَ صِرْفَةً واستلمها","من رشاً يستبيك صبغ بنانِه",25,"ن",2,0],["وأرشف رشَّاح الأداوي ظماءةً","فأرجع موهون الأباء صاديا",26,"ي",2,0],["وأرشفها ثغوراً من أقاحٍ","صوامتَ وهيَ مفصحةُ التناجي",27,"ج",2,0],["وأرشفَ ظَلماًُ مِن مُجاجِكِ بارداً","تفوقُ ثناياهُ على نا صعِ الدُّرَّ",28,"ر",1,0],["وأرشفُ ظلمَ الثغرِ عذباً مُجاجُه","بنفسيَ أفدي ذلكَ الظلمَ والثغرا",29,"ر",2,0],["وارْشُقْنَ بالوعدِ قلبي","من تَجَنِّيكَ سِهَامَا",30,"م",2,0],["واِرشف هنيّاً أيَّ شهدِ مسرّةٍ","شيمٌ تغصُّ بها العُداةُ وتشرقُ",31,"ق",1,0],["وإرشاد لنحو طريق سوء","وإذن في المعاصي للمداني",32,"ن",2,0],["وأرشدته لما غدا متحيرا","فلا زلت في كل الأمور مظفرا",33,"ا",1,0],["وأَرْشَدْتَني بَعْدَ انْسِدَادِ مَذَاهِبي","وأَرْويتَني من بَعْدِ طُولِ أُوَامِي",34,"م",2,0],["وأرشُف من فيها رُضاباً كأنّه","مُعتّقه راحٌ بماءٍ تُشَعْشَعُ",35,"ع",1,0],["وأرشفُ في الحياة أَلذَّ كأسٍ","متى استوفيتَ حظكَ من هناكا",36,"ك",2,0],["وارشُفِ اللُّطف من أَبيك زُلالاً","وارعَ منهُ مرعى الحنانِ خصيبا",37,"ب",2,0],["وارشنبلود يعلل أيضا","بقول أراه يشابه ذا",38,"ذ",2,0],["وأرشفُ مِن فيه الزُّلال مُصفّقاً","بصهباءَ تستهوي الأعفَّ المُصمِّما",39,"م",2,0],["وَأَرشُفُ خَمراً مِن لَماها وقَرقَفاً","فَأَشرَبُ شَهداً كانَ حِلّاً لِشارِبِ",40,"ب",1,0],["وارشدْ وجاورْ بحارَ العلم تحظَ به","من جاورَ البحرَ أغنتْه فوائده",41,"د",2,0],["وَأرْشُفُ كَأسَ مبسمكَ المُفَدَّى","وَأقطِفُ وَرْدَ تِلْكَ الْوَجْنَتَيْنِ",42,"ن",1,0],["وأرشف من كؤوس الفوز راحا","ببرد روحها حر الأواري",43,"ر",2,0],["وأرشدنا بالمصطفى بعد ضلّة","ولولاه ما نال الرشاد ميمم",44,"م",1,0],["وأَرْشدُونَا سُبُلَ الصوابِ","وعَلَّمُونا عِلْمَ ذا الكتَابِ",45,"ب",1,0],["وَاِرشُف ثُغورَ الأَقاحي وَهيَ ضاحِكَةٌ","تَفتَرُّ عَن لُؤلُؤٍ رَطبٍ وَعَن بَرَدِ",46,"د",1,0],["وارشدنا للصالحات وقادنا","لنهج المراضي والرضا بتفقه",47,"ه",1,0],["وارشف كما شاءَ الهوى ريقةً","كانت تمنّيك بسلسالِها",48,"ل",3,0],["وأُرشد بامتداحك كل خاطٍ","توغل في المآثم والشرور",49,"ر",1,0],["وأرشد الناس للدين القويم أتي","بذي حديث صحيح جاء في الخبر",50,"ر",1,0],["وارشت من عينيك اقتل اسهم","فتركت قلبي مثخناً بجراح",51,"ح",1,0],["وأرشدتمونا فنلنا المنى","وهذبتمونا فحقَّ الثَّناء",52,"ا",2,0],["وأرش جراح الأذن كالجرح في القفا","تأوله في حكمه المتأول",53,"ل",1,0],["وَأَرشَدَكُم فِعلُ الجَميلِ إِلى الهُدى","أَلا إِنَّما فِعلُ الجَميلِ هُوَ الرُشدُ",54,"د",1,0],["وارشد بنا ما دام رشدا باقيا","في عزة ونباتة ابن منيع",55,"ع",1,0],["وأرشفنا الهنا كأس التصابي","بحان ربى معاهده الزهيه",56,"ي",2,0],["وأَرْشَقَني عن قَوْس ضِغْن وإِحْنَةٍ","كَسَتْ جَسَدي تحت الدِّلاص نِبالا",57,"ل",2,0],["وارشفُ من رُضابٍ","واطربُ من مقال",58,"ل",1,0],["وارشد رهطه للظلم جهلاً","وانهلهم كما راموا عُقاره",59,"ر",2,0],["وأرشد أمة في الجهل حيرى","وهل كالجهل من داء عقام",60,"م",1,0],["وأرشدتَ النديم إلى مكان","رآه بعد حيرته مكينا",61,"ن",2,0],["وأرشفني عصيرةَ وجنتيه","فَدَبَّت بين جلدي والعظام",62,"م",1,0],["وارشف من فيكِ الحياة وإنني","تطيلُ حياتي هذه الرشفات",63,"ت",1,0],["وأرشفنا على ظمأ زلالا","ألذ من المدامة للنديم",64,"م",1,0],["وارشف من الاسعاد صابا مترعا","ما عاد عيد بالصفاء موطدا",65,"د",2,0],["وارشدوا العقل في دياجي التمادي","وادركوا النفس من ضلال مبين",66,"ن",1,0],["وارشدونا إلى صراط سوي","نبلغ المجد ثابت الاعراق",67,"ق",1,0],["وارشفها من شفتي ساق","ما أحلى فاه واللعسا",68,"س",2,0],["وارشف بكاس الثغر منه سلافة","صرفاً وحسبك باللمى أن تمزجا",69,"ج",2,0],["وارشف عذباً من ثناياه بارداً","هو الخمر لو تمززتها صرفا",70,"ف",2,0],["وأرشف من ثغرهِ خمرةً","مدى العمر تمنع أن أَعطشا",71,"ش",2,0],["وأرشف المراح من ثنايا","لعذبها ينسب الزلال",72,"ل",1,0],["وَأَرشَدوا الناسَ إِلى الرَشاد","حَتّى اِهتَدى مَن لَم يَكُن بِهادِ",73,"د",1,0],["وارشف حميا ثغر باسم شنيب","واشهد سني بارق ثناياه",74,"ا",2,0],["وأرشدني إِلى السكر","إِذا ما شئت أَن أَسكر",75,"ر",1,0],["وأرشفني بكأس لماه راحا","مترجمة عن الخمر الحلال",76,"ل",1,0],["وارشفني سلاف الرّا","ح فهي الجلّ من قصدي",77,"د",2,0],["وارشُقوها لا تُشفِقُنَّ عليها","بسِهامٍ تُصِيبها في المقاتل",78,"ل",1,0],["وأرشِد الضالَ وأفرغ في هدايته","كِنانةَ الجُهد وأنسهُ إذا نَفَرا",79,"ر",2,0],["وأرشف رضابيَ راحا","وضمّ قديَ غصنا",80,"ن",2,0],["وَأَرشُفُ بِالأَلحاظِ خَمرَةَ ريقِهِ","فَإِنّي فَتىً آلَيت لا ذُقتُ إِسفَنطا",81,"ط",2,0],["وارشُدْ بنا برا الرشيدِ للهُدى","إلى طريقِ الحقِّ واحفظ مِن ردى",82,"د",2,0],["وأرشدَنِّي وعافني واحفظَنِّي","يا حفيظٌ ويا وليُّ رشيدُ",83,"د",1,0],["وَأَرشِديني إِلى الضِياءِ وَإِلّا","فَاِترُكيني أَهوي إِلى ظُلماتي",84,"ي",1,0],["وَأَرشفَتنا بكَ ثَغرَ نِعمَةٍ","لا نَسأَلُ اللَّه سِوى دَوامِها",85,"م",3,0],["وَأَرشدَنا إِلى اِستقلالِ فكرٍ","وَحُريةْ بِها في الدَهرِ نَعلو",86,"ل",2,0],["وأرشفني الرضاب فقلت خمر","سمت عن ان يكون لها قدام",87,"م",1,0],["وأرشف ورد اللمى","واقطف ورد الخجل",88,"ل",1,0],["وأرشف من أقداح رائق لفظه","السلافة حتى يفضح المسك رياه",89,"ا",2,0],["وأرشدَ الكلَّ للاصلاح فانتُدبت","معالمٌ كان عنها الغربُ مغتربا",90,"ب",2,0],["وأرشد الخلقَ برُسلٍ بعدَهُ","هدوا إلى سبيلهِ كما هدى",91,"ا",1,0],["وَأَرشفُ في مِثلِ العَقيقِ سلافةً","وأَلثُمُ شبهَ الأُقحوانِ مُنَوَّرا",92,"ر",2,0],["وأرشد الأمراءَ القائمين بها","أهل المكارم أهل المجد والحسب",93,"ب",1,0],["وأرشدت كل ذي أمر لمعدلةٍ","من غير ما جنف فيها ولا جنب",93,"ب",1,0],["وَأرشدني إلى ما فيه فوزي","وَفَوز سَفينَتي ذات الشِراعِ",94,"ع",1,0],["وَأَرْشَفَنا مِن خَمْرَةِ الأُنْسِ أكْؤساً","وَطابَ لَنا في قَصْرِ ((زائِدَ)) مُوْرِدَا",95,"د",2,0],["وارشق سهام صواب في الكلام ولا","تعبأ بفدم جهول بالغرور بلي",96,"ل",2,0],["وأرشدني نهجَ الطريق وخصَّني","بنصح همام ثاقب الرأى صائب",97,"ب",1,0],["وأرشِدْ إلى نهج الهُدى من يضلُّ عن","طريقِ الهُدى مولايَ إِنَّك راشدُ",98,"د",1,0],["وأرشدني وهناً لتقبيل خاله","وميض ثناياه وشعلة أنفاسي",99,"س",2,0],["وأرشُّ من وهج المعاني دُرَّها","كم كنتُ للشّعر البهي مُريدا",100,"د",2,0],["وأرشف خمره والكأس ثغر","وأقطب ورده والغصن قد",101,"د",1,1],["وَأرشفُ من حَنِينِ الصُّبحِ إشرَاقَاً زُلالْ","وَأَعقِدُ مِنْ طُلُولِ الرَّنْدِ عِقْدَاً للجَمَالْ",102,"ل",1,0],["وَارشُد أيَا مَن قد هَوِيتَ سُجُونَهُم","هَلَّا أَفَاقَ العَقلُ كَى تتفكَّرا",103,"ر",2,0],["وإرشاد أهل الأرض بعد ضلالهم","إلى كل ما يدني إلى جنة الخلد",104,"د",1,0],["وأرشده أن يسأل الله وحده","ويفرده سبحان ذي العرش والمجد",105,"د",1,0],["وأرشفني الحنين كوى عروقي","وغاب بأضلعي سهما عتيّا",106,"ي",2,0],["وأرشفني من ريقه العذب نهلة","أهاجت ظما قلبي فزاد زفير",107,"ر",1,0],["وأرشدهم ففاقوا الخلق طرا","هدي وتقي وعلما واستقامة",108,"م",2,0],["وأرشف نبع الوّد من نهدِ صدرها","فلمْ أصطبرْ إلا إلى ورِده الظما",109,"م",2,0],["وأرشف من يد المحبوب كأساً","رحيفاً ختمها ريقٌ مبرد",110,"د",1,0],["وَأرْشُقُ جَفْنَيْهِ بِعِطْري، فَمُهْجَتي","بِسَيْفٍ جَسورٍ لا تُرَدُّ سِهامُها",111,"م",3,0],["‏وأرشدْ خطوها نحو المعالي","‏ ‏ وساعدني أصون لها الجباها",112,"ا",3,0],["وَ ارْشُفْ رِضَابًا مِنْ سُلَافِ تَلَهُّفِي","مَا أَصْعَبَنَّ الرَّشْفَ مِنْهُ وَ أَسْهَلَكْ",113,"ك",1,0],["وارشد أهل الحب من عشق العلى","فرقته منها ذروه العز والمجد",114,"د",1,0],["وارْشِفْهما بالفمِ رَشْفاً فكم","ضَيّقَ أنفاسيَ ما زرّراه",115,"ا",2,0]]}