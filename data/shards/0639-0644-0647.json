{"poems":[[53,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[86,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[93,"القلوب والمقل","https://www.aldiwan.net/poem9152.html","المقتضب"],[88,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[91,"إن تر زهرة ورد فوقها للطل قطره","https://www.aldiwan.net/poem8876.html","عموديه"],[85,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[115,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[115,"نقشت في جبينها والمحيا","https://www.aldiwan.net/poem41658.html","الخفيف"],[132,"كلف العيس بالسرى فذراها","https://www.aldiwan.net/poem54692.html","الخفيف"],[155,"يا صروف الدهر حسبي","https://www.aldiwan.net/poem55755.html","مجزوء الرمل"],[223,"إنزعوا مني قلبي","https://www.aldiwan.net/poem41878.html","مجزوء الرمل"],[254,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[256,"يا سيدي عشت في نعيم","https://www.aldiwan.net/poem48420.html","مخلع البسيط"],[290,"أطلقوا المدفع المبشر بالعيد","https://www.aldiwan.net/poem11663.html","الخفيف"],[297,"ما على حاديهم لو كان عاجا","https://www.aldiwan.net/poem33310.html","الرمل"],[300,"ألم ترم الأطلال من حول جعشم","https://www.aldiwan.net/poem45455.html","الطويل"],[320,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[328,"هتف الليل فلب الهاتفا","https://www.aldiwan.net/poem55046.html","الرمل"],[328,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[377,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[453,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[479,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[500,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[505,"فلسفة","https://www.aldiwan.net/poem27794.html","الخفيف"],[505,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[562,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"]],"verses":[["عِلَّةُ مِثلي السَيفُ لا مُمرِضَةٌ","أَضُجُّ مِنها كَضَجيجِ الأَدبَرِ",0,"ر",1,0],["عَلَّها دَمعَةُ الوَداعِ لِذاكَ ال","مُلكِ أَو ذِكرَةٌ لِتِلكَ العُهودِ",1,"د",1,0],["علة لما فعلا","لو تعاقب العلل",2,"ل",1,0],["علّه قد درى بذاك فهذا","هو باك ودمعه سفّاح",3,"ح",1,0],["عَلِهَت تَرَدَّدُ في نِهاءِ صَعائِدٍ","سَبعاً تُؤاماً كامِلاً أَيّامُها",4,"م",3,0],["عَلَّها تَحيا قَليلاً في الفَضاءِ الحُرِّ حُرَّه","ذَرَفَتها مُقلَةُ الظَلماءِ عِندَ الفَجرِ قَطرَه",5,"ر",2,0],["عِلَّةٌ لَم تَصِل فِراشَكَ حَتّى","وَطِئَت في القُلوبِ وَالأَكبادِ",6,"د",1,0],["عَلَّ هَذا الأَميرَ أَسعَدَهُ اللَ","هُ بِطولِ البَقاءِ يَرضى أَميرُه",7,"ر",2,0],["علَّة لَو أَفَقت مِنها لِسَعدي","كُنتَ مِثلَ النُظار أَصفاهُ سَبكُ",8,"ك",1,0],["علة ذرات الورى حلها","فبثراها يبرأ الارمد",9,"د",1,0],["علة للغرام والوجد جاءت","فرقت في البها مكناً عليا",10,"ي",2,0],["عَلَّهَا بَعدَ أن تَرَامَت أسَابِي","عَ وَأَلقَت عَنِ العِظَامِ نَقَاهَا",11,"ا",3,0],["عِلَّةٌ عَمَّتْ وخَصَّتْ","في حَبيبٍ ومُحِبِّ",12,"ب",1,0],["عَلَّه إِن يَستَفِق من سَكرَتِه","يَهجُر الأَيّام",13,"م",1,0],["عَلَّهُ يوماً يعاني","قَسْوَةً إذْ يستجيبُ",14,"ب",1,0],["علة سوءٍ كانت تريني","نفسي فوق الفراش حسره",15,"ر",2,0],["علها ذكريات شجو قديم","ليس يألو حرصا عليها الضمير",16,"ر",1,0],["عَلَّها تُبرئ وَجداً كامِناً","كلَّما عالجتهُ زاد اِعتِلاجا",17,"ج",2,0],["عَلِهنَ فَما نَرجو حَنيناً لِحِرَّةٍ","هِجانٍ وَلا نَبني خِباءً لِأَيمِ",18,"م",1,0],["عَلَّهُ أَحمَدَ خَيري","كانَ مَولايَ نَصيرُهُ",19,"ر",2,0],["علّه يحنو فيرضى بالتلاقي","لتذيب العمر في كأس الوئام",20,"م",1,0],["عله يكتوى بسفع لظاها","فهو سر لشقوتي واكتئابي",21,"ب",2,0],["علَّةُ الكائنات قَبلاً وبَعداً","وإليه الثوابُ ثم العقاب",22,"ب",1,0],["علهم يغدون إخوا","نا ويفني الشرّ خير",23,"ر",1,0],["علها تشفي غلّتي","أو تراعيك في الثوا",24,"ث",3,0],["عِلَّةٌ وا لَوعَتي مُزْمِنَةٌ","وبها حارَ الطَّبيبُ الحاذقُ",25,"ق",1,0],["علّهم ما زالوا يهابون ليلاً","ينجلِي فيهِ الطارئُ المُسْتجِدُّ",26,"د",1,0],["علّها تركعُ من أبتْ ذُلّنا","أو تلين كجارٍ لها حَمُقا",27,"ق",2,0],["عِلّةُ الموتِ لا تُداوى ولا تَح","مِي الرُّقَى منهُ والقنا والحُصونُ",28,"ن",1,0]]}