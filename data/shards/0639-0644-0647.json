/www.poetsgate.com/ViewPoem.aspx?id=34690",""],[5525,"دار الشواق","https://www.poetsgate.com/ViewPoem.aspx?id=920",""],[5528,"لوعة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=201198",""],[5691,"جوهر الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=206131",""],[5887,"عانق الشوق فؤادي إذ ذكرت اليوم أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=35285",""],[5901,"العقود الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=204927",""],[6019,"إنطفاءة قنديل ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53041",""],[5309,"ما علينا بعد توديع المنى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573858",""],[2220,"بأثيلاتِ النَّقا سربُ قطا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19287&r=&rc=829",""]],"verses":[["عِلَّةُ مِثلي السَيفُ لا مُمرِضَةٌ","أَضُجُّ مِنها كَضَجيجِ الأَدبَرِ",0,"ر",1,0],["عَلَّها دَمعَةُ الوَداعِ لِذاكَ ال","مُلكِ أَو ذِكرَةٌ لِتِلكَ العُهودِ",1,"د",1,0],["علة لما فعلا","لو تعاقب العلل",2,"ل",1,0],["علّه قد درى بذاك فهذا","هو باك ودمعه سفّاح",3,"ح",1,0],["عَلِهَت تَرَدَّدُ في نِهاءِ صَعائِدٍ","سَبعاً تُؤاماً كامِلاً أَيّامُها",4,"م",3,0],["عَلَّها تَحيا قَليلاً في الفَضاءِ الحُرِّ حُرَّه","ذَرَفَتها مُقلَةُ الظَلماءِ عِندَ الفَجرِ قَطرَه",5,"ر",2,0],["عِلَّةٌ لَم تَصِل فِراشَكَ حَتّى","وَطِئَت في القُلوبِ وَالأَكبادِ",6,"د",1,0],["عَلَّ هَذا الأَميرَ أَسعَدَهُ اللَ","هُ بِطولِ البَقاءِ يَرضى أَميرُه",7,"ر",2,0],["علَّة لَو أَفَقت مِنها لِسَعدي","كُنتَ مِثلَ النُظار أَصفاهُ سَبكُ",8,"ك",1,0],["علة ذرات الورى حلها","فبثراها يبرأ الارمد",9,"د",1,0],["علة للغرام والوجد جاءت","فرقت في البها مكناً عليا",10,"ي",2,0],["عَلَّهَا بَعدَ أن تَرَامَت أسَابِي","عَ وَأَلقَت عَنِ العِظَامِ نَقَاهَا",11,"ا",3,0],["عِلَّةٌ عَمَّتْ وخَصَّتْ","في حَبيبٍ ومُحِبِّ",12,"ب",1,0],["عَلَّه إِن يَستَفِق من سَكرَتِه","يَهجُر الأَيّام",13,"م",1,0],["عَلَّهُ يوماً يعاني","قَسْوَةً إذْ يستجيبُ",14,"ب",1,0],["علة سوءٍ كانت تريني","نفسي فوق الفراش حسره",15,"ر",2,0],["علها ذكريات شجو قديم","ليس يألو حرصا عليها الضمير",16,"ر",1,0],["عَلَّها تُبرئ وَجداً كامِناً","كلَّما عالجتهُ زاد اِعتِلاجا",17,"ج",2,0],["عَلِهنَ فَما نَرجو حَنيناً لِحِرَّةٍ","هِجانٍ وَلا نَبني خِباءً لِأَيمِ",18,"م",1,0],["عَلَّهُ أَحمَدَ خَيري","كانَ مَولايَ نَصيرُهُ",19,"ر",2,0],["علّه يحنو فيرضى بالتلاقي","لتذيب العمر في كأس الوئام",20,"م",1,0],["عله يكتوى بسفع لظاها","فهو سر لشقوتي واكتئابي",21,"ب",2,0],["علَّةُ الكائنات قَبلاً وبَعداً","وإليه الثوابُ ثم العقاب",22,"ب",1,0],["علهم يغدون إخوا","نا ويفني الشرّ خير",23,"ر",1,0],["علها تشفي غلّتي","أو تراعيك في الثوا",24,"ث",3,0],["عِلَّةٌ وا لَوعَتي مُزْمِنَةٌ","وبها حارَ الطَّبيبُ الحاذقُ",25,"ق",1,0],["علّهم ما زالوا يهابون ليلاً","ينجلِي فيهِ الطارئُ المُسْتجِدُّ",26,"د",1,0],["علّها تركعُ من أبتْ ذُلّنا","أو تلين كجارٍ لها حَمُقا",27,"ق",2,0],["عِلّةُ الموتِ لا تُداوى ولا تَح","مِي الرُّقَى منهُ والقنا والحُصونُ",28,"ن",1,0],["علّةٌ زَعْفَرَتْ مُعصفر خدٍّ","كان من رِّيه يكاد يفيض",29,"ض",1,1],["علةٌ أوليةٌ غلبت في","ها على رأي آدم حواء",30,"ا",2,0],["علَّةٌ أوَّليَّةٌ ليس تلقى","غيرَ لَثمِ الشفاهِ منهُ شفاءَ",31,"ا",2,0],["عَلَّها يا نَديم تبرِئُ قَلباً","ذابَ لَما رشقتَه بِنبال",32,"ل",1,0],["عَلَّه بِالوِصال يَسمَحُ يَوماً","لِعزيز أَذلَّه طُولُ بعد",33,"د",1,0],["علة المال أرخصت كل غال","وأشاعته بعد عز مناله",34,"ل",2,0],["عَلَّهُ من لَمّة الجَهْ","ل بتَوفيقٍ يُفيقُ",35,"ق",1,0],["علها تنحطُّ من عُنقي","في غدٍ أُصْرٌ وأوزار",36,"ر",1,0],["علة الكون روح جسم المعالي","نقطة البدء سر معنى المعاد",37,"د",1,0],["علة الزمت ثمانين عاماً","أورثت مهجتي ضناً وسقاما",38,"م",2,1],["علة الكون ولولاه لما","كان للعالم عين وأثر",39,"ر",1,1],["علة الإيجاد للعالم أبناء الرسول","قادةٌ للعلم والتقوى فروعاً وأصول",40,"ل",1,0],["علّها الطَّلُّ ورقرَقها","بَردُ أنفاس الصَّبا سَحَرَا",41,"ر",2,0],["علّه يكشفُ سرَّ الكائناتْ","ويرى فيها شفيعاً في الفضاءْ",42,"ا",2,0],["عِلَّةَ البَدرِ راقِبي اللَهَ فيهِ","لا تَضُرّي بِجِسمِهِ وَدَعيهِ",43,"ي",2,1],["عله مطفىء بقلبك نارا","هاجها حبك افتتاح البلاد",44,"د",1,0],["علّةٌ أحجمَ عنها","كلّ عرّافٍ حكيم",45,"م",1,0],["علها تنمحي براحة بشر","بعدها تكتب المسرة صحا",46,"ح",2,0],["عله أن ينيب منها إلى الله","بصدق مستعصما بمتاب",47,"ب",1,0],["عَلَّهُ يُخبِرُ حَيثُ يَمَّموا","أَلِجَرعاءِ الحِمى أَول لِقَبا",48,"ب",2,0],["علة الضم بين هذا وهذا","قد نفاها فأين حقُّ القرابه",49,"ب",2,0],["علة النشأتين فيمن يرى ال","له ومولى وجودها وفناها",50,"ا",3,0],["عَلَّها تُسفِرُ عَن حادِثَةٍ","يَسبِقُ الأَبيَضُ فيها الأَسمَرا",51,"ر",2,0],["علة الجفن فيك علة سقمي","وشفاي ارتشاف خمرة فيكا",52,"ك",2,0],["علَّه يبلو أناساً بعدنا","فيرَى من ذَا على العهدِ أقاما",53,"م",2,0],["عل هذا الليل يتبعه","فجر يوم كاشف الظلم",54,"م",1,0],["عله يقذف من أع","ماقه بعض اللآلي",55,"ي",1,0],["عَلّ هَذا الزَمان يَسمَح يَوماً","وَيَعود البَخيل غير بَخيلِ",56,"ل",1,0],["عله أَن يَفيق مِن طول سُكر","لِلمَعاني وَرقة الأَشعار",57,"ر",1,0],["عِلَّةٌ اذ تَدِبُّ في كُلّ عُضوٍ","شِبهَ صِلٍّ يخالُها العقلُ تَسعَى",58,"ع",2,0],["علها آخر ذكرى للحزين","ثم تفتر شفاه للقبل",59,"ل",1,0],["عله نجمي الذي أشكو به","ضنك العيش مساء وبكورا",60,"ر",2,0],["علها رقت لصب","بات رقاً في هواها",61,"ا",3,0],["علها تَشفي عَليل الأَضلع","حينَ تُنسيه هموما وَعَذاب",62,"ب",1,0],["عَلَّها تَدفَعُ عَنهُنَّ الأَذى","وَلِزاهي قَصرِ فِريامَ مَضى",63,"ض",2,0],["علة الكائنات قطب مدار ال","حق مشكاة نوره والنور",64,"ر",1,0],["علة البدر راقبي الحسن فيه","لا تضري به ولا تنحليه",65,"ي",2,1],["عَلَّها تَشفي فُؤادي","مِن هَوى مَن هيَ مُرادي",66,"ي",1,0],["عِلَّةُ الخَلقِ أَشرَفُ الرسل طه","خيرَةُ اللَه في جَميعِ المَحامِد",67,"د",1,0],["علهم إن يسمعوك ينظروا","لي فيحنو كلهم عطفاً علي",68,"ي",1,0],["عَلَّها تَرْوِي غَرامِي عَنْ جَوَى","مُهْجَةٍ تَلْظَى بِوَجْدٍ سَرْمَدِ",69,"د",1,0],["عَلَّها تَقْرَأُ سَطْراً خَطَّهُ","لَحْظُها في قَلْبِ عانٍ مُجْهَدِ",69,"د",1,0],["علة ابليس التي اوجبت","ابعاده باللعن مدحورا",70,"ر",2,0],["علَّهُ أن يحيا في دعةٍ","قلبه بالمرِّ قد طفحا",71,"ح",2,0],["علَّها في الدهرِ ِ تسهو مرةًا","ذا ت يومٍ بوفاءٍ َ مُنْفَرد",72,"د",1,0],["علَّةُ الأوْهامِ في العظمِ شَابتْ","نَخرُها للقلبِ علَّ الشَّباَبا",73,"ب",2,0],["علها الأوهَامُ قدَّتٰ مضجعكْ","أوكللْٰتَ الصَّبْرَ لَمَّا أشٰبَعَكْٰ",74,"ك",