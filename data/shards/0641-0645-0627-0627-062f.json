{"poems":[[95,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[99,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[46,"كأني لم أبثكما دخيلي","https://www.aldiwan.net/poem30009.html","الوافر"],[71,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[76,"تهاداني لذكركم ارتياح","https://www.aldiwan.net/poem12882.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85315","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[92,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[146,"أبا الخير المفيد لكل خير","https://www.aldiwan.net/poem58356.html","الوافر"],[211,"من مبلغ الأقوام أن محمدا","https://www.aldiwan.net/poem27907.html","الطويل"],[211,"أراني كلما قاربت قومي","https://www.aldiwan.net/poem27975.html","الوافر"],[215,"ولي شبابك لم ننعم بنضرتِه","https://www.aldiwan.net/poem46560.html","البسيط"],[217,"تعجبُ جارتي لما رأتني","https://www.aldiwan.net/poem405.html",""],[267,"لقد خاصمتني دهاة الرجال","https://www.aldiwan.net/poem68184.html","المتقارب"],[274,"ألا قل لعبيد الله","https://www.aldiwan.net/poem26457.html","الهزج"],[275,"أما أرجوه نفسي تختشيه","https://www.aldiwan.net/poem35049.html","الوافر"],[275,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[285,"أبا حسن لئن كانت أجابت","https://www.aldiwan.net/poem60736.html","الوافر"],[303,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[303,"تعالى المبدع القدس","https://www.aldiwan.net/poem36858.html","عموديه"],[333,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[358,"أدر راح الصفا ولك الأمان","https://www.aldiwan.net/poem39769.html","الوافر"],[376,"ألا يا أيها البيت المعلى","https://www.aldiwan.net/poem57081.html","الخفيف"],[409,"أجاب الدمع من قبل اللسان","https://www.aldiwan.net/poem33393.html","الوافر"],[411,"المرء بالهمة والتجمل","https://www.aldiwan.net/poem49808.html","الرجز"],[454,"حديث الحب","https://www.aldiwan.net/poem1016.html",""],[457,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[463,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[543,"عدو الحق عند الناس طرا","https://www.aldiwan.net/poem47994.html","عموديه"],[556,"سقى الله التي طردت وسادي","https://www.aldiwan.net/poem47862.html","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96992","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96366","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96627","الوافر"],[1242,"","https://poetry.dctabudhabi.ae/diwan/poem/79668","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108715","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132290","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124743","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69429","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27923","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28549","المتقارب"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121188","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102384","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128926","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34682","الهزج"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2525","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83547","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28657","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4733,"النظرة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=210308",""],[5129,"حين يزهر الجنون","https://www.poetsgate.com/ViewPoem.aspx?id=120621",""],[5135,"طيفَ الأحبةِ","https://www.poetsgate.com/ViewPoem.aspx?id=201973",""],[5219,"طائر الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=194854",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5804,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=214960",""],[6212,"عيون الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1622&r=&rc=3",""],[463,"أمن خفوق البرق ترزمينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60256&r=&rc=312",""],[6327,"مَرْثيّةُ الغَريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86570&r=&rc=5",""]],"verses":[["فَمَا ادْخَرْتَ نَفِيساً قَدْ تَضُنُّ بِهِ","عَلَى الذَّرَاِري نَفْسُ الْوَالِدِ الحَدِبِ",0,"ب",1,0],["فما أدري لأيّهما ثنائي","ثوانيه السِّراع أم البطاء",1,"ا",2,0],["فَما أَدري عَمايَ عَنِ اِرتِيادي","دَهاني أَم عَماكَ عَنِ الجَميلِ",2,"ل",1,0],["فما أدري أنقشاً فوقَ طرسٍ","يطرزُ أم مساءً في صباحِ",3,"ح",1,0],["فَما أَدري أَمَوجٌ أَم قُلوبٌ","وَأَنفاسٌ تُصَعِّدُ أَم رِياحُ",4,"ح",1,0],["فَما أَدري أَليلى لَم ترد أَن","تجيب عليه أَم ضاع الكِتاب",5,"ب",1,0],["فما أدْرَمَتْها في الوقائعِ دارِم","ولا استافَها في مَحبِسِ الخيلِ حابِس",6,"س",1,0],["فما أدري غَداةَ نَزَا عليه","من الأمواج مُغتَلِمٌ يؤر",7,"ر",1,0],["فَما أَدركوا ذَحلاً وَلا سَفَكوا دَماً","وَلا حالَفوا إِلّا شِرارَ القَبائِلِ",8,"ل",1,0],["فما أدرى أمن كُحلٍ مُماع","تجسَّم أم دُجَى ليلٍ مذابِ",9,"ب",1,0],["فَما أَدرَكَ الأَوتارَ إِلا سُيوفُنا","وَإِلا رِماحاً نَستَدِرُّ بِها الدِّما",10,"م",2,0],["فَما أَدري وَما يُدريهِ عَوفٌ","أَيَنفَعُني الهُبوطُ أَمِ الصُعودُ",11,"د",1,0],["فما ادّكارُ عهود منك ما ظفرت","فيها الأماني بوعد غير ممطول",12,"ل",1,0],["فَما أَدري وَظَنّي كُلُّ ظَنٍّ","أَيُسلِمُني بَنو البَرءِ اللِقاحِ",13,"ح",1,0],["فَمَا أدحضَ اللهُ لي حُجَّةً","وَلا خَيَّبَ اللهُ لي قَافِيَه",14,"ف",3,0],["فَما أَدري وَقَد غابا","بِهِ أَيُّهُما الأَعلى",15,"ل",2,0],["فما أدنى الأمانَ من المنايا","وما أدنى الكريمَ من الكريه",16,"ي",2,0],["فما أدنى الحياةَ من التّلاشي","وما أدنى الحمامَ من الخلود",17,"د",1,0],["فَما أَدْرِي أَأَشْكُرِ مِنْكَ قَصْدِي","بِجُودِكَ وَاصْطِناعِكَ أَمْ إِخائِي",18,"ي",1,0],["فما أدري أَمِن محضِك","أُسقى اليوم أم شوبكْ",19,"ك",1,0],["فما أَدري أَظلّ الل","هِ أَمْ من نورِه قبسُ",20,"س",1,0],["فما أدناك من عيني","وما أنآك عن فقري",21,"ي",1,0],["فَما أَدري وَدرع الصَبر ضافٍ","أَسيفٌ قَدّ درعي أَم سِنانُ",22,"ن",1,0],["فَما أَدري أمِن شَرفٍ ومجدٍ","بَناكَ اللَّهُ أم حَجَرٍ وطِينِ",23,"ن",1,0],["فما أدرى عين قد رمتنا","ففارقنا المغاني والغواني",24,"ن",2,0],["فما أدري جنى النَّخلِ","أراني أمْ جنى النَّحْلِ",25,"ل",1,0],["فما أدري وقعت لسوء ظني","صريعا أو وقعت لحسن ظني",26,"ن",2,0],["فما أدماء تعطو حين تمشي","بجيد عاكل تزجي طَلاها",27,"ا",3,0],["فما أدراي خُلُقا مموَّها","ولا أروم نائلا ممنونا",28,"ن",2,0],["فما أدخلتموه يقولُ إلا","لخوفِ لسانه فيكم يطيلُ",29,"ل",1,0],["فما أدرِي وقد قضّيت نَحْبِي","أَغيَّاً كانَ ذلكَ أَمْ رَشادا",30,"د",2,0],["فما آدم في يوم راحٍ مفارقٌ","لجنان بدمع يستهل ويذرف",31,"ف",1,0],["فما أدنى نعامَةَ من أبينَا","اذا عُدَّ الخؤولَةُ والعمومُ",32,"م",1,0],["فما أدهاه من شهر تقضى","وحسبك عبرة ما كان أمسِ",33,"س",1,0],["فَما أَدري أَطلعٌ أَم حبابٌ","بِفيها أَم جمانٌ أم إقاحُ",34,"ح",1,0],["فما أدري وعلِّي سوفَ أدري","أحِلُّ مالُ أهيبَ أم حرامُ",35,"م",1,0],["فما أدخلت من بعدها العين ثيباً","على طور قلبي لا ولا غادةً عذرا",36,"ر",2,0],["فما أدري ولكن من أتاها","محالٌ أن يؤوب إلى الحسان",37,"ن",1,0],["فما أدركته ميتاً فكله","وذك الحي منه بالحديد",38,"د",1,0],["فَما أَدناهُ مِن خَيرِ مَجِيءٌ","وَلا أَقصاهُ مِن شَرِّ إِيابُ",39,"ب",1,0],["فما أدري ما هذا ولستُ بجاهل","وقد عرفتني بالأمور حدودي",40,"ي",1,0],["فَما أَدرَكوهُ وَلا ماطَلوا","مِطالَ البَطيء عَنِ السُّرَّعِ",41,"ع",1,0],["فما ادبي الا غريمي وفطنتي","عدوى ومن شعري دهتني المصائب",42,"ب",1,0],["فما أدركتْنا يا بنَ مروانَ دونَكمْ","صلاةٌ لأُولى في مُناخٍ ولا فجرِ",43,"ر",1,0],["فما أدباء الشرق الا فرائد","من الجوهر الغالي وانك أغلاها",44,"ا",3,0],["فما أدري اليد اليسرى","به أشقى أم اليمنى",45,"ن",2,0],["فَما أَدرَكَ الأَوتارَ مِثلُ مُحَقِّقٍ","بِأَجرَدَ طاوٍ كَالعَسيبِ المُشَذَّبِ",46,"ب",1,0],["فما أدري ثغوراً من عقود","تفصل أم عقودا من ثغور",47,"ر",1,0],["فَما أَدري وَأَنت حَبيبُ رَبّي","أَجِبني هَل غَدَوتُ له حَبيبا",48,"ب",2,0],["فَما أَدرَكَ النَّورُ الرَّبيعي يَومَهُ","وَلا عَرَفات بَعدَ ذلِكَ أَدرَكا",49,"ك",2,0],["فما أدري أقولي آه مني","يبرَّد غلتي أم آه منك",50,"ك",1,0],["فما أدري بما للقلبِ أجدَى","أغضُّ الطَّرفَ نُبلا أو أعيدُ",51,"د",1,0],["فما أْدركتْكِ النَّفسُ بين شتاتِها","كيانًا ولا أدركْتُ فيكِ تَأطُّرَا",52,"ر",2,0],["فما أدري أصار الليل دهراً","أم الدهرُ الذي أحياهُ ليلُ ؟!",53,"ل",1,0],["فما أدري أتسالني دلالا ؟ .","فهل ياقلب فزت بمبتغاكا ؟",54,"ك",2,0],["فما ادرعت باللام إلا وأفرغت","عليها لأطراف القنا مهجاتها",55,"ت",3,0],["فماادري اذا زجرت هوانا","غراماً قد توقّر في اذيني",56,"ن",2,0],["فما أدري وهل أدري","إذا يرضى بحالاتي",57,"ت",2,0],["فما أدري ، إذا ما قلتُ شعراً،","أشعراً كان قولي أم جروحي؟!",58,"ح",2,0],["فما أداري خلقا مموَّها","ولا أروم نائلا ممنونا",59,"ن",2,0],["فما أدري أتُشْرِقُ في هَزيعٍ","شُموسُ الحُلمِ أم تَرِثُ الغِيابا",60,"ب",2,0]]}