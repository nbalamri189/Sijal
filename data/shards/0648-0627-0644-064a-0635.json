{"poems":[[275,"دع للجهاد قواعد الزجاج","https://www.aldiwan.net/poem35000.html","الكامل"],[275,"يا مي أفنى مهجتي التعليل","https://www.aldiwan.net/poem35580.html","الكامل"],[287,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[287,"روحي مذللة بحب مدلله","https://www.aldiwan.net/poem32649.html","الكامل"],[369,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[369,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126824","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78170","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108701","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117947","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[5848,"حلم با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=53185",""]],"verses":[["وإلى صلاحِ الدينِ تشهدُ بَطشَهُ","حطّينُ للتحريرِ والإفراج",0,"ج",1,0],["وإلى صباحٍ فيهِ سرتِ خفيفةً","وعلى الجبينِ من السَّنى إكليل",1,"ل",1,0],["وَإِلى صَفِيِّ الدينِ أَستَعدي عَلى","دَهرٍ أَقامَ بِساحَتي عُدوانُهُ",2,"ن",2,0],["وَإِلى صَفِيِّ الدينِ اِستَعدي عَلى","زَمَنٍ عَلَيَّ عَلا فَأَلقى كَلكَلَه",3,"ل",2,0],["وإلى صَفىِ الدّولةِ اصسطحَبا معاً","وَفْدان وَفْدُ عُلاً ووفْدُ سُعود",4,"د",1,0],["وإلى صَبيبِ دماءِ أعداءِ الهُدى","في عَصْرِكَ التاحَتْ فقلتَ لها رِدي",5,"د",2,0],["وإلى صاحب السعادةِ أُهدي","خالص الشكر إذ بهِ الشعب حافل",6,"ل",1,0],["وَإِلى صَحابَتِهِ إِلا ماجد ما ثَنَت","أَيدي النَسيم مَعاطف الأَغصان",7,"ن",1,0],["والٍ يصول برأيه وحسامه","فيفوز فوز قضاء ربك والقدر",8,"ر",1,0],["وإلى صيانته وعفّة نفسه","وحميد سيرته العيون تحدق",9,"ق",1,0],["وإِلى صَحبِهِ أَشارَ بأَن سُو","قُوا إِلى الفُلكِ خَيلَها الأحرارا",10,"ر",2,0],["والى صحت من نومها عاد ماني","قايل لكم خطواتها تشطب ازمان",11,"ن",1,0]]}