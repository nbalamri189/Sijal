{"poems":[[48,"أجزاء دهر ينقضين ولم يكن","https://www.aldiwan.net/poem22576.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119864","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128704","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118407","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131058",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[5732,"الجادل اللي","https://www.poetsgate.com/ViewPoem.aspx?id=177913",""]],"verses":[["وَوَنى الرِجالُ العامِلونَ وَما وَنى","فَلَكٌ بِخِدمَةِ رَبِّهِ دَوّارُ",0,"ر",1,0],["وونت بقوته الرياح ولا ونى","دمع الغمام يروح فيه ويغتدي",1,"د",2,0],["وونت من السير الشديد وكلما","غنى لها الحادي بطيبة تسرع",2,"ع",1,0],["وونيت عن حمل الملامة والجفا","وعن الملامة هن لس ينينا",3,"ن",2,0],["وونت له همم فلم","يطمح إلى نيل العلى",4,"ا",1,0],["وَوِناسُ الشَّيخُ الجَليلُ أَبُوهُ","جَاثِياً عِندَ بابِهِ يَرجُوه",5,"ه",1,0],["وونيت ونات لها الورق غنا","ومن العنا والوجد ياسف لي الميت",6,"ت",1,0]]}