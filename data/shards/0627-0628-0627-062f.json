bi.ae/diwan/poem/74175","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112647","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112641","الرجز"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100174","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48435","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138615",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66320","السريع"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85245","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59488","الطويل"],[3862,"","https://poetry.dctabudhabi.ae/diwan/poem/111214","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123511","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133111","الوافر"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89570","المديد"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139554",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139555",""],[4654,"","https://poetry.dctabudhabi.ae/diwan/poem/206248","المتقارب"],[4748,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=4193",""],[4767,"طفل الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=88355",""],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[1012,"فتح بلدة نفعا","https://www.poetsgate.com/ViewPoem.aspx?id=124499",""],[5050,"تحدر دمعي على سادة","https://www.poetsgate.com/ViewPoem.aspx?id=38197",""],[5242,"جنود الله هبُّوا للقتال","https://www.poetsgate.com/ViewPoem.aspx?id=125969",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5302,"كن لي رفيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=200552",""],[5351,"لعمرك إن للأحرارُ نورُ","https://www.poetsgate.com/ViewPoem.aspx?id=202769",""],[5376,".أُبادله بكل هوى وألقى.إلى ولدي الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=188452",""],[5845,"أرى برقَ الغويرِ إذا تراءى","https://www.poetsgate.com/ViewPoem.aspx?id=198484",""],[6213,"عانقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76276&r=&rc=33",""]],"verses":[["أُبادِرُ دونَها عَجَانَ أَمشي","رُوَيدَ المَشيِ مُضطَرِبَ النِجادِ",0,"د",1,0],["أبادُوا شَياطينَ الضّلالِ وزَيّنَتْ","سَماءَ رُسومِ الحَقِّ منْهُمْ مَصابِحُ",1,"ح",1,0],["أُبَادِرُ دُرونك الأميرِ وقُربَه","لأُذكرَ في أَهلِ الكَرَامَةِ والنُّهى",2,"ا",1,0],["أباد قلوب العاشقين فلم يدع","حبيباً لفاد أو رقيقاً لمعتق",3,"ق",1,0],["أُبادِرُ شَوّالاً بِظَبيَةَ إِنَّني","أَتَتني بِها الأَهواءُ مِن كُلِّ جانِبِ",4,"ب",1,1],["أُبادِرُ مَن يَأتيكَ مِن كُلِّ جانِبٍ","مُشاةً وَرُكباناً فَإِنّي مُبادِرُه",5,"ر",2,0],["أُبادِرُ كَفَّيكَ اللَتَينِ نَداهُما","عَلى مَن بِنَجدٍ أَو تِهامَةَ ماطِرُه",5,"ر",2,0],["أَبادَ القُرونَ الماضِياتِ وَإِنَّما","تَمُرُّ التَوالي في طَريقِ الأَوائِلِ",6,"ل",1,0],["أَبادَهُم فَلِبَيتِ المالِ ما مَلَكوا","وَالروحُ لِلسَيفِ وَالأَشلاءُ لِلرَخَمِ",7,"م",1,0],["أبادَ حياتي الموْتُ إن كنتُ ساليا","وأنتَ مقيمٌ في قيودكَ عانيا",8,"ي",2,1],["أَبا دُلَفٍ لَم يَبقَ طالِبُ حاجَةٍ","مِنَ الناسِ غَيري وَالمَحَلُّ جَديبُ",9,"ب",1,1],["أُبادِرُها بِالشُكرِ قَبلَ وِصالِها","وَإِن هَجَرَت يَوماً طَلَبتُ لَها عُذرا",10,"ر",2,1],["أبادت قومَنا إلا بقايا","أقاموا بالعَراءِ معذَّبينا",11,"ن",2,0],["أبادوا النّاسَ شعباً بعد شعبٍ","وقاموا في المآتمِ ساخرينا",11,"ن",2,0],["أَبادَت في قُرى إِزميرَ قَوماً","وَغالَت في أَدَرنَةَ آخِرينا",12,"ن",2,0],["أَبادَت كُلَّ مَعرِفَةٍ وَفَنٍّ","وَأَفنَت كُلَّ مَقدِرَةٍ وَحِذقِ",13,"ق",1,0],["أَبا دُلَيجَةَ مَن يوصى بِأَرمَلَةٍ","أَم مَن لِأَشعَثَ ذي طِمرَينِ طِملالِ",14,"ل",1,0],["أَبا دُلَيجَةَ مَن يَكفي العَشيرَةَ إِذ","أَمسَوا مِنَ الأَمرِ في لَبسٍ وَبَلبالِ",14,"ل",1,0],["أَبا دُلَيجَةَ مَن لِحَيٍّ مُفرَدٍ","صَقِعٍ مِنَ الأَعداءِ في شَوّالِ",15,"ل",1,1],["أَبَادُوا بِهَا شَمْلَ الْعُلُومِ وَشَوَّهُوا","مَحَاسِنَ كَانَتْ زِينَةَ الْبَرِّ وَالْبَحْرِ",16,"ر",1,0],["أَبَادَ بَنِيهِ ظَالِمَاً غَيْرَ رَاحِمٍ","فَيَا عَجَبَاً مِنْ وَالِدٍ لَيْسَ يُشْفِقُ",17,"ق",1,0],["أَبَادَهُ الدَّهْرُ رَغْمَاً بَيْنَ أُسْرَتِهِ","كَمَا أَبَادَ بِرِيحٍ صَرْصَرٍ عَادَا",18,"د",2,0],["أَبَادَتْ قَبْلَنَا إِرَمَاً وَعَاداً","وَطَارَتْ بَيْنَ ذُبْيَانٍ وَعَبْسِ",19,"س",1,0],["أبادرُ درنوكَ الأميرِ وقربهِ","لأذْكرَ في أهلِ الكَرامَة ِ والنُّهى",20,"ا",1,0],["أَبادَت بَقايا الصَبر مني صَئولةٌ","فَما صَحبت سَيفاً وَلا اِعتَقَلت رُمحا",21,"ح",2,0],["أَبادَت بَقايا الصَبر طارِقةُ الدَهرِ","وَعَهد التَصابي وَهِيَ رَيحانة العُمرِ",22,"ر",1,1],["أبَادُوا كُلَّ مَنقَصةٍ وشَادُوا","بِنَاءَ المَجدِ مِن بَعدِ إنهَدَادِ",23,"د",1,0],["أَبادَ مُخالِفاً وَأَفادَ ذِكراً","تَزولُ الراسِياتُ وَما يَزولُ",24,"ل",1,0],["أبادهم قتلا وأسرا ولم يدع","بها من له رمح مضر ولا نصل",25,"ل",1,0],["أبادهم الزمان على اتفاق","فما يلوي الكبير على الصغير",26,"ر",1,0],["أَبادَ الجاهليّة والأعادي","فَلَم يترُك أبا جهلٍ وجهلا",27,"ل",2,0],["أَبادَ ندَاك المالَ حتَّى كأنما","سماحُك يقظانٌ ومالُك نائم",28,"م",1,0],["اباد النوم عن عينيه فيها","ومن طلب السها الف السهادا",29,"د",2,0],["أَباد المُشركين بكل ثغر","وَقاد الخيل شاذبة وَساقا",30,"ق",2,0],["أَبادَهُمُ تَخَوُّفُه فأَمسى","مُناهُمْ لو يُبَيِّتُهم بأَمْن",31,"ن",1,0],["أباد ملوك الأرض كسرى وقيصراً","وكرَّ على المأمون يوماً وجعفر",32,"ر",1,0],["أَبادوا العيس لَما كَلَفوها","دَؤُوباً قَطع بيد بعد بيد",33,"د",1,0],["أَبادَ حُماةَ القَومِ وَاجتاحَ أَرضَهُم","وَلَولاهُ لَم يَطرِق لمعقلِهِم خَطب",34,"ب",1,0],["أباد الطغاة وأفنى العصاة","ودمّرها بعد عصيانها",35,"ن",3,0],["أبادلك الحب والعيدُ زاهٍ","ألسنا الى نوره ننتمى",36,"م",2,0],["أبا دُلفٍ اِن جار بيْنٌ وصرَّحت","نوىً قُذفٌ لا يرتجى بعدها وصل",37,"ل",1,1],["أبادَ الظُّلْمَ والإِمْلاقَ حتى","لِكُلٍّ منْ مَناقِبهِ انْتِقامُ",38,"م",1,0],["أبادَ وأبلى الدهرُ بهجةَ أنسِها","فهل لليالي أُنسِها مَنْ يُعيدُها",39,"د",3,0],["أبادية الأعراب أهلَكِ إنني","ببادية الأتراك نيطت علائقي",40,"ق",2,0],["أَبادَ الرّدى أَهلي وَأَفنى معاشِري","وَفرّقَ ما بيني وبينَ عَصائبي",41,"ب",2,0],["أَبادَني هَواكُم","وَالحُبُّ لا يَبيدُ",42,"د",1,0],["أبادَ الوَرى بالمشْكلات وقَبْلهم","بأوهامِه قد أهْلَك الجِنَّ والبِنَّا",43,"ن",2,0],["أَبادَهُمُ بأْسُه المستطيلُ","وأَهلَكهم سيْفُه الفاصِلُ",44,"ل",1,0],["أَبادَ الخَوالي وَالبَواقي رِهائِنٌ","لَدَيهِ فَما باقٍ بِهِ غَيرَ بائِدِ",45,"د",1,0],["أبادوا جنودَ الإنكليز ومزّقوا","منَ الكفرِ جَمعاً بعد ذا ليسَ يَلتَئِم",46,"م",1,0],["أَباد أَهل العِنادِ","بِمدفع وَحسامِ",47,"م",1,0],["أباً دعوني ومالي فيهمُ ولدٌ","ولستُ للقوم غيرَ العمِّ والخال",48,"ل",1,0],["أباد اللضه ريب الدهر جمعاً","أيدري من بحادثه أبادا",49,"د",2,0],["أَبا دُلَفٍ أوقعت عِشرينَ وَقعَةً","وَأَفنَيت أَهل الأَرضِ في السَنواتِ",50,"ت",1,0],["أَبا دُلَفٍ إن الفَقيرَ بِعينِهِ","لَمَن يَرتَجي جَدوى يَدَيكَ وَيَأمَلُه",51,"ل",2,1],["أَبا دُلَفٍ بورِكتَ في كُلِّ بَلدَةٍ","كَما بورِكَت في شَهرِها لَيلَةُ القَدرِ",52,"ر",1,0],["أَبا دُلَفٍ يا أَكذَبَ الناسِ كُلِّهِم","سِوايَ فَإِنّي في مَديحِكَ أَكذبُ",53,"ب",1,1],["أَبا دُلَفٍ دَلَفَت حاجَتي","إِلَيكَ وَما خِلتُها بالدلوفِ",54,"ف",1,1],["أَبادَ أَعداءَنا سَطْواً وكانَ لَنا","هَدَىً فأَمَّنَنا ظُلْماً وإِظْلاماً",55,"م",2,0],["أَبادَ اللهُ أَهْلَ الشِّركِ مِنْهُ","بخيرِ مُكافحٍ عن خَيرِ مِلَّهْ",56,"ل",2,0],["أبادَ لباسُها عمرَ النسورِ وكم","ردت إلى الحرب عن أرواحها الأجلا",57,"ل",2,0],["أبادهم ودمرهم وأفنا","وأوردهم إلى حوض الحمام",58,"م",1,0],["أَباديسُ أَنتَ اِمرِؤٌ حاذِقٌ","تُصيبُ بِظَنِّكَ نَفسَ اليَقين",59,"ن",1,0],["أبادني طرفه من قبل عاذله","والسبق للسيف ليس السبق للعذل",60,"ل",1,0],["أَبا دُلَفٍ السَماحَةَ لَم تَزَل","مُغَلَّلَةً تشكو إِلى اللَهِ غُلَّها",61,"ه",2,1],["أبادوا جمعكم وسبوا نساكم","وساموكم بأفعالٍ قباح",62,"ح",1,0],["أبادتكم فرسانُ قيس فما لكم","عديدٌ إذا عُدَّ الحصا لا ولا عقبُ",63,"ب",1,0],["أباد من الوحش الأعارب والذي","ترفع عنه السيف غيَّبها أكلا",64,"ل",2,0],["أباد قريشاً يوم بدرٍ بسيفه","ويوم حنينٍ ليس إلاه ضارب",65,"ب",1,0],["أَبادَ سُيوفَ الهِندِ بِالضَربِ في الصِبا","وَأَفنى بِطُولِ الطَعنِ ما أَنبَتَ الخَطُّ",66,"ط",1,0],["أَبادَ المالَ حَتّى لَيسَ تُلفي","لَهُ إِلّا جَميلَ الذِكرِ مالا",67,"ل",2,0],["اباد وهم قتلا واسراً ومثلة","كأن رسول اللَه ليس لهم أب",68,"ب",1,0],["أبادَ ملوكَ الأرض كسرى وقيصرا","وأصمت لدى فرسانها منه أسهمُ",69,"م",1,0],["أبادر إهلاك مستهلك","لمالي أو عبث العابث",70,"ث",1,0],["أباد ملوك المترفين فأصبحوا","كنقع تهاداه السنابك ملحب",71,"ب",1,0],["أبادَ كلَّ كميٍ من كتائِبهم","ولفَّ أوّلها بأساً بآخرها",72,"ر",3,0],["ابادوهم قتلا وصلباً وفي بناً","وسما وتعذيبا وإقبار آبار",73,"ر",1,0],["أبادوا بنيك وطافوا بروس","ذراريك وانتهكوا حرمتك",74,"ك",1,0],["أباد أحمد أباد هول مصرعه","وباء بعد الآباء من فيه بالوجل",75,"ل",1,0],["أباد كل كافرٍ زنديق","وكان مهديّاً على التحقيقِ",76,"ق",1,0],["أَبادَ المُشرِكينَ بِكُلِّ ثَغرٍ","وَأَوطأَهُم مُسَوَّمَةً دِقاقا",77,"ق",2,0],["أَباد بِها جَيش الطُغاة فَأَصبَحوا","أسارى لَدَيها لا فِداء وَلا منا",78,"ن",2,0],["أبادَ منهُم عَدَداً كثيرا","أصلاهُمُ من سيفهِ سعيرا",79,"ر",2,0],["أبادَ جمعاً منهُمُ كثيراً","وشبّها على العدا سعيرا",80,"ر",2,0],["أباد ذوي التيجان من عهد آدم","وكسرى على ذحل قضى ومرازبه",81,"ب",2,0],["أبادَ دُموعي يومَ أبْدى صَبابَتي","فبحْتُ بسرٍّ لم يزَل ميّتَ الأحْيا",82,"ي",2,0],["أباد بسيف البغي أبناء فاطم","وما هجعت عن جعفر قط عيناه",83,"ا",2,0],["أباد أهل الشام في جحفل","حمق لدى الهيجاء أكياسِ",84,"س",1,0],["أباد خضراهم بالسمر شجرت","وكل أبيض ماضي الحد بتار",85,"ر",1,0],["أبادت بني ذبيان في لطم داحس","بعبس فأضحوا من قتيل وقاتلِ",86,"ل",1,0],["أباد الجحود واردى اليهود","وباهل بالأهل حتى النصارى",87,"ر",2,0],["أبا داود فزت بمأثرات","هي الأقمار والأيام هال",88,"ل",1,0],["إبادة ولده طر","راً وذل بناته أسرا",89,"ر",2,0],["أباده الرحمن شر بيد","وكل من ألزمك المحبه",90,"ه",1,0],["أبادوا بأسياف الردى عدد العدا","فما اخطؤا شخصا وأرضهم اختطوا",91,"ط",3,0],["أباد الله منهم كل حي","وأجلى عن صفا الوادي قتامه",92,"م",2,0],["أَبِ آدَمَ إِبنِهِ عَجَباً","لَكَ حُسنى اللَهِ لِلأُمَمِ",93,"م",1,0],["أباد ذوى السلطان من آل قيصرٍ","وكسرى وأفنى الغرَّ من آل غالب",94,"ب",1,0],["أباد بنى ساسان حدُّ سنانه","وأفنى الكرام الغلب من آل غالب",95,"ب",1,0],["أبادر بالمال سهمانه","وقول المعوق والرائث",96,"ث",1,1],["أبادر بالهلا واحبس دموعي","واحاول اتسلى بالمزاحي",97,"ح",2,0],["أبادوا عودك الريان قصفاً","فماتت منه في الحال الورود",98,"د",1,0],["أبادهم فهم صرعى وقتلى","وبآءوا بين ذل وانهزام",99,"م",1,0],["أبادهم فهم صرعى وقتلى","وباءَ الغافرية بإنهزام",100,"م",1,0],["أبادوا العداة فليس النجا","لغير فتى بهم أسعدا",101,"د",2,0],["أبادتهم جنود لم يروهَا","ومنهَا ما يرى مثل السعالي",102,"ل",2,0],["أبادل صب العشق مني صبابة","وأدني إليه القلب مهما نهانيا",103,"ي",2,0],["أبادلها الآهات في كل غمرة","تمهد للآتي من الغمرات",104,"ت",1,0],["أباد الشعب في برٍ وبحرٍ","فما سلم العزاء ولا السرورُ",105,"ر",1,0],["أُبادله بكل هوى وألقى","حياءً منه لا يخفيه عنِّي",106,"ن",2,1],["أبادَبدينهِ الأديانَ حقاً","وكانتْ قبلُ زوراً وافتراءَ",107,"ا",2,0],["أبادلك الحديث فلامسيني","أسرُّكِ في لساني أم يديا؟",108,"ي",2,0]]}