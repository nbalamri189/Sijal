{"poems":[[26,"تؤمل أن تلاقي أم وهب","https://www.aldiwan.net/poem24089.html","الوافر"],[50,"لا أندب الربع قفرا غير مأنوس","https://www.aldiwan.net/poem66269.html","البسيط"],[52,"فيا حزنا هلا بنا كان ما به","https://www.aldiwan.net/poem64837.html","الطويل"],[48,"إذا عقدت عقدا لياليك هذه","https://www.aldiwan.net/poem22308.html","الطويل"],[111,"أبا الحارث اسمع حديثا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=527",""],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"حكى لي صديق صادق حال ظالم","https://www.aldiwan.net/poem57550.html","الطويل"],[325,"خليل العلا خياط باشا الذي له","https://www.aldiwan.net/poem67201.html","الطويل"],[435,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[463,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[484,"حللت قلبي يا ابني","https://www.aldiwan.net/poem37055.html","المجتث"],[534,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[541,"تولى الجود وانقرض الكرام","https://www.aldiwan.net/poem23847.html","الوافر"],[563,"فراشتي رأت النور الذي ظهرا","https://www.aldiwan.net/poem34480.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126877","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86932","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48542","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38622","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77579","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77571","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77543","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77479","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77489","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77602","الرجز"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216895","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56292","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46524","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124741","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124721","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27977","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87319","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205785","الوافر"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58264","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65124","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112689","الرجز"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102390","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138474",""],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36759","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135258","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135500","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102979","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102944","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94983","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72973","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72433","الطويل"],[4836,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=205524",""],[557,"بين العمر والأماني","https://www.poetsgate.com/ViewPoem.aspx?id=15725",""],[557,"إذا دارت بنا الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=6369",""],[5135,"خَيلُ البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=201871",""],[5190,"بئس المآل","https://www.poetsgate.com/ViewPoem.aspx?id=61650",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5660,"وَيحَ الأَماني إِذا كانَت مِنَ العَدَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=36845",""]],"verses":[["وَقالَ بِعَهدِهِ في القَومِ إِنّي","شَفَيتُ النَفسَ لَو يُشفى اللَهيفُ",0,"ف",1,0],["وقال بئسَ لعمري أنت من رجلٍ","فقلتُ مهلاً فإني لستُ بالبيسِ",1,"س",1,0],["وَقالَ بِما قَالَ المُحِبُّ نَصاحَةً","وَهَل يَكذِبُ الصَبَّ المُحِبَّ حَبائِبُه",2,"ب",2,0],["وَقالَ بِأَحكامِ التَناسُخِ مَعشَرٌ","غَلوا فَأَجازوا الفَسخَ في ذاكَ وَالرَسخا",3,"خ",2,0],["وقال بجنبي فتى صبركم","تخف على النفس أوصابها",4,"ب",3,0],["وقال بحمد اللَه للنظم خاتما","على ختمها استغفر اللَه من وزري",5,"ر",2,0],["وقال بأن الله لم يعص في الورى","فما ثم محتاج لعاف وغافر",6,"ر",1,0],["وقال بلى قد أغرقوا في معارف","من العلم والباري لهم خير ناصر",6,"ر",1,0],["وقال بأن الأنبياء جميعهم","بمشكاة هذا تستضي في الدياجر",6,"ر",1,0],["وَقال بشرُ الحافي","بل عِدَّةُ الأَصنافِ",7,"ف",1,0],["وقال بني بالجوى لا الجور قاعة","فقلت تراها عن قليلٍ مرخمه",8,"ه",1,0],["وَقالَ بِمَجدِ المُلكِ يَثني مُؤَرِّخاً","بِأَكرَمِ صَدرٍ لاحَ أَفخَرَ نيشاني",9,"ن",2,0],["وقال بهرام أن الشهب أجودهم","يعني بذلك بيض الصدر والنحرِ",10,"ر",1,0],["وقال بقولي فيك كلُّ محدث","يرى أنني ما قلت إلا وأَخبُرُ",11,"ر",1,0],["وقال بالشعر أرخ","بشراك يا منجي",12,"ي",1,0],["وَقَالَ بأَنَّ اللهَ أَوْجَبَ في الْوَرَى","سُلُوكَ طَريقِ الْعَدْلِ منْ كُلّ قائِمِ",13,"م",1,0],["وَقالَ بِأَنَّهُ يَأتي شَفيعاً","لِمَن قَد كانَ قُبلَتُهُ اِستِلامُ",14,"م",1,0],["وقال بعض لها عشق يهيج بها","فتحسب النار نوراً والهوى غدرا",15,"ر",2,0],["وقال بالأمس قتلتم والده","واليوم تقتلونه مشاهدة",16,"ه",1,0],["وقال بعد ذكر ما تهيا","إني خلعت عنكم عليا",16,"ي",2,0],["وقال بادِر إلى توديع أمّك مع","كلّ النساء فهذا آخر الزمنِ",17,"ن",1,0],["وَقالَ بَهاؤُها لِلمَجد أَرّخ","خديوي عَصرِنا وَصَل البياسه",18,"س",2,0],["وقال بُنَيَّ ارحَلْ بسخطي مزوداً","فقال وداعاً أيها الوالد الغر",19,"ر",1,0],["وَقالَ بِسَيفي أَو بِطَبعي أُبيدُكم","وَمَن لَم يَمُت بِالسّيفِ ماتَ بِغَيرِهِ",20,"ه",1,0],["وَقالَ بَعدُ يا إِلهي إِنَّني","أَدعوك بِالأَلطاف أَن تدركني",21,"ي",1,0],["وَقالَ بَراني خالِقي جَلَّ صانِعاً","وَفَرضٌ عَلَينا أَن نَقومَ بِشُكرِهِ",22,"ر",2,0],["وَقالَ بِالصَبر وبِالمُداوَمَه","يُدرك ما لا تُدرك المُقاوَمَه",23,"ه",1,0],["وَقالَ بَعدُ مُظهراً عتوَّه","وَآخذُ الثالث ذا بالقوّه",24,"ه",1,0],["وَقالَ بُني اِحذر غَبيّاً لَقيته","وَلا تَصنع المَعروف غَير أَهله",25,"ل",2,0],["وَقالَ بِالخَير يَفوز مَن صَدَق","وَمَن مَشى بِالزور فَالضَرب اِستَحق",26,"ق",1,0],["وقال بفعْلٍ لا يُردّ معالهُ","وسطوة ذي بأس تُزيّنُ بالوفْرِ",27,"ر",1,0],["وقال بأن الله غير مفتّشٍ","ولا فاحص عمَّا به ساء وافترى",28,"ر",2,0],["وَقالَ بَعضٌ مِنهُم في خفيه","لِبَعضهم بحيلة وفريه",29,"ه",1,0],["وَقالَ بَعض القَوم مثل ذَلِكا","وَانَّهُ لا يعرف التماسُكا",30,"ك",2,0],["وقال بعضٌ إن يكن واقعاً","في الدهن من ثلثٍ إلى عشر",31,"ر",1,0],["وقال بعضهم إن كان أعلمه","فتمم السلم جاز السلم والسلفُ",32,"ف",1,0],["وقال بعضٌ فإن الزبد معتزلٌ","باسم عن السمن ناءٍ غير متصلِ",33,"ل",1,0],["وقال بعضهم لا شيء يوجبه","حتى يسمى أهل الفقر والهزل",33,"ل",1,0],["وقال بعضٌ بلا دينٍ تقومه","يوم استحق عليه الحنث بالوهلِ",33,"ل",1,0],["وقال بخمسةٍ أيضاً أناسٌ","وقال ببعضهم من كان أحرى",34,"ر",2,0],["وقال بعضهم حتى يقول له","كذا كذا بكذا في سعره ذهبا",35,"ب",2,0],["وقال بسطامينا إنه","دعا عباد الله أن ينزلوا",36,"ل",3,0],["وقالَ بَعضٌ إِنَّه اثنا عَشَر","أَمَّا المغيبي هُوَ نَعشُ أحَد عَشَر",37,"ر",1,0],["وقالَ بعضٌ هُنَّ سِتُّونَ عَدَد","والتِّيرُ والواقع لدى الحِسبَه سَنَد",38,"د",1,0],["وقالَ بعضٌ إِنَّ نَسرَ الطائر","يزيدُ نصفاً كُن بهذا خَابِر",39,"ر",1,0],["وقال بعض بهما وفصلا","إن نصبت فألف أو لم فلا",40,"ل",2,0],["وقال بعونه سر حيث شئنا","فطاوعه وسر سيراً ذلولا",41,"ل",2,0],["وَقالَ بشراكُم فَعَن قَريب","يَأتي لِواء صاحِب القَضيبِ",42,"ب",1,0],["وقالَ بأنّي مِن مِنىً نِلتُ منيتي","بِقَصْدي وَفَالي بالمرام وفى لي",43,"ل",2,0],["وَقالب لرضاء الحَق مُنقلب","بالحسن مشتمل بالبر متسم",44,"م",1,0],["وقال بعزّ الدّين والغنم ثق به","وأرّخ به يحوي الغنائم والعزّا",45,"ز",2,0],["وقال بالجبر وبالأرجاءِ","ونال من خير بني حواء",46,"ا",2,0],["وقالَ ببطنِ عاجنةٍ رفيقي","وعيناهُ بأربعةٍ سِجامِ",47,"م",1,0],["وقال بأنك عبد ولا","شريك إلى الله فيما ملك",48,"ك",1,0],["وَقالَ بُشراكَ رَوضُ الفَضلِ قُلتُ لَهُ","رَوضُ اِبنِ بُستانٍ وَمَولانا فَقالَ بَلى",49,"ل",2,0],["وقال بعض السلفِ العلومُ","أربعةٌ تأخذها الفهومُ",50,"م",1,0],["وقال به الإنسان شرقاً ومغرباً","يميناً شمالاً فوق تحت مع العسِّ",51,"س",1,0],["وقال به اليوم الأغر مؤرخا","سليمان مجلوب له الفتح والنصر",52,"ر",1,0],["وقال به اليوم الأغر مؤرخا","سليمان لا ينفك خادمة السعد",53,"د",1,0],["وَقَال بَل هُمَا أمرَانِ نِسبِيَّانِ","لَم يَصِلاَ الوُجُودَ فى التِّبيَانِ",54,"ن",1,0],["وَقَالَ بَلِّغ مَن بُعِثتَ فِيهِم","حُكماً دُعُوا إلَيهِ يَقتفِيهِم",54,"م",1,0],["وقال بأرخِ يا محبٌّ ترضياً","هلمَّ عُبَيداً صالحاً وأمينا",55,"ن",2,0],["وقال بأيمنِ وقتٍ سعيد","يورثُ أطيبَ عيشٍ رغيد",56,"د",1,0],["وقالبه بالكرخ علم أهله","فنون جنون وهو في غيرهم جنا",57,"ن",2,0],["وقال: بُنَّيَ أراكَ قصيِّاً","وقد كُنتَ مني قريبَ النظر",58,"ر",1,0],["وقال بأننا ذبنا.. مع الأيام أشواقا","وأن هواك في قلبي يضيء العمر إشراقا",59,"ا",1,0],["وقالَ بأننا ذبنا ..مع الأيام أشواقا","وأن هواكِ في قلبي يُضئ العمرَ إشراقا ...",60,"ا",1,0],["وقال بنبْرةٍ حرَّى وحزْنٍ","أتنْظرُ للَّذي عيْني تراه",61,"ا",2,0],["وقَالَ بِصَوتٍ أَبِيٍّ : كَفَانَا","خُنُوعٌ وظُلمٌ ، كَفَانَا اْحتِلالْ",62,"ل",1,0],["وقال بلا علم وسلطان حجة","تلوح جهراً باليقين دلائله",63,"ل",2,0],["وقال به هذا الكربتي جهرة","فسحقاً لمن تلك المخازي مناهله",63,"ل",2,0],["وَقالَ بَعضُ كِرامِ النّاسِ ذا زَمَنٌ","قَد ضَيَّعَ الراعِي المَرعى فَلا تَلُمِ",64,"م",1,0]]}