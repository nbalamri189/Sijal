etry.dctabudhabi.ae/diwan/poem/83566","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66155","الرجز"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33659","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67487","المنسرح"],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[5338,"لطيبة الغراء شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=187891",""],[5790,"يا من لديه الجميل موجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=111953",""],[5991,"يا ألمي منك إليك الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=116385",""],[4442,"أهوت به علته فانتدب","https://www.poetsgate.com/ViewPoem.aspx?id=171003",""]],"verses":[["وهْو عيبٌ يكادُ يسقط فيه","كلُّ حرٍّ يريدُ إظهارَ آلَهْ",0,"ل",2,0],["وهو على ما وصفتْ منه","مُتَّهمٌ وُدُّهُ ظنينُ",1,"ن",1,0],["وهو على غصن من الدوح","وريق يجثم",2,"م",1,0],["وَهوَ عَلى الجِدارِ في أَمانِ","يَغلِبُ بِالمَكانِ لا الإِمكانِ",3,"ن",1,0],["وَهوَ عَلى الفِطامِ ذو زَئيرِ","أَبلَغَ لِلمُجدي مِنَ التَنّورِ",4,"ر",1,0],["وَهوَ عند الدنو منها سَريع","وَهوَ عند الإبعاد ذو إبطاء",5,"ا",2,0],["وهو عمرٌ كاملٌ عشتُ به","كلَّ أعمارِ الورَى مُجتمعات",6,"ت",1,0],["وَهوَ عَلى كُربَةِ السِياقِ مَعي","يَشهَدُ أَن لا إِلهَ إِلّا هُو",7,"ا",3,0],["وَهْوَ عَالٍ كَذِكْرِهِ مَلأَ الأَرْ","ضَ وَأَلْوَى بِعاصِفَاتِ الْفَنَاءِ",8,"ا",2,0],["وهو عند الرسول شبل عزيز","ولهذا مدت له يمناه",9,"ا",2,0],["وهو عين العمى التي بعماها","قابلتها الألطاف بالأبصار",10,"ر",1,0],["وهو عنهم في غفلة معرض الوجه","كأن ليس من بني الإنسان",11,"ن",1,0],["وَهُوَّ عَلَى العَدُوِّ أمَرُّ صَابٍ","وصِبرٍ فَهوَ مَرهُوبُ الشِّفَارِ",12,"ر",1,0],["وَهوَ عارٍ ممّا يقي الحرّ من أع","مالِ خيرٍ لا كسوةٌ لا كساءُ",13,"ا",2,0],["وهو عند الطوفان صاحب نوح","والخليل الرضا بنار بن كوش",14,"ش",1,0],["وَهوَ عَلى ذا التيهِ لا أَنثَني","عَنهُ بِما فيهِ يَقولُ العَذول",15,"ل",1,0],["وَهُوَ عَلى إَرهافِهِ وَطَبَّه","يَقصُرُ عَنهُ المُحزَمانُ وَاللّبَبَ",16,"ب",1,0],["وَهْوَ على فَرْطِ السُّقو","طِ مَائِلٌ كالحَائِطِ",17,"ط",1,0],["وَهوَ عاصٍ لِقَولِ لا","حٍ عَلى مَن يُطيعُهُ",18,"ع",2,0],["وهو عند الجمهور من غير شك","كذب موجب لسوط الملام",19,"م",1,0],["وهو عليه دائماً معتمد","في الدين والدنيا وفي شرب الدوا",20,"ا",1,0],["وهو عبد الرَّحمن شهماً هماما","ناشئٌ في الشَّباب في طاعة الل",21,"ا",3,0],["وهو عبد الرحمن نجلُ عليٍّ","عَلَويُّ الآباء والأَجداد",22,"د",1,0],["وهو على ترك ذا لهذا","مباركٌ وجهُه جميلُ",23,"ل",1,0],["وهو عدوّ الفضل مذ لم يزل","يكاثر الأحلَمَ بالأنزقِ",24,"ق",1,0],["وهو على فخرهمُ","فخرٌ لهم وشرَفُ",25,"ف",1,0],["وهو عَن عارِ الدَّنايا نازِحٌ","ومِن العَلْياءِ والمَجْدِ سَقِبْ",26,"ب",1,0],["وَهوَ عَلى ما فيهِ مِن إِعجابِ","أَشَدُّ تَطفيلاً مِنَ الذُبابِ",27,"ب",1,0],["وهو على ما أشتهي","من كل خلق أقدر",28,"ر",1,0],["وَهُوَ عُذري حينَ عَن بَي","تِكَ ألوي لِعِناني",29,"ن",2,0],["وَهوَ عنِ النُّصحِ أخو تَمرُّدٍ","بالشُّحِّ والتَّقتير محجوبُ اليدِ",30,"د",1,0],["وهو علم الإشارة الإرث مما","جاءت الأنبيا به تقتفيه",31,"ي",2,0],["وهو علم التشريف علم المزايا","ليس ظناً لنا ولا حُسبانا",32,"ن",2,0],["وهو علم الإله يظهر فيمن","قرأ الله ذاته قرآنا",32,"ن",2,0],["وهو على ما عليه قدماً","بلا انتقال ولا اختزان",33,"ن",1,0],["وهو على نفسه به وله","يكتبنا فوق لوحه القلم",34,"م",1,0],["وهو عند الجهول خلف قناع","هو يا ذا الجهول أنت بذاتك",35,"ك",1,0],["وهو عن أمرٍ قديمٍ","حادثٍ مسكٌ يضوع",36,"ع",1,0],["وهو عيان لكل ذي بصر","لا يَحْجِبَنْكُمْ للنفس أخدود",37,"د",1,0],["وهو علم الله أيضاً مثلنا","نازل للذكر من غير صعود",38,"د",1,0],["وهو عين الكل والكل له","راجع إذ هو فيهم رصد",39,"د",1,0],["وهو عين السوى وللنور نار","هي في النشأتين ذات الوقود",40,"د",1,0],["وهُوَ على ذا ينوبُ إن سَكَتَتْ","عَنْهُ وَعَنْهُ تنوب إنْ سَكَتَا",41,"ت",2,0],["وهو عليه حاكم أمير","لواؤه من فوقه منشور",42,"ر",1,0],["وهو على ذلك من مقاله","ورأيه الفاسد وانتحاله",42,"ه",1,0],["وهو عندَ الملوكِ يُبْتَاع بالآ","لاف تبراً وقد يُبَاع بِدِرهَم",43,"م",1,0],["وَهوَ عِندَ الجَميع خَمرٌ حلالٌ","وَلَدى المُسلِمين أَيضاً حَرام",44,"م",1,0],["وَهُوَ عَلى المَعدودِ مِن ذُنوبِهِ","خَيرٌ مِنَ الصَيفِ عَلى عُيوبِهِ",45,"ه",1,0],["وهو علم التشريف علم المزايا","ليس ظنا لنا ولا استرواحا",46,"ح",2,0],["وهو عيب يغري بحبك لو أع","قل من كان ناجياً منك سالمْ",47,"م",1,0],["وهو عذري إلى جميع رفاقي","من سمير وعالم وصحافي",48,"ف",2,0],["وهو عون الدين والمولى الذي","نصر السلطان في هذا الزمان",49,"ن",1,0],["وَهوَ عَلى جَمع الدُنى منكبُّ","كَأَنَّهُ بِها معنيّ صَبُّ",50,"ب",1,0],["وَهوَ عَلى هيئته المنحرفه","يعرف في الرِياح حَقَّ المَعرفه",51,"ه",1,0],["وَهُوَ عَلَيْهِ فِي ذاكَ مُتَّكِلٌ","يَشْكُرُ إحْسَانَهُ وَيَحْمَدُهُ",52,"د",2,0],["وهو عوني إذا اضطررت سؤالا","وهو عوني إذا سئلت اضطرارا",53,"ر",2,0],["وَهوَ عَلى ما كانَ مِن ذِلَّةٍ","سُمّى بِاِسمِ المَلِكِ الأَعظَمِ",54,"م",1,0],["وَهوَ عَظيم الرأس ذو قامة","يَمشي لعمري وَهوَ مَذبوح",55,"ح",1,0],["وهو عندي ما دمت في القلب مذ","كور دواما والروح تعشق ذكره",56,"ر",2,0],["وهو عندي في صورةِ الولدِ البِر","ر وفي صورةِ الصديقِ الحميم",57,"م",1,0],["وَهوَ عَلى ظَهر الفَرَس","كَضيغم إِذا اِفتَرَس",58,"س",1,0],["وَهوَ عَن الحَي بَعيد عازب","وَالصَّخر مِن لَفح الهَجير ذائِب",59,"ب",1,0],["وَهوَ عَلَيها حذر شَفيق","ببرها وَحفظِها حَقيق",60,"ق",1,0],["وهو عذب لو ذاقه الكمد العا","شق لم يرشف الثنايا العذابا",61,"ب",2,0],["وَهوَ عَلَيك صَخره","قاسية بَل زُبرَه",62,"ه",1,0],["وَهوَ عَظيم الإثم","ما مثله مِن جرم",63,"م",1,0],["وهو على المفرد والمذكر","وعالم والعكس والمصغر",64,"ر",1,0],["وهو على قسمين ظرف الأزمنه","في الدهر يسعى ثم ظرف الأمكنه",64,"ه",1,0],["وهو على مقيد القوافي","نون بتسكين بلا خلاف",65,"ف",1,0],["وهو على قسمين مسلوبٌ عُلِم","وبعده مُسلسلٌ ايضاً فُهم",66,"م",1,0],["وَهُوَ عَلى إِرهافِهِ وَطَيِّهِ","يَقصُرُ عَنهُ المُحزَمانِ وَاللُبَب",67,"ب",1,0],["وهْو على العرش اسْتوى لا كما","تستوطن الأجسامُ فوق الرّحال",68,"ل",1,0],["وهو عن عزّ مابنوه مُحَامٍ","ولاًّعراضهم عن الذّمّ واقِ",69,"ق",1,0],["وهو على ذاك مولع أبداً","لشؤم بختي بالعض والقبل",70,"ل",1,0],["وهو عوان لم يخش من ألم ال","حمل عقيم ولم يخش من حبل",70,"ل",1,0],["وهو عندَ كلٍّ عطفُ جسمٍ وفطرةٍ","كَفُؤٌ بإحساس وميل ووجدانِ",71,"ن",1,0],["وهو عبد الرحمن محو المفدى","زاده ربه كما لا وقدرا",72,"ر",2,0],["وَهُوَ عارٌ عَلى الفَتى وَلَهُ عَن","ه إِذا أَزمَعَ الفِراقَ اِنتِهاءُ",73,"ا",2,0],["وهو على ما هو في نفسه","يحكم للأوَّل والآخر",74,"ر",1,0],["وهو على التحقيق علم به","لكنه عن علمه أنزل",75,"ل",1,0],["وهو على كل ما يريد من ال","علم بفصل الأحكام مشتمل",76,"ل",1,0],["وَهوَ عِندي أَبو شُروطِ اِقتِراح","هُوَ في العَقلِ عَقدُ بَيعٍ أَكيدِ",77,"د",1,0],["وهو على الأصح لا يذيل","إن تم أجزاءاً ولا يرفل",78,"ل",1,0],["وهو على ما صح نقلا يختلف","مسبغا أو سالما أو منحذف",78,"ف",1,0],["وهو على فعل الجميل مجتهد","وبايعوا من بعدهِ للمعتمد",79,"د",1,0],["وهو عليا قسى قلبه","مع لين عطفه وغيصانه",80,"ن",2,0],["وَهوَ عَلَى الحَدِّ آربَعَه إلاَّ رُبُع","وَنَجمُهُ الفَوقِي يَكُن في الرَّفَع",81,"ع",1,0],["وَهوَ على مَامِيَ تِسعَه فاعلَمِ","وَنِصفَ دَرِّج ذَا الخِلافَ وَافهَمِ",81,"م",1,0],["وَهوَ عَلَى الجُب سَبعَةُ ورُبعُ","فِي بَلَدِ مَلوَانَ هُوَّ الوَضعُ",81,"ع",1,0],["وهو عبد اللَه الوحيد نسيجا","في زمان له عبيد كثير",82,"ر",1,0],["وهو على ما فيه من تحري","يجوز التبيذ للتمري",83,"ي",1,0],["وهو عبوس كالفهد مجتمعٌ","يكاد من خُنْزُوانةٍ يثب",84,"ب",1,0],["وَهوَ على أربعٍ","منْ خَنثٍ يَرْقصُ كالدبّة",85,"ب",2,0],["وهو على البخت ناقة فمتى","قدمت ثوراً بفرثه شرقه",86,"ق",2,0],["وهو على عادته دائماً","يجامع الأدنثى ولا يتقي",87,"ق",2,0],["وهو على خِفَّة به أبداً","مُعترف أنَّهُ من الثُقَلا",88,"ل",2,0],["وهو على ما قيل نبتٌ ضري","وبعد أن قال اسكنا في روضكم",89,"م",1,0],["وهو على إفساده متق","ملازم والخوف من خلقه",90,"ق",2,0],["وهوَ عليه أفضلُ السلامِ","أشفَقُ من أمّ على أيتامِ",91,"م",1,0],["وهو عليه واجب الإطاعة","ما حلل اللَه له نزاعة",92,"ه",1,0],["وهوَ عليمٌ بمصيرِ الأمرِ","وما عليه في العراقِ يجري",93,"ي",1,0],["وهو عظيم الجرم ذو نور يقق","يتابع النسر اذا النسر شرق",94,"ق",1,0],["وهو على ساعد هذى الصوره","تتبعه كواكب منيره",94,"ه",1,0],["وهو على الكف من العذراء","يطلع بعد مطلع العواء",94,"ا",2,0],["وهو على أربعةٍ يفصَّل","قسم جليٌّ ظاهرٌ لا يجهل",95,"ل",1,0],["وهو عظيم في علو قدره","فكل من سواه تحت قهره",95,"ه",1,0],["وَهوَ عَلى ما فيهِ من جفوة","أَخلص أَحبابي وَخلّاني",96,"ن",2,0],["وهو على الآرام وقف فمن","أفتاه في الوقف بأن يرهنا",97,"ن",2,0],["وهو على قسمين عطف النسقِ","أي الحروف وهي في المحقق",98,"ق",1,0],["وهو علوة مرت تجر ذيولها","وهل عندها ذكرى عهود التنادم",99,"م",1,0],["وهو على المختلفات يحمل","مهما يكن عنها بما هو يسأل",100,"ل",1,0],["وهو عالمٌ بأن ليس سواهُ","وليس لي سواهُ في الذي يراهُ",101,"ه",1,0],["وهو عليه الله صلى أمَرَا","بالذكر والتقى وإخلاصٍ جرى",102,"ر",2,0],["وهو على ذُكر من الأَمير","وفُلفل وعُنق البعير",103,"ر",1,0],["وَهْوَ عِندي موسى بن عِمْران لِلْحَظْ","وةِ فيما أَنُصُّ من ديواني",104,"ن",2,0],["وَهوَ عَلى ذَيّالِكَ البَأسِ أَبى","لِقاءَ آياسَ لِذا تَنكَّبا",105,"ب",2,0],["وَهوَ عَلى قائِمَتَيهِ اِنتَصَبا","وَبِمَساميرِ النُضارِ التَهَبا",105,"ب",2,0],["وَهُوَ عَلَى وُجُوبِهِ قَد دَلاَّ","مَع كونِهِ بِالقَصدِ مَا استَقَلأ",106,"ل",2,0],["وَهوَ عَلَى مَذهبِنَا المَحمُودِ","يُوصَفُ بالحدُوثِ والوُجُودِ",106,"د",1,0],["وَهُوَ عَنِ البَحرِ مُحَمَّد حَياة","السورَتي ذي العُلومِ الباهِرات",107,"ت",1,0],["وَهُوَ عَنِ البَصَري ذي الاِمداد","أَكرَمُ بِهِ فَخذ بِذا الاِسناد",107,"د",1,0],["وَهُوَ عَنِ النَخلي رَب المُسنَد","أَحمَد شَيخ المُنتَهي وَالمُبتَدي",107,"ي",1,0],["وَهُوَ عَنِ التَقي أَي مُحَمَّد","مَروي بِعَذب العِلم نِعمَ المَورِد",108,"د",1,0],["وَهُوَ عَلاّمةُ الزَمانِ المُجلَّى","في رَفيعِ العُلومِ وَالآدابِ",109,"ب",1,0],["وَهوَ عونٌ على النوائبِ في الحق","ق ومن ذا يَفوقُه بمزيّه",110,"ي",2,0],["وهو عليه حةٌ مورودة","إن كان ذا بغيٍ وذا عدوان",111,"ن",1,0],["وَهْوَ عَلى إِخْوانهِ لَيْثُ الشَّرَى","أَغْضَبَهُ في غِيلهِ آتٍ أَتَى",112,"ا",1,0],["وَهوَ عَلى التَحقيقِ وَاللَه وَصفه","وَمِن ثمَّ كانَ الفَتحُ مِنهُ لِحَضرَتي",113,"ي",1,0],["وهو عندَ الغُصنِ فوقَ ال","غُصنِ إشراقاً ولينا",114,"ن",2,0],["وهو عين الفيض القديم ومنه","مُتعت في وجودها الأشياء",115,"ا",2,0],["وهو على عُجْبه ونخوته","ما بين جنبيه يحمل العذره",116,"ر",2,0],["وهو على ماقيل شماعة همومي ...لابلاني","صاحب(ن) ياكل يديه وهو على مذهب ...ومله",117,"ل",2,0],["وَهْوَ عَلَىٰ العَرْشِ لَهُ جِلْسَةٌ","كَجِلْسَةِ الْمُلوكِ بَيْنَ الرِّجَالْ",118,"ل",1,0],["وهو على كل شدةٍ ورخا","بألسن الخلق وهو محمود",119,"د",1,0],["وهو على صورته في الظهور","وهو على طوره في الانطوار",120,"ر",1,0],["وهو على بصيرة من أمره","منتبها يرنو لسوء المنقلب",121,"ب",1,0]]}