وَلَم يَكُن لي بِهِ يَدانِ",1,"ن",1,0],["فَبِحَمْدِي الْيَوْمَ صَارَ لَنَا","مَوْقِفٌ فِي جَانِبِ الغَرْبِ",2,"ب",1,0],["فَبِحقٍّ أقول عَمَّرَكَ اللَّ","ه طويلاً في رِفْعَةٍ وعلاءِ",3,"ا",2,0],["فبحرمتي لما استجب","تَ لجاعلي سبباً إليكا",4,"ك",2,0],["فبحقٍّ أقول إنَّ من الإحْ","سان إصلاح آلةِ الأحسان",5,"ن",1,0],["فبِحَقِّ الجَمَال يا أَيُّها الحُ","بُّ حَنَانَيْكَ بي وَهَوِّن بَلائي",6,"ي",1,0],["فَبِحُرمَةِ المَوتى وَواجِبِ حَقِّهِم","عيشوا كَما يَقضي الجِوارُ كِراما",7,"م",2,0],["فَبِحَقِّي أَهْدِ السُّرورَ إلى مَنْ","لا يَلَذّ الدُّنْيا بِغَيْرِ حُضُورِكْ",8,"ك",1,0],["فبحُرمةِ العَصْبِ الذي أُلبِستَه","ونَباهةُ الأفعال تاجُ نَبيهِ",9,"ي",2,0],["فبُحْتُ بما استودَعْتُ صَدْري من الهُوى","وباحَتْ بما استودَعْتُ منه صدورَها",10,"ر",3,0],["فَبِحَقّي أَموتُ يا مالِكَ الرِق","قِ فَاِثنِ عَنِ المُدامِ عِناني",11,"ن",2,0],["فَبِحُرمَةِ الغُرمولِ في اِستِكَ إِنَّهُ","قَسَمٌ لَهُ حَقٌّ عَلى البُغاءِ",12,"ا",2,0],["فَبِحَقّي وَحُرمَتي لا تَسُبّوا الدَه","رَ ظُلماً فَإِنَّهُ لي صَديقُ",13,"ق",1,0],["فَبِحَقّي إِلّا خَصَصتَ أَبا الطَي","يِبِ عَنّي بِطَيِّبٍ مِن سَلامي",14,"م",2,0],["فبحقّ أن يسمَّى محزناً","وبصدق أنْ يُسمَّى مُحسنا",15,"ن",2,0],["فَبِحَسبي أَنّي بِذِكرَةِ هِندٍ","هائِمُ العَقلِ دائِمُ الأَحزانِ",16,"ن",1,0],["فَبِحَمدِ الإِلَهِ إِنَّ جَميعَ ال","خَلقِ قَد كانَ بَعضُهُ قَبلُ شَذّا",17,"ذ",2,0],["فبحسبه ممّا أرادوا بذلَهُ","في المجدِ نفسُ المُتعَب المجهود",18,"د",1,0],["فَبُحْ باسْمِ من تهوى ، ودعني من الكنى","فلا خيرَ في اللذّاتِ من دونها سِتْر",19,"ر",1,0],["فَبِحَمدِ حَيِّهِمُ وَحَمدِ قَبيلِهِم","إِذ طالَ يَومُهُمُ وَعابَ العُيَّبُ",20,"ب",1,0],["فَبِحُسْنِ أَيَّةِ شِيْمَةٍ طَاحَ الرَدَى","قَبْلَ الأَوَانِ وَنُورِ أَيِّ ذَكاءِ",21,"ا",2,0],["فبحَسْبِ قدِّكِ أنْ تُسنِّدَه","هذي القلوبُ ، وإنْ شكتْ ضَعفا",22,"ف",2,0],["فبحرمتي لما استبح","ت لجاعلي سببا إليكا",23,"ك",2,0],["فبحقكم جودوا له بمراده","وتحننوا عطفاً على أحواله",24,"ل",2,0],["فبحقه وبحق أهل طريقه","وبحزبه وبجيشه وبآله",24,"ل",2,0],["فبحبه متوثق وإذا تذكر ما","طواه كتابه فنحجيل",25,"ل",1,0],["فبحسب قانون الجزاء","وحسب أحكام الخزينة",26,"ن",2,0],["فبحتَ شوقاً بذكر شوق","والجمر يذكو من الذبال",27,"ل",1,0],["فبحسن الدلال أسَّرت قلبي","وبسوء الفعال شيبت راسي",28,"س",2,0],["فبحسن وجهك كن لعرضك صائناً","عمّن يُعَرِّض عرضَه للعارِ",29,"ر",1,0],["فبحسن وجهك كن لعرضك صائناً","عمَّن يعرِّض نفسَه للعارِ",30,"ر",1,0],["فبحقه يا رب اسبابي بها","يسر وثبت بالتقى أوتادي",31,"د",2,0],["فبحر الجود قد وافاك حقا","وزادك بهجة هذا الوفاء",32,"ا",2,0],["فَبِحَقِّهِ عِنْدَكُمْ يَا مَلاَذِي","يَحْتَمِي عِرْضُنَا مِنَ الأَدْنَاسِ",33,"س",1,0],["فبحرك در لجته ثمينٌ","وغيثك ماء مزنُته طهورُ",34,"ر",1,0],["فبحق حقك برنى وامدني","بعوارف وَعَواطف وَحَنان",35,"ن",1,0],["فبحق الَّذي هَداك رأعطا","ك هدى شافيا وَقَولا ثَقيلا",36,"ل",2,0],["فَبحقه صَلوا عليه وَسلموا","قمر تفرد بالكَمال كماله",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","طلعت عَلى الآفاق شمس وجوده",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","والكون مبتهج بهاء بهائه",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","دهشته أَخطار النبوة في حرا",37,"ر",2,0],["فَبحقه صَلوا عليه وَسلموا","قال ابن نوفل ذاك يؤثر عن نبي",37,"ي",1,0],["فَبحقه صَلوا عليه وَسلموا","قالَت له فمني يَكون ظهوره",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","وَمن العلامة يوم يبعث مرسلا",37,"ل",2,0],["فَبحقه صَلوا عليه وَسلموا","طمس الضلال نور حق بين",37,"ن",1,0],["فَبحقه صَلوا عليه وَسلموا","وَقبائِل الانصار خيل جهاده",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","قبر يحط الوزر مسح ترابه",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","وَالثدى فاضكَفَيضِ نهر يمينه",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","نثر التراب عَلى رؤس الحسد",37,"د",1,0],["فَبحقه صَلوا عليه وَسلموا","ملأت محاسنه الزَمان فأفرعت",37,"ت",1,0],["فَبحقه صَلوا عليه وَسلموا","من بعد ما قد جاز سدرة منتهى",37,"ه",2,0],["فَبحقه صَلوا عليه وَسلموا","سبقت عنايته لسبق عناية",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","سل تعط يا من لَيسَ ينطق عَن هَوى",37,"ه",3,0],["فَبحقه صَلوا عليه وَسلموا","شرفت قدرك بي وضدك أَحقر",37,"ر",1,0],["فَبحقه صَلوا عليه وَسلموا","يا خير مَبعوث لا كرم أمة",37,"ه",1,0],["فَبحقه صَلوا عليه وَسلموا","وابن