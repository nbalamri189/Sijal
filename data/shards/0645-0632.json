ت ابن الفداغ نظمي","https://www.aldiwan.net/poem54065.html","مخلع البسيط"],[413,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[413,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[426,"مزاياك السنية قد تسامت","https://www.aldiwan.net/poem40848.html","الوافر"],[426,"ورق التهاني الوافيه","https://www.aldiwan.net/poem41000.html","مجزوء الكامل"],[429,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[434,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[436,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[451,"لج الحنين إليك حتى خلتني","https://www.aldiwan.net/poem61336.html","الكامل"],[451,"ماذا أصابك أيها البستاني","https://www.aldiwan.net/poem61801.html","الكامل"],[456,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[456,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[456,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[456,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[456,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[459,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[459,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16342.html","الطويل"],[462,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[462,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[466,"صف صدغا كصده","https://www.aldiwan.net/poem60221.html","مجزوء الخفيف"],[475,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[477,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[480,"وغزالة لغزالة خضعت ولكن","https://www.aldiwan.net/poem24327.html","عموديه"],[480,"نور ربي قد تجلى","https://www.aldiwan.net/poem24359.html","عموديه"],[480,"عج ساحل الدير سل عنها الشماميسا","https://www.aldiwan.net/poem24427.html","عموديه"],[498,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[498,"لله أن يختار من أحبابه","https://www.aldiwan.net/poem38096.html","الكامل"],[498,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[502,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[512,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[513,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[513,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[513,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[513,"يا ملكاً ساحة أبوابه","https://www.aldiwan.net/poem12248.html","السريع"],[536,"تجلت معاني الطعن من قدك اللدن","https://www.aldiwan.net/poem47919.html","عموديه"],[536,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[549,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[551,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[565,"صينت بمرفعها الدواة فأصبحت","https://www.aldiwan.net/poem69518.html","الكامل"],[565,"مزاجك للمثنى من العود والصبا","https://www.aldiwan.net/poem69689.html","الطويل"],[565,"مزجت دموع العين من","https://www.aldiwan.net/poem69821.html","مجزوء الكامل"],[573,"ومخيم بين الحشا وشغافه","https://www.aldiwan.net/poem2911.html","الكامل"],[573,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"],[573,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[584,"طرف تعرض بعدكم لهجوع","https://www.aldiwan.net/poem17592.html","الكامل"],[584,"إن تبدوا أو تثنوا","https://www.aldiwan.net/poem17813.html","مجزوء الرمل"]],"verses":[["مَزبورَةٌ تُطوى عَلى أَشطارِها","يُبطَنُ باديها وَيَبدو ما بَطَن",0,"ن",1,0],["مُزاحِمٌ يَقذِفُ في","يَومِ الحِصابِ جَلمَدا",1,"د",2,0],["مَزِقَ الجِلدِ يُرى القَل","بُ مِنَ الجُرحِ الرَغيبِ",2,"ب",1,0],["مَزَجنا دِماءً بالدُّموعِ السَّواجِمِ","فَلَم يَبقَ مِنّا عَرصَةٌ لِلمَراحِمِ",3,"م",1,1],["مُزْنٌ إذا هزَّ فيهِ البَرقُ مُنْصُلَهُ","عَلا منَ الرّعْدِ في حَضْنَيْهِ إرْنانُ",4,"ن",1,0],["مِزاجُ كَأسي في نَدامايَ مِن","دُموعِ عَينٍ بِالبُكا هامِلات",5,"ت",1,0],["مُزْنٌ مذْ حلّ بِبَسْكَرَةٍ","يوْماً نطَقْتُ بمُصَحَّفِها",6,"ف",3,0],["مَزْبَلَةٌ قَدْ فُتِّحَتْ فَوْقَهَا","ثِنْتَانِ مِنْ نَوَّارِ كَتَّانْ",7,"ن",1,0],["مَزَايَا النَّخْلِ يَوْمَ الْفَخْرِ مِماَّ","تَسَاوَى الشَّيْخُ فِيهِ وَالْغُلاَمُ",8,"م",1,1],["مَزِّقْ جُفُونَ الْبِيضِ عَنْ أَلْحَاظِهَا","لِتَسِيْلَ فَوقَ شِفَارِهَا الحَوْبَاءُ",9,"ا",2,0],["مُزَينَةُ مِنهُمُ وَبَنو غِفارٍ","وَأَسلَمُ أُضعِفوا مَعَهُ بَلِيّا",10,"ي",2,0],["مزَّقتَ منه أديماً حَشُوه هِمَمٌ","في ذِمّةِ اللهِ عاليها وماضِيها",11,"ي",3,0],["مَزيدٌ في بَنيهِ كَواوِ عَمروٍ","وَمُلغى الحُكمِ فيهِ كَراءِ واصِل",12,"ل",1,0],["مِزَقاً تُطَرِّدُها الرِياحُ","كَأَنَّها خِرَقٌ طَرائِد",13,"د",1,0],["مَزْهُوَّةً بِالزَّائِرِينَ أُولى التُّقَى","وَالعِلْمِ وَالإقْدَامِ وَالإِحْْسَانِ",14,"ن",1,0],["مُزِيلَةٌ لِلْهُمُومِ بَاعِثَةٌ","مِنَ الرُّكُودِ المُذِيلَ لِلْهِمَمِ",15,"م",1,0],["مُزِّقَ عَن ضَبابِهِ سُرادِقُه","وَاِنجابَ عَن ثَوبِ الظَلامِ غاسِقُه",16,"ق",2,0],["مُزَينَةُ لا يُرى فيها خَطيبُ","وَلا فَلجٌ يُطافُ بِهِ خَصيبُ",17,"ب",1,1],["مزجتُ بتذكار العقيق بكائي","وطارحتُ معتلَّ النسيم بدائي",18,"ي",1,1],["مزجت بنطقِي في الورى وجوارحِي","فلأشكرَنَّك ما حييتُ وإن أمت",19,"ت",1,0],["مزجنا بحور الفضل والشعر بيننا","فها نحنُ في هذا وذا نتبختر",20,"ر",1,0],["مزجت يا بحرُ بحرَيها فذاك وذا","عذب على أنه للدّرّ ألفاظ",21,"ظ",1,0],["مُزِجَت روحُكَ في روحي كَما","تُمزَجُ الخَمرَةُ بِالماءِ الزُلالِ",22,"ل",1,1],["مَزَجْتُ خمرة عينيها بريقتها","كيما تُكفكف عني من حُمَيَّاها",23,"ه",2,1],["مُزمَّمَةُ الأواخرِ سائرات","على أصلابها شَبَهَ الدبيبِ",24,"ب",1,0],["مُزِجَ القبحُ كلُّهُ","فيك بالمقْت فامْتَزَجْ",25,"ج",1,0],["مَزَرُّ سحيقِ الورس فوق صلاءةٍ","أدبَّ عليها دارجُ الذرِّ أكرعا",26,"ع",2,0],["مَزِينٌ بسربالٍ من الريش ناصع","له زبرج يحكي الثغام المترَّعا",27,"ع",2,0],["مُزنٌ يُمِطنَ الريَّ عن أفواهنا","ويَجُدن للأبصار بالإبراق",28,"ق",1,0],["مَزَّقتَ جَمعَهُمُ تَمزيقَ مُقتَدِرٍ","عَلى المُهَنَّدِ بَعدَ اللَهِ يَتَّكِلُ",29,"ل",1,0],["مَزَّقتُمُ أَقسامَكُم وَعُهودَكُم","وَلَقَد تَكونُ كَأَنَّها التَنزيلُ",30,"ل",1,0],["مَزَّقَ الفَجرُ جَلابيبَ الدُجى","وَمَحا مِن صَفحَةِ الأَرضِ الرُسوم",31,"م",1,0],["مَزائِدُ خَرقاءَ اليَدَينِ مُسيفَةٍ","أَخَبَّ بِهِنَّ المُخلِفانِ وَأَحفَدا",32,"د",2,0],["مُزَعزَعُ أَجيالٍ وَغاشي مَعاقِلٍ","وَقائِدُ جَرّارٍ وَمُزجي عَرمرَمِ",33,"م",1,0],["مُزبِداً ثائِرَ اللُجاجِ كَجَيشٍ","قَوَّضَ العاصِفُ الهَبوبُ خِيامَه",34,"م",2,0],["مَزَّقَت تاجَهُ الخُطوبُ وَأَلقَت","في التُرابِ الَّذي أَرى صَولَجانَه",35,"ن",2,0],["مَزَّقتُمُ الوَهمَ وَأَلِفتُمُ","أَهِلَّةَ اللَهِ عَلى صُلبِهِ",36,"ب",2,0],["مَزَّقَت جَمعَهُم عَلى كُلِّ أَرضٍ","مِثلَما مَزَّقَ الظَلامَ الضِياءُ",37,"ا",2,0],["مزج الرصاص به فأن","جبَ وهو نعم الوالدُ",38,"د",1,0],["مزج الرصاص به فأصلحه","وكساه لوناً منه مؤتلقا",39,"ق",2,0],["مزاريق تبرٍ ترامتْ بهَا","بنو الحربِ في حومةِ الوقعَهْ",40,"ع",2,0],["مَزَّقتَ أَنفُسَهُم بِقَلبٍ واحِدٍ","جُمِعَت قَواصيهِ وَسَيفٍ أَوحَدِ",41,"د",1,0],["مُزايِدُ نَفسٍ في تُقى اللَهِ لَم تَدَع","لَهُ غايَةً في جِدِّها وَاِجتِهادِها",42,"د",3,0],["مُزاوِلَةٌ أَن تَخلِطَ الوُدَّ بِالقِلى","وَمُزمِعَةٌ أَن تُلحِقَ القُربَ بِالبُعدِ",43,"د",1,0],["مُزايَدَةً مِنّي وَمِنهُ وَكُلُّنا","إِلى أَمَدٍ وافي النَصيبِ مِنَ البُعدِ",43,"د",1,0],["مَزَجنا كُؤوسَ الهَوى مَرَّةً","بِتِلكَ العُيونِ وَتِلكَ الخُدودِ",44,"د",1,0],["مُزعَجاً بِالفِراقِ عَن أُنسِ إِلفٍ","عَزَّ أَو مُرهَقاً بِتَطليقِ عِرسِ",45,"س",1,0],["مُزنَةٌ حينَ خَيَّلَت","آذَنَت بِالتَكَشُّفِ",46,"ف",1,0],["مُزَيِّلَةٌ شَعبي وَشَعبَ أَصادِقي","وَداخِلَةٌ بَيني وَبَينَ شَقيقي",47,"ق",2,0],["مَزَجتُ الراحَ مِن فيهِ","بِمِثلِ الراحِ أَو أَفضَل",48,"ل",1,0],["مزقوا جبة الدراويش عنكم","واخلعوا الصوف أيها الأتقياء",49,"ا",2,0],["مَزَجْنَ له عَذْبَ الهَوى بمَرارَةٍ","يُج