73.html","البسيط"],[48,"الجسم مني سقيم شفه النصب","https://www.aldiwan.net/poem10808.html","البسيط"],[48,"وعقار كأنما نتعاطى","https://www.aldiwan.net/poem62484.html","الخفيف"],[48,"لا تبك رسما بجانب السند","https://www.aldiwan.net/poem62559.html","المنسرح"],[48,"وقهوة عتقت في دير شماس","https://www.aldiwan.net/poem63421.html","الطويل"],[48,"خبز إسماعيل كالوشي","https://www.aldiwan.net/poem64409.html","مجزوء الرمل"],[48,"لو كنت تعشق درا ما سألتهم","https://www.aldiwan.net/poem66103.html","البسيط"],[48,"يا كثير النوح في الدمن","https://www.aldiwan.net/poem66134.html","المديد"],[76,"ألما على قصر الخليفة فانظرا","https://www.aldiwan.net/poem39323.html","الطويل"],[76,"صدعت قلبي صدع الزجاج","https://www.aldiwan.net/poem39471.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85498","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20993","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54940","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55025","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55058","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[77,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[91,"الضفادع والنجوم","https://www.poetsgate.com/ViewPoem.aspx?id=53280",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[29,"ومحبوسة ٍ في الحيّ ضامنة ِ القرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17428&r=&rc=1",""]],"verses":[["مَزبورَةٌ تُطوى عَلى أَشطارِها","يُبطَنُ باديها وَيَبدو ما بَطَن",0,"ن",1,0],["مُزاحِمٌ يَقذِفُ في","يَومِ الحِصابِ جَلمَدا",1,"د",2,0],["مَزِقَ الجِلدِ يُرى القَل","بُ مِنَ الجُرحِ الرَغيبِ",2,"ب",1,0],["مَزَجنا دِماءً بالدُّموعِ السَّواجِمِ","فَلَم يَبقَ مِنّا عَرصَةٌ لِلمَراحِمِ",3,"م",1,1],["مُزْنٌ إذا هزَّ فيهِ البَرقُ مُنْصُلَهُ","عَلا منَ الرّعْدِ في حَضْنَيْهِ إرْنانُ",4,"ن",1,0],["مِزاجُ كَأسي في نَدامايَ مِن","دُموعِ عَينٍ بِالبُكا هامِلات",5,"ت",1,0],["مُزْنٌ مذْ حلّ بِبَسْكَرَةٍ","يوْماً نطَقْتُ بمُصَحَّفِها",6,"ف",3,0],["مَزْبَلَةٌ قَدْ فُتِّحَتْ فَوْقَهَا","ثِنْتَانِ مِنْ نَوَّارِ كَتَّانْ",7,"ن",1,0],["مَزَايَا النَّخْلِ يَوْمَ الْفَخْرِ مِماَّ","تَسَاوَى الشَّيْخُ فِيهِ وَالْغُلاَمُ",8,"م",1,1],["مَزِّقْ جُفُونَ الْبِيضِ عَنْ أَلْحَاظِهَا","لِتَسِيْلَ فَوقَ شِفَارِهَا الحَوْبَاءُ",9,"ا",2,0],["مُزَينَةُ مِنهُمُ وَبَنو غِفارٍ","وَأَسلَمُ أُضعِفوا مَعَهُ بَلِيّا",10,"ي",2,0],["مزَّقتَ منه أديماً حَشُوه هِمَمٌ","في ذِمّةِ اللهِ عاليها وماضِيها",11,"ي",3,0],["مَزيدٌ في بَنيهِ كَواوِ عَمروٍ","وَمُلغى الحُكمِ فيهِ كَراءِ واصِل",12,"ل",1,0],["مِزَقاً تُطَرِّدُها الرِياحُ","كَأَنَّها خِرَقٌ طَرائِد",13,"د",1,0],["مَزْهُوَّةً بِالزَّائِرِينَ أُولى التُّقَى","وَالعِلْمِ وَالإقْدَامِ وَالإِحْْسَانِ",14,"ن",1,0],["مُزِيلَةٌ لِلْهُمُومِ بَاعِثَةٌ","مِنَ الرُّكُودِ المُذِيلَ لِلْهِمَمِ",15,"م",1,0],["مُزِّقَ عَن ضَبابِهِ سُرادِقُه","وَاِنجابَ عَن ثَوبِ الظَلامِ غاسِقُه",16,"ق",2,0],["مُزَينَةُ لا يُرى فيها خَطيبُ","وَلا فَلجٌ يُطافُ بِهِ خَصيبُ",17,"ب",1,1],["مزجتُ بتذكار العقيق بكائي","وطارحتُ معتلَّ النسيم بدائي",18,"ي",1,1],["مزجت بنطقِي في الورى وجوارحِي","فلأشكرَنَّك ما حييتُ وإن أمت",19,"ت",1,0],["مزجنا بحور الفضل والشعر بيننا","فها نحنُ في هذا وذا نتبختر",20,"ر",1,0],["مزجت يا بحرُ بحرَيها فذاك وذا","عذب على أنه للدّرّ ألفاظ",21,"ظ",1,0],["مُزِجَت روحُكَ في روحي كَما","تُمزَجُ الخَمرَةُ بِالماءِ الزُلالِ",22,"ل",1,1],["مَزَجْتُ خمرة عينيها بريقتها","كيما تُكفكف عني من حُمَيَّاها",23,"ه",2,1],["مُزمَّمَةُ الأواخرِ سائرات","على أصلابها شَبَهَ الدبيبِ",24,"ب",1,0],["مُزِجَ 