{"poems":[[9,"من ديار بالهضب هضب القليب","https://www.aldiwan.net/poem21913.html","الخفيف"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[58,"يا بكر ما فعلت بك الأرطال","https://www.aldiwan.net/poem58518.html","الكامل"],[82,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[50,"يا دار ما فعلت بك الأيام","https://www.aldiwan.net/poem65255.html","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56569","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132308","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74171","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85237","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95002","الكامل"],[4829,"غاروا علي القوم","https://www.poetsgate.com/ViewPoem.aspx?id=34262",""]],"verses":[["عِرمِسٍ بازِلٍ تَخَيَّلُ بِالرِد","فِ عَسوفٍ مِثلِ الهِجانِ السَيوبِ",0,"ب",1,0],["عِرمِسٌ تَرجُمُ الإِكامَ بِأَخفا","فٍ صِلابٍ مِنها الحَصى أَفلاقُ",1,"ق",1,0],["عَرِمَ الزَّمانُ على الدِّيارِ بِرَغْمِهِمْ","وعليكَ أيضاً للزَّمانِ عُرَامُ",2,"م",1,0],["عَرَمْرَمٌ مُقْدم الفرسانِ تحْسَبُهُ","سَيْلاً يُحَدّثُ عمّا فَجّرَ العَرِمُ",3,"م",1,0],["عَرمرَمٌ يَنسِفُ الأَرضَ الفَضاءَ إِذا","سَرى بِها وَيَدُكُّ الهَضبَ مِن خِيَمِ",4,"م",1,0],["عَرَمَ الزَمانُ عَلى الَّذينَ عَهِدتُهُم","بِكِ قاطِنينَ وَلِلزَمانِ عُرامُ",5,"م",1,0],["عرمت عرام الدهر جاشت صروفه","وهل يستذل الدهر والدهر عارم",6,"م",1,0],["عَرَمرَمُ عَادِيَّات قَارِعَة لَهُ","تَكَاثرُ عَصراً فيهِ وَيلُ المُحارِبِ",7,"ب",1,0],["عَرَمرم كَزهاء اللَيل منسدل","اللَه بِالنَصر وَالتَوفيق يكرمهم",8,"م",1,0],["عرمرم جيش سيق من مصر معنفاً","يهتك أستار النساء ويعتدِ",9,"د",1,0],["عَرَمان تبكي بالدماء حبيبها","حتى ارتوى وجه الثرى بدمٍ صبيب",10,"ب",1,1],["عرمرمي لو سال قشّع بيوتهم","ياويلهم من هدرة السيل عارمه",11,"م",2,0]]}