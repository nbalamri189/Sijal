{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[242,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[358,"إذ زرت من يستثقلوا منك جانبا","https://www.aldiwan.net/poem39579.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130203","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66252","الرجز"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101813","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94217","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132605","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89319","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109929","البسيط"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131343","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47068","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4444,"فديتك لو لم تكن لي قريبا","https://www.poetsgate.com/ViewPoem.aspx?id=85444",""],[5956,"إخلاصه الجم يسقي حقل موهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=193723",""],[5956,"إذْ زار بيتي مصطفى الميمون","https://www.poetsgate.com/ViewPoem.aspx?id=207346",""]],"verses":[["إذ زوجوها من فتى","ما إن رأته وَلا رآها",0,"ا",3,0],["إِذْ زِيدَ مَصْدَرُ زَادَ وَالتَّذْيِيلُ لِل","تَّكْثِيرِ فِي مَعْنَاهُ بِالْبُرْهَانِ",1,"ن",1,0],["إِذ زُرت مَن يَستثقلوا مِنكَ جانِباً","فَجانِبهُمُ وَاِربأ بِنفسك ذاكيا",2,"ي",2,1],["إذ زاد في المد وزاد أيضا","في مسجد النبي قالوا أرضا",3,"ض",2,0],["إذ زارني رشأ تفرد بالبها","ما كان ينجز لي بأدني وعده",4,"د",2,0],["إذ زحفت بحدِّها المُفَلّلِ","تَقْضِي على العِيَانِ بِالتّخَيُّلِ",5,"ل",1,0],["إذ زفت الشمس إليه مثلما","لجده رُدت بلا ترددِ",6,"د",1,0],["إذ زارني المولى الرضا","والفضل بين الناس له",7,"ل",2,0],["إذ زوج البدر شمس الحسن وابتهجت","كل الأنام بهذا الطالع النامي",8,"م",2,0],["إذ زينت طرّة غرّة","فذي غرر زينتها طرر",9,"ر",1,0],["إذ زين الدين والدنيا بدولته","دامت وقالت له هنيت فاحتكم",10,"م",1,0],["إذ زاد عن إبيلس أعلى درجهْ","قف واستمع في وصفِه مُزدوجه",11,"ه",1,0],["إِذ زالَ منهم قضيبُ المُلكِ مُنتَزِعاً","ولم تَعُد لَهُمُ ايضاً مقالِدُهُ",12,"د",2,0],["إذْ زار بعدَ إطالةِ ال","هِجْرانِ في ليلٍ قصيرِ",13,"ر",1,0],["اذ زارني كالبدر في سجف الصدق","فجاءة وهكذا البسط صدف",14,"ف",1,0],["إذ زاده ما زانَه","كيما يعز وكي يجل",15,"ل",1,0],["إذ زماني غرُّ وغصني رطيب","وشبابي غض وبردي قشيب",16,"ب",1,0],["اذ زارت الشاة ذئباً طبيبا","فلا تأمنن على الشاة ذيبا",17,"ب",2,0],["إذْ زرتُ والده والدهر يشهد لي","أزاح أنفي عن الأدرانِ للعبقِ",18,"ق",1,0],["إذْ زار بيتي مصطفى الميمون","معه ابنتي آن الحنون تعينُ",19,"ن",1,1]]}