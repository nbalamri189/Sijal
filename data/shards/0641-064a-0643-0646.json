{"poems":[[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[82,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202700","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21108","الرمل"],[146,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[182,"لعل وعسى","https://www.aldiwan.net/poem50717.html","الرمل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[463,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88624","الكامل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31636","المنسرح"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141286","الوافر"],[1787,"","https://poetry.dctabudhabi.ae/diwan/poem/105105","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200092",""],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97989","المجتث"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67984","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82827","الكامل"],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5404,"ما لوحش الحفرة من مصرع","https://www.poetsgate.com/ViewPoem.aspx?id=186636",""]],"verses":[["في كِنِّ أَرطَاتِه يَلُوذُ بِها","ضَيفاً قِرَاهُ السُّهضادُ والوَصَبُ",0,"ب",1,0],["في كنّ ارطاته يلوذ بها","ضيفا قراه السهاد والوصب",1,"ب",1,0],["في كُنْهِ قَدْرِكُ للعقولِ تَحَيّرُ","فَلِذاكَ عنه النَيّرَاتُ تُقَصّرُ",2,"ر",1,1],["فيك ناغينا الهوى فى مهده","ورضعناه فكنتَ المرضعا",3,"ع",2,0],["في كِنَاسٍ ظاهِرٍ يَستُرُهُ","مِن عَلُ الشَّفَّانِ هُدَّابُ الفَنَن",4,"ن",1,1],["في كِناس الأَرْطَى شبيهةُ لعسا","ءَ حَماها العفافُ مثلَ الحُجْبِ",5,"ب",1,0],["فيكِ نثراً أبتَثيّاتي احتفَتْ","ورويُّ الشِّعرِ منكِ انبجَسا",6,"س",2,0],["فيكن غانم والا","فسالم لا جراحات",7,"ت",1,0],["فيكنّ مَن حشوُ جلابيبه","أهيفُ راوي الرِّدف ظامي الحشا",8,"ا",1,0],["فيكن يا ظبيات حاجر","سهرت قلوب لا محاجر",9,"ر",1,1],["في كَنَفِ اللهِ ظاعِنٌ ظَعَنا","أَوْدَعَ قَلْبي وَداعُهُ حَزَنَا",10,"ن",2,1],["فيك نارٌ وبصدري مثلها","وكلا النّارين تزداد التهابا",11,"ب",2,0],["فيك نهني العيد يابن الألى","سموا سماء المجد دون الرجال",12,"ل",1,0],["فيك نوم وفيك عربدة","فلقد أسكرتْك أحلام",13,"م",1,0],["فيك نعم فيك شورٌ","ومغريات كثيره",14,"ر",2,0],["فِي كَنْفِكَ اليومَ مأسوراً وَقَدْ سَلَفت","أيامُ أَسرِك لما كنتِ فِي كَنَفه",15,"ف",2,0],["في كُنهِها الإِدراكَ ضاع","إِذ لَم يَسَعها عَقلُنا",16,"ن",2,0],["فِيِكَ نَهْجِي وَاعْتِزَازِي","فِيِكَ عُمْرِي فَاحَ عِطْرَا",17,"ر",2,0],["في كنف الله وفي حفظه","وفي المحل الأرفع الأوسع",18,"ع",1,0]]}