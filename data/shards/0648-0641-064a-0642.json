,"https://www.poetsgate.com/ViewPoem.aspx?id=208747",""],[4999,"قدميّ أمي","https://www.poetsgate.com/ViewPoem.aspx?id=184282",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5121,"رَيَّانَةُ الدِّبْسِ / إبنتي حنين","https://www.poetsgate.com/ViewPoem.aspx?id=49548",""],[5136,"بروحي طيفاً أتى في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=121707",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5269,"يا أَوس ما طلعت شمسٌ ولا غربتْ","https://www.poetsgate.com/ViewPoem.aspx?id=81493",""],[5277,"أهل قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185166",""],[5277,"بيتُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=190995",""],[5277,"شظفُ المنافي","https://www.poetsgate.com/ViewPoem.aspx?id=203512",""],[5277,"شعارُ الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=204180",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5411,"رِسالَتك الوَحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185460",""],[5413,"أسيرُ همومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201522",""],[5431,"اثم المجرة ...","https://www.poetsgate.com/ViewPoem.aspx?id=202563",""],[5459,"رقصنا","https://www.poetsgate.com/ViewPoem.aspx?id=190907",""],[5470,"الليل والشجن","https://www.poetsgate.com/ViewPoem.aspx?id=10906",""],[5539,"مجتمعنا","https://www.poetsgate.com/ViewPoem.aspx?id=193725",""],[5690,"تسامت بك الدنيا فأنت أميرُها","https://www.poetsgate.com/ViewPoem.aspx?id=172156",""],[5690,"أجبرت بك الدنيا فأنت مجيرها","https://www.poetsgate.com/ViewPoem.aspx?id=172135",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5829,"فتاة السكر","https://www.poetsgate.com/ViewPoem.aspx?id=210632",""],[6134,"الا ذا الجمال اليوم اصبح مهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=169554",""]],"verses":[["وَفِي قِبَابِ قُبا قاَمَتْ لَنَا بِقَبَا","طِرَازُهَا مذْهَبٌ فِي حُسْنِ تَزْيِينِ",0,"ن",1,0],["وَفي قَصرِ حَجرٍ مِن ذُؤابَةِ عامِرٍ","إِمامُ هُدىً مُستَبصِرُ الحُكمِ عادِلُه",1,"ل",2,0],["وَفي قُضاعَةَ بَيتٌ غَيرُ مُؤتَشَبٍ","نِعمَ القَديمُ إِذا ما حُصِّلَ القِدَمُ",2,"م",1,0],["وفي قلبه داءٌ دفين من الأسى","فلا غروَ أن يبكي لأجل دفينه",3,"ن",2,0],["وفي قُطربُّلٍ أطلالُ مغنىً","بهن ملاعبُ الظبي الرَّبيبِ",4,"ب",1,0],["وفي قُبْحها كافٍ لها من كِيَادها","ولكنها في فعلها تتبرَّدُ",5,"د",1,0],["وَفي قَبضِ كَفِ الطّفلِ عِندَ وَلادِهِ","دَليلٌ عَلى الحِرصِ المُرَكَّبِ في الحَيِّ",6,"ي",1,1],["وفي قضُب الخطّي يهتزّ حولها","مَشابهُ من أعطافها وشواكل",7,"ل",1,0],["وفي قلبهِ أعينٌ ثَرَّةٌ","بها النارُ طاغية العنفوانْ",8,"ن",1,0],["وفي قلبه ندم يستقي","دماه وفي حزنه يرتعي",9,"ع",2,0],["وَفِي قَصْرِ حَجْرٍ مِنْ ذُؤَابَة ِ عَامِرٍ","إمامُ هدى ً مستبصرُ الحكمِ عاملهْ",10,"ل",2,0],["وفي قرلق طه وبياضة السنى","بها لبهاء الدين قد لألأ السعد",11,"د",1,0],["وفي قَلبي مَحَبَّتِكِ التى لاَ","يُعَبِّرُ عن حَقِيقَتِهَا لِسني",12,"ن",2,0],["وفي قوله اذكرني لساقي مليكه","دليلٌ لمن في الصالحات له عزم",13,"م",1,0],["وفي قاضي القضاة عيوب سوء","تمعزل واستحل المال غاره",14,"ر",2,0],["وفي قلبي من الهجرانِ سقمٌ","وفي كبدي من الأشواقِ داءُ",15,"ا",2,0],["وَفي قُطر مِصرٍ كَم تَذَكَّرتَ زَحلَةً","فَأَبكاكَ بردونيَّها ذلِكَ القُطرُ",16,"ر",1,0],["وفي قدر ما أنهى إليك كفاية","عن الجهر ان الستر أليق بالحر",17,"ر",1,0],["وفي قدحٍ من البلَّورِ طابت","فتِلكَ نفيسةٌ تَهوى النَّفيسا",18,"س",2,0],["وَفي قعار جناب ما نزلت به","الا أَممنت أَمان الصيد في الحرم",19,"م",1,0],["وَفِي قُرْبِهِ الزُّلْفى وَفِي نَيْلِهِ الْعُلى","وَفِي حُكْمِهِ الْبُقْيا وَفِي ظِلِّهِ الْيُسْرا",20,"ر",2,0],["وَفي قلبي حسيسُ لظى","فهل أحسستِ في قلبكْ",21,"ك",1,0],["وفي قربهم أنسى وروحي وراحتي","ولست بشيء إن بلوني بالبعد",22,"د",1,0],["وفي قصة الأطيار وهي عجيبة","وكم من أمور في الوجود عجيبة",23,"ه",1,0],["وفي قرارة نفسي","ام في سماء خيالي",24,"ل",2,0],["وَفي قِبابِ الصينِ أَيُّ قُبَّةٍ","شَيَّدَها لِبَهمَنٍ مَنو شَهَر",25,"ر",1,0],["وَفي قُربِكَ لي بُعدٌ","وَعَن أُنسٍ وَعَن جانِ",26,"ن",1,0],["وفي قدومك ما تمَّ السرور به","وربَّما غابت الأَقمار أحيانا",27,"ن",2,0],["وفي قلوبِ أُناسٍ من صَفاتِكُما","نارٌ وفي أَعْيُنٍ من مَعْشَرٍ نُورُ",28,"ر",1,0],["وَفِي قاضِي القُضاةِ قَضَاءُ حَقٍّ","لِمَنْ يرعاهُمُ راعِي الرِّعاءِ",29,"ا",2,0],["وفي قول نيات","وفي عمل وعن كذب",30,"ب",1,0],["وفي قومها من فارسٍ للسانها","عدوٌّ فسل في قيصرٍ مَن نصيرُها",31,"ر",3,0],["وفي قعره شخصان بعل وحامل","أتاها مخاض مؤذنا بالمضائق",32,"ق",1,0],["وفي قمَّةِ المجد المنيع منابرٌ","وفي ساحة العزِّ الرفيع مساجدُ",33,"د",1,0],["وَفي قسم المَولى لَهُ بِحياتِهِ","آجل نَظراً تَلقاهُ أَوفرهم قَسما",34,"م",2,0],["وفي قلبه مَلِكٌ جائرْ","وفي خِصْرِه خَاتَمٌ جَائِلُ",35,"ل",1,0],["وفي قلة في أهل دين محمد","ذوي الصدق في يوم الوغى والتجالد",36,"د",1,0],["وفي قوة الوهم المحيط جميعه","فكلٌ ترى بالكشف في قيده رَهنا",37,"ن",2,0],["وفي قوله إن قال لله فاستمع","فلا تقطعن حبل التواصل تنقطع",38,"ع",1,0],["وَفي قَلبه المَعمور بِالعَفو رَأفةٌ","طَبيعية مِنها تُسَرُّ الخَواطر",39,"ر",1,0],["وفي قَيِّمَ الرّاحِ مِنْ سِحْرِهِ","خَوَاطرُ وَلَّهَتِ الخاطِرَا",40,"ر",2,0],["وَفي قَتلي فَأَحسِن في قَضاءٍ","خِيارُ النّاسِ أَحسَنُهم قَضاءا",41,"ا",3,0],["وَفي قَدِّهِ كَالرّمحِ يَطعَنُ مُهجَتي","وَإِنّي بِهِ المَقتولُ مِن غَيرِ ما شَكِّ",42,"ك",1,1],["وفيقْ عن سحبِ أذيالَكْ وأردانكْ","وتُوبْ مِنْ قبل تِيْبَسْ منكَ عيدانكْ",43,"ك",1,0],["وفي قباب قباء والمدينة ما","بالقلب والجسم من عيّ وإعياء",44,"ا",2,0],["وفي قتادة لما رد مقلته","إظهار ما حمدت للعين عقباه",45,"ا",2,0],["وفي قتادة والعرجون كم ظهرت","مظاهر ليس تخفيها التحاييل",46,"ل",1,0],["وفي قريظة والأحزاب كم ظهرت","وفي هوازن للهادي أفاعيل",46,"ل",1,0],["وفي قرب سلمان وبعد أبي لظى","وزوجته تاييد كل متابع",47,"ع",1,0],["وفي قرب سلمان وبعد أبي لظى","سرور لبيب لم يكن يتجهم",48,"م",1,0],["وفي قتادة والعرجون معتمد","لمبصر عنه لم تخف الإشارات",49,"ت",1,0],["وفي قريظة والأحزاب كم ظهرت","وفي تبوك له بالفتح حالات",49,"ت",1,0],["وفي قتادة والعُرجون معتبر","لمبصر لم يزغ بل لاذ واعتصما",50,"م",2,0],["وفى قُتَرِ الناموسِ تحت صفيحه","أَخو قَنَصٍ للهاديات كلومُ",51,"م",1,0],["وفي قلب ملك الروم ما لو رمى به","مناكب ليل أسلمته كواكبه",52,"ب",2,0],["وفي قاسم الخيرات لي خير قسمةٍ","بلغت بها أقصى الأماني والوطرْ",53,"ر",1,0],["وفي قربنا يا سيدي حسن حالنا","وكيد عدانا والحماية والولا",54,"ل",2,0],["وفي قلبه ثورة الساخطين","على شرعة الظلم والظالم",55,"م",1,0],["وفي قبة الشيخ الشطاويِّ كرّروا","حديث غرامي فهو يملأها عطرا",56,"ر",2,0],["وفي قد كان حديثنا استمر","حتى دنا السير ووقته حضر",57,"ر",1,0],["وفي قطع ثدي الخود عشر قلائص","وللرجل خمسٌ ما شجا الصب منزلُ",58,"ل",1,0],["وفي قول خير الخلق طه بشارة","لراء لرائي الذائقين توسلا",59,"ل",2,0],["وَفي قَلبي شِهابُ أَسىً وَوَجدٍ","زَكيٌّ مِن فَتاةِ بَني شِهابِ",60,"ب",1,0],["وَفِي قَلعَةِ الجِسرِ قَومٌ تَدُوسُ","قَرِيباً جَباهَهُمُ الأَرجُلُ",61,"ل",1,0],["وفي قبضة الرحمن كانت ذواتنا","مع الحدثِ المرئيّ والقابضُ الله",62,"ل",2,0],["وفي قمع أهواء النفوس اعتزازها","وفي نيلها ما تشتهي ذل سرمدي",63,"د",2,0],["وفي قلعة السلطان وهي بعيدة","عن النيل ولوا ينظرون لها شزرا",64,"ر",2,0],["وَفي قِيَاسٍ وَاحِدٍ سَبعَه","في جَاهِ سَبعَه يا لَهَا مِن صَنعَه",65,"ه",1,0],["وفي قوله لبيك ارقى تواضعا","كذا قوله للشخص من صولة الجبر",66,"ر",1,0],["وفي قوله للأم اكبر عبرة","عنيت بتلك الام بنت ابى بكر",66,"ر",1,0],["وفي قصة الدجال اذ جاءه الذي","غدا سائلا عن اكل زاد مع الكفر",67,"ر",1,0],["وفي قدم والغرب منهم وفارس","نعم وخوارزم كرام أراوع",68,"ع",1,0],["وفي قدر الرحمن كل عجيبة","حبالي ليالينا بها لم تبكر",69,"ر",1,1],["وفي قرى المدن غانيات","سترن تحت النقاب عابا",70,"ب",2,0],["وَفي قريظة إِذا كانوا ثَمانية","مِن المِئات عَلا لباتهم وَفَرى",71,"ر",2,0],["وفي قسمة الأرزاق عدل وإنما","هنالك سرّ في السماء وطلسم",72,"م",1,0],["وفي قلبيه المقهور نفس نبية","تحدّث عن سر القضا وتترجم",72,"م",1,0],["وَفي قَعرِ الكِنانَةِ مُرهَفاتٌ","كَأَنَّ ظُباتِها شَوكُ السِبالِ",73,"ل",1,0],["وفِي قَبُول الخلقِ أوقَى دَلِي","لِ في قَبُولِ اللهِ كُلَّ اقتِدَاح",74,"ح",1,0],["وفي قُلَلِ الأجبال خلَف مُقطَّم","زَبرجَدُ أملاك الوَرَى ساعةَ الحشدِ",75,"د",1,0],["وفي قَصِّ هُدَّابٍ وإحفاء شاربٍ","وكَوْرٍ على شَيبٍ يُضيء لناظِرِ",76,"ر",1,0],["وفي قفاك اكتب به يا هَيْ بَلَمْ","قصائد الأولاد والنسوانِ",77,"ن",1,0],["وفي قل تعالوا ىيةٌ لاتحاده","بطاها استنارت عند أهل البصار",78,"ر",1,0],["وفي قَلبِهِ رَفَثٌ بَيِّنٌ","إذا صَحَّفُوهُ لِمَن يَنظُرُ",79,"ر",1,0],["وفي قتل قابيل أخاه لعبرة","لمن كان عنه لبّه غير نازح",80,"ح",1,0],["وفي قلبهِ فعلٌ وحرفٌ كِلاهما","لهُ عَمَلٌ فيهِ بإِلزام حَدِّهِ",81,"د",2,0],["وفي قلبِهِ داءٌ يَعِزُّ لهُ الشِفا","وأكثَرُ ما تَلقاهُ في المَعزَ والعَرَب",82,"ب",1,0],["وَفي قَلْبِهِ نَارٌ يَشبُّ ضرَامُها","وَآثارُ وَجْدٍ لَيْسَ ترسى كُلُومُهُ",83,"م",2,0],["وفي قبريون ابن فريام صاح","يرد الجياد إلى الحرب ردا",84,"د",2,0],["وفي قلب زنث استطار يعيث","حميم الصلا فدعا يستغيث",85,"ث",1,0],["وفي قوله لا تقنطوا طمعٌ لنا","فما معها ضيق لمن ذنبه حمل",86,"ل",1,0],["وفي قوله ادعوا استجب لدعائكم","ضمان غرام ما لضامنه مطل",86,"ل",1,0],["وَفِي قُبُولِهَا لِغَيرِ الكَافِرِ","قَطعاً وَظَنَّا وَجهُ خُلفٍ سِافِرِ",87,"ر",1,0],["وَفي قِصَّةِ الإِسرا شِفاءٌ مِنَ العَمى","وَبُرهانُ صِدقٍ شَمسُهُ لَم تَزَل تَبدو",88,"د",2,0],["وَفي قلب ذا للفك مرسى وَمسرح","حوامل تطفو بالعنا فوق ظهره",89,"ر",2,0],["وفي قبسات الشوق وجداً أذبتها","وهذي عظامي بالجفا قد رضضتها",90,"ه",2,0],["وفي قطر العراق وكل قطر","وفي أم الطماخ ورأس عين",91,"ن",1,0],["وفي قصر غمدان بان القصور","غداة تجلت وان عز دارا",92,"ر",2,0],["وفي قدِّهِ لينٌ وفي القلب قسوةٌ","وفي خصره جدبٌ وفي رِدفه خصبُ",93,"ب",1,0],["وفي قاب قرب شاهد الحق مشهدا","تنزه عن كيف وعن جهة حشا",94,"ش",2,0],["وفيّ قلم يخلف مواعيد بره","صفى فلم يدنس بغل ولا غش",95,"ش",1,0],["وفي قبةِ النسْرِ لي سادةٌ","بهم للكارمِ أُفْقٌ مُنيرُ",96,"ر",1,0],["وفي قبة العلياءِ كالبدر أَنجم","بهالتهِ الحسنى النجومُ الزواهرُ",97,"ر",1,0],["وَفي قِبابِ الخَليطِ خودٌ","تُديرُ لِلسِّحرِ مُقلَتَينِ",98,"ن",1,0],["وفي قصة ا