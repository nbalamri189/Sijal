{"poems":[[77,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[30,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[27,"هل رام أم لم يرم ذو السدر فالثلم","https://www.aldiwan.net/poem5990.html","البسيط"],[72,"ألا من لمسلوب الفؤاد رهينه","https://www.aldiwan.net/poem20148.html","الطويل"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"تكايدنا بالنتن أنفاس شنطف","https://www.aldiwan.net/poem61892.html","الطويل"],[58,"وفي قبض كف الطفل عند ولاده","https://www.aldiwan.net/poem30784.html","الطويل"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[100,"أثيم الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50095",""],[30,"عفا الدَّحلُ منْ ميِّ فمحَّتْ منازلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=3087",""],[115,"الى حلب الشهباء ثار بنا الوجد","https://www.aldiwan.net/poem41167.html","عموديه"],[132,"رقاب العقل لا تنسى زماني","https://www.aldiwan.net/poem54707.html","الوافر"],[150,"توكل إذا نابتك يوما ملمة","https://www.aldiwan.net/poem68522.html","الطويل"],[186,"أمير المؤمنين بلا إماره","https://www.aldiwan.net/poem43872.html","الوافر"],[199,"أطاب لذلك لرشا الجفاء","https://www.aldiwan.net/poem45593.html","الوافر"],[223,"ألا تبصر الأغصان بللها القطر","https://www.aldiwan.net/poem41891.html","الطويل"],[261,"تحية داع مخلص في دعائه","https://www.aldiwan.net/poem38280.html","الطويل"],[270,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[271,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[280,"ألا هكذا فليحرز الحمد والأجرا","https://www.aldiwan.net/poem60701.html","الطويل"],[298,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[304,"أجود بدمعي والدموع على الخد","https://www.aldiwan.net/poem16786.html","الطويل"],[304,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[342,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[349,"وجدي بك فقداني","https://www.aldiwan.net/poem15966.html","الهزج"],[416,"يا نائبا غاب عني الصبر مذ بانا","https://www.aldiwan.net/poem54149.html","البسيط"],[432,"منتاب مصركما بالرفد مغمور","https://www.aldiwan.net/poem12354.html","البسيط"],[439,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[441,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[458,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[479,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[500,"تدوس بساط الله والقلب فاقد","https://www.aldiwan.net/poem37566.html","الطويل"],[524,"نبي براه الله من نوره الأسمى","https://www.aldiwan.net/poem13283.html","الطويل"],[575,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[587,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"]],"verses":[["وَفِي قِبَابِ قُبا قاَمَتْ لَنَا بِقَبَا","طِرَازُهَا مذْهَبٌ فِي حُسْنِ تَزْيِينِ",0,"ن",1,0],["وَفي قَصرِ حَجرٍ مِن ذُؤابَةِ عامِرٍ","إِمامُ هُدىً مُستَبصِرُ الحُكمِ عادِلُه",1,"ل",2,0],["وَفي قُضاعَةَ بَيتٌ غَيرُ مُؤتَشَبٍ","نِعمَ القَديمُ إِذا ما حُصِّلَ القِدَمُ",2,"م",1,0],["وفي قلبه داءٌ دفين من الأسى","فلا غروَ أن يبكي لأجل دفينه",3,"ن",2,0],["وفي قُطربُّلٍ أطلالُ مغنىً","بهن ملاعبُ الظبي الرَّبيبِ",4,"ب",1,0],["وفي قُبْحها كافٍ لها من كِيَادها","ولكنها في فعلها تتبرَّدُ",5,"د",1,0],["وَفي قَبضِ كَفِ الطّفلِ عِندَ وَلادِهِ","دَليلٌ عَلى الحِرصِ المُرَكَّبِ في الحَيِّ",6,"ي",1,1],["وفي قضُب الخطّي يهتزّ حولها","مَشابهُ من أعطافها وشواكل",7,"ل",1,0],["وفي قلبهِ أعينٌ ثَرَّةٌ","بها النارُ طاغية العنفوانْ",8,"ن",1,0],["وفي قلبه ندم يستقي","دماه وفي حزنه يرتعي",9,"ع",2,0],["وَفِي قَصْرِ حَجْرٍ مِنْ ذُؤَابَة ِ عَامِرٍ","إمامُ هدى ً مستبصرُ الحكمِ عاملهْ",10,"ل",2,0],["وفي قرلق طه وبياضة السنى","بها لبهاء الدين قد لألأ السعد",11,"د",1,0],["وفي قَلبي مَحَبَّتِكِ التى لاَ","يُعَبِّرُ عن حَقِيقَتِهَا لِسني",12,"ي",1,0],["وفي قوله اذكرني لساقي مليكه","دليلٌ لمن في الصالحات له عزم",13,"م",1,0],["وفي قاضي القضاة عيوب سوء","تمعزل واستحل المال غاره",14,"ر",2,0],["وفي قلبي من الهجرانِ سقمٌ","وفي كبدي من الأشواقِ داءُ",15,"ا",2,0],["وَفي قُطر مِصرٍ كَم تَذَكَّرتَ زَحلَةً","فَأَبكاكَ بردونيَّها ذلِكَ القُطرُ",16,"ر",1,0],["وفي قدر ما أنهى إليك كفاية","عن الجهر ان الستر أليق بالحر",17,"ر",1,0],["وفي قدحٍ من البلَّورِ طابت","فتِلكَ نفيسةٌ تَهوى النَّفيسا",18,"س",2,0],["وَفي قعار جناب ما نزلت به","الا أَممنت أَمان الصيد في الحرم",19,"م",1,0],["وَفِي قُرْبِهِ الزُّلْفى وَفِي نَيْلِهِ الْعُلى","وَفِي حُكْمِهِ الْبُقْيا وَفِي ظِلِّهِ الْيُسْرا",20,"ر",2,0],["وَفي قلبي حسيسُ لظى","فهل أحسستِ في قلبكْ",21,"ك",1,0],["وفي قربهم أنسى وروحي وراحتي","ولست بشيء إن بلوني بالبعد",22,"د",1,0],["وفي قصة الأطيار وهي عجيبة","وكم من أمور في الوجود عجيبة",23,"ه",1,0],["وفي قرارة نفسي","ام في سماء خيالي",24,"ي",1,0],["وَفي قِبابِ الصينِ أَيُّ قُبَّةٍ","شَيَّدَها لِبَهمَنٍ مَنو شَهَر",25,"ر",1,0],["وَفي قُربِكَ لي بُعدٌ","وَعَن أُنسٍ وَعَن جانِ",26,"ن",1,0],["وفي قدومك ما تمَّ السرور به","وربَّما غابت الأَقمار أحيانا",27,"ن",2,0],["وفي قلوبِ أُناسٍ من صَفاتِكُما","نارٌ وفي أَعْيُنٍ من مَعْشَرٍ نُورُ",28,"ر",1,0],["وَفِي قاضِي القُضاةِ قَضَاءُ حَقٍّ","لِمَنْ يرعاهُمُ راعِي الرِّعاءِ",29,"ا",2,0],["وفي قول نيات","وفي عمل وعن كذب",30,"ب",1,0],["وفي قومها من فارسٍ للسانها","عدوٌّ فسل في قيصرٍ مَن نصيرُها",31,"ر",3,0],["وفي قعره شخصان بعل وحامل","أتاها مخاض مؤذنا بالمضائق",32,"ق",1,0],["وفي قمَّةِ المجد المنيع منابرٌ","وفي ساحة العزِّ الرفيع مساجدُ",33,"د",1,0],["وَفي قسم المَولى لَهُ بِحياتِهِ","آجل نَظراً تَلقاهُ أَوفرهم قَسما",34,"م",2,0],["وفي قلبه مَلِكٌ جائرْ","وفي خِصْرِه خَاتَمٌ جَائِلُ",35,"ل",1,0],["وفي قلة في أهل دين محمد","ذوي الصدق في يوم الوغى والتجالد",36,"د",1,0]]}