{"poems":[[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[66,"أدرها بلطف واجعل الرفق مذهبا","https://www.aldiwan.net/poem39207.html","الطويل"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16689","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[39,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""],[305,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[346,"فقمت إلى بلهاء ذات علالة","https://www.aldiwan.net/poem4474.html","الكامل"],[410,"أيا منقذي والحادثات تنوشني","https://www.aldiwan.net/poem32284.html","الطويل"],[453,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[453,"سقى الله أيام العذيب وبارقه","https://www.aldiwan.net/poem13862.html","الطويل"],[559,"نقطة الكون تحت باء الوجود","https://www.aldiwan.net/poem34601.html","الخفيف"]],"verses":[["كَظوماً عَلى مِثلِ الجَوائِفِ أَتعَبَت","نَطاسِيُّها مِن قارِفٍ بَعدَ جالِبِ",0,"ب",1,0],["كَظَّهُ الحُزنُ فَاِنفَجَر","اِنفِجارا",1,"ا",1,0],["كَظَنِّهِمِ في كَثرَةِ الأَكلِ أَنَّها","إِذا أَفرَطَت أَمسى بِها الجِسمُ مُخصِبا",2,"ب",2,0],["كَظَهرِ اللأى لَو تُبتَغى رِيَّةٌ بِها","نَهاراً لَأَعيَت في بُطونِ الشَواجِنِ",3,"ن",1,0],["كَظِباءِ وَجرَةَ ساقَهُن","نَ إِلى ظِلالِ السِدرِ ناجِر",4,"ر",1,0],["كظَبيةِ سَهلٍ في السَّرارَةِ مُرْضِعٍ","تَرُودُ ومأواها إلى عَلَجانَه",5,"ن",2,0],["كَظَنِّ كلِّ مَنْ بَدَا","لَهُ خَيَالٌ فَشَعَرْ",6,"ر",1,0],["كظباء وجرة ساقهنَّ","إلى ظلال السِّدر ناجر",7,"ر",1,0],["كظهرِ اللأَى ، لوْ تُبتغَى ريَّة ٌ بهَا","نهاراً لأعيتْ في بكونِ الشَّواجنِ",8,"ن",1,0],["كظل زائل أو طيف نوم","يئول بسرعة للإنحلال",9,"ل",1,0],["كَظَبيِ القَنيصِ قارَبوا فَوقَ رَأسِهِ","وَأَوصالِهِ في مُكنَباتِ المَرائِرِ",10,"ر",1,0],["كَظُومٌ على غيظٍ يضيقُ بِهِ الحَشَا","فلستُ وإن آدَ اصطبارِي أَبثُّهُ",11,"ث",2,0],["كظبيٍ راح مُلْتَفِتاً","بخال إِن بدا خلبا",12,"ب",2,0],["كظلِّ السَريّ بن السريّ محمد ال","أمين حليف الفضل حاوي طرائقه",13,"ق",2,0],["كظلال عن أمره أو خيال","خيَّلَتْهُ أسماءُ ربٍّ ودود",14,"د",1,0]]}