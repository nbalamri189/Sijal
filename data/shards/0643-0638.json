{"poems":[[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[93,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[68,"أدرها بلطف واجعل الرفق مذهبا","https://www.aldiwan.net/poem39207.html","الطويل"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16689","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[41,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""],[309,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[350,"فقمت إلى بلهاء ذات علالة","https://www.aldiwan.net/poem4474.html","الكامل"],[415,"أيا منقذي والحادثات تنوشني","https://www.aldiwan.net/poem32284.html","الطويل"],[457,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[457,"سقى الله أيام العذيب وبارقه","https://www.aldiwan.net/poem13862.html","الطويل"],[563,"نقطة الكون تحت باء الوجود","https://www.aldiwan.net/poem34601.html","الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38063","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67831","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119361","الخفيف"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138101",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93124","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95513","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109333","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53197","الرجز"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33850","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27915","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28026","الوافر"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105752","الرجز"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34648","المتقارب"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139381",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119561","الطويل"],[4679,"وشمس بهائه لما أضاءت","https://www.poetsgate.com/ViewPoem.aspx?id=142746",""],[5186,"ليت شعري أي المصائب أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=156468",""],[1043,"بغض ومقه","https://www.poetsgate.com/ViewPoem.aspx?id=92988",""],[5277,"قميصُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=192064",""],[5277,"قُمريّةُ الحارات","https://www.poetsgate.com/ViewPoem.aspx?id=202106",""],[5431,"ماكيافيلي والحصاد...","https://www.poetsgate.com/ViewPoem.aspx?id=205414",""],[5431,"إنّ ربي بمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=213011",""],[5493,"كل له ظله","https://www.poetsgate.com/ViewPoem.aspx?id=197568",""],[5688,"أجيبي مغرما","https://www.poetsgate.com/ViewPoem.aspx?id=206653",""],[5725,"جمعة محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177425",""],[5725,"نما بك داء","https://www.poetsgate.com/ViewPoem.aspx?id=177962",""],[5725,"عشق صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=186860",""],[5725,"مبتدأ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209146",""],[5992,"يا مَنْ كَغُرَّتِه الهلالُ أما ترى","https://www.poetsgate.com/ViewPoem.aspx?id=41840",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[2220,"إني رأيتُ وجوداً لا أسميهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11916&r=&rc=785",""],[6308,"انكسارات آخر الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87730&r=&rc=8",""]],"verses":[["كَظوماً عَلى مِثلِ الجَوائِفِ أَتعَبَت","نَطاسِيُّها مِن قارِفٍ بَعدَ جالِبِ",0,"ب",1,0],["كَظَّهُ الحُزنُ فَاِنفَجَر","اِنفِجارا",1,"ا",1,0],["كَظَنِّهِمِ في كَثرَةِ الأَكلِ أَنَّها","إِذا أَفرَطَت أَمسى بِها الجِسمُ مُخصِبا",2,"ب",2,0],["كَظَهرِ اللأى لَو تُبتَغى رِيَّةٌ بِها","نَهاراً لَأَعيَت في بُطونِ الشَواجِنِ",3,"ن",1,0],["كَظِباءِ وَجرَةَ ساقَهُن","نَ إِلى ظِلالِ السِدرِ ناجِر",4,"ر",1,0],["كظَبيةِ سَهلٍ في السَّرارَةِ مُرْضِعٍ","تَرُودُ ومأواها إلى عَلَجانَه",5,"ن",2,0],["كَظَنِّ كلِّ مَنْ بَدَا","لَهُ خَيَالٌ فَشَعَرْ",6,"ر",1,0],["كظباء وجرة ساقهنَّ","إلى ظلال السِّدر ناجر",7,"ر",1,0],["كظهرِ اللأَى ، لوْ تُبتغَى ريَّة ٌ بهَا","نهاراً لأعيتْ في بكونِ الشَّواجنِ",8,"ن",1,0],["كظل زائل أو طيف نوم","يئول بسرعة للإنحلال",9,"ل",1,0],["كَظَبيِ القَنيصِ قارَبوا فَوقَ رَأسِهِ","وَأَوصالِهِ في مُكنَباتِ المَرائِرِ",10,"ر",1,0],["كَظُومٌ على غيظٍ يضيقُ بِهِ الحَشَا","فلستُ وإن آدَ اصطبارِي أَبثُّهُ",11,"ث",2,0],["كظبيٍ راح مُلْتَفِتاً","بخال إِن بدا خلبا",12,"ب",2,0],["كظلِّ السَريّ بن السريّ محمد ال","أمين حليف الفضل حاوي طرائقه",13,"ق",2,0],["كظلال عن أمره أو خيال","خيَّلَتْهُ أسماءُ ربٍّ ودود",14,"د",1,0],["كظلك فوق الماء إذ ظل حاكيا","لتشكلك بالتشبيه حكماً مساويا",15,"ي",2,0],["كَظَنِّ الثريّا ثَعلبُ الفَجرِ طالِعاً","مِنَ الحَبِّ عنقوداً يَرومُ لَهُ قَطفا",16,"ف",2,0],["كَظَمْتُ بِهِ غَيْظِي وَأَخْفَيْتُ لَوُعَتي","وَأَظْهَرْتُ لِلْعُذَّالِ ضَحْكاً بِلاَ ضَحْكِ",17,"ك",1,0],["كظني الكظم والكظوم فغنطي","جاحظ باهظ فضيع النظام",18,"م",1,0],["كظمت حبِّىَ كي أجزيك من سفه","كبراً بكبر فما فما أجداني الكظم",19,"م",1,0],["كظنّ خال حسبت رأى علم","كظَنّ زيد عامرا أخا رحم",20,"م",1,0],["كظ أحشاه الظما حتى قضى","كيف مادكت لما نال الجبال",21,"ل",1,0],["كظباء مكةَ منعةً وعُلاَ","سَبَتِ النفوسَ وذيلُها طهرَا",22,"ر",2,0],["كَظَمَ الغيظَ بالتصبُّرِ دهراً","وإلى اللَهِ حقَّ منه التِجاء",23,"ا",2,0],["كظمنا غيظ أنفسنا عليهم","ولم نرهم لكيظ كاظمينا",24,"ن",2,0],["كظلم قوم شبهوا بجهلهم","كف غياث الدين بالبحر الخضم",25,"م",1,0],["كَظَمآنٍ يَحِنُّ إِلى الفَيافي","وَيَترُكُ مَوضِعَ النُطفِ العِذابِ",26,"ب",1,0],["كظلِّ جسمي متى أن كنت ذا نظرا","في نشأتي وهو مجلى من مجاليه",27,"ي",2,0],["كظهر البيت منزله سواء","يؤدي من علاه إلى اعتلال",28,"ل",1,0],["كَظَبيَةٍ قَنّاصٍ وَلَكِنَّها إِذا","رَمَت طَرفَها صادَت بِمِثلِ المَخالِبِ",29,"ب",1,0],["كظبية ما بين خشفين لها","أو كحبيبٍ في رقيبين اغتدى",30,"ا",1,0],["كظهر الأديم اذا ما السحا","بُ صابَ على متنها وانسجم",31,"م",1,0],["كظل سحابٍ لم يقم غير ساعةٍ","إلى أن أطاحته فطاح جنوبُ",32,"ب",1,0],["كظباء الخيف لا تخشي القناص","يتسرتن بمسود العقاص",33,"ص",1,0],["كظاعنة ضنت بها غربة النوى","علينا ولكن قد يلم خيالها",34,"ل",3,0],["كظلِ فاجأته الشمس لما","تقلد درَّهُ الزهر الرطيبُ",35,"ب",1,0],["كظ فيها أشهى طعام لئام","وكرام يقضون فيها جياعا",36,"ع",2,0],["كظمت حبِّيَ كي أجزيك من سفه","كبراً بكبر فما أجداني الكظمُ",37,"م",1,0],["كظّي بنابِ الهجرِ..ويكَ حبيبتي","والشوقُ للأحبابِ من صمتٍ نطقْ",38,"ق",1,0],["كظّي على ضيم الزمانِ بسجدةٍ","وتمترسي بالصومِ والدعواتِ",39,"ت",1,0],["كظلالٍ في واحة الجُبت بانت","زادها المحْو في الكرامة وهْنا",40,"ن",2,0],["-كظلالٍ على البسيطة جئنا","نقتفي النور والشعور معاقُ",41,"ق",1,0],["كظمتُ حُزني ووجهُ الظِّلِّ مستبِقٌ","بابَ الغيابِ وجرحِي بعدُ لمْ يَطِبِ",42,"ب",1,0],["كَظَبْيِ الرَّوْضِ إِنْ أَبْدَيْتِ طَرْفًا","وُدُونَكِ فِي المُقَارَنَةِ الظِّبَاءُ",43,"ا",2,0],["كظمت فمالِ الحزن يقظم اضلعي","واخفيت شيباتي فشابتْ رواصدُ",44,"د",1,0],["كظبيٍ يعطّ المسك من نفحاته","نحيل العصيّا والحشا منه اضمرُ",45,"ر",1,0],["كظمناها عهودا منذ كنا","وحفظ العهد من شيم الرجالِ",46,"ل",1,0],["كظمتُ وللعين فضل العتاب","وهذا الجوى مهلكاً كاظمهْ",47,"م",2,0],["كظريفةٍ نظرتْ إلى عُشّاقها","فتنقّبَتْ خَجَلاً بكمٍّ أزرقِ",48,"ق",1,0],["كَظَمتُ حَتَّى تَفَشَّى الغَمُّ فِي كَبِدِي","فَجِئتُ أَنفُثُ مِنْ صَدرِي شَعالِيلِي",49,"ل",2,0],["كَظَمتُ حَتَّى أَثارَ الجَهلُ عاصِفَتِي","فَقُمتُ أَحمِلُ فِي كَفَّيَّ قَدُّوما",50,"م",2,0],["كظلِّ جسمي متى أنْ كنتُ ذا نظرٍ","في نشأتي وهو مجلى من مجاليه",51,"ي",2,0],["كظلِّ عاشِقَةٍ غنَّتْ نوافِذُها","فمرَّ عاشِقُها... لَمْ يَسْمعِ الصَّوْتا",52,"ت",2,0]]}