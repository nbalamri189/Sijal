[575,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[575,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[586,"لهفي على شادن في حسن طلعته","https://www.aldiwan.net/poem17405.html","البسيط"],[586,"هذا الذي أحبه","https://www.aldiwan.net/poem17421.html","مجزوء الرجز"],[587,"سبحان من كون الأشياء تكوينا","https://www.aldiwan.net/poem11513.html","عموديه"],[587,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"]],"verses":[["قَد بانَ حالي سِربِهِ","فَلِم أَقامَ العاطِلُ",0,"ل",1,0],["قَد بَنَيتُم فَشَيِّدوا","وَغَرَستُم فَأَورِقوا",1,"ق",3,0],["قَد باتَ فيها قائِلٌ صَنَعٌ","يَهمي لِهاذِمَها وَيُرهِفُها",2,"ف",3,0],["قَد بَلاكَ الأَعداءُ حُلواً وَمُرّاً","وَبَلَوا شيمَتَيكَ ليناً وَعُنفا",3,"ف",2,0],["قَد بَذَلنا لَكَ المَوَدَّةَ وَالحُ","بَّ وَزِدناكَ فَوقَ ما تَتَمنّى",4,"ن",2,0],["قَد بِتَّ أَجفى الناسِ مُستَيقِظاً","وَأَوصَلَ الناسِ لَنا في المَنام",5,"م",1,1],["قَد بَلَوناكَ مَريضاً","وَبَلَوناكَ صَحيحا",6,"ح",2,0],["قَد بَنى اللُؤمُ عَلَيهِم بَيتَهُ","وَفَشا فيهِم مَعَ اللُؤمِ القَلَح",7,"ح",1,0],["قَد بِتُّ رائِدَها وَشاةِ مُحاذِرٍ","حَذَراً يُقِلُّ بِعَينِهِ أَغفالَها",8,"ل",3,0],["قَد بَكاكَ الرَئيسُ وَهوَ جَريحٌ","وَدُموعُ الرَئيسِ كَالرَحَماتِ",9,"ت",1,0],["قَد بَكَينا لَكُمُ مِن رَحمَةِ","يَومَ مِسّينا فَأَرخَصنا الدُرَر",10,"ر",1,0],["قَد بَلَوناكَ قاضِياً وَوَزيراً","وَرَئيساً وَمِدرَهاً خَلّابا",11,"ب",2,0],["قَد بَعَثناهُ يَنفَعُ الأَعضاءَ","حينَ يَجلو بِلُطفِهِ السَخناءَ",12,"ا",2,1],["قد بلغ الآداب أسمى الذرى","بفضل ما يولي من العطف",13,"ف",1,0],["قَدْ بَرَّحَ الوَجْدُ بِأَكْبَادِنَا","حَتَّى اسْتَطَلْنَا العُمْرَ دُونَ المَرَامْ",14,"م",1,0],["قَدْ بِتَّ أَتْعَبَ مَا بَا","تَ دُونَ حَقٍّ مُخَاصِمْ",15,"م",1,0],["قَد بَلَوتَ الناسَ طُرّا","لَم أَجِد في الناسِ حُرّا",16,"ر",2,1],["قد بلغ رتب منيفا","الصلا على محمد",17,"د",1,0],["قد بشَّرَ الرسُلُ الكرامُ ببعثِهِ","وتقدَّمَ الكُهَّانُ بالأَنباءِ",18,"ا",2,0],["قد بتّ فيه ضجيع كل غريرة","رَود الشباب من الخراد رداح",19,"ح",1,0],["قد بات كافور من جراءتها","على الموامي بمهجة وجله",20,"ل",2,0],["قد بِعتَما الدين بالدنيا مجازفة","فكنتما في البرايا شّر مَن غُبِنا",21,"ن",2,0],["قد بِتّها ليلة مُطَّولة","يَعقِد جَفني بنجمها الوَصَب",22,"ب",1,0],["قد بكينا شجواً عليها ومنها","وعنانا سقامها والشفاء",23,"ا",2,0],["قد بكته مدارس عامرات","هو فيها المدّرس المسؤول",24,"ل",1,0],["قد بكته شجواً يسبع عيون","في رباها تجود بالتسجام",25,"م",1,0],["قَد بُدِّلَت ساكِنَ الآرامِ بَعدَهُمُ","وَالباقِرَ الخُنسَ يَبحَثنَ المَآرينا",26,"ن",2,0],["قَد بِتُّ سامِرَها وَغايَةُ تاجِرٍ","وافَيتُ إِذ رُفِعَت وَعَزَّ مُدامُها",27,"م",3,0],["قد بلونا السادات شرقاً وغرباً","فوجدنا جلال علياه أجلى",28,"ل",2,0],["قد بسطتها راحة الغمائم","بسط الدنانير على الدراهم",29,"م",1,0],["قد بالغت من طمعٍ في كسبها","ففتَّشت عن أنفسٍ لم تخبها",29,"ه",2,0],["قد بُلينا في دهرنا بملوكٍ","أدباءٍ عَلِمْتُهمْ شعراءِ",30,"ا",2,1],["قد بغى قبلَك الدعيُّ فلم أح","فلْ بأنْ كان باغياً بغّاءَ",31,"ا",2,0],["قد بَغَيْنا كما بغيتَ وقد كا","ن حقيقاً وفاؤنا بوَفائِكْ",32,"ك",1,0],["قد بلونا خلاله فَحمِدْنا","غَيْبَها حمدَ ذائقٍ مُستطيبِ",33,"ب",1,0],["قد بيَّضَ الأوجُه بابنٍ لَهُ","قالتْ له آمالُنا مرحبا",34,"ب",2,0],["قد بدرتْ سَبَّةُ الخطيب فما","لَجْلَجَ في قيله ولا اكترثَا",35,"ث",2,0],["قَدْ بَدَا في فِرَاسَةِ الفارس الطَّا","لع يُمْنٌ دعْوَاهُ ذاتُ شُهُودِ",36,"د",1,0],["قد بعثتَ المبشّرات بريداً","بغناه فلا تُكذِّبْ بريدَكْ",37,"ك",1,0],["قد بارها الدهرُ كلَّ بور","وبارت الدهرَ كل بورِ",38,"ر",1,0],["قد بلونا يوميك يا ابن عليٍّ","فحمدنا المغيوم والمطلوقا",39,"ق",2,0],["قد بخَّرته لك هِركَوْلةٌ","ومسَّكته أيَّ تمسيك",40,"ك",1,0],["قد بلى اللَّه يونسَ بن بُغاءٍ","ببلاءِ النبيّ يونسَ قَبْلَهْ",41,"ه",1,1],["قد بذلتُ التذكير فابذلْ ليَ التن","كيرَ إنّ الزمان فيه عُرامُ",42,"م",1,0],["قد بعثتمْ حربَ عَتْبٍ مُقلق","من وليٍّ فاستعدوا هُدَنه",43,"ن",2,0],["قد بان غَيُّ أُناسٍ في تَخرُّصِهم","لك العيوبَ فلا تجعل لهم لَسَنا",44,"ن",2,0],["قَد بَكى التارِكوكِ مِنكِ قُنوطاً","فَبَكى الساكِنوكِ خَوفَ التَنائي",45,"ا",2,0],["قَد بَكَينا كَما بَكى لُبنانُ","وَحَنَتنا كَأَرزِهِ الأَحزانُ",46,"ن",1,0],["قَد باتَ قَلبِيَ في دُنيا مُشَوَّشَةٍ","مُنذُ اِلتَفَتُّ إِلى آثارِ دُنياكِ",47,"ك",1,0],["قَد باتَ كُلُّ مُسَهَّدٍ طَوعَ جَناحَهُ","وَاللَيلُ أَمسى سِترُهُ مَسدولا",48,"ل",2,0],["قَد بَكاكَ الأُفقُ حَتّى","فَرقَداهُ وَسُهاه",49,"ه",1,0],["قَد بَدَّلَ الإِنسانُ أَطوارَها","وَاِغتَصَبَ الطَيرَ مَآويها",50,"ي",3,0],["قد بكته الأقلام منكسرات","وبكته الأخلاق والآداب",51,"ب",1,0],["قد بدأ الشعب باسباب","الهدى يعتصم",52,"م",1,0],["قد بت والحق منبوذين في بلد","كنا عزيزيه ابكيه ويبكيني",53,"ي",1,0],["قد بلوت الحياة وهي بلتني","فكلانا من الفه مملول",54,"ل",1,0],["قد بلاني الزمان سهلا وصعبا","وبلوت الزمان حلواً ومرا",55,"ر",2,1],["قد بكى مجده الذي","غاض من بعد ما زخر",56,"ر",1,0],["قد بالغ الأدباء في أوصافها","ما بين منشور وبين منظم",57,"م",1,0],["قد بلغنا أبا محمد النج","م كما يبلغ السُراة المنارا",58,"ر",2,0],["قَد بَعَثنا تَحِيَّةً وَثَناءً","لَكَ يا أَرفَعَ الزَواخِرِ ذِكرا",59,"ر",2,0],["قَد بَلَغتِ الكَمالَ في نِصفِ قَرنٍ","كَيفَ إِن تَمَّتِ المَلاوَةُ قَرنا",60,"ن",2,0],["قَد بَنى اللَهُ بَيتَهُم فَهوَ باقٍ","ما بَنى اللَهُ ما لَهُ مِن هادِم",61,"م",1,0],["قَد بَعَثتَ القَضِيَّةَ اليَومَ مَيتاً","رُبَّ عَظمٍ أَتى الأُمورَ العَظائِم",61,"م",1,0],["قَد بَلَّغَت رَبَّ المَدائِنِ وَاِنتَهَت","حَيثُ اِنتَهَيتَ بِصاحِبِ الأَحقافِ",62,"ف",1,0],["قَد بَلَوناكَ في الرِياسَةِ حيناً","فَبَلَونا الوَزيرَ عَبدَ الحَميدِ",63,"د",1,0],["قَد بَسَطوا الكَفَّ عَلى أَنَّهُم","في كَرَمِ الراحِ كَصَوبِ العِهاد",64,"د",1,0],["قَدْ باتَ سَيْفي في مَجَالِ وِشَاحِها","ومَدَامِعِي تَجْرِي على خَدَّيْها",65,"ي",3,0],["قَد بَلَغتَ الَّذي أَرَدتَ مِنَ البِر","رِ وَمِن حَقِّ ذا الشَريفِ عَلَيكا",66,"ك",2,1],["قَد بَلَوتَ الخُطوبَ مُرّاً وَحُلواً","وَسَلَكتَ الأَيّامَ حَزناً وَسَهلا",67,"ل",2,0],["قَد بَلَّغوا بِقَناهُم فَوقَ طاقَتِهِ","وَلَيسَ يَبلُغُ ما فيهِم مِنَ الهِمَمِ",68,"م",1,0],["قَد بَيَّنَ البَينُ المُفَرِّقُ بَينَنا","عِشقَ النَوى لِرَبيبِ ذاكَ الرَبرَبِ",69,"ب",1,0],["قَد باتَ مُستَعبِراً مَن كانَ مُصطَبِراً","وَعادَ ذا جَزَعٍ مَن كانَ ذا