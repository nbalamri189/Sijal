{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[77,"ودير أنخنا في قرارته العيسا","https://www.aldiwan.net/poem35886.html","الطويل"],[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"يا من زهت عن أن تماشي شخصها","https://www.aldiwan.net/poem19107.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[85,"أبولو مرحباً بك يا أبولو","https://www.aldiwan.net/poem8077.html","الوافر"],[45,"وإذا مضى للمرء من أعوامه","https://www.aldiwan.net/poem62726.html","الكامل"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[2,"هاج الفؤاد معارف الرسم","https://www.aldiwan.net/poem25007.html","الكامل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[69,"ذاب من ثغرك قلبي","https://www.aldiwan.net/poem29077.html","مجزوء الرمل"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"يا بريد الدهر يمشي خفية","https://www.aldiwan.net/poem43137.html","الرمل"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[105,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[105,"عكاشة ما في الغمر من متخلف","https://www.aldiwan.net/poem43584.html","الطويل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"نفر النوم واحتمى","https://www.aldiwan.net/poem65232.html","مجزوء الخفيف"],[46,"كيف احتيالك والقضاء مدبر","https://www.aldiwan.net/poem22563.html","الكامل"],[46,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85506","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39680","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54311","الخفيف"],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[100,"قالت الضحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50170",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[115,"خبر طوى شقق البقاع فاخبرا","https://www.aldiwan.net/poem41104.html","عموديه"],[115,"غرامك اضنى الجسم فالنار توقد","https://www.aldiwan.net/poem41166.html","عموديه"],[115,"سبقوا البرية طارفا وتليدا","https://www.aldiwan.net/poem41963.html","الكامل"],[160,"إليك فلو أدركت مغنى الهوى مغنا","https://www.aldiwan.net/poem59014.html","الطويل"],[164,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[221,"ذهبالشباب فأطرقت","https://www.aldiwan.net/poem55286.html","مجزوء الكامل"],[237,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[239,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[250,"على المصطفى المختار من آل هاشم","https://www.aldiwan.net/poem15071.html","الطويل"],[271,"سقاك الحيا الوسمى ربعا تأيدا","https://www.aldiwan.net/poem52098.html","الطويل"],[271,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[275,"كرت سوافح عبرتي أشجاني","https://www.aldiwan.net/poem25514.html","الكامل"],[285,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[298,"لما رقصت على المنصة بدعة","https://www.aldiwan.net/poem36273.html","عموديه"],[298,"البرلمان: وهل أتاك حديثه","https://www.aldiwan.net/poem36824.html","عموديه"],[305,"بل ربما قد كان في أغمارهم","https://www.aldiwan.net/poem56393.html","الكامل"],[353,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[380,"لمن طلل بالجزع قفر جوانبه","https://www.aldiwan.net/poem48837.html","الطويل"],[403,"قسما لقد أثقلتني تبجيلا","https://www.aldiwan.net/poem33491.html","الكامل"],[403,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[416,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[429,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[432,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[432,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[441,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[464,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[536,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[551,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"بدت الحقيقة من خلال ستورها","https://www.aldiwan.net/poem34461.html","الكامل"]],"verses":[["عَكَفوا عَلى العَلياءِ ما","فيهِم عَلى مَجدٍ ضَنينُ",0,"ن",1,0],["عُكوفٍ علَى التِّمْثالِ يستَلِمونَهُ","ويُعْنَوْنَ بالإنْجيلِ حِفْظاً وتَدْريسا",1,"س",2,0],["عكَفْنا علَيْهِ والبُروقُ كأنّها","مُطهّمةً شُقرٌ تبارَتْ الى السّبْقِ",2,"ق",1,0],["عُكَاظِيًّا أَبُوه أَبو إِياد","صَحِيحَاً لاَ عَوارَ وَلاَ دَهِينا",3,"ن",2,0],["عكس الضنى والسهد حالي فاغْتدى","نومي سباتي والنهار معاشي",4,"ي",1,0],["عكستْ أمْريَ النحوسُ فعنزي","أبداً حائلٌ وتيسي حلوبُ",5,"ب",1,0],["عكف الرأيُ عليكم وحدكم","والهوى يَعبدُ جهلاً وثَنَه",6,"ن",2,0],["عَكَفنا عَلَيهِ نَجتَني مِن فُنونِهِ","فَعَلَّمَنا هَذا الكَلامَ المُؤَنَّقا",7,"ق",2,0],["عُكاظُ وَأَنتِ لِلبُلَغاءِ سوقٌ","عَلى جَنَباتِها رَحَلوا وَحَلّوا",8,"ل",3,0],["عَكَفَت عَلَيهِ المُخزِياتُ وَقُلنَ قَد","أَضحَكتَنا وَسَرَرتَنا لا تَبرَحِ",9,"ح",1,0],["عَكَسَت حَظُّهُ اللَيالي وَباتَ ال","مُشتَري فيهِ وَهوَ كَوكَبُ نَحسِ",10,"س",1,0],["عَكَراً إِذا ما راحَ سَربُهُمُ","وَثَنوا عُروجَ قَنابِلٍ دُهمِ",11,"م",1,0],["عُكُفٌ بِجِذلٍ لِلطِعانِ لِقاؤُهُ","خَطَرٌ إِذا خَطَرَ القَنا الخَطّارُ",12,"ر",1,0],["عُكِسَ الأمرُ لعكسي","بَرَدٌ ذَوَّبَ جمراً",13,"ر",2,0],["عَكَفَتْ عَلَى الأصنْامِ واتَّخذَتْ","دينَ العَمَى من دينها بَدَلا",14,"ل",2,0],["عكفوا على أعراسهم وبلادُهم","في مأتمٍ من همّها وحِدادِ",15,"د",1,0],["عكفوا على نار الخلافِ فسرّهم","ما جرَّ مُوقِدُها وذاقَ الصّالي",16,"ل",2,0],["عَكَسوا الأَشياءَ حَتّى جُعِلَت","تَسفُلُ الهامُ وَتَعلو الأَرجُلُ",17,"ل",1,0],["عَكَفَت عَلَيهِ الطَيرُ تَحسَبُ أَنَّما","طاحَت بِهِ أَيدي الرَدى وَكَأَنْ قَدِ",18,"د",1,0],["عَكفتَ على البَغْيِ المُذمَّمِ والأذَى","فَذُبْ أسفاً واعْكُفْ على النَّارِ صَاليا",19,"ي",2,0],["عُكاشَةُ ما في الغَمْرِ من مُتْخلَّفٍ","خلا الغَمْرُ من عُمَّارِهِ فَهْوَ مُقْفِرُ",20,"ر",1,1],["عُكَاشَةُ عُدْ بالجندِ غيرَ مُخيَّبٍ","كفى القومَ خِزْياً أن يَفِرُّوا ويُدبِرُوا",20,"ر",3,0],["عَكَفوا على آيِ الكتابِ فأفْلَحُوا","والجاهلونَ على المآثِمِ عُكَّفُ",21,"ف",1,0],["عكسوا الزّمانَ عَواثنِاً ودواخنِاً","فالصُّبْحُ ليلٌ والظَّلامُ نهار",22,"ر",1,0],["عَكَفَ الحُبُّ عيرَهُ","في فُؤادي وَخَيَّما",23,"م",2,0],["عُكِسَ الأَنامُ بِحِكمَةٍ مِن رَبِّهِ","فَتَحَكَّمَ الهَجَرِيُّ فيهِ وَسَنبَرُ",24,"ر",1,0],["عَكَرُ العَيشِ في إِنائي وَهَل يُؤ","مَلُ مِن صَفوِهِ وَقَد فاتَ عَكرُ",25,"ر",1,0],["عكر اللفظ ما عليه صفاءٌ","تافه المعنى ما عليه قبول",26,"ل",1,0],["عكّاءُ في الساحلِ الشرقيّ شامخةٌ","تطاولُ النجمَ أبراجاً وأسوارا",27,"ر",2,1],["عَكُوفٌ عَلَى التَّحْصِيلِ مِنْ كُلِّ مَطْلَبٍ","يُلِمُّ بِهِ مَهْما يَسُمْهُ عَنَاءَ",28,"ا",2,0],["عَكَفتُ عَلى الأَحزانِ بَعدَكَ جافِياً","لِقَبرِكَ إِنّي لَستُ أَبرَحُ مُعكفِ",29,"ف",1,0],["عُكِس الحال لا محالة لكن","ربّما أنجد الغريقَ الماء",30,"ا",2,0],["عكوفا على اللذات من قبل فوتها","حريصا على الإرشاد في منهج الحق",31,"ق",1,0],["عكذا كنتم أمامي وخلفي","غزلا مغريا وكنت ... غريره",32,"ر",2,0],["عُكِسَتْ آيةُ الفضائلِ فالأعلى","مَقاماً من كانَ في النفس أدْنى",33,"ن",2,0],["عكفتْ أنفسٌ هناك على الأفراحِ","والأنسِ بين خَمرٍ وهيف",34,"ف",1,0],["\" عُكاظُ \" من الشعر تحتلّهُ","ويرعاهُ \" حافظُ \" حتى ازدهر",35,"ر",1,0],["عكفت بمحراب العبادة في الدجى","لله تخشع لم تذق طعم الكرى",36,"ر",2,0],["عكست لي المعنى فجئت بمثله","فدمعي وقلبي مطلق ومقيد",37,"د",1,0],["عكفوا على أعتابهم ولقد رأوا","رأياً لإنتاج المراد سديدا",38,"د",2,0],["عكفنا على اللذات فيها بمعزل","عن الناس لا عينا تخاف ولا أذنا",39,"ن",2,0],["عَكَفَ الدَمعُ عَلى كُلِّ عَينٍ","رَأَتِ الطَيرَ عَلَيهِم عُكوفا",40,"ف",2,0],["عكست لنا آياتها","سبح بإسم العاكس",41,"س",1,0],["عَكْسُ النقِيضِ مُوافِقٌ","لِمُرِيدِهِ فِي كُلِّ مَشْهَدْ",42,"د",1,0],["عكوف على أجداثهم يعبدونها","وكل لها في غيه متعصب",43,"ب",1,0],["عكفتُ على مدحي له متيقنا","بدفعِ خطوبٍ لا أطبقُ لها دفعا",44,"ع",2,0],["عكفت عَلى مغناك حَتّى توهمت","نهاتي باني قد تخذتك مسجدا",45,"د",2,0],["عكوفا بمغناها حَيارى بحسنها","فَلِلَّه كَم أَصبت قلوبا وأَكبدا",45,"د",2,0],["عكفت بساحتها الرفاق وانما","عكفوا عَلى كبد من الاكباد",46,"د",1,0],["عَكْسَ الحَقائِق في الهَوى مُتَعَارَفٌ","فَتَرَى الأُسُودَ قَنَائِصَ الغِزْلانِ",47,"ن",1,0],["عكس الامر عليهم","فسقوا سم العذاب",48,"ب",1,0],["عكسوا عليك الكهرباءَ ملوناً","كوميض برق أَو كلمح سراب",49,"ب",1,0],["عَكَفَتْ زواياه عَلَى أصنامِهمْ","من لي بإبراهيم للأصنام...",50,"م",1,0],["عَكَفَت عَلى اِستكمالها الآراء أع","صاراً بِصرفِ نهاية الإمكانِ",51,"ن",1,0],["عَكف العَنيد عَلى الخَديعة مِثلَما","عَكَفت عَلى رَوث البَهيم الخُنفسا",52,"س",2,0],["عَكَفت عَلَيهِ بَعد ما إِسوَدَ جَوّهُ","وَقَد أَفلَت أَقمارُهُ وَكَواكِبُهُ",53,"ب",2,0],["عكسوا أساليب المعارف كلها","وجنوا فصار الفاضل المفضولا",54,"ل",2,0],["عكس ما أنزله الإِله من الحق","وما قاله النبيُّ محمد",55,"د",1,0],["عكفت بهم على اللَّذَّات حتَّى","قرعت بهم من الغايات بابا",56,"ب",2,0],["عكاءُ قاهرة الآساد في أجم","علياء فاخرت الأفلاك بالأجمِ",57,"م",1,0],["عكَفَ الشِّعْرُ على أوصافه","فهو الروضُ أصابَ المَنهَلا",58,"ل",2,0],["عكفنا على حاناتِها فكأنّها","مشاعرُ تقوىً أُوثرت أو مناسكُ",59,"ك",1,0],["عكفت بقبرك أحمد حنانة","تذري عليك مدى الزمان دموعا",60,"ع",2,0],["عكفت بأبلج بالحديد مثقَّلِ","عن معتفيهِ بالنضار مخفف",61,"ف",1,0],["عُكوفُهُمُ عَلى الأَصنا","مِ لَم يَرضَوا بِها بَدَلا",62,"ل",2,0],["عَكَفَ اللَيلُ عَلى آثارِنا","مِثلَ ما حَنَّت عَلى البَوِّ الظُؤارُ",63,"ر",1,0],["عكفنا على ما تعلمون من التُّقى","وأنتمْ على ما يعلمُ اللّهُ عُكَّفُ",64,"ف",1,0],["عَكَفَت عَلى الصَفصافِ مِنكَ عَزيمَةٌ","مِن رَأيِ مُكتَنِفٍ بِنَصرٍ أَيِّدِ",65,"د",1,0],["عكس البليغ بليغ العكس في عذلي","يا عاذلي فدع التبديل في الكلم",66,"م",1,0],["عكفوا عليها لائذين بحبها","إن المحبة دكها في طورها",67,"ر",3,0]]}