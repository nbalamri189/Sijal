iewPoem.aspx?id=208334",""],[5751,"مرسوم كوني بنرجسية شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214785",""],[5771,"بطاقة زائر","https://www.poetsgate.com/ViewPoem.aspx?id=189060",""],[5829,"اعترافات","https://www.poetsgate.com/ViewPoem.aspx?id=189909",""],[5845,"سقاكَ الحيا الوسميُّ ربعاً تأبداً","https://www.poetsgate.com/ViewPoem.aspx?id=198489",""],[5956,"أنا دونك شيخ ضرير","https://www.poetsgate.com/ViewPoem.aspx?id=182218",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""],[5956,"بسبب وعد بلفور: الفلسطينيون يأكلون حشائشا","https://www.poetsgate.com/ViewPoem.aspx?id=202513",""],[6089,"عدتَ ياعيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213024",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["عكوفاً دون أَصنامٍ وإلا","عكوفاً دون جبارٍ ووال",0,"ل",1,0],["عَكَفوا عَلى العَلياءِ ما","فيهِم عَلى مَجدٍ ضَنينُ",1,"ن",1,0],["عُكوفٍ علَى التِّمْثالِ يستَلِمونَهُ","ويُعْنَوْنَ بالإنْجيلِ حِفْظاً وتَدْريسا",2,"س",2,0],["عكَفْنا علَيْهِ والبُروقُ كأنّها","مُطهّمةً شُقرٌ تبارَتْ الى السّبْقِ",3,"ق",1,0],["عُكَاظِيًّا أَبُوه أَبو إِياد","صَحِيحَاً لاَ عَوارَ وَلاَ دَهِينا",4,"ن",2,0],["عكس الضنى والسهد حالي فاغْتدى","نومي سباتي والنهار معاشي",5,"ي",1,0],["عكستْ أمْريَ النحوسُ فعنزي","أبداً حائلٌ وتيسي حلوبُ",6,"ب",1,0],["عكف الرأيُ عليكم وحدكم","والهوى يَعبدُ جهلاً وثَنَه",7,"ن",2,0],["عَكَفنا عَلَيهِ نَجتَني مِن فُنونِهِ","فَعَلَّمَنا هَذا الكَلامَ المُؤَنَّقا",8,"ق",2,0],["عُكاظُ وَأَنتِ لِلبُلَغاءِ سوقٌ","عَلى جَنَباتِها رَحَلوا وَحَلّوا",9,"ل",3,0],["عَكَفَت عَلَيهِ المُخزِياتُ وَقُلنَ قَد","أَضحَكتَنا وَسَرَرتَنا لا تَبرَحِ",10,"ح",1,0],["عَكَسَت حَظُّهُ اللَيالي وَباتَ ال","مُشتَري فيهِ وَهوَ كَوكَبُ نَحسِ",11,"س",1,0],["عَكَراً إِذا ما راحَ سَربُهُمُ","وَثَنوا عُروجَ قَنابِلٍ دُهمِ",12,"م",1,0],["عُكُفٌ بِجِذلٍ لِلطِعانِ لِقاؤُهُ","خَطَرٌ إِذا خَطَرَ القَنا الخَطّارُ",13,"ر",1,0],["عُكِسَ الأمرُ لعكسي","بَرَدٌ ذَوَّبَ جمراً",14,"ر",2,0],["عَكَفَتْ عَلَى الأصنْامِ واتَّخذَتْ","دينَ العَمَى من دينها بَدَلا",15,"ل",2,0],["عكفوا على أعراسهم وبلادُهم","في مأتمٍ من همّها وحِدادِ",16,"د",1,0],["عكفوا على نار الخلافِ فسرّهم","ما جرَّ مُوقِدُها وذاقَ الصّالي",17,"ل",2,0],["عَكَسوا الأَشياءَ حَتّى جُعِلَت","تَسفُلُ الهامُ وَتَعلو الأَرجُلُ",18,"ل",1,0],["عَكَفَت عَلَيهِ الطَيرُ تَحسَبُ أَنَّما","طاحَت بِهِ أَيدي الرَدى وَكَأَنْ قَدِ",19,"د",1,0],["عَكفتَ على البَغْيِ المُذمَّمِ والأذَى","فَذُبْ أسفاً واعْكُفْ على النَّارِ صَاليا",20,"ي",2,0],["عُكاشَةُ ما في الغَمْرِ من مُتْخلَّفٍ","خلا الغَمْرُ من عُمَّارِهِ فَهْوَ مُقْفِرُ",21,"ر",1,1],["عُكَاشَةُ عُدْ بالجندِ غيرَ مُخيَّبٍ","كفى القومَ خِزْياً أن يَفِرُّوا ويُدبِرُوا",21,"ر",3,0],["عَكَفوا على آيِ الكتابِ فأفْلَحُوا","والجاهلونَ على المآثِمِ عُكَّفُ",22,"ف",1,0],["عكسوا الزّمانَ عَواثنِاً ودواخنِاً","فالصُّبْحُ ليلٌ والظَّلامُ نهار",23,"ر",1,0],["عَكَفَ الحُبُّ عيرَهُ","في فُؤادي وَخَيَّما",24,"م",2,0],["عُكِسَ الأَنامُ بِحِكمَةٍ مِن رَبِّهِ","فَتَحَكَّمَ الهَجَرِيُّ فيهِ وَسَنبَرُ",25,"ر",1,0],["عَكَرُ العَيشِ في إِنائي وَهَل يُؤ","مَلُ مِن صَفوِهِ وَقَد فاتَ عَكرُ",26,"ر",1,0],["عكر اللفظ ما عليه صفاءٌ","تافه المعنى ما عليه قبول",27,"ل",1,0],["عكّاءُ في الساحلِ الشرقيّ شامخةٌ","تطاولُ النجمَ أبراجاً وأسوارا",28,"ر",2,1],["عَكُوفٌ عَلَى التَّحْصِيلِ مِنْ كُلِّ مَطْلَبٍ","يُلِمُّ بِهِ مَهْما يَسُمْهُ عَنَاءَ",29,"ا",2,0],["عَكَفتُ عَلى الأَحزانِ بَعدَكَ جافِياً","لِقَبرِكَ إِنّي لَستُ أَبرَحُ مُعكفِ",30,"ف",1,0],["عُكِس الحال لا محالة لكن","ربّما أنجد الغريقَ الماء",31,"ا",2,0],["عكوفا على اللذات من قبل فوتها","حريصا على الإرشاد في منهج الحق",32,"ق",1,0],["عكذا كنتم أمامي وخلفي","غزلا مغريا وكنت ... غريره",33,"ر",2,0],["عُكِسَتْ آيةُ الفضائلِ فالأعلى","مَقاماً من كانَ في النفس أدْنى",34,"ن",2,0],["عكفتْ أنفسٌ هناك على الأفراحِ","والأنسِ بين خَمرٍ وهيف",35,"ف",1,0],["\" عُكاظُ \" من الشعر تحتلّهُ","ويرعاهُ \" حافظُ \" حتى ازدهر",36,"ر",1,0],["عكفت بمحراب العبادة في الدجى","لله تخشع لم تذق طعم الكرى",37,"ر",2,0],["عكست لي المعنى فجئت بمثله","فدمعي وقلبي مطلق ومقيد",38,"د",1,0],["عكفوا على أعتابهم ولقد رأوا","رأياً لإنتاج المراد سديدا",39,"د",2,0],["عكفنا على اللذات فيها بمعزل","عن الناس لا عينا تخاف ولا أذنا",40,"ن",2,0],["عَكَفَ الدَمعُ عَلى كُلِّ عَينٍ","رَأَتِ الطَيرَ عَلَيهِم عُكوفا",41,"ف",2,0],["عكست لنا آياتها","سبح بإسم العاكس",42,"س",1,0],["عَكْسُ النقِيضِ مُوافِقٌ","لِمُرِيدِهِ فِي كُلِّ مَشْهَدْ",43,"د",1,0],["عكوف على أجداثهم يعبدونها","وكل لها في غيه متعصب",44,"ب",1,0],["عكفتُ على مدحي له متيقنا","بدفعِ خطوبٍ لا أطبقُ لها دفعا",45,"ع",2,0],["عكفت عَلى مغناك حَتّى توهمت","نهاتي باني قد تخذتك مسجدا",46,"د",2,0],["عكوفا بمغناها حَيارى بحسنها","فَلِلَّه كَم أَصبت قلوبا وأَكبدا",46,"د",2,0],["عكفت بساحتها الرفاق وانما","عكفوا عَلى كبد من الاكباد",47,"د",1,0],["عَكْسَ الحَقائِق في الهَوى مُتَعَارَفٌ","فَتَرَى الأُسُودَ قَنَائِصَ الغِزْلانِ",48,"ن",1,0],["عكس الامر عليهم","فسقوا سم العذاب",49,"ب",1,0],["عكسوا عليك الكهرباءَ ملوناً","كوميض برق أَو كلمح سراب",50,"ب",1,0],["عَكَفَتْ زواياه عَلَى أصنامِهمْ","من لي بإبراهيم للأصنام...",51,"م",1,0],["عَكَفَت عَلى اِستكمالها الآراء أع","صاراً بِصرفِ نهاية الإمكانِ",52,"ن",1,0],["عَكف العَنيد عَلى الخَديعة مِثلَما","عَكَفت عَلى رَوث البَهيم الخُنفسا",53,"س",2,0],["عَكَفت عَلَيهِ بَعد ما إِسوَدَ جَوّهُ","وَقَد أَفلَت أَقمارُهُ وَكَواكِبُهُ",54,"ب",2,0],["عكسوا أساليب المعارف كلها","وجنوا فصار الفاضل المفضولا",55,"ل",2,0],["عكس ما أنزله الإِله من الحق","وما قاله النبيُّ محمد",56,"د",1,0],["عكفت بهم على اللَّذَّات حتَّى","قرعت بهم من الغايات بابا",57,"ب",2,0],["عكاءُ قاهرة الآساد في أجم","علياء فاخرت الأفلاك بالأجمِ",58,"م",1,0],["عكَفَ الشِّعْرُ على أوصافه","فهو الروضُ أصابَ المَنهَلا",59,"ل",2,0],["عكفنا على حاناتِها فكأنّها","مشاعرُ تقوىً أُوثرت أو مناسكُ",60,"ك",1,0],["عكفت بقبرك أحمد حنانة","تذري عليك مدى الزمان دموعا",61,"ع",2,0],["عكفت بأبلج بالحديد مثقَّلِ","عن معتفيهِ بالنضار مخفف",62,"ف",1,0],["عُكوفُهُمُ عَلى الأَصنا","مِ لَم يَرضَوا بِها بَدَلا",63,"ل",2,0],["عَكَفَ اللَيلُ عَلى آثارِنا","مِثلَ ما حَنَّت عَلى البَوِّ الظُؤارُ",64,"ر",1,0],["عكفنا على ما تعلمون من التُّقى","وأنتمْ على ما يعلمُ اللّهُ عُكَّفُ",65,"ف",1,0],["عَكَفَت عَلى الصَفصافِ مِنكَ عَزيمَةٌ","مِن رَأيِ مُكتَنِفٍ بِنَصرٍ أَيِّدِ",66,"د",1,0],["عكس البليغ بليغ العكس في عذلي","يا عاذلي فدع التبديل في الكلم",67,"م",1,0],["عكفوا عليها لائذين بحبها","إن المحبة دكها في طورها",68,"ر",3,0],["عَكَسَ الزَّمانُ وما أشُكُّ بأنَّه","في الأصلِ كُنيَتُه أبُو العَكّاس",69,"س",1,0],["عُكُوسٌ تَمرَضُ المُهُجاتُ مِنها","وَلَيس مَريضُ حَسرَتِها يَبَلُّ",70,"ل",1,0],["عَكَفَت سليمانٌ عَليكَ وأدلَجَت","فِئةٌ لِضَعفَةِ حَدِّها لَم تَعكِفِ",71,"ف",1,0],["عكفتُ عَلى الآداب قَبل فطامي","وَهمتُ بِها حَتّى بَلغت مَرامي",72,"م",2,1],["عكفت عليه العين تنظر حسنه","فبحسنه قد قيد الأحداقا",73,"ق",2,0],["عكفت بحضرتك الكرام وطالما","هوت الملوك فقبلت أعتابها",74,"ب",3,0],["عكفنا بها حتى الصباح وتارة","يناولني حرفا ويمزجه رشفا",75,"ف",2,0],["عكفت على شرب الدخان وفي الحشا","لهيب جوى فازددت جمرا على جمر",76,"ر",1,1],["عكفنا منهُ في أوط","فَ فيه الوحشُ مَعكوفه",77,"ف",2,0],["عكّس حتى ثمرها","وزويت أمور عظام",78,"م",1,0],["عَكَفَ الزُّبَيرُ عَلى الضَلالَةِ سائِساً","وَإِمامُهُ المَشهورُ كَلبُ النارِ",79,"ر",1,1],["عكازتاكِ على المنأى دماؤكِ وال","دموع ُفاحتملي الأثنين واندفِعِي",80,"ع",2,0],["عكس القصد أخفر العهد حتى","آل إرْغامُ أنفه للنفاد",81,"د",1,0],["عكلى ترى هواي قُسيمَه اعفُقه","قل لُو: البُوَيذنجين كيف انقلا",82,"ل",2,0],["عكفت على أهل العراق فذللت","من جانبيه كل صعبٍ أعسر",83,"ر",1,0],["عُكوفٌ على أصنامهم يعبدونها","وليس لهم ربٌّ سواها ومذهب",84,"ب",1,0],["عكا تنادي اللطف يا مولاي من","هذا الظلوم فكم دمٍ فيَّ سفكْ",85,"ك",1,0],["عَكَفَتْ عَلَيْهِ شُهورُها فَتَسَرْبَلَتْ","حُلَلَ 