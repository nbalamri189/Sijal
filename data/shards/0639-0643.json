{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[77,"ودير أنخنا في قرارته العيسا","https://www.aldiwan.net/poem35886.html","الطويل"],[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"يا من زهت عن أن تماشي شخصها","https://www.aldiwan.net/poem19107.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[85,"أبولو مرحباً بك يا أبولو","https://www.aldiwan.net/poem8077.html","الوافر"],[45,"وإذا مضى للمرء من أعوامه","https://www.aldiwan.net/poem62726.html","الكامل"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[2,"هاج الفؤاد معارف الرسم","https://www.aldiwan.net/poem25007.html","الكامل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[69,"ذاب من ثغرك قلبي","https://www.aldiwan.net/poem29077.html","مجزوء الرمل"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"يا بريد الدهر يمشي خفية","https://www.aldiwan.net/poem43137.html","الرمل"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[105,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[105,"عكاشة ما في الغمر من متخلف","https://www.aldiwan.net/poem43584.html","الطويل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"نفر النوم واحتمى","https://www.aldiwan.net/poem65232.html","مجزوء الخفيف"],[46,"كيف احتيالك والقضاء مدبر","https://www.aldiwan.net/poem22563.html","الكامل"],[46,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85506","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39680","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54311","الخفيف"],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""]],"verses":[["عَكَفوا عَلى العَلياءِ ما","فيهِم عَلى مَجدٍ ضَنينُ",0,"ن",1,0],["عُكوفٍ علَى التِّمْثالِ يستَلِمونَهُ","ويُعْنَوْنَ بالإنْجيلِ حِفْظاً وتَدْريسا",1,"س",2,0],["عكَفْنا علَيْهِ والبُروقُ كأنّها","مُطهّمةً شُقرٌ تبارَتْ الى السّبْقِ",2,"ق",1,0],["عُكَاظِيًّا أَبُوه أَبو إِياد","صَحِيحَاً لاَ عَوارَ وَلاَ دَهِينا",3,"ن",2,0],["عكس الضنى والسهد حالي فاغْتدى","نومي سباتي والنهار معاشي",4,"ي",1,0],["عكستْ أمْريَ النحوسُ فعنزي","أبداً حائلٌ وتيسي حلوبُ",5,"ب",1,0],["عكف الرأيُ عليكم وحدكم","والهوى يَعبدُ جهلاً وثَنَه",6,"ن",2,0],["عَكَفنا عَلَيهِ نَجتَني مِن فُنونِهِ","فَعَلَّمَنا هَذا الكَلامَ المُؤَنَّقا",7,"ق",2,0],["عُكاظُ وَأَنتِ لِلبُلَغاءِ سوقٌ","عَلى جَنَباتِها رَحَلوا وَحَلّوا",8,"ل",3,0],["عَكَفَت عَلَيهِ المُخزِياتُ وَقُلنَ قَد","أَضحَكتَنا وَسَرَرتَنا لا تَبرَحِ",9,"ح",1,0],["عَكَسَت حَظُّهُ اللَيالي وَباتَ ال","مُشتَري فيهِ وَهوَ كَوكَبُ نَحسِ",10,"س",1,0],["عَكَراً إِذا ما راحَ سَربُهُمُ","وَثَنوا عُروجَ قَنابِلٍ دُهمِ",11,"م",1,0],["عُكُفٌ بِجِذلٍ لِلطِعانِ لِقاؤُهُ","خَطَرٌ إِذا خَطَرَ القَنا الخَطّارُ",12,"ر",1,0],["عُكِسَ الأمرُ لعكسي","بَرَدٌ ذَوَّبَ جمراً",13,"ر",2,0],["عَكَفَتْ عَلَى الأصنْامِ واتَّخذَتْ","دينَ العَمَى من دينها بَدَلا",14,"ل",2,0],["عكفوا على أعراسهم وبلادُهم","في مأتمٍ من همّها وحِدادِ",15,"د",1,0],["عكفوا على نار الخلافِ فسرّهم","ما جرَّ مُوقِدُها وذاقَ الصّالي",16,"ل",2,0],["عَكَسوا الأَشياءَ حَتّى جُعِلَت","تَسفُلُ الهامُ وَتَعلو الأَرجُلُ",17,"ل",1,0],["عَكَفَت عَلَيهِ الطَيرُ تَحسَبُ أَنَّما","طاحَت بِهِ أَيدي الرَدى وَكَأَنْ قَدِ",18,"د",1,0],["عَكفتَ على البَغْيِ المُذمَّمِ والأذَى","فَذُبْ أسفاً واعْكُفْ على النَّارِ صَاليا",19,"ي",2,0],["عُكاشَةُ ما في الغَمْرِ من مُتْخلَّفٍ","خلا الغَمْرُ من عُمَّارِهِ فَهْوَ مُقْفِرُ",20,"ر",1,1],["عُكَاشَةُ عُدْ بالجندِ غيرَ مُخيَّبٍ","كفى القومَ خِزْياً أن يَفِرُّوا ويُدبِرُوا",20,"ر",3,0],["عَكَفوا على آيِ الكتابِ فأفْلَحُوا","والجاهلونَ على المآثِمِ عُكَّفُ",21,"ف",1,0],["عكسوا الزّمانَ عَواثنِاً ودواخنِاً","فالصُّبْحُ ليلٌ والظَّلامُ نهار",22,"ر",1,0],["عَكَفَ الحُبُّ عيرَهُ","في فُؤادي وَخَيَّما",23,"م",2,0],["عُكِسَ الأَنامُ بِحِكمَةٍ مِن رَبِّهِ","فَتَحَكَّمَ الهَجَرِيُّ فيهِ وَسَنبَرُ",24,"ر",1,0],["عَكَرُ العَيشِ في إِنائي وَهَل يُؤ","مَلُ مِن صَفوِهِ وَقَد فاتَ عَكرُ",25,"ر",1,0],["عكر اللفظ ما عليه صفاءٌ","تافه المعنى ما عليه قبول",26,"ل",1,0],["عكّاءُ في الساحلِ الشرقيّ شامخةٌ","تطاولُ النجمَ أبراجاً وأسوارا",27,"ر",2,1],["عَكُوفٌ عَلَى التَّحْصِيلِ مِنْ كُلِّ مَطْلَبٍ","يُلِمُّ بِهِ مَهْما يَسُمْهُ عَنَاءَ",28,"ا",2,0],["عَكَفتُ عَلى الأَحزانِ بَعدَكَ جافِياً","لِقَبرِكَ إِنّي لَستُ أَبرَحُ مُعكفِ",29,"ف",1,0],["عُكِس الحال لا محالة لكن","ربّما أنجد الغريقَ الماء",30,"ا",2,0],["عكوفا على اللذات من قبل فوتها","حريصا على الإرشاد في منهج الحق",31,"ق",1,0],["عُكِسَتْ آيةُ الفضائلِ فالأعلى","مَقاماً من كانَ في النفس أدْنى",32,"ن",2,0],["عكفتْ أنفسٌ هناك على الأفراحِ","والأنسِ بين خَمرٍ وهيف",33,"ف",1,0],["\" عُكاظُ \" من الشعر تحتلّهُ","ويرعاهُ \" حافظُ \" حتى ازدهر",34,"ر",1,0]]}