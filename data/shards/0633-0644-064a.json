م الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[515,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[516,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[516,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[539,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[541,"كأني من تذكر ما ألاقي","https://www.aldiwan.net/poem56627.html","الوافر"],[541,"لما رأيت الحادثات كنفنني","https://www.aldiwan.net/poem56677.html","الطويل"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[563,"لعمرك ليس في الدنيا خليل","https://www.aldiwan.net/poem52737.html","الوافر"],[563,"أهلا بعائدة أتت تشفيني","https://www.aldiwan.net/poem52758.html","الكامل"],[563,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[563,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"],[563,"كثيب فوقه غصن رطيب","https://www.aldiwan.net/poem52890.html","الوافر"],[563,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[563,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[568,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[588,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"]],"verses":[["سَلي بي جَولَةَ الخَيلِ","وَمُلتَفَّ العَجاجَينِ",0,"ن",1,0],["سَلي عَن هَيئَةِ السَيفِ","شُجاعَ القَومِ لا القَينا",1,"ن",2,0],["سُلَيمانُ دَلَّتني يَداكَ عَلى الغِنى","وَأَجرَيتَ لي عَزماً أَغَرَّ مُحَجَّلا",2,"ل",2,1],["سَلّى عَنِ العَيشِ أَنّا لا نَدومُ لَهُ","وَهَوَّنَ المَوتَ ما نَلقى مِنَ العِلَلِ",3,"ل",1,0],["سَلي عَن فَمي فَصلَ الخِطابِ وَعَن يَدي","رِماحاً كَحَيّاتِ الرِمالِ طِوالا",4,"ل",2,0],["سَلي بي أَلَم أَنغَلُّ في لَهَواتِها","وَفَحلُ الرَدى دوني بِنابَيهِ يَصرُفُ",5,"ف",1,0],["سَلي بي أَلَم أَحمِل عَلى الضيمِ ساعِدي","وَقَد ثُلِمَ الماضي وَرُضَّ المُثَقَّفُ",5,"ف",1,0],["سَلي بي أَلَم أَثنِ الأَعِنَّةَ ظافِراً","تُحَدِّثُ عَن يَومي نِزارٌ وَخِندِفُ",5,"ف",1,0],["سَلي بي أَلَم أَصبِر عَلى الظَمءِ بَعدَما","هَوى بِالمَهاري نَفنَفٌ ثُمَّ نَفنَفُ",5,"ف",1,0],["سَليباً يُخَفِّفُ حَتّى رَمى","مِنَ الرُعبِ بِالدِرعِ وَالمِغفَرِ",6,"ر",1,0],["سُلَيمانُ لَو وَفَّيتَ مَدحِيَ حَقَّهُ","أَرَيتُكَ أَسبابَ المُنى كَيفَ تَنجَحُ",7,"ح",1,1],["سَليهِ يُكلِّمْنا فإِنَّ اخْتِيالَهُ","على ما بِهِ مِنْ خَلَّةٍ لَعَجيبُ",8,"ب",1,0],["سَلي ابْنَيْ نِزارٍ عنْ جُدودي بَعْدَما","سمِعْتِ ببأْسي إذْ هزَزْتُ نِصالي",9,"ل",2,0],["سَليلُ مُلوكٍ منْ نِزارٍ تَخيّروا","لهُ سَرَواتِ المُحْصَناتِ الحَرائِرِ",10,"ر",1,0],["سَلي يا بْنَةَ القَومِ عمّنْ تَضُمُّ","دِرْعي وبُرْديَ عمّا حَواهْ",11,"ا",2,0],["سَلي عَنّا الفَزارِيِّينَ لَمّ","شَفَينا مِن فَوارِسِها الكُبودا",12,"د",2,0],["سَلي يا عَبلَ قَومَكِ عَن فَعالي","وَمَن حَضَرَ الوَقيعَةَ وَالطِرادا",13,"د",2,0],["سَلي يا اِبنَةَ الأَعمامِ عَنّي وَقَد أَتَت","قَبائِلُ كَلبٍ مَع غَنِيٍّ وَعامِرِ",14,"ر",1,0],["سَلي سَيفي وَرُمحي عَن قِتالي","هُما في الحَربِ كانا لي رِفاقا",15,"ق",2,0],["سَلي فَزارَةَ عَن فِعلي وَقَد نَفَرَت","في جَحفَلٍ حافِلٍ كَالعارِضِ الهَطِلِ",16,"ل",1,0],["سَلي يا اِبنَةَ العَبسِيِّ رُمحي وَصارِمي","وَما فَعَلا في يَومِ حَربِ الأَعاجِمِ",17,"م",1,1],["سَلي يا عَبلَةُ الجَبَلَينِ عَنّا","وَما لاقَت بَنو الأَعجامِ مِنّا",18,"ن",2,1],["سَلي إِن جَهِلتِ الحُبَّ مَن ذاقَ طَعمَهُ","وَإِن كُنتِ لا تَلقَين مِثلي مُخبِرا",19,"ر",2,0],["سَلي عَن مَبيتي مَن رَأى ذَلِكَ البَلا","فَباتَ مَبيتي في عَذابٍ وَفي كَربِ",20,"ب",1,0],["سَلي هَل قَلاني مِن عَشيرٍ صَحِبتُهُ","وَهَل مَلَّ رَحلي في الرِفاقِ رَفيقُ",21,"ق",1,0],["سَلي الناسَ هَل خَبَّرتُ سِرَّكِ مِنهُمُ","أَخا ثِقَةٍ أَو ظاهِرَ الغِشِّ بادِيا",22,"ي",2,0],["سَليلَ الطينِ كَم نِلنا شَقاءً","وَكَم خَطَّت أَنامِلُنا ضَريحا",23,"ح",2,1],["سَليلُ مُلوكٍ يَشهَدُ اللَهُ أَنَّهُم","أَقاموا عَمودَ الدينِ لَمّا تَهَدَّما",24,"م",2,0],["سُلَيمانُ ذَكَّرتَ الزَمانَ وَأَهلَهُ","بِعِزِّ سُلَيمانٍ وَإِقبالِ دُنياهُ",25,"ا",2,0],["سُلَيمانُ دُم ما دامَتِ الشُهبُ في الدُجى","وَما دامَ يَسري ذَلِكَ البَدرُ مَسراهُ",25,"ا",2,0],["سُلَيمانُ السُلَيمانِيُّ يَبغو","وَيُصفعُ دائِماً في أَخدَعَيهِ",26,"ي",2,1],["سُلَيمانَ وَالجاموسِ وَالصَدرِ وَاِبنِهِ","وَأَصهارِهِم وَالناصِحَينِ وَجامِعِ",27,"ع",1,0],["سَليمَ الشَظى عَبلَ الشَوى شَنَجَ النَس","لَهُ حَجَباتٌ مُشرِفاتٌ عَلى الفالِ",28,"ل",1,0],["سليلة المرء الكبير الحمى","كريمة العلامة الأفضل",29,"ل",1,0],["سَليمٌ العَلَمُ الفَرْدُ الَّذِي بَعُدَتْ","بِهِ النَّوى وَهْوَ فِي آثَارِهِ دَانِي",30,"ن",2,0],["سَلِيمٌ العَلَمُ الفَرْدُ الَّذِي بَعُدَتْ","بِهِ النَّوَى وَهْوَ فِي آثَارِهِ دَانِ",31,"ن",1,0],["سَلي النَاسَ هَل أَرضى عَدُوَّكِ أَو بَغى","حَبيبُكِ عِندي حاجَةً لا يَنالُها",32,"ل",3,0],["سلي عنيّ الكواكب وهي تسري","بجنح الليل تطلُع أو تغيب",33,"ب",1,0],["سلى ذا الفتى يا أم أين مضى أبي","وهل هو يأتينا مساءً بمَطْعَم",34,"م",1,0],["سُلَيمٌ وَذُبيانٌ وَعَبسٌ وَعامِرٌ","حُصونٌ إِلى عِزٍّ طِوالٌ عُمورُها",35,"ر",3,0],["سُلَيمانُ المُبارَكُ قَد عَلِمتُم","هُوَ المَهدِيُّ قَد وَضَحَ السَبيلُ",36,"ل",1,0],["سَلي فَتَياتِ هَذا الحَيِّ عَنّي","يَقُلنَ بِما رَأَينَ وَما سَمِعنَه",37,"ن",2,1],["سَلي عَنّا سَراةَ بَني كِلابٍ","بِبالِسَ عِندَ مُشتَجَرِ العَوالي",38,"ل",2,1],["سَليماً عَلى طَيِّ الزَمانِ وَنَشرِهِ","أَميناً عَلى النَجوى صَحيحاً عَلى البُعدِ",39,"د",1,0],["سليمان ملاَّك المعالي وإنه","بآية طوفان المكارم نوحها",40,"ح",3,0],["سليل علاً شفت مخايل مجده","ودلَّت كما دلَّ الفرند على النصل",41,"ل",1,0],["سليل عماد الدِّين إنك بعده","مصاعد ما همَّ الزمان بلثمها",42,"م",3,0],["سليمُ الزمان كمنكوبِهِ","وموفورُهُ مثلُ محروبِهِ",43,"ب",2,1],["سَلَّيْتُ نفسي بأفاعِيله","من بعد ما قد كنت أسَّفْتُهَا",44,"ت",3,0],["سُليمانُ مَفْسدةُ المملكَهْ","فأهلكَهُ اللَّهُ واستدْركَهْ",45,"ك",2,1],["سليمانُ ميمونُ النقيبةِ حازمُ","ولكنَّه حتْمٌ عليه الهزائمُ",46,"م",1,1],["سليلُ تَقيٍّ نَقيِّ الجيو","بِ من دنسَ العابِ والمأثم",47,"م",1,0],["سَلي الطارِقَ المُعتَرَّ يا أُمَّ مالِكٍ","إِذا ما أَتاني بَينَ قَدري وَمَجزِري",48,"ي",1,1],["سَلي تَعَلمي إِن كُنتِ عالِمَةٍ","بِأَنَّ لَيسَ في حُبّي لِغَيركِ مَطمَعُ",49,"ع",1,1],["سلى بي القوم قبل اللوم باحثة","وبعد ذلك يا لوامتي لومي",50,"ي",1,0],["سليماً يظل الخيط بين اولى النهى","وينقطع الجنزير بين المجانين",51,"ن",1,0],["سَلي مَن راعَ غيدَكِ بَعدَ وَهنٍ","أَبَينَ فُؤادِهِ وَالصَخرِ فَرقُ",52,"ق",1,0],["سَل يَلدِزاً ذاتَ القُصورِ","هَل جاءَها نَبَأُ البُدور",53,"ر",1,1],["سَلي عَن سيرَتي فَرَسي وَسَيفي","وَرُمحي وَالهَمَلَّعَةِ الدِفاقا",54,"ق",2,0],["سَليلُ المَعالي وَالفَخارِ وَإِنَّما","يَتيهُ وَيُزهي بِالمَعالي سَليلُها",55,"ل",3,0],["سُلَيمانُ غَيثُ المُمحِلينَ وَمَن بِهِ","عَنِ البائِسِ المِسكينِ حُلَّت سَلاسِلُه",56,"ل",2,0],["سُليمُ بنُ مَنصورٍ وَأَفناءُ عامِرٍ","وَسَعدُ بنُ بَكرٍ وَالنُصورُ وَأَعصُرُ",57,"ر",1,0],["سَليمُ العَرضِ مَن حَذِرَ الجَوابا","وَمَن دارى الرِجالَ فَقَد أَصابا",58,"ب",2,1],["سَليمَ دَواعي الصَدرِ لا باسِطاً يَداً","وَلا مانِعاً خَيراً وَلا قائِلاً هُجرا",59,"ر",2,0],["سَليلُ صَفِيِّ المُصطَفى وَاِبنُ سِبطِهِ","لَقَد تابَ مِنهُ الأُمُّ وَالأَبُّ وَالجَدُّ",60,"د",1,0],["سَليلُ النَبِيِّ المُصطَفى وَاِبنُ عَمِّهِ","وَنَجلُ الوَصِيِّ الهاشِمِيِّ لِصُلبِهِ",61,"ب",2,0],["سَليلُ المُلوكِ","الكُماةِ الحُماه",62,"ه",1,0],["سَلي الرِماحَ العَوالي عَن مَعالينا","وَاِستَشهِدي البيضَ هَل خابَ الرَجا فينا",63,"ن",2,1],["سلي شجونَكِ بالنجو","مِ عَقَدنَ عرساً للقمَر",64,"ر",1,0],["سلي قليلاً واهدئي","أَنُضَيِّعُ في الدمعِ العُمُر",64,"ر",1,0],["سَليلُ المُلوكِ الغُرِّ يُؤنِسُهُ النّدى","إذا ما عُلاهُ أَوحَشَتهُ مِنَ النِّدِّ",65,"د",1,0],["سليلُ تميم بن المعزّ الذي له","مطالعُ فخرٍ في العلى تُطلعُ الشّهبا",66,"ب",2,0],["سَليلُ الشَمسِ أَنتَ فَدَتكَ نَفسي","وَهَل لِسَليلِ شَمسٍ مِن شَبيهِ",67,"ي",2,0],["سَلي هَل عَمَرتُ القَفرَ وَهوَ سَباسِبٌ","وَغادَرتُ رَبعي مِن رِكابي سَباسِبا",68,"ب",2,0],["سَلِيمُ نَوَاحِي الصَّدْرِ لا يَسْتَفِزُّهُ","نِزَاعٌ إِلَى الْبَغْضَاءِ وَالشَّنَآنِ",69,"ن",1,0],["سلي النجمَ عن حالي يُخَبِّرْك لوعتي","وما أنا فيه مِنْ بكاءٍ ومنْ سهدِ",70,"د",1,0],["سَلي هَل قَلاني مِن عَشيرٍ صَحِبتُهُ","وَهَل ذَمَّ رَحلي في الرِفاقِ رَفيقُ",71,"ق",1,0],["سَلي اللَيلَ عَنّي هَل أَذوقُ ر