{"poems":[[74,"رب صديق كلغز سيدنا","https://www.aldiwan.net/poem19545.html","المنسرح"],[53,"يا أبا حفص المبرز في الشعر","https://www.aldiwan.net/poem65798.html","الخفيف"],[91,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[87,"مرت على الخفاش","https://www.aldiwan.net/poem8037.html","مجزوء الرجز"],[63,"رب صاف رقرقته الريح","https://www.aldiwan.net/poem51758.html","مجزوء الرمل"],[51,"قل لمم يعجب من حسن","https://www.aldiwan.net/poem63061.html","مجزوء الرمل"],[104,"اغفري لي إذا اتهمتك بالغد","https://www.aldiwan.net/poem33102.html","الخفيف"],[54,"قف خليلي نسأل لشرة دارا","https://www.aldiwan.net/poem27045.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85380","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55060","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[124,"تقبس النار وإن طال القدم","https://www.aldiwan.net/poem49356.html","الرمل"],[201,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[226,"رب لحن سرى مع النسمات","https://www.aldiwan.net/poem55258.html","الخفيف"],[228,"قوني يا مقسم الأعباء","https://www.aldiwan.net/poem39725.html","الخفيف"],[234,"رب صفراء عللتني بصفرا","https://www.aldiwan.net/poem51071.html","الخفيف"],[276,"كل شيء منكم عليكم دليل","https://www.aldiwan.net/poem52133.html","الخفيف"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[406,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[422,"قد ذكرناكم على بعد المزار","https://www.aldiwan.net/poem53843.html","الرمل"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[615,"","https://poetry.dctabudhabi.ae/diwan/poem/34538","الخفيف"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/103982","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37943","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70658","الخفيف"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44790","السريع"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75763","الخفيف"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128279","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26537","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104814","الخفيف"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144360","الرمل"],[2903,"","https://poetry.dctabudhabi.ae/diwan/poem/204551",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200903","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203053","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205689","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81280","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83518","الخفيف"],[5111,"صَرْحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212514",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5409,"يا شبابي لم يصبني لك ذكر","https://www.poetsgate.com/ViewPoem.aspx?id=155268",""],[5431,"وكأني بروحه الموسيقا","https://www.poetsgate.com/ViewPoem.aspx?id=197665",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5722,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=12682",""],[5785,"لا رعى الله من بالجفا والهجر شار","https://www.poetsgate.com/ViewPoem.aspx?id=131574",""],[5853,"((غيمٌ بلا مخاض))","https://www.poetsgate.com/ViewPoem.aspx?id=175650",""],[5853,"(( لي حبيبٌ))","https://www.poetsgate.com/ViewPoem.aspx?id=175657",""],[5997,"بيّاع الأضاحي","https://www.poetsgate.com/ViewPoem.aspx?id=215045",""]],"verses":[["ربَّ صديق كلغز سيدنا","بخالصِ الودّ ثم ينتقل",0,"ل",1,1],["ربّ صفعٍ مُشَعشعٍ لي في رأ","سكَ شهَّاك وقْعُهُ صفْع نفسِكْ",1,"ك",1,0],["رب صوت من الغناء رقيق","طال عند استماعه استعباري",2,"ر",2,0],["رُبَّ صَديقٍ عَبدِ","أَبيَضُ وَجهِ الوُدِّ",3,"د",1,0],["رُبَّ صافٍ رَقْرَقَتْه الرْ","يحُ في متنِ صَفاةِ",4,"ه",1,1],["رُبَّ صَدٍّ بَعدَ وُدٍّ","وَهَواً بَعدَ تَقالِ",5,"ل",1,0],["رُبَّ صَرحٍ مَمرَّد مِن أَماني","ي أَظَلَّ النُجوم تَحتَ جَناحِهِ",6,"ه",1,0],["رُبَّ صادٍ إِلى حَديثِكِ خَلّا","بٍ وَقَد طافَ حَولَ سَرّي وَدارا",7,"ر",2,0],["رب صنها حتى تَكون فَتاة","ثم أمّاً تَرعى ابنها ليُهذَّب",8,"ب",1,0],["رَبِّ صُنْ فَيْصَلاً مَلِيكَ العِرَاقِ","وَأَدِمْهُ كَالشَّمْسِ فِي الإِشْراقِ",9,"ق",1,1],["رُبَّ صَمْتٍ مِنَ الَبَيَانِ رَهِيبٍ","حُرِمَتْهُ مَقَاوِلُ الْبُلَغَاءِ",10,"ا",2,0],["رُبَّ صِدْقٍ تَوَدُّ لو كَانَ كِذْباً","وكِذَابٍ لو كانَ غَيْرَ كِذَاب",11,"ب",1,0],["رُبَّ صَدْرٍ نَافَسَ الْحِلْمُ به","كُلَّ صَحْراءَ بَعِيدٍ مُنْتهاها",12,"ا",3,0],["رب صوتٍ نبهت نائمه","بسمع السامع منه كالنغم",13,"م",1,0],["رُبَّ صمتٍ يا صاح أوقعُ بل","أبلغُ في سحرهِ منَ التنزيلِ",14,"ل",1,0],["رب صوت سمعته من بعيد","دلني وقعه على الحركات",15,"ت",1,0],["رَبِّ صُنها وَأَبقِها لِيَ ظِلّاً","مِن حَنانٍ يَمتَدُّ في صَحرائي",16,"ي",1,0],["ربَّ صفراء علَّلتني بصفرا","ء وجِنْح الظلام جَوْن الإزار",17,"ر",1,1],["رب صفحا فان ذَنبي كَبير","واِصطباري عَلى العَذاب قَليل",18,"ل",1,0],["رَبَّ صَلاحٍ وَتُقى","يَنهاه عَمّا يُتَّقى",19,"ق",2,0],["رُبَّ صوتٍ، يزيل عنَّا غبار","ويجلِّي أحلامَنا، ويُرينا:",20,"ن",2,0],["ربَّ صَحْبٍ نظمت شملهم","ليلةٌ أحسن من نظم الدراري",21,"ر",2,0],["رُب صَفوٍ رُبَّ عفوٍ","رُبَّ حَزمٍ رُبَّ عَزمِ",22,"م",1,0],["رُبَّ صَهباءَ مِن شَرابِ المَجوسِ","قَهوَةٍ بابِلِيَّةٍ خَندَريسِ",23,"س",1,1],["رُبَّ صغير الخلق ذي دهاء","يَستنزلُ الصَّير من السَّماء",24,"ا",2,1],["رَبِّ صَبراً وَرِضاءً","بِالّذي يَقضي القضاءُ",25,"ا",2,0],["رب صَلِّى عليه ما طلعت شمْ","سٌ وما اجلوّذَ البهم الهادى",26,"د",2,0],["رُبَّ صَغيرٍ لَكَ خَلَّفتَهُ","مُنتَظِراً إِيّاكَ حَتّى تَؤوبْ",27,"ب",1,0],["رب صبر له كَتائِب رحمى","زاحِفات عَلى البلا أَنصار",28,"ر",1,0],["رب صعب القياد ذلله الما","ل كما ذلل البعير الخطام",29,"م",1,0],["رُبَّ صَوتٍ حَسَنٍ ين","بِتُ في الرَأسِ قُرونا",30,"ن",2,0],["رَبِّ صَلِّ على النَّبِى","شافِعِ الخَلقِ فى المَعاد",31,"د",1,1],["رب صفراء تردت","برداء العاشقينا",32,"ن",2,1],["رب صوت حسن قد","ألبس الراس قرونا!",33,"ن",2,0],["ربّ صديق خان الوداد معي","وكان كالروح لا يفارقني",34,"ي",1,1],["رب صخر منمنم برياض","وبياض منمق باخضرار",35,"ر",1,0],["رب صدرٍ من خالص النور تهوَى","لَو حكته الجنة النضراء",36,"ا",2,0],["رب صب هوى الجَمال فَأَضحى","مستهاماً تُبيدُه البَيداء",36,"ا",2,0],["ربَّ صلاةٍ علَّمت مصليًا","إجابةَ الصلاة والرجاء",37,"ا",2,0],["رب صلاحٍ وتقى","ينهاك عما يتقي",38,"ي",1,0],["رب صلب مِن صَخرِها ظَل يندى","وَعصي مِن عودها لَم يعاسر",39,"ر",1,0],["ربّ صَلِّ عَلَيه خير صَلاةٍ","وَعلى صحبِه وَكُلّ نَسيبِ",40,"ب",1,0],["رُبَّ صَرْحٍ مِنْ خَيَالٍ","قَدْ تَهَاوَى فِيْ ثَوَانِ",41,"ن",1,0],["رب صنا من صرف دهر يدي من","ه عبوس مشوه وكلوح",42,"ح",1,0],["رب صمت يملي عليك حديثاً","مسهباً كل لفظةٍ منه سفر",43,"ر",1,0],["ربّ صوتٍ لمهجتي ليس أحلى","سالَ بالروح كوثرا كي تذوقا",44,"ق",2,0],["ربّ صوتٍ محلّقٍ في سموٍ","فغزانا موّلها معشوقا",44,"ق",2,0],["رُبَّ صيْفٍ دَرَسْتُ قَمْحاً على","البَيْدَر ِفيها ودَقَّهُ الطّاحونُ",45,"ن",1,0],["رُبَّ صِنْديدٍ خاضَ هولَ الوغى","مستشهداً وهْو بالخُلود قَمينُ",45,"ن",1,0],["رُبَّ صحراءَ طوَّفَ الحبُّ فيها","أزهرتْ ربوةً وروضاً عشيبا",46,"ب",2,0],["ربّ صلي على الطهر ماناح الهزاز","وعلى الآل في جنح الأغلاس",47,"س",1,0],["رُبَّ صخرٍ منَ الغرام تداعى","هزّهُ الشوق ُ لوعةً فتكلمْ",48,"م",1,0],["رب صمت..أيا. ...حبيبة قلبي","لغرامي صداه صار انفجارا",49,"ر",2,0],["رُبّ صمتٍ لا يوالي ربَّهُ","إن طغى حداً يشقّ الناصيه",50,"ي",2,0]]}