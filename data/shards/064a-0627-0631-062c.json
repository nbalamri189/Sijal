{"poems":[[95,"يا رجاء الوطن","https://www.aldiwan.net/poem11167.html","مجزوء الرمل"],[53,"يا رجلا أوفى على كل رجل","https://www.aldiwan.net/poem65868.html","الرجز"],[45,"إنما التهنئات للأكفاء ولمن يدني من البعداء","https://www.aldiwan.net/poem9447.html","الخفيف"],[68,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[104,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20250","الرمل"],[108,"حرب الأعداء الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=179643",""],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[92,"يراع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=179189",""],[53,"يا رجلاً أوفى على كلُّ رجلْ","https://www.poetsgate.com/ViewPoem.aspx?id=30258",""],[119,"يا رجال البطاح يا ساداتي","https://www.aldiwan.net/poem41205.html","عموديه"],[203,"نعس النجم ولم أنم","https://www.aldiwan.net/poem45362.html","المديد"],[358,"يا رجائي في شدتي ورخائي","https://www.aldiwan.net/poem40841.html","الخفيف"],[409,"يا رجائي وهل سواك رجائي","https://www.aldiwan.net/poem34178.html","الرمل"],[466,"هو في ناديه طود راسخ","https://www.aldiwan.net/poem15398.html","الرمل"],[466,"اذا اطباها الناضر الحزني","https://www.aldiwan.net/poem15584.html","الرجز"],[505,"يا رجال الغيب أين الهمم","https://www.aldiwan.net/poem37787.html","الرمل"],[563,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[563,"شمس باء الوجود ذات غروب","https://www.aldiwan.net/poem34937.html","الخفيف"],[567,"ليس يجري غير ما الله كتب","https://www.aldiwan.net/poem52773.html","الرمل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126754","الخفيف"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104439","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48811","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48799","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48816","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48817","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48858","الخفيف"],[978,"","https://poetry.dctabudhabi.ae/diwan/poem/73897","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126145","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136361","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49011","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125461","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125419","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125371","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125492","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69339","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27203","المديد"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101400","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100926","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130821",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74061","السريع"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145120","الرمل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125952","الرمل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123529","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76503","الرمل"],[4096,"","https://poetry.dctabudhabi.ae/diwan/poem/100004","المنسرح"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136675",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83669","الرمل"],[4755,"يا رَجْفةَ المَقصوفِ والقاصِفَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183781",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5277,"طويتُ غرامَها","https://www.poetsgate.com/ViewPoem.aspx?id=191043",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5433,"عين تشربك شوف","https://www.poetsgate.com/ViewPoem.aspx?id=36228",""],[5455,"غربة أعياد","https://www.poetsgate.com/ViewPoem.aspx?id=34466",""],[5631,"عَلى تَقاسِيمِ البَياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=210481",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5948,"يا رجلاً خفَّ عندهَ الثِقَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=100602",""],[5976,"القلب داعي له","https://www.poetsgate.com/ViewPoem.aspx?id=32522",""],[6344,"حرّ في قبضة العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87983&r=&rc=23",""]],"verses":[["يَا رَجَاءَ الوَطَنِ","وَضِيَاءَ الأَعْيُنِ",0,"ن",1,1],["يا رجلاً أوفى على كلُّ رجلْ","يا مَنْ متى تُقَصِّر الناسُ يَطلْ",1,"ل",1,1],["يا رَجاءَ العُيونِ في كُلِّ أَرضٍ","لَم يَكُن غَيرَ أَن أَراكَ رَجائي",2,"ا",2,0],["يا رَجيمَ الخُطوبِ فَاِستَرِقِ السَم","عَ فَأُفقُ العُلى بِغَيرِ شِهابِ",3,"ب",1,0],["يا رجالَ البلادِ يا قادةَ الأُم","مَةِ ماذا دهاكُمُ ودهاها",4,"ا",3,0],["يا رِجالَ الجِدِّ هَذا وَقتُهُ","آنَ أَن يَعمَلَ كُلٌّ ما يَرى",5,"ر",2,0],["يا رجال البلادِ: مصرُ تنادي:","أين أهلُ الندَى وأهلُ السِّماح؟",6,"ح",1,0],["يا رجال الدين هل جاءكم","إن بدر الدين في الأرض أفل",7,"ل",1,0],["يا رجال الدين لا تهنأ لكم","فرصة إن مصاب الدهر حل",7,"ل",1,0],["يا رجال الدين لم ينزل بنا","فادح أعظم مما قد نزل",7,"ل",1,0],["يا رجال الدين أهلاً بالقضا","غاض هذا البحر واندك الجبل",7,"ل",1,0],["يا رجال الدين ما هذا الأسى","والأسى بالعقل والعقل ذهل",7,"ل",1,0],["يا رجال الدين ما حسن العزا","عن فقيد في السما والأرض جل",7,"ل",1,0],["يا رجال العلم أودى قطبكم","بل جميع العلم أودى والعمل",7,"ل",1,0],["يا رجاءَ الكونِ في محنته","يا شُعاعَ الأملِ المستعذَب",8,"ب",1,0],["يا رجلاً أوفى على كلُّ رجلْ","يا مَنْ متى تقصرُ الناسُ بَطلْ",9,"ل",1,1],["يا رجال البطاح يا ساداتي","من نداكم لا تقطعوا عاداتي",10,"ت",2,1],["يا رجالَ الشعرِ لستُ فتىً","إن أنا لم يطوكم علمي",11,"م",2,0],["يا رَجائي في شِدَّتي وَرَخائي","وَدَوائي إِذا تَحكّم دائي",12,"ا",2,1],["يا رجائي وهل سواك رجائي","أنت سؤلي في شدتي ورخائي",13,"ا",2,1],["يأرَجُ الدْهرُ بِرَيَّا نشْرهِ","فيفوقُ الحمدُ أنفاسَ الخُزامى",14,"م",2,0],["يأرَجُ منه الصُّبْحُ والعَشيُّ","مْنبتهُ الرِّمْثَةُ والنَّصيُّ",15,"ي",1,0],["يا رجالَ الغيبِ أينَ الهمَمُ","وأَياديكُمْ وأينَ الشِّيَمُ",16,"م",1,1],["يا رِجالَ اللهِ يا أَهلَ الوَحا","لاحِظونا ها هو الدَّمعُ دَمُ",16,"م",1,0],["يا رجال الغيب عيني شهدت","غيبكم كالبرق لما لمعا",17,"ع",2,0],["يا رجال الهوى قفوا لكلامي","واستعينوا به على المطلوب",18,"ب",1,0],["يا رجالَ الدَّهرِ هذا مُلحِمٌ","من بني رسلانَ أقيالِ العرَبْ",19,"ب",1,0],["يا رجالَ العُربِ الكرام ومن قد","غَنِموا مِن نتائجِ المجدِ ذُخرا",20,"ر",2,0],["يأرج بالمسك شذا لفظها","وتنثر الدر معانيها",21,"ي",3,0],["يا رجالَ البلاد حسبكم اليو","مَ رجوعُ الوفاقِ بعد الذهاب",22,"ب",1,0],["يا رجال البلاد من كل حزب","أين من تفزع البلاد إليهِ",23,"ي",2,1],["يا رجالَ القضيةِ الضخمة العس","راء بين الطغاةِ والأبرياء",24,"ا",2,0],["يا رجالَ البلادِ هذا أوانُ ال","فصلِ فاستقبلوهُ صحواً وصفوا",25,"و",2,1],["يا رجالَ الزمان أحسنتمُ ما","قلتمُ والزمانُ يطلب فعلا",26,"ل",2,0],["يا رِجالاً بَينَ أَعلامِ مِنىً","إِلثِموا الأَستارَ وَاِسعَوا رَمَلا",27,"ل",2,0],["يا رجائي وملجئي وغياثي","كن بما أرتجيه منك كفيلا",28,"ل",2,0],["يا رجال الغيب مالي ملجا","عند دهم الخطب إلاّ انتم",29,"م",1,0],["يا رجال الغيب قلت حيلتي","وعفى رسمي وزاد الألم",29,"م",1,0],["يا رجال الغيب كل منكم","للأمان والأماني حرم",29,"م",1,0],["يا رجال الغيب حسبي حبكم","يوم تدعى للحساب الأمم",29,"م",1,0],["يا رجالي طالت ليالي بعادي","واشتياقي إليكمو فادركوني",30,"ن",2,0],["يا رجائي يا خالقي يا غياثي","يا خبيراً بكل شيءٍ عليما",31,"م",2,0],["يا رجائي من الودود وقصدي","ونعيمي متى يكونُ التداني",32,"ن",2,0],["يا رجيم الدارينِ بئسَ خلودٌ","صدقت فيه آيةُ الرحمنِ",33,"ن",1,0],["يا رجاءَ العيونِ في كلِّ آنٍ","يا عظيمَ النُّهى عليك الثناء",34,"ا",2,0],["يا رجاءَ العيون إنَّ دموعي","شاهداتٌ بلوعتي وسَقامي",35,"م",2,0],["يا رجاءَ العُيُونِ في أرضِ مصر","لَيسَ بِدعاً إذا بكا الهَرَمانِ",36,"ن",1,0],["يا رجالَ العلمِ أنتُم","للهُدى رُسلُ السَّلام",37,"م",1,0],["يَأرِجُ في الحَزنِ مِن حَقائِبها","ما فاحَ مِن رَندِهِ وَمِن نَشَمِه",38,"م",2,0],["يا رجالاً غيرنا طلبوا","أين جود البحر من كرمي",39,"م",2,0],["يا رجال البأس في يوم الكفاح","يا ليوث الحرب في غاب الرماح",40,"ح",1,0],["يا رجال التمثيل شدُّوا الأواخى","وانهضُوا للعلا بشعبٍ وان",41,"ن",1,0],["يا رجالي إذا عصتكم حياة","فهو صعب المراس أني تجشم",42,"م",1,0],["يا رجل الشرق وَيا نطفه","وَيا مجيب الغرب إن نادى",43,"د",2,0],["يا رجاء النفس يا أقصا مناها","يا حبيب الروح يا كل هواها",44,"ا",3,1],["يا رجال الشعر قوموا وانظروا","صورة للبائس المنهزم",45,"م",1,0],["يأْرَجُ بالنَّسِيم عَرْفُ الرَّنْدِ","والقَدْحُ أصلٌ في ثُقوبِ الزَّنْدِ",46,"د",1,0],["يا رِجال الغَرب رفقا ما لكم","ليسَ ينأى عَن اياديكم زناد",47,"د",1,0],["يا رجعَ طرفي ويا يميني في ال","روْعِ ويا مُهجتي ويا كبدي",48,"د",2,0],["يا رجاء الوصال كذَّبك اليأسُ","ويا قلبُ بانت الأسرار",49,"ر",1,0],["يا رِجال الغيب أَنتُم جُندُهُ","أَمرُهُ الأَمرُ وَلِلِّهِ فِعالُه",50,"ل",2,0],["يا رجالَ الغيبِ ما حالُ الوَرى","كَالخفاجيِّ الَّذي يُحكى ضَلالُه",50,"ل",2,0],["يا رِجال الغيب قوموا وَاِقتُلوا","كلّ ضَلّيلٍ فَقَد حَقَّ قِتاله",50,"ل",2,0],["يا رِجالَ الغيبِ إنّي عندكُم","فَاِنظُروا في حالِ من لم تخفَ حالُه",50,"ل",2,0],["يا رَجْفةَ المَقصوفِ والقاصِفَةْ","هَلْ مِنْ هدوءِ يَتبعُ العاصِفةْ؟!",51,"ف",2,1],["يا رجاما فيها العجوز وفيها الش","يخ والطفل والذي يرعاه",52,"ا",2,0],["يأرجحني الزمانُ على هواها","وقلبي كم يحنُّ إلى لقاها",53,"ا",3,1],["يا رجال الجنوب من فتيةِ الله","وألغامكم لظى وانتصارُ",54,"ر",1,0],["يارجا العمر لو حفتك الاشواك","\" ليتك اول طريق القلب ليتك",55,"ك",1,0],["يا رجفتي.. والبرد يبغى له بلاد","يا غربتي.. والعيد طعمه بلا روح",56,"ح",1,1],["يَا رجْفةَ \"الأوْتارِ\" بينَ أصَابِعٍ","هتَكتْ حِجابَ القلبِ في خِدْرِ الضُّلوعْ",57,"ع",1,0],["يارجانا في ملمات الكروب","أنتم أفلاذ الكبود الغاليات",58,"ت",1,0],["يا رجلاً خفَّ عندهَ الثِقَلُ","حتى به صار يُضربُ المثلُ",59,"ل",1,1],["يا رِجْل عن دربهم وبيوتهم .. خفّي","ويا قلب لا تتعب اللي عذّبه ليله ..",60,"ل",2,0],["يَا رَجُلًا سَافَرَ فِي جَهْلِهِ","يَبْحَثُ فِي اللَّاشَيءَ عَنْ عَقْلِهِ",61,"ل",2,1]]}