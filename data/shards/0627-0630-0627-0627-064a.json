{"poems":[[73,"تيممت سعد الله","https://www.aldiwan.net/poem3770.html","الطويل"],[95,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[32,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[90,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[52,"ونبئت قوما بهم جنة","https://www.aldiwan.net/poem62253.html","المتقارب"],[173,"تسلطن بالحدباء عبد بلؤمه","https://www.aldiwan.net/poem1670.html",""],[189,"لعل اعترافي باقترافي شافع","https://www.aldiwan.net/poem14578.html","الطويل"],[228,"أمير الشعر لا نور وحق","https://www.aldiwan.net/poem41613.html","الرمل"],[409,"لقد خلطت بالإبتداع عقائد","https://www.aldiwan.net/poem33688.html","الطويل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48761","الطويل"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/73561","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91891","الوافر"],[3840,"","https://poetry.dctabudhabi.ae/diwan/poem/198376","الوافر"],[4539,"","https://poetry.dctabudhabi.ae/diwan/poem/203877","الطويل"],[4578,"قلبٌ بنار الأسى والوجد حرانُ","https://www.poetsgate.com/ViewPoem.aspx?id=49529",""],[5183,"إلى الحسنى","https://www.poetsgate.com/ViewPoem.aspx?id=180186",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[2365,"قفا صاحبيّ نحىّ الطلل","https://www.poetsgate.com/ViewPoem.aspx?id=200654",""],[5320,"صيحة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=40397",""],[402,"لذكراك يا حفني في النفس أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=36492",""],[788,"إذا ايسرت معزى عطية وارتعت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=578021",""]],"verses":[["إِذا أَيقَظَتهُ نَخوَةٌ عَرَبِيَّةٌ","إِلى المَجدِ قالَت أَرمنيَّتُهُ نَمِ",0,"م",1,0],["إِذَا ائْتَمَرَ المُسْتَشْرِقُونَ وَقلِّبَتْ","تَوَارِيخُنَا مِمَّا طَوَى الأَيْنُ والآنُ",1,"ن",1,0],["إِذا اِئتَجَّ رَضراضُ الحَصى مِن وَديقَةٍ","تُلاقي وُجوهَ القَومِ دونَ العَصائِبِ",2,"ب",1,0],["إذا أيقظتني للعِداء اعتداءة","شربت لها من خالصِ العَفوِ مُرْقِدا",3,"د",2,0],["إِذا أَيقَظَتكَ حُروبُ العِدا","فَنَبِّه لَها عُمَراً ثُمَّ نَم",4,"م",1,0],["إِذا أَيقَظَتهُ لَفظَةٌ عَرَبِيَّةٌ","إِلى المَجدِ قالَت أَرمَنِيَّتُهُ نَمِ",5,"م",1,0],["إذا آيَسَتْني كثرةُ الذَّنبِ رَدَّني","رجائي وعلمي أنّ صدرك واسع",6,"ع",1,0],["إِذا أَيَّدتَهم أَيَّدتَ حَقّاً","أَبي تَأييدَهُ شَرفٌ وَخُلقُ",7,"ق",1,0],["إذا آيةٌ صكت مسامع قلبه","وجاءت بما لا يرتضي من يتابع",8,"ع",1,0],["إذا ائْتَمَرَتْ يوماً بأَمرِكَ بادَرَتْ","إلى أَمرك العالي بدار الضراغم",9,"م",1,0],["إذا أَيْتَم البخلُ سؤَّالهُ","فيكفيك فينا أبو السائلينا",10,"ن",2,0],["إذا ائتلف الوادي جعلتم شروطكم","على الخصم للوادي قضاء محتما",11,"م",2,0],["إِذا أَيّامُ دَولَتِكَ اِستَمَرَّت","عَلى شَيءٍ فَلا رَجَعَ الشَّبابُ",12,"ب",1,1],["إِذا أَيقنت أَنّ اللَه حَقٌّ","وَأَنّ اللَه حيّ لا يَموتُ",13,"ت",1,1],["إذا أيقنت أن الله ربي","وأرسل أحمداً حقًّا نبياً",14,"ي",2,0],["إذا أيقنت بالموت بادرت رأسها","بقطع فتستحيي جديداً من العمر",15,"ر",1,0],["إذا أيقظ الشر قوم ساء جهلهم","أعماهم عن منار الحق طغيان",16,"ن",1,0],["إذا أيقظتهم أيقظت غير قنع","وإن أغفلتهم أغفلت غير هجع",17,"ع",1,0],["إذا ايقظتها عزمة وطنية","تدور كما شاء اللقا وتدير",18,"ر",1,0],["إذا آيسوك فلا تقنط","ن فللدهر عقد وللدّهر حل",19,"ل",1,0],["إذا أيقنوا أن السلام سبيله","قصف المدافع وانطلاقات الهمم",20,"م",1,0],["إذا ائتمر المستشرقون وقلبت","تواريخنا مما طو الين والآن",21,"ن",1,0],["إذا أيسرتَ مِعزى عَطيّة وارتَعَت","تلاعاً من المَروتِ أحوى جَميمُها",22,"م",3,1]]}