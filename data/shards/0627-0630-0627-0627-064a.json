{"poems":[[71,"تيممت سعد الله","https://www.aldiwan.net/poem3770.html","الطويل"],[93,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[50,"ونبئت قوما بهم جنة","https://www.aldiwan.net/poem62253.html","المتقارب"],[169,"تسلطن بالحدباء عبد بلؤمه","https://www.aldiwan.net/poem1670.html",""],[185,"لعل اعترافي باقترافي شافع","https://www.aldiwan.net/poem14578.html","الطويل"],[223,"أمير الشعر لا نور وحق","https://www.aldiwan.net/poem41613.html","الرمل"],[403,"لقد خلطت بالإبتداع عقائد","https://www.aldiwan.net/poem33688.html","الطويل"],[416,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[458,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"]],"verses":[["إِذا أَيقَظَتهُ نَخوَةٌ عَرَبِيَّةٌ","إِلى المَجدِ قالَت أَرمنيَّتُهُ نَمِ",0,"م",1,0],["إِذَا ائْتَمَرَ المُسْتَشْرِقُونَ وَقلِّبَتْ","تَوَارِيخُنَا مِمَّا طَوَى الأَيْنُ والآنُ",1,"ن",1,0],["إِذا اِئتَجَّ رَضراضُ الحَصى مِن وَديقَةٍ","تُلاقي وُجوهَ القَومِ دونَ العَصائِبِ",2,"ب",1,0],["إذا أيقظتني للعِداء اعتداءة","شربت لها من خالصِ العَفوِ مُرْقِدا",3,"د",2,0],["إِذا أَيقَظَتكَ حُروبُ العِدا","فَنَبِّه لَها عُمَراً ثُمَّ نَم",4,"م",1,0],["إِذا أَيقَظَتهُ لَفظَةٌ عَرَبِيَّةٌ","إِلى المَجدِ قالَت أَرمَنِيَّتُهُ نَمِ",5,"م",1,0],["إذا آيَسَتْني كثرةُ الذَّنبِ رَدَّني","رجائي وعلمي أنّ صدرك واسع",6,"ع",1,0],["إِذا أَيَّدتَهم أَيَّدتَ حَقّاً","أَبي تَأييدَهُ شَرفٌ وَخُلقُ",7,"ق",1,0],["إذا آيةٌ صكت مسامع قلبه","وجاءت بما لا يرتضي من يتابع",8,"ع",1,0],["إذا ائْتَمَرَتْ يوماً بأَمرِكَ بادَرَتْ","إلى أَمرك العالي بدار الضراغم",9,"م",1,0],["إذا أَيْتَم البخلُ سؤَّالهُ","فيكفيك فينا أبو السائلينا",10,"ن",2,0]]}