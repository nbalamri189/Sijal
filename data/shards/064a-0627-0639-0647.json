{"poems":[[79,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[90,"أدب العلم وعلم الأدب","https://www.aldiwan.net/poem45003.html","الرمل"],[422,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[469,"ما على ما لاقيته من مزيد","https://www.aldiwan.net/poem3440.html","عموديه"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136327","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125362","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138622",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4830,"مغنى صَبوتي","https://www.poetsgate.com/ViewPoem.aspx?id=202936",""],[5490,"رجع الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=176347",""],[5612,"ويعود للأقصى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=196750",""],[5954,"عهد التميمي","https://www.poetsgate.com/ViewPoem.aspx?id=195112",""],[6167,"الصوارمى يتذكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85545&r=&rc=28",""]],"verses":[["يا عَهْدَ عيْنِ الدّمْعِ كمْ منْ لُؤلُؤٍ","للدّمْعِ جُدْتَ بهِ عَساكَ تَعودُ",0,"د",1,0],["يا عهود العلم ما شئت اندُبي","يا عيون المجد ما شئت اذرفي",1,"ي",1,0],["يا عهدنا الماضي وليسَ براجعٍ","أفترجعنَّ بما مضيت فترجعُ",2,"ع",1,0],["يا عهود الحدباء عودي فقد","برحت شوقاً بالهائم المعمودِ",3,"د",1,0],["يا عهدنا بالحي من لعلع","ووقتنا بين الصفا والحطيم",4,"م",1,0],["يا عهدَ طِيبَةَ إنَّ مجدَكَ فاقَهُ","مجدٌ لنا بأميرنا وَوِئَامُ",5,"م",1,0],["يا عُهوداً طالَما سمحت","بِوصال الخرّد العربِ",6,"ب",1,0],["يا عهدنا المأنوس هل انساك أم","انسى ربوعاً بالأحبة تحفل",7,"ل",1,0],["يا عهودَ صبْوَتِنا","ليتَ عهدَكِ الهَرمُ",8,"م",1,0],["ياعهدَ وجدي لايجفُّ نضارةً","اِنْ أشرَقتْ شمسُ المشيبِ بلَّمَّتي",9,"ت",2,0],["يا عهدُ ماذا لو خلعتُ خواتمي؟","وقطعتُ عِقداً كان عندي الأمجدا",10,"د",2,0],["يا ( عَهْدُ ) إنَّ اللهَ بالِغُ أمْرهِ","واللهُ أكْبرُ فوقَ كيْدِ يَهودِ",11,"د",1,0],["يا عهدُ كلُّ الحاضرين تساوموا","ألقوا بأمكِ ساجنين حجارها",12,"ر",3,0],["يا عهَدنا الميمونَ في زمنِ الرضا","يَغشاكَ مِنى ما اْدَّكرتُ سلامُ",13,"م",1,1]]}