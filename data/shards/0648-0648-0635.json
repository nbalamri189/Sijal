,[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[3591,"على صدور الخرد الحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=149415",""],[5183,"كؤس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185677",""],[5189,"الحب نهرا","https://www.poetsgate.com/ViewPoem.aspx?id=213319",""],[5216,"النّيل","https://www.poetsgate.com/ViewPoem.aspx?id=186992",""],[5216,"الأول والأخير","https://www.poetsgate.com/ViewPoem.aspx?id=187648",""],[5219,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[5219,"الأم مدرسة إذا.......","https://www.poetsgate.com/ViewPoem.aspx?id=194906",""],[2365,"أدرك الدّهر الذي طلبا","https://www.poetsgate.com/ViewPoem.aspx?id=200641",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5431,"قبلت طفلي وانحنيت لأتبعه","https://www.poetsgate.com/ViewPoem.aspx?id=191111",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5628,"حديث مع البحر","https://www.poetsgate.com/ViewPoem.aspx?id=178548",""],[402,"بلغت أعلى منصب توثيقا","https://www.poetsgate.com/ViewPoem.aspx?id=36002",""],[5809,"سياحة","https://www.poetsgate.com/ViewPoem.aspx?id=205334",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[6102,"عِندَما قالَ حِذائِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=184457",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[572,"وَوَصَائفٌ صُفّتَ على ذي أَربعٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9305&r=&rc=162",""]],"verses":[["وَوَصِيَّةٍ خُلِفَت لَنا مِن حازِمٍ","وَطِىءَ الزَمانَ سُهولَةً وَحُزونا",0,"ن",2,1],["وَوَصايِلُ الأَدَبِ الَّذي تَصِلُ الفَتى","لا بِاِتِّصالِ قَبائِلٍ وَجُدودِ",1,"د",1,0],["وَوَصْلُكَ بِالصَّلاَةِ دُجَى اللَّيَالِي","وَقَطْعُكَ لِلْهَوَاجِرِ بِالصِّيَامِ",2,"م",1,0],["ووَصْفُكَ يهْدي المَدْحَ قصْدَ ثَوابِهِ","إذا ضلّ في أوْصافِ مَنْ دونَكَ الشِّعْرُ",3,"ر",1,0],["ووَصْلٍ كأنّا منْهُ في سِنَةِ الكَرى","وعَيْشٍ كأنّا منْهُ في جنّةِ الخُلْدِ",4,"د",1,0],["ووصَلْتَ تِمَّ اللّيْلِ منْهُ بيَوْمِهِ","ذِكْراً يُبَلِّغْهُ القَبولَ صُعودُهُ",5,"د",2,0],["وَوَصَلتَ بَينَ شَكاتِنا وَمَشايِخٍ","في البَرلَمانِ أَعِزَّةٍ أَخيارِ",6,"ر",1,0],["وَوَصَفتَ لي زَمَنَ الرَبيعِ وَقَد بَدا","هرمُ الزَمانِ إِلى شَبابٍ مُقبِلِ",7,"ل",1,0],["وَوَصَلْتَ أَرْحَاماً فَمَا أَغْلَيْتَ مِنْ","عَرْضٍ تَقَطَّعَ دُونَهُ الأَرْحَامُ",8,"م",1,0],["ووصولاً إلى مقام رفيع","عَزّ من قبله إليه الوُصول",9,"ل",1,0],["ووصلهن الصِّبا إن كنت فاعله","وفي مقام الصِّبا زحلوقةُ زُلَلُ",10,"ل",1,1],["وَوَصِيُّ الوَصِيَّ ذِي الخُطَّةِ الفَص","لِ وَمُردِي الخُصُومِ يَومَ الخِصَامِ",11,"م",1,0],["ووصلُ معذِّبي جناتُ عدنٍ","لباسي فيه ضمٌّ كالحرير",12,"ر",1,0],["ووصلة زاكية بالرفا","وبالبنين ابْتدرت باسمهْ",13,"م",2,0],["ووصلُك الإلفَ بعد هجرتِهِ","يَجْنيك معسول حدّة الظَّفرِ",14,"ر",1,0],["ووصفت كأساً لا يشاكلها","فجعلتها صهباء كالدمعه",15,"ع",2,0],["ووصفت ضوء الصبح محتفلاً","فجعلته كإضاءة الشمعه",15,"ع",2,0],["ووصفت الذي يحق على الإخ","وان من رعيهم ذمام الصديق",16,"ق",1,0],["وَوَصَلنا السُرى فَلَولا ظَلامُ ال","جَهلِ لَم يَخطُنا إِلَيكِ اِهتِداءُ",17,"ا",2,0],["وَوَصَلتَ أَرضَ الرومِ وَصلَ كُثَيِّرٍ","أَطلالَ عَزَّةَ في لِوى تَيماءِ",18,"ا",2,0],["وَوَصَلتَ عَفوَكَ يا أَمي","رَ المُؤمِنينِ لَنا بِجُهدِك",19,"ك",1,0],["وَوَصَلتَ بَينَ الجَعفَرِيِّ وَبَينَهُ","بِالنَهرِ يَحمِلُ مِن جُنوبِ الخَندَقِ",20,"ق",1,0],["ووَصَلْتَ للإسْلامِ بأسَكَ مُقْدِماً","بِضياءِ عَزْمِكَ فاستنارَ ظَلامُه",21,"م",2,0],["وَوَصَلتَ فيهِ العاكِفينَ عَلى التُقى","فَشَرِكتَها في صَومِها وَصَلاتِها",22,"ت",3,0],["وَوَصفِ العِذارِ وَذاتِ الخِمارِ","وَنَعتِ العُقارِ بِأَلقابِها",23,"ب",3,0],["ووصفت قيساً في شديد بلائه","ظمآن يطلب قطرةً من ماءِ",24,"ا",2,0],["وَوَصَلتُ مابَيني وَبَينَ مُحَمَّدٍ","حَتّى كَأَنّا مِعصَمٌ وَذِراعُ",25,"ع",1,0],["وَوَصَفْتَ عاقبةَ الغُرورِ وما جَنَى","سَفَهُ العقولِ وخِفّةُ الأحلامِ",26,"م",1,0],["ووصفتها فتمثّلت في روعةٍ","للسّحرِ فيها أخذُه المتعاقِبُ",27,"ب",1,0],["وَوَصَلتُ أَسبابي بِمُختَلَقٍ","رَخصِ البَنانِ مُخَضَّبٍ بِلِحا",28,"ح",2,0],["ووصَلتَ بينَ قريبها وبعيدها","رَحِمَ العروبة أو عُهُودَ الضَّادِ",29,"د",1,0],["ووَصْلُه في كِلا الحالَيْنِ مُفْتَرَضٌ","سِيّانِ قاطِعُهُ جَهْلاً وواصِلُهُ",30,"ل",2,0],["وَوَصَلْتَ فِي الطِّبِّ الفُرُوعَ بِأَصْلِهَا","فزَهَا الْفُوُرعُ بِأَصْلِهِنَّ عَرِيقا",31,"ق",2,0],["ووصالا كانت تفيض معاني","علينا سكينة وخشوعا",32,"ع",2,0],["ووصلنا … قطرت مأساة أهلي","من دم القلب دمعة بعد دمعه",33,"ع",2,0],["وَوِصال مَن أَهواه لَيسَ بِمقنعي","زَمَناً فَرحتُ وَلِلفراق تَشوّقي",34,"ي",1,0],["ووصلُها غُررٌ وصرمها غَرَرٌ","ونيلها بِشرٌ مآلهُ بُشَرُ",35,"ر",1,0],["وَوَصيَّتيكَ فَجُد بِعَفوِكَ زَلَّةٌ","ما فَوقَ ما أَولَيتَنيهِ مَزيدُ",36,"د",1,0],["وَوَصفٌ أَحَلَّكَ فَوقَ السَماءِ","فَخاطِب وَكاتِب مِنَ المُستَقَرّ",37,"ر",1,0],["وَوَصَفْتُ نِعْمَةَ جِسْمِهِ","فَنَعِمْتُ في صِفَةِ النَّعِيمِ",38,"م",1,0],["وَوَصَلْناها وَمَنْ يَصْ","بِرُ عَنْ وَصْلِ المِلاحِ",39,"ح",1,0],["ووصلتُ ثم قدرتُ ثم عَفَفتُ معْ","شوقٍ تَناهَى بي إلى الإنضاج",40,"ج",1,0],["ووصّى الأحنف الرجلين يوما","وما يألو وصيّته غلامه",41,"م",2,1],["ووصفُه يعجز عن حصره","نظماً ونثراً ماهرٌ مُفلق",42,"ق",1,0],["ووصفك يعطي الفهم نوراً كأنه","على الدّر في البحر الخضّم يغوص",43,"ص",1,0],["ووصلهما سهل على كل فاضل","ومقصده للغرم ليس له نحو",44,"و",1,0],["ووصلتي لحمى القرب الصلاة على","مَن عاد مِن ذروة العلياء بالشرف",45,"ف",1,0],["ووصلك كالأصغاء فيك بمسمعي","للائمة ليس ليس يحلو مريرها",46,"ر",3,0],["وَوصلتكم ارجو بجاه وجوهكم","وَبجاه سيدنا الجَمال جَمالا",47,"ل",2,0],["ووصفُها بالصغر","وَخلقُها المختصرِ",48,"ر",1,0],["ووصف اضطرار وانكسار وذلة","وقلب طفوح بالظنون الجميلة",49,"ه",1,0],["ووصلنا المدينة الشريفة دا","ر الدين والإيمان والإسلام",50,"م",1,0],["ووصل خرود غادة أريحية","سبتني بحسن ما أتم وما أجلى",51,"ل",2,0],["وَوَصلُكَ الدَهرَ مَضنُونٌ فَمَوعِدُهُ","مُرَجَّعٌ بَينَ تَصديقٍ وَتَكذِيبِ",52,"ب",1,0],["وَوَصلُ الأَقرَبينَ سَبيلُ حَقٍّ","وَقَطعُ الرِحمِ مُطَّلَعٌ كَؤودُ",53,"د",1,0],["ووصالك فتّح لخيالي دنيا هنيّه","الزهر بين صاحي ونايم",54,"م",1,0],["ووصَلْنا الحنينَ لو جَرَّ نَفْعاً","وأَدَمْنا البكاءَ لو كان أَجْدى",55,"د",2,0],["ووصالٍ كان الشبابُ شفيعي","ورفيقي فيه فنعمَ الرفيقُ",56,"ق",1,0],["وَوَصلاً غَير مُتَّصلٍ","وهَجراً غَير مُنفَصِلِ",57,"ل",1,0],["وَوَصف مَفاخر أَربت","عَلى التَفصيل وَالجُمَل",58,"ل",1,0],["وَوَصَفتُ مَبسَمَكَ الشَهي","بِمِثلِ أَبكارِ اللآلي",59,"ل",2,0],["وَوَصَفتُ عارِضَكَ الصَقي","ل مِن النَعيمِ بِلا صِقالِ",59,"ل",1,0],["وَوِصالٍ مِن حبيبٍ","بعدَ هَجْرٍ وصدودِ",60,"د",1,0],["وَوَصَلْنا إلى حماكِ وصُلْنا","صَوْلةٌ تتركُ الشجاعَ جبانا",61,"ن",2,0],["ووصف الذي قد كان تحصيل حاصل","فكل رآها جهرة ورواها",62,"ا",3,0],["ووصف نداكم يخرس اللسن الذي","يزاحم في نظم الدقائق حسانا",63,"ن",2,0],["ووصفكم قد أدهش اللب شأوه","ولو كنت في باب البلاغة سحبانا",63,"ن",2,0],["ووَصَلْتَ موصولاً بِبُغْيَتِكَ المُنى","ومُيَسَّراً لمُرادِكَ التَّيْسِيرُ",64,"ر",1,0],["ووصائف مثل الشمو","س تزف حوراً غانيه",65,"ي",2,0],["ووصفه فوق اقتدار قدري","ومدحه فوق مقام شعري",66,"ر",2,0],["ووصية منكم يكون بحسنها عملى","وتهدينى لما لا أعلم",67,"م",1,0],["ووصلت به قطيعة وعززت بع","د إضاعة وهديت بعد ضلال",68,"ل",1,0],["ووصلك الهاجرين عوراءُ مع عل","مك أن كم هجرتَ من وصلك",69,"ك",1,0],["وَوَصلُ مُعاطاةٍ وَقَطعُ تَمَنُّعٍ","وَطَيُّ مُراعاةٍ وَنَشرُ مُجونِ",70,"ن",1,0],["وَوَصِّ جَدواكَ بِتَعجيلِهِ","لِناصِحٍ في خِدمَةِ الشُكرِ",71,"ر",1,0],["وَوَصفها المُعجِزُ مالا يُدرَكُ","وَمِثلُهُ في غَيرِها لا يُملَكُ",72,"ك",1,0],["ووصلنا بهم إلى حضرة القد","سِ كراماً زهراً وطاب المقام",73,"م",1,0],["ووصفْتَ أشكالاً وطبعُكَ شاهِدٌ","وذكرْتَ ألواناً ولا اسْتِجْلاءُ",74,"ا",2,0],["ووصوت شادٍ حكى في سجع منطقهِ","ورق الحمائِم تغريداً وتصويتا",75,"ت",2,1],["ووصلت حبلك في الحياة بحبلهم","صلة الأشاجع ركبت في الأنمل",76,"ل",1,0],["وَوَصلِكَ المَنيعِ","زُرني فَإِني عانِ",77,"ن",1,0],["ووصفُكَ فيه يَحلو لي قَريضٌ","ويَحسُدُ دُرَّهُ العِقدُ النَّظيمُ",78,"م",1,0],["ووَصفُ البَحرِ للرَّائي مُحالٌ","عنِ التَّحديدِ قد جَلَّت 