{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[55,"يا قلب ما أنت من نجد وساكنه","https://www.aldiwan.net/poem30428.html","البسيط"],[88,"كم مر بي فيك عيش لست أذكره","https://www.aldiwan.net/poem10506.html","البسيط"],[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[74,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[70,"ما بين معترك الأحداق والمهج","https://www.aldiwan.net/poem1488.html",""],[70,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54940","السريع"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[113,"من لإحتراق حشاشة الملهوف","https://www.aldiwan.net/poem16209.html","الكامل"],[119,"ما للقلوب من العيون امان","https://www.aldiwan.net/poem40440.html","عموديه"],[156,"ماضٍ وأعرف ما دربي وما هدفي","https://www.aldiwan.net/poem17105.html","عموديه"],[228,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[302,"من عم طلعتك الغراء بالبلج","https://www.aldiwan.net/poem33309.html","البسيط"],[315,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[347,"مهلا ممرضة المشوق العاني","https://www.aldiwan.net/poem55312.html","الكامل"],[358,"تحت الغلائل بانة تترنح","https://www.aldiwan.net/poem40408.html","الكامل"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56697","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113954","الكامل"],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205528","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104807","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126200","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60939","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60889","المنسرح"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123751","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116501","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108392",""],[3622,"","https://poetry.dctabudhabi.ae/diwan/poem/204350","السريع"],[3656,"","https://poetry.dctabudhabi.ae/diwan/poem/133928","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132142","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4693,"أهوى السحاب","https://www.poetsgate.com/ViewPoem.aspx?id=29939",""],[4693,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=53819",""],[4830,"بقايا الصَّبْر","https://www.poetsgate.com/ViewPoem.aspx?id=201200",""],[4830,"شجو النوى","https://www.poetsgate.com/ViewPoem.aspx?id=201358",""],[4830,"سلاماً ياعِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207947",""],[4830,"ورديُّ الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=214992",""],[4927,"أم العيون السود","https://www.poetsgate.com/ViewPoem.aspx?id=12984",""],[4984,"عبق القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=175557",""],[5082,"أطيافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212387",""],[5111,"مَرَاكِبُ التِّحْنَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212287",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5155,"الربيع والفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=176155",""],[5187,"زيارة لقصر العظم","https://www.poetsgate.com/ViewPoem.aspx?id=29065",""],[5190,"الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=175589",""],[5232,"العاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=211570",""],[307,"ملكة الدار","https://www.poetsgate.com/ViewPoem.aspx?id=214581",""],[5431,"ومواقف القلب الوفي تُخلدُ","https://www.poetsgate.com/ViewPoem.aspx?id=197629",""],[5490,"رجع الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=176347",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[5628,"اجمل الاغنيات","https://www.poetsgate.com/ViewPoem.aspx?id=178476",""],[5628,"ابتهالات في محراب الورد","https://www.poetsgate.com/ViewPoem.aspx?id=178665",""],[5829,"بلبل الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=176836",""],[6152,"يابحر","https://www.poetsgate.com/ViewPoem.aspx?id=202893",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[2588,"توفيق ان ابنك المحبوب عدنانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83074&r=&rc=22",""],[406,"غفوة قلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1113&r=&rc=57",""]],"verses":[["أَهفو إِلى الريحِ إِن هَبَّت يَمانِيَةً","تَحدو زَعازِعُها عيراً مِنَ المُزُنِ",0,"ن",1,0],["أَهفو إِلى الرَكبِ تَعلو لي رِكابُهُمُ","مِنَ الحِمى في أُسَيحاقٍ وَأَطمارِ",1,"ر",1,0],["أَهفو إِلَيهِ عَلى ما أَقرَحَت كَبِدي","مِنَ التَباريحِ أولاهُ وَأُخراهُ",2,"ا",2,0],["أَهفُو إِذَا تهفُوا البروقُ وأَنثني","لِسُرى النواسمِ من رُبى تيماءِ",3,"ا",2,0],["أهفو إلى مرِّ النسيم بمهجةٍ","ترجو شفاءً منه وهو عليل",4,"ل",1,0],["أهْفُو إلى كلّ قَلْبٍ بالغرام لهُ","شُغْلٌ وكُلِّ لسانٍ بالهوى لَهِجِ",5,"ج",1,0],["أهْفُو لأنفاسِ النّسِيمِ تَعِلّةً","ولوَجْه مَن نقَلَتْ شَذَاهُ تشوّفي",6,"ف",2,0],["أَهْفُو إِلَيْهِ وَالمُلِمَّاتُ لاَ","تَعْفُو وَلاَ يُعْصَى لَهَا أَمْرُ",7,"ر",1,0],["اهفو الى روح النسيم راجيا","اطفاء ما بالقلب من حر الصلا",8,"ا",1,0],["أَهفو إِلَيهِ مَع العَفاف وَأَثني","وَالوَجد ملئ فُؤاديَ المَشغوف",9,"ف",1,0],["اهفا واخطأ ناسيا فصددتمو","هل يكتب الهفوات والنسيان",10,"ن",1,0],["أهفو إلى جنة الفردوس محترقاً","بنار شوقي إلى الأوفياء والغرف",11,"ف",1,0],["آهِ في دَولَةِ الأَدَب","أَيُّ مَلكَينِ كُنتُما",12,"م",2,0],["أَهفو إِلى الريح إِن مَرَّت على إِضمٍ","شَوقاً لمن قَلبُه بالشَوق لم يَهِجِ",13,"ج",1,0],["أهفو إلى الأطلال كانت مطلعاً","للبدر منهم أو كناس ربيب",14,"ب",1,0],["أهفو إليك وفي الجوانح حرقة","وخيال شعري في فضائك فاني",15,"ن",2,0],["أَهفو لِشَجو حَمائم الحلي الَّتي","تَهفو عَلى غُصن القوام وَتصدحُ",16,"ح",1,0],["أهفو لعُلويِّ الرياح إذا جَرتْ","وأظنُّ رامةَ كلَّ دارٍ أقفرتْ",17,"ت",1,1],["أهفو لسهدي ليت لي مثله","وليتني في ليلي الاليل",18,"ل",1,0],["أهفو إذا هتفت عليّ نسائم","من مصر أو أشفى علي الفرقد",19,"د",1,0],["أهفو لَهُنَّ إذا رَايتُ حُدوجَها","عولينَ بالتَنماطِ والتنواطِ",20,"ط",1,0],["أهفو لأنفاس النسيم فعله","من كثر أشواقي وفرط تكلفي",21,"ف",2,0],["أَهفُو إِلَى حُبِّ مَن قَلبى يُشَخِّصُهُ","فِى كُلِّ حِينٍ وَما عَينى بهِ رَمَقَا",22,"ق",2,0],["آه فَكَّ الحَبيبُ عَقدِ وِصالِ","وانطفت نارُ زَفرَتى بالهواءِ",23,"ا",2,0],["أهفوا إذا ما البارقُ القِبْلى لي","وَهَناً تألّقَ من خلال غمَام",24,"م",1,0],["أهفوا إلى عامرٍ وشعبُهم","ظام ولو أنني تلفت ظمَا",25,"م",2,0],["أهفوا إلى مرِّ الحمامِ وشُربهِ","ومذاقُه ياما أُحَيلاهُ بفى",26,"ف",2,0],["اهفو به وهو قصدى لا ازال به","مستسقيا فاسقنى اشرب وعد عللا",27,"ل",2,0],["اهفو الى بشر الجبين بشيخنا","ولئن يكن بمهابة متلفعا",28,"ع",2,0],["اهفو الى ابن اليازجي ومهجتي","نزعت اليه وحقها ان تنزعا",28,"ع",2,0],["اهفو اذا مامر ذكرك خاطراً","في خاطري وأود ان نتجمعا",28,"ع",2,0],["اهفو الى الوجه الجميل لانهُ","بدرٌ لنا نورَ الفضائل اطلعا",28,"ع",2,0],["أهفو ويعفو فأرتجو فضله","لكنكم لا تأمنوا عدله",29,"ل",2,0],["أهفو وأهتف والهيام معنفى","والشوق يقلق والهوى يضنيني",30,"ن",2,0],["أهفو إلى الأرز الأغن على الربى","وإلى عريش الحقل والصفصاف",31,"ف",1,0],["آه فلن يعود للأوطان","قصر عن إمداده بناني",32,"ي",1,0],["آه فقد فات زمانٌ غبرا","حيين فيه نعقد المؤتمرا",33,"ر",2,0],["آهِ فارحَم وَانعَطِف رِفقاً عَلَي","آهِ فارفُق بي وَبالطِّفلِ لَدَى",34,"د",2,0],["آه فما عدت ادري أي قافية","تجدي فأرسل يا بوابة العرب",35,"ب",1,0],["آه 00 فان القلب يبكي حسرة","وتئن من آهاته الأجناب",36,"ب",1,0],["آهِ فقد عُقِرَتْ خيولُ صبابتي","مُذ أنْ تنفّسَ في القَذالِ صباحُ",37,"ح",1,0],["آه فليتُكَ حاضرا ياصاحبي","لسقيتَ خِلاًّ يرتوي الحِرمانا",38,"ن",2,0],["آهٍ فاِنَّ سؤالَكُمْ","أردى على شَفَتي الجَوابْ",39,"ب",1,0],["أهفو مُداعبةً لهُنَّ كأنَّني","موجٌ يُداعبُ في نداهُ ضِفافا",40,"ف",2,0],["آهٍ فَآهٍ ، إِنَّ بَاْبِلَ حُوْصِرَتْ","بِأَعَاْجِمٍ عَشِقُوْا تُرَاْثَ يَهُوْدِ",41,"د",1,0],["آه.. فإن مر الصدى برحابكم","بعبير ما كتم النسيم فما انجلى",42,"ل",2,0],["آهٍ فقد ولّى الشّبا","بُ وما حظيتً بنارِ وجدِكْ",43,"ك",1,0],["أهْفُو إلَى دَرْبِيْ وَأحْلامِهِ","دُنْيَا الرّؤَى تَشْدُو ، فَهَاتِي يَدَكْ",44,"ك",1,0],["أهفوا لوردي ماءها فيذودني","علمي بغب موارد وصدور",45,"ر",1,0],["اهفو واصبو فلا والله مانقعت","من غلتي هذه الانهار نيرانا",46,"ن",2,0],["أهفو إليها كي أحدّقَ ساعةً","فتظنُّها، أحياء كلُّ مشاعري",47,"ر",2,0],["أَهفُو إِلَيهِ إِذَا مَا غَابَ عَن خَلَدِي","يَوماً ، ولَاحَ عَلَى بُعدٍ تَوَجُّسُهُ",48,"س",2,0],["أهفو إلى عينيهِ لؤلؤةٌ أنا","ألماسةٌ وتشعُّ من عينيهِ",49,"ي",2,0],["أهفو إلى بيتِ الحنانِ كأنّني","طيٌر يناغي عشّه تغريدا",50,"د",2,0],["أهفو إلى الوحي الرسول بمهجتي","ويطير في شغف إليه الهدهد",51,"د",1,0],["أهفو لبسمة بَرقه فيكفّها","رعدٌ يقهقه في الفضاء توعُّدا",52,"د",2,0],["أهفو إليها كلما ضاقت بي الدن","يا فأمرح في فضاها الأوسع",53,"ع",1,0],["أهفو إلى لُقياك كُل دقيقة ٍ","وأود لو تتعانق الخطواتُ",54,"ت",1,0],["أهفو إلى لُقياكَ عذ ّبني","هذا الفراقُ المُرُّ يا شهْدُ",55,"د",1,0],["أهفو الى وصل الحبيب تشوقا","افضي اليه من الشعور بما اعتمل",56,"ل",1,0],["أهفو إليه ولا أدري أيذكرني","أم الذي غاب عن عينيه ينساه!؟",57,"ا",2,1],["أهفو إليه طامحا متوثبا","وكأنه حرب على النظار",58,"ر",1,0],["اه فيك طالت قوافيه وان قصرت","فلم يزل لي على الحالين مذعانا",59,"ن",2,0],["أهفو إليكَ وأنتَ في طيّ النَّوى","تهفو إليّ ، وحبلُنا مفتولُ",60,"ل",1,1]]}