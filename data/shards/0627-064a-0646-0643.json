{"poems":[[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[95,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[93,"غلط القائل إنا خالدون","https://www.aldiwan.net/poem62825.html","عموديه"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[45,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[71,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[71,"ذهب الصدق وإخلاص العمل","https://www.aldiwan.net/poem29305.html","الرمل"],[107,"سائلوا الأبطال هل ملوا الكفاحا","https://www.aldiwan.net/poem42054.html","الرمل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[83,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[48,"رب درفس خلفه ذائب","https://www.aldiwan.net/poem23432.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[92,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[96,"الدمية المحطّمة","https://www.poetsgate.com/ViewPoem.aspx?id=15615",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[228,"عصرت فؤادي في إناء من الهوى","https://www.aldiwan.net/poem41450.html","الطويل"],[234,"جادك الغيث من محلة دار","https://www.aldiwan.net/poem51068.html","الخفيف"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[264,"أقول لأهل اللهو والتيه والحجب","https://www.aldiwan.net/poem35748.html","الطويل"],[275,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[275,"لمست بنفسي أسطع النجمات","https://www.aldiwan.net/poem35600.html","الطويل"],[285,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[310,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[310,"لا وغصن راق للطرف ورق","https://www.aldiwan.net/poem56446.html","الطويل"],[371,"على إثر ما حل الدخول وحوملا","https://www.aldiwan.net/poem17063.html","الطويل"],[409,"لله در الجلال من علم","https://www.aldiwan.net/poem33433.html","المنسرح"],[422,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[534,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[534,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[569,"خل عنك الصد يا بدر الدجى","https://www.aldiwan.net/poem832.html",""],[580,"أين كؤوسي وأين أكوابي","https://www.aldiwan.net/poem2745.html","المنسرح"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37984","البسيط"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33096","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62463","الوافر"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203681","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64663","الخفيف"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124706","الخفيف"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93105","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115930","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108742","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49591","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76888","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108482","الوافر"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93864","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127383","الرمل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71308","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131952","الرمل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40125","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119597","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127081","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117294","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146758","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133105","الرمل"],[4691,"حبّها ينحتُ دربَ القدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=175416",""],[5111,"وَجْدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212300",""],[5121,"عِنَاقُ الأَشْقِيَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=33629",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[5387,"أين كنتِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=46528",""],[5671,"أضيق صدر الدهر والحزم واسع","https://www.poetsgate.com/ViewPoem.aspx?id=169351",""],[5704,"أهلا وسهلا ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=202823",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5309,"أين كنت ومن انا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573963",""],[5396,"لمعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65505&r=&rc=4",""]],"verses":[["أينَ كِسْرى أو أيْنَ إيوانُ كِسْرى","لا يُقاسُ الخِضَمُّ بالضَّحْضاحِ",0,"ح",1,0],["أَيْنَ كَاسِي الْبَيَانِ مِنْ كُلِّ ثَوْبٍ","عَبْقَرِيٍّ وَكُلِّ لَوْنٍ وَسِيمِ",1,"م",1,0],["أَينَ كانَ النورُ أَنّى وُجِدا","كَيفَ وَلّى عِندَما زالَ البِناء",2,"ا",2,0],["أَينَ كانَ القَضاءُ وَالعَدلُ وَالحِك","مَةُ وَالرَأيُ وَالنُهى وَالذَكاءُ",3,"ا",2,0],["أَيُنكِرُ خَدّي دُموعي وَقَد","جَرَت مِنهُ في مَسلَكٍ سابِلِ",4,"ل",1,0],["أَيُنكِرُ ريحَ اللَيثَ حَتّى يَذوقَهُ","وَقَد عَرَفَت ريحَ اللُيوثِ البَهائِمُ",5,"م",1,0],["أينكرُ الشعراءُ النورَ منكَ وهل","أتى نظيرُكَ يا مَنْ بالجمالِ سبا",6,"ب",2,0],["أين كسرى وهِرَقْلٌ أين مَنْ","ملك الأرضَ وولَّى وعزلْ",7,"ل",1,0],["أين كبشُ القوم ماذا نَابَهُ","أَعراهُ الضّعفُ أم عَافَ النِّطاحا",8,"ح",2,0],["أين كنّا ما بالُنا لا نَراهُ","ما لأوصالِنا تُحسُّ الفُتورا",9,"ر",2,0],["أَيُنكِرُ قَلبُ الصَبِّ مُنذُ سَكَنتَهُ","لَهيباً وَحَرّاً وَهوَ لِلشَمسِ مُشرِقُ",10,"ق",1,0],["أَيُنكِرُ التَقليدَ مُستَبصِرٌ","قَبَّلَ رُكنَ البَيتِ ثُمَّ اِستَلَم",11,"م",1,0],["أَينَ كِسرى إِن كُنتَ مُبصِر آيٍ","مِنهُ أقوت فَلَستَ سامِع رِكزِ",12,"ز",1,0],["اين كانَ الوطنُ المحبوبُ إذْ","قَلَّتِ الزينةُ مالٌ وبَنون",13,"ن",1,0],["أينكرني حسن خلقت فتونه","فيخنقني عطري وتحرقني ناري",14,"ر",2,0],["أَينَ كِسرى كِسرى المُلوكِ أَنوشِر","وانُ أَم قَبلَهُ سابورُ",15,"ر",1,0],["أَينَ كلُّ العلوالمِ العلويّه","أَينَ كلّ العوالمِ السفليّه",16,"ه",1,0],["أَينَ كلّ الوَرى بكلِّ مزيّه","إنّما فوقهُ العليُّ العظيمُ",16,"م",1,0],["أَيُنكَرُ حَتّى البُؤسُ ما فيكِ مِن غِنىً","وَأَيذُ غِذاءٍ أَنتِ لِلبُؤَساءِ",17,"ا",2,0],["أين كان العبّاس إِذ ذاك في الهج","رة أم في الفراش أم في الغار",18,"ر",1,0],["أينكره بالأمس واليوم يمتطي","من السحر طياراته حين يركب",19,"ب",1,0],["أينكَرُ ذكرُ الله جلّ جلاله","وفي محكم التنزيل نصٌّ لذي لبّ",20,"ب",1,0],["أينكُرُ بَطشَنا يومَ التَقينا","وكنّا قائلينَ وفاعلينا",21,"ن",2,0],["أينكر فَضلي حُسَّدي وفضيلتي","وقد فاضَتِ الأنوارُ من كلماتي",22,"ت",2,0],["أَيُنْكَرُ يا مُحَمَّدُ لِي نَحِيبُ","وَقَدْ غالَتْكَ لِلأَيَّامِ غُولُ",23,"ل",1,0],["أَينَ كِسرى وَأَين قيصرُ بل أي","نَ الّذي مِن بنائه الهرمانِ",24,"ن",1,0],["أَينَ كأسُ الراحِ مِن ثغرٍ نشا","مِن رُضابٍ سَكِرَت منهُ الحَدَق",25,"ق",1,0],["أَيُنكَرُ أَن تَجري دِماءُ جَريحِهِ","فَكَم سَلَّ جَفناً لا فَكَم سَلَّ مُنصُلا",26,"ل",2,0],["أينكرون علمه وقد شهدت","آثاره بالرسوخ من قدمه",27,"م",2,0],["أَيُنْكِرُ مَعروفَنا المُنكِرُ","ويَكْفُرُهُ وهو لا يُكْفَرُ",28,"ر",1,1],["أَيُنْكِرُ أَقُوامٌ إذا قَالَ قائِلٌ","قَضَى رَبُّنا تَحْريمَ كُلِّ الْمَظالِمِ",29,"م",1,0],["ايُنْكَرُ مَعْرُوفٌ ويُعْرَفُ مُنْكَرٌ","ويُقْبَلُ في الدّينِ المطَهَّرِ جاحِدُهْ",30,"د",2,0],["أين كان الود يا من حبه","بسويداء فؤادي قد حجى",31,"ج",2,0],["أَين كؤوسِي وأَين أَكوَابي","فَهِي وحقِّ المجونِ أَوْلَى بي",32,"ب",2,1],["أَينَ كُتبُ الأَصحابِ تَطلَعُ تَترى","مِثلَما يَحتَسي السَلافَ المُكَرَّر",33,"ر",1,0],["أَيُنكِرُ الرَّميَ إِذ هَذي حَواجِبهُ","قَوسٌ بِقَوسٍ لِرَميِ الصّبِّ مقرونُ",34,"ن",1,0],["أَئِن كُنتُ في الفِتيانِ آلوتُ سَيِّداً","كَثيرَ شُحوبِ اللَونِ مُختَلِفَ العَصبِ",35,"ب",1,1],["أينكر فضلُ سيِدنا المعظم","مالكِ العصرِ",36,"ر",1,0],["أينكرون بأنّا لم نزل عَرَباً","نبني ونهدم أعراشاً وتيجانا",37,"ن",2,1],["أَيْنَ كِسْرى وقَيْصَرٌ مِنْ ملُوكِ","الأَرْضِ والْمُنْذِرُ بْنُ ماءِ السَّماءِ",38,"ا",2,0],["أين كأسي أرى الرفاق جميعا","يملأون الكؤوس خمرا شهيا",39,"ي",2,1],["أينكت ثغرا طيب الدهر ذكره","وما بارح التسبيح والحمد والشكرا",40,"ر",2,0],["أَيُنكَرُ نثرُ الدُّرِّ من بحر خاطرى","وتعلمُ أن الدُّرَّ معدِنُهُ البحرُ",41,"ر",1,0],["أينكر أرجوان الخد هذا","وذا أثر الدخان على الحواشي",42,"ش",2,0],["أيُنكِرَ أهْلُ العلم أنّكَ رَوْضَةٌ","يُسِيمونَ فيها والبلادُ هشيِيم",43,"م",1,0],["أين كنتم يُدرِككُمُ الموتُ حتى","لو حَوَتكم في بُرجِها الجَوزاءُ",44,"ا",2,0],["أينَ كِسرى قبلَه دا","راءُ بل أَينَ ابن داره",45,"ر",2,0],["أين كُتْبٌ للعلم إذ أحرقوها","برمادٍ منها أُقيمَ بناء",46,"ا",1,0],["أينكر معشر الشعراء أني","أسير مليحة تسبي الملاحا",47,"ح",2,1],["أي نكر أتى واي فجور","حسبه في الحساب نار الضرام",48,"م",1,0],["أَيُنكِرُ أفعالي وقَولي جماعةٌ","مُسَوَّدَةٌ والعارُ شَرُّ العَوَاقِبِ",49,"ب",1,0],["أينكرون إزدها روض البها وبه","لبينات على الخدين توريد",50,"د",1,0],["أين كان السر مدفو","نا أفي طي اللحود",51,"د",1,0],["أين كشاف غامضات العوي","صات بأنوار حدسه الإلهامي",52,"م",2,0],["أَيُنْكِرُ الوَجْدُ أَنِّي فِي الهَوىَ شَحِبُ","وَدُونَ كُلِّ دُخَانٍ سَاطِعٍ لَهِبُ",53,"ب",1,1],["أين كانوا يوم كنتم في لظى","سجناء الظلم في ذاك الأتون",54,"ن",1,0],["أين كان الكاتب الدساس في","زمن الأهوال والعهد اللعين",54,"ن",1,0],["أَينَ كانَ المُلوكُ عَن وَجهِها الطّل","قِ يُرينا إضاءةً إطْلاقُه",55,"ق",2,0],["أيُنكَرُ فضلُهُ والفضل منه","تفرَّقَ في بحابيح المهاد",56,"د",1,0],["أين كسرى وقيصر أين دارا","أين رب السدير والزباء",57,"ا",2,0],["أينكرُ سح الدمع والحزن والأسى","لمن شوقه شوقى ومَن خبلُه خبلى",58,"ل",2,0],["أينكر نص العيس والبيد والدجا","لمن عزمه عزمي ومن فضله فضلي",59,"ل",2,0],["أين كهف الناس أين الملتجا","أين من يحمي عن الباغي حماه",60,"ا",2,0],["أين كفّاك أجيبي بهما","يصبحُ القلب حياةَ النهر",61,"ر",1,0],["أيْنَ كَيْفَ وَمَتَى ؟!!","يَا لِقَلْبِيْ هَلْ نَسَى ؟!!",62,"س",2,0],["أَيْنَ كُنَّا حِينَ شَعَّ النُّورُ فِينَا ؟!","هَلْ تَعَشَّقْنَا بِأَطْيَافِ السَّنَاءِ ؟!",63,"ا",2,0],["أينكر أقوام علينا بزعمهم","مهاجرة العاصين قبح من زعم",64,"م",1,0],["أين كنتِ ؟ كيف جئتِ مضيئة ً","مثل البروق ِبعالمي المحجوب ِ",65,"ب",1,0],["أينكر نور الشمس والشمس في الضحى","ويجحد ضوء البدر والبدر طالع",66,"ع",1,0],["أيُنْكِرُ البدر طرفًا ظل يرعاه","أم ينكر الكأس صبًّا ظل يسقاه",67,"ا",2,1],["أينكر هذا عند من وطئي الثرى","ومن كان في بحر وقعر وقريةِ",68,"ه",1,0],["أَينَ كُنتُ وَمَن أَنا","كَيفَ يُمسي الَّذي أَراه",69,"ا",2,1],["اين كفّاك تجمعان الذي","يسقط من عقد عمري المقطوع",70,"ع",1,0]]}