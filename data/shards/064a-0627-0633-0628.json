{"poems":[[79,"يا سبتة العزفيين الألى درجوا","https://www.aldiwan.net/poem36659.html","البسيط"],[60,"أنا مذ كنت صبيا","https://www.aldiwan.net/poem30791.html","مجزوء الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9964","الخفيف"],[366,"يا آل طه من أتى حيكم","https://www.aldiwan.net/poem68064.html","السريع"],[500,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77520","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77736","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58415","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48422","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66326","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109887","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206137","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133270","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133273","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81273","الخفيف"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/205870","الكامل"],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[6355,"بيضي واصفري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66618&r=&rc=78",""]],"verses":[["يا سَبتَة العَزَفِيِّين الأُلى دَرَجوا","وقدْ تضوَّعَ منْ أخْبارِهِمْ أرَجُ",0,"ج",1,1],["يا سِبَاعَ البَرِّ زِيغي","وَكُلي ذا اللَحمِ نيّا",1,"ي",2,0],["يا سِباعَ الفَلا إِذا اِشتَعَلَ الحَر","بُ اِتبَعيني مِنَ القِفارِ الخَوالي",2,"ل",2,0],["يا سبط طه يا حسينا عَلى","ضريحك المَأنوس منى السَلام",3,"م",1,0],["يا سبط هند وابنها","دون البتول ولا كرامه",4,"م",2,0],["يا سَبع كَم في الفعل تَستضعفني","أَلم تَكُن في سَطوَتي تَعرفني",5,"ي",1,0],["يا سَبع تِلكَ في الوحوش شهره","عَرفتها المرة بَعدَ المَرّه",5,"ه",1,0],["يا سبط سبط السبط من أَسباطنا","يا جار دار جوارنا يا كاتب",6,"ب",1,0],["يا سَبالَ الهيتيِّ حرِّكتَ طبعي","بعدما كانَ ساكناً ذا قرارِ",7,"ر",1,0],["يا سَبالَ الهيتيِّ ما بالُ دَمعي","بينَ فَخْدَيَّ ساكِبَ التبّار",7,"ر",1,0],["يا سَبال الهيتي قد ضَر طول","الليلِ بي بعد هَجْعَةِ السّمْارِ",7,"ر",1,0],["يا سَبالَ الهيتيِّ صُبْغَتُكَ اليومَ","كَلَون الفقاحِ والجلنّارِ",7,"ر",1,0],["يا سَبْطَ مَنْ حاز النّبوءَةَ والهُدى","وبنُورِه غصّ الفضاءُ الأفْيَحُ",8,"ح",1,0],["يا سبط أشرف آلِ","إني بمدحك آل",9,"ل",1,0],["يا سِبطَ لاويَ قَدكَ بغياً إِنَّ هي","كلك اغتدَى في حَوزة الأَعداءِ",10,"ا",2,0],["يا سُبة الخلق هل في الأرض من دنسٍ","يزري بكم بعد هذا أي إزراء",11,"ا",2,0],["يا سبط خير المرسلين ومن له","أعلى العطايا باليد البيضاء",12,"ا",2,0],["يا سبط خير الخلق إنا في الحمى","فانظر إلينا نظرة الكرماء",12,"ا",2,0],["يا سبط خير الخلق مالى ملجأ","إلا حماك أؤمّه فأفاد",13,"د",1,0],["يا سَبيل الكِرام مِن بَطن طَيء","وَاِبن بَيت السَماح مِن كَردَفانه",14,"ن",2,0],["يا سبعةً كالأُسْدِ في هذا الحِمى","وجدوا التوحُّدَ عِزّةَ الأَقوامِ",15,"م",1,0],["يا سبيلا تلاقيا فيه عفوا","أنت للنبل كعبة وحطيم",16,"م",1,0],["يا سِبْطَ طَه وَهل غَادَرتَ ما فُرِضَتْ","إِلا وَوَجهَكَ للخَلَّاق قَد رَكَعا",17,"ع",2,0],["ياسبب مجد الإمارات وعماره","ياذرى كل الشعوب المستجيره",18,"ر",2,0],["يا سُبَّةً في عصْرنا المتَحضِّرِ","يا وصْمةَ التاريخ بيضي واصفري",19,"ر",2,1]]}