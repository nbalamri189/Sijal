//www.poetsgate.com/ViewPoem.aspx?id=108229",""],[5183,"على شعر ابن الدَّمينة","https://www.poetsgate.com/ViewPoem.aspx?id=180216",""],[5190,"عندليب البيان","https://www.poetsgate.com/ViewPoem.aspx?id=56113",""],[5273,"القتيل","https://www.poetsgate.com/ViewPoem.aspx?id=178282",""],[5277,"قسمةٌ ضيزى","https://www.poetsgate.com/ViewPoem.aspx?id=186525",""],[5286,"هو الشعر !..","https://www.poetsgate.com/ViewPoem.aspx?id=110863",""],[592,"ألا أيها الغادي على ظهر ضامر","https://www.poetsgate.com/ViewPoem.aspx?id=128828",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[5353,"الآتي الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212460",""],[5413,"هو الشمس إلا أنه ليس يختفي!","https://www.poetsgate.com/ViewPoem.aspx?id=200669",""],[5419,"وهل في الشعر يا أم ارحميني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=32254",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[327,"ما الناس إلا في رماقٍ وصالح","https://www.poetsgate.com/ViewPoem.aspx?id=3861",""],[5528,"لمن خلفهم عزم وشعلة نبراس","https://www.poetsgate.com/ViewPoem.aspx?id=201025",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[5753,"مولاي","https://www.poetsgate.com/ViewPoem.aspx?id=198597",""],[5776,"خارطة الثورة اليمانية","https://www.poetsgate.com/ViewPoem.aspx?id=199935",""],[5781,"بعضٌ من حب","https://www.poetsgate.com/ViewPoem.aspx?id=202852",""],[5809,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205300",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5957,"لأنك أنت الصباح المضيء","https://www.poetsgate.com/ViewPoem.aspx?id=18148",""],[5969,"سلام لمن رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=199203",""],[6045,"تحية الترحيب","https://www.poetsgate.com/ViewPoem.aspx?id=180624",""],[6152,"اتعبني التمني","https://www.poetsgate.com/ViewPoem.aspx?id=204822",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[5190,"هو الشعر أرقى فنون الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78296&r=&rc=9",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""],[5190,"إحساس شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85055&r=&rc=130",""]],"verses":[["هُوَ الشُغُلُ اِستَولى عَلى كُلُّ مُهجَةٍ","وَأَلقى ذِراعَيهِ بِكُلِّ جَنانِ",0,"ن",1,0],["هُوَ الشَوقُ مَدلولاً عَلى مَقتَلِ الفَتى","إِذا لَم يَعِد قَلباً بِلُقيا حَبيبِهِ",1,"ب",2,0],["هُوَ الشِّعْرُ الطَّلِيقُ مِنَ القَوَافِي","ومفْخَرَةُ النَّثِيرِ عَلَى النَّظِيمِ",2,"م",1,0],["هو الشمس بَثَّتْ في البسيطة نفعَها","وأنوارها أهدت قريباً وقاصيا",3,"ي",2,0],["هو الشعر لا أعتاض عنه بغيره","ولا عن قوافيه ولا عن فنونه",4,"ن",2,0],["هو الشاعر الفحل الذي راح شعره","بانشاده في البَرّ والبحر سائرا",5,"ر",2,0],["هو الشمس إشراقاً ولكنني أرى","من الحرمِ إني عنهُ لا أتحوَّل",6,"ل",1,0],["هو الشمس يَغشاني سناها ونفعُها","وتُعجزُ لمسي حين يطلبُها لمسي",7,"س",2,0],["هُوَ الشَعبُ قَد وافاكَ كَالبَحرِ زاخِراً","وَكَالجَيشِ يَقفو فَيلَقٌ إِثرَ فَيلَقِ",8,"ق",1,0],["هو الشيخ الفتىّ لو استراحت","من الدأب الكواكب ما استراحا",9,"ح",2,0],["هُوَ الشُجاعُ يَعُدُّ البُخلَ مِن جُبُنٍ","وَهوَ الجَوادُ يَعُدُّ الجُبنَ مِن بَخَلِ",10,"ل",1,0],["هو الشوقُ حتى ما تَقَرُّ المضاجِعُ","وبَرْحُ الهَوى حتى تَضيق الأضالعُ",11,"ع",1,1],["هُوَ الشِهابُ الَّذي يُرمى العَدُوُّ بِهِ","وَالمَشرِفِيُّ الَّذي تُعصى بِهِ مُضَرُ",12,"ر",1,0],["هُوَ الشَيخُ وَاِبنَ الشَيخِ لا شَيخَ مِثلَهُ","أَبو كُلُّ ذي بَيتٍ رَفيعِ الدَعائِمِ",13,"م",1,0],["هو الشن وما واف","ق منا طبق شنا",14,"ن",2,0],["هو الشِّفَاءُ لأداوءِ النّفوسِ إذا","حَارَ الطبيبُ وأَمْسَى رَهْنَ إخفاقِ",15,"ق",1,0],["هُوَ الشفيعُ إِذَا كانَ المعادُ غَداً","واشتَدَّ لِلحَشرِ تَخوِيفٌ وتَهوِيلُ",16,"ل",1,0],["هو الشعب إذ لم تملك القول ألسن","وإذا لم تسغ برد الشراب حُلوق",17,"ق",1,0],["هُوَ الشِهابُ الَّذي يُكوى العَدُوُّ بِهِ","وَالمَشرَفِيُّ الَّذي تَعصى بِهِ مُضَرُ",18,"ر",1,0],["هُوَ الشَرُّ قَد عَمَّ في العالَمينَ","أَهلَ الوُهودِ وَأَهلَ الذُرى",19,"ر",2,0],["هُوَ الشَيخُ لَم يَرضَهُ أَهلُهُ","وَلَم يُرضِ في فِعلِهِ أَهلَه",20,"ل",2,0],["هوَ الشّهْدُ مَجّتْه الخُطوبُ مرَارَةً","وقد فَغَرَتْ أفْواهَها لالتِهامهِ",21,"م",2,0],["هُوَ الشُكرُ الجَسيمُ عَلى الأَعادي","إِذا شُكرُ الرِجالِ غَدا ضَئيلا",22,"ل",2,0],["هو الشرقُ لم يهدأ بصبحٍ ولم يَطِبْ","رقاداً على ليلٍ رماكِ بزلزالِ",23,"ل",1,0],["هو الشرقُ أَلقى عن يديهِ قيودَه","فلا تحسبيهِ في قيودٍ وأغلالِ",23,"ل",1,0],["هو الشرقُ ثارت روحُهُ فهو لُجّةٌ","من النّارِ تُذكيها رياحٌ تَهزَّمُ",24,"م",1,0],["هو الشعر إيقاع الحياة وشدوُها","وحُلْمُ صِباها في الرَّبيع المباكِرِ",25,"ر",1,0],["هُوَ الشمسُ يدنُو في الظَّهيرةِ ضَوْءُهَا","ويَصْعُبُ مَرْآهَا على مَن يُحَاوِلهْ",26,"ل",2,0],["هو الشأن بالتوفيق تزكو ثماره","ومتجره والله ليس يبور",27,"ر",1,0],["هو الشعب طاف بإنذاره","على من تحدّاه واستعبدا",28,"د",2,0],["هو الشرّ، قد عمّ، في العالَمين،","أهلَ الوُهودِ، وأهل الذُّرا",29,"ر",2,0],["هو الشهم محبوب الإله صفيه","ومأمونه في كل ما كان قاضيا",30,"ي",2,0],["هو الشمس والبدر النجوم تضاههْ","هدايته تحيي لكونِهَ راجحا",31,"ح",2,0],["هو الشريف الذي لولاه ما هربت","أبطال كفرٍ ولكن منه قد هربوا",32,"ب",3,0],["هو الشريف الذي لولاه ما ذهبت","شحنا ولكن به أسبابها ذهبوا",32,"ب",3,0],["هو الشريف الذي لولاه ما خربت","جنود إبليس لكن منه قد خربوا",32,"ب",3,0],["هو الشريف الذي لولاه ما شربت","أهل المعارف لكن منه قد شربوا",32,"ب",3,0],["هو الشريف الذي في النأْي قد قربت","ضمائر منه للإله قد قربوا",32,"ب",3,0],["هو الشمس فوق الأنام عرين","وعون لها في الأمور عوين",33,"ن",1,0],["هو الشيخ عبد الله نسلُ محمدٍ","سليلٌ على الندبِ ذاكَ المُشقّعُ",34,"ع",1,0],["هُوَ الشَمسُ نوراً والنَبيونَ أَنجُمُ","عَلا لَيلَةَ الإِسراءِ وَالناسُ نُوَّمُ",35,"م",1,0],["هو الشرع فليستعصمون بحبله","وليّون والأشقون من قطعوا الحبلا",36,"ل",2,0],["هُوَ الشَمسُ في جَوِّ السَماءِ وَنُورُها","عَلى كُلِّ مَن فَوقَ البَسيطَةِ شامِلُ",37,"ل",1,0],["هُوَ الشَمسُ نُوراً وَاِرتِفاعاً وَشارَةً","كَما قَد تَسَمّى وَالمُلوكُ ذُبالُ",38,"ل",1,0],["هُوَ الشَمسُ بَل لَو قابَلَ الشَمسَ بشرُهُ","لَما اِستوضحَت إِلّا كَحَلقَةِ خاتِمِ",39,"م",1,0],["هوَ الشفيعُ لمولاه وسيّدهِ","في كلِّ حالٍ مغيث المستغيث بهِ",40,"ب",2,0],["هوَ الشافعُ المقبولُ أفضلُ مرسلٍ","لَديكَ فجُد واِمنح لأمّتهِ النصرا",41,"ر",2,0],["هوَ الشمسُ إلّا أنّ في الكونِ نورهُ","يدومُ وَنورُ الشمس ليس يدومُ",42,"م",1,0],["هُوَ الشَمسُ حُسناً فَلا غَروَ أَن","تَظَلُّ النَدامى لَدَيهِ مَجوسا",43,"س",2,0],["هو الشيخ لما صفا جوهر ال","فضائل منه ولم يكدرِ",44,"ر",1,1],["هو الشيخ محيي الدين عارفُ وقته","وأفكار أهل الجهل عن كتبه تقصُرْ",45,"ر",1,1],["هُوَ الشَّيْخُ أَبْرَدُ شَيْءٍ يُرَى","إِذَا لَبِسَ البُرْنُسَ الأَبْيَضَا",46,"ض",2,0],["هو الشّعرُ فيهِ كلُّ فنٍّ وحِكمةٍ","وأطرافُهُ مَوصولةٌ بالطَّرائف",47,"ف",1,0],["هوَ الشافِع المَقبول في الحشر للورى","اذا عمل الانسان لم يتقبل",48,"ل",1,0],["هُوَ الشَّفِيعُ لِتَالِيهِ وَحَاذِقِهِ","وَمِثْلُهُ غَيْرُ مَرْدُودٍ إِذا شَفَعا",49,"ع",2,0],["هُوَ الشَمسُ لِلمُلكِ وسطَ السَماءِ","وَلا مَلِكٌ بَعدُ إِلّا سُهاها",50,"ا",3,0],["هُوَ الشَمسُ وَالسَّرجُ الهِلالُ وَطَرفُهُ","لَهُ فَلَكٌ في حِليَةٍ هِيَ أَلجُمُ",51,"م",1,0],["هو الشَريفُ الَّذي فاق الورى شرفاً","سل عن مفاخره من شئت يعترفِ",52,"ف",1,0],["هو الشعرُ ما أَداه طبعُ (محمد)","أَدار عَلَى الأَلبابِ من سحرِه خمرا",53,"ر",2,0],["هُوَ الشَهم أَمّا حلمه فَهوَ وافر","مَديدٌ وَأَمّا عِلمهُ فَغَزيرُ",54,"ر",1,0],["هُوَ الشَهم عَبد اللَه وَالجَهبذ الَّذي","لرفع عِماد الدين قَد بَذل النُصحا",55,"ح",2,0],["هو الشّمسُ والعافون أَقمارُ أفْقهِ","تُجِدُّ وتُبْلِي النُّورَ ممّا يُفيدها",56,"د",3,0],["هوالشّمسُ في العَلْياهوالدّهرُفي السُّطا","هوالبَدْرُفي النّادي هو البحرُ في النَدى",57,"د",2,0],["هُوَ الشَمسُ وَجهاً قَد بَلَغتُ هَجيرَها","مِراراً وَوَجهُ الرَأيِ أَن أَتَحَوَّلا",58,"ل",2,0],["هُوَ الشُهبُ نوراً يَومَ يَختَرِقُ المُنى","سَريعاً فَإِن أَنصَفتَهُ فَهوَ السُحبُ",59,"ب",1,0],["هو الشَّرف الأَعلى هو العلم والتّقى","توَرَّثه عن جدِّه سيِّد الرّسل",60,"ل",1,0],["هو الشَّهم الَّذي لا عيب فيه","سوى العرض النقيّ 