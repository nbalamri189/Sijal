{"poems":[[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[70,"عليك سلام الله يا قبر عثمان","https://www.aldiwan.net/poem42450.html","الخفيف"],[38,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[97,"هم أناخ فما انجلى","https://www.aldiwan.net/poem24903.html","مجزوء الكامل"],[44,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[31,"لم يقض ذو الشجو ممن شفه أربا","https://www.aldiwan.net/poem42634.html","البسيط"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[38,"يا أهلِ ما بالُ هذا اللّيلِ في صفرِ","https://www.poetsgate.com/ViewPoem.aspx?id=21195",""],[260,"برج يؤثمني ويكفر نعمتي","https://www.aldiwan.net/poem1115.html",""],[443,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[468,"ذو غضب قاتلي بعلته","https://www.aldiwan.net/poem60337.html","المنسرح"],[562,"فقدت كرام بني طراد فاضلا","https://www.aldiwan.net/poem52682.html","الكامل"]],"verses":[["في إِثرِهِ غُضفٌ مُقَلَّدَةٌ","يَسعى بِها مُغاوِرٌ أَطحَل",0,"ل",1,0],["فَيا ثاوِياً قَد طَيَّبَ اللَهُ ذِكرَهُ","فَأَضحى وَطيبُ الذِكرِ عُمرٌ لَهُ ثانِ",1,"ن",1,0],["في إِثرِ ما قُطِّعَت مِنّي قَرينَتُهُ","يَومَ الحَدالى بِأَسبابٍ مِنَ القَدَرِ",2,"ر",1,0],["في إِثر أخرى لم تكن","إلا كجرداء الفلا",3,"ل",2,0],["فَيا ثَلَجَ الفُؤادِ وَكانَ رَضفاً","وَيا شِبَعي إِذا يَمضي وَرِيِّ",4,"ي",1,0],["في إِثرِ غانِيَةٍ لَم تُمسِ طِيَّتُها","إِلّا المُنى أَمَماً مِنّا وَلا صَقَبا",5,"ب",2,0],["في إِثرِ سارِيَةٍ تَبَط","طَنَ نورُها خَفضاً وَرَبوا",6,"و",2,0],["في إِثرِ غانِيَةٍ رَمَتكَ بِسَهمِها","فَأَصابَ قَلبَكَ غَيرَ أَن لَم تُقصِدِ",7,"د",1,0],["فِي إثْرِ مَنْ قُطِّعَتْ مِنِّي قَرِينَتُهُ","يَوْمَ الْحَدَالَى بِأسْبَابٍ مِنَ الْقَدَرِ",8,"ر",1,0],["في إِثرِ إِخوانٍ لَنا مِن طَيِّءٍ","لَيسوا بِأَكفاءٍ وَلا بِكِرامِ",9,"م",1,0],["في إثر سعيد يا أسعد","أبذاك قضى الدهر الأنكد",10,"د",1,1],["فَيا ثِقاتي هَل فيكُمُ أَحَدٌ","يُرشِدُ مَن ضَلَّ في بَلِيَّتِهِ",11,"ت",2,0],["في إثْرهِ التأريخُ يدعو قائلاً","فُتحتْ لفتحِ اللهِ أبوابُ السما",12,"م",2,0]]}