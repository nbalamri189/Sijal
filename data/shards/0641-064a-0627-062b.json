{"poems":[[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[72,"عليك سلام الله يا قبر عثمان","https://www.aldiwan.net/poem42450.html","الخفيف"],[40,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[99,"هم أناخ فما انجلى","https://www.aldiwan.net/poem24903.html","مجزوء الكامل"],[46,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[33,"لم يقض ذو الشجو ممن شفه أربا","https://www.aldiwan.net/poem42634.html","البسيط"],[54,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[40,"يا أهلِ ما بالُ هذا اللّيلِ في صفرِ","https://www.poetsgate.com/ViewPoem.aspx?id=21195",""],[265,"برج يؤثمني ويكفر نعمتي","https://www.aldiwan.net/poem1115.html",""],[449,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[473,"ذو غضب قاتلي بعلته","https://www.aldiwan.net/poem60337.html","المنسرح"],[567,"فقدت كرام بني طراد فاضلا","https://www.aldiwan.net/poem52682.html","الكامل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105611","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59696","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59110","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64703","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93106","المتقارب"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113954","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111829","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108973","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66258","المتقارب"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77221","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120721","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93426","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58303","الرجز"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145868","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87607","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123939","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138655",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138623",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101241","السلسلة"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36775","الرجز"],[3802,"","https://poetry.dctabudhabi.ae/diwan/poem/141082","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57965","الطويل"],[4578,"نهي بك الأيام والبشر شامل","https://www.poetsgate.com/ViewPoem.aspx?id=49506",""],[5431,"من هلوسات الحمى (3)-وشعبي سيغلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=198325",""]],"verses":[["في إِثرِهِ غُضفٌ مُقَلَّدَةٌ","يَسعى بِها مُغاوِرٌ أَطحَل",0,"ل",1,0],["فَيا ثاوِياً قَد طَيَّبَ اللَهُ ذِكرَهُ","فَأَضحى وَطيبُ الذِكرِ عُمرٌ لَهُ ثانِ",1,"ن",1,0],["في إِثرِ ما قُطِّعَت مِنّي قَرينَتُهُ","يَومَ الحَدالى بِأَسبابٍ مِنَ القَدَرِ",2,"ر",1,0],["في إِثر أخرى لم تكن","إلا كجرداء الفلا",3,"ل",2,0],["فَيا ثَلَجَ الفُؤادِ وَكانَ رَضفاً","وَيا شِبَعي إِذا يَمضي وَرِيِّ",4,"ي",1,0],["في إِثرِ غانِيَةٍ لَم تُمسِ طِيَّتُها","إِلّا المُنى أَمَماً مِنّا وَلا صَقَبا",5,"ب",2,0],["في إِثرِ سارِيَةٍ تَبَط","طَنَ نورُها خَفضاً وَرَبوا",6,"و",2,0],["في إِثرِ غانِيَةٍ رَمَتكَ بِسَهمِها","فَأَصابَ قَلبَكَ غَيرَ أَن لَم تُقصِدِ",7,"د",1,0],["فياثلمة للدين والفضل مالها","سداد ولا اذ يقدم الدهر تقدم",8,"م",1,0],["فِي إثْرِ مَنْ قُطِّعَتْ مِنِّي قَرِينَتُهُ","يَوْمَ الْحَدَالَى بِأسْبَابٍ مِنَ الْقَدَرِ",9,"ر",1,0],["في إِثرِ إِخوانٍ لَنا مِن طَيِّءٍ","لَيسوا بِأَكفاءٍ وَلا بِكِرامِ",10,"م",1,0],["في إثر سعيد يا أسعد","أبذاك قضى الدهر الأنكد",11,"د",1,1],["فَيا ثِقاتي هَل فيكُمُ أَحَدٌ","يُرشِدُ مَن ضَلَّ في بَلِيَّتِهِ",12,"ت",2,0],["في إثْرهِ التأريخُ يدعو قائلاً","فُتحتْ لفتحِ اللهِ أبوابُ السما",13,"م",2,0],["فيا ثمال العفاة المسنتين إذا","ما الغيث أكدى فلا يلوي على أحد",14,"د",1,0],["فيا ثاوياً حيث الحمى وعُهودُهُ","تروقُ بدورُ في عُلاهُ وأنجمُ",15,"م",1,0],["فَيَا ثَنَائِيَ انْشُرْ مَا طَوَاهُ وَسِرْ","وَيَا رَجَائِيَ لاَزِمْ بَابَهُ وَقِفِ",16,"ف",1,0],["في إِثرِ نَعش عليه واحدُها","في صدره طَعنَةٌ تساورها",17,"ر",3,0],["فَيا ثَقاتي دَعُوا ملامي","ما هكذا تَفعَلُ الثِقاتُ",18,"ت",1,0],["في اثنين في مضارع والمقتضب","وفي سواهما لها منع موجب",19,"ب",1,0],["فيا ثاوياً يملأ الكائنات","علاً ويضيء الوجود منارا",20,"ر",2,0],["في إثرِ أظعانٍ سَلَكنَ بواكِراً","بينَ الصريمِ فمَنبتِ الأسباطِ",21,"ط",1,0],["فيا ثغر بالله فسّر غرامي","فانكَ تروي حديث المبرّد",22,"د",1,0],["فيا ثغرهُ أنَّى حمتكًَ لحاظهُ","وأنتَ برودٌ واللحاظُ فواترُ",23,"ر",1,0],["فيا ثغر روزا جامع الخمر والصفا","ألا غلطة يوماً فيعطى لعيسوي",24,"ي",1,0],["فيا ثاوياً يملأ الكائنات","علاً ويضيىء الوجود منارا",25,"ر",2,0],["فَيا ثُقلَ ما حُمِّلتُ حينَ أَعَنتُهُ","بِيُمنايَ مِن نُعمى بَخيلٍ تَنَقَّبا",26,"ب",2,0],["فيا ثائرَ العتبِ الذي قد عكستَهُ","بحقٍ ألا فارجع على مَن أشاركا",27,"ك",2,0],["في إِثرها وَقعت مَلاحم تَجتَلي","التاريخ بَينَ سَحائب وَمحولِ",28,"ل",1,0],["في إثره دَجَاجَة","مصلوقة في مَرَقَه",29,"ق",2,0],["فيا ثورة تتحدى الصعاب","وتزحف ساخرة بالممات",30,"ت",1,0],["فَيا ثُرَيّايَ ها شَمسٌ مؤَرَّخَةٌ","فان ظِفرتِ بها أُهدي الهنآءَ لكِ",31,"ك",1,0],["فيا ثعلبي الرمي لحظك رائش","وقدك عسال وعطفك ذابل",32,"ل",1,0],["فيا ثاوياً في الرمس مذ غبت أشبهت","لفقدك أيام الزمان اللياليا",33,"ي",2,0],["فيا ثاوياً في أرض بغداد شاسعاً","عن الدار ربع الرشد تبكيك عيناه",34,"ا",2,0],["في إثر محبيك للقياك عدوت","في بادية العشق وقد تهت وتاهوا",35,"ه",3,0],["في إِثرِها بَوارِقٌ","تَرمي شرارَ اللَهَبِ",36,"ب",1,0],["فيا ثاويا في قلب كل موحد","عليك سلام الله في القرب والبعد",37,"د",1,0],["في إثره هكطور كالبرق ركص","لكن إيذومين في الحال اعترض",38,"ض",1,0],["فيا ثلمة في الدين يشتدَّ بابُها","إلى النشر لَمَّا أن ثوى بيننا القطب",39,"ب",1,0],["فيا ثغر بيروت لك الأنس والمنى","بمن لك تهدي الدر منه الأنامل",40,"ل",1,0],["فيا ثورتي احتدي ضياء وثابري","وشعّي كما النجم المنيرُ المقرّبُ",41,"ب",1,0]]}