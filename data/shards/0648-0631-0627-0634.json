{"poems":[[463,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38770","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129524","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96391","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62569","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59067","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64669","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115859","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123678","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115667","البسيط"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22533","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46920","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""]],"verses":[["وراش حالي فتحلَّقْتُ به","من بعد ما كنتُ قصيصاً واقعا",0,"ع",2,0],["وَراشَت سِهام الحبّ أَجفانَكَ الّتي","رَمَتني بِسَهمِ العشقِ مِن وطف الهدبِ",1,"ب",1,0],["وراشوا سهام المكرمات وأشحذوا","ظُباها كما فلوا سيوف النوائب",2,"ب",1,0],["وراشَتِ الريحُ بالبُهمي أشاعرَهُ","فآض كالمَسَدِ المفتولِ احناقا",3,"ق",2,1],["وراشد راشد في نهج مكرمةٍ","أخلاقه بالرضا تقضي وبالسخطِ",4,"ط",1,0],["وَرَاشِ سَهْمَ الحَيَا قَوْسُ السَّحابِ إلَى","أن صَادَرَتْهُ يَدٌ الأوْرَاقِ بِالدَّرَقِ",5,"ق",1,0],["وراشَقَتْني إشاراتٍ رَجْوتُ بِها","تصديقَ ظنِّ الأماني بَعْدَ تكذيبِ",6,"ب",1,0],["وراش باللّحظ سهامَ الهوى","وفَّوقن السهم من الحاجب",7,"ب",1,0],["وراش نبالاً لم تفت مقتل العدى","وأقتلُ سهمٍ ما يريش نبيلها",8,"ل",3,0],["وراش لي أسهماً من هدب مقلته","أصمت فؤاد المعنى عندما رشقا",9,"ق",2,0],["وراشق اللحظ قد هفابي","قوامه الأهيف الرشيق",10,"ق",1,1],["وَراشَيتُ حَتّى لَو تَكَلَّفَ رِشوَتي","خَليجٌ مِن المُرّانِ قَد كادَ يُنزَحُ",11,"ح",1,0],["وَراشَ جَنَاحِيَ المَقْصُوصَ ظُلْماً","وَأنْسَانِي الأحِبَّةَ والمَغَانِي",12,"ن",2,0],["وَراشَ لِلقَلبِ سَهماً من لَواحِظه","فَهَل تُرى ما دَرى وَيلاهُ من فيهِ",13,"ه",1,0],["وراشها الوردي يقطر نشوةً","فكأنه دوامةٌ بحرية",14,"ي",2,0]]}