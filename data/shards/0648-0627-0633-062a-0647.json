{"poems":[[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[75,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[90,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"تتجافى جنوبهم","https://www.aldiwan.net/poem65083.html","مجزوء الخفيف"],[72,"دخلت مصر غنيا","https://www.aldiwan.net/poem42805.html","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[27,"يَاحُرَّ أَمْسَيْتُ شَيْخاً قَدْ وَهَى بَصَرِي","https://www.poetsgate.com/ViewPoem.aspx?id=18372",""],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[146,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[203,"هدم الأنام وجئت انت تشيد","https://www.aldiwan.net/poem45155.html","الكامل"],[246,"أودى بي الحزن واغتال الجوى جلدي","https://www.aldiwan.net/poem45759.html","البسيط"],[309,"يا وجيه إنها هب","https://www.aldiwan.net/poem16885.html","عموديه"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[354,"لذ بالثناء على الإله","https://www.aldiwan.net/poem15798.html","مجزوء الكامل"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[382,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[438,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[438,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[443,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[466,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[466,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[563,"اصبر على ضر البلايا","https://www.aldiwan.net/poem33572.html","مجزوء الكامل"],[563,"يعلم الحق نفسه بالذي قد","https://www.aldiwan.net/poem34093.html","الخفيف"],[563,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2508","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122687","الخفيف"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104026","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126567","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56126","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79787","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79864","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79934","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202553","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202174","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109331","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53109","المنسرح"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93923","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104682","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140313",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132781","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62842","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66434","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109996","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131344","الخفيف"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/198733","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90817","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33522","الخفيف"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99116","الخفيف"],[4767,"نعي الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=89357",""],[4927,"طيب عيد العراق","https://www.poetsgate.com/ViewPoem.aspx?id=12982",""],[4984,"دوامة الفتن","https://www.poetsgate.com/ViewPoem.aspx?id=180639",""],[5121,"يَا طُيُورُ اذْكُرِيِنِي","https://www.poetsgate.com/ViewPoem.aspx?id=49541",""],[5183,"وقِّر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=186456",""],[5199,"كلنا لجل الملك والسعوديه فدى","https://www.poetsgate.com/ViewPoem.aspx?id=147704",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5953,"طوس يا طوس لا عد مناك طوسا","https://www.poetsgate.com/ViewPoem.aspx?id=93790",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[2588,"شاخصة (حجر طفل)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65632&r=&rc=64",""]],"verses":[["وَاِستَهَلَّت سُحبُ البُكاءِ عَلى الوا","دي فَغَطَّت خَضراءَهُ وَاليَبابا",0,"ب",2,0],["وَاِستَهدِ مِن أَحمى مَراتِعَها المَها","فَالصَعبُ يَسمَحُ في عِنانِ هَواكا",1,"ك",2,0],["واستهانُوا بالوعد إذ أخلفوه","واستغلّوا دفائن الأوطان",2,"ن",1,0],["واسْتَهَبَّ الرُقودُ للشكر فالأم","مَةُ من ذي تَهَجُّدٍ أو هُجُودِ",3,"د",1,0],["واستهلَّت عيونهم","فائضاتِ المدامع",4,"ع",1,0],["وَاِستَهلَكَ البَيعُ حَتّى","طَرّاحَتي وَلِحافي",5,"ف",2,0],["واسْتَهْزَأَتْ تِرْبُهَا مِنِّي فَقُلْتُ لَهَا","مَاذَا تَعِيبَانِ مِنِّي يَا بْنَتَيْ عَصَرِ",6,"ر",1,0],["واستهلّت دمعةٌ منْ عينها","دمعةٌ رفّتْ وشفّتْ قطرتاها",7,"ا",3,0],["واسْتَهْزَأَتْ تِرْبُهَا مِنِّي.فَقُلْتُ لَهَا",": ماذا تعيبانِ منِّي يا بْنَتَتيْ عَصَرِ؟",8,"ر",1,0],["واستَهلَّ الشَّمَالَ مِنهُ فَرَوَّى","وغَدَا كُلُّ مَوضِع مِنهُ مَطمُومَا",9,"م",2,0],["واستهدفته ال","لحظات مثنىَ أو أُحاد",10,"د",1,0],["واستهدت الخصورُ من بَنانها","خواتما تلبَسها مَناطقا",11,"ق",2,0],["واستهدفوا يفدونها حريةً","بنفوسهم وكذا يسود السيد",12,"د",1,0],["واستهدَفَتني صُروفُ الدهر راميةً","تُصوبُ النبلَ نحوَ القلبِ والكبدِ",13,"د",1,0],["واستهل الحيا المغ","دق وحن الرعود",14,"د",1,0],["وَاِستهدفَ الدينُ الحنيف بظنّةٍ","في غربه لِمطاعنِ المطعانِ",15,"ن",1,0],["وَاِستَهدِهِ لِسَبيلِهِ","وَاِستَجدِهِ مِن رِزقِهِ",16,"ق",2,0],["وَاِستَهامَ الصينُ عَن أَنهارِها","بِسَرابٍ ظَنَّهُ الظامي مُوَي",17,"ي",1,0],["وإستهجنتْهُ واشتفتْ يوم صلبه","أعاديه واستزرته يوماً أقاربه",18,"ب",2,0],["واستهلّوا بشاشة وابتساما","لو سألتَ العُلى أجابَتْكَ عنهم",19,"م",1,0],["واستهلَّتْ به سحابُ الأَراجِي","ودفِينُ الحَيَا بها والحياةِ",20,"ه",1,0],["واستهدِ ألطافَ النسيم رسالةً","أوصاه مندلُه",21,"ه",1,0],["واستهلّت بك السحائب تحدو","ديمة فيك ديمة وطفاء",22,"ا",2,0],["واستهون القومُ المقالَ سفاهةً","فالفضلُ للسكيت لا المُتكلمِ",23,"م",1,0],["واستهْدم الجدْبُ الغوارب والذرى","حيث البَهازِرُ والصِّعابُ البُزَّل",24,"ل",1,0],["واستهلت مواطرُ المزنِ من غي","ر رعودٍ مخشيةٍ أو رياح",25,"ح",1,0],["واستهزأوا لطهارة","فينا وهم خُبْثُ الطوايا",26,"ا",3,0],["واستهمها حظاً ودع كل حظٍّ","فلها الحق كل شيء أسهمْ",27,"م",1,0],["واستهانوا بي وقد قهروا","ثم صالوا صول منتقم",28,"م",1,0],["وَاِستَهَلَّت عَلَيهِمُ الطَيرُ بِالجَن","دَلِ حَتّى كَأَنَّهُ مَرجومُ",29,"م",1,0],["واستَهَلَّت سَماءُ غَيثِكَ بالغَي","ثِ إلى أن جَرَت بِسَيلِ حِجافِ",30,"ف",1,0],["واستهلّت رفقاً كما يقعُ الطلُّ","على الورد في دُجى الأسحارِ",31,"ر",1,0],["واستهلك الاسطول من لم يلقه","بالنفس منه على الظبا بضنين",32,"ن",1,0],["واستهلت مدامعي فرثت لي","غذ رأتني حرمت في الحب صبرا",33,"ر",2,0],["واستهونت عرجانهم طرقي ولم","يدروا بان العُرج بي لا تلحقُ",34,"ق",1,0],["واستهلَّت طير السماءِ وقالت","مشعُ الطير جاء يطوي السُّهوبا",35,"ب",2,0],["واستهلَّ الدهرُ يُثني مُطرباً","عطفَ نشوانٍ ويختالُ ازدهاءا",36,"ا",3,0],["واستهلَّ السعدُ في أبياتكم","فاكتست من حُللِ الزهو رقوما",37,"م",2,0],["واستهلَّت كلتا يديه إلى أن","لم يدع في بني الزمانِ عَديما",38,"م",2,0],["واستهلت جناتُ عدنٍ وحورُ ال","عينِ شوقاً إليهم استهلالا",39,"ل",2,0],["واستهبا طيب النسيم حجازي","ياً عسى أن يفوح منه بردع",40,"ع",1,0],["واستَهلَّت بالرُّقَيْطا أَدْمُعٌ","منه تَستْضحك تلِك الدَّمَنا",41,"ن",2,0],["واستهتروا بالشرع بل","عمدا لقد راموا اهتباله",42,"ل",2,0],["واستهدِ لي نفحة أعيش بها","من روض نجد مَيثَاءُ معطار",43,"ر",1,0],["واستهلت زبيدةٌ بابتسام","يفتن اللب ثغرها المحبوب",44,"ب",1,0],["واستهلت مدامع المزن تبكي","وبدا الأقحوان يضحك سنا",45,"ن",2,0],["وأستهيم وقلبي يستفز لإن","هبت لنشر الصبا النجدي هبات",46,"ت",1,0],["واستهل هلال العيد أحسبه","طوقاً لمي به زينت تراقيها",47,"ي",3,0],["واستهانت بالمسلمين جميعا","واستخفت بالخطة الدوليه",48,"ي",2,0],["واِستَهدفي ما شئت من","مهج الوَرى وَتخرّمي",49,"م",2,0],["واستهلتْ بما تحب وتختا","رُ عليكَ الشُّهورُ والأَعوامُ",50,"م",1,0],["واستهلت دموعهم أسفاً","حين أرّخت غاب نجمهمُ",51,"م",1,0],["واستهدَفَتني النائباتُ فلم أَزَل","طولَ المَدى لِسهامِها أَستهدفُ",52,"ف",1,0],["وإِستِهجانُ لوطَ البارِ لمَّا","احلَّ بسكُرهِ عِقدَ الحَرامِ",53,"م",1,0],["واسْتَهلَّتْ مَدامعِي كالغَوادِي","وغَدَا القلبُ مِن جَواهُ وَطِيسَا",54,"س",2,0],["واستهجنوا حرمات شعب آمن","واستبدلوا الايمان بالإلحاد",55,"د",1,0],["واستهل البرق منه عسجدا","ولجيناً هل فيه البرد",56,"د",1,0],["واستهدي وشمس الراح تجري","إلى أقمارها والليل هادي",57,"د",2,0],["واستهلت بوارقَ الأنعم الغُر","به في حيا الأيادي الغُزرِ",58,"ر",1,0],["واستهلت بالدمعِ عيني عليهِ","جزعاً حينَ ما إليهِ سبيلُ",59,"ل",1,0],["واستهلت لمصرع الليل ورقٌ","ثاكلاتٌ حدادها التطويق",60,"ق",1,0],["واسته في مأساته أمم","ضمت بأفق سمائها الرسلا",61,"ل",2,0],["وَاسْتَهْتَرَ الْهَمَلُ الرَّعَاْعُ، وَهَرْوَلُوْا","نَحْوَ الْعَدُوِّ، فَذَلَّهُمْ جَلاّدُهُ",62,"د",2,0],["واستهدف القصف عن بعد حواضرَها","من السماء ومن غواصة السفن",63,"ن",1,0],["وَاسْتَهَلَّتْ أُغْنِيَاتِي","فِي تَبَاشِيِرِ السُّطُورْ",64,"ر",1,0],["واستهاموا والدجى يجزؤهم","بسياطٍ شرراً ملتهبا",65,"ب",2,0],["واستهلت وامطرت واستوا حرف القصيد","فى قراء الحره مقرن لعبس ويكدى",66,"د",2,0],["[ وَاسْتَهْوَنَ الحَرْبَ مِنْهُ وَاسْتَعَدَّ وَقَدْ","شَقَّ العَصا بَعْدَ سِلْمٍ كانَ وَاحْتَقَرا ]",67,"ر",2,0],["واستهل البيت والركن لما","كسيت من نوره الخافقان",68,"ن",1,0],["واستهل الرشاد والدين والرش","د وأبان الهدى فأنباه سوسا",69,"س",2,0],["وَاستَهانَتْ بِنُونِنا حَيثُ قالَتْ:","(يُونُسٌ فِي قَرارَةِ البِطرِيقِ)",70,"ق",1,0],["وَاستَهزأتْ بِي عِندَما ضَحِكَتْ","- وَيحِي - عَلَى قَلبِي وَمَا بَذَلا",71,"ل",2,0],["وَاستهون المَوت الزوام عن النَوى","وَلو نَقعوا الصَبر السقطري غَزالها",72,"ل",3,0],["واستهجنوها قراراتٍ مدوِّيةً","لا في الميادين بل حبراً على ورقِ",73,"ق",1,0]]}