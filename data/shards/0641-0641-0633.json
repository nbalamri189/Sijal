{"poems":[[71,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[164,"أهلا بطرس من إمام مدته","https://www.aldiwan.net/poem59120.html","الرجز"],[190,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[406,"إيقاعات على نيل مصر","https://www.aldiwan.net/poem6726.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37869","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202080","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65959","الطويل"],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""]],"verses":[["ففستقُها عند ابتسامِ ثغورهِ","يُضاحِكُ برقاً قد أضاءَ بذي الأضا",0,"ض",2,0],["ففسخت نكاحه زوجته","من قبل أن يمسها ببضعته",1,"ت",2,0],["ففسّرت ما يرجى ويخشى ويتّقى","وشانيك من ريب الردى غير سالم",2,"م",1,0],["ففسُطَاطُ عمروٍ له صورةٌ","حقيقتها فوقَ ما ننقلُ",3,"ل",1,0],["فَفَسادُهُ مِن أَهلِهِ","وَدَليلُهُ ظهرَ الفسادُ",4,"د",1,0],["ففسَادٌ في الآخر النقْضُ وإن كا","نَ صلاحاً في الأوَّل الإبرَام",5,"م",1,0],["ففسر لنا من مات أو من وراءه","وكم ماله أجزا هديت إِلى السار",6,"ر",1,0],["ففسروا ذاك باستقراره وكذا","بالارتفاع وباستعلائه شرفا",7,"ف",2,0]]}