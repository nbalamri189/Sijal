واجتنب","بما لست تدري في الرعاع تأثما",0,"م",2,0],["وَخُذ ما صَفا مِن كُلِّ دَهرٍ فَإِنَّما","غَضارَتُهُ غُنمٌ لَنا وَنِهابُ",1,"ب",1,0],["وَخُذي كَلاماً صُغتُهُ مِن عَسجَدٍ","وَمَعانِياً رَصَّعتُها بِالجَوهَرِ",2,"ر",1,0],["وَخُذي بِكَفِّكِ قَبضَةً","مِمّا وَطِئتِ مِنَ التُرابِ",3,"ب",1,0],["وَخُذْ مِنْ الأَمْرِ بَعْضاً وَاقْتَصِدْ وَأَفِقْ","وانْظُرْ لِنَفْسِكَ فِي جَيْشٍ وَفِي مَالِ",4,"ل",1,0],["وخُذْ يا إمامَ الحقِّ بالحقِّ ثأرَهُ","فَفي ضِمْنِ ما تأتي بهِ العِزُّ والأجْرُ",5,"ر",1,0],["وخُذْ ما بِهِ جادَ الزّمانُ مُسامِحاً","ولا تَتْرُكْ يوْمَ السّرورِ الى غَدِ",6,"د",1,0],["وخُذْها والبلابِلُ في خِصام","ونجْمُ الصُّبْحِ مُلْتَهِبُ الوَقودِ",7,"د",1,0],["وخُذْها على آسِ الرّياضِ ووَرْدِهِ","فهَذا عِذارٌ للرِّياضِ وذا خَدُّ",8,"د",1,0],["وَخُذ بِزِمامِ القَومِ وَاِنزِع بِأَهلِهِ","إِلى المَجدِ وَالعَلياءِ أَكرَمَ مَنزِعِ",9,"ع",1,0],["وَخُذا فِدايَ جُعِلتُ مِن","رَيبِ الزَمانِ فِداكُما",10,"م",2,0],["وخذها عقلة مدح على","بني الشعر رتبتها عاليه",11,"ي",2,0],["وخذ من فؤادك بعض الهوى","لقلب بحبك مستأثر",12,"ر",1,0],["وَخُذ جانِبَ الوادي كَذا عَن يَمينِهِ","بِحَيثُ القَنا يَهتَزُّ مِنهُ طِوالُهُ",13,"ل",2,0],["وَخُذها كَالدَنانيرِ","عَلى رُغمِ الدَنانيرِ",14,"ر",1,0],["وَخُذ جُمَلاً هَذا الثَناءَ فَإِنَّني","لَأَعجَزُ عَن تَفصيلِهِ وَلِيَ العُذرُ",15,"ر",1,0],["وَخُذ عَنِ الكَأسِ نوراً","يُضيءُ مِنهُ الفَسيحُ",16,"ح",1,0],["وخذ النجابة كلها","عن أنجب الآباء طرّا",17,"ر",2,0],["وخذوا سبيل المصلحين وأقبِلوا","روح الزمان هوامد الأجساد",18,"د",1,0],["وَخُذ لَكَ زادَينِ مِن سيرَةٍ","وَمِن عَمَلٍ صالِحٍ يُدَّخَر",19,"ر",1,0],["وَخُذها بِالمَساعي باهِراتِ","تُنافِسُ في جَلالَتِها النُجوما",20,"م",2,0],["وَخُذ لُغَةَ المُعاصِرِ فَهيَ دُنيا","وَلا تَجعَل لِسانَ الأَصلِ نَسيا",20,"ي",2,0],["وَخُذي طَريفَ المَجدِ بَعدَ تَليدِهِ","مِن راحَتَي مَلِكٍ أَغَرَّ هُمامِ",21,"م",1,0],["وَخُذوا مِن وِسادِهِم في المُصَلّى","رُقعَةً كَفِّنوا بِها فَرعَ هاشِم",22,"م",1,0],["وَخُذوا بِناءَ المُلكِ عَن دُستورِكُم","إِنَّ الشِراعَ مُثَقِّفُ المَلّاحِ",23,"ح",1,0],["وَخُذِ النُبوغَ عَنِ الكِنانَةِ إِنَّها","مَهدُ الشُموسِ وَمَسقَطُ الآرادِ",24,"د",1,0],["وَخُذ لِبَنيكَ وَالأَيّامِ ذُخراً","وَأَعطِ اللَهَ حِصَّتَهُ اِحتِسابا",25,"ب",2,0],["وخذ منه السواد تجد ضياء","كجنح الليل حين جلا نهارك",26,"ك",1,0],["وخذ من الزيت العتيق الأولِ","مثلهما في وزنه المعدّلِ",27,"ل",1,0],["وخذ صفوَ دُنياكَ ما أسعفتْ","فإِنَّكَ فيها قليلُ المقامِ",28,"م",1,0],["وَخُذها مُداماً مِن غَزالٍ كَأَنَّهُ","إِذا ما سَقى بَدراً تَحَمَّلَ فَرقَدا",29,"د",2,0],["وَخِذلانُ العَشائِرِ حَيثُ أَمَّت","هَوازِنُ دارَكُم وَهُمُ سِراعُ",30,"ع",1,0],["وَخذُ القِلاصِ يَرُدُّني لَكِ بِالغِنى","في بَعضِ ذا التَطوافِ أَو يُرديني",31,"ن",2,0],["وخذْ لَهَباً حَرُّه في غدٍ","إذا الحَرُّ قارنَ يوماً لَهِيبا",32,"ب",2,0],["وخُذْها كالتهابِ الحَلْيِ تُغْنِي","عن المِصباحِ في اللَّيلِ التِهابا",33,"ب",2,0],["وَخُذ في عَذلِ نَفسِكَ كُلَّ يَومٍ","لَعَلَّ النَفسَ تَقبَلُ مِنكَ عَذلَك",34,"ك",1,0],["وَخُذ لِلمَنايا لا أَبا لَكَ عُدَّةً","فَإِنَّ المَنايا مَن أَتَت لا تُقيلُهُ",35,"ل",2,0],["وَخُذها بِأَوفَرِ أَثمانِها","وَلا تَأسَ مِن غِبطَةِ الكاتِبِ",36,"ب",1,0],["وخُذ الأنوار عنّي ربما","أجدَ الرحمةَ في جوفِ الليالي",37,"ي",1,0],["وخذني حيث هند لا تسلني","لأية غايةٍ ولأيِّ دَرب",38,"ب",1,0],["وخذه من أخرس مرير","من شفه دمعها سجام",39,"م",1,0],["وخُذ ماءً منَ الياقوتِ يَطفو","له دُرَرٌ مُجَوَّفَةٌ صغارُ",40,"ر",1,0],["وخُذْ من فتاة الغيد راحاً سَبِيئةً","لها قدمٌ في السبق من قِدَم العُمرِ",41,"ر",1,0],["وَخُذهُم بِالرُقى إِنَّ المَهاري","يُهَيِّجُها عَلى السَيرِ الحُداءُ",42,"ا",2,0],["وخُذِ السّبيلَ هُدىً ونوراً ساطعاً","إنّ ابن محمودٍ لَنجمٌ ثاقبُ",43,"ب",1,0],["وخُذِ القِلادةَ صاغها لَكَ شاعرٌ","اللهُ أَوْرَثَهُ قَلائدَ تُبَّعِ",44,"ع",1,0],["وَخُذِي العُهودَ على الرِّجالِ فَحسْبُهم","مَا كانَ مِن شَغَبٍ وَطُولِ تَعادِ",45,"د",1,0],["وخُذِي مَعْنَى الأَسَى عَنْهُ فما","لكِ من مَعناه إلا ما نَظمْ",46,"م",1,0],["وَخُذوا عَلى الوِجدانِ كُلَّ ثَنِيَّةٍ","وَاِقضوا الحَياةَ مُزَمّلينَ نِياما",47,"م",2,0],["وَخُذْ من المالِ ما يَقْضِي الدِّياتِ وما","يُرضِي النُّفوسَ ويشفيها من الغَضَبِ",48,"ب",1,0],["وَخُذِ الكتابَ مُباركاً ما مثلُه","كتبتْ يَدٌ فيما يُخَطُّ وَيُرقَمُ",49,"م",1,0],["وَخُذْهَا بُردَةً للشّعْرِ فيها","طَرِيفُ العِزِّ والمجدُ التِّلادُ",50,"د",1,0],["وَخُذِ القُبلةَ التي هِيَ أَقْصَى","ما تُرجِّيهِ أنْفُسُ المتَّقينا",51,"ن",2,0],["وَخُذهم بالنّصائحِ والعظاتِ","مُضيئاتِ المعالمِ مُشرِقاتِ",52,"ت",1,0],["وَخُذْهُ بحقِّه في غيرِ لينِ","لِتنصُرَ في الكريهةِ خيرَ دينِ",52,"ن",1,0],["وخُذُوا النصيحَةَ عن قَميصِي إنّه","لأَجَلُّ من يَعِظُ النّيامَ ويَنصحُ",53,"ح",1,0],["وَخُذها مِن يدَي ظبي غرِيرِ","بِجَفنَيهِ فُتُورٌ وَانكِسَارُ",54,"ر",1,0],["وَخُذ وَهاتِ سُلافاً","مِنَ الشَرابِ رَحيقا",55,"ق",2,0],["وَخُذوا عَفوِيَ ما دُمتُ لَكُم","يَدَ أَخذٍ وَاِلحَقوا بَعضَ وِدادي",56,"د",2,0],["وَخُذوا نَصائِحَ حازِمٍ مُتَعَصِّبٍ","بِالشَيبِ مُجتَمِعِ النُهى مُتَأَسِّدِ",57,"د",1,0],["وَخُذها مِن مُشَعشِعَةٍ كُمَيتٍ","تُنَزِّلُ دِرَّةَ الرَجُلِ الشَحيحِ",58,"ح",1,0],["وَخُذها إِن شَرِبتَ وَميضَ بَرقٍ","بِماءِ المُزنِ مِن نُطَفِ الغُيومِ",59,"م",1,0],["وَخُذ مِن كَفِّ جارِيَةٍ وَصيفٍ","رَخيمَ الدَلِّ مَلثوغَ الكَلامِ",60,"م",1,0],["وخذها قهوةً من كفّ ظبي","رخيم الدل ممشوقِ الشطاطِ",61,"ط",1,0],["وَخُذي مَلابِسَ زينَةٍ","وَمُصَبَّغاتٍ هُنَّ أَنوَر",62,"ر",1,1],["وَخُذ لِنَفسِكَ مِن عُمرٍ تُضَيِّعُهُ","جُزءاً وَلا تُرسِلَنَّ الأَمرَ تَفويضا",63,"ض",2,0],["وخُذْ بقيّةَ ما أبقَيتَ من رمَقٍ","لا خيرَ في الحبّ إن أبقى على المُهجِ",64,"ج",1,0],["وخُذْ من جناحيَّ ما تتَّقي","به في السماء عثارَ القدمْ",65,"م",1,0],["وخُذ رايةَ الحقِّ من قبضةٍ","جلاها الوغى ونَماها الندى",66,"د",2,0],["وخُذي ليومكِ من قديمكِ أُهبةً","ومن الجديد تعِلَّةً ورجاءَ",67,"ا",2,0],["وخذ في ضفافِ النهر مسراك واتَّبعْ","خطى الوحي في تلك الحقول النواضرِ",68,"ر",1,0],["وخذه من محقق أمين","وميز الغث من الثمين",69,"ن",1,0],["وخُذَا لِمُرْتَبَع الحِسانِ فرُبَّمَا","شَفَعَ الشَّبَابُ فصْرتُ مِن أَخدانِهَا",70,"ن",3,0],["وَخُذي مِن جَماجِمِ القَومِ قوتاً","لِبَنيكِ الصِغارِ وَالأَشبالِ",71,"ل",1,0],["وَخُذُوا الضَّمِيرَ فَكَفِّنُو","ه بِالكَرِيمِ مِنَ الشِّيَمْ",72,"م",1,0],["وَخُذ بِيَدي وَاِضرَع لِرَبِّكَ شافِعاً"