{"poems":[[93,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[88,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[85,"إلى حسين حاكم القنال","https://www.aldiwan.net/poem63688.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42651","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54705","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[212,"يا نجوم الفنون والدهر ليل","https://www.aldiwan.net/poem46602.html","الخفيف"],[343,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[507,"يا من حواه الدين في عصره","https://www.aldiwan.net/poem2447.html","السريع"],[539,"ترسل النكتة اللطيفة سهما","https://www.aldiwan.net/poem48158.html","عموديه"],[539,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"]],"verses":[["تَرَسُّلُ هَيْكَلٍ مَاءٌ مُصَفَّى","حَبَتْهُ بِسِرِّهَا بِنْتُ الكُرُومِ",0,"م",1,0],["ترسل الموت في قنابلها كالشُهْ","ب ذريعاً مستأصلاً عِتْريسا",1,"س",2,0],["تُرسِلُ السُحبَ فَتسقي أَرضَنا وَالشَجَرا","وَقَد أَكَلناك وَقُلنا قَد أَكَلنا الثَمَرا",2,"ر",2,0],["تُرسِلُها مُؤَمِّناً عَلَيها","إِن هَلَكَت لِيَ الحَقُّ في مِثلَيها",3,"ه",2,0],["ترسل الشمس في الغدوّ شعاعاً","فيرد الشعاع منها الأصيل",4,"ل",1,0],["تَرَسَّمْ فَضَاءَ الأَرْضِ شَرْقَاً وَمَغْرِبَاً","عَسَاكَ تَرَى آثَارَ كِسْرَى وَقَيْصَرِ",5,"ر",1,0],["تَرَسَّمْتِ فِي الْكَمَالِ رَسْماً","جَرَتْ عَلَيْهِ بِلاَ مُحِيدِ",6,"د",1,0],["تُرْسِلُ الأَمْثَالَ تَسْرِي شُرَّداً","لا تُبَالي أَيْنَما كانَ سُرَاها",7,"ا",3,0],["ترسَّلَ لم يَرْتَبِكْ خَطوُهُ","عناءً ولا نال منه البَهَر",8,"ر",1,0],["ترسل النور كالحقيقة صرفاً","لتبيد الظنون بعد الظنون",9,"ن",1,0],["ترسل الطرف في السماوات حيناً","ثم نحو الارضين اخذاً وردا",10,"د",2,0],["ترسمها أنمله مثل ما","نمّق زهر الروض كفُّ العهاد",11,"د",1,0],["تُرسِلُ النكتةَ اللَّطيفةَ سَهماً","والمُصابونَ في الحُضورِ كَثيرُ",12,"ر",1,1],["تَرسَّمَ منه الخطوَ يَقفوه سائِراً","على نهجِه أكرِم به من مَسيرِ",13,"ر",1,0]]}