ps://www.poetsgate.com/ViewPoem.aspx?id=208776",""],[5879,"من لي بها ..","https://www.poetsgate.com/ViewPoem.aspx?id=215464",""],[5939,"ظامئٌ لارتشافِكِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=178620",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""]],"verses":[["تَرَسُّلُ هَيْكَلٍ مَاءٌ مُصَفَّى","حَبَتْهُ بِسِرِّهَا بِنْتُ الكُرُومِ",0,"م",1,0],["ترسل الموت في قنابلها كالشُهْ","ب ذريعاً مستأصلاً عِتْريسا",1,"س",2,0],["تُرسِلُ السُحبَ فَتسقي أَرضَنا وَالشَجَرا","وَقَد أَكَلناك وَقُلنا قَد أَكَلنا الثَمَرا",2,"ر",2,0],["تُرسِلُها مُؤَمِّناً عَلَيها","إِن هَلَكَت لِيَ الحَقُّ في مِثلَيها",3,"ه",2,0],["ترسل الشمس في الغدوّ شعاعاً","فيرد الشعاع منها الأصيل",4,"ل",1,0],["تَرَسَّمْ فَضَاءَ الأَرْضِ شَرْقَاً وَمَغْرِبَاً","عَسَاكَ تَرَى آثَارَ كِسْرَى وَقَيْصَرِ",5,"ر",1,0],["تَرَسَّمْتِ فِي الْكَمَالِ رَسْماً","جَرَتْ عَلَيْهِ بِلاَ مُحِيدِ",6,"د",1,0],["تُرْسِلُ الأَمْثَالَ تَسْرِي شُرَّداً","لا تُبَالي أَيْنَما كانَ سُرَاها",7,"ا",3,0],["ترسَّلَ لم يَرْتَبِكْ خَطوُهُ","عناءً ولا نال منه البَهَر",8,"ر",1,0],["ترسل النور كالحقيقة صرفاً","لتبيد الظنون بعد الظنون",9,"ن",1,0],["ترسل الطرف في السماوات حيناً","ثم نحو الارضين اخذاً وردا",10,"د",2,0],["ترسمها أنمله مثل ما","نمّق زهر الروض كفُّ العهاد",11,"د",1,0],["تُرسِلُ النكتةَ اللَّطيفةَ سَهماً","والمُصابونَ في الحُضورِ كَثيرُ",12,"ر",1,1],["تَرسَّمَ منه الخطوَ يَقفوه سائِراً","على نهجِه أكرِم به من مَسيرِ",13,"ر",1,0],["تُرسِلُ الكَهرَباءَ فيها شُعاعاً","وَيَرى لِلبُخارِ فيها رِكامِ",14,"م",1,0],["تِرسٌ عَظيمٌ مِنَ الأَلماسِ دائِرة","مُلقىً يَعومُ وَيَطفو فَوقَ بَحرِ دَمِ",15,"م",1,0],["ترسمت بعد المستقلين أربعا","فأسقيتها من وابل العين أدمعا",16,"ع",2,1],["ترسل النورَ من وراء حِجاب","شفَّ عن خاطر يريد النّورا",17,"ر",2,0],["ترسَّلوا آلَ عبادٍ فربَّتما","لم يُدرِكِ الوصفُ ما تأتون والمثل",18,"ل",1,0],["ترسي الخطا وَنواحيها تجاذبها","يمنى وَيُسرى وَتقديم وَتأَخير",19,"ر",1,0],["ترسلُ النورَ من بعيدٍ مداها","بشُعاعٍ يفيضُ في الأكوانِ",20,"ن",1,0],["ترسم خليلي هل ترى رسم مربع","بجانب تجراج فقلب ابن الأقرع",21,"ع",1,1],["ترسَّمتُ رسماً باللّوى للأولى خَلو","به من أحبائي وأهل وداديا",22,"ي",2,0],["ترس مَليح أَخي مثاقفة","يَديره في الدُجى إِدارات",23,"ت",1,0],["ترسل اللحن في الفضاء وتصغي","لصداه يسري بعيد الرنين",24,"ن",1,0],["ترسل الصوت عالياً نبراتٍ","ينحدرْن انحدار ماء العيون",25,"ن",1,0],["ترسل الشعر منطقا عربيا","بيِّنَ الآي واضح التبيان",26,"ن",1,0],["ترسم الأنغام ان رجّعها","صورا تعجز أيدي الراسمين",27,"ن",1,0],["ترسل السهم ويلقى مثله","ليس بالكرار أن لم يلق ندا",28,"د",2,0],["ترسل الدمع على الخد دما","والأسى في رأسها يرتطم",29,"م",1,0],["تُرسِلُها الريح العَقي","مُ مِن سَماء الغَضَبِ",30,"ب",1,0],["ترسلين النور يهد","يني إلى سبل العلاء",31,"ا",2,0],["ترس النحاس مموهاً من فضة","وتكشف التمويه عن أطرافه",32,"ه",1,0],["تُرسِلُ الطَرفَ نَحوَهُ فَيُلاقي","حَجنَةَ المَوتِ فَوقَهُ فَيَؤوبُ",33,"ب",1,0],["تُرسِلُ مِن شُعورِها أَفاعِيا","تَنهَشُ قَلبَ الصَب وَهيَ ماهِيا",34,"ي",2,0],["ترسو البواخر كي تفرغ شحنها","بسهولة ولراحة ابن السبيل",35,"ل",1,0],["ترسم هدفها على الليزر وترسل له","اشارة الضبط والمضرب تهيا له",36,"ل",2,0],["ترسل الدمع مخبراً عن عزيز","أسهم الموت نفسه قد أصابت",37,"ت",1,0],["ترسم لي اليمنى نهر تزرع لي اليسرى نخيل","تبحر بنظراتي شمال دور الحكيم تمارسه .",38,"س",2,0],["ترسي لفلو شرعها والغدرا","تتكسر ارياح نوتك دونك",39,"ك",1,0],["ترسو بشطك كي ترتاح من سفر","قضيتَ من عمُر وانساب في قصر",40,"ر",1,0],["ترسم ملامح من صور نوب / ويذوب","قلب (ن) حداه الضيق ويقول راحت",41,"ت",1,0],["ترسُو سَفينةُ فكْري حيثُ عَنَّ لها","وراءَ بحرِ المُنى عشب يَشِي الأكُما",42,"م",2,0],["ترسللي أنواع الشقى عشر موجات","واللي تبثللي الفرح نسقتها",43,"ت",3,0],["ترسل النظرة نصلا قاطعا","يقطع الأحشاء قبل العضل",44,"ل",1,0],["ترسو بشاطئ مقلتيكَ على الظما","من بعدما اغتسلتْ بكَ الصّحراء ُ",45,"ا",2,0],["ترسانةُ العُربِ قد صارت مدافُعها","في قمةِ الحربِ أشعاراً وأوزانا",46,"ن",2,0],["ترسم وطن باقي على غربة اوطان","جفّت عروقه لين شاخت سنينه",47,"ن",2,0],["ترسّمنا خطاكَ على طريق ٍ","فدائيٍّ فكنتَ لنا اعتبارا",48,"ر",2,0],["ترسي لمرسي والدلايل علامه","ولازحزح الباطل ولاهز الاهرام",49,"م",1,0],["ترَسَّخَ الحُكْمُ في ميراثِهمْ لَزَباً","فليْسَ يجْدُرُ كرْسِيٌّ بمُنْتَخَبِ !",50,"ب",1,0],["تَرْسُمُ الشَّمْسُ للمَكَانِ جَمَالاً","‏ فَاقَ فُي الوَصْفِ مَا يَجُوْدُ البَيَانُ",51,"ن",1,1],["ترْسو عَلى سَفَرٍ ضاعَتْ حَقائِبُهُ","فَالحُزْنُ يَقْرَؤها، والقَلْبُ يَكْتُبُهُ",52,"ب",2,1],["ترْسو عَلى سَفَرٍ ضاعَتْ حَقائِبُهُ","فالحُزْنُ يَسْمَعُها، والقَلْبُ يَكْتُبُهُ",53,"ب",2,1],["ترسو على الباسِقاتِ السُّمْرِ قافيةٌ","تُعَمِّدُ الحَرْفَ بالأشواقِ والوَرَقا",54,"ق",2,0],["ترسو على مرفئ الأشواق ذكراها","فينكأ الوعدُ جرحا كاد ينساها",55,"ا",3,1],["تَرسمُ الدربَ لَهفةُ خَطْوي","ألهميني، فعِشقُكُ مَبدأْ",56,"ا",1,0],["تَرْسُمُ الدَّرْبَ سُلَّمَا","أَنْتَ يَا بَاسِطَ المُنَى",57,"ا",1,0]]}