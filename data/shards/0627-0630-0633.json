{"poems":[[9,"شريح لا تتركني بعدما علقت","https://www.aldiwan.net/poem21933.html","البسيط"],[90,"أيها الأنجم التي قد رأينا","https://www.aldiwan.net/poem45031.html","الخفيف"],[53,"من رأى مثل خالد فضل حلم","https://www.aldiwan.net/poem66745.html","الخفيف"],[33,"فجعتنا أم بشر","https://www.aldiwan.net/poem41858.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[211,"يا أيها الرجل الذي تهوي به","https://www.aldiwan.net/poem27944.html","الكامل"],[242,"شرذمة مأبونه","https://www.aldiwan.net/poem19102.html","مجزوء الرجز"],[287,"إني إذا لاح البريق يماني","https://www.aldiwan.net/poem32383.html","الكامل"],[422,"الدين أصبح منصورا بتأييد","https://www.aldiwan.net/poem54113.html","البسيط"],[430,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[543,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[591,"لا خلت من سناكم الأحياء","https://www.aldiwan.net/poem17398.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138384",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83291","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77658","الرجز"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99986","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96368","الرجز"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128276","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112814","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79965","الكامل"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100446","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110613","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67256","الرمل"],[2731,"","https://poetry.dctabudhabi.ae/diwan/poem/102022","الرمل"],[3149,"","https://poetry.dctabudhabi.ae/diwan/poem/198917",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114443","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86353","الرمل"],[4446,"","https://poetry.dctabudhabi.ae/diwan/poem/139091","المتقارب"],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5183,"الِّلثَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=186447",""],[5183,"عسعس الليل","https://www.poetsgate.com/ViewPoem.aspx?id=186373",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5343,"عجزت عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=132536",""],[5674,"امي ... افتقدتك بشدة","https://www.poetsgate.com/ViewPoem.aspx?id=186941",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[5720,"الْهِنْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=205305",""],[6127,"طلائع الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=198788",""]],"verses":[["إِذ سامَهُ خُطَّتي خَسفٍ فَقالَ لَهُ","مَهما تَقُلهُ فَإِنّي سامِعٌ حارِ",0,"ر",1,0],["إذ سكنّا وفي القلوب ارتجاج","مثل تيّار لجّة القاموس",1,"س",1,0],["إذ سحا نفسَه بماءٍ مَسوس","ولظى النار بين جاعِرَتَيْهِ",2,"ي",2,0],["إِذ سَمِعنا مِن مُنادٍ","أَن تَهَيَّوا لِاِرتِحالِ",3,"ل",1,0],["إذ سقطت صاعقة","في بَيت جاري الأشفع",4,"ع",1,0],["إِذ سالَ مِن أَفناءِ بُهثَةَ كُلِّها","جَمعٌ تَظَلُّ بِهِ المَخارِمِ تَرجُسُ",5,"س",1,0],["إذْ سُرْبِلُوا بِالْعِزِّ وَال","وَقَارِ وَاللُّدُونَهْ",6,"ن",2,0],["إِذ ساعَدتُ سُعدى وَسَلمى سَلَّمَت","وَسُرِرتُ مِن حَسناءَ بِالإِحسانِ",7,"ن",1,0],["إذ سلَّ من مرهفات الله بيض ظبا","فشيَّد الدِّين فيها أي تشييد",8,"د",1,0],["إذْ ساوَرَ الإسْلامَ سُقْمٌ قاتِلٌ","لَوْ لَمْ يُدارِكْ سُقْمَهُ بِشِفاءِ",9,"ا",2,0],["إذ ساقَهُم سَوقَ السَّوائِمِ حيثُ حا","قَ بهم وحاقَ به أذىً وثُبورُ",10,"ر",1,0],["إذ سَرتْ مِنْ دِيارِهِمْ نَسماتٌ","بَسماتٌ في إثْرها إرْضاءُ",11,"ا",2,0],["اذ سألوك عن شهم كريم","وديع فاضل سمح حليم",12,"م",1,1],["إِذ سَيفٌ رَأيُكَ في الحَوادِثِ فَيصَلُ","وَنَدى يَمينُكَ ديمَةً مِدرارُ",13,"ر",1,0],["إِذ ساقَهُ السائِقُ رَغماً فَعَصى","فَمالَ فَوقَ إِليَتيهِ بِالعَصا",14,"ص",2,0],["إذْ سَيْفُ عَزْمِكَ كَامِنٌ في جَفْنهِ","أَرْجُو انْتضاكَ لَهُ وَلَمَّا يُنْتَضى",15,"ض",2,0],["إِذ سابَق الصّنعة حسنُ المَعنى","ثُمّ يُراعى بَعد ذاكَ المَبنى",16,"ن",2,0],["إذ سَوفَ تَلقَينَ جَواداً حُرّا","سَيّدَ قيسٍ زُفَرَ الأغرّا",17,"ر",2,0],["اذ سد بالوحي كل باب إلى ال","مسجد من صحبه وعترته",18,"ت",2,0],["إذ سبقت النجوم في فلق الصبح","فرد الصدى علي كلامي",19,"م",2,0],["إذ سترت العيوب فضلا ومنا","وبذلت الجدا وجملت سيره",20,"ر",2,0],["إِذ سَلمت سَلمى القياد وَمَهَدَت","هِند المَحبة لي أَعَز مِهادِ",21,"د",1,0],["إذ سار مقتعداً براق عزيمة","قد قرّبت من كل أفقٍ بعده",22,"د",2,0],["إذ سددت نحوي من الأبيض","كلمة كانت جوابا تقتضي",23,"ي",1,0],["إذ سعى أيده اللَه به","عند سلطان رحيب العرصات",24,"ت",1,0],["إذ سرى يطوي أديم البلقع","واصل التأويب وخداً بالسرى",25,"ر",2,0],["إذ سقتها مُقلتي من درِّها","فهي من بهجتها جوُّ السما",26,"م",2,0],["إذ سطا فاغتال منا أسداً","يرهب الأسد إذا صال وشدا",27,"د",2,0],["إذ سفر الموت في شحط","والقرب منه هو البعاد",28,"د",1,0],["اذ سَنَّ باريها لها عن لازمٍ","لُبسَ السَوادِ بسُنَّةٍ تستلزمُ",29,"م",1,0],["اذ سايَرَ الأَبرارَ في فَلَكِ العَلا","متمتّعين بمنظر الرَحمانِ",30,"ن",1,0],["إذ سار صالح مع المسوده","إلى خراسان بجند جنده",31,"ه",1,0],["إذ ساندتها أعينٌ لتوسمٍ","ما كان أحسنَ ذا السنادِ لو ائتمن",32,"ن",1,0],["إذ سعى يرتاح فيها معجلا","عاثراً بالريط ريط الرفرف",33,"ف",1,0],["إذ سقاني ما أطيبا","خمرة الريق بكأسٍ ألعس",34,"س",1,0],["إذ سُئل العرفَ","ليثبتَ دعواه في تغلبِ",35,"ب",1,0],["إِذْ سَقَانِي مِلْءَ نَفْسِي","رِعْشَةَ الأَوْرَاقِ قَطْرَا",36,"ر",2,0],["إذ سرى باللوح في أفق الهدى","ممتطيا منه سنام اليعملات",37,"ت",1,0],["إذ سرت في ظلامها تحت عدو","كاد لو لا جيش الدجى يغشاها",38,"ا",3,0],["إذ سرت نغمة من الأدب ال","غض عليها من الغوالي طيوب",39,"ب",1,0],["إذ ساسنا بالهدى والرفق يغمرنا","حرصاً علينا فلم نرتب ولم نهم",40,"م",1,0],["إِذْ سِحْرُ تَمْنَحُكَ الحَيَاةَ وَغَيْرُهَا","يَسْعَى لِقَتْلِكَ لا يَكِلُّ، مُشَمِّرَا",41,"ر",2,0],["إذْ سافرٓ الفكرُ يا أماهُ ترهقهُ","أطيافُ حزنٍ بها الأحلامُ ترتجفُ",42,"ف",1,0],["إذْ سَخَّروا الشَّهَواتِ مُلْتَجَأً","يَهْوي إليْهِ الغِرُّ خَلّابا",43,"ب",2,0],["إذ سَحَّ ذاكَ الماءَ بينَ جموعهِ","فانهالَ سكباً حينَ أغدقَ ماطِرا",44,"ر",2,0],["إذْ سلّطَ الحوَّلَ اللّاهينَ في وطنٍ","مازالَ من جُرحِهِ يشكو وما فرغا",45,"غ",2,0]]}