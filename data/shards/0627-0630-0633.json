{"poems":[[9,"شريح لا تتركني بعدما علقت","https://www.aldiwan.net/poem21933.html","البسيط"],[88,"أيها الأنجم التي قد رأينا","https://www.aldiwan.net/poem45031.html","الخفيف"],[51,"من رأى مثل خالد فضل حلم","https://www.aldiwan.net/poem66745.html","الخفيف"],[31,"فجعتنا أم بشر","https://www.aldiwan.net/poem41858.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[208,"يا أيها الرجل الذي تهوي به","https://www.aldiwan.net/poem27944.html","الكامل"],[238,"شرذمة مأبونه","https://www.aldiwan.net/poem19102.html","مجزوء الرجز"],[283,"إني إذا لاح البريق يماني","https://www.aldiwan.net/poem32383.html","الكامل"],[417,"الدين أصبح منصورا بتأييد","https://www.aldiwan.net/poem54113.html","البسيط"],[425,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[539,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[587,"لا خلت من سناكم الأحياء","https://www.aldiwan.net/poem17398.html","الخفيف"]],"verses":[["إِذ سامَهُ خُطَّتي خَسفٍ فَقالَ لَهُ","مَهما تَقُلهُ فَإِنّي سامِعٌ حارِ",0,"ر",1,0],["إذ سكنّا وفي القلوب ارتجاج","مثل تيّار لجّة القاموس",1,"س",1,0],["إذ سحا نفسَه بماءٍ مَسوس","ولظى النار بين جاعِرَتَيْهِ",2,"ي",2,0],["إِذ سَمِعنا مِن مُنادٍ","أَن تَهَيَّوا لِاِرتِحالِ",3,"ل",1,0],["إذ سقطت صاعقة","في بَيت جاري الأشفع",4,"ع",1,0],["إِذ سالَ مِن أَفناءِ بُهثَةَ كُلِّها","جَمعٌ تَظَلُّ بِهِ المَخارِمِ تَرجُسُ",5,"س",1,0],["إذْ سُرْبِلُوا بِالْعِزِّ وَال","وَقَارِ وَاللُّدُونَهْ",6,"ن",2,0],["إِذ ساعَدتُ سُعدى وَسَلمى سَلَّمَت","وَسُرِرتُ مِن حَسناءَ بِالإِحسانِ",7,"ن",1,0],["إذ سلَّ من مرهفات الله بيض ظبا","فشيَّد الدِّين فيها أي تشييد",8,"د",1,0],["إذْ ساوَرَ الإسْلامَ سُقْمٌ قاتِلٌ","لَوْ لَمْ يُدارِكْ سُقْمَهُ بِشِفاءِ",9,"ا",2,0],["إذ ساقَهُم سَوقَ السَّوائِمِ حيثُ حا","قَ بهم وحاقَ به أذىً وثُبورُ",10,"ر",1,0],["إذ سَرتْ مِنْ دِيارِهِمْ نَسماتٌ","بَسماتٌ في إثْرها إرْضاءُ",11,"ا",2,0]]}