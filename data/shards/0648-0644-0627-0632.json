,"الطويل"],[51,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"أبا العباسِ عمرت","https://www.aldiwan.net/poem66081.html","الهزج"],[51,"تظلّم شِعري إلى القاسمِ","https://www.aldiwan.net/poem66302.html","المتقارب"],[70,"عليك سلام الله يا قبر عثمان","https://www.aldiwan.net/poem42450.html","الخفيف"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[70,"نهاك عن الغواية ما نهاكا","https://www.aldiwan.net/poem42781.html","الوافر"],[78,"إذا كان أردى الزمان بمثله","https://www.aldiwan.net/poem14161.html","الطويل"],[32,"أتاني عن مروان بالغيب أنه","https://www.aldiwan.net/poem27812.html","الطويل"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[89,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[43,"لكل امرئ من دهره ما تعودا","https://www.aldiwan.net/poem9529.html","الطويل"],[43,"أيا راميا يصمي فؤاد مرامه","https://www.aldiwan.net/poem10526.html","الطويل"],[62,"خليلي لا راع الفراق حشاكما","https://www.aldiwan.net/poem52272.html","الطويل"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[62,"أهنئ مولانا بأيمن قادم","https://www.aldiwan.net/poem52431.html","الطويل"],[45,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[45,"مثالك من طيف الخيال المعاود","https://www.aldiwan.net/poem63474.html","الطويل"],[45,"إذا عرضت أحداج سلمى فنادها","https://www.aldiwan.net/poem63485.html","الطويل"],[45,"وصلنا إلى التوديع غير مودع","https://www.aldiwan.net/poem65138.html","الطويل"],[45,"سقى ربعها سح السحاب وهاطله","https://www.aldiwan.net/poem65565.html","الطويل"],[28,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[61,"أعاد الله عيدك بالسرور","https://www.aldiwan.net/poem51647.html","الوافر"],[49,"ولا زوردية تزهو بزرقتها","https://www.aldiwan.net/poem64135.html","البسيط"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[87,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[33,"ألا يا غرابا صاح من نحو أرضها","https://www.aldiwan.net/poem25778.html","الطويل"],[33,"ألا يا غراب البين لونك شاحب","https://www.aldiwan.net/poem25925.html","الطويل"],[33,"ألا يا غراب البين هيجت لوعتي","https://www.aldiwan.net/poem25969.html","الطويل"],[33,"أبوس تراب رجلك يا لويلي","https://www.aldiwan.net/poem25985.html","الوافر"],[33,"ألا لا أرى وادي المياه يثيب","https://www.aldiwan.net/poem26018.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[81,"ولازورد باهر نوره","https://www.aldiwan.net/poem61475.html","السريع"],[48,"أيا ليل لا انقضيت","https://www.aldiwan.net/poem62473.html","المضارع"],[48,"نعزي أمير المؤمنين محمدا","https://www.aldiwan.net/poem63356.html","الطويل"],[7,"دعاك الهوى واستجهلتك المنازل","https://www.aldiwan.net/poem1979.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39674","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42660","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42729","الطويل"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10397","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23993","الطويل"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10257","الوافر"],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[77,"أنا ملعب الوصل الذي يشرح الصدرا","https://www.poetsgate.com/ViewPoem.aspx?id=34126",""],[77,"بحيث القباب البيض والأسل السمر","https://www.poetsgate.com/ViewPoem.aspx?id=34138",""],[33,"ألا يا غراب البين هيجت لوعتي","https://www.poetsgate.com/ViewPoem.aspx?id=2609",""],[45,"إذا عَرَضَتْ أحْدَاجُ سلمى، فنادِها","https://www.poetsgate.com/ViewPoem.aspx?id=31564",""]],"verses":[["وَلازالَ جَوُّكِ في ناضِرٍ","مِنَ النورِ يَحمَدُهُ الرائِدانِ",0,"ن",1,0],["وَلازَمَ ثَوبَيكَ صِبغُ العُلى","كَما لَزِمَت صِبغَةُ الزِبرِقانِ",0,"ن",1,0],["وَلا زالَتِ الأَعيادُ هَطلى رَخيَّةً","يُحَيِّيكَ مِنها زائِرٌ وَنَزيلُ",1,"ل",1,0],["وَلا زالَ مِن آمالِنا وَرَجائِنا","عَلَيكَ وَإِن ساءَ العَدوَّ عِيالُ",2,"ل",1,0],["وَلا زالَتِ الأَنواءُ تَحبوهُ مُرعِداً","مِنَ المُزنِ مَلآنَ الحَيازيمِ مُبرِقا",3,"ق",2,0],["وَلا زالَ دَهرُكَ طَوعَ الجَنيبِ","إِذا ما أَمَرتَ بِأَمرٍ أَطاعا",4,"ع",2,0],["وَلا زالَت رِماحُكَ مُطلَقاتٍ","تُرَدِّدُها إِلى الأَجَلِ الأَسيرِ",5,"ر",1,0],["وَلا زالَتِ الأَسيافُ تَسبي حَريمَهُم","وَتَسبي حَريمَ المالِ مِنكَ القَصائِدُ",6,"د",1,0],["وَلا زادَ يَومُ البَينِ إِلّا صَبابَةً","فَلا الشَوقُ مَنسِيٌّ وَلا الدَمعُ ناضِبُ",7,"ب",1,0],["وَلا زالَ خَفّاقُ النَسيمِ مُرَقرِقاً","عَليكِ وَأَنواءُ الغَمامِ تَصوبُ",8,"ب",1,0],["وَلا زالَ عَن ذاكَ الضَريحِ مُنَوِّرٌ","مِنَ الرَوضِ تَفليهِ الصَبا وَالجَنائِبُ",9,"ب",1,0],["وَلا زالَ يَسقي شِربَهُ مِن مَدامِعي","شآبيبَ تَحكي اللؤلؤَ المُتَبَدِّدا",10,"د",2,0],["وَلا زالَ فيها الظِّلُّ أَلْمَى تَلَفَّتتْ","إليهِ صَباً تَعتادُهُ بالأَصائِلِ",11,"ل",1,0],["ولازالتِ الأمْلاكُ تأتيكَ خُضَّعاً","ولازِلْتَ بالإحْسانِ والعَفْوِ تكْلَفُ",12,"ف",1,0],["ولازالَ نَصْريَّ العُلا رائِقَ الحُلَى","يُصاحِبُ جيشَ النّصْرِ رايَتُهُ الحَمْرا",13,"ر",2,0],["ولازِلْت أفْقاً للقِبابِ ومَطْلَعا","يُريكَ البُدورَ الغُرَّ والأنْجُمَ الزُّهْرا",13,"ر",2,0],["ولا زِلْتَ في مُلْكٍ مَنيعٍ مؤيَّدٍ","تهَشُّ لهُ الدُّنْيا ويعْنو لهُ الدّهْرُ",14,"ر",1,0],["ولازالَ ظِلُّ البانِ فيكِ منَعَّماً","يَميسُ منَ الأوْراقِ في حُلَلٍ خُضْرِ",15,"ر",1,0],["ولازِلْتَ قُطْباً تَسْتَديرُ بهِ العُلى","كما دارَتِ الأفْلاكُ حوْلَ المُحَدَّدِ",16,"د",1,0],["ولازِلْتَ تجْني كلّما اشْتَجرَ الوَغى","جنَى النّصْرِ منْ غرْسِ القَنا المُتقصِّدِ",16,"د",1,0],["ولازِلْتَ تَلْقى السّهْلَ والرّحْبَ حيثُما","أرَحْتَ السُّرَى منْ كُلِّ غادٍ ورائِحِ",17,"ح",1,0],["وَلاَ زِلْتَ تَجْنِي النَّصْرَ مِنْ شِجَر الْقَنَا","وَتُدْنِي الأَمَانِي وَهْيَ شُمسٌ مَصَاعِب",18,"ب",1,0],["وَلا زِلتَ في دَستِ الجَلالِ مُؤَيَّداً","وَلا زالَ هَذا المُلكُ في هَذِهِ الدارِ",19,"ر",1,0],["وَلازَمتُهُ عامَينِ عاماً مُسَلَّماً","إِلى البابِ أَحياناً وَعاماً أُواظِبُه",20,"ب",2,0],["وَلازَمَها سَعدُ السُعودِ وَصَحبُهُ","إِلى أَن تَلاقى الضَبُّ وَالنونُ في وَكرِ",21,"ر",1,0],["وَلا زالَ مِنّا بِالضُحى وَالأَصائِلِ","سَلامٌ عَلى تِلكَ المَيادينِ يُقرَأُ",22,"ر",2,0],["وَلا زالَ مِنكُم لابِسٌ مِن ظِلالِها","يُسَوِّغُ أَبكارَ المُنى وَيُهَنَّأُ",22,"ن",2,0],["وَلازالَ نورٌ في الرَصافَةِ ضاحِكٌ","بِأَرجائِها يَبكي عَلَيهِ غَمامُ",23,"م",1,0],["وَلا زالَت نِبالُ الدَهرِ تُصمي","عُداتَكَ أَيُّها المَلِكُ النَبيلُ",24,"ل",1,0],["وَلا زِلتَ مَوفورَ العَديدِ بِقُرَّةٍ","لِعَينَيكَ مَشدوداً بِهِم ذَلِكَ الأَزرُ",25,"ر",1,0],["وَلا زِلتَ مَوفورَ العَديدِ بِقُرَّةٍ","لِعَينَيكَ مَشدودٍ بِهِم ذَلِكَ الأَزرُ",26,"ر",1,0],["وَلازَمَهَا كَالظِّلِّ غَيْرَ مُفَارِقٍ","مَشُوقاً عَلَى كَرِّ اللَّيَالِي مُتَيَّمَا",27,"م",2,0],["وَلا زالَ مَسنوّا تُرابُكَ تَستَقي","عَزاليَ بَرّاقِ العَوارِضِ مُرزِمِ",28,"م",1,0],["وَلا زالَ نَوءُ الدَلوِ يَبعَقُ وَدقُهُ","بِكُنَّ وَمِن نَوءِ السِماكِ غَمامُ",29,"م",1,0],["وَلا زِلتُما في حَبرَةٍ ما بَقيتُما","وَصاحَبتُما يَومَ الحِسابِ مُحَمَّدا",30,"د",2,0],["وَلا زالَ مِن نَوءِ السِماكِ عَلَيكُما","وَنَوءِ الثُريّا وَابِلٌ مُتَبَطِّحُ",31,"ح",1,0],["ولا زلتُ في الأعياد ساجعَ روضها","إذا احتفلت أشرافُها أترنّمُ",32,"م",1,0],["وَلا زادَني عَنهُ غِنائي تَباعُد","وَإِن كانَ ذا نَقصٍ مِنَ المالِ مُصرِما",33,"م",2,0],["ولا زلتَ بالأقلامِ والحلمِ زائداً","تظلّ بها عن حوزة الدين ذائدا",34,"د",2,0],["ولا زلت للجامع المجتبى","تفتح للخير باب الزياده",35,"د",2,0],["ولا زلتَ مسروراً بنشرِ محامدٍ","وذخر أجورٍ واتصالِ عواف",36,"ف",1,0],["ولا زالت هباتك بالضحايا","وبالأشغال قائمة برسمِي",37,"ي",1,0],["ولا زالَ عقد المزْن درًّا بداركم","يفصله من قادح الشوق مرجان",38,"ن",1,0],["ولا زلتُمُ يأوي إلى حُجُراتكم","أخو حادثٍ أنحَى وذو زمن أخْنَى",39,"ن",2,0],["ولا زال مسرحُ غِزْلانكُنَّ","مَريعَ المَحلَّةِ والمُنْتأَى",40,"ا",1,0],["ولازال للأَعداء في كلِّ حالةٍ","وللمالِ يومٌ من يديك عصيبُ",41,"ب",1,0],["ولازَوَرْدِيَّةٍ تزهُو بزُرْقَتِهَا","وسطَ الرياض على حُمْرِ اليواقيتِ",42,"ت",1,0],["ولا زال قَصرُ القُفْصِ أعمرَ مَنزلٍ","به وبدهرٍ صالح لا يُماغثُهْ",43,"ث",2,0],["ولا زلت محفوظاً بحفظك عهدَ من","تود إذا مال الخليل إلى الغدرِ",44,"ر",1,0],["ولا زلتَ سبّاقاً إلى كلِّ غايةٍ","من الجود والإفضال سبقَ المبرز",45,"ز",1,0],["ولا زلتَ في يوم ترنُّ قيانه","فكم لك من يوم أرنت معاجِسه",46,"س",2,0],["ولا زلتَ في الأعمار خالفَ معشرٍ","وسابقهم في كلّ مكرمةٍ ركْضا",47,"ض",2,0],["ولا زال سعدك مستصحباً","مساعدة القدر الواقع",48,"ع",1,0],["ولا زلتَ جارَ المجد في رأس هضبةٍ","تفوتُ الردى ما حَلَّت الهضبَ أوعالُ",49,"ل",1,0],["ولا زلتَ ممدوحاً لمطريك مَصْدَقٌ","إذا كان للمطرينَ في الناس مَزْعَمُ",50,"م",1,0],["ولا زلتَ من الخيرا","تِ طُرّاً وافرَ القسمِ",51,"م",1,0],["ولا زال غيثاً على سائلٍ","مُحِقٍّ وغيظاً على ناقمِ",52,"م",1,0],["وَلازالَ مُنهَلّاً عَلى تُربِكَ الحَيا","يُغاديكَ مِنهُ كُلُّ أَوطَفَ هَتّانِ",53,"ن",1,0],["وَلا زالَتِ الأَعوامُ تَأتي وَتَنقَضي","فَتَبدَؤُها بِالصالِحاتِ وَتَختِمُ",54,"م",1,0],["وَلا زالَ السَلامُ عَلَيكَ مِنّي","يَرُفُ مَعَ النَسيمِ عَلى ذُراكا",55,"ك",2,0],["وَلا زالَ ملذوعاً عَلى سَيِّد حشا","ولا انفكّ مَلطوماً عَلى مِلكٍ خَدُّ",56,"د",1,0],["وَلا زادَني الواشونَ إِلّا صَبابَةً","وَلا كَثرَةُ الواشينَ إِلّا تَمادِيا",57,"ي",2,0],["ولازم حمى الدق ناعم جسمها","فأمست على رغم الشبيبة تنحل",58,"ل",1,0],["ولازَمهُ من الآلام داءٌ","وأصبح داؤُه داءً عضالا",59,"ل",2,0],["ولا زالت على مرِّ الليالي","نجومك يستضئ بها الفضاءُ",60,"ا",2,0],["وَلا زالَتِ الأَعيادُ لُبسَكَ بَعدَهُ","تُسَلِّمُ مَخروقاً وَتُعطى مُجَدَّدا",61,"د",2,0],["وَلا زالَ تَجتازُ البُدورُ بِوَجهِهِ","تَعَجَّبُ مِن نُقصانِها وَتَمامِهِ",62,"م",2,0],["ولا زِلتُما كالفرقدينِ تلازُماً","أجدّكما لا تذكرانِ أخاكما",63,"م",2,0],["ولا زال خدُّ الوردِ فيهنَّ ناضراً","وثغرُ أقاحيهنَّ طلقَ المباسمِ",64,"م",1,0],["ولا زلتَ تنضُو من ثيابِكَ بالياً","وتَلبسُ غَضَّاً من أوانِقِه نَضْرَا",65,"ر",2,0],["وَلا زالَت سِنوكَ عَلَيكَ تَجري","بِإِنعامٍ يَتِمُّ بِلا اِنقِضاءِ",66,"ا",2,0],["وَلازالَ مُخضَرٌّ مِنَ الرَوضِ يانِعٌ","عَلَيهِ بِمُحمَرٍّ مِنَ النورِ جاسِدِ",67,"د",1,0],["وَلازالَ لِلدُنيا بَهاءٌ وَبَهجَةٌ","بِمُلكِكَ يَزدادَنِّ طولَ اِزدِيادِها",68,"د",3,0],["وَلازِلتَ بِالصُنعِ الجَميلِ مُشَيَّعاً","كَما أَنَّني بِالصَبرِ غَيرُ مُشَيَّعِ",69,"ع",1,0],["وَلازالَ مَغناها بِمُنعَرَجِ اللِوى","مُرَوَّضَةً أَجزاعُهُ وَجَراوِلُه",70,"ل",2,0],["وَلا زادَ إِلّا فُضلَتانِ سُلافَةٌ","وَأَبيَضُ مِن ماءِ الغَمامَةِ قَرقَفُ",71,"ف",1,0],["ولا زالَتْ رِباعُكَ مُخْصِباتٍ","قَريباتِ الجَنى من كلِّ جانِي",72,"ي",1,0],["ولا زالَتْ سعودُكَ طالعاتٍ","بما تَهواه من عَيْشٍ نَضيرِ",73,"ر",1,0],["وَلا زَوَردِيَّةٍ تَزهو بِزُرقَتِها","بَينَ الرِياضِ عَلى حُمرِ اليَواقيتِ",74,"ت",1,1],["ولا زنداً له في الجوِّ قَدْحٌ","مكانَ شرارها هَمَتِ القِطارُ",75,"ر",1,0],["ولا زلتَ عيداً للورى غيرَ ذاهبٍ","إذا العيدُ ولّى بالزمانِ ذهابا",76,"ب",2,0],["وَلا زَالَ رَيْحَانُ التَّحِيَّةِ نَاضِرَاً","عَلَيْكِ وَهَفَّافُ الرِّضَا مُتَنَسَّمَا",77,"م",2,0],["وَلا زالَ مِن نوءِ السِماكِ عَلَيكُما","أَجَشُّ هَزيمُ الوَدقِ بِالهَطَلانِ",78,"ن",1,0],["وَلا زِلتَ مَطروداً عَديما لِناصِرٍ","كَما لَيسَ لي مِن ظالِمِيَّ نَصيرُ",79,"ر",1,0],["وَلا زالَ رَمٍ فيكَ فَوَّقَ سَهمَهُ","فَلا أَنتَ في عُشٍ وَلا أَنتَ تُفرِخُ",80,"خ",1,0],["وَلا زِلتَ عَن عَذبِ المِياهِ مُنَفَّراً","وَوَكرُكَ مَهدوماً وَبَيضُكَ يُرضَخُ",80,"خ",1,0],["وَلا زِلتَ في شَرِّ العَذابِ مُخَلَّداً","وَريشُكَ مَنتوفٌ وَلَحمُكَ يُشدَخُ",80,"خ",1,0],["وَلازَمتُ القِفارَ بِكُلِّ أَرضٍ","وَعَيشي بِالوُحوشِ نَما وَطابا",81,"ب",2,0],["وَلا زائِراً فَرداً وَلا في جَماعَةٍ","مِنَ الناسِ إِلّا قيلَ أَنتَ مُريبُ",82,"ب",1,0],["وَلا زلت يا رُوحَ الخِلافَةِ سالِماً","فَأَمنيَّةُ الإِسلامِ أَنّك تسلمُ",83,"م",1,0],["وَلازَوَردٍ باهِرٍ نورُهُ","مُستَظرَفِ الأَوصافِ مُستَحسَنِ",84,"ن",1,1],["وَلا زِلتُ عاشِقاً لَ","كَ إِن شِئتَ أَو أَبَيت",85,"ت",1,0],["وَلا زِلتَ مَرعِيّاً بِعَينٍ حَفيظَةٍ","مِنَ اللَهِ لا تَسطو عَلَيكَ المَقادِرُ",86,"ر",1,0],["وَلا زالَ رَيحانٌ وَمِسكٌ وَعَنبَرٌ","عَلى مُنتَهاهُ ديمَةٌ ثُمَّ هاطِلُ",87,"ل",1,0],["ولا زوى أفقه ظلامٌ","له على موجه وثوب",88,"ب",1,0],["وَلا زَالَتِ الأَيَّامُ تَتْلُو مَدَائِحِي","عَلَيْكَ وَيُمْلِيهَا الضُّحَى وَالأَصَائِلُ",89,"ل",1,0],["وَلا زَالَتِ الأَعْيَادُ تَجْرِي سُعُودُهَا","عَلَيْكَ وَتَحْظَى مِنْ عُلاكَ بِإِينَاسِ",90,"س",1,0],["وَلا زَالَ غَضَّ الْعُمْرِ مُمْتَنِعَ الذُّرَا","مَرِيعَ الْفِنَا تُطْوَى إِلَيْهِ الْمَرَاحِلُ",91,"ل",1,0],["وَلا زادَني عَنهُ غِنائي تَباعُداً","وَإِن كانَ ذا نَقصٍ مِنَ المالِ مُصرِما",92,"م",2,0],["ولا زلتَ محمودَ البلاء جميلَه","إذا استخرَجَتْ منك الهناتُ الحفائظا",93,"ظ",2,0],["وَلاَ زَالَ صُنْعُ اللهِ يَضْفوُ لِبَاسُهُ","عَلَى أَمْرِكَ الْعَالِي وَتَصْفُو مَشَارِبُهُ",94,"ب",2,0],["وَلا زالَت عَزالى النَوءِ تُزجي","إِلَيهِ صُبابَةَ المُزنِ الرَوِيِّ",95,"ي",1,0],["ولا زلتِ حصنًا للعروبة شامخًا","يرتدُّ طرْفُ الدهر عنه كليلاَ",96,"ل",2,0],["ولا زلت قطبا تستدير به العلا","كما دارت الأفلاك حول المجدد",97,"د",1,0],["ولا زال نصري العلى رائق الحلى","يصاحب جيش النصر رايته الحمرا",98,"ر",2,0],["ولا زلت في ملك منيع مؤيد","تهش له الدنيا ويعلو له الدهر",99,"ر",1,0],["ولازال رام فيك فوق سهمه","فَلا أنْتَ في عُشٍّ وَلاَ أَنْتَ تُفْرِخُ",100,"خ",1,0],["وَلاَ زِلْتَ فِي شَرِّ الْعّذَابِ مُخَلِّدَاً","وريشك منتوف ولحمك يشرخ",100,"خ",1,0],["وَلاَ زَالَ للدّنيا بَهَاءٌ وَبَهْجَةٌ","بمُلْكِكَ يَزْدَادَانِ طولَ ازْدِيَادِها",101,"د",3,0]]}