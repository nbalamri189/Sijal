{"poems":[[88,"ضعت بين النهى وبين الخيال","https://www.aldiwan.net/poem10945.html","الخفيف"],[93,"قال الغراب وقد رأى كلف الورى","https://www.aldiwan.net/poem8788.html","عموديه"],[93,"وهيامهم بالبلبل الصداح","https://www.aldiwan.net/poem8789.html","عموديه"],[87,"أسخطت جدى الشاذلي","https://www.aldiwan.net/poem7288.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[93,"السر في الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=52996",""],[93,"الغراب والبلبل","https://www.poetsgate.com/ViewPoem.aspx?id=14084",""],[236,"لولا شذا من نشركم ينشق","https://www.aldiwan.net/poem44579.html","السريع"],[382,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[458,"الله في الحب ألحان واضواء","https://www.aldiwan.net/poem61241.html","البسيط"],[505,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[567,"جاءت رسالة إبراهيم سافرة","https://www.aldiwan.net/poem52791.html","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145828","الكامل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128275","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28014","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127401","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216418",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216817",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135722","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135903","الرجز"],[585,"أهلاً بيوم هو الأحقاب والسير","https://www.poetsgate.com/ViewPoem.aspx?id=161900",""],[5246,"مهلا رجال الصفا مهلا محبينا","https://www.poetsgate.com/ViewPoem.aspx?id=187061",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5628,"أميرة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=178481",""],[5628,"طيش وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=191436",""],[5674,"نزيف الشريان مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=189101",""],[5956,"أحلام شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183354",""],[5956,"وجوه مبتسمة","https://www.poetsgate.com/ViewPoem.aspx?id=184823",""],[5956,"لحن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186141",""],[6236,"من أجلك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82000&r=&rc=19",""]],"verses":[["آنَ يا شِعرُ أَن نَفُكَّ قُيوداً","قَيَّدَتنا بِها دُعاةُ المُحالِ",0,"ل",1,0],["إِنّي أَشَدُّ قِوى وَأَمضى مِخلَباً","فَعَلامَ نامَ الناسُ عَنِ اِمتِداحي",1,"ح",2,0],["إِنّي أَشَدُّ قِوى وَأَمضى مِخلَباً","فَعَلى ما نامَ الناسُ عَن تَمداحي",2,"ح",2,0],["إني اشتريت مراقبا","لا أرتضيه بفرغلي",3,"ل",2,0],["آنَ يا شِعْرُ أَنْ تُغَنِّي فأَرْسِلْ","مِنْ قَوافِيكَ ما يَهُزُّ الْوُجُودَا",4,"د",2,0],["اني أشح بدمعي أن يسح على","أرض وما هي لي يا برق أوطان",5,"ن",1,0],["إني أشدّ قوى وأمضي مخلبا","فعلى م نام النّاس عن تمداحي؟",6,"ح",2,0],["إني أشدّ قوى وأمضى مخلبا","فعلام نا الناس عن تمداحي؟",7,"ح",2,0],["أنّي أشوب الآن صفو الهوى","وعارضي قد شاب والمفرق",8,"ق",1,0],["أَنّي أَشينُ كَمالَها","بكلامِهِ أو أَشنَأُ",9,"ا",1,0],["إني أشم عطورا لا أكيفها","لكن يكيفها للنفس إيحاء",10,"ا",2,0],["إنِّي أُشاهِدُ فيه معنًى خافِياً","بُرهانُهُ كالسَّيفِ للمُتَمَحِّلِ",11,"ل",1,0],["إني أشوقُ إلى تلكَ الدِّيارِ كما","شاقت منازلُ ميٍّ قلبَ غَيْلانِ",12,"ن",1,0],["إني أشمُّ الطفلَ فيَّ برغم ِأنَّ","الشيْبَ قوَّسَ أضلعي أو أوْشَكا",13,"ك",2,0],["إني أشاهد في الحياة غرائبا","قد جاوزت بحدودها المعقولا",14,"ل",2,0],["إني أشرتُ إلى علمٍ ومعرفة","فيما أتيت وما يدريه من رجلِ",15,"ل",1,0],["إني أشاهد فيك ما","يدمي فؤادي المضطرب",16,"ب",1,0],["أَنّي أُشِيدَت للطُغاةِ مَدارسٌ","وغدا الهُداةُ فماً بلا أَضراسِ",17,"س",1,0],["إني أشاهد كيف يف","طم في القلوب رضاعها",18,"ع",3,0],["إني أشب الهيام عمري","في قِبلة القلب كالشهاب",19,"ب",1,0],["إني أشكرك للآلاء","من الرجال ربي والنساءِ",20,"ا",2,1],["إني أشكركَ للذي وُلي","من نعمٍ أولَيتَها لي يا ولي",21,"ي",1,1],["إني أشيد بقومي كلما هتفت","بي العروبة لا التيجان والسرر",22,"ر",1,0],["إني أشجع روحا فيك طامحة","إلى العلوم رعاك الله آمينا",23,"ن",2,0],["إنِّي أُشاغِلُ رُوحي عَن مَذابِحِها","كَي لا أصيرَ مَعَ الإدمان مَخبُولا",24,"ل",2,0],["إنّي أشمّكِ زهرةً فوّاحة ً","فأحسُّ أنّ الكونَ صارَ زهورا",25,"ر",2,0],["إنّي اشتريتُ خلاصي وهْوَ أثمنُ مِنْ","هذا المتاع الذي يُغريكِ سيّدتي",26,"ت",2,0],["إني أشتاق ويبعدني","طيف يدنو ثم يغادر",27,"ر",1,0],["إني أشيمُ الروحَ مهما تحتجبْ","فَهِيَ المُحَرِّكُ للهوى وَوَقودُ",28,"د",1,0],["أنَّى أشاهدُ زَهْرةً بسَّامةً","أجِدُ الرُّقِيَّ يطيب مثلَ طيوبها",29,"ب",3,0],["إني أُشّبِّهُ عقلي مثلَ طابِعة","لها حروفٌ عليها عازفٌ فِكري",30,"ر",2,0],["أنِّى أشتاقُكِ سيدتى","لّبِّى أشواقى ضُمِّينى ...",31,"ن",2,0]]}