{"poems":[[79,"هاجتك إذ جئت اللوى فزرودا","https://www.aldiwan.net/poem36535.html","الكامل"],[88,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[49,"أبلغ بني حمدان في بلدانها","https://www.aldiwan.net/poem25125.html","الرجز"],[74,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[91,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[91,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[107,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[48,"خير من الظلم للوالين لو عقلوا","https://www.aldiwan.net/poem22674.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42695","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[105,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[92,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[182,"حريرة","https://www.aldiwan.net/poem50703.html","الكامل"],[228,"ضيعت في هضب الهوى رشدي","https://www.aldiwan.net/poem41886.html","أحذ الكامل"],[256,"صلح","https://www.aldiwan.net/poem39736.html","عموديه"],[303,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[303,"إِن الذين تجافى عنهم الشرف","https://www.aldiwan.net/poem36822.html","عموديه"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[454,"والله ما يا رنج إلا العار","https://www.aldiwan.net/poem993.html",""],[458,"لج الحنين إليك حتى خلتني","https://www.aldiwan.net/poem61336.html","الكامل"],[458,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[469,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[469,"عاثت فكل دم ومال ضائع","https://www.aldiwan.net/poem3372.html","عموديه"],[484,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[543,"أتركوه يهذي فإن كلامه","https://www.aldiwan.net/poem47945.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70907","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70934","البسيط"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100144","الكامل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105460","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114834","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49975","الكامل"],[1456,"","https://poetry.dctabudhabi.ae/diwan/poem/143625","البسيط"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101920","الكامل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114035","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137068",""],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124714","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101600","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101605","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132781","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89147","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109929","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131966","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117889","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117861","البسيط"],[4678,"أبطال غزّة","https://www.poetsgate.com/ViewPoem.aspx?id=185287",""],[4693,"يا أمة المليار","https://www.poetsgate.com/ViewPoem.aspx?id=29925",""],[4715,"دمعة وطن","https://www.poetsgate.com/ViewPoem.aspx?id=208560",""],[4767,"غارة الذئاب","https://www.poetsgate.com/ViewPoem.aspx?id=178790",""],[4796,"الى الاستاذ الشاعر يوسف الخطيب","https://www.poetsgate.com/ViewPoem.aspx?id=34722",""],[4814,"جُرعةُ اللّبن","https://www.poetsgate.com/ViewPoem.aspx?id=201763",""],[4815,"أحلام بلا وطن (على موسيقى المنسرح)","https://www.poetsgate.com/ViewPoem.aspx?id=210526",""],[4832,"جود المسعى فكل قد وعى","https://www.poetsgate.com/ViewPoem.aspx?id=166705",""],[4858,"كيف السّرور؟","https://www.poetsgate.com/ViewPoem.aspx?id=30639",""],[4988,"سيرة بطل راحت معاه الكرامه","https://www.poetsgate.com/ViewPoem.aspx?id=186507",""],[5038,"نسيم الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=188550",""],[5038,"قارورة مسك","https://www.poetsgate.com/ViewPoem.aspx?id=189987",""],[5038,"الموصل الحدباء","https://www.poetsgate.com/ViewPoem.aspx?id=190135",""],[5135,"يا قومنا","https://www.poetsgate.com/ViewPoem.aspx?id=208730",""],[5174,"في يوم الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=185487",""],[5219,"أضغاث أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=195012",""],[5362,"إني تصفحت المعايش كلها","https://www.poetsgate.com/ViewPoem.aspx?id=170321",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5365,"رسالةُ اعتذار إلى نزار قبّاني","https://www.poetsgate.com/ViewPoem.aspx?id=190817",""],[5431,"رحماك يارب السماء","https://www.poetsgate.com/ViewPoem.aspx?id=185254",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5458,"كان جدِّي","https://www.poetsgate.com/ViewPoem.aspx?id=72394",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5569,"غيمة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=60253",""],[5618,"القدس في عين شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=208919",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""],[5956,"أمريكا وحلفاؤها","https://www.poetsgate.com/ViewPoem.aspx?id=192331",""],[5975,"السير في نهج البردة","https://www.poetsgate.com/ViewPoem.aspx?id=58777",""],[6004,"قرابين العِدا","https://www.poetsgate.com/ViewPoem.aspx?id=33754",""],[6069,"وأهيف القد سهل الخد أسمر","https://www.poetsgate.com/ViewPoem.aspx?id=105667",""],[6093,"يا جاثياً في رسُوم الحيِّ معتكفا (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176186",""],[6147,"سفر على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=151691",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[454,"يارنج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82663&r=&rc=27",""]],"verses":[["عاثَتْ بهِنّ يَدُ الزّمانِ فلمْ تجِدْ","أعْلامُهُنّ عنِ العَفاءِ مَحيدا",0,"د",2,0],["عاثوا فَساداً وَفَرّوا","يَستَعجِلونَ السَفينا",1,"ن",2,0],["عاثِرَةً تَعثُرُ في عِنانِها","تَرَكتُ ماصَبَّحتُ مِن فُرسانِها",2,"ن",3,0],["عاثت يدُ الدهر في يومي وقد بليت","أضعاف ما بليت بالهمِّ أقوالي",3,"ل",2,0],["عاث هذا المنون يسرف فينا","فلحت تحتج الحياة المنونا",4,"ن",2,1],["عاثت بها فتاكة ابناؤها","فكأنما ابناؤها اغوالها",5,"ل",3,0],["عاثت ذؤالةُ في القطيع ومَا له","راعٍ وأضحى اللصُّ وهو أمينُ",6,"ن",1,0],["عاثَ في خَطِّ العِذارِ بِهِ","شَرَرٌ قَد طارَ في فَحَمِ",7,"م",1,0],["عاث فيه القومُ حتّى مَالَهُ","حُرمةٌ تُرعَى وحقٌّ يُحتَرمْ",8,"م",1,0],["عاث رَيْبُ الدّهرِ فيما جمعوا","من كنوزٍ كُنَّ في التُّربِ رُكاما",9,"م",2,0],["عاثَت يَدُ الشَرِّ بِالقُطرَينِ وَاِنطَلَقَت","في الأُمَّتَينِ عَوادي الدهرِ وَالنُوَبُ",10,"ب",1,0],["عاثَتِ ذِئابٌ فَلَم يَزجُر مَعَرَّتها","مُستَضعَفونَ لِفُقدانِ السَنانيرِ",11,"ر",1,0],["عاثَت عَصائِبُ فيها كَالذِئابِ عَدَت","عَلى الأَقاطيعِ لَمّا نامَ راعيها",12,"ي",3,0],["عَاثُوا بِهَا حِقْبَةً حَتَّى إِذَا نَهَضَتْ","طَيْرُ الْحَوادِثِ مِنْ أَوْكَارِهَا وَقَعُوا",13,"ع",3,0],["عَاثَ فِيهَا مُسْتَبِدًّا مُسْرِفاً","دَائِبَ الإِجْرَامِ عَوَّاداً مُصِرَّا",14,"ر",2,0],["عاثوا فساداً وبات الكل قاطبة","وبعضهم لحقوق البعض مغتصب",15,"ب",1,0],["عاثت بلُحْمَتِكِ السنينُ ولم تُطِقْ","-لله درَك- عيثةً بسَداك",16,"ك",1,0],["عاثوا بِيَعْرُبَ جَفّفوا أعْوادَها","فَتَناثَرَتْ بيد العِدا تَتَفَكَّكُ",17,"ك",1,0],["عاثَت صُروف الدَهرِ في جَسَدي","بِمَخالِبٍ كَمَخالِبِ الأُسدِ",18,"د",1,0],["عاث اليهود به فسادا ويحكم","ولهم تزان وترفع الأعلام",19,"م",1,0],["عاثَتْ بها سودُ الوُجوهِ تَخالهمْ","بين الطُّلولِ عقارِباً وأَساوِدا",20,"د",2,0],["عاثوا فساداً (بمصرٍ) (والشآم) فهمْ","مقنَّعون بلعْنٍ أينما ثقفوا",21,"ف",3,0],["عاثَ فيها شيطانُ إنسٍ كما عا","ثَ بدار الخلود شيطان جانِ",22,"ن",1,0],["عاث اليهود بأمتي خسفاً ول","رجعية نهضت ولا ثوار",23,"ر",1,0],["عاث الطغاة مدى فما هادنتهم","ورحلت أرشقهم بصدق هجائي",24,"ي",1,0],["عاث اليرابيعُ فيها وهو في شغل","عنها بأضغاث أحلام وبهتان",25,"ن",1,0],["عاثت ذئاب القوم في سرحي ولولا","أنت هاجوا عند ذاك غضنفرا",26,"ر",2,0],["عاثت فكلُّ دمٍ ومالٍ ضائعٌ","أيدي ولائك يا فلانَ الدينِ",27,"ن",1,1],["عاثت يد الموت في النوع اللطيف كما","عاثت يد اللص تشبيها بتشويه",28,"ي",2,0],["عاثَ في الغابِ أيها الملكُ الصِّن","ديدُ قِردٌ وأنتَ فيه أُسامَه",29,"م",2,0],["عاثوا فساداً في البلاد فأصبحوا","جرثومة الأجرام مصدر كل شر",30,"ر",1,0],["عاثَ دينُ امرئٍ يرائي الورى","فحراً بقلب المنهج الرشد قال",31,"ل",1,0],["عاث الزمان وأهلوه وقد مُسخوا","معْ كلِّ ممْتسِخ في إثر مُمْتسخ",32,"خ",1,0],["عاثت بهم غير الزمان كانما","نقدتهم الأيام نقد الصيرفي",33,"ف",2,0],["عاثت بنا وحش الفيافي بعدما","خفقت على هام الرجال نسور",34,"ر",1,0],["عاثت عياث القرد والثعالي","وداستْ الأحرار بالنعال",35,"ل",1,0],["عاثَت في العَتِيقِ بنوقُشَيرٍ","كَعيثِ جَعَارِ في أخرى الرُّخالِ",36,"ل",1,1],["عاثَ الفتى ما عاث في طُرق الصّبا","لم يبدُ عن غيّ الهوى إقْصارُهُ",37,"ر",2,0],["عاثت يد البين في قلبي تقسمه","على الهوى وعلى الذكرى توزعه",38,"ع",2,0],["عاث الزمام بشملهم فتفرقوا","أرأيت عقداً بتّ منه نظام",39,"م",1,0],["عاثت بأنحاء افريقيةٍ فرقٌ","طال الزمانُ وما عن طبعهم حالوا",40,"ل",3,0],["عاثوا بِآل أُمية فكأنهم","سرب البغاث يَعثن فيهِ صُقور",41,"ر",1,0],["عاثوا فساداً وفي الاكسير قد سكروا","لا في عصير ابنة الكرم الذي شربوا",42,"ب",3,0],["عاث الحمام فما أبقى وماتركا","ولم يدع سوقةً منا ولا ملكا",43,"ك",2,1],["عاثر الجدّ جدَّ تحدو بذاته","نزعاتٌ إِلى العدم",44,"م",1,0],["عاث في أرضه فحالت جحيماً","فأتى الخلد عائثاً في جنانه",45,"ن",2,0],["عاث في أرضنا من القوم وحش","كاسر وهو يدعى المدنيه",46,"ي",2,0],["عاث الوبا فكأنَّ المالكين لها","يعاقبون بذنبٍ غير مغتفر",47,"ر",1,0],["عاثَ الدَمارُ ببيتِ اللَهِ وانهَدَمَت","حُصونُهُ المُنع واندكَّت اطابدهُ",48,"د",2,0],["عاثَ الدَمارُ بها فأَمسَت بَلقَعاً","قَفراً يَباباً فاقدَ القُطَّانِ",49,"ن",1,0],["عاثَ فيها البَوارُ طُولاً وعَرضاً","واستباها الدمارُ باستِيثاقِ",50,"ق",1,0],["عاثر الجد كما شاء المدى","تضرم الأشواق في قلبي سعيرا",51,"ر",2,0],["عاثت صروف الدهر في أهله","كأن للدهر لديهم ترات",52,"ت",1,0],["عاثت بنو اللؤم في أبناء فاطمة","أهل الفضائل والغرّ المحاميد",53,"د",1,0],["عاث الصهاينة الأنذال واغتصبوا","كل الحقوق فلا عهدٌ ولا ذممُ",54,"م",1,0],["عاثوا فسادا واستباحوا حرمة","وعيون امتنا الجريحة تنظر",55,"ر",1,0],["عاثت بتاليهم قروم الشياطن","وقاداتُهُم قامت وتلعب بدمها",56,"م",3,0],["عاثوا فساداً فما طا","بتْ مَن تردَّت نِتاجا",57,"ج",2,0],["عاثُ البغاة وما زالوا ولم يجدوا","صدَّاً لبغيهمُ الطَّامي سوى الخطَبِ",58,"ب",1,0],["عاثت صروفُ الدهرِ بالسُننِ","لا شيءَ غيرَ الدمعِ والشجنِ",59,"ن",1,1],["عَاثُوا فَسَاداً في كُلِّ نَاحِيةٍ","وَ كَبَّلَ الضَّيمُ كلَّ مُنتَقدِ",60,"د",1,0],["عاثر جداً فتى ذو فرق","يحسب الذرة طوداً أمنعا",61,"ع",2,0],["عاثوا فساداً في البلاد ودمرّوا عِلماً ودِين","باعوا القضيّة وانتهَوا من كلّ رابطة القرون",62,"ن",1,0],["عاثوا فساد آ بأرض الاسلام واجرام","من داعش الأوباش يالله السّلامه",63,"م",2,0],["عاثَ يا شَوقُ مِنْ لِحاظِكَ سَهْمٌ","في فُؤادي تَجاوزَ السَّمْهَرِيَا",64,"ي",2,0]