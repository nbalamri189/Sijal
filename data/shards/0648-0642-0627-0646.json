{"poems":[[79,"وقاني أذى الناس أخذ الدواء","https://www.aldiwan.net/poem36627.html","المتقارب"],[53,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[63,"وقانا الله فيك منى الحسود","https://www.aldiwan.net/poem51716.html","الوافر"],[50,"وقانص محتقر ذميم","https://www.aldiwan.net/poem65275.html","الرجز"],[50,"قد أغتدي والليل في مكتمه","https://www.aldiwan.net/poem65276.html","الرجز"],[556,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[556,"وما مرح الفتى تزور عنه","https://www.aldiwan.net/poem47893.html","الوافر"],[572,"وملعب للخيل في قرواح","https://www.aldiwan.net/poem69751.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83265","المتقارب"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143780","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93618","البسيط"],[2452,"","https://poetry.dctabudhabi.ae/diwan/poem/100704","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76030","الطويل"],[4101,"","https://poetry.dctabudhabi.ae/diwan/poem/97582","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139610",""],[5186,"\"ثلاث ليال يا \"\"جريج\"\" قضيتها","https://www.poetsgate.com/ViewPoem.aspx?id=156527",""],[2452,"وقانا لفحة الرمضاء واد","https://www.poetsgate.com/ViewPoem.aspx?id=107034",""],[5768,"وَقَانَا اللهُ أَوْبِئَةً !","https://www.poetsgate.com/ViewPoem.aspx?id=215420",""],[6124,"أحبك ياوطني","https://www.poetsgate.com/ViewPoem.aspx?id=154121",""]],"verses":[["وَقاني أذى الناسِ أخْذُ الدّواءِ","وجاءَ بعُذْرٍ لرَفْعِ الجُناحْ",0,"ح",1,1],["وقاني شرَّهُ من بعد يأسٍ","دِفاعُ الله دَفّاعِ الرُّيوبِ",1,"ب",1,0],["وقانَا اللهُ فيكَ مُنى الحسودِ","ودافعَ عنك للكرمِ التَّليدِ",2,"د",1,1],["وَقانِصٍ مُحتَقَرٍ ذَميمِ","كَدرِيِّ لَونٍ أَغبَرٍ قَتيمِ",3,"م",1,1],["وَقانِصٍ أَحفى بِهِ مِن أُمِّهِ","لَو يَستَطيعُ قاتَهُ بِلَحمِهِ",4,"م",2,0],["وَقاني اللّهُ ما أَخشاه فيمنْ","به من بين هذا الخلق أُنْسِي",5,"س",2,0],["وَقاني اللَّه فَقدَك من خليلٍ","ثَنَتْ مِنِّي مودّتُهُ جِماحِي",6,"ح",2,0],["وقانِئٍ مِثْلَ دَمِ الجِرَاحِ","سَبْطٍ كَخَطِّيٍّ مِنَ الرِّمَاحِ",7,"ح",1,0],["وقانا حيث صار الماء خمرا","بعرس قد ركبت لها المطيه",8,"ي",2,0],["وَقانا دَسائِسَ أَهلَ النِفا","قِ وَردُ الوُشاةِ وَجَلى الغِمَم",9,"م",1,0],["وقاني بزيتونها والجبن","صفائح من بيضةٍ مدعمه",10,"م",2,0],["وَقانص العلم وَالآداب أَن يَره","أَغناه عَن كُل صَيد فَهوَ جَوف فَرا",11,"ر",2,0],["وقانا لفحة الرمضاء واد","وقاه مضاعف الغيث العميم",12,"م",1,1],["وَقانونُ عِيسى وَالفُصُولُ وَنَظمُها","وَنَظمُ ابنُ مالٍ ما أَرَدَّ وَأَقلَقا",13,"ق",2,0],["وَقانا لفحةَ الرمضاء واد","سقاه مضاعف الغيث العميمِ",14,"م",1,1],["وقانصة ولي قلبٌ إليها","يود بأن يطير بلا جناح",15,"ح",1,0],["وقاني، وقى الله اللطيف شبابه،","تباريح، لولا كفه، أخمدت حسي",16,"س",2,0],["وقانا لفحة الرمضاء واد","وقاء مضاعف الغيث العميم",17,"م",1,1],["وَقَانَا شَرَّ أَوْبِئَةٍ","تُلَوِّثُ لُجَّةَ الْبَحْرِ",18,"ر",1,0],["وَقانونًا للوَادي أملاً","وتَارِيخًا يَخلو منْ شَجنِ",19,"ن",1,0]]}