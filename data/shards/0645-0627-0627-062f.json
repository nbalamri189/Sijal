{"poems":[[72,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[91,"زعم المرء إنما هو رب","https://www.aldiwan.net/poem62799.html","عموديه"],[66,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[44,"هي فرقة من صاحب لك ماجد","https://www.aldiwan.net/poem30554.html","الكامل"],[22,"ما أدري إذا لاقيت عمروا","https://www.aldiwan.net/poem21708.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85466","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141928","الخفيف"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[22,"مَا أَدْرِي إذا لاقَيْتُ عَمْراً","https://www.poetsgate.com/ViewPoem.aspx?id=19735",""],[144,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[144,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"غفرت للأيام ذنب الفراق","https://www.aldiwan.net/poem51913.html","السريع"],[372,"أما اشتفى كاشح ولا حاسد","https://www.aldiwan.net/poem57477.html","المنسرح"],[410,"حملت ثقلي بعد ما شبت العصا","https://www.aldiwan.net/poem31941.html","الكامل"],[433,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[462,"ما أدعي فيك ما حبي ينمقه","https://www.aldiwan.net/poem15902.html","البسيط"],[501,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"]],"verses":[["ما أدمعي في هواك السمح باخلة","وكيف وهي التي بالعينِ قد سمحت",0,"ت",1,0],["ما اِدَّعى الدُرُّ أَنَّةَ صورَةُ البَح","رِ وَلا قالَ إِنَّني إِيّاهُ",1,"ا",2,0],["ما أَدرَكَت فُصَحاءُ العُربِ غايَتَها","قَبلي وَلا أَخذوا في مِثلِها سَبَقي",2,"ق",2,0],["ما أَدَّعي لَكَ جانِباً مِن سُؤدُدٍ","إِلّا وَأَنتَ عَلَيهِ أَعدَلُ شاهِدِ",3,"د",1,0],["ما أَدري إِذا لاقَيتُ عَمرواً","أَكَلبى آلُ عَمروٍ أَم صِحاحُ",4,"ح",1,1],["ما أَدري حين أَجيء به","هَل أصلحه أَم أُفسده",5,"د",2,0],["ما ادلَهَمّت سماءُ لبنان إلا","أطلعت منك في دياجيهِ فجرا",6,"ر",2,0],["ما آدها حملُ السلا","ح ولا شَكَتْ ثِقْلَ الذخائر",7,"ر",1,0],["مَا أَدْرِي إذا لاقَيْتُ عَمْراً","أكلبى آل عمروٍ أم صحاحُ",8,"ح",1,1],["ما أَدرَكَت أَشياخُهُ وَهُمُ الأُلى","شَرُفوا وَعَزّوا ما حَواهُ أَمرَدا",9,"د",2,0],["ما أَدرَكَ الطَلِباتِ مِثلُ مُصَمِّمِ","إِن أَقدَمَت أَعداؤُهُ لَم يُحجِمِ",10,"م",1,1],["ما اِدّعيتُم فضلاً على الخلق إلّا","سلّمتهُ الأعداء والأصدقاءُ",11,"ا",2,0],["ما ادَّرَعَ الليلُ بظلمائه","حتى كساه الصبحُ منه رُواقْ",12,"ق",1,0],["ما أدَّعي بعدَ ذابها كَلفاً","نمَّت على الخَلق حيلة الجاحِد",13,"د",1,0],["ما آدَها ثِقْلِي ولكن ثِقلُ ما","أبقَى الشّبابُ عَليَّ من أوزَارِهِ",14,"ر",2,0],["ما أدركوا سَعْيَكَ العالي وما بَلَغُوا","فهَلْ عليهم إِذا خافوك من دَرَكِ",15,"ك",1,0],["ما أدَّعي فيك ما حُبِّي يُنَمِّقهُ","الحَيُّ أعْلَمُ بالمجدِ الذي فيكا",16,"ك",2,1],["ما أدَّعى في مشاهدِ القوم دعوى","ذات بالٍ إلا علا برهانه",17,"ن",2,0]]}