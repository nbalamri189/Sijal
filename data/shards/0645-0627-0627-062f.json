{"poems":[[74,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[93,"زعم المرء إنما هو رب","https://www.aldiwan.net/poem62799.html","عموديه"],[68,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[46,"هي فرقة من صاحب لك ماجد","https://www.aldiwan.net/poem30554.html","الكامل"],[22,"ما أدري إذا لاقيت عمروا","https://www.aldiwan.net/poem21708.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85466","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141928","الخفيف"],[108,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[22,"مَا أَدْرِي إذا لاقَيْتُ عَمْراً","https://www.poetsgate.com/ViewPoem.aspx?id=19735",""],[147,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[202,"غفرت للأيام ذنب الفراق","https://www.aldiwan.net/poem51913.html","السريع"],[376,"أما اشتفى كاشح ولا حاسد","https://www.aldiwan.net/poem57477.html","المنسرح"],[415,"حملت ثقلي بعد ما شبت العصا","https://www.aldiwan.net/poem31941.html","الكامل"],[438,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[466,"ما أدعي فيك ما حبي ينمقه","https://www.aldiwan.net/poem15902.html","البسيط"],[505,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83270","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48670","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37759","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120027","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144779","الخفيف"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216640",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199814","المسحوب"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105062","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94301","الرمل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107025","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112490","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97885","المتدارك"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68020","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62821","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138652",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138605",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133176","الرجز"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114606","الكامل"],[4680,"وهبتك العمر","https://www.poetsgate.com/ViewPoem.aspx?id=185008",""],[4739,"انا ضدك","https://www.poetsgate.com/ViewPoem.aspx?id=34894",""],[4869,"مدت لي الفنجال","https://www.poetsgate.com/ViewPoem.aspx?id=162863",""],[4869,"جن الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=151520",""],[4869,"ياتسرع ونقلب ياهدي السرعه","https://www.poetsgate.com/ViewPoem.aspx?id=151547",""],[4869,"الموت لحظة طلّته","https://www.poetsgate.com/ViewPoem.aspx?id=151549",""],[4869,"صباح الليل","https://www.poetsgate.com/ViewPoem.aspx?id=151610",""],[4869,"الحشيمه","https://www.poetsgate.com/ViewPoem.aspx?id=151642",""],[4869,"الغالي اللي يحب الكذب","https://www.poetsgate.com/ViewPoem.aspx?id=151657",""],[4869,"قالت تعال","https://www.poetsgate.com/ViewPoem.aspx?id=151672",""],[4869,"حريق جده","https://www.poetsgate.com/ViewPoem.aspx?id=151707",""],[5055,"شوف ألماس","https://www.poetsgate.com/ViewPoem.aspx?id=103651",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5455,"غربة أعياد","https://www.poetsgate.com/ViewPoem.aspx?id=34466",""],[5461,"مرتاح أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=27710",""],[5751,"حزنٌ بلون الفَرَح","https://www.poetsgate.com/ViewPoem.aspx?id=214719",""],[5943,"نوارس الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=60767",""],[5943,"تشطير ( يا صاحِبِي مالي وللأُنْسِ )","https://www.poetsgate.com/ViewPoem.aspx?id=138278",""],[5952,"قد هاجت الصبحَ أشواقٌ إلى وطنِ","https://www.poetsgate.com/ViewPoem.aspx?id=197113",""],[5956,"لو كنتَ تعرف ما الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=182193",""],[6023,"والصباح استعار من هجر حبِّي","https://www.poetsgate.com/ViewPoem.aspx?id=123863",""]],"verses":[["ما أدمعي في هواك السمح باخلة","وكيف وهي التي بالعينِ قد سمحت",0,"ت",1,0],["ما اِدَّعى الدُرُّ أَنَّةَ صورَةُ البَح","رِ وَلا قالَ إِنَّني إِيّاهُ",1,"ا",2,0],["ما أَدرَكَت فُصَحاءُ العُربِ غايَتَها","قَبلي وَلا أَخذوا في مِثلِها سَبَقي",2,"ق",2,0],["ما أَدَّعي لَكَ جانِباً مِن سُؤدُدٍ","إِلّا وَأَنتَ عَلَيهِ أَعدَلُ شاهِدِ",3,"د",1,0],["ما أَدري إِذا لاقَيتُ عَمرواً","أَكَلبى آلُ عَمروٍ أَم صِحاحُ",4,"ح",1,1],["ما أَدري حين أَجيء به","هَل أصلحه أَم أُفسده",5,"د",2,0],["ما ادلَهَمّت سماءُ لبنان إلا","أطلعت منك في دياجيهِ فجرا",6,"ر",2,0],["ما آدها حملُ السلا","ح ولا شَكَتْ ثِقْلَ الذخائر",7,"ر",1,0],["مَا أَدْرِي إذا لاقَيْتُ عَمْراً","أكلبى آل عمروٍ أم صحاحُ",8,"ح",1,1],["ما أَدرَكَت أَشياخُهُ وَهُمُ الأُلى","شَرُفوا وَعَزّوا ما حَواهُ أَمرَدا",9,"د",2,0],["ما أَدرَكَ الطَلِباتِ مِثلُ مُصَمِّمِ","إِن أَقدَمَت أَعداؤُهُ لَم يُحجِمِ",10,"م",1,1],["ما اِدّعيتُم فضلاً على الخلق إلّا","سلّمتهُ الأعداء والأصدقاءُ",11,"ا",2,0],["ما ادَّرَعَ الليلُ بظلمائه","حتى كساه الصبحُ منه رُواقْ",12,"ق",1,0],["ما أدَّعي بعدَ ذابها كَلفاً","نمَّت على الخَلق حيلة الجاحِد",13,"د",1,0],["ما آدَها ثِقْلِي ولكن ثِقلُ ما","أبقَى الشّبابُ عَليَّ من أوزَارِهِ",14,"ر",2,0],["ما أدركوا سَعْيَكَ العالي وما بَلَغُوا","فهَلْ عليهم إِذا خافوك من دَرَكِ",15,"ك",1,0],["ما أدَّعي فيك ما حُبِّي يُنَمِّقهُ","الحَيُّ أعْلَمُ بالمجدِ الذي فيكا",16,"ك",2,1],["ما أدَّعى في مشاهدِ القوم دعوى","ذات بالٍ إلا علا برهانه",17,"ن",2,0],["ما أَدهَشَتنا مِنَ النَجمِيِّ قافِيَةً","كَأَنَّها الغادَةَ الحَسناءَ في العُرُسِ",18,"س",1,1],["ما أدَّبَ العاصين طال مقامهم","في السجن كالعفو الكريم وعلّما",19,"م",2,0],["ما أَدارَ الكَأسَ إِلّا خِلتُها","شَمسَ أُفقٍ نورُها قَد وَضُحا",20,"ح",2,0],["ما أداري في النصف خلقا من النا","س وسعد الفراش يعرف داري",21,"ر",2,0],["ما أدارَ الراحَ إلاَّ مثّلت","حول كسرى منه في الكأس ربيبا",22,"ب",2,0],["ما أديب قد حاك من نسج فكر","حللا من بديع لفظ كسحر",23,"ر",1,0],["ما ادري يشب الجُوْ رُوحي تِسَاعِير","والا مصادر حرّها قَلْب وقَّاد",24,"د",1,0],["ما ادلَهَمَّتْ ربد الحوادث إلا","راح طلقاً كالكوكب الوقاد",25,"د",1,0],["ما ادري طرب لو من شقا به يونّي","لي من لفا وامسى على العشّ ضاوي",26,"ا",3,0],["ما أداة عجماء لكن روت لي","من حديث القرون ما قدم تقادم",27,"م",1,1],["ما ادعى الفضل على من ثم إلا","ثبتت يا صاحب البرهان دعواه",28,"و",3,0],["ما آدم لا ولا نوح ولا أحد","من النبيين من بدء ومن عقب",29,"ب",1,0],["ما آدنى إلا بكاء حليلتي","حزنا لبؤس شبابها وشبابي",30,"ب",2,0],["ما أدركَ سر النجم ولا","سر الآلاءِ أو الوقد",31,"د",1,0],["مَا آدَها كُللٌ ثِقْلاً بمن حَملتْ","تَطير بالرَّكْبِ إقداماً إِلَى النَّجَفِ",32,"ف",1,0],["ما أدركوا ورُقاهُم فيكَ نافِثةٌ","غيرَ الأماني من ظَنٍّ وتقديرِ",33,"ر",1,0],["ما أدمعي وحرارة الأنفاس","لدثور ربعٍ أو خلو كناس",34,"س",1,1],["ما ادعى استخلافه عن أحمدٍ","إنما كان إلى الحق عضيدا",35,"د",2,0],["ما ادري هل الأحباب يذكروني","فيرحموني",36,"ي",1,0],["ما ادرك الجهلاء رشدك فيهم","عين الجهول عن الهدى عمياء",37,"ا",2,0],["ما أدركت فيك روحي بعدُ قبلتَها","لكنّ قلبي إليها حجَّ واعتمرا",38,"ر",2,0],["ما ادري انا ضد قلبي اوانا ضدك","من شاف ما يكرهه يعاف ما حبه",39,"ب",2,0],["ما ادري بكت من حرّها او تباكت","بس الاكيد اني ضفرت بشهدها",40,"د",3,0],["ما ادري كتبته. او هو اللي كتبني","ما ادري ولكنّي كذا. جيت شاعر",41,"ر",1,0],["ما ادري احس انك من صدمتي ثآير","او ماعجبك اللي اخلف معي شرعه",42,"ع",2,0],["ماادري نبت بين الحنآيآ اوهطل","فديت نبته يوم تثمر هطلته",43,"ت",2,0],["ماادري قتلت اللي بقى من خلآيآ","والا انبتت لك بالخلآيآ عفآريت",44,"ت",1,0],["ما ادري عيونك للبشر كانت جياع","والا ان سودك تاليتها وخيمه",45,"م",2,0],["ماادري وش اللي معاه آآحب","لاعاد هرجه / ولا حِبه",46,"ب",2,0],["مآ ادري اسميهآ المهآ وْالا الغزآل","والا اسميهآ حيآة لميتهآ",47,"ت",3,0],["ما ادري بدرب المجرمين اتحآذآ","والا تبي تقسى قلوب الموده !!",48,"د",2,0],["ما أدور عن عهودٍ تفترق","عندي الهامات تعلا في الكفوف",49,"ف",1,0],["ما أدعى ذو الخيال إلا تداعى","وبحب الظهور قصم الظهور",50,"ر",1,0],["ما أديم الثرى وثير لحر","ما أديب الورى لفرش وثير",50,"ر",1,0],["ما ادري اتوه.. او اهتدي.. بس الوكاد","منفاي ما ادري موطني..حذفة جروح",51,"ح",1,0],["ما ادري صواب او خطأ ما قلت","إنك حبيبي وانا خلّك",52,"ك",1,0],["ما أَدْمَعَتْ عَيناهُ إلاّ عِندَما","آوى إليهِ مُقَمِّطاً أَنواءَهُ",53,"ا",3,0],["ماأدركتْ فطنةُ التفكيرِ معقلَها","فكيفَ تسبحُ والتيارُ بالضِّدِ؟",54,"د",1,0],["ما أَدْرَكَتْ ثَأْرًا ولا وَطَرًا","((ماحررتْ قدسًا من الحبسِ",55,"س",1,0],["ما أدركت ماء نيلٍ إذ بها عطشٌ","ولا بتمر عراقٍ صِحَّةُ البَدَنِ",56,"ن",1,0],["ما أدرَكَ الإنسانُ ما النشوى سوى","من بعد ما شرب المحبة لا الطّلى",57,"ل",2,0],["ما أديل اللقاء من يومِ بَيْنٍ","وأعاد السُّرور لُطف المعادِ",58,"د",1,0]]}