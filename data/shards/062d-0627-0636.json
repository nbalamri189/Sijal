{"poems":[[66,"لي حبيب أزور في الخلوات","https://www.aldiwan.net/poem67660.html","الخفيف"],[87,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[119,"دعنا من الاضغاث والاحلام","https://www.aldiwan.net/poem40482.html","عموديه"],[216,"برق تبدى خفية بسناء","https://www.aldiwan.net/poem37922.html","الكامل"],[264,"بمدام أنس مقام إبراهيما","https://www.aldiwan.net/poem35807.html","الكامل"],[266,"ربع أسماء لا عداك عنان","https://www.aldiwan.net/poem38168.html","الخفيف"],[409,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[463,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[519,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[543,"إن يكن غيري تابا","https://www.aldiwan.net/poem48275.html","عموديه"],[563,"إن وجها كنت أنظره","https://www.aldiwan.net/poem34469.html","المديد"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111809","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127379","الرمل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118830","المديد"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79701","الرمل"],[3096,"","https://poetry.dctabudhabi.ae/diwan/poem/198785",""],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/22","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125877","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28678","المنسرح"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119559","الخفيف"],[4739,"الملهمة","https://www.poetsgate.com/ViewPoem.aspx?id=28035",""],[4764,"ما يهمنّي تكدر ولا يهمنّي ازعله","https://www.poetsgate.com/ViewPoem.aspx?id=37125",""],[4875,"حاضر بحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=133359",""],[5171,"سلامة البيت","https://www.poetsgate.com/ViewPoem.aspx?id=198198",""],[5277,"جدبٌ..ولات سحاب","https://www.poetsgate.com/ViewPoem.aspx?id=187585",""],[5461,"زايل الشر ردا على قصيدة الأمير (سلطان بن عبد العز","https://www.poetsgate.com/ViewPoem.aspx?id=5063",""],[5539,"المندق","https://www.poetsgate.com/ViewPoem.aspx?id=196880",""],[5691,"قالها شافيز...!","https://www.poetsgate.com/ViewPoem.aspx?id=207080",""],[5732,"يا سيفنا القطاع","https://www.poetsgate.com/ViewPoem.aspx?id=177833",""],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""]],"verses":[["حاضِرٌ غائِبٌ قَريبٌ بَعيدٌ","وَهوَ لَم تَحوِهِ رُسومُ الصِفاتِ",0,"ت",1,0],["حاضِرٌ لَدى طَلَبٍ","حاضِرٌ وَلا طَلَبُ",1,"ب",1,0],["حاضرٌ أشبهُ بالماضي الجميلْ","لو يُغَنِّيهِ المغني الأولُ",2,"ل",1,0],["حَاضِرَةُ الإِسْلاَمِ فِي حُقْبَةٍ","تَجْدُرَ أَنْ تُدْعَى بِكُبْرَى الْحُقُبْ",3,"ب",1,0],["حَاضِرُ الذِّهْنِ مَا دَعَا الوَحْيَ لَبَّى","مِنْ سَمَاءٍ الحِجَى بِمَعْنَى جَدِيدِ",4,"د",1,0],["حاضرتكم بقصيدة مضمونها","مدح وعرض الحال مسك ختام",5,"م",1,0],["حَاضَتْ بيمناه الصَّوارمُ والقَنَا","من وَكْزِه في مَعْركِ الهيجاءِ",6,"ا",2,0],["حاضت ذكور رماح سطوته دماً","وصفاح دولته جرت تبكي ما",7,"م",2,0],["حاضر غائب قريب بعيد","عاجز قادر غني معان",8,"ن",1,0],["حاضر في القلب لم يغب","ذكركم والقلب ينقلب",9,"ب",1,0],["حاضرة تحسبها باديةً","تديَّرتْ داراتِ خبتٍ فالبُرَقْ",10,"ق",1,0],["حاضرٌ عند علمهِ كلُّ شيءٍ","فطِوالُ الدُهورِ مثلُ فَواقِ",11,"ق",1,0],["حاضرُ الجسمِ ولكِن","عقلُه قد كَانَ غَابا",12,"ب",2,0],["حاضر عندي أشاهده","وسويدا القلب تبصره",13,"ه",1,0],["حاضراً مستقبلاً او ماضياً","ما احثيالُ الناس في هذا القضا",14,"ض",2,0],["حاضر عنه علمه كل شيء","فانتهاءُ الأشياء مثل ابتداها",15,"ا",3,0],["حاضرٌ شاهدٌ سميعٌ بصيرٌ","ما نأى فيضُ نورهِ عن مكانِ",16,"ن",1,0],["حاضرٌ شاهدٌ سميعٌ بصيرٌ","ومحالٌ إدرامهُ بالعيانِ",16,"ن",1,0],["حاضرا مستمعا إم","ما يناديني ألبي",17,"ي",1,0],["حاضرٌ في القلب لم يغبِ","لذَّ لي في حبه تعبي",18,"ب",2,1],["حاضراً ما بين قوم غائباً","لا ينال القوم مني بالمقال",19,"ل",1,0],["حاضر زاه وراق","وغدٌ واعٍ وواعد",20,"د",1,0],["حاضرُها ومن لهم خيامُ","فقال لا يأتيكما طعامُ",21,"م",1,0],["حاضِرٌ شَرُّكُم وَخَيرُكُمُ دَرُّ","خَروسٍ مِنَ الأَرانِبِ بِكرِ",22,"ر",1,0],["حاضرٌ زاهراٌ وماضٍ مجيدٌ","لم تَفُقنَا في الخلد إلا الجنان",23,"ن",1,0],["حاضِرُنا نَرجسٌ كَأَنَّ بِهِ","عِناقَ خَيلٍ سَفَرنَ عَن قَرحِ",24,"ح",1,0],["حاضرا في صدوده","حين يرجى وصاله",25,"ل",2,0],["حاضري واول طريقي وآخره","ابتديت اعيش عمري.. واحسبه",26,"ب",2,0],["حاضره كلي لكبره .. لأطعنه كلي برود","ما يهمنّي تِكدر .. ولا يِهمنّي ازعله",27,"ل",2,0],["حاضر بحاضر على علم وعداله","ما ألتفت يمّ المترجم والدليله",28,"ل",2,0],["حاضناً بيته الذي طال صرحاً","من سماحٍ ويقظة وصمود",29,"د",1,0],["حاضنتُها في الكرى طيفاً فساومني","وجدي... فأثقلتِ الأحلامَ آهاتي",30,"ت",2,0],["حاضر بالمراجل مثل ماهي قدايم","أمسك ويومك وباكرمعك له ذخيره",31,"ر",2,0],["حاضر ن لو طرقه الشعر بدء وختام","مايوفيه ،،من حقه يكود القليل",32,"ل",1,0],["حاضِناً أحْبابَهُ في دَعَةٍ","وازْدِهار ٍبخُطى أحْبابِهِ !",33,"ب",2,0],["حاضرك يشهد لك بما قال ماضيك","وماضيك تاريخ يصور سجاياك",34,"ك",1,0],["حاضر الشخص فيكم ظاهر القد","رة رحبة المكان عالي الحضور",35,"ر",1,0]]}