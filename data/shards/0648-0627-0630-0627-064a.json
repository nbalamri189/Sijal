{"poems":[[57,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[56,"فإذا جالسته صدرته","https://www.aldiwan.net/poem27446.html","الرمل"],[90,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[49,"وإذا يإست من الدنو","https://www.aldiwan.net/poem25302.html","مجزوء الكامل"],[93,"يا شاعرا حلو المودة","https://www.aldiwan.net/poem8762.html","عموديه"],[93,"امنحيني يا نجوم الألقا","https://www.aldiwan.net/poem9047.html","عموديه"],[87,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[107,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[48,"وعظ الزمان فما فهمت عظاته","https://www.aldiwan.net/poem23321.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20992","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[13,"وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180800",""],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""],[96,"المعبد المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15623",""],[132,"يا سائلي عن حصن قريتنا لم","https://www.aldiwan.net/poem50674.html","الطويل"],[136,"هاج إدكارى شادن بدكار","https://www.aldiwan.net/poem54836.html","الكامل"],[147,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[186,"أمنازل الأحباب ما فعل الألى","https://www.aldiwan.net/poem67039.html","الكامل"],[280,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[287,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[347,"يا حبيبي عد الينا","https://www.aldiwan.net/poem55358.html","مجزوء الرمل"],[369,"ماذا يهيج غدوة شجني","https://www.aldiwan.net/poem60626.html","أحذ الكامل"],[369,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[371,"ورأيت أجسام العداة","https://www.aldiwan.net/poem17261.html","مجزوء الكامل"],[376,"ما بال همك لا يزيد","https://www.aldiwan.net/poem57503.html","مجزوء الكامل"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[466,"شرف الدولة بحر زاخر","https://www.aldiwan.net/poem15129.html","الرمل"],[469,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[469,"أهدى الضنا تذكارها","https://www.aldiwan.net/poem3495.html","عموديه"],[484,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[543,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54067","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63837","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59533","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72293","الكامل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96463","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133816","الخفيف"],[1380,"","https://poetry.dctabudhabi.ae/diwan/poem/21310","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52054","الكامل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114724","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46471","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27392","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106908","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132305","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75989","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76050","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93792","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202607","الكامل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71331","الرمل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28900","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62888","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131280",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59473","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135521","الكامل"],[3986,"","https://poetry.dctabudhabi.ae/diwan/poem/20931","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125831","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125803","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83184","الكامل"],[4830,"بين جدران الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=195193",""],[4940,"سيف التجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=210451",""],[3271,"شعر","https://www.poetsgate.com/ViewPoem.aspx?id=104124",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[5158,"للحلم للشعر وأشياء أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=59128",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5213,"أعلى السفح تعرفت الديارا","https://www.poetsgate.com/ViewPoem.aspx?id=170459",""],[5358,"ذهب الدهرُ بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21475",""],[5358,"طيرُ المَجَرّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=48735",""],[5358,"طرقتُ بابَك","https://www.poetsgate.com/ViewPoem.aspx?id=183427",""],[5648,"انا محتار باستغراب","https://www.poetsgate.com/ViewPoem.aspx?id=154842",""],[5691,"ليوث الغضب","https://www.poetsgate.com/ViewPoem.aspx?id=206859",""],[5725,"قولي لحسنك","https://www.poetsgate.com/ViewPoem.aspx?id=192489",""],[5821,"امانه","https://www.poetsgate.com/ViewPoem.aspx?id=113761",""],[5909,"هلّا بقيِتَ وفي الحبيب عزاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210580",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"أوطان الحب","https://www.poetsgate.com/ViewPoem.aspx?id=192320",""],[6167,"عمارة الضباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85571&r=&rc=54",""],[186,"أمنازل الأحباب ما فعل الألى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55792&r=&rc=55",""],[572,"وإذا يَمَّمَتْ بنانُكَ خَطّاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9234&r=&rc=91",""]],"verses":[["وَإِذا يَمُرُّ بِبابِها","لَثَمَ الجِدارَ وَظَلَّ يُصعَق",0,"ق",1,0],["وَإِذا يُثَوِّبُ صارِخٌ مُتَلَهِّفٌ","وَعَلا غُبارٌ ساطِعٌ بِعِمادِ",1,"د",1,0],["وَإِذا يَلوثُ لُغامَهُ بِسَديسِهِ","ثَنّى فَهَبَّ هِبابَهُ وَتَزَيَّدا",2,"د",2,0],["وَإِذا ياسَرتَهُ صادَفتَهُ","سَلِسَ الخُلقِ سَليمَ الناحِيَه",3,"ي",2,0],["وإذا يخاطبك اللئي","مُ فصُمَّ سمعك عن خطابه",4,"ب",2,0],["وَإِذا يَإِستُ مِنَ الدُنُو","وِ رَغِبتُ في فَرطِ البِعادِ",5,"د",1,1],["وَإِذا يُعابُ عَلى المَشيبِ","فَتى فَمَن ذا لا يُعاب",6,"ب",1,0],["وَإِذا يُتلى لِمُشتاقٍ سَلا","وَإِذا يُروى لِباكٍ صَفَّقا",7,"ق",2,0],["وإذا يسام نفيسَه","والنفس أعطى الكل صاغر",8,"ر",1,0],["وَإِذا يَمَّموا الجِبالَ سُجوداً","فَالمُرادُ الجَلالَةُ الشَمّاءُ",9,"ا",2,0],["وَإِذا يُلاقي نَجدَةً مَعلومَةً","يَصلى الكُماةُ بِحَرِّها لَم يَبلُدِ",10,"د",1,0],["وَإِذا يُهابُ بِهِم إِلى أُكرومَةٍ","نَفَروا وَإِن سيموا الهَوانَ أَشاحوا",11,"ح",3,0],["وَإِذا يَعَضُّ تَشُدُّهُ أَعضائُهُ","عَضَّ الكَبيرِ مِنَ الرِجالِ الأَدرَدِ",12,"د",1,0],["وَإِذا يَدٌ قُطِعَت فَإِنَّ عَشيرَها","لَو حُرِّقَت بِالنارِ لا يَتَأَلَّمُ",13,"م",1,0],["وإذا يَركَبُ رَأساً كَُّهُ","زاعِبيٌّ في رُدَينِيٍّ أَصَم",14,"م",1,0],["وَإِذا يَحزنُ مَن يَرجو المُنى","فَالَّذي اِستَيأَسَ بِالحُزنِ أَحَق",15,"ق",1,0],["وَإذَا يَهْبُّ من الْمَنَامِ رَأَيْتَهُ","كَرُتُوبِ كَعْبِ السَّاقِ لَيْسَ بِزُمَّلِ",16,"ل",1,0],["وإذا يعضّ تشدهُ أعضاؤهُ","، عضّ الكَبيرِ مِنَ الرّجالِ الأدردِ",17,"د",1,0],["وإذا يشتهي الأغانيّ يسمع","معبدا والغريض والموصليّا",18,"ي",2,0],["وإذا يقولُ رأيتُ حِصناً مثله","بعُمانَ في الترتيب ليس يصيبُ",19,"ب",1,0],["وإذَا يُحَاوِلُ أنّ يَنُوءَ صَدَّهُ","كَفَلٌ كَمركُومِ الكَثِيبِ الهَارِي",20,"ر",2,0],["وَإِذا يُهابُ الخَطبُ عِندَ حُلولِهِ","فَبِهِ لِدَفعِ النائِباتِ يُهابُ",21,"ب",1,0],["وَإِذا يَفوه تَناثَرَت مِن لَفظِهِ","دُرر تَقلّدها المَعاصم وَالطُلَى",22,"ل",2,0],["وَإِذا يَلوذُ بظِلِّهِ الجَبَّارُ لَمْ","تُحْرِقْهُ شُهْبُ رِماحِهِ شَيْطانا",23,"ن",2,0],["وَإِذا يُجادِلُ في العُلومِ بُزاتَها","كانوا بُغاثاً وَهوَ فيهِم أَجدَلُ",24,"ل",1,0],["وَإِذا يُشفّعُ في القيامة عالمٌ","وَيفوز بِالتأريخ فاز مشفّعُ",25,"ع",1,0],["واذا يا صاحبي نحن","ن نيامٌ فوعينا",26,"ن",2,0],["وإذا يَعِزُّ الشَّيْءُ أَطلُبُه","وإذا تركْتُ الشّيْءَ يَطلُبني",27,"ن",2,0],["وإذا يداهُ أسنتا بعَطيّةٍ","نَصرْتُكَ حتّى لم يُبَلْ إن أسنَتا",28,"ت",2,0],["وَإِذا يُباشِرُ عَذلَهُ","فَالسَمعُ أَشرَدُ مِن نَعامِ",29,"م",1,0],["وإذا يُباشرُ حربَهُ","فالرِجلُ أثبتُ من شمامِ",29,"م",1,0],["وإذا يذودُ الناسُ عن","أموالِهم فبِها يذودُ",30,"د",1,0],["وإذا يرنو إلى مشتاقِهِ","سلَّ سيفَ اللّحظ عنواناً وكرّا",31,"ر",2,0],["وإذا يمَّمْتَه في حاجة","زاد في ملقاك إكراماً وبشرا",31,"ر",2,0],["وإذا يُسْألُ مَنْ فارسُها","يومَ تحطيم القنا قِيلَ عُمَرْ",32,"ر",1,0],["وإذا يعدُّ أباهُ في","دين الشجاعة والحزامة",33,"م",2,0],["وإذا يخاف المحلُ","فالملك المعظّم جارها",34,"ر",3,0],["وإذا يكافحك العصيب مراسله","قل هكذا عند الكفاح مراسي",35,"س",2,0],["وإذا يا حضُورُ جِئتُ مقِلاًّ","مِن حيَاءٍ وحِشمَة فَاعذِرُوني",36,"ن",2,0],["وإذا يروم رجوعه عن لحنه","أحدٌ بمصحفه له مستظهر",37,"ر",1,0],["وإذا يُشَارُ إلى الزني","مِ فليسَ تُخْطِيكَ الإشاره",38,"ر",2,0],["وإذا يسأل المُخبِّر عني","لم يجد غير عبرتي من جواب",39,"ب",1,0],["وإذا يقاس به سواه فإنه","طمع لعسرك ماله من موضع",40,"ع",1,0],["وَإِذا يُقَادُ عَلَى الجِنيبَةِ بَلَّهُ","حَتَّى يُحَمَّ مِنَ العِنَانِ المُجنَبُ",41,"ب",1,0],["وإذا يَعبَثُ النسيمُ بشعري","يعَبقُ الطيبُ في الروابي العتاق",42,"ق",1,0],["وِإِذا يُناحُ عَلى اِمرئٍ فَتَعلَّمن","أَنَّ المُغيرَةَ فَوقَ نَوحِ النائِحِ",43,"ح",1,0],["وإِذا يَصولُ بِك ابنُ عَمِّكَ لَم يَصُل","بِمواكِلٍ وَكَلٍ غَداةَ تَجايُحِ",43,"ح",1,0],["وَإذا يَقُولُ الخَصْمُ لَستُ بِقاصِدٍ","تَفويتَهَا قُلنَا لَهُ لاَ تُعْذرُ",44,"ر",1,0],["وَإِذا يَجيءُ مُصَمِّتٌ مِن غارَةٍ","فَيَقولُ قَد آنَستُ هَيجاً فَاِركَبوا",45,"ب",3,0],["وإذا يئستَ فلا تَبُت","تَ اليأسَ وانتظِر الفَرَج",46,"ج",1,0],["وَإِذ أَيقَظتَني وَنَدبت مني","إِلى قَصد الوَرى صَعبَ الإِنابه",47,"ب",2,0],["وإذا يكون الأمر هذا لم يزل","سلكُ القلادَة ثابتاً في جيده",48,"د",2,0],["وإذا يجامعها تعود كما أتت","بكرا بغير دم ولا نقصان",49,"ن",1,0],["وإذا يا هند ما طال البعادُ","ذبتُ وجداً عنكِ أُذادُ",50,"د",1,0],["وإذا يُرى في غربهنَّ نظرتَهُ","نَظراً يصيرُ به شبا البسلاءِ",51,"ا",2,0],["وَإِذا يَحُلُّ بِمَنزِلٍ أَضحى بِهِ","مَأوى الغَريبِ وَمَطمَحُ الأَطماعِ",52,"ع",1,0],["وَإِذا يُناغِي تربَهُ فَكَأَنَّما","نَغَمُ البَلابل هَيَّجَت بلبالا",53,"ل",2,0],["وإذا يمين الدهر راشت أسهماً","فدتك أفئدة لنا وقوادم",54,"م",1,0],["وإذا يعيش يعيش في ندواتهم","متقارضين مديحه برياء",55,"ا",2,0],["وَإِذَا يَا سَعْدُ جَاوَزْتَ النَّقَا","فَاحْبِسْ العِيسَ تَرَى نَهْبَ القُلُوبِ",56,"ب",1,0],["وَإِذا يُقالُ أَتَيتُمُ لَم يَبرَحوا","حَتّى تُقيمَ الخَيلُ سُوقَ طِعانِ",57,"ن",1,0],["وَإِذا يَمَّموا فناء الأَعادي","صاحَ داعيهم الفَناء الفَناءَ",58,"ا",2,0],["واذا يدُ العَلياءِ مُدْ","دَتْ للطِّعانِ وللمكارِمْ",59,"م",1,0],["وإذا يمم لبنان امرؤ","لم يجد إلا وهاداً وإكاما",60,"م",2,0],["وإذا يُضاف ليَ الكريمُ وإن عَلا","شرفاً غدا وهو اللئيم الأوضعُ",61,"ع",1,0],["وإذا يضيء يثير فيَّ فواحشاً","لم يعلمنَّ لها سوائي أكلبُ",62,"ب",1,0],["وإذا يعاتبني بسو","ء قلت اعياني جوابه",63,"ب",2,0],["وإِذا يقال هل امتلأُتمْ","قُلتُمُ هل من مزيد",64,"د",1,0],["وإذا يُعد الاعظمون","نراه فوق الكل وترا",65,"ر",2,0],["وَإِذا يُتَرجِمُ كانَ في تَعقيدِهِ","قَبرٌ بِهِ المَعنى البَريءُ قَتيلُ",66,"ل",1,0],["واِذا يغادرني رأيتَ مدامعي","ترثو رياضاً عاريَ الأغصانِ",67,"ن",1,0],["وإذا يعاتبك الهوى لوِّح له","واضمر له في قعر روحك \"تبَّا\"",68,"ب",2,0],["وإذا يثورُ بجنّةٍ مُخضلّةٍ","زأرتْ بأنفاس اللهيبِ بِطاحُها",69,"ح",3,0],["وإذا يثور لها تخالُ مروجها","غيلاً يهيج على ثراه القسورُ",70,"ر",1,0],["وإذا يالّتي شجاها نشيدي","ومَرَى جفْنها الدموع الغرارا",71,"ر",2,0],["واذا يبي موتي دخيلك تراني !","مثله أبيه ! وعلّني بس ألقاه !",72,"ا",2,0],["وإِذَا يَجِنُّ اللَّيلُ أَشهَدُ نَجمَةً","تَختَالُ فِي زَهوٍ عَلَى قُرَنَائِهَا",73,"ا",3,0],["واذا يركبها صهالة","تحجب الافق من النقع مهارا",74,"ر",2,0],["وإذا يَخْتَنِقُ المرءُ يَرَى","أعذبَ الأنفاسِ في شمِّ الزفيرْ",75,"ر",1,0],["وإذا يذمُّكَ عاقِلٌ في قومِهِ","ضَحِكَ الجميعُ وقيلَ شَخْصٌ أخرَقُ",76,"ق",1,0],["وإذا يقولُ الناسُ قدْ","أخْطَأْتَ لم تفقِدْ صَوابَكْ",77,"ك",1,0],["واذا يقدر يغطي نور شمس الحق يخفيها","تشوف اللي يشيب راس من عاده على حله",78,"ل",2,0],["وإذا يوماًَ رأينا أملاً","ضاع منا كسراب السبْسبِ !",79,"ب",1,0],["واذا يناجزك الخميس بقلبه","انى لقلبك ان يكفّ رماحهُ",80,"ح",2,0],["واذا ي راشد ما همه كلامي ما خسرت اشياك","بدايتها خراب وبالنهايه وش تمناهاا",81,"ا",1,0],["وإذا يجنّ الليل أرقى لهفةً","حيث المساء يسوده الإغواءُ",82,"ا",2,0],["وإذا يشاب مع الطعا","م بمرجلٍ جزل الحطب",83,"ب",1,0],["وإذا يوماً حظينا بالمنى","لا تقل: وحدي، فكلّ الشعب ثارْ",84,"ر",1,0],["وإذا يومٌ عصيبُ الوقعِ أمضته السماءْ","وإذا مادَ الفضاءُ الرحبُ يغشاه البلاءْ",85,"ا",2,0],["وإذا يقوى تناثرت من لفظه","درر تقلدها المعاصم والطلى",86,"ل",2,0],["وإذا يَمَّمَتْ بنانُكَ خَطّاً","مُعْرِباً عن بلاغة ٍ وسدادِ",87,"د",1,1]]}