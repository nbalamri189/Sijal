{"poems":[[55,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[54,"فإذا جالسته صدرته","https://www.aldiwan.net/poem27446.html","الرمل"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[47,"وإذا يإست من الدنو","https://www.aldiwan.net/poem25302.html","مجزوء الكامل"],[91,"يا شاعرا حلو المودة","https://www.aldiwan.net/poem8762.html","عموديه"],[91,"امنحيني يا نجوم الألقا","https://www.aldiwan.net/poem9047.html","عموديه"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[46,"وعظ الزمان فما فهمت عظاته","https://www.aldiwan.net/poem23321.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20992","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[13,"وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180800",""],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""],[126,"يا سائلي عن حصن قريتنا لم","https://www.aldiwan.net/poem50674.html","الطويل"],[130,"هاج إدكارى شادن بدكار","https://www.aldiwan.net/poem54836.html","الكامل"],[141,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[180,"أمنازل الأحباب ما فعل الألى","https://www.aldiwan.net/poem67039.html","الكامل"],[273,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[280,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[340,"يا حبيبي عد الينا","https://www.aldiwan.net/poem55358.html","مجزوء الرمل"],[362,"ماذا يهيج غدوة شجني","https://www.aldiwan.net/poem60626.html","أحذ الكامل"],[362,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[364,"ورأيت أجسام العداة","https://www.aldiwan.net/poem17261.html","مجزوء الكامل"],[369,"ما بال همك لا يزيد","https://www.aldiwan.net/poem57503.html","مجزوء الكامل"],[413,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[459,"شرف الدولة بحر زاخر","https://www.aldiwan.net/poem15129.html","الرمل"],[462,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[462,"أهدى الضنا تذكارها","https://www.aldiwan.net/poem3495.html","عموديه"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[536,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"]],"verses":[["وَإِذا يَمُرُّ بِبابِها","لَثَمَ الجِدارَ وَظَلَّ يُصعَق",0,"ق",1,0],["وَإِذا يُثَوِّبُ صارِخٌ مُتَلَهِّفٌ","وَعَلا غُبارٌ ساطِعٌ بِعِمادِ",1,"د",1,0],["وَإِذا يَلوثُ لُغامَهُ بِسَديسِهِ","ثَنّى فَهَبَّ هِبابَهُ وَتَزَيَّدا",2,"د",2,0],["وَإِذا ياسَرتَهُ صادَفتَهُ","سَلِسَ الخُلقِ سَليمَ الناحِيَه",3,"ي",2,0],["وإذا يخاطبك اللئي","مُ فصُمَّ سمعك عن خطابه",4,"ب",2,0],["وَإِذا يَإِستُ مِنَ الدُنُو","وِ رَغِبتُ في فَرطِ البِعادِ",5,"د",1,1],["وَإِذا يُعابُ عَلى المَشيبِ","فَتى فَمَن ذا لا يُعاب",6,"ب",1,0],["وَإِذا يُتلى لِمُشتاقٍ سَلا","وَإِذا يُروى لِباكٍ صَفَّقا",7,"ق",2,0],["وإذا يسام نفيسَه","والنفس أعطى الكل صاغر",8,"ر",1,0],["وَإِذا يَمَّموا الجِبالَ سُجوداً","فَالمُرادُ الجَلالَةُ الشَمّاءُ",9,"ا",2,0],["وَإِذا يُلاقي نَجدَةً مَعلومَةً","يَصلى الكُماةُ بِحَرِّها لَم يَبلُدِ",10,"د",1,0],["وَإِذا يُهابُ بِهِم إِلى أُكرومَةٍ","نَفَروا وَإِن سيموا الهَوانَ أَشاحوا",11,"ح",3,0],["وَإِذا يَعَضُّ تَشُدُّهُ أَعضائُهُ","عَضَّ الكَبيرِ مِنَ الرِجالِ الأَدرَدِ",12,"د",1,0],["وَإِذا يَدٌ قُطِعَت فَإِنَّ عَشيرَها","لَو حُرِّقَت بِالنارِ لا يَتَأَلَّمُ",13,"م",1,0],["وإذا يَركَبُ رَأساً كَُّهُ","زاعِبيٌّ في رُدَينِيٍّ أَصَم",14,"م",1,0],["وَإِذا يَحزنُ مَن يَرجو المُنى","فَالَّذي اِستَيأَسَ بِالحُزنِ أَحَق",15,"ق",1,0],["وَإذَا يَهْبُّ من الْمَنَامِ رَأَيْتَهُ","كَرُتُوبِ كَعْبِ السَّاقِ لَيْسَ بِزُمَّلِ",16,"ل",1,0],["وإذا يعضّ تشدهُ أعضاؤهُ","، عضّ الكَبيرِ مِنَ الرّجالِ الأدردِ",17,"د",1,0],["وإذا يقولُ رأيتُ حِصناً مثله","بعُمانَ في الترتيب ليس يصيبُ",18,"ب",1,0],["وإذَا يُحَاوِلُ أنّ يَنُوءَ صَدَّهُ","كَفَلٌ كَمركُومِ الكَثِيبِ الهَارِي",19,"ر",2,0],["وَإِذا يُهابُ الخَطبُ عِندَ حُلولِهِ","فَبِهِ لِدَفعِ النائِباتِ يُهابُ",20,"ب",1,0],["وَإِذا يَفوه تَناثَرَت مِن لَفظِهِ","دُرر تَقلّدها المَعاصم وَالطُلَى",21,"ل",2,0],["وَإِذا يَلوذُ بظِلِّهِ الجَبَّارُ لَمْ","تُحْرِقْهُ شُهْبُ رِماحِهِ شَيْطانا",22,"ن",2,0],["وَإِذا يُجادِلُ في العُلومِ بُزاتَها","كانوا بُغاثاً وَهوَ فيهِم أَجدَلُ",23,"ل",1,0],["وَإِذا يُشفّعُ في القيامة عالمٌ","وَيفوز بِالتأريخ فاز مشفّعُ",24,"ع",1,0],["واذا يا صاحبي نحن","ن نيامٌ فوعينا",25,"ن",2,0],["وإذا يَعِزُّ الشَّيْءُ أَطلُبُه","وإذا تركْتُ الشّيْءَ يَطلُبني",26,"ي",1,0],["وإذا يداهُ أسنتا بعَطيّةٍ","نَصرْتُكَ حتّى لم يُبَلْ إن أسنَتا",27,"ت",2,0],["وَإِذا يُباشِرُ عَذلَهُ","فَالسَمعُ أَشرَدُ مِن نَعامِ",28,"م",1,0],["وإذا يُباشرُ حربَهُ","فالرِجلُ أثبتُ من شمامِ",28,"م",1,0],["وإذا يذودُ الناسُ عن","أموالِهم فبِها يذودُ",29,"د",1,0],["وإذا يرنو إلى مشتاقِهِ","سلَّ سيفَ اللّحظ عنواناً وكرّا",30,"ر",2,0],["وإذا يمَّمْتَه في حاجة","زاد في ملقاك إكراماً وبشرا",30,"ر",2,0],["وإذا يُسْألُ مَنْ فارسُها","يومَ تحطيم القنا قِيلَ عُمَرْ",31,"ر",1,0],["وإذا يعدُّ أباهُ في","دين الشجاعة والحزامة",32,"م",2,0],["وإذا يخاف المحلُ","فالملك المعظّم جارها",33,"ر",3,0],["وإذا يكافحك العصيب مراسله","قل هكذا عند الكفاح مراسي",34,"س",2,0],["وإذا يا حضُورُ جِئتُ مقِلاًّ","مِن حيَاءٍ وحِشمَة فَاعذِرُوني",35,"ي",1,0]]}