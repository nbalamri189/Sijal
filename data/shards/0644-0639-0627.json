{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[55,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[39,"وفي اللزبات إذا ما السنون","https://www.aldiwan.net/poem7325.html","المتقارب"],[49,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[53,"لعا من عاثر لك يا ابن يحيى","https://www.aldiwan.net/poem66733.html","الوافر"],[87,"خلقنا للحياة وللممات","https://www.aldiwan.net/poem62917.html","الوافر"],[47,"ترى زعيم الجبال منقينا","https://www.aldiwan.net/poem62646.html","المنسرح"],[47,"أخي متى خاصمت نفسك فاحتشد","https://www.aldiwan.net/poem65209.html","الطويل"],[47,"توعدني شيبان بغيا وما","https://www.aldiwan.net/poem66845.html","البسيط"],[46,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[46,"لا عيش أو يتحامى جسمك الوصب","https://www.aldiwan.net/poem30570.html","البسيط"],[33,"لعائشة ابنة التيمي عندي","https://www.aldiwan.net/poem41260.html","الوافر"],[107,"متى ينهض الشرق من كبوته","https://www.aldiwan.net/poem43416.html","المتقارب"],[42,"يا ويح هذا الطرف ما غمضا","https://www.aldiwan.net/poem42315.html","الطويل"],[48,"لعالم العلو فعل لاخفاء به","https://www.aldiwan.net/poem22828.html","البسيط"],[53,"لعاً من عاثر لك يابنَ يحيى","https://www.poetsgate.com/ViewPoem.aspx?id=30713",""],[33,"لِعَائِشَة َ کبْنَة ِ التَّيْمِي عِنْدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19139&r=&rc=401",""],[147,"كذا في طلاب المجد فليسع من سعى","https://www.aldiwan.net/poem11775.html","الطويل"],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[173,"أبى الدهر أن يلقاك إلا محارباً","https://www.aldiwan.net/poem1599.html",""],[182,"إلا من رحم ربي","https://www.aldiwan.net/poem50699.html","البسيط"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[287,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[331,"لعاصم سماء","https://www.aldiwan.net/poem44238.html","منهوك المنسرح"],[376,"أفردتني وأرى العشاق أقرانا","https://www.aldiwan.net/poem57010.html","البسيط"],[406,"أمام حجرة عائشة رضي الله عنها","https://www.aldiwan.net/poem6772.html","عموديه"],[447,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[463,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[466,"أبر صلاح الدين وابن صلاحه","https://www.aldiwan.net/poem16398.html","الطويل"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[487,"الدهر أعلى بالتنفيس قد سجعت","https://www.aldiwan.net/poem24291.html","البسيط"],[500,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126743","الوافر"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145581","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70725","البسيط"],[984,"","https://poetry.dctabudhabi.ae/diwan/poem/122199","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120111","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59286","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64640","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64572","الطويل"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116687","المتقارب"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93100","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50012","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49916","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49993","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49985","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49922","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49979","البسيط"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45359","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132261","الوافر"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27681","البسيط"],[2679,"","https://poetry.dctabudhabi.ae/diwan/poem/122392","الطويل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128648","الهزج"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100265","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58463","السريع"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107069","الوافر"],[3117,"","https://poetry.dctabudhabi.ae/diwan/poem/29531","الطويل"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203658","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74056","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77186","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143824","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45127","الطويل"],[4250,"","https://poetry.dctabudhabi.ae/diwan/poem/31540","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73109","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117299","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58155","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89585","الطويل"],[4660,"","https://poetry.dctabudhabi.ae/diwan/poem/143984","الطويل"],[4691,"لكن الهوى حصلا !!","https://www.poetsgate.com/ViewPoem.aspx?id=64040",""],[4797,"العام اخذت البيرق","https://www.poetsgate.com/ViewPoem.aspx?id=78478",""],[4578,"لعارضي الشيب من هول النوى وخطا","https://www.poetsgate.com/ViewPoem.aspx?id=49461",""],[4927,"عالية","https://www.poetsgate.com/ViewPoem.aspx?id=30195",""],[4957,"دنياك يَا صَاح دَار دَاره","https://www.poetsgate.com/ViewPoem.aspx?id=190234",""],[5464,"وفي حقول فؤادي أتمَرَ القصب","https://www.poetsgate.com/ViewPoem.aspx?id=21368",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5956,"على بِرْكَةِ الشوقِ","https://www.poetsgate.com/ViewPoem.aspx?id=184979",""],[1793,"لَعائِنُ اللَهِ مُتابَعاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=14816",""],[6068,"لعارضة ذاك القوام -20-","https://www.poetsgate.com/ViewPoem.aspx?id=177500",""],[6156,"أَمَاطَتْ لِثَاماً عَنْ أَقَاحِي الدَّمَائِثِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17593&r=&rc=9",""]],"verses":[["لَعاً لِمُنايَ وَإِن لَم تُصِب","فَما عَثَرَت بِرَجاءِ اللِئامِ",0,"م",1,0],["لَعاً لَكُمُ مِن عاثِرينَ تَتابَعوا","عَلى زَلَلِ الأَقدامِ عَثرَ المُقَيَّدِ",1,"د",1,0],["لَعا وَلَعا لا عَثرَ مِن بَعدِ هَذِهِ","تَلَقّى العُلى وَاِستَأنَفَ العِزَّ أَغيدا",2,"د",2,0],["لعام يقول له المُؤْلِفو","ن هذا المقيم لنا المُرْحِلُ",3,"ل",1,0],["لَعاً يا أَخي لامَسَّكَ السوءُ إِنَّهُ","هُوَ الدَهرُ في حالَيهِ بُؤسٌ وَأَنعُمُ",4,"م",1,0],["لعاقد خنصر المدَّاح يوم ثنا","وموضح الجود فيهم بعد إبهام",5,"م",1,0],["لعاً لعاً لك من عَثْرٍ ألمَّ بنا","في سابحٍ منك طِرفٍ غير عثّار",6,"ر",1,0],["لعاً من عاثر لك يا ابنَ يحيى","يموتُ الكاشحون وأنت تحيا",7,"ي",2,1],["لَعاً لِلنَعشِ لا حُبّاً وَلَكِن","لِأَجلِكِ يا سَماءَ المَكرُماتِ",8,"ت",1,0],["لَعائِنُ اللَهَ وَالرَسولُ عَلى","خاريهِ مِن سِفلَةٍ وَخارِيَتِه",9,"ت",2,0],["لَعاً لَكُمُ مِن عاثِرينَ بِنَكبَةٍ","بَني مَخلَدٍ صَوبَ الغَمامِ المُطَبِّقِ",10,"ق",1,0],["لَعايَنوا المَوتَ أَوِ استَأسَروا","بِالصُغرِ وَالذِلَّةِ أَو دانوا",11,"ن",3,0],["لُعابُ الأَفاعي القاتِلاتِ لُعابُهُ","وَأَريُ الجَنى اِشتارَتهُ أَيدٍ عَواسِلُ",12,"ل",1,0],["لَعاً أَبا جَعفَرٍ وَاِسلَم فَقَد سَلِمَت","بِكَ المروءَةُ واِستَعلى بِكَ الحَسَبُ",13,"ب",1,0],["لِعائِشَةَ اِبنَةَ التَيمِيِّ عِندي","حِمىً في القَلبِ ما يُرعى حِماها",14,"ا",3,1],["لَعاً أَيّها الشرقُ مِن عَثرَةٍ","بِها نَهضَ الغَربُ مِن عَثرتِه",15,"ت",2,0],["لِعاشِقٍ يَبغى بِهِ بَعضَ مَن","أَقصَدَهُ وَالجِسمَ قَد أَحرَضا",16,"ض",2,0],["لَعالَمِ العُلوِ فِعلٌ لاخَفاءَ بِهِ","في عالَمِ الأَرضِ مِن وَحشٍ وَمِن أَنَسِ",17,"س",1,1],["لعاً من عاثر لك يابنَ يحيى","يموتُ الكاشحون وأنت تحيا",18,"ي",2,1],["لِعَائِشَة َ کبْنَة ِ التَّيْمِي عِنْدي","حمى ً في القلبِ، ما يرعى حماها",19,"ا",3,1],["لَعاشَ النَدى مُذ ظَلتَ فينا فَلا رَأَت","لِجَنبِ النَدى عَينٌ مَدى الدَهرِ مَصرَعا",20,"ع",2,0],["لَعاً لَكُم إِن أَنأَ عَنكُم فَإِنَّني","سَأُمحِضُكُم رَأيَ اِمرِئٍ غَيرِ غالِثِ",21,"ث",1,0],["لعايَنَ دوني عُصبَةً عَبدَلِيَّةً","تَسامى فُرادى لِلعُلا وَمُقانِبا",22,"ب",2,0],["\"لُعابُهُم\" هَطِلٌ في سُوْحِ خِسّتهِمْ","كَما القَطيعِ بِمَرْعى الذُّلِّ قَدْ حُشِدوا",23,"د",3,0],["لَعاً لِزَمانٍ عاثِرٍ من جَلالِهِ","بِواقٍ منَ الجُلَّى أُصيبَ بوَاقِمِ",24,"م",1,0],["لُعابُهُ دِرياقُ مَلسوعِ أَف","عى الجَهلِ جارٍ بِالمُنى وَالأَمان",25,"ن",1,0],["لِعاصِمٍ سَماءٌ","عارِضُها تَهتانُ",26,"ن",1,1],["لِعادةٍ من نَدى كفَّيهِ أعرفُها","إذا فَزِعتُ إلى كفَّيهِ أَحيانا",27,"ن",2,0],["لعائشَ فيكَ منزلةٌ ولكنْ","لهنَّ القَدْرُ والحقُّ المُصَانُ",28,"ن",1,0],["لعاذلتي أقول حديث ليلى","علي بكل آونة أعيدي",29,"د",2,0],["لعاذله حقٌّ على من يزوره","لكثرةِ ما يُغريه بالجود عاذلُهْ",30,"ل",2,0],["لِعافٍ وقِرْنٍ في نِزالٍ وأزْمَةٍ","على الجَوْدِ من صَوْبِ الحَيا والمَناصِل",31,"ل",1,0],["لعاً لرماح الخطِّ وهيَ ذوابلٌ","تعثّرُ في ذيلٍ من النقع سابل",32,"ل",1,0],["لعار ما أبرز الرحمن من قلق ال","جهات والوقت والظروف ما علمت",33,"ت",1,0],["لَعَا لا يرعك الهم يا عم إنه","وإن كان مر الحال حلو مصائره",34,"ر",2,0],["لعادَ بهِ قريرَ العين بشراً","وشاهدهُ ومنه القلب سُرّا",35,"ر",2,0],["لعاداكَ أقوامٌ فضرُّوا نفوسَهم","كضرِّ معاداة النَّبيِّ أبا جهلِ",36,"ل",1,1],["لِعادَةٍ يَعرِفُها الجَميعُ","يَذوقُها الوَضيعُ وَالرَّفيعُ",37,"ع",1,0],["لعَّابةً كسهام الشمس جمرتها","أو كنجيع من الأَوداجِ مَهرْوقِ",38,"ق",1,0],["لعاً لك من جواد قد أجادا","ونال الغاية القصوى وزادا",39,"د",2,1],["لعاشق لاج إلى بابكم","منكم وعنكم ليس يمتاز",40,"ز",1,0],["لِعَامِلِ مقلتيكَ عَلَى فُؤَادِي","تَعَادِي العَامِلَيْنِ الْمَاضِيَيْنِ",41,"ن",1,0],["لعاصمة ترفض نبلاً جباهها","وتهفو بها البشرى لعرف وعرفان",42,"ن",1,0],["لعاد وفرعون جرى وثمود","وعذبهم نكر العذاب ودنهمُ",43,"م",1,0],["لَعَادَ بِلاَلٌ إِلى أُمِّهِ","مُقَفَّعَةً ومُخًّا خِبَالا",44,"ل",2,0],["لعاجلني الدى وقضيت نحبي","وما روحت قلبي بارتياح",45,"ح",1,0],["لعَاً لَبني نبهَان من كل عَثْرَة","ولا وجدت في دارِهم زلّة النَّعْلِ",46,"ل",1,0],["لعاً لكَ مما أحْدثته خُطوبُ","ومن نائباتِ الدهرِ حين تَنوبُ",47,"ب",1,1],["لعادته الإحسان قبلَ عداتهِ","ويكفيه حسن الطَّبع أن يتكلّفا",48,"ف",2,0],["لَعاً لبني نبهان من كل عثرةٍ","ولا نال ساداتِ العتيك عُثورُها",49,"ر",3,0],["لعاً لمحمدٍ ولقد أسفْنا","بأنّ محمداً أسفٌ كئيبُ",50,"ب",1,0],["لعاً لكم وانتعاشاً يا أبا عمرا","من عَثرة خلتُ فيها الكلّ قد عَثَرا",51,"ر",2,1],["لعاً لِسُرورٍ لَم يَقُم مِنكُم بِهِ","مُحَييٍّ عَلى طولِ المَدى أَو مُخاطِبُ",52,"ب",1,0],["لعائشة غدَت للعين فرضا","وفرض كفاية عن كل فرض",53,"ض",1,1],["لعالم فاق أهل العصر منزلةٌ","علماً وفضلاً وأفضالاً ومفتخرا",54,"ر",2,0],["لعاد قبح الذي جعلت مظهركم","عندي وفي نظري من أحسن الصورِ",55,"ر",1,0],["لعاينت من قبح المنيّة منظراً","يهالُ لمرآهُ ويرتاع ناظرُ",56,"ر",1,0],["لعالي الجاهِ والقدرِ","ثنائي جلَّ عن حصرِ",57,"ر",1,1],["لعاً لكَ من كابٍ تكعكع عاثراً","بزلة مقدام على الهول عامد",58,"د",1,0],["لِعاملِ المطبخِ داءٌ وإنْ","شككتُمُ فيهِ ابصِروا الحِلْيَه",59,"ه",1,1],["لعار أن نعود وانت كفؤ","كفيل تحمل العبء العباما",60,"م",2,0],["لِعادِيَةٍ مِنَ السِلاحِ اِستَعَرتُها","وَكانَ بِكُم فَقرٌ إِلى الغَدرِ أَو عَدَم",61,"م",1,0],["لعاب الافاعي العاملات لعابه ...","وأرْيُ الجنا اشتارته أيد عواسل",62,"ل",1,0],["لِعادتها الَّتي كانَت كُلَيبٌ","تُذيلُ بِمِثلِها الأُتُنَ الصِعابا",63,"ب",2,0],["لعارض اوقع بعد الوحشه","بينهما وغشذه من غشّه",64,"ه",1,0],["لَعادَ منّي مرؤوبا وَمُلتَئما","ما كانَ مِنّي مَجروحا وَمنصدعا",65,"ع",2,0],["لِعام سِراء الفلك قُلت مؤرخا","فَلاحٌ وَرِبحٌ كُل رِزق السَلامتي",66,"ي",1,0],["لعادة غير ذي ر