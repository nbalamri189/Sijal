الذكرى ذكرتُ عشِيَّةً","زهراءَ بيْن كواعبٍ أترابِ",147,"ب",1,0],["لَو تَهَيّا هَذا وَلا يَتَهَيّا","لَتَهاوَت مِنَ السَماءِ النُجومُ",148,"م",1,0],["لَو تَستَطيعُ نُفوسُهُم فَقَدَت","أَجسادُها وَتَعانَقَت حُبّا",149,"ب",2,0],["لو تَرَى الأَحزَابَ طاروا فِراراً","خِلْتَهُمْ بينَ يديهِ ذبابا",150,"ب",2,0],["لو تستطيعُ ضِياءَهُ لَدَنَتْ لهُ","يَعْشو إلى لَمَعانِهِ لَمَعانُها",151,"ن",3,0],["لو تَتّقُونَ اللّهَ لم يَطمَحْ لها","طَرْفٌ ولم يَشْمَخْ لها عِرْنين",152,"ن",1,0],["لو تَسألونَ القَبرَ يومَ فَرِحْتُمُ","لأجابَ أنّ محمّداً محزون",152,"ن",1,0],["لَوْ تَشْرَئِبُّ لهُ عقيلةُ رَبْرَبٍ","ظَنّتْهُ جُؤذَرَ رَمْلِها المَكحولا",153,"ل",2,0],["لو تأخُذُ الحَسناءُ عنهُ خِصالهَا","ما طالَ بَثُّ مُحِبِّها المفروك",154,"ك",1,0],["لو تلمسونَ الصَّخرَ لانبجستْ بهِ","وتفجَّرَتْ وتدفّقَتْ أنهار",155,"ر",1,0],["لو تراخى اليومُ عنه ساعةً","ملأ الأرضَ طِعاناً وصَفَد",156,"د",1,0],["لَو تَغَنّى وَفوهُ مَلآنُ جَمراً","لَم يَضِرهُ لِبَردِ ذاكَ الغِناءِ",157,"ا",2,0],["لَو تَراني ذَكَرتَ لِلحَسَنِ البَص","رِيِّ في حُسنِ سَمتِهِ أَو قَتادَه",158,"د",2,0],["لَو تَأَمَّلتَني لِتُثبِتَ وَجهي","لَم تَبِن مِن كِتابِ وَجهِيَ حَرفا",159,"ف",2,0],["لَو تَرى الشَربَ حَولَها مِن بَعيدٍ","قُلتَ قَومٌ مِن قِرَّةٍ يَصطَلونا",160,"ن",2,0],["لَو تَستَطيعُ الأَرضُ لَاِنقَبَضَت","حَتّى يَصيرَ جَميعُهُ فيها",161,"ي",3,0],["لَو تَعلَمينَ بِما لَقيتُ بِكُم","لَفَدَيتِني بِالرَحمِ وَالصِهرِ",162,"ر",1,0],["لَو تَرَدّى لَم يَزِد إِخوانُهُ","حينَ يُنعى أَن يَقولوا بَعِدا",163,"د",2,0],["لَو تَجَلَّت غَيابَةُ الهَمِّ عَن قَل","بي إِلى يافِعٍ أَطَعتُ الرَشيدا",164,"د",2,0],["لَوَت حاجَتي عِندَ اللِقاءِ وَأَنكَرَت","مَواعيدَ قَد صامَت بِهِنَّ وَصَلَّتِ",165,"ت",1,0],["لَو تَسمَعينَ وَكُنتِ شاهِدَةً","ما يَقرَأَ الرُهبانُ في الكُتبِ",166,"ب",1,0],["لَو تَعلَمُ الأَرضَ ما أَفعالُ ساكِنِها","لَطالَ مِنها لِما يَأتي بِهِ العَجَبُ",167,"ب",1,0],["لَو تَعقِلُ الأَرضُ وَدَّت أَنَّها صَفِرَت","مِنهُم فَلَم يَرَ فيها ناظِرٌ شَبَحا",168,"ح",2,0],["لَو تَسلَكُ الروحُ في الأَجبالِ عالِمَةً","كَعِلمِنا هَدَمَتها كِثرَةُ الرَعدِ",169,"د",1,0],["لَو تَترُكُ الدُنيا الفَتى وَمرادَهُ","لَوَجَدتَهُ يَشتَطُّ أَو يَختارُ",170,"ر",1,0],["لَو تَحمِلُ الشَربُ الرَواسِيَ أَوهَموا","أَن لَيسَ فَوقَ ظُهورِهِم أَوقارُ",171,"ر",1,0],["لَو تَراءى لِناظِرٍ","بِأَنَّ في وَجهِهِ الكَلَف",172,"ف",1,0],["لَو تَعلَمُ النَحلُ بِمِشتارِها","لَم تَرَها في جَبَلٍ تَعسِلُ",173,"ل",1,0],["لَو تاهَ بَيتُ قَريضٍ وَهوَ مُنتَسِبٌ","في كامِلِ الشِعرِ وافى الوَقصَ أَو خُزِلا",174,"ل",2,0],["لوْ تَقْدِرُ الخَيْلُ التي زايَلْتَها","أنْحَتْ بأيديها على الأعرافِ",175,"ف",1,0],["لو تأتّى لنَطْحِها حَمَلُ الشّهْ","بِ تَرَدّى عن رأسِه الشَّرَطانِ",176,"ن",1,0],["لَو تَستَطِيعونَ أَن تُلقُوا جُلُودَكُمُ","وَتَجعَلُوا جِلدَ عبد اللَهِ سِربالا",177,"ل",2,0],["لو تستطيعُ العُلا جاءَتْك خاضعةً","حتى تُقبِّلَ منكَ الكفَّ والقَدَما",178,"م",2,0],["لو تَرى اينَ خَمِيلاَتُ قُبا","وتَراءَيْنَ جَمِيْلاَتُ القُبَي",179,"ي",1,0],["لو تقدرُ الأنسامُ زفَّتْ لها","أربِعَةَ الفردوسِ في مهرجانْ",180,"ن",1,0],["لو تلفتَّ في دجاها لراعت","كَ خوالي الأبراجِ والهالاتِ",181,"ت",1,0],["لو تلفَّتَّ خلفَ نعشِك يا عد","لي لراعتكَ أمة مسكينه",182,"ن",2,0],["لو تمشَّتْ بمناياها الرجومْ","لاستحال الخلقُ والكونُ سُدى",183,"د",2,0],["لَو تَعلَمينَ بِما أُجِنُّ مِنَ الهَوى","لَعَذَرتِ أَو لَظَلَمتِ إِن لَم تَعذِري",184,"ي",1,0],["لو توبةٌ يَلقاهُمُو","لبُلُوا بَعيراً فوقَ ناضلْ",185,"ل",1,1],["لَوْ تَراني وأَنا أُلْطِفُهُ","وأُدارِيهِ مُدَارَاةَ الصَّبي",186,"ي",1,0],["لَوْ تَدُومْ الأحْيَاءُ مِنْ أَجْلِ فَضْلٍ","دُمْتَ لَكِنْ كُلُّ حَيٍّ يَزُولُ",187,"ل",1,0],["لَوْ تُحَوَّلُ الدُّمُوعُ شِعْراً لَمَا جَا","رَى قَوَافِيَّ فِيهِ صَوْبُ العِهَادِ",188,"د",1,0],["لَوْ تَجَلَّتْ صِفَاتُهُ لِعُيونِ النَّاسِ","كَانَتْ مِنَ الْفَرَائِد عَقْدَا",189,"د",2,0],["لَو تفكّرت رَأَتِ الر","رشدَ في تَفَكُّرِها",190,"ر",3,0],["لَو تَلَبَّثتَ أَربَعاً أَو ثَلاثاً","قامَ مِن عَرشِهِ لَكَ القَمقامُ",191,"م",1,0],["لَو تَراخى المَوتُ عَنهُ قَليلاً","لَعَلا فَوقَ العَليمِ العَليِّ",192,"ي",1,0],["لَو تَرى الغيمَ وَقَد أَسعَدَني","بِالبُكا ساعَةَ أَودى فَوَدَق",193,"ق",1,0],["لَو تَمادَت مُدَّةُ اِبنِيَ لَم","يَتَجاوَز حَدَّهُ أَحَدُ",194,"د",1,0],["لو تَسْتطيعُ الباسقاتُ بأرضه","سَعْياً لجاءت نحو بابِكَ تشكُر",195,"ر",1,0],["لوتِ الدهرَ على باطله","وهي كالحقِّ صَفاةٌ لا تلين",196,"ن",1,0],["لو تلا هؤلاء شعرَكَ، قالوا:","إن سلطاننا أبو سلطان!",197,"ن",1,0],["لو ترى غادة الكنانة في الجوِّ","لأنستك غادة اليابان",198,"ن",1,0],["لو تسألون أبا البَرايا آدمًا:","هل من سلالِتكَ اليهودُ؟ لأَنْكَرا",199,"ر",2,0],["لو تنطقُ الأفلاكُ، قا","لتْ: تلك نادِرَةُ النوادر",200,"ر",1,0],["لو تَرى ما يَخْطُّ محْراثُه في","أرضه، قلتَ: آيةٌ في النَّجَابة",201,"ب",2,0],["لو ترانا واللّيلُ في عُنفوانٍ","قُلت سِرَّينِ في فؤاد الدَّياجِ",202,"ج",1,0],["لو تحوّلتُ فرخةَ ثعلبوني","لو تضفدعت خبّروا عن نقيقي",203,"ق",2,0],["لو تَراها عجبتَ ان لا يَهُزَّ الشرخُ","قلباً او يُضحِكَ الزهوُ سِنا",204,"ن",2,0],["لو تخيرتُ لي الهاً لما ألَّهْتُ","إلاّ من هيكل الأم بطنا",204,"ن",2,0],["لو تشترى بالروح","أيام الصبا قل الثمن",205,"ن",1,0],["لو تأذنون سألتُهُ عن خاطرٍ","مُبْكٍ يَهُزُّ فؤادَ كلِّ مَروع",206,"ع",1,0],["لو تحولْتَ عن مجاريك أو حُلت","لما جئتَ بالنكير الفري",207,"ي",1,0],["لو تستطيع دنت إليك مُدّلةًً","فتزودت من رُدنك الأردان",208,"ن",1,0],["لو تكون النجوم بُرداً وتاجاً","لكسيناكَهُنّ عِطفاً ورأسا",209,"س",2,0],["لوتُحسيِّنَ ما أحسُّ إذا رجَّفْتِ","في الرَّقص بطنَك الخمصانه",210,"ن",2,0],["لَو تَراهُ مجّبِياً","خلتهُ عقدَ قنطرهُ",211,"ر",2,0],["لَوْ تُوَفّي مَا لَنَا في صاعِدٍ،","لَصَعِدنا، مِنْ عُلُوٍّ، في الأُفُقْ",212,"ق",1,0],["لو تعقل الأجناد أنّ ملوكها","أعداؤها انقلبت على التيجان",213,"ن",1,0],["لوّ تعدل الدنيا لم ينتثر","شمل نظمناه ولم نتفرّق",214,"ق",1,0],["لو تعدَّاكُم لأَعْيا","ما تأنَّى أو لَشَقَّا",215,"ق",2,0],["لو تحلت بالحريرِ لآنسربت","من خَلَل النسج غير محتبسَهْ",216,"س",2,0],["لو تكون الجبالُ مالاً أو البح","رُ لغاداهما بنسفٍ ونزف",217,"ف",1,0],["لو تأمّلتها لراعك منها","عرَّة البرِّ في سوادِ الحداد",218,"د",1,0]]}