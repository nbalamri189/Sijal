راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[46,"كل على مكروهه مسبل","https://www.aldiwan.net/poem23150.html","السريع"],[46,"سقيا لشوهاء ما همت بفاحشة","https://www.aldiwan.net/poem23162.html","البسيط"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[76,"نفسي فداؤك والأبطال واقفة","https://www.aldiwan.net/poem39001.html","البسيط"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39600","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8240","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72246","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30441","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[106,"سلطان العاشقين أبو سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=179375",""],[106,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[77,"يا سراج الجمالِ يا بن سِراج","https://www.poetsgate.com/ViewPoem.aspx?id=33799",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[54,"يا أَبا سعدِ قَوصَرَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=14293",""],[45,"قُلْتُ للاّئِمِ في الجُبّ أفِقْ","https://www.poetsgate.com/ViewPoem.aspx?id=32850",""],[91,"معركة بورغاس","https://www.poetsgate.com/ViewPoem.aspx?id=53308",""],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[51,"لا تَشِم للمزنِ برقا","https://www.poetsgate.com/ViewPoem.aspx?id=29919",""],[51,"خِوانُ عيسى من نصف ترمسة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29365",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[85,"كلُّ حيٍّ على المنية غادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9597&r=&rc=87",""]],"verses":[["لَو تَراخَت تِلكَ الرِياحُ لَأَرسَل","تُ رِياحَ الزَفيرِ وَالإِرنانِ",0,"ن",1,0],["لَو تَحفِلونَ بِزَفرَةٍ مِن واجِدٍ","أَو تَسمَعونَ لِأَنَّةٍ مِن ذاكِرِ",1,"ر",1,0],["لَو تَعلَمُ الأَفلاكُ أَنَّكَ والِدي","لَم تَرضَ أَنّي لِلسَماءِ مُصاهِرُ",2,"ر",1,0],["لَو تَسأَلونَ دَمي سَمَحتُ بِهِ","مِن غَيرِ مَعصِيَةٍ وَلا رَدِّ",3,"د",1,0],["لَوَتْ طَرَفَيْ حَبْلي عَنِ الذُّلِّ هِمَّةٌ","لَها بِمَناطِ الشِّعْرَيَيْنِ ثَواءُ",4,"ا",2,0],["لو تَستَطيعُ لَوَتْ شَوقاً أخادِعَها","إليكَ ثمّ إليه الأعْصُرُ الأُوَلُ",5,"ل",1,0],["لَو تَسمَعُ الطَيرُ ما نَشكو عَكَفنَ بِنا","كَما عَكَفنَ بِداوُدَ الَّذي فُتِنا",6,"ن",2,0],["لَو تَراني يا هاشِمُ بنَ سُلَيما","نَ وَما بي بَكَيتَ حينَ تَراني",7,"ي",1,0],["لَو تَمَنَيتُ ما بَلغَتُ ظَلوماً","قَصَّرَت عَنكِ يا ظَلومُ الأَماني",7,"ي",1,0],["لوْ تَراني واللّيلُ في عُنْفُوانٍ","قُلْتُ سِرَّيْنِ في فؤادِ الدّياجي",8,"ي",1,0],["لَو تَرَيَّثتَ لَاِستَطالَ بِكَ الني","لُ عَلى هَذِهِ الخُطوبِ التَوالي",9,"ل",2,0],["لَو تُفتَدى بِحَياتي","مِنَ الرَدى لَفَدَيتُ",10,"ت",1,0],["لَو تَنظُرينَ إِلَيهِ في جَوفِ الدُجى","مُتَمَلمِلاً مِن هَولِ ما يَتَجَشَّمُ",11,"م",1,0],["لَو تَراني وَقَد تَعَمَّدتَ قَتلي","بِالتَنائي رَأَيتَ شَيخاً حَريبا",12,"ب",2,0],["لَو تُرِكنا بِأَن نَعودَكَ عُدنا","وَقَضَينا الَّذي عَلَينا وَزِدنا",13,"ن",2,1],["لَو تُرسَلُ الإِبلُ الظِما","ءُ يَسُمنَ لَيسَ لَهُنَّ قائِد",14,"د",1,0],["لُوْ تَصِّحُ النُّقُودُ حُلْيَ صُدُورٍ","لَمْ يَدَعْ حَمْلَ مَا مُنْحِتُ نَبِيْ",15,"ي",1,0],["لَوْ تَجْتَلِي عَيْنٌ مَعَانِي مَجْدِهِ","لَرَأَتْ رِعَاناً تُوِّجَتْ بِرِعَانِ",16,"ن",1,0],["لَوْ تَسَنَّى فِي مَكَانٍ وَاحِدٍ","جَمْعُهُمْ أَلْفَيْتِهِمْ مُجْتَمِعِينْ",17,"ن",1,0],["لَوْ تَجَلَّى إِبَاءُ لُبْنَ","انَ فِي شَخْصِهِ ارْتَسَمْ",18,"م",1,0],["لَوْ تَسْتَجِيرُ وَأَنْتَ أَطْهَرُ شِيمَةً","لَمَشَيْتَ يَا مَوْلايَ فَوْقَ الهَامِ",19,"م",1,0],["لو تروا حب ما اجمل","السبدور من يخجل",20,"ل",1,1],["لو تَمَّ في فلك الثريّا سعدها","لم تُمنَ بالعَيوق والدَّبَران",21,"ن",1,0],["لَو تَعلَمينَ الَّذي نَلقى أَوَيتِ لَنا","أَو تَسمَعينَ إِلى ذي العَرشِ شَكوانا",22,"ن",2,0],["لَو تَعلَمينَ عَلِمتِ هَمّاً داخِلاً","هَمّاً طَوارِقُهُ مَنَعنَ المَرقَدا",23,"د",2,0],["لَو تَنسِبونَ لِيُربوعٍ فَتَعرِفَكُم","أَو مالِكٍ أَو عُبَيدٍ جَدِّ نَزّالِ",24,"ل",1,0],["لَو تَشكُرُ الحَسَناتِ تَيمٌ لَم تَعِب","تَيمٌ فَوارِسَ قَعنَبٍ وَخِزامِ",25,"م",1,0],["لَو تَراني إِذا اِستَهَلَّت دُموعي","في صَبوحٍ ذَكَرتُهُ أَو غَبوقِ",26,"ق",1,0],["لو تصدَّى عبد الحميد لعليا","كَ لَلَجَّتْ أسبابها في الصعود",27,"د",1,0],["لو تفاخرت وابن شكر بمعنى","جامع زدت في المعاني اغْتباطه",28,"ط",2,0],["لو تنطق الشهباء قالَ مقامها","قل يا محمد كلّ فخر يسمع",29,"ع",1,0],["لو تسأل البدر أنبا عن سناه بلا","تكلُّفٍ وتجلى باسمه الحلك",30,"ك",1,0],["لو تسأل الشهب عن علياء أسرته","ألفيته جازَ عنها منذ أزمانِ",31,"ن",1,0],["لو تكونُ القلوبُ مأوى طعامٍ","نازَعتْهُ قلوبُنا الأحشاءَ",32,"ا",2,0],["لو تلفَّفتَ في كساءِ الكسائي","وتلبَّستَ فروة الفرَّاءِ",33,"ا",2,1],["لو تَرى القومَ بينهنّ لأجبر","تَ صُراحاً ولم تقلْ باكتسابِ",34,"ب",1,0],["لوْ تراهُ إذا دعا","يا مليكاً مُحجّبا",35,"ب",2,0],["لو تراني وفي يدي قدحُ الدو","شاب أبصرتَ بَازيارَ غُرابِ",36,"ب",1,0],["لو تَراهم قلتَ آسادُ الشّرى","أو سُيُوفٌ حُسِرتْ عنها الغُمودُ",37,"د",1,0],["لو تراه وهو منتصب","مُشْعِرٌ أجفانَه السُّهُدا",38,"د",2,0],["لو تشرب الأرض الدماء لطيبها","شربتْ فَصيدك أمسِ أرضُ العسكر",39,"ر",1,0],["لو تخفّفتَ بالقيادة ما اسطع","ت لكنت الثقيل يا تلّ محرى",40,"ر",2,0],["لو ترى الشيخ وقد أب","ركها مثل الدّوار",41,"ر",1,0],["لو تراهُ خلفَ السّنان يُهاوي","هِ لأبصرْتَ ماضياً خلف ماضي",42,"ض",2,0],["لو تمسَّحتَ بالحطيم لحاضتْ","كعبةُ اللَّهِ من مخازيك حَيْضا",43,"ض",2,0],["لو تُسامي بمجدكَ البدرَ والشم","سَ إذاً أوْطآكَ خدَّيْ خُضوعِ",44,"ع",1,0],["لو تراهم إذا همُ","خطروا بالأصابع",45,"ع",1,0],["لو تسوَّغت في الحلوق بشهدٍ","أو رحيق مشعشع لم تسوغي",46,"غ",2,0],["لو تراه ثانياً من عطفه","مائلاً في السرج من فرط الصلف",47,"ف",1,0],["لو تعدّاكم لأعيا","ما تأتّى أو لشقّا",48,"ق",2,0],["لو تكون المحق كنت محباً","لامرئ لم يزل يعز المحقا",49,"ق",2,0],["لو ترانا في بطن إسناية الني","ل لأبصرت هارباً مرهوقا",50,"ق",2,0],["لو تراها وقد تسامت ذراها","خلت أمواجها جِمالاً ونوقا",50,"ق",2,0],["لو تستطيع تسلَّبت من طوقها","لو كان منتحلاً من الأطواق",51,"ق",1,0],["لو تسجُدُ الأيام ما سجدَتْ","إلا ليومٍ فتَّ في عضُدك",52,"ك",1,0],["لو تُسمَّونَ بالذي تستحقُّو","ن خُصصتم بأحرف التثقيلِ",53,"ل",1,0],["لو تُجاريك في مكارمك الري","حُ لخِيلت معقولةً بعقالِ",54,"ل",1,0],["لو تدلّى إليه حبلٌ من اللَّ","هِ رآه حبلاً من الأحبالِ",55,"ل",1,0],["لو تجاريك في مكارمك الري","ح لخيلت مشكولةً بشكالِ",55,"ل",1,0],["لو تمَّ ما قدّروه","لجُبَّ كلُّ سَنَامِ",56,"م",1,0],["لو تجافى الخصيمُ عنه وأغضى","لكفاهُ بنفسه من خصيمِ",57,"م",1,0],["لو تبعتَ الأُلى مضوْا من شهيد","ووئيدٍ إلى جنان النعيمِ",58,"م",1,0],["لو تراءى لجنَّة الخلد صَبَّتْ","واشرأبت بجيدها الحُسَّانِ",59,"ن",1,0],["لو تُسلَّى به حديثَةُ رُزءٍ","لشفى داءَ صدرها الحَرَّان",59,"ن",1,0],["لَو تَشائينَ كُنتِ أَرفَهَ حالاً","أَوَ لَستِ قَديرَةً أَن تَشائي",60,"ا",2,0],["لَو تُفيدُ الدُموعُ شَيئاً لَأَحيَت","كُلِّ عافٍ مَدامِعُ الشُعَراءِ",60,"ا",2,0],["لَو تَكونُ الذُيولُ أَعمارَ قَومٍ","لَضَمِنّا لَهُم نَوالَ الخُلودِ",61,"د",1,0],["لَو تَنظُرينَ إِلَيَّ كَالمَي","تِ المُسَجّى في سَريري",62,"ر",2,0],["لَو تَعدِلُ الدُنيا بِنا لَم يَنتَثِر","شَملٌ نَظَمناهُ وَلَم نَتَفَرَّقِ",63,"ق",1,0],["لَو تَنظُرينَ إِلى قَتيلِكِ في الدُجى","يَرعى كَواكِبَهُ وَيَستَرعيكِ",64,"ك",1,0],["لو تُجاري الريح في المجْ","دِ لَخِيلَتْ ذاتَ قَيْدِ",65,"د",1,0],["لَو تَعرِفُ الشَمسُ ما لِلهَوى لَم","تَبِن لِطَرفٍ مِنَ السَقامِ",66,"م",1,0],["لَو تَعشَقُ البَيداءُ أَصبَحَ رَملُها","زَهراً وَصارَ سَرابُها الخَدّاعُ ما",67,"م",2,0],["لَو تَعقِلُ الأَجنادُ أَنَّ مُلوكَها","أَعدائُها اِنقَلَبَت عَلى التيجانِ",68,"ن",1,0],["لَو تَعقِلونَ عَمِلتُمُ لِخَلاصِكُم","مِن دَولَةِ القَيناتِ وَالخِصيانِ",69,"ن",1,0],["لَو تَسمَعانِ نَجِيَّهَا مُتَمَشِياً","كَالسِحرِ في الأَرواحِ يَستَهويها",70,"ي",3,0],["لَو تَكونُ الروحُ ما لا يَضمَحِل","جَزِعنا كُلَّما جِسمٌ هَمَد",71,"د",1,0],["لَو تَكونُ الروحُ جِسماً مُستَقِل","لَرَآها مَن يَرى هَذا الجَسَد",71,"د",1,0],["لَو تَراني وَحَبيبي عِندَما","فَرَّ مِثلَ الظَبيِ مِن بَينِ يَدَيَّ",72,"ي",1,1],["لَو تُشرِفونَ رَأَيتُمُ","مِن مِصرَ نيرانَ اِشتِياقي",73,"ي",1,0],["لو تبصرون وقوفى في منازلكم","رأيتم طللا يبكى على طلل",74,"ل",1,0],["لو تسترت كنت كالقبة الغرا","ء ذيلا من الجلال وردنا",75,"ن",2,0],["لو ترى كيف أستهلت أدمعي","لا رأت أمك يوما أدمعك",76,"ك",1,0],["لو تقدرين على الحياة وردّها","قلنا عليك الرد والإحياء",77,"ا",2,0],["لو تسأل الأرض عنه كيف تحمله","لقالت الأ