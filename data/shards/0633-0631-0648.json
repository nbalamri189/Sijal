oetry.dctabudhabi.ae/diwan/poem/205691","الهزج"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117992","المتقارب"],[3796,"","https://poetry.dctabudhabi.ae/diwan/poem/124124","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114311","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76500","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70155","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70128","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77153","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111062","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199066","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107293","الخفيف"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78311","الوافر"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21531","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90853","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54457","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94401","الطويل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103309","المتقارب"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135105","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73283","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73207","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136468",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136677",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28745","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117239","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133113","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133098","الطويل"],[4449,"","https://poetry.dctabudhabi.ae/diwan/poem/143720","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33166","المتقارب"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89595","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72788","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72518","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120360","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"],[4767,"الفرحة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=91838",""],[4767,"فؤادي (ابني فؤاد)","https://www.poetsgate.com/ViewPoem.aspx?id=129783",""],[4858,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=30460",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[4119,"إني لأغنى الناس عن عصبية","https://www.poetsgate.com/ViewPoem.aspx?id=16088",""],[5057,"لماذا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184013",""],[5116,"وماذا عليهم لو أقاموا فسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=181369",""],[5121,"اللَّحْنُ الجَرِيحْ","https://www.poetsgate.com/ViewPoem.aspx?id=33509",""],[5191,"حَوَتْ كلّي","https://www.poetsgate.com/ViewPoem.aspx?id=214053",""],[5353,"بردة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=212465",""],[5409,"دم ذاكراً فيك يا شعبان من وثبوا","https://www.poetsgate.com/ViewPoem.aspx?id=155253",""],[5442,"نوى ولو أن الفعل وافق ما نوى","https://www.poetsgate.com/ViewPoem.aspx?id=114765",""],[5444,"نجومُ الأحساء","https://www.poetsgate.com/ViewPoem.aspx?id=205512",""],[5690,"رأى نظري ربوعهم فما لا","https://www.poetsgate.com/ViewPoem.aspx?id=172171",""],[5809,"سرور","https://www.poetsgate.com/ViewPoem.aspx?id=205326",""],[5894,"ساقت جيوش التيه نحو أساسي","https://www.poetsgate.com/ViewPoem.aspx?id=131421",""],[5938,"ثمانية قام الوجود بها فهل","https://www.poetsgate.com/ViewPoem.aspx?id=181423",""],[6068,"إذا ذكر الأحباب آضت تهزّني -24-","https://www.poetsgate.com/ViewPoem.aspx?id=175862",""],[6171,"لا فِتَةٌ عَلى بَوابةِ العَام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84672&r=&rc=2",""],[6223,"يا حادي الركب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1210&r=&rc=7",""]],"verses":[["سَرَوا وَخُيولُ اللَيلِ دُهمٌ وَعَرَّسوا","وَقَد غادَروها في طِرادِ الضُحى شُهبا",0,"ب",2,0],["سَرَوْا وفُضولُ الرَّيْطِ تَضْرِبُها الصَّبا","إِلى أنْ يَمَسَّ الأرضَ منهُنَّ رَفْرَفُ",1,"ف",1,0],["سَرَوْا فأناخوها لَدَيْكَ لَواغِباً","يَشِمْنَ بُروقاً وَدْقُها لا يُرَيَّثُ",2,"ث",1,0],["سُرورُ الغِنى مالَم يَكُن مِنكَ حَسرَةٌ","وَأَريُ المُنى مالَم تُنَل بِكَ صابُ",3,"ب",1,0],["سَروٌ تَزاحَمُ في نَظمِ المَديحِ لَهُ","مَحاسِنُ الشِعرِ حَتّى بَينَها قُرَعُ",4,"ع",1,0],["سَرَوا حَتّى كَأَنَّهُمُ تَساقَوا","عَلى راحاتِهِم جُرَعَ المُدامِ",5,"م",1,0],["سروات مصر في العلا","ء لهم على السروات ميزه",6,"ز",2,0],["سُرَّ وَقالَ هاتِ قُلتُ مَهلا","اِحلِف عَلى الرَدِّ فَقالَ كَلّا",7,"ل",2,0],["سَرَوا وَاللَيلُ يَجمَعُنا وَلَكِن","يَبوحُ بِهِم وَيَكتُمُنا الظَلامُ",8,"م",1,0],["سُروري عِندَهُ لُمَعٌ","وَدَهرِيَ كُلَّهُ أَسَفُ",9,"ف",1,0],["سروراً بإقبالِ الزمانِ وحبَّذا","سرورُ زمانٍ محكمات سعوده",10,"د",2,0],["سرَوْ للشآم وغرب الجفون","تفطر منا بنار الهموم",11,"م",1,1],["سُرورُهُ في بُكاءِ الأَكثَرينَ لَهُ","وَحُزنُهُ أَن تَرى عَيناهُ جَذلانا",12,"ن",2,0],["سُروري كانَ أَن أَلقاكَ يَوماً","لِأَجلِ مَحاسِنٍ لَكَ أَجتَليها",13,"ي",3,1],["سَرَّ وَاللَهِ ناظِري","ما أَرى فيهِ وَاِشتَفى",14,"ف",2,0],["سُرورِيَ أَن يَبدو عَليهِم تَنَعُّمٌ","وَحُزنِيَ أَن يَبدو عَلَيهِم تَقَشُّفُ",15,"ف",1,0],["سُرورِيَ أَن تَبقى بِخَيرٍ وَنِعمَةٍ","وَإِنّي مِنَ الدُنيا بِذَلِكَ قانِعُ",16,"ع",1,0],["سُرورُنا بَعدَكُم ناقِصُ","وَالعَيشُ لا صافٍ وَلا خالِصُ",17,"ص",1,1],["سِر وآسر في طول البلاد وعرضها","إن الأهلة دأبها الأسفار",18,"ر",1,0],["سُرورُكَ أَن تَسُرُّ الناسَ طُرّاً","تُعَلِّمُهُم عَلَيكَ بِهِ الدَلالا",19,"ل",2,0],["سرَوا يطردون الليلَ عن متبلِّجٍ","من الصبحِ يهدي الناظرَ المتوسّما",20,"م",2,0],["سُرورُ المَوالي بِقَمرٍ عَلَيهِ","أُديلَ أَخيراً بِشاهٍ وَرُخ",21,"خ",1,0],["سِرٌ وَإِعلانٌ تُسَوّى مِنهُما","نَفسٌ تُضيءُ وَهِمَّةٌ تَتَوَقَّدُ",22,"د",1,0],["سَرَوا موجِفينَ لِسَعيِ الصَفا","وَرَميِ الجِمارِ وَمَسحِ الحَجَر",23,"ر",1,0],["سَرَوا يَخبِطونَ اللَيلَ وَهيَ تَلُفُّهُم","عَلى شُعَبِ الأَكوارِ مِن كُلِّ جانِبِ",24,"ب",1,0],["سَرَوا يَركَبونَ اللَيلَ حَتّى تَفَرَّجَت","دُجاهُ لَهُم عَن واضِحٍ غَيرِ خامِلِ",25,"ل",1,0],["سرّ وراء الظنون","أظلِّني وأضاء",26,"ا",2,0],["سرَوا بالمَها وهناً ومن ورقِ الظُّبَا","كناسٌ عَلَيها حُفَّ بالقَصَبِ المُلْدِ",27,"د",1,0],["سِر وادِعاً لا تَستَطِر قَلباً هَفا","بِجَناحِ شَوقٍ رِشتَهُ خَفّاقِ",28,"ق",1,0],["سُروراً بِهِ عَن فَتى دَولَةٍ","تُباهي بِعَلياهُ خَيرَ الدُوَل",29,"ل",1,0],["سَروا ثُمَّ حَطّوا عَن قُلاصٍ خَوامِسٍ","كَما عَطَلَ الرامي القَسِيَّ الحَوانِيا",30,"ي",2,0],["سَروقاً لِما لاقى طَروباً إِلى الزُبى","وَهَل تَجِدُ الزِنجِيَّ غَيرَ طَروبِ",31,"ب",1,0],["سِرْ وَفَوَّضْتُ لِلْمُهَيمِنِ أَمْري","سِرْ وَإِيَّاهُ أَسْأَلُ التَّدْبِيرَا",32,"ر",2,0],["سِرْ وَكَافِحْ وَاسْفِكْ بِغَيْرِ جُنَاحٍ","مِن دَمِ المُعْتَدِي دَماً مَهْدُورَا",32,"ر",2,0],["سُرُورُهُ الْيَوْمَ أَضْعَافُ السُّرُورِ بِمَا","أَوْلاَهُ مِنْ مَنْصِبٍ عَالٍ وَمِنْ حَسَبِ",33,"ب",1,0],["سروا يخبطون الليل عميا تلفهم","شمائل من أهوائهم ودبور",34,"ر",1,0],["سر واثقاً بجهاد شعبٍ طامحٍ","ولقد يسرُّكَ أن تراه طامحا",35,"ح",2,0],["سروا بطريق المصطفى وبنوره","ازالوا دجى الاوهام والشك والغيا",36,"ي",2,0],["سروا وناؤوا والدهر اقصى مقرهم","وقد ضربوا تلك الخيام بمهجتي",37,"ي",1,0],["سروا ولكن فوأدي عنوة اسروا","وخلفوني ولي ندب وصيحات",38,"ت",1,0],["سرور عم حتى ما عرفنا","مهني العالمين من المهنا",39,"ن",2,1],["سرورٌ ولذاتٌ صَفَتْ من كبائرٍ","نَهتْها النُّهى عن قرْبِنا والشَّرائع",40,"ع",1,0],["سِرٌّ ولولا شُحُّ أَلْسُنِنا به","رَقَصت به طَرَبا لها كثبان",41,"ن",1,0],["سروري بالسلامة من أمور","تورطها المغفل والبليد",42,"د",1,0],["سُرورُهُ بعدَكُمُ تَرْحَةٌ","وصُبْحُهُ بعدكمُ غَيْهَبُ",43,"ب",1,0],["سروري أن تدوم لك الليالي","بما تهوى كأني عنك راضِ",44,"ض",1,0],["سروري فلا تُنكِر هواي فتُبتَلى","ببعض الذي قد ذُقتُ من ألم الشَّغَف",45,"ف",1,0],["سرور أزاح الهمّ والغمّ مذ بدا","ونور جلا الظلماء حتى توقدا",46,"د",2,1],["سُروري أَنتَ في الدنيا فَيَومٌ","تَغيبُ جَميعُ لذاتي تَغيبُ",47,"ب",1,0],["سَروا مَعَ اللَيلِ يُغنيهم تَهلُّلهم","عَن ضَوءِ 