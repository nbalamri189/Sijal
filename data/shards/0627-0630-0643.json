ر ونار الحرب تستعر","https://www.aldiwan.net/poem43164.html","البسيط"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[105,"صاحب السيفين ماذا صنعا","https://www.aldiwan.net/poem44212.html","الرمل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[67,"الصبح بدا من طلعته","https://www.aldiwan.net/poem18129.html","المتدارك"],[48,"وفتية نازعوا والليل معتكر","https://www.aldiwan.net/poem62503.html","البسيط"],[48,"منحت طرفي الأرض خوفا لأن","https://www.aldiwan.net/poem66101.html","المنسرح"],[50,"يا فرخ نهيا بإفك قلت أو زور","https://www.aldiwan.net/poem63807.html","البسيط"],[50,"أذكرت نفسي عشية الأحد","https://www.aldiwan.net/poem63909.html","المنسرح"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[46,"اذكر إلهك إن هببت من الكرى","https://www.aldiwan.net/poem22491.html","الكامل"],[46,"إذا ما الأصل ألفي غير زاك","https://www.aldiwan.net/poem22947.html","الوافر"],[15,"بان الخليط الؤولى شاقوك إذ شحطوا","https://www.aldiwan.net/poem45261.html","البسيط"],[76,"يا ابن الخلائف والعلا للمعتلي","https://www.aldiwan.net/poem39020.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85438","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85655","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85464","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140823",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8332","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19289","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42712","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54672","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[45,"إنْ تَرْجُ طُولَ عُبَيدِالله لا تَخِبِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31530",""],[45,"ما للكبير في الغواني من أرب","https://www.poetsgate.com/ViewPoem.aspx?id=31558",""],[91,"عصر الشبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=53194",""],[51,"إني لأغضي عن الزلات أثبِتُها","https://www.poetsgate.com/ViewPoem.aspx?id=30737",""],[89,"أوَ هل يعود إلى العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=55711",""],[88,"برزت تميس كخطرة النشوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19539&r=&rc=42",""]],"verses":[["أَذكَرَتهُ أَيّامُ هَذا التَنائي","ما مَضى مِن أَيّامِ ذاكَ التَداني",0,"ن",2,0],["إِذكُرونا يَومَ ذي قارٍ وَقَد","أَقبَلوهُ عارِضَ الطَعنِ بَرَد",1,"د",1,0],["أذْكى بقَلبي لوعَةً إذ أوْمَضا","بَرْقٌ أضاءَ وميضُهُ ذاتَ الأضا",2,"ض",2,1],["أُذكُري مَن لَيسَ يَنسا","كِ وَلَو لاقى الحِماما",3,"م",2,0],["أذْكى شُعاعَ الشّمْسِ نارُ قِرانِهِ","وهُوَ الذي رُصِدَتْ لهُ أدْوارُهُ",4,"ر",2,0],["أُذْكِي بِهِ زَنْدَ الْقِرَاءَةِ وَالْقِرَى","رَحْبُ الْجنَابِ لِطَارقٍ أَوْ طَالِبِ",5,"ب",1,0],["اُذكُري المَوتَ لَدى النَومِ وَلا","تُغفِلي ذِكرَتَهُ عِندَ الهُبوبِ",6,"ب",1,0],["أَذكَرتَني وادي دِمَشقَ وَظِلَّهُ ال","ضافي عَلى صافي البَرودِ السَلسَلِ",7,"ل",1,0],["أَذَكَرتَني سالِفَ العَيشِ الَّذي طابا","يا لَيتَ غائِبَ ذاكَ العَهدِ قَد آبا",8,"ب",2,1],["اِذكُر سَعيداً بِخِلاَّتٍ سَبَقنَ لَهُ","ميراثُ والدِهِ وَالعِرقُ مُنتَسِبُ",9,"ب",1,1],["أَذْكَرْتَ مَجْداً لَمْ تَزَلْ","تَحْدُو بِهِ السِّيَرُ الرِّكَابَا",10,"ب",2,0],["أَذْكَرْتَنِي غَيْرَ نَاسٍ","يَوْمَ الفَتَاةِ اللَّعُوبِ",11,"ب",1,0],["إِذْ كَانَ سَعْدُ سُعُودِهَا فِي أَوْجِهِ","وَلِمُقْتَفِيهِ تَأَلُّقٌ يُسْتَامُ",12,"م",1,0],["إِذْ كُنتُ أَشْهَدُ وِرْدَهُنَّ وَرُبَّمَا","جَارَيْتُهُنَّ وَلَمْ أعُجْ بِمَلامِ",13,"م",1,0],["اِذكُر أَبا جَعفَرٍ حَقّاً أَمُتُّ بِهِ","أَنى وَإِيّاكَ مَشغوفانِ بِالأَدَبِ",14,"ب",1,1],["أذكيت فيه شعلَةَ من نصلهِ","يهدي بها إن ضلَّ عنه المقتلُ",15,"ل",1,0],["أذكرتني العهد القديم ومعهداً","كانت شموسُ الراح فيه تلالا",16,"ل",2,0],["إذ كان يصغي منهما للسمر","وهو مطلٌّ ناظر من عل",17,"ل",1,0],["إذ كان يغبطنا الزمان ونحن في","وادي الفريكة منبت الريحانى",18,"ن",2,0],["إذ كان فيها النشاشيبي يسعفني","وكنت فيها خليلاً للسكاكيني",19,"ي",1,0],["إذ كنت أنت لمثله عقبا","أكرم يمثلك أنت من عقب",20,"ب",1,0],["إِذ كُنتَ يا جُعَلَ الشَقيقَةِ غافِلاً","عَن يَومِ شَدَّتِنا عَلى بِسطامِ",21,"م",1,0],["أذكى سنا البرقِ في أحشائهِ لهبا","وجاذبتهُ يدُ الأشواقِ فانجذبا",22,"ب",2,1],["أذكِّر مولايَ ما قلتُ في","مقاطيع شعرٍ تجوب البوادِي",23,"ي",1,0],["أذكرتني بالقوم يا","عليّ ببيتٍ قد بهر",24,"ر",1,0],["أذكر ثغراً لها فأسكر من","ورود خدٍّ لها فأرتع في",25,"ي",1,0],["أذكرتنا زمن المؤيد لا غدت","مثواه باكية الغمام تشهّق",26,"ق",1,0],["أذكّر جودك الوعد المبدَّا","وقد أخمدت من سغبي ضرامهْ",27,"م",2,0],["أذكرتنا فقد يحيى يا محمده","وللجراح على آثارها ألم",28,"م",1,0],["أذكِّرك الوعدَ الذي كان بيننا","وما مرَّ من يومٍ عليه ومن شهر",29,"ر",1,0],["اذكرْ هداكَ اللَّهُ موعِدنا","ودعِ السكون له إلى الحرك",30,"ك",1,0],["إذْ كلُّ رأيٍ آفلٌ","وهلالُ رأيك يستَهلُّ",31,"ل",1,0],["أذكِّرُ النَّفس مَثْنىً من محاسنهم","إذا ذكرت ذنوب القوم أُحدانا",32,"ن",2,0],["أَذَكَرتَ عَهدَكَ فَاِعتَرَتكَ صَبابَةٌ","وَذَكَرتَ مَنزِلَةً لِآلِ كَنودِ",33,"د",1,1],["إِذ كانَ مَنزِلُكَ المَرَّوتَ مُنجَحِراً","يا اِبنَ المَراغَةِ يا حُبلى بِمُختارِ",34,"ر",1,0],["إِذ كُلُّ طَيرٍ صادِحٌ مُتَرَنِّمٌ","إِذ كُلُّ غُصنٍ يانِعٌ مُتَهَدِّلُ",35,"ل",1,0],["أَذكَرتَني أَشياءَ مِن","زَمَنٍ تَرَكتُ بِها وَلوعي",36,"ع",2,0],["أَذكَرتَني زَمَناً مَضى","عَنّي وَعَيشاً كانَ نَضرا",37,"ر",2,0],["أَذكُرُ اليَومَ سُلَيمى","وَغَداً أَذكُرُ زَينَب",38,"ب",1,0],["اذ كنت اقرأ بينات ربيعه","سوراً ووجه الارض دوني مصحف",39,"ف",1,0],["اذ كان يحبو العقل فيه","حبو طفل محول",40,"ل",1,0],["اذ كنت والاهواء تقتادني","اصبح فيها غير ما امسى",41,"س",2,0],["اذكري إذ كنا صغيرين نلعب","وعلى انغام الطبيعة نطرب",42,"ب",1,1],["أذكى تعصب ثلة جهال","نارا بها انا دون غيري الصالي",43,"ي",1,1],["إِذ كُنتَ أَمسِ ماشِياً بِجانِبي","تَعجَبُ مِن رَقصِيَ تَحتَ صاحِبي",44,"ي",1,0],["إِذ كَيفَ تَسمو لِلعُلا يا فَتى","إِن أَنتَ لَم تَنفَع وَلَم تَشفَعِ",45,"ع",1,0],["اُذكُرِ الآيَةَ إِذ أَنتَ جَنين","لَكَ في الظُلمَةِ لِلنورِ حَنين",46,"ن",1,0],["اُذكُرِ المَوتَ وَلا تَفزَع فَمَن","يَحقِرِ المَوتَ يَنَل رِقَّ الزَمَن",46,"ن",1,0],["أَذكَرْتِ هَرْوَلَةَ الصبابةِ والهوى","لما خَطَرْتِ يُقبِّلان خُطاكِ ؟",47,"ك",1,0],["أُذكُروا الخُطبَةَ الَّتي","هِيَ مِن آيَةِ الكُبَر",48,"ر",1,0],["أُذَكِّرُكَ الدُنيا وَكَيفَ وَلَم يَزَل","لَها أَثَرا شَهدٍ بِفيكَ وَصابِ",49,"ب",1,0],["اُذكُر لَها اليابانَ لا","أُمَمَ الهَوى المُتَهَتِّكاتِ",50,"ت",1,0],["إِذكارُ مِثلِكَ تَركُ إِذكاري لَهُ","إِذ لا تُريدُ لِما أُريدُ مُتَرجِما",51,"م",2,0],["أذكِّرُ بالبُقيا على السِرِّ بعدما","فُضحتُ وهل بعدَ الفضيحةِ من بُقيا",52,"ي",2,0],["أذكِّرُ مجدَ المُلكِ حاجتيَ التي","تضمَّنَها سَمْحُ السَّجَايا كريمُها",53,"م",3,1],["أَذكَرتِنيهُمُ الخُطوبُ التَوالي","وَلَقَد تُذكِرُ الخُطوبُ وَتُنسي",54,"س",2,0],["أَذكَرتِنا دُوَلَ الزَمانِ وَصَرفَهُ","وَأَرَيتَنا كَيفَ الخُطوبُ النُزَّلُ",55,"ل",1,0],["أُذَكِّرُكَ العَهدَ الَّذي لَيسَ سُؤدُداً","تَناسيهِ وَالوُدُّ الصَحيحَ المُسَلَّما",56,"م",2,0],["أُذَكَّرُ أَيّامَ المُصافاةِ بَعدَ ما","تَجَرَّمَ عامٌ بَعدَهُنَّ وَعامُ",57,"م",1,0],["أَذكَرتُهُم سيماهُ سِيَما عَلِيٍّ","إِذ غَدا أَصلَعاً عَلَيهِم بَطينا",58,"ن",2,0],["أُذكُر هَداكَ الإِلَهُ أَغثَرَ لا","يُغسَلُ بِالبَحرِ طامِياً دَرَنُه",59,"ن",2,0],["أَذْكَرنَنا زَمَنَ الشَّبابِ مُدَبَّجاً","والدهرَ غِرّاً والحبيبَ مُواصِلا",60,"ل",2,0],["أَذكَرتَنا النَّشَواتِ في ظِلِّ الصِّبا","والعيشَ في سِنَةِ الزمانِ الغافلِ",61,"ل",1,0],["أذكَى له المِرِّيخُ جَمْرَ نُحوسِه","وتَغَّيَبَتْ عنه سُعودُ المُشتَري",62,"ر",2,0],["أَذكَرَتْنا الجِيرَةَ الغادين من","برقةِ الأبرقِ والرَّكْبَ الرَّوَحْ",63,"ح",1,0],["أَذْكرْتَنا شِيَمَ اللَّيالي في النَّدى","والبأسِ إذ هي شِدَّةٌ ورَخاءُ",64,"ا",2,0],["اِذكُر أَحِبَّتَكَ الَّذينَ ثَكِلتَهُم","اِذكُر رُهوناً في التُرابِ رَهَنتَها",65,"ت",3,0],["اِذكُر مَعادَكَ أَفضَلَ الذِكرِ","لا تَنسَ يَومَ صَبيحَةِ الحَشرِ",66,"ر",1,1],["إِذ كانَ يُسرِفُ في مَسَرَّتِهِ","فَيَموتُ مِن أَعضائِهِ جُزوُ",67,"و",1,0],["إِذ كُنتَ أَولَيتَ قوماً دونَ مَرتَبَتي","بِأَيسَرِ المَدحِ إِرفاقاً وَإِنفادا",68,"د",2,0],["إِذ كُنتُ أَرغَبُ في رِضاكَ وَلَم يَكُن","لي مَع وِدادِكَ رَغبَةٌ في المالِ",69,"ل",1,0],["أَذَكَروا لَمّا أَرَوها النَديما","مِن عُهودِ المِعصارِ عَهداً قَديما",70,"م",2,1],["إِذ كُنتَ لي ديمَةً تَسُحُّ وَلا","يَنساكَ قَلبي ما سَحَّتِ الدِيَمُ",71,"م",1,0],["أَذكَرَها عَرفُ الرَبيعِ إِلفَها","فَأَقبَلَت لِشَوقِها حَوامِلا",72,"ل",2,0],["إِذ كانَ في اللَونِ لَها مُناسِباً","كَأَنَّها مِن كَثرَةِ الصُروعِ",73,"ع",1,0],["أَذكَت لِحاظَ عُيونِها فَكَأَنَّها","زَهرٌ تَفَتَّحَ في حَديقَةِ نَرجِسِ",74,"س",1,0],["اذكري ذاك المساء","كيف كنا سعداء",75,"ا",2,1],["أذكرْتَنَا الفرْدوْس حينَ أرَيْتَنَا","غُرَفاً رفعتَ بناءَها وقصورا",76,"ر",2,0],["أذكرها والدموعُ تسبقني","كأنّني للأسى أجاريها",77,"ي",3,0],["أذكى من المندلِ في نارِهِ","ما سَاكَتِ الدّرَّ به مِنْ بشام",78,"م",1,0],["أَذكَرتَني أَمرَ داوُدٍ وَكُنتُ فَتىً","مُصَرَّفَ القَلبِ في الأَهواءِ وَالفِكَرِ",79,"ر",1,0],["أَذكَت حُميّا وَجدِها حُمَّةَ الأَسى","فَغَدَت بِنارٍ غَيرِ ذاتِ خُمودِ",80,"د",1,0],["أَذكَرتَنا المَلِكَ المُضَلَّلَ في الهَوى","وَالأَعشَيَينِ وَطَرفَةً وَلَبيدا",81,"د",2,0],["أَذكَت عَلَيهِ شِهابَ نارٍ في الحَشا","بِالعَذلِ وَهناً أُختُ آلِ شِهابِ",82,"ب",1,0],["أذكرني بشمِّهِ","وَجْنَةَ منْ أحبُّهُ",83,"ه",1,0],["إذْ كلُّ ذي مخلبٍ ونابٍ","يعدو به لا يحلُّ أكلُهْ",84,"ه",1,0],["اذكرْ فلانَ الذي أسهلْتَهُ سَحَرَاً","إنَّ الكرامَ إذا ما أسهلوا ذكروا",85,"ر",3,0],["أذكرَتْنا وفاته بأبيه","وأخيه أيامَ كانوا وكنَّا",86,"ن",2,0],["أَذكُرُ أَن لا بُدَّ مِن مَجلِسٍ","يَكونُ عَن سامِرِكُم مَعزِلا",87,"ل",2,0],["إِذ كِدتُ لَولا الحَيا يُوَرِّعُني","أُبدي الَّذي قَد كَتَمتُ بِالنَظَرِ",88,"ر",1,0],["أَذكَرَتني مِن بَهجَةِ الشَمسِ لَمّا","طَلَعَت مِن دُجُنَّةٍ وَسَحابِ",89,"ب",1,0],["إِذ كُنتِ حاوَلتِ العِتابَ لِتَعلَمي","ما عِندَنا فَلَقَد أَطَلتِ عِتابا",90,"ب",2,0],["أَذكى الدُجى عَن نَظرَةٍ ناراً كَما","هَزَّ الفَلا عَن زَأرَةٍ أَقطارا",91,"ر",2,0],["اذكروهُ عَرَبيّاً ماجداً","نَابِهَ الذِّكرِ كريمَ المُنْتَمى",92,"م",2,0],["اذكروا العصريْنِ كم من قُوّةٍ","تتلظَّى نارُها في الذكريَيْنْ",93,"ن",1,0],["اذكري يومَكِ في أفيائهم","وَدَعي الأمسَ فما يُغني النّدمْ",94,"م",1,0],["اذكروا بُلفورَ في تلمودكم","واغفروا اليومَ لعيسَى ما اجترمْ",94,"م",1,0],["اذكريني أدركيني خَفِّفِي","ألمِي بُوركتِ من أُختٍ وأُمّْ",94,"م",1,0],["اذكرونا في المُلِمّاتِ الكُبَرْ","واشْهَدوا أنّا الميامينُ الغُرَرْ",95,"ر",1,1],["اذْكُرِي التّيجانَ حَيْرَى تَرْتَمِي","والعروشَ الشُّمَّ تَهوِي في الدَّمِ",95,"م",1,0],["اذكُر لَنا القَومَ الغُزاةَ وَحَيِّهِ","شَعباً أَبَرَّ عَلى الشُعوبِ نَبيلا",96,"ل",2,0],["اذكُري البَأسَ رَحيماً عادِلا","وَاِذكُري العَدلَ عَميماً شامِلا",97,"ل",2,0],["اذكُري العَهدَ كَريماً فاضِلا","ماجِدَ الأَخلاقِ غِطريفَ الشِيَمْ",97,"م",1,0],["اذكُري يا مِصرُ عَهدَ الفاتِحينْ","مِن جُنودِ اللَهِ رَبِّ العالَمينْ",97,"ن",1,0],["أذكَ وَالعَصرُ عَصرُ النورِ عِندَكُم","فَما يَكونُ إِذا ما اِسوَدَّتِ العُصُرُ",98,"ر",1,0],["اذكروا الأبطالَ تَهوِي واتّقوا","حاصِدَ الموتِ كفاكم ما حَصَدْ",99,"د",1,0],["اذكروا يا قومُ من أمجادِكم","ما نَسِيْتُم رُبَّ ذِكرٍ نَفعا",100,"ع",2,0],["أَذكى عَلَيَّ الدَهرُ نارَ خُطوبِهِ","فَبَثَثتُ فيها مِن مَديحِكَ عَنبَرا",101,"ر",2,0],["أذْكَرَتْنَا بِأَكْلِهَا أكلَ مِنْسَا","ةِ سُلَيْمانَ الأَرْضَةُ الخَرساءُ",102,"ا",2,0],["أَذْكَرَتْنا عَيْشاً قديماً نَزَعْنَا","هُ لِبَاساً كَالحُلَّةِ المُسْتَعَارَهْ",103,"ر",2,0],["إذ كانَ سُلْطانُ البسيطةِ منهمُ","يَغارُ على الإِسْلامِ فاللَّهُ أَغيَرُ",104,"ر",1,0],["أذْكَرْتَنِي عَهْدَ الطِّعانِ فَلَم أجِد","رُمْحاً أَصُولُ بِهِ وَلا دَبُّوسا",105,"س",2,0],["أَذْكَى النَّسَبِ أَعْلَى الحَسَبِ","كُلُّ العَرَبِ في خِدْمَتِهِ",106,"ت",2,0],["أَذكى سِراجاً وَساقي القَومِ يَمزِجُها","فَلاحَ في البَيتِ كَالمِصباحِ مِصباحُ",107,"ح",1,0],["إِذ كُنتُ لا أَنظُرُ مِن حَيثُ لا","أَنظُرُ إِلّا نَحوَ وَجهٍ حَسَن",108,"ن",1,0],["اِذكُر سَواءَةَ ثُمَّ اِفخَر بِظِئرِهِمُ","وَما اِفتِخارُ بُنَيِّ الظِئرِ بِالظيرِ",109,"ر",1,0],["أَذكَرتُ نَفسي عَشِيَّةَ الأَحَدِ","مِن زائِرٍ صادَني وَلَم يَصِدِ",110,"د",1,1],["أَذكى عَلَيكُم عُيوناً غَيرَ غافِلَةٍ","إِذا تَغَفَّلَتِ الأَحراسُ وَالرَصَدُ",111,"د",1,0],["اِذكُري لَيلَةَ نَلهو","في رُعودٍ وَسَحابِ",112,"ب",1,0],["اِذكُر إِلَهَكَ إِن هَبَبتَ مِنَ الكَرى","وَإِذا هَمَمتَ لِهَجعَةٍ وَرُقادِ",113,"د",1,1],["أَذكَرُكُم بِرِحلَتِكُم لَعَلّي","أَروعُ قُلوبَكُم وَلِمَن أَروعُ",114,"ع",1,0],["إِذ كُلُّنا وَمِقٌ راضٍ بِصاحِبِهِ","لا يَبتَغي بَدَلاً فَالعَيشُ مُغتَبِطُ",115,"ط",1,0],["أَذكرتَ بل أَنْسَيتَ ما ذَكرَ الأُلى","في فِعلهم فَكأنَّهُ لم يُفعلِ",116,"ل",1,0],["إذ كانت الأعداء تسعر نارها","وَالنار منك قَريبة لا تبعد",117,"د",1,0],["اذكريني وتعالي","قبلما الوقت يفوتُ",118,"ت",1,1],["أذكى الشقيق شموعاً","فوق الربى والبطاح",119,"ح",1,0],["إذ كل أَحلام الشَبيبة حلوة","وَالصحب يعطفهم عليّ وفاء",120,"ا",2,0],["إِذ كانَ ساكِباً","لنوره القَمَر",121,"ر",1,0],["إِذ كنتَ عائشاً","في دولة الغنى",121,"ن",2,0],["إذ كنت حين لقيتني","متوجعاً لتغيبك",122,"ك",1,0],["إِذكري بين الكؤوس الذهبيَّه","حانةً يا ليتها دامت لنا",123,"ن",2,0],["أَذكَرَتني ما قالَهُ عَرَبِيٌّ","طارِقِيٌّ أَمسى اِحتَواهُ شُلَيرُ",124,"ر",1,0],["اِذكُر وَأُمُّكَ مِنّي حينَ تَنكُبني","جِنّي فَيَغلِبُ جِنّي كُلَّ مَجنونِ",125,"ن",1,0],["أذْكَتْ سَرَنْدِيبُ أُولاها وآخِرَها","وعَوّذَتْها بَناتُ القَيْنِ تَشْميتا",126,"ت",2,0],["أَذكُرُها وَالمَوتُ في ذِكرِها","عَلى سَبيلِ البَثِّ وَالعِبرَةِ",127,"ه",1,0],["إذ كان في دولته مجال","فيه جلتْ أسرارها الرجال",128,"ل",1,0],["أُذَكِّرُ قَومي ظُلمَهُم لي وَبَغيَهُم","وَقِلَّةَ إِنصافي عَلى القُربِ وَالبُعدِ",129,"د",1,0],["أَذْكَرْتَنِي مَا مَضَى وَالشَّمْلُ مُجْتَمِعٌ","بِمِصْرَ وَالْحَرْبُ لَمْ تَنْهَضْ عَلَى سَاقِ",130,"ق",1,0],["إِذْ كُنْتِ مفْترَجِي وَكانَ يَرُوعُنِي","نَزَقُ المِيَاهِ وَحِلْمُ كُلِّ جَمَادِ",131,"د",1,0],["أَذْكُرُ مِنْ فِي ذِكْرِهِ","مَسَرَّةٌ لَكُمْ وَلِي",132,"ل",2,0],["أَذْكَى العُقُولِ يَسُوسُ أَذْكى تُرْبَةٍ","فَيُرِيكَ مُعْجِزَتَيْنِ فِي الإِنْبَاتِ",133,"ت",1,0],["أَذْكَى وَأَبْلَغِ مَنْ عَرَتْهُ","جِنَّةٌ لِهَوى مُخَامِرْ",134,"ر",1,0],["اذكري، يا بدرُ، ما شاهدتهِ","من جنود الله في حربِ عداه",135,"ا",2,0],["أذْكُر مسامَرَةً ومجْتَمَعاً","مزدانتين بقُبلَةِ الحَذر",136,"ر",1,0],["أذْكُرْ تَوَسُّدَها ثنيَّتَها","وسنانةً محلولةَ الشعر",136,"ر",1,0],["أذْكر يداً مرّتْ على بَدَنٍ","هي منهُ حتى الآن في ذُعُر",136,"ر",1,0],["أذكياءٌ عيونُهم تسبقُ الألسُنَ","عمَّا ترومه وتنوب",137,"ب",1,0],["إذْ كانَ من فارِسٍ في بَيتِ سُؤدَدِها،","وَكنتَ من طَيِّئٍ في البَيتِ ذي الحَسبِ",138,"ب",1,0],["إذ كساني الفتح أثواب الغنى","فكسوتي إياه مدح منتخب",139,"ب",1,0],["إذ كانت الدنيا بعيني هيكلا","فيه إلاهات الجمال ترتل",140,"ل",1,0],["اذَكِّرُ النفسَ مَثْنَى من محاسنهم","إذا ذكرْتُ ذنوب القومِ وحدانا",141,"ن",2,0],["إذ كانَ في بغداد عم","رانٌ وكان له شمول",142,"ل",1,0],["اذ كان يغبطنا الزمان ونحن ظلامه","يرنو لهن بمقلة ِ الغَيران",143,"ن",1,0]]}