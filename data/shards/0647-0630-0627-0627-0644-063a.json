{"poems":[[88,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[73,"هذا الغزال الذي بعثت به","https://www.aldiwan.net/poem3953.html","المنسرح"],[74,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[63,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[173,"هذا الغميم فناد في صحرائه","https://www.aldiwan.net/poem1597.html",""],[173,"ما شئتما يا صاحبي فقولا","https://www.aldiwan.net/poem1656.html",""],[186,"هذا الغريب الذي لاقى المنية في","https://www.aldiwan.net/poem66933.html","البسيط"],[186,"هذا الغريب الذي أبكى دمشق وقد","https://www.aldiwan.net/poem66972.html","البسيط"],[215,"دخلت أسيوط والآمال تعصف بي","https://www.aldiwan.net/poem46311.html","البسيط"],[234,"هذا الغزال الذي يرمي بمقلته","https://www.aldiwan.net/poem50786.html","البسيط"],[309,"يا جيرة بالمعهد اليماني","https://www.aldiwan.net/poem16842.html","الرجز"],[422,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[466,"هذا الغدير وحوله من عزه","https://www.aldiwan.net/poem15434.html","الكامل"],[484,"أبت الوداع فبكرت برحيل","https://www.aldiwan.net/poem36916.html","الكامل"],[580,"هذا الغرام غرمت آخره","https://www.aldiwan.net/poem2878.html","أحذ الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122375","الكامل"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130640","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104823","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53045","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27710","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77285","الكامل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147349","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108338",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108342",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133175","البسيط"],[5183,"سلطان الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=180268",""],[5189,"إنّي أحبّك والهوى غدَّارُ","https://www.poetsgate.com/ViewPoem.aspx?id=191636",""],[5198,"بيت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=136097",""],[5268,"في الليلِ يصمتُ كلُّ شيء","https://www.poetsgate.com/ViewPoem.aspx?id=207016",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5277,"المرثيّة الكاظميّة","https://www.poetsgate.com/ViewPoem.aspx?id=187574",""],[5493,"شيء من القهر","https://www.poetsgate.com/ViewPoem.aspx?id=197211",""],[5540,"الترتر","https://www.poetsgate.com/ViewPoem.aspx?id=215061",""],[5628,"الغروب والذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=178450",""],[5688,"خلّوا الدموع تَسرّب","https://www.poetsgate.com/ViewPoem.aspx?id=200824",""],[5784,"#مرت_بنا","https://www.poetsgate.com/ViewPoem.aspx?id=210562",""],[5848,"نكهة اعنابك","https://www.poetsgate.com/ViewPoem.aspx?id=53332",""],[5923,"من مذكرات مراقب امتحان","https://www.poetsgate.com/ViewPoem.aspx?id=149684",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[6127,"يوم الجائزة","https://www.poetsgate.com/ViewPoem.aspx?id=206104",""]],"verses":[["هَذا الغِراسُ الَّذي والَيتَ مَنبِتَهُ","بِخَيرِ ما والَتِ الأَضواءُ وَالنَسَمُ",0,"م",1,0],["هَذا الغَزالُ الَّذي بَعَثتُ بِهِ","ظَمآنُ يَشكو إِلى نَداكَ ظَما",1,"م",2,1],["هذا الغياب الذي قد كنت أحسبه","حتى أكاد قبيل الفقد أبكيكا",2,"ك",2,0],["هذا الغدير طما فأين الساقي","والمعقل استعلى فأين الراقي",3,"ق",2,0],["هذا الغِراسُ – وملُْ عينِكَ قرّةٌ","أنَّا قطفنا مِن جَناهُ أطايبا",4,"ب",2,0],["هذا الغميمُ فنادِ في صحرائهِ","وقفِ الرِكابَ هنيئةً بفنائهِ",5,"ه",1,1],["هَذا الغَرامُ فَكَيفَ لَو نادى بِهِم","بَينٌ وَأَصبَحَتِ الدِيارُ طُلولا",6,"ل",2,0],["هَذا الغَريبُ الَّذي لاقى المنيَّةَ في","شَرخِ الصِّبا بِقَضاءٍ غَيرِ مَحسوبِ",7,"ب",1,1],["هَذا الغَريبُ الَّذي أَبكى دِمَشقَ وَقَد","لاقى مِن البينِ في أَسفارِهِ أَجَلا",8,"ل",2,1],["هذا الغزال الكحيل العين أنذرني","بأنني سارق من أهل لبنان",9,"ن",1,0],["هذا الغزالُ الَّذي يَرمي بمقلتِه","فما يبالي بمَن أردى من الأُممِ",10,"م",1,1],["هذا الغزال الأهيف المكحل","ما أحسنه ما ألطفه ما أجمل",11,"ل",1,0],["هذا الغرامُ وما مرادك بعده","ممَّا يحولُ جفاك دون مراده",12,"د",2,0],["هذا الغَديرُ وحولهُ من عِزِّهِ","عِوض الرياض ملاعبُ الفُرسانِ",13,"ن",1,1],["هذا الغرام وهذه حالاته","والناس بين منغص وقتيل",14,"ل",1,0],["هذا الغرامُ غَرِمْتُ آخرَهُ","عُدْماً لَهُ ورَبِحتُ أَوَّلَهُ",15,"ل",2,1],["هذا الغمام على الخلائق رحمة","وصفاته الابراق والارعاد",16,"د",1,0],["هذا الغرام وتلك حاجر","والدمع ليس عليه حاجر",17,"ر",1,1],["هذَا الغَرَامُ إِذَا ما خُضتَ مَذهَبَهُ","عَرَّضتَ نَفسَكَ لِلبَلوَى وَلِلضَّرَرِ",18,"ر",1,0],["هذا الغياث الغازي الذي وعدت","به الأماني وهذه حلب",19,"ب",1,0],["هذا الغليل الذي عندي من القلقِ","وما أبثُ من الأشواقِ والحُرَقِ",20,"ق",1,1],["هَذا الغَريمُ رَأى أَديمي فِضَّةً","وَالدُرَّ وَالياقوتَ بَعض مَحاسِني",21,"ن",2,0],["هَذَا الغَدِيرُ مُرَتَّلٌ بِنُبُوءَةٍ","تَتَقَمَّصُ القَمَرَ البَهِيجَ بِتُرْبَتِي",22,"ت",2,0],["هذا الغرام وسره فتنبهوا","يا غافلين ووق نفسك يا فتى",23,"ا",1,0],["هذا الغوير ترأءاي في موشحها","وذا العذيب بذاك المبسم العطر",24,"ر",1,0],["هذا الغنا هذا المنا يا صاح","والرب ذو الجود العميم فتاح",25,"ح",1,0],["هذا الغرام وهذه سطواته","ما الملك في سطواته وقبابه",26,"ب",2,0],["هذا الغرامُ فَمالنا منهُ دوا","إن جاءَ ويلي كُلهُ أخطارُ",27,"ر",1,0],["هذا الغلا العف يبقى فالضماير رصيد","ماعكرته الظنون وسطوة الحاقدين",28,"ن",1,0],["هذا الغروبُ الآنَ يُصبِحُ أخضَرا","رِفقًا..فهذا القلبُ لن يتغيَّرا",29,"ر",2,1],["هذا الغُروبُ وَشمس أهلي لم تزلْ","خَلف الغُروبِ تلَوحُ للطلابِ",30,"ب",1,0],["هذا الغريبُ وذاكَ محبسُهُ الَّذي","فيه القيودُ وكلُّ وجهٍ واجمِ",31,"م",1,0],["هذا الغمامُ بأطيافِ الزمانِ أتى","ذكراهُ مطمورةٌ في الصّدرِ واللحَدِ",32,"د",1,0],["هذا الغرام ولست أُكذبه","بل جن قيس كاد او طفقا",33,"ق",2,0],["هذا الغروبُ كغورِ الروحِ مُكْتئبُ","تظلّهُ مِنْ مجاهيلِ الأسى سُحبُ",34,"ب",1,1],["هذا الغروبُ تراتيلٌ مُعذّبة ٌ","أفاضها خافق أحلامُهُ الشُهُبُ",34,"ب",1,0],["هذا الغرام وهبتني","لمَ بعد ذلك يُسحب",35,"ب",1,0],["هذا الغزال المليحُ الوجهِ ذوبني","ومال بي عن دروبي ثمَّ لمْ يَعُجِ",36,"ج",1,0],["هذا الغلا صار ضارب ف اعمق جذوري","والمشكله كان هذا الشوق ما جابك",37,"ك",1,0],["هذا الغلام يقلّب الورق الذي","أنساه لهواً قد جرى في الدار",38,"ر",1,0],["هذا الغلو إلى التوحيد يعرفه","من كان مستبصراً طبا به طبنا",39,"ن",2,0],["هذا الغديرُ به ناختْ كلاكلها","هيمٌ عطاشٌ، وذا رِيٌّ فَمَنْ نَهَلا؟!",40,"ل",2,0]]}