{"poems":[[94,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101402","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93896","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145070","الرمل"],[5969,"مِنْ لَظى التعياءِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=199332",""]],"verses":[["مِن لَظَى جَمرِ خَدِّهِ","كَبِدي قَدْ تَحَرَّقا",0,"ق",2,0],["من لظماي من برود ريقها","برشفة قد حرمت مذاقها",1,"ق",3,0],["من لظى خدها التهاب فؤادي","وببرد الرضاب يطفا الغليل",2,"ل",1,0],["من لظى اليأس ومن نار الخسار","وادع لي ذات الفخار يا هزاري!",3,"ي",1,0],["مِنْ لَظى التعياءِ شِعري","نارُهُ في الروحِ تَسري",4,"ر",2,1]]}