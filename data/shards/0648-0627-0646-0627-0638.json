{"poems":[[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[438,"ثنت عنك يوم الرحيل العنانا","https://www.aldiwan.net/poem12741.html","المتقارب"],[447,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[475,"وإن أظلمت يوما من الناس طخية","https://www.aldiwan.net/poem4821.html","الطويل"],[580,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27814","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121155","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123932","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111441","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75681","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136418",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204316","الطويل"],[4764,"بكت لأشواق في غيابه","https://www.poetsgate.com/ViewPoem.aspx?id=36432",""],[5480,"ديجور الغلى","https://www.poetsgate.com/ViewPoem.aspx?id=10401",""],[5596,"نغزى وسحرا","https://www.poetsgate.com/ViewPoem.aspx?id=206186",""]],"verses":[["وإنْ أظَلَّ صُبْحُهُ فَوْدي فَما","فارَقَني لَيلُ الشّبابِ عنْ قِلى",0,"ا",1,0],["وإنْ أَظْهَرَ الأَصْحَابُ ما ليسَ عِنْدَهُم","فإنّي بما عِنْدِي مِنَ الوُدِّ مُظهِرُ",1,"ر",1,0],["وإن أظلِم فقد عاقبتمُوني","وإن أُظلَم فذلكَ من نصيبي",2,"ب",2,0],["وإن أظلمت طُرقُ المعالي أنارها","من الرأيِ منه والذكاءِ شِهاب",3,"ب",1,0],["وَإن أظمأت عزمي وأذوَت مراده","غدا مورداً عذباً ومنتجعاً خصبا",4,"ب",2,0],["وإن أظلمَ الخطبُ جلّى حِجاهُ","عوارضَ أشكالِه فاسْتَبانا",5,"ن",2,0],["وإِن أَظهرت بالاعوال سبدى","فخطب الدهر بالارزا صموت",6,"ت",1,0],["وَإِن أَظلَمَت يَوماً مِنَ الناسِ طَخيَةٌ","أَضاءَ بِكُم يا آلَ مَروانَ مَنسِمُ",7,"م",1,1],["وإن أَظلَمَت من نَقْعه جَنَباتُه","فكَمْ صُبحِ سيفٍ بَيْنَه قد تَبلَّجا",8,"ج",2,0],["وإن أظهروا إضلالهم وتكبروا","فالعالمون يرون ذاك خَيالا",9,"ل",2,0],["وإن أظهر الذمي ذكراً فأطفه","وإن يستتر بالنكر فاحلم عن الفرد",10,"د",1,0],["وأن أظلَّ على الرَّاحات تشملني","بيض الأماني التي كانت لنا حُلُما",11,"م",2,0],["وان اظلمت سود الخطوب مكامني","فبعد ظلام الليل ينبثق الفجر",12,"ر",1,0],["وأَنا ظَهِيرُكَ فادعُوَنَّ إِلى الوَغى","لِتَشُبَّ حَالاً سائِرُ النُّصَراءِ",13,"ا",2,0],["وان أَظلمت أَبصارهم من عماية","فمن رأيك النور المزيل الغَياهب",14,"ب",1,0],["وانا ظننا ان يكون معوضاً","فحقق رب العرش ذاك واكدا",15,"د",2,0],["وإن أظهروا برد الودود وظله","أسروا من الشحناء حر حريق",16,"ق",1,0],["واناظر مهجتي وابكي من قليبي / الهوى حراق","يلملمني وانا طفله تشهت شي من روفه",17,"ف",2,0],["وأناظر عينك المشهل غواها","وكانت لي وسادي واللحافي",18,"ف",2,0],["وأن أظلّ صفيّاً","وتصطفينيَ خمرا",19,"ر",2,0]]}