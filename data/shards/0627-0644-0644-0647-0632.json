{"poems":[[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48642","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109890","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35535","البسيط"],[5956,"أ تطيق بُعداً عن محبِّك خالدٍ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193347",""],[5956,"ألمٌ ألمَّ به","https://www.poetsgate.com/ViewPoem.aspx?id=194579",""]],"verses":[["الله زفَّ الفتح فيه وهدى","الى قنا الحقّ ورايات الهدى",0,"د",2,0],["اللّه زان كرائماً أنجبتها","بالصالحات فزادها تجميلا",1,"ل",2,0],["اللَهُ زِد سُؤاً لِمَن","رَغِبوا الجُنوحَ إلى سَوائِك",2,"ك",1,0],["اللَهُ زِدها عِزَّةً ومَهابةً","حتى تَذِلَّ لِعزِّها أَعداؤُها",3,"ا",3,0],["اللَهُ زانَ بِكَ الأَيّام مِن ملكٍ","لَكَ الحجول مِنَ الأَيّام وَالغررُ",4,"ر",1,0],["الله زيّن عيشتي بجلاله","وتلوح إرهاصات ما سأعانُ",5,"ن",1,0],["الله زين بالوفاءِ عباده","مثل النجوم بها السما تزدانُ",6,"ن",1,0]]}