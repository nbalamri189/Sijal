{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[63,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[14,"إذا آذاك مالك فامتهنه","https://www.aldiwan.net/poem38312.html","الطويل"],[58,"إذا أذن الله في حاجة","https://www.aldiwan.net/poem30990.html","المتقارب"],[49,"أيا للمنايا ويحها ما أجدها","https://www.aldiwan.net/poem62063.html","الطويل"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[121,"رعى الله أيام الطفولة إنها","https://www.aldiwan.net/poem49279.html","الطويل"],[144,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[187,"إذا أذنبت ذنبا فيه قبح","https://www.aldiwan.net/poem43312.html","الوافر"],[187,"ألا ذرفت عيني ودام سجومها","https://www.aldiwan.net/poem43334.html","الطويل"],[282,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[327,"يدير الأمور مقادرها","https://www.aldiwan.net/poem44249.html","المتقارب"],[459,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[554,"ويخطئ عذري وجه جرمي عندها","https://www.aldiwan.net/poem68311.html","الطويل"]],"verses":[["إِذا أَذَمّوا ضَمِنوا","عَلى الزَمانِ ما اِجتَرَم",0,"م",1,0],["إذا أذابَ شَرارُ الحِقْدِ عاطفَةً","هَزَزْتَ للعَفْو عِطْفَيْ سُؤدَدٍ كَرَما",1,"م",2,0],["إِذا آذاكَ مالُكَ فَاِمتَهِنهُ","لِجاديهِ وَإِن قَرَعَ المَراحُ",2,"ح",1,1],["إِذا أَذِنَ اللَهُ في حاجَةٍ","أَتاكَ النَجاحُ بِها يَركُضُ",3,"ض",1,1],["إِذا أَذكَرَتكَ النَفسُ دِنياً دَنِيَّةً","فَلا تَنسَ رَوضاتي الجِنانِ وَخُلدَها",4,"د",3,0],["إِذا آذَنَتهُ الحَربُ آذَنَ نَومُهُ","بِحَربٍ إِلى أَن يُقعِدَ الحَربَ مَقعَدا",5,"د",2,0],["إذا أذيت نفسي صرخت ولم أبل","وداويت نفسي في الأسى ببكائيا",6,"ي",2,0],["إِذا أَذَمّوا لِمَن تُخشى بَوائِقُهُ","حَكَمتَ مُقتَدِراً أَن يَخفِروا الذِمَما",7,"م",2,0],["إذا أذنبت ذنبا فيه قبحٌ","وخفت النار والألم الأليما",8,"م",2,1],["إذا أذني استهدت بها صوت صائت","تناسيت إلا من صداها ينيمها",9,"م",3,0],["إذا أذهب الله العلومَ وأهلَها","فما الله للدهر الجهول بتارك",10,"ك",1,0],["إِذا أَذِنَ اللَهُ في حاجَةٍ","أَتاكَ النَجاحُ عَلى رِسلَهِ",11,"ل",2,0],["إذا أذنوا فأحلامٌ وهَدْيٌ","وإن وهبوا فإفراطٌ وخُرْقُ",12,"ق",1,0],["إِذا أَذنَبَت أَعدَدتُ عُذراً لِذَنبِها","فَإِن سَخَطَت كانَ اِعتِذاري مِنَ العُذرِ",13,"ر",1,0]]}