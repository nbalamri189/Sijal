{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[14,"إذا آذاك مالك فامتهنه","https://www.aldiwan.net/poem38312.html","الطويل"],[60,"إذا أذن الله في حاجة","https://www.aldiwan.net/poem30990.html","المتقارب"],[51,"أيا للمنايا ويحها ما أجدها","https://www.aldiwan.net/poem62063.html","الطويل"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[124,"رعى الله أيام الطفولة إنها","https://www.aldiwan.net/poem49279.html","الطويل"],[147,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[190,"إذا أذنبت ذنبا فيه قبح","https://www.aldiwan.net/poem43312.html","الوافر"],[190,"ألا ذرفت عيني ودام سجومها","https://www.aldiwan.net/poem43334.html","الطويل"],[286,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[331,"يدير الأمور مقادرها","https://www.aldiwan.net/poem44249.html","المتقارب"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[558,"ويخطئ عذري وجه جرمي عندها","https://www.aldiwan.net/poem68311.html","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128705","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82960","المتقارب"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112497","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131015",""],[4755,"إلى الشِّعرِ لَيلًا تَطِيرُ اليَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183688",""],[4955,"إذا ضاع الحياء فلا تسلني","https://www.poetsgate.com/ViewPoem.aspx?id=202492",""],[5956,"أستعطف الرب","https://www.poetsgate.com/ViewPoem.aspx?id=192563",""],[5977,"توبة مذنب","https://www.poetsgate.com/ViewPoem.aspx?id=213276",""]],"verses":[["إِذا أَذَمّوا ضَمِنوا","عَلى الزَمانِ ما اِجتَرَم",0,"م",1,0],["إذا أذابَ شَرارُ الحِقْدِ عاطفَةً","هَزَزْتَ للعَفْو عِطْفَيْ سُؤدَدٍ كَرَما",1,"م",2,0],["إِذا آذاكَ مالُكَ فَاِمتَهِنهُ","لِجاديهِ وَإِن قَرَعَ المَراحُ",2,"ح",1,1],["إِذا أَذِنَ اللَهُ في حاجَةٍ","أَتاكَ النَجاحُ بِها يَركُضُ",3,"ض",1,1],["إِذا أَذكَرَتكَ النَفسُ دِنياً دَنِيَّةً","فَلا تَنسَ رَوضاتي الجِنانِ وَخُلدَها",4,"د",3,0],["إِذا آذَنَتهُ الحَربُ آذَنَ نَومُهُ","بِحَربٍ إِلى أَن يُقعِدَ الحَربَ مَقعَدا",5,"د",2,0],["إذا أذيت نفسي صرخت ولم أبل","وداويت نفسي في الأسى ببكائيا",6,"ي",2,0],["إِذا أَذَمّوا لِمَن تُخشى بَوائِقُهُ","حَكَمتَ مُقتَدِراً أَن يَخفِروا الذِمَما",7,"م",2,0],["إذا أذنبت ذنبا فيه قبحٌ","وخفت النار والألم الأليما",8,"م",2,1],["إذا أذني استهدت بها صوت صائت","تناسيت إلا من صداها ينيمها",9,"م",3,0],["إذا أذهب الله العلومَ وأهلَها","فما الله للدهر الجهول بتارك",10,"ك",1,0],["إِذا أَذِنَ اللَهُ في حاجَةٍ","أَتاكَ النَجاحُ عَلى رِسلَهِ",11,"ل",2,0],["إذا أذنوا فأحلامٌ وهَدْيٌ","وإن وهبوا فإفراطٌ وخُرْقُ",12,"ق",1,0],["إِذا أَذنَبَت أَعدَدتُ عُذراً لِذَنبِها","فَإِن سَخَطَت كانَ اِعتِذاري مِنَ العُذرِ",13,"ر",1,0],["إذا أذنوا بالحرب قام خطيبهم","لرفع منار الدين بالصوت بجهر",14,"ر",1,0],["إِذا أَذرفت عبرَةً خِلتها","كغاليةٍ فوق خدٍّ أَسيل",15,"ل",1,0],["إذا أذنوا للفجر طرت مسرة","إلي مسجد فيه أصلى وأضجع",16,"ع",1,0],["إذا أذنبت يوما رعية دولة","تؤدّبها لكنها لا تبيدها",17,"د",3,0],["إذا أَذَّنَ الفَجْرُ عُدْ بي إلى","فِرَاشِي, وغِبْ أيُّهَا الفَرْقَدُ",18,"د",1,0],["إذا آذى السَّفيهُ كريمَ قومٍ","ولم ينلِ العقابَ فذاكُ داءُ",19,"ا",2,0],["إذا آذيتُ إنسانا","فمنك أريد غُفرانا",20,"ن",2,1],["إذا أذنب العاصي وتاب لربه","فإن إله الكون يقبل توبه",21,"ب",2,1]]}