"السريع"]],"verses":[["غُصِبتُكَ عِلقاً لَم أَبِعهُ وَلَم أَكُن","كَباغي رِباحٍ يَشتَري وَيَبيعُ",0,"ع",1,0],["غَصَصتُ تُربَتَهُ بِالعيسِ مالِكَةً","عَلى النَجاءِ رِقابَ الوِردِ وَالصَدَرِ",1,"ر",1,0],["غُصِبَت ما أَثَّرَت في جِسمِها","قَدَمُ العِلجِ بِرَأسِ العَرَبي",2,"ي",1,0],["غُصنٌ طَموحٌ عَطَّفَتهُ مَنيَّةٌ","لِلخابِطينَ وَطاوَعَ النَكباءَ",3,"ا",2,0],["غُصْنُ بانٍ وهِلالٌ ورَشا","إنْ تفنّى أو تبدّى أو خطَرْ",4,"ر",1,0],["غُصِبَتْ حُقوقُ اللهِ جلَّ جَلالُهُ","فقَضى أبو الحَسَنِ الصّغير بردِّها",5,"ه",2,0],["غُصونُ المُنى تُدْني إليْكَ قِطافَها","وللدّهْرِ إسْعافٌ إليْكَ وإسْعادُ",6,"د",1,0],["غَصَبَ الْعَدُوُّ بلاَدَهَا وَحُسَامُكَ الْ","مَاضيِ الشَّبَا مُسْتَرْجِعُ الْمَغْصُوبِ",7,"ب",1,0],["غَصَّتِ الأَرضُ أُتخِمَ البَحرُ مِمّا","طَوَياهُ مِن هَذِهِ الأَبدانِ",8,"ن",1,0],["غَصَبتَ عِجلاً عَلى فَرجَينِ في سَنَةٍ","أَفسَدتَهُم ثُمَّ ما أَصلَحتَ مِن نَسَبِك",9,"ك",1,1],["غصن قدوا ما أعدل","تسقوا الريح وتحمل",10,"ل",1,0],["غصون بروض الجود منك ترعرعت","وقد جادها من صوب نعماكَ وَابِلُ",11,"ل",1,0],["غصنٌ بأوراق الغلائل يخطر","وسوى هواه بمهجتي لا يخطر",12,"ر",1,1],["غصون الحمى إن الفؤاد لطائر","إليكم وأني كامل الحب وافر",12,"ر",1,0],["غصني بعيدٌ عن يديّ وغصنها","ضمت عليه أنامل المستمتع",13,"ع",1,0],["غصن من البان إذا ما انثنى","أبصرت فيه ألف بستان",14,"ن",1,0],["غَصَبْتِهِ جهراً على قلبهِ","لا تُبْتِ ما عشتِ من الغَصْبِ",15,"ب",1,0],["غصنٌ من البان في وشاحِ","ركَّب في مَغْرِس رَداحِ",16,"ح",1,1],["غصن ولكنه فتاة","بديعة الشكل في الملاحِ",16,"ح",1,0],["غُصنٌ رطيبٌ أعالي خَلقها ونقا","تحت النطاق إذا تهتَزُّ يَبهرها",17,"ر",3,0],["غصون غَذَاهُنَّ النعيم بمائه","ولم يُسقهنّ الماء في الأرض غَارس",18,"س",1,0],["غصن من الآبنوس أُلِّفَ من","مؤتَزَرٍ معجب ومنتطق",19,"ق",1,0],["غصونُ بانٍ عليها الدهرَ فاكهةٌ","وما الفواكه مما يحملُ البانُ",20,"ن",1,0],["غُصنٌ كان وَالصِبا يَتَثَنّى","هَصَرَتهُ يَدُ الرَدى فَاِنآدا",21,"ا",1,0],["غُصنٌ مِن التِبرِ فَوقَهُ وَرَقُ","كَأَنَّهُ الصُبحُ تَحتَهُ شَفَقُ",22,"ق",1,1],["غَصباً كأنَّ عُيونَهُنَّ مِن السُّرى","وَمِن الكَلالِ مَدَافِعُ الأَوشَالِ",23,"ل",1,0],["غصبوا غرس كفه","عند ما ادرك الثمر",24,"ر",1,0],["غصن الأراك وكم أقو","ل مغالطا غصن الأراك",25,"ك",1,0],["غُصَصٌ تكادُ تغيظ مِنها نَفْسُهُ","وتكادُ تُخْرِجُ قَلْبَهُ مِنْ صَدْرِهِ",26,"ر",2,0],["غَصَبَ الدَهرَ وَالمُلوكَ عَلَيها","فَبَناها في وَجنَةِ الدَهرِ خالا",27,"ل",2,0],["غُصنٌ عَلى نَقَوى فَلاةٍ نابِتٌ","شَمسُ النَهارِ تُقِلُّ لَيلاً مُظلِما",28,"م",2,0],["غصونُ الخلاف اكتستْ فانبرتْ","لها الطيرُ دارسةً شدْوَهَا",29,"و",3,1],["غُصنانِ مؤتلفانِ أَفْرَدَ واحِداً","ريبُ المنيَّةِ منهما فتهصَّرا",30,"ر",2,0],["غَصِبتُكَ مَمزوجاً بِنَفسي وَلا أَرى","لَهُم زاجِراً يَنهى وَلا حاكِماً يُعدي",31,"ي",1,0],["غُصنٌ يَشُفُّكَ إِن تَعَط","طَفَ لِلتَثَنّي أَو تَأَوَّد",32,"د",1,0],["غُصونٌ من التِّبْرِ قد أَزهَرَتْ","لهيباً يُزَيِّنَ أفنانَها",33,"ن",3,0],["غُصْنٌ يُحمِّلُني عِبءَ الهَوى فمَتى","ضَعُفْتُ عنه حَبتْني منه أَضعافا",34,"ف",2,0],["غُصْنٌ تعالى في كَثيبٍ أعفَرٍ","ليلٌ تَداجَى في صَباحٍ مُسفِرِ",35,"ر",1,0],["غُصِبْتُ على ديباجِه وعُقودِه","فديباجُه غَصبٌ وجوهرُه نَهبُ",36,"ب",1,0],["غَصِصتَ بِنيئِها فَبَشِمتَ عَنها","وَعِندَكَ لَو أَرَدتَ لَها دَواءُ",37,"ا",2,0],["غَصَّتِ الراحُ بِالمِزاجِ فَجاشَت","بِحَبابٍ يَحكي الثُغورَ سَباغِ",38,"غ",1,0],["غُصَصُ الدَهرِ قَبلَهُ أَخلَصَتني","فَاِنثَنَيتُ لِلناسِ نَشرَ مَساغِ",38,"غ",1,0],["غَصَبوا الوُعولَ بِها القِيانَ وَوَطَّدوا","وَعرَ الذُرى بِتَسَهُّلِ الأَكنافِ",39,"ف",1,0],["غَصَّت عُيونُ الرَدى وَالسَوءُ عَن مَلِكٍ","طَرفُ الزَمانِ إِلى عَليائِهِ طَمَحا",40,"ح",2,0],["غُصنٌ مِنَ البانِ مُهتَزٌّ عَلى قَمَرٍ","يَهتَزُّ مِثلَ اِهتِزازِ الغُصنِ في البانِ",41,"ن",1,0],["غَصَبَتها نَحيبَها عَزَماتٌ","غَصَبَتني تَصَبُّري وَاِغتِماضي",42,"ض",2,0],["غصصٌ هذهِ المناصب تضني","وتشقُّ القلوبَ قبلَ الجلودِ",43,"د",1,0],["غَصَبَتني مَجّاجَةُ المِسكِ نَفسي","فَسَلوها ماذا أَحَلَّ اِغتِصابي",44,"ب",2,0],["غَصَبوا المَمالِكَ مُفسِدينَ فَأَصبَحَت","وَكَأَنَّما هِيَ مَذبَحٌ أَو مَعرَكُ",45,"ك",1,0],["غُصنٌ مَنابِتُهُ القُلوبُ وَكَوكَبٌ","ما نوءُهُ إِلّا المَدامِعُ فُيَّضا",46,"ض",2,0],["غُصُنٌ يَهتَزُّ في قَمَرٍ","راكِضاً لِلوَشيِ سَحّابا",47,"ب",2,0],["غَصَّتْ قُلوبٌ كما غَصَّ القَلِيبُ بهم","فللأَسَى فيهِمُ والنارِ تَأْكِيلُ",48,"ل",1,0],["غُصِصتُ مِنكَ بِما لا يَدفَعُ الماءُ","وَصَحَّ هَجرُكَ حَتّى ما بِهِ داءُ",49,"ا",2,1],["غَصَبَت عُبَيدَةُ قَلبَهُ","أَيَحِلُّ في الإِسلامِ غَصبُه",50,"ب",2,0],["غُصنٌ نَما فوقَ دِعصٍ","يختالُ كلَّ اخْتيالِ",51,"ل",1,0],["غصبوا حقكم فيا قوم ثوروا","إنَّ غصبَ الحقوق ظلمٌ كبير",52,"ر",1,0],["غصبوا حقنا ولم ينصفونا","إنما نحن للحقوق نثور",52,"ر",1,0],["غصبوا النساء حقوقهن","نَ فَلا تصان ولا تؤدَّى",53,"د",2,0],["غُصن يطلُّ الفجرُ من ورقاتِه","ويُقبِّلُ الأنداءَ جدَّ شغوفِ",54,"ف",1,0],["غصْنُ الشبابِ عصى السحابَ فلم يَعُدْ","ذا خُضْرَةٍ إذْ كلُّ غُصْنٍ أخْضَر",55,"ر",1,0],["غصن بان كلما عاتبته","عطفته رقّة فانعطفا",56,"ف",2,0],["غُصْنُ بَانٍ قَدْ أَطْلَعَ الْحُسْنُ فِيهِ","بِيَدِ السِّحْرِ جُلَّنَاراً وَوَرْدَا",57,"د",2,0],["غَصَبْتَ مَحَبَّتي وَمَلِكْتَ قَلْبِي","وَجُلْتَ مَجَالَ سِرِّي فِي ضَمِيري",58,"ي",1,1],["غُصْنٌ نَمَا حَتّى زَكَتْ أَثْمَارُهُ","فَرَمَاُ كَيْدُ زَمَانِهِ مَقْضُوبَا",59,"ب",2,0],["غصناً عند ضفاف الجدول","لي من الأوراق أبهى حلل",60,"ل",1,0],["غُصنُ الصِبا المَخروطُ مِن عَسجَد","سُبحانَ مَن أَحكَمهُ خَرطا",61,"ط",2,0],["غُصنُ الملاحَةِ غَيرَ أَنَّ وقارَهُ","يَأبى عَلَيهِ أَن تَراهُ يَميسُ",62,"س",1,0],["غُصنٌ من المجدِ النضيرِ بدوحةٍ","كم أصْغتِ الدنيا إلى أصْداحها",63,"ح",3,0],["غُصْنَان هَزهُمَا الصِّبَا فتَمَايلا","وسَقَاهُما الأَمَلُ الرَّوِيُّ جِمَاما",64,"م",2,0],["غصن بان وهلال ورشا","إن تثنى أو تبدى أو خطر",65,"ر",1,0],["غصْن لوته الحادثات فلم يُطِق","دفعاً لها فذوى بخضرة مائه",66,"ا",3,0],["غُصْنٌ يَشُفّكَ إنْ تَعَطّ","فَ للتّثَنّي، أوْ تَأوّدْ",67,"د",1,0],["غصف الردى بمحمد ومذمم","فكانما وجد الرجال سواءَ",68,"ا",2,0],["غُصتُ بحر القَريض بِالفكر حَتّى","لَكَ أَهدي مِن اللآلي الكِبارا",69,"ر",2,0],["غُصن مِن البان في أَثواب سَوسانِ","مَسيّجٌ وَرد خَديهِ بِريحانِ",70,"ن",1,1],["غُصن فُؤادي صارَ رَوضاً لَهُ","قَد أَبدَع الغارس في غَرسِهِ",71,"س",2,0],["غُصنان قَد نَشأ بِرَوض ملاحة","فَكَأَنَّما سَقيا بِماء وا