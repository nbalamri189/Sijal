605,"استراحة فنية","https://www.poetsgate.com/ViewPoem.aspx?id=160695",""],[5612,"في يوم عيد الحج","https://www.poetsgate.com/ViewPoem.aspx?id=199230",""],[5690,"ضاءت الأكوان والدهر ابتسمْ","https://www.poetsgate.com/ViewPoem.aspx?id=172184",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5725,"يا ايها البدر","https://www.poetsgate.com/ViewPoem.aspx?id=195274",""],[5758,"عزفٌ أخْضر","https://www.poetsgate.com/ViewPoem.aspx?id=200586",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5781,"قلبي على شفاهه والسَّحَر !","https://www.poetsgate.com/ViewPoem.aspx?id=208946",""],[5791,"تعويذة حبر داخن ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208589",""],[5809,"عين الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205336",""],[5818,"عروةُ الإيمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=193069",""],[5877,"فتل الاشناب","https://www.poetsgate.com/ViewPoem.aspx?id=37471",""],[5956,"لقبٌ أحبُّه","https://www.poetsgate.com/ViewPoem.aspx?id=185626",""],[5956,"يا ناشر الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=192511",""],[6097,"قل للشّهيدة في النّقاب الأسودِ","https://www.poetsgate.com/ViewPoem.aspx?id=190678",""],[520,"أما لي من عذولكم عذير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577535",""],[6267,"ألاَ حَيِّ لُبْنَى اليَوْمَ إنْ كُنْتَ غادِيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8357&r=&rc=65",""],[276,"إليهِ بهِ سبحانهُ أتوسلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59268&r=&rc=7",""]],"verses":[["وَقُل إِنَّني الراقِصاتِ إِلى مِناً","بِأَجبُلِ جَمعٍ يَنتَظِرنَ المُنادِيا",0,"ي",2,0],["وَقَلَّ إِلى أَطلالِ مَيٍّ تَحيَّةٌ","تُحَيّى بِها أَو أَن تُرِشَّ المَدامِعُ",1,"ع",1,0],["وَقُل إِن يَكُن يَوماً بِأُحدٍ يَعُدُّهُ","سَفيهٌ فَإِنَّ الحَقَّ سَوفَ يَشيعُ",2,"ع",1,0],["وَقُلِ السَلامُ عَلَيكُم","يَأَهلَ تِلكَ الناحِيَه",3,"ي",2,0],["وَقُلِ السَلامُ عَلَيكُمُ","أَهلَ القُصورِ العالِيَه",4,"ي",2,0],["وَقَلَّ اِصطِباري حينَ لا ليَ عِندَكُم","مِنَ العَطفِ إِلّا قَسوَةٌ وَعِتابُ",5,"ب",1,0],["وقِلاهم في طبعه","كالفأر تلقاه السنانر",6,"ر",1,0],["وَقُل إِذا ذَكَرتَ قَصريهِ بِها","عَلى السَدير وَالخَوَرنقِ العَفا",7,"ا",1,0],["وقلَّ المواسي فلا صرخةٌ","تُجابُ ولا غُلَّةٌ تُنْقَعُ",8,"ع",1,0],["وقِلاعٍ مثلِ الهوادجِ حُسناً","جاعلاتٍ مَطِيَّها الأَجيَالا",9,"ل",2,0],["وقَلالَي الدَّيرِ التي لولا النَّوى","لم أَرمِها بِقِلىً ولا بعُقُوقِ",10,"ق",1,0],["وَقِلاصاً لَم يَغذُهُنَّ غَبوقٌ","دائِماتِ النَجيمِ وَالإِنقاضِ",11,"ض",1,0],["وقُلِ المَعرُوفَ فيمَن قاَلهُ","وأمنَعَن نَفسَكَ مِن قيلِ الفَنَد",12,"د",1,0],["وقل إنّ الفناءَ إلى خلودٍ","وإنَّ زخارفَ الأيامِ بُطْل",13,"ل",1,0],["وقل السلامَ على جوا","دٍ لا يلينُ له جماح",14,"ح",1,0],["وقلاعا تثني المغيرين صرعى","وتلالا مدجّجات مغيره",15,"ر",2,0],["وقُلْ إنَّني أُودعتُ شتَّى غَرائبٍ","ولا مثلَ هذي فهي منهُنَّ أغرَب",16,"ب",1,0],["وقل أنت مني داخل في حمايتي","وصن يا أجل العالمين حمائيا",17,"ي",2,0],["وقل أنت مني لا تخف كيد ظالم","وكم بأسرار العناية نقصاني",18,"ن",2,0],["وقلا وضم الراحتين على يد","كساها شأبيب الدموع الجواريا",19,"ي",2,0],["وقل إن قيل لا عفو","لعل العفو لا كانا",20,"ن",2,0],["وقلّ البِنَا والحرثُ والزرعُ للورَى","وضاقَ بأهليها بها العُلوُ والسُّفْلُ",21,"ل",1,0],["وقلاهُ كل مُساعدٍ","وجفاه أولادُ الأقاربْ",22,"ب",1,0],["وقُل القليلَ فإنه","بين الورى أمضَى نفاذا",23,"ذ",2,0],["وَقِلاصٌ أَوفى مَشارِبِها العِش","رُ وَأَدنى مَسيرِها الإِجدامُ",24,"م",1,0],["وَقُلِ السَلامُ عَلَيكَ يا مَن لَم يَزَل","كَنزاً لِأَبناءِ الهُمومِ وَمَعقِلا",25,"ل",2,0],["وَقلِ السلامُ عليكم من يوسف","يا خيرَ مَن أروى العطاشَ الهيما",26,"م",2,0],["وقل السلام عليك أل","فاً يا أمير المؤمنين",27,"ن",1,0],["وَقِلادَةُ الجَوزاءُ عِق","دٌ في تَرائِبِهِ نَظيمُ",28,"م",1,0],["وَقُلِ السَلامُ عَليكَ يا","خَيرَ الأَئِمَّةِ وَالخَلائِف",29,"ف",1,0],["وَقُلِ المَدنِفُ المُقي","مُ بِتَيماءَ قَد قَضى",30,"ض",2,0],["وَقُلِ الْعُبَيْدُ بِبَابِكُمْ","يَرْجُو الشِّفَاءَ وَلاَ مَزِيدْ",31,"د",1,0],["وقل استغفرتك ربّ فحن","وأتيت إليك خليّاً من",32,"ن",1,0],["وقل اللهمّ العفو لمن","أمسى بالذنب على جُرُف",33,"ف",1,0],["وقل إلهي إلهي أنت أنت وها","أنا أُناجيك فارحم سيّدي أسفي",34,"ف",2,0],["وقُلِ السلامُ على أصولٍ أنبَتَت","هذي الفروعَ فشرّفَت تَشريفا",35,"ف",2,0],["وقُل إننا كالفرقَدَين فأنتَ لي","أخٌ صادقٌ يحنو عليهِ أخوه",36,"و",2,0],["وقل إذا أرضُ أفريقيةِ اضطربت","وزلزلت تتعاطى الموتَ أَكوابا",37,"ب",2,0],["وَقل انقامني وَلي وَمَعي وَبي","وَعندي فاهوال القيامة تصعب",38,"ب",1,0],["وَقل أَنتَ يا عَبد الرَحيم وكل من","يَليك غَريق الخير في لجه الندى",39,"د",2,0],["وَقل أَنتَ يا عَبد الرَحيم غدامعي","بحضرة قدس عند من يغفر الذَنبا",40,"ب",2,0],["وَقل أَنتُما في ذِمَتي من جهنم","وَمن محن الدنيا وَمكر الحَواسِد",41,"د",1,0],["وَقل أَنتَ يا عَبدالرَحيم لِرَحمَتي","خلقت ومن يعنيك فهو مجمل",42,"ل",1,0],["وقل ان الموت حوض والورى","كله يشرب كاسا بالسوا",43,"و",2,0],["وَقُلِ العَبدَ لِلصَنيعِ شَكورٌ","وَعَلَيهِ الثَنا لِفَضلِكَ أَوجَب",44,"ب",1,0],["وَقُل إِذا قُمتَ إِلى صَلاتِها","حَيَّ عَلى خَيرِ الصَلاةِ وَالعَمَل",45,"ل",1,0],["وَقُل إِذا قيل أَرّخ حُسنَها بِبهاً","مرآة حسن بِها الوَجه الجَميل يُرى",46,"ر",2,0],["وَقُل أَقل عثرَتي وَاِستُر عَلى زللي","وَاِصفح عَن العَجز وَاِمنَح عَفو مُقتدرِ",47,"ر",1,0],["وَقَلَّ أعمالُ خُوزِسْتانَ مَنزلةً","عن أَنْ يكونَ بها تُهدي تَهانيه",48,"ي",2,0],["وقلائدٌ مِمّا نظَمْتُ أَوابدٌ","من كلِ قَولٍ أَنتَقيهِ مُهَذَّب",49,"ب",1,0],["وَقُل اِقبَلوها وَهيَ ضَيفٌ وَلَو سَرَت","إِلى حائِمِ الطائِيُّ حَرَّمَ أَن تُقرى",50,"ر",2,0],["وَقُل إِنَّهُ قَولٌ عَظيمٌ وَإِنَّهُ","يُعاقِبُ إِن قالَت وَيَعفو وَيَغفِرُ",51,"ر",1,0],["وقُل السلامُ عليكِ من صَبٍّ غدا","يحنو أضالعهُ عن الرَمضاءِ",52,"ا",2,0],["وقل إذا ما شئت بالبيادق","دوانق الثّغور والفواتق",53,"ق",1,0],["وقلاعُ أَعوامٍ تُعَانِقُ بعضَها","يَرْتَدَّ عنها الفارس الصِّنْديد",54,"د",1,0],["وقُل التحية مِنْ سميّك مَن غدا","بكمُ يُرجَي ذنبَهُ أن يُغْفرا",55,"ر",2,0],["وَقِلادَةٌ في جيدِهِ إِن حُرِّكَت","تَهتَزُّ مِنها الأَرضَ في تَمييدِها",56,"د",3,0],["وقلائد العقيان خلت جمانه","او ثغر محبوب تبسمّ جوهرا",57,"ر",2,0],["وقلاعٍ وتلالٍ","وفِجاجٍ ورَوابي",58,"ب",2,0],["وقل اصطباري والتسلي وأنتما","لليلى قطعتم حزنها ثم سهلها",59,"ل",3,0],["وقلائدٍ قذَفت بحارُك دُرَّها","وقضى لسانك رَصفَها ونظامَها",60,"م",3,0],["وقل إن سئلت بشيراز مَنْ","قتيلُ اشتياقٍ إلينا نُقِلْ",61,"ل",1,0],["وقل انطوى حتّى كأنك لم تلدْ","منه الهدى وكأنّه لم يولَدِ",62,"د",1,0],["وقل التحيةَ والسلامَ وحاجةً","من بعدِ أن خابت وإن هي أُنجِحتْ",63,"ت",1,0],["وقل الأرماس موطن من","سبقوا فلترع وتحترم",64,"م",1,0],["وقل إنا فتحنا اليوم بابا","إلى الإنصاف مرفوع الستار",65,"ر",1,0],["وقل الشراب مع النشيد مسوغ","وقل النشيد مع الشراب حماسي",66,"س",2,0],["وقل السلام عليك يا ابن المرتضى","وانشر هنالك لهفةً تطويها",67,"ي",3,0],["وقُلْ أغِثْني رَسولَ الله مَرْحَمةً","بِنَظرةٍ دونَها الأعْراضُ والنَّشبُ",68,"ب",1,0],["وقل الناصرون بأرض مصر","فكان وداده نهم النصير",69,"ر",1,0],["وَقُل اِن قُرب الدار يَطلُبُه العدى","قَديماً وَنَأى الدار يَطلُبُه القرب",70,"ب",1,0],["وَقُل ان نَنَل بِالود مِنكَ مَحَبَّة","فَلا مِثل ما لاقيتُ من حُبِّكُم حُب",70,"ب",1,0],["وقل إذا رمت أن ترفع إلى العيوقْ","أمّا الجميعْ هو الخالقْ أو المخلوقْ",71,"ق",1,0],["وقل الصدق منه يرجع والكذ","ب إلى نفسه بغير التباس",72,"س",1,0],["وقُلِ السَّلامُ على المنازلِ من فَتىً","لم يبقَ غيرُ سلامِهِ وسؤَالهِ",73,"ل",2,0],["وَقِلادَةٌ تَفصيلُها وَنِظامُها","كالعِقدِ في تَفصيلِهِ وَنِظامِهِ",74,"م",2,0],["وقَل أهَل تَنقضي الدنيا وما لَكُمُ","عن أرضكُم في بِلادِ اللهِ مُغتَرَبُ",75,"ب",1,0],["وقل الصلاة عليه لو","غار الحسود وقد هذى",76,"ذ",2,0],["وقلْ إلهيَ هبْ لي ما أعيشُ به","ثم احشُرنِّي غداً في زُمرة الفقرا",77,"ر",2,0],["وقُل إذا جئت أرضاً لا أنيس بها","عيت جواباً وما بالربع من أحد",78,"د",1,0],["وقل الحق والفصاحة خل","ليس هذا بموضع الفصحاء",79,"ا",2,0],["وقلَّ الرِّجال الكاملون فلا أرى","رحيماً على ذي الفقر أو متوددا",80,"د",2,0],["وقلَّ الرِّجال الكاملون ومنهم","علي بن موسى فايض الجود والندى",81,"د",2,0],["وقلْ: أنا أخطأت في ذمّها","وحُطَّ في رأسك خلعْ الدِّلا",82,"ل",2,0],["وقل: أبي القِردُ وخالي أنا","كلبٌ وإنّ الكلب قد خُوِّلا",82,"ل",2,0],["وقل اسمع واشفع تشفع وسلني","أعطك السؤل والرضا المأمولا",83,"ل",2,0],["وقل اسمع واشفع ت