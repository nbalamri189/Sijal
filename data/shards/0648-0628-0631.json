{"poems":[[53,"وبرق حدا المزن حدو الثقال","https://www.aldiwan.net/poem29635.html","المتقارب"],[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[53,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[53,"دوام الهوى في ضمان الشباب","https://www.aldiwan.net/poem30745.html","المتقارب"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[63,"تذكر الوصل فارفضت مدامعه","https://www.aldiwan.net/poem46128.html","البسيط"],[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[77,"ساعة أولى من الليل انقضت","https://www.aldiwan.net/poem36000.html","الرمل"],[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[86,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[86,"وافى كتابك يزدري","https://www.aldiwan.net/poem68852.html","مجزوء الكامل"],[54,"وبرهان باردة المطبخ","https://www.aldiwan.net/poem29072.html","المتقارب"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[88,"هل سمعتم منيرة مذ أفاضت","https://www.aldiwan.net/poem44403.html","الخفيف"],[88,"قصدوا الرياضة لاعبين وبينهم","https://www.aldiwan.net/poem44415.html","الكامل"],[88,"بكت في ظلام الليل تندب أهلها","https://www.aldiwan.net/poem44803.html","الطويل"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[37,"وبرية ضل فيها الدليل","https://www.aldiwan.net/poem7466.html","المتقارب"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"نباتي المناسب كيف تلقى","https://www.aldiwan.net/poem18441.html","الوافر"],[72,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[72,"تأوب كالبدر في جنحه","https://www.aldiwan.net/poem18484.html","المتقارب"],[72,"تنبه لما أن رأى شبيه فجرا","https://www.aldiwan.net/poem18702.html","الطويل"],[72,"أما والله قد شرفت شعري","https://www.aldiwan.net/poem18740.html","الوافر"],[72,"وبروحي المشروط في الحد يقرأ","https://www.aldiwan.net/poem19152.html","الخفيف"],[72,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[38,"هممت الغداة همة أن تراجعا","https://www.aldiwan.net/poem7729.html","الطويل"],[78,"لما تماسكت الدموع","https://www.aldiwan.net/poem14198.html","مجزوء الكامل"],[78,"يقولون صبرا لا سبيل إلى الصبر","https://www.aldiwan.net/poem14209.html","الطويل"],[89,"لقد رقد السمار حتى خلا النادي","https://www.aldiwan.net/poem44864.html","الطويل"],[85,"أم الملائك والبدور","https://www.aldiwan.net/poem6815.html","مجزوء الكامل"],[85,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[62,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[45,"أراني متى أبغ الصبابة أقدر","https://www.aldiwan.net/poem63635.html","الطويل"],[45,"لأوشك شعب الحي أن يتفرقا","https://www.aldiwan.net/poem65185.html","الطويل"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[45,"عذيري فيك من لاح إذا ما","https://www.aldiwan.net/poem65672.html","الوافر"],[61,"ألذ العيش إتيان الصبيح","https://www.aldiwan.net/poem51310.html","الوافر"],[61,"وبركة حفة بنيلوفر","https://www.aldiwan.net/poem51312.html","السريع"],[61,"أما وأبيك لا أنساه تدمي","https://www.aldiwan.net/poem51394.html","الوافر"],[61,"أمن رقبة عاف السلام مودعا","https://www.aldiwan.net/poem51570.html","الطويل"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[66,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[66,"وبركة نيلوفر زهرها","https://www.aldiwan.net/poem38804.html","المتقارب"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[66,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[80,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[44,"أما وقد ألحقتني بالموكب","https://www.aldiwan.net/poem30575.html","الكامل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[87,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[33,"جنن بليلى والجنون يسير","https://www.aldiwan.net/poem25730.html","الطويل"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[105,"ويح ذي القصة ماذا يشهد","https://www.aldiwan.net/poem43989.html","الرمل"],[81,"عميد أصيب عن عمد","https://www.aldiwan.net/poem61406.html","الطويل"],[102,"روضنا من رياضكم فينان","https://www.aldiwan.net/poem32916.html","الخفيف"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[48,"يا فضل قد أودعتني عظة","https://www.aldiwan.net/poem66203.html","الكامل"],[48,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[50,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72252","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42609","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55187","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55119","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54908","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55121","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54834","الرجز"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8988","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54225","الكامل"],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[100,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[78,"الخضوع سياسة","https://www.poetsgate.com/ViewPoem.aspx?id=12697",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[80,"تفشي يداكَ سرائر الأغمادِ","https://www.poetsgate.com/ViewPoem.aspx?id=3154",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[87,"رفَّ النَّدَى ، وَتَنَفَّسَ النُوَّارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23924&r=&rc=186",""]],"verses":[["وَبَرقٍ حَدا المُزنَ حَدوَ الثِقالِ","يُزَجّي عَلى الأَينِ حيناً فَحينا",0,"ن",2,1],["وَبِرُغمي أَن كَسَوناكَ الثَرى","وَفَرَشناكَ زَرابيَّ الرِمالِ",1,"ل",1,0],["وَبَرقٍ يُعاطينا الجَوى غَيرَ أَنَّهُ","بِهِ مِن عُيونِ الناظِرينَ نُحولُ",2,"ل",1,0],["وَبَرَزتَ في بُردِ النَبيِّ وَلِلهُدى","نورٌ عَلى أَطرارِ وَجهِكَ مُشرِقُ",3,"ق",1,0],["وَبَراقِعاً لِلعارِ ضافِيَةً","يَبقى عَلى الأَيّامِ مُغدِفُها",4,"ف",3,0],["وَبُرودٌ غالى بِهِنَّ أَبوكَ ال","قَرمُ فَاِختارَها الأَشَفَّ الأَشَفّا",5,"ف",2,0],["وَبَرى المَعابِلَ لِلعِدى فَكَأَنَّما","لِحِمامِهِ كانَ الَّذي يَبري",6,"ر",2,0],["وَبَرقٌ يُنَفِّضُ أَطرافَهُ","كَما رَمَحَت بُلقُ خَيلٍ عِرابِ",7,"ب",1,0],["وَبَرقٍ رَقيقِ الطُرَّتَينِ لَحَظتُهُ","إِذِ الجَوُّ خَوّارُ المَصابيحِ أَكهَبُ",8,"ب",1,0],["وبَرْقَعَ الدّمعُ عينيهِ لِذي هَيَفٍ","نمّتْ على القمَرِ السّاري بَراقِعُهُ",9,"ع",2,0],["وبَرَزْتَ في حُلَلِ الجَلالِ أنارَها","بأنامِلِ العِزِّ النّعيمُ الشّاملُ",10,"ل",1,0],["وَبُرُوقُ الْحَقِّ فَاصْرِفْ نَحْوَهَا","خَاطِرَ الهمَّةِ مَهْمَا أَوْمَضَتْ",11,"ت",1,0],["وَبَربَطُنا مُعمَلٌ دائِمٌ","فَقَد كادَ يَغلِبُ إِسكارَها",12,"ر",3,0],["وَبَرثَرانِ الَّذي حاكَ الإِباءُ لَهُ","ثَوباً مِنَ الفَخرِ أَبلى الدَهرَ وَالحِقَبا",13,"ب",2,0],["وَبَرَعتَ جالينوسَ أَو","لُقمانَ بَينَ الحُضَّرِ",14,"ر",1,0],["وَبُرهانُ بارِدَةُ المَطبَخِ","وَحَمّامُها واسِعُ المَسلَخِ",15,"خ",1,1],["وبرج منيف في ذراها قد ارتقى","لتُرفَعَ منه للبروج الرسائلُ",16,"ل",1,0],["وبراها ممشوقة القد كيما","يعرف الناس كيف حسن التثنّي",17,"ي",1,0],["وبرفس أرجلهم تساق وضربها","بالكفّ عند اللاعبين حرام",18,"م",1,0],["وبَرقَعَها حزن فكان لوجهها","مكان من الحسن المَهيب مكين",19,"ن",1,0],["وَبِرَحرَحانَ تَخَضخَضَت أَصلأؤُكُم","وَفَزِعتُمُ فَزَعَ البِطانِ العُزَّلِ",20,"ل",1,0],["وبريةٍ ضلَّ فيها الدليل","من الحرَّ والبعد والقسطل",21,"ل",1,1],["وَبَرُّ الأَرضِ بَعدُ وكُلُّ بَحر","أقَلَّ الفُلكُ مَركَبَه الشَّحِينَا",22,"ن",2,0],["وبرقاً ضارباً من فوقِ بشتٍ","فضربتهُ لعمري والعباةُ",23,"ه",1,0],["وبرّ رعى قصدَ العفاةِ فغاثها","وبأسٌ كوى قلبَ العدوِّ فأنضجا",24,"ج",2,0],["وبرُّك في الفضل برٌّ رفيع","فليس المعاند من طرحه",25,"ح",2,0],["وبرّ البرايا عدله ونواله","فلا عدموا من شخصه البرّ والبحرا",26,"ر",2,0],["وبرًّا إن تقاصر عنه شكري","فأقسم ما تقاصر عنه أجري",27,"ر",2,0],["وبروحي المشروط في الحدّ يقرأ","منه لحظ الكئيب أحسن خط",28,"ط",1,1],["وبرّ إذا خانَ الزمان موكلٌ","براءٍ وفاءٍ للأنام وقَّافِ",29,"ف",1,0],["وبرغمي هناك تسمع أُذنا","ي وَلكنْ من يَضبطُ الدهماءَ",30,"ا",2,0],["وَبَردَ النَدى وَالجُزءَ حَتّى يُغيرَكُم","خَريفٌ إِذا ما النَسرُ أَصبَحَ واقِعا",31,"ع",2,0],["وَبَرَزتُ لَيسَ سِوى القَمي","صِ عَن الحَشى شيءٌ دفوعُ",32,"ع",1,0],["وَبرقٌ ذَكيُّ النارِ حَتّى كَأَنَّما","يُسَعَّرُ مِمّا في فُؤادي مِنَ الجَمرِ",33,"ر",1,0],["وبرّحت الذكرى بها فترنمت","ترنم ثكلى قد اصيبت باولاد",34,"د",1,0],["وبراحة فوق السحا","ب وفوق مقدرة البحور",35,"ر",1,0],["وَبَريدٌ يَسحَبُ الذَيلَ عَلى","بُرُدٍ في البَرِّ وَالبَحرِ بِطاء",36,"ا",2,0],["وبرّهما في السحق بالعمياء","فإنها تعكس قطر الماءِ",37,"ا",2,0],["وَبَرَّحَ بي في زِبرِجٍ أَنَّ يَومَهُ","تَعَجَّلَ لَم يُمهِل وَلَم يَتَنَظَّرِ",38,"ر",1,0],["وَبُردَ خَريفٍ قَد لَبِسنا جَديدَهُ","فَلَم يَنصَرِف حَتّى نَزَعناهُ مُخلِقا",39,"ق",2,0],["وَبِرُغمِ أَنفي أَن أَراكَ مُوَسَّداً","يَدَ هالِكٍ وَالشامِتونَ قِيامُ",40,"م",1,0],["وَبَرٌّ مِثلُ بُردِ الوَشيِ فيهِ","جَنى الحَوذانِ يُنشَرُ وَالخُزامى",41,"م",2,0],["وبرق مثل حاشيتي رداء","جديد مذهب في يوم ريح",42,"ح",1,0],["وبركة حفة بنيلوفر","ألوانه بالحسن منعوته",43,"ت",2,1],["وبَرقاً في أنامِله إذا ما","تَأَلَّقَ فتَّحَ الوَردَ الجَنِيَّا",44,"ي",2,0],["وبرَّزْتُ سَبقاً في غَرائبِه الأُلى","يُقَصِّرُ عنها سابقُ القَوْمِ إن سَعى",45,"ع",2,0],["وبركةٌ ليس يُخفْي مَوجُ لُجِتَّها","من القَذى ما طفَا فيها وما رَسَبا",46,"ب",2,0],["وَبِريفِ مِصرِكَ لي عَزيزٌ لَم أَجِد","بِسِواكَ لِلإِنصافِ مِنهُ سَبيلا",47,"ل",2,0],["وَبُركَةِ نيلوفَرٍ زَهرُها","ثَنى جيدَهُ في الدُجى وَاِحتَجَب",48,"ب",1,1],["وَبِركَتُنا بِها فَوّارُ ماءٍ","يُجيدُ القَصدَ في طَلَبِ السَماءِ",49,"ا",2,0],["وَبَرقٍ حَكى ثَغرَ الحَبيبِ اِبتِسامُهُ","تَأَلَّقَ وَهناً وَالرِفاقُ رُقودُ",50,"د",1,0],["وَبَرَزتَ تَلفِظُكَ الصُفوفُ إِلَيهِم","لَفظَ الزَنادِ سَواطِعَ النيرانِ",51,"ن",1,0],["وَبَرَزنا مِنَ الكُماةِ بِأَطوا","دِ حُلومٍ تَسري عَلى أَطوادِ",52,"د",1,0],["وبرغم ذهن كالفرا","شة حول مصباح أضاء",53,"ا",2,0],["وبريقاً يظمأ الساري له","أين في عينيك ذياك البريق",54,"ق",1,0],["وَبرَدْتِ حرَّ الشّوْقِ بالبردِ الَّذي","شَهدٌ ومِسكٌ دونَهُ وعقارُ",55,"ر",1,0],["وبَرْقٍ تألّقَ إيماضُهُ","كَخَفْقِ جناحِ فؤادٍ عميدِ",56,"د",1,0],["وَبَرَقتَ لي بَرقَ اليَقينِ وَطالَما","أَمسَيتُ مُرتَقِباً لِبَرقِ الخُلَّبِ",57,"ب",1,0],["وَبَرزَةِ الوَجهِ قَد أَعيَت رِياضَتُها","كِسرى وَصَدَّت صُدوداً عَن أَبي كَرِبِ",58,"ب",1,0],["وَبَرْقٍ يَمَانِيٍّ أَرِقْتُ لِوَمْضِهِ","يَطِيرُ بِهُدَّابٍ كَثِيرِ الزَّمَازِمِ",59,"م",1,0],["وَبَرِّد حَرَّ أَحشاءِ المَوالي","وَخَضخِض لُجَةَ العَلَقِ الصَبيبِ",60,"ب",1,0],["وَبَرِّد لَهيبي وَاِطفِ نيرانَ لَوعَتي","فَعِندَكَ ما زالَ العَسيرُ يَسيرُ",61,"ر",1,0],["وَبَرَّحَ بِالتَرائِبِ مُستَطيرٌ","يُعاوِدُهُ التَمَيُّزُ وَالشَهيقُ",62,"ق",1,0],["وبَريدٌ من بَني ثعلبةٍ","وَعَوالٍ بالغوالي يُبْرَدُ",63,"د",1,0],["وَبَردُ الغَليلِ في البَردِ","مَيّادٌ تَجني المُنى زَهرَه",64,"ه",1,0],["وَبِرَغم العِدا أَواصى قربا","نا وثاق لَم تَبلها الأَزمان",65,"ن",1,0],["وَبِرَدِّ الخُصومِ شَتّى ثِقالاً","مِثلَ ما وَجَّبَت هِجانُ الجِمالِ",66,"ل",1,0],["وَبِرَيْحانَتَيْنِ طيبُهُما مِن","كَ الذي أودعتهُما الزَّهْراءُ",67,"ا",2,0],["وبرا الملوكَ فجادَ منهم جعفَرٌ","وبنو أبِيهِ وكلُّ حَيٍّ باخل",68,"ل",1,0],["وَبَرِئتُ مِمّا تَستَريبُ بِهِ","فَلِيَنهَني بِكَ ذَلِكَ البَروُ",69,"و",1,0],["وبرمكيُّ الحسنِ في حلّةٍ","كأنّهُ من حسنهِ جنّي",70,"ي",1,0],["وَبِركَةٍ تَحمِلُ الوَفاءَ تَلا","فاها مِنَ المَوتِ بَعدَ ما كَرَبا",71,"ب",2,0],["وَبَراني الحُبُّ حَتّى","كَثُرَت فيها نُحوبي",72,"ي",1,0],["وَبَركٍ هُجودٍ قَد أَثارَت مَخافَتي","بَوادِيَها أَمشي بِعَضبٍ مُجَرَّدِ",73,"د",1,0],["وبَرزَ الإمامُ بالتأييدِ","في عُدَّةٍ منهُ وفي عَديدِ",74,"د",1,0],["وبراءةُ الملكِ المُتَوَّجِ حُسنُه","بجمالِ رحمنٍ وطيبةِ غافر",75,"ر",1,0],["وبروجٍ لحمامٍ زاجلٍ","هو بالأقدارِ يهفو من كُواها",76,"ا",3,0],["وبريءُ ابتسامةٍ في فم الأيا","م كانت عزاء قلبٍ كسيرِ",77,"ر",1,0],["وبرذَوْنة بلَّ البراذين ثفْرها","وقد شرِبتْ في أوَّلِ الصيفِ أيِّلا",78,"ل",2,0],["وبراحتي مِن فِكْرتي ذُو ذُكرَةٍ","عَهِدَتْ تُذاكِرُني بطَبْعِ ذَكِيرِه",79,"ر",2,0],["وَبِرَاحَتِي قَلَمٌ إِذَا حَرَّكْتُهُ","روِيَتْ بِهِ الأَفْهَامُ وَهْيَ حِرَارُ",80,"ر",1,0],["وَبَرَاعَةٌ فِي حَلِّ مَا هُوَ مُعْضِلٌ","حَيْثُ المُعَاضِلُ قَدْ أَبَيْنَ حُلُولاَ",81,"ل",2,0],["وَبَرْقٌ قَادِحٌ ضَرَماً","لِيُشْعِلَ كُلَّ مُشْتَعِلِ",82,"ل",1,0],["وَبِرَأْيٍ مَاضٍ وَقَلْبٍ شُجاعٍ","مِنْ عدُوِّ الذِّمَارِ صَانَ الذِّمَارَا",83,"ر",2,0],["وَبَرَزْتَ تَثْأَرُ لِلبِلاَدِ مُوَفَّقاً","فَرَدَدْتَ فَيِهَا الحَالَ غَيْرَ الحَالِ",84,"ل",1,0],["وَبَرَقتْ أَسِرةُ الْوُجُوهِ عَن","سَرائِرَ تَفِيضُ بِالسُّرُورِ",85,"ر",1,0],["وَبِركَةٍ تَزهو بِنَيلوفَرٍ","أَلوانُهُ بِالحُسنِ مَنعوتَه",86,"ت",2,1],["وَبَرَزْتَ كَاللَّيْثِ الْهَصُو","رِ دَعَتْهُ أَشْبالٌ فَهَبَّا",87,"ب",2,0],["وبرقُها خُلَّبٌ، يغريك بارقُةُ","حتى إذا شِمتَهُ، ألفيتَهُ آلا",88,"ل",2,0],["وَبَرِّئُوا كل جانٍ من جِنايتهِ","إذا بَدَا لَكُمُو في وَجْهِهِ غَضَب",89,"ب",1,0],["وبرَّز النِّجب الجياد","وبلَّد الكذبُ المحامر",90,"ر",1,0],["وبرغمه ، عصف التيقظ ،","بالعلالات الخواطف",91,"ف",1,0],["وبرغمي يصبح الغازي أخي","بعدما أضحى أخي أعدى الأعادي",92,"د",2,0],["وبرزت ليس سوى القمي","ص على الحشا شئ دفوع",93,"ع",1,0],["وبرغْمهِ أنْ حبَّ خابِطُهُ","للزارعينَ وذُمَّ مَورده",94,"د",2,0],["وبرزتَ مثلُ السيفِ لا مُستسلماً","جُبْناً ، ولا نِكْساً ، ولا مخذولا",95,"ل",2,0],["وبردّ سُمرَ الطعن عن أرض العدى","وكأنَّها في صِبْغَة ِ الفرصاد",96,"د",1,0],["وبرغم اللُّهَى التي راغمتني","فهي عني مصروفة ٌ كلَّ صرفِ",97,"ف",1,0],["وبرْكٍ هُجود قد أثارت مخافتي","نواديها أمشي بعضب مجرَّد",98,"د",1,0],["وَبِراحَتِي قَلَمٌ، إِذَا حَرَّكْتُهُ","رَويَتْ بهِ الأمهامُ وَهى َ حرارُ",99,"ر",1,0]]}