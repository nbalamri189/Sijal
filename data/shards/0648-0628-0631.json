وء الرجز"],[469,"وعاتق صبحة جليت علينا","https://www.aldiwan.net/poem60194.html","الوافر"],[469,"وبركة قد أفادنا عجبا","https://www.aldiwan.net/poem60490.html","المنسرح"],[478,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[478,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[478,"صباه الهوى ما أحوج الخلو أن يصبو","https://www.aldiwan.net/poem15336.html","الطويل"],[491,"وبروضة السُلان منا مشهد","https://www.aldiwan.net/poem645.html",""],[501,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[501,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[501,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[501,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[515,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[516,"يا صاح لست من الغرام بصاح","https://www.aldiwan.net/poem12056.html","الكامل"],[516,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[516,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[525,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[539,"إذا ذكر المثقف من شباب","https://www.aldiwan.net/poem47958.html","عموديه"],[552,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[552,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[559,"لنا غرق كلنا في القدم","https://www.aldiwan.net/poem33853.html","المتقارب"],[559,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[559,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[559,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[559,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[559,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[576,"أمانا فإني من عتابك خائف","https://www.aldiwan.net/poem2762.html","الطويل"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[576,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[576,"لقد عذبتني بالغرام مليحة","https://www.aldiwan.net/poem2872.html","الطويل"],[576,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[587,"يمينا بطيب شباب الزمان","https://www.aldiwan.net/poem17808.html","المتقارب"],[587,"لا ولين المعاطف المياله","https://www.aldiwan.net/poem18012.html","الخفيف"]],"verses":[["وَبَرقٍ حَدا المُزنَ حَدوَ الثِقالِ","يُزَجّي عَلى الأَينِ حيناً فَحينا",0,"ن",2,1],["وَبِرُغمي أَن كَسَوناكَ الثَرى","وَفَرَشناكَ زَرابيَّ الرِمالِ",1,"ل",1,0],["وَبَرقٍ يُعاطينا الجَوى غَيرَ أَنَّهُ","بِهِ مِن عُيونِ الناظِرينَ نُحولُ",2,"ل",1,0],["وَبَرَزتَ في بُردِ النَبيِّ وَلِلهُدى","نورٌ عَلى أَطرارِ وَجهِكَ مُشرِقُ",3,"ق",1,0],["وَبَراقِعاً لِلعارِ ضافِيَةً","يَبقى عَلى الأَيّامِ مُغدِفُها",4,"ف",3,0],["وَبُرودٌ غالى بِهِنَّ أَبوكَ ال","قَرمُ فَاِختارَها الأَشَفَّ الأَشَفّا",5,"ف",2,0],["وَبَرى المَعابِلَ لِلعِدى فَكَأَنَّما","لِحِمامِهِ كانَ الَّذي يَبري",6,"ر",2,0],["وَبَرقٌ يُنَفِّضُ أَطرافَهُ","كَما رَمَحَت بُلقُ خَيلٍ عِرابِ",7,"ب",1,0],["وَبَرقٍ رَقيقِ الطُرَّتَينِ لَحَظتُهُ","إِذِ الجَوُّ خَوّارُ المَصابيحِ أَكهَبُ",8,"ب",1,0],["وبَرْقَعَ الدّمعُ عينيهِ لِذي هَيَفٍ","نمّتْ على القمَرِ السّاري بَراقِعُهُ",9,"ع",2,0],["وبَرَزْتَ في حُلَلِ الجَلالِ أنارَها","بأنامِلِ العِزِّ النّعيمُ الشّاملُ",10,"ل",1,0],["وَبُرُوقُ الْحَقِّ فَاصْرِفْ نَحْوَهَا","خَاطِرَ الهمَّةِ مَهْمَا أَوْمَضَتْ",11,"ت",1,0],["وَبَربَطُنا مُعمَلٌ دائِمٌ","فَقَد كادَ يَغلِبُ إِسكارَها",12,"ر",3,0],["وَبَرثَرانِ الَّذي حاكَ الإِباءُ لَهُ","ثَوباً مِنَ الفَخرِ أَبلى الدَهرَ وَالحِقَبا",13,"ب",2,0],["وَبَرَعتَ جالينوسَ أَو","لُقمانَ بَينَ الحُضَّرِ",14,"ر",1,0],["وَبُرهانُ بارِدَةُ المَطبَخِ","وَحَمّامُها واسِعُ المَسلَخِ",15,"خ",1,1],["وبرج منيف في ذراها قد ارتقى","لتُرفَعَ منه للبروج الرسائلُ",16,"ل",1,0],["وبراها ممشوقة القد كيما","يعرف الناس كيف حسن التثنّي",17,"ن",2,0],["وبرفس أرجلهم تساق وضربها","بالكفّ عند اللاعبين حرام",18,"م",1,0],["وبَرقَعَها حزن فكان لوجهها","مكان من الحسن المَهيب مكين",19,"ن",1,0],["وَبِرَحرَحانَ تَخَضخَضَت أَصلأؤُكُم","وَفَزِعتُمُ فَزَعَ البِطانِ العُزَّلِ",20,"ل",1,0],["وبريةٍ ضلَّ فيها الدليل","من الحرَّ والبعد والقسطل",21,"ل",1,1],["وَبَرُّ الأَرضِ بَعدُ وكُلُّ بَحر","أقَلَّ الفُلكُ مَركَبَه الشَّحِينَا",22,"ن",2,0],["وبرقاً ضارباً من فوقِ بشتٍ","فضربتهُ لعمري والعباةُ",23,"ه",1,0],["وبرّ رعى قصدَ العفاةِ فغاثها","وبأسٌ كوى قلبَ العدوِّ فأنضجا",24,"ج",2,0],["وبرُّك في الفضل برٌّ رفيع","فليس المعاند من طرحه",25,"ح",2,0],["وبرّ البرايا عدله ونواله","فلا عدموا من شخصه البرّ والبحرا",26,"ر",2,0],["وبرًّا إن تقاصر عنه شكري","فأقسم ما تقاصر عنه أجري",27,"ر",2,0],["وبروحي المشروط في الحدّ يقرأ","منه لحظ الكئيب أحسن خط",28,"ط",1,1],["وبرّ إذا خانَ الزمان موكلٌ","براءٍ وفاءٍ للأنام وقَّافِ",29,"ف",1,0],["وبرغمي هناك تسمع أُذنا","ي وَلكنْ من يَضبطُ الدهماءَ",30,"ا",2,0],["وَبَردَ النَدى وَالجُزءَ حَتّى يُغيرَكُم","خَريفٌ إِذا ما النَسرُ أَصبَحَ واقِعا",31,"ع",2,0],["وَبَرَزتُ لَيسَ سِوى القَمي","صِ عَن الحَشى شيءٌ دفوعُ",32,"ع",1,0],["وَبرقٌ ذَكيُّ النارِ حَتّى كَأَنَّما","يُسَعَّرُ مِمّا في فُؤادي مِنَ الجَمرِ",33,"ر",1,0],["وبرّحت الذكرى بها فترنمت","ترنم ثكلى قد اصيبت باولاد",34,"د",1,0],["وبراحة فوق السحا","ب وفوق مقدرة البحور",35,"ر",1,0],["وَبَريدٌ يَسحَبُ الذَيلَ عَلى","بُرُدٍ في البَرِّ وَالبَحرِ بِطاء",36,"ا",2,0],["وبرّهما في السحق بالعمياء","فإنها تعكس قطر الماءِ",37,"ا",2,0],["وَبَرَّحَ بي في زِبرِجٍ أَنَّ يَومَهُ","تَعَجَّلَ لَم يُمهِل وَلَم يَتَنَظَّرِ",38,"ر",1,0],["وَبُردَ خَريفٍ قَد لَبِسنا جَديدَهُ","فَلَم يَنصَرِف حَتّى نَزَعناهُ مُخلِقا",39,"ق",2,0],["وَبِرُغمِ أَنفي أَن أَراكَ مُوَسَّداً","يَدَ هالِكٍ وَالشامِتونَ قِيامُ",40,"م",1,0],["وَبَرٌّ مِثلُ بُردِ الوَشيِ فيهِ","جَنى الحَوذانِ يُنشَرُ وَالخُزامى",41,"م",2,0],["وبرق مثل حاشيتي رداء","جديد مذهب في يوم ريح",42,"ح",1,0],["وبركة حفة بنيلوفر","ألوانه بالحسن منعوته",43,"ت",2,1],["وبَرقاً في أنامِله إذا ما","تَأَلَّقَ فتَّحَ الوَردَ الجَنِيَّا",44,"ي",2,0],["وبرَّزْتُ سَبقاً في غَرائبِه الأُلى","يُقَصِّرُ عنها سابقُ القَوْمِ إن سَعى",45,"ع",2,0],["وبركةٌ ليس يُخفْي مَوجُ لُجِتَّها","من القَذى ما طفَا فيها وما رَسَبا",46,"ب",2,0],["وَبِريفِ مِصرِكَ لي عَزيزٌ لَم أَجِد","بِسِواكَ لِلإِنصافِ مِنهُ سَبيلا",47,"ل",2,0],["وَبُركَةِ نيلوفَرٍ زَهرُها","ثَنى جيدَهُ في الدُجى وَاِحتَجَب",48,"ب",1,1],["وَبِركَتُنا بِها فَوّارُ ماءٍ","يُجيدُ القَصدَ في طَلَبِ السَماءِ",49,"ا",2,0],["وَبَرقٍ حَكى ثَغرَ الحَبيبِ اِبتِسامُهُ","تَأَلَّقَ وَهناً وَالرِفاقُ رُقودُ",50,"د",1,0],["وَبَرَزتَ تَلفِظُكَ الصُفوفُ إِلَيهِم","لَفظَ الزَنادِ سَواطِعَ النيرانِ",51,"ن",1,0],["وَبَرَزنا مِنَ الكُماةِ بِأَطوا","دِ حُلومٍ تَسري عَلى أَطوادِ",52,"د",1,0],["وبرغم ذهن كالفرا","شة حول مصباح أضاء",53,"ا",2,0],["وبريقاً يظمأ الساري له","أين في عينيك ذياك البريق",54,"ق",1,0],["وَبرَدْتِ حرَّ الشّوْقِ بالبردِ الَّذي","شَهدٌ ومِسكٌ دونَهُ وعقارُ",55,"ر",1,0],["وبَرْقٍ تألّقَ إيماضُهُ","كَخَفْقِ جناحِ فؤادٍ عميدِ",56,"د",1,0],["وَبَرَقتَ لي بَرقَ اليَقينِ وَطالَما","أَمسَيتُ مُرتَقِباً لِبَرقِ الخُلَّبِ",57,"ب",1,0],["وَبَرزَةِ الوَجهِ قَد أَعيَت رِياضَتُها","كِسرى وَصَدَّت صُدوداً عَن أَبي كَرِبِ",58,"ب",1,0],["وَبَرْقٍ يَمَانِيٍّ أَرِقْتُ لِوَمْضِهِ","يَطِيرُ بِهُدَّابٍ كَثِيرِ الزَّمَازِمِ",59,"م",1,0],["وَبَرِّد حَرَّ أَحشاءِ المَوالي","وَخَضخِض لُجَةَ العَلَقِ الصَبيبِ",60,"ب",1,0],["وَبَرِّد لَهيبي وَاِطفِ نيرانَ لَوعَتي","فَعِندَكَ ما زالَ العَسيرُ يَسيرُ",61,"ر",1,0],["وَبَرَّحَ بِالتَرائِبِ مُستَطيرٌ","يُعاوِدُهُ التَمَيُّزُ وَالشَهيقُ",62,"ق",1,0],["وبَريدٌ من بَني ثعلبةٍ","وَعَوالٍ بالغوالي يُبْرَدُ",63,"د",1,0],["وَبَردُ الغَليلِ في البَردِ","مَيّادٌ تَجني المُنى زَهرَه",64,"ه",1,0],["وَبِرَغم العِدا أَواصى قربا","نا وثاق لَم تَبلها الأَزمان",65,"ن",1,0],["وَبِرَدِّ الخُصومِ شَتّى ثِقالاً","مِثلَ ما وَجَّبَت هِجانُ الجِمالِ",66,"ل",1,0],["وَبِرَيْحانَتَيْنِ طيبُهُما مِن","كَ الذي أودعتهُما الزَّهْراءُ",67,"ا",2,0],["وبرا الملوكَ فجادَ منهم جعفَرٌ","وبنو أبِيهِ وكلُّ حَيٍّ باخل",68,"ل",1,0],["وَبَرِئتُ مِمّا تَستَريبُ بِهِ","فَلِيَنهَني بِكَ ذَلِكَ البَروُ",69,"و",1,0],["وبرمكيُّ الحسنِ في حلّةٍ","كأنّهُ من حسنهِ جنّي",70,"ن",2,0],["وَبِركَةٍ تَحمِلُ الوَفاءَ تَلا","فاها مِنَ المَوتِ بَعدَ ما كَرَبا",71,"ب",2,0],["وَبَراني الحُبُّ حَتّى","كَثُرَت فيها نُحوبي",72,"ب",2,0],["وَبَركٍ هُجودٍ قَد أَثارَت مَخافَتي","بَوادِيَها أَمشي بِعَضبٍ مُجَرَّدِ",73,"د",1,0],["وبَرزَ الإمامُ بالتأييدِ","في عُدَّةٍ منهُ وفي عَديدِ",74,"د",1,0],["وبراءةُ الملكِ المُتَوَّجِ حُسنُه","بجمالِ رحمنٍ وطيبةِ غافر",75,"ر",1,0],["وبروجٍ لحمامٍ زاجلٍ","هو بالأقدارِ يهفو من كُواها",76,"ا",3,0],["وبريءُ ابتسامةٍ في فم الأيا","م كانت عزاء قلبٍ كسيرِ",77,"ر",1,0],["وبرذَوْنة بلَّ البراذين ثفْرها","وقد شرِبتْ في أوَّلِ الصيفِ أيِّلا",78,"ل",2,0],["وبراحتي مِن فِكْرتي ذُو ذُكرَةٍ","عَهِدَتْ تُذاكِرُني بطَبْعِ ذَكِيرِه",79,"ر",2,0],["وَبِرَاحَتِي قَلَمٌ إِذَا حَرَّكْتُهُ","روِيَتْ بِهِ الأَفْهَامُ وَهْيَ حِرَارُ",80,"ر",1,0],["وَبَرَاعَةٌ فِي حَلِّ مَا هُوَ مُعْضِلٌ","حَيْثُ المُعَاضِلُ قَدْ أَبَيْنَ حُلُولاَ",81,"ل",2,0],["وَبَرْقٌ قَادِحٌ ضَرَماً","لِيُشْعِلَ كُلَّ مُشْتَعِلِ",82,"ل",1,0],["وَبِرَأْيٍ مَاضٍ وَقَلْبٍ شُجاعٍ","مِنْ عدُوِّ الذِّمَارِ صَانَ الذِّمَارَا",83,"ر",2,0],["وَبَرَزْتَ تَثْأَرُ لِلبِلاَدِ مُوَفَّقاً","فَرَدَدْتَ فَيِهَا الحَالَ غَيْرَ الحَالِ",84,"ل",1,0],["وَبَرَقتْ أَسِرةُ الْوُجُوهِ عَن","سَرائِرَ تَفِيضُ بِالسُّرُورِ",85,"ر",1,0],["وَبِركَةٍ تَزهو بِنَيلوفَرٍ","أَلوانُهُ بِالحُسنِ مَنعوتَه",86,"ت",2,1],["وَبَرَزْتَ كَاللَّيْثِ الْهَصُو","رِ دَعَتْهُ أَشْبالٌ فَهَبَّا",87,"ب",2,0],["وبرقُها خُلَّبٌ، يغريك بارقُةُ","حتى إذا شِمتَهُ، ألفيتَهُ آلا"