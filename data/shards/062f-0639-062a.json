للت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""],[5682,"كذا فليُغِرْ أو فليَغَرْ طالبَ الوِتْر","https://www.poetsgate.com/ViewPoem.aspx?id=189005",""],[5690,"أجبرت بك الدنيا فأنت مجيرها","https://www.poetsgate.com/ViewPoem.aspx?id=172135",""],[5691,"فِراقان ...!","https://www.poetsgate.com/ViewPoem.aspx?id=208655",""],[5818,"وحالمةٍ تواعد باب بيتي","https://www.poetsgate.com/ViewPoem.aspx?id=199992",""],[5910,"لقد طال هذا اللَّيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=206275",""],[5956,"أحداث غزة علّمتْنا","https://www.poetsgate.com/ViewPoem.aspx?id=192183",""],[5956,"يُغَرّد لي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=194624",""],[5956,"سقطَ الجنينُ من بطنِ آنَ الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=207114",""],[5970,"دعت فؤادي بليل الأمس غانية","https://www.poetsgate.com/ViewPoem.aspx?id=130649",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""]],"verses":[["دَعَتني بِذي الرِّمثِ الصَبابَةُ مَوهِناً","فَلَبَّيتُها وَالدَّمعُ يَستَنُّ وابِلُهْ",0,"ل",2,1],["دَعَتْ أُمُّ عَمْروٍ وَيْلَها ثُمَّ أَقْبَلَتْ","تُؤَنِّبُني وَالصُّبْحُ لَمْ يَتَنَفَّسِ",1,"س",1,1],["دَعَتهُ بِالوَيلِ فَلَبّى لَها","مُستَملِحاً لِلوَيلِ مُستَحسِنا",2,"ن",2,1],["دعَتْكَ قُلوبُ النّاسِ إذْ عمّ جذْبُها","ولَجّ الأسَى فِيها وجَلّ التأسُّفُ",3,"ف",1,0],["دعَتْكَ قُلوبُ المؤمِنينَ وأخْلَصَتْ","وقد طابَ منْها السّرُّ للهِ والجَهْرُ",4,"ر",1,0],["دعَتْني لِما لسْتُ أهْلاً لهُ","عُلاكَ فجئْتُ بجَهْدي ائْتِمارا",5,"ر",2,0],["دَعَت في أَعالي الصُغدِ يَوماً حَمامَةٌ","عَلى فَنَنٍ في ظِلِّ رَيانَ كَاليَمِّ",6,"م",1,1],["دَعَتهُم ذِئابٌ مِن أُمَيَّةَ وَاِنتَحَت","عَلَيهِم دِراكاً أَزمَةٌ وَسِنونُ",7,"ن",1,0],["دَعَتكَ مَيَّالةٌ لَعُوبٌ","أَسِيلَةُ الخَدِّ باللِّمَاعِ",8,"ع",1,0],["دَعَت مَيَّةَ الأَعدادُ فَاِستَبدَلَت بِها","خَناطيلَ آجالٍ مِنَ العَينِ خُذَّلِ",9,"ل",1,0],["دَعَتني بِأَسبابِ الهَوى وَدَعَوتُها","بِهِ مِن مِكانِ الإِلفِ غَيرِ المُساعِفِ",10,"ف",1,0],["دَعَتِ المُصَوِّرَ دَعوَةً مَسموعَةً","وَمَعَ الدُعاءِ تَضَرُّعٌ وَحِذارُ",11,"ر",1,0],["دَعَت أُمُّكَ العَمياءُ لَيلَةَ مِنقَرٍ","ثُبوراً لَقَد زَلَّت وَطالَ ثُبورُها",12,"ر",3,0],["دَعَت يالَ ذُهلٍ رَغبَةً عَن مُجاشِعٍ","وَهَل بَعدَها حَدراءُ داعِيَةٌ ذُهلا",13,"ل",2,0],["دَعَتكَ لَها أَسبابُ طولِ بَلِيَّةٍ","وَوَجدٌ بِها هاجَ الحَديثَ المُكَتَّما",14,"م",2,0],["دَعَتني وَفاضَت عَينُها بِخَدورَةٍ","فَجِئتُ غِشاشاً إِذ دَعَت أُمُّ طارِقِ",15,"ق",1,0],["دعتك المنايا فاقتفيت سبيلها","وتلك سبيلٌ لست فيها بأوحد",16,"د",1,0],["دعت الوزارة أن يعود لشملها","كفءٌ فقال لها الزمان أمين",17,"ن",1,0],["دَعَتْنِي إلى فَضلِ معروفِكُمْ","وجوهٌ مناظرُها مُعْجِبَهْ",18,"ب",2,1],["دعتني إلى لمس الكواكب قاعداً","وذلك شيء لا يكون يدَ الدهر",19,"ر",1,0],["دعتْ طالبي جدوى يديه وشأوِهِ","صنائعُ معْلُوطٍ بهن المعالطُ",20,"ط",1,0],["دعتنا إلى حمد الرجال وذمهم","هموعُ سحابات لهم ودموعها",21,"ع",3,0],["دَعَتها نَوىً عَنّا شُطونٌ وَلَيتَها","ثَوَت ما ثَوى عِندَ الكُلابِ جَنادِلُه",22,"ل",2,0],["دَعَتنا فَأَلوَت بِالنَصيفِ وَدونَها","جَناحٌ وَرُكنٌ مِن أَهاضيبِ ثَهمَدِ",23,"د",1,0],["دَعَت بِصَريحٍ ذي غُثاءٍ هَراقَهُ","سَواري العُروقِ في الضُروعِ السَحابِلِ",24,"ل",1,0],["دعت كذا دعوة وطاحت","في رقدة مالها انتباهُ",25,"ه",1,0],["دعتك المنايا بعد سقم ملازمٍ","فقلت لنفس فيك قد حشرجت لبي",26,"ب",2,0],["دعت فأسمع داعيها ولو سكتت","دعوت أسمعها والحرّ ينتدب",27,"ب",1,0],["دَعَتِ البِلادَ إِلى الغِمارِ فَغامَرَت","وَطَنِيَّةٌ بِمُثَقَّفٍ وَمُعَلِّمِ",28,"م",1,0],["دَعَتهُ بِمَفزَعِ الأَعضاءِ مِنها","لِيَومِ الحَربِ بِكرٍ أَو عَوانِ",29,"ن",1,0],["دَعَتهُ فَلَبّاها إِلى المَجدِ وَالعُلا","وَقَد خالَفَ الناسُ النُفوسَ الدَواعِيا",30,"ي",2,0],["دَعَتهُ لِأَلقى التُربَ عَنهُ اِنتِفاضَهُ","وَلَو كانَ تَحتَ الراسِياتِ الرَواسِبِ",31,"ب",1,0],["دَعَتني إِلَيها الشَمسُ تَحتَ خِمارِها","وَجَعدٌ تَثَنّى في الكَثيبِ غَدائِرُه",32,"ر",2,0],["دَعَت يا لَيَربوعٍ وَقَد حالَ دونَها","صُدورُ العَوالي وَالذُكورُ القَواطِعُ",33,"ع",1,0],["دَعَتهُم مَقاديرٌ فَأَصبَحتُ بَعدَهُم","بَقِيَّةُ دَهرٍ لَيسَ يُسبَقُ بِالذَحلِ",34,"ل",1,0],["دَعَتْني لِشُرْبِ الجاشريَّة بعدَما","تَوَسَّدْتُ وَرْدَ الزّنْدِ رَوْداً مُهَوِّما",35,"م",2,0],["دَعَتْ يمينُكَ بالمَصِيصةَ الجَفَلى","حتَّى غَدا المُحْلُ عنها وهو مُنْجفِلُ",36,"ل",1,0],["دعَتْني إساءاتُ الخُطوبِ إلى السُّرى","وكم من سُرىً أهدَتْ لنفسٍ سرورَها",37,"ر",3,0],["دَعَتْكَ الثُّغورُ وقد عايَنتْ","حِماماً مُطِّلاً وحَتْفاً بَوارا",38,"ر",2,0],["دَعَتني إِلى الدُنيا دَواعٍ مِنَ الهَوى","فَأَرسَلتُ ديني مِن يَدي وَأَتَيتُها",39,"ت",3,0],["دَعَتِ النَوى بِفِراقِهِم فَتَفَرَّقوا","وَقَضى الزَمانُ بِبَينِهِم فَتَبَدَّدوا",40,"د",3,0],["دعَتهُم بُروقٌ بالأَكُفِّ مشيرةً","إِلَيهم وعينٌ عَرْفُهَا يتنَسَّمُ",41,"م",1,0],["دَعَت ساقَ حُرٍّ بَعدَما عَلَتِ الضُحى","فَهاجٍ لَكَ الأَحزانَ أَن ناحَ طائِرُ",42,"ر",1,0],["دَعَتني دَواعي حُبِّ لَيلى وَدونَها","دَرى قُربَ جِسمي الخَوفُ مِنها قُلوبُها",43,"ب",3,0],["دعتهم للوغَى بِيضُ المواضِي","وصَيَّرتِ السِّهامَ لهم خطابا",44,"ب",2,0],["دَعَت لِلحُبِّ عَيناك","وَبِالسِحرِ اِتَّبعناك",45,"ك",1,0],["دعت الرجال ولم تكد حتى مشت","هِمم إلى الهيجاء كالأطواد",46,"د",1,0],["دَعَتنا بِكَهفٍ مِن كُنابيلَ دَعوَةً","عَلى عَجَلٍ دَهماءُ وَالرَكبُ رائِحُ",47,"ح",1,1],["دَعَتني إِلَيهِ العَينُ بِالخَيفِ مِن منى","فَهاجَت لَهُ قَلباً عَلُوقاً مُشَوَّقا",48,"ق",2,0],["دَعَت قَلبَهُ عَينٌ إِلَيها مَشُومَةٌ","عَلَيهِ وَعَينٌ لِلفُؤاذِ دَليلُ",49,"ل",1,0],["دَعَت رَبَّها أَلّا يَزالَ بِحاجَةٍ","وَلا يَغتَدي إِلّا عَلى حَدِّ بارِحِ",50,"ح",1,0],["دَعَتْ لَكَ سُكَّانٌ بها وَمساكِنٌ","ولم يَدْعُ إِلَّا عامِرٌ وَمُعَمِّرُ",51,"ر",1,0],["دَعَتِ الهُمومُ إِلى شِغافِ فُؤادي","وَحَمَت جَوانِبَ مُقلَتَيَّ رُقادي",52,"د",2,1],["دَعَت لِخُزّانِ الفَلا ثُبورا","أَدفى تَرى في شِدقِهِ تَأخيرا",53,"ر",2,0],["دَعَتني عَينُهُ دونَ النَدامى","وَآذَنَني مَتى مِنّا التَلاقي",54,"ق",2,0],["دَعَتني حينَ شِبتُ إِلى المَعاصي","مَحاسِنُ زائِرٍ كَالريمِ غَضِّ",55,"ض",1,1],["دَعَتني بِأَسبابِ الهَوى وَدَعَوتُها","لَيالِيَ سِربالُ الصَفاءِ جَديدُ",56,"د",1,0],["دَعَتهُ المَنايا فَاِستَجابَ لِصَوتِها","فَلِلَّهِ مِن داعٍ دَعا وَمُجيبِ",57,"ب",1,0],["دَعَت رَبَّها أَن يُهلِكَ البيضَ وَالقَنا","وَكُلٌّ لَهُ مِن قُدرَةِ اللَهِ آزِلُ",58,"ل",1,0],["دَعَتنَا النِساءُ إِذ عَرَفنَ وُجُوهَنا","دُعاءَ نِساءٍ لَم يُفارِقنَ عَن قِلى",59,"ل",2,0],["دعَتْهُ مُنىً كانت عليهِ مَنِيَّةً","فَترْحا لهُ منها وقَلَّ لهُ الترْحُ",60,"ح",1,0],["دعَتنيَ من لبنان لُبنى لخفرها","وإني للبنى ما حييت مطيع",61,"ع",1,0],["دَعَتْنا بِكَهْفٍ مِنْ كُنَا بَيْن دَعْوَةً","عَلَى عَجَلٍ دَهْمَاءُ والرَّكْبُ رَائِحُ",62,"ح",1,1],["دَعَتْنَا عُتَيْبَةُ مِنْ عَالِجٍ","وقَدْ حَانَ مِنَّا رَحِيلٌ فَشَالاَ",63,"ل",2,1],["دعتكم دمشقُ فما استنفرتْ","سوى عاصفٍ يتخطّى الجبالا",64,"ل",2,0],["دَعَتْ بالنَّهر فهْوَ لظىً ووقدٌ","وبالنَّسماتِ فهي حصىً وحصْبُ",65,"ب",1,0],["دَعَتْني فَجمَّعتُ قلبي لها","وناديتُ ماضِيَّ والحاضرا",66,"ر",2,0],["دعَتْ باسمها حين استقتْ فاستقلَّها","قَوادِمُ حجنٌ رِيشُهنّ ملِيمُ",67,"م",1,0],["دَعَتْ إِلَى الغَيِّ قَلْبِي فَاسْتَبَدَّ بِهِ","شَوْقٌ تَوَلَّدَ مِنْهُ الْهَمُّ وَالشَّجَنُ",68,"ن",1,0],["دَعَتْهُمْ إِلَيْهَا نَفْحَةٌ عَنْبَرِيَّةٌ","وَبِالنَّفْحَةِ الْحَسْنَاءِ قَدْ يُعْرَفُ الْوَرْدُ",69,"د",1,0],["دَعَتْهَا جَديدَاتُ اللَّيَالِي فَأَنْشَأَتْ","تَقُولُ جَديداً غَيْرَ مَا النَّاسُ تَأْثُرُ",70,"ر",1,0],["دَعَتْكَ إلى الصّحَافَةِ نَفْسُ حُرٍّ","شَديدَ العَزْمِ مُؤْتَنِفَ الفَتَاءِ",71,"ا",2,0],["دَعَتْهُ وَقَالَتْ يَا حَبِيبِيَ إِنَّهُ","دَنَا أَجَلِي فالزَمْ عَلَى الْقُرْبِ مَضْجَعِي",72,"ع",2,0],["دَعَتْهُ مِصْرُ فَلَبَّى","وَالْوَجْهُ يَعْلُوهُ بِشْر",73,"ر",1,0],["دعته مصرُ وللأحداثِ مَلْحَمةٌ","والخطبُ ما بينَ تَهْدارٍ وتهديد",74,"د",1,0],["دعتك قلوب الناس إذ عم جدبها","ولح الأسى فيها وجل التأسف",75,"ف",1,0],["دعتْ طالبي جدوى يدريه وشأوِهِ","صنائعُ معْلُوطٍ بهنَّ المعالطُ",76,"ط",1,0],["دعته الى الحجاز شؤن وجد","فمنه الدمع يحسده الغمام",77,"م",1,0],["دَعَتْه المعالي للعُلَى فأجابَها","لما قَدْ دَعَتْه وهْو أحْزَمُ حَازِمِ",78,"م",1,0],["دَعَتكَ صَبابَةٌ وَدَعاكَ شَوقٌ","وَأَخضَلَ دَمعُ عَنيِكِ مَأقِياها",79,"ا",3,0],["دَعَت لَكَ بِالبَقاءِ وَقَد أُجيبَت","حَزائِقُ أَمَّتِ البَيتَ الحَرا