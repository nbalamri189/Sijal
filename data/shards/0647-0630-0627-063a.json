{"poems":[[55,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[88,"هجعت يا طير ولم أهجع","https://www.aldiwan.net/poem68946.html","السريع"],[91,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[87,"يا سعد إن أنت دخلت لوندرة","https://www.aldiwan.net/poem7263.html","الرجز"],[76,"هذا غراب دجاك ينعب فازجر","https://www.aldiwan.net/poem12962.html","الكامل"],[50,"هذا غلام حسن وجهه","https://www.aldiwan.net/poem66265.html","السريع"],[7,"هذا غلام حسن وجهه","https://www.aldiwan.net/poem1964.html","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[112,"حزن النبلاء","https://www.poetsgate.com/ViewPoem.aspx?id=35291",""],[119,"شيخي أمام الاولياء النجبا","https://www.aldiwan.net/poem41227.html","عموديه"],[186,"هذا غلام للخليل أتى وقد","https://www.aldiwan.net/poem61133.html","الكامل"],[275,"جاء الندامى وحل الأنس والفرح","https://www.aldiwan.net/poem35293.html","البسيط"],[308,"هذا غلامي أحمق","https://www.aldiwan.net/poem57615.html","مجزوء الكامل"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[371,"هذا غريمي في الغرام","https://www.aldiwan.net/poem17097.html","مجزوء الكامل"],[567,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87098","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64307","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125476","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125468","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108463","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53039","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137262",""],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147351","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74034","الكامل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132998","البسيط"],[3509,"","https://poetry.dctabudhabi.ae/diwan/poem/124132","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206143","السريع"],[4278,"","https://poetry.dctabudhabi.ae/diwan/poem/144414","الرجز"],[5092,"غادرتُ بعضي","https://www.poetsgate.com/ViewPoem.aspx?id=176225",""],[5277,"محاورة مع بنت المستكفي","https://www.poetsgate.com/ViewPoem.aspx?id=185412",""],[5277,"لست الحطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=190909",""],[5411,"هذا غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=185524",""],[5660,"وَ كَم تَنَدَّرَ بِالعُقَلاءِ مِن خَبِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=29466",""],[5956,"أرجو بقايَ لأجل زوجي الصابرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183732",""],[6019,"نَفَحَات غَدِيرِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=150972",""],[6102,"اللي لزوما","https://www.poetsgate.com/ViewPoem.aspx?id=182909",""],[6328,"عنتر والماسنجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""],[5190,"لا زلتُ أشكو لوعةَ الغُرباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78295&r=&rc=8",""]],"verses":[["هَذا غَزالٌ قَد عَطا","وَذاكَ ظَبيٌ قَد رَنا",0,"ن",2,0],["هَذا غَليظٌ لَم يَرُضهُ الهَوى","ما بَينَ جَنبَي أَسوَدٍ أَسفَعِ",1,"ع",1,0],["هذا غناء فيه آ","ثار النبوغ ظاهره",2,"ر",2,0],["هذا غزانا بالسيوف اللامعة","وذا غزانا مرة بالجامعة",3,"ه",1,0],["هَذا غُرابُ دُجاكَ يَنعَبُ فَاِزجُرِ","وَعُبابُ لَيلِكَ قَد تَلاطَمَ فَاِعبُرِ",4,"ر",1,1],["هذا غُلامٌ حسنٌ وجههُ","ليست له من خلفهِ آخره",5,"ر",2,1],["هَذا غُلامٌ حَسَنٌ وَجهَهُ","مُستَقبِلُ الخَيرِ سَريعُ التَمام",6,"م",1,1],["هَذَا غِرَاسُكَ قَدْ مَاسَتْ بَوَاسِقُهُ","تُدَاعِبُ الرِّيحَ في زَهْوٍ وَفي لَعِبِ",7,"ب",1,0],["هذا غلاي اللي مع الدم مدقوق","ولا عاد تسأل عن شعوري بزعّلك",8,"ك",1,0],["هذا غريب القوم في طور الولا","على الألى اهل البراهين علا",9,"ا",1,0],["هَذا غُلامٌ لِلخَليلِ أَتى وَقَد","حَيَّتهُ غُرتُهُ بِوَجهِ حَبيبِهِ",10,"ب",2,1],["هذا غبوقٌ جميلٌ فيهِ يجمَعُنا","حبُّ التي مَشيُنا في رَبعِها مَرَح",11,"ح",1,0],["هذا غلامي أحمق","يغتاظ إن حاولت برأه",12,"ه",1,1],["هذا غدا خيرَ أَمجادٍ إذا ذُكِروا","كما غد ذاك فخْراً خيرَ أَدْيان",13,"ن",1,0],["هَذا غَريمِيَ في الغَرامِ","أَينَ التَعاطي في المَلامِ",14,"م",1,1],["هذا غُلامٌ كالكُهولِ فكيفَ لو","بَلغَ الشَبابَ وخاضَ في فَلوَاتِهِ",15,"ت",2,0],["هَذا غُلامك قامَ قَبلُ بِواجبٍ","لأَبيك يَرحمه الرَحيم الراحم",16,"م",1,0],["هذا غداً مالِكٌ في النَّارِ يَمْلِكُهُ","وذاكَ رِضْوانٌ يَلقاهُ بِرِضوانِ",17,"ن",1,0],["هذا غرامي يذكي النارَ في جسدي","والنومُ عن مقلتي قد جدَّ في الهرَبِ",18,"ب",1,0],["هذا غرامُكِ قد تسَعَّرَ وجدُهُ","في مُهجةِ فتكت بها الآلامُ",19,"م",1,0],["هذا غريب الدار حل بأرضنا","شهماً فادرك بالشهامة مجده",20,"د",2,0],["هذا غياث الدين أقصى منية","لطالب الرفد وهذي حلب",21,"ب",1,0],["هذا غلامك بادٍ في غلائله","كما تبدي لنا في الهالة القمر",22,"ر",1,0],["هَذَا غِيَابِيَ مَوْلُوْدٌ بِقُنْبُلَةٍ","مِنَ الحُرُوفِ تُبَاهِيْ صولةَ الحممِ",23,"م",1,0],["هَذا غَريمُ الدَهرِ طالَ مطالُهُ","فاِغرم فَإِنَّكَ ضامِنٌ وَكَفيلُ",24,"ل",1,0],["هذا غزالُ وما عَجِيبٌ","تَوَلُّدُ المِسكِ في الغزالِ",25,"ل",1,0],["هذا غريب هل بكم من فاضل","يبدي الجواب لينجلي عني النصب",26,"ب",1,0],["هذا غَناءُ الأَتقِياءِ وللسُوَى","جُوعٌ إلى أَبدِ الأَبيِدِ بلا انتِها",27,"ا",1,0],["هذا غد أرقص في ظله","وما تبدى شخصه الأرفق",28,"ق",1,0],["هذا غَمامٌ للردى","ودمعُ عيني مَطَرُهْ",29,"ر",2,0],["هذا غدي, ذنبُ البوحِ يُسْكتُني","بماءِ صمتٍ باكٍ- أُغَسِّلُها",30,"ل",3,0],["هذا غرامُك مثل الماء أشربه","يا طيب مرواكِ في قلبي ورياكِ",31,"ك",1,0],["هَذا غَرامكَ كذبة لا تنتهي","يامن علي بسوئه قد أسْرِعَا",32,"ع",2,0],["هَذا غَرامكَ لَعْنَةٌ مَرْصُودَةٌ","وَمُصيَبةٌ باتَتْ قَضاءًا مُسْرِعَا",33,"ع",2,0],["هَذا غُلامٌ أَتى يَرجوا مُنازَلَتي","يَظُنُّ أَنَّ مَنالَ العِزِّ بِالأَمَلِ",34,"ل",1,0],["هذا غنيٌّ والفقير جوارَه","هي قسمةُ المولى وسرٍّ الساهرِ",35,"ر",1,0],["هَذَا غَدِيرُكَ لا مَاءٌ ولا حَجَرُ","لَكِنَّهُ الحُبُّ في الأَعمَاقِ يَنفَجِرُ",36,"ر",1,1],["هَذَا غَدِيرُكَ تَأْرِيخٌ بِمُجمَلِهِ","عَصَتْ تَفَاصِيلُهُ إلَّا لِمَنْ عَبَرُوا",36,"ر",3,0],["هَذا غِمارُ المَوتِ ثارَ عَجاجُهُ","ما لِي أَراكَ وَ قَدْ نَهَزتُكَ تَكزِمُ ؟!",37,"م",1,0],["هذا غرامُ اليوم ِدونَ مشقّةٍ","لا مَهْرَ لا خُطّابَ ، لا ، لا جرْجرَ ة",38,"ر",2,0],["هذا غنيٌّ ، هكذا يبدو بها","ليس الغِنى بجواهرٍ وكساءِ",39,"ا",2,0]]}