{"poems":[[55,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[88,"هجعت يا طير ولم أهجع","https://www.aldiwan.net/poem68946.html","السريع"],[91,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[87,"يا سعد إن أنت دخلت لوندرة","https://www.aldiwan.net/poem7263.html","الرجز"],[76,"هذا غراب دجاك ينعب فازجر","https://www.aldiwan.net/poem12962.html","الكامل"],[50,"هذا غلام حسن وجهه","https://www.aldiwan.net/poem66265.html","السريع"],[7,"هذا غلام حسن وجهه","https://www.aldiwan.net/poem1964.html","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[112,"حزن النبلاء","https://www.poetsgate.com/ViewPoem.aspx?id=35291",""],[119,"شيخي أمام الاولياء النجبا","https://www.aldiwan.net/poem41227.html","عموديه"],[186,"هذا غلام للخليل أتى وقد","https://www.aldiwan.net/poem61133.html","الكامل"],[274,"جاء الندامى وحل الأنس والفرح","https://www.aldiwan.net/poem35293.html","البسيط"],[307,"هذا غلامي أحمق","https://www.aldiwan.net/poem57615.html","مجزوء الكامل"],[368,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[370,"هذا غريمي في الغرام","https://www.aldiwan.net/poem17097.html","مجزوء الكامل"],[565,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"]],"verses":[["هَذا غَزالٌ قَد عَطا","وَذاكَ ظَبيٌ قَد رَنا",0,"ن",2,0],["هَذا غَليظٌ لَم يَرُضهُ الهَوى","ما بَينَ جَنبَي أَسوَدٍ أَسفَعِ",1,"ع",1,0],["هذا غناء فيه آ","ثار النبوغ ظاهره",2,"ر",2,0],["هذا غزانا بالسيوف اللامعة","وذا غزانا مرة بالجامعة",3,"ه",1,0],["هَذا غُرابُ دُجاكَ يَنعَبُ فَاِزجُرِ","وَعُبابُ لَيلِكَ قَد تَلاطَمَ فَاِعبُرِ",4,"ر",1,1],["هذا غُلامٌ حسنٌ وجههُ","ليست له من خلفهِ آخره",5,"ر",2,1],["هَذا غُلامٌ حَسَنٌ وَجهَهُ","مُستَقبِلُ الخَيرِ سَريعُ التَمام",6,"م",1,1],["هَذَا غِرَاسُكَ قَدْ مَاسَتْ بَوَاسِقُهُ","تُدَاعِبُ الرِّيحَ في زَهْوٍ وَفي لَعِبِ",7,"ب",1,0],["هذا غلاي اللي مع الدم مدقوق","ولا عاد تسأل عن شعوري بزعّلك",8,"ك",1,0],["هذا غريب القوم في طور الولا","على الألى اهل البراهين علا",9,"ا",1,0],["هَذا غُلامٌ لِلخَليلِ أَتى وَقَد","حَيَّتهُ غُرتُهُ بِوَجهِ حَبيبِهِ",10,"ب",2,1],["هذا غبوقٌ جميلٌ فيهِ يجمَعُنا","حبُّ التي مَشيُنا في رَبعِها مَرَح",11,"ح",1,0],["هذا غلامي أحمق","يغتاظ إن حاولت برأه",12,"ه",1,1],["هذا غدا خيرَ أَمجادٍ إذا ذُكِروا","كما غد ذاك فخْراً خيرَ أَدْيان",13,"ن",1,0],["هَذا غَريمِيَ في الغَرامِ","أَينَ التَعاطي في المَلامِ",14,"م",1,1],["هذا غُلامٌ كالكُهولِ فكيفَ لو","بَلغَ الشَبابَ وخاضَ في فَلوَاتِهِ",15,"ت",2,0]]}