tsgate.com/ViewPoem.aspx?id=185209",""],[6142,"حبذا المصطفى مدينة علم","https://www.poetsgate.com/ViewPoem.aspx?id=155699",""],[6152,"سيد قومه المتغابي","https://www.poetsgate.com/ViewPoem.aspx?id=203404",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""],[5190,"طر يا حجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78347&r=&rc=60",""]],"verses":[["لَيسَ عَلى الشَيبِ لِلغَواني","وَإِن تَجَمَّلنَ مِن قَرارِ",0,"ر",1,1],["لَيسَ عَلى مُضرِمِها سُبَّةٌ","وَلا عَلى المُجلِبِ مِنها جُناح",1,"ح",1,0],["لَيسَ عِشقُ الإِماءِ مِن شُغلِ مِثلي","إِنَّما يَعشَقُ الإِماءَ العَبيدُ",2,"د",1,0],["لَيسَ عَن بَغضَةٍ حُذافَ وَلَكِن","كانَ جَهلاً بِذَلِكُم وَعُراما",3,"م",2,0],["لَيْسَ عَلَى النعْمَى لَهَا حَاسِدٌ","يحْفَظُهَا اللهُ وَيحمِيهَا",4,"ي",3,0],["ليس عن شرّكم ولا عن أذاكمْ","مُسْتمازٌ ولا ذَرىً للجَنوبِ",5,"ب",1,1],["ليس على الضارِط تعييرُ","ولا على الضاحِكِ تغييرُ",6,"ر",1,1],["ليس عن عمدٍ ليشقوا","بك من دائك يُشقى",7,"ق",2,0],["ليس على عاشقٍ تَمَنَّى","زَوْرَةَ معشوقهِ أَثام",8,"م",1,0],["لَيسَ عُمرُ الفَتى وَإِن طالَ إِلّا","ما حَوَتهُ الحَياةُ مِن مَكرُماتِه",9,"ت",2,0],["لَيسَ عِندي شَيءٌ أَعَزُّ مِنَ الروحِ","وَروحي مَرحونَةٌ في يَدَيكِ",10,"ك",1,0],["لَيسَ عِندَ الإِلَهِ نارٌ لِذي حُبٍّ","وَنارُ الإِنسانِ لا أَخشاها",11,"ا",3,0],["لَيسَ عِندي ما أُقَدِّمُهُ","غَيرَ روحٍ أَنتَ تَملِكُها",12,"ه",2,1],["لَيسَ عِندي غَيرُ شِعري","لَيتَهُ يَنفُقُ عِندَه",13,"د",2,0],["ليس عندي ما استقى منه شعري","غير عين من الكآبة عبرى",14,"ر",2,0],["ليس عيشي اليوم في","بغداد عيشاً يستطاب",15,"ب",1,0],["ليس على الكفار في أمرهم","عتب بل الإنصاف أن يعذروا",16,"ر",3,1],["لَيسَ عَزفُ النُحاسِ أَوقَعَ مِنهُ","في شُجاعِ الفُؤادِ أَو في جَبانِه",17,"ن",2,0],["لَيسَ عَزماً ما مَرَّضَ المَرءُ فيهِ","لَيسَ هَمّاً ما عاقَ عَنهُ الظَلامُ",18,"م",1,0],["لَيسَ عَن ثَروَةٍ بَلَغتُ مَداها","غَيرِ أَنّي اِمرُؤٌ كَفاني كَفافي",19,"ف",2,0],["لَيسَ عَلى المَرءِ في قَناعَتِهِ","إِن هِيَ صَحَّت أَذىً وَلا نَصَبُ",20,"ب",1,0],["لَيسَ عَلى قَدري وَلا قَدرِكُم","لَكِن عَلى مِقدارِ مَقدوري",21,"ي",1,0],["لَيسَ عَنكَ مُصطَبَرُ","حينَ أَسعَدَ القَدَرُ",22,"ر",1,1],["لَيسَ عِندي سِوى التَلهف أَهدي","ه وَقَلب مَوله بِكَ عان",23,"ن",1,0],["لَيسَ عَن ريمَةَ فَضلٌ في الهَوى","لَستُ بي حُبُّها أَو عَقَدا",24,"د",2,0],["لَيسَ عِندَ اللِئامِ فَضلٌ وَلَكِن","عِندَ رَوحٍ عَلى الثَناءِ ثَوابُ",25,"ب",1,0],["لَيسَ عَذابُ اللَهِ مَن خانَهُ","كَالقَطعِ لِلأَيدي وَضَربِ الرِقاب",26,"ب",1,0],["ليس على الذئب إذا ما جنى","يزيل جوع بطنه من عقاب",27,"ب",1,0],["لَيْسَ عَنْ دَعْوَةِ الجِّهَادِ وَلاَ عَنْ","نَجْدَةٍ لِلْبِلاَدِ بِالمَعْتاقِ",28,"ق",1,0],["لِيَسْعُدَا مَا شَاءَ صَفْوُ الدَّهْرِ","بِالْمَالِ وَالوُلْدِ وَطُولِ العُمْرِ",29,"ر",1,0],["ليس عندي وسيمُهم بأَثيرٍ","لا، ولا مَيَّز الذكِيَّ الذكاءُ",30,"ا",2,0],["ليس عدلاً تشاؤمُ المرءِ في الدنيا","وفيها هذا المحيط الطَروب",31,"ب",1,0],["ليس عندي شيء أعزّ من الروح","وروحي مرهونة في يديك",32,"ك",1,0],["ليس عندي في الحبّ .. حبٌّ أخيرُ","في البدء كان البحرُ، والبرُّ هو استثناءْ",33,"ا",2,0],["ليس على آفاقها قَتامُ","جَلْدٌ فما تؤلمُه الآلامُ",34,"م",1,0],["لَيسَ عَاراً عَليكَ إِن جِئتَ عَاراً","كَانَ يُعزَى إِلَيكَ قَبلَ الشُّرُوعِ",35,"ع",1,0],["ليس عندي ضيعةٌ تكفل لي","رزق أولادي ولا عندي تجارهْ",36,"ر",2,0],["ليس عيداً بل مأتم يا صحابي","فاملأوا الكأس إن أردتم عذابي",37,"ب",2,1],["ليس عن خيرةٍ وصفتُكَ لكن","حركاتٌ دلَّت على الموصوفِ",38,"ف",1,0],["ليس عار على الأديب اذا ما","قابل النظم في الطباق ينثر",39,"ر",1,0],["لَيسَ عمرُ الإِنسانِ غَير منامٍ","تَتَمَشّى أَشباحُه في العُيونِ",40,"ن",1,0],["لَيسَ عَن ضُعفٍ قُعودي","عَنهُ لكِن عَن شَهامَه",41,"م",2,0],["ليس عبّاسُكم كمثل عليّ","هل تقاس النجوم بالأقمار",42,"ر",1,0],["لَيسَ عَلى وِردِهِ لِعافٍ","وَلا لِذي غُلَّةٍ شُروعُ",43,"ع",1,0],["لَيسَ عَلى عاشِقِهِ","في الحُبِّ مِن جُناحِ",44,"ح",1,0],["ليس عدلا ان أراكم","في سلام ثم حرب",45,"ب",1,0],["ليس عندي أهديه إلا دعاء","من فوآد مدى المدى المكسور",46,"ر",1,0],["لَيسَ على الحَقِّ مِرا","حبٌّ مُعدُّ للقِرى",47,"ر",2,0],["لَيسَ علمُ اليقينِ كالعين منه","لا وَلا عينُه وحقٌّ سيانِ",48,"ن",1,0],["ليسعَى كما تَرضَى إذا سعَتِ الدنا","ويَجري بما تَهوَى إذا ما جَرى القَضا",49,"ض",2,0],["لَيْسَ عَلَى طولِ الحَياةِ نَدَمْ","ومِن وَراءِ المَرْءِ ما يَعْلَمْ",50,"م",1,0],["ليس عنها بحد سيفك رفع","واندفاع ولا بحد سنانك",51,"ك",1,0],["ليس على راكبها جنايةٌ","من عَلَمٍ يُعيي ولا أرض تشطّْ",52,"ط",1,0],["ليس عليه للتمنِّي طاعةٌ","ولا له في الشهواتِ أربُ",53,"ب",1,0],["ليس عندي فروٌ ولا لي تبنٌ","ذبتُ برداً وماتت الخيلُ جوعا",54,"ع",2,0],["ليسَ على الصبِّ المغنّى جناحْ","إن باح الشكوى فمن ضيمَ باحْ",55,"ح",1,1],["ليس عارا مسير قلبي إليها","افما سار آدم نحو حوا",56,"و",2,0],["ليسَ عُجباً إذا يَغَارُ قَريبٌ","إنما العُجبُ أن يَغَارَ البَعيدُ",57,"د",1,0],["ليس عندي لسواكم خَلاقٌ","فَاِجعَلوا عِندكمْ لي خَلاقا",58,"ق",2,0],["ليس عذرٌ لكم فيقبله اللّ","ه غداً يوم يقبل الأعذارا",59,"ر",2,0],["لَيسَ عاراً هَذا المصابُ وكان ال","ضَعفُ عنه بين الأجالدِ عارا",60,"ر",2,0],["لَيس عن الغيِّ لهُ عَرْجَةٌ","ولا له في الرّشد من نهضةِ",61,"ه",1,0],["ليسَ عندي الا سَوادُ مِدادٍ","هل يكافي تلك اليدَ البيضاءَ",62,"ا",2,0],["ليس على أن تسقط الفرائض","وسنة الله لهم إن عارضوا",63,"ض",3,0],["لَيسَ عَسٍ أَن يُقالَ مَرَّ بِهِ","أَفراسُ صِدقٍ وَأَينُقٌ عُتُقُ",64,"ق",1,0],["لَيسَ عَلَيهِم دِياتُ مَن قَتَلوا","وَالرَهنُ فيهِم مُمَنَّعٌ غَلِقُ",65,"ق",1,0],["ليسَ على الله بمستنكرٍ","أن يجمع العالم في واحِدِ",66,"د",1,0],["ليس علينا ما بَقوا غيرَهم","في هذه الأُمَة من حاكمِ",67,"م",1,0],["ليس عشقي حديث زورٍ ولكن","زان إسناده مزيد عداله",68,"ل",2,0],["ليس عثمان قصدنا","دون عمرو وسالم",69,"م",1,0],["ليس على مرسلها نحوكم","من حرجٍ إن راح صفر اليمين",70,"ن",1,0],["ليس على عاتقه عقدة","إلا من البرد، لأجل اليمين",70,"ن",1,0],["لِيَسْعَ الفتى جهدهُ طامعاً","بما شاء والمنتهى للترابْ",71,"ب",1,0],["ليس عن المعروف المنتهي","ولا عن الإحسان بالواني",72,"ن",2,0],["ليس عين الكريم من ينجز الوع","د ولكن من يجعل الوعد نقدا",73,"د",2,0],["ليس عنْكَ لي نَزْعٌ","بلْ لِعاذلي نَزْعَهْ",74,"ع",2,0],["لَيسَ عَلَيهِ حجه","يَرى بِها مَحَجه",75,"ه",1,0],["لَيس عَلى الخَير نَدَم","لَيسَ مَع الذكر عَدَم",76,"م",1,1],["ليس عجيباً جزَعٌ إنَّما الْ","عجيبُ أن أبقى وقد بانوا",77,"ن",3,0],["لَيسَ عَن حُسنِها لِلمُؤرخ بُدٌّ","فيهِ زَفت محمد اِبن الأَتاسي",78,"س",2,0],["ليس عمر الفتى السنين طوالا","كل دهر مصيره للنفادِ",79,"د",1,0],["لَيسَ عَلى عاشِقه","في حُبِّه مِن حَرَج",80,"ج",1,0],["ليس على لهونا مزيد","ولا لحمامنا ضريبُ",81,"ب",1,1],["لَيسَ عِندي وَإِن تَغَضَّبتَ إِلّا","طاعَةٌ حُرَّةٌ وَقَلبٌ سَليمُ",82,"م",1,0],["ليس عيب به وحاشا سوى أن","ليس فيه يعاب إلا الثناء",83,"ا",2,0],["ليس عن شيء سوى بعدك قد","شفهم وجدا وأوداهم هياما",84,"م",2,0],["لَيْسَ عِندِي مَا يُسَاوِي","مِنْ أثَاثٍ مَائِتَيْن",85,"ن",1,0],["ليس عصر النور فيما زعموا","غير عصر النار والخلق المشين",86,"ن",1,0],["ليس عَزمي رضىً وعن طيبِ نَفسِ","إنّما كان بالقضاءِ اضطِرارا",87,"ر",2,0],["ليسَ عَليهَا حرَجٌ لأنَّها","بَدرِيّةٌ تَفعلُ مَا تشاءُ",88,"ا",2,0],["ليسَ عليّ أن أموت عارُ","والعارُ في الناسِ هوَ الفِرارُ",89,"ر",1,1],["ليس على الأرض في زماني","من شانه في الحديث شاني",90,"ي",1,1],["ليس عهدي إني جنيت ذنوباً","إن عهدي توافر الحسنات",91,"ت",1,0],["ليس عيدُ المحب قصدَ المصَلَّى","وانتظارَ الجيوش والأعوانِ",92,"ن",1,1],["لَيْسَ عِنْدِي مِنَ الهُمُومِ حَدِيثٌ","كُلَّمَا سَاءَنِي الزَّمَانُ سَدِرْتُ",93,"ت",1,1],["ليس عندي في هواكم","قد بدا لي قد بدالي",94,"ل",2,0],["ليس عنها مفر","ولا دونها محجر",95,"ر",1,0],["ليس عبد عن العبادة لاهى","مثل عبد صلى وصام وزكى",96,"ك",2,0],["ليس عندي المعشوقَ بل كل غُصنٍ","فيهِ عندي المعشوقُ حينَ تميس",97,"س",1,0],["ليس عندي غير هذا","لا ترم مني زيادة",98,"د",2,0],["ليس عندي من الدُّموع سوى ما","وهبتْهُ عصارة الأكبادِ",99,"د",1,0],["ليس عندي شيء جديد من الأخ","بار غير الهمّ الذي اشتكيه",100,"ي",2,0],["ليس عاراً للمبدعين استعاروا","أي معنىً من أي لفظ ووزن",101,"ن",1,0],["ليس عندي سحر ولكن قريض","ميت الحسن منه يبعث حيا",102,"ي",2,0],["ليس عيناي لي بكافيتين","فوق عيني أبتغي ألف عين",103,"ن",1,0],["ليس عند الخلق من خبر","عنك يا أغلوطة الفكرِ",104,"ر",1,1],["لَيْسَ عَبْدٌ أتاكَ وَهُوَ نَحيبُ","يا سَميعَ الدُّعاءِ أَنْتَ مُجيبُ",105,"ب",1,0],["ليس عار على امرىء يتردّى","في طلاب العلى ثياب الهوان",106,"ن",1,0]