t/poem24474.html","عموديه"],[556,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101505","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48588","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122309","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64210","المتقارب"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70945","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103231","الطويل"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105248","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28518","الكامل"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139813",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204500","الخفيف"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123887","المتقارب"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33131","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77075","الوافر"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111320","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73429","الرمل"],[5060,"عتبي عليك","https://www.poetsgate.com/ViewPoem.aspx?id=214488",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5431,"هيتَ له ....","https://www.poetsgate.com/ViewPoem.aspx?id=202400",""],[5459,"لن تضيع ..","https://www.poetsgate.com/ViewPoem.aspx?id=196959",""],[5672,"شهد الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=206435",""],[5674,"الحزن حبر دواتي","https://www.poetsgate.com/ViewPoem.aspx?id=189930",""],[5674,"الحظ العاثر","https://www.poetsgate.com/ViewPoem.aspx?id=207917",""],[5992,"أرى الغيث ترسمُ شكلَ النباتِ","https://www.poetsgate.com/ViewPoem.aspx?id=41833",""],[6103,"تشتاقُكُم عيني","https://www.poetsgate.com/ViewPoem.aspx?id=203242",""],[831,"ذكرى جلوسك مظهرُ الأوطانِ","https://diwany.org/%D8%B0%D9%83%D8%B1%D9%89-%D8%AC%D9%84%D9%88%D8%B3%D9%83-%D9%85%D8%B8%D9%87%D8%B1%D9%8F-%D8%A7%D9%84%D8%A3%D9%88%D8%B7%D8%A7%D9%86%D9%90/","الكامل"]],"verses":[["كَم أَدورُ البِلادَ شَرقاً وَغَرباً","وَأَرودُ الأَرزاقَ غَوراً وَنَجدا",0,"د",2,0],["كما دعا جود مولانا الوزير رجا","لباه ذو فضةٍ تجري وعقيان",1,"ن",1,0],["كَم أَدَّتِ الأَيّامُ لي ذِمَّةً","مَحفوظَةً في ضِمنِهِ ما تَضيع",2,"ع",1,0],["كَم أَدلَجَت بي سَخوَةٌ مِن لَيلَةٍ","شَهباءَ أَو سَمِعَت زَئيرَ المُخدِرِ",3,"ر",1,0],["كَم أَديبٍ فَطِنٍ عالِمِ","مُستَكمِلِ العَقلِ مُقِّلٍ عَديمِ",4,"م",1,1],["كَما دَعا الرّوْضُ إذ فاحَتْ نَواسِمُهُ","رُوّادَهُ بِنَسيمِ النّوْرِ في السَّحَرِ",5,"ر",1,0],["كَم أَدَّتِ الأَيّامُ مِن حَدَثٍ كَفَت","أَيّامُهُ حَدَثَ الزَمانِ المُعضِلِ",6,"ل",1,0],["كَم اِدَّعى الطُهرَ ناسٌ ثُمَّ كَشَفَهُم","مَرُّ الزَمانِ فَكانَ القَومُ أَرجاسا",7,"س",2,0],["كَم ادعى القوم إحسانا بما نظموا","من القريض وما للقوم إحسان",8,"ن",1,0],["كَمْ أَدِيبٍ عُدُّهُ فِي قَوْمِهِ","عَدُّ أَلْفِ وَهْوَ صِفْرُ فِي الْحِسَابْ",9,"ب",1,0],["كَم اِدَّرَأَت مِن نِقمَةٍ بَرَكاتهُ","وَدَرَّت بِهِ مِن نِعمَةٍ حافِل ضَرعا",10,"ع",2,0],["كم آدمي لا يعدّ من الورى","إلاّ بشكل الجسم والتشبيه",11,"ي",2,0],["كما دعوتُ التي قامتْ بقرقرها،","تَمْشي كَمَشْيِ ضَعِيفٍ خَرّ فَانْجَدَلا",12,"ل",2,0],["كَم اِدخرت لِهَذا اليَوم مِن رَجُل","فَلَم يكنهُ وَأَخلاقي تَسامحهُ",13,"ح",2,0],["كم أدلجوا كم أزعجوا كم أسرجوا","بتسارعٍ للموت لا بتمهّل",14,"ل",1,0],["كَمادِح قَوم شُرِفوا بِمُحَمَدِ","أَمَولايَ صنى عَن زَمان تبدلا",15,"ل",2,0],["كَم اِدَّعوا صدقَهم يَوماً وما صدقوا","سلَّمتُ ذاكَ فما أَرجو بصدقهمِ",16,"م",1,0],["كَم أداجي في هواهُم كاشِحاً","أَعجزَ الكتمانُ مَن حبَّ فَداجى",17,"ج",2,0],["كَم أُداري عَواذِلي فيكَ وَالعُم","رُ قَصير وَشَرح حالي مطوّل",18,"ل",1,0],["كم أَدمُعٍ ذُلُلٍ فاضَتْ غداتَئِذٍ","فسايَرتْ ما حدَوْا من أَينُقٍ ذُلُل",19,"ل",1,0],["كما دعا داعي الهوى حين دعا","أنَّها رقٌّ له ما بقيت",20,"ت",1,0],["كم أُديرَتْ عليه كأسُ ثناءٍ","هزّ أعطافَه إليها ارتِياحا",21,"ح",2,0],["كم أُدارِي عَنَتَ الأيّام في","غَبْنِ حظِّي وأُطاطِي للخطوبِ",22,"ب",1,0],["كما دَلَّ برقُ الغاديات على الحَيا","فأوسع بُشرى كلِّ مُقْوٍ ومُصرم",23,"م",1,0],["كما دبت الصهباء لما تجوهرت","بجسم صريع فيه غنّت حمائم",24,"م",1,0],["كم أُداري وقلّما نفع التّعْ","ليلُ هَمّاً لا يبرح الحَيْزوما",25,"م",2,0],["كُم أُداري العِدا فَهل في غيوب ال","لَه يومٌ أخشى بِه وأدارى",26,"ر",2,0],["كم أداوي وكم أداري طباعاً","فيكَ ساءَت فالبُعدُ خير دواءِ",27,"ا",2,0],["كم ادعيتم زمان الكأسِ إنكمُ","أصبحتمُ ليَ أنصاراً وإخوانا",28,"ن",2,1],["كم أداوي القلب قلت حيلتي","كلما داويت جرحا سال جرح",29,"ح",1,0],["كما درَّج الماءَ مرُّ الصَّبا","ودبَّج وجهَ السماءِ الحبك",30,"ك",1,0],["كم أدخل اللصَّ جارُه فغدَا","في داره قاعداً بغير كِسا",31,"س",2,0],["كَمَا دَعَا داعِي كِلابٍ مُخْلِ","وَقُلْتُ إِذْ وَسْوَسَ أَهْلُ السَمْلِ",32,"ل",1,0],["كما دارت رحا من فوق حَبٍّ","تداولها أكف المسغبينا",33,"ن",2,0],["كما دَبَّ صافي الخمرِ في مُخِّ شارِبٍ","يميلُ بِعِطفَيهِ عن اللُبِّ ذاهِلِ",34,"ل",1,0],["كم أدارت صرفا بكأس دهاق","عتقتها من بعد خمسين عاما",35,"م",2,0],["كَم أَدرَكَت بِنَداكَ مِن أَوطارِها","خَطَراً وَكَم قَرَعَت بِسَيفِكَ مِنبَرا",36,"ر",2,0],["كم ادعيتم أن لا فرق عندكم","في الحكم ما بين درزي ونصراني",37,"ن",2,0],["كم أديب دل الخمول عليه","وشهير لم يُجدِ فيه الصياح",38,"ح",1,0],["كما درج الماء مر الصبا","ودبج أفق السماء الحبك",39,"ك",1,0],["كَما دانَ هَذا الناسِرُ المَلِكُ وَفدَهُ","بِما هالَ إِذ تَرقى التِلالَ قِيامُهُ",40,"م",2,0],["كما دون قرن الثور غاصت رصاصةٌ","لأسماكه فيما المنية تعتد",41,"د",1,0],["كَما دَلَّت عَلى هذا نُصوص","تُؤَيِّدُ ما قَضيت بِذا المَقال",42,"ل",1,0],["كم أدعو بالويل فيكم يالفهر دمي","هدر ورحلي منكم راح يغتنم",43,"م",1,0],["كَم أُداري فيكَ لُوَّامي وَمَن","يَعذِلُ الُمشتاقَ ما أَجهَلَهُ",44,"ل",2,0],["كم أدّعي أنّي سَلَوتُكَ عامداً..","وأقولُ إني قدْ نسيتُ.. وأكذبُ !",45,"ب",1,0],["كم أدب السيف من رأس فعلمه","-بعد الفوات - الذي يُنفى به الهلعُ",46,"ع",1,0],["كم أدمنت أخطاءه بحفاوة","كالوشم بين نهودها متغلغله",47,"ل",2,0],["كمْ أدمعٍ شيّعَتْ في الأمة الشهدا","وأحرفٍ من دماء تندبُ البلدا ..",48,"د",2,1],["كمْ أدارَ الشهدَ من شفتهِ","فسكرنا بين خمرِ الشفتينْ",49,"ن",1,1],["كم أدمت الأوجاع حبل نجاتي","الحزن قافيتي وحبر دواتي",50,"ت",2,1],["كم أدمى فينا أضلاعاً","وطغى كالبركان الثائر",51,"ر",1,0],["كما دوَّروا للصغير الحروف","بنقطٍ فحقَّقَها خَطُّه",52,"ه",1,0],["كمْ أدَّعي أنِّي بغير وصالكمْ","أبدو صبورًا غير أنِّي كاذبُ",53,"ب",1,0],["كم أدرك المتماديَ المتواني","رحماكم فينا لنذكركم إذا",54,"ذ",2,0]]}