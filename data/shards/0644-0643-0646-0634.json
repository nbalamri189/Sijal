"],[5277,"روحُ العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189672",""],[5284,"خير الزَّائرين","https://www.poetsgate.com/ViewPoem.aspx?id=188851",""],[5413,"الحب","https://www.poetsgate.com/ViewPoem.aspx?id=208710",""],[5431,"أنين شوق....","https://www.poetsgate.com/ViewPoem.aspx?id=191398",""],[5431,"حول الحرام ترى اللسان مطقطقا","https://www.poetsgate.com/ViewPoem.aspx?id=197841",""],[5606,"ياوقت ماودك ترده؟","https://www.poetsgate.com/ViewPoem.aspx?id=197801",""],[5781,"نَصْرٌ ووعد","https://www.poetsgate.com/ViewPoem.aspx?id=190950",""],[5848,"أطلق شنب","https://www.poetsgate.com/ViewPoem.aspx?id=48988",""],[5915,"يَا مرج كحل وَمن هذي المروج لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=189109",""],[5956,"بسمة ذات إعجاب بموهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182292",""],[5956,"أحلام شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183354",""],[5956,"شكر حقيقيّ","https://www.poetsgate.com/ViewPoem.aspx?id=193437",""],[5956,"خالد باعشن مقدَّسٌ في نفسي كقداسة الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=193793",""],[5956,"هلّا منحت إليّ بعض محبة","https://www.poetsgate.com/ViewPoem.aspx?id=194016",""],[5956,"سيُنْصِفُها التاريخ إن شاء الله ولو ليس يهمها التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=207820",""],[6127,"يا نونُ ... يا قلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188718",""],[6218,"عبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65866&r=&rc=20",""],[6259,"لوكان حرُّ الوجد يُعقب بعده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59419&r=&rc=67",""]],"verses":[["لَكِنَّ شَيبَ الرَأسِ إِن يَكُ طالِعاً","عِندي فَوَصلُ البيضِ أَوَّلُ غائِرِ",0,"ر",1,0],["لَكِنْ شَجَانِي خَطْبٌ","وَصَفْتَهُ لِي مُبِينَا",1,"ن",2,0],["لَكِنْ شَجَانِي الطِّرْسُ قَرَّ بِضَمِّهِ","وَمَشُوقُ صَدْرِي دَائمُ الخَفَقَانِ",2,"ن",1,0],["لكن شفيت وما شقيت فحبَّذا","إني برجلك قد وقيت براسي",3,"س",2,0],["لكن شهوته اللِّبا","ءُ فما يُحبُّ سوى الحواملْ",4,"ل",1,0],["لكن شرعتُ على بحرٍ له حدبٌ","تغشى غواربُه الركبانَ كالظّلَلِ",5,"ل",1,0],["لَكِن شَهِدتُ شَبيبَة وَكُهولَةً","وَمُنىن وَأَحلاماً بِغَيرِ حِسابِ",6,"ب",1,0],["لكن شموس جاريا","ت ضمن هاتيك السحائب",7,"ب",1,0],["لَكُنَّ شُهوداً أَن يُكافِرَ نِعمَتي","بِعَطفِ النَقا إِذ عاصِمٌ غَيرُ قائِمِ",8,"م",1,0],["لَكِنَّ شَمسَ الدينِ مُذ مَلَّني","صَوَّحَ نَبتي وَذَوى غَرسي",9,"س",2,0],["لكن شكّاً بما تجن","خيّم فوق العقول جمعَا",10,"ع",2,0],["لكن شعباً يكون القائدون له","من الألى عرفوا بالشر ينخذل",11,"ل",1,0],["لكن شيئا داخلي يلتظي","فيخفق الثلج ، ويظمى الربيع",12,"ع",1,0],["لكن شُغِفْتُ بأن أُقابلَ بينه","أبداً وبين خِلافه ومثيله",13,"ل",2,0],["لكن شعري برغم الدهر يكلؤه","وهل لذي الحسن غير الشعر أكنان",14,"ن",1,0],["لكِن شَبابي وَالغَرامُ تَلاشيا","فَهُما كَنَفخَةِ دُخنةٍ من فيكِ",15,"ك",1,0],["لكن شقاوة أقوام وحظهم ال","منحوس أوقعهم في الشر والشرر",16,"ر",1,0],["لكن شَغَفت بحب آ","ل البَيت بَيت بني قَصى",17,"ص",2,0],["لكن شتان بين العبد في شرفٍ","وبين سيده والحقُّ لا يخطو",18,"ط",2,0],["لك نشرُ الأزهار صبحاً ثناءً","وسنا الشهب نسبةً وخلالا",19,"ل",2,0],["لكن شمائلُ فِي النَّدى وكَّلتها","بعفاةِ جُودِكَ فتيةٌ أَغمارُ",20,"ر",1,0],["لكنَّ شوقاً حرُّه في أضلعي","جنايةٌ لا يُملَكُ اغتفارُها",21,"ر",3,0],["لكنّ شيطانَهُ منبّهاً يقفُ:","حذارِ أنْ تدّعي بأنّك الأحدُ",22,"د",1,0],["لكنَّ شِعري يَزدهي بِمدحهِ","كالعِقدِ يزدهِي بحُسن العُنُقِ",23,"ق",1,0],["لكنَّ شيمتنا تقول لنا صفحوا","عنهم عسى ان يقلعوا عن ذا العدا",24,"د",2,0],["لَكنَّ شَيطان الحَريصِ أَقوى","إِذ طالَما ساقَ إِلَيهِ البَلوى",25,"ل",3,0],["لكن شجاعٌ يقصِّر","عنه كلُّ غضَنْفر",26,"ر",1,0],["لكن شرعي فيهم موضح","قصد السبيل الأسوع الأرحبِ",27,"ب",1,0],["لكن شعور بذل النير أرهقنا","وأسكتت شادياتِ الروض غربان",28,"ن",1,0],["لكن شأن النسر تحليقه","وقصده أنى يطيق الثواء",29,"ا",2,0],["لكنَّ شيبيَ بادٍ","وشيبُهُ في غِلافِ",30,"ف",1,0],["لكنّ شدّد ولكي مع لا وما","وصل ألم عدا خلا حاشا بما",31,"م",2,0],["لكن شجانَا فقدُ سادتنا","فانهدّ منّا الصّبْرُ والجَلدُ",32,"د",1,0],["لكن شجاني زمنٌ فادحٌ","وحادثٌ من خطبهِ أشنعُ",33,"ع",1,0],["لَكِنَّ شُكري لِمَن لَو لا مَكارِمُهُ","لَكُنتَ فَلَّلت مِن نابي وَمن ظُفُري",34,"ر",2,0],["لكِنَّ شَمسَ مُلوكِ الأَرضِ قاطِبَةً","عَبدُ العَزيزِ بِلا مَينٍ وَلا كَذِبِ",35,"ب",1,0],["لكن شوقي لنيل العز يمنعني","عن الذي ليس من شأني ولا شغلي",36,"ل",2,0],["لكن شهدت رجوعهم فوجدتهم","يتحدثون عن الدخول فحومل",37,"ل",1,0],["لكن شمسك في الفضاء تربعت","فتوهم التكرار محض محال",38,"ل",1,0],["لكن شكتك الغراء فاز بها ال","عدى وهكطور فيها الآن متسم",39,"م",1,0],["لكن شاني غير شأنك إذ بدا","لك من عبارة عبرتي التعبير",40,"ر",1,0],["لكنَّ شهم العلى المولى السنيُّ لهُ","صفات حسنٍ سمت بالوصف أبدارا",41,"ر",2,0],["لكن شكت عنِّي الهوَى أدمُعٌ","ما ظفِرت منهم بغير الهوان",42,"ن",1,0],["لكِنَّ شَعبي ما زَالَ يَرجُو","مِن كُلِّ خُسْرٍ نَيْلَ المَكَاسِبْ!",43,"ب",1,0],["لكنَّ شكرَ الله أمرٌ واجبٌ","ما إن جرتْ لعباده النعماءُ",44,"ا",2,0],["لكنَّ شمسَ الهدى للناس مشرقةٌ","أنوارُها مزقت من ليلِكم حجبا",45,"ب",2,0],["لكنَّ شوقَك كان أكبرَ شوقِنا","حتى رحلتَ فصاحتِ الأبواق",46,"ق",1,0],["لكنّ شيطان الغواية رافعٌ","علَمَ الغرور لكي يُنَسِّي المُنتهى",47,"ا",1,0],["لكنّ شيطانَ الهوى متربّصٌ","بالمؤمنين ومّن لهم طهْرُ الصّدور",48,"ر",1,0],["لكنّ شعبَهُمُ أثارَ عجاجةً","في الشرقِ طافِحةً بأهوال الرّدى",49,"د",2,0],["لَكِنَّ شِعْرَكَ كَالنَّسَائِمِ خَمْرُهُ","فَإِذَا الحُضُورُ تَرَنَّحُوُا سَنُصَفِّقُ",50,"ق",1,1],["لكن شهرت السيف من دونهم","تنقذهم من حومة الامتهان",51,"ن",1,0],["لكنَّ شعريَ يَسْتَبيحُ جمالَها","فَحَرامُها وقتَ القصيدِ حَلالُ",52,"ل",1,0],["لكنّ شعرَك مثلُ العودِ يطربني","وفي زجاجةَ كأسِ العشقِ يسكبني",53,"ن",2,0],["لكنَّ شهرَ الخيرِ تُزهرُ عندَهُ","ألأَرضُ والأنهارُ والأشجارُ",54,"ر",1,0],["لكنَّ شيئا لا يقول يقول لي","الحبُّ أكبرُ أنْ يرى مقتولا",55,"ل",2,0],["لكنّ شوقي بركانٌ ومحتبسٌ","يغلي بطاقته ياهول مااحتُبسا",56,"س",2,0],["لكنّ شكلا في النذالة لم تلد","أمٌ بسحنته الكريهة مطلقا",57,"ق",2,0],["لكن شوقي وصل حده","ياعين من دمعتك هلي",58,"ل",2,0],["لكِنَّ شِعْري على الأَسْماعِ مِئذَنَةٌ","فالضَّادُ لوْ سَجَدَتْ صَلَّى بِذي الغُرَرِ",59,"ر",1,0],["لكن شتات الفكر يخلف ماتبقى من عقول","ووقت الفراغ يسبب الفوضى لكل العاطلين",60,"ن",1,0],["لَكِن شيمتها أَخْلَاق صَاحبهَا","فَمَا تفارقها كَيْفيَّة الخجل",61,"ل",1,0],["لكنَّ شعري خصيبٌ في تخيُّلِهِ","شتَّى الخيال الذي بالكذبِ أصقُلُهُ",62,"ل",2,0],["لكنَّ شغلي في نطاق مكارهي","بالرغم أنهُ واجبٌ ونقودُ",63,"د",1,0],["لكنْ شكرتك بل أرجو إليك وفاً","يكفيك أنك لم تجلب ليَ الفلَجا",64,"ج",2,1],["لكنَّ شيئاً ليس في مقدوره","هو جعل نفسي أن تعيش بقربهِ",65,"ب",2,0],["لكنّ شِعري مالكٌ وحشيّةً","عِشْقيةً وتوسُّماً وعنادا",66,"د",2,0],["لكنَّ شِعري رغم عنّي ماردٌ","يعلو عليَّ ولستُ أفهم عُمْقهُ..",67,"ق",2,0],["لكنَّ شمساً لطه دكدكتْ ظُلَماً","وَصَيَّرَتْها هباءً والمَلَا حُطَمُ",68,"م",1,0],["لكنَّ شيئاً ما سيسألُ : من أنا؟","فأدورُ ثمَّ أدورُ ثم أدورُ",69,"ر",1,0],["لكن شجيتُ بمن يبيت مسلّماً","خالي الضلوع ولا يُحسّ شجاكا",70,"ك",2,0]]}