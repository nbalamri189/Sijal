{"poems":[[55,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[65,"وأشلاء دار بالحمى تلبس البلى","https://www.aldiwan.net/poem45691.html","الطويل"],[65,"معاهدها والعهد ينسى ويذكر","https://www.aldiwan.net/poem46143.html","الطويل"],[30,"على المتردفات بكل خرق","https://www.aldiwan.net/poem5155.html","الوافر"],[30,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[324,"ويوم نهاوند شهدت فلم أخم","https://www.aldiwan.net/poem23884.html","الطويل"],[445,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[754,"","https://poetry.dctabudhabi.ae/diwan/poem/18846","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147347","الطويل"],[5431,"فإن الصبرَ من عزم الأمور","https://www.poetsgate.com/ViewPoem.aspx?id=187730",""],[6275,"مهرجان من حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83609&r=&rc=1",""]],"verses":[["وَأُشلي عَلى المُقرَباتِ السِياطَ","إِذا ضَمَّها البَلَدُ البَلقَعُ",0,"ع",1,0],["وَأَشلاءِ دارٍ بالحِمى تَلبَسُ البِلَى","ومنها بكفَّيْ كُلِّ نائبَةٍ شِلْوُ",1,"و",1,1],["وأشْلاءِ دارٍ بالمُحَصِّبِ منْ مِنىً","وَقَفْتُ بِها والأرْحَبيّ تَهْدِرُ",2,"ر",1,0],["وَأَشلاءٍ لِناجِيَةٍ تَرَكنا","عَلَيها العاكِفاتِ مِنَ النُسورِ",3,"ر",1,0],["وَأَشلاءُ لَحمٍ مِن حُبارى يَصيدُها","إِذا نَحنُ شِئنا صاحِبٌ مُتَأَلَّفُ",4,"ف",1,0],["وأشلاء مبعثرة تمنّت","على البيد الشقائق والأقاحا",5,"ح",2,0],["وَأَشلاؤُهُم في وَأيِ خُردٍ مُقيمَةٌ","تَنوبُهُم عيسُ الذِئابِ العَواسِلِ",6,"ل",1,0],["وأَشلاءِ قفرٍ شاكَهَتْ فِيهِ مَا عَفَتْ","خيولُكَ من معنىً لَهُنَّ ومن رَبْعِ",7,"ع",1,0],["وَأَشلاؤُهُم في وَأيِ خُردٍ مُقيمَةٍ","نُفوسُهُمُ غَبسُ الذِئابِ العَواسِلِ",8,"ل",1,0],["وَأَشْلاءُ تِمْثَالٍ جَمِيلٍ مُحَطَّمٍ","وَأَسْمَالُ طِفلٍ خَائِفٍ يَتَرَقَّبُ",9,"ب",1,0],["وأشلاءٌ تطيرُ بلا جناحٍ","ولم يُرفق بشيخ أو صغيرِ",10,"ر",1,0],["وأشلاء زهر تناثرن مثلي","وتسفر أمواجه عن لقاء",11,"ا",2,0]]}