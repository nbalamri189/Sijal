956,"","https://poetry.dctabudhabi.ae/diwan/poem/77086","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125802","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86413","الرجز"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78212","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54399","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117249","المديد"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117226","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33491","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33477","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33549","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33456","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33505","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33296","المديد"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72840","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204313","الطويل"],[4869,"سكر قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=151565",""],[5145,"سفرت لنا عن سنة البدر","https://www.poetsgate.com/ViewPoem.aspx?id=108134",""],[5178,"يا كسروياً في القديم","https://www.poetsgate.com/ViewPoem.aspx?id=181298",""],[5183,"لن تراني","https://www.poetsgate.com/ViewPoem.aspx?id=180161",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5367,"سبيل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=197666",""],[5497,"إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=205946",""],[5643,"أصبح الملك واهي الأرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=181292",""],[5790,"بأبي غزال تائه متصلف","https://www.poetsgate.com/ViewPoem.aspx?id=112076",""],[5829,"الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=151769",""],[5943,"إلا شذانا ففي الجنات مخلوق","https://www.poetsgate.com/ViewPoem.aspx?id=53801",""],[5956,"رشادٌ مستديم","https://www.poetsgate.com/ViewPoem.aspx?id=192321",""],[6032,"ترنيمة عشق إلهية","https://www.poetsgate.com/ViewPoem.aspx?id=181501",""],[6075,"عرفتك عشفا","https://www.poetsgate.com/ViewPoem.aspx?id=193315",""]],"verses":[["فَوَحيُ عَقلي يَقولُ هَذا","وَوَحيُ قَلبي يَقولُ ذاكا",0,"ك",2,0],["فَوَحَقَّ مَجدِكَ وَهوَ جَهدُ ألِيَّتي","وَنَداكَ وَهوَ لِكُلِّ خَطبٍ مَدفَعُ",1,"ع",1,0],["فوحقّ جود يديك لولا أنت ما","سميت نفسي الآن باسم الشاعر",2,"ر",1,0],["فَوَحَقِّ نَعْلَيْها وما وَطِىءَ الحَصَى","شَيءٌ أَعَزُّ عَلَيَّ مِنْ نَعْلَيْها",3,"ي",3,0],["فَوَحشُ نَجدٍ مِنهُ في بَلبالِ","يَخَفنَ في سَلمى وَفي قِيالِ",4,"ل",1,0],["فوحَقِّ نِعمَتِه عليَّ وطَوْلِه","قسَماً يقول السامعون كفى بِه",5,"ب",2,0],["فَوَحَقّ طيبِ رضَى الحبيب ووَصلِهِ","ما مَلّ قلبي حُبّهُ لمَلاله",6,"ل",2,0],["فوحدهَا في دولةٍ عربيةٍ","تُزاحم في ركب العُلا بالمناكبِ",7,"ب",1,0],["فوح قلبي كل مصبح فوح دلّه","ويابري حالي وياجرّة ونيني",8,"ن",2,1],["فوحقكم ما حال عن أبوابكم","أبداً ولا وجهاً يرى لحاله",9,"ل",2,0],["فَوَحقّ مَنْ أنا نجله مِن هاشم","قَسَماً يتمّ من الحسابِ لأربعِ",10,"ع",1,0],["فوحّد على تلك المثاني فإنّها","بلوحك تُقرا والتجلّي المقرّر",11,"ر",1,0],["فوحق منتعنو الوجوه لوجهه","ذي العزة الباقي وَكل فاني",12,"ن",2,0],["فَوَحَّدَ المَعنى وَقَدَّسَ اِسمَهُ ال","أَعلى وَلِلوَصفِ تَلا كَما أَمَر",13,"ر",1,0],["فَوَحِّد بِرُؤياها وُلاةَ ظُهورِها","كَتَوحيدِكَ الأَشخاصَ في النَوعِ وَالنُطقِ",14,"ق",1,0],["فَوَحَّدتُ وَلا تَوحيدٌ","إِلّا لِفَتىً مِثلي",15,"ل",2,0],["فَوَحقِّ فَخر الكائِنات وَآلِهِ","ما اِعتاضَ باذل وَجهِهِ بِسؤالِهِ",16,"ه",1,0],["فَوَحق الهَوى وَحبي ما حل","وَصالي لمن عَصى رُحمانُه",17,"ن",2,0],["فَوَحَقِّهِ لَم أَرج غَير نَوالِهِ","هُو لا سِواهُ المُنعِم المُتَفَضِّل",18,"ل",1,1],["فَوَحَقِّ اللَه انَّ ال","لهَ لَم يَثبت أَذاها",19,"ا",3,0],["فوحقّك دأبي هجرهم","أبدا حتى يفنى أمدي",20,"د",2,0],["فوحدها بعد التمزق والتقى","على حبه كهل لها ووليد",21,"د",1,0],["فوحد الله بالإسلام فرقتهم","على يديه وفي توحيدها العجب",22,"ب",1,0],["فَوَحَقِّ الرَسولِ ما قُلتُ حَرفاً","مِن جَميعِ الَّذي حَكاهُ الرَسولُ",23,"ل",1,0],["فَوَحَقِ وَفدِ هَواكَ لا","زَحزَحتُ سِرَّكَ مِن فُؤادي",24,"د",2,0],["فَوَحَقِّ رَأسِ إِخائِنا قَسَماً بِهِ","إِن كانَ مِمّا قيلَ حَرفٌ واحِدُ",25,"د",1,0],["فو حقه ما نال إلا حقه","والدر أحسنه على الحسناء",26,"ا",2,0],["فوحقّ ما في ثغره من لؤلؤ","رطب ومن مشمولة وأقاح",27,"ح",1,0],["فوحق نعمتك التي من أجلها","أصبحت محسوداً عليك من العدا",28,"د",2,0],["فوحق ودك إنني","ما كنت قط بمستضام",29,"م",1,0],["فوحدة ليبيا لا بد منها","لتنفيذ القرار بها دواما",30,"م",2,0],["فَوحقّ الحبِّ لم يَصْ","دُقْك مَن بلّغ عنّا",31,"ن",2,0],["فوحيده قد عاجلته منية","ذهب الجمال بها وزال الرونق",32,"ق",1,0],["فوحقّ جاهك إنّني بكَ مُغرم","واللّه يعلمُ أنّني أهواكا",33,"ك",2,0],["فوحدتها في كل شيء تكثرت","وصورتها في كل كون تصورت",34,"ت",1,0],["فوحشته أنس وفي البعد قربه","وفي موته وجدا عليه حياته",35,"ت",2,0],["فَوَ حقِّهِ ووَحقِّ آياتٍ بِهِ","تُبْدي العيونُ لِذكْره اسْتعْبارَا",36,"ر",2,0],["فوحشُ الرّزايا للرزيّةِ خُضّرٌ","وطيرُ المنايا بالمنيّةِ حُوّمُ",37,"م",1,0],["فَوَحَقِّ أيام الحِمى ووصالنا","قَسماً بها وبنعمةِ الخَلاقِ",38,"ق",1,0],["فوحقّ مَن قَد كانَ أخرج يونساً","بِمشيئة قدريّة من نونهِ",39,"ن",2,0],["فَوحقّ مَن قَد كانَ صوّر آدماً","في الخلقِ من حمأٍ ومن صلصالِ",40,"ل",1,0],["فوحقّ مَن أوحى وخصّ بوحيه","خيرَ العبادِ وسيّد الحرمينِ",41,"ن",1,0],["فَوَحَقُّ البَيانِ يَعضُدهُ البُر","هانُ في مَأقَطُ أَلَدِّ الخِصام",42,"م",1,0],["فوحق الغرام لولا سطورٌ","منه قد أحيت المشوق العليلا",43,"ل",2,0],["فوحق عيشك غير تنميق الكلا","م على المعيشة ما لنا امكانُ",44,"ن",1,0],["فَوَحَقِّهَا مِن تِسعِ آيَاتٍ لَقَد","جَاءَت بتَأيِيدي عَلَى أَعدَائِي",45,"ا",2,0],["فَوَحَقِّ الإِلَهِ إِنّي لِعَينٍ","أَسهَرَتني عَينُ وَباءٍ وَدالُ",46,"ل",1,0],["فوحّدوا في سبيلِ اللهِ نهجكم","حتى نرى القدسَ عادت والعدا انهاروا",47,"ر",3,0],["فوحقه مايستخف بحقه","وهو الخطير وللذمام خفير",48,"ر",1,0],["فَو حق من سَمك السَماء بِقُدرة","وَالأَرضُ صير لِلعِبادِ مهادا",49,"د",2,1],["فوحسنه لقد انتدبت لوصفه","بالبخل لولا أن حمصاً داره",50,"ر",2,0],["فَوَحقِّهِ لاَ يَقبَلَنَّ نَصِيحَةً","مِن عاذِلٍ يُبدِى بِها استنصاحَا",51,"ح",2,0],["فوحقه لو زار زورة عاطف","وعصى كما أَعْصي عليه العاذلا",52,"ل",2,0],["فوحق دولتك التي نوهت بي","فيها كما نبهت مني خاملا",52,"ل",2,0],["فوحق نعمتك التي ملأت يدي","وكفى به قسماً أليّة صادق",53,"ق",1,0],["فوحقه ما خان إلا وافياً","واختص بالنسيان إلا ذاكرا",54,"ر",2,0],["فوحقِّ أنعمك التي في روضها","غصن المنى ما زال غضّاً مثمرا",55,"ر",2,0],["فوحقهم ما صادفت آمالهم","من دون غمر نداه باباً مغلقا",56,"ق",2,0],["فوحق أيام لبست نعيمها","في القرب منك أودُّ لو أن تشترى",57,"ر",2,0],["فوحقكم مذ غبت عنكم لم يزل","منى الفؤاد عليكم يتقطع",58,"ع",1,0],["فوحَّد العين لا تثنى","فالنسب الغرُّ ما تحيل",59,"ل",1,0],["فَوَحَقِّ نِعمَتِكَ التَي أولَيتَنِي","وَجَعَلتَ قَلبِي وَاعِيَ القُرآنِ",60,"ن",1,0],["فوحدة الوجود في اصطلاحنا","كناية عن رؤية الودود",61,"د",1,0],["فَوَحق مَجدكم الأَثيل وَإنه","قسم لَقَد كَلفت بِكُم أَحشائي",62,"ي",1,0],["فَوَحَقَّ أغصان القدو","د ولين هاتيك المعاطفْ",63,"ف",1,0],["فوحد اللّه يا مغرور واتقه","لا تبغ دنيا سوى الاسلام فاعلم",64,"م",1,0],["فوحِّدوا الرأي لا يُلهيكمُ غرضٌ","عن نصرِ مصر ولا تستبعِدوا الأرَبا",65,"ب",2,0],["فَوَحِّدوا الرَأيَ لا يَلعَب بِلُبِّكُم","هَوى النُفوسِ فذا داعً إِلى الزللِ",66,"ل",1,0],["فوحشة الناس أُنسٌ إذ يمازجهم","فتىً بضاعتُه في الفضل مزجاة",67,"ه",1,0],["فوحقِّ ربِّ العرشِ فلاّقِ النوى","ما استعذَبَ الصبُّ الغرامَ ولا ثوى",68,"ث",3,0],["فوحدتنا وقد عادت سيدنو","بعودتها لنا الأمل البعيد",69,"د",1,0],["فوحد الجمع وطار قلبه","بلا جناحٍ خافقاً يضطرب",70,"ب",1,0],["فَوَحَقَّ حِكمَتِكَ الَّتي آتيتني","حَتّى شَدَدتَ بِنورِها بُرهاني",71,"ن",2,0],["فَوَحَقَّ جَبّارٍ عَلى العَرشِ اِستَوى","مِن غَيرِ تَمثيلٍ كَقَولِ الجاني",71,"ن",2,0],["فَوحقّ عهد بيننا متقادم","ما زلت في عمري عليه باقيا",72,"ي",2,0],["فَوَحَق مصرٍ ما بمصرٍ حاجة","إلا إلى العزمات والإيثار",73,"ر",1,0],["فوحق ساكنها يميناً بَرَّةً","لا فاجراً فيها ولا مأثوما",74,"م",2,0],["فَوحقِّ نِعمَتِكُم قَسَم","ما ذاقَ لَحماً مُنذُ كَم",75,"م",1,0],["فوحقِّ كَوثَرِ مائِهِ من وال في","جَنّاتِ عَدنٍ مِثلُهُ فَلَقَد لَغا",76,"غ",2,0],["فوحق عز الدولة القمر الذي","أمسى بغير موافق وعديل",77,"ل",1,0],["فَوَحَقِّ نُورِ جَمَالِهٍِ","مَا فِي الهَوَى أنَا غَادِرُ",78,"ر",1,0],["فوحَقِّ نُورِ بهائِهِم وجمالهم","ووحقِّ حُبِّي فيهمُ وشُجُوني",79,"ن",2,0],["فوحق شأن في علاك مشيد","وزمان فخر في نهاك يمجد",80,"د",1,0],["فَوَحَقِّ ساحرِ مُقْلتَيْ","هِ وما تُكِنُّ من الفُتُورِ",81,"ر",1,0],["فَوَحَق الهَوى وَحَبيه ما حَلَّ","ت دَواعي الهَوى بِقَلب فَصانه",82,"ن",2,0],["فوحَّدتَ قلبَ البلاد العظيم","وألَّفتَ ما بين تلك الزمر",83,"ر",1,0],["فوحشت بذا السوار خصرها","وسورت بذا الوشاح المعصما",84,"م",2,0],["فَوَحَقّه مالي سِواهُ تَخيل","أَبَدا وَلا لي عَن حِماه تَحول",85,"ل",1,1],["فوحدةُ الغربةِ قد حرَّكتْ","سواكنَ البلبالِ والمسِّ",86,"س",1,0],["فوحقّ الحب ما أبصرت","مقلتي من بعدكم حسنا",87,"ن",2,0],["فوحق حبك لا يفارقني الضنا","حتى أرى متفيئاً بدراكا",88,"ك",2,0],["فوَحَق الوجدِ ما يُط","فا غليلٌ بغليلِ",89,"ل",1,0],["فوَحسن مَن أخذَ الفؤادَ بطرفهِ","ما إِن سلوتُ ولا أردتُ بَديلا",90,"ل",2,0],["فَوَحبيكَ ما أطعت مَلاما","حينَ يَرقى على القلوبِ المَلامُ",91,"م",1,0],["فوحسنِ وجهِكَ ما بدَت لي زهرةٌ","فنسبتُها إلا إلى خدَّيكا",92,"ك",2,0],["فوحسنِ وجهكَ والذي خلقَ الهوى","ما إن يضركَ أن تكونَ وصولا",93,"ل",2,0],["فوَحسنٍ أنتَ مالكهُ","مَلك الأبصارَ والنظرا",94,"ر",2,0],["فوَحقّ الهوى وعهدٍ قديم","زادَ فيه مع البعادِ احتفاظي",95,"ظ",2,0],["فوحّدها للاختصار إشارة","إلى جملة تفصيلها لك مرتهن",96,"ن",1,0],["فوح العبير استنشقه حب واخلاص","ومروره بصدري يشكّل مدينه",97,"ن",2,1],["فوحقّ فاحمها الأثيث وهل","في ذلكم لذي حجر",98,"ر",1,0],["فوحق كفك إنها","كف كأخلاف السماء",99,"ا",2,0],["فوحق الجلال من مُجتلَى الأن","وار حيث الكمال في مستواه",100,"ا",2,0],["فوحده في أفعاله جل ذكره","مقراً بأن الله أكمل سيد",101,"د",1,0],["فوحده وأفرده بهذا","ودعنا من مزلات الضلال",102,"ل",1,0],["فوَحِّدْ رَبَّك الأعْلى وصَدِّقْ","بأحمدَ خاتمًا لِلأنبياءِ",103,"ا",2,0],["فوحدك الله لم نشرك به أحدا","وعن عبادتنا لا شيء يثنينا",104,"ن",2,0],["فوحق الذي يميت ويحيي","وهو الله مالك الأشياء",105,"ا",2,0],["فوحقه لم يبق فيّ بقيةٌ","ولقلما يلقى الكئيب المدنف",106,"ف",1,0],["فوح البنفسج في كفيكِ ينعشني","والياسمين فلا أشهى ولا أحلى",107,"ل",2,0],["فوحُ الشذا من رياضِ الأرض منبعُهُ","إلا شذانا ففي الجناتِ مخلوقُ",108,"ق",1,0],["فوحدتنا بهذا الدين نهج","لنسلكه وننجو من همومِ",109,"م",1,0],["فوحّدتُك الله َ ربا ً عظيما ً","تمجّدَ في القدس عن كلِّ قدس ِ",110,"س",1,0],["فُوحِي عَبِيرًا وَقُولِي","لِلْقَلْبِ هَيْهَاتَ تَشْقَى",111,"ق",2,0]]}