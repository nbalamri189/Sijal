{"poems":[[113,"من لإحتراق حشاشة الملهوف","https://www.aldiwan.net/poem16209.html","الكامل"],[543,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[543,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[556,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35404","الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122878","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78183","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78166","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108760","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110271","الخفيف"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124187","البسيط"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111158","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70162","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69915","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94895","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72671","الخفيف"],[5022,"ألقمرية","https://www.poetsgate.com/ViewPoem.aspx?id=200597",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5411,"روحي تُحبّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=185917",""],[5561,"سفر الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192757",""],[5861,"رثاء حب","https://www.poetsgate.com/ViewPoem.aspx?id=188027",""],[5943,"لاتعجبني ياسيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=37263",""]],"verses":[["وَبِظِلِهِ خُضر البِطاح كَأَنَّها","حَبرَ تنمقها يَد التَفويف",0,"ف",1,0],["وبِظلِّ مِنَ الجِنسِ اللَّطيفِ أدِلَّةً","لِلقَبقَريَّةِ فانتَصَبتِ دَليلا",1,"ل",2,0],["وبظلِّكُم قد نالَ أرفعَ رُتبةٍ","ووَقيتُموه عُداتَه الحُسَّادا",2,"د",2,0],["وبظلٍّ لك ممدو","دٍ على هذي الأنامِ",3,"م",1,0],["وبظلام وبضياء","وبضراب وبطعان",4,"ن",1,0],["وَبِظِلِّ عَدلِكَ لا زَوالَ يَمُسُّهُ","تَحيا بِلادٌ عَمَّها وَعِبادُ",5,"د",1,0],["وَبِظَهرِ زاوِيَةٍ جَآذِرُ أَثلَعَت","فَوقَ الرُبى أَجيادَ حورِ العينِ",6,"ن",1,0],["وبظلّ من النعيم مديد","وبحرزٍ من الليالي حريزِ",7,"ز",1,0],["وبِظل الوَرد كامن","وَإِذا حَرَكتُ ساكن",8,"ن",1,0],["وَبِظَبي البيض شُغلٌ لَهُ","عَن الظِباءِ البيض إِذ تَخطر",9,"ر",1,0],["وبظل مولانا الخليفة حرةً","لا تبتغي إلّا رضاه حليفا",10,"ف",2,0],["وبظلي كل القبور تظلل","وبغصني أحرم الطير موكر",11,"ر",1,0],["وبظر أمّي ورحم أختي","ولحيتي في خَرا عيالي",12,"ل",2,0],["وبظبي يستعذب الهجر أحوى","تخذ القلب منزلاً ومقاما",13,"م",2,0],["وبظلّ الرواق بالأمن ناما","وأخيلٌ في عزلةٍ بحماه",14,"ه",1,0],["وبظلها يشدو الهزار مرنحاً","تيهي دلالاً يا ابنة الاحرارِ",15,"ر",1,0],["وَبظلِ اَجنحةِ الملائك مهدُهُ","للدَهرِ مَخفورٌ فَلَن يَتَكَدرا",16,"ر",2,0],["وبظلِّ مولانا العزيز لقد بدا","يروي الظما والرمل غصَّ طريّا",17,"ي",2,0],["وبظل الاشجار في الروضة الغن","اء باتت مسحوبة الاذيال",18,"ل",1,0],["وبظلّ عرشك فلتظلّلنا إذا","ما قيل للإنسان( كلا لا وزر )",19,"ر",1,0],["وبظل رايته العقاب تزاحمت","للطير عقبان تؤم نزولا",20,"ل",2,0],["وَبِظلِّ عِشْقكَ للشّعورِ سَماوَةٌ","بِصَبابَةٍ فيها الغَرام مَسارِحُ",21,"ح",1,0],["وبظلِّها شمسٌ تحطُّ وترتمي","حتى كأنّ ظلالَها إغفاء",22,"ا",2,0],["وبظنّه أنّّ القصيدَ رياءُ","ولعل بعضَ القولِ فيهِ حياءُ",23,"ا",2,1],["وبظنِّي لايخفى أبدًا","عنْ مثلِكِ ما يُشقي الوَلدا",24,"د",2,0]]}