[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69924","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90898","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94590","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4652,"","https://poetry.dctabudhabi.ae/diwan/poem/123766","السريع"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52194","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52146","الكامل"],[4755,"يا حامِلاتَ الزَّعِيمْ","https://www.poetsgate.com/ViewPoem.aspx?id=184508",""],[4755,"رَاسِلِينِي بمُلصَقٍ أَو بصُورةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183775",""],[4782,"رِحَال الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202629",""],[4830,"يالِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213988",""],[4832,"ورد بخدك أم دم مطلول","https://www.poetsgate.com/ViewPoem.aspx?id=166708",""],[4859,"صديقتي","https://www.poetsgate.com/ViewPoem.aspx?id=189816",""],[4888,"عشرون عاما من العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=207743",""],[4914,"طاف بكأس المدام أغيد","https://www.poetsgate.com/ViewPoem.aspx?id=170939",""],[4929,"ازهري كالربيع","https://www.poetsgate.com/ViewPoem.aspx?id=206681",""],[5111,"القَلمُ المُرَابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=212648",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188408",""],[5387,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=53543",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5551,"حَيِّ الأماجد","https://www.poetsgate.com/ViewPoem.aspx?id=137148",""],[5670,"أُحاذِرُ !","https://www.poetsgate.com/ViewPoem.aspx?id=211202",""],[5829,"يا ثغرها","https://www.poetsgate.com/ViewPoem.aspx?id=147423",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5848,"أغرق","https://www.poetsgate.com/ViewPoem.aspx?id=53458",""],[5956,"تجاوب الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182392",""],[5956,"تأتي إليّ بسرعة وتطيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=192385",""],[5956,"شكراً لمن يهدي لنا الأفراحا","https://www.poetsgate.com/ViewPoem.aspx?id=192942",""],[5956,"لله درُّ فراسنا المتفاني","https://www.poetsgate.com/ViewPoem.aspx?id=193205",""],[5956,"يا رمزَ خيرِ حضارةِ الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=193684",""],[5956,"الله كرَّر لي نبيلِ ميشيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194195",""],[5961,"اليوم أبيض","https://www.poetsgate.com/ViewPoem.aspx?id=199807",""],[6102,"عِندَما قالَ حِذائِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=184457",""]],"verses":[["يا نِعمَةَ اللَهِ حلّي في مَنازِلِنا","وَجاوِرينا فَدَتكِ النَفسُ مِن جارِ",0,"ر",1,0],["يَا نِعَمَةً عَظُمَتْ فَلَمْ تَدُمِ","وَكَذَا تَكُونُ عَظَائِمُ النِّعَمِ",1,"م",1,1],["يا نعمةً عظُمَتْ في الخلق مِنَّتُها","ورحمةً تشمُلُ الغادينَ والرَّوحَا",2,"ح",2,0],["يا نعمة للمرجّى","وللمعاند نشبه",3,"ب",2,0],["يانع الغصن كلَّما هزَّه أس","قطَ مال البلاد منه جنيّا",4,"ي",2,0],["يا نِعمَتي في حَياتي","وَراحَتي بَعدَ دَفني",5,"ن",2,0],["يا نعمة الله في بريّته","أصبحتِ إحدى فواقرِ الفِقرِ",6,"ر",1,0],["يا نعمةً ولّتْ غضارتُها","ما كانَ أقبح حُسنَها بيدك",7,"ك",1,0],["يا نُعمَها لَيلَةً حَتّى تَخَوَّنَها","داعٍ دَعا في فُروعِ الصُبحِ شَحّاجِ",8,"ج",1,0],["يا نعيمي وعذابي في الهوى","بعذولي في الهوى ما جَمَّعضك",9,"ك",1,0],["يا نَعيمي وَعَذابي في الهَوى","بِعَذولي في الهَوى ما جَمَعَك",10,"ك",1,0],["يا نِعمَةَ اللَهِ دومي في بَني جُشَمٍ","بِمالِكِ المَلِكِ المَحمودِ مِن جُشَمِ",11,"م",1,0],["يا نعيم العيش في ظل الرضا","آه لو أعرف ما طعم النعيم",12,"م",1,0],["يا نُعمُ آتيهِ أُسائِلُهُ","فَيَزيدُني سُقماً عَلى سُقمِ",13,"م",1,0],["يا نُعمَ ما لاقَيتُ بَعدَكُمُ","لِمَجالِسِ اللَذّاتِ مِن طَعمِ",13,"م",1,0],["يا نُعمَ قَد طالَت مُماطَلَتي","إِن كانَ يَنفَعُ عاشِقاً مَطَلُه",14,"ل",2,1],["يا نُعمُ لا أُذلِفُ الصَديقَ وَلا","يَطمَعُ فيَّ الوُشاةُ إِن نَطَقوا",15,"ق",3,0],["يا نِعمَهُ مَجلِساً سَدّى مَحاسِنُهُ","مَن لا يَؤوبُ وَإِن أَمسى عَلى دِرَرِ",16,"ر",1,0],["يا نِعمَ مَن كانَ مِنهُم في مَحَلَّتِهِ","وَكانَ يَشرَبُ بِالماءِ الَّذي شَرِبوا",17,"ب",3,0],["يا نِعْمَةَ اللَّهِ زِيدِي","ما كانَ فِيكِ مَزيدُ",18,"د",1,0],["يَا نِعْمَةً عُلُويِّةً طَيبُهَا","عَرْفا وَعَرُفا سَابِغُ شَامِلُ",19,"ل",1,0],["يانِعُ رَوضِ الشَبابِ يَبسٌ","وَطائِعُ المُزدَهي أَلِيُّ",20,"ي",1,0],["يا نُعْمُ لا أُخْلِفُ الصَّدِيقَ وَلاَ","يطمعُ فيّ الوشاة ُ إن نطقوا",21,"ق",3,0],["يا نعم حسبك ان عين زماني","عمياء عن شيمي وعن عرفاني",22,"ن",2,1],["يا نعم عني واتركيني انني","في حيرة فرط العناء اعاني",22,"ن",2,0],["يا نعم ها هي قصة منصوصة","لك من عقود كالعقود ثمان",22,"ن",1,0],["يا نعم ضائعة المكارم تنشد","ولكل يوم في تقلبه غد",23,"د",1,1],["يانِعمَ ذلك مَجلِساً ولُبانةً","لو كانَ يَومُكَ لَيلُهُ يَتَطاوَلُ",24,"ل",1,0],["يا نعمة للَه لم","تجحد وما في الشعب جاحد",25,"د",1,0],["يا نعمةً أسبغها مُنْعِم","على وليّ مخلصٍ مصفِ",26,"ف",1,1],["يا نعمَ أندلسياً كان جَدّكِ في","عهدِ النعيمِ وهذا العهدُ يشقينا",27,"ن",2,0],["يا نِعمَةَ اللَهِ الَّتي فَضلُها","يوجِدُ إيمانَ الَّذي يَجحَدُ",28,"د",1,0],["يا نعم تلك العصابه","أهل العقول الزكيه",29,"ه",1,0],["يا نعمة الله حلّي في منازلنا","وجاورينا رعاكِ الله من جارِ",30,"ر",1,0],["يا نعمة نفعت على طول المدى","من ظامىء الآمال خرّ أوام",31,"م",1,0],["يا نعمة ولت ولا يرجى لها","عود ولكن ذكرها يضنيني",32,"ي",1,1],["يا نعمةً ما صاحبتْ صاحباً","وعُقلَةُ النعمة أن تُشكَرا",33,"ر",2,0],["يا نعمةً زالت غدا","ةَ جهلتُ ما مقدارها",34,"ر",3,0],["يا نعمةً لم يفز إلّا القليلُ بها","من يعتمدْ غيرَها يُضرَبْ بأعواد",35,"د",1,0],["يا نِعمةَ اللهِ زَخُّورُ احتَضنْتَ هنا","مِتري الذي كُنتَ منهُ ترتجي خَلَفا",36,"ف",2,1],["يا نعمةً طَفَحتْ عليَّ غَلِطتُ بل","شَمَلَت جميعَ السَّاكنينَ المَشرِقا",37,"ق",2,0],["يا نِعمةَ اللهِْ الذي لَكَ نِعمةٌ","من فَضلِهِ وكَرامةٌ مِن عِندِهِ",38,"د",2,0],["يا نعمةَ اللهِ علىَ","عبدِ الرَّحيمِ دُومِي",39,"م",2,0],["يا نِعمةً أنْعَمَ الرَّحمنُ جلَّ بها","علي المسَاكين أصحابِ المُعاناةِ",40,"ه",1,0],["يا نُعمُ ما صَنَعَ السّاقي مَعَ الحاسي","يَسقي مِنَ الثَّغرِ ما يَسقي مِنَ الكاسِ",41,"س",1,1],["يا نعمها امرأة لم يحكها رجل","فضلا ونعم أخوها المرتضى رجلا",42,"ل",2,0],["يا نِعَم أيامنا بالرَّقمَتْين بكم","وخَيرُ أيامنا ما كان أوَلَها",43,"ل",3,0],["يا نعم نور البحر كم من صدمة","في البحر زاحمها بصَدْرٍ لا يُفَلّ",44,"ل",1,0],["يا نِعْمَ مَا في رِيَاضها نعمت","نَفْسُ ولىٍّ وفَاتَت النَّعَما",45,"م",2,0],["يا نعم ما قرّرت يا خلّي وذا","مرغوب حبٍّ في هواك تهيَّما",46,"م",2,0],["يا نعمة الله عندي","وجل من أولاني",47,"ن",2,0],["يا نعمها ليلة جاءت على قدري","بات الصفاءُ بها يسطو على الكدر",48,"ر",1,1],["يا نعم ما أوَّلٌ منها وثالثها","وحسن ما رابع منها وثانيها",49,"ي",3,0],["يا نعش ما يصنع الفصيحُ","لم أدرِ ماذا به يبوحُ",50,"ح",1,1],["يا نعمةً ما حييتُ اذكرُها","ومنةً للزمان اشكرُها",51,"ر",3,1],["يا نعمة نعمت بنعمة ربها","في مهرجان الأَرجوان الأَخضر",52,"ر",1,0],["يا نعمة فيه وموهبة","مربوطتين بواجب الشكر",53,"ر",1,0],["يا نعمة السيدِ المولى لمعترفٍ","بالذنب إياك نرجو أن تراجعني",54,"ن",2,0],["يا نعمة من عشيٍ غاب حاسده","وصح فيه اجتماع دون تشتيت",55,"ت",1,1],["يا نعيمَ الوصالِ رفقاً بصبٍّ","أضرَمَ النَّأيُ بين جنبيهِ نارا",56,"ر",2,0],["يا نعيم الجنات رحِّب وبارك","وتقدم بعاطراتِ التهاني",57,"ن",2,0],["يا نعمها من روضةٍ في مصرَ قد","جَمَعت جميلَ الطيرِ والأنعامِ",58,"م",1,0],["يا نِعمها من ساعةٍ فيها جرى","ماءُ الحديث فجاء طِبقَ مرامي",58,"ي",1,0],["يا نُعمَ إِنّي وَأَيديهِم وَما نَحَروا","بِالخَيفِ حَيثُ يَسُحُّ الدافِقُ المُهَجا",59,"ج",2,1],["يا نعمة الله التي أسبغها","منه على الخلق فلا أذالها",60,"ل",3,0],["يا نعمة الله","على الأيتام والأرامل",61,"ل",1,0],["يا نَعيمي وَلَذَّتي وَغَرامي","وَمَراحَ الصِبا وَمَغدى التَصابي",62,"ب",2,0],["يا نعمةً لمّا تبلّغتها انقضت","فأنعَمُ أحوالي بماعاد أبأسا",63,"س",2,0],["يا نعمة ما كان اسبغ فيضها","تحيا النفوس بها ويحيا الوادي",64,"د",2,0],["يا نَعشه طل بَنات النَعش مُفتَخِرا","فَفيك يا نَعش نُور الأَرض قَد رَفَعوا",65,"ع",3,0],["يا نعمة الله اقتدحت بخاطري","زنداً وملكت السهاد نواظري",66,"ر",2,1],["يا نِعمَةَ السُّلطانِ أَنتَ عَلى الوَرى","تَحيَى بِسَعيِكَ أَنفُسٌ وَدِيارُ",67,"ر",1,0],["يا نعم علي أنعمي بالوصل","كم ذا وإلى متى عذاب الفصلِ",68,"ل",1,1],["يا نِعمةَ المَوْلَى وأيَّ فضيلةٍ","فَلأَنْتَ صالحُ والأَنام ثَمود",69,"د",1,0],["يَا نِعْمَ من بلدٍ لو كنت أسكنُها","بلغتُ منها بِهَا أُمنيَّتي بيدي",70,"د",2,0],["يا نعمة عظمت قدراً على ملأ","لولاك ما عرفوا اللَه أحكاما",71,"م",2,0],["يا نعمةً سُمِّيتُ مَمْلوكَها","قَدْري بِها بيْن البرايا سَما",72,"م",2,0],["يا نعمة فزت ما بين الأنام بها","وسؤل نفسي بل يا منتهى فكري",73,"ر",2,1],["يا نعمةَ اللَه التي جلَّت بكم","إذ كُلُّ ما يَهَبُ الالهُ جليلُ",74,"ل",1,0],["يا نعمةَ اللَه الذي سادَ الوَرَى","بمضاءِ عزمٍ ما عراهُ فُلولُ",74,"ل",1,0],["يا نعمةَ اللَه التي من دُونها","كلٌّ سيفنى حالُهُ ويحولُ",74,"ل",1,0],["يا نعمةَ اللَه ارقَ في أَوجِ العَلا","لازِلتَ في أُفُق البَهاءِ تجولُ",74,"ل",1,0],["يا نعم ما فعلوه","به على ما جناه",75,"ا",2,0],["يا نعم قوم عليه","غاروا وحلوا عراه",75,"ا",2,0],["يا نِعْمَةً لإِلهِنا فِي خَلْقِهِ","مَقْسومَةً لأِقَارِبٍ وَأجانِبِ",76,"ب",1,0],["يا نعم منتدح الكلام على ملاً","خلت النجوم الزهر من أفراده",77,"د",2,1],["يا نعم مولى أنت يا نعم النصيرْ","كن لي نصيراً ومعيناً في النَّفيرْ",78,"ر",1,0],["يا نِعمَةَ اللَّه يستصْفى المَزيد بها","لِلشاكرينَ وَيستقنى صفاياهُ",79,"ا",2,0],["يانِعاً كُنتَ حاهِلاً لِلطّعانِ","حَيثُ تَبدُو شَجاعَةُ الشُّجعانِ",80,"ا",2,0],["يا نعمَ ما انعمت يا بحر النَدى","لَولا الاصابة ظُنَّ جودكَ مسرفا",81,"ف",2,0],["يا نعم مولود لاكرم والد","بالمكرمات غدا وريث جدوده",82,"د",2,0],["يا نعمة المولى سلمتَ من العدى","وشموسكم تزهو ولن تتغيرا",83,"ر",2,0],["يا نَعيماً مشرف الصَف","حَة يُساقط دُوني",84,"ي",1,0],["يا نعمة قد أصبحت نقمة","مذ نالها الكلب على خسته",85,"ه",1,1],["يا نعم هاتيكَ الصفات حَوَيتَها","وقَضَيت وهْيَ حديثُ كلّ لسانِ",86,"ن",1,0],["يا نِعْمَِ هاتيك الخلال حديثُها","وقضيتَ وهي حديث كلِّ لسانِ",87,"ن",1,0],["يا نِعمَتِي والنَّعِيمْ","والخَيرْ مِنْ كُلِّ.... ما بِشْ",88,"ش",1,0],["يا نَعِيمَ الفؤادِ.. ما مِن فؤادٍ","جَفَّفَ الحُبُّ زَهرَهُ أَو جُذُورَهْ",89,"ر",2,0],["يانعيم الروح ياخِصب قفاري","يشتكيكَ القلب من ضيمٍ بدا له",90,"ل",2,0],["يانِعُ النَّهدَينِ مصقولُ الّلمى","فاتنُ الحاجبِ ذو خدٍّ أَغَنْ",91,"ن",1,0],["يا نعم ليل أنعمت بخيالها","نعم وخذ المشرقين صقيل",92,"ل",1,0],["يانعمةَ الله التي حصنتها","من كل شر أوصديق مجحفِ !",93,"ف",1,0],["يا نِعمَ جائزةٌ بالدِّينِ قائمةٌ","عَزّتْ مَثيلاتُها، يَنْأى بها اللَّحَقُ",94,"ق",1,0],["يانع غصن وقد تثنى","طائر قلبي عليه غرد",95,"د",1,0],["يانعات القطاف فيه ثمار","لا يُملُ المذاق طعما ورَيَّا",96,"ي",2,0],["يَا نِعْمَ أسْتَاذٌ يَضُوعُ مَحَبَّةً","يبني الْكفَاءَةَ آنَسَ الأطْفَالاَ",97,"ل",2,0],["يا نعْمَ عقبى الدنا فالظفرُ آخرةٌ","والعدلُ قائمها والله ُحاكمها",98,"م",3,0],["يا نعمة كبرى أطلت","للوجود من المحال",99,"ل",1,0],["يا نعمة الباري على","أبويه آدم والخليل",100,"ل",1,0],["يا نِعْمَ في السلم أيامًا لهم سلفَتْ","قد اكتَسَوا من ثيابٍ للعلا حُللا",101,"ل",2,0],["‏يا نعمةَ الحرفِ عودي نحو قافيتي","تاهَ اليراعُ وما في الأفق من هادِ",102,"د",1,0],["يانعم حبات اللآلئ إن بدت","تغري وتضرم في الفؤاد حريقا",103,"ق",2,0],["يا نعم مرضعة الغلام وطيبها","فهو الذي في حسنه فرّيد",104,"د",1,0],["يا نعم أخلاق الشباب محمد","هذا الرجاء ومنهل مورود",104,"د",1,0],["يا نعومة يدك تذبح والغريب فتورك !!","لو لمست الباب بيدينك بسرعه أورق",105,"ق",1,0],["يا نعمةً من ربنا دَعَمت يدي","ودَعَمْتُها حتى تَماسَكَ مَجُدُنا",106,"ن",2,0],["يا نِعْمَ صوتك كم جميل إنه","آياتُ فنٍ للمَلا مذخورُ",107,"ر",1,0],["يا نِعْمَ أخلاقِ الشقيق يُحيطُهمْ","عطفاً وجوداً يملّان الراحا؟",108,"ح",2,0],["يا نعمة وخلاصة لوجودنا","بالخيرِ والتطويرِ والإحسانِ",109,"ن",1,0],["يا نِعْمَ أرضٍ بالمحبة أنجبت","أهلَ المكارم ذروةَ الإيمانِ",110,"ن",1,0],["يا نعمةً للحبِ في شخصيهما","ومكارم الأخلاق والتنويلِ",111,"ل",1,0],["يا نعمة نزلت بعام مجدب","الفقر فيه مع المحول شديد",112,"د",1,0],["يا نَعلُ ؛ قُلتُ , وَ لا أَزالُ مُرَدِّدًا","( إِمَّا نَطَقتَ عَلَوتَهُمْ ؛ يا مُترَفُ",113,"ف",1,0]]}