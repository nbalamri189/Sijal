ctabudhabi.ae/diwan/poem/124730","الرمل"],[1924,"","https://poetry.dctabudhabi.ae/diwan/poem/102027","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53177","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53061","الخفيف"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123645","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130777","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205426","الخفيف"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138774",""],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204080","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109896","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85187","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35584","الخفيف"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67630","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136480",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136746",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33322","الرمل"],[5074,"الغائب الحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=153717",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5956,"شغلهُ بالمجد","https://www.poetsgate.com/ViewPoem.aspx?id=193197",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6152,"عيناك وطن","https://www.poetsgate.com/ViewPoem.aspx?id=203050",""]],"verses":[["أيها الغِرّ لا تغرّك دنيا","ك بكون مصيره لفساد",0,"د",1,0],["أَيُّها الغازي الَّذي يَغ","زو بِجَيشِ الحُبِّ جِسمي",1,"ي",1,1],["أيها الغيَّاب بعد جفا","ما على هجرين من قِبَل",2,"ل",1,0],["أَيُّها الغائِبُ عَنّي إِنَّني","عَلِمَ اللَهُ لَمُشتاقٌ إِلَيك",3,"ك",1,1],["أَيُّها الغائِبُ قَد آ","نَ لِعَيني أَن تَراكا",4,"ك",2,1],["أَيُّها الغافِلُ ما تُب","صِرُ عُنوانَ الصَحيفَه",5,"ف",2,0],["أَيُّها الغائِبُ عَنّي","قَرَّبَ اللَهُ مَزارَك",6,"ك",1,1],["أَيُّها الغافِلُ الَّذي لَيسَ يُجدي","كَثرَةُ اللَومِ فيهِ وَالتَوبيخِ",7,"خ",1,1],["أَيُّها الغالونَ في أَجداثِهِم","اِبحَثوا في الأَرضِ هَل عيسى دَفين",8,"ن",1,0],["أَيُّها الغادونَ كَالنَح","لِ اِرتِياداً وَطِلابا",9,"ب",2,0],["أَيُّها الغائِبُ الَّذي","عَن حِمى القَلبِ ما نَزَح",10,"ح",1,0],["أيها الغائبُ العزيزُ النائي","فَسدت ليلتي وضاع هنائي",11,"ا",2,1],["أَيُّها الغَيثُ حَيِّ أَهلاً بِمَغدا","كَ وَعِندَ السُرى وَحينَ تَؤوبُ",12,"ب",1,0],["أَيُّها الغَضبانُ رِفقاً","جُعِلَت نَفسي فِداكا",13,"ك",2,0],["أَيُّها الغافِلُ المُقيمُ عَلى السَهَ","وِ وَلا عُذرَ في المُقامِ لِساهِ",14,"ه",1,0],["أَيُّها الغِرُّ إِن خُصِصتَ بِعَقلٍ","فَاِسأَلنَهُ فَكُلُّ عَقلٍ نَبِيُّ",15,"ب",2,0],["أيها الغابةُ الظليلةُ رُدِّي","أنت يا من أبقى عليها الزمانُ",16,"ن",1,0],["أيها الغائب الذي في فؤادي","حاضرٌ كيفَ حالُ قلبكَ بعدي",17,"د",2,1],["أيها الغاضب الكبير تأمل","كيف صار الكتّاب كالخرفان",18,"ن",1,0],["أيها الغارقون في نعم الله","ونعمى المربربات الحسان",18,"ن",1,0],["أيها الغربُ، اتَّئِدْ؛ إن هنا","ضيغَمًا قام يحامي عن شَراهْ",19,"ا",2,0],["أيها الغرّ بالزما","ن وتاثير عكسه",20,"س",2,1],["أيها الغربُ علمِ الشرقَ أنَّ ال","علمَ لا شيءَ فيهِ صعبُ المنالِ",21,"ل",1,0],["أيها الغافون في ليل الوقار","والمسجون بأثواب الكهوف",22,"ف",1,0],["أيها الغافل عن وجدى به","ولقد يفصح دمعي ويبين",23,"ن",1,1],["أَيُّها الغَربُ كلُّ علمٍ حَديثٍ","نحن فيهِ الثَرى وَاَنتَ السماء",24,"ا",2,0],["أيها الغمر المغفل","لا تتبع عن هواكا",25,"ك",2,0],["أيها الغار أنت أجدر بالغار","نديّا من فاتحين وصيد",26,"د",1,0],["أيها الغائبُ الذي حضر الشوقُ","إليه وواصلَ التفريق",27,"ق",1,0],["أيها الغائب، قد خلفت حزنا","وتركت الجرح يزداد اختيالا",28,"ل",2,0],["أيها الغار ، غار ثورٍ ، تلاقى","عندك المجد وانبثاق الصَّباح",29,"ح",1,0],["أيّها الغافِلونَ عن سَكرةِ المو","تِ وإذْ لا يسوغُ في الحلقِ رِيقُ",30,"ق",1,1],["أَيّها الغافِلُ كم هَذا الهجوعُ","أعلنَ الدَّاعيِ فهل أنتَ سَميعُ",31,"ع",1,1],["أيها الغيثُ الذي فاضَ جوداً","فسقى أعلى الرُبى والبِطاحا",32,"ح",2,0],["أيها الغيثُ إن طرَقْتَ تهامَهْ","فاسْقِ وادي الغَضا وحيّ خِيامَهْ",33,"م",2,0],["أيها الغاضب الغشوم رويدا","رب سيل يحون من جرفه",34,"ف",2,0],["أيها الغادي وقلبي نزله","ليس في العادةِ نقل المنزل",35,"ل",1,0],["أيها الغادي بهم لا صاغراً","عجْ على الحيِّ وعن قلبي فسل",36,"ل",1,0],["أيُّها الغزيُّ الذي حاصَروهُ","قبلَ أنْ تكسوَ العِظامَ اللُّحومُ",37,"م",1,0],["أيها الغر تنبه","لحبيبي وهباته",38,"ت",2,0],["أيها الغائب فيه","لمتى تعرض عنه",39,"ن",2,0],["أيها الغائب عنا","لا تقل بالله زورا",40,"ر",2,0],["أيها الغافلون مهلاً رويداً","لم أوافق لكم على الغفلات",41,"ت",1,0],["أَيها الغيثُ لا انْقَشَعْتَ فكلٌّ","منكَ لاَ بَلْ إِليك ريّانُ صَادِي",42,"د",2,0],["أيها الغرب هل تصورت يوماً","كيف تعلو على الهضاب التلاع",43,"ع",1,0],["أيها الغالبون رفقاً بنا رف","قاً ورحمى بالعزَّل الأبرياء",44,"ا",2,0],["أيها الغشاش لي بال","عذل ما أنت نصوحُ",45,"ح",1,0],["أَيُّها الغاديات عودي إِلى الدي","ر كما كنت والحقي بالبدور",46,"ر",1,0],["أيها الغادة التي يفضل الدا","نقُ من مسك خالها الدينارا",47,"ر",2,0],["أَيُّها الغادِي إلى وادي الغَضَا","نِلتَ من حسنِ القَضا ما تَتَمنَّى",48,"ن",2,0],["أيها الغافلون كف اشتغلتم","عن حقوق العلى بهذا الرقاد",49,"د",1,0],["أيها الغافلُ الأثيمُ تذكر","قدرةَ الخالقِ الجليل الشانِ",50,"ن",1,0],["أيها الغافلُ الجهُولُ تنبَّه","وتيقظ من غفلةِ الوسنانِ",50,"ن",1,0],["أيها الغر أفق ويك أفق","أنت في أسمالٍ دهرٍ قد خلق",51,"ق",1,0],["أيها الغيد صلينا","فبك الصبر اضمحلا",52,"ل",2,0],["أيها الغرب إنَّ للشرق شأنًا","وعلى غابر الزمان العفاء",53,"ا",1,0],["أيها الغُمْرُ أفق من غمرة","أنت في رقدتها طيف خيال",54,"ل",1,0],["أيها الغمر إنما العمر طيف","ما مضى من خياله غير آت",55,"ت",1,0],["أيها الغافل الغبي تنبه","إن بالنوم يقظة الناس أشبه",56,"ب",2,1],["أيها الغاضب القويُّ هوينا","أوسع العهد بالمكارم ودّا",57,"د",2,0],["أيها الغابر الدفين وما كن","ت دفيناً بقلبي المكلوم",58,"م",1,0],["أيّها الغافل لا نلتَ نجاحا","خالف النفسَ ودع عنكَ المِلاحا",59,"ح",2,1],["أيها الغافلون عن نوب الده","ر وناسون سطوة الأقدار",60,"ر",1,0],["أَيُّها الغَوثُ في المَضيقِ ويا مَن","يَهَبُ العَونَ في الأُمورِ الصِعابِ",61,"ب",1,0],["أيها الغمر هل سؤالك إيا","ي لجهل أم خفّة واغترارا",62,"ر",2,0],["أيها الغوث عجلن بمرادي","وأرحني من شدة البرحاء",63,"ا",2,0],["أيها الغوث والمغاث أنلني","ما أرجيه يا هزبر اللقاء",63,"ا",2,0],["أيها الغوث ضاق حالي فهل لي","نجدة منك يا وسيع العطاء",63,"ا",2,0],["أيها الغوث كم هبات لدينا","من نداكم جلت عن الإحصاء",63,"ا",2,0],["أَيُّها الغَيثُ إِن رَوض الأَماني","آض يبسا فَهَل يُطيقُ هموعا",64,"ع",2,0],["أيُّها الغيثُ كنت بؤساً وفقراً","لي وللناس حنطة وشعيرا",65,"ر",2,0],["أيّها الغائب المحجبّ يفديك","تَليدي وطارفي وقَبيلي",66,"ل",2,0],["أيها الغادرونَ مَهلاً فقدُ يق","طعُ حبلُ الصفا بعضب الملال",67,"ل",1,0],["أيها الغصنُ الذي حُم","مِل في أعلاهُ بدرا",68,"ر",2,0],["أيُّها الغائبُ الَّذي لا يَغِيْبُ","أنتَ في خَاطِرِي بعيدٌ قَرِيْبُ",69,"ب",1,1],["أيها الغاصب القوي دع الإمعا","ن في الظلم فالنُّهى تأباه",70,"ا",2,0],["أيها الغاضبون من ثقة الشعب","... بنا والمؤلبون علينا",71,"ن",2,1],["أيها الغالي أدِمْ حثَّ المطايا","واصلِ الإبداع تَغْدُ الأكملا",72,"ل",2,0],["أيّها الْغَافُونَ عَنْ حَوْضِِ الْمَجَانِي","فََاضَ سَيْلُ الْهَوْنِ ، بِتْنَا صَاغِرينَا",73,"ن",2,1],["أيّها الْغافي عنْ نداء اللّيالي","قمْ إلى إحْياء الْمنى بالطّلاء",74,"ا",2,0],["أيُّها الغَادةُ التي لا أرَى المَرْ","زُوقَ من غيرِ وَصْلِها مَرْزُوقَا",75,"ق",2,0],["أيها الغائب عني عامدا","أنت لي ماوى وعيناك وطن",76,"ن",1,0]]}