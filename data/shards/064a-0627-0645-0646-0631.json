ps://www.poetsgate.com/ViewPoem.aspx?id=178360",""],[5780,"المرء بالأعمال","https://www.poetsgate.com/ViewPoem.aspx?id=187625",""],[5809,"شاغل","https://www.poetsgate.com/ViewPoem.aspx?id=205938",""],[5851,"مملكة سبأ المزيفة","https://www.poetsgate.com/ViewPoem.aspx?id=152879",""],[5897,"إلى ذات الحرير الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=160572",""],[5943,"إلى من رخصت نفسها فخسرتها","https://www.poetsgate.com/ViewPoem.aspx?id=61959",""],[5956,"يا من رددتَ عليّ بعد شهور","https://www.poetsgate.com/ViewPoem.aspx?id=192993",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[5956,"يا مَن ردَدْتَ تحيتي بمثيلها","https://www.poetsgate.com/ViewPoem.aspx?id=193493",""],[5957,"أنت الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=27115",""],[5977,"يا راحلين","https://www.poetsgate.com/ViewPoem.aspx?id=212731",""],[5977,"أحاديث الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=213128",""],[6035,"النداء الأخير ! .","https://www.poetsgate.com/ViewPoem.aspx?id=151965",""],[6070,"المشيب","https://www.poetsgate.com/ViewPoem.aspx?id=188466",""],[1362,"سقتك وهناً يا دارها الديم","https://www.poetsgate.com/ViewPoem.aspx?id=127724",""],[199,"يا منْ رأى برقاً أرقتُ لضوئهِ","https://www.poetsgate.com/ViewPoem.aspx?id=22447",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[6148,"بشري","https://www.poetsgate.com/ViewPoem.aspx?id=202057",""],[6152,"يا جامع يعقوب بيوسف اجمعنا","https://www.poetsgate.com/ViewPoem.aspx?id=213199",""],[6185,"شدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87030&r=&rc=16",""],[6189,"مسافرٌ بلا بوصلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83586&r=&rc=53",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[5957,"أنت الرصافة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82437&r=&rc=75",""],[6221,"على ضفاف القمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64920&r=&rc=0",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""],[6259,"حُييتما من دمنتي طللينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59406&r=&rc=54",""]],"verses":[["يا مَن رَأى البَرقَ عَلى الأَنعَمِ","يَطوي بِساطَ الغَسَقِ المُظلِمِ",0,"م",1,1],["يا مَن رَمَت مُهجَتي مِن نَبلِ مُقلَتِه","بِأَسهُمٍ قاتِلاتٍ بُرؤُها عَسِرُ",1,"ر",1,0],["يا مَن رَمى قَلبي فَأَقصَدَهُ","أَنتَ العَليمُ بِمَوقِعِ السَهمِ",2,"م",1,0],["يا مَن رَأى مِثلي فَتىً","يَسعى طَليقاً وَهوَ موثَق",3,"ق",1,0],["يَا مَنْ رَآنِي أَشْفِقْ لِمَا حَلَّ بِي","يُلْبَسُ مَخْيُوطٌ عَلَى ذَا النُّحُولْ",4,"ل",1,0],["يَا مَنْ رَعَيْتَ النِّيلَ رَعْيَ مُوفِرِ","لِلْخَيْرِ مُقْتَصٌّ مِنَ الطُّغْيَانِ",5,"ن",1,1],["يامَن رَجَعتُ عَلى كُرهٍ لِطاعَتِهِ","قَد خالَفَ القَلبُ لَمّا طاوَعَ البَدَنُ",6,"ن",1,1],["يا مَن رَضيتُ بِفَرطِ ظُلمِه","وَدَخَلتُ طَوعاً تَحتَ حُكمِه",7,"م",2,1],["يامَن رَأى لي بِحِصنِ خِرشَنَةٍ","أُسدَ شَرىً في القُيودِ أَرجُلُها",8,"ل",3,0],["يامَن رَأى لي الدُروبَ شامِخَةً","دونَ لِقاءِ الحَبيبِ أَطوَلُها",8,"ل",3,0],["يامَن رَأى لي القُيودَ موثَقَةٌ","عَلى حَبيبِ الفُؤادِ أَثقَلُها",8,"ل",3,0],["يا من رمى هذا الرماد بمفرقي","ما ذا رمى قلبي الشجيّ فأحرقا",9,"ق",2,0],["يا من رأى جوده العافون منشرحاً","فوجَّهوا العيس تطوي الرمل بالرَّمل",10,"ل",1,0],["يا من رأى جوده العافون منسرحاً","فوجَّهوا العيس تطوي الرمل بالرمل",11,"ل",1,0],["يا من ركبت نجوم السعد أقصده","وما ركبت إليه الناس بُعرانا",12,"ن",2,0],["يا مَن رِياضُ مَعاني","هِ قَد حَوَت كُلَّ فَنِّ",13,"ن",1,0],["يا مَنْ رأى قدْرَهُ يعلو مواهِبَهُ","فليس مُسْتَعْظِماً شيئاً وإنْ عَظُما",14,"م",2,0],["يا مَن رَفَضتُ الناسَ حينَ لَقيتُهُ","حَتّى ظَنَنتُ بَأَنَّهُم لَم يُخلَقوا",15,"ق",3,0],["يا مَن رَأَيتُ الحَليمَ وَغدا","بِهِ وَحُرَّ المُلوكِ عَبدا",16,"د",2,1],["يا مَن رَأى الدامِرَ يَختالُ في","شاشيَّةٍ شَوهاءَ مُغبَرَّه",17,"ر",2,1],["يا مَن رَأَت عَينُهُ عَوراءَ مُعوِرَةً","تُناكُ في دُبرِها مِن غَيرِ إِنكارِ",18,"ر",1,0],["يامَن رَأى البِركَةَ الحَسناءَ رُؤيَتَها","وَالآنِساتِ إِذا لاحَت مَغانيها",19,"ي",3,0],["يا مَن رَأى أَبَوَيهِ في","ما قَد رَأى كانا فَماتا",20,"ت",2,0],["يا مَن رَأى قَبلي قَتيلاً بَكى","مِن شِدَّةِ الوَجدِ عَلى القاتِلِ",21,"ل",1,0],["يا مَن رَماني عَن قِسيِّ سَماحِهِ","بِسِهامِ أَنعُمِهِ الَّتي لَم تُخطِني",22,"ن",2,0],["يا من رفعتِ بناء نفسي شاهقاً","متهلّلَ الجَنَبات بالأنوار",23,"ر",1,0],["يا من رأت طللاً كتمثالِ","يستعرض العمر الذي مرَّا",24,"ر",2,0],["يا من رأت حزني العميق البعيد","داويتِ لي جرحي بجرح جديد",25,"د",1,0],["يا من رأى في غُصُنٍ روضة","يسمعُ منها للأقاحي كلام",26,"م",1,0],["يا منْ رأى منهُ جيناً واضحاً","تقولُ قدْ خلتُ الهلالَ لائحا",27,"ح",2,0],["يا مَنَ رَأى الخَمرَ في غَيرِ الكُرُومِ وَمَن","هَذا رَأى نَبتَ وَردٍ في سِوى الشَجَرِ",28,"ر",1,0],["يا مَن رَمَتني عَينُهُ بِسَهمِ","أَصابَ جِسمي فَتَداعى جِسمي",29,"ي",1,1],["يا مَن رَجا دَرَكاً بِوَجهِ شَفاعَةٍ","مَلَّكتَ رِقَّكَ مُنعِماً وَشَفيعا",30,"ع",2,0],["يا مَن رَأى عاشِقاً أَخا كَلَفٍ","يَزدادُ حِرمانُهُ عَلى قَلَقِه",31,"ق",2,0],["يا مَن رآني في الكرى زعَماً","وكأنّني أشتدّ في أثره",32,"ر",2,1],["يا من رأَى بحرَ ندىً زاخراً","يحملُهُ طِرفٌ فلا يغرقُ",33,"ق",1,0],["يا من رأى عمر تكسوه بردته","والزيت أدم له والكوخ مأواه",34,"ا",2,0],["يا مَن رَمَت مُهجَتي مِن نَبلِ مُقلَتِها","بِأَسهُمٍ قاتِلاتٍ بُرؤُها عَسِرُ",35,"ر",1,0],["يَا مَنْ رَأَى الشَّادِنَ في سِرْبِهِ","يَتِيهُ بِالْحُسْنِ عَلَى تِرْبِهِ",36,"ب",2,1],["يَا مَنْ رَمَاهُ عُدَاتُهُ بِتَطَرُّفٍ","حَقَّقْتَ آمَالَ الهُدَى مُتَطَرِّفَا",37,"ف",2,0],["يا مَن رَأَت عَيناهُ فيما خَلا","أَحَلى وَلا أَحسَنَ مِن أَمسِ",38,"س",1,1],["يا من رأى قلبه صريعًا","غنى على رأسه الهَزار",39,"ر",1,0],["يا من رأى أرضًا أبيح حرامُها","بالأمس كانت في قداسة معبد؟",40,"د",1,0],["يا من رياض معانيهْ","قد حّويْت كل فنّي",41,"ن",2,0],["يا من رأيت الهجر في دين الهوى","سهلا تأمل فهو امر يصعب",42,"ب",1,0],["يا من رأى مثل ابن تاج الدين","في بيعه وشرائه المغبون",43,"ن",1,1],["يا منْ رأى بارقاً قد بت أرمُقهُ","يسري على الحَرَّةِ السوداء فالوادي",44,"د",2,0],["يا مَن رَعَى وُدِّي وأَدْناني","وَصْلاً ولم يَهْمُمْ بهِجْراني",45,"ن",2,1],["يا مَن رَأى حَدُّ الحُسامِ مَضاءَهُ","وَرَأى السَحابُ سَخاءَهُ فَتَعَلَّما",46,"م",2,1],["يا مَن رَأَينا عِياناً مِن مَكارِمِهِ","ما حَدَّثَ الناسُ عَن كَعبٍ وَعَن هَرِمِ",47,"م",1,0],["يا مَن رَأى قُضبانَ با","نٍ في الدَمالِجِ وَالشُنوفِ",48,"ف",1,0],["يا مَن رَعَيتُ لَهُ الوِدادَ تَمَسُّكاً","بِعُهودِهِ فَغَدا لِعَهدي نابِذا",49,"ذ",2,1],["يا من رأى البدر حسن صورته","فبان في البدر موضع الحسدِ",50,"د",1,1],["يا من رأى نَهرَاً قدْ أنشأتْ يدُه","بحراً يموج بأشجار وَأدواح",51,"ح",1,0],["يا مَن رَماه زَمانه بِعنائِهِ","لُذ بِالنَبيّ تَفز بحصن حمائِهِ",52,"ه",1,1],["يا مَن رأَى ظُعُنَ الحَيِّ الّذي شَحَطا","كأنّها بينَ أحناء الضُّلوعِ قَطا",53,"ط",2,1],["يا مَن رَمى فأَقامَني غَرَضاً","لا تُنكِرنَّ عَليَّ أَن أَرمي",54,"م",2,0],["يا من رضيتَ الذلَّ عني عارياً","مولاي لما أن أتيتَ مُؤَنَّسا",55,"س",2,1],["يا مَن رَأى شَفَقاً يَبدو مِن الفَلَق","وَلا يغطى مِن الأَصداغ بِالغَسَق",56,"ق",1,0],["يامن رحم يعقوب ومن شفا أيوب","فرج على المكروب ذي قلبه مسقوم",57,"م",1,0],["يا مَن رأيت الهوى من أجله حَسَناً","فيه ولو أنّه في غيره قَبُحا",58,"ح",2,0],["يا مَن رأى ظعن الخَليط كَأَنَّها","نَخل الرُبا أَو دوم ذي الحَدَقَينِ",59,"ن",1,0],["يا من رأيت به المديح فريضة","ومن المدايح واجب وتطوّع",60,"ع",1,0],["يا من رأيت انفراجي","لديهِ بعدَ مَضيق",61,"ق",1,0],["يا مَنْ رأَى الجودَ يَغْشى نَعْشَهُ شَغِفاً","بالهَمِّ مُرْتَدِياً بالحزنِ مُلتَحِفا",62,"ف",2,0],["يا من رأى مثلي المنية صورة","للعيش لا تجزع من الأرزاء",63,"ا",2,0],["يا من رأته العبقرية ندها","في الخلق والآداب والإحسان",64,"ن",1,0],["يا من رأى النَّفْرَ ولمَّا يَمتْ","نجوتَ فأخلُدْ أبدا باقيا",65,"ي",2,0],["يا من رآني قبلَ أحمدَ سائلا","قوماً يقول جوادُهم لي عُدَّني",66,"ن",2,0],["يا من رأى بالعقيق بارقةً","تحسرُ منها الرُّبَى وتعتَمُّ",67,"م",1,0],["يا من رأى بحاجرٍ مَجالياً","من حيثُ ما استقبلها فهي قِبَلْ",68,"ل",1,0],["يا من رأى باللِّوى بُرَيقاً","تقدَحُ نيرانَهُ الجَنوبُ",69,"ب",1,0],["يا من رأيت بكفه","ماضي المضارب كالمنون",70,"ن",1,1],["يا مَن رَأى ذُلّي لَهُ فَاِستَقدَرا","اِنظُر إِلَيَّ فَقَد بَقيتُ مُحَيَّرا",71,"ر",2,1],["يا م