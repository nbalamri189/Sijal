{"poems":[[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[87,"يا فارسا ترجلا","https://www.aldiwan.net/poem7259.html","مجزوء الرجز"],[124,"ألومك لو أرى لو ميك يجدي","https://www.aldiwan.net/poem49307.html","الوافر"],[147,"هواكم وإن لم تسعفونا ولم تجدوا","https://www.aldiwan.net/poem11744.html","الطويل"],[186,"سترت حبك في قلب إليك صبا","https://www.aldiwan.net/poem67063.html","البسيط"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[286,"لم أكتحل إثمداً ولكن","https://www.aldiwan.net/poem1394.html",""],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[333,"ملأت بالدمع كأسي","https://www.aldiwan.net/poem54927.html","المجتث"],[369,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[409,"جمال الهدى أوحشت لا زلت مؤنسا","https://www.aldiwan.net/poem33697.html","الطويل"],[466,"أهلا بغر قوافيكم لقد طلعت","https://www.aldiwan.net/poem16069.html","البسيط"],[484,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[509,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[563,"وراء هذا الوجود عندي","https://www.aldiwan.net/poem34585.html","مخلع البسيط"],[563,"كلامنا غير ما تعطى العبارات","https://www.aldiwan.net/poem34718.html","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39018","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65045","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100418","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121653","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91158","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92328","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85245","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124042","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[4978,"تالله سالت دموعي من مآقيها","https://www.poetsgate.com/ViewPoem.aspx?id=177133",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[5376,"قد زاد شوقي كما النيران فاحتدما","https://www.poetsgate.com/ViewPoem.aspx?id=188561",""],[5545,"ثغر الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=191688",""],[5612,"الطريقُ الصَّعْب","https://www.poetsgate.com/ViewPoem.aspx?id=179789",""],[6035,"لادامت لكم نِعمُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175082",""]],"verses":[["فلا تَظْلمي قلبي لوَجهْي فإنّني","أرى ظُلْم خيري شرَّ خُطَّةِ سائمِ",0,"م",1,0],["فلا تظن ذكرهم","يدنى إليك أملا",1,"ل",2,0],["فلا تظهر لهذا الناس أنا","قديماً قد تلابسنا لصحابا",2,"ب",2,0],["فَلا تُظهِروا سُخطاً إِذا لَم يَكُن رِضىً","وَلا تُكثِروا ذَمّاً إِذا لَم يَكُن حَمدُ",3,"د",1,0],["فَلا تَظُننَّ قَلبي عَنكَ مُنصَرِفاً","وَإِن يَكُن باتَ بِالأَشجان مَكسورا",4,"ر",2,0],["فلا تظنّي ضنايَ مِثلَ ضَنى","عينيكِ ذا صحّةٌ وذا عِلَلُ",5,"ل",1,0],["فلا تظن اكتحال عيني","ويك لطب ولا لزين",6,"ن",1,0],["فلا تظهر الابغاض بغضا فربما","يصير بغيض المرء أقرب خلان",7,"ن",1,0],["فلا تظني فؤادي","قد نام عن ذكرياتي",8,"ي",1,0],["فلا تَظُنَّنَّ أنّي عنك مُصطَبِرٌ","وإن رحَلْتَ فمالي عنك مُصطَبَر",9,"ر",1,0],["فلا تظلم المملوك إن كان محسن","أساء فإني للمردة حافظ",10,"ظ",1,0],["فلا تظُنُّوا به نقْصاً فقد نُثِرتْ","عليَّ منه بأيدي مجدكم دُرَرُ",11,"ر",1,0],["فلا تظن الظنون","فيما ارتآه ضلالا",12,"ل",2,0],["فلا تظلم التقوى والا مجازيا","يعاد بك سلطان التقى وهو عادل",13,"ل",1,0],["فَلا تَظنّوا اِصطِلاحاً أَنْ يَكون لنا","فَلم يدع ما أَتَيتمْ بَيننا صُلُحا",14,"ح",2,0],["فلا تظنوا بأن هذا ال","وجود ذاك الوجود عندي",15,"د",2,0],["فلا تظن بأني إن وصفت حلى","شيء مرادي به تلك الإحالات",16,"ت",1,0],["فَلا تظنَّنَّ أنْ يُصْغي لِنَغْمتِهِ","قلبٌ فَيُسلِمَهُ أخُرى المدى وَصَبُ",17,"ب",1,0],["فَلا تظُنَّهُ وَصْفَ خِمْعٍ","مِنْ سُنَّحٍ في الْفَلاةِ عُفْرِ",18,"ر",1,0],["فلا تظهر الشكوى لمن لا تحبه","وان هو قد افضى اليك بشكواه",19,"ا",2,0],["فلا تُظْهِرَنَّ الفقْرَ ما دُمْتَ بينهم","وأظْهِرْ غنىً عنهم فذلك أجْمَلُ",20,"ل",1,0],["فَلا تظلمونا نتقيكم فنعتزي","وَتعلو شَواظٌ لَيس يُطفئها دم",21,"م",1,0],["فلا تظن الهوى دعوى بلى حكم","ولا تَعُدَّ اطّرادَ الخيل برهانا",22,"ن",2,0],["فلا تظنوا به منا لما وهبت","يداه خاشاه من بخل ومن غار",23,"ر",1,0],["فلا تَظُنَّى أنني آسى لِمَا","قَد بزَّني صَرفُ الزَمانِ وبَزا",24,"ا",1,0],["فلا تظّنوا ظنون السوء بي فلكم","تجنّب الماء صاد خوف ارصاد",25,"د",1,0],["فلا تظلمنْ مثقالَ ذرةٍ واعملنْ","ليوم به كلٌّ لمولاهُ هاطعُ",26,"ع",1,0],["فلا تظني بأن البعد يفصلنا","فوحدة الروح ما شيء يضاهيها",27,"ي",3,0],["فلا تظنن بي سوءاً وإن خفيت","عليك مني الخطى فالسوء في الظنن",28,"ن",1,0],["فلا تظن بان العمر في سعة","كلمحة الطرف راح الدهر منصرما",29,"م",2,0],["فلا تظننَ عين الشمسِ إن عزمتْ","على الأُفُولِ سينسى فضلَها الرُطبُ",30,"ب",1,0],["فلا تظلِمْ فؤادَكَ طُولَ دهْرٍ","ويكْفي ما نَظرْتَ وما صَبرْتا",31,"ت",2,0],["فلا تظنّن أنّ الحقّ منهزمٌ","ولا إذا طال ليلُ القهر ننهزمُ",32,"م",1,0]]}