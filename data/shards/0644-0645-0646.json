قصد المنون له فمات فقيدا","https://www.aldiwan.net/poem39456.html","الكامل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85830","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140874",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9896","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9987","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9958","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9904","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20992","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21039","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20981","الوافر"],[23,"","https://poetry.dctabudhabi.ae/diwan/poem/6499","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54900","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142064","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199481","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[77,"مولاي منذ بعدت دياري لا تسل","https://www.poetsgate.com/ViewPoem.aspx?id=33637",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[90,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"شجوُ قلبي من سائر الخلق شاجي","https://www.poetsgate.com/ViewPoem.aspx?id=27411",""],[99,"إفادة في محكمة الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=203&r=&rc=17",""],[31,"لِمَنْ الدّارُ كَخَطٍّ بِکلقَلَمْ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19046&r=&rc=309",""],[18,"أن في الصدر من كُلَيْب شجونا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26436&r=&rc=2",""],[4,"لِمَنْ طَلَلٌ تَضَمَّنَهُ أُثَالُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10935&r=&rc=30",""]],"verses":[["لِمَن بَعدَهُ أَسيافُهُ وَقَناهُ","وَمَن يولِعُ البيضَ الرِقاقَ سِواهُ",0,"ه",1,1],["لِمَنِ الضَوامِرُ عُرِّيَت أَمطاؤُها","حَولَ الخِيامِ تُنازِعُ الأَمطالا",1,"ل",2,0],["لِمَنِ المَطايا غَيرُ ذاتِ رَحائِلٍ","فارَقنَ ذاكَ السَدوَ وَالإِرقالا",1,"ل",2,0],["لِمَنِ النُصولُ نَشِبنَ في أَغمادِها","كَلَفَ الظُبى لا يَنتَظِرنَ صِقالا",1,"ل",2,0],["لِمَنِ الأَسِنَّةُ قَد نَصَلنَ عَنِ القَنا","وَعَدِمنَ جَرّاً في الوَغى وَمَجالا",1,"ل",2,0],["لِمَن دِمَنٌ بِذي سَلَمٍ وَضالِ","بَلينَ وَكَيفَ بِالدِمَنِ البَوالي",2,"ي",1,1],["لِمَنِ الحُدوجُ تَهُزُّهُنَّ الأَنيُقُ","وَالرَكبُ يَطفو في السَرابِ وَيَغرَقُ",3,"ق",1,1],["لِمَنِ الدِيارُ طُلولُها وُقصُ","ما لِلقَطينِ بِعُقرِها شَخصُ",4,"ص",1,1],["لِمَن أَطلُبُ المالَ مِن بَعدِكُم","وَأُحفي الحِصانَ وَأُنضي الجَنيبا",5,"ب",2,0],["لمنِ الظّعائِنُ دون أكثِبَةِ الحِمى","يَطوي الفَلاةَ بهِنَّ كُلُّ أَمونِ",6,"ن",1,0],["لِمَنْ فِتْيَةٌ مَنشورَةٌ وَفَراتُها","رَواعِفُ في أيْمانِها قَنَواتُها",7,"ت",3,1],["لِمَنِ الدِيارُ عَفونَ بِالحَبسِ","آياتُها كَمَهارِقِ الفُرسِ",8,"س",1,1],["لِمَن يَلتَقي أَبطالَها وَسَراتَه","بِقَلبٍ صَبورٍ عِندَ وَقعِ المَضارِبِ",9,"ب",1,0],["لَم نَدرِ ما الدُنيا وَما طيبُها","وَحُسنُها حَتّى رَأَيناها",10,"ا",3,0],["لِمَن بَشّرَني البَشرَى","عَلى العَينينِ وَالراسِ",11,"س",1,0],["لمَنْ علَمٌ في هضْبَةِ المُلْكِ خفّاقُ","أفاقَتْ بهِ منْ غَشْيَةِ الهَرْجِ آفاقُ",12,"ق",1,1],["لِمَنْ دِمَنٌ يَشْكُو الْعَفَاءَ رُسُومُهَا","كَخَطِّ زَبُورٍ فِي مَصَاحِف رُهْبان",13,"ن",1,0],["لمَنْ طَلَلٌ نائِي المَزارِ بَعيدُهُ","وعهْدٌ كَريمٌ لا يُذَمُّ حَميدُهُ",14,"د",2,1],["لَم نَطَأكُم يَوماً بِظُلمٍ وَلَم نَه","تِك حِجاباً وَلَم نُحِلَّ حَراما",15,"م",2,0],["لَم نُؤذِ في الدَهرِ جاراً","وَلَم نُخاتِل خَدينا",16,"ن",2,0],["لَم نَجِد ما يَفي بِقَدرِكَ في المَج","دِ فَيُهدى إِلى حِماكَ الكَريمِ",17,"م",1,1],["لُمنا اِبنَ شيثٍ وَقُلنا في مَلامَتِهِ","أَسرَفتَ في حُبِّ إِبراهيمَ فَاِقتَصِدِ",18,"د",1,1],["لَم نَعتَقِد بَعدَكُم إِلّا الوَفاءَ لَكُم","رَأياً وَلَم نَتَقَلَّد غَيرَهُ دينا",19,"ن",2,0],["لَم نَجفُ أُفقَ جَمالٍ أَنتِ كَوكَبُهُ","سالينَ عَنهُ وَلَم نَهجُرهُ قالينا",19,"ن",2,0],["لِمَن طَلَلٌ أَبصَرتُهُ فَشَجاني","كَخَطِّ زَبورٍ في عَسيبِ يَمانِ",20,"ن",1,1],["لِمَنِ الدِيارُ غَشِيتُها بِسُحامِ","فَعَمايَتَينِ فَهُضبُ ذي أَقدامِ",21,"م",1,1],["لِمَن طَلَلٌ بَينَ الجُدَيَّةِ والجبَل","مَحَلٌ قَدِيمُ العَهدِ طَالَت بِهِ الطِّيَل",22,"ل",1,1],["لِمَنِ الدِيارُ بِأَبرَقِ الحَنّانِ","فَالبُرقِ فَالهَضَباتِ مِن أُدمانِ",23,"ن",1,1],["لَمْ نَلْقَ فِيمَا بَيْنَكُمْ إِلاَّ أَباً","وَأَخاً وَمِعْوَاناً أَبَرَّ حَمِيمَا",24,"م",2,0],["لِمَن طَلَلٌ عافٍ بِوَهبينَ راوَحَت","بِهِ الهوجُ حَتّى ما تَبينُ دَواثِرُه",25,"ر",2,1],["لمن دري أني نهواه","هزّ الوتر وتكلّم",26,"م",1,0],["لمن الركائب بعد بعدك تُنتضى","ما بين شامٍ ترتمي وعراقِ",27,"ق",1,0],["لمن قبةٌ حمراء مُدْ نُضارُها","تطابق منها أرضُها وسماؤُها",28,"ا",3,1],["لمن الجيادُ الصافناتُ كأنها","في الوِرْدِ أسرابُ القطا الأرسالِ",29,"ل",1,0],["لمن القباب الحمر تُشرَع للندى","فتفيض للعافين فيض سجالِ",29,"ل",1,0],["لمن الخيام البيض تحسب أنها","زُهْرُ الكواكب أَطلِعَتْ بِحِلالِ",29,"ل",1,0],["لمن الديار يلحن في الصحصاح","لعبت بهن روامس الأرواح",30,"ح",1,1],["لم نحُل عن عهودنا مذ جفتنا","بل لها الودّ عندنا والوفاء",31,"ا",2,0],["لمن تركت فنون العلم والأدب","أما خشيت عليها من يد العطب",32,"ب",1,1],["لِمَنِ الدِيارُ بِبُرقَةِ الرَوحانِ","إِذ لا نَبيعُ زَمانَنا بِزَمانِ",33,"ن",1,1],["لِمَن رَسمُ دارٍ هَمَّ أَن يَتَغَيَّرا","تَراوَحَهُ الأَرواحُ وَالقَطرُ أَعصُرا",34,"ر",2,1],["لِمَنِ الحُمولُ مِنَ الإِيادِ تَحَمَّلَت","كَالدَومِ أَو ظَلَلِ السَفينِ العابِرِ",35,"ر",1,0],["لِمَنِ الدِيارُ كَأَنَّها لَم تُحلَلِ","بَينَ الكِناسِ وَبَينَ طَلحِ الأَعزَلِ",36,"ل",1,1],["لِمَنِ الدِيارُ رُسومُهُنَّ خَوالي","أَقَفَرنَ بَعدَ تَأَنُّسٍ وَحِلالِ",37,"ل",1,1],["لِمَن طَلَلٌ هاجَ الفُؤادَ المُتَيَّما","وَهَمَّ بِسَلمانينَ أَن يَتَكَلَّما",38,"م",2,1],["لِمَن طَلَلٌ تَضَمَّنَهُ أُثالُ","فَسَرحَةُ فَالمَرانَةُ فَالخَيالُ",39,"ل",1,1],["لِمَنِ الجُدودُ الأَكرَمو","نَ مِنَ الوَرى إِلّا لِيَه",40,"ي",2,1],["لِمَن أُعاتِبُ مالي أَينَ يُذهَبُ بي","قَد صَرَّحَ الدَهرُ لي بِالمَنعِ وَالياسِ",41,"س",1,1],["لِمَن جاهَدَ الحُسّادُ أَجرُ المُجاهِدِ","وَأَعجَزُ ما حاوَلتُ إِرضاءُ حاسِدِ",42,"د",1,1],["لِمَن مَنزِلٌ عافٍ كَأَنَّ رُسومَهُ","خَياعيلُ رَيطٍ سابِرِيٍّ مُرَسَّمِ",43,"م",1,1],["لِمَنِ الدارُ أَقفَرَت بِبُواطِ","غَيرَ سُفعٍ رَواكِدٍ كَالغَطاطِ",44,"ط",1,1],["لِمَنِ الدارُ أَوحَشَت بِمَغانِ","بَينَ أَعلى اليَرموكِ فَالخَمّانِ",45,"ن",1,1],["لِمَنِ الدارُ وَالرُسومُ العَوافي","بَينَ سَلعٍ وَأَبرَقِ العَزّافِ",46,"ف",1,1],["لِمَنِ الصَبِيُّ بِجانِبِ البَطحاءِ","مُلقىً عَلَيهِ غَيرَ ذي مَهدِ",47,"د",1,1],["لِمَن سَواقِطُ صِبيانٍ مُنَبَّذَةٍ","باتَت تَفَحَّصُ في بَطحاءِ أَجيادِ",48,"د",1,1],["لمن بكفيه إما طوق عارضةٍ","للأولياء وإما غلّ أعداء",49,"ا