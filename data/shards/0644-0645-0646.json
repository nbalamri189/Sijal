تَ غَيَّرَها طُولُ القِدَم",189,"م",1,1],["لِمَنِ الظُّعنُ كَالَبسَاتينِ في الصُّب","حِ تَرَى نَبتَها أَثيثاً نَضيرا",190,"ر",2,1],["لِمن ليل بِذي جُشُمٍ طَويلُ","لِمَن قَد شَفَّهُ همٌّ دَخيلُ",191,"ل",1,1],["لِمَنِ الدارُ أَقفرت بمعان","بَينَ شاطي اليَرموكِ فَالصمّان",192,"ن",1,1],["لِمَنْ الخِيَامُ فَمَا عَلَى","جَبَلٍ لِنَسْرٍ مُعْتَصَمْ",193,"م",1,0],["لِمَنْ تَسْتَعِدُّ السَّيْفَ كُنْتُ أَوَدُّهُ","يُرَوِّي الثَّرَى الظَّمْآنَ مِنْ مُهْجَةِ الدَّهْرِ",194,"ر",1,0],["لَمْ نَخَلُهُ يَنْقَضُّ إِلاَّ إِذَا انْقَ","ضَّ شِهَابٌ أَوْ قِيلَ لِلأَرْضِمِيدي",195,"د",2,0],["لَمْ نُحَدَّثُ عَنْ مُبْتَ","كِرٍ مَا ابتَكَرْتَهُ فِي العَطَاءِ",196,"ا",2,0],["لمن ْ أزاهر هذا العيد باسمة؟","وليس في الروض تسجيعٌ وتغريدُ",197,"د",1,1],["لمن ينساق هذا المال","قولي يا سما قولي",198,"ي",1,0],["لَمْ نَجدهُ... وقيل: «هذا الفِراقُ!»","فاستجارت بدمعِها الأحداقُ",199,"ق",1,1],["لم نميّزهم ولم نع","رف غنيّا من فقيرِ",200,"ر",1,0],["لم نَرَ البَدْرَ قبله يعتلي العَرْ","شَ ويُمْسِي الجلالُ من هَالاَتهْ",201,"ت",2,0],["لمْ نَشْكُرِ الأيَّامَ عند بَريقِهِ","حَتَّى أَخذْنَا نَشْتَكِي الأيَّاما",202,"م",2,0],["لمن الأحمر المراق بسيناء","يحاكي شقائق النعمان",203,"ن",1,0],["لِمَنِ السفينُ يَلُحَنَ كالأعلامِ","فوق العُباب نواشِرَ الأعلامِ؟",204,"م",1,1],["لم نلق بعدك ما يلذ لناظري","من حسن أرجاء وزهر بطاح",205,"ح",1,0],["لم ندرِ ما نَسْتزيدُ منهُ","لو قيلَ : هلْ عندَهُم مَزيد؟",206,"د",1,0],["لمن وإلى مَ مِن ألمٍ يُنادي","كَفاَه مذَّلةً أن لا يجابا",207,"ب",2,0],["لمن الصُّفوف تحفُّ بالأمجاد","وعلى من التاج الملمع باد",208,"د",1,1],["لمنِ المحافلُ جمّة الوُفّادِ","جَلَّ المَقام بها عن الانشادِ",209,"د",1,1],["لمن طللٌ بين الجُديةِ والجَبلْ","محَلّ قديمُ العهد طالتْ به الطٌّولْ",210,"ل",1,1],["لم نزل لم نزل .. نمصمص شعرا","وفلسطين خضبتها الدماء",211,"ا",2,0],["لم نزل نشرب المدامة حتى","عاد منها الفصيح كاللَّجلاجِ",212,"ج",1,0],["لم نزَل، لم نزَل نمصمصُ قشراً","وفلسطينُ خضّبتها الدماءُ",213,"ا",2,0],["لِمَنْ الدّارُ كَخَطٍّ بِکلقَلَمْ،","لم يغيرْ رسمها طولُ القدمْ",214,"م",1,1],["لَمْ نَرَ النَّاسَ مِثْلَنَا يَوْمَ سِرْنَا","نسلبُ الملكَ غدوة ً وَ رواحا",215,"ح",2,0],["لِمَنْ طَلَلٌ تَضَمَّنَهُ أُثَالُ","فسرحة ُ المرانة ُ فالخيالُ",216,"ل",1,1]]}