3,"س",2,0],["حَتّى مَتى أَنا مَوقوفٌ عَلى ظَمَإٍ","بَينَ الطَريقَينِ لا وِرداً وَلا صَدرا",4,"ر",2,1],["حَتّى مَتى صَبري لَهُ","يا حَرَبي يا سَلَبي",5,"ب",2,0],["حَتّى مَتى أَكتُبُ أَشكو الهَوى","وَلا تَجودينَ بِرَدِّ الجَواب",6,"ب",1,0],["حَتّى ما تَسرقُني في كُلِّ مجمَعَةٍ","عَرضي وَأَنتَ إِذا ما شِئتَ مُنتَقِلُ",7,"ل",1,0],["حتى متى أنا في البلدان مغترب","نوائب الدهر بالأنياب تُدميني",8,"ن",2,0],["حَتّى مَتى أَنتَ مَشغوفٌ بِغانِيَةٍ","صَبٌّ إِلَيها طَوالَ الدَهرِ مَكروبُ",9,"ب",1,0],["حتَّى مددت إليه راحة عائل","طاوٍ فعجلنا نداه وكرشا",10,"ش",2,0],["حتى مَ يا روضتي ويا غصني","حشاشتي من تقاطع دهشه",11,"ش",2,0],["حتَّى مَ أسأل عن لهوٍ وعن لعبٍ","وفي غدٍ أنا عن عقباه مسؤول",12,"ل",1,0],["حتَّى مَ تشكو كسرةً من جفنها","وإلى متى من فرعها تتظلم",13,"م",1,0],["حتَّى ملا عيني نداه عينا","وطبتُ نفساً إذ قضيتُ دينا",14,"ن",2,0],["حتَّى متى يُورِي سِوايَ وأقْتَدِحْ","حتى متى يُعْطى سواي وامْتَدِحْ",15,"ح",1,1],["حتى متى تبكي الديا","رَ وفرعُ رأسك مُخلِس",16,"س",1,0],["حتى متى نحن من إساءَتِنا","وعَتْبِنا في وقائع حُمُس",17,"س",1,0],["حتى متى أنت كذا مبتلىً","بالسلّ لا تحيا ولا تقضي",18,"ض",2,0],["حتى متى تتقضى دولة أُنُفٌ","يا أهل ودي وتأتي دولة أنف",19,"ف",1,0],["حتى متى لا تُفيقُ من سِنَةٍ","ولا يداوي مفنِّدٌ فندَكْ",20,"ك",1,0],["حتى متى نشتري دنيا بآخرةٍ","سفاهةً ونبيعُ الفوْق بالدون",21,"ن",1,0],["حَتّى ما في لا شَيءَ يَقتَتِلُ الوَرى","إِنَّ الحِمامَ عَلى الجَميعِ بِمَرصَدِ",22,"د",1,0],["حَتّى ما يا صاحِ تَخفيهِ وَتَطمُرُهُ","كَأَنَّما هُوَ سَوآتٍ تُواريها",23,"ي",3,0],["حَتّى مَتى وَإِلى مَتى","أَنا بَينَ هِجرانٍ وَبَينِ",24,"ن",1,1],["حتى متى نَشْقى ليَسْعَد غيرنا","ونُذلِّل القُربى لعِزّ بعيد",25,"د",1,0],["حتى ملكت مجرى","بحر الغزال طرّا",26,"ر",2,0],["حتى مررت على الأيدي يدٍ فيدٍ","وطال في عالم الأهوال تردادي",27,"د",2,0],["حَتّى مَشى اللَيثُ مَعَ الحِمارِ","وَأَخَذَ القِطُّ بِأَيدي الفارِ",28,"ر",1,0],["حَتّى مَضى الشَهرُ وَجاءَ الشَهرُ","وَعُرِفَ اللِصُّ وَشاعَ الأَمرُ",29,"ر",1,0],["حتى مضى اليومُ مُبيَضّاً شمائلُه","وعارضَتْ شمسُه مصفرَّةَ النُّورِ",30,"ر",1,0],["حَتّى مَتى لا تَرعَوي يا صاحِبي","حَتّى مَتى حَتّى مَتى وَإِلى مَتى",31,"ا",1,0],["حَتّى مَتى تَبغي عِمارَةَ مَنزِلٍ","لا تَأمَنُ الرَوعاتِ فيهِ وَلا الأَذى",31,"ا",1,0],["حَتّى مَتى يا نَفسُ تَغ","تَرّينَ بِالأَمَلِ الكَذوبِ",32,"ب",1,0],["حَتّى مَتى أَنتَ حَريصٌ عَلى","كَثيرِ ما يَكفيكَ مِنهُ اليَسير",33,"ر",1,0],["حَتّى مَتى وَالمَنايا لي مُخاتِلَةٌ","يَغتَرُّني في صُروفِ الدَهرِ وَسواسي",34,"س",2,0],["حَتّى مَتى تَصبو وَرَأسُكَ أَمشَطُ","أَحَسِبتَ أَنَّ الَمَوتَ بِاِسمِكَ يَغلَطُ",35,"ط",1,1],["حَتّى مَتى أَنتَ لاعِبٌ إِشِرٌّ","حَتّى مَتى أَنتَ بِالصِبا وَلِعُ",36,"ع",1,0],["حَتّى مَتى يَستَفِزُّني الطَمَعُ","أَلَيسَ لي بِالكَفافِ مُتَّسَعُ",37,"ع",1,1],["حَتّى مَتى أَنتَ بِالآمالِ مُشتَبِكٌ","إِذا اِنقَضى أَمَلٌ أَمَّلتَ آمالا",38,"ل",2,0],["حَتّى مَتى تُمسي وَتُصبِحُ لاعِباً","تَبغي البَقاءَ وَتَأمُلُ الآمالا",39,"ل",2,0],["حَتّى مَتى لَيتَ شِعري يا اِبنَ يَقطينِ","أُثني عَلَيكَ بِشَيءٍ لَستَ توليني",40,"ن",2,0],["حَتّى مَتى لا تَعقِلي","نَ وَتَسمَعينَ وَتُبصِرينا",41,"ن",2,0],["حَتّى مَتى نَحنُ في الأَيّامِ نَحسُبُها","وَإِنَّما نَحنُ فيها بَينَ يَومَينِ",42,"ن",1,0],["حَتّى مَتى ذو التيهِ في تيهِهِ","أَصلَحَهُ اللَهُ وَعافاهُ",43,"ا",2,1],["حَتّى مَتى أَنتَ في لَهوٍ وَفي لَعِبٍ","وَالمَوتُ نَحوَكَ يَهوي فاغِراً فاهُ",44,"ا",2,0],["حَتّى مَتى أَنا في حِلٍّ وَتَرحالِ","وَطولِ سَعيٍ بِإِدبارٍ وَإِقبالِ",45,"ل",1,1],["حَتّى مَتى لَيتَ شِعري يا اِبنَ يَقطينِ","أُثني عَلَيكَ بِما لا مِنكَ توليني",46,"ن",2,1],["حتى مشت كفّاك فوق العذاب","يا ليل إني لشقي سعيد",47,"د",1,0],["حتَّى متى بَينَ اللوى فالأجْرَعِ","لَوْماً فما أَمَرَّهُ في مَسمَعي",48,"ع",2,1],["حَتّى مَقالِهِمُ إِذا اِجتَمَعوا","أَجُنِنتَ أَم ذا داخِلُ السِحرِ",49,"ر",1,0],["حَتى مَتى أَنتَ لَنا هَكَذا","نَفسي فِداءٌ لَكَ يا حارِثي",50,"ث",2,0],["حَتّى مَرَرنَ بِنا يَخِد","نَ خِلالَ ذي قَطَنٍ فَحامِل",51,"ل",1,0],["حَتّى مَتى أَنتَ في مُعَصفَرَةٍ","عَلى جَوادٍ وَتَلبَسُ الحُلَلا",52,"ل",2,0],["حَتّى مَتى نَلتَقي عَلى حَذَرٍ","أَما لَنا مِن عَذابِنا فَرَجُ",53,"ج",1,0],["حَتّى مَتى يُشمِتُ الهِجرانُ حاسِدَنا","في كُلِّ يَومٍ لَنا نَوعٌ مِنَ الصَخَبِ",54,"ب",1,0],["حَتّى مَتى أَنتَ تَلهو","في غَفلَةٍ وَتُمازِح",55,"ح",1,0],["حَتّى مَتى لا تَرعَوي عَن لَذَّةٍ","وَحِسابُها يَومَ الحِسابِ شَديدُ",56,"د",1,0],["حَتّى مَتى لا نَرى شَيئاً نُسَرُّ بِهِ","قَد طالَ هَجرُكِ ما نَهوى وَمُنتَظَري",57,"ر",2,0],["حَتّى مَغاني أَهلِها دُثورُ","وَمِن سِفاهٍ وَالرَدى مُغيرُ",58,"ر",1,0],["حَتّى مَتى تُبقي لِنَفسِكِ حُبَّهُ","وَالمَرءُ يَصبِرُ إِنَّهُ لَصَبورُ",59,"ر",1,0],["حَتّى مَتى أَنا مَشغولٌ بِحُبِّكُمُ","مِن شِدَّةِ الحُبِّ أَو أَهذي بِأَشعاري",60,"ر",2,0],["حَتّى مَتى أَنتِ يا خُشّابَ جالِسَةً","لا تَخرُجينَ لَنا يَوماً وَلا تَلِجُ",61,"ج",1,0],["حَتّى ما تُصبِحُ لِلضَعيفِ مُقَوِّياً","فِعلَ السَفيهِ وَلِلجَبانِ مُشَجِّعا",62,"ع",2,0],["حتى مرضت فبت اللَيل مشتكياً","من طول إظلامه وَاللَيل منتصف",63,"ف",1,0],["حتى مشت كتيبة الحواري","عليك كالأنوار والأنوار",64,"ر",1,0],["حَتَّى مَضَيْتَ كَمَا ابْتَغَيْتَ مُؤَلِّفاً","مِنْ شَمْلهَا مَا لَمْ يَكُنْ لِيُؤَلَّفَا",65,"ف",2,0],["حَتّى مَتى في كُلِّ يَومٍ سَخطَةٌ","قَد ذُبتُ مِن سَخَطاتِها وَعِتابِها",66,"ب",3,0],["حتّى متى لا تَرى عدلاً تسرّ به","ولا ترى لدعاة الحقّ أعوانا",67,"ن",2,1],["حتى مَ هذا الوعدُ والايعادُ","وإلام كتمِ الابراقُ والارعادُ",68,"د",1,1],["حتّى م ، يا صاح ، تخفيه وتطمره","كأنّما هو سوءات تواريها ؟",69,"ي",3,0],["حتّى م في لا شيء يقتتل الورى","إنّ الحمام على الجميع بمرصد",70,"د",1,0],["حتَّى متى يُورِي سِوايَ وأفْتَدِحْ","حتى متى يُعْطَى سواي وأمْتَدِحْ",71,"ح",1,1],["حَتّى م يَغرس عِندي مِن بَليت بِهِ","غَرس الوُعود وَيَجني مطمَعي الكَذَبا",72,"ب",2,0],["حَتّى م تَرى بِزائل مُلتَهياً","وَالدَهر يُريك كُل يَومٍ عِبرا",73,"ر",2,0],["حتى م اجري في ميادين الهوى","والقلب مني للهوى موثوق",74,"ق",1,1],["حَتّى مَتى نَحنُ عَلى فَترَةٍ","يا هاشِمٌ وَالقومُ في جَحفَلِ",75,"ل",1,1],["حتّى محا الصبحُ سوادَ الدُّجَى","كِلَّمةٍ في يدِ حلاّقِ",76,"ق",1,0],["حَتّى مَضى مَلِكُهُم يَشكو وَغىً بَلَغَت","فيهِ رِضاكَ وَلَم يَبلُغ بِها أَرَبا",77,"ب",2,0],["حَتّى مَضَوا يَحسِبونَ اللَيلَ مِن فَرَقٍ","نَقعَ الرَدى وَنُجومَ اللَي