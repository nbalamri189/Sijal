لغَمضِ أَجفانَ ناظِري","كَما قارَبَ القَومُ العِطاشُ صِلالا",1,"ل",2,0],["أَواخِرٌ مِن مِنَنٍ","يَضُمُّها الأَوائِلُ",2,"ل",1,0],["أَو أَحقَبٌ أَعجَلَهُ قِناصُها","مُشاوِراتِ النَفسِ أَو أَزماعَها",3,"ع",3,0],["أَوائِلي مَن قَد عَلِمتَ في العُلى","وَمَعشَري عَلى القَديمِ مَعشَري",4,"ي",1,0],["أَو أَنَّ هَذي الشَمسَ تَصبُغُ لِمَّةً","صَبَغَت شَواتي طولَ ما أَنا حاسِرُ",5,"ر",1,0],["أُؤانِسُ وَحشيَّ هَذا البَرو","قِ في مَوطِنِ النَعَمِ النافِرِ",6,"ر",1,0],["أَو أَنَّ خُطواً يُستَرابُ بِهِ","مِنكُم سَحَبتُ وَراءَكُم بُردي",7,"ي",1,0],["أَو أَنَّني أَبقى وَظَه","ري بَعدَ أَقراني أَجَبُّ",8,"ب",1,0],["أَو أُمُّ مَثوىً يَلَنجو","جُها عَلى النارِ رَطبُ",9,"ب",1,0],["أَو أَن أَقولَ سَقاهُ","صَوبُ الغَمامِ المُرِبُّ",9,"ب",1,0],["أَو أَن يُبَلَّ غَليلٌ","إِن بَلَّ قَبرَكِ شُربُ",9,"ب",1,0],["أَو أَعوَزَ الخَطبُ في لَيلٍ بُيوتَهُمُ","مَدّوا يَدَ النارِ في الأَعمادِ وَالطُنُبِ",10,"ب",1,0],["أَو إِن أَشاحَ بِهِ سالَ الحِمامُ لَهُ","في مَضرَبَيهِ فَلَم يَرقَأ وَلَم يَصُبِ",10,"ب",1,0],["أَوِ الشَّوقُ إِلّا أَن تَرى مَن تُحِبُّهُ","قَريباً وَلا يُرجى إِلَيهِ وصُولُ",11,"ل",1,0],["أَواضِعَ جَفْنٍ فَوْقَ آخَرَ مِنْ كَرىً","مَتى لَحِقَتْ شَأْوَ الصَّميمِ الوَشَائِظُ",12,"ظ",1,0],["أوانِسُ أبرَزَهُنَّ النّوى","فلاحَتْ بُدوراً وماسَتْ غُصونا",13,"ن",2,0],["أُواصِلُ الخِشْفَ والغَيْرانُ مُرْتَقِبٌ","لا خَيْرَ في الوَصْلِ عِندي غَيْرَ مَرْقوبِ",14,"ب",1,0],["أوْ أطْرُقَنَّ القِبابَ الحُمْرَ يَصْحَبُني","أغَرُّ مِن كُلِّ ما أخشاهُ يُنْجيني",15,"ي",1,0],["أَو أَنكَرَت فُرسانُ عَبسٍ نِسبَتي","فَسِنانُ رُمحي وَالحُسامُ يُقِرُّ لي",16,"ل",2,0],["أَو أَن تُريدُ الخَيرَ لِلإِن","سانِ وَهُوَ يُريدُ ضَيرَكَ",17,"ك",1,0],["أو أمّ اليَمَّ بعَزْمَتِهِ","يوْماً لتصَدّعَ وانْفَرَقا",18,"ق",2,0],["أَوِ الدِّينُ مَرْفُوعاً عَلَى عَمَدِ التُّقَى","أَوِ الْكلِمُ الْحِكْمِيُّ يُشْفَى بِهِ الْكَلْمُ",19,"م",1,0],["أَوْ أَشْهَبٍ إِنْ لاَحَ فِي غَسَقِ الدُّجَى","فَكَأَنَّمَا هُوَ غُرَّةٌ فِي أَدْهَمِ",20,"م",1,0],["أو أتى للبِحارِ يجْلُبُ ماءً","يبِسَتْ كلّما أتاها البِحارُ",21,"ر",1,0],["أو أنْ يتوِّجَ أو يُقلِّدَ هامَها","ونُحورَها بأهِلّةٍ ودَراري",22,"ر",2,0],["أو أريحوا باليأسِ قلْبي فإنّي","قدْ تخبّطْتُ في عَناءٍ كَبيرِ",23,"ر",1,0],["أو أمّةُ عَمرُو بنُ ذُهْلٍ ما طَفَتْ","مُهْجاتُ صِبْيَتِهِ على ذي قارِ",24,"ر",1,0],["أَو أَن يَرَوا جَبّارَها وَأَشاءَها","يَعلو دُخانٌ فَوقَها وَسَعيرُ",25,"ر",1,0],["أَو إِناءِ النُضارِ لاحَمَهُ القَي","نُ وَدارى صُدوعَهُ بِالكَتيفِ",26,"ف",1,0],["أَو أَقَبّاً تَصَيَّفَ البَقلَ حَتّى","طارَ عَنهُ النَسيلُ يَرعى غَريرا",27,"ر",2,0],["أَو أَطاروا الحَمامَ يَوماً لِزَجلٍ","قابَلوا مِنكَ في السَماءِ عُقابا",28,"ب",2,0],["أَوّاهُ إِنّي أَراهُ","بِالمَوتِ أَمسى رَهينا",29,"ن",2,0],["أَو إِنَّما هِيَ أَلفاظٌ مُدَبَّجَةٌ","وَكُلُّ لَفظٍ تَجَلّى فيهِ مَعناهُ",30,"ا",2,0],["أَو أَنَّها طَرَبٌ بِنَفسِكَ كُلَّما","وُفِّقتَ في بَحثٍ وَكَشفِ نِقابِ",31,"ب",1,0],["أَو أَنَّها اِستِنكارُ ما شاهَدتَهُ","في الناسِ مِن لَهوٍ وَسوءِ مَآبِ",31,"ب",1,0],["أُواصِلُها حَتّي إِذا ما مَلِلتُها","رَأَيتُ لَذيذَ العيشِ في طولِ هَجرِها",32,"ر",3,0],["أَو أَرتَجي خِلّاً سِواكَ أَبُثُّهُ","الشَكوى وَتُحفَظُ عِندَهُ الأَسرارُ",33,"ر",1,0],["أَوِ العِلقَ يُخفى في الصِوارِ وَيُخبَأُ","يَضيقُ بِأَنواعِ الصَبابَةِ مَذهَبي",34,"ي",1,0],["أَو أَتبَعَتكَ حَنينَها","نَفسي فَأَنتَ لَها قَسيم",35,"م",1,0],["أَو أَنأَ عَن صَيدِ المُلوكِ بِجانِبي","فَهُمُ العَبيدُ مَليكُهُم عَبّادُ",36,"د",1,0],["أَو أَن تُسَوِّغَ نِعمَةً","لِلدَهرِ أَسهَرَت الحَسود",37,"د",1,0],["أَوِ المُكرَعاتِ مِن نَخيلِ اِبنِ يامِنٍ","دُوَينَ الصَفا اللائي يَلينَ المُشَقَّرا",38,"ر",2,0],["أَو الدَومُ مِن وادي غُرانَ تَرَوَّحَت","لَهُ الريحُ قَصراً شَمأَلٌ وَدَبورُها",39,"ر",3,0],["أوِ الَّذِي كَشَفَتْ ضَيْماً أَلَمَّ بِهِ","أَوِ الَّذِي مَسَحَتْ مَا فِيهِ مِنْ وَصِبِ",40,"ب",1,0],["أَوْ أَنَّهَا بِالكَظْمِ تَقْضِي مَأْرَباً","لا بَثَّ أَخْيَبُ مِنْ دُمُوعِ الكَاظِمِ",41,"م",1,0],["أَوِ اعْلَمُوا مَرَّةً فِي الدَّهْرِ صَالِحَةً","عِلماً تُؤَيِّدُهُ الأَفْعَالُ وَالهِمَمُ",42,"م",1,0],["أَوِ الْتَمِعْ فِي نِصَالٍ ى عِدَادَ لَهَا","خَطَّافَةٍ تَتَغَنَّى وَهْيَ تَقْتَسِمُ",42,"م",1,0],["أَوْ أَنْ يُبَاحَ لَهُ بِحَاجَةِ آمِلٍ","أَوْ أَنْ تُسَرَّ إِلَيْهِ شَكْوَى كَاتِمِ",43,"م",1,0],["أَوابِدَ قَد حَيَّسَت قَبلَهُ","كُهولَ الرِجالِ وَأَحداثَها",44,"ث",3,0],["أَوانِسُ حورُ الطَرفِ لُعسٌ كَأَنَّها","مَها قَفرَةٍ قَد أَفرَدَتهُ جَآذِرُه",45,"ر",2,0],["أَوانِسَ وُضَّعِ الأَجيادِ عينٍ","تَرى مِنهُنَّ في المُقَلِ اِحوِرارا",46,"ر",2,0],["أو أشقرٍ مرّ عن شقر البروق وقد","أبقى لها شفقاً في الجو تنبيها",47,"ي",3,0],["أو أحمرٍ جمره في الحرب متّقدٌ","يعلو لها شَررٌ من بأس مُذكيها",47,"ي",3,0],["أو أدهمٍ ملء صدر الليل تنعله","أهلّة فوق وجه الأرض يبديها",47,"ي",3,0],["أو أصفرٍ بالعشيّات ارتدى مرحاً","وعُرفُه بتمادي الليل يُنبيها",47,"ي",3,0],["أو أدهمٍ كالليلِ إلاَّ أنه","لم يرضَ بالجوزاء حلي عِذارِ",48,"ر",1,0],["أو أحمر كالجمر يذكي شعلةً","وقد ارتمى من بأسه بشرار",48,"ر",1,0],["أو أشقرٍ حلَّى الجمالُ أديمَهُ","وكساهُ من زهو جلال نُضارِ",48,"ر",1,0],["أو أشعلٍ راق العيون كأنه","غَلَسٌ يخالط سُدفةً بنهارِ",48,"ر",1,0],["أو أدهمٍ كالليل قَّدَ شُهبه","خاض الصباحَ فأثبتَتُه الأجلُ",49,"ل",1,0],["أو أشقرٍ سال النُضار بعطفه","وكساه صبغة بهجةٍ لا تنصلُ",49,"ل",1,0],["أو أحمرٍ كالجمر أضمر بأسه","بالركض في يوم الحفيظة يشعلُ",49,"ل",1,0],["أو أصفرٍ لبس العشي ملاءةً","وبذيله لِلَّيل ذيل مسبلُ",49,"ل",1,0],["أوانس قد نادمن كل غرانق","فمنهنّ من تسقى ومنهنّ من تسقى",50,"ق",2,0],["أو أكرة من دناميت إذا انفجرت","فنارها تنسف الشبان والشيبا",51,"ب",2,0],["أَو آلِ شَمخٍ وَهَل في الناسِ مِثلُهُمُ","لِلمُعتَفينَ وَلا طُلّابِ أَوتارِ",52,"ر",1,0],["أَواصِلٌ أَنتَ أُمَّ العَمروُ أَم تَدَعُ","أَم تَقطَعُ الحَبلَ مِنهُم مِثلَ ما قَطَعوا",53,"ع",3,1],["أَوانِسُ أَمّا مَن أَرَدنَ عَناءَهُ","فَعانٍ وَمَن أَطلَقنَ فَهوَ طَليقُ",54,"ق",1,0],["أَوانِسُ لَم يَعِشنَ بِعَيشِ سَوءٍ","يُجَدِّدنَ المَواعِدَ وَالمِطالا",55,"ل",2,0],["أَواصِلٌ أَنتَ سَلمى بَعدَ مَعتَبَةٍ","أَم صارِمُ الحَبلِ مِن سَلمى فَمَصرومُ",56,"م",1,1],["أو الناطقات الصادقات إذا غدت","باسقية لم يفرهن المطببُ",57,"ب",1,1],["أَو أَن تَكونَ وَقيعَةٌ أَو غارَةٌ","مالي بِها أَثَرٌ مَعَ الفِتيانِ",58,"ن",1,0],["أُوافى عَلى عُلّاتِ عَتبِكَ صابِراً","وَأُلفى عَلى حالاتِ ظُلمِكَ مُنصِفا",59,"ف",2,0],["أوانس أبكارٍ يحقُّ لحسنِها","على ساكنِ الأمصارِ أن يتبرَّجا",60,"ج",2,0],["أواخر نمّ بها أولٌ","ومجمع لم يغن عنْ فرده",61,"د",2,0],["أوالي عليًّا خلد الله مجده","وأشكو أذى عثمان وهو يزيد",62,"د",1,0],["أوَّاه من جائرةٍ جاره","فتَّانة الألحاظ سحَّاره",63,"ر",2,1],["أوَّاهُ من سنٍ وأسنانٍ مضت","في فعليَ العاصي وقولي الطيّع",64,"ع",1,0],["أوانس أن ينعم حشانا بقربها","لقد شقيت من بعدها بكلومها",65,"م",3,0],["أو أرى في أراكها ضوء ثغرٍ","كلَّما ضلَّ رسمها يهديني",66,"ن",2,0],["أوابد قد أعيى امرئ القيس قبلنا","سنا نجمها الهادِي فماتَ مضلَّلا",67,"ل",2,0],["أو أسأنا في مَدْحهم أنَّبونا","وهَجَوْا شعرَنا أشدَّ هجاءِ",68,"ا",2,0],["أو أمُّها الكبرى التي لم يزل","للَّيل من طلعتها جائبُ",69,"ب",1,0],["أو أن أجاوزَ بالعتاب حدودَهُ","فأكونَ عائبَ صاحبٍ ومَعيبَهُ",70,"ب",2,0],["أوابِدُ قد خيَّستْ قبلَهُ","كهولَ الرجال وأحداثَها",71,"ث",3,0],["أو ابن ميمونَ إذ يُضارطُهُ","جهلاً ولا يحفلانِ سوءَ نثا",72,"ث",2,0],["أو أنها تصفو لنا وتعمُّنا","حتى يُخَيَّل أننا نُسْتَدرَجُ",73,"ج",1,0],["أو أكن قصَّر جهدي عنكُم","فأثيبوني ثواب المجتهدْ",74,"د",1,0],["أو استعدَّ عتاداً","سواهما مُسْتَعِدُّ",75,"د",1,0],["أو أصبح المنشور من شكرنا","كأنه من ريحه يُنشر",76,"ر",1,0],["أو الرمحُ ذو النصلين كيف رهِقتهُ","رِهقت حِمام الموت أو يتأخر",77,"ر",1,0],["أو الغيثُ يأتي قطْره قبل سَيله","أو الشمسُ يَهدي ضوءها وضَحُ الفجر",78,"ر",1,0],["أو أناس غدوا وراحوا من الظّر","ف على حالة الفقير الوقير",79,"ر",1,0],["أو أن يُراعي الجارياتِ الخُنَّسا","بل شاعِراً ثَبْتَ المقام أحْوسا",80,"س",2,0],["أو اسْتَجَشْتَ في الكلام فَقْعَسا","كي يُصرِخَاك مِثلها لأُبْلِسا",80,"س",2,0],["أو أن أصلي من وراء قَسِّ","قُرانُهُ تمجيدُ روح القُدس",81,"س",1,0],["أوائلكُمْ داووا أوائلَ دائِها","وأنتم لها إن تاح للداء ناكس",82,"س",1,0],["أو المزن ينأى أن يُمسَّ وما يني","على الأرض منه وابلٌ أو قطاقِط",83,"ط",1,0],["أو الميزان يخفض كل وافٍ","ويرفع كل ذي زنة خفيفه",84,"ف",2,0],["أو أرى المجد قاعداً ليَ عن كف","فِك وعداً مثمّراً إخلافا",85,"ف",2,0],["أو أن يجور به الزمان عن الغنى","أو بي وأنت طريقه وطريقي",86,"ق",2,0],["أو الشجاعُ الذي لا شيءَ يُفْزِعُه","ولا تُردُّ عوادِيه إذا حملا",87,"ل",2,0],["أَوارِدٌ بحرَكم مثلي ومنصرفٌ","في الصادرين بلا علّ ولا نهلِ",88,"ل",1,0],["أو أنكم صحتي وعافيتي","فررتُ من قربكم إلى السقمِ",89,"م",1,0],["أو إثمدٌ وسَمَ البُكاءَ به","حمراً مُضَرَّمةً بلا ضَرَمِ",90,"م",1,0],["أو أنْ يراكَ يَحِلُّ فض","لُكَ لي فُواقاً ثم يَحرُمْ",91,"م",1,0],["أو المبتنِي بنيانَه فوق هائلٍ","من الرَّمْلِ لا ينفك يهوي بما يَبْني",92,"ي",1,0],["أو أن أفلاكَ المعالي سبعةٌ","لخَرقْتَها صُعُداً إليها ثامنا",93,"ن",2,0],["أَوِ اِنتِظامُ العُقودِ أَغضَبَها","فَإِنَّ دُرَّ الكَلامِ مُنتَثِرُ",94,"ر",1,0],["أَوّاهُ هَذي دارُ فاتِنَتي","مَن قالَ ما لِلشَمسِ مِن خِدرِ",95,"ر",1,0],["أَو أَن يَبيتَ عَلى الحَضيضِ مُقامُكُم","وَالدودُ يَزحَفُ فَوقَهُ وَالأَرقَمُ",96,"م",1,0],["أَو إِن كَرِهتَ الحَربَ كُنتَ يَراعَةً","وَإِذا قَتَلتَ أَخاكَ غَيرَ جَبانِ",97,"ن",1,0],["أَو أَنَّ مَرأى الحَشدِ أَقلَقَ روحَهُ","في جِسمِهِ فَهَفا إِلى الطَيَرانِ",98,"ن",1,0],["أَو أَنَّها كَالغولِ لَيسَ لَها أَثَر","فَإِذا المُروأَةُ في رِجالِ بِلادي",99,"ي",1,0],["أَو الخَشرَمُ المَبعوثُ حَثحَثَ دَبرَهُ","مَحابيضُ أَرداهُنَّ سامٍ مُعَسَّلُ",100,"ل",1,0],["أَوِ الأَثلُ أَثلُ المُنحَنى فَوقَ واسِطٍ","مِنَ العِرضِ أَو دانٍ مِنَ الدَومِ ناضِرُ",101,"ر",1,0],["أَوَّاهُ قدْ ضاعتْ عليَّ","سَعَادَةُ القلبِ الغَريرْ",102,"ر",1,0],["أَو أَنَّ مَن يَشري رِضاكَ بِفَوزِهِ","بِالخُلدِ قُلنا إِنَّهُ المَغبونُ",103,"ن",1,0],["او انه في العبقري","يفل غرب المنصل",104,"ل",1,0],["او انه جسر كقنو","النخلة المتعثكل",104,"ل",1,0],["اوان عيني فيها","اذا نظرت قذاة",105,"ه",1,0],["او اني اسمو للكواكب ناظما","فارسلها شعراً إلى صاحب الشورى",106,"ر",2,0],["او اني في مصر الجميلة بلبل","فاطرب بالتغريد تلك الجماهيرا",106,"ر",2,0],["أو الحسناء يوم العرس جنَّت","فمزقتِ الغلائل والنقابا",107,"ب",2,0],["أو اشتهى الأبيض من ملبس","قولوا له الأسود ما أجمله",108,"ل",2,0],["أو أخرت لم يُجدني","أو قدَمت لم أُغبن",109,"ن",1,0],["أَوِ اِستَغنِ عَنِ العَقلِ","إِذَن عَنِّيَ تَستَغني",110,"ي",1,0],["أَوِ اِفتَرَقوا واحِداً واحِداً","حَسِبتَهُمو لُؤلُؤاً يُنثَرُ",111,"ر",1,0],["أَو أَنَّهُ اِبتُلِيَ الخَليلُ بِمِثلِها","أَستَغفِرُ الرَحمَنَ وَلّى مُدبِرا",112,"ر",2,0],["أَو أَنَّ سَيلاً عاصِمٌ مِن شَرِّها","عَصَمَ الدِيارَ مِنَ المَدامِعِ ما جَرى",112,"ر",2,0],["أَوانِسُ في داجٍ مِنَ اللَيلِ موحِشٍ","وَلِلَّهِ أُنسٌ في القُلوبِ وَنورُ",113,"ر",1,0],["أَو أَدرَكا يَومَ المَسي","حِ لَعاوَناهُ عَلى النِكايَه",114,"ا",3,0],["أَو أَنتَ مِثلُ أَبي تُرابٍ يُتَّقى","وَيَهابُهُ الأَملاكُ في أَسمالِهِ",115,"ل",2,0],["أَو أَن تَزُفَّ لَكِ الوِراثَةُ فاسِقاً","كَيَزيدَ أَو كَالحاكِمِ المَأفوكِ",116,"ك",1,0],["أَوِ الدينُ إِلّا ما رَأَت مِن جِهادِهِم","أَوِ المُلكُ إِلّا ما أَعَزّوا وَهَيَّبوا",117,"ب",3,0],["أَوْ أَسْمَرِ الصَّدْرِ أَصْفَرٍ أَزْرَقِ الرَّ","أْسِ وإِنْ كانَ أَحْمَرَ الحَلَبِ",118,"ب",1,0],["أَو آنَسَتكَ المَخازي","فَإِنَّها لَكَ نِسبَه",119,"ب",2,0],["أَواناً في بُيوتِ البَدوِ رَحلي","وَآوِنَةً عَلى قَتَدِ البَعيرِ",120,"ر",1,0],["أَوِ اِبنَ اِبنِهِ الباقي عَلِيَّ بنَ أَحمَدٍ","يَجودُ بِهِ لَو لَم أَجُز وَيَدي صِفرُ",121,"ر",1,0],["أوْ أُسقَ سجْلاً من نداهُ فإنّما","من عندك الأوزامُ والأشطانُ",122,"ن",1,0],["أواعِدُهَا قربَ اللقاءِ ودونَها","مواعيدُ دهرٍ مولعٍ بمَطالِ",123,"ل",1,0],["أواخرُ دهرٍ أشبهتْ في فَسادِها","أوائِلَها ما أشبَهَ الشَّرْجَ بالشَّرْجِ",124,"ج",1,0],["أَواصِرُ زائِرٍ وَزِمامُ ناءٍ","عَلَيكَ ضَمانُهُ حَتّى يَؤوبا",125,"ب",2,0],["أَو اِستَبَقنا المَجازِياتِ فَلَن","يَذهَبَ شِعري لَغواً وَلا ذَهَبُه",126,"ب",2,0],["أَو أَدهَمٍ صافي السَوادِ كَأَنَّهُ","تَحتَ الكَمِيِّ مُظَهَّرٌ بِيَرَندَجِ",127,"ج",1,0],["أَو أَشهَبٍ يَقَقٍ يُضيءُ وَراءَهُ","مَتنٌ كَمَتنِ اللُجَّةِ المُتَرَجرِجِ",127,"ج",1,0],["أَو أَبلَقٍ يَلقى العُيونَ إِذا بَدا","مِن كُلِّ لَونِ مُعجِبٍ بِنَموذَجِ",127,"ج",1,0],["أَوِ الضَيغَمُ الضِرغامُ يَحمي عَرينَهُ","أَوِ الوابِلُ الداني مِنَ الديمَةِ السَحِّ",128,"ح",1,0],["أَو أَشكُرَنَّ أَبا نوحٍ بِأَنعُمِهِ","وَكَيفَ يُشكَرُ ما يَعيا بِهِ العَدَدُ",129,"د",1,0],["أَو أُحَمِّلهُ مُثقِلاً مِن خَراجي","يُلفَ في طَولِهِ قَليلاً كَثيرُه",130,"ر",2,0],["أَوانِسٌ عَطشانَةٌ وُشحُها","رَيّانَةٌ خُرسٌ خَلاخيلُها",131,"ل",3,0],["أَواخِرُ العَيشِ أَخبارٌ مُكَرَّرَةٌ","وَأَقرَبُ العَيشِ مِن لَهوٍ أَوائِلُهُ",132,"ل",2,0],["أَواخِرُ مِن عَيشٍ إِذا ما اِمتَحَنتَها","تَأَمَّلتَ أَمثالاً لَها في الأَوائِلِ",133,"ل",1,0],["أَوانَ رِكابِ الجَهلِ عِندَ تَطَرُّبي","مُوَجَّهَةٌ نَحوَ الخِباءِ المُجَلَّلِ",134,"ل",1,0],["أَو أَن يَبيتَ مومِلوكَ بِلَوعَةٍ","مُتَمَلمِلينَ وَخائِفوكَ نِيامُ",135,"م",1,0],["أَو أَغفَلوا حُجَّةً لَم يُلفَ مُستَرِقاً","لَها وَإِن يَهِموا في القَولِ لَم يَهِمِ",136,"م",1,0],["أَوائِلُ شَيبٍ يُشيرُ العَذو","لُ إِلَيها وَيُكبِرُ مِن شانِها",137,"ن",3,0],["أَو أَجرِ في الحَلبَةِ الأولى بِلا صَفَدٍ","تولونَهُ فَهُوَ الخُسرانُ وَالغَبَنُ",138,"ن",1,0],["أَوِ المَنزِلُ العافي يَرُدُّ أَنيسَهُ","بُكاءً عَلى أَطلالِهِ وَرُبوعِهِ",139,"ع",2,0],["أَو أَن تَزورَ تَميماً في مَنازِلِها","بِمَروَ وَهيَ مَخوفٌ دونَها الغَرَرُ",140,"ر",1,0],["أَوِ النَفيُ حَتّى عَرضُ أَرضٍ وَطولُها","عَلَيهِم كَبَيتِ القَينِ أُغلِقَ بِالقَفلِ",141,"ل",1,0],["أَو أَخدَرِيَّ فَلاةٍ ظَلَّ مُرتَبِئاً","عَلى صَريمَةِ أَمرٍ غَيرِ مَقسومِ",142,"م",1,0],["أَوادٍ بِهِ صِنُّ الوِبارِ يُسيلُهُ","إِذا بالَ فيهِ الوَبرُ فَوقَ الخَراشِمِ",143,"م",1,0],["أوانَ تَحامَتِ الأيامُ سِلْمي","وعُدْنَ عليَّ بالحَرْبِ العَوانِ",144,"ن",1,0],["أَوَانٌ تحَيِّيك أَنوارُه","رَواحاً بأنفاسِها أو بُكورا",145,"ر",2,0],["أو السَّبَجَ المسوَدَّ حُلَّتْ عقودُه","على تُربةٍ محمرَّةٍ من فَضائِها",146,"ا",3,0],["أُواصِلُ فيها الدمعَ يَدمَى مسيلُهُ","وأقطعُ أنفاساً مسالِكُها تَدمى",147,"ا",1,0],["أَوِ الحَضرُ لَم يَمنَع مِنَ المَوتِ رَبَّهُ","وَقَد كانَ ذا مالٍ طَريفٍ وَتالِدِ",148,"د",1,0],["أَوِ اِنتَجَعي سِناناً حَيثُ أَمسى","فَإِنَّ الغَيثَ مُنتَجَعٌ مَعينُ",149,"ن",1,0],["أَوِ الأَمسِ الَّذي وَلّى ذَهاباً","فَلَيسَ يَعودُ أَو لَمعِ السَرابِ",150,"ب",1,0],["أَواخِرُ مَن تَرى تَفنى","كَما فَنِيَت أَوائِلُهُ",151,"ل",2,0],["أَو أَيُّهُم لَم يُلفَ في","دارِ البِلى غَلِقَ الرُهونِ",152,"ن",1,0],["أَوالِبُ أَنتَ في العَرَبِ","كَمِثلِ الشَيصِ في الرُطَبِ",153,"ب",1,1],["أَوالِبُ ما دَهاكَ وَأَن","تَ في الأَعرابِ ذو نَسَبِ",153,"ب",1,0],["أَو إِذا قُلتُ لِلقِيامِ جُلوسٌ","عَلِمَ الناسُ ما يَكونُ الجُلوسُ",154,"س",1,0],["أَوانٍ وَساقٍ غَيرُ وانٍ وَمُطرِبٌ","وَراحٌ لَها طيبُ السُرورِ مُقارِنُ",155,"ن",1,0],["أَو أَساريعاً عَلى عَمَدٍ","أَشرَقَت في زِيِّ مُرتَقِبِ",156,"ب",1,0],["أَو أَعالي حُمرِ أَلوِيَةٍ","نُشِرَت في جَحفَلٍ لَجِبِ",156,"ب",1,0],["أَو أَصوغَ الأَشعارَ يَومَ هَناءٍ","يَشمَلُ المَلكَ أَو أُهَنّي بِعيدِ",157,"د",1,0],["أَو أَصدَأَ الإِيّامُ سَيفَ قَريحَتي","إِلّا جَعَلتُ مَديحَهُ كَصِقالِهِ",158,"ل",2,0],["أو إن أقبل الدجى بعد إدبا","ر نهارٍ صافي الضياء قضيته",159,"ه",1,0],["أو إن أبصر الشقي وميضاً","في رماد الهوى فقام إليه",159,"ه",1,0],["أو إن غاصت روحه في عباب الذ","ذكريات التي طوتها السنين",159,"ن",1,0],["أَو أَشقَرٍ كَالصبحِ يَعقِلُ رادعاً","هَيْقَ الفلاةِ وجأبها الذيّالا",160,"ل",2,0],["أو أشعلٍ كالسّيد عَرّضَ سابحاً","فحسبته بالأيطلَينِ غزالا",160,"ل",2,0],["أَو أَدهَمٍ كاللَّيلِ أَمّا لونه","فَلَكَم تَمنّى الحسنُ منه خيالا",160,"ل",2,0],["أَو أنَّ للأرْضِ الجمادِ تَنقُّلاً","حَجّتْ إلى أمْصارِكَ الأمْصارُ",161,"ر",1,0],["أَو أَدهمٍ داجي الإِهابِ كَأنّما","صَبَغَ الغرابَ بِلَونِهِ الغربيبِ",162,"ب",1,0],["أَو أَشهبٍ مثل الشهابِ ورَجمهِ","شخصَ المريدِ بِمُحرقٍ مشبوبِ",162,"ب",1,0],["أو أصفرٍ مثل البهار مغيّر","بسواد عَرْفٍ عَن سَوادِ عسيبِ",162,"ب",1,0],["أو أشعلٍ للون فيه شُعْلَةٌ","تُذْكى بريحٍ منه ذاتُ هبوبِ",162,"ب",1,0],["أَوِ الَّتي طالَما أَفضَت وُعورَتُها","مِنَ الأُمورِ إِلى مِنهاجِها الجَدَدِ",163,"د",1,0],["أَو أَدهَمٍ فيهِ كُمتَةٌ أَمَمٌ","كَأَنَّهُ قِطعَةٌ مِنَ الغَلَسِ",164,"س",1,0],["أو أرادت بوصالٍ عِوضا","فأنا كُلِّي لها بعضُ الرِشا",165,"ش",2,0],["أوِ انصببنا على غايٍ نُحاولها","عُدنا غُزاةً وإن طاشت مرامينا",166,"ن",2,0],["أَو أَقيدي فَإِنَّما النَفسُ بِالنَف","سِ قَضاءً مُفَصَّلاً في الكِتابِ",167,"ب",1,0],["أَوانِسُ يَسلُبنَ الحَليمَ فُؤادَهُ","فَيا طولَ ما شَوقٍ وَيا حُسنَ مُجتَلى",168,"ا",1,0],["أوائلُنا زلزلوا الراسياتْ","أنرقدُ نحن مع الرّاقدينْ",169,"ن",1,0],["أَوِ الوُرقَ ما بَكَت تَغريد","بَل فاضَت آماقُها عَبرَه",170,"ه",1,0],["أَوِ الَّذي سَبَقَت مِن قَبلِ مَولِدِهِ","لَهُ السَعادَةُ مِن خَلّاقِها الباري",171,"ي",1,0],["أَو أَنزَلَ اللَهُ وَحياً أَن يُعَذِّبَها","إِن لَم تَعُد لِقِتالِ الأَزدِ لَم تَعُدِ",172,"د",1,0],["أُواخِذُ خُطَّةً فيها سَواءٌ","أَبيتُ وَلَيلُ واتِرِها نَأومُ",173,"م",1,0],["أُواسيهِ عَلى الأَيّامِ إِنّي","إِذا قَعَدَت بِهِ اللُؤما أَلومُ",173,"م",1,0],["أُوارَ النارِ حَتّى هُنَّ جُونٌ","وَلَم يُخلَقنَ يَومَ خُلِقنَ جُونا",174,"ن",2,0],["أَو أَريحيني فَفي المَوتِ كُفءٌ","وَاِقتِليني مِثلَ مَن تَقتُلينا",175,"ن",2,0],["أَو أَيكَةٌ ناحَت حَمائِمُها","مَنثورُ أَخضَرَ ناعِمٍ لَدنِ",176,"ن",1,0],["أَوّاهُ يا سَيِّدي فَخُذ بِيَدي","وَلا تَدَعني وَلا تَقُل تَعَسا",177,"س",2,1],["أو أن أتَتْ سَرْحٌ إليه مُطِيعَةً","فكأَنَّما أتَتِ الرِّياضَ سُرُوحُ",178,"ح",1,0],["أوْ أنْ يحِنَّ إليه جِذْعٌ يابِسٌ","شَوْقاً وَيَشْكُو بَثَّهُ وَيَنُوحُ",178,"ح",1,0],["أو أَلْحَقُوا بهما المَسِيحَ وَسَوَّغُوا ال","تَحْرِيمَ في الحالَيْنِ والتَّحْلِيلا",179,"ل",2,0],["أو أثبَتُوا النَّسخَ الَّذي في كُتبِهم","قد نُصَّ عنْ شَعْيا وعَنْ يُوئِيلا",179,"ل",2,0],["أَو أنَّ إخْوَتَهمْ بنو العِيصِ الّذي","نُقِلَتْ بَكارَتُهُ لإِسْرائيلا",179,"ل",2,0],["أو الخمر صرفا ما يمجّ لك الطلى","أو المسكَ ما تسفي عليك القساطل",180,"ل",1,0],["أو أنّ مَلحودَ النبيِّ ورمْسَهُ","بمدارجِ الأقدامِ يُنسَفُ مَنسَفا",181,"ف",2,0],["أو أن يُصرِّفَ هذا الأمرَ خاتَمُهُ","كما يُصرِّفُ في جِدٍّ وفي لَعِبِ",182,"ب",1,0],["أَوِ انتَفَعَت عَيني بِغابِرِ نَظرَةٍ","أَوَ اثبَتُّ في كَأسٍ لِأَشرَبَها ثَغرا",183,"ر",2,0],["أَو أَشجَعٌ وَهوَ مِن سُلَيمٍ","فيما رَوَوا رُقعَةُ الخِضافِ",184,"ف",1,0],["أَوِ الغَزالَةُ في دَجنٍ يُغازِلُها","أَو ظَبيَةُ البانِ في أَجفانِها كَحَلُ",185,"ل",1,0],["أَوِ المِسكِ فَإِن المِس","كَ مِن أَشباهِهِ عِندي",186,"ي",1,0],["أَواقِدُ ذُبَّ القَومَ عَنّي بِزَجرَةٍ","وَهاتِ نَصيحاً لا يَطيبُ المُلَهوَجُ",187,"ج",1,0],["أَو أَذِقها يَومَ عَنّي","كُربَةً مِن كُرُباتي",188,"ي",1,0],["أَو أَفيقي مِن داءِ ما يَصنَعُ الحُبُّ","بِصَبٍّ فَطالَما قَد دَويتِ",189,"ت",1,0],["أَوائِلُ قَد قَرَّبتِ غَيرَ مُقَرَّبٍ","وَناسَبتِ كَلباً كانَ غَيرَ نَسيبِ",190,"ب",1,0],["أَواجِيَّ حُزنٍ لِلمُحِبِّ يَهِجنَهُ","إِذا اِجتازَ فيما يَغتَدي وَيَؤوبُ",191,"ب",1,0],["أَوانَ يَقولُ مُسلِمَةُ ابنُ قَيسٍ","وَلَيسَ لِسَيِّدِ النَوكى دَواءُ",192,"ا",2,0],["أَو أَضَعُ البَيتَ في سَوداءِ مُظلِمَةٍ","تُقَيِّدُ العيرَ لا يَسري بِها الساري",193,"ر",2,0],["أَو اِلتُمِعَت أَنوارُ عَمرٍ وَعامِرٍ","لَما حَمَلا رُمحاً وَلا شَهِدا حَربا",194,"ب",2,0],["أَو الغِربانَ مِلنَ لَها بِبَيضٍ","نَواصِعَ فَاِنثَنَينَ مُحَمَّماتِ",195,"ت",1,0],["أَواكَ ضَنٍ فَاِهرَب مِنَ الأُنسِ طالَما","تَتَبَرَّمَ مُضَناً مِن حَديثِ العَوائِدِ",196,"د",1,0],["أَو النَثرَةُ الحَصداءُ قورِبَ نَسجُها","لَها حَلَقٌ هالَ الأَسِنَّةَ عَبرُها",197,"ر",3,0],["أَو أُمُّ أَجرٍ جَرى قَتلٌ عَلى نَفَرٍ","حُرٍّ وَعَبدٍ فَجَرَّتهُم إِلى الغارِ",198,"ر",1,0],["أَوانُ قُرٍّ يُوافي بَعدَهُ وَمَدٌ","مِنَ الزَمانِ وَحَرٌّ بَعدَهُ قَرَسُ",199,"س",1,0],["أَو العادي السُلَيكُ وَصاحِباهُ","أَو الأَسَدِيُّ كَالصَعلِ الهِزَفِّ",200,"ف",1,0],["أَوالِيَ هَذا المِصرِ في زِيِّ واحِدٍ","أَواخِرَ مِن أَيّامِنا وَأَوالِ",201,"ل",1,1],["أَو أَرِدَ الماءَ بَعدَ خامِسَةٍ","في هَجَماتِ الحِلالِ وَالصِرَمِ",202,"م",1,0],["أَوانِيَ هَمٌّ فَأَلقى أَواني","وَقَد مَرَّ في الشَرخِ وَالعُنفُوانِ",203,"ن",1,1],["أو أراد السّماكُ طَعْناً لها عا","د كسِيرَ القَناةِ قبْلَ الطّعانِ",204,"ن",1,0],["أَوارِيُّ خَيلٍ قَد عَفَت وَمَنازِلٌ","أَراحَ بِها حَيُّ كِرامٌ وَأَعزَبوا",205,"ب",3,0],["أو إذا شئتَ أن يصير لك الحص","باءُ دراً فإنه ليصير",206,"ر",1,0],["أو أنة من فؤاد","ببين ليلى يراع",207,"ع",1,0],["أو اسمحوا بسكوت كي أخاطبكم","أو انصرفت كما قد جئت أدراجي",208,"ي",1,0],["أَو إذا ما أَزمعت يوماً رَحيلاً","عَن بِلادي يهمُّ قوماً زَماعي",209,"ي",1,0],["أو الحكيم بحق","أبى العلاء المعري",210,"ي",1,0],["أو أنه هو راع","وأنهن قطيع",211,"ع",1,0],["أَو إذا بدا وهن","من أخ لهم وثبوا",212,"ب",3,0],["أو أنه فرط عاشقين","ينفر من زحمة الضجيج",213,"ج",1,0],["أو أرضٌ جوفها نارُ جحيمِ","وفضاءٌ كلُّ ما فيهِ أسير",214,"ر",1,0],["أو إلهٍ مُجنَّحٍ يتراءى","في أساطيرِ شاعرٍ إغريقي",215,"ق",2,0],["أَو أَستَطيعُ تَجَلُّداً عَن ذِكرِكُم","فَيفيقُ بَعضُ صَبابَتي وَتُفَكِّري",216,"ي",1,0],["أواليَ نعت الراح من شعفٍ بها","كأنك خال للمدامة أو عم",217,"م",1,1],["أو ألهموا ما نحتوا من الحجر","أو عبدوا ما استنبتوا من الشجر",218,"ر",1,0],["أَوْ أَعْيُنُ الأَحْبَابِ حين تَرَاسَلَتْ","باللَّحْظِ تَحْتَ تَخَوُّفٍ وتوقُّعِ",219,"ع",1,0],["أو أن تُشَمِّر حَربٌ بعدَ ما لَقِحَت","حتَّى تَشُوبَ لَكُم شَيباءَ مِذكارا",220,"ر",2,0],["أَوْ أَنْ تَبِينِي عَنْ قَرَارَةِ مَنْزِلٍ","كُنْتِ الضِيَاءَ لَهُ بِكُلِّ سَوَادِ",221,"د",1,0],["أَوْ أَهْجَرُوا قَوْلاً لِكُلِّ مُهَذَّبٍ","مِنْكُمْ فَبَعْضُ المَدْحِ فِي الإِهْجَارِ",222,"ر",1,0],["أَوْ أَيْسَروا حَجُّوا بِقلْبٍ خَاشِعٍ","وَبِنَاظِرٍ فَرِحٍ ربوعَ الْهَادِي",223,"د",2,0],["أَوْ أَنَّ لِلشَّرَفِ الرَّفِيعِ يَداً","عِنْدَ القَضَاءِ لَكَان يَفْدِيكا",224,"ك",2,0],["أَوَانِسَ رَاقِصَاتٍ مُرْقِصَاتٍ","يَكَادُ الحِلْمُ يَشْهَدُهَا خَلِيعَا",225,"ع",2,0],["أَوْ أَتى الطُّورَ فِي الجَمَاهِيرِ موسى","مَا زكتْ نَارُهُ وَلا لاحَ نُورُ",226,"ر",1,0],["أَوَاصِفٌ أَنَا أَخْلاَقاً سَمَوْتَ بِهَا","أَمْ وَاصِفٌ عِلْمَكَ الفَيَّاضَ وَالأَدَبَا",227,"ب",2,1],["أَوَابِداً لَمْ يكُ لِي","مِنْهَا بِتَأْبِيدٍ وَطرْ",228,"ر",1,0],["أَوْ آتَتِ الرَّوْضَ بَوَاكِيرُهَا","أَيُحْمَلُ الوَرْدُ إِلى الوَرْدِ",229,"د",1,0],["أَواصِفُ حُييْتَ مِنْ سَابِقٍ","وَمِنْ أَرْيَحِيِّ بِهِ يُقْتَدَى",230,"د",2,0],["أَوْ أَزَاهِيرَ فِي قَوَارِيرَ مِنْ","شِبْهِ الْجِنَانِ الْمُعَلَّقَاتِ بِوَادِي",231,"د",2,0],["أَوْ أَتَى ظَافِراً فَيَا نُكْرَ شُكْرٍ","يَتَقَاضَاهُ ظَافِرُ الأَجْنَادِ",231,"د",1,0],["أَوْ أَنْ نُقِيمَ حُجَجاً دَوَامِغاً","لَهُمْ عَلَيْنَا فَنَجِيءَ إِدَّا",232,"د",2,0],["أوِ القُرَطاءِ ما إِنْ أَسْلَمُوهُ","وقِدْماً ما وَفَوْا إذْ لا تَفُونَا",233,"ن",2,0],["أو أننه رأس ملاك أشقر","يحمله صدر حنون أشقر",234,"ر",1,0],["أو أنصفت نعم وقد أبرزتها","للفتنة الكبرى مثالاً يؤثر",234,"ر",1,0],["أوّاه! سيدتي السبعونَ! معذرةً","إذا التقينا ولم يعصفْ بيَ الجَذَلُ",235,"ل",1,0],["أوّاه! سيدتي السبعونَ! معذرةً","بأيِّ شيءٍ من الأشياءِ نحتفل؟!",235,"ل",1,0],["أَو أَبي جَعفَرٍ الطَائِيَّ إِذ","يَتَمادى مُعطِياً حَتّى يُمَل",236,"ل",1,0],["أَوِ الْعَذْرَاءَ حِينَ رَأَتْ غَرِيباً","فَلَثَّمَتِ الْمَلاَحَةَ بِالْحَيَاءِ",237,"ا",2,0],["أو أبحناهُ راعنا كلَّ يوْمٍ","شُرُفاتٌ يهوين من بنيانه",238,"ن",2,0],["أوِ الْحَمَائِمُ غَنَّتْ فَوْقَ مَائِجَةٍ","حَبَا الْحَمائِمَ تَهْدَاراً بِتَهْدَارِ",239,"ر",1,0],["أواصرُ الدَّمِ والتاريخِ تَجمعُنا","وكلُّنا في رِحابِ الشرقِ إخوانُ",240,"ن",1,0],["أو أراه قَصَبَ المجدِ الذي","دونه ينفَقُ جُهْدُ السابقين",241,"ن",1,0],["أو أراه عَلَماً في فَدْفَدٍ","لمعتْ أضواؤُه للحائرين",241,"ن",1,0],["أو أراه روضةً إنْ نَفَحتْ","خَجِلَ الوردُ وأغْضَى الياسَمين",241,"ن",1,0],["أو أراه دَوْحَةً وارفةً","نَشَرَتْ أفياءَها للاجئين",241,"ن",1,0],["أو أراه قلبَ مصرٍ نابضاً","بِمُنىً تمحو من القلبِ الأنينْ",241,"ن",1,0],["أو آيةً في علمه","وذكائه المتوقد",242,"د",1,0],["أو أذنب الطلاَّب، عُدَّ","تْ في صحيفته الذنوب",243,"ب",1,0],["أوائلُكُم -أيها المسلمون-","بشرعةِ أحمدَ ساسوا الورى",244,"ر",2,0],["أو أمه عمر بن بكر ما طفت","مهجات صبيته في ذي قار",245,"ر",1,0],["أو استشعرتها النفس عاهدت الجوى","أو التمحتها العين عاقرت السهدا",246,"د",2,0],["أو أفيقي من داء ما يصنع الحبُّ","بص فطالما قد دويت",247,"ت",1,0],["أو أرى القتل قد تقاضى رجالا","لم يميلوا عن السفاهة جهلا",248,"ل",2,0],["أُوَاخِذُ خُطَّةً فِيهَا سَواءً","أَبِيتُ وَلَيْلُ دَاثِرِهَا نَؤومُ",249,"م",1,0],["أو ألحقوا بهما المسيحَ وسَوَّغوا التَّح","وبأنَّ أموالَ الطَّوائِفِ حُلِّلَتْ",250,"ل",2,0],["أو أنَّ دينَ محمدٍ لم ينصدعْ","حتى بكى قرآنَه الانجيل",251,"ل",1,0],["أو أنَّ بالنَّزْر اليسير من الدما","سيُبَلُّ من عطَش الطُغاة أُوام",252,"م",1,0],["أو أنَّ مَتعوباً ستَسْعى نحوه","عما قريبٍ راحةٌ وجِمام",252,"م",1,0],["أو أنْ يرِفَّ عليك في رَيْعانِهِ","هذا الربيعُ – كوَجهِك – البسام",252,"م",1,0],["أو أبعثُ الأملَ المريحَ اليكُمُ","أنا مثلكُمْ متصدِّعُ الآمال",253,"ل",1,0],["أو أنني حجر وربتَّمَا","قد بات أرْوَحَ منّيَ الحَجَر",254,"ر",1,0],["أواعدكم من \" غَدٍ \" صادقاً","ويُسرِفُ في الوعد من يَكذب",255,"ب",1,0],["أو المتنبّي حينَ قالَ تذمُّراً","\" أفيقا خُمارُ الهمِّ بغَّضني الخمرا\"",256,"ر",2,0],["أوَاصِرُ زَائِرٍ، وَذِمَامُ ناءٍ،","عَلَيكَ ضَمَانُهُ حَتّى يَؤوبا",257,"ب",2,0],["أوْ أنّ مَجْدَكَ لم يكُنْ مُتقادِماً،","أغْنَاكَ آخِرُ سُؤدَدٍ عَنْ أوّلِ",258,"ل",1,0],["أواكَ ضَنٍ، فاهربْ من الانسِ، طالما","تَبَرّمَ مُضنىً من حديثِ العوائد",259,"د",1,0],["أو التُمِعتْ أنوارُ عمروٍ وعامرٍ،","لما حَملا رُمحاً، ولا شهدا حربا",260,"ب",2,0],["أو أرى المجد قاعداً ليَ عن","كفِّك وعداً مثمراً إخلافا",261,"ف",2,0],["أو أعرض الرَّدمُ دون حاجته","أو لقِيَ الليثَ هائجاً كَلَبهْ",262,"ب",2,0],["أَوِ الثَّاكِلَ اعْتَاضَ السُّرُورَ مِنَ الثُّكْلِ","وَقَالَ فَتىً مَا شَاءَ رَبُّكِ أَحْكَمَا",263,"م",2,0],["أو أثار الشعور في سامعيه","مثل لحن من ذي أغاني يشدي",264,"ي",1,0],["او انحت الماس اقلاما معرضة","امدها ذهبا في الطرس ابريزا",265,"ز",2,0],["أو أن سيلاً عاصمٌ من شرها","عصمَ الديارَ من المامع مال جرى",266,"ر",2,0],["أوِ المُكْرَاعاتِ من نَخيلِ ابنِ يامِنٍ","دوينَ الصفا اللائي يلينَ المشقرا",267,"ر",2,0]]}