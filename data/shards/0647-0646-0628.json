{"poems":[[500,"عشرون من عمري تنفيتها","https://www.aldiwan.net/poem10242.html","السريع"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86361","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139659",""]],"verses":[["هن بقرط الزق شنفنني","وبالمساعي الغر شرفتها",0,"ت",3,0],["هن بعيدات عن المجرّه","وهي التي تدعى نجوم الجرّه",1,"ه",1,0],["هن به الحسن الزاكي فذاك فتى","فاق الكرام فأضحى بدر أفاق",2,"ق",1,0],["هنِّ به آل الأمين الألى","عمت أياديهم جميعَ البلاد",3,"د",1,0]]}