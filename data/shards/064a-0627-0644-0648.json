tps://www.poetsgate.com/ViewPoem.aspx?id=210327",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[5355,"لم أنسه أبدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87129&r=&rc=24",""],[6213,"لوحة حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76258&r=&rc=15",""],[463,"قد قنعنا أن نرقبَ الأحلاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60324&r=&rc=380",""],[6290,"الْعَدْلُ مَفْقُودٌ فَكَيْفَ رُقِيُّنَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85160&r=&rc=11",""],[6335,"قراءة في قسمات وجه عربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65401&r=&rc=3",""],[5190,"طَرَقات على باب الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78319&r=&rc=32",""],[6366,"ما لم يقله الرّسّام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86676&r=&rc=4",""],[6366,"لهواك أسرارٌ وصمتك ساحرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86673&r=&rc=0",""]],"verses":[["يا لَوعَةً بانَت تَباريحُها","تَقدَحُ في قَلبي شَجاً كَالشَرار",0,"ر",1,0],["يا لَوعَةَ الأَحبابِ حينَ تَساءَلوا","عَنهُ وَعادوا بِالجَوابِ الموجِعِ",1,"ع",1,0],["يا لَوعَةً حارَ النُطاسِيُّ فيكِ","كَم يَشتَكي غَيري وَكَم أُخفيكِ",2,"ك",1,1],["يا لورد قومك نالوا منك ما طلبوا","وأخطأت مصر آمال وأوطار",3,"ر",1,1],["يا لورد كم من معان في سياستكم","جرّت إلى القال بين الناس والقيل",4,"ل",1,1],["يا لِواءَ الغِناءِ في دَولَةِ الفَن","نِ إِلَيكَ اِتَّجَهتُ بِالإِكليلِ",5,"ل",1,0],["يا لوعة الدنيا وراء مودع","يمضي إلى الأخرى بألفِ نوابِ",6,"ب",1,0],["يا لُوّمي ومتى بُليت بلوّمٍ","إلّا وَهُمْ ببليّتي أغمَارُ",7,"ر",1,0],["يا لواءً عصف اللهُ بهِ","واستباح الحقُّ منه ما استباحا",8,"ح",2,0],["يا لِواءً كان للحقّ حِمىً","حين لا يرجو حِمَىً أو حَرَما",9,"م",2,0],["يا لُؤلُؤً يَتَلالا","في حُمرَةِ العِقيانِ",10,"ن",1,0],["يا لؤلؤاً يَسْبي العقولَ أَنِيقا","وَرَشاً بَتقطيعِ القُلوبِ رَفيقا",11,"ق",2,1],["يَا لَوْعَةً مَا يَزَالُ لاعجُها","يَقْدحُ نَارَ الأَسَى على كبِدِي",12,"د",2,0],["يا لواءَ الحسنِ أحزابَ الهوى","أجّجوا في الحب نيران الجفَاءْ",13,"ا",2,1],["يا لِوَاءَ الْبِلادِ أَيُّ لِوَاءٍ","لا يُفَدِّي لِوَاءَكَ الْمَعْقُودَا",14,"د",2,0],["يا لواءَ التوحيدِ في الأُفقِ، رفرِفْ","لَقِيَ الشِّرْكُ يومَه الموعُودا",15,"د",2,0],["يا لِواءَ الغناءِ في دَوْلة ِ الف","ن، إليكَ اتجهتُ بالإكليل",16,"ل",1,0],["يا لَوردٍ في خدِّه كلما رمتُ","جنَاهُ ويا للحظِّ زادَ احمرارُه",17,"ر",2,0],["يا لُواةَ الديون هل في قَضاءِ ال","حُسْنِ أن يَمْطُل الغنيُّ الفقيرا",18,"ر",2,0],["يا لوعة القلب من جمال","لم ترأه مقلتاي قبلا",19,"ل",2,0],["يا لوعة القلب لا شكوايَ نافعة","ولا بكاي بشافٍ مسّ ضرائي",20,"ي",1,0],["يا لوعتي في المساء","وفتنتي في الصباح",21,"ح",1,0],["يا لِواءَ الحُسنِ أَحزابُ الهوى","أَيقَظوا الفِتنةَ في ظلِّ اللِواءِ",22,"ا",2,1],["يا لوعةَ الحب أثرت الأسى","في كبدي المقروحة الظاميه",23,"ي",2,1],["يا لوسنان ليله","باهت النجم والقمر",24,"ر",1,0],["يا لواديك مترعاً بالاماني","ترجمان الجمال والحب شعرا",25,"ر",2,0],["يا لَوعة الوَجد إن أُحرَم بِهِ أَمَلي","عَلى فُؤاديَ لا تبقي وَلا تَذري",26,"ر",2,0],["يَا لَوْ دَرَتْ مَنْ ذَا لَهُ قيدَتْ لَمَا","عَقَدَتْ سَنابكُها علَيْها عِثيرا",27,"ر",2,0],["يا لوعتي كيف أضحى اللحد منزلهُ","وكان لا يرتضي متن السهى دارا",28,"ر",2,0],["يا لوْعَةً لِلْحَدِيدِ فازتْ","طُلَّابُ أعدائها بوِتْرِ",29,"ر",1,0],["يالُواةَ الديون إني غريمٌ","لكُمُ لو قضيتموه الغَراما",30,"م",2,0],["يا لُواةَ الدَّين عن ميسَرةٍ","والضنيناتِ وما كنَّ لئاما",31,"م",2,0],["يا لواة الدين عن ميسرةٍ","كيف للمعسر أن ينسَى حقوقَهْ",32,"ق",2,0],["يا لُواةَ الديون هل في قضايا ال","حسن أن يمطُلَ الغنيُّ الفقيرا",33,"ر",2,0],["يا لوذعيّاً لاذَ عيٌّ باسمهِ","أسواك يبرع في المقال ويبدع",34,"ع",1,0],["يا لوعتي مِن بعدِ سكّانِ الحِمى","زيدي ويا راحةِ سِرّي ودَّعي",35,"ع",2,0],["يا لوعةَ ساعِة بينهمُ","قد حَقَّ البعدُ فلا تَذَري",36,"ر",2,0],["يا لومُ ماذا لقِيتُ في هذه الدُّ","نيا مِنَ الأَقْرِباءِ والبُعدَا",37,"د",2,0],["يا لواحي ويا عواذل كفُّوا","ضاق ذَرعي مالي لديكُم ذنبُ",38,"ب",1,1],["يا لَوعَتي ما حيلتي في ذا الرَشا","أَشكوه أَم أَشكو لَدَيهِ تذللي",39,"ل",2,0],["يا لَوعة التدريس مِن أَلم النَوى","سيزور قبل الأَربعين المدفنا",40,"ن",2,0],["يا لوعة البين لا نبقي علي فما","تركت غير حشى في البعد منصدع",41,"ع",1,0],["يا لواء العز إني أعشقُ","نورك الساطع يا شكل الهلالْ",42,"ل",1,0],["يا لوْحَ دينِ الُهدَى ويا قَلما","ناسبَ لوْحَ الإله والقَلما",43,"م",2,0],["يا لَوعة قَد خلدت","ما خَلدت في خلدي",44,"د",2,0],["يا لوعة الام الحنونة إذ ترى","حنا ينوحك والدموع تسيلُ",45,"ل",1,0],["يا لوعة الأب الذي بعده","كم ذا له نوحٌ عليه مزيدْ",46,"د",1,0],["يا لوعة العم الذي فيه احتسى","كاساً مرايره تفوق العلقما",47,"م",2,0],["يا لؤلؤ عقد قد أغنى","وسحاب ربيع قد روض",48,"ض",1,0],["يا لَوفدِ السحابِ ريّانَ فيهِ","قبلَ أمطاره من السحر وابل",49,"ل",1,0],["يا لوعتي من زمنٍ مُقبلٍ","ويا سُهادَ الجفنِ ممّا اْنصرم",50,"م",1,0],["يا لوعة الدهر ما أبقيت لي سنداً","تبت يداك التي جارت على سندي",51,"د",2,0],["يا لوعتي يا عذابي ما بقيت لغي","ر الهم والغم والأحزان والسهر",52,"ر",1,0],["يا لوعتي يا عذابي بعد مريم يا","طول انتحابي وعمري صار في قصر",53,"ر",1,0],["يا لوعةً هي أحلى منْ مُنى أملٍ","الآنَ أعْرفُ شيئاً كُنتُ أنكِرُه",54,"ر",2,0],["يا لواء الأقطاب يا من لواه","تهتح فردهم ونعم اللواء",55,"ا",2,0],["يا لوعةَ القلب الذي","أنَّاتُهُ مَنَعَت هُجُوعي",56,"ع",2,0],["يا لَو شَهِدتَ إِذا رَأَيتُكِ في الكَرى","كَيفَ اِرتِجاعُ صِبايَ بَعدَ تَكَهُّلِ",57,"ل",1,0],["يا لوعتي اكتملي يا عبرتي انهملي","يا مهجتي احتملي فالصبر لي خال",58,"ل",1,0],["يا لوعتي لرُضاب دونَهُ لعسٌ","في شفّتَيك ويا نوحي ويا صدحي",59,"ح",2,0],["يا لواد تجمع الحسن فيه","كدت حبا له أعاف دياري",60,"ر",2,0],["يا لورد هل لك في الاسلام من غرضٍ","ترمي إليه بسهم منك مسنونِ",61,"ن",1,1],["يا لُؤمَ رَهطِ كُلَيبٍ في نِسائِهِم","ما قاتَلوا القَومَ إِذ تُسبى وَلا شَكَروا",62,"ر",3,0],["يَا لوُدي ويا أُهَيلِي وصحبي","إن يوم النَّفيرِ أحزن قلبي",63,"ي",1,0],["يا لوعة فعدت وقامت في الحشى","خرساء تنطق بالشجي نفثاتها",64,"ت",3,0],["يا لَوعةً طالَت وَلا اصطبارْ","في مُهجة ذابَت لفقد الدِيارْ",65,"ر",1,1],["يا لَودّي وَالَّذي أَمضى النَوى","بَينَنا رغماً عَن الحَزم الأَشدّْ",66,"د",1,1],["يا لِودي لَكَ ما أَعجبه","مِن وِداد لَم يَطُل حَتّى قَصر",67,"ر",1,0],["يا لَوعة تَملأ الصَحارى","وَطَلسما يَزحم القُبورا",68,"ر",2,0],["يا لوهمٍ كَم لَه في الن","نَفسِ أَعراقٌ تشعّب",69,"ب",1,0],["يا لوَردٍ تَشِعُّ فيهِ الثَنايا","بسناً يَسحرُ القُلوبَ وَيَسبي",70,"ب",2,0],["يا لوعة الشام في إبان سدتها","تجرعت غصصا فيها استخارات",71,"ت",1,0],["يا لوعة الشوق أسكني في مهجتي","ما فاتني مَّمن أحبّ وصول",72,"ل",1,0],["يا لوعة ما ذاقها ذو وحشة","قبلي ولا مرت بسمع اناسي",73,"س",2,0],["يالوعة الليل المحمل بالأسى","هذا قصيدي صغته موالا",74,"ل",2,0],["يا لوحةً مرسومةً بدموعِنا","نسيَتْ براعة َ فنِّنا الأجيالُ",75,"ل",1,0],["يالوعة بأوارها","حفرت شغافي عاما",76,"م",2,0],["يا لَوْعَتِي وَدَمِي يَغْلِي وَحَشْرَجَتِي","يَرْنُو لَهَا عَدَمِي حُبًّا وَ إِدْمَانا !",77,"ن",2,0],["يَا لَوَجْدِيْ واشْتِيَاقيْ","والْتِيَاعِيْ وافْتِضَاحْ",78,"ح",1,0],["يا لوحة َ التكوير ِ في حشر ِ الهوى","قامت ْ على شمس ِ الحبور ِ حبور ُ",79,"ر",1,0],["يَا لَوْعَةَ الصَّمْتِ مُحْمُومٌ بِقَافِيَتِي","يُتْلى عَلَى وَجَعِيْ يَا سِيْنُ وَالسُّوَرُ",80,"ر",1,0],["يَا لُؤْلُؤاً يُثْرِي سَمَائِي بَهْجَةً","قَدْ أَتْأَمَتْ عَيْنِي بِأَقْمَارِ الْجَلَلْ",81,"ل",1,0],["يا لَودّي مالي وللدهر يشكو","ني وأشكوه في العداء الرهيب",82,"ب",1,0],["يا لودي أنا المعنىَّ فمن لي","بسلاف الهوى وإن تك مُهلا",83,"ل",2,0],["يا لُؤلُؤاً لِلْعِلْمِ فاللهُ ارتَضا","كَ ولِيَّهُمْ وَوَليَّ حَتَّى مَنْ سَلَفْ",84,"ف",1,0],["يا لوعةَ البثِّ المغمّسِ بالضنى","من همزةِ الإرجافِ والأرجاسِ",85,"س",1,0],["يا لوحةً رسمتْ ألوانُها عبثاً","كأنّها لسرابِ البيدِ قد عرضتْ",86,"ت",1,0],["يا لُؤلُؤاً للنورِ لمْ","يظْهرْ ولم يهجُرْ مَحارَه",87,"ر",2,0],["يا لَوْعةً ما كُنتُ أَحْسبُها","أَنْ تألفَ الطَّعناتِ في الكبِدِ",88,"د",1,0],["يا لوعةَ القلبِ الحزينِ مخافةً","هجراً ينوءُ بها فلا ألقاها",89,"ا",3,0],["يا لوعة الأشواق أنت","ودمعة العين الزلال",90,"ل",1,0],["يا لوحة الطهر لم يُخلقْ لها شبهاً","فكلّ ما قيل من وصفٍ فما وصفوا",91,"ف",3,0],["يالوجدي كم أعاني","غاب عني ..مادهاه",92,"ا",2,0],["يالوجهٍ مهشمٍ في المرايا","وشُرود مخيّم في اللحاظِ",93,"ظ",1,0],["يالوِردِ الدُجى وقد دام فجرا","أين مني ..إذا ضحى ..الإمساكُ ؟!!",94,"ك",1,0],["يا لوعة المشتاق تصفق كفوفه","لين التفت ما شاف بالدّار غاليه",95,"ي",2,0],["يالودّي وكم أبحُّ لودٍّ","آلمتني صدوده إيلاما",96,"م",2,0],["يا لودي ضاع عمري وأنا","في تمني نظرة منكم إلي",97,"ي",1,0],["يا ل ودي انجزوا وعدي فقد","صار برد الصبر أبلى حلتي",97,"ي",1,0],["يا ل ودي عنكم يروي الوفا","في البرايا ليس عن هي بن بي",97,"ي",1,0],["يا ل ودي كملت أوصافكم","فحلا لي مدحكم ما عشت حي",97,"ي",1,0],["يا لوعة الروح يا أوجاع قافيتي","يا نازك الحرف في اسمى بلاغاتي",98,"ت",2,0],["يالوايلي يالتغلبي عز الاصحاب","ما ذكر فيكم ها في الاصل عايب",99,"ب",1,0],["يا لوعةَ الوجدِ قد تَقاسَمَها","قلبي وعيني، لقد سئمتُ عَنا",100,"ن",2,0],["يا لؤلؤا ودرارياً","بَصَري تعشّقَ مطلعكْ",101,"ك",1,0],["يا لوعة الإنسان في أيامه","فلديه هم قائم لم يقعد",102,"د",1,0],["يا لوحة ً فوق الجدار كمثل ضِلْع ٍ تختفِقْ","يا قُبلةً، في وُجْنة ٍ بيضاءَ عاشتْ تحترقْ",103,"ق",1,0],["يَا لَوْعَةَ الْقَلْبِ الَّذِي","قَدْ كَانَ نَهْبًا لِلَيَبَابْ",104,"ب",1,0],["يا لَوثَةَ الأمجادِ أودَى مَجدَهَا","ماءٌ تَنَكَّرَ ثمَّ جفَّ وَ غَوَّرَا",105,"ر",2,0],["يَا لَوعةً كُتِبَتْ وَالقَلبُ يَعشَقُها","مَنْ يُلهمُ الرّوحَ في تَسويفِهَا رَشدَا",106,"د",2,0],["يا لوحة تحنو علي فتنجلي عني","الهموم وتستفيق الأنجم",107,"م",1,0],["يالواة َالديون إن غريمٌ","لكمُ لو قضبتموه الغراما",108,"م",2,0],["يَالَوْعَتِي إِنَّ الْوَدَاعَ مُعَذِّبٌ","يَسْتَلُّ أَرْوَاحًا مِنَ الْأَبْدَانِ",109,"ن",1,0],["يا لوعة القمح في ألواننا.. عبَقٌ","تراثنا.. فادفني «الناسيك» والسببا",110,"ب",2,0],["يا لَوْعَةَ اْلقلْبِ اْلذي اْختَارَ اْلنَّوَىَ","وَ بِمَا تأجَّجَ مِنْ لَظَىً أنْ يُحْرَقا",111,"ق",2,0],["يا لوحة الوطن الصّوفيُّ مَنْ رَسَمَ","المعنى، وحمَّل أشجار الصّبا حجرا",112,"ر",2,0],["يا لؤلؤيَّ الصمت إنّك صاحبي","تدري بأن البحر طفل ماكر",113,"ر",1,0]]}