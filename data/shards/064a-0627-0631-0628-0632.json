{"poems":[[56,"آل الرسول مصابيح الهداية","https://www.aldiwan.net/poem27438.html","البسيط"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[71,"إن الخمول وقاني","https://www.aldiwan.net/poem29010.html","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[107,"يا رب أصبحنا نخاف العاديا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54943&r=&rc=113",""],[151,"يا رب يا رب يا رب الأنام ومن","https://www.aldiwan.net/poem47639.html","البسيط"],[164,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[164,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[358,"حمدا لك اللهم يا من قد قضى","https://www.aldiwan.net/poem40828.html","الرجز"],[509,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[534,"يا رب زدني نعما","https://www.aldiwan.net/poem37161.html","مجزوء الرجز"],[534,"وافت إلي من المقام الأشرف","https://www.aldiwan.net/poem37320.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120069","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130772","الكامل"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124093","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135283","الرجز"],[4164,"","https://poetry.dctabudhabi.ae/diwan/poem/203841","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94403","البسيط"],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[5956,"يا ربَّنا انصرها على أعدائها","https://www.poetsgate.com/ViewPoem.aspx?id=214089",""]],"verses":[["يا رَبِّ زِدني رُشداً في مَحَبَّتِهِم","وَاِشفِ فُؤادِيَ مِن أَهلِ الضَلالاتِ",0,"ت",1,0],["يا ربّ زِدْ في معاني ما تُخَوِّلُهُ","ولا تزدْ في معانيه فقد كَمُلا",1,"ل",2,0],["يا ربِّ زدني خمولاً","وزدْ عدوِّي شهرَهْ",2,"ه",1,0],["يا رُبَّ زاهيةِ الأصيلِ أحالها","أُفقاً أحمّ ولجَّةً حمراءَ",3,"ا",2,0],["يا رب زلزل خصمك المناويا","ولقه منك الجزاء الوافيا وكن لما تخشى النفوس كافيا",4,"ي",2,0],["يا ربّ زدهم بتأييد إذا زحفوا","واقطع بسيفهم ظلما وكفرانا",5,"ن",2,0],["يا رب زده على ما ترتضيه له","عونا ويسر له في الخير ما عسرا",6,"ر",2,0],["يا رب زده من الذي خولته","واحفظ بصارمه علينا ديننا",7,"ن",2,0],["يا رَبّ زادَ الغَمُّ وَالهَمّ بِنا","وَالسِجنُ أصمانا وَقَد طالَ الثوا",8,"ا",1,0],["يا رب زد شعف الفضولي في الهوى","واسدر طوايق نقصه وزواله",9,"ل",2,0],["يا رَبّ زِدْني نِعَما","واصْرِفْ عَنّي النِّقما",10,"م",2,1],["يا رَبِّ زِدْهُ فَضائِلاً وفَواضِلاً","فَهُوَ الذي بِعِبادِكَ الْبَرُّ الْحَفي",11,"ف",2,0],["يا رب زده على فلي","س على نداه من مزيدِ",12,"د",1,0],["يا رب زالت حرمة القرآن من","تلك القلوب وحرمة الايمان",13,"ن",1,0],["يا رب زدنا قوةً","ترديه في شر انهزام",14,"م",1,0],["يا رب زدهم على ما كان من شرف","ويرحم اللّه عبداً قال آمينا",15,"ن",2,0],["يا ربِّ زِدْ لي بصري","لا تنقصَنَّ عمُري",16,"ر",2,1],["يا رب زدني غراما في محبته","ودع فؤادي بالأشواق يتلفه",17,"ف",2,0],["يا ربّ زدهُ علاءً طالَما بزغت","شَمسٌ وأَبّد لهُ نصراً وتأَييدا",18,"د",2,0],["يا ربُّ زِدني بالحياةِ تبصُّراً","واسمعْ دعائي إنني لا أسأمُ",19,"م",1,0],["يارب زدنا صبر وإيمان وثبات","يامن إليك المنتهى والمبتدا",20,"د",2,0],["يا رَبِّ زوجتيَ المقدسةُ انتهتْ","أو قد تكاد تعيش مِن أدوائها",21,"ا",3,0]]}