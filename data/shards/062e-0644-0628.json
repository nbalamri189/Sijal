{"poems":[[72,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[91,"هزنا الفن في كمنجة سامي","https://www.aldiwan.net/poem44773.html","الخفيف"],[91,"جاء الربيع وورد الرمان","https://www.aldiwan.net/poem44908.html","الكامل"],[58,"خل بيني وبين حب المدام","https://www.aldiwan.net/poem58497.html","الخفيف"],[47,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[71,"خل بكرا أو عجوزا","https://www.aldiwan.net/poem28152.html","مجزوء الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[240,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[422,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138203",""],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119376","الكامل"],[1615,"","https://poetry.dctabudhabi.ae/diwan/poem/73665","المجتث"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101022","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60891","المتدارك"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123798","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200819","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52985","الرمل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45782","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139184","الرجز"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123866","الخفيف"],[4684,"يغتالنا خببا","https://www.poetsgate.com/ViewPoem.aspx?id=201573",""],[5209,"يا موقظ العزمات من سنة الكرى","https://www.poetsgate.com/ViewPoem.aspx?id=188703",""],[5370,"البنت ياحبها","https://www.poetsgate.com/ViewPoem.aspx?id=81635",""],[2110,"خطرت بأم عبيدة الريح الرخا","https://www.poetsgate.com/ViewPoem.aspx?id=156269",""],[5829,"رياضُ الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=212095",""],[5956,"لولا براك الله من خير المَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193373",""],[6134,"أفديه لا أفدي سواه جميلاً","https://www.poetsgate.com/ViewPoem.aspx?id=169522",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""]],"verses":[["خَلَبَ السامِعينَ سِحرُ كَلامي","وَسَرت في عُقولِهِم نَفَثاتي",0,"ت",2,0],["خلب الفن انفس السامعيه","ايها الفن انت سحر مباح",1,"ح",1,0],["خلب الربيع بحسنه البابنا","ان الربيع لساحر فتان",2,"ن",1,0],["خَلِّ بَيني وبينَ حُبِّ المُدامِ","واعْفِني مِنْ مَسَائِلِ ابنِ سَلاَمِ",3,"م",1,1],["خِلٌّ بَلَغتُ بِرَأيِهِ شَرَفَ العُلا","وَأَخٌ غَنيتُ بِهِ عَنِ الإِخوانِ",4,"ن",1,0],["خلِّ بِكراً أو عجوزاً","فهما آفةُ مالكْ",5,"ك",1,1],["خَلَبَتْهُ وَاسْتَفَزَّتْ رَوْعَه","فَطوَى اللَّيْلَ وَقَدْ أَضْمَرَ أَمْرَا",6,"ر",2,0],["خُلَّبُ البَرقِ باتَ يَصدِقُ مُعرو","فُكَ لِلشائِمينَ وَهوَ يَمينُ",7,"ن",1,0],["خَلَبَ القلوبَ جمالهُ وجلالُهُ","فجلالهُ وجمالهُ سيَّان",8,"ن",1,0],["خلب الجمالُ عقول بعض إنما","منك الكمال عقول أجمعنا خلب",9,"ب",1,0],["خل به قمر الأخوة ما بدا","من قبح خسف خيانةٍ متشوها",10,"ه",2,0],["خَلَبتَ قَلبي بِلَحظٍ","أَبا الحُسَينِ خَلوبِ",11,"ب",1,1],["خلب الطوى أحشاءها فتفزعت","حيرى تعاني سهدها وملالها",12,"ل",3,0],["خُلِبٌ سُلْبٌ تُرَبٌ عُرُبٌ","كثبٌ قضُبٌ شهبٌ الظُلم",13,"م",1,0],["خَلبيُ إنسٍ صيغَ من لطفٍ ولو","هرَّ بالوَهمِ تشَكّى الألَما",14,"م",2,0],["خلبت محاسنه حجاي وكدت من","حبّي له ألقي بنفسي فيه",15,"ه",1,0],["خلِّ برلينَ ولندنْ","يَصعدا أوْجَ التَّمدُنْ",16,"ن",1,1],["خَلبت لَباقتها القُلوب لَطافة","مُذ وَشحت بحلى كريم العنصر",17,"ر",1,0],["خلبت هيرا نهى زفس وفي","قربها يهجع بالطرف القرير",18,"ر",1,0],["خل بنيات الطرق","ووافق الناس تفق",19,"ق",1,1],["خلب الحب لبه وأطال ال","شوق والصبر ليلهُ ونهارَه",20,"ر",2,0],["خلْب الوداد صدودً الزِّيْف أنْشبها","ظِفْر الجَّفاءِ وكم من مهْجةٍ خَلَبَا",21,"ب",2,0],["خلبتهم منك المواعظ مثل ما","خلبت فؤاد العاشق الآرام",22,"م",1,0],["خل بيننا انقاش وعلوم وتعاليلي","وآمر على البنت وان حبّيت طالبها",23,"ب",3,0],["خلبت قلوب العاشقين فيا له","يوم بقتل العاشقين تأرخا",24,"خ",2,0],["خَلَبتُ مباهجُها قوافي شاعرٍ","فتمكنَتْ في القلبِ والوجدانِ",25,"ن",1,0],["خلبتْ صفاتك عقلَ أمتنا بما","آتاك خالقنا هدىً ومكارما",26,"م",2,0],["خلب النهى هاروت سحر كلامه","فغدا كثير الوصف فيه قليلا",27,"ل",2,0],["خلبت غروب الشأن مني غربة","في بلدة شأني بها لم ينبه",28,"ه",1,0]]}