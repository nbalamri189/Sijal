{"poems":[[70,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[89,"هزنا الفن في كمنجة سامي","https://www.aldiwan.net/poem44773.html","الخفيف"],[89,"جاء الربيع وورد الرمان","https://www.aldiwan.net/poem44908.html","الكامل"],[56,"خل بيني وبين حب المدام","https://www.aldiwan.net/poem58497.html","الخفيف"],[45,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[69,"خل بكرا أو عجوزا","https://www.aldiwan.net/poem28152.html","مجزوء الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[236,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[417,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"]],"verses":[["خَلَبَ السامِعينَ سِحرُ كَلامي","وَسَرت في عُقولِهِم نَفَثاتي",0,"ت",2,0],["خلب الفن انفس السامعيه","ايها الفن انت سحر مباح",1,"ح",1,0],["خلب الربيع بحسنه البابنا","ان الربيع لساحر فتان",2,"ن",1,0],["خَلِّ بَيني وبينَ حُبِّ المُدامِ","واعْفِني مِنْ مَسَائِلِ ابنِ سَلاَمِ",3,"م",1,1],["خِلٌّ بَلَغتُ بِرَأيِهِ شَرَفَ العُلا","وَأَخٌ غَنيتُ بِهِ عَنِ الإِخوانِ",4,"ن",1,0],["خلِّ بِكراً أو عجوزاً","فهما آفةُ مالكْ",5,"ك",1,1],["خَلَبَتْهُ وَاسْتَفَزَّتْ رَوْعَه","فَطوَى اللَّيْلَ وَقَدْ أَضْمَرَ أَمْرَا",6,"ر",2,0],["خُلَّبُ البَرقِ باتَ يَصدِقُ مُعرو","فُكَ لِلشائِمينَ وَهوَ يَمينُ",7,"ن",1,0],["خَلَبَ القلوبَ جمالهُ وجلالُهُ","فجلالهُ وجمالهُ سيَّان",8,"ن",1,0]]}