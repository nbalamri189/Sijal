{"poems":[[79,"أما والذي تبلى لديه السرائر","https://www.aldiwan.net/poem36461.html","الطويل"],[74,"رعى الله للعلياء قطب سيادة","https://www.aldiwan.net/poem18658.html","الطويل"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[47,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[47,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[47,"بالله أولي يمينا برة قسما","https://www.aldiwan.net/poem65683.html","البسيط"],[47,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[47,"تعاط الصبابة أو عانها","https://www.aldiwan.net/poem66802.html","المتقارب"],[68,"مغانم صفو العيش أسنى المغانم","https://www.aldiwan.net/poem38478.html","الطويل"],[107,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[22,"قدامة أمسى يعرك الجهل أنفه","https://www.aldiwan.net/poem22021.html","الطويل"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[22,"قدامة ُ أمسى يعركُ الجهلُ أنفهُ","https://www.poetsgate.com/ViewPoem.aspx?id=19762",""],[47,"لِمَا وَصَلَتْ أسماءُ مِنْ حَبلِنَا شكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31345",""],[47,"مَغَاني سُلَيْمَى بالعَقيقِ، وَدُورُها","https://www.poetsgate.com/ViewPoem.aspx?id=31289",""],[173,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[255,"طلبت من الكتان فصا فجاد لي ال","https://www.aldiwan.net/poem15046.html","الطويل"],[285,"أيا بين ما سلطت إلا على ظلمي","https://www.aldiwan.net/poem60729.html","الطويل"],[287,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[290,"بين الجبال وبين حوض","https://www.aldiwan.net/poem39375.html","مجزوء الكامل"],[382,"شعار المدح من كرم الطبيعه","https://www.aldiwan.net/poem59346.html","الوافر"],[382,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[412,"أبت لحظات عزمك أن تناما","https://www.aldiwan.net/poem50108.html","الوافر"],[443,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[580,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122793","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110230","المتقارب"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146326","المتقارب"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146323","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103829","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86533","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114234","الطويل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121276","الطويل"],[4836,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=205524",""],[4853,"أتحمل مني نحو ذيالك الرشا","https://www.poetsgate.com/ViewPoem.aspx?id=181770",""],[3591,"من دولة الحسن أم من دولة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=149490",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""]],"verses":[["متَى جادَ بالدّينارِ أخْضَرَ زائِفاً","ودارَتُهُ دارَتْ علَيْها الدّوائِرُ",0,"ر",1,0],["متى جئت موسى شائماً نار ذهنه","تجد خير نارٍ عندها خير موقد",1,"د",1,0],["متى جئتَ ممتاراً فناهيك من فتى","وإن جئت مرتاداً فناهيك من حَبر",2,"ر",1,0],["مَتى جِئتُموها أَو دُعيتُم لِمِثلِها","فَما هِيَ مِن بَكرِ بنِ وائِلِكُم بِكرُ",3,"ر",1,0],["مَتى جِئتُهُم مِن عُسرَةٍ رَفَعوا يَدي","إِلى اليُسرِ بِالأَيدي المِلاءِ بُحورُها",4,"ر",3,0],["مَتى جَرى الدَمعُ عَن بَينٍ تَقَدَّمَهُ ال","هِجرانُ كانَ خَليقاً أَن يَكونَ دَما",5,"م",2,0],["مَتى جِئتَهُ عَن مَوعِدٍ أَو فُجاءَةً","تَهَلَّلَ بَدرٌ وَاِستَهَلَّ غَمامُ",6,"م",1,0],["مَتى جِئتُ بائِقَةً في الهَوى","فَإِسرارُها دونَ إِعلانِها",7,"ن",3,0],["مَتى جادَ نادى مالُهُ يا لِطارِقٍ","وَإِن سارَ نادى عِرضُهُ يا لِسالِمِ",8,"م",1,0],["مَتى جاءَ كيفَ انسلَّ في غَسَقِ الدُّجَى","وماذا جَرى من كان للحصنِ حاميا",9,"ي",2,0],["مَتى جِئتُمُ إِنّا رَأَينا شُخوصَكُم","ضِئالاً فَما إِن بَينَنا مِن تَفاكُرِ",10,"ر",1,0],["متى جهلت أبا السبطين خطته","وأنت أعلم أهل الطين والوبر",11,"ر",1,0],["متى جئتمُ إنَّا رأينا شخوصكم","ضئالاًفما إنٌ بيننا من تناكر",12,"ر",1,0],["متى جئتموها أو دعيتهم لمثلها","فما هي من بكر بن وائلكم بكر",13,"ر",1,0],["متى جِئتُهُمْ، من عُسرَةٍ، دفعوا يدي","إلى اليُسرِ بالأيدي، المِلاءِ بحُورُهَا",14,"ر",3,0],["مَتى جَرَّ نَفعاً مَدحُكُم أَو كَفى أَذىً","وَكَم نَفَعَ السارينَ حَدوُ الرَكائِبِ",15,"ب",1,0],["مَتى جُزتَ النَقا وَربوعَ سَلعٍ","وَجئتَ أعزّ أرضِ اللَّه أَهلا",16,"ل",2,0],["متى جِئتُهُ يدعو عليه لسانُهُ","إذا قلتُ أين الفَصُّ قال على عَيني",17,"ي",1,0],["مَتى جِئْتَهُ وَالْمُعْتَفُونَ بِبابِهِ","شَهِدَتْ بِنُعْمى كَفِّهِ مَصْرَعَ الْعُدْمِ",18,"م",1,0],["مَتى جادَت أَنامِلُهُ بِأَرضٍ","فَلا سَغَبٌ هُناكَ وَلا أُوامُ",19,"م",1,0],["متيجة طاووس بر","فل في عقود الجوهر",20,"ر",1,0],["متى جرَّدته جردت شرّاً","كأن الموت في فيه طليعه",21,"ع",2,0],["متى جال طرفي في نواحيك راغباً","أهيم بسفحٍ ضم ديرَك محروسا",22,"س",2,0],["مَتى جِئتَ الشآم وَكانَ شَرقاً","رَكائِبُكَ الَّتي أَبَداً تراما",23,"م",2,0],["متى جئته أبغي التواصل مقبلا","غدا بالتنائي والقطيعة معرضا",24,"ض",2,0],["متى جاءَ مِنْ دمْعِه زائرٌ","تلقَّاهُ من زهْرِها محجَرُ",25,"ر",1,0],["مَتَى جِئناهُ مَضطَرّينَ فَقرا","وانضاءً لَهُ أَغنَى وَأقَنَى",26,"ن",2,0],["متى جرد التوفيق ثوب عناده","وأطلقه التحقيق من سجن عاده",27,"ه",1,0],["متى جاء أخلو به في خبائي","وأكتن خديه بين يديا",28,"ي",2,0],["متى جاوَزَ الشوقُ حدّ النزاعِ","وكان اللقاءُ عديم الدواعي",29,"ي",1,1],["متى جئتُ موماةً تفرَّدتُ واثقاً","بصُحبة عَسّالَيْن: رمحي وسيْدِها",30,"د",3,0],["متى جاء تحريم الهوى عن محمدٍ","وهل منعه في محكم الذكر ثابت",31,"ت",1,0],["متى جرت على حي سلاحاً","عن الكر استعاضت بالدبيب",32,"ب",1,0],["مَتَى جَالَ فِي أمرٍ خَفِيٍّ سَبِيلُهُ","عَلَى أهلِ عِرفَانٍ فَنَهجُهُ ظَاهِرُ",33,"ر",1,1],["متى جمعُ شملي بالحبيبِ المغاضِبِ","وكيفَ خلاصُ القلبِ من يدِ سالبِ",34,"ب",1,1],["متى جدتي سَتَهِلُّ علينا؟","لنسعدَّ في الكون مثل البشر",35,"ر",1,0],["متى جحدت نعماه أنهض جوده","شهوداً من الإحسان لا تقبل الرشا",36,"ش",2,0],["متى جرى اسم فرنسا في الشفاه ولم","أهبّ فيه هبوب النار في الحطب",37,"ب",1,0],["متى جادلوا فالله موهن كيدهم","فكم قد ظفرتم بالدليل على الخصم",38,"م",1,0]]}