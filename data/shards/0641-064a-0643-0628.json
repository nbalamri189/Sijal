{"poems":[[53,"في كبدي جمرة نكت كبدي","https://www.aldiwan.net/poem61952.html","المنسرح"],[77,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[136,"أكمام جنبت لقاء الشدة","https://www.aldiwan.net/poem54870.html","الرجز"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[234,"إليك مدت رقابها العرب","https://www.aldiwan.net/poem51240.html","المنسرح"],[264,"من مجيري من فاتن الطرف فاتك","https://www.aldiwan.net/poem35948.html","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27158","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100332","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79699","الخفيف"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32384","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202340","الخفيف"],[4702,"عاد عيدك يا وطنا","https://www.poetsgate.com/ViewPoem.aspx?id=155108",""],[5840,"فيك برحت بالعذول إباء","https://www.poetsgate.com/ViewPoem.aspx?id=181437",""],[5943,"شقوقُ قهرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=34276",""],[5976,"عِش .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=34069",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""]],"verses":[["في كبدي جمرةٌ نَكَتْ كبدي","وفي غدٍ مُنىً لبعْدِ غدِ",0,"د",1,1],["في كَبِدٍ من كَمَدٍ لَوعةٌ","أبقَى تباريحاً من العِشق",1,"ق",1,0],["في كِبرَ إن كنت أو في جِدَّةِ","أنتِ التى سُمِّيتِ باسِم جَدَّتِى",2,"ت",2,0],["في كَبِد الأرض منه مُنْخَسِفٌ","وفي فُؤادِ السُّهالهُ وَجَلُ",3,"ل",1,0],["في كِبِد المسجِد الحرام لها","شوقٌ وللبيت نحوها طربُ",4,"ب",1,0],["فيك بعنا نفوسنا واسترحنا","من بلاها فجد لنا بالتفاتك",5,"ك",1,0],["في كَبِدي نارُ جَوىً مُحرِقَةٌ","في خَلَدي بَدرُ دُجىً قَد غَرَبا",6,"ب",2,0],["في كبش كل كتيبة","شاكي السلاح مدرَّع",7,"ع",1,0],["فيك بعض العزاء يا زهرة ال","قبر فحني للوعة العشاق",8,"ق",1,0],["فَيُكبَتَ أَعداءُ وَيَجذَلَ آلِفٌ","لَهُ كَبِدٌ مِن لَوعَةِ الحُزنِ يُلعَجُ",9,"ج",1,0],["فيك برحت للعذول إباء","وعصيت اللوام والنصحاء",10,"ا",2,1],["فيك بيت الله وبيت المصطفى وفيك الأمن","وْفيك حكامٍ على نهج النبي ترقى سنود",11,"د",1,0],["فيك برحت بالعذول إباء","وعصيت اللوام والنصحاء",12,"ا",2,1],["فيكبر حزنه للناس كرهًا","وعند الثأرِ يرسله سهاما",13,"م",2,0],["في كبريائك مع تعابير لونك","يذوب ذاك الحي ويْديه تفرش ..",14,"ش",1,0],["فيكِ بحرٌ من علومٍ","كانَ يجري كالغمامِ",15,"م",1,0]]}