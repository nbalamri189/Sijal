{"poems":[[77,"يا رب كل كتيبة شهباء","https://www.aldiwan.net/poem69108.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55187","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[137,"يا من يجدي لمن يجدي","https://www.aldiwan.net/poem4242.html","مخلع البسيط"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[376,"ليست من الغير التي تتغير","https://www.aldiwan.net/poem57429.html","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59502","البسيط"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127794","الخفيف"],[5277,"المقصورة النبوية","https://www.poetsgate.com/ViewPoem.aspx?id=187883",""],[5452,"ضفاف الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=110945",""],[402,"كيف اعتذارك والسفارة أولى","https://www.poetsgate.com/ViewPoem.aspx?id=36165",""]],"verses":[["إنا اجتمعنا في النديّ عصابةً","تثني عليكَ بألسن النعماء",0,"ا",2,0],["إِنّا اجْتَمَعْنَا فِي وِدَاعِكَ أُسْرَةً","تَقْضِي حْقُوقَ عَمِيدَهَا تَبْجِيلاَ",1,"ل",2,0],["أَنا أُجيبُ من اِستَفَتى بِنادِرَةٍ","وَخاطِري بَينَ إِنجادٍ وَإِتهامِ",2,"م",1,0],["أنا أجدي الأنامَ طُرَّاً","وأنت تبغي النوالَ عندي",3,"ي",1,0],["أنا أجتر أمنياتي إذا لم","يخلق الحب أمنيات جديده",4,"ه",1,0],["أنا أجتدي منهم بأن لا أجتدي","وأكفُّ شُكري عنهم كي يَشكروا",5,"ر",3,0],["أنا أجَلُّ ملوك الأرضِ مرتبةً","نعم وأكثرُ أملاكِ الورى هِمما",6,"م",2,0],["أنا أجرى من الكلابِ ولكن","خيرُ يومٍ أن لا يراني الكلابُ",7,"ب",1,0],["أنا أجتدي الوصلَ من أحمدٍ","ومنهُ الوصالُ هوىً يُجتَدى",8,"د",2,0],["أنا أجمل العشاق قدس هدبك","جعل القصائد سجدا وقياما",9,"م",2,0],["إنا اجتمعنا في وداعك أسرة","تقضي حقوق عميدا تبجيلا",10,"ل",2,0]]}