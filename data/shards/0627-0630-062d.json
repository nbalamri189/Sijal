{"poems":[[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[88,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[51,"بينما أنت في احتيال فياشك","https://www.aldiwan.net/poem65818.html","الخفيف"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[39,"لولا فوارس مذحج ابنة مذحج","https://www.aldiwan.net/poem53776.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/3032","البسيط"],[45,"أَصُدُودٌ غَلاَ بِهَا أَمْ دَلاَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32056",""],[39,"لولاَ فوارسُ مذحجِ ابنة ِ مذحجٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7474&r=&rc=14",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[143,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[174,"قسم الأترج فينا","https://www.aldiwan.net/poem4384.html","عموديه"],[343,"هاك قلبي واعطني قلبا","https://www.aldiwan.net/poem55380.html","مجزوء الرمل"],[378,"هنئت يا بيت لحم","https://www.aldiwan.net/poem59147.html","المجتث"],[378,"ربي بنى كالوحيد القرن مسكنه","https://www.aldiwan.net/poem59373.html","البسيط"],[394,"أحمد الله لبشرى","https://www.aldiwan.net/poem53375.html","مجزوء الرمل"],[417,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"],[417,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[562,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["إذ حكت أرضك السماء نجوماً","ما حياتٍ أنوارهنّ الجدوبا",0,"ب",2,0],["إذ حلّ فيها غراب كان يُوحِشُني","وكان تَنعا به بالبين يؤذيني",1,"ن",2,0],["إذ حداكَ الشقاءُ نحوي فأقْبل","تَ وما ذاك من رَباطة جاشِكْ",2,"ك",1,0],["إذ حيُّها حَيُّ السُّرورِ وظِلُّها","رَحْبُ الجِنابِ بِهمْ عَزيزُ الجانِبِ",3,"ب",1,0],["إِذ حالَقَت جَزَعاً رَبيعَةَ كُلَّها","فَتَفَرَّقَت مُضَرٌ وَمَن يَتَمَضَّرُ",4,"ر",1,0],["إذ حُبسوا مراقباً عليهم","حتى أَتَوا بكلِّ ما لديهمُ",5,"م",1,0],["إذ حَلَّ عنكض عَزيزُ الفَقدِ مُجتَنباً","للِهاجراتِ نَقِيَّ الصَّدرِ نَحَّارا",6,"ر",2,0],["إِذ حَثَّ بي عَلَقٌ عالٍ وَحَشرَجَ في","صَدري وَدارَت لِكَربِ المَوتِ مُقلَتِيَه",7,"ت",3,0],["إِذ حَوَاشِي الزَّمَانِ خُضْرٌ رِقَاقٌ","وقَنَاةُ الأَيامِ فِيهَا اعْتِدَالُ",8,"ل",1,0],["إذْ حالفَتْ جزعاً ربيعة َ كلَّها،","فَتَفَرَّقَتْ مُضَرٌ ومَنْ يَتَمَضَّرُ",9,"ر",1,0],["اذ حكت ارضك السماء نجوما","دَ استحالت كذُورة وشحوبا",10,"ب",2,0],["إذ حطَّه الحَيْنُ من صمَّاء شاهقةٍ","لايلحَق الموتُ فيها مهجةَ الوَعِلِ",11,"ل",1,0],["إِذ حَبَا فَرداً بَفَردٍ","وَحَبَانِي بأثنَثَينِ",12,"ن",1,0],["إذ حقرنا الأرض والأر","ض عذاب وشقاء",13,"ا",2,0],["إذ حل فيك إلهٌ","نراه طفلاً صبيا",14,"ي",2,0],["إذ حلَّ في مريم العذراء مرتضياً","بطُهرها فهي عرشُ اللَه مذ جلسا",15,"س",2,0],["اِذ حَباني اللَهُ سَبطاً","هو سبطٌ لِلنَبِيِّ",16,"ي",1,0],["إذ حان حَينُ أبي الثناء وجاءه","بين الأكارم يومُه الموعود",17,"د",1,0],["إذ حلَلْنا نادياً حلَّ به","لم نحلّ إلاَّ بغاب الأسدِ الورد",18,"د",1,0],["إِذ حَسِبَ الرَحمنَ عَنهُ مُضرِبا","كَهانَةً وَقَد رَأى مُرَيِّبا",19,"ب",2,0],["إِذ حَميَ الزِيُّ وَجَدَّ الزِيُّ","مِنها وَمِنهُ وَأَبى أَبِيُّ",20,"ي",1,0]]}