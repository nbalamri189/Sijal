"الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56081","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136179","الرمل"],[1464,"","https://poetry.dctabudhabi.ae/diwan/poem/146699","الكامل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124025","الكامل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21662","المديد"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104814","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126232","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132306","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94253","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112668","الرجز"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138743",""],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56430","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48305","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66372","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109996","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94931","البسيط"],[4929,"لصوص في منعطف التأريخ","https://www.poetsgate.com/ViewPoem.aspx?id=199532",""],[5183,"سَيْفُ الْلّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186452",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6229,"مرآةُ عصرنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65213&r=&rc=36",""]],"verses":[["إذ حكت أرضك السماء نجوماً","ما حياتٍ أنوارهنّ الجدوبا",0,"ب",2,0],["إذ حلّ فيها غراب كان يُوحِشُني","وكان تَنعا به بالبين يؤذيني",1,"ن",2,0],["إذ حداكَ الشقاءُ نحوي فأقْبل","تَ وما ذاك من رَباطة جاشِكْ",2,"ك",1,0],["إذ حيُّها حَيُّ السُّرورِ وظِلُّها","رَحْبُ الجِنابِ بِهمْ عَزيزُ الجانِبِ",3,"ب",1,0],["إِذ حالَقَت جَزَعاً رَبيعَةَ كُلَّها","فَتَفَرَّقَت مُضَرٌ وَمَن يَتَمَضَّرُ",4,"ر",1,0],["إذ حُبسوا مراقباً عليهم","حتى أَتَوا بكلِّ ما لديهمُ",5,"م",1,0],["إذ حَلَّ عنكض عَزيزُ الفَقدِ مُجتَنباً","للِهاجراتِ نَقِيَّ الصَّدرِ نَحَّارا",6,"ر",2,0],["إِذ حَثَّ بي عَلَقٌ عالٍ وَحَشرَجَ في","صَدري وَدارَت لِكَربِ المَوتِ مُقلَتِيَه",7,"ت",3,0],["إِذ حَوَاشِي الزَّمَانِ خُضْرٌ رِقَاقٌ","وقَنَاةُ الأَيامِ فِيهَا اعْتِدَالُ",8,"ل",1,0],["إذْ حالفَتْ جزعاً ربيعة َ كلَّها،","فَتَفَرَّقَتْ مُضَرٌ ومَنْ يَتَمَضَّرُ",9,"ر",1,0],["اذ حكت ارضك السماء نجوما","دَ استحالت كذُورة وشحوبا",10,"ب",2,0],["إذ حطَّه الحَيْنُ من صمَّاء شاهقةٍ","لايلحَق الموتُ فيها مهجةَ الوَعِلِ",11,"ل",1,0],["إِذ حَبَا فَرداً بَفَردٍ","وَحَبَانِي بأثنَثَينِ",12,"ن",1,0],["إذ حقرنا الأرض والأر","ض عذاب وشقاء",13,"ا",2,0],["إذ حل فيك إلهٌ","نراه طفلاً صبيا",14,"ي",2,0],["إذ حلَّ في مريم العذراء مرتضياً","بطُهرها فهي عرشُ اللَه مذ جلسا",15,"س",2,0],["اِذ حَباني اللَهُ سَبطاً","هو سبطٌ لِلنَبِيِّ",16,"ي",1,0],["إذ حان حَينُ أبي الثناء وجاءه","بين الأكارم يومُه الموعود",17,"د",1,0],["إذ حلَلْنا نادياً حلَّ به","لم نحلّ إلاَّ بغاب الأسدِ الورد",18,"د",1,0],["إِذ حَسِبَ الرَحمنَ عَنهُ مُضرِبا","كَهانَةً وَقَد رَأى مُرَيِّبا",19,"ب",2,0],["إِذ حَميَ الزِيُّ وَجَدَّ الزِيُّ","مِنها وَمِنهُ وَأَبى أَبِيُّ",20,"ي",1,0],["إِذ حُسنهُ مِن حُسنِهِ عارِية","لَو لَم يُعره كانَ جرماً مُظلِما",21,"م",2,0],["إِذ حَباها وكساها ال","لهُ برداً من جمالِ",22,"ل",1,0],["إذْ حِلُّهُ مُخَصَّصٌ بِمَنْ حَضَرْ","مُحْتَمَلٌ أَوْ بَلْ يَعُمُّ الْمُنْتَظَرْ",23,"ر",1,0],["إِذْ حَسِبُوا مِنْ سَفَه الأَحْلامِ","الأَسْدَ أَدْنَى مِنْ ذَوِي الأَرْحامِ",24,"م",1,0],["إِذْ حُبُّ أَرْوَى يَشْعَف المُؤَنَّقا","مَيَّالَةٌ تَرْتَجُّ إِرْعادَ النَقَا",25,"ق",2,0],["إذ حزن بطرس كم تراه قد كسى","سكانه الذللا ثوباً ادهما",26,"م",2,0],["إذ حبانا بوجد ال","مصطفى الهادي محمد",27,"د",1,0],["إذ حاجتي ذات المداري والهوى","أقصاه والفلك المدار مدار",28,"ر",1,0],["إذ حل ساحتها الأمين بجنده","وحجا الأمين على الحصون مزلزلا",29,"ل",2,0],["إِذ حَرىً شِعبُ المَشاشِ لَنا","وَمَصيفٌ تَلعَةُ الرَخَمَةُ",30,"م",2,0],["إِذ حَبانا وَخَصَّنا","بِهُدَاهُ وَبالرَّشَاد",31,"د",1,0],["إذ حزت أوصاف الكمال جميعها","ولأجل ذا دانت لك الثقلان",32,"ن",1,0],["اذ حوت سيد السموات والأر","ض ومختار خالق سواها",33,"ا",3,0],["إذ حَجَى الاذكياءِ فى تلك ضَلَّت","خَلفَ أستارها ذكاها تَخَلَّت",34,"ت",1,0],["إذ حُسنُها فاقَ للهيفِ الخَرائِدِ بَل","عَن وَصفِهِ عَجَزَ التلعابَةُ الذرِب",35,"ب",1,0],["إذ حواشيه سيدات تهادت","وسواها كحاملات الغواشي",36,"ش",2,0],["إذ حل قصر الظُلم والعِدوانِ","وقَد دَعا الناسَ إلى الإتيانِ",37,"ن",1,0],["إذ حبكم في الذكر مفروض وفي","ما جاء من متواتر الأخبار",38,"ر",1,0],["إذ حَثَا التُربَ على هَيْلا","نَ في الحُفْرةِ حاثِ",39,"ث",1,0],["إذْ حيثُ حلّ الناصرُ المَلك الرِّضَى","نلقَى المكارِمَ والعُلى والجاها",40,"ا",3,0],["إذ حوتنا حديقة قد تحلّت","بحليِّ الأزهار فهي عروس",41,"س",1,0],["اذ حدَّتِ اليونانُ حدّاً صادقاً","أَنَّ التذكُّرَ بالمنونِ تَفَلسُفُ",42,"ف",1,0],["إذ حصروه في حريم الدار","مستسلماً من غير ما أنصار",43,"ر",1,0],["إذ حُمُوا وَاحمَرَّ الوَطِيسُ وَوَلَّت","عَن رَسُولٍ كَتِيبَةٌ خَضرَاءُ",44,"ا",2,0],["إِذ حَيثُ سارَ اثنانِ بَعضُهما بَدا","لا شَكَّ أَدرَك لِلمَرامِ وأَرشَدا",45,"ا",1,0],["إذ حَيَّر الخلقَ خوفو في بنايته","وسرُّها عن بني الإنسان مكتوم",46,"م",1,0],["إذ حكاها طي كشح وحشا","إنما يدري وما يدري الرشا",47,"ش",2,0],["إذ حدا الرعد يسوق المزنا","مثقلات كالظعين المدلج",48,"ج",1,0],["إذ حجَّبوهُ لدى التاريخ في بُردٍ","في جنَّةِ النور نال الفخر جدعونُ",49,"ن",1,0],["إذ حرَّمَ الظلم على نفسِهِ","هيهات في العباد ان يقبله",50,"ل",2,0],["إذ حطم الشرك والدنيا مؤيِّدةُُ","لحزبه وهو في هبات مستعر",51,"ر",1,0],["إذ حمدنا للحمد أيضاً يفتقر","بما به أثنيت سيدي على",52,"ل",2,0],["إذ حملتَ الميثاقَ فينا ضماناً","كيف يرضى في عهدكَ الناسُ ضَيْما",53,"م",2,0]]}