{"poems":[[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[88,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[51,"بينما أنت في احتيال فياشك","https://www.aldiwan.net/poem65818.html","الخفيف"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[39,"لولا فوارس مذحج ابنة مذحج","https://www.aldiwan.net/poem53776.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/3032","البسيط"],[45,"أَصُدُودٌ غَلاَ بِهَا أَمْ دَلاَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32056",""],[39,"لولاَ فوارسُ مذحجِ ابنة ِ مذحجٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7474&r=&rc=14",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""]],"verses":[["إذ حكت أرضك السماء نجوماً","ما حياتٍ أنوارهنّ الجدوبا",0,"ب",2,0],["إذ حلّ فيها غراب كان يُوحِشُني","وكان تَنعا به بالبين يؤذيني",1,"ي",1,0],["إذ حداكَ الشقاءُ نحوي فأقْبل","تَ وما ذاك من رَباطة جاشِكْ",2,"ك",1,0],["إذ حيُّها حَيُّ السُّرورِ وظِلُّها","رَحْبُ الجِنابِ بِهمْ عَزيزُ الجانِبِ",3,"ب",1,0],["إِذ حالَقَت جَزَعاً رَبيعَةَ كُلَّها","فَتَفَرَّقَت مُضَرٌ وَمَن يَتَمَضَّرُ",4,"ر",1,0],["إذ حُبسوا مراقباً عليهم","حتى أَتَوا بكلِّ ما لديهمُ",5,"م",1,0],["إذ حَلَّ عنكض عَزيزُ الفَقدِ مُجتَنباً","للِهاجراتِ نَقِيَّ الصَّدرِ نَحَّارا",6,"ر",2,0],["إِذ حَثَّ بي عَلَقٌ عالٍ وَحَشرَجَ في","صَدري وَدارَت لِكَربِ المَوتِ مُقلَتِيَه",7,"ت",3,0],["إِذ حَوَاشِي الزَّمَانِ خُضْرٌ رِقَاقٌ","وقَنَاةُ الأَيامِ فِيهَا اعْتِدَالُ",8,"ل",1,0],["إذْ حالفَتْ جزعاً ربيعة َ كلَّها،","فَتَفَرَّقَتْ مُضَرٌ ومَنْ يَتَمَضَّرُ",9,"ر",1,0],["اذ حكت ارضك السماء نجوما","دَ استحالت كذُورة وشحوبا",10,"ب",2,0]]}