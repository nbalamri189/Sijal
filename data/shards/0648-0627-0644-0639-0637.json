{"poems":[[53,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[63,"نحن للأيام غنم ونفل","https://www.aldiwan.net/poem51477.html","الرمل"],[132,"أيها العاقل الذي شاء تزو","https://www.aldiwan.net/poem50678.html","الخفيف"],[189,"لا تكل لذة إلى التسويف","https://www.aldiwan.net/poem14716.html","الخفيف"],[201,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[376,"ما تسر الأيام إلا لتحزن","https://www.aldiwan.net/poem57045.html","الخفيف"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[563,"كن عارفا بنعمة الله وكن","https://www.aldiwan.net/poem34564.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83273","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66749","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62647","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95571","الخفيف"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20580","الرمل"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109280","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53029","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47210","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2284,"","https://poetry.dctabudhabi.ae/diwan/poem/143060","الكامل"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60892","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134050","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4702,"حب الزبيب","https://www.poetsgate.com/ViewPoem.aspx?id=155198",""],[4767,"بحر المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=210316",""],[4862,"اهلا وسهلا شاعر العرب","https://www.poetsgate.com/ViewPoem.aspx?id=147188",""],[5111,"حَسْنَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=212126",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5324,"بين شك ويقين","https://www.poetsgate.com/ViewPoem.aspx?id=207178",""],[5376,"سكنت فؤادي في الضلوع وأودعت","https://www.poetsgate.com/ViewPoem.aspx?id=197588",""],[5457,"من أنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=213314",""],[5602,"ضمي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=204943",""],[5725,"عيناك يابغداد تسكنني","https://www.poetsgate.com/ViewPoem.aspx?id=181642",""],[5743,"كلهم يحدثني عنك","https://www.poetsgate.com/ViewPoem.aspx?id=202315",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""],[5848,"أخت القمر","https://www.poetsgate.com/ViewPoem.aspx?id=53377",""],[5906,"هدية عيد","https://www.poetsgate.com/ViewPoem.aspx?id=188518",""],[5937,"صلاةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211799",""],[5943,"إحساسُ الأمة في سقمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=45273",""],[5956,"أطفالي","https://www.poetsgate.com/ViewPoem.aspx?id=194840",""]],"verses":[["والعطايا مجدِّداتٌ لكفي","كَ فجدّدْ لغرسِ كفَّيكَ حالا",0,"ل",2,0],["والعطايا ما لم تُكرَّر مِراراً","بين قيلٍ من الأعادي وقالِ",1,"ل",1,0],["والعَطايا الغُرُّ تَنْهَلُّ على","آملي جُودِكُمُ أو تَستَهِلّ",2,"ل",1,0],["والعَطايا الجِسام من غير مَنٍّ","كي تلينَ القلوبُ بالإعطاءِ",3,"ا",2,0],["والعطايا من فيض كفَّيْه قد عَمْ","مَتْ جميع الأنامِ بالمعروف",4,"ف",1,0],["والعطفَ والميلَ البريءَ ولا","غرابةَ فالمُعلّمُ والدٌ متفانِ",5,"ن",1,0],["والعَطايا المحسَّناتُ بأثوا","بِ السَّجايا يَسَلنَ أينَ المحسِّن",6,"ن",1,0],["والعطورُ التي حباها ربيعٌ","أنكرتها الحياةُ والأكفان",7,"ن",1,0],["والعطر لا ينشقه عطاره","والغير يدريه لبعد وجده",8,"د",2,0],["وَالعَطفُ إِن حَلَّ الفُؤادُ","غَدَت تُؤَكِّدُهُ النَواظِرُ",9,"ر",1,0],["والعِطرُ والرّيحانُ أنواعُهُ","تَسطعُ إن هبَّتْ به زَعْزَعُ",10,"ع",1,0],["والعطف للمخفوص كالمنص","وبِ يجري في قَرَنْ",11,"ن",1,0],["والعطف كالنعت الذي قد فصلا","إن لم تكن كررت لا وقس ألا",12,"ل",2,0],["والعطايا تثير فى المرء روحا","من نبوغ بعزمها المسنونِ",13,"ن",1,0],["وَالعَطياتُ خِساسٌ بَينَهُم","وَسَواءٌ قَبرُ مُثرٍ وَمُقِل",14,"ل",1,0],["والعطايا أو البلايا حظوظٌ","وهي في القَسْم في وجوب وسلب",15,"ب",1,0],["والعطف والجود والإيثار شيمتهم","والكل عمّا سوى الاخلاص مبتعد",16,"د",1,0],["والعَطْف منه على الرعية دونه","عطف الأب الحاني على الأبناء",17,"ا",2,0],["والعطفَ من شيخ الوفا البشيرِ","والْجَمْعَ في اليقظة بالبشير",18,"ر",1,0],["والعَطفُ عندَهُمُ كعَطفِ الفَردِ مِن","نَوعٍ عَلَيهِ وَذَاكَ فِي القُرآنِ",19,"ن",1,0],["والعطرُ فاح الجيدُ من ريحانهِ","ممّا تخبّئ للهوى الأعناق",20,"ق",1,0],["والعطف تفصيل مع اقتراب","أو رد سامع الى الصواب",21,"ب",1,0],["والعطايا على العطايا فَمنَها","تبر مصرِ وعبقري البُرود",22,"د",1,0],["والعطف قد لاحت البشرى بعودته","فاقبل سلام وداد جئت اهديه",23,"ه",1,0],["وَالعَطفُ إن لَم تَتَكَرَّر لاَ احكُمَا","لَه بِمَا لِلنَعتِ ذِى الفَصلِ انتَمَى",24,"م",2,0],["وَالعَطفُ إن يُمكِن بِلاَ ضَعفٍ أحَق","وَالنَّصبُ مُختَارٌ لَدَى ضَعفِ النَّسَق",24,"ق",1,0],["والعطفة اللي خلف نار وبواريد","والفارس المغوار فوق الاصيله",25,"ل",2,0],["والعطرُ إن مرَّتْ يلوذُ ببعضهِ","خجلانَ يترك دَكَّةَ العطار",26,"ر",1,0],["والعطر رشرش في الدروب أريجه","فرحاً فصافح ظله وتظللا",27,"ل",2,0],["وَالْعْطْفُ شَرَّبَنَا مِنْ نَبْعِهِ غَدَقًا","فَنَاءَ لَيْلِيْ وَأفْجَارِيْ ثُثَمِّنُنِيْ",28,"ن",2,0],["والعطايا لجامد والتحايا","لخمول والخير للمتعامي",29,"م",2,0],["والعطر يسبقها إلينا لو أتت","فقبيل أن تأتي إلينا نعلمُ",30,"م",1,0],["والعطف فيض في ربيع فؤادها","حنوٌ كشلال من الاغداق",31,"ق",1,0],["والعطرُ في زهر الربيعِ نواتُهُ","عَرقي الذي ألقيتُهُ وهوْ اغتنم",32,"م",1,0],["والعطر في أنفاسكِ الحرى سرى","في الكون ينشرُ في الأنام عطورا",33,"ر",2,0],["والعطر يمشي قبل مشيتها","والثغر ماادراك مالثغر",34,"ر",1,0],["والعطر يأبى كلما رمته","من غير أنفاسك أن يعبقا",35,"ق",2,0],["والعطايا من يدين الخلق للطالب قليله","والوهايب من يد الله للعباد اجل وأرها",36,"ر",3,0],["والعطر مدري ليه ساق المعاذير","خجلان منها يوم مر ف نحرها",37,"ر",3,0],["وَ العِطْرُ أَجْمَلُهُ الَّذي إذْ مَرَّ بي","ريحٌ تَعاصَفَ مِن رَحيقِ شَذاكِ",38,"ك",1,0],["والعطرُ في الجذع الرقيق مُرَنّحٌ","وعلى الغصون من الخضاب حزامُ",39,"م",1,0],["والعطسةُ نسمعُها شجبا","بمداهنةٍ تدعمُ عباسْ",40,"س",1,0],["والعطف في الآباءِ أقوى قوة","تحمي بنيهم إذْ تهبُّ خطوبُ",41,"ب",1,0]]}