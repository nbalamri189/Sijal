{"poems":[[139,"للعلم في عصر الضياء شروق","https://www.aldiwan.net/poem49040.html","الكامل"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124027","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95501","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108499","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[4869,"بشار الاسد وحمزه كاشغري وباقي الفئران ...","https://www.poetsgate.com/ViewPoem.aspx?id=151705",""]],"verses":[["ثم ازدهت بعبارة عربية","قد صاغها علمَ الكمال شفيقُ",0,"ق",1,0],["ثم ازجروا واقهروا","بالسمر والمرهفات",1,"ت",1,0],["ثم أزكى الصلاة مني إليه","ولاصحابه نجوم الدآدي",2,"د",2,0],["ثم أزجى الزمان عيداً كبيراً","فتلاقَت مرَاسمُ التعظيمِ",3,"م",1,0],["ثم ازدروا ورد النحور وشبهوا","كلماته بكواكب الجوزاء",4,"ا",2,0],["ثُمَّ أَزالَ المُلكَ بُختَنَصَّرُ","عَنهُم فَقامَ بَعدَهُم وَقَصَّروا",5,"ر",3,0],["ثُمَّ أَزالَ الظُلمَةَ الضِياءُ","وَعاوَدَت جِدَّتَها الأَشياءُ",5,"ا",2,0],["ثم ازرعوآ تفكير يخزي نظآمه","وخلوآ اليدين اتصير كلتيهن إيسآر",6,"ر",1,0]]}