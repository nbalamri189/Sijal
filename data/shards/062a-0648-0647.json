.poetsgate.com/ViewPoem.aspx?id=12684",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5751,"كل ما فيها يُغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=215018",""],[5779,"توهم واشينا بليل مزارنا","https://www.poetsgate.com/ViewPoem.aspx?id=189112",""],[5843,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=51282",""],[5843,"طارق بن زياد","https://www.poetsgate.com/ViewPoem.aspx?id=51296",""],[5939,"منذ التقى يوليو ببرد يناير","https://www.poetsgate.com/ViewPoem.aspx?id=179997",""],[5966,"بردة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=158309",""],[6085,"كامل الزين","https://www.poetsgate.com/ViewPoem.aspx?id=8676",""],[6152,"شوقي إليك ألم","https://www.poetsgate.com/ViewPoem.aspx?id=203689",""],[520,"فتوح لها في كل يوم مسرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577510",""],[520,"فما استنشقت ريح الصباح خياشم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577633",""],[6262,"أحلامُ نورِ الدين الصغيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80126&r=&rc=24",""],[6279,"العابث الهاذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78844&r=&rc=60",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["تَوَهَّمتُ عَصفَ الريحِ بَينَ فُروجِهِ","يُسِرُّ إِلى سَمعي مَقالاً يُصِمُّهُ",0,"م",2,0],["تَوَهَّمتُ بِالخَيفِ رَسماً مُحيلا","لِعَزَّةَ تَعرِفُ مِنهُ الطَلولا",1,"ل",2,1],["تَوَهَّمتُها يَوماً فَقُلتُ لِصاحِبي","وَلَيسَ بِها إِلّا الظِباءُ الخَواضِعُ",2,"ع",1,0],["تَوَهَّمَتكَ كِلابٌ غَيرَ قاصِدِها","وَقَد تَكَنَّفَكَ الأَعداءُ وَالشُغُلُ",3,"ل",1,0],["توهَّمْت قد سوَّفتَ بالغوث راجياً","لغوثك لا بل طالباً يتضرَّعُ",4,"ع",1,1],["توهَّمُهُم وقد مالت","لسكرالنوم أعناق",5,"ق",1,0],["توهَّم زَحْفَ موسى نحو حُسْنٍ","على مَنْقوصتيه لكي ينيكا",6,"ك",2,0],["توهَّمْ مصابيحَ السماءِ سبائكاً","وصُغْ مثله من صفو تلك السبائك",7,"ك",1,0],["تَوَهَّمتُهُ مِن سُرعَةِ السَيرِ راكِداً","وَأَنَّ الدُنى فيمَن عَلى ظَهرِها تَعدو",8,"د",2,0],["تَوَهَّمتُهُ هَمّاً فَقُلتُ لَهُ اِنجَلي","فَإِنَّ هُمومي ضاقَ عَن وِسعِها صَدري",9,"ر",2,0],["تَوَهَّمَ التُركُ لَمّا حانَ حينُهُمُ","أَنَّ الأُلى وَتَروا آبائُهُم غَفَلوا",10,"ل",3,0],["تَوَهَّمتَهُ يَبقى إِذا أَنتَ صُنتَهُ","عَنِ الشَفَةِ الحَمراءَ وَالمُقلَةِ الكُحلا",11,"ل",2,0],["تَوَهَّمَ قَومٌ أَنَّما الشَرقُ واهِمٌ","وَأَنَّكَ يا دُستورُ أَضغاثَ حالِمِ",12,"م",1,0],["توهموا العز في ذل يراد بهم","وشبهت لهم النعماء تشبيها",13,"ي",3,0],["تَوَهَّمَها الأَعرابُ سَورَةَ مُترَفٍ","تُذَكِّرُهُ البَيداءُ ظِلَّ السُرادِقِ",14,"ق",1,0],["تَوَهَّمَ القَومُ أَنَّ العَجزَ قَرَّبَنا","وَفي التَقَرُّبِ ما يَدعو إِلى التِهَمِ",15,"م",1,0],["تَوَهَّمَ أَنِّيَ لا أَستَطي","عُ مَساءَةَ أَغثَرَ بادي الهَوَج",16,"ج",1,0],["توهي صَفاةَ الخَطبِ وَهوَ مُلَملَمٌ","وَيَهُدُّ رُكنَ الخَصمِ وَهوَ يَلَندَدُ",17,"د",1,0],["تَوَهَّمتُها أَلوي بِأَجفانِها الكَرى","كَرى النَومِ أَو مالَت بِأَعطافِها الخَمرُ",18,"ر",1,0],["تَوَهَّمَ لَيلى وَأَظعانَها","ظِباءَ الصَريمِ وَغِزلانَها",19,"ن",3,1],["تَوَهَّمتُ قَوماً قَد خَلَوا فَكَأَنَّهُم","بِاجمَعِهِم كانوا خَيالاً تَخَيَّلا",20,"ل",2,0],["تَوَهُّمَهُ الشَمسَ قَد أَشرَقَت","فَقامَ عَلى سوقِهِ وَاِنتَصَب",21,"ب",1,0],["تَوَهَّمَها الساقونَ نوراً مُجَسَّماً","فَظَلَّت بِها بَعدَ اليَقينِ تُشَكِّكُ",22,"ك",1,0],["توهجت شمسُ ذاك اليومِ واضطرمت","كأنها شُعَلٌ في الأفقِ حمراءُ",23,"ا",2,0],["توهان في غمم الدجى قلق","بحنينه بالحب بالأشواق",24,"ق",1,0],["تَوَهّمْتُها حُلْماً بها فذكرتها","وقد يذكر الإِنسانُ ما يَتَوَهّمُ",25,"م",1,0],["تَوَهُّمُ آجِلِ الطَمَعِ المُفيتي","تَيَقُّنُ عاجِلِ اليَأسِ المَنيلِ",26,"ل",1,0],["تَوَهَّنُ مِنهُ المَضرَحِيَّةُ بعدَما","مَضَت فيهِ أُذنا بَلقَعِيُّ وَعامِلِ",27,"ل",1,0],["تَوَهَّمتُ فيها مَلعَباً وَمَسارِحاً","وَنُؤياً كَمُلقى الطَوقِ ثَلَّمُهُ القَطرُ",28,"ر",1,0],["تَوَهَّمَ طَرْفِي أَنَّ تَجْزِيعَ بُسْطِها","رُقُومٌ وَتَلْوِينَ الرُّخامِ حَريرُ",29,"ر",1,0],["تَوَهَّمَهُ قَلبي فَأَصنَحَ خَدُّهُ","وَفيهِ مَكانَ الوَهمِ مِن نَظَري أُثرُ",30,"ر",1,1],["تَوَهَّمتُ آياتٍ لَها فَعَرَفتُها","لِسِتَّةِ أَعوامٍ وَذا العامُ سابِعُ",31,"ع",1,0],["تَوَهَّمنَ الظُنونَ فَكُنَّ ناراً","لِما أُشعِرنَهُ مُتَوَهِّماتِ",32,"ت",1,0],["تَوَهَّمَ بَعضُ الناسِ أَمراً فَأَصَّلوا","يَقينَ أُمورٍ باتَ يَتبَعُها الوَهمُ",33,"م",1,0],["تَوَهَّمتُ خَيراً في الزَمانِ وَأَهلِهِ","وَكانَ خَيالاً لا يَصِحُّ التَوَهُّمُ",34,"م",1,1],["تَوَهَّمتَ يا مَغرورُ أَنَّكَ دَيِّنٌ","عَلَيَّ يَمينُ اللَهِ ما لَكَ دينُ",35,"ن",1,1],["تَوَهَّمَ كلَّ سابِغَةٍ غَديراً","فَرَنّقَ يَشْرَبُ الحَلَقَ الدُّخالا",36,"ل",2,0],["تَوَهَّنُ فِيهِ المَضرَحِيَّةُ بَعدَما","نَهَلنَ نَجِيعاً كَالمَجاسِدِ أَحمَرا",37,"ر",2,0],["توَهِّج السحب البيضاء حمرتهُ","فتستحيل عليها ذات ألوان",38,"ن",1,0],["تَوَهَّمُ أنّ ضَوْءَ الفَجْرِ دانٍ","فلم تَقْدَحْ بظِنَّتِها زِنادا",39,"د",2,0],["توهم الخلد به الأوائل","وظن أن نال البقاء الزائل",40,"ل",1,0],["توهم الحياة بعد موت","وتزعم الوجدان بعد فوت",40,"ت",1,0],["تَوَهَّمَ فيه الرُّعنُ حِصْناً فزُرْتَهُ","بأَرعنَ فيه مُرعِدُ المَوْتِ مبرِقُ",41,"ق",1,0],["توهنُ الدين وتدني","كَ من الحوب الكبيرِ",42,"ر",1,0],["توهّمتها حلوة كالحيا","ة فكانت أمرّ من المصرع",43,"ع",1,0],["توهمت أن أهل البغي تمنعُها","وقلما حَمَتِ الشهدَ اليعاسيبُ",44,"ب",1,0],["توهمت الرسومَ بها كخال","وشام في المعاصم أو وشام",45,"م",1,0],["تَوَهَّمَ الحَزمَ مَولوداً فَصَحَّ لَهُ","مُذ قارَعَ التُركَ أَنَّ الحَزمَ مُكتَسَبُ",46,"ب",1,0],["تَوَهَّمَها قَلبي فَزادَ نُزوعُهُ","وَكَيفَ يُداوي أَو يَخِفُّ وَلوعُهُ",47,"ه",1,0],["تُوهِمُ مَنْ جَاءَ شَرْعَ مِلَّتهَا","بالُقُرْبِ وَصْلاً فَأَوْعَدَ الوَهْيَا",48,"ي",2,0],["توهمته لما رأيت احمراره","بوجنتها جرحا به الخد قد دمي",49,"م",2,0],["تَوَهَّمَهُ وَلَم يَلفِظ بِحَرفٍ","فَما أَبدى لَدَيهِ وَلا أَعادا",50,"د",2,0],["تَوَهَّمَ إِبلادَ المَنازِلِ عَن حُقُبِ","فَراجَعَ شَوقاً ثُمَّتَ اِرتَدَّ في نَصَبِ",51,"ب",1,1],["تَوَهَّمتُها مِن بَعدِ ما قَد خَلا لَها","أَهِلَّةُ حَولٍ بَعدَ حَولٍ مُجَرَّمِ",52,"م",1,0],["توهج شعرى قد توهّج رائعا","كأن الثريا في حفافيه تنزل",53,"ل",1,0],["توهجت الحمّى وثار شرارها","وفي أضلع المحموم من نارها وقد",54,"د",1,0],["توهم عمرو ان صمصامه عصا","وقصر وصفاً في