لرمل"],[459,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[459,"يشرق النادي إذا حل به","https://www.aldiwan.net/poem16150.html","الرمل"],[462,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[462,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[462,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[462,"عق دمعي من بعد أهل العقيق","https://www.aldiwan.net/poem3605.html","عموديه"],[466,"قد غاب وجه البدر في","https://www.aldiwan.net/poem59832.html","مجزوء الكامل"],[466,"القضب نشوى والزهر مخمور","https://www.aldiwan.net/poem60078.html","المنسرح"],[477,"هذا الابى التونسي","https://www.aldiwan.net/poem36965.html","مجزوء الكامل"],[477,"بعث الحبيب بصورة","https://www.aldiwan.net/poem36967.html","مجزوء الكامل"],[477,"طلعت فينا هلالا","https://www.aldiwan.net/poem37051.html","المجتث"],[477,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[477,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[477,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[477,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[498,"في كل عصر من علي واحد","https://www.aldiwan.net/poem37549.html","الكامل"],[498,"خبط الظلام ولألأ الفجر","https://www.aldiwan.net/poem37558.html","أحذ الكامل"],[498,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[498,"قمنا لنساوت النبي مثالا","https://www.aldiwan.net/poem37629.html","الكامل"],[504,"خليفة الله دم للدين تحرسه","https://www.aldiwan.net/poem2454.html","البسيط"],[513,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[513,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[513,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[513,"فاعلم وأنت بما أريد مقاله","https://www.aldiwan.net/poem12268.html","الكامل"],[527,"يا من له في المعالي أرفع السند","https://www.aldiwan.net/poem37463.html","البسيط"],[536,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[536,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[549,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[549,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[556,"إنا فهمنا عنه أمثالا لنا","https://www.aldiwan.net/poem34234.html","الكامل"],[556,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[569,"بارك فيك الله من غلام","https://www.aldiwan.net/poem2056.html","الرجز"],[585,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"],[585,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"],[585,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["فَاللَهُ يَعلَمُ أَنَّ نورَكَ لَم يَزَل","مُستَهزِئاً بِالظُلمِ وَالإِظلامِ",0,"م",1,0],["فَاللَيالي عَونٌ عَلَيكَ مَعَ البَي","نِ كَما ساعَدَ الذَوابِلَ طولُ",1,"ل",1,0],["فَاللَحظُ مُحتَبِسٌ وَمُنطَلِقٌ","وَالقَولُ مُنقَطِعٌ وَمُتَّصِلُ",2,"ل",1,0],["فَاللَهُ يُعشي عَنهُ ناظِرَ الغِيَر","ما طَلَعَ النَجمُ وَأَورَقَ الشَجَر",3,"ر",1,0],["فَاللَهُ يَشكُرُ وَالنَبيُّ مُحَمَّدٌ","وَقَفاتِ مُبدٍ في النِضالِ مُعيدِ",4,"د",1,0],["فاللَهَ أَسأَلُ عُمراً كُلَّما بَلَغَتْ","مَدى القُروحِ سِنوهُ فُرَّ لي جَذَعا",5,"ع",2,0],["فَاللهُ يُخْدِمُكَ الْكَوَاكِبَ عِزَّةً","لَكَ سَعْدُهَا وَالْيُمْنُ مِنْ تَبْعَاتِهَا",6,"ت",3,0],["فَاللهُ يَجْزِي أَمَيِرَ الْمُسْلِمِينَ أبِي","خَيْرَ الْجَزَاءِ فَكَمْ حَقٍّ لَهُ وَجَبَا",7,"ب",2,0],["فَاللَهُ يَشهَدُ وَالخَلائِقُ أَنَّنا","طُلّابُ حَقٍّ في الحَياةِ صِراحِ",8,"ح",1,0],["فَاللَفظُ فيهِ مُقَوَّمٌ بِصَحيفَةٍ","وَالسَطرُ فيهِ مُقَوَّمٌ بِكِتابِ",9,"ب",1,0],["فَاللَهُ يُبقي لِلخَليفَةِ صُنعَهُ","وَيَقي لَنا قَدَمَيهِ مِن أَن تُدحَضا",10,"ض",2,0],["فَاللَهُ يَخرقُ في بَقائِكَ عادَةَ الد","نيا وَيُعطيكَ البَقاءَ الأَطوَلا",11,"ل",2,0],["فالله يَجزي بَينَنا أَعمالَنا","وَضَميرَ أَنفُسِنا وَيُوَفي مَن جَزى",12,"ا",1,0],["فَاللَّحْنُ سِرٌّ بِهَا دَفِينٌ","وَهْيَ عَلَى سِرِّهَا حَوَانِ",13,"ن",1,0],["فَاللهُ أَكْرَمُ إَنْ يَعْجِلْ بِثَوْبَتِهِ","وَاللهُ أَرْحَمُ لِلْعَبْدِ الَّذِي رَحِمَا",14,"م",2,0],["فالله يقبل من دعا","لعلاك من أهل السلوكْ",15,"ك",1,0],["فالله يمتع لابسي","بالبشر والإيناسِ",16,"س",1,0],["فالله يحفظ مهديها على شَحَطِ","فعاودَ القلبُ من غَصبَهْ",17,"ب",2,0],["فَاللُؤمُ حَلَّ عَلى الحَماسِ فَما لَهُم","كَهلٌ يَسودُ وَلا فَتىً بُهلولُ",18,"ل",1,0],["فَاللُؤمُ فيكَ وَفي سَمراءَ ما بَقِيَت","وَفي سُمَيَّةَ حَتّى يَنفَدَ الأَبَدُ",19,"د",1,0],["فاللَّهُ يُبقيه ألفَ عامٍ","وما رأى في البقاء بُقْيا",20,"ا",1,0],["فألٌ لعمرك لم أَعِفْه ولم أَعِفْ","منه البريح ولا النَّطيحَ الأعضبا",21,"ب",2,0],["فالله يجزيه في دنيا وآخرةٍ","ذِكراً إذا ما أُميت الذكر لم يَمُتِ",22,"ت",1,0],["فالليل منذ خَلَفْتَهُ","ليلٌ قصيرٌ مستنيرُ",23,"ر",1,0],["فالله يفديه من كأس المنون به","فوجهه آثَرُ الوجهين بالكاس",24,"س",1,0],["فالله الله في أحدوثة حسُنت","لا تهدموها بظلم إنها الشرف",25,"ف",1,0],["فالليل عَونٌ والنها","رُ له على الأمر المرومِ",26,"م",1,0],["فاللَّهُ يُبْقي الإمامَ حتى","يُرى لمثلَيْهما اقتران",27,"ن",1,0],["فاللَّه يعلمُ والبريَّةُ بعدَهُ","وكَفى بعلْم الواحد الأزلِيِّ",28,"ل",2,0],["فَاللَهُ لَم يَرضَ عَن آلِ الزُبَيرِ وَلا","عَن قَيسِ عَيلانَ طالَما خَرَبوا",29,"ب",3,0],["فَاللَيلَةُ العَسراءُ مِن عُمري","وَعُمرُ الدَهرِ مِثلَ اللَيلَةِ السَمحاءِ",30,"ا",2,0],["فَاللَونُ مِن خَدَّيهِ وَالطَعمُ مِن","ريقَتِهِ وَالطيبُ مِن نَكهَتِه",31,"ت",2,0],["فَاللِواءُ الَّذي تَلَقَّوا رَفيعٌ","وَالأُمورُ الَّتي تَوَلَّوا عِظامُ",32,"م",1,0],["فَاللَيلُ حينَ قَدِمتَ فيها أَبيَضٌ","وَالصُبحُ مُنذُ رَحَلتَ عَنها أَسوَدُ",33,"د",1,0],["فالله في كتمانه إن فزتا","فالملك لا يعدل ما قد حزتا",34,"ت",2,0],["فاللّهُ شاكر ما رفدت بهِ","دينَ الهدى والرُسْلُ والكُتُبُ",35,"ب",1,0],["فَاللَهُ جارُ أَبي عَلِيٍّ إِنَّهُ","أُنسُ الصَديقِ وَغَيظُ صَدرِ الكاشِحِ",36,"ح",1,0],["فَاللَهُ يَكلَأُ عَبدَ اللَهِ إِنَّ لَهُ","مَكارِماً مَن يُخَوَّل بَعضَها يَسُدِ",37,"د",1,0],["فَاللَهُ يُبقيهِ لَنا وَيَحوطُهُ","وَيُعِزُّهُ وَيَزيدُ في تَأييدِهِ",38,"د",2,0],["فَاللَهُ يَحفَظُ عَبدَ اللَهِ إِنَّ لَهُ","فَضلَ السَماحِ وَزَندَ السُؤدَدِ الواري",39,"ي",1,0],["فَاللَهُ يَجزي الحُسنى أَبا حَسَنٍ","فَهوَ لِثِقلِ الحُقوقِ حَمّالُ",40,"ل",1,0],["فَاللَهُ مِن كَثَبٍ حَسيبُكَ ظالِماً","وَحَسيبُ زَوجَةِ صاحِبِ الديوانِ",41,"ن",1,0],["فَاللَهُ أَكبَرُ قَد أُقيدَ بِجُرمِهِ","بِشرٌ وَثارَ بِنائِلٍ جُعلانُ",42,"ن",1,0],["فَاللُؤمُ يَمنَعُ مِنكُمُ أَن تَحتَبوا","وَالعِزُّ يَمنَعُ حُبوَتي لا تُحلَلُ",43,"ل",1,0],["فَاللَهُ يَجزيهِم عَمّا أَتَوا وَحَبَوا","بِهِ الرَسولَ وَما مِن صالِحٍ كَسَبوا",44,"ب",3,0],["فَاللَهُ حَسبُكَ لا سِواهُ وَمَن","راعى الرُعاةَ وَحافَظَ الحَفَظَه",45,"ظ",2,0],["فَاللَهُ يَكلَأُ عُذّالي وَيُلهِمُهُم","عَذلي فَقَد فَرَّجوا كَربي بِذِكرِهِمِ",46,"م",1,0],["فَاللَهِ يُبقيهِ وَيُبقيكُم لَهُ","حَتّى تَرى الأَولادَ مِن أَولادِه",47,"ه",1,0],["فَاللَهُ يَحرُسُ مارِدينَ فَإِنَّها","بَلَدٌ يَلَذُّ بِها الغَريبُ وَيَنعَمُ",48,"م",1,0],["فَاللَهُ قَد ضَرَبَ الأَقَلَّ لِنورِهِ","مَثَلاً مِنَ المِشكاةِ وَالنِبراسِ",49,"س",1,0],["فاللهُ يدفعُ شرَّهُمْ","حتى أدومَ على يمينْ",50,"ن",1,0],["فاللهُ يجعلُ مَوْتي","قبلَ اكتسابي بشعري",51,"ي",1,0],["فاللهُ لا يجعلُهُ آخرَ ال","عهدِ لنا من وجهكَ الناضرِ",52,"ر",1,0],["فاللَّهُ يَجْمَعُ شَمْلَكُمْ ساداتِنا","جَمْعَ السلامَةِ في نعيمٍ سَرْمَدِ",53,"د",1,0],["فاللَّهُ عَلَّمَ كلَّ عِلمٍ آدَماً","وأطاعَ آدَمُ ناسِياً إبلِيسا",54,"س",2,0],["فاللَّهُ مُنتَقِمٌ بِهِم مِن كُلِّ مَنْ","يَبْغِي عَلَى الحَقِّ المُبينِ عُدُولا",55,"ل",2,0],["فاللهُ حَسْبُكَ يا مُحَمَّدُ صَاحِباً","ومُؤازِراً في رِحْلَةٍِ وَمُقامِ",56,"م",1,0],["فَاللَهُ يُعطيكَ الشَبَر","وَفي أَعاديكَ الظَفَر",57,"ر",1,0],["فَاللَهُ يَرعاكَ يا مَن","مَعَ الرِياحِ يَميلُ",58,"ل",1,0],["فَاللَهُ يُبقيهِ وَيُب","قيها لَنا حِقَبَ السِنينِ",59,"ن",1,0],["فَاللُبُّ إِن صَحَّ أَعطى النَفسَ فَترَتَها","حَتّى تَموتَ وَسَمّى جِدَّها لَعِبا",60,"ب",2,0],["فَاللَهُ فَردٌ قادِرٌ مِن قَبلِ أَن","تُدعى لِآدَمَ صورَةٌ أَو تُحسَبا",61,"ب",2,0],["فَاللَهُ ما اِختارَ البَقاءَ وَطولَهُ","إِلّا لِشَرِّ عِبادِهِ إِبليسا",62,"س",2,0],["فاللّهُ يَرْحَمُ مَن مضَى مُتَفَضِّلاً","ويقيك من جَزل الخطوب وشَختِها",63,"ت",3,0],["فاللّوْمُ لؤمٌ ولم يُمْدَحْ بِهِ أحَدٌ","وهل رأيتَ مُحِبّاً بالغرام هُجي",64,"ج",2,0],["فَالْلَّحْظُ عَضْبٌ صَارِمٌ وَالْهُدْبُ نَبْ","لٌ صَائِبٌ وَالْقَدُّ رُمْحٌ أَسْمَرُ",65,"ر",1,0],["فَاللَّحْظُ يَشْرَبُ وَالنَّدَى","مَشْمُولَةٌ وَالكِمُّ كُوبُ",66,"ب",1,0],["فاللّه يقيكَ السّوءَ لنا","وبرحمتِهِ يتَغَمَّدهُ",67,"د",2,0],["فَاللَهُ أَسأَلُ أَن تُعَمَّرَ صالِحاً","وَدَوامُ عُمرِكَ شَيرُ شَيءٍ يُصأَلُ",68,"ل",1,0],["فاللَّيْلُ مَوْصُولٌ بيَوْمٍ حافلٍ","واليومُ مَعقُودٌ بليْل سُهَأدِ",69,"د",1,0],["فالله يجْرزي أميرَ المسلمينَ أبي","خيْر الجزاء فكَمْ حقٍّ لهُ وَجَبا",70,"ب",2,0],["فَالله أسْألُ أنْ تُعَمِّرَ صَالِحاً،","وَدَوَامُ عُمْرِكَ خَيْرُ شيءٍ يُسألُ",71,"ل",1,0],["فاللَّهُ لمْ يرْضَ عَنْ آلِ الزُّبَيرِ، ولا","عَنْ قيسِ عَيلاَنَ، حيّاً طال ما خَرَبوا",72,"ب",3,0],["فاللَه كافله والنصر صاحبه","والخير تابعه والسعد خادمه",73,"م",2,0],["فاللهُ يوصَفُ بالحكيمِ مهابةً","ومحبَّةً ندعوهُ بالحنَّانِ",74,"ن",1,0],["فاللّه يعلم أنني في حبها","بسوى الشباب وبرده لم أكتس",75,"س",1,0],["فاللّهُ يَرْعَى مَنْ يواصِلُ حبَّه","ورَعَى الذي يَرْعَى الهوَى وَرَعَاكِ",76,"ك",1,0],["فالله ربّي في بقيةِ عُمرنا","فلم يبقَ مِنه صاح غيرُ زَهيدِ",77,"د",1,0],["فاللّهَ أسألُه بأن يُنْجيك من","هذي الشدائد غَدْوَتي ومسائي",78,"ا",2,0],["فاللّهَ فيما قد بَقِى","مِ العُمْرِ فهْو لنا نَمَاءُ",79,"ا",2,0],["فالله طهرنا مما يُعَوِّقُنَا","فلا انتقاد ولا بغض ولا حسد",80,"د",1,0],["فالله أشهدني منه الخصوص على","ما كان من عجرٍ مني على بَجَرِ",81,"ر",1,0],["فاللَّطِيمُ المَضِيمُ أنتَ فَإني","لَستُ في الشَّأوِ والحَطيمِ لَطِيمَا",82,"م",2,0],["فَاللهُ أبقَاهُ مِن أوفي لَنَا خَلَفاً","وقَد رَضِينَاهُ مِن أوفي لَنَا خَلَفَا",83,"ف",2,0],["فاللهُ يَنصُرُهُم ويَجمَعُ شَملَهُم","وَيزِيدُ في البَرَكَاتِ والأعمَارِ",84,"ر",1,0],["فألِل العباد منك بعدلٍ","وتوخّ الس