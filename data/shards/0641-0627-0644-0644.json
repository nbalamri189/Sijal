3.html","الكامل"],[403,"عدة الصابرين إن ناب خطب","https://www.aldiwan.net/poem34120.html","الخفيف"],[405,"لا تنكرن إهداءنا لك منطقا","https://www.aldiwan.net/poem49478.html","الكامل"],[406,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[416,"بشرى بمولد نجلكم من مولد","https://www.aldiwan.net/poem53858.html","الكامل"],[416,"ذا مسجد سر أرباب السجود به","https://www.aldiwan.net/poem53874.html","البسيط"],[416,"قل مثلما قد قال عبد الباقي","https://www.aldiwan.net/poem53980.html","الكامل"],[416,"عاد المتيم في غرامك داؤه","https://www.aldiwan.net/poem54182.html","الكامل"],[432,"عهدي بحيك وهو حي عامر","https://www.aldiwan.net/poem12398.html","الكامل"],[437,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[437,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[437,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[439,"أي شراع لأي بحر","https://www.aldiwan.net/poem34854.html","مخلع البسيط"],[439,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[439,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[439,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[441,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[443,"عوذت بالله إمام العصر","https://www.aldiwan.net/poem56033.html","عموديه"],[449,"حققت مأرب مأربٍ في سدها","https://www.aldiwan.net/poem971.html",""],[452,"يا أيها النشوان من سنة الكرى","https://www.aldiwan.net/poem13809.html","الكامل"],[458,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[458,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[458,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[461,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[461,"عضد الدين مشار ال","https://www.aldiwan.net/poem15407.html","مجزوء الرمل"],[461,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[461,"يشرق النادي إذا حل به","https://www.aldiwan.net/poem16150.html","الرمل"],[464,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[464,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[464,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[464,"عق دمعي من بعد أهل العقيق","https://www.aldiwan.net/poem3605.html","عموديه"],[468,"قد غاب وجه البدر في","https://www.aldiwan.net/poem59832.html","مجزوء الكامل"],[468,"القضب نشوى والزهر مخمور","https://www.aldiwan.net/poem60078.html","المنسرح"],[479,"هذا الابى التونسي","https://www.aldiwan.net/poem36965.html","مجزوء الكامل"],[479,"بعث الحبيب بصورة","https://www.aldiwan.net/poem36967.html","مجزوء الكامل"],[479,"طلعت فينا هلالا","https://www.aldiwan.net/poem37051.html","المجتث"],[479,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[479,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[479,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[479,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[500,"في كل عصر من علي واحد","https://www.aldiwan.net/poem37549.html","الكامل"],[500,"خبط الظلام ولألأ الفجر","https://www.aldiwan.net/poem37558.html","أحذ الكامل"],[500,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[500,"قمنا لنساوت النبي مثالا","https://www.aldiwan.net/poem37629.html","الكامل"],[506,"خليفة الله دم للدين تحرسه","https://www.aldiwan.net/poem2454.html","البسيط"],[515,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[515,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[515,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[515,"فاعلم وأنت بما أريد مقاله","https://www.aldiwan.net/poem12268.html","الكامل"],[529,"يا من له في المعالي أرفع السند","https://www.aldiwan.net/poem37463.html","البسيط"],[538,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[538,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[551,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[551,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[558,"إنا فهمنا عنه أمثالا لنا","https://www.aldiwan.net/poem34234.html","الكامل"],[558,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"بارك فيك الله من غلام","https://www.aldiwan.net/poem2056.html","الرجز"],[587,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"],[587,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"],[587,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["فَاللَهُ يَعلَمُ أَنَّ نورَكَ لَم يَزَل","مُستَهزِئاً بِالظُلمِ وَالإِظلامِ",0,"م",1,0],["فَاللَيالي عَونٌ عَلَيكَ مَعَ البَي","نِ كَما ساعَدَ الذَوابِلَ طولُ",1,"ل",1,0],["فَاللَحظُ مُحتَبِسٌ وَمُنطَلِقٌ","وَالقَولُ مُنقَطِعٌ وَمُتَّصِلُ",2,"ل",1,0],["فَاللَهُ يُعشي عَنهُ ناظِرَ الغِيَر","ما طَلَعَ النَجمُ وَأَورَقَ الشَجَر",3,"ر",1,0],["فَاللَهُ يَشكُرُ وَالنَبيُّ مُحَمَّدٌ","وَقَفاتِ مُبدٍ في النِضالِ مُعيدِ",4,"د",1,0],["فاللَهَ أَسأَلُ عُمراً كُلَّما بَلَغَتْ","مَدى القُروحِ سِنوهُ فُرَّ لي جَذَعا",5,"ع",2,0],["فَاللهُ يُخْدِمُكَ الْكَوَاكِبَ عِزَّةً","لَكَ سَعْدُهَا وَالْيُمْنُ مِنْ تَبْعَاتِهَا",6,"ت",3,0],["فَاللهُ يَجْزِي أَمَيِرَ الْمُسْلِمِينَ أبِي","خَيْرَ الْجَزَاءِ فَكَمْ حَقٍّ لَهُ وَجَبَا",7,"ب",2,0],["فَاللَهُ يَشهَدُ وَالخَلائِقُ أَنَّنا","طُلّابُ حَقٍّ في الحَياةِ صِراحِ",8,"ح",1,0],["فَاللَفظُ فيهِ مُقَوَّمٌ بِصَحيفَةٍ","وَالسَطرُ فيهِ مُقَوَّمٌ بِكِتابِ",9,"ب",1,0],["فَاللَهُ يُبقي لِلخَليفَةِ صُنعَهُ","وَيَقي لَنا قَدَمَيهِ مِن أَن تُدحَضا",10,"ض",2,0],["فَاللَهُ يَخرقُ في بَقائِكَ عادَةَ الد","نيا وَيُعطيكَ البَقاءَ الأَطوَلا",11,"ل",2,0],["فالله يَجزي بَينَنا أَعمالَنا","وَضَميرَ أَنفُسِنا وَيُوَفي مَن جَزى",12,"ا",1,0],["فَاللَّحْنُ سِرٌّ بِهَا دَفِينٌ","وَهْيَ عَلَى سِرِّهَا حَوَانِ",13,"ن",1,0],["فَاللهُ أَكْرَمُ إَنْ يَعْجِلْ بِثَوْبَتِهِ","وَاللهُ أَرْحَمُ لِلْعَبْدِ الَّذِي رَحِمَا",14,"م",2,0],["فالله يقبل من دعا","لعلاك من أهل السلوكْ",15,"ك",1,0],["فالله يمتع لابسي","بالبشر والإيناسِ",16,"س",1,0],["فالله يحفظ مهديها على شَحَطِ","فعاودَ القلبُ من غَصبَهْ",17,"ب",2,0],["فَاللُؤمُ حَلَّ عَلى الحَماسِ فَما لَهُم","كَهلٌ يَسودُ وَلا فَتىً بُهلولُ",18,"ل",1,0],["فَاللُؤمُ فيكَ وَفي سَمراءَ ما بَقِيَت","وَفي سُمَيَّةَ حَتّى يَنفَدَ الأَبَدُ",19,"د",1,0],["فاللَّهُ يُبقيه ألفَ عامٍ","وما رأى في البقاء بُقْيا",20,"ا",1,0],["فألٌ لعمرك لم أَعِفْه ولم أَعِفْ","منه البريح ولا النَّطيحَ الأعضبا",21,"ب",2,0],["فالله يجزيه في دنيا وآخرةٍ","ذِكراً إذا ما أُميت الذكر لم يَمُتِ",22,"ت",1,0],["فالليل منذ خَلَفْتَهُ","ليلٌ قصيرٌ مستنيرُ",23,"ر",1,0],["فالله يفديه من كأس المنون به","فوجهه آثَرُ الوجهين بالكاس",24,"س",1,0],["فالله الله في أحدوثة حسُنت","لا تهدموها بظلم إنها الشرف",25,"ف",1,0],["فالليل عَونٌ والنها","رُ له على الأمر المرومِ",26,"م",1,0],["فاللَّهُ يُبْقي الإمامَ حتى","يُرى لمثلَيْهما اقتران",27,"ن",1,0],["فاللَّه يعلمُ والبريَّةُ بعدَهُ","وكَفى بعلْم الواحد الأزلِيِّ",28,"ل",2,0],["فَاللَهُ لَم يَرضَ عَن آلِ الزُبَيرِ وَلا","عَن قَيسِ عَيلانَ طالَما خَرَبوا",29,"ب",3,0],["فَاللَيلَةُ العَسراءُ مِن عُمري","وَعُمرُ الدَهرِ مِثلَ اللَيلَةِ السَمحاءِ",30,"ا",2,0],["فَاللَونُ مِن خَدَّيهِ وَالطَعمُ مِن","ريقَتِهِ وَالطيبُ مِن نَكهَتِه",31,"ت",2,0],["فَاللِواءُ الَّذي تَلَقَّوا رَفيعٌ","وَالأُمورُ الَّتي تَوَلَّوا عِظامُ",32,"م",1,0],["فَاللَيلُ حينَ قَدِمتَ فيها أَبيَضٌ","وَالصُبحُ مُنذُ رَحَلتَ عَنها أَسوَدُ",33,"د",1,0],["فالله في كتمانه إن فزتا","فالملك لا يعدل ما قد حزتا",34,"ت",2,0],["فاللّهُ شاكر ما رفدت بهِ","دينَ الهدى والرُسْلُ والكُتُبُ",35,"ب",1,0],["فَاللَهُ جارُ أَبي عَلِيٍّ إِنَّهُ","أُنسُ الصَديقِ وَغَيظُ صَدرِ الكاشِحِ",36,"ح",1,0],["فَاللَهُ يَكلَأُ عَبدَ اللَهِ إِنَّ لَهُ","مَكارِماً مَن يُخَوَّل بَعضَها يَسُدِ",37,"د",1,0],["فَاللَهُ يُبقيهِ لَنا وَيَحوطُهُ","وَيُعِزُّهُ وَيَزيدُ في تَأييدِهِ",38,"د",2,0],["فَاللَهُ يَحفَظُ عَبدَ اللَهِ إِنَّ لَهُ","فَضلَ السَماحِ وَزَندَ السُؤدَدِ الواري",39,"ي",1,0],["فَاللَهُ يَجزي الحُسنى أَبا حَسَنٍ","فَهوَ لِثِقلِ الحُقوقِ حَمّالُ",40,"ل",1,0],["فَاللَهُ مِن كَثَبٍ حَسيبُكَ ظالِماً","وَحَسيبُ زَوجَةِ صاحِبِ الديوانِ",41,"ن",1,0],["فَاللَهُ أَكبَرُ قَد أُقيدَ بِجُرمِهِ","بِشرٌ وَثارَ بِنائِلٍ جُعلانُ",42,"ن",1,0],["فَاللُؤمُ يَمنَعُ مِنكُمُ أَن تَحتَبوا","وَالعِزُّ يَمنَعُ حُبوَتي لا تُحلَلُ",43,"ل",1,0],["فَاللَهُ يَجزيهِم عَمّا أَتَوا وَحَبَوا","بِهِ الرَسولَ وَما مِن صالِحٍ كَسَبوا",44,"ب",3,0],["فَاللَهُ حَسبُكَ لا سِواهُ وَمَن","راعى الرُعاةَ وَحافَظَ الحَفَظَه",45,"ظ",2,0],["فَاللَهُ يَكلَأُ عُذّالي وَيُلهِمُهُم","عَذلي فَقَد فَرَّجوا كَربي بِذِكرِهِمِ",46,"م",1,0],["فَاللَهِ يُبقيهِ وَيُبقيكُم لَهُ","حَتّى تَرى الأَولادَ مِن أَولادِه",47,"ه",1,0],["فَاللَهُ يَحرُسُ مارِدينَ فَإِنَّها","بَلَدٌ يَلَذُّ بِها الغَريبُ وَيَنعَمُ",48,"م",1,0],["فَاللَهُ قَد ضَرَبَ الأَقَلَّ لِنورِهِ","مَثَلاً مِنَ المِشكاةِ وَالنِبراسِ",49,"س",1,0],["فاللهُ يدفعُ شرَّهُمْ","حتى أدومَ على يمينْ",50,"ن",1,0],["فاللهُ يجعلُ مَوْتي","قبلَ اكتسابي بشعري",51,"ي",1,0],["فاللهُ لا يجعلُهُ آخرَ ال","عهدِ لنا من وجهكَ الناضرِ",52,"ر",1,0],["فاللَّهُ يَجْمَعُ شَمْلَكُمْ ساداتِنا","جَمْعَ السلامَةِ في نعيمٍ سَرْمَدِ",53,"د",1,0],["فاللَّهُ عَلَّمَ كلَّ عِلمٍ آدَماً","وأطاعَ آدَمُ ناسِياً إبلِيسا",54,"س",2,0],["فاللَّهُ مُنتَقِمٌ بِهِم مِن كُلِّ مَنْ","يَبْغِي عَلَى الحَقِّ المُبينِ عُدُولا",55,"ل",2,0],["فاللهُ حَسْبُكَ يا مُحَمَّدُ صَاحِباً","ومُؤازِراً في رِحْلَةٍِ وَمُقامِ",56,"م",1,0],["فَاللَهُ يُعطيكَ الشَبَر","وَفي أَعاديكَ الظَفَر",57,"ر",1,0],["فَاللَهُ يَرعاكَ يا مَن","مَعَ الرِياحِ يَميلُ",58,"ل",1,0],["فَاللَهُ يُبقيهِ وَيُب","قيها لَنا حِقَبَ السِنينِ",59,"ن",1,0],["فَاللُبُّ إِن صَحَّ أَعطى النَفسَ فَترَتَها","حَتّى تَموتَ وَسَمّى جِدَّها لَعِبا",60,"ب",2,0],["فَاللَهُ فَردٌ قادِرٌ مِن قَبلِ أَن","تُدعى لِآدَمَ صورَةٌ أَو تُحسَبا",61,"ب",2,0],["فَاللَهُ ما اِختارَ البَقاءَ وَطولَهُ","إِلّا لِشَرِّ عِبادِهِ إِبليسا",62,"س",2,0],["فاللّهُ يَرْحَمُ مَن مضَى مُتَفَضِّلاً","ويقيك من جَزل الخطوب وشَختِها",63,"ت",3,0],["فاللّوْمُ لؤمٌ ولم يُمْدَحْ بِهِ أحَدٌ","وهل رأيتَ مُحِبّاً بالغرام هُجي",64,"ج",2,0],["فَالْلَّحْظُ عَضْبٌ صَارِمٌ وَالْهُدْبُ نَبْ","لٌ صَائِبٌ وَالْقَدُّ رُمْحٌ أَسْمَرُ",65,"ر",1,0],["فَاللَّحْظُ يَشْرَبُ وَالنَّدَى","مَشْمُولَةٌ وَالكِمُّ كُوبُ",66,"ب",1,0],["فاللّه يقيكَ السّوءَ لنا","وبرحمتِهِ يتَغَمَّدهُ",67,"د",2,0],["فَاللَهُ أَسأَلُ أَن تُعَمَّرَ صالِحاً","وَدَوامُ عُمرِكَ شَيرُ شَيءٍ يُصأَلُ",68,"ل",1,0],["فاللَّيْلُ مَوْصُولٌ بيَوْمٍ حافلٍ","واليومُ مَعقُودٌ بليْل سُهَأدِ",69,"د",1,0],["فالله يجْرزي أميرَ المسلمينَ أبي","خيْر الجزاء فكَمْ حقٍّ لهُ وَجَبا",70,"ب",2,0],["فاللّيل رقص عابث كالصبا","ومعزف يشدو بلا عازف",71,"ف",1,0],["فَالله أسْألُ أنْ تُعَمِّرَ صَالِحاً،","وَدَوَامُ عُمْرِكَ خَيْرُ شيءٍ يُسألُ",72,"ل",1,0],["فاللَّهُ لمْ يرْضَ عَنْ آلِ الزُّبَيرِ، ولا","عَنْ قيسِ عَيلاَنَ، حيّاً طال ما خَرَبوا",73,"ب",3,0],["فاللَه كافله والنصر صاحبه","والخير تابعه والسعد خادمه",74,"م",2,0],["فاللهُ يوصَفُ بالحكيمِ مهابةً","ومحبَّةً ندعوهُ بالحنَّانِ",75,"ن",1,0],["فاللّه يعلم أنني في حبها","بسوى الشباب وبرده لم أكتس",76,"س",1,0],["فاللّهُ يَرْعَى مَنْ يواصِلُ حبَّه","ورَعَى الذي يَرْعَى الهوَى وَرَعَاكِ",77,"ك",1,0],["فالله ربّي في بقيةِ عُمرنا","فلم يبقَ مِنه صاح غيرُ زَهيدِ",78,"د",1,0],["فاللّهَ أسألُه بأن يُنْجيك من","هذي الشدائد غَدْوَتي ومسائي",79,"ا",2,0],["فاللّهَ فيما قد بَقِى","مِ العُمْرِ فهْو لنا نَمَاءُ",80,"ا",2,0],["فالله طهرنا مما يُعَوِّقُنَا","فلا انتقاد ولا بغض ولا حسد",81,"د",1,0],["فالله أشهدني منه الخصوص على","ما كان من عجرٍ مني على بَجَرِ",82,"ر",1,0],["فاللَّطِيمُ المَضِيمُ أنتَ فَإني","لَستُ في الشَّأوِ والحَطيمِ لَطِيمَا",83,"م",2,0],["فَاللهُ أبقَاهُ مِن أوفي لَنَا خَلَفاً","وقَد رَضِينَاهُ مِن أوفي لَنَا خَلَفَا",84,"ف",2,0],["فاللهُ يَنصُرُهُم ويَجمَعُ شَملَهُم","وَيزِيدُ في البَرَكَاتِ والأعمَارِ",85,"ر",1,0],["فألِل العباد منك بعدلٍ","وتوخّ السدادَ في كل أمرِ",86,"ر",1,0],["فَاللَيلُ أَطوَلُ شَيءٍ حينَ أَفقِدُها","وَاللَيلُ أَقصَرُ شَيءٍ حينَ أَلقاها",87,"ه",2,0],["فَاللَهُ عَزَّ مُجيباً فيكَ مُستَمِعٌ","دُعاءَ مَن ضَمَّهُ في أَمنِكَ الحَرَمُ",88,"م",1,0],["فاللّه أكرمني حقّاً وأسعدني","وحطّ عني أوزاراً وأثقالا",89,"ل",2,0],["فالله يمتع أمليه به","ويصون رونق علمه الغض",90,"ض",1,0],["فالله خير لفخر الدين من ابنه","والأجر للأب خير من أبى بكر",91,"ر",1,0],["فالله يجزيك عنها ما تكون بهِ","لا يستطيع الجزا عنه من الشكر",91,"ر",1,0],["فالله نحمده شفيت قلوبنا القر","حا بما لاقت بك الاضدادُ",92,"د",1,0],["فاللهُ راض والبريةُ كلهُمْ","راضوان فاستكثر من الخيراتِ",93,"ت",1,0],["فالله يعلمُ أَنّ فيك لخلقه","خيراً كثيراً جلَّ عن أَن يحُصرا",94,"ر",2,0],["فالله ينصرها ويبعث قبلها","من عنده بالنصر جيشا آخرا",94,"ر",2,0],["فالله يبقيك للمعروف تفعله","ولا يبقى من الأعدا لكم أحدا",95,"د",2,0],["فالله جارك حيث أنت لخلقه","وبلاده من كل سوءٍ جار",96,"ر",1,0],["فالله أسأل أن يطيل لك البقا","ما دام نجم دجي بأفق منجم",97,"م",1,0],["فالله نسأله يجزيك خير جزا","فما برحت علينا مشفقا حدبا",98,"ب",2,0],["فالله ما ذم أهل الشرك إذ صفروا","وصفقوا عند بيت الله للعب",99,"ب",1,0],["فَاللَّهُ يُسعِدُهُ وُيمتعُ خَلقَهُ","بِدَوامِ دَولَتِهِ وَطولِ بِقائِهِ",100,"ا",3,0],["فاللهُ ناصرُ من أطاعَك صادقا","ومُبيدُه بالذلِّ عند نُكوله",101,"ل",2,0],["فالليل أستر للعيو","ب وللذنوب من النهار",102,"ر",1,0],["فاللَّه يَرضى والنبي يتبسّمُ","بِحياتهِ صلّوا عليهِ وسلّموا",103,"م",3,0],["فَاللَهُ لَيسَ بِغافِلٍ عَن أَمرِكُم","حَتّى يُحِلَّ بِكُم عُقوبَةَ مُوجِعِ",104,"ع",1,0],["فاللَهُ نِعَم العون جلّ جلالُه","إن تعدَمِ الأنصارَ والأعوانا",105,"ن",2,0],["فاللَه وفَّاهم بيمنك ما بَغَوا","واللَه بلَّغهم بك الآمالا",106,"ل",2,0],["فاللَه بالبركات خصَّك إذ رأى","نعماك قد كَلِفَت بهَدِّ جِبالِ",107,"ل",1,0],["فالله يمنحك النسل الكثير ولا","يطرق لبابك لا حزن ولا أسف",108,"ف",1,0],["فالله فيض فائض متكاثر","وأجر جزيل جلّ ان يتعد