etry.dctabudhabi.ae/diwan/poem/55177","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55086","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55026","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54842","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142005","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54290","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[106,"الربيع الحائل","https://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[106,"طلعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=179627",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[77,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[49,"مَا استَعبَدَ الحِرْصُ مَنْ لهُ أدَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16963",""],[100,"في المساء","https://www.poetsgate.com/ViewPoem.aspx?id=50420",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"يوم فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=179165",""],[34,"ألُبنى لًقًد جًلًت عًليكِ مُصيبتَي","https://www.poetsgate.com/ViewPoem.aspx?id=18160",""],[85,"لا يقيمنَّ على الضَّيمِ الأسدْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9643&r=&rc=133",""]],"verses":[["أَلبَسُ الذُلَّ في دِيارِ الأَعادي","وَبِمِصرَ الخَليفَةُ العَلَوِيُّ",0,"ي",1,0],["أَلبَستَني النَعماءَ في قَفَلي","وَأَنَلتَني العَلياءَ في ظَعَني",1,"ي",1,0],["أَلبَسَتني نِعَماً عَلى نِعَمِ","وَرَفَعَت لي عَلَماً عَلى عَلَمِ",2,"م",1,1],["البَيتُ ذو العَمَدِ الطِوالِ يُظِلُّهُم","بَينَ القَنا وَالحامِلِ الهَمهامِ",3,"م",1,0],["آلَ بُوَيهٍ أَنتُمُ ال","أَعناقُ وَالكَواهِلُ",4,"ل",1,0],["أَلبَستَنيها بِغَيظِ طالِبِها","وَغودِرَت في الأَضالِعِ الغُلَلُ",5,"ل",1,0],["البيضُ أَوفى وَأَبقى لي مُصاحَبَةً","وَالسودُ مُستَوفِزاتٌ لِلنَوى غُدُرُ",6,"ر",1,0],["آلَ بُوَيهٍ أَنتُمُ ال","أَمطارُ وَالناسُ الخُضَر",7,"ر",1,0],["أَلبَسنَني بُردَ الوَقارِ ضَرورَةً","وَأَرَينَني جَدَدَ الطَريقِ الأَقصَدِ",8,"د",1,0],["اِلبَس نَسيجَ الذُلِّ إِن أُلبِستَهُ","مُتَمَلمِلاً وَإِناءُ قَلبِكَ يَطفَحُ",9,"ح",1,0],["البيدَ يا أَيدي المَطيِّ فَإِنَّني","لِلضَيمِ إِن أَسرى إِلَيَّ مُجانِبُ",10,"ب",1,0],["أَلبَسَهُ الشَوقُ تَباريحَهُ","فَعِندَهُ هَمٌّ وَتَعذيبُ",11,"ب",1,1],["أَلُبنى لَقَد جَلَّت عَلَيكَ مُصيبَتي","غَداةَ غَدٍ إِذ حَلَّ ما أَتَوَقَّعُ",12,"ع",1,1],["ألْبَسْتَ هَذا المُلْكَ ثوْبَ جَلالَةٍ","يَبْقي على مَرِّ الجَديدِ جَديدُهُ",13,"د",2,0],["الْبَاطِنُ الظَّاهِرُ الْحَقُّ الَّذِي عَجَزَتْ","عَنْهُ الْمَدَارِكُ لَمَّا أَمْعَنَتْ طَلَبَا",14,"ب",2,0],["الْبَابَ رَبَّاتِ الحِجَالِ بَلِ الحِجَى","كَيْفَ اهْتَدَيْتَ وَمَا اسْتَبَانَ المَذْهَبُ",15,"ب",1,0],["ألْبَسْتَ مَلْكَ الرُّوْمِ عَاراً بَاقِياً","وَكَسَوْتَ غَمّاً وَجْهَهُ وَقُطُوبَا",16,"ب",2,0],["أَلبِس عَدوَّكَ في رِفقٍ وَفي دعَةٍ","طوبي لِذي إِربَةٍ لِلدَهرِ لَبّاسِ",17,"س",1,1],["البابِلي صَفوَةُ فِتيانِنا","وَاِبنُ المولِحي الكاتِبُ الأَشهَرُ",18,"ر",1,0],["البَرلَمانُ تَهَيَّأَت أَسبابُهُ","لَم يَبقَ مِن سَبَبٍ سِوى المِفتاحِ",19,"ح",1,0],["أَلبَستِهِ الثَوبَينِ في حالَيهِما","تيهَ الغَنِيِّ وَذِلَّةِ المَفلوكِ",20,"ك",1,0],["أَلبَسوكِ الدِماءَ فَوقَ الدِماءِ","وَأَرَوكِ العِداءَ بَعدَ العِداءِ",21,"ا",2,1],["البَغلُ وَالجاموسُ في جَدَلَيهِما","قَد أَصبَحا مَثَلاً لِكُلِّ مُناظِرِ",22,"ر",1,1],["أَلبَستَها مَجدَكَ الضافي فَباتَ لَها","ذَيلٌ عَلى مَنكِبِ الجَوزاءِ يَنسَحِبُ",23,"ب",1,0],["البَدرُ في سُحُبِ البُرو","دِ اللَيثُ في لَبَدِ الدُروع",24,"ع",1,0],["البحر أقرب أن يصير هواء","والأرض أقرب أن تحول ماء",25,"ا",2,1],["الباذلين نفوسهم دون الحمى","ليعيش مرفوع المقام سعيدا",26,"د",2,0],["أَلْبَائِعِينَ زُهَى الْقُشُو","رِ المُشْتَرِينَ بِهِ لُبَابَا",27,"ب",2,0],["ألْبَيْنُ مَحْتُومٌ وَآ","لَمُهُ إِذَا مَا المرْءُ هَابَا",27,"ب",2,0],["البلبل المحكي يوقع لحنه","والطير مجمعةً تقول يعاد",28,"د",1,0],["أَلْبِرُّ فِي أَنْبَلِ غَايَاتِهِ","مُمَثَّلٌ فِي هَذِهِ الْجَامِعَهْ",29,"ع",2,1],["أَلْبَطْرِكِيًّةُ فِي زَمَانِكَ نَافَسَتْ","مِنْ عَهْدِهَا المَشْهُورِ خَيْرَ زَمَانِ",30,"ن",1,0],["ألبَاذِلُونَ لَكِ النُّفُوسَ رَخِيصَةً","وَنَفَائِسَ الدُّنْيَا بِلاَ أَثْمَانِ",31,"ن",1,0],["البِنْتُ أَحْرَى لِلْعِنَايِةِ","فِي حِلَى مَلِكٍ جَمِيلْ",32,"ل",1,0],["البَانِياتِ بِقُوَّةِ الأخْلاَ","قِ أَعْلاَمَ الرِّجَالْ",33,"ل",1,0],["البِشر في وجهها واليمن في يدها","والسّحرُ في لفظها والدرُّ في فيها",34,"ي",3,0],["ألبستهم ثوب الكرامة ضافياً","وأرحتَ من كدِّ ومن إرهاقِ",35,"ق",1,0],["ألبست عبدكَ من ثيابك ملبَساً","قد قصّرت عنه مدارك شكره",36,"ر",2,0],["ألبستني أركبتني شرّفتني","أهديتني ما لا أقوم بحصره",36,"ر",2,0],["البحر رهوٌ والسما صاحيه","والفخت في الليل شبيه السديم",37,"م",1,1],["ألبسوها من الحديد وِشاحاً","فتهادت على العُباب عروسا",38,"س",2,0],["ألبِس حياتك أحوال المحيط وكن","كالماء يلبس ما للظَرف من جُدُر",39,"ر",1,0],["البدر يبدو حقيراً عند طلعته","والشمس تعنو لوجهٍ منه نوراني",40,"ن",2,0],["أَلباعِثينَ بِرَغمِ آنُفِ تَغلِبٍ","في كُلِّ مَنزِلَةٍ عَلَيكَ أَميرا",41,"ر",2,0],["الباعِثُ النَوحَ في مَآتِمِهِ","مِثلَ الظِباءِ الأَبكارِ بِالجَرَدِ",42,"د",1,0],["البالغون قٌعور الأمر تروية","والباسطون أكفاً غير أصفارِ",43,"ر",1,1],["البَغيُ أَكثَرُ ماتُقِلُّ خُيولُهُم","وَالبَغيُ شَرُّ مُصاحِبِ الإِنسانِ",44,"ن",1,0],["أُلبِستَ مالَبِسوا أُركِبتَ مارَكِبوا","عُرِّفتَ ماعَرَفوا عُلِّمتَ ماعَلِموا",45,"م",3,0],["ألبسته وشيها الحالي وألبسني","نواله وشيَ أثوابِ الغِنى القشبِ",46,"ب",1,0],["البرق في كانونه قد نفخ","والثلج في جيب الغوادي نفخ",47,"خ",1,1],["البدارَ البدارَ نحو نداه","فإذا صال فالفرارَ الفرارا",48,"ر",2,0],["ألبستني ثوب الغرام مشهَّراً","فمدامعي حمرٌ ولوني أصفر",49,"ر",1,0],["ألبسته آباؤه ثوبَ مجدٍ","فغدا بالجلال يرقم طرزَه",50,"ز",2,0],["إلباس تشريفي اقتضى فأزل","إلباس حسنى بحسنِ إلباس",51,"س",1,0],["البحر في كفيه أو في صدره","فانهل وإن ناويته فاخش الغرق",52,"ق",1,0],["الباذل الوفر في بدوٍ وفي حضرٍ","والجامع الحمد من سهلٍ ومن جبل",53,"ل",1,0],["البالغين مدى العليا ولو قعدوا","والسابقين ولو ساروا على مهل",53,"ل",1,0],["البحر علماً وجوداً جانسا صفة","فحبذا منه سيحان وجيحان",54,"ن",1,0],["البُحْتُريُّ ذَنُوبُ الوجهِ نعرفُهُ","وما رأينا ذَنُوبَ الوجه ذا أدبِ",55,"ب",1,0],["ألبسَهُ هَيبةً فغادرهُ","رِئْبالَ غابٍ يَحفُّهُ أَشَبُهْ",56,"ب",2,0],["ألبِسَ الزّرّين والجِب","سين من بعد اختيار",57,"ر",1,0],["ألبسُ حِلمي عند لُبسي له","حتى تراني ساكنَ النَّبض",58,"ض",1,1],["البنتُ بنتُكما معاً","شهدت به السبع الطباق",59,"ق",1,0],["البذْرُ للشَّوْكيِّ غَيْ","رَ مدافَعٍ والأرضُ أرضُك",60,"ك",1,0],["ألبسكَ اللَّه يا أبا عُمرٍ","ثوبَ بهاء وتاجَ تبجيلِ",61,"ل",1,0],["الباقطائيِّ ذي البراعة وال","سؤددِ والمحتدِ الذي كرما",62,"م",2,0],["الباسِطونَ بِدُنياهُم أَكُفَّهُمُ","وَالضارِبونَ غَداةَ العارِضِ الشَبِمِ",63,"م",1,0],["البائِتونَ قَريباً دونَ أَهلِهِمِ","وَلَو يَشاؤونَ آبوا الحَيَّ أَو طَرَقوا",64,"ق",3,0],["البيدُ وَالناسُ ما بَيني وَبَينَكُمُ","لَيتَ المَهامِهَ تُطوى لي فَأَقتَرِبُ",65,"ب",1,0],["الباذِلينَ نُفوسَهُم لَم يَسأَلوا","وَعَلى النُفوسِ مَدارِعُ الفولادِ",66,"د",1,0],["البَغيُ مَرتَعُهُ وَخيمٌ فَاِعلَموا","وَالظُلمُ يُعقَبُ لِلظَلومِ دَمارا",67,"ر",2,0],["البَذلُ دَيدَنُها سَواءٌ جِئتَها","مُتَقَدِّماً أَم جِئتَها مُتَأَخِّرا",68,"ر",2,0],["أَلبَستَهُم ثَوبَ عارٍ لا تُطَهِّرُهُ","نارُ الجَحيمِ وَلَو في حَرِّها اِغتَسَلوا",69,"ل",3,0],["البَدرُ مِن أَزرارِهِ طالِعٌ","وَالغَيثُ مِن راحَتِهِ هامِلُ",70,"ل",1,0],["أَلبَستَنيهِ مونِقاً بَعدَما","أَبلاهُ أَخوالي وَأَعمامي",71,"ي",1,0],["اِلبِسوا في صَحوِكُم ثَوبَ الجُمود","وَاِحلَموا في نَومِكُم بِالمُعجِزات",72,"ت",1,0],["البَدرُ أَمسى أَكلَفاً","مِن حُسنِهِ وَالغُصنُ ناكِس",73,"س",1,0],["أَلباغِيَ الحَربَ يَسعى نَحوَها تَرِعاً","حَتّى إِذا ذاقَ مِنها جاحِماً بَرَدا",74,"د",2,1],["أَلْبَسوا رُوحَهُ قَميصَ اضْطِهادٍ","فاتِكٍ شائِكٍ يَرُدُّ جَمَاحَهْ",75,"ح",2,0],["البعضُ لم يدرِ إلاَّ","البِلى يُنَادي البلايا",76,"ي",2,0],["البؤسُ لابنِ الشَّعبِ يأكلُ قلبَه","والمجدُ والإثراءُ للأغرابِ",77,"ب",1,1],["البُخلُ عَينُ نَقيصَةٍ","وَالجودُ عَينٌ لِلكَمالْ",78,"ل",1,0],["البحر يغلى كان البحر بركان","تثيره تحت فيض الماء نيران",79,"ن",1,1],["البرد يهرو كل نابتة بها","لا الزهر مستثنى ولا الافنان",80,"ن",1,0],["البلبل الصيداح موسيقارها","فاذا شدا خرت له الاذقان",81,"ن",1,0],["البَحرُ الفَيّاضُ القُدسُ","الساقي الناسَ وَما غَرَسوا",82,"س",3,0],["البُلبُلُ الغَرِدُ الَّذي هَزَّ الرُبى","وَشَجى الغُصونَ وَحَرَّكَ الأَوراقا",83,"ق",2,0],["البَنونَ اِستَنهَضوا آبائَهُم","وَدَعا الشِبلُ مِنَ الوادي الأَسَد",84,"د",1,0],["البَرلَمانُ غَداً يُمَدُّ رُواقُهُ","ظِلّاً عَلى الوادي السَعيدِ ظَليلا",85,"ل",2,0],["البَدرُ دونَكَ في حُسنٍ وَفي شَرَفٍ","وَالبَحرُ دونَكَ في خَيرٍ وَفي كَرَمِ",86,"م",1,0],["البُعدُ أَدناني إِلَيكَ فَهَل تُرى","تَقسو وَتَنفُرُ أَم تَلينُ وَتَرفُقُ",87,"ق",1,0],["البُؤسُ وَالنُعمى عَلى حالَيهِما","وَالحَظُّ يَعدِلُ تارَةً وَيَجورُ",88,"ر",1,0],["البَنونَ هُم دَمُنا","وَالحَياةُ وَالوُرُدُ",89,"د",1,0],["البَعثُ غايَةُ زائِلٍ","فانٍ وَأَنتُم خالِدون",90,"ن",1,0],["البَرُّ مَغلوبُ القَنا","وَالبَحرُ مَسلوبُ السَفين",90,"ن",1,0],["البَأسُ وَالجَبَروتُ في أَعرافِها","وَالمَوتُ حَولَ شَكيمِها المَعلوكِ",91,"ك",1,0],["الباعِثونَ الحَربَ حُب","باً لِلتَوَسُّعِ في الوِلايَه",92,"ا",3,0],["البِرُّ مِن شُعَبِ الإيمانِ أَفضَلُها","لا يَقبَلُ اللَهُ دونَ البِرِّ إيمانا