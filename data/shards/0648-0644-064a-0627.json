.html","الكامل"],[362,"سبى مني الفؤاد لحاظ فاتن","https://www.aldiwan.net/poem60611.html","الوافر"],[362,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[362,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[364,"ولى العدو وعثمان وراءهم","https://www.aldiwan.net/poem17213.html","البسيط"],[364,"الأرض واسعة نعم لكنهم","https://www.aldiwan.net/poem17335.html","الكامل"],[365,"ولي النبعة من سلافها","https://www.aldiwan.net/poem4618.html","الرمل"],[369,"لست أرضى لسرهن دموعي","https://www.aldiwan.net/poem57319.html","الخفيف"],[374,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[377,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[377,"ناء بمصر وبالشآم حبيبه","https://www.aldiwan.net/poem49206.html","الكامل"],[388,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[397,"موازين الرجال","https://www.aldiwan.net/poem6777.html","عموديه"],[402,"دعني فإن غريم العقل لازمني","https://www.aldiwan.net/poem49681.html","البسيط"],[402,"ولي أخ مستظرف","https://www.aldiwan.net/poem49848.html","مجزوء الرجز"],[406,"مواصلتي كتبي إليك تزيدني","https://www.aldiwan.net/poem32266.html","الطويل"],[413,"خليلي في قلبي من الوجد جذوة","https://www.aldiwan.net/poem53928.html","الطويل"],[413,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[413,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[413,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[413,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[413,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[413,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[413,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[429,"كان لك الله يا أبا الحسن","https://www.aldiwan.net/poem12329.html","المنسرح"],[429,"نمت بسر غرامه الأجفان","https://www.aldiwan.net/poem12412.html","الكامل"],[429,"يا أيها الملك الذي","https://www.aldiwan.net/poem12537.html","مجزوء الكامل"],[429,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[436,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[438,"ويا طالبا شرح السؤال فآنه","https://www.aldiwan.net/poem14401.html","الطويل"],[447,"حديث الحب","https://www.aldiwan.net/poem1016.html",""],[450,"در در الصبا ودر التصابي","https://www.aldiwan.net/poem13651.html","الخفيف"],[450,"يا لعهد مضى وعيش رغيد","https://www.aldiwan.net/poem13711.html","الخفيف"],[456,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[456,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[456,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[459,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[462,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[462,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[462,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[462,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[477,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[480,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[488,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[493,"ما كان ليلي ليلا","https://www.aldiwan.net/poem9881.html","المجتث"],[498,"الحمد لله لي للمصطفى نسب","https://www.aldiwan.net/poem37811.html","البسيط"],[498,"غراميات قلبي في هواكم","https://www.aldiwan.net/poem38050.html","الوافر"],[512,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[513,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[549,"أسيدنا الشريف علوت عن أن","https://www.aldiwan.net/poem47315.html","الوافر"],[549,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[549,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[556,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[565,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[573,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"],[573,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[573,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"]],"verses":[["وَلي أَمَلٌ لا بُدَّ أَحمِلُ عِبئَهُ","عَلى الجُردِ مِن خَيفانَةٍ وَحِصانِ",0,"ن",1,0],["وَلي أَمَلٌ أَطَلتُ الصَبرَ فيهِ","لَوَ أَنَّ الصَبرَ يَنقَعُ مِن أُوامي",1,"م",2,0],["وَلي أَمَلٌ كَصَدرِ الرَمحِ ماضٍ","سِوى أَنَّ اللَيالي مِن خُصومي",2,"م",2,0],["وَلَيالي السوسِ صَبَّحتُ بِها","صائِحاً يَسقي دَمَ الطَعنِ مُداما",3,"م",2,0],["وَلّى الشَبابُ وَهَذا الشَيبُ يَطرُدُهُ","يَفدي الطَريدَةَ ذاكَ الطارِدُ العَجِلُ",4,"ل",1,0],["وَلي أَمَلٌ مِن دونِ مَبرَكِ نِضوِهِ","يُقَلقِلُ أَثباجَ المَطيِّ البَوارِكِ",5,"ك",1,0],["وَلَيالِيَ الصَبَواتِ وَهيَ قَصائِرٌ","خَطفَ الوَميضِ بِعارِضٍ مِبراقِ",6,"ق",1,0],["وَلي أَنفٌ كَأَنفِ اللَيثِ يَأبى","شَميمي لِلمَذَلَّةِ وَاِستِيافي",7,"ي",1,0],["وَلِيَ النَقابَةَ خالُ أُم","مي قَبلُ ثُمَّ أَبي وَجَدّي",8,"ي",1,0],["وَلي إِن يَطُل عُمري مَعَ الدَهرِ وَقفَةٌ","تُذَلِّلُ أَحداثَ الزَمانِ لِمَن بَعدي",9,"ي",1,0],["وَلَيالِيَّ بِجَمعٍ","وَمِنىً وَالجَمَراتِ",10,"ت",1,0],["وَلِي إِلَيها وَإِن خِفتُ العِدا نَظَرٌ","أَلْوِي لَهُ الجيدَ أَحياناً إِذا غَفَلوا",11,"ل",3,0],["وَلي أَدْمُعٌ إِنْ أَمْسَكَ المُزْنُ دَرَّهُ","كَفَلْنَ بِصوْبِ البارِقاتِ الرَّواعِدِ",12,"د",1,0],["وَلي إِذا خَالسَتْنِي القَوْلَ أَوْ سَفَرَتْ","عَنْ وَجْهِها ما اشْتَهاه السَّمْعُ وَالبَصَرُ",13,"ر",1,0],["وَلي أَبٌ لَوْ أُعيرَ النّاسُ سُؤدَدَهُ","لَم يَرْغَبوا الدّهْرَ في عَمٍّ وَلا خَالِ",14,"ل",1,0],["ولَّى الصّيامُ وقد أوْقرْتَهُ كَرَماً","أفضى إليكَ بأجرٍ غَيرِ مَمنونِ",15,"ن",1,0],["وَلِيَ اِبنُ عَمٍّ ما يَزا","لُ لِشِعرِهِ خَبَباً رِكابُه",16,"ب",2,0],["وَلِيَ الأَمرَ ثُلثَ قَرنٍ يُنادي","بِاِسمِهِ كُلُّ مُسلِمٍ في الوُجودِ",17,"د",1,0],["وَلّى الشَبابُ وَجازَتني فُتُوَّتُهُ","وَهَدَّمَ السُقمُ بَعدَ السُقمِ أَركاني",18,"ي",1,0],["وَلي أَمَلٌ لَوِ الواشونَ كَفّوا","لَأَطلَعَ غَرسُهُ ثَمَرَ النَجاحِ",19,"ح",1,0],["وَلّى أَبو بَكرٍ فَراعَ لَهُ الوَرى","هَولٌ تَقاصَرَ دونَهُ الأَهوالُ",20,"ل",1,0],["ولي أملٌ في ذمة الدهر مخلف","وجاه بأيدي النائبات سليب",21,"ب",1,0],["وَلَّى الرَّبِيعُ وَجَفَّ عُو","دِي وَانقَضَى عَهْدُ التَّغَنِي",22,"ن",2,0],["وَلِيَ الإِدَارَةَ وَالقَضَاءَ فَلَمْ يَكُنْ","بِمُفَرِّطٍ أَوْ مُفْرِطٍ فِي شَانِ",23,"ن",1,0],["وَلِيَ الزَّعَامَةَ غَيْرَ وَا","هٍ فِي الْخُطُوبِ وَغَيْرَ وَانِي",24,"ي",1,0],["وَلَّى إِمَامُ المُنْشِئِينَ وَكَانَ فِي","تَجْدِيدِ شَأْنِ الضَّادِ أيَّ إمَامِ",25,"م",1,0],["وَلَّى أخُو الأَفْذَاذِ مِنْ شُعَرَائِهَا","فِي جَاهِلِيَّتِهَا وَفِي الإِسْلامِ",25,"م",1,0],["وَلَّى الشَّبَابُ وَصَوَّحَتْ جَنَّاتُهُ","وَتَخَالَفَتْ فِي طَيْرِهَا الأنْعَامُ",26,"م",1,0],["وَليَالياً لَو أَنَّ حَاضِرَ بَثَّها","طَرف القَضِيبِ أصابَهُ لأَشَلَّهُ",27,"ل",2,0],["وَلِيَ الخِلافَةَ وَالكَرامَةَ أَهلُها","فَالمُلكُ أَفيَحُ وَالعَطاءُ جَزيلُ",28,"ل",1,0],["وَلِيُّ الحَقِّ حينَ تَؤُمَّ حَجّاً","صُفوفاً بَينَ زَمزَمَ وَالحَطيمِ",29,"م",1,0],["وَلي إِذا كُلَّ عَينٍ نامَ صاحِبُها","عَينٌ تَحالَفَ فيها الدَمعُ وَالأَرَقُ",30,"ق",1,0],["وَلِيَ الناسَ مِنهُمُ إِذ حَضَرتُم","أُسرَةٌ مِن بَني قُصَيٍّ صَميمُ",31,"م",1,0],["وليَ المصيف وفي حشايَ حرارةٌ","للهمّ فوق حرارة المصطاف",32,"ف",1,0],["ولي أسفٌ بادٍ من الحزنِ إنما","على مثل لقياك ابن يعقوب يوسف",33,"ف",1,0],["وليالٍ جادت وأعقبت اله","مّ فيا ليت جودها كانَ بخلا",34,"ل",2,0],["وَليَ الطائرُ السعيد الذي كا","ن بريداً بدولةٍ زهراءَ",35,"ا",2,0],["وَلِيَ الخفُّ ذو الرقاع أو النعْ","لُ وللعبدِ سابحٌ يَعْبُوبُ",36,"ب",1,0],["ولي إلى ابن فراس عودة وجبتْ","له عليّ بحق إنه وَزَر",37,"ر",1,0],["ولي أصدقاء كثيرو السلام","عليَّ وما فيهم نافعُ",38,"ع",1,1],["ولي السدَّ وهو أقوم بالفت","ح وان كان قد يسد الفتوقا",39,"ق",2,0],["وليَ الدهرَ طعنةٌ ذاتُ غَوْرٍ","غير أن لستُ حينَ أطعنُ أَقْتُلْ",40,"ل",1,0],["وليَ العطرُ والملابسُ","كلُّه والتقتُّلْ",40,"ل",1,0],["وَليَأتِيَنَّ عَلَيكَ يَومٌ مَرَّةً","يُبكى عَلَيكَ مُقَنَّعاً لا تَسمَعُ",41,"ع",1,0],["وَلي أَخوكَ فَما أَمضَنِيَ النَوى","وَلَقَد قَدِمتَ فَما هَشَشتُ إِلى اللُقا",42,"ق",2,0],["وَلّى الصِبا وَتَبَدَّدَت أَحلاُهُ","أَودى بِهِ وَبِها قَضاءٌ حَوَّلُ",43,"ل",1,0],["وَلِيَ الجَيشُ الَّذي تَرشُحُ بِالمَوتِ ظِباهُ","وَلِيَ الغاباتُ وَالشُمُّ الرَواسي وَالمِياهُ",44,"ه",1,0],["وَلِيَ النسُ وَبُؤسُ الناسِ مِنّي وَالرَفاهُ","إِنَّ هَذا الكَونَ مُلكي أَنا في الكَونِ إِلَهُ",44,"ه",1,0],["وَلّى الشِتاءُ وَنَفسي في كَآبَتِها","وَاِستَضحَكَ الصَيفُ إِلّا في نَوحيها",45,"ي",3,0],["وَلَيالِيَّ في الجَزيرَةُِ وَالجي","زَةِ فيما اِشتَهَيتُ مِن لَذّاتِ",46,"ت",1,0],["وليَ الإِنْشادُ والعَزْفُ","إلى وَقْتِ الأَصيلْ",47,"ل",1,0],["ولي الشتاء وانواء الشتاء وقد","جاء الربيع ولما يورق العود",48,"د",1,0],["ولىّ الأهل والأتبا","ع والمسكين يطعِمه",49,"م",2,0],["ولى الصبا ومضى جِد الدهور به","ولا تزال لعوبا في تصابيها",50,"ي",3,0],["وَلَيالٍ مِن كُلِّ ذاتِ سِوارٍ","لَطَمَت كُلَّ رَبِّ رومٍ وَفُرسِ",51,"س",1,0],["وَلَيالِياً لَم تَدرِ أَينَ عِشاؤُها","مِن فَجرِها لَولا صِياحُ الديكِ",52,"ك",1,0],["وليَ الزجاجة وهي سر غامض","والزيت والمشكاة والمصباح",53,"ح",1,0],["ولي أملٌ أن ساعدتْ منك عطفةٌ","فما دونَ نَيْلِ المشتَهى منه مانعُ",54,"ع",1,0],["ولي الأمورَ فكان أحسنَ منظراً","ممن تقدَّمهُ وأكرمَ مخبَرا",55,"ر",2,0],["ولي أُسوةٌ بالبدر يُنفق نورَه","فيخفَى إِلى أن يستجدَّ ضياءَ",56,"ا",2,0],["وَلِيَ البِلادَ فَكانَ عَدلاً شائِعاً","يَنفي الظَلامَ وَنائِلاً مَوهوبا",57,"ب",2,0],["وَلِيَ الأُمورَ بِنَفسِهِ وَمَحَلُّها","مُتَقارِبٌ وَمَرامُها مُتَباعِدُ",58,"د",1,0],["وَلِيَ السِياسَةَ واسِطاً","بَينَ التَسَهُّلِ وَالتَشَدُّد",59,"د",1,0],["وَلَيالٍ كُسينَ مِن رِقَّةِ الصَي","فِ فَخَيَّلنَ أَنَّهُنَّ بُرودُ",60,"د",1,0],["وَلِيَ الوِزارَةَ مُبقِياً في أُمَّةٍ","قَد كانَ شارَفَ هُلكُها أَن يَأفِدا",61,"د",2,0],["وَلِيَ الأُمورَ بِرَأيِهِ فَسَدادُهُ","إِمضاؤُهُ بِالحَزمِ أَو تَوقيفُهُ",62,"ف",2,0],["وَلِيُّ أَيادٍ عِندَنا ما يُغِبُّها","ثَناءٌ عَلى سَمعِ العَدُوِّ ثَقيلُ",63,"ل",1,0],["وَلَيالي الخَريفِ خُضرٌ وَلَكِن","رَغَّبَتنا عَنها لَيالي الرَبيعِ",64,"ع",1,0],["وَلِيَّ العَهدِ مِن أَبَوَيكَ فيهِ","خَلائِقَ قَد كَمَلنَ لَهُ كَمالا",65,"ل",2,0],["وَلي إذا الضيفُ عادَ أُخرَى","مُصرَّعٌ حولها سوامي",66,"م",2,0],["ولَّى الشَّمَيْشَقُ لا يهفو به طَربٌ","إلى المحلِّ ولا يدنو به سببُ",67,"ب",1,0],["وَلِيَ السُبقَةُ في الإِس","لامِ طِفلاً وَوَجيها",68,"ي",3,0],["وَلِيَ القُربَةَ إِن قا","مَ شَريفٌ يَنتَميها",68,"ي",3,0],["وَلِيَ الفَخرُ عَلى النا","سِ بِفاطِم وَبَنيها",68,"ي",3,0],["وَلِيَأتِيَنَّ عَلَيكِ ما","أَفنى القُرونَ الأَوَّلينا",69,"ن",2,0],["وَلي إِلى أَن أَموتُ رِزقٌ","لَو جَهَدَ الخَلقُ ما عَداني",70,"ي",1,0],["وَلَيَأتِيَنَّ عَلَيَّ تَح","تَ التُربِ حينٌ بَعدَ حينِ",71,"ن",1,0],["وَلي إلى ذاك الجمالِ اتجاه","ولي بسلطانِكِ عزٌّ وجاه",72,"ا",2,0],["وليالي الصفاء تمضي عجالاً","والمنايا بالموتِ غيرُ بطاءِ",73,"ا",2,0],["وليالياً موصولة سهراً","أبدية حجرية الكبدِ",74,"د",1,0],["وليالٍ في إثرهن ليالٍ","سنة أقفرَت وأخرى خلاء",75,"ا",2,0],["وليَ الويل إذا لبيتها","ولي الويل إذا لم أتبعها",76,"ه",2,0],["وَلّى الحُماةُ وَأَضحى عِندَ سَورَتِهِ","مَعَ الحَمِيَّةِ كَالمَشدودِ في قَرَنِ",77,"ن",1,0],["وَلَيالِيَ الحَشّاكِ وَالثَرثارِ قَد","جَلَبوا الجِيادَ لَواحِقَ الأَقرابِ",78,"ب",1,0],["وَلِيَ القضاءَ وصارَ شيخَ شيوخِهِمْ","والقلبُ منهُ على التصوفِ منطوِ",79,"و",1,0],["وليَ القضاءَ وصارَ لا","يلوي ولا يترفَّقُ",80,"ق",1,1],["وليَ الفقهُ الذي فقتُ بهِ","ووجوهُ النحوِ نحوي تُصرفُ",81,"ف",1,0],["وليَ النظمُ الذي سارتْ إلى","سائرِ الأقطارِ منهُ التحفُ",81,"ف",1,0],["ولي النثرُ الذي سجْعاتُهُ","تسكرُ الأسماعَ فَهْيَ القرقفُ",81,"ف",1,0],["وَلّى الشَبابُ حَميداً غَيرَ مُرتَجَعٍ","وَاِستَبدَلَ الرَأسُ مِنّي شَرَّ ما بَدَلا",82,"ل",2,0],["وَليَأتِ إِن جاءَ عَلى بَغلَةٍ","إِنّي أَخافُ المُهرَ أَن يَصهِلا",83,"ل",2,0],["وَلي أَلفُ وَجهٍ قَد عَرَفتُ طَريقَهُ","وَلَكِن بِلا قَلبٍ إِلى أَينَ أَذهَبُ",84,"ب",1,0],["وَلي أَواصر قُربى فيكَ ما بَرحت","لَما مَضى ذات تَوثيق وَتَمكين",85,"ن",1,0],["وَليالٍ ظَفرتُ فيها مِن الدَه","ر عَلى بخله بِنعمة عَطفِ",86,"ف",1,0],["وليالي الأَعراس يا لهف قلبي","عطلتْها تقلُّباتُ الليالي",87,"ل",2,0],["وَلِيَ الصافِناتُ تَردي إِلى المَو","تِ وَلا تَهتَدي سَبيلَ الفِرارِ",88,"ر",1,0],["وَلّى الصِيامُ وَجاءَ الفِطرُ بِالفَرَحِ","وَأَبدَتِ الكَأسُ أَلواناً مِنَ المُلَحِ",89,"ح",1,1],["وَلِيَ المَهابَةُ في الأَحِبَّةِ وَالعِدى","وَكَأَنَّني أَسَدٌ لَهُ تامورُ",90,"ر",1,0],["وَلّى الشَبابُ وَمِن شَوقٍ لِرُؤيَتِهِ","يَظَلُّ مَشبِهُهُ في الرَوضِ مَنشوقا",91,"ق",2,0],["وَلي أَمَلٌ قَد شُبتُ وَهوَ مُصاحِبي","وَساوَدَني قَبلَ السَوادِ وَما هَمّا",92,"م",2,0],["وَلي أَمَلٌ كَأَتمِّ القَنا","وَحالٌ كَأَقصَرِ سَهمٍ يَكونُ",93,"ن",1,0],["وَلِيَ الأَصلُ الَّذي في مِثلِهِ","يُصلِحُ الآبِرُ زَرعَ المُؤتَبِر",94,"ر",1,0],["ولَّى الشَّبابُ وكنتَ تَسكنُ ظِلَّهُ","فانظُرْ لنفسِكَ أيَّ ظِلٍّ تسكُنُ",95,"ن",1,1],["ولَّى الشبابُ فقلتُ أندبُه","لا مثلَ ما قالوا ولا نَدَبوا",96,"ب",3,0],["ولي التفاتٌ لسري الصّفات","واللؤلؤِ اللّماح خلف القناع",97,"ع",1,0],["وليالي الصيفِ منها كأماسيِّ الشتاءِ","بِتُّ أسقيها وتسقيني على محض الوفاءِ",98,"ا",2,0],["وليالٍ من الفراغ عواتٍ","هَرأتهُ ثلوجهنَّ صقيعا",99,"ع",2,0],["ولّي أبا بكرٍ على الصلاة","وتلك عليا رتب الولاة",100,"ه",1,0],["وَلِي أَملٌ فِي اللَّهِ تَحْيَا بِهِ الْمُنَى","وَيُشْرِقُ وَجْهُ الظَّنِّ والْخَطْبُ كَاشِرُ",101,"ر",1,0],["وَلِيَ الوِزَارَةَ لَمْ يَخَلْهُ حِينَما","لَبَّى عَلَى الآسَادِ يَدْخُلُ غَابَا",102,"ب",2,0],["وَلِيَ الإِدَارَةَ رَائِضاً عِلاَّتِهَا","يَتَدَارَكُ التَّحْسِينَ بَاباً بَابَا",102,"ب",2,0],["وَلَيَالِيهِ فِي الخِيَامِ لَيَالِي","وَسِنٍ رَازِحٍ مِنَ الإِجْهَادِ",103,"د",1,0],["وَلِيَ العُذْرُ هَلْ يَصِحُّ سُكُوتٌ","عَنْ فِعَالٍ تَدْعُو إِلى الإِطْرَاءِ",104,"ا",2,0],["وَلي أَدمُعٌ طَوعى إِذا ما أَمَرتُها","وَهُنَّ عَواصٍ في هَواهُ غَوالِبُ",105,"ب",1,0],["ولي الْحُماةُ فما أجابوا دعوةً","لمّا دعاهم للردَى داعيك",106,"ك",1,0],["وَليَ الأمورَ بمصرَ أصيدُ، يافعٌ","بذَّ الأوائلَ فتيةً وكهولا",107,"ل",2,0],["ولَّى القديم، فما ظفرت بطائلٍ","وأتى الجديد، فهل ترى هو مُسعدي؟",108,"د",2,0],["ولّى الصبا وتبددت أحلامه","أودى به وبها قضاء حوّل",109,"ل",1,0],["ولّى الشتاء ونفسي في كآبتها","واستضحك الصّيف إلاّ في نواحيها",110,"ي",3,0],["ولى أخوك فما أمضى النوى","ولقد قدمت فما هششت إلى اللقا",111,"ق",2,0],["ولى الشبابُ حمياً غيرَ مرتجعٍ،","واستبدل الرأسُ مني شرّ ما بدلا",112,"ل",2,0],["وَلي العُذر حَيث لا أَحسَن الشعر","وَأَنّي أَخطَأت كانَ صَوابي",113,"ي",1,0],["وليال سلفت لي","قرب سلع ورباها",114,"ا",3,0],["ولي الملاذ فتى المعامع شبله","وادي الندا حسن ابو البركات",115,"ت",1,0],["ولي أمل من سر قدرة بأسه","أفوز وضدي لا يزال بذله",116,"ل",2,0],["ولي الجبال عرايا غير كاسيةٍ","والبحر والريح سمار وندمان",117,"ن",1,0],["ولى الظلام وأجفلت أحلامه","فرجعت أرمق غضة المتنسم",118,"م",1,0],["وليالي الصيف في وادي الشتا","لليالي شهر كانون تحن",119,"ن",1,0],["وَلي اِبنُ عَمٍّ لَهُ خُلقٌ وَلي خُلُقٍ","قَد اِختَلَفنا فَأقليهِ وَيَقليني",120,"ي",1,0],["وَلي اِبنُ عَمِّ لَو أَنَّ الناسَ في كَبَدٍ","لَظَلَّ مُحتَجِزاً بِالنَبلِ يَرميني",120,"ي",1,0],["ولي أن أباهي رفقتي حيث وجهت","عنايتكم نحوي وأن أزدهي فخراً",121,"ر",2,0],["وليّ الصدورُ وجوهَهم","يا كعبةَ الأدباءِ شطركْ",122,"ك",1,0],["ولَّى أَرَسْلانٌ يُمَسِّح في الحشا","قلبا يشير عليه بالطيرانِ",123,"ن",1,0],["وَلِيَ المَحامِدُ لَن يُطاوَلَ رَبُّها","حَتّى يَطولَ الفاضِلَ المَفضولُ",124,"ل",1,0],["ولى الملوكَ ليصلحَ الدينا بهم","وحباك أنت لنفسه سُلطانا",125,"ن",2,0],["ولي أمل في أحمد آن وقته","وأوشك أن يرضى نداه المطامعا",126,"ع",2,0],["ولي أسوة قبلي بمن مات في الهوى","ومن مات لا عار عليه ولا ذل",127,"ل",1,0],["وَليَ الجُمجُمَةُ العَل","ياءُ وَالعِزُّ الكَثيفُ",128,"ف",1,0],["وَليَ التالِدُ مِلحم","دِ قَديماً وَالطَريفُ",128,"ف",1,0],["وَلّى الرَدى يَومَ تَوَلّى بِهِ","وَوَجهُهُ أَزهَرُ 