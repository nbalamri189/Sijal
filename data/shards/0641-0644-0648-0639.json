em/120523","البسيط"],[4980,"ألِفتُ النّوى","https://www.poetsgate.com/ViewPoem.aspx?id=191964",""],[5000,"النداء الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=6082",""],[5111,"رِيكَا","https://www.poetsgate.com/ViewPoem.aspx?id=212166",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5213,"أحبتنا عودوا فقد شفني البعد","https://www.poetsgate.com/ViewPoem.aspx?id=170453",""],[307,"خَرِيفُ العُمْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215587",""],[5376,"والرمز بالعشق باد","https://www.poetsgate.com/ViewPoem.aspx?id=196646",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5853,"عاااااااااااااااااااشق","https://www.poetsgate.com/ViewPoem.aspx?id=175701",""],[5957,"تنحى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=176787",""],[5355,"أما آن الرجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87208&r=&rc=33",""]],"verses":[["فلَوْ عَلِمْتَ بَعْضَ ما يُجِنُّهُ","لمْ تَسْتَرِبْ منهُ بكُلِّ ما تَرى",0,"ا",1,0],["فَلَو عَلِمَت فَوزٌ بِما كانَ بَينَنا","لَقَد كانَ مِنها بَعضُ ما كُنتُ أَرهَبُ",1,"ب",1,0],["فَلَو عَزَّ حَمّامٌ لَأَدفَأَنا ذَرىً","يَفيضُ بِهِ ماءُ النَدى المُتَفَجِّرُ",2,"ر",1,0],["فَلَو عَرَفَت مَزاياها الغَواني","لَعَلَّقَ حُبُّها في كُلِّ نَحرِ",3,"ر",1,0],["فَلَو عُدتَما لاخترتُما العودَ في الثَرى","إِذا أَنتُما أَبصَرتُمانيَ في الأَسرِ",4,"ر",1,0],["فلو علمت المنون شخصا","لقلت لا عقل للمنون",5,"ن",1,0],["فَلَو عَلِمَ الجَمعُ مِمَّن مَضى","تَنَحّى لَهُ الجَمعُ حَتّى عَبَر",6,"ر",1,0],["فَلَو عَلِمَت عَلوٌ بِما كانَ بَينَنا","لَقَد كانَ مِنها بَعضُ ما كُنتُ أَرهَبُ",7,"ب",1,0],["فَلَو عَلِمَ القَتيلُ وَأَيُّ عِلمٍ","لِمَيتٍ مِن وَراءِ التُربِ مودِ",8,"د",1,0],["فَلَو عَلِمَ العِلمَ المُنافِسُ في الَّذي","تَرَكتُم مِنَ الدُنيا لَهُ لَم يُنافَسِ",9,"س",1,0],["فَلَو عَقَلتُ لَأَعدَدتُ الجِهازَ لِما","بَعدَ الرَحيلِ بِها ما دامَ بي رَمَقُ",10,"ق",1,0],["فَلَو عَلا بِكَ أَقوامٌ مَناكِبَهُم","حَثّوا بِنَعشِكَ إِسراعاً بِأَقدامِ",11,"م",1,0],["فلو عاينَ الأمرَ حلَّ الجوادَ","وشدّ الحزامَ وسلّ الحساما",12,"م",2,0],["فلو عُوِّضَ المرءُ منها الصِّبا","لما رَضِيَتْ نَفْسهُ بالعِوض",13,"ض",1,0],["فَلَو عَصَرتَ الصَخرَ صارَ ماءَ","مِن لَيلَةٍ بِتنا بِها لَيلاءَ",14,"ا",2,0],["فلوْ عِزّةٌ أنْطَقَتْ مُلحَداً","لأنْطَقَ مُلحَدَها ما يَرَى",15,"ا",1,0],["فَلَو عَمَّيتَ عَنها بِاِسمِ أُخرى","عَلِمنا كُلَّنا مَن أَنتَ عانِ",16,"ن",1,0],["فَلَوْ عَلِمَ الإِنْسَانُ حَالَةَ نَفْسِهِ","كَفَاهُ وَلَكِنَّ ابْنَ آدَمَ أَخْرَقُ",17,"ق",1,0],["فَلَوْ عَلِمَ الإِنْسَانُ مَا هُوَ كَائِنٌ","لَمَا نَامَ سُمَّارٌ وَلا هَبَّ هَاجِعُ",18,"ع",1,0],["فَلو عَذُبت كُل البُحور لَما اِرتَضَت","فَضائِلُهُ تِلكَ البُحور سَواقيا",19,"ي",2,0],["فَلو عَرضت مِنها لرضوان نَفحة","لَما خَطَرت يَوماً بِفكرَتِهِ الخُلد",20,"د",1,0],["فلو عاش رَسْطالِيسُ كان له بها","غرامٌ وقلبٌ دائم الفكرِ تَوّاق",21,"ق",1,0],["فَلَو عَمِلوا بِالدينِ كانوا بِحكمهِ","أَشدَّ الوَرى زُهداً وأكثرهم فقرا",22,"ر",2,0],["فَلو عبدَ اللَّه الفَتى ألف حجّةٍ","وَلَم يعصهِ في أمره قدر ذرّة",23,"ه",1,0],["فلو عاتبته يوما","لزاد عناده العتب",24,"ب",1,0],["فلو عاينَ الْمَلْكُ العزيزُ مَبِيتَنا","لخطبٍ دَهتَنْا بالفَظِيعِ كَلاكِله",25,"ل",2,0],["فلوْ عابدُونَ الشمس والنار أبصَروا","أشعتَهُ لأغرتهُمْ منه معبُودُ",26,"د",1,0],["فَلَو عايَنتَنا وَبَني كِلابٍ","سَمِعتَ لَنا بِعَقوَتِهِم زَئيرا",27,"ر",2,0],["فَلَوْ عَقَلْنَا عقَلنا عَنهُ ألسُننا","لكِنّها سُنَةٌ في شِرْعَة الأدبِ",28,"ب",1,0],["فَلَو عِشتَ وَطَوَّفتَ","مِنَ الغَربِ إِلى الشَرقِ",29,"ق",1,0],["فلَو عايَنتَه يَرنُو إليها","عرَفتَ الفرقَ بينَ الصَّيقَلَينِ",30,"ن",1,0],["فَلَو عَلِمَ اللَهُ الجِبالَ ظَلَمنَهُ","أَتاهُ بِأَمراسِ الجِبالِ يَقودُها",31,"د",3,0],["فلو عاش الموفق خلف عام","ولم يعرف مقالاً في الفعال",32,"ل",1,0],["فلو علم العبد عقبى الجفا","سعى في اكتساب الجفا واجتلب",33,"ب",1,0],["فلو عُرِضَ الصَّوابُ إذَنْ عليهم","بحالٍ أَعْرَضوا عنه عنادا",34,"د",2,0],["فلو عدا الكرم الوصوف منه يدا","لما استعدّ به يوما ولا وصفا",35,"ف",2,0],["فَلَوْ عَلِمَ البَدْرُ عَمَّ السَّماءَ","أَوِ البَحْرُ جَلَّلَ وَجْهَ الصَّعِيدِ",36,"د",1,0],["فلو عاش في الدنيا عليها معمراً","لعاش بها الطهر النبي محمد",37,"د",1,0],["فلو علمتم به قرت عيونكمو","مذ أنزلوا الكل فيما كان تنزيلا",38,"ل",2,0],["فلو عاد الزمان فتىً","وشبّ لكم على الهَرَمِ",39,"م",1,0],["فلو علِقتُ بجناحِ نهضةٍ","حوَّمَ بي عليك سعيٌ مبتدَرْ",40,"ر",1,0],["فلو عرضوا جمالك لابتياع","لصبح سوق غيرك في كساد",41,"د",1,0],["فلو عشت يوما كنت أحسب بعده","طرائق ليس بعدي",42,"ي",1,1],["فَلَو عَدا الكَرمُ المَوصوفُ راحَتَهُ","عَن أَن يُجاوِزها لَم يُكرم الكَرَمُ",43,"م",1,0],["فلو عن رداكَ سألنهاهُمُ","أحالَ الحضور على الغُيَّبِ",44,"ب",1,0],["فلو عرفوا ما بهم من فناً","لفازوا وكان ثبوت القدم",45,"م",1,0],["فلو علموا أن الذي في عقولهم","هو الخلق بل والحق في حسهم مجلي",46,"ل",2,0],["فلو عرتني جبال الثلج لم ترني","أقول: أجحف هذا البرد بي وأسا",47,"س",2,0],["فلو عرف الصوابَ التركُ قومي","لما احتقروا له عملاً وقدرا",48,"ر",2,0],["فلو علمَ الورى مجهولَ أمري","لنادوا يا صريعَ المقلتينِ",49,"ن",1,0],["فَلَو عَلا المعرب اليَعبوب ثمَّ عَدا","لَفَرَّ جيشَ الأَعادي مِنهُ وَاِنهَزَما",50,"م",2,0],["فَلَو عَلِمَ النّجومُ مُصاغَ نَظمي","بِتَمْداحي لِذاتِكَ مع نِثاري",51,"ر",2,0],["فلو عبدوها دون نارهم انتحوا","لهم عُذُراً بين الأنام طويلا",52,"ل",2,0],["فلو علمتمْ بيَ يا سادتي","لنا لكم مِنْ ذاك شغْل كثير",53,"ر",1,0],["فلو عدلوا اختصروا لوعتي","وثقل غرامي اختصار الخصورِ",54,"ر",1,0],["فلو على أكمة دارت لأبصرها","في الكون وانكشفت عنه العمايات",55,"ت",1,0],["فَلَو عادَ جفني مَرة لِمَنامه","لَكُنت إِذا زارَ المَنام أَزور",56,"ر",1,0],["فلو عاش كسرى لهذا الزمان","أطاع وألقى إليك القياد",57,"د",1,0],["فلو عاينتنا عاين","تنا في جنةِ الخُلدِ",58,"د",1,0],["فلو عادَ للدنيا بشخصك عائدٌ","لأبصرتَ فيها ما يُسرُّ ويعجب",59,"ب",1,0],["فَلَو عَلِمَ الناسُ بِالحالَتَينِ","لَما لَقَّبوني إِلّا النَتيفا",60,"ف",2,0],["فلَو عرَضَت يوماً لِراهبِ بيعَةٍ","حليمٍ على عاداتهِ مُتَحَرِّجِ",61,"ج",1,0],["فلو عرفوا إجابته إلى ما","تؤدي في القيامة من حروب",62,"ب",1,1],["فلو علمتم بما في الوصل كرمٍ","جودُ بروح لكم منهنَّ في رغبِ",63,"ب",1,0],["فلو عدلت عند الإلهِ بأسرِها","قلامةَ ظفرٍ حازها دونَ من ظلم",64,"م",1,0],["فَلَو عددتُ الَّذين خانوا","فيهم عهودي أطلتُ عَدّي",65,"ي",1,0],["فلو علمنا بأن النصح يردعكم","عن الغرور نظمنا منه ديوانا",66,"ن",2,0],["فَلَو عُكِسَ الأَمرُ مِثلَ الَّذي","فَعَلتَ لَكانَ سَليمَ النَظَر",67,"ر",1,0],["فلو علمتَ الذي علمنا","رأيتَه كله عطاء",68,"ا",2,0],["فلو عامل الله العبادَ بعدله","لأهلكهم والله من ذاك أفضل",69,"ل",1,0],["فلو عرضت على من كان يجهله","عبادة الله في الأشياء ما عبدا",70,"د",2,0],["فلو علمتُ به ما","ذكرتُ بيعاً لأنسي",71,"س",2,0],["فلو عاش الندى لبكاك حزناً","ولكني أراه هو الفقيد",72,"د",1,0],["فَلَو عَلِقَت نَفسي بِغَيرِكَ لَم تَكُن","تُؤمِّلُهُ إِلّا لِيَشفَعَ في الحَشرِ",73,"ر",1,0],["فلو علم القِرطاس مَا في ضميره","شكى وبكى لكنّه غير عالم",74,"م",1,0],["فلو عدنا إلى الإسلام نرعى","عقائده لعادَ لنا الهناءُ",75,"ا",2,0],["فلو عنك ألقين المقانع أشرقت","لخدك أنوار لهن وقود",76,"د",1,0],["فلو عددت في الكون بدأ بدائع","لكان به ختم لذاك التعدد",77,"د",1,0],["فلو عند غسان السليطي عرّست","رغا قرن منها وكاس عقير",78,"ر",1,0],["فلو عرف الخمار أسرار سكرها","لعاف الطلا والكرم والحان والعقلا",79,"ل",2,0],["فلو عرف البدر من جاءه","لأخفى محاسنه واستتر",80,"ر",1,0],["فلو عرضت الريق في سوقها","لا بتيعت التفلة بالبدره",81,"ر",2,0],["فلوعتي من غزال","وودعتي من غزاله",82,"ل",2,0],["فلو عدل المقدار أعطاك حكمه","وشاطرك السلطان عن قسمة عدل",83,"ل",1,0],["فلو عرف الكميُّ مجال علمٍ","لزاحمنا عليه باليماني",84,"ن",2,0],["فلو علم المُسلمُ ما تَمنّى","إذاً حيّاكَ بالأسَلِ الطّوالِ",85,"ل",1,0],["فلوْ علِمَ العُذّالُ كُنْهَ محبّتي","لأقصرَ عن عَذْلي وُشاةٌ ولُوَّمُ",86,"م",1,0],["فلو عاينت عيناك بالقصر يومهم","ومصرعهم لم تكتحل برقاد",87,"د",1,0],["فلو عُدَّت كرام الناس يوماً","لقيل لهُ الكريمُ ابن الكريمِ",88,"م",1,0],["فلو علمت تلك الصفائح أودرت","بها حل ركن للعلى ومقام",89,"م",1,0],["فلو عقلنا بدنيانا التي ذهبت","لنبأتنا بأن الكل ينهار",90,"ر",1,0],["فَلو عدّوا المَكارم أَنصفوني","وَقام دَليلُنا وَبِهِ الكِفايه",91,"ا",3,0],["فلو عرضت للبحر لن يلفظ الدّرّا","ولو عارضت هاروت لم ينفث السحرا",92,"ر",2,0],["فلو عبد الإنسان يوماً ليمنه","لعدك معبوداً مصلٍ وصائم",93,"م",1,0],["فَلَوُ عَلِمَ المُؤَرِّخُ ما","تَغالى فِي الَّذي دَوَّنْ",94,"ن",1,0],["فَلَو عَلِمَت سُلَيمى عِلمَ مِثلي","غَداةَ الرَوعِ واصَلَتِ الكِراما",95,"م",2,0],["فلَو عُدَّ إِغرِيقٌ وَطُروَادَةٌ عَلى","تَصافٍ وَكلٌّ قَومَهُ أَمَّ جَاريا",96,"ي",2,0],["فَلو عَلَيهِ وَجَبَ الصَّلاَحُ","سُبحَانَهُ عَمَّ الوَرَى الفَلاَحُ",97,"ح",1,0],["فلوعة الحزن في اضطرام","ودمعة الخوف في انهمال",98,"ل",1,0],["فَلَو عقب الهَوى قَلبي وَقالَت","اِذن روحي أَروح لقال روحي",99,"ح",2,0],["فلو على قدر حبِّ المرءِ تؤثره","ما كان إيثارُ خلقٍ فوقَ إيثاري",100,"ر",2,0],["فَلَو عَلمَت روحي بِماذا يُصيبُها","لَمَا بَدَّلت خلقاً سواكُم وإِنَّما",101,"م",2,0],["فلو علموا يا صاحبَي بما بنا","لما رقدوا ليلاً وجَفني يَقظان",102,"ن",1,0],["فلو علمت ملحودةُ القبر من غدا","إليها ومن أهدى إليها سريرُها",103,"ر",3,0],["فلو علمت أسد الشرى سطواتهم","لما حملتها أرجلُ ومفاصِلُ",104,"ل",1,0],["فلو عرفوا حق الولاء لحيدر","لما منعوا عنه مواليه لا ولا",105,"ل",2,0],["فلو عاذل البغاث بهم لامسى","ومخلبه ينوش النسر نسرا",106,"ر",2,0],["فلو عرضت على قوم جواهره","لما حلا احد منهم بها ثمنا",107,"ن",2,0],["فلو عاد حبِّي بعد نأيٍ ضممتُهُ","ودمعي على أيّامِ هجري يسيلُ",108,"ل",1,0],["فلو علمتِ بحالي حينما انقشعت","ْسُحْبُ الأماني وبِتُّ الدهرَ ظمآنا",109,"ن",2,0],["فَلَوْعَتُهَا الشَّوْقُ إنْ زَارَ طَيْفٌ","وَغَفْوَتُهَا المُنْتَهَاةُ حَيَاةُ",110,"ه",1,0],["فلو عدت شؤمها الليمن كان قرى","ضيف ألمّ برأسي غير محتشم",111,"م",1,0],["فلو عدتم عاد الفؤاد لجسمه","وأنى لكم بالعود والمنزل المعد",112,"د",1,0],["فَلَوْ عَرَفُوا خَرِيفَ العُمْرِ صِدْقًا","لأَجْرُوا الدَّمْعَ خَوْفًا وَارْتِقَابَا",113,"ب",2,0],["فلوعة الشوق جمر","بها تناءى سهادي",114,"د",2,0],["فلو عدت حيا كي ترى يوم صفدت","أسارى وقد ركبن بالسير اجمالا",115,"ل",2,0],["فَلَوْ عادَلَتْهُ الأَرْضُ وَزْناً وَأَهْلُها","لَما عادَلُوا فِي الوَزْنِ مِنْ كَفِّهِ ظُفْرا",116,"ر",2,0],["فلوعة الحب نار في الفؤاد غدت","تراوح الذات في روحي فتضطرم ؟",117,"م",1,0],["فلو علم المساء لهيب قلبي","لطول الوجد لاشتعل المساء",118,"ا",2,0],["فلو عشق الأنام لما أحاطوا","بعشقي أو يباروني اصطبارا",119,"ر",2,0]]}