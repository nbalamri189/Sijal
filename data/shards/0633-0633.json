{"poems":[[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""]],"verses":[["سُسْتَ الأمورَ وبَيْتُ مُلْكِكَ قدْ غَدا","صِفْراً وتاهَ الخَلْقُ أيَّ مَتاهِ",0,"ه",1,0],["سُسْتُهُمْ لسْتُ أبتَغي غيْرَ حق ال","لاهِ أو قوْمَتي بحقِّ الجِوارِ",1,"ر",1,0],["سُسْتَ الأنام برأي مشتمِلٍ","بالحزمِ لا سأمٌ ولا مَلَلُ",2,"ل",1,0],["سُستَ الخِلافَةَ إِشرافاً وَحَيِّطَةً","وَذُدتَ عَن حَقِّها بِالسَيفِ وَالقَلَمِ",3,"م",1,0],["سُسْتَ مَنْ سُسْتَ فِي الوَزَارَةِ بِالحَقِّ","وَوَفَّيْتَ مَا اقْتَضَتْ مِنْ خَلاَقِ",4,"ق",1,0],["سِسِيلُ هَلْ تَدْرِينَ تِلْكَ الَّتِي","أَذْكُرُهَا أَنْتِ الَّتِي أَذْكُرُ",5,"ر",1,0],["سُسْتَ القُلوبَ فنلْتَ أَكْرمَ وُدِّها","وعَرَفْتَ بالإِحْسانِ كيف تُثار",6,"ر",1,0],["سُسْتَ الحوادثَ بالروية جاهداً","وحملتَ أعباءَ الخطوبِ فوادحا",7,"ح",2,0]]}