{"poems":[[79,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[79,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[64,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[47,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[92,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[164,"انهض فطائر سعدك الميمون","https://www.aldiwan.net/poem59011.html","الكامل"],[189,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[239,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[239,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[309,"يهنأ بمولد طه خاتم الرسل","https://www.aldiwan.net/poem56438.html","البسيط"],[420,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[554,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[567,"عنوان مجدك ظاهر وضاح","https://www.aldiwan.net/poem833.html",""]],"verses":[["سُسْتَ الأمورَ وبَيْتُ مُلْكِكَ قدْ غَدا","صِفْراً وتاهَ الخَلْقُ أيَّ مَتاهِ",0,"ه",1,0],["سُسْتُهُمْ لسْتُ أبتَغي غيْرَ حق ال","لاهِ أو قوْمَتي بحقِّ الجِوارِ",1,"ر",1,0],["سُسْتَ الأنام برأي مشتمِلٍ","بالحزمِ لا سأمٌ ولا مَلَلُ",2,"ل",1,0],["سُستَ الخِلافَةَ إِشرافاً وَحَيِّطَةً","وَذُدتَ عَن حَقِّها بِالسَيفِ وَالقَلَمِ",3,"م",1,0],["سُسْتَ مَنْ سُسْتَ فِي الوَزَارَةِ بِالحَقِّ","وَوَفَّيْتَ مَا اقْتَضَتْ مِنْ خَلاَقِ",4,"ق",1,0],["سِسِيلُ هَلْ تَدْرِينَ تِلْكَ الَّتِي","أَذْكُرُهَا أَنْتِ الَّتِي أَذْكُرُ",5,"ر",1,0],["سُسْتَ القُلوبَ فنلْتَ أَكْرمَ وُدِّها","وعَرَفْتَ بالإِحْسانِ كيف تُثار",6,"ر",1,0],["سست الرعية بالتدبير متئدا","بالحق معتمدا بالله معتصما",7,"م",2,0],["سُسْتَ الحوادثَ بالروية جاهداً","وحملتَ أعباءَ الخطوبِ فوادحا",8,"ح",2,0],["سست الأنام سياسة وملكتهم","فالحر عبد والعزيز مهين",9,"ن",1,0],["سُسْتُ الأمور سياسةً بلطافةٍ","فإذا جَفا خَطْبٌ رَمتْه لجَزْلِها",10,"ل",3,0],["سُستَ الأَنامَ بِسيرَةٍ ما سارَها","في الناسِ إِلّا جَدُّكَ المُتَوَكِّلُ",11,"ل",1,0],["سُستَ الرَعايا بِسيرَةٍ لَم يَسِر","في الناسِ إِلّا بِمِثلِها عُمَرُ",12,"ر",1,0],["سُستَ الأنامَ بِعدلٍ يستقيمُ بهِ","طباعُ كلِّ مزاجٍ غير معتدلِ",13,"ل",1,0],["سُسْتَ العراقَ سياسة ملكيَّة","ما ساسها ذو التَّاج نوشروان",14,"ن",1,0],["سُستَ الملوكَ وودّ القومُ أنّهُمُ","ساسوا وما بلغوا تلك المُنى السُّوَقا",15,"ق",2,0],["سست الأمور بحكمةٍ ورويةٍ","فعنى لك السرحان والتمساح",16,"ح",1,0]]}