{"poems":[[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[160,"انهض فطائر سعدك الميمون","https://www.aldiwan.net/poem59011.html","الكامل"],[185,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[235,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[235,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[305,"يهنأ بمولد طه خاتم الرسل","https://www.aldiwan.net/poem56438.html","البسيط"],[416,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[551,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[564,"عنوان مجدك ظاهر وضاح","https://www.aldiwan.net/poem833.html",""]],"verses":[["سُسْتَ الأمورَ وبَيْتُ مُلْكِكَ قدْ غَدا","صِفْراً وتاهَ الخَلْقُ أيَّ مَتاهِ",0,"ه",1,0],["سُسْتُهُمْ لسْتُ أبتَغي غيْرَ حق ال","لاهِ أو قوْمَتي بحقِّ الجِوارِ",1,"ر",1,0],["سُسْتَ الأنام برأي مشتمِلٍ","بالحزمِ لا سأمٌ ولا مَلَلُ",2,"ل",1,0],["سُستَ الخِلافَةَ إِشرافاً وَحَيِّطَةً","وَذُدتَ عَن حَقِّها بِالسَيفِ وَالقَلَمِ",3,"م",1,0],["سُسْتَ مَنْ سُسْتَ فِي الوَزَارَةِ بِالحَقِّ","وَوَفَّيْتَ مَا اقْتَضَتْ مِنْ خَلاَقِ",4,"ق",1,0],["سِسِيلُ هَلْ تَدْرِينَ تِلْكَ الَّتِي","أَذْكُرُهَا أَنْتِ الَّتِي أَذْكُرُ",5,"ر",1,0],["سُسْتَ القُلوبَ فنلْتَ أَكْرمَ وُدِّها","وعَرَفْتَ بالإِحْسانِ كيف تُثار",6,"ر",1,0],["سُسْتَ الحوادثَ بالروية جاهداً","وحملتَ أعباءَ الخطوبِ فوادحا",7,"ح",2,0],["سست الأنام سياسة وملكتهم","فالحر عبد والعزيز مهين",8,"ن",1,0],["سُسْتُ الأمور سياسةً بلطافةٍ","فإذا جَفا خَطْبٌ رَمتْه لجَزْلِها",9,"ل",3,0],["سُستَ الأَنامَ بِسيرَةٍ ما سارَها","في الناسِ إِلّا جَدُّكَ المُتَوَكِّلُ",10,"ل",1,0],["سُستَ الرَعايا بِسيرَةٍ لَم يَسِر","في الناسِ إِلّا بِمِثلِها عُمَرُ",11,"ر",1,0],["سُستَ الأنامَ بِعدلٍ يستقيمُ بهِ","طباعُ كلِّ مزاجٍ غير معتدلِ",12,"ل",1,0],["سُسْتَ العراقَ سياسة ملكيَّة","ما ساسها ذو التَّاج نوشروان",13,"ن",1,0],["سُستَ الملوكَ وودّ القومُ أنّهُمُ","ساسوا وما بلغوا تلك المُنى السُّوَقا",14,"ق",2,0],["سست الأمور بحكمةٍ ورويةٍ","فعنى لك السرحان والتمساح",15,"ح",1,0]]}