{"poems":[[79,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[79,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[64,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[47,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[92,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[164,"انهض فطائر سعدك الميمون","https://www.aldiwan.net/poem59011.html","الكامل"],[189,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[240,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[310,"يهنأ بمولد طه خاتم الرسل","https://www.aldiwan.net/poem56438.html","البسيط"],[422,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[556,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[569,"عنوان مجدك ظاهر وضاح","https://www.aldiwan.net/poem833.html",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122667","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122813","الرمل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82508","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53160","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53108","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67942","الرجز"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120608","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100828","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100806","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100794","الخفيف"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145129","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91200","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199110","الكامل"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[402,"وأقبل الأمن بآلآئه","https://www.poetsgate.com/ViewPoem.aspx?id=36336",""],[5829,"تطريز الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=210922",""],[6056,"الأ لفية ))(( المنبثقة","https://www.poetsgate.com/ViewPoem.aspx?id=130517",""],[6115,"حطيت بيني ونقال الحكي عازل","https://www.poetsgate.com/ViewPoem.aspx?id=180903",""]],"verses":[["سُسْتَ الأمورَ وبَيْتُ مُلْكِكَ قدْ غَدا","صِفْراً وتاهَ الخَلْقُ أيَّ مَتاهِ",0,"ه",1,0],["سُسْتُهُمْ لسْتُ أبتَغي غيْرَ حق ال","لاهِ أو قوْمَتي بحقِّ الجِوارِ",1,"ر",1,0],["سُسْتَ الأنام برأي مشتمِلٍ","بالحزمِ لا سأمٌ ولا مَلَلُ",2,"ل",1,0],["سُستَ الخِلافَةَ إِشرافاً وَحَيِّطَةً","وَذُدتَ عَن حَقِّها بِالسَيفِ وَالقَلَمِ",3,"م",1,0],["سُسْتَ مَنْ سُسْتَ فِي الوَزَارَةِ بِالحَقِّ","وَوَفَّيْتَ مَا اقْتَضَتْ مِنْ خَلاَقِ",4,"ق",1,0],["سِسِيلُ هَلْ تَدْرِينَ تِلْكَ الَّتِي","أَذْكُرُهَا أَنْتِ الَّتِي أَذْكُرُ",5,"ر",1,0],["سُسْتَ القُلوبَ فنلْتَ أَكْرمَ وُدِّها","وعَرَفْتَ بالإِحْسانِ كيف تُثار",6,"ر",1,0],["سست الرعية بالتدبير متئدا","بالحق معتمدا بالله معتصما",7,"م",2,0],["سُسْتَ الحوادثَ بالروية جاهداً","وحملتَ أعباءَ الخطوبِ فوادحا",8,"ح",2,0],["سست الأنام سياسة وملكتهم","فالحر عبد والعزيز مهين",9,"ن",1,0],["سُسْتُ الأمور سياسةً بلطافةٍ","فإذا جَفا خَطْبٌ رَمتْه لجَزْلِها",10,"ل",3,0],["سُستَ الأَنامَ بِسيرَةٍ ما سارَها","في الناسِ إِلّا جَدُّكَ المُتَوَكِّلُ",11,"ل",1,0],["سُستَ الرَعايا بِسيرَةٍ لَم يَسِر","في الناسِ إِلّا بِمِثلِها عُمَرُ",12,"ر",1,0],["سُستَ الأنامَ بِعدلٍ يستقيمُ بهِ","طباعُ كلِّ مزاجٍ غير معتدلِ",13,"ل",1,0],["سُسْتَ العراقَ سياسة ملكيَّة","ما ساسها ذو التَّاج نوشروان",14,"ن",1,0],["سُستَ الملوكَ وودّ القومُ أنّهُمُ","ساسوا وما بلغوا تلك المُنى السُّوَقا",15,"ق",2,0],["سست الأمور بحكمةٍ ورويةٍ","فعنى لك السرحان والتمساح",16,"ح",1,0],["سُستَ أهل الزَّمانِ بالمَنعِ والشَّر","عِ فَدانَ الأنامُ منعاً وشَرعا",17,"ع",2,0],["سُستَ مِن مِصرٍ إلَى الخيفِ إلَى","شَرقِ صَنعاءَ إلَى غَربِ عَدَن",18,"ن",1,0],["سُستَ الخلافة إِذ نَصَبت لَها","فَحميتها وَمنعتَ جانِبَها",19,"ب",3,0],["سستم عباد الله خير سياسة","رَضِيَ الإله بهديها والمرسل",20,"ل",1,0],["سُسْتَ العباد برأفة قرنت","بِسَطَا فعمَّ الأمن والحذر",21,"ر",1,0],["سسان وسسان كذا","كان على الشبابِ خَلتانِ",22,"ن",1,0],["سُستَ الأمور بسيرة مرضية","عدل ورأي للرشاد موفق",23,"ق",1,1],["سست البلاد وقوما ان دعوتهمُ","جاؤا اليك زرافات على عجل",24,"ل",1,0],["سستَ العباد بأمرٍ ليس ينقصه","ناهٍ تحقق ان الامر مفعول",25,"ل",1,0],["سُست بالعدل هذه الارض حتى","صرت فيها ابرَّ مولىً وارحم",26,"م",1,0],["سستم الناس بعدل شامل","فتساوى الناس في عيش رغيد",27,"د",1,0],["سست السياسة وَهِيَ أَعضلُ علةٍ","طالَت يَزيدَ الجرحِ مِنها المَرهم",28,"م",1,0],["سست البلاد بحكمة وروية","وفعال بر زحزحت عنا العنى",29,"ن",2,0],["سسلوك طريق العابدين بعرفاني","يلذ بأرواح غذين بإيمان",30,"ن",1,1],["سست البلاد بحكمة ودراية","وصفعت كل مناويء وعنيد",31,"د",1,0],["سسيل هل تردين تلك التي","أذكرها أنت التي أذكر",32,"ر",1,0],["س _ سبحان من أسرى بعبد ليلة","فعلا السماءً، فشاهدٌ وأمين",33,"ن",1,0],["س/ سلامي سلم مسالم سلوم إسلام سلمنّاه","سليم سلمه لسلمي سلامه لي سلاميني",34,"ن",2,0],["س- سوالفه دوم بين الجد والهازل","ويبث نار الخصيمه بين الاخواني",35,"ن",2,0]]}