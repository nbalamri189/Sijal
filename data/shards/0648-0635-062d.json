رغم الحسود مسالمي","https://www.aldiwan.net/poem53996.html","الطويل"],[417,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[417,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[417,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[417,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[433,"وصحبة قوم لو يقاس أجلهم","https://www.aldiwan.net/poem12441.html","الطويل"],[433,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[442,"كتابك يا علي زار غبا","https://www.aldiwan.net/poem14295.html","الوافر"],[442,"لولا مخافة بيع قائد الغبن","https://www.aldiwan.net/poem14431.html","البسيط"],[453,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"],[459,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[459,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[459,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[459,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[462,"مالي وللدنيا ويا غفلتي","https://www.aldiwan.net/poem15383.html","السريع"],[465,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[480,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[494,"من منصفي من محكم الكتاب","https://www.aldiwan.net/poem67302.html","الرجز"],[501,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[501,"لنا رفرف من دونه الفلك الأعلى","https://www.aldiwan.net/poem37806.html","الطويل"],[501,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[501,"سقط الفحول عن الأرائك","https://www.aldiwan.net/poem38102.html","مجزوء الكامل"],[506,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[516,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[516,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[516,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[528,"أكل بناءٍ أنت بانيه معجز","https://www.aldiwan.net/poem45542.html","الطويل"],[530,"يجاهرني العدو بكل نكر","https://www.aldiwan.net/poem37467.html","الوافر"],[552,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[552,"لعنة الله على من","https://www.aldiwan.net/poem47303.html","مجزوء الرمل"],[552,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[552,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[552,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[559,"فؤادي له في رتبة الحب ما نوى","https://www.aldiwan.net/poem34088.html","الطويل"],[568,"لصديق لنا صديقة سوء","https://www.aldiwan.net/poem69465.html","الخفيف"]],"verses":[["وَصَحِبتُ أَيّامَ الهَوى فَرَأَيتُها","سَرحاً حَمَتهُ عَواذِلٌ وَعَواذِرُ",0,"ر",1,0],["وَصَحايِفٍ فيها الأَراقِمُ كُمَّنٌ","مَرهوبَةُ الإِصدارِ وَالإيرادِ",1,"د",1,0],["وَصُحبَةِ كُلَّ غُلامٍ عَلَي","هِ مِن سِمَةِ العِزِّ حُسنٌ وَطيبُ",2,"ب",1,0],["وَصَحبي إِذا أَغْشَوْا مَطيَّهُمُ الرُّبا","دَعا بِالَّذي تَحثوهُ مِن تُربِها الوَهدُ",3,"د",1,0],["وصَحْبي وَجيهِيٌّ ورُمْحٌ وصارِمٌ","ودِرْعٌ وصَبْري والخَفاجِي سادِسُ",4,"س",1,0],["وَصَحابَةٍ شُمَّ الأُنوفِ بَعَثتُهُم","لَيلاً وَقَد مالَ الكَرى بِطُلاها",5,"ا",3,0],["وَصَحيفَةٍ تَحكي الضَمي","رَ مَليحَةٍ نَغَماتُها",6,"ت",3,1],["وصِحْتُ بِرَكْبِ العَدْلِ لا تَنْوِ خَطْرَةً","عَلَى حُسْنِ عَهْدِي فَهْوَ توأَمُ إِيمَانِي",7,"ن",2,0],["وصَحِبْتَ جَزّاراً للَحْمٍ طيّبٍ","وخَدَمْتَ غيرَ مُقَصِّرٍ دَجّاجا",8,"ج",2,0],["وَصَحراءَ سِختيتٍ يَحارُ بِها القَطا","وَيرتَدُّ فيها الطَرفُ أَو يَتَقَضَّبُ",9,"ب",1,0],["وَصَحِبنا مِن آلِ جَفنَةَ أَملا","كاً كِراماً بِالشامِ ذاتِ الرَفيفِ",10,"ف",1,0],["وَصُحفٌ تَطِنُّ طَنينَ الذُبابِ","وَأُخرى تَشُنُّ عَلى الأَقرَبِ",11,"ب",1,0],["وَصُحبَةُ قَومٍ كَالمَصابيحِ كُلُّهُم","إِذا هُزَّ لِلخَطبِ المُلِمِّ حُسامُ",12,"م",1,0],["وصحبه الأبرار في ال","عهد الجديد الزاهر",13,"ر",1,0],["وَصَحِيحُ اليَقِينِ لَوْ صَلَى النَّا","ر عَذَاباً مَا اعْتَلَّ مِنْهُ اليَقِينُ",14,"ن",1,0],["وَصَحَّ فِي كُلِّ نَفْسٍ","أَنَّ الْحِجَى غَيْرُ عَاصِمْ",15,"م",1,0],["وَصَحبي عَلى أَكوارِ شُدقِ رَمَت بِها","طَرآئفُ حاجاتِ الفَتى وَتَليدُها",16,"د",3,0],["وَصُحمٍ صِيامٍ بَينَ صَمدٍ وَرَجلَةٍ","وَبَيضٍ تُؤامٍ بَينَ مَيثٍ وَمِذنَبِ",17,"ب",1,0],["وَصِحتُ بِالأُسودِ كَالخُطّافِ","لَيسَ بِأَبيَضٍ وَلا غِطرافِ",18,"ف",1,0],["وصحبٌ إن غروا بملام مثلي","فربَّ أصاحبٍ بالإثم باؤا",19,"ا",2,0],["وصحبتمو ملكاً فما خدعت","يمناهُ خدْعَ الآل بالصحب",20,"ب",1,0],["وصححت أخبارَ الندى فرويتها","عوَاليَ تروى كلّ وقتٍ وتكتب",21,"ب",1,0],["وصحبةٌ ما تأملنا فضائلها","إلاَّ روينا حديثَ الفضل عن عمر",22,"ر",1,0],["وصحّت أسانيد السيادة والنهى","عن الأذن عن عين البصير عن الفم",23,"م",1,0],["وصحَّ حمى الشمال بيمن رأيٍ","أنالَ من السعادةِ ما أنالا",24,"ل",2,0],["وصحابةٍ ناكوا القيانَ تَظَرُّفاً","يوماً فنِكْتُ زَوامِراً ورقائبا",25,"ب",2,1],["وصحنُ خدٍّ حريقُهُ ضَرِمٌ","يقذف في القلب دائماً شرره",26,"ر",2,0],["وصحبةُ المعتِم من شأنِه","وليس منه صحبةُ المغلس",27,"س",1,0],["وَصَحِبتُهُنَّ فَما اِستَفَدتُ سِوى الأَسى","ما يُستَفادُ مِنَ الغَواني يُتعِبُ",28,"ب",1,0],["وَصُحُبٍ أَخلاقُهُم كَالمُنى","يَروُّنَ عَنكَ الحِكَمَ الغالِيات",29,"ت",1,0],["وَصَحابَةٌ مِثلُ الرِياضِ شَذىً","وَصَواحِبٌ كَوُرودِها عَدَدا",30,"د",2,0],["وَصِحابٍ بِذِكرِهِم","تَفخَرُ الكُتُبُ وَالسِيَر",31,"ر",1,0],["وصحت اسمعه شعري واعلمه","اني كما هو شاد ماله وزر",32,"ر",1,0],["وصحبناه كالغبار فلا رح","لا شددنا ولا ركابا زممنا",33,"ن",2,0],["وَصَحِبناهُ كَالغُبارِ فَلا رَج","لاً شَدَدنا وَلا رِكاباً زَمَمنا",34,"ن",2,0],["وَصَحَوا مِن مُنَوِّمٍ","وَأَفاقوا مِنَ الحَذَر",35,"ر",1,0],["وَصُحبَةَ قَومٍ يَذبَحونَ قَنيصَهُم","بِفَضلَةِ ما قَد كَسَّروا في المَفارِقِ",36,"ق",1,0],["وصِحْ بندامايَ والمسمعين","وأحورَ كالبدر ليلَ التمامِ",37,"م",1,0],["وصحِبتُ بعد المُرْدِ وال","فتيانِ مشيخةً كِراما",38,"م",2,0],["وصَحبٍ كجُمَّاعِ الثُّرَيَّا تأَلُّفَاً","مغاويرَ نُجْلِ الطعنِ هُدْلِ الضرائبِ",39,"ب",1,0],["وَصَحيحٌ لَم يَقُم نَخّاسُهُ","وَتَبَرّا مِن عَشاً أَو مِن سَرَق",40,"ق",1,0],["وَصِحَّتُكَ الَّتي قامَت لَدَيهِم","مَقامَ الفَوزِ بِالعُمرِ الطَويلِ",41,"ل",1,0],["وَصَحيحُ السَماحِ بَينَ أُناسٍ","في سَجاياهُمُ عَلَينا اِعتِلالُ",42,"ل",1,0],["وَصِحابُكَ الكُتّابُ لَم يَكُ عِندَهُم","نَقضٌ بِصالِحَةٍ وَلا إِبرامُ",43,"م",1,0],["وصَحبِتُ أيامَ المَشيبِ بِجُودِه","مُبيْضَّةً فذمَمتُ أيامَ الصَّبا",44,"ب",2,0],["وَصَحبُهُ مَن لَهُم فَضلٌ إِذا اِفتَخَروا","ما إِن يُقَصِّرُ عَن غاياتِ فَضلِهِمِ",45,"م",1,0],["وَصَحِبتُ قَوماً لَستُ مِن نَظَرائِهِم","فَكَأَنَّني في الطَرسِ سَطرٌ مُلحَقُ",46,"ق",1,0],["وَصَحبِكَ النُجُبِ الصيدِ الَّذينَ جَرَوا","إِلى المَناقِبِ مِن تالٍ وَمُستَبِقِ",47,"ق",1,0],["وَصَحبُكَ خَيرُ الصَحبِ وَالغُرَرُ الَّتي","بِها أَمِنَت مِن كُلِّ أَرضٍ ثُغورُها",48,"ر",3,0],["وَصُحبَةِ ماجِدٍ كَالنَجمِ هادٍ","يُسِرُّ النَطشَ حِلماً وَهوَ هادِن",49,"ن",1,0],["وَصَحيفَةٌ ضَمَّنتُها بِأَمانَةٍ","عِندَ الرَحيلِ إِلَيكِ أُمَّ الهَيثَمِ",50,"م",1,0],["وَصَحماءَ أَشباهِ الحَزابِيِّ ما يُرى","بِها سارِبٌ غَيرَ القَطا المُتَراطِنِ",51,"ن",1,0],["وَصَحِيحٌ بأَنَّني كُنتُ قَدْ مِتُّ","وأحْيانِيَ جُودُ هذَا الوَزِيرِ",52,"ر",1,0],["وَصَحَوتُ إِلّا مِن لِقاءِ مُحدِّثٍ","حَسَنِ الحَديثِ يَزيدُني تَعليما",53,"م",2,0],["وَصَحوتُ مِن سُكرٍ وَكُنتُ مُوَكَّلاً","أَرعى الحَمامَةَ وَالغُرابَ الأَبيَضا",54,"ض",2,0],["وَصَحيحُ القَلبِ مِن داءِ الهَوى","لَو بِهِ ما بي مِنَ الحُبِّ عَذر",55,"ر",1,0],["وَصَحا باطِلي وَأَصبَحتُ كَهلاً","لا يُؤاتي أَمثالَها أَمثالي",56,"ل",2,0],["وصَحائحٍ مَرضى العُيونِ شَحائحٍ","بِيضِ الوجُوهِ نَواعمِ الأَبْشارِ",57,"ر",1,1],["وصحوتُ من خَبَلٍ وبي مما أرى","إطراقُ مكتئبٍ وصمتُ حزين",58,"ن",1,0],["وصحوتَ من وهْمٍ ومن خَبَلِ","فإذا جراحُك كُلَّهن دَمُ",59,"م",1,0],["وصحارى لا ينتهي الركبُ فيها","عند صخرٍ أو واحةٍ مئنافِ",60,"ف",1,0],["وصحافٍ كتهاويلِ الرؤى","تجد الأنفسُ فيها مُشتهاها",61,"ا",3,0],["وصَحْراءَ مَوْماةٍ يَحارُ بها القَطا","قَطَعْتَ عَلى هَوْلِ الجِنانِ بِمِنْسَرِ",62,"ر",1,0],["وصَحيحٍ أَضحَى يَعُودُ مَريضاً","وهَوَ أَدنَى لِلمَوتِ مِمَّن يَعُودُ",63,"د",1,0],["وَصَحِيفَةٍ مِنْ كُلِّ مَطْلَعِ كَوْكَبٍ","يُزْجَى إِلَيْهَا أَطْرَفُ الأَخْبارِ",64,"ر",1,0],["وَصَحْبُهُ فِي نُخَبِ الشْرَقِ مِنْ","أَهْلِ الحِجِى وَالْعِلْمِ أَصْفَى النُّخَبْ",65,"ب",1,0],["وَصَحْبُهُ وَمُعِينُوهُ الكِرَامُ بَنَوا","لِلْعِلْمِ أَخْلَقَ بُنْيَانٍ بِتوْطِيدِ",66,"د",1,0],["وصحوتي في الواقع الحزين","هل تذكرين الان؟..ذكريني",67,"ن",2,0],["وصحونا فإذا أعناقنا","مثقلات بقيود الأجنبي",68,"ب",2,0],["وصحبي والأهلُ فارقتهم","وكنتُ أراهُم رفاقاً عزينا",69,"ن",2,0],["وصحا الشرق ناشطاً يجبَه الدن","يا وينفي النعاسَ عن أجفانه",70,"ن",2,0],["وصحت يا فتنتي ما تفعلين هنا","البرد يؤذيك عودي لن أعود أنا",71,"ن",2,0],["وَصَحيحٌ لَمْ يَقُمْ نَخَاسُهُ","يَتَبَرّا مِنْ عَشاً، أوْ مِنْ سَرَقْ",72,"ق",1,0],["وَصحت بِكَ الدُنيا فَلَيسَ بِها يَرى","مِن مُسكر إِلّا لِحاظ الخرَّد",73,"د",1,0],["وصحاب المصطفى فاعرف لهم","حقهم تحفظ مما دهما",74,"م",2,0],["وصحبٌ كرامٌ ماجدٌ متسلسلٌ","جوادٌ خِضَمٌّ لوذعيٌّ معظَّما",75,"م",2,0],["وصحبت كلاً لا صحابة قاطع","بل مورداً لوصاله متجسما",76,"م",2,0],["وصحّة الجسم فيها غير خافيةٍ","والعيب والداء مقصورٌ على الحضَر",77,"ر",1,0],["وصحفي بما يهدون من حسناتِهم","ملاء لهم أعمالهم ولي الكتبُ",78,"ب",1,0],["وصحَّ بأَن السيفَ والرمحَ تابعٌ","فمن بعد ما يبدا بها بهما يثنى",79,"ن",2,0],["وصحبةُ أيامٍ مضَتْ وكأنّما","هواجِرُها تُكْسى ظِلالَ الأصائِلِ",80,"ل",1,0],["وصح مزاجه من بعد ريّ","غنيا كان أو لم يحو مالا",81,"ل",2,0],["وَصحبهِ الهداةِ أنجمِ السَما","وَتابِعيهم وَجَميعِ العُلما",82,"م",2,0],["وَصحبَه الأسدَ وأيّ أسدِ","أَكثِر منَ الصلاةِ والسلامِ",82,"م",1,0],["وصحابه الأمجاد أع","ضاء المعاف والمدير",83,"ر",1,0],["وصحيح الحب حبه هدر","كل ما يسطع أن لا يستطيع",84,"ع",1,0],["وصحابي إذا افتقرتُ إليهم","زادنب الأغنياءُ عني فقرا",85,"ر",2,0],["وصحفة الراح اذ يبدو الحبيب ها","خد الصباح وفيه حمرة الشفق",86,"ق",1,0],["وصحت اذ لم اجد سبيلا","اليه يا حسرتي على ما",87,"م",2,0],["وصحب من البيض الثياب تطلّبوا","ودادى فلم يهمم بطردهمو مجدي",88,"د",2,1],["وصححوا هوى ونحو طوى","لأنه فرع ونحو قوى",89