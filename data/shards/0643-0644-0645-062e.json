{"poems":[[55,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[90,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[234,"حبذا طيب يومنا الممطور","https://www.aldiwan.net/poem51090.html","الخفيف"],[422,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[469,"قم نديمي فاسفك دم الزق","https://www.aldiwan.net/poem3306.html","عموديه"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134094","الرمل"],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[6113,"سر الجاذبيه","https://www.poetsgate.com/ViewPoem.aspx?id=120889",""]],"verses":[["كُلُّ مَخنوقٍ عَلى جِرَّتِهِ","خَلَطَ العَجزَ بِشَوكٍ فَاِختَلَط",0,"ط",1,0],["كل مَخّارة إذا حَرَّكت دُفّ","اعها خضخضت به القاموسا",1,"س",2,0],["كل مخطوفة الحَشَا تُضرم الشو","ق بلفظٍ عذبٍ وطَرْف سَحُورِ",2,"ر",1,0],["كلُّ مختال بها في عزَّةٍ","قد مضى يسحبُ في الفخرِ الإِزارا",3,"ر",2,0],["كلّ مخطوبة الخميلة تجلى","في ثياب الأنوار والنوَّار",4,"ر",1,0],["كل مخلوق سيفنى انما","بركات العمر في حسن العمل",5,"ل",1,0],["كل مخلوق لديه سيّئاتٌ","ومزايا ما ، وإلّا لن يكونْ",6,"ن",1,0],["كل مخلوقٍ عرفته يكره الموت ويخافه","بس انا مابي حياتي دام ما حنّا سويّه",7,"ي",2,0]]}