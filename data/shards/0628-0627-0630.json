{"poems":[[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[51,"قصدت إليك لا أدلي بشيء","https://www.aldiwan.net/poem66295.html","الوافر"],[89,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[45,"للعلاء ابن صاعد في مدح","https://www.aldiwan.net/poem63607.html","الخفيف"],[97,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[105,"هتف الداعي فلبى واعتزم","https://www.aldiwan.net/poem41931.html","الرمل"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[46,"أرى الأشياء ليس لها ثبات","https://www.aldiwan.net/poem22150.html","الوافر"],[46,"أبا القدر المتاح ردين جن","https://www.aldiwan.net/poem23407.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85848","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[141,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[158,"أهلا بطرس من إمام مدته","https://www.aldiwan.net/poem59120.html","الرجز"],[259,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[273,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[283,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[303,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[400,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[400,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[413,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[413,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[451,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[459,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[480,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[502,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[549,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[559,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[559,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"]],"verses":[["بِأَذنابِ طاؤوسَينِ ضَمَّت عَلَيهِما","جَميعاً وَقامَت في بَقيرٍ وَمُرفَلِ",0,"ل",1,0],["باذل المال بالبنان الذي قد","حفظ الملك من جميع النواحي",1,"ح",2,0],["بإذن الله يُعْرِي متن أرضٍ","ويكسو أُختَها الزهرَ العميما",2,"م",2,0],["باذلاً في نشر العلوم بمصرٍ","منه جهداً ما أن يضاهيه جهد",3,"د",1,0],["باذِلٌ بِشرَهُ ضَنينٌ بِما يَح","ويهِ مِن دِرهَمٍ وَمِن دينارِ",4,"ر",1,0],["باذلا للصديق والأه","لِ كلّ الذي غنِم",5,"م",1,0],["باذلُ النّفسِ إذا رِيعَ الحمى","كاشفُ الخطبِ إذا الخطبُ ادلهمّ",6,"م",1,0],["بِإِذنِ اللَهِ فَاِشتَدَت قِواهُم","عَلى مَلَكَينِ وَهيَ لَهُم وِثابُ",7,"ب",1,0],["بِإِذنِ اللَهِ تَفتَرِقُ البَرايا","لِطيَّتِها وَتَجتَمِعُ الثُباتُ",8,"ت",1,0],["بِإِذنِ اللَهِ يَنفُذُ كُلُّ أَمرٍ","فَنَهنِه فَيضَ أَدمُعِكَ السُجومِ",9,"م",1,0],["بأذان منه صبحا","أيقظ الناس وناما",10,"م",2,0],["بَاذِلاً نُصْحَهُ مُشِيراً بِمَا فِيهِ","فَلاَحٌ نِعْمَ النَّصِيحُ المُشِير",11,"ر",1,0],["بَاذِخٌ فِي الرِّجَالِ يَسْمُو فَمَا تُخْ","طِيءُ عَيْنٌ مَكَانَهُ فِي العَديدِ",12,"د",1,0],["بِأَذيالِ دَوحٍ نَيرَبِيٍّ كَأَنَّهُ","سَماءُ دُجىً أَبدَت مِنَ النورِ أَنجُما",13,"م",2,0],["باذنه له بجعل نفسه","ملكا له يصرفها في شهوته",14,"ت",2,0],["بأذهل للألباب من سحر جفنه","وافتك من فيه على الشرب قرقفا",15,"ف",2,0],["باذِلٌ والغَيثُ فيها باخِلٌ","سَنةً شَهْباء تُزْجِي العِبَرا",16,"ر",2,0],["باذن الذي بالامس عزز نصرنا","فكانت سراقوزا لنا موقع الجند",17,"د",1,0],["باذلٌ وفرَه لغنيةِ دينٍ","وَأناسٌ لقينةٍ ودنانِ",18,"ن",1,0],["باذلاً لنفس فيما يرتضي","سيد الرسل صباحاً وعشيا",19,"ي",2,0],["باذلين النفيس والنفس لل","ه مطيعين في الأوامر حكمه",20,"م",2,0],["باذلاً كلَّ ما يروق ويحلو","لا مُملاًّ ولا ملولاً بذلا",21,"ل",2,0],["باذل من نفيس ما يقتنيه","من نوالٍ ما يخجل الغيث رفدا",22,"د",2,0],["باذلا روحه فتنمو وتسري","سريان الحياة في غير من",23,"ن",1,0],["باذلُ الجودِ ومنّاعُ الحِمى","لنزيلٍ خافَ أو ضيفٍ نزَلْ",24,"ل",1,0],["باذلُ المجدين جاهاً وغنىً","قاتلُ الإلفينِ من لؤمٍ وجبن",25,"ن",1,0],["بإذن إله العرش أرسل طالبا","معشعشة يأتي بجذوة نائل",26,"ل",1,0],["باذن الذي اعلاه قدراً ومنزلاً","له في امور الكاينات مداخل",27,"ل",1,0],["بأَذرُعٍ لم تزلْ منهمْ معوَّدَةً","هزَّ الظُّبا البيضِ أو سُمرَ القنا اللّدِنِ",28,"ن",1,0],["بِأَذرُعٍ سَوابِحٍ وَأَرجُلِ","مُجَنَّباتٍ للِنجاءِ زُجَّلِ",29,"ل",1,0],["بِاذنِهِ الأَرضُ وَما تَعَتَّتِ","وَحى لَها القَرارَ فَاِستَقَرَّتِ",30,"ت",1,0]]}