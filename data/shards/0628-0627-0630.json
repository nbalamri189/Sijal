{"poems":[[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[74,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[53,"قصدت إليك لا أدلي بشيء","https://www.aldiwan.net/poem66295.html","الوافر"],[91,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[47,"للعلاء ابن صاعد في مدح","https://www.aldiwan.net/poem63607.html","الخفيف"],[99,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[107,"هتف الداعي فلبى واعتزم","https://www.aldiwan.net/poem41931.html","الرمل"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[48,"أرى الأشياء ليس لها ثبات","https://www.aldiwan.net/poem22150.html","الوافر"],[48,"أبا القدر المتاح ردين جن","https://www.aldiwan.net/poem23407.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85848","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[164,"أهلا بطرس من إمام مدته","https://www.aldiwan.net/poem59120.html","الرجز"],[266,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[280,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[290,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[409,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[409,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[422,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[422,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[458,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[466,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[469,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[487,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[509,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[556,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[566,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48746","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18511","المتقارب"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99970","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70708","الخفيف"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202073","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126180","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55943","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78187","الوافر"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137935",""],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47187","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77260","الطويل"],[2314,"","https://poetry.dctabudhabi.ae/diwan/poem/198738",""],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99067","الخفيف"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128644","المديد"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128653","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83228","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202596","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204708","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85175","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32908","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114374","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135741","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103005","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75722","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54378","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58157","السريع"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22799","الرمل"],[4767,"يا ابنةَ العشرين","https://www.poetsgate.com/ViewPoem.aspx?id=213890",""],[1536,"أَصْبَحَ الْمُلْكُ عالياً بأَبي الْعَب","https://www.poetsgate.com/ViewPoem.aspx?id=85704",""],[4859,"ليس يهزمنا غروب!","https://www.poetsgate.com/ViewPoem.aspx?id=194788",""],[4884,"الخط صنعة","https://www.poetsgate.com/ViewPoem.aspx?id=210386",""],[4984,"بشرى","https://www.poetsgate.com/ViewPoem.aspx?id=175838",""],[5045,"دام صدرك يااليماني في انشراحه","https://www.poetsgate.com/ViewPoem.aspx?id=185177",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5189,"بإذنِ الواحد الصمد","https://www.poetsgate.com/ViewPoem.aspx?id=211097",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"اقيض الروح ياحبيبي وخذني","https://www.poetsgate.com/ViewPoem.aspx?id=198171",""],[5516,"على ضفة النهر","https://www.poetsgate.com/ViewPoem.aspx?id=212479",""],[5956,"إذا ترتضين الزواج","https://www.poetsgate.com/ViewPoem.aspx?id=182342",""],[5956,"لقبُ المظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=183733",""],[5993,"يارفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=186544",""],[6008,"الصدر ضاق","https://www.poetsgate.com/ViewPoem.aspx?id=59160",""],[6008,"يراعي الجمس","https://www.poetsgate.com/ViewPoem.aspx?id=60994",""],[456,"عروس الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84502&r=&rc=1",""],[6251,"صديقُ المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76479&r=&rc=19",""]],"verses":[["بِأَذنابِ طاؤوسَينِ ضَمَّت عَلَيهِما","جَميعاً وَقامَت في بَقيرٍ وَمُرفَلِ",0,"ل",1,0],["باذل المال بالبنان الذي قد","حفظ الملك من جميع النواحي",1,"ح",2,0],["بإذن الله يُعْرِي متن أرضٍ","ويكسو أُختَها الزهرَ العميما",2,"م",2,0],["باذلاً في نشر العلوم بمصرٍ","منه جهداً ما أن يضاهيه جهد",3,"د",1,0],["باذِلٌ بِشرَهُ ضَنينٌ بِما يَح","ويهِ مِن دِرهَمٍ وَمِن دينارِ",4,"ر",1,0],["باذلا للصديق والأه","لِ كلّ الذي غنِم",5,"م",1,0],["باذلُ النّفسِ إذا رِيعَ الحمى","كاشفُ الخطبِ إذا الخطبُ ادلهمّ",6,"م",1,0],["بِإِذنِ اللَهِ فَاِشتَدَت قِواهُم","عَلى مَلَكَينِ وَهيَ لَهُم وِثابُ",7,"ب",1,0],["بِإِذنِ اللَهِ تَفتَرِقُ البَرايا","لِطيَّتِها وَتَجتَمِعُ الثُباتُ",8,"ت",1,0],["بِإِذنِ اللَهِ يَنفُذُ كُلُّ أَمرٍ","فَنَهنِه فَيضَ أَدمُعِكَ السُجومِ",9,"م",1,0],["بأذان منه صبحا","أيقظ الناس وناما",10,"م",2,0],["بَاذِلاً نُصْحَهُ مُشِيراً بِمَا فِيهِ","فَلاَحٌ نِعْمَ النَّصِيحُ المُشِير",11,"ر",1,0],["بَاذِخٌ فِي الرِّجَالِ يَسْمُو فَمَا تُخْ","طِيءُ عَيْنٌ مَكَانَهُ فِي العَديدِ",12,"د",1,0],["بِأَذيالِ دَوحٍ نَيرَبِيٍّ كَأَنَّهُ","سَماءُ دُجىً أَبدَت مِنَ النورِ أَنجُما",13,"م",2,0],["باذنه له بجعل نفسه","ملكا له يصرفها في شهوته",14,"ت",2,0],["بأذهل للألباب من سحر جفنه","وافتك من فيه على الشرب قرقفا",15,"ف",2,0],["باذِلٌ والغَيثُ فيها باخِلٌ","سَنةً شَهْباء تُزْجِي العِبَرا",16,"ر",2,0],["باذن الذي بالامس عزز نصرنا","فكانت سراقوزا لنا موقع الجند",17,"د",1,0],["باذلٌ وفرَه لغنيةِ دينٍ","وَأناسٌ لقينةٍ ودنانِ",18,"ن",1,0],["باذلاً لنفس فيما يرتضي","سيد الرسل صباحاً وعشيا",19,"ي",2,0],["باذلين النفيس والنفس لل","ه مطيعين في الأوامر حكمه",20,"م",2,0],["باذلاً كلَّ ما يروق ويحلو","لا مُملاًّ ولا ملولاً بذلا",21,"ل",2,0],["باذل من نفيس ما يقتنيه","من نوالٍ ما يخجل الغيث رفدا",22,"د",2,0],["باذلا روحه فتنمو وتسري","سريان الحياة في غير من",23,"ن",1,0],["باذلُ الجودِ ومنّاعُ الحِمى","لنزيلٍ خافَ أو ضيفٍ نزَلْ",24,"ل",1,0],["باذلُ المجدين جاهاً وغنىً","قاتلُ الإلفينِ من لؤمٍ وجبن",25,"ن",1,0],["بإذن إله العرش أرسل طالبا","معشعشة يأتي بجذوة نائل",26,"ل",1,0],["باذن الذي اعلاه قدراً ومنزلاً","له في امور الكاينات مداخل",27,"ل",1,0],["بأَذرُعٍ لم تزلْ منهمْ معوَّدَةً","هزَّ الظُّبا البيضِ أو سُمرَ القنا اللّدِنِ",28,"ن",1,0],["بِأَذرُعٍ سَوابِحٍ وَأَرجُلِ","مُجَنَّباتٍ للِنجاءِ زُجَّلِ",29,"ل",1,0],["بِاذنِهِ الأَرضُ وَما تَعَتَّتِ","وَحى لَها القَرارَ فَاِستَقَرَّتِ",30,"ت",1,0],["بأذلَّ من ذاك المولِّي وهو في","جرح أشد من الردى وأسار",31,"ر",1,0],["باذلي القوتَ وحشةً أن يبيت ال","مستبيتون منهمُ أوحاشا",32,"ش",2,0],["بِإِذنٍ مَنَ اللَهِ وَالخَيلُ قَد","أُعِدَّ لِذَلِكَ مِضمارُها",33,"ر",3,0],["بَاذِلُ الرَّأْي سَالِكٍ شَعْبَ عَزْمٍ","مَا الْمَصَاعِيبُ فِيهِ كالأَحْفَاضِ",34,"ض",1,0],["باذلٌ للوُفَّادمِ الخيرِ كنزا","ولأعدائه من الشر كنزا",35,"ز",2,0],["بَاذخٌ سَعْدُهُ سَنيَ أَصيلُ","شَامخٌ مَجْدُهُ عليٌّ أَثيلُ",36,"ل",1,0],["بإذن الله منشينا","ومحيينا ومفنينا",37,"ن",2,0],["باذيال عطفٍ منكم عل تنعموا","على الهايم الولهان في خير معلمِ",38,"م",1,0],["بِإِذنيهِ فَأَكثر يا مَلول","شُؤون لَيسَ يُدرك مُنتَهاها",39,"ه",2,0],["باذلين الحياة طوعاً لكي يب","قى حماكِ العزيز حراً مصونا",40,"ن",2,0],["بإذنِكَ توفيقي وفضلُك واسعٌ","إذا لم تُوَفِّقْنِي فكيف أطيع",41,"ع",1,0],["بِأَذكى وَأَبهى مَنظَراً مِن بَنانِها","لَهُنَّ عَلَى أَوراقِهِنَّ رَفيفُ",42,"ف",1,0],["بَاذلاً كُلَّ نِفيسٍ لَمْ يُوَفِّرْ ثَمَّ شَيّا","نَاِفخاً في مَيْتِها الرُّوحَ وفي الحيِّ الدَّوِيّا",43,"ي",2,0],["باذلاً للعزيز تخوض المنايا","وترد الردى وتلقى الصفوفا",44,"ف",2,0],["باذلُ المعروفِ عن مننٍ","مانحُ الإحسان عن عجلِ",45,"ل",1,0],["باذِلُ البشرِ والسماحةِ والإغ","ضاءِ والحلمِ والحيا والحباءِ",46,"ا",2,0],["باذِلاً روحي وَمالي وَالضَنا","ما دَعاني لِلحِمى داعي الحِمى",47,"م",2,0],["بأُذن الروح يأتي الشعر همساً","أتسمع بعد موت الحس همسا",48,"س",2,0],["بإذن النفس تسمعه فصيحاً","متى صفّيتَ نفسك من شرور",49,"ر",1,0],["باذل علمه ومسدي العطايا","حق إن تمتطي إليه المطايا",50,"ي",2,0],["باذِلٌ عُرسَهُ لَنا بِطَعامٍ","وَشَرابٍ نَزرٍ كَنَيلِ البَخيلِ",51,"ل",1,1],["بإذنه هدى","بآيٍ جِسَام",52,"م",1,0],["بأذن خيرٍ وصحيح الإسلامْ","وسيد الكونين عافِ بالدوامْ",53,"م",1,0],["باذخِ العزِّ حلَّ أي محل","من مقام التعظيم والتبجيل",54,"ل",1,0],["باذل فاض كفه بهبات","من أتى بابه برفد جدير",55,"ر",1,0],["باذلٌّ في مصالح الدِّين طَوْعاً","ما حواهُ من طارف وتلادِ",56,"د",1,0],["بإذن مولاه لقد أُرسلتْ","عليك يا شهر الصيام السلامْ",57,"م",1,0],["باذِلٍ في الخَيرِ لا يَن","ظُرُ مِنهُ في اِرتِخاصِ",58,"ص",1,0],["باذلاً مِمَّا حباني ال","لهُ مِن فضلٍ سخيا",59,"ي",2,0],["بَاذلِ النَّفْسِ وَاهبٍ لَكَ مَحْضَ ال","نُصْحِ مِنْ أُسْرَةٍ لَكُمْ أَمْحَاضِ",60,"ض",1,0],["بإذن اللهِ ثم بعزم شعبٍ","أبيّّ لا تحطمه الخطوبُ",61,"ب",1,1],["باذلاً بالعزْمِ جهداً","أَسكبُ التَّركيزَ دفعهْ",62,"ع",2,0],["بإذنك يا مولاي يممت زائرا","وظني بأن الدرب صار ممهدا",63,"د",2,0],["باذن ربي يامن اتحلى الوقااحة","حل دحره باذن من سير رياحه",64,"ه",1,0],["باذل الجود جواد","في السنايا لا يجارى",65,"ر",2,0],["بإذنِ الواحد الصمدِ العليمِ","سيغدو الحالُ للوضعِ السليمِ",66,"م",1,1],["بأذكار وأوراد رووها","عن الإثبات عن صحب وآل",67,"ل",1,0],["باذخ الروح حبّه لم يخنّي","مُزهر القلب عطره باح عني",68,"ن",2,1],["بأذيالها الطّهرُ سالَ ندى","على وجنة الورد والعطر سالْ",69,"ل",1,0],["‏بإذن المهيمن لا تندمين","‏ ‏ ولكن تقيمين عندي الدهورا",70,"ر",2,0],["بإذن الله أجعل لي سَمِيّاً","سوى المظلوم فهو أذى وصابُ",71,"ب",1,0],["باذن ربي غير لاصل ولاجاني حرج","والرجال الطيبه ماتخيب ظنونها",72,"ن",3,0],["بإذن الولي خلاق خمس الفروضي","الواحد اللي في عباده يقاضي",73,"ض",2,0],["باذن ولي ٍ دوم بسمه نسبح","صلوا على سيد الهاشمي والأصاحيب",74,"ب",1,0],["باذخات مُنعماتٍ كُسّلاً","لاهياتٍ شامخاتِ القمَم",75,"م",1,0],["بأذخٌ أحسبه يوماً أتي الفجر أو زار مدار الأنجمِ","لم تقل زوراً يراعاتي وميزانها قسطاسه لم يظلمِ",76,"م",1,0]]}