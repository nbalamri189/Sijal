{"poems":[[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[63,"هويتها والفراق يهواها","https://www.aldiwan.net/poem51406.html","المنسرح"],[68,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[102,"سياح الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=50398",""],[102,"سياح الرماد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67651&r=&rc=138",""],[240,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[303,"هل في البكاء على ما فات من حرج","https://www.aldiwan.net/poem36286.html","عموديه"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[422,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[534,"الجواب الذي أراه صوابا","https://www.aldiwan.net/poem37448.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138297",""],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/105358","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79809","المتقارب"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48279","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45866","البسيط"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199149","المجتث"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81288","المنسرح"],[5739,"رسالة شاعر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=127065",""],[4228,"اليقظه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69254&r=&rc=8",""]],"verses":[["لو أفضل البيهقيُّ قافيةً","أنهشتُها البينَ أي إنهاش",0,"ش",1,0],["لو أفرَطَتْ بالعقيقِ خَجْلَتَها","أسلمَ ماءَ العَقيقِ خَدَّاها",1,"ا",3,0],["لَو أَفادَتنا العَزائِمُ حالا","لَم نَجِد حُسنَ العَزاءِ مَحالا",2,"ل",2,1],["لو أفاد العتابُ، ملنا على النفْ","سِ بما لا تطيقهُ نفسُ نادم",3,"م",1,0],["لو أفاء الورى إليه، أقاموا","ما أقاموا في ظل عيشٍ سعيد",4,"د",1,0],["لوافته ، من أغاني الطيوب ... وأبوابه ، أذرع ، من وداد","حنون الممرّات ، جدرانه ... نجوم كسالى ، تدير الرّقاد",5,"د",1,0],["لوافته ، من أغاني الطيوب","وأبوابه ، أذرع ، من وداد",6,"د",1,0],["لِوافِدِ النَيروزِ ما اِس","تُشرِطَ مِنها وَاِقتُرِح",7,"ح",1,0],["لوافِحٌ مِنْ مُصيباتِ الزَّمانِ لَقَدْ","لوَّحنَ وَجهي وَزنَّ الخُلق تحسينا",8,"ن",2,0],["لَوافِحُ الحَرِّ خالوها نَسيمَ صِبا","وَقَعقَعاتِ السِلاحِ المُنتَضي طَرَبا",9,"ب",2,0],["لو أُفيضَتْ أبْحرٌ من علمِه","ونَداه صار هذا البر بحرا",10,"ر",2,0],["لو أفضيت علومه في البرايا","شمل العالمين بالإِغراق",11,"ق",1,0],["لَوْ أَفادَ اتِّصالُ رُوحٍ برُوحٍ","في وِدادٍ وَمَعْ طَويلِ بِعادِ",12,"د",1,0],["لو افتخرت بالماجدين فانما","بلا جدل عجبا به افتخر القطر",13,"ر",1,0],["لو افتديها وقليل بأن","تفدى لها الدنيا بما فيها",14,"ي",3,0],["لوافتكَ دعوتهُ بالنُّهوض","بأسرع من لمحة النَّاظرِ",15,"ر",1,0],["لو أفقنا من سكرة الأمل الكا","ذب أو خف سكرنا والحمار",16,"ر",1,0],["لو أفْصحتْ أشكالُها بخِطابِها","للمُبْصرينَ لأوْضَحَتْ إشكالَها",17,"ل",3,0],["لَو اِفتدتك المَنايا عندَ ما فَتَكَت","بِخيرَنا لفدتك العَجم وَالعَرَب",18,"ب",1,0],["لو أفلتوه علانا","واجتاحنا بوباه",19,"ا",2,0],["لَو أَفرَغ الفَجر ذُو الجَوانب في","أَدنى إِناء مِن عِندَه وَسغه",20,"ه",1,0],["لو افهق ضلوعك بها اويق بشويش.","بااشوف ناس ٍ تآكل اظهورها ناس.",21,"س",1,0],["لو افزع الفجر ذو الجوانب فى","ادنى اناء من عنده وسعه",22,"ع",2,0]]}