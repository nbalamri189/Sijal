{"poems":[[37,"أشاقك برق آخر الليل خافق","https://www.aldiwan.net/poem39128.html","الطويل"],[87,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[63,"لنا مجلس لو لم تغب عنه كامل","https://www.aldiwan.net/poem51481.html","الطويل"],[63,"خيش ابن رستم يحمى وهو ممطور","https://www.aldiwan.net/poem51649.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[159,"أبيض واصفر لاعتلال","https://www.aldiwan.net/poem55613.html","مخلع البسيط"],[215,"يا مليك الحسن عزت دولتك","https://www.aldiwan.net/poem46307.html","الرمل"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[285,"أمن الملك حسبك من أمين","https://www.aldiwan.net/poem60689.html","الكامل"],[287,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[396,"جاء الفرج زال الحرج","https://www.aldiwan.net/poem54489.html","عموديه"],[466,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[466,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138404",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122713","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96754","المتدارك"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177900","المنسرح"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117645","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79808","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80049","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79898","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108881","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27232","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75921","الرجز"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100173","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126971","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66373","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101377","الطويل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124621","الطويل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105166","البسيط"],[4734,"فجر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=50227",""],[4919,"جرح","https://www.poetsgate.com/ViewPoem.aspx?id=34792",""],[5184,"لأنك العراق","https://www.poetsgate.com/ViewPoem.aspx?id=186052",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[5818,"يحمل الأشواق والحبّ الثقيلا","https://www.poetsgate.com/ViewPoem.aspx?id=199621",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""]],"verses":[["يُرَشِّحُ نَبتاً ناعِماً وَيَزينُهُ","نَدىً وَلَيالٍ بَعدَ ذاكَ طَوالِقُ",0,"ق",1,0],["يَرشو عَلَيها الوالِدينَ ثَلاثَةً","لَم أَدرِ أَيُّهُمُ الغَليظُ الضاري",1,"ر",2,0],["يُرَشُّ بماءِ الوَرْدِ حتى ترى له","دُموعاً على ما اخضلَّ منه تجولُ",2,"ل",1,0],["يَرُشُّهُ والنُّدامى يَعْرَقُونَ به","كأنه لدوامِ الرَّشِّ ممطورُ",3,"ر",1,0],["يُرْشِدُ النَّاسَ بِالْبَيَانِ وَبِالْقُدْ","وَةِ لاَ بِالْوُعُودِ أَوْ بِالْوَعِيدِ",4,"د",1,0],["يَرْشَحُ مِنْهُ الجَبينُ ماءً","كأَنَّهُ لُؤْلُؤٌ مُنَصَّفْ",5,"ف",1,0],["يرشفُ اللثمةَ من كأس لماك","في ظلال الأنس والصفو المتاح",6,"ح",1,0],["يُرشُّ على الجنّاتِ مِنه تبرُّكاً","فينبتُ فيها زعفراناً وعُصفرا",7,"ر",2,0],["يُرَشَّحُ لِلْعُلى مَنْ لَيْسَ مِثْلِي","وَيُدْعى لِلغِنى مَنْ كانَ دُونِي",8,"ن",2,0],["يَرِشنَ بِاللَحظِ نِبالاً لِمَن","يَزورُ يَبرينَ وَيَبرينا",9,"ن",2,0],["يرشدك للخير يا نعم الحميم اللزيم","يحفظك من شر إبليس اللعين الرجيم",10,"م",1,0],["يرشُّ كثيفُ الدجْن حيناً وتارةً","له ساكبٌ من رائق الماء هاطلُ",11,"ل",1,1],["يرْشُقُ كلَّ وجْنةٍ بمِعْبَلِ","صُرادُه يفْلُق صُلْب الجنْدَل",12,"ل",1,0],["يرشقن باللحظ قبل الزهر افئدة","كالنبل صابت صميم المدنف العاني",13,"ن",2,0],["يُرشِفُني إذ وِسادَتي يَدُهُ","مَلمَظَ ثَغرٍ جَناهُ مَعسُولُ",14,"ل",1,0],["يرشق القلبَ منّي بأسهمه","كلَّما رقرقَ الأعينَ النجلا",15,"ل",2,0],["يرشف ريق الندى مقبلها","فيجتنيها معسولة الشنب",16,"ب",1,0],["يرشف من ثغر أبيه بضعة","لا تستطيع بالظما ان تنطقا",17,"ق",2,0],["يرشون فضلاتِ الكؤوس تبركاً","عليهم ولا يصغون إن لامَ لائمُ",18,"م",1,0],["يُرَشّحُ لكن لا لشيء سوى الخنا","وليدكم فيما يروحُ ويغتدي",19,"د",2,0],["يرشف السمعُ لفظها العذب راحاً","لجميع العقول منهُ انتشاءُ",20,"ا",2,0],["يُرشِفنيها ريقةً عنبيَّةً","كخُلقِ أبي الهادي روت عنهُ طيبها",21,"ب",3,0],["يُرشَى الرَشا القاسي بها","فيرقُّ رقة مغرَم",22,"م",1,0],["يُرشدُ النفسَ أينَ تبنى ليبقى","ما أقامتهُ خالدَ البُنيانش",23,"ن",2,0],["يرشد الخَلقَ ويبدي رسمَه","شاكراً واستمعوا إن أذنا",24,"ن",2,0],["يَرشُفُنا مِن ريقِهِ مُدامَةً","نَكهَتُها تَهزَأُ بِالعَبيرِ",25,"ر",1,1],["يرشف كاساتها يطفي الجوى وبها","يشفي سقيم الهوى أن شفه الوصب",26,"ب",1,0],["يرشحُ صبية الأضغانِ فيها","ويرقبُ فيكَ يوما أرونانِ",27,"ن",1,0],["يرشح الصم ندى لو","لامست كفاه جلمد",28,"د",1,0],["يرشف السمع حتى تتلى كؤساً","من طلاها مستعذبات المذاق",29,"ق",1,0],["يرشحه لها نسبٌ منيفٌ","لمحتده ذرى العليا سجودُ",30,"د",1,0],["يرشف الطل من ثغور الأزاهي","ر فيغدو كأنه سكران",31,"ن",1,0],["يَرشَحُ مِن جَبينِهِ سَيلُ عَرَق","وَالسَهمُ بادٍ عَضَلَ الحُقِّ اختَرَق",32,"ق",1,0],["يرشفنها ما ساغ بالكأس شربة","وشربك من ضخ وكأسك من كف",33,"ف",1,0],["يرشح ما قد أورثته جدوده","من الدين والبذل السماحة والبذل",34,"ل",1,0],["يرشفها تحيى أقواماً وان هزلوا","مما بهم من أذى الأشواق واللهب",35,"ب",1,0],["يرشونَ الدروبَ بألفِ عهدٍ","وكلُّ عهودهمْ باتت كِذابا",36,"ب",2,0],["يرشه بالعطر يخد الألم وينام","ينام بعد الألم نومة هنية",37,"ي",2,0],["يَرُشُّ على أهْدابِها وَسَناً فإنْ","غَفَتْ صَاغَ مِنْ أهْدابِهِ حَوْلَها خِدْرا",38,"ر",2,0],["يرشد الحائرين حينا وأحيا","نا يربي لغابك الأشبالا",39,"ل",2,0],["يرشف الأحلام يقتات القوافي","مستغيثاً يسهر الليل الطويلا",40,"ل",2,0],["يرشدُ الحقُّ إلى أن نحذر فعلاً","كبعوضٍ نافثٍ فينا انتقامَهْ",41,"م",2,0],["يَرشِحُ الشِّعرُ مِن مَسامِ شُعُورِي","رُغمَ عَنِّي, وَلَيسَ مِن وَحيِ قُدرَةْ",42,"ر",2,0]]}