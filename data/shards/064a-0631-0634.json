{"poems":[[37,"أشاقك برق آخر الليل خافق","https://www.aldiwan.net/poem39128.html","الطويل"],[87,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[63,"لنا مجلس لو لم تغب عنه كامل","https://www.aldiwan.net/poem51481.html","الطويل"],[63,"خيش ابن رستم يحمى وهو ممطور","https://www.aldiwan.net/poem51649.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[158,"أبيض واصفر لاعتلال","https://www.aldiwan.net/poem55613.html","مخلع البسيط"],[214,"يا مليك الحسن عزت دولتك","https://www.aldiwan.net/poem46307.html","الرمل"],[273,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[283,"أمن الملك حسبك من أمين","https://www.aldiwan.net/poem60689.html","الكامل"],[285,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[394,"جاء الفرج زال الحرج","https://www.aldiwan.net/poem54489.html","عموديه"],[463,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[463,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"]],"verses":[["يُرَشِّحُ نَبتاً ناعِماً وَيَزينُهُ","نَدىً وَلَيالٍ بَعدَ ذاكَ طَوالِقُ",0,"ق",1,0],["يَرشو عَلَيها الوالِدينَ ثَلاثَةً","لَم أَدرِ أَيُّهُمُ الغَليظُ الضاري",1,"ر",2,0],["يُرَشُّ بماءِ الوَرْدِ حتى ترى له","دُموعاً على ما اخضلَّ منه تجولُ",2,"ل",1,0],["يَرُشُّهُ والنُّدامى يَعْرَقُونَ به","كأنه لدوامِ الرَّشِّ ممطورُ",3,"ر",1,0],["يُرْشِدُ النَّاسَ بِالْبَيَانِ وَبِالْقُدْ","وَةِ لاَ بِالْوُعُودِ أَوْ بِالْوَعِيدِ",4,"د",1,0],["يَرْشَحُ مِنْهُ الجَبينُ ماءً","كأَنَّهُ لُؤْلُؤٌ مُنَصَّفْ",5,"ف",1,0],["يرشفُ اللثمةَ من كأس لماك","في ظلال الأنس والصفو المتاح",6,"ح",1,0],["يُرشُّ على الجنّاتِ مِنه تبرُّكاً","فينبتُ فيها زعفراناً وعُصفرا",7,"ر",2,0],["يُرَشَّحُ لِلْعُلى مَنْ لَيْسَ مِثْلِي","وَيُدْعى لِلغِنى مَنْ كانَ دُونِي",8,"ن",2,0],["يَرِشنَ بِاللَحظِ نِبالاً لِمَن","يَزورُ يَبرينَ وَيَبرينا",9,"ن",2,0],["يرشدك للخير يا نعم الحميم اللزيم","يحفظك من شر إبليس اللعين الرجيم",10,"م",1,0],["يرشُّ كثيفُ الدجْن حيناً وتارةً","له ساكبٌ من رائق الماء هاطلُ",11,"ل",1,1],["يرْشُقُ كلَّ وجْنةٍ بمِعْبَلِ","صُرادُه يفْلُق صُلْب الجنْدَل",12,"ل",1,0]]}