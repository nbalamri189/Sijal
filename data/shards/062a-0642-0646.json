ml","الرمل"],[411,"تقنع بالكفاية فهي أولي","https://www.aldiwan.net/poem49884.html","الوافر"],[463,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[466,"أظن القوافي ساورتها صبابة","https://www.aldiwan.net/poem15311.html","الطويل"],[482,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[498,"أيا ماجدا مذ يمم المجد ما نكص","https://www.aldiwan.net/poem67358.html","الطويل"],[510,"المُقنَّع","https://www.aldiwan.net/poem27796.html","الطويل"],[580,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[580,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2458","الوافر"],[719,"","https://poetry.dctabudhabi.ae/diwan/poem/99139","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96679","الطويل"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74107","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64866","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27552","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94024","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100419","السريع"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103479","المتقارب"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121561","المتقارب"],[3349,"","https://poetry.dctabudhabi.ae/diwan/poem/73837","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123936","الوافر"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[4684,"يغتالنا خببا","https://www.poetsgate.com/ViewPoem.aspx?id=201573",""],[4755,"بينَ يَدَيْ قِيَامِ السَّاحَة","https://www.poetsgate.com/ViewPoem.aspx?id=183587",""],[5187,"فرسان ميونيخ","https://www.poetsgate.com/ViewPoem.aspx?id=29246",""],[5304,"العشق","https://www.poetsgate.com/ViewPoem.aspx?id=155916",""],[5582,"أَأَوْجُهُ غِيدٍ زِلْنَ عَنْها البَراقِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63532",""],[5684,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=188300",""],[402,"عجبا أتوحشني وأنت إزائي","https://www.poetsgate.com/ViewPoem.aspx?id=35059",""],[4442,"أنفت أن تميس إلا دلالا","https://www.poetsgate.com/ViewPoem.aspx?id=171224",""]],"verses":[["تَقَنَّصَكِ الرَدى عَرَضاً وَأَمسى","يُجاذِبُكِ المَسيرَ عَنِ المُقامِ",0,"م",1,0],["تَقَنَّصَهُ صَرفُ المَقاديرِ غِرَّةً","وَكَم فاتَ مِن نابٍ عَلوقٍ وَمِخلَبِ",1,"ب",1,0],["تَقَنَّصَ عَقلي دَلُّهُ وَأَعانَهُ","عَلى قَبضِ روحي ثَغرُهُ وَمَحاجِرُه",2,"ر",2,0],["تَقَنَّصْتُ مَنْهُ ظَبْيَةَ الأُنْسِ فَانْثَنَتْ","رَهِينَةَ حُبً أَوْثَقَتْهَا حِبَالُهُ",3,"ل",2,0],["تَقنِصُ الخَيلَ خَيلَهُ قَنَصَ الوَح","شِ وَيَستَأسِرُ الخَميسَ الرَعيلُ",4,"ل",1,0],["تَقَنَّصَهُ بَنو سِنباطَ أَخذاً","بِأَشراكِ المَواثِقِ وَالعُهودِ",5,"د",1,0],["تَقَنَّصَني لَمّا بَدا لِيَ سانِحاً","كَما مَرَّ ظَبيٌ بِالمَفازَةِ يَسنَحُ",6,"ح",1,0],["تَقَنَّصَ في الإيوانِ أَملاكَ فارِسٍ","وَكَم جازَ بَحراً دونَ قَيصَرَ أَو دَربا",7,"ب",2,0],["تَقَنَّع مِنَ الدُنيا بِلَمحٍ فَإِنَّها","لَدى كُلِّ زَوجٍ حائِضٌ ما لَها طُهرُ",8,"ر",1,1],["تَقنو الحَياة خلوداً","وَالمشكلات تَهون",9,"ن",1,0],["تَقنو الحَياة بقاء في تنازعها","من النشاط وكل المَوت في الكسل",10,"ل",1,0],["تَقنصُكَ الَخيلُ ويَصطادُكَ ال","طَّيرُ ولا تُنكَعُ لَهوَ القَنيص",11,"ص",1,0],["تَقْنِي حَيَاءَكَ عَالِماً عَنْ خِبْرًةٍ","إِنَّ الخَصَاصَةَ آفَةُ الأُدَباءِ",12,"ا",2,0],["تقنّع بالحياء فلا نراه","وأولعَ بالوفاء فما يرامُ",13,"م",1,0],["تقنصت منه ظبية الأنس فانثنت","رهينة حب وثقتها حباله",14,"ل",2,0],["تَقنِصُكَ الخَيلُ وَتَصطادُكَ الط","طَيرُ وَلا تُنكَعُ لَهوَ القَنيص",15,"ص",1,0],["تَقَنَّعَتْ بالدّجى فَوْق الضحى فَجَلَتْ","في عاجِ عارِضِها لاماً من السَّبَجِ",16,"ج",1,1],["تقنّعت بالقوت القليل تعفّفا","مخافة أن أبلى برد بخيل",17,"ل",1,1],["تقنصني غزال شاب فيه","مَفارِقُ لمّةٍ قَد كُنَّ سُودا",18,"د",2,1],["تقنع بالورد من لطفه","ليخفي الجمال فلم يخفه",19,"ف",2,1],["تقنَّعَ الأُفْقُ لما ثارَ من فَرَقٍ","وظلَّ يرعد من ذعرٍ ويرتمض",20,"ض",1,0],["تقنصتها كالظبي جيداً وطالما","غدت لم تعج نحو الحبا والحبائل",21,"ل",1,1],["تَقنّصها ذو الجَدّ أخْذاً بكَفّه","وخابَتْ رجالٌ ناصِبونَ شِباكا",22,"ك",2,0],["تَقنَّصْتُه والأُفْقُ يجتابُ حُلّةً","من الوَشْيِ يُسدَى نَسْجُها ويُنار",23,"ر",1,0],["تُقنعُ النَّفسَ بأَدْنى عيشةٍ","في بلادٍ كلّ أَهليها لِئَامُ",24,"م",1,0],["تقنَّعْ بالكفِايةِ فهْيَ أولي","بوَجهِ الحُرِّ من ذُلِّ القُنوعِ",25,"ع",1,1],["تقنصُ الأغراضَ ركضاً كلّما","أدركتْ فنّاً تعدّته لفنِّ",26,"ن",1,0],["تقنَّصها السلطانُ منه بحملةٍ","أعادت مجال القوم وهو مَصارعُ",27,"ع",1,0],["تقنَّصها الحامي حقيقة صحْبهِ","اذا صافحت بركَ الرجال البراقِع",27,"ع",1,0],["تقنعُ مِن مشربِها","بكلَّ نَزْرٍ ثَمْدِ",28,"د",1,0],["تَقَنَّصتَ بِالأَلطافِ شُكرى وَلَم أَكُن","عَلِمتُ بِأَنَّ الحُرَّ بِالبِرِّ يُقتَنَص",29,"ص",1,0],["تقنّعْ فكيفما تزيّفُ وجْهكَ","القبيح تظلُّ في العيونِ دنيّا",30,"ي",2,1],["تقنَّعَت تعمَتْ","تسوَّرتْ تَمَنْطَقَتْ",31,"ت",1,0],["تقنَّعتُ لكِنْ بالحبيبِ المعَّمَّمِ","وفَارَقْتُ لكِنْ كلَّ عَيْشٍ مُذَمَّمِ",32,"م",1,1],["تَقِنَّ اللَهَ فيَّ رُقَيَّ وَاِخشي","عُقوبَةَ أَمرِنا لا تَقتُلينا",33,"ن",2,0],["تقنع بالأهواز لي","وواسط والبصرة",34,"ه",1,0],["تقنّعنَ مِن نسجِ الحريرِ مقاطعاً","فَزانت عَلى أعطافهنّ المقانعُ",35,"ع",1,0],["تقنَّع بَدرُ التمِّ عند طلوعِه","مَخافةَ أَن يَسري إِلَيهِ فَيُفضَح",36,"ح",1,0],["تَقَنَّصَه مِنِّي غَزالٌ مُمَنَّعٌ","حَلالي تمنِّي بَذْلِهِ بَعْدَ مَنْعِهِ",37,"ع",2,0],["تقنع بما قد جاء منه ولا تزد","مخافة أن يأتيك من بعده خلف",38,"ف",1,0],["تقنص منها ما تبدى نفاره","وانفد في تأليف شاردها الوسعا",39,"ع",2,0],["تقنَّصت عيناي فيه طلى","تنفث مثل السحر عيناه",40,"ا",2,0],["تَقَنَّصتُ مِن هَضبَةٍ زُرَّقا","وأَحرَزتُ مِن رَهوَةٍ سَوذَنيقا",41,"ق",2,1],["تقنعت بالوصل من طيفه","وكل محب لعمري قنوع",42,"ع",1,0],["تَقنَعُ بِاللَّحظِ مِنهُ عَيني","فَما عَدا لَحظَهُ مُحالُ",43,"ل",1,0],["تقنعها العدا بالسوط مهما","شكت لسرائها سلب القناع",44,"ع",1,0],["تَقنّصهُ مِن دونِ بَيضاءَ نَثلَةٍ","وَعَضبٍ إِذا ما صابَ لِلقَطعِ أَسرَعا",45,"ع",2,0],["تقنا صواع إباءٍ زان مِحْملُنا","الحمْل ضاع جهاراً والبعيْرُ كبا",46,"ب",2,0],["تُقْنا إِلى اليَمَنِ الجَدِيدِ, ولم نَكُن","نَدري بأنَّ التَّوْقَ لاستِئصالِهِ",47,"ل",2,0],["تَقنَّعوا من ظلامِ الليلِ أرديةً","واسْترخصوا ما فَدتْ أرواحُهم فيها",48,"ي",3,0],["تقنب ضلوعي بين صكّات وغلاق","وعينن جفاها النوم والدمع مخروق",49,"ق",1,0],["تَقَنَّعْنَ مِنْ نَسْجِ الحَرِيرِ مَقانِعاً","فَزانَتْ عَلَى أَعْطافِهِنَّ المَقانِعُ",50,"ع",1,0],["تقنا لمجد طواه النوم من زمن","والغرب تحطيمَنا ساعٍ ومنتهج",51,"ج",1,0],["تقني حيائك عالما عن خبرة","إن الخصاصة آفة الأدباء",52,"ا",2,0],["تقنص الأسد من حمى كل غيل","ثم ترتاد تصرع الأجيال",53,"ل",1,0]]}