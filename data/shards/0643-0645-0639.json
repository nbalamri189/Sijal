{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"كم عرضوا لي بالدنيا وزخرفها","https://www.aldiwan.net/poem30182.html","البسيط"],[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[86,"كم ذا يكابد عاشق ويلاقي","https://www.aldiwan.net/poem10915.html","الكامل"],[71,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[93,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[54,"جاؤوا من الشام المشومة أهلها","https://www.aldiwan.net/poem27430.html","الكامل"],[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[72,"كم عاذل يغري وواش يتعب","https://www.aldiwan.net/poem18277.html","الكامل"],[72,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[72,"صيرني في كل واد أهيم","https://www.aldiwan.net/poem19673.html","السريع"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"تأمل العيب عيب","https://www.aldiwan.net/poem8304.html","المجتث"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"مستقبل خائفه الصفح مستقبل آمنه المنح","https://www.aldiwan.net/poem9400.html","السريع"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[51,"لست أبكي على نوال صديق","https://www.aldiwan.net/poem65523.html","الخفيف"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"قل لأبي سهل الذي ترك","https://www.aldiwan.net/poem65915.html","المنسرح"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[89,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[85,"ذكر الحداثة جهلها وغرامها","https://www.aldiwan.net/poem7105.html","الكامل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"لدودة القز عندي","https://www.aldiwan.net/poem8009.html","المجتث"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[56,"كلب قبيلي وكلب خير من ولدت","https://www.aldiwan.net/poem58498.html","البسيط"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"خير يوميك في الهوى واقتباله","https://www.aldiwan.net/poem65606.html","الخفيف"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[58,"صرمت حبالك بعد وصلك زينب","https://www.aldiwan.net/poem31129.html","الكامل"],[49,"لله عاقبة الأمور جميعا","https://www.aldiwan.net/poem62165.html","الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[49,"دار وعورة سهلها","https://www.aldiwan.net/poem63094.html","مجزوء الكامل"],[49,"بالله يا حلوة العينين زوريني","https://www.aldiwan.net/poem65335.html","البسيط"],[66,"كم عكفنا على المدامة يوما","https://www.aldiwan.net/poem39188.html","الخفيف"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[66,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[97,"قل لوزير الحق وهو الذي","https://www.aldiwan.net/poem24979.html","السريع"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[80,"وباقة مستحسن نورها","https://www.aldiwan.net/poem31558.html","السريع"],[69,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[69,"كم عالم عالم يشكو طوى وظما","https://www.aldiwan.net/poem28518.html","البسيط"],[69,"فضل لديك اكتسى به","https://www.aldiwan.net/poem28908.html","المجتث"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"من معيني على السهر","https://www.aldiwan.net/poem27000.html","مجزوء الخفيف"],[52,"لا تلق إلا بليل من تواصله","https://www.aldiwan.net/poem27115.html","البسيط"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[46,"من صفة الدنيا التي أجمع النا","https://www.aldiwan.net/poem22219.html","السريع"],[46,"عاقبة الميت محمودة","https://www.aldiwan.net/poem22374.html","السريع"],[46,"تلف البصائر والزمان مفجع","https://www.aldiwan.net/poem22708.html","الكامل"],[46,"إرفع مجنك أو ضع للفتى قدر","https://www.aldiwan.net/poem22827.html","البسيط"],[46,"ما أكرم الله عز من ملك","https://www.aldiwan.net/poem23418.html","المنسرح"],[46,"أنافق الناس إني قد بليت بهم","https://www.aldiwan.net/poem23518.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85639","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141934","الرمل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12738","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[106,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[51,"لستُ أبكي على نوالِ صديقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29915",""],[51,"تأمُّلُ العيبِ عَيْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=26997",""]],"verses":[["كَم عَمَّمَتني بِالظَلامِ مَطِيَّةٌ","بَعدَ اِعوِجاجِ عَمائِمِ الرُكبانِ",0,"ن",1,0],["كَم عَرَّضوا لِيَ بِالدُنيا وَزُخرُفِها","مَعَ الهَلوكِ فَلَم أَرفَع بِها راسا",1,"س",2,1],["كَمُعاقِدِ الجَبَلِ الأَشَمِّ مُعاقِدي","وَمُجاوِرِ البَيتِ الحَرامِ مُجاوِري",2,"ر",2,0],["كَم عَلى تُربِكِ لَمّا صُرِّعوا","مِن دَمٍ سالَ وَمِن دَمعٍ جَرى",3,"ا",1,0],["كَم عَبرَةٍ مَوَّهتُها بِأَنامِلي","وَسَتَرتُها مُتَجَمِّلاً بِرِدائي",4,"ي",1,0],["كَم عالِمٍ مَدَّ العُلومَ حَبائِلاً","لِوَقيعَةٍ وَقَطيعَةٍ وَفِراقِ",5,"ق",1,0],["كَم عاثَ بِاللَيلِ في الفِراشِ عَلى","كرومِ بُستانِ شُفرِها",6,"ه",2,0],["كَمْ عَزَّ مِنْ ضَعَةٍ شَعْبٌ بِفِتْيَتَهِ","وَكَانَ آبَاؤُهُمْ فِي أَوْضَعِ المِهَنِ",7,"ن",1,0],["كَم عَبرَةٍ فاضَت لَكُم وَتَقَطَّعَت","يَومَ الطُفوفِ عَلى الحُسَينِ نُفوسُ",8,"س",1,0],["كَم عَينِ ذي حِوَلٍ فَقَّأتُ ناظِرَها","وَكَم قَطَعتُ لِأَهلِ الغِلِّ مِن حُمَةِ",9,"ه",1,0],["كم عمرتْ بحسابها من دولةٍ","وبلا حسابٍ كم سختْ بعطاء",10,"ا",2,0],["كم عاذلٍ يغري وواشٍ يتعب","ومراقب بل خائف يترَقب",11,"ب",1,1],["كم عذولٍ على هواك أداجي","يا رشا من سطاه لست بناجي",12,"ج",2,1],["كم عرضنَا مقدِّماتِ أمانٍ","لنداهُ فأحْسنت في النتاج",12,"ج",1,0],["كم عادنا منك ندًى مشهرٌ","لواحظ المدح وأمنٌ منيم",13,"م",1,0],["كم عائذٍ من دهرِهِ","بهمُ إذا ما الدهرُ رابَهْ",14,"ب",2,0],["كم عاتبٍ كلَّ شيءٍ","وكلُّ ما فيه عيبُ",15,"ب",1,0],["كم عدوٍّ لهم غدا وهو مغمُو","رٌ بنعماءَ منهمُ لا مَقُوتُ",16,"ت",1,0],["كم عائلٍ ليست له ضيْعَةٌ","ولا بِهِ سعْيٌ ولا كدحُ",17,"ح",1,0],["كمْ عَارِضٍ رَجُلاً عليَّ مُشَبِّهاً","لأَمِيلَ عنْكَ إليه بالأمْدَاحِ",18,"ح",1,0],["كم عصت الله وما أحسنت","فقحتها شيئاً سوى الطاعه",19,"ع",2,0],["كم عدات نسختَها بعدات","حلَّ إنجازها مع العيوق",20,"ق",1,0],["كم عدو لكم غدا يجتديكم","ولقد بات نابه محروقا",21,"ق",2,0],["كم عالمٍ فيكمُ وليس بأن","قاسَ ولكن بأن رقى فَعَلا",22,"ل",2,0],["كم عرَّضُوا للْمنايا الحمرِ أنفسَهُمْ","فحان قومٌ تَوَقَّوْها وما حانوا",23,"ن",3,0],["كَم عَنَّفونا في الهَوى وَاِستَرسَلوا","لَو أَنَّهُم عَزَفوا الهَوى لَم يَعذِلوا",24,"ل",3,0],["كَم عانَقَت روحي رُباكَ","وَصَفَّقَت في المُنحَنى",25,"ن",2,0],["كم عاهدوا أنهم يأتون معدلة","لكنهم جانبوا الإنجاز لاهينا",26,"ن",2,0],["كمعادن الذهب استقل بتبرها","قوم وزوّد آخرون رغامها",27,"م",3,0],["كم عن يمينك أو يسارك لو ترى","من فيلق متتابع الأمداد",28,"د",1,0],["كَم عِندَنا مِن أَيادٍ","لِلدودَةِ الغَراءِ",29,"ا",2,0],["كَم عَليمٍ سَقَطَ العِيُّ بِهِ","مُظلِمٌ لا تَهتَدي في كُتبِهِ",30,"ه",1,0],["كَم عَزيزٍ عِندَكَ اِستَودَعتَهُ","وَعُهودٍ بَعدَكَ اِستَرعَيتَهُ",30,"ه",1,0],["كَمْ عَرَّضُوا أَيْدِياً بِيضاً مُكَرَّمَةً","للعُدْمِ مِنْ طولِ ما انْتَاشُوا مِنَ العَدَمِ",31,"م",1,0],["كَم عَزيزٍ حَرَبنَ مِن غَيرِ ذُلٍّ","مالَهُ أَو نَزَعنَ عَنهُ ثِيابَه",32,"ب",2,0],["كَم عَزيزٍ أَبادَهُ فَغَدا را","كِبَ عودٍ مُرَكَّبٍ فَوقَ عودِ",33,"د",1,0],["كَم عِداتٍ تَضَمَّنَ الجودُ فيها","رَدَّ إِكثارِهِ إِلى إِقلالِه",34,"ل",2,0],["كم عَزْمَةٍ كالشَّهابِ عُدْتُ بها","مَحَتْ مَغِيمَ الهُمومِ فانقَشَعا",35,"ع",2,0],["كَم عاجِزٍ في الناسِ يُؤتى رِزقَهُ","رَغداً وَيُحرَمُ كَيِّسٌ وَيَخيَّبُ",36,"ب",1,0],["كَم عِبرَةٍ لَكَ قَد رَأَيتَ إِنِ اِعتَبَر","تَ بِها وَكَم عَجَباً رَأَيتَ بَديعا",37,"ع",2,0],["كَم عِبرَةٍ لِذَوي التَفَكُّرِ وَالنُهى","في ذا الزَمانِ وَذا الزَمانِ الخالي",38,"ل",2,0],["كَم عِبرَةٍ لَكَ في المُلو","كِ وَفي تَفَرُّقِ شَملِها",39,"ل",3,0],["كَم عائِبٍ لَكَ لَم أَسمَع مَقالَتَهُ","وَلَم يَزِدكِ لَدَينا غَيرَ تَزيِينِ",40,"ن",1,0],["كَم عَكَفنا عَلى المُدامَةِ يَوماً","إِذ دَعانا إِلى المَسَرَّةِ داعِ",41,"ع",1,1],["كَم عُصبَةٍ مُذ بَدا سوءُ الخِلافِ بِها","بادَت بِصارِمِ عَزمٍ مِنهُ مَشهورِ",42,"ر",1,0],["كَم عَنيدٍ أَبدى لَنا زُخرُفَ القَو","لِ وَأَخفى في القَلبِ قَدحَ الزَنادِ",43,"د",1,0],["كم عيروها بسلحفاتها","فلينظروها بجناحٍ تطير",44,"ر",1,0],["كم عُفَاةٍ في بلادٍ نَزَحَتْ","فَسَبَتْ مِنهُم أَياديهِ وُفُود",45,"د",1,0],["كمعشرٍ راقَتْكَ أثوابُهُمْ","وليسَ في جُملتهم من أديب",46,"ب",1,0],["كمعصمِ خَوْدٍ خضَّبَتْهُ وأومأتْ","بهِ في قباءٍ سندسيٍّ تقوَّضا",47,"ض",2,0],["كم عالمٍ عالمٍ يشكو طوى وظما","وجاهلٍ جاهلٍ شبعانَ ريَّانا",48,"ن",2,1],["كمْ عالمٍ قدْ سرى بهْ","ما نالَ لَمْعَ سرابهْ",49,"ب",2,0],["كَم عَدُوٍّ لَنا قُراسِيَةِ العِزْ","زِ تَرَكنا لَحماً عَلى أَوفاضِ",50,"ض",1,0],["كَم عَزمَةٍ بِنَفسِهِ أَمضاها","لَم يَكِلِ الأَمرَ إِلى سِواها",51,"ه",2,0],["كَم عَذولٍ عَلى الخَطي","ئَةِ وَاللَهُ قَد غَفَر",52,"ر",1,0],["كَم عاشِقٍ وَظَلامُ اللَيلِ يَستُرُهُ","لاقى أَحِبَّتَهُ وَالناسُ رُقّادُ",53,"د",1,0],["كم عادَ بَغْيٌ عَلَى قومٍ عليه بَغَوْا","وحاقَ مَكْرٌ بأَقْوَامٍ به مَكَرُوا",54,"ر",3,0],["كم عاوَدَ البُرْءُ مِنْ إِعْلالِهِ جَسَداً","بِلَمِسِهِ واسْتَبانَ العَقْلَ مَخْبُولُ",55,"ل",1,0],["كم عليهِ من غَمامٍ لكما","ولديه من رجاءٍ واعتِداد",56,"د",1,0],["كَم عَفَّةٍ ما عَفَّ عَنها الرَدى","وَكَم دِيارٍ لِأُناسٍ عَفَت",57,"ت",1,0],["كَم عَمَلٍ أَهمَلُهُ عامِلٌ","يَحفَظُهُ خالِقُنا بِاِرتِقاب",58,"ب",1,0],["كَم عايَنَ الفَتَياتِ بَعدَ شَبيبَةٍ","عُجُزاً وَدُنياهُنَّ في الأَعصارِ",59,"ر",1,0],["كَم عاذِلٍ جَرسُهُ في اللَيلِ فائِدَتي","بِهِ كَفائِدَةِ الحُرّاسِ بِالجَرَسِ",60,"س",1,0],["كَم عالَ مِن كافِرٍ وَكافِرَةٍ","مِن اِبتِداءِ الصِبا إِلى الهَرَمِ",61,"م",1,0],["كَم عَبَّدَ الفَتَيانِ الخَلقَ عَن عُرُضٍ","بِذِلَةٍ وَهُما لِلَّهِ عَبدانِ",62,"ن",1,0],["كم عدو يودّ لي خذلاناً","وصديق يهم بالإنجاد",63,"د",1,0],["كَم عَلَيها يبين من كلف كال","خال قد زانَ وجنة الحسناء",64,"ا",2,0],["كم عُذْتَ منه بقبَّةِ الفلَكِ","وصرختَ وحدكَ فيه يا قلبي",65,"ي",1,0],["كم عيونٍ نفَضَتْ أحلامَها","حينَ نادى غيرَ حُلمٍ واحدِ",66,"د",1,0],["كم عصفت منك السوافي الهوج","وهبّت الحاصبة السيهوج",67,"ج",1,0],["كَمْ عَالَجَتْ خُلُقاً فَرُدَّ",