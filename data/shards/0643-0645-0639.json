لرجز"],[456,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[456,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[456,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[456,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[462,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[477,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[480,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[498,"كم عاشق متلذذ","https://www.aldiwan.net/poem38021.html","مجزوء الكامل"],[513,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[527,"إن المرا فعلاته","https://www.aldiwan.net/poem37330.html","مجزوء الكامل"],[549,"رب كن لي منها لباسا حصينا","https://www.aldiwan.net/poem47226.html","الخفيف"],[549,"بني الحفيظة هل للمجد من طلب","https://www.aldiwan.net/poem48043.html","البسيط"],[556,"علم عظيم النفع للعالم","https://www.aldiwan.net/poem34181.html","السريع"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[556,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[560,"لكل قلب حبيب ظل يهواه","https://www.aldiwan.net/poem52742.html","البسيط"],[565,"سيدي أنت مم شكواك قل لي","https://www.aldiwan.net/poem69591.html","الخفيف"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"]],"verses":[["كَم عَمَّمَتني بِالظَلامِ مَطِيَّةٌ","بَعدَ اِعوِجاجِ عَمائِمِ الرُكبانِ",0,"ن",1,0],["كَم عَرَّضوا لِيَ بِالدُنيا وَزُخرُفِها","مَعَ الهَلوكِ فَلَم أَرفَع بِها راسا",1,"س",2,1],["كَمُعاقِدِ الجَبَلِ الأَشَمِّ مُعاقِدي","وَمُجاوِرِ البَيتِ الحَرامِ مُجاوِري",2,"ر",2,0],["كَم عَلى تُربِكِ لَمّا صُرِّعوا","مِن دَمٍ سالَ وَمِن دَمعٍ جَرى",3,"ا",1,0],["كَم عَبرَةٍ مَوَّهتُها بِأَنامِلي","وَسَتَرتُها مُتَجَمِّلاً بِرِدائي",4,"ي",1,0],["كَم عالِمٍ مَدَّ العُلومَ حَبائِلاً","لِوَقيعَةٍ وَقَطيعَةٍ وَفِراقِ",5,"ق",1,0],["كَم عاثَ بِاللَيلِ في الفِراشِ عَلى","كرومِ بُستانِ شُفرِها",6,"ه",2,0],["كَمْ عَزَّ مِنْ ضَعَةٍ شَعْبٌ بِفِتْيَتَهِ","وَكَانَ آبَاؤُهُمْ فِي أَوْضَعِ المِهَنِ",7,"ن",1,0],["كَم عَبرَةٍ فاضَت لَكُم وَتَقَطَّعَت","يَومَ الطُفوفِ عَلى الحُسَينِ نُفوسُ",8,"س",1,0],["كَم عَينِ ذي حِوَلٍ فَقَّأتُ ناظِرَها","وَكَم قَطَعتُ لِأَهلِ الغِلِّ مِن حُمَةِ",9,"ه",1,0],["كم عمرتْ بحسابها من دولةٍ","وبلا حسابٍ كم سختْ بعطاء",10,"ا",2,0],["كم عاذلٍ يغري وواشٍ يتعب","ومراقب بل خائف يترَقب",11,"ب",1,1],["كم عذولٍ على هواك أداجي","يا رشا من سطاه لست بناجي",12,"ج",2,1],["كم عرضنَا مقدِّماتِ أمانٍ","لنداهُ فأحْسنت في النتاج",12,"ج",1,0],["كم عادنا منك ندًى مشهرٌ","لواحظ المدح وأمنٌ منيم",13,"م",1,0],["كم عائذٍ من دهرِهِ","بهمُ إذا ما الدهرُ رابَهْ",14,"ب",2,0],["كم عاتبٍ كلَّ شيءٍ","وكلُّ ما فيه عيبُ",15,"ب",1,0],["كم عدوٍّ لهم غدا وهو مغمُو","رٌ بنعماءَ منهمُ لا مَقُوتُ",16,"ت",1,0],["كم عائلٍ ليست له ضيْعَةٌ","ولا بِهِ سعْيٌ ولا كدحُ",17,"ح",1,0],["كمْ عَارِضٍ رَجُلاً عليَّ مُشَبِّهاً","لأَمِيلَ عنْكَ إليه بالأمْدَاحِ",18,"ح",1,0],["كم عصت الله وما أحسنت","فقحتها شيئاً سوى الطاعه",19,"ع",2,0],["كم عدات نسختَها بعدات","حلَّ إنجازها مع العيوق",20,"ق",1,0],["كم عدو لكم غدا يجتديكم","ولقد بات نابه محروقا",21,"ق",2,0],["كم عالمٍ فيكمُ وليس بأن","قاسَ ولكن بأن رقى فَعَلا",22,"ل",2,0],["كم عرَّضُوا للْمنايا الحمرِ أنفسَهُمْ","فحان قومٌ تَوَقَّوْها وما حانوا",23,"ن",3,0],["كَم عَنَّفونا في الهَوى وَاِستَرسَلوا","لَو أَنَّهُم عَزَفوا الهَوى لَم يَعذِلوا",24,"ل",3,0],["كَم عانَقَت روحي رُباكَ","وَصَفَّقَت في المُنحَنى",25,"ن",2,0],["كم عاهدوا أنهم يأتون معدلة","لكنهم جانبوا الإنجاز لاهينا",26,"ن",2,0],["كمعادن الذهب استقل بتبرها","قوم وزوّد آخرون رغامها",27,"م",3,0],["كم عن يمينك أو يسارك لو ترى","من فيلق متتابع الأمداد",28,"د",1,0],["كَم عِندَنا مِن أَيادٍ","لِلدودَةِ الغَراءِ",29,"ا",2,0],["كَم عَليمٍ سَقَطَ العِيُّ بِهِ","مُظلِمٌ لا تَهتَدي في كُتبِهِ",30,"ه",1,0],["كَم عَزيزٍ عِندَكَ اِستَودَعتَهُ","وَعُهودٍ بَعدَكَ اِستَرعَيتَهُ",30,"ه",1,0],["كَمْ عَرَّضُوا أَيْدِياً بِيضاً مُكَرَّمَةً","للعُدْمِ مِنْ طولِ ما انْتَاشُوا مِنَ العَدَمِ",31,"م",1,0],["كَم عَزيزٍ حَرَبنَ مِن غَيرِ ذُلٍّ","مالَهُ أَو نَزَعنَ عَنهُ ثِيابَه",32,"ب",2,0],["كَم عَزيزٍ أَبادَهُ فَغَدا را","كِبَ عودٍ مُرَكَّبٍ فَوقَ عودِ",33,"د",1,0],["كَم عِداتٍ تَضَمَّنَ الجودُ فيها","رَدَّ إِكثارِهِ إِلى إِقلالِه",34,"ل",2,0],["كم عَزْمَةٍ كالشَّهابِ عُدْتُ بها","مَحَتْ مَغِيمَ الهُمومِ فانقَشَعا",35,"ع",2,0],["كَم عاجِزٍ في الناسِ يُؤتى رِزقَهُ","رَغداً وَيُحرَمُ كَيِّسٌ وَيَخيَّبُ",36,"ب",1,0],["كَم عِبرَةٍ لَكَ قَد رَأَيتَ إِنِ اِعتَبَر","تَ بِها وَكَم عَجَباً رَأَيتَ بَديعا",37,"ع",2,0],["كَم عِبرَةٍ لِذَوي التَفَكُّرِ وَالنُهى","في ذا الزَمانِ وَذا الزَمانِ الخالي",38,"ل",2,0],["كَم عِبرَةٍ لَكَ في المُلو","كِ وَفي تَفَرُّقِ شَملِها",39,"ل",3,0],["كَم عائِبٍ لَكَ لَم أَسمَع مَقالَتَهُ","وَلَم يَزِدكِ لَدَينا غَيرَ تَزيِينِ",40,"ن",1,0],["كَم عَكَفنا عَلى المُدامَةِ يَوماً","إِذ دَعانا إِلى المَسَرَّةِ داعِ",41,"ع",1,1],["كَم عُصبَةٍ مُذ بَدا سوءُ الخِلافِ بِها","بادَت بِصارِمِ عَزمٍ مِنهُ مَشهورِ",42,"ر",1,0],["كَم عَنيدٍ أَبدى لَنا زُخرُفَ القَو","لِ وَأَخفى في القَلبِ قَدحَ الزَنادِ",43,"د",1,0],["كم عيروها بسلحفاتها","فلينظروها بجناحٍ تطير",44,"ر",1,0],["كم عُفَاةٍ في بلادٍ نَزَحَتْ","فَسَبَتْ مِنهُم أَياديهِ وُفُود",45,"د",1,0],["كمعشرٍ راقَتْكَ أثوابُهُمْ","وليسَ في جُملتهم من أديب",46,"ب",1,0],["كمعصمِ خَوْدٍ خضَّبَتْهُ وأومأتْ","بهِ في قباءٍ سندسيٍّ تقوَّضا",47,"ض",2,0],["كم عالمٍ عالمٍ يشكو طوى وظما","وجاهلٍ جاهلٍ شبعانَ ريَّانا",48,"ن",2,1],["كمْ عالمٍ قدْ سرى بهْ","ما نالَ لَمْعَ سرابهْ",49,"ب",2,0],["كَم عَدُوٍّ لَنا قُراسِيَةِ العِزْ","زِ تَرَكنا لَحماً عَلى أَوفاضِ",50,"ض",1,0],["كَم عَزمَةٍ بِنَفسِهِ أَمضاها","لَم يَكِلِ الأَمرَ إِلى سِواها",51,"ه",2,0],["كَم عَذولٍ عَلى الخَطي","ئَةِ وَاللَهُ قَد غَفَر",52,"ر",1,0],["كَم عاشِقٍ وَظَلامُ اللَيلِ يَستُرُهُ","لاقى أَحِبَّتَهُ وَالناسُ رُقّادُ",53,"د",1,0],["كم عادَ بَغْيٌ عَلَى قومٍ عليه بَغَوْا","وحاقَ مَكْرٌ بأَقْوَامٍ به م