tsgate.com/ViewPoem.aspx?id=196967",""],[5030,"لؤم","https://www.poetsgate.com/ViewPoem.aspx?id=215700",""],[1440,"أحببت منه شمائلاً فوجدتها","https://www.poetsgate.com/ViewPoem.aspx?id=106527",""],[5160,"نحنُ القلوبُ الطاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=183333",""],[5183,"روض الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180204",""],[5187,"زيارة لقصر العظم","https://www.poetsgate.com/ViewPoem.aspx?id=29065",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5191,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=212089",""],[5277,"متعاجمٌ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190996",""],[5277,"جُبٌّ...ولا دِلَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199916",""],[5277,"جُبٌّ..ولا دلوَ لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=203009",""],[5353,"طائر الشمال","https://www.poetsgate.com/ViewPoem.aspx?id=212468",""],[5402,"مليكة الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=215511",""],[5425,"لم أَعتَذِر","https://www.poetsgate.com/ViewPoem.aspx?id=207507",""],[5431,"من ذا الذي في عشقه لاينزف؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=190744",""],[5431,"متورطٌ إني به متورط...","https://www.poetsgate.com/ViewPoem.aspx?id=199177",""],[5431,"بورصة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=199785",""],[5436,"ياعيد اهلي / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177540",""],[5464,"بهمومنا لا بالخمور سكارى","https://www.poetsgate.com/ViewPoem.aspx?id=697",""],[5582,"لِمَنْ المَنازِلُ بِالصَّفِيحَةِ تُعْرَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187184",""],[5725,"او كالذي سال الفؤاد الصادي","https://www.poetsgate.com/ViewPoem.aspx?id=198670",""],[5725,"شدوا الركائب","https://www.poetsgate.com/ViewPoem.aspx?id=201720",""],[5751,"أنثى الماس","https://www.poetsgate.com/ViewPoem.aspx?id=214776",""],[402,"بالأمس أكبر صرح جدك","https://www.poetsgate.com/ViewPoem.aspx?id=36023",""],[5829,"رهين بنانك","https://www.poetsgate.com/ViewPoem.aspx?id=205089",""],[5851,"قبس في منتصف الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=175274",""],[5861,"حكاية من الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=188299",""],[5956,"أجمل جنة في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=184960",""],[6031,"إلى الملكِ الوهَّابِ ما في يمينِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46259",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6152,"شوق ثجاج","https://www.poetsgate.com/ViewPoem.aspx?id=202757",""],[6190,"حمَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87010&r=&rc=16",""],[6213,"ما أحيلاه العناق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76271&r=&rc=28",""],[6225,"شراع وريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80914&r=&rc=183",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""],[5567,"يغشى الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81772&r=&rc=40",""]],"verses":[["فَكَأَنَّني بَعِداكَ قَد حَبَطوا","حَبَطاً لِما شَبّوا مِنَ الفِتَنِ",0,"ن",1,0],["فَكَأَنَّني بِعَلائِقٍ شُعَبٍ","قَد زالَ عَن أَمَمٍ تَأَلُّفُها",1,"ف",3,0],["فكأنّنا غُصنانِ يَشكو منهُما","بَرْحَ الغَرام إِلى الرّطيبِ الذّابِلُ",2,"ل",1,0],["فَكَأَنَّني ذو غُربَةٍ","بِمَفازَةٍ مِلحٍ حُساها",3,"ا",3,0],["فَكَأَنَّنِي بِالْمُلْكِ قَدْ عَقَدَ الْحُبَى","وَزَهَا بِفَاخِرِ دِرْهَمٍ إِكْلِيلُهُ",4,"ل",2,0],["فَكَأَنَّنِي بَكَ وَالْفُتُوحُ سَوَافِرٌ","وَالسَّبْيُ قَدْ عَمَرَ الرُّبَى تَنْفِيلُهُ",4,"ل",2,0],["فكأنّني بكَ قدْ نَبَذْتَ مُهَرْقِماً","وقَصَدْتَ في أعْقابِهِ سَفّاجا",5,"ج",2,0],["فكأنّني اسْتَقْرَيْتُ آثارَ النّدى","مِنْ كَفِّ موْلانا أبي الحَجّاجِ",6,"ج",1,0],["فكأنّني قوْسُ السّماءِ إذا بَدَتْ","والشّمْسُ موْلانا أبو الحَجّاجِ",7,"ج",1,0],["فَكَأَنَّني لَعِبَ الهَجِيرُ بِمُهْجَتِي","فِي مَهْمَهٍ وَبَعَثْتَ لِي نَفَسَ الصَّبَا",8,"ب",2,0],["فَكَأَنَّ ناحِلَ جِسمِهِ في ثَوبِهِ","خَلفَ الخُروقِ يُطِلُّ مِن غِربالِ",9,"ل",1,0],["فَكَأَنَّني فِرعَونُ مِص","رَ وَأَنتَ شَيطانٌ رَجيمُ",10,"م",1,0],["فَكَأَنَّنا واوٌ بِعَمروٍ أُلحِقَت","أَو إِصبَعٌ بَينَ الأَصابِعِ زائِده",11,"د",2,0],["فَكَأَنَّني طالَعتُهُم بِوِفادَةٍ","لَم يَستَطِعها عُروَةُ الوَفّادُ",12,"د",1,0],["فكان نُزوله في ساكنيها","نزول الماء في المُهَج الصوادي",13,"د",2,0],["فكأنني البدويّ يسمع راطناً","وكأنما هي أعجمّي طمطم",14,"م",1,0],["فكأنني بك فاتحاً شرقيها","للسدِّ يا مفتاحَ كلّ هناء",15,"ا",2,0],["فكأننا الثغر الشنيب فذا لذا","دانٍ ولكن اللقاءِ عزيز",16,"ز",1,0],["فكأَنَّ نائله أرادَ فَضِيحتي","مما اعتلى مَتْحِي هناك مِتَاحُه",17,"ح",2,0],["فكأنني بك قد نجوتَ محمداً","في النائبات كما دُعيت محمدا",18,"د",2,0],["فكأنني بك قد نُعي","تَ وقد بكى الباكُون فقْدَك",19,"ك",1,0],["فكأنني بسؤالهم متنوِّرٌ","شُعلَ الذُّبالِ وللنهارِ ترحُّلُ",20,"ل",1,0],["فَكَأَنَّني فُلكٌ وَهَتَ أَمراسُها","وَالبَحرُ يَطغى حَولَها وَيَثورُ",21,"ر",1,0],["فَكَأَنَّني ماءُ الغَمامِ إِذا اِنطَوى","في الأَرضِ رَدَّتهُ نَباتاً مُثمِرا",22,"ر",2,0],["فَكَأَنَّني البُستانُ جَرَّدَ نَفسَهُ","مِن زَهرِهِ المُتَنَوِّعِ المُتَضَوِّعِ",23,"ع",1,0],["فَكَأَنَّنا في عالَمٍ غَيرِ الَّذي","تَتَزاحَمُ الأَيدي بِهِ وَالأَرجُلُ",24,"ل",1,0],["فكأَنَّنا نحيا بأَعصابٍ","من المَرَحِ المُثيرْ",25,"ر",1,0],["فكأننَّي بك بين نسلٍ طاهرٍ","تَردي أمامَك في الحديدِ وتَرفُلُ",26,"ل",1,0],["فكأننا في الحب أهل ديانة","وكأنه في العذل أهل شقاق",27,"ق",1,0],["فكأنَّني بجبينِه في مأزقٍ","متمزِّقٍ عنه دُجى ظلمائِه",28,"ا",3,0],["فَكَأَنَّ نَغمَةَ عودِها في صَوتِها","وَكَأَنَّ رِقَّةَ صَوتِها في عودِها",29,"د",3,0],["فَكَأَنَّني بِالرَوضِ قَد أَجلى لَها","عَن حُلَّةٍ مِن وَشيِهِ أَفوافِ",30,"ف",1,0],["فكأنَّني بالفضَّةِ ان","فَضَّتْ وقد ذهبَ الذهبْ",31,"ب",1,0],["فَكَأَنَّ نائِسَهُ العَرا","رُ عَرارُ بُطنانِ الخَمائِل",32,"ل",1,0],["فَكَأَنَّ نورَهُ","نَبذُ شَيبٍ وَخَطا",33,"ط",2,0],["فَكَأَنَّني رَوَّعتُ ظَبيَ نَقاً","في عَينِهِ سِنَةٌ تُغالِبُهُ",34,"ب",2,0],["فكأنَّني ألفَيْتُ مُقْلَةَ فاقِدٍ","ثَكْلَى ومُوجَعَةٍ تُصِيبُ عَوِيلا",35,"ل",2,0],["فكأنّنَا شَمْلُ الدّموعِ تَفَرُّقاً","وكأنّنَا سِرُّ الوَداعِ نُحُولا",36,"ل",2,0],["فكأنَّني بالجيش قد ضاقتْ بهِ","أرضُ الحجازِ وبالمواسمِ دُلَّفا",37,"ف",2,0],["فَكَأَنَّنا عَسَلٌ بِماءِ سَحابَةٍ","بَعدَ التَفَرُّغِ بِالأَناةَ أُعيدا",38,"د",2,0],["فكأَنَّنَا عُمْيٌ نُسا","قُ على العَمَى في ظِلِّ عاتِمْ",39,"م",1,0],["فكأَنَّ نَرْجِسَهَا وقَد حَشَدَتْ به","زهْرُ النُّجُومِ تقارَبَتْ في مَطْلَعِ",40,"ع",1,0],["فَكَأنَّنَا فِيمَا نُطَالِعُ عَنْهُ","نَشْهَدُ فَضَلَ كَدِّكْ",41,"ك",1,0],["فَكَأَنَّني رَيّان مِن","قَدَحِ النَديمِ وَكوزِهِ",42,"ه",1,0],["فكأنَّنَا قُمْنَا نُؤيِّ","دُ فيه مُعْتقَدَ المَجُوس",43,"س",1,0],["فكأنَّني أبصرتَ جِبْرِيلاً بها","بين الصفوف مُهَلِّلاً ومُكبِّر!",44,"ر",1,0],["فكأنني بالملك قد عقد الحبا","وزها بفاخر درهم إكليله",45,"ل",2,0],["فكأنني بك والفتوح سوافر","والسبي قد غمر الربا تنفيله",45,"ل",2,0],["فكأنني لَهَبَ الهجيرُ بمُهْجتي","في مَهْمَه وبعثتَ لي نَفَس الصَّبا",46,"ب",2,0],["فكأنني بك قد نُعيص","تَ وقد بكى الباكُون فقْدَك",47,"ك",1,0],["فكأنني الرجل الخؤن بعينه","ويرى الامانة حلية الخوان",48,"ن",1,0],["فكأنني عبود في إِسلامه","أو حمزة العربي في إِيمانه",49,"ن",2,0],["فكَأَنَّنِي وَكَأَنَّها وَكَأَنَّهُ","صُبحانِ باتا تَحتَ لَيلٍ مُطبِق",50,"ق",1,0],["فكأنّني مستعلمٌ من عفّةِ","الملكِ الأشم السيد القَمْقَامِ",51,"م",1,0],["فكأننا خرس بدون إشارةٍ","وعلى الأحقّ جوامدٌ تتحركُ",52,"ك",1,1],["فكأنني بك في القيامة نادماً","أسفاً تعضُّ أنامل المتحسِّر",53,"ر",1,0],["فَكَأَنَّني وَحَبِيبُ قَلْبي مُنْشِدٌ","يا رَبْعَ خَوْلَةَ مِنْ هَوَاكِ خَلِينا",54,"ن",2,0],["فَكأنَّنا صُبْحانِ في لَيْلٍ حَوى","فَجْرَيْنِ بَيْنَهُما ظَلامٌ مُطْبِقُ",55,"ق",1,0],["فكأنني بعضُ الملائكةِ التي","لا تغتذى وكأن بيتيَ مسجد",56,"د",1,0],["فكأننا ليكائهم في مأتمٍ","طولَ الزمانِ وما لنا من نفقد",56,"د",1,0],["فكأنني ظمآن ضلَّ بقَفْزةٍ","حتى انتهى يأسا فصَابَ النِّيلا",57,"ل",2,1],["فكأنني كَفّا مُحِبٍّ شَبَّكَتْ","يومَ الفراقِ أَصابِعا بأَصابع",58,"ع",1,0],["فكأنني ظمآن ضَلَّ بقَفْزةٍ","حتى انتهى يأسا أصاب النيلا",59,"ل",2,0],["فكأننا قيس وليل","ى إذ غرقنا في ا