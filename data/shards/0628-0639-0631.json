{"poems":[[73,"أحاجي وقد أصبحت عنها بمعزل","https://www.aldiwan.net/poem3837.html","الطويل"],[53,"ألا رب أشياء مذكورة","https://www.aldiwan.net/poem8127.html","المتقارب"],[47,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[63,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[82,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[50,"يا أيها المطنب ذا الغرور","https://www.aldiwan.net/poem63413.html","الرجز"],[50,"عوجا صدور النجائب البزل","https://www.aldiwan.net/poem65038.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[119,"لسراج الأنبيا حامي النزيل","https://www.aldiwan.net/poem41965.html","الرمل"],[119,"قرب الحبيب وقد تباعد وصله","https://www.aldiwan.net/poem41972.html","الكامل"],[137,"أعليت دين الواحد القهار","https://www.aldiwan.net/poem4234.html","الكامل"],[154,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[154,"تبارك رب عمنا بحبائه","https://www.aldiwan.net/poem68601.html","الطويل"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[199,"عرف الديار توهما فاعتادها","https://www.aldiwan.net/poem54421.html","الكامل"],[264,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[276,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[387,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[408,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[438,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[447,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[466,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[469,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[543,"هنيئا بعرس سرور زها","https://www.aldiwan.net/poem47518.html","عموديه"],[556,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[572,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53733","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126714","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38177","المتقارب"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19962","البسيط"],[1220,"","https://poetry.dctabudhabi.ae/diwan/poem/111218","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64570","الطويل"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134230","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109492","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109413","السريع"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104981","البسيط"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111153","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116502","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65937","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74336","الرمل"],[3082,"","https://poetry.dctabudhabi.ae/diwan/poem/202457","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132577","الوافر"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128322","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86242","الطويل"],[3540,"","https://poetry.dctabudhabi.ae/diwan/poem/100522","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129374","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59484","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135741","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95371","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40138","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111435","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101360","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107041","الطويل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90800","الرمل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105509","البسيط"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89592","المديد"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107132","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139530",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139659",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139793",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139641",""],[4680,"سلاماً يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=185027",""],[4578,"قلَ الريحان في الورد أجاد","https://www.poetsgate.com/ViewPoem.aspx?id=49392",""],[4859,"ريح الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=186716",""],[4935,"ببسم الله قم واقراً","https://www.poetsgate.com/ViewPoem.aspx?id=129447",""],[4978,"لأستاذي من القلب التحية","https://www.poetsgate.com/ViewPoem.aspx?id=180852",""],[5431,"وبالخيبات قد رجع البريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=191824",""],[5431,"وضياءات للرؤى في الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=197022",""],[5632,"برآة طفل","https://www.poetsgate.com/ViewPoem.aspx?id=178124",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[199,"عَرَفَ الدِّيَارَ تَوَهُّماً فاعْتَادَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=20775",""],[199,"كُلَّمَا رَدَّنَا شَطاً عَنْ هَوَاهَا","https://www.poetsgate.com/ViewPoem.aspx?id=14100",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِعُريانَ لَولا الريقُ ما راقَ فِعلُهُ","لَهُ هامَةٌ مَلمومَةٌ ضَخمَةٌ مَلسا",0,"س",2,0],["بِعرْسٍ وآوَى وما أشْبها","وكابنِ الرُّخاميِّ طيفِ الكَرى",1,"ر",2,0],["بِعَرائِسٍ خُضرِ الغَلائِلِ تَرتَمي","بِنَواظِرٍ نُجلٍ مِنَ العِقيانِ",2,"ن",1,0],["بِعَريقٍ في الأزدِ طابَ أُصولاً","في صَعيدِ العُلى وطابَ طُروقا",3,"ق",2,0],["بعرَمرَم رَكبت لإِرجالِ العِدى","عقبانُ جوٍّ فيه أُسْدَ حروبِ",4,"ب",1,0],["بِعَرصَةِ الإِناثِ وَالذُكورِ","وَطَرَدِ الغَيورِ كَالغَيورِ",5,"ر",1,0],["بِعِرمِسٍ أُمُّها الشَمالُ وَتَع","تَدُّ بِصِهرٍ في البَرقِ لا يَنكِل",6,"ل",1,0],["بِعَرُوسٍ شَرِيكَةٍ فِي الْحَيَاةِ","إِلْفُ عُمْرٍ وَالإِلْفُ لِلإنْسَانِ",7,"ن",1,0],["بعريض الذنب مني والطويل","لذت في أعتبابه دار الحضور",8,"ر",1,0],["بعريض جاه محمد مولى الورى","من أغمر الأكوان طرا فضله",9,"ل",2,0],["بعرابِ خيلٍ فوقهُنَّ أعارِبٌ","من كل مقتحمٍ على الأخطارِ",10,"ر",1,0],["بِعِرفانِهِ اِنجابَت دَياجي المَناكِرِ","وَبُدِّلَ ناسِ لِلعُهودِ بِذاكِرِ",11,"ر",1,0],["بِعَرفِ المِسكِ طيبُ ثَنائِهِ","وَمَن ذا يُسامي المُصطَفى في سَنائِهِ",12,"ه",1,0],["بِعروجِ العرشِ فاقَ المُصطفى","كلّ عبدٍ كانَ لو لم يكنِ",13,"ن",1,0],["بِعَرَمرَمٍ يَئِدُ الرَوابي ذي وَغيٍ","كَالحَرَّةِ اِحتَمَلَ الضُحى أَطوادَها",14,"د",3,0],["بعرائس قدسٍ قد جليت","بحُلَى الأسرار وبالدعج",15,"ج",1,0],["بعر مرم في الخافقين غباره","صعدا وَفي أذن السماك زمائمه",16,"م",2,0],["بِعُرىً دونَها وَتُقرَنُ بِالقَي","ظِ وَقَد دَلَّهُ الرِباعَ البُغامُ",17,"م",1,0],["بِعُرى الرَّحمنُ كنْ مُسْتمسكاً","إنّه مَا لِعُرى اللهِ انْفصامُ",18,"م",1,0],["بعرَنْدَسٍ كالطودِ خَلْقاً لم يزلْ","وقفاً على الإتهامِ والإنجادِ",19,"د",1,0],["بعروتك الوثقى تمسكت أن لي","بها مانعاً عما أخاف منيف",20,"ف",1,0],["بِعَراءٍ نازِحٍ ذي غَرَرٍ","يحذرُ القانصُ منه ما اشمَعَلْ",21,"ل",1,0],["بعرامسٍ مثل القسيّ تناقلت","كالسَّهم أضعفه الزمان وأوهنا",22,"ن",2,0],["بِعُرسٍ تَسَامى عَلاَ إذ بدَت","تَهانٍ لباشا ندىً يُزدَهَى",23,"ه",2,0],["بعِرضٍ لا أجود به مصونٍ","ومالٍ لا أضنُّ به مُذالِ",24,"ل",1,0],["بِعَرْفٍ كَكُسُورِ النَّدِّ","بِالْعَنْبَرِ مَعْجُونَهْ",25,"ن",2,0],["بعريش تَرَى من الزاد فيه","زُكْرَتَيْ خمرة وصقرا صيودا",26,"د",2,0],["بِعُرسكَ تمّ الهنا والسرور","وأهل الولاءِ به عيّدوا",27,"د",3,1],["بِعَرشِكَ بِالكرسي بِلَوحٍ حَفِظتهُ","وَبِالقَلَمِ المُحصي لِما نُخفي أَو نُبدي",28,"د",2,0],["بِعَرشِ المَعالي لِكرسيِّ مَجدٍ","عَلَيهِ تَربّى بَنى العزَّ دارا",29,"ر",2,0],["بعرضةٍ جانب الأدنون جانبها","والأهل بالشام والإخوان باليمن",30,"ن",1,0],["بعرس فتى يلوح عليه فخر","وعز راق كالتبر المذاب",31,"ب",1,0],["بعروة ركن للاله شديد","وتفويض أمري للمدبر خيرتي",32,"ي",1,0],["بعرس ابنه روضي لقد عاد مزهراً","وأيامنا يرفلن في حلل خضر",33,"ر",1,0],["بعروتها الوثقى تمسكت وانثنى","فؤادي له منها صبابة عروة",34,"ه",1,0],["بعرس اخوتك المسعود طالعهُ","لكِ الهناءُ ودام الحظ مشتركا",35,"ك",2,0],["بعرس من فينا غدا صالحاً","للمدح منسوباً إلى خير آل",36,"ل",1,0],["بعرس جعفر والعباس دام لكم","نيل المنى والهنا والبشر مؤتلفا",37,"ف",2,0],["بعرس موري زناد الفضل فيصلها","من قوله الفصل والجوزا منازله",38,"ل",2,0],["بعرضى عروض الخير دون تود","اليك وتوحيدي فحقك اكبر",39,"ر",1,0],["بعرصة نزوى ذات دين وعفة","وحلم رسيب كالجبال الرواسب",40,"ب",1,0],["بِعُرى عَقل رَصين","وَقوى فكر مَتين",41,"ن",1,0],["بعروتك الوثقى وأسمائك التي","تعلمها موسى الكليم من الخضر",42,"ر",1,0],["بعرس دائم البهجة","زاه زاهر السعد",43,"د",1,0],["بعروة والذي بسهام هند","أصيب فما أقدن ولا ودينا",44,"ن",2,0],["بِعَروَتِهِ الوُقى الرَعايا تَمَسَّكوا","وَقَد عَقدت مِنهُم عَلَيها الخَناصِر",45,"ر",1,0],["بعرس فتىً أن امتدحه فإنما","تخط بناني ما مكارمه تملي",46,"ل",2,0],["بعرمرم شمس النهار بنقعه","قد كورت كظلام ليل ساتر",47,"ر",1,0],["بعريض الخّدِ عريض الجن","بِ عريض الصَّهوةِ والكَفلِ",48,"ل",1,0],["بعروة وُثقى صراطِ اللهِ","صُدَّ شرورَ ذاكرٍ ولاهي",49,"ي",1,0],["بعرمرم بالخافقين مخيم","وعلى دراري النجوم مطنب",50,"ب",1,0],["بعَرَمْرَمٍ صَلَمَتْ وعاوِعُه عُرَى","أسماعَ جَيْحُون وسيف البربَرِ",51,"ر",1,0],["بِعُرى العَسجَدِ زَرَّت وَاِنثَنَت","لِناطاقٍ يَشمَلُ القَدَّ الرشيق",52,"ق",1,0],["بِعُرَى اللُّجَينِ أَناطَهُ واعتَاضَ دِر","عَ أَخِيهِ لِيقاوُونَ عن نَتَراتِهِ",53,"ت",2,0],["بِعُرَاهُ شَدَّ يَقِلُّ رُمحاً ساطِعاً","فُولاذُهُ ثُمَّ السَّفائِنَ يَمَّما",54,"ا",1,0],["بعرسه بارق الاقبال مؤتلق","فقل به اليوم ما أجلى تألقه",55,"ق",2,0],["بعرس فتى فاتت مكارمه ومن","تعود بسط الراحتين إلى الوفد",56,"د",1,0],["بعرس هلال تمنى الهلا","له صيغ طوقاً ليزهو منيرا",57,"ر",2,0],["بعروس يابن ودي مهرها","مهج نصلى بذات الشرر",58,"ر",1,0],["بعرس بدر العلى السامي بمفخره","على البرية من بدوٍ ومن حضر",59,"ر",1,0],["بِعَراقٍ قيلَ مِن فَدَحٍ","وَسَناً مِنهُ بِأَندَلُسِ",60,"س",1,0],["بعرس حبيب أشرقت مصر بالسنا","وجاد له الاقبال والعز والفخر",61,"ر",1,0],["بعرسٍ به الدهر احتبى بتنعُّمِ","به لم يزل برد المسرَّة ساحبا",62,"ب",2,0],["بعرس لقد عمَّ الأنامَ حبورُه","وقد خصَّ في أسنى المسرات طالبا",62,"ب",2,0],["بعرس ندبٍ قد سما همةً","طالت سماوات المعالي الشداد",63,"د",1,0],["بعرس الهمام مفيض المنن","زها الدهرُ في صفوه والزمن",64,"ن",1,1],["بعرس جنكي شاه سُرَّ العباد","وعمَّت البشرى جميعَ البلاد",65,"د",1,1],["بعرس ذى فضلٍ سما همةً","طالت سماوات المعالي الشداد",65,"د",1,0],["بعرقك يا عراق دمٌ أبيٌّ","بعزمكَ لن يُذلَّ ولن يُضاما",66,"م",2,0],["بعرب اللفظ فما يعرب أن","قيس أو قيسٌ وما شخ أياد",67,"د",1,0],["بعروقه يجري الخداعُ ولاترى","عيناه عمداً حولها الأشياءَ",68,"ا",2,0],["بعرفاني تنال علا","فجد وسد بها فورا",69,"ر",2,0],["بعرفانٍ وشكر مستمرٍّ","لأفضال توالت حاتميّةْ",70,"ي",2,0],["بعرشِ القلب منفردٌ فريدُ","لهيبته يلين له الحديدُ",71,"د",1,1],["بعراءاتٍ في القلوب أصيبوا","لبسوا حقدهم وذل امتهان",72,"ن",1,0],["بعر ناقة على شوكه","تحقق كل رجاوينا",73,"ن",2,0],["بعروبةِ الأحلامِ بين رياضِهِ","وسماحةِ الإسلامِ غُرَّةِ فَجرِهِ",74,"ر",2,0],["بعرمرمٍ - تبدو الروابي - ذي وعى","كَالْحِرَّة ِ احْتَمَلَ الضُّحَى أَطْوَادَهَا",75,"د",3,0],["بِعُرَابٍ إلَى الإلاهَة ِ حَتَّى","تبعت أمهاتها الأطلاء",76,"ا",2,0],["بعرش زلفاه الذي فيه استوى","يا فالق الحب وفالق النوى",77,"ن",3,0]]}