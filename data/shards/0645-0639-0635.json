{"poems":[[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[2,"هل في تذكر أيام الصبا فند","https://www.aldiwan.net/poem25036.html","البسيط"],[54,"معصفرة أنخت بها","https://www.aldiwan.net/poem27256.html","مجزوء الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[234,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[302,"معصيتي أعظم من طاعتي","https://www.aldiwan.net/poem33160.html","السريع"],[369,"نشر المنى طاوي السهوب","https://www.aldiwan.net/poem60995.html","مجزوء الكامل"],[401,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[409,"بذكرك يا رب الخلائق أبتدي","https://www.aldiwan.net/poem33942.html","الطويل"],[449,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[534,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[556,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[563,"ركب شوق بدار قلبي أناخا","https://www.aldiwan.net/poem34657.html","الخفيف"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136367","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35766","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79895","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48958","الكامل"],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146065","البسيط"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95398","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53033","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77303","الخفيف"],[2825,"","https://poetry.dctabudhabi.ae/diwan/poem/130729","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202726","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103439","الطويل"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31664","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89273","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107098","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109976","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109981","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135490","المديد"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102984","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36617","الدوبيت"],[129,"","https://poetry.dctabudhabi.ae/diwan/poem/203067","البسيط"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105166","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120233","الكامل"],[4988,"ارطغرلّ","https://www.poetsgate.com/ViewPoem.aspx?id=198225",""],[5038,"في الحكمة / الصدق2","https://www.poetsgate.com/ViewPoem.aspx?id=190168",""],[5402,"لو تدري مافعلت بنا الأسماك","https://www.poetsgate.com/ViewPoem.aspx?id=215528",""],[5725,"آه لو يفصح","https://www.poetsgate.com/ViewPoem.aspx?id=211663",""]],"verses":[["مَعصوبُ المُقلَةِ وَالدَربُ","وَعرٌ وَكَثيرُ الآفاتِ",0,"ت",1,0],["مُعصَوصِباتٌ يُبادِرنَ النَجاءَ بِنا","إِذا تَرامَت بِها الدَيمومَةُ الجَدَدُ",1,"د",1,0],["مُعَصفَرَةٌ أَنَختُ بِها","وَقَرنُ الشَمسِ لَم يَغِبِ",2,"ب",1,1],["معَ صِهرٍ كانَ الرَّجاءَ فأَدَّي","تُ حبيباً صاحَبتُه بجَمالِ",3,"ل",1,0],["معصومة الذروة لا يبلغها","الا همام باللهاميم اقتدى",4,"ا",1,0],["مِعْصَمها من سوارها اعتَقرا","وخدُّها من لِحاظها انفطرا",5,"ر",2,1],["معصيَتي أَعظَمُ من طاعَتي","لكن رَجائي منهما أَعظَمُ",6,"م",1,1],["مَع صَفوِ وُدٍّ خالص","لا بالمخوضِ ولا المَشوب",7,"ب",1,0],["مُعصَّباً من صباحٍ لا طعامَ له","ولا رَعيّةَ إِلا الطوفُ والعَسسُ",8,"س",1,0],["مع صنوه المنصور أفضل قائم","من الآل واسأل كل هاد ومهتد",9,"د",1,0],["مع صحب من كرام الوطن","أطرأوا نثري وشعري النظيم",10,"م",1,0],["مَعَ صِفاتٍ فائِقَهْ","وَفي سِماتٍ رائِقَه",11,"ه",1,0],["مُعَصْفَرَ الأرْفاغِ مَوْشِيَّ المَطا","مضرَّجاً إمّا دماً أو عَنْدَما",12,"م",2,0],["مع صحب عن العيان استقلوا","فطووه سباسباً وسباخا",13,"خ",2,0],["معصم يدعو عليه","كل من صاغ السوارا",14,"ر",2,0],["معصفرةُ اللّبوسِ وآلُ حامٍ","نساؤهُمُ مُعَصْفَرَةُ اللبوس",15,"س",1,0],["معصوصبات وسط الأَزِقّة قَد","أَبرزها لِلعُيون ساتِرها",16,"ر",3,0],["مع صدق الاقبال في كل أمر","قد قصدنا والصدق في كل نيه",17,"ي",2,0],["معصوب وافر بصاد مهمله","كهزج قد صح في التشبيه له",18,"ه",1,0],["مِعصَمٌ بِالفرارِ تَحمِلُهُ الرَه","بَةُ بَينَ الإِيضاعِ وَالإيجافِ",19,"ف",1,0],["معصومةٍ بالتقى من كلِّ سيِّئةٍ","عن مدحه أيُّ حسنى غيرُ مُنبَئةٍ",20,"ه",1,0],["معصورةٌ بيدٍ مطّهرةٍ","في حين لا خمرٌ ولا عِنبُ",21,"ب",1,0],["معصية اللائمين فيها","فهي وكلتاهما وتمرا",22,"ر",2,0],["مع صحن قشطاء به أمزجها ولا","تخش فذا يا صاحبي مطلوبي",23,"ب",2,0],["معصومة أهواؤه مدعومة","علياؤه معدومة نظراؤه",24,"ا",3,0],["مِعصَمي ناعِمٌ وَنَحري لَطيفٌ","آه لا تَقطَعوهُ حَبلَ وَريدي",25,"ي",1,0],["معصم الملك تاج كل فخار","راية المجد عدة الأيام",26,"م",1,0],["معصورةٍ بالإثم لا الايمان","ما احتاج شاربها لكوبٍ ثان",27,"ن",1,0],["معصَّبةٌ بالقِدِّ ذات نواشرٍ","لها من خطاطيف الحديد ظفور",28,"ر",1,0],["مُعَصْفَرُ التُّفّاحِ في","خَدِ مَليحِ الضَّرَجِ",29,"ج",1,0],["مع صاحب صادقٍ وقاه","بالنفس من صاحب الصليل",30,"ل",1,0],["مع صرف ظأب وظأم ظأن أي سلف","ظف واظأف اطرد وظأظاء مرادف ظا",31,"ظ",2,0],["مع صِنوهِ عُمَرَ النبيهِ ومَن لهُ","رأيٌ بهِ القفرُ اليَباب يُعمَّرُ",32,"ر",1,0],["معصومَةً من خطاءِ الجِدِّ ليسَ بها","من وَصمةٍ فعليها قَطُّ لم يُقَسِ",33,"س",1,0],["مع صدرٍ فيه ثديٌ","فوق عكن ملتقاتِ",34,"ت",1,0],["معصورة بالوهم لم تذكر لها","أهل العصور السالفات عصيرا",35,"ر",2,0],["مَع صَدِّك يَزداد لِقَلبي مَيلُه","وَالدَمعُ عَلى خَدّيَ يَطغَى سَيلُه",36,"ه",1,1],["معصفر الحسن للأبصار ناصعه","كأنه فضة شيبت بعقيان",37,"ن",1,0],["معصورة من لمى في شادن وسن","تنفي الهموم وما بالقلب من عطب",38,"ب",1,0],["مع صون معنى الاصل عما","لا يلائم او يناسب",39,"ب",1,0],["مع صحبك الأخيّار حطّمت الاصنام","واسست بالإصرار نهجٍ مشوبه",40,"ب",2,0],["مَعَ صِدْقِهِ مَوتُ الْفَتى لَسَعادَةٌ","والْكِذْبُ يُتْعِسُ عِيشَةَ الْإِنْسانِ",41,"ن",1,0],["مع صحبة جالوا الفؤاد بشعرهم","فكانهم في منزلي افلاكُ",42,"ك",1,0],["معصرات الشوق تستمطرني","من غيوم العين دمعاً ينضحُ",43,"ح",1,0]]}