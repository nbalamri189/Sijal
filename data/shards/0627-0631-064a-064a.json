{"poems":[[55,"ما بعد يومك ما يسلو به السالي","https://www.aldiwan.net/poem29885.html","البسيط"],[73,"أرى يحيى تعرض لي بسوء","https://www.aldiwan.net/poem3760.html","الوافر"],[82,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[82,"بكى فقدكَ العزُّ المؤيد والمجد","https://www.poetsgate.com/ViewPoem.aspx?id=3164",""],[261,"أميري يا من ندى كفه","https://www.aldiwan.net/poem48537.html","المتقارب"],[520,"تناولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[556,"أفي كل يوم لي حميم أفارقه","https://www.aldiwan.net/poem47369.html","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109679","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76025","الطويل"],[3264,"","https://poetry.dctabudhabi.ae/diwan/poem/198457","الخفيف"],[4181,"","https://poetry.dctabudhabi.ae/diwan/poem/56","الطويل"],[5038,"كيف يغنيك القليل","https://www.poetsgate.com/ViewPoem.aspx?id=190125",""],[5225,"نصيحه منه تحتاج إلنصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=27612",""]],"verses":[["أَرى يَقينَ المُنى شَكّاً فَأَرفُضُهُ","ما أَشبَهَ الماءَ في عَينَيَّ بِالآلِ",0,"ل",1,0],["أَرى يَحيى تَعَرَّضَ لي بِسوءٍ","تَعَرُّضَ عَقرَبٍ ولعت بِحَيَّه",1,"ه",1,1],["أَرى يُمْنَ مَيمونٍ تَعاظَمَ في العُلا","بنيلِ مَعَالٍ لا يُحَدّ لها حَدُّ",2,"د",1,0],["أرى يمنَ ميمون تعاظم في العلى","بنيلِ معالٍ لا يحدّ لها حدُّ",3,"د",1,0],["أرى يومنا يوم كأسٍ تدو","ر من يد ذي دعجٍ أحور",4,"ر",1,0],["أرى يا ورد ضدك في انخفاض","وجدك في علو وارتفاع",5,"ع",1,0],["أرى يومَه يومي وأشعرُ فقدَه","بأنّي وإنْ طال التّلَوُّمُ لاحقُهْ",6,"ق",2,0],["ارى يا ابن باز اللَه في مركز العلا","بك الساريات السبع صارت ثمانيا",7,"ي",2,1],["أَرى يَقظَتي تُبدي لَطائفَ حكمةٍ","وَفي هجعتي وَهناً أشيم البَوارِقا",8,"ق",2,0],["أرئيس الزمان أغفلت أمري","وتلذذت تاركاً لي بأسر",9,"ر",1,1],["أَرى يَومَ شَرُّ شَرُّهُ مُتَفاقِمٌ","وَقَد حَمَّلَتكَ اليَومَ أَحسابِها مُضَر",10,"ر",1,0],["أرى يومَ الرّحيلِ يكادُ يدْنو","كأنّ حرابَهُ سيفٌ صقيلُ",11,"ل",1,0],["أرى يومَ الحسابِ وقدْ تجلّى","تكافلْنا فما نفعَ الكفيلُ",11,"ل",1,0],["أرى يا سيّدي بعض الشّريحهْ","بطانة رمّةٍ تحتْ التّرابي",12,"ب",2,0]]}