"],[106,"مؤامرة على شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179739",""],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[77,"مولايَ يا خيرَ مُلوكِ الوَرى","https://www.poetsgate.com/ViewPoem.aspx?id=33310",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[45,"زَعَمَ الغُرَابُ مُنَبّىءُ الأنْبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=32958",""],[51,"أجدرُ مالٍ أن يكون نائلاً","https://www.poetsgate.com/ViewPoem.aspx?id=30252",""],[51,"أفسدتْ توبتي عليَّ غلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30611",""]],"verses":[["مِن قَبلِ أَن يَغلَقَ يَوماً رَهني","مَتى تَراني وَالجَوادُ خِدني",0,"ي",1,0],["مِن قُلوبٍ يَدمى بِها ناظِرُ الوَج","دِ وَمِن أَدمُعٍ مَراها الهُمولُ",1,"ل",1,0],["مِن قَبلِ أَن تَرِدَ الخُطو","بُ عَلى مَوَدَّتِنا طِراقا",2,"ق",2,0],["مِن قائِمٍ عَلى العُلا ما أَحفَظَك","ما نامَ عَن حاجَتِهِ مَن أَيقَظَك",3,"ك",1,0],["مُنقَعاً في ماءِ النَجابَةِ مَنسو","باً لُباباً إِلى المَناجيبِ مَحضا",4,"ض",2,0],["مِن قُلوبٍ لَها التَقَلُّبُ في العَز","مِ وَأَيدٍ طَليقَةٍ بِالأَيادي",5,"د",2,0],["مَن قاسَ ذا شَرَفٍ بِهِ فَكَأَنَّما","وَزَنَ الجِبالَ القودَ بِالأَشباحِ",6,"ح",1,0],["مَن قَضى عُقبَةَ الثَلاثينَ يَغدو","راجِعاً يَطلُبُ الصِبا هَيهاتا",7,"ت",2,0],["مِن قَبلِ أَن أَعرِضَ الفِراقَ عَلى","قَلبي وَأَن اِستَعِدَّ لِلحَزَنِ",8,"ن",1,0],["مَنْ قاسَ ذاتَكِ بالذّواتِ فإنّهُ","جهِلَ الوِزانَ وأخْطأ التّقْييسا",9,"س",2,0],["مَنْ قُلْتَ يَا عَمِّ لَهُ مَرَّةً","ثِقْ بِتَعَاطِيهِ وَإِعْجَابِهِ",10,"ب",2,0],["مِن قَبلِ أَن يُهزَمَ التَسَلّي","وَيَغلِبَ الشَوقُ ما يَليهِ",11,"ي",2,0],["مَن قالَ إِنَّكَ لَستَ أَوحَدَ في النُهى","وَالصالِحاتِ فَدانَ بِالإِشراكِ",12,"ك",1,0],["منقشة الوجهين","جميلة الرسمين",13,"ن",1,0],["مَنْ قَضَى هكَذَا شَهِي","داً فَمِنْ أَهْلِنَا هُوَا",14,"و",2,0],["مَنْ قَالَ لِلْمَطْلَبِ الْبَادِي تَعَذُّرُهُ","عِنْدَ اجْتِمَاعِ الْهَوَى وَالرَّأْيِ كُنْ يَكُنِ",15,"ن",1,0],["من قرا سورة تبارك","قد فهم هذا السريرا",16,"ر",2,0],["من قاس كفك بالغمام فإنه","جهل القياس ومثلها لا يجهلُ",17,"ل",1,0],["من قاسَ بالشمس المنيرة وجههه","ألفَيْته في حكمه لا يعدلُ",17,"ل",1,0],["من قاس بالبدر المنير كمالَه","فالبد ينقص والخليفةُ يكمُلُ",17,"ل",1,0],["من قِصّة واقصة غصّة","تُضحك بل تدعو إلى الانتحاب",18,"ب",1,0],["منقوصة حتى بميراثها","محجوبة حتى عن المَكْرُمه",19,"م",2,0],["من قال بت أخا الهموم ومن يبت","غرض الهموم ونَصْبِهنَّ يُؤرَّقِ",20,"ق",1,1],["من قال اضعف أضعافاً على هرم","في الجود بدَّ الحصى قيلت له أجل",21,"ل",1,1],["مِن قُرُبٍ فَأَرسَلوا إِلَيها","وَلَم تَزَل أَعيُنُهُم عَلَيها",22,"ه",2,0],["مِن قَبلِها طِبتَ في الظِلالِ وَفي","مُستَودَعٍ يَومَ يُخصَفُ الوَرَقُ",23,"ق",1,1],["من قبل ما عملت لديه عقيقة","عملت له المدح الجواري جوهره",24,"ه",1,0],["مَن قام فيهِ بِحَقِّهِ وَحُقوقِهِ","وَخَلا عَنِ الحَدَثانِ وَالأَشباحِ",25,"ح",1,0],["من قرينَيْنِ أصبحا في غِناءٍ","وفريدين أصبحا في انتحابِ",26,"ب",1,0],["مَنْ قائلٌ عني لمن أحبَبْتُهُ","هل يُنقَعُ اللَّوح الذي ألتاحُه",27,"ح",2,0],["من قال يوماً خالدٌ","فَلْيَبْتدِىءْ عَجِلاً بلعنة خالدْ",28,"د",1,1],["من قولُهُ وفَعَالُهُ","سَمَرانِ ما سمر السّميرُ",29,"ر",1,0],["من قهوة شِرّةُ الشبان شرّتُها","وعهدها عهد سابور وفيروزِ",30,"ز",1,0],["من قائل أكرِمْ به أو قائل","أحزِم به في المتْح والإمراس",31,"س",1,0],["منقلب الشفرين مستضحِكٌ","ما هو إلا جيب درّاعه",32,"ع",2,0],["من قول علامة له لججٌ","يغرق فيهن صاحب النُتَف",33,"ف",1,0],["من قاسم صيغت أماديحه","ومن حمام الأيك أطواقه",34,"ق",2,0],["من قول حُرّ مُخوّل لك بال","إحسان تُوليهِ كلَّ تخويلِ",35,"ل",1,0],["من قال يوماً خالدٌ","فلَيَبْدَ حينئذٍ بلعنِهْ",36,"ن",2,1],["مُنقَضِبينَ اِنقِضابَ الحَبلِ يَتبَعُهُم","بَينَ الشَقيقِ وَعَينِ المَقسِمِ البَصَرُ",37,"ر",1,0],["مِن قَرقَفِ الزَرَجونِ فُتَّ خِتامُها","فَالدَنُّ بينَ خَنابِجٍ وَقِلالِ",38,"ل",1,0],["مِن قَهوَةٍ نَفَحَت كَأَنَّ سَعيطَها","مِسكٌ تَضَوَّعَ في غَداةِ شَمالِ",38,"ل",1,0],["مِن قِمَّةٍ كَالنَهدِ أَيُّ فَتىً رَأى","نَهداً يَفيضُ بِعارِضٍ مِدرارِ",39,"ر",1,0],["مِن قائِلٌ عَنّي لِمَن خالَني","أَمرَحُ مِن دُنيايَ في جَنَّةِ",40,"ه",1,0],["مِن قَهوَةٍ طابَ مِنها","طَعمٌ وَلَونٌ وَريحُ",41,"ح",1,0],["مِن قَومِكَ الزُهرِ الوجوهِ إِذا الوَغى","كَسَتِ الوجوهَ الغُرَّ ثَوبَ القارِ",42,"ر",1,0],["من قضى نحبه ونام بقبر","لا يبالي طول الليالي السود",43,"د",1,0],["من قضى في تلك الشموس بان","تسبح في لا نهاية الابعاد",44,"د",1,0],["من قاسه بالآخرين بدواله","في جنبه وكأنهم اقزام",45,"م",1,0],["من قضى منهم تفرق فكرا","في نهى النشء أو تقسم ذهنا",46,"ن",2,0],["مَن قائِلٌ لِلمُسلِمينَ مَقالَةً","لَم يوحِها غَيرَ النَصيحَةِ واحِ",47,"ح",1,0],["مِن قَصيرِ اللَفظِ في مَكرِ النُهى","وَطَويلِ الرُمحِ في كِبارِ الوَتين",48,"ن",1,0],["مَن قالَ لَستَ بِخَيرِ الناسِ كُلِّهِمِ","فَجَهلُهُ بِكَ عِندَ الناسِ عاذِرُهُ",49,"ر",2,0],["من قبل ذا خانَ الأمين شقيقه","فأُديل منه لبغيه المأمونُ",50,"ن",1,0],["من قاسَ بالعلمِ الثراءَ فإنَّهُ","في حُكمهِ أعمى البصيرةِ كاذبُ",51,"ب",1,1],["من قالَ غيرُكَ للعُلَى فقد افترى","مَيْناً وكذْبَا",52,"ب",2,0],["مِن قَهوَةٍ تُنسي الهُمومَ وَتَبعَثُ ال","شَوقَ الَّذي قَد ضَلَّ في الأَحشاءِ",53,"ا",2,0],["مَن قائِلٌ لِلزَمانُِ ما أَرَبُه","في خُلُقٍ مِنهُ قَد خَلا عَجَبُه",54,"ب",2,1],["مِن قُروحٍ نَبَتنَ في كَبدٍ جا","دَ عَلَيها مِنَ البُكا شُؤبوبُ",55,"ب",1,0],["مِن قَبلِ داعِيَةِ الفِراقِ وَرِحلَةٍ","مَنَعَت مُغازَلَةَ الغَزالِ الأَدعَجِ",56,"ج",1,0],["مِن قُباذٍ وَيَزدَجِردَ وَفَيرو","زٍ وَكِسرى وَقَبلَهُم أَردَشيرِ",57,"ر",1,0],["مِن قَضاءِ الحُقوقِ في بَعضِ ما عا","رَضَ دونَ الحُقوقِ أَلّا تُقَضّى",58,"ض",2,1],["من قيانٍ برزْنَ ليسَ على الأب","صارِ في نهْبِ حبِّها من جُناحِ",59,"ح",1,0],["مِن قَبلِ أَن يَتَثاقَلَ الز","زُوّارُ عَنكَ وَعَن مَزارِك",60,"ك",1,0],["مِن قَبلِ أَن تُلفى وَلَي","سَ النَأيُ إِلّا نَأيَ دارِك",60,"ك",1,0],["مَن قَرَّ عَيناً بِغِنى بُلغَةٍ","يَوماً بِيَومٍ عاشَ عَيشَ المَلِك",61,"ك",1,0],["مِن قَبلِ أَن تَرشُفَ شَمسُ الضُحى","ريقَ الغَوادي مِن ثُغورِ الأَقاح",62,"ح",1,0],["مِن قَهوَةٍ كَشُعاعِ الشَمسِ مُشرِقَةٍ","إِذا جَرى الماءُ فيها أَطلَعَت شُهُبا",63,"ب",2,0],["مِن قَهوَةٍ حَجَبوها في مَعابِدِهِم","وَعَلَّقوا حَولَها الأَستارَ وَالصُلُبا",63,"ب",2,0],["مِن قَبلِ أَن يَهتِفَ داعِ النَوى","فَلَم أَجِد عَن بَينِنا مِن بَراح",64,"ح",1,0],["من قلبُه صافٍ ودي","دنهُ الولاءُ المطلق",65,"ق",1,0],["من قهوةٍ في الكأسِ لمّاعةٍ","كالبرقِ شُقّ الغيمُ عنه فلاح",66,"ح",1,0],["مِن قَطعِ أَلفاظِهِ تَوصيلُ مَهلَكَتي","وَوَصلُ أَلحاظِهِ تَقطيعُ أَنفاسي",67,"ي",1,0],["مَنْ قالَ بالمردِ فإني امرؤٌ","ما لي إلى المِردانِ مِنْ شَوْفِ",68,"ف",1,1],["مَنْ قالَ بالمردِ فاحذر إنْ تصاحبَهُ","فإنْ فعلْتَ فثقْ بالعارِ والنارِ",69,"ر",1,1],["مَنْ قالَ بالمردِ فإني امرؤٌ","إلى النسا ميلي ذواتِ الجمال",70,"ل",1,1],["مَنْ قالَ بالمُرْدِ فإني امرؤٌ","مالي إلى النسوانِ مِنْ شَوْفِ",71,"ف",1,1],["منْ قبلِ أنْ تمسوا ونصفٌ منهمُ","في الفاسقينَ ونصفهمْ كفّارُ",72,"ر",1,1],["مَن قالَ أنْ ليسَ مِن معْنىً للفْظَتِها","بلا دِمَشْقَ وبَغدادٍ فقد صَدَقا",73,"ق",2,0],["مُنقَسِمٌ بَينَ رَمادٍ أَزرَقٍ","وَبَينَ جَمرٍ خَلفَهُ يَلتَهِبُ",74,"ب",1,0],["مِن قُرَيشٍ في الصَميمِ وَمِن","فِتيَةِ الهَيجاءِ في القِمَمِ",75,"م",1,0],["مَنْ قَدَّمَ الدُّنيا فليس ببالِغٍ","ما قدَّمَتْ عِندَ الرسولِ يَدَاكِ",76,"ك",1,0],["مِن قَبلِهِ بَلقيسُ كانَت عَمَّتي","حَتى تَقَضّى مُلكُها بِالهُدهُدِ",77,"د",1,0],["مِنْ قابِ قَوْسَينِ أوْ أَدْنَى لهُ نُزُل","وحُقَّ منه له مَثوَىً وَتَحلِيلُ",78,"ل",1,0],["من قاصراتِ الطَّرْفِ كلّ خريدةٍ","لم يأتِ دونَ وِصالها هِجرانُها",79,"ن",3,0],["من قال للشِّعرى العَبور كذا اعبُري","كرهاً وقال لأختها الأخرى اغمصي",80,"ص",2,0],["مُنقَدَّ جَيبِ القَميصِ يَحثو عَلى ال","رَأسِ مَلِيّاً بِكَفِّهِ التُرُبا",81,"ب",2,0],["مِن قَهوَةٍ مُزَّةٍ مُشَعشَعَةٍ","تَرى لَها عِندَ مَزجِها حَبَبا",81,"ب",2,0],["مِن قَهوَةٍ زانَها تَقادُمُها","فَهيَ عَجوزٌ تَعلو عَلى الحُقُبِ",82,"ب",1,0],["مِن قَهوَةٍ جاءَتكَ قَبلَ مِزاجِها","عُطُلاً 