"البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114600","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69978","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94541","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66132","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120519","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204221","الكامل"],[4767,"نبع الإيثار","https://www.poetsgate.com/ViewPoem.aspx?id=197294",""],[585,"من مهبط الوحي حول البيت والحرم","https://www.poetsgate.com/ViewPoem.aspx?id=161898",""],[778,"وشمس سلاف كان العب","https://www.poetsgate.com/ViewPoem.aspx?id=89210",""],[5308,"الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=215218",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[5409,"أصقر تهامة والأبطحين","https://www.poetsgate.com/ViewPoem.aspx?id=155485",""],[5413,"فقد الأحبة غربةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201389",""],[5413,"ما أعمقَ الحبَّ!","https://www.poetsgate.com/ViewPoem.aspx?id=208596",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5582,"زارَتْ وَثَوْبُ الدُّجَى قَدْ مالَ مَسْدُولا","https://www.poetsgate.com/ViewPoem.aspx?id=187240",""],[5720,"أبا مُحَمَّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=201401",""],[5725,"هذا الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=195400",""],[5725,"الا أيها الثائرون الصغار","https://www.poetsgate.com/ViewPoem.aspx?id=207899",""],[402,"لتاج تاج مملكين عظام","https://www.poetsgate.com/ViewPoem.aspx?id=36335",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5842,"كي لا ينضب الماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=73684",""],[5865,"إلى أصدقائي","https://www.poetsgate.com/ViewPoem.aspx?id=179880",""],[6259,"يغالبني فرطُ الغرام على الصبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59380&r=&rc=28",""],[5567,"ذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69072&r=&rc=10",""]],"verses":[["فَكانَ لَفظُكَ دُرّاً حَولَ لَبَّتِها","العَدلُ يَنظِمُ وَالتَوفيقُ لَآلُ",0,"ل",1,0],["فكأن لبناناً عروس إذ غدا","يزهو بنشر غدائر الأغصان",1,"ن",1,0],["فَكانَ لَهُ بَردُ السِماكِ وَغَيمُهُ","خَليطاً غَدا صُبحَ الحَرامِ مُزايِلا",2,"ل",2,0],["فكأن لذة صوته ودَبِيبَها","سِنةٌ تمشَّى في مفاصل نُعَّس",3,"س",1,0],["فكأن ليلته علي لطولها","باتت تمخَّضُ عن صباح الموقف",4,"ف",1,0],["فَكانَ لَدَينا السِرَّ بَيني وَبَينَها","وَلَمعَ غَضيضاتِ العُيونِ رَسولُها",5,"ل",3,0],["فَكَأَنَّ لَفظَكَ لُؤلُؤٌ","وَكَأَنَّما القِرطاسُ جيد",6,"د",1,0],["فَكانَ لَنا بِظِلِّكَ خَيرُ وَقتٍ","وَخَيرُ الوَقتِ ما لَكَ فيهِ أُنسُ",7,"س",1,0],["فَكَأَن لَم يَنهَض بِهَودَجِها الدَه","رُ وَلا سارَ خَلفَها الأُمَراءُ",8,"ا",2,0],["فكانَ لَحَاظُكَ المكرورُ شَزْراً","وكانَ جوابُك المفهومُ عِيَّا",9,"ي",2,0],["فكانَ لجوهرِ المَجدِ انتظامٌ","وكان لجوهرِ الحَمدِ انتثارُ",10,"ر",1,0],["فكانَ لها الشِّفاءُ بغيرِ كَلْمٍ","وكانَ بنا مُباشرَةُ الحديدِ",11,"د",1,0],["فكانَ لنا في الرّومِ قتلٌ معجَّلٌ","وفينا لهم من الوشيج شجاجُ",12,"ج",1,0],["فَكَأَنَّ لَيلَكَ مِن تَذَكُّرِها","لَيلُ السَليمِ سَرَت عَقارِبُهُ",13,"ب",2,0],["فكان للقادم منهم أهلُ","ومنزلٌ رحب الفناء سهلُ",14,"ل",1,0],["فكان للهادي علوّ شان","وغيظ كل حاسدٍ وشان",14,"ن",1,0],["فكأن لبنانا عروس إذ غدا","يزهو بنشر غادائر الاغصان",15,"ن",1,0],["فكان لِزاماً أنْ تحوزَ عصابةٌ","تفيتْ بظلِّ الجاه أعلى المراتب",16,"ب",1,0],["فَكَأن لامع بَرقِها","سَيفاً يَسل وَيُغمَدُ",17,"د",1,0],["فَكَأَن لَم يُصاقِبوا أَرضَ حَرّا","نَ وَلا حَلَّ حَيُّهُم جُلّابا",18,"ب",2,0],["فكأن لم تكن قضيباً رطيباً","وكأن لم تكن كثيباً مهيلا",19,"ل",2,0],["فَكانَ لِلدينِ خَيرَ مُنتَصِرٍ","وَكانَ اللَهُ خَيرَ مُنتَقِمِ",20,"م",1,0],["فكان له قَدمٌ بالتراث","رفيعٌ على شامخ الأرؤس",21,"س",1,0],["فكان لهم بالقائدِ الشّهمِ إسوةً","وكان المُرجَّى للشؤونِ المصدّرا",22,"ر",2,0],["فَكانَ له في العرش سبق وَرفعَة","وَكانَ له في الارض بعث ومولد",23,"د",1,0],["فكأن لؤلؤ ظله راد الضحى","درر مَتى تسر النَسائِم تنثر",24,"ر",1,0],["فَكانَ لاهل دين اللَه عزا","وَللهيجاء حين تَقوم ساقا",25,"ق",2,0],["فَكانَ لِدَولَتِهِ زينَةً","كَذاكَ الطِرازُ يَزينُ اللِباسا",26,"س",2,0],["فكانَ لكُلِّ من هو من ترابٍ","إِليك وأَنت علَّته اِنتسابُ",27,"ب",1,0],["فَكانَ لَهم منهُ النفوذُ إِلى المنى","وَلا سيما ثغرٌ خَبا منه حجمهُ",28,"م",2,0],["فَكانَ لَهُم في ظلّه متقيِّلٌ","مِنَ الصولِ يُحمى بالمكائدِ أطمهُ",28,"م",2,0],["فَكَأَنَّ لُطفِكَ زانَها","وَكَأَنَّها التَحَفَت بِبَردِكَ",29,"ك",1,0],["فَكانَ لِلنَفسِ أَوقاتَ تَعَلُّلِها","فيها الأَماني بَينَ اليأسَ وَالمَلَلِ",30,"ل",1,0],["فَكانَ لَهُم ثَناءٌ حَيث كُنّا","وَكانَ لَنا سُرور حَيث كانوا",31,"ن",3,0],["فَكانَ لَهَا فِي الأَربِعَاءِ مَرارة","مِنَ الدّم ريٌّ بالأَسِنّةِ لا تَضحو",32,"ح",2,0],["فكان لَقىً لأيدي الخَيْلِ دَهراً","عليه الجيشُ يَقتتِلُ اقْتِتالا",33,"ل",2,0],["فكان لهذا بالسيادةِ حجّةً","وهذا يَقودُ الخيلَ نحوَ الوغَى جُردا",34,"د",2,0],["فَكَأَن لَم يَكُن فَتى في زَمانِ","وَكَأَن لَم يَكُن فَتىً في دارِ",35,"ر",1,0],["فكانَ لفظُكَ في آلائِه زَهَراً","وكانَ معناكَ في أثنائهِ ثَمَرا",36,"ا",1,0],["فكان لي غَزَلي كلُّه","وكانَ لسلمان جلّ امتداحي",37,"ح",2,0],["فكان ليَ الثناء عليه دأباً","وكان له الندى والجود دابا",38,"ب",2,0],["فكأن ليل الصيف قبل صباحهِ","من أزرق الجو البهيج كساها",39,"ا",3,0],["فكان لما غدت في السفح صائلة","يوماً على آل حجلان يعدُّ فنا",40,"ن",2,0],["فكان لكُمْ من التَّضْعِيفِ فَأْلٌ","على مقدارِ تضعيفِ الحِسابِ",41,"ب",1,0],["فكأَنَّ للدُّنيا بحَمدِكَ أَلسُناً","تُصغِي لَهَا الآفاقُ والأَقطارُ",42,"ر",1,0],["فكان لا خوفَ على الآمن ال","جار ولا حرمانَ للسائلِ",43,"ل",1,0],["فكان لك السؤلُ لمّا نهضتَ","وكان له السوءُ لمّا نكلْ",44,"ل",1,0],["فكأنّ ليلي مع تفاوت طولِهِ","أسيافُهم موصولةً بالأذرعِ",45,"ع",1,0],["فكان لنا قمرا ما دجتْ","وماءً إذا هي شُبَّتْ لهيبا",46,"ب",2,0],["فَكَأَنَّ لَمعَ البَرقَ دُخّانُهُ","بَرقٌ تَأَلَّقَ في مَثارِ ضَبابِ",47,"ب",1,0],["فكانَ لهُ في دارةِ الأرضِ مأتَمٌ","وفي العرشِ عيدٌ يجمعُ الفِطرَ والنَّحرا",48,"ر",2,0],["فكانَ لهُ فَضلانِ فَضلٌ على الثَّنا","وفَضلٌ على خُلقِ الرِّضَى المُتَواضعِ",49,"ع",1,0],["فكان لللجهل هو المعارض","لسنة النبي وهو الناقض",50,"ض",1,0],["فكان لذلك مشهد هول","أفاض عيون الأنام دما",51,"ا",1,0],["فكان له من مجده خير شافع","لديهم ومن آياته لهم صبر",52,"ر",1,0],["فَكانَ لَهُ التّأييد في كُلِّ مَوطِنٍ","وَكانَ لَهُ حقّاً عَليَّ التغلّبُ",53,"ب",1,0],["فكان لنا وللمضرين حظٌّ","وللحُسّادِ في الأثَرِ الغبارُ",54,"ر",1,0],["فكان له غرةً في التمام","ونعلاً لحافره في السرار",55,"ر",1,0],["فكان لقلبي مهجة ولخاطري","صقالاً ربا فوق الصقال صقالا",56,"ل",2,1],["فكان لي الجود الجموم وجوده","أحب جموح جانح لاخاء",57,"ا",2,1],["فكان للإثم أَقداحه","وتفاح خديه فوز القداحِ",58,"ح",1,0],["فكان لي طبعُها في مضجعي قدراً","ينهاجُ بالحتفِ مَقدوراً ومرسولا",59,"ل",2,0],["فَكانَ لإِسمكَ حَظٌّ أَنتَ تَحسدُهُ","لِأَنَّهُ قَد جَنى مِن لَمسِهِ القُبُلا",60,"ل",2,0],["فكأن لم ترفعِ الصوت ولم","تملأ الأنفس بشراً ورجاء",61,"ا",2,0],["فكان لي منه اعتنا","هدى فؤادي للرشد",62,"د",1,0],["فَكانَ لِأَهلِ العيدِ عيدٌ بِنُسكِهِم","وَكانَ حُمَيدٌ عيدَهُم بِالمَواهِبِ",63,"ب",1,0],["فكان لم في كل بهماء معلما","تبين لهم أسراره كل كائن",64,"ن",1,0],["فكان ليل ابن الحسين دجاكم","او ليل شاعر عصره اللبناني",65,"ن",2,0],["فكان لها وللسمر العوالي","بأفئدة الأسود الربد لعب",66,"ب",1,0],["فكان لكل حتف أنف معجلا","وان لم يكن مرأىً فقد جل مسمعا",67,"ع",2,0],["فكان له الشعب عبداً وفي","ولم ينقص الدهر يوماً وفاه",68,"ا",2,0],["فكان للعلمِ بين الناسِ عُنوانا","محضُ النجارِ كريم الفرعِ طيّبهُ",69,"ه",1,0],["فكأَنَّ ليلة وصلها زنجيَّةٌ","حنقتْ عليكَ فمزَّقت جلبابها",70,"ب",3,0],["فكان لهم واللّه يكلأ مجدهم","بما فعلوا حقّا على كل مسلم",71,"م",1,0],["فكان لكل حاليةٍ عصامٌ","به ولكل عاطلةٍ وشاح",72,"ح",1,0],["فكانَ لنا عيدانِ عيدُ قدومهِ","وعيدٌ لختمِ الصَّومِ فاعجب لذا الشملَ",73,"ل",1,0],["فَكَانَ لَنَا بَاكُورَةَ الفَتحِ رَأسُهُ","وَفي البَدءِ مِنْ عِلمِ الخِتامِ حصولُ",74,"ل",1,0],["فكان له على الدنيا وداد","يقاوم ملأها سهلا وحزنا",75,"ن",2,0],["فكان للدين قيماً وبها","أمواله في العطاء يقسمها",76,"م",3,0],["فكان لقائي والوداع معا فلا","تسل كيف حالي حين ولى مع الصبر",77,"ر",1,0],["فكان لقاء رنحَّ الشرق غبطةً","وكان حديث كل مضمونه الود",78,"د",1,0],["فكان لي اذنا وكان لي بصرا","وكان ما عندنا من القوى وسل",79,"ل",1,0],["فكان لها كفؤاً ومجلى زفافها","عليه إلى الاقبال اوضح منهجا",80,"ج",2,0],["فكان لها روحاً وشاد لأهلها","من السعد والاقبال فوق السها قصرا",81,"ر",2,0],["فَكانَ لِماحاً مِن خَصاصٍ ورِقبَة","مَخافَةَ أَعداءٍ وَطَرفاً مُقسّما",82,"م",2,0],["فَكانَ لِنَجديِّ الرِّياحِ كأَنَّهُ","أَخو كُربَةٍ داني الإِسارِ طَليقُ",83,"ق",1,0],["فكأنَّ لؤلؤَ ثغرها منه عقدها","أو ثغرُها منه لئالي الجيد",84,"د",1,0],["فكان لكم منا ذمام ومثله","لنا منكم لله صنعكم الأحرى",85,"ر",2,0],["فَكانَ لِلقَدر المَحتوم صَولَته","حِتّى تَفرَّق عَنهُ الجَمع أَشباحا",86,"ح",2,0],["فكان لهم فيها الفخار بغربة","وكانت لهم هديا لسبل المكاسب",87,"ب",1,0],["فَكانَ لِأَهلِ دينِ اللَهِ عِزّاً","وَسُمّاً لِلعِدا مُرّاً مَذاقا",88,"ق",2,0],["فكان لطيفاً كماء الندى","وكان لذيذاً كحلو القبل",89,"ل",1,0],["فكأن لون مسائنا لون الأسى","وكأن لون صباحنا لون الرضا",90,"ض",2,0],["فكان لديّ الحبّ قمح وغيره","حكى جبلي نعمان في الحجم أو رضوى",91,"ا",1,0],["فكأنّ ليلي في امتداد مقامه","صدرُ ابن خُوجة عسكر الدّيوان",92,"ن",1,0],["فكان لأهل الاتحاد وقد دجى","عليهم ظلام الخطب في غلس فجرا",93,"ر",2,0],["فكان لنا عيدان عيد انتصارنا","وعيد لعباس أغر سعيد",94,"د",1,0],["فكأن لم يك طل","لا ولا زهرٌ وساق",95,"ق",1,0],["فكأن لم أدر صادقها","في ودادي من منافقها",96,"ق",3,0],["فكان لديها حاضرا غير حاضرٍ","وكان لديها غائبا غير غائب",97,"ب",1,0],["فكأن لم يكن يزيد ولم يش","ج نديماً يهزه التغريد",98,"د",1,0],["فَكأن لَم يخلفوني أَوَّل ال","خلق إِلّا لِيَكونوا عُظَماءَ",99,"ا",2,0],["فكأن لم تكن رأت للغواني","لمما في مشيبها وهي شمط",100,"ط",1,0],["فكأن ليلة ما أصيب بمثلها","في فجرها قد عممته صقالها",101,"ل",3,0],["فكأنَّ لا كنفاً بمصر غيره","وكأنَّ لا غوثاً بها إلاه",102,"ا",2,0],["فكان لا أرباً لديك سوى دمي","تجريه ثم تبين لا تتراف",103,"ف",1,0],["فكأنّ ليلَك وَالنُجوم زَهَت بِهِ","درٌّ قَلائدُه بكفِّ مُبدّ