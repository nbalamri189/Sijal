{"poems":[[53,"صبرا غريم الثأر من عدنان","https://www.aldiwan.net/poem29664.html","الرجز"],[9,"كانت وصاة وحاجات لنا كفف","https://www.aldiwan.net/poem21952.html","البسيط"],[86,"هجعت يا طير ولم أهجع","https://www.aldiwan.net/poem68946.html","السريع"],[35,"حي المنازل قد عفت أطلالها","https://www.aldiwan.net/poem39103.html","الكامل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[27,"ما للفرزدق من عز يلوذ به","https://www.aldiwan.net/poem5674.html","البسيط"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[27,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[11,"إن كنت كارهة معيشتنا","https://www.aldiwan.net/poem247.html",""],[23,"أسألت رسم الدار أم لم تسأل","https://www.aldiwan.net/poem21245.html","الكامل"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[89,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[85,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[85,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[28,"فأنت إذ لم تكن إياه صاحبه","https://www.aldiwan.net/poem5082.html","البسيط"],[28,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[22,"إن اليمامة خير ساكنها","https://www.aldiwan.net/poem21701.html","الكامل"],[75,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[46,"ما كان في الأرض من خير ولا كرم","https://www.aldiwan.net/poem23450.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116956","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"أسماؤهم رتب","https://www.poetsgate.com/ViewPoem.aspx?id=179697",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"موظف بلا مأوى","https://www.poetsgate.com/ViewPoem.aspx?id=179766",""]],"verses":[["الضامِنينَ لِطَيرِهِم مُهَجَ العِدا","عَن كُلِّ ضَربٍ صادِقٍ وَطِعانِ",0,"ن",1,0],["الضَيفُ أوصيكُمُ بِالضَيفِ إِنَّ لَهُ","حَقّاً عَلَيَّ فَأُعطيهِ وَأَعتَرِفُ",1,"ف",1,0],["الضارِبِ الجِزيَةِ مُنذُ اِنتَشى","عَلى يَراعِ الشاعِرِ المُبدِعِ",2,"ع",1,0],["الضارِبونَ أَمامَها وَوَراءَها","بِمُهنَّداتٍ قَد أُجيد صِقالُها",3,"ل",3,0],["الضارِبينَ إِذا الكُماةُ تَنازَلوا","ضَرباً يَقُدُّ عَواتِقَ الأَبدانِ",4,"ن",1,0],["الضارِبينَ زُحوفاً يَومَ ذي نَجَبٍ","فيها الدُروعُ وَفيها البَيضُ وَالغابُ",5,"ب",1,0],["الضارِبو النَخلَ لا تَنبو مَناجِلُهُم","عَنِ العُذوقِ وَلا يُعيِيهِمُ الكَرَبُ",6,"ب",1,0],["الضارِبينَ إِذا ما الخَيلُ ضَرَّجَها","وَقعُ القَنا وَاِلتَقى مِن فَوقِها الغَبَرُ",7,"ر",1,0],["الضاحِكينَ إِلى الخِنزيرِ شَهوَتَهُ","يا قُبِّحَت تِلكَ أَفواهاً إِذا اِكتَشَروا",7,"ر",3,0],["الضارِبونَ عَلى النَصارى جِزيَةً","وَهُدىً لِمَن تَبِعَ الكِتابَ وَنورا",8,"ر",2,0],["الضارِبينَ لَدى أَعِنَّتِهِم","الطاعِنينَ وَخَيلُهُم تَجري",9,"ر",2,0],["الضارِبونَ الكَبشَ يَبرُقُ بَيضُهُ","ضَرباً يَطيحُ لَهُ بَنانُ المَفصِلِ",10,"ل",1,0],["الضادُ مِن بَعدِكَ في مَأتَمٍ","حاضِرُها وَالأَعصُرُ الغابِرات",11,"ت",1,0],["الضاحِكاتُ مِنَ الدَلا","لِ اللاعِباتُ مِنَ الحُبورِ",12,"ر",1,0],["الضاحكون من البعيد كأنهم","حزب على ان يشمتوا بي اجمعوا",13,"ع",3,0],["الضُلوعُ تَتَّقِدُ","وَالدُموعُ تَطَّرِدُ",14,"د",1,1],["اَلضاحِياتُ الضاحِكاتُ وَدونَها","سِترُ الجَلالِ وَبُعدُ شَأوِ المَطلَعِ",15,"ع",1,0],["الضارِبينَ عَلى حَقٍّ إِذا ضَرَبوا","يَومَ اللِقاءِ وَلَيسوا بِالعَواويرِ",16,"ر",1,0],["الضارِبونَ إِذا الكَتيبَةُ أَحجَمَت","وَالنازِلونَ غَداةَ كُلَّ نِزالِ",17,"ل",1,0],["الضامِنونَ فَما تَنفَكُّ خَيلُهُمُ","شُعثَ النَواصي عَلَيها كُلُّ مُشتَهِرِ",18,"ر",1,0],["الضارعين لأقْدارٍ تحِلُّ بهم","كما تلوَّى ببطن الحُوتِ ذُو النون",19,"ن",1,0],["الضّعفُ أَدركَهُمْ وكانوا قُوّةً","لا تُستباحُ بِقُوَّةٍ وَعَتادِ",20,"د",1,0],["الضّارباتُ على الدُّفوفِ فإن هُمُ","ضَربوا الطُّلى فالنّادباتُ النُّوَّحُ",21,"ح",1,0],["الضارِبينَ التَقدُمِي","يَّةَ بِالمُهَنَّدَةِ الصَفائِح",22,"ح",1,0],["الضامِنونَ لِمالِ جارِهِمُ","حَتّى يَتِمَّ نَواهِضُ البَقلِ",23,"ل",1,0],["الضاربين كُليبا فوق مَفرِقِهِ","بالمشرفيّ على نابٍ من الإبل",24,"ل",1,0],["الضارب الأسد في بآدلها","والطاعن الخيل في فوائلها",25,"ل",3,0],["الضاحِكينَ إِذا ما خيضَ في سَفَهٍ","وَإِن أُريدوا عَلى أُكرومَةٍ شَفَنوا",26,"ن",3,0],["ألضَّارِبُ الأَمْثَالِ لَيْ","سَ لَهُ بِرَوعَتِهَا ضَرِيبُ",27,"ب",1,0],["الضَّاحِكُ اللاَّعِبُ بِالأَمْسِ","بَاتَ صرِيعاً فَاقِدَ الأُنْسِ",28,"س",1,1],["الضارِباتُ خدودَهُنَّ برَنَّةٍ","الداعياتُ نبيِّهُنَّ محمَّدِ",29,"د",1,0],["الضادُ تَجْمَعُهُمْ وَتَرْأَبُ صَدْعَهُمْ","سِيَّانِ في الأَفْراحِ وَالأَتْرَاحِ",30,"ح",1,0],["الضَيْفُ فِي سَاحَاتِهِمْ","يَجْتَازُ مِنْ رِفْدٍ لِرِفْدِ",31,"د",1,0],["الضاد تعتزُّ -يا طه- إذا ذَكرت","ما ضَمَّ بينكما من لُحمة النسب",32,"ب",1,0],["الضَّادُ أُمُّهُما؛ ويَعْرُبُ والدٌ","أَرأَيت أَنَجَبَ منهما أو أعرَقا؟",33,"ق",2,0],["الضّادُ في الديوان ضاعَ رجالها","بين المكاتب ضَيعةَ الأيتام",34,"م",1,0]]}