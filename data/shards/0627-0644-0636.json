راعِ الشاعِرِ المُبدِعِ",2,"ع",1,0],["الضارِبونَ أَمامَها وَوَراءَها","بِمُهنَّداتٍ قَد أُجيد صِقالُها",3,"ل",3,0],["الضارِبينَ إِذا الكُماةُ تَنازَلوا","ضَرباً يَقُدُّ عَواتِقَ الأَبدانِ",4,"ن",1,0],["الضارِبينَ زُحوفاً يَومَ ذي نَجَبٍ","فيها الدُروعُ وَفيها البَيضُ وَالغابُ",5,"ب",1,0],["الضارِبو النَخلَ لا تَنبو مَناجِلُهُم","عَنِ العُذوقِ وَلا يُعيِيهِمُ الكَرَبُ",6,"ب",1,0],["الضارِبينَ إِذا ما الخَيلُ ضَرَّجَها","وَقعُ القَنا وَاِلتَقى مِن فَوقِها الغَبَرُ",7,"ر",1,0],["الضاحِكينَ إِلى الخِنزيرِ شَهوَتَهُ","يا قُبِّحَت تِلكَ أَفواهاً إِذا اِكتَشَروا",7,"ر",3,0],["الضارِبونَ عَلى النَصارى جِزيَةً","وَهُدىً لِمَن تَبِعَ الكِتابَ وَنورا",8,"ر",2,0],["الضارِبينَ لَدى أَعِنَّتِهِم","الطاعِنينَ وَخَيلُهُم تَجري",9,"ر",2,0],["الضارِبونَ الكَبشَ يَبرُقُ بَيضُهُ","ضَرباً يَطيحُ لَهُ بَنانُ المَفصِلِ",10,"ل",1,0],["الضادُ مِن بَعدِكَ في مَأتَمٍ","حاضِرُها وَالأَعصُرُ الغابِرات",11,"ت",1,0],["الضاحِكاتُ مِنَ الدَلا","لِ اللاعِباتُ مِنَ الحُبورِ",12,"ر",1,0],["الضاحكون من البعيد كأنهم","حزب على ان يشمتوا بي اجمعوا",13,"ع",3,0],["الضُلوعُ تَتَّقِدُ","وَالدُموعُ تَطَّرِدُ",14,"د",1,1],["اَلضاحِياتُ الضاحِكاتُ وَدونَها","سِترُ الجَلالِ وَبُعدُ شَأوِ المَطلَعِ",15,"ع",1,0],["الضارِبينَ عَلى حَقٍّ إِذا ضَرَبوا","يَومَ اللِقاءِ وَلَيسوا بِالعَواويرِ",16,"ر",1,0],["الضارِبونَ إِذا الكَتيبَةُ أَحجَمَت","وَالنازِلونَ غَداةَ كُلَّ نِزالِ",17,"ل",1,0],["الضامِنونَ فَما تَنفَكُّ خَيلُهُمُ","شُعثَ النَواصي عَلَيها كُلُّ مُشتَهِرِ",18,"ر",1,0],["الضارعين لأقْدارٍ تحِلُّ بهم","كما تلوَّى ببطن الحُوتِ ذُو النون",19,"ن",1,0],["الضّعفُ أَدركَهُمْ وكانوا قُوّةً","لا تُستباحُ بِقُوَّةٍ وَعَتادِ",20,"د",1,0],["الضّارباتُ على الدُّفوفِ فإن هُمُ","ضَربوا الطُّلى فالنّادباتُ النُّوَّحُ",21,"ح",1,0],["الضارِبينَ التَقدُمِي","يَّةَ بِالمُهَنَّدَةِ الصَفائِح",22,"ح",1,0],["الضامِنونَ لِمالِ جارِهِمُ","حَتّى يَتِمَّ نَواهِضُ البَقلِ",23,"ل",1,0],["الضاربين كُليبا فوق مَفرِقِهِ","بالمشرفيّ على نابٍ من الإبل",24,"ل",1,0],["الضارب الأسد في بآدلها","والطاعن الخيل في فوائلها",25,"ل",3,0],["الضاحِكينَ إِذا ما خيضَ في سَفَهٍ","وَإِن أُريدوا عَلى أُكرومَةٍ شَفَنوا",26,"ن",3,0],["ألضَّارِبُ الأَمْثَالِ لَيْ","سَ لَهُ بِرَوعَتِهَا ضَرِيبُ",27,"ب",1,0],["الضَّاحِكُ اللاَّعِبُ بِالأَمْسِ","بَاتَ صرِيعاً فَاقِدَ الأُنْسِ",28,"س",1,1],["الضارِباتُ خدودَهُنَّ برَنَّةٍ","الداعياتُ نبيِّهُنَّ محمَّدِ",29,"د",1,0],["الضادُ تَجْمَعُهُمْ وَتَرْأَبُ صَدْعَهُمْ","سِيَّانِ في الأَفْراحِ وَالأَتْرَاحِ",30,"ح",1,0],["الضَيْفُ فِي سَاحَاتِهِمْ","يَجْتَازُ مِنْ رِفْدٍ لِرِفْدِ",31,"د",1,0],["الضاد تعتزُّ -يا طه- إذا ذَكرت","ما ضَمَّ بينكما من لُحمة النسب",32,"ب",1,0],["الضَّادُ أُمُّهُما؛ ويَعْرُبُ والدٌ","أَرأَيت أَنَجَبَ منهما أو أعرَقا؟",33,"ق",2,0],["الضّادُ في الديوان ضاعَ رجالها","بين المكاتب ضَيعةَ الأيتام",34,"م",1,0],["ألضحى والشجاع حلفا كفاح","ما احتمى بالظّلام إلاّ جبان",35,"ن",1,0],["الضاحياتُ، الباكياتُ، ودونَها","ستر الجلالِ ، بعدُ شأو الملطع",36,"ع",1,0],["الضايعون اليوم والباكون والش","كون من أخَذ لشخصك مغتصب",37,"ب",1,0],["الضارِبي الهامَ في يَومٍ تَخالُ بِهِ الش","شَمسَ المُنيرَةَ قَد غابَت وَلم تَغِبِ",38,"ب",1,0],["الضارِبُونَ الطُلى وَالهامَ ضاحِيَةً","في الحَربِ حينَ يَهُزُّ الحَربَ جانيها",39,"ي",3,0],["الضابطُ الحفيظُ والسريعُ","الحافظُ المحفوظُ والممنوعُ",40,"ع",1,0],["الضارِبونَ جُنودَ الشِركِ ضاحِيَةً","بِبَطنِ مَكَّةَ وَالأَرواحُ تَبتَدِرُ",41,"ر",1,0],["الضارِبونَ الكُماةَ في الغارَةِ ال","شَعواءِ وَالمُطعِمونَ في الإِزَمِ",42,"م",1,0],["الضاحكِون اذا الوجوه عَوابِس","وَالمقدمون اذا المقدم احجما",43,"م",2,0],["الضغن والشحناء ببعض خطوبه","ومصارع الاخلاق والآداب",44,"ب",1,0],["الضحايا معناهم الشهداء","الألى بعد موتهم احياءُ",45,"ا",2,1],["الضَّرْبُ أَوَّلُ أَمرِها","والحَبْسُ في أَيدِي اللِّئامِ",46,"م",1,0],["الضاربين بكلِّ أبيَضَ مِخذَمٍ","والطاعِنينَ مَجامِعَ الأَضغانِ",47,"ن",1,0],["الضيا بخل الكرام ومن","حدثت عنه الرماح وعن",48,"ن",1,0],["الضُّرُّ في أيَّامِنا هَذِهِ","كاللَّيلِ يَغْشى سائِرَ النّاسِ",49,"س",1,0],["الضارِبونَ بِحَومَةٍ نَزَلَت","وَالطاعِنونَ بِأَذرُعٍ شُعرِ",50,"ر",1,0],["الضيغم الشهم البشير أبو الثنا","مفني العدا بحسامه المسنونِ",51,"ن",