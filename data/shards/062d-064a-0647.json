93867","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93868","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203480","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204751","الخفيف"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110778","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216570",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138650",""],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132006","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131952","الرمل"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124071","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85015","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86451","الخفيف"],[4209,"","https://poetry.dctabudhabi.ae/diwan/poem/105541","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94361","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136698",""],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33832","الخفيف"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102000","الرمل"],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[463,"ساهرة ُ الليلِ نؤومُ الضمحى","https://www.poetsgate.com/ViewPoem.aspx?id=14507",""],[4858,"العمر الذبيح","https://www.poetsgate.com/ViewPoem.aspx?id=138291",""],[4987,"طاب السهر","https://www.poetsgate.com/ViewPoem.aspx?id=49558",""],[5055,"غارة الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=103656",""],[5121,"شَاعِرُ الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=212038",""],[5433,"عين تشربك شوف","https://www.poetsgate.com/ViewPoem.aspx?id=36228",""],[5436,"مهرة العراق (جواد بركات علي )","https://www.poetsgate.com/ViewPoem.aspx?id=34809",""],[5572,"العشق القديم","https://www.poetsgate.com/ViewPoem.aspx?id=53486",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[5919,"هبّ نشرُ المعنبرِ المخزونِ","https://www.poetsgate.com/ViewPoem.aspx?id=128683",""],[6045,"وثبة قلب طروب","https://www.poetsgate.com/ViewPoem.aspx?id=181560",""],[6142,"حيةٌ ميتةٌ برأسين تحيا","https://www.poetsgate.com/ViewPoem.aspx?id=155684",""],[6229,"دمية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65180&r=&rc=1",""]],"verses":[["حَيِّهِ وَاِنثُر عَلى أَكمامِهِ","مِن نِطافِ الماءِ أَشباهَ الدُرَر",0,"ر",1,0],["حيّ هل يا أخا مصر","ندّكر خير مدّكر",1,"ر",1,1],["حيّ هل أيها الملا","نحي ذكرى أبي العلا",1,"ل",2,0],["حَيِّهِم مِنهُمُ كَشاهِدِ عُربٍ","غائِبٍ مِنهُمُ بِدارِ عَتيكِ",2,"ك",1,0],["حَيَّةً في الوَجارِ أَربَدَ لا تَن","فَعُ مِنهُ السَليمَ نَفثَةُ راقِ",3,"ق",1,0],["حَيَّةُ اللَيلِ يُشمِسُ الحَزمُ مِنهُ","إِن أَرادَت شَمسُ النَهارِ الغُروبا",4,"ب",2,0],["حَيَّةٌ تَصرَعُ الرِجالَ إِذا ما","صارَعوا رَأيَهُ عَلى الأَذقانِ",5,"ن",1,0],["حية في الأجار أربد لا ين","فع منه السليم نفثة راق",6,"ق",1,0],["حيةً بالذهن قد تبعث","مسك النفحات",7,"ت",1,0],["حيهلا يا كأس ما دام الهوى","ملء حباتك يفنى ويهيم",8,"م",1,0],["حَيُّهُم سَيِّدٌ لِأَحياءِ ذا الخَل","قِ وَمَن ماتَ سَيِّدُ الأَمواتِ",9,"ت",1,0],["حَيِّها بالقبول منك كما حَيَّتك","والقَ ابتسامها بابتسامِ",10,"م",1,0],["حيّها حيّها فقلت سلاما","يا بنة الليل والطّلا والندامى",11,"م",2,0],["حيه ما حييت يا قلب واهدا","مالك اليوم قد تطايرت وجدا",12,"د",2,1],["حيه واصطبح سلاف الاماني","واغتبقها في الكأس صابا وشهدا",12,"د",2,0],["حيه يا خواطري وشجوني","واذكري المعرض الجميل المفذى",12,"ذ",2,0],["حيِّها أوجُهاً على السَّفحِ غُرَّاً","وقِباباً بِيضاً ونُوقاً حُمرا",13,"ر",2,1],["حَيَّهَل إِن كنتَ خِدنِي","تقتَرِب خَلفَ المِيَاهِ",14,"ه",1,0],["حيهلا بمن بمدحي قمن","حيهلا حيهلا بالزعيم",15,"م",1,0],["حيهم يا طالب الفضل جماً","وأقم حيث الندى قد أقاما",16,"م",2,0],["حيٌّ همُ تركوا الأجساد خاليةً","منّا وَأرواحُنا أصبحنَ عندهمُ",17,"م",1,0],["حَيِّهِ إِذ أَتاكَ بالرِقَّةِ البَي","ضاءِ يَسري مِنَ البِلادِ الحَرامِ",18,"م",1,0],["حيِّها خير ما اجتليتَ عَروساً","بنت يومٍ لها قَبولك مهر",19,"ر",1,0],["حيِّ هل رحْ قاصد العل","ياء إن كنت تروح",20,"ح",1,0],["حيّهل بالحديث فيه وعبّر","عنه في كل قولة بسعاد",21,"د",1,0],["حيّهِ عن متيم ذي اشتياق","في هواه قد خالف اللوّاما",22,"م",2,0],["حَيِّهِمْ إن جِئْتَهم يا سَعْدُ حَيّ","فَهُمُ أهل الحيا في كلّ حيّ",23,"ي",1,1],["حيه بالصلاة من مولود","وابكه نازحاً نزوح الشريد",24,"د",1,0],["حيهم حيز الرضى وحماهم","مركز الوافدين والقصاد",25,"د",1,0],["حيهم منزل الرضى وحماهم","حيث تمحي كبائر الأوزار",26,"ر",1,0],["حيهم حيز الرضى وحماهم","حيث تمحي كبائر السيئات",27,"ت",1,0],["حيهم ان تجىء بنظرة عطف","انهم أتلعوا اليك الجيدا",28,"د",2,0],["حية رغم مر خمسين حولاً","كنت فيها أخوض بحر الهموم",29,"م",1,0],["حيه المستطاب زره بقرب","تلقه كالنسيم هيج رندا",30,"د",2,0],["حيّه عِدَد مَاشي ومطّاي","واعداد مصباحك وممساك",31,"ك",1,0],["حيها روضةً ففيها تدلت","ثمرات المنى وطاب جناها",32,"ا",3,0],["حيها عني وقل يا حبذا","منزل بالشكر والشعر حرى",33,"ر",2,0],["حيه يا شعر عني أنه","فارس الهيجاء والركن الركين",34,"ن",1,0],["حيّها حيّها وسائل ربوعها","برباها عن أهل تلك الربوع",35,"ع",1,0],["حَيُّهِم خِلتُهُ السَماءُ لِأَنَّ الش","شَمسَ وَالبَدرَ شابَها سُكانِهِ",36,"ن",2,0],["حيه واقرأ السلام عليه","وادعه بالذي يروق سماعا",37,"ع",2,0],["حيهم حل سويدا مهجتي","وفؤادي بعد ما فت العظاما",38,"م",2,0],["حَيهَّل باهي المحيّا قُم وَحي","وأَدِر كأس الحُميّا والرحيق",39,"ق",1,0],["حَيهلٍ حَيهلٍ على الربى","نقضي بها حقاً لريعان الصبا",40,"ب",2,0],["حَيِّها بِالسَلامِ سِرّاً وَإِلّا","مَنَعوها لِشَقوَتي أَن تَناما",41,"م",2,0],["حي هاتيك الليالي جيها","فلكم فيهن ارغمنا حسودا",42,"د",2,0],["حيِّهِ ما شئت تقبيلاً ولثماً","واصمتَن الدهرَ عن أقوال عاذل",43,"ل",1,0],["حية ُ ماءٍ ناقعٌ سمها","وناقعٌ سمُّ أفاعي الصفا",44,"ا",1,0],["حيّة الشّهوة بثتْ سمَّها","في دماءٍ نسيتْ نهْجَ الصّحيح",45,"ح",1,0],["حي هالطول يا زولٍ عساه محروس","من عبث لوعة الايام وازعاجها",46,"ج",3,0],["حيه سرت بالنفس ماعندي الغيب","وأنا أحس اللمس ظني دلاله",47,"ل",2,0],["حَيَّهَلَّا يَا صَحْوَةَ الشِّعْرِ قُلْ لِي","كَيْفَ شِعْرِي بِكَ اسْتَفَاقَ مِرَارَا",48,"ر",2,0],["حي هالشوف ماتنمل دنياك","شف سواة العيون ليا لقيتك",49,"ك",1,0],["حي هالشوف رغم هموم فرقاك","لو تناسيت جرحي مانسيتك",49,"ك",1,0],["حيّة ألامس في الديار تربّت","ما علمنا ماء الوفا اضماها",50,"ا",3,0],["حي هالعارض على متونه ودق",".شرهتي وابل وانا راضي بديم",51,"م",1,1],["حيه إنه حيالك قد طا","ف به الروح يمنة وشمالا",52,"ل",2,0],["حيَّ هلاّ إلى جناب مُحيّا","ربّةِ الراح نزهتي بل مَعيني",53,"ن",2,0],["حيه حييت يا شعري ومن","حضر الحفل من القوم النجب",54,"ب",1,0],["حيةٌ ميتةٌ برأسين تحيا","كلما رص رأسها بشديد",55,"د",1,1],["حَيّةٌ أنتِ - يا لَسحركِ - في الإغْ","راءِ، إذ تنهدين باستحياء",56,"ا",2,0]]}