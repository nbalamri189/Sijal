{"poems":[[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[64,"أما الزمان ففي تنبيهه عظة","https://www.aldiwan.net/poem52472.html","البسيط"],[48,"محمودنا الله والمسعود خائفه","https://www.aldiwan.net/poem22472.html","البسيط"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[100,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[124,"هيهات يحنو على قلبي معذبه","https://www.aldiwan.net/poem49319.html","البسيط"],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[227,"قوت روحي هواك بل روح ذاتي","https://www.aldiwan.net/poem55470.html","الخفيف"],[411,"كأن فاها إذا ما الراح قبلها","https://www.aldiwan.net/poem50045.html","البسيط"],[519,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[543,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[580,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101503","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53905","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63845","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119980","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109060","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108714","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108051","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205604","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128880","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[4764,"الليالي العقيمه","https://www.poetsgate.com/ViewPoem.aspx?id=32992",""],[4927,"شقاء الْمُغرم","https://www.poetsgate.com/ViewPoem.aspx?id=29957",""],[5539,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192505",""],[5309,"كل يوم فيه للخلق عبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573804",""]],"verses":[["قوتٌ يُقيم الجسم في عفّةٍ","أشعِرتُها قِدْماً وألحفْتُها",0,"ت",3,0],["قوتٌ ودَرُّ سَحابٍ أمسكا رمقاً","فما التنافسُ في دُرٍّ وياقوتِ",1,"ت",1,0],["قوتي غَنايَ وَطِمري ساتِري وَتُقى","مَولايَ كَنزي وَوِردَ الموتِ مَوعودي",2,"د",2,0],["قوتُ روحي ذِكْرُها أنّى تحُو","رُ عن التّوقِ لِذِكْري هَيِّ هَي",3,"ي",1,0],["قوتُ الشعوبِ ورِيُّها أحلامُها","إنّ الخيالَ إلى الحقيقةِ سُلّمُ",4,"م",1,0],["قوتل الإنسان كم دمر بي","وأنا روح النظام الأمثل",5,"ل",1,0],["قوتلوا من بشر أفضلهم","إن يفاضل أي وحش يفضل",5,"ل",1,0],["قوتي همومي على أن الفؤاد لها","فوت فدأبي أفنيها وتفنيني",6,"ن",2,0],["قوت العدات إلى الكماة وإنما","أغديت أسد الغاب بالأنعام",7,"م",1,0],["قوت روحي هواك بل روح ذاتي","وحياتي وهل سواك حياتي",8,"ت",2,1],["قُوتي بفيِها وعيْشي بَرْدُ ريقَتِها","إذا نأى ريقُها ناديْتُ ياقُوتي",9,"ي",1,0],["قوتُكَ الذِكرُ فيه والوردُ وِردٌ","إن دعاكَ الأنامُ نحو الوُرودِ",10,"د",1,0],["قُوَّتَى بَرٍّ وبحرِ","وصَنَادِيد شِدَاد",11,"د",1,0],["قوتي حياتي وكذا","سلامتي أن أعطب",12,"ب",1,0],["قُوتُ النفوسِ وصَفوُها ونعيمها","نُورُ الوجود سعادةُ الانسانِ",13,"ن",1,0],["قوتُ القلوبِ منَ الّسرور رَهِينةٌ","ببقائكمْ من غير ما إنْكارِ",14,"ر",1,1],["قَوَّتْ له الآدابُ فينا سُنَّةً","عَرَضُ الفتوةِ في قُواها جوهر",15,"ر",1,0],["قوتي عليك مدى مقامي لم يزل","فانعم وعجله لمدة سفرتي",16,"ت",2,0],["قوتل الإنسان ما أكفَرهُ","فهو لا يرضيه من حالٍ بقاء",17,"ا",2,0],["قوت النفوس من المدامة وحدها","فاحفل بها قوتُ الجسوم كثير",18,"ر",1,0],["قوتك الحمد فيه والذكر دأبا","والمناجاة تارة والدعاء",19,"ا",2,0],["قوت النفوس وانما القرآن قو","ت القلب أنى يستوي القوتان",20,"ن",1,0],["قوتل الخلق لست تلقى بهم إلا","لئيماً مدنس النيات",21,"ت",1,0],["قُوتُ النفوس وقُوَّةُ الأرواحِ في","خُبزٍ وخمرٍ جَلَّ عن فَهمٍ ذكا",22,"ا",1,0],["قوته للوطن المعمودِ","أقوى من العدة والعديدِ",23,"د",1,0],["قوتهم كسرة الشعير اذا ما","بللوها بلت بدمع غزير",24,"ر",1,0],["قوتها دائما ينابيع تبرٍ","هي تقتاتها بغير توان",25,"ن",1,0],["قوّت جروحي زودت حلكة الظيم","وذابت بها سطوة عقولٍ حكيمه",26,"م",2,0],["قُوْتُ الْقُلُوْبِ لِمَنْ تَعَلَّقَ بِالَّتِيْ","لِغَرَاْمِهَاْ فَوْقَ النُّعُوْتِ نُعُوْتُ",27,"ت",1,0],["قوت القلوب اللي شقت بالمعانات","واللي السعاده عن طرفه محظوره",28,"ر",2,0],["قوتِلَ الإِنسانُ ما أَكفَرَهُ","أَهمَلَ الرّوحَ فَأَغواهُ الحَجَر",29,"ر",1,0]]}