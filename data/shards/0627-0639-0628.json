ps://www.poetsgate.com/ViewPoem.aspx?id=21231",""],[99,"ورقة إلى القارىء","https://www.poetsgate.com/ViewPoem.aspx?id=17760",""],[91,"فلنعش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67817&r=&rc=100",""],[128,"أعباس بن مرداس ألما","https://www.aldiwan.net/poem24256.html","الوافر"],[128,"أعباس إن الذي بيننا","https://www.aldiwan.net/poem24257.html","المتقارب"],[128,"أعباس إما كرهت الحروب","https://www.aldiwan.net/poem24267.html","المتقارب"],[128,"أعباس إنا وما بيننا","https://www.aldiwan.net/poem24271.html","المتقارب"],[132,"أعبد الله إن سبتك عرسي","https://www.aldiwan.net/poem24006.html","الوافر"],[133,"أيا عين السلامة لا تنامى","https://www.aldiwan.net/poem54740.html","الوافر"],[135,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[144,"تسد إذا حم الحمام المذاهب","https://www.aldiwan.net/poem11729.html","الطويل"],[165,"لا يفوت الموت من حذر","https://www.aldiwan.net/poem67811.html","المديد"],[200,"شكوت هواها فاشتكتني إلى هجر","https://www.aldiwan.net/poem45650.html","الطويل"],[222,"لقد مزق الشوق قلبي الوفي","https://www.aldiwan.net/poem55307.html","المتقارب"],[226,"أعباس يا فرع المكارم والعلا","https://www.aldiwan.net/poem55237.html","الطويل"],[230,"ألا من لنفسي وأوصابها","https://www.aldiwan.net/poem51210.html","المتقارب"],[232,"أئمة أهل الحب ما القول في فتى","https://www.aldiwan.net/poem44555.html","الطويل"],[242,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[242,"وملك وإن طال المدى سيبيد","https://www.aldiwan.net/poem45773.html","الطويل"],[276,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[329,"أخت أحلامي الذواهب مرحى","https://www.aldiwan.net/poem54958.html","الخفيف"],[366,"أعباس هل أبصرت مثلي فارسا","https://www.aldiwan.net/poem44373.html","الطويل"],[366,"لمن طلل بالعمق أصبح دارسا","https://www.aldiwan.net/poem44502.html","الطويل"],[382,"هاج رسم دارس طرباً","https://www.aldiwan.net/poem400.html",""],[401,"موازين الرجال","https://www.aldiwan.net/poem6777.html","عموديه"],[433,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[454,"غطست فيه حين بعثرت","https://www.aldiwan.net/poem61334.html","الخفيف"],[483,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[501,"تجرأ حزب الجاحدين كما تشا","https://www.aldiwan.net/poem37564.html","الطويل"],[501,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[539,"أعبد اللطيف أجب عمرا","https://www.aldiwan.net/poem47462.html","عموديه"],[541,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"],[559,"اعبد على الكشف وادخل ساحة الإحسان","https://www.aldiwan.net/poem33826.html","المواليا"]],"verses":[["أَعَبلَةُ قَد زادَ شَوقي وَم","أَرى الدَهرَ يُدني إِلَيَّ الأَحِبَّه",0,"ب",2,0],["أَعَبلَةُ لَو سَأَلتِ الرُمحَ عَنّي","أَجابَكِ وَهوَ مُنطَلِقُ اللِسانِ",1,"ن",1,0],["أَعَبّادُ يا أَوفى المُلوكِ لَقَد عَدا","عَلَيكَ زَمانٌ مِن سَجِيَّتِهِ الغَدرُ",2,"ر",1,0],["أَعَبّادُ يا أَوفى المُلوكِ بِذِمَّةٍ","وَأَرعاهُمُ عَهداً وَأَطوَلَهُم يَدا",3,"د",2,0],["أَعَبْدَ الله هَذَا اليومُ وَافَى","وَللدنْيَا بِبَهْجَتِهِ ابْتِسَامُ",4,"م",1,0],["أَعَبدَ بَني اِمرِئِ القَيسِ اِبنَ لُؤم","أَلَم تَسأَل قُضاعَةَ أَو نِزارا",5,"ر",2,0],["أَعَبداً حَلَّ في شُعَبى غَريباً","أَلُؤماً لا أَبالَكَ وَاِغتِرابا",6,"ب",2,0],["أَعِبتَ فَوارِسَ يَومِ الغَبيطِ","وَأَيّامَ بِشرِ بَني مَرثَدِ",7,"د",1,0],["أَعَبدَ التَيمِ إِنَّ بَني تَميمٍ","تَلَبَّسَ فيهِمُ أَجَمي وَغَيلي",8,"ل",2,0],["أَعِبتَ فَوارِساً رَجَعوا بِتَيمٍ","وَرَكضَهُمُ مُبادَرَةَ الأَصيلِ",8,"ل",1,0],["أَعَبدُ هَجينٌ أَحمَرُ اللَونِ فاقِعٌ","مُوَتَّرُ عِلباءِ القَفا قَطَطٌ جَعدُ",9,"د",1,0],["أعبق من ذكره ولا عبق المس","ك المسمَّى أقلّ خدَّامه",10,"م",2,0],["أعبقته من طيب ريحك نفحةً","كادت تكون ثناءك المسموعا",11,"ع",2,0],["أَعَبدَ آلِ بَغيضٍ لا أَبا لَكُمُ","عَبسٍ تَخافونَ وَالعَبسِيُّ مُحتَقَرُ",12,"ر",1,0],["إِعبَثِ ما شِئتِ يا دُنيا بِنا","وَتَحَكَّم ما تَشاءُ يا قَدَرُ",13,"ر",1,0],["اُعبُدِ اللَهَ بِعَقلٍ يا بُنَيَّ","وَبِقَلبٍ مِن رَجاءِ اللَهِ حَي",14,"ي",1,0],["أَعَبدٌ تُعتَقُ في إِنعامِهِ","مِنهُمُ الدَهرَ وَحورٌّ يُستَرَق",15,"ق",1,0],["أَعَبدَ اللَهِ أَنتَ أَحَقُّ ماشٍ","وَساعٍ بِالجَماهيرِ الكِبارِ",16,"ر",1,1],["أَعَبدَ اللَهِ قُم وَاِقعُد بِهَجري","فَقَد أُلقيتَ مِن بالي وَفِكري",17,"ر",2,1],["أَعَبدونُ قَد صِرتَ أُحدوثَةً","يُدَوَّنُ سائِرُ أَخبارِها",18,"ر",3,1],["أَعَبدَ اللَهِ دَع لَوّاً وَلَيتا","فَقَد أَصبَحتَ يا مِسكينُ مَيتا",19,"ت",2,1],["أعبدٌ خسيسٌ أنتَ أمْ أنتَ زاهدٌ","عظيمٌ كما كانَ ابنُ أدهمَ أو بشرُ",20,"ر",1,0],["أُعَبِّسُ حينَ ألقاهُ","كأني لستُ أهواهُ",21,"ا",2,1],["أَعَبدَةُ ما يَنسى مَوَدَّتَكِ القَلبُ","وَلا هُوَ يُسليهِ رَخاءٌ وَلا كَربُ",22,"ب",1,1],["أعبدَ اللهِ مالكَ من خَلاقِ","فَعُدْ بالنّاكِثينَ ذوي النّفاقِ",23,"ق",1,0],["أَعَبدَ اِبنَ يَربوعِ اِبنِ ضَرطِ اِبنِ مازِنٍ","كُلوا ما اِستَطَعتُم وَاِهدُروا بِالشَقاشِقِ",24,"ق",1,1],["أَعُبَيدَ يا ذاتَ الهَوى النَزرِ","ثَقُلَت مُوَدَّتُكُم عَلى ظَهري",25,"ر",2,1],["أَعُبَيدَ هَلّا تَذكُرينَ فَتىً","تَيَّمتِهِ بِحَديثكِ السِحرِ",25,"ر",1,0],["أَعُبَيدَ هَلّا تَنقَمينَ عَلى فَتىً","نَفِدَت رُقاهُ وَسُقمُهُ مَوتورُ",26,"ر",1,0],["أَعَبّادَ أَغفَلتِ وَجدي بِكُم","فَلَيتَكِ لَم تُغفِلي الواجِدا",27,"د",2,0],["أَعَبدَةُ قَد غَلَبتِ عَلى فُؤادي","بِدَلِّكِ فَاِرجِعي بَعضَ الفُؤادِ",28,"د",1,1],["أَعَبدَ قَد طالَ في ذِكراكِ تَفنيدي","وَكِدتُ أَقضي وَما تُقضى مَواعيدي",29,"د",2,1],["أَعَبّادَةُ لَو تَنسا","كِ نَفسي لِتَناسَيتُ",30,"ت",1,0],["أَعَبّادَةُ مِن حُبِّ","كِ في الأَحشاءِ كَاللَهبِ",31,"ب",1,0],["أعُبَيدَ قَد أَثبَتِّهِ بِهَوىً","في مُضمَرِ الأَحشاءِ لاهِبُهُ",32,"ب",2,0],["أَعبُدِ اللَهَ لا تَظاهَر لِمَن جا","وَرتَ يَوماً بِسُنَّةٍ أَو بِرَفضِ",33,"ض",1,1],["أَعِبرِيٌّ تَهَوَّكَ في حَديثٍ","فَباعَ المُشكِلاتِ كَما اِشتَراها",34,"ا",3,0],["أعُبّادَ المَسيحِ يَخافُ صَحْبي","ونحنُ عَبيدُ مَنْ خَلَقَ المَسيحا",35,"ح",2,0],["أَعبد الغنيّ اسمع إذا كنتَ سامعاً","نداء أَخٍ قد نابه بعدك الضر",36,"ر",1,0],["أعبرةً تذكرها كلَّ حينْ","للعالم الذَّاكرِ إمَّا نسِي",37,"ي",1,0],["أعبد اللَّه ، خير من حياتى","وطول ذمائها موت مريحُ",38,"ح",1,1],["أَعَبلَةُ قَد زادَ شَوقي وَما","أَرى الدَهرَ يُدني إِلَيَّ الأَحِبَّه",39,"ب",2,0],["أَعَبَّاسُ إِنْ تَكْبُرْ على النَّاسِ هِمَّةً","فَأَيْنَ مَقامُ النَّاسِ مِنْكَ وَلاَ فَخْرُ",40,"ر",1,0],["أَعُبُّ عَبّاً مِنْ يَنَابِيعِهِ","وَالْقَلْبُ يُرْوَى لَهُ حَرُّ",41,"ر",1,0],["أَعبد الغني وَهَبت الفظاظ","وَكَيفَ وَأَنتَ الَّذي فَظَّظا",42,"ظ",2,0],["أَعبدَ الغنيّ اِبني إِلى رَبّكَ الرجعى","فَكُن شافِعي عِندَ الَّذي أَخرَجَ المَرعى",43,"ع",2,1],["أَعَبدَ الغنيّ اِلتَفِت","لِبَثٍّ بِقَلبي لَبَث",44,"ث",1,0],["أَعبدُ الغنيّ اِبني شَذَذتَ نَجابَةً","وَما زالَت الأنجابُ مِثلكَ شُذَّذا",45,"ذ",2,0],["أعبد الغنيّ اِشفَعَن لي غَداً","لِيَجمَعَنا اللَهُ في مُتَّكا",46,"ك",2,0],["أعبد ريان بماء النعيم","ألبسني السقمَ بلحظٍ سقيم",47,"م",1,1],["أَعبد الغَنيّ اِختَرتَ دارَ كَرامَةٍ","نَزَلت بِها حَيثُ الكِرام نزولُ",48,"ل",1,0],["أعبدَ بنَ يربوع بن ضرطِ بن مازنٍ","كلوا ما استطعتمْ واهدروا بالشّقاشقِ",49,"ق",1,1],["أَعْبُدٌ تُعْتْقُ في إِنعَامِهِ","مِنْهُمُ الدَّهْرَ وحُرُّ يُسْتَرَقّ",50,"ق",1,0],["أعبدَ اللهِ للبرقِ اليماني","يُضِيءُ حَبيَّ ذِي سِقْطَيْنِ دَانِي",51,"ي",1,1],["أُعبِّيءُ جيبي نجوماً .. وأَبْني","على مقعدِ الشمس لي مقعدا",52,"ا",1,0],["إعبثي ما شئت يا دنيا بنا","وتحكّم ما تشاء يا قدر",53,"ر",1,0],["أَعَبّاسُ بنُ مِرداسٍ أَلَمّا","تُخَبِّرُكَ المَجامِعُ عَن خُفافِ",54,"ف",1,1],["أَعباسُ إِنَّ الَّذي بَينَنا","أَبى أَن يُجاوِزَهُ أَربَعُ",55,"ع",1,1],["أَعبّاسُ إِمّا كَرِهتَ الحُروبَ","فَقَد ذُقتَ مِن عَضِّها ما كَفى",56,"ا",1,1],["أَعبّاسُ إِنّا وَما بَينَنا","كَصَدعِ الزُجاجَةِ لا يُجبَرُ",57,"ر",1,1],["أَعبّاسُ أَنّ اِستَعارَ القَصيدُ","في غَيرِ مَعشَرِهِ مُنكَرُ",57,"ر",1,0],["أَعَبدَ اللَهِ إِن سَبَّتكَ عِرسي","تَساقَطَ بَعضُ لَحمي قَبلَ بَعضِ",58,"ض",1,1],["أعبدَ اللهِ عِش مَلِكاً هُمَاماً","وُقِيتَ الشَّرَّ مِن مَلِكٍ هُمَامِ",59,"م",1,0],["أَعَبدَ مَنافٍ أَنتُمُ خَيرُ قَومِكُم","فَلا تُشرِكوا في أَمرِكُم كُلَّ واغِلِ",60,"ل",1,0],["أُعَبِّرُ بِالتَذكيرِ عَمداً وَإِنَّني","وَما إِن تَعَدَّيتُ الكِنايَةَ هائِبُ",61,"ب",1,0],["أَعبُدٌ قِنٌّ يُصادِرُهُم","قَومٌ أُسودٌ تَنابيلُ",62,"ل",1,0],["أعباس إن لم يبتدرْ مدحك الورى","فلا نطقت لسنٌ بمدحك لا تجري",63,"ر",2,0],["أعباس هل أنت لا زلت لي","وعندك مما أقاسيه شي",64,"ي",1,0],["أَعَبّاس يا فرعَ المَكارمِ وَالعُلا","وَأَفضَلُ من في ظِلّ والِدِه سَما",65,"م",2,1],["أعبَّاسها كأبي حَرْبِها","عليٍّ وقاتِلِ نصَّابها",66,"ب",3,0],["أعبّاسكم كان سيفَ النبيّ","إذا أبدت الحربُ عن نابها",66,"ب",3,0],["أعبّاسكم كان قي بَدْره","يذود الكتائبَ عن غابها",66,"ب",3,0],["أعبّاسكم قاتِل المشركين","جِهاراً ومالِك أَسْلابِها",66,"ب",3,0],["أعبّاسكم كوصيّ النبيّ","ومُعْطي الرِّغاب لطُلاّبها",66,"ب",3,0],["أعبّاسكم شَرَح المُشْكلاتِ","وفَتَّح مُقْفَلَ أبوابها",66,"ب",3,0],["أعبر عن أنوار طلع وجهه","ببرق سرى من نحو كاظمة ليلا",67,"ل",2,0],["أعباسُ ترجو أن تكون خليفةً","لتوفيقنا فاسلم ونحنُ عبيدُ",68,"د",1,0],["أعباسُ لا تحزن على الملك إنه","كما رمته باقٍ وكيفَ تُريدُ",68,"د",1,0],["أعباسُ صار الملكُ في يد عادلٍ","وإنك تبنى صرحهُ وتشيدُ",68,"د",1,0],["أعباس ترجو أن تكونَ خليفةً","كما ودَّ آباءٌ ورامَ جُدودُ",69,"د",1,0],["أعباسُ لا تحزن على الملك إنه","تقضى فهذا الحزن ليس يفيدُ",69,"د",1,0],["أعباسُ صار الملكُ في يد عادلٍ","يذبُّ الردى عن حوضهِ ويذودُ",69,"د",1,0],["أعُبَّادَ المَسيح دنا رَدَاكُمْ","وأَخْرَسَ نَأْمةَ الجَرَس النِّداءُ",70,"ا",2,0],["اعبدي فكرة من النور عليا","تستثير الخيال والوجدانا",71,"ن",2,0],["أَعَبّاسُ هل أبصرتَ مِثليَ فارساً","إِذا الحربُ بالأَبطالِ شَبَّ وَقودُها",72,"د",3,1],["أَعَبَّاسُ لو كانت شِياراً جيادُنا","بِتَثليثَ ما ناصَيتَ بعدي الأحامسا",73,"س",2,0],["أَعبّاسُ إن تطمع فما ثَمَّ مَطمَعٌ","فَرُح قانعاً ممّا طَلَبتَ وآيِسا",73,"س",2,0],["أَعُبَيدُ هَل تَرى ظُعُناً","أَقبلت حَزايقا عُصَبا",74,"ب",2,0],["أَعبدَ اللَّه شكراً ثم شكر","يُزَفُّ إليكَ من بلد النِّضالِ",75,"ل",1,0],["أعَبْدَ اللَّهِ ما كلُّ المرَاي","تُرينا صورةَ الوجه المثالي",75,"ل",2,0],["أعبَد اللَّه ما وقفتْ خُطان","عن السَّير الحثيثِ إلى الكمالِ",75,"ل",1,0],["أعُبَيْدُ ما خابَ امرؤٌ عونٌ له","عونٌ إذا ما هزّتِ اللأواءُ",76,"ا",2,0],["أعُبيدُ ما لجريرَ فيك جريرةٌ","لو بصّرتْك طريقَها الآراءُ",76,"ا",2,0],["إعبثي أيها العصافير بالماء","فأنت الأطفال تلهو وتغنم",77,"م",1,0],["أعبير أنس أم فسيح أجنة","أشموس بدر ديره حانات",78,"ت",1,0],["أعبت الكرام الطيِّبن ولم تكن","لغير أفانين الأكاذيب راويه",79,"ي",2,0],["اعْبُدِ اللهَ خاشِعاً بفُؤادٍ","خالِصٍ طاهِرٍ سَليمٍ نَقِيِّ",80,"ي",1,0],["أعبدَ اللَّطيفِ أجِب عُمَرَا","وأوجِز جَوابَكَواختَصِرَا",81,"ر",2,1],["أَعَبدَ الواحِدِ المَحمود إِنّي","أَغَصُّ حذار سُخطِكَ بالقَراحِ",82,"ح",1,0],["اعبد على الكشف وادخل ساحة الإحسانْ","واطلق جوادكْ بلا لجمٍ ولا أرسانْ",83,"ن",1,1]]}