{"poems":[[46,"جعلت فداك أنت من لا ندله","https://www.aldiwan.net/poem30370.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122612","البسيط"],[5493,"أسرار الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=197477",""]],"verses":[["وَفَيءٌ فَوَقِّرهُ وَإِنّي لَواثِقٌ","بِأَن لا يَراكَ اللَهُ مِمَّن يَغُلُّهُ",0,"ل",2,0],["وفَيءُ خَيلِكَ مِن أعدائِها هَدَرٌ","لَغوٌ وكُلُّ دمٍ أهرقتَهُ هدَر",1,"ر",1,0],["وفيْءٌ ظليلٌ يُغنِّي لِدوحٍ","برقصٍ يُزَفُّ لِأَشجَارِهِ",2,"ر",2,0]]}