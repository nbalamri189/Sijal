{"poems":[[55,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[55,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[88,"لمحت من مصر ذاك التاج والقمرا","https://www.aldiwan.net/poem68954.html","البسيط"],[37,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[90,"وفدفد قاتم الأعماق متسع","https://www.aldiwan.net/poem44438.html","البسيط"],[74,"ما للندى لا يلبي صوت داعيه","https://www.aldiwan.net/poem20565.html","البسيط"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[53,"دع صاعدا يقتني الدنيا وزبرجها","https://www.aldiwan.net/poem64955.html","البسيط"],[53,"طرقت بنشوة روضة ربعية","https://www.aldiwan.net/poem65736.html","الطويل"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[53,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[93,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[93,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[93,"بأبي خيال لاح لي متلففا","https://www.aldiwan.net/poem62779.html","عموديه"],[72,"إن شكا القلب هجركم","https://www.aldiwan.net/poem42888.html","مجزوء الخفيف"],[87,"إن تسألي عن مصر حواء القرى","https://www.aldiwan.net/poem8089.html","الكامل"],[63,"على غير عتب ما طويت عتابها","https://www.aldiwan.net/poem51781.html","الطويل"],[68,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[68,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[71,"ما طلبنا الخمول جهلا ولكن","https://www.aldiwan.net/poem28707.html","الخفيف"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[78,"ومعترك تهز به المنايا","https://www.aldiwan.net/poem38842.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[111,"ماذا تريد من الدنيا تعنيها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66822&r=&rc=1",""],[87,"إن تسألي عن مصرَ حواءِ القرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9656&r=&rc=146",""],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[215,"دوافق من مطر","https://www.aldiwan.net/poem46590.html","مجزوء الرجز"],[234,"أيها الماجد الذي لم يقصر","https://www.aldiwan.net/poem51050.html","الخفيف"],[234,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[237,"لما وردت فديتها أسطركم","https://www.aldiwan.net/poem14921.html","الدوبيت"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[285,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[364,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[369,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[469,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[520,"لو أمكنتني في مدحي لك الشهب","https://www.aldiwan.net/poem12022.html","البسيط"],[520,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[556,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[567,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138200",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48703","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64040","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70984","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56623","الكامل"],[1661,"","https://poetry.dctabudhabi.ae/diwan/poem/67817","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125364","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53045","المنسرح"],[2255,"","https://poetry.dctabudhabi.ae/diwan/poem/34918","البسيط"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140242",""],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126222","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93579","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102564","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146351","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109826","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45795","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36265","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36301","الدوبيت"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78311","الوافر"],[4058,"","https://poetry.dctabudhabi.ae/diwan/poem/118048","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73351","الدوبيت"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52125","الكامل"],[4679,"أهلال أفق المجد لا برح القضا","https://www.poetsgate.com/ViewPoem.aspx?id=142751",""],[1012,"الشعشعة","https://www.poetsgate.com/ViewPoem.aspx?id=186277",""],[4929,"الى الذين يطلبون من صنعاء أن تنتفض","https://www.poetsgate.com/ViewPoem.aspx?id=199409",""],[5136,"أدعوه يا قمري غلط","https://www.poetsgate.com/ViewPoem.aspx?id=121933",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5431,"قصيدة قلقه...","https://www.poetsgate.com/ViewPoem.aspx?id=201108",""],[5725,"غافلت في وصلك","https://www.poetsgate.com/ViewPoem.aspx?id=200865",""],[5950,"المشهد الأخير ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128146",""],[6035,"تشوقني تلك العيون .. !","https://www.poetsgate.com/ViewPoem.aspx?id=176654",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""]],"verses":[["لَو أَمكَنوا وَصَلوا بِكُلِّ مُثَقَّفٍ","يَسِمُ الطُلى في الطَعنِ كُلَّ بَنانِ",0,"ن",1,0],["لَو أَمطَرَتهُ السَماءُ أَنجُمَها","عِزّاً لَما قالَ لِلسَماءِ قَدي",1,"د",2,0],["لَو أَمطَرَ الغَيثُ أَرضاً تَستَظِلُّ بِهِم","عَدَت رُؤوسَهُمُ عَن وَجهِها المَطَرا",2,"ر",2,0],["لَوامِعَ يَخطِفنَ النُفوسَ كَأَنَّها","مَصابيحُ شَبَّت أَو بروقٌ عَوامِلُ",3,"ل",1,0],["لو امتطاها لبيد قبل تاه بها","على الحواضر قدماً والأعاريب",4,"ب",1,0],["لو أمكنَ الصبر عنهُ ما أنستُ به","فكيفَ والحزنُ من أحشاي ينعيه",5,"ي",2,0],["لو أمكن الشمس التي تجلى له","ما سمِّيت من خوفها غزاله",6,"ه",1,0],["لو امتحنَ الله البحارَ بجوده","لأضحتْ وأمست من عطاياه غُيَّضا",7,"ض",2,0],["لو آمنتْ أنفسٌ باللَّهِ ما شُغِلْت","عنه بما ليس في فقدانِه مَضَض",8,"ض",1,0],["لو أمتع المرءَ الشبابُ حياتَه","أزرى به أن المآرب تخلق",9,"ق",1,0],["لو امتريتَ به الأرزاقَ أنزلها","ولو قرعْتَ به الآجالَ ما نكلا",10,"ل",2,0],["لو أمهلتكَ مدى ثوائك في استها","لسلمْتَ لكنْ داؤها لم يُمهلِ",11,"ل",1,0],["لَو أَملِكُ الأَقدارَ أَو تَصريفَها","لَأَمَرتُها فَجَرَت بِما يُرضيكِ",12,"ك",1,0],["لَو اِمَّحى عالَمُ الخُطوبِ","لَقامَ مِنهُم لَها مُعيدُ",13,"د",1,0],["لَو أَمسَتِ الدُنيا لِغَيري كُلُّها","وَرُبّاهُ لي ما كُنتُ بِالمَغبونِ",14,"ن",1,0],["لَو أَمَرتُم بِما عَسى","ماتَعَدَّيتُ أَمرَكُم",15,"م",1,0],["لَو أَمهَلوا حَتّى النُشورِ بِدَورِهِم","قاموا لِخالِقِهِم بِغَيرِ غُبارِ",16,"ر",1,0],["لوامعُ بَرْقٍ لا تَمَسُّ أراكَها","وأنفاسُ ريحٍ لا تروعُ تُرابَها",17,"ب",3,0],["لَو أَمَّها يَومَ القِيامَةِ طالِبٌ","نَقَلَت إِلى ميزانِهِ حَسَناتِها",18,"ت",3,0],["لَو آمَنَت بِكَ كُلُّ الناسِ مُخلِصَةً","لَم يُخشَ في البَعثِ مِن بَخسٍ وَلا رَهَقِ",19,"ق",1,0],["لو أَمْسَكُوا بِقَمِيصِ الرِّيحِ ما بَرِحَتْ","أو أَظْهَرُوا بَرَمَاً بالتَّل ما وَطَدَا",20,"د",2,0],["لو أمنَّا الزحامَ فيه لكُنَّا","نشتهيهِ لصاحبٍ وحبيبِ",21,"ب",1,0],["لَوْ أمْكَنَ الْقَوْمَ وَزْنُ المالِ لاتَّخَذُوا","لَهُ الموازِينَ مِنْ بَعْدِ القَبابِينِ",22,"ن",1,0],["لوامِعُ يُبْصِرُ الأعْمَى سَناها","وَيَعْمَى دُونَها طَرْفُ البَصيرِ",23,"ر",1,0],["لو أمْسَكَتْ ما زَلّ عن سَرْدِها","لأُبْصِرَ الدّارِعُ كالشَّيْهَم",24,"م",1,0],["لَوْ امعَنَتْ صُعُداً لَمَا ضَلُعتْ وَلاَ","رسَخَتْ وَلاَ جَلدَتْ لِرَدِّ نَآدِ",25,"د",1,0],["لو أمكن القوم نطق كان نطقهم","ريب المنون جرت فينا عواديها",26,"ي",3,0],["لو أُمهلوا حتى النُّشُورِ بِدُورِهم","قاموا لخالقهم بعير غبار!",27,"ر",1,0],["لو أمسكتْ بنانُه معروفَه","لأصبحتْ من كفِّه طَوالقا",28,"ق",2,0],["لوامع من شرر","أخفّ منها سقر",29,"ر",1,0],["لو أمِنتُ الذي حذرتُ إذاً زر","تُكَ فيهنّ أوّل الزُّوّار",30,"ر",1,0],["لو أمَّهُ من عُفاته أحَدٌ","يقول هَبْ لي عُلاكَ أعطاها",31,"ا",3,0],["لَو أَمكَنَني بَعَثتُ مَع خَطِّ يَدي","عَيني فَلَعَلَّ ساعَةً تَنظُرُكُم",32,"م",1,0],["لَوْ أُمْهِلَتْ تِلْكَ الشَّمائِلُ لَمْ تَفَزْ","يَوْماً بِأَغْرَبَ مِنْ عُلاكَ وَأَبْدَعِ",33,"ع",1,0],["لُوْ أَمِنْتُ الْمَلامَ وَالْدَّمْعَ ما اخْتَرْ","تُ وُقُوفِي عَلَى الْمَنازِلِ وَحْدِي",34,"د",2,0],["لوامع برق في صواعق نقمة","تجرِّعهم كأساً تحسَّوا به قسرا",35,"ر",2,0],["لو أَمكنَ الدّهرَ أَن يَبقَى على نَسَقٍ","ما زال باديه حتّى جاءَ تاليه",36,"ي",2,0],["لوامعُ قولٍ كالسراب بلالهُ","بطيءٌ وسَرَّ العينَ ما يترقرقُ",37,"ق",1,0],["لو املكُ الدنيا سمحتُ بها لمَن","وأوفى بمقدمكَ السعيد مبشِّرا",38,"ر",2,0],["لو أمكنتني في مدحي لك الشهب","لم يرضني في علاك الشعر والخطب",39,"ب",1,1],["لو أمكنته النيرات لأصبحت","فيه ولكن ليس في الإمكان",40,"ن",1,0],["لَوامِع لَم تكنْ للغيث جاذبةً","وأنجُمٌ لم تُنِرْ للمُدْلِجِ السَّاري",41,"ر",2,0],["لو أمكَنَ البحرَ أنْ يُهدِيهِ جَوهَرهُ","لم يُبقِ في جَوفِهِ دُرّاً ولا صَدَفا",42,"ف",2,0],["لَوَّامةٌ أوقفتني لا أُطاوعُها","ولا يُحبِّبُ ضُعفِي أنْ أُعاصيها",43,"ي",3,0],["لو أمطرت يده الكريمة نائلا","شمت الغيوث تسح منه وتنسكب",44,"ب",1,0],["لو أملك الكتمان ما أشمت بي","خصماً ألدَّ ولا رقيباً واشيا",45,"ي",2,0],["لو أمال الأقلامَ في فَيْلَقٍ قا","مَتْ مقامَ الأرماحِ والأسياف",46,"ف",1,0],["لو أمُّها تعطيكَ من مالها","ومن أبيها مهرَها والصداقْ",47,"ق",1,0],["لو أمهلتك لكي تودع معشراً","سبقت قلوبهم إليك تودع",48,"ع",1,0],["لو أمكنني غداتئذٍ جلاداً","لأَلفوني به سمحاً سخيا",49,"ي",2,0],["لو أمكن الأقلامَ أن تسعى على","قَدَمٍ لعُرسِكَ عَزَّ أن تَتَأَخَّرَا",50,"ر",2,0],["لوامة حلف الملامه","أهدت إلى قلبي سقامه",51,"م",2,1],["لوامة نوامة","أين المنام من الملامه",51,"م",2,0],["لو أمكن البدر أن يقابلها","كان بذيل الغمام ينتقب",52,"ب",1,0],["لَو أَمَّنَتني الَّذي نَفسي تَخَوَّفُهُ","مِنهُم بِبَغدادَ يَوماً عُذتُ بِالصينِ",53,"ن",1,0],["لو أمكنت سائر البلدان رؤيتها","خرت لها سجدا للوجه والذقن",54,"ن",1,0],["لو أمسَكوا عن سبِّ مَن تقدَّموا","فالقذفُ ويكَ غِبُّه ليلٌ سَجا",55,"ا",1,0],["لوامِعُ وَجهِ الحقِّ فى القلبِ نازِلٌ","وأُنسِى بذا الوَجهِ المقدَّسِ كامِلُ",56,"ل",1,1],["لَوامِسُ غِيدانِ الغَزَالِ تَعَشَّقتُ","لصَوتِ حَمَامٍ غَرَّدَتهَ الحواصِلَ",56,"ل",1,0],["لَو أَمحَلَت كُل البِلاد فَأَرضه","تَأوي لَها الورّاد وَالروّاد",57,"د",1,0],["لو أمّ خشف فارقته وقد غدا","تطوى الفيافي لا تؤمّ دليلا",58,"ل",2,0],["لو امتلأَت بها أُذنُ ابنِ حُجرٍ","لعلّقها مع السبع الطِوال",59,"ل",1,0],["لو امكن الاقلام ان تمشي على","قدم لخرت حول قبرك ركعا",60,"ع",2,0],["لَو أَملَت كُل البَرية بَعض ما","فيهِ لَأَمسى رُشدَها كَضِلالها",61,"ا",1,0],["لَو أَمعَنَتِ النُحاةَ فيها نَظَراً","لَم تَدَّعِ للمذكَّر التَغليبا",62,"ب",2,0],["لَو أَمكَنَني عَلى الحِمى مُنعَرِجُ","لَم يَبقَ لِقَلبيَ المعنّى حَرَجُ",63,"ج",1,1],["لَوامع نيرات كان قَلبي","لِشَوق ضِيائِها وَلَها يُعاني",64,"ن",2,0],["لو امكنني غداة إذن جلاد","لألفوني به سمحاً سخيّاً",65,"ي",2,0],["لَو أَمَكَنَهُ أَعلاكَ عَن رُتبَتِهِ","أَو جاءَ إِليكَ صاغِراً يَعتذِرُ",66,"ر",1,0],["لو أمطرتنا السحب سيلاً مفعماً","خلناه من فرط الهناء شحيحا",67,"ح",2,0],["لو أمكن القطر الذي قد سدته","إيفاء مدحك لانثنى لك ساجدا",68,"د",2,0],["لوامع برق في صواعق نقمة","بها لم يزل جيش الردى المتنوع",69,"ع",1,0],["لو أمرُ تحريريها يحتلُّ عندَكمُ","شيئا من الجد ما في الحسمِ من عَسَرِ",70,"ر",1,0],["لو أمكن القمر الهبوط","إليه يلثمه هبط",71,"ط",1,0],["لو أملك الغيب أو لو عدت في زمنٍ","لم تعرف الزيف لم تُخطء مزاميرُ",72,"ر",1,0],["لو أمطرت طينا يعانقها","مستنشقا من غيثها عبقه",73,"ق",2,0],["لو امعنوا فيك كل الشك ماوجدوا","اخفيت شذرك بالآهات فأحتبسا",74,"س",2,0],["لو أملك الريش كان أنفض جناحي وأطير","وأروح أخاوي بجنحاني طيور اليمام",75,"م",1,0],["لو أُمْسِكتْ في المُعْصِرات غيوثها","مااخضرَّ غصنٌ أوْ حِمالٌ أينعا",76,"ع",2,0],["لوّامتي زجرت لفعل شائن","كم لمت نفسي حينذاك كما ترى",77,"ر",2,0]]}