{"poems":[[50,"وأخي حفاظ ماجد","https://www.aldiwan.net/poem62521.html","مجزوء الكامل"],[141,"أنا ابن يزيد بن عبد الملك","https://www.aldiwan.net/poem67968.html","المتقارب"],[543,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59127","الخفيف"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128726","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26427","الوافر"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123705","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77301","الرمل"],[2687,"","https://poetry.dctabudhabi.ae/diwan/poem/130368","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115417","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34599","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141679","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139587",""],[4650,"","https://poetry.dctabudhabi.ae/diwan/poem/76555","الخفيف"],[5038,"رقصت","https://www.poetsgate.com/ViewPoem.aspx?id=189934",""],[5183,"إلى ربوع مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180214",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[6102,"اللي لزوما","https://www.poetsgate.com/ViewPoem.aspx?id=182909",""]],"verses":[["فَبَخِلتِ أَنتِ وَلَيسَ أَه","لُكِ مِن قَبيلِكِ بِالشِحاحِ",0,"ح",1,0],["فَبَخ بَخ بَخٍ لَكَ ما أَكرَمَك","وَبَخ بَخ بَخٍ لَكَ ما أَفخَرَك",1,"ك",1,0],["فَبِخَيرِ البِقاعِ فَلتَهنَأن يا","خيرَ مَن أمَّها مِنَ الأقيالِ",2,"ل",1,0],["فَبِخَدَّيْهِ طَالِعْ البَدْرِ","لَمْ يَكُنْ مُخْتَلَقْ",3,"ق",1,0],["فبخديه مثلما بفؤآدي","من لهيب تذكيه جذوة نار",4,"ر",1,0],["فَبَختَيشوعُ يَشهَدُ لِاِبنِ عَمروٍ","وَعَزّونٌ لِهارونَ المُرائي",5,"ا",2,0],["فبخده الورديّ روض قد جنت","منه نواظرنا وإن لم يقطف",6,"ف",1,0],["فَبِخِزيٍ بُؤ وَعارٍ خالِدٍ","وَتَبَوَّأ مَنصِباً في الأَرذَلين",7,"ن",1,0],["فبخٍ بخٍ طابت مواسم أنسنا","والهمُّ عنا قد ترحَّل واختفى",8,"ف",2,0],["فبِخَدِّهِ الزاهيَ أهيمُ صبابةً","وبصدغهِ يتغَزَّلُ الوأواءُ",9,"ا",2,0],["فبخديك للربيع رياضٌ","وبخديَّ للدموع غديرُ",10,"ر",1,0],["فبخاطري تذكاره متجدد","ولقد يظل بأنسهم مأهولا",11,"ل",2,0],["فبخضرائها تميس الأماني","وبهنَّ الآمال تسبح سبحا",12,"ح",2,0],["فَبخَدَّيهِ رَوضُ وَردٍ نَضِير","وَبِصُدغَيهِ غُصنُ آسٍ نَعِيمِ",13,"م",1,0],["فَبَخٍ بكأْسِ وِصالِها وسُلافَتي","ناراهما يُذْهِبْنَ كلَّ جَرائِري",14,"ر",2,0],["فبخ بخ لفتى تضلع منهما","ريا بعذب كالزلال معين",15,"ن",1,0],["فبخٍ بالرضا بخٍ وتجلٍّ","كهلال الأعياد وهو براء",16,"ا",2,0],["فَبَخَستَنِي قَدرِي ! وَ لَستَ مُوازِيًا","نَعلًا بِرِجلِي . أَيُّها المُتَأَزِّمُ",17,"م",1,0]]}