",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""],[6201,"كينونة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87476&r=&rc=0",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""]],"verses":[["هِمَّةٌ كَالسَماءِ بُعداً وَكَالري","حِ هُبوباً في كُلِّ شَرقٍ وَغَربِ",0,"ب",1,0],["هُم هامَةُ الحَيِّ إِذا حُصِّلوا","مِن جَعفَرٍ في السُؤدَدِ القاهِرِ",1,"ر",1,0],["هَمُّهُ فَصدُ دِنانٍ وَنَدىً","وَأَبوهُ هَمُّهُ جَمعُ النُقود",2,"د",1,0],["همّة دونها الكواكب نوراً","واعتلاءً يَعلو بها ويطول",3,"ل",1,0],["هَمُّها العِطرُ وَالفِراشُ وَيَعلو","ها لِجَينٌ وَلُؤلُؤٌ مَنظومُ",4,"م",1,0],["همةٌ جازت السماكَ فلم يع","بأ مداها بالحاسد العوّاء",5,"ا",2,0],["همة تعتلي على شرف الشه","ب ورفدٌ يدنو إلى الممتاح",6,"ح",1,0],["همَّة في سنائها جازت الشه","بَ وأمسى الهلال ذا أطواق",7,"ق",1,0],["همَّة جازت السماك وفي عق","ل الأعادِي وحالها دبران",8,"ن",1,0],["همَّة تحسب النجوم على الأف","قِ شعاعاً من جرمها يتجلَّى",9,"ل",2,0],["هُمُ هيَ لولا إرْبُهم وحلومهم","لهم منظر منها مَهيبٌ ومخبر",10,"ر",1,0],["همها الدهر مدمَجٌ","لحفافيه أحرُف",11,"ف",1,0],["هَمّه المسكين في عِرفانه","رأيُ مولىً لم يُبدِّل سُننه",12,"ن",2,0],["هُم هَدَّدوني حينَ صِحتُ بِهِم","صَيحاتِيَ الشَعواءَ مُنتَقِدا",13,"د",2,0],["هَمُّها في العِلمِ تُعلي شَأنَهُ","بَينَها وَالجَهلِ تَمحو أَثَرَه",14,"ر",2,0],["همه أن تزيد مصر رقياً","فتراه وراء ذلك يعدو",15,"د",2,0],["همة تكتبها مصر لهم","إن أبيتم أن تكونوا الكاتبين",16,"ن",1,0],["هَمُّهُ في ذَوي الأَسِنَّةِ لا في","ها وَأَطرافُها لَهُ كَالنِطاقِ",17,"ق",1,0],["هِمَّةٌ أَغرَبَت بِبُشتِ زَرَندٍ","يُحسِرُ الخَيلَ نَهجُها المَمدودُ",18,"د",1,0],["هِمَّةٌ أَنزَلَتهُ مَنزِلَةَ الموفي","عَلى النَجمِ مَأثُراتٍ وَمَجدا",19,"د",2,0],["هِمَّةٌ نَعرِفُها مِن جَعفَرٍ","وَخِلالُ فيهِ يَكثُرنَ العَدَد",20,"د",1,0],["هِمَّةٌ تَرذُلُ الدَنايا وَنَفسٌ","شَرُفَت أَن تَهُمَّ بِالإِشرافِ",21,"ف",1,0],["هَمُّهُ في غَدٍ بِتَفليقِ هامٍ","في قُرى العازَرونَ وَالمازِرونا",22,"ن",2,0],["هِمَّةٌ إن شامَها غاضَتْ به","هِمَّةٌ إن رامَها لاحٍ ألحّ",23,"ح",1,0],["هُمُ هُمُ في جَميعِ الفَضلِ ما عَدِموا","فَضلَ الإِخاءِ وَنَصَّ الذِكرِ وَالرَحِمِ",24,"م",1,0],["هِمَّةٌ تَنطَحُ النُجومَ وَجَدٌّ","آلِفٌ لِلحَضيضِ فَهوَ حَضيضُ",25,"ض",1,0],["هِمَّةُ النَّسرِ إذا ما نَهَضا","مِنْ سَجايا قَومِنا فِيما مَضَى",26,"ض",2,0],["هِمَّةُ المِقدَامِ مِن آلائها","وبَيانُ العبقريِّ المُفلِقِ",27,"ق",1,0],["هُمْ هنَّؤوكَ وأنت أهلٌ للذي","صنعوا وحَسْبُكَ أن يُفيقَ النّائمُ",28,"م",1,0],["هِمَّةٌ من هُدَى الرسولِ وَلُودٌ","تُورِثُ الشِّرْكَ والضَلالَةَ عُقْما",29,"م",2,0],["هَمُّها الأَعوَرُ الهِجانُ مُبا","ري الريحِ لِلشَرمَحِيَّةِ الأَزوالِ",30,"ل",1,0],["هَمُّهُ هَمّي وَهَمّي","هَمُّهُ في كُلِّ شانِ",31,"ن",1,0],["هَمُّها أَن تَزورَ عُقبَةَ في المُل","كِ فَتَروى مِن بَحرِهِ بِدِلاءِ",32,"ا",2,0],["هُمُ هَتَكوا بِالراحِ أَستارَ عاذِلٍ","وَلَم يَحفَظوا بِالنُسكِ حُرمَةَ ناتِقِ",33,"ق",1,0],["هِمَّةٌ في السَّمَاءِ تَسْحَبُ ذَيْلاً","مِن ذُيُولِ العُلا وجَدٌّ كابِي",34,"ب",2,0],["هَمُّهُ نِعْمَةٌ يَعِيشُونَ فِيهَا","بِصَفَاءٍ وَيُؤْمَنُ الإجْرَامُ",35,"م",1,0],["هِمَّةٌ لاَ تَنِي وَقلْبٌ خَفُوقٌ","لِلعُلَى لاَ يَهِي وَلاَ يَسْتَطِيرُ",36,"ر",1,0],["هُمْ هَؤُلاَءِ الشِّيبُ يُلْقُونَ الْعَصَا","وَعَلَى الرُّؤُوسِ مِنَ الْمَسِيرِ غُبَارُ",37,"ر",1,0],["هِمَّةٌ لاَ يَعُوقُهَا عَنْ مَدَاهَا","عَائِقٌ مِن تَرَدُّدٍ أَوْ تَفَادِي",38,"د",2,0],["هِمّةٌ تَفْرَعُ النُّجومَ وعَزْمٌ","سلَبَ السَّيْفَ حدَّه والفِرنْدَا",39,"د",2,0],["همّةٌ جاءت تناجي همَّةً","ويدٌ مُدّتْ إلى أكرمِ رَاحْ",40,"ح",1,0],["هِمَّةٌ تَفْرَعُ السمَاءَ وعَزْمٌ","لَيْس للسَّيْفِ حَدُّهُ وَمَضَاؤه",41,"ا",3,0],["هِمَّةٌ تَمْتَطِي السماءَ وَعَزْمٌ","يَرْهَبُ الدهْرُ سَيْفَهُ مَغْمُودا",42,"د",2,0],["هِمَّةٌ شادَتْ بِمِصْرٍ دَوْلَةً","صانَها الإِنْصَافُ والعِلْمُ وَقاها",43,"ا",3,0],["همهم في شهوات طبعهم","هم السوام في ارتياد المرتعى",44,"ا",1,0],["هِمَّة ٌ تَفْرَغُ السَماءَ وعَزْمٌ","لَيْسَ للسَّيْفِ حَدُّهُ ومَضَاؤه",45,"ا",3,0],["همه المزعج ما زا","ل مريعا صفونا",46,"ن",2,0],["هم هؤلاء ثلاثة ابوابهم","فيها المنى وطوائف الانعام",47,"م",1,0],["هَمُّه تدبيرُ الممالك في","الملك اجتهاداً وصومُه وصلاتُه",48,"ت",2,0],["همُّهُ أن يتَلهَّى","بِنحُورٍ وثُغور",49,"ر",1,0],["هِمَّةٍ أَزعَجَت قُلوبَ الأَعادي","وَاِطمَأَنَّت بِعَدلِها الدَهماءُ",50,"ا",2,0],["همةٌ في العلا اقتدت","بالسهى والفراقد",51,"د",1,0],["همُ همُ اِئتلفوا جمعاً وما اِختلفوا","لَولا الأبوَّة قلنا باِستوائهمِ",52,"م",1,0],["هُمُ هابوا القويَّ وَقدَّروه","وما اعتبروا الضعيفَ والكسولا",53,"ل",2,0],["همّه الأخبثانِ مِن أَجوفيه","وَهُما عند زعمه الأطيبانِ",54,"ن",1,0],["همة ما عرفتها لسواكم","وأنا من خبرت دهري وجيله",55,"ل",2,0],["هُمُ هَدَموا الهاماتِ بَعدَ اِعتِدالِها","بِصَحنِ نَهاوَندَ الَّتي قَد أَمَرَّتِ",56,"ت",1,1],["همة أن يتم ما جاء للنا","س به من هداية متاب",57,"ب",1,0],["همُّهم في الحياة أن يقتلوا الشع","بَ ويلقوا آمالَه في اللحود",58,"د",1,0],["همّه الحبّ والينابيع والوك","رُ ونجوى رفيقه الغريد",59,"د",1,0],["همّه الفكر في المجاعة والدين","وعقل الفتى وسقم الصبي",60,"ي",1,0],["همها البيت والتقى ورضا البعل","وغوث الجرحى ودفن الشهيد",61,"د",1,0],["همهم في الحياة اكل وشرب","وغناء وخمرة وسفاح",62,"ح",1,0],["هِمَّةٌ هَمُّها العلوُّ فما تَن","فَكُّ مِن ذاكَ دَهرها في اهتِمامِ",63,"م",1,0],["همهم في التشدق بالكلام","والتفيهق بها في كل اوان",64,"ن",1,0],["همه الله وحده","تاه في حبه وهام",65,"م",1,0],["هم هم فليصنعوا ما رأوا","بغيرهم ما أنا مستبدل",66,"ل",1,0],["هِمَّة همُّها اكتِسابُ المَعالي","فوق قطب العيوق لَيسَ يَزولُ",67,"ل",1,0],["هَمُّهُ كل غادة تَشبه اللؤ","لؤ مِنها لَوناً وَلَفظاً وَثَغرا",68,"ر",2,0],["هم هداة الخلق لولا جدُّهُم","وهداهم كانت الخلق بهائم",69,"م",1,0],["هِمَّةٌ تنشئُ الحَسُودَ وتُنْشِى","أَبداً بَيْنَ جانبَيْهِ الهُموما",70,"م",2,0],["همّةٌ لم تتثقَّفْ بمشيرٍ","واعتزامٌ أوّلٌ لا يتثنَّى",71,"ن",2,0],["همّةٌ قارنت قريناً من السع","د فسارت في الأفق حيث يسيرُ",72,"ر",1,0],["همَّة مالكةٌ أوقاتهُ","منعت مُقْلتهُ طيبَ الوسَنْ",73,"ن",1,0],["همة الأحرار تنهضه","أعين الخضرا تراعيه",74,"ي",2,0],["همهام همت بالكلام فهمهمت","عند المراق وخانها التعبير",75,"ر",1,0],["همُّها طيَّ وهمها في حضيضٍ","وسنا مجدنا ذر