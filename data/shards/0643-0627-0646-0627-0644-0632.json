{"poems":[[95,"أبقى ويرفض حولي عقد خلاني","https://www.aldiwan.net/poem11271.html","البسيط"],[74,"قاضي القضاة بيمنى حكمه القلم","https://www.aldiwan.net/poem19672.html","البسيط"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[93,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[68,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[82,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[82,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[46,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[50,"غدوت وما يشجي فؤادي خوادش","https://www.aldiwan.net/poem63271.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[93,"الشباب أبو المعجزات","https://www.poetsgate.com/ViewPoem.aspx?id=52993",""],[113,"صبر الفؤاد على فعال الجافي","https://www.aldiwan.net/poem16208.html","الكامل"],[168,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[203,"أعرني عينيك يا عاذلي","https://www.aldiwan.net/poem45230.html","المتقارب"],[203,"أم يكيد لها من نسلها العقب","https://www.aldiwan.net/poem45409.html","البسيط"],[280,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[280,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[280,"الحمد لله لا أهل ولا ولد","https://www.aldiwan.net/poem25572.html","البسيط"],[287,"هل دهرنا الماضي يعود","https://www.aldiwan.net/poem32804.html","مجزوء الكامل"],[342,"أعائش ما لأهلك لا أراهم","https://www.aldiwan.net/poem45426.html","الوافر"],[435,"هو الحب في العشاق ينفذ ما يقضي","https://www.aldiwan.net/poem39881.html","الطويل"],[438,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[438,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[463,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[469,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[482,"أعيا العواذل ما عندي من الكلف","https://www.aldiwan.net/poem15214.html","البسيط"],[520,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[569,"دعني أخي من الأدب","https://www.aldiwan.net/poem823.html",""],[572,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122680","الكامل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104105","الوافر"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130200","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64187","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64210","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59674","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62459","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59157","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72307","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35753","الهزج"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128067","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69410","البسيط"],[2001,"","https://poetry.dctabudhabi.ae/diwan/poem/111181","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93595","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109820","الوافر"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132949","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48409","الوافر"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77733","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92309","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92075","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92104","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102940","الكامل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103579","المتقارب"],[4908,"ضياع وشتاء","https://www.poetsgate.com/ViewPoem.aspx?id=207329",""],[5092,"لهُ الحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=179342",""],[5539,"الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=194073",""],[5726,"مات السماحُ وماتَ الجودُ والكرمُ","https://www.poetsgate.com/ViewPoem.aspx?id=92330",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""],[6281,"أعائشُ ما لأهلكِ لا أراهمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26413&r=&rc=14",""],[572,"عَذِيريَ منْ صرفِ هذا الزّمنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9489&r=&rc=346",""]],"verses":[["كَانَا لَزِيمَيْنِ حَالَ البَيْنُ بَيْنَهُمَا","حَتَّى تَلاقَى اللَّزِيمَانِ الوَفِيَّانِ",0,"ن",1,0],["كانَ الزمان لنا حرباً نخادعه","فاليوم أُلقيَ فيما بيننا السلم",1,"م",1,0],["كأَن الزِّجَاجَ اللَّهذمياتِ فيهمُ","فَتِيلٌ بأطراف الرُّدْينِيِّ مُسْرجُ",2,"ج",1,0],["كَأَنَّ الزُهورَ تَرقرَقُ فيها","سَقيطَ النَدى أَعيُنُ باكِيات",3,"ت",1,0],["كانَ الزَفافُ إِلَيكَ غايَةَ حَظِّها","وَالحَظُّ إِن بَلَغَ النِهايَةَ موبِقُ",4,"ق",1,0],["كانَ الزَمانُ بِلُقياكُم يُمَنّينا","وَحادِثُ الدَهرِ بِالتَفريقِ يَثنينا",5,"ن",2,1],["كان الزّمانُ عدوّهم فثنيْتَهُ","وهو الصّديقُ لهم بلا عُدوانِ",6,"ن",1,0],["كَأَنَّ الزّمانَ الرحبَ من ذكره فَمٌ","ونحنُ لسانٌ فيه ينطقُ بالشكرِ",7,"ر",1,0],["كانَ الزَمانُ بِكُم كَلباً فَغادَرَكُم","بِالسَيفِ وَالدَهرُ فيكُم أَشهُرُ الحُرُمِ",8,"م",1,0],["كَأَنَّ الزُجاجَ البيضَ مِنها عَرائِسٌ","عَلَيهِنَّ بَينَ الشَربِ أَردِيَةٌ حُمرُ",9,"ر",1,0],["كأنّ الزِّبْرِقانَ بها أسيرٌ","تُجُنِّبَ لا يُفَكُّ ولا يُفادى",10,"د",2,0],["كان الزمانُ يُظِلُّنا برَبِيعِه","فتركتني للقُرِّ من مَشْتَاتِهِ",11,"ت",2,0],["كأن الزهور ترقرق فيها","سقسط الندى أعين باكيات",12,"ت",1,0],["كانَ الزَمانُ لَهُم مُطيعاً خاضِعاً","وَأراهُ مُنتَصِباً لِفعل خلاف",13,"ف",1,0],["كانَ الزَمانُ بِهِ تَصفو مَشارِبُهُ","فَالآنَ أَصبَحَ بِالتَكديرِ مَقطوبا",14,"ب",2,0],["كأنَّ الزمانَ بقايا دُجىً","أنا فيهِ كالقمرِ الآفلِ",15,"ل",1,0],["كانَ الزمانُ لنا واللسنُ جامعةٌ","فقد غدونا لهُ والأمرُ ينقلبُ",16,"ب",1,0],["كانَ الزَّمانُ يَضِيقُ عَنْهُ جَلالَةً","فَإِذَا بِهِ في تُرْبَةٍ وسلامِ",17,"م",1,0],["كَانَ الزّمَانُ بَهيماً قَبله فبَدَا","عليهِ لِلحُسْنِ أوْضاحٌ وأَحْجالُ",18,"ل",1,0],["كانَ الزَّمانُ لَنَا سِلْماً إلى أمَدٍ","فَعَادَ حَرْباً لَنَا لمّا انْقَضَى الأمَدُ",19,"د",1,0],["كانَ الزَمانُ يَطيبُ لي","وَأَحِبَّتي فيهِ شُهودُ",20,"د",1,0],["كَأَنَّ الزَعفَرانَ بِمِعصَمَيها","وَبِاللَبّاتِ نَضحُ دَمٍ نَجيعِ",21,"ع",1,0],["كأن الزمان الغمر أصبح حاسداً","فاخلفنا عهداً وعامل بالنقض",22,"ض",1,0],["كان الزمانُ جَنَى فجاءَ لياسرٍ","ونصولُهُ ممَّا جَنَى تَتَنَصَّلُ",23,"ل",1,0],["كان الزمانُ لها بفضلِكَ واعداً","فوقى وأعطاكَ المرادَ الأوفَقا",24,"ق",2,0],["كان الزمانُ لأن أشافِهَ ضامنا","فأعاضَ منه بأخرسٍ متضمّنِ",25,"ن",1,0],["كان الزمانُ يُسرُّ لي ضِغْناً فقد","أصلحتَ لي قلبَ الزمان الفاسد",26,"د",1,0],["كأن الزمان حذا حذوهم","مفتياً بأحداثه أو مفيدا",27,"د",2,0],["كانَ الزمانُ بهمْ والعيشُ مبتهجٌ","حتى جَزَعنَ رمالَ المهمهِ القَذَفِ",28,"ف",1,0],["كان الزمان بهيم اللون فاتضحت","له بأيامك الأوضاح والغرر",29,"ر",1,0],["كان الزّمان بهيماً قبل أنْ مَنَحتْ","فضائلِي جِلدَه الأوضاحَ والقُرحا",30,"ح",2,0],["كان الزمان كما تشا","عزاً ورغداً وطرب",31,"ب",1,0],["كَأَنَّ الزَّمَانَ فَتًى عَاشِقٌ","رَآنِي أُعَارِضُهُ فِي سَكَنْ",32,"ن",1,0],["كانَ الزَّمانُ بِه نَسيماً سَجسَجاً","أرِجاً فَأصبَحَ مِنهُ صِرّاً حَرجَفا",33,"ف",2,0],["كأنّ الزّيتَ والعسلَ المصفّى","عبيرٌ خالصٌ في دُهنِ بانِ",34,"ن",1,0],["كان الزمان يهنيني بمقدمه","وكنت اطرب في مرآه بالحلم",35,"م",1,0],["كأن الزائرين إِذا أتوه","مفاجأة أتوه على اتعاد",36,"د",1,1],["كأن الزجاج عليها أُذيبَ","وماءَ اللجين بها قد سبك",37,"ك",1,0],["كأن الزواهر ألقت سناها","على الحلي من حسنها والحلل",38,"ل",1,0],["كان الزمان على بنيه جائراً","حتى استذل بعدله وبرشده",39,"د",2,0],["كَانَ الزَّمَانُ لَهُ عرساً بِدَولَتِه","فَأحْسَنَ اللَّهُ للِدَّهْرِ العَزَا فِيهِ",40,"ي",2,0],["كان الزمان لحسنه بوجوههم","يختال بالاوضاح والتحجيل",41,"ل",1,0],["كَأَنَّ الزَبد الجَعدي","عَلى أَشداقِها بَرسُ",42,"س",1,0],["كان الزمان بفضله","يبدى الفخار ولم يزل",43,"ل",1,0],["كانَ الزَمانُ بَهِيماً وَاِتَّفَقتَ لَهُ","فَغَيَّرَت لَونَهُ أَيّامُكَ الغُرَرُ",44,"ر",1,0],["كان الزمان بقرب جعفر حالي","في بهجة أمسي وطيب وصال",45,"ل",1,1],["كانَ الزَمان بِكَفه","خَصب المَرابع أَخضَرا",46,"ر",2,0],["كأن الزئبق الرجراج فيه","يدور فلا يقر له قرار",47,"ر",1,0],["كأنَّ الزمان فسا على الأحرار","فالآن لطَّخَهم بِسَلح جارِ",48,"ر",1,1],["كأنّ الزُهْرَ في أفُقِ الدّياجي","أزاهِرُ لُحْنَ في خُضْرِ البِطاحِ",49,"ح",1,1],["كأنَ الزهرَ غبُّ سما بَكَتْهُ","لما أبدي حمامُ الشاطئَينِ",50,"ن",1,0],["كأن الزمانَ الغضَّ أخلقَ حسنَه","مشيبٌ وتدهى بالمشيب حلومُ",51,"م",1,1],["كان الزمان نصيحاً في تقلُّبه","وعن بعيد المدى كم جاءنا بِنبا",52,"ب",2,1],["كأن الزمان على رأسه","منادٍ ينادي الغريب الغريب",53,"ب",1,0],["كان الزمان وكانت الدار التي","كنا لنسخة أنسها نستنسخ",54,"خ",1,0],["كأن الزمان أتى تائباً","إلي وأنت اعتذار الزمان",55,"ن",1,0],["كان الزمانُ شتاءً بارداً وأنا","خلفَ المتاهاتِ وحدي اشتهي سكنا",56,"ن",2,1],["كان الزمان مُصحّرًا , لمّا أتى","زُرعتْ ببيداء الزمان نخيلُ",57,"ل",1,0],["كان الزمان الحزن داخل حناياه","ترى الفرح موجود دايم ربيعه",58,"ع",2,0],["كان الزمان فتياً مشرقاً نضراً","فاليوم أخلقه من بعدك الهرمُ",59,"م",1,0],["كانَ الزَّمانُ بنا يزهوْ برفقتِكُمْ","والنَّفسُ تسجدُ للرَّحمن ِعِرْفانَا",60,"ن",2,0],["كأنّ الزمان زمان المواشي","هواها هواها تلوك الفطيرا",61,"ر",2,0],["كأنّ الزّهورَ أبتْها العطورُ","فبات الرّحيق يَعاف الزهورا",61,"ر",2,0],["كأنَّ الزعفرانَ يمعصميها","وباللَّباتِ نضحٌ دمٍ نَجيعِ",62,"ع",1,0],["كأَنَّ الزّمانَ فتى ً عاشقٌ","وأَنِّي أُعارِضُهُ في سَكَنْ",63,"ن",1,0]]}