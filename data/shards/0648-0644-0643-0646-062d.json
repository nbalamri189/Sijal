فر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/46003","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45143","الوافر"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105508","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83660","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83592","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120501","الوافر"],[4699,"لمست القمر","https://www.poetsgate.com/ViewPoem.aspx?id=153903",""],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[4823,"شكوى مكلوم","https://www.poetsgate.com/ViewPoem.aspx?id=188850",""],[4829,"همسة شمالية","https://www.poetsgate.com/ViewPoem.aspx?id=34265",""],[4935,"تمثل لي خيالك في المنام","https://www.poetsgate.com/ViewPoem.aspx?id=129386",""],[5046,"ك مثل الشموس","https://www.poetsgate.com/ViewPoem.aspx?id=197917",""],[5122,"يابعد عمري تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=18066",""],[5246,"ترددت قبل العزم نحوك يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=187026",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"الريم ..لوحة ذاتية","https://www.poetsgate.com/ViewPoem.aspx?id=206889",""],[5516,"لا غفت عين","https://www.poetsgate.com/ViewPoem.aspx?id=213424",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5628,"الغريبان","https://www.poetsgate.com/ViewPoem.aspx?id=179897",""],[5718,"قدس أقصانا","https://www.poetsgate.com/ViewPoem.aspx?id=213783",""],[5848,"الطفل الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=53455",""],[5906,"آدمية جائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188520",""],[5932,"صرخة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=37129",""],[5939,"شعورُ الحبِّ لا يكفي!","https://www.poetsgate.com/ViewPoem.aspx?id=178603",""],[5956,"النساء لا يَرَيْنني","https://www.poetsgate.com/ViewPoem.aspx?id=185465",""],[5956,"حنينٌ لقرية \"بيت أجنادٍ\" ثم انطفاءُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=207910",""],[5977,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=213250",""],[5355,"حظي عنيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87130&r=&rc=25",""]],"verses":[["وَلَكِن حَماكَ العِلمُ وَالرَأيُ وَالحِجا","وَمالٌ إِذا جَدَّ النِزالُ وَفيرُ",0,"ر",1,0],["ولكنّ حلم اللّه أبقى عليهم","فعاشوا ولو في ِذلّة وشقاء",1,"ا",2,0],["ولكن حبها وشهادتاها","من النيرانِ نعمَ الأكفياء",2,"ا",2,0],["ولكنَّ حظاً ناله وحُرمتُهُ","أرى خشلَه معوىً ومعوي مِنَ الخشلِ",3,"ل",1,0],["وَلَكِنَّ حَدَّ المَشرَفِيَّةِ ساقَهُم","إِلى أَن حَشَرنا فَلَّهُم أَسوَأَ الحَشرِ",4,"ر",1,0],["ولكن حرا ليس يرضيه حاله","يموت ولا يبقى مقيما على الحال",5,"ل",1,0],["وَلَكِنَّ حُبّاً خامَرَ القَلبَ في الصِبا","يَزيدُ عَلى مَرِّ الزَمانِ وَيَشتَدُّ",6,"د",1,0],["وَلَكِن حَمى الشِعرَ إِلّا القَليلَ","هَمٌّ حَمى النَومَ إِلّا غِرارا",7,"ر",2,0],["وَلَكِنَّ حيرِيّاً أَصابَ نَقيعَةً","فَزَعزَعَها في سابِرِيٍّ وَفي بُردِ",8,"د",1,0],["وَلَكِن حَسبُ إِمكاني وَأَرجو","لَدَيكَ قُبولَها وَقِيامَ عُذري",9,"ر",2,0],["وَلَكِن حالِيَ في التَباعُدِ بَيِّنٌ","لَدَيكَ وَعُذرِيَ في التَأَخُّرِ واضِحُ",10,"ح",1,0],["ولكنْ حدودُ العِتْقِ تجري بسابقٍ","فلا طَلَقٌ إلّا أعَدّ له حدّا",11,"د",2,0],["وَلَكِنْ حُسْنُهُ يَبْدُو","إِلَى عَيْنِي فَتَرْسُمُهُ",12,"م",2,0],["وَلَكِنْ حَدَانِي جُودُهُ فَاسْتَثَارَنِي","لِوَصْفِ مَعَالِيهِ الْعِظَامِ الْجَسَائِمِ",13,"م",1,0],["وَلَكِنَّ حُمّى أَضرَعَتني ثَلاثَةً","مُجَرَّمَةً ثُمَّ اِستَمَرَّت بِنا غِبّا",14,"ب",2,0],["وَلَكِن حَديثٌ جاءَنا عَن نَبِيِّنا","فَذاكَ الَّذي أَجرى دُموعي عَلى النَحرِ",15,"ر",1,0],["وَلَكِن حورُ غِزلانٍ","تُراعي بِالمَلا بَقَرا",16,"ر",2,0],["وَلَكِن حُبُّكَ الداخِ","لُ في الأَحشاءِ قَد دَبّا",17,"ب",2,0],["ولكن حشو الحياة مُنىً","تحببها ليَ عاما فَعاما",18,"م",2,0],["ولكنْ حَذارِ ففي طبعٌ","لِيانٌ يسمُّونَهُ بالوداعهْ",19,"ه",1,0],["ولَكِنَّ حَبيبي جَلَّ","عِندي فَتغَافَلتُ",20,"ت",1,0],["ولكن حيث لا طمع لرد","فحسن الصبر مرتبع الحزين",21,"ن",1,0],["ولكن حر القول ينحو مقره","كما أن للتيجان تنحو اليتائم",22,"م",1,0],["ولكنَّ حظاً ناله وحُرمتُهُ","أرى خشلَه معرى ً ومعوى من الخشل",23,"ل",1,0],["ولكن حلْمُ ذي خُلقٍ عظيمٍ","له نحو العُلا والمجْد صمْدُ",24,"د",1,0],["ولكن حيث لا طمع لرد","فحسن الصبر مرتع الحزين",25,"ن",1,0],["ولكنّ حمى أضرعتني ثلاثة ً","مُجَرَّمَة ً، ثُمَّ کسْتَمَرَّتْ بِنَا غِبّا",26,"ب",2,0],["وَلَكنَّ حُسن الظَنّ يُسكِن رَوعَتي","وَيُخبِرني إِنَّ الكَريم غَفورُ",27,"ر",1,0],["ولكن حسبنا في البرِّ جِدُّ","وليس على مجدّ من جناح",28,"ح",1,0],["ولكن حكمةٌ للهِ فيها","عناياتٌ سرُّ ليس يبدو",29,"د",2,0],["وَلَكِنَّ حُسنَ العَفوِ مِنهُم سَجِيَّةٌ","إِذا ما عَفا وَالٍ وَعاقَبَ والِ",30,"ل",1,0],["ولكن حظي شقيٌّ تشظّى","بجرْدِ الفيافي أطالَ اغترابَهْ",31,"ب",2,0],["ولكن حَسِبتُ الصُّرمَ شَيئاً أُطِيقُهُ","إِذَا رُمتُ أَو حاوَلتُ أَمَّ عَزِيمُ",32,"م",1,0],["ولكن حداه على ما أتاه","فساد الطباع ولؤم الظفر",33,"ر",1,0],["وَلكنَّ حفظَ الدينِ شَرطٌ محتّمٌ","فَلا خيرَ في الدُنيا إذا ضاعتِ الأخرى",34,"ر",2,0],["ولكن حواءَ الجميلة أسرعت","خواطرها كالبارق المتلاحقِ",35,"ق",1,0],["وَلَكِن حالَ دونَهُمُ وَكانوا","بِهِ مِن خَوفِنا مُتَعَوِّذينا",36,"ن",2,0],["ولكِن حَلَّ في بُردَيهِ وَحيٌ","كَفاكَ تَفاخُراً وَكَفاهُ فَخرا",37,"ر",2,0],["وَلكنْ حبيبٌ راحَ فِيَّ مُصَدِّقاً","كلامَ عَدُوٍّ ما يزالُ مُكَذّبا",38,"ب",2,0],["وَلكنْ حميد القومِ مَنْ كان نفسه","عَلَى كلِّ حالٍ تنبذُ الذلَّ والضيما",39,"م",2,0],["ولكن حقوق للعلا قد ترتبت","على ذمتي مفروضةٌ وديون",40,"ن",1,0],["وَلَكِن حَيَّ أُسوَةٌ","فيهِ بِمَوتِ مُحَمَّدِ",41,"د",1,0],["ولكنْ حياتي بَعدَك اليومَ هكذا","حياةٌ لعمْري لا أُقيمُ لها وَزْنا",42,"ن",2,0],["ولكنْ حُقوقٌ ما أُقيمَتْ فُروضُها","ففاتَت وقاضي الفائتاتِ مُثاب",43,"ب",1,0],["ولكن حظ العين رؤية من هوت","وإن منعت جارت بمنع منام",44,"م",1,0],["ولكن حساناً رثى سيد الورى","عليه صلاة اللّه ما تلي الذكر",45,"ر",1,0],["وَلَكِن حِذاراً مِن وُشاةٍ عيونهم","عَلَينا وَإِن أَبدَت هُجوداً رَواصِدُ",46,"د",1,0],["ولكن حديثي فاض شهداً ولذةً","فادرك ما قد كان ذاك المفندُ",47,"د",1,0],["ولكن حبا قادني لك بالصبا","وحيث مني الشعر بالشيب أشمط",48,"ط",1,0],["ولكن حوى الغار النبي وصهره","وما كان إلا العنكبوت لهم حرب",49,"ب",1,0],["ولكن حل ما لم ي","ك في حسبان محتلم",50,"م",1,0],["ولكن حق الحب في الشرع ضائع","وما كل حق ضائع سيعود",51,"د",1,0],["ولكن حياة الحبِّ فيه وطولُه","ولليأس حالٌ لا ينادي وليدُها",52,"د",3,0],["ولكنْ حديثٌ من علي بن أحمد","تُحلَّى بذكراهُ المَقاولُ والكتبُ",53,"ب",1,0],["ولكنْ حَليمٌ والحَفيظَةُ مُرَّةٌ","غَمامُ نَداهُ ساكِبٌ غيرُ مُنْجم",54,"م",1,0],["ولكنَّ حُسن العهد شيمةُ نفْسِهِ","وآبائهِ في كُلِّ دانٍ ونازحِ",55,"ح",1,0],["ولكن حياءٌ لم يزلْ ملءَ طَرْفِه","من الناس في آمالهِمْ والمَطالِبِ",56,"ب",1,0],["ولكن حمتهُ خطوبٌ سدكن","يا ليت أمّي لها لم تلدني",57,"ن",2,0],["ولكن حسادي لفرط عنادهم","يظنون ذاك الفعل نوعاً من الزنا",58,"ا",1,0],["ولكنّ حظّي كالشّياطين يفعلُ","إذ احتجّ حينها بآتٍ يُنعِّمُ",59,"م",1,0],["ولكنّ حظّي شاخَ والشّيخُ قلّما","بغير الذي شابَ عليهِ يُسلِّمُ",59,"م",1,0],["ولكن حِمى المَولى عزيزٌ مُقدَّسٌ","ومَن ذا الذي يَقوى ليَنظُرَهُ شَزرا",60,"ر",2,0],["وَلَكن حُبي في علاك هُوَ الَّذي","بِهِ فَتحت لي في ثَناك المَطالب",61,"ب",1,0],["ولكن حاز أخلاقَ ال","كرامِ فباء بالفخر",62,"ر",1,0],["ولكنَّ حلماً واسعاً وتكرُّما","وعقلا ونفساً تكره الغدْر والختلا",63,"ل",2,0],["ولكن حاجات الفتى قذف به","إذا لم يجد من أن يطالبها بدا",64,"د",2,0],["ولكن حمتهم عن رماحك والظبي","وإن يهلكوا أرجاء مهلكة قعر",65,"ر",1,0],["ولكن حلتُّها فأنسته أوطان صباه","والأهل يوماً غريب",66,"ب",1,0],["ولكن حيثما حسنت ظناً","فطب نفساً بمنقبة الإجازة",67,"ز",2,0],["وَلَكِنَّ حِفظَ العَهدِ مِنهُ سَجِيَّةٌ","إِلَيهِ بِها دونَ المُلوكِ يُشارُ",68,"ر",1,0],["ولكنَّ حُبّاً أنتمُ بَدءُ غرسه","رَطيبٌ على مَحْل الزّمان وَرِيقُ",69,"ق",1,0],["ولكن حشاشات على الشوقِ لم تزلْ","تذوبُ إلى أن جاءها ما يسيلها",70,"ل",3,0],["ولكنْ حداها الحُزْنُ فاستوسقتْ به","وأكبرُ ما يُعِطي البخيلُ على قسر",71,"ر",1,0],["ولكن حيلةٌ جرت بلاء","على الدنيا وأياماً وخاما",72,"م",2,0],["وَلكِن حالَ دونَكَ كُلُّ طِرفٍ","أَبانَ الخَيرَ وَهوَ إِذٍ وَليدُ",73,"د",1,0],["وَلكِن حَمى هذا وَذاكَ بِهِمَّةٍ","يُهَدُّ بِها مِن شامِخِ الطَودِ فارِعُه",74,"ع",2,0],["وَلَكِن حَلَّ حِلمُكَ واجتَباهُ","عَلى الهَفَواتِ عَفوٌ مِن قَديرِ",75,"ر",1,0],["وَلَكِن حُلتَ عَن عَهدي وَوَلَّت","لِحَظّي مِنكَ أَيّامٌ قِصارُ",76,"ر",1,0],["ولكنَّ حصولي اتفاقاً فإنني","عزيزٌ عن الإدراكِ غيباً ومحضراً",77,"ر",2,0],["ولكن حكم الله جار وأنه","لأصبر من في الله يستعذب الصبرا",78,"ر",2,0],["وَلَكِنَّ حَظّي مِن سَحابِكَ شِيمَةٌ","تُكَثِّرُ حُسّادي وَتَرفَعُ مِن قَدري",79,"ر",2,0],["وَلَكِنَّ حُبَّكَ نادَى بِهِ","وَلَم يَزَلِ المَرءُ طَوعَ الهَوى",80,"ا",1,0],["ولكنّ حظيّ حطَّني غير أننيّ","اُديم البكا فيهم واُنشي المراثيا",81,"ي",2,0],["ولكن حين تقرنها جميعاً","يبين لك الصحيح من المعيب",82,"ب",1,0],["ولكن حالهُ أخفته عناذذ","كذاكَ الشمسُ تسترُ للظلالِ",83,"ل",1,0],["وَلَكن حَوى راءً وَجيما حُروفُهُ","فَرَجَّيتُ أَن يَسخُو وَيَذهَبَ ضِدُّهُ",84,"د",2,0],["ولكن حين يدنو النوم منا","يشرده البعوض بلا حياء",85,"ا",2,0],["ولكن حبي له لم يدع","فؤادي يأبه بالمنظر",86,"ر",1,0],["ولكن حسناً بر عنك نضيره","وأبدلت منه القبح وهو سطور",87,"ر",1,0],["وَلَكن حرقة في الصَدر تَجري","عصارتها مِن القَلب السَقيم",88,"م",1,0],["وَلَكن حُقوق أَوجبتها بذمتي","أَياد لَكُم لَم أَنسها أَبَداً عِندي",89,"د",2,0],["ولكن حظى بدّل النور ظلمة","وبدّل ما أشدو نعيب غراب",90,"ب",1,0],["ولكنَّ حزمي ما علمتُ ولُوثةُ ال","بداوَةِ تأبى أن ألين وتمنع",91,"ع",1,0],["وَلَكِن حماها مِن شَماطيط غارَةٍ","حَلالَ العَوالي فارِسٌ غَيرُ سائِلِ",92,"ل",1,0],["ولكن حمّلوه على كحيل","تفوق أباه في سوق البهام",93,"م",1,0],["ولكن حظي كان عنك يصدني","ولو لم يعقني الحظ ما كنت أسلوك",94,"ك",1,0],["ولكنّ حسْبي منْكَ أدْنى إشارةٍ","إليّ بلحْظِ اللحْظِ ترْفَعُ لي ذِكْرا",95,"ر",2,0],["ولكنّ حاديهَا شاقها","بذكرى معاهد أمّ القرى",96,"ر",2,0],["وَلَكن حَيث ما يَخلو بَليلٍ","يُرقِّصُ فَوقَ لحيته غَلامه",97,"م",2,0],["وَلَكِن حُسنُ ظَنّي في حَبيبي","جَميلٌ مُنتَجُ نَيلِ التَمَنّي",98,"ن",2,0],["ولكن حل