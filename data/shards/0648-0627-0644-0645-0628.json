{"poems":[[23,"الله أكرمنا بنصر نبيه","https://www.aldiwan.net/poem21430.html","الكامل"],[63,"سعد حبيت به وجد مقبل","https://www.aldiwan.net/poem51472.html","الكامل"],[63,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[60,"الله أكرمنا بنصر نبيه","https://www.aldiwan.net/poem30867.html","الكامل"],[51,"الدهر ذو دول والموت ذو علل","https://www.aldiwan.net/poem63190.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[105,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[23,"الله أكرمنا","https://www.poetsgate.com/ViewPoem.aspx?id=11418",""],[60,"اللُه أَكْرَمَنا بِنَصْرِ نَبِّيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=22821",""],[266,"أكذا النفوس إذا عشقن الأنفسا","https://www.aldiwan.net/poem38255.html","الكامل"],[266,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[382,"لو كان للأفلاك نطق أو فم","https://www.aldiwan.net/poem59270.html","الكامل"],[408,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[466,"كفي مقالك عن لومي وتفنيدي","https://www.aldiwan.net/poem15135.html","البسيط"],[469,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[556,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[563,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[567,"خير الرثاء الذي بالقلب قد لطفا","https://www.aldiwan.net/poem52788.html","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62467","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120065","الرمل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74012","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1448,"","https://poetry.dctabudhabi.ae/diwan/poem/144541","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46485","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27555","الكامل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105407","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118776","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117966","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131060",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69908","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54410","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4702,"المبسم الحالي","https://www.poetsgate.com/ViewPoem.aspx?id=156813",""],[4929,"مليكة اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=201110",""],[5150,"المسرح الحر","https://www.poetsgate.com/ViewPoem.aspx?id=202875",""],[5183,"النفس البريئة","https://www.poetsgate.com/ViewPoem.aspx?id=180251",""],[5950,"ماغرّد القمري ولا ناحت الورق","https://www.poetsgate.com/ViewPoem.aspx?id=139975",""],[6038,"غزوة رمش","https://www.poetsgate.com/ViewPoem.aspx?id=27051",""],[6056,"الحظ الأقشر","https://www.poetsgate.com/ViewPoem.aspx?id=156697",""],[6068,"لا تأس يا قلب المحب إذا مضى -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175875",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[6203,"نصائح عاشق عتيق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88023&r=&rc=1",""]],"verses":[["وَالمُبرِمونَ قُوى الأُمورِ بِعِزِّهِم","وَالناقِضونَ مَرائِرَ الأَقوامِ",0,"م",1,0],["والمُبتَني الشرفَ الذي لا يَنثني","الحاملُ العِبءَ الذي لا يُحمَلُ",1,"ل",1,0],["والمبتني بيتَ العَلاءِ ببأسِه","فغدا علاءُ النجمِ دونَ علائِه",2,"ا",3,0],["وَالمُبرِمونَ قُوى الأُمورِ بِعِزَّةٍ","وَالناقِضونَ مَرائِرَ الإِبرامِ",3,"م",1,0],["وَالمُبتَلى فَهُوَ المَهجورُ جانِبُهُ","وَالناسُ حَيثُ يَكونُ المالُ وَالجاهُ",4,"ا",2,0],["وَالمَبَانِي تَعِزُّ بَيْنَ المَبَانِي","بِمَتِينِ الأسْبَابِ وَالأوْتَادِ",5,"د",1,0],["وَالمَبَانِي بِهَا الحُلِيُّ ال","بَدِيعَاتُ وَالْقُبَبْ",6,"ب",1,0],["والمبتغين رضا الإله وما ابتغوا","من حاكمٍ عرض الحياة محقرا",7,"ر",2,0],["والمبرمونَ قوى الأمورِ بعزمهمْ","والناقضونَ مرائرَ الأقوامِ",8,"م",1,0],["والمُبْرِمُونَ قِوَى الأُمُورِ بِعزَّة","ٍ والناقصون مرائرالإ برام",9,"م",1,0],["وألم بي إلمام من صحب السرى","مترقبا وسري الدجى متهجسا",10,"س",2,0],["والمبتدا في الأصل كان مقدما","ولربما خصته بالتأخير",11,"ر",1,0],["والمبدعون تمزَّقت آراؤهم","وبدا الردى بهلاكهم يترنّم",12,"م",1,0],["والمبتْنَي دونَ أملاك الورى شرفاً","بناءَ عزّ على هامِ السّماك بُني",13,"ن",2,0],["والمُبْتَني شَرفاً ترسو دعائمُهُ","بمحمد السَّعي لا صُمِّ القَراميدِ",14,"د",1,0],["وألم بها فبها من أهلها لممٌ","وأنت خوذةُ أهلِ السهل والجبل",15,"ل",1,0],["والمِبعج السيف واللسان له","رأس طويل كهامة الأسل",16,"ل",1,0],["والمبصرين مكانَ حزّ شفارهمْ","في الرَّوْع إذ أعشى العيونَ القَسْطَلُ",17,"ل",1,0],["والمباح القلب يقلبه","طاعة بالقصد للإكمال",18,"ل",1,0],["والمُبكياتُ تَضُرُّ الحيَّ مُزعجةً","لهُ ولا تنفعُ الميْتَ الذي انصَرَفا",19,"ف",2,0],["والمبتلي بالهوى لم","يزَل بعيشة ضنكِ",20,"ك",1,0],["والمبيد الذمر في هبوتها","باللعان المر من مرّانِها",21,"ن",3,0],["وألم بالدوح النسي","م أريجةٌ أردانه",22,"ن",2,0],["والمبتدأ اسم وبمعنى يرفع","والخبر الجزء المفيد يتبع",23,"ع",1,0],["والمَبسِمْ العذبُ الرُّضا","ب وحسنُ لؤلئه المُنَضَّد",24,"د",1,0],["وَالمُبتَغي مِنهُ الوَفاء كَطالِبٍ","ماءاً قراحاً في سَراب قَفار",25,"ر",1,0],["والمبتغى المعتوبُ في أعراضه","عن نفسِه وقبوله لمن ابتغى",26,"غ",2,0],["وألم بي بالسفح من وادي الغضا","لو كان يجدي في الجوى الألمام",27,"م",1,0],["وَأَلَمّ بِالقَلب الصَحي","حِ فشقّ منه وَبضّعا",28,"ع",2,0],["والمبتدا الثالث ثم الخبرُ","رابعها كالعلم نور مزهر",29,"ر",1,0],["والمبتغي بالكيمياء الغنى","بشره بالإفلاس في العاجل",30,"ل",1,0],["والمبتنون بما بنوا سفلوا","والهادمون علوا بما هدموا",31,"م",3,0],["وَأَلمَّ بِالهنديِّ يا وَيَلمِّهِ","فتكٌ ذَريعٌ مِن كَميٍّ قادرِ",32,"ر",1,0],["والمبطلونَ متى طالتْ رقابُهمُ","أَبدى من الهُون في أَعناقها الوقصا",33,"ص",2,0],["والمبتدا أخبروا عنه بما هو هو","وما تضمنه أو ما قد التزما",34,"م",2,0],["والمبسم الحالي يحلوي حكاويها","اليا حكت غطّت على الجوّ ملسونه",35,"ن",2,0],["والمُبتدى والمُرتقى والمُنتهى","وإليكِ يُسندُ أخذُ كلِّ زِمامِ",36,"م",1,0],["والمبدعُ الحرُّ خوفُ النقدِ قيَّدَهُ","فحرَّرَ الفكرَ إبداعاً مع الحِشمهْ",37,"م",2,0],["والمبتلى إما جبان عاجز","أو ضيغم عضب الجنان جريء",38,"ي",2,0],["والمبعد اللي بينه وبينهم فرق","لليوم يحطب في ضلوعي غيابه",39,"ه",1,0],["والمبسم اللي في نجاح المساعيد","الغضي اللي على كتفه وشاحه",40,"ح",2,0],["والمبيسم موت ٍأحمر* يشفي العطشان غله ّ","ونظمة اللولو سنونه * لاغنج لي بأبتسامة",41,"م",2,0],["والمبتغى الحسن الأغن وطلعة","كطلوع بدر القلب وهو عميد",42,"د",1,0],["وَالمَبدأُ السّامي بِنَفسيَ حاكِمٌ","يَستَأهِلُ التَّكريمَ وَالتَّبجيلا",43,"ل",2,0],["والمبدعونَ مروّجو أفيونِهِ","ويجرّبون مزاجَهُ المحظورا",44,"ر",2,0]]}