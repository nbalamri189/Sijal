{"poems":[[55,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[88,"يرغي ويزبد بالقافات تحسبها","https://www.aldiwan.net/poem68854.html","البسيط"],[73,"ريح الشمال عساك أن تتحملي","https://www.aldiwan.net/poem4013.html","الكامل"],[73,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[10,"أعيني فيضي ولا تبخلي","https://www.aldiwan.net/poem21127.html","السريع"],[32,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[4,"ما إن تعري المنون من أحد","https://www.aldiwan.net/poem21157.html","المنسرح"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[53,"وسيد قد عمرتني أنعمه","https://www.aldiwan.net/poem66090.html","الرجز"],[89,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/117011","الوافر"],[108,"القُبلة","https://www.poetsgate.com/ViewPoem.aspx?id=179478",""],[132,"لك منزل في القلب لا يتغير","https://www.aldiwan.net/poem50594.html","الكامل"],[147,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[154,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[190,"أقول لمنكر فقري قنوعا","https://www.aldiwan.net/poem43650.html","الوافر"],[216,"سعيد بن سلطان بنى العز والعلا","https://www.aldiwan.net/poem37860.html","الطويل"],[228,"لقد مر بي أمس بالصدفة","https://www.aldiwan.net/poem41637.html","المتقارب"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[240,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[275,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[280,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[369,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[408,"عيد ثغور الأماني فيه تبتسم","https://www.aldiwan.net/poem46932.html","البسيط"],[412,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[412,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[422,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[466,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[466,"رفقا بها يا أيها الزاجر","https://www.aldiwan.net/poem16434.html","السريع"],[469,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[567,"نفذ القضا من أوج ذلك المنبر","https://www.aldiwan.net/poem52778.html","الكامل"],[567,"قد طلع البدر من المغرب","https://www.aldiwan.net/poem52981.html","السريع"],[580,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[580,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[580,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[580,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[580,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138225",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83292","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38260","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70763","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119890","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122006","الكامل"],[1504,"","https://poetry.dctabudhabi.ae/diwan/poem/143716","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35743","الكامل"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72145","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69406","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53225","البسيط"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101795","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105014","الكامل"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21205","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100348","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62771","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62828","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126986","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129376","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117937","السريع"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44644","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72448","الطويل"],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[5183,"الجلاء عن قاعدة بنزرت","https://www.poetsgate.com/ViewPoem.aspx?id=185647",""],[5185,"الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=71576",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5302,"وعلى هواه بما يرى ذهبا","https://www.poetsgate.com/ViewPoem.aspx?id=201380",""],[5431,"قلبي...","https://www.poetsgate.com/ViewPoem.aspx?id=211835",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5758,"تَرَاتِيلُ الشَّمْس","https://www.poetsgate.com/ViewPoem.aspx?id=200496",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5956,"برأيي ما الحياة تحِقُ حلمي","https://www.poetsgate.com/ViewPoem.aspx?id=199892",""],[5956,"أهديتني يا خالق الدنيا بُنيَّ علاءا","https://www.poetsgate.com/ViewPoem.aspx?id=206926",""],[6144,"الواسطه لسه شغاله","https://www.poetsgate.com/ViewPoem.aspx?id=22536",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""]],"verses":[["يَعِفُّ عَنِ الفَحشاءِ ذَيلي كَأَنَّما","عَلَيهِ نِطاقٌ دونَها وَحِجابُ",0,"ب",1,0],["يُعفى مِنَ المَهرِ إِكراماً لِلِحيَتِهِ","وَما أَظَلَّتهُ مِن دُنيا وَمِن دينِ",1,"ن",1,0],["يَعفو عَنِ الذَنبِ العَظيمِ تَكُرُّماً","وَيَجودُ مَسؤولاً وَإِن لَم يُسأَلِ",2,"ل",1,0],["يَعفو عَنِ الذَنبِ العَظيمِ تَكُرُّماً","وَيَصُدُّ عَن قَولِ الخَنا مُتَكَبِّرا",3,"ر",2,0],["يَعِفُّ وَيَحمي إِذا ما اِعتَزى","إِلى الشَرَفِ الباذِخِ الأَطوَلِ",4,"ل",1,0],["يَعِفُّ وَيَستَحيي وَيَعلَمُ أَنَّهُ","مُلاقي الَّذي فَوقَ السَماءِ فَسائِلُه",5,"ل",2,0],["يَعفو عَلى الجَهدِ وَالسُؤالِ كَما","أُنزِلَ صَوبُ الرَبيعِ ذي الرَصَدِ",6,"د",1,0],["يَعفو إذا الجاني ابتغى عَفْوه","لكنه فارسُ مُستفْرِس",7,"س",1,0],["يعفو كُلومِي دائباً فأكلمُهْ","أني لَأخنى قائلٍ وألامُهْ",8,"م",2,0],["يَعْفُو عَنِ الذَّنْبِ حَتَّى يَسْتَوِي كَرَماً","لَدَيْهِ ذُو الْعَمَلِ الْمَبْرورِ وَالْجَانِي",9,"ن",2,0],["يَعِفُّ عن المظالمِ والدَّنايا","ويرفُقُ بالضِّعافِ الوادعينا",10,"ن",2,0],["يَعِفُّ فَيَعْفُو عَنْ كَثِيرٍ مُؤَمِّلاً","لَهُ الْعَفْوُ مِنْ رَبٍ قَرِيب مَتَابٍ",11,"ب",1,0],["يعفّ عن المحارمِ والملاهي","ومرضاة الإله له وظيفَه",12,"ف",2,0],["يعفُّ عن التقبيل وهُوَ متيمُ","فهل هو إنس أم مَلاك مكرَّمُ؟",13,"م",1,0],["يَعفُو عن الذنبِ العظيم تكرماً","وتجاوزاً وهو الحليم الأقدرُ",14,"ر",1,0],["يَعِفُّ إِذ ما خَلا مِثلَما","تَعِفُّ وَيَعفو إِذا ما قَدَر",15,"ر",1,0],["يُعَفّي عَلى مَن عَفا أَو كَفى","وَيوفي عَلى مَن وَفى أَو عَدَل",16,"ل",1,0],["يُعَفِّرُ خَدّاً عِندَ قَبرِ مُحَمَّدِ","إِلى اللَهِ أَشكو لَوعَةَ الهائِمِ",17,"م",1,0],["يعفّ الليث عن صيد ابن آوى","ويغلب بعد ما غلب الشجاع",18,"ع",1,0],["يَعِفَّ عنهم إذا ذلوا ويأمنهم","لكنهم دُهِشوا وَلّوا ولا وَقَفُوا",19,"ف",3,0],["يعفِّرُكِ الناسُ تَحتَ النِعالِ","وَأَنتِ تجودينَ بِالنَفحَةِ",20,"ه",1,0],["يَعفو وَيَصفَحُ لا يُجازي مَن أَتى","بِإِساءَة ناءٍ مِنَ العُدوانِ",21,"ن",1,0],["يَعفو عَنِ الجاني فَيوسِعُ ذَنبَهُ","عَفواً وَيُعطي سائِليهِ فَيُجزِلُ",22,"ل",1,0],["يَعفو وَقَد مَلَكَ العِدى عَن قُدرَةٍ","وَالعَفوُ يَحسُنُ بِالمَليكِ القادِرِ",23,"ر",1,0],["يعفُّ المرءُ عَجزاً أو رياءً","ويَستُرُ بالمداجاةِ الفجورا",24,"ر",2,0],["يَعْفُو وَيَصْفَحُ في ذاتِ الإلهِ كَما","يَسْخُو ويَسْمَحُ والمِفضالُ مِفْصَالُ",25,"ل",1,0],["يعفونَ عَن كُلِّ ذنبٍ إذا قدروا","مُستتبعين نداهم عند عَفوِهمِ",26,"م",1,0],["يَعْفو عنِ المرء يَجْني وهْو مُعتَذرٌ","حتّى يقالَ تُرَى مَن منْهما الجاني",27,"ن",2,0],["يَعْفو عنِ الجاني وإن لم يَعتَذِرْ","ويَجودُ للعافي وإنْ لم يُسأَل",28,"ل",1,0],["يَعْفُوا فتَبْتَسِم الأَرجاء ضاحِكةً","وترجُفُ الأرضُ خوفاً حين ينْتَقِمُ",29,"م",1,0],["يَعفو فَيَفعل حلمه بِعَدوِّهِ","ما تَفعَل الأَسياف بِالأَجسامِ",30,"م",1,0],["يَعفُّونَ عَن أَسلاب مَن رام حربهم","وَيَقتَسِموا الأَرواح قَسماً مَلهوجا",31,"ج",2,0],["يعفو عن الجاني ويغفر ذنبه","والعفو أحسنُ ما أتى من قادر",32,"ر",1,0],["يعفو إذا قدرتْ يداهُ على العِدى","فكأنه من حلمه لم يقدرِ",33,"ر",1,0],["يُعَفِّرُ الصِّيدَ بيومِ الوَغى","وهو لجاني سَلْمِهِ غافِرُ",34,"ر",1,0],["يعف ولا خوفٌ عن الفحش والخنا","ويعفو ولا عجزٌ عن الذنب والجرم",35,"م",1,0],["يعفو عن الشَّيخِ المكبِّ على العَصا","عجزاً ويفتُكُ بالغُلامِ الأصغرِ",36,"ر",1,0],["يَعفوُ على قُدرتهِ مُغضِياً","من حلِمهِ عن نَظَر المغُضَبِ",37,"ب",1,0],["يعفو عن الباغي عليه فِحلْمُه","مُغْنى الحقودِ ومُهْلِكُ الأَضغان",38,"ن",1,0],["يَعفُّون عن كسبِ المغانِم في الوْغَى","فليس لهم إِلاَّ الفوارسُ مَغْنَمُ",39,"م",1,0],["يَعْفُو عَن الْجَاني على قُدرَةٍ","ما أَحْسَن الْعَفْوَ مِنَ القَادر",40,"ر",1,0],["يعفر الشجعان في يومِ الوَغَى","بمُهَنَّدٍ يَذَرُ الشُّجَاعَ مُقَدَّدَا",41,"د",2,0],["يَعِفُّونَ عن كَسْبِ المغانمِ في الوَغَى","فَلَيسَ لهم غيرُ الفوارسِ من كَسْب",42,"ب",1,0],["يعفو الكرام عن الجاني ولو عظمت","ذنوبه بلسان قلبهم جرحا",43,"ح",2,0],["يَعفو الجَرائِرَ نَحوَهُ طَرّاً وَلا","يَعفو إِذا الإِسلامُ غُضَّ فَتيلا",44,"ل",2,0],["يَعفو بِحُسنِ تَفَضُّلٍ","لا عَجزَ فيهِ عَنِ اِنتِقام",45,"م",1,0],["يَعِفُّ عن الفعل المذمَّمِ خاطري","كما يكره الفعلَ المقبَّح خاطره",46,"ر",2,0],["يعفو عن الجاني ويدني بالندى","أبدا قطوف سماحه للجاني",47,"ن",2,0],["يَعْفُونَ إِنْ قَدَرُوا وَيُولُونَ الرِّضَى","وَيَقِلُ عِنْدَهُمُ الْكَثِيرُ لِمُلْتَجِ",48,"ج",1,0],["يُعفّي ويُعفي سُخطه وابتسامُهُ","ويُحيى ويُردي وعدُه ووَعيده",49,"د",2,0],["يَعفو عَنِ الذَنبِ العَظي","مِ وَلَيسَ يُعجِزُهُ اِنتِصارُه",50,"ر",2,0],["يَعِفُّ وَيسْتَحْيِي إذا كان خَالِياً","كما عَفَّ واسْتَحْيَا بِحَيْثُ رَقِيبُ",51,"ب",1,0],["يَعِفُّ عَنِ الخَنا وَيَشفُّ حِلماً","كَما شَفَّت ذُرى عَلَمَي أَبانِ",52,"ن",1,0],["يعفو عن الجرم للجاني وقدرته","تكاد تنفذ فيما فوق كِيوانا",53,"ن",2,0],["يعفر منها رائح أريح أوجها","بها ينجلي ليل الدجى والعضائم",54,"م",1,0],["يعفو الإله عن الدفين برمله","وله ملائكة السما تستغفر",55,"ر",1,0],["يَعفو ويَصفَحُ لا يجزي بسيِّئة","ويَكظمُ الغيظَ عند الشَتمِ والغَضَبِ",56,"ب",1,1],["يعفرون وَجوهاً طالَما سَهَمت","حَتّى كَأنَّ أَديم الأَرض مَبلولُ",57,"ل",1,0],["يعفُّ له دون النطاق مفخمٌ","نبيلٌ وخصرٌ بالنحول تمنطقا",58,"ق",2,0],["يعِفُّ عن الماءِ الزلالِ تنزُّهاً","وفيه صَدى من غُلّةٍ ونُزوعُ",59,"ع",1,0],["يعفُّ عن الصيدِ اللّئيمِ مَرامُهُ","إذا عَدِمَ الأقرانَ أصبحَ طاوِيا",60,"ي",2,0],["يعفر في الصعيد له محيا","ويقطع منه بالهندي نحرا",61,"ر",2,0],["يعفو ويصفح عن جان جنى ولكم","أغنى وبعد الغنى يلقاه معتذرا",62,"ر",2,0],["يعفو عن الزاني إذا تاب وال","سارق والناكث والقاسط",63,"ط",1,0],["يَعفو عَلى العَبد الأَثيمْ","نَعمَ الجَليلْ",64,"ل",1,0],["يعفو عن الجاني المسيء تكرمّا","والعفو والاحسان دأبُ الحازم",65,"م",1,0],["يعفين آثار الخطى بذوائب","كما قد عفت من منزل الذل آثاري",66,"ر",2,0],["يعْفو عن الزّلّات للمستذنب","ويتفوا بعين العانت الملئومي",67,"م",2,0],["يعفي آثار الاستعما","ر السوء عليك ويطرده",68,"د",2,0],["يعفو ويقدر أن يكون عذابه","واليوم قد لا توصل الأرحام",69,"م",1,0],["يَعفُوُ ويَصفَحُ ، فَالرِّجَالُ مَوَاقِفٌ","مَا كَانَ يَعرِفُهَا سِوَى خُبَرَائِهَا",70,"ا",3,0],["يعفو الإله وبعض أفئدة ال","خلق اعتد