{"poems":[[93,"شاهدتها كالميت في أكفانه","https://www.aldiwan.net/poem62809.html","عموديه"],[46,"شعبي وشعب عبيد الله ملتئم","https://www.aldiwan.net/poem29705.html","البسيط"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112763","الخفيف"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135858","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83409","السريع"],[5612,"يا أرْضَ طَيْبَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=186739",""],[5906,"قصدتك يا كريم","https://www.poetsgate.com/ViewPoem.aspx?id=188230",""]],"verses":[["فَاِرزَح بِحُزنِك يا حَزينُ فَإِنَّها","لا تَنشُرُ الشَكوى وَلا تَطويها",0,"ي",3,0],["فَأَرزَمَت أَنفُسٌ قَد كُنَّ واحِدَةً","لِوالِدٍ واحِدٍ في أَنفِهِ شَمَمُ",1,"م",1,0],["فارْزُق عبادَك منكَ فضْلَ شفاعةٍ","واقرُبْ بهمْ زُلْفَى فأنتَ مَكين",2,"ن",1,0],["فارزقنه الرجوع واصلح جنانا","منه واجعل له سيدي ألف باب",3,"ب",1,0],["فَأَرزاقُ عَمّالِ الرَساتيقِ سُنَّةٌ","عَلَينا شُهورَ الحَولِ ما نَتَخَوَّفُ",4,"ف",1,0],["فارزق له الأرواحَ والأجساما","رزقاً يكون منعماً إنعاما",5,"م",2,0],["فاِرزُقنيَ الشكرَ الَّذي يقتَضي","زِيادَةَ الخير وَيَستَوجِبُ",6,"ب",1,0],["فارْزُقْ عُبَيْدَكَ عِنْدَ الحَوْضِ صُحْبَتَهُ","وهَبْ لقلْبيَ قُرْباً مِنْهُ يُحْييني",7,"ن",2,0],["فأرزاقُ العبادِ عَلى العِبادِ","وَبابُ الرِّزقِ عَندِكَ حََيثُ تَجريْْ",8,"ر",2,0]]}