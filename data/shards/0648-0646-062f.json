aldiwan.net/poem13758.html","الخفيف"],[456,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[456,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[459,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[462,"يا لقبي من نغمة الأوتار","https://www.aldiwan.net/poem3182.html","عموديه"],[462,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[462,"يا زمان الحمى عليك السلام","https://www.aldiwan.net/poem3413.html","عموديه"],[466,"أيا من ما له في الجود ثان","https://www.aldiwan.net/poem59611.html","الوافر"],[466,"نحن في روض نضير","https://www.aldiwan.net/poem60132.html","مجزوء الرمل"],[475,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[536,"مر عام وأنتض يا صاح صاح","https://www.aldiwan.net/poem48247.html","عموديه"],[549,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[556,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[556,"لك الحمد يا رب السموات والأرض","https://www.aldiwan.net/poem34419.html","الطويل"],[565,"ونديم مخالف","https://www.aldiwan.net/poem69628.html","مجزوء الخفيف"],[565,"وندمان أخي ثقة","https://www.aldiwan.net/poem69656.html","مجزوء الوافر"],[565,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[567,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[573,"وندامى فصحاء شربوا","https://www.aldiwan.net/poem2736.html","الرمل"],[573,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[573,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"]],"verses":[["وَنَدامى كَالنُجومِ سَطوا","بِالمُنى وَالدَهرُ جَذلانُ",0,"ن",1,0],["وَنَدمانِ صِدقٍ تَسلُبُ الراحُ عَقلَهُ","وَتَسلُبُها خَداهُ حُسنَ التَوَرُّدِ",1,"د",1,0],["وَنَدَى يُؤْثُر الضُّيُوفَ عَلَى الأَهْ","لِ إِذَا مَا نَوْءُ السَّمَوَاتِ ضَنّا",2,"ن",2,0],["وَنَدىً كَصَوْبِ الْغَيْثِ إِلاَّ أَنَّهُ","لاَ يَعْرِفُ الإِمْحَالَ وَالإِمْسَاكَا",3,"ك",2,0],["وَنَدامى بيضُ الوُجوهِ كَأَنَّ ال","شَربَ مِنهُم مَصاعِبٌ أَفناقُ",4,"ق",1,0],["وَنَداكَ مُحتَضَرٌ وَنو","رُكَ في دُجى الظَلماءِ واقِد",5,"د",1,0],["وَنَدِيماً حَدِيثُهُ طُرَفٌ لا","تَتَنَاهَى أَلْطَافُهَا وَشُجُونُ",6,"ن",1,0],["وَنَدخُلُ بالسُّرُورِ ديارَ قَومٍ","وَنُعقِبُ آخرينَ أَذىً وَوَيلا",7,"ل",2,0],["ونُدرك فيه ثأرنا بكتائب","لها نَسَب من صلب يعرب مشتق",8,"ق",1,0],["وَنَدعو كَريماً مَن يَجودُ بِمالِهِ","وَمَن يَبذِلُ النَفسَ الكَريمَةَ أَكرَمُ",9,"م",1,0],["وَنَدماني السَريعُ إِلى لِقائي","عَلى عَجَلٍ وَأَقداحي الكِبارُ",10,"ر",1,0],["وَنَدنو دُنُوّاً لا يُوَلَّدُ جُرأَةً","وَنَجفو جَفاءً لايُوَلِّدُهُ زُهدُ",11,"د",1,0],["وَنَدمانِ صِدقٍ تَمطُرُ الخَيرَ كَفُّهُ","إِذا راحَ فَيّاضَ العَشِيّاتِ خِضرِما",12,"م",2,0],["وندًى يخجلُ السحابَ فيمشي","من ورا جودِهِ على استحياء",13,"ا",2,0],["ونداؤه هذا جزاً","فأقول قد صدق المنادي",14,"ي",1,0],["وندباً أطارت طائر المدح واجباً","قوادِم من نعمائه وخواف",15,"ف",1,0],["وندى تتابع وفده حتى اشتكت","نفحات أنعمه الفلا والأينق",16,"ق",1,0],["ونديم يسعى بكأسيهِ مسعى","قمر التّم حوله الفرقدان",17,"ن",1,0],["وندًى شبَّ ذكره فنسينا","ما سمعناه عن فتى شيبان",17,"ن",1,0],["وندىً إذا فُقِدَ النَّدى","يتتبَّعُ العافي مُصابهْ",18,"ب",2,0],["وندرأ بؤسه بالصبر حتى","نفرجه بأذهان لطيفه",19,"ف",2,0],["وَنَديمٍ بِتُّ مِنهُ","ناعِمَ البالِ رَضِيّا",20,"ي",2,1],["وَنَدامى بِهِمُ العَي","شُ كَما قيلَ قَصيرُ",21,"ر",1,0],["وَنَديمٍ كَما نُحِبُّ ظَريفٍ","وَعَلى كُلِّ ما نُحِبُّ مُؤاتي",22,"ي",1,0],["وَنَدعوكَ الحُسامَ وَهَل حُسامٌ","يَعيشُ بِهِ مِنَ المَوتِ القَتيلُ",23,"ل",1,0],["وندىً لَوَ اَن السحبَ تَعْشُرُه","لم يتَّسِعْ لِقطَارها سُهبُ",24,"ب",1,0],["وَنُدمانُ صِدقٍ في جِوارِ خَليفَةٍ","غَدا بَينَ كَفَّيهِ النَدى وَالصَفائِحُ",25,"ح",1,0],["وَنَدى كَفِّهِ الَّتي نُسِبَ الجو","دُ إِلَيها تَعاقُبَ اِبنَي سَميرِ",26,"ر",1,0],["وَنَديمٌ حُلوُ الشَمائِلِ كَالدي","نارِ مَحضُ النِجارِ عَذبٌ مُصَفّى",27,"ف",2,1],["وَنَديمٍ نَبَّهتُهُ وَدُجى اللَي","لِ وَضَوءُ الصَباحِ يَعتَلِجانِ",28,"ن",1,0],["وَنَدمانٌ يَسُرُّكَ أَن تَراهُ","لَهُ مِن قَلبِ كُلِّ أَخٍ مَكانُ",29,"ن",1,0],["وندىً إذا استمطرتَ عارضَ مُزنِه","حنَّ الحَيا الرِّبعيُّ فيه وأَرزَما",30,"م",2,0],["ونَدىً رفَعْتَ به لِحَيَّيْ تَغلبٍ","شَرَفاً أنافَ فعانقَ العَيُّوقا",31,"ق",2,0],["ونَدمانِ صدقٍ نَثرُهُ ونِظامُه","ربيعٌ إذا فاوضتَه وخَريفُ",32,"ف",1,0],["ونَدمانٍ دَعَوْتُ إلى العُقارِ","وقد فضحَ الدُّجى ضَوْءَ النَّهارِ",33,"ر",1,1],["ونَداكَ لا تُنسى مَواعِدُه","كَرَماً فما أحتاجُ أذكُرُه",34,"ر",2,0],["وَنَديمي لَفظي وَفِكري أَنيسي","وَسُروري مائي وَصَبري زادي",35,"ي",1,0],["ونداماه على طول المدى","رفقة حفّوا به كالحبب",36,"ب",1,0],["وندى فاضَ من بنانِ كريمٍ","غيرِ مُصْغٍ في بَذْلِهِ للملامِ",37,"م",1,0],["وَنَداهُ كَما تَراهُ ارتِجالٌ","جابِرٌ في الفَقيرِ كَسْرَ الفَقارِ",38,"ر",1,0],["وَنَدِمتُمُ وَلَوِ اِستَطاعَ عَلى جَوى","أَحشائِكُم لَوَقاكُمُ أَن تَندَموا",39,"م",3,0],["وَنَدىً إِذا اِدَّهَنَت بِهِ لِمَمُ الثَرى","خِلتَ السِحابَ أَتاهُ وَهُوَ مُعَذِّرُ",40,"ر",1,0],["وَنَدِيِّ أُنسٍ هَزَّني","هَزَّ الشَرابِ مِنَ الشَبابِ",41,"ب",1,1],["وَنَدبٌ لَبيبٌ يَمشُقُ الطَعنَ كاتِباً","وَيَكفيهِ أُنبوبٌ مِن الرُمحِ أَملَدُ",42,"د",1,0],["وندعو إلى الإسلامِ نَنشرُ نُورَهُ","ونُورِدُ منه قومَنا خيرَ مَورِدِ",43,"د",1,0],["وَنَدّى الماءُ جَفنَ العَينِ حَتّى","تَرَقرَقَ ثُمَّ فاضَ مِنَ الجُفونِ",44,"ن",1,0],["وَنَديمٍ قَد أَمرَضَ السُقمُ مِنهُ","مُقلَةً فاتِرَةً وَلِسانا",45,"ن",2,0],["وَنَداميَّ في شَبابٍ وَحُسنٍ","أَتلَفَت ما لَهُم نُفوسٌ كِرامُ",46,"م",1,0],["وَنَدمانٍ دَعَوتُ وَهَبَّ نَحوي","وَسَلسَلَها كَما اِنخَرَطَ العَقيقُ",47,"ق",1,1],["وَنَدمانٍ سَقَيتُ الراحَ صِرفاً","وَأُفقُ الصُبحِ مُرتَفِعُ السُجوفِ",48,"ف",1,1],["وَنَديمٍ قَمَرَتهُ","غَفلَةُ الكَأسِ العُقار",49,"ر",1,1],["ونَدامى كأنهُم قُضُب الفضضة","قد فُصّلَت بحسن القَوام",50,"م",1,0],["وَنَدمانٍ يَرى غَبَناً عَلَيهِ","بِأَن يُمسي وَلَيسَ لَهُ اِنتِشاءُ",51,"ا",2,1],["وَنَدمانِ صِدقٍ باكَرَ الراحَ سُحرَةً","فَأَضحى وَما مِنهُ اللِسانُ وَلا القَلبُ",52,"ب",1,0],["وَنَدمانٍ تَرادَفَهُ خُمارٌ","فَأَورَثَ في أَنامِلِهِ اِرتِعادا",53,"د",2,1],["وَنَديمي كُلُّ خِرقٍ","زانَهُ عِتقُ نِجارِه",54,"ر",2,0],["وَنَديمٍ لَم يَزَل ساقِيَنا","وَعَلى الصُبحِ مِنَ اللَيلِ إِزارُ",55,"ر",1,1],["وَنَدمانِ صِدقٍ بَل يَزيدُ فُكاهَةً","عَلى الصِدقِ لَم يَخلِط مُواتاتَهُ مَحكا",56,"ك",2,1],["وَنَدمانِ صِدقٍ مِن خُزاعَةَ في الذُرا","أَغَرَّ كَضَوءِ الصُبحِ حُلوِ الشَمائِلِ",57,"ل",1,1],["وَنَديمٍ مُساعِدٍ غَيرِ نِكسِ","حَيثُما مِلتَ مالَ مَعكَ مَميلا",58,"ل",2,0],["وَنَديمٍ فَدَيتُهُ مِن نَديمٍ","وَجهُهُ جالِبٌ لِكُلِّ نَعيمِ",59,"م",1,0],["وَنَدامايَ كِرامٌ","كُلُّهُم زَينٌ لِزَينِ",60,"ن",1,0],["وَنَديمٍ نادَمتُهُ عامِرِيٍّ","كَزِيادٍ عَينِ النَدى أَو يَزيدا",61,"د",2,0],["وَنَدمانِ صِدقٍ قَد وصَلتُ حديثَهُ","بِأَزهَرَ مَجّاجِ المُدامَةِ نَبّاحِ",62,"ح",1,0],["ونداءَ فادٍ تسأل الدنيا به","أصريعَ حربٍ أم شهيد سلامِ",63,"م",1,0],["ونُدِلُّ فوقَ النيراتِ بموكبٍ","فيه الحِجَى والبأسُ يلتقيانِ",64,"ن",1,0],["وَنَدعو أَن تُصاحَبَ كُلَّ مَجرٍ","وَنَدعو بِالإِيابِ إِذا تَأوبُ",65,"ب",1,0],["ونَدامَى لا يَفرحُونَ بِمَا نَا","لُوا ولا يَرهَبثونَ صَرفَ الَمنُونِ",66,"ن",1,0],["وَنَدَى الصَّبَاحِ يَزِينُهَا بِنِطَافِهِ","فَإِذَا جَرَتْ خِيلَتْ نَدَى أَحْدَاقِ",67,"ق",1,0],["وَنَدمانٍ تَفَرَّغَ مِن لُجَينٍ","لَدى طَودٍ مِنَ الأَطوادِ عالِ",68,"ل",1,0],["وندوةُ الشيخ «سعدٍ» أنت بهجتُها","لله درُّكَ بدرًا بين أَقمار!",69,"ر",1,0],["وندفع أحبابا كراما إلى الردى","ونسلو ونلهو بعد ذاك عن الأمر",70,"ر",1,0],["وندى يؤثر الضيوف على الأهل","إذا ما نوء السماوات ضنا",71,"ن",2,0],["ونداجي بلا اقتدار المداجي","ونغني ولا نجيد الرنينا",72,"ن",2,0],["وندِمنا فهل نكفّر عمَّا","قد جنينا اجتراحهً وابتداعا",73,"ع",2,0],["وَنَدامى لا يَفرَحونَ بِما نا","لوا وَلا يَرهَبونَ صَرفَ المَنونِ",74,"ن",1,0],["وندعو أن تصاحبَ كلَّ مجرٍ","وندعو بالايابِ إذا تؤوبُ",75,"ب",1,0],["وَنَدعوهُ لِلرَحمن عَبداً وَإِنَّهُ","لِيَكفيهِ فَخراً فاقَ فيهِ المَواليا",76,"ي",2,0],["وَنَداك مِنهُ البَحر أَيسر قُطرة","تَغدو بِهِ سُفن الرَجا وَتَروحُ",77,"ح",1,0],["وندعو لكم بالنصرِ والعدلِ غدوةً","إلى ان يغشينا النعاسَ منامُ",78,"م",1,0],["ونَدَى يديك مُصاحبي","بؤساً للزمانِ الذاهبِ",79,"ب",1,0],["وَنَدبتَها وَسأَلتَهَا عَن أهلِهَا","ومصونَ دَمعِكَ فَوقَ خَدِّكَ جَارِ",80,"ر",1,0],["وَندبٍ حَائِزٍ قَصَبَ التَّبَارِى","شَآ سُبَّاقَ حَلبَتِه عَدَاءَ",81,"ا",2,0],["وَنَداكَ رَوّى رَوضَ شِعري بارِضاً","حَتّى لَصارَ كَما تَراهُ مُنَوِّرا",82,"ر",2,0],["وَنَدىً يَعُمُّ وَلا يَخُصُّ كَأَنَّهُ","هامي قُطارٍ طَبَّقَ الأَقطارا",83,"ر",2,0],["وَنَدىً إِذا ما الغَيثُ خَصَّ أَوانُهُ","عَمَّ الأَنامَ فَعَمَّ كُلَّ أَوانِ",84,"ن",1,0],["وَنَدىً قَصَرتَ عَلى الثَناءِ فُنونَهُ","وَتُظِلُّ آمالَ الوَرى أَفنانُهُ",85,"ن",2,0],["وندخل في الحزب العظيم الذي حظى","بخير خطاب واتصال بحضرة",86,"ه",1,0],["وندرج في الدرج الذي في سادة","تساموا بإكرام لأرفع رتبة",86,"ه",1,0],["وندير صفو الانس في ربواتها","ذات الرياض الزاهرات النضر",87,"ر",1,0],["ونديرها حمراء ياقوتية","لم تُبقِ إلاًَّ وصفَها أيدي البل",88,"ل",1,0],["وَنَدْمانِ صدقٍ قال لي بعد رقدةٍ","أَلا فَاسْقِني كأساً عَلى شدَّة الظَّما",89,"ا",1,0],["ونداك معوان فمره يقوم لي","بأروش ما تجنى علي العفة",90,"ه",1,0],["وَنَدمانِ صِدقٍ قَد رَفَعتُ بِرأَسِهِ","إِليَّ وَأَوتارُ الوَليدَةِ تَعزِفُ",91,"ف",1,0],["وَنَديماهُ داثِرُ الحَدِّ عَضب","وَأَمينُ الفُصوصِ نَهدٌ ذَليلُ",92,"ل",1,0],["ونَداك أَدْوم ثم أحلى موقعا","منه فما ينفكُّ عن تخجيله",93,"ل",2,0],["وندى يمينك من عطايا حاتم","اوفى واوفر بالنوال واكثر",94,"ر",1,0],["وندمانٍ يساعِدني","ويَسقِيني ويشرب لي",95,"ل",2,0],["ونَدْمان صِدقٍ ليس تنبو طِباعه","بحيث صفا صَفْوَ الشّرابِ المُرَوّقِ",96,"ق",1,0],["وندامى لو لم يكونوا من الإن","س لما ناسبوا سوى الأقمار",97,"ر",1,0],["وَنَديمٍ صافٍ عَلى كَدَرِ الدَه","رِ سَليمٍ مِن شُبهَةٍ وَاِرتِيابِ",98,"ب",1,0],["وَنَدامايَ فِتِيةٌ يَطرَب الحا","ضِرَ مِنهُم فَكاهَةً وَبَراعَه",99,"ع",2,0],["وَنَديمٍ مِن شُيوخِ ال","كَرخِ مَحلولِ الرِباطِ",100,"ط",1,0],["وَنَدمانٌ كَبُستانٍ نَضيرٍ","بَعيدٍ أَن يَكونَ لَهُ نَظيرُ",101,"ر",1,0],["وَنَدى يَضيقُ بِسَحِّ دي","مَتِهِ المَحاني وَالشِعابُ",102,"ب",1,0],["وَنَدى يَهَشُّ إِلى العُفاةِ تَكَرُّمَاً","وَمَواهِبٌ بِالطارِقينَ تُرَحِّبُ",103,"ب",1,0],["وَنَدىً إِذا يَممتَه فَسأَلته","سالَت عَلَيكَ مِن