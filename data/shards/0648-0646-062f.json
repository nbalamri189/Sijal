رُّدِ",1,"د",1,0],["وَنَدَى يُؤْثُر الضُّيُوفَ عَلَى الأَهْ","لِ إِذَا مَا نَوْءُ السَّمَوَاتِ ضَنّا",2,"ن",2,0],["وَنَدىً كَصَوْبِ الْغَيْثِ إِلاَّ أَنَّهُ","لاَ يَعْرِفُ الإِمْحَالَ وَالإِمْسَاكَا",3,"ك",2,0],["وَنَدامى بيضُ الوُجوهِ كَأَنَّ ال","شَربَ مِنهُم مَصاعِبٌ أَفناقُ",4,"ق",1,0],["وَنَداكَ مُحتَضَرٌ وَنو","رُكَ في دُجى الظَلماءِ واقِد",5,"د",1,0],["وَنَدِيماً حَدِيثُهُ طُرَفٌ لا","تَتَنَاهَى أَلْطَافُهَا وَشُجُونُ",6,"ن",1,0],["وَنَدخُلُ بالسُّرُورِ ديارَ قَومٍ","وَنُعقِبُ آخرينَ أَذىً وَوَيلا",7,"ل",2,0],["ونُدرك فيه ثأرنا بكتائب","لها نَسَب من صلب يعرب مشتق",8,"ق",1,0],["وَنَدعو كَريماً مَن يَجودُ بِمالِهِ","وَمَن يَبذِلُ النَفسَ الكَريمَةَ أَكرَمُ",9,"م",1,0],["وَنَدماني السَريعُ إِلى لِقائي","عَلى عَجَلٍ وَأَقداحي الكِبارُ",10,"ر",1,0],["وَنَدنو دُنُوّاً لا يُوَلَّدُ جُرأَةً","وَنَجفو جَفاءً لايُوَلِّدُهُ زُهدُ",11,"د",1,0],["وَنَدمانِ صِدقٍ تَمطُرُ الخَيرَ كَفُّهُ","إِذا راحَ فَيّاضَ العَشِيّاتِ خِضرِما",12,"م",2,0],["وندًى يخجلُ السحابَ فيمشي","من ورا جودِهِ على استحياء",13,"ا",2,0],["ونداؤه هذا جزاً","فأقول قد صدق المنادي",14,"د",2,0],["وندباً أطارت طائر المدح واجباً","قوادِم من نعمائه وخواف",15,"ف",1,0],["وندى تتابع وفده حتى اشتكت","نفحات أنعمه الفلا والأينق",16,"ق",1,0],["ونديم يسعى بكأسيهِ مسعى","قمر التّم حوله الفرقدان",17,"ن",1,0],["وندًى شبَّ ذكره فنسينا","ما سمعناه عن فتى شيبان",17,"ن",1,0],["وندىً إذا فُقِدَ النَّدى","يتتبَّعُ العافي مُصابهْ",18,"ب",2,0],["وندرأ بؤسه بالصبر حتى","نفرجه بأذهان لطيفه",19,"ف",2,0],["وَنَديمٍ بِتُّ مِنهُ","ناعِمَ البالِ رَضِيّا",20,"ي",2,1],["وَنَدامى بِهِمُ العَي","شُ كَما قيلَ قَصيرُ",21,"ر",1,0],["وَنَديمٍ كَما نُحِبُّ ظَريفٍ","وَعَلى كُلِّ ما نُحِبُّ مُؤاتي",22,"ت",2,0],["وَنَدعوكَ الحُسامَ وَهَل حُسامٌ","يَعيشُ بِهِ مِنَ المَوتِ القَتيلُ",23,"ل",1,0],["وندىً لَوَ اَن السحبَ تَعْشُرُه","لم يتَّسِعْ لِقطَارها سُهبُ",24,"ب",1,0],["وَنُدمانُ صِدقٍ في جِوارِ خَليفَةٍ","غَدا بَينَ كَفَّيهِ النَدى وَالصَفائِحُ",25,"ح",1,0],["وَنَدى كَفِّهِ الَّتي نُسِبَ الجو","دُ إِلَيها تَعاقُبَ اِبنَي سَميرِ",26,"ر",1,0],["وَنَديمٌ حُلوُ الشَمائِلِ كَالدي","نارِ مَحضُ النِجارِ عَذبٌ مُصَفّى",27,"ف",2,1],["وَنَديمٍ نَبَّهتُهُ وَدُجى اللَي","لِ وَضَوءُ الصَباحِ يَعتَلِجانِ",28,"ن",1,0],["وَنَدمانٌ يَسُرُّكَ أَن تَراهُ","لَهُ مِن قَلبِ كُلِّ أَخٍ مَكانُ",29,"ن",1,0],["وندىً إذا استمطرتَ عارضَ مُزنِه","حنَّ الحَيا الرِّبعيُّ فيه وأَرزَما",30,"م",2,0],["ونَدىً رفَعْتَ به لِحَيَّيْ تَغلبٍ","شَرَفاً أنافَ فعانقَ العَيُّوقا",31,"ق",2,0],["ونَدمانِ صدقٍ نَثرُهُ ونِظامُه","ربيعٌ إذا فاوضتَه وخَريفُ",32,"ف",1,0],["ونَدمانٍ دَعَوْتُ إلى العُقارِ","وقد فضحَ الدُّجى ضَوْءَ النَّهارِ",33,"ر",1,1],["ونَداكَ لا تُنسى مَواعِدُه","كَرَماً فما أحتاجُ أذكُرُه",34,"ر",2,0],["وَنَديمي لَفظي وَفِكري أَنيسي","وَسُروري مائي وَصَبري زادي",35,"د",2,0],["ونداماه على طول المدى","رفقة حفّوا به كالحبب",36,"ب",1,0],["وندى فاضَ من بنانِ كريمٍ","غيرِ مُصْغٍ في بَذْلِهِ للملامِ",37,"م",1,0],["وَنَداهُ كَما تَراهُ ارتِجالٌ","جابِرٌ في الفَقيرِ كَسْرَ الفَقارِ",38,"ر",1,0],["وَنَدِمتُمُ وَلَوِ اِستَطاعَ عَلى جَوى","أَحشائِكُم لَوَقاكُمُ أَن تَندَموا",39,"م",3,0],["وَنَدىً إِذا اِدَّهَنَت بِهِ لِمَمُ الثَرى","خِلتَ السِحابَ أَتاهُ وَهُوَ مُعَذِّرُ",40,"ر",1,0],["وَنَدِيِّ أُنسٍ هَزَّني","هَزَّ الشَرابِ مِنَ الشَبابِ",41,"ب",1,1],["وَنَدبٌ لَبيبٌ يَمشُقُ الطَعنَ كاتِباً","وَيَكفيهِ أُنبوبٌ مِن الرُمحِ أَملَدُ",42,"د",1,0],["وندعو إلى الإسلامِ نَنشرُ نُورَهُ","ونُورِدُ منه قومَنا خيرَ مَورِدِ",43,"د",1,0],["وَنَدّى الماءُ جَفنَ العَينِ حَتّى","تَرَقرَقَ ثُمَّ فاضَ مِنَ الجُفونِ",44,"ن",1,0],["وَنَديمٍ قَد أَمرَضَ السُقمُ مِنهُ","مُقلَةً فاتِرَةً وَلِسانا",45,"ن",2,0],["وَنَداميَّ في شَبابٍ وَحُسنٍ","أَتلَفَت ما لَهُم نُفوسٌ كِرامُ",46,"م",1,0],["وَنَدمانٍ دَعَوتُ وَهَبَّ نَحوي","وَسَلسَلَها كَما اِنخَرَطَ العَقيقُ",47,"ق",1,1],["وَنَدمانٍ سَقَيتُ الراحَ صِرفاً","وَأُفقُ الصُبحِ مُرتَفِعُ السُجوفِ",48,"ف",1,1],["وَنَديمٍ قَمَرَتهُ","غَفلَةُ الكَأسِ العُقار",49,"ر",1,1],["ونَدامى كأنهُم قُضُب الفضضة","قد فُصّلَت بحسن القَوام",50,"م",1,0],["وَنَدمانٍ يَرى غَبَناً عَلَيهِ","بِأَن يُمسي وَلَيسَ لَهُ اِنتِشاءُ",51,"ا",2,1],["وَنَدمانِ صِدقٍ باكَرَ الراحَ سُحرَةً","فَأَضحى وَما مِنهُ اللِسانُ وَلا القَلبُ",52,"ب",1,0],["وَنَدمانٍ تَرادَفَهُ خُمارٌ","فَأَورَثَ في أَنامِلِهِ اِرتِعادا",53,"د",2,1],["وَنَديمي كُلُّ خِرقٍ","زانَهُ عِتقُ نِجارِه",54,"ر",2,0],["وَنَديمٍ لَم يَزَل ساقِيَنا","وَعَلى الصُبحِ مِنَ اللَيلِ إِزارُ",55,"ر",1,1],["وَنَدمانِ صِدقٍ بَل يَزيدُ فُكاهَةً","عَلى الصِدقِ لَم يَخلِط مُواتاتَهُ مَحكا",56,"ك",2,1],["وَنَدمانِ صِدقٍ مِن خُزاعَةَ في الذُرا","أَغَرَّ كَضَوءِ الصُبحِ حُلوِ الشَمائِلِ",57,"ل",1,1],["وَنَديمٍ مُساعِدٍ غَيرِ نِكسِ","حَيثُما مِلتَ مالَ مَعكَ مَميلا",58,"ل",2,0],["وَنَديمٍ فَدَيتُهُ مِن نَديمٍ","وَجهُهُ جالِبٌ لِكُلِّ نَعيمِ",59,"م",1,0],["وَنَدامايَ كِرامٌ","كُلُّهُم زَينٌ لِزَينِ",60,"ن",1,0],["وَنَديمٍ نادَمتُهُ عامِرِيٍّ","كَزِيادٍ عَينِ النَدى أَو يَزيدا",61,"د",2,0],["وَنَدمانِ صِدقٍ قَد وصَلتُ حديثَهُ","بِأَزهَرَ مَجّاجِ المُدامَةِ نَبّاحِ",62,"ح",1,0],["ونداءَ فادٍ تسأل الدنيا به","أصريعَ حربٍ أم شهيد سلامِ",63,"م",1,0],["ونُدِلُّ فوقَ النيراتِ بموكبٍ","فيه الحِجَى والبأسُ يلتقيانِ",64,"ن",1,0],["وَنَدعو أَن تُصاحَبَ كُلَّ مَجرٍ","وَنَدعو بِالإِيابِ إِذا تَأوبُ",65,"ب",1,0],["ونَدامَى لا يَفرحُونَ بِمَا نَا","لُوا ولا يَرهَبثونَ صَرفَ الَمنُونِ",66,"ن",1,0],["وَنَدَى الصَّبَاحِ يَزِينُهَا بِنِطَافِهِ","فَإِذَا جَرَتْ خِيلَتْ نَدَى أَحْدَاقِ",67,"ق",1,0],["وَنَدمانٍ تَفَرَّغَ مِن لُجَينٍ","لَدى طَودٍ مِنَ الأَطوادِ عالِ",68,"ل",1,0],["وندوةُ الشيخ «سعدٍ» أنت بهجتُها","لله درُّكَ بدرًا بين أَقمار!",69,"ر",1,0],["وندفع أحبابا كراما إلى الردى","ونسلو ونلهو بعد ذاك عن الأمر",70,"ر",1,0],["وندى يؤثر الضيوف على الأهل","إذا ما نوء السماوات ضنا",71,"ن",2,0],["وندمّي التلال ، تغلي فيمضي","كلّ تلّ دام ، بألفين ركبه",72,"ب",2,0],["ونداجي بلا اقتدار المداجي","ونغني ولا نجيد الرنينا",73,"ن",2,0],["ونداء خلف نداءات","لا تنسى ( عبلة ) يا ( عنتر )",74,"ر",1,0],["وندِمنا فهل نكفّر عمَّا","قد جنينا اجتراحهً وابتداعا",75,"ع",2,0],["وَنَدامى لا يَفرَحونَ بِما نا","لوا وَلا يَرهَبونَ صَرفَ المَنونِ",76,"ن",1,0],["وندعو أن تصاحبَ كلَّ مجرٍ","وندعو بالايابِ إذا تؤوبُ",77,"ب",1,0],["وَنَدعوهُ لِلرَحمن عَبداً وَإِنَّهُ","لِيَكفيهِ فَخراً فاقَ فيهِ المَواليا",78,"ي",2,0],["وَنَداك مِنهُ البَحر أَيسر قُطرة","تَغدو بِهِ سُفن الرَجا وَتَروحُ",79,"ح",1,0],["وندعو لكم بالنصرِ والعدلِ غدوةً","إلى ان يغشينا النعاسَ منامُ",80,"م",1,0],["ونَدَى يديك مُصاحبي","بؤساً للزمانِ الذاهبِ",81,"ب",1,0],["وَنَدبتَها وَسأَلتَهَا عَن أهلِهَا","ومصونَ دَمعِكَ فَوقَ خَدِّكَ جَارِ",82,"ر",1,0],["وَندبٍ حَائِزٍ قَصَبَ التَّبَارِى","شَآ سُبَّاقَ حَلبَتِه عَدَاءَ",83,"ا",2,0],["وَنَداكَ رَوّى رَوضَ شِعري بارِضاً","حَتّى لَصارَ كَما تَراهُ مُنَوِّرا",84,"ر",2,0],["وَنَدىً يَعُمُّ وَلا يَخُصُّ كَأَنَّهُ","هامي قُطارٍ طَبَّقَ الأَقطارا",85,"ر",2,0],["وَنَدىً إِذا ما الغَيثُ خَصَّ أَوانُهُ","عَمَّ الأَنامَ فَعَمَّ كُلَّ أَوانِ",86,"ن",1,0],["وَنَدىً قَصَرتَ عَلى الثَناءِ فُنونَهُ","وَتُظِلُّ آمالَ الوَرى أَفنانُهُ",87,"ن",2,0],["وندخل في الحزب العظيم الذي حظى","بخير خطاب واتصال بحضرة",88,"ه",1,0],["وندرج في الدرج الذي في سادة","تساموا بإكرام لأرفع رتبة",88,"ه",1,0],["وندير صفو الانس في ربواتها","ذات الرياض الزاهرات النضر",89,"ر",1,0],["ونديرها حمراء ياقوتية","لم تُبقِ إلاًَّ وصفَها أيدي البل",90,"ل",1,0],["وَنَدْمانِ صدقٍ قال لي بعد رقدةٍ","أَلا فَاسْقِني كأساً عَلى شدَّة الظَّما",91,"ا",1,0],["ونداك معوان فمره يقوم لي","بأروش ما تجنى علي العفة",92,"ه",1,0],["وَنَدمانِ صِدقٍ قَد رَفَعتُ بِرأَسِهِ","إِليَّ وَأَوتارُ الوَليدَةِ تَعزِفُ",93,"ف",1,0],["وَنَديماهُ داثِرُ الحَدِّ عَضب","وَأَمينُ الفُصوصِ نَهدٌ ذَليلُ",94,"ل",1,0],["ونَداك أَدْوم ثم أحلى موقعا","منه فما ينفكُّ عن تخجيله",95,"ل",2,0],["وندى يمينك من عطايا حاتم","اوفى واوفر بالنوال واكثر",96,"ر",1,0],["وندمانٍ يساعِدني","ويَسقِيني ويشرب لي",97,"ل",2,0],["ونَدْمان صِدقٍ ليس تنبو طِباعه","بحيث صفا صَفْوَ الشّرابِ المُرَوّقِ",98,"ق",1,0],["وندامى لو لم يكونوا من الإن","س لما ناسبوا سوى الأقمار",99,"ر",1,0],["وَنَديمٍ صافٍ عَلى كَدَرِ الدَه","رِ سَليمٍ مِن شُبهَةٍ وَاِرتِيابِ",100,"ب",1,0],["وَنَدامايَ فِتِيةٌ يَطرَب الحا","ضِرَ مِنهُم فَكاهَةً وَبَراعَه",101,"ع",2,0],["وَنَديمٍ مِن شُيوخِ ال","كَرخِ مَحلولِ الرِباطِ",102,"ط",1,0],["وَنَدمانٌ كَبُستانٍ نَضيرٍ","بَعيدٍ أَن يَكونَ لَهُ نَظيرُ",103,"ر",1,0],["وَنَدى يَضيقُ بِسَحِّ دي","مَتِهِ المَحاني وَالشِعابُ",104,"ب",1,0],["وَنَدى يَهَشُّ إِلى العُفاةِ تَكَرُّمَاً","وَمَواهِبٌ بِالطارِقينَ تُرَحِّبُ",105,"ب",1,0],["وَنَدىً إِذا يَممتَه فَسأَلته","سالَت عَلَيكَ مِن العَطاءِ سُيولُ",106,"ل",1,0],["وندى بخلت به","كفُّ يحيى بن خالد",107,"د",1,0],["وَنَديمٌ هِمتُ في غُرّتِه","وَشَرِبت الراحَ مِن راحَتِه",108,"ه",1,0],["ونديم الألحان من حان سكري","وله نشأةٌ به وانتشاء",109,"ا",2,0],["وَنَدى المُلوكِ نَظيرُ أَحراحٍ لِأَب","كارٍ حِمىً إِلّا عَنِ الحُرقوصِ",110,"ص",1,0],["وندمت حين أضعت ايام الصبا","وأضعت فيها لذتي ورغابي",111,"ب",2,0],["وَنَدِموا وما النَدم","مُجدٍ وقد زلَّ القدَم",112,"م",1,0],["وندرك السبق والغايات تبلغها","مهنأ بمنال القصد والأرب",113,"ب",1,0],["وندامى كالزهر يرجون صفوى","ويخافون ثورتي واندفاعي",114,"ي",1,0],["وَنِداكَ المَقصودُ في كُلِّ حَيٍّ","وَنَداكَ المَورودُ في كُلِّ نادِ",115,"د",1,0],["وَنَدى الطلِّ بإطلال النَدى","قلّد الزَهر عُقوداً لُؤلؤيّه",116,"ي",2,0],["وَندمان قُبيلَ الصُبح هبّوا","بحيّ عَلى الصبوح لَها أذانُ",117,"ن",1,0],["وَنَديمي في الهَوى رَشأ","فُتنت في حُسنه الغيدُ",118,"د",1,0],["وَنَديم النهى سَمير المَعالي","مُنذُ قَد كانَ سَيّداً في المهودِ",119,"د",1,0],["وندىً حُسِدْتُ له فحين أذلّني","فَرْطُ التَبذُّلِ زال كَرْبُ الحاسد",120,"د",1,0],["ونَدَّتْ بلَيلٍ للرّياحِ لَطيمةٌ","فنَمَّ بها للرّكبِ نَشْرٌ منَ النَّدّ",121,"د",1,0],["ونَدِيمي وُدُّهُ من طَرَبٍ","وسُرُورٍ أن تكونَ الكأسُ دَن",122,"ن",1,0],["وندىً ذكرُهُ إلى ما تَولا","هُ مِن الأنجُمِ السَّعيدَةِ سامِ",123,"م",1,0],["ونَديمٍ إِذا تَنفَّسَ في الكأ","سِ كَساها نَسيمَ مسكٍ فَتيقِ",124,"ق",1,0],["ونَدى أبي الحَسن الخَطيب خطابُه","لخطوبِها لما تطاوَلت اقصِري",125,"ر",2,0],["وندىً غدا بئسَ الخَلي","طُ له ونعم المقصدُ",126,"د",1,0],["ونَدِّ منه ثم الزم فعلهُ","كفّارةً من قبل أن تَحُلَّهُ",127,"ه",1,0],["وَنَدامى هُم نُجوم","بَل بُدور الداجِيات",128,"ت",1,0],["وَنَديمنا ظَبيٌ غَريرٌ بَينَنا","كَالبَدر بَينَ كَواكب الجَوزاء",129,"ا",2,0],["وَ