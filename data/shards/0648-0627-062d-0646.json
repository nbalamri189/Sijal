{"poems":[[11,"أتعرف أطلالاَ ونؤيا مهدم","https://www.aldiwan.net/poem268.html",""],[53,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[47,"ريح الشمال أتت بريح شمال","https://www.aldiwan.net/poem65636.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[108,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[119,"يا نعم ضائعة المكارم تنشد","https://www.aldiwan.net/poem41173.html","عموديه"],[128,"واحنيني إلى مباسم بيبي","https://www.aldiwan.net/poem23799.html","الخفيف"],[136,"سرى الطيف من لبنى فهاج الضنى وهنا","https://www.aldiwan.net/poem54730.html","الطويل"],[237,"عودي علي ولو كلمح الناظري","https://www.aldiwan.net/poem14832.html","الكامل"],[287,"بكاظمة قفوا وسلوا","https://www.aldiwan.net/poem32641.html","مجزوء الوافر"],[342,"رأيت وقد أتى نجران دوني","https://www.aldiwan.net/poem45430.html","الوافر"],[350,"وأحنف مسترخي العلابي طوحت","https://www.aldiwan.net/poem4475.html","الطويل"],[445,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[463,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86691","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/34702","الخفيف"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128273","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216674",""],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206233",""],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104785","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27738","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60940","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107002","الكامل"],[2679,"","https://poetry.dctabudhabi.ae/diwan/poem/122392","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205849","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205803","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202998","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202398","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52974","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138559",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125943","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206149","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103556","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77039","الطويل"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131648",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94625","الكامل"],[4679,"يانيل قد فاضت دموعي نيلاً","https://www.poetsgate.com/ViewPoem.aspx?id=142756",""],[4762,"يا ليت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=212916",""],[5005,"أصدقاء ولكن..","https://www.poetsgate.com/ViewPoem.aspx?id=204892",""],[5045,"أنا يماني وصيتي كل من يعرفه","https://www.poetsgate.com/ViewPoem.aspx?id=185721",""],[5114,"واجرد اصليت","https://www.poetsgate.com/ViewPoem.aspx?id=185540",""],[5275,"شهداء الخبزفي بلادي_جابر الشكرجي","https://www.poetsgate.com/ViewPoem.aspx?id=35816",""],[5294,"متتاليات الفوضى","https://www.poetsgate.com/ViewPoem.aspx?id=98132",""],[5389,"عشاق فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=207840",""],[5422,"كانت الدنيا صبيه","https://www.poetsgate.com/ViewPoem.aspx?id=151980",""],[5514,"رباعية الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=31895",""],[5850,"رأيتُ وقد أتى نَجْرانُ دوني","https://www.poetsgate.com/ViewPoem.aspx?id=19706",""],[5970,"ما بين قلب كليم آرق عاني","https://www.poetsgate.com/ViewPoem.aspx?id=130614",""],[6088,"حسان","https://www.poetsgate.com/ViewPoem.aspx?id=207592",""],[6102,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=182838",""],[6144,"مدارسنا ومدارسهم","https://www.poetsgate.com/ViewPoem.aspx?id=21675",""]],"verses":[["وَأَحناءَ سَرجٍ فاتِرٍ وَلِجامَهُ","عَتادَ فَتىً هَيجاً وَطِرفاً مُسَوَّما",0,"م",2,0],["وأحنفُ دهره حِلماً","بغير سريرةٍ نَغِلَهْ",1,"ل",2,0],["وَأَحِنُّ في غَلَسِ الدُجونِ مُسَهَّداً","وَأُواصِلُ الإِدبارَ بِالإِقبالِ",2,"ل",1,0],["وَأَحْنو عَلْيهَا حِنْيَةَ الأُمِّ مُشْفِقاً","وهَيْهَاتَ تَحْمِيهَا مِنَ البَيْنِ أَضْلُعِي",3,"ع",2,0],["واحنِ الجبينَ بقُدسِ مح","راب الفنون وطهره",4,"ر",2,0],["واحن ترحمني الحجارة لو وعت","والقلب مني مقلق ومنكد",5,"د",1,0],["واحنيني إلى مباسم بيبي","وأتون الغرام في وجنتيها",6,"ا",1,1],["وأحنَآ على الغِيابِ مِن أُمَّهَأتِهِم","فَهُوَّ الإِمَامُ الأَعدَلُ الأرأفُ الأحنَى",7,"ن",2,0],["وَأَحِنُّ حَنَّةَ ذاكِرٍ مُتَجاوِزٍ","لِرَسيسِ لَوعَتِهِ حَنينَ الذاكِرِ",8,"ر",1,0],["وَأَحناءُ الضُلوعِ عَلى","لَهيبِ النارِ تَشتَمِلُ",9,"ل",1,0],["وَأَحنَقَ صُلبُهُ وَطَوى مِعاهُ","وَكَشحَيهِ كَما طُوِيَ الحَصيرُ",10,"ر",1,0],["وَأَحنَفَ مُستَرخي العَلابِيَ طَوَّحَت","بِهِ الأَرضُ في بادٍ عَريضٍ وَحاضِرِ",11,"ر",1,1],["وأحنى موتِرٍ برضاه قوسي","وأخفى رائِشٍ بنَدَاهُ نَبْلي",12,"ل",2,0],["واحنوا لمُلكٍ عودتموه","حنوَّ بَرَّيْن حانيينِ",13,"ن",1,0],["واحنُ عليه فإنّه ولدٌ","أبوه قلبٌ وأمُّه خاطرْ",14,"ر",1,0],["وَأحنفٌ دُونه في الحلم وَهوَ بِما","لَهُ مِن العَزم في الإِقدام داود",15,"د",1,0],["واحنن عليه واعف عنه وعافه","واحرسه في المحيى وفي الأرماس",16,"س",1,0],["وأحن من ظمإ لوادي المنحنى","وأشم عرف بهارها والمنزل",17,"ل",1,0],["وَاِحنِطوني بِتُربِها ثُمَّ رُشّوا","كَفَني مِن رَحيقِها المَختومِ",18,"م",1,0],["وأحن ما حن الحمام كأنني","عود يردد نغمة الأوتار",19,"ر",1,0],["واحْنا بجَوٍّ يبْهج النفْس صافي","لي ينظره ما اظنّ لاح الكدَر فيه",20,"ي",2,0],["وآحنّ واشاكي مِنْ يحنّ","وغلاه فِيْ قلبي رضايف",21,"ف",1,0],["وَأَحنِى لِظهَرى رَاكِعاً غيرَ خاشِعٍ","وَمِن غيرِ تَوقِيرٍ وُضُوعِى لِجَبهتَى",22,"ت",2,0],["واحن عليه كالضلوعِ التي","قد انحنت خوفاً على القلبِ",23,"ب",1,0],["وأحِنّ من بُعدِ الديارِ إليكم","وقلُوبكم صَخْراً فما أقساكم",24,"م",1,0],["واحن للبرق اللموع","كأن بشرك لي تبسم",25,"م",1,0],["وأحنوا على أمواله يقسِمونها","فلا حامدٌ منهم عليها وشاكرُ",26,"ر",1,0],["واحنى على قبر الغريب موسداً","في قاع خالية من القرباء",27,"ا",2,0],["وأحنو على قلبي أُعزّيه بالهوى","وأبكي غراماً كفّنَتْه يداك",28,"ك",1,0],["وأحنو عليه وإمَّا قضى","تغسّله أدمعي الجاريه",29,"ي",2,0],["وأحنو على الصغرى أشد من الكبرى","فعطفي عليها كلما صغرت أسمى",30,"ا",1,0],["وأحن نحون شقيق تمٍ خدِّه","قد نمَّ فيه شقايقُ النعمان",31,"ن",1,0],["وأحنت له عوج السيوف ظهورها","وظلله من سمرها ما تكسرا",32,"ر",2,0],["وأَحنى لدى الحاجاتِ جِيداً وكاهلاً","وأَخنَى على الفَدمِ العنيدِ المقاومِ",33,"م",1,0],["وأحن للزمن القديم مرددا","سرى وأعبس للزمان المقبل",34,"ل",1,0],["وأحنو على الدنيا ويا ربما حنَت","على الميِّت الثاوي بهنَّ قبور",35,"ر",1,0],["وأحن نحو لقائه طرباً","كالطير إذ جنت إلى وكر",36,"ر",1,0],["وَأَحنِفهُم وَهوَ اِبنُ قَيسِ أَخو الحِجا","وَفي حِلمِهِ الاِمثال تَضرب مِن قبل",37,"ل",1,0],["واحنا الذي في الوغى والحرب ما نتعب","ولا ترانا نميل في محرب الدوله",38,"ل",2,0],["وأحنُّ شوقاً للقاءِ ولم يكن","لي في النوى سلوى وبتُّ متيَّما",39,"م",2,0],["وأحن للأرض التي قد أمها","وأود ربعاً ودَّ فيه حلولاَ",40,"ل",2,0],["وأحنّ لي قلبا نقيّا طاهرا","ببراءتي وسذاجتي أتنعّم",41,"م",1,0],["واحنثْ به، وتصدّقن بودِّه","فالمال من كفارة الأيمان",42,"ن",1,0],["واحنا عليها تعودنا القضاء والسلف","والعفو والاقتدار من قدرنا يرفعه",43,"ع",2,0],["واحنف خنذيذ يطاع كراهة","تداعى له شمّ العرانين سجّدا",44,"د",2,0],["واحنه ناطرين الجيته اعله الباب","اوجزه وكت الغده وتعدت المده",45,"د",2,0],["واحنا لو زيدنا ألف","مش هانلقى ميت أكله !",46,"ه",1,0],["واحنه ويّه حسين حاربنه الدهر","وما غُفت أمواجَه المتلاطمه",47,"م",2,0],["واحنا كنا حلم أخضر","ع الليالي ومفرودين",48,"ن",1,0],["واحنا كمان للاسف","ماحيلتنا الا لسان..",49,"ن",1,0],["وأحنقَ صلبهُ وطوى معاهُ","وكشحيهِ كما يطوى الحصيرُ",50,"ر",1,0],["واحنوا علي إذا ما الهم أرقني","وباركوني إذا ما الصبر وافاني",51,"ن",2,0],["وأحنت عليه الصدر ما زال يافعا","ومن قد نما في حضنها ما تشرذما",52,"م",2,0],["وَ احنُنْ عَلَى القَلبِ الذِي قَدْ ذابَ مِنْ","فَرطِ اصطِبارٍ فِي كَثِيرِ دَلَالِكا } . )",53,"ك",2,0],["واحنا وزارة معارفنا أم هليله","أم الحيطان والبيان، والحطة والشيلة",54,"ل",2,0]]}