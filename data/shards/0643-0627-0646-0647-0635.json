{"poems":[[74,"في الريق سكر وفي الأصداغ تجعيد","https://www.aldiwan.net/poem18560.html","البسيط"],[54,"من كل جسم كأنه عرض","https://www.aldiwan.net/poem27247.html","المنسرح"],[54,"لما رأونا في خميس يلتهب","https://www.aldiwan.net/poem27300.html","الرجز"],[77,"يا خير ملتحف بالمجد والكرم","https://www.aldiwan.net/poem69038.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8835","البسيط"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[111,"تلك ربوع الحي في سفح النقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545619",""],[189,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[266,"ما راعني الليل ولا السبسب","https://www.aldiwan.net/poem38366.html","السريع"],[280,"سما بأمرك إسعاد وإنجاد","https://www.aldiwan.net/poem25589.html","البسيط"],[287,"لنا برامة أوطان وأوطار","https://www.aldiwan.net/poem32786.html","البسيط"],[303,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[305,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[369,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38126","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62670","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62467","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110263","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62969","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45781","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86580","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33537","البسيط"],[4797,"ماهوب كفو الوقت حبك يمحّيه","https://www.poetsgate.com/ViewPoem.aspx?id=50259",""]],"verses":[["كأنَّه صنمٌ في الحبّ متبعٌ","هذا وما فيه إلاَّ القلب جلمود",0,"د",1,0],["كَأَنَّهُ صاغَهُ النِفاقُ فَما","يَخلُصُ مِنهُ صِدقٌ وَلا كَذِبُ",1,"ب",1,0],["كَأَنَّهُ صَبَّ عَلى الأَرضِ ذَهَب","وَقَد بَدَت أَسيافُنا مِنَ القُرَب",2,"ب",1,0],["كأنّهُ صَنَمٌ من بعْدِ فِطْنَتِهِ","وما التنفُّسُ معهودٌ من الصّنم",3,"م",1,0],["كَأَنَّهُ صَارِمٌ يَرْفَضُّ مِنْ عَلَقٍ","بِالأُفْقِ يُغْمَدُ أَحْيَاناً وَيُخْتَرَطُ",4,"ط",1,0],["كَأَنَّهُ صَبُّ سِلسالَ المِزاجِ عَلى","سَبيكَةٍ مِن بَناتِ التِبرِ صَفراءِ",5,"ا",2,0],["كأنه صاعقة منقضة","لوصلك في خطفته الطود ثرى",6,"ا",1,0],["كأنه صاعقة منقضة","لوصك في خطفته الطود ثرى",7,"ا",1,0],["كأنه صدرُ فضةٍ قُصِّرت","حافته وهْو مُذْهَبٌ مُحْرَق",8,"ق",1,0],["كأنه صوب ندى الأمجد","إبراهيم لو ماثله الصيب",9,"ب",1,0],["كَأنّه صِيتُه السيّارُ في أفُقَي","غَرْبٍ وَشَرْق فَتَأويبٌ وإِسْآدُ",10,"د",1,0],["كَأَنَّهُ صَنَمٌ تَهفو لِفِتنَتِهِ","مِنّا قُلوبٌ وَأَسماعٌ وَأَبصارُ",11,"ر",1,0],["كأَنه صورةٌ ما زال راسمها","يمحو وَيثبت كي تحكي محياك",12,"ك",1,0],["كَأَنَّهُ صُبحَ يَسري القَومُ لَيلَهُمُ","ماضٍ مِنَ الهِندُوانِيّاتِ مُنسَدِرُ",13,"ر",1,0],["كأنّه صنَمٌ أهدَى الحياةَ له","رَبُّ العبادِ وأبقَى قلبَه حَجَرا",14,"ر",2,0],["كَأَنّه صارِخ أرِّخْ يمنَ مَطلَعهِ","مِسْكٌ عَلى النّارِ أَم آسٍ عَلى الوردِ",15,"د",1,0],["كأنه صيرفيٌّ يأخذ الذهب الا","بريز في كمه والزيفَ يلقيه",16,"ي",2,0],["كأنَّهُ صارم في","كف الهُمام ابن تركي",17,"ك",2,0],["كأنه صنمٌ اقبلتُ اعبده","فلا تحركه نجوى مناجيه",18,"ي",2,0],["كأَنه صدرُ ردينية","ذابلةٍ في الكفِّ عسالَهْ",19,"ل",2,0],["كَأَنَّهُ صولجان وَهُوَ مُنصَلت","مِن غَمدِهِ وَرُؤس القَوم كَالأَكر",20,"ر",1,0],["كأنه صائد ندبٌ حبائله","أشعة الفكر لا تنبو عن الوطر",21,"ر",1,0],["كأنهُ صارمٌ عدنٌ صريمَتُهُ","لم يؤتَ من طَبعٍ فيه ولا ثلَمِ",22,"م",1,0],["كانه صلح لك واعجبك . زيد تبينه","ابنه وجهزّ للمقابيل مبناه",23,"ا",2,0]]}