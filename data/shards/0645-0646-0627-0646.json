Poem.aspx?id=215419",""],[5776,"الهُبوبُ الثّاني","https://www.poetsgate.com/ViewPoem.aspx?id=199446",""],[5781,"غاية بُغيتي..والأمل","https://www.poetsgate.com/ViewPoem.aspx?id=208931",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5926,"رنين الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213933",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[5939,"سارقة الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=131444",""],[5939,"يا حسنا كثيرَ الذنوب!","https://www.poetsgate.com/ViewPoem.aspx?id=138043",""],[5939,"أحلى عذاباتي","https://www.poetsgate.com/ViewPoem.aspx?id=178597",""],[5943,"العيدُ عيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=11095",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"شاعر يدافع عن صديقه","https://www.poetsgate.com/ViewPoem.aspx?id=192463",""],[5957,"شحروري","https://www.poetsgate.com/ViewPoem.aspx?id=207428",""],[5966,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=159346",""],[6019,"نبضاتٌ في حضرة الأمير (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=53829",""],[6052,"اخلاق المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=34793",""],[6056,"طيور الظلامي","https://www.poetsgate.com/ViewPoem.aspx?id=130381",""],[6062,"وعد","https://www.poetsgate.com/ViewPoem.aspx?id=176606",""],[6075,"طَيْفُ الْغَرَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=192917",""],[6075,"أجمل الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=210327",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6102,"فارسية","https://www.poetsgate.com/ViewPoem.aspx?id=184546",""],[6102,"لحم ودم","https://www.poetsgate.com/ViewPoem.aspx?id=184863",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[6152,"حورية الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=203287",""],[6189,"كائن بلا هوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67117&r=&rc=2",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6243,"سارق النّار الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84438&r=&rc=12",""],[5555,"مَنْ أنتَ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87413&r=&rc=9",""]],"verses":[["مَن أَنهَضَتهُ لِقَطعِ الوُدِّ عُذرَتُهُ","كانَ المُذَمَّمَ مِنهُ الكَفُّ وَالقَدَمُ",0,"م",1,0],["من أنا ؟.. أسأل شخصا داخلي :","هل أنا أنت ؟ ومن أنت ؟ وما اسمي ؟",1,"م",2,0],["من أنا ؟.. الليل يبني للرؤى","قامة كالرّمح ، من جلدي وعظمي",1,"م",2,0],["من أنا ؟.. صار ابن عمي تاجرا","واشترى شيخ ثريّ ، بنت عمّي",1,"م",2,0],["من أنا يا تكس ؟ أفلست وما شبعوا","من من حماة الأمن يحمي ؟",1,"م",2,0],["من أنا ؟ كانت ترى والدتي","ذلّ بعض الناس ، تحت البعض حتمي",1,"م",2,0],["من أنا والليلة الجرحى على","رغمها تهمي ، كما أهمي برغمي ؟",1,"م",2,0],["مَنْ أنْكَرَ الفَضْلَ الذي أوتيتَهُ","جحَدَ العِيانَ وأنْكَرَ المحبوسا",2,"س",2,0],["مَنْ أنْكَرَ غيْثاً منْشَؤهُ","في الأرضِ وليْسَ بمُخْلِفِها",3,"ف",3,1],["من أن يفارق حسن وجهك مهجتي","أو أن يحرك بي سواك رجاء",4,"ا",2,0],["مِن أَنَفِ الوَسمِيِّ نَوءُ صادِقُه","مُنبَجِسٌ مُرتَجِسٌ صَواعِقُه",5,"ق",2,0],["من أناسٍ كانُوا إذا عزمَ الده","ر وحامى كفاته وحماته",6,"ت",2,0],["من أناسٍ من التقى والمعالي","وهمُ بين نطفة أمشاج",7,"ج",1,0],["من أنشر العلم من بعدَ الهمود ومن","ضمَّت يدله المعالي وهو كالهمل",8,"ل",1,0],["من أناسٍ سادوا وشادوا معالي","هم بشدٍّ عند الفعال ولين",9,"ن",1,0],["من أناسٍ لا يُرْتَضون عبيداً","وهمُ في مراتبِ الأربابِ",10,"ب",1,0],["من أنَاسٍ قَدْ أوْسَعُونِيَ سَبَّاً","بعد عرفانِهمْ مَنِ المسبُوبُ",11,"ب",1,0],["من أناسٍ قُعُودُهُم كقيام ال","ناس لكنَّهُمْ قليلُو القُعُودِ",12,"د",1,0],["من أُناسٍ ترى الفضائلَ فيهم","صِبغةَ اللَه فهي غيرُ نَواضي",13,"ض",2,0],["من أنت يا من أبوه نصف ساقية","من باشِكوتى وكيف الأرض ترضعه",14,"ع",2,0],["من أناس أصبحوا في","دينهم سوداً وبلقا",15,"ق",2,0],["من أُناسٍ أوتوا حلومَ العصافي","ر فلم تُغنهم جسومُ البغالِ",16,"ل",1,0],["من أناسٍ ذوي جسوم شِخاتٍ","قد أُمرَّتْ على نفوسٍ نبالِ",16,"ل",1,0],["مَن أَنتَ يا هَذا فَقُلتُ لَها أَنا","كَالكَهرُباءِ أُرى خَفِيّاً ظاهِرا",17,"ر",2,0],["مَن أَنتَ أَجابَ أَنا أَنتَ","أَنا ذاتُكَ تَمشي قُدّامك",18,"ك",1,0],["مَن أَنا ما صَنَعتُ كَي تَعصُبوا بِالتا","جِ رَأسي وَأَيُّ شَأنٍ شاني",19,"ن",2,0],["مَن أَنتَ يا شَبَحاً كَئيباً صامِتاً","قُل لي فَإِنَّكَ قَد أَثَرتَ شُجوني",20,"ن",2,0],["مِن أَنعُمِ التاريخِ أَنَّ حِسابَهُ","حَقٌّ وَأَن قَضاءَهُ لا يُشجَبُ",21,"ب",1,0],["من انا حتى اصدر الشر","كما قد زعموا",22,"م",3,0],["مَن أَنتِ حَتّى تُداني","ذاتَ السَنا وَالسَناءِ",23,"ا",2,0],["مَن أَنبَتَ الغُصنَ مِن صَمصامَةٍ ذَكَرٍ","وَأَخرَجَ الريمَ مِن ضِرغامَةٍ قَرِمِ",24,"م",1,0],["مِن أُناسٍ كَالدَراري جُدُدٍ","في سَمَواتِ اللَيالي قُدَماء",25,"ا",2,0],["مَن أَنتَ مِنهُم يا هُمامَ وائِلا","الطاعِنينَ في الوَغى أَوائِلا",26,"ل",2,0],["مِن أَن تَصُدَّ الطَرفَ عَنّي وَأَن","أَخيبَ في جَدواكَ بَعدَ النَجاح",27,"ح",1,0],["مُنانا وَحاجَتُنا أَن يَعِز","زَ وَأَن يَمنَعَ اللَهُ مِن فَقدِهِ",28,"د",2,0],["مَن أَنتَ إِن حُصِّلتَ ياِبنَ اِستِها","وَمَن أَبو ديكِكَ في الرُقعَه",29,"ع",2,1],["من أنا .. خلي السؤالات أن","لوحة تبحث عن ألوانها",30,"ن",3,0],["مُنانا أن تُعَمَّرَ ألفَ عامٍ","وتُصرَفَ عنك أحداثُ الدُّهورِ",31,"ر",1,0],["مِن أُناسٍ إِذا تَمَنَّعَتِ العَل","ياءُ كانوا مِنها كَحَبلِ الوَريدِ",32,"د",1,0],["مِن أُناسٍ صَيَروا العِ","ضَ عَلى الذَمَّ حَراما",33,"م",2,0],["من أنتَ من أي العوالمِ ساحرٌ","مستأثر بأعنَّةِ الألبابِ",34,"ب",1,0],["مَن أنت يا مَن روحها اقتربت","مني وخاطب دمعها روحي",35,"ي",1,0],["من أنت لا أدري ولا من أنا","فيا إله الحب ماذا اسمنا",36,"ن",2,0],["مَن أَنكَرَ الضَّيمَ لَم يَأنَس بِصُحبَتِهِ","وَمَن أَحاطَت بِهِ الأَهوالُ لَم يُقِمِ",37,"م",1,0],["مَنْ أُنزِلَ القرآنُ في أوصافِهِ","أنا قاصرٌ عَنْ مدحِهِ متلجلجا",38,"ج",2,0],["مَن انتهى طيشُهُ في المخزيات إلى","هذا المقامِ عليهِ لعنةُ الباري",39,"ي",1,1],["من أنمل الغِيد في حسنٍ تُتمِّمه","فإنْ تعرَّتْ قمن أنياب تنِّين",40,"ن",1,0],["مِن أَنجُمِ السَعدِ وَلَكِنَّهُ","يَومَ الوَغى مِن أَنجُمِ القَذفِ",41,"ف",1,0],["مَن أَنكرَ اليأسَ المُذِلَّ وعَابَهُ","لأَخِي الحياةِ فمدَّ حَبلَ رَجائِه",42,"ا",3,0],["مِنّا نُساءُ إِذا الخُطوبُ تَحَفَّزَت","وَبِنا إِذا وَثَبَت نُصابُ وَنُنكَبُ",43,"ب",1,0],["من أنعُم الغيثِ الكثيرِ الجدا","ومكرماتِ العارضِ المسبل",44,"ل",1,0],["مِنْ أُناسٍ سادوا بَنِي الدِّينِ والدُّن","يا فما في الوَرَى لهُمْ مِنْ نَظِيرِ",45,"ر",1,0],["مِنْ أُنسٍ جانَبَتْ أَحْسَابُهُمْ","طُرُقَ الذَّمِّ شِمالاً ويَمِينا",46,"ن",2,0],["مَنِ انتاشَهُم في كلِّ شرقٍ ومَغربٍ","فبُدّلَ أمْناً ذلك الخوْفُ والذُّعْرُ",47,"ر",1,0],["مَنّانِيَ الصَبرَ لا يَألو لِيوقِعَني","حَتّى إِذا صارَ بي في مَقطَعِ السُبُلِ",48,"ل",1,0],["مَن أَنا في مَوقِفِ الحِسابِ إِذا","نودِيَ بِالأَنبِياءِ وَالرُسُلِ",49,"ل",1,1],["مِن أَنكَرِ النُكرِ سودانٌ شَرامِحَةٌ","تَكونُ أَبناؤُها بيضاً تَنابيلا",50,"ل",2,0],["من أنت يا من يجوب الليل منفردا","ولم تقع لي عليه بعد عينان",51,"ن",1,0],["مِن أنْجُمِ الدَّرْعاءِ أو نابِتِ ال","فَقْعاءِ بل مِنْ زَرَدٍ مُحْكَم",52,"م",1,0],["من أُناس كنت أرجوُ نَفعَهُم","أَصبحُوا قد خَمَدُوا تحتَ البلَدَ",53,"د",1,0],["من أنا والأنا فناء ومحو","في مقام التعذيب والأشهاد",54,"د",1,0],["من أنا والأنا خيال ووهم","في مقام الخطاب والارشاد",54,"د",1,0],["من أنا والأنا مجاز وظل","في مقام الابعاد والايجاد",54,"د",1,0],["من أنا نسبة الى أثر ال","حق شهيد للحق بالانفراد",54,"د",1,0],["من أنت يا مجدي أفتدي ؟)","قال لي ك (مجدي أفتدي)",55,"د",2,0],["من أنادي ؟ وأنت صمّا سميعه","بين صوتي وبين أمّي قطيعه",56,"ع",2,1],["من أنادي ؟ من ذا هنا ؟ لم يجبني","آه ، إلاّ صمت القبور الصديعه",56,"ع",2,0],["من أنا ؟ شاعر ، حريق يغنّي","وغنائي دمي ، دخان دخاني",57,"ن",2,0],["من أنت ماذا تساوي ؟","وكلّ ما فيك خاوي",58,"ا",3,1],["من أنادي يا ريح ؟ : من لست أدري","هل سيدنو ، أم يستزيد ابتعادا",59,"د",2,0],["من أنا يا مدى ..؟ وأنكر صوتي","ويعبّ السّفار وجه السفيره",60,"ر",2,0],["من أنا ..؟ وانجلت لها من بعيد","لوز ((همدان)) كالنجوم الصغيره",60,"ر",2,0],["مُنَانَا وَحَاجَتُنا أنْ يَعِزّ،","وَأنْ يَمْنَعَ الله مِنْ فَقْدِهِ",61,"د",2,0],["من أنّه الثكلى أخذت رويّها","ومن القلوب قد استعرت مدادها",62,"د",3,0],["من أنت؟ وارتاع نهدٌ","طفل.. كثير الفضول",63,"ل",1,0],["من أنت؟ أوجعت حتى","تنفتا القميص الكسول",63,"ل",1,0],["منْ أنتَ يا من أبوه نصفُ ساقية ٍ","من ياشِكوتي وكيف الأرضُ ترضعهُ",64,"ع",2,0],["مَنْ أنتَ؟! من أيِّ العوالم ساخرٌ","مستأثرٌ بأعنة الألبابِ؟",65,"ب",1,0],["من أنا .. خلي السؤالات أنا","لوحة تبحث عن ألوانها",66,"ن",3,0],["مَنْ أنتِ . . مَنْ رماكِ في طريقي ؟","مَنْ حرَّكَ المياهَ في جذوري ؟",67,"ر",2,0],["من أنتِ ؟ من أنتِ؟ لا الأسماءُ تُسعِفُني","ولا البصيرةُ ، تكفيني ، ولا البَصَرُ",68,"ر",1,0],["مِن أُناسٍ تَوارَثوا البَأسَ وَالنَخ","وَةَ وَاِستَحقَبوا العُلى أَحقابا",69,"ب",2,0],["مِن أَنعُمٍ قَد غارَ عِدُّ مَحامِدي","في ضِمنِهِنَّ وَصارَ بَحري جَدوَلا",70,"ل",2,0],["من أنت يا دهرُ ما تريد","وما غمومٌ بها تجود",71,"د",1,0],["من أنت لا أدري","وأنت هل تدري",72,"ي",1,0],["من أنت لا لن أسمى غافلا جهلت","أجفانه ما جرى من ماء أجفاني",73,"ن",2,0],["من أنت هذا كلامٌ أنت لا أحد","إنى أردّد ما يوحيه شيطاني",73,"ن",2,0],["من أنت إني أرى من أنت يا وثنا","أهدى له كل يومٍ ألف قربان",73,"ن",1,0],["من أنت يا ساحراً لحن الغرام به","لحن الخلود بذاك العالم الثاني",73,"ن",2,0],["من أنت سوف ترى من أنت إن سمحت","روحي بقتل هوى بالشعر أحياني",73,"ن",2,0],["من أنت سوف ترى من أنت يوم ترى","أنى سأضني الذي بالصد أضناني",73,"ن",2,0],["من أنت لا لن أسمى لن يبوح فمي","باسمٍ إذا قلته في السر أبكاني",73,"ن",2,0],["من أنت من شاعرٌ أدميت مهجتهُ","بأعين لك لم توهب لإنسان",73,"ن",1,0],["من أنت إني أرى من أنت يا رشأ","من غدره سوف يسقى كأس كفراني",73,"ن",2,0],["من أنت لا لن أسمّى من أهيم به","يكفى الذي قد مضى من فضح أشجاني",73,"ن",2,0],["من أنت ما هالةٌ يسرى بها قمرٌ","مسرى الصبابة في أحلام ولهان",73,"ن",1,0],["من أنت سوف أسمى يوم تلهمني","ما لم يكن لي في وهم وحسبان",73,"ن",1,0],["مَن أَنتَ أَنتَ يَدٌ سَوداءُ ما اِرتَفَعَت","إِلّا لِتَفريقِ أَحبابٍ وَإِخوانِ",74,"ن",1,0],["مَن أَنتِ يا بِنتَ الأُلى وَجدوكِ","في رَوضَةِ الدُنيا بِغَير شَريكِ",75,"ك",1,1],["مِنْ أَن تُباكِرَ بالنَّدَامى قهوةً","صفراءَ مِمّا عَتَّقَتْها بابِلُ",76,"ل",1,