,[462,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[465,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[465,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[465,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[480,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[483,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[483,"أطلعن في قمر الأفوق شموسنا","https://www.aldiwan.net/poem24426.html","عموديه"],[496,"يا قلب ما أغفلك","https://www.aldiwan.net/poem10253.html","السريع"],[552,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[552,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[552,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[559,"أيها الناي عندك الخبر","https://www.aldiwan.net/poem34554.html","الخفيف"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"]],"verses":[["مَن أَنهَضَتهُ لِقَطعِ الوُدِّ عُذرَتُهُ","كانَ المُذَمَّمَ مِنهُ الكَفُّ وَالقَدَمُ",0,"م",1,0],["من أنا ؟.. أسأل شخصا داخلي :","هل أنا أنت ؟ ومن أنت ؟ وما اسمي ؟",1,"م",2,0],["من أنا ؟.. الليل يبني للرؤى","قامة كالرّمح ، من جلدي وعظمي",1,"م",2,0],["من أنا ؟.. صار ابن عمي تاجرا","واشترى شيخ ثريّ ، بنت عمّي",1,"م",2,0],["من أنا يا تكس ؟ أفلست وما شبعوا","من من حماة الأمن يحمي ؟",1,"م",2,0],["من أنا ؟ كانت ترى والدتي","ذلّ بعض الناس ، تحت البعض حتمي",1,"م",2,0],["من أنا والليلة الجرحى على","رغمها تهمي ، كما أهمي برغمي ؟",1,"م",2,0],["مَنْ أنْكَرَ الفَضْلَ الذي أوتيتَهُ","جحَدَ العِيانَ وأنْكَرَ المحبوسا",2,"س",2,0],["مَنْ أنْكَرَ غيْثاً منْشَؤهُ","في الأرضِ وليْسَ بمُخْلِفِها",3,"ف",3,1],["من أن يفارق حسن وجهك مهجتي","أو أن يحرك بي سواك رجاء",4,"ا",2,0],["مِن أَنَفِ الوَسمِيِّ نَوءُ صادِقُه","مُنبَجِسٌ مُرتَجِسٌ صَواعِقُه",5,"ق",2,0],["من أناسٍ كانُوا إذا عزمَ الده","ر وحامى كفاته وحماته",6,"ت",2,0],["من أناسٍ من التقى والمعالي","وهمُ بين نطفة أمشاج",7,"ج",1,0],["من أنشر العلم من بعدَ الهمود ومن","ضمَّت يدله المعالي وهو كالهمل",8,"ل",1,0],["من أناسٍ سادوا وشادوا معالي","هم بشدٍّ عند الفعال ولين",9,"ن",1,0],["من أناسٍ لا يُرْتَضون عبيداً","وهمُ في مراتبِ الأربابِ",10,"ب",1,0],["من أنَاسٍ قَدْ أوْسَعُونِيَ سَبَّاً","بعد عرفانِهمْ مَنِ المسبُوبُ",11,"ب",1,0],["من أناسٍ قُعُودُهُم كقيام ال","ناس لكنَّهُمْ قليلُو القُعُودِ",12,"د",1,0],["من أُناسٍ ترى الفضائلَ فيهم","صِبغةَ اللَه فهي غيرُ نَواضي",13,"ض",2,0],["من أنت يا من أبوه نصف ساقية","من باشِكوتى وكيف الأرض ترضعه",14,"ع",2,0],["من أناس أصبحوا في","دينهم سوداً وبلقا",15,"ق",2,0],["من أُناسٍ أوتوا حلومَ العصافي","ر فلم تُغنهم جسومُ البغالِ",16,"ل",1,0],["من أناسٍ ذوي جسوم شِخاتٍ","قد أُمرَّتْ على نفوسٍ نبالِ",16,"ل",1,0],["مَن أَنتَ يا هَذا فَقُلتُ لَها أَنا","كَالكَهرُباءِ أُرى خَفِيّاً ظاهِرا",17,"ر",2,0],["مَن أَنتَ أَجابَ أَنا أَنتَ","أَنا ذاتُكَ تَمشي قُدّامك",18,"ك",1,0],["مَن أَنا ما صَنَعتُ كَي تَعصُبوا بِالتا","جِ رَأسي وَأَيُّ شَأنٍ شاني",19,"ن",2,0],["مَن أَنتَ يا شَبَحاً كَئيباً صامِتاً","قُل لي فَإِنَّكَ قَد أَثَرتَ شُجوني",20,"ن",2,0],["مِن أَنعُمِ التاريخِ أَنَّ حِسابَهُ","حَقٌّ وَأَن قَضاءَهُ لا يُشجَبُ",21,"ب",1,0],["من انا حتى اصدر الشر","كما قد زعموا",22,"م",3,0],["مَن أَنتِ حَتّى تُداني","ذاتَ السَنا وَالسَناءِ",23,"ا",2,0],["مَن أَنبَتَ الغُصنَ مِن صَمصامَةٍ ذَكَرٍ","وَأَخرَجَ الريمَ مِن ضِرغامَةٍ قَرِمِ",24,"م",1,0],["مِن أُناسٍ كَالدَراري جُدُدٍ","في سَمَواتِ اللَيالي قُدَماء",25,"ا",2,0],["مَن أَنتَ مِنهُم يا هُمامَ وائِلا","الطاعِنينَ في الوَغى أَوائِلا",26,"ل",2,0],["مِن أَن تَصُدَّ الطَرفَ عَنّي وَأَن","أَخيبَ في جَدواكَ بَعدَ النَجاح",27,"ح",1,0],["مُنانا وَحاجَتُنا أَن يَعِز","زَ وَأَن يَمنَعَ اللَهُ مِن فَقدِهِ",28,"د",2,0],["مَن أَنتَ إِن حُصِّلتَ ياِبنَ اِستِها","وَمَن أَبو ديكِكَ في الرُقعَه",29,"ع",2,1],["من أنا .. خلي السؤالات أن","لوحة تبحث عن ألوانها",30,"ن",3,0],["مُنانا أن تُعَمَّرَ ألفَ عامٍ","وتُصرَفَ عنك أحداثُ الدُّهورِ",31,"ر",1,0],["مِن أُناسٍ إِذا تَمَنَّعَتِ العَل","ياءُ كانوا مِنها كَحَبلِ الوَريدِ",32,"د",1,0],["مِن أُناسٍ صَيَروا العِ","ضَ عَلى الذَمَّ حَراما",33,"م",2,0],["من أنتَ من أي العوالمِ ساحرٌ","مستأثر بأعنَّةِ الألبابِ",34,"ب",1,0],["مَن أنت يا مَن روحها اقتربت","مني وخاطب دمعها روحي",35,"ي",1,0],["من أنت لا أدري ولا من أنا","فيا إله الحب ماذا اسمنا",36,"ن",2,0],["مَن أَنكَرَ الضَّيمَ لَم يَأنَس بِصُحبَتِهِ","وَمَن أَحاطَت بِهِ الأَهوالُ لَم يُقِمِ",37,"م",1,0],["مَنْ أُنزِلَ القرآنُ في أوصافِهِ","أنا قاصرٌ عَنْ مدحِهِ متلجلجا",38,"ج",2,0],["مَن انتهى طيشُهُ في المخزيات إلى","هذا المقامِ عليهِ لعنةُ الباري",39,"ي",1,1],["من أنمل الغِيد في حسنٍ تُتمِّمه","فإنْ تعرَّتْ قمن أنياب تنِّين",40,"ن",1,0],["مِن أَنجُمِ السَعدِ وَلَكِنَّهُ","يَومَ الوَغى مِن أَنجُمِ القَذفِ",41,"ف",1,0],["مَن أَنكرَ اليأسَ المُذِلَّ وعَابَهُ","لأَخِي الحياةِ فمدَّ حَبلَ رَجائِه",42,"ا",3,0],["مِنّا نُساءُ إِذا الخُطوبُ تَحَفَّزَت","وَبِنا إِذا وَثَبَت نُصابُ وَنُنكَبُ",43,"ب",1,0],["من أنعُم الغيثِ الكثيرِ الجدا","ومكرماتِ العارضِ المسبل",44,"ل",1,0],["مِنْ أُناسٍ سادوا بَنِي الدِّينِ والدُّن","يا فما في الوَرَى لهُمْ مِنْ نَظِيرِ",45,"ر",1,0],["مِنْ أُنسٍ جانَبَتْ أَحْسَابُهُمْ","طُرُقَ الذَّمِّ شِمالاً ويَمِينا",46,"ن",2,0],["مَنِ انتاشَهُم في كلِّ شرقٍ ومَغربٍ","فبُدّلَ أمْناً ذلك الخوْفُ والذُّعْرُ",47,"ر",1,0],["مَنّانِيَ الصَبرَ لا يَألو لِيوقِعَني","حَتّى إِذا صارَ بي في مَقطَعِ السُبُلِ",48,"ل",1,0],["مَن أَنا في مَوقِفِ الحِسابِ إِذا","نودِيَ بِالأَنبِياءِ وَالرُسُلِ",49,"ل",1,1],["مِن أَنكَرِ النُكرِ سودانٌ شَرامِحَةٌ","تَكونُ أَبناؤُها بيضاً تَنابيلا",50,"ل",2,0],["من أنت يا من يجوب الليل منفردا","ولم تقع لي عليه بعد عينان",51,"ن",1,0],["مِن أنْجُمِ الدَّرْعاءِ أو نابِتِ ال","فَقْعاءِ بل مِنْ زَرَدٍ مُحْكَم",52,"م",1,0],["من أُناس كنت أرجوُ نَفعَهُم","أَصبحُوا قد خَمَدُوا تحتَ البلَدَ",53,"د",1,0],["من أنت يا مجدي أفتدي ؟)","قال لي ك (مجدي أفتدي)",54,"د",2,0],["من أنادي ؟ وأنت صمّا سميعه","بين صوتي وبين أمّي قطيعه",55,"ع",2,1],["من أنادي ؟ من ذا هنا ؟ لم يجبني","آه ، إلاّ صمت القبور الصديعه",55,"ع",2,0],["من أنا ؟ شاعر ، حريق يغنّي","وغنائي دمي ، دخان دخاني",56,"ن",2,0],["من أنت ماذا تساوي ؟","وكلّ ما فيك خاوي",57,"ا",3,1],["من أنادي يا ريح ؟ : من لست أدري","هل سيدنو ، أم يستزيد ابتعادا",58,"د",2,0],["من أنا يا مدى ..؟ وأنكر صوتي","ويعبّ السّفار وجه السفيره",59,"ر",2,0],["من أنا ..؟ وانجلت لها من بعيد","لوز ((همدان)) كالنجوم الصغيره",59,"ر",2,0],["مُنَانَا وَحَاجَتُنا أنْ يَعِزّ،","وَأنْ يَمْنَعَ الله مِنْ فَقْدِهِ",60,"د",2,0],["من أنّه الثكلى أخذت رويّها","ومن القلوب قد استعرت مدادها",61,"د",3,0],["من أنت؟ وارتاع نهدٌ","طفل.. كثير الفضول",62,"ل",1,0],["من أنت؟ أوجعت حتى","تنفتا القميص الكسول",62,"ل",1,0],["منْ أنتَ يا من أبوه نصفُ ساقية ٍ","من ياشِكوتي وكيف الأرضُ ترضعهُ",63,"ع",2,0],["مَنْ أنتَ؟! من أيِّ العوالم ساخرٌ","مستأثرٌ بأعنة الألبابِ؟",64,"ب",1,0],["من أنا .. خلي السؤالات أنا","لوحة تبحث عن ألوانها",65,"ن",3,0],["مَنْ أنتِ . . مَنْ رماكِ في طريقي ؟","مَنْ حرَّكَ المياهَ في جذوري ؟",66,"ر",2,0],["من أنتِ ؟ من أنتِ؟ لا الأسماءُ تُسعِفُني","ولا البصيرةُ ، تكفيني ، ولا البَصَرُ",67,"ر",1,0],["مِن أُناسٍ تَوارَثوا البَأسَ وَالنَخ","وَةَ وَاِستَحقَبوا العُلى أَحقابا",68,"ب",2,0],["مِن أَنعُمٍ قَد غارَ عِدُّ مَحامِدي","في ضِمنِهِنَّ وَصارَ بَحري جَدوَلا",69,"ل",2,0],["من أنت يا دهرُ ما تريد","وما غمومٌ بها تجود",70,"د",1,0],["من أنت لا أدري","وأنت هل تدري",71,"ي",1,0],["من أنت لا لن أسمى غافلا جهلت","أجفانه ما جرى من ماء أجفاني",72,"ن",2,0],["من أنت هذا كلامٌ أنت لا أحد","إنى أردّد ما يوحيه شيطاني",72,"ن",2,0],["من أنت إني أرى من أنت يا وثنا","أهدى له كل يومٍ ألف قربان",72,"ن",1,0],["من أنت يا ساحراً لحن الغرام به","لحن الخلود بذاك العالم الثاني",72,"ن",2,0],["من أنت سوف ترى من أنت إن سمحت","روحي بقتل هوى بالشعر أحياني",72,"ن",2,0],["من أنت سوف ترى من أنت يوم ترى","أنى سأضني الذي بالصد أضناني",72,"ن",2,0],["من أنت لا لن أسمى لن يبوح فمي","باسمٍ إذا قلته في السر أبكاني",72,"ن",2,0],["من أنت من شاعرٌ أدميت مهجتهُ","بأعين لك لم توهب لإنسان",72,"ن",1,0],["من أنت إني أرى من أنت يا رشأ","من غدره سوف يسقى كأس كفراني",72,"ن",2,0],["من أنت لا لن أسمّى من أهيم به","يكفى الذي قد مضى من فضح أشجاني",72,"ن",2,0],["من أنت ما هالةٌ يسرى بها قمرٌ","مسرى الصبابة في أحلام ولهان",72,"ن",1,0],["من أنت سوف أسمى يوم تلهمني","ما لم يكن لي في وهم وحسبان",72,"ن",1,0],["مَن أَنتَ أَنتَ يَدٌ سَوداءُ ما اِرتَفَعَت","إِلّا لِتَفريقِ أَحبابٍ وَإِخوانِ",73,"ن",1,0],["مَن أَنتِ يا بِنتَ الأُلى وَجدوكِ","في رَوضَةِ الدُنيا بِغَير شَريكِ",74,"ك",1,1],["مِنْ أَن تُباكِرَ بالنَّدَامى قهوةً","صفراءَ مِمّا عَتَّقَتْها بابِلُ",75,"ل",1,0],["مَنَ أنْتُمْ فقلنا عُصْبةٌ من بني الصِّبا","دعاهم إليكِ القَصْفُ والعَزْف واللِّعْب",76,"ب",1,0],["من أناسٍ حازوا الثناء ببذل الج","ود مجداً أكرم بهم من أُناس",77,"س",1,0],["من أنت تضلّ فذاك من الْ","هُلّاك ومن تهدي فنجي",78,"ي",1,0],["من انزلت فيه أمن هو قانت","ذاك الَّذي جمع الكتاب المحكما",79,"م",2,0],["مِنْ أَنْ يَكُونَ الَّذِي بَيْنِي وَبَيْنَهُمُ","شَيْئاً سِوى الْحَظِّ يُدْنِيهِمْ وَيُقْصِينِي",80,"ن",2,0],["من أن يصاب بعلة","ويموت وهو على السرير",81,"ر",1,0],["من انقاد للآمال بالطمع اختنى","وما هي الا كالسراب الظمآن",82,"ن",1,0],["مِن أَن تَخدِشَ خَدَّكَ الأَبصارُ","هامَت بِرُؤيَتِكَ العُيونُ وَرَجَحَت",83,"ت",1,0],["من أنا دون عزة وعلاءٍ","وطموح على الليالي وطيد",84,"د",1,0],["من أنا إن رضيت للوطن الأم","جد عيش الأغلال والتقييد",84,"د",1,0],["من أنا في الحياة إن حملتني","ميت الذات فانيا في ركودي",84,"د",2,0],["من أنا والوجود حولي فسيح","إن تقيّدت بالصوى والحدود",84,"د",1,0],["من أنا من أكون ما كنت ما بد","ءُ وجودي متى تكون النهايه",85,"ه",1,0],["مَن إِن سَعَيتُ رَأى سَعيي فَأَقعَدَني","وَقامَ عَنّي وَبي حَتّى هُوَ الساعي",86,"ع",2,0],["مَن أنتَ مِن مُضرِ الحَمراءِ واليَمنِ","وما جُفُونكَ في الخَطِّية اللُّدُنِ",87,"ن",1,1],["مَن أَنتَ حيلَتَه أَبا","سَهلٍ إِذا لَم تَبقَ حيلَه",88,"ل",2,0],["مَن اِن سَما هَبط الزَمانُ وَريبُهُ","أَو قامَ فَالدَهر المَغالِب يُقعدُ",89,"د",1,0],["مَن إنْ دجَتْ ظُلَمُ النّوائب حلِّها","رأيٌ له في المشكلاتِ رجيحُ",90,"ح",1,0],["مِن أناسٍ كانوا ملكَ البرايا","كلُّ كهْلٍ منهمْ وك