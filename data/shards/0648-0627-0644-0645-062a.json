{"poems":[[95,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[80,"أباح لطيفي طيفها في الكرى الخد","https://www.aldiwan.net/poem14018.html","الطويل"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[309,"يا آخذا مني بأذيالي","https://www.aldiwan.net/poem16757.html","السريع"],[309,"يا راحلاً إن جئت وادي المنحنى","https://www.aldiwan.net/poem16793.html","الكامل"],[396,"قلت الراحة في هذا الزمن","https://www.aldiwan.net/poem54536.html","عموديه"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[549,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/112999","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50035","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95553","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97886","الكامل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103947","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131301",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95323","الكامل"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4767,"الغيمة السوداء","https://www.poetsgate.com/ViewPoem.aspx?id=200825",""],[4869,"ظلم خلق الله","https://www.poetsgate.com/ViewPoem.aspx?id=151717",""],[4953,"عروس الغجر!!!","https://www.poetsgate.com/ViewPoem.aspx?id=201298",""],[5032,"القناديل الغامضة","https://www.poetsgate.com/ViewPoem.aspx?id=189645",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5536,"بذرة غلاه!!!","https://www.poetsgate.com/ViewPoem.aspx?id=20300",""],[5977,"كل الأسى سوف ننساه","https://www.poetsgate.com/ViewPoem.aspx?id=213237",""]],"verses":[["وَالمُتْقِنُ المِجُوَادُ يُرْ","ضى اللهَ عَنْهُ وَالصَّحَابَا",0,"ب",2,0],["وَألمَتني ثَغراً شَمَمتُ نَسيمهُ","فَخُيِّلَ لي أَنّي شَمَمتُ بِهِ نَدّا",1,"د",2,0],["والمت بك الرزايا ولكن","انت ما كنت عابئا بالرزايا",2,"ي",2,0],["والمُتقاربُ الذي في الآخرِ","تَحلو بهِ خامسةُ الدَّوائرِ",3,"ر",1,0],["والمتقون لهم أجر على عمل","ذاك الجزاء فيا طوبى لمن رحما",4,"م",2,0],["والمتقين جنة ولهم","فيها نعيم ليس بالبالي",5,"ل",2,0],["والمتقون رجاله وحضوره","يا رب فالحقنا بهم يا ربنا",6,"ن",2,0],["والمتاعب والمخاوف والحزن","كلها بطن المظاهر والفضول",7,"ل",1,0],["والمُتْلفينَ المال في بذْلِ النَّدى","اِتلافَهُمْ للسُّمْرِ في الهَجياءِ",8,"ا",2,0],["والمتعبون أمانةٌ أودعتها","بضميره وسيخسأُ الخوّانُ",9,"ن",1,0],["والمُتجبى الحسن الزاكي أخوهُ له","نور تَشَعشع في أفقِ الجلال جلي",10,"ل",2,0],["والمتقي ومضى بالخَلعِ منسملاً","من بعدِ أربعة الأعوامِ في صفرا",11,"ر",2,0],["والمتعدّي ينصب المفعول به","بنفسه لم نائما لينتبه",12,"ه",1,0],["والمتعدي بعد هاء ساكنه","يزيد في البيت عن الموازنه",13,"ه",1,0],["والمتبّع البرّ بالأوفى تَرى أَبداً","أَجرى أَياديه أَوفاهن رُجحانا",14,"ن",2,0],["وألمت به المنية يوما","تطلب الروح من كريم جوادِ",15,"د",1,0],["وألمَّت لا لتمحيصِ اللمم","بمقام البيتِ لكن طَلَبا",16,"ب",2,0],["وَالمترع الحَوض المدعدع حَيث لا","حَوض يَفيض وَلا قَليب يَترع",17,"ع",1,0],["والمتقارب الذي بها وزن","على فعولن بثمان قد قرن",18,"ن",1,0],["والمترفون لزامهم سفهٌ","ولك الخيار فوالِ أوولِّ",19,"ل",1,0],["وآلمت قلباً مخلصاً لك ممحضاً","بودك موصول العرى والعلائق",20,"ق",1,0],["والمترع الأرض من كفيه غيث ندى","إذا غدا القطر لم يهطل من السحب",21,"ب",1,0],["والمترعُ الحوضِ المدَعدعِ حَيثُ لا","وادٍ يفيضُ ولا قليبٌ يترعُ",22,"ع",1,0],["والمتقي يروي، عليك ب (كنزه)","إن اللآلي في الكنوز لناصعة",23,"ع",2,0],["والمترفون من الأذى سلِمُوا","دنياهمُ ما مثلُها اعتدلت",24,"ت",1,0],["والمترف اللي عليه بفكرتي سآرح","بآكر بيفهم وش اللي صآيبٍ خلّه",25,"ل",2,0],["وَآلَمَتْنِي رُؤى الآمالِ بَدَّدَها","غُلْبُ الرِّقَابِ، ظِمَاءٌ، بَلْ مَجَالِيْحُ",26,"ح",1,0],["والمِتْجَرُ الضَّخْمُ مَقْفُولٌ وصاحِبُهُ","مُسَلَّحٌ لِعيال الليلِ يَنْتَظِرُ",27,"ر",1,0],["والمتعبون شفاههم","خبرٌ يبيتُ مكسّرا",28,"ر",2,0],["والمترف اللي في ثرى قلبي زرع بذرة غلاه","جاني بعد مدة يدور وين راحت بذرته!!",29,"ت",2,0],["وآلمته وزادت من توجّعه","حتى نراه كأنّا ما عرفناه",30,"ا",2,0]]}