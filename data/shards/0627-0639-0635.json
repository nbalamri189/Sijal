{"poems":[[63,"أعصر الحمى عد والمطايا مناخة","https://www.aldiwan.net/poem45780.html","الطويل"],[42,"أعصيت أمر ذوي النهى","https://www.aldiwan.net/poem50355.html","مجزوء الكامل"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[61,"ظهر الهوى وتهنكت أستاره","https://www.aldiwan.net/poem51298.html","الكامل"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/999","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141959","الخفيف"],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[107,"أعصابة الشوق التي","https://www.aldiwan.net/poem16488.html","مجزوء الكامل"],[158,"من سلب الدهر رد أشبابه","https://www.aldiwan.net/poem58893.html","الرجز"],[209,"يا نجوم الفنون والدهر ليل","https://www.aldiwan.net/poem46602.html","الخفيف"],[254,"أعصر شبيبتي قف لي قليلا","https://www.aldiwan.net/poem48352.html","الوافر"],[266,"اعص النساء فتلك الطاعة الحسنه","https://www.aldiwan.net/poem69122.html","عموديه"],[344,"إعص العواذل وارم الليل عن عرض","https://www.aldiwan.net/poem24150.html","الكامل"],[390,"أما رأيت الدمع مسجوما","https://www.aldiwan.net/poem53664.html","السريع"],[406,"من زين الأقحوان الرطب بالشنب","https://www.aldiwan.net/poem32614.html","البسيط"],[407,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[407,"إعص الهوى وتعز عن سعداكا","https://www.aldiwan.net/poem67488.html","الكامل"],[484,"نُبئت أنك جئت تسري","https://www.aldiwan.net/poem456.html",""]],"verses":[["أَعصَرَ الحِمى عُد وَالمَطايا مُناخَةٌ","بِمَنزِلَةٍ جَرداءَ ضاحٍ مَقيلُها",0,"ه",2,1],["أَعَصَيتَ أَمرَ ذَوي النُهى","وَأَطَعتَ أَمرَ ذَوي الجَهالَه",1,"ل",2,1],["أعصير خمرك هذه","من ماء خدك أم عصيرُ",2,"ر",1,0],["أعصي العواذل في هواه جهارة","فألذ عيش المستهام جهاره",3,"ه",1,0],["أَعصَمَت نَفسُ اِمرِئٍ عَلِقَت","مِنهُ بِالوُثقى مِنَ العِصَمِ",4,"م",1,0],["أعصي رِماحَ الخطِّ دونكِ شُرّعاً","وأُطِيعُ فيكِ صَبابَةً وغَليلا",5,"ل",2,0],["أَعصي الهَوى وَأُطيعُ الرَأيَ في وَلَدٍ","بَعدَ النَصيحَةِ رابَت مِنهُ أَخلاقُ",6,"ق",1,0],["اعصفي في النفوس أنشودة الأمس","فتمشي إلى المكارم عجلى",7,"ل",2,0],["أعصيرَ الكروم يا نيلُ تحوي","أم لعاب الحياتِ والأُفعوان؟",8,"ن",1,0],["أَعصابة الشَوق الَّتي","شَب الجَوى بِضُلوعِها",9,"ع",3,1],["اعص الهوى فإن من أطاعه","جنى به الشر على جنابه",10,"ب",2,0],["أعصرٌ قد مضت وأنتم بعصر","سادر في ضلاله مجنون",11,"ن",1,0],["أعصر شبيبتي قف لي قليلاً","أناشدك المودة أن تحولا",12,"ل",2,1],["اعص النساء فتلك الطاعة الحسنه","ولن يسود فتى أعطى النسا رسنه",13,"ه",1,1],["إِعصِ العَواذِلَ وَاِرمِ اللَيلَ عَن عُرُضٍ","بِذي سَبيبٍ يُقاسي لَيلَهُ خَبَبا",14,"ب",2,1],["أَعصِم بِحَبلِ اللَهِ ذا رِفعَةٍ","عَلَّكَ أَن تَلقاهُ مَرحوما",15,"م",2,0],["أعْصِي النّصيحةَ فيها غيرَ مُعتَذِرٍ","وأَركبُ الغَيَّ عمداً غير مُتَّئِبِ",16,"ب",1,0],["أُعصِمَت مِنكُمُ نِزارٌ بِحَبلٍ","لَم يُريدوا بِغَيرِهِ اِستِمساكا",17,"ك",2,0],["إِعصِ الهَوى وَتَعَزَّ عَن سُعداكا","فَلَمِثلُ حِلمِكَ عَن هَواكَ نَهاكا",18,"ك",2,1],["أَعَصيَمَ لا تَجزَع فَإِنَّ ال","حَربَ لَيسَت بِالدُعابَه",19,"ب",2,0]]}