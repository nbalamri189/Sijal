{"poems":[[65,"أعصر الحمى عد والمطايا مناخة","https://www.aldiwan.net/poem45780.html","الطويل"],[44,"أعصيت أمر ذوي النهى","https://www.aldiwan.net/poem50355.html","مجزوء الكامل"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[63,"ظهر الهوى وتهنكت أستاره","https://www.aldiwan.net/poem51298.html","الكامل"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/999","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141959","الخفيف"],[108,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[113,"أعصابة الشوق التي","https://www.aldiwan.net/poem16488.html","مجزوء الكامل"],[164,"من سلب الدهر رد أشبابه","https://www.aldiwan.net/poem58893.html","الرجز"],[215,"يا نجوم الفنون والدهر ليل","https://www.aldiwan.net/poem46602.html","الخفيف"],[261,"أعصر شبيبتي قف لي قليلا","https://www.aldiwan.net/poem48352.html","الوافر"],[273,"اعص النساء فتلك الطاعة الحسنه","https://www.aldiwan.net/poem69122.html","عموديه"],[351,"إعص العواذل وارم الليل عن عرض","https://www.aldiwan.net/poem24150.html","الكامل"],[398,"أما رأيت الدمع مسجوما","https://www.aldiwan.net/poem53664.html","السريع"],[415,"من زين الأقحوان الرطب بالشنب","https://www.aldiwan.net/poem32614.html","البسيط"],[416,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[416,"إعص الهوى وتعز عن سعداكا","https://www.aldiwan.net/poem67488.html","الكامل"],[491,"نُبئت أنك جئت تسري","https://www.aldiwan.net/poem456.html",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122696","الكامل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138932",""],[881,"","https://poetry.dctabudhabi.ae/diwan/poem/21189","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77397","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200888","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202588","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204640","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87561","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132002","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216510","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131014",""],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81930","الكامل"],[4778,"بان الفساد","https://www.poetsgate.com/ViewPoem.aspx?id=191349",""],[4804,"يا قصر ذا النخلات من بارا","https://www.poetsgate.com/ViewPoem.aspx?id=92094",""],[4883,"شيطنه","https://www.poetsgate.com/ViewPoem.aspx?id=48375",""],[5055,"عين زمزم","https://www.poetsgate.com/ViewPoem.aspx?id=103655",""],[5092,"عزفٌ على وتر الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=176564",""],[5092,"هزَّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190578",""],[5137,"أنتِ التي أهواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=101521",""],[5409,"حياك وادي الرافدين وما به","https://www.poetsgate.com/ViewPoem.aspx?id=155250",""],[5431,"لاسلمَ في عرْفِ الهوى لأسايره","https://www.poetsgate.com/ViewPoem.aspx?id=192058",""],[5612,"مَوْلايَ رغْمَ جَهالَتي يُعْطيني","https://www.poetsgate.com/ViewPoem.aspx?id=179819",""],[5725,"ايها الناظم المخانق عقدا","https://www.poetsgate.com/ViewPoem.aspx?id=213048",""],[6056,"شيخة القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=130570",""]],"verses":[["أَعصَرَ الحِمى عُد وَالمَطايا مُناخَةٌ","بِمَنزِلَةٍ جَرداءَ ضاحٍ مَقيلُها",0,"ه",2,1],["أَعَصَيتَ أَمرَ ذَوي النُهى","وَأَطَعتَ أَمرَ ذَوي الجَهالَه",1,"ل",2,1],["أعصير خمرك هذه","من ماء خدك أم عصيرُ",2,"ر",1,0],["أعصي العواذل في هواه جهارة","فألذ عيش المستهام جهاره",3,"ه",1,0],["أَعصَمَت نَفسُ اِمرِئٍ عَلِقَت","مِنهُ بِالوُثقى مِنَ العِصَمِ",4,"م",1,0],["أعصي رِماحَ الخطِّ دونكِ شُرّعاً","وأُطِيعُ فيكِ صَبابَةً وغَليلا",5,"ل",2,0],["أَعصي الهَوى وَأُطيعُ الرَأيَ في وَلَدٍ","بَعدَ النَصيحَةِ رابَت مِنهُ أَخلاقُ",6,"ق",1,0],["اعصفي في النفوس أنشودة الأمس","فتمشي إلى المكارم عجلى",7,"ل",2,0],["أعصيرَ الكروم يا نيلُ تحوي","أم لعاب الحياتِ والأُفعوان؟",8,"ن",1,0],["أَعصابة الشَوق الَّتي","شَب الجَوى بِضُلوعِها",9,"ع",3,1],["اعص الهوى فإن من أطاعه","جنى به الشر على جنابه",10,"ب",2,0],["أعصرٌ قد مضت وأنتم بعصر","سادر في ضلاله مجنون",11,"ن",1,0],["أعصر شبيبتي قف لي قليلاً","أناشدك المودة أن تحولا",12,"ل",2,1],["اعص النساء فتلك الطاعة الحسنه","ولن يسود فتى أعطى النسا رسنه",13,"ه",1,1],["إِعصِ العَواذِلَ وَاِرمِ اللَيلَ عَن عُرُضٍ","بِذي سَبيبٍ يُقاسي لَيلَهُ خَبَبا",14,"ب",2,1],["أَعصِم بِحَبلِ اللَهِ ذا رِفعَةٍ","عَلَّكَ أَن تَلقاهُ مَرحوما",15,"م",2,0],["أعْصِي النّصيحةَ فيها غيرَ مُعتَذِرٍ","وأَركبُ الغَيَّ عمداً غير مُتَّئِبِ",16,"ب",1,0],["أُعصِمَت مِنكُمُ نِزارٌ بِحَبلٍ","لَم يُريدوا بِغَيرِهِ اِستِمساكا",17,"ك",2,0],["إِعصِ الهَوى وَتَعَزَّ عَن سُعداكا","فَلَمِثلُ حِلمِكَ عَن هَواكَ نَهاكا",18,"ك",2,1],["أَعَصيَمَ لا تَجزَع فَإِنَّ ال","حَربَ لَيسَت بِالدُعابَه",19,"ب",2,0],["أعَصَرتَها مِن وجنتَيكَ شَقيقاً","وَمَزَجتَها مِن مَلمَظَيِكَ رَحيقا",20,"ق",2,1],["أعصى الملام ولا منام يطيعني","فكأن أذني العين واللوم الكرا",21,"ر",2,0],["أَعصِ العَواذِل وَاِرمِ اللَيلَ عَن عُرُضٍ","بِذي شَبيبٍ يُقاسي لَيلَهُ جَبَبا",22,"ب",2,1],["أعصى الله تراه المصطفى","وأطاع الله إبليس المصر",23,"ر",1,0],["أَعَصرَ النورِ بَل عَصرَ الظَلامِ","كَفَرتَ بِأَنعُمِ اللَهِ الجِسامِ",24,"م",1,1],["أعصِرُ العمرَ باحثا عن شبابي","عصرك الكأس باحثاً عن شراب",25,"ب",1,1],["أعصابه غلظت فلو رجيته","لحسبت نفسك في صفاةٍ تنحت",26,"ت",1,0],["اعصري أنت عصر النور لكن","ورثت جميع أوهام العصور",27,"ر",1,0],["أعصاكَ في شيءٍ فَقال وَكَيفَ لا","أَوَ ما سمعتم كَم أَقولُ لَهُ انطِقِ",28,"ق",1,0],["أعصا موسى أم السحر الذي","عند هارون تجلى للورى",29,"ر",2,0],["أعصيك أعصيك لا آلوك معصيةً","ولست أعصي جمالاً فيك يحييني",30,"ن",2,0],["أعصركم عصر الرقي وبالدما","مشارقه مخضوبة والمغارب",31,"ب",1,0],["أعصر رشاد أنت للدهر حلبة","ومنك نعيم للأنام متمّم",32,"م",1,0],["أعصاه طرفك أم أباح بسره","لمَّا أسال بدمعه المتحادر",33,"ر",1,0],["إعصار ارما شمال الأرض أغرقها","وفي الجنوب نرى الروهانج قد حُرقوا",34,"ق",3,0],["أعصي النصيح وكل عاذلةٍ","وأطيع أوتاراً ومزمارا",35,"ر",2,0],["اعصي غلاها الرقيق العذب واطيع","ابوها فاحيان واحياناً ولدها!",36,"د",3,0],["أعصم غراب اليوم دامك تحاتيه","والشيخ دله (عين زمزم ) دراية",37,"ا",3,0],["أعصرهُ من غصنِ فؤادي","وبناتُ الشعرِ لهُ عَصَروا",38,"ر",3,0],["أعْصِرُ الأيامَ في كَبدي","ذاقَ طعمَ المرَّ مَنْ عَصَرا",39,"ر",2,0],["إعصارُ حُبكِ فى الفؤادِ كما بَدَتْ","شمسُ الحقيقةِ فى بديعِ سماكِ",40,"ك",1,0],["أعصابةٌ بجنيف أم هي عصبةٌ","تكفي نعاج الشرق شر ذئابه",41,"ب",2,0],["اعصار عشقيَ باترٌ ومخلّعٌ","يمضي ويترك بالضلوع حوافره",42,"ر",2,0],["أعْصاهُ في وَضَحِ النَّهارِ وفي الدُّجى","وهو الحليمُ لبابهِ يدْعوني",43,"ن",2,0],["أعصر العمر بالترائب خمرا","يستفزّ الربيع عطراً ووردا",44,"د",2,0],["أعصر الماء من اليابس وأنشّف أخضرالأوراق","على صوت ٍ سحب من داخل الوجدان وناته",45,"ت",2,0]]}