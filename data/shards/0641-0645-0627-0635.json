{"poems":[[55,"سليمان دلتني يداك على الغنى","https://www.aldiwan.net/poem29869.html","الطويل"],[65,"أثرها فما دون الصرائم حاجز","https://www.aldiwan.net/poem46169.html","الطويل"],[65,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[29,"متى تغمز ذراع مجاشعي","https://www.aldiwan.net/poem5999.html","الوافر"],[74,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[91,"يراع صنانيد الكتابة كالعضب","https://www.aldiwan.net/poem44643.html","الطويل"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[64,"وكنت أراني مفلتا شرك الهوى","https://www.aldiwan.net/poem52468.html","الطويل"],[46,"لم يبق للصيف لا رسم ولا طلل","https://www.aldiwan.net/poem29688.html","البسيط"],[46,"مهاة النقا لولا الشوى والمآبض","https://www.aldiwan.net/poem30473.html","الطويل"],[107,"منايا القوم في جلد البعير","https://www.aldiwan.net/poem44061.html","الوافر"],[41,"أسرناهم وأنعمنا عليهم","https://www.aldiwan.net/poem53720.html","الوافر"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[77,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[52,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[52,"أعاذل إن لومك في تباب","https://www.aldiwan.net/poem64852.html","الوافر"],[48,"عبيط ضوائن نحير جزر","https://www.aldiwan.net/poem22680.html","الوافر"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54984","الوافر"],[50,"","https://poetry.dctabudhabi.ae/diwan/poem/4133","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67286","الوافر"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[82,"حُجبتَ فلا والله ما ذاك عن أمري","https://www.poetsgate.com/ViewPoem.aspx?id=3290",""],[136,"فما صوت جليت مع القوم في الند","https://www.aldiwan.net/poem54847.html","الطويل"],[136,"ألا أيها الأخوان أهل التأدب","https://www.aldiwan.net/poem54879.html","الطويل"],[141,"أسلمى تلك حييت","https://www.aldiwan.net/poem68027.html","الهزج"],[164,"أعندك علم أم أقول فأطرب","https://www.aldiwan.net/poem58761.html","الطويل"],[215,"تحدثت بالهتاف أنك حاضر لإيناس","https://www.aldiwan.net/poem46315.html","الطويل"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[236,"سلكت طريق الفقر ظنا بأنني","https://www.aldiwan.net/poem44560.html","الطويل"],[254,"كفى بالنأي من أسماء كافي","https://www.aldiwan.net/poem2105.html","الوافر"],[275,"لقد ذهبت تلك الأماني الخوادع","https://www.aldiwan.net/poem35239.html","الطويل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[276,"دم المحب على الاطلال مطلول","https://www.aldiwan.net/poem52067.html","البسيط"],[276,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[376,"أتاني عنك إخوانك","https://www.aldiwan.net/poem57037.html","الهزج"],[385,"أمن بعد ما بان الفريق وأدلجا","https://www.aldiwan.net/poem48769.html","الطويل"],[409,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[420,"أقمنا لهم عرض الشمال فكبكبوا","https://www.aldiwan.net/poem4482.html","الطويل"],[435,"بدا ينجلي تحت الغلالة والبرد","https://www.aldiwan.net/poem40517.html","الطويل"],[438,"ثنت عنك يوم الرحيل العنانا","https://www.aldiwan.net/poem12741.html","المتقارب"],[443,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[445,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[447,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[447,"رأيت الزمان وإخوانه","https://www.aldiwan.net/poem14395.html","المتقارب"],[473,"أيا من لي بمربطه رجاء","https://www.aldiwan.net/poem59899.html","الوافر"],[519,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[534,"بضع وخمسون مرت","https://www.aldiwan.net/poem37072.html","المجتث"],[543,"ألم به الوشي فأعرض هازئا","https://www.aldiwan.net/poem47505.html","عموديه"],[556,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[568,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[608,"","https://poetry.dctabudhabi.ae/diwan/poem/93485","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122710","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122618","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122572","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87083","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130206","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48823","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64109","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38131","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16935","الطويل"],[1299,"","https://poetry.dctabudhabi.ae/diwan/poem/203401","المنسرح"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82313","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128074","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101070","الطويل"],[1745,"","https://poetry.dctabudhabi.ae/diwan/poem/111592","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26479","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103206","الطويل"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139331",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53118","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53236","البسيط"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[2679,"","https://poetry.dctabudhabi.ae/diwan/poem/122392","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76081","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200031","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115778","المتقارب"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115538","المتقارب"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103198","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68017","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89048","الطويل"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138535",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108331",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45803","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118744","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77024","الوافر"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143862","الهزج"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132184","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119609","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136619",""],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104513","الهزج"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138828",""],[4472,"","https://poetry.dctabudhabi.ae/diwan/poem/144575","المنسرح"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136383",""],[4655,"","https://poetry.dctabudhabi.ae/diwan/poem/140190",""],[4815,"إربد في زمن الكورونا (الأقحوانة)","https://www.poetsgate.com/ViewPoem.aspx?id=211062",""],[4954,"كَفاني قَريضي مُؤْنِسًأ","https://www.poetsgate.com/ViewPoem.aspx?id=207724",""],[5187,"بوم النصر","https://www.poetsgate.com/ViewPoem.aspx?id=29242",""],[5314,"خلجات","https://www.poetsgate.com/ViewPoem.aspx?id=214746",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5376,"تُهانُُ القدسُ ما فيكم مروءةْ","https://www.poetsgate.com/ViewPoem.aspx?id=203293",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[5873,"حصون العز","https://www.poetsgate.com/ViewPoem.aspx?id=215408",""],[5956,"الإعجابُ والحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=182655",""],[5956,"خشيت من الخروج إلى المروج","https://www.poetsgate.com/ViewPoem.aspx?id=201543",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["فَما صِرتُ حَربَ الدَهرِ حَتّى رَأَيتُهُ","يُحارِبُ مَن أَمسى وَأَصبَحَ مُرمِلا",0,"ل",2,0],["فما صَدَقَتْ عنكَ القَوابِلُ وانْثَنَتْ","تَذُمُّ شُيوخَ الحَيِّ فيكَ العَجائِزُ",1,"ز",1,0],["فَما صَحْبُهُ الأدْنَوْنَ غيرَ صَوارِمٍ","ولا رَهْطُهُ الأعْلَوْنَ غيرَ كَواكِبِ",2,"ب",1,0],["فَما صَدَقَ اللِقاءَ مُجاشِعِيٌّ","وَما جَمَعَ القَناةَ مَعَ اللِجامِ",3,"م",1,0],["فما صغروا وبه كبروا","ولا كبّروا وبه صُغروا",4,"ر",3,0],["فما صُنعُ عبدٍ في قضاء مليكهِ","وتقديرهِ وهْو المدينُ المحوَّلُ",5,"ل",1,0],["فما صد عن نصر الحقيقة يونسا","وعيد ولا نحاه وعد عن الذب",6,"ب",1,0],["فما صرخت صرخة","بل قد ذهبت فرخة",7,"ه",1,0],["فما صفقتي في البيعِ صفقةُ خاسرٍ","ولا بيعتي للحب بيعةُ ناكثِ",8,"ث",1,0],["فَما صِلائِيَ إِن كانَ الصِلاءُ بِها","جَمرَ الغَضا الجَزلِ إِلّا السَيرُ وَالإِبلُ",9,"ل",1,0],["فَما صُقِلَ السَيفُ اليَماني لِمَشهَدٍ","كَما صُقِلَت بِالأَمسِ تِلكَ العَوارِضُ",10,"ض",1,0],["فما صَدقوا النبيَّ ولا استحبُّوا","سِوى الطمعِ المخيِّبِ والغُرورِ",11,"ر",1,0],["فَما صَبَروا لِبَأسٍ عِندَ حَربٍ","وَلا أَدَّوا لِحُسنِ يَدٍ ثَوابا",12,"ب",2,0],["فما صَنَعَتْ عادٌ مَصانِعَ مِثلَهُ","وَلا طاوَلَتْهُ في البِناءِ قُصُورُ",13,"ر",1,0],["فما صَفا الجوُّ فيها منذُ غِبتَ ولا","له انفِراجٌ إلى حيّ من العَرَبِ",14,"ب",1,0],["فَما صاحِبِيَ الحَيُّ","وَلَكِن صاحِبي المَيتُ",15,"ت",1,0],["فَما صَدَروا بِقَرفِهِمُ سُلَيمى","وَلا أَعتَبتُهُم عَمدَ العِتابِ",16,"ب",1,0],["فَما صُنعي تُمِرُّ يَدايَ شَزَراً","وَتَنقِضُ مِرَّةُ الأَيّامِ شَزري",17,"ر",2,0],["فَما صادِياتٌ حُمنَ يَوماً وَلَيلَةً","عَلى الماءِ دونَ الوِردِ هُنَّ حَواني",18,"ن",2,0],["فمَا صَدَقُوا وَغَيْرُكَ مَنْ عَنَوهُ","بِقَوْلِهِمْ أُحِيلَ إِلى المَعاِشِ",19,"ش",1,0],["فَما صاحِبي إِلّا فَتىً جَمجَمَت بِهِ","أَبِيَّةُ نَفسٍ عَن قُبولِ مُلامِ",20,"م",1,0],["فما صَفِرتْ عيابُ بني كلابٍ","ولا القُرَطَاءُ مِنْ ذمِّ الوفاءِ",21,"ا",2,0],["فما صحيفة صفين التي رقمت","إلا صحيفة بين الركن والحجر",22,"ر",1,0],["فما صار إخلال المكارم لي هوى","ً ولا دار إخجالٌ لمثلكَ في صدري",23,"ر",2,0],["فَمَا صَوتُ جِلِّيتٍ مَعَ القَومِ في النِّدِ","تُقَلِّبُ قَصباً مِن عَقِيمِ الزَّبَرجَدِ",24,"د",1,1],["فما صدرت لِي بامتحاني ذِلَّةٌ","ولَكن قَضَى قَاضِيهِ لِى بالتَّغَلُّبِ",25,"ب",1,0],["فَما صَهباءُ لَم تُكسَ","قَذىً مِن خَمرِ بَيروتِ",26,"ت",1,0],["فما صحَ عن هذا وذاك فإِنني","أرى كل يومٍ لي كذلك يوهبُ",27,"ب",1,0],["فما صح حلم في هواك ولا انتهت","على اليأس موجات الدموع الدوافق",28,"ق",1,0],["فما صبركم أنتم وبيني وبينكم","خطى هيناتٌ قد يقدّرن بالعد",29,"د",1,0],["فما صح لي فقر وما صح لي غنى","بل ازددت في علم التقلب تعريفا",30,"ف",2,0],["فَما صَدعٌ بِجُبَّةَ أَو بِشوطٍ","عَلى زُلُقٍ زَوالِقَ ذي كَهافِ",31,"ف",1,0],["فما صدَقت بالخبرِ أخبارُ كاذبٍ","وذلكَ طيفٌ زَخرَفتهُ المضاجع",32,"ع",1,0],["فما صدّ أعداءً ولا سدَّ ثغرةً","سوى بارجاتٍ كالبروجِ اشمخرّت",33,"ت",1,0],["فَما صَريح ومبنى ومطرد","وَما دَليل وَتَعليل وَتأَصيل",34,"ل",1,0],["فَما صدني من بعدكم بعد منزلي","وَلا خوف قطع من ظَلام الشَدائد",35,"د",1,0],["فما صدَّقتُهم مِن فَ","رحٍ فيما يَقولُونا",36,"ن",2,0],["فَما صافَحَت بَحر القَوافي نَسيمُهُ","لِكَف الصِبا إِلّا طَما وَتَموَجا",37,"ج",2,0],["فما صباحي سوى لقيا كتابكم","عنوانه أول الإِصباح في السحر",38,"ر",1,0],["فما صبروا للحرب عند قيامها","صبيحة يسمو بالرجال أبو بكر",39,"ر",1,0],["فما صفخة الياقوت تحت زمردٍ","بأحسن من آس العذار على الخدِ",40,"د",1,0],["فما صدَّ ذلك عزمي بها","ولا راعَ ذلك مني الجَنانا",41,"ن",2,0],["فما صاحفحت بيض الصفاح ككفّه","ولا حملت ذاك الطهمة الجرد",42,"د",1,0],["فما صَدَّني عن مُلتَقى الغِيلِ ضيغَمٌ","ولا راعَني فِي مَورِدِ الماءِ تِمساحُ",43,"ح",1,0],["فما صحبت أخاً إلا وجدت به","ختيلة الفهد أو مبلولة النلب",44,"ب",1,0],["فما صان عرضك إلا فتى","إذا سيم في عرضه صانه",45,"ن",2,0],["فَما صَبري عَلَيكَ وَأَنتَ مَحلٌ","إِذا ما كانَ غَيرُكَ لي رَبيعا",46,"ع",2,0],["فما صارَ شيءٌ من عِداهُ بأرضِه","سِوى ما سَرى من لحمِهم في الحَواصِلِ",47,"ل",1,0],["فما صهوة إلا وقد مل سرجها","ولا ذرة إلا وقد مال كورها",48,"ر",3,0],["فما صَنَعْتَ وَمَاذَا","تَقُولُهْ لِلْعَلِيِّ",49,"ي",1,0],["فما صدَّني خبثُ النُّفوسِ مِنَ أهلِهَا","وخُبثُ النفُوسِ الدَّاءُ مالَه مِن دَوَا",50,"و",2,0],["فما صدّقوا حتّى رأوا جانب الفَلا","يفيض رجالاً نُسَّلاً وخيولا",51,"ل",2,0],["فَما صانَ حِبراً عِلمُهُ وَكِتابُهُ","وَلا مَلِكاً أَعلامُهُ وَكَتائِبُه",52,"ب",2,0],["فَما صَفا لامرِئٍ عَيشٌ يُسَرُّ به","إلا سيتبَعُ يوما صَفوَه كَدَرُ",53,"ر",1,0],["فَما صُنتُ نَفسي عَن قِتالِ عَدُوِّكُم","وَما قُلتُ مالي في أمُورِكُمُ دَخلُ",54,"ل",1,0],["فما صَرَّفتُما قدحاً وراحا","على النُّدَماءِ بل نُوراً ونارا",55,"ر",2,0],["فما صَلُح الصَّلاحُ لغير جَدوَى","أبي موسى ولا فَسَدَ الفَسادُ",56,"د",1,0],["فَما صادِراً يَدري وَلا وارِداً لَهُ","بِهِ خبرةٌ سل عَنهُ أَيّ غلام",57,"م",1,0],["فَما صانَ وَجهاً كَالكِرام لِأَنَّهُ","لَئيمٌ مهين مِن نتاج لئام",57,"م",1,0],["فما صرفوا فضلي وما ارتحل المجد","هموم واحزان وحط ورحلة",58,"ه",1,0],["فما صال أحرارها بالحديد","ولا النار في حومة أضرموا",59,"م",3,0],["فما صدودكَ عن كاسِ السلوِّ إذا","ما كنتَ لابدَّ أنْ يَسقيكها السَّاقي",60,"ق",2,0],["فَما صالَ إِلّا وَالأُسودَ رأيتَها","فَمِن مَيّتٍ يَبدو وَآخرَ هارِبِ",61,"ب",1,0],["فَما صَحِبَتهُ لِلأَنامِ صَنيعَةٌ","وَيَصحُبُهُم مِنهُ وَفيهِ صَنائِعُ",62,"ع",1,0],["فما صفا بُرْهَةٌ لذي أدبٍ","ولم يُبلّغه منتَهَى الأرَبِ",63,"ب",1,0],["فَما صَفراءُ تُكنَى أُمَّ عَوفٍ","كَأَنَّ رُجَيلَتَيها مِنجَلانِ",64,"ن",1,1],["فما صان منها صاحب الحصن نفسه","ولاصاحب الدرع المقدر في السرد",65,"د",1,0],["فما صفوات العيش لو عقل الورى","سوى أمل نطوي عليه الليالي",66,"ي",1,0],["فما صدعت الا حشا متصدعا","ولا هيجت الافؤاداً مهيجا",67,"ج",2,0],["فَما صُنتُ وَجهي عَن ظُباتِ سُيوفِهِم","وَلا اِنحَزتُ عَنهُم وَالقَنا تَتَكَسَّرُ",68,"ر",1,0],["فما صَقرُ حجاجِ بنِ يوسَفَ ممسكاً","بأسرَعَ منّي لَمحَ عَينٍ بحاجبِ",69,"ب",1,1],["فَما صَلحت إلاّ لجودٍ أكفهُم","وأرجلهم إلاّ لأعوادِ منبر",70,"ر",1,0],["فما صلاح الدين بالقَصُور","عن غاية المجد ولا المنزور",71,"ر",1,0],["فما صفات ملوك الأرض قاطبة","في حيث مختطرات من أسانيها",72,"ي",3,0],["فما صادفت في قحطان مثلي","ولا صادفت مثلك في معد",73,"د",1,0],["فما صرفت كفّ المنية إذ أتت","مبادرة تهوي إليها الذخائر",74,"ر",1,0],["فَما صحَّ عِندي غَيرُ أَني مُقصِّرٌ","وَقَد فاتَنا مِنه كثيرٌ وأَعيانا",75,"ن",2,0],["فما صدقت نفسي الشفاه بلثمها","وقلت لعل السكر مثّل لي الوصلا",76,"ل",2,0],["فما صافحوا غير بيض الصفاح","ولا عانقوا غير سمر القنا",77,"ن",2,0],["فما صحَّ لي بعده صِحّةٌ","وإن لمي زرني فبرئي عسر",78,"ر",1,0],["فما صفراء تدعى أم عوف","كأن رجيلتيها منجلان",79,"ن",1,0],["فما صدقتْ أَذْني ولا كَذَّب الهوى","ولا صَدِئتْ عيني بغير المَدامع",80,"ع",1,0],["فما صائلٌ لاقاه في حومة الوغى","ولا واصل ساواه والحرب تصهد",81,"د",1,0],["فما صدك الإيذاء منها ولا الهوى","ولا عن هداك المستبين صدودها",82,"د",3,0],["فما صدرا إلا من الود والجوى","وكان بشأن السبط أدرى وأخبرا",83,"ر",2,0],["فما صنعوا أو حاولوا كان مصدراً","لما كابدت ابناؤها من ذوي الغدر",84,"ر",1,0],["فما صادني جيداءُ رائعة اللمى","كما صادني لطفٌ به اللب يخلب",85,"ب",1,0],["فَما صلتم إِلّا وَصلتُم لِغاية","يَقصر عَنها في العُلا كُلُ طائل",86,"ل",1,0],["فما صدّني عن وصلها بأس قومها","وقد حجبوها من قنا الخط في خدر",87,"ر",1,0],["فما صبروا لوقعِ سيوفِ قومٍ","كفَوها بالكفاح من الصِّقال",88,"ل",1,0],["فما صبروا لشدتنا ولكن","تولوا مجهضين عن القتال",88,"ل",1,0],["فَما صَبري وَإِن يَعظُم جَميلاً","لِما اِستَمسَكتُ في حُبي بَعروه",89,"و",2,0],["فما صدقت حتى قل","ت للشيخ وقد أطرق",90,"ق",1,0],["فما صافحت كفي أكفاً بخيلة","على الوسع والاقلال من يوم مولدي",91,"د",2,0],["فما صار حقاً إلى حضرة","ولا حل فيها ولا أقبرا",92,"ر",2,0],["فما صَدحت لولا هَواه بَلابلٌ","ولا سَهرت عَيني وهاجتَ بلابلي",93,"ل",2,0],["فما صنعك بالحور","إذا لم يك ولدان",94,"ن",1,0],["فما صال بالأبطال إلا تفرّقوا","حِذارَ الرَّدى من بأسِهِ وتمزّقوا",95,"ق",3,0],["فما صَرمتمْ تَصارمت لكُمُ","منّا بوصل السُّهاد أجفان",96,"ن",1,0],["فما صده عن خطة العدل ذو هوى","وما مال في اثبات حق لباطل",97,"ل",1,0],["فما صبروا في حومة الموت ساعة","لحد الرماح والسيوف الصوارم",98,"م",1,0],["فما صِيبَ مَيْتٌ بداءٍ وَ ما ما _","تَ بالدَّاءِ مَن فيهِ ذي الروحُ حَيَّهْ",99,"ي",2,0],["فما صادَفتْ منّي شقاءً ولا شجًا","فيا دهْرُ أنْصِفْ قدْ عدِمْتُ الْمهانِيَا",100,"ي",2,0],["فما صهيونُ عمَّرها قديماً","ولا تركوا بها أثراً يُزارُ",101,"ر",1,0],["فما صعودك لي إلا النجاح وما","وما تنازلي لك إلا محض إخفاقي",102,"ق",2,0],["فما صح بعد الاجتماع اختلافهم","وكيف وقد كانوا جميعاً ذوي رشد",103,"د",1,0],["فما صهيونُ ينفَعُكم بمكرٍ","ومكرُ اللهِ لم تأمنْ مجيئهْ",104,"ا",2,0],["فَما صَرَّحَتْ رَدَّ السَّلامِ كأَنَّما","عَلَيْها لَنا رَدُّ السَّلامِ حَرامُ",105,"م",1,0],["فما صدعت كبدي لوعة","كلوعة ثكلك يا نفنف",106,"ف",1,0],["فما صدق الغرام من ادّعاه","إذا من سكره يوماً أفاقا",107,"ق",2,0],["فما صوَّر الرحمن أعذب منطق","ومَوْسَقَهُ لو عُشرَ حُسْن رنينها",108,"ن",3,0],["فما صادفتُ من أحدٍ نصيحاً","سوى بالزهرِ محرومِ الأريجِ",109,"ج",1,0],["فما صُراخُكَ في الأبوابِ يعطفُهُ","ولا سجودُكَ في الأعتاب يُرضيهِ",110,"ي",2,0]]}