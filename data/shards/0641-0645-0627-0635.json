{"poems":[[53,"سليمان دلتني يداك على الغنى","https://www.aldiwan.net/poem29869.html","الطويل"],[63,"أثرها فما دون الصرائم حاجز","https://www.aldiwan.net/poem46169.html","الطويل"],[63,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[27,"متى تغمز ذراع مجاشعي","https://www.aldiwan.net/poem5999.html","الوافر"],[72,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[89,"يراع صنانيد الكتابة كالعضب","https://www.aldiwan.net/poem44643.html","الطويل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[62,"وكنت أراني مفلتا شرك الهوى","https://www.aldiwan.net/poem52468.html","الطويل"],[44,"لم يبق للصيف لا رسم ولا طلل","https://www.aldiwan.net/poem29688.html","البسيط"],[44,"مهاة النقا لولا الشوى والمآبض","https://www.aldiwan.net/poem30473.html","الطويل"],[105,"منايا القوم في جلد البعير","https://www.aldiwan.net/poem44061.html","الوافر"],[39,"أسرناهم وأنعمنا عليهم","https://www.aldiwan.net/poem53720.html","الوافر"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[75,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[50,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[50,"أعاذل إن لومك في تباب","https://www.aldiwan.net/poem64852.html","الوافر"],[46,"عبيط ضوائن نحير جزر","https://www.aldiwan.net/poem22680.html","الوافر"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54984","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/4133","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67286","الوافر"],[80,"حُجبتَ فلا والله ما ذاك عن أمري","https://www.poetsgate.com/ViewPoem.aspx?id=3290",""],[130,"فما صوت جليت مع القوم في الند","https://www.aldiwan.net/poem54847.html","الطويل"],[130,"ألا أيها الأخوان أهل التأدب","https://www.aldiwan.net/poem54879.html","الطويل"],[135,"أسلمى تلك حييت","https://www.aldiwan.net/poem68027.html","الهزج"],[158,"أعندك علم أم أقول فأطرب","https://www.aldiwan.net/poem58761.html","الطويل"],[209,"تحدثت بالهتاف أنك حاضر لإيناس","https://www.aldiwan.net/poem46315.html","الطويل"],[209,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[229,"سلكت طريق الفقر ظنا بأنني","https://www.aldiwan.net/poem44560.html","الطويل"],[247,"كفى بالنأي من أسماء كافي","https://www.aldiwan.net/poem2105.html","الوافر"],[268,"لقد ذهبت تلك الأماني الخوادع","https://www.aldiwan.net/poem35239.html","الطويل"],[268,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[269,"دم المحب على الاطلال مطلول","https://www.aldiwan.net/poem52067.html","البسيط"],[269,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[369,"أتاني عنك إخوانك","https://www.aldiwan.net/poem57037.html","الهزج"],[377,"أمن بعد ما بان الفريق وأدلجا","https://www.aldiwan.net/poem48769.html","الطويل"],[400,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[411,"أقمنا لهم عرض الشمال فكبكبوا","https://www.aldiwan.net/poem4482.html","الطويل"],[426,"بدا ينجلي تحت الغلالة والبرد","https://www.aldiwan.net/poem40517.html","الطويل"],[429,"ثنت عنك يوم الرحيل العنانا","https://www.aldiwan.net/poem12741.html","المتقارب"],[434,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[436,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[438,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[438,"رأيت الزمان وإخوانه","https://www.aldiwan.net/poem14395.html","المتقارب"],[466,"أيا من لي بمربطه رجاء","https://www.aldiwan.net/poem59899.html","الوافر"],[512,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[513,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[527,"بضع وخمسون مرت","https://www.aldiwan.net/poem37072.html","المجتث"],[536,"ألم به الوشي فأعرض هازئا","https://www.aldiwan.net/poem47505.html","عموديه"],[549,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[561,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"]],"verses":[["فَما صِرتُ حَربَ الدَهرِ حَتّى رَأَيتُهُ","يُحارِبُ مَن أَمسى وَأَصبَحَ مُرمِلا",0,"ل",2,0],["فما صَدَقَتْ عنكَ القَوابِلُ وانْثَنَتْ","تَذُمُّ شُيوخَ الحَيِّ فيكَ العَجائِزُ",1,"ز",1,0],["فَما صَحْبُهُ الأدْنَوْنَ غيرَ صَوارِمٍ","ولا رَهْطُهُ الأعْلَوْنَ غيرَ كَواكِبِ",2,"ب",1,0],["فَما صَدَقَ اللِقاءَ مُجاشِعِيٌّ","وَما جَمَعَ القَناةَ مَعَ اللِجامِ",3,"م",1,0],["فما صغروا وبه كبروا","ولا كبّروا وبه صُغروا",4,"ر",3,0],["فما صُنعُ عبدٍ في قضاء مليكهِ","وتقديرهِ وهْو المدينُ المحوَّلُ",5,"ل",1,0],["فما صد عن نصر الحقيقة يونسا","وعيد ولا نحاه وعد عن الذب",6,"ب",1,0],["فما صرخت صرخة","بل قد ذهبت فرخة",7,"ه",1,0],["فما صفقتي في البيعِ صفقةُ خاسرٍ","ولا بيعتي للحب بيعةُ ناكثِ",8,"ث",1,0],["فَما صِلائِيَ إِن كانَ الصِلاءُ بِها","جَمرَ الغَضا الجَزلِ إِلّا السَيرُ وَالإِبلُ",9,"ل",1,0],["فَما صُقِلَ السَيفُ اليَماني لِمَشهَدٍ","كَما صُقِلَت بِالأَمسِ تِلكَ العَوارِضُ",10,"ض",1,0],["فما صَدقوا النبيَّ ولا استحبُّوا","سِوى الطمعِ المخيِّبِ والغُرورِ",11,"ر",1,0],["فَما صَبَروا لِبَأسٍ عِندَ حَربٍ","وَلا أَدَّوا لِحُسنِ يَدٍ ثَوابا",12,"ب",2,0],["فما صَنَعَتْ عادٌ مَصانِعَ مِثلَهُ","وَلا طاوَلَتْهُ في البِناءِ قُصُورُ",13,"ر",1,0],["فما صَفا الجوُّ فيها منذُ غِبتَ ولا","له انفِراجٌ إلى حيّ من العَرَبِ",14,"ب",1,0],["فَما صاحِبِيَ الحَيُّ","وَلَكِن صاحِبي المَيتُ",15,"ت",1,0],["فَما صَدَروا بِقَرفِهِمُ سُلَيمى","وَلا أَعتَبتُهُم عَمدَ العِتابِ",16,"ب",1,0],["فَما صُنعي تُمِرُّ يَدايَ شَزَراً","وَتَنقِضُ مِرَّةُ الأَيّامِ شَزري",17,"ر",2,0],["فَما صادِياتٌ حُمنَ يَوماً وَلَيلَةً","عَلى الماءِ دونَ الوِردِ هُنَّ حَواني",18,"ن",2,0],["فمَا صَدَقُوا وَغَيْرُكَ مَنْ عَنَوهُ","بِقَوْلِهِمْ أُحِيلَ إِلى المَعاِشِ",19,"ش",1,0],["فَما صاحِبي إِلّا فَتىً جَمجَمَت بِهِ","أَبِيَّةُ نَفسٍ عَن قُبولِ مُلامِ",20,"م",1,0],["فما صَفِرتْ عيابُ بني كلابٍ","ولا القُرَطَاءُ مِنْ ذمِّ الوفاءِ",21,"ا",2,0],["فما صار إخلال المكارم لي هوى","ً ولا دار إخجالٌ لمثلكَ في صدري",22,"ر",2,0],["فَمَا صَوتُ جِلِّيتٍ مَعَ القَومِ في النِّدِ","تُقَلِّبُ قَصباً مِن عَقِيمِ الزَّبَرجَدِ",23,"د",1,1],["فما صدرت لِي بامتحاني ذِلَّةٌ","ولَكن قَضَى قَاضِيهِ لِى بالتَّغَلُّبِ",24,"ب",1,0],["فَما صَهباءُ لَم تُكسَ","قَذىً مِن خَمرِ بَيروتِ",25,"ت",1,0],["فما صحَ عن هذا وذاك فإِنني","أرى كل يومٍ لي كذلك يوهبُ",26,"ب",1,0],["فما صح حلم في هواك ولا انتهت","على اليأس موجات الدموع الدوافق",27,"ق",1,0],["فما صبركم أنتم وبيني وبينكم","خطى هيناتٌ قد يقدّرن بالعد",28,"د",1,0],["فما صح لي فقر وما صح لي غنى","بل ازددت في علم التقلب تعريفا",29,"ف",2,0],["فَما صَدعٌ بِجُبَّةَ أَو بِشوطٍ","عَلى زُلُقٍ زَوالِقَ ذي كَهافِ",30,"ف",1,0],["فما صدَقت بالخبرِ أخبارُ كاذبٍ","وذلكَ طيفٌ زَخرَفتهُ المضاجع",31,"ع",1,0],["فما صدّ أعداءً ولا سدَّ ثغرةً","سوى بارجاتٍ كالبروجِ اشمخرّت",32,"ت",1,0],["فَما صَريح ومبنى ومطرد","وَما دَليل وَتَعليل وَتأَصيل",33,"ل",1,0],["فَما صدني من بعدكم بعد منزلي","وَلا خوف قطع من ظَلام الشَدائد",34,"د",1,0],["فما صدَّقتُهم مِن فَ","رحٍ فيما يَقولُونا",35,"ن",2,0],["فَما صافَحَت بَحر القَوافي نَسيمُهُ","لِكَف الصِبا إِلّا طَما وَتَموَجا",36,"ج",2,0],["فما صباحي سوى لقيا كتابكم","عنوانه أول الإِصباح في السحر",37,"ر",1,0],["فما صبروا للحرب عند قيامها","صبيحة يسمو بالرجال أبو بكر",38,"ر",1,0],["فما صفخة الياقوت تحت زمردٍ","بأحسن من آس العذار على الخدِ",39,"د",1,0],["فما صدَّ ذلك عزمي بها","ولا راعَ ذلك مني الجَنانا",40,"ن",2,0],["فما صاحفحت بيض الصفاح ككفّه","ولا حملت ذاك الطهمة الجرد",41,"د",1,0],["فما صَدَّني عن مُلتَقى الغِيلِ ضيغَمٌ","ولا راعَني فِي مَورِدِ الماءِ تِمساحُ",42,"ح",1,0],["فما صحبت أخاً إلا وجدت به","ختيلة الفهد أو مبلولة النلب",43,"ب",1,0],["فما صان عرضك إلا فتى","إذا سيم في عرضه صانه",44,"ن",2,0],["فَما صَبري عَلَيكَ وَأَنتَ مَحلٌ","إِذا ما كانَ غَيرُكَ لي رَبيعا",45,"ع",2,0],["فما صارَ شيءٌ من عِداهُ بأرضِه","سِوى ما سَرى من لحمِهم في الحَواصِلِ",46,"ل",1,0],["فما صهوة إلا وقد مل سرجها","ولا ذرة إلا وقد مال كورها",47,"ر",3,0],["فما صَنَعْتَ وَمَاذَا","تَقُولُهْ لِلْعَلِيِّ",48,"ي",1,0],["فما صدَّني خبثُ النُّفوسِ مِنَ أهلِهَا","وخُبثُ النفُوسِ الدَّاءُ مالَه مِن دَوَا",49,"و",2,0],["فما صدّقوا حتّى رأوا جانب الفَلا","يفيض رجالاً نُسَّلاً وخيولا",50,"ل",2,0],["فَما صانَ حِبراً عِلمُهُ وَكِتابُهُ","وَلا مَلِكاً أَعلامُهُ وَكَتائِبُه",51,"ب",2,0]]}