{"poems":[[55,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[29,"انظر خليلي بأعلى ثرمداء ضحى","https://www.aldiwan.net/poem5927.html","البسيط"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[93,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[60,"الأزد سيفي على الأعداء كلهم","https://www.aldiwan.net/poem31152.html","البسيط"],[51,"أراني صالح بغضا","https://www.aldiwan.net/poem64230.html","الهزج"],[104,"تحية لك يا مصر الفراعين","https://www.aldiwan.net/poem33034.html","السريع"],[41,"لولا فوارس مذحج ابنة مذحج","https://www.aldiwan.net/poem53776.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85382","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[303,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[411,"بئس شعار الرجل الشعاره","https://www.aldiwan.net/poem49940.html","الرجز"],[438,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[445,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[457,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[523,"اسمعوني","https://www.aldiwan.net/poem13164.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66827","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49995","المنسرح"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110272","الخفيف"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17699","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94271","المتدارك"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122461","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87348","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89062","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205579",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133311","البسيط"],[4889,"لَيْت العواذل للعذال مَا خلقُوا","https://www.poetsgate.com/ViewPoem.aspx?id=188596",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5538,"هب النسيم على محب ناءي","https://www.poetsgate.com/ViewPoem.aspx?id=142626",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""]],"verses":[["وَالأَزدَشيرِيّونَ أَبرَزَ مِنهُمُ","مُتَفَيِّئينَ مِنَ النَعيمِ ظِلالا",0,"ل",2,0],["وَالأَزدُ قَد جَعَلوا المَنتوفَ قائِدَهُم","فَقَتَّلَتهُم جُنودُ اللَهِ وَاِنتُتِفوا",1,"ف",3,0],["وَالأَزاهير وَالشَذى","في وِهاد وَأَنجُدِ",2,"د",1,0],["وَالأَزاهيرُ لَيسَ تَسخَرُ مِن فَق","ري وَلا فيكَ لِلغِنى تَتَوَدَّد",3,"د",1,0],["وَالأَزدُ جُرثومَةٌ إِن سُوبِقوا سَبَقوا","أَو فُوخِروا فَخَروا أَو غُولِبوا غَلَبوا",4,"ب",3,0],["وَإِلّا زِدتُهُ مَقتاً","وَإِلّا زِدتُهُ رَفضا",5,"ض",2,0],["وَالأَزبكيّةُ في الأَمساء راقِصة","لَها غَلائل مِن شَتى الرَياحين",6,"ن",1,0],["وَالأَزدُ تَعلَمُ أَنَّ تَحتَ لِوائِها","مُلكاً قُراسِيَةً وَمَوتٌ أَحمَرُ",7,"ر",1,0],["وَالأَزدُ تَعلَمُ ما يقال ضُحى غَدٍ","تَحتَ اللِواءِ فَتَستَحِدُّ وَتَصبِرُ",7,"ر",1,0],["والأزاهير للعصافير ترنو","باسمات عَن لؤلؤ وَعَقيق",8,"ق",1,0],["والأَزْرَقُ الأَصْفَرُ السِّرْبَالِ مُنْتَصِبٌ","قِيدَ العَصَا فَوْقَ ذَيَّالٍ مِنَ الزَّهَرِ",9,"ر",1,0],["والأزاهيرُ بهجةً وَسناءً","من وجوهٍ تحت الترابِ وِضاءِ",10,"ا",2,0],["وإلاّ زُبدَةَ الأيّا","مِ أو باكورةَ العُمْرِ",11,"ر",1,0],["والأزغبُ المَسلوبُ من ريشِه","كصاحبِ القادمةِ المُنْكَفي",12,"ف",2,0],["والأَزْهَرَ الوضَّاحَ والمَلِكَ الَّذِي","لبِسَ الندى والبأْسَ ثَوْباً وارتدى",13,"د",2,0],["والأزاهيرُ لدينا نسقتْ","فوق ظهران وروق بهجِ",14,"ج",1,0],["والأزهار تذبل","ويصير اللص ناطورا لبيت المال",15,"ل",1,0],["والأَزْدُ أُزد عُمانَ الأكرمون إذا","عُدَّت مآثِرُهُم في سالفِ الزمنِ",16,"ن",1,0],["وَالأَزْهَرَانِ فَتَجَلَّتْ ظُلَمُهْ","عَنْ وَجْهِ وَهّابٍ تُفَدَّى شِيَمُهْ",17,"م",2,0],["والأزْدُ آباؤهُ الذين هُم","بكل فضلٍ وعزَّةٍ سَبَقوا",18,"ق",3,0],["والازد قومي خيار القوم قد علموا","اذا قرومهم يوم الوغى خطروا",19,"ر",3,0],["والأزاهير حولها مثل أحدا","ق المها قد تفتحت ترعاها",20,"ا",3,0],["وَالأَزرَقُ العِجلِيُّ في ناموسِهِ","باري القِداحِ وَصانِعُ الأَوتارِ",21,"ر",1,0],["والأزمة ما اشتدت فرجت","كم حبلى قد صار نفسا",22,"س",2,0],["والأزرق الجبل الذي من دونه","والأسود العالي على ارمينه",23,"ه",1,0],["والأزهَرَ الشَّبمَ المورودَ سلهُ وسَل","فاساً ومنهلَها تُنبئك بالخَبَرِ",24,"ر",1,0],["والأَزهرُ الزاهرُ الوضّاحُ تعضدُها","منهُ معاقل آدابٍ وعرفانِ",25,"ن",1,0],["والأزرق العينين سوّد وجهه","وأحاطه الخذلان والتنكيد",26,"د",1,0],["والأزاهير في الغرَرْ","حيرة القلب والبصَرْ",27,"ر",1,0],["والأزهر اضطربت أركانه جزعا","على همام به قد كان مزدانا",28,"ن",2,0],["والأزرق اللَّوْن كالكبريت ذِي شعب","اطرقن عِنْد اقتباس مِنْهُ أطراقا",29,"ق",2,0],["والازاهير في ضفاف السواقي","قد تولى جفونها الاغفاء",30,"ا",2,0],["والأزهرُ انفطرتْ حزناً مآذنُه","والنيلُ نام على شطّيه ظمآنا",31,"ن",2,0],["(والأزهر) المعمور يرجو دومكم","لتثقفوا النائي من الجهلاء",32,"ا",2,0],["والازهر التاريخ يفقه فضله","جامعة الاسلام بالعلم خصيب.",33,"ب",1,0]]}