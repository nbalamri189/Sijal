رتي طول الدجى","تقطع البيد له ميلاً فميلا",122,"ل",2,0],["ومطلق هو لكن","في حضرة الحق حبسه",123,"س",2,0],["وَمُطَوَّقٌ مِنْ صِبْغِ خِلْقَةِ رَبِّهِ","طَوْقَيْنِ خِلْتُهُمَا مِنَ النُّوُّارِ",124,"ر",1,0]]}