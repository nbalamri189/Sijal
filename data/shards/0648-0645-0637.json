5.html","مجزوء الكامل"],[433,"هفا طربي الى عافي الرسوم","https://www.aldiwan.net/poem12714.html","الوافر"],[433,"أنا من جوارك في أعز مكان","https://www.aldiwan.net/poem12752.html","الكامل"],[440,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[440,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[453,"ومطرد الأجزاء صفر من القذى","https://www.aldiwan.net/poem13749.html","الطويل"],[459,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[459,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[459,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[459,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[462,"جلا سدف المفارق نور شيب","https://www.aldiwan.net/poem15444.html","الوافر"],[462,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[462,"تنيخ منه معمل المطي","https://www.aldiwan.net/poem16161.html","الرجز"],[465,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[469,"ومطرد المودة ليس فيها","https://www.aldiwan.net/poem60311.html","الوافر"],[469,"عندي طباهجة وجدي بارد","https://www.aldiwan.net/poem60498.html","الكامل"],[478,"لا تخدعن فتصطفي لك صاحبا","https://www.aldiwan.net/poem15315.html","الكامل"],[496,"غضي جفونك يا رياض","https://www.aldiwan.net/poem9883.html","مجزوء الكامل"],[496,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[516,"خادم ذيل المجلس العادلي","https://www.aldiwan.net/poem12197.html","السريع"],[552,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[552,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[552,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[552,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[559,"ردني الله له ردا جميلا","https://www.aldiwan.net/poem33577.html","الرمل"],[559,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[568,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"]],"verses":[["وَمُطلِعي في رَأسِ عادِيَّةٍ","تَخسَأُ طَرفَ الجَذَعِ الأَزلَمِ",0,"م",1,0],["وَمَطلُ الكَريمِ سَريعُ الزَوا","لِ كَالظِلِّ رَيعانُهُ زائِلُ",1,"ل",1,0],["وَمُطاعِنٍ بَعَثَت يَداكَ لَهُ","طَعناً يَذُلُّ لِوَقعِهِ البَطَلُ",2,"ل",1,0],["وَمُطاعِنَينِ إِذا هُما اِعتَرَضا","يَتَطاعَنانِ وَلِلقَنا زَجَلُ",2,"ل",1,0],["وَمُطَلَّحينَ لَهُم بِكُلِّ ثَنيَّةٍ","مُلقىً وِسادَتُهُ الثَرى وَالمَرفِقُ",3,"ق",1,0],["وَمُطالِعي في الأُنسِ إِن لُوِيَت","عَنّي الرِقابُ وَلَجَّ في صَدّي",4,"د",2,0],["وَمُطاعِنٌ وَلّى بِها وَكَأَنَّهُ","مِمّا يَجُرُّ مِنَ العَوامِلِ حاطِبُ",5,"ب",1,0],["وَمَطيَّةٍ أَنضَيتَها وَكِلاكُما","تَتَنازَعانِ السَيرَ وَالإِنضاءَ",6,"ا",2,0],["وَمِطراقٍ عَلى اللَحَظاتِ صِلٍّ","مَريضِ الناظِرَينِ مِنَ الحَياءِ",7,"ا",2,0],["وَمُطَّرِدُ الكُعوبِ أَحَصُّ صَدقٌ","تَخالُ سِنانَهُ بِاللَيلِ نارا",8,"ر",2,0],["ومَطْلَبي والذي كلِفْتُ بهِ","أمَّلْتُ تَحْصيلَهُ فَما حصَلا",9,"ل",2,0],["وَمُطْلِعُ شَمْسِ الْبِشْرِ فِي سُحُبِ النَّدَى","وَبَانِي مَعَالِيهِ وَهَادِم مَالِهِ",10,"ل",2,0],["ومَطلولَةِ الأعْطافِ جرّتْ ذُيولَها","على مِسْحَةٍ منْ مُسْكَةِ الغاسِقِ الغاسي",11,"س",2,0],["وَمُطَبِّبٍ لِلعَينِ يَحمِلُ ميلُهُ","نوراً إِذا غَشّى العُيونَ قَتامُ",12,"م",1,0],["وَمُطَبِّبٍ لِلطِفلِ لَم تَنبُت لَهُ","سِنٌّ وَلَم يَدرُج إِلَيهِ فِطامُ",12,"م",1,0],["وَمُطاوِلٍ في الكاتِبينَ وَمُدَّعٍ","في العالِمينَ وَمولَعٍ بِفَخارِ",13,"ر",1,0],["وَمُطَّرِداً كَرِشاءِ الجَرو","رِ مِن خُلُبِ النَخلَةِ الأَجرَدِ",14,"د",1,0],["وَمَطرَحَ أَثناءَ الزِمامِ كَأَنَّهُ","مَزاحِفُ أَيمٍ بِالفِناءِ صَريعِ",15,"ع",1,0],["وَمُطعِمُ القَومِ شَحماً عِندَ مَسغَبِهِم","وَفي الجُدوبِ كَريمُ الجَدِّ ميسارُ",16,"ر",1,0],["وَمَطو العُرى في مُجفَراتٍ كَأَنَّها","تَوابيتُ تُنضي مُخلِصاتِ السَفائِفِ",17,"ف",1,0],["وَمُطعَمُ الصَيدِ هَبّالٌ لِبُغيَتِهِ","أَلفى أَباهُ بِذاكَ الكَسبِ يَكتَسِبُ",18,"ب",1,0],["ومطرَّد الدماء وحيثُ يُلقى","من الشَّعَر المضفَّر والفليلِ",19,"ل",1,0],["وََمُطَّرد الدماءِ وحَيث تَلقَى","ضَفَائِرَ مَا دُهِنَّ وَمَا فُلِينَا",20,"ن",2,0],["ومطالع السعديّ في أُفق العُلى","والملك نعم القصد والحركات",21,"ت",1,1],["ومطّلب كانَ ارتحالك قبله","فعطلت الأيام شدّ رحاله",22,"ل",2,0],["ومُطَّردٌ مثل الرِّشاء تهزه","كعوبٌ تدانت فيه مثلَ نوى القَسْبِ",23,"ب",1,0],["ومطلُ الكريم مواعيدَه","أمانٌ من الخلف ما فيه خَتْر",24,"ر",1,0],["وَمُطعَمُ الغُنمِ يَومَ الغُنمِ مُطعَمُهُ","أَنّى تَوَجَّهَ وَالمَحرومُ مَحرومُ",25,"م",1,0],["وَمَطِيَّةٍ رَجراجَةٍ","لا كَالمَطِيَّة وَالبَعيرِ",26,"ر",1,0],["وَمُطرِبُ أَرواحِكُم مُطرِبي","وَموجِعُ أَكبادِكُم موجِعي",27,"ع",2,0],["ومطيع أحكام المنون وطالما","سبقت لطاعته يد الجلاد",28,"د",1,0],["وَمُطعِمُ الجَماعَه","وَخادِمُ الزِراعَه",29,"ه",1,0],["وَمَطلَعٌ لِسُعودٍ مِن أَواخِرِنا","وَمَغرِبٌ لِجُدودٍ مِن أَوالينا",30,"ن",2,0],["وَمَطلَبٍ في الظَنِّ مُستَبعَدٍ","كَالصُبحِ لِلناظِرِ في قُربِهِ",31,"ب",2,0],["وَمَطالِبٍ فيها الهَلاكُ أَتَيتُها","ثَبتَ الجَنانِ كَأَنَّني لَم آتِها",32,"ت",3,0],["وَمُطلِقٌ مِن خَراجي ما أَعُدُّ بِهِ","دَيناً عَلى ناصِرِ الإِسلامِ مَضمونا",33,"ن",2,0],["وَمُطَّلِبٍ مِنكَ المُساواةِ لَم تَزَل","أُلوفُكَ حَتّى أَجحَفَت بِمِئيهِ",34,"ي",2,0],["وَمُطروفَةِ العَينَينِ قَد قُدتُ لِلصِبا","تُقادُ إِلى أُخرى لَذيذٍ شَميمُها",35,"م",3,1],["ومُطارِدٌ لا الدَّرزُ يَعصِمُ صَيدَه","ما غابَ فيهِ ولا الفِرارُ يَقيِه",36,"ي",2,0],["ومطلعةِ الشموسِ على غصونٍ","مُضَاحِكَةٍ عن الدّرّ المصونِ",37,"ن",1,1],["ومُطلٌّ على مِنَى بَعد حَجٍّ","لِبُلوغِ المُنى ورميِ الجمارِ",38,"ر",1,0],["وَمُطَّرِدِ الأَجزاءِ يَصقُلُ مَتْنَهُ","صَبا أَعْلَنَتْ لِلعَينِ ما في ضَميرهِ",39,"ر",2,1],["ومطلةٍ في الخافقين خوافقٍ","كقلوب أعداءٍ ذَواتِ وجيبِ",40,"ب",1,0],["وَمُطعَمِ النَصرِ لَم تَكهَم أَسِنَّتُهُ","يَوماً وَلا حُجِبَت عَن رَوحِ مُحتَجِبِ",41,"ب",1,0],["ومطمعي أنها لا تشرْكَ بشركها","فإنَّ ذلك ذنبٌ غيرُ مغتفرِ",42,"ر",1,0],["وَمُطَهَّمٍ شَرِقِ الأَديمِ كَأَنَّما","أَلِفَت مَعاطِفُهُ النَجيعَ خِضابا",43,"ب",2,1],["وَمَطروراً أُجَرِّدُهُ صَقيلاً","وَيَعبوباً أَُكَرِّبُهُ كَريما",44,"م",2,0],["وَمُطَّرِدِ الكُعوبِ كَأَنَّ فيهِ","قُدامى ذي مَناكِبَ مَضرَحِيِّ",45,"ي",1,0],["ومُطّرِحُ الآراءِ ما كَرّ طَرفَه","ولا ارتدّ حتى عادَ شِلْواً مُطرَّحا",46,"ح",2,0],["وَمَطمومَةٍ لَم تَتَّصِل بِذُؤابَةٍ","وَلَم تَعتَقِد بِالتاجِ فَوقَ المَفارِقِ",47,"ق",1,0],["وَمَطَّت حاجِبَيها أَن رَأَتني","كَبِرتُ وَأَن قَدِ اِبيَضَّت قُروني",48,"ن",2,0],["وَمطوحين بنفسهم","خوف المذلة في المطاوح",49,"ح",1,0],["ومطلب في العمر ولَّى وفات","وكان همِّي أنه لا يفوت",50,"ت",1,0],["ومَطْلِيّةٍ قارَ الظّلامِ وما بَدا","بها جَرَبٌ إلاّ مَواقِعَ أنْسُع",51,"ع",1,0],["وَمُطَوِّعٌ لِي مِنْ بَيَانِيَ مَا عَصَى","فأَقُولَ فِيكَ كَمَا تُحِبُّ رِثَائِي",52,"ا",2,0],["ومَطِيَّةُ الآمال في رَيْعَانِهَا","وسِرَاجُ لَيْلِ السَّاهِدِ المَجْهُودِ",53,"د",1,0],["ومطالبي لم تَعْدُ مدَّةَ ساعدي","بُعْداً فما استعصَى عليّ مرام",54,"م",1,0],["ومطويَّةٍ كالسابِريَّةِ أُدْرِجَتْ","على فُقَرٍ مثلِ الجِبالِ الشَّواهقِ",55,"ق",1,0],["ومطربة تشجي الجموعَ بصوتها","وقد حَمَلَتْ بين الضلوع مآسيا",56,"ي",2,0],["ومطمعهم رشوة والذباب أكول","إذا خبث المطعمُ",57,"م",1,0],["ومطارَدون تعجَّلوا أيّامَهم","ومشرَّدون من المذلّةِ هاموا",58,"م",3,0],["وَمُطّلِبٌ منكَ المُساماةَ لم تَزَلْ","أُلُوفُكَ، حتّى أجحَفَتْ بمِئيهِ",59,"ي",2,0],["وَمَطْرُوفَةِ العَيْنَينِ قد قُدْتُ الصِّبا،","تُقادُ إلى أخْرَى لَذِيذٍ شَمِيمُهَا",60,"م",3,1],["ومطربات الأغاني وهي واقعة","في غير موقعها ضرب من الكدر",61,"ر",1,0],["وَمطلع الروح تبدي مِنهُ شمس ضحى","لهُ فتشرق في ارجاء مغربهِ",62,"ب",2,0],["ومطامعى هذى تَصَيُّدُهَا","كنصيُّد الشَّغواءِ في الشَعَفِ",63,"ف",1,0],["ومطروقَ الفِناءِ لزائريه","تقولُ كلابُه أهلا وسهلا",64,"ل",2,0],["وَمُطَهَّمٍ يَرِدُ النِزالَ كَأَنَّما","يُدعى إِلىآرِيِّهِ وَعَليقِهِ",65,"ق",2,0],["وَمُطَّرِدٍ يُرضيكَ عِندَ ذَواقِهِ","وَيَمضي وَلا يَنآدُ فيها يُصادِفُ",66,"ف",1,0],["وَمُطعِم الطَيرِ عامَ المَحلِ فَاِسمُ بِهِ","مِنّا إِذا صَرَّ خِلفُ الغَيثِ فَاِنصَرَما",67,"م",2,0],["ومَطامع الآمالِ تخدع ذا النُّهى","وتُعيد عالمَ عصرِه كجِهوله",68,"ل",2,0],["ومطوَّقٍ طارحتُه شَجَني","وعلى الدُّجى طوقٌ من الفجرِ",69,"ر",1,0],["ومطرب القوم احيا البسط حين به","ابدى السرور ومنه ما انطوى نشره",70,"ر",2,0],["وَمَطارفا لِلفَضلِ أَن","تَ بِلُبسها في الكَون أَدرى",71,"ر",2,0],["وَمُطَهَّمٌ في السَرجِ مِنهُ هَضبَةٌ","وَمُهَنَّدٌ في الغِمدِ مِنهُ جَدوَلُ",72,"ل",1,0],["وَمُطَيَّبٍ وَمُعَطَّرٍ حُلْوِ الْحُلَى","بَهِجٍ بِمَا تَجْنِيهِ رَوْضَةُ قَشِّهِ",73,"ش",2,0],["ومطلعها من أفق أفلاك حضرةٍ","تمدّ لنا ظلّ البقا في الظهيرة",74,"ه",1,0],["ومطلق الوجود بالحسن سرى","فخصّه بحبّه وعمّمَهْ",75,"م",2,0],["وَمُطَّرِداً مِن رُدَينِيَّةٍ","أَذودُ عَنِ الوِردِ أَبطالَها",76,"ل",3,0],["وَمُطَهَّمٍ قَدْ وَدَّ أَنَّ سَراتَهُ","مَهْدٌ لَهُ فِي سَيْرِهِ وَقُطُونِهِ",77,"ن",2,0],["وَمُطْلِعُها عَلَيْكَ مُسَوَّمَاتٍ","تَضِيقُ بِهَمِّها سَعَةُ الْبِلاَدِ",78,"د",1,0],["وَمُطَّرِدِ الأَمواجِ مُضطَرِبِ الحَشى","كَأَنَّ حَشاهُ جُرِّحَت بِالجَنادِلِ",79,"ل",1,0],["وَمطلقُ الحبِّ أَعم","ومن أَبى فقد زَعم",80,"م",1,0],["وَمطَّت قناعَ الطِرس عَن ضوء حسنها","فنارَ بها رَبعي وضاءَ مقامي",81,"م",2,0],["ومطوِّقِ الأَعناق من أَفضاله","بثقالِ أَطواقٍ عليه خِفافِ",82,"ف",1,0],["وَمطالبٍ شَتّى ستجمعُها","بالنُجح منه عوائدُ البِرِّ",83,"ر",1,0],["ومطلع شمس النفس من مشرق الخلا","سيطلعها من مغرب العدمية",84,"ه",1,0],["ومطهراً روحي الاثيم وباعثاً","في المنى ومعلمي التهذيبا",85,"ب",2,0],["وَمطبخُنا قَد شَابَ مِن طُولِ عُطْلَةٍ","بِها ما رَفَعْنا فَوقَ كانُونهِ قِدْرا",86,"ر",2,0],["وَمَطبخي بَعدَ ما قد شَابَ آبَ لهُ","زَمانُهُ بِشبابٍ منهُ فَينانِ",87,"ن",1,0],["ومَطْويّةِ الأقرابِ طاويةِ الفلا","بطُولِ نَجاءٍ بالنَّجاحِ ضَمين",88,"ن",1,0],["ومَطِيّةً ألقَيْتُ فَو","قَ سَراتِها أحدَ الرِّحال",89,"ل",1,0],["ومطَلْتَ المَطْلَ الشّديدَ وآنَي","تَ وآذيتَ أيّما إيذاء",90,"ا",2,0],["ومَطايا مِن العَطايا ثِقال","كلَّفت حَملَها سَجايا رِقاقُ",91,"ق",1,0],["ومطلبي رب قل له كن فكان","والحمدلله رب العالمين",92,"ن",1,0],["ومطلبي من جملة العباد","وأنس روحي في الأنام",93,"م",1,0],["ومطيل في عتبه لأناس","هم على المسلمين عار ووصمه",94,"م",2,0],["ومَطوءاً بأَخفافٍ","وأَظْلافٍ توطّاني",95,"ن",2,0],["ومطوّقٌ جيدي بنائله الَّذي","ملك