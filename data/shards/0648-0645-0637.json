{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[53,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[53,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[3,"حولي تنفض اِستُكَ مذرويه","https://www.aldiwan.net/poem95.html",""],[77,"انظر خضاب الشباب قد نصلا","https://www.aldiwan.net/poem35719.html","المنسرح"],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"تعلقته من دوحة الجود والباس","https://www.aldiwan.net/poem35881.html","الطويل"],[86,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[86,"قلم إذا ركب الأنامل أو جرى","https://www.aldiwan.net/poem68880.html","الكامل"],[0,"تطاول ليلك بالأثمد","https://www.aldiwan.net/poem81.html","المتقارب"],[35,"لعمري لقد رعتم غداة سويقة","https://www.aldiwan.net/poem39133.html","الطويل"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[37,"لنا حوض الحجيج وساقياه","https://www.aldiwan.net/poem7431.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"ومطالع السعدي في أفق العلى","https://www.aldiwan.net/poem18434.html","الكامل"],[72,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"كثير نوالك في جنب ما","https://www.aldiwan.net/poem62854.html","المتقارب"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"أنا من أنا يا ترى في الوجود","https://www.aldiwan.net/poem8977.html","عموديه"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"الحيوان خلق له عليك حق","https://www.aldiwan.net/poem7932.html","مجزوء الرجز"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[43,"سرب محاسنه حرمت ذواتها","https://www.aldiwan.net/poem9518.html","الكامل"],[45,"نسعى وأيسر هذا السعي يكفينا","https://www.aldiwan.net/poem66668.html","البسيط"],[45,"متى تسألي عن عهده تجديه","https://www.aldiwan.net/poem66847.html","البسيط"],[28,"ومطروفة العينين قد قدت للصبا","https://www.aldiwan.net/poem5565.html","الطويل"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[80,"ومطلعة الشموس على غصون","https://www.aldiwan.net/poem31271.html","الوافر"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[80,"ومطرد الأجزاء يصقل متنه","https://www.aldiwan.net/poem31461.html","الطويل"],[80,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[74,"ومطهم شرق الأديم كأنما","https://www.aldiwan.net/poem12848.html","الكامل"],[74,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[22,"عرفت منازلا من آل هند","https://www.aldiwan.net/poem21670.html","الوافر"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[48,"لقد صبحت بالخير عين تصبحت","https://www.aldiwan.net/poem64432.html","الطويل"],[15,"تغيرت الديار بذي الدفين","https://www.aldiwan.net/poem45241.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50358","الطويل"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"متى تَسألي عَن عَهْدِهِ تَجِدِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31643",""],[28,"ومطروفة العينين قد قدت الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=17970",""],[88,"وصاحب قد دعانا ان نلمّ به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19574&r=&rc=77",""]],"verses":[["وَمُطلِعي في رَأسِ عادِيَّةٍ","تَخسَأُ طَرفَ الجَذَعِ الأَزلَمِ",0,"م",1,0],["وَمَطلُ الكَريمِ سَريعُ الزَوا","لِ كَالظِلِّ رَيعانُهُ زائِلُ",1,"ل",1,0],["وَمُطاعِنٍ بَعَثَت يَداكَ لَهُ","طَعناً يَذُلُّ لِوَقعِهِ البَطَلُ",2,"ل",1,0],["وَمُطاعِنَينِ إِذا هُما اِعتَرَضا","يَتَطاعَنانِ وَلِلقَنا زَجَلُ",2,"ل",1,0],["وَمُطَلَّحينَ لَهُم بِكُلِّ ثَنيَّةٍ","مُلقىً وِسادَتُهُ الثَرى وَالمَرفِقُ",3,"ق",1,0],["وَمُطالِعي في الأُنسِ إِن لُوِيَت","عَنّي الرِقابُ وَلَجَّ في صَدّي",4,"ي",1,0],["وَمُطاعِنٌ وَلّى بِها وَكَأَنَّهُ","مِمّا يَجُرُّ مِنَ العَوامِلِ حاطِبُ",5,"ب",1,0],["وَمَطيَّةٍ أَنضَيتَها وَكِلاكُما","تَتَنازَعانِ السَيرَ وَالإِنضاءَ",6,"ا",2,0],["وَمِطراقٍ عَلى اللَحَظاتِ صِلٍّ","مَريضِ الناظِرَينِ مِنَ الحَياءِ",7,"ا",2,0],["وَمُطَّرِدُ الكُعوبِ أَحَصُّ صَدقٌ","تَخالُ سِنانَهُ بِاللَيلِ نارا",8,"ر",2,0],["ومَطْلَبي والذي كلِفْتُ بهِ","أمَّلْتُ تَحْصيلَهُ فَما حصَلا",9,"ل",2,0],["وَمُطْلِعُ شَمْسِ الْبِشْرِ فِي سُحُبِ النَّدَى","وَبَانِي مَعَالِيهِ وَهَادِم مَالِهِ",10,"ل",2,0],["ومَطلولَةِ الأعْطافِ جرّتْ ذُيولَها","على مِسْحَةٍ منْ مُسْكَةِ الغاسِقِ الغاسي",11,"س",2,0],["وَمُطَبِّبٍ لِلعَينِ يَحمِلُ ميلُهُ","نوراً إِذا غَشّى العُيونَ قَتامُ",12,"م",1,0],["وَمُطَبِّبٍ لِلطِفلِ لَم تَنبُت لَهُ","سِنٌّ وَلَم يَدرُج إِلَيهِ فِطامُ",12,"م",1,0],["وَمُطاوِلٍ في الكاتِبينَ وَمُدَّعٍ","في العالِمينَ وَمولَعٍ بِفَخارِ",13,"ر",1,0],["وَمُطَّرِداً كَرِشاءِ الجَرو","رِ مِن خُلُبِ النَخلَةِ الأَجرَدِ",14,"د",1,0],["وَمَطرَحَ أَثناءَ الزِمامِ كَأَنَّهُ","مَزاحِفُ أَيمٍ بِالفِناءِ صَريعِ",15,"ع",1,0],["وَمُطعِمُ القَومِ شَحماً عِندَ مَسغَبِهِم","وَفي الجُدوبِ كَريمُ الجَدِّ ميسارُ",16,"ر",1,0],["وَمَطو العُرى في مُجفَراتٍ كَأَنَّها","تَوابيتُ تُنضي مُخلِصاتِ السَفائِفِ",17,"ف",1,0],["وَمُطعَمُ الصَيدِ هَبّالٌ لِبُغيَتِهِ","أَلفى أَباهُ بِذاكَ الكَسبِ يَكتَسِبُ",18,"ب",1,0],["ومطرَّد الدماء وحيثُ يُلقى","من الشَّعَر المضفَّر والفليلِ",19,"ل",1,0],["وََمُطَّرد الدماءِ وحَيث تَلقَى","ضَفَائِرَ مَا دُهِنَّ وَمَا فُلِينَا",20,"ن",2,0],["ومطالع السعديّ في أُفق العُلى","والملك نعم القصد والحركات",21,"ت",1,1],["ومطّلب كانَ ارتحالك قبله","فعطلت الأيام شدّ رحاله",22,"ل",2,0],["ومُطَّردٌ مثل الرِّشاء تهزه","كعوبٌ تدانت فيه مثلَ نوى القَسْبِ",23,"ب",1,0],["ومطلُ الكريم مواعيدَه","أمانٌ من الخلف ما فيه خَتْر",24,"ر",1,0],["وَمُطعَمُ الغُنمِ يَومَ الغُنمِ مُطعَمُهُ","أَنّى تَوَجَّهَ وَالمَحرومُ مَحرومُ",25,"م",1,0],["وَمَطِيَّةٍ رَجراجَةٍ","لا كَالمَطِيَّة وَالبَعيرِ",26,"ر",1,0],["وَمُطرِبُ أَرواحِكُم مُطرِبي","وَموجِعُ أَكبادِكُم موجِعي",27,"ي",1,0],["ومطيع أحكام المنون وطالما","سبقت لطاعته يد الجلاد",28,"د",1,0],["وَمُطعِمُ الجَماعَه","وَخادِمُ الزِراعَه",29,"ه",1,0],["وَمَطلَعٌ لِسُعودٍ مِن أَواخِرِنا","وَمَغرِبٌ لِجُدودٍ مِن أَوالينا",30,"ن",2,0],["وَمَطلَبٍ في الظَنِّ مُستَبعَدٍ","كَالصُبحِ لِلناظِرِ في قُربِهِ",31,"ب",2,0],["وَمَطالِبٍ فيها الهَلاكُ أَتَيتُها","ثَبتَ الجَنانِ كَأَنَّني لَم آتِها",32,"ت",3,0],["وَمُطلِقٌ مِن خَراجي ما أَعُدُّ بِهِ","دَيناً عَلى ناصِرِ الإِسلامِ مَضمونا",33,"ن",2,0],["وَمُطَّلِبٍ مِنكَ المُساواةِ لَم تَزَل","أُلوفُكَ حَتّى أَجحَفَت بِمِئيهِ",34,"ي",2,0],["وَمُطروفَةِ العَينَينِ قَد قُدتُ لِلصِبا","تُقادُ إِلى أُخرى لَذيذٍ شَميمُها",35,"م",3,1],["ومُطارِدٌ لا الدَّرزُ يَعصِمُ صَيدَه","ما غابَ فيهِ ولا الفِرارُ يَقيِه",36,"ي",2,0],["ومطلعةِ الشموسِ على غصونٍ","مُضَاحِكَةٍ عن الدّرّ المصونِ",37,"ن",1,1],["ومُطلٌّ على مِنَى بَعد حَجٍّ","لِبُلوغِ المُنى ورميِ الجمارِ",38,"ر",1,0],["وَمُطَّرِدِ الأَجزاءِ يَصقُلُ مَتْنَهُ","صَبا أَعْلَنَتْ لِلعَينِ ما في ضَميرهِ",39,"ر",2,1],["ومطلةٍ في الخافقين خوافقٍ","كقلوب أعداءٍ ذَواتِ وجيبِ",40,"ب",1,0],["وَمُطعَمِ النَصرِ لَم تَكهَم أَسِنَّتُهُ","يَوماً وَلا حُجِبَت عَن رَوحِ مُحتَجِبِ",41,"ب",1,0],["ومطمعي أنها لا تشرْكَ بشركها","فإنَّ ذلك ذنبٌ غيرُ مغتفرِ",42,"ر",1,0],["وَمُطَهَّمٍ شَرِقِ الأَديمِ كَأَنَّما","أَلِفَت مَعاطِفُهُ النَجيعَ خِضابا",43,"ب",2,1],["وَمَطروراً أُجَرِّدُهُ صَقيلاً","وَيَعبوباً أَُكَرِّبُهُ كَريما",44,"م",2,0],["وَمُطَّرِدِ الكُعوبِ كَأَنَّ فيهِ","قُدامى ذي مَناكِبَ مَضرَحِيِّ",45,"ي",1,0],["ومُطّرِحُ الآراءِ ما كَرّ طَرفَه","ولا ارتدّ حتى عادَ شِلْواً مُطرَّحا",46,"ح",2,0],["وَمَطمومَةٍ لَم تَتَّصِل بِذُؤابَةٍ","وَلَم تَعتَقِد بِالتاجِ فَوقَ المَفارِقِ",47,"ق",1,0],["وَمَطَّت حاجِبَيها أَن رَأَتني","كَبِرتُ وَأَن قَدِ اِبيَضَّت قُروني",48,"ن",2,0],["وَمطوحين بنفسهم","خوف المذلة في المطاوح",49,"ح",1,0],["ومطلب في العمر ولَّى وفات","وكان همِّي أنه لا يفوت",50,"ت",1,0],["ومَطْلِيّةٍ قارَ الظّلامِ وما بَدا","بها جَرَبٌ إلاّ مَواقِعَ أنْسُع",51,"ع",1,0],["وَمُطَوِّعٌ لِي مِنْ بَيَانِيَ مَا عَصَى","فأَقُولَ فِيكَ كَمَا تُحِبُّ رِثَائِي",52,"ا",2,0],["ومَطِيَّةُ الآمال في رَيْعَانِهَا","وسِرَاجُ لَيْلِ السَّاهِدِ المَجْهُودِ",53,"د",1,0],["ومطالبي لم تَعْدُ مدَّةَ ساعدي","بُعْداً فما استعصَى عليّ مرام",54,"م",1,0],["ومطويَّةٍ كالسابِريَّةِ أُدْرِجَتْ","على فُقَرٍ مثلِ الجِبالِ الشَّواهقِ",55,"ق",1,0],["ومطربة تشجي الجموعَ بصوتها","وقد حَمَلَتْ بين الضلوع مآسيا",56,"ي",2,0],["ومطارَدون تعجَّلوا أيّامَهم","ومشرَّدون من المذلّةِ هاموا",57,"م",3,0],["وَمُطّلِبٌ منكَ المُساماةَ لم تَزَلْ","أُلُوفُكَ، حتّى أجحَفَتْ بمِئيهِ",58,"ي",2,0],["وَمَطْرُوفَةِ العَيْنَينِ قد قُدْتُ الصِّبا،","تُقادُ إلى أخْرَى لَذِيذٍ شَمِيمُهَا",59,"م",3,1],["ومطربات الأغاني وهي واقعة","في غير موقعها ضرب من الكدر",60,"ر",1,0]]}