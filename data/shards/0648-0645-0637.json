"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[585,"طلع الربيع على الربوع نضيرا","https://www.poetsgate.com/ViewPoem.aspx?id=161872",""],[5183,"طائش المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180259",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5219,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=194915",""],[2365,"ومطيع الفؤاد عاصى اللّسان","https://www.poetsgate.com/ViewPoem.aspx?id=200659",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5431,"رباعيات حول النقد...","https://www.poetsgate.com/ViewPoem.aspx?id=183017",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5561,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=196755",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5701,"يا صاحب السيف الذي","https://www.poetsgate.com/ViewPoem.aspx?id=164598",""],[5770,"يا وَحشَةَ الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=178815",""],[5790,"يا لقومي أين يذهب بي","https://www.poetsgate.com/ViewPoem.aspx?id=111981",""],[5991,"يا قانعاً بصفاته عن ذاته","https://www.poetsgate.com/ViewPoem.aspx?id=116387",""],[5997,"قيم الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=214222",""],[5997,"لَيْلَةُ وَضُحَاُهَا","https://www.poetsgate.com/ViewPoem.aspx?id=214283",""],[5997,"ريمٌ شرودٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215170",""],[6001,"بنت العز","https://www.poetsgate.com/ViewPoem.aspx?id=376",""],[6068,"يا فزعو الروع -22-","https://www.poetsgate.com/ViewPoem.aspx?id=177483",""],[231,"العود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79153&r=&rc=27",""],[572,"غَدَرَ الزّمانُ وجارَ في أَحكامِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9296&r=&rc=153",""]],"verses":[["وَمُطلِعي في رَأسِ عادِيَّةٍ","تَخسَأُ طَرفَ الجَذَعِ الأَزلَمِ",0,"م",1,0],["وَمَطلُ الكَريمِ سَريعُ الزَوا","لِ كَالظِلِّ رَيعانُهُ زائِلُ",1,"ل",1,0],["وَمُطاعِنٍ بَعَثَت يَداكَ لَهُ","طَعناً يَذُلُّ لِوَقعِهِ البَطَلُ",2,"ل",1,0],["وَمُطاعِنَينِ إِذا هُما اِعتَرَضا","يَتَطاعَنانِ وَلِلقَنا زَجَلُ",2,"ل",1,0],["وَمُطَلَّحينَ لَهُم بِكُلِّ ثَنيَّةٍ","مُلقىً وِسادَتُهُ الثَرى وَالمَرفِقُ",3,"ق",1,0],["وَمُطالِعي في الأُنسِ إِن لُوِيَت","عَنّي الرِقابُ وَلَجَّ في صَدّي",4,"د",2,0],["وَمُطاعِنٌ وَلّى بِها وَكَأَنَّهُ","مِمّا يَجُرُّ مِنَ العَوامِلِ حاطِبُ",5,"ب",1,0],["وَمَطيَّةٍ أَنضَيتَها وَكِلاكُما","تَتَنازَعانِ السَيرَ وَالإِنضاءَ",6,"ا",2,0],["وَمِطراقٍ عَلى اللَحَظاتِ صِلٍّ","مَريضِ الناظِرَينِ مِنَ الحَياءِ",7,"ا",2,0],["وَمُطَّرِدُ الكُعوبِ أَحَصُّ صَدقٌ","تَخالُ سِنانَهُ بِاللَيلِ نارا",8,"ر",2,0],["ومَطْلَبي والذي كلِفْتُ بهِ","أمَّلْتُ تَحْصيلَهُ فَما حصَلا",9,"ل",2,0],["وَمُطْلِعُ شَمْسِ الْبِشْرِ فِي سُحُبِ النَّدَى","وَبَانِي مَعَالِيهِ وَهَادِم مَالِهِ",10,"ل",2,0],["ومَطلولَةِ الأعْطافِ جرّتْ ذُيولَها","على مِسْحَةٍ منْ مُسْكَةِ الغاسِقِ الغاسي",11,"س",2,0],["وَمُطَبِّبٍ لِلعَينِ يَحمِلُ ميلُهُ","نوراً إِذا غَشّى العُيونَ قَتامُ",12,"م",1,0],["وَمُطَبِّبٍ لِلطِفلِ لَم تَنبُت لَهُ","سِنٌّ وَلَم يَدرُج إِلَيهِ فِطامُ",12,"م",1,0],["وَمُطاوِلٍ في الكاتِبينَ وَمُدَّعٍ","في العالِمينَ وَمولَعٍ بِفَخارِ",13,"ر",1,0],["وَمُطَّرِداً كَرِشاءِ الجَرو","رِ مِن خُلُبِ النَخلَةِ الأَجرَدِ",14,"د",1,0],["وَمَطرَحَ أَثناءَ الزِمامِ كَأَنَّهُ","مَزاحِفُ أَيمٍ بِالفِناءِ صَريعِ",15,"ع",1,0],["وَمُطعِمُ القَومِ شَحماً عِندَ مَسغَبِهِم","وَفي الجُدوبِ كَريمُ الجَدِّ ميسارُ",16,"ر",1,0],["وَمَطو العُرى في مُجفَراتٍ كَأَنَّها","تَوابيتُ تُنضي مُخلِصاتِ السَفائِفِ",17,"ف",1,0],["وَمُطعَمُ الصَيدِ هَبّالٌ لِبُغيَتِهِ","أَلفى أَباهُ بِذاكَ الكَسبِ يَكتَسِبُ",18,"ب",1,0],["ومطرَّد الدماء وحيثُ يُلقى","من الشَّعَر المضفَّر والفليلِ",19,"ل",1,0],["وََمُطَّرد الدماءِ وحَيث تَلقَى","ضَفَائِرَ مَا دُهِنَّ وَمَا فُلِينَا",20,"ن",2,0],["ومطالع السعديّ في أُفق العُلى","والملك نعم القصد والحركات",21,"ت",1,1],["ومطّلب كانَ ارتحالك قبله","فعطلت الأيام شدّ رحاله",22,"ل",2,0],["ومُطَّردٌ مثل الرِّشاء تهزه","كعوبٌ تدانت فيه مثلَ نوى القَسْبِ",23,"ب",1,0],["ومطلُ الكريم مواعيدَه","أمانٌ من الخلف ما فيه خَتْر",24,"ر",1,0],["وَمُطعَمُ الغُنمِ يَومَ الغُنمِ مُطعَمُهُ","أَنّى تَوَجَّهَ وَالمَحرومُ مَحرومُ",25,"م",1,0],["وَمَطِيَّةٍ رَجراجَةٍ","لا كَالمَطِيَّة وَالبَعيرِ",26,"ر",1,0],["وَمُطرِبُ أَرواحِكُم مُطرِبي","وَموجِعُ أَكبادِكُم موجِعي",27,"ع",2,0],["ومطيع أحكام المنون وطالما","سبقت لطاعته يد الجلاد",28,"د",1,0],["وَمُطعِمُ الجَماعَه","وَخادِمُ الزِراعَه",29,"ه",1,0],["وَمَطلَعٌ لِسُعودٍ مِن أَواخِرِنا","وَمَغرِبٌ لِجُدودٍ مِن أَوالينا",30,"ن",2,0],["وَمَطلَبٍ في الظَنِّ مُستَبعَدٍ","كَالصُبحِ لِلناظِرِ في قُربِهِ",31,"ب",2,0],["وَمَطالِبٍ فيها الهَلاكُ أَتَيتُها","ثَبتَ الجَنانِ كَأَنَّني لَم آتِها",32,"ت",3,0],["وَمُطلِقٌ مِن خَراجي ما أَعُدُّ بِهِ","دَيناً عَلى ناصِرِ الإِسلامِ مَضمونا",33,"ن",2,0],["وَمُطَّلِبٍ مِنكَ المُساواةِ لَم تَزَل","أُلوفُكَ حَتّى أَجحَفَت بِمِئيهِ",34,"ي",2,0],["وَمُطروفَةِ العَينَينِ قَد قُدتُ لِلصِبا","تُقادُ إِلى أُخرى لَذيذٍ شَميمُها",35,"م",3,1],["ومُطارِدٌ لا الدَّرزُ يَعصِمُ صَيدَه","ما غابَ فيهِ ولا الفِرارُ يَقيِه",36,"ي",2,0],["ومطلعةِ الشموسِ على غصونٍ","مُضَاحِكَةٍ عن الدّرّ المصونِ",37,"ن",1,1],["ومُطلٌّ على مِنَى بَعد حَجٍّ","لِبُلوغِ المُنى ورميِ الجمارِ",38,"ر",1,0],["وَمُطَّرِدِ الأَجزاءِ يَصقُلُ مَتْنَهُ","صَبا أَعْلَنَتْ لِلعَينِ ما في ضَميرهِ",39,"ر",2,1],["ومطلةٍ في الخافقين خوافقٍ","كقلوب أعداءٍ ذَواتِ وجيبِ",40,"ب",1,0],["وَمُطعَمِ النَصرِ لَم تَكهَم أَسِنَّتُهُ","يَوماً وَلا حُجِبَت عَن رَوحِ مُحتَجِبِ",41,"ب",1,0],["ومطمعي أنها لا تشرْكَ بشركها","فإنَّ ذلك ذنبٌ غيرُ مغتفرِ",42,"ر",1,0],["وَمُطَهَّمٍ شَرِقِ الأَديمِ كَأَنَّما","أَلِفَت مَعاطِفُهُ النَجيعَ خِضابا",43,"ب",2,1],["وَمَطروراً أُجَرِّدُهُ صَقيلاً","وَيَعبوباً أَُكَرِّبُهُ كَريما",44,"م",2,0],["وَمُطَّرِدِ الكُعوبِ كَأَنَّ فيهِ","قُدامى ذي مَناكِبَ مَضرَحِيِّ",45,"ي",1,0],["ومُطّرِحُ الآراءِ ما كَرّ طَرفَه","ولا ارتدّ حتى عادَ شِلْواً مُطرَّحا",46,"ح",2,0],["وَمَطمومَةٍ لَم تَتَّصِل بِذُؤابَةٍ","وَلَم تَعتَقِد بِالتاجِ فَوقَ المَفارِقِ",47,"ق",1,0],["وَمَطَّت حاجِبَيها أَن رَأَتني","كَبِرتُ وَأَن قَدِ اِبيَضَّت قُروني",48,"ن",2,0],["ومطردٌ لدن الكعوب كأنما","تغشاه منباع من الزيت سائل",49,"ل",1,0],["وَمطوحين بنفسهم","خوف المذلة في المطاوح",50,"ح",1,0],["ومطلب في العمر ولَّى وفات","وكان همِّي أنه لا يفوت",51,"ت",1,0],["ومَطْلِيّةٍ قارَ الظّلامِ وما بَدا","بها جَرَبٌ إلاّ مَواقِعَ أنْسُع",52,"ع",1,0],["وَمُطَوِّعٌ لِي مِنْ بَيَانِيَ مَا عَصَى","فأَقُولَ فِيكَ كَمَا تُحِبُّ رِثَائِي",53,"ا",2,0],["ومَطِيَّةُ الآمال في رَيْعَانِهَا","وسِرَاجُ لَيْلِ السَّاهِدِ المَجْهُودِ",54,"د",1,0],["ومطالبي لم تَعْدُ مدَّةَ ساعدي","بُعْداً فما استعصَى عليّ مرام",55,"م",1,0],["ومطويَّةٍ كالسابِريَّةِ أُدْرِجَتْ","على فُقَرٍ مثلِ الجِبالِ الشَّواهقِ",56,"ق",1,0],["ومطربة تشجي الجموعَ بصوتها","وقد حَمَلَتْ بين الضلوع مآسيا",57,"ي",2,0],["ومطهمات كالرياح قواصف","قحل الى دهم الحروب هيامها",58,"م",3,0],["ومطعم تهافتت ذبانه","قضم الهبيد منه أحلى في اللها",59,"ا",1,0],["ومطمعهم رشوة والذباب أكول","إذا خبث المطعمُ",60,"م",1,0],["ومطارَدون تعجَّلوا أيّامَهم","ومشرَّدون من المذلّةِ هاموا",61,"م",3,0],["وَمُطّلِبٌ منكَ المُساماةَ لم تَزَلْ","أُلُوفُكَ، حتّى أجحَفَتْ بمِئيهِ",62,"ي",2,0],["وَمَطْرُوفَةِ العَيْنَينِ قد قُدْتُ الصِّبا،","تُقادُ إلى أخْرَى لَذِيذٍ شَمِيمُهَا",63,"م",3,1],["ومطربات الأغاني وهي واقعة","في غير موقعها ضرب من الكدر",64,"ر",1,0],["وَمطلع الروح تبدي مِنهُ شمس ضحى","لهُ فتشرق في ارجاء مغربهِ",65,"ب",2,0],["ومطامعى هذى تَصَيُّدُهَا","كنصيُّد الشَّغواءِ في الشَعَفِ",66,"ف",1,0],["ومطروقَ الفِناءِ لزائريه","تقولُ كلابُه أهلا وسهلا",67,"ل",2,0],["وَمُطَهَّمٍ يَرِدُ النِزالَ كَأَنَّما","يُدعى إِلىآرِيِّهِ وَعَليقِهِ",68,"ق",2,0],["وَمُطَّرِدٍ يُرضيكَ عِندَ ذَواقِهِ","وَيَمضي وَلا يَنآدُ فيها يُصادِفُ",69,"ف",1,0],["وَمُطعِم الطَيرِ عامَ المَحلِ فَاِسمُ بِهِ","مِنّا إِذا صَرَّ خِلفُ الغَيثِ فَاِنصَرَما",70,"م",2,0],["ومَطامع الآمالِ تخدع ذا النُّهى","وتُعيد عالمَ عصرِه كجِهوله",71,"ل",2,0],["ومطوَّقٍ طارحتُه شَجَني","وعلى الدُّجى طوقٌ من الفجرِ",72,"ر",1,0],["ومطرب القوم احيا البسط حين به","ابدى السرور ومنه ما انطوى نشره",73,"ر",2,0],["وَمَطارفا لِلفَضلِ أَن","تَ بِلُبسها في الكَون أَدرى",74,"ر",2,0],["وَمُطَهَّمٌ في السَرجِ مِنهُ هَضبَةٌ","وَمُهَنَّدٌ في الغِمدِ مِنهُ جَدوَلُ",75,"ل",1,0],["وَمُطَيَّبٍ وَمُعَطَّرٍ حُلْوِ الْحُلَى","بَهِجٍ بِمَا تَجْنِيهِ رَوْضَةُ قَشِّهِ",76,"ش",2,0],["ومطلعها من أفق أفلاك حضرةٍ","تمدّ لنا ظلّ البقا في الظهيرة",77,"ه",1,0],["ومطلق الوجود بالحسن سرى","فخصّه بحبّه وعمّمَهْ",78,"م",2,0],["وَمُطَّرِداً مِن رُدَينِيَّةٍ","أَذودُ عَنِ الوِردِ أَبطالَها",79,"ل",3,0],["وَمُطَهَّمٍ قَدْ وَدَّ أَنَّ سَراتَهُ","مَهْدٌ لَهُ فِي سَيْرِهِ وَقُطُونِهِ",80,"ن",2,0],["وَمُطْلِعُها عَلَيْكَ مُسَوَّمَاتٍ","تَضِيقُ بِهَمِّها سَعَةُ الْبِلاَدِ",81,"د",1,0],["وَمُطَّرِدِ الأَمواجِ مُضطَرِبِ الحَشى","كَأَنَّ حَشاهُ جُرِّحَت بِالجَنادِلِ",82,"ل",1,0],["وَمطلقُ الحبِّ أَعم","ومن أَبى فقد زَعم",83,"م",1,0],["وَمطَّت قناعَ الطِرس عَن ضوء حسنها","فنارَ بها رَبعي وضاءَ مقامي",84,"م",2,0],["ومطوِّقِ الأَعناق من أَفضاله","بثقالِ أَطواقٍ عليه خِفافِ",85,"ف",1,0],["وَمطالبٍ شَتّى ستجمعُها","بالنُجح منه عوائدُ البِرِّ",86,"ر",1,0],["ومطلع شمس النفس من مشرق الخلا","سيطلعها من مغرب العدمية",87,"ه",1,0],["ومطهراً روحي الاثيم وباعثاً","في المنى ومعلمي التهذيبا",88,"ب",2,0],["وَمطبخُنا قَد شَابَ مِن طُولِ عُطْلَةٍ","بِها ما رَفَعْنا فَوقَ كانُونهِ قِدْرا",89,"ر",2,0],["وَمَطبخي بَعدَ ما قد شَابَ آبَ لهُ","زَمانُهُ بِشبابٍ منهُ فَينانِ",90,"ن",1,0],["ومَطْويّةِ الأقرابِ طاويةِ الفلا","بطُولِ نَجاءٍ بالنَّجاحِ ضَمين",91,"ن",1,0],["ومَطِيّةً ألقَيْتُ فَو","قَ سَراتِها أحدَ الرِّحال",92,"ل",1,0],["ومطَلْتَ المَطْلَ الشّديدَ وآنَي","تَ وآذيتَ أيّما إيذاء",93,"ا",2,0],["ومَطايا مِن العَطايا ثِقال","كلَّفت حَملَها سَجايا رِقاقُ",94,"ق",1,0],["ومطلبي رب قل له كن فكان","والحمدلله رب العالمين",95,"ن",1,0],["ومطلبي من جملة العباد","وأنس روحي في الأنام",96,"م",1,0],["ومطيل في عتبه لأناس","هم على المسلمين عار ووصمه",97,"م",2,0],["ومَطوءاً بأَخفافٍ","وأَظْلافٍ توطّاني",98,"ن",2,0],["ومطوّقٌ جيدي بنائله الَّذي","ملك الرقاب وطوَّق الأجيادا",99,