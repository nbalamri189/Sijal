{"poems":[[55,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[53,"وثدي ناهدات","https://www.aldiwan.net/poem65709.html","مجزوء الرمل"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[40,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[91,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[64,"صنوان ضدان أب واحد","https://www.aldiwan.net/poem52181.html","السريع"],[63,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[18,"هل عرفت الغداة من أطلال","https://www.aldiwan.net/poem23933.html","الخفيف"],[71,"باسم إله الخلق هذا ما اشترى","https://www.aldiwan.net/poem27989.html","الرجز"],[77,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[48,"أعوذ بالله من ألي سفة","https://www.aldiwan.net/poem22303.html","المنسرح"],[70,"ما اسم إذا ما سأل المرء عن","https://www.aldiwan.net/poem1555.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[53,"صبراً على أَشياءَ كُلِّفْتُها","https://www.poetsgate.com/ViewPoem.aspx?id=27205",""],[139,"لم ينلها سواك من أهل مصر","https://www.aldiwan.net/poem49077.html","الخفيف"],[164,"معظم له يدا وكم وكم","https://www.aldiwan.net/poem58664.html","الرجز"],[190,"أخيب خلق الله مستنكح","https://www.aldiwan.net/poem43816.html","السريع"],[333,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55024.html","الخفيف"],[333,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55035.html","الخفيف"],[376,"لو كان في أن يزور وزر","https://www.aldiwan.net/poem57440.html","مخلع البسيط"],[409,"يا ماجدا ما زال يهدي نظمه","https://www.aldiwan.net/poem33457.html","الرجز"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[543,"بين هذي الربوع أسكب دمعي","https://www.aldiwan.net/poem47569.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126754","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122306","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70922","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72311","المنسرح"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216673",""],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93102","الرمل"],[1730,"","https://poetry.dctabudhabi.ae/diwan/poem/121897","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66262","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199808","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27946","الرمل"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111088","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77302","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77399","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121021","الرجز"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123649","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106843","السريع"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87811","الرمل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132572","الخفيف"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205579",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205484","الرمل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199023","الرجز"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128894","الخفيف"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111427","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107501","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136600",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28719","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4767,"إلى شيخ مصر الشهيد حسن شحاتة","https://www.poetsgate.com/ViewPoem.aspx?id=147142",""],[4791,"اجمع الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=36959",""],[4859,"غيهب التأويل!","https://www.poetsgate.com/ViewPoem.aspx?id=197784",""],[4119,"سطرا عذار مونق خطه","https://www.poetsgate.com/ViewPoem.aspx?id=16149",""],[5055,"حسابي للنجوم","https://www.poetsgate.com/ViewPoem.aspx?id=103545",""],[5122,"حال القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=27775",""],[1420,"في أول النزلة فصد وفي","https://www.poetsgate.com/ViewPoem.aspx?id=87629",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[308,"قل لي مَا شَيْء إِذا رمت إِن","https://www.poetsgate.com/ViewPoem.aspx?id=189406",""],[5848,"شاطي الدمام","https://www.poetsgate.com/ViewPoem.aspx?id=48953",""],[5848,"رسالة قديمة","https://www.poetsgate.com/ViewPoem.aspx?id=53464",""],[5885,"درب البهاء","https://www.poetsgate.com/ViewPoem.aspx?id=194671",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""],[6257,"صعلكة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87176&r=&rc=1",""]],"verses":[["بَينَ هَمٍّ تَحتَ المَناسِمِ مَطرو","حٍ وَعَزمٍ عَلى ظُهورِ الجِيادِ",0,"د",1,0],["بَيِّنَةً من منطق محكمٍ","فَنَّنْتُهَا فيك وصرَّفْتُها",1,"ت",3,0],["بينها حلي نفيس","كفؤه تلك الحقاق",2,"ق",1,0],["بينها غادةٌ تُشارك فيها","بهجةَ الشمسِ صورةُ التمثالِ",3,"ل",1,0],["بَيَّنَهُنَّ بِبَينٍ ما يُبَيِّنُهُ","صَحبي وَما بِعُيونِ القَومِ مِن عَوَرِ",4,"ر",1,0],["بينهما لو علمتِ حرب","لابد أن يغلب الممات",5,"ت",1,0],["بينهما بعد فمن طالع","في أفق الشرق ومن غاربِ",6,"ب",1,0],["بينها بركة تسل على خض","رة بستانها سيوف السواقي",7,"ق",2,0],["بَينَهُم مالِكٌ وَعَمرٌو وَعَوفٌ","وَعُقَيلٌ وَصالِحٌ بنُ هِلالِ",8,"ل",1,0],["بينهما بالبدنِ التفرُّقُ","طَوْعاً فما لأحدٍ تَعَلُّقُ",9,"ق",1,0],["بينهما بَوْنٌ بعِيدٌ إذا","قايستَ بينَ العِلقِ والعِلق",10,"ق",1,0],["بَينَهُمُ كَالغِمامِ شادِيَةٌ","تومِضُ في مَلبَسٍ كَقَوسِ قُزَح",11,"ح",1,0],["بَيّنْهُ لي إن كُنتَ ذا فِطْنَةٍ","فإنّني قد جِئْتُ بالتّرْجَمَهْ",12,"م",2,0],["بين هذي الخمائل الحالماتِ","وهي تهتزّ رغدةً في الفضاء",13,"ا",2,0],["بَيِّنَة ً من منطق محكمٍ","فَتَّنْتُهَا فيك وصرَّفتُها",14,"ت",3,0],["بين هذا وذاك نهج حميد","آمنٌ من يجوزه كلّ شرِ",15,"ر",1,0],["بينهم يا ضيعتي جماعة","تعصبوا بينهم ياضيعتي",16,"ت",2,0],["بينهما أخيب من فعله","مديرة زفّت إلى مدبر",17,"ر",1,0],["بين همس الشفاه والأحداق","والليالي خمريّة الأشواق",18,"ق",1,1],["بين همس الشفاه والأحداق","والليالي تفيض بالعشاق",19,"ق",1,1],["بينَهما بالسواء سُقمٌ","بواحدٍ منهما مُضِرُّ",20,"ر",1,0],["بَيِّنْهُ لي يا من غدا كل فتى","يقصر عن إدراك نيل فضله",21,"ل",2,0],["بيِّنةٌ ظاهِرةٌ فخُذْ بها","ودعْ سبيلَ كاذِبٍ قدِ ادَّعَى",22,"ا",1,0],["بَينَ هذِي الربُوعِ أسكُبُ دَمعِي","إنَّ ربعَ الرسُولِ أشرفُ رَبعِ",23,"ع",1,1],["بينهم البلاء عند المشهد","بمن يكون كان منهم يقتدي",24,"ي",1,0],["بيّنة فأحضرت عليا","فقال لو كنا ادعينا شيئا",24,"ا",2,0],["بينهما فيما مضى مما سلف","ذكرى لها ثم أتتها بسرف",24,"ف",1,0],["بَينَهُ في الذكاءِ وَبَينَ سِواهُ","فَرَقَّ ما بَينَ أَميَلٍ وَمُكَفِّر",25,"ر",1,0],["بَينهم عمّهم له خرّ وجهٌ","شعّ بينَ الأنام للناسِ صَبرا",26,"ر",2,0],["بين هوى لخانل ومدحه","لباخل وفرقة لغادي",27,"د",2,0],["بينهم صار كلُّ حِجْرٍ حرامٍ","مَشْرباً في عيوب شَرْبٍ عِطاش",28,"ش",1,0],["بينه للعقول ان نظرت","تبارك اللّه موضع السبل",29,"ل",1,0],["بين هزْل الدَّلع والجدِّ","لعبة العشَّاق مخطوره",30,"ر",2,0],["بينهم قطب رحى الإمكان شبل المرتضى","ملكٌ دان له دون الورى أمر القضا",31,"ض",2,0],["بينها زينب تسعى عجلا وهي الوقور","فتساقطن عليه وهو محزوز الوريد",31,"د",1,0],["بينهما أشلاء لحمٍ مقتسم","فامض ولا يأخذك باللحم القرم",32,"م",1,0],["بينهم من بني النصارى طروب","ضلَّ فيها أحكام دين النصارى",33,"ر",2,0],["بين هذين وهي حسب","المحاباة لما يستطيعه أواها",34,"ا",3,0],["بينهم في الحب ميزاني","بالتبادل تنفتح اعطوره",35,"ر",2,0],["بينهم تبصرهم قد وقفوا","في المحاريبِ وصفوا القدما",36,"م",2,0],["بينهم والماء حالت ظلمة","من جموع عدها لا يتناهى",37,"ا",3,0],["بَينَ هَذا البَيتِ وَالكَع","بَةِ عَهدٌ أَو ذِمام",38,"م",1,0],["بَينَ هَذي البِحارِ بَينَ الرَواسي","بَينَ تِلكَ الكَواكِبِ الزاهِراتِ",39,"ت",1,0],["بيِّنهُ فهوَ في كتا","بِ الله بادي التعريف",40,"ف",1,0],["بينهم كل فصيح ناطق","بلسان عربي ذي عوج",41,"ج",1,0],["بينهما قد نشرت عطرها","ثغرو هذي الروضة الزاكيه",42,"ي",2,0],["بينهم حَقائقُ العَوالمِ","فأدركُوا فيكَ جَميعَ العالَمِ",43,"م",1,0],["بَينهم فتنة المشوق لَميس","لارمت اسهم البعاد لميسا",44,"س",2,0],["بَينَ هاتيك الرَوابي وَالسُهول","وَشِعاب الهُضُب المُرتِفِعات",45,"ت",1,0],["بينَهُ في أَمكِنَةٍ طريقُ","عروكُ ساكنونَ يا حبيبي",46,"ي",1,0],["بَينَهُمَا يُوصِفُ خَمسَ طُرُق","الغَربَ والأوساطَ ثمَّ الشَّرَق",46,"ق",1,0],["بينهما أربعَةٌ أزواما","في آخرِ المَفرضِ يا هماما",47,"م",2,0],["بينهما غبٌّ قليلُ الماءِ","إِحذَر بأن تُقبِل على الجوزاءِ",47,"ا",2,0],["بَينَهُمُ طَريقُ لِلمُسَافِر","وَإن تُخَلِّفهُم تَرَ الجَزَايِر",48,"ر",1,0],["بينَ هراميزَ وبَينَ الباطِنَه","ومِن عَدَن لفرتكٍ كُن فاطِنَه",49,"ه",1,0],["بينهم غضة الشبيبة هيفاء","كغصن الاراكة المياد",50,"د",1,0],["بينهما في البعد كالذراع","تعرفه العرب بكلب الراع",51,"ع",1,0],["بينهما نجم يسمى الملكى","تراه من أضوء نجوم الفلك",51,"ك",1,0],["بَينَ هذا غَذاً يَصيرُ المُغَذَّى","لِحَياةِ الوُجودِ حَذوَ النّعالِ",52,"ل",1,0],["بينها الزهر والثمَرْ","بينها الشمس والقمَرْ",53,"ر",1,0],["بينها التبر والدرَرْ","والمصابيح والشرَرْ",53,"ر",1,0],["بين هذين لنا حدٌّ قوامْ","وليلُمْ من كل حزب من يلومْ",54,"م",1,0],["بينة في حجج العقول","شاهدة بالصدق للرسول",55,"ل",1,0],["بينهم للآداب قدر عظيم","ولحفظ الوداد فيهم مآثر",56,"ر",1,0],["بينهما العموم من وجه لما","تصادقا وافترقا بينهما",57,"م",2,0],["بينهم قد أودعت إكراما","لمن محا بالعدل شر الوزر",58,"ر",1,0],["بينهم فتنة والغوغاء","كذا مبيد الأمم القضاء",58,"ا",2,0],["بينهم فتىً بعودٍ قاما","مردِّداً بنقره الأنغاما",58,"م",2,0],["بينهم بونٌ فهم يبلونا","غِبّاً وهول الحرب يتقونا",59,"ن",2,0],["بينهم قد حمي الوطيس","بهمةٍ ما عليها آريس",59,"س",1,0],["بَينَهُنَّ النَفسُ في الصيدِ تَهيج","فَاِنبَروا كُلٌّ عَلى عامِلهِ",60,"ه",1,0],["بينهم شق الصفوف الأولا","مذ إلى الإغريق إبان النزال",60,"ل",1,0],["بَينَهُم من أَراهُ أَضخَمَ جِسماً","مِنهُ لَكِن أَنَّى لِذا الحُسنِ ثاني",61,"ن",2,0],["بين هَيفٍ وزَعزَعٍ ودَروجٍ","وسمومٍ وعاصفٍ مرنانِ",62,"ن",1,0],["بينهما يُسفك الغداةَ دمي","وفي سَبيل الغرام قد سُفكا",63,"ك",2,0],["بَينَ هجرانٍ وَبُعد أَجَّجا","في بَناتِ القَلبِ ناراً تَستَعِر",64,"ر",1,0],["بينهم ليس دليل الشجن","ما تراهم وقفوا صفاً فصفّ",65,"ف",1,0],["بينهم شيخٌ كبدرٍ","من بَهاءٍ ذو مكانة",66,"ن",2,0],["بين همٍ خفيف وبين همٍ ثقيل","أترجى وصالك وأحترق في رجاك",67,"ك",1,0],["بينهم صرتُ يازماني غريبا","بعد أن كان في حماهم مقيلي",68,"ل",2,0],["بينهما روضة ورد لها","من خالها الأسود ناطور",69,"ر",1,0],["بين (ه ) الدنيا ولفتات القروم","حطمت كل السفن والأشرعة",70,"ع",2,0],["بينه وبين ألمحبره حب وعناق","حب(ن) قديم وصار مولد قصيده",71,"د",2,0],["بينهما ماء شعير به","صحت من النزلة أجسام",72,"م",1,0],["بينها بيضاء آنسة","مثل قرن الشمس عن أمم",73,"م",1,0],["بين هذي الأشيا وإن هي لذت","لصراخ يهوي بشر القضاء",74,"ا",2,0],["بَينه لَا زلت فصيح اللها","فَإِنَّهُ لم يخف عَن بالك",75,"ك",1,0],["بينهم قلت اغسل احلامي بتنهيدة قوافي","قبل اعرف ان الشعر تنهيدة الروح الخفيّة",76,"ي",2,0],["بينه وبينه ما شغله انشغاله","في غيرك الا فيك ذكرى مقيمه",77,"م",2,0],["بينه والخلود درب قصير","لا تراه إلا عيون البهاء",78,"ا",2,0],["بينَ هجرٍ أو وصالٍ تَرتَضي","رحلةَ العُمرِ الشّجي إذْ يجمعكْ",79,"ك",1,0],["بينه والزمان شكل ومعنى","كلما استغلقا يفضّ حرامَهْ",80,"م",2,0]]}