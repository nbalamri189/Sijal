4","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66163","المتدارك"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33592","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4699,"يا مالكةً قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=153978",""],[4991,"كويت العز","https://www.poetsgate.com/ViewPoem.aspx?id=187518",""],[5057,"سلوة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=197255",""],[5121,"أُنْشُودَةُ السَّهَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=33583",""],[5130,"راحة الصب غيبة الرقباء","https://www.poetsgate.com/ViewPoem.aspx?id=152663",""],[5183,"عالي الجناب","https://www.poetsgate.com/ViewPoem.aspx?id=186607",""],[5198,"سلطنة","https://www.poetsgate.com/ViewPoem.aspx?id=136229",""],[5213,"انشقاني من ربع مية طيبا","https://www.poetsgate.com/ViewPoem.aspx?id=170409",""],[5219,"الأماني المنشودة","https://www.poetsgate.com/ViewPoem.aspx?id=194625",""],[5277,"بغدادُ","https://www.poetsgate.com/ViewPoem.aspx?id=198623",""],[5606,"ماياجيك باس","https://www.poetsgate.com/ViewPoem.aspx?id=196788",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5873,"عطر الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=215310",""],[5894,"يا حداة السرى بحث المطي","https://www.poetsgate.com/ViewPoem.aspx?id=131438",""],[6124,"سقيم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=159785",""],[456,"عروس الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84502&r=&rc=1",""],[6288,"مسيرة العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79611&r=&rc=37",""]],"verses":[["يا سَلْمُ شَفَّ الجِسمَ وَعدُكِ لِي","بِرضىً يَشِفُّ وَراءَهُ سُخطُ",0,"ط",1,0],["يا سَلمَ ما بِالشَيبِ مَنقَصَةٌ","لا سوقَةً يُبقي وَلا مَلِكا",1,"ك",2,0],["يا سَلمَ ذاتَ الوُضَّحِ العِذابِ","وَرَبَّةَ المِعصَمِ ذي الخِضابِ",2,"ب",1,1],["يا سليل الفقيد أعظم بمجدٍ","قد رزئناه في أبيك مجيدا",3,"د",2,0],["يا سلوِّي عليهِ عليه بُعداً وسُحقاً","واشْتياقي إليه أهلاً وسهلا",4,"ل",2,0],["يا سليباً من الملا","حَةِ والحسن والبَهَجْ",5,"ج",1,0],["يا سليمان ظماءً","قُطِعَت عنك السواقي",6,"ق",2,0],["يا سليمانُ لا ألومك في ردْ","دِك شعري وهل تُلام البهيمَهْ",7,"م",2,1],["يا سُلافَ الفُؤادِ يا سُمَّ نَفْسي","في حَيَاتي يا شِدَّتي يا رَخَائي",8,"ي",1,0],["يا سليمى أفرطتِ في الصرم رفقاً","يا سليمى بالعاشق المعمود",9,"د",1,0],["يا سِلاحَ العَصرِ بُشِّرنا بِهِ","كُلُّ عَصرٍ بِكَمِيٍّ وَسِلاح",10,"ح",1,0],["يا سَلمُ كَم مِن جَبانٍ قَد صَبَرتَ بِهِ","تَحتَ السُيوفِ وَلَولا أَنتَ ما صَبَرا",11,"ر",2,1],["يا سلئلي عن عليٍّ كَيفَ شِيمَتُهُ","أنظُرْ إلى الشُّكْرِ مَقْروناً به النِّعَمُ",12,"م",1,0],["يا سَليماً مِن داءِ قَلبي السَليمِ","وَمُقيماً عَلى الوِدادِ القَديمِ",13,"م",1,1],["يا سلوتي في الدهر يا قيثارتي","ما لي أراك حبيسة الألحان",14,"ن",1,0],["يا سُلَيمانُ تَرَّفَ اللَهُ أَرضاً","أَنتَ فيها بِمُستَهِلِّ الغَمامِ",15,"م",1,0],["يا سَلمَ عَرَّفَني المَشي","بُ وَحَقُّ لي أَن أَعرَفا",16,"ف",2,0],["يا سُلَيمانُ غَنِّني","وَمِنَ الراحِ فَاِسقِني",17,"ن",2,1],["يا سَلمَ إِنّا تَأَيّاني لَكُم مَلِكٌ","حِبُّ الوَفاءِ وَشَوقي غَيرُ تَعذيرِ",18,"ر",1,0],["يا سَلمَ إِن تُصبِحي بَسلاً مَحَرَّمَةً","وَتَنزِلي في مُنيفٍ بَينَ أَرصادِ",19,"د",1,0],["يا سَلمَ هَل قَيِّمُكُم ماكِثُ","وَهَل لِغادٍ مِن غَدٍ رائِثُ",20,"ث",1,1],["يا سَلمَ إِنّي مِن مَلالِ الهَوى","في نَصَبٍ يَفري وَيَستانِثُ",20,"ث",1,0],["يا سَلمَ رُجعاكِ بِمَيتِ الهَوى","كَما تُميتُ الحَيَّةُ النافِثُ",20,"ث",1,0],["يا سَلمَ إِنَّ الرِزقَ جَمٌّ وَقوت","وَلَيسَ بَعدَ القَولِ إِلّا السُكوت",21,"ت",1,1],["يا سَلمَ نَفسي بِكِ مَشغولَةٌ","شُغلَ وِدادٍ دامَ لي ما حَيِيت",21,"ت",1,0],["يا سَلمَ طابَ لَكِ الفُؤا","دُ وَعَزَّ سُخطُكِ فَاِحتَمَيتُه",22,"ت",2,0],["يا سَلمَ عِرضي حِمىً سَأَمنَعُهُ","وَالعِرضُ يُحمى وَيوهَبُ الذَهَبُ",23,"ب",1,0],["يا سَلمَ إِنّي اِمرُؤٌ يُوَقِّرُني","حِلمي إِذا القَومُ في الخَنا وَثَبوا",23,"ب",3,0],["يا سَلمَ هَل تَذكُرينَ مَجلِسَنا","أَيّامَ رَأسي كَأَنَّهُ عِنَبُ",24,"ب",1,0],["يا سَلمَ جودي بِما رَأَيتِ لَنا","ما عِندَ أُخرى سِواكِ لي أَرَبُ",24,"ب",1,0],["يا سَلمَ أَنتِ الهَوى إِذا شَهِدَ ال","ناسُ وَأَنتِ الهَوى إِذا ذَهَبوا",24,"ب",3,0],["يا سُلَيمى قومي فَروحي إِلَيهِ","أَنتِ سُرسورَتي مِنَ الخُلَطاءِ",25,"ا",2,0],["يا سلوة النفس التي ذهبت فما","يرجى لها بعد الذهاب رجوع",26,"ع",1,0],["يَا سَلِيلَ الْكِرَامِ مِنْ عُنْصُرٍ يُرْ","جِعُ فِي جَاهِهِ إِلى آمَادِ",27,"د",1,0],["يَا سَلِيمَ الضَّمِيرِ وَالْقَلْبِ فِي أَشْ","رَفِ مَعْنىً وَفِي أَعَزِّ مُرَاد",28,"د",1,0],["يا سُلَيْمانَ الزَّمانِ أَفِقْ","لَيْسَ لِلَّذّاتِ مِنْ ثَمَن",29,"ن",1,0],["يا سليلَ الصِّيدِ البهاليلِ من نَسْ","ل «نِزارٍ»، هلا خَلَفْتَ الجدودا؟",30,"د",2,0],["يا \"سلم\" هل قيمكم ماكث","وهل لغادي من غد رائث",31,"ث",1,1],["يا \"سلم\" إني ملال الهوى","في نصبٍ يفري ويستأنث",31,"ث",1,0],["ياسلام الله على اللي حبها.؟ بين المحاني..","فارعن بلحالها....؟ تسوى ثمانمية....؟؟ بديده......",32,"د",2,0],["يا سليل الآل آل المرتضى","غيركم يا سيدي ما لي احد",33,"د",1,0],["يا سليلَ الإمام سلطانَ سيف","أنت أهدَى الورَى وأزكَى وأَتقَى",34,"ق",2,0],["يا سليلَ الكرامِ صارتْ لك الأ","عداءُ بالجودِ والسخاءِ شهودا",35,"د",2,0],["يا سليلَ الإمام سلطانَ لاَ","زِلْتَ إماماً ولا برحتَ تُنادَى",36,"د",2,0],["يا سُلّم الجهَّالِ بل يا عنوة ال","عُذَّالِ بل يا أثقلَ الثُّقلاءِ",37,"ا",2,0],["يا سَلمَ كُنتِ كَجَنَّةٍ قَد أَطمَعَت","أَفنانُها دانٍ جَناها موضَعُ",38,"ع",1,1],["يا سُلَيمى يا سُلَيمى","كُنتِ لِلقَلبِ عَذابا",39,"ب",2,1],["يا سُلَيمى اِبنَةَ عَمّي","بَرَدَ اللَيلُ وَطابا",39,"ب",2,0],["يا سُلَيمانُ جَرِّدِ العَزمَ قُدماً","تُدرِكِ الوِترَ مُنجداً وَهوَ نولُ",40,"ل",1,0],["يا سُلَيمَ بنَ مالِك المُنتَمي قَد","هَدَّنا السَيِّدُ العَميدُ القَتيلُ",40,"ل",1,0],["يَا سُلَيمَانَ أبنَ عَبدِ","اللهِ هَذَا يَومُ عِيدٍ",41,"د",1,0],["يا سليل الخال صبراً بعدَهُ","أنت أعلَى أن تُسَلِّي وأجَل",42,"ل",1,1],["يا سَلمَ باعَدَ ربُّ النَّاسِ مُصبَحَكُم","مِنَّا وَباعَدَ مِن مُمسَاكِ مُمسَانَا",43,"ن",2,0],["يا سُلَيمى وَقد أَثارَ نُحولي","كامِناتِ الرَدى عَلى العِشرينِ",44,"ن",1,0],["يا سُلَيمى أَنا أَموتُ ضحوكاً","لَيسَ هذا الوجودُ عَبرَ مجونِ",44,"ن",1,0],["يا سُلَيمى وَكم أُنادي سُلَيمى","فَاِسمُها بِلسمٌ لِقَلبي الحَزينِ",44,"ن",1,0],["يا سُلَيمى أُغنيَّةُ المَوتِ هذي","وَمراراً أَنشَدَتها في جُنوني",44,"ن",2,0],["يا سُلَيمان أَيُّ نَعشٍ مجيد","حلَّ فيهِ جَلال صَدرِ مَجيدِ",45,"د",1,0],["يا سُلمَ إِن ضاعَت عُهودي عِندَكُم","فَأَنا الَّذي اِستَودَعتُ غَيرَ أَمينِ",46,"ن",1,0],["يا سَلمَ إِنَّ الحُبَّ أَسلَمَني إِلى","شُغلَينِ مِن وَجدٍ بِكُم وَوُلوعِ",47,"ع",1,0],["يَا سَلِسَ الأَلْفَاظِ عَذْبَ الْمَذَاقْ","وَابْنَ الأُلَى رَاضُو الْمَذَاكِي الْعِتَاقْْ",48,"ق",1,1],["يَا سُلَيْمَانُ قَدْ تَرَكْتَ صَلاَةَ الصُّبْ","حِ حَتَّى رَأَيْتَ قَرْنَ الشَّمْسِ",49,"س",1,1],["يا سليل الكرام من آل سيفا","والألى ما بهم مجون ولغو",50,"و",1,0],["يا سلوى أنجد فؤادي وإلا","ذاب وسط الحشا أما لك نخوه",51,"ه",1,1],["يَا سَلِيلَ الخُلَفَاء السَّادَة ال","مُظهِرِين العَدلَ لَمَّا طَمسا",52,"س",2,0],["يا سُلَّماً ألفاهُ يعقوبُ الفتى","في بيت إيلٍ وهوَ في المنفاءِ",53,"ا",2,0],["يا سلم خير أن نراك مزعزعا","من أن نرى للحرب سوقا بيننا",54,"ن",2,1],["يا سَليمَ القلبِ منْ غِشٍّ يَرى","خُدَعَ الآراءِ آثاماً وعارا",55,"ر",2,0],["يا سَلمُ لَيتَ لِساناً تَنطِقينَ بِهِ","قَبلَ الَّذي نالَني مِن حُبِّكُم قُطِعا",56,"ع",2,0],["يا سلوتي فيه لا تقربي","وإن كنت دانيةً فاِبعدِي",57,"د",2,0],["يا سُلَيمانُ إِن تُلاقِ الثُرَيّا","تَلقَ عَيشَ الخُلودِ قَبلَ الهِلالِ",58,"ل",1,0],["يا سَلمَ نَأيُ الدِيارِ عَن بَلَدِ ال","والِدِ ذُلٌّ وَرُحبُها ضَيَقُ",59,"ق",1,0],["يا سليلَ القُضاةِ من آل جَعْدٍ","مُنتهى العلم والذّكا والنجابَهْ",60,"ب",2,1],["يا سلوة المحزون وابن أبي الحمى","أقبل وجدِّد للحمى آمالَهُ",61,"ل",2,1],["يا سليمى أنقذت قومك رفقاً","ورددت النيران برداً سلاما",62,"م",2,0],["يا سَليمَ الطّبعِ ذا الفَهمِ الدّقيقْ","وَأَخا اللّطفِ وَحسنَ الأدبِ",63,"ب",1,0],["يا سليل الكرام حسبك فخراً","ما ترسّمت من جليل المعاني",64,"ن",2,0],["يا سَلوة العاشق يا بُغية الراجى","المعَنَّى يا خِيارَ الخيارْ",65,"ر",1,0],["يا سليلَ الفتى الكريم خميس","لك فضلٌ به سبقتَ الكراما",66,"م",2,0],["يا سلوةَ الصبِّ بادرْ","قمْ وانتبهْ مِنْ نعاسكْ",67,"ك",1,1],["يا سليمي ترفقي بمعنى","حمّليه من الهَوى ما يُطيق",68,"ق",1,0],["يا سلم أني والذي","رفع