{"poems":[[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[63,"ترنح من برح الغرام مشوق","https://www.aldiwan.net/poem46136.html","الطويل"],[63,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[3,"أعادي صرف دهر لا يعادى","https://www.aldiwan.net/poem145.html",""],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[88,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[72,"تخيلت في إنشاء لفظي نجعة","https://www.aldiwan.net/poem18279.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[45,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[45,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[28,"وكم من ناذرين دمي رمتهم","https://www.aldiwan.net/poem5218.html","الوافر"],[28,"وحرف كجفن السيف أدرك نقيها","https://www.aldiwan.net/poem5326.html","الطويل"],[61,"أهجرا كان صدك أم ملالا","https://www.aldiwan.net/poem51492.html","الوافر"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[61,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[58,"وكم خليل لك خاللته","https://www.aldiwan.net/poem31115.html","السريع"],[49,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[66,"إذا علم العدا عنك انتقالي","https://www.aldiwan.net/poem40101.html","الوافر"],[69,"فقلت وقد أنكرت منه مقالة","https://www.aldiwan.net/poem29297.html","الطويل"],[102,"بها لم تقع العين","https://www.aldiwan.net/poem33031.html","الهزج"],[46,"قد أسرف الإنس في الدعوى بجهلهم","https://www.aldiwan.net/poem22087.html","البسيط"],[46,"ألا إن الظباء لفي غرور","https://www.aldiwan.net/poem22262.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[106,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[115,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[132,"أبرق لاح من خلل الغمام","https://www.aldiwan.net/poem54734.html","الوافر"],[142,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[143,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[147,"إلى الصون مدت تلمسان يداها","https://www.aldiwan.net/poem47691.html","الطويل"],[155,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[160,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[169,"اليوم سر العلا واستبشر الأدب","https://www.aldiwan.net/poem1607.html",""],[185,"سلام على الثغر الذي طال عنهده","https://www.aldiwan.net/poem14510.html","الطويل"],[221,"أيسلو فؤادي أو أكتم","https://www.aldiwan.net/poem55305.html","المتقارب"],[259,"على فقد شهر الصوم تجري المدامع","https://www.aldiwan.net/poem35731.html","الطويل"],[271,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[275,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[282,"لقد سرني لما سرى طيف مية","https://www.aldiwan.net/poem32851.html","الطويل"],[364,"أضم على قلبي يدي من الوجد","https://www.aldiwan.net/poem60941.html","الطويل"],[364,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[366,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[371,"تبيت أحاديث الهوى لك تفتري","https://www.aldiwan.net/poem57453.html","الطويل"],[377,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[377,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[377,"الله الله أنت السمع والبصر","https://www.aldiwan.net/poem59432.html","البسيط"],[393,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[402,"وكم خلي يلوم جهلا","https://www.aldiwan.net/poem46653.html","المنسرح"],[402,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[403,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[403,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[403,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[409,"ديار الهوى حيا معالمك","https://www.aldiwan.net/poem31696.html","عموديه"],[416,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[432,"تغير عن مودته وحالا","https://www.aldiwan.net/poem12316.html","الوافر"],[432,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[439,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[439,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[441,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[458,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[461,"إذا المرء لم يستخلص الحزم جنة","https://www.aldiwan.net/poem15140.html","الطويل"],[461,"أظن القوافي ساورتها صبابة","https://www.aldiwan.net/poem15311.html","الطويل"],[464,"أنجل علي ما برحت محمداً","https://www.aldiwan.net/poem3305.html","عموديه"],[464,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[477,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[482,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[506,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[551,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[575,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"]],"verses":[["وَكَم خالَطَ الباكينَ مِن سِنِّ ضاحِكٍ","وَبَينَ رُغاءِ الرازِحاتِ صَهيلُ",0,"ل",1,0],["وَكَم خاضَ تَأمورَ الظَلامِ بِفِتيَةٍ","يَرَونَ وُعورَ اللَيلِ مِثلَ سُهولِ",1,"ل",1,0],["وكمْ خَلّفَتْ أنْضاؤُها منْ مَعاشِرٍ","تَساوَى صَهيلٌ عندَهمْ ونَهيقُ",2,"ق",1,0],["وكَمْ خَلّفْنَ منْ طَلَلٍ بحُزْوى","وسَمْتُ عِراصَهُ مَرَحاً بِبُرْدي",3,"ي",1,0],["وَكَم خَلَّفتُ مِن بِكرٍ رَداحٍ","بِصَوتِ نُواحِها تُشجي الفُؤادا",4,"د",2,0],["وَكَم خَلَّفَت أَعناقُها مِن نَحيزَةٍ","وَأَرعَنَ مِن قودِ الجِبالِ خُشامِ",5,"م",1,0],["وكم خشف بمربعهم وظبيٍ","يمرّ مع الجدَاية والمهاة",6,"ه",1,0],["وكم خلتُ في فنِّ الحساب إفادة","فكانَ حسابُ الدهرِ غيرَ حسابي",7,"ي",1,0],["وكم خَانِ سَفْرٍ خَانَ فانقضَّ فوقهم","كما انقضَّ صقرُ الدجنِ فوق الأرانبِ",8,"ب",1,0],["وَكَم خَلَّيتُ عِندَكِ مِن لَيالٍ","مُعَشَّقَةٍ وَأَيّامٍ قِصارِ",9,"ر",1,0],["وَكَم خَسَأوا الحُسّادَ وَاِستَحدَثوا لَهُم","خَساسَةَ حالٍ مِن نَباهَةِ حالِ",10,"ل",1,0],["وَكَم خَبَطَت بِأَرساغٍ وَجَرَّت","نِعالَ الجِلدِ وَهيَ إِلَيكَ تَسري",11,"ر",2,0],["وَكَم خَبَطَت نَعلاً بِخُفٍّ وَمَنسِمٍ","تُدَهدي بِهِ صُمَّ الجَلاميدِ راعِفِ",12,"ف",1,0],["وكَم خَرَقَ الصِّبا بذوي التَّصابي","إلى خُرسِ الحُجولِ بِها الحِجالا",13,"ل",2,0],["وكم خُطَّةٍ حاولتَها فاستَطَعْتَها","بِسَيْفِكَ والأيَّامُ لا تَستَطيعُها",14,"ع",3,0],["وكم خرَقَ الحِجابَ إلى مَقامٍ","توارَى الشَّمسُ فيه بالحِجابِ",15,"ب",1,0],["وكم خضعت بخرشنة قلوب","وقد خفقت بعقوبته العقاب",16,"ب",1,0],["وَكَم خَليلٍ لَكَ خالَلتَهُ","لا تَرَكَ اللَهُ لَهُ واضِحَة",17,"ه",1,1],["وَكَم خامِدٍ تُخفيهِ ضَغطَةُ حُفرَةٍ","وَقَد كانَ في الدُنيا يَصيحُ وَيُرهِجُ",18,"ج",1,0],["وَكَم خاطَرتُ فوكَ بِبَذلِ نَفسي","وَأَعلَمُ أَنَّ بالي فيكَ بالي",19,"ي",1,0],["وكم خفقَتْ فيها البنودُ وَكَمْ حَوَتْ","ملوكاً ترى الجوزاءَ تحتَ نعالِها",20,"ل",3,0],["وَكَم خالٍ مِن الاسقا","م ردّوه وَقَد أَشرَف",21,"ف",1,0],["وَكَم خَنَت مِن هَجولٍ حُجِّبَت وَوَفَت","مِن حُرَّةٍ ما لَها في العينِ جِلبابُ",22,"ب",1,0],["وَكَم خَدَعَت هِزَبراً كانَ جَبراً","مِنَ الأَملاكِ ذاتُ حُلىً وَدَرجِ",23,"ج",1,0],["وكم خريفٍ في نشيدٍ بديعْ","تظلُّ ترويه ليالي الشتاءْ",24,"ا",2,0],["وكم خُطىً أحْسَسْتُها في دمي","أقولُ قد جاءَ وهذي خطاه",25,"ه",1,0],["وَكَمْ خَلَبَ الأَلْبَابَ مِنْهُ بِمَوقِفٍ","بَلِيغُ حِوَارٍ أَوْ سَدِيدُ جَوَابِ",26,"ب",1,0],["وكم خِلٍّ حميم لم أزُرهُ","وبي شوقٌ إِلى الخِلِّ الحميم",27,"م",1,0],["وكم خصمت بالمعنى خصاما","دهاهم من جلالتك انتقام",28,"م",1,0],["وَكَم خودٍِ نَكَحتَ بِغَيرِ مَهرٍ","عَلَى رَجَفانِ رعيِكَ لِلذِّمامِ",29,"م",1,0],["وكم خُطّة أَفردتهُ الرجا","لُ فيها وولت شَعاعا عِضينا",30,"ن",2,0],["وَكَم خَلَفتَ الحَيا أَوقاتَ غَيبَتِهِ","عَن ذي البِلادِ وَلَم يَخلُفكَ حينَ هَما",31,"م",2,0],["وكم خاطبٍ لم يدع كفئاً لها ولم","يشم طرفاً من وشي ذيلِ رداها",32,"ا",3,0],["وكم خاض نقعاً يُمْطِرُ الهامَ وقْعُهُ","إِلى المَوتِ في صَفَّيْ قَناً وقواضبِ",33,"ب",1,0],["وكم خرجت تواقيع ببشرى","على أيدى الملئكة الكرام",34,"م",1,0],["وَكَم خَلاءٍ مَخُوفٍ قَلبُ سالِكِهِ","لِلخَوفِ مِثلَ لِواءِ الجَيشِ يَضطَرِبُ",35,"ب",1,0],["وكم خُلْسة للَّثْم فيها كأنها","على طمأٍ عذبُ المذاق بَرود",36,"د",1,0],["وكم خطر إن أبحناه عن","جموح غرائزنا ينجم",37,"م",1,0],["وكم خفقت مذ جاء ألويةُ الهدى","وكم أعينٍ قرّت ولذّت مسامع",38,"ع",1,0],["وَكَم خَلائق لا يحصون غيرهم","في نهج خرقتنا تاهو أَو ما تاهوا",39,"ا",1,0],["وَكَم خَطبتْ على الأسوارِ هامٌ","رَماها الجِدُّ بالجَدِّ العثورِ",40,"ر",1,0],["وَكَم خائِضٍ في النارِ حُبّاً لِجَنَّةٍ","وَوَجنَةُ مَن أَهواهُ ناري وَجَنَّتي",41,"ي",1,0],["وكم خاطبٍ إحدى بناتِ خواطري","بمَهْرَيْنِ من جاهٍ وسيعٍ ومن رِفد",42,"د",1,0],["وكم خامِلٍ لا يَهْتدي لنباهةٍ","بغَيْرِ وقُوعٍ منه في عِرْضِ راجح",43,"ح",1,0],["وَكَم خَلَقَ العِذارُ عَلَيكَ حُبّاً","وَمِن عُجبٍ بِهِ سَحَبَ الرِداءَ",44,"ا",2,0],["وكم خبرٍ لو صحَّ لم يبقِ منهُمُ","لمُستَخبِرٍ عَنهُم وعَنكَ مخبِّرا",45,"ر",2,0],["وكم خبّأت في نفسي كنوزاً","فقد وأبيك أغنتني الخبايا",46,"ا",3,0],["وكم خمرةٍ ساءت بعقل نديمها","فكانت سواءً وهي صهباء قَرقَف",47,"ف",1,0],["وكم خرقتَ حجاباً كان من قِبَلي","قد بُدِلَّت عنه حجبٌ ما بها قِصَر",48,"ر",1,0],["وَكم خَبَرٍ في خَيبَرٍ قَد رويتُمُ","وَلكنَّكم مثل النعام تشرَّد",49,"د",1,0],["وكم خلّي يلومُ جهلاً","وكلّ من حَبَّ لا يُلامُ",50,"م",1,1],["وكَمْ خَلفَ السُّتورِ جَنَيتُ ذنباً","وربُّ العرش مُطلِّعٌ خبيرُ",51,"ر",1,0],["وكم خُضْتُ من بحر الرواية أبحراً","وسألت عن تحقيقها كلَّ مخبر",52,"ر",1,0],["وكم خضنا بحوراً من علوم","بتحقيق تجاوز كل حد",53,"د",1,0],["وكم خدمت مقالته أناس","هم مثل المؤيد والشهاب",54,"ب",1,0],["وكم خاطب ردته لم يك كفأها","إلى أن أتاها خاطب سيفه المهر",55,"ر",1,0],["وكم خمرٍ معتّقةٍ رآها","ففضَّلها على الخلِّ العتيق",56,"ق",1,0],["وكم خَلُصَتْ سريرة من يُعادَى","وكم كدُرَتْ سريرةُ من يُوالَى",57,"ل",2,0],["وكم خدعَتْنا من ملوك يسُرُّها","لو انّكَ ترضى أنها لك أعبُدُ",58,"د",1,0],["وكم خاضُوا كَهِمَّتِهِمُ بُحوراً","وكم عَدِمُوا الثَّرى عَدَمَ الثَّرَاءِ",59,"ا",2,0],["وكم خَطَّ جودُكَ بالمِسْكِ فِيهِمْ","شهادَتُهُ لمليكٍ جوادِ",60,"د",1,0],["وكم خلع لبست إذاً حسان","وكم تاج على رأسي حسين",61,"ن",1,0],["وكم خابطتُ عشواءَ الأماني","وكاذَبني على الظنّ ارتيادي",62,"ي",1,0],["وكم خلقٍ شثْنٍ بأول ملمسٍ","ولَيْنٍ إذا يْلوهُ من هو عاقِلهْ",63,"ل",2,0],["وكم خلَّةٍ من بائس ذي خصاصةٍ","سددتَ وقد أكْدتْ عليه المطامعُ",64,"ع",1,0],["وكم خاب قدحٌ من قبل فوزهُ","واخطأ من بعد الوثوق به سهم",65,"م",1,0],["وكم خضتُ ناراً دون جنّة وجهها","حنيناً إلى ما حلَّ فيها من الجمر",66,"ر",1,0],["وكم خَفَرْتُ ذِمامَ النسكِ مِن وَلَهٍ","يعتادُني لذواتِ الدلَّ والخَفَرِ",67,"ر",1,0],["وكم خضت في بحر الكنايات مائلا","لشرع الهوى حتى حباني وأدناني",68,"ن",2,0],["وَكَم خالةٍ أمسَت عَليكَ بحالةٍ","مِنِ الحُزنِ ما تَنفَكُّ ذاهِلةَ اللُّبِّ",69,"ب",1,0],["وَكَم خُطّةٍ جاوزتُها مُتَمهّلاً","وعرضِيَ من لومِ العشيرة أملَسُ",70,"س",1,0],["وكم خدودٍ وعيونٍ بها","كُسينَ بالأَدمُع حتَى عَرِين",71,"ن",1,0]]}