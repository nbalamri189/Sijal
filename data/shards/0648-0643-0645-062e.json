https://www.poetsgate.com/ViewPoem.aspx?id=191824",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5653,"خليلي من قيس بن عيلان خليا","https://www.poetsgate.com/ViewPoem.aspx?id=26386",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5730,"تساؤلات عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=210417",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5873,"غيث الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=215780",""],[6147,"ترشف ..من دموعي..","https://www.poetsgate.com/ViewPoem.aspx?id=151494",""],[402,"نبا بك دهر بالأفاضل نابي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53283&r=&rc=135",""],[5126,"أقلّي اللَّوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87797&r=&rc=12",""],[572,"تَعَطَّفْ علينا أيُّها الغُصُنُ الغَضُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9362&r=&rc=219",""]],"verses":[["وَكَم خالَطَ الباكينَ مِن سِنِّ ضاحِكٍ","وَبَينَ رُغاءِ الرازِحاتِ صَهيلُ",0,"ل",1,0],["وَكَم خاضَ تَأمورَ الظَلامِ بِفِتيَةٍ","يَرَونَ وُعورَ اللَيلِ مِثلَ سُهولِ",1,"ل",1,0],["وكمْ خَلّفَتْ أنْضاؤُها منْ مَعاشِرٍ","تَساوَى صَهيلٌ عندَهمْ ونَهيقُ",2,"ق",1,0],["وكَمْ خَلّفْنَ منْ طَلَلٍ بحُزْوى","وسَمْتُ عِراصَهُ مَرَحاً بِبُرْدي",3,"د",2,0],["وَكَم خَلَّفتُ مِن بِكرٍ رَداحٍ","بِصَوتِ نُواحِها تُشجي الفُؤادا",4,"د",2,0],["وَكَم خَلَّفَت أَعناقُها مِن نَحيزَةٍ","وَأَرعَنَ مِن قودِ الجِبالِ خُشامِ",5,"م",1,0],["وكم خشف بمربعهم وظبيٍ","يمرّ مع الجدَاية والمهاة",6,"ه",1,0],["وكم خلتُ في فنِّ الحساب إفادة","فكانَ حسابُ الدهرِ غيرَ حسابي",7,"ب",2,0],["وكم خَانِ سَفْرٍ خَانَ فانقضَّ فوقهم","كما انقضَّ صقرُ الدجنِ فوق الأرانبِ",8,"ب",1,0],["وَكَم خَلَّيتُ عِندَكِ مِن لَيالٍ","مُعَشَّقَةٍ وَأَيّامٍ قِصارِ",9,"ر",1,0],["وَكَم خَسَأوا الحُسّادَ وَاِستَحدَثوا لَهُم","خَساسَةَ حالٍ مِن نَباهَةِ حالِ",10,"ل",1,0],["وَكَم خَبَطَت بِأَرساغٍ وَجَرَّت","نِعالَ الجِلدِ وَهيَ إِلَيكَ تَسري",11,"ر",2,0],["وَكَم خَبَطَت نَعلاً بِخُفٍّ وَمَنسِمٍ","تُدَهدي بِهِ صُمَّ الجَلاميدِ راعِفِ",12,"ف",1,0],["وكَم خَرَقَ الصِّبا بذوي التَّصابي","إلى خُرسِ الحُجولِ بِها الحِجالا",13,"ل",2,0],["وكم خُطَّةٍ حاولتَها فاستَطَعْتَها","بِسَيْفِكَ والأيَّامُ لا تَستَطيعُها",14,"ع",3,0],["وكم خرَقَ الحِجابَ إلى مَقامٍ","توارَى الشَّمسُ فيه بالحِجابِ",15,"ب",1,0],["وكم خضعت بخرشنة قلوب","وقد خفقت بعقوبته العقاب",16,"ب",1,0],["وَكَم خَليلٍ لَكَ خالَلتَهُ","لا تَرَكَ اللَهُ لَهُ واضِحَة",17,"ه",1,1],["وَكَم خامِدٍ تُخفيهِ ضَغطَةُ حُفرَةٍ","وَقَد كانَ في الدُنيا يَصيحُ وَيُرهِجُ",18,"ج",1,0],["وَكَم خاطَرتُ فوكَ بِبَذلِ نَفسي","وَأَعلَمُ أَنَّ بالي فيكَ بالي",19,"ل",2,0],["وكم خفقَتْ فيها البنودُ وَكَمْ حَوَتْ","ملوكاً ترى الجوزاءَ تحتَ نعالِها",20,"ل",3,0],["وَكَم خالٍ مِن الاسقا","م ردّوه وَقَد أَشرَف",21,"ف",1,0],["وَكَم خَنَت مِن هَجولٍ حُجِّبَت وَوَفَت","مِن حُرَّةٍ ما لَها في العينِ جِلبابُ",22,"ب",1,0],["وَكَم خَدَعَت هِزَبراً كانَ جَبراً","مِنَ الأَملاكِ ذاتُ حُلىً وَدَرجِ",23,"ج",1,0],["وكم خريفٍ في نشيدٍ بديعْ","تظلُّ ترويه ليالي الشتاءْ",24,"ا",2,0],["وكم خُطىً أحْسَسْتُها في دمي","أقولُ قد جاءَ وهذي خطاه",25,"ه",1,0],["وَكَمْ خَلَبَ الأَلْبَابَ مِنْهُ بِمَوقِفٍ","بَلِيغُ حِوَارٍ أَوْ سَدِيدُ جَوَابِ",26,"ب",1,0],["وكم خِلٍّ حميم لم أزُرهُ","وبي شوقٌ إِلى الخِلِّ الحميم",27,"م",1,0],["وكم خصمت بالمعنى خصاما","دهاهم من جلالتك انتقام",28,"م",1,0],["وَكَم خودٍِ نَكَحتَ بِغَيرِ مَهرٍ","عَلَى رَجَفانِ رعيِكَ لِلذِّمامِ",29,"م",1,0],["وكم خُطّة أَفردتهُ الرجا","لُ فيها وولت شَعاعا عِضينا",30,"ن",2,0],["وَكَم خَلَفتَ الحَيا أَوقاتَ غَيبَتِهِ","عَن ذي البِلادِ وَلَم يَخلُفكَ حينَ هَما",31,"م",2,0],["وكم خاطبٍ لم يدع كفئاً لها ولم","يشم طرفاً من وشي ذيلِ رداها",32,"ا",3,0],["وكم خاض نقعاً يُمْطِرُ الهامَ وقْعُهُ","إِلى المَوتِ في صَفَّيْ قَناً وقواضبِ",33,"ب",1,0],["وكم خرجت تواقيع ببشرى","على أيدى الملئكة الكرام",34,"م",1,0],["وَكَم خَلاءٍ مَخُوفٍ قَلبُ سالِكِهِ","لِلخَوفِ مِثلَ لِواءِ الجَيشِ يَضطَرِبُ",35,"ب",1,0],["وكم خُلْسة للَّثْم فيها كأنها","على طمأٍ عذبُ المذاق بَرود",36,"د",1,0],["وكم خطر إن أبحناه عن","جموح غرائزنا ينجم",37,"م",1,0],["وكم خفقت مذ جاء ألويةُ الهدى","وكم أعينٍ قرّت ولذّت مسامع",38,"ع",1,0],["وَكَم خَلائق لا يحصون غيرهم","في نهج خرقتنا تاهو أَو ما تاهوا",39,"ا",1,0],["وَكَم خَطبتْ على الأسوارِ هامٌ","رَماها الجِدُّ بالجَدِّ العثورِ",40,"ر",1,0],["وَكَم خائِضٍ في النارِ حُبّاً لِجَنَّةٍ","وَوَجنَةُ مَن أَهواهُ ناري وَجَنَّتي",41,"ت",2,0],["وكم خاطبٍ إحدى بناتِ خواطري","بمَهْرَيْنِ من جاهٍ وسيعٍ ومن رِفد",42,"د",1,0],["وكم خامِلٍ لا يَهْتدي لنباهةٍ","بغَيْرِ وقُوعٍ منه في عِرْضِ راجح",43,"ح",1,0],["وَكَم خَلَقَ العِذارُ عَلَيكَ حُبّاً","وَمِن عُجبٍ بِهِ سَحَبَ الرِداءَ",44,"ا",2,0],["وكم خبرٍ لو صحَّ لم يبقِ منهُمُ","لمُستَخبِرٍ عَنهُم وعَنكَ مخبِّرا",45,"ر",2,0],["وكم خبّأت في نفسي كنوزاً","فقد وأبيك أغنتني الخبايا",46,"ا",3,0],["وكم خمرةٍ ساءت بعقل نديمها","فكانت سواءً وهي صهباء قَرقَف",47,"ف",1,0],["وكم خرقتَ حجاباً كان من قِبَلي","قد بُدِلَّت عنه حجبٌ ما بها قِصَر",48,"ر",1,0],["وَكم خَبَرٍ في خَيبَرٍ قَد رويتُمُ","وَلكنَّكم مثل النعام تشرَّد",49,"د",1,0],["وكم خلّي يلومُ جهلاً","وكلّ من حَبَّ لا يُلامُ",50,"م",1,1],["وكَمْ خَلفَ السُّتورِ جَنَيتُ ذنباً","وربُّ العرش مُطلِّعٌ خبيرُ",51,"ر",1,0],["وكم خُضْتُ من بحر الرواية أبحراً","وسألت عن تحقيقها كلَّ مخبر",52,"ر",1,0],["وكم خضنا بحوراً من علوم","بتحقيق تجاوز كل حد",53,"د",1,0],["وكم خدمت مقالته أناس","هم مثل المؤيد والشهاب",54,"ب",1,0],["وكم خاطب ردته لم يك كفأها","إلى أن أتاها خاطب سيفه المهر",55,"ر",1,0],["وكم خمرٍ معتّقةٍ رآها","ففضَّلها على الخلِّ العتيق",56,"ق",1,0],["وكم خَلُصَتْ سريرة من يُعادَى","وكم كدُرَتْ سريرةُ من يُوالَى",57,"ل",2,0],["وكم خدعَتْنا من ملوك يسُرُّها","لو انّكَ ترضى أنها لك أعبُدُ",58,"د",1,0],["وكم خاضُوا كَهِمَّتِهِمُ بُحوراً","وكم عَدِمُوا الثَّرى عَدَمَ الثَّرَاءِ",59,"ا",2,0],["وكم خَطَّ جودُكَ بالمِسْكِ فِيهِمْ","شهادَتُهُ لمليكٍ جوادِ",60,"د",1,0],["وكم خلع لبست إذاً حسان","وكم تاج على رأسي حسين",61,"ن",1,0],["وكم خابطتُ عشواءَ الأماني","وكاذَبني على الظنّ ارتيادي",62,"د",2,0],["وكم خلقٍ شثْنٍ بأول ملمسٍ","ولَيْنٍ إذا يْلوهُ من هو عاقِلهْ",63,"ل",2,0],["وكم خلَّةٍ من بائس ذي خصاصةٍ","سددتَ وقد أكْدتْ عليه المطامعُ",64,"ع",1,0],["وكم خاب قدحٌ من قبل فوزهُ","واخطأ من بعد الوثوق به سهم",65,"م",1,0],["وكم خضتُ ناراً دون جنّة وجهها","حنيناً إلى ما حلَّ فيها من الجمر",66,"ر",1,0],["وكم خَفَرْتُ ذِمامَ النسكِ مِن وَلَهٍ","يعتادُني لذواتِ الدلَّ والخَفَرِ",67,"ر",1,0],["وكم خضت في بحر الكنايات مائلا","لشرع الهوى حتى حباني وأدناني",68,"ن",2,0],["وَكَم خالةٍ أمسَت عَليكَ بحالةٍ","مِنِ الحُزنِ ما تَنفَكُّ ذاهِلةَ اللُّبِّ",69,"ب",1,0],["وَكَم خُطّةٍ جاوزتُها مُتَمهّلاً","وعرضِيَ من لومِ العشيرة أملَسُ",70,"س",1,0],["وكم خدودٍ وعيونٍ بها","كُسينَ بالأَدمُع حتَى عَرِين",71,"ن",1,0],["وكم خربت ديار عامرات","بتبذير فصارت خاويات",72,"ت",1,0],["وَكَم خاطِبٍ عِندي رُجوعَ مَودَّتي","عَزيزٌ إلى عِزِّ الكِرامِ رُجُوعُها",73,"ع",3,0],["وكم خيلت مغرى بها كنه وصفها","فأصبح مختالاً بها ساحباً ردنا",74,"ن",2,0],["وَكَم خَط نار مِنهُ تَبدو صَواعقٌ","فَتحرق ما تَأتي عَلَيهِ بِسُرعة",75,"ه",1,0],["وَكَم خَط رَأس مِنهُ طافَت بِمارق","رجوم مِن النيران في كُل لَمحة",75,"ه",1,0],["وكم خندق فاضت مياه عذابه","على طامع ما فاز يوما ببغية",75,"ه",1,0],["وَكَم خَوارِقَ حَتّى في قُلوبِهمُ","مِن سمرِهِ وَسُيوفٍ برقُها خَطَفا",76,"ف",2,0],["وكم خائضين بموج اللهب","لإنقاذ أموالهم أو سلب",77,"ب",1,1],["وكم خَطَبَتْنِي مِصْرُ في نَيْلِ نِيْلِها","ورامَتْ بنا بَغْدادُ وِرْدَ فُراتِها",78,"ت",3,0],["وَكَم خَفَقت بِالنّصرِ راياتُهُ ضحى","وِبالفَتحِ عادَت حيثُما الفتح مطلبُ",79,"ب",1,0],["وكم خيرٍ يجر إليك ضيراً","وبعض الشر يدفع عنك شرَّا",80,"ر",2,0],["وكم خفضت خفة","خوف الخبيث المجرم",81,"م",1,0],["وكم خلبت خلة","وكم حليت حلة",81,"ه",1,0],["وكم خلال خنتها","وذمة أخفرتها",81,"ه",2,0],["وكم ختلت من عدا","بحيلتي لما اعتدى",81,"د",2,0],["وكم خذمت من صبا","الى خبا المخدم",81,"م",1,0],["وَكَمْ خُضْتُ نَاراً فَوْقَ نبتِ عِذَارِهِ","غراماً بريحَانٍ نَمَى فوْقَ عَنْدَمِ",82,"م",1,0],["وَكَم خطّة قَد تخطّيتُها","وَمارستُ فيها أموراً عِظاما",83,"م",2,0],["وكم خدر لفاطمة مصون","أباحته وكم هتكت حجابا",84,"ب",2,0],["وَكَم خَبطَة مِن فَحمة لدُجُنَّة","وَحمرة وَهّاج عَن الصَيف حاجم",85,"م",1,1],["وكم خالفت مطراناً","فطوناً خير مخبورِ",86,"ر",1,0],["وكم خميسٍ بهِ لم تُبقِ مِنْ أَحَدٍ","مِنهمْ سليماً مِنَ البَأْساءِ والغِيَلِ",87,"ل",1,0],["وكم خادع الناس عن حقده","فلم يخدع الناس عن حقده",88,"د",2,0],["وكَم خَاضَ مِن بَحرٍ طَمُومٍ إلَى العُلاَ","وكَم بَذَّ مِن حِبرٍ تَلاَهِيهِ بالحِبرِ",89,"ر",1,0],["وكم خير دعا حالا وقالا","إليه وكم أتت منه الصلاة",90,"ه",1,0],["وَكَم خَدَعتِني عَلى أَنَّني","بَصيرٌ بِطُرقِ الخَطا وَالصَوابِ",91,"ب",1,0],["وكم خلَّفتُ من كَرَمٍ مُهَانٍ","بِعَرصَتِهِ ومن لُؤم مُطاعِ",92,"ع",1,0],["وكم خطأ لو ساعدَ المرءَ جدُّه","لَعُدَّ صوباً واستزادَ به رَفعا",93,"ع",2,0],["وكم خاضوا عباب الموت شوقا","وعاموا في لظى حربٍ تشب",94,"ب",1,0],["وَكَمْ خِلْتُ بَرْقاً فِي الدُّجَى نُور بِشْرِهِ","تَشِيمُ سَنَاهُ النَّاجِيَاتُ النَّجَائِبُ",95,"ب",1,0],["وكم خاب ظنى فى أناس عرفتهُم","وكانوا أسرابا يخدع العيز والذّهنا",96,"ن",2,1],["وَكَم خَبَطَت مِن فَحمَةٍ لِدُجنَّةٍ","وَجَمرَةِ وَهّاجِ مِن الصَيفِ جاحِمِ",97,"م",1,0],["وكم خصنا من غيث فضلك وابل","وعم الورى من بحر جودك نائل",98,"ل",1,0],["وَكَمْ خَائِفٍ صَارَ المَخُوفَ وَمُقْتِرٍ","تَمَوَّلَ والأحْدَاثُ يَحلُو مَرِيرُها",99,"ر",3,0],["وكم خلدت في السجن منكم أعزةً","إلى أن قضت نحباً بطامورة النجب",100,"ب",1,0],["وكم خضبت بين الأنام مدائحي","لها لمما لا ينصلن خضابها",101,"ب",3,0],["وكم خلناهُ يوعظُ في اللَّيالي","بقلبٍ خاشع للصَّيدِ صالي",102,"ل",2,0],["وكم خيّلت سِحراً وألقتْ حبالَها","وأفنتْ جيوشاً مثلَ داحسَ والغبرا",103,"ر",2,0],["وكم خُيولٍ ولَبُوسٍ وزَرَدْ","وكم رأَيْنا عَدداً وهي عُدَد",104,"د",1,0],["وَكَم خَدَجَت فيهِ الجِيادُ مِهارَها","وَعادَ كُمَيتُ اللَونِ مِنها مُسَوَّما",105,"م",2,0],["وَكَم خاطَبت عاطشة الأَماني","سِوى العَذب المَروق لا تَذوقي",106,"ق",2,0],["وَكَم خُضتُ لُجَّ المَوت وَاللُج ثائر","يَدكُّ الرَواسي مِن صَواخبه وَثب",107,"ب",1,0],["وكم خود مهفهفة كسلوى","لها وجه كوجه البدر حال",108,"ل",1,0],["وكم خطيب وكم من شاعر فطن","تعنو له شعراء العرب والعجم",109,"م",1,0],["وكم خيالات له شنيعه","يظنها أنوار وهي أكدار",110,"ر",1,0],["وكم خلوتُ بمن أهوى فيقنعني","منه الفكاهة والتحديث والنظر",111,"ر",1,0],["وكم خلي بات يخلو بالهوى","وكم شج لازمه الرقيب",112,"ب",1,0],["وكم خضنا لزورتك الليالي","بسير يقطع الفلوات همس",113,"س",1,0],["وكم خلفت من فطن اديب","ينوح على فتى فطن اديب",114,"ب",1,0],["وكم خلقت المعاني حيّة أبداً","شتانَ خالقُ احياء وأزياء",115,"ا",2,0],["وكم خلت أن الانتحار مخلّصي","فلم يرضَه عقلي ولم يرضَه باسي",116,"س",2,0],["وكم خلت بي جنا وكم خلت جنة","فكذبني عقلي بآياته الغر",117,"ر",1,0],["وكم خطم الفقر كنّ الخدور","فذرّى به زعزع السافيات",118,"ت",1,0],["وكم خبطت عشواء في ليل مشكل","فجاء لها بالشمس فكرك يوشع",119,"ع",1,0],["وكم خلَّفت للصب غمزة حسرة","وشاقتهُ ان يدنو اليها ويلثما",120,"م",2,0],["وكم خرّبوا مسجداً عامراً","وكم شربوا جهرةً مسكرا",121,"ر",2,0],["وَكَم خليلين إِذ جادَ الصبا شطحاً","حَتّى إِذا ما اِنقضت أَيامه شحطا",122,"ط",2,0],["وَكَم خدرٍ كعيص اللَيث عزّاً","خلصتُ لَهُ وَما أَغنى الزَئير",123,"ر",1,0],["وَكَم خيلَت أَنّي ذُقتُ شَهداً","إِذا ما ذُقتُ حالَ اللَثمِ ظَلما",124,"م",2,0],["وَكَم خُصَّت بِسِرٍّ لَيسَ يَدري","لَها بِالحُسنِ وَالإِحسانِ عَمّا",124,"م",2,0],["وكم خبر في فضله صح مسنداً","عن المصطفى فاسئل به من له علم",125,"م",1,0],["وكم خائن بث الغوائل شاكيا","فأصبح وهو الظالم المتظلم",126,"م",1,0],["وكم خطةٍ قلدتها فتعرفت","بشخصك عنوان الدراية والرشد",127,"د",1,0],["وكم خُضت بحراً موجه البيضُ والقَنا","وكلُّ ربيطِ الجأش كالليل ثائرِ",128,"ر",1,0],["وكم خدمت فيك من لا يخدم","بل لم يكن سواك شيئا يعلم",129,"م",1,0],["وَكَم خاضَ لَج البَحر راجَ يَؤمه","وَبِالبِشرِ وافاهُ الغِنى وَالتَأَنُّس",130,"س",1,0],["وكم خلتنا سكرى بخمر جفونها","إذا مال بالاعطاف حسن قوامها",131,"م",3,0],["وكم خامل أمطاه حارك رتبة","حراك ويعلو الترب حين يثار",132,"ر",1,0],["وكم خفضنا كماةً في عواملنا","فقل لمن ناب دعوىً عن مباهلنا",133,"ن",2,0],["وكم خُلقٍ في شيخ لِسْلام عَزْوه","إلى اسم من جمال جلاله",134,"ل",2,1],["وكَم خضتُ تَياراً رعودٌ عجيجهُ","يزمجر أغراقا ولن يتوقفا",135,"ف",2,0],["وكم خادنتُ ملّاقي خداعٍ","أضاعوا الودَّ في القول المريبِ",136,"ب",1,0],["وكم خلَّ خلّاني وخلّوا خلالتي","فَريسة عُذّالي وَقَلبي ما جفا",137,"ف",2,0],["وَكَم خسيفٍ ضَعيف القلب ساد عُلا","تطول منهُ على الباعات أشبارُ",138,"ر",1,0],["وكم خادنت مرءا عن صفاءٍ","تخذتُ عهودهُ شيئاً خَطيرا",139,"ر",2,0],["وكم خالطت ملّاقي زمانٍ","وكم نصبوا شباك المكر حولي",140,"ل",2,0],["وكم خالطت سُمْرَ الرماح وأوردت","مياهاً غَدتْ حُمْرُ الدِماءِ لها خلطا",141,"ط",2,0],["وكم خاملٍ قدرُهُ في الورى","وهوَّ الوجيهُ ورأسُ الأممْ",142,"م",1,1],["وكم خطت عليه لام كيّ","بها قد رمنت لام الجحود",143,"د",1,0],["وكم خضنا له لجا فضيعنا به الطرقا","وكم من تائه فيه ومنبوذ به ملقى",144,"ق",2,0],["وكم خبر فاق خبراً ومن","نراه يرى الخبر فاق الخبر",145,"ر",1,0],["وكم خاضت الأفكار فيها فما انقضت","عجائب ما فيها فحدث عن البحر",146,"ر",1,0],["وكَمْ خَفَقَتْ براياتٍ لِقَومٍ","ولَمْ يَخفقْ لهمْ أُفقٌ طُموحَا",147,"ح",2,0],["وكم خلت الصعاب بلا انفراجٍ","وكانَ الصدرُ للوسواس نهْبا",148,"ب",2,0],["وكم خلعت العذار ركضاً","إلى المعاصي وما ونيت",149,"ت",1,0],["وَكَمْ خِلْتُ أنَّ الْحُبَّ لِلْقَلْبِ رَحْمَةٌ","وَشِعْرٌº وأَلْحانٌº وَفَنٌّº وَمَنْطِقُ",150,"ق",1,0],["وكم خضتُ درب الشعر والعشق لجّه","تحرقتُ شوقاً والقريض سبيلُ",151,"ل",1,0],["وكم خاض في بحر الحقائق فاصطفى","جواهر أصداف المعاني فنظما",152,"م",2,0],["وكم خصم تجرع منك كأسَ ال","منون بصارم ذكر بتور",153,"ر",1,0],["وكم خائنٍ للشعب كنت اتخذته","لي الآلة الصماء عند الشدائد",154,"د",1,1],["وكم خطرت فيها الرماح عواليا","وكم سفرت بيض الصفاح مواضيا",155,"ي",2,0],["وكم خدعنا بوهم ِ النصر ِ أنفسَنا","ومن دمانا أعادي الله قد شربوا",156,"ب",3,0],["وكم خصمته بنات الغنى","وشاحت بأوجهها ريثما",157,"م",2,0],["وكم خوارق للشيطان قد ظهرت","أضل منها رجالاً حاز خسرانا",158,"ن",2,0],["وكم خابرتُ أتراحي إليكم","فما وصلت ومابقيَ الرصيدُ",159,"د",1,0],["وكم خط سطر العزم فرطحنينه","فظلت يد الحرمان تمحو وتمحق",160,"ق",1,0],["وكم خطبتني مصر في نيلها","ورامت بنا بغداد ورد فراتها",161,"ت",3,0],["وكم خلفت من خدن ورائي","غداة البين ينتحب انتحابا",162,"ب",2,0],["وكمْ خائضٍ في الدّينِ مكْراً كأدْرُعي","ولوْ قالَ آياتٍ فلسْنا نُصَدِّقُهْ",163,"ق",2,0],["وكم خطا بي خطابي نحو منزلهِ","للحرف ذاكرةٌ لو رحت أنساهُ",164,"ا",2,0],["وكمْ خلائقَ لا يحصونَ غيرهمُ","في نهجِ خرقناتاهوا وما تاهوا",165,"ا",1,0],["وكم خاض في حسنها خاطري","وكم قد تعجّب منها وحارا",166,"ر",2,0],["وكم خجلت بتغميزي السواقي","وما قصدي أغمّزه سواكا",167,"ك",2,0],["وكم خلب الألباب منه بموقف","بليغ حوار أو سديد",168,"د",1,0],["وَكَمْ خَفِيَتْ مَعَانٍ ثُمَّ لاحَتْ","لِيَاحَ الشَّمْسِ مِنْ بَعْدِ الأُفُولِ",169,"ل",1,0],["وكَمْ خَفَقَ الأَمرَ الذي هو باطلٌ","وكَمْ دَحَضَ الحقَّ الذي مَالهُ دَحْضُ",170,"ض",1,0]]}