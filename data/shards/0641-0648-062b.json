{"poems":[[29,"ولقد رحلت إليكم عيدية","https://www.aldiwan.net/poem5794.html","الكامل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[194,"اصبر وسل شكك الأمور","https://www.aldiwan.net/poem1155.html",""],[519,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93992","الكامل"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103779","الخفيف"],[5183,"خفة الأروى","https://www.poetsgate.com/ViewPoem.aspx?id=186382",""],[5943,"الشعر في قدري","https://www.poetsgate.com/ViewPoem.aspx?id=34715",""]],"verses":[["فَوَثِقتُ ما سَلِمَ الخَليفَةُ بِالغِنى","لَيسَ البُحورُ إِلى الثِمادِ البُرَّضِ",0,"ض",1,0],["فَوَثَّقَ الإمامُ من رِهانِهْ","كيلا يكونَ في عمىً من شانِهْ",1,"ه",1,0],["فَوَثَبَت شاقِئَةِ الفُطُورِ","عَيرانَةً تَختالُ بِالخَطِيرِ",2,"ر",1,0],["فوثِقْتُ منذُ حلَلْتُ ساحتَهُ","أن لا يحِلَّ بساحَتي فَقْرُ",3,"ر",1,0],["فوثبت مثل الليث وهو يقول أح","رقت الحشى فارفق ولاتك متعبا",4,"ب",2,0],["فوثبنا على الغزال ركوباً","ودببنا إلى الرقيب دبيبا",5,"ب",2,0],["فوثقت به وولجت إلى حضرته بالقدس المنبلج","وشممت شذاه فأسكرني من عرف المسك المنثبج",6,"ج",1,0],["فوثَّقَ العهدَ بالإخلاصِ مُحْتَكِمَاً","لِمَنْ بهِ خافقِيْ بالحُبِّ يَرْبطُنِيْ",7,"ن",2,0]]}