,[5277,"ظلالٌ وضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=206824",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5490,"من أغضب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176263",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5584,"ولقد رجوت الله بعد رحيلها","https://www.poetsgate.com/ViewPoem.aspx?id=175149",""],[5616,"موال فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5670,"وأمُرُّ بالدُّنْيا !","https://www.poetsgate.com/ViewPoem.aspx?id=211219",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5742,"رثاء الأماجد","https://www.poetsgate.com/ViewPoem.aspx?id=206966",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5815,"عَلمْ","https://www.poetsgate.com/ViewPoem.aspx?id=192033",""],[5829,"البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=210657",""],[5848,"والله لاجي قدام بيتك","https://www.poetsgate.com/ViewPoem.aspx?id=53210",""],[5910,"لِي في الهوى حَرْفَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=206237",""],[5948,"ربَّ مغمومِ بعَافيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=100597",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[5997,"الوصل الممنوع","https://www.poetsgate.com/ViewPoem.aspx?id=214231",""],[6031,"أَمَوْلَى الوَرَى إنِّي جَعلْتُكَ في الذِي","https://www.poetsgate.com/ViewPoem.aspx?id=46412",""],[6062,"وعد","https://www.poetsgate.com/ViewPoem.aspx?id=176606",""],[6152,"قلبي المنحاز لها","https://www.poetsgate.com/ViewPoem.aspx?id=208666",""],[1583,"عن بلادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73070&r=&rc=27",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[572,"أَبى الدَّهرُ إِلاَّ فعالاً خسيسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9344&r=&rc=201",""]],"verses":[["وَأَمراً مِنكَ يَحذَرُهُ الأَعادي","فَيَلحَظُهُ بِأَجفانِ دَوامِ",0,"م",1,0],["وَأَمرَدَ حَيٍّ مُلتَحِ بِلِثامِهِ","يَطولُ جَواداً قادِحَ السِنِّ أَجرَدا",1,"د",2,0],["وَأَمرُ السَفى حَتّى اِلتَقَينا غُدَيَّةً","كِلانا يُحامي عَن ذِمارٍ وَيَحتَمي",2,"م",2,0],["وَأَمَرنا الرِياحَ تَجري بِأَمرٍ","مِنكَ حَتّى نَراكَ مِنّا قَريبا",3,"ب",2,0],["وَأَمرٍ قَد فَرَقتَ اللَبسَ مِنهُ","بِحِلمٍ لا يَجورُ وَلا يَميلُ",4,"ل",1,0],["وَأَمرٍ يُهِمُّ الناسَ غِبُّ نِتاجِهِ","كَفَيتَ وَكَربٍ بِالدَواهي مُطَرِّقِ",5,"ق",1,0],["وأمرّ حلو العيش فانقلبا","بمحاوليه شرّ منقلب",6,"ب",1,0],["وَأَمري كُلَّهُ أُمَمٌ","وَحُبِّيَ وَحدَهُ سَرَفُ",7,"ف",1,0],["وَأَمرَدَ مُرتاحاً إِذا ما نَدَبتَهُ","تَحَمَّلَ ما حَمَّلتَهُ فَتَرَبَّلا",8,"ل",2,0],["وأمرضتني جفون منكِ قد مرِضتْ","فكان أطيبَ من نجح الدوا دائي",9,"ا",2,0],["وأمر بنشرِ سماطٍ منك يجبرنا","ونحنُ في رسمنا بالأكل نجبره",10,"ر",2,0],["وأمرد نشوان أما لقاه","لعمري فمعذرة الفاسق",11,"ق",1,0],["وآمراً بنوال القاصدين فما","يزال فيهم رشيد الرأي مأمونا",12,"ن",2,0],["وأمر بما تروي صدايَ أقم بها","مِدَحاً يضيق بها بيان الأفوهِ",13,"ه",1,0],["وأمرْتَهُ أنْ لا يَفُوهَ بذكرها","في الناطقين وغيرُ ذلك رُشِّحا",14,"ح",2,0],["وأْمُرْ لها ثم بروميةٍ","للرقص والإيقاع جمَّاعه",15,"ع",2,0],["وآمرين بغير الرشد قلت لهم","لا ألفظ العذب إن العذب مرشوف",16,"ف",1,0],["وامرؤٌ يستقي بجاهك أهلٌ","بسجالٍ رويَّةٍ وسجالِ",17,"ل",1,0],["وامرؤٌ مصلحٌ إذا عاينَ القوْ","م أرادوا الأديمَ بالإنغالِ",18,"ل",1,0],["وَاِمرَح بِدُنيا جَمالٍ مِن تَصَوُّرِهِ","فَإِنَّها السِحرُ إِلّا أَنَّهُ أَدَبُ",19,"ب",1,0],["وَأَمرَحُ في بَلَدِ عامِرٍ","وَأَحسَبُني قاطِناً سَبسَبا",20,"ب",2,0],["وَأمُر طُيورَكَ أَن تَنوحَ عَلى فَتى","قَد كانَ يَهواها وَإِن لَم تَسجَعِ",21,"ع",1,0],["وَأَمَرتُ أَن يَقِفَ الزَمانُ عَنِ السُرى","كَيلا نَمُرَّ بِساعَةٍ تُبكينا",22,"ن",2,0],["وامْرَحي مَا شئتِ في الوديانِ","أَو فَوْقَ التِّلالْ",23,"ل",1,0],["وأمر فكل بني العرو","بة حين تأمرهم سميع",24,"ع",1,0],["وأمرت بابني فالتقا","ك بوجهه المتهلل",25,"ل",1,0],["وأمرّ من ذا بيع واحدة النعا","ج أو التي بقيت من البقرات",26,"ت",1,0],["وَأَمَرُّ مِمّا فَرَّ مِنهُ فِرارُهُ","وَكَقَتلِهِ أَن لا يَموتَ قَتيلا",27,"ل",2,0],["وَأَمَرُّ مِن فَقدِ الأَحِبَّةِ عِندَهُ","فَقدُ السُيوفِ الفاقِداتِ الأَجفُنا",28,"ن",2,0],["وَأَمرُ أَبي الفَضلِ في حاجَتي","بِما فُزتَ بِالشَطرِ مِن حَمدِهِ",29,"د",2,0],["وَإِمرَةُ المُؤمِنينَ مُنتَخَبٌ","لَها رَضِيُّ الخَلاقِ خَيرُها",30,"ر",3,0],["وَأمُر غَريرَكَ أَن يُكَرِّرَ كُلَّما","أَدهَقتَ كَأسَكَ صَوبَ صَبٍّ مُبلِسِ",31,"س",1,0],["وَأَمَرُّ مِن عِلَلي تَخَلّى ناظِري","عَن حُسنِ وَجهِ خَليفَةِ الرَحمَنِ",32,"ن",1,1],["وَأَمرَضتَني بِالجَفا","أَتارِكَتي مُدنَفا",33,"ف",2,0],["وَاِمرِئِ القِيسِ مَيِّتٍ يَومَ أَودى","ثُمَّ خَلّى عَلَيَّ ذاتِ العَراقي",34,"ق",2,0],["وأمْراضُنَا أَسبابُهُنَّ كَثيرةٌ","تَحِلُّ بِأَجسامٍ فتهلكُ أنْفُسُ",35,"س",1,0],["وَأَمرٍ كَسَدِّ المِنخَرَينِ اِعتَلَيتَهُ","فَنَفَّستَ مِنهُ وَالمَنايا حَواضِرُ",36,"ر",1,0],["وَأَمَرتَني كَيما أُجا","مِعَ عُصبَةً فيها مَقاذِر",37,"ر",1,0],["وآمُرُ الناسَ بالصَّلاحِ ولا","أُصْلِحُ نَفْسِي حُرِمْتُها حِسْبَهْ",38,"ب",2,0],["وَآمُرُ بِالمَعروفِ لا مِن تَقِيَّةٍ","وَكَيفَ وَقَولي لا يُصَدِّقُهُ فِعلي",39,"ل",2,0],["وَأَمِرّي الحِزامَ بَينَ ثَنايا","كِ العِذابِ المُفَلَّجاتِ الحِسانِ",40,"ن",1,0],["وأمْرَاضُ المَواعِدِ أعْلَمَتْني","بأنّ وَرَاءها سَقَماً صَحيحا",41,"ح",2,0],["وامرئ القيس ميت ما كرم أو","دى وخلى علي ذات العراقي",42,"ق",2,0],["وأمر مما فر منه فراره","وكقتله ألا يموت قتيلا",43,"ل",2,0],["وأمّر الجيش عليهم خالدا","وانتظروا اليوم العظيم الخالدا",44,"د",2,0],["وأمر إبراهيم في البصرة قد","زاد وكوفان كمرجلٍ غلا",45,"ا",1,0],["وأَمَرناهُ به من بَينِها","بَعدَ ما انصاعَ مُصرّاً أَو كَصَم",46,"م",1,0],["وأمرّ من هذا وأوجعُ زوجةٌ","خطرة كومضِ البرقِ أو خطرَ ابنمُ",47,"م",1,0],["وأمرتني كيما أُجا","مع أسرة ً فيها مقاذر",48,"ر",1,0],["وإمرة المؤمنين منتخب","لها رضي الأخلاق خيرها",49,"ر",3,0],["وامرأة يرسم .. عارية",".. ولها ثديان من المرمر",50,"ر",1,0],["وامر ما يجد الكريم من العنا","ان يبتليه زمانه بلئام",51,"م",1,0],["وأمرُك نافدٌ في كلِّ شىءٍ","وأمضى في القضاء مِن الحُسَامِ",52,"م",1,0],["وأمَرتَهَأ أن لاَ تَمَلَّ مِنَ العَطَا","حَتى تُمِلًّ هِبَاتُكَ المُتنَاوِلا",53,"ل",2,0],["وَأَمَرتِني أَلّا أَمُرَّ بِدارِكُم","فَمَتى مَرَرتُ بِها مَرَتُ مُجَنِّبا",54,"ب",2,0],["وَأَمرٌ قُمتَ فيهِ بِلا ظَهيرٍ","وَأَهلُ الأَرضِ مِن فَشَلٍ قُعودُ",55,"د",1,0],["وَأَمرُكَ نافِذٌ فينا فَأَطلِق","بِمَحضِ العَدلِ حَقّي مِن عِقالِ",56,"ل",1,0],["وَأَمريَ إِبهامٌ عَليَّ وَغُمَّةٌ","أَتَنهَضُ بي نَحوَ المَدينَةِ هِمَّةٌ",57,"ه",1,0],["وأمرتهم بحيون ليل صيامهم","بقيامه أكرمْ بذلك مَطلبا",58,"ب",2,0],["وأَمران اشكو منهما كل واحد","به الخطب عند الانفراد شديدُ",59,"د",1,0],["وأمرت بالصدقات في أربابها","فوضعن فيهم والحديث شجون",60,"ن",1,0],["وأمرتنا لك بالدعا ووعدتنا","أن تستجيب لمن دعاك دعاه",61,"ا",2,0],["وأَمْرَح في ميادين التَّصابي","وأخلع في مَلاعبِها عِذاري",62,"ر",2,0],["وأمرتَ فامتثلَ الملوكُ كأَنهم","أعضاء مُقْتدِر وأنت جَبان",63,"ن",1,0],["وأمرح الطرف فيمن لا إزار له","فصان فرجا ولم تسلم مناظره",64,"ر",2,0],["وأمرك ماض مثل سيفك قاطع","ورأيك مثل السهم والسهم صائب",65,"ب",1,0],["وأمرد لم يطعني مذ كلفت به","حتى التحى جاءني طوعا على رغم",66,"م",1,1],["وأمر ذي ثلاثة ابن ابنة","وال وأم كذا أيمن وامرأة",67,"ه",1,0],["وأمرك ماض ما له من مضارع","وحمع العلى يقضي بأنك مفرد",68,"د",1,0],["وَأَمَرَّ البنان يَستَرجِعُ الرُش","دَ عَلى أَصغَرٍ نبا عَن مَكانِه",69,"ن",2,0],["وَامرَح كما يَمرَحُ ذو نَشوةٍ","في قُلَّةٍ من تحتِها الهاوِيَه",70,"ي",2,0],["وأمرُ بتعجيلها حتّى أعيشَ وقد","أقْرَرْتَ عيني وقد بَلَّغْتَني هِمَمي",71,"م",2,0],["وَأَمُرُّ العَيشِ عَيشٌ","ذاهِبٌ بِالبُعدِ فانِ",72,"ن",1,0],["وَآمِرَةٍ لي بِجَوبِ البِلادِ","وَإِنضاءِ كُلِّ أَمونٍ دِفاقِ",73,"ق",1,0],["وأمر حقير لا يرى الذل ضمنه","لراء ولم تمدد له كف رائم",74,"م",1,0],["وأمرك لا الأفلاك يغلب دورها","وكفاك لا الأنواء تهمي وتهمع",75,"ع",1,0],["وأمرضني منك العتاب وَلَيسَ لي","سواك اذا عز الطَبيب طَبيب",76,"ب",1,0],["وامرت قَلبك أن يقر فَما ارعَوى","وَنهيت حفتك أَن يَسيل فَسالا",77,"ل",2,0],["وأمرضني وأضرم نار وَجدي","وَذلك مذهب الحب اِتفاقا",78,"ق",2,0],["وامرضني الطَبيب فَيا لِقَومي","طَبيب زادَني بدواه داء",79,"ا",2,0],["وَأمروا الريح تهدى","نَفحة من صباها",80,"ا",3,0],["وأمرضنى الهوى لهوان حظي","وَلكن لَيسَ غيرك لي طَبيب",81,"ب",1,0],["وَأَمْرَعُهُمْ لِمُرْتَادٍ جَنَاباً","وَأَمْنعُهُمْ لِمَطْلُوبٍ جِوَارا",82,"ر",2,0],["وامر إله الخلق بين ما به","يسوق أولى التنعيؤم نحو السعادة",83,"ه",1,0],["وَأَمرٍ تَشتَهيهِ النَفسُ حُلوٍ","تَرَكتُ مَخافَةً سوءَ السَماعِ",84,"ع",1,1],["وَأَمرٌ يُرَجّي النَفسَ لَيسَ بِضائِرٍ","وَتَخشى عَلَيها ضَيرَةَ ما يَضيرُها",85,"ر",3,0],["وامرحي في دلال","واصخبي في سكون",86,"ن",1,0],["وَأَمَرَ الآمِرينَ بِهِ أَطَعنا","وَنَهيَ ذَوي النُهى عَنهُ عَصَينا",87,"ن",2,0],["وَأَمرى مشكل صَعب وَلكِن","عَلَيكَ ميسر سَهل خَفيف",88,"ف",1,0],["وأْمُرْ بها بِدَراً يُنحَرنَ تامِكةً","كما يُقرَّبُ عند المَوسمِ النُّسك",89,"ك",1,0],["وآمرُ دَهْري أن يُعيدَ زَمانَهمْ","وتلك لعَمْري أَمرةٌ ما يُطِيعها",90,"ع",3,0],["وأمرُّ بِالمَغنى لحاجَة مُسرعٍ","فَيَكونُ ذكرُ قَطينه مُستَوقِفي",91,"ف",2,0],["وأمرُّ من هذا عقابٌ خالدٌ","وأمر منهالبعد عن مولائه",92,"ا",3,0],["وأمر من هذا وهذا ثم ذا","أبدٌ بسجنٍ جُنَّ ضيقُ وعائه",92,"ا",3,0],["وأمر ذا الدين والدنيا بهذا استقام","أمر به الله والمختار بدر ا