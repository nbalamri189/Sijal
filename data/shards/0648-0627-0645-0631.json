","وَأنْ أُعْمِلَ الطَّرْفَ وَالعَنْتَرِيْسَا",121,"س",2,0],["وأمرت أن يدفنوها ليلا","وأن يعمى قبرها لكي لا",122,"ل",2,0],["وأمر الناس معا بنصرته","من دون أهل بيته وعترته",122,"ه",1,0],["وأمرت بردها فامتنعوا","فأظهرت خلافهم فاجتمعوا",122,"ع",3,0],["وأمروا عائشة الشقيّة","فعادت السيرة جاهليّة",122,"ه",1,0],["وأَمرُ معاليك لا يَنْقَضِي","ومنزل سَعْدك لن يُنقضا",123,"ض",2,0],["وَأْمُرْ غُصُونَ النَّقا أَنْ تَنْثني خَجَلاً","وَقُل لِشَمْسِ الضُّحَى أَنْ تَبْتَغي حُجُبَا",124,"ب",2,0],["وأمر صدوق القول ليس بكاذب","ومطلب حق في حقيقة طالب",125,"ب",1,0],["وأمرُّ الأيام ما كان فيها","قدَمُ المرءِ في أَذل القيود",126,"د",1,0],["وَأَمرت بِالإِفراج عَن ماء لَنا","أَعياه حَبسٌ بِالجُسور شَديد",127,"د",1,0],["وأمْر ضَني شَوْقي إليكمْ وقُرْبُكمْ","شِفائي من الأمْراضِ لو صَحَّ للنّفْسِ",128,"س",1,0],["وأمَرُّ ما ألقاه أنّي عاجزٌ","عن أن أخُصَّ فرائضي بأداءِ",129,"ا",2,0],["وأمره في صعَدٍ","وأمرها في صبب",130,"ب",1,0],["وَأَمر الدُبَّ بِأَن يَروح لَه","وَإِن يَكُن في بعد أَلف مَرحَله",131,"ه",1,0],["وأم رزْبَنَ لا تهوى العصا ومع النْ","نَعَّاشة الخيرُ لا لؤمٌ ولا ندم",132,"م",1,0],["وأمر الخلق مصروفٌ إلينا","ومثوانا الكرامةُ والكرام",133,"م",1,0],["وأمرت بالشكوى إليك وإنما","ينمى إلى الإنسان ما لمي علم",134,"م",1,0],["وأمرك ممتثل في الأممْ","مساعيك في المجد قد طالتِ",135,"ت",1,0],["وأمر غورث لم يجحده ذو خبر","بل فيه قد أنزل الرحمن والله",136,"ه",1,0],["وأمر الغار فيه أيّ أمر","عجاب للبيب المستشار",137,"ر",1,0],["وَآمَرَ قيصرُ الألحاظِ قَلْبِي","وَقَدْ سَلَّ الظُّبَي وَأجال خَيْلَهْ",138,"ل",2,0],["وَأمرٌ منَ الخطبِ مُستصعبٌ","تَمطّيت منه القرى والسلاما",139,"م",2,0],["وأمر لوط عبرةٌ للمعتبرْ","وَشَأْنُهُ ذِكْرَى فَهل مِن مُدَّكِرْ",140,"ر",1,0],["وأَمْرَ جُلٍّ يَجْمَعُ المَعَاشِرا","إِذا أَجْتَلَت أَيّامُه المَفَاخِرا",141,"ر",2,0],["وأمر الموت محتومٌ علينا","وهذا ما به حكم الالهُ",142,"ا",3,0],["وأمرك جزم خافض رفع ما انطوى","عليه ونصب الفخ منهم تعطلا",143,"ل",2,0],["وآمرُ دهريَ أَمْرَ الغُلامِ","لأَنِّي مِنْ بعضِ غِلْمانِهِ",144,"ن",2,0],["وأمر شيء أن تحل بمربع","لم تلف فيه سائلا و