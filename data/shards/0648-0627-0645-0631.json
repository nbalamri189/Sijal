"وأمر مبرم قهر البرايا","فلا أحداً له عنه اندفاع",174,"ع",1,0],["وامرأةٌ مؤمنةٌ","الوجهُ منها كالقمر",175,"ر",1,0],["وأمرناها بأن تلبسها","كل من كان بخير عرفا",176,"ف",2,0],["وأمرُك بالمعروف والنهيُ يا فتى","عن المنكر اجعل فرص عين تسدّد",177,"د",1,1],["وَأَمَرتَني بِجُحودِهِ وَبِذِكرِهِ","عَنوَنتُ ذِكرَ صَحيفَتي في المَوقِفِ",178,"ف",1,0],["وامر فانت المطاع في فئة","ارحامها في علاك توصلها",179,"ل",3,0],["وأَمَّره على حيَّيْ مَعدٍّ","وأَمَّرهُ على الحَيِّ المُعالي",180,"ل",2,0],["وامرح مع القسيس والمطران لا","تخش كلوماً من ملام صديق",181,"ق",1,0],["وآمرة بالبخل قلت لها اقصري","فاحسان ربّ العالمين جزيل",182,"ل",1,1],["وأمرغ الخدين في تربٍ غدا","كالمسك في أرج شذا منشوقه",183,"ق",2,0],["وامرئ غير ذي دين ولا أدب","معمر بين تأهيل وترحيب",184,"ب",1,0],["وأمر لحاظك ان تكف سهامها","عنى فقد مستني الأسقام",185,"م",1,0],["وأَمرَ الرَسُولُ أَن تُوَفَّرا","فَحَلقُها يُعَدُّ قُبحاً مُنكَرا",186,"ر",2,0],["وأمرح في روض الجمال منعما","وأسكر من خمر اللمى وأطيب",187,"ب",1,0],["وَأَمرَضَهُ ضَوءُ الصَّباحِ كَأَنَّهُ","يُرى في اِجتِماعِ الآلفين حَسودُ",188,"د",1,0],["وأمرٌ في بسط الحقيقة والوفا","وامتع الميل الونا بطلاق",189,"ق",1,0],["وأمر بقلع عيون نرجسها وقل","إياك يا منثور أن تتفرجا",190,"ج",2,0],["وأمري ليس لهُ مثيل","فأنتَ عنهُ في سكَرات",191,"ت",1,0],["وأمَّرَكُم وخصَّصَكُم بِقَيلٍ","سَمَى بفِعالِهِ قلباً ونفسَا",192,"س",2,0],["وَأَمرَضَني وَأَرَمَ نارَ وَجدي","فَضَلَّ لَهيبُها يَصلى الصِفاقا",193,"ق",2,0],["وأمرد ضاق عن معاملتي","أودعت فاه خفيف دينار",194,"ر",1,1],["وأمرح هازئاً بأنين صدري","فلست لصدريَ الشاكي حزينا",195,"ن",2,0],["وأمرح في المخاطر دون خوف","وأجعل حارسي الرب القديرا",196,"ر",2,0],["وأمردٍ كالجبل الراسي","أثقل من هم وإفلاس",197,"س",1,1],["وأمرَضَتني جفونٌ منك قد مرِضَت","وكان أنجحَ من طيبِ الدوا دائي",198,"ا",2,0],["وأم روضته الغنّاء ذو شغف","سعيا وَفوق متون الأينق الرسُم",199,"م",1,0],["وامر بعرف لهم مثل الصلاة وقل","حقا اذا خلت بطلا في سبيلهم",200,"م",1,0],["وأمرٌ بالعُرف","سام رفيع الرتب",201,"ب",1,0],["وأمرهم بينهم شورى ودينهم","فتح من الله لا قتل وتمثيل",202,