م أصلحهُ","ولا تعرض لما يمضي",230,"ض",2,0],["وأَمرهُ مستفادُ","من القضاءِ المُتاحِ",231,"ح",1,0],["وأمرتها أن اصبري","لطلاب سابقةٍ تنالي",232,"ل",2,0],["وأمرض قلبي جفنها وهو ممرضٌ","وأدلف طرفي طرفها وهو آلف",233,"ف",1,0],["وأمرتني نظم القريض وإنما","بك عمت في بحر القريض العامر",234,"ر",1,0],["وأمر الجفون يوالي نوء صيبها","وبلاً يفوق غوادي السحب ماطره",235,"ر",2,0],["وَأَمَّرنا أَميرَينِ","وَكُلٌّ جائِزُ الإِمرَه",236,"ر",2,0],["وأَمرَعَ مِنها الرَّوضُ حَتَّى تَرَى لَها","نَسيماً كأَنفاسِ الَملابِ مُعَطرا",237,"ر",2,0],["وأمررُ بِبيروتَ حيثُ الماء مُنحدرٌ","يسُوخُ بينَ رياضِ للرَّياحينِ",238,"ن",1,0],["وأمر الله مقدورٌ","وما يخطيه من أحد",239,"د",1,0],["وأمر الله في الخلق جميعاً","على وفق الإرادة حكم قاهر",240,"ر",1,0],["وأمراً فظيعاً يصدَعُ الصُّمَّ وقْعهُ","وتُذْهَلُ ألبابٌ له وعقولُ",241,"ل",1,0],["وأمرك ماض بيوم الحساب","أبا حسن أنت فصل الخطاب",242,"ب",1,0],["وأمر الهوى عند الذي لم يقاسه","غريب وقيس فاس ذلك بالسحر",243,"ر",1,0],["وأمَّرَ فيها العدلَ حتى تعمَّرت","به وملوكُ الأرض تمَّت أمورُها",244,"ر",3,0],["وأمرُّ من إلفِ الذليلِ لسوْطَه","إلفٌ لقيدٍ لا يفارقُ عنْقَه",245,"ق",2,0],["وامرر على دوحة الآداب مُلتمِساً","فكراً عميقاً ترَ الألبابَ مزدحمة",246,"م",2,0],["وأمرٌ واحدٌ لا لبس فيه","فأنّى كان درهمهم يكونوا",247,"ن",3,0],["وأمرَكوا الوحيَ، فالتنزيل تفقهه","كلُّ اللغاة سوى ضاديَّةِ الأدبِ",248,"ب",1,0],["وامرّ بيتك من بعيدٍ ولا اجيه","وانا لو انه في يدي ماتعداه",249,"ا",2,0],["وأمري حميد باتباعي لأحمد","فمن نوره علمي وحكمي وبرهاني",250,"ن",2,0],["وأمرُّ الحياةَ بينَ لئامِ","وأعفَّ الكريمَ عنها وأغنَى",251,"ن",2,0],["وامرر الضحكه على روس الكلآم","اخآف لاْ العآلم على الدمعه تويق",252,"ق",1,0],["وآمرْك بيّ .. وقبل تدري .. انفذك","واسَكر البيبآن عن كل طآرق",253,"ق",1,0],["وأمراض نفسٍ قد تبدت جليةً","تبيِّنُ أصحابَ الفسادِ وتفضحُ",254,"ح",1,0],["وأمرحن النواظر في وجوه","منزهة الخدود عن الخدور",255,"ر",1,0],["وآمرْليْ كأنْصالِ الشّظايا","تُذيقُ الْمعْتدي دمَهُ شَرابا",256,"ب",2,0],["و(أَمْريكا ) أَعاذَ اللهُ منْها","وأَخْزى ساسَةَ البيتِ الضَليلِ",257,"ل",1,0],["و