وَإِذا عَزانا ناسِبٌ","نَسَبَ الشُموسَ إِلى البُدورِ",2,"ر",1,0],["وَأَذاعَ الحَلْيُ سِرّاً كاتِماً","فَتَرَكنا مِن تَوَقِّهِ السُّرى",3,"ا",1,0],["وَإِذا عَجَزْتَ وَلَمْ تُلِمَّ بِهِ","فَالعَجْزُ بَعْدَ طِلابِهِ دَرَكُ",4,"ك",1,0],["وَإِذا عَصاني الدَمعُ في","إِحدى مُلِمّاتِ الخُطوبِ",5,"ب",1,1],["وَإِذا عادَني العَوائِدُ يَوماً","قالَتِ العَينُ لا أَرى مَن أُريدُ",6,"د",1,0],["وَإِذَا عَدَلْتَ فَلاَ الْهَوَادَةُ وَالْهَوَى","مِنْ بَعْدِهِ أَبَداً لَدَيْكَ تُؤْمَّلُ",7,"ل",1,0],["وَإِذَا عَقَدْتَ فَلِلْغنَى لاَ لِلْهَوَى","فَبِكُلِّ قَدْرِ رُئْبْةٌ لاَ تُهْمَلُ",7,"ل",1,0],["وإذا عدَتْ أيْدي الذّنوبِ عَواسِفاً","لتَعيثَ كُنْتَ المَلْجأ المقْصودا",8,"د",2,0],["وَإِذا عتِبتَ عَلى السَفيه وَلُمتَهُ","في مِثلِ ما تأَتي فَأَنتَ ظَلومُ",9,"م",1,0],["وَإِذا عُضالُ الداءِ أَبهَمَ أَمرُهُ","عَرَفَت خَفِيَّ دَبيبِهِ الإِبهامُ",10,"م",1,0],["وَإِذا عَلاها راكِبٌ رَقَصَت بِهِ","رَقصَ القَلوصِ بِراكِبٍ مُستَعجلِ",11,"ل",1,0],["وَإِذا عَكَستَ الجَمعَ كانَ اِسماً لِمَن","أَفعالهُ مَشهورَةٌ في السُؤدَدِ",12,"د",1,0],["وَإِذا عَكَستَ حُروفَهُ","شَرُفَ الحُسامُ بِذِكرِهِ",13,"ر",2,0],["وَإِذَا عَوَالِمُ لَيْسَ مِنْهَا بَاقِياً","إِلاَّ اخْتِلاطُ أَشِعَّةٍ وَدُخَانِ",14,"ن",1,0],["وَإِذَا عَزَّ مَا ابْتَغَيْتَ عَلَى الأَرْ","ضِ فَكَيْفَ ابْتِغَاءُ مَا فِي النُّجُومِ",15,"م",1,0],["وَإِذا عاسَرتَه أَلفَيتَهُ","شَرِسَ الرَأيِ أَبِيّاً داهِيَه",16,"ي",2,0],["وَإِذ أَعيُنٌ مَرضى لَهُنَّ رَمِيَّةٌ","فَقَد أُقصِدَت تِلكَ القُلوبُ الصَحائِحُ",17,"ح",1,0],["وإذا عطا للمجدِ نال بكفه","ما لا ينال الناس بالأبصارِ",18,"ر",1,0],["وَإِذا عَدَلتَ بِهِ رِجالاً لَم تَجِد","فَيضَ الفُراتِ كَراشِحِ الأَوشالِ",19,"ل",1,0],["وَإِذا عَدَدتَ قَديمَهُم وَقَديمَكُم","أَربَوا عَلَيكَ بِطارِفٍ وَتَليدِ",20,"د",1,0],["وَإِذا عَدَدتَ بُيوتَ قَومِكَ لَم تَجِد","بَيتاً كَبَيتِ عُطارِدٍ وَلَبيدِ",20,"د",1,0],["وَأَذاعَ أَنّي قَد سَلَوتُكَ مَعشَرٌ","يا رَبِّ لا عاشوا لِذاكَ وَلا بَقوا",21,"ق",3,0],["وَأَذاعَ سِرّاً مابَرِحتُ أَصونُهُ","وَهَوىً أُنَزِّهُ قَدرَهُ أَن يُذكَرا",22,"ر",2,0],["واذا عينك الجميلة شكرى","واذا الدمع دافق يتصبب",23,"ب",1,0],["وإذا عظَّم البلادَ بنوها","أنزلتهم منازل الإجلال",24,"ل",1,0],["وإذا عزّت عزّزت بها","وإذا هانت فرُح فهُن",25,"ن",1,0],["وَإِذا عَفَوتَ فَقادِراً وَمُقَدَّراً","لا يَستَهينُ بِعَفوِكَ الجُهَلاءُ",26,"ا",2,0],["وإِذا عَدا فرعونُ فيها واعتَدى","فعصا الكليم لواؤُكَ الخَطَّارُ",27,"ر",1,0],["وَإِذا عارِضُ المَنِيَّةِ أَوفى","وَبَنوها يَبُلُّهُم شُؤبوبُ",28,"ب",1,0],["وَإِذا عَزَّ الكِرا فَاِن","زِل عَلى حُكمِ المُكاري",29,"ي",1,0],["وَإِذا عَدَدتُ عَلى طِماسٍ عَيبَهُ","لَم أَرضَ أَلفاظي وَلا أَنفاسي",30,"س",2,0],["وَإِذا عِزُّ مَعشَرٍ زالَ يَوماً","مَنَعَ السَيفُ عِزَّهُم أَن يَزولا",31,"ل",2,0],["وَإِذا عَدَدتَ وَجَدتَني لِنَجيبَةٍ","غَرّاءَ قَد أَدَّت لِفَحلٍ مُنجِبِ",32,"ب",1,0],["وَإِذا عَدَدتَ بَني كُلَيبٍ لَم تَجِد","حَسَباً لَهُم يوفي بِشِسعِ قِبالِ",33,"ل",1,1],["وإذا عُدَّتِ المَناهِلُ كانَتْ","يَدُهُ منهلاً من العُرفِ عِدَّا",34,"د",2,0],["وإذا عرَتْها مَرْضةٌ","فَشِفَاؤُّها ضَربُ الرِّقاب",35,"ب",1,0],["وإذا عَبسْتَ فصارِمٌ ومَنِيَّةٌ","وإذا ابتسمْتَ فمَوعِدٌ وعَطاءُ",36,"ا",2,0],["وَإِذا عَقَلتَ هَواكَ عَن هَفَواتِهِ","أَطلَقتَهُ مِن خَينِ كُلِّ عِقالِ",37,"ل",1,0],["وَإِذا عَجِزتُ عَنِ الجَزاءِ لَحَقَّكُم","بِمَدائِحي فَاللَهُ خَيرُ مُجازي",38,"ي",1,0],["وإذا عفا صفحاً عفا عن قُدْرَةٍ","والحلمُ في الملك القدير فخارُ",39,"ر",1,0],["وَإِذا عَلوقُ الحاجِ يَوماً سُكِّنَت","بِهِمُ فَقَد رَئِمَتكَ حينَ تَرومُها",40,"م",3,0],["وَإِذَا عَرَتْكَ مُلِمَّةٌ فَاهْتِفْ بِهِ","تَسْمَعْ بِقَلْبِكَ حَيْثُ كُنْتَ صَدَاهُ",41,"د",3,0],["وَإِذا عَثَرتُ يَقولُ إِنّي شامِتٌ","وَأَقولُ حينَ أَراهُ يَعثُرَ دَعدَعا",42,"ع",2,0],["وَإِذا عَزَمتَ فَلا عَثَرتَ بِحادِثٍ","فَرَكِبتَ مِنهُ ظَهرَ صَعبٍ شامِسِ",43,"س",1,0],["وَإِذا عَلِقتَ بِذِمَّةٍ مِن خالِدٍ","فَاِقصِد بِسَومِكَ ضارِبَ الأَصدارِ",44,"ر",1,0],["وَإِذا عَمَدتُ لِصَخرَةٍ أَسهَلتُها","أَدعو بِأَفلِح مَرَّةً وَرَباحِ",45,"ح",1,0],["وإذا عُقابُ الجَوِّ هَدْهَدَ رِيشَها","صَعِقَتْ شواهِينٌ لها وأجادل",46,"ل",1,0],["وَإِذا عَدَدتُ سِنِيَّ كَم هِيَ لَم أَجِد","لِلشَيبِ عُذراً في النُزولِ بِراسي",47,"س",2,0],["وَإِذا عَريتَ فَلا تَكُن جَشِعاً","تَسمو لِغَثِّ الكَسبِ تَكسِبُه",48,"ه",1,1],["وَإِذا عُدَّت المَساعي كَفاهُ","حاتِمٌ وَالمُهَلَّبُ الوَهّابُ",49,"ب",1,0],["وَإِذا عَتَبتَ المَرءَ لَيسَ بِمُعتَبٍ","أُلفيتَ فيما جِئتَهُ مَعتوبا",50,"ب",2,0],["وَإِذا عَلِمتُ لِما يَزو","لُ فَذَلِكَ العَمَلُ المُتَبَّر",51,"ر",1,0],["وإذا عدا دُورَ القما","ر مشى إلى دُورِ العهار",52,"ر",1,0],["وإذا عمت المعارف قوماً","قلَّ فيهم مَع الزَمان الشرورُ",53,"ر",1,0],["وإذا عُدَّتِ الكواكبُ شعراً","فهي بيتُ القَصيدة العصماء",54,"ا",2,0],["وَإِذا عَزَمْتَ فَكُنْ بِنَفْسِكَ وَاثِقاً","فَالْمُسْتَعِزُّ بِغَيْرِهِ لا يَظْفَرُ",55,"ر",1,0],["وإِذَا عَتَبْتُ عَلَيْهِ ثُمَّتَ لَمْ يَعُدْ","عَنْ غَيِّهِ لَمْ أَكْتَرِثْ لعِتَابِهِ",56,"ه",1,0],["وَإِذَا عَصَفَتْ عَوَاصِفُهُمْ بِشَرٍّ","وَقَتنِيها يَدٌ سَبَقَتْ بِخَيْرِ",57,"ر",1,0],["وَإِذَا عَلَى العَرْشِ اسْتَوى فَكَأَنَّهُ","موسَى الكَليمُ عَلَى ذُرَى سيناءِ",58,"ا",2,0],["وإذا عزَتِ المكارمُ ولَى","مُطرِقَ الرأسِ واجماً خَزْيانا",59,"ن",2,0],["وإذا عتبتِ على القويِ فلا يكنْ","إلا بأطرافِ الحرابِ عتاب",60,"ب",1,0],["وإذا علا صوت الضعيف فربّما","أخفى صداه زماجر وصهيل",61,"ل",1,0],["وإذا عتبت على لماك فربّما","سمح الحبيب برشفة الأعتاب",62,"ب",1,0],["وَ إذا عرتكَ ملموٌ ، فاهتفْ بهِ","تَسْمَعْ بِقَلْبِكَ حَيْثُ كُنْتَ صَدَاهُ",63,"د",3,0],["وإذا عدَّ الكرام وجدتَ تيماً","نُخالَتَهُمْ، وَغٍيرَهُمُ اللُّبَابَا",64,"ب",2,0],["واذا علقت من الزمان بمعشر","فارفع كرام الوقت عن انذاله",65,"ل",2,0],["واذا علمت فكن حكيما عالما","لا كالوثوب مفاجئا بجداله",65,"ل",2,0],["وإذا عليك غمار أمر تبهض","لا تأخذن قنوط غرٍّ مذئما",66,"م",2,0],["وإذا عَصِيتِ هَويتِ في","قعر الجحيمِ الواقِدَهْ",67,"د",2,0],["وأذاع بشرى أحمدٍ فجميعنا","فرِح بمولود ومولده الندي",68,"د",2,0],["وإذا عصاه لسانه يعتاضه","بالسب والقول الشديد المؤلمِ",69,"م",1,0],["وإذا عزّت الهيولى زماناً","فمن الرأي الاكتفا بالصوره",70,"ر",2,0],["وإذا عِشارُ المال عُذنَ بكفّهِ","فلقد عقَلن نفوسَهنَّ بمَنحَرِ",71,"ر",1,0],["وَإِذا عَزَمتَ عَلى قِراعِ مُخالِفٍ","فَاِسلُل عَلَيهِ مِن سُيوفِكَ أَحمَدا"