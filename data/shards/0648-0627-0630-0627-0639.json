ِ بانتْ قواطعٌ مِن نوابِ",137,"ب",1,0],["وَإِذا عاتَبتَ مِنهم","مُذنباً ضاعَ العِتابُ",138,"ب",1,0],["وإِذا عَايَنْتَها في كأسِها","ذهب العقلُ ولم يبق استتار",139,"ر",1,0],["وإذا عَدَلتَ هديَّةً بهديَّةٍ","ما زال حُكمُ الفضلِ للمُتقَدِّمِ",140,"م",1,0],["وإذا عَثَرْتَ على فُؤادي بينَها","يوماً فَسَلْهُ إلى مَتَى يَتَخلَّفُ",141,"ف",1,0],["وإذا عَدِمْتَ مِن المآ","كِلِ خَيْرَهَا فكُلِ الحِجَارَهْ",142,"ر",2,0],["وإذا عَطَفْتَ بِهِ عَلَى ناوَرْدِهِ","لتديَرَهُ فكأنَّهُ برْكَارُ",143,"ر",1,0],["وإِذا عاقَبوه في الدَّارِ قد فرّ","إِلى سَطْحِها على غير سُلَّم",144,"م",1,0],["وإِذَا عَانقْتُ مِنْ طَربٍ","غُصْنَ قَدٍّ مِنْكِ مُتَّشحِ",145,"ح",1,0],["وإذا على الإنصاف قامت دولة","تنمو وعونا من الهك تكتب",146,"ب",1,0],["وإذا عدمت الطرس كانت مهجتي","طرسي اخط عليه او قرطاسي",147,"س",2,0],["وإذا عُجتُ في سِواهُ شَجاني","طُولُ مكثي في ظِلِّهِ ومعاجي",148,"ج",2,0],["وإذا عَبَّسَ الرِّجالُ مِنَ الهَو","لِ أتَى الهَولَ باسِماً ضَحّاكا",149,"ك",2,0],["وَإذا عَدَلتَ بَني رَسُولَ بِعامِلٍ","جَلفٍ فَأنتَ أقَلُّ مِنهُ وأجلَفُ",150,"ف",1,0],["واذا عصيتُ رمى الوسا","د بجمر نارٍ حاميه",151,"ي",2,0],["واذا عُدّ مَعشَرُ الفضلِ يَوماً","حسبوهم من أفضل العقلاءِ",152,"ا",2,0],["وإذا عاقرت أقداح الشراب","فهي لا تطفيء من نفسي اللهيب",153,"ب",1,0],["وَإِذا عَلا شرفَ المَهارِقِ منبراً","خطبَ الغِنى في أَسوَدٍ مِن بُردِهِ",154,"د",2,0],["وإذا علوم النحو قيست فهو من","جمعا له الكوفي والبصري",155,"ي",1,0],["وإذا علت أهرامها وتطلعت","فسلام مسترعٍ إليك يشير",156,"ر",1,0],["وإذا عبستَ لها أبت ضيماً وإن","حاسنت لان لك المراس الأصعب",157,"ب",1,0],["وإذا علت نفس الأبي غلت فلا","مستأجر لإبائه ومساوم",158,"م",1,0],["وإذا عنيت بكل مقضيٍّ فمن","أولى بإنجاز الوعود سواكا",159,"ك",2,0],["وَإِذا عَتَبتَ عَلى أَخٍ فَاِستَبقِهِ","لِغَدٍ وَلا تَهلِك بِلا إِخوانِ",160,"ن",1,1],["وإذا عَلَوْتَ فَواصِ بالعلمِ العُلى","تَكْمُل فخيرُ القومِ عالٍ عالمُ",161,"م",1,0],["وإذا عرْتك حوادث الد","نيا شفاكَ بلا علاج",162,"ج",1,0],["وإذا عارضْته عارضة أعْ","رض عنها وعاج عنها وعفَّا",163,"ف",2,0],["وإذا علقتُ من الوليدِ بذمةٍ","سكنت 