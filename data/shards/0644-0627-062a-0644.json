habi.ae/diwan/poem/43661","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"إلى الغزاة الهادمين","https://www.poetsgate.com/ViewPoem.aspx?id=179650",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"ما نسيناك","https://www.poetsgate.com/ViewPoem.aspx?id=179363",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[100,"حين يصحو الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50112",""],[96,"ردّوا على الوادي ربيه نهاره","https://www.poetsgate.com/ViewPoem.aspx?id=13208",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[45,"إِن تأَملْ مَحاسِنَ الأَصبَهَاني","https://www.poetsgate.com/ViewPoem.aspx?id=31114",""],[51,"لا تَلْحيني في المنْطق السخيفِ","https://www.poetsgate.com/ViewPoem.aspx?id=29572",""]],"verses":[["لا تَلزِمَنّي زَلَّةً","سَفَهَت عَلَيَّ بِها القَدَم",0,"م",1,0],["لا تَلُمني فَما عَلَيَّ مَلامُ","أَبصَرَتها عَيني فَلَيسَ تَنامُ",1,"م",1,1],["لا تَلومي عَلى ظَلومَ فَإِنَّ ال","لَومَ فيها مُخالِفٌ لِلسَدادِ",2,"د",1,1],["لأتْلوَ منْ آيِ المَحامِدِ سورَةً","وأبْصِرُ منْ شخْصِ المحاسِنِ صورَهْ",3,"ه",1,0],["لا تُلقِيَنَّ مَقالَةً مَشهورَةً","لا تَستَطيعُ إِذا مَضَت إِدراكَها",4,"ك",3,0],["لا تَلُم كَفّي إِذا السَيفُ نَبا","صَحَّ مِنّي العَزمُ وَالدَهرُ أَبى",5,"ب",2,1],["لا تَلجَئوا في العُلا إِلّا إِلى هِمَمٍ","وَثّابَةٍ لا تُبالي هِمَّةَ النُوَبِ",6,"ب",1,0],["لا تَلهُ عَنّي فَلَم أَسأَلكَ مُعتَسِفاً","رَدَّ الصِبا بَعدَ إيفاءٍ عَلى الكِبَرِ",7,"ر",1,0],["لا تلم إنسان مقلته","خلق الإنسان من عجل",8,"ل",1,0],["لا تلم عاشقاً بكى بعد روضٍ","كبكاء الوليد بعد نسيم",9,"م",1,0],["لا تلم الدهر على نقلةٍ","فقد تنقَّلت لأشهى مقام",10,"م",1,0],["لا تلح قلبي في الهوى فتتعبا","وما عليكَ عتبهُ فتعتبا",11,"ب",2,0],["لا تَلُمني فَاللَومُ مِنّي بَعيدُ","وَأَجِر سَيِّدي فَإِنّي وَحيدُ",12,"د",1,1],["لا تلومنَّ لائماً وضع اللَّو","ماءَ في كُنه موضع اللَّوماءِ",13,"ا",2,0],["لا تلمنا وإنْ أسأنا ثناءً","أنت مستأهل لسوءِ الثناءِ",14,"ا",2,0],["لا تلتمسْ شأوَه البطينَ فما","يُجريه إلا طِرفٌ له قبَبُهْ",15,"ب",2,0],["لا تلكُمُ الأوصالُ مهتزةٌ","كلّا ولا الأردافُ مرتجَّهْ",16,"ج",2,0],["لا تَلُمْني فالهوى فِي","هِ جماحٌ وطِماحُ",17,"ح",1,0],["لا تلومنّ حاسداً أَلَمُ النَّفْ","س من البخس يا أُخَيَّ شديدُ",18,"د",1,0],["لا تلحينِّي إن جعل","تك للجَدا كلباً وصقرا",19,"ر",2,0],["لا تلحِني في المنطق السخيفِ","فإنني في حالة اللهيفِ",20,"ف",1,1],["لا تلجَنَّ في معاندة الحق","ق فتعتد جاهلاً مألوقا",21,"ق",2,0],["لا تلوَّنْ تلوُّنَ البغل في البغ","لِ ولا يَخْتلف عليّ مذاقُك",22,"ك",1,0],["لا تَلمْهُ فإنه","خائفٌ من أناملكْ",23,"ك",1,0],["لا تَلُمنا فأنت تفاحةُ الأر","واحِ لا راعَها خُلُوُّ مكانِك",24,"ك",1,0],["لا تلمْهُم فإن لومَك لا ين","فع وارفُق بأكلِك الطفشيلا",25,"ل",2,0],["لا تلهُ عنها إنها حُجَّةٌ","من حُجج المَدْح كما تعلمُ",26,"م",1,0],["لا تَلْحَ مَنْ يبكي شبيبته","إلا إذا لم يَبْكِها بِدَمِ",27,"م",1,1],["لا تَلْحياني وإياها على ضرعي","وزهوها فكلا الأمريْنِ دَيْدان",28,"ن",1,0],["لا تلحَ من تفتنه قينهْ","فإن تصحيفَ اسمها فتْنَهْ",29,"ن",2,1],["لا تلُمه في عتاب مسرف","أنت قَوَّيت عليه مُننه",30,"ن",2,0],["لا تَلَجّي في اِجتِذابي أَو فَلَجّي في اِجتِذابي","إِنَّ عوداً فيهِ ماءٌ لَيسَ عوداً لِاِحتِطابِ",31,"ب",1,0],["لا تَلُمني إِن أَنا لِمتُ القَضا","وَلُمِ الدَهرَ الَّذي أَخنى عَلَي",32,"ي",1,0],["لا تَلُم شَيخي فَما أَدري بِهِ","غَيرَ أَن شارَكَ نَهداً في النَسَب",33,"ب",1,1],["لا تَلُمني أَو فَلُمني","فيكَ ظُلمٌ وَتَجَنّي",34,"ن",2,1],["لا تَلُم فيكَ عاشِقاً","رامَ صَبراً فَما قَدَر",35,"ر",1,0],["لاتَلحَ في السُمرِ المِلا","حِ فَهُم مِنَ الدُنيا نَصيبي",36,"ي",1,1],["لا تلم في يوم ضعيفا اذا ما","خاف بطش القوي ذي الاجهاز",37,"ز",1,1],["لا تلحينّ المنايا","فللمنايا مزايا",38,"ا",3,1],["لا تلمني اذا خشيت عليها","غرقا فهي اليوم تحمل رأسي",39,"ي",1,0],["لا تلوموني فإني","في الهوى أخت المقطم",40,"م",1,0],["لا تَلَدُّ مِثلَهُم","مُهجَةٌ وَلا كَبِدُ",41,"د",1,0],["لا تَلوموها أَلَيسَت حُرَّةً","وَهَوى الأَوطانِ لِلأَحرارِ دين",42,"ن",1,0],["لا تَلغُ فيهِ وَلا تَقُل","غَيرَ الفَواصِلِ مُحكَماتِ",43,"ت",1,0],["لا تَلتَمِس غَلَباً لِلحَقِّ في أُمَمٍ","الحَقُّ عِندَهُمُ مَعنىً مِنَ الغَلَبِ",44,"ب",1,0],["لا تَلومَنَّ اليَهودِيَّ عَلى","أَن يَرى الشَمسَ فَلا يُنكِرُها",45,"ه",2,1],["لا تَلُمني فَإِنَّني أَعشَقُ العُش","شاقَ فيها يا أَعذَلَ العُذّالِ",46,"ل",1,0],["لا تَلقَ أَفرَسَ مِنكَ تَعرِفُهُ","إِلّا إِذا ضاقَت بِكَ الحِيَلُ",47,"ل",1,0],["لا تَلقَ دَهرَكَ إِلّا غَيرَ مُكتَرِثٍ","مادامَ يَصحَبُ فيهِ روحَكَ البَدَنُ",48,"ن",1,0],["لا تلتمسُ فضلَ الغِنَى إنهُ","في صدفٍ أهلكه الدُّرُّ",49,"ر",1,0],["لا تَلُمني عَلى البُكاءِ فَإِنّي","نِضوُ شَجوٍ ما لُمتُ فيهِ البُكاءَ",50,"ا",2,0],["لا تَلُمهُ عَلى الفَعالِ إِنِ اِستَأ","ثَرَ شُحّاً بِسُروِهِ وَاِستَبَدّا",51,"د",2,0],["لا تُلحِقَنَّ إِلى الإِساءَةِ أُختَها","شَرُّ الإِساءَةِ أَن تُسيءَ مُعاوِدا",52,"د",2,0],["لا تَلحَني إِن عَزَّني الصَبرُ","فَوَجهُ مَن أَهواهُ لي عُذرُ",53,"ر",1,1],["لا تَلُمني فَبَعضُ لَومِكَ يُغري","وَإِلهُ عَنّي فَقَد تَبَنَّيتَ عُذري",54,"ي",1,0],["لا تَلُمهُ عَلى مُواصَلَةِ الدَم","عِ فَلُؤمٌ لَومُ الخَليلِ الَخَليلا",55,"ل",2,0],["لا تَلُمني إِن ضِقتُ ديونَ قَوافي ال","شِعرِ أَو كِلتُ لِلصَديقِ بِصاعِه",56,"ع",2,0],["لا تَلُمْني على انتثارِ دُموعي","حين عاينْتُ روضةَ المَنْثورِ",57,"ر",1,0],["لا تَلْحُ صبّاً على صَبابَتِه","وإنْ رأى الغَيَّ في الهوى رَشَدا",58,"د",2,0],["لا تَلتَطخ بِوقيعَةٍ","في الناسِ تلطخكَ الوَقيعَة",59,"ع",2,0],["لا تُلهِيَنَّكَ عَن مَعادِكَ لَذَّةٌ","تَفنى وَتورِثُ دائِمَ الحَسَراتِ",60,"ت",1,0],["لا تَلعَبَنَّ بِكَ الدُنيا وَأَنتَ تَرى","ما شِئتَ مِن عِبَرٍ فيها وَأَمثالِ",61,"ل",1,0],["لا تَلعَبَنَّ بِكَ الدُنيا وَزُخرُفُها","فَإِنَّها قُرِنَت بِالظِلِّ في المَثَلِ",62,"ل",1,0],["لا تَلعَبَنَّ بِكَ الدُنيا وَخُدعَتُها","فَكَم تَلاعَبَتِ الدُنيا بِأَقوامِ",63,"م",1,0],["لا تَلُمني عَلى الَّتي فَتَنَتني","وَأَرَتني القَبيحَ غَيرَ قَبيحِ",64,"ح",1,0],["لا تلم سيدي فحظي في الأظ","هر مع خسة البياض يجوز",65,"ز",1,1],["لا تُلامُ العُشّاقُ في تَلَفِ الأَر","واحِ في عِشقِهِ وَبَذلِ النُفوسِ",66,"س",1,0],["لا تَلُمْهُ في عَطاياهُ الَّتي","إن تَرُمْ مِنهُنَّ نَقصاً تَزدَدِ",67,"د",1,0],["لا تَلْبَثُ الْحِكْمَةُ مَا بَيْنَهُمْ","وَلا يَرِيثُ الْفَضْلُ حَتَّى يَتُوهْ",68,"و",2,0],["لا تلِ الحكمَ وإنْ همْ سألوا","رغبةً فيكَ وخالفْ مَنْ عذَلْ",69,"ل",1,0],["لا تلمْني في افتضاحي","فغرامي بالفقيرِ",70,"ر",1,0],["لا تَلُمني عَتيقُ حَسبي الَّذي بي","إِنَّ بي يا عَتيقُ ما قَد كَفاني",71,"ي",1,0],["لا تَلُمني وَأَنتَ زَيَّنتَها لي","أَنتَ مِثلُ الشَيطانِ لِلإِنسانِ",71,"ن",1,0],["لا تَلوما في أَهلِ زَينَبَ إِنَّ ال","قَلبَ رَهنٌ بِئالِ زَينَبَ عانِ",72,"ن",1,0],["لا تَلُمني وَاِجتَنِبني","أَنتَ ما سَدَّيتَ ذاكا",73,"ك",2,0],["لا تَلُمني في اِشتِياقي إِلَيها","وَاِبكِ لي مِمّا تُجِنُّ الضُلوعُ",74,"ع",1,0],["لا تَلُمني في الرَبابِ وَأَمسَت","عَدَلَت لِلنَفسِ بَردَ الشَرابِ",75,"ب",1,0],["لا تَلُمني عَتيقُ حَسبي الَّذي بي","وَاِلتَمِس لي الدَواءَ عِندَ الطَبيبِ",76,"ب",1,1],["لاتَلتَقي الأَجفانُ فيكَ","وَلا المَضاجِعُ وَالجُنوب",77,"ب",1,0],["لاتَلتَقي عَينٌ عَلَيهِ وَنَومَةٌ","لَيلاً وَلا جَنبٌ بِهِ وَمِهادُ",78,"د",1,0],["لا تِلكَ تَخفِضُ مِن جَناحَيْها ولا","هذا يُريد سِوَى التفوُّقِ مطلبا",79,"ب",2,0],["لا تلتَمِسْ عَدَماً فلستَ بواجدٍ","من ليس يُوجَدُ في دَمٍ مَغموسا",80,"س",2,0],["لا تَلمِسُ الأَرضَ إِلّا اِسوَدَّ جانِبُها","بَعدَ الضِياءِ وَجَفَّ الماءُ وَالعُشُبُ",81,"ب",1,0],["لا تلوميها إذا ما غَضبتْ","إنّها تَعلمُ ما لا تَعلمينْ",82,"ن",1,0],["لا تَلو مَا عَلَى الصَّبَابَةِ مِثلي","هَائِماً لَو لَقِيتُمَأ مَا لَقِيتُ",83,"ت",1,0],["لا تَلقَ أَنفاسي بِثَغرِكَ إِنَّهُ","بَرَدٌ أَخافُ عَلَيهِ مِن جَمرِ الغَضا",84,"ض",2,0],["لا تَلُم في الحَياءِ هَذي القَوافي","لَيسَ بِدَعاً أَن تَخجَلَ الأَبكارُ",85,"ر",1,0],["لا تلمني إن لم أجد من وميضٍ","لرجاءٍ ما بين هذا السوادِ",86,"د",1,0],["لا تَلجَأنَّ إِذا ظُلِمتَ لِمَنطق