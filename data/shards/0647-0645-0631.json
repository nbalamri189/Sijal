{"poems":[[55,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[55,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[39,"همرجلة الأدب قبل السياط","https://www.aldiwan.net/poem7396.html","المتقارب"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[26,"ألا هل أتى أم الحويرث مرسل","https://www.aldiwan.net/poem24081.html","الطويل"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[30,"سما لك شوق من نوار ودونها","https://www.aldiwan.net/poem1233.html",""],[30,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[30,"ستأتيك مني إن بقيت قصائد","https://www.aldiwan.net/poem5426.html","الطويل"],[30,"وما عن قلى عاتبت بكر ابن وائل","https://www.aldiwan.net/poem5507.html","الطويل"],[46,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[107,"أهذي ديار القوم غيرها الدهر","https://www.aldiwan.net/poem43415.html","الطويل"],[107,"تأن ابن حرب لست في مثلها جلدا","https://www.aldiwan.net/poem44214.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[113,"وقف الوجد بي على الأطلال","https://www.aldiwan.net/poem16226.html","الخفيف"],[119,"دع الفكر واصبر فالزمان صعائبه","https://www.aldiwan.net/poem41944.html","الطويل"],[138,"ألا هل أتى بحرينا صنع ربنا","https://www.aldiwan.net/poem20995.html","الطويل"],[151,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[211,"إذا فرس العوالي لم يخالج","https://www.aldiwan.net/poem27977.html","الوافر"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[264,"هزنا الشوق للمقام السني","https://www.aldiwan.net/poem35969.html","الخفيف"],[287,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[354,"هم رغبتي فلماذا في قد زهدوا","https://www.aldiwan.net/poem15620.html","البسيط"],[369,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[396,"طلب الراحة في الدنيا محال","https://www.aldiwan.net/poem54543.html","عموديه"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[469,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[505,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[519,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[563,"كيف أخشى من اللعين اللاهي","https://www.aldiwan.net/poem33635.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70924","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70794","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177916","الطويل"],[1186,"","https://poetry.dctabudhabi.ae/diwan/poem/204017","الوافر"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145157","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205527","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105198","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110308","الكامل"],[2344,"","https://poetry.dctabudhabi.ae/diwan/poem/131383","الطويل"],[2380,"","https://poetry.dctabudhabi.ae/diwan/poem/29474","الطويل"],[2390,"","https://poetry.dctabudhabi.ae/diwan/poem/199135","الطويل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70355","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200019","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100841","البسيط"],[3252,"","https://poetry.dctabudhabi.ae/diwan/poem/105714","المتقارب"],[3310,"","https://poetry.dctabudhabi.ae/diwan/poem/26608","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17663","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138592",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131084",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90890","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136513",""],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146758","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133136","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83187","الرجز"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4964,"هم رحلوا يوم الخميس عشيّةً","https://www.poetsgate.com/ViewPoem.aspx?id=191702",""],[2177,"هما العلمان بالزوراء لاحا","https://www.poetsgate.com/ViewPoem.aspx?id=127085",""],[5057,"خريف القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=197249",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5213,"بماضي رهيف العزم أقتحم الصعبا","https://www.poetsgate.com/ViewPoem.aspx?id=170408",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[5569,"النبض والنبض الآخر","https://www.poetsgate.com/ViewPoem.aspx?id=60535",""],[5720,"عذراً جدة *","https://www.poetsgate.com/ViewPoem.aspx?id=201051",""],[5906,"عدالة جائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188523",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[5956,"ما مصرُ إلا خير أمة يعربٍ","https://www.poetsgate.com/ViewPoem.aspx?id=194222",""]],"verses":[["هُمُ رَفَعوا كَما رَفَعَت نِزارٌ","قِبابَ عُلىً عَلى كَرَمٍ بُنينا",0,"ن",2,0],["هُم رَمَوا عَنّي جَليلَ ال","خَطبِ يَدمى وَدَقيقَه",1,"ق",2,0],["هُم رَفَعوا بِمَجدِهِم قِبابَها","وَضَوَّأوا مِن نارِهِم يَفاعَها",2,"ع",3,0],["همرجلة الأدب قبل السيا","ط والحوب لما يقل والحل",3,"ل",1,1],["همُّ رجال العلا تنافسهم","فيها وهمُّ الحمير في العلف",4,"ف",1,0],["هُم رَجَعوا بِالعَرجِ وَالقَومُ شُهَّدُ","هَوازِنَ تَحدوها حُماةٌ بَطارِقُ",5,"ق",1,0],["هُم رَفَعوا الإِصلاحَ مِصباحاً فَما","مِن مُصلِحٍ إِلّا بِنورهم مَشى",6,"ا",1,0],["هُمُ رَهَنوا عَنهُم أَباكَ فَما أَلوا","عَنِ المُصطَفى مِن رَهنِها لِوَفائِها",7,"ا",3,0],["هُمُ رَفَعوا يَدَيَّ فَلَم تَنَلني","مُفاضَلَةً يَدانِ وَلا سِبابا",8,"ب",2,0],["هُمُ رَهَنوا عَنهُم أَباكَ لِفَضلِهِ","عَلى قَومِهِ وَالحَقُّ بادي الشَواكِلِ",9,"ل",1,0],["هُمُ رَهَنوا عَنهُم أَباكَ وَما أَلَوا","عَنِ المُصطَفى مِن قَومِهِم بِالتَكَرُّمِ",10,"م",1,0],["هُم رَهطُ مَن أَمسى بَعيداً رَهطُهُ","وَبَنو أَبي رَجُلٍ بِغَيرِ بَني أَبِ",11,"ب",1,0],["هُمُ رَقَدوا عَنها فَطالَ رُقادُهُم","فَديتكُمُ هُبُّوا فَقَد طَلعَ الفَجرُ",12,"ر",1,0],["هُمُ رفدوهم كارهين ولو وفوا","بأيمانهم كانوا لأسيافهم رِفدا",13,"د",2,0],["هُمُ رياحينُ مصرٍ نَضْرَةً وشذاً","لا أذْبَلَ اللّهُ هاتيكَ الرياحينَا",14,"ن",2,0],["هُم رَياحين دَوحة المَجد وَالفَض","ل وَوَرد النَدا وَنور الكَمال",15,"ل",1,0],["هم ركب برهان خفي مطلسم","إلى الملك والملكوت سارت نجائبه",16,"ب",2,0],["هم روح جسم الكون بل نور عينه","تشرف فيهم شرقه ومغاربه",16,"ب",2,0],["هُمُ رَجَعوا سَهلَ ابنَ بَيضاءَ رَاضِياً","وَسُرَّ أَبو بَكرٍ بِها وَمُحَمَّدُ",17,"د",1,0],["هم رحمة لبني الإيمان قاطبةً","هم الوقاية أسواء وأهوالا",18,"ل",2,0],["هُمُ رَأسُ العَدُوِّ مِن أَهلِ نَجدٍ","فَقَتلُهُمُ أَلَذُّ مِنَ الشَرابِ",19,"ب",1,0],["هُم رموزُ الشقاق وَالفِتَن الحم","راءِ وَالغَدر وَالزِنى وَالغُرورِ",20,"ر",1,0],["هُم رَجائي لَدَيكَ في كُلِّ داءٍ","وَمُهِمٍّ مِن لَيلِ خَطبٍ دَجِيِّ",21,"ي",1,0],["هُم رَحمَةُ اللَهِ فاضَت عَلى ال","لَذينَ اِهتَدَوا مِثلَ فَيضِ الدِيَم",22,"م",1,0],["هُم رَغبَتي فَلِماذا فِيَّ قَد زَهِدوا","وَالحُكمُ في عَكسِ قَصدي مِنهُم اِطِّرَدوا",23,"د",3,1],["هُمُ رؤساءُ النّاس وهْو رئيسُهمْ","عَلاءً لكَبْتِ الحاسدين مُقيَّضا",24,"ض",2,0],["هم رجال الله فاقف أثرهم","واتبعهم في المقال والفعال",25,"ل",1,0],["هم ردوا عن الأحرا","ر كابوسا حكى رضوى",26,"ا",1,0],["هُمُ رحِمِي والأقربون مَعَقَّةٌ","وفيهم أبِي البَرُّ الرؤوفُ ولا أبُ",27,"ب",1,0],["همُ رافِعو الأَعلامِ في كلّ شاهقٍ","كما لهمُ في كل وهدٍ حبائل",28,"ل",1,0],["همُ رغبوا بي عن إجابةِ حادثٍ","فلي في خطاب الخطب مطلٌ وتبيان",29,"ن",1,0],["هَمَراتُ الجَحيم ِ، والسُّرَفُ الهُوجُ","وَقَتلاكَ ، والوجوهُ الصِّفاقُ",30,"ق",1,0],["همْ روحُ روحي ضِمنَ نَشأةِ أمْرِها","مع عُنْصُري وتَكَوُّنِ الفَخَّارِ",31,"ر",1,0],["همُ راحي ورَيحاني وروحي","وجنّاتي وإنْ كانوا عذابي",32,"ب",2,0],["هم رجال الله الذين اصطفاهم","وحماهم من الدها والدواهي",33,"ي",1,0],["هُم رؤوسٌ وباقى الناس جملة أذ","ناب فشتان بين الرأس والذنب",34,"ب",1,0],["همُ رجالي وعوني في الزمانِ على","صرف الزمانِ وهمْ أُنسى وإيناسي",35,"س",2,0],["هم رفعوا قدري فلم ينخفض","فيا لساني بالثنا فانْصَبِ",36,"ب",1,0],["هم رقموا أردان حلة دينهم","فأضحى طراز الحق بالحق معلما",37,"م",2,0],["هم رحلوا صبري غداة رحيلهم","وسرى بوجدي أبرزوا يوم برزوا",38,"ز",3,0],["همُ رفعوا عماد المجد حتى","أناف، وليس فيه لهم قسيم",39,"م",1,0],["هُمُ رأسُ مالي لا نضار وفضّة","وهمْ ربحُ أعمالي ونُجْح مآربي",40,"ب",2,0],["هم رهطه الادنى وفيما بيننا","عهد الوفاء وحرمة الاخوان",41,"ن",1,0],["همرجل مشيها والله صورها","في خلقها عن بنات الفحل تفضيل",42,"ل",1,0],["همُ رأوْا كَيْفَ دسْتَ الغَورَ منْتَقِماً","وَكَيفَ تَنْصَبُ مِن أنيَابِكَ النُّوبُ",43,"ب",1,0],["هم ركبوا الأخطار حتى توطدت","وهل يركب الأخطار إلا خطيرها",44,"ر",3,0],["هم ريق الأمل الذي يحيا به","والموت يضرب سيفه بجواره",45,"ر",2,0],["هم رفعوا شأن الشريق وشّيدوا","زوايا بذكر اللّه كلمتها تعلوا",46,"ل",3,0],["هُمُ رفعوكُمْ للسماءِ فَكِدْتُمُ","تنالونَها لو أنّ حيًّا يَطُورُها",47,"ر",3,0],["هم رحلوا يوم الخميس غدية","فودعتهم لمااستقلوا وودعوا",48,"ع",3,1],["هم رجائي وهم في نهاية سولى","وهم برء مهجتي والسلام",49,"م",1,0],["هم روضة زاهية معطارُ","حديثهم كشعرهم أزهارُ",50,"ر",1,0],["هم رشحوك لامر لو فطنت له","فاربأ بنفسك ان ترعى مع الهمل",51,"ل",1,0],["هم رفعوا علماً للفخار","فطال الفخار بهم واستطالا",52,"ل",2,0],["هُمُ رَدّوا القَبائِلَ مِن بَغيضٍ","بِغَيظِهِمُ وَقَد حَمِيَ الوَقودُ",53,"د",1,0],["هُم رِجالُها","وَالرِجالُ هم",54,"م",1,0],["هُمُ رَفعوا فَأسَ اللِجامِ فَأَدرَكَت","لِهاتَكَ حَتّى لَم تَدع لَكَ مَشرَبا",55,"ب",2,0],["هم راقبوا ذمتي لم لا أراقبهم","وهم وفوا لي ألا أوفي بعهدهم",56,"م",1,0],["هم رقصوا طربا بالرقي","فهل بارقي لنا مطمع",57,"ع",1,0],["هُم رِياضٌ وَأنتَ زَهرُهُ تُجنَى","إِنَّمَا مَثَّلوا صِفاتِكَ لِلنَّا",58,"ن",2,0],["هم رياض الفضل في الشام التي","فاخر الزهر بها زهر الربى",59,"ب",2,0],["هم رحمة الدنيا هم الشفعاء في ال","أخرى إذا عظم البلاء وارجفا",60,"ف",2,0],["همُ رحلُوا عنكَ الغداةَ وما دَرَوا","بأَنهمُ قد خَلفوكَ وساروا",61,"ر",3,0],["هم رَضَعوا دَرَّ الحجَى في مهودهمْ","أَماجدُ وانضمتْ على السؤددِ القُمْطُ",62,"ط",1,0],["هم رماحٌ أعددُتهم لطعانٍ","وسُيوفٌ ذَخرتهم للضراب",63,"ب",1,0],["هم راضة الدنيا وساسة أهلها","إذا افتخروا لا راضة الشاء والإبل",64,"ل",1,0],["هم راحةُ الروح والاشباح","هم الأمانُ أتى الوارد",65,"د",1,0],["هُم رُكنُكَ الشَديدُ","وَسَهمُكَ السَديدُ",66,"د",1,0],["هم ربوهُ في صباه فلما","شبَّ انضى إلى سواهم مطيَّة",67,"ي",2,0],["هم رحلوا يوم الخميس عشيّةً","فودّعتهم لمّا استقلّوا وودعوا",68,"ع",3,1],["هم راشوا المكارم فاستقلت","ولكن لم تجد عنهم براحا",69,"ح",2,0],["هُمْ راحِلونَ وأنتَ وحدكَ باقِ","كالجذعِ بعدَ تساقُطِ الأوراقِ",70,"ق",1,1],["هم ربأوا الإسلام وانتصروا له","بعزمٍ وإقدامٍ وشدةِ باسل",71,"ل",1,0],["هم رحماء بينهم وعلى العدا","أسود ولم يشرب جوانحهم رحما",72,"م",2,0],["هم رشحوني للعلى فارتقيتها","وهم اوردوني الفضل منهله العذبا",73,"ب",2,0],["هُم راقَبُوا الغَفْلاتِ فِيكَ فأُطمِعُوا","والغَافِلُونَ فَرائسٌ بَيْنَ الوَرَى",74,"ر",2,0],["هم رصّّعوا رأسه تاجَ الريا ذهباً","وقَلَّدوه سيوفَ الب