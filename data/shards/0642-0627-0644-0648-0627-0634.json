{"poems":[[35,"إني لأجلس في النادي أحدثهم","https://www.aldiwan.net/poem25845.html","البسيط"],[107,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[104,"تحية لك يا مصر الفراعين","https://www.aldiwan.net/poem33034.html","السريع"],[50,"كيف النزوع عن الصبا والكاس","https://www.aldiwan.net/poem63424.html","الطويل"],[78,"قالوا شبابك قد ولى فقلت لهم","https://www.aldiwan.net/poem38870.html","البسيط"],[78,"قالوا شبابك قد مضت أيامه","https://www.aldiwan.net/poem38988.html","الكامل"],[108,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[139,"رقيتني حسا ومعنى","https://www.aldiwan.net/poem49107.html","مجزوء الكامل"],[463,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[469,"قالوا شكا جسم ابرهيم قلت لهم","https://www.aldiwan.net/poem3223.html","عموديه"],[556,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48727","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108858","السريع"],[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127843","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60827","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93927","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216595","المجتث"],[4542,"","https://poetry.dctabudhabi.ae/diwan/poem/76556","البسيط"],[4935,"قالوا شتمت من اللئام أجبتهم","https://www.poetsgate.com/ViewPoem.aspx?id=129325",""],[5050,"ما لي وللأنذال والغوغاء","https://www.poetsgate.com/ViewPoem.aspx?id=38216",""],[5135,"قالوْا \"شَرِيْفٌ\"","https://www.poetsgate.com/ViewPoem.aspx?id=201815",""],[5320,"قالوا","https://www.poetsgate.com/ViewPoem.aspx?id=42041",""],[5320,"صيحة فدائى","https://www.poetsgate.com/ViewPoem.aspx?id=40418",""],[6102,"معلمة الموسيقى ..","https://www.poetsgate.com/ViewPoem.aspx?id=185060",""]],"verses":[["قالوا شَبيهَكَ لا يَخفى عَلى أَحَدٍ","لَيلى الجَمالِ رِضاها القَصدُ وَالسولُ",0,"ل",1,0],["قالوا شَهِدنا دينُكم خيرٌ لكم","من دينِ صاحِبكم وأصدقُ سيما",1,"م",2,0],["قالوا شفاؤك في مصر وَقَد يَئسوا","مني وَأَعيي سقامي مَن يُداويني",2,"ن",2,0],["قالوا شَمِطتَ فَقُلتُ ما شَمِطَت يَدي","عَن أَن تَحُثَّ إِلى فَمي بِالكاسِ",3,"س",1,0],["قالوا شبابُكَ قد ولَّى فقلتُ لهُمْ","هل من جَديدٍ على كرِّ الجَديدينِ",4,"ن",1,1],["قالوا شَبابُكَ قد مضَتْ أَيامُهُ","بالعيشِ قلتُ وقد مَضت أَيامي",5,"م",2,1],["قالوا: شفى الأبدان. قلت: وشعره","طبُّ النفوس، وصحَّةُ الأخلاق",6,"ق",1,0],["قالوا شخصت إلى قنا","يا مرحباً بقنا وإسنا",7,"ن",2,0],["قال واشيها وقد راودْتُها","رشفةً تبرُدُ قلبي من لمَاها",8,"ا",3,0],["قالوا شكا جسم ابرهيم قلت لهم","تنآد لدن القنا حيناً وتعتدل",9,"ل",1,1],["قالوا شكوتَ الحبّ في كَلِمٍ","مَنظومةٍ مِن غَيرِ ما كلمِ",10,"م",1,0],["قالوا شديد البأس قلت لهم على","قدر الفريسة يركب الأخطارا",11,"ر",2,0],["قالوا شهابيٌّ ورب السما","مثل اسمه وافى بقلب سليم",12,"م",1,0],["قالوا شباب الفتى خؤونُ","والشيبُ وافٍ وليس يرحل",13,"ل",1,1],["قالوا شُغلْتَ بليلي وهي فارغة","فقلتُ ليسَ المُعَافى مثلَ ذي سِقَمِ",14,"م",1,0],["قال واشي الهوى بمن أنت صب","كم تكنى عنه فقل لي صريحا",15,"ح",2,0],["قالوا شقاءٌ فقلنا","نعم فأين النعيم",16,"م",1,0],["قالُوا شِفاؤك في السُلوان عَنهُ إِذن","قُلتُ السُلّو عَنِ السُلوانِ يَشفِيني",17,"ن",2,0],["قالوا شتمت من اللئام أجبتهم","إن الكرام مذمة اللؤماء",18,"ا",2,1],["قالوا شديد طبعه ذو غلظة","فأجبتهم لكن على السفهاء",19,"ا",2,0],["قالوْا \"شَرِيْفٌ\" وَلَمْ تَفْخَرْ بِذا النَّسَبِ","فقُلْتُ يا قَوْمُ هَٰذا لَيْسَ مِنْ تَعَبِي",20,"ب",2,1],["قالوا: شريدا قلت : لا","سيكون فى بلدى المقام",21,"م",1,1],["قالوا : شريكا قلت : لا","وحدى للعادى الزؤام",21,"م",1,0],["قالوا شريدا قلت لا","ويدي يعاتبها الحسام",22,"م",1,0],["قَالُوا: (شَغَفتُكَ- يَا فَتَايَ- وَإِنَّنِي","بِالطَّردِ وَالإقصَاءِ- لَا التِّلمِيذُ- أَولَى)",23,"ل",2,0]]}