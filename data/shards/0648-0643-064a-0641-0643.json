{"poems":[[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[164,"خذوا لي من سعدى أمانا من الهجر","https://www.aldiwan.net/poem59078.html","الطويل"],[240,"ألا مبلغ عني المهين ابن عروة","https://www.aldiwan.net/poem31912.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[325,"أقبل معاذير من يأتيك معتذرا","https://www.aldiwan.net/poem67110.html","البسيط"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80241","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119609","المتقارب"],[4691,"ماذا يريد السقام من قمر","https://www.poetsgate.com/ViewPoem.aspx?id=215322",""],[5277,"وطن الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=190100",""],[5561,"حبيبتي في الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=192909",""],[5667,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=214890",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[6102,"سارة","https://www.poetsgate.com/ViewPoem.aspx?id=184409",""]],"verses":[["وكيف كان العاقبة","فإن مصر الخائبة",0,"ه",1,0],["وَكَيْفَ كَانَتْ لَنَا الأَيَّامُ طَائِعَةً","كَمَا تَشَاءُ فَلَمْ تُهْمِلْ لَنَا طَلَبَا",1,"ب",2,0],["وكيف كفاه الله ما كان يتقى","واطفا عنه الشر من كل ذى شر",2,"ر",1,0],["وَكَيفَ كَرِهتَ اليَومَ مِنهُ سَجِيَّةً","وَقَد كُنتَ تَرضاها لِنَفسِكَ بِالأَمسِ",3,"س",1,0],["وَكيفَ كَساها الفخر مسداً وملحماً","بعزٍّ وإجلالٍ فجرّت له الهدبا",4,"ب",2,0],["وَكَيفَ كانَ فَلَم يَجهَر بِمَعصِيَةٍ","وَقَد أَجَلَكَ مَن يَعصيكَ مُستَتِرا",5,"ر",2,0],["وكَيف كَتمتِ اللَّيل وَجْهَكِ مظلماً","أَشْعَرَكِ أَغشيْتِ السَّنا أَم شِعَارَكِ",6,"ك",1,0],["وَكَيفَ كُنتِ فَإِني ثابِتٌ أَبَداً","عَلى غَرامَكِ لا أَلوي عَلى بَشَرِ",7,"ر",1,0],["وكيف كسَفتَ دراريَّه","وغَيَّبتَ من شكلهِ النَّيّرا",8,"ر",2,0],["وكيف كان الفؤاد في عِللٍ","من حبّهِ حين مدّ جفوتَهُ",9,"ت",2,0],["وكيفَ كانَ وهل راقتْكَ طلّتُهُ","مثلَ المليكِ مَهيباً لا يُجافينا",10,"ن",2,0],["وكيف كانت حكايانا تسامرُنا","ويرتوي ضمأً مِن حبِّنا الآه",11,"ا",2,0],["وكيفَ كنّا على الأعشابِ نَنثرُها","أحلى الترانيمِ والأطيارُ تَبتَسمُ",12,"م",1,0],["وكيف كبرتُ ولم ، وأتيتُكِ","نصفيَ شيخٌ ونصفٌ غلامْ",13,"م",1,0],["وَ كَيفَ كَيفَ استَطَعتِ النَّومَ وَادِعَةً","فِيمَا يُؤَرِّقُنِي الكَابُوسُ وَ الحُلمُ ؟",14,"م",1,0]]}