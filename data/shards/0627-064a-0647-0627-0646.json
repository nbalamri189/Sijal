{"poems":[[99,"إيه إنعام والمحاسن كثر","https://www.aldiwan.net/poem24342.html","الخفيف"],[99,"يا جزيل الهبات والإنعامِ","https://www.aldiwan.net/poem24344.html","الخفيف"],[107,"عهد لمصر من الحياة جديد","https://www.aldiwan.net/poem43166.html","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141295","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61009","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101627","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83470","الكامل"],[4802,"انخذلت","https://www.poetsgate.com/ViewPoem.aspx?id=36909",""],[4869,"صوت الانين","https://www.poetsgate.com/ViewPoem.aspx?id=151712",""],[4924,"اسمحي لي يا الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=22080",""],[4988,"من هبس انا إيه !","https://www.poetsgate.com/ViewPoem.aspx?id=213920",""],[585,"لا تقولوا بلغ السيل الزبى","https://www.poetsgate.com/ViewPoem.aspx?id=161856",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5145,"رجعت صبوته إن خطرا","https://www.poetsgate.com/ViewPoem.aspx?id=108110",""],[5198,"بوصلة","https://www.poetsgate.com/ViewPoem.aspx?id=136236",""],[5302,"في فؤادي ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=201267",""],[5401,"شمعة الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=78670",""],[5433,"حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=36220",""],[5455,"الدلوعه","https://www.poetsgate.com/ViewPoem.aspx?id=35554",""],[5455,"سالفة عشاق","https://www.poetsgate.com/ViewPoem.aspx?id=34372",""],[5463,"ودّي أحضن[ سلوى ] للمرّة الأخيره","https://www.poetsgate.com/ViewPoem.aspx?id=34690",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[5848,"أنا اقصد حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=52026",""],[6113,"سر الجاذبيه","https://www.poetsgate.com/ViewPoem.aspx?id=120889",""]],"verses":[["إيه إنعامُ والمحاسنُ كُثرُ","ما لمن لم يقم بوصفِكِ عذرُ",0,"ر",1,1],["إيه إنعام هذه صولة الحسنِ","التي تَحطِمُ القويَّ وتذرو",0,"ر",2,0],["إيه إِنعام والقصائد تَترى","أنتِ سرُّ الإِبداعِ في الأقلامِ",1,"م",1,0],["أَيُهانُ لِلأَهرامِ مَجدٌ باذِخٌ","وَيُضامُ تَاريخٌ لِمِصرَ مجيدُ",2,"د",1,0],["إيه أنطون يا كريم المعاني","ووديع الخلال قلباً ومبسم",3,"م",1,0],["أيهانُ عندك موقفي وأنا الذي","يحمي عليك فؤاده ويغار",4,"ر",1,0],["أيهان فرعون الكبير بقبره","وهو العزيز بملكه وجنابه",5,"ب",2,0],["أَيُهانُ من كرُمت إِلى علياك نس","بتهُ وَقد تخذ المَعالي ديدنا",6,"ن",2,0],["إيه إنخذلت ولا بواحد ولا إثنين","وما أقول كل المجتمع بس جلّه",7,"ل",2,1],["ايه انطبع حزني على وجه الايام","ايه انمحى صوتي ويبّس وريدي",8,"د",2,0],["ايه انا والعالم المغرور والياس اللحوح","خايض حرب الرياح اللي تسوق الاشرعه",9,"ع",2,0],["إيه اِنِحني توجيب واجلال واكبار","يا قافي اللي تعطي الحقّ راعيه",10,"ي",2,1],["إيه إنا قد بذلنا النفس عن","طيبةٍ حين القتال انتشبا",11,"ب",2,0],["إِيِهِ أَنْسَى ؟ كَيْفَ أَغْدُو","إِنْ أَلِفْتُ الْحُبَّ هَجْرَا",12,"ر",2,0],["آية أنزلها الله: بها","بتلى معروفنا والمنكرا",13,"ر",2,0],["ايه انا فوضوي واوراقي مبعثرة","ونبض قلبي قريّب من سهام الرُماة",14,"ا",2,0],["آية أنت في الجمال يحار ال","فكر فيها وتذهل الأفهام",15,"م",1,0],["إيه أنتضر تهطل سحابة ودّنا","ماحب أكرر في معاناتي وأعيد",16,"د",1,0],["ايه انصتي ياشجون الروح ممنونه","جاني رقيق المشاعر ناوي الخوه",17,"و",2,0],["إيه أنا ياأم الترف قلبي غدا موضوعه","الفراق اللي بلا رجعه وطاري جيه",18,"ي",2,0],["ايه انا هذا طريقي ( موحش .. وصعب .. وطويل )","وانت لامنك تعبت .. العالم فجوجه وساع",19,"ع",1,0],["إيه أنا المخطي وهذا القلب ذلّه","هين أبوه وخلّ به العيشه مريره",20,"ر",2,0],["آية أنتِ من زخارف شتى","طرّزتها بوشيها الأشجار",21,"ر",1,0],["إيه .. انا اقصد حبيبي .. ليه ؟ عندي حبيب !","غير من له رخصت عيون غير القلوب",22,"ب",1,0],["ايه انا حبيت وحده وهدمت قلبي حسافه","رغم كل اللي حصل لي لاتزال تموت فيّه",23,"ي",2,0]]}