etsgate.com/ViewPoem.aspx?id=156476",""],[5186,"\"ثلاث ليال يا \"\"جريج\"\" قضيتها","https://www.poetsgate.com/ViewPoem.aspx?id=156527",""],[5232,"أمُّ الحضاره","https://www.poetsgate.com/ViewPoem.aspx?id=212984",""],[5277,"ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=184903",""],[5280,"تراءت","https://www.poetsgate.com/ViewPoem.aspx?id=189574",""],[5282,"رداء المروءة","https://www.poetsgate.com/ViewPoem.aspx?id=213938",""],[5318,"\"لإربدَ\" أن تُعاتبَ ما اْستطابتْ..","https://www.poetsgate.com/ViewPoem.aspx?id=211011",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5376,"يا قِبلةَ الشوقِ هاج القلبَ وجدانُ","https://www.poetsgate.com/ViewPoem.aspx?id=191873",""],[5376,"لكلِّ خليقةٍ فضْلٌ وبرُّ","https://www.poetsgate.com/ViewPoem.aspx?id=197280",""],[5397,"هلال دجى وشمس ضحى وفرقد","https://www.poetsgate.com/ViewPoem.aspx?id=157966",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5508,"وقفنا على حكم الهوى نعلن الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=110819",""],[5561,"الحريّة","https://www.poetsgate.com/ViewPoem.aspx?id=193313",""],[5561,"عروبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=213353",""],[5628,"ميادة الحناوي","https://www.poetsgate.com/ViewPoem.aspx?id=180395",""],[4444,"شردت يا هذا شرود البعير","https://www.poetsgate.com/ViewPoem.aspx?id=85447",""],[5714,"أشذى من الفل","https://www.poetsgate.com/ViewPoem.aspx?id=213798",""],[5720,"البَصْمَة","https://www.poetsgate.com/ViewPoem.aspx?id=200696",""],[5723,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=25485",""],[5725,"هنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=206598",""],[5759,"أقولُ لها","https://www.poetsgate.com/ViewPoem.aspx?id=214106",""],[5874,"الدَّرْوِيشَة","https://www.poetsgate.com/ViewPoem.aspx?id=212177",""],[5952,"تضوع عطراً","https://www.poetsgate.com/ViewPoem.aspx?id=202703",""],[5956,"من الخلد هطلتْ غادةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182335",""],[5977,"أمة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=212755",""],[5997,"بحرٌ وأطْلس","https://www.poetsgate.com/ViewPoem.aspx?id=214227",""],[6052,"بستان جهدي","https://www.poetsgate.com/ViewPoem.aspx?id=50109",""],[6117,"أَوْرَاقُ مُسَافِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=182787",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6125,"هي الحبُّ المُعَتَّقُ في دِمَائي","https://www.poetsgate.com/ViewPoem.aspx?id=210959",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[520,"لك الحسب الباقي في عقب الدهر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577546",""],[6164,"فتاتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66064&r=&rc=73",""],[6225,"عيد ولكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80907&r=&rc=176",""],[6229,"حواء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65186&r=&rc=12",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""],[463,"يقولونَ يومَ البينُ عينكَ تدمعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60123&r=&rc=179",""]],"verses":[["لَها اليَومَ راعٍ لا يُراعُ سَوامُهُ","أَذَلَّ لَها نَهجَ الطَريقِ وَعَبَّدا",0,"د",2,0],["لَها السَبقُ في الضَمّاتِ وَالسَبقُ وَخدُها","إِذا غُطِّيَت مِن نَقعِها بِغِطاءِ",1,"ا",2,0],["لَهَا اللهُ مِنْ نَفْسٍ شُعَاعٍ وَمُهْجَةٍ","هِيَ الْغَرَضُ الْمَقْصُودُ يُثْبِتُهُ السَّهْمُ",2,"م",1,0],["لَها أَرَجٌ في البَيتِ عالٍ كَأَنَّما","أَلَمَّ بِهِ مِن تَجرِ دارينَ أَركَبُ",3,"ب",1,0],["لَها الشَوقُ بَعدَ الشَحطِ حَتّى كَأَنَّما","عَلاني بِحُمّى مِن ذَواتِ الأَفاكِلِ",4,"ل",1,0],["لَها أُذُنٌ حَشرٌ وَذِفرى أَسيلَةٌ","وَخَدٌ كَمِرآةِ الغَريبَةِ أَسجَحُ",5,"ح",1,0],["لها إن تقمْ في دارَةِ الأفقِ منزلٌ","وإن تسرِ حلت من ثرياه هوْدَجا",6,"ج",2,0],["لها أسطرٌ مثل السيوف لدى الوغى","وترميلها في صحفها من دم السفك",7,"ك",1,0],["لها أجرُها إن أحسنتْ فلنفسها","وميزانُها يومَ القيامة يرجَحُ",8,"ح",1,0],["لها ألسُنٌ ما تستفيق لهاتها","يكاد لُعاب الموت منهن يقطر",9,"ر",1,0],["لها إبلٌ وقْفٌ عَليها ولم تزلْ","تقوتُ الرواعي ضبْغها لا العوافط",10,"ط",1,0],["لها أوَّلٌ طوع اليدين وآخرٌ","إذا سمته الإغراق فيها تمنَّعا",11,"ع",2,0],["لها إبط كريح المي","ت منه الرشح والعرق",12,"ق",1,0],["لها أرجٌ بعد الرُّقادِ كأنما","يُحدِّثُ عما فيكِ من طَيِّبِ الشِّيمْ",13,"م",1,0],["لَها الحُجرَةُ الحَسناءُ في القَصرِ إِنَّما","أَحَبُّ إِلَيها رَوضَةٌ وَكَثيبُ",14,"ب",1,0],["لَها الدُرُّ ثَغرٌ وَاللُجَينُ تَرائِبٌ","وَشَمسُ الضُحى أُمٌّ وَبَدرُ الدُجى أَبُ",15,"ب",1,0],["لَها أَمرُها حَتّى إِذا ما تَبَوَّأَت","بِأَخفافِها مَأوىً تَبَوَّأَ مَضجَعا",16,"ع",2,0],["لَها اِبنُ لَيالٍ وَدَّأَتهُ بِقَفرَةٍ","وَتَبغي بِغيطانٍ سِواهُ المَراعِيا",17,"ي",2,0],["لَها النَظرَةُ الأولى عَلَيهِم وَبَسطَةٌ","وَإِن كَرَّتِ الأَبصارُ كانَ لَها العُقبُ",18,"ب",1,0],["لَها القَمَرُ السّارِي شَقِيقٌ وإنّها","لَتَطْلُعُ أَحْياناً لَهُ فَيَغِيبُ",19,"ب",1,0],["لها العَذَباتُ الحُمْرُ تهفو كأنَّها","ضِرامٌ بمُستَنَّ العواصفِ مشبوبُ",20,"ب",1,0],["لَها الدَهرُ إِضرارٌ فَإِمّا فِراقُها","مُجِدٌّ لَنا وَجداً وَإِمّا صُدودُها",21,"د",3,0],["لَها الحَسَبُ الزاكي الَّذي تَعرِفونَهُ","وَفيها طَريفاتُ العُلا وَتَليدُها",21,"د",3,0],["لَها الكَنَفُ الرَحيبُ بِساحَتَيهِ","وَطولُ مُعَرِّسِ الظِلِّ المَديدِ",22,"د",1,0],["لَها اللَهُ عَنّي ضامِنٌ وَكَفيلُ","يُتابَعُ فيها أَو يُطاعُ عَذولُ",23,"ل",1,1],["لَها الأَرضُ إِلّا أَربَعٌ ثَفِناتُها","إِذا اللَيلَةُ السَوداءُ ناداهُ بومُها",24,"م",3,0],["لها أَرَجُ السَّوالفِ حينَ تُجلَى","على الأسماعِ أو أَرَجُ السُّلافِ",25,"ف",1,0],["لها أخَواتٌ لِطافُ القُدُودِ","إذا ما تَبَرَّجْنَ خُضرُ الكُسا",26,"س",2,0],["لَها أَطلُبُ الأُخرى فَإِن أَنا بِعتُها","بِشَيءٍ مِنَ الدُنيا فَذاكَ هُوَ الغَبنُ",27,"ن",1,0],["لَها أَرَجُ اللَطيمَةِ حينَ يَنشا","وَرِقَّةُ مَنظَرِ الحَدِّ اللَطيمِ",28,"م",1,0],["لها العَتْبُ هذا دأبها وَليَ العُتْبَى","سلمتُ من التعذيب لو لم أكن صبّا",29,"ب",2,1],["لَها أَخَواتٌ قَبلَها قَد سَمِعتَها","وَإِن لَم تَزِع بي مُدَّةً فَسَتسَمَعُ",30,"ع",1,0],["لَها أَنَّةٌ قَبلَ العِشاءِ وَأَنَّةٌ","سُحَيرٌ فَلَولا أَنَّتاها لَجُنَّتِ",31,"ت",1,0],["لَها الوَيلُ ماوَجَدَت ثابِتاً","أَلَفَّ اليَدَينِ وَلا زُمَّلا",32,"ل",2,0],["لَها أَرَجٌ مِن زاهِرِ البَقلِ وَالثَرى","وَبُردٌ إِذا ما باشَرَ الجِلدَ يَخصَرُ",33,"ر",1,0],["لَها أُسُّ دارٍ بِالعُرَيمَةِ أَنهَجَت","مَعارِفُها بَعدي كَما يُنهِجُ البُردُ",34,"د",1,0],["لها العَذبَاتُ الحُمْرُ تَهْفُو كأنّهَا","حَواشي بروقٍ أو ذوائبُ أنجُم",35,"م",1,0],["لَها أَليفانِ مِن لَونٍ وَرائِحَةٍ","مَثوى مَقَرِّهِما في العَينِ وَالراسِ",36,"س",1,0],["لَها الثُلثانِ مِن قَلبي","وَثُلثا ثُلثِهِ الباقي",37,"ق",2,0],["لها أيورٌ كالجياد الكُمتِ","لها فياشٍ كرؤوسِ البُختِ",38,"ت",1,0],["لَها السادَةُ الأَشرافُ تَأتي عَلَيهِمُ","فَتُهلِكُهُم والسابِحَاتُ النّجائِبُ",39,"ب",1,0],["لها البدرُ كأسٌ وهيَ شمسٌ يُدِيرُهَا","هلالٌ وكم يبدو إذا مُزِجَتْ نَجم",40,"م",1,0],["لَهَا اللهُ فِي الغِيدِ مِنْ غَادَةٍ","وَفِي الصِّيْدِ مِنْ بَطَلٍ أَصْيَدِ",41,"د",1,0],["لَهَا ابْتِسَامَاتُ الصَّبَاحِ","وَشُجُونُ البُلْبُلِ",42,"ل",1,0],["لها أناشيدُ في الأسماعِ ساحرةٌ","لو كنَّ من لُغَةِ الدنيا رَوَيْناهَا",43,"ا",3,0],["لها أجهشت بالبكاء السما","تناوح أجفاننا الساهده",44,"د",2,0],["لها الكرامة في الكونين موصلة","في القبض والبسط وصلا غير منبتل",45,"ل",1,0],["لها أغلى حبيباتي","بداياتي ... وغاياتي",46,"ت",2,1],["لها الله ما ابهى ودجلةُ حولها","تلف كما التف السوارُ على الزند",47,"د",1,0],["لها أرجٌ في البيتِ عالٍ كأنما","ألمّ مِنْ تَجْرِ دارِينَ أرْكَبُ",48,"ب",1,0],["لها ألسنٌ ما تستفيق لهاتُها","فلو أبصرتْ عيناك يوماً مُقامنا",49,"ن",2,0],["لها الجهلاء تلعب من سرور","ويبكي من عواقبها اللبيب",50,"ب",1,0],["لها أوجه مثل البدورِ كواملا","تَلأْلأ في جُنْحٍ من الليل أَسودِ",51,"د",1,0],["لها اليَلِىٌّ مُسبَكِرٌّ وأشنَبٌ","أغَرُّ شَتِيتُ النَّبتِ مُزرٍ بِدُرِّهَا",52,"ر",3,0],["لَها أَرَجٌ كَنَسيمِ الرِياضِ","وافى رَسيلَ نَسيمِ السَحَر",53,"ر",1,0],["لَها أَرَجٌ تَضَوَّعَ مِن نَداهُ","وَمِن نُوّارِها أَرَجُ الخَمائِل",54,"ل",1,0],["لَها إِذا حَسَّنَ الشِعرَ الغِناءُ غِنىً","عَن أَن يَصوغَ لَها الشادونَ أَلحانا",55,"ن",2,0],["لَها أَنَفٌ أَنتُعقِبَ البَسطَ بِالقَبضِ","امانٌ إِذا ما الخَوفُ ذادَ عَنِ الكَرى",56,"ر",2,0],["لها أذن جود يسمعُ الوهم جنسها","وعينُ سماحٍ نومها لا يخونها",57,"ن",3,0],["لها أفق قد أرج الافق طيبه","تود به لو تطلع الانجم الزهر",58,"ر",1,0],["لها الحسن دون الناس عبد وكلما","علا الناس من حسن فمنها يصرّف",59,"ف",1,0],["لها الهوى قادني قود الاسير فهل","من آخذ بيدي في الحب او قودي",60,"د",2,0],["لها اسكندرية دار بعد دارتها","في عين شمس بها تأوى فتمتنع",61,"ع",1,0],["لَها اللَهُ مِن مَوجوعَةِ القَلبِ فارَقَت","مَرابِعَها الأولى وَقاعُ قِلاها",62,"ا",3,0],["لَها الهَناءُ ولِلدُنيا بِمُلكِكُمُ","يامَن بِهِم تَفخَرُ الدُنيا وَمَن فيها",63,"ي",3,0],["لَها إِذا اِستُجلِيَت قَبولٌ","كَأَنَّها غادَةٌ شَموعُ",64,"ع",1,0],["لَها أَرَجٌ كَما اِستَقبَل","تَ مِن رَوضِ الحِمى نَفَسا",65,"س",2,0],["لَها إِذا شَجَّها الما","ءُ في الزَجاجِ هَديرُ",66,"ر",1,0],["لها الماء روحٌ وهي نارٌ يزينُها","دخانٌ وكم تحلو إذا اشتعلَ الفَحمُ",67,"م",1,0],["لها أُمها صنعتهُ وفيهِ","صليبٌ حَمى الطهرَ ليلَ نهارا",68,"ر",2,0],["لها العيش أرجو بعد موتي فطالما","رأيتُ من الأيام تقليبَ أحوال",69,"ل",1,0],["لها الخيرُ إنّي حافظٌ لجميلِها","كفاني بها أنسٌ على وَحشةِ السَفر",70,"ر",1,0],["لها الهامُ يومَ السّلم والحربِ تنحَني","سَنابِلُ مَرجٍ رَنّحتها النّياسِم",71,"م",1,0],["لَهَا اللَّهُ مَاذا فِي القَلائِدِ مِنْ حُلىً","تَشِفُّ وَماذا في الشُّفُوفِ وفِي القُمْصِ",72,"ص",1,0],["لَهَا اللّهُ لِمْ ضَنّتْ عَلَيّ بِوَصْلِها","وَلِم حَرمَتني القرْبَ دونَ ذرَى القرْبى",73,"ب",2,0],["لَها أَشَدُّ وِطاءٍ بِالموطَّأ مَر","وِيّاً وَأَقوَمُ قيلٍ فازَ منشيها",74,"ي",3,0],["لَها العَينُ وَالجيدُ مِن مُغزِلٍ","تُلاعِبُ في القَفَراتِ الغَزالا",75,"ل",2,0],["لها اللهُ من مفتونةٍ بجمالها","فما موضعٌ من قلبها لي خاليا",76,"ي",2,0],["لها أبداً شوق إلى خير معهد","به خير عهد في العصور القديمة",77,"ه",1,0],["لَها اللّه واقٍ دولةً أحمديَّةً","لَقد أعتَبَت لِلدهرِ طلعتها البكرُ",78,"ر",1,0],["لها الله ما لطمتها الرياح","وما استيقظت في حماها الجراح",79,"ح",1,0],["لها الله من