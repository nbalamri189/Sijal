{"poems":[[55,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[90,"وبيضاء أغناها عن الحلي ثغرها","https://www.aldiwan.net/poem44839.html","الطويل"],[53,"تذكرت ما سخى بنفسي عنكم","https://www.aldiwan.net/poem65858.html","الطويل"],[72,"حبيبي على الدنيا إذا غبت وحشة","https://www.aldiwan.net/poem42830.html","الطويل"],[72,"أرى قوما بليت بهم","https://www.aldiwan.net/poem43003.html","مجزوء الوافر"],[45,"أريقك أم ماء الغمامة أم خمر","https://www.aldiwan.net/poem9572.html","الطويل"],[51,"ألا قل لابن معن ذا","https://www.aldiwan.net/poem64281.html","الهزج"],[51,"أرى قوما وجوههم حسان","https://www.aldiwan.net/poem65332.html","الوافر"],[82,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[22,"أفيما خلا من سالف العيش تدكر","https://www.aldiwan.net/poem21656.html","الطويل"],[48,"أتذهب دار بالنضار وربها","https://www.aldiwan.net/poem22080.html","الطويل"],[48,"ألا فانعموا واحذروا في الحياة","https://www.aldiwan.net/poem23437.html","المتقارب"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85439","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39639","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72182","الطويل"],[13,"أَلاَ أَبْلِغْ بَنِي فَهْم بنِ عَمْروٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180812",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[107,"الله أكبر باسم الله أهديها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54930&r=&rc=100",""],[190,"أرى قوما شجيت بهم رذالا","https://www.aldiwan.net/poem43473.html","الوافر"],[203,"رويدا إنما الأيام سفر","https://www.aldiwan.net/poem45665.html","الوافر"],[216,"أرى قلمي فوق الصحائف يعبث","https://www.aldiwan.net/poem37902.html","الطويل"],[228,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[287,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[422,"بروحك يا سليمى ما لقلبي","https://www.aldiwan.net/poem53844.html","الوافر"],[447,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[454,"جهاد ولكن ليس بالسيف والقن","https://www.aldiwan.net/poem990.html",""],[463,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[556,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[558,"أريقا من رضابك أم رحيقا","https://www.aldiwan.net/poem68282.html","البسيط"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104450","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63970","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37972","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102287","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78028","الوافر"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113945","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108822","الوافر"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36198","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49605","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118369","الطويل"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76903","الوافر"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69487","الوافر"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34902","الهزج"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121134","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100425","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200419","الوافر"],[3104,"","https://poetry.dctabudhabi.ae/diwan/poem/79632","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45789","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59509","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35643","البسيط"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97090","المجتث"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34745","السريع"],[5064,"المُشتاقُ حتفًا","https://www.poetsgate.com/ViewPoem.aspx?id=199098",""],[3591,"كفكف دموعَ عيونٍ قد سفكن دماً","https://www.poetsgate.com/ViewPoem.aspx?id=149401",""],[5117,"(الغِل)","https://www.poetsgate.com/ViewPoem.aspx?id=12147",""],[5135,"الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=201877",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5431,"تُضاء بنا الأكوان حبا ولن نُطفا","https://www.poetsgate.com/ViewPoem.aspx?id=193477",""],[444,"صباح مُحلّى حُبّا","https://www.poetsgate.com/ViewPoem.aspx?id=184403",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5873,"حصون العز","https://www.poetsgate.com/ViewPoem.aspx?id=215408",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[5975,"أمنيات الورود","https://www.poetsgate.com/ViewPoem.aspx?id=53259",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6063,"\"نبأٌ يقينٌ..!\"","https://www.poetsgate.com/ViewPoem.aspx?id=188934",""],[6152,"صبا نجد","https://www.poetsgate.com/ViewPoem.aspx?id=201750",""],[6189,"خميرة الممكنات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83561&r=&rc=28",""],[6336,"في ليلة غائمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73558&r=&rc=19",""],[6344,"طُقُوسُ العاشِقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87967&r=&rc=7",""]],"verses":[["أُريقَت في قُبورِهِمُ اللَواتي","بِبَطنِ القاعِ أَذنِبَةُ النَوالِ",0,"ل",1,0],["أرى قَطَراتِ الدمع في وَجَناتها","فأحسبها الياقوت رُصّع بالدرّ",1,"ر",1,0],["أرى قربكم عِدلَ الحياة وروحَها","ويعدل عندي قُربه الموت والقتلا",2,"ل",2,0],["أَرى قَصدَهُ أَن يَقطَعَ الوَصلَ بَينَنا","وَقَد سَلَّ سَيفَ اللَحظِ وَالسَيفُ قاطِعُ",3,"ع",1,0],["أَرى قَوماً بُليتُ بِهِم","نَصيبي مِنهُمُ نَصبي",4,"ب",2,1],["أَريقُكِ أَم ماءُ الغَمامَةِ أَم خَمرُ","بِفِيَّ بَرودٌ وَهوَ في كَبِدي جَمرُ",5,"ر",1,1],["أَرى قَومَكَ أَبطالا","وَقَد أَصبَحتَ بَطّالا",6,"ل",2,0],["أَرى قَوماً وُجوهُهُمُ حِسانٌ","إِذا كانَت حَوائِجُهُم إِلَينا",7,"ن",2,1],["أرى قائدَ القوّادِ أعطى مَقَادَهُ","لحكم قضاءٍ في البرايا محكَّمِ",8,"م",1,0],["أَرى قُصوراً يِضمُّ العارَ شامِخُها","أَرى طَيالِسَ يُخفي السوءَ غاليها",9,"ي",3,0],["أَرى قَومَنا لا يَغفِرونَ ذُنوبَنا","وَنَحنُ إِذا ما أَذنَبوا لَهُمُ غُفُر",10,"ر",1,0],["أَرى قَبَساً في الجِسمِ يُطفِئُهُ الرَدى","وَما دُمتَ حَيّاً فَهوَ ذا يَتَلَهَّبُ",11,"ب",1,0],["أَرى قَدَراً بَثَّ أَحداثَهُ","فَخَصَّ بِهِنَّ أُناساً وَعَم",12,"م",1,0],["أَرى قَبرَ نَحّامٍ بَخيلٍ بِمالِهِ","كَقَبرِ غَويٍّ في البَطالَةِ مُفسِدِ",13,"د",1,0],["أَريقت دماءٌ من رجال أَعزة","بأَوطانهم فاحمرَّ منها صعيدها",14,"د",3,1],["أرى قبضةَ الشيطان تستلُّ خنجراً","توهَّجُ شوقاً للدماءِ مَضارِبُهْ",15,"ب",2,0],["أُرِيقَتْ جِفانُ ابْنِ الخَلِيعِ فأَصْبَحَتْ","حِياضُ النَّدى زالَتْ بِهنَّ المراتبُ",16,"ب",1,1],["أرَى قَدَمَيَّ وَقْعُهمَا حَثِيثٌ","كَتَحْلِيلِ الظَّلِيمِ دَعَا رئَالَهْ",17,"ل",2,0],["أرى قبر نخامٍ بخيلٍ بماله","كقبر غويٍ في البطالة مفسد",18,"د",1,0],["أرى قصوراً بضم العار شامخها","أرى طيالس يخفي السوء غاليها",19,"ي",3,0],["أرى قوما شجيت بهم رذالا","وقد زادوا على حد الرذال",20,"ل",1,1],["أرى قوماً أعدوا ما استطاعوا","لدهرهمُ وقوماً ما أعدوا",21,"د",3,0],["أرى قلَمِي فوقَ الصحائفِ يَعْبَثُ","كمثلِ حصانٍ في الميادينِ يَنْفُثُ",22,"ث",1,1],["أَرى قَلَمي المَظلومَ في هَدأَةِ الدُجى","يَنامُ مَعَ الأَوراقِ قُربَ المحابِرِ",23,"ر",1,0],["أريقُكِ أَم صَهباءَ في الكَأسِ إِسفِنطُ","وَثَغرُكِ أَم دُرٌّ تَضَمَّنَهُ السِّمطُ",24,"ط",1,1],["أُريقُ دَمَ العيون غداةَ سارت","ركائبهم وأيُّ دمٍ أُريق",25,"ق",1,0],["أَريقي الدمع يا مقلي أَريقي","على أمي وابن أخي الشقيق",26,"ق",1,1],["أرى قوم موسى لم يوحد شتاتهم","لسان ولا جنس ولا اللون ما دنا",27,"ن",2,0],["أرى قلبي يطيش إذا المطايا","إلى الرابين ياسَرهنَّ حادِي",28,"د",2,0],["أُرَيْقِطٌ غيرَ أرفاغٍ نَجَوْنَ كما","مسّ الفتى من نواحي جلده البَهَقُ",29,"ق",1,0],["أَريقاً مِن رَضابِكَ أَم رَحيقاً","رَشَفتُ فَكُنتُ مِن سُكري مُفيقا",30,"ق",2,1],["أَرى قاتلي غُصُناً ناضراً","ولكن له مَرشفٌ ذابل",31,"ل",1,0],["أرى قوامك مثل الغصن منعطفا","وليس يدنيه لي عطف ولا ميل",32,"ل",1,0],["أرى قلبيَ في حُبِّ","كَ محمولاً على خُطَّه",33,"ط",2,0],["أَرى قُربَ إِقبالِ الحَبيبِ لمغرمٍ","بِكَثرةِ هِجرانٍ تُؤدّي لأخطارِ",34,"ر",1,1],["أريقته في الكأس أم صرف خمره","وهذا حباب المزج أم سيط ثغره",35,"ر",2,1],["أَرى قَلبي بِلَيلي زادَ ميلا","وَما جَرَّت بِربعي قَط ذَيلا",36,"ا",1,1],["أرى قلبَكَ الأعشارَ والكبدَ الفِلَذ","منَ الأمرِ أمراً كانَ أسفَلُه أحَذّ",37,"ذ",1,1],["أرى قول المنجم في سهيلٍ","ضعيفاً ما له عندي دليل",38,"ل",1,0],["أَرى قدمي أَراقَ دَمي","وَهانَ دَمي فَها نَدَمي",39,"ي",1,1],["أَريقُ ثَغْرِكِ أمْ ينتُ الزَّراجين","وَعَرْفُ نَشْرِكِ أم مِسْكٌ بدارينِ",40,"ن",1,1],["اريقا بها ماء الشؤون وخليا","عزاليه ما بين هام وهامع",41,"ع",1,0],["أَريقاً من رضابِك أَم رَحيقا","رشفتُ فَلَستُ من سُكري مُفيقا",42,"ق",2,1],["أُريقَ دَمُ الحُسَينِ وَلَم يُراعوا","وَفي الأَحياءِ أَمواتُ العُقولِ",43,"ل",1,0],["أَرى قَلبي قَد حَنّا","إِلى دَيرِ مَريحَنّا",44,"ن",2,1],["أرى قلبي على أسما","جريحاً طرفه أعمى",45,"م",2,1],["ارى قمر السماء اذا تعلىَّ","يلوح بذلك الوجه الوجيه",46,"ي",2,0],["أرى قلبي يرفّ لكل غصنٍ","ترنّح للشمّال أو اليمين",47,"ن",1,1],["أرى قَوْمي بني قَطَنٍ أرادوا","بأَلاَّ يتركوا بيدَيَّ مالا",48,"ل",2,1],["أَرى قَصَبات السبق في حَلبة العُلا","وَما كُل سبّاق إَلَيها بِلاحق",49,"ق",1,0],["أريقُوا علَيهم وابِلاً من عِقابِكمْ","عسى يقْعدُ البغي الذي هو قائمُ",50,"م",1,0],["أَرى قَوافيهِ أَطياراً مُغرّدَةً","بِأَلسُن الحَمد وَالأَبيات أَغصانا",51,"ن",2,0],["أَرى قَومَنا يَبكونَ شَجوَ نُفوسِهِم","وَقَد بَعَثوا مِنّا كَذلِكَ مَأتَما",52,"م",2,0],["أريق فيها دموعي","على دم مهراق",53,"ق",1,0],["أَرى قُروناً قَد تَجَلَّلنَهُ","مَنصوبَةً شُعِّبنَ تَشعيبا",54,"ب",2,0],["أَرِيقِي مِنْ فَمِي الكلِمَاتِ، بَيني","وبيَنكِ زاخِرُ العينينِ جَفَّا",55,"ف",2,0],["أرى قوامك مثل الغصن منعطفاً","فاذكر المنحنى والضال والعلما",56,"م",2,0],["أُريقُ قَطْرَ السَّنا أحْيي أجادِبَهُمْ","والحقُّ يشهدُ أني الصَّادقُ الأسما",57,"م",2,0],["أرى قلْبي تدثَّرَ بالْحنيْنِ","ولمْ يسْليْه تكْرارُ السِّنيْنِ",58,"ن",1,1],["أريقت برغم الدين هدرا دماؤه","وللحشر تبقى لا تؤدى دياتها",59,"ت",3,0],["أُريقت على درب الحياة نفوسنا","وسيقت الى جرْف وصارت لنا منفى",60,"ف",2,0],["أريقي دماء الوصل يكفيك أنه","يعيش على الذكرى، يموت تذكرا",61,"ر",2,0],["أُريقُ بها دمَ الاِبريقِ صرفاً","وغصنُ شبابنا غضُّ وريقُ",62,"ق",1,0],["أرى قد هام قلبك إشتياقا","على آثار من أبدت شقاقا",63,"ق",2,1],["أرى قوة التقليد عندك في الذبى","ولكنّ شِعْرَك للحداثةِ عاصيا",64,"ي",2,0],["أرى قلبي بحبِّكمُ استراحا","وهدهدَ حلمَهُ واستلَّ راحا",65,"ح",2,1],["أرَى قُرْبَهُ غُنْمي ولم أدرِ أنّهُ","على عكسِ ما عنديْ يرَى غُنمَهُ هَجْري",66,"ر",2,0],["أَرى قَدري عَلى خدَّيكِ تيهًا","وَ خارطةُ الغوايةِ منتَهاهُ..؛",67,"ا",2,0],["أريق دماء النوق يوم لقاءكم","وأرفدها دينا إذا عجز النقد",68,"د",1,0],["أُريقه عطراً صباً ديمةً","ذؤابتها تُنعش البَلْقَعا",69,"ع",2,0],["أريقي السنايا أخت عل شعاعة","تطوف بمثواها فتمسح خدّها",70,"د",3,0],["أَرِيقِي فَوْقَ ثَغْرِيَ شَهْدَ ثَغْرِكْ","لِأَبْلُغَ سَكْرَتِي مِنْ صَفْوِ خَمْرِكْ",71,"ك",1,1]]}