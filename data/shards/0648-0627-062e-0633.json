{"poems":[[53,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[52,"غمض الحديد بصاحبيك فغمضا","https://www.aldiwan.net/poem62354.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142039","الوافر"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[371,"أمنت بحمد الله مما أحاذر","https://www.aldiwan.net/poem17199.html","الطويل"],[411,"سرورك بالدنيا غرور فلا تكن","https://www.aldiwan.net/poem49415.html","الطويل"],[411,"بين من يعطي ومن يأخذ","https://www.aldiwan.net/poem49888.html","مجزوء الرمل"],[445,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[447,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[463,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[510,"بيان","https://www.aldiwan.net/poem42464.html","الهزج"],[567,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96638","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96641","الطويل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216666",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118432","الرجز"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143191","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137157",""],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145184","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101351","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5582,"أَلا هَلْ شَجاكَ الأَوْرَقُ المُتَغَرِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63491",""]],"verses":[["وأخسُّ الرجالِ مَنْ راحَ فيهم","مُسْلَمَ العِرض سالماً ماعونه",0,"ن",2,0],["وَأَخٌ سَلَوتُ لَهُ فَأَذكَرَهُ أَخٌ","فَمَضى وَتُذكِرُكَ الحَوادِثُ ما مَضى",1,"ض",2,0],["وأخسَرُ صفقة الأوطان قومٌ","إذا نكِبَت بكاها أو تباكى",2,"ك",2,0],["وَأَخسَرُ الناسِ سَعياً رَبُّ مَملَكَةٍ","أَطاعَ في أَمرِهِ النِسوانَ وَالخَدَما",3,"م",2,0],["وَأَخسرُ خلقِ اللَّه مَن كانَ كافراً","وَإِن مَلَكَ الدُنيا وَعاشَ بِها دَهرا",4,"ر",2,0],["وَأَخسَرُ خَلقِ اللَهِ في الصِدقِ صَفحَةً","عَدُوٌّ يَرى أَنّي بِبابِكَ خاسِرُ",5,"ر",1,0],["وأخسرُ أهلِ الأرضِ من عاشَ غافلاً","فلم يحيَ مشكوراً ولم يفنَ معذوراً",6,"ر",2,0],["وأخسُّ الوِردِ ما يُكْ","رَعُ فيهِ وهو بَرْضُ",7,"ض",1,0],["واخسِفِ الشِّرْكَ بعزمٍ يُنْتَضى","سَيْفُهُ عن قُلْ هُوَ اللهُ أَحَدْ",8,"د",1,0],["وأخسر خلق اللَه ديناً وبعدها","ذميم المساعي للذنوب قروف",9,"ف",1,0],["وأخ سبيلي في الحياة سبيله","مُلقىً إليّ وما إليه سبيلُ",10,"ل",1,0],["وأخْسَرْنا موازينا","فامْسينا مَدِينينا",11,"ن",2,0],["وأخسَرُ ما يَضيعُ العُمرُ فيهِ","فَضولُ المالِ تُجمَعُ للرِّفاقِ",12,"ق",1,0],["وَاخسأ فَقَد أَنشدت فيكَ مؤرّخا","يا ألكناً أَنا أَرشد الشُعَراء",13,"ا",2,0],["وَأَخسرُ خلقِ اللّهِ مَن كان كاذباً","يَبوحُ بسرٍّ لا يبوحُ بما يسدُ",14,"د",1,0],["وَأَخسرُ خلقِ اللّه مَن نالَ ثروةً","وَيُسراً وَلَم يَبسط له عندها يدُ",14,"د",1,0],["وَأخسرُ خلقِ اللّه من قطع المدى","حَياة وَلم يَحمَدهُ في الناس حامدُ",15,"د",1,0],["واخسر هوانا والحيا والمناعه","واصبِح مثَل بين الملا كالمجينين",16,"ن",1,0],["واخسف الى ان تجعل البياض في","ختمكها كلوزةٍ لا تختفي",17,"ي",1,0],["واخسفه إن أتى كجيمِ جعفرِ","ونحوه وراعِ ميلَ الاسطرِ",17,"ر",1,0],["واخسر الناس بغير ثنيا","من باع اخراه بحرث الدنيا",18,"ي",2,0],["واخس كما يخسا أبو خالد","عن صولة الليث أبي الشبل",19,"ل",1,0],["واخسوك يسأل ان تكلمه وهل","يجدي عليه سؤال من لا يسمع",20,"ع",1,0],["واخسر في فراقهم نفيسا","وأشك الله غوثا من مدابك",21,"ك",1,0],["واخسِ المعابَ وأُب بَمسكَنةٍ فمَن","وافى اليهِ بذِلَّةٍ لم يُخسِهِ",22,"س",2,0],["وأخسر كل الورى صفقة","فتى أخلص الود للخريد",23,"د",1,0],["وأخسرُ كلِّ الفاجرينَ بضاعةً","لَمَنْ هو أخواهُ بدنياهُ بائع",24,"ع",1,0],["وأخسركم حظا سعاةُ تجارةٍ","وهم يحسبون الخير فيمَ تبضّعوا",25,"ع",3,0],["وَأَخْسَرُ خَلْقِ اللهِ مَنْ نالَ ثَرْوَةً","وَيُسْراً وَلَمْ تُبْسَطْ لَهُ عِنْدَها يَدُ",26,"د",1,0]]}