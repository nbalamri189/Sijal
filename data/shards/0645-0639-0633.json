{"poems":[[74,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[74,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[53,"قلبي من الضيق مما ضم قرقرها","https://www.aldiwan.net/poem64024.html","البسيط"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[92,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[132,"يا هل شجتك برود الريق حواء","https://www.aldiwan.net/poem50682.html","البسيط"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[202,"خذها ولا تلفظ بغير بيوتها","https://www.aldiwan.net/poem51888.html","الكامل"],[214,"ماس من التيه في غلائل","https://www.aldiwan.net/poem13335.html","مخلع البسيط"],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[280,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[333,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[435,"تاالله يا ظبيات الروم إن لعبت","https://www.aldiwan.net/poem39853.html","البسيط"],[469,"هيج بلبالي بأهل بابل","https://www.aldiwan.net/poem3494.html","عموديه"],[567,"قف بالديار إذا الليل البهيم سجا","https://www.aldiwan.net/poem52900.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123689","المديد"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59113","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96704","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61108","المتدارك"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128303","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89526","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109388","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28517","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110624","السريع"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99094","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93790","الخفيف"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70361","الكامل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199150","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66556","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123523","السلسلة"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94519","البسيط"],[4962,"أنتِ الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=208748",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[3369,"يا إلهي أنت بر","https://www.poetsgate.com/ViewPoem.aspx?id=118165",""],[5756,"حد علمي","https://www.poetsgate.com/ViewPoem.aspx?id=5421",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""]],"verses":[["معسل بنعاسٍ في لواحظه","أما تراها إلى كلّ القلوب حلت",0,"ت",1,0],["معسولة الثغر إلاَّ أنَّ قامتها","منسوبة القدّ للعسَّالة الذبل",1,"ل",1,0],["معسولةُ الريق يحكي طيبَ نكهتها","بعد الكرى وغُؤُورِ النجم مَنْشَرُها",2,"ر",3,0],["مَعْسُولَةٍ ألفاظُها مِنْ كامِلٍ","أَبرِد حَشىً مِنْ رِيقِها بِمُبَرَّدِ",3,"د",1,0],["معسولةَ الأحلامِ ذاهبةً","بِخَيالِها لمدارجِ الصِّغَر",4,"ر",1,0],["معسولةُ الريق مصقولٌ عوارضها","كأنما ريقها شَهدٌ وصهباءُ",5,"ا",2,0],["مُعَسكَرُ دَلاّحٍ مَرَت وَدَقَاتِهِ","صَباً بَعدَ مَا هَبَّت لَهُنَّ جَنُوبُ",6,"ب",1,0],["معسولةً كالأري إلا أنها","لكيودها حُمَةُ الشُّجاعِ الأرقم",7,"م",1,0],["معسل الريق ليتني لو","كنت لذاك الرضاب عامل",8,"ل",1,0],["معَ سلامٍ عبهريٍّ ندٍّ","يفوق معناه عبير الوردِ",9,"د",1,0],["مَعسولَةُ الرّيق لم أنْكِر وقد وُصِفَتْ","أنْ قيلَ في قَدِّهَا الميَّالِ عَسَّالُ",10,"ل",1,0],["مع سبق الإصرار صاغكَ ربي","لعنةً في نواظر الأحياء",11,"ا",2,0],["معسولة الريق معطار تلهفها","تشفي بمرشفها الخمري كل أسى",12,"س",2,0],["معسولةٌ كأنما نشوتها","في حركاتِ تلكم العواسل",13,"ل",1,0],["معسولةُ الثَغْر في لألآئهِ فَلَجٌ","دمعي النَضِيدُ يُباهِي ذلكَ الفَلَجا",14,"ج",2,0],["مع سائر الأزواج والذرية","ما أوجبوا في مثله الوصية",15,"ه",1,0],["مع ستة كانوا أصيبوا فيه","بالقتل أيضا من بني أبيه",15,"ه",1,0],["مع سلام لا يزال على","ربعك المعمور متصلا",16,"ل",2,0],["مُعَسَّلُ الجفن معسول اللَّمَى فَتَكَتْ","عُيُونُهُ بِعُيُونِ الخُرَّدِ العِينِ",17,"ن",1,0],["مَعسولةُ الثغرِ يشفي ريقُ مبسمها","ما أثرت في الحشا ألحاظها النجلُ",18,"ل",1,0],["مَعسول لقاحهم عَسَل","وَشَهي رِضابهم ضرب",19,"ب",1,0],["معسكرها فيها مجني ثمارها","تنسم روح الأنس لله من قرب",20,"ب",1,0],["مع سابق لساكن به ابتدي","قافية بها الخليل يقتدي",21,"ي",1,0],["مُعَسَّلُ الريقِ في أَنيابِهِ شَنَبٌ","يُجنيكَ مِن خَدِّهِ وَرداً بِنَسرينِ",22,"ن",1,0],["معسول ثغرٍ أراني ميلُ قامته","إذا تثنى بروض الحسن عسالا",23,"ل",2,0],["مُعسِرٌ مالاً وَمُثرٍ كَرَماً","إِنَّما أَترَبَ لَمّا أَقتَرا",24,"ر",2,0],["معسول ريق ثغره ألعس","صبراً رأيت الصبر عن شهده",25,"د",2,0],["مع سادة نجب غر غطارفة","في ذروة المجد من ذهل بن شيبان",26,"ن",1,0],["مع سلام بنشر طي شذاه","يتوالى وما له من تناهي",27,"ا",3,0],["مَع سَطْوَة لله فِي يوْم الوَغَى","تعنُو لشدَّةِ بأسها أَسْدُ الشرى",28,"ر",2,0],["مع سلام عليه في كل وقت","مثلما كلّمَ الجمادَ وضَبّا",29,"ب",2,0],["مَعْسُولُ أَطْرافِ الْحَديثِ كَأَنَّما","يَسْقي الْمَسامِعَ مُسْكِراً أوْ سُكَّرَا",30,"ر",2,0],["مع سهرى والنوح مثل ورقا","قد فارقت الفا بذات الرند",31,"د",1,0],["مع سائر صحب وآله ومحب","ماماس لعجب بها مكحلة العين",32,"ن",1,0],["معسولةٌ ريقتُها مُزةٌ","وهي على اللذةِ مقصورَهْ",33,"ر",2,0],["معسولة الريق من عسّال قامتها","تغزو الرجالَ بلا لدنٍ وهبّارِ",34,"ر",1,0],["معسولة الخدين أنتِ جميلةٌ","والحسن فيك يبوحُه الإبهاجُ",35,"ج",1,0],["معسكر صاغنا جندًا لمعركة","ومعهد زادنا للحق تبيانا",36,"ن",2,0],["معسولة الريق ما يدري مقبلها","أبنت كرم أم ابن المزن في فيه",37,"ي",2,0],["مع سلام يتوالى","مازها عقد نظيم",38,"م",1,0],["مع سواد مجدّل ٍ مايثور إلا يثير","كنه اللي ينهم الريح ثم ٍ تنهمه",39,"م",2,0],["مع سجودك اكمل الدين انتصاره","بعد جودك صابت الحكام غيره",40,"ر",2,0]]}