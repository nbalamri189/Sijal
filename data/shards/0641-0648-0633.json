{"poems":[[31,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[47,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[92,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[119,"سارت تزمزم للحمى الركبان","https://www.aldiwan.net/poem40480.html","عموديه"],[147,"ما ضر طيفك والكرى لو زارا","https://www.aldiwan.net/poem11768.html","الكامل"],[242,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[267,"قف بالديار وأي الدهر لم تقف","https://www.aldiwan.net/poem68198.html","البسيط"],[275,"ركبت فهزني طربي","https://www.aldiwan.net/poem35269.html","مجزوء الوافر"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[369,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[422,"أما والهوى بالوجوه الملاح","https://www.aldiwan.net/poem53979.html","الرمل"],[469,"سرى موهناً والأنجم الزهر لا تسري","https://www.aldiwan.net/poem3632.html","عموديه"],[473,"أخ زاد معناه في صده","https://www.aldiwan.net/poem60234.html","المتقارب"],[558,"وبتنا على رغم الحسود وبيننا","https://www.aldiwan.net/poem68320.html","الطويل"],[563,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[1464,"","https://poetry.dctabudhabi.ae/diwan/poem/146699","الكامل"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/121498","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27943","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106887","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93830","الطويل"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88981","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135842","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97097","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45026","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94791","الطويل"],[5480,"لزيم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=21011",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5770,"كم في الموت من عجبِ","https://www.poetsgate.com/ViewPoem.aspx?id=178685",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5937,"خارِجَ النّسَق","https://www.poetsgate.com/ViewPoem.aspx?id=211805",""],[6093,"الزمكان","https://www.poetsgate.com/ViewPoem.aspx?id=198343",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""]],"verses":[["فَوُسِّدَ فيها كَفَّهُ أَو لَحَجَّلَت","ضِباعُ الصَحارى حَولَهُ غَيرَ ذي قَبرِ",0,"ر",1,0],["فَوَسَمتُ أَوجُهَهُم سِماتٍ ذَلَّلَت","أَعناقَهُم لِلخَلقِ بَعدَ قَلائِدِ",1,"د",1,0],["فوَسَمْتَني شَرَفَاً وكَيْدَ حَوَاسِدٍ","بِهِمَا أَعَزَّ الفَاضِلُ المَفْضُولا",2,"ل",2,0],["فوسع فيه المسلمون سياسة","ليكثر طبق الحاجة النسل منهم",3,"م",1,0],["فوسيلتي لك قدس ذاتك سيدي","وحبيبك المختار والقرآن",4,"ن",1,0],["فَوَسَمتُ أَوجُهُها بِمُستَولٍ عَلى","رُتَبِ العَلاءِ مَناقِباً وَنِجارا",5,"ر",2,0],["فَوَسِيلَتِي لِرِضَاكَ جَاهُ مُحَمَّدٍ","أَزْكَى الْوَرَى سَامِي الْعُلاَ مَرْصُوصُهُ",6,"ص",2,0],["فَوَسوَسُوا بِقُرانٍ في مَسَامِعِه","خوفاً من الجِنِّ والإنسانُ لم يَخَفِ",7,"ف",1,0],["فوَسطَ المَرجِ يُعجبُني","بزَهوٍ منهُ أو لعِب",8,"ب",1,0],["فوسطَ مرّاكشِ الكبرى لقائِدهم","دستٌ وقد شرَّدوا عنها السلاطينا",9,"ن",2,0],["فوسَمتُ أغفالَ المهامةِ واطئاً","وجَناتِها بمناسمِ الوجنْاء",10,"ا",2,0],["فوسَّدْتُه ساعدي والكرى","يخوض بعينيه حتَّى الصَّباح",11,"ح",1,0],["فوسنان من فتر الجفون بلا كرى","ونشوان من ليل الشباب بلا خمر",12,"ر",1,0],["فَوَسَّختُ بِالهَجو آذانَهُ","وَنَظَّفتُ قَلبِيَ مِن وُدِّهِ",13,"د",2,0],["فَوَسَّدتُهُ كَفي وَبِتُّ ضَجيعَهُ","وَقُلتُ لِلَيلي طُل فَقَد رَقَدَ البَدرُ",14,"ر",1,0],["فوسوس في المظاهر رام صداً","لها عن سر رب العالمينا",15,"ن",2,0],["فوسمت باسم أبي العلاء قصيدةً","وجعلتها هدياً مع الأشعار",16,"ر",1,0],["فوسدته كفي وبات معانقي","إلى أن بدا ضوء من الصبح سافرُ",17,"ر",1,0],["فوسع مكانَ الضيقِِ منك تخلقا","فمن وسعَ الرحمن سهل حزنه",18,"ن",2,0],["فوسوست حوّا إلى آدم","واقتسما تفاحةً في النعيم",19,"م",1,0],["فوسع عليه بالذي أنت أهله","وخلصه من أشراك ضيق المنافس",20,"س",1,0],["فوسف تعروك على اتلافها","نادمة الكسعيّ والفرزدق",21,"ق",1,0],["فوسيلتي للَه جاه حبيبه","وإلى الحبيب أتيت بالمحبوب",22,"ب",1,0],["فوسِّع الرزق وسخِّر لي جميعْ","خلقك واكفني المعاصي والمطيعْ",23,"ع",1,0],["فوسيذُ فَوراً وَآفُلّونٌ اِنحَدَرا","وَكُلُّ أَنهارِ إيذا فَوقَهُ اِنحَدَرَت",24,"ت",1,0],["فوسيلتي في كل سؤلٍ أنني","عبد الحسين وعصمتي في ديني",25,"ن",2,0],["فَوَسعتَها برّا وَقُمتَ بِحَملِها","وَأَخَذتَ رايَتَها وَأَلقَت باليَد",26,"د",1,0],["فوسع أيا مولايَ صدري وعزَّتي","وعَظِّم بهِ أجري وعفوك طالبُه",27,"ب",2,0],["فوسط القلب لك قصر ٍ مشيّد","بساس الحب وعمدان الشجاعه",28,"ع",2,0],["فوسائلي عند الحسانِ أمينُها","كلّ المُريب وشافعي مردودُ",29,"د",1,0],["فوسديهِ عيون الغيدِ هاميةً","وأطبقي حوله بالجفن والهُدُبِ",30,"ب",1,0],["فوسعتنا يا ذا الجلال برحمة","لما تزل تهمي بها الأرجاءُ",31,"ا",2,0],["فوسوس النأي أن مدّوا أناملكم","حتى انزلقنا عليهِ شرّ مُنزلَقِ",32,"ق",1,0],["فَوسَامَةُ اللقْيا تُنِيْرُ جَوانِحًا","ودَمَامَةُ التَّودِيْعِ عندِيَ بِيْدُ",33,"د",1,0],["فوسادتي خدُّ التشرُّدِ... والأسى","لُغَتي... ونومُ المقلتيْنِ غِرارُ",34,"ر",1,0]]}