{"poems":[[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[77,"ألا عم صباحا أيها الربع واسلم","https://www.aldiwan.net/poem36106.html","الطويل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[86,"لا والأسى وتلهب الأحشاء","https://www.aldiwan.net/poem10498.html","الكامل"],[71,"الله يعلم يا ابن شيث","https://www.aldiwan.net/poem3732.html","مجزوء الكامل"],[73,"أغائبة عني وحاضرة معي","https://www.aldiwan.net/poem11881.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[88,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[51,"ما زلت تشرك في ثرائك حاسدا","https://www.aldiwan.net/poem61882.html","الكامل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"دع صاعدا يقتني الدنيا وزبرجها","https://www.aldiwan.net/poem64955.html","البسيط"],[51,"بكعبة الله بل بخالقها","https://www.aldiwan.net/poem65716.html","المنسرح"],[51,"سليمان ميمون النقيبة حازم","https://www.aldiwan.net/poem66040.html","الطويل"],[51,"قولا لطوط أبي علي","https://www.aldiwan.net/poem66064.html","مخلع البسيط"],[78,"بكيت إلى سرب القطا إذ مررن بي","https://www.aldiwan.net/poem14230.html","الطويل"],[85,"نظمنا سنى التهنئات نزفها","https://www.aldiwan.net/poem7135.html","الطويل"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[28,"لما أجيلت سهام القوم فاقتسموا","https://www.aldiwan.net/poem5268.html","البسيط"],[61,"ألا عد لي بباطية وكاس","https://www.aldiwan.net/poem51599.html","الوافر"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[87,"صبوت إلى المدامة والغواني","https://www.aldiwan.net/poem8238.html","الوافر"],[74,"ألا عرس الإخوان في ساحة البلى","https://www.aldiwan.net/poem12868.html","الطويل"],[21,"مجدوا الله فهو للمجد أهل","https://www.aldiwan.net/poem36210.html","الخفيف"],[13,"ألا عجب الفتيان من أم مالك","https://www.aldiwan.net/poem2223.html","الطويل"],[52,"ألا عج إلى دار السرور وسلم","https://www.aldiwan.net/poem26677.html","الطويل"],[52,"ألا عللاني إنما العيش تعليل","https://www.aldiwan.net/poem26724.html","الطويل"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[75,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[48,"طربت إلى قطربل فأتيتها","https://www.aldiwan.net/poem65293.html","الطويل"],[48,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[50,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[46,"ألا عدي بكاء أو نحيبا","https://www.aldiwan.net/poem22095.html","الوافر"],[15,"تغيرت الديار بذي الدفين","https://www.aldiwan.net/poem45241.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42497","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[13,"أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180813",""]],"verses":[["أَلاَ عدِّ عَنِ ذِكْرِ الرَّحِيقِ الْمُفَدَّمِ","وَخُذْهَا شَمُولاً مِنْ بِشَارَةِ مَقْدَمِ",0,"م",1,1],["أَلاَ عِمْ صَبَاحَاً أَيُّهَا الرَّبْعُ وَاسْلَمِ","وَدُمْ فِي جِوَارِ اللهِ غَيْرَ مُذَمَّم",1,"م",1,1],["إِلّا عُلالَةَ أَو بُدا","هَةَ سابِحٍ نَهدِ الجُزارَه",2,"ر",2,0],["إِلّا عَلى طَرفٍ بَكاكَ وَشاعِرٍ","أَحيا عَلَيكَ مَراثِيَ الخَنساءِ",3,"ا",2,0],["إِلّا عَلى الداءِ الَّذي","خُصَّت بِهِ تِلكَ العِصابَه",4,"ه",1,0],["أَلا عَطفَةٌ تَحيا بِها نَفسُ عاشِقٍ","جَعَلتِ الرَدى مِنهُ بِمَرأىً وَمَسمَعِ",5,"ع",1,0],["أَلا عِم صَباحاً أَيُّها الطَلَلُ البالي","وَهَل يَعِمَن مَن كانَ في العُصُرِ الخالي",6,"ل",2,1],["ألا عَدّ عمّا في العراق فإنني","أراه بأخلاق الزمان مَعايبا",7,"ب",2,0],["إلا على ما لستَ تملك بذْله","من صدْق بأس أو براعة جودِ",8,"د",1,0],["إلا عدوّاً أخرستْهُ ضغينةٌ","لا زال منها الدهرَ في إخراس",9,"س",1,0],["ألا عُقُولَ ألا أحلامَ تَزْجُرهُم","بلى عُقولٌ وأحلامٌ بها مرض",10,"ض",1,0],["إلا على فيشة المغيث له","تعمداً منه أو كما اتفقا",11,"ق",2,0],["ألا عوِّذُوه من توالي فتوحهِ","عساه تَرُدُّ العينَ عنه التمائمُ",12,"م",1,0],["الأعور المُعور الملاقي","بمؤخر السوء كلَّ مقدمْ",13,"م",1,0],["أَلا عَصَمَ اللَهُ القَطا في فِراخِها","فَإِنَّ فِراخي خانَها الماءُ وَالظِلُّ",14,"ل",1,0],["ألا عند مصر والبيان وأهله","يد للمعالي صادفت حافظ اليد",15,"د",1,0],["إلا عوارض روحانية عرضت","بها لطائفُ لا يدركن بالنظرِ",16,"ر",1,0],["إِلّا عَلى رَأسِ جِذعٍ باتَ يَنقُرُهُ","جِرذانُ سَوءٍ وَفَرخٍ غَيرُ ذي ريشٍ",17,"ش",1,0],["ألا عُدْ لي بباطَيةٍ وكاسِ","وَزَعْ همِّي بإبريقٍ وطاسِ",18,"س",1,1],["إلّا على غزوٍ يُبيدُ بِهِ العِدى","للِّه من غزوٍ لَهُ وجهادِ",19,"د",1,0],["أُلاعِبُ فِيهِ أَطْرَافَ الْعَوَالِي","وَأُطْلِقُ بَيْنَ هَبْوَتِهِ حِصَانِي",20,"ي",1,0],["أَلا عَرَّسَ الإِخوانُ في ساحَةِ البِلى","وَما رَفَعوا غَيرَ القُبورِ قِبابا",21,"ب",2,1],["الأَعلى الَذي سَبَقَ الناسَ","وَسَوَّى فَوقَ السَماءِ سَريرا",22,"ر",2,0],["أَلا عَجِبَ الفِتيانُ مِن أُمِّ مالِكٍ","تَقولُ لَقَد أَصبَحتَ أَشعَثَ أَغبَرا",23,"ر",2,1],["أَلا عُج إِلى دارِ السُرورِ وَسَلِّمِ","وَقُل أَينَ لَذّاتي وَأَينَ تَكَلُّمي",24,"ي",1,1],["أَلا عَلِّلاني إِنَما العَيشُ تَعليلُ","وَما لِحَياةٍ بَعدَها ميتَةٌ طولُ",25,"ل",1,1],["أَلا عَلِّلاني قَبلَ أَن يَأتِيَ المَوتُ","وَيُبنى لِجُثماني بِدارِ البِلى بَيتُ",26,"ت",1,1],["أَلا عَلِّلاني كَم حَبيبٍ تَعَذَّرَت","مَوَدَّتُهُ عَن وَصلِهِ قَد تَسَلَّيتُ",26,"ت",1,0],["أَلا عَلِّلاني لَيسَ سَعيِي بِمُدرَكٍ","وَلا بِوُقوفي بِالَّذي خُطَّ لي فَوتُ",26,"ت",1,0],["ألا عبقرِيُّ الرأي يَفري فَرِيَّه","ألا نَدُسٌ طَبٌّ ألا حازمٌ جَلد",27,"د",1,0],["أَلا عِش بِزَينٍ أَينَ سِرتَ مُسَلَّماً","وَقَد رُحتُ مِنهُ حينَ رُحتُ بِشَينِ",28,"ن",1,0],["إلا على ظهر أمردٍ خنِثٍ","تميلُ أردافهُ من الثقَل",29,"ل",1,0],["أَلاعَلِمتَ وَأَنتَ غَيرُ مُفَنَّدٍ","أَنَّ القَليلَ إِلى القَليلِ كَثيرُ",30,"ر",1,0],["أُلاعِبُ غولاً هَداهُ الكَرى","إِلَينا تَشُطُّ وَتَستَورِدُ",31,"د",1,0],["أَلا عَدّي بُكاءً أَو نَحيباً","فَمِن سَفَهٍ بُكاؤُكِ وَالنَحيبُ",32,"ب",1,1],["أَلا عَتَبَت عَلَيَّ اليَومَ عِرسي","وَقَد هَبَّت بِلَيلٍ تَشتَكيني",33,"ن",2,0],["الأعزلُ المنفيُّ فارق قيدَه","ورمى بآسره وذلَّ إِسارِهِ",34,"ر",2,0],["أَلاَ عاطِنِيها بِنْتَ كَرْمٍ تَزَوَّجَتْ","عَلَى نَغَماتِ الْعُودِ بِابْنِ سَمَاءِ",35,"م",3,1],["أَلا عَمِيَت عَينُ الزَمانِ فَلا هُدى","وَشلَّت يَمينُ المَجدِ مِنكَ فَلا بَطشُ",36,"ش",1,0],["أَلاعيبُ نحن بكفِّ القضاءِ","هو الصولجانُ، ونحنُ الأُكر",37,"ر",1,0],["أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","تَقُولُ أَرَاكَ الْيَوْمَ أَشْعَثَ أَغْبَرَا",38,"ر",2,1]]}