{"poems":[[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[77,"ألا عم صباحا أيها الربع واسلم","https://www.aldiwan.net/poem36106.html","الطويل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[86,"لا والأسى وتلهب الأحشاء","https://www.aldiwan.net/poem10498.html","الكامل"],[71,"الله يعلم يا ابن شيث","https://www.aldiwan.net/poem3732.html","مجزوء الكامل"],[73,"أغائبة عني وحاضرة معي","https://www.aldiwan.net/poem11881.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[88,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[51,"ما زلت تشرك في ثرائك حاسدا","https://www.aldiwan.net/poem61882.html","الكامل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"دع صاعدا يقتني الدنيا وزبرجها","https://www.aldiwan.net/poem64955.html","البسيط"],[51,"بكعبة الله بل بخالقها","https://www.aldiwan.net/poem65716.html","المنسرح"],[51,"سليمان ميمون النقيبة حازم","https://www.aldiwan.net/poem66040.html","الطويل"],[51,"قولا لطوط أبي علي","https://www.aldiwan.net/poem66064.html","مخلع البسيط"],[78,"بكيت إلى سرب القطا إذ مررن بي","https://www.aldiwan.net/poem14230.html","الطويل"],[85,"نظمنا سنى التهنئات نزفها","https://www.aldiwan.net/poem7135.html","الطويل"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[28,"لما أجيلت سهام القوم فاقتسموا","https://www.aldiwan.net/poem5268.html","البسيط"],[61,"ألا عد لي بباطية وكاس","https://www.aldiwan.net/poem51599.html","الوافر"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[87,"صبوت إلى المدامة والغواني","https://www.aldiwan.net/poem8238.html","الوافر"],[74,"ألا عرس الإخوان في ساحة البلى","https://www.aldiwan.net/poem12868.html","الطويل"],[21,"مجدوا الله فهو للمجد أهل","https://www.aldiwan.net/poem36210.html","الخفيف"],[13,"ألا عجب الفتيان من أم مالك","https://www.aldiwan.net/poem2223.html","الطويل"],[52,"ألا عج إلى دار السرور وسلم","https://www.aldiwan.net/poem26677.html","الطويل"],[52,"ألا عللاني إنما العيش تعليل","https://www.aldiwan.net/poem26724.html","الطويل"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[75,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[48,"طربت إلى قطربل فأتيتها","https://www.aldiwan.net/poem65293.html","الطويل"],[48,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[50,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[46,"ألا عدي بكاء أو نحيبا","https://www.aldiwan.net/poem22095.html","الوافر"],[15,"تغيرت الديار بذي الدفين","https://www.aldiwan.net/poem45241.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42497","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[13,"أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180813",""],[116,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[116,"دع الفكر واصبر فالزمان صعائبه","https://www.aldiwan.net/poem41944.html","الطويل"],[121,"ألا عد إلى العهد الذي كنت أحمد","https://www.aldiwan.net/poem49293.html","الطويل"],[122,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[133,"ألا عج من حيازيم المطي","https://www.aldiwan.net/poem54681.html","الوافر"],[151,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[170,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[187,"قد زادني أدب يمشي على قدم","https://www.aldiwan.net/poem43620.html","البسيط"],[196,"أتعرف الدار أم لا تعرف الطللا","https://www.aldiwan.net/poem54422.html","البسيط"],[198,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[199,"ألا عظة إن الزمان خؤون","https://www.aldiwan.net/poem51871.html","الطويل"],[200,"ألا عاطني الخمر إن الزمان","https://www.aldiwan.net/poem45361.html","المتقارب"],[212,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[224,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[226,"أجل أنا من أرضاك خلا موافيا","https://www.aldiwan.net/poem55092.html","الطويل"],[238,"أهاجك بينهم إذ نأوا","https://www.aldiwan.net/poem19741.html","المتقارب"],[238,"ألا عذ بالضريح التاودي","https://www.aldiwan.net/poem19749.html","الوافر"],[271,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[272,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[276,"عجبت لمن يستوثر الفرش مترفا","https://www.aldiwan.net/poem25388.html","الطويل"],[305,"يا نسيم الأسحار","https://www.aldiwan.net/poem16906.html","عموديه"],[323,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[365,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[366,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[372,"نظرن بأسياف عليها جفونها","https://www.aldiwan.net/poem57093.html","الطويل"],[392,"من شل بقعا على جنبيه ماطاقها","https://www.aldiwan.net/poem54430.html","عموديه"],[403,"فراقكم هاج اشتياقي وأشجاني","https://www.aldiwan.net/poem46756.html","الطويل"],[410,"ألا عجب صاغ الربيع من الزهر","https://www.aldiwan.net/poem31692.html","عموديه"],[440,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[442,"حقيق إن بكيت دماً حقيق","https://www.aldiwan.net/poem14382.html","الوافر"],[454,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[459,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[466,"لزوم ما لا يلزم من الوجع","https://www.aldiwan.net/poem61434.html","عموديه"],[467,"ألا طرقت ليلى فأحزن ذكرها","https://www.aldiwan.net/poem50373.html","الطويل"],[469,"ألا عاطني المدامه","https://www.aldiwan.net/poem59671.html","المضارع"],[491,"ألا علِّلاني واعلما أنني غرر","https://www.aldiwan.net/poem654.html",""],[496,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[506,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[549,"ألا عتبت علي فصارمتني","https://www.aldiwan.net/poem1184.html",""],[552,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[552,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[554,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[559,"هو الوارد القدسي كالسيل يحطم","https://www.aldiwan.net/poem33881.html","الطويل"],[559,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"]],"verses":[["أَلاَ عدِّ عَنِ ذِكْرِ الرَّحِيقِ الْمُفَدَّمِ","وَخُذْهَا شَمُولاً مِنْ بِشَارَةِ مَقْدَمِ",0,"م",1,1],["أَلاَ عِمْ صَبَاحَاً أَيُّهَا الرَّبْعُ وَاسْلَمِ","وَدُمْ فِي جِوَارِ اللهِ غَيْرَ مُذَمَّم",1,"م",1,1],["إِلّا عُلالَةَ أَو بُدا","هَةَ سابِحٍ نَهدِ الجُزارَه",2,"ر",2,0],["إِلّا عَلى طَرفٍ بَكاكَ وَشاعِرٍ","أَحيا عَلَيكَ مَراثِيَ الخَنساءِ",3,"ا",2,0],["إِلّا عَلى الداءِ الَّذي","خُصَّت بِهِ تِلكَ العِصابَه",4,"ه",1,0],["أَلا عَطفَةٌ تَحيا بِها نَفسُ عاشِقٍ","جَعَلتِ الرَدى مِنهُ بِمَرأىً وَمَسمَعِ",5,"ع",1,0],["أَلا عِم صَباحاً أَيُّها الطَلَلُ البالي","وَهَل يَعِمَن مَن كانَ في العُصُرِ الخالي",6,"ل",2,1],["ألا عَدّ عمّا في العراق فإنني","أراه بأخلاق الزمان مَعايبا",7,"ب",2,0],["إلا على ما لستَ تملك بذْله","من صدْق بأس أو براعة جودِ",8,"د",1,0],["إلا عدوّاً أخرستْهُ ضغينةٌ","لا زال منها الدهرَ في إخراس",9,"س",1,0],["ألا عُقُولَ ألا أحلامَ تَزْجُرهُم","بلى عُقولٌ وأحلامٌ بها مرض",10,"ض",1,0],["إلا على فيشة المغيث له","تعمداً منه أو كما اتفقا",11,"ق",2,0],["ألا عوِّذُوه من توالي فتوحهِ","عساه تَرُدُّ العينَ عنه التمائمُ",12,"م",1,0],["الأعور المُعور الملاقي","بمؤخر السوء كلَّ مقدمْ",13,"م",1,0],["أَلا عَصَمَ اللَهُ القَطا في فِراخِها","فَإِنَّ فِراخي خانَها الماءُ وَالظِلُّ",14,"ل",1,0],["ألا عند مصر والبيان وأهله","يد للمعالي صادفت حافظ اليد",15,"د",1,0],["إلا عوارض روحانية عرضت","بها لطائفُ لا يدركن بالنظرِ",16,"ر",1,0],["إِلّا عَلى رَأسِ جِذعٍ باتَ يَنقُرُهُ","جِرذانُ سَوءٍ وَفَرخٍ غَيرُ ذي ريشٍ",17,"ش",1,0],["ألا عُدْ لي بباطَيةٍ وكاسِ","وَزَعْ همِّي بإبريقٍ وطاسِ",18,"س",1,1],["إلّا على غزوٍ يُبيدُ بِهِ العِدى","للِّه من غزوٍ لَهُ وجهادِ",19,"د",1,0],["أُلاعِبُ فِيهِ أَطْرَافَ الْعَوَالِي","وَأُطْلِقُ بَيْنَ هَبْوَتِهِ حِصَانِي",20,"ن",2,0],["أَلا عَرَّسَ الإِخوانُ في ساحَةِ البِلى","وَما رَفَعوا غَيرَ القُبورِ قِبابا",21,"ب",2,1],["الأَعلى الَذي سَبَقَ الناسَ","وَسَوَّى فَوقَ السَماءِ سَريرا",22,"ر",2,0],["أَلا عَجِبَ الفِتيانُ مِن أُمِّ مالِكٍ","تَقولُ لَقَد أَصبَحتَ أَشعَثَ أَغبَرا",23,"ر",2,1],["أَلا عُج إِلى دارِ السُرورِ وَسَلِّمِ","وَقُل أَينَ لَذّاتي وَأَينَ تَكَلُّمي",24,"م",2,1],["أَلا عَلِّلاني إِنَما العَيشُ تَعليلُ","وَما لِحَياةٍ بَعدَها ميتَةٌ طولُ",25,"ل",1,1],["أَلا عَلِّلاني قَبلَ أَن يَأتِيَ المَوتُ","وَيُبنى لِجُثماني بِدارِ البِلى بَيتُ",26,"ت",1,1],["أَلا عَلِّلاني كَم حَبيبٍ تَعَذَّرَت","مَوَدَّتُهُ عَن وَصلِهِ قَد تَسَلَّيتُ",26,"ت",1,0],["أَلا عَلِّلاني لَيسَ سَعيِي بِمُدرَكٍ","وَلا بِوُقوفي بِالَّذي خُطَّ لي فَوتُ",26,"ت",1,0],["ألا عبقرِيُّ الرأي يَفري فَرِيَّه","ألا نَدُسٌ طَبٌّ ألا حازمٌ جَلد",27,"د",1,0],["أَلا عِش بِزَينٍ أَينَ سِرتَ مُسَلَّماً","وَقَد رُحتُ مِنهُ حينَ رُحتُ بِشَينِ",28,"ن",1,0],["إلا على ظهر أمردٍ خنِثٍ","تميلُ أردافهُ من الثقَل",29,"ل",1,0],["أَلاعَلِمتَ وَأَنتَ غَيرُ مُفَنَّدٍ","أَنَّ القَليلَ إِلى القَليلِ كَثيرُ",30,"ر",1,0],["أُلاعِبُ غولاً هَداهُ الكَرى","إِلَينا تَشُطُّ وَتَستَورِدُ",31,"د",1,0],["أَلا عَدّي بُكاءً أَو نَحيباً","فَمِن سَفَهٍ بُكاؤُكِ وَالنَحيبُ",32,"ب",1,1],["أَلا عَتَبَت عَلَيَّ اليَومَ عِرسي","وَقَد هَبَّت بِلَيلٍ تَشتَكيني",33,"ن",2,0],["الأعزلُ المنفيُّ فارق قيدَه","ورمى بآسره وذلَّ إِسارِهِ",34,"ر",2,0],["أَلاَ عاطِنِيها بِنْتَ كَرْمٍ تَزَوَّجَتْ","عَلَى نَغَماتِ الْعُودِ بِابْنِ سَمَاءِ",35,"م",3,1],["أَلا عَمِيَت عَينُ الزَمانِ فَلا هُدى","وَشلَّت يَمينُ المَجدِ مِنكَ فَلا بَطشُ",36,"ش",1,0],["أَلاعيبُ نحن بكفِّ القضاءِ","هو الصولجانُ، ونحنُ الأُكر",37,"ر",1,0],["أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","تَقُولُ أَرَاكَ الْيَوْمَ أَشْعَثَ أَغْبَرَا",38,"ر",2,1],["الا عذر لا كان الهوى في الهوى العذر","متى ليل عسر الهجر يكشف باليسر",39,"ر",1,1],["ألاعب دهراً لا انقضاء لحاله","بلا طائل زين فكم ذا ألاعبه",40,"ب",2,0],["ألا عد إلى العهد الذي كنت أحمد","ولا تتركني في العذاب أخلد",41,"د",1,1],["ألا عِم صباحاً أيها الربع منعما","وحدِّث حديثاً عن مُيَيمَ مُنَعِّما",42,"م",2,1],["أَلاَ عُج مِن حَيَازِيمِ المَطِيِّ","عَلَى قَبرِ الإِمَامِ الحَضرَمِيِّ",43,"ي",1,1],["الأَعلى عَلى الوَرى قَدراً وَأَوضَحِهُم هُدىً","وَأَصدَقُهمِ قَولاً وَأَكرَمُهم فِعلا",44,"ل",2,0],["أَلا عَمِيَت عَينُ اِمرِئٍ لَم تَجُد لَهُ","بِدَمعٍ وَأَضحى رَبُّها رَبَّ عميانِ",45,"ن",1,0],["إلا عيالا أباد الله شأفتهم","ما منهم أحد للماء يغترف",46,"ف",1,0],["الأَعصَمَ الصَدَعَ الوَحشِيِّ في شَعَفٍ","دونَ السَماءِ نِيافٍ يَفرُعُ الجَبَلا",47,"ل",2,0],["إلّا على ذي المال والما","ءِ المقطّرِ واللحوم",48,"م",1,0],["ألا عظةٌ إنَّ الزمانَ خؤونُ","وإنَّ ملمَّاتِ الزمانِ فنونُ",49,"ن",1,1],["ألا عاطني الخمرَ إنَّ الزمانَ","على مِيمِها وعلى رائِها",50,"ا",3,1],["الأعين الزرق في باريس ترهبني","كالأعين السود في آطام بغدان",51,"ن",1,0],["أَلا عُد بي إِلى حَيثُ السَرايا","تُقيمُ لِعُرسِكَ اليَومَ الأَغَرّا",52,"ر",2,0],["أَلا عَلِّلاني بِالتَعازي وَأَقنِعا","فُؤاديَ أَن يَرضى بهِنَّ تَعازِيا",53,"ي",2,0],["أَلاَ عَطْفَةٌ لِأَسِيِرهِمُ","أَلاَ رَحْمَةٌ لِلَّذِي قَدْ سَبَوْا",54,"و",2,0],["أَلاَ عُذْ بِالضَّرِيحِ التَّاوُدِيِّ","وَمَا قَدْ ضَمَّ مِنْ ذَاكَ الْوَلِيِّ",55,"ي",1,1],["ألا عَلمت أمي هنالِكَ أنّني","أعيشُ بلا أُمٍ وهذا هو الفَقر",56,"ر",1,0],["الاعز المتقى من هاشم","طيب العنصر حاشا أَن يضاما",57,"م",2,0],["ألا عدّ عن صغرى تجرّ كبيرةً","فغايةُ صبّ الغيث من مبدإ الرش",58,"ش",1,0],["إلا على باطل وترك قربه","ما أولئك أخيار",59,"ر",1,0],["إِلّا عسولٌ أَو حاجِلٌ نَغِقٌ","وَذو ضُياحٍ في صَوتِهِ بَحَحُ",60,"ح",1,0],["إلاّ عِنانَ مُطَهَّمٍ ذي مَيْعةٍ","ألقاهُ منه بينَ تلك الأنْمُل",61,"ل",1,0],["ألا عَتَبَت عليَّ اليومَ أَروَى","لآتيها كما زعمت بفَهدِ",62,"د",1,0],["ألا عَدِّها عَنِّي حَياءً فإنَّني","أراها تَراني والحَبابُ عُيونُها",63,"ن",3,0],["إلا على الله خالقها ورزاقها","تسرح جويعه وتضوى به إلى أحداقها",64,"ق",3,0],["ألا عطفةً بالوصْلِ منكم لِمُغْرمٍ","أسير الجوى صَادي الجوانح حرّانِ",65,"ن",1,0],["ألا عجب صاغ الربيع من الزهر","مداهن تبر لم يصغن من التبر",66,"ر",1,1],["ألا عَزَّ من أبَدى إليكَ خُضُوعَهُ","وحازَ غِناهُ من إليكَ افتقارُهُ",67,"ر",2,0],["ألا عفواً وتوفيقاً إلهي","فحبل رجاي فيك بك الوثيق",68,"ق",1,0],["إلا على ند يبادلها الهوى","فلغاتها موصولة بلغاتي",69,"ت",2,0],["ألا عَطفاً على عيشٍ فسادٍ","يكون له بقربكُمُ صلاحُ",70,"ح",1,0],["إلا \" عراق \" تُناد يني .. وَها أنَذا","أصحو بأنأى بقاع ِالأرض ِمن حُلُمي",71,"م",2,0],["أَلا عَلَّ لَيلى إِن تَشَكَّيتُ عِندَها","تَباريحَ لَوعاتِ الهَوى أَن تَلَيَّنا",72,"ن",2,0],["أَلا عاطِني المَدامَه","بِقاقُرَّةٍ وَجامَه",73,"ه",1,1],["أَلا عَلِّلاني وَاِعلَما أَنَّني غَرَر","وَما خِلتُ يُجديني الشَفاقُ وَلا الحَذَر",74,"ر",1,1],["ألا عَتَبَتْ جُمْل وبيني وبينها","من البيد عذرٌ لو به علمت جمل",75,"ل",1,0],["ألا عدَلْتِ عن الملامِ؟","والرّوحُ عنْ ريبتيْ تُجيبُ",76,"ب",1,0],["أَلا عَتَبَت عَلَيَّ فَصارَمَتني","وَأَعجَبَها ذَوو اللِّمَمِ الطِوالِ",77,"ل",1,1],["ألا عوجا لمجتَمَعِ السِّيالِ","فثَمَّ شفاءُ ما بي من خبَالِ",78,"ل",1,1],["أَلا علّلاني بالحياةِ وخادِعا","يقينِي فكلٌّ بالحياةِ معلَّلُ",79,"ل",1,0],["أَلا عَظَّمَت ما باحَ مِنّي مِنَ الهَوى","وَما في ضَميرِ القَلبِ أَدهى وَأَعظَمُ",80,"م",1,0],["ألا عم صباحا قول من قال قبلنا","له ومساء نحن قلنا نتمم",81,"م",1,0],["ألا علَّ من شاقني علَّهُ","يداوي فؤادي بما علَّهُ",82,"ه",1,0]]}