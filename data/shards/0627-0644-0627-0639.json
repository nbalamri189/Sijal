","https://www.poetsgate.com/ViewPoem.aspx?id=215575",""],[5615,"على مضض ...!","https://www.poetsgate.com/ViewPoem.aspx?id=189551",""],[243,"أعاصير","https://www.poetsgate.com/ViewPoem.aspx?id=50473",""],[5691,"أفْوافٌ...!","https://www.poetsgate.com/ViewPoem.aspx?id=207696",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5701,"مقادير تمحو ما تشاء وتكتب","https://www.poetsgate.com/ViewPoem.aspx?id=164592",""],[5704,"خمريات","https://www.poetsgate.com/ViewPoem.aspx?id=196500",""],[5725,"من منكما احلى","https://www.poetsgate.com/ViewPoem.aspx?id=194934",""],[5804,"لستُ مغرورًا ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=214757",""],[5829,"البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=210657",""],[5899,"داليا","https://www.poetsgate.com/ViewPoem.aspx?id=31373",""],[5956,"يا صاحب المجد والنخوات والمُثُلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194145",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[199,"أَتَعْرِفُ الدارَ أَمْ لا تعرفُ الطَّلَلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=20770",""],[243,"يا ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68157&r=&rc=149",""],[186,"وداع وما يغني الوداع من الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55748&r=&rc=11",""],[6262,"السقوط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80111&r=&rc=9",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""],[6318,"لغتي الجميلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66157&r=&rc=7",""]],"verses":[["أَلاَ عدِّ عَنِ ذِكْرِ الرَّحِيقِ الْمُفَدَّمِ","وَخُذْهَا شَمُولاً مِنْ بِشَارَةِ مَقْدَمِ",0,"م",1,1],["أَلاَ عِمْ صَبَاحَاً أَيُّهَا الرَّبْعُ وَاسْلَمِ","وَدُمْ فِي جِوَارِ اللهِ غَيْرَ مُذَمَّم",1,"م",1,1],["إِلّا عُلالَةَ أَو بُدا","هَةَ سابِحٍ نَهدِ الجُزارَه",2,"ر",2,0],["إِلّا عَلى طَرفٍ بَكاكَ وَشاعِرٍ","أَحيا عَلَيكَ مَراثِيَ الخَنساءِ",3,"ا",2,0],["إِلّا عَلى الداءِ الَّذي","خُصَّت بِهِ تِلكَ العِصابَه",4,"ه",1,0],["أَلا عَطفَةٌ تَحيا بِها نَفسُ عاشِقٍ","جَعَلتِ الرَدى مِنهُ بِمَرأىً وَمَسمَعِ",5,"ع",1,0],["أَلا عِم صَباحاً أَيُّها الطَلَلُ البالي","وَهَل يَعِمَن مَن كانَ في العُصُرِ الخالي",6,"ل",2,1],["ألا عَدّ عمّا في العراق فإنني","أراه بأخلاق الزمان مَعايبا",7,"ب",2,0],["إلا على ما لستَ تملك بذْله","من صدْق بأس أو براعة جودِ",8,"د",1,0],["إلا عدوّاً أخرستْهُ ضغينةٌ","لا زال منها الدهرَ في إخراس",9,"س",1,0],["ألا عُقُولَ ألا أحلامَ تَزْجُرهُم","بلى عُقولٌ وأحلامٌ بها مرض",10,"ض",1,0],["إلا على فيشة المغيث له","تعمداً منه أو كما اتفقا",11,"ق",2,0],["ألا عوِّذُوه من توالي فتوحهِ","عساه تَرُدُّ العينَ عنه التمائمُ",12,"م",1,0],["الأعور المُعور الملاقي","بمؤخر السوء كلَّ مقدمْ",13,"م",1,0],["أَلا عَصَمَ اللَهُ القَطا في فِراخِها","فَإِنَّ فِراخي خانَها الماءُ وَالظِلُّ",14,"ل",1,0],["ألا عند مصر والبيان وأهله","يد للمعالي صادفت حافظ اليد",15,"د",1,0],["إلا عوارض روحانية عرضت","بها لطائفُ لا يدركن بالنظرِ",16,"ر",1,0],["إِلّا عَلى رَأسِ جِذعٍ باتَ يَنقُرُهُ","جِرذانُ سَوءٍ وَفَرخٍ غَيرُ ذي ريشٍ",17,"ش",1,0],["ألا عُدْ لي بباطَيةٍ وكاسِ","وَزَعْ همِّي بإبريقٍ وطاسِ",18,"س",1,1],["إلّا على غزوٍ يُبيدُ بِهِ العِدى","للِّه من غزوٍ لَهُ وجهادِ",19,"د",1,0],["أُلاعِبُ فِيهِ أَطْرَافَ الْعَوَالِي","وَأُطْلِقُ بَيْنَ هَبْوَتِهِ حِصَانِي",20,"ن",2,0],["أَلا عَرَّسَ الإِخوانُ في ساحَةِ البِلى","وَما رَفَعوا غَيرَ القُبورِ قِبابا",21,"ب",2,1],["الأَعلى الَذي سَبَقَ الناسَ","وَسَوَّى فَوقَ السَماءِ سَريرا",22,"ر",2,0],["أَلا عَجِبَ الفِتيانُ مِن أُمِّ مالِكٍ","تَقولُ لَقَد أَصبَحتَ أَشعَثَ أَغبَرا",23,"ر",2,1],["أَلا عُج إِلى دارِ السُرورِ وَسَلِّمِ","وَقُل أَينَ لَذّاتي وَأَينَ تَكَلُّمي",24,"م",2,1],["أَلا عَلِّلاني إِنَما العَيشُ تَعليلُ","وَما لِحَياةٍ بَعدَها ميتَةٌ طولُ",25,"ل",1,1],["أَلا عَلِّلاني قَبلَ أَن يَأتِيَ المَوتُ","وَيُبنى لِجُثماني بِدارِ البِلى بَيتُ",26,"ت",1,1],["أَلا عَلِّلاني كَم حَبيبٍ تَعَذَّرَت","مَوَدَّتُهُ عَن وَصلِهِ قَد تَسَلَّيتُ",26,"ت",1,0],["أَلا عَلِّلاني لَيسَ سَعيِي بِمُدرَكٍ","وَلا بِوُقوفي بِالَّذي خُطَّ لي فَوتُ",26,"ت",1,0],["ألا عبقرِيُّ الرأي يَفري فَرِيَّه","ألا نَدُسٌ طَبٌّ ألا حازمٌ جَلد",27,"د",1,0],["أَلا عِش بِزَينٍ أَينَ سِرتَ مُسَلَّماً","وَقَد رُحتُ مِنهُ حينَ رُحتُ بِشَينِ",28,"ن",1,0],["إلا على ظهر أمردٍ خنِثٍ","تميلُ أردافهُ من الثقَل",29,"ل",1,0],["أَلاعَلِمتَ وَأَنتَ غَيرُ مُفَنَّدٍ","أَنَّ القَليلَ إِلى القَليلِ كَثيرُ",30,"ر",1,0],["أُلاعِبُ غولاً هَداهُ الكَرى","إِلَينا تَشُطُّ وَتَستَورِدُ",31,"د",1,0],["أَلا عَدّي بُكاءً أَو نَحيباً","فَمِن سَفَهٍ بُكاؤُكِ وَالنَحيبُ",32,"ب",1,1],["أَلا عَتَبَت عَلَيَّ اليَومَ عِرسي","وَقَد هَبَّت بِلَيلٍ تَشتَكيني",33,"ن",2,0],["إِلاَّ عِلاَفِيّا وَسَيْفاً مُلْطَفاً","وضِبِرَّةً وَجْنَاءَ ذَاتَ هِبَابِ",34,"ب",1,0],["الأعزلُ المنفيُّ فارق قيدَه","ورمى بآسره وذلَّ إِسارِهِ",35,"ر",2,0],["أَلاَ عاطِنِيها بِنْتَ كَرْمٍ تَزَوَّجَتْ","عَلَى نَغَماتِ الْعُودِ بِابْنِ سَمَاءِ",36,"م",3,1],["أَلا عَمِيَت عَينُ الزَمانِ فَلا هُدى","وَشلَّت يَمينُ المَجدِ مِنكَ فَلا بَطشُ",37,"ش",1,0],["أَلاعيبُ نحن بكفِّ القضاءِ","هو الصولجانُ، ونحنُ الأُكر",38,"ر",1,0],["أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","تَقُولُ أَرَاكَ الْيَوْمَ أَشْعَثَ أَغْبَرَا",39,"ر",2,1],["الا عذر لا كان الهوى في الهوى العذر","متى ليل عسر الهجر يكشف باليسر",40,"ر",1,1],["ألاعب دهراً لا انقضاء لحاله","بلا طائل زين فكم ذا ألاعبه",41,"ب",2,0],["ألا عد إلى العهد الذي كنت أحمد","ولا تتركني في العذاب أخلد",42,"د",1,1],["ألا عِم صباحاً أيها الربع منعما","وحدِّث حديثاً عن مُيَيمَ مُنَعِّما",43,"م",2,1],["أَلاَ عُج مِن حَيَازِيمِ المَطِيِّ","عَلَى قَبرِ الإِمَامِ الحَضرَمِيِّ",44,"ي",1,1],["الأَعلى عَلى الوَرى قَدراً وَأَوضَحِهُم هُدىً","وَأَصدَقُهمِ قَولاً وَأَكرَمُهم فِعلا",45,"ل",2,0],["أَلا عَمِيَت عَينُ اِمرِئٍ لَم تَجُد لَهُ","بِدَمعٍ وَأَضحى رَبُّها رَبَّ عميانِ",46,"ن",1,0],["إلا عيالا أباد الله شأفتهم","ما منهم أحد للماء يغترف",47,"ف",1,0],["الأَعصَمَ الصَدَعَ الوَحشِيِّ في شَعَفٍ","دونَ السَماءِ نِيافٍ يَفرُعُ الجَبَلا",48,"ل",2,0],["إلّا على ذي المال والما","ءِ المقطّرِ واللحوم",49,"م",1,0],["ألا عظةٌ إنَّ الزمانَ خؤونُ","وإنَّ م