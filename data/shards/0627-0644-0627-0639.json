{"poems":[[79,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[79,"ألا عم صباحا أيها الربع واسلم","https://www.aldiwan.net/poem36106.html","الطويل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[88,"لا والأسى وتلهب الأحشاء","https://www.aldiwan.net/poem10498.html","الكامل"],[73,"الله يعلم يا ابن شيث","https://www.aldiwan.net/poem3732.html","مجزوء الكامل"],[75,"أغائبة عني وحاضرة معي","https://www.aldiwan.net/poem11881.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[90,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[53,"ما زلت تشرك في ثرائك حاسدا","https://www.aldiwan.net/poem61882.html","الكامل"],[53,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[53,"دع صاعدا يقتني الدنيا وزبرجها","https://www.aldiwan.net/poem64955.html","البسيط"],[53,"بكعبة الله بل بخالقها","https://www.aldiwan.net/poem65716.html","المنسرح"],[53,"سليمان ميمون النقيبة حازم","https://www.aldiwan.net/poem66040.html","الطويل"],[53,"قولا لطوط أبي علي","https://www.aldiwan.net/poem66064.html","مخلع البسيط"],[80,"بكيت إلى سرب القطا إذ مررن بي","https://www.aldiwan.net/poem14230.html","الطويل"],[87,"نظمنا سنى التهنئات نزفها","https://www.aldiwan.net/poem7135.html","الطويل"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[30,"لما أجيلت سهام القوم فاقتسموا","https://www.aldiwan.net/poem5268.html","البسيط"],[63,"ألا عد لي بباطية وكاس","https://www.aldiwan.net/poem51599.html","الوافر"],[82,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[89,"صبوت إلى المدامة والغواني","https://www.aldiwan.net/poem8238.html","الوافر"],[76,"ألا عرس الإخوان في ساحة البلى","https://www.aldiwan.net/poem12868.html","الطويل"],[21,"مجدوا الله فهو للمجد أهل","https://www.aldiwan.net/poem36210.html","الخفيف"],[13,"ألا عجب الفتيان من أم مالك","https://www.aldiwan.net/poem2223.html","الطويل"],[54,"ألا عج إلى دار السرور وسلم","https://www.aldiwan.net/poem26677.html","الطويل"],[54,"ألا عللاني إنما العيش تعليل","https://www.aldiwan.net/poem26724.html","الطويل"],[54,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[77,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[50,"طربت إلى قطربل فأتيتها","https://www.aldiwan.net/poem65293.html","الطويل"],[50,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[52,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[52,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[48,"ألا عدي بكاء أو نحيبا","https://www.aldiwan.net/poem22095.html","الوافر"],[15,"تغيرت الديار بذي الدفين","https://www.aldiwan.net/poem45241.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62203","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42497","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[108,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[13,"أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180813",""],[118,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[118,"دع الفكر واصبر فالزمان صعائبه","https://www.aldiwan.net/poem41944.html","الطويل"],[123,"ألا عد إلى العهد الذي كنت أحمد","https://www.aldiwan.net/poem49293.html","الطويل"],[124,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[135,"ألا عج من حيازيم المطي","https://www.aldiwan.net/poem54681.html","الوافر"],[153,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[172,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[189,"قد زادني أدب يمشي على قدم","https://www.aldiwan.net/poem43620.html","البسيط"],[198,"أتعرف الدار أم لا تعرف الطللا","https://www.aldiwan.net/poem54422.html","البسيط"],[200,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[201,"ألا عظة إن الزمان خؤون","https://www.aldiwan.net/poem51871.html","الطويل"],[202,"ألا عاطني الخمر إن الزمان","https://www.aldiwan.net/poem45361.html","المتقارب"],[214,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[226,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[228,"أجل أنا من أرضاك خلا موافيا","https://www.aldiwan.net/poem55092.html","الطويل"],[240,"أهاجك بينهم إذ نأوا","https://www.aldiwan.net/poem19741.html","المتقارب"],[240,"ألا عذ بالضريح التاودي","https://www.aldiwan.net/poem19749.html","الوافر"],[273,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[274,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[278,"عجبت لمن يستوثر الفرش مترفا","https://www.aldiwan.net/poem25388.html","الطويل"],[307,"يا نسيم الأسحار","https://www.aldiwan.net/poem16906.html","عموديه"],[325,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[367,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[368,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[374,"نظرن بأسياف عليها جفونها","https://www.aldiwan.net/poem57093.html","الطويل"],[394,"من شل بقعا على جنبيه ماطاقها","https://www.aldiwan.net/poem54430.html","عموديه"],[405,"فراقكم هاج اشتياقي وأشجاني","https://www.aldiwan.net/poem46756.html","الطويل"],[412,"ألا عجب صاغ الربيع من الزهر","https://www.aldiwan.net/poem31692.html","عموديه"],[442,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[444,"حقيق إن بكيت دماً حقيق","https://www.aldiwan.net/poem14382.html","الوافر"],[455,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[460,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[467,"لزوم ما لا يلزم من الوجع","https://www.aldiwan.net/poem61434.html","عموديه"],[468,"ألا طرقت ليلى فأحزن ذكرها","https://www.aldiwan.net/poem50373.html","الطويل"],[470,"ألا عاطني المدامه","https://www.aldiwan.net/poem59671.html","المضارع"],[492,"ألا علِّلاني واعلما أنني غرر","https://www.aldiwan.net/poem654.html",""],[497,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[507,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[550,"ألا عتبت علي فصارمتني","https://www.aldiwan.net/poem1184.html",""],[553,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[553,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[555,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[560,"هو الوارد القدسي كالسيل يحطم","https://www.aldiwan.net/poem33881.html","الطويل"],[560,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"],[869,"","https://poetry.dctabudhabi.ae/diwan/poem/31478","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/27081","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21389","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21391","الطويل"],[1093,"","https://poetry.dctabudhabi.ae/diwan/poem/75807","الطويل"]],"verses":[["أَلاَ عدِّ عَنِ ذِكْرِ الرَّحِيقِ الْمُفَدَّمِ","وَخُذْهَا شَمُولاً مِنْ بِشَارَةِ مَقْدَمِ",0,"م",1,1],["أَلاَ عِمْ صَبَاحَاً أَيُّهَا الرَّبْعُ وَاسْلَمِ","وَدُمْ فِي جِوَارِ اللهِ غَيْرَ مُذَمَّم",1,"م",1,1],["إِلّا عُلالَةَ أَو بُدا","هَةَ سابِحٍ نَهدِ الجُزارَه",2,"ر",2,0],["إِلّا عَلى طَرفٍ بَكاكَ وَشاعِرٍ","أَحيا عَلَيكَ مَراثِيَ الخَنساءِ",3,"ا",2,0],["إِلّا عَلى الداءِ الَّذي","خُصَّت بِهِ تِلكَ العِصابَه",4,"ه",1,0],["أَلا عَطفَةٌ تَحيا بِها نَفسُ عاشِقٍ","جَعَلتِ الرَدى مِنهُ بِمَرأىً وَمَسمَعِ",5,"ع",1,0],["أَلا عِم صَباحاً أَيُّها الطَلَلُ البالي","وَهَل يَعِمَن مَن كانَ في العُصُرِ الخالي",6,"ل",2,1],["ألا عَدّ عمّا في العراق فإنني","أراه بأخلاق الزمان مَعايبا",7,"ب",2,0],["إلا على ما لستَ تملك بذْله","من صدْق بأس أو براعة جودِ",8,"د",1,0],["إلا عدوّاً أخرستْهُ ضغينةٌ","لا زال منها الدهرَ في إخراس",9,"س",1,0],["ألا عُقُولَ ألا أحلامَ تَزْجُرهُم","بلى عُقولٌ وأحلامٌ بها مرض",10,"ض",1,0],["إلا على فيشة المغيث له","تعمداً منه أو كما اتفقا",11,"ق",2,0],["ألا عوِّذُوه من توالي فتوحهِ","عساه تَرُدُّ العينَ عنه التمائمُ",12,"م",1,0],["الأعور المُعور الملاقي","بمؤخر السوء كلَّ مقدمْ",13,"م",1,0],["أَلا عَصَمَ اللَهُ القَطا في فِراخِها","فَإِنَّ فِراخي خانَها الماءُ وَالظِلُّ",14,"ل",1,0],["ألا عند مصر والبيان وأهله","يد للمعالي صادفت حافظ اليد",15,"د",1,0],["إلا عوارض روحانية عرضت","بها لطائفُ لا يدركن بالنظرِ",16,"ر",1,0],["إِلّا عَلى رَأسِ جِذعٍ باتَ يَنقُرُهُ","جِرذانُ سَوءٍ وَفَرخٍ غَيرُ ذي ريشٍ",17,"ش",1,0],["ألا عُدْ لي بباطَيةٍ وكاسِ","وَزَعْ همِّي بإبريقٍ وطاسِ",18,"س",1,1],["إلّا على غزوٍ يُبيدُ بِهِ العِدى","للِّه من غزوٍ لَهُ وجهادِ",19,"د",1,0],["أُلاعِبُ فِيهِ أَطْرَافَ الْعَوَالِي","وَأُطْلِقُ بَيْنَ هَبْوَتِهِ حِصَانِي",20,"ن",2,0],["أَلا عَرَّسَ الإِخوانُ في ساحَةِ البِلى","وَما رَفَعوا غَيرَ القُبورِ قِبابا",21,"ب",2,1],["الأَعلى الَذي سَبَقَ الناسَ","وَسَوَّى فَوقَ السَماءِ سَريرا",22,"ر",2,0],["أَلا عَجِبَ الفِتيانُ مِن أُمِّ مالِكٍ","تَقولُ لَقَد أَصبَحتَ أَشعَثَ أَغبَرا",23,"ر",2,1],["أَلا عُج إِلى دارِ السُرورِ وَسَلِّمِ","وَقُل أَينَ لَذّاتي وَأَينَ تَكَلُّمي",24,"م",2,1],["أَلا عَلِّلاني إِنَما العَيشُ تَعليلُ","وَما لِحَياةٍ بَعدَها ميتَةٌ طولُ",25,"ل",1,1],["أَلا عَلِّلاني قَبلَ أَن يَأتِيَ المَوتُ","وَيُبنى لِجُثماني بِدارِ البِلى بَيتُ",26,"ت",1,1],["أَلا عَلِّلاني كَم حَبيبٍ تَعَذَّرَت","مَوَدَّتُهُ عَن وَصلِهِ قَد تَسَلَّيتُ",26,"ت",1,0],["أَلا عَلِّلاني لَيسَ سَعيِي بِمُدرَكٍ","وَلا بِوُقوفي بِالَّذي خُطَّ لي فَوتُ",26,"ت",1,0],["ألا عبقرِيُّ الرأي يَفري فَرِيَّه","ألا نَدُسٌ طَبٌّ ألا حازمٌ جَلد",27,"د",1,0],["أَلا عِش بِزَينٍ أَينَ سِرتَ مُسَلَّماً","وَقَد رُحتُ مِنهُ حينَ رُحتُ بِشَينِ",28,"ن",1,0],["إلا على ظهر أمردٍ خنِثٍ","تميلُ أردافهُ من الثقَل",29,"ل",1,0],["أَلاعَلِمتَ وَأَنتَ غَيرُ مُفَنَّدٍ","أَنَّ القَليلَ إِلى القَليلِ كَثيرُ",30,"ر",1,0],["أُلاعِبُ غولاً هَداهُ الكَرى","إِلَينا تَشُطُّ وَتَستَورِدُ",31,"د",1,0],["أَلا عَدّي بُكاءً أَو نَحيباً","فَمِن سَفَهٍ بُكاؤُكِ وَالنَحيبُ",32,"ب",1,1],["أَلا عَتَبَت عَلَيَّ اليَومَ عِرسي","وَقَد هَبَّت بِلَيلٍ تَشتَكيني",33,"ن",2,0],["إِلاَّ عِلاَفِيّا وَسَيْفاً مُلْطَفاً","وضِبِرَّةً وَجْنَاءَ ذَاتَ هِبَابِ",34,"ب",1,0],["الأعزلُ المنفيُّ فارق قيدَه","ورمى بآسره وذلَّ إِسارِهِ",35,"ر",2,0],["أَلاَ عاطِنِيها بِنْتَ كَرْمٍ تَزَوَّجَتْ","عَلَى نَغَماتِ الْعُودِ بِابْنِ سَمَاءِ",36,"م",3,1],["أَلا عَمِيَت عَينُ الزَمانِ فَلا هُدى","وَشلَّت يَمينُ المَجدِ مِنكَ فَلا بَطشُ",37,"ش",1,0],["أَلاعيبُ نحن بكفِّ القضاءِ","هو الصولجانُ، ونحنُ الأُكر",38,"ر",1,0],["أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","تَقُولُ أَرَاكَ الْيَوْمَ أَشْعَثَ أَغْبَرَا",39,"ر",2,1],["الا عذر لا كان الهوى في الهوى العذر","متى ليل عسر الهجر يكشف باليسر",40,"ر",1,1],["ألاعب دهراً لا انقضاء لحاله","بلا طائل زين فكم ذا ألاعبه",41,"ب",2,0],["ألا عد إلى العهد الذي كنت أحمد","ولا تتركني في العذاب أخلد",42,"د",1,1],["ألا عِم صباحاً أيها الربع منعما","وحدِّث حديثاً عن مُيَيمَ مُنَعِّما",43,"م",2,1],["أَلاَ عُج مِن حَيَازِيمِ المَطِيِّ","عَلَى قَبرِ الإِمَامِ الحَضرَمِيِّ",44,"ي",1,1],["الأَعلى عَلى الوَرى قَدراً وَأَوضَحِهُم هُدىً","وَأَصدَقُهمِ قَولاً وَأَكرَمُهم فِعلا",45,"ل",2,0],["أَلا عَمِيَت عَينُ اِمرِئٍ لَم تَجُد لَهُ","بِدَمعٍ وَأَضحى رَبُّها رَبَّ عميانِ",46,"ن",1,0],["إلا عيالا أباد الله شأفتهم","ما منهم أحد للماء يغترف",47,"ف",1,0],["الأَعصَمَ الصَدَعَ الوَحشِيِّ في شَعَفٍ","دونَ السَماءِ نِيافٍ يَفرُعُ الجَبَلا",48,"ل",2,0],["إلّا على ذي المال والما","ءِ المقطّرِ واللحوم",49,"م",1,0],["ألا عظةٌ إنَّ الزمانَ خؤونُ","وإنَّ ملمَّاتِ الزمانِ فنونُ",50,"ن",1,1],["ألا عاطني الخمرَ إنَّ الزمانَ","على مِيمِها وعلى رائِها",51,"ا",3,1],["الأعين الزرق في باريس ترهبني","كالأعين السود في آطام بغدان",52,"ن",1,0],["أَلا عُد بي إِلى حَيثُ السَرايا","تُقيمُ لِعُرسِكَ اليَومَ الأَغَرّا",53,"ر",2,0],["أَلا عَلِّلاني بِالتَعازي وَأَقنِعا","فُؤاديَ أَن يَرضى بهِنَّ تَعازِيا",54,"ي",2,0],["أَلاَ عَطْفَةٌ لِأَسِيِرهِمُ","أَلاَ رَحْمَةٌ لِلَّذِي قَدْ سَبَوْا",55,"و",2,0],["أَلاَ عُذْ بِالضَّرِيحِ التَّاوُدِيِّ","وَمَا قَدْ ضَمَّ مِنْ ذَاكَ الْوَلِيِّ",56,"ي",1,1],["ألا عَلمت أمي هنالِكَ أنّني","أعيشُ بلا أُمٍ وهذا هو الفَقر",57,"ر",1,0],["الاعز المتقى من هاشم","طيب العنصر حاشا أَن يضاما",58,"م",2,0],["ألا عدّ عن صغرى تجرّ كبيرةً","فغايةُ صبّ الغيث من مبدإ الرش",59,"ش",1,0],["إلا على باطل وترك قربه","ما أولئك أخيار",60,"ر",1,0],["إِلّا عسولٌ أَو حاجِلٌ نَغِقٌ","وَذو ضُياحٍ في صَوتِهِ بَحَحُ",61,"ح",1,0],["إلاّ عِنانَ مُطَهَّمٍ ذي مَيْعةٍ","ألقاهُ منه بينَ تلك الأنْمُل",62,"ل",1,0],["ألا عَتَبَت عليَّ اليومَ أَروَى","لآتيها كما زعمت بفَهدِ",63,"د",1,0],["ألا عَدِّها عَنِّي حَياءً فإنَّني","أراها تَراني والحَبابُ عُيونُها",64,"ن",3,0],["إلا على الله خالقها ورزاقها","تسرح جويعه وتضوى به إلى أحداقها",65,"ق",3,0],["ألا عطفةً بالوصْلِ منكم لِمُغْرمٍ","أسير الجوى صَادي الجوانح حرّانِ",66,"ن",1,0],["ألا عجب صاغ الربيع من الزهر","مداهن تبر لم يصغن من التبر",67,"ر",1,1],["ألا عَزَّ من أبَدى إليكَ خُضُوعَهُ","وحازَ غِناهُ من إليكَ افتقارُهُ",68,"ر",2,0],["ألا عفواً وتوفيقاً إلهي","فحبل رجاي فيك بك الوثيق",69,"ق",1,0],["إلا على ند يبادلها الهوى","فلغاتها موصولة بلغاتي",70,"ت",2,0],["ألا عَطفاً على عيشٍ فسادٍ","يكون له بقربكُمُ صلاحُ",71,"ح",1,0],["إلا \" عراق \" تُناد يني .. وَها أنَذا","أصحو بأنأى بقاع ِالأرض ِمن حُلُمي",72,"م",2,0],["أَلا عَلَّ لَيلى إِن تَشَكَّيتُ عِندَها","تَباريحَ لَوعاتِ الهَوى أَن تَلَيَّنا",73,"ن",2,0],["أَلا عاطِني المَدامَه","بِقاقُرَّةٍ وَجامَه",74,"ه",1,1],["أَلا عَلِّلاني وَاِعلَما أَنَّني غَرَر","وَما خِلتُ يُجديني الشَفاقُ وَلا الحَذَر",75,"ر",1,1],["ألا عَتَبَتْ جُمْل وبيني وبينها","من البيد عذرٌ لو به علمت جمل",76,"ل",1,0],["ألا عدَلْتِ عن الملامِ؟","والرّوحُ عنْ ريبتيْ تُجيبُ",77,"ب",1,0],["أَلا عَتَبَت عَلَيَّ فَصارَمَتني","وَأَعجَبَها ذَوو اللِّمَمِ الطِوالِ",78,"ل",1,1],["ألا عوجا لمجتَمَعِ السِّيالِ","فثَمَّ شفاءُ ما بي من خبَالِ",79,"ل",1,1],["أَلا علّلاني بالحياةِ وخادِعا","يقينِي فكلٌّ بالحياةِ معلَّلُ",80,"ل",1,0],["أَلا عَظَّمَت ما باحَ مِنّي مِنَ الهَوى","وَما في ضَميرِ القَلبِ أَدهى وَأَعظَمُ",81,"م",1,0],["ألا عم صباحا قول من قال قبلنا","له ومساء نحن قلنا نتمم",82,"م",1,0],["ألا علَّ من شاقني علَّهُ","يداوي فؤادي بما علَّهُ",83,"ه",1,0],["إِلّا عَواسِلُ كَالمِراطِ مَعيدَةٌ","بِاللَيلِ مَورِدَ أَيِّمٍ مُتَغَضِّفِ",84,"ف",1,0],["أَلا عَلِّلاني قَبلَ نَوحِ النَوائِحِ","وَقَبلَ ارتِقاءِ النَفسِ فَوقَ الجَوانِحِ",85,"ح",1,1],["أَلا عَلِّلاني والمُعَلِّلُ أَروَحُ","وَيَنطِقُ ما شاءَ اللِسانُ المُسَرَّحُ",86,"ح",1,1],["أَلا عَلِّلاني قَبلَ نَوحِ النَوائِحِ","وَقبلَ اطِّلاعِ النَفسِ بَينَ الجَوانِحِ",87,"ح",1,1],["الأعَلِّلانِي قَبْلَ نَوْحِ النَّوادبِ","وقبلَ بكاءِ المُعْوِلاتِ القَرائِبِ",88,"ب",1,1]]}