{"poems":[[55,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[95,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[93,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[186,"رقص الهزار على الغصون الميس","https://www.aldiwan.net/poem67056.html","الكامل"],[325,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[382,"قد حاز يوحنا الجنين كماله","https://www.aldiwan.net/poem59246.html","الكامل"],[438,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[445,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[447,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[458,"من أنبأ الغيد الحمائم أنه","https://www.aldiwan.net/poem61724.html","الكامل"],[463,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[534,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[556,"يا يوم أي شجى بمثلك ذاقه","https://www.aldiwan.net/poem47153.html","الكامل"],[556,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122695","المنسرح"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35404","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114757","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87704","الكامل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126064","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87372","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108360",""],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90974","الكامل"],[4929,"الموت القادم من الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=199561",""],[5183,"الدعاء الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=185885",""],[402,"فجع القريض وقد ثوى حسان","https://www.poetsgate.com/ViewPoem.aspx?id=36468",""],[5956,"‏متزلف أنا للإله الباري","https://www.poetsgate.com/ViewPoem.aspx?id=183921",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[5956,"تعاطف من الله","https://www.poetsgate.com/ViewPoem.aspx?id=194054",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[6068,"عصفور بيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179264",""]],"verses":[["مُتَزَيِّدينَ إِلى السُؤالِ وَعِندَكُم","أُمُّ العَظاءِ مُفِذَّةً لَم تُتئِمِ",0,"م",1,0],["مُتَزَوِّداً بِالصَّالِحَاتِ وَزَادُهُ","مِنْ خَيْرِ مَا يَتَقَبَّلُ الرَّحْمَنُ",1,"ن",1,0],["مُتَزَوِّداً مِن كُلِّ حُسنٍ لَمحَةً","شَأنَ المُحِبِّ الثائِرِ المُتَمَرِّدِ",2,"د",1,0],["مُتَزَمِلٌ بِالطَيلَسانِ وَدونَهُ","يَبدو مِن التَقوى بِأَبهى مَلبَسِ",3,"س",1,0],["مُتَزاحِمينَ أَقارِباً وَأَجانِباً","لِلمَنهَلِ العَذبِ الكَثيرِ ُررودُهُ",4,"د",2,0],["متزيناً بمواهبٍ روحيةٍ","تمَّت وما تمت خلائقُ رسمه",5,"م",2,0],["متزيّنٌ من نفسه بمحاسِنٍ","هي في الحُسامِ العضْبِ ماءُ فِرنْدِه",6,"د",2,0],["مُتَزاحِمينَ عَلَى يمينٍ أَصْبَحَتْ","مبسوطَةً لمُؤَمِّلٍ ومُقَبِّلِ",7,"ل",1,0],["متزهد في الناس أي تزهد","وإذا خلوت عصيت رب الناس",8,"س",1,0],["متزحلقاتٍ كالغواني قُربها","فوقَ الجليدِ يرف مِلءَ جمالِهِ",9,"ل",2,0],["متزمّلاً بالصونِ أرقع دائباً","بالصبر من أثوابه الأسمالِ",10,"ل",1,0],["مُتَزَهِّداً فيما يَزُولُ مُزايلاً","إدْراكَ ما يُبْقي عَظِيمَ ثَوابِهِ",11,"ب",2,0],["متزاحمين على الرّدى في موقفٍ","حُشِيَ الظُّبا وأُسِنَّةَ المُرّانِ",12,"ن",1,0],["مُتزاحمين فَمنْسِرٌ في مَنْسِرٍ","أو فَيْلَقٍ بضرابه في فيلقِ",13,"ق",1,0],["مَتَّزِرٌ بالوَقارِ مُشتَمِلٌ","مُصطَبِحٌ بالسَّماحِ مُغتَبِقُ",14,"ق",1,0],["مُتَزاحِمينَ عَلى بِساطِكَ رَغبَةً","في لَمحِ غُرَّتِكُم وَلَثمِ يَمينِ",15,"ن",1,0],["مُتَزيّداً من بِشرها متزوداً","من نَشرِها متخيّراً مُتَحكما",16,"م",2,0],["مُتزوّج يا لَيته","قَد ماتَ مِن قَبل الزَواج",17,"ج",1,0],["متزجيات ماينين على","الوجى من بعد مسرى",18,"ر",2,0],["متزيّنٌ بحلى العلى متواضعٌ","حيثُ العلاءُ بِهِ تشامخ كِبرُهُ",19,"ر",2,0],["متزين في كل خلق باهر","اضحى ارق من النسيم والينا",20,"ن",2,0],["متزيٍّ خوف الرفيبِ بزيِّ ال","غيد من كان فارسَ الهيجاءِ",21,"ا",2,0],["متزوداً بالخير مغتنما رضا","مولى غدا تقواه خير مغانم",22,"م",1,0],["مُتزعمٍ امساخَ عقلٍ سُخرَت","في أمره وبها هوىً وتعلُقُ",23,"ق",1,0],["متزلفا للشاكر المنان في","تضراع منقطع على جدرانه",24,"ن",2,0],["متزودا بالصالحات وزاده","من خبر ما يتقبل الرحمن",25,"ن",1,0],["متزلفٌ أنا للإلهِ الباري","فعسى يُخفف عَطْفُه أكداري",26,"ر",2,1],["متزوج من عَشْر نسوانٍ معاً","جوعى يفضّلن الخلود إلى البلى",27,"ل",2,0],["متزلفٌ لك شاكرٌ ومُقَدِّرٌ","جرّاء جَعْلكَ لي أعود سعيدا",28,"د",2,0],["متزلزلٌ أنا يا ترى في حبهم","أم إنَّ هذا الحبَّ ليس مزلزلي؟",29,"ل",2,0],["متزايدا في حبّ \"بيّة\" نافضا","منه الجناح لقصدها فيطير",30,"ر",1,0]]}