{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[91,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[180,"رقص الهزار على الغصون الميس","https://www.aldiwan.net/poem67056.html","الكامل"],[318,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[374,"قد حاز يوحنا الجنين كماله","https://www.aldiwan.net/poem59246.html","الكامل"],[429,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[436,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[438,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[451,"من أنبأ الغيد الحمائم أنه","https://www.aldiwan.net/poem61724.html","الكامل"],[456,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[527,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[549,"يا يوم أي شجى بمثلك ذاقه","https://www.aldiwan.net/poem47153.html","الكامل"],[549,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"]],"verses":[["مُتَزَيِّدينَ إِلى السُؤالِ وَعِندَكُم","أُمُّ العَظاءِ مُفِذَّةً لَم تُتئِمِ",0,"م",1,0],["مُتَزَوِّداً بِالصَّالِحَاتِ وَزَادُهُ","مِنْ خَيْرِ مَا يَتَقَبَّلُ الرَّحْمَنُ",1,"ن",1,0],["مُتَزَوِّداً مِن كُلِّ حُسنٍ لَمحَةً","شَأنَ المُحِبِّ الثائِرِ المُتَمَرِّدِ",2,"د",1,0],["مُتَزَمِلٌ بِالطَيلَسانِ وَدونَهُ","يَبدو مِن التَقوى بِأَبهى مَلبَسِ",3,"س",1,0],["مُتَزاحِمينَ أَقارِباً وَأَجانِباً","لِلمَنهَلِ العَذبِ الكَثيرِ ُررودُهُ",4,"د",2,0],["متزيناً بمواهبٍ روحيةٍ","تمَّت وما تمت خلائقُ رسمه",5,"م",2,0],["متزيّنٌ من نفسه بمحاسِنٍ","هي في الحُسامِ العضْبِ ماءُ فِرنْدِه",6,"د",2,0],["مُتَزاحِمينَ عَلَى يمينٍ أَصْبَحَتْ","مبسوطَةً لمُؤَمِّلٍ ومُقَبِّلِ",7,"ل",1,0],["متزهد في الناس أي تزهد","وإذا خلوت عصيت رب الناس",8,"س",1,0],["متزحلقاتٍ كالغواني قُربها","فوقَ الجليدِ يرف مِلءَ جمالِهِ",9,"ل",2,0],["متزمّلاً بالصونِ أرقع دائباً","بالصبر من أثوابه الأسمالِ",10,"ل",1,0],["مُتَزَهِّداً فيما يَزُولُ مُزايلاً","إدْراكَ ما يُبْقي عَظِيمَ ثَوابِهِ",11,"ب",2,0],["متزاحمين على الرّدى في موقفٍ","حُشِيَ الظُّبا وأُسِنَّةَ المُرّانِ",12,"ن",1,0],["مُتزاحمين فَمنْسِرٌ في مَنْسِرٍ","أو فَيْلَقٍ بضرابه في فيلقِ",13,"ق",1,0]]}