Poem.aspx?id=211958",""],[557,"لأن الشوق معصيتي","https://www.poetsgate.com/ViewPoem.aspx?id=13820",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[5057,"واهِنُ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=207364",""],[3591,"أنيخوا مطاياكم غداة نودع","https://www.poetsgate.com/ViewPoem.aspx?id=149422",""],[5183,"نَبْعُ الفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=186454",""],[5277,"زهرة البيتونيا","https://www.poetsgate.com/ViewPoem.aspx?id=190958",""],[5277,"القشطةُ..هي..","https://www.poetsgate.com/ViewPoem.aspx?id=194452",""],[5299,"ارجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210537",""],[5376,"لن تَبْلُغي ماعشْتُ عمري هاجرا","https://www.poetsgate.com/ViewPoem.aspx?id=198977",""],[5690,"خلَعَ الزمان الآن ثوب حداحدهِ","https://www.poetsgate.com/ViewPoem.aspx?id=172149",""],[5713,"نعم هِيَ دَار من نهوى يَقِينا","https://www.poetsgate.com/ViewPoem.aspx?id=189216",""],[5781,"كمشةُ أحزانٍ بيدي...","https://www.poetsgate.com/ViewPoem.aspx?id=208992",""],[402,"ماذا يريد الشعر منني","https://www.poetsgate.com/ViewPoem.aspx?id=36534",""],[5956,"ماذا أقول لمن أردتُ زواجها؟","https://www.poetsgate.com/ViewPoem.aspx?id=182522",""],[5956,"ليت يحالفني التعبير","https://www.poetsgate.com/ViewPoem.aspx?id=183270",""],[5956,"هم لم يطيقوا أن يكونوا دولة واحدة","https://www.poetsgate.com/ViewPoem.aspx?id=205384",""],[6093,"بِيْدُ القصائد ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=181742",""],[6108,"مع سبق الإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=192751",""],[6125,"أنيخي الركبَ في كنفي أنيخي","https://www.poetsgate.com/ViewPoem.aspx?id=210907",""],[6142,"وطلاب رشدٍ فوق نجب حدت بهم","https://www.poetsgate.com/ViewPoem.aspx?id=155740",""],[6152,"غيابك اتعبني","https://www.poetsgate.com/ViewPoem.aspx?id=204821",""],[6072,"حديث المواسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81422&r=&rc=4",""],[6340,"نار في الرسغ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85835&r=&rc=0",""],[5567,"المجد بابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82078&r=&rc=131",""]],"verses":[["أُنيخَت رِكابُ اللَيلِ مِن كُلِّ جانِبٍ","وَحادَت نُجومُ اللَيلِ عَن كُلِّ مَوقِعِ",0,"ع",1,0],["إِنِّي خَتَمْتُ العَيْشَ فِي","وَادِي المخِيلَةِ أَوْ كَأَنِّي",1,"ن",2,0],["إِنْ يَخْتَدِمْ فَلَهُ الفَخَارُ وَكُلُّ ذِي","قَدْرٍ لِسُدَّتِهِ مِنَ الخُدَّامِ",2,"م",1,0],["أُنيخَت فَأَلقَت بَلدَةً فَوقَ بَلدَةٍ","قَليلٍ بِها الأَصواتُ إِلّا بُغامُها",3,"م",3,0],["إن يخلُفِ الأرضَ الغمامُ فإِنّني","أَسقي الضريحَ بدمعيَ المُهَراقِ",4,"ق",1,0],["أُنيخَت رِكابي بِالأَحِزَّةِ بَعدَما","خَبَطنَ بِحَورانَ السَريحَ المُخَدَّما",5,"م",2,0],["إن يخدم القلمَ السيفُ الذي خضعتْ","له الرقابُ ودانت خوفه الأممُ",6,"م",1,1],["إِنّي خَشيتُ مَواقِفاً","لِلبَينِ تَسفَحُ غَربَ ماقِك",7,"ك",1,0],["أُنيخَت وَما تَدري أَما في ظُهورِها","مِنَ القَرحِ أَم ما في المَناسِمِ أَنقَبُ",8,"ب",1,0],["أُنيخَت إِذا اِنشَقَّ العَمودُ كَأَنَّما","بَنائِقُهُ مِن طَيلَسانٍ وَمُجسِدِ",9,"د",1,0],["إني خلعتُ إليه العذرَ مُنسلِخاً","من الحِجَا سابحاً في بحرِ غاراتِ",10,"ت",1,0],["إِنِّي خَبرتُ الدَّهر خُبْرَ مُجَرّبٍ","وكلمْتُ غاربَهُ بِحَمْلِ قتودِ",11,"د",1,0],["إن يخطبوا باسْمِ الإِخاءِ ويكتبوا","فالقولُ لَغْوٌ والكتابُ مُزوَّرُ",12,"ر",1,0],["إن يُخلفِ الزّمنُ الكَنودُ فربّما","وَفَتِ الجُدودُ وبَرّتِ الأقسامُ",13,"م",1,0],["إِن يَختَلِف مِنكُمو في الأمرِ مُختَلِفٌ","فَما لَنا اليَومَ غَيرُ اللَهِ مِن حَكَمِ",14,"م",1,0],["إن يَخْلُ منها اليومُ فالغدُ بعده","بالخيرِ والرضوانِ منها مُفعَمُ",15,"م",1,0],["أَن يَخبُ للحُب في أَكبادهم قَبس","سَقَتهُم مِن شَراب المهل أَكواب",16,"ب",1,0],["إِن يَخُطَّ الذَنبَ اليَسيرَ حَفيظا","كَ فَكَم مِن فَضيلَةٍ مَحّايَه",17,"ا",3,0],["أُنِيخَتْ بِبَابِ البَيْتِ حَتَّى تَحَلَّلَتْ","فَرَاحَتْ مَعَ الرَّكْبِ الَّذِي قَدْ تَحَلَّلاَ",18,"ل",2,0],["أُنِيخَتْ فَخَرَّتْ فَوْقَ عُوجٍ ذَوَابِلٍ","ووَسَّدْتُ رَأْسي طِرْفَساناً مُنَخَّلاَ",18,"ل",2,0],["أُنِيخَتْ لَدى بابِ ابْنِ مَرْوانَ ناقَتِي","ثَلاثاً لَها عِنْدَ النِّتاجِ صَرِيفُ",19,"ف",1,1],["إِنْ يَخِبْ سَائِلٌ فَمَا خَابَ يَوْماً","فِي ذَرَاهُ المُؤَمِّلُ المُعْتَامُ",20,"م",1,0],["إِنِّي خَبَرْتُ صَدَاقَةً بِكَ حُلْوةً","وَوَرَدْتُ أَصْفى مَوْرِدٍ بِهَوَاكَا",21,"ك",2,0],["أنّى خطرت ، لبست حقلا","من غزل ، وانتعلت حقلا !",22,"ل",2,0],["إِن يَخفِهِ لَيل النَوى فَجَبينُهُ","صُبح يَنمُّ عَلَيهِ بِالأَضواءِ",23,"ا",2,0],["إن يخْسر البائعُ ما باعَه","مما سقاهُ يربح المُشترِى",24,"ر",2,0],["إِن يَخفَ ما بَينَكم فَضلي فَلا عَجَبٌ","لا يَستَطيعُ شُعاعَ الشَمسِ ذُو السَبَلِ",25,"ل",1,0],["إنّي خدمتُ مثالَ نعلِ المصطفى","لأعيشَ في الدارينِ تحتَ ظلالها",26,"ه",2,1],["أَنَّى خَبَتْ تلك العزائمُ ريثما","لم يخلُ من ضرَمٍ ومن إلهاب",27,"ب",1,0],["إن يخنْ ظبيٌ فظبياً","أو تضقْ أرضٌ فأرضا",28,"ض",2,0],["إن يخونوا فما خيانة روح","سقطت سقطة الهوى في طريقي",29,"ي",1,0],["إِنْ يَخْلُ طَرْفُكَ مِنْ سُكَانِها فَبِها","ما يَمْلأُ الْقَلْبَ مِنْ شَوْقٍ وَتَذْكارِ",30,"ر",1,0],["أَنيخوا حيث تغتَنم العَطايا","أَنيخوا حَيث تَندمل الكُلومُ",31,"م",1,0],["أَنيخوا حَيث هبَّ صبا الأَماني","أَنيخوا حَيث طابَ لَكُم شَميمُ",31,"م",1,0],["أُنيخُها ضَلّةً منهمْ إلى عُصَبٍ","حاشا الكرامَ إذا سِيلو النّدى وَعِكوا",32,"ك",3,0],["إنْ يَخْلُ طَرْفي منك في حالةٍ","فليس يَخْلو منك إضماري",33,"ر",2,0],["إنْ يُخْصِبُوا يَعْيَوْا بخَصْبهمُ","أَو يُجْدِبُوا فهُمْ بهِ أَِلأَمْ",34,"م",1,0],["إني خسرت لأجل ربي ثروتي","وحسبتها كالزِبل من فوق الثرى",35,"ر",2,0],["إن يخيبني فقد أعضت بخل","ما له في بني الزمان عديل",36,"ل",1,0],["إِن يُخطِني كلف بِه فإلى جوىً","أَو يخطها بَينٌ فنَحو تَجَنُّبِ",37,"ب",1,0],["أُنيخت في رحاب بني عليٍّ","نياقي لا بمنعرج الغميم",38,"م",1,0],["أنيخاها فَقَدْ بَلَغَت مُناها","وغادرها المسيرُ كما تراها",39,"ا",3,1],["اِني خَبرْتُ عُلاهُ خُبْر مجربٍ","فجعلتُ صفو قلائدي لثَنائهِ",40,"ا",3,1],["أَن يَخسِفَ الأَرضَ بِالأَحوى وَفارِسِهِ","فَاِنظُر إِلى أَربَعٍ في الأَرضِ غُوّارِ",41,"ر",1,0],["أنيخوا بركن الدّين شُعْثَ مَطِيّكمْ","وحُلّوا فما بعد الهُمامِ هُمامُ",42,"م",1,0],["إن يخالط غيره اشتغلت","فكرة منه فتنضغط",43,"ط",1,0],["أُنيخَ مَسحولٌ مَعَ الصُبّارِ","مَلالَةَ المَأسورِ للاِسارِ",44,"ر",1,1],["أُنِيخَت بِجَوٍّ يَصرُخُ الدِّيكُ عِندَها","وَباتَت بِقَاعٍ كادِئِ النَّبتِ سَملَقِ",45,"ق",1,0],["إنْ يخفقِ القلبُ بالنَّجوى يساعِفُهُ","بما هو الخيرُ في أَصْفى تَجَلِّيهِ",46,"ي",2,0],["أَنيخُوا فَمَا بَالُ الرّكُوبِ وَإِنَّها","عَلى الرَّأْسِ تَمْشِي أَوْ عَلَى العَيْنِ تَشْخصُ",47,"ص",1,0],["إن يَخلُ كَفُّكَ مِن سَيفٍ وَمِن قَلَمٍ","فَشَدَّ ما حِمداهُ السَّيفُ والقَلَمُ",48,"م",1,0],["إني خَبَرتُ الرِّجال فاسأل","عَنهُم تَجدني بِهم خَبيرا",49,"ر",2,0],["أنيخا بنا العيس في كربلا","مناخ البلاء مناخ الكرب",50,"ب",1,0],["إِن يُخَصَّا بالوصل منِّي فإنِّي","أنا بالهجر منهما مَخْصُوص",51,"ص",1,0],["أنيخت لهم عند الطفوف ركاب","وناداهم داعي القضا فأجابوا",52,"ب",3,1],["أنيخا يمين الحي في الجزع واسمعا","بكاء يعيد الطو ركا مصدعا",53,"ع",2,1],["إنْ يَخْلُ عَمْروّ بِهِ يَقْذُفْهُ فقي لْجَج","يَهْوِي بِهِ النَّجْمُ تَيْساً بَيْنَ أتْيَاس",54,"س",1,0],["أن يخل ريع الصبا ينزل مرابعها","أو يندثر أثر يظهر بها أثر",55,"ر",1,0],["إني خلعْتُ عِذاري","على المليح العِذارِ",56,"ر",1,1],["إن يخلُ لى مجلسٌ منه فقد حُشِيت","من الغرام به والوجدِ أحشاءُ",57,"ا",2,0],["إن يختلط رزءاهما فكلاهما","قصما قرَا الإِيمان والتوحيد",58,"د",1,0],["إنِّي خَضَعتُ لحكمِ سُلطانِ الهوى","وصبابَةً أبكي بدمعٍ مُرسَلِ",59,"ل",1,0],["إن يخط البنان منك حرفا","خط قلبي والوجد ما ليس يخفى",60,"ف",2,0],["اني خبرت بني الزمان فلم أجد","إلا الأديب على البلاء يؤاتي",61,"ت",2,0],["أنيخوا بأبلج سامي الجدود ما","شاب في الجود منا بمن",62,"ن",1,0],["إني خليفيه داود وأضوأ من","قد كان في قبضة الرحمن يبديه",63,"ي",2,0],["إني خلصتُ إليه","لما اقتربتُ نجيّا",64,"ي",2,0],["إني خصيص لما أوليه من كرم","إني خسيسٌ لجانٍ إذ أعاقبه",65,"ب",2,0],["إن يخفَ سرُّ غيابه عنّا فكم","لله من سرٍ خفيٍ كانا",66,"ن",2,0],["إني خرجت إلى الوجود","فلا وراءَ ولا إمام",67,"م",1,0],["إِن يَختَطف أسدَ اللَه الحمامُ فَقَد","يَحتال بِالأَسد الضرغامة السيد",68,"د",1,0],["أَنيخا الناعِجينَ وَلا تَروما","فَما السُلوانُ بِالأَمرِ العَظيمِ",69,"م",1,0],["إني خرجت كاشفاً للظلم","بنعمة الهادي السلام المنعم",70,"م",1,0],["إني خلعتُ عليك ظلّ شبابي","فإذا هواك مُنّي ولمع سراب",71,"ب",1,1],["إن يختبرني الأولى من مظهري ضحكوا","سيضحكون ولكن من عقولهم",72,"م",1,0],["إن يُخف ذكري حسودي","فلي بذلك فخرُ",73,"ر",1,1],["اني خشيت على المود","ة ان يشوب كؤوسها",74,"س",3,0],["أنيخا جمالي بأبوابها","وحطا بها بين خطابها",75,"ب",3,1],["إِنّي خبرت النيري","نِ فكنتَ أَنفَع منهما",76,"م",2,0],["أُنيخَتْ بأبوابِ الوزيرِ محمدٍ","فلم تَرعَ إلاّ في سَماحٍ ونائِلِ",77,"ل",1,0],["أُنيختْ بهِ ولقدْ هُلّلتْ","ومُقْوَرَّةً كِليتاها اقوِرارا",78,"ر",2,0],["أنيخوا مطاياكم غداة نودّع","لتملأ عيني فرقةٌ وتودعُ",79,"ع",1,1],["إني خلقت وفيّاً","لعهد خلي أراعي",80,"ع",2,0],["ان يخلفوا لك في الممات وصية","فالعذر شوق لا يطيق بعادا",81,"د",2,0],["أن يخدعوك بألفاظ منمقة","لا تغترر منهم يوما بتأمين",82,"ن",1,0],["أنى خديجة مذعورا ومرتعدا","فأذهب الرعب تدثير وتزميل",83,"ل",1,0],["إنِّيَ خائفٌ من الرحمنِ","وخوفه فرضٌ على الأعيانِ",84,"ن",1,1],["أنيخاها بمنعرج الغميم","فثم ملاعب الرشأ الرخيم",85,"م",1,1],["إِن يَخفَ عَن أَهلِ دَهري كُنهُ مَنزلَتي","فَالصُّبحُ عَن بَصر العميانِ مُنكتمُ",86,"م",1,0],["أن يخضع العسر لأمر اليسر","وقربه يانع زرعٍ بادي",87,"ي",1,0],["أن يخنك الصبر فالأنس وفى","يوم تزويج الفتى عبد الغني",88,"ي",1,0],["إِن يَخشَ منَ القَوم سِراراً قَمَري","لا غَروَ مِنَ السِرارِ يؤتى القَمَرُ",89,"ر",1,0],["إِن يُخاطِبكَ في رُمُوزِ هَواهُ","تُبصِرِ البَدرَ بِالعَجائِبِ ناطِق",90,"ق",1,0],["إن يخسف البدر إعظاما لمصرعه","فمن سناه استمد النور باهره",91,"ر",2,0],["إني خطوت إليك الناس كلهم","ولم أزر سوقة منهم ولا ملكا",92,"ك",2,1],["انْ يَخْبِطِ السازُونَ فَهْيَ مَنارَةً","تَهْدِيكِ في لَيْلِ الحياةِ الداجي",93,"ج",2,0],["إني خَرُوصيٌّ ستال دراي","عزيزةٌ شهيَّةُ القرار",94,"ر",1,0],["إن يخلُ جفني من المنامِ بكى","وطالَ ما رُعتُ طرفه فشكا",95,"ك",2,1],["ان يخلعوا فبنو العباس قد خلعوا","وقد خلت قبل حمص أرض بغداد",96,"د",1,0],["أنيخت به غرُّ القوافي وعرَّست","بكل مراح من ذراه شوارده",97,"د",2,0],["انيخت به للعلم كل دقيقةٍ","وقد اُعقلت للفضل فيه الشواردُ",98,"د",1,0],["إني خبير بالذي ترومه","فالق العصا لكي تفوز بالمنى",99,"ا",1,0],["إن يختبرْ جلَدي هذا الفراقُ فما","حصدتُ غيرَ رسوبٍ ساحقٍ ثمَرا",100,"ر",2,0],["إني خُلِقْت لكي أُحِسَّكِ دائماً","وأكون إلفَكِ في الهوى وتكوني",101,"ن",2,0],["إن يختلفْ خُبزُنا اليومى لهجتُنا","فى القلب فصحى دماءٌ ليس تختلفُ",102,"ف",1,0],["إنّي خسرتُ بشاشتي مذ زارني","طيف الأسى ومضى لحصني يَهْدِم",103,"م",1,0],["أن يخمد النار التي اشتعلت","إذ رأسها عن رأسه ارتفعا",104,"ع",2,0],["إني خبرتُ بناتِ الدهرِ أكثرها","خبرتُ فيها الجوى والحربَ والفتنا",105,"ن",2,0],["أَنْ يُخْضِعُوا الأَنْبَاْرَ لَوْلاْ عُصْبَةٌ","عَرَبِيَّةٌ أَبْنَاْؤُهَاْ آسَاْدُ",106,"د",1,0],["ان يخلُ بيتُ اللهِ منكَ فما","كصدُورِنا بالذكرِ مِنْ مأوى",107,"و",2,0],["إن يخفقِ القلب كيف العمر نرجعه","كل الذي مات فينا.. كيف نحييه..",108,"ي",2,0],["إن يختلف الاسم فالموضوع متَّحِدٌ","مهما تلوَّنت الأشخاص ألوانا",109,"ن",2,0],["إنّيْ خبرتُ بني دينِي فلم أَرَهُمْ","إلّا بطوناً على الأرزاقِ تختَصِمُ",110,"م",1,0],["أنيخوا مطاياكم غداة نودع","لتملاء عيبي فرقة وتودعُ",111,"ع",1,1],["أني خبرت من الحياة جديدها","وحديدها فاسئائبَ الاسواء",112,"ا",2,0],["إنّي خَتَمتُ بهذا القَلْب أُمْنية","بِأن تمدين مِنْ وَسْطِ الفُراقِ يَدا",113,"د",2,0],["أنيخوا الركبَ إنْ لاحتْ بدورٌ","فإنّ نجومَها رسلٌ لوعدِ",114,"د",1,0],["إني خضعتُ لأمر قلبي رفعة","وَلعلةٍ يحْنو الكريمُ ويخضَعُ",115,"ع",1,0],["إني خلقت وما عرفْتُ موائلا","فسكنْتُ طيراً في السماء مهاجرا",116,"ر",2,0],["أن يخف ذاك الجسم عنك لبعدهِ","فانظر إليه باعثاً بفؤادهِ",117,"د",2,0],["أنيخوا فِي معالمها المطايا","فديتكم لنشكو مَا لَقينَا",118,"ن",2,0],["إنّي خَذَلْتُ الأَنبِياءَ لِعَيْنِهِ","سُحْقًا لِعَيْنِي لوْ بَكَتْ عَيْناهُ",119,"ا",2,0],["إني ختمت العيش ف","وادي المخيلة أو كأني",120,"ن",2,0],["إني خُدِعتُ ببسمة براقة","أخفت دجى حقدٍ يحيط مزاجَها",121,"ج",3,0],["إني خِلٌّ للأشجارْ","للأنسام وللإعصارْ",122,"ر",1,1],["إني خجولٌ من تدني مجدنا","وكذا فكلُّ مُواطن مخجولُ",123,"ل",1,0],["إني خبيرٌ بأهل الشعر أنعتُهم","فليس من قَادَ وزناً جاء بالعيدِ",124,"د",1,0],["إني خلقتُ مع الأشواق راقصةً","بالحبِّ أغوي الذي في دربه جاسا",125,"س",2,0],["أنيخي الركبَ في كنفي أنيخي","أنيخي صهوة الفرس الجريحِ",126,"ح",1,1],["أنيخوا فهذا موقع الحق 