{"poems":[[55,"أتطمع يا عباس في غير مطمع","https://www.aldiwan.net/poem26259.html","الطويل"],[93,"ماذا يريد الشعر مني","https://www.aldiwan.net/poem11203.html","مجزوء الكامل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[30,"مررنا على دار لمية مرة","https://www.aldiwan.net/poem29525.html","الطويل"],[83,"أغرى سراة الحي بالإطراق","https://www.aldiwan.net/poem54268.html","الكامل"],[27,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[51,"إن يخدم القلم السيف الذي خضعت","https://www.aldiwan.net/poem66080.html","البسيط"],[45,"الله جارك في انطلاقك","https://www.aldiwan.net/poem65184.html","مجزوء الكامل"],[28,"ألم يك جهلاً بعد ستين حجةً","https://www.aldiwan.net/poem1288.html",""],[28,"إليك حملت الأمر ثم جمعته","https://www.aldiwan.net/poem4992.html","الطويل"],[61,"أمقدم يا أبا المقدام أنت على","https://www.aldiwan.net/poem51756.html","البسيط"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[105,"ناج الممالك وهي حيرى تنظر","https://www.aldiwan.net/poem42046.html","الكامل"],[105,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[105,"نبني وتهدم أيدي الجهل دائبة","https://www.aldiwan.net/poem43368.html","البسيط"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[102,"مسهدون وهم حيرى محاجرهم","https://www.aldiwan.net/poem32919.html","البسيط"],[46,"ليس يبقى الضرب الطويل على الدهر","https://www.aldiwan.net/poem23619.html","الخفيف"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72208","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55086","الكامل"],[100,"أخر جديد","https://www.poetsgate.com/ViewPoem.aspx?id=50333",""],[110,"بان الخليط ضحى من الجرعاء","https://www.aldiwan.net/poem16224.html","الكامل"],[129,"يا نهرا سميت بالأصغرين","https://www.aldiwan.net/poem50609.html","السريع"],[170,"أميم لا تنكري حلي ومرتحلي","https://www.aldiwan.net/poem1651.html",""],[190,"إني خدمت مثال نعل المصطفى","https://www.aldiwan.net/poem35117.html","الكامل"],[199,"هم سرى في أضلعي وسرى بي","https://www.aldiwan.net/poem51978.html","الكامل"],[200,"اتخذ باللهو لهوا","https://www.aldiwan.net/poem45521.html","مجزوء الرمل"],[212,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[281,"هي الديار فعج في رسمها العاري","https://www.aldiwan.net/poem60723.html","البسيط"],[354,"هناء بالسلامة مستديم","https://www.aldiwan.net/poem39955.html","الوافر"],[365,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[365,"يا راحلا بالسعد عن مقلتي","https://www.aldiwan.net/poem60903.html","السريع"],[369,"هل بالديار أن تجيب صمم","https://www.aldiwan.net/poem1879.html","السريع"],[378,"إن الذي ترك الثراء الأفخرا","https://www.aldiwan.net/poem59428.html","الكامل"],[404,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[407,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[417,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[417,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[462,"اني خبرت علاه خبر مجرب","https://www.aldiwan.net/poem15618.html","الكامل"],[537,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[552,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[559,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[562,"أنيخ مسحول مع الصبار","https://www.aldiwan.net/poem27822.html","الرجز"],[567,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[580,"رجواك في الله لاتخطأ مراميه","https://www.aldiwan.net/poem56780.html","البسيط"],[587,"لعل أراك الحي ليلا أراكه","https://www.aldiwan.net/poem17998.html","الطويل"]],"verses":[["أُنيخَت رِكابُ اللَيلِ مِن كُلِّ جانِبٍ","وَحادَت نُجومُ اللَيلِ عَن كُلِّ مَوقِعِ",0,"ع",1,0],["إِنِّي خَتَمْتُ العَيْشَ فِي","وَادِي المخِيلَةِ أَوْ كَأَنِّي",1,"ن",2,0],["إِنْ يَخْتَدِمْ فَلَهُ الفَخَارُ وَكُلُّ ذِي","قَدْرٍ لِسُدَّتِهِ مِنَ الخُدَّامِ",2,"م",1,0],["أُنيخَت فَأَلقَت بَلدَةً فَوقَ بَلدَةٍ","قَليلٍ بِها الأَصواتُ إِلّا بُغامُها",3,"م",3,0],["إن يخلُفِ الأرضَ الغمامُ فإِنّني","أَسقي الضريحَ بدمعيَ المُهَراقِ",4,"ق",1,0],["أُنيخَت رِكابي بِالأَحِزَّةِ بَعدَما","خَبَطنَ بِحَورانَ السَريحَ المُخَدَّما",5,"م",2,0],["إن يخدم القلمَ السيفُ الذي خضعتْ","له الرقابُ ودانت خوفه الأممُ",6,"م",1,1],["إِنّي خَشيتُ مَواقِفاً","لِلبَينِ تَسفَحُ غَربَ ماقِك",7,"ك",1,0],["أُنيخَت وَما تَدري أَما في ظُهورِها","مِنَ القَرحِ أَم ما في المَناسِمِ أَنقَبُ",8,"ب",1,0],["أُنيخَت إِذا اِنشَقَّ العَمودُ كَأَنَّما","بَنائِقُهُ مِن طَيلَسانٍ وَمُجسِدِ",9,"د",1,0],["إني خلعتُ إليه العذرَ مُنسلِخاً","من الحِجَا سابحاً في بحرِ غاراتِ",10,"ت",1,0],["إِنِّي خَبرتُ الدَّهر خُبْرَ مُجَرّبٍ","وكلمْتُ غاربَهُ بِحَمْلِ قتودِ",11,"د",1,0],["إن يخطبوا باسْمِ الإِخاءِ ويكتبوا","فالقولُ لَغْوٌ والكتابُ مُزوَّرُ",12,"ر",1,0],["إن يُخلفِ الزّمنُ الكَنودُ فربّما","وَفَتِ الجُدودُ وبَرّتِ الأقسامُ",13,"م",1,0],["إِن يَختَلِف مِنكُمو في الأمرِ مُختَلِفٌ","فَما لَنا اليَومَ غَيرُ اللَهِ مِن حَكَمِ",14,"م",1,0],["إن يَخْلُ منها اليومُ فالغدُ بعده","بالخيرِ والرضوانِ منها مُفعَمُ",15,"م",1,0],["أَن يَخبُ للحُب في أَكبادهم قَبس","سَقَتهُم مِن شَراب المهل أَكواب",16,"ب",1,0],["إِن يَخُطَّ الذَنبَ اليَسيرَ حَفيظا","كَ فَكَم مِن فَضيلَةٍ مَحّايَه",17,"ا",3,0],["أُنِيخَتْ لَدى بابِ ابْنِ مَرْوانَ ناقَتِي","ثَلاثاً لَها عِنْدَ النِّتاجِ صَرِيفُ",18,"ف",1,1],["إِنْ يَخِبْ سَائِلٌ فَمَا خَابَ يَوْماً","فِي ذَرَاهُ المُؤَمِّلُ المُعْتَامُ",19,"م",1,0],["إِنِّي خَبَرْتُ صَدَاقَةً بِكَ حُلْوةً","وَوَرَدْتُ أَصْفى مَوْرِدٍ بِهَوَاكَا",20,"ك",2,0],["أنّى خطرت ، لبست حقلا","من غزل ، وانتعلت حقلا !",21,"ل",2,0],["إِن يَخفِهِ لَيل النَوى فَجَبينُهُ","صُبح يَنمُّ عَلَيهِ بِالأَضواءِ",22,"ا",2,0],["إن يخْسر البائعُ ما باعَه","مما سقاهُ يربح المُشترِى",23,"ر",2,0],["إِن يَخفَ ما بَينَكم فَضلي فَلا عَجَبٌ","لا يَستَطيعُ شُعاعَ الشَمسِ ذُو السَبَلِ",24,"ل",1,0],["إنّي خدمتُ مثالَ نعلِ المصطفى","لأعيشَ في الدارينِ تحتَ ظلالها",25,"ه",2,1],["أَنَّى خَبَتْ تلك العزائمُ ريثما","لم يخلُ من ضرَمٍ ومن إلهاب",26,"ب",1,0],["إن يخنْ ظبيٌ فظبياً","أو تضقْ أرضٌ فأرضا",27,"ض",2,0],["إن يخونوا فما خيانة روح","سقطت سقطة الهوى في طريقي",28,"ي",1,0],["إِنْ يَخْلُ طَرْفُكَ مِنْ سُكَانِها فَبِها","ما يَمْلأُ الْقَلْبَ مِنْ شَوْقٍ وَتَذْكارِ",29,"ر",1,0],["أَنيخوا حيث تغتَنم العَطايا","أَنيخوا حَيث تَندمل الكُلومُ",30,"م",1,0],["أَنيخوا حَيث هبَّ صبا الأَماني","أَنيخوا حَيث طابَ لَكُم شَميمُ",30,"م",1,0],["أُنيخُها ضَلّةً منهمْ إلى عُصَبٍ","حاشا الكرامَ إذا سِيلو النّدى وَعِكوا",31,"ك",3,0],["إنْ يَخْلُ طَرْفي منك في حالةٍ","فليس يَخْلو منك إضماري",32,"ر",2,0],["إنْ يُخْصِبُوا يَعْيَوْا بخَصْبهمُ","أَو يُجْدِبُوا فهُمْ بهِ أَِلأَمْ",33,"م",1,0],["إني خسرت لأجل ربي ثروتي","وحسبتها كالزِبل من فوق الثرى",34,"ر",2,0],["إن يخيبني فقد أعضت بخل","ما له في بني الزمان عديل",35,"ل",1,0],["إِن يُخطِني كلف بِه فإلى جوىً","أَو يخطها بَينٌ فنَحو تَجَنُّبِ",36,"ب",1,0],["أُنيخت في رحاب بني عليٍّ","نياقي لا بمنعرج الغميم",37,"م",1,0],["أنيخاها فَقَدْ بَلَغَت مُناها","وغادرها المسيرُ كما تراها",38,"ا",3,1],["اِني خَبرْتُ عُلاهُ خُبْر مجربٍ","فجعلتُ صفو قلائدي لثَنائهِ",39,"ا",3,1],["أَن يَخسِفَ الأَرضَ بِالأَحوى وَفارِسِهِ","فَاِنظُر إِلى أَربَعٍ في الأَرضِ غُوّارِ",40,"ر",1,0],["أنيخوا بركن الدّين شُعْثَ مَطِيّكمْ","وحُلّوا فما بعد الهُمامِ هُمامُ",41,"م",1,0],["إن يخالط غيره اشتغلت","فكرة منه فتنضغط",42,"ط",1,0],["أُنيخَ مَسحولٌ مَعَ الصُبّارِ","مَلالَةَ المَأسورِ للاِسارِ",43,"ر",1,1],["أُنِيخَت بِجَوٍّ يَصرُخُ الدِّيكُ عِندَها","وَباتَت بِقَاعٍ كادِئِ النَّبتِ سَملَقِ",44,"ق",1,0],["إنْ يخفقِ القلبُ بالنَّجوى يساعِفُهُ","بما هو الخيرُ في أَصْفى تَجَلِّيهِ",45,"ي",2,0],["أَنيخُوا فَمَا بَالُ الرّكُوبِ وَإِنَّها","عَلى الرَّأْسِ تَمْشِي أَوْ عَلَى العَيْنِ تَشْخصُ",46,"ص",1,0]]}