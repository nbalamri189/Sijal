{"poems":[[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[24,"وهاجِرة ٍ لا تَسْتَرِيدُ ظِباؤها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10884&r=&rc=25",""],[119,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[435,"يا ذا الخليل الذي في قوله ثقة","https://www.aldiwan.net/poem40862.html","البسيط"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[568,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38936","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96358","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59431","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108637","الوافر"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52043","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126225","الرمل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140046",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140068",""],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9610","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5695,"وداع صهر..","https://www.poetsgate.com/ViewPoem.aspx?id=212543",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""]],"verses":[["وَأَمَّ بِها ماءَ الرَسيسِ فَصَوَّبَت","لِلَينَةَ وَاِنقَضَّ النُجومُ القَوائِمُ",0,"م",1,0],["وَأَمَّ بِالخَيلِ سيفَ البَحرِ مُعتَزِماً","أَبُو عُبَيدَةَ في صُيّابَةٍ حُشُمِ",1,"م",1,0],["وأمّ بها ماء الرّسيسِ فصوّبت","لِلِينَة َ وانْقَضَّ النُّجُومُ العَوَائِمُ",2,"م",1,0],["وام بامر المصطفى الناس وهو قد","رأه وقد ناداه من داخل الستر",3,"ر",1,0],["وأمّ بيتاً لدين المجد منتهضاً","في خير مولى شدت في فضله الأمم",4,"م",1,0],["وأمّ بنينَ استبطنتْهم فصدرُها","غصيصٌ بهم عند الحِضانِ كظيمُ",5,"م",1,0],["وَأُمَّ بِساطَ اِبنِ الشَريفِ مُحَمَّدٍ","مُبيدِ العِدا ذِكراً وَمُبدي الهُدى صُبحا",6,"ح",2,0],["وَأُمَّ بِها رَبع الحِسانِ مِنَ الظّبا","فَفيه لِغزلانِ المِلاحِ مَكانسُ",7,"س",1,0],["وأمَّ بني بَدر فلا تَنسيَنَّها","وبَدراً أبا تلك النجوم الخَضارمِ",8,"م",1,0],["وأم بأملاك الإله ورسله","لدى مشهد جم كريم مؤنس",9,"س",1,0],["وأم بالرسل والأملاك قاطبة","في مشهد فيه تكريم وتبجيل",10,"ل",1,0],["وأم بالرسل والأملاك ثم رقى","مرقى له العز والتأييد مرقاة",11,"ه",1,0],["وأم بالرسل والأملاك قاطبة","في محفل لم يكن إلا له رسا",12,"س",2,0],["وأمَّ بنا وقد قمنا نشاوى","نسير لجامع اللهو الكبير",13,"ر",1,0],["وَأمَّ بِكَ المَشَاهِدَ حِينَ لاَحَتْ","عَلَيِكَ لَهُ أمَارَاتُ السَّعِيدِ",14,"د",1,0],["وامَبِيتِى فى مَسَاءٍ وغُدُو","بإنخِفَاضٍ وإرتقاءِ فى عُلو",15,"و",1,1],["وأم بالرسل والأملاك كلهم","وبالمسيح وموسى ثم هارون",16,"ن",1,0],["وأم بالأملاك من بعد ما","بالانبيا صلى بهم ثله",17,"ل",2,0],["وَأُمُّ بَحيرٍ في تَمارُسِ بَينِنا","مَتى تَأتِها الأَنباءُ تَخمِش وَتَحلِقِ",18,"ق",1,0],["وَأم بِهَا اعطِف إثرَ هَمزِ التَّسوِيَه","أو هَمزَةٍ عَن لَفظِ أيٍّ مُغنِيَه",19,"ه",1,0],["وَإِمبريوسُ الأَياسانِ سارا","بِهِ يَقدَحانِ اِحتِداماً شِرارا",20,"ر",2,0],["وأمّ بالرسل والملائك والكل","أقرّوا بفضله علنا",21,"ن",2,0],["وأم به مصراً فراح عزيزها","به رغباً يعطى الرغائب لا حتما",22,"م",2,0],["وأم بأمر الله تلقاء طيبة","مهاجدره يبغى بني قبله الشما",22,"م",2,0],["وأمّ بناتك بعدك حصنٌ","كأنْ بعدها لم يضمَّك لحدُ !",23,"د",1,0],["وامبسمت الزهر والافلاك عابسة","حزناص عليها وعين البدر في سهر",24,"ر",1,0]]}