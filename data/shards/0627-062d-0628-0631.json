{"poems":[[37,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[74,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[154,"صبوت إلى الدنيا وذو اللب لا يصبوا","https://www.aldiwan.net/poem68604.html","الطويل"],[199,"أتعرف بالصحراء شرقي شابك","https://www.aldiwan.net/poem54400.html","الطويل"],[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59429","البسيط"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102359","المتقارب"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139979","الطويل"],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5390,"كَبِيرٌ بعَيْنَيَّاسْمُكَ يَا وَطنِي","https://www.poetsgate.com/ViewPoem.aspx?id=215720",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""]],"verses":[["أُحَبِّر لَهُ قَولاً تَناشَدُ شِعرَهُ","إِذا ما اِلتَقَت بَينَ الجِبالِ القَبائِلِ",0,"ل",1,0],["أحبر في مدح الإمام محمدٍ","من اللفظ أبهى الروضتين وأبهجا",1,"ج",2,0],["أُحِبُّ رَسولَ اللَهِ حُبَّ مُوَحِدٍّ","وَأَمدَحُهُ بِالحَقِّ غَيرَ مُفَنَّدٍ",2,"د",1,0],["أُحَبِّرُ قَولاً لَن يُحَبَّرَ مِثلُهُ","لَهُ صاحِبُ غَيري وَلَو كانَ مَغرِبا",3,"ب",2,0],["أحبُّ رمحَ القوام عن ثقةٍ","أني بهِ إن حييتُ مقتولُ",4,"ل",1,0],["أحبر المدح في خيز الكرام عسى","ألقى به الفوز من هول المصيبات",5,"ت",1,0],["أحبَّ رضاكن وإن لم تُثبني","به وتثبت سلطانكا",6,"ك",2,0],["أحبُّ رسول الله حباً لو انه","تقاسمه جيل كفتهم قسائمه",7,"م",2,0],["أحْبرْتَ قوماً وقد عادوا بمثْوَبَةٍ","وعادَ من كان أمساً غيرَ مبتسمِ",8,"م",1,0],["أحِبُّ رُبَى شنقيطَ حُبًّامُجَذَّراً","ولاأعْرِفُ الأسبابَ إنِّي أَسِيرُها",9,"ر",3,0],["أحب روس القوم وأقدّرهم","مير اللحى من دونها الأشنابي",10,"ب",2,0],["أحب ركوب السفينة صُبْحاً","فركب السفينة أحلى خطَرْ",11,"ر",1,0]]}