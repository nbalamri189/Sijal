//www.aldiwan.net/poem64853.html","الخفيف"],[50,"يا طيب عبدة ويلي منك يا طيبي","https://www.aldiwan.net/poem64854.html","البسيط"],[46,"اعمل لأخراك شروى من يموت غدا","https://www.aldiwan.net/poem23054.html","البسيط"],[46,"للخير منزلتان عند معاشر","https://www.aldiwan.net/poem23251.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16622","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[122,"علمك بعمان قرية","https://www.aldiwan.net/poem23740.html","البسيط"],[130,"بلغ سلامى إذا جئت البتول لها","https://www.aldiwan.net/poem54771.html","البسيط"],[158,"العلم بالإجماع معدنه ذهب","https://www.aldiwan.net/poem58716.html","الطويل"],[162,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[164,"لا تنكري يا عز إن ذل الفتى","https://www.aldiwan.net/poem47081.html","الكامل"],[197,"تعد الملاح وأهون الأشياء","https://www.aldiwan.net/poem45179.html","مجزوء الكامل"],[221,"هذي الروائع من ذاك اللظى خلق","https://www.aldiwan.net/poem39686.html","البسيط"],[227,"إن الأمير المعلى في معاليه","https://www.aldiwan.net/poem51407.html","البسيط"],[248,"ما بلغ الله حسادي الذي طلبوا","https://www.aldiwan.net/poem14923.html","البسيط"],[257,"يا من يغيث الورى من بعد ما قنطوا","https://www.aldiwan.net/poem35529.html","البسيط"],[260,"إني أعوذ بروح أن يقدمني","https://www.aldiwan.net/poem68216.html","البسيط"],[268,"قلبي كنجمي قد أنار أو التظى","https://www.aldiwan.net/poem35060.html","الكامل"],[268,"أو لم تري يده على أحشائه","https://www.aldiwan.net/poem35401.html","الكامل"],[268,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[273,"إن البشائر كلها جمعت","https://www.aldiwan.net/poem25518.html","أحذ الكامل"],[303,"سيان أن لبس التجمل أو عري","https://www.aldiwan.net/poem56550.html","الكامل"],[320,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[364,"إن البنان الخمس أكافاء معا","https://www.aldiwan.net/poem17693.html","الكامل"],[374,"إن البتولة مريما قد كللت","https://www.aldiwan.net/poem59179.html","الكامل"],[374,"نار تثير على الضلوع وطيسا","https://www.aldiwan.net/poem59384.html","الكامل"],[388,"فاز المخفون في اليوم العظيم الطويل","https://www.aldiwan.net/poem54542.html","عموديه"],[413,"عفت أرسم من دار مي وأطلال","https://www.aldiwan.net/poem53921.html","الطويل"],[413,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[418,"يا من بغيث الورى من بعد ما قنطوا","https://www.aldiwan.net/poem46386.html","البسيط"],[426,"قمر بأفلاك الخدورِ","https://www.aldiwan.net/poem40082.html","مجزوء الكامل"],[426,"للصيد فضل لدى أهل العلى ظهرا","https://www.aldiwan.net/poem40507.html","البسيط"],[426,"إن البشير شهاب سعد زماننا","https://www.aldiwan.net/poem40821.html","الكامل"],[426,"إن البشير الذي جاد الزمان به","https://www.aldiwan.net/poem41435.html","البسيط"],[429,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[438,"وهبتك النصح لو طاوعت من نصحا","https://www.aldiwan.net/poem14423.html","البسيط"],[438,"هجيت ما بي وقد كشفت مكنوني","https://www.aldiwan.net/poem14489.html","البسيط"],[441,"بحق من يا منيتي","https://www.aldiwan.net/poem56010.html","عموديه"],[446,"وما جرى من دمعه الاّ الذي","https://www.aldiwan.net/poem53780.html","الرجز"],[451,"الموحيات حيالي لا عداد لها","https://www.aldiwan.net/poem61582.html","البسيط"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[459,"العين تبدي الذي في قلب صاحبها","https://www.aldiwan.net/poem16446.html","البسيط"],[498,"تهادت العيس ليلا","https://www.aldiwan.net/poem37778.html","المجتث"],[498,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[503,"الإنسان","https://www.aldiwan.net/poem61093.html","البسيط"],[549,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[549,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"]],"verses":[["إِنَّ البَخيلَ الَّذي قَد باتَ يُؤنِسُني","مِثلُ الجَوادِ الَّذي قَد باتَ يَمطُلُني",0,"ن",2,0],["إِنَّ البَهيمَ إِذا مَسَّحتَ جَبهَتَهُ","فَالحُكمُ أَن تُلطَمَ الأَوضاحُ وَالغُرَرُ",1,"ر",1,0],["إِنَّ البُكاءَ عَلَيكَ فَرضٌ واجِبٌ","وَالعَيشُ لا يُبكى عَلَيهِ رِياءَ",2,"ا",2,0],["إِنَّ البَلِيَّةَ أَن تُباعَ وَتُشتَرى","مِصرٌ وَما فيها وَأَلّا تَنطِقا",3,"ق",2,0],["إِنَّ البِلادَ الَّتِي وَلَّتْكَ سُدَّتَهَا","لَهَا هَوَى مِصْرَ فِي سِرٍّ وَإِعْلانِ",4,"ن",1,0],["إن البدور لتيجانٌ مُكَّلَلة","جواهرُ الشهب في أبهى مجاليها",5,"ي",3,0],["أن البلاد إذا تخاذل أهلها","كانت منافعها هي الآفات",6,"ت",1,0],["إِنَّ البَعيثَ وَعَبدَ آلِ مُقاعِسٍ","لا يَقرَآنِ بِسورَةِ الأَحبارِ",7,"ر",1,0],["إِنَّ البَرِيَّةَ تَرضى ما رَضيتَ لَها","إِن سِرتَ ساروا وَإِن قُلتَ اِربَعوا رَبَعوا",8,"ع",3,0],["إِنَّ البَلِيَّةَ مَن يُمَلُّ حَديثُهُ","فَاِنشَح فُؤادَكَ مِن حَديثِ الوامِقِ",9,"ق",1,0],["إِنَّ البَغيضَ لَهُ مَنازِلُ عِندَنا","لَيسَت كَمَنزِلَةِ المُحِبِّ المُكرَمِ",10,"م",1,0],["إِنَّ البَخيلَ إِذا ما ماتَ يَتبَعُهُ","سوءُ الثَناءِ وَيَحوي الوارِثُ الإِبِلا",11,"ل",2,0],["إن البراغيث قد باتت تشيبني","فبتُّ أحيي الدجى نسكاً وإيمانا",12,"ن",2,1],["إنَّ البخيل ميتٌ بدائِهِ","وأمرُهُ كلٌّ إلى ورائِهِ",13,"ا",3,0],["إن البلاء يطاق غير مضاعَفٍ","فإذا تضاعف كان غير مطاق",14,"ق",1,0],["إن البناءَ متى مادتْ قواعدُهُ","مالَ البناءُ ولن يبقى إذا مالا",15,"ل",2,0],["إِنَّ البُكاءَ مِنَ الرِجالِ مُذَمَّمٌ","إِلّا عَلَيكَ فَتَركُهُ لا يُشكَرُ",16,"ر",1,0],["إِنّا لِبُعدِكَ عَنّا","في وَحشَةٍ وَكَآبَه",17,"ب",2,0],["ان البوار جزاء من","يخشى من الجبن البوارا",18,"ر",2,0],["إن البقاء طويلا","على الشقاء علامه",19,"م",2,0],["أن البلاد لتشتكي من أهلها","وتقول قول الرازح المجهود",20,"د",1,0],["إن البلاد لها غد","يرجى فكن غدها الأغرّا",21,"ر",2,0],["إن البكى فاسترح إليه","يصرف للراحة العناء",22,"ا",2,0],["إن البلابل ما تشدو يهيم بها","قلب المحب فيجرى الدمع هتّانا",23,"ن",2,0],["إِنَّ البُطولَةَ أَن تَموتَ مِن الظَما","لَيسَ البُطولَةُ أَن تَعُبَّ الماءَ",24,"ا",2,0],["إِنَّ البَناتَ ذَخائِرٌ مِن رَحمَةٍ","وَكُنوزُ حُبٍّ صادِقٍ وَوَفاءِ",25,"ا",2,0],["إِنَّ البَيانَ وَإِنَّ حُس","نَ العَقلِ ما زالا مَتاعَك",26,"ك",1,0],["إِنَّ البَنانَ الَّذي تُقَلِّبُهُ","عِندَكَ في كُلِّ مَوضِعٍ مَثَلُ",27,"ل",1,0],["إنَّ البرامكةَ الأُلى سَنُّوا الندى","بين الأنامِ فمحسنٌ أو منعِمُ",28,"م",1,1],["إِنَّ البَقِيَّةَ مِن خَراجي قَدرُها","ما إِن يَكونُ لَدَيكَ قَدرَ غَداءِ",29,"ا",2,0],["إِنَّ البُكاءَ عَلى الماضينَ مَكرُمَةٌ","لَو كانَ ماضٍ إِذا بَكَّيتَهُ رَجَعا",30,"ع",2,0],["إِنَّ البَخيلَةَ لَم تُنعِم لِسائِلِها","يَومَ الكَثيبِ وَلَم تَسمَع لِداعيها",31,"ي",3,0],["إِنَّ البَكارَةَ لا يَدَي لِصِغارِها","بِزِحامِ أَصيَدَ رَأسُهُ هَدّارِ",32,"ر",1,0],["إن أُلبِسَتْ تُزْهى بك الدُّنيا فقد","أصبحْتَ للدُّنيا شِهاباً واقِدا",33,"د",2,0],["إِنَّ البَخيلَ مَلومٌ حَيثُ كانَ وَلَ","كِنَّ الجَوادَ عَلى عِلّاتِهِ هَرِمُ",34,"م",1,0],["إِنَّ البَخيلَ وَإِن أَفادَ غِنىً","لَتَرى عَلَيهِ مَخايِلَ الفَقرِ",35,"ر",1,1],["إِنَّ البَسيطَ لَدَيهِ يُبسَطُ الأَمَلُ","مُستَفعِلُن فاعِلُن مُستَفعِلُن فَعِلُ",36,"ل",1,0],["إِنَّ البَخَيري مُذ فارَقتُموهُ غَدا","يَسفي الرَمادَ عَلى كانونِهِ الحَرِبِ",37,"ب",1,1],["إِنَّ البُحيرَةَ زانَ بَهجَتَها","مَلِكٌ بِها أَفديهِ مِن مَلِكِ",38,"ك",1,1],["إنّ البِلادَ إذا ما الخوْفُ أمْرَضَها","ففي أمانك من أمراضها نُشرُ",39,"ر",1,0],["إِنَّ البِلادَ إِذا السُيولُ تَعاوَدَت","ساحاتِها غَمَرَ الفَضاءَ نَباتُها",40,"ت",3,0],["إنّ البناءَ إذا تَماسَكَ فَاسْتَوَى","لم يضطرِبْ ضَعفاً ولم يَتَهَدَّمِ",41,"م",1,0],["إِنَّ البِلادَ لَها حُقوقٌ جَمَّةٌ","ما لِاِمرِئٍ مِنها وَلا لَكَ مَهرَبُ",42,"ب",1,0],["إنّ البلادَ بلادُكم فإذا انثنت","ومَضى البلاءُ فلن تُصيبوا واقيا",43,"ي",2,0],["إِن البِلاد كَريمة يا لَيتَها","ضَنت عَلى من عقها بِالمدفن",44,"ن",1,0],["إِنَّ البَلِيَّةَ سَدَّت","عَلَيَّ طُرقَ المَذاهِب",45,"ب",1,1],["إِنَّ البَرامِكَةَ الَّذينَ تَعَلَّموا","فِعلَ المُلوكِ فَعَلَّموهُ الناسا",46,"س",2,1],["إِنَّ البَخيلَةَ لَو يَميلُ بِها الصِبى","كَالقِنوِ مالَ عَلى أَبي الدَحداحِ",47,"ح",1,0],["إِنَّ البَغيضَ إِلَينا لا نُطالِبُهُ","يَتَجَلّى عَن باطِلٍ مَكذوبِ",48,"ب",1,0],["إِنَّ البَغيضَ إِلَينا لا نُطالِبُهُ","ذاكَ الهَوى وَحَبيبٌ كُلُّ مَطلوبِ",49,"ب",1,0],["إِنَّ البَهائِمَ مِثلَ الإِنسِ غافِلَةٌ","وَإِنَّما نَحنُ بُهمٌ ذاتُ أَرباقِ",50,"ق",1,0],["إِنَّ البَعوضَةَ مِن تُقىً مَوزونَةٌ","بِالفيلِ عِندَ مَليكِها وَالبازِلِ",51,"ل",1,0],["إن البلابل بالأدواح مولعة","وَزينة الدوح أَوراق وأَفنان",52,"ن",1,0],["إنّ البخيلَ إذا يُمَدّ له المَدَى","في الجُودِ هانَ عليه وَعْدُ السائلِ",53,"ل",1,0],["إِنَّ البِلاَدَ أَبا عَلِيٍّ كَابَدَتْ","وَجْداً عَلَيْكَ حَرَارَةَ البُرَحَاءِ",54,"ا",2,0],["إنّ البطولةَ والأجسادُ فانيةٌ","تبقَى على الدهر في بعثٍ وتجديد",55,"د",1,0],["ان البلادَ بمرصاد ومن سَفهٍ","ان تحسبوا الناسَ طراً لعبةً لكُم",56,"م",1,0],["إن البذور تُعقِبُ الحصائدا","وكنتُ لا أكذب أهلي رائدا",57,"د",2,0],["إن البراطيل قدماً خربت جرشاً","والحاكم الفذ لكام لشانيه",58,"ه",1,0],["إِنَّ البَتُولَ لَهَا في القَلبِ مَنزِلَةً","مَن حَلَّها قَبلَهَا مَا حَلَّ مَنزِلَهَا",59,"ل",3,0],["إن البكا منا عليك لواجبٌ","وعلى سواك بغير ندب مستحب",60,"ب",1,0],["إِنَّ البَلِيَّةَ لا وَفرٌ تُزَعزِعُهُ","أَيدي الحَوادِثِ تَشتيتاً وَتَشذيبا",61,"ب",2,0],["إنَّ البُزاةَ رؤوسُهُنَّ عواطل","والتاجُ معقودٌ برأسِ الهُدهدِ",62,"د",1,0],["إنَّ البخيلَ على غنا","هُ يعيشُ بالبخلِ سعيدا",63,"د",2,0],["إِنَّ البَقاءَ عَلى الإيمانِ مُرتَكِزٌ","الأَقوِياءُ مَضَوا وَالمُؤمِنونَ بَقوا",64,"ق",3,0],["إن البِناءَ إذا ما انهدَّ جانبُه","لم يأمَنِ الناسُ أن يَنهدَّ باقِيه",65,"ي",2,0],["إن البرامكة الماضين ما افتخُروا","إلا بأيسَرِ ما تُعطى وما تَهَبُ",66,"ب",1,0],["إنّ البهائم أضحى الترب مرتعها","ومنه مربعها لا الأثل والخمط",67,"ط",1,0],["إنّ البِرَازَ إلى الأقرَانِ أعلَمُهُ","مِمَّا يُفرِّقُ بَينَ الرُّوحِ والجَسَدِ",68,"د",1,0],["إنّ البيانَ مُقصِّرٌ عن خَفقِهِ","فأبى اللسانُ لِذاكَ أن يتلفَّظا",69,"ظ",2,0],["إن البلاءَ من المحبَّةِ أصلُهُ","فبلاءُ آدمَ كانَ من حوّائه",70,"ا",3,0],["إنّ البسالةَ بالسلاحِ صلاحُها","وبدونه لا تستعزُّ وتجسر",71,"ر",1,0],["إنَّ البَشَائِرَ كُلَّها جُمِعَتْ","للدِّينِ والدّنيا ولِلأُمَمِ",72,"م",1,1],["إنّ البطالةَ وهيَ حرمانُ الفتى","تُغري الفَتى بالإِمتراءِ فَيَمتري",73,"ر",2,0],["إِنَّ البَوارِحَ لا يَحبِسنَ رِحلَتَهُ","وَلا يَعوجُ بِأَصواتِ الغَرابيبِ",74,"ب",1,0],["إِنَّ البَنانَ الخَمسَ أَكافاءٌ مَعاً","وَالحَلى دونَ جَميعِها لِلخِنصَرِ",75,"ر",1,1],["إن البتولة مريماً قد كُلِّلت","من ربها في عرشه من غير لوْ",76,"و",1,1],["إن البلايا للنفوس مناهلٌ","تجلو الصدا فتفرُّ من إبليسا",77,"س",2,0],["إن البطاله هي أرداخلة في الخليل","طوبى لمن كان شغله كل فعل جميل",78,"ل",1,0],["أنالُ بك الآمال وهي بعيدة","وأفتَحُ أبواباً عَليهنَّ أقفال",79,"ل",1,0],["أنال به الثواب بغير شكٍّ","وأمحو بالثناء عليك إثما",80,"م",2,0],["إنَّ البهائمَ أضحى التربُ مرتعها","والطيرَ تغدو من الحصباء تلتقطُ",81,"ط",1,0],["إن البلاغة والبراعة","عند داود الوزيرِ",82,"ر",1,0],["إن البزاة التي حبي بها اشتهرا","سباع جوٍّ ويهواها سباع ورى",83,"ر",2,0],["إن البشير شهاب سعد زماننا","أحيى الربى بسحا بكف يهتنُ",84,"ن",1,1],["إن البشير الذي جاد الزمان به","قد ساد بالمجد والإفضال واللطف",85,"ف",1,1],["أنالُ به ما شئتُ غيرَ مُمانعٍ","على أنني ما شئتُ غيرُ ممنّعِ",86,"ع",1,0],["إِن البضاعة لم تُجلب لموسمها","إِلا لانفاقها أَو ربُّها ربحا",87,"ح",2,0],["إن البكاء لمأمون على مقلي","غدا وسلوان قلبي غير مأمون",88,"ن",1,0],["إن البكا يشغلني","في يقظتي عن نظرتي",89,"ي",1,0],["ان البكاء ما دموعه","ثم يفيض بعده نجيعه",90,"ع",2,0],["إن البعوضة قد توحي بنشوتها","لما تغنت فتونا من صباباتي",91,"ت",2,0],["إن البطينَ مخمِصٌ","فاشبع ذليلاً أوجُعِ",92,"ع",1,0],["إنَّ البَغيضَ لهُ عينٌ تُكَشِّفُهُ","لا تَسْتطيعُ لما في القلْبِ كِتْمانا",93,"ن",2,0],["إِنَّ البُكاءَ لَعَمْري","على المُحِبِّ عَلامَهْ",94,"م",2,0],["إنَّ البراهينَّ لا تَخْفى على دَرِبٍ","إنْ لم يُخَطِّئْهُ في مَسراه أقْذاءُ",95,"ا",2,0],["إنّ البلايا بناتُ الدّهرِ هنّ لهُ","علىْ بني البشرِ النّصيرُ والسّندُ",96,"د",1,0],["إنَّ البَهيم من الشّباب ألَذُّ لِي","فلتَعْدُني أوضاحُهُ وحُجولُهُ",97,"ل",2,0],["أَنالُ بِهِ فائِتاتِ الوُحوش","وَأَلمسُ مِن صَفحَتيه السُّها",98,"ا",1,0]]}