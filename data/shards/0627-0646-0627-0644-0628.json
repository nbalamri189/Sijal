291,"","https://poetry.dctabudhabi.ae/diwan/poem/106691","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97984","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146487","الطويل"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124006","الكامل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99409","البسيط"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32376","الكامل"],[3605,"","https://poetry.dctabudhabi.ae/diwan/poem/130569","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109926","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206137","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85120","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114311","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135500","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111483","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70163","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70155","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75688","الكامل"],[4218,"","https://poetry.dctabudhabi.ae/diwan/poem/143427","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45033","الكامل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81698","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81686","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198189","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139119","المجتث"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66113","البسيط"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107133","الكامل"],[416,"ان خلدت بعد الامام محمد","https://www.poetsgate.com/ViewPoem.aspx?id=12819",""],[4857,"قد قام الدين, قد قام الدين","https://www.poetsgate.com/ViewPoem.aspx?id=30118",""],[4858,"سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=34882",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[4935,"أضحى خطيب العلم فوق المنبر","https://www.poetsgate.com/ViewPoem.aspx?id=129451",""],[4955,"إن البلاء إذا ما حل ذا قدرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=191122",""],[5033,"قبضةٌ من أثر الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=207615",""],[585,"مهلاً وبعض اللوم والتفنيد","https://www.poetsgate.com/ViewPoem.aspx?id=161943",""],[5121,"كِلَاهُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=214740",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[5219,"ما حيلتي","https://www.poetsgate.com/ViewPoem.aspx?id=194917",""],[5219,"كن عاقلا ....","https://www.poetsgate.com/ViewPoem.aspx?id=195013",""],[5277,"رسالة منها...","https://www.poetsgate.com/ViewPoem.aspx?id=190741",""],[5284,"جارتا النهرين","https://www.poetsgate.com/ViewPoem.aspx?id=191795",""],[5296,"أماه لا تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=152482",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5353,"رئة من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=212242",""],[5358,"ساعات تحت النار","https://www.poetsgate.com/ViewPoem.aspx?id=21892",""],[5409,"حياك وادي الرافدين وما به","https://www.poetsgate.com/ViewPoem.aspx?id=155250",""],[5542,"من أعماق القلب","https://www.poetsgate.com/ViewPoem.aspx?id=10052",""],[5605,"البحر والموج","https://www.poetsgate.com/ViewPoem.aspx?id=160692",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5736,"الشبل في بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=208184",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5776,"الفجر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=199936",""],[5873,"المجالدة على الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=215413",""],[5956,"سلبيّات الحب","https://www.poetsgate.com/ViewPoem.aspx?id=184230",""],[5992,"إنّ البرامكة الذين تقدّموا","https://www.poetsgate.com/ViewPoem.aspx?id=41849",""],[6093,"إن البيوت التي سكانها رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=208772",""],[6097,"الباب يشهد...","https://www.poetsgate.com/ViewPoem.aspx?id=192045",""],[6277,"ازعق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64492&r=&rc=55",""]],"verses":[["إِنَّ البَخيلَ الَّذي قَد باتَ يُؤنِسُني","مِثلُ الجَوادِ الَّذي قَد باتَ يَمطُلُني",0,"ن",2,0],["إِنَّ البَهيمَ إِذا مَسَّحتَ جَبهَتَهُ","فَالحُكمُ أَن تُلطَمَ الأَوضاحُ وَالغُرَرُ",1,"ر",1,0],["إِنَّ البُكاءَ عَلَيكَ فَرضٌ واجِبٌ","وَالعَيشُ لا يُبكى عَلَيهِ رِياءَ",2,"ا",2,0],["إِنَّ البَلِيَّةَ أَن تُباعَ وَتُشتَرى","مِصرٌ وَما فيها وَأَلّا تَنطِقا",3,"ق",2,0],["إِنَّ البِلادَ الَّتِي وَلَّتْكَ سُدَّتَهَا","لَهَا هَوَى مِصْرَ فِي سِرٍّ وَإِعْلانِ",4,"ن",1,0],["إن البدور لتيجانٌ مُكَّلَلة","جواهرُ الشهب في أبهى مجاليها",5,"ي",3,0],["أن البلاد إذا تخاذل أهلها","كانت منافعها هي الآفات",6,"ت",1,0],["إِنَّ البَعيثَ وَعَبدَ آلِ مُقاعِسٍ","لا يَقرَآنِ بِسورَةِ الأَحبارِ",7,"ر",1,0],["إِنَّ البَرِيَّةَ تَرضى ما رَضيتَ لَها","إِن سِرتَ ساروا وَإِن قُلتَ اِربَعوا رَبَعوا",8,"ع",3,0],["إِنَّ البَلِيَّةَ مَن يُمَلُّ حَديثُهُ","فَاِنشَح فُؤادَكَ مِن حَديثِ الوامِقِ",9,"ق",1,0],["إِنَّ البَغيضَ لَهُ مَنازِلُ عِندَنا","لَيسَت كَمَنزِلَةِ المُحِبِّ المُكرَمِ",10,"م",1,0],["إِنَّ البَخيلَ إِذا ما ماتَ يَتبَعُهُ","سوءُ الثَناءِ وَيَحوي الوارِثُ الإِبِلا",11,"ل",2,0],["إن البراغيث قد باتت تشيبني","فبتُّ أحيي الدجى نسكاً وإيمانا",12,"ن",2,1],["إنَّ البخيل ميتٌ بدائِهِ","وأمرُهُ كلٌّ إلى ورائِهِ",13,"ا",3,0],["إن البلاء يطاق غير مضاعَفٍ","فإذا تضاعف كان غير مطاق",14,"ق",1,0],["إن البناءَ متى مادتْ قواعدُهُ","مالَ البناءُ ولن يبقى إذا مالا",15,"ل",2,0],["إِنَّ البُكاءَ مِنَ الرِجالِ مُذَمَّمٌ","إِلّا عَلَيكَ فَتَركُهُ لا يُشكَرُ",16,"ر",1,0],["إِنّا لِبُعدِكَ عَنّا","في وَحشَةٍ وَكَآبَه",17,"ب",2,0],["ان البوار جزاء من","يخشى من الجبن البوارا",18,"ر",2,0],["إن البقاء طويلا","على الشقاء علامه",19,"م",2,0],["أن البلاد لتشتكي من أهلها","وتقول قول الرازح المجهود",20,"د",1,0],["إن البلاد لها غد","يرجى فكن غدها الأغرّا",21,"ر",2,0],["إن البكى فاسترح إليه","يصرف للراحة العناء",22,"ا",2,0],["إن البلابل ما تشدو يهيم بها","قلب المحب فيجرى الدمع هتّانا",23,"ن",2,0],["إِنَّ البُطولَةَ أَن تَموتَ مِن الظَما","لَيسَ البُطولَةُ أَن تَعُبَّ الماءَ",24,"ا",2,0],["إِنَّ البَناتَ ذَخائِرٌ مِن رَحمَةٍ","وَكُنوزُ حُبٍّ صادِقٍ وَوَفاءِ",25,"ا",2,0],["إِنَّ البَيانَ وَإِنَّ حُس","نَ العَقلِ ما زالا مَتاعَك",26,"ك",1,0],["إِنَّ البَنانَ الَّذي تُقَلِّبُهُ","عِندَكَ في كُلِّ مَوضِعٍ مَثَلُ",27,"ل",1,0],["إنَّ البرامكةَ الأُلى سَنُّوا الندى","بين الأنامِ فمحسنٌ أو منعِمُ",28,"م",1,1],["إِنَّ البَقِيَّةَ مِن خَراجي قَدرُها","ما إِن يَكونُ لَدَيكَ قَدرَ غَداءِ",29,"ا",2,0],["إِنَّ البُكاءَ عَلى الماضينَ مَكرُمَةٌ","لَو كانَ ماضٍ إِذا بَكَّيتَهُ رَجَعا",30,"ع",2,0],["إِنَّ البَخيلَةَ لَم تُنعِم لِسائِلِها","يَومَ الكَثيبِ وَلَم تَسمَع لِداعيها",31,"ي",3,0],["إِنَّ البَكارَةَ لا يَدَي لِصِغارِها","بِزِحامِ أَصيَدَ رَأسُهُ هَدّارِ",32,"ر",1,0],["إن أُلبِسَتْ تُزْهى بك الدُّنيا فقد","أصبحْتَ للدُّنيا شِهاباً واقِدا",33,"د",2,0],["إِنَّ البَخيلَ مَلومٌ حَيثُ كانَ وَلَ","كِنَّ الجَوادَ عَلى عِلّاتِهِ هَرِمُ",34,"م",1,0],["إِنَّ البَخيلَ وَإِن أَفادَ غِنىً","لَتَرى عَلَيهِ مَخايِلَ الفَقرِ",35,"ر",1,1],["إِنَّ البَسيطَ لَدَيهِ يُبسَطُ الأَمَلُ","مُستَفعِلُن فاعِلُن مُستَفعِلُن فَعِلُ",36,"ل",1,0],["إِنَّ البَخَيري مُذ فارَقتُموهُ غَدا","يَسفي الرَمادَ عَلى كانونِهِ الحَرِبِ",37,"ب",1,1],["إِنَّ البُحيرَةَ زانَ بَهجَتَها","مَلِكٌ بِها أَفديهِ مِن مَلِكِ",38,"ك",1,1],["إنّ البِلادَ إذا ما الخوْفُ أمْرَضَها","ففي أمانك من أمراضها نُشرُ",39,"ر",1,0],["إِنَّ البِلادَ إِذا السُيولُ تَعاوَدَت","ساحاتِها غَمَرَ الفَضاءَ نَباتُها",40,"ت",3,0],["إنّ البناءَ إذا تَماسَكَ فَاسْتَوَى","لم يضطرِبْ ضَعفاً ولم يَتَهَدَّمِ",41,"م",1,0],["إِنَّ البِلادَ لَها حُقوقٌ جَمَّةٌ","ما لِاِمرِئٍ مِنها وَلا لَكَ مَهرَبُ",42,"ب",1,0],["إنّ البلادَ بلادُكم فإذا انثنت","ومَضى البلاءُ فلن تُصيبوا واقيا",43,"ي",2,0],["إِن البِلاد كَريمة يا لَيتَها","ضَنت عَلى من عقها بِالمدفن",44,"ن",1,0],["إِنَّ البَلِيَّةَ سَدَّت","عَلَيَّ طُرقَ المَذاهِب",45,"ب",1,1],["إِنَّ البَرامِكَةَ الَّذينَ تَعَلَّموا","فِعلَ المُلوكِ فَعَلَّموهُ الناسا",46,"س",2,1],["إِنَّ البَخيلَةَ لَو يَميلُ بِها الصِبى","كَالقِنوِ مالَ عَلى أَبي الدَحداحِ",47,"ح",1,0],["إِنَّ البَغيضَ إِلَينا لا نُطالِبُهُ","يَتَجَلّى عَن باطِلٍ مَكذوبِ",48,"ب",1,0],["إِنَّ البَغيضَ إِلَينا لا نُطالِبُهُ","ذاكَ الهَوى وَحَبيبٌ كُلُّ مَطلوبِ",49,"ب",1,0],["إِنَّ البَهائِمَ مِثلَ الإِنسِ غافِلَةٌ","وَإِنَّما نَحنُ بُهمٌ ذاتُ أَرباقِ",50,"ق",1,0],["إِنَّ البَعوضَةَ مِن تُقىً مَوزونَةٌ","بِالفيلِ عِندَ مَليكِها وَالبازِلِ",51,"ل",1,0],["إن البلابل بالأدواح مولعة","وَزينة الدوح أَوراق وأَفنان",52,"ن",1,0],["إنّ البخيلَ إذا يُمَدّ له المَدَى","في الجُودِ هانَ عليه وَعْدُ السائلِ",53,"ل",1,0],["إِنَّ البِلاَدَ أَبا عَلِيٍّ كَابَدَتْ","وَجْداً عَلَيْكَ حَرَارَةَ البُرَحَاءِ",54,"ا",2,0],["إنّ البطولةَ والأجسادُ فانيةٌ","تبقَى على الدهر في بعثٍ وتجديد",55,"د",1,0],["ان البلادَ بمرصاد ومن سَفهٍ","ان تحسبوا الناسَ طراً لعبةً لكُم",56,"م",1,0],["إن البذور تُعقِبُ الحصائدا","وكنتُ لا أكذب أهلي رائدا",57,"د",2,0],["إن البراطيل قدماً خربت جرشاً","والحاكم الفذ لكام لشانيه",58,"ه",1,0],["إِنَّ البَتُولَ لَهَا في القَلبِ مَنزِلَةً","مَن حَلَّها قَبلَهَا مَا حَلَّ مَنزِلَهَا",59,"ل",3,0],["إن البكا منا عليك لواجبٌ","وعلى سواك بغير ندب مستحب",60,"ب",1,0],["إِنَّ البَلِيَّةَ لا وَفرٌ تُزَعزِعُهُ","أَيدي الحَوادِثِ تَشتيتاً وَتَشذيبا",61,"ب",2,0],["إنَّ البُزاةَ رؤوسُهُنَّ عواطل","والتاجُ معقودٌ برأسِ الهُدهدِ",62,"د",1,0],["إنَّ البخيلَ على غنا","هُ يعيشُ بالبخلِ سعيدا",63,"د",2,0],["إِنَّ البَقاءَ عَلى الإيمانِ مُرتَكِزٌ","الأَقوِياءُ مَضَوا وَالمُؤمِنونَ بَقوا",64,"ق",3,0],["إن البِناءَ إذا ما انهدَّ جانبُه","لم يأمَنِ الناسُ أن يَنهدَّ باقِيه",65,"ي",2,0],["إن البرامكة الماضين ما افتخُروا","إلا بأيسَرِ ما تُعطى وما تَهَبُ",66,"ب",1,0],["إنّ البهائم أضحى الترب مرتعها","ومنه مربعها لا الأثل والخمط",67,"ط",1,0],["إنّ البِرَازَ إلى الأقرَانِ أعلَمُهُ","مِمَّا يُفرِّقُ بَينَ الرُّوحِ والجَسَدِ",68,"د",1,0],["إنّ البيانَ مُقصِّرٌ عن خَفقِهِ","فأبى اللسانُ لِذاكَ أن يتلفَّظا",69,"ظ",2,0],["إن البلاءَ من المحبَّةِ أصلُهُ","فبلاءُ آدمَ كانَ من حوّائه",70,"ا",3,0],["إنّ البسالةَ بالسلاحِ صلاحُها","وبدونه لا تستعزُّ وتجسر",71,"ر",1,0],["إنَّ البَشَائِرَ كُلَّها جُمِعَتْ","للدِّينِ والدّنيا ولِلأُمَمِ",72,"م",1,1],["إنّ البطالةَ وهيَ حرمانُ الفتى","تُغري الفَتى بالإِمتراءِ فَيَمتري",73,"ر",2,0],["إِنَّ البَوارِحَ لا يَحبِسنَ رِحلَتَهُ","وَلا يَعوجُ بِأَصواتِ الغَرابيبِ",74,"ب",1,0],["إِنَّ البَنانَ الخَمسَ أَكافاءٌ مَعاً","وَالحَلى دونَ جَميعِها لِلخِنصَرِ",75,"ر",1,1],["إن البتولة مريماً قد كُلِّلت","من ربها في عرشه من غير لوْ",76,"و",1,1],["إن البلايا للنفوس مناهلٌ","تجلو الصدا فتفرُّ من إبليسا",77,"س",2,0],["إن البطاله هي أرداخلة في الخليل","طوبى لمن كان شغله كل فعل جميل",78,"ل",1,0],["أنالُ بك الآمال وهي بعيدة","وأفتَحُ أبواباً عَليهنَّ أقفال",79,"ل",1,0],["أنال به الثواب بغير شكٍّ","وأمحو بالثناء عليك إثما",80,"م",2,0],["إنَّ البهائمَ أضحى التربُ مرتعها","والطيرَ تغدو من الحصباء تلتقطُ",81,"ط",1,0],["إن البلاغة والبراعة","عند داود الوزيرِ",82,"ر",1,0],["إن البزاة التي حبي بها اشتهرا","سباع جوٍّ ويهواها سباع ورى",83,"ر",2,0],["إن البشير شهاب سعد زماننا","أحيى الربى بسحا بكف يهتنُ",84,"ن",1,1],["إن البشير الذي جاد الزمان به","قد ساد بالمجد والإفضال واللطف",85,"ف",1,1],["أنالُ به ما شئتُ غيرَ مُمانعٍ","على أنني ما شئتُ غيرُ ممنّعِ",86,"ع",1,0],["إِن البضاعة لم تُجلب لموسمها","إِلا لانفاقها أَو ربُّها ربحا",87,"ح",2,0],["إن البكاء لمأمون على مقلي","غدا وسلوان قلبي غير مأمون",88,"ن",1,0],["إن البكا يشغلني","في يقظتي عن نظرتي",89,"ي",1,0],["ان البكاء ما دموعه","ثم يفيض بعده نجيعه",90,"ع",2,0],["إن البعوضة قد توحي بنشوتها","لما تغنت فتونا من صباباتي",91,"ت",2,0],["إن البطينَ مخمِصٌ","فاشبع ذليلاً أوجُعِ",92,"ع",1,0],["إنَّ البَغيضَ لهُ عينٌ تُكَشِّفُهُ","لا تَسْتطيعُ لما في القلْبِ كِتْمانا",93,"ن",2,0],["إِنَّ البُكاءَ لَعَمْري","على المُحِبِّ عَلامَهْ",94,"م",2,0],["إنَّ البراهينَّ لا تَخْفى على دَرِبٍ","إنْ لم يُخَطِّئْهُ في مَسراه أقْذاءُ",95,"ا",2,0],["إنّ البلايا بناتُ الدّهرِ هنّ لهُ","علىْ بني البشرِ النّصيرُ والسّندُ",96,"د",1,0],["إنَّ البَهيم من الشّباب ألَذُّ لِي","فلتَعْدُني أوضاحُهُ وحُجولُهُ",97,"ل",2,0],["أَنالُ بِهِ فائِتاتِ الوُحوش","وَأَلمسُ مِن صَفحَتيه السُّها",98,"ا",1,0],["إِنَّ البِلادَ سِوى بِلا","دِكَ ضاقَ عَرضُ فَضائِها",99,"ا",3,0],["إن البلاد بفضله","أضحى إرتقاها في مزيد",100,"د",1,0],["إن البكاء على الألى متن الخطا","ركبوا وما تابوا إلى التواب",101,"ب",1,0],["إن البرايا هم عدى من يرأسُ","لا تحفلنّ بهم إذاً يا بطرس",102,"س",1,1],["إن البلوك هو الذي أحسنته","أمن الشريط به أمانا أكبرا",103,"ر",2,0],["أن البغايا كل صقع قد عشت","مكشوفة الأعضاء دون حياء",104,"ا",2,0],["إن البلاءَ مُصيبٌ كُلَّ شيعتِهِ","فاصبِر ولا تك عند الهمِّ مِقْصافا",105,"ف",2,0],["إن البحار لقطرةٍ","من جود جعفره الغزير",106,"ر",1,0],["إن البلادَ كمن ولَّت شبيبتُه","وقلَّ مالاً ولم يَسطَع له سَبَبَا",107,"ب",2,0],["إنّ البيانَ المستحيلَ الرُّؤَى","مملوكُ فكرِ الأزرقِ الحافظِ",108,"ظ",1,1],["إِنَّ البَراغيثَ عَذابٌ مُزعِجُ","لِكُلِّ ما قَلبٍ وَجِلدٍ تُنضِجُ",109,"ج",1,0],["إن البلاد وأهلها بيدي إذا","كانت يدي لبني بلادي تشمل",110,"ل",1,0],["إن البلاد بلا استقلال صاحبها","قفر لديه وإن أصبحن جنات",111,"ت",1,0],["إن البراهين في أيد وألسنة","أقوى من الناب للضرغام والظفر",112,"ر",1,0],["إن البلى لمآلها ولو اَنَّها","في أبحر وكواكب وقصور",113,"ر",1,0],["إن البغاة على الخلافة أصبحوا","في ذمة الدستور غير بغاة",114,"ه",1,0],["إن البراعةَ أدنى ما وُصِفْتَ به","ولن يسودَ الفتى إِلا إذا برعا",115,"ع",2,0],["إِنّ البَرِيّة في يَدَيك زِمامُها","فَاِحذَر فديتُك أَن تَكون مُعَنّفا",116,"ف",2,0],["إن البيانَ هو البيانُ كلفظِه","فإذا جهلتَ فَكُفَّ عن تأويله",117,"ه",1,1],["إن البرية من عرب ومن عجم","لكم رياعا إذا ما أعطوا النصفا",118,"ف",2,0],["إن البخيل بفعله لمذمم","أبدا وإن محمدا لمحمدُ",119,"د",1,0],["إنّ البياضَ بياضُ الشَعرِ من لممي","يعلو بِسطرِ بياضٍ فيه مسطورِ",120,"ر",1,0],["إن البلاد علي وهي عريضةٌ","وعرت مذاهبها وسد المطلع",121,"ع",1,0],["إن البراء من الأعادي","للولاء لهم قرين",122