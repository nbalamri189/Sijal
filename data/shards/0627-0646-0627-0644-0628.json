ب",3,0],["إنَّ البطولة َ قول ٌ فيكَ نَخْلَصُهُ","لو قيلَ :بعضُ الذي قد قيلَ مُختَلقُ",228,"ق",1,0],["إنَّ البداية َ قد كانت نهايَتَنا","وفي النهايةِ يا شقراءُ نفترقُ",229,"ق",1,0],["إن البلاد وإن أضاع شقاقها","مجداً طواه الدهر في أحقابه",230,"ب",2,0],["إن البناء وإن تسامق واعتلى","ما لم يشيد بالتقى ينهار",231,"ر",1,0],["إن البكاء إذا ما طال معصية","فاستبشري إن نصر الله وافاني",232,"ن",2,0],["إنَّ البصيصَ أراهُ اليومَ مؤتِلقاً","كالشمسِ فوقَ المدى تَمضي وتَنتَشرُ",233,"ر",1,0],["أن البطولة لا يسطّرُها الفتى","بالحرفِ، بل بدمائهِ مترنّما",234,"م",2,0],["إنَّ البُكاءَ على الذين ترحَّلوا","مِنّا الضَلالةُ والخَسارُ الأفظَعُ",235,"ع",1,0],["إن البنادق يفهمون حديثها","وهي التي للنصر خير حوارِ",236,"ر",1,0],["إنّ البلايا إذا ما أنت تجبهها","مصمماً بسيوف الحزم تنبترُ",237,"ر",1,0],["إن البلادة في الشعور لنعمةٌ","وقت الخطوب فلا نُحِسُ بما يُهِينْ",238,"ن",1,0],["إنّ البرامكة الذين تقدّموا","عن عصرنا نهبوا بيوتَ المالِ",239,"ل",1,1],["‏‎إن البيوت التي سكانها رحلوا","عنها قصائد شعر غاب راويها",240,"ه",2,1],["إنّ البيوتَ لو استنطقتَها سألَتْ","دُونَ التّردُّدِ عن أرواحِ مَن غابوا",241,"ب",3,1],["إنّ البلاء إذا سرى في أمة","حمّ القضا ، وتحقق المكتوب",242,"ب",1,0]]}