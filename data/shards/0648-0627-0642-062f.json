{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[85,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[39,"وأقدح كالظبيات انصلها","https://www.aldiwan.net/poem6460.html","المنسرح"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[87,"لحظها لحظها رويدا رويدا","https://www.aldiwan.net/poem7779.html","الخفيف"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[45,"أطاعن خيلا من فوارسها الدهر","https://www.aldiwan.net/poem9607.html","الطويل"],[47,"عذيري فيك من لاح إذا ما","https://www.aldiwan.net/poem65672.html","الوافر"],[30,"لعمرك لا يفارق ما أقامت","https://www.aldiwan.net/poem5471.html","الوافر"],[63,"هي الدنيا وزينتها الشباب","https://www.aldiwan.net/poem51797.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[125,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[147,"ظلامة من أعدك لليالي","https://www.aldiwan.net/poem11796.html","الوافر"],[147,"بنصرك يدرك الفتح المبين","https://www.aldiwan.net/poem11833.html","الوافر"],[182,"ذهاب أضاع إيابه","https://www.aldiwan.net/poem50692.html","المتقارب"],[203,"أيا ضيفا أطال المك","https://www.aldiwan.net/poem45506.html","الهزج"],[228,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[234,"يعد وجيع الوجد ما هيج البعد","https://www.aldiwan.net/poem51175.html","الطويل"],[242,"أقول لمن يصيخ إلى اصطراخي","https://www.aldiwan.net/poem18130.html","الوافر"],[276,"أراني ما ذكرت لك الفراقا","https://www.aldiwan.net/poem52101.html","الوافر"],[333,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[358,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[438,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[447,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[458,"أتاني كتاب الصديق العزيز","https://www.aldiwan.net/poem61796.html","المتقارب"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[463,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[463,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[470,"أطلق لها السيف لاخوف ولا وجل","https://www.aldiwan.net/poem36229.html","البسيط"],[473,"من باع هما بلذة ربحا","https://www.aldiwan.net/poem60296.html","المنسرح"],[484,"لمتى الوقوف بجانب الأسطول","https://www.aldiwan.net/poem37199.html","الكامل"],[556,"ولما التقينا والقلوب مهيجة","https://www.aldiwan.net/poem47196.html","الطويل"],[556,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[556,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[563,"يامن يحب حبيبه","https://www.aldiwan.net/poem34961.html","المجتث"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82801","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126879","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122806","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122686","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122749","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86758","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86618","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62685","الرمل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105463","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119865","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64877","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112736","البسيط"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73960","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93100","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79825","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137925",""],[2158,"","https://poetry.dctabudhabi.ae/diwan/poem/26739","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53179","الوافر"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121186","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131474",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104673","الوافر"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102370","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132575","الكامل"],[3480,"","https://poetry.dctabudhabi.ae/diwan/poem/202493","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62813","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216461","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131262",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102977","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102930","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75681","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101381","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86436","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90894","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83423","الطويل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123458","الرمل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77687","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72593","المتقارب"],[4858,"عوفيتَ يا ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=138781",""],[4869,"احبك لحالك","https://www.poetsgate.com/ViewPoem.aspx?id=151550",""],[4929,"الى الله (تضرع)","https://www.poetsgate.com/ViewPoem.aspx?id=211538",""],[3271,"من نار السكينة","https://www.poetsgate.com/ViewPoem.aspx?id=128739",""],[5183,"ثورة اليمن الشمالية","https://www.poetsgate.com/ViewPoem.aspx?id=185646",""],[5409,"نعيك هز أرجاء البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=155455",""],[5587,"في طلب العلم","https://www.poetsgate.com/ViewPoem.aspx?id=197601",""],[5764,"ست وثلاثينك","https://www.poetsgate.com/ViewPoem.aspx?id=177319",""],[5781,"صمتُكَ الغائِرِ كالجُرْح","https://www.poetsgate.com/ViewPoem.aspx?id=202857",""],[5809,"اقدام","https://www.poetsgate.com/ViewPoem.aspx?id=205651",""],[5837,"غيث الجهام (هلالية)","https://www.poetsgate.com/ViewPoem.aspx?id=181595",""],[5936,"نار العداوة","https://www.poetsgate.com/ViewPoem.aspx?id=184999",""],[5956,"مرحلة مُمْتِعة معَ عِرْق السُّوس","https://www.poetsgate.com/ViewPoem.aspx?id=184840",""],[5997,"الليلة الدلماء","https://www.poetsgate.com/ViewPoem.aspx?id=214293",""]],"verses":[["وَأَقَدناهُ رَبَّ غَسانَ بِالمُن","ذِرِ كَرهاً إِذ لا تُكالُ الدَماءُ",0,"ا",2,0],["وأقدمَ لا هيّابة الحفل واجماً","ولا قاصراً فيه الخطى متوانيا",1,"ي",2,0],["وأقدح كالظُبيات انصلُها","لا تَقَل ريشُها ولا لَغَبُ",2,"ب",1,1],["وأقدح في ثواقب واريات","وأنجح في المَكارم طالبينا",3,"ن",2,0],["وأَقدْني من الليالي مُثيباً","عن إمامٍ ولّاكها ليَقيدَكْ",4,"ك",1,0],["واقدح الكهرباء فيه لتهدى","وأقمها على البخار لتندى",5,"د",2,0],["وَأَقدَرُ مَن يُهَيِّجُهُ اِنتِصارٌ","وَأَحلَمُ مَن يُحَلِّمُهُ اِقتِدارُ",6,"ر",1,0],["وَأَقدَمتُ إِقدامَ الأَتِيِّ كَأَنَّ لي","سِوى مُهجَتي أَو كانَ لي عِندَها وِترُ",7,"ر",1,0],["وَأَقدَمتُم وَفي الإِقدامِ كُرهٌ","عَلى الغَمَراتِ تُقتَحَمُ اِقتِحاما",8,"م",2,0],["وَأَقداماً لَهُم جُرداً قِصاراً","قَليلاً أَخذُهُنَّ مِنَ النِعالِ",9,"ل",1,0],["وأقداحٌ تَفُوتُ المِسكَ طيباً","ويَكمَدُ عندَها الذَّهَبُ المُذابُ",10,"ب",1,0],["وَإِقْدَامٌ عَلَى الجُلَّى وَعَزْمٌ","لَهُ إِنْ مَسَّهُ الضَّيْمُ اشْتِعَالُ",11,"ل",1,0],["واقدام ضرغام اذا البهم أحجمت","وصخت بأذان النجوم الهماهم",12,"م",1,0],["واقدامسٌ واخزيرة مع طنجةٍ","وتِطاوَنُ وارْباط واسْل متوءَما",13,"م",2,0],["واقدم كقسورةٍ أديباً واقتنص","لعلوم نافعة حَلَتْ أو علقما",13,"م",2,0],["وَأَقدَمَ مَن بَغى إِغضابَ مِثلي","عَلى أَمرٍ ثَناهُ عَلى مِثالِ",14,"ل",1,0],["وَإِقدامٌ تَبورُ بِهِ الأَعادي","وَإِنعامٌ تَقَرُّ بِهِ العُيونُ",15,"ن",1,0],["وأقدمُ موتٍ عرفناهُ قتلاً","وأصعبُ قتلٍ بنصلِ \"القرابَهْ\"",16,"ب",2,0],["وأقداهمُ الأقلا","مُ والأرضُ هي الصحفُ",17,"ف",1,0],["وَأَقدَمَ مُثبِتَ الأَبصارِ فيهِ","فَكانَ كِلاهُما أَسَداً تَسَرّى",18,"ر",2,0],["وأقدمتُ إلحاحاً على كلّ مَطْلب","فلم ينفع الإقدامُ إذ لم يكن جَدّ",19,"د",1,0],["وَأَقْدَامُ افْتِقارِ الْخَلْقِ فِيهِ","لِبارِئِهِمْ عَلاَ ذَاتُ ارْتِسَاخِ",20,"خ",1,0],["وأقدم وَالصوافن صافنات","وَقَد ضرب العجاج لها رواقا",21,"ق",2,0],["وأقدمتُ إقدامَ الجبان على الوغى","ترى الموتَ عيناه بعيدا ودانيا",22,"ي",2,0],["وَإِقدام وَعَزم وَاِهتِمام","وَنور مَهابة يَغشى العُيونا",23,"ن",2,0],["واقدَحْ زِنادَ الرّأيِ منكَ ولا تَكُنْ","فيما عنَى نَشْرَ الحَيا قَدّاحا",24,"ح",2,0],["وأقدَمَ نحوهُم أسَداً مُشيحاً","فولّوا بين أيديه ذئابا",25,"ب",2,0],["وإِقدامٍ تؤيِّدُهُ بحزمٍ","إِلَى الأَعداءِ مشدودِ الحزامِ",26,"م",1,0],["وأَقْدَمْتَ فِيهِ الخَيْلَ حَتَّى رَدَدْتَها","وآثارُها ثَغْرٌ لقاصِيَةِ الثَّغْرِ",27,"ر",1,0],["وأقدح في السما حتى لكادت","تمور كمور مرتج الجهام",28,"م",1,0],["وإقدام واحجام","ومن الوى ومن أودى",29,"ا",1,0],["وأقدر ما صُغتهُ للجمال","قرابينَ تسبح بالمغرم",30,"م",1,0],["واقدح ولو جذوة فإن ال","ظلماء يورى فيها الفتيلُ",31,"ل",1,0],["واقدم على السعد إلى الصدر الذي","أوحشتَه فانهض بِورْدٍ وصدَرْ",32,"ر",1,0],["وأقدحُ زَنداً وارياً من هَوَى أخٍ","وأكشفُ عن ودٍّ خبيئةَ صاحبِ",33,"ب",1,0],["واقدح زنادك وابق النار لاهبةً","يخافها الخاسئ المستعبد النذل",34,"ل",1,0],["وَاِقدَح بِأَقداحِكَ السُرورَ فَكَم","مِن قَدَحٍ لِلسُرورِ قُدِحا",35,"ح",2,0],["واقدم لساحة من أطلت وقوفهم","وطمعت فيهم قبل ذا التطويل",36,"ل",1,0],["وأَقدَمَتِ النَّصْرَ البعيدَ سيوفُنا","وقد كان لولا سلُّها غيرَ قادمِ",37,"م",1,0],["وأقدامٌ يُطفْن على أشمٍّ","يُطِلْن وقد علقن به اِستلامَهْ",38,"م",2,0],["وَأَقدموا بَعدَ أَنْ ضاق المَكَرُّ بهمْ","لمّا رأوك على الأهوالِ تَقتحمُ",39,"م",1,0],["واقدم بنفس منيبهْ","واشرب بألطف كوبِ",40,"ب",1,0],["وَأَقدام طَود حَفها المَوج غاسِلا","وَهامات هَضب لَفَها الغَيم كاسيا",41,"ي",2,0],["وأقدّم الترحيبَ للأمجاد مَن","وَفَدوا فزادوا الربع بالتزيينِ",42,"ن",1,0],["وَأقدَمُوا وَصُدُورُ الخَيلِ جانِحَةٌ","عَنِ التَّقَدُّمِ ميلاً يَومَ جازانِ",43,"ن",1,0],["وإقدامُكُم والخيلُ في قَسطَلِ الوَغَى","دَوامي الهَوادي خاضِعاتِ المَعارفِ",44,"ف",1,0],["وأقدَمَ حينَ لا يَنفَكُّ فَكٌ","وَلا يَعلُو كَقابِ القَوسِ سَهمُ",45,"م",1,0],["وَإِقدامِ زنجيٍّ لعسكرك اِنتَمى","عَلى أَعظَم الأَخطار في كُل فدفد",46,"د",1,0],["وَإِقدامه المَعهود في كل معرك","يَدين لَهُ بَينَ الفَوارس غالب",47,"ب",1,0],["وَاِقدَح زِناد الرَأي إِن كُنتَ امرأً","بِالحَزم مَعروفاً لَدى الحُكَماء",48,"ا",2,0],["وَأَقدامَهمْ زَلزِل وَأَرجِف قُلوبَهم","وَصَيِّر لَها الإِرجافَ فيها الرّدى يُجدي",49,"د",2,0],["واقد الفكرة ثبات الحجا","صارم الفطنة زاكي العمل",50,"ل",1,0],["وَإِقدامُ مَن لَم يُرهِب الحَتفُ قَلبَهُ","خَبيرٌ لدَى الهَيجاءِ بِالكَرِّ والفَرِّ",51,"ر",1,0],["وأقدم في نكبةٍ لم تقس","بما قدم الدهر أو أخرا",52,"ر",2,0],["وأقدام يشيّعه برأي","إذا دجت الحوادث فهو فجرُ",53,"ر",1,0],["وأقد الحشا وأفرش خدّي","لحفاة أتينه زوارا",54,"ر",2,0],["واقدم بفقر على باب الكريم فما","خابت مطالب من بالفقر قد قدما",55,"م",2,0],["وأَقْدمَ زَحْفاً خارِجيُّ عِذارِهِ","فهلْ عِنْدَهُ أَنِّي مِنَ الزَّحْفِ",56,"ف",1,0],["واقدح زناد غرام في الفؤاد وهب","حسن اشتياق وحال للكمال حوى",57,"و",2,0],["وأقدم أنواع المسرة قادماً","وعاد لزند الشوق اذ عاد قادحا",58,"ح",2,0],["واقداحاً يدير الموت فيها","ذعافاً من مريشات القداح",59,"ح",1,0],["وأقدم لا مُستسقياً غيرَ عزمةٍ","تعيد غِرارَ السيف بالدّم راويا",60,"ي",2,0],["واقدحوا أزندًا شأنها الإبراء","جددوا عهده أُسرة أورثوكم",61,"م",1,0],["وَأَقدَامُهُ إِذ خَطَّ فِى الأَرضِ لاَ أَثَر","يُرَى وَصَمِيمُ الصَّخرِ لانَ وَسَوَّدَا",62,"د",2,0],["وأقدم كالأتي وشقَّ زحف ال","عدوٍ وصال بطاشاً زبرا",63,"ر",2,0],["وَأَقدَمتُ وَالخَطِّيُّ يَخطِرُ بَينَنا","لِأَعلَمَ مَن جَبانُها مِن شُجاعِها",64,"ع",3,0],["وإقدام إذا عز المحامي","وقد حادت عن الحرب الفحول",65,"ل",1,0],["واقدح باقداح صفراء معتقة","فما الكؤوس لجين ضمنت ذهبا",66,"ب",2,0],["وَأَقدرهم عَلى الجلى اِحتِمالاً","وَأَطيبهم وَأرحبهم فناءا",67,"ا",3,0],["واقدام فضيّه عليها استقام","تشبيكها باطن وظاهر",68,"ر",1,0],["وَأَقدَمَ وَالصَوافِنُ صافِناتٌ","تَخوضُ مِنَ الكُماةِ دَماً مُراقا",69,"ق",2,0],["واقدِر بقائلكم خذها يزيد فقل","خذها معاويَ لا تعجِز ولا تَلم",70,"م",1,0],["واقدمت لكن افلت الموت مشفقاً","من الحية النضناض والاسد الورد",71,"د",1,0],["وأقدر سام مخفر الجنب طامح","بعنيه نهر واضح الوجه ساهمه",72,"م",2,0],["وأقدمَ وثّابٌ على الهولِ خيلُهُ","إذا كُلِّلَتْ لا تَقشَعِرُّ جلودُها",73,"د",3,0],["واقدِم فما عُلَّيقةٌ بل جُذوةٌ","أَورى الزِنادَ بها فما من ياسِ",74,"س",1,0],["وإقدامه في قضاء الفرو","ض إقدام مستبسل صابر",75,"ر",1,0],["وأقدمت والأبطال تحجم رهبةً","وخضت من الهيجاء كل عباب",76,"ب",1,0],["وإقدامه على الشفاعةِ في الورى","جميعاً إذا الرسلُ الأكابرُ أحجمُوا",77,"م",3,0],["وأقداح راح نصطليها مجامراً","ممسكة للَه تلك المجامر",78,"ر",1,0],["وأقدم بها غير هياب ولا وكل","فكل أمر جرى في اللوح مكتوب",79,"ب",1,0],["وَإِقدام وُجودٌ صِدق وَعد","وَعَهد لَيسَ يَخفِرُهُ البَلاء",80,"ا",2,0],["واقدام من لا يرهب الموت وَالفَتى","يَنال المنى ما كانَ لَيسَ براهب",81,"ب",1,0],["وأقدموا فأقامت عرش عاصمة","إيمانهم وبحبل الوحدة اعتصموا",82,"م",3,0],["وأقداح بلور جلاها نديمها","فعاد بها روض السرور أنيقا",83,"ق",2,1],["وأقداح الهنا صرفا علينا","يطوف به ابن ست مع ثمان",84,"ن",1,0],["وَأَقدرك المَولى عَلى كلّ ما تَشا","وَأقسمُ بِالرَحمن أَنّك قادِرُ",85,"ر",1,0],["واقدحوا للعلم زِندا","والبَسوا لِلحزم بُردا",86,"د",2,0],["واقدم على دار الرضا","حيث الإقامة والخلود",87,"د",1,0],["وأقداح راح أجلن بها","عتيقا تعوَّد كرَّا وفر",88,"ر",1,1],["واقدُرْ لنا خيراً فإنّ حياتنا","ملآى بمن ألقى الشّباك وحاكا",89,"ك",2,0],["واقدع من الذكرى وحَلوى ليآلك","دربي على مآضيك غصبٍ ادلّه",90,"ل",2,0],["وأقدارُه في الكونِ تجري لحكمةٍ","تضاءلَ عن إدراكِها الحُكَمَاءُ",91,"ا",2,0],["وأقداح رق بكف الطغاةِ","أساها بنايي تجرَّعتهُ",92,"ت",2,0],["واقدم يا يُمن إلى يمن","حيث الإيمان ومعهده",93,"د",2,1],["وإقداماً تجافى الدهر عنه","وخافك لو أصر على العناد",94,"د",1,0],["وَ اقْدِمْ إِذَا حَقَّ البَقَا فِي لَذَّتِي","بِالنَّفْسِ بَعْدَ تَخَضُّبٍ وَ تَكَحُّلِ",95,"ل",1,0],["وأٌقدرك تقدير غالي ومحشوم","وأعشق ديارك وأنت لي دار وبْلاد",96,"د",1,0],["وَأَقْدَمْتَ لا يُثْنيكَ أَمْسٌ وَلا غَدُ","فَأَشْهى لَذاذاتِ الوِصالِ تَواعُدُ",97,"د",1,1],["واقدِمْ بنفسِكَ نحوَ كلِّ عظيمةٍ","إنَّ النفوسَ لَتعشقُ الإِقداما",98,"م",2,0],["واقدّر خوّي الطيب لو كانه اجنبي","وإذا غبت عنّه ما ينام قرير",99,"ر",1,0],["وا قد قلبي قدة الثوب لا إنقد","على ربوعٍ كل مجدٍ تظبه",100,"ب",2,0],["وأقدامنا كانت خيولا سريعة","تطير إلى الأقصَى حدَتْها المطامعُ",101,"ع",1,0],["واقدح كؤوس العاشقين تزلفاً","ضامّ الحنين بمورد الحكماءِ",102,"م",3,0]]}