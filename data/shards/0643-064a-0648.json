{"poems":[[79,"يهنيك مقدم عبد الواحد ابنك عن","https://www.aldiwan.net/poem36710.html","البسيط"],[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[46,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43676","المتقارب"],[108,"هنا شعر أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=179385",""],[131,"أرى العباس ينقص كل يوم","https://www.aldiwan.net/poem24269.html","الوافر"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[285,"أمني النفس وصلا من سعاد","https://www.aldiwan.net/poem60785.html","الوافر"],[308,"كئوس المدام تحب الصفا","https://www.aldiwan.net/poem57795.html","المتقارب"],[333,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[369,"تظلم من طرف ظبي رخييم","https://www.aldiwan.net/poem60647.html","المتقارب"],[371,"طفل كفاه القلب دارا له","https://www.aldiwan.net/poem17678.html","السريع"],[409,"إلام أرى عاذلي في تعب","https://www.aldiwan.net/poem34155.html","المتقارب"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[567,"زر قبر جرجي الغلام اللاذقي سحرا","https://www.aldiwan.net/poem52534.html","البسيط"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104409","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93106","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49985","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137026",""],[3357,"","https://poetry.dctabudhabi.ae/diwan/poem/105648","المتقارب"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129343","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129405","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118004","السريع"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116043","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139606",""],[4762,"لماذا","https://www.poetsgate.com/ViewPoem.aspx?id=215337",""],[4984,"نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=183238",""],[4119,"أما وخيال زار ممن أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=16065",""],[5277,"زهرةٌ اسمها حوّاء","https://www.poetsgate.com/ViewPoem.aspx?id=206956",""],[5582,"َكى وناحَ غراماً في الهوى ناحا","https://www.poetsgate.com/ViewPoem.aspx?id=63479",""]],"verses":[["كَيُوسُفٍ كَانَ فِعْلُ الزَّمَانِ بِهِ","وَكُنْتَ فِي الْبّثِّ وَالشَّكْوَى كَيَعْقُوبِ",0,"ب",1,0],["كَيَومِ اِبنِ هِندٍ وَالجِفارِ وَقَرقَرى","وَيَومٍ بِذي قارٍ أَغَرَّ مُحَجَّلِ",1,"ل",1,0],["كَيَوْمِك الأرْيَحيِّ قصّره","ربك في عمرك الذي وَفَره",2,"ر",2,0],["كَيوسُفَ لَمّا أَن رَأى أَمرَ رَبِّهِ","وَقَد هَمَّ أَن يَعرَورِيَ الذَنبَ أَحجَما",3,"م",2,0],["كيوْمِ يَزيدٍ والسّبايا طَريدةٌ","على كلّ مَوّارِ المِلاطِ عَشَمْشَم",4,"م",1,0],["كَيوسُفَ لكِنَّني","كَيَعقوبَ حُزناً وَبَث",5,"ث",1,0],["كيوبيدُ يغزو عرينَ الأُسود","فكيف به لا يشقُّ الخدُورا!",6,"ر",2,0],["كَيَومِكَ إِذ خَرَجتَ تَفوقُ رَكضاً","وَطارَ القَلبُ وَاِنتَفَخَ الوَريدُ",7,"د",1,0],["كَيَومِهِم بِعَزازٍ إِذ مَضَوا قُدُماً","حَتّى ثَنى كُلَّ أَلفٍ مِنهُمُ نَفَرُ",8,"ر",1,0],["كَيَومِ عَزازٍ إِذ حَمى الدينَ سَيفُهُ","وَقَد قارَبَت أَركانُهُ أَن تَضَعضَعا",9,"ع",2,0],["كَيَوْمِكَ إِذْ دَمُ الأَعْلاَجِ بَحْرٌ","يُرِيكَ الْبَحْرَ فِي حُلَلٍ وِرَادِ",10,"د",1,0],["كئوس المدام تحب الصفا","فكن لتصاويرها مبطلا",11,"ل",2,1],["كئوسا حلوُها مرّ","وصافي ريقها كرب",12,"ب",1,0],["كيوم مؤيّد دين الهدى","ترى فيه طلعة حرٍّ عديم",13,"م",1,0],["كَيوسُفِ الحُسنِ وَقَلبي لَهُ","سِجنٌ وَما ثَمَّ لَهُ صاحِبُ",14,"ب",1,0],["كيوسف صِدِّيقِ رب السما","به قد أقام لوهم الريب",15,"ب",1,0],["كيومِ الهمِّ لَيْسَ بذي انتقاصٍ","ويومِ اللهوِ لَيْسَ بذي تَمَامِ",16,"م",1,0],["كيُوسُفِ الحُسنِ في سِنِّ الثَمانِ رَمَى","أباهُ طنُّوسَ في أحزانِ يعقوبِ",17,"ب",1,0],["كيوم حسين والسبايا حواسر","تشاهد من أسر العدى ما تشاهد",18,"د",1,0],["كيوم الحسين ونار الوغى","تصاعد للفرقدين الشرارا",19,"ر",2,0],["كيوم وجدنا فيه نبهان هالكاً","وذلك من أيامنا قمطريرها",20,"ر",3,0],["كيوسف هذا العصر من في خلاله","بلبنان امسى مثل يوسف في مصر",21,"ر",1,0],["كيوم سروري بعرس الحسين","فتى قد زكا محتداً ونجارا",22,"ر",2,0],["كيوم أني الناعي وللعلم رنة","تطير بها الآراء قسرا وتسلب",23,"ب",1,0],["كيوم انقطاع الوحي للخلق رنة","وكم برزت عذرا من الخدر والسجف",24,"ف",1,0],["كيوسف الصديق في عدله","كلا الوزيرين مدير آمين",25,"ن",1,0],["كيوم مكة والاحزاب إذ دهَموا","ويوم بدر وأوطاس وذي قَرَد",26,"د",1,0],["كَيَومٍ بِأَسوَارِ فِيَّا فَظِيع","وَحَولَ سُرى يَردَنُوسَ السَّرِيع",27,"ع",1,0],["كَيوَانُ أعلى كوكبٍ مَوضعاً","وَهوَ إِذ أنصَفتَهُ نَحسُ",28,"س",1,0],["كيوم حسين حيث أمسى لفقده","بحزنٍ نواحى الأرض والدهر كالح",29,"ح",1,0],["كَيُوسُفَ أَنْتِ بِحُسْنٍ وطُهْر","فلا تجزعي من أذى الكائدين",30,"ن",1,0],["كيوم بدر ففي مراجعنا","لنا صدى من حديثه الجلل",31,"ل",1,0],["كيوم الرها الورهاء والهام يانع","ملي برعي الهندواني خصبه",32,"ب",2,0],["ك(يوسُفَ) روعةً وقفتْ ببابي","فغادرتُ المشيبَ إلى الشباب",33,"ب",1,1],["َكى وناحَ غراماً في الهوى ناحا","وَباح بالحبّ عن أحبابهِ باحا",34,"ح",2,1]]}