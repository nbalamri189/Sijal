{"poems":[[55,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[55,"حلفت بأعلام المحصب من منى","https://www.aldiwan.net/poem30724.html","الطويل"],[88,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[32,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[90,"أتى من مصر طلعتها بن حرب","https://www.aldiwan.net/poem44397.html","الوافر"],[91,"هزنا الفن في كمنجة سامي","https://www.aldiwan.net/poem44773.html","الخفيف"],[87,"تحبك صاحبي منا قلوب","https://www.aldiwan.net/poem7780.html","الوافر"],[64,"عليك أقمت أرسال الكلام","https://www.aldiwan.net/poem52266.html","الوافر"],[35,"أجبت بليلى من دعاني تجلدا","https://www.aldiwan.net/poem25965.html","الطويل"],[48,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85439","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16642","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54209","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[106,"يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=37408",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[119,"لجأت بأعتاب الحبيب ابن هاشم","https://www.aldiwan.net/poem42165.html","الطويل"],[234,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[264,"نحن وفد القرى حللنا الخياما","https://www.aldiwan.net/poem35964.html","الخفيف"],[266,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[287,"وأهيف لحظه بالسحر ناجا","https://www.aldiwan.net/poem32838.html","الوافر"],[309,"إذا شئت أن تحيا سعيدا مدى العمر","https://www.aldiwan.net/poem16761.html","الطويل"],[369,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[369,"أذاكرة يوم الوداع نوار","https://www.aldiwan.net/poem60917.html","الطويل"],[382,"ما أحسن الروض في الروابي","https://www.aldiwan.net/poem66927.html","مخلع البسيط"],[422,"هكذا كان فعلها الحمقاء","https://www.aldiwan.net/poem53943.html","الكامل"],[438,"عزت ضمائره على كتمانه","https://www.aldiwan.net/poem12747.html","الكامل"],[445,"ليهن لك العيد الذي بك يهنينا","https://www.aldiwan.net/poem34859.html","الطويل"],[447,"أحن إلى ليلى وليلى منى قلبي","https://www.aldiwan.net/poem14296.html","الطويل"],[447,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[458,"أجل ضربت لكم في غربتي المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[466,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[505,"أراني هلال الأفق لمعة أنسكم","https://www.aldiwan.net/poem38063.html","الطويل"],[545,"أفي طلل قفر تحمل آهله","https://www.aldiwan.net/poem56713.html","الطويل"],[558,"حياتك يا ابن سعدان بن يحيى","https://www.aldiwan.net/poem68262.html","الوافر"],[580,"تدعي العقل وهو أشرف ما فيك","https://www.aldiwan.net/poem2757.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48790","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38131","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37799","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67840","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64877","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49965","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49921","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79819","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142262","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124733","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2163,"","https://poetry.dctabudhabi.ae/diwan/poem/124034","الطويل"],[2169,"","https://poetry.dctabudhabi.ae/diwan/poem/141459","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109453","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109522","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45564","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123824","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100485","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100498","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130086","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97893","الوافر"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117024","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28875","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112402","المتقارب"],[3487,"","https://poetry.dctabudhabi.ae/diwan/poem/111547","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145130","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138614",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97076","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81709","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81689","الكامل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105494","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28619","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120511","الوافر"],[4697,"الدار صدت","https://www.poetsgate.com/ViewPoem.aspx?id=22675",""],[4755,"ُتَمُرُّ على (العيونِ) مُرورَ حُلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=183524",""],[4767,"ثورة الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=178407",""],[4815,"إربد في زمن الكورونا (الأقحوانة)","https://www.poetsgate.com/ViewPoem.aspx?id=211062",""],[4869,"طريق الولايف","https://www.poetsgate.com/ViewPoem.aspx?id=162814",""],[4955,"دياجير القلوب تنار دوماً","https://www.poetsgate.com/ViewPoem.aspx?id=188735",""],[4956,"من الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=1393",""],[3591,"أين الذي كان في باريس يزدهر","https://www.poetsgate.com/ViewPoem.aspx?id=149476",""],[5101,"الأنا الشّاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=189781",""],[5167,"خمار الهوى يربي على نشوة الخمر","https://www.poetsgate.com/ViewPoem.aspx?id=181119",""],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[5358,"المسارُ الصّعبُ","https://www.poetsgate.com/ViewPoem.aspx?id=202469",""],[5829,"حينا فحينا","https://www.poetsgate.com/ViewPoem.aspx?id=214903",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[5956,"تسائلني: أكلتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182647",""],[5957,"سلامٌ...2","https://www.poetsgate.com/ViewPoem.aspx?id=33889",""],[6102,"نِهايَةُ المُسَلسَل","https://www.poetsgate.com/ViewPoem.aspx?id=182768",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[6271,"عاشق التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80707&r=&rc=13",""],[6288,"الحاضر ... ليس النهاية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76849&r=&rc=12",""]],"verses":[["وَتَرَجُّلي عَن كُلِّ أَجرَدَ سابِحٍ","مَيلَ الرِقابِ نَواكِسَ الأَبصارِ",0,"ر",1,0],["وَتَرجيعِ أَصواتِ الحَجيجِ وَقَد بَدا","وَقورُ النَواحي تَستَبِدُّ بِهِ الحُجبُ",1,"ب",1,0],["وَتَرجو رَجاءَ اللِصِّ لَو أَسبَلَ الدُجى","عَلى البَدرِ سِتراً حالِكَ اللَونِ أَسوَدا",2,"د",2,0],["وَتَرجافُ أَلحِيَها إذا ما تَنَصَّبَت","عَلى رافِعِ الآلِ التِلالُ الزَراوِحُ",3,"ح",1,0],["وترجعهم إلى ما كان قبلاً","لهم من دولة ومن اعتزاز",4,"ز",1,0],["وتر جامد ورق بلا حس","فمن اين جاء هذا النواح",5,"ح",1,0],["وترجو أن تعيش لها نفوس","إذا تبقى لها يبقى النعيم",6,"م",1,0],["وترْجعُ كيدَها عنّي مَهينا","كليلَ الغرب محدودَ اللثامِ",7,"م",1,0],["وَتَرجِعُ لي روحُ الحَياةِ فَإِنَّني","بِنَفسِيَ لَو عايَنتَني لَأَجودُ",8,"د",1,0],["وَتَرجو الرِباحَ وَأَينَ الرِباحُ","وَنَعتُكَ في نَفسِكَ الخَيسَرا",9,"ر",2,0],["وَترجف بالنوح السماء ملاحها","وَتَبكي وَتَستَبكي المَلائكَ غيدها",10,"د",3,0],["وتُرجّى عودةَ المجد الذي","أعجزَ الباني وأعيا المتسامي",11,"م",2,0],["وتَرْجِيعُ أصْواتِ الخصومِ يردّها","سُقُوفُ بيوتٍ في طِمارِ مُبَوَّبِ",12,"ب",1,0],["وتَرْجِعُ خِرْصانُ العَواسِلِ هُيّباً","كخِرْصانِ رَقْلٍ أو مَخارِصِ عَسّال",13,"ل",1,0],["وتَرْجِعُ أعقابُ الرّماحِ سَليمَةً","وقد حُطِمتْ في الدارعينَ العَوامل",14,"ل",1,0],["وتَرْجِعُ بَغْدادَ بعد الفَنَاءِ","تُحدِّثُ للنَّاسِ أَخْبارَها",15,"ر",3,0],["وترجعُ فيهم مثلَ سعدٍ وخالدٍ","وترفَعُ من راياتهم حينَ تُنصَبُ",16,"ب",1,0],["وترجع عنها وفي جانبيك","جرح تئن .. وتأبى اندمالا",17,"ل",2,0],["وتَرْجِعُ والعتبُ في مُوقِها","تَساءلُ : أيُّكما المُبتلى ؟",18,"ا",1,0],["وترجم رمز اللوح في حسن منطق","بديع وفهم جل عن درك فاهم",19,"م",1,0],["وترجُف منه قلوبُ العِدَا","إذا صَولَةٌ فيهمُ صالَها",20,"ل",3,0],["وترجّى حسن القرى حيث أهدا","ك نظاماً ورام منك نظاما",21,"م",2,0],["وترجو انتقال الود من قلب غادر","وقد غلب المطبوع أن يتطبعا",22,"ع",2,0],["وَتَرجِعُ عَنكَ شُقرُ الخَيلِ دُهماً","مِنَ الدَمِ حينَ يَقتَحِم العَجاجا",23,"ج",2,0],["وَتُرَجَّحُ عِندَ الوَزنِ أَعمالَكَ الَّتي","تَسرِبُها في مَوقِفِ الحَشرِ وَالنَشرِ",24,"ر",1,0],["وتَرجِعُ مَثلومةً بالبِعا","دِ عَيْنٌ إلى غايتَيْهِ رَموق",25,"ق",1,0],["وتَرجع أصواتِ المُهِلّينَ كلّما","دَمِينَ جِمالٌ أو رُمِينَ جِمار",26,"ر",1,0],["وترجعيني إلى حماك","رجوع ساهٍ عن الصواب",27,"ب",1,0],["وترجّى للحَلْق أمراً محالاً","ولقَدْ خابَ ظنُّه والرَّجاء",28,"ا",2,0],["وتُرجِّعُ الأوراقُ في أوراقِه","شجواً يضيعُ اللحنُ في ألحانِه",29,"ن",2,0],["وتُرْجَوْنَ للجُلَّى فنِعْمَ المُجَلُّونَا","وتُدْعَوْنَ للنُّعمى فنعمَ المُجِيبونا",30,"ن",2,0],["وترجو لها وصلاً ومن دون وصلها","تنايف سهب قد أضفن إلى سهب",31,"ب",1,0],["وترجو النجاة وتعمي السبيل","أتجري السفينة فوق الوهاد",32,"د",1,0],["وترجعونَ إل شعرٍ وعى خلقي","وتتبعون سلوكاً لم يكن خبلاَ",33,"ل",2,0],["وترجَّلْ فتحدَّثْ عَجَبا","أن قلباً سار عن جسمٍ أقاما",34,"م",2,0],["وتُرْجعُها في أرضهمْ عربيَّةً","يرُدُّ قَناها كلَّ سهْم ومِعْبَل",35,"ل",1,0],["وتُرجِعُني عن كلِّ شيءٍ سوى الهَوَى","فيذهَبُ صبري حين تثبُتُ رَجْعَتي",36,"ي",1,0],["وَتَرجو وَلَم يَنطِق وَلَيسَ بِناطِقٍ","جَواباً مُحيلٌ قَد تَحَمَّل آهِلُهْ",37,"ل",2,0],["وَتُرجِعُني إِلَيكَ وَإِن نَأَت بي","دِياري عَنكَ تَجرُبَةُ الرِجالِ",38,"ل",1,0],["وتُرجِّي البقاءَ في يَوْمِك الآ","تي ولم تَتَّعِظْ بذاهِب أَمْسِكْ",39,"ك",1,0],["وترجرجت أردافهن كأنها","موج له بعد الهبوط صعود",40,"د",1,0],["وترجِفُ صحْفُهم بالوعيد","وما هو إلا الجوى والوجل",41,"ل",1,0],["وَتَرجو قَبولاً مِنكَ فَضلاً وَلَم يَكُن","عَلَيكَ أَخا المَجدِ القبولُ بِواجِبِ",42,"ب",1,0],["وَتَرجو قَبولاً مِنكَ فَضلاً وَمِنّةً","وَتَقبيلَ راحاتٍ بِهِ يُنعَشُ الكبدُ",43,"د",1,0],["وَتُرْجِعُ أَيَّاماً تَقَضَّتْ عَلىَ مِنى","أُنَادِيهِمُ وَالدَّمْعُ فِي الْخَدِّ مُعْلِنَا",44,"ن",2,0],["وترجم على سر الربا صامت الشذى","فيا طيب ما أبدى الصموت المترجم",45,"م",1,0],["وتَرْجُو فَلاحاً عُذَّلي فأُحيلُهمْ","على آخِرِ العِشرينَ مِنْ سُورةِ الكَهْفِ",46,"ف",1,0],["وتُرَجْوَنَ للجَدوى وتُهدى اليكم","بأحسن أَشعار المديح القصائدُ",47,"د",1,0],["وَتَرجُّوا أن تَندَموا والمُعافَى","مَنْ تَلافَي نَدامةَ من قريبِ",48,"ب",1,0],["وترجو عُلاً من دونها قدرُ القضا","وعزمك عن قرع المقادير ناكل",49,"ل",1,0],["وَتَرجُفُ الأَرضُ بِأَعدائِهِ","إِذا عَلاهُ الدِرعُ وَالمِغفَرُ",50,"ر",1,0],["وترجع لذاتي وأنسي ورفهتي","على رغم أنف الحاسدين سترجع",51,