فَاف تجسّد نوره","من جوهرِ لألاءُ بهجته بَهَرْ",4,"ر",1,0],["في كفّه نبعةٌ مُوَتَّرة","يهزج ابياضًها ويهتضِبُ",5,"ب",1,1],["في كفه قصباتُ كل مقلد","يوم الرهان وفوز كل نصالِ",6,"ل",1,0],["في كفه قلمٌ يُخافُ ويُرتجى","فيجانس الإعطاءَ والأَعطابا",7,"ب",2,0],["في كفِّه قلمٌ ناهيك من قلمٍ","للمالِ مجرٍ وللغماء فرَّاج",8,"ج",1,0],["في كفِّه القلمان الرَّاجحان على","سواهما بين كفاتٍ وأدراج",9,"ج",1,0],["في كفِّهِ قلمٌ كأنَّ رِشاءه","للرزقِ والدرر النفيسة مائح",10,"ح",1,0],["في كفِّ يقظان لا في القولِ ممتنع","إذا أراد ولا في الفكر ترديد",11,"د",1,0],["في كفه حمرُ أقلامٍ وبيض ظباً","كأنها لبرود المدْحِ تشهير",12,"ر",1,0],["في كفِّ من لا عيبَ فيه سوى ندى","فهمٍ على كلّ المحامد نبشا",13,"ش",2,0],["في كفِّ فيَّاض النوال كأنها","لمعُ البروق بعارضٍ وكَّاف",14,"ف",1,0],["في كفِّه قلمٌ الإنشاد منشأه","فضلٌ وفصلٌ وتعريفٌ ومعروف",15,"ف",1,0],["في كفِّه قلمٌ كالسيف منتصبٌ","لكنه لبني الآداب كالهدف",16,"ف",1,0],["في كفِّه قلمٌ ناهيك من قلم","ومن حسامٍ ومن رزق ومن أجل",17,"ل",1,0],["في كفّ أبلج يلقى الجود مفترضاً","لدى علاه وحدّ العزم مسنونا",18,"ن",2,0],["في كفِّه محنيَّة الأوصال","قاطعة الأعمار كالهلال",19,"ل",1,0],["في كفّه قلم ناهيك من قلم","نُبْلاً وناهيك من كف بها اتشحا",20,"ح",2,0],["في كفّك العود وهو يؤذن بال","إحسان إيذانَ صادقِ الخبرِ",21,"ر",1,0],["في كفّه كالشَهاب لاح على","ظلماء ليلٍ دجتْ فنوَّرها",22,"ر",3,0],["في كفك السيفُ إن ضربتَ به","نَفْسَك أو مَنْ تريدُها خَذَما",23,"م",2,0],["في كفِّ كافٍ أمينٍ غيرِ مُتَّهمٍ","غنَّى بذلك مُشَّاءٌ ورُكبان",24,"ن",1,0],["في كَفِّها طاقَةٌ تُشيرُ بِها","لِكُلِّ طيبٍ مِن طيبِها ريحُ",25,"ح",1,0],["في كَفِّهِ قَلَمٌ تَهمي مَشافِرُهُ","في نَفعِ مُعتَكَرٍ أَو وَقعِ مُعتَرَكِ",26,"ك",1,0],["في كَفِّهِ القَلَمُ الَّذي خَضَعَت لَهُ","بيضُ الصَفاحِ وَفُلُّ حَدُّ شَباتِها",27,"ت",3,0],["في كفه كأس يقدمها","تمحو العذاب وتغسل الندما",28,"م",2,0],["فَيَكفي الَّذي يَكفي الكَريمُ بِحَزمِهِ","وَيَصبِرُ إِنَّ الحُرَّ مِثلَكَ صابِرُ",29,"ر",1,0],["في كَفِّهِ مُرهَفُ الغِرارِ إِذا","أَهوى بِهِ مِن كَريهَةٍ رَسَبا",30,"ب",2,0],["في كفِّ يحيَى منه أبيضُ مُرهَفٌ","عرَفَ المعزَّ حقيقةً فتشيّعا",31,"ع",2,0],["في كفِّهِ البُشْرَى وفي هَمساتِهِ","نُعْمَى الحياةِ وعزُّ مِصْرَ الأَوْفر",32,"ر",1,0],["في كفِّهِ قلمٌ، لُعا","بُ النَّحلِ قَصَّرَ عن لُعابه",33,"ب",2,0],["في كفّه شعلة تهدي وفي فمه","بشرى وفي عينه إصرار أقدار",34,"ر",1,0],["في كفه -الدهر- أم في ظهره قلم","فنصفه كاتب، والنصف مكتوب",35,"ب",1,0],["فيكفرها المفتون والحق ظاهر","ويشكرها العبد المنيب فينصر",36,"ر",1,0],["في كفِّه صمَّاءُ ضامرةٌ","سرَقَتْ شمائَلها من الصِّلِّ",37,"ل",1,0],["فيكفي فخراً أَن ذاك أبٌ له","ويكفي أبوه أَن ذا الليث شبلُهُ",38,"ل",2,0],["في كفه للجود خمسةُ أبحرٍ","تجرى ووكف الكف منك بضيضُ",39,"ض",1,0],["في كفِّه جناتُ عَدْنٍ للعَطَا","وجَهنّمٌ في الحربِ للأعداءِ",40,"ا",2,0],["فَيَكُفُّ شِرَّتَها وَيَجلو نَقعها","بِمُهَنَّدٍ ماضي الغِرارِ يَماني",41,"ن",2,0],["في كَفِّهِ طَيّانُ أَرقَشُ لِلعِدى","مِنهُ لِسانُ الحَيَّةِ النَضناضِ",42,"ض",1,0],["في كَفِّهِ قَلَمٌ تَخُر","رُ لِبَأسِهِ قُلَلُ الرِماحِ",43,"ح",1,0],["في كَفِّه مِثْلُ الشُعاعِ الحارِد","أسرَعُ في النّسِّ مِن الأساوِد",44,"د",1,0],["فِي كَفِّهِ سَيْفُ مِسْمارَ الَّذِي شَقِيَتْ","هامُ الْمُلُوكِ بِهِ أَيّامَ سِنْجارِ",45,"ر",1,0],["في كَفِّهِ أَبيَضُ ماضي الشَّبا","إِذا مَشى أَطرَقَ كَالأُفعُوان",46,"ن",1,0],["في كَفِّهِ قَلَمٌ واهاً لَهُ قَلَماً","بِهِ الأَمانِيُّ تَبدو وَالمَنِيّاتُ",47,"ت",1,0],["في كَفِّه كفُّ العدى","وَبفكِّه فَكُّ الأَسيرِ",48,"ر",1,0],["في كَفِّه قَلمٌ تَلْقاهُ مُنْصَلتاً","يَجْري القَضاءُ مُجدّاً في مَجاريه",49,"ي",2,0],["في كفِّهِ قَلمٌ بالرُّمْحِ تُشْبِهُه","إذا غدا في صُدورِ الخَيلِ طَعّانا",50,"ن",2,0],["في كَفِّهِ قَلَمٌ لَهُ","فاقَ الصَوارِمَ في الصَرامَه",51,"م",2,0],["في كفّهِ قَلمٌ يَعنو الزّمانُ له","ويَسْنَ الخطْبُ منه وهْو ذو عَجَف",52,"ف",1,0],["في كفِّه قلمٌ للخطْبِ يُعملُه","كأنّه لجِراحِ الدَّهرِ مِسْبار",53,"ر",1,0],["في كَفِّهِ قَلَمٌ تَجري بِمَدَّتِهِ","عَينا دَمٍ وَعَطاءٍ غَيرِ تَصريدِ",54,"د",1,0],["في كَفّهِ الدَّهْرَ أو في طَهرِه قَلَمٌ","فنِصفْهُ كاتبٌ والنِّصفُ مَكْتوب",55,"ب",1,0],["في كفِّه قَلَمٌ يَغُضُّ مضاؤُه","من كلِّ مَطْرورِ الغِرارِمُذَرَّب",56,"ب",1,0],["في كفِّهِ لَدنَةٌ مُثَقَّفَةٌ","فيها سِنانٌ مُحَرَّبٌ لَحِمُ",57,"م",1,1],["في كفِّهِ قَلَمٌ تختالُ ريشتُهُ","مازال يكتب للعلياءِ ميثاقا",58,"ق",2,0],["في كفِّه مُتلهّب الصّفحات","مشحوذُ الجوانبْ",59,"ب",1,0],["فيكفَ يخفى ما فيكَ مِن كرمٍ","ومِن خلالٍ غرّ ومِن شِيَمِ",60,"م",1,0],["فيكف إذا أنْتَ أَبْصَرتها","فكيفَ الوقوعُ فيكفَ الخلودْ",61,"د",1,0],["في كَفِّهِ قَلَم أَتَمُّ من القَنا","طولاً وَهُنَّ أَتَمُّ منه طولا",62,"ل",2,0],["في كَفِّهِ أَحيا وَمِن كَفِّهِ","أَحشَر إِن حُمَّ القَضاءَ المُتاح",63,"ح",1,0],["في كَفه قلم يَنوبُ بِحَدِّهِ","عَن حد كل مثقَّفٍ وَمشطَّبِ",64,"ب",1,0],["في كفها شرك يصطاد افئدة","فكم فؤاد بهما قد صار ذا ألم",65,"م",1,0],["في كَفِّ كُلِّ كَمِيٍّ ما بَصَرْتَ به","إلاَّ تَنَزَّهْتَ في عَقْلٍ وفي هَوَجَ",66,"ج",1,0],["في كَفِّه ولسانِهِ وجنانِهِ","مَنٌّ وإِيمانٌ لنا وأَمانُ",67,"ن",1,0],["في كفّها حمراء مثلُ الشِّهابْ","صافيةٌ رقّتْ كمِثلِ السّراب",68,"ب",1,0],["في كفِّ كاعِبَ من تور","دِها كما في خدِّ كاعِبْ",69,"ب",1,0],["في كَفِّهِ السيفُ المقلَّدُ جَدُّهُ","بالمَرْجِ إِذ تَبَّتْ يدُ الضحَّاكِ",70,"ك",1,0],["في كف عذراء الخليج مقره","ذات الجمال الباهر الجذاب",71,"ب",1,0],["في كفِّ راكبها عِنانُ مسمِّحٍ","في السبق غرّةُ وجهه لم تُلطَمِ",72,"م",1,0],["في كفَّ أروعَ دامي الظُّفْرِ مُنْصَلِتٍ","رَحْبِ الذَّراعِ على الأهوالِ صبّارِ",73,"ر",1,0],["في كفّه مثلُ حِدادِ المُدى","يفرِي بها الجلدَ ولا تَخْلِقُ",74,"ق",1,0],["في كفِهِّ البيضاءِ خمسُ أناملٍ","يدعونها في الأرضِ خمسَ سَحائِبِ",75,"ب",1,0],["في كَفِّهِ سيفُ عَدلٍ طالَ قائِمُهُ","في غِمْدِ حلمٍ بخَلْقِ اللهِ قد لَطفَا",76,"ف",2,0],["في كَفِّهِ النايُ يَسقِيهِ الرُّضابَ فلا","تَعجَبْ إذا مالَ فيها وَهْوَ نَشْوانُ",77,"ن",1,0],["في كَفِّهِ البيضاءِ سُمْرُ يَراعةٍ","لَعِبتَتْ لها بالمُعرَباتِ عواملُ",78,"ل",1,0],["في كفِّه قلمٌ يُجْري أوامِرَه","بالبأس والجود أَو بالعيشِ والأَجَلِ",79,"ل",1,0],["في كفِّه قَلَمٌ إِنْ شئتَ أَو قَدرٌ","يُصَرِّفُ الخلقَ بين النَّفْعِ والضَّرَرِ",80,"ر",1,0],["في كفِّه أَرْقَمٌ به نَظَمَ ال","مُلْكَ أُموراً من قبله بَدَداً",81,"د