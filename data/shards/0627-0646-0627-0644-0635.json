{"poems":[[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[88,"عهد الصبا سقيا لأيام الصبا","https://www.aldiwan.net/poem44447.html","الرجز"],[37,"اعتبت أم عتبت عليك صدوف","https://www.aldiwan.net/poem7233.html","الكامل"],[23,"إن الصنيعة لا تكون صنيعة","https://www.aldiwan.net/poem21594.html","الكامل"],[51,"ما أوجب العفو على سيد","https://www.aldiwan.net/poem61992.html","الوافر"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[62,"قالوا وقد بكروا لعذلي إذ رأوا","https://www.aldiwan.net/poem52449.html","الكامل"],[61,"هذا أوان ثمار له","https://www.aldiwan.net/poem51621.html","مجزوء الكامل"],[66,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[66,"إن الصديق إذا رأك مخالفا","https://www.aldiwan.net/poem38551.html","الكامل"],[66,"إن الصديق يريد بسطك مازحا","https://www.aldiwan.net/poem38566.html","الكامل"],[66,"حتام أمنحك المودة والوفا","https://www.aldiwan.net/poem38754.html","الكامل"],[66,"يا من له راية العلياء قد رفعت","https://www.aldiwan.net/poem41554.html","البسيط"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[74,"قل ما تشاء بمحفل أو مجهل","https://www.aldiwan.net/poem13202.html","الكامل"],[105,"أم تدافع يأسها برجائها","https://www.aldiwan.net/poem43414.html","الكامل"],[105,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[21,"إن الصفي بن النبيت مملكا","https://www.aldiwan.net/poem36213.html","الكامل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[48,"ذكر الصبوح بسحرة فارتاحا","https://www.aldiwan.net/poem62495.html","الكامل"],[46,"أنا لصرورة في الحياة مقارن","https://www.aldiwan.net/poem22264.html","الكامل"],[46,"يا راعي الود الذي أفعاله","https://www.aldiwan.net/poem23629.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85364","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202527","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54813","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[58,"صَرَمَتْ حِبَاْلَكَ بَعْدَ وَصْلِكَ زَيْنَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=22645",""],[51,"ما أوجَبَ العفوَ على سيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=28620",""],[124,"قولوا لعبود على القول يشفيني","https://www.aldiwan.net/poem23720.html","البسيط"],[160,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[185,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[229,"إن الصبوح هو السرور بأسه","https://www.aldiwan.net/poem50878.html","الكامل"],[270,"دعني أجازف بالهوى والحسن","https://www.aldiwan.net/poem35249.html","الكامل"],[270,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[275,"ويح ابن آدم غرته سلامته","https://www.aldiwan.net/poem25389.html","البسيط"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[320,"الحب ما أقساه ليس يطاق","https://www.aldiwan.net/poem61735.html","الكامل"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[364,"طرقت بليل من سناها مقمر","https://www.aldiwan.net/poem60912.html","الكامل"],[402,"ثق بالذي خلق الورى","https://www.aldiwan.net/poem46994.html","مجزوء الرمل"],[403,"إن الصلاة من الرحمن واجبة","https://www.aldiwan.net/poem34133.html","البسيط"],[432,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[461,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[479,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[515,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[515,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[562,"طال البعاد فطال الشوق والكمد","https://www.aldiwan.net/poem52804.html","البسيط"],[562,"ماذا يؤمله الحسود بجهده","https://www.aldiwan.net/poem52870.html","الكامل"]],"verses":[["إِنَّ الصَحائِفَ لا يَقريكَ باطِنُها","نَفسَ الطَوابِعِ مَوسوماً عَلى الطِيَنِ",0,"ن",1,0],["إِنَّ الصَفا العاديَّ يُقرَعُ بِالأَذى","مِن غَيرِكُم وَصَفاكُمُ لا يُقرَعُ",1,"ع",1,0],["إِنَّ الصَديقَ مُشَيَّعٌ","إِن جَلَّ خَطبٌ أَو خِطابُ",2,"ب",1,0],["إنّ الصّيامَ يهُزُّ عِطفَيْ شَهرِهِ","أجْرٌ بما زَعَمَ التّمَنّي كافِلُ",3,"ل",1,0],["إِنَّ الصَّدَاقَةَ لَفظَةٌ مَدْلُولُهَا","فِي الدَّهْرِ كَالْعَنْقَاءِ بَلْ هُوَ أَغْرَبُ",4,"ب",1,0],["إنَّ الصَّحَافَةَ فِيهِ عَزَّ عَزَاؤُهَا","مَا خَطْبُهَا فِي صَبِّهَا المُتَفَانِي",5,"ن",2,0],["إن الصبا كالورد في نضرته","وعمره واللون منه والشذا",6,"ا",1,0],["إن الصريمة لا يقوم يثقلها","إلا القوي بها وأنت ضعيف",7,"ف",1,0],["إِنَّ الصَنيعَةَ لا تَكونُ صَنيعَةً","حَتّى يُصابَ بِها طَريقُ المَصنَعِ",8,"ع",1,1],["إن الصناديد بني مَخْلد","لهم بإحياء النفوس التذاذْ",9,"ذ",1,0],["إِنَّ الصَنيعَةَ لا تَكونُ كَريمَةً","حَتّى تُقَلِّدُها كَريمَ نِجارِ",10,"ر",1,0],["إن الصديقَ هو اسْمُ معنىً لم نجدْ","من طالبيهِ في البريةِ واجدا",11,"د",2,0],["إنَّ الصِّغارَ صغيرةٌ","فاغْشَ الكبائرَ والكِبارا",12,"ر",2,0],["إِنَّ الصَوارِمَ وَاللِحاظَ تَعاهَدا","أَن لا أَزالَ مُزَمَّلاً بِدِمائي",13,"ا",2,0],["إِنَّ الصَديقَ إِذا رَأَكَ مُخالِفاً","لِهَواهُ بَدِّلَ وِدَّهُ بِعُقوقِ",14,"ق",1,1],["إِنَّ الصَديقَ يُريدُ بَسطَكَ مازِحاً","فَإِذا رَأى مِنكَ المَلالَةَ يُقصِرُ",15,"ر",1,1],["إِنَّ الصَديقَ إِذا تَأَكَّدَ حَقُّهُ","بِالوُدِّ أَغلَظَ في العِتابِ وَعَنَّفا",16,"ف",2,0],["إِنَّ الصُدورَ الَّتي بِالغِلِّ مُشحَنَةٌ","لَو قُطِّعَت بِلَهيبِ النارِ ما رَجَعَت",17,"ت",1,0],["إنّ الصوارمَ في فتح الحصون لها","ضربٌ به تُخْتَلى الأجياد والقممُ",18,"م",1,0],["إِنَّ الصَفائِحَ مِنكِ قَد نُضِدَت عَلى","مُلقى عِظامٍ لَو عَلِمتِ عِظامِ",19,"م",1,0],["إِنَّ الصَغيرَةَ قَد تَجُرُّ عَظيمَةً","وَلَرُبَّما أَودى بِشاهٍ بَيدَقُ",20,"ق",1,0],["إِنّ الصَنائعَ للحياةِ وَسيلةٌ","فَتعاونوا طُرّاً عَلى إحيائِها",21,"ا",3,0],["إِنّ الصَليبَ عَلى جَهالةِ أَهلِهِ","ليرى سَبيلَ المُصلِحينَ وَيَعرِفُ",22,"ف",1,0],["إِنَّ الصَفيَّ بنَ النَبيتِ مُملِكاً","أَعلى وَأَجوَدُ مِن هِرَقلَ وَقَيصَرا",23,"ر",2,1],["إِنَّ الصَينعَةَ لا تَضيعُ إِذا اِنتَهَت","مِنكُم إِلَيَّ وَإِن أَغَبَّ مَزاري",24,"ر",2,0],["إِنَّ الصَبوحَ جِلاءُ كُلِّ مُخَمِّرٍ","بَدَرَت يَداهُ بُكَأسِهِ الإِصباحا",25,"ح",2,0],["أَنا لِصَرورَةِ في الحَياةِ مُقارِنٌ","ما زُلتُ أَسبَحُ في البِحارِ المُوَّجِ",26,"ج",1,1],["إنّ الصّروفَ كما علِمتَ صَوَامتٌ","عَنّا وكل عبارَةٍ في صَمتِها",27,"ت",3,0],["إن الصديق من الرجال هُوَ الَّذي","إن غبت يحفظ غيبتي كحضوري",28,"ر",2,0],["إن الصباح شَبيه","في لونه بالمَساء",29,"ا",2,0],["إن الصبابات أعلنتْهُ","وَعذَّبته وأَوهنتْهُ",30,"ه",1,0],["إِنَّ الصراحة تغنى","ما لَيسَ تغني الرموزُ",31,"ز",1,1],["إن الصبي ما تغذيه اغتذى","فاكثر عليه في المثال المحتذى",32,"ذ",2,0],["إِنَّ الصِّحَافَة حَوْمَةُ الأَقْلامِ لاَ","مَرْمَى القِدَاحِ وَمَلْعَبُ الأَيْسَارِ",33,"ر",1,0],["إِنَّ الصِّحَافَةَ مَوْسُوعَاتُ مَعْرِفَةٍ","يُزَوَّدُ العَقْلُ مِنْهَا خَيْرَ تَزْوِيدِ",34,"د",1,0],["إِنَّ الصَّفَاءَ لِلرِّفَاءِ وعْد","وَلْتَكُنِ الدَّارُ الَّتِي ابْتَنَيْتُمَا",35,"م",2,0],["إنّ الصعيدَ لمُزْدَهٍ بأميرِهِ","جَذْلانُ يصدَحُ بالثناء ويجهر",36,"ر",1,0],["إن الصحافَةَ أنتم أسُّ نَهضتها","لولاكمو، لم تقم للصُّحْف عمدان",37,"ن",1,0],["إن الصديق رأيته متعلقاً","فهو العدوُّ وحقُّه يُتَجنَّبُ",38,"ب",1,0],["إن الصاديد بني مَخلد","لهم بإحياء النفوس التذاذْ",39,"ذ",1,0],["إن الصعاليك اخواني وإن لهم","حقاً به لو شعرتم لم تلوموني",40,"ي",1,0],["إن الصنائع أطواق إذا شكرت","وان كفرن فاغلال لمنتحل",41,"ل",1,0],["إن الصلاة بكم تَصِحُّ وذكرُكم","تتميمُها في فَرْضها أو نَفْلِها",42,"ل",3,0],["إن الصَّبوح هو السرورُ بأَسِهِ","وهْوَ اللذاذةُ والنعِيمُ الكامِلُ",43,"ل",1,1],["إن الصَّبا ضَيفٌ أخافُ رَحيلَهُ","فلهُ الكرامةُ والبشاشةُ منّي",44,"ي",1,0],["إن الصحابةَ والأنصارَ قد حفظوا","عهدَ النبيِّ وكانوا عنه نوّابا",45,"ب",2,0],["إنّ الصعاب وإن أعيت رياضتُها","من المنايا لتدويخٍ وتخييسِ",46,"س",1,0],["إِنَّ الصَديقَ الصادِقا","من فرَّج المَضايقا",47,"ق",2,0],["إِنَّ الصَبابَةَ في عُذوبَةِ شُربُها","كَم جَرَعَت غُصَصاً لَنا في صَوبِها",48,"ه",2,0],["إِنَّ الصَبابَةَ ما دامَت مُقَدَّرَةً","أَظهِر عَلَيها لَدى العُذّالِ مَقدِرَة",49,"ه",1,0],["إنّ الصّنائعَ والأياديَ في الورَى","غَرْسُ المودّةِ والقِلَى فتدَبّر",50,"ر",1,0],["إنّ الصَّديقَ إذا اكتفَى","ورأى غناءاً عَنْكَ مَلّ",51,"ل",1,0],["إن الصلاة من الرحمن واجبة","للآل من آمنوا باللّه والكتب",52,"ب",1,1],["إِن الصناعةَ يا أَشلُّ مُهنَّدٌ","ماضِي الغِرارِ محلُّه لِلضَّاربِ",53,"ب",1,0],["إنَّ الصلات لبيت الله ماضيةٌ","من عازبٍ ببلادِ الصين مُعتزلِ",54,"ل",1,0],["إن الصديق على القريب مفضل","ما العم في مقداره والخال",55,"ل",1,0],["إن الصنائع في الكرام ودائع","تبقى وإن فني الزمان بأسره",56,"ر",2,0],["إن الصيام مضى وقد أودعته","عملاً كما شاء التقى متقبلا",57,"ل",2,0],["إِنَّ الصِبا وَعَرَت عَلَيكَ سَبيلُهُ","فَتَنَكَّبَت بِكَ عَن وِصالِ الخُرَّدِ",58,"د",1,0],["إن الصغيرَ يَرَى في نفسهِ صِغَراً","عند الكبارِ سواهم حينما يَفِدُ",59,"د",1,0],["إنَّ الصَّديقَ هُوَ المُقيمُ على الوَفا","في وَقتِ ضَنْكِ العَيشِ لا في رَغدِهِ",60,"د",2,0]]}