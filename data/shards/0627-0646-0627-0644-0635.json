x?id=215993",""],[5612,"فرْضُ عَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=181417",""],[5686,"يا قدس جئنا","https://www.poetsgate.com/ViewPoem.aspx?id=203544",""],[5720,"الصَّلَاةُ عَلَىٰ النَّبِيِّﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=199187",""],[5725,"الى العراق","https://www.poetsgate.com/ViewPoem.aspx?id=203570",""],[5827,"الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=208734",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[5952,"لو فيه أفنيْ الحبرَ والقرطاسا","https://www.poetsgate.com/ViewPoem.aspx?id=202324",""],[5956,"تتسلق عيناي عيونَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193890",""],[5956,"هذي الردينة والإيادُ.. أحِبتي","https://www.poetsgate.com/ViewPoem.aspx?id=194112",""],[5956,"إنَّ الصداقة تبدو في حقيقتها","https://www.poetsgate.com/ViewPoem.aspx?id=194173",""],[5977,"سعادة وأمان","https://www.poetsgate.com/ViewPoem.aspx?id=212739",""],[6068,"حيّ الخريدة حبّة الايناس -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175898",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[6167,"الصوارمى يتذكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85545&r=&rc=28",""],[6204,"إلى صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69140&r=&rc=12",""]],"verses":[["إِنَّ الصَحائِفَ لا يَقريكَ باطِنُها","نَفسَ الطَوابِعِ مَوسوماً عَلى الطِيَنِ",0,"ن",1,0],["إِنَّ الصَفا العاديَّ يُقرَعُ بِالأَذى","مِن غَيرِكُم وَصَفاكُمُ لا يُقرَعُ",1,"ع",1,0],["إِنَّ الصَديقَ مُشَيَّعٌ","إِن جَلَّ خَطبٌ أَو خِطابُ",2,"ب",1,0],["إنّ الصّيامَ يهُزُّ عِطفَيْ شَهرِهِ","أجْرٌ بما زَعَمَ التّمَنّي كافِلُ",3,"ل",1,0],["إِنَّ الصَّدَاقَةَ لَفظَةٌ مَدْلُولُهَا","فِي الدَّهْرِ كَالْعَنْقَاءِ بَلْ هُوَ أَغْرَبُ",4,"ب",1,0],["إنَّ الصَّحَافَةَ فِيهِ عَزَّ عَزَاؤُهَا","مَا خَطْبُهَا فِي صَبِّهَا المُتَفَانِي",5,"ن",2,0],["إن الصبا كالورد في نضرته","وعمره واللون منه والشذا",6,"ا",1,0],["إن الصريمة لا يقوم يثقلها","إلا القوي بها وأنت ضعيف",7,"ف",1,0],["إِنَّ الصَنيعَةَ لا تَكونُ صَنيعَةً","حَتّى يُصابَ بِها طَريقُ المَصنَعِ",8,"ع",1,1],["إن الصناديد بني مَخْلد","لهم بإحياء النفوس التذاذْ",9,"ذ",1,0],["إِنَّ الصَنيعَةَ لا تَكونُ كَريمَةً","حَتّى تُقَلِّدُها كَريمَ نِجارِ",10,"ر",1,0],["إن الصديقَ هو اسْمُ معنىً لم نجدْ","من طالبيهِ في البريةِ واجدا",11,"د",2,0],["إنَّ الصِّغارَ صغيرةٌ","فاغْشَ الكبائرَ والكِبارا",12,"ر",2,0],["إِنَّ الصَوارِمَ وَاللِحاظَ تَعاهَدا","أَن لا أَزالَ مُزَمَّلاً بِدِمائي",13,"ا",2,0],["إِنَّ الصَديقَ إِذا رَأَكَ مُخالِفاً","لِهَواهُ بَدِّلَ وِدَّهُ بِعُقوقِ",14,"ق",1,1],["إِنَّ الصَديقَ يُريدُ بَسطَكَ مازِحاً","فَإِذا رَأى مِنكَ المَلالَةَ يُقصِرُ",15,"ر",1,1],["إِنَّ الصَديقَ إِذا تَأَكَّدَ حَقُّهُ","بِالوُدِّ أَغلَظَ في العِتابِ وَعَنَّفا",16,"ف",2,0],["إِنَّ الصُدورَ الَّتي بِالغِلِّ مُشحَنَةٌ","لَو قُطِّعَت بِلَهيبِ النارِ ما رَجَعَت",17,"ت",1,0],["إنّ الصوارمَ في فتح الحصون لها","ضربٌ به تُخْتَلى الأجياد والقممُ",18,"م",1,0],["إِنَّ الصَفائِحَ مِنكِ قَد نُضِدَت عَلى","مُلقى عِظامٍ لَو عَلِمتِ عِظامِ",19,"م",1,0],["إِنَّ الصَغيرَةَ قَد تَجُرُّ عَظيمَةً","وَلَرُبَّما أَودى بِشاهٍ بَيدَقُ",20,"ق",1,0],["إِنّ الصَنائعَ للحياةِ وَسيلةٌ","فَتعاونوا طُرّاً عَلى إحيائِها",21,"ا",3,0],["إِنّ الصَليبَ عَلى جَهالةِ أَهلِهِ","ليرى سَبيلَ المُصلِحينَ وَيَعرِفُ",22,"ف",1,0],["إِنَّ الصَفيَّ بنَ النَبيتِ مُملِكاً","أَعلى وَأَجوَدُ مِن هِرَقلَ وَقَيصَرا",23,"ر",2,1],["إِنَّ الصَينعَةَ لا تَضيعُ إِذا اِنتَهَت","مِنكُم إِلَيَّ وَإِن أَغَبَّ مَزاري",24,"ر",2,0],["إِنَّ الصَبوحَ جِلاءُ كُلِّ مُخَمِّرٍ","بَدَرَت يَداهُ بُكَأسِهِ الإِصباحا",25,"ح",2,0],["أَنا لِصَرورَةِ في الحَياةِ مُقارِنٌ","ما زُلتُ أَسبَحُ في البِحارِ المُوَّجِ",26,"ج",1,1],["إنّ الصّروفَ كما علِمتَ صَوَامتٌ","عَنّا وكل عبارَةٍ في صَمتِها",27,"ت",3,0],["إن الصديق من الرجال هُوَ الَّذي","إن غبت يحفظ غيبتي كحضوري",28,"ر",2,0],["إن الصباح شَبيه","في لونه بالمَساء",29,"ا",2,0],["إن الصبابات أعلنتْهُ","وَعذَّبته وأَوهنتْهُ",30,"ه",1,0],["إِنَّ الصراحة تغنى","ما لَيسَ تغني الرموزُ",31,"ز",1,1],["إن الصبي ما تغذيه اغتذى","فاكثر عليه في المثال المحتذى",32,"ذ",2,0],["إِنَّ الصِّحَافَة حَوْمَةُ الأَقْلامِ لاَ","مَرْمَى القِدَاحِ وَمَلْعَبُ الأَيْسَارِ",33,"ر",1,0],["إِنَّ الصِّحَافَةَ مَوْسُوعَاتُ مَعْرِفَةٍ","يُزَوَّدُ العَقْلُ مِنْهَا خَيْرَ تَزْوِيدِ",34,"د",1,0],["إِنَّ الصَّفَاءَ لِلرِّفَاءِ وعْد","وَلْتَكُنِ الدَّارُ الَّتِي ابْتَنَيْتُمَا",35,"م",2,0],["إنّ الصعيدَ لمُزْدَهٍ بأميرِهِ","جَذْلانُ يصدَحُ بالثناء ويجهر",36,"ر",1,0],["إن الصحافَةَ أنتم أسُّ نَهضتها","لولاكمو، لم تقم للصُّحْف عمدان",37,"ن",1,0],["إن الصديق رأيته متعلقاً","فهو العدوُّ وحقُّه يُتَجنَّبُ",38,"ب",1,0],["إن الصاديد بني مَخلد","لهم بإحياء النفوس التذاذْ",39,"ذ",1,0],["إن الصعاليك اخواني وإن لهم","حقاً به لو شعرتم لم تلوموني",40,"ن",2,0],["إن الصنائع أطواق إذا شكرت","وان كفرن فاغلال لمنتحل",41,"ل",1,0],["إن الصلاة بكم تَصِحُّ وذكرُكم","تتميمُها في فَرْضها أو نَفْلِها",42,"ل",3,0],["إن الصَّبوح هو السرورُ بأَسِهِ","وهْوَ اللذاذةُ والنعِيمُ الكامِلُ",43,"ل",1,1],["إن الصَّبا ضَيفٌ أخافُ رَحيلَهُ","فلهُ الكرامةُ والبشاشةُ منّي",44,"ن",2,0],["إن الصحابةَ والأنصارَ قد حفظوا","عهدَ النبيِّ وكانوا عنه نوّابا",45,"ب",2,0],["إنّ الصعاب وإن أعيت رياضتُها","من المنايا لتدويخٍ وتخييسِ",46,"س",1,0],["إِنَّ الصَديقَ الصادِقا","من فرَّج المَضايقا",47,"ق",2,0],["إِنَّ الصَبابَةَ في عُذوبَةِ شُربُها","كَم جَرَعَت غُصَصاً لَنا في صَوبِها",48,"ه",2,0],["إِنَّ الصَبابَةَ ما دامَت مُقَدَّرَةً","أَظهِر عَلَيها لَدى العُذّالِ مَقدِرَة",49,"ه",1,0],["إنّ الصّنائعَ والأياديَ في الورَى","غَرْسُ المودّةِ والقِلَى فتدَبّر",50,"ر",1,0],["إنّ الصَّديقَ إذا اكتفَى","ورأى غناءاً عَنْكَ مَلّ",51,"ل",1,0],["إن الصلاة من الرحمن واجبة","للآل من آمنوا باللّه والكتب",52,"ب",1,1],["إِن الصناعةَ يا أَشلُّ مُهنَّدٌ","ماضِي الغِرارِ محلُّه لِلضَّاربِ",53,"ب",1,0],["إنَّ الصلات لبيت الله ماضيةٌ","من عازبٍ ببلادِ الصين مُعتزلِ",54,"ل",1,0],["إن الصديق على القريب مفضل","ما العم في مقداره والخال",55,"ل",1,0],["إن الصنائع في الكرام ودائع","تبقى وإن فني الزمان بأسره",56,"ر",2,0],["إن الصيام مضى وقد أودعته","عملاً كما شاء التقى متقبلا",57,"ل",2,0],["إِنَّ الصِبا وَعَرَت عَلَيكَ سَبيلُهُ","فَتَنَكَّبَت بِكَ عَن وِصالِ الخُرَّدِ",58,"د",1,0],["إن الصغيرَ يَرَى في نفسهِ صِغَراً","عند الكبارِ سواهم حينما يَفِدُ",59,"د",1,0],["إنَّ الصَّديقَ هُوَ المُقيمُ على الوَفا","في وَقتِ ضَنْكِ العَيشِ لا في رَغدِهِ",60,"د",2,0],["إنَّ الصديقَ لَيَستحيلُ تَغَيٌّراً","فيجيءُ مِنْ عُدْوانه بملخّصِ",61,"ص",1,0],["إنّ الصّديق إذا أبدى تغيُّرَهُ","لم يُبْقِ ممّا به يأتي ولم يَذَرِ",62,"ر",1,0],["إن الصوابَ جميعُ الناسِ تعرفُه","منْ لا له قدَرٌ لا يعرفُ القدَرا",63,"ر",2,0],["إنَّ الصِّبا فيه ذن","بُ الجاني يغَطَّى ويُغْفَرْ",64,"ر",1,0],["إنَّ الصداق لمهر العِرس وهولها","ملك تحل به والمهر قد شرعا",65,"ع",2,0],["إن الصبور الجَلْد من إن أقبلت","بجهاته زمر البلا كان البَطَلْ",66,"ل",1,0],["إنَّ الصَّديق الصرْف من","يحيى عليك ومن يموت",67,"ت",1,0],["إن الصلاة أفضل الاعمال","وإنها الربح ورأس المال",68,"ل",1,0],["إِنَّ الصُّدودَ لَعَذْبٌ مَرُّ مَورِدِهِ","عِنْدي لِمَنْ لم يُوفقْ حالَهُ حالي",69,"ل",2,0],["إن الصديقَ فلا تأمَنْ بوائقَه","دون العدوِّ إذا ما سُؤْته ثأرا",70,"ر",2,0],["إن الصبا والحسن لم يبلغا","بعد بيوت الشعر من موئل",71,"ل",1,0],["إنِ الصبا خفقت خلالَها طفقت","تختالُ واصطَفقْت ما بينها العُذُرُ",72,"ر",1,0],["إن الصَّدارة لم يصلحْ سواكَ لها","كأنَّها أبداً عينٌ وأنتَ كرى",73,"ر",2,0],["إنَّ الصواعقَ لا يحلُّ بلاؤُها","إلاَّ على الأطوادِ والأركان",74,"ن",1,0],["إن الصبابةَ لا يبرّد نارها","ثلج وهي ثلج يبرّد ناري",75,"ر",2,0],["إن الصوامتَ في الوجوه بيانُها","يسمو بلاغةَ ناطق مكثار",75,"ر",1,0],["إن الصنائع في الكرام ودائع","تبقى ولو فنى الزمان بأسره",76,"ر",2,0],["ان الصبا في حسن تسياره","قد جعد الماء بتياره",77,"ه",1,0],["إنَّ الصدودَ في الهوى كالملَلِ","ومُدلَهِمَّ وجْهِهِ كالظُّلَلِ",78,"ل",1,0],["إنَّ الصبابةَ واللَّطافةَ والحيا","علمٌ عليه يدلُّ من أسمائِهِ",79,"ا",3,0],["إنّ الصباحَ من أجل العين أبرزه","والحبُّ للروح فانظر حالة الفارق",80,"ق",1,0],["إنَّ الصباح قديمٌ للنوى وكذا","للحبِّ وهو لهذا الهائم الرامق",80,"ق",1,0],["إنّ الصيامَ له العلوُّ جلالة","صام النهارُ إذا النهار تعالى",81,"ل",2,0],["ان الصبا رق وجدا في محاسنه","فقام في امره بعضا من الرسل",82,"