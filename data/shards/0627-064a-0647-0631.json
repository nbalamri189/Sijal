{"poems":[[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141971","الخفيف"],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[201,"أسفر الصبح قم نحيي الصباحا","https://www.aldiwan.net/poem39883.html","الخفيف"],[295,"أبشري يا دمشق بالأبطال","https://www.aldiwan.net/poem11669.html","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205784","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29282","الخفيف"],[5190,"رائيل","https://www.poetsgate.com/ViewPoem.aspx?id=104370",""],[5277,"قميصُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=191116",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5431,"إيه ربي...","https://www.poetsgate.com/ViewPoem.aspx?id=211341",""]],"verses":[["إِيه روح الشَهيد زوري فَلَسطي","ن وَطوفي قَدسيةً بِالمَغاني",0,"ن",2,0],["إيه ريحانةَ الرياحين فيضي","مرحاً واملإي الجوانحَ وجدا",1,"د",2,0],["إيه رهين المحبسين ألم يئن","إطلاق مأسور وفكّ سراح",2,"ح",1,0],["أَيهربُ العبدُ مِن تقريب سيّدهِ","وَسيّدُ العبدِ يَدنو حين مهربهِ",3,"ب",2,0],["إيه رُبّان زورقي هاك قلبي","إنّني قد جعلته ملّاحا",4,"ح",2,0],["أيه رمزَ الأمجاد رفرِف على الدهر","وكن عالياً مدى الأجيال",5,"ل",1,0],["إيه ردي إليَّ عمري فهذي","شمس عمري قد آذنت بفوات",6,"ت",1,0],["إيه رمسيس يا مخلد ذكرا","ك على الصخر في العصور الأولى",7,"ل",2,0],["إيه رمسيس إن علوت على السف","ح وأرسلت ناظريك مجيلا",7,"ل",2,0],["ايهِ رَبّاهُ ما أَراهُ أَمامي","أَيُّ نورٍ في أَيُّما أَسدافِ",8,"ف",1,1],["إِيهِ \" رَائِيلُ \" لَن نَلُومَكِ بَعدَ اْل","يَومِ ، كَلاَّ ، ولَن نَخُونَ يَمِينَا",9,"ن",2,0],["ايه( رُباحُ)...وما زالَ العتاب نوىً","والروحُ ولهىً ( وسارتْ بالهوى الإبلُ).",10,"ل",1,0],["إيه رب التاج قد شاء القضا","لا أرى التعليل إلا فندا",11,"د",2,0],["إيه ربي معذبا فك أسره","وتولى رخاءه وامح عسره",12,"ه",1,1],["إيه ربي أليس للذبح نذر","فخذ الروح منحة واقض أمره",12,"ه",1,0]]}