7.html","الوافر"],[197,"هي الأفلاك لا شم القباب","https://www.aldiwan.net/poem45404.html","الوافر"],[205,"ترى الرجل النحيف فتزدريه","https://www.aldiwan.net/poem27875.html","الوافر"],[219,"أيسلو فؤادي أو أكتم","https://www.aldiwan.net/poem55305.html","المتقارب"],[221,"كيف لا أندب أمسي","https://www.aldiwan.net/poem41625.html","مجزوء الرمل"],[221,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[221,"هذه القصة لا شأن لها","https://www.aldiwan.net/poem41916.html","الرمل"],[227,"ضعيف الهوى والرأي من جدد البشرى","https://www.aldiwan.net/poem51008.html","الطويل"],[229,"ما ذا أثار بقلبي السائق الغرد","https://www.aldiwan.net/poem44592.html","البسيط"],[235,"يا جميل الصبر لب من دعا","https://www.aldiwan.net/poem19492.html","الرمل"],[268,"تعالي فأحييني بفنجان قهوة","https://www.aldiwan.net/poem35265.html","الطويل"],[268,"يا ليلة الحب أغري الغيم بالقمر","https://www.aldiwan.net/poem35334.html","البسيط"],[268,"أرى الصب لا يرضى بنصح نهاته","https://www.aldiwan.net/poem35374.html","الطويل"],[268,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[301,"يا هذه إن للأشعار معجزة","https://www.aldiwan.net/poem58074.html","البسيط"],[318,"أيا حامل الرمح الشبيه بقده","https://www.aldiwan.net/poem67089.html","الطويل"],[351,"وافى بوضاح الجبين صبيحه","https://www.aldiwan.net/poem40556.html","البسيط"],[362,"تظلم من طرف ظبي رخييم","https://www.aldiwan.net/poem60647.html","المتقارب"],[364,"سأركب بحر الهوى مقدما","https://www.aldiwan.net/poem17056.html","المتقارب"],[377,"بالذي أسكر من عرف اللما","https://www.aldiwan.net/poem48806.html","الرمل"],[397,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[406,"لما بلغت من الحياة إلى مدى","https://www.aldiwan.net/poem31711.html","عموديه"],[434,"ولى فأسرع في الفراق وما شفى","https://www.aldiwan.net/poem2558.html","الكامل"],[438,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[438,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[450,"يا ابن أبي الخير ويا من غدت","https://www.aldiwan.net/poem13814.html","السريع"],[456,"لا لنوازي كبد هاجها","https://www.aldiwan.net/poem56080.html","السريع"],[456,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[456,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[459,"ضعي لامتداحي ما استطعت من العذر","https://www.aldiwan.net/poem15104.html","الطويل"],[459,"يقر بعيني أن يعيش بغبطة","https://www.aldiwan.net/poem15667.html","الطويل"],[459,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[462,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[462,"أما النسيم فما يغب وروده","https://www.aldiwan.net/poem3545.html","عموديه"],[462,"ما للمطايا تكثر الحنينا","https://www.aldiwan.net/poem3574.html","عموديه"],[498,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[513,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[549,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[549,"ومنتقبات بالجمال على منى","https://www.aldiwan.net/poem47763.html","الطويل"],[560,"على رسم هاتيك الديار البلاقع","https://www.aldiwan.net/poem52872.html","الطويل"]],"verses":[["ضَعيفَةُ رَجعِ النَّاظرَينِ خَريدَةٌ","يَرِقُّ لأَثناءِ الوِشاحِ إِزارُها",0,"ر",3,0],["ضَعيفُ وِكاءِ الكيسِ لا جارُهُ أَذٍ","وَلا ضَيفُهُ بِالمَنزِلِ المُتَضايقِ",1,"ق",1,0],["ضَعيفَةُ رَجعِ القَولِ مِن تَرَفِ الصِّبا","لَها نَظرَةٌ تُنسيكَ ما يَفعَلُ النَّصلُ",2,"ل",1,0],["ضَعوا القُلوبَ أَساساً لا أَقولُ لَكُم","ضَعوا النُضارَ فَإِنّي أُصغِرُ الذَهَبا",3,"ب",2,0],["ضِعتَ بَينَ النُهى وَبَينَ الخَيالِ","يا حَكيمَ النُفوسِ يا اِبنَ المَعالي",4,"ي",1,1],["ضِعتَ في الشَرقِ بَينَ قَومٍ هُجودٍ","لَم يُفيقوا وَأُمَّةٍ مِكسالِ",4,"ل",1,0],["ضَعِي عَلَى عَيْنَيْكِ بَلُّورَةً","لِتَسْلَمِي مِنْ وَهَجِ الهَاجِرَهْ",5,"ه",1,1],["ضعيف يَصِحُّ النصر من فتكاته","فيُروى لنا منه الصحيحُ المضعّفُ",6,"ف",1,0],["ضعفت مباني كل أمرٍ عندهم","ما بين هادمها وبين الباني",7,"ن",2,0],["ضَعيفُ العُرى دانٍ مِنَ الأَرضِ بَركُهُ","مُسِفٍّ كَمِثلِ الطَودِ أَكظَمَ أَسحَمِ",8,"م",1,0],["ضعفٌ تضاعف في فكري وفي بدني","حتَّى تحيف إسراري وإعلاني",9,"ي",1,0],["ضعُفنَ وكان الضعفُ منهنَّ قوةً","فهنَّ على الألبابِ مقتدراتُ",10,"ت",1,0],["ضعيف على المرء الضعيف وإنه","لأشوسُ عدَّاءٍ على الدهرِ قاسط",11,"ط",1,0],["ضعيف اللُّتيّا في الدماغ سخيفها","قوي اللُّتيا في الحتار لذوعها",12,"ع",3,0],["ضَعفُ العوامل في أسنَّتها","ضعفُ المغازل عنه في الفلك",13,"ك",1,0],["ضَعُفَت حَوامِلُهُ فَمالَ إِلى اِستِها","في الغَيِّ إِنَّ مُحارِباً لَضَلولُ",14,"ل",1,0],["ضُعَفاءٌ مُحَقَّرونَ كَأَنّا","مِن ظَلامٍ وَالناسُ مِن لَألاءِ",15,"ا",2,0],["ضَعيفُ الخُطى بادي النُحولِ كَأَنَّما","يُشَدُّ إِلى قَيدٍ يُشَدُّ إِلى حَبسِ",16,"س",1,0],["ضَعُفَت قَوائِمُها وَلَمّا تَرعَوي","عَن غَيِّها حَتّى تَزولَ وَتُمحَقا",17,"ق",2,0],["ضَعُفَت فَلا عَجَبٌ إِذا اِهتُضِمَت","اللَيثُ لَولا بَأسُهُ اِهتُضِما",18,"م",2,0],["ضَعيفُ العَصا بادي العُروقِ تَرى لَهُ","عَلَيها إِذا ما أَجدَبَ الناسُ إِصبَعا",19,"ع",2,1],["ضِعافُ القُوى لَيسوا كَمَن يَبتَني العُلا","جَعاسيسُ قَصّارونَ دونَ المَكارِمِ",20,"م",1,0],["ضُعْفُ العزيمَةِ لَحْدٌ في سَكينَتِهِ","تقضي الحَيَاةُ بَنَاهُ اليأسُ والوجلُ",21,"ل",1,1],["ضعف الناس عن أداءِ البقايا","والذي ما غدا ضعيفاً سيغدو",22,"د",2,0],["ضَعفَي وكم أبلين من ذى قوّة","مرضى وكم أفنَين من عُوّاد",23,"د",1,0],["ضعيفين لا نعطى حَراكا على الدجى","كلانا عليه مُقعد وعثور",24,"ر",1,0],["ضَعُفُوا كأفراخ الحمام","فمن لهم عطفا وزقا",25,"ق",2,0],["ضَعفى تَعِفُّ الأَيادي عَن مِثالِهِمِ","مِنَ الأَعادي وَإِن هَمّوا بِهِم نَزَعوا",26,"ع",3,0],["ضَعُفَ الطالِبُ المُعَنّى وَلَم تَضعُ","ف عَلى البُعدِ مُهلَةُ المَطلوبِ",27,"ب",1,0],["ضَعُفَ الدَهرُ عَن هَوانا وَما الدَه","رُ عَلى كُلِّ دَولَةٍ بِقَديرِ",28,"ر",1,0],["ضَعَةٌ لِلزَمانِ عِندي وَعَكسُ","إِذ تَوَلّى بِزُرجَسابورَ جِبسُ",29,"س",1,1],["ضَعَةٌ بي إِن لَم أَنَل بِمَكاني","مِنكَ عِزّاً مُستَأنَفاً في مَكاني",30,"ن",2,0],["ضَعُفَتْ معاقِدُ خصرِه وعهودُه","فكأنّ عَقْدَ الخصرِ عَقْدُ وَفَائِه",31,"ا",3,0],["ضَعُفَ المِسكينُ عَن تِلكَ المِحَن","بِهَلاكِ الروحِ مِنهُ وَالبَدَن",32,"ن",1,0],["ضَع مِنَّةً وَاُجلُ المُدامَ لَنا","فيها مِنَ الأَيّامِ نَستَقضي",33,"ي",1,0],["ضُعفُ رَأسي وَقِلَّةُ الإيمانِ","أَوجَبا ما رَأَيتَ مِن هَذَياني",34,"ي",1,1],["ضعضع الجسم عزم روحي المُعَنَّى","يا أخا الروح بُث فيه قواكا",35,"ك",2,0],["ضَعُفتُ عن النّهْضِ القوي زَمَانَةً","وَنُقّلَ بعد الباع خَطوي إِلى شِبرِ",36,"ر",1,0],["ضَعُفَت جَوارِحُ مَن أَذاقَتهُ النَوى","طَعمَ الفِراقِ فَذَمَّ طَعمَ العَلقَمِ",37,"م",1,0],["ضِعافُ القلوبِ قُعودٌ جُمودُ","يخافون كلَّ سَفوحِ دَفُوقْ",38,"ق",1,0],["ضَعِيفاً قَعِيعَ الصَوتِ لَذّاً دَلالُهُ","غَضِيضَ سَوامِ الطَرفِ في المَشِي أَخرَقا",39,"ق",2,0],["ضَعِيفِ البَطشِ ذي كَيدٍ شَدِيدٍ","بِنَظرَتِهِ إِذا أَومى سَؤُوم",40,"م",1,0],["ضَعيفَةٌ أَجفانُهُ","وَالقَلبُ مِنهُ حَجَرُ",41,"ر",1,0],["ضَعِ السّلاحَ فهل حُدّثتَ عن رَشَإٍ","في مَشْرَفيٍّ صَقيلٍ أو رُدَينيّ",42,"ي",1,0],["ضَعيفَةُ كَرَّ الطِرفِ تَحسَبُ أَنَّها","حَديثَةُ عَهدٍ بِالإِفاقَةِ مِن سُقمِ",43,"م",1,0],["ضَعضَعتُ حَبَّةَ جِلدِهِ بِقَصيدَةٍ","وَرَدَت قُرَيشٌ دُونَها يَعبورُ",44,"ر",1,0],["ضَعضَعتُ جَنَّةَ خالِدٍ","بِعَزيمَةٍ لا تُقرَبُ",45,"ب",1,0],["ضَعيفُها مِثلُ فَرا نَيسَبٍ","فَرَّ حِذاراً مِن فَرانيسِها",46,"س",3,0],["ضَعفُنا عَنِ الأَشياءِ إِلّا عَنِ الأَذى","وَقَد يَسِمُ الوَجهَ الكهامُ المُثَلَّمُ",47,"م",1,0],["ضَعُفْتَ عن الإصْباحِ واللّيلُ ذاهبٌ","كما فَنيَ المِصْباحُ في آخرِ الوَهْنِ",48,"ن",1,0],["ضعفى تعفّ الأعادي عن مثالهم","من الأعادي وإن همّوا بهم نزعوا",49,"ع",3,0],["ضعفت عن كيدهم غير أن","اللّه بالحكمة قواني",50,"ي",1,1],["ضَعِ السَيفَ وَاِقتُل مُهجَتي بِمَحاجِرٍ","مراضٍ وَإِن تَختَر فَغَير مِراضِ",51,"ض",1,0],["ضَع يَداً عَلى كَبِدٍ","آه مِن تَفَطُّرِها",52,"ر",3,0],["ضَعيفُ جِسمٍ قَوِيُّ عَزم","تَعنو الصِعابُ الّتي يَروضُ",53,"ض",1,0],["ضَعُفتْ منه القُوَى فَغَدَتْ","مِن قَوارِير قَوَارِحُهُ",54,"ح",2,0],["ضعوا مقاليد أمر الشعب في يده","ما صرَّفت أمرَهُ يمنى كيمناه",55,"ا",2,0],["ضعيف الخطى،بادي التحول كأنما","يشدّ إلى قيد، يشدّ إلى حبس",56,"س",1,0],["ضَعُفَ العوامل في أسنَّتها","ضعفُ المعازل عنه في الفلك",57,"ك",1,0],["ضعيف الركنِ ، مخذولاً ، مضاعا","غريقٌ حاولت يَدُه شِراعاً",58,"ا",1,0],["ضعفت عَن السَير نَحو الرُبا","وَحَث الكُؤس وَشَمّ الزَهر",59,"ر",1,1],["ضَعُفَتْ حِيلَتِي فأيُّ اعتذِارٍ","ليلةَ القَبْرِ مُؤنِسي في تُرابِكْ",60,"ك",1,0],["ضعف القلب عن هواه وما القلب","على كل ذي جمال بجلد",61,"د",1,0],["ضعف الصائد عن ظبي","كثير الوثبات",62,"ت",1,0],["ضَعُفَت صَولَةُ القَرِيحَةِ عَنهُ","فَأبَى الوَزنُ مِنهُ أن يَستَقِيمَا",63,"م",2,0],["ضعيفاً يُرجِّي من ضعيف إغاثةً","لقد غلط الإدراكُ وانعكس الفهم",64,"م",1,0],["ضَعُوا فَوقَ قَلبي رَاحَةَ الصَّبرِ إنَّني","فَنِيتُ وَلَم أنهَض بِبسَطٍ ولا قَبضِ",65,"ض",1,1],["ضَعُفتُ فقَواني التَّعَلُّلُ بالمُنى","وَكَم طَمَعٍ مَحضٍ لِذِي كَرَمٍ مَحضِ",65,"ض",1,0],["ضِعافُ اليَتامى وَالأَرامِلِ عِندَهُ","لَدى ديمَةٍ هَطلاءَ في زَهَرٍ غَضِّ",66,"ض",1,0],["ضَعُفتُ عَنِ الكُلِّ الَّذي هُوَ واجِب","فَلَوَّحتُ تَلويحَ الضَرورَةِ بِالبَعضِ",66,"ض",1,0],["ضَعيفُ القُوى رِخوُ العِظامِ كَأَنَّهُ","حِبالٌ نَضَتهُ مُبطِئاتٌ مَحامِرُ",67,"ر",1,0],["ضعفت وقدما كنت جهلا ممارسا","على عزماتي ف الخطوب هجوم",68,"م",1,1],["ضع الأعمى ولا يثنيك خوف","ولا حرج بكفة منجنيق",69,"ق",1,0],["ضِعافُ النُهى أعرابُ نجدٍ جدودهم","وَقَد أَورَثوهم عنهمُ الزورَ والوِزرا",70,"ر",2,0],["ضَعُفَ الإيمانُ فيهم والأمان","ودُّهُم مَذقٌ وجَدواهم وعود",71,"د",1,0],["ضعيفةٌ طرفاً وخصراً فما","يُطيقُ ذا اللحظَ ولا ذا النِّطاق",72,"ق",1,0],["ضعافٌ غيرَ أنَّ لهنَّ رأياً","يسددهُ إلى القصدِ الصوابُ",73,"ب",1,0],["ضعيفٌ وهو أقوى من عليها","قويٌّ وهو أضعفُ من ذبابِ",74,"ب",1,0],["ضِعافُ الطَيرِ أَطوَلُها جُسوماً","وَلَم تَطُلِ البُزاةُ وَلا الصُقورُ",75,"ر",1,0],["ضِعافُ الأُسدِ أَكثرُها زَئيراً","وَأَصرَمُها اللَواتي لا تَزيرُ",75,"ر",1,0],["ضعاف النفوس ضعاف العقو","ل وقد عز من بيننا الأحزم",76,"م",1,0],["ضعفتُ روحي بِصَدري","وَتَلاشَت في الفُؤاد",77,"د",1,0],["ضَعضَعته ذِكرى أَمرَّت عَلَيهِ","جَنحَها وَاِستَفاقَ يَنفُثُ جَمرا",78,"ر",2,0],["ضَع عَلى الأَبواقِ يُمناكَ وَقل","إِنَّني آمَنتُ بِاللَهِ المُجيب",79,"ب",1,0],["ضعيف الهوى والرأي مَن جدّد البشرى","وهنّا أمير المؤمنين بها وِترا",80,"ر",2,1],["ضعف أضيف إلى ضعف وبعضهما","يوهي قوى الجسم مني وهو منفرد",81,"د",1,0],["ضَعْضَعَ الْمَوْتُ الإِمَامَ الأَرْوَعَا","أَيُّ رُكْنٍ لِرَشَادٍ ضَعْضَعَا",82,"ع",2,0],["ضَعي فوقها المقهاةَ حتى إذا غَلت","ضَعي البنَّ وائتينا بأطيَب قهوة",83,"ه",1,0],["ضَعي على عُنُقي رأساً بهِ اجتَمَعَت","كلُّ المحاسنِ من نورٍ ومن زهر",84,"ر",1,0],["ضعيفٌ أنا وهي القويةُ في الهوَى","سلوا العصرَ منهُ كيفَ حالُ دهاته",85,"ت",2,0],["ضَعي كفَّيكِ في يَدِهِ وقُولي","صَدَقتَ فكن زَعيمَ الأفضلينا",86,"ن",2,0],["ضعى بنانك محضوباً على جسدي ال","بالي ليجتمع العناب والحشف",87,"ف",1,0],["ضَعِ الرُمحَ وَاِغمِد ما سَلَلتَ فَرُبَّما","قَضى كُلُّ مُضني بِالجَوى وَالهَوى نَحبا",88,"ب",2,0],["ضَعها عَلى المَذبوح ثاني مَرَّةٍ","وَأَنا الضَمين لَه بردِّ حَياتِهِ",89,"ه",1,0],["ضِعافُ الهُبوبِ ولكنْ بها","تَخرَّقَ عنّي غَمامُ الغُموم",90,"م",1,0],["ضَعيفَينِ مِن جَفنِهِ وَالوِدادِ","فَلَيتَ الضَعيفَ لِضَعفي يَرِق",91,"ق",1,0],["ضَع عَلى صَدريَ يَمناك فَما","أَجدَر الماء بِأَن يَطفي اللَهَب",92,"ب",1,0],["ضَعْفُنا، قُوَّةُ العدوِّ، ولول","ضَعْفُ قومي، ما حالَفوا التِّنِّينا",93,"ن",2,0],["ضعفت قواي وخانني الثقتان من","بصري وسمعي حين شارفت المدى",94,"د",2,0],["ضعفت عهودك لي ونحن بذي الحمى","لكن صبري راح منها أضعفا",95,"ف",2,0],["ضعيف الحيل مظلوم مهان","وذو الأَموال يظلم ما عداها",96,"ا",3,0],["ضعضعت أركان الأباضي والرجا","بك أشيد وكان لا يتضعضع",97,"ع",1,0],["ضَعْ حلية الآدابِ وابعَثْ لنا","عارِيةً منك بنقط العروسْ",98,"س",1,0],["ضعُفتُ تحت الغمز من عاجمٍ","يصرَعُ لبِّي وهو خَوَّارُ",99,"ر",1,0],["ضعي أهَبَ الحرب واستسلمي","لمالكِ أمرك واستضرعي",100,"ع",2,0],["ضعيفُ جناحِ الحشا بائحُ ال","لسان بما ضمَّ منه الضميرُ",101,"ر",1,0],["ضعي لامتداحي ما استطعت من العذر","سأغسل عني بالعُلى دَرنَ الشعرِ",102,"ر",1,1],["ضعيفٌ بأدْنى العارِ لا يستطيعهُ","نَهوضٌ بعبءِ المجدِ وهو ثقيلُ",103,"ل",1,0],["ضعوا أثْقالكُم بحِمى إِمامٍ","تُقاهُ قبل مَلْبسِهِ شِعارُ",104,"ر",1,0],["ضعيفةُ عقدِ الخصر والعهدُ عطفها","تميل مع الواشين والغصن ميّال",105,"ل",1,0],["ضعفتْ يداي عن الهوى وتنا