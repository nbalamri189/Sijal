{"poems":[[63,"خلا الجزع من سلمى وهاتيك دارها","https://www.aldiwan.net/poem45717.html","الطويل"],[63,"ألا ليت شعري هل أرى أم سالم","https://www.aldiwan.net/poem45785.html","الطويل"],[63,"ألا ليت شعري هل تخب مطيتي","https://www.aldiwan.net/poem45820.html","الطويل"],[86,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[86,"ضعت بين النهى وبين الخيال","https://www.aldiwan.net/poem10945.html","الخفيف"],[93,"ضعي على عينيك بلورة","https://www.aldiwan.net/poem11138.html","السريع"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[72,"العيد أنت وهذا عيدنا الثاني","https://www.aldiwan.net/poem20159.html","البسيط"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"سبحان مجري الفلك والفلك","https://www.aldiwan.net/poem65811.html","أحذ الكامل"],[29,"بئس الفوارس عند معترك القنا","https://www.aldiwan.net/poem6062.html","الكامل"],[91,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[91,"أقص عليكم ما جرى لي بالأمس","https://www.aldiwan.net/poem8975.html","عموديه"],[91,"أزف الرحيل وحان أن نتفرقا","https://www.aldiwan.net/poem8988.html","عموديه"],[91,"ما عز من لم يصحب الخذما","https://www.aldiwan.net/poem62738.html","عموديه"],[38,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[38,"فإن كنت يا ابن السمط سالمت دوننا","https://www.aldiwan.net/poem7813.html","البسيط"],[92,"ضعف العزيمة لحد في سكينته","https://www.aldiwan.net/poem38923.html","البسيط"],[89,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[85,"عبد المجيد","https://www.aldiwan.net/poem7521.html","مجزوء الكامل"],[43,"غيري بأكثر هذا الناس ينخدع","https://www.aldiwan.net/poem9719.html","البسيط"],[45,"رقة النور واهتزاز القضيب","https://www.aldiwan.net/poem10892.html","الخفيف"],[45,"ما بعيني هذا الغزال الغرير","https://www.aldiwan.net/poem63566.html","الخفيف"],[45,"ضعة للزمان عندي وعكس","https://www.aldiwan.net/poem64604.html","الخفيف"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[49,"شغل المسكين عن تلك المحن","https://www.aldiwan.net/poem65350.html","البسيط"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[66,"ضعف رأسي وقلة الإيمان","https://www.aldiwan.net/poem39039.html","الخفيف"],[97,"يوم أبحرت فوق متنك تهوي","https://www.aldiwan.net/poem24589.html","الخفيف"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[105,"ثقيف انظري أين قصد الطريق","https://www.aldiwan.net/poem44033.html","المتقارب"],[40,"ألا قاتل الله الهوى كيف أخلقا","https://www.aldiwan.net/poem42279.html","الطويل"],[40,"أقول لصاحبي ومثل ما بي شكاه","https://www.aldiwan.net/poem42306.html","الوافر"],[52,"قد صد قلبي قمر","https://www.aldiwan.net/poem27040.html","مجزوء الرجز"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"ألا لا أرى مثلي امترى اليوم في رسم","https://www.aldiwan.net/poem65096.html","الطويل"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[50,"يا بان ضاق المذهب","https://www.aldiwan.net/poem64810.html","مجزوء الكامل"],[46,"ارتاحت النفس بتطهيرها","https://www.aldiwan.net/poem22848.html","السريع"],[46,"أراك حسبت النجم ليس بواعظ","https://www.aldiwan.net/poem23287.html","الطويل"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140974",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147606","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43850","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43888","المديد"],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[91,"ضيف ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=53124",""],[51,"سبحان مُجري الفُلكِ والفَلَكِ","https://www.poetsgate.com/ViewPoem.aspx?id=30080",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""]],"verses":[["ضَعيفَةُ رَجعِ النَّاظرَينِ خَريدَةٌ","يَرِقُّ لأَثناءِ الوِشاحِ إِزارُها",0,"ر",3,0],["ضَعيفُ وِكاءِ الكيسِ لا جارُهُ أَذٍ","وَلا ضَيفُهُ بِالمَنزِلِ المُتَضايقِ",1,"ق",1,0],["ضَعيفَةُ رَجعِ القَولِ مِن تَرَفِ الصِّبا","لَها نَظرَةٌ تُنسيكَ ما يَفعَلُ النَّصلُ",2,"ل",1,0],["ضَعوا القُلوبَ أَساساً لا أَقولُ لَكُم","ضَعوا النُضارَ فَإِنّي أُصغِرُ الذَهَبا",3,"ب",2,0],["ضِعتَ بَينَ النُهى وَبَينَ الخَيالِ","يا حَكيمَ النُفوسِ يا اِبنَ المَعالي",4,"ي",1,1],["ضِعتَ في الشَرقِ بَينَ قَومٍ هُجودٍ","لَم يُفيقوا وَأُمَّةٍ مِكسالِ",4,"ل",1,0],["ضَعِي عَلَى عَيْنَيْكِ بَلُّورَةً","لِتَسْلَمِي مِنْ وَهَجِ الهَاجِرَهْ",5,"ه",1,1],["ضعيف يَصِحُّ النصر من فتكاته","فيُروى لنا منه الصحيحُ المضعّفُ",6,"ف",1,0],["ضعفت مباني كل أمرٍ عندهم","ما بين هادمها وبين الباني",7,"ن",2,0],["ضَعيفُ العُرى دانٍ مِنَ الأَرضِ بَركُهُ","مُسِفٍّ كَمِثلِ الطَودِ أَكظَمَ أَسحَمِ",8,"م",1,0],["ضعفٌ تضاعف في فكري وفي بدني","حتَّى تحيف إسراري وإعلاني",9,"ي",1,0],["ضعُفنَ وكان الضعفُ منهنَّ قوةً","فهنَّ على الألبابِ مقتدراتُ",10,"ت",1,0],["ضعيف على المرء الضعيف وإنه","لأشوسُ عدَّاءٍ على الدهرِ قاسط",11,"ط",1,0],["ضعيف اللُّتيّا في الدماغ سخيفها","قوي اللُّتيا في الحتار لذوعها",12,"ع",3,0],["ضَعفُ العوامل في أسنَّتها","ضعفُ المغازل عنه في الفلك",13,"ك",1,0],["ضَعُفَت حَوامِلُهُ فَمالَ إِلى اِستِها","في الغَيِّ إِنَّ مُحارِباً لَضَلولُ",14,"ل",1,0],["ضُعَفاءٌ مُحَقَّرونَ كَأَنّا","مِن ظَلامٍ وَالناسُ مِن لَألاءِ",15,"ا",2,0],["ضَعيفُ الخُطى بادي النُحولِ كَأَنَّما","يُشَدُّ إِلى قَيدٍ يُشَدُّ إِلى حَبسِ",16,"س",1,0],["ضَعُفَت قَوائِمُها وَلَمّا تَرعَوي","عَن غَيِّها حَتّى تَزولَ وَتُمحَقا",17,"ق",2,0],["ضَعُفَت فَلا عَجَبٌ إِذا اِهتُضِمَت","اللَيثُ لَولا بَأسُهُ اِهتُضِما",18,"م",2,0],["ضَعيفُ العَصا بادي العُروقِ تَرى لَهُ","عَلَيها إِذا ما أَجدَبَ الناسُ إِصبَعا",19,"ع",2,1],["ضِعافُ القُوى لَيسوا كَمَن يَبتَني العُلا","جَعاسيسُ قَصّارونَ دونَ المَكارِمِ",20,"م",1,0],["ضُعْفُ العزيمَةِ لَحْدٌ في سَكينَتِهِ","تقضي الحَيَاةُ بَنَاهُ اليأسُ والوجلُ",21,"ل",1,1],["ضعف الناس عن أداءِ البقايا","والذي ما غدا ضعيفاً سيغدو",22,"د",2,0],["ضَعفَي وكم أبلين من ذى قوّة","مرضى وكم أفنَين من عُوّاد",23,"د",1,0],["ضعيفين لا نعطى حَراكا على الدجى","كلانا عليه مُقعد وعثور",24,"ر",1,0],["ضَعُفُوا كأفراخ الحمام","فمن لهم عطفا وزقا",25,"ق",2,0],["ضَعفى تَعِفُّ الأَيادي عَن مِثالِهِمِ","مِنَ الأَعادي وَإِن هَمّوا بِهِم نَزَعوا",26,"ع",3,0],["ضَعُفَ الطالِبُ المُعَنّى وَلَم تَضعُ","ف عَلى البُعدِ مُهلَةُ المَطلوبِ",27,"ب",1,0],["ضَعُفَ الدَهرُ عَن هَوانا وَما الدَه","رُ عَلى كُلِّ دَولَةٍ بِقَديرِ",28,"ر",1,0],["ضَعَةٌ لِلزَمانِ عِندي وَعَكسُ","إِذ تَوَلّى بِزُرجَسابورَ جِبسُ",29,"س",1,1],["ضَعَةٌ بي إِن لَم أَنَل بِمَكاني","مِنكَ عِزّاً مُستَأنَفاً في مَكاني",30,"ن",2,0],["ضَعُفَتْ معاقِدُ خصرِه وعهودُه","فكأنّ عَقْدَ الخصرِ عَقْدُ وَفَائِه",31,"ا",3,0],["ضَعُفَ المِسكينُ عَن تِلكَ المِحَن","بِهَلاكِ الروحِ مِنهُ وَالبَدَن",32,"ن",1,0],["ضَع مِنَّةً وَاُجلُ المُدامَ لَنا","فيها مِنَ الأَيّامِ نَستَقضي",33,"ي",1,0],["ضُعفُ رَأسي وَقِلَّةُ الإيمانِ","أَوجَبا ما رَأَيتَ مِن هَذَياني",34,"ي",1,1],["ضعضع الجسم عزم روحي المُعَنَّى","يا أخا الروح بُث فيه قواكا",35,"ك",2,0],["ضَعُفتُ عن النّهْضِ القوي زَمَانَةً","وَنُقّلَ بعد الباع خَطوي إِلى شِبرِ",36,"ر",1,0],["ضَعُفَت جَوارِحُ مَن أَذاقَتهُ النَوى","طَعمَ الفِراقِ فَذَمَّ طَعمَ العَلقَمِ",37,"م",1,0],["ضِعافُ القلوبِ قُعودٌ جُمودُ","يخافون كلَّ سَفوحِ دَفُوقْ",38,"ق",1,0],["ضَعِيفاً قَعِيعَ الصَوتِ لَذّاً دَلالُهُ","غَضِيضَ سَوامِ الطَرفِ في المَشِي أَخرَقا",39,"ق",2,0],["ضَعِيفِ البَطشِ ذي كَيدٍ شَدِيدٍ","بِنَظرَتِهِ إِذا أَومى سَؤُوم",40,"م",1,0],["ضَعيفَةٌ أَجفانُهُ","وَالقَلبُ مِنهُ حَجَرُ",41,"ر",1,0],["ضَعِ السّلاحَ فهل حُدّثتَ عن رَشَإٍ","في مَشْرَفيٍّ صَقيلٍ أو رُدَينيّ",42,"ي",1,0],["ضَعيفَةُ كَرَّ الطِرفِ تَحسَبُ أَنَّها","حَديثَةُ عَهدٍ بِالإِفاقَةِ مِن سُقمِ",43,"م",1,0],["ضَعضَعتُ حَبَّةَ جِلدِهِ بِقَصيدَةٍ","وَرَدَت قُرَيشٌ دُونَها يَعبورُ",44,"ر",1,0],["ضَعضَعتُ جَنَّةَ خالِدٍ","بِعَزيمَةٍ لا تُقرَبُ",45,"ب",1,0],["ضَعيفُها مِثلُ فَرا نَيسَبٍ","فَرَّ حِذاراً مِن فَرانيسِها",46,"س",3,0],["ضَعفُنا عَنِ الأَشياءِ إِلّا عَنِ الأَذى","وَقَد يَسِمُ الوَجهَ الكهامُ المُثَلَّمُ",47,"م",1,0],["ضَعُفْتَ عن الإصْباحِ واللّيلُ ذاهبٌ","كما فَنيَ المِصْباحُ في آخرِ الوَهْنِ",48,"ن",1,0],["ضعفى تعفّ الأعادي عن مثالهم","من الأعادي وإن همّوا بهم نزعوا",49,"ع",3,0],["ضعفت عن كيدهم غير أن","اللّه بالحكمة قواني",50,"ي",1,1],["ضَعِ السَيفَ وَاِقتُل مُهجَتي بِمَحاجِرٍ","مراضٍ وَإِن تَختَر فَغَير مِراضِ",51,"ض",1,0],["ضَع يَداً عَلى كَبِدٍ","آه مِن تَفَطُّرِها",52,"ر",3,0],["ضَعيفُ جِسمٍ قَوِيُّ عَزم","تَعنو الصِعابُ الّتي يَروضُ",53,"ض",1,0],["ضَعُفتْ منه القُوَى فَغَدَتْ","مِن قَوارِير قَوَارِحُهُ",54,"ح",2,0],["ضعوا مقاليد أمر الشعب في يده","ما صرَّفت أمرَهُ يمنى كيمناه",55,"ا",2,0],["ضعيف الخطى،بادي التحول كأنما","يشدّ إلى قيد، يشدّ إلى حبس",56,"س",1,0],["ضَعُفَ العوامل في أسنَّتها","ضعفُ المعازل عنه في الفلك",57,"ك",1,0],["ضعيف الركنِ ، مخذولاً ، مضاعا","غريقٌ حاولت يَدُه شِراعاً",58,"ا",1,0]]}