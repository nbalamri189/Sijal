{"poems":[[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[173,"لا عز إلا بحد الصارم الذكر","https://www.aldiwan.net/poem1630.html",""],[367,"سر منقلبًا","https://www.aldiwan.net/poem11643.html","عموديه"],[369,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[578,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/34514","البسيط"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69391","الكامل"],[2001,"","https://poetry.dctabudhabi.ae/diwan/poem/111182","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110278","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87761","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75963","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202989","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112674","الرجز"],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22588","الكامل"],[4702,"ماكل شعبٍ يثور يغير القادة","https://www.poetsgate.com/ViewPoem.aspx?id=155215",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5751,"رسْمٌ بذاكرةِ اللَّيلَك","https://www.poetsgate.com/ViewPoem.aspx?id=214774",""]],"verses":[["والممتلونَ كأنَّهم كلُّ الدُّنى","والفارِغونَ كأنَّهم أصنام",0,"م",1,0],["وَالمُمطِرُ الجودَ مِن أَثناءِ راحَتِهِ","فَيضاً إِذا ضَنَّتِ الأَنواءُ بِالمَطَرِ",1,"ر",1,0],["والممنوعاتُ مِنَ الصَّرف ِ","انصرفت لا تخشى تأنيبا",2,"ب",2,0],["وألْمَمْتَ عند اقْترابِ الرَّحيلِ","وخَدّي بواكِفِ دَمْعي غَريق",3,"ق",1,0],["والْممْ بقبرٍ فيهِ سَيدة النّسا","بأبي وأمّي ما أبرَّ وأظهرَا",4,"ر",2,0],["وَالمُمحِلاتُ مِنَ البِلادِ بَوابِلٍ","مِن جودِهِ يُحيي الأَنامَ سُجومِ",5,"م",1,0],["وَالمُم بِقَصرِ اِبنِ بِسطامٍ فَرُبَّتَما","سَعِدتُ فيهِ بِأَيّامي وَلَيلاتي",6,"ت",2,0],["وألممت بأوطانٍ","قويّ النهي والأمر",7,"ر",1,0],["وَالمِم بِدارٍ لِلرَّبابِ وَقُل لَها","يا دارُ جادَ رُباكِ صَوبُ رَبابِ",8,"ب",1,0],["وألم ما لقيت من الرزايا","فراق احبة خفوا ارتحالا",9,"ل",2,0],["والمماتُ المماتُ عندهم ان","يبعدوا عن ملذةِ الحيوان",10,"ن",1,0],["وَالممطر النار مِن فَوهاء صاخِبَةٍ","تَحوّل الطَود قاعاً وَالذَرى ساحا",11,"ح",2,0],["وَأَلمِم بمُغني دَولَةٍ ناصِرِيَّةٍ","تَكنَّفَها الاقبالُ وَالنَصرُ وَالأُنسُ",12,"س",1,0],["والممات اتساع روحك حتى","تخلع الجسم بل تشق البرودا",13,"د",2,0],["والمُم بهِ الحقّ وفُك أسرَنا","واعزِز به الإسلامَ بعد الذلّه",14,"ه",1,0],["وَالمُمطِرينَ إِذا المحولُ تَتابَعَت","دِرراً تَداوَلُها المُحولُ غِزارا",15,"ر",2,0],["والمملكة دايما بالعدل معتاده","باذن الولي في ظلال عيال اخو نوره",16,"ر",2,0],["والممتطى أقب يأبى نعله","ولو بزهر النيرات يثقب",17,"ب",1,0],["وأَلُمُّ مِنْ حُزْنِ الغيومِ نوارسي","وعلى الحروفِ نوارسٌ بيضاءُ",18,"ا",2,0]]}