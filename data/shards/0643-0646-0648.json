{"poems":[[95,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[29,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[53,"ألا أيها المطري العلاء بن صاعد","https://www.aldiwan.net/poem7969.html","الطويل"],[93,"خذ ما استطعت من الدنيا وأحليها","https://www.aldiwan.net/poem62810.html","عموديه"],[64,"بضاعة هرمس مكنونة","https://www.aldiwan.net/poem52211.html","المتقارب"],[47,"خيال يعتريني في المنام","https://www.aldiwan.net/poem65653.html","الوافر"],[82,"كن واثقا بالله سبحانه","https://www.aldiwan.net/poem31546.html","السريع"],[48,"أمامة كيف لي بإمام صدق","https://www.aldiwan.net/poem22478.html","الوافر"],[48,"كن وشيكا في حاجة أو مكيثا","https://www.aldiwan.net/poem23260.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[113,"كن ولوعا بحب جمعك للمال","https://www.aldiwan.net/poem16636.html","الخفيف"],[131,"كنواح ريش حمامة نجدية","https://www.aldiwan.net/poem24253.html","الكامل"],[146,"تفيض نفوس بأوصابها","https://www.aldiwan.net/poem58421.html","المتقارب"],[147,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[234,"سقياني على العناقيد مما","https://www.aldiwan.net/poem50812.html","الخفيف"],[242,"يا دار من أهوى رعاك الله","https://www.aldiwan.net/poem19729.html","الكامل"],[369,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[382,"عبادة مريم في الأرض كانت","https://www.aldiwan.net/poem66915.html","الوافر"],[409,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[412,"ليهن كلاك مداها القصي","https://www.aldiwan.net/poem50088.html","المتقارب"],[447,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[449,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[509,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[556,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[563,"إنني كن وإنني فيكون","https://www.aldiwan.net/poem33740.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[715,"","https://poetry.dctabudhabi.ae/diwan/poem/146047","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86670","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37831","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70816","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35407","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89543","البسيط"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20473","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109408","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60956","الكامل"],[2899,"","https://poetry.dctabudhabi.ae/diwan/poem/107119","المتقارب"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99543","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130054","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140024","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62920","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199153","السريع"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111470","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111419","الطويل"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131902","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94778","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94627","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139314","الخفيف"],[4755,"كُن كما كُنتَ واحدًا فِي وَلائِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=184802",""],[4814,"ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=193408",""],[4954,"ألْمَحتُ بَدْرًا","https://www.poetsgate.com/ViewPoem.aspx?id=207791",""],[4968,"معزوفة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=208095",""],[5189,"دستور على الأذواقِ","https://www.poetsgate.com/ViewPoem.aspx?id=200100",""],[5216,"قناة السويس","https://www.poetsgate.com/ViewPoem.aspx?id=187002",""],[5219,"الرجولة موقف","https://www.poetsgate.com/ViewPoem.aspx?id=193709",""],[5219,"كن عاقلا ....","https://www.poetsgate.com/ViewPoem.aspx?id=195013",""],[5277,"إنما الأعمال بالنيات","https://www.poetsgate.com/ViewPoem.aspx?id=198177",""],[5358,"الأشباح","https://www.poetsgate.com/ViewPoem.aspx?id=21886",""],[5409,"لا يحرم الكذب من ناسٍ تصدقه","https://www.poetsgate.com/ViewPoem.aspx?id=155438",""],[5542,"مالي أراك تقلبُ النظرا","https://www.poetsgate.com/ViewPoem.aspx?id=9683",""],[5628,"حب وحيرة","https://www.poetsgate.com/ViewPoem.aspx?id=178514",""],[5638,"أمي (أنشودة للأطفال)","https://www.poetsgate.com/ViewPoem.aspx?id=199069",""],[5725,"عشق صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=186860",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5829,"ما سواها زائل","https://www.poetsgate.com/ViewPoem.aspx?id=204861",""],[6070,"كُنْ واثقا بالله دوماً صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=194509",""],[6102,"لَو بِيَدي ..","https://www.poetsgate.com/ViewPoem.aspx?id=184868",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6291,"طفولة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87679&r=&rc=13",""]],"verses":[["كُنُوزٌ لِلأَدِيبِ بِهَا ثَرَاءٌ","فَلَيْسَ بِقائِمٍ عُذْرُ العَدِيمِ",0,"م",1,0],["كَنوا كَهاوٍ رَدٍ مِن حالِقَي جَبَلٍ","وَمُغرَقٍ في عُبابِ البَحرِ مَغموسِ",1,"س",1,0],["كنوزُ غِنىً للمُقْتِرين وإنْ دُعوا","لنائرةٍ كانوا كنوزَ غَناء",2,"ا",2,0],["كُن وَردَةً طيبُها حَتّى لِسارِقِها","لا دِمنَةً خُبثها حَتّى لِساقيها",3,"ي",3,0],["كنوز ملوك لنا سبعة","مفاتيحها بيدي هرمسِ",4,"س",1,0],["كَنورِ الأُقحُوانِ جَلاهُ طَلٌّ","وَسِمطِ الدُرِّ فُصِّلَ في النِظامِ",5,"م",1,0],["كُنْ واثقاً باللّه سبحانه","فهو الذي يصرفُ عنك الخطوبْ",6,"ب",1,1],["كَنودٌ جاءَنا مِنها كُنودٌ","وَأَعيا القَومَ سَعدٌ مِن سُعادِ",7,"د",1,0],["كُن وَشيكاً في حاجَةٍ أَو مَكيثاً","لَيسَ مُرُّ الأَيامِ فينا بِمَهلِ",8,"ل",1,1],["كنَوَى القَسْبِ كِدْتَ تَسْمَعُ في الآ","خِرِ منها للموْتِ مِثلَ القَسيب",9,"ب",1,0],["كُنُوزٌ سَيَغْزُونَ أَعْلاَقَهَا","وَيَسْبُونَ قَيِّمَها المُرْصَدا",10,"د",2,0],["كنوز الأرض خافيةٌ علينا","ولا يَبْدُو لنا إلا الإطَار",11,"ر",1,0],["كُن وَلوعاً بِحُب جَمعِكَ لِلما","ل وَحُب الأَكياس لا الأَكياس",12,"س",1,1],["كَنَواحِ ريشِ حَمامَةٍ نَجدِيَّةٍ","وَمَسَحتُ بِاللَثَتَينِ عَصفَ الأَثمَدِ",13,"د",1,1],["كنوزُ محامِدها والثناءِ","عليها ذخائرُ أعقابها",14,"ب",3,0],["كُنوزُ المَعالي لَدَيهِ تُزارُ","وَثَوبُ الثَناءِ عَلَيهِ يُزَرّ",15,"ر",1,0],["كنوز بَدَتْ لولا ذبولٌ يُصيبُها","لأَصبحَ ما عند الصَّيارفِ كاسِدا",16,"د",2,0],["كَنواصي القِيانِ نَظْماً وكالشَّهْ","د مَذاقاً وكالعَبِيرِ نسيما",17,"م",2,0],["كَنَوَاسِمِ الْعَهْدِ الذِي مِنْ طِيبِهِ","تُذْكِي سَعِيرَ أَضَالِعِي ذِكْرَاهُ",18,"ا",2,0],["كَنَّوْا أباك أبا عيسى فأنت إذَن","عيسى إذا حقّقَ المَعْنَى مُكَنّيه",19,"ي",2,0],["كنور الشمس لا يزراه شينٌ","إذا طلعت بآفاق السحاب",20,"ب",1,0],["كنوز من التحقيق فيه وإنما","يفوز بها من في العلوم وحيد",21,"د",1,0],["كَنورِ الحَديقَةِ في رَوضَةٍ","تَتابَع وَسميّها وَالوَليّ",22,"ي",1,0],["كنواله هتانها بضريحه","يتعاقب الأَنواء كالأَنواء",23,"ا",2,0],["كنوز ذي الأرض تحت أرجلكم","والفرق بين الأقوام كالفلق",24,"ق",1,0],["كنور الشمس منه البدر ينمي","ومنه النقصُ يسري في الهلال",25,"ل",1,0],["كنور الذكا في البدر عند كماله","تنقصه في السير قرباً منازل",26,"ل",1,0],["كنْ وَقوراً على مضاضةِ خطبٍ","حطّ عن مَنْكِبَيْ سواك الوَقارا",27,"ر",2,0],["كن وجود وغيره عدم","عنه كنَّى بقوله فيكونْ",28,"ن",1,0],["كنوز الأرض إن غدقت عليها","وكانت كالغيوث الهاطلات",29,"ت",1,0],["كنوز يصون الحق منها مصونه","فقد صرت بالسر المصون أمينه",30,"ه",1,0],["كن وكيس وكانون وكاس طلاً","مع الكتاب وكس ناعم وكسا",31,"س",2,0],["كُنوزاً وَإِن جلّت فَلَيسَت جَسيمة","بِنسبة حفظ الملك مِن شرِّ أُمة",32,"ه",1,0],["كُنوزُ البَها والحسنِ منكَ تلوحُ لي","بذاتكَ يا مَنْ في المحاسِن يُفرَدُ",33,"د",1,1],["كنْ واثقاً بإله العرشِ معتصما","ولا تخفْ نفثة مِنْ نافثٍ نفثا",34,"ث",2,0],["كُنوزُ الأَرضِ وَهيَ لَكُم مِلاكٌ","شُموسٌ في قُصورِكَ مُجتَلاها",35,"ا",3,0],["كُنوزُ فَضلٍ أَثارَتها مَكارِمُهُ","أَنسَت مَكارِمَ عَن مَعنٍ وَعن هَرِم",36,"م",1,0],["كَنودٌ لا تَمُنُّ وَلا تُفادي","إِذا عَلِقَت حَبائِلُها بِرَهنِ",37,"ن",1,0],["كنوز أوصافه تُغني أحبته","لكن أعدأه تفنى بها حسدا",38,"د",2,0],["كنوالِ راحة راشد بن مظفر","فهو المعيضُ عن الحيا الهتان",39,"ن",1,0],["كنوه بما مدّ في عمره","وكان نحور العدا يخترم",40,"م",1,0],["كن وكيس وكانون وكاس طلا","بعد الكباب وكس ناعم وكسا",41,"س",2,0],["كنوزُ الأرض يأخُذها سِوانا","ويمنحُنا نزول النائباتِ",42,"ت",1,0],["كنوزُ الورى أعمالهم وصلاتهم","عليه وخيرُ الكنز ما دام في الملك",43,"ك",1,0],["كنواصي الرِّعان تلعب بالطَر","فِ وتأبى فروعها ان تناصَا",44,"ص",2,0],["كُن وَديع النَفسِ يُحبِّبك الملا","من كَبيرِ النَفس من ذا ما جَفَل",45,"ل",1,0],["كن وكانون وكيس كسا","واللحم والسمن وبيض الدجاج",46,"ج",1,0],["كنوز الأرض قد عرضت عليه","فأعرض عن زخارفها اعتصاما",47,"م",2,0],["كَنُوتِيَّةٍ شَقَّتِ اليَمَّ شَقَّا","بِمُلسِ المَجَاذِيفِ والأَمرُ شَقَّا",48,"ق",2,0],["كُنُوزاً إِذا ما نالَها أَيُّما امرِىءٍ","تَرَفَّعَ عَن شَكوَى شَجِيةِ مُعسِرِ",49,"ر",1,0],["كنُوطُسَ إِذ مِن كُلِّ صَوبٍ وهَبَّةٍ","لأَعلى حَزِيزِ الصَّخرِ بِالمَوجِ يَقذِفُ",50,"ف",1,0],["كنوز حووها من رياء وخلسة","وغَدرِ ضعيفٍ ألجأوه الى الغسر",51,"ر",1,0],["كنور النار لما ضاءَ خدٌّ","فحام عليهِ قلبي كالفراشِ",52,"ش",1,1],["كن واثقاً في ودادٍ لا أُغيِّرهُ","ما دام عمري وروحي ضمن جسماني",53,"ن",2,0],["كن وحيداً ما عشت تحيا بخير","سالماً من شرور كل البريه",54,"ه",1,1],["كُن وَحِيدًا.. فأنتَ مِن كُلِّ جَفنٍ","جئتَ كالنَّهرِ حافِلًا بابتِلائِكْ",55,"ك",1,0],["كن وطني سكني عاصمتي","لأكونكَ من ذاتِ المصدر",56,"ر",1,0],["كنودٌ ولوْ أحْسنْتَ دهْرًا وأدْهرًا","لقالتْ:وما أبْصرْتُ غيْر الْمخازيَا!",57,"ي",2,0],["كنورس بزجاج الموج منشغلٌ","يقتات فوق ثلوج القدّ والعنق",58,"ق",1,0],["كن واثقًا في قولهِ سبحانهُ","لن تصطفيك جماجمَ الفسّاقِ",59,"ق",1,0],["كنوزي فى رمالي نائماتٌ","تعالوا فتِّشوا عنها سَويّا",60,"ي",2,0],["كن واثقا أن الرجال مواقف","ومروءة تزهو بها مزدانا",61,"ن",2,0],["كن واثقا أن الحياة بأسرها","لله مثل بعوضة الميزانِ",62,"ن",1,0],["كن واثقاً بالذي أعطاكَ مائدةً","بالمصطفى كمُلتْ..فاشكر أياديهِ",63,"ي",2,0],["كنْ والياً يا حبيباً يا سنا قمرٍ","فلي ولاية ُ أحلامٍ بلا والي",64,"ل",2,0],["كن واقعياً تنل ما قد صبوت له","أما المثالي في الدنيا فقد فشلا",65,"ل",2,0],["كن واضحاً كالشمس صافية","بيضاء يجلو نورها البصرا",66,"ر",2,0],["كنوْرس البحْر يبكي وحْده ألما ً","والبحر يهْدر لا يدري بشكواه ُ",67,"ا",2,0],["كَنُورِ الْبَدْرِ طَلَّتُهَا","وَضَوْءِ الشَّمْسِ بَسْمَتُهَا",68,"ه",2,0],["كنور البدر يحبسه محاق","وقد اغرى المغارب بالهلالِ",69,"ل",1,0],["كن ودق المزن من فوق الحزوم","المكاين بالصحايف كاتبات",70,"ت",1,0],["كن واثقاً بعليٍ واتبع سبباً","يُنجيك من حرِّ نارٍ أنت صاليه",71,"ي",2,0],["كن واحدا بين الأنام مغردا","كالنور في الديجور انك باسل",72,"ل",1,0],["كُنْ واثقا بالله دوماً صاحبي","هو مالكُ السُّلطانِ والتيجانِ",73,"ن",1,1],["كَنَوبَةٍ مِن نَشِيجٍ نَارُهُ وَقَدَتْ","فِي أَضلُعٍ عُضِبَتْ مِنها مَحَارِفُها",74,"ف",3,0],["كن واقعيا يا شويعر ناظرا","في واقع الحال الذي يتكوم",75,"م",1,0],["كنوز حين نذكرها","فلا كسرى ولا قيصرْ",76,"ر",1,0]]}