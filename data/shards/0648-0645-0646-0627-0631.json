https://poetry.dctabudhabi.ae/diwan/poem/83190","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120501","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139762",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139588",""],[4767,"طود العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=94353",""],[4929,"دردشة مع أبي الطيب المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=199189",""],[585,"سل الدهر ما للدهر بالرزء يفجع","https://www.poetsgate.com/ViewPoem.aspx?id=161944",""],[585,"من مهبط الوحي حول البيت والحرم","https://www.poetsgate.com/ViewPoem.aspx?id=161898",""],[5104,"فاسألوا عنه غامضات المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=38510",""],[5174,"لغة الضاد ليلة الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=184937",""],[5186,"لم يبق لي في الساح جولة جائل","https://www.poetsgate.com/ViewPoem.aspx?id=156459",""],[5221,"بوح الأمير","https://www.poetsgate.com/ViewPoem.aspx?id=188995",""],[5275,"صرخة من بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=35276",""],[5284,"المُبعدون","https://www.poetsgate.com/ViewPoem.aspx?id=205895",""],[5325,"نقضت بك الأيام أعلى منزل","https://www.poetsgate.com/ViewPoem.aspx?id=171979",""],[5358,"يا عِراقاً","https://www.poetsgate.com/ViewPoem.aspx?id=21880",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5431,"لليمن الحبيب /لزوم مالا يلزم","https://www.poetsgate.com/ViewPoem.aspx?id=196908",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[2110,"والنجم من فلك النحور إذا هوى","https://www.poetsgate.com/ViewPoem.aspx?id=156289",""],[5677,"بني عزيز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=179980",""],[402,"مددت طرافك للائذين","https://www.poetsgate.com/ViewPoem.aspx?id=36537",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[773,"مبنى أغر وليلة غراء","https://www.poetsgate.com/ViewPoem.aspx?id=134917",""],[6090,"قدمت فليهن فيك المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=170911",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6291,"هنا ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87673&r=&rc=7",""]],"verses":[["ومنْ أرْيَحِيّاتي وللرّاحِ نَشْوَةٌ","متى تَدُرِ الكأسُ الرّوِيّةُ أطْرَبِ",0,"ب",1,0],["ومنْ أرْيَحيّاتي إذا اقْتادَني الهَوى","أفُضُّ وإنْ ساءَ العَذولُ لِجامي",1,"م",2,0],["وَمَن أَروحُ وَأَغدو","مُشَمِّراً في هَواهُ",2,"ا",2,0],["ومنِ ارْتَضاهُ اللهُ وفّقَ سعْيَهُ","فرأى العظيمَ منَ الحُظوظِ خَسيسا",3,"س",2,0],["وَمَنارَةً لِلفَضلِ قَد رُفِعَت","فَوقَ الكَنانَةِ نورُها شَعّا",4,"ع",2,0],["وَمِنْ أَرْشَدِ الرَّأْيِ أَلاَّ تَفُوتَ","عِنَايَتَتُهَا فِئةَ الأًَوْسَطِينْ",5,"ن",1,0],["وَمِنّا رَسولُ اللَهِ حَقّاً وَلَم يَزَل","لَنا بَطنُ بَطحاوَي مِنىً وَقِبابُها",6,"ب",3,0],["ومَنِ ارتوى في هذه","الدُّنيا تَسَنَّمَهَا خَطِيبْ",7,"ب",1,0],["وَمِن إِرثِكُم أَعطَت صَفِيَّةُ مُصعَباً","جَميلَ الأَسى لِما اِستُحِلَّت مَحارِمُه",8,"م",2,0],["وَمِنّا رَسولُ اللَهِ أُرسِلَ بِالهُدى","وَبِالحَقِّ جاءَت بِاليَقينِ نَوادِرُه",9,"ر",2,0],["وَمن أَرحَبَ الشَمَّ المطاعينَ بِالقَنا","وَرَهُمٌ وَأَحياءُ السَبيعِ وَيامِ",10,"م",1,0],["وَمَن أَرادَ العُلى عَفواً بِلا تَعَبٍ","قَضى وَلَم يَقضِ مِن إِدراكِها وَطَرا",11,"ر",2,0],["وَمَن أَرادَ بِهِ الرَّحمنُ مَكرُمَةً","هَداهُ لِلرُّشدِ في داجٍ مِنَ الظُّلَمِ",12,"م",1,0],["وَمِن إِرثِ سَرّاقٍ عَلَيهِ مَهابَةٌ","تَظَلُّ قُلوبُ القَومِ مِنها تَوَجَّبُ",13,"ب",1,0],["ومن أراد العلا عفواً بِلا تعبٍ","قضى ولم يقضِ من إدراكها وطرا",14,"ر",2,0],["ومن ارى قصدي","في الكون رؤياه",15,"ا",2,0],["ومن ارتضاهُ إمامُنا بولايةٍ","أبداً فلا يشقى به إخوانُه",16,"ن",2,0],["وَمِن إِرادَتِهِ حُكمٌ فَمَن رَفَعَت","فَما لرفعَتِهِ في الأَرضِ إِنكارُ",17,"ر",1,0],["وَمَن أرادَ هَهنا الإنشادا","فَليخترِ الرَشادَ لا الفسادا",18,"د",2,0],["ومن اركبته الأرض انعمها انتهى","بحيث انتهى من يركب العيشةَ النكدا",19,"د",2,0],["وَمَن أَرضى بِقَتلي في","هَواهُ وَهوَ لا يَرضى",20,"ض",2,0],["وَمَنْ أَرْهَقَتْهُ خُطُوبُ الدُّنَا","فَكَيْفَ يُحُوكُ الْقَرِيضَ النَّضِيرَا",21,"ر",2,0],["ومن ارتقي كأبيه شاهين العلا","وسما إلى فلك السماحة والسما",22,"م",2,0],["وَمنا راوهديا","وَعلا واِنتباها",23,"ا",3,0],["ومنارة المرآة ميديها مضى","والآن ما بعمود تلك فخار",24,"ر",1,0],["وَمَن اِرتَأى لِيَرى الهُدى مِن رَبِّهِ","بِكِتابِهِ أَلفاهُ فيهِ مُبَيِّناً",25,"ن",2,0],["ومن أرجاتٍ في الغصونِ كأنها","خدودُ عذارى في مقانعها الخضر",26,"ر",1,0],["وَمَن اِرتَدى بِالخلف عُرّيَ حَيث لا","يَلقى سِوى العار المَهين لَهُ كسا",27,"س",2,0],["ومَن أرادَ الفوزَ فليعتقد","حقاً ويلبس ثَوبَ أَوّاهِ",28,"ه",1,0],["ومنْ أرادَ الوُرودَ رِفْهاً","فَلْيُهِنِ العِرْضَ ثمَّ دِينَهُ",29,"ه",1,0],["ومن أرسل الأفكار في كل ما يرى","يقلّبه إِن شاء بَطْناً إِلى ظهر",30,"ر",1,0],["ومن أراد التناسي في مصيبته","فللورى برسول الله معتبر",31,"ر",1,0],["ومن أراد بهذا البيت غائلة","فالنصر عاذله والنصر خاذله",32,"ل",2,0],["وَمنارةُ الكتبيِّ أعظمُ شاهدٍ","إن قيلَ أين مفاخرُ الحمراء",33,"ا",2,0],["وَمَن أَرى وُدَّهُمُ وحدَهُ","زادي إذا وُسّدتُ في قبري",34,"ر",2,0],["ومَن أرادَ الغِنَى الباقي لهُ أبداً","يَطلُبْ غِناكَ ولا يَبغي بهِ بَدَلا",35,"ل",2,0],["ومن أراد أن يلج احتجا","وباهت الحق إذا ما لجا",36,"ج",2,0],["ومنارةٍ من حُسْن حُلَّتِها","يُنْشى الحبُورُ ويُنْشَر الخَبَرُ",37,"ر",1,0],["وَمَن أَرَقتَهُ دَواعي الهَوى","فَدونَ الَّذي أَرَقتَهُ الحَكَم",38,"م",1,0],["ومن أرى رأي الحق المبين ومن","أخفى عليه فقد أودى به الغم",39,"م",1,0],["وَمن أَرضه يأتي بِكُلِّ ملوّثٍ","جَهول بِتَلقين الدُروس لِطالب",40,"ب",1,0],["ومن أراد حياة العز طيبة","فالأرض تحمله حراً أو الشهب",41,"ب",1,0],["ومناراً تبتنيه عالياً","لِهُدى الناسِ لَباقٍ غير فان",42,"ن",1,0],["ومنار واسطَ كالنجو","مِ منيفةً فوق المنار",43,"ر",1,0],["وَمن إِرْبُه للنّاسِ في الدّهرِ راحَةٌ","وَلَيسَ لَهُ في غَيرِها الدّهرَ مأربُ",44,"ب",1,0],["ومن أراد أكْبَر الفوز غداً","فليقتنع وليُلجِمنَّ أصغرَيْه",45,"ي",2,0],["ومن أراد العلى يسعى لها عجلا","مستسهلاً كل ما في الدهر قد عسرا",46,"ر",2,0],["ومن أراد استراقا رد مسمعه","رشد الشيطان بالنجم الذي رجما",47,"م",2,0],["وَمَن أَرادَ دَفْعَهُ تَزَحْزَحا","وَخافَ أُسْداً وَكِباشاً نُطَّحا",48,"ح",2,0],["وَمِنّا رَسولُ اللَهِ فينا تُراثُهُ","فَهَل فَوقَ هَذا لِلمُفاخِرِ مُفتَخَر",49,"ر",1,0],["ومَنْ أَرْبَى على سَبْعينَ عاماً","بأَرْبعةٍ فقد أَخْلى رِباعَهْ",50,"ع",2,0],["ومنار الدين والهدى الذي","عطر الأكوان في كل الجهات",51,"ت",1,0],["ومن ارهاص حضرته","رجوم الجن بالشهب",52,"ب",1,0],["ومنار دين اللَه عز ونوره","شرح الصدور بحكمة وبيان",53,"ن",1,0],["ومن ارض الهلاك لكم خذوه","وقولوا هاك فرقانا مبينا",54,"ن",2,0],["ومن أرسل الآمال نحو مبرها","تعالى حباها واجبات المبرة",55,"ه",1,0],["ومن أرجو سواه ليوم حشري","إذا انقطع الرجاء لغفر ذنبي",56,"ب",2,0],["ومن أُرِيَ الأذان وكان منا","معاذ رأسُ رسل المرسلينا",57,"ن",2,0],["ومنا راويو خبر الترايا","ومنا العالمون الناسبونا",57,"ن",2,0],["ومن أرجائها قد فاح نشر","يعطّر عَرفه مهما يدور",58,"ر",1,0],["ومن أرضٍ بها الجُ","ؤذَر لا يأمن من ذيبِ",59,"ب",1,0],["ومناراً بسناه ينجلي","غيهب الجهل وان مدّ رواقا",60,"ق",2,0],["وَمَنارة في زيِّ صاحِبها","وَسَخاً تَراها رثة قذره",61,"ه",1,1],["ومن أراد تَكوة من بُتَّما","يَجري على مَطلَعِهِ ليَغنما",62,"م",2,0],["وَمِن أَريجِ مسكٍ أَو عَنبرٍ","يَلتَذُّ بِالشمِّ لَهُ أَنفُهُ",63,"ف",2,0],["وَمَنارَةِ اللَهِ الَّتي قَد أَرسَلَت","أَضواءَها فمَحَت دُجا الظَلماءِ",64,"ا",2,0],["ومناراتها تشير إلينا","ان آل الخليل في السرداب",65,"ب",1,0],["ومن ارتقى فوق البراق إلى السما","والروح بين يديه حتى السدرة",66,"ه",1,0],["ومن أرادَسمعة أو شُهرَة","أحبَطَ في دارِ الجزاءِ أجرَه",67,"ه",1,0],["ومن أراد منهم الرواحا","فإنه يستلب المصباحا",68,"ح",2,0],["ومن أرباب الأذواق نالت علومها","وهاجت فهومها وصارت عالية",69,"ه",1,0],["ومَنِ ارتَضَى بالموتِ عن أَعدائِهِ","حُبّاً بِهِم فهُوَ المُحِبُّ الاعظمُ",70,"م",1,0],["ومن أراق دماء البدنُ مشعرَةً","على أياسرِ كل تامك قرد",71,"د",1,0],["وَمِن أرَبِي أخِي العَرَبِي","أخِيكَ الطَّيِّبِ العِطرِ",72,"ر",1,0],["ومن أراد مؤنساً فالقرآن","يكفيه والحق هناك مستبان",73,"ن",1,0],["ومن أراد كَنْزاً القناعهْ","تكفيه لا ينفد ذا إشاعه",73,"ه",1,0],["ومن أراد موعظهْ فالموت","يكفيه ليس وعظ ذا يفوتُ",73,"ت",1,0],["ومن أراد أن يضرّني بضارْ","فردّه من قبل ما إليَّ سارْ",74,"ر",1,0],["ومنارٍ يجتلي صُلْبانهُ","بَينَ بِيضٍ تَتبارَى في البرين",75,"ن",1,0],["وَمَن أَرجوهُ غَيرُكَ يا إِلهي","وَمَن ذا للفَقيرُ سِواكَ يُغني",76,"ن",2,0],["وَمِنّا رَئيسُ يُستَضاءُ بِرَأيِهِ","سَناءً وَحُلماً فيهِ فَاِجتَمَعا مَعا",77,"ع",2,0],["ومن أروت العزاء اصلَ فروعهِ","فكم اثمرت تلك الفروع من الفخرِ",78,"ر",1,0],["وَمَن أَرَبَّ الرَّدَى لَم يَلْقَ غَيْرَ رَدىً","سَلْ خَيْبَرَاً حِين وَلَّى جَمْعُهُمْ بَدَدَاً",79,"د",2,0],["وَمَن أَرادَ أَن يَكونَ خادِما","لا مَن أَرادَ أَن يَكونَ عالِما",80,"م",2,0],["ومن ارواه ورد من معين","فما اغناه عن حمأ الدلاء",81,"ا",2,0],["ومنار الفضل بل نور الهدى","بدر أفق العلم بل شمس التقى",82,"ا",1,0],["ومَن أرادهم البارى انتقاما","فلا يحيى رفاتَهم المسيح",83,"ح",1,0],["و(منار حق) فيه كان هلاكه","لو لا الإله لكان ينقم ناقم",84,"م",1,0],["ومنْ أرادَ بغير الله عِزَّتَهُ","تبوَّأَ الذلَّ واسودَّتْ مصائِرُهُ",85,"ر",2,0],["ومن أرزه الباقي على الدهر مجده","ومن زهره الذكر الذي يتضوع",86,"ع",1,0],["ومن أراد حياة الشعب جد لها","ومن أراد نهوض الشعب لم ينم",87,"م",1,0],["ومنار من الهوى أوضحوهُ","بعلومٍ تهدي إلى قسطاسِ",88,"س",1,0],["ومنارة ً مِن حِقْبة ذهبيّة","عشِقت لها روحُ\"النُّواسِ\" فِراسا\"",89,"س",2,0],["ومنار وحدتنا ولم شمولنا","\"من نوركم روح \"\"الإخاء\"\" الشامل\"",90,"ل",1,0],["ومن أرض المنارة جاء شعري","يهيج الصب لا سمر السمير",91,"ر",1,0],["ومِن ْ ْ أرجَع ْ أجيب ِ الخبز ْ ويْاي ْ","وجيبلنْج دوه مِن ِ الصيدلية ْ",92,"ي",2,0],["ومنارةٌ ملَّ النِّداءَ شعاعُها","فمتى تُنادي غائبًا فتُجابُ",93,"ب",1,0],["ومنارة فاضت على نيرانها","مثل الروابي في فناء المنزل",94,"ل",1,0],["ومَناراتٌ لأعْلامِ الهُدى","عانقَتْ سَقْفَ السّماواتِ عِناقا",95,"ق",2,0],["ومنار حق كل من","فيه تمسك لن يضلا",96,"ل",2,0],["ومنارا للمجد كان سهيلٌ","يمني الصبا بحاء وباء",97,"ب",3,0],["ومَنِ ارْتضى دينَ السماحةِ مِلَّة ً","عزَّتْ مكانتُهُ وصارَ جَليلا",98,"ل",2,0],["ومن ارتدى برد السلوك بلا تقى","فلقد تعرض للقطيعه والنوى",99,"و",2,0],["ومنا رجال ماغطى تاريخهم ستر وحجاب","ولو كثروا بعض البشر باستارها وحجابها",100,"ب",3,0],["ومن أرشد الرأي ألا تفوت","عنايتتها فئة الوسطين",101,"ن",1,0],["ومن أرضعته حليلتي","فعلى حرمٌ مجتنب",102,"ب",1,0],["ومن ارتقى متن البراق إلى العلى","تطوى سماء دونه فسماء",103,"ا",2,0],["ومن أراد لحوقا فيك أعجزه","أن ليس يلحق ليث الغابة السيد",104,"د",1,0],["وَمِنا رَموه بلجة البَحر عالميا","هَفوا وَلا بَين لَهُم أَعلام",105,"م",1,0],["وَمِنا رَموه بلجة البَحر عالميا","وَمِنا بجلق ما لقوا دفان",106,"ن",1,0],["وَمِنا رَموه في لجة البَحر عالميا","وَكلاهم هَوام المايع السيال",107,"ل",1,0],["ومن أرادك شراً صاح نادبه","تذود عنك يدٌ فراسة وفمُ",108,"م",1,0]]}