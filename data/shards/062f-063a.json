{"poems":[[93,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[347,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203676","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109081","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203032","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101612","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101613","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100728","الكامل"],[4962,"ابتَسِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=201737",""],[6256,"المضيفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65930&r=&rc=18",""]],"verses":[["دَغدِغ بِريشَتِكَ الكَمَنجَةَ يَنطَلِق","وَيَدُبُّ في أَرواحِنا تَأثيرُهُ",0,"ر",2,0],["دغدغه أخو هوى فمد من","لسانه وراح شهداً يقطر",1,"ر",1,0],["دغلوا في ضلالهم واباحوا","في ربوع الالهام ما لا يباح",2,"ح",1,0],["دغدغت حلميَ السما، فتململ","تُ ورفرفتُ في الفضاء المباح",3,"ح",1,0],["دغدغ الزهر يا نسيم ورفقاً","بورودٍ تفوح في أرجائك",4,"ك",1,0],["دغدغن ضلع الصدر فعل مداعب","وسقين خمر الوحي المتوسد",5,"د",1,0],["دغدغ الطهر مقلتيه فكانت","ساذجات الألحاظ من آثاره",6,"ر",2,0],["دغدغ الروض عابثاً بنداه","ساكباً روحه على أزهاره",7,"ر",2,0],["دغلت صدورهمُ لما أوتيته","وبدت عليهم فترة وقطوب",8,"ب",1,0],["‏دغدغ شعورك وابتسم","مهما استشاط بك الألم",9,"م",1,1],["دغدغت حسّنا بأحلى من الشدو","فشب الهوى بغافي القلوب",10,"ب",1,0]]}