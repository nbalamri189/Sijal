{"poems":[[94,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[50,"عاد لي بالسدير شارد قصف","https://www.aldiwan.net/poem64405.html","الخفيف"],[159,"لجنون الهوى وهبت جناني","https://www.aldiwan.net/poem55511.html","الطويل"],[214,"لا وليال بالحمى من نجد","https://www.aldiwan.net/poem13348.html","الرجز"],[234,"إنما العيش بلوغ السسول","https://www.aldiwan.net/poem50736.html","مجزوء الرمل"],[471,"يقول خليلي باللوى من حفارة","https://www.aldiwan.net/poem50474.html","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96619","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16795","الهزج"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6773","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49973","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124737","الطويل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126363","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129997","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100236","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46020","الرمل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35510","المديد"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22799","الرمل"],[182,"صنو روحي","https://www.poetsgate.com/ViewPoem.aspx?id=72810",""],[5691,"تناقضات","https://www.poetsgate.com/ViewPoem.aspx?id=206156",""]],"verses":[["ورخيمِها وعنيفِها","وبغيضِها وحبيبِها",0,"ه",2,0],["وَرَخيمُ الدَلالِ كادَ مِنَ الرِق","قَةِ يُدمي أَديمَهُ وَقعُ طَرفِ",1,"ف",1,0],["وَرَخِيمِ الدَّلالِ قَدْ تَاهَ في الحُسْ","نِ بَدِيعٍ تَضِلُّ فِيهِ المَعَاني",2,"ن",2,0],["ورخرخت عن جلنار خدها","وابرزت رمان ذاك النهد",3,"د",1,0],["ورَخيمٌ ساحرُ المٌقْ","لةِ معدومُ الشَّبِيه",4,"ي",2,0],["وَرَخصٍ بِهِ الحَنّاءُ لَم يَعدُ أَن جَلا","أَكَمتُهُ بَعدَ التَثَبُّتِ خاضِبُه",5,"ه",1,0],["وَرخيمة الأطرافِ طاوية الحشا","شمساً أضاءت بالشعاعِ من الخبا",6,"ب",2,0],["وَرُخٌّ يَنتَحي نَهجاً","فَلا يَعدو عَلى النَهجِ",7,"ج",1,0],["وَرَخَّمَ قِردُهُم دارَهُ","وَأَجرى إِلَيها نَميرَ العُيون",8,"ن",1,0],["ورخّموا نحو زهيرا أو يريه","في مذهب حكاه عنهم سيبويه",9,"ه",1,0],["ورخّم المعرفة المنفردا","بحذف آخر اسمه عند الندا",9,"د",2,0],["ورخيمة الأَطراف تُجنى عندها","ثمر المُنى من لحظ طَرفٍ أَحْوَرِ",10,"ر",1,0],["ورخص في وطء الطوامث في الفلا","إذا طهرت لم تغتسل بالتيمم",11,"م",1,0],["ورخيم الدلال حلو المعاني","تتثنى أعطافه مختاله",12,"ل",2,0],["ورخص البنان تصدّى لأن","يقط السراج بمثل العنم",13,"م",1,1],["ورخيمة لألفاظ ودَّ مخارق","يروي رقيق غناه عن نغماتها",14,"ت",3,0],["وَرَخيمُ الصَّوتِ مِنهُ","نَغمةُ النّايِ حَنوقَه",15,"ق",2,0],["وَرَخيم الدَلّ عَذبُ الثَنايا","شَرق الخِلخالِ صادي الوِشاحِ",16,"ح",1,0],["وَرُخاصِ الكَرخِ ظَبيٌ","لَم أَنَل مِنهُ اِفتِراصي",17,"ص",2,0],["ورخيمُ الصوت تَطْريباً أتى","خاتل السمع غَريداً شاقَني",18,"ن",2,0],["ورَخاءٍ تَراهُ بالنُّكْرِ سُخْطاً","وبَلاءٍ تَراهُ بالصَّبْرِ نُعْمى",19,"م",2,0]]}