{"poems":[[53,"أتذهل بعد إنذار المنايا","https://www.aldiwan.net/poem29623.html","الوافر"],[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[53,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[53,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[63,"صبابة نفس ليس يشفى غليلها","https://www.aldiwan.net/poem46134.html","الطويل"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[63,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[63,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[55,"يا إخوتي إني لموضع رحمة","https://www.aldiwan.net/poem26113.html","الكامل"],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[86,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[73,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[10,"ذكرت أخي بعد نوم الخلي","https://www.aldiwan.net/poem21082.html","المتقارب"],[93,"هنيئاً أيها الملك الهمام","https://www.aldiwan.net/poem11307.html","الوافر"],[93,"بارك الله في قران النجيبين","https://www.aldiwan.net/poem11381.html","الخفيف"],[88,"أطربتهم بلحنها الأنغام","https://www.aldiwan.net/poem44463.html","الخفيف"],[27,"أتعرف أم أنكرت أطلال دمنة","https://www.aldiwan.net/poem5729.html","الطويل"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[27,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[47,"إذا مررت بواد جاش غاربه","https://www.aldiwan.net/poem25129.html","البسيط"],[47,"وما أنس لا أنس يوم المغار","https://www.aldiwan.net/poem25380.html","المتقارب"],[72,"إنسان عيني ساهر بك سافح","https://www.aldiwan.net/poem18483.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"بليت بفلتة فضحكت فلته","https://www.aldiwan.net/poem8706.html","الوافر"],[51,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[51,"كنز الله في كنيزة نتنا","https://www.aldiwan.net/poem64718.html","البسيط"],[51,"متهلل زجل تحن رواعد","https://www.aldiwan.net/poem65503.html","الكامل"],[51,"لمت يا وهب أهل دهرك فيما","https://www.aldiwan.net/poem65981.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[29,"عز الشراب فأقبلت مشروبة","https://www.aldiwan.net/poem6107.html","الكامل"],[91,"جلست وقد هجع الغافلون","https://www.aldiwan.net/poem8802.html","عموديه"],[91,"قالت وصفت لنا الرحيق وكوبها","https://www.aldiwan.net/poem8857.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[92,"نحن نمشي وحولنا هاته الأك","https://www.aldiwan.net/poem38888.html","الخفيف"],[92,"راعها منه صمته ووجومه","https://www.aldiwan.net/poem38890.html","الخفيف"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"في جبال الهموم أنبت أغصاني","https://www.aldiwan.net/poem38948.html","الخفيف"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[43,"بم التعلل لا أهل ولا وطن","https://www.aldiwan.net/poem10591.html","البسيط"],[62,"الصلب يخلط بالرطوبة مدة","https://www.aldiwan.net/poem52221.html","الكامل"],[45,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[45,"لا أرى بالعقيق رسما يجيب","https://www.aldiwan.net/poem62639.html","الخفيف"],[45,"مخلف في الذي وعد","https://www.aldiwan.net/poem63496.html","مجزوء الخفيف"],[45,"أبا الفضل أنت فتى فارس","https://www.aldiwan.net/poem65635.html","المتقارب"],[61,"أعن الأهلة في الدياجر","https://www.aldiwan.net/poem51676.html","مجزوء الكامل"],[66,"زوج الماء بابنة العنقود","https://www.aldiwan.net/poem40987.html","الخفيف"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[80,"ثلاثة أفلاك عن العين مضمره","https://www.aldiwan.net/poem31435.html","الطويل"],[80,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[31,"قل للمنازل بالكديد تكلمي","https://www.aldiwan.net/poem41807.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"لست بدار عفت وغيرها","https://www.aldiwan.net/poem62428.html","البسيط"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[48,"انس رسم الديار ثم الطلولا","https://www.aldiwan.net/poem64509.html","الخفيف"],[48,"ودهماء ترسيها رقاش إذا شتت","https://www.aldiwan.net/poem65046.html","الطويل"],[48,"أعاذل ما غنيت عن المدام","https://www.aldiwan.net/poem65243.html","الوافر"],[48,"وبديع الحسن قد فاق","https://www.aldiwan.net/poem65303.html","مجزوء الرمل"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[46,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[46,"أمامة كيف لي بإمام صدق","https://www.aldiwan.net/poem22478.html","الوافر"],[46,"أيا سارحا في الجو دنياك معدن","https://www.aldiwan.net/poem22599.html","الطويل"],[46,"أتدري النجوم بما عندنا","https://www.aldiwan.net/poem22641.html","المتقارب"],[46,"سبحان ربك هل يزول كغيره","https://www.aldiwan.net/poem22706.html","الكامل"],[46,"لم يكن لي عرش فيثلم عرشي","https://www.aldiwan.net/poem22870.html","الخفيف"],[46,"قطعت البلاد فمن صاعد","https://www.aldiwan.net/poem22920.html","المتقارب"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[46,"لبكر لعمري بكر الدهر بالردى","https://www.aldiwan.net/poem23198.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[76,"ولرب نائحة على فنن","https://www.aldiwan.net/poem38853.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39602","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142345","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[98,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[45,"ظَلَمَ الدّهْرُ فيكُمُ، وَأسَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=32879",""],[51,"أجدرُ مالٍ أن يكون نائلاً","https://www.poetsgate.com/ViewPoem.aspx?id=30252",""],[92,"في جِبال لهمومِ، أننبتَّ أغصاني،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14569&r=&rc=14",""],[92,"راعها منهُ صَمتُه ووجُومُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14597&r=&rc=42",""]],"verses":[["وَتُغلِقُ دونَ رَيبِ الدَهرِ باباً","كَأَنَّكَ آمِنٌ قَرعَ الرَزايا",0,"ا",3,0],["وَتَغَنَّموا إِبطاءَ عارِضِها","مِن قَبلِ أَن يَمريهِ حَرجَفُها",1,"ف",3,0],["وَتَغشى في الظَلامِ بِضَو","ءِ غُرَّتِهِ عَذافِرُه",2,"ر",2,0],["وَتَغلَقُ فيهِم رُهونَ المُلوكِ","قَتلاً بِيَومِ طِعانٍ وَصَفدا",3,"د",2,0],["وَتَغَنَّموا عَفواً يَفيضُ وَفَيئةً","تَدنو وَحِلماً لا يَزالُ يَعودُ",4,"د",1,0],["وَتَغَزُّلٍ كَصَبا الأَصائِلِ أَيقَظَت","رَيّا خُزامى بِاللِوى وَأَقاحِ",5,"ح",1,0],["وَتَغدُرُ بي الأَقارِبُ وَالأَداني","فَلا عَجَبٌ إِذا غَدَرَ الصِحابُ",6,"ب",1,0],["وَتَغَنَّموا تِلكَ المَنا","زِلَ وَهيَ آمِنَةٌ رِغابُ",7,"ب",1,0],["وَتَغدو كَالكَواكِبِ لامِعاتٍ","تُمَزِّقُ مِن عَجاجَتِها الحِجابا",8,"ب",2,0],["وتَغْشى الوَغى بيضاً حِداداً سُيوفُهُ","فتَرْجِعَ حُمْراً بادِياتٍ فُلولُها",9,"ل",3,0],["وتُغْضي لكَ الأبْصارُ رُعْباً وتَنثَني","إليكَ الهَوادي طائِعاتٍ وخُضَّعا",10,"ع",2,0],["وتَغلي بأسرارِ العُذَيبِ ضَمائِري","ولكنْ قَليلٌ في النّوى هَفَواتُها",11,"ت",3,0],["وتَغدو إِلى سَرْحي أراقِمُ وائِلٍ","وقَد كان تَسْري في رُباهُمْ عَقاربي",12,"ب",2,0],["وَتَغَيَّرَت عَمّا عَهِدتُ وَإِنَّهُ","حَدَثٌ عَلَيَّ مِنَ البَلاءِ عَظيمُ",13,"م",1,0],["وتغَمّدَتْكَ منَ الإلاهِ سَعادَةٌ","تسْمو بروحِكَ للمَحَلِّ الرّاقي",14,"ق",2,0],["وَتَغَيَّرَت فيهِ الخُطوبُ بِفارِسٍ","حَتّى رَأَيتُ الشاهَ يَخشى البَيدَقا",15,"ق",2,0],["وَتَغولُهُ البُؤسى وَطَر","فُ رِعايَةِ الأَطفالِ ساهِر",16,"ر",1,0],["وَتَغنى عَنِ المَدحِ اكتِفاءً بِسَروِها","غِنى المُقلَةِ الكَحلاءِ عَن زينَةِ الكُحلِ",17,"ل",1,0],["وَتُغشي الخُيولَ حِياضَ النَجيعِ","وَتُعطي الجَزيلَ وَتُردي العِشارا",18,"ر",2,0],["وَتَغْبِط أُمَّةً بهُدَاكَ أَضْحَتْ","وَجَانِبُهَا عَزِيزٌ لا يُرَامُ",19,"م",1,0],["وَتَغَنى الوَصَّافُ بِالخُلُقِ السَّمَ","حِ وَبِالمَبْدَأِ القَوِيِّ القَوِيمِ",20,"م",1,0],["وتغنّت للقوم فيه قيان","أنكر العهد صوتها والذمام",21,"م",1,0],["وَتَغلِبُ لا مِن ذاتِ فَرعٍ بِنَجوَةٍ","وَلا ذاتِ أَصلٍ يَشرَبُ الماءَ عودُها",22,"د",3,0],["وَتَغلِبُ لا وُلاةُ قَضاءَ عَدلٍ","وَلا مُستَنكِرونَ لِأَن يُضاموا",23,"م",3,0],["وَتَغلِبُ لا يُصاهِرُهُم كَريمٌ","وَلا أَخوالُ مَن وَلَدوا كِرامُ",23,"م",1,0],["وَتَغضَبُ مِن شَأنِ القُيونِ مُجاشِعٌ","وَما كانَ ذِكرُ القَينِ سِرّاً مُكَتَّما",24,"م",2,0],["وَتَغتَدي الكومُ أَشتاتاً مُرَوَّعَةً","لا تَأمَنُ الدَهرَ إِلّا مِن أَعادينا",25,"ن",2,0],["وَتَغضَبُ حَتّى إِذا مامَلَكتَ","أَطَعتَ الرِضا وَعَصَيتَ الغَضَب",26,"ب",1,0],["وتغزل الأشعار فيك كواسد","ولهنَّ في مدح الجمال منادح",27,"ح",1,0],["وتغنَّى القُمْريُّ فيها أخاه","وأجابت مُكَّاءةٌ مُكَّاءَ",28,"ا",2,0],["وتغضبُ إنْ ضحكتُ بغير عمدٍ","ولم تسمعْ أذايَ ولا شَمِمتَهْ",29,"ت",2,0],["وتَغنَّى كأن صوتك من أن","فك صوتُ الزنبور في جوف كوز",30,"ز",1,0],["وتُغني فتُورثُ السمع وقْراً","فَعَلَيْها لمن تغنّته أرْشُ",31,"ش",1,0],["وتغرد المُكَّاء فيه كأنه","طَرِبٌ تعلَّل بالغناء مَشوق",32,"ق",1,0],["وتغضّبتَ من كلامِ أناسٍ","أكثروا إذ ضرطت قالاً وقيلا",33,"ل",2,0],["وتُغَنِّي الحمامُ بعدَ وجوم","بفنون اللحون في الأغصانِ",34,"ن",1,0],["وتَغنَّته بالمدائح فيه","كلُّ غيداء غادة مِفتانِ",34,"ن",1,0],["وَتَغَوَّلَت لِتَروعَنا جِنِّيَّةٌ","وَالغانِياتُ يُرينَكَ الأَهوالا",35,"ل",2,0],["وَتَغَيَّظَت أَيّامَها في شارِفٍ","نُقِلَت قَرائِنُهُ وَلَمّا يُنقَلِ",36,"ل",1,0],["وَتَغدو الطُيورُ بِأَجسادِها","فَإِن عَطِشَت فَالشَرابُ الدَمُ",37,"م",1,0],["وَتُغَيِّرُ الأَيّامُ قَلبَ فَتاتِهِ","وَيَظَلُّ ذا كَلَفٍ بِقَلبِ فَتاتِهِ",38,"ه",1,0],["وَتَغَزَّلْتُ بالحَيَاةِ وبالح","بِّ وغنَّيتُ كالسَّعيدِ اللاَّهي",39,"ي",1,0],["وتغشَّى الضَّبابُ نفسي فصاحتْ","في مَلالٍ مُرٍّ إلى أَيْنَ أَمشي",40,"ي",1,0],["وتَغَنَّى في ظلِّها الفَرَحُ الَّلا","هي فَجَفَّ الأَسى وخَرَّ هَشِيمُهْ",41,"م",2,0],["وتغلغلي كالنُّورِ في روحي التي","ذَبُلَتْ من الأَحزانِ والآلامِ",42,"م",1,0],["وتَغَزَّلْ بسِحْرِ أَيَّامِكَ الأولى","وخَلِّ الحَيَاةَ تخطو خطاها",43,"ه",2,0],["وتَغَنَّتِ الدُّنيا وغرَّدَ","بلبلُ الغَاب الجميلْ",44,"ل",1,0],["وتَغَشَّانيَ الضَّبابُ فأورقتُ","وأزْهَرتُ للعَواصفِ وَحْدي",45,"د",2,0],["وتَغَزلْتُ بالرَّبيعِ وبالفجرِ","فماذا ستفعلُ الرّيحُ بعدي",45,"د",2,0],["وتغنمه إذا ولَّى","عن الإنسان مغنمه",46,"م",2,0],["وَتَغشى أَبِيّاتِ المَعاقِلِ وَالذُرا","فَثَيِّبُهُنَّ البِكرُ وَالبِكرُ ثَيِّبُ",47,"ب",1,0],["وَتَغبِطُ الأَرضُ مِنها حَيثُ حَلَّ بِهِ","وَتَحسُدُ الخَيلُ مِنها أَيَّها رَكِبا",48,"ب",2,0],["وَتَغضَبونَ عَلى مَن نالَ رِفدَكُمُ","حَتّى يُعاقِبَهُ التَنغيصُ وَالمِنَنُ",49,"ن",1,0],["وتغلغلت في الأرض وهي جدية","فاستخرجت من قعرها الأزهارا",50,"ر",2,0],["وَتَغَشّى مُهَلهِلَ الذُلُّ فيهِن","نَ وَقَد أُعطِيَ الأَديمَ حِباءَ",51,"ا",2,0],["وَتَغَوَّلتَ جانِبَ اللَيلِ في سِرِّ","كَ وَاللَيلُ فاحِمٌ غِربيبُ",52,"ب",1,0],["وَتَغَضَّبتَ أَن شَكَو","تُ جَوى الحُبِّ وَالكَمَد",53,"د",1,0],["وَتَغضَبُ لِلفيلِ إِن أَزلَقو","هُ لِأَنَّ الأَعاجِمَ كانَت تُجِلُّه",54,"ل",2,0],["وتغايرَتْ فيه العُلى","حتى حَسِبناها ضَرائِر",55,"ر",1,0],["وَتَغانَت بِنَهرِ حَرزَمَ وَالغَر","سَينِ عَن نَهرِ ثَورَةٍ وَيَزيدِ",56,"د",1,0],["وَتَغْرِسُ مِنكَ العينُ في القلبِ فتنةً","وَوَجْدٌ جَناها بِالضميرِ وبلبالُ",57,"ل",1,0],["وتَغشى علِيّاً نَفحةٌ كَثَنائِهِ","مُرَدّدَةٌ في مَدحه ومُكَرَّرَه",58,"ر",2,0],["وَتَغورُ في هامِ العُلوجِ جَداوِلٌ","لِلضَّربِ مِن أَغمادِهِم تَتفَجَّرُ",59,"ر",1,0],["وَتَغلِبُ لاقَت غالِباً كُلَّ غالِبٍ","وَبَكرٌ فَأَلفَت حَربَنا بازِلاً بَكرُ",60,"ر",1,0],["وتغافلْ عنْ أمورٍ إنَّهُ","لمْ يفزْ بالرفدِ إلاّ مَنْ غفلْ",61,"ل",1,0],["وتغازلي والنَّاعِمَات","الزاحفاتِ من الهوامِ",62,"م",1,0],["وَتَغاطَسَت عَمّا بِنا وَلَقَد تَرى","أَن قَد تَخَلَّلَتِ الفُؤادَ بِأَسهُمِ",63,"م",1,0],["وتغشَى كُلَّ منزلةٍ وَمَثْوَىً","فيذهبُ كيدُها باللّاجئينا",64,"ن",2,0],["وتَغولَّتْ صُوَرُ القتالِ فأقبلا","والأرضُ من حَوْلَيْهما تَترجَّحُ",65,"ح",1,0],["وَتغنّتْ بِمَدْحِهِ الْجِنُّ حتَّى","أطرَبَ الإِنسَ منه ذاك الغِناءُ",66,"ا",2,0],["وتغْدُو على يحيَى الوُفودُ ببابِهِ","كما ابْتَدَرَتْ أُمَّ الحَطيم المَواسم",67,"م",1,0],["وتغدو فمنهنّ أسماعُنا","وأبصارُنا في حِجالِ المها",68,"ا",1,0],["وَتَغلِبٌ تَندُبُ الطُلولَ وَلَم","تَثأَر قَتيلاً عَلى ذَنائِبِها",69,"ب",3,0],["وَتَغدو في بَراجِدِها","تَصيدُ الذِئبَ وَالنَمِرا",70,"ر",2,0],["وَتَغَنّى عَلى المُدامِ ثَلاثاً","أُزجُرِ العَينَ أَن تُبَكّي الطُلولا",71,"ل",2,0],["وَتَغلي بِذِكرِ النارِ مِن غَيرِ حَرِّها","وَيُنزِلُها الطاهي بِغَيرِ جِعالِ",72,"ل",1,0],["وَتَغدو لِلصَوالِجِ كُلَّ يَومٍ","وَتَرمي بِالبَنادِقِ وَالسِهامِ",73,"م",1,0],["وَتَغَنَّينا بِحِذقٍ","يا دِيارَ الظاعِنينا",74,"ن",2,0],["وَتَغبِطُ شاوِيَ الحِرباءِ حَتّى","تَروحَ إِلَيهِ مِن حُبِّ القُتارِ",75,"ر",1,0],["وَتغدو في الكَراءِ لِنَيلِ زادٍ","وَلَيسَ بِسَيِّدِ القَومِ المُكاري",75,"ر",2,0],["وَتَغشى النِساءَ تُوازي بِهِن","وَمِن هَمِّكَ الحَيَّةُ الأَسوَدُ",76,"د",1,0],["وَتَغَشّى دَهماءَنا الغَيُّ لَمّا","عُطِّلَت مِن وُضوحِها الدَهماءُ",77,"م",3,0],["وَتَغدِرُ هَذِهِ الأَيّامُ مِنّي","كَما أَغدَرنَ مِن إِرَمٍ وَعادِ",78,"د",1,0],["وَتَغلِبُ كانَت سَيفَ بَكرٍ وَرُمحَها","فَأَمسَت تُرامي عَن حَرائِبِها بَكرا",79,"ر",2,0],["وَتَغبِطُ غانِيَةً في النِسا","ءِ تَعبِطُ في بَيتِها فارَها",80,"ر",3,0],["وَتَغَنَّتِ الدُنِّيا بِصَوتٍ واحِدٍ","لا تُحسِنُ الرَبداءُ غَيرَ زِمارِ",81,"ر",1,0],["وَتَغَنَّيتُ في الأَمورِ فَنابَت","قَدَمي عَن رُكوبِ دُهمٍ وَبُرشِ",82,"ش",1,0],["وَتَغبِطُ كُلّاً عَلى ما حَواهُ","وَما لَكَ في العَيشِ مِن غابِطِ",83,"ط",1,0],["وَتَغَرُّبُ الشِرّيرِ يوجَبُ حَتفَهُ","مِثلُ الوِجارِ إِذا تَسَحَّبَ صِلُّهُ",84,"ل",2,0],["وَتَغلِبُ مِن أَحياءِ تَغلِبَ سادَةً","وَقَد غَلَبَتهُم قَبلَ مُختَلِفِ الرَجلِ",85,"ل",1,0],["وَتَغمِسُ في الماءِ الَّذي باتَ آجِنا","إِذا أَورَدَ الراعِي نَضيحاً مُجَيَّرا",86,"ر",2,0],["وتَغرَّدتْ في غصنِ أيكتِها","فكأنما تغريدُها شَدْوُ",87,"و",1,0],["وتُغض من عينين دعجاوين في","وجهٍ صبيح فوق جيد أتلع",88,"ع",1,0],["وتُغري بيَ الموتَ لا جانياً","ولكنها ثورةٌ من غضبْ",89,"ب",1,0],["وتُغنّيكِ نشيداً مثلَهُ","ما تغنَّتْ لحبيبٍ زائرِ",90,"ر",1,0],["وَتَغْتَدِي يُوِفضُ سَيْراً بِهَا","مُنْخَطِفٌ كَالبَرْقِ أَوْ أَسْيَرُ",91,"ر",1,0],["وتغنت بالمروءات التي","عرفتها في فتاها العربي",92,"ب",2,0],["وتغيب في الصمت الكئيب كأنّها","كهف وراء الكون والأضواء",93,"ا",2,0],["وتغنَّتْ به شفاهُ العذارَى","ما أحبَّ الشفاهَ والألحانا",94,"ن",2,0],["وتغنّى الفراتُ بالسؤدد الفَخْ","مِ وحلَّى أجيادَه والمعاصم",95,"م",1,0],["وَتَغَشّى مُهَلْهِلَ الذّلُّ فيهِنّ","وَقَدْ أُعْطيَ الأدِيمَ حِبَاءَ",96,"ا",2,0],["وتغتدي أمنع خلق فاعلا","أقسمْتُ لولا أن أصيب عاذلا",97,"ل",2,0],["وَتَغَشَّانيَ الضَّبَابُ..، فأورقتُ","وأزهرتُ للعواضف، وحْدي",98,"د",2,0],["وتغنَّى في ظلها الفرحُ اللاهي","هي فَجَفَّ الأسى وَخَرّ هَشِيمُهْ",99,"م",2,0]]}