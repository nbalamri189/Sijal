oem33489.html","الكامل"],[404,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[404,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[410,"أطع الهوى واعص المعاتب","https://www.aldiwan.net/poem32615.html","مجزوء الكامل"],[417,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[417,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[430,"رشف المجد بالمسرة كاسه","https://www.aldiwan.net/poem39875.html","الخفيف"],[430,"نجم الهنا والمجد اشرق في سما","https://www.aldiwan.net/poem40827.html","الكامل"],[430,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[442,"لقد أثرت بي لسعة الكرش بالكرش","https://www.aldiwan.net/poem14309.html","الطويل"],[444,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[453,"كم حللت الحبى بشرخ الشباب","https://www.aldiwan.net/poem13629.html","الخفيف"],[453,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[453,"أرن في عذبات الأيك مرنان","https://www.aldiwan.net/poem13930.html","البسيط"],[454,"خطرت آسيا بعيد أبيها","https://www.aldiwan.net/poem61621.html","الخفيف"],[459,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[459,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[462,"سقى الله المهيمن قبر ثاو","https://www.aldiwan.net/poem15417.html","الوافر"],[462,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[462,"تقر بأسرار التقى خلواته","https://www.aldiwan.net/poem16417.html","الطويل"],[465,"أبدور تم أو وجوه كواعب","https://www.aldiwan.net/poem3409.html","عموديه"],[465,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[466,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[467,"أمسى الشباب مودعا محمودا","https://www.aldiwan.net/poem50445.html","الكامل"],[478,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[478,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[480,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[516,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[530,"دمت رب الإصدار والإيراد","https://www.aldiwan.net/poem37449.html","الخفيف"],[544,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[552,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[559,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[559,"قف على أيمن الحمى كوقوفي","https://www.aldiwan.net/poem34361.html","الخفيف"],[568,"سلام على الأطلال وحش خيامها","https://www.aldiwan.net/poem69505.html","الطويل"],[568,"هذ الصبوح فما الذي","https://www.aldiwan.net/poem69659.html","مجزوء الكامل"],[568,"حبذا الزائر في وقت السحر","https://www.aldiwan.net/poem69697.html","الرمل"],[571,"أخي والله خير من أخيكم","https://www.aldiwan.net/poem59471.html","الوافر"],[574,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[576,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[587,"يا حبذا نهر القصير ومغربا","https://www.aldiwan.net/poem17431.html","الكامل"],[587,"لما حدا بالأيمنين يسار","https://www.aldiwan.net/poem17510.html","الكامل"],[587,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"]],"verses":[["وَتُغلِقُ دونَ رَيبِ الدَهرِ باباً","كَأَنَّكَ آمِنٌ قَرعَ الرَزايا",0,"ا",3,0],["وَتَغَنَّموا إِبطاءَ عارِضِها","مِن قَبلِ أَن يَمريهِ حَرجَفُها",1,"ف",3,0],["وَتَغشى في الظَلامِ بِضَو","ءِ غُرَّتِهِ عَذافِرُه",2,"ر",2,0],["وَتَغلَقُ فيهِم رُهونَ المُلوكِ","قَتلاً بِيَومِ طِعانٍ وَصَفدا",3,"د",2,0],["وَتَغَنَّموا عَفواً يَفيضُ وَفَيئةً","تَدنو وَحِلماً لا يَزالُ يَعودُ",4,"د",1,0],["وَتَغَزُّلٍ كَصَبا الأَصائِلِ أَيقَظَت","رَيّا خُزامى بِاللِوى وَأَقاحِ",5,"ح",1,0],["وَتَغدُرُ بي الأَقارِبُ وَالأَداني","فَلا عَجَبٌ إِذا غَدَرَ الصِحابُ",6,"ب",1,0],["وَتَغَنَّموا تِلكَ المَنا","زِلَ وَهيَ آمِنَةٌ رِغابُ",7,"ب",1,0],["وَتَغدو كَالكَواكِبِ لامِعاتٍ","تُمَزِّقُ مِن عَجاجَتِها الحِجابا",8,"ب",2,0],["وتَغْشى الوَغى بيضاً حِداداً سُيوفُهُ","فتَرْجِعَ حُمْراً بادِياتٍ فُلولُها",9,"ل",3,0],["وتُغْضي لكَ الأبْصارُ رُعْباً وتَنثَني","إليكَ الهَوادي طائِعاتٍ وخُضَّعا",10,"ع",2,0],["وتَغلي بأسرارِ العُذَيبِ ضَمائِري","ولكنْ قَليلٌ في النّوى هَفَواتُها",11,"ت",3,0],["وتَغدو إِلى سَرْحي أراقِمُ وائِلٍ","وقَد كان تَسْري في رُباهُمْ عَقاربي",12,"ب",2,0],["وَتَغَيَّرَت عَمّا عَهِدتُ وَإِنَّهُ","حَدَثٌ عَلَيَّ مِنَ البَلاءِ عَظيمُ",13,"م",1,0],["وتغَمّدَتْكَ منَ الإلاهِ سَعادَةٌ","تسْمو بروحِكَ للمَحَلِّ الرّاقي",14,"ق",2,0],["وَتَغَيَّرَت فيهِ الخُطوبُ بِفارِسٍ","حَتّى رَأَيتُ الشاهَ يَخشى البَيدَقا",15,"ق",2,0],["وَتَغولُهُ البُؤسى وَطَر","فُ رِعايَةِ الأَطفالِ ساهِر",16,"ر",1,0],["وَتَغنى عَنِ المَدحِ اكتِفاءً بِسَروِها","غِنى المُقلَةِ الكَحلاءِ عَن زينَةِ الكُحلِ",17,"ل",1,0],["وَتُغشي الخُيولَ حِياضَ النَجيعِ","وَتُعطي الجَزيلَ وَتُردي العِشارا",18,"ر",2,0],["وَتَغْبِط أُمَّةً بهُدَاكَ أَضْحَتْ","وَجَانِبُهَا عَزِيزٌ لا يُرَامُ",19,"م",1,0],["وَتَغَنى الوَصَّافُ بِالخُلُقِ السَّمَ","حِ وَبِالمَبْدَأِ القَوِيِّ القَوِيمِ",20,"م",1,0],["وتغنّت للقوم فيه قيان","أنكر العهد صوتها والذمام",21,"م",1,0],["وَتَغلِبُ لا مِن ذاتِ فَرعٍ بِنَجوَةٍ","وَلا ذاتِ أَصلٍ يَشرَبُ الماءَ عودُها",22,"د",3,0],["وَتَغلِبُ لا وُلاةُ قَضاءَ عَدلٍ","وَلا مُستَنكِرونَ لِأَن يُضاموا",23,"م",3,0],["وَتَغلِبُ لا يُصاهِرُهُم كَريمٌ","وَلا أَخوالُ مَن وَلَدوا كِرامُ",23,"م",1,0],["وَتَغضَبُ مِن شَأنِ القُيونِ مُجاشِعٌ","وَما كانَ ذِكرُ القَينِ سِرّاً مُكَتَّما",24,"م",2,0],["وَتَغتَدي الكومُ أَشتاتاً مُرَوَّعَةً","لا تَأمَنُ الدَهرَ إِلّا مِن أَعادينا",25,"ن",2,0],["وَتَغضَبُ حَتّى إِذا مامَلَكتَ","أَطَعتَ الرِضا وَعَصَيتَ الغَضَب",26,"ب",1,0],["وتغزل الأشعار فيك كواسد","ولهنَّ في مدح الجمال منادح",27,"ح",1,0],["وتغنَّى القُمْريُّ فيها أخاه","وأجابت مُكَّاءةٌ مُكَّاءَ",28,"ا",2,0],["وتغضبُ إنْ ضحكتُ بغير عمدٍ","ولم تسمعْ أذايَ ولا شَمِمتَهْ",29,"ت",2,0],["وتَغنَّى كأن صوتك من أن","فك صوتُ الزنبور في جوف كوز",30,"ز",1,0],["وتُغني فتُورثُ السمع وقْراً","فَعَلَيْها لمن تغنّته أرْشُ",31,"ش",1,0],["وتغرد المُكَّاء فيه كأنه","طَرِبٌ تعلَّل بالغناء مَشوق",32,"ق",1,0],["وتغضّبتَ من كلامِ أناسٍ","أكثروا إذ ضرطت قالاً وقيلا",33,"ل",2,0],["وتُغَنِّي الحمامُ بعدَ وجوم","بفنون اللحون في الأغصانِ",34,"ن",1,0],["وتَغنَّته بالمدائح فيه","كلُّ غيداء غادة مِفتانِ",34,"ن",1,0],["وَتَغَوَّلَت لِتَروعَنا جِنِّيَّةٌ","وَالغانِياتُ يُرينَكَ الأَهوالا",35,"ل",2,0],["وَتَغَيَّظَت أَيّامَها في شارِفٍ","نُقِلَت قَرائِنُهُ وَلَمّا يُنقَلِ",36,"ل",1,0],["وَتَغدو الطُيورُ بِأَجسادِها","فَإِن عَطِشَت فَالشَرابُ الدَمُ",37,"م",1,0],["وَتُغَيِّرُ الأَيّامُ قَلبَ فَتاتِهِ","وَيَظَلُّ ذا كَلَفٍ بِقَلبِ فَتاتِهِ",38,"ه",1,0],["وَتَغَزَّلْتُ بالحَيَاةِ وبالح","بِّ وغنَّيتُ كالسَّعيدِ اللاَّهي",39,"ي",1,0],["وتغشَّى الضَّبابُ نفسي فصاحتْ","في مَلالٍ مُرٍّ إلى أَيْنَ أَمشي",40,"ي",1,0],["وتَغَنَّى في ظلِّها الفَرَحُ الَّلا","هي فَجَفَّ الأَسى وخَرَّ هَشِيمُهْ",41,"م",2,0],["وتغلغلي كالنُّورِ في روحي التي","ذَبُلَتْ من الأَحزانِ والآلامِ",42,"م",1,0],["وتَغَزَّلْ بسِحْرِ أَيَّامِكَ الأولى","وخَلِّ الحَيَاةَ تخطو خطاها",43,"ه",2,0],["وتَغَنَّتِ الدُّنيا وغرَّدَ","بلبلُ الغَاب الجميلْ",44,"ل",1,0],["وتَغَشَّانيَ الضَّبابُ فأورقتُ","وأزْهَرتُ للعَواصفِ وَحْدي",45,"د",2,0],["وتَغَزلْتُ بالرَّبيعِ وبالفجرِ","فماذا ستفعلُ الرّيحُ بعدي",45,"د",2,0],["وتغنمه إذا ولَّى","عن الإنسان مغنمه",46,"م",2,0],["وَتَغشى أَبِيّاتِ المَعاقِلِ وَالذُرا","فَثَيِّبُهُنَّ البِكرُ وَالبِكرُ ثَيِّبُ",47,"ب",1,0],["وَتَغبِطُ الأَرضُ مِنها حَيثُ حَلَّ بِهِ","وَتَحسُدُ الخَيلُ مِنها أَيَّها رَكِبا",48,"ب",2,0],["وَتَغضَبونَ عَلى مَن نالَ رِفدَكُمُ","حَتّى يُعاقِبَهُ التَنغيصُ وَالمِنَنُ",49,"ن",1,0],["وتغلغلت في الأرض وهي جدية","فاستخرجت من قعرها الأزهارا",50,"ر",2,0],["وَتَغَشّى مُهَلهِلَ الذُلُّ فيهِن","نَ وَقَد أُعطِيَ الأَديمَ حِباءَ",51,"ا",2,0],["وَتَغَوَّلتَ جانِبَ اللَيلِ في سِرِّ","كَ وَاللَيلُ فاحِمٌ غِربيبُ",52,"ب",1,0],["وَتَغَضَّبتَ أَن شَكَو","تُ جَوى الحُبِّ وَالكَمَد",53,"د",1,0],["وَتَغضَبُ لِلفيلِ إِن أَزلَقو","هُ لِأَنَّ الأَعاجِمَ كانَت تُجِلُّه",54,"ل",2,0],["وتغايرَتْ فيه العُلى","حتى حَسِبناها ضَرائِر",55,"ر",1,0],["وَتَغانَت بِنَهرِ حَرزَمَ وَالغَر","سَينِ عَن نَهرِ ثَورَةٍ وَيَزيدِ",56,"د",1,0],["وَتَغْرِسُ مِنكَ العينُ في القلبِ فتنةً","وَوَجْدٌ جَناها بِالضميرِ وبلبالُ",57,"ل",1,0],["وتَغشى علِيّاً نَفحةٌ كَثَنائِهِ","مُرَدّدَةٌ في مَدحه ومُكَرَّرَه",58,"ر",2,0],["وَتَغورُ في هامِ العُلوجِ جَداوِلٌ","لِلضَّربِ مِن أَغمادِهِم تَتفَجَّرُ",59,"ر",1,0],["وَتَغلِبُ لاقَت غالِباً كُلَّ غالِبٍ","وَبَكرٌ فَأَلفَت حَربَنا بازِلاً بَكرُ",60,"ر",1,0],["وتغافلْ عنْ أمورٍ إنَّهُ","لمْ يفزْ بالرفدِ إلاّ مَنْ غفلْ",61,"ل",1,0],["وتغازلي والنَّاعِمَات","الزاحفاتِ من الهوامِ",62,"م",1,0],["وَتَغاطَسَت عَمّا بِنا وَلَقَد تَرى","أَن قَد تَخَلَّلَتِ الفُؤادَ بِأَسهُمِ",63,"م",1,0],["وتغشَى كُلَّ منزلةٍ وَمَثْوَىً","فيذهبُ كيدُها باللّاجئينا",64,"ن",2,0],["وتَغولَّتْ صُوَرُ القتالِ فأقبلا","والأرضُ من حَوْلَيْهما تَترجَّحُ",65,"ح",1,0],["وَتغنّتْ بِمَدْحِهِ الْجِنُّ حتَّى","أطرَبَ الإِنسَ منه ذاك الغِناءُ",66,"ا",2,0],["وتغْدُو على يحيَى الوُفودُ ببابِهِ","كما ابْتَدَرَتْ أُمَّ الحَطيم المَواسم",67,"م",1,0],["وتغدو فمنهنّ أسماعُنا","وأبصارُنا في حِجالِ المها",68,"ا",1,0],["وَتَغلِبٌ تَندُبُ الطُلولَ وَلَم","تَثأَر قَتيلاً عَلى ذَنائِبِها",69,"ب",3,0],["وَتَغدو في بَراجِدِها","تَصيدُ الذِئبَ وَالنَمِرا",70,"ر",2,0],["وَتَغَنّى عَلى المُدامِ ثَلاثاً","أُزجُرِ العَينَ أَن تُبَكّي الطُلولا",71,"ل",2,0],["وَتَغلي بِذِكرِ النارِ مِن غَيرِ حَرِّها","وَيُنزِلُها الطاهي بِغَيرِ جِعالِ",72,"ل",1,0],["وَتَغدو لِلصَوالِجِ كُلَّ يَومٍ","وَتَرمي بِالبَنادِقِ وَالسِهامِ",73,"م",1,0],["وَتَغَنَّينا بِحِذقٍ","يا دِيارَ الظاعِنينا",74,"ن",2,0],["وَتَغبِطُ شاوِيَ الحِرباءِ حَتّى","تَروحَ إِلَيهِ مِن حُبِّ القُتارِ",75,"ر",1,0],["وَتغدو في الكَراءِ لِنَيلِ زادٍ","وَلَيسَ بِسَيِّدِ القَومِ المُكاري",75,"ر",2,0],["وَ