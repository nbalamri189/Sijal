{"poems":[[10,"أبك أبي عمرا بعين غزيرة","https://www.aldiwan.net/poem21077.html","الطويل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[275,"تلك الخمائل عريت أشجارها","https://www.aldiwan.net/poem35688.html","الكامل"],[463,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130747","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3749,"وليلة الربوة الشماء معلمة","https://www.poetsgate.com/ViewPoem.aspx?id=134972",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5512,"قضيت العمر أعجنه بصبري","https://www.poetsgate.com/ViewPoem.aspx?id=204500",""]],"verses":[["وَصَخراً وَمَن ذا مِثلُ صَخرٍ إِذا غَدا","بِساحَتِهِ الأَبطالُ قَزمٌ يَقودُها",0,"د",3,0],["وصَخرةٍ كانت عليهم صَيْلما","وانقلبوا منها إلى جَهنَّما",1,"م",2,0],["وصخرُكِ لا يزال اليومَ صخراً","يفُلُّ عزائماً ويشقُّ هَاما",2,"م",2,0],["وصخورُها في غابها وهِضابُها","حَرَسٌ مَجَرَّدةٌ عليَّ شِفارها",3,"ر",3,0],["وصخرٌ ذابَ صخرُ على قناكم","ولان لكم به الحجر الشديدُ",4,"د",1,0],["وصخرُ في نشوةٍ من سلعة ربحت","وفي يمامته يحلو له الغزل",5,"ل",1,0],["وصخرُ مضطجع يدنيهما اذناً","تصغى فتعمل في انحائها الجُمَل",5,"ل",1,0],["وصخر في مطلع العلياء مندلع","لسانه وبدا في وجهه الهزل",5,"ل",1,0],["وصخرٌ يقضُّ الترائك حول ال","قتل الذي خر هامي الدما",6,"م",2,0],["وصخرة المزة الغراء ناطحة","قرن الغزالة في مبدا تجليها",7,"ي",3,0],["وَصَخْرَةُ الخَنْدَقِ الصَّمَّاءُ شَاهِدَةٌ","بِضَرْبةٍ مِنْ رَسُولِ اللهِ ذِي الهِمَمِ",8,"م",1,0],["وصخرٌ في جبالِ العمرِ يقسو","وشوكٌ في ثنايا دربِ عمري",9,"ر",2,0]]}