{"poems":[[37,"ما بل ذاك البيت الذي كنت آلفا","https://www.aldiwan.net/poem39146.html","الطويل"],[53,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[93,"يا شاعر الحسن هذي روعة العيد","https://www.aldiwan.net/poem8808.html","عموديه"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[47,"شاقني بالعراق برق كليل","https://www.aldiwan.net/poem65569.html","الخفيف"],[68,"أيته كالهلال يبدو","https://www.aldiwan.net/poem39522.html","مجزوء البسيط"],[70,"ما بلدة في الشأم قلب اسمها","https://www.aldiwan.net/poem1557.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/142152","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[93,"روعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=53024",""],[97,"عروس المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=745&r=&rc=23",""],[147,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[255,"ما بلغ الله حسادي الذي طلبوا","https://www.aldiwan.net/poem14923.html","البسيط"],[302,"معاطف أم رماح سمهريات","https://www.aldiwan.net/poem33315.html","البسيط"],[406,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[445,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[591,"كيف خلاصي من الذي أجد","https://www.aldiwan.net/poem17479.html","المنسرح"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126880","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126756","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87114","الخفيف"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123407","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72313","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56086","المجتث"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35796","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79801","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77939","المنسرح"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123680","الكامل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141210","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109924","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35590","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[5573,"خالي انتم خابرينه","https://www.poetsgate.com/ViewPoem.aspx?id=201921",""],[5937,"طَلْقَة","https://www.poetsgate.com/ViewPoem.aspx?id=211807",""]],"verses":[["ما بلُ ذاكَ البَيتِ الَّذي كُنتَ آلِفاً","أَنارَكَ فيهِ بَعدَ إِلفِكَ نائِرُ",0,"ر",1,1],["ما بلغتْ بي الخطوب رتبةَ من","تفهم عنه الكلاب والقردَهْ",1,"د",2,0],["ما بُلبُلٌ كانَ مَسجوناً فَأَطلَقَهُ","سَحّانُهُ بَعدَ تعذيب وَتَنكيدِ",2,"د",1,0],["ما بلغت المنى لمصر ولكن","كنت تمشي على سواء السبيل",3,"ل",1,0],["ما بلغنا من اللبانات يا نفسي","سوى النزر بعد جهد جهيد",4,"د",1,0],["ما بَلَغنا التَقسيطَ حَتّى خَشينا","عَثرَةً ما يُقالُها المُستَقيلُ",5,"ل",1,0],["ما بَلَّ يَوماً غَليلَ قَلبي","وَإِن دَعاهُ الوَرى بِلالا",6,"ل",2,0],["ما بَلْدَةٌ في الشّأمِ قَلْبُ اسمها","تَصْحيفُهُ أخرى بأَرْضِ العَجَمْ",7,"م",1,1],["ما بلغت مغاني من شغف بها","إلاّ وقد بلغت نفسي تراقيها",8,"ي",3,0],["ما بلدة سعدت بالنهر يغمرها","بكل أزهر حالي العود ناضره",9,"ر",2,0],["ما بليت موهبة في حقها","ووعد ما ضن به الحرص البلى",10,"ا",1,0],["ما بلبل كان مسجونا فأطلقه","سحّانه ، بعد تعذيب وتنكيذ",11,"ذ",1,0],["ما بلغنا بعدُ من أحلامنا","ذلكَ الحلمَ الكريمَ الذهبي",12,"ب",2,0],["ما بَلَغَ الحَمدُ كَنهَ ما أَنتَ مو","ليهِ مِنَ العُرفِ وَهوَ مُجتَهِدُ",13,"د",1,0],["ما بلَّغ اللَه حُسَّادي الذي طلبوا","زارَ الحبيبُ وزال الهَجرُ والغَضَبُ",14,"ب",1,1],["ما بَلبلَ القَلبَ من وَجدٍ ومن وَلَهٍ","هوايَ لَولا العيونُ البابليّاتُ",15,"ت",1,0],["مابلَّل البحرُ المحيط ُ ثيابَه","يوماً ‘ ولا بَلَغَ المُرَادَ حَقُودُ",16,"د",1,0],["مَا بَلَّ بَحْرٌ صُوفَةً وتقاذَفَتْ","أَمْواجُهُ بشَمَائِلٍ وجَنَائِبِ",17,"ب",1,0],["ما بَلغُوا ما حَويْتُ مِنْ أَدبٍ","فَبالغُوا في أذايَ وَاجْتَهدُوا",18,"د",3,0],["ما بلدة إلّا وفيها مأتمٌ","ولهُ تحنّ بعولة ورنينِ",19,"ن",1,0],["ما بلدة إلّا ومنكَ قد اِكتَست","طيباً وشمّت مِن شَذاك عَبيرا",20,"ر",2,0],["ما بُلوغ المَأمول إِلّا لِشَخص","سادَ مثلي بمثل هَذا الحَكيم",21,"م",1,0],["ما بَلْبَلَ الأصْداغَ في وَجَنَاته","إلاّ ليترُك من رآه مُبَلْبَلا",22,"ل",2,0],["ما بلبل الأصداغ فوق عذاره","الا انطوى قلبي على بلباله",23,"ل",2,0],["ما بلبل الروض غنّى","وصادح الورق ناجى",24,"ج",2,0],["ما بَلَغَت وائِلٌ وَقَيسٌ","بِسيّدٍ مِنهُمُ عَظيمِ",25,"م",1,0],["ما بَلَغَت في ذُرى المَعالي","بِاِبنِ جَميلٍ بَنو تَميمِ",25,"م",1,0],["ما بلَّ أوجُهها الحيا ولو أنَّها","قِطعُ الصفا بلَّ الحيا مَلساءها",26,"ا",3,0],["ما بلغت نفسه هَواها","من بغية صعبة المراقي",27,"ق",2,0],["ما بلبل الأفراح قام مغرّداً","فوق الغصون الملد في ترنامه",28,"م",2,0],["ما بَلَغوا مِن المعارفِ سوى","ما أنسَ المغرورُ من رجعِ الصّدى",29,"ا",1,0],["ما بلدة أولها سورة؟","بل جبل صعب بعيد المنال",30,"ل",1,0],["ما بَليعال غيرُهُ فأَرِحني","منهُ يا ربِّ عَلَّني أَستريحُ",31,"ح",1,0],["ما بَلَغَ الأَوّلونَ قاطِبة","مَن رُتَبِ الفَضلِ بَعض ما بَلَغا",32,"غ",2,0],["ما بُلِّغا رَفعَهُ إِلّا بِجُهدِهِما","مِن صَفحَةِ الأَرضِ حَتّى يَبلُغَ العَجَلا",33,"ل",2,0],["مابلغتم منزلتهم بالذهب يامنفقينه","لومثل احد المدينه تنفقونه في حصانه",34,"ن",2,0],["مابل وجهك قد أضاع ملامحي","مابال وجهي قد أحيل دفاتِرا",35,"ر",2,0]]}