{"poems":[[29,"أمسيت إذ رحل الشباب حزينا","https://www.aldiwan.net/poem4446.html","الكامل"],[29,"هاج الهوى لفؤادك المهتاج","https://www.aldiwan.net/poem5696.html","الكامل"],[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[87,"زين الملوك الصيد مر بزينتي","https://www.aldiwan.net/poem7146.html","الكامل"],[50,"نبات بنت سباك الله من أمة","https://www.aldiwan.net/poem64993.html","البسيط"],[112,"غني بربي","https://www.poetsgate.com/ViewPoem.aspx?id=8379",""],[234,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[280,"يا آخذا في غير مسلك رشده","https://www.aldiwan.net/poem25403.html","الكامل"],[591,"ما بين هجرك والنوى","https://www.aldiwan.net/poem17844.html","مجزوء الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63801","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59635","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96677","الكامل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114030","الكامل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216394",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122504","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74056","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114123","المتدارك"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102750","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77695","الكامل"],[4764,"ساح القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=25366",""],[4764,"بقايا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=28003",""],[4764,"الدمع ساكن والاماني تفضحه","https://www.poetsgate.com/ViewPoem.aspx?id=28004",""],[4764,"ثلج الدفا","https://www.poetsgate.com/ViewPoem.aspx?id=29777",""],[4802,"أشواق وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=34418",""],[4874,"بنت مطلق","https://www.poetsgate.com/ViewPoem.aspx?id=176409",""],[4883,"عيونك أم الشجب والتنديد","https://www.poetsgate.com/ViewPoem.aspx?id=48364",""],[4883,"من جيل متبلد مغفل وتعبان !","https://www.poetsgate.com/ViewPoem.aspx?id=58829",""],[4883,"قرية سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=48355",""],[4883,"لا تعتذر لي لو سمحت","https://www.poetsgate.com/ViewPoem.aspx?id=48374",""],[4988,"أقضب لسانك","https://www.poetsgate.com/ViewPoem.aspx?id=196640",""],[4988,"رحيل ومحطات","https://www.poetsgate.com/ViewPoem.aspx?id=215968",""],[5106,"فَتْفُوتَةً قَدْ حَوَتْ حُسْنَاً مِنَ الكَسَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=137199",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5145,"أرأيت كيف تزعزع الأجيال؟","https://www.poetsgate.com/ViewPoem.aspx?id=108230",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5364,"ثامن عشر آذار","https://www.poetsgate.com/ViewPoem.aspx?id=177161",""],[5370,"صبحية العيد","https://www.poetsgate.com/ViewPoem.aspx?id=87581",""],[5573,"ياسعود لاصكت علي الغلايب","https://www.poetsgate.com/ViewPoem.aspx?id=200079",""],[5573,"رهين","https://www.poetsgate.com/ViewPoem.aspx?id=200342",""],[5573,"رشدك يغيب وتلتمس عندي الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=204549",""],[5587,"جيتك يا حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197806",""],[5652,"ياكبر ضيقات الليالي والايام","https://www.poetsgate.com/ViewPoem.aspx?id=208686",""],[5683,"برج الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=32346",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5764,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=137063",""],[5821,"نشرة الأخبار","https://www.poetsgate.com/ViewPoem.aspx?id=113756",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6082,"جفف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=60100",""],[6115,"ياقاتلين الذيب ماترحموا الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=180741",""],[6115,"قلت الحقيقه ولا فيها جدال وشكوك","https://www.poetsgate.com/ViewPoem.aspx?id=196466",""]],"verses":[["هاذا اِبنُ عَمّي في دِمَشقَ خَليفَةً","لَو شِئتُ ساقَكُمُ إِلَيَّ قَطينا",0,"ن",2,0],["هاذا هَوىً شَعَفَ الفُؤادَ مُبَرِّحٌ","وَنَوىً تَقاذَفُ غَيرُ ذاتِ خِلاجِ",1,"ج",1,0],["هاذا كَما تَرَكوا مَزاداً مُسلَماً","فَكَأَنَّما ذُبِحَ الخَروفُ الأَبقَعُ",2,"ع",1,0],["هاذي الصَحيفَةُ مِن قُفَيرَةَ فَاِقرَأوا","عُنوانَها وَبِشَرِّ طينٍ تُطبَعُ",2,"ع",1,0],["هاذ ابن هانئ نال ما قد نلت من","حسب نُدل به على الأحساب",3,"ب",1,0],["هاذي التَطاريفُ مِن غُنجٍ وَمِن عَبَثٍ","كَما زَعَمتِ فَما لِلطَرفِ مَكحولُ",4,"ل",1,0],["هاذي فقط نبذه عن أهل العراقه","والسامي أيرجّح كلامه سموّه",5,"و",2,0],["ها ذاك يسعَى يكشف سِرك لل","زّاري وهذا يرِيك وجهينِ",6,"ن",1,0],["هاذي الشعوب أحلّها بطن الثرى","فتلاحقت ببطونها الأفخاذُ",7,"ذ",1,0],["هَا ذَاكَ حَرَّكَه الهَوا","ءُ وأَنْتَ حَرَّكْتَ الهَوَى",8,"و",2,0],["هاذاك بازٍ وذاك صقرٌ","وتلك صَعْوٌ وذا هَزَار",9,"ر",1,0],["هاذي القلوب التي قد ألتهبتْ","بواكفٍ للدموع منهمر",10,"ر",1,0],["هاذي العيون التي بكتْ أسفاً","ما متعتْ في حُلاك بالنظر",10,"ر",1,0],["هاذي النفوس التي عفت كمداً","لم يبق منها الهوَى ولمْ يذر",10,"ر",1,0],["هاذي الخطوب التي متى وفدت","ألقت إلى العين ذاهبَ الأثر",10,"ر",1,0],["هاذي الصَّبا كلما أتتْ سحراً","أهدتْ لمثواك طيب الخبر",10,"ر",1,0],["هاذيكَ تُبليها الدهورُ وهذه","لَم تُبلها للحادثات قوارعُ",11,"ع",1,0],["هاذي الثَّلاثُ لها فؤادي شَيّقٌ","لم يألها قلبي العميدُ تَذَكُّرا",12,"ر",2,0],["هاذيه قولٍ صدْق ما فيه جحّاد","هاذيه شيٍ شايفِنّه وِكَادي",13,"د",2,0],["هاذِي حياةُ البُخارِي نُظِمَت دُرَراً","تحككِي قلائِدَ غيدٍ فِي تراقِيهَا",14,"ي",3,0],["ها ذاك باعَ العلا بَخساً وَذاكَ أَبى","أَن تَغتَدي لِلعدا أَوطانه سلعا",15,"ع",2,0],["هَاذِي عَادَاتُ الدَّهرِ بِنَا","قَبضٌ يَمضِي وَالبَسطُ يَجِي",16,"ج",2,0],["ها ذاك موسى كليم اللَه خاطبه","بأن يراه فقال انظر إلى الجبل",17,"ل",1,0],["هاذي دِيارُهُم فَمَثّلهم بِها","إِن المُتيّم شَأنُّه تَمثيلهُ",18,"ل",2,0],["هاذي تميل وهذا يسلب قلوب العذاره","ما بقى لِشعر موقف غيرِ صَمتٍ وانصرافي",19,"ف",2,0],["هَاذي الحِكايه عمرها جِيل لا جِيل","تِحكي زَوايا الحزن .. والليل يِنهال",20,"ل",1,0],["هاذي جِزاته وهذا كل اللي جناه","الدمع ساكن / والأماني تِفضحه",21,"ح",2,0],["هاذي انا ياما الهوى ارداني","وياما غدا وجدي معه مظلومي",22,"م",2,0],["هاذي حكاية طفلة مشوارها دمع وانين","عاشت يتيمة وحدها ذاقت سموم اقدارها",23,"ر",3,0],["هاذيك مفلولة حجاج وشريفه","وهاذيك من قالت للاحسان:ياعم",24,"م",1,0],["هاذي ضلوعي من عرار وبيد","ووصلك رفيف البرق والرعّاد!",25,"د",1,0],["هاذي فلسطين أتوجد ل منصور","ولا ناصر إلا في فلسطين شبان",26,"ن",1,0],["هاذي قصص بندر المتروك وحده داخله دُور","صَغْر صَغْر لين عوّد فالقرايا رجْلْ ف مهاد",27,"د",1,0],["هاذي يدك ..هاذي يديّ","صح لي..وانا لاصحت ، صحت!",28,"ت",1,0],["هاذي المرّه منعني من يمونون","أقضب لسانك ترى شتمي جريمه",29,"م",2,0],["هاذي هي الدنيا رحيل ومحطات","ما لي بها وجهه ولا لي عناوين",30,"ن",1,1],["هَاذِيْ شِرَاعِيْ وَكَمْ أَبْدَلْتُ أَشْرِعَتِيْ","وَفِيْ مَوَانِيْ الدُّنَىْ قَدْ عَاشَ بيْ أَمَلِيْ",31,"ل",2,0],["هَاْذِيْ بَنُوْكِ بَدَتْ تَبْنِيْ لَكِ زَمَنَاً","تَاْرِيْخُهَاْ أَلَقٌ كَالنُّوْرِ إنْ يَهَبِ",32,"ب",1,0],["هاذاك فخر الدين ثم بهاؤه","وشهابه راعاهم الإقبال",33,"ل",1,0],["هاذا اخو نوره كما الليث ضرغام","على العدا مسلول سيفه يسنا",34,"ن",2,0],["هاذي ثلاث سنين من ثورة الشام","ثامن عشر 18 آذار وش عاد بااقي",35,"ق",2,0],["هاذي معايدها قبل وقت الأسحار","وهذيك صاحبها عطاها رسايل",36,"ل",1,0],["هاذيك اليس وذي بلاد العجايب","فيها التلول يغرد الطير مرحا",37,"ح",2,0],["هاذا قصيدي جاي لمك سفاره","وضحت لك يانور عيني عن شفوف",38,"ف",1,0],["هاذيك راحت وانتهت رحلة المجد","يوم انتهى وصل الحضر للبوادي",39,"د",2,0],["هَاذُومَا الكَلْمَاتْ خَرْجُو مِنْ صُلْبِي","صَوْبَكْ مَا نْبَدَّلَشْ وْ رَبِّي هُوَ التَّوَابْ",40,"ب",1,0],["هاذي ثلاث سنين يابحر الأحلام","وعيني على الغالي تزيد احتمالي",41,"ل",2,0],["هاذي حياتي .. كلها .. كومة ركام","ومن صدمتي .. لاحت عليها النهايات",42,"ت",1,0],["هاذي قصيده من قصائد فيصل","فيها العسل يخلط بسم الدابي",43,"ب",2,0],["هاذي اطهر بنت تسرقني بهون","هاذي غيمة مرت ارض اليائسين",44,"ن",1,0],["هاذي هاذي خلتني ماشوف الاخبار","لاني اشوف الضلم بعيوني ولااسوي له حاجه",45,"ه",1,0],["هاذي طريقة سالف عن سالف","جلت عن التضليل والالحاد",46,"د",1,0],["هاذي الحياة وانت لن تُغيّرها","بين التحدّي وبين اليأس شتّانُ",47,"ن",1,0],["هاذي طلاقة صانعين الأكاذيب","الكذب صنعه عند هم شي عادي",48,"د",2,0],["هاذي نماذج من انماط البشر والسلوك","بالناس طيب وردا وأمام ومشعوذا",49,"ذ",2,0]]}