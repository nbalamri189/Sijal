{"poems":[[95,"هو العيش جهد طائل وفتون","https://www.aldiwan.net/poem11186.html","الطويل"],[30,"ستأتيك مني إن بقيت قصائد","https://www.aldiwan.net/poem5426.html","الطويل"],[82,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[50,"ومجلس خمار إلى جنب حانة","https://www.aldiwan.net/poem64427.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[102,"لعيني أم بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=50431",""],[406,"موازين الرجال","https://www.aldiwan.net/poem6777.html","عموديه"],[438,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48219","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109515","الوافر"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145300","المتقارب"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105504","الوافر"],[4767,"شهداء العقيدة","https://www.poetsgate.com/ViewPoem.aspx?id=179282",""],[4908,"قصر المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=209096",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5512,"بوحي مهيض","https://www.poetsgate.com/ViewPoem.aspx?id=204169",""],[5956,"تبَسُّمُ عاشقتي","https://www.poetsgate.com/ViewPoem.aspx?id=182048",""]],"verses":[["لَهَا تَسْتَمِدُّ البِرُّ مِنْ كُلِّ قَادِرٍ","وَمَا أَنْتَ بِالقِسْطِ الوَفِيرِ ضَنِينُ",0,"ن",1,0],["لَها تُشرِقُ الأَحسابُ عِندَ سَماعِها","إِذا عُدَّ فَضلُ الفِعلِ مِن كُلِّ فاعِلِ",1,"ل",1,0],["لها تألقُ برقٍ كيف قَيّدَهُ","في الكأسِ ساقٍ يُنيلُ الوَرْدَ في عنَمِ",2,"م",1,0],["لَها تَفَراتٌ تَحتَها وَقَصارُها","إِلى مَشرَةٍ لَم تُعتَلَق بِالمَحاجِنِ",3,"ن",1,0],["لَها تاجُ مَرجانٍ وَإِكليلُ لُؤلُؤٍ","وَتَرنيمُ نَشوانٍ وَصُفرَةُ عاشِقِ",4,"ق",1,0],["لَهَا تَرَةٌ فِي كُلِّ حَيٍّ وَما لَهَا","عَلَى طُولِ مَا تَجْنِي عَلَى الْخَلْقِ وَاتِرُ",5,"ر",1,0],["لها ترانيمُ إنْ سارتْ مُهَمْهَمةً","كالشعرِ يُتْبعُ بالتحريكِ تسكينا",6,"ن",2,0],["لها تلويح توديعي","لها أشواق أوباتي",7,"ت",2,0],["لها تمثالُها الموصوفُ زور","بأحسنِ ما يُصاغُ من المقالِ",8,"ل",1,0],["لها ترفع الأستار وهي سواترُ","وتأبى العُلا لي أن أقولَ هواتِكُ",9,"ك",1,0],["له أتانا في التمام يقثل","وخف من نقص عليه يدخل",10,"ل",1,0],["لها تشهد الأعداءُ في كلِّ محفلٍ","هي السحرُ لا شعرٌ يناظرُها قَطُّ",11,"ط",1,0],["لها تهدي الفواتح زائروها","ويتلون المحامد والمدائح",12,"ح",1,0],["له اتباعا اذا احكمت عقدك في","روم اقتداء به يا طيب الشيم",13,"م",1,0],["لها توبة يستفيد الندام","جميع المسرات من فوتها",14,"ت",3,0],["له اتخذ الصيد من صحبه","بيوم به عز نصر الصحيب",15,"ب",1,0],["لَها تدعو الأحبةَ حيث فيها","بِماء الود كم يَخضر عود",16,"د",1,0],["لها تعزف الأنغام في السر والعلن","إذا جائني مرسول يحمل سلامها",17,"م",3,0],["لها تسيارها لكن عليكم","مطابقة الذهاب على الإياب",18,"ب",1,0],["لَهَاتُهُ اليومَ ما عادتْ بشاديةٍ","واليومَ صارَ بلا ليلايَ مخبولا",19,"ل",2,0],["لها تاجُ شعر كثيفٌ جميل","يغطي الوجود بإكليل بيدَرْ",20,"ر",1,0]]}