{"poems":[[53,"شهدت بعض المخانيث","https://www.aldiwan.net/poem65476.html","المجتث"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[87,"يقال كانت فأرة الغيطان","https://www.aldiwan.net/poem8045.html","الرجز"],[107,"ألا إن هذا وفد كندة قد أتى","https://www.aldiwan.net/poem44007.html","الطويل"],[107,"سويلم ما قول ببيتك يفترى","https://www.aldiwan.net/poem44029.html","الطويل"],[107,"كذلك يشقى الجامح المتعسف","https://www.aldiwan.net/poem44190.html","الطويل"],[42,"ألا أيها الربع الذي خف أهله","https://www.aldiwan.net/poem42340.html","الطويل"],[50,"جالست يوما أبانا","https://www.aldiwan.net/poem66153.html","المجتث"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10689","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"],[197,"قال لمن يحلقه","https://www.aldiwan.net/poem13063.html","مجزوء الرجز"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[406,"أغصان الحروف","https://www.aldiwan.net/poem6789.html","عموديه"],[518,"ولما وقفنا للوداع وبيننا","https://www.aldiwan.net/poem67764.html","الطويل"],[520,"لما رأيت عراص القصر خالية","https://www.aldiwan.net/poem12048.html","البسيط"],[541,"وقد زاد نفسي واطمأنت وآمنت","https://www.aldiwan.net/poem23845.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66722","الطويل"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109579","السريع"],[2327,"","https://poetry.dctabudhabi.ae/diwan/poem/123669","الطويل"],[3256,"","https://poetry.dctabudhabi.ae/diwan/poem/20938","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92059","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131025",""],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105265","المتقارب"]],"verses":[["فقال رأي قويٌّ","رآه شيخٌ ضعف",0,"ف",1,0],["فَقالَ رَبُّ العَرشِ ما خَطبُكُم","ما بالُكُم صَرَخاتُكُم عالِيَه",1,"ه",1,0],["فَقالَ رَفٌّ لَم أصِبهُ عالي","صَيَّرَني أَعرج في المَعالي",2,"ي",1,0],["فقال رُويداً إنّني لستُ كاهناً","ومَهْلاً فهذا شاهدٌ صادقُ الخَبَرْ",3,"ر",1,0],["فقالَ رسولُ اللهِ بل قُلتمُ الذي","عَلِمتُ وما يخفَى عَليَّ المُغيَّبُ",4,"ب",1,0],["فقال رَسولَ اللهِ جئتُكَ شافعاً","لشيخٍ دعاني ضارعاً يتلهّفُ",5,"ف",1,0],["فَقالَ رَفيقي ما الوُقُوفُ بِمَنزِلٍ","وَنُؤىٍ كَعِنوانِ الصَحِيفَةِ ماثِلِ",6,"ل",1,0],["فَقالَ رَبُّكَ ذو مُق","لَةٍ إِذَن وَلِسانِ",7,"ن",1,0],["فَقالَ رَماني الدَهرُ مِنهُ بِقَوسِهِ","وَأَعرَضَ إِلفي فَالفُؤادُ يَذوبُ",8,"ب",1,0],["فقالَ ريبُ المَنونِ كلّا","هَيهاتَ أَن يُؤمن المَخوفُ",9,"ف",1,0],["فَقالَ رِفقاً يا فَتى","بَينَ يَدَيكَ يَسقُطُ",10,"ط",1,0],["فقال ردُّوا صِلَته","منه وقدّوا خِلعتَه",11,"ه",1,0],["فقال: رويدك في رحلتي","شقائي فياليت لي مستقر",12,"ر",1,0],["فقال رفيقي ما للونك حائلاً","وعينيك ما يعدو جفونك جودها",13,"د",3,0],["فقال رأي ضعيف لا يطاوعني","كيف السلو وأهل الفضل قد ماتوا",14,"ت",3,0],["فَقالَ رَسولُ اللَهِ يا رَبِّ أَعنِهِ","فَمَهما تَشَأ مِن مُفظَعِ الأَمرِ تَفرِجِ",15,"ج",1,0],["فقال رسولُ الله قمْ لوصيِّه","فقامَ وقِدماً كانَ غيرَ مُقَصِّرِ",16,"ر",1,0],["فقال رب أئتني يشاركني","في أكله وانتهاز لذته",17,"ت",2,0],["فقال رزق اللَه قلنا نعم","لا شك رزق اللَه رزق حسن",18,"ن",1,0],["فقال رويناه على الكتم بيننا","وما كل ما ترى عيون الظبا يروى",19,"و",2,0],["فَقالَ رَأَيتُ الأَرضَ لَيسَ بِمُمحِلٍ","وَلا سارِحٍ مِنها عَلى الرَعيِ يَشبَعُ",20,"ع",1,0],["فَقالَ رَأى بِخَدّي وَردَ حُسنٍ","فَراحَ بِلَحظِهِ عَمداً جَناهُ",21,"ه",1,0],["فقال رضوانه فيما يؤرِّخُه","ثَوى أَبو النَصر من أنس الجنان وَطَن",22,"ن",1,0],["فقال رجوت المستحيل وإنني","لأشهد أن الله أرسل أحمدا",23,"د",2,0],["فقال رضيت ولكنني","أخاف عليك حدود الأسل",24,"ل",1,0]]}