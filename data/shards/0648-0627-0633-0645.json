ttps://www.aldiwan.net/poem47334.html","الكامل"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[552,"ألم تسأل الطلل الدارسا","https://www.aldiwan.net/poem47752.html","المتقارب"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[552,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[552,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[552,"ولي صاحب لا يصحب الضيم ربه","https://www.aldiwan.net/poem48089.html","الطويل"],[559,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[559,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[559,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[559,"أيها القوم السكارى","https://www.aldiwan.net/poem33840.html","مجزوء الرمل"],[559,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[559,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[559,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[559,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[559,"عرجا بي على النقا فجياد","https://www.aldiwan.net/poem34617.html","الخفيف"],[559,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[559,"من كان بالعشق مفقود","https://www.aldiwan.net/poem34638.html","المجتث"],[559,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[560,"يا ساقي القوم من شذاه","https://www.aldiwan.net/poem69336.html","مخلع البسيط"],[560,"حرك الوجد في هواكم سكوني","https://www.aldiwan.net/poem69337.html","الخفيف"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[568,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[587,"يا مالك رق الصب بالله عليك","https://www.aldiwan.net/poem17638.html","مخلع الرمل"],[588,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["وَأَسمَرَ هَزهازِ الكُعوبِ كَأَنَّهُ","قَرا الذِئبِ مَجبولٌ عَلى العَسَلانِ",0,"ن",1,0],["وَأَسمَرَ يَهتَزُّ في راحَتي","كَما هَزَّتِ القَلَمَ الإِصبَعُ",1,"ع",1,0],["وَأَسمَعُ لَيلَةَ أَورادِها","تَداعي الرُغاءِ وَزَجرِ الرُعا",2,"ع",2,0],["وَأَسمَرَ شارِعاً في كُلِّ نَحرٍ","شُروعَ الصَلِّ في يَنبوعِ ماءِ",3,"ا",2,0],["وأسْمَرَ في نُحولِ الصَّبِّ لَدْنٍ","كقَدِّ الحِبِّ لِيناً واعْتِدالا",4,"ل",2,0],["واسْمَح ولوْ بمَزارِ لُقْيا في الكَرَى","تُبْقِي بِها منّا علَى الأرْماقِ",5,"ق",1,0],["وَاسمُ عَن الَكوْن تَبْقَ مِنْهُ","وَمِنْ أَذَى الْكَوْنِ فِي أمَانِ",6,"ن",1,0],["وَاسْمُكِ مَقْلُوبُهُ يُبَيِّنُ لِي","مَآلَ أَمْرِي فِي مَعْرِضِ الْفَالِ",7,"ل",1,0],["وَأَسمَعتُ مَن أَخشى عَليهِ مَغازِلَ ال","حَديثِ وَأَحراسُ الحَديثِ مَغازِلُه",8,"ل",2,0],["وَاِسمَع فَإِنّي طَبِنٌ عالِمٌ","أَقطَعُ مِن شَقشَقَةِ الهادِرِ",9,"ر",1,0],["وَأَسمَعُ لِلكُتّابِ في مِصرَ ضَجَّةً","فَأَعلَمُ أَنَّ الصائِحينَ نُعاتي",10,"ت",2,0],["وَاِسمَع مَديحَ مُحِبٍّ","يُطري بِحَقٍّ وَيُثني",11,"ن",2,0],["وَأَسمَعُ في الدُنيا دُعاءً بِنَصرِهِ","يُرَدِّدُهُ البَيتُ العَتيقُ وَيَثرِبُ",12,"ب",1,0],["وَأَسمَرٍ كَالهِلالِ رُكّبَ في","غُصنِ أَراكٍ مُهَفهَفٍ رَطبِ",13,"ب",1,0],["وَأَسماءُ لا مَشنوعَةٌ بِمَلامَةٍ","إِلَينا وَلا مَعذورَةٌ بِاِعتِلالِها",14,"ل",3,0],["واسمع في الآفاق من كل جانبٍ","وأناشيد بشرى في النفوس لها صدى",15,"د",2,0],["وَاسْمُ سَمْعانَ مَالِيءُ السَّمْعِ","فِي كُلِّ مَكَان بِطَيِّبَاتِ الفِعَالِ",16,"ل",1,0],["وَأَسمَراً في رَأسِهِ أَزرَقٌ","مِثلُ لِسانِ الحَيَّةِ الصادي",17,"د",2,0],["وَأَسمَعُ مِنها نَبأَةٍ فَكَأَنَّما","أَصابَ بِها سَهمٌ طَريرٌ فُؤاديا",18,"ي",2,0],["وَأَسمَرَ قَوّامٍ إِذا نامَ صُحبَتي","خَفيفِ ثِيابٍ لا تُواري لَهُ أَزرا",19,"ر",2,0],["واسمع غنا أن معلم","وأنزوي واتعتّم",20,"م",1,0],["وأسمعتها فنون السحر مبدعةٌ","وُرْقُ الحمام وغنّاهَا مُغنّيها",21,"ي",3,0],["وأسمَى من سما أدباً وعلماً","وأفصح من تكلّم عن سَداد",22,"د",1,0],["واسم أمرىء طيره كالظبي معترضاً","ولا النغيق من الشحاجةِ النُعُبِ",23,"ب",1,1],["واسمٌ هو المستفادُ لا النَبَزُ ال","كاذبُ مَن قَالَهُ ولا اللَّقَبُ",24,"ب",1,0],["واسم هو المستفاد ولا النبر","للكاذب من قاله ولا القلب",25,"ب",1,0],["وَأَسمَرُ مِمّا يُنبِتُ الخَطُّ ذابِلٌ","وَأَبيَضُ مِمّا تَطبَعُ الهِندُ باتِرُ",26,"ر",1,0],["وَأَسمَعَكَ الداعي الفَصيحُ بِفُرقَةٍ","وَقَد جَنَحَت شَمسُ النَهارِ لِتَغرُبا",27,"ب",2,0],["واسْمع مدائح قد فاه الجمادُ بها","وقد ترنم فوقَ الأيكِ طائره",28,"ر",2,0],["واسمع مدائح كالأسلاك من دُرَرٍ","غنَّى بها مادحوه أيّة سلكوا",29,"ك",3,0],["واسْمع مدائح لم يعجز تواصلها","وربَّما عجزت عن وقت إيصال",30,"ل",1,0],["واسْمَعْ مِنَ المُسْمِعَات فيكَ وهلْ","تسمعُ إلا ما فيك من مِدح",31,"ح",1,0],["واسْمعاني الآن صوتاً طال ما","كادتِ النفسُ عليه تنفطِر",32,"ر",1,0],["واسمع وأسمِعنا بما لم تزل","من شهرنا الظاعن في محبِس",33,"س",1,0],["واسم كيد المجرَّب الكيدِ كيْدٌ","ظَاهِرٌ قبل باطنٍ ختَّالِ",34,"ل",1,0],["واسمع أبا جعفر إن كنت مستمعاً","فلم تزل ماجد الإصغاء والأذن",35,"ن",1,0],["وَأَسمَعُ فَأَصواتُ الطُيورِ عَلَت","بَينَ النَقا وَالضال وَالسِدرِ",36,"ر",1,0],["واسمعي هَمْسَ السَّواقي","وانشقي عِطْرَ الزُّهُورْ",37,"ر",1,0],["واسمعي شبَّابتي تَشْدُو","بمعسولِ النَّشيدْ",37,"د",1,0],["واسمعي الرِّيحَ تُغَنِّي","في شَمَاريخِ الجِبَالْ",37,"ل",1,0],["واسمعي الغابَ فهو قيثارَةُ الكو","نِ تغنِّي لحبّنا الميمونِ",38,"ن",1,0],["وأَسْمَعَهُ صَرَخاتِ القُلُوبِ","وأَنْهَلَهُ مِنْ سُلافِ الشُّؤونْ",39,"ن",1,0],["وأسمع القول بأذنى","بعد ذاك الصمم",40,"م",1,0],["واسمع لقول العقل لا قول الهوى","إن الهوى لضلالة لا تتبع",41,"ع",1,0],["وَاِسمَع بِمِصرَ الهاتِفي","نَ بِمَجدِها وَالهاتِفاتِ",42,"ت",1,0],["وَاِسمُ بِالأَرواحِ وَاِدفَعها إِلى","عالَمِ اللُطفِ وَأَقطارِ الصَفاء",43,"ا",2,0],["وَاِسمَحي بِالعِناقِ إِن رَضِيَ الدَلُّ","وَسامَحتِ فانِياً في العِناقِ",44,"ق",1,0],["وَأَسمَجُ مِنهُ في عَيني جُباةٌ","تَراهُم وَسطَهُ وَبِجانِبَيهِ",45,"ي",2,0],["وَآسِ ما باتَ يَذوي مِن مَنازِلِنا","بِالحادِثاتِ وَيَضوى مِن مَغانينا",46,"ن",2,0],["وَاِسمُ الخَليفَةِ في الجِهاتِ مُنَوِّرٌ","تَبدو السَبيلُ بِهِ وَيَهدي الساري",47,"ر",2,0],["وَأَسمَعَ مِن أَلفاظِهِ اللُغَةَ الَّتي","يَلَذُّ بِها سَمعي وَلَو ضُمِّنَت شَتمي",48,"م",2,0],["وَأَسمَرَ ذي عِشرينَ تَرضاهُ وارِداً","وَيَرضاكَ في إيرادِهِ الخَيلَ ساقِيا",49,"ي",2,0],["وأسمتُ طرفي في رِياض جمالِها","والحسنُ روضٌ والعيونُ سَوامُ",50,"م",1,0],["وأسمو إِلى نيلِ الأماني واقتضِي","مواعيدَ دَهْرٍ مولَعٍ بمطالِ",51,"ل",1,0],["وأسمعني داعي الغَرامِ ِنداءَهُ","فقمتُ إِليه مسرعاً غيرَ لابِثِ",52,"ث",1,0],["وَاِسمٍ شَقَقتَ لَهُ مِنِ اِسمِكَ فَاِكتَسى","شَرَفَ العُلُوِّ بِهِ وَفَضلَ المَفخَرِ",53,"ر",1,0],["وَأَسمَرُ مِن رِماحِ الحَظِّ لَدنٍ","شَدَدتُ غِرابَهُ أَن لا يُحابا",54,"ب",2,0],["وَأَسمَعُ مِن نَجوى الدَفاتِرِ طُرفَةٌ","أُزيلُ بِها هَمّي وَأَجلو بِها حُزني",55,"ن",2,0],["وَأَسمَرُ كَالخَطِّيِّ زُرقاً عُيونُهُ","كَذاكَ رِماحُ الخَطِّ زُرقاً عَلى سُمرُ",56,"ر",1,0],["وَأَسمَعُ مِن وُشاةِ الحَيِّ فينا","كَلاماً دونَ مَوقِعِهِ النِبالُ",57,"ل",1,0],["وَأُسمِعُ الناسَ أَوصافاً عُرِفتَ بِها","حَتّى كَأَنَّكَ في الأَحياءِ مَعدودُ",58,"د",1,0],["وَأَسمَرَ ناهَزَ العِشرينَ لَدنٍ","رُدَينيِّ المَناسِبِ ذي اِعتِدالِ",59,"ل",1,0],["وَأَسمَرَ مَهزوزَ المَعاطِفِ ذابِلٍ","وَأَبيَضَ مَسنونِ الغِرارَينِ قاضِبِ",60,"ب",1,0],["وأسمرُ خطيٌّ أمامَ كُعوبِهِ","سنانٌ ذليقٌ ينفذُ الحلقَ السّرْدا",61,"د",2,0],["وَأَسمَرَ مُحمَرِّ العَوالي يَؤُمُّهُ","سِنانٌ بِحَبّاتِ القُلوبِ مُمَتَّعُ",62,"ع",1,0],["وأسمرَ زاهٍ قدْ تقلَّدا أسمرا","وأبيضَ ناهٍ قدْ تقلَّدَ أبيضا",63,"ض",2,0],["وَأَسمَرٍ يَلحَظُ عَن أَزرَقٍ","كَأَنَّهُ كَوكَبُ رَجمٍ وَقَد",64,"د",1,1],["واسمُه في فم الزمنْ","إنه كوكب الهدى",65,"د",2,0],["واسمَعْ مناقِبَ للحبيبِ فإنّها","فِي الحُسْنِ مِنْ عَنْقَاءَ مُغْرِبَ أغْرَبَ",66,"ب",1,0],["واسمَعْ مَدائحَ آلِ بيتِ المصطفى","مِنى ودونَكَ جَمْعُها في المُفرَدِ",67,"د",1,0],["واسمعْ لِمَا يُوحَى مِنَ الذِّكْرِ الَّذِي","يُشْجِي القلوبَ لَوَ انَّها مِنْ جَلْمَدِ",68,"د",1,0],["وَاسمَع بِرُؤيا بُخْتَنَصَّرَ وَالتَمِس","مِنْ دانِيالَ لها إذَنْ تَأْوِيلا",69,"ل",2,0],["وأسمحهم كفا إذا جاد جائد","واربطهم جأشا إذا صال صائل",70,"ل",1,0],["وأسْماءُ لم يَبْعُدْ لِهَجرٍ مَزارُهَا","ولم تتقَطّعْ باقِياتُ الرّسائل",71,"ل",1,0],["وأسمرُ عَرّاصُ الكعوب مثقَّفٌ","وأبيضُ مشقوقُ العقيقة مخشوب",72,"ب",1,0],["وَاِسمٍ عَلَيهِ جُنَنٌ لِلهَوى","وَضَمُّهُ لِلوَردِ دُوّارُ",73,"ر",1,0],["وَأُسمِعُ مِنكِ النَفسَ ما لَيسَ تَسمَعُ","مِنَ القَولِ لي أَبشِر فَتَرضى وَتَقنَعُ",74,"ع",1,1],["وَأَسمَرَ مارِنٍ يَلتاحُ فيهِ","سِنانٌ مِثلُ نِبراسِ النِهامِ",75,"م",1,0],["وَأَسمَرَ قَد نَصَبتُ لِذي سَناءٍ","يَرى مِنّي مُحافَظَةَ اليَقينِ",76,"ن",1,0],["وأسمَعتْ من خفق أنفاسها","صوتَ البشيرات وشدوَ القيانْ",77,"ن",1,0],["وأسمع صيحةَ مُسْتَقتلٍ","يُصارعُهُ اليأسُ بين الضُّلوعْ",78,"ع",1,0],["وَأَسمَرَ كُلَّما رَفَعَتهُ كَفّي","يَلوحُ سِنانُهُ مِثلَ الهِلالِ",79,"ل",1,0],["وَاسْمَعْ صَهِيلَ خُيُولِهِمْ","مُتَحَفِّزَاتٍ لِلقحَمْ",80,"م",1,0],["وَاسْمَعْ صَدَى الأَطْوَادِ تُو","شِكُ أَنْ تُصَدعَ أَوْ تُصِمّْ",80,"م",1,0],["وَاسْمَعْ أَنِينَ الأَرْضِ وَا","جِفَةً أَسىً مِمَّا تَجِمْ",80,"م",1,0],["وَأَسْمَعُ فِي الأفَاقِ مِنْ كُلِّ جَانِبٍ","أَنَاشِيدَ بُشْرَى فِي النُّفوسِ لَهَا صَدَى",81,"د",2,0],["وَأَسمَرَ أَمّا قَدُّهُ فَهوَ أَهيَفٌ","رَشيقٌ وَأَمّا وَجهُهُ فَهوَ أَصبَحُ",82,"ح",1,0],["وَأَسمَرَ خَطِّيّاً كَأَنَّ كُعوبَهُ","نَوى القَسبِ قَد أَرمى ذِراعاً عَلى العَشرِ",83,"ر",1,0],["واسمع تحدّثك الحياة فإنّها","أستاذة التأديب والتّفقيه",84,"ي",2,0],["وَاسْمُ نَحْوَ السَّماءِ كَالْمَثَل الأَعْلَى","تَجَلَّى مُحَلِّقاً في السماءِ",85,"ا",2,0],["واسمَعي إنّ في السماء لحُونا","أسمعتِ الترتيل والترديدا",86,"د",2,0],["وأَسمع -إِن دَعَتْنِي الغِيدُ عَمًّا-","هزيمَ الرَّعْدِ في الصوت الرخيم",87,"م",1,0],["وأسمعت خفق أنفاسها","صوت البشيرات وشدو القيان",88,"ن",1,0],["وَأَسْمَرُ مِنْ رِمَاحِ الخَطِّ لَدْنٍ","شددت غرابه أن لا يحابا",89,"ب",2,0],["واسمعْ تُشَرِّفْ باستماعِكَ قِيلَتيِ","أسفاً وأنكَ مَيِّتٌ لا تَسَمع",90,"ع",1,0],["وأسمالٌ لهمْ منها فِراشٌ","يُلَمُّ بها الثَّرى ولَهُمْ شُفوف",91,"ف",1,0],["واسمَعْ غِناء الحاصدينَ حُقولَها","للحاصداتِ من القلوبِ حُقولا",92,"ل",2,0],["واسمع أبا جعفر إن كنت متسمعاً","فلم تزل ماجد الإصغاء والأذن",93,"ن",1,0],["واسمع الورق فوق أفنانها الملد","تغني كأنهن قيان",94,"ن",1,0],["وأسمع نجواها على غير رؤية","كأنّي على طور الجلال (كليم)",95,"م",1,0],["واسمح لنصرك أن يرفرف فوقها","ويطاول الجوزاء في أعلامها",96,"م",3,0],["وَاِسمَع لَها مِن قَواف لا يُماثلها","قَولٌ مِن الشعر إِلا قَول حَسانا",97,"ن",2,0],["وَاسمَع مَقالة ناصح","إِن كُنت مِمَن يَنتَصح",98,"ح",1,0],["واسمع ثرانا فيك اش","بعنا الدجى حنا وانا",99,"ن",2,0],["واسمعنا حديث طلول نجد","ويوم طويلع والنهرجان",100,"ن",1,0],["وأسمر حمرته ممزوجة","بصفرة جامعة للعجب",101,"ب",1,1],["وأسمر عسلي اللون صادفني","يوماً فذكرني عهداً ببغداد",102,"د",1,1],["وَأَسْمَعُوا مَن تصلِّى خَلفهم معهم","بضمةٍ لهكذَا استنباطُ مَا فَعَلُوا",103,"ل",3,0],["وَأَسمَرَ مَربوعٍ مِتَلٍّ كُعوبُهُ","تُصَرِّفُ فيهِ لَهذَماً وادِقَ الحَدِّ",104,"د",1,0],["واسمح ونجِّز وعودك","بالردّ لي ردّ تاني",105,"ي",1,0],["وأسمرَ يرعُد الأنبوبُ منه","غداةَ الروع خوفا أن يَزلاَّ",106,"ل",2,0],["وَاِسمَع لَها جَمَّةَ المَحاسِنِ مِن","أَحسَنِ ما يُصطَفى وَيُنتَخَبُ",107,"ب",1,0],["وَاِسمَع لِمُحكَمَةِ النِظامِ حُلِيُّها","دُرَرُ الثَنا وَجِلائُها الإِنشادُ",108,"د",1,0],["وَأَسمَعتَني مِن حُسنِ رَأيِكَ فيهِ ما","أَزالَ التَشَكّي بَل أَماطَ التَلَوُّما",109,"م",2,0],["وَاِسمَع لِحاكِمَةٍ في القَلبِ مُحكَمَةٍ","لَم يَستَمِع مِن زُهَيرٍ مِثلَها هَرِمُ",110,"م",1,0],["واسمع بإذنيك وأنظر كم يد بسطت","تدعو وتنثنى وكم من منطق ذلق",111,"ق",1,0],["وأسملت خوف السيف كرها فما الذي","أمنت به حتى رجعت إلى الكفر",112,"ر",1,0],["واسْمٌ طوتْ ذكراهُ كلَّ مسافةٍ","في الأرضِ نائيةِ المزارِ شَطونِ",113,"ن",1,0],["وَاِسمَع وَلا تُلغِ ما أَنشَأتُ مِن حِكَمٍ","فَذُو الحِجا لَم يَزَل يَستَنبِطُ الحِكَما",114,"م",2,0],["وَأَسمَعوني صَدى البارودِ مُنطَلِقاً","يَدوي بِهِ كُل قاعٍ حينَ يَصطَخِبُ",115,"ب",1,0],["وأسمو لرَوضىِّ النسيمِ لعلّني","أُصادف منه نَفْحةً من تُرابه",116,"ب",2,0],["واسمع وصية ناصح لا تركبنّ من","الأمور الملحقات بك الملامه",117,"ه",1,0],["واسمعْ عويلَ بكائها فلقد بكتْ","لبكائها الأصواء والأعلام",118,"م",1,0],["واسمع نداي فاني لم ازل ابدا","اليك في سائر الحالات ابتهل",119,"ل",1,0],["واسم كذا است وابنم واثنان","كذا امرؤ فاحفظه واثنتان",120,"ن",1,0],["وَأَسمَعُ مِنكَ ما أَسمَعتَ قَلبي","وَقَد غَدَرَ الحَبيبُ المُستَميتُ",121,"ت",1,0],["وَأَسمَعُ صَوتاً كَهَمسٍ عَميق","فَأَصغي لِتَسمعَ أَعماقيه",122,"ي",2,0],["وَأَسمَع فُؤاديَ لَحناً شجيّاً","فَيَحيا بِهِ حبُّهُ الأَوَّلُ",123,"ل",1,0],["وَأُسمِعُكَ الشِعرَ عَذباً طَرِيّا","كَسِحرٍ بِمرشفِكَ الباسِمِ",124,"م",1,0],["واسمَعْ فعندي من كلّ صالحةٍ","ألطَفُ أسرارِها وأخفاها",125,"ا",3,0],["وأسمر عسّال وأبيض قاضب","صقيل وقوس بالسهام مروض",126,"ض",1,0],["وَاِسمَع حَديثَ أَبي هُرَيرَةَ إِذ غَدا","وَفُؤادُهُ بِالجوعِ ذو أَشجانِ",127,"ن",1,0],["وَأَسمَرَ يَحكي الأَسمَرَ اللَدنَ قَدُّهُ","وَخَدٌّ شَقا قَلبَ المُحِبُّ شَقيقُهُ",128,"ق",2,0],["وَاِسمَع نَصيحَةَ خِلٍّ","قَد هَذَّبَتهُ الدُهورُ",129,"ر",1,0],["وَأَسْمَعَكَ الْهَوَاتِفَ باِلتَّهَانِي","وَلَقَّاكَ الْبَشَائِرَ بِالدَّوَامِ",130,"م",1,0],["وَاسْمَعْ أَحَادِيثَ كَرَامَتِهِمْ","مَرْوِيَّةً عَمَّنْ لَهُ دِرْيَهْ",131,"ي",2,0],["وَأَسمَرٍ مِن وَريد النَحرِ مورِدُهُ","وَأَجَدلَ أَكلهُ مِن لَحمِ مُنجَدِلِ",132,"ل",1,0],["واسمح للسامع ما نُشدت","قم نحو حماه وابتهجِ",133,"ج",1,0],["واسمع لما يأمره بالطاعهْ","موافقاً لسنّة الجماعهْ",134,"ه",1,0],["واسمع فوق الأغصان لما","تبدي الورقاءُ من اللهف",135,"ف",1,0],["وأسمِعيني مِنَ الألحانِ أطيَبَها","حتى أرى الحُسنَ أشكالاً وألوانا",136,"ن",2,0],["وأُسمِعُها ما يجرحُ السَّمعَ لفظُهُ","فَترضى بمغزاهُ ويَشفَعُ لي القلبُ",137,"ب",1,0],["وأسمَع تَغريداً وألمسَ خضرةً","وأنشُقَ طيبا حيثُ أرغَبُ في الزّهد",138,"د",1,0],["واسمع في سفح البشام عشية","بكاء حَمامات لهن هدير",139,"ر",1,0],["واسمع جواهر أَحرف عربية","زفت اليك فَصيحة الانشاد",140,"د",1,0],["واسمع دُعائي واكشف ما يساورني","من الخطوب وَنفس كل أَحزاني",141,"ن",2,0],["وأَسْمَعَتْ أَلْسِنَةُ القَصَائِد","وجدانُها المَنشودُ حَسبَ الناشِدِ",142,"د",1,0],["وَأَسْمُو 