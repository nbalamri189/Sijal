["وَأَسمَعُ مِن سنايوحٍ نِداءً","إِلى أَهلَ الهَوى أَوحاهُ يوحُ",166,"ح",1,0],["وَاِسمَح لِعَبدك إِن أَرَدَت بِنَظرَةٍ","إِن شئت يا مَولاي أَن أَتشَرَّفا",167,"ف",2,0],["وَأسمَح مَن أَعطى وَأَرأف مَن هدى","وَأَكرَم مَن أَوفى وَأَصدَق مَن دَعا",168,"ع",2,0],["وَاِسمَح بِاِطلاق طَرفي فَالغَرام لَهُ","أَسد اِذا عايَنوا غُزلانَه جبنوا",169,"ن",3,0],["وَاِسمَح بِوَصلِكَ لي وَلَو","بِخَيال طَيفِكَ في المَنام",170,"م",1,0],["واسْمَعْ جَميلَ ثناءٍ عن خُلوصِ هَوىً","على لسانِ جَناني فيكَ يُلْقيه",171,"ي",2,0],["واسْمَعْ فذاكَ ثناءٌ غيرُ مُنتَحَلٍ","وانْظُرْ فهذا ولاءٌ غيرُ مُنتَحَل",172,"ل",1,0],["واسمَعْ مُحبَّرةً نفَثْتُ بها وإنْ","أضحَتْ تَقلُّ لديكَ أن تُتأَمَّلا",173,"ل",2,0],["وأسمحتِ الأيّامُ بعدَ إبائها","ولانَتْ إلى الإنصافِ أعناقُها الصُّعر",174,"ر",1,0],["وأسمحَتِ الأيّامُ بعدَ إبائها","ولانتْ لما تَهواهُ أعناقُها الصُّعر",175,"ر",1,0],["وَاِسمَع إِذا شِئتَ مِنّي كُلَّ شارِدَةٍ","كَالعِقدِ تُجعَلُ مِن عُلياكَ في جيدِ",176,"د",1,0],["وأسماءُ هَمُّ النفس إن كنتَ عالماً","وبادي أحاديثِ الفؤادِ وغائبهْ",177,"ب",2,0],["وأسمرَ كالقَناةِ يُرى","وَلَيسَ مِن القَنا الذبُلِ",178,"ل",1,0],["وَاِسمَع رِثاءِ هُريرة","كانَت تَرى عِندي أَسيرَهَ",179,"ر",2,0],["وَاِسمَع مَقالاً لَم يقل مِثلُهُ","مُذ كانَت الدُنيا لِاِنسانِ",180,"ن",1,0],["وأسمع ألف أغنيةٍ نشازٍ","فيزعجني التكسر والنعيق",181,"ق",1,0],["وأسمرٌ ليِّنُ الأعطافِ مُعتَدلٌ","وسابريٌّ عظيم السِّرد موضونُ",182,"ن",1,0],["واسمعْ شكيةَ ذي وَدادٍ صادقٍ","وأسيرِ فقرٍ ما لَهُ مِن فادي",183,"د",2,0],["وإسمعيل فارس كل فن","فواصله التي شرحت نظامي",184,"م",2,0],["وأسمع سكان البسيطة كلها","فما مؤمن للسامعين بعاذر",185,"ر",1,0],["وأسمَعَتْكَ اللَّيالي في مواعظِها","أنَّ ابنَ سبعين من وِردٍ على قُرُبِ",186,"ب",1,0],["وأسْمَعَ باستهلاله كلَّ مَسْمَعٍ","يُقَرِّط آذانَ المنى ويشنّف",187,"ف",1,0],["واسمرَّ نفَّاث المنون سنانه","كما نفث السمَّ الزعاف الأَراقم",188,"م",1,0],["وأسمع من نغمات القيان","كلاماً يعشقني بالدمى",189,"ا",1,0],["واسمٌ من الفضل لم يُخْصَصْ سواكَ به","إلا كما يَستبينُ النّعْتُ واللّقَبُ",190,"ب",1,0],["وأسمرٍ يفتكُ بي طرفُهُ","إذا تثنّى وكذا الأسمرُ",191,"ر",1,1],["واسمُ الأديبِ إذا نظرتَ مصَحَّفُ","فابحثْ فمعناهُ الخفيُّ دَنيُّ",192,"ي",1,0],["وَاسْمٌ من السَّلْمِ والإِسلامِ أَنشأَهُ","بَدْءٌ من الصِّدْقِ عَوَّادٌ بأَحْمَدِهِ",193,"د",2,0],["وأَسَمْتُ فِي أَزْكَى البِقاعِ صَوَافِني","وَضَرَبْتُ فِي أَعلى اليَفَاعِ قِبابي",194,"ب",2,0],["وأُسْمِعُها دَاعيكَ فِي كُلِّ مَنْهَلٍ","هَلُمَّ إِلَى الإِكْرَامِ والمنزِلِ الرَّحبِ",195,"ب",1,0],["وأَسمَرُ يسرِي فِي بحارٍ من النَّدى","بيُمناكَ لكنْ يَغْتدي وهوَ ظَمْآنُ",196,"ن",1,0],["وأَسمرَ ظمآنِ الكعوبِ كَأَنَّما","بِهِنَّ إِلَى شُرْبِ الدماءِ غليلُ",197,"ل",1,0],["واسمع دعاي ولا تنكس وعاي فذي","يذي استمدت لنيلٍ منك مسموح",198,"ح",1,0],["واسمح ولو بزيارة تطفي الجوى","وتحرق الواشي بخيبة ظنه",199,"ن",2,0],["وأسمعُ تَرْنامَ محدودبٍ","طروبِ الأغاريد شجيِّ النديمْ",200,"م",1,1],["واسمع لها تشفي الجوى","كالعَرّ يشفيه الهِنَا",201,"ن",2,0],["واسمع لها عذراءَ بِكرا كلّما","خُطِبتْ لديك فأردفتك عَوانا",202,"ن",2,0],["واسمع فإن عَزَبَتْ فلم تسمَع لها","أختاً لها في مادحيك عرفتني",203,"ن",2,0],["واسمح لها أن كنتَ عنها فاضلا","كم ناقصٍ وله بكم تتميمُ",204,"م",1,0],["وأسمنتَ أيّامي فعدن بدائنا","وهنّ جلودٌ من ضَناً وعظامُ",205,"م",1,0],["وأسمنها رعيُ وادي الوفا","ء فيكم ووِردُ حياضِ الدِّيَمْ",206,"م",1,0],["واسمح لنفسي بحفظ نفس ابن أي","يوبَ فما ذاك في الإخاء هُمُ",207,"م",1,0],["واسمع على الاختصار طارقةً","لها طوالاً سوالفٌ قُدُمُ",207,"م",1,0],["واسمح بأحلَى نومتيك لساهرٍ","شُفِعتْ أواخر ليله بأوائلِ",208,"ل",1,0],["وأسمنها ربُّها في السماءِ","قديما ولكنه استلَّها",209,"ل",3,0],["وأسماع أبناء عبد الرحي","م تُصغي وأبوابُهم تُطرَقُ",210,"ق",1,0],["واسمع على بعد الديار وقربها","مثلَ القِراط تعلّقاً بالمسمعِ",211,"ع",1,0],["واسمع كما انتظم الفريدُ ورقَّ ما","ءُ غمامةٍ وصفا الفِرِندُ اللامعُ",212,"ع",1,0],["واسمع لها أنت خير السامعين لها","عذراءَ ما طُرَّ معناها ولا لُقِطا",213,"ط",2,0],["وأسمحتِ الأيام بعد حِرانها","ونهنهها الوعظُ المكرَّرُ والزجرُ",214,"ر",1,0],["واسمع أناديك بكلِّ غادةٍ","غريبةٍ لم تجْرِ في الخواطرِ",215,"ر",1,0],["واسمع لها تُهدِي إلى ال","عرِض الغنى وهو فُقُرْ",216,"ر",1,0],["واسمعْ أَزُرْكَ بكلّ مالئةٍ","عينَ الضجيع خريدةٍ بِكْرِ",217,"ر",1,0],["واسمعْ إذا شُدَّت لها حَبوتي","أفصحَ ما فاهَ به خاطبُ",218,"ب",1,0],["واسمع لمغلوب على حظِّه","لو أنك الناصرُ لم يُغلَبِ",219,"ب",1,0],["وأسمرُ لدنٌ قدُّها تلغي به","وكم تلفتْ نفس بلدنٍ من السّمر",220,"ر",1,0],["وأسمر يحكي الأسمر اللدن قدُّه","له لونه عند العناق ولينه",221,"ن",2,0],["واسمعْ قريضاً هام وجداً بهِ","بيضُ المقاصير وبيضُ الأداحْ",222,"ح",1,0],["وأسمرَ مامالَ الدلالُ بقدِّهِ","مِنَ التيهِ اِلاّغار أسمرُعسّالُُ",223,"ل",1,0],["واسمي لها اسم","في بحر بري",224,"ر",2,0],["وأسمعه ما قام موضع دكه","كفاحا وكانت فارقا لن تراني",225,"ن",2,0],["واسْمَحْ بِرَمشَةِ عينٍ نَجْتَلي نَظَراً","لِطَلْعَتهٍ منكَ قد جَلَّتْ مَعانيها",226,"ي",3,0],["وَأَسمَرُ خَطِيٌّ كَأَنَّ اِهتِزازَهُ","مِقاطُ قَليبٍ مَسَّهُ الماءُ مُدمَجُ",227,"ج",1,0],["وأسمعُ صوتَها أنّ ظلومٍ","وشدوَ مُظفَّرٍ عادا فحِرْتُ",228,"ت",1,0],["وإسمٍ دون عنوانٍ كنبتٍ","على الماءِ تؤمّلُهُ المصائرْ",229,"ر",1,0],["وأسمع بالتفويض حتى إذا انتهى","ضميري إلى ما بيننا لم أفوض",230,"ض",1,0],["واِسْمُ واِسْلَم واِسْتَجْلِ بِكرَ قَريضٍ","ختَمَتْ مَدحَكُم بخيرِ دُعاها",231,"ا",3,0],["واسمع أبا النجم مديح خادم","تسمو على الشعرى بكم أشعاره",232,"ر",2,0],["واسمح لها بوقفة إن عرضت","عن الغوير نفحة من حاجر",233,"ر",1,0],["واسمع محاسن لفظه لا حسنه","كالدر بل أنقى من الدر النقي",234,"ق",2,0],["واسمع محبرة الأوصاف خاطبة ال","إنصاف طالت معانيها ولم تطل",235,"ل",1,0],["واسم الفتى أشرف من","ذكر النعوت والكنى",236,"ن",2,0],["واسمع لدر ينتقى","باسمك ثم يقتنى",236,"ن",2,0],["وإسماعيل لي شغل","عن اللذات يشغلني",237,"ن",2,0],["وإسماعيل لا أسلوه","حتى الموت يصدعني",237,"ن",2,0],["واسمَح لنا يا من لِعَفوِكَ نَرتَجِي","بِجِوارِهِ في جَنَّةِ الرِّضوانِ",238,"ن",1,0],["واسمَحي أن نرَى بِوَجهِكِ بَدراً","مُشرِقاً حولَه السوالِفُ هَالَه",239,"ه",1,1],["وإسمُكِ مهمَا جرَى ذكرُهُ","تكَهرَبَ جِسمي وقلبِي اضَطرب",240,"ب",1,0],["وَاِسمَعْ مديحاً بتّ أنظمه","يمليه منك عليَّ ما يُملي",241,"ل",2,0],["وأسمَعتَنا أنّةَ المُعْوِلات","على القوم أو رنّةَ الثّاكلِ",242,"ل",1,0],["واِسمَعْ كَلاماً من مديحك شارداً","طارت بهِ عنّي الصَّبا والشَّمْأَلُ",243,"ل",1,0],["واِسمَعْ فذا النّيروزُ يُخْ","برُ أنّ جَدّك فيه يعلو",244,"ل",2,0],["واِسمعا مثلما سمعتُ من الأي","يامِ هذا التّخويفَ والتّرْويعا",245,"ع",2,0],["وَأَسمَعني وَكَسا أعظُمِي","وَعادَ لَها عارقاً ناهسا",246,"س",2,0],["وَاِسمَعوا ناظرينَ نَصر يميني","بشبا البِيض فَحْلِيَ الهدّارا",247,"ر",2,0],["وَأَسمَعني في كلِّ يومٍ وليلةٍ","نَشيجَ البواكي أو حنينَ النوادبِ",248,"ب",1,0],["وَاِسمَعْ كَلاماً لم يُحَكْ شِبْهٌ له","ملآنَ بالإحسانِ والإطرابِ",249,"ب",1,0],["وَأَسمرُ عَسّالُ الكعوبِ سنانُهُ","رَسولُ المَنايا في يَديهِ كتابُ",250,"ب",1,0],["واسمع على طور الفنا","إني أنا وأعص النواهي",251,"ا",3,0],["واسمي العبد للغني به","حاش لله أن أكون أنا",252,"ن",2,0],["واسمع مثانيك التي","تتلى على صوت المثاني",253,"ن",2,0],["واسمعوا من قول ربي","فله نحن الشئون",254,"ن",1,0],["واسمعوا من فم الوجود كلاماً","لا اعوجاج به ولا تحويل",255,"ل",1,0],["واسمع النفخ منك في صوْرِ جسم","لك فالناي طاب من نغماتك",256,"ك",1,0],["وأسماء ربي للصفات مظاهر","بها تظهر الآثار حدث عن البحر",257,"ر",1,0],["واسمها الكائنات علواً وسفلاً","كاملات لا نقص لا تغييرا",258,"ر",2,0],["واسمهم ما به الجميع تسمّى","عندهم في النزول للأعداد",259,"د",1,0],["وأسماء له حسنى","إليه ذات إرشاد",260,"د",1,0],["واسمع حديثاً صحيحاً","كالدر وافاك معقود",261,"د",1,0],["واسمها الكائنات حساً وعقلاً","في نهار يضي وليل داجي",262,"ج",2,0],["واسمعْ إِذا غنَّت المثاني","تقولُ يا هُو لبَيَّك يا هُوَ",263,"و",1,0],["واسمحوا للمَزارِ بالرُّوح إِنِّي","في نَعيم إِن أنتمُ زُرتموني",264,"ن",2,0],["وَاِسمٌ يُثنى وَمُفرَدٌ وَتَجمَعُهُ","مُذَكَّرٌ وَمُؤَنَّثٌ بِذا اِعتَبَرا",265,"ر",2,0],["وَأَسْمَحَتْ فَاجْتَذَبْتُ مِئْزَرَهَا","يَا حُسْنَهَا حَاسِراً وَمُؤْتَزِرَهْ",266,"ر",2,0],["واسم أبيه فاعلموا كاسم أبي","فلم تزل أمته في تعب",267,"ب",1,0],["وأَسماؤُهم بَيْن البَرايا سِماَتُهم","وأَسماؤُه بين البريَّة أَفْعَال",268,"ل",1,0],["وَاسمَح بِخَيالٍ في الدُجى يطرُقُ مَن","أَضحَى دنفاً أذابَهُ الشّوْقُ إِليكَ",269,"ك",1,0],["وأسمائك الحسنى وأوصافك العلى","فأنت الذي ترجى لكشف العظائم",270,"م",1,0]]}