{"poems":[[51,"ما كل ما تشتهي يكون","https://www.aldiwan.net/poem63158.html","مجزوء البسيط"],[107,"يا دولة من بقايا الظلم طاف بها","https://www.aldiwan.net/poem43379.html","البسيط"],[108,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[214,"طاب الزمان وجاء الدهر يعتذر","https://www.aldiwan.net/poem13432.html","البسيط"],[310,"در أيادي التهاني فتحت صدفه","https://www.aldiwan.net/poem56474.html","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96708","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28588","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48326","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86511","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90814","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90896","الرمل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4767,"شمس الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179940",""],[4859,"غفلة","https://www.poetsgate.com/ViewPoem.aspx?id=187406",""],[5232,"بوحٌ ونظرة","https://www.poetsgate.com/ViewPoem.aspx?id=212687",""],[5561,"الثائرون","https://www.poetsgate.com/ViewPoem.aspx?id=207881",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5751,"حزنٌ بلون الفَرَح","https://www.poetsgate.com/ViewPoem.aspx?id=214719",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"الكون محوره الإله","https://www.poetsgate.com/ViewPoem.aspx?id=192517",""],[5956,"فضل الله المتواصل","https://www.poetsgate.com/ViewPoem.aspx?id=193369",""],[5956,"متوسّم فيه السموَّ إلى الذرى","https://www.poetsgate.com/ViewPoem.aspx?id=193978",""],[5956,"إني لَمُختصّ بكم يا أشهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194262",""]],"verses":[["ما أَيسَرَ المُكثَ في مَحَلٍّ","مالَ إِلَيهِ بِنا الرُكونُ",0,"ن",1,0],["ما أَيَّدَ المُلكَ وَاِستَبقى نَضارَتَهُ","كَالرِفقِ وَالعَدلِ ماداما وَما اِصطَحَبا",1,"ب",2,0],["ما أيَّد الحقَّ المُضاعَ كمنطقٍ","تُدلي به شَفَةُ السلاح الأبكم",2,"م",1,0],["ما اينع الروض واخضرت جوانحه","وما سقى بالند روض الحمى المطر",3,"ر",1,0],["ما أيمنَ الزمنَ الموفي بِطالعهِ","وَما أبرّ يداً عنهُ نضَت سَجفه",4,"ف",2,0],["ما آيست مُدنفاً يوماً بهجرتها","إلّا وقد أطمعت منه بإدلالِ",5,"ل",1,0],["ما آئِبٌ سَرَّكَ إِلّا سَرَّنِي","شُكْراً وَإِنْ عَرَّكَ أَمْرٌ عَرَّنِي",6,"ن",2,0],["ما أيقنت ببقاءِ مهجتها لها","حتَّى دعاكَ اللهُ قم فتلافَها",7,"ف",3,0],["ما أَيقَنوا لِغَريبٍ مِن بَدائعِها","إِلّا وَقَد جَهِلوا فَوقَ الَّذي عَلِموا",8,"م",3,0],["ما أيْنَعَتْ للمَكْرُماتِ حدائِقٌ","لوْلا سَحابٌ من نَوالِكَ جادَها",9,"د",3,0],["ما أيمن الحرب التي من نارها","أحرقت مسكاً من ثناك فتيقا",10,"ق",2,0],["ما أياس الزمان الاك ان الش","كل أمر من الأمور ضروري",11,"ر",2,0],["ما إياس غيره في وقته","لو تراه في مجال من جدال",12,"ل",1,0],["ما أيسرَ المرءُ والأشياعُ مُعسِرةٌ","ولا اعتَلا قَدرُه والأهلُ في ثَهَل",13,"ل",1,0],["ما أيقظت صرخةُ الأطفال نائمَكم","حتى تعيدون ما قد صار مستلبا",14,"ب",2,0],["ما أيقظ الشيطانَ إلا غفلةٌ","وقعت بحفرتها النّفوس الحرّه",15,"ه",1,1],["ما أينعَ الزهرُ إلا وانتشى الوترُ","يا غُرَّةَ الُّصّبحِ عادَ الَّصيفُ والَّسّهرُ",16,"ر",1,1],["ما أيقظَ الفكرَ الصحيحَ ثمالةٌ","أو صاحبَ العيشَ الكريمَ فساد",17,"د",1,0],["ما آيَسَتْ مُدْنَفاً يَوْماً بِهِجْرَتِها","إِلاَّ وَقَدْ أَطْمَعَتْ مِنْها بِإِدْلالِ",18,"ل",1,0],["ما أَيْنَعَ اللِبْلابِ يَطْفُرُ ماؤُهُ","إلاّ ويَخبو وهْوَ يُزْهِقُ ماءَهُ",19,"ا",3,0],["ما أيّ غانية تفوق جَمالَها","ووقوفَها في الشاعريّةِ ذاتِها",20,"ت",3,0],["ما أي إبداعٍ سوى من بذرةِ ال","مولى الذي المغزى بأعماقِ ذاتهِ",21,"ه",1,0],["ما أيُّ مَنٍّ أو أذىً بودادهم","بل نخوة من دون أي تكبُّرِ",22,"ر",1,0],["ما أي مأفون يحارب مجْدَهُ","إلا يكون مُصادِقَ الإبليسِ",23,"س",1,0],["ما أيُّ حَيْل عندكم في خدمتي","ورفاهتي إلا له تستخدمُ",24,"م",1,0]]}