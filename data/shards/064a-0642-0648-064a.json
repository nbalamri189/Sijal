{"poems":[[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[74,"نقل الضنا عن مهجتي","https://www.aldiwan.net/poem20531.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[124,"الله في كلف الأحشاء مفتون","https://www.aldiwan.net/poem49320.html","البسيط"],[256,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[327,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[371,"مريضي بي إن عدته لي عائد","https://www.aldiwan.net/poem17024.html","الطويل"],[406,"يا ضيف وجداني","https://www.aldiwan.net/poem6759.html","عموديه"],[409,"ما المنحنى قصده ورامه","https://www.aldiwan.net/poem33422.html","مخلع البسيط"],[580,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130719","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100353","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65137","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97950","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93258","المتقارب"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123468","الكامل"],[4119,"أما آن أن يزهق الباطل","https://www.poetsgate.com/ViewPoem.aspx?id=16203",""],[5325,"خطب أناخ على الإسلام كلكله","https://www.poetsgate.com/ViewPoem.aspx?id=171970",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""]],"verses":[["يَقْوى الضّعيفُ بِها ويأمَنُ خائِفٌ","قَلِقَتْ وِسادَتُهُ ويُثْري المُقْتِرُ",0,"ر",1,0],["يقوى لنبل الراشقي","ن وليس يقوى للنوى",1,"و",2,0],["يَقْوَى بِهِ قَلْبُ الْجَبَانِ وَيَرْعَوِي","طَمَعُ الْحَريصِ وَيَخْضَعُ الْمُتَكَبِّرُ",2,"ر",1,0],["يقوى ويضعف كالآذي آونة","يطغى وآونة يهدأ في حين",3,"ن",1,0],["يقوى على حجج الخصام فصاحة","بمحمّر الشفتين للعشّاق؟!",4,"ق",1,0],["يُقوي بِها الرُكبُ حَتّى ما يَكونُ لَهُم","إِلّا الزِنادُ وَإِلا القِدحُ مُقتَبَسُ",5,"س",1,0],["يُقَوّيهِ ضَعفٌ لِلحَبيبِ مُضاعَفٌ","وَيُعلِنُهُ صَوتُ الأَنينِ خَفيضُ",6,"ض",1,0],["يقْوى الضعيفُ بما يشاهده","من صائميكَ، فيُسْعِفُ الصَّبْرُ",7,"ر",1,0],["يُقوَى ويَقْرِي بكل معنى","رد بحر علم مع الكرامه",8,"م",2,0],["يقوَى على حَمْل هِضَابِ العُلاَ","فَيا لَهُ من سَيَّدٍ أَيِّدِ",9,"د",1,0],["يقوى سنا البدر حتى أن بدت لمَع","من نور سرّ أبي بكر تراه كسف",10,"ف",1,0],["يقوى عليَّ بقادرٍ من لحظه","يا من يحلُّ من القدير وثاقي",11,"ق",2,0],["يقوى الذبال بقطه والمسك قد","يذكو بما تلْفيه عنْه مختما",12,"م",2,0],["يقوى ويعلم وهو يبدي لومه","فيطاول الأيام وهي قصار",13,"ر",1,0],["يقوى على الإبلاء فوق السغب","مهما علت همته والتهب",14,"ب",1,0],["يُقوّي مقاعِلَه جاهِداً","وهل عاقِلٌ بَعْدَها عاقِل",15,"ل",1,0],["يقوى بها وقد وهى","عن برده جثمانه",16,"ن",2,0],["يَقوى الرجاءُ بها لنيلِ تَصبُّرٍ","ومَطالبٍ جَلَّت ورفعِ مَقام",17,"م",1,0],["يقوي معاقله جاهدا","وهل عاقل بعدها عاقل",18,"ل",1,0],["يقوى المسامع علما والوفود ندا","والفعل حزما وحلقوم العدو شجا",19,"ج",2,0],["يُقَوِّي الإقتصادَ حِجىً منيرٌ","ويُضْعفه حِجىً مِنْ دون نورِ",20,"ر",1,0],["يَقْوى الكتاب متى تقوى حضارته","في حفظ روحٍ ولودٍ ترفض القبضا",21,"ض",2,0]]}