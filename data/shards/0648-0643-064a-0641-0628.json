oem.aspx?id=96554",""],[4119,"أما آن أن يزهق الباطل","https://www.poetsgate.com/ViewPoem.aspx?id=16203",""],[4119,"أيا عاذلي في الحب مالي وللعذل","https://www.poetsgate.com/ViewPoem.aspx?id=16210",""],[4119,"أقول لخيلي عند أبلى وماؤه","https://www.poetsgate.com/ViewPoem.aspx?id=16147",""],[5038,"زهرة البلدان","https://www.poetsgate.com/ViewPoem.aspx?id=196716",""],[585,"أهلاً بيوم هو الأحقاب والسير","https://www.poetsgate.com/ViewPoem.aspx?id=161900",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5121,"يَعيشُ الحَرْفُ","https://www.poetsgate.com/ViewPoem.aspx?id=214863",""],[5147,"سبرت مقاييس العراق فلاح لي","https://www.poetsgate.com/ViewPoem.aspx?id=166736",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5536,"الشفة السفلى !!","https://www.poetsgate.com/ViewPoem.aspx?id=19796",""],[5736,"بعضي إليك","https://www.poetsgate.com/ViewPoem.aspx?id=208223",""],[5742,"مولد النور","https://www.poetsgate.com/ViewPoem.aspx?id=206973",""],[2546,"لطغيان خفّ مذ ثلاثون حجّة","https://www.poetsgate.com/ViewPoem.aspx?id=201430",""],[5861,"سراب الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=188086",""],[6102,"عَجِيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=184446",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[6211,"أَعنِيهِ، لَيْسَ عَنْهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78533&r=&rc=15",""],[422,"بوادي الغضا للمالكية أرْبُعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22255&r=&rc=11",""]],"verses":[["وَكَيْفَ بِإِلْمَامِ الْمَذَلَّةِ لاِمْرِىٍء","وَمِنْ يَمَنٍ رَهْطٌ لَهُ وَقَبِيلُ",0,"ل",1,0],["وَكَيفَ بِنِسيانٍ وَقَد مَلَأَت يَدي","جِسامُ أَيادٍ مِنكَ أَيسَرُها الوَفرُ",1,"ر",1,0],["وَكَيفَ بِنَفسٍ كُلَّما قيلَ أَشرَفَت","عَلى البُرءِ مِنَ حَوصاءَ هيضَ اِندِمالُها",2,"ه",2,0],["وكيف بين الحق من نفثاتهم","وكلّ له في الحق نفثة مارد",3,"د",1,0],["وَكَيفَ بِهِندٍ وَالنَوى أَجنَبِيَّةٌ","طَموحٌ تَنائيها عَسيرٌ طِلابُها",4,"ب",3,0],["وكيف بقاءُ الناس فيها وإنما","يُنالُ بأسباب الفناء بقاؤها",5,"ه",2,0],["وكيف بأن يخفَى قِراكم وإنما","بلادُ بني الدنيا لكم حَجَراتُ",6,"ت",1,0],["وكيف بالنوم للمُباشر أط","راف حُمات الحيّات والإبرِ",7,"ر",1,0],["وكيف بالصبر وامتزاجُكما","مثل امتزاج الزُّلال والخمر",8,"ر",1,0],["وكيف بمُشتاقٍ تضمَن جسمَه","على شوقِه مِصرٌ ومُهجَتَه مِصْر",9,"ر",1,0],["وكيف بأن يَخفى المشيبُ لخاضب","وكل ثلاث صبْحُه يتنفّسُ",10,"س",1,0],["وكيف بأن تخفَى محاسن مِثله","وهُنَّ لأبصار القلوبِ مَقابس",11,"س",1,0],["وكيف بالصبرِ عنكِ يا حسنا","يأمر بالسيئات من لحَظَه",12,"ظ",2,0],["وكيف بأن يقْنى الفؤادُ عظاته","وقد ذابَ حتى لو تَرَقْرَقَ لانسجمْ",13,"م",1,0],["وكيف بِهَدْمي ما بنتْهُ سعادةٌ","وليس لما تبني السعادةُ هادمُ",14,"م",1,0],["وَكَيفَ باتَ لِسانٌ لَم يَدَع غَرَضاً","وَلَم تَفُتهُ مِنَ الباغينَ عَوراءُ",15,"ا",2,0],["وَكَيفَ بِصاحِبٍ إِن أَدنُ شِبراً","يَزِدني في مُباعَدَةٍ ذِراعا",16,"ع",2,0],["وَكَيفَ بِلَيلَةٍ لا نَومَ فيها","وَلا ضَوءٍ لِصاحِبِها مُنيرِ",17,"ر",1,0],["وَكَيفَ بِصَفحي عَن لَئيمٍ تَلاحَقَت","إِلَيهِ بِأَخلاقِ الدَناءَةِ ناقِصِ",18,"ص",1,0],["وَكَيفَ بِكُم إِن تَظلِموني وَتَشتَكوا","إِذا أَنا عاقَبتُ اِمرَأً وَهوَ أَقطَعُ",19,"ع",1,0],["وَكَيفَ بِنَفسٍ كُلَّما قُلتُ أَشرَفَت","عَلى البُرءِ مِن حَوصاءِ هَيضَ اِندِمالُها",20,"ل",3,1],["وَكَيفَ بِرامٍ لا تَطيشُ سِهامُهُ","وَلا نَحنُ نَرميهِ فَنُدرِكَ بِالنَبلِ",21,"ل",1,0],["وَكَيفَ بِمَن خَمسونَ قَيداً وَحَلقَةً","عَلَيهِ مَعَ اللَيلِ الَّذي هُوَ أَدهَمُ",22,"م",1,0],["وَكَيفَ بِعَيني وَالَّتي طُرِفَت بِها","لَها حينَ أَلقاها يَموتُ سُجومُها",23,"م",3,0],["وكيفَ بالجِدِّ منها وهي لاعبةٌ","تُهدي إلى الصبِّ جِدَّ الشوقِ في اللَّعبِ",24,"ب",1,0],["وَكَيفَ بِمَطلوبي إِذا شَطَّتِ النَوى","وَقَد صَمَّ مِن قُربٍ فَلَيسَ يُجيبُ",25,"ب",1,0],["وَكَيفَ بِشَكوى ساعَةٍ أَشتَفي بِها","وَدونَ التَلاقي كُلُّ بَيداءَ سَملَقِ",26,"ق",1,0],["وكيف بمن يُصابُ ولا يُصيبُ","سَليبُ النّفسِ يتبعه سليبُ",27,"ب",1,0],["وكيف بدا يشقّ الكا","ف في قرطاسهِ قلمي",28,"م",2,0],["وَكَيفَ بِسَلمى أَحرَمَ النَأيُ وَجهَها","عَلَيَّ وَإِن طافَت بِنا لَم تُعَرَّجِ",29,"ج",1,0],["وكيف بي فؤادٌ مستطيرٌ","لمن لا يستطيرُ له فؤادُ",30,"د",1,0],["وَكَيفَ بِالصَبرِ لِذي غُربَةٍ","هَيَّجَ مِنهُ الشَوقُ بَلبالا",31,"ل",2,0],["وكيف بقائي بعد صحبي وبعدما","تجلَّل رأسي الشيبَ؟ وكيف بقائيا؟",32,"ي",2,0],["وكيف بقائي وانكفائي على العَصَا","يذكِّرنِي بالموت إن كنت ناسيا؟",32,"ي",2,0],["وكيف بالشيب اذا تقاربت","خطاه أن يقصر في الجد الخطى",33,"ا",1,0],["وكيفَ بي ونصيبُ المرء مُرْتَهَنٌ","به ، ومَغْنَمُهُ في العُمْرِ محدود",34,"د",1,0],["وكيفَ بِصاحبٍ إِنْ أَذنُ شِبْراً","يزدْني في مُباعَدَةٍ ذِراعَا",35,"ع",2,0],["وكيف بنفس أنتِ هيّجتِ سقمها","ويمنع منها يا بثين شفاؤها",36,"ا",3,0],["وكيف بالغت بتدويره؟","وكيف وزعت نقاط الدم؟",37,"م",1,0],["وكيف بالتوليب سورته","بالورد، بالعناب، بالعندم؟",37,"م",1,0],["وكيف باهل الردة اشتعل الردا","باشطبه القاضي على كل مارد",38,"د",1,0],["وكيف باللّه ربي سوف يمنحني","وهذه قصتي عفواً وغفرانا",39,"ن",2,0],["وَكَيفَ بُكائي في الطُلولِ وَقَد أَتَت","لَها حِقَبٌ مُذ فارَقَت أُمّ عاصِمِ",40,"م",1,0],["وَكَيفَ بِظُلمِ جارِيَةٍ","وَمِنها اللينُ وَالرحمُ",41,"م",1,0],["وَكَيفَ بُكائي مُؤمِناً وَلَقَد أَرى","بِأَنّي لَهُ يا نَفسُ لا بُدَّ تابِعُ",42,"ع",1,0],["وكيف بنسياني الذي حفِظ الصِّبا","وبات به طيفُ الخيال مسامرى",43,"ر",2,0],["وَكيفَ بِلا عقلٍ يكون تديّنٌ","إِذاً كلّفوا المجنون والطفل والعيرا",44,"ر",2,0],["وكيف بقاءُ الغصْنِ بين عواصفٍ","منَ الدَّهْرِ لا يُرْجى لهنَّ ركود",45,"د",1,0],["وكيف بهذا الموتِ إنْ كانَ صَبْرُكُمْ","وفيه لباناتٌ لكم ومآرب",46,"ب",1,0],["وكيف بقلب واحد أحمل الهوى","عجيباً على طبعي وغير عجيب",47,"ب",1,0],["وَكَيفَ بُلوغُ الماءِ وَالكَف رازِم","إِلَى فَم ظامٍ لا يَعبُّ مِنَ العَدِّ",48,"د",1,0],["وَكيف بالرشدِ في قوم كبيرهمُ","من فوق عرنينه بالغدر قد وَسما",49,"م",2,0],["وَكيف بخلتِ حين بذل","تُ فيكِ النفسَ والقلبا",50,"ب",2,0],["وكيف بمن يأتي ذنوباً كثيرةً","ويقضي وما وافى بتوبة مخبت",51,"ت",1,0],["وكيف بصبري عنك يا مَن لقاؤه","طليعةُ إسعادي على حَرْبِ أيامي",52,"م",2,0],["وَكَيفَ بِأَن يُلقى سلاحيَ مَتنَهُ","لِأَسيافِ إِفرِنج وَأَقلامِ أَقباطِ",53,"ط",1,1],["وَكَيفَ بَعدَ اِستِلامي رُكنَ كَعبَتِهِ","أَخافُ مِن ظَمَئي مِن ماءِ زَمزَمِهِ",54,"م",2,1],["وكيفَ بكُم والدّهرُ غيرُ مُساعدٍ","ودونَكُمُ الأعداءُ واللّجَجُ الخُضَرُ",55,"ر",1,0],["وكيف بورد الماء والماء آجن","يُبَلُّ به هذا الغليل وينقع",56,"ع",1,0],["وكيف بشكوايَ الزوان وقد غدا","بكم جامعا شملى وأنتم أفاضله",57,"ل",2,0],["وكيفَ بأَشجانِ قلبٍ عزيزٍ","فيُسْعِدُهُ لَهْوُ قلبٍ طَروبِ",58,"ب",1,0],["وكيفَ بكُفْرِي من هَدى وابْنُ مَنْ هَدى","أَبُوكَ ويُمْناكَ الَّتِي أَثمَرَتْ غَرْسِي",59,"س",2,0],["وكيف بين حق دو","ن أشهاد ذوي قيم",60,"م",1,0],["وكيف بِمن أنفاسُه علويَّةٌ","تَشرَّبها من حولنا كل ما نَضر",61,"ر",1,0],["وكيف بوصلِ الحبلِ من أمِّ مالكٍ","وبين بلادينا زَرودُ وحَبْلاها",62,"ا",3,0],["وكيف بمهجةٍ أمست بنجدٍ","مضللة وتنشد في تهامهْ",63,"م",2,0],["وكيف بالنوم على الهجر لي","والنومُ من شرط ليالي الوصالْ",64,"ل",1,0],["وكيف باناتٌ بسقط اللِّوى","ما لم يجُدْها الدمعُ لم تورقِ",65,"ق",1,0],["وكيف بطمس النيرين لطالب","ونيلِ منيرات النجوم الطوالع",66,"ع",1,0],["وكيف بها وقد عطرت وشيبت","بمسك الجنح أنفاسُ الرياح",67,"ح",1,0],["وَكيفَ بُلوغٌ للّذي سوّلتْ به","لك النّفس مغروراً ولستَ عديلا",68,"ل",2,0],["وكيف بقائي لا أموت وإنّما","ربوعُ الأنامِ الهالكين ربوعي",69,"ع",2,0],["وَكيفَ بِنجدٍ بعد أنّ مطيَّنا","تسادكُ بالغَوْرين منه الأكارعُ",70,"ع",1,0],["وَكَيفَ بِعتمْ دينَكمْ بالّذي اِس","تنزره الحازمُ واِستحقرا",71,"ر",2,0],["وَكَيفَ بِدَفعِ اليَأسِ وَالوَجدِ بَعدَها","وَسَهماهُما في القَلبِ يَعتَلِجانِ",72,"ن",1,0],["وَكَيفَ بِالسَيرِ في جَرداءَ بَلقَعَةٍ","أَقرى مَراتِعَها القَيصومُ وَالشيحُ",73,"ح",1,0],["وكيف بقائي والأَخلاء قد ثووا","وكيفَ مُقَامِي والأَحبّةُ قد سَارُوا",74,"ر",3,0],["وكيف بعدك يزهو عيشهم ولقد","أبدلت نورهم الباهي بظلماء",75,"ا",2,0],["وَكَيفَ بَدَت وَهيَ تِربُ الهِلالِ","في غُرَّةِ الشَّمسِ بَدراً تَماما",76,"م",2,0],["وَكَيفَ بِما يَرجو يَفوز وَما له","مِن الجدّ ما يَملا بُطونَ الحَقائب",77,"ب",1,0],["وكيف بذاك الجاه لا أرتجي الشفا","وأنت شفيعُ الخلق في موقف الحشرِ",78,"ر",1,0],["وكيف بمن يرجو أيادي محمدٍ","غداه غدا ماءٍ أن يردّ محمّدا",79,"د",2,0],["وَكَيفَ بِإِنكاري وَذِكري شاهِدٌ","وَشُكري لِما أَوليت لا شَكّ إقرارُ",80,"ر",1,0],["وَكَيفَ بُكائي وَالهَوى فَرح الفَتى","وَطرف أَخي الأَفراحِ بِالدّمعِ ناشِفُ",81,"ف",1,0],["وكيف بنَيْتَ في الصحْرا قصورا","وفردوساً أقمتَ على البوادي",82,"د",2,0],["وَكَيف بِالذئب إِذا رَآنا","نَأكلها وَلا يَجي وَرانا",83,"ن",2,0],["وكيف بحالي والديار قصية","وقد كنت أبكي والمزار قريبُ",84,"ب",1,0],["وَكَيفَ بِكِتمَانِ الغَرامِ وَقَد بَدا","بِجِسمي نَحُولٌ في الهَوى وشُحُوبُ",85,"ب",1,0],["وَكَيْفَ بِأنْ أظما وَبحر ندَاكمُ","مَصَادِرُهُ مَشْرُوعَةٌ وَمَوَارِدُهُ",86,"د",2,0],["وكَيْفَ بأنْ تُحْصِي مَحَاسنَ مَنْ غَدَا","لأوْصَافِهِ الحُسْنَى مَقَالُ الوَرَى يُعزْى",87,"ز",2,0],["وكيف بأن أسلو هواكم وقد غدا","به القلب في إبان سقي المراضع",88,"ع",1,0],["وكيف بقاء عمرك وهو كنز","وقد أنفقت منه بلا حساب",89,"ب",1,0],["وَكَيفَ بِكتماني عَن الناس حُبكُم","وَعِندي لَكُم مِن لَوعة الحُب ما عِندي",90,"د",2,0],["وكَيْفَ بِتَهْذِيبِ النِّسَاءِ وقَدْ سَرَى","مقالُهُمُ أيُّ الرِّجالِ المُهَذَّبُ",91,"ب",1,0],["وكيف بدا وجه هذا النهار","إذ ودع الورد في الباكيات",92,"ت",1,0],["وكيف بمن أتت مئتان عاما","عليه أن يكون له نكير",93,"ر",1,0],["وكيف بلوغي للهوى بعد ما غَدَت","ركابُ الصِّبا منّي لواغبَ طُلَّحا",94,"ح",2,0],["وَكَيفَ بِالرِّزق لي أَم كَيف يَجلِبُه","سَعي إِذا اللَّهُ لَم يَجعَل له سَبَبا",95,"ب",2,0],["وكيف بذكرى أم هارون بعدما","خبطن بايديهن رمل الشقائق",96,"ق",1,0],["وكيف بدا لي منك تصديق ما افترى","عليَّ بهِ الواشي فهل انت مازحُ",97,"ح",1,0],["وكيف بزاة الترك يغلبها القطا","أو الأسد الرئبال يقهره الوعل",98,"ل",1,0],["وَكَيفَ بِمَن لا أَستَطيعُ فِراقَهُ","وَمَن هُوَ إِن لا تَجمَعِ الدارُ لاهِفُ",99,"ف",1,1],["وَكَيفَ بَلى خُفٍّ هُوَ الدَهرُ كُلُّهُ","عَلى قِدمَهيا في الهَواءِ مُعَلَّقُ",100,"ق",1,0],["وكيف بصبر الصبِّ عن فقد إلفه","ولم يرج منه أوبةً مدة العمر",101,"ر",1,0],["وكيف بالصبر لمن غودر من","تراكم الهم عليه حرضا",102,"ض",2,0],["وكيف بعد بالبها تنورقا","لا سيما بنور طه البدر",103,"ر",1,0],["وَكَيْفَ بَقَاءُ لَيْلٍ مَعْ نَهَارٍ","ولاَ سِيماَ لِذِ النَّظَر الصَّحِ