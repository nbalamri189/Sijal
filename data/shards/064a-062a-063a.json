,[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83128","الرمل"],[4767,"بهجة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=187985",""],[4859,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=207372",""],[4888,"متشاعرون","https://www.poetsgate.com/ViewPoem.aspx?id=207680",""],[4896,"وحشة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=180896",""],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5121,"مَسَاءُ الشُّعُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=56463",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5183,"ناشد الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=180191",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5302,"في فؤادي ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=201267",""],[5409,"يا لها من فلتةٍ مبكيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155299",""],[5616,"شموخا أيتها المآذن","https://www.poetsgate.com/ViewPoem.aspx?id=204845",""],[5691,"العم سام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207063",""],[5691,"بحر عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207064",""],[5694,"مدير الحب","https://www.poetsgate.com/ViewPoem.aspx?id=132094",""],[5858,"رسالة الى البردوني","https://www.poetsgate.com/ViewPoem.aspx?id=195176",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6223,"حثالة الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1211&r=&rc=6",""],[6233,"سيمر العاشق فانتظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78445&r=&rc=8",""]],"verses":[["يَتَغايَرونَ عَلى السَماحِ كَأَنَّما","يَتَغايَرونَ عَلى وِصالِ ضَرائِرِ",0,"ر",1,0],["يتغنى بغير رُزءٍ ولا يس","كتُ إلا بحُكْمِه ورضاهُ",1,"ا",2,0],["يتغابَى لهم وليس لمُوقٍ","بل لِلُبٍّ يفوقُ لبَّ اللبيبِ",2,"ب",1,0],["يَتَغَاضَى عن زوجتيهِ اغتفاراً","وهما ضُرَّتاه في عَبْديهِ",3,"ي",2,0],["يتغنَّى مع العَصافيرِ في الغابِ","ويرنو إلى الضَّبابِ الكَسُولِ",4,"ل",1,0],["يَتَغالى بِهِ التَدَفُّقُ سَيلاً","كَاِنكِفاتِ السَرِيِّ أَسرَعَ يَجري",5,"ر",2,0],["يَتَغَوَّلُ المُدّاحَ أَدنى سَعيِهِ","بِمَكارِمٍ مِثلِ النُجومِ مُثولِ",6,"ل",1,0],["يَتَغَطّى عَنهُم وَلَكِنَّهُ تَن","صُلُ أَخلاقُهُ نُصولَ المَشيبِ",7,"ب",1,0],["يَتَغَنّى إِذا خَلا بِاِسمِكِ الحَ","قِ وَيَكنيكِ في العِدى أُمَّ وَهبِ",8,"ب",1,0],["يتغنى لحنَ الخلود ويدعو","من وراءِ الغيبِ الرهيبِ زمانَه",9,"ن",2,0],["يتَغَلَّبُ الرَّأْيُ الأَسَدُّ وَإِنْ","حال التَّنَاحُرُ دُونَهُ دَهْرَا",10,"ر",2,0],["يَتَغَنَّوْنَ بالنُّواسِيِّ حِيناً","وَبِشِعْر الفَتَى أَبي الْخَطَّابِ",11,"ب",1,0],["يَتَغَذَّى دمَ القُلوب شبابٌ","لا يُريدُ الحياةَ ذُلاًّ ووَهْنا",12,"ن",2,0],["يتغنّى سكران بين عوار","رضيت عريها كسا وحليّا",13,"ي",2,0],["يَتَغَنَّى اليَومَ في أرجَائِهَا","والفَايِيدُ لَهَا فِيهَا زَجَل",14,"ل",1,0],["يَتَغَنّى بِها عَلى نَغِمٍ بالٍ","في ضَواحي رِياضِها المَكّاءُ",15,"ا",2,0],["يتغنى والموت منه قريب","بالمنى والجنديّ رمز التفاني",16,"ن",2,0],["يتغنّى بالشعر شعرى شجيّا","فيصير الظلام عندي نهارا",17,"ر",2,0],["يتغاضى عند احتكامي في الخصر","ويلتذ عند مس النهود",18,"د",1,0],["يَتَغَنَّيانِ فَأَنكَرَ الصَّدّيقُ إِذ","قَد كانَ يُضربُ عِندَهُ دَفّانِ",19,"ن",1,0],["يتغنّون كلما أهرق الشعب على","الحق دمعه المسكوبا",20,"ب",2,0],["يتغنّى ساجعُ الطّيرِ به","هزَجاً في أيْكِهِ أو رمَلا",21,"ل",2,0],["يتغطرفونَ على الحِمامِ ويَتَّقِي","سطواتهم دُفَعُ السِّمام المُنْقعِ",22,"ع",1,0],["يتغطرفونَ على الحِمامِ إذا","خامَ الكماةُ وذلَّتِ البُهمُ",23,"م",1,0],["يتغايَرانِ على ثناءِ مُمَدَّحٍ","سِيَّانِ خَلْوةُ ليلهِ والمَحْفِلُ",24,"ل",1,0],["يتغنى في الطلى صارمه","بلحون لم تكن عن معبد",25,"د",1,0],["يَتَغَمَّدُ الأَيّامَ في نَزَواتِها","ثَبتُ المَقامِ عَلى اِقتِراحِ السُؤدَدِ",26,"د",1,0],["يَتغنّى نَشيشُها في الرواقي","دِ فتُنسيكَ نغمةَ الأوتارِ",27,"ر",1,0],["يتغنى بوصفك الدهر لما","يعجز الوصف ألسن الشعراء",28,"ا",2,0],["يتغنّى بخطبهم وهو يجري","في الدم الطاهر الذي بذلوه",29,"و",2,0],["يَتَغابى وَهوَ الفريدُ ذكاءً","وَحَميدٌ مِنَ الكِرامِ التّغابي",30,"ب",2,0],["يتغنى بها الحداة وتغني","عن لقاء الأحباب والآلاف",31,"ف",1,0],["يتغنى فيشتكى الحب والهُو","ن وما ان يَدرى الهوى والهوانا",32,"ن",2,0],["يتغنى وقلبه الغض خال","فيثير الهموم والأحزانا",32,"ن",2,0],["يتغنى بأنةٍ والميامي","ن من الشيب والأباة الشباب",33,"ب",1,0],["يتغنى في قلبٍ وَلِهٍ","وصفا ودٍ وافٍ وافرْ",34,"ر",1,0],["يَتَغَنّى وحبه يَتغنى","كتغني أَليفة لأَليف",35,"ف",1,0],["يَتَغَنّى مُصَوِّراً كُلَّ ما يَب","دو لِعَينَيهِ أَو يَمُرُّ بِبالِه",36,"ل",2,0],["يَتَغَنّى عَلى الأَراكِ طَروباً","مَرِحَ النَفسِ مُطمَئِنَّ البالِ",37,"ل",1,0],["يتغنى بلسانٍ","معربٍ فوق قضيب:",38,"ب",1,0],["يتغنى على مجارى السيول","ماشيا مشية السقيم العليل",39,"ل",1,0],["يتغنى برفعة المامون","ويجيد القريض في هارون",39,"ن",1,0],["يتغنى على أغاني الخرير","كتغنى المتيم المهجور",39,"ر",1,0],["يَتَغَنّى بِمَجدِ رَبِّ البَرايا","وَدُموعُ الحَمامِ راحٌ تَدورُ",40,"ر",1,0],["يَتَغايَرونَ عَلَى النَّدى فَكَأَنَّما","يَجِدُ الغَنِيُّ عَداوَة لِلمُعسِرِ",41,"ر",1,0],["يتغنى بين ورد الجلنار","ولها رمانة النهد ثمر",42,"ر",1,0],["يتغنّى به أخو الحبّ في نج","واه بين الأسى وبين الحنين",43,"ن",1,0],["يتغنى وقد سجا الليل والبدر","نثا ضوءه كذوب النضار",44,"ر",1,0],["يتغَنّى القيدُ في رج","ليهِ ألوان الغناءِ",45,"ا",2,0],["يتغنى باسمه جيل فجيل","حيث يبني جيل للعلى",46,"ل",2,0],["يتغنين حولها وهي في صمت","ولم تفتكر بتلك الهواجس",47,"س",1,0],["يَتَغَنّى بَينَ الثِمارُ بِلَحنٍ","هَل سَمِعتَ القِيانَ غَنَّت طِرابا",48,"ب",2,0],["يَتَغَنّى بِنُظمِهِ كل باد","وَغدا لِلمُقيمِ في النادِ نَدا",49,"د",2,0],["يَتَغَنّى بِاِسمِ الحَبيبِ المُفَدّى","بَينَ سَفحِ الوادي وَبَينَ قبابه",50,"ب",2,0],["يتغنّى باِسم الحَبيب جَهاراً","وَهو مع من أحبّ في خلواتِه",51,"ت",2,0],["يتغنى من المديح بلحن","فهمته منه الأيادي الجسام",52,"م",1,0],["يتغشى المصطفى من هاشمٍ","ويعم الآل والصحب الفرود",53,"د",1,0],["يَتَغَنّى الشعرُ في أَفيائِها","مُرسِلاً في كُلِّ لَحنٍ مَدمَعا",54,"ع",2,0],["يتغنى في احتفال","مثلما ربي أرادا",55,"د",2,0],["يتغزّلون بلا حياءٍ بينهم","وكأنها رخصَت لهم بيروتُ",56,"ت",1,1],["يتغزلون كصبية رُعنٍ وقد","سكبَ الزّمانُ على الوجوهِ خدودا",57,"د",2,0],["يتغنى مع الرياح اذاغنت","فيشجى خميله والتلالا",58,"ل",2,0],["يتغلفى على الجفون ، فإنْ رُحْ","تُ أناجيهِ لجَّ في الكرَى وتوَغّلْ",59,"ل",1,0],["يَتَغَنَى فِي وَاحَةِ الْخَيْرِ طَيْرِي","إِذْ يُحَيِّي سَمِيِرَهَا الْيَخْضُورُ",60,"ر",1,0],["يتغنى صبابة وهياما","فيثير الغرام منه الغناء",61,"ا",2,0],["يتغنى في الفضاء فإن","نام .,. نام اللطف في وكنه",62,"ن",2,0],["يتغشاه مس جن وقلب ال","صب يغلي وفي الضلوع حريق",63,"ق",1,0],["يتغلى ولست أدري أيدري","بغلاه وما تغلى الكرام",64,"م",1,0],["يتغنى شهر شعبان بها","والتغني كل ما نمتلك",65,"ك",1,0],["يتغنَّى به الزناةُ، ويسمو","كلُّ علجٍ.. فيا زواحفُ طيري",66,"ر",2,0],["يتغنّى بالحقِّ وهْوَ بَراءٌ","منه بُرْءَ الشيطان ِمنْ كلِّ نادمْ !",67,"م",1,0],["يتغنّى بها الكَناريُّ والبُلْبُ","لُ والعنْدليبُ والكَرَوانُ",68,"ن",1,0],["يتغلى عليه ويتغيض بدون غيوض","واجيله على مايشتهي ظبي الأوحاشي",69,"ش",2,0],["يتغنون بأرضي إنما","لا يلاقي الشعبَ ماءً أو طعاما",70,"م",2,0],["يتغنى بفضلها كل جيل","وهي فينا معدودة في القبائل",71,"ل",1,0],["يتغنّى بشعره كلُّ فدمٍ","يتهجّى قراءة الأسماء!",72,"ا",2,0],["يتغنّى باسمكِ يحرقه","تنهيدةَ لحن في وترِ",73,"ر",1,0]]}