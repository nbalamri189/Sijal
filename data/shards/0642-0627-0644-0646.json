{"poems":[[53,"يا رب عبد مالك سيدا","https://www.aldiwan.net/poem61854.html","الكامل"],[87,"كان لسلطان نديم واف","https://www.aldiwan.net/poem8052.html","الرجز"],[87,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"قسَماً بالإله عزَّ وجلاَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19555&r=&rc=58",""],[203,"وخليل ضممته فتأبى","https://www.aldiwan.net/poem45605.html","الخفيف"],[214,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63932","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77602","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46518","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46520","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46514","الرجز"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111233","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115688","المديد"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101599","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112672","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112637","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48348","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92083","الرمل"],[4702,"قالن علام الشيب ناشك يا يابه","https://www.poetsgate.com/ViewPoem.aspx?id=155111",""],[5055,"سيد الباب","https://www.poetsgate.com/ViewPoem.aspx?id=101195",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5282,"طريقُ العُلا","https://www.poetsgate.com/ViewPoem.aspx?id=213965",""],[5431,"جدّ باهظ...","https://www.poetsgate.com/ViewPoem.aspx?id=202658",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""]],"verses":[["قال نعم قلت متى قال لي","كُفيتَ مطْلَ الوعْد بالنقدِ",0,"د",1,0],["قالَ نَعَم مُرٌّ وَهَذا عَيبُه","مُذ كُنتُ يا مَولايَ لا أُحِبُّه",1,"ه",1,0],["قالَ ناسٌ صَرعَةٌ مِن قَدَرٍ","وَقَديماً ظَلَمَ الناسُ القَدَر",2,"ر",1,0],["قال نجمٌ لآخرٍ : ليت أني","لثرى الكوفةِ المعطر لاثم",3,"م",1,0],["قال: نلت المنى ، فقلت: جميعاً","قال لولا فراقهم قلت لولا",4,"ل",2,0],["قالَ نارُ الخليلِ في القلبِ شبَّتْ","قلتُ أقبلْ فتلكَ نارُ الكليمِ",5,"م",1,0],["قال ناظري صف لي نديت","ما لي جلد للناظرين",6,"ن",1,0],["قال نثرى يوما لشعري سلاماً","يا أخي يابنَ والدي ووليدي",7,"ي",1,0],["قال نحيلٌ جسمُه","من كرمٍ قد نحَلا",8,"ل",2,0],["قال نعم ومال نحو الظل","قالا له جئنا ونحن ندلي",9,"ي",1,0],["قال نِكْني فقلتُ ما نكتُ حُشّاً","قطُّ ما لي وما لنيك الحشوش",10,"ش",1,0],["قالَ نَعم أَعرف حَق المَعرفَه","وَأَنا خَير مَن أَتاكَ بِالصِفَه",11,"ه",1,0],["قالَ نَعَم ذي الفَأس حَقاً فَأسي","لأَنتَ خَيرُ سَيِّدٍ مُواسي",11,"ي",1,0],["قالَ نَعم فَافعل فَأَنتَ عالم","وَناصح كما تَقول راحم",12,"م",1,0],["قالَ نَعم جن الظَلام وَسَقَط","عَلى جِدار مَنزِلي وَقَد شَحط",13,"ط",1,0],["قالَ نَعم ثَأري عِندَ الجنس","وَلَيسَ يَشقى غَير ذاكَ نَفسي",14,"ي",1,0],["قالَ نَعم لا شَكَ لي في حكمته","وَعلمه وَحلمه وَقدرته",14,"ه",1,0],["قالَ نَعم فَالنَّسَب القَريب","يَعرفه المحقق اللبيب",14,"ب",1,0],["قال نَعم خَرَجت في جَماعة","تاجرة لكلنا بِضاعة",15,"ه",1,1],["قالَ نَعَم كانَت عَجوز خرفه","بِبَعلِها وَهوَ صَبي كلفه",16,"ه",1,1],["قالَ نَعم عامر كان ملكاً","عَلى نِزارٍ كُلها مملكا",17,"ك",2,0],["قال نال غاية مطلوب مؤرخها","تسميطها معرب عن معجز الكلم",18,"م",1,0],["قال نظرت في كتاب الأطمة","من الدروس ما اقتضى ان أنظمه",19,"ه",1,0],["قال ناولني زحاجتها","وهي ملأى قلت هاك فلا",20,"ل",2,0],["قال نسر لآخر أي طيرٍ","هو هذا ومن رفاقه",21,"ه",1,1],["قال نعم قال امضِ نحو يثربِ","وانعَ بها سبطَ النبيّ الأنجبِ",22,"ب",1,0],["قال نعم حرباً تسيلُ الأنفُسُ","وتُسقطُ الأيدي به والأرؤُس",23,"س",1,0],["قال نقّلْهُ ساعةً عنْ هَواها","قلتُ ما فيهِ للوجودِ نَصيبُ",24,"ب",1,0],["قال نور الشمع نارٌ تتَّقى","قلتُ إذ عيناك فيها قَلبُها",25,"ه",2,0],["قالن علام الشيب ناشك يا يابه","توّك شباب وتوّ بالعمر بادي",26,"د",2,1],["قالن بنات الشيخ وش جاب لي جاب","وقالن بنات البدو يمكن خدعها",27,"ع",3,0],["قال نسر الليل يجمعنا","تحت جنح السر والذمم",28,"م",1,0],["قِ النفسَ مِنْ عَثَراتها لاتعتبرْ","إلا بفضْلٍ في نَعيمِ السُّؤْدَدِ",29,"د",1,0],["قال نبعٌ على الحلاوة يجري","اسكبي الشوق ماجنا لا المواعظْ!",30,"ظ",1,0],["قَالَ نَجمٌ :مَنْ ذا الذِي قَد أتَانَا","أَعَلنَتْ أقمَارُ السَّما بالثَّنَاءِ",31,"ا",2,0]]}