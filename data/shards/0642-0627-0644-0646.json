{"poems":[[51,"يا رب عبد مالك سيدا","https://www.aldiwan.net/poem61854.html","الكامل"],[85,"كان لسلطان نديم واف","https://www.aldiwan.net/poem8052.html","الرجز"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[88,"قسَماً بالإله عزَّ وجلاَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19555&r=&rc=58",""],[200,"وخليل ضممته فتأبى","https://www.aldiwan.net/poem45605.html","الخفيف"],[211,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[459,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قال نعم قلت متى قال لي","كُفيتَ مطْلَ الوعْد بالنقدِ",0,"د",1,0],["قالَ نَعَم مُرٌّ وَهَذا عَيبُه","مُذ كُنتُ يا مَولايَ لا أُحِبُّه",1,"ه",1,0],["قالَ ناسٌ صَرعَةٌ مِن قَدَرٍ","وَقَديماً ظَلَمَ الناسُ القَدَر",2,"ر",1,0],["قال نجمٌ لآخرٍ : ليت أني","لثرى الكوفةِ المعطر لاثم",3,"م",1,0],["قال: نلت المنى ، فقلت: جميعاً","قال لولا فراقهم قلت لولا",4,"ل",2,0],["قالَ نارُ الخليلِ في القلبِ شبَّتْ","قلتُ أقبلْ فتلكَ نارُ الكليمِ",5,"م",1,0],["قال ناظري صف لي نديت","ما لي جلد للناظرين",6,"ن",1,0],["قال نثرى يوما لشعري سلاماً","يا أخي يابنَ والدي ووليدي",7,"ي",1,0],["قال نحيلٌ جسمُه","من كرمٍ قد نحَلا",8,"ل",2,0],["قال نعم ومال نحو الظل","قالا له جئنا ونحن ندلي",9,"ي",1,0]]}