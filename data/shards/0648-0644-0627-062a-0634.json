ps://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[4869,"بيني وبينك","https://www.poetsgate.com/ViewPoem.aspx?id=151718",""],[4926,"وحَّد إلهك لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[5038,"فم الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=188382",""],[5145,"إذا شئت أن تحظى من العلم بالذي","https://www.poetsgate.com/ViewPoem.aspx?id=108234",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5461,"يا وش بقى","https://www.poetsgate.com/ViewPoem.aspx?id=500",""],[5550,"أرى القلبَ","https://www.poetsgate.com/ViewPoem.aspx?id=210923",""],[5564,"يا لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5573,"اترك مشاكيك للباري","https://www.poetsgate.com/ViewPoem.aspx?id=200174",""],[5628,"حنين واشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=178259",""],[5629,"الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=184506",""],[5725,"وماعجبي بوجهك من صفاء","https://www.poetsgate.com/ViewPoem.aspx?id=185402",""],[242,"ألا قل لمن يبغي الى العز منفذا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563806",""],[242,"أقول لمن يصيخ الى اصطراخ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563805",""],[119,"إلهي مسني كرب عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55614&r=&rc=11",""]],"verses":[["وَلا تَشمَخَنَّ بِأَنفِ الأَنِيِّ","فَأَولى لِأَنفِكَ أَن يُرغَما",0,"م",2,0],["وَلا تَشَكَّ زَماناً أَنتَ في يَدِهِ","رَهنٌ فَما لَكَ بِالأَقدارِ مِن قِبَلِ",1,"ل",1,0],["وَلا تُشمِتَن مَن وَدَّ لَو أَنَّنا مَعاً","شَحيحانِ تُلطينا الجَنادِلُ بِالأَرضِ",2,"ض",1,0],["وَلا تَشرَبُ الأَمواهَ إِلّا تَعِلَّةً","إِذا عَثَرَت أَخفافُهُنَّ بِماءِ",3,"ا",2,0],["ولا تشتكي الأيام من داء فتنة","فقد عَرفَتْ منك الطبيب المداويا",4,"ي",2,0],["ولا تشتطَّ في طرب ولهو","فكلّ مُقارفٍ شَططاً ذميم",5,"م",1,0],["وَلا تَشقَيَن فيهِ فَيَسعَدَ وارِثٌ","بِهِ حينَ تَخشى أَغبَرَ اللَونِ مُظلِما",6,"م",2,0],["ولا تشحُّوا علينا أن نُغَرِّمكم","فيلتقي فيكُمُ بخلٌ وإضرارُ",7,"ر",1,0],["ولا تُشْجينَّ السائلين بمطلهم","فتشكي وتُعطي والعطاءُ مضيَّع",8,"ع",1,0],["ولا تشحَّنَّ أن تشارك في","جدواه فالبحر غير منتزف",9,"ف",1,0],["ولا تشتغلْ عني بلومِك خطبتي","فتودعَ صدر الودّ ذَحلاً على ذَحْلِ",10,"ل",1,0],["ولا تُشْفقي من حَدِّ نحْسٍ على امرئٍ","يسيرُ إلى سعدٍ لغُنْمِ غنائمِ",11,"م",1,0],["ولا تشفقوا بي من ضلال فإنما","إلى ضِلتي في شربها ينتهى الهدى",12,"د",2,0],["وَلا تُشبِعُها عَينٌ","مِنَ البِنزينِ فَوّارَه",13,"ر",2,0],["وَلا تَشَكَّ إِلى خَلقٍ فَتُشمِتَهُ","شَكوى الجَريحِ إِلى الغِربانِ وَالرَخَمِ",14,"م",1,0],["ولا تشيرا بنُصحٍ فيه معجزةٌ","فالنصحُ ليس بناهٍ عزمةَ البطلِ",15,"ل",1,0],["وَلا تُشِع سِرّاً لَهُ مُحتَبَسا","وَلا تَبِت في عَيشِهِ مُنغَمِسا",16,"س",2,0],["وَلا تُشارِكهُ بِأَحوالِ النِسا","لَم تَدرِ ما في نَفسِهِ قَد هَجَسا",16,"س",2,0],["ولا تشربنْ في كبوةِ الكُوبِ بالفَتى","كَذلِكَ يَجري في مَدى السُّكرِ من يجري",17,"ر",2,0],["وَلا تَشرَبَن بِاِدِّكارٍ لَهُ","وَلَكِن تَثاءَب عَلى ذِكرِهِ",18,"ه",1,0],["ولا تشكر الدنيا على نيل رتبة","فما نلتها إلا وأنت حقيق",19,"ق",1,0],["وَلا تَشكوا لَنا فَقدا","فَما نَشكو لَكُم فَقدا",20,"د",2,0],["وَلا تَشرَب بِلا طَرَبٍ وَلَهوٍ","فَإِنَّ الخَيلَ تَشرَبُ بِالصَفيرِ",21,"ر",1,0],["وَلا تُشَيمَن حُساماً كَي تَريقَ دَماً","كَفاكَ سَيفٌ لِهَذا الدَهرِ ما غُمِدا",22,"د",2,0],["وَلا تُشيفَن عَلى دارٍ لِتَنظُرَها","فَمَن أَشافَ عَلى قَومٍ كَمَن دَمَرا",23,"ر",2,0],["وَلا تشاور في أُمو","ر لك منهم أحدا",24,"د",2,0],["ولا تشربنَّ الخمر إن لم تزرهم","سجماهيرَ خيل يتبعن جماهرا",25,"ر",2,0],["ولا تشكُ الظِماء فان فينا","دماءً سوفَ تشربُها تِباعا",26,"ع",2,0],["ولا تَشِمَن بَرقَ الهَوَى فَهوَ خُلَّبٌ","وشِم بَارِقَ الحَقِّ اليَمَاني إِن لَمَنَع",27,"ع",1,0],["ولا تشكيت من الأين وجي","إذا دجى جنح من اليل دجن",28,"ن",1,0],["ولا تشمتوا بي عاذلين هجرتهم","على كونهم ذموا الغرام وعابوا",29,"ب",3,0],["ولا تشف غيظا إن ظفرت فما شفا","تقى ولا ذى غرة غلة الصدرة",30,"ر",2,0],["وَلا تَشكُ أَحداثَ اللَيالي إِلى اِمرئٍ","فَذا الناسُ إِمّا حاسِدٌ أَو مُعانِدُ",31,"د",1,0],["وَلا تَشقَيَا قَبلَ المَماتِ بِصُحبَتِى","ولا تَلبَسانِى لُبسَ مَن كانَ قاليَا",32,"ي",2,0],["ولا تَشْغَلْ ضميري باستماعٍ","لواشٍ فيّ مهدوم البِناء",33,"ا",2,0],["وَلاَ تَشْمَخْ بِأَنْفِكَ يَا ابْنَ طِينٍ","فَبِيسَ الْمَرْءُ شَخْصٌ ذُو جِفَاخِ",34,"خ",1,0],["ولاَ تَشْتَرِ الدنْيا بِدينِكَ سَاءَ مَنْ","يَبيعُ بِأَفْلاَذِ الزُّجاجِ زُمُرُّذَا",35,"ذ",2,0],["وَلا تشمت بي الاعداء وانظر","اليّ برحمة نظر اختيار",36,"ر",1,0],["وَلا تُشمِتِي بِيَ العِدا مِن عداتِها","فَحل الأَذى لَيْسَ الردَى مَعْنَا سَهل",37,"ل",1,0],["ولا تَشُب مَورِداً للأنس فزتَ به","بِذكرِ ما قَد قَضى في سالف الحُقبِ",38,"ب",1,0],["وَلا تَشكُ مِن خَطبٍ أَلَم إِلى فَتى","فايِ فَتى حَرٍّ لِشكواكَ يَسمَعُ",39,"ع",1,1],["وَلا تَشكُ الزَمان لِضيق رزقٍ","فَرزق اللَه أَوسَع ما يَكونُ",40,"ن",1,0],["وَلا تَشرَب سِوى صَهباء بكرٍ","تَجلّت كَالصبوح بِكَفّ بكرِ",41,"ر",1,0],["وَلا تَشك الزَمان فكلُّ ذَنبٍ","جَناهُ بَنو الزَمان وَكُلُّ وزرِ",41,"ر",1,0],["ولا تُشتَرَى اليومَ السُّيوفُ لِقَطعِهَا","وَلَكِن لِحُسنِ الحَليِ أو رَونَقِ الصَّّقلِ",42,"ل",1,0],["ولا تَشكَّى المَطايا طُولَ وِحْلَتها","ولا لأرجُلِها طَرْداً بأيديها",43,"ي",3,0],["ولا تشوفين للناس","فالأنس بالناس إفلاس",44,"س",1,0],["ولا تشبع من الحل","بل حسبك لقيمات",45,"ت",1,0],["ولا تشغل بغير العلم وقتاً","وهل بسواه يشتغل السعيد",46,"د",1,0],["ولا تَشِمِ البَرق اليمانيّ فإنَّه","متى لاحَ أورى في حشاشتك الزّندا",47,"د",2,0],["ولا تشقَّ لديهِ","ألم يجدك يتيما",48,"م",2,0],["ولا تشق عليه","اذا انجليت بسما",49,"م",2,0],["ولا تشتكي من لاعج اليتم بعدما","أزلت بهذا النصر من دمك اليتما",50,"م",2,0],["ولا تشاورهْ في أمرٍ هممت به","فربما لهوَجَ الآراءَ أو خبطا",51,"ط",2,0],["ولا تشامخت أنفا أو رضخت إلى","عسف الزمان وان جلت دواهيه",52,"ي",2,0],["ولا تشرب بأقداح صغار","فقد ضاق الزمان عن الصغار",53,"ر",1,0],["ولا تشغِلْ بأَهلِ الحِقدِ فِكراً","فحِقْدُهُمْ لهُمْ سَمُّ الأَفاعي",54,"ع",2,0],["ولا تُشمِتِ الاَعدَاءَ ولتَكُ نَاسياً","لِمَا بيننا إني لِنَعلِكَ أَلثِمُ",55,"م",1,0],["ولا تشتكي إلا لمن أنت عبده","فليس سوى المولى له ترفع الشكوى",56,"و",2,0],["ولا تشتغل بالناس عمن يراك إن","غفلت بأمر عنه لم تر منجدا",57,"د",2,0],["ولا تَشتَغِل عَن مُلكِ بَيشَ وخَرجِه","بِقطعةِ جازانٍ وقِطَعةِ طَوطَر",58,"ر",1,0],["ولا تشكّت جيادي ما أضرّ با","من طول ركض وإساد وتأويب",59,"ب",1,0],["وَلا تشمت بي الأَعداءَ واعطف","عليّ وِبالرضا يا رَب عجِّل",60,"ل",1,0],["وَلا تشهدِ الأَسبابَ وَاِترُك شُهودَها","فَمَن شاهَدَ الأسبابَ لا شكَّ يَندَمِ",61,"م",1,0],["ولا تشكُ إلى الأعدا","ء مِنْ صرْف الدُّنا حالا",62,"ل",2,0],["ولا تشاورْ في الأمور النسا","يوماً ولو يُعْرَفْن بالفهمِ",63,"م",1,0],["وَلا تُشيري لي وَلا تومِئي","وَدِدتُ لَو تُقطَعُ كِلتا يَدَيكْ",64,"ك",1,0],["ولا تشبب بألحان الحجاز فما","حبل آدكارك بالمحبوب موصول",65,"ل",1,0],["ولا تشكّى ولا نشكى العدا في الحرب من","ظمإ غلا سقوهم بكاسات المنيات",66,"ت",1,0],["ولا تشكونَّ اليومَ قبلَ انقضائِه","فمن ساعةٍ منه إلى ساعة فرح",67,"ح",1,0],["ولا تشمت به الاعداء يا من","له حسن المواهب واليسار",68,"ر",1,0],["ولا تَشدُدِ النونَ التي يُظهِرونَها","كقَولِكَ من خيل لدى سروةِ الحَشرِ",69,"ر",1,0],["ولا تشفي الدموع حليف وجد","وان فاضت بأربعة سجام",70,"م",1,0],["وَلا تَشُق عَلَيهِ","فَنترَُنهُ هَشيما",71,"م",2,0],["وَلا تشم للجنان ريّا","وَلا تفيا في فناها فيّا",72,"ي",2,0],["ولا تشذ اذا عز الطلاب وقل","حكم المنية في حكم الحبيب منى",73,"ن",2,0],["ولا تشدد النون التي يظهرونها","إذا ما عدت شيئا من الأحرف الزهر",74,"ر",1,0],["ولا تشوَّفت نحو الرمل ملتفتاً","لو لم يكن لظباء الحي أوطانا",75,"ن",2,0],["ولا تشكيت زماني ولو","نازلني بالفادح المرهق",76,"ق",1,0],["ولا تشتِّت ولا تفرِّق","عبديه من حاضر وبادي",77,"د",2,0],["ولا تشربن من في السقاء وثلمة ال","إنا وانظرن فيه ومصا تزرّد",78,"د",1,0],["ولا تشرب باقداح صغار","فإنّ الوقت ضاق عن الصغار",79,"ر",1,0],["ولا تشهدوا بدراً اذا سل بيضه","فقد جاء زحفاً في كتيبته الخضرا",80,"ر",2,0],["ولا تشمت بنا الأعداء إنا","تأزرنا بودك وارتدينا",81,"ن",2,0],["ولا تشتموا أسلافكم وتعاطفوا","على البرِّ إِنَّ البر من أفضل الفعل",82,"ل",1,0],["ولا تشغل الذهب النقي بمنصب","تريد فذاك الفكر يسطو على النهى",83,"ن",3,0],["ولا تشبه بماءٍ","فالماء عندي كثير",84,"ر",1,0],["ولا تشرّد يوما","ولا أصاغ مطيعا",85,"ع",2,0],["ولا تُشبها بأقوال الوّشاة فما","يجرُّ نفعا إلى علياك واشيها",86,"ي",3,0],["ولا تشتكي الا اليه فانه","حليف مروآت يواسيك أو يسلى",87,"ل",2,0],["ولا تَشقَن عليّ جزَعاً","جَيباً وإن جلّ المصابُ موقِعاً",88,"ع",2,0],["وَلاَ تَشْكُ هَجْراً مِنْ حَبِيبٍ مُوَاصِلٍ","تَنَكَّرَ إِذْ سَمَّيْتَهُ باسْمِ كَاشِحِ",89,"ح",1,0],["ولاتشمت الملعون بي وتردّ ما","يكيد به في نحره رمى نابل",90,"ل",1,0],["وَلا تَشتُمِ المَولى تَتَبَّع أَذاتَهُ","فَإِنَّكَ إِن تَفعَل تُسَفَّه وَتَجهَلِ",91,"ل",1,0],["ولا تشاجرت الأوراق في ورق","إلاَّ توالت على قلبي شواجره",92,"ر",2,0],["ولا تشفق على قوم لئام","قد اعتادوا السعاية والسبابا",93,"ب",2,0],["ولا تشيدوا بناء الأعتقاد على","أوهى شفا جرف من أصله هار",94,"ر",1,0],["ولا تشحَّ فإن الشحَّ يُورِثُ ما","يُردي ومن يوقَ شحَّ النفس يغتنمِ",95,"م",1,0],["وَلاَ تَشِحَّ وَجُدْ وَلَوْ بِطَلِّ يَدٍ","إِنْ لَمْ يُصَبْ مِنْكَ وَيْلُ الصَّيِّبِ الهَطِلِ",96,"ل",1,0],["ولا تشيدوا القبر قبراً أمثلا","بل فاعتنوا به اعتناءً مجملا",97,"ل",2,0],["ولا تشمتوا العذال يوماً بمدنفٍ","فؤادكمُ سُؤلي لفي حالهِ أدري",98,"ر",2,0],["ولا تُشمتِ العذّالَ بل خَل كيدهم","بأنحارهم دهراً بعينٍ حسيرةِ",99,"ه",1,0],["وَلا تَشذَّ عَنهمُو في مَذهَبِ","لَكن إِذا لَم تَرضَ شَيئاً فَاعزُبِ",100,"ب",1,0],["وَلا تَشكرا شُكرى عَلى حُسنِ شعرِهِ","فَذَلِكَ شعرٌ بِالبَلاغَةِ يَكفُرُ",101,"ر",1,0],["ولا تَشتُمْ ولا تعتبْ","ولا تُظهرْ لما سَتَرا",102,"ر",2,0],["ولا تشقوا لنا اللحود فما","يصنع قتلي الغرام باللحد",103,"د",1,0],["ولا تشهروا حرب النكير عليهم","بتكذيب ذي صدق وتصديق كاذب",104,"ب",1,0],["ولاتشقي علي جيب اللطيمه","اخاف يجيني ذنب النادبينا",105,"ن",2,0],["ولاتشيل هم .. الحب ديني ودينك","ولايسدده ياكود دينك وديني",106,"ن",2,0],["ولا تشتم الدَّهر جهلاً إذ مقلِّبه","في عقدنا ليس إلاّ الواحد الأحدا",107,"د",2,0],["ولا تشْكو إلى الإنسانِ وهْناً","فإنّ الوهنَ في البلوى مَعِيبُ",108,"ب",1,0],["ولا تشتغل إلا به إن غيره","من العلم مثل الكعب يستلحق الشظا",109,"ظ",2,0],["ولا تشغلي بالا بهم فتحملي","من الحزن مايؤذي ويستحضر السهدا",110,"د",2,0],["ولا تشرك علياً أو حسينا","ولا الجيلي في هذي الفعال",111,"ل",1,0],["ولا تشوف العين زين بلياك","ولا يطرب سمعي إلا مجالك",112,"ك",1,0],["ولا تشْرب الخمْرَ حتَّى تظل َّ","حياتُكَ مُتْرَعةً بالصفاء",113,"ا",2,0],["ولا تشاور الا لي له الشور بجدود","وليمن ثقل حمله يروم اشتلاله",114,"ل",2,0],["ولاتشتكي من عنا ضرفي","أترك مشاكيك للباري",115,"ر",2,0],["ولا تشغلكِ أخطائي فتنسي","ذنوبكِ وَهْيَ كُثْرٌ بالألوفِ",116,"ف",1,0],["ولاتشكي وهم سنارة الصياد","ترى وجهين عملة همك وهمي",117,"م",2,0],["ولاتشدو بصوتك قرب غصن","فماللطير بعدك من غناءٍ",118,"ا",2,0],["وَلا تَشتَري الدُنيا بِدينِكَ ساءَ مَن","يَبيعُ بِأَفلاذِ الزُجاجِ زُمُرُّذا",119,"ذ",2,0],["وَلا تَشمَخُ بِأَنفِكَ يا اِبنَ طينٍ","بيسَ المَرءُ شَخصٌ ذو جَفاخِ",120,"خ",1,0],["ولا تشمت بي الأعداء إني","أخو ضعف به ضاق الفضاء",121,"ا",2,0]]}