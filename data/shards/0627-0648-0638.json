{"poems":[[53,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[94,"يا عذارى الجمال والحب والأحلام","https://www.aldiwan.net/poem38951.html","الخفيف"],[60,"أغن عن المخلوق بالخالق","https://www.aldiwan.net/poem30955.html","السريع"],[76,"نهر كما سال اللمى سلسال","https://www.aldiwan.net/poem13208.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[199,"بانت حسينة وائتمت بمن بانا","https://www.aldiwan.net/poem54410.html","البسيط"],[314,"إغن عن المخلوق بالخالق","https://www.aldiwan.net/poem50271.html","السريع"],[463,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59320","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108615","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2002,"","https://poetry.dctabudhabi.ae/diwan/poem/203092",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106892","البسيط"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121127","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205792","الخفيف"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110834","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52984","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132132","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111190","الكامل"],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""],[5770,"طرب الفؤاد وهاجه شجن","https://www.poetsgate.com/ViewPoem.aspx?id=178269",""],[6035,"تشوقني تلك العيون .. !","https://www.poetsgate.com/ViewPoem.aspx?id=176654",""]],"verses":[["أو ظَنُّهُ أنْ لا صيامَ لضيفِه","مع رَتْعه في عرضه المسبوبِ",0,"ب",1,0],["أو ظَلامٌ كأنَّهُ قِطَعُ اللّيلِ","وهَوْلٌ يُشيبُ قلبَ الوليدِ",1,"د",1,0],["أَو ظَنَّ أَنَّ الناسَ يُغنونَهُ","زَلَّت بِهِ النَعلانِ مِن حالِقِ",2,"ق",1,0],["أَو ظِلُّ أَسمَرَ بِاللِوى مُتَأَطِّرٌ","عَطَفَت جَنوبٌ مَتنَهُ وَشَمالُ",3,"ل",1,0],["أَوْ ظَنَنْتَ الطَّرِيقَ غَيْرَ الَّتِي يَسْ","لُكُهَا وَهْوَ فِي طَرِيقِ السَّدَادِ",4,"د",1,0],["أَو ظَبيَةٌ مِن ظِباءِ الحُوَّةِ اِبتَقَلَت","مَذانِباً فَجَّرَت نَبتاً وَحُجرانا",5,"ن",2,0],["أَو ظَنَّ أَنَّ المالَ مِن كَسبِهِ","زَلَّت بِهِ النَعلان مِن حالِقِ",6,"ق",1,0],["أو ظمئتْ أعراضُكم","كانت شفاءَ الغُلَّهْ",7,"ل",2,0],["أوْ ظِلِّ نَبْتٍ عَلَى غدير","أوْ عَنْبَرٍ فِي لَظًى تَوَقَّدْ",8,"د",1,0],["أو ظلت يوماً والياً لولايةٍ","وتركت فيها فاجراً وعنيدا",9,"د",2,0],["أو ظبيّات مصمتات حجال","والدماليج كالبرى خرساء",10,"ا",2,0],["أو ظَلَّ عازَرُ قصدِنا","ميتاً فجَدواكَ المسيحُ",11,"ح",1,0],["أو ظمئت نفسكم نهاراً","بالصوم أو كنت فيه جعتا",12,"ت",2,0],["أو ظَاهرٌ فِيه وَذَا مِن حيثُ نِس","بَتُهُ إلَى الأفهَامِ وَالأذهَانِ",13,"ن",1,0],["أو ظل دوحٍ على ماءِ الغدير غدا","من النواسم في وجد وفي قلق",14,"ق",1,0],["أو ظنّ أن فناك في تهديمها","فإذا به تحيا حياة نحيب",15,"ب",1,0],["أو ظللت الأمين رغم تجافي","ك وكنت الوفيّ في الهجران",16,"ن",1,0],["أَو ظلَّ يلعَبُ عمرٌو في نُهَى زُمَرٍ","فإنَّ سيفَ عليٍّ فرَّق الزُّمَرَا",17,"ر",2,0],["أو ظامئين استسقيا صوب الحيا","فسقاهما عذبا روي المنهل",18,"ل",1,0],["أو ظبيُ قاعٍ ذو نِفار","يعدو إذا عمّ النفير",19,"ر",1,0],["أو ظل أغمية الغمام","على البطائح من زرود",20,"د",1,0],["أو ظبية أدماء يعطو جيدها","فرق الحوائم في نمير المورد",21,"د",1,0],["أو ظلالٍ معطَّراتِ الحواشي","وحَرورٍ مُلَهَّبٍ كالحريق",22,"ق",1,0],["أو ظننّا النّصر قولا","وشعارا وانبطاح",23,"ح",1,0],["أو ظللتك ظلال وارفةٍ","وكساكَ من زيتونةٍ غصنُ",24,"ن",1,0],["أو ظلّت الدُرّات في صَدَفاتها","مارُفِّه الجيدُ اللطيفُ ودُلِّعَا",25,"ع",2,0]]}