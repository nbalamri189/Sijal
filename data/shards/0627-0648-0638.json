{"poems":[[51,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[92,"يا عذارى الجمال والحب والأحلام","https://www.aldiwan.net/poem38951.html","الخفيف"],[58,"أغن عن المخلوق بالخالق","https://www.aldiwan.net/poem30955.html","السريع"],[74,"نهر كما سال اللمى سلسال","https://www.aldiwan.net/poem13208.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[195,"بانت حسينة وائتمت بمن بانا","https://www.aldiwan.net/poem54410.html","البسيط"],[309,"إغن عن المخلوق بالخالق","https://www.aldiwan.net/poem50271.html","السريع"],[458,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"]],"verses":[["أو ظَنُّهُ أنْ لا صيامَ لضيفِه","مع رَتْعه في عرضه المسبوبِ",0,"ب",1,0],["أو ظَلامٌ كأنَّهُ قِطَعُ اللّيلِ","وهَوْلٌ يُشيبُ قلبَ الوليدِ",1,"د",1,0],["أَو ظَنَّ أَنَّ الناسَ يُغنونَهُ","زَلَّت بِهِ النَعلانِ مِن حالِقِ",2,"ق",1,0],["أَو ظِلُّ أَسمَرَ بِاللِوى مُتَأَطِّرٌ","عَطَفَت جَنوبٌ مَتنَهُ وَشَمالُ",3,"ل",1,0],["أَوْ ظَنَنْتَ الطَّرِيقَ غَيْرَ الَّتِي يَسْ","لُكُهَا وَهْوَ فِي طَرِيقِ السَّدَادِ",4,"د",1,0],["أَو ظَبيَةٌ مِن ظِباءِ الحُوَّةِ اِبتَقَلَت","مَذانِباً فَجَّرَت نَبتاً وَحُجرانا",5,"ن",2,0],["أَو ظَنَّ أَنَّ المالَ مِن كَسبِهِ","زَلَّت بِهِ النَعلان مِن حالِقِ",6,"ق",1,0],["أو ظمئتْ أعراضُكم","كانت شفاءَ الغُلَّهْ",7,"ل",2,0]]}