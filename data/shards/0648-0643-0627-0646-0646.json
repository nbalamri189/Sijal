"وكأنَّني مما تُسوِّلُهُ المُنى","والدّارُ نازِحةٌ إليها أنظُرُ",3,"ر",1,0],["وكأنني بِذَرا الإمامِ مُقَبِّلٌ","مِن سُدَّتَيْهِ مُعَرَّسَ العَلياءِ",4,"ا",2,0],["وَكَأَنَّنا لَم نَجتَمِع في بَلدَةٍ","وَكَأَنَّنا في خَلوَةٍ لَم نَلتَقِ",5,"ق",1,0],["وَكَأَنَّ نُسوَتَها الكَواعِبَ حَولَها","زُهرُ الكَواكِبِ حَولَ بَدرٍ أَزهَرِ",6,"ر",1,0],["وَكَأَنَّنا لَم نَجتَمِع في مَجلِسٍ","فيهِ الغِناءُ وَنَرجِسٌ وَبَهارُ",7,"ر",1,0],["وكأنّني لمّا سمِعْتُ بَديعَها","ورشَفْتُ منْها قَرْقَفا مَشْمولا",8,"ل",2,0],["وَكَأَنَّنِي عَاطِيْتُ كأْسَ مُدَامَةٍ","صَهْبَاءَ بَيْنَ مَثَالثٍ وَمَثَانِي",9,"ن",2,0],["وكأنّني بالصُّبحِ فيهِ عاطِساً","مِنْ بعْدِ ما هَبّ الهَواءُ البارِدُ",10,"د",1,0],["وكأنّ نورَ جَبينِ يوسُفَ نورُهُ","وكأنّ ديمَتَهُ المُلِثّةَ جودُهُ",11,"د",2,0],["وكأنّني مُذْ غابَ وجْهُكَ ذاهِبٌ","في اللّيلَةِ الظّلما بِلا مِصْباحِ",12,"ح",1,0],["وَكَأَنَّنا فَوقَ السَما","ءِ وَتَحتَنا ذاكَ السَديمُ",13,"م",1,0],["وَكانَ نَصراً مِنَ الرَحمَنِ قَدَّرَهُ","وَاللَهُ رَبُّكَ ذو مُلكٍ وَتَقديرِ",14,"ر",1,0],["وَكَأَنَّني رِئبالُ غابٍ ضَيغَمٍ","يَقرو الأَماعِزَ بِالفَجاجِ الأَفيَحِ",15,"ح",1,0],["وكأنني يا سيفَ دولة فتنةُ","بك وهو مفتخرٌ على القدَماء",16,"ا",2,0],["وكانَ نباتي قد ذوى عنه معشرٌ","فأحياه محيي النبت بالشمس والقطر",17,"ر",1,0],["وكان نهارُ المرء أهْدَى لسعيه","ولكنَّ ظلَّ الليل أنْدَى وأبردُ",18,"د",1,0],["وكأنني بي قائل","زرتُ الحيا فحبا وأمجدْ",19,"د",1,0],["وكأنني بهمُ لديك وإنّما","شمسُ النهارِ بهم هناك لديكا",20,"ك",2,0],["وكأنني بي شاكرٌ لك قائلٌ","لاقَيْتُ خيرَ مُنفّل تنفيلا",21,"ل",2,0],["وكأنني بك شاكرٌ لك قائلٌ","إنَّ الكريمَ يلين للتليين",22,"ن",1,0],["وَكَأَنَّنا كُنّا نُحَلِّقُ في الفَضا","صُعُداً لِنَلمِسَ مَنكِبَ الجَوزاءِ",23,"ا",2,0],["وَكَأَنَّنا وَالمَوتُ يَرتَعُ في","أَرواحِنا مَرعى وَمُستَمري",24,"ر",2,0],["وَكَأَنَّني العُصفورُ عَرّى جُسمُهُ","مِن ريشِهِ المُتَناسِقِ المُتَلَمِّعِ",25,"ع",1,0],["وَكَأَنَّنا رَهَطُ الكَواكِبِ في الفَضا","مَهما جَرى في الأَرضِ لا تَتَزَلزَلُ",26,"ل",1,0],["وَكَأَنَّ نُمرُقَتي فُوَيقَ مُوَلَّعٍ","يَرعى الدَكادِكَ مِن جَنوبِ قَطانا",27,"ن",2,1],["وكأنَّنا نمشي بأَقدامٍ","مجنَّحةٍ تَطيرْ",28,"ر",1,0],["وَكأَنَّني قَبّلتُ ثَغرَكِ وَالطلى","وَالوَجنَتَينِ وَنِلتُ مِنك مُرادي",29,"د",2,0],["وكان نصير الحق مذ كان يافعا","برغم الرزايا والرقيب المراصد",30,"د",1,0],["وكأن نفح الطيب حو","ل نضيدها أنفاس حور",31,"ر",1,0],["وَكانَ نَزيلُهُ بِالمَلكِ يُدعى","فَصارَ يُلَقَّبُ الكَنزَ الثَمينا",32,"ن",2,0],["وَكَأَنَّني بِكَ قَد أَتَيتَ بِعَرشِها","وَالسَيفُ أَسرَعُ هِبَةً مِن آصِفِ",33,"ف",1,0],["وَكانَ نُفَيعٌ إِذ هَجاني لِأُمِّهِ","كَباحِثَةٍ عَن مُديَةٍ تَستَثيرُها",34,"ر",3,0],["وكأنَّ نَشْرَ كُؤوسِها","شُكري لأحمدَ في المَحافِل",35,"ل",1,0],["وَكَأَنَّني بِكَ عَن قَري","بٍ رَهنَ حَتفٍ لَم يَفُت",36,"ت",1,0],["وَكَأَنَّني بِكَ بَينَهُم واهي القُوى","نِضواً تَقَلَّصُ بَينَهُم وَتَبَسَّطُ",37,"ط",1,0],["وَكَأَنَّني بِكَ بَينَهُم خَفِقَ الحَشا","بِالَموتِ في غَمَراتِهِ يَتَشَحَّطُ",37,"ط",1,0],["وَكَأَنَّني بِكَ في قَميصٍ مُدرَجاً","في رَيطَتَينِ مُلَفَّفٌ وَمُحَنَّطُ",37,"ط",1,0],["وَكَأَنَنَني بِالمَوتِ أَغفَ","لَ ما تَرى بِكَ قَد نَزَل",38,"ل",1,0],["وَكَأَنَّني مِمّا تَطاوَلَ بي","مِنكَ السَقامُ طُليتُ بِالوَرسِ",39,"س",1,0],["وَكَأَنَّني بِالمَوتِ قَد","دارَت رَحاهُ عَلى بَنيهِ",40,"ه",1,0],["وَكَأَنَّ نَرجِسَ رَوضِها","قَد صيغَ مِن وَرَقٍ وَعَينِ",41,"ن",1,0],["وكأنني طفلٌ بها وخواطري","أرجوحةٌ في لجّها المتلاطم",42,"م",1,0],["وكأنني مما يسوء خلي","وحياتيَ انجابت حوالكها",43,"ه",2,0],["وكأنني في شاطئ مهجور","قد فارقته سفينة لا ترجع",44,"ع",1,0],["وَكَأَنَّني بِالظاعِنينَ وَطِيَّةٌ","تَبكي لَها الأُلّافُ لِلأُلّافِ",45,"ف",1,0],["وَكَأَنَّني بِالشَدقَمِيَّةِ وَسطَهُ","خُضرُ اللُهى وَالوُظفِ وَالأَخفافِ",45,"ف",1,0],["وَكَأَنَّني أُسقى إِذا ذُكِرَت","صَفوَ المُدامِ عَلى رُقى السَحرِ",46,"ر",1,0],["وَكَأَنَّ نُطفَةَ بارِدٍ وَطَبَرذَداً","وَمُدامَةً قَد عُتِّقَت أَعصارا",47,"ر",2,0],["وَكانَ نِساءُ الحَيِّ مُذ كُنتِ بَينَهُم","مِلاحاً فَلَمّا غِبتِ صِرنَ قِباحا",48,"ح",2,1],["وَكانَ نَضيراً عَلى منكبيه","فَأَصبَح مِنهُ سَليباً خَضيب",49,"ب",1,0],["وَكَأَنَّني ضَلّلتُ سَيرَ مَنيتي","إِن الطَريق إِلى الفَناء معبّد",50,"د",1,0],["وَكَأَنَّ نَقعَهُما بِبُرقَةِ ثادِقٍ","وَلِوى الكَثيبِ سُرادِقٌ مَنشورُ",51,"ر",1,0],["وَكَأَنَّنا لَم نَغنَ بَينَ عِراصِها","في غَبطَةٍ وَكَأَنَّنا لَم نَحلُلِ",52,"ل",1,0],["وَكَأَنَّ نَشرَ الأَرضِ بِال","أَنوارِ حينَ تَلَحَّفا",53,"ف",2,0],["وَكانَ نَشيطاً فَلَمّا رَآ","هُ صاحِبَ هَمٍّ فَلَم يَنشَطِ",54,"ط",1,0],["وكأنّني بك قد هَزِجْتَ مُلبيّاً","وهَدَجْتَ بينَ شِعابِ مكّة والصَّفا",55,"ف",2,0],["وكأنّني بِلِواءِ نَصرِكَ خافِقاً","قد حامَ بينَ المَرْوَتَينِ ورفرَفا",55,"ف",2,0],["وكأنني بك قد بلغت مأربي","وقضيتُ من نُسكِ المُودِّع ما كفى",55,"ف",2,0],["وَكَأَنَّني بِكَ قَد أَتَتكَ مَنِيَّةٌ","لا شَكَّ أَنَّ سَبيلَها مَورودُ",56,"د",1,0],["وَكَأَنَّني بِكَ قَد شُغِفتَ بِحُسنِهِ","فَخَطَطتَهُ حِرصاً عَلَيهِ بِكَفِّكا",57,"ك",2,0],["وكانَ نكاحُهنَّ يراهُ حوباً","مخافةَ أن يناسلنَ الشرارا",58,"ر",2,0],["وَكَأَنَّني رَحِلٌ أَضَلَّ رُقادَهُ","عانٍ تُطيفُ بِهِ الهُمومُ جُنودا",59,"د",2,0],["وَكَأَنَّ نَكهَتَها إِذا نَبَّهتَها","طِفلٌ يَلوكُ بِدُردُرَيهِ سِخابا",60,"ب",2,1],["وَكَأَنَّني مِن حُبِّها","ظَأرٌ أَهابَ بِهِ مُهيب",61,"ب",1,0],["وكَأَنَّ نَابَيْهَا بِأَخْطَبِ ضَالَةٍ","مُسْتَنْقِعَانِ عَلَى فُضُولِ المِشْفَرِ",62,"ر",1,0],["وكأنني ما كنت إلفَك في الصبا","يوماً ولا كنتَ الحياة مشاطري",63,"ر",2,0],["وكأَنَّني لمّا انْحَطَطْتُ به","أَرْمي الفَلاة بكَوْكَب طَلْقِ",64,"ق",1,1],["وكأَنَّني لمّا طَلَبْتُ به","وَحْش الفَلاةِ على مَطا بَرْقِ",64,"ق",1,0],["وكأَنَّ نَثْرَ النَّجْمِ ضَأْنٌ وسْطَهَا","وكأَنَّمَا الجَوْزاءُ راعِي ضانِهَا",65,"ن",3,0],["وكأَنَّنِي لمّا كَرُمْتُ وقد شَكَتْ","أَرْضِي الحوادِث غِبْتُ مِن حدثانِهَا",65,"ن",3,0],["وكأَنَّني فِيهِمْ لَقِي","طٌ قاد مِن أَحْياءِ دارِمْ",66,"م",1,0],["وكأَنَّنا فيها العفا","رِتُ والكُؤوسُ مِن الرّواجِمْ",66,"م",1,0],["وكأَنَّنا في رَمْيها","نَسْتَلُّ مِن بِيضِ الصّوارِمْ",66,"م",1,0],["وَكَأَنَّنِي بِكَ بَيْنَهُمْ مُتَرَفِّعاً","كَالْبَدْرِ بَيْنَ كَواكِبِ الخَضْراءِ",67,"ا",2,0],["وَكَأَنَّ نَابلْيُونَ فِي إِشْرَافِهِ","عَلَمٌ عَلَى عَلَمِ الزَّعامَةِ بَادِ",68,"د",1,0],["وَكَأَنَّ نَرْجِسَهُ بِمَرْ","أى مِنْهُمُ نَادٍ ونامِ",69,"م",1,0],["وَكَأَنَّنِي بِالقَبْرِ أَصْبَحَ مِنْبَراً","وَكَأَنَّنِي بِكَ مُوشِكٌ أَنْ تَهْتِفَا",70,"ف",2,0],["وَكَانَ نَجْدَةً دَاعيَةٍ بِلاَ مَهَلٍ","فِي نُصْرَةِ الحَقِّ هَانَ الأَمْرُ أَوْ صَعُبَا",71,"ب",2,0],["وَكَانَ نَوْءَ المُوَا","لِينَ رَحْمَةٌ وَسَخَاءَ",72,"ا",2,0],["وكأنني «بابن الوليد»، «وطارقٍ»","«وأبي عبيدة» يركبون خيولا",73,"ل",2,0],["وكأنني لما سمعت بديعها","ورشفت منها مرفقا مشمولا",74,"ل",2,0],["وكأنني بالصبح فيه غاطسا","من بعد ما هب الهواء البارد",75,"د",1,0],["وكأنني عاطيت كأس مدامة","صهباء بين مثالث ومثان",76,"ن",1,0],["وكأنني مذ غاب وجهك ذاهب","في الليلة الظلماء بلا مصباح",77,"ح",1,0],["وكأنني بشخوصهم في مَحضرٍ","دانٍ ، بعيدٍ ، سائغٍ ، ممنوع",78,"ع",1,0],["وكأنني بك إذ تقابلُ واحداً","منهم ، تريه غفلةَ المتغابي",79,"ب",2,0],["وكان نقياً فكرةً وعقيدةً","عزيزاً عليه ان تَسِفَّ العقائد",80,"د",1,0],["وكأنني فيما أُحاولُ ، هاربٌ","حَذِرٌ مخافةَ ان يَرَى إنسانا",81,"ن",2,0],["وَكأنّني بكَ قَد أتَيتَ بعَرْشِها،","وَالسّيفُ أسرَع هَيْبَةً مِنْ آصَفِ",82,"ف",1,0],["وكأنّني بك حين تهتف قائل","للزهر : إنّ الحسن غير مخلّد",83,"د",1,0],["وكأنّني بالصيد من أمرائها","يوم الحميّة أنكرت أحقادها",84,"د",3,0],["وكأنّني بالتاج ألّف شملها","نظما ولمّ نثيرها وبدادها",84,"د",3,0],["وكأنني بهمُ إليك وإنّما شمسُ","النهارِ بهم هناك لديكا",85,"ك",2,0],["وكأنّ نطفة َ باردٍ وطبرزداً","وَمُدَامَة ً قَدْ عُتِّقَتْ أَعْصارا",86,"ر",2,0],["وكأنني ما كنت إلفك في الصّبا","يوما ولا كنت في الحياة مشاطري",87,"ر",2,0],["وكَأنني لَمَّا مَرَرتُ بِدِمنَتَى","ذَاتِ الرُّبَى نَقِفتُ حَنَاظِلا",88,"ل",2,0],["وكأنني بك فوق غاربها","متسنِّما في ذِروة الفخرِ",89,"ر",1,0],["وكان ندا يوم عظيم ومشهد","به العلما قد أجمعوا وذوو الأمر",90,"ر",1,0],["وَكَأَنَّنا مِن فَرعِها في مَغرِبٍ","وَكَأَنَّنا مِن وَجهِها في مَشرِقِ",91,"ق",1,0],["وكأنّ نَمْلَ عِذَاره قد خاف أن","يَسْعَى به فيزلّ عن مرآته",92,"ت",2,0],["وَكَأَنَّ نَخلاً في مُطيَةٍ ثاوِياً","بِالكَمعِ بَينَ قَرارِها وَحَجاها",93,"ا",3,0],["وكأنني من صفرةٍ غسلينُه","وكأنني من دقَّةٍ زُنارُهُ",94,"ر",2,0],["وكان نقل مدامي","من ناهدات النهود",95,"د",1,0],["وكأنني أشكو لطي","فك جور حكمك في الغرام",96,"م",1,0],["وَكَأَنَّني في عَينِها لَهَبٌ","بِفُؤادِها الوَلهانِ مُتَّصِلُ",97,"ل",1,0],["وَكَأَنَّن مُقلَتَها سِرا","جٌ كاد يُطفيُ بِالزَفير",98,"ر",1,0],["وكأنّ نَرْجِسَه إذا استقبلتَه","يرنو بأجفانِ العيون الحُور",99,"ر",1,0],["وكأنّ نظم فُصولِه","دُرّ على سَبَج نَثِير",100,"ر",1,0],["وَكَأَنَّني مُتِّعتُ مِن","ها نَظرَةً أَو نَظرَتَينِ",101,"ن",1,0],["وَكانَ نَيل المَنايا لَو تُباحُ لَهُ","خَيراً لَهُ مِن حَياةٍ تُشمِتُ الشاني",102,"ن",2,0],["وَكأَنَّني وَكأَنَّها متودد","متلطف لظويلم متمادي",103,"د",2,0],["وَكَأنَّ نُوّارَ الثُّغُورِ مُقَبَّلاً","فِيها وَتُفّاحَ الْخُدُودِ مُعَضَّضَا",104,"ض",2,0],["وَكاَن نَداكَ حِينَ يَسِيرُ نَحْوِي","جَنِيباً لِلْمَوَدَّةِ وَالصَّفاءِ",105,"ا",2,0],["وَكَأَنَّنا بِذِمامِ سَيفِ الدينِ في","أحمى جَنابٍ في أَعَزِّ مَكانِ",106,"ن",1,0],["وَكَأَنَّنا بِالوَردِ يُرسَلُ رائِداً","قَد حُلَّ عَنهُ قباؤُهُ المَزرورُ",107,"ر",1,0],["وَكأنَّ نارَ الحبِّ في أرجائها","نارُ الخليلِ تلفعتْ بأياءِ",108,"ا",2,0],["وكأنَّ نقطَ مدامعي في نحرِها","بردٌ بمرآة جلوتُ زجاجها",109,"ج",3,0],["وَكأنّنا بِمنارة الخضراءِ قد","أَنِست مغاني الشعب من بوّانِ",110,"ن",1,0],["وَكأنّنا بِقصورها قَد شيّدت","وقَصيرها كخورنقِ النعمانِ",110,"ن",1,0],["وَكأنّني بكَ قد بَرَرت أليّتي","وَكَفيتني الإعدامَ والإقتارا",111,"ر",2,0],["وَكأَنَّني بِخِيامِهِمْ قَد قُوِّضَتْ","فَتَأَهَبَا لِلرِّحُلَتَيْنِ وَشَّمِّرِ",112,"ر",1,0],["وكأنّ نُورَ جَبينِه لعُيونِنا","كَرماً مَخيلةُ عارضٍ هَتّان",113,"ن",1,0],["وكأنّني بي قد بلَغْتُ بك المُنَى","وحصدْتُ بعضَ رجائيَ المَزروع",114,"ع",1,0],["وَكَأَنَّني بِيَدِ الدجى","في جَيبِهِ طَرَباً تَشَقِّق",115,"ق",1,0],["وكانَ نهارُ وَجهِكَ ذا مُنيراً","طَليقَ النُّورِ لَم يَحضُرهُ لَيلُ",116,"ل",1,0],["وكأنني إذ خفتُ بادرَ عُذره","علمتُه بمخافَتي أن يَغدرا",117,"ر",2,0],["وكأنني طفلٌ بمهدٍ نائمٌ","يزداد نوماً في الحداء ويطرب",118,"ب",1,0],["وكأنني الخنساء تندب صخرَها","هذي العلوم فأين من يتدرب",118,"ب",1,0],["وكأنَّني بهما حليفا فت