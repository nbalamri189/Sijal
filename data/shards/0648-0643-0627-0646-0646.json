25703.html","الكامل"],[437,"الحسن حيث المقلة الكحلاء","https://www.aldiwan.net/poem2578.html","الكامل"],[439,"اليوم أبهجت المنى إبهاجها","https://www.aldiwan.net/poem34909.html","الكامل"],[441,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[458,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[458,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[477,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[538,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[551,"ألا يا لقومي لاعتنان النوائب","https://www.aldiwan.net/poem47146.html","الطويل"],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"كنا جميعا ثم فرق بيننا","https://www.aldiwan.net/poem47225.html","الكامل"],[551,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[551,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[551,"إنا نعلل كلنا بمحال","https://www.aldiwan.net/poem47297.html","الكامل"],[551,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[551,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[551,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[551,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[551,"ضنت عليك ضنينة الخدر","https://www.aldiwan.net/poem47786.html","أحذ الكامل"],[551,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[551,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[551,"عادت إلي بغيضة فتوددت","https://www.aldiwan.net/poem48072.html","الكامل"],[562,"نفارقكم ونضرب في البلاد","https://www.aldiwan.net/poem52988.html","الوافر"],[567,"قفل الدجى وأتى الصباح حميدا","https://www.aldiwan.net/poem69716.html","الكامل"],[567,"ها قد كتبت فما رددت جوابي","https://www.aldiwan.net/poem69808.html","الكامل"]],"verses":[["وَكَأَنَّ نوراً مِنكَ عاقَ لِحاظَهُ","فَأَتاكَ لا يَرنو إِلى الغُدرانِ",0,"ن",1,0],["وَكَأَنَّني بِالهامِ قَد جُعِلَت","مِنهُم عَمائِمَ لِلقَنا اللُدنِ",1,"ن",1,0],["وَكَأَنَّنا في العَيشِ نَطلُبُ غايَةً","وَجَميعُنا يَدَعُ السِنينَ وَراءَ",2,"ا",2,0],["وكأنَّني مما تُسوِّلُهُ المُنى","والدّارُ نازِحةٌ إليها أنظُرُ",3,"ر",1,0],["وكأنني بِذَرا الإمامِ مُقَبِّلٌ","مِن سُدَّتَيْهِ مُعَرَّسَ العَلياءِ",4,"ا",2,0],["وَكَأَنَّنا لَم نَجتَمِع في بَلدَةٍ","وَكَأَنَّنا في خَلوَةٍ لَم نَلتَقِ",5,"ق",1,0],["وَكَأَنَّ نُسوَتَها الكَواعِبَ حَولَها","زُهرُ الكَواكِبِ حَولَ بَدرٍ أَزهَرِ",6,"ر",1,0],["وَكَأَنَّنا لَم نَجتَمِع في مَجلِسٍ","فيهِ الغِناءُ وَنَرجِسٌ وَبَهارُ",7,"ر",1,0],["وكأنّني لمّا سمِعْتُ بَديعَها","ورشَفْتُ منْها قَرْقَفا مَشْمولا",8,"ل",2,0],["وَكَأَنَّنِي عَاطِيْتُ كأْسَ مُدَامَةٍ","صَهْبَاءَ بَيْنَ مَثَالثٍ وَمَثَانِي",9,"ي",1,0],["وكأنّني بالصُّبحِ فيهِ عاطِساً","مِنْ بعْدِ ما هَبّ الهَواءُ البارِدُ",10,"د",1,0],["وكأنّ نورَ جَبينِ يوسُفَ نورُهُ","وكأنّ ديمَتَهُ المُلِثّةَ جودُهُ",11,"د",2,0],["وكأنّني مُذْ غابَ وجْهُكَ ذاهِبٌ","في اللّيلَةِ الظّلما بِلا مِصْباحِ",12,"ح",1,0],["وَكَأَنَّنا فَوقَ السَما","ءِ وَتَحتَنا ذاكَ السَديمُ",13,"م",1,0],["وَكانَ نَصراً مِنَ الرَحمَنِ قَدَّرَهُ","وَاللَهُ رَبُّكَ ذو مُلكٍ وَتَقديرِ",14,"ر",1,0],["وَكَأَنَّني رِئبالُ غابٍ ضَيغَمٍ","يَقرو الأَماعِزَ بِالفَجاجِ الأَفيَحِ",15,"ح",1,0],["وكأنني يا سيفَ دولة فتنةُ","بك وهو مفتخرٌ على القدَماء",16,"ا",2,0],["وكانَ نباتي قد ذوى عنه معشرٌ","فأحياه محيي النبت بالشمس والقطر",17,"ر",1,0],["وكان نهارُ المرء أهْدَى لسعيه","ولكنَّ ظلَّ الليل أنْدَى وأبردُ",18,"د",1,0],["وكأنني بي قائل","زرتُ الحيا فحبا وأمجدْ",19,"د",1,0],["وكأنني بهمُ لديك وإنّما","شمسُ النهارِ بهم هناك لديكا",20,"ك",2,0],["وكأنني بي شاكرٌ لك قائلٌ","لاقَيْتُ خيرَ مُنفّل تنفيلا",21,"ل",2,0],["وكأنني بك شاكرٌ لك قائلٌ","إنَّ الكريمَ يلين للتليين",22,"ن",1,0],["وَكَأَنَّنا كُنّا نُحَلِّقُ في الفَضا","صُعُداً لِنَلمِسَ مَنكِبَ الجَوزاءِ",23,"ا",2,0],["وَكَأَنَّنا وَالمَوتُ يَرتَعُ في","أَرواحِنا مَرعى وَمُستَمري",24,"ر",2,0],["وَكَأَنَّني العُصفورُ عَرّى جُسمُهُ","مِن ريشِهِ المُتَناسِقِ المُتَلَمِّعِ",25,"ع",1,0],["وَكَأَنَّنا رَهَطُ الكَواكِبِ في الفَضا","مَهما جَرى في الأَرضِ لا تَتَزَلزَلُ",26,"ل",1,0],["وَكَأَنَّ نُمرُقَتي فُوَيقَ مُوَلَّعٍ","يَرعى الدَكادِكَ مِن جَنوبِ قَطانا",27,"ن",2,1],["وكأنَّنا نمشي بأَقدامٍ","مجنَّحةٍ تَطيرْ",28,"ر",1,0],["وَكأَنَّني قَبّلتُ ثَغرَكِ وَالطلى","وَالوَجنَتَينِ وَنِلتُ مِنك مُرادي",29,"د",2,0],["وكان نصير الحق مذ كان يافعا","برغم الرزايا والرقيب المراصد",30,"د",1,0],["وكأن نفح الطيب حو","ل نضيدها أنفاس حور",31,"ر",1,0],["وَكانَ نَزيلُهُ بِالمَلكِ يُدعى","فَصارَ يُلَقَّبُ الكَنزَ الثَمينا",32,"ن",2,0],["وَكَأَنَّني بِكَ قَد أَتَيتَ بِعَرشِها","وَالسَيفُ أَسرَعُ هِبَةً مِن آصِفِ",33,"ف",1,0],["وَكانَ نُفَيعٌ إِذ هَجاني لِأُمِّهِ","كَباحِثَةٍ عَن مُديَةٍ تَستَثيرُها",34,"ر",3,0],["وكأنَّ نَشْرَ كُؤوسِها","شُكري لأحمدَ في المَحافِل",35,"ل",1,0],["وَكَأَنَّني بِكَ عَن قَري","بٍ رَهنَ حَتفٍ لَم يَفُت",36,"ت",1,0],["وَكَأَنَّني بِكَ بَينَهُم واهي القُوى","نِضواً تَقَلَّصُ بَينَهُم وَتَبَسَّطُ",37,"ط",1,0],["وَكَأَنَّني بِكَ بَينَهُم خَفِقَ الحَشا","بِالَموتِ في غَمَراتِهِ يَتَشَحَّطُ",37,"ط",1,0],["وَكَأَنَّني بِكَ في قَميصٍ مُدرَجاً","في رَيطَتَينِ مُلَفَّفٌ وَمُحَنَّطُ",37,"ط",1,0],["وَكَأَنَنَني بِالمَوتِ أَغفَ","لَ ما تَرى بِكَ قَد نَزَل",38,"ل",1,0],["وَكَأَنَّني مِمّا تَطاوَلَ بي","مِنكَ السَقامُ طُليتُ بِالوَرسِ",39,"س",1,0],["وَكَأَنَّني بِالمَوتِ قَد","دارَت رَحاهُ عَلى بَنيهِ",40,"ه",1,0],["وَكَأَنَّ نَرجِسَ رَوضِها","قَد صيغَ مِن وَرَقٍ وَعَينِ",41,"ن",1,0],["وكأنني طفلٌ بها وخواطري","أرجوحةٌ في لجّها المتلاطم",42,"م",1,0],["وكأنني مما يسوء خلي","وحياتيَ انجابت حوالكها",43,"ه",2,0],["وكأنني في شاطئ مهجور","قد فارقته سفينة لا ترجع",44,"ع",1,0],["وَكَأَنَّني بِالظاعِنينَ وَطِيَّةٌ","تَبكي لَها الأُلّافُ لِلأُلّافِ",45,"ف",1,0],["وَكَأَنَّني بِالشَدقَمِيَّةِ وَسطَهُ","خُضرُ اللُهى وَالوُظفِ وَالأَخفافِ",45,"ف",1,0],["وَكَأَنَّني أُسقى إِذا ذُكِرَت","صَفوَ المُدامِ عَلى رُقى السَحرِ",46,"ر",1,0],["وَكَأَنَّ نُطفَةَ بارِدٍ وَطَبَرذَداً","وَمُدامَةً قَد عُتِّقَت أَعصارا",47,"ر",2,0],["وَكانَ نِساءُ الحَيِّ مُذ كُنتِ بَينَهُم","مِلاحاً فَلَمّا غِبتِ صِرنَ قِباحا",48,"ح",2,1],["وَكانَ نَضيراً عَلى منكبيه","فَأَصبَح مِنهُ سَليباً خَضيب",49,"ب",1,0],["وَكَأَنَّني ضَلّلتُ سَيرَ مَنيتي","إِن الطَريق إِلى الفَناء معبّد",50,"د",1,0],["وَكَأَنَّ نَقعَهُما بِبُرقَةِ ثادِقٍ","وَلِوى الكَثيبِ سُرادِقٌ مَنشورُ",51,"ر",1,0],["وَكَأَنَّنا لَم نَغنَ بَينَ عِراصِها","في غَبطَةٍ وَكَأَنَّنا لَم نَحلُلِ",52,"ل",1,0],["وَكَأَنَّ نَشرَ الأَرضِ بِال","أَنوارِ حينَ تَلَحَّفا",53,"ف",2,0],["وَكانَ نَشيطاً فَلَمّا رَآ","هُ صاحِبَ هَمٍّ فَلَم يَنشَطِ",54,"ط",1,0],["وكأنّني بك قد هَزِجْتَ مُلبيّاً","وهَدَجْتَ بينَ شِعابِ مكّة والصَّفا",55,"ف",2,0],["وكأنّني بِلِواءِ نَصرِكَ خافِقاً","قد حامَ بينَ المَرْوَتَينِ ورفرَفا",55,"ف",2,0],["وكأنني بك قد بلغت مأربي","وقضيتُ من نُسكِ المُودِّع ما كفى",55,"ف",2,0],["وَكَأَنَّني بِكَ قَد أَتَتكَ مَنِيَّةٌ","لا شَكَّ أَنَّ سَبيلَها مَورودُ",56,"د",1,0],["وَكَأَنَّني بِكَ قَد شُغِفتَ بِحُسنِهِ","فَخَطَطتَهُ حِرصاً عَلَيهِ بِكَفِّكا",57,"ك",2,0],["وكانَ نكاحُهنَّ يراهُ حوباً","مخافةَ أن يناسلنَ الشرارا",58,"ر",2,0],["وَكَأَنَّني رَحِلٌ أَضَلَّ رُقادَهُ","عانٍ تُطيفُ بِهِ الهُمومُ جُنودا",59,"د",2,0],["وَكَأَنَّ نَكهَتَها إِذا نَبَّهتَها","طِفلٌ يَلوكُ بِدُردُرَيهِ سِخابا",60,"ب",2,1],["وَكَأَنَّني مِن حُبِّها","ظَأرٌ أَهابَ بِهِ مُهيب",61,"ب",1,0],["وكأنني ما كنت إلفَك في الصبا","يوماً ولا كنتَ الحياة مشاطري",62,"ر",2,0],["وكأَنَّني لمّا انْحَطَطْتُ به","أَرْمي الفَلاة بكَوْكَب طَلْقِ",63,"ق",1,1],["وكأَنَّني لمّا طَلَبْتُ به","وَحْش الفَلاةِ على مَطا بَرْقِ",63,"ق",1,0],["وكأَنَّ نَثْرَ النَّجْمِ ضَأْنٌ وسْطَهَا","وكأَنَّمَا الجَوْزاءُ راعِي ضانِهَا",64,"ن",3,0],["وكأَنَّنِي لمّا كَرُمْتُ وقد شَكَتْ","أَرْضِي الحوادِث غِبْتُ مِن حدثانِهَا",64,"ن",3,0],["وكأَنَّني فِيهِمْ لَقِي","طٌ قاد مِن أَحْياءِ دارِمْ",65,"م",1,0],["وكأَنَّنا فيها العفا","رِتُ والكُؤوسُ مِن الرّواجِمْ",65,"م",1,0],["وكأَنَّنا في رَمْيها","نَسْتَلُّ مِن بِيضِ الصّوارِمْ",65,"م",1,0],["وَكَأَنَّنِي بِكَ بَيْنَهُمْ مُتَرَفِّعاً","كَالْبَدْرِ بَيْنَ كَواكِبِ الخَضْراءِ",66,"ا",2,0],["وَكَأَنَّ نَابلْيُونَ فِي إِشْرَافِهِ","عَلَمٌ عَلَى عَلَمِ الزَّعامَةِ بَادِ",67,"د",1,0],["وَكَأَنَّ نَرْجِسَهُ بِمَرْ","أى مِنْهُمُ نَادٍ ونامِ",68,"م",1,0],["وَكَأَنَّنِي بِالقَبْرِ أَصْبَحَ مِنْبَراً","وَكَأَنَّنِي بِكَ مُوشِكٌ أَنْ تَهْتِفَا",69,"ف",2,0],["وَكَانَ نَجْدَةً دَاعيَةٍ بِلاَ مَهَلٍ","فِي نُصْرَةِ الحَقِّ هَانَ الأَمْرُ أَوْ صَعُبَا",70,"ب",2,0],["وَكَانَ نَوْءَ المُوَا","لِينَ رَحْمَةٌ وَسَخَاءَ",71,"ا",2,0],["وكأنني «بابن الوليد»، «وطارقٍ»","«وأبي عبيدة» يركبون خيولا",72,"ل",2,0],["وكأنني لما سمعت بديعها","ورشفت منها مرفقا مشمولا",73,"ل",2,0],["وكأنني بالصبح فيه غاطسا","من بعد ما هب الهواء البارد",74,"د",1,0],["وكأنني عاطيت كأس مدامة","صهباء بين مثالث ومثان",75,"ن",1,0],["وكأنني مذ غاب وجهك ذاهب","في الليلة الظلماء بلا مصباح",76,"ح",1,0],["وكأنني بشخوصهم في مَحضرٍ","دانٍ ، بعيدٍ ، سائغٍ ، ممنوع",77,"ع",1,0],["وكأنني بك إذ تقابلُ واحداً","منهم ، تريه غفلةَ المتغابي",78,"ب",2,0],["وكان نقياً فكرةً وعقيدةً","عزيزاً عليه ان تَسِفَّ العقائد",79,"د",1,0],["وكأنني فيما أُحاولُ ، هاربٌ","حَذِرٌ مخافةَ ان يَرَى إنسانا",80,"ن",2,0],["وَكأنّني بكَ قَد أتَيتَ بعَرْشِها،","وَالسّيفُ أسرَع هَيْبَةً مِنْ آصَفِ",81,"ف",1,0],["وكأنّني بك حين تهتف قائل","للزهر : إنّ الحسن غير مخلّد",82,"د",1,0],["وكأنّني بالصيد من أمرائها","يوم الحميّة أنكرت أحقادها",83,"د",3,0],["وكأنّني بالتاج ألّف شملها","نظما ولمّ نثيرها وبدادها",83,"د",3,0],["وكأنني بهمُ إليك وإنّما شمسُ","النهارِ بهم هناك لديكا",84,"ك",2,0],["وكأنّ نطفة َ باردٍ وطبرزداً","وَمُدَامَة ً قَدْ عُتِّقَتْ أَعْصارا",85,"ر",2,0],["وكأنني ما كنت إلفك في الصّبا","يوما ولا كنت في الحياة مشاطري",86,"ر",2,0],["وكَأنني لَمَّا مَرَرتُ بِدِمنَتَى","ذَاتِ الرُّبَى نَقِفتُ حَنَاظِلا",87,"ل",2,0],["وكأنني بك فوق غاربها","متسنِّما في ذِروة الفخرِ",88,"ر",1,0],["وكان ندا يوم عظيم ومشهد","به العلما قد أجمعوا وذوو الأمر",89,"ر",1,0],["وَكَأَنَّنا مِن فَرعِها في مَغرِبٍ","وَكَأَنَّنا مِن وَجهِها في مَشرِقِ",90,"ق",1,0],["وكأنّ نَمْلَ عِذَاره قد خاف أن","يَسْعَى به فيزلّ عن مرآته",91,"ت",2,0],["وَكَأَنَّ نَخلاً في مُطيَةٍ ثاوِياً","بِالكَمعِ بَينَ قَرارِها وَحَجاها",92,"ا",3,0],["وكأنني من صفرةٍ غسلينُه","وكأنني من دقَّةٍ زُنارُهُ",93,"ر",2,0],["وكان نقل مدامي","من ناهدات النهود",94,"د",1,0],["وكأنني أشكو لطي","فك جور حكمك في الغرام",95,"م",1,0],["وَكَأَنَّني في عَينِها لَهَبٌ","بِفُؤادِها الوَلهانِ مُتَّصِلُ",96,"ل",1,0],["وَكَأَنَّن مُقلَتَها سِرا","جٌ كاد يُطفيُ بِالزَفير",97,"ر",1,0],["وكأنّ نَرْجِسَه إذا استقبلتَه","يرنو بأجفانِ العيون الحُور",98,"ر",1,0],["وكأنّ نظم فُصولِه","دُرّ على سَبَج نَثِير",99,"ر",1,0],["وَكَأَنَّني مُتِّعتُ مِن","ها نَظرَةً أَو نَظرَتَينِ",100,"ن",1,0],["وَكانَ نَيل المَنايا لَو تُباحُ لَهُ","خَيراً لَهُ مِن حَياةٍ تُشمِتُ الشاني",101,"ن",2,0],["وَكأَنَّني وَكأَنَّها متودد","متلطف لظويلم متمادي",102,"ي",1,0],["وَكَأنَّ نُوّارَ الثُّغُورِ مُقَبَّلاً","فِيها وَتُفّاحَ الْخُدُودِ مُعَضَّضَا",103,"ض",2,0],["وَكاَن نَداكَ حِينَ يَسِيرُ نَحْوِي","جَنِيباً لِلْمَوَدَّةِ وَالصَّفاءِ",104,"ا",2,0],["وَكَأَنَّنا بِذِمامِ سَيفِ الدينِ في","أحمى جَنابٍ في أَعَزِّ مَكانِ",105,"ن",1,0],["وَكَأَنَّنا بِالوَردِ يُرسَلُ رائِداً","قَد حُلَّ عَنهُ قباؤُهُ المَزرورُ",106,"ر",1,0],["وَكأنَّ نارَ الحبِّ في أرجائها","نارُ الخليلِ تلفعتْ بأياءِ",107,"ا",2,0],["وكأنَّ نقطَ مدامعي في نحرِها","بردٌ بمرآة جلوتُ زجاجها",108,"ج",3,0],["وَكأنّنا بِمنارة الخضراءِ قد","أَنِست مغاني الشعب من بوّانِ",109,"ن",1,0],["وَكأنّنا بِقصورها قَد شيّدت","وقَصيرها كخورنقِ النعمانِ",109,"ن",1,0],["وَكأنّني بكَ قد بَرَرت أليّتي","وَكَفيتني الإعدامَ والإقتارا",110,"ر",2,0],["وَكأَنَّني بِخِيامِهِمْ قَد قُوِّضَتْ","فَتَأَهَبَا لِلرِّحُلَتَيْنِ وَشَّمِّرِ",111,"ر",1,0],["وكأنّ نُورَ جَبينِه لعُيونِنا","كَرماً مَخيلةُ عارضٍ هَتّان",112,"ن",1,0],["وكأنّني بي قد بلَغْتُ بك المُنَى","وحصدْتُ بعضَ رجائيَ المَزروع",113,"ع",1,0],["وَكَأَنَّني بِيَدِ الدجى","في جَيبِهِ طَرَباً تَشَقِّق",114,"ق",1,0],["وكانَ نهارُ وَجهِكَ ذا مُنيراً","طَليقَ النُّورِ لَم يَحضُرهُ لَيلُ",115,"ل",1,0],["وكأنني إذ خفتُ بادرَ عُذره","علمتُه بمخافَتي أن يَغدرا",116,"ر",2,0],["وكأنني طفلٌ بمهدٍ نائمٌ","يزداد نوماً في الحداء ويطرب",117,"ب",1,0],["وكأنني الخنساء تندب صخرَها","هذي العلوم فأين من يتدرب",117,"ب",1,0],["وكأنَّني بهما حليفا فتنةٍ","ثقلت على أوطاننا أكدارُها",118,"ر",3,0],["وكأنَّني إذا ذاكَ أو","لَجْتُ الضِّياءَ على الظَّلامِ",119,"م",1,0],["وكانَ نداه للعافين وصلاً","وكانَ على أعاديه وبالا",120,"ل",2,0],["وكان نادرَ الكلام","كأنه يبصر بين كل لفظتين",121,"ن",1,0],["وكأنّنا والقصرُ يجمعُ شملَنا","في الأفْقِ بين كواكبٍ وبُدورِ",122,"ر",1,0],["وَكأَنَّنا فرَحاً وَلَذَّةَ أَنْفُسٍ","نُسْقى بِعِلِّيِّيْنَ مِنْ تَسْنيمِ",123,"م",1,0],["وكأن نور الشمس في جنباته","شبكُ النضار تهزّها الأهواء",124,"ا",2,0],["وكَأَنَّنِي بِجَبِينِهِ فِي لُجَّةٍ","للحَرْبِ يَخْرِقُ بالقَنَا أَموَاجَهَا",125,"ج",3,0],["وكأنني بدح من الحزن الذي","أورثتني عن أمه مخلوع",126,"ع",1,0],["وكأنني فوق الرِّحالة خالعٌ","لعبت بأمّ عظامِهِ الخُرطومُ",127,"م",1,0],["وكان نوالُ أقوامٍ ضماناً","أسوَّفه وجودُ يديه نَقْدُ",128,"د",1,0],["وكأنَّني لمّا نشقتُ عبيرَهُ","أودعتُ أسرابَ الخياشمِ عنبرا",129,"ر",2,0],["وكأنني والأنفُ مِنِّي راعِفٌ","قَطَّارةٌ لِشَقائِقِ النُّعمانِ",130,"ن",1,0],["وكأنّني وَجْداً به وصبابةً","أنّي طمحتُ بناظِرَيَّ أراهُ",131,"ا",2,0],["وكأنّنا فيها نَحُزُّ جلودَنا","حَزَّ المُدى لحماً على أوضامِ",132,"م",1,0],["وكأنّني من بعد أنْ فارقتُه","كفٌّ يفارق ساعداً أو مِعصما",133,"م",2,0],["وكأنّني لمّا سمعتُ به","حيرانُ ممتلئٌ من الخَبْلِ",134,"ل",1,0],["وكأنّني لمّا لففتُ بهمْ","شملي اِمرؤٌ متقطّعُ الشَّمْلِ",135,"ل",1,0],["وكأنّنا نرعى القَواءَ من الطَّوى","أبداً ونكرع من ظماً في آلِ",136,"ل",1,0],["وكأنّنِي من بعد ثُكلك ذو يدٍ","جذّاءَ أو غصنٌ بلا أوراقِ",137,"ق",1,0],["وكأنّنِي من بعده ذو قفرةٍ","صَفِرَتْ إداوتُهُ كليلُ الأنيُقِ",138,"ق",1,0],["وكأنّنِي لمّا رجعتُ إلى النّوى","أبكي رَجعتُ بناظرٍ مطروفِ",139,"ف",1,0],["وكأنّني لمّا سمع","تُ نَعِيَّها مثلُ النَّزيفِ",140,"ف",1,0],["وكأنّنِي لمّا وطأتُ على","حرّ النّوى أمشي على جمرِ",141,"ر",1,0],["وَكأنَّني ضَوَّعتُ نَشرَ لَطيمةٍ","لمّا سننتُ مديحكمْ في النّادِي",142,"ي",1,0],["وكأنّني بالكُمْتِ تَرْدِي","في البسيطةِ بالكُماةِ",143,"ه",1,0],["وَكأنَّني لمّا أخذتُكِ كارهاً","قَسمي حُرمتُ وما أخذت نصيبا",144,"ب",2,0],["وَكان نَصيبُنا مِنكُم كَلاماً","قَطَعناهُ لِتشتَفِيَ الأَعادي",145,"د",2,0],["وكأنّ نرجِسَنَا ومضعَفَ وَرْدِنَا","سَلَبا الجواري أعيُناً وخُدُودَا",146,"د",2,0],["وكأنَّنَي بك قد كَتَبْتَ معذِّراً","فظلمتني بملامَةٍ وعِتابِ",147,"ب",1,0]]}