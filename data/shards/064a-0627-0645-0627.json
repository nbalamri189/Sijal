امل"],[435,"عيناك أمكنت الشيطان من خلدي","https://www.aldiwan.net/poem25312.html","البسيط"],[435,"عيناك أمكنت الشيطان من خلدي","https://www.aldiwan.net/poem25674.html","البسيط"],[438,"يا مانعي النوم بقطع الوصال","https://www.aldiwan.net/poem2583.html","السريع"],[438,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[440,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[442,"الموت في نفسي أغدو به وأجي","https://www.aldiwan.net/poem14360.html","البسيط"],[442,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[442,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[453,"عشقتني يا فاتني بالغنا","https://www.aldiwan.net/poem13871.html","السريع"],[453,"غيري يلذ له الهوى بهوان","https://www.aldiwan.net/poem13931.html","الكامل"],[453,"مر بنا ظبي حريري","https://www.aldiwan.net/poem13971.html","السريع"],[454,"نبئت أنك عن قرب ستسعدنا","https://www.aldiwan.net/poem61373.html","البسيط"],[454,"يا مالكا لا عن وراثة شامخ","https://www.aldiwan.net/poem61646.html","الكامل"],[459,"يا ماشيا بالعتب يحمل مره","https://www.aldiwan.net/poem56079.html","الكامل"],[459,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[465,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[465,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[465,"يا مانعي صفو الوصال","https://www.aldiwan.net/poem3455.html","عموديه"],[465,"يا مخجل القمر المنير","https://www.aldiwan.net/poem3502.html","عموديه"],[465,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[465,"رحلوا فشموسهم تجب","https://www.aldiwan.net/poem3622.html","عموديه"],[466,"لزوم ما لا يلزم من الوجع","https://www.aldiwan.net/poem61434.html","عموديه"],[480,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[483,"يا راميا قلبا جريح","https://www.aldiwan.net/poem24200.html","عموديه"],[483,"أشكو له منه مهجتي","https://www.aldiwan.net/poem24282.html","عموديه"],[483,"صلّ اللديغ أذاب قلب الراسخ","https://www.aldiwan.net/poem24339.html","عموديه"],[487,"يا مال والسيد المعمم","https://www.aldiwan.net/poem480.html",""],[501,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[501,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[514,"يا مانعا مقلتي من لذة الوسن","https://www.aldiwan.net/poem67699.html","البسيط"],[516,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[516,"يا مالك الرق ومن حقه","https://www.aldiwan.net/poem12168.html","السريع"],[516,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[530,"يا ناقدا لكلام ليس يفهه","https://www.aldiwan.net/poem37468.html","البسيط"],[552,"يا مالكا رقي بلا ثمن","https://www.aldiwan.net/poem47157.html","أحذ الكامل"],[552,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[552,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[554,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[559,"أصبحت أنا على مرادك","https://www.aldiwan.net/poem34271.html","مجزوء الدوبيت"],[559,"ظهرت لي يا غيب يا مطلق","https://www.aldiwan.net/poem34302.html","السريع"],[559,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[563,"عليك كل اعتمادي أيها الصمد","https://www.aldiwan.net/poem52823.html","البسيط"],[576,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[587,"يا مالك رق الصب بالله عليك","https://www.aldiwan.net/poem17638.html","مخلع الرمل"]],"verses":[["يا ماطِلي بِالدَينِ وَهوَ مُحَبَّبٌ","مَن لي بِدائِمِ وَعدِكَ الكَذّابِ",0,"ب",1,0],["يا ماطِلاً لي بِدُيونِ الهَوى","مَن دَلَّ عَينَيكَ عَلى قَلبي",1,"ب",2,0],["يا مالِكي بخِلالٍ","تُهْدي الى القلبِ حَيْرَةْ",2,"ه",1,1],["يا مالِئَ الكُرسِيِّ مِنهُ مَهابَةً","وَكِفايَةً يا مِلءَ عَينِ الناظِرِ",3,"ر",1,0],["يا مانِعاً مِن فَقرِ عاشِقِهِ","زَكَواتِ حُسنٍ أَنتَ عَنهُ غَني",4,"ن",2,0],["يا مالِكاً مِن بَعدِ فَقدي وَجهَهُ","جارَ الزَمانُ عَلَيَّ بَعدَكَ وَاِعتَدى",5,"د",2,0],["يا ماءَ مُزنٍ يا شِها","بَ دُجُنَّةٍ يا لَيثَ غيل",6,"ل",1,0],["يَا مَائِساً عَنْ غَض بَانِ","أَعْيَتْ مَحَاسِنُهُ بَيَانِي",7,"ن",2,1],["يا مالِ إِحدى صُروفِ الدَهرِ قَد طَرَقَت","يا مالِ ما أَنتُمُ عَنها بِنُزّاحِ",8,"ح",1,1],["يا مالِ جاءَت حِياضَ المَوتِ وارِدَةً","مِن بَينِ غَمرٍ فَخُضناهُ وَضَحضاحِ",8,"ح",1,0],["يا مانحي منناً من بعدها مننٌ","كالماءِ يتبعُ مسكوباً بمسكوب",9,"ب",1,0],["يا مانحي غرر اللهى متبسِّماً","والعام مغبرّ الأسرَّة كالح",10,"ح",1,0],["يا مالكاً أشرقت أيامه وزَهت","رياضها فتجلى النورُ والنور",11,"ر",1,0],["يا مالكَ الرّقّ بالعطاء لقد","ملكت رقّي ورقّ أحرار",12,"ر",1,1],["يا ماجداً نال من حمدٍ ومن شرف","ما لم تنل آل حمدان ولم تحز",13,"ز",1,0],["يا ماجداً لا يزال من كرمٍ","في بابِهِ القاصدون تستبق",14,"ق",1,1],["يا ماجداً أحيى مآثر قومه","بمحامدٍ أرخصن نشر غوالي",15,"ل",2,0],["يا ماليَ البيت بيت الشعر من مدحٍ","وكانَ أقفرَ بالوعساء من طلل",16,"ل",1,0],["يا مانحي غرر المواهب سبّقاً","من قبل ما سبقت له آمالي",17,"ل",2,0],["يا مانحي منناً من بعدها مننٌ","ما شأنها منك لا عيٌّ ولا سأمُ",18,"م",1,0],["يا مالكاً لا يخيب زائره","دعوة ضيف منقّح النظم",19,"م",1,1],["يا مانع الثغر وحقّ الهوى","إني لمشتاقٌ إلى اللّثم",20,"م",1,0],["يا ماجداً فاز بادينا وحاضرنا","به وأنجح قاصينا ودانينا",21,"ن",2,0],["يا ماجداً ما ظننت همته","تفعل ما المكرمات تأباه",22,"ه",1,1],["يا مادحَ الحقدِ محتالاً له شَبهاً","لقد سلكتَ إليه مسلكاً وَعِثا",23,"ث",2,1],["يا مادحَ القوم اللئا","م وطالباً نيل الشِّحاحِ",24,"ح",1,0],["يا مانِعي قُوتَ جسْمِي","ومانعي قَوتَ رُوحي",25,"ح",2,1],["يا مانعينا من هداياكُمُ","ثناؤنا من عطركم أعطر",26,"ر",1,0],["يا مادح الورد لا ينفك عن غَلطِهْ","ألستَ تُبصرهُ في كفِّ ملتقطِهْ",27,"ط",2,0],["يا مالكاً قلبي وتعذيبه","مهلاً فما ملكت إقلاعه",28,"ع",2,0],["يا مانعي باليأسِ مِنْ","إحسانهِ روحَ التمنِّي",29,"ن",2,1],["يامالِكي بِجودِهِ","غَلِطتُ بَل يامُعتِقي",30,"ق",2,0],["يامانِعاً حُلوَ الرِضا","وَباذِلاً مُرَّ السَخَط",31,"ط",1,0],["يام ام كلثوم يقنو الشعب فيك هوى","من ذا الى امة تهواك القاك",32,"ك",1,0],["يا ماء اهلي اين انت","فانني اشكوا اللهابا",33,"ب",2,0],["يا ماء اهلي اين انت","فانني اشكو الاوارا",34,"ر",2,0],["يا مالكا أمر هذي الناس في يده","فابيضّ ليلك واسودّت ليالينا",35,"ن",2,0],["يا مالكين الفؤاد رفقا","يا مالكين العنان مهلا",36,"ل",2,0],["يا مالكي بجميله","وجماله روحي فداك",37,"ك",1,0],["يا مَأتَماً مِن عَبدِ شَمسٍ مِثلُهُ","لِلشَمسِ يُصنَعُ في المَماتِ وَيُنسَقُ",38,"ق",1,0],["يا مانِحَ السودانِ شَرخَ شَبابِهِ","وَوَلِيَّهُ في السِلمِ وَالهَيجاءِ",39,"ا",2,0],["يا مالِكاً رِقَّ الرِقابِ بِبَأسِهِ","هَلّا اِتَّخَذتَ إِلى القُلوبِ سَبيلا",40,"ل",2,0],["يا ما أَقَلَّ مُلكَها","وَما أَجَلَّ خَطَرَه",41,"ر",2,0],["يا ماءُ هَل حَسَدتَنا مَعِنَهُ","أَمِ اِشتَهَيتَ أَن تُرى قَرينَهُ",42,"ن",2,0],["يا مالكَ الدُّنيا الذي بشبيههِ","عقُم الزمانُ وضنَّتِ الأدوارُ",43,"ر",1,0],["يا مالِكَ اِبنَ المالِكِيّينَ الأُلى","ما لِلمَكارِمِ عَنهُمُ مِن مَذهَبِ",44,"ب",1,0],["يا مادِحَ الفَتحِ وَيا آمِلَهُ","لَستَ اِمرَأً خابَ وَلا مُثنٍ كَذَب",45,"ب",1,0],["يَإِمامَ الهُدى وَيا صاحِبَ الحَق","قِ وَيا اِبنَ الرَشيدِ وَالمَهدِيِّ",46,"ي",1,0],["يا مالِ هَل لَكَ في أَسيرٍ قَد أَتَت","تِسعونَ فَوقَ يَدَيهِ غَيرَ قَليلِ",47,"ل",1,0],["يا مالِ هَل أَنا مُهلِكي ما لَم أَقُل","وَلِيُعرَفَنَّ مِنَ القَصائِدَ قيلي",47,"ل",2,0],["يا ماجِداً ما دَعَتهُ في نَدىً وَرَدىً","بَنو المَطالِبِ إِلّا جالَ أَو جادا",48,"د",2,0],["يا مانِحي مَحضَ الوُعودِ وَمانِعي","حِفظَ العُهودِ وَمُجتَنى مَعروفِهِ",49,"ه",1,1],["يا مالِكاً أَصبَحَ لي صارِماً","أُعِدُّهُ يَومَ الوَغى لِلضِراب",50,"ب",1,0],["يا مالِكَ العَصرِ وَمَن","لِجودِهِ الغَيثُ حَسَد",51,"د",1,1],["يا مالِكي إِنّي عَلَيكَ مُتَيَّمٌ","يا صَخرُ إِنّي فيكَ كَالخَنساءِ",52,"ا",2,0],["يا مالِكاً بِصَنيعِهِ","حازَ المَعاني وَالمَعالي",53,"ل",2,0],["يا مالِكاً دانَتِ المُلوكُ لَهُ","وَاِتَّبَعَت في اِعِتِمادِها سُنَنَه",54,"ن",2,0],["يا مالِكاً أَضحَتِ الدُنيا تَتيهُ بِهِ","وَالصَومُ وَالفِطرُ وَالأَعيادُ تَفتَخِرُ",55,"ر",1,0],["يا مالكَ الأرض الّذي أضحى له","مَلِكُ السماءِ على العداة 