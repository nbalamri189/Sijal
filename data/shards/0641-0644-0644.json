 طلل نائي المزار بعيده","https://www.poetsgate.com/ViewPoem.aspx?id=33818",""],[77,"ودير أنخنا في قراراته العيسا","https://www.poetsgate.com/ViewPoem.aspx?id=34190",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[9,"فِدًى لَبنى ذُهلِ بنِ شَيبانَ ناقَتي","https://www.poetsgate.com/ViewPoem.aspx?id=20023",""],[45,"هَجَاني النّغيلُ، وَما خِلْتُني","https://www.poetsgate.com/ViewPoem.aspx?id=31797",""],[45,"تعست، فما لي من وفاء ولا عهد","https://www.poetsgate.com/ViewPoem.aspx?id=31384",""],[80,"فؤادِي نجيبٌ والجلالُ نجيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=3009",""],[91,"الحجر الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=53425",""],[51,"بكيتَ فلم تترك لعيْنِكَ مدمعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29517",""],[53,"رضينا الظبي من عناق الظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9813&r=&rc=10",""],[3,"لأَيِّ حَبيبٍ يَحْسُنُ الرَّأْيُ والوُدُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10678&r=&rc=32",""]],"verses":[["فَلِلَّهِ عَزمِيَ لَو أَنَّهُ","عَلى قَدرِ عَزمِيَ سُلطانِيَه",0,"ي",2,0],["فَلِلعِزِّ ما أَدنى لِياني مِنَ القَنا","وَأَكرَهَ رُمحي في صُدورِ الفَيالِقِ",1,"ق",1,0],["فَلِلَّهِ مَن غَنّى الحُداةُ وَراءَهُ","وَلِلَّهِ ما وارى العَبيطُ المُسَجَّفُ",2,"ف",1,0],["فَلِلَّهِ ما أَقسى ضَمائِرَ قَومِنا","لَقَد جاوَزوا حَدَّ العُقوقِ وَأَسرَفوا",2,"ف",3,0],["فَلِلَّهِ ما جَمَعَ المَأزَما","نِ وَجَمعٌ لِقَلبِيَ وَالمَسجِدُ",3,"د",1,0],["فَلِلَّهِ نورٌ في مُحَيّاكَ إِنَّهُ","يُمَزِّقُ جِلباباً مِنَ اللَيلِ أَربَدا",4,"د",2,0],["فَلِلَّهِ دَرّي يَومَ أَنعَتُ قَولَةً","لَها في رُؤوسِ السامِعينَ دَبيبُ",5,"ب",1,0],["فَلِلَّهِ كاسٌ صَرَعتُ الهُمو","مَ بِسَورَتِها وَعَقَرتُ الأَسى",6,"ا",1,0],["فَلِلحَلْيِ لا عَزَّ الدَنانيرُ رَنَّةٌ","وَلِلمسكِ لا عاشَ الظِباءُ أَريجُ",7,"ج",1,0],["فَلِلْبانَةِ الغَنَّاءِ ظِلٌّ أَلفتُهُ","فَلا يَنزَوي عَنّي وَلا يَتَقَلَّصُ",8,"ص",1,0],["فَلَلْمَوْتُ خَيْرٌ لِلْفَتى مِنْ ضَراعَةٍ","تَرُدُّ إِلَيْهِ الطَّرْفَ وَهْوَ كَلِيلُ",9,"ل",1,0],["فَلْلِعُلا قُحَمٌ يَغْشَى مَصاعِبَها","ثَبْتُ المَقارمِ في أَسْيافِهِ قَلَقُ",10,"ق",1,0],["فَلِلْأَمَدِ الأَدْنى سَمَتْ بِكَ هِمَّةٌ","وَلي هِمَّةٌ تَسْمو إِلى الغايَةِ القُصْوى",11,"و",2,0],["فَلِلْوَجْدِ قَلْبِي وَالمَدامِعُ لِلْبُكا","إِذا لاحَ بَرْقٌ أَوْ تَنَفَّسَ رِيحُ",12,"ح",1,0],["فللّهِ مَرْأىً بالعَقيقِ ومَسْمَعٌ","عشيّةَ مرّتْ بالحِمى أُخْتُ مُدْلِجِ",13,"ج",1,0],["فَللهِ دَرّي حينَ تُوقِظُ هِمّتي","مُساوَرَةُ الأشْجانِ والنّجْمُ ناعِسُ",14,"س",1,0],["فلِلّهِ مَيْمونُ النّقيبَةِ إن غَزا","أراحَ إليهِ مالَهُ كلُّ مُعْزِبِ",15,"ب",1,0],["فللهِ ما يَطْوي عليهِ ضُلوعَهُ","رَمِيٌّ بِذِكْرِ الغانِياتِ مُكَلَّفُ",16,"ف",1,0],["فللهِ مَجْدٌ أعْجَزَ النّجْمَ شأوُهُ","أحَلَّكَ أعْلى ذِرْوَةٍ وسَنامِ",17,"م",1,0],["فلِلْحُداةِ على أرجاءِ مَنهَلِهِ","بما تَحمّلْنَ منْ مَدْحي أغاريدُ",18,"د",1,0],["فلِلّهِ حَيُّ مِنْ كِنانَةَ أرْقَلوا","إِلى رُتَبٍ لا تُمتَطى هَضَباتُها",19,"ت",3,0],["فللّهِ قَوْمٌ بالعُذَيْبِ إليهِمُ","نَضَوْتُ مِراحَ الرَّازِحاتِ اللَّواغِبِ",20,"ب",1,0],["فللّهِ حُزْوى حينَ أيقَظَ رَوْضَها","رَشاشُ الحَيا والنَّجْمُ في الأفْقِ وَسْنانُ",21,"ن",1,0],["فَلِلَّهِ قَلبٌ لا يَبُلُّ غَليلَهُ","وِصالٌ وَلا يُلهيهِ مِن حَلِّهِ عَقدُ",22,"د",1,0],["فَلِلَّهِ دَرُّ العارِفِ النَدبِ إِنَّهُ","تَفيضُ لِفَرطِ الوَجدِ أَجفانُهُ دَما",23,"م",2,0],["فَلِلّهِ منْ ضَيْفٍ حَميدٍ مُقامُهُ","لدَيْنا فلَوْ طالَ المُقامُ لَما مُلاّ",24,"ل",2,0],["فلِلّهِ منْ يَومٍ أغَرَّ مُحجَّلٍ","لحِزْبِ الهُدى قِدْماً إليْهِ تشوُّفُ",25,"ف",1,0],["فَلِلّهِ عَيْنا مَنْ رَآنا ولِلْحَيا","حَبِيٌّ بآفَاقِ البَشاشَةِ أوْمَضا",26,"ض",2,0],["فَلِلشَّرِيعةِ مِنْهَا الْعِلْمُ إِنْ سئلت","عما به عملت فيما به علمت",27,"ت",1,0],["فَلِلَّهِ دَرُّ الْقَوْمِ فِيهَا وَقَدْ غَدَوْا","ضُيُوفاً بِمَثْوَى سَيِّدِ الْعُرْبِ والْعُجْمِ",28,"م",1,0],["فَلِلَّهِ مِنْهَا لَيْلَةٌ بَرَكَاتُهَا","سَحَائِبُهَا تَنْهَلُّ بِالنِّعَمِ الْعُمِّ",28,"م",1,0],["فَلِلَّهِ عَيْناً مَنْ رَآهَا صَوَافِناً","أَفَاضَ عَلَيْهَا الْقَارُ سُحْمَ جِلاَلِهِ",29,"ل",2,0],["فللّهِ ما أعْزَزْتَ منْ مِلّةِ الهُدى","وللّهِ ما أذْلَلْتَ منْ مِلّةِ الكُفْرِ",30,"ر",1,0],["فلِلقُلوبِ من الغَمّاء مُنْصَرفٌ","بِما تقدّمَ في بَدْرٍ وفي أحُدِ",31,"د",1,0],["فلِلنّاسِ في يومِ العَطاءِ هِباتُهُ","وللّهِ في اللّيلِ الطّويلِ هُجودُهُ",32,"د",2,0],["فَلَلنَأيُ خَيرٌ مِن دُنُوٍّ عَلى الأَذى","وَلا خَيرَ فيما يَستَقِلُّ المَعاتِبُ",33,"ب",1,0],["فَلِلَّهِ عَينا مَن رَأى مِن عِصابَةٍ","أَشَدَّ عَلى أَيدي السُقاةِ مِنَ الَّتي",34,"ت",2,0],["فَلِلَّهِ ما أَحلاكِ في أَنمُلِ البِلى","وَإِن كُنتِ أَحلى في الطُروسِ وَأَكرَما",35,"م",2,0],["فللسَّقِيفَةِ يومٌ أنتَ صاحِبُه","فيه الخِلافةُ قد شِيدَتْ أواسيها",36,"ي",3,0],["فَلِلَّهِ ما أَبهاكَ في مِصرَ حالِياً","وَلِلَّهِ ما أَتقاكَ في البَيتِ مُحرِما",37,"م",2,0],["فَلِلعَواذِلِ مِنّي حَظُّ شيعَتِهِ","يَومَ الوَليمَةِ لا يُلوي عَلى أَحَدِ",38,"د",1,0],["فَلِلَّهِ أَيّامي وَغُصنُ الصِبا بِها","وَريقٌ وَإِذ وَجهُ الزَمانِ صَقيلُ",39,"ل",1,0],["فَلِلعانِكِ المُرتَجِّ ماحازَ مِئزَرٌ","وَلِلغُصُنِ المُهتَزِّ ماضَمَّ مِطرَفُ",40,"ف",1,0],["فَلِلساقِ أُلهوبٌ وَلِلسَوطِ دُرَّةٌ","وَلِلزَجرِ مِنهُ وَقعُ أَهوَجَ مُتعَبِ",41,"ب",1,0],["فَلِلَّهِ عَينا مَن رَأى مِن عِصابَةٍ","تُناضِلُ عَن أَحسابِ قَومٍ نِضالَها",42,"ل",3,0],["فَلِلأَمْرِ عَاقَ الْمُهَيْمِنُ حَقّاً","عَنْ قَضَاءٍ وَمَطْلَباً عَنْ تَمَامِ",43,"م",1,0],["فَلِلَّهِ شَعباً طَيَّةٍ صَدَّعا العَصا","هِيَ اليَومَ شَتّى وَهيَ أَمسِ جَميعُ",44,"ع",1,0],["فللسحّاب عبرا","تضحك لها الأزهار",45,"ر",1,0],["فللدين والدنيا ابتهاجٌ وغبطة","وللثغر ثغرٌ بالمنى يُتَرَشَّفُ",46,"ف",1,0],["فللمجد وجه طليق بها","وللسعد ثغر بها أشنب",47,"ب",1,0],["فللشرّ ما صخب الصاخبو","ن وللخير جمعك هذي الكتب",48,"ب",1,0],["فللحسام صليل يرتمي شرراً","مفتِّقاً إذن مَن في إذنه صمم",49,"م",1,0],["فللنجم بعدٌ دون ما أنا ناشد","وللدُرّ قدر دون ما أنا مُنشِد",50,"د",1,0],["فللّه نار قد بردت بحرّها","وإن سال منها دمعنا بالجوي سخنا",51,"ن",2,0],["فللّه ما قد هجِنَ لي من صبابة","ألفت بها طيّ الضلوع على الجمر",52,"ر",