{"poems":[[65,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[59,"إذا أصبحت عندي قوت يومي","https://www.aldiwan.net/poem24702.html","الوافر"],[59,"خبت نار نفسي باشتعال مفارقي","https://www.aldiwan.net/poem24732.html","الطويل"],[79,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[37,"تظل ابنة الضمري في ظل نعمة","https://www.aldiwan.net/poem39160.html","الطويل"],[32,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[29,"يعافي الله بعد بلاء سوء","https://www.aldiwan.net/poem6013.html","الوافر"],[72,"ألا أيها الناء","https://www.aldiwan.net/poem42974.html","الهزج"],[12,"إذا أصبحت بين جبال قوو","https://www.aldiwan.net/poem1227.html",""],[47,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[47,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[47,"أمير المؤمنين لقد سكنا","https://www.aldiwan.net/poem66797.html","البسيط"],[30,"أرى ابن سليم ليس تنهض خيله","https://www.aldiwan.net/poem5438.html","الطويل"],[51,"لكم فجع الدهر من والد","https://www.aldiwan.net/poem62064.html","المتقارب"],[68,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[83,"فوق سهامك إن الله يهديها","https://www.aldiwan.net/poem61441.html","البسيط"],[77,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[50,"شجاني وأبلاني تذكر من أهوى","https://www.aldiwan.net/poem10420.html","الطويل"],[52,"عدمتك عاجلا يا قلب قلبا","https://www.aldiwan.net/poem64866.html","الوافر"],[48,"إذا اصفر الفتى لفراق روح","https://www.aldiwan.net/poem22342.html","الوافر"],[48,"إسمع مقالة ذي لب وتجربة","https://www.aldiwan.net/poem23349.html","البسيط"],[48,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[78,"سيوف يقيل الموت تحت ظباتها","https://www.aldiwan.net/poem39491.html","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/2896","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[79,"بحيث القباب البيض والأسل السمر","https://www.poetsgate.com/ViewPoem.aspx?id=34138",""],[92,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[47,"أَميرَ المُؤْمنين لَقَدْ سَكَنَّا","https://www.poetsgate.com/ViewPoem.aspx?id=31844",""],[37,"تظلُّ ابنة ُ الضَّمريِّ في ظلِّ نعمة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22010",""],[53,"أمسى الشبابُ رداءً عنك مستلبا","https://www.poetsgate.com/ViewPoem.aspx?id=27201",""],[59,"خبتْ نارُ نفسي بِاشْتِعالِ مَفَارِقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14210&r=&rc=6",""],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[240,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[280,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[302,"إذا أصبحت ذا طرب ولهو","https://www.aldiwan.net/poem33296.html","الوافر"],[303,"إذا أصبح الجزار للسرب راعيا","https://www.aldiwan.net/poem36836.html","الطويل"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[409,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[466,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[466,"اذا اصطبخت ألفاظه فارج خيره","https://www.aldiwan.net/poem15583.html","الطويل"],[466,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[469,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[515,"لا تتعرض لنا فإن لنا","https://www.aldiwan.net/poem1587.html",""],[519,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[520,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[567,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[615,"","https://poetry.dctabudhabi.ae/diwan/poem/34542","المجتث"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122592","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77594","الرجز"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96373","الوافر"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96355","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138067",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109071","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18416","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122089","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21671","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49606","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102158","البسيط"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10489","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106847","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45705","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65986","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58276","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115545","الهزج"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100834","الوافر"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99350","الوافر"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99380","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62845","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62793","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45776","الطويل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32790","السريع"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125816","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101380","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28726","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72454","السريع"],[4755,"سَقَطْنَا لِأَنَّ الأَرضَ أَعلَى مِن الفَضَا","https://www.poetsgate.com/ViewPoem.aspx?id=183779",""],[4755,"بلادٌ بلا رَأسٍ.. وشَعبٌ \"مُسَارِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=184099",""],[4927,"الْحُبُّ وَ الْوُشَاْة","https://www.poetsgate.com/ViewPoem.aspx?id=29735",""],[5057,"لا عيد للحب","https://www.poetsgate.com/ViewPoem.aspx?id=197181",""],[3591,"إذا ما أنشدت أهلي دمائي","https://www.poetsgate.com/ViewPoem.aspx?id=149383",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[6102,"مَرارَةُ الحَقِيقَة","https://www.poetsgate.com/ViewPoem.aspx?id=182766",""]],"verses":[["إذا أصْغَرَتْ أو أكْبَرَتْ في حَنينِها","ظَلِلْتُ على آثارِهِنَّ مُغرِّدا",0,"د",2,0],["إِذا أَصبَحتُ عِندي قوتُ يَومي","فَخَلِّ الهَمَّ عَنّي يا سَعيدُ",1,"د",1,1],["إِذا اِصفَرَّ لَونُ المَرءِ وَاِبيَضَّ شَعرُهُ","تَنَغَّصَ مِن أَيّامِهِ مُستَطابُها",2,"ب",3,0],["إذَا أَصْبَحَتْ خَيْلِي الْبُيوتَ مُغِيرةً","وَفِي كُلِّ شِعْبٍ مِقْنَبٌ وَرَعِيلُ",3,"ل",1,0],["إِذا أَصبَحَت في الجِلسِ في أَهلِ قَريَةٍ","وَأَصبَحَ أَهلي بَينَ شَطبٍ فَبَدبَدِ",4,"د",1,0],["إِذا اِصطَكَّتِ الإِلباسُ فَرَّقتَ بَينَها","بِعَدلٍ وَلَم تَقحَز عَلَيكَ المَصادِرُ",5,"ر",1,0],["إِذا أَصبَحتُ في جَدَثٍ مُقيماً","فَكَم قَد غاظَهُ الجَدَثُ المُقيمُ",6,"م",1,0],["إِذا أَصبَحتَ في عُسرٍ","فَلا تَحزَن لَهُ وَاِفرَح",7,"ح",1,0],["إِذا أَصبَحتُ بَينَ جِبالِ قَوٍّ","وَبيضانِ القُرى لَم تَحذَريني",8,"ن",2,1],["إِذا أَصبَحَ الحَوذانُ في جَنَباتِها","يُفَتَّحُ وُهِّمتَ الدَنانيرَ تُضرَبُ",9,"ب",1,0],["إِذا اِصطَحَبَت آلاؤُهُ غَطَّتِ الرُبى","وَحُسنُ اللَآلي زائِدٌ في اِصطِحابِها",10,"ب",3,0],["إِذا أَصحابُهُ اِصطَبَحوا بِلَيلٍ","أَطالوا الخَوضَ في خَلقِ القُرانِ",11,"ن",1,0],["إِذا أَصبَحَت أُمُّ المَنايا مُقيمَةً","بِمُعتَرَكٍ زَلجٍ أَزالَ زَوالَها",12,"ل",3,0],["إِذا أَصبَحوا أَصبَحوا كَالأُسو","دِ باتَت مُجَوَّعَةً حارِدَه",13,"د",2,0],["إِذا أَصابَ لُجَينُ الماءِ عَسجَدَها","أَرتَكَ دُرّاً يُزيكَ الدُرِّ مُحتَلَبا",14,"ب",2,0],["إِذا أَصابَت لَدى المَرمى النِبالُ فَما","تُعزى إِصابَتُها إِلّا لِراميها",15,"ي",3,0],["إذا أصْلدوا أورى وإن عجِلوا ارتأى","وإن بخِلوا أعطى وإن غَدروا أوفى",16,"ف",2,0],["إِذا أَصبَحَت أَهدَت إِلى الشَمسِ سَجدَةً","وَتَسجُدُ أُخرى حينَ تَسجُدُ لِلمَسرى",17,"ا",1,0],["إِذا أَصبَحتَ صَبَّحَكَ التَصابي","وَأَطرابٌ تُصَبُّ عَلَيكَ صَبّا",18,"ب",2,0],["إِذا اِصفَرَّ الفَتى لِفُراقِ روحٍ","فَأَهوِن بِالتَصَعلُكِ وَالشُحوبِ",19,"ب",1,1],["إِذا أَصابَ الفَتى خَطبٌ يَضِرُّ بِهِ","فَلا يَظَنُّ جَهولٌ أَنَّهُ ظُلِما",20,"م",2,0],["إِذا أَصحابُ دينٍ أَحكَموهُ","أَذالوا ما سِواهُ وَعَيّبوهُ",21,"ب",3,0],["إذَا اصْطفَّتِ الرَّاياتُ حُمْراً مُتُونُهَا","ذَوَائِبُها تَهْفُو فَيَهْفُو لَها القَلْبُ",22,"ب",1,0],["إِذا اصطَحَبَ الأَقوامُ كانَ أَذَلُّهُم","لِأَصحابِهِ نَفساً أَبَرَّ وَأَفضَلا",23,"ل",2,0],["إِذَا اصطَنَع اللّهُ أمْرأً جَلّ سَعْيُهُ","وَعَمَّتْ أيَادِيِه وطَابَتْ نَقَائِبُه",24,"ب",2,0],["إذا اصطنبوا أقواسهم وتمنطقوا","فتبصر جيش الترك جاشت به مصر",25,"ر",1,0],["إذا أصحرتْ للخطب كان شبابُها","حصوناً منيعاتٍ لها وقلاعا",26,"ع",2,0],["إِذا أَصْحَابُهُ اصْطَبَحُوا بِلَيْلٍ","أَطَالُوا الحَوْضَ فِي خَلْقِ القُرَانِ",27,"ن",1,0],["إذا أصبحتْ في المجلسِ في أهل قرية","ٍ وأصبحَ أهلي بين شطبٍ فبدبدِ",28,"د",1,0],["إذا أصحبُ الدهرَ مغتراً بصحبته","إذا أعارَ متَاعَاً خِلْتُهُ وهَبَا",29,"ب",2,0],["إذا اصفرَّ لونُ المرءِ وابيضَّ شعرُهُ","تنغص من أيامه مستَطَبابُها",30,"ب",3,0],["إذا أصبح الموتُ حتماً فلا","تَخَفْه دنا وقُتُه أو نأى",31,"ا",1,0],["إِذا أَصبَحَت أَرضَ العَدُوِّ لِغارَةٍ","أَقامَت مَعَ الإِمساءِ سوقَ المَآتِمِ",32,"م",1,0],["إذا أصْدَرَتْ غُبْرُ السّباسِبِ وافِداً","لَها أوْرَدَتْ شرْواه خُضْرُ الغَوارِبِ",33,"ب",1,0],["إِذا أَصبَحتَ ذا طَرَبٍ وَلَهوٍ","تُعاقرُ راحةً أَو شرب راحِ",34,"ح",1,1],["إذا أصبح الجزّارُ للسِربِ راعياً","ففي كلِّ يومٍ منه شِلْوٌ ممزقُ",35,"ق",1,1],["إِذا أَصَبتَ بِسَهمٍ قَد رَمَيتَ بِهِ","وَما اِعتَمَدتَ فَذاكَ السَهمُ لَم يُصِبِ",36,"ب",1,0],["إذا أصبحت أو أمسيت","لا تنظر إلى الآت",37,"ت",1,0],["إذا اصطفيت صاحباً","أنشبت فيه مخلبك",38,"ك",1,0],["إذا أصابا وطراً من العلا","فذاك أو فيبلغان العُذُرا",39,"ر",2,0],["إذا أصاب فرصةً لعزمه","صمَّمَ لا يسوّفُ اليومَ بغدْ",40,"د",1,0],["إِذا أصبحت مني سجايا مُهَذَّبٍ","غَدا أملي ذا وقفةٍ وحِرانِ",41,"ن",1,0],["اذا اصْطبختْ ألفاظُه فارْجُ خيرَه","فإنَّ سَحوح الغيث يقدُمه الرَّعْدُ",42,"د",1,1],["إذا أصْرَدتهُ نسمةٌ شَمْألِيَّةٌ","تأجَّج عن وقْدٍ من الهمِّ مُشعَل",43,"ل",1,0],["إذا أصدفوا نيلا فلا سمح الحيا","وان سفروا ليلاً فلا طلعت يُوح",44,"ح",1,0],["إذا أصابت بنظرةٍ أحَداً","فما له عن حياته غرض",45,"ض",1,0],["إذا أصابَ غُبارُ الكُحْلِ مُقلتَها","تكادُ ترقُصُ من أهدابِها العُضُبُ",46,"ب",1,0],["إذا أصلحتها فسدت كأني","أهيب بها إلى نغل الإهاب",47,"ب",1,0],["إذا أصبحَتْ دُهْمُ الأمورِ مريضةً","شَفاها بإذنِ اللهِ حينَ يَعودُها",48,"د",3,0],["إذا أصبحت مقترنا حلالا","عرفت الطهر ن شرف الصبايا",49,"ا",3,0],["إِذا اِصطَبَحتُ ثَلاثاً","وَكانَ عودي نَديمي",50,"م",2,1],["إذا أصدروها كنتَ آخر صادر","وغن أوردُوها كنتَ أول وارد",51,"د",1,0],["إذا أصل المحبوب في الصب أصله","فحاشاه بعد الوصل يقطع وصله",52,"ه",1,0],["إِذا أَصابوا ثَروَةً وَاِكتَسَبوا","لِفعلهم وَالاجتهاد نَسبوا",53,"ب",3,0],["اذا اصطَكَّا بارَعنَ مكفهرٍ","تفارَطَ أن تناوله القصارُ",54,"ر",1,0],["إذا اصطَك رأسانا حلَلَنا بباذخٍ","برُكنيهِ تعتاذُ التوالي الزعانيفُ",55,"ف",1,0],["إذا اصطفقت في السمع فاضت مدامع","وحالت عيونٌ واستبان المكتَّم",56,"م",1,0],["إِذَا اصْلَخَمَّ لَمْ يُرَمْ مُصَلْخِمُهْ","وَارْتَدَّ فِي دُوَّارَةٍ مُحْرَنْجِمُهْ",57,"م",2,0],["إذا أصابوا الشاة والبعيرا","وركبوا البغال والحميرا",58,"ر",2,0],["إذا أصابت فؤاد صب","لا ينفع الطب والطبيب",59,"ب",1,0],["إِذا اِصطَبَحتُ أَربَعاً عَرَفتَني","ثُمَّ تَجَشَّمتُ الَّذي جَشَّمتَني",60,"ي",1,1],["إِذَا أَصْمَغَتْ فِي كَفِّهِ شَجَرُ القَنَا","أَتَى مِنْ نَجِيعٍ جَامِدٍ بِصَمَاغِ",61,"غ",1,0],["إِذا أَصبَحوا لَم يَقولوا الخَنا","وَلَم يَأكُلوا الناسَ أَضحوا غِراثا",62,"ث",2,0],["إذا أصغَى الوزيرُ إلى ثَنَائي","فإني ثالثٌ للفرقدين",63,"ن",1,0],["إذا اصفَّهمُ للذكرِ تحسبهُم","ملائكَ العرشِ قد حفّوا بنورانِ",64,"ن",1,0],["إِذا اِصطادوا بُغاثا شَيَّطوهُ","فَكانَ وَفاءَ شاتِهِمُ القُروعِ",65,"ع",1,0],["إذا اصفر وجه الشمس في الغرب وانتحى","ظلامُ على الدنيا يمد رواقه",66,"ق",2,1],["إِذا أَصغى لَها سَمع وَفهم","حَسبتهما مَعاً فَرَسي رِهان",67,"ن",1,0],["إذا أصبحت منهم أناساً كتائب","أغاثت بأشلاء العداة الحوائما",68,"م",2,0],["إذا اصطلوا بلظى قدر حَسبْتَهُم","لسوء حالهمِ صبيانَ عدّاسِ",69,"س",1,0],["إذا أصبحتَ مَخموراً","فداوِ الخمرِ بالخَمرِ",70,"ر",1,1],["إذا أصابهم مصيبةٌ بما","أن ظهورَ المصطفى قد حتما",71,"م",2,0],["اذا اصطدما وكان الامر خلفاً","فعن أي تناضل او تذود",72,"د",1,0],["إذا اصفرت عليه الشمس خلنا","نمير الماء يمزج بالعقار",73,"ر",1,0],["إذا اصفرت عليه الشمس صبت","على أمواجه ماء الخلوق",74,"ق",1,0],["إذا اصْطكتِ الاحسابُ وابتدر المدى","وهابَ جَسيماتِ الأمورِ المُروَّعُ",75,"ع",1,0],["إذا اصطرعَتْ نيرانُنا ورِياحُها","ولم تبقَ نارٌ تستنيرُ لطالِبِ",76,"ب",1,0],["إِذا أَصبَحت نَجداً أَظَل غُبارَها","هَذيلاً وَداسَ الهول دَوساً وَحَميرا",77,"ر",2,0],["إِذا اِصطِباحي في بَساتينِها","وَإِذ غَبوقي في دِياراتِها",78,"ت",3,0],["إذا أصدرت تلك الفخامة أمَرها","فإنَّ الذي يمضي عليه وزيرها",79,"ر",3,0],["إذا اصطدما حول المخيم أفزعا","أوانس مزدانا بهن المخيم",80,"م",1,0],["إِذا اِصطَلَحنا مُنِحنا بِالصُّدودِ فَما","تَنفَكُّ مِن غَضَب يُفضي إِلى غَضَبِ",81,"ب",1,0],["إذا أصابت دهرهم نكبة","بعض مواليهم لها استنهضا",82,"ض",2,0],["إِذا أَصبَحَت أَرضُ اليَمَانِينَ غابَةً","تَسَاوَى بها مَن ماتَ عَنها وحَرَّضَا",83,"ض",2,0],["إذا أَصْلَحَ الإنسانُ بالجَهلِ حَالَهُ","فَكُلُّ الذي يَأتِي بهِ الجَهلُ خارِبُ",84,"ب",1,0],["إِذَاْ أَصْغَى الْحَبِيْبُ لِكُلِّ وَاْشِ","فَلاْ تَحْفَلْ بِأَحْلاْمِ الْفِرَاْشِ",85,"ش",1,1],["إذا أصابكَ لن تدري بموعِدِهِ","فما لهُ موعِدٌ تلقاهُ أو ذاتُ",86,"ت",1,0],["إذا اصطنعوا الجميل فذا لفخر","ولولاه لضنوا بالسخاءِ",87,"ا",2,0],["إذا أصابت فعن عمد ولا خطأ","وإن تحد فهي للمرمي تأميل",88,"ل",1,0],["إذا اصطبحَ الفؤادُ بكأس سعدٍ","فقد زخّتْ بمغتبقٍ همومُ",89,"م",1,0],["إِذا أَصابُوا: أَنا مَدَّاحُ ضَربَتِهِم","وَإِن أَصابَهُمُ المَكرُوهُ: رَدَّاحُ",90,"ح",1,0]]}