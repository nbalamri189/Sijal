{"poems":[[63,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[57,"إذا أصبحت عندي قوت يومي","https://www.aldiwan.net/poem24702.html","الوافر"],[57,"خبت نار نفسي باشتعال مفارقي","https://www.aldiwan.net/poem24732.html","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[35,"تظل ابنة الضمري في ظل نعمة","https://www.aldiwan.net/poem39160.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[27,"يعافي الله بعد بلاء سوء","https://www.aldiwan.net/poem6013.html","الوافر"],[70,"ألا أيها الناء","https://www.aldiwan.net/poem42974.html","الهزج"],[12,"إذا أصبحت بين جبال قوو","https://www.aldiwan.net/poem1227.html",""],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[45,"أمير المؤمنين لقد سكنا","https://www.aldiwan.net/poem66797.html","البسيط"],[28,"أرى ابن سليم ليس تنهض خيله","https://www.aldiwan.net/poem5438.html","الطويل"],[49,"لكم فجع الدهر من والد","https://www.aldiwan.net/poem62064.html","المتقارب"],[66,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[81,"فوق سهامك إن الله يهديها","https://www.aldiwan.net/poem61441.html","البسيط"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[48,"شجاني وأبلاني تذكر من أهوى","https://www.aldiwan.net/poem10420.html","الطويل"],[50,"عدمتك عاجلا يا قلب قلبا","https://www.aldiwan.net/poem64866.html","الوافر"],[46,"إذا اصفر الفتى لفراق روح","https://www.aldiwan.net/poem22342.html","الوافر"],[46,"إسمع مقالة ذي لب وتجربة","https://www.aldiwan.net/poem23349.html","البسيط"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[76,"سيوف يقيل الموت تحت ظباتها","https://www.aldiwan.net/poem39491.html","الطويل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2896","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[77,"بحيث القباب البيض والأسل السمر","https://www.poetsgate.com/ViewPoem.aspx?id=34138",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[45,"أَميرَ المُؤْمنين لَقَدْ سَكَنَّا","https://www.poetsgate.com/ViewPoem.aspx?id=31844",""],[35,"تظلُّ ابنة ُ الضَّمريِّ في ظلِّ نعمة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22010",""],[51,"أمسى الشبابُ رداءً عنك مستلبا","https://www.poetsgate.com/ViewPoem.aspx?id=27201",""],[57,"خبتْ نارُ نفسي بِاشْتِعالِ مَفَارِقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14210&r=&rc=6",""],[230,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[236,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[276,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[298,"إذا أصبحت ذا طرب ولهو","https://www.aldiwan.net/poem33296.html","الوافر"],[299,"إذا أصبح الجزار للسرب راعيا","https://www.aldiwan.net/poem36836.html","الطويل"],[367,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[392,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[404,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[459,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[459,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[462,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[462,"اذا اصطبخت ألفاظه فارج خيره","https://www.aldiwan.net/poem15583.html","الطويل"],[462,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[465,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[511,"لا تتعرض لنا فإن لنا","https://www.aldiwan.net/poem1587.html",""],[515,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[516,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[563,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"]],"verses":[["إذا أصْغَرَتْ أو أكْبَرَتْ في حَنينِها","ظَلِلْتُ على آثارِهِنَّ مُغرِّدا",0,"د",2,0],["إِذا أَصبَحتُ عِندي قوتُ يَومي","فَخَلِّ الهَمَّ عَنّي يا سَعيدُ",1,"د",1,1],["إِذا اِصفَرَّ لَونُ المَرءِ وَاِبيَضَّ شَعرُهُ","تَنَغَّصَ مِن أَيّامِهِ مُستَطابُها",2,"ب",3,0],["إذَا أَصْبَحَتْ خَيْلِي الْبُيوتَ مُغِيرةً","وَفِي كُلِّ شِعْبٍ مِقْنَبٌ وَرَعِيلُ",3,"ل",1,0],["إِذا أَصبَحَت في الجِلسِ في أَهلِ قَريَةٍ","وَأَصبَحَ أَهلي بَينَ شَطبٍ فَبَدبَدِ",4,"د",1,0],["إِذا اِصطَكَّتِ الإِلباسُ فَرَّقتَ بَينَها","بِعَدلٍ وَلَم تَقحَز عَلَيكَ المَصادِرُ",5,"ر",1,0],["إِذا أَصبَحتُ في جَدَثٍ مُقيماً","فَكَم قَد غاظَهُ الجَدَثُ المُقيمُ",6,"م",1,0],["إِذا أَصبَحتَ في عُسرٍ","فَلا تَحزَن لَهُ وَاِفرَح",7,"ح",1,0],["إِذا أَصبَحتُ بَينَ جِبالِ قَوٍّ","وَبيضانِ القُرى لَم تَحذَريني",8,"ن",2,1],["إِذا أَصبَحَ الحَوذانُ في جَنَباتِها","يُفَتَّحُ وُهِّمتَ الدَنانيرَ تُضرَبُ",9,"ب",1,0],["إِذا اِصطَحَبَت آلاؤُهُ غَطَّتِ الرُبى","وَحُسنُ اللَآلي زائِدٌ في اِصطِحابِها",10,"ب",3,0],["إِذا أَصحابُهُ اِصطَبَحوا بِلَيلٍ","أَطالوا الخَوضَ في خَلقِ القُرانِ",11,"ن",1,0],["إِذا أَصبَحَت أُمُّ المَنايا مُقيمَةً","بِمُعتَرَكٍ زَلجٍ أَزالَ زَوالَها",12,"ل",3,0],["إِذا أَصبَحوا أَصبَحوا كَالأُسو","دِ باتَت مُجَوَّعَةً حارِدَه",13,"د",2,0],["إِذا أَصابَ لُجَينُ الماءِ عَسجَدَها","أَرتَكَ دُرّاً يُزيكَ الدُرِّ مُحتَلَبا",14,"ب",2,0],["إِذا أَصابَت لَدى المَرمى النِبالُ فَما","تُعزى إِصابَتُها إِلّا لِراميها",15,"ي",3,0],["إذا أصْلدوا أورى وإن عجِلوا ارتأى","وإن بخِلوا أعطى وإن غَدروا أوفى",16,"ف",2,0],["إِذا أَصبَحَت أَهدَت إِلى الشَمسِ سَجدَةً","وَتَسجُدُ أُخرى حينَ تَسجُدُ لِلمَسرى",17,"ا",1,0],["إِذا أَصبَحتَ صَبَّحَكَ التَصابي","وَأَطرابٌ تُصَبُّ عَلَيكَ صَبّا",18,"ب",2,0],["إِذا اِصفَرَّ الفَتى لِفُراقِ روحٍ","فَأَهوِن بِالتَصَعلُكِ وَالشُحوبِ",19,"ب",1,1],["إِذا أَصابَ الفَتى خَطبٌ يَضِرُّ بِهِ","فَلا يَظَنُّ جَهولٌ أَنَّهُ ظُلِما",20,"م",2,0],["إِذا أَصحابُ دينٍ أَحكَموهُ","أَذالوا ما سِواهُ وَعَيّبوهُ",21,"ب",3,0],["إذَا اصْطفَّتِ الرَّاياتُ حُمْراً مُتُونُهَا","ذَوَائِبُها تَهْفُو فَيَهْفُو لَها القَلْبُ",22,"ب",1,0],["إِذا اصطَحَبَ الأَقوامُ كانَ أَذَلُّهُم","لِأَصحابِهِ نَفساً أَبَرَّ وَأَفضَلا",23,"ل",2,0],["إِذَا اصطَنَع اللّهُ أمْرأً جَلّ سَعْيُهُ","وَعَمَّتْ أيَادِيِه وطَابَتْ نَقَائِبُه",24,"ب",2,0],["إذا اصطنبوا أقواسهم وتمنطقوا","فتبصر جيش الترك جاشت به مصر",25,"ر",1,0],["إذا أصحرتْ للخطب كان شبابُها","حصوناً منيعاتٍ لها وقلاعا",26,"ع",2,0],["إِذا أَصْحَابُهُ اصْطَبَحُوا بِلَيْلٍ","أَطَالُوا الحَوْضَ فِي خَلْقِ القُرَانِ",27,"ن",1,0],["إذا أصبحتْ في المجلسِ في أهل قرية","ٍ وأصبحَ أهلي بين شطبٍ فبدبدِ",28,"د",1,0],["إذا أصحبُ الدهرَ مغتراً بصحبته","إذا أعارَ متَاعَاً خِلْتُهُ وهَبَا",29,"ب",2,0],["إذا اصفرَّ لونُ المرءِ وابيضَّ شعرُهُ","تنغص من أيامه مستَطَبابُها",30,"ب",3,0],["إذا أصبح الموتُ حتماً فلا","تَخَفْه دنا وقُتُه أو نأى",31,"ا",1,0],["إِذا أَصبَحَت أَرضَ العَدُوِّ لِغارَةٍ","أَقامَت مَعَ الإِمساءِ سوقَ المَآتِمِ",32,"م",1,0],["إذا أصْدَرَتْ غُبْرُ السّباسِبِ وافِداً","لَها أوْرَدَتْ شرْواه خُضْرُ الغَوارِبِ",33,"ب",1,0],["إِذا أَصبَحتَ ذا طَرَبٍ وَلَهوٍ","تُعاقرُ راحةً أَو شرب راحِ",34,"ح",1,1],["إذا أصبح الجزّارُ للسِربِ راعياً","ففي كلِّ يومٍ منه شِلْوٌ ممزقُ",35,"ق",1,1],["إِذا أَصَبتَ بِسَهمٍ قَد رَمَيتَ بِهِ","وَما اِعتَمَدتَ فَذاكَ السَهمُ لَم يُصِبِ",36,"ب",1,0],["إذا أصبحت أو أمسيت","لا تنظر إلى الآت",37,"ت",1,0],["إذا اصطفيت صاحباً","أنشبت فيه مخلبك",38,"ك",1,0],["إذا أصابا وطراً من العلا","فذاك أو فيبلغان العُذُرا",39,"ر",2,0],["إذا أصاب فرصةً لعزمه","صمَّمَ لا يسوّفُ اليومَ بغدْ",40,"د",1,0],["إِذا أصبحت مني سجايا مُهَذَّبٍ","غَدا أملي ذا وقفةٍ وحِرانِ",41,"ن",1,0],["اذا اصْطبختْ ألفاظُه فارْجُ خيرَه","فإنَّ سَحوح الغيث يقدُمه الرَّعْدُ",42,"د",1,1],["إذا أصْرَدتهُ نسمةٌ شَمْألِيَّةٌ","تأجَّج عن وقْدٍ من الهمِّ مُشعَل",43,"ل",1,0],["إذا أصدفوا نيلا فلا سمح الحيا","وان سفروا ليلاً فلا طلعت يُوح",44,"ح",1,0],["إذا أصابت بنظرةٍ أحَداً","فما له عن حياته غرض",45,"ض",1,0],["إذا أصابَ غُبارُ الكُحْلِ مُقلتَها","تكادُ ترقُصُ من أهدابِها العُضُبُ",46,"ب",1,0],["إذا أصلحتها فسدت كأني","أهيب بها إلى نغل الإهاب",47,"ب",1,0],["إذا أصبحَتْ دُهْمُ الأمورِ مريضةً","شَفاها بإذنِ اللهِ حينَ يَعودُها",48,"د",3,0]]}