{"poems":[[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[47,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42625","الرمل"],[193,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[199,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[302,"طاف بدر الدجى بشمس الكؤوس","https://www.aldiwan.net/poem33240.html","الخفيف"],[325,"ها هو الدمع في المحاجر سائل","https://www.aldiwan.net/poem61620.html","الكامل"],[333,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[385,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[466,"تنيخ منه معمل المطي","https://www.aldiwan.net/poem16161.html","الرجز"],[469,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136292","البسيط"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205476","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113873","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91850","الرمل"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113702","المنسرح"],[3979,"","https://poetry.dctabudhabi.ae/diwan/poem/114849","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33553","السريع"],[4791,"شهامة ملام","https://www.poetsgate.com/ViewPoem.aspx?id=36960",""],[5111,"نَوْرَسَاتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212524",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5183,"الدويّ الحيران","https://www.poetsgate.com/ViewPoem.aspx?id=180175",""],[5455,"الدلوعه","https://www.poetsgate.com/ViewPoem.aspx?id=35554",""],[5790,"أنا أولى بما ذكرت من الأم","https://www.poetsgate.com/ViewPoem.aspx?id=111947",""],[5956,"أنا محرومٌ","https://www.poetsgate.com/ViewPoem.aspx?id=181915",""],[6257,"الأسامي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87194&r=&rc=19",""]],"verses":[["بين حجور العلم والأعلام","تكنفه لواحظ الأقلام",0,"م",1,0],["بَينَ حِرابِ الجُندِ وَالأَسهُمِ","وَالأَسيُفِ الهِندِيَّةِ الحُمرِ",1,"ر",1,0],["بَينَ حَقٍّ يَنوبُهُ يَصرِفُ الرَغ","بَ إِلَيهِ أَو مُعتَفٍ يَنتابُه",2,"ب",2,0],["بَيْنَ حِيطَانٍ وَبَابٍ مُوصَدٍ","كُلَّمَا حَرَّكَهُ السَّجَّانُ صَرْ",3,"ر",1,0],["بينَ حَقٍّ وباطلٍ فرقانُ","هوَ نعمَ المبينُ نعم البيانُ",4,"ن",1,0],["بَينَ حَربٍ وَعامِرِ بنِ كَريزٍ","فَأُلالَ الأَكارِمُ الأَخيارُ",5,"ر",1,0],["بَين حورٍ من الحِسانِ بدورٍ","وَحَوالٍ من الغَواني شُموسِ",6,"س",1,0],["بَينَ حورٍ وَبَينَ وِلدانٍ حُسنِ","وَجَنانِ نَعيمِها غَيرَ زائِلِ",7,"ل",1,0],["بين حورٍ عينٍ وأكواب خمرٍ","وأغانٍ علويّة الإيقاع",8,"ع",1,0],["بَين حُزن وَسقام وَكَرب","أَنَّهُ يَعشَقهُ غَيري وَما",9,"م",2,0],["بيْنَ حُروفِ الخطِّ والخَطِّي","بالبأسِ والعَزْمَةِ والرَّويِّ",10,"ي",1,0],["بين حزني وحسنه اليوسفي","نسبٌ كالصباح غير دعي",11,"ي",1,1],["بين حُمرٍ وبين بيض تحارُ ال","حورُ فيها من حمرةٍ وبياض",12,"ض",1,0],["بين حقيقة تفصيلي واجمالي","بشاهد بين تحكيه أقوالي",13,"ل",2,1],["بين حالي مسرة ونعيم","أنا من أن تقلصا في أمان",14,"ن",1,0],["بين حرفين كلما شاءَ يقضى","مطلق الحُكمِ لم يُشاركه ثان",15,"ن",1,0],["بين حقلٍ من الملائكِ صلى","في جلالٍ من نعمة الرضوانِ",15,"ن",1,0],["بين حرفينِ كلما شاءَ يقضى","وله النَّجمُ والثرى يسجدانِ",15,"ن",1,0],["بين حور يزلن أستار نور","عن بدور من الوجوه الحسان",16,"ن",1,0],["بَين حلٍّ وَارتحالِ","وَاضطرابٍ وَانتقالِ",17,"ل",1,1],["بين حَنايا ضلوعي اللَّهبُ","ومن جفوني اسْتهلَّتِ السُّحُبُ",18,"ب",1,1],["بين حَرامِ اللَّهوِ والحلال","أَكرمُ من مَصارعِ الأبطالِ",19,"ل",1,0],["بينَ حشاهُ لهبٌ مضرمُ","فدمعه يظهرُ ما يكتمُ",20,"م",1,1],["بين حد النهار وبين حد الظلام","احفر القبر وادفن به محبٍ ذبيح",21,"ح",1,0],["بَيْنَ حُلْمٍ وَسَرَابٍ","أيْنَ صَفْوِيْ يَا لَيَالِيْ",22,"ل",2,0],["بَيْنَ حُزْنِي وَاعْتِكَافِي","شَارِدٌ يَجْتَاحُ عَصْرَا",23,"ر",2,0],["بين حالين هذه تجهد الجس","م وهاتيك أجهدت للقلوب",24,"ب",1,0],["بين حضن أبوك وأمك وردةٍ مزروعه","طول عمرك مافقدتي لمسة الحنيه",25,"ي",2,0],["بين حاناتنا نروح ونغدو","فكأني ذاك الفلاني الآخر",26,"ر",1,0],["بين حَلْبٍ بين ضغط والتحامْ","بينما الأصل بعيدٌ كالغمام..",27,"م",1,0],["بين حلم الذرى وصمت سرانا","تتهادى حياتنا في الزحامِ",28,"م",1,0]]}