{"poems":[[30,"ألما على أطلال سعدى نسلم","https://www.aldiwan.net/poem5505.html","الطويل"],[68,"جل الذي أطلع شمس الضحى","https://www.aldiwan.net/poem40110.html","السريع"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[108,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[164,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[275,"أمن قتله العشاق خصرك ناحل","https://www.aldiwan.net/poem35358.html","الطويل"],[287,"أشكو إلى أقوش عكس اسمه","https://www.aldiwan.net/poem32626.html","السريع"],[354,"قول الإله جل في كتابه","https://www.aldiwan.net/poem15776.html","الرجز"],[466,"السيف والحجة الغراء قد شهدا","https://www.aldiwan.net/poem15158.html","البسيط"],[466,"تباريت والشهر الحرام ففقته","https://www.aldiwan.net/poem16180.html","الطويل"],[534,"قد صح إجماع جميع الورى","https://www.aldiwan.net/poem37258.html","السريع"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"إن يوم الهباة أورثني الذل","https://www.aldiwan.net/poem59467.html","الخفيف"],[580,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[667,"","https://poetry.dctabudhabi.ae/diwan/poem/105536","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34402","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53876","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77663","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119904","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64970","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64931","البسيط"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105221","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27684","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117038","السريع"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94448","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72464","المتقارب"],[4778,"سبقتُ السائرين","https://www.poetsgate.com/ViewPoem.aspx?id=204693",""],[5376,"نورٌ على نورٍ بهاء محمد ِ","https://www.poetsgate.com/ViewPoem.aspx?id=188493",""]],"verses":[["فَخُصَّت بِهِ شَيبانُ مِن دونِ قَومِها","عَلى راضِياتٍ مِن أُنوفٍ وَرُغَّمِ",0,"م",1,0],["فَخَصرُهُ واهٍ وَأَجفانُهُ","مَريضَةٌ وَاللَحظُ مِنهُ سَقيم",1,"م",1,0],["فخصَّه الإمامُ بالتّرحيبِ","والصَّفحِ والغُفرانِ للذُّنوبِ",2,"ب",1,0],["فخصومهُ اعترفوا له","بالفضل أكثرَ من صحابه",3,"ب",2,0],["فَخَصمٌ بِسَيفِ اللَهِ عاجَلَهُ الرَدى","وَأَغرَبَ في قَتلِ الأَخيرِ وَأَبدَعا",4,"ع",2,0],["فَخَصَّ بِأَوفى العَطِيّاتِ مَن","يُسَدِّدُ في غَزوِهِ وَالقَفَل",5,"ل",1,0],["فَخَصَصتَ بِالإِذلالِ كُلَّ مُقَلنَسٍ","وَعَمَمتَ بِالإِعزازِ كُلَّ مُعَمَّمِ",6,"م",1,0],["فخصمه المغرور كاللاحس","الموس ما يحيى به موسما",7,"م",2,0],["فخصرُكِ تذكارُ السعادة في الأسى","وعهدُ غرامٍ كالغمامةِ زائل",8,"ل",1,0],["فَخَصرُه يظلِمُهُ رِدفُهُ ال","مهتَزُّ وَالمُعتَزُّ في ظُلمِهِ",9,"م",2,0],["فَخَصَّهُ مِنهُ بِوصَفٍ لَم يَكُن","بِغَيرِهِ فيما رَوَوهُ واقِعا",10,"ع",2,0],["فخصمهُ أبداً ما بين مُنْقطعٍ","يرى فصاحته عِيّاً ومُنْعَفِرِ",11,"ر",1,0],["فخصماهُ من يوميْ وَغاهُ وسَلْمه","همُا مُرْمِلٌ من حُجةٍ ومُرمل",12,"ل",1,0],["فَخَصّص الإجْمَاع ما عَمَّ مِنْ","مَسالِكِ التخريجِ في ذَا السُّؤالْ",13,"ل",1,0],["فخصه بالوحي والنبوة","وخص بالإمرة والأخوة",14,"ه",1,0],["فخصبت السنانَ من ثُغر القومِ","وكانوا للناظرين نجوما",15,"م",2,0],["فخِصْرُه أَنحفُ من عاشِقِه","وردفُه مثلُ كثيبِ الرَّمْل",16,"ل",1,0],["فخصره أصبح من","نطاقه في فرج",17,"ج",1,0],["فخُصّوا بِالتَمام وَعَمَّ نَقصٌ","ومحقٌ بالأعادي الأَشقياءِ",18,"ا",2,0],["فَخُصَّنِي بنَصِيبِ من دعائِكَ لِي","لعلَّ نَحْوي بِهِ الأيّامُ تَنْعَطِفُ",19,"ف",1,0],["فَخصَّ أولاهنَّ وَهيَ السكرى","دِن النَبيذ وَالأَواني طرّا",20,"ر",2,0],["فخصره مثل ديني","ورد فمه أوزاري",21,"ر",2,0],["فخَصَصْتُهُ مِنْ خاطِري بقَلائدٍ","جَلَّتْ ودَقَّ الفِكْرُ في تَثْمينِها",22,"ن",3,0],["فَخَصَّني بِعُلا يَعْلو على أَمَلي","فَلا عَساهُ يُدانيها ولا عَلَّهْ",23,"ل",2,0],["فخصمه لم يزل في الذل منغمساً","وعينه ملأت رعباً فلم تنم",24,"م",1,0],["فَخَصَّ بِالطَولِ بَني اِسماعيلِ","أَضافَهُم بِالشَرَفِ الجَليلِ",25,"ل",1,0],["فخصّ بفتح النون إذ عمّ نفعه","ورحمته والضم من شأنه السدّ",26,"د",1,0],["فخص كلا من وجوه البرج","بناظر من الدراري البلج",27,"ج",1,0],["فخصك اللَه تَفضيلا بمنصبها","وَقدمتك جَميع الأنبياء بها",28,"ه",2,0],["فخصره واه وأردافه","تثقله واللحظ منه سقيم",29,"م",1,0],["فَخصَّهُ قومُ هوميرٍ بآلهة","لها من القلب إجلال وتعظيم",30,"م",1,0],["فخصَّها لقبا أحيا بِهِ نسبا","في حكمةٍ طاب مثواها ومسراها",31,"ا",3,0],["فخص العوام وعمَّ الخواص","سرور على كلهم ظاهر",32,"ر",1,0],["فخصَّ الله أزواجا ثلاثة","بولدان وفاكهة وجنةْ",33,"ه",1,0],["فخصالك القرآن كم تسمو به","فملكْتَ كوناً بالحنان وسؤددِ",34,"د",1,0]]}