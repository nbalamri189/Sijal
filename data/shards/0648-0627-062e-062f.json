{"poems":[[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[88,"رباك والدك الكريم على التقى","https://www.aldiwan.net/poem68935.html","الكامل"],[74,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[51,"حتى متى يستفزني الطمع","https://www.aldiwan.net/poem62168.html","المنسرح"],[50,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[102,"عذاب ولحن","https://www.poetsgate.com/ViewPoem.aspx?id=50120",""],[47,"أُنَبِّيكَ عَن طَوْلِ الأَميرِ وفَضْلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31863",""],[132,"أهنيك يا ابن الأكرمين الأطايب","https://www.aldiwan.net/poem50673.html","الطويل"],[190,"لا تأنسن إلى أحد","https://www.aldiwan.net/poem43965.html","مجزوء الكامل"],[203,"إن المعارف للمعالي سلم","https://www.aldiwan.net/poem45672.html","الكامل"],[242,"يا جميل الصبر لب من دعا","https://www.aldiwan.net/poem19492.html","الرمل"],[267,"إن الخليط أجد البين فانتجعوا","https://www.aldiwan.net/poem68200.html","البسيط"],[275,"سلم وصل على النبي محمد","https://www.aldiwan.net/poem34997.html","الكامل"],[409,"أديرت على حمى بكيل وحاشد","https://www.aldiwan.net/poem34126.html","الطويل"],[412,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[438,"لو أن ذا قلمي قوى كلمي","https://www.aldiwan.net/poem12401.html","أحذ الكامل"],[484,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[484,"حللت قلبي يا ابني","https://www.aldiwan.net/poem37055.html","المجتث"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107239","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34402","الوافر"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117487","الطويل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118116","الطويل"],[1636,"","https://poetry.dctabudhabi.ae/diwan/poem/131361","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141286","الوافر"],[1862,"","https://poetry.dctabudhabi.ae/diwan/poem/199194","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28500","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91517","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216512","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206133","الكامل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130431","المديد"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136822",""],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116077","الرمل"],[5910,"سلامٌ على تلك الدِّيار","https://www.poetsgate.com/ViewPoem.aspx?id=206229",""],[6259,"لو جادهنَّ غداة رمنَ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59361&r=&rc=9",""]],"verses":[["وأخْدَعُهُمْ ولي عَزْمٌ شُجاعٌ","بمُخْتَلَقٍ منَ الكَلِمِ الجَبانِ",0,"ن",1,0],["وَاِخدُم بِلادَكَ بِالَّذي أوتيتَهُ","مِن فِطنَةٍ وَأَقِل عِثارَ العاثِرِ",1,"ر",1,0],["وأخدمهم من رأيه ومداده","صواباً كما ترضى الملوك وعنبرا",2,"ر",2,0],["وَاِخدَعِ الأَحياءَ ما شِئتَ فَلَن","تَجِدَ التاريخَ في المُنخَدِعين",3,"ن",1,0],["وَأَخدَعَ اللَيلَ وَالنَهارَ لِأَق","وامٍ أَراهُم في الغَيِّ قَد رَتَعوا",4,"ع",3,0],["وَأَخدَرِيٍّ صُلبِ النَواهِقِ صَل","صالٍ أَمينِ الفُصوصِ وَالوُظُفِ",5,"ف",1,0],["وأخدع بالوهم جوع الحنين º","كما يخدع الحلم الهجّدا",6,"د",2,0],["وأَخْدُ يَدِي مَنٌّ عَلَيَّ ،وإِنَّما","يُقَالُ لَقَوَّالِ الخَنَا خُذْ بِرِجْلِهِ",7,"ل",2,0],["وأخدُمُكم ما دمت حيّاً مُجاهِداً","بقلبٍ صحيحِ خالصٍ غير ناكِبِ",8,"ب",1,0],["واخدم نفيستك الضعي","فة واحتمل تعب الجسد",9,"د",1,0],["واخدم بلاداً أنتَ من أبنائها","إن البلادَ بأهلها تتفدمُ",10,"م",1,0],["وَاخْدُمَنْ يَا عَفْوَ رَبِّي سَيَّداً","كَانَ لِلْعَفْوِ عَنِ الْجَانِي وَعَا",11,"ع",2,0],["واخدَع خَلِيفَتَنَا عَنها بِمسألَةٍ","إنّ الخَلِيفَةَ لِلسُّؤال يَنخَدِعُ",12,"ع",1,0],["واخدم لعزَّةِ دولة عربيةٍ","في الجيشِ والبس شكَّة المتجند",13,"د",1,0],["واخد خفاش وهو أرفع رتبة","وأعلى منالاً من حصون المغارب",14,"ب",1,0],["وَأخ دعوتك بَعدَ طولِ نُعاسِهِ","فازتاع نَحو الجَرسِ ثُمَّ ارتاحا",15,"ح",2,0],["واخدُمْ بتقبيلي البِساطَ لِمَنْ","باتَ الزمانُ له من الخَدَمِ",16,"م",1,0],["واخدم بلادك وارفع شأن أمتها","ما خدمة الشعب إلا أشرف الرتب",17,"ب",1,0],["واخدم بلادك واعلم","بأنك التونسي",18,"ي",1,0],["واخدَعيهِ بِوصالٍ","منكِ يُنسيهِ اكتآبَه",19,"ه",1,0],["واخدَع فُؤَادِي بالأماني واسقِني","مِمّا انتَقاهُ التاجِرُ الصَّنعانِي",20,"ن",2,0],["وأخدمه العيونُ فَعَينُ ماء","جَرَت مِن كَفِّهِ للإِرتِواءِ",21,"ا",2,0],["وأخدمني الماءَ القراحَ فحيثُ ما ال","تفتُّ رأيتُ الماءَ في خدمتي يجري",22,"ر",2,0],["وأخدمني الماء القراح وحيثما","سنحت رأيت الماء في خدمتي يجري",23,"ر",2,0],["واخدم كخدمته وانهض كنهضته","تحز برمّته مأثور آثاره",24,"ر",2,0],["واخدموا أوطانكم خدمة من","يحسب الموت لديها مستطابا",25,"ب",2,0],["وأخدم العلم لا ألوي على أحد","ولست أجعل غير العلم مكتسبي",26,"ب",2,0],["وَأَخَدتُمُ أنتُمُ بُنَيَّاتِ الطَّرِيقِ وَنَح","نُ سِرنَا فِي الطَّرِيقِ الأعظَمِ السُّلطَانِ",27,"ن",1,0],["وَاخدَع فُؤادي في الخَليطِ لَعَلَّهُ","يَهفو عَلى آثارِهِم وَيَعودُ",28,"د",1,0],["وَاخدع كما تبغى النُهى","وَرجاله بسكينتك",29,"ك",1,0],["وأخدع شيء أنت ان قيل منصف","وأصعب شيء أنت ان قيل أسلما",30,"م",2,0],["واخدع جليسك بالقطوب فإنني","أنا لا أُغر بضاحك متنكر",31,"ر",1,0],["واخدع القلب الذي صحبوا","وخداع النافرين عنا",32,"ن",2,0],["وأخدم أهله وسر في رأي عبده وسيده","تبلغ أعلا معاليه الرفاع الفريده",33,"د",2,0],["وآخدعوا العينَ بطيفٍ مثلما","تخدعُ القلبَ أحاديثُ المُنَى",34,"ن",2,0],["وأخدارِ آرامٍ شُغِفتُ بحبِّها","فخلَّفن قلبي بين صبٍّ وحائنِ",35,"ن",1,0],["وأخ دعوتك بعدَ طولِ نعاسهِ","فارتاع نحو الجرس ثم ارتاحا",36,"ح",2,0]]}