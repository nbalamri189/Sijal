etsgate.com/ViewPoem.aspx?id=129279",""],[4984,"وَادِي الْقُرَى","https://www.poetsgate.com/ViewPoem.aspx?id=204860",""],[5111,"آهَاتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212617",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5152,"قافية الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=185869",""],[5198,"بيت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=136097",""],[5281,"غزَّة العزِّ","https://www.poetsgate.com/ViewPoem.aspx?id=199703",""],[5457,"الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=213388",""],[5561,"طيفًا يزورُكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=203216",""],[5638,"حكم الخنازير","https://www.poetsgate.com/ViewPoem.aspx?id=206324",""],[5690,"أما ينقضي هذا التدلل والصدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=172154",""],[5708,"مَلَكْتَ قلبيَ قهرا","https://www.poetsgate.com/ViewPoem.aspx?id=158078",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[5815,"خَلَجات","https://www.poetsgate.com/ViewPoem.aspx?id=190305",""],[5851,"طير الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=175287",""],[5943,"سفينة الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34867",""],[5956,"العبّارة المصرية","https://www.poetsgate.com/ViewPoem.aspx?id=192129",""],[5956,"يا ربِّ كيف خلقت هذا الهاديا؟","https://www.poetsgate.com/ViewPoem.aspx?id=207357",""],[5997,"العذراء","https://www.poetsgate.com/ViewPoem.aspx?id=214229",""],[6068,"ل بُونَةَ فِي قَلْبِي غَرَامٌ مُطَابِق -26-","https://www.poetsgate.com/ViewPoem.aspx?id=175807",""],[6125,"جِرَاحِي لا تُضَمِّدها الأمَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=207908",""],[6125,"لماذا الحبُّ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=210965",""],[242,"أدام الله مولانا العليا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563721",""],[6198,"عباءة الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79232&r=&rc=6",""],[6213,"بحار الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85491&r=&rc=94",""],[6300,"أنا يا أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81626&r=&rc=3",""]],"verses":[["بِحادِثِ عِزٍّ في ذُؤابَةِ عامِرٍ","أُضيفَ إِلى عادِيِّهِ المُتقَدِّمِ",0,"م",1,0],["بِحافَتِهِ مِن لا يَصيحُ بِمَن سَرى","وَلا يَدَّعي إِلا بِما هُوَ صادِقُهُ",1,"ق",2,0],["بِحاجِبِهِ كَدحٌ مِنَ الضَربِ جالِبٌ","وَحارِكُهُ مِنَ الكُدامِ حَصيصُ",2,"ص",1,0],["بِحَارٌ يَهلِكُ السُّبَحَاءُ فِيها","تَرَى الجُردَ العِتَاقَ لَهَا سَفِينَا",3,"ن",2,0],["بِحالٍ تُرَدُّ الحاسِدينَ بِغَيظِهِم","وَتَطرِفُ عَنّا عَينَ كُلِّ رَقيبِ",4,"ب",1,0],["بحاجةٍ إن قضاها وهي هينةٌ","يُنَزِّهُ الشيخُ في تلك الصُّحون يدي",5,"د",2,0],["بحّاءُ في حلقها خريرٌ","دوّارةٌ سَلحها حريره",6,"ر",2,0],["بحالي ضنىً من توانيكُمُ","فحتَّى متى سادتي لا تُبلُّ",7,"ل",1,0],["بِحاجاتٍ تَحَضَّرَها عَدُوٌّ","فَما يَسطيعُها إِلّا خِطارا",8,"ر",2,0],["بِحاجِبَيهِ وَعَينَي","هِ لِلمُحِبّينَ هَتكُ",9,"ك",1,0],["بِحاجَةِ مَحزونٍ كَئيبٍ فُؤادُهُ","رَهينٌ بِبَيضاتِ الحِجالِ صَديقُ",10,"ق",1,0],["بِحاجَةٍ ما دَعَت شَجواً مُطَوَّقَةٌ","في أَيكَةٍ بَينَ أَغصانٍ بِتَغريدِ",11,"د",1,0],["بُحّاً حَناجِرُها هُدلاً مَشافِرُها","تُسيمُ أَولادَها في قَرقَرٍ ضاحي",12,"ح",2,0],["بحاجة ٍ نَزَّر فيها سائلا","بل فاضلٌ وافق شكراً فاضلا",13,"ل",2,0],["بِحالٍ لَو تَأَمَّلَها عَدُوّي","لَساهَمَني الرَزِيَّةَ أَو رَثى لي",14,"ل",2,0],["بحار غير راكدة","وفيها النار تضطرم",15,"م",1,0],["بحاتم شسع عبدالله يفدي","وألف مثل ذاك ولا ابتذاخ",16,"خ",1,0],["بحارٌ بأَحكامِ الرِّياحِ فإنها","مفاتيحُ في أَبوابِهنَّ وأَغْلاق",17,"ق",1,0],["بحارُ عقلُ المرءِ فيهِ فهلْ","من حيلةٍ في عقلي الحائرِ",18,"ر",1,0],["بِحَارُ النَّدَى تُعْزَى إِلَيْكُمْ أَبَا يَعْزَى","فَأَعْظِمْ بِمَا يُنْمَى إِلَيْكُمْ وَمَا يُعْزَى",19,"ز",2,1],["بِحارٌ إِذا أَنْحَتْ لَوازِبُ مَحْلِهِ","جِبالٌ إِذا هَبَّتْ زَعازِعُ نُكْبِهِ",20,"ب",2,0],["بِحال ما أنو شروانَ فيهِ","وَبزرجمهرهُ رأيٌ مفيدُ",21,"د",1,0],["بِحارَ هَمٍّ ما عَنى صاحِبي","لا غَرَقي فيها وَلا سَبحي",22,"ح",2,0],["بحالٍ كادَ يكشفُها مَقامي","أُراقبُ أمرَ سيِّدنا الأميرِ",23,"ر",1,0],["بِحالٍ قَعدتُ بِها عاطِلاً","فَصيغ لَها من نَداهُ الحُليّ",24,"ي",1,0],["بحافظٍ ما تجلّى صُبْحَ مكرمةٍ","إلا انْجَلى من ظلامِ الشّكّ داجيهِ",25,"ي",2,0],["بحاجِبِ شَمْسِ دَوْلَةِ عبدِ شَمْسٍ","وسيفِ اللهِ منها فِي اليَدَيْنِ",26,"ن",1,0],["بِحَارٌ أَمَرَّتْ للأَعادي طُعومُها","كَمَا طاب فينا شُرْبُهَا وطَهُورُها",27,"ر",3,0],["بحالها وهي بالجرعاء عالقةً","تظن أقوازها فيها المعاليقا",28,"ق",2,0],["بحارَةِ غُرْبةٍ من أرض حمصٍ","لقد غَدر الزمانُ وأيَّ غَدْرِ",29,"ر",1,0],["بحارٌ فان شاموا بروقً غمودهم","رأيت بحاراً فاضَ منها جداول",30,"ل",1,0],["بحار ندّى غزر العطايا وساعها","شموس ضحىً غرُّ الوجوه وسامها",31,"م",3,0],["بحالة بات لها معرضا","من كان لا يصفى الولاء ممحضا",32,"ض",2,0],["بحالٍ يستَميلُ الطَّوْدَ وجداً","وعزمٍ فوقَ أَبراجِ النُّجومِ",33,"م",1,0],["بِحالِ حَنينٍ من رِجالٍ دُموعهُمْ","منَ الخَوفِ سَحًّا منْ أماقِيِّهمْ تَجْري",34,"ر",2,0],["بِحالٍ طَواهُ من بَراهينِ فَتْحهِ","لِصاحبِهِ البَرِّ الكَريمِ أبي بَكْرِ",34,"ر",1,0],["بِحامي الحِمى شَيخِ العَواجزِ أحمدٍ","أبي العَلَميْنِ المُنْجَلي جَلْوَةَ البَدْرِ",34,"ر",1,0],["بِحاجِبَي سَبعينَ أَلفاً مُعرِبا","مَوجاً تَرى قُدموسَهُ مُكَوكَبا",35,"ب",2,0],["بِحارٌ على وجهِ البِحارِ زواخرٌ","جِبالٌ على متنِ الجِبالِ الشواهقِ",36,"ق",1,0],["بُحَّ الحُلُوقِ كأن بينَ حُلُوقِها","قَصَباً تَداولَ بَينَهنَّ الزّامِرُ",37,"ر",1,0],["بحار علوم في عماقة لجها","بعاصفة الأهواء كم أهلكت سفنا",38,"ن",2,0],["بِحالَةٍ لَم تَمضِ قَطّ في زَمَن","سُبحانَ مَن سَخّرها بِذا الزَمَن",39,"ن",1,0],["بِحالَة قرّت بِها العُيون","فَلَم تَخب في رَبّنا الظُنونُ",39,"ن",1,0],["بحافتْ فأوصاها الحسودُ ببيْنها","فقد باينَتْنا مذ أصاخت لمن أوصى",40,"ص",2,0],["بحامي الذمار برب الفخار","بشم النهار ببدر الدجن",41,"ن",1,0],["بِحارٌ وَأَمواجٌ تَرامَى كأنَّها","شَماريخُ سَلمى جادَها وابِلُ القَطرِ",42,"ر",1,0],["بحار طرفي بسحر","في طرفه واحورارِ",43,"ر",1,0],["بحار الندَى كَفُّه والعلوم","مدى الدَّهْر في قِرْنِ زاخرة",44,"ر",2,0],["بِحَافَتيهِ أو لُجَيناً مُحرَقَا","أَو سِنَّ رَوقِ جَابَةٍ مُرَوَّقَا",45,"ق",2,1],["بحاء المحبة والحكم