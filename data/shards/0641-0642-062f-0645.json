رِ أَطْلالٍ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63500",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[402,"لذكراك يا حفني في النفس أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=36492",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""],[199,"لَعَمْرِي لَقَدْ أَصْحَرَتْ خَيْلُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=20782",""],[6142,"إذا ما سهام الدهر أغرق نزعها","https://www.poetsgate.com/ViewPoem.aspx?id=155756",""],[5309,"عذابي اليم من مهاة اصابها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573548",""],[6237,"رصيد الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77886&r=&rc=28",""]],"verses":[["فَقَد مُدَّت غَياباتُ المَخازي","عَلى عَرَصاتِكُم مَدَّ الطِرافِ",0,"ف",1,0],["فَقَدِّمَ مَجْدُوداً وَأَخِّرَ غَيْرَهُ","تَحَكُّمَ نَجْمٍ وَالفَرِيقَانِ أَقْرَانُ",1,"ن",1,0],["فَقَد مَلَأَ الأَرضَ مِن سَلحِهِ","خَنافِسَ لا تُشبِهُ الوالِدا",2,"د",2,0],["فَقَد مُنِعَ القَينُ الجَوازَ وَقَد يَرى","لِشَيبانَ عَينَ الماءِ وَالعَطَنَ السَهلا",3,"ل",2,0],["فَقِدماً عَصَيتُ العاذِلاتِ وَسُلِّطَت","عَلى مُصطَفى مالي أَنامِلِيَ العَشرُ",4,"ر",1,0],["فقدمتُ رجلاً رغبةً في رغيبةٍ","وأخّرتُ رجلاً رهبةً للمعاطبِ",5,"ب",1,0],["فقدَّمتُ بالإغضاء عن كلّ ذلةٍ","مِواعيدَ ذي مجدٍ وذي كرم محض",6,"ض",1,0],["فقد مضت سننة العادين إذا حصروا ال","بيت الحرام فردّوا كالهماليل",7,"ل",1,0],["فَقَدَّمَ ديكاً عُدْمُلِيّاً مُلَدَّحاً","مُبَرْنَسَ أَثيابٍ مُؤَذِّنَ مَسْجِدِ",8,"د",1,0],["فَقَد مَلَّ ضَوءُ الصُبحِ مِمّا تُغيرُهُ","وَمَلَّ سَوادُ اللَيلِ مِمّا تُزاحِمُه",9,"م",2,0],["فَقِدماً كانَ عَيشُ أَبيكَ مُرّاً","يَعيشُ بِما تَعيشُ بِهِ الكِلابُ",10,"ب",1,0],["فَقدِّمْ له الجَدْيَ الرَّضيعَ وَثِّنه","بِعَذْراءَ مِنْ ماءِ الكُرومِ زُلالِ",11,"ل",1,0],["فقَد مَلكتْ وُدَّ أربابِها","فكلٌّ يخافُ عليها شَعوبا",12,"ب",2,0],["فَقَد مَرَّ لي يَومٌ سَعيدٌ لِغَيمِهِ","لَبائِدُ عَن أَعطافِهِ ما تَرَجَّلُ",13,"ل",1,0],["فَقَد مَلَّكتُكُم مُلكاً جَليلاً","بَنَيتُ بِهِ المَناقِبَ طولَ عُمري",14,"ر",2,0],["فَقُد ما كُنتُ مَعسولَ الأَماني","وَمَأدومَ القَوافي بِالسَدادِ",15,"د",1,0],["فَقَدْ مَرَّ ذَاكَ الْعَصْرُ إِلا لُبَانَةً","مُعَلَّقَةً بَيْنَ الْحَشَا وَالْحَيَازِمِ",16,"م",1,0],["فَقِدماً كُنتِ أَرجى الناسِ عِندي","وَأَقدَرَهُم عَلى ما تَطلُبينا",17,"ن",2,0],["فَقَدَّمتُ صَفحاً عَنهُ يوجِبُ شُكرَهُ","وَما كانَ لي مِنهُ جَزاءٌ وَلا شُكرُ",18,"ر",1,0],["فَقُدَّمَ مَن تَأَخَّرَ في العَطايا","وَأُخِّرَ مَن تَقَدَّمَ في المِراسِ",19,"س",1,0],["فقدَّمَ الخيْلَ إليها مُسرعاً","واحتلَّها مِن يومهِ تَسرُّعا",20,"ع",2,0],["فقُدِّمتْ كُفّارُها للسَّيفِ","وقُتِّلوا بالحَقِّ لا بالحَيفِ",20,"ف",1,0],["فقدَّم القُوَّادَ بالحُشودِ","وأَتْبعَ الحدودَ بالحُدودِ",20,"د",1,0],["فقد ملّ ضوء الصّبح ممّ تغيره","وملّ سواد اللّيل ممّا تزاحمه",21,"م",2,0],["فَقِدْماً كُنْتَ لا تَلْقَى","لصفوٍ قد مضى كدرا",22,"ر",2,0],["فَقَدِّمهُ إِجماعاً عَلَيهِم بِلا ثُنيا","تُقَدِّم أَجَلَّ الخَلقِ عَن كُلِّ عالَمٍ",23,"م",1,0],["فقد مست الضراء وانقطع الرجا","من الخلق إلا منك ياواسع النعما",24,"م",2,0],["فَقَد ماتَ بِسطامٌ بِطَعنَةِ عاصِمٍ","وَكانَ المُرَجّى في مَعَدّ بنِ عَدنانِ",25,"ن",1,0],["فَقَد ملكَ الشيطانُ ملكاً مؤبّداً","نَواصيهم وَاللحمَ وَالعظمَ والشعرا",26,"ر",2,0],["فَقَد ماتَ لكن أحيتِ الدجل كتبهُ","وَورّثَ كلّاً مِن تَلاميذهِ قدرا",26,"ر",2,0],["فَقَد مَلكوا الدُنيا وَكانوا جَمالَها","كَما مَلَكوا الأُخرى وكانوا لَها فَخرا",26,"ر",2,0],["فَقَد ملكتني الاوزار عَبدا","وَلكني رجوت بك العتاقا",27,"ق",2,0],["فَقَدْ مَلأَ الْبِلادَ لَهُ حَدِيثٌ","يُرَدَّدُ بَيْنَ أَفْواهِ الرُّواةِ",28,"ه",1,0],["فقَدّمَنَّ ما حضَر","فَلَيسَ في البِرِّ خَطر",29,"ر",1,0],["فقد منعتني عن لقاهم موانع","وقد قصرت بي دون ذلك أعذار",30,"ر",1,0],["فَقَد مَضَت عِشرونَ ثُمَّ عَشرَةً","سَنونَ فيها تَستَبينُ العَشرَه",31,"ه",1,0],["فقدمواالعقائدالسنيه","مجردات عن فرى ومريه",32,"ه",1,0],["فَقَدْ مَلَّ الطَّبِيبُ وَمَلَّ أَهْلي","وَمَلَّتْنيَ المُضَاجِعَةُ العَروسُ",33,"س",1,0],["فقد مَدَّ كَفُّ الغَربِ زَنْداً مُخضَّباً","عليه هِلالٌ كالسِّوارِ إذا انْعطَف",34,"ف",1,0],["فَقَد مَنحَ الدُنيا حَديثاً مُخَلَداً","لَهُ أَبَداً تَفنى الرواةُ وَلا يُفنى",35,"ن",2,0],["فقد مضى عمره في الترهات وقد","آن الرحيل إلى الأخرى على عجل",36,"ل",1,0],["فقدموا العدل والإِنصاف في أمم","قد طال منكم لهم ظلم وعدوان",37,"ن",1,0],["فقد منع الألى تقليد مثلي","وعدوا ذاك من قسم الحرام",38,"م",1,0],["فقد ما عهدنا المكرمات خيامها","وعليك وأما عن سواك تقوض",39,"ض",1,0],["فقد مزقته بعد كل ممزق","فلم يبق منه جثة وإهاب",40,"ب",1,0],["فَقد مَرَّتْ لنا فيها ليالٍ","نشاوى بالمدام فلا نفيق",41,"ق",1,0],["فقدماك فقدان الغَمامة أقلَعْتْ","وقد ألْبَستْ برد الرَّبيع اليمانيا",42,"ي",2,0],["فقدَّمه المشيرُ ليوم بُؤسٍ","يقدُّ من الخوارج كل هام",43,"م",1,0],["فقد مَرَّتْ لنا فيها ليالٍ","كما نظمت قلائدها العقود",44,"د",1,0],["فقد مات لقمان وماتت نسوره","وما عمرت أعمارها والمسالك",45,"ك",1,0],["فقِدْماً رآكم لأخلاقه","بحسن خلائقكم فاضحينا",46,"ن",2,0],["فقد منع السَّرحَ ذو لِبدتين","متى ما يُهَجْهَجْ به يُوقعِ",47,"ع",1,0],["فقدّم العزمَ واتخذه أخا رح","لك وأسلك هديت حيث سلك",48,"ك",1,0],["فقد ملأَ الحنينُ عِراصَ قلبي","غداةَ تَغدَتْ ديارُهمُ قِفارا",49,"ر",2,0],["فقدّم لي العَقيقَ قِرىً لعَيني","وقرّطَ سَمعي الدُرَرَ الغَوالي",50,"ل",2,0],["فقد منحتك وداً مثل عرضك لا","تسمو إلى صفوه الأيام بالكدر",51,"ر",1,0],["فَقِدماً ما جَلَوْتَ عليّ وَهْناً","شَماماً في صبيغةِ أُرْجُوانِ",52,"ن",1,0],["فقد مضى من يدِي وفارقنِي","ما لا أراهُ براجعِ أبدا",53,"د",2,0],["فَقِدْمَاً يَا لَكَ الخَيْرُ","غَرَسْتَ الوُدَّ فِي صَدْرِي",54,"ر",2,0],["فقد مَنع الطرفَ منِّي ومنْه","إِمّا الدُّمُوعُ وإِمّا الضِّياءُ",55,"ا",2,0],["فقد مسهم من ذلك القرح فادح","فكانوا طعاماً للنسور الحوائم",56,"م",1,0],["فقدماً أبكت الورق","بمخضر الأفانين",57,"ن",1,0],["فَقَد مَلأت بِقاع الأَرض أَجمعها","بِنُور إِنصاف ذي حَقٍّ وَمَحقوق",58,"ق",1,0],["فقد ماتوا وما قُبروا ولكنْ","كأَنَّ بيوتَهُمْ لهمُ قبور",59,"ر",1,0],["فَقَد مَرَّ بي صُبحاً وجسمي ناحلٌ","فَصارَ عَليلاً حينَ مَسَّ نَحيلا",60,"ل",2,0],["فَقدمَ لي بكراً لَها الكرمُ والدٌ","وَلَكِنّها مِن غَيرِ أُمٍّ وَراحا",61,"ح",2,0],["فَقَدموا الواحد بَعد الواحدِ","وَلَم أَكُن أَحصيهم في العَدَدِ",62,"د",1,0],["فقد ملكت بنو الأتراك رقي","بهزل من تجنيهم وجد",63,"د",1,0],["فقد ملت الجرد المذاكي طراده","وضجت إلى الغارات منه الوقائعُ",64,"ع",1,0],["فقد مضى في سبيل الله حاملها","متوّجاً لحياض المجد منتسبا",65,"ب",2,0],["فقدم بالأملاك والرسل في علا","مقام له من قبل فيه التقدم",66,"م",1,0],["فَقَد مَلَأَت بِهِ كَفَّيكَ مِن رَجل","يَرعى ذِمامَكَ رَعيَ الواصِلِ الحَدبِ",67,"ب",1,0],["فَقَدِمْتُ مجهولا وقد","نقض الجناحان القوادمْ",68,"م",1,0],["فقدمها أمامك يا إمام","لتحظى بالسرور وبالتهني",69,"ي",1,0],["فقدم العلم بأصل الدين","مع الدليل الواضح المبين",70,"ن",1,0],["فَقدمت إِلَيهِ رسلاً فشرب","وَكان عيمان فَقامَ إذ طَرب",71,"ب",1,0],["فَقدم الطعام وَالشرابا","وَأظهر الإكرام وَالإعجابا",72,"ب",2,0],["فقد مضى القيظ واحتثت رواحله","وطابت الراح لما آل أيلول",73,"ل",1,0],["فقدّمت التَّأخُّر يا مَلِيكي","وقلبي نَحو حضرتكم يَطيرُ",74,"ر",1,0],["فقد منينني قبل المنايا","مرور ركائبي بالدهنوين",75,"ن",1,0],["فقد ملئت منّا القلوب مسرة","وأي سرور مثل ما قد سررناه",76,"ن",3,0],["فَقَد ماتَ مَعروفٌ وَماتَت تِجارَةٌ","وَماتَ غَناءٌ يَومَ وَدَّعتَ ماضيا",77,"ي",2,0],["فقد مات خير الناس والدين كامل","غني عن التبيين من كل ملحد",78,"د",1,0],["فقد مسنا ياذا العزيز وأهلنا","من الضر ما أشقى القلوب وشققا",79,"ق",2,0],["فقد مَرّ بي عامٌ وعامٌ ولم أزر","جوانبَ ذلك السوح وهو رحيبُ",80,"ب",1,0],["فَقُدماً رَأى مِنّا المُهَلَّبُ فُرصَةً","فَها تِلكَ أَعدائي طَويلٌ سُرورُها",81,"ر",3,0],["فقدِّم ليلةَ الاثنين ذكراً","وقدِّم فضلَهَا عن كُلِّ ليلِ",82,"ل",1,0],["فقدِّم لها التَكيَاتِ أوَّلَ فَجوَةٍ","على قَدَرِ الحَايَاتِ يا ابنَ الكريمةِ",83,"ه",1,0],["فَقَد ماتَ ذُو المَجد الرَفيع محمد","هُوَ الفاضل القُوصي رَب سَناه",84,"ا",2,0],["فَقِدماً قَد خَضَبنا وَجهَ أَرضٍ","وَأَخضَعنا المَمالِكَ وَالرِّقابا",85,"ب",2,0],["فقد مضَى حيّاً نسكه","موحّداً لله يستغفر",86,"ر",1,0],["فقد مات حظوظ سعدك انتجب","حملاً ووضعاً إذ أتت بمحمد",87,"د",1,0],["فقدم لها مهر القبول تكرما","فما ثم من بكر تفض بلا مهر",88,"ر",1,0],["فقدماً دعوني اب