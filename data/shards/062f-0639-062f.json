{"poems":[[47,"دع دموعي في ذلك الاشتياق","https://www.aldiwan.net/poem65177.html","الخفيف"],[30,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[136,"هاج ما اكتن من دفين الدار","https://www.aldiwan.net/poem54898.html","البسيط"],[259,"رددي بعدي وجيبي","https://www.aldiwan.net/poem24956.html","مجزوء الرمل"],[302,"لو أبانت حجابها أسماء","https://www.aldiwan.net/poem33339.html","الخفيف"],[411,"دع دموعي يسلن سيلا بدار","https://www.aldiwan.net/poem49964.html","الخفيف"],[572,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[591,"هات قل لي كم الجفا والدلال","https://www.aldiwan.net/poem17650.html","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56060","المتدارك"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53226","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91529","المجتث"],[5431,"مأساة نينوى ....","https://www.poetsgate.com/ViewPoem.aspx?id=203771",""],[5672,"من بقايا الرثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=206450",""]],"verses":[["دَع دُموعي في ذَلِكَ الاِشتِياقِ","تَتَناجى بِفِعلِ يَومِ الفِراقِ",0,"ق",1,1],["دَعدِع بِأَعنَقِكَ التَوائِمَ إِنَّني","في باذِخٍ يا اِبنَ المَراغَةِ عالي",1,"ل",2,0],["دَعدُ هَلاَّ شَفَيتِ قَلبَ مُعَنّى","مُستَجنٍّ مِن لاَعِدِ الأهوَاءِ",2,"ا",2,0],["دَعدُ كَم بِتُّ مُغرَماً بِكِ مُشتَا","قاً سميراً للنجم والجَوزَاءِ",2,"ا",2,0],["دَعدُ إنني لم يُنسِنِيكِ التَّنَائِى","لاَ ولاَ طولٌ صَدِّكُم عَن لِقَائِى",2,"ا",2,0],["دَعْ دموعي شاهداتٍ","إذْ فلا من مستجيبِ",3,"ب",1,0],["دَع دَعاوى قَومٍ أَتوها بِجَهلٍ","فالدَعاوى أَبناءُها أدعياءُ",4,"ا",2,0],["دَعْ دُموعي يسِلْنَ سَيلاً بِدار","وضُلوعي يصلَيْنَ بالوَجدِ نارا",5,"ر",2,1],["دَعْ دُمُوعِي عَلَى الأَحِبَّةِ تَجْرِي","وَاجْتَنِبْنِي فَلَسْتُ مِنْ أَخْدَانِكْ",6,"ك",1,0],["دَعْ دَلالَ الجمالِ وَانْصِفْ وَقُلْ لي","أَيُّ شَيءٍ مِنَ الصُّدودِ حَلالُ",7,"ل",1,0],["دعدٌ بالحسن لمفردةٌ","وانا بمحبتها الفردُ",8,"د",1,0],["دعدعوا الكأس واشربوها فمن","نَقَّصَ أَفضت به إلى النقصان",9,"ن",1,0],["دَع دُموع العين فلتَصُبِ","وَسِهام البين فلتُصِبِ",10,"ب",1,1],["دَع دَع فؤادي وَحالَهْ","وَانظر تَرى أَيَّ حالهْ",11,"ل",2,1],["دعْ درّة الأزمان وامسح رملها !!","شرب الظلام من الوكور وماارتوى",12,"و",2,0],["دع دارهم واذهب لزور قبورهم","كن مثل حرف راح في اعجامه",13,"م",2,0]]}