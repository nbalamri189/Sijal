www.aldiwan.net/poem34883.html","المتقارب"],[447,"يزهو القريض به","https://www.aldiwan.net/poem972.html",""],[456,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[456,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[456,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[456,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[456,"أنا اليوم مما تعهدين بعيد","https://www.aldiwan.net/poem56239.html","البسيط"],[456,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[456,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[456,"الآن إذ برد السلو ظمائي","https://www.aldiwan.net/poem56313.html","الكامل"],[459,"جزاك الله مجد الدين خيرا","https://www.aldiwan.net/poem15284.html","الوافر"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[462,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[466,"وصديق سروره بالصديق","https://www.aldiwan.net/poem59814.html","الخفيف"],[466,"يا معاذي حقا ويا أستاذي","https://www.aldiwan.net/poem60142.html","الخفيف"],[469,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[475,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[477,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[481,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[498,"رعى الزمان فرأى العجائبا","https://www.aldiwan.net/poem37663.html","الرجز"],[498,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[498,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[503,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[513,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[513,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[513,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[527,"مولاي ذا الكرامه","https://www.aldiwan.net/poem37163.html","منهوك المنسرح"],[534,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[549,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[549,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[549,"قد كان لي غلس لا فجر يمزجه","https://www.aldiwan.net/poem47741.html","البسيط"],[549,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[560,"كريم قد تولاه الكريم","https://www.aldiwan.net/poem52763.html","الوافر"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[573,"ليس حظي من الهوى","https://www.aldiwan.net/poem2881.html","مجزوء الخفيف"],[573,"فرطت فيك فلوعتي لا تنقضي","https://www.aldiwan.net/poem2921.html","الكامل"],[573,"هلال ولكن السعود منازله","https://www.aldiwan.net/poem3023.html","الطويل"],[573,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[584,"أما وتمايل الغصن النضير","https://www.aldiwan.net/poem17536.html","الوافر"],[585,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["وَصَدَّعَت غُمدانَ عَن مَرضومَةٍ","جَوبَكَ بِالمِقراضِ أَثوابَ الرَدَن",0,"ن",1,0],["وَصَدرٍ وَسيعٍ عَلى النائِباتِ","يُجيلُ إِذا غَبَّ رَأياً وُساعا",1,"ع",2,0],["وَصَدَدْتُ عَنْ تِلْكَ المَراشِفِ عِفَةًّ","فَالرِّيقُ خَمْرٌ وَالحَبابُ ثُغورُها",2,"ر",3,0],["وصَدّقَ قَوْلي فيكَ أفعالُكَ التي","أبَتْ لقَريضي أن أوَشِّحَهُ كِذْبا",3,"ب",2,0],["وَصَدَّت بِوَجهٍ يَبهَرُ الشَمسَ حُسنُهُ","إِذا أَبصَرَتهُ العَينُ حارَت وَزَلَّتِ",4,"ت",1,0],["وَصَدَّ عَنِ الآيَاتِ مَنْ سَبَقَتْ لَهُ","شَقَاوَتُهُ فِي سَابِقِ الْقَدَرِ الْحَتْمِ",5,"م",1,0],["وصدَمْتَ بحْرَ الخَطْبِ دونَ ذِمامِهِ","ما بيْنَ غرْبِ مثقّفٍ وغِرارِ",6,"ر",1,0],["وَصَدوحٍ إِذا يُهَيِّجُها الشَر","بُ تَرَقَّت في مِزهَرٍ مَندوفِ",7,"ف",1,0],["وَصَدَقتَ إِنَّ دِمَشقَ جَنَّةُ هَذِهِ ال","دُنيا وَلكِنَّ الجَحيمَ أَلَذُّ لي",8,"ي",1,0],["وَصِدقَ مَواعيدٍ إِذا قيلَ إِنَّما","يُصَدِّقُ موعودَ المَغيبِ يَقينُها",9,"ن",3,0],["وَصَدَّقتَ بِالفِعلِ المَقالَ مَعَ الَّذي","أَتَيتَ فَأَمسى راضِياً كُلُّ مُسلِمِ",10,"م",1,0],["وَصَدِيقاً فِي وُدِّهِ لا يُدَاجِي","وَصَدُوقاً بِعَهْدِهِ لا يَمِينُ",11,"ن",1,0],["وَصَدْرُهَا أُفْقٌ بَدَا كَوْكَبٌ","فِيهِ كَأَنَّ النُّورَ مِنْهُ ابْتِسَامْ",12,"م",1,0],["وصِدْقِ وُدٍّ وَعَهْدٍ","يَشِفُّ عَنْ طَهْرِ خِيمِ",13,"م",1,0],["وَصَدَّقَ في بَكرٍ مَواعيدَ ضَيفِهِ","وَثَوَّرَ بِاِبنِ الغَمرِ وَالنَقعُ ثائِرُ",14,"ر",1,0],["وصدَّ عمَّا يروم اللوم نائله","فما تفيد ولا تجدِي الملامات",15,"ت",1,0],["وصدر لما يلقى من السرِّ لائق","وكوكب فضلٍ في سما الملك لائح",16,"ح",1,0],["وصدرٍ تقبل الكلمات منه","فتجلسها المسامع في الصدور",17,"ر",1,0],["وصدراً فيهِ للرحمن سرٌّ","كذاك الصدر موطن كلّ سر",18,"ر",1,0],["وصديق أنشدته ليَ بي","تين حوت في الصداع معنًى بديعا",19,"ع",2,1],["وصديقٍ أجبتُهُ إذ دعاني","نحو معروفه فلم ألق رُشْدا",20,"د",2,1],["وصدرت عما قال فيك مجرِّبٌ","لا عن مقالة عائفٍ ومعيفه",21,"ف",2,0],["وصدَّقَهم من قد عرفتُ مكانه","فمزِّق منا الشلوُ كلَّ ممزق",22,"ق",1,0],["وصدّقْ أناساً فضَّلوك فأطنبوا","وكذّب من الحُسّادِ مُنْتقِصيكا",23,"ك",2,0],["وَصَديقٍ لي صَدوقٍ","وَرَفيقٍ بي رَفيقِ",24,"ق",1,0],["وَصَدَّ ذَواتُ الضِغنِ عَنّي وَقَد أَرى","كَلامِيَ تَهواهُ النِساءُ الجَوامِحُ",25,"ح",1,0],["وَصَدَّقَت فيَّ أَقوالاً تَقَوَّلَها","واشٍ وَما أَنا لِلواشي بِمِطواعِ",26,"ع",1,0],["وَصَدَرَ المَرسومُ بِالأَمانِ","في الأَرضِ لِلقاصي بِها وَالداني",27,"ي",1,0],["وَصَدَقتُ في حُبّي فَلَستُ مُبالِياً","أَن أُمنَحَ الدُنيا بِهِ أَو أُمنَعا",28,"ع",2,0],["وَصَدَرتَ أَغنَمَ صادِرٍ عَن مَورِدٍ","مَرفوعَةً لِقُدومِكَ الأَبصارُ",29,"ر",1,0],["وَصُدورُ الجِيادِ في جانِبِ البَح","رِ فَلَولا الخَليجُ جُزنَ ضَحاءَ",30,"ا",2,0],["وَصَدَّهُ عَنكَ عَزمٌ صادِقٌ وَيَدٌ","طَويلَةٌ وَحُسامٌ صارِمٌ يَقِدُ",31,"د",1,0],["وَصَدَّ الغَواني عِندَ إيماضِ لِمَّتي","وَقَصَّرنَ عَن لَبَّيكَ ساعَةَ مَنطِقِ",32,"ق",1,0],["وَصَدرٍ أَمينِ الغَيبِ يُهدي إِلَيهِمِ","نَصيحَةَ حَرّانِ الجَوانِحِ مُشفِقِ",32,"ق",1,0],["وَصَدَّت لا الوِصالُ لَها بِقَصدٍ","وَلا الإِسعافُ مِنها بِالمُخيلِ",33,"ل",1,0],["وَصَدَّت رَبيعَةُ عَن شاعِرٍ","يُسَمّى رَبيعَةَ أَخوالَهُ",34,"ل",2,0],["وصدره.. ونحره.. كفاكم","فلن أبوح باسمه حبيبي",35,"ب",2,0],["وصَدَّعَنِ البِيضِ الحِسانِ وقد بَدَت","فأَبدَتْ لعَينيهِ المَحاسِنَ أجمَعا",36,"ع",2,0],["وَصَدْرٍ وراءَ السَّابريِّ خَرَقْتَه","فكان ثِقافَ الرُّمحِ لمَّا تأوَّدا",37,"د",2,0],["وَصَدَّهُمُ الهَوى أَن يُؤمِنوا بي","وَقالوا إِنَّ مُعجِزَهُ مُحالُ",38,"ل",1,0],["وَصَدَّت يَميناً عَن شُمَيطٍ وَجاوَزَت","رُبى قَطَنٍ وَالشُهبُ قَد شَفَّ نورُها",39,"ر",3,0],["وَصَدَّت وَقَد شَبَّهتُ بِالبَدرِ وَجهَها","نِفاراً وَقالَت صِرتَ تَطمَعُ في شَتمي",40,"ي",1,0],["وصديقاً لا ينثني ووفياً في","الزمانِ الضنينِ بالأوفياءِ",41,"ا",2,0],["وصدحةُ الطيرِ تهفو","للجدولِ المختالِ",42,"ل",1,0],["وصدت نواحيكِ هدارةً","كما أغضبت أسداً موثقاً",43,"ق",2,0],["وصَدَّ عنها وخلاَّها وقد دَمِيَت","في قبضة الموت غَشَّاها وظلّلها",44,"ل",3,0],["وَصَدَقتِ إِنَّ الرِزقَ يَطلُبُ أَهلَهُ","لَكِن بِحيلَةِ مُتعَبٍ مَكدودِ",45,"د",1,0],["وَصَدرِ نادٍ نَظَمنا","بِهِ القَوافِيَ عِقدا",46,"د",2,1],["وَصَدَّ اِبنَ فَرّاسَ عَن نَصرِها","تَلَظّي حِرابٍ دَوامي المُقَل",47,"ل",1,0],["وصَدُّوا عن سبيلِ الله بَغياً","وكان البَغْيُ مَجلبةَ الدَّمارِ",48,"ر",1,0],["وصدَّ مُستكبراً يلوِي لشقوتِه","رأساً يغيظ الظُّبَى أن ليس يُهتَصَر",49,"ر",1,0],["وصدورٍ كأنهنَّ قبورٌ","مظلماتٌ قلوبهمْ مَوتْاها",50,"ا",3,0],["وَصَدى اليَأس رَجّعته ضُلوعي","أَو بُكائي عَلى أَمان الشَبابِ",51,"ب",1,0],["وَصَدَّها لِلشَقاءِ عَن طَلَبِ","الجَنَّةِ دُنيا الآِلَهُ ما حِقُها",52,"ق",3,0],["وصَدَّقَهُ وحَكَّمَهُ صَبيّاً","مِنَ الكُفَّارِ شُبَّانٌ وشِيبُ",53,"ب",1,0],["وصدَرْتَ تَح