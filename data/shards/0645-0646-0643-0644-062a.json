{"poems":[[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[234,"يا عم لا زلت في النعماء محبورا","https://www.aldiwan.net/poem51044.html","البسيط"],[240,"إن كان دينك في الصبابة ديني","https://www.aldiwan.net/poem31741.html","الكامل"],[463,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[563,"غير الوجود محال","https://www.aldiwan.net/poem34222.html","المجتث"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144129","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144118","السريع"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77273","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36409","الدوبيت"],[276,"إليهِ بهِ سبحانهُ أتوسلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59268&r=&rc=7",""]],"verses":[["من كلِّ تمّ حقّ أن يسمي","ضياؤه المشرق بدر التمّ",0,"م",1,0],["مَن كُلِّ تَلعاءِ المَناكِبِ جيدُها","يُغني عَنِ القَرَبوسِ يَومَ طِرادِ",1,"د",1,0],["من كلّ تفّاحة زهراءَ مُذْهَبة","كأنها حشيت مسكاً وكافورا",2,"ر",2,0],["مِن كُلِّ تائِهَةٍ عَلى أَترابِهِا","بِالحُسنِ غانِيَةٍ عَنِ التَحسينِ",3,"ن",1,0],["من كلِّ تاركةٍ ولم تعطف له","بوّاً وطارحةٍ بمضيعة سَلا",4,"ل",2,0],["من كل تقدير شيء","في العلم منه مثال",5,"ل",1,0],["من كلّ تيس خرق بارد","ثيابه غمد بلا نصل",6,"ل",1,1],["من كلّ تيسٍ خرِفٍ باردٍ","ثيابُه غِمدٌ بلا نصْلِ",7,"ل",1,0],["مِن كُلِّ تارِكِ أَهلِهِ في حَسرَةٍ","يَبكونَ مَن ضَلّوا الطَريقَ وَمَن عَموا",8,"م",3,0],["من كل تغيير تولى حفظه","رب العباد فنوره لألاء",9,"ا",2,0],["مِن كِلَّتِهِ تَبَرَّجَ الوَردُ فقُم","واشربه عَلى تهتُّك المَنثورِ",10,"ر",1,0],["منْ كلتِ الأفهامُ عنْ وصفِ ذاتهِ","فليسَ لها في الكيفِ والأينِ مدخلُ",11,"ل",1,0]]}