1,0],["مَا لَمْ يَفِدْ لَفْظُ الشِّفَاهِ أَفَادَهُ","لَحْظُ العُيُونِ بِأَفْصَحِ البَيَّانِ",3,"ن",1,0],["مَا لَمْ يَعُدْ ذَاكَ الزَّمَانُ وَأَهْلُهُ","وَالعَادُ وَالأَخْلاقُ حَتَّى جُرْهُمِ",4,"م",1,0],["ما لُمنا عَميرَةَ غَيرَ أَنّا","نَزَلنا بِالعُرَيجِ فَما قُرينا",5,"ن",2,1],["ما لِمَن وَكَّلُ الهَوى مُقلَتَيهِ","بِاِنسِكابٍ وَقَلبَهُ بِزَفيرِ",6,"ر",1,0],["ما لمنْ لامَ فيكمو من جواب","غير دمع جفانهُ كالجوابي",7,"ب",2,1],["ما لمن يُغمَزُ في أنسابه","ولِعَيبِ الشعرِ من أهل الأدبْ",8,"ب",1,0],["ما لمن حَسَّنَهُ اللَّ","هُ وأعْلَى دَرَجاتِهْ",9,"ت",2,1],["ما لما تصطليه من وجنتَيْها","غير تَرْشافِ رِيقِها تَبْريدُ",10,"د",1,0],["مالٌ مولٍّ وأسبابٌ مخيَّبةٌ","في دولة الفوزِ ما هذا بمحتملِ",11,"ل",1,0],["ما لمتُ نَفْساً أصبحتْ","غَرْثَى إليها شرههْ",12,"ه",2,0],["ما لمن كان حقودا منطق","قتل الحاقد ما انحسه",13,"ه",1,1],["مالم يِبد منها على يد أهله","أخنى عليه تطاول الآباد",14,"د",1,0],["ما لِمَن يَنصِبُ الحَبائِلَ في الأَر","ضِ وَمَرجاهُ أَن يَصيدَ الهِلالا",15,"ل",2,0],["ماّلمَرءُ تُخبَرُ عَن حَقيقَةِ سَروِهِ","كَالمَرءِ تَخبُرُ سَروَهُ وَتَراهُ",16,"ا",2,0],["ما لَم تَكُن لَكَ فيهِ مَنفَعَةٌ","مِمّا مَلَكتَ فَلَستَ تَملِكُهُ",17,"ك",2,0],["ما لَمَسناهُ وَلَكِن","كادَ مِن لَحظٍ يَذوبُ",18,"ب",1,0],["ما لمن يهوى جمالا زائلا","وعلى البدر جمال ما يُزال",19,"ل",1,0],["ما لمطران يا فَلسطين شَأن","بِكَ لَكن لَهُ بنيرونَ شان",20,"ن",1,0],["ما لمْ تقمْ بالعبئِ أن","تَ فَمَنْ يقوم به إذن",21,"ن",1,0],["ما لمْ يكنْ فَضْلٌ يَزي","نك فالظُّورُ هو الفجورُ",21,"ر",1,0],["ما لموسى وَلا لعِيسى حَوارِي","يُونَ في فَضْلِهم وَلا نُقَبَاءُ",22,"ا",2,0],["ما لُمتُ حَمّاداً عَلى فِسقِهِ","يَلومُهُ الجاهِلُ وَالمائِقُ",23,"ق",1,1],["ما لِمُؤسى عِندَ صَبِّ","حاجَةٌ فَاِغلي وَذوبي",24,"ب",2,0],["ما لُمتُ في أَفعالِهِ صالِحاً","بَل خِلتُهُ أَحسَنَ مِنّي ضَمير",25,"ر",1,1],["ما لمتني يوماً عَلى تَقصيري","إلا جرحت بِما تَلوم ضَميري",26,"ر",2,1],["مَا لَمْ يُضعْ فِي بَاطِلٍ حَقَّهُ","وَتَقْتُلِ الشَّهْوَةُ فِيهِ الرَّشَادْ",27,"د",1,0],["مَا لِمِصْرٍ شِبْهَُ قَبْرٍ وَاسِعٍ","مُنْذُ فِرْعَوْنَ وَمَنْ فِيهَا رُفَاتُ",28,"ت",1,0],["ما لِمُنجِداتِ رِكا","بي وَما لِغُوَّرِها",29,"ر",3,0],["ما لما قد بنيته من صروح","للأماني فخمة من أساس",30,"س",1,0],["ما لما قد قضيته من مرد","ما لما قد خططت من تغيير",30,"ر",1,0],["ما لِمِثلي عَلى هَواهُ نَصير","لا وَلا مُسعف يَرى وَظَهير",31,"ر",1,0],["مالمت لو تدري","كالقوم حسناه",32,"ا",2,0],["ما لُمتُ قَومَيهِما إِلّا لِأَنَّهُمُ","إِذ حانَ يَومُهُما قَلّوا وَإِن كَثُروا",33,"ر",3,0],["ما لمحيَّاك يروقُ الضحى","وما لأعطافكَ تَسْبي الغصون",34,"ن",1,0],["ما لمر النسيمِ يجرحُ خديكِ","ومرُ النسيمِ مثل عتابي",35,"ب",2,0],["ما لمنْ فارقَ الحبيب جفونٌ","تعرفُ الليلَ بعدهُ والنهارا",36,"ر",2,0],["ما لم يكن من غابر قد صدرا","بالتاء زائداً فلن يغيرا",37,"ر",2,0],["ما لم يكن ذا أربع فيبتدا","بهمز قطع وافتحنه ان بدا",37,"د",2,0],["ما لم يكن مهموزاً او مضعفا","أو ذا اعتلال بالصحيح اتصفا",37,"ف",2,0],["ما لم يكن مضارعاً ذو الأربع","فاليا تزاد فيه دائما غه",37,"ه",1,0],["ما لمحرومين لم يستمعا","ذلك الصوت لذي دوّى صداه",38,"ا",2,0],["ما لمعشوقها شِفاءٌ سوى اللثْ","م لها والعناق حتى يُفيقا",39,"ق",2,0],["ما لِماءِ الوَردِ في القِس","مَةِ جَورِيّاً يَجورُ",40,"ر",1,0],["ما لِماءِ الوَردِ يا مَن","خُلقُهُ سَهلٌ دَميثُ",41,"ث",1,0],["مَا لِمَنْ مَسَّهُ مِنَ الْفَقْرِ دَاءُ","غَيْرَ قَصْدِ رَبِّ الْجَمَالِ دَوَاءُ",42,"ا",2,1],["ما لم تنافق فاتخذ نفقا به","ترجو السلامة منهم أو سلما",43,"م",2,0],["ما لِمَن يَمدَحُهُم مِن","هُم سِوى خُفَّي حُنَينِ",44,"ن",1,0],["ما لِميادينِها وَلِلشَرَفِ ال","أَعلى نَظيرٌ بِكُلِّ مَنظورِ",45,"ر",1,0],["ما لم تكن قطب هذا الجمع زهرته","فارحم قلوبا وعد ان فزت بالأرب",46,"ب",1,0],["مالَ مع الدهرِ على رَوعتي","وَلَم يَمل يوماً عليه مَعي",47,"ع",2,0],["ما لَم تَكُن مِن لَيالي الأَشهُرِ الحُرُمِ","أَمّا الصَحابَةُ مَن خَلوا تِجارَتَهُم",48,"م",1,0],["ما لِما قَدَّرَه اللَ","هُ مِنَ الأَمرِ مَرَدُّ",49,"د",1,0],["ما لِمَدْحي لدَيْكَ قَدْرٌ ولكنْ","كرَمُ الطّبْعِ هَزَّ لي منك عِطْفا",50,"ف",2,0],["ما لِمواعيدِكَ قد أَصبحَتْ","جَزاؤها يَهزَأُ بالشّرط",51,"ط",1,0],["ما لِمَن ساجَلَتكَ كفَّاهُ في جُو","دِكَ إلا التَّفويضُ والتَّسلِيمُ",52,"م",1,0],["ما لم يَكن من مَعشَرٍ","غَدروا وقد شهِدوا الغَديرا",53,"ر",2,0],["ما لم يكُن منهم أوا","ئِلهم كذلكَ والأواخِر",54,"ر",1,0],["ما لم ظفرت أنا بالفوز منفرداً","بأجر نصحي يقيناً غير مظنون",55,"ن",1,0],["ما لم فإن الصلح خير إنه","قد سنَّه الأسلاف للأخلاف",56,"ف",1,0],["ما لِمَنْ حَلَّلَ قتلي في الهوى","حَرَّم الوصل وما كانَ حراما",57,"م",2,0],["ما لمن في الهوى من خلاقِ","فأقِلاّ ملامةَ العشاقِ",58,"ق",1,1],["ما لما قدّمته راحم","قد قضى الشرع المنيف الكريم",59,"م",1,0],["ما لمتُ طرفَكِ أختَ غاضرة","في السقم عن شكٍّ ولا جهلِ",60,"ل",1,0],["ما لمُريدِ حسنِها","إلا الأسى والكمدُ",61,"د",1,0],["ما لمتُ دهري على شيء غضبت له","من الحوادث حتى جارَ في القسم",62,"م",1,0],["ما لمعتْ منكَ سنا شعلةٍ","اِلاّ وسحَّتْ منهمُ الأدمعُ",63,"ع",1,0],["ما لَمْ يَلُحْ لذَوي الأَفْهامِ أَنَّ بِذا","كَ النَّقْلِ وَهْماً لأَمْرٍ مِنْهُ مَفْهومِ",64,"م",1,0],["مَا لِمَنْ فَازَ بِسَبْقٍ","في بَني الدّهْرِ صَدِيقُ",65,"ق",1,0],["ما لِمُراكشٍ تَفيضُ سُروراً","وأهَاليها باسِماتٍ ثُغورا",66,"ر",2,1],["ما لَمحُ عَينِ الرائي","أمامَه إن يركَب",67,"ب",1,0],["ما لمنْ ينصف أنْ يُل","حى على غير القبيحِ",68,"ح",1,0],["ما لم أراه بكم منكم لدي بني","وسر طلعتكم يا ساكني بدني",69,"ي",1,0],["ما لم يحل بينهما موصل","لبرد ماء حر نيران",70,"ن",1,0],["ما لم يذد عنه بغالي الثمن","ويجعل الأقدام من دابه",71,"ه",1,0],["ما لِمَجدي قالَت مَعاليك أرخ","نُور شَمس الأَمين في مَصر عيد",72,"د",1,0],["ما لمرضَى الأغراض يبغون بالأل","سن برءاً وفي البطون السموم",73,"م",1,0],["ما لم تنله بالفتوح بلغته","بجلال أخلاق وطيب خلال",74,"ل",1,0],["ما لمن ضاق أمس بالحكم أضحى","يتعدى عليك بعد اعتزاله",75,"ل",2,0],["ما لما أوليتني عن","أعينَ الناسِ استتار",76,"ر",1,0],["ما لم يكن عضداً له ذو همة","عليا بعيني سؤدد مرموق",77,"ق",1,0],["ما لم تكن لحدود دين","اللّه فيه ذا إِطراحِ",78,"ح",1,0],["ما لَمْ يَكُنْ مَعْ قُوَّةٍ قُدْسِيَّهْ","لاََِخْذِهِ الْمَسائِلِ الْفَرْعِيَّهْ",79,"ه",1,0],["ما لِمَبنى لَيسَ فيه","مِن غَريبات المَباني",80,"ن",2,1],["ما لمت قط بكل عمري مكرما","قد ملّ مني أو تعذرّ بالعطا",81,"ط",2,1],["ما لمِل