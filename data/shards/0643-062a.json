,[105,"ذهب السرور وولت الأعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54941&r=&rc=111",""],[99,"الى صديقة جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=347&r=&rc=53",""],[31,"يا عَمْرَ حُمَّ فِرَاقُكُمْ عَمْرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18884&r=&rc=147",""],[3,"كأَنَّ السرَايا بينَ قَوٍّ وقارة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10655&r=&rc=9",""]],"verses":[["كَتَبَت سُطوراً مِن مَناسِمِها","فَوقَ الأَباطِحِ وَالسُرى يُملي",0,"ل",2,0],["كَتَفَتُّحِ النُوّارِ فَتَّقَهُ الحَيا","أَو كَالصَباحِ فَرى الدُجى بِعَمودِ",1,"د",1,0],["كَتَمَت دِماءَكُمُ الظُبى","كَالشَيبِ يَكتُمُهُ الخِضابُ",2,"ب",1,0],["كَتَمْنا الهَوى وكَفَفْنا الحَنينا","فلَمْ يَلْقَ ذُو صَبوَةٍ ما لقِينا",3,"ن",2,1],["كَتائِبُ لَولا أنّ للسَّيْفِ رَوْعَةً","كَفاها العِدا الرّأيُ الإمامِيُّ والكُتْبُ",4,"ب",1,0],["كَتَكاليفِ قَومِنا إِذ غَزا المُن","ذِرُ هَلِ نَحنُ لابنِ هِندٍ رِعاءُ",5,"ا",2,0],["كَتائِبُ تُجزى فَوقَ كُلِّ كَتيبَةٍ","لِواءٌ كَظِلِّ الطائِرِ المُتَقَلِّبِ",6,"ب",1,0],["كَتائِبَ شُهباً فَوقَ كُلِّ كَتيبَةٍ","لِواءٌ كَظِلِّ الطائِرِ المُتَصَرِّفِ",7,"ف",1,0],["كِتابُ مَظلومٍ إِلى ظالِمِ","يَشكو إِلَيهِ مِن جَوىً لازِمِ",8,"م",1,1],["كَتَبَ الحُبُّ في فُؤادي كِتاباً","هُوَ بِالشَوقِ وَالضَنى مَختومُ",9,"م",1,0],["كِتابُ حَبيبٍ جاءَني بَعدَ جَفوَةٍ","فَظَلَّت تَناجي مُقلَتَيَّ أَنامِلُه",10,"ل",2,1],["كَتَبَت في الكِتابِ فَوزٌ فَقالَت","في عِتابٍ مِنها وَفي إِلطافِ",11,"ف",1,0],["كَتَمتُ اِسمَها كِتمانَ مَن صانَ عِرضَهُ","وَحاذَرَ أَن يَفشو قَبيحُ التَسَمُّعِ",12,"ع",1,0],["كَتَبَ الحُبُّ في جَبيني كِتاباً","بَيِّناً كَالكِتابِ في القُرطاسِ",13,"س",1,1],["كَتَمتُ وَمَن أَهوى هَوانا فَلَم نَبُح","وَقَد كانَتِ الأَسرارُ بِاللَمحِ تَظهَرُ",14,"ر",1,1],["كَتَبَت بِأَن لا تَأتِني فَهَجَرتُها","لِتَذوقَ طَعمَ الهَجرِ ثُمَّ أُعاوِدُ",15,"د",1,0],["كَتَبتُ فَلَيتَني مُنّيتُ وَصلاً","وَلَم أَكتُب إِلَيكِ بِما كَتَبتُ",16,"ت",1,1],["كَتَبتُ وَقَد شَرِبتُ الراحَ صِرفاً","فَلا كانَ الشَرابُ وَلا شَرِبتُ",16,"ت",1,0],["كَتَبتُ اِسمَها في راحَتي وَلَثَمتُهُ","أُقَبِّلُهُ طَوراً وَطَوراً أُعاتِبُه",17,"ه",1,1],["كَتَبَت تُعَيِّرُني بِطولِ صُدودِكُم","وَاللَهُ يَعلَمُ كَيفَ كانَ جَوابي",18,"ي",1,0],["كَتَبتُ إِلى ظَلومَ فَلَم تُجِبني","وَقالَت ما لَهُ عِندي جَوابُ",19,"ب",1,1],["كِتابٌ جاءَ وَالرُقَباءُ حَولي","إِذا ما مَرَّ طَيرٌ بي اِستَرابوا",19,"ب",3,0],["كَتَبتُ فَأَكثَرتُ الكِتابَ إِلَيكُمُ","عَلى رَغبَةٍ حَتّى لَقَد مَلَّ كاتِبي",20,"ب",2,0],["كَتَمتُ الهَوى وَهَجَرتُ الحَبيبا","وَأَضمَرتُ في القَلبِ شَوقاً عَجيبا",21,"ب",2,1],["كَتَبتُ كِتابي ما أُقيمُ حُروفَهُ","لِشِدَّةِ إِعوالي وَطولِ نَحيبي",22,"ب",2,0],["كِتابٌ أَتاني عَلى نَأيِها","يُخَبِّرُ عَن بَعضِ أَنبائِها",23,"ه",2,1],["كَتَبَ المُحِبُّ إِلى الحَبيبِ رِسالَةً","وَالعَينُ مِنهُ ما تَجِفُّ مِنَ البُكا",24,"ا",1,1],["كَتَمْتُ اشْتِيَاقِي وَالْنُّحُولُ يَنِمُّ بِي","كَأنِّي أَحَلْتُ الْكَتْمَ مِنِّي عَلَى جِسْمِي",25,"م",2,0],["كَتَبْتُ بِدَمْعِ عيني صَفْحَ خَدِّي","وَقَدْ مَنَعَ الْكَرَى هَجْرُ الْخَلِيلِ",26,"ل",1,1],["كَتَائِبُ أَمْثَالِ الْكِتَابِ تَتَالِياً","فَمِنْ بِيضِهَا شكْلٌ وَمِنْ سُمْرِهَا نَقْطُ",27,"ط",1,0],["كتبْتُ وقدْ نازَعْتُ فيكَ مُلاءَةً","كسَتْني شُحوباً في المُلاءِ المورَّسِ",28,"س",1,0],["كَتَمَيُّلِ النَشوانِ يَر","فُلُ في البَقيرَةِ وَالإِزارَه",29,"ر",2,0],["كَتائِبُ مِن بَني ذُهلٍ","عَلَيها الزَغفُ قَد نُظِما",30,"م",2,0],["كَتومِ الرُغاءِ إِذا هَجَّرَت","وَكانَت بَقِيَّةَ ذَودٍ كُتُم",31,"م",1,0],["كَتَيسِ الإِرانِ الأَغفَرِ إِنضَرَجَت لَهُ","كِلابٌ رَآها مِن بَعيدٍ فَأَحضَرا",32,"ر",2,0],["كَتِلكَ النُقوشِ الزاهِياتِ بِمَعبَدٍ","لِفِرعَونَ لا زالَت عَلى الدَهرِ تَسلَمُ",33,"م",1,0],["كَتَبَ المَنفِيُّ سَطراً لِلَّذي","جاءَهُ بِالعَفوِ فَاِقرَأ وَاِعجَبِ",34,"ب",1,0],["كَتَمتُ فَقالوا شاعِرٌ يُنكِرُ الهَوى","وَهَل غَيرُ صَدري بِالغَرامِ خَبيرُ",35,"ر",1,0],["كَتائِبٌ أَضحَتِ البَيداءُ مُتأَقَةً","مِنها وَضاقَت بِها البُطنانُ وَالحَدَبُ",36,"ب",1,0],["كِتابي عَن وِدادِكَ لا يَزولُ","وَعَهدي مِثلَ عَهدِكَ لا يَحولُ",37,"ل",1,0],["كَتيبَتُهُ مُلَملَمَةٌ رَداحٌ","إِذا يَرمونَها تُنبي النِبالا",38,"ل",2,0],["كَتَيسِ الظِباءِ الأَعفَرِ اِنضَرَجَت لَهُ","عُقابٌ تَدَلَّت مِن شَماريخَ ثَهلانِ",39,"ن",1,0],["كِتَابُ تَفْدِيَةٍ أَوْعَتْ صَحَائِفُهُ","أَدْعَى الفُصُولِ إِلى الإِعْجَابِ وَالعَجَبِ",40,"ب",1,0],["كِتَابُكِ فِي الرَّشِيدِ كِتَابُ صِدْقٍ","هُوَ التَّارِيخُ رُدَّ إِلَى الحَقِيقَهْ",41,"ق",2,1],["كَتَبَ الفَتَى سَلْمَى وَخَطَّتْ يُوسُفُ","وَإِلَيْكَ مَا عَنيَا بِبَعْضِ بَيَانِ",42,"ن",1,0],["كَتَمْتَ هَوَاكِ دَهْراً لا لِخَوْفٍ","وَلا أَنَا مَنْ يُرَوِّعُهُ الحِمَامُ",43,"م",1,0],["كِتَابُ مُحَمَّد فِيهِ افتِنَانٌ","أفَاضَ مِنَ الحَديثِ عَلَى القَدِيمِ",44,"م",1,0],["كَتَبوا الصَكَّ عَلَيهِ","فَهوَ بَينَ الناسِ آيَه",45,"ا",3,0],["كتبتُ ودمعي بلَّلَ الركبَ قطرُهُ","وأجرى به بين الخيام السواقيا",46,"ق",3,1],["كتب الإله على العباد محبةً","لك كان فرض كتابها موقوتا",47,"ت",2,1],["كتبت كتاب المدح في وصف حسنه","فضاق ولم يستوعب الوصف طرسه",48,"س",2,0],["كتابان لم يُنزلهما اللَّه ربنا","على رُسْله إلاّ ليَسعَد أنسان",49,"ن",1,0],["كتبت لنفسي عهد تحريرها شعرا","وأشهدت فيما قد كتبت الدهرا",50,"ر",2,1],["كتبن في العلم أسفاراً سيدرسها","أهل البسيطة أجيالاً فأجيالا",51,"ل",2,0],["كَتُومٌ إذا ضَجَّ المَطِيّ كأنَّما","تَكَرَّمُ عن أخلاقِهِنَّ وَتَرغَبُ",52,"ب",1,0],["كتَائبَ تَحسُر الهَبَوَات عَنَّا","عوالي مَا حُدُنَ وَمَا عُلَينَا",53,"ن",2,0],["كَتَمَت هَوايَ وَقابَلَتهُ بِهَجرَةٍ","سَيّانِ إِن كَتَمَت وَإِن لَم تَكتُمِ",54,"م",1,0],["كَتَذَكُّرِ الصادي وَلَيسَ لَهُ","ماءٌ بِقُنَّةِ شاهِقٍ وَعرِ",55,"ر",1,0],["كَتائِبُهُم تَردي بِكُلِّ سَمَيدَعٍ","أَخي ثِقَةٍ في الحَربِ أَروَعَ بارِعِ",56,"ع",1,0],["كتب التواريخ تملينا وتخبرنا","عن سادةٍ من ذوي العلياءِ والرتب",57,"ب",1,0],["كتبت وقد وجدت من التشكي","ومسّ السقم أكثر ما وجدتا",58,"ت",2,1],["كتب الفناء على الشواهد حجة","غنيت عن الإقرار والإنكار",59,"ر",1,0],["كتب العبد خطه وهو في الفر","ش وما كلّ ما جرى منه يذكر",60,"ر",1,0],["كتاب مع المطل أحضرته","قليل الحلاوة إذ يلتمس",61,"س",1,1],["كتم الحبّ جهده فأزاعه","مدمع زاد قسمه فأشاعه",62,"ع",2,1],["كتمت الهوى في عشقه متفلسفاً","فأصبح عشقي قائلاً بكمونه",63,"ن",2,0],["كتاب مولانا بإشفاقه","لا يختشي من سفر ثقلا",64,"ل",2,0],["كتمته والحسن ليسَ يجتلى","والاسم لا يدخله من وإلى",65,"ل",2,0],["كَتَبتُ وَلَم أَكتُب إِلَيكَ وَإِنَّما","كَتَبتُ إِلى روحي بِغَيرِ كِتابِ",66,"ب",1,1],["كَتَمَتْهُ أمُّهُ آباءهُ","فلهذا أنكر القومُ النسبْ",67,"ب",1,0],["كتبتْ ربّةُ الثنايا العِذابِ","تتشَكَّى إليَّ طولَ اجتنابي",68,"ي",1,1],["كتلك التي أبدت ثرى البحر يابساً","وَشَقَّت عيوناً في الحجارة سُفَّحا",69,"ح",2,0],["كتطفيل سليمان","على إمرة بغداذا",70,"ذ",2,0],["كتّاب ملك إذا شئتم مقاتَلةً","يستنفر الملك منكم خير أنفار",71,"ر",1,0],["كتم اللسان عليك فاستمعت","فطنٌ لما جمجمت مستمعه",72,"ع",2,0],["كُتّابُ دولتِك الميمونِ طائرُها","أضحوا وهم أسوأ الكتّاب أحوالا",73,"ل",2,0],["كتضييعه ماءَ الرجالِ وخونِه","وليست لأرحام المخانيثِ أحمالُ",74,"ل",1,0],["كتومٌ لما أولى أخاهُ مُحدِّثٌ","أخاهُ بنُعْمى اللَّهِ غيرُ مُكاتمِ",75,"م",1,0],["كتابتُه مناقفةُ العوالي","وليستْ ما يُرَقِّشه القِلامُ",76,"م",1,0],["كتبتَ طولاً بأبياتٍ وجَدْتُ بها","خِفَّاً وقد كنتُ في ثِقْلٍ مِنَ المِحَنِ",77,"ن",1,0],["كَتَبَ الضَنى في وَجهِهِ هَذا الَّذي","كادَ الغَرامُ بِهِ يَؤولُ إِلى الفَنا",78,"ا",1,0],["كَتَبَ السَيفُ اِقرَأوا ما كَتَبا","لا يُنالُ المَجدُ إِلّا بِالجِهادِ",79,"د",1,0],["كَتَبَت بِلا حِبر وَعَزَّ عَلى","الأَقلامِ حَرفٌ دونَ ما حِبرِ",80,"ر",1,0],["كَتَبوا بِمَسفوكِ النَجيعِ نُعوتَهُم","وَبَنوا عَلى الجُثَثِ العُروشَ وَأَثَّلوا",81,"ل",3,0],["كَتُيورٍ في الأَسرِ تَبغي اِنعِتاقاً","قَبلَ أَن يُفسِدَ الإِسارُ لُغاها",82,"ا",3,0],["كَتَلاشي الشَمعَةِ المُحتَرِقَه","تَتَلاشى بَينَ ضِحكٍ وَعَويل",83,"ل",1,0],["كَتَبتُ إِلَيكَ أَشرَحُ في كِتابي","أُموراً مِن فِراقِكَ أَشتَكيها",84,"ي",3,1],["كِتابٌ رَأَيتُ الحُسنَ فيهِ مُفَصَّلاً","كَما فَصَّلَ الياقوتَ بِالدُرِّ ناظِمُه",85,"م",2,0],["كَتَمتُ حُبَّكُم عَن كُلِّ جارِحَةٍ","مِنَ المَسامِعِ وَالأَفواهِ وَالمُقَلِ",86,"ل",1,0],["كَتَبتُها مِن عَجَلٍ","بِدَهشَتي وَقَلَقي",87,"ي",1,0],["كَتَبتُها مِن آمِدِ","عَن فَرطِ شَوقٍ زائِدِ",88,"د",1,1],["كِتابٌ أَتاني مِن حَبيبٍ وَبَينَنا","لِطولِ التَنائي بَرزَخٌ أَيُّ بَرزَخِ",89,"خ",1,1],["كَتَ