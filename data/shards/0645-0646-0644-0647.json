https://poetry.dctabudhabi.ae/diwan/poem/83669","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83506","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83523","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28788","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139665",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4767,"دوحة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=179253",""],[4767,"حديث القلب","https://www.poetsgate.com/ViewPoem.aspx?id=181101",""],[1901,"كادّني العاذلُ كيدْا","https://www.poetsgate.com/ViewPoem.aspx?id=160377",""],[5057,"غنِّ يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=207360",""],[5064,"ليلٌ حاتِميٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=199087",""],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[3591,"أيها الموت قد أخذلت الرجالا","https://www.poetsgate.com/ViewPoem.aspx?id=149461",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5194,"القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=30640",""],[5324,"من وحي المرأة الحلم.","https://www.poetsgate.com/ViewPoem.aspx?id=211607",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5431,"إنّ ربي بمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=213011",""],[5525,"زل الطرب","https://www.poetsgate.com/ViewPoem.aspx?id=911",""],[5573,"العمر ينقضي بالوفا والتمام","https://www.poetsgate.com/ViewPoem.aspx?id=204529",""],[5652,"مرّت خيال","https://www.poetsgate.com/ViewPoem.aspx?id=135377",""],[5939,"اخضعي","https://www.poetsgate.com/ViewPoem.aspx?id=195299",""],[5997,"دمعة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=214255",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[5567,"شغف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81761&r=&rc=29",""]],"verses":[["مَن لَهُمُ مِثلي إِذا اِستُزلِقَت","أَقدامُهُم يَومَ ذَليلِ المَقام",0,"م",1,0],["مَن لَهُمُ مِثلي إِذا أَصبَحوا","بِعارِضٍ يَهضِبُ بيضاً وَلام",0,"م",1,0],["منْ لَهواتِ الوادِ مَغْنىً مِحْلالْ","تَرْشُفُ دَرّاتِ الغَمامِ الهَطّالْ",1,"ل",1,0],["مَنْ لَهُ قُدْرَةٌ سِوَاكَ عَلَى الْ","خِدْمَةِ بُورِكْتَ أَوْ علَى الثُّقَلاَءِ",2,"ا",2,0],["مَن لَهُ في حِرِ أُمِّهِ أَلفُ قَرنٍ","قَد أَنافَت عَلى عُلُوِّ مَنافِ",3,"ف",1,0],["مَن لَهُ مِثلُ حَبيبي","قَد حَوى حُسناً وَحُسنى",4,"ن",2,0],["مِن لَهجَةٍ مَكسوبَةٍ أَو بَهجَةٍ","مَنسوبَةٍ تَحلو لِعَينِ حَسودِها",5,"د",3,0],["من له طيبُ ثناءٍ أرِجٌ","راحلٌ في مِقْوَلِ الدّهْرِ مقيم",6,"م",1,0],["مَنْ له القِدحُ المُعَلّى في العلى","فائزٌ في الملكِ بالحظّ العظيم",6,"م",1,0],["من لها أنْ تعيرها منكِ مشياً","قَدَمٌ رَخْصَةٌ وخطوٌ قصيرُ",7,"ر",1,0],["مَنْ له وجْهُ سماحٍ سافراً","أبداً للمجتدي لا ينْتقب",8,"ب",1,0],["مَن لِهَمٍّ قَد باتَ يُشجي فُؤادي","ما لَهُ حالُ دَمعَتي مِن خَفاءِ",9,"ا",2,0],["من له وحده يضيء ويجلو ال","كون في ناظريه أفقا وضيّا",10,"ي",2,0],["مَنْ لِهَاوٍ في لُجَّةٍ هِيَ دُنْيا","هُ وأَيَّامُ بُؤسِه المُتَوَالي",11,"ل",2,0],["مَنْ لهذا الأعْمى يَمُدُّ عصَاه","عاصِبَ البَطْنِ لم يَبُحْ بسُؤَالِ",11,"ل",1,0],["مَن لَهُ المُكرَمات وَالعَدلُ وَالفَضل","صِفاتٌ تَسمو بِها أَسماؤُهُ",12,"ا",3,0],["مَن له إن رماه بالهجر وال","بين حبيبٌ معشوقةٌ لمحاتُه",13,"ت",2,0],["من له رِحلتا قريشٍ إلى المج","د تؤوبان من علاءٍ بكسبِ",14,"ب",1,0],["مَن له في تبزُّع القول بَسطٌ","للَّيالي وللذكاء وقارُ",15,"ر",1,0],["من له الحوض من يرده غدا","فهو عنه يجلو صدا الكرب",16,"ب",1,0],["من له الفضل والتقدم في الإس","لام والناس شِيعةُ الكفار",17,"ر",1,0],["من له الصِهْر والمواساة والنُصْ","رة والحرب ترتمي بالشَرار",17,"ر",1,0],["من له قال أنت مِنّي كهارو","ن وموسَى أكرِمْ به من نِجارِ",17,"ر",1,0],["من له قال لا فتى كعليّ","لا ولا مُنْصُل سوى ذي الفَقَار",17,"ر",1,0],["مَن لَهُ الرُعبُ سَرايا","في الأَعادي وَبُعوثُ",18,"ث",1,0],["من له في الورى كعثمانَ جدٌ","وأبٌ ماجدٌ كعبدِ المجيد",19,"د",1,0],["من له الملك وَالمُلوك عَبيد","وَله العز وَالعَزيز ذَليل",20,"ل",1,0],["مَن لَهُ جَدٌّ كَجَدّي في الوَرى","أَو كَشَيخي فَأَنا اِبنُ القَمَرَين",21,"ن",1,0],["مَن لَهُ عَينٌ كَعَيني","مَن لَهُ قَلبٌ كَقَلبي",22,"ب",2,0],["مَن لَهُ وَالحُبّ يوهنه","مِنهُ إِنذار وَتَهديدُ",23,"د",1,0],["من له مجد أثيل وعلى آل وصحب","من فضائلهم تطول",24,"ل",1,0],["مَن لَهُ في كُلِّ يَومٍ","وَقَفاتٌ لا تُضاهى",25,"ا",3,0],["من له من مهجتي منزلة","غيره ما حام من حول حماها",26,"ا",3,0],["مَنْ له الفضلُ علينا","وله الحُسْنى لدَينا",27,"ن",2,0],["مَنْ له الحكمةَ حقّاً","وله فصْلُ الخِطابِ",28,"ب",1,0],["منْ لهُم بواحد","يحوط أطرافَ الدنا",29,"ن",2,0],["من له ارتقى أدبي","في منصّة الأدبا",30,"ب",2,0],["مَن لَهُ في كُلِّ عامِ","مَولدٌ في مَصر سامي",31,"ي",1,0],["مَن لَهُ العلم سَميرُ","وَهوَ في أَكرَم ظَهرِ",32,"ر",1,0],["مَنْ له المجدُ الأصلُ من كلا","طَرَفَيْهِ لُزَّ مَعْه في قَرَنْ",33,"ن",1,0],["من له أمسى ضجيعاً طائعاً","طاب نفساً حين يحظى بالمنى",34,"ن",2,0],["من له إن أقام عنه بعيداً","لحظة وهو مائج بالصروف",35,"ف",1,0],["مَنْ له الجلّنارُ أصبح خداً","وله الأقحوانُ أصبحَ ثَغْرا",36,"ر",2,0],["من له فتكةٌ مَضَتْ مثلاً في","ما مضى مثلَ فتكةِ البرَّاض",37,"ض",1,0],["مَن لَها حَلّلَهُ","أَيُّ حبرٍ أَو إِمام",38,"م",1,0],["مَن لَهُ بِالفضلِ حتّى الجاهلُ","كلُّ ذي فَضلٍ ذَكيٍّ يشهدُ",39,"د",1,0],["مَن لَهُ العَلياءُ صارَت سُلَّما","لِبُروجِ العِزِّ فَوقَ الأرؤُسِ",40,"س",1,0],["مَنْ له عِزٌّ وفخرٌ","مَن لَهُ المجدُ رداءُ",41,"ا",2,0],["مَن لِهذا الحُسنِ قَد حازَ يكون","حُسنه وَاللَّهِ بِالمُكتَملِ",42,"ل",1,0],["مَنْ لَهُ اللَّه تَعالى وَشَّحا","بِحُلى الفَضلِ وَحُسنِ اللسنِ",42,"ن",1,0],["مَنْ لَهُ اللَّه تَعالى أَكرَما","بِعلومٍ لَم تُنل بِالهَوَسِ",43,"س",1,0],["مَن لَهُ سامي المَعالي خَدَما","وَبِهِ فازَت بِرَفعِ الأَرؤُسِ",44,"س",1,0],["مَن لَهُ اللَّهُ تَعالى كَلَّما","وَحَباهُ بِالدنوِّ الأَقدسِ",44,"س",1,0],["مَن لَهُ في الجهادِ صيتٌ حَميدٌ","مِثلُ شَمسِ النّهارِ غِبَّ اِشتِهارِ",45,"ر",1,0],["من له الخير نصيب فليكن","كنصيب حاز مجد المَلَوينْ",46,"ن",1,0],["مَن لهذا المصاب راقٍ بذكرا","كم فقد مسَّهُ من الحب خَبْلُ",47,"ل",1,0],["من له السؤدد محضا","وله المجد الصريحُ",48,"ح",1,0],["من له بحر خاطر مثل جدو