"","https://poetry.dctabudhabi.ae/diwan/poem/216785","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44908","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204242","الخفيف"],[4801,"أجميل بالمرء يخلف وعداً","https://www.poetsgate.com/ViewPoem.aspx?id=86681",""],[4883,"المارون انشغلو با الغياب والغيبه","https://www.poetsgate.com/ViewPoem.aspx?id=48377",""],[5064,"رفض","https://www.poetsgate.com/ViewPoem.aspx?id=199126",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[4045,"غيبة لم تطل عليّ وماذا","https://www.poetsgate.com/ViewPoem.aspx?id=200270",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5593,"صل يا ذا العلا لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=181048",""],[6189,"عاهة مستديمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83601&r=&rc=68",""]],"verses":[["أَنتَ أَعلى مِن أَن تُهَنَّأَ بِالعِز","زِ إِذا ما ضَفا عَلَيكَ وَرَفّا",0,"ف",2,0],["أَنتِ أَعَنتِ الشَيبَ في مَفرِقي","مَعَ اللَيالي فَصِلي أَو دَعي",1,"ع",2,0],["أنت أعلى من أن تُقَوِّلَ أعدا","ءَك قولاً يُضرِّب الأولياءَ",2,"ا",2,0],["أنت أعلى من أن يقول لك القا","ئل يهنيك أن وليت الضياعا",3,"ع",2,0],["أنت أعْلى من أن تُفات بعلم","أو يُداني مدى عليمٍ مداكا",4,"ك",2,0],["أنت أعلى من أنْ تُعلَّم علماً","ويُداني مدَى عليمٍ مداكا",5,"ك",2,0],["أنت أعلى من أنْ توازَى بشيءٍ","لستَ ممن يُرمى به الرَّجَوان",6,"ن",1,0],["أَنتَ أَعلى مَحَلَّةً أَن تُهَنّى","بِمَكانٍ في الأَرضِ أَو في السَماءِ",7,"ا",2,0],["أَنتَ أَعمى وَلِلزُناةِ هَناتٌ","مُنكَراتٌ تَخفى عَلى البُصَراءِ",8,"ا",2,0],["أَنتَ أَعدَيتَهُ بِحوبِّ سُعادٍ","وَكَريمُ الأَهواءِ يُعدي الكِراما",9,"م",2,0],["أَنتَ أَعزَزتَني وَرُبَّ زَمانٍ","طالَ فيهِ بَينَ اللِئامِ خُصوعي",10,"ع",2,0],["أَنتَ أَعلى مِن أَن تُهَنّى بِعيدٍ","بَل تُهَنّى بِمَجدِكَ الأَعيادُ",11,"د",1,0],["أنت أعددتَ للبلادِ حياةً","ليس من دُونها مَفازٌ ومغنَمْ",12,"م",1,0],["أَنْتَ أعْلَى كَعْباً وأبْقَى عَلَى الدَّهْرِ","وإِنْ زَاحمَ الْخُلُودَ بَقاؤُه",13,"ا",3,0],["أنتَ أعْدَيْتَهُ بِحُبِّ سُعَادٍ،","وَكَرِيمُ الأهْوَاءِ يُعْدِي الكِرَامَا",14,"م",2,0],["أنتَ أعْزَزْتَني، وَرُبّ زَمَانٍ،","طالَ فيهِ بَينَ اللّئَامِ خُضُوعي",15,"ع",2,0],["أنتَ أعلى مَن أن يقول لك القا","ئل يَهنيك أو وَلِيت الضياعا",16,"ع",2,0],["أنْتَ أعلى مَحَلّةً أنْ تُهَنّا","بمَكانٍ في الأرْضِ أوْ في السّماءِ",17,"ا",2,0],["أنتَ أعلاهُم وأعظمهم حالا","وعدّا وعدة وجنودا",18,"د",2,0],["أَنتَ أَعلَيتَها فَأَكدى مُرَجّي","ها وَأَغلَيتَها فَما تُستامُ",19,"م",1,0],["أَنتَ أَعلا مِن أَن أُهاديكَ قَدراً","وَمَحَلّاً لَكِنَّني طَرّاحُ",20,"ح",1,0],["أَنتَ أَعلى مِن أَن نُهَنّيكَ قَدراً","لِلَّيالي إِذا سَلِمتَ الهَناءُ",21,"ا",2,0],["أَنْتَ أَعْلى مِنْ كُلِّ ما ينْسِبُ النّا","سِبُ مِنْ سُؤْدُدٍ وَيَعْزُو",22,"ز",2,0],["أَنتَ أَعلى مِن أَن تُعَدَّ بِوَصفٍ","بلَغَتهُ بَلاغَةُ البُلَغاءِ",23,"ا",2,0],["أنت أعلى ذكراً وأكثرُ أيا","ماً ولا يلحقُ القليلُ الكَثيرا",24,"ر",2,0],["أنت أعلم بحال قلبي مني","أنت نعم النصير نعم الكفيل",25,"ل",1,0],["أَنتَ أَعجَزتَ في غداة التَلاقي","كُلَّ خَصمٍ نِهايَةَ الاِعجازِ",26,"ز",1,0],["أنتَ أعلنتَها بياناً صريحاً","ما به حاجةٌ إلى تَبْييِن:",27,"ن",1,0],["أنت أعطيت من خصال المعاني","جملاً لا تعد بالمقدار",28,"ر",1,0],["أَنْتَ أعلى من أن يقال كريمٌ","إن عَدَدْنا من الأنام الكراما",29,"م",2,0],["أنتَ أعلى يداً وأطول باعاً","في المعالي وأنتَ أثقب زندا",30,"د",2,0],["أنت أعلى رتبة من شبه ال","رشإ الأحوى أو الغصن النضير",31,"ر",1,0],["أنت اعلى رتبة أن تنمحي","حسناتي أو تناساها وأعلى",32,"ل",2,0],["أنتَ أعلَى أُكرُومَةً يا ابنَ عَبدٍِ ال","لَّهِ في هاشِم وأحسَنُ صُنعا",33,"ع",2,0],["أنتَ أعلى مَجداً وأطَولُ باعاً","أن تُجَارَى لِغايَةٍ أو تُساعَى",34,"ع",2,1],["أنت أعلى من أن تلاقيَ جهلاً","للذي أنت صانعٌ أو جحودا",35,"د",2,0],["أنت أعددت للوقائع والحر","ب رماحا لدنا وحصداء زغفا",36,"ف",2,0],["أنت أعلى من مدح كل قؤول","يا لعمري فما عسى أن أقولا",37,"ل",2,0],["أنت أعليت ذروة المجد والفخ","ر وأحييت سنة الأسلاف",38,"ف",1,0],["أنت اعترفتَ بمن أنكرتَ صورته","الأمر سوق فأرباحٌ وخسران",39,"ن",1,0],["أنت أعلا محلّةً ومكاناً","أنْ يُملِيّ ولو قتَلَتَ قَتيلا",40,"ل",2,0],["أَنتَ أَعطَيت مِن دَلائل رُسل","اللَه آياً بِها عَلَوت الرُؤوسا",41,"س",2,1],["أنت أعطشتني إلي","ك وأبكيتني دما",42,"م",2,0],["أنت أعز الوجود عندي","فاسجد لعزي وكبريائي",43,"ا",2,0],["أنت أعلى من أي يغرك واش","فتظنّ السراب ماء غمامه",44,"م",2,0],["أنت أعطيتني كتاباً إلى رضو","ن حتى أجزتُ خيرَ الجزاءِ",45,"ا",2,1],["أَنتَ أعلى من أَنْ تُعزَّى بمفقو","دِ وانْ عزَّ فقدُه أو تُهَنَّى",46,"ن",2,0],["أَنتَ أعديتني على كفةِ الصَّا","ئدِ حتى وطئت منها القُماصَا",47,"ص",2,0],["أنتَ أعْلى قدْراً وأعْلَمُ لكِن","ذَكّرَ العبْدُ منكَ مَنْ ليس يَنْسى",48,"س",2,0],["انتِ اعتِمادي باعِياذَ مَعا ثِري","وبكِ اعتِقادي باليِاذَ رَجائي",49,"ا",2,0],["انت اعشيت بالبريق ضميري","فاستراحت من وخزة أعضائي",50,"ي",1,0],["أنت أعلى الرؤس في مصر رأسا","وأعز الدعاة في مصر جندا",51,"د",2,0],["أَنتَ أَعطَيتَ في حَياتكَ حَظّاً","مِن جُنونِ الصِبا وَطَيشِ الشَبابِ",52,"ب",1,0],["أنت أعلى من أن تكون أضاحي","ك قروماً من الجمال تعفَّرْ",53,"ر",1,0],["أنت أعطيته أمانيه جوراً","وزماناً قد كان في ذاك أكدى",54,"د",2,0],["أنت اعتبرني شخص ضيّع سنينه","وابعتبر شوفتْك \" غلطة تفاوه!\"",55,"ا",3,0],["أنتَ اعلنتَ فِي الحيَاةِ انشقاقًا","فلماذا لا أُعلِنُ اليومَ رَفضِي؟!",56,"ض",2,0],["أنت أعلى من العُلُو ِّ وأسمى","أنت دمع ٌ تحتاجُه ُ الدَّمَعات ُ",57,"ت",1,0],["أنت أعمى فيما ادّعيت كما","لست لصوغ الألحان بالأستاذ",58,"ذ",1,0],["أنت اعلم ابحالي ومااخفيت وابديت","وانت اعلم بضعفي وسلة ضروفي",59,"ف",2,0],["أنت أعلى من أن تكون أضاح","يك قروماً من الجمالة تعقر",60,"ر",1,0],["أنت أعليتَ صَرْحَهم لست تدري","أنَّه ما علا لقومك صرحُ",61,"ح",1,0]]}