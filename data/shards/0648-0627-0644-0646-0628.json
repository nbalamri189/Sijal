{"poems":[[53,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[64,"في الحل والعقد حار الناس كلهم","https://www.aldiwan.net/poem52228.html","البسيط"],[30,"لأمدحن بني المهلب مدحة","https://www.aldiwan.net/poem5176.html","الكامل"],[68,"ولقد ذكرتك حين أنكرت الظبى","https://www.aldiwan.net/poem39938.html","الكامل"],[83,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[48,"لا تطلب الغرض البعيد وتسهر","https://www.aldiwan.net/poem22697.html","الكامل"],[48,"صاح الزمان فعاد الجمع مفترقا","https://www.aldiwan.net/poem23224.html","البسيط"],[48,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141952","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[48,"لا تَطلُبِ الغَرضَ البعيدَ وتَسهَرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=20272",""],[96,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[119,"يا رسول الرضى بفضلك دارك","https://www.aldiwan.net/poem42172.html","الخفيف"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[170,"وفت السعود بوعدها المضمون","https://www.aldiwan.net/poem46843.html","الكامل"],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[230,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[234,"انظر إلى البركة الغناء مفعمة","https://www.aldiwan.net/poem50996.html","البسيط"],[287,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[287,"هب نسيم بالطل مبلول","https://www.aldiwan.net/poem32639.html","المنسرح"],[287,"يا لائمي ما للخلي وللشجى","https://www.aldiwan.net/poem32836.html","الكامل"],[366,"ان من يحفظ المودة أحرى","https://www.aldiwan.net/poem68108.html","الخفيف"],[409,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[438,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[473,"الغيم بين مزرر ومحلل","https://www.aldiwan.net/poem59763.html","الكامل"],[473,"الغيم يبسط في السماء ويفرش","https://www.aldiwan.net/poem59930.html","الكامل"],[534,"الجواب الذي أراه صوابا","https://www.aldiwan.net/poem37448.html","الخفيف"],[556,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[580,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112449","البسيط"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67018","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59114","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61201","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113030","السريع"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106856","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102570","الرمل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140094",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138536",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132112","البسيط"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21494","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66546","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86574","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29319","السريع"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81237","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83662","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58145","البسيط"],[4702,"ياليتها تاقف الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=155199",""],[4767,"تقريع","https://www.poetsgate.com/ViewPoem.aspx?id=178421",""],[4815,"جَفَّ البيان","https://www.poetsgate.com/ViewPoem.aspx?id=210473",""],[4869,"جووووز","https://www.poetsgate.com/ViewPoem.aspx?id=151636",""],[4119,"هذي العزائم لا ما تدعي القضب","https://www.poetsgate.com/ViewPoem.aspx?id=16061",""],[5120,"هَلِ انْتَهَى أَرَقُ الْأَحْلاَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=179959",""],[5136,"حين مرت تميس ذات الغزاله","https://www.poetsgate.com/ViewPoem.aspx?id=121783",""],[5187,"من وحي الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=29701",""],[5431,"للشاعر الإنسان عبد الحميد الجمال -جريدة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=190263",""],[5512,"إسراف في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206699",""],[5653,"والسمر من قلب مواتحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=26457",""],[5674,"نزيف الشريان مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=189101",""],[5674,"الحديث يطول","https://www.poetsgate.com/ViewPoem.aspx?id=189482",""],[5691,"ديار أهلها رحلوا...!","https://www.poetsgate.com/ViewPoem.aspx?id=206526",""],[5829,"ربيع الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161988",""],[6075,"عرفتك عشفا","https://www.poetsgate.com/ViewPoem.aspx?id=193315",""],[6075,"نهر اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=201155",""],[6093,"دوبيت :القلب إليه كل درب سلكا","https://www.poetsgate.com/ViewPoem.aspx?id=203959",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6120,"أَتُرِيدُنِي أَنْ أَعْتَرِفْ","https://www.poetsgate.com/ViewPoem.aspx?id=213513",""],[6142,"حشدوا كل واحدٍ من قبيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155696",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6213,"لوحة حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76258&r=&rc=15",""]],"verses":[["والنَبلُ مبرية منصلة","يحفزُهُنَّ القسيُّ والشرع",0,"ع",1,0],["والنبت يغذوه حرّ ليّن وندى","حلّ الثرى فارتقى في جسمه صعدا",1,"د",2,0],["وَالنُبلُ مُلجَمَةٌ بِكُلِّ مَحَدرَجٍ","مِن رِجلِ خاصِبَةٍ مِنَ الأَوتارِ",2,"ر",1,0],["وَالنَبلُ مِن خَلَلِ العَجاجِ كَأَنَّهُ","وَبلٌ تَتابَعَ مِن فُروجِ غَمامِ",3,"م",1,0],["وَالنَبتُ عَن لُقيا الغَمامِ بِمَعزَلٍ","وَيَبيتُ يَشرَبُ صَوبَهُ المُستَغزِرا",4,"ر",2,0],["وَالنَبتُ يَظهَرُ لِعُيونِ وَإِن مَضَت","سَنَةٌ لَهُ فَكَأَنَّهُ لَم يَظهَرِ",5,"ر",1,0],["وَالنَبلُ يَبلُغُ ما أَعيا القَنا مَثَلاً","أُجريهِ لِلنُبلِ يُلفى عِندَ تِنبالِ",6,"ل",1,0],["والنَّبْلُ تَسقُطُ فوْقَها ونصالُها","كالرّيشِ فهْوَ على رَجَاها طافِ",7,"ف",1,0],["وَ النَّبْعُ يَضْحَكُ لِلْمَزَارِعِ وَالجَنَى","وَيَكادُ يَلْثُمُ مِنْجَلَ الحُصَّادِ",8,"د",1,0],["وَالنُّبُوغُ النُّبُوغُ يَمْضِي وَتَمْضِي","كلُّ آمَالِ قَوْمِهِ فِي رِكَابِهْ",9,"ب",2,0],["والنّبْتُ يَظهَرُ للعيونِ، وإن مضَتْ","سَنَةٌ له، فكأنّهُ لم يَظهَر",10,"ر",1,0],["والنبع والقبّة في هدأة","يسرع دهر وهما وانيان",11,"ن",1,0],["والنبوّات والفنون وملك","في شباب الدّنيا عريض طويل",12,"ل",1,0],["والنبيون والعوالم طرا","فرع فضل من أصل فيض بحارك",13,"ك",1,0],["وَالنَبعُ كَالشَريانِ إِلّا أَنَّ ذا","نَبتُ الوِهادِ وَذاكَ نَبتٌ في الذُرى",14,"ر",2,0],["والنّبلُ يُمطرُ وبْلَهُ من مُنْحنى","نبعٍ كمُرْتجِزِ الغَمام حَنونِ",15,"ن",1,0],["وَالنُبلُ فَتككَ بِالمُعادي غادِراً","أَو وافياً مُستَنجِداً أَو مُنجِدا",16,"د",2,0],["وَالنَبلُ في الجَوِّ تَحكي لِلمُشَبِّهِهِ ال","كبرِيتَ في رُوسِهِ النِيرانُ تَشتَعِلُ",17,"ل",1,0],["وَالنبيُّ الأمّيُّ قد علموهُ","ما لهُ في كمالِه قرناءُ",18,"ا",2,0],["وَالنبيّ الأمّيُّ كالليثِ يُردي الش","شركَ منهُ تقدّمٌ واِجتراءُ",18,"ا",2,0],["وَالنبيُّ الأمينُ أَغفى لبعد ال","خوفِ منه واِزدادَ فيه الرجاءُ",18,"ا",2,0],["وَالنبيِّ الأمّيُّ لو جاءَ أهلَ ال","أرضِ حَرباً ما اِختلّ فيهِ الرجاءُ",18,"ا",2,0],["وَالنَبِيُّ يَطلُبُهم","وَالمُحِبُّ يَقتَربُ",19,"ب",1,0],["والنبت قد حفّها من كل ناحيةٍ","بكل غصن أَنيقٍ فهو حائزها",20,"ز",3,0],["وَالنَبِيّونَ وَمَن تابَعَهُم","كُلُّهُم آلَ إِلى هَذا المَآلِ",21,"ل",1,0],["وَالنَبتُ مِنهُ عَلى الثَّرى نُشِرَت","مِن كُلِّ زَهرٍ زاهٍ مَناديلُ",22,"ل",1,0],["وَالنَّبتُ بَينَ مُعَمَّمٍ وَمُنَمنَمٍ","وَالرَوضُ بَينَ مُفَوَّفٍ وَمُدَبَّجِ",23,"ج",1,0],["وَالنَبيل الاصيل يَنمو وٌَارا","وَاِحتِشاما مِن حَيثُ يَغفِر وزرا",24,"ر",2,0],["والنبيل اللبيب يكفيه أدنى","لمحة في التعريف بالإِلمام",25,"م",1,0],["والنِّبْلُ قد نَفَضَتْ كِنَانَتَهُ","بِيَدِ السَّدادِ مسدِّدَ النَّبْل",26,"ل",1,0],["وَالنَبتُ بَينَ مُزَعفَرٍ وَمُمَسَّكٍ","وَمُخَلَّقٍ وَمُعَبَّرٍ وَمُصَندَلِ",27,"ل",1,0],["وَالنَبتُ مُنتَشِرٌ فَمِنهُ مُدَبَّجٌ","تُجلى الغُصونُ بِهِ وَمِنهُ مُرَيَّشُ",28,"ش",1,0],["والنَّبيُّ الْكَريمُ صَلّى عَلَيْه","رَبُّنا قَدْ أَفادَنَا بالْمُرادِ",29,"د",1,0],["والنّبعُ تسلبه النَّجابةُ فرعَهُ","ونجا بلؤمٍ خِرْوَعٌ وثُمامُ",30,"م",1,0],["والنَّبْع قالوا مَالَهُ ثَمَرٌ","أَمَّا أَنا فالدَّمْعُ لي ثمَرُ",31,"ر",1,0],["والنبي زاد بو هيامى","ولا تسمع لوم لائم",32,"م",1,0],["والنبع في السفح فياض ومندفق","ما أعذب النبع يجري من روابيها",33,"ي",3,0],["والنَّبْلُ في حَلَقِ الدِّلاَصِ كأنَّها","وَيْلُ الحَيَا في مائجِ الغُدْرَانِ",34,"ن",1,0],["والنبت والأحجار والوحش قد","حيوه يا هادي بأزكى سلام",35,"م",1,0],["والنبت أقلاما وما قد جرى","من كل ماء كالمحاد استقام",35,"م",1,0],["والنبات الممد يضحى يراعا","ومياه الوجود حبرا كحيلا",36,"ل",2,0],["وَالنَّبْلَ نُوراً وَالحِمَامَ مُطَاعِماً","وَالنَّقْعَ روضاً وَالعِدَى ضِيفَانَا",37,"ن",2,0],["والنبت الأقلام والقوادي","وكلما سال كالمداد",38,"د",1,0],["والنبت أقلام والمخلوق تكتب ما","لم يحو محمله سر وتفصيل",39,"ل",1,0],["والنبت والأشجار الأحجار قد","صلو عليه صلاة من لم يبخل",40,"ل",1,0],["والنبت أقلام وكل الخلق تس","رع في الكتابة بالكلام المجمل",40,"ل",1,0],["وَالنبت مِن حَولِها تَبدو أَزاهره","كَأَنَّها أَنجُم قَد فرقت فرقا",41,"ق",2,0],["والنبأ العظيم ما عودته","من حلمك الشامل أي من عصى",42,"ا",1,0],["والنبيذ استقوه واغتنموه","آخر الليل كاستقاء السواني",43,"ن",2,0],["والنبيّ جل فضلهُ بشرٌ لم","تحذ حاشا لفضله الفضلاء",44,"ا",2,0],["والنبيين أخرت قرباها","والوصيين قدمت قرباها",45,"ا",3,0],["والنباتات كلمته وأحيا","باسقات وأينعت بجناها",46,"ا",3,0],["والنَّبت جمٌّ ترتعيه حمًى","والماء لا مستكدرٌ رغد",47,"د",1,0],["والنبت زاهٍ به عميم","يبعث روحَ المسرَّةِ",48,"ه",1,0],["والنبي برّت يميني","ما كمحبوبي الأوّل",49,"ل",1,0],["والنبق والزعرور شبه بنادق","مع مشمش مع عصفر معجونة",50,"ه",1,0],["والنبي الأمين في يوم خم","علماً قد أقامه لاهتداها",51,"ا",3,0],["والنبي المصطفى كان على","جاحديه بمواضيه يصول",52,"ل",1,0],["والنبيون الألى قد غبروا","باسمه كانت دجى الكفر يزيل",52,"ل",1,0],["والنبي الهادي عن اللَه قد بل","غه في غدير خم مطيعا",53,"ع",2,0],["والنبيه النبيلِ والسابق الحِبرِ","إِمام الهُدَى الرفيعِ المَقامِ",54,"م",1,0],["والنبل بين صفات النفس عندهم","كالماس بين اللآلي عند الآل",55,"ل",1,0],["وَالنَبيّونَ عِندَهُ بِمَكانٍ","في عَلاءٍ وَالصالِحونَ قُعودُ",56,"د",1,0],["وَالنَّبْلُ فِي ظُلَلِ العَجاجِ كَأَنَّهُ","وَبْلٌ تَتابَعَ مِن خِلالِ سَحائِبِ",57,"ب",1,0],["والنبت يرقص لا يكل له","من قده ردف ولا خصر",58,"ر",1,0],["والنبل من فزع يطيش رشاشه","قد يورث الفزع الشديد خبالا",59,"ل",2,0],["وَالنَبتُ وَالأَشجارُ لامِعَةٌ","مِن حُمرَةِ الأَضواءِ في يَبَسِ",60,"س",1,0],["وَالنَبي الصَغير مِن بَعد ما زا","لَ نبياً معظماً في الصُدور",61,"ر",1,0],["وَالنَبي العَظيم في الأَر