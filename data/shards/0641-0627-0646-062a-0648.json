{"poems":[[57,"سألت بحق هذا الشهر ألا","https://www.aldiwan.net/poem26153.html","الوافر"],[73,"ولي حاجة في جنب جودك سهلة","https://www.aldiwan.net/poem3972.html","الطويل"],[39,"فأنت وجدك من هاشم","https://www.aldiwan.net/poem6989.html","المتقارب"],[53,"وحية في رأسها درة","https://www.aldiwan.net/poem8136.html","السريع"],[94,"إن الحياة صراع","https://www.aldiwan.net/poem38937.html","المجتث"],[94,"سئمت الليالي وأوجاعها","https://www.aldiwan.net/poem38972.html","المتقارب"],[45,"أحلما نرى أم زمانا جديدا","https://www.aldiwan.net/poem9540.html","المتقارب"],[30,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[30,"ألم يك جهلاً بعد ستين حجةً","https://www.aldiwan.net/poem1288.html",""],[63,"هل لك يا ابن غاليه","https://www.aldiwan.net/poem51315.html","مجزوء الرجز"],[46,"لنمنا وصرف الدهر ليس بنائم","https://www.aldiwan.net/poem30302.html","الطويل"],[46,"أمالك إن الحزن أحلام حالم","https://www.aldiwan.net/poem30352.html","الطويل"],[33,"ألا قل لهند إحرجي وتأثمي","https://www.aldiwan.net/poem41824.html","الطويل"],[50,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[48,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[111,"لا تترك الأنفاس في الهزل سدى","https://www.poetsgate.com/ViewPoem.aspx?id=532",""],[139,"ببرئك أضحت الدنيا تسامى","https://www.aldiwan.net/poem49069.html","الوافر"],[147,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[181,"فيا ليت عمي يوم فرق بيننا","https://www.aldiwan.net/poem4503.html","الطويل"],[208,"فؤادي على عهد الحبيب حبيس","https://www.aldiwan.net/poem53115.html","الطويل"],[264,"بشير أتى من عالم الغيب للحس","https://www.aldiwan.net/poem35798.html","الطويل"],[275,"زفرت لضم الخود بعد تلهفي","https://www.aldiwan.net/poem35394.html","الطويل"],[280,"أتهم بي في الهوى وأنجد","https://www.aldiwan.net/poem25576.html","مخلع البسيط"],[287,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[290,"تدفق ماء معدني من الصخر","https://www.aldiwan.net/poem39345.html","الطويل"],[302,"بنفسي هيفاء المعاطف ناهد","https://www.aldiwan.net/poem33285.html","الطويل"],[325,"تأمل لما يمضي من العمر خلسة","https://www.aldiwan.net/poem61765.html","الطويل"],[358,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[376,"أتسكن بعد فراق السكن","https://www.aldiwan.net/poem57056.html","المتقارب"],[405,"وقد رزينا به محضا خليقته","https://www.aldiwan.net/poem4511.html","البسيط"],[438,"هفا طربي الى عافي الرسوم","https://www.aldiwan.net/poem12714.html","الوافر"],[445,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[457,"حيا دمشق فكم فيها لذي وطر","https://www.aldiwan.net/poem13761.html","البسيط"],[473,"يا غصنا يهتز في شمس","https://www.aldiwan.net/poem59957.html","الطويل"],[511,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[569,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82800","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122570","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122771","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1203,"","https://poetry.dctabudhabi.ae/diwan/poem/28260","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64669","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56591","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46527","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79926","الوافر"],[1557,"","https://poetry.dctabudhabi.ae/diwan/poem/124309","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108534","البسيط"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102068","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100975","المجتث"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66267","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48237","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106864","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76037","السريع"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141224","المتقارب"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136977",""],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126539","السريع"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142838","البسيط"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104251","البسيط"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133300","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[4134,"","https://poetry.dctabudhabi.ae/diwan/poem/100559","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73636","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136763",""],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[4935,"إله البرايا إليك الحقير","https://www.poetsgate.com/ViewPoem.aspx?id=129277",""],[4119,"ألا لله درك أي در","https://www.poetsgate.com/ViewPoem.aspx?id=16109",""],[3591,"أيا ميةً في الحسن صيتك أعجبا","https://www.poetsgate.com/ViewPoem.aspx?id=149387",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5145,"تنحط من قدرك السماء","https://www.poetsgate.com/ViewPoem.aspx?id=108099",""],[5155,"الربيع العائد","https://www.poetsgate.com/ViewPoem.aspx?id=176168",""],[5213,"فديتك قد بلغت انك مؤلم","https://www.poetsgate.com/ViewPoem.aspx?id=170552",""],[5246,"أبا سليمان يا من في الفؤاد له","https://www.poetsgate.com/ViewPoem.aspx?id=187051",""],[181,"خليليَّ منْ عليا هلالِ بنِ عامرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22257",""],[5582,"كَئِيبٌ ما النَّسِيمُ سَرَى عَلِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=63608",""],[5703,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=216044",""],[5725,"الا ياسليمى","https://www.poetsgate.com/ViewPoem.aspx?id=178415",""],[5776,"أكاد أذوب","https://www.poetsgate.com/ViewPoem.aspx?id=199364",""],[5790,"لك الله إن العفو أقرب للتقوى","https://www.poetsgate.com/ViewPoem.aspx?id=111926",""],[5956,"نايُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206677",""],[5975,"في ولاء آل بيت الرسول1","https://www.poetsgate.com/ViewPoem.aspx?id=53466",""],[6031,"أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46411",""],[242,"حبل الدنا يا مبتغيه رث","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563804",""],[6227,"شلاّل الشذا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87069&r=&rc=12",""]],"verses":[["فَأَنتِ وَإِن أَضَعتِ الوُدَّ عِندي","بِمَنزِلَةِ اليَمينِ مِنَ الشِمالِ",0,"ل",1,0],["فَإِن تُولِنيَها أَحتَسِبها صَنيعَةً","أَقومُ لَها بِالشُكرِ ما قامَ مَوسِمُ",1,"م",1,0],["فأنت وجدك من هاشم","بحيث الواد من الناظرِ",2,"ر",1,1],["فإن تَولَّتْ فالعَمَى حاضرٌ","وإن بدتْ بان طريقُ الهدى",3,"د",2,0],["فإنْ تولَّتْ تصدَّتْ","حَيَاتُهُ للبَلاءْ",4,"ا",2,0],["فأَنَّتْ وقدْ غَمَرَتْها الدُّمُوعُ","وقَرَّتْ وقدْ فاضَ مِنْها الحَبَابْ",5,"ب",1,0],["فَأَنتَ وَحيدُ بَني آدَمٍ","وَلَستَ لِفَقدِ نَظيرٍ وَحيدا",6,"د",2,0],["فَإِن تُؤذِنينا بِالفِراقِ فَلَستُمُ","بِأَوَّلِ مَن يَنسى وَمَن يَتَجَنَّبُ",7,"ب",1,0],["فَإِن تُؤذِنينا بِالفِراقِ فَلَستُمُ","بِأَوَّلِ مَن يَنأى وَمَن يَتَجَنَّبُ",8,"ب",1,0],["فإن توليت قفت","إثرك منهم قافيه",9,"ي",2,0],["فَإِن توهِ في الدُنيا دَعائِمُ عُمرِهِ","فَما جودُهُ فيها بِواهي الدَعائِمِ",10,"م",1,0],["فَأَنتَ وَصِنواكَ النَصيرانِ إِخوَةٌ","خُلِقتُم سَعوطاً لِلأُنوفِ الرَواغِمِ",11,"م",1,0],["فَأَنتِ وَبَيتِ اللَهِ هَمّي وَمُنيَتي","وَكِبرُ مُنانا مِن فَصيحٍ وَأَعجَمِ",12,"م",1,0],["فَإِن تولِني مِنكَ الجَميلَ فَأَهلُهُ","وَإِلّا فَإِنّي عاذِرٌ وَشُكورُ",13,"ر",1,0],["فإنْ تَوافَقَ في معْنىً بَنو زَمَنٍ","فإنّ جُلّ المَعاني غيرُ مُتّفِقِ",14,"ق",1,0],["فإنّ تَواتُرَ الفِتْيانِ عِزٌّ","يُشَيّدُ حينَ تَكْتَهِلُ الرّجال",15,"ل",1,0],["فان توجهت الى حضرته","فرافق العلم يقود الجملا",16,"ل",2,0],["فأنت وُقِيتَ لم تخصص بسقْم","فقد عم السقامُ على الأنامِ",17,"م",1,0],["فَأَنتَ وَلَن تُدافَعَ عَن مَساعٍ","تَظَلُّ لِشارِدِ العَلياءِ عَقلا",18,"ل",2,0],["فَإِن تَوَلَّت مُلُوكُ الرُومِ ما بَلَغَت","مِعشارَ ما صَنَعَت إِخوانُنا فِينا",19,"ن",2,0],["فأَنت ولم يَنْفَعْكَ فَرَّقْتَ بَيْنَنا","ونحنُ جَميعٌ شَعْبُنا مُتَدانِ",20,"ن",1,0],["فإن توحش الأيام بيني وبينه","فما لي سوى شوقي إليه أنيسُ",21,"س",1,0],["فأنت وزيرٌ أجدرُ الناس بالثنا","على ملكٍ يعنو له العرش والكرسي",22,"س",2,0],["فأنّت وقد حكّمتُ كفِّي بخصرها","فأصبَحَ فيها كالكِتابِ المغلَّفِ",23,"ف",1,0],["فَأنْتَ واللّه مَنْ عَلَيهِ","لِواءُ أهْل الجمال يُعْقَد",24,"د",1,0],["فَإِن تُؤاخِذهُم يَوماً بِفِعلِهِمُ","تَذَرهُم مِثلَ لَحمٍ ضَمَّهُ وَضَمُ",25,"م",1,0],["فأنت وتاهت في الخيال ورفرفت","عشية اذ هب النسيم على الزهر",26,"ر",1,0],["فَأَنّت وَرَنَّت واِرجحنَّت وأَجهشَت","وَقَد بُلَّ من فيض الدِماءِ المجاسِدُ",27,"د",1,0],["فَأَنتَ وَما تَحويهِ في اليَومِ أَوغَدَ","سَحابَةً صَيفَ عَن قَليلِ تَقَشُّعُ",28,"ع",1,0],["فَأَنتَ وَسيلَتي وَالكَون فانٍ","بِمَشهَد لَيسَ غَير اللَه باقي",29,"ق",2,0],["فأنتِ وُسِّمتِ أَيضاً يا سماءُ له","فما هِلالُكِ إلاّ نونُ سُلْطان",30,"ن",1,0],["فأنتَ وسُخطُ النَّوى والأسَى","وفقدُ العَزا أبَداً في قَرَن",31,"ن",1,0],["فأنت واللَه خير الخلق كلّهم","وَأصدق الناس حيثُ الصدق والكذبُ",32,"ب",1,0],["فإنْ توجتُ راحي كأسَ راحٍ","فشُرْبُ الإثْمِ أوْلى بالأثيمِ",33,"م",1,0],["فإِنْ تُؤْوِ منها يَا مُظَفَّرُ غربةً","فنازِحَةُ الأَوطانِ مُؤْيِسَةَ الرَّجْعِ",34,"ع",1,0],["فإِن توخيت منها طيبَ مختبر","وتجتني عند باكورةَ العُمُر",35,"ر",1,0],["فَأَنتَ وَالوُدُّ الَّذي بَينَنا","أَعَزُّ مِن نَفسي عَلى نَفسي",36,"س",2,0],["فَأنَّت وَهامَت فِيكِ بِالوَجدِ والأسَى","وَحُقَّ لهَا فالصَّبُّ يُفجَعُ بالصَّبِّ",37,"ب",1,0],["فأنت وسام العصر فخراً وهمة","وذكرك أسنى ما تضم التراجم",38,"م",1,0],["فَأَنتَ وَإِن غلت المُنى أَطيب المُنى","وَفيكَ نَعيم المَرء أَي نَعيم",39,"م",1,0],["فإن تُولِيني خيراً فإنك أهلُه","وإن تكتسب مجداً فإنك ماجد",40,"د",1,0],["فَأنتَ وَهُم لَو لَم يَكونُوا وَلَم تَكُن","كَجِسمٍ بِلا رُوحٍ وَرُوحٍ بِلا جِسم",41,"م",1,0],["فإن تؤثرى بالودِّ مولاك لا أَقل","أَسأتِ وإن تستبدلى أَتبدلِ",42,"ل",1,0],["فَأَنتَ وَإِن كُنتَ الجَريءَ جَنانُهُ","مُنيتَ بِضِرغامٍ مِن الأسدِ الغُلبِ",43,"ب",1,0],["فإنْ تُواصِلْ فَنَزَرٌ غيرُ مُحْتَسَبٍ","وإنْ تُهاجِرْ فجمٌّ غَيرُ مَحْسُوبِ",44,"ب",1,0],["فأنت وذا السيف من جوهر","وطبعك من طبع إفرنده",45,"د",2,0],["فَإِن تَوانيت أريق دَمه","وَذَهبت ضائِعة أنعمه",46,"ه",1,0],["فأنتِ وما صنعتِ فعنكِ فحسبي","بمدحِ محمدِ الحسنِ الصنيع",47,"ع",1,0],["فانت وسيلتي في كل كرب","عن الرحمان تفرجُ ما عناني",48,"ن",2,0],["فإن توانيت عن صرف المعاش به","نابت عن الحطب الأقلام والكتب",49,"ب",1,0],["فانت وطيب البان هل تعلمانه","ويا نسمة الاسحار باللَه هل نبا",50,"ب",2,0],["فإن توليت عني","فلست أحرم عودا",51,"د",2,0],["فأنت وقد كنت المعدّ لنيلها","ولولاك لم ينهج إلى الجود شارع",52,"ع",1,0],["فأنت ولا مينَ ابنُ بَجْدتِها إِذا","عَزَتْكَ العوالي والعُذَيْقُ المرُجَّبُ",53,"ب",1,0],["فأنتَ وهُنَّ الأمسُ واليومُ بالمدى","قريبان لكن دون لقياهما الدهر",54,"ر",1,0],["فإن تُوَافِ البابَ بالنَّهَارِ","وَازِ الزُّبَانَينِ وَظَلَّ جَاري",55,"ي",1,0],["فَإِن تُوافِق مُقلَتي مُهجَتي","في الرُؤيةِ اِستراحتا مِن نَواك",56,"ك",1,0],["فأنت وإن حلت النازلات","فتى لا يضيم له الدهر جارا",57,"ر",2,0],["فأنت وأنوا بعدها ودموعهم","بها ابتل اردان لهم ونحور",58,"ر",1,0],["فان توقفت فمن اسأل","سواد همي مفرقي بيضا",59,"ض",2,0],["فأنت وحدك جبّار ومقتدر","وأنت وحدك غفّار وصَفّاح",60,"ح",1,0],["فأنت واللَه من أناس","قد خسروا الغيب والشهادة",61,"ه",1,0],["فإن توَّشحت الاكرامَ لا عجبٌ","لأنها عينُ تمِّ الجود والكرمِ",62,"م",1,0],["فإن تولّوا فقولوا عند فرقتهم","الحمد لله زال الظلم وانزاحا",63,"ح",2,0],["فأنت والآل عندي خير واسطة","ارصدتكم لابتغاء الخير إرصادا",64,"د",2,0],["فأنت ولا سواك وكل شيءٍ","سواك يرى فذاك خيال راء",65,"ا",2,0],["فإن توالى ضميران اكتسى بهما","وجْهُ الحقيقةِ من إشكالهِ غمَما",66,"م",2,0],["فَأَنتَ وَإِن كُنتَ القَريبَ مُبَعَّدٌ","لأَنَّكَ مِن قَلبي بِمَنزِلَةِ السِّرِّ",67,"ر",1,0],["فأنتَ وهو رَبيبا حجر مكرمةٍ","وفيكَ ما فيه مما كنتُ أرويه",68,"ي",2,0],["فان توشحت الاكرام لا عجبٌ","لأنها أُم عين الجود والكرم",69,"م",1,0],["فأنت وإن نلت المكارم فردُها","ومجموعها في جمع مجموعها فرد",70,"د",1,0],["فأنت وعدت وعدك حق","إجابة داع يروم رضاك",71,"ك",1,0],["فأنت وإن أرحت الخيل وقتا","فهمك غير هم المستريح",72,"ح",1,0],["فأنت ومن أهواه صنوا محاسنٍ","فما واحدٌ قد خس أو آخرا ربا",73,"ب",2,0],["فأنت ولي يا ولي ومنك يا","حميد ينال السؤل من أنت مولاه",74,"ا",2,0],["فأنت وفق لقول ربي:","يزيد في الخلق ما يشاء",75,"ا",2,0],["فأنت وراء الغيم حلم مجنح","أبيت اناجيه وكيف أثوب",76,"ب",1,0],["فأنت وان لم تبلغني شكاية","فقلبي متى تشكو وعينيك يكلم",77,"م",1,0],["فإن توافق على المطلوب كان بها","أو لا فأمرك عندي أخذه يجب",78,"ب",1,0],["فأنتَ ولم ينفعكَ فرّقتَ بيننا","ونحنُ جمعٌ شعبنا متدانِ",79,"ن",1,0],["[ فأَنْتَ وَحِيدُ عَصْرِكَ لا زَمِيلٌ","كَمِثْلِكَ فِي العُلا يُدْعَى زَمِيلا ]",80,"ل",2,0],["فأنتَ وإنْ طالَ عُمركَ فيها","قريباً إلى الله منها تُغادرْ..",81,"ر",1,0],["فانتِ ورسم الدار هيّجتما معا","هيامات وجدٍ لايخفّ ضرامها",82,"م",3,0],["فأنتَ ولا طريقَ إلى سواكا","أتيتكَ رافضًا دربَ المتاهِ",83,"ه",1,0],["فإن تولني عفوا فإنك أهله","ولا بدع إن عاقبت مثلي ولا غروا",84,"و",2,0],["فأنت وكيلها الأبدي","وراعيها.. وذا حسْبي",85,"ب",2,0],["فأنت وليّيْ يا وصيّ محمّدٍ","وأنت شفيعي من يقدُّ ليَ الذنْبا",86,"ب",2,0],["فإنْ تُولِني مِنْكَ الجَميلَ فإنَّنِي","عَليهِ وإنْ طَالَ الزَّمَانُ شَكُورُ",87,"ر",1,0],["فَإِن تُواخِذني فَصُنعي كَثُّ","وَإِن يَكُن لي في رِضاكَ مَغثُ",88,"ث",1,0],["فأنتِ وَرَبِّ البيت. روحي وراحتي","وأنت نسيم الشّوق وفي مُهجتي هبّا",89,"ب",2,0]]}