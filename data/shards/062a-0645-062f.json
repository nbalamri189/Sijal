"تمدين كفيك","https://www.poetsgate.com/ViewPoem.aspx?id=182450",""],[5956,"ثورة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=182636",""],[5957,"عراقية النبض تهدي السلام","https://www.poetsgate.com/ViewPoem.aspx?id=177054",""],[5957,"أغانيهِ العِذابُ","https://www.poetsgate.com/ViewPoem.aspx?id=204608",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["تَمُدُّ بِأَردافٍ ثِقالٍ وَتَرتَمي","عَلى عَجرَفِيّاتِ الصِبا وَالجَنايِبِ",0,"ب",1,0],["تَمُدُّ إِلى الماءِ أعْناقَها","وهُنَّ إذا ورَدَتْ تُضْرَبُ",1,"ب",1,0],["تَمُدُّ حِفافَيْكَ القَوافي جَناحَها","وهنَّ أفاعٍ يَحتَوِشْنَ العِدا رُقْطُ",2,"ط",1,0],["تَمُدُّ إليها الجِيدَ كَيما تَنالَهُ","ويا نُعْمَ مَلفَى العَيشِ لو كانَ دانِيا",3,"ي",2,0],["تَمُدُّ بُنُودُ النَّصْرِ مِنْهُمُ ظِلاَلَهَا","عَلَى كُلِّ مِطْعَامِ الْعَشِيَّاتِ مِطْعَانِ",4,"ن",1,0],["تُمَدُّ بِباسْمِ اللّهِ في كُلِّ مشْهَدِ","وتُرْفَعُ بعْدَ الشُّكْرِ للّهِ والحَمْدِ",5,"د",1,0],["تمدُّ لها الجوزاءُ كفَّ مُصَافحٍ","ويدنو لها بدرُ السماء مناجيا",6,"ي",2,0],["تمد لأَكواس العَرار أناملاً","من السَّوسن الغضِّ المختَّم بالتَّبرِ",7,"ر",1,0],["تمدُّ جناحيْ ظلّها في هجيرةٍ","فتحسبها في البيد خيط نعام",8,"م",1,0],["تُمَدُّون في طغيانكم وضلالكم","ويُسْتدرَج المغرور منكم فُيُدْرَجُ",9,"ج",1,0],["تَمُدُّ في أَلحانِها","مَدَّ الغناءِ المَدَني",10,"ن",2,0],["تمده كلما غا","ض دجلة والفرات",11,"ت",1,0],["تمد يميناً بالسؤال ضعيفة","وتخجل منهم عند ما هي تسأل",12,"ل",1,0],["تُمِدُّهُمُ قُذّافُهُم وَرُماتُهُم","بِنارٍ كَنيرانِ البَراكينِ تَدأَبُ",13,"ب",1,0],["تَمُدُّ على الأمواجِ باعاً كأنَّه","يُعانِقُها في مَدِّهِ ويَبوعُها",14,"ع",3,0],["تَمُدُّ إِلى تَنغيمِهِ سُبْطَ أَنمُلٍ","كَأَقلامِ دُرٍّ بالعقيقِ تقمَعُ",15,"ع",1,0],["تَمُدُّ إلى عَالَمٍ بالخُنُوعِ","وَالضَّيْمِ ذي شَرَقٍ مُتْرَعِ",16,"ع",1,0],["تَمُدُّ عَلَيكَ الظِلَّ سَرحَةُ أَبطَحٍ","بِها وَيُغنيكَ الحَمامُ المُغَرِّدُ",17,"د",1,0],["تُمِدُّ رسولَ اللَّهِ بالكُتْبِ حُفَّلاً","بأنبائهم تَطوي الفِجاجَ سوائرا",18,"ر",2,0],["تَمُدّونَ منْ أيْدٍ تَغَيَّمُ بالنّدَى","إذا ما سَماءُ القوْمِ لم تَتَغَيّم",19,"م",1,0],["تَمُدُّ بِها إِلَيكَ يَدا غُلامٍ","أَغَنُّ كَأَنَّهُ رَشَأٌ رَبيبُ",20,"ب",1,0],["تَمُدُّ عَصاكَ إِلى النابِحاتِ","فَيُعجَبنَ مِن جَأشِكَ الرابِطِ",21,"ط",1,0],["تمُدُّ يديها وتَثنيهما","وترتدُّ في عِوَجٍ واعتدالْ",22,"ل",1,0],["تَمُدّ لتَقْبِضَ القَمَرَينِ كَفّا","وتَحْمِلُ كيْ تَبُذّ النجْمَ زادا",23,"د",2,0],["تَمُدُّ يَداً نَحْوَ السَّمَاءِ خَضِيبَةً","تُصَافِحُهَا الشِّعْرَى وَيَلْثِمُهَا الْغَفْرُ",24,"ر",1,0],["تَمُدُّ أَسْبَابَ الْهُدَى نَحْوَهُمْ","مَدَّ مَنَارٍ نُورَهُ لِلرَّقِيبْ",25,"ب",1,0],["تَمُدُّ يَدَيْهَا لِلسُّؤَالِ ذَلِيلَةً","فَإِنْ سُئِلَتْ مَا يُنْكِرُ النُّبْلُ تَمْنَعِ",26,"ع",1,0],["تَمُدُّ الليالي للجريءِ زمامَها","وتعنو له الأيامُ وهي صِعاب",27,"ب",1,0],["تَمُدُّ الْمَعالِي نَحْوَ مَجْدِي رِقابَها","وَجُذَّتْ إذَا كَانَتْ لِغَيْريَ تمْتَدُ",28,"د",1,0],["تمد ببسم الله في كل مشهد","وترفع بعد الشكر لله والحمد",29,"د",1,0],["تمدّ يديها وتثنيها","وترتّد في عوج واعتدال",30,"ل",1,0],["تُمَدُّ بها أيدٍ طِوال يُطيعها البيانُ","جنيباً إن تعاصت فُنونه",31,"ن",2,0],["تَمُدُّ بِها ريح الصَبا خطواتها","وَتَرفل في ثَوب مِن النور معلم",32,"م",1,0],["تمدحُ عمروا وتُريد رِفدا","ياما خض الماءِ عَدِمتَ الزُّبْدا",33,"د",2,1],["تُمَدُّ بِأَخذِ العَفوِ وَالأَمرِ بِالعُرفِ","فَلَم يأَلُ حَتّى بَثَّ فينا جِماعَها",34,"ه",2,0],["تمد به الأيدي لك الخلق بالدعا","ويرضى به الرحمن والملأ الأعلى",35,"ل",2,0],["تمدُّ عليها كالمجاذيف اذرع","وكل سواريها هناك نحورُ",36,"ر",1,0],["تَمُدُّ إِلى الإِحسانِ كَفّاً بَنانُها","يُناطُ بِهِ زَندٌ مِنَ الخَيرِ مَبتورُ",37,"ر",1,0],["تمد للخير باعا ما به قصر","يَفيض فضلا عَلى حاف وَمتعل",38,"ل",1,0],["تَمُدُّ زِمامَها مِنها بِسامٍ","مَرُوحٍ في قَوائِمِها اِعتِلاءُ",39,"ا",2,0],["تَمُدُّ الزِمامَ وَالجَديلَ إِذا مَشَت","مُواشِكَةٌ غَلباءُ كَالبُرجِ عاقِرُ",40,"ر",1,0],["تَمُدُّ أمامَ السِربِ للرّكْبِ جيدَها","فللّهِ من وَحشيّةٍ ما نَصيدها",41,"د",3,0],["تُمِدُّ راياتِهمُ","آراؤه بالسَّداد",42,"د",1,0],["تَمَدّونَ مِنّي الذَنبَ وَالذَنبُ كامِنٌ","وَتَعمَونَ دونَ العُذرِ وَالعُذرُ لائِحُ",43,"ح",1,0],["تَمُدُّ إِلى الأَعداءِ مِنها مَعاصِماً","فَتَرجِعُ مِن ماءِ الكُلى بِأَساوِرِ",44,"ر",1,0],["تمدُّ إذا شُعشِعَت كالهَبا","ءِ إذا كان قُدَّامها أو وَرا",45,"ر",2,0],["تَمُدُّ الرِيا فخّاً لعُجبٍ تصيدُه","فواعجباً من عالمٍ فيه قانع",46,"ع",1,0],["تَمُدُّ له اليَدَ اليُمْنَى احتفاءً","وتمنح غيرَه طَرَفَ الشِّمال",47,"ل",1,0],["تمدُّ به فيقصرُ في خطاها","من البَيْداء أبواعٌ طوال",48,"ل",1,0],["تمدّ جناحاً من قوادمه الصّبا","تروم بأكناف الغريّ لها وكرا",49,"ر",2,0],["تمُدّ أباً وابناً لنحر حسودها","أنابيبُ لم تعلَقْ بهنَّ وُصومُ",50,"م",1,0],["تمدكم طلَّ الثنا","ء سحبُها ووبلَهْ",51,"ل",2,0],["تمدّني من بحرها","في كلِّ يومٍ جدولا",52,"ل",2,0],["تمُدّ بحبلٍ غيرِ منتقض القُوَى","وتسكن عزّاً غيرَ منتقلِ الظلِّ",53,"ل",1,0],["تمدّ للخطب يداً مقبوضةً","لا سيفُها فيها ولا سِوارُها",54,"ر",3,0],["تمُدُّ بالآذان والمناخِرِ","لحاجرٍ ومَن لها بحاجرِ",55,"ر",1,1],["تَمُدُّ لك الدنيا مَطَاها ذليلةً","فَتركَبُ منها ما تشاءُ وتُركِبُ",56,"ب",1,0],["تمدُّ برقراق الدماءِ جراحُها","أَتيّا ولمَّا يأَتِ سيلُ المذانبِ",57,"ب",1,0],["تمُدُّ إِلى العليْاءِ كَفّاً بَنانُها","بسلمٍ وحربٍ تقْطرُ الجود والدما",58,"م",2,0],["تمُدُّ بدُفَّاعِ الدِّماءِ حُروبُهُ","فكُلُّ دَمٍ أجرتْ ظُباهُ جُراجر",59,"ر",1,0],["تَمُدُّ لَهُ حَوالِبُ مُشعَلاتٌ","يُجَلِّلُهُنَّ أَقمَرُ ذو اِنعِطاطِ",60,"ط",1,0],["تمدُّ إلى لمعِ السرابِ رقابَها","وقد غرّها فيه مِنَ الماءِ تمِثالُ",61,"ل",1,0],["تمدُّ لكُمْ من جانِبِ اللهِ منَّةٌ","تفيضُ ببحرٍ عامِرِ الموجِ لاجِبِ",62,"ب",1,0],["تُمَدُّ الحربُ منك بلَوْذَعِيٍّ","يسعّرها إذا خَبَتِ اِشتعالا",63,"ل",2,0],["تَمدُّ بِهَا في السَّيْرِ أَجْيادُهَا الَّتي","كَأَنَّ لِحَى الأَعْداءِ فيها بَراجِمُ",64,"م",1,0],["تَمُدُّ نَباهَةً عقلِي كما قد","يَمُدُّ ذُبالَةَ النِّبراسِ زَيتُ",65,"ت",1,0],["تُمَدُّ طوراً سُجفَها","وتارةً تُماط",66,"ط",1,0],["تَمُدّ إِلَينا كَالخيوطِ شُعاعَها","فَخِلناهُ مِنّا كَالرِّماحِ تصوَّبُ",67,"ب",1,0],["تَمُدُّ شُعاعَ النّفعِ بِالخيرِ لِلوَرى","وَخَيرُ شُعاع الشّمسِ مِنها المَنافِعُ",68,"ع",1,0],["تَمُدُّ ظِلالَ العَدلِ في كلِّ جانِبٍ","وَتَستَأصِلُ الإِجنافَ وَالجَورَ بِالهدِّ",69,"د",1,0],["تَمُدُّكَ أجناد الملوك تَقرُّباً","وجندُ السَّخين العينِ جَزْرٌ ولا مَدُّ",70,"د",1,0],["تمدحُها وهْي على حالةٍ","سريعةِ التغيير والإنقلابْ",71,"ب",1,0],["تمدح من لم تلق ما تبتغى","هذا هو الشىءُ العُجابُ العُجاب",71,"ب",1,0],["تمُدَّ ذراعيها دِلاثٌ شِملَّة","بمجرى صفيحات من المَيسِ نُصَّلِ",72,"ل",1,0],["تمدّها من حمى الأحرار زغردة","فارتاع مرتجفا واصفرّ حيرانا",73,"ن",2,0],["تَمُد أَدْراك القَوِيِّ المُحْكَمِ","وَتَقْبَل الأَخْلاقَ بِالتَقَمُّمِ",74,"م",1,0],["تمد كف بنان اللهو محتلبا","من الجديدين مرعى غير محتلب",75,"ب",1,0],["تمداحهُ فضلٌ على الترك الذي","في باب جدواه العميمة مرتمي",76,"م",2,0],["تّمُدُّ إلى الجَوْزاءِ أَرْماحَ مائِها","فَتَذْعَرُها في أُفْقِها وتَرُوعُها",77,"ه",2,0],["تمدح الخير ولا تفعله","وترى الحل فيعميك الحرام",78,"م",1,1],["تمدَّنت السودان منه بحكمةٍ","يكاد يرد الليل رونقها فجرا",79,"ر",2,0],["تمدح لي فجئت إليه أسعى","أجاب برأفة صوت المنادي",80,"د",2,0],["تمد ذراعيها وتخطر تارة","وفي معصميها للحلي رنين",81,"ن",1,0],["تُمِدّهُم شمسُ الجنوب أخو الوفا","سليلُ بني المَزوارِ حُقَّ له السّبقُ",82,"ق",1,0],["تَمُدان أنور الجمال ضحوكةً","إلى أُفُقٍ قاصٍ تارمت جوانبه",83,"ب",2,0],["تمديُنهم مصائبُ صائبات","يضيق ببعضها الصدر الوساع",84,"ع",1,0],["تمد إليه الظلَّ يعبسُ وجههُ","إذا ما شعاعٌ في الغصون تبسما",85,"م",2,0],["تم دمعي على هواكم والدم","ع على كل ذي هوىً نمام",86,"م",1,0],["تَمدّ إِلى الأَزاهر مِن لُجَينٍ","لَجيناً مِن أَناملها المِلاح",87,"ح",1,0],["تَمدُّننا أَعلى مَناراً وَرُوحنا","بِرَغم اِنحِطاط الجسم عِندَ العُلى أَرضى",88,"ض",2,0],["تَمدُّ يَدَيها وَهِيَ حانِقَة لِكَي","تَستّر حسن الساق وَالحسن فاضح",89,"ح",1,0],["تَمَدَّحتَ لَيلى فَاِمتَدِح أَمَّ نافِعٍ","بِعاقِبَةٍ مِثلَ الحَبيرِ المُسَلسَلِ",90,"ل",1,1],["تُمَدُّ بأفلاذ الزنوج إذا خبت","فتحكي جحيم الزنج في يوم محشر",91,"ر",1,0],["تمد له الايدي وأنى ينال من","به حلقت عن طاير الوهم علياه",92,"ا",2,0],["تَمُدُّ مُلو