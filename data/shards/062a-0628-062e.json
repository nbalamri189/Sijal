{"poems":[[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[93,"كأني في روض أرى الماء جاريا","https://www.aldiwan.net/poem8854.html","عموديه"],[45,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[83,"وداع قلب أزفا","https://www.aldiwan.net/poem61459.html","مجزوء الرجز"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[78,"مقيلك تحت أظلال العوالي","https://www.aldiwan.net/poem39442.html","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[92,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[77,"تقدّم خطى ً أو تأخّر خطى ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10782&r=&rc=2",""],[151,"تبخر بعود الطيب لا زلت طيبا","https://www.aldiwan.net/poem47631.html","الطويل"],[227,"أو لم يأن أن يفيق من الغفلة","https://www.aldiwan.net/poem55408.html","الخفيف"],[240,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[409,"وكم غافل غره مادح","https://www.aldiwan.net/poem33766.html","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48507","الطويل"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136784",""],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142906","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68014","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114100","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40124","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127121","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136742",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133142","المجتث"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123871","المنسرح"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204172","المنسرح"],[4692,"طفل تبخر في الايام وانفلتا","https://www.poetsgate.com/ViewPoem.aspx?id=190440",""],[4858,"في ظل الحضارة الزائفة","https://www.poetsgate.com/ViewPoem.aspx?id=33863",""],[4875,"الشُهرة","https://www.poetsgate.com/ViewPoem.aspx?id=133719",""],[4968,"صولات الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=208105",""],[5074,"خَرِيْفُ العُمر","https://www.poetsgate.com/ViewPoem.aspx?id=155797",""],[5368,"طوقاً من نجاة","https://www.poetsgate.com/ViewPoem.aspx?id=184389",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5461,"وداع يا نفس","https://www.poetsgate.com/ViewPoem.aspx?id=5040",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5582,"قِفْ بِالدِّيارِ دِيارِ الحَيِّ مِنْ إِضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=63571",""],[5956,"صُوَرُ الحب العميق","https://www.poetsgate.com/ViewPoem.aspx?id=182026",""],[6027,"وأحرز في الجوى السبقا","https://www.poetsgate.com/ViewPoem.aspx?id=187669",""],[6056,"حمامة الأفكار","https://www.poetsgate.com/ViewPoem.aspx?id=130504",""],[6152,"تبخرت الوعود","https://www.poetsgate.com/ViewPoem.aspx?id=213195",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[463,"تغربْ فالبدار الحبيبة ِ دارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60062&r=&rc=118",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""]],"verses":[["تبخل إلا على القُمُدّ إذا","شقَّقَ ذاتَ الدلالِ والخفر",0,"ر",1,0],["تُبخّلُ البحرَ نفسي ما عرضتَ لها","أو تزدري البدرَ أو تستصغر الجبلا",1,"ل",2,0],["تَبَختَرَ فَوقَ الطِرسِ يَسحَبُ ذَيلَهُ","فَقالوا بِهِ كِبَرٌ فَقُلتُ عَنِ الكِبَرِ",2,"ر",1,0],["تَبخَلُ أَيدينا بِأَرواحِنا","عَلى زَمانٍ هِيَ مِن كَسبِهِ",3,"ب",2,0],["تَبخَلُ أَن تُحيِيَ بِاللَ","فظِ مُحِبّاً تَلِفا",4,"ف",2,0],["تَبَخْتَرُ في عُصْفُرٍ من دَمٍ","وتَخْطِرُ في لِبَدٍ من قَنا",5,"ا",1,0],["تَبَخترُ في قمِيصٍ مِنْ دِلاصٍ","وَتَرْفُلُ في رِداءٍ مِنْ نِجادِ",6,"د",1,0],["تبخلُ الكفُّ أن تُشير من البْر","دِ ويخشَى المقرورُ من لفَتاتهْ",7,"ت",2,0],["تبخَل الدنيا بآسادِ الشرَى","أيّها الدنيا إلى كم تَبْخَلين",8,"ن",1,0],["تَبخَس الأوطان ظلماً حقَها","ثم لا يُسترخَصُ العمرُ الثمين",9,"ن",1,0],["تبخترُ عصفرٍ من دمٍ","وتخطرُ في لبدٍ من قنا",10,"ا",1,0],["تبخّر بعود الطيب لا زلت طيبا","ورش بماء الزهر يا خلّ والورد",11,"د",1,1],["تبخل الأغنياء خشية إملا","ق وفي فاقة القنوع ثراء",12,"ا",2,0],["تَبَختَرَ مَحتوماً إِلَيكَ وَإِنَّهُ","لَمَشيُ دَلالٍ لا تَبَختُرُ إِدلالِ",13,"ل",1,0],["تبختر تيها لإِطرائه","ونازع في الكبريا من برا",14,"ر",2,0],["تبخترن فيها معجباتٍ وإنما","يروق ويحلو في الحسان التبختر",15,"ر",1,0],["تبخل بالوصل على أنني","بدر دمعي في هواها أجود",16,"د",1,0],["تبخرت الأجساد في لحظة.. ومَن","أصيبوا على بعد كما الشمع ذُوِّبوا",17,"ب",3,0],["تَبَخْترُ فِي ثوبِ الدلالِ منيعةً","وعينُ رقيبِ المجدِ فِيهَا تُخالس",18,"س",1,0],["تَبَختَرَ لَيلٌ مُطلِعٌ فَجرَ أحمَدٍ","عَلَى لَيلَةِ القَدرِ الَّتِي قَد تَعَلَّتِ",19,"ت",1,0],["تَبَخْتَرُ في كسا عدْلٍ وبذلٍ","مدبَّجة التَّهائم والنِّجادِ",20,"د",1,0],["تبختر ببرد طرزته يد العلى","وزرره الاقبال باليمن والبشرا",21,"ر",2,0],["تبخلُ بالوصل وهذا شأن من","بالجود قد عممَّ البرايا أجمعا",22,"ع",2,0],["تبخل بالكلام","ما كان ذا فيك ظني",23,"ي",1,0],["تبختر وازه بالجمال","فما ضر لطفك الدلال",24,"ل",1,1],["تبخرت والعثان يكنفها","فكانت البدر وسط هالته",25,"ه",1,0],["تبخر اليوم تلو اليوم من حزن","وشاخ حزني وفي درب الرجا نبتا",26,"ت",2,0],["تَبَخَّرَت غَيْرَةٌ منا قد اشتَهَرَتْ","فيما مضى أين منا اليومَ زاكيها ؟",27,"ي",3,0],["تبختر يا قصيدي حيل بأسوّي منك موسوعه","يشبّ النار يا عيني يدوّر من يطفّيها",28,"ي",3,0],["تبخترتَ في روضي بديباجِ لهفتي","وكلُّ حريرٍ فيَّ منكَ جميلُ",29,"ل",1,0],["تَبَخَّرَ الحِسُّ مِنْ قَلْبِيْ ومِنْ كَبِدِيْ","حَتَّى غَدَوْتُ كَوَهْمٍ مَا لَهُ أثَرُ",30,"ر",1,0],["تَبَخْترْ في الوَريدِ كما تَشاءُ","فأنتَ الدِّفءُ إِنْ طالَ الشِّتاءُ",31,"ا",2,1],["تبختره حسنٌ كأن بعينه","جميلا كميس الغصنِ في خطوه مَهْلُ",32,"ل",1,0],["تبخّرت روحي من حياض ماها","يتلّها نزّاع الأرواح بركود",33,"د",1,0],["تَبَخْتَرُ فِي غُرِّ المَعانِي كأَنَّها","عَرُوسٌ مِنَ البِيضِ الخِرادِ رَداحُ",34,"ح",1,0],["تَبَخْتَرَتْ فِي بُرُودِ الفَخْرِ أُمَّتُهُ","بِهِ وَطالَتْ مَيادِيناً عَلَى الأُمَمِ",35,"م",1,0],["تبخَّرَ كل الأسى من فؤادي","مجرَّدَ شكواي منك لربِّي",36,"ب",2,0],["تبخترَ في دمي عشقاً","فيا ويلي لما ألقى",37,"ق",2,1],["تبخترت في مشيها لي وشاحت","خلف السواد اللي مغطي بعضها",38,"ض",3,0],["تبخرتَ الوعود؛ وكان وهما","حديثكَ عن مواعيد الإياب!",39,"ب",1,0],["تبخّر العشق من نبضي ومن حلمي","وأسدل الليل للآمال أستاري",40,"ر",2,0],["تبخرتُ أقصى جودهِ وهو كارة ٌ","ولم يك للمولى عليّ خيارُ",41,"ر",1,0],["تَبَخْتَرَ الإِثْمُ في أَجْنَابِهَا وغَدَتْ","مَصَائِرُ النَّاسِ للأَقْدَارِ والصُّدَفِ",42,"ف",1,0]]}