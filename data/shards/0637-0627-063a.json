{"poems":[[99,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131718",""],[4929,"ارهاصات النهاية","https://www.poetsgate.com/ViewPoem.aspx?id=199351",""],[5302,"خير الأحبة نجود","https://www.poetsgate.com/ViewPoem.aspx?id=201738",""],[5431,"نسيم روحك مثل الفجر تعشقها","https://www.poetsgate.com/ViewPoem.aspx?id=189650",""],[5931,"بس أمل !","https://www.poetsgate.com/ViewPoem.aspx?id=175192",""],[5939,"لستِ أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=185492",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""]],"verses":[["طاغياً يعصف عصفاً بالرشاد","ظامئاً سيان قرب وبعاد",0,"د",1,0],["طَاغٍ أَلَمَّ بِكُمْ وَهْناً يُرَاوِدُكُمْ","عَنْ عِصْمَةِ الدَّارِ لاَ يَعْتَاقُهُ رَشَدُ",1,"د",1,0],["طاغوت معورات ربا حوزق له المربيط","والقتل والنهب والتقسيم للأصنام",2,"م",1,0],["طاغي سلاحِكَ أطغى منه غضبتُنَا","إنْ فاهَ بركانُها الجبارُ مندَلِعَا",3,"ع",2,0],["طاغ بروعة حسنه فإذا دنا","يغري وللحظ المغير بريق",4,"ق",1,0],["طاغور قومك قد شابهت حكمته","ببحر شعرك كل الدُر قد جُمعا",5,"ع",2,0],["طاغية واللي اهتدى بك ما يميل","في غواية فتنتك حكمه وعدل",6,"ل",1,0],["طاغٍ جمالُكِ ما لِقلبِكِ قاسيًا؟","سوءُ السَّجِيَّةِ في خِصالِكِ سَبعُ",7,"ع",1,0],["طاغوتُ هذا العصرِ جنَّ جنونُهُ","فقد الصوابَ ، وغابَ عنهُ رشادُ",8,"د",1,0]]}