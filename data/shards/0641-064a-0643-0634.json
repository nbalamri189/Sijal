{"poems":[[74,"بأبي أنت حلوة الريق لكن","https://www.aldiwan.net/poem20610.html","الخفيف"],[53,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[94,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[196,"يطيب العيش أن تلقى حكيما","https://www.aldiwan.net/poem27462.html","الوافر"],[358,"قلت يوما لزائر فيه ساءت","https://www.aldiwan.net/poem39978.html","الخفيف"],[411,"وإني لمحتاج إلى سيد له","https://www.aldiwan.net/poem50092.html","الطويل"],[449,"في الشام دار الكتب مجد لنا","https://www.aldiwan.net/poem55957.html","عموديه"],[466,"يمل هواه كل سرج وسابح","https://www.aldiwan.net/poem15449.html","الطويل"],[466,"تتيه به الأيام فخرا وغبطة","https://www.aldiwan.net/poem16121.html","الطويل"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96759","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96721","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204966","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35637","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36261","الدوبيت"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139667",""],[4748,"صورتك","https://www.poetsgate.com/ViewPoem.aspx?id=6664",""],[4859,"بهي المحيا!","https://www.poetsgate.com/ViewPoem.aspx?id=198167",""],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[5582,"أَبَرْقَ الأَبْرَقَيْنِ أَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63574",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""],[5809,"قلمي","https://www.poetsgate.com/ViewPoem.aspx?id=205081",""],[5953,"إذا ضاق صدري بالهموم رأيتني","https://www.poetsgate.com/ViewPoem.aspx?id=93873",""]],"verses":[["فيكِ شهد وفيكِ لسع فرفقاً","بشجيٍّ أمسى وأنتِ خليَّه",0,"ه",1,0],["فيك شَوْب من الجفاء مع الخن","ث كأن قد قَدِمت من ترعوز",1,"ز",1,0],["فيكِ شبَّ الشَّبابُ وشَّحهُ السّحْرُ","وشدوُ الهَوَى وعِطْرُ الورودِ",2,"د",1,0],["فَيَكشِفُ عَنكَ حيرَةَ كُلِّ جَهل","فَفَضلُ العِلمِ يَعرِفُهُ الأَديب",3,"ب",1,0],["فيكَ شَيءٌ مِن العَجائب أَضحى","ما أَرانا لَهُ الزَمان مَثيلا",4,"ل",2,0],["فَيَكشِفُ أياَّمَ الجُدوبِ سَماحُةُ","وتَفتُق أكمامَ الغُيُوبِ تجارِبُهْ",5,"ه",1,0],["فيكشف الخطب ويغدو لنا","من كل عاد جاهل جنه",6,"ن",2,0],["فيكشف مُغبرَّين عن جونة الضحى","بسورة جدبٍ أو بحومةِ مازقِ",7,"ق",1,0],["فيكشف ليل الخطب والخطب حالكٌ","ويجلو عجاج الحرب واليومُ قاتمُ",8,"م",1,0],["فيكشف لي علم الحروف وكيف كا","ن وضع لها من لي حضرة نوريه",9,"ي",2,0],["في كشرِها ضمرٌ في قدِّها سمرٌ","أزهارها ثمرٌ يزهو برمَّانِ",10,"ن",1,0],["فَيكشف إِن دجت ظلم الد","دجا بِضيائهِ الظلما",11,"م",2,0],["فيكشف للرائين ما لا يرونه","فأعظم كل الكاشفين شعور",12,"ر",1,0],["فيكَ شَهران مِن العا","م إِذا العام تَصَرَّم",13,"م",1,0],["في كَشفِ نِقابها بِضَبعي خَذَبَت","لُطفاً فَأَنا المكاشَف المَجذوبُ",14,"ب",1,0],["فيكشف أسرارَ القلوب سناؤها","ويهتك أستارَ الغيوب سفورها",15,"ر",3,0],["فيك شِعري واسأل حْروفه","واسأل اقلامي والاوراقي",16,"ق",2,0],["فيك شهر الحنينِ يزدادُ شوقِي","لأبٍ لم يزلْ بقلبيَ حيّا",17,"ي",2,1],["فيكشِفُ لي سريرتَهُ","فما دونَ النّدى حُجُبُ",18,"ب",1,0],["فَيَكْشِفُ إِنْ دَجَتْ ظُلَمُ ال","دُّجَى بِضِيائِهِ الظُّلَمَا",19,"م",2,0],["في كشفه للغيب في تعليمه","في شرعه في الاحتجاج المفحم",20,"م",1,0],["فيك شوقٌ وللطلول عتابٌ","زاد وخزا من شوكها اكليلُ",21,"ل",1,0],["فيكشفُ رأسَهُ ويرومُ قوسًا","فإنَّ الحربَ تبدأُ بالنبالِ",22,"ل",1,0],["فيكشفها ربي بآل محمد","ويشفي غليلي من جميع خصومي",23,"ي",1,0]]}