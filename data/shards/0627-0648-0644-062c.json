{"poems":[[53,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[53,"يا قاتل السنور والديك","https://www.aldiwan.net/poem65828.html","الطويل"],[40,"ألا اسلمي اليوم ذات الطوق والعاج","https://www.aldiwan.net/poem7694.html","البسيط"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87087","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[4238,"","https://poetry.dctabudhabi.ae/diwan/poem/147738","المنسرح"],[4898,"وطني الكبير !","https://www.poetsgate.com/ViewPoem.aspx?id=35778",""],[5528,"قراءة لعيون بيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=201137",""]],"verses":[["أولجتُ في ثُقبَتَيها","أيراً بطُولي وعرضي",0,"ض",2,0],["أولجتُ في فيها الذي في استها","آلة تحنيك وتسويك",1,"ك",1,0],["أَولَجتُ حانوتَهُ حُمراً مُقَطَّعَةً","مِن مالِ سَمحٍ عَلى التُجّارِ وَلّاجِ",2,"ج",1,0],["أَولَجتَهُ النَفَقَ الَّذي مَن أَمَّهُ","ماتَت ضَغينَتُهُ وَعاشَ ذَليلا",3,"ل",2,0],["أَو لِجَمع الأَموال مِن باب زورٍ","حَيث أَمسى بِها أَسير غَرام",4,"م",1,0],["أوْ لُجَّةً بِلُجَيْنِ المَوْجِ تُرْقَمُ أوْ","قِبَابَ يَشْمٍ عَلاَهَا دُر حَصْبَاءِ",5,"ا",2,0],["اول جمعة تكون في رجب","وبعد عشرين وسبع تحتسب",6,"ب",1,0],["أولجته صعدة موقعة","سنانها كالشهاب في الظلمه",7,"م",2,0],["أو لجّة ً رقْراقَة ً ببُحَيرةٍ","أو جَدولاً متسَلسِلَ الجَرَيان ِ",8,"ن",1,0],["أوْلُجَّتَانِ تَرَائَى الحُلْمُ بيْنهُمَا","فُلْكًا يشُقُّ عُبَابيْ مَا ارْتَأَى سَمَتَا",9,"ت",2,0]]}