name=Sh3er&doWhat=shqas&qid=85973&r=&rc=10",""],[6239,"نُور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75986&r=&rc=37",""],[463,"آنسة ٌ لا تكتم القولَ الحسنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60217&r=&rc=273",""],[6352,"كذا يظهر المعجز الباهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22746&r=&rc=7",""]],"verses":[["تَحَدو اللَيالي بِهِم رِفاقاً","ما ضيهِمُ مُعوَزُ الرُجوعِ",0,"ع",1,0],["تحدّيت بالأمس الحكومة ، مجرم","رهنت لدى الخباز ، أمس جواربي",1,"ب",2,0],["تَحدو بِهِم أَعوَجِيّاتٌ مُضَمَّرَةٌ","مِثلُ السَراحينِ في أَعناقِها القَبَبُ",2,"ب",1,0],["تُحَدِّثُ عَنّا في الوُجوهِ عُيونُنا","وَنَحنُ سُكوتٌ وَالهَوى يَتَكَلَّمُ",3,"م",1,1],["تُحَدِّثُني الأَحلامُ إِنّي أَراكُمُ","فَيا لَيتَ أَحلامَ المَنامِ يَقينُ",4,"ن",1,0],["تُحَدِّثُنِي عَنْهَا الشَّمَالُ فَتَنْثَنِي","وَقَدْ عَرَفتْ مِنِّي شَمَائِلَ نَشْوَانِ",5,"ن",1,0],["تُحَدِّثُني أَنّي كَبيرٌ فَإِنَّني","كَبيرٌ وَلَكِن أَيَّ شَيءٍ أَشابَكا",6,"ك",2,0],["تَحَدَّرَتِ المَدامِعُ مِنكَ حَتّى","تَعَلَّمَ مِن مَحاجِرِكَ الغَمامُ",7,"م",1,0],["تَحَدَّرَ وَاِنبَتَّ مِنهُ النِظامُ","فَاِنسَلَّ مِن سِلكِهِ أَجمَعُ",8,"ع",1,0],["تَحَدَّبُ سَعدٌ وَالرِبابُ وَراءَها","عَلى كُلِّ طَرفٍ أَعوَجيٍّ مُسَوَّمِ",9,"م",1,0],["تَحدو سُرَاها أَرجُلٌ لا تَفتُرُ","كَأَنَّهُنَّ الشَوحَطُ الموَتَّرُ",10,"ر",1,0],["تُحدى الركاب إلى البيت العتيق به","فمكّةٌ عَمَرَتْ منه نَواديها",11,"ي",3,0],["تحدو قوائمَ كالجذوع وفوقها","جبلٌ أشمُّ بنوره متوارِ",12,"ر",1,0],["تحدثك الأنفاس فيها عن اللما","ويأتيك بالأخبار من لم تزَوَّد",13,"د",1,0],["تُحْدَى الرِّكابُ بذكره فترى الحصَى","منْ بين مَنْجُول وبين ضَريحِ",14,"ح",1,0],["تحدّيتَ صَلّاً وفي نفْثه","نذيرٌ فأقلِع ولم تُنهش",15,"ش",1,0],["تحدثت الأَملاء أنك حابِسي","على غيرِ إجرامٍ وأنك مغتالي",16,"ل",2,0],["تُحِدُّ لنا أيدي الزمانِ شِفاره","ونرتع في أكْلائِه رَتْعَةَ النّعَمْ",17,"م",1,0],["تَحَدَّرَ عَن شاهِقٍ كَالحَصي","رِ مُستَقبِلَ الريحِ وَالفَيءِ قَر",18,"ر",1,0],["تَحدو بِهِم نَبَطٌ صُهبٌ سِبالُهُمُ","مِن كُلِّ أَحمَرَ مِن حَورانَ مُؤتَجَرِ",19,"ر",1,0],["تُحَدِّثُني أَن لَستُ لاقي نِعمَةٍ","بَعِدتَ وَلا أَمسى لَدَيكَ نَصيحُ",20,"ح",1,0],["تُحَدِّثُهُم بِمَعاني الغِنا","ءِ عَن بَثِّ نَفسٍ وَأَشواقِها",21,"ق",3,0],["تَحَدَّرَ بِالدُرّاجِ مِن كُلِّ شاهِقِ","مُخَضَّبَةٌ أَظفارُهُنَّ دَوامِ",22,"م",1,0],["تُحَدِّثُنا كَفّاهُ وَالمَحلُ راهِنٌ","عَنِ الأَرضِ تُكلا وَالسَماءِ تُغامُ",23,"م",1,0],["تَحَدَّرَ قَبلَ النَجمِ مِمّا أَمامَهُ","مِنَ الدَلوِ وَالأَشراطِ يَجري غَديرُها",24,"ر",3,0],["تَحَدَّرَ قَبلَ النَجمِ مِمّا أَمامَهُ","مِنَ الدَلوِ وَالأَشراطِ يَجري غَضيرُها",25,"ر",3,0],["تُحدَى بألسنةِ الرُّعودِ عِشارُه","فتسيرُ بين مُغَرِّدٍ ومُزَمْجِرِ",26,"ر",1,0],["تُحَدِّثُ أَخبارَها رَبُّها","وَرَبُّكَ لا شَكَّ أَوحى لَها",27,"ل",3,0],["تُحدّثُني بالسرِّ في ثِنْيِ ساعدي","فيسمعُ نجوى السرّ من فمها فمي",28,"م",2,0],["تُحَدِّثُنا عَنهُ العُلَى وَبِمثلِ ما","تُحَدِّثُنا عَنهُ تُحَدِّثُنا عنكا",29,"ك",2,0],["تُحْدَى بسحرِ ساهرٍ في نِغْضَةٍ","شهمِ الجنَانِ لَوذَعِيٍّ أَلمَعي",30,"ع",2,0],["تُحدّثُ عيني عينَهُ بالّذي يرَى","بوجهكَ لي من حُسنِ مائيّة البِشرِ",31,"ر",1,0],["تَحدو عَذابَكَ فيه للوَغَى عَذَبٌ","تَهفو كَأَيدي الثكالى طِشْنَ من حررِ",32,"ر",1,0],["تَحَدَّرَ مِن لِهبَيهِ يَرجو غَنيمَةً","بِساحَةِ لا الواني وَلا المُتَخاذِلِ",33,"ل",1,0],["تحدبتم علىَّ ينثُ حولي","نديُّ الحبَّ والطفُ المجود",34,"د",1,0],["تَحَدُّرَ غُصنِ البانِ لانَت فُروعُهُ","وَجادَت عَلَيهِ ديمَةٌ ثُمَّ أُرهِما",35,"م",2,0],["تُحدِّثُ عن مَخاوفِ باعِثيها","حَديثاً يَبعثُ العَجَبَ العُجابا",36,"ب",2,0],["تَحدّاهُ الزُّبَيْرُ وفي يَديْهِ","قَضاءٌ خفَّ عاجِلُه إليْهِ",37,"ه",1,0],["تَحْدُوا عَزَائمُهُ العِبادَ كأنَّما","تَخِذَتْ عزائِمُهُ الفضاءَ سَبيلا",38,"ل",2,0],["تَحَدُّبَ الشَيخِ عَلى أَبنائِهِ","يُكِنُّهُ بِاللَيلِ في غِطائِهِ",39,"ا",3,0],["تَحَدَّرَ ماءُ مُقلَتِهِ","فَخَرَّقَ وَردَ وَجنَتِهِ",40,"ت",2,1],["تُحدُّ في كلّ شهر","جفونهُ وتُغيّر",41,"ر",1,0],["تُحَدِّثُكَ الظُنونُ بِما تُلاقي","كَأَنَّ الظَنَّ عَلّامُ الغُيوبِ",42,"ب",1,0],["تُحِدُّ شِفارَها لِرِدى بَنيها","وَما تُرجى كَرامَتُها لِشِفرِ",43,"ر",1,0],["تُحَدِّثُ هَذِهِ الأَيّامُ جَهراً","وَيحُسَبُ أَنَّ ما نَطَقَت هَسيسُ",44,"س",1,0],["تَحَدَّثوا بِمَخازيهِ مُكَتَّمَةً","وَقابَلوهُ بِإِجلالٍ وَهابوهُ",45,"ب",3,0],["تحدّبتم علىَّ ينثُ حولي","نديُّ الحبَّ واللطفُ المجود",46,"د",1,0],["تَحَدَّرُ صِبْيَانُ الصَّبَا فَوْقَ مَتْنِهِ","كَمَا لاَحَ في سِلْكٍ جُمَانٌ مُثَقَّبُ",47,"ب",1,0],["تحدَّرَ من وراء الغَي","مِ حينَ رآكِ واستأنى",48,"ن",2,0],["تحدَّرَ مختنِقاً فوقها","بلا نبأةٍ قطرُهُ المنسكبْ",49,"ب",1,0],["تحدَّى الحياةَ وآلامَها","ببأسِ الجبابرة الأعلياء",50,"ا",2,0],["تُحدِّثني عيني وقد سِرتُما معاً","حبيبانِ سارا أم هما أخوانِ",51,"ن",1,0],["تحدَّثتَ عَنِّي وعن قُبلةٍ","فيا لكَ من كاذبٍ مُلهَمِ",52,"م",1,0],["تحدّرا مزنين من غمام","ولاقيا الديمة في الأعمام",53,"م",1,0],["تَحَدَّثُ الغُصُونُ عَنْ","قَوَامِهَا المُعْتَدِلِ",54,"ل",1,0],["تَحَدَّثْ إِلى شَتَّى الجَمَاعَاتِ تُلْفِهَا","ثَكَالى وَقَدْ بَانَ العَمِيدُ المُنَاجِد",55,"د",1,0],["تُحْدَى بِهَا اليَعْمَلاَتُ الكُومُ إِنْ لَغِبَتْ","فَلاَ تُحِسُّ بِإِنْضَاءٍ وَلاَ لَغَبِ",56,"ب",1,0],["تَحَدُّثُ النَّاسِ هَمْسٌ","كَأنَّمَا هُوَ فِكْرُ",57,"ر",1,0],["تحدَيتِ الخطوبَ تزيدُ هَوْلاً","فتزدادين صبراً واعتِزاما",58,"م",2,0],["تَحَدَّتْ فُنُونَ المَوْصِليِّ وطوَّحَتْ","بأَنْفَسِ ما ضُمَّتْ عَلَيْه بنَاصرُهْ",59,"ر",2,0],["تحدّاه وصال ولو سواه","أراد لما استطاع ولا تحدّى",60,"د",2,0],["تَحَدَّثت في المِذْيَاعِ عن فَضْلِ صَوْمِه","وكَمْ مَثَلٍ عالِي الذُّرَا أَنْتَ ضارِبُهْ",61,"ب",2,0],["تحدّثت الدنيا بسعدٍ ومصطفى","وهل قُرئتْ أم الكتابِ بِلاَ بسمِ",62,"م",1,0],["تحدّثتِ الدنيا بهم في شبابِها","وجاءت إلى أبنائِهم تتطلَّع",63,"ع",1,0],["تحَدَّى العصامِّيين؛ عزمًا، وهمَّةً","وِبذَّ العظاميِّين؛ أصلاً، ومَحتِدا",64,"د",2,0],["تَحدَّرُ في مهوىً تلقفَ قُرْصَها","تلقُّفَ تَنُّورٍ رغيفاً محصبا",65,"ب",2,0],["تحدَّتْ عُبابَ البحرِ تُزعجُ حُوتَهُ","ومن قبلهِ في البرّ أزعجتِ الضَّبَّا",66,"ب",2,0],["تَحَدَّتْهُ أصنافُ الرزايا فضيَّقَت","عليه ولا تضييقَ فقر مخيِّم",67,"م",1,0],["تحدث أوضاع العراق بنهضة","ترددها أسواقه والشوارع",68,"ع",1,0],["تحدثني أن لستُ لاقي نعمٍة","بعدتَ، ولا أمسى لديكَ نيحُ",6