{"poems":[[80,"تنام ومدنفها يسهر","https://www.aldiwan.net/poem14245.html","المتقارب"],[47,"ضراط ابن ميمون صوت العروب","https://www.aldiwan.net/poem11435.html","المتقارب"],[47,"ما لها أولعت بقطع الوداد","https://www.aldiwan.net/poem63473.html","الخفيف"],[107,"هي الحماية هب اليوم داعيها","https://www.aldiwan.net/poem43142.html","البسيط"],[47,"ضراط ابن ميمون وصوت العروب","https://www.poetsgate.com/ViewPoem.aspx?id=31412",""],[185,"أما والذى حجت له العيس وارتمى","https://www.aldiwan.net/poem58763.html","الطويل"],[240,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[240,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[287,"لعمر ضياء الدين إني لمظهر","https://www.aldiwan.net/poem32746.html","الطويل"],[287,"أما والذي يحيي الورى ويميت","https://www.aldiwan.net/poem32845.html","الطويل"],[309,"أموت بدائي والدوا في يديكم","https://www.aldiwan.net/poem16754.html","الطويل"],[358,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[463,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[463,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122748","البسيط"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102038","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62646","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137846",""],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11963","الوافر"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33862","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202576","الطويل"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124007","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62778","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48443","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91789","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202334","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86510","الطويل"],[4017,"","https://poetry.dctabudhabi.ae/diwan/poem/97622","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94401","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133153","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4778,"إن غدا لناظره قريب","https://www.poetsgate.com/ViewPoem.aspx?id=188201",""],[5055,"ثارت الفتنة","https://www.poetsgate.com/ViewPoem.aspx?id=101192",""]],"verses":[["لَئِن دامَ هَذا وَهَذا بِهِ","سَيَهلِكُ وَجداً وَلا يَشعُرُ",0,"ر",1,0],["لَئِن دامَ هَذا لِوالي الخَر","اجِ قَليلاً دَعَوناهُ والي الخَرابِ",1,"ب",1,0],["لي نَديمانِ كَوكَبٌ وَظَلامٌ","لا يَخونانِ صُحبَتي وَوِدادي",2,"د",2,0],["لَئِن دَعاها إِلى الطُغيانِ آمِرُها","لَقَد نَهاها عَنِ الطاغوتِ ناهيها",3,"ي",3,0],["لئن دام هذا الولي الخر","اج قليلاً دعواناه والى الخبراب",4,"ب",1,0],["لَئِن دائراتُ الدَّهرِ يَوماً أَدَرنَ لِى","عَلَى أُمِّ عَمرٍو نَوبةً لا أُقِيلُهَا",5,"ه",2,0],["لَئِن دَفَعوهُ ظُلماً عَن حُقوقِ ال","خِلافَةِ بِالوَشيجِ السَمهَرِيِّ",6,"ي",1,0],["لَئِن دَرَسَت رُبوعُكِ فَال","هَوى العُذرِيُّ ما دَرَسا",7,"س",2,0],["لَئِن دامَ هَذا مِنكَ إِنّي لَظاعِنٌ","وَكَم مِثلُها فارَقتُها وَهيَ تَصفِرُ",8,"ر",1,0],["لَئِن دامَ هَذا بي فَإِنّي لَمَيِّتٌ","وَما لي سِوى هَجرِ الحَبيبِ مُميتُ",9,"ت",1,0],["لئن دام هذا الهجر منكم وفي الحشا","من الوجد ما فيها وردت ثرائي",10,"ا",3,0],["لَئن دَنَت المَنازل بَعدَ بُعدٍ","فَإِنّا بِالصُدود لَقَد رَضينا",11,"ن",2,0],["لَئِنْ دَهَتْنِي شَمالاً حَرْجَفاً عَصَفَتْ","بماءِ وَجْهِي لقد أَنشأْتَها سُحُبا",12,"ب",2,0],["لئن دبَّ دهرٌ إلى مجدكم","بنقصٍ يُخافُ على الفاضلينا",13,"ن",2,0],["لئن دَرِدَتْ فلا يَغررْك منها","أراقمُ يزدرِدنَ وهنَّ دُرْدُ",14,"د",1,0],["لئن دَرَسَتْ منها الخُطوطُ فإنه","لَيبْقَى طويلاً عَرفُها في المَساحبِ",15,"ب",1,0],["لَيندَمَنَّ عَلَى التَّفريطِ مِن قِبَلي","أهلُ الرِئاسَةِ إذ لا يَنفَعُ النَّدَمُ",16,"م",1,0],["لئن درجوا عنا وقمنا بربعهم","على طلل رهن الحوادث دارس",17,"س",1,0],["لئِن دامَ هذا الحال فينا شَنَنْتُ مِن","كتائب شعري في الدُّنى كل غارةِ",18,"ه",1,0],["لئن دثرت كتب الاولى قد تقدموا","من العرب هذا صدره جمع الكتبا",19,"ب",2,0],["لَئِن دامَ المَدى هَجراً وَبَيناً","فَلا شامٌ لَدَيَّ وَلا عِراقُ",20,"ق",1,0],["لِئِن دَقَّ وَاِستَرخى لَقَد كانَ مَرَّةً","لَهُ مَقبَضٌ في كَفِّ لا مِسِهِ يَجفو",21,"ف",2,0],["لئن دام هذا العصر للحسِّ قاتلا","فشعري لن يتلوه إلا شياطيني",22,"ن",2,0],["ليندبه من أعباه حلّ عويصة","وملتمس الذكر المنزّل والذكرى",23,"ر",2,0],["لِيَنْدَمَ من باعَ المذلّةَ عِرضَهُ","فَما العيشُ عندي بالمذلّةِ طَيِّبُ",24,"ب",1,0],["لَئِنْ درَجَ الأعْلَوْنَ أبناءُ قَيْلةٍ","بحيثُ رياضُ المَكرُماتِ أثائِثُ",25,"ث",1,0],["لَئن دامتِ الآثارُ تَندُبُ فَقدَهُ","فلا غرو أن دامت عليهِ المنايِحُ",26,"ح",1,0],["لَئن دام حال الناس في الناس ما أَرى","وَحُكِّمَ وَغْدُ القومِ في وقعة الحرث",27,"ث",1,0],["ليندمن كل من لاحت له فرص","على الأعادي فأرجاها ولم يثب",28,"ب",1,0],["لئن دهم الرزء الذي جل جله","فأنت فتاه والعذيق المرجب",29,"ب",1,0],["لئِن دامَ هذا وهذا له","سيهلكُ وَجداً ولا يشعرُ",30,"ر",1,1],["لئن دهمت في الدهر سوء خطوبه","ففي صالح تجلى وبيض أياديه",31,"ي",2,0],["لئن دام تنميقاً فأفضل نابقٍ","يُحلي بتنضيدٍ صدور الصحائفِ",32,"ف",1,0],["لئن دام هذا والحياة مديدةٌ","وشئت الدوا فالعزلة الغاية القصوى",33,"و",2,0],["لئن دلست كفرانا بشكر","فما دنست أيمانا بشرك",34,"ك",1,0],["لئن دقت فهام الشرك دقت","وفريته فرت جهد المجيح",35,"ح",1,0],["لئن دققت في تاريخ قومي","تجد ما لذَّ من نفحٍ وطيبِ",36,"ب",1,1],["لين (داحس) صافح (الغبراء) هدب","نارت اقلوب وتغشّاها حرير",37,"ر",1,0]]}