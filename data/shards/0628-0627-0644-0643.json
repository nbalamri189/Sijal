9957","الكامل"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/145861","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81248","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72964","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104902","الكامل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4764,"المسأله","https://www.poetsgate.com/ViewPoem.aspx?id=34653",""],[4578,"نشرت على رمح القوام عصائبا","https://www.poetsgate.com/ViewPoem.aspx?id=49349",""],[4899,"الغني الله","https://www.poetsgate.com/ViewPoem.aspx?id=179784",""],[5206,"في علم الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187418",""],[5318,"دعاءٌ للدوحة، واللهُ خيرٌ حافظاً","https://www.poetsgate.com/ViewPoem.aspx?id=211229",""],[5431,"ولربّ جهلٍ قد قتلْ!","https://www.poetsgate.com/ViewPoem.aspx?id=214015",""],[402,"يا من حمدت به اختياري","https://www.poetsgate.com/ViewPoem.aspx?id=35064",""],[6115,"الكرم في ذا الزمان اصبح مظاهر","https://www.poetsgate.com/ViewPoem.aspx?id=181602",""],[6115,"الرخوم اللى تهايط على الفاضي بلاش","https://www.poetsgate.com/ViewPoem.aspx?id=196462",""],[6142,"الفضل ما بين النبي وصنوه","https://www.poetsgate.com/ViewPoem.aspx?id=155733",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِالكاسِ أَو بِالطاسِ أَو بِاِثنَيهِما","أَو بِالدِنانِ فَإِنَّ فيهِ شِفائي",0,"ا",2,0],["بالكرم عقدت بندك","وبريح الجود يشرشق",1,"ق",1,0],["بِالكُرهِ مِنّي وَاِختِيارِك","أَن لا أَكونَ حَليفَ دارِك",2,"ك",1,1],["بِالكاهِنينَ الَّذينَ جَدُّهُمُ","عَبدُ العَصا وَاللِئامُ إِن أَسِفوا",3,"ف",3,0],["بِالكَرى عَنّي وَبي عَنهُ جَفاء","أَنا وَحدي أَم كَذا كُلُّ الأَنام",4,"م",1,0],["بالكلماتِ العشرِ لا","تقلْ لروحي كلمَهْ",5,"ه",1,0],["بِالْكَاتِبِ الحر الْجَرِي","ءِ وَبِالمُحَامِي لاَ المُحَابِي",6,"ب",2,0],["بالكأسِ يَقْرَعُها نديمٌ مالثاً","بالوعدِ منها الحافَتَيْنَ وقاطبا",7,"ب",2,0],["بآلك أقمار الشهود أولى العلا","وأصحاب بدر من أبادوا الأعاديا",8,"ي",2,0],["بالكأس طُف يا كامل الحسن قد","كويت بالهجر حشا عبدكا",9,"ك",2,1],["بِالكامِلِ الأَوحَدِ اِستَخذى الزَمانُ لَنا","وَصارَ يُنعَتُ بِالهَيّابَةِ الوَكِلِ",10,"ل",1,0],["بالكره لا باختياري بات مفترقا","شملي وبت لمس الضر محتملا",11,"ل",2,0],["بِالكِلَّةِ الحَمراءِ مِنها جُؤذَرٌ","وَسنانُ مَصقُولُ التَرائِبِ أَغيَدُ",12,"د",1,0],["بالكاذبين المفترين بأنهم","قد طبقوا (التوراة) و(الإنجيلا)",13,"ل",2,0],["بِالكامِلِ بنِ العادِلِ المَنصورِ قَد","نادى النَدى لما دَعاهُ مُؤَبِّها",14,"ه",2,0],["بِالكامِلِ انتَظَمَت أُمورُ الدينِ وَالد","دُنيا بِأَحسَنِ مَنظَرٍ وَبِمَخبَرِ",15,"ر",1,0],["بآلكَ بالأصحابِ لا سيّما الألى","ببدرٍ غَدَت للدّينِ شُهبانُهم حصنا",16,"ن",2,0],["بالكُتْبِ طُرّاً كتابٌ خَطَّهُ مَلِكٌ","بأَنمُلٍ خُلِقتْ للجُودِ والباسِ",17,"س",1,1],["بالكبريا قد صار شيطاناً له","من ذاته إبليس من آلاتها",18,"ت",3,0],["بالكره منك وبالمَساءة رَوَّحت","لسوى العُقور على البيوتِ عِشارُ",19,"ر",1,0],["بالكُرهِ فارق سيف عمرٍو كفّه","وتقلَّصت عن رمحه يدُ عامرِ",20,"ر",1,0],["بالكنز وبالرمز الذي استجلاه","منوال طراز العالم العلوي",21,"ي",1,0],["بالكرلام القديم كل ما قد","صين أو جاء واضح الأنباء",22,"ا",2,0],["بالكامل افتخرت على أمرائها","وبشاور تاهت على وزرائها",23,"ا",3,0],["بالكامل بن أبي الفتح الوزير لنا","عن النسيب لبانات وأشغال",24,"ل",1,0],["بِالكِتابة يَدري","فَلم يُدرك حَقيقة وَصل حبلي",25,"ل",2,0],["بالكبرياء شهيرتا","ن غليظتان عنيدتانِ",26,"ن",1,0],["بالكواذن والصافنات وباليع","ملات خيار النياق ذَلُل",27,"ل",1,0],["بالكاس والطاس ولا يرعوي","مع البغايا ومع المرد",28,"د",1,0],["بالكتاب العزيز بالصحف بالتوراة","بالإنجيل الرضا بالزبور",29,"ر",1,0],["بِالكِمْعِ لَمْ تَمْلِكْ لِعَيْنٍ غَرْبَا","يُحْسَبْنَ شاماً بالِيا أَوْ كُتْبَا",30,"ب",2,0],["بالكيد أو بالضغط أو بالش","تم أو بالمقرعه",31,"ع",2,0],["بالكسر والإشمام أو بالضمّ في","فعل كباع أو كاختير يفي",32,"ي",1,0],["بالكل من قبل الوجود والعدم","سبحانه كشاف أستار الظلم",33,"م",1,0],["بالكأس داني مَمزوج هاني","كالأرجوان لا من دنان",34,"ن",1,0],["بالكوثر الموعود هذا المشرب ال","منقود من هذا الغزال الرومي",35,"م",2,0],["بالكوكبِ الدريّ في جنْحِ الدُّجى","والصارمِ الهنديِّ في عَينِ الكمي",36,"م",2,0],["بالكوثر الفياض خص تفضلا","فملا حياض أولى العلا وتفضلا",37,"ل",2,0],["بالكرم معروف","والِهِ العطوف",38,"ف",1,0],["بالكتب لن أنهي جوابا لما","قد كنت في سطرين أديته",39,"ت",2,0],["بالكرخ من جانب الغربي عن لنا","ظبي ينفره عن وصلنا نفر",40,"ر",1,1],["بالكاظم بن الصادق ب","الباقر بن الساجد",41,"د",1,0],["بالكرى جفوةٌ وفيكَ تَجَافٍ","فمتى تَنقَعُ القلوبُ الصَّوادي",42,"د",2,0],["بِالكَرخ مِن فَلَك الآزار مَطلَعُهُ","يا لَيتَ ما كانَ يَومٌ راحَ يُفجِعُني",43,"ي",1,0],["بِالكافِ حَرفاً دُونَ لاَمٍ أو مَعَه","وَالَّلامُ إن قَدَّمتَ هَا مُمتَنِعَه",44,"ه",1,0],["بالكره مني ثم لا بالعمد","فقال لي والقول ذو مرد:",45,"د",1,0],["بِالكَهرُباءِ وَبِالبُخارِ سَما لَهُ","مَجدٌ وَفي هذَينِ سَوفَ يبيدُ",46,"د",1,0],["بالكرخ من فلك الأزرارِ مطلعُهُ","كان الوصالُ شهيّاً ليس يقنعُني",47,"ي",1,0],["بالكافي والمكتفي فاكفنا الأمورْ","وعافنا من الشرور والثبورْ",48,"ر",1,0],["بِالكَورِ يَومَ ثَوى الحُصَينُ وَقَد رَأى","عَبدُ المَدانِ خُيولَها تَعدو",49,"د",2,0],["بالكسر والضم وفي الماضي أَسَن","بالفتح أي خاس ومثله أَجَن",50,"ن",1,0],["بالكسر والحَمَل فحمَل البطن","والنخل واكسر لغة لبطن",51,"ن",1,0],["بالكر مثل كرة القوم الأولى","بلوت في طي زمانٍ قد خلا",52,"ل",2,0],["بِالكدِّ اوفي مِن الوفٍ درهماً","لِمَن اِرتَضاني في حماهُ خادِما",53,"م",2,0],["بالكف أشرب تكفي كف محتسب","بالكف لا الكأس من آماله شربا",54,"ب",2,0],["بِالكَون جِفناكَ وَما أَفلَتا","مِن حَرق سَمح بِها الناظر",55,"ر",1,0],["بالكرَّ والفرَّ هاماتُ العداةِ لها","وقع الدخيلِ على أقداحِ أقدامي",56,"م",2,1],["بالكسر حركتا وحاجبه","قلم الملاحة خطه زبرا",57,"ر",2,0],["بالك مصروف إلى التورع","مالك موقوف على التبرع",58,"ع",1,0],["بالكآبه كان حظه ،، يمتليه الإكتئاب","لو تكذبني تفضل يا حبيبي إسأله",59,"ل",2,0],["بالكسر جرت نحوها قلباً لقد","جزم السلوّ وضم وجدا ناصبا",60,"ب",2,0],["بالكلا والنار والماء خشرا","كل خلق الله ما منهم حريم",61,"م",1,0],["بِالكَشْفِ يُدرِكُهَا الفَتَى","والعَارِفُونَ مِنَ الطَّمَش",62,"ش",1,0],["بالكافِ والنونِ المشيئةُ، يا حبيبةُ فافرحين","سيّري على نهجِ الأُلى، لا تعبأي بالظالمين",63,"ن",1,0],["بالكبر قد جفّت مياه رزونِه","وتصخّرت مُهج الرؤى حدّ المللْ!",64,"ل",1,0],["بالكاتب الحر الجري","وبالمحامي لا المحابي",65,"ب",2,0],["بالكبر والفشخره دايم يجاهر","وقال انا حاتم وعمّر في وجاره",66,"ر",2,0],["بالكبروالفشخره روسهم فوق النجوم","وفالحقيقه مايساوون حبةفيش فاش",67,"ش",1,0],["بالكرد بين محمد وعليه","فصلوا عرى التوحيد والإيمان",68,"ن",1,0],["بالكلم الطيب لي معول","بكل ما ترضاه مني أمثل",69,"ل",1,0]]}