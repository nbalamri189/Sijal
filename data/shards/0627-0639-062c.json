ف"],[459,"ما أم أولاد كثير في العدد","https://www.aldiwan.net/poem56210.html","الرجز"],[459,"أُعجِبت بي بين نادي قومِها","https://www.aldiwan.net/poem56289.html","الرمل"],[462,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[465,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[465,"أعجبت من خد صفا وتلهبا","https://www.aldiwan.net/poem3445.html","عموديه"],[465,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[465,"أسفي على لدن القوام رشيقه","https://www.aldiwan.net/poem3598.html","عموديه"],[471,"أعجبت أن ركب ابن حزم بغلة","https://www.aldiwan.net/poem4630.html","الكامل"],[501,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[506,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[515,"أعجم هواك واجفاني عنه يفصحن","https://www.aldiwan.net/poem20921.html","المواليا"],[516,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[543,"ما يريد الناس من صبب","https://www.aldiwan.net/poem34050.html","مجزوء الرمل"],[552,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[552,"يا جالبا للأرق","https://www.aldiwan.net/poem47350.html","مجزوء الرجز"],[563,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[563,"دع ذكر بانات العلم","https://www.aldiwan.net/poem52959.html","مجزوء الكامل"]],"verses":[["أَعجَلوا المُلجِماتِ أَو","رَكِبوها عَوارِيا",0,"ي",2,0],["أَعجِب لِمُسكَةِ نَفسٍ بَعدَما رُمِيَت","مِنَ النَوائِبِ بِالأَبكارِ وَالعونِ",1,"ن",1,0],["أَعجَلتَ قَلبي أَن يَمَس","سَ الهَجرَ فَاِستَلَبَ الوِدادا",2,"د",2,0],["أَعجَلتَها المَنونُ عَنّا وَلكِن","خَلَّفَت في دِيارِنا أَفراخا",3,"خ",2,0],["أَعجِب وَأَخلِق أَن تَرى عِجابا","يُبَلِّدُ الأَفهامَ وَالأَلبابا",4,"ب",2,0],["أَعْجَلْتَ حِزْبَ الْبَغْيِ فاشْتَبَهَتْ بِهِمْ","طُرُقُ النَّجَاةِ وَلِلْهَلاَكِ تَعَجَّلُوا",5,"ل",3,0],["أعْجَمَتْ منْهُ أربُعٌ وطُلولٌ","صالَ قِدْماً بِها اللِّسانُ الفَصيحُ",6,"ح",1,0],["أَعجَزَتهُ مِن قُدرَةِ اللَهِ أَسبا","بٌ طَواها مُسَبِّبُ الأَسبابِ",7,"ب",1,0],["أَعجَزَها النُطقُ فَجاءَت بِنا","نَنوبُ عَن أَلسُنِها الخُرسِ",8,"س",1,0],["أَعجَزتَ أَطواقَ الأَنامِ بِمَدحِهِ","سَجَدَ البَيانُ لِرَبِّها وَالمَنطِقُ",9,"ق",1,0],["أَعجَمِيٌّ كادَ يَعلو نَجمُهُ","في سَماءِ الشِعرِ نَجمَ العَرَبي",10,"ب",2,1],["أَعجَزَتني ثَلاثَةٌ وَهيَ خَمسٌ","مُشكِلاتٌ ما لَم تُنَط بِثَماني",11,"ن",2,0],["أَعجَزَتني البُروقُ شَيماً فَلَوعا","لجتُ بَحراً لأُنبِطَ الماءَ أَكدى",12,"د",2,0],["إِعجَب لِحالِ السَروِ كَيفَ تُحالُ","وَلِدَولَةِ العَلياءِ كَيفَ تُدالُ",13,"ل",1,1],["أعجب بشعبٍ في الخفاء عبأته","لم يألف التنظيم والتنجيدا",14,"د",2,0],["أعجزتني عن شكر ما أوليتني","أتزيدني بقبول عذري جودا",14,"د",2,0],["أَعْجَبَنِي مِنْ نَقْدِهَا قَوْلُهَا","فِي غَادَةٍ بَادِنَةٍ جَاهِلَهْ",15,"ل",2,0],["أَعْجِبْ بِرَسْمِكَ صِيغَ مِنْ شَبَهٍ عَلَى","وَجْهٍ مِنَ الشَّبهِ الأَتَمِّ مُجَسَّمِ",16,"م",1,0],["أَعْجَبْ بها أَوْحَى إِلَيْكَ النُّعْمَى","فَكَانَ فِي الأَرْضِ كَمَا فِي السَّمَا",17,"م",2,0],["أَعجَبَتها ذَاكَ فَأَبدَت لَهُ","سُنَّتَها البَيضَاءَ والمِعصَمَا",18,"م",2,0],["أعجز الورق أن تعارَ دُموعي","فاستعارت على الغصون انتحابي",19,"ب",2,0],["أعجب لها ناعورة قلبها","للماءِ منشى العيش والعشب",20,"ب",1,1],["أعجل الكافرين بالفتك عن أن","يلدوا فيه فاجراً كفَّارا",21,"ر",2,0],["أعجبني والله مع نظمه","رضوانك المعهود يا مالك",22,"ك",1,0],["أعجبَ الناسَ ما وَعَيْتَ وقالوا","عسلٌ طيبٌ خبيثُ الوِعاء",23,"ا",2,0],["أعجبَ ذاك السماء فانبعثتْ","تَنثُر دُرَّاً على مُحيَّاها",24,"ا",3,0],["أعجز الطالبيكَ شأوٌ بعيدٌ","لكَ أدركْتَهُ بعُرفٍ قريبِ",25,"ب",1,0],["أعجِبْ بتلك البِكْرِ محجوبةً","مكروبةً يُجْلَى بها الكاربُ",26,"ب",1,0],["أَعْجِبْ بآمِنِ دهرٍ وهو مُبترِكٌ","يُعريه من ورقٍ طوراً ومن نَجَبِ",27,"ب",1,0],["أعجِبْ بأنكَ تَجْتَلِي بِشُعَيْلَةٍ","وجْهَ الصباح وقد بَدَا لكَ أجْلَحَا",28,"ح",2,0],["أعجِبْ بمن يقتل الرجال وإن","لاحَ له شخص شيبةٍ ذَعره",29,"ر",2,0],["أعجِبْ بناسل عمروٍ وهْو في جدثٍ","وفي الحوادث آيات ومعتبَر",30,"ر",1,0],["أعجبْ به فيك من شكوٍ ولا عَجَبٌ","من ريب دهرٍ ولا من صرف مقدار",31,"ر",1,0],["أعجِبْ بأن رَوَيتُمُ غُلتي","ومن سوى منهلِكم أحْتسي",32,"س",2,0],["أعجب بوجد مزور قاد زائرَه","بل لم تزل ذِكَرٌ يجلبن أطيافا",33,"ف",2,0],["أعجب بمثلي سائلاً مثله","مهر استه ذات الأفاويق",34,"ق",1,0],["أعجِبْ بتزويرك الخضابَ على","من تتولاه في الخلاء لكا",35,"ك",2,0],["أعجزنا كرّنا الشبابَ وأن","تُثمرَ صِدقاً مواعدُ الأملِ",36,"ل",1,0],["أعجله الوقتُ عن رياضتها","فأقبلتْ ريّضاً على عجلِ",37,"ل",1,0],["أعجِبْ بأمرك أن أُجِرتَ وإنما","إسداؤكَ النَعمى لديك نعيمُ",38,"م",1,0],["أعجِبْ بها شُعلاً على فَحَمٍ","لم تَشْتَعِلْ في ذلك الفحَمِ",39,"م",1,0],["أعجِبْ به يُهدي إلى رجم","حيَّاً ويبعثُ صاحبَ الرَّجَمِ",39,"م",1,0],["أعجِبْ بِبرٍّ تعلمتُ العقوقَ به","فما أحِنُّ إلى إلفٍ ولا سكنِ",40,"ن",1,0],["أعْجِبْ به مِنْ عَدوٍّ ذي مُنابذةٍ","مُصغىً إليه طوالَ الدهْرِ مزكون",41,"ن",1,0],["أعجميٌّ آيينُه عربيٌ","مجدُه ينتمي إلى عدنان",42,"ن",1,0],["أعجِبْ بحاجة ملهوفٍ تُؤَخّرها","عنايةً مع إمكانٍ قد اعتونا",43,"ن",2,0],["إعجامُها الجبنُ والزيتونُ","وشكلُها النَّعنعُ والطَّرْخونُ",44,"ن",1,0],["أُعجوبَتانِ زَبَرجَدٌ مُتَهَدِّلٌ","نامٍ تَدَفَّقَ تَحتَهُ البَلّورُ",45,"ر",1,0],["أَعجَبُ ما في بَني التُرابِ","قِتالَهُم فَوقَهُ عَلَيهِ",46,"ه",1,0],["أَعجَبتَها شَرَفاً فَطالَ وُقوفُها","لِتَأَمُّلِ الأَعضاءِ لا لِأَذاتِها",47,"ت",3,0],["أَعجَلتَ أَلسُنَهُم بِضَربِ رِقابِهِم","عَن قَولِهِم لا فارِسٌ إِلّا ذا",48,"ذ",2,0],["أَعجِب بِأَخذِكَهُ وَأَعجَبُ مِنكُما","أَن لا تَكونَ لِمِثلِهِ أَخّاذا",48,"ذ",2,0],["أَعجَسلَتها النَوى فَما نِلتُ مِنها","طائِلاً غَيرَ نَظرَةٍ مِن بَعيدِ",49,"د",1,0],["أَعجِب لِظُلمِ زَمانِنا المُتَواتِرِ","وَلِأَوَّلٍ مِمّا يُريكَ وَآخِرِ",50,"ر",1,1],["أَعجَمِيٌّ إِلّا عَجالَةَ لَفظٍ","عَرَبِيٍّ تَفَتَّحُ النُوّارِ",51,"ر",1,0],["إِعجَب مِنَ الغَيمِ كَيفَ اِرفَضَّ فَاِنقَشَعا","وَصالِحِ العَيشِ كَيفَ اِعتيقَ فَاِرتُجِعا",52,"ع",2,1],["أَعجَلتُموها عَن تَئِيَّةِ رَأيِها","عَجَلَ الكِرامِ إِلى قِرى الأَضيافِ",53,"ف",1,0],["أَعجَلَ بَعضاً بِضَربٍ مِن تَقَدُّمِهِ","وَاِقتادَ بَعضاً بِضَربٍ مِن تَأَتّيهِ",54,"ي",2,0],["أَعْجِبْ بهِ حينَ يَدعوهُ لمَلْحَمَةٍ","أَصَمُّ ليسَ به من دَعْوَةٍ صَمَمُ",55,"م",1,0],["أَعجِبْ بِها حرباً تُثيِرُ إذا التظَت","فَضلَ الرِّجال ولا تُثِيرُ قساطِلا",56,"ل",2,0],["أَعَجِبتِ مِمّا قَد رَأَيتِ وَفي الحَشا","أَضعافُ ما عايَنتِ في الأَعضاءِ",57,"ا",2,0],["أَعجَبُ ما شوهِدَ في عَصرِنا","عَوسَجَةٌ تَحمِلُ يَقطينَه",58,"ه",1,0],["اَعجَب لِنَرجِسِنا المُضَعَّفِ أَن نَمَت","أَوراقُهُ وَتَفَتَّحَت أَزهارُه",59,"ه",1,1],["أعجب ما في الشكر أني امرؤ","بيانه عندك يعصاه",60,"ا",2,0],["أُعجِلنَ عَن شَدِّ الإِزارِ وَرُبَّما","عُوِّدنَ أَن يَمشِينَ غَيرَ عِجالِ",61,"ل",1,0],["اعجبْ لهوايَ فيهِ غُصناً","والقدُّ بمعنيينِ سائلْ",62,"ل",1,1],["اعجبْ لنونِ حاجبيهِ تنصرُ","والنونُ في كلِّ مثنى تكسرُ",63,"ر",1,0],["أعجَزُ عنْ وصفي ضميري لكُم","إذْ لمْ يُجَزْ أَنَّ توصفَ الضمائرُ",64,"ر",1,0],["أَعْجَبَتْني غَضبْةٌ من شيخِكم","هِيَ من دَأْبِ الشُّيوخِ الأوّلِينْ",65,"ن",1,0],["أَعجزنا أن نَجوبَ المَشرِقَيْنْ","أم عَيينا أن نَفوت النَّيِّرَيْنْ",66,"ن",1,1],["أُعجوبةٌ ما لها في الدّهرِ من مَثَلٍ","لكنَّ ربَّكَ ذُو فضلٍ وإحسانِ",67,"ن",1,0],["أَعَجِبْتِ إذ ذَكَرَ الفواحِشَ هادياً","فَنَهَى اللّواتِي جِئْنَهُ وَنَهاكِ",68,"ك",1,0],["أَعجَلَ مِن مِسواكِهِ وَزينَتِه","وَهَيأَةٍ تَنظُرُ حُسنَ صورَتِه",69,"ه",1,0],["أَعجزَ الإِنسَ آية منه والجن","نَ فَهَلَّا يأتي بها البُلَغاءُ",70,"ا",2,0],["أعجزَ الدُّرَّ نَظمُهُ فاستوتْ في","هِ اليَدَانِ الصَّناعُ والخَرْقَاءُ",70,"ا",2,0],["أَعَجبتَ أنْ غَدَتِ الغمامةُ آيَةً","لِمُحَمَّدٍ يَغْدُو بها وَيَرُوحُ",71,"ح",1,0],["أَعَجِبْتَ مِنْ مَلكٍ رَأَيْتَ مُقَيَّداً","وَشرِيفِ قَوْمٍ عِنْدَهمْ مَغْلولا",72,"ل",2,0],["أعْجَلتَ في يوْمي رَجائي في غَدٍ","فكأنّني في جنّةِ الرِّضْوانِ",73,"ن",1,0],["أَعجَبُ الدَهرِ ما تَضَمَّنتُ مِنها","فَنَمى في الحَشا وَكانَ صَغيرا",74,"ر",2,0],["أُعجَب بِدَهرِكَ أولاهُ وَآخِرِهِ","إِنَّ الزَمانَ قَديمٌ سِنُّهُ حَدَثُ",75,"ث",1,0],["أَعجِل بِتَسبيحِ رَبٍّ لا كِفاءَ لَهُ","أَو رَتِّلَنهُ وَلا تَجنَح إِلى رَتِلِ",76,"ل",1,1],["أَعَجِبتَ لِلطِفلِ الوَليدِ بِمَهدِهِ","لَم يَخطُ كَيفَ سَرى بِغَيرِ رَواحِلِ",77,"ل",1,0],["أَعجَبَ العَضبُ لِم