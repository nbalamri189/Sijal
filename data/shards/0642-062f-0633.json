ما طَفِقَتْ","تَجري إليهِ على آثارِها الأُمَمُ",4,"م",1,0],["قد سعى والطرق نار ودم","يعبر السهل ويجتاز الأكاما",5,"م",2,0],["قَد سَقاهُ الزَمانُ كَأسَ حِمامٍ","وَكَذاكَ الزَمانُ يَسقي الحِماما",6,"م",2,0],["قَد سَحَّبَ الناسُ أَذيالَ الظُنونِ بِنا","وَفَرَّقَ الناسُ فينا قَولَهم فِرَقا",7,"ق",2,1],["قد ستَرَ الدّهْرُ منْكَ عوْرَتَهُ","وكانَ لليوْمِ غيْرَ مُسْتَتِرِ",8,"ر",1,0],["قدْ ساعَدَ السّعْدُ رَبْعاً أنْتَ تعْمُرُهُ","وأُنْجِزَتْ فيهِ للفَتْحِ المَواعيدُ",9,"د",1,0],["قَد سالَ واديكِ خِصباً مُمتِعاً فَمَتى","تَسيلُ أَرجاؤُهُ عِلماً وِعِرفانا",10,"ن",2,0],["قَد سَنَّ فينا مُزاحاً","عَلى الحَقيقَةِ يَجني",11,"ي",1,0],["قَد سَمِعنا خَليلَكُم فَسَمِعنا","شاعِراً أَقعَدَ النُهى وَأَقاما",12,"م",2,0],["قَد سالَمَتهُ اللَيالي حينَ أَعجَزَها","عَقدٌ لِما حَلَّ أَو تَقويمُ ما أَطَرا",13,"ر",2,0],["قَدْ سَلا عَهْدَهُ وَنَحْنُ عَلَى","عَهْدِنَا لا يُطِيقُ سُلْوَانَا",14,"ن",2,0],["قَدْ سَاءَ مَنْعَاكَ الَّذِينَ بَقُوا وَإِنْ","سَرَّ الأُولَى سَبَقُوا مِنَ الأَقْرَانِ",15,"ن",1,0],["قُدْسُ القَضَاءِ رَجَعْتَ فِيهِ إِلَى","ذِكْرِ العَلِيمِ وَخِبْرَةِ الفَهِمِ",16,"م",1,0],["قَدْ سَرَّتْ الضَّيف العَظِيمَ وَدُونَهَا","فِي كُنْهِ مَا يَرْمِي إِلَيْهِ مَرَامِ",17,"م",1,0],["قَدْ سَقَاكَ المُحِبُّ كَأْساً وَمَا إِنْ","خَالَ فِيهَا سِوَى الدَّوَاءِ المُلائِمْ",18,"م",1,0],["قَدْ سِرتُمُ في سَبِيلِ الخَيْرِ سِيرتَكُمْ","مُحقِّقِينَ رَجَاءً خِيلَ مَوْهَومَا",19,"م",2,0],["قد سددوا الأنضاء ثم تتابعوا","يتلو رعيلٌ في الفلاة رعيلا",20,"ل",2,0],["قدست واديها وزرت خلالَها","فلها الفخار بها على الآصالِ",21,"ل",1,0],["قد سمعنا غناءها فعرفنا","كيف فعل الغناء في الإنسان",22,"ن",1,0],["قد ساء مُنقلَب البلاد بأهلها","فانحطّ أوْج واشمخر حضيض",23,"ض",1,0],["قد ساد من قبل الصبى سابقاً","قولهم السؤدد قبل السواد",24,"د",1,0],["قد ساقك الله إلى جلّق","لما درى حاجتها للغمام",25,"م",1,0],["قد سرّت الأمة والدين إذ","قالوا أتى السلطان نجلٌ كريم",26,"م",1,1],["قد سبتْ عَقْلَه الشَّمُولُ فما في","ه سوى أن يقولَ قومٌ شَروبُ",27,"ب",1,0],["قد سَيَّرُوهُ بِضَرْطَةٍ","في الخافِقَيْن وما بَرِحْ",28,"ح",1,0],["قد سُهِّل الوعْرُ وهو حَزْنٌ","فيك وقد هُوِّن الشديدُ",29,"د",1,0],["قد سألتُ الأنام عنك فقالوا","بالكلام الفصيح لا المرموز",30,"ز",1,0],["قد سار باسمك مدح لم أوفِّكَهُ","وقد يبلغك الغايات محذوف",31,"ف",1,0],["قد سنَّ من شفرتيه البأسُ بغيته","وشاف من صحفتيه الجود ما شافا",32,"ف",2,0],["قد سحَّب الناس أذيال الظنون بنا","وفرّق القوم فينا ظنهم فرقا",33,"ق",2,0],["قد سلَّموك إلى الضَّري","حِ ووسَّدُوا بالتّرْبِ خَدَّك",34,"ك",1,0],["قد سَبتْنا وإنما كان قومٌ","يومَ لا يَسبتون لا يأتيهِمْ",35,"م",1,0],["قد سقتني من عينها كأس وجدٍ","فعلتْ فيَّ فعلَ كأسِ المُدام",36,"م",1,0],["قد سألتُ الناس ما أسألكم","فأبت مسؤولَهم تلك الهَنَه",37,"ن",2,0],["قد سلونا إن كنت أعرضتَ عمداً","واعتقدنا الإعراضَ إن كانَ هفوه",38,"و",2,0],["قد سمِعنا بحاتم وبكعبٍ","فهما يعدُوان بينَ يديهِ",39,"ي",2,0],["قد ساءني أن بُزَّ تِرْبي قناعَهُ","وأضْحى قناعي حالكَ اللّون داجيا",40,"ي",2,1],["قَد سَأَلتُ البَحرَ يَوماً هَل أَنا يا بَحرُ مِنكا","هَل صَحيحٌ ما رَواهُ بَعضُهبُم عَنّي وَعَنكا",41,"ك",2,0],["قَد سَأَلتُ السُحبَ في الآفاقِ هَل تَذكُرُ رَملَك","وَسَأَلتُ الشَجَرَ المورِقَ هَل يَعرِفُ فَضلَك",41,"ك",1,0],["قَد سَقَتنا الحَياةُ كاساً دُهاقاً","حَسُنَت نَكهَةً وَطابَت مَذاقا",42,"ق",2,0],["قَد سَرَّني فيكَ يا مَن خابَ مَسعاهُ","سَخيفُ رَأيِكَ هَذا كانَ عُقباهُ",43,"ه",1,1],["قَد سَكَنتَ القَلبَ حَتّى","صارَ مَأواكَ وَدارَك",44,"ك",1,0],["قَد سَرَّني هَذا الَّذي","بي مِن ضَنىً إِن كانَ سَرَّك",45,"ك",1,0],["قَدَّْسَ اللهُ ذِكْرَهُ مِنْ صَبَاحٍ","ساحرٍ في ظِلالِ غابٍ جميلِ",46,"ل",1,1],["قَدْ سَكِرْنا بحُبِّنا واكتفينا","يا مُدِيرَ الكؤُوس فاصرفْ كؤُوسكْ",47,"ك",1,1],["قَدْ سكرنا بحبِّنا واكتفينا","طَفَحَ الكَأْسُ فاذهبوا يا سُقاةُ",47,"ه",1,0],["قد سار قبلك حافظ فتبعته","وبقيت وحدي اليوم للنكبات",48,"ت",1,0],["قد سرت بين نواظر ودموع","تجتاز ينبوعا إلى ينبوع",49,"ع",1,1],["قد سقتني الخمر مِن","فيها فاغراني الشراب",50,"ب",1,0],["قد سافر الجهل إلّا عن منازلنا","وأثمر العلم إلا في نواحينا",51,"ن",2,0],["قد سب إسماعيل عند ابنه","وسب رب القطر في جدّه",52,"د",2,0],["قد سقطت في زير","أو وقعت في البير",53,"ر",1,0],["قد ساعفتك رياح اللطف لو نظرت","إلى السفينة بين الماء والنار",54,"ر",1,0],["قَد سَمِعَ الثَعلَبُ أَهلَ القُرى","يَدعونَ مُحتالاً بِيا ثَعلَبُ",55,"ب",1,1],["قَد سَوَّدَت صَحيفَتي الذُنوبُ","وَإِن وَجَدتُ شافِعاً أَتوبُ",56,"ب",1,0],["قَد سَمَّتِ الأَكبَرَ نورَ الغَيطِ","وَعَلَّمَتهُ المَشيَ فَوقَ الخَيطِ",57,"ط",1,0],["قَد سَحَبَت عَلى جَلالي بُردَها","لَيتَ جَلالَ المَوتِ كانَ صَدَّها",58,"د",3,0],["قُدُساً في البِلادِ شَرقاً وَغَرباً","حَجَّهُ القَومُ مِن فَقيهٍ وَقَسِّ",59,"س",1,0],["قُدسِيَّةُ النَفَحاتِ تُس","كِرُ بِالمَذاقِ وَبِالشَميمِ",60,"م",1,0],["قَد سالَ بِالدَمِ مِن ذَبحٍ وَمِن بَشَرٍ","وَاِحمَرَّ فيهِ الحِمى وَالأَشهُرُ الحُرُمُ",61,"م",1,0],["قَد سَمِعنا ما قُلتَ في الأَحلامِ","وَأَنَلناكَ بَدرَةً في المَنامِ",62,"م",1,1],["قَد سَوَّدَت شَجَرَ الجِبالِ شُعورُهُم","فَكَأَنَّ فيهِ مُسِفَّةَ الغِربانِ",63,"ن",1,0],["قَد سارَتِ الرُكبانُ بِال","خَبَرِ المُعَجِّبِ عَن وَفائِك",64,"ك",1,0],["قَد سَرَّني بُرءُ عِجلٍ مِن عَداوَتِهِ","بَعدَ الَّذي اِحتَطَبَت مِن سُخطِهِ الموبي",65,"ب",2,0],["قَد سُمِّحَ القَومُ عَنهُ بَعدَما مَنَعوا","وَخُفِّضَ القَولُ فيهِ بَعدَما شَغَبوا",66,"ب",3,0],["قَد سُدتَ في حالِ الحَداثَةِ يافِعاً","وَلَبِستَ أُبَّهَةَ الجَليلِ الأَشيَبِ",67,"ب",1,0],["قَد سَمَطَت عانَتَها وَقدَةٌ","مِن حَرِّ ماءٍ سَهِكِ الرائِحَه",68,"ح",2,0],["قَد سارَ بِالمَجدِ فَخَيَّم بِهِ","وَغابَ عَنّا بِالنَدى فَاِحضُرِ",69,"ر",1,0],["قَد سَلَّمَ اللَهُ مِنَ الهَجرِ","وَنِلتُ ما آمُلُ بِالصَبرِ",70,"ر",1,1],["قَد ساءَني مِنكَ اِشتِمالُكَ دونَ مَن","يَدنو إِلَيكَ عَلى أَبي كِشنيزَه",71,"ز",2,0],["قَد سَقاني وَلَم يُصَرِّد أَبو الغَو","ثِ عَلى العَسكَرَينِ شَربَةَ خُلسِ",72,"س",1,0],["قَد سَأَلنا سُعدى عَلى أَنَّ سُعدى","بِالَّذي يَسأَلُ المُحِبُّ بَخيلَه",73,"ل",2,0],["قَد سَمِعتُ الغُرابَ يوعِدُ بَيناً","وَاِنصِراماً لِحَبلِكِ المَوصولِ",74,"ل",1,0],["قَد سَيَّروا أَفعالَهُم بَينَها","وَنَقَّلوها كُلَّ تَنقيلِها",75,"ل",3,0],["قَد سُرَّ فيها الأَولِياءُ إِذِ التَقَوا","بِفِناءِ مِنبَرِها الجَديدَ فَجَمَّعوا",76,"ع",3,0],["قَد سَبَقَتني فيهُمُ الو