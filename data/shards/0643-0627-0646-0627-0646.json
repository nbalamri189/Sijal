حلومها","https://www.poetsgate.com/ViewPoem.aspx?id=16207",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5277,"رُبحى..أم البنين","https://www.poetsgate.com/ViewPoem.aspx?id=191402",""],[5344,"ماهو حلا .. كل ما زعلنا تغيبين .!","https://www.poetsgate.com/ViewPoem.aspx?id=155069",""],[5376,"كأنِّي أنا والبحرُ والطيرُ في هوى","https://www.poetsgate.com/ViewPoem.aspx?id=188428",""],[5376,"لا تسألِ النذلَ عزاً ليس يملكُه","https://www.poetsgate.com/ViewPoem.aspx?id=193183",""],[5410,"خفقة في بداية المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=154943",""],[5411,"كاهنة الأوراس","https://www.poetsgate.com/ViewPoem.aspx?id=191399",""],[5431,"سورة الماء...","https://www.poetsgate.com/ViewPoem.aspx?id=203214",""],[5431,"وما كلّ وجه بالبشاشة صادق","https://www.poetsgate.com/ViewPoem.aspx?id=211697",""],[5437,"بياض الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=144443",""],[5500,"سكون ظل","https://www.poetsgate.com/ViewPoem.aspx?id=188515",""],[5573,"ياذيب ياذيب يالي تكتب وتقرا","https://www.poetsgate.com/ViewPoem.aspx?id=202126",""],[5732,"يا زين جرحك","https://www.poetsgate.com/ViewPoem.aspx?id=177949",""],[5732,"قالو تتوب وقلت بالطرف مصيوب","https://www.poetsgate.com/ViewPoem.aspx?id=177872",""],[5758,"تراتيل الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=207926",""],[6004,"واستباح العُرى","https://www.poetsgate.com/ViewPoem.aspx?id=33753",""],[6019,"ذبولٌ يطوقُ زهرةَ عُمرك","https://www.poetsgate.com/ViewPoem.aspx?id=175268",""],[520,"نبهتني حمامة بسحير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577675",""],[6237,"رصيد الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77886&r=&rc=28",""],[6325,"الغياب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88020&r=&rc=2",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""]],"verses":[["كَأَنّا نَرى الضَربَ نَحرَ السَوامِ","وَنَحتَسِبُ الطَعنَ ضَربَ الصِفاحِ",0,"ح",1,0],["كأنّ انْسِيابَ النّهْرِ بيْنَ ظِلالِها","حُسامٌ صَقيلٌ والظِّلالُ لهُ غِمْدُ",1,"د",1,0],["كَأَنَّ إِناثَها عِقبانُ دَجنٍ","إِذا طُؤطِئنَ في بَلَدٍ يَبابِ",2,"ب",1,0],["كَأَنَّ أُناساً لَم يَحُلّوا بِتَلعَةٍ","فَيَمسوا وَمَغناهُم مِنَ الدارِ بَلقَعُ",3,"ع",1,0],["كأنا نواريه الثرى كل ساعة","أسى وكأنا كل آن نزايله",4,"ل",2,0],["كَانَ إِنْ تَدْعُهُ المُرُوءةُ لَبَّ","اهَا وَمَسْعَاهُ بِالنَّجَاحِ ضَمِينُ",5,"ن",1,0],["كَأَنَّ أُنوفَ الطَيرِ في عَرَصاتِها","خَراطيمُ أَقلامِ تَخُطُّ وَتَعجُمُ",6,"م",1,0],["كَأَنّا نَشُدُّ المَيسَ فَوقَ مَراتِجٍ","مِنَ الحُقبِ أَسفى حَزنُها وَسُهولُها",7,"ل",3,0],["كأنّ انقلاب الأرض ماء كأننا","على الماء من ريح الحياة نقوش",8,"ش",1,0],["كان أناسٌ يرون أنيَ في ال","آداب صفو ما شابه رنقُ",9,"ق",1,1],["كَأَنَّ أَنساعَها مِن طولِ ما ضَمَرَت","وُشحٌ تَقَعقَعَ فيها رَفرَفٌ قَلِقُ",10,"ق",1,0],["كان ان قال خاطباً يحسب","السامع منه ان السماء تقول",11,"ل",1,0],["كأنّ أنجمه فوضى مبدّدة","على الدجى بين مهزوز ومضطرب",12,"ب",1,0],["كَأَنَّ أُنوفَ الخَيلِ حَرّى مِنَ الوَغى","مَجامِرُ في الظَلماءِ تَهدا وَتَلهُبُ",13,"ب",1,0],["كَأَنَّ اِنخِراقَ الجَوِّ غَيَّرَ لَونَهُ","لَبوسُ حَديدٍ أَو لِباسُ حِدادِ",14,"د",1,0],["كَأَنّا نَمُتُّ بِحاجاتِنا","إِلى طاهِرٍ أَو إِلى هَرثَمَه",15,"م",2,0],["كَأَنّا نُباري بِهِ حَيَّةً","عَلى جَبَلٍ لا يُريدُ النُزولا",16,"ل",2,0],["كَانَ انصرافَي جُرْماً لا كِفاءَ له","عندي وأيُّ لَبيبٍ ليسَ يَجتَرِمُ",17,"م",1,0],["كَأَنَّ آناءَ لَيلِيَ في تَطاوُلِها","تَسوفُ كاذِبَ آمالي بِقُربِهِم",18,"م",1,0],["كأنّ انصداعَ الفجر نارٌ يُرَى لها","وراء حجابٍ حالكٍ نَفَسٌ يسمو",19,"م",2,0],["كَأَنَّ انهِزامَ اللَّيل بعدَ اقتِحامِهِ","تَمَوُّجُ بحرٍ ناقضَ المدَّ بالجزرِ",20,"ر",1,0],["كَأنَّا نُسلِّطُ آجالَها","عَلَيها فتَمحَقُ أَعمارَها",21,"ر",3,0],["كأنا نُقيمُ وراءَ الزمان","فما من حديثٍ ولا من خبرْ",22,"ر",1,0],["كَأَنَّ أَنينَ الهالِكينَ مُرَدَّداً","أَهازيجُ في أَسماعِكُم تَتَرَدَّدُ",23,"د",1,0],["كَأنَّ أنفَاسَ مُوسَى فِيهِ قد كمُلَت","بِسِرّ إحيَائِهَا لِلرُّوحِ فِي الصُّوَرِ",24,"ر",1,0],["كَأَنّا نُداري حِينَ نَسرُو جِلالُهُ","بِهِ مَلِكاً مِن عِزَّةٍ يَتَخَيُّلُ",25,"ل",1,0],["كَأَنّا نَرى الغَيبَ في أَمرِهِ","بِأَعيُنِ ظَنٍّ لَنا لَم تَخِب",26,"ب",1,0],["كأنّ أنابِيبَ الصِّعادِ أراقمٌ","تَلَمَّظُ في أنيابِها السمُّ مُنقَع",27,"ع",1,0],["كَأَنَّ أَنواحُ النِساءِ الجُدِّ","في عَرصَةٍ يَلمَعنَ بِالفِرَندِ",28,"د",1,0],["كَأَنَّ أَنْجُمَهُ والجَوُّ مُعتَكِرٌ","غِيدٌ بِأَخْبِيَةٍ يَنْظُرْنَ مِنْ فُرَجِ",29,"ج",1,0],["كَأَنَّ أَنْفَاسَهَا دُعَاءٌ","تَقُولُهُ الرُّوحُ فِي سِرَارْ",30,"ر",1,0],["كَانَ أَنْطُونُ كَاتِباً","بِالهُدَى صَدْرُهُ انْشَرَحْ",31,"ح",1,0],["كانَ إِن فتَّ الحَشا سَقَمٌ","عادَ في قُرآنِهِ فَتَلا",32,"ل",2,0],["كانَ إِن بارَزَ الرِجالَ غُلاماً","رَدَّ في الحَربِ بَيدَقاً كُلَّ فَرزِ",33,"ز",1,0],["كأن انسياب النهر بين ظلالها","حسام صقيل والظلال له عمد",34,"د",1,0],["كَأنّا نُبارِي بِهِ حَيّةً","على جَبَلٍ مَا يُرِيدُ النّزُولا",35,"ل",2,0],["كَأَنَّ أَنفُسَهُم أَتباعُ مُهجَتِهِ","وَصِدقَ إِقدامِهِم مِن بَعضِ ما سُلِبا",36,"ب",2,0],["كأن أنجمها في الليلِ زاهرةً","دراهمٌ والثريا كفُّ مُنتِقد",37,"د",1,0],["كانَ إن مرّ سالكاً في طريق","أَرِجَت مِن أريجهِ الأرجاءُ",38,"ا",2,0],["كانَ إِن فاهَ أحسنَ الناسِ صوتاً","وَبعيدَ المدى رواه البراءُ",38,"ا",2,0],["كانَ إن نامَنامَ يذكُر مَولا","هُ تَعالى ونومُه إغفاءُ",38,"ا",2,0],["كانَ أَندى الأجوادِ كفّاً وما كف","فتهُ عن حاجةِ الورى الحوجاءُ",38,"ا",2,0],["كأنّ إِناءها منها","خَلاَءٌ وهوَ مَلآنُ",39,"ن",1,0],["كان انصرافك عنَّا علَّةً قدحتْ","في كل حبَّة قلبٍ عندنا نارا",40,"ر",2,0],["كَأَنَّ أَنهارَها ماضي ظُبىً حُشيَت","خَناجِراً مِن لجينٍ في حَواشيها",41,"ي",3,0],["كان انقشاع النقع عن لمعانها","تفرُّج كرب لأبتسام بشير",42,"ر",1,0],["كَأَنَّ أَنينَهُنَّ بِكُلِّ سَهبٍ","إِذا اِرتَحَلَت تَجاوُبُ نائِحاتِ",43,"ت",1,0],["كَأنَّا نَرَى الإسكندرَ الآنَ قاطِناً","بِبلدتهِ أوأرسطا ليسَ نَائِبُ",44,"ب",1,0],["كأن أنفاسه من سمه لهبٌ","فكلُّ ما مسَّ ملدوغٌ ومغشومُ",45,"م",1,0],["كَأَنّا نَرى مِن غاسق اللَيل معبدا","يُشير إِلَينا بِالمَصابيح راهبُه",46,"ب",2,0],["كَأَنّا نَرى نَهر المَجرّة منهلا","لَهُ مِن غَواني الحَيّ أَمّت كَواعبُه",46,"ب",2,0],["كأنَّ انتساجَ الطِّينِ بالقصَب الّذي","نُظِمْنَ أكُفٌّ شابكَتْ بأنامل",47,"ل",1,0],["كأنّا نُبارِي الشُّهْبَ في كُلِّ قُنَّةٍ","فمِنّا هُبوطٌ تارةً وصُعود",48,"د",1,0],["كَأَنَّ إِنسانَها وافى بِمُعجِزَةٍ","فَكانَ مِن أَدمُعي يَمشي عَلى الماءِ",49,"ا",2,0],["كَأَنَّ أَنجمه وَالصبح يغمضها","قَسراً عيون غفت مِن شِدَّةِ السَهَرِ",50,"ر",1,0],["كَأَنَّا نَذَرْنا مَطْلَعَ الشَّمْسِ مَنْزِلاً","أَلِيَّةَ حَلْفٍ كَانَ وَجْهُكَ حِلَّها",51,"ل",3,0],["كَأَنَّ اِنتِثارَ القَطرِ وَالزَهرُ زاهِرٌ","عَلى الوَردِ دَمعٌ فَوقَ خَدٍّ مُوَرِّدِ",52,"د",1,0],["كَأَنَّ أَنفاسُهُ وَنَكهَتُهُ","نَسيمُ زَهرٍ زَها بِزَهرَتِهِ",53,"ت",2,0],["كان أنسي بها قديماً وقدماً","كنت أسطو به على الأزمان",54,"ن",1,0],["كَأَنَّ أُنوفَنا لاقَينَ جَدعاً","لِفَقدِ مُحَمَّدٍ فيهِ اِصطِلامُ",55,"م",1,0],["كان أنا سيدي","مدة دهر مضى",56,"ض",2,1],["كأنَّ أنمُلَهُ في كَفِّه خُلُجٌ","أو ديمَةٌ مِن هَزيمِ الوَدقِ رَجّاسِ",57,"س",1,0],["كأنَّ أُنْمُلَهُ مِنْ فَوْقِ وَجْنَتِهِ","سُوسانَةٌ قَدْ بَدا خِلالَها وَرْدُ",58,"د",1,0],["كأنّا نوطئُ الأقدا","مَ أطرافَ السكاكين",59,"ن",1,0],["كان انتظار بلوغ رأيك عندها","مثل انتظار الشمس حتى تبزغا",60,"غ",2,0],["كأن انسلال الذئب أول ليلةٍ","يبادر أسماك الحياض انسلالها",61,"ل",3,0],["كأن انبلاج الصبح في طرف الدجى","صَحائف تنبي أنه جادَ ماتعُ",62,"ع",1,0],["كانَ أُنسِي في خَلوَتي وَنَدِيمي","وَجَمالي إِن كانَتِ الجَلَواتُ",63,"ت",1,0],["كأَنَّ أنجمها والجو يبرزها","جواهر الدرّ في بحر الظلام طفَت",64,"ت",1,0],["كأن أنابيبها باللجي","ن من كل ناحيةٍ تدفق",65,"ق",1,0],["كأنَّ أنفسَنا لم ترتحل مَعَنا","أو سِرنَ فى أوّل الحيِّ الذي سارا",66,"ر",2,0],["كَأَنَّ انْصِدَاعَ الفَجْرِ نَهْرُ حَدَائِقٍ","سَقَى زَهْرَهَا أَوْ دَمْعُ أَحْدَاقِ هَيْمَانِ",67,"ن",1,0],["كأنا نبتغي مما وغلنا","وراء الصين في الشرقيِّ صينا",68,"ن",2,0],["كأَنَّ أنداءه على ورق الخري","ف دُرٌّ في التبر منثور",69,"ر",1,0],["كأن انزعاج القلب حين ذكرتكم","وقد بعد المسرى خفوق جناحين",70,"ن",1,1],["كأن انشادنا مدائحه","أنصاف كتب ليست بمؤتلفه",71,"ف",2,0],["كَأَنَّ اِنجِلاءَ اللَيل عَن وَجهِ صُبحِهِ","نُصولُ خِضاب كانَ ستر نصوع",72,"ع",1,1],["كَأَنَّ اِنتِصار البَدر مِن تَحت غَيمَةٍ","نَجاة مِن البَأساءِ بَعدَ وُقوع",73,"ع",1,1],["كأنّا نرى أن لا نشور وأنّنا","صدىً ما لنا بعد الممات مصادر",74,"ر",1,0],["كان إنسانه خليقاً بوحش","كاسرٍ والفؤادُ صخر الجبال",75,"ل",1,0],["كَأَنَّ اِندِفاعَ البَرقِ بَينَ رعوده","تطاير نارٍ لاصطكاك جنادِلِ",76,"ل",1,1],["كَأَنَّ اِنتِثارَ القطرِ فيهِ ضَوابِطٌ","تُدارُ عَلى الغُدران مِنهُ دَوائِرُ",77,"ر",1,0],["كأن أنين الأم يوم مخاضها","على فصلها جزءاً من الروح تهواه",78,"ا",2,0],["كأنَّ اندِماجَ الريشِ مِنهُ حبائِكٌ","بعقبِ سحاباتٍ لَهُنَّ نُشورُ",79,"ر",1,0],["كأنا نيامٌ وأحداثه","تمرّ كطيف له زائر",80,"ر",1,0],["كأنَّ انعطافَ الصُّدغِ لامٌ أمالها","أديبٌ يجيدُ الخطَّ أيّانَ يكتب",81,"ب",1,0],["كأن انتثار الطل في الورد أدمع","تبدى على زهر الخدود انتثارها",82,"ه",2,1],["كأنا نرسلُ الصقرا","فمنْ يبغي يراسلنا",83,"ن",2,0],["كأن انقلاب الهجر والوصل مركب","يجوز به الملاح طوراً ويهتدي",84,"د",2,0],["كأنّ انسِكابَ الغيْثِ وقْعُ سِهامِها","إذا ما تُوالي رمْيَها وتُتابِعُ",85,"ع",1,0],["كأن أنفاسهم فيها قد امتزجت","أنفاس عيسى لميت القلب تحييه",86,"ي",2,0],["كان أنطنيوس صباً مغرما","فانقضى الحب ومات المغرم",87,"م",1,0],["كأن أنو شروان أعطاه تاجه","ومن كل لونٍ نال من حسنه قسطا",88,"ط",2,1],["كَأَنّ انسكاب الطلّ في جنحِ لَيلِه","دُموعٌ جرت من جفنِ هَيفاء كحلاءِ",89,"ا",2,1],["كَأَنّ إِنسانَ عَيني في مدامعه","موسى الكَليم غدا في اليمّ منتَبَذا",90,"ذ",2,0],["كأنا نذود البين بالقرب بيننا","فنشتدّ من خوف الفراق تدانيا",91,"ي",2,0],["كان أنين المومقين ومن به","جوارح رمى قاصفات لأعمد",92,"د",1,0],["كان أنيسي في سكون الدجى","كان سميري في دجى وحشتي",93,"ي",1,0],["كأنَّ أنيابَها وَهْناً حَصى بَرَدٍ","أو أُقحوانُ سقاه طلَّه الحَدرُ",94,"ر",1,0],["كأن إنَاثَ العين تهدى سَخالها","خرائدَ يمشين الضُّحى عند أطفالِ",95,"ل",1,0],["كانَ إِنشادُكَ المُبارَكُ فَجراً","مُستَهَلّاً وَضيءَ نورِ الحَياةَ",96,"ه",1,0],["كأن انسياب الرمح في الدرع سالخ","من الرقش في وسط الغدير له غط",97,"ط",1,0],["كأن انسياب الرمح في الدرع سابح","من الرقش في وسط الغدير له غبط",98,"ط",1,0],["كان أنسَ المحرا