{"poems":[[57,"إني بليت بذي لونين يظهر لي","https://www.aldiwan.net/poem26402.html","البسيط"],[53,"لم يظلم الدهر أن توالت","https://www.aldiwan.net/poem65789.html","مخلع البسيط"],[53,"لم يظلم الدهر في أن حاف مجتهدا","https://www.aldiwan.net/poem66448.html","البسيط"],[46,"كان لنفسي أمل فانقضى","https://www.aldiwan.net/poem29691.html","السريع"],[54,"يا سارق الأنوار من شمس الضحى","https://www.aldiwan.net/poem26886.html","الكامل"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[109,"تقبيل","https://www.poetsgate.com/ViewPoem.aspx?id=214007",""],[53,"لم يظلمِ الدهْرُ أنْ توالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=30056",""],[147,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[190,"ترك الأنام الموجبات","https://www.aldiwan.net/poem43476.html","مجزوء الكامل"],[354,"لا رحت للآمال منك مبلغا","https://www.aldiwan.net/poem15782.html","الكامل"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17077","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100983","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47168","الكامل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93871","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205683","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131221",""],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143820","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58086","البسيط"],[4961,"الموتُ لا يمرُّ بهذهِ القِمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=50581",""],[5701,"أهلا بمقدمك العظيم وأكرم","https://www.poetsgate.com/ViewPoem.aspx?id=164676",""],[5830,"فِي المَجْدِ ْمُسْتَبَقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201192",""]],"verses":[["لَم يَظلِمِ اللَهُ قَلبي حينَ أَودَعَهُ","بِكِ البَلاءَ وَأَعطى قَلبَكِ الجَلَدا",0,"د",2,0],["لم يظلم الدهْرُ أنْ توالتْ","فيكم مُصيباتُه دِراكا",1,"ك",2,1],["لم يظلم الدهرُ في أن حاف مجتهداً","عليكم آلَ عيسى حيْفَ مُضطغِنِ",2,"ن",1,1],["لَم يَظلِمِ الدَهرُ وَلَكِنَّهُ","أَقرَضَني الإِحسانَ ثُمَّ اِقتَضى",3,"ض",2,0],["لَم يَظفَرِ التَشبيهُ مِنكَ بِطائِلٍ","مُتَسَلِّخٌ بَهَقاً كَلَونِ الأَبرَصِ",4,"ص",1,0],["لم يظلم القاسم محروما ولا","كل سعيد بالثراء محتظى",5,"ا",1,0],["لم يظلم الدهر من أتيح له","هذا الهوى من إنس ومن جان",6,"ن",1,0],["لم يظلمِ الدهْرُ أنْ توالتْ","فيكم مُصيباتُه دارِكا",7,"ك",2,1],["لَم يَظفَروا بِطَريقٍ نَحوَ مُلكِكَ ما","تُزاحِمُ الناسَ فيهِ الخَيلُ وَالإِبِلُ",8,"ل",1,0],["لم يظفروا في دهرهم","من ريب دنياهم بباطل",9,"ل",1,0],["لَم يَظمَ وارِدُ عَينِ ظِلِّكَ لا وَلا","ضَحٌّ لِمَن أَضحى عَلَيهِ مُسبَغا",10,"غ",2,0],["لم يظفَرِ الفهمُ يوماً في تصوّرها","ولا يَزورُ خيالُ الوهمِ مَغناها",11,"ا",3,0],["لَم يَظلِموا في الحُكمِ إِذ مَثَّلوا بِهِ","فَلَشَدَّ ما رَفَعَ البَنَفسَجُ شانَهُ",12,"ن",2,0],["لم يظلموا حين جاروا غير أنفسهم","ولا هوى غيرهم في الغي إذ غدروا",13,"ر",3,0],["لم يظفَروا بسوى الذي","عَمِلُوه من خَيْرٍ مُدَام",14,"م",1,0],["لم يظنوا أنا فطنا لهم من","قبل أن يقلبوا علينا المرادا",15,"د",2,0],["لم يظفروا يوماً بنيل مرامهم","ولغيظهم عضو على الأظفار",16,"ر",1,0],["لم يظلم اليقظاتِ فهْيَ إذا وفت","بلقائه، سلبته من حلم الكرى",17,"ر",2,0],["لم يظهروه على الصدور تباهياً","لكنهم تركوه فيها مضمرا",18,"ر",2,0],["لم يظلموا في الحكم إذ مثلوا ب","فأشد ما رفع البنفسج شانه",19,"ن",2,0],["لم يظلمنَّ وليس الظلمُ عادتَهُ","وإن تعدَّى عليه الظالمونَ عَفَا",20,"ف",2,0],["لمْ يظهرِ النبضُ إلا حينما علِمتْ","كلُّ العروق ِ بقلبي أنَّكَ المددُ",21,"د",1,0],["لم يظلموا شعبا ولكن آثروا","من يحكمون وذاك حكم المسلم",22,"م",1,0],["لَمْ يَظْلِمُوا إِذْ عَلَوْا سَادُوا بِمَرْحَمَةٍ","وَ الكَوْنُ شَاهِدُهُمْ أَسْلَمَهُم العَلَمَا",23,"م",2,0]]}