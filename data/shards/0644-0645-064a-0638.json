{"poems":[[55,"إني بليت بذي لونين يظهر لي","https://www.aldiwan.net/poem26402.html","البسيط"],[51,"لم يظلم الدهر أن توالت","https://www.aldiwan.net/poem65789.html","مخلع البسيط"],[51,"لم يظلم الدهر في أن حاف مجتهدا","https://www.aldiwan.net/poem66448.html","البسيط"],[44,"كان لنفسي أمل فانقضى","https://www.aldiwan.net/poem29691.html","السريع"],[52,"يا سارق الأنوار من شمس الضحى","https://www.aldiwan.net/poem26886.html","الكامل"],[107,"تقبيل","https://www.poetsgate.com/ViewPoem.aspx?id=214007",""],[51,"لم يظلمِ الدهْرُ أنْ توالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=30056",""],[144,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[187,"ترك الأنام الموجبات","https://www.aldiwan.net/poem43476.html","مجزوء الكامل"],[350,"لا رحت للآمال منك مبلغا","https://www.aldiwan.net/poem15782.html","الكامل"],[515,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"]],"verses":[["لَم يَظلِمِ اللَهُ قَلبي حينَ أَودَعَهُ","بِكِ البَلاءَ وَأَعطى قَلبَكِ الجَلَدا",0,"د",2,0],["لم يظلم الدهْرُ أنْ توالتْ","فيكم مُصيباتُه دِراكا",1,"ك",2,1],["لم يظلم الدهرُ في أن حاف مجتهداً","عليكم آلَ عيسى حيْفَ مُضطغِنِ",2,"ن",1,1],["لَم يَظلِمِ الدَهرُ وَلَكِنَّهُ","أَقرَضَني الإِحسانَ ثُمَّ اِقتَضى",3,"ض",2,0],["لَم يَظفَرِ التَشبيهُ مِنكَ بِطائِلٍ","مُتَسَلِّخٌ بَهَقاً كَلَونِ الأَبرَصِ",4,"ص",1,0],["لم يظلم الدهر من أتيح له","هذا الهوى من إنس ومن جان",5,"ن",1,0],["لم يظلمِ الدهْرُ أنْ توالتْ","فيكم مُصيباتُه دارِكا",6,"ك",2,1],["لَم يَظفَروا بِطَريقٍ نَحوَ مُلكِكَ ما","تُزاحِمُ الناسَ فيهِ الخَيلُ وَالإِبِلُ",7,"ل",1,0],["لم يظفروا في دهرهم","من ريب دنياهم بباطل",8,"ل",1,0],["لَم يَظمَ وارِدُ عَينِ ظِلِّكَ لا وَلا","ضَحٌّ لِمَن أَضحى عَلَيهِ مُسبَغا",9,"غ",2,0],["لم يظفَرِ الفهمُ يوماً في تصوّرها","ولا يَزورُ خيالُ الوهمِ مَغناها",10,"ا",3,0]]}