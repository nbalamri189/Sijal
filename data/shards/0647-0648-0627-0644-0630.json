اس من جهلهم","https://www.poetsgate.com/ViewPoem.aspx?id=215825",""],[585,"من مهبط الوحي حول البيت والحرم","https://www.poetsgate.com/ViewPoem.aspx?id=161898",""],[585,"يا صاحب التاج عن حقٍّ وإرث أب","https://www.poetsgate.com/ViewPoem.aspx?id=161895",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[585,"ماذا الجمود وجرعاء الديار دم","https://www.poetsgate.com/ViewPoem.aspx?id=161903",""],[5092,"القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=190571",""],[5117,"النبي","https://www.poetsgate.com/ViewPoem.aspx?id=12149",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[5346,"فيا عجيبا من الدنيا وعادتها","https://www.poetsgate.com/ViewPoem.aspx?id=127132",""],[5362,"كوفان بوركت من أرض مقدسة","https://www.poetsgate.com/ViewPoem.aspx?id=170376",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5411,"مِنْ هَمْسِ ضارِعَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187706",""],[5568,"هي الحوادث لا ترمي سوى العلم","https://www.poetsgate.com/ViewPoem.aspx?id=169348",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[2110,"هلال حسن هل يا من يراه","https://www.poetsgate.com/ViewPoem.aspx?id=156288",""],[5732,"قلبي نهبته","https://www.poetsgate.com/ViewPoem.aspx?id=177915",""],[5939,"يا لها","https://www.poetsgate.com/ViewPoem.aspx?id=195295",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[6225,"في حب المصطفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78038&r=&rc=123",""]],"verses":[["هُوَ الذَكَرُ المُرَشَّحُ لِلمَعالي","وَلِلبيضِ القَواضِبِ وَاللَدانِ",0,"ن",1,0],["هُوَ الذي نَعَشَ اللهُ العِبادَ بهِ","ضَخْمَ الدَّسيعَةِ مَتبوعٌ ومَسؤولُ",1,"ل",1,0],["هُوَ الَّذِي جَمَعَتْ يُمْنَاهُ بُوركَتَا","لِلْجُودِ وَالْبَأَسِ دَأْباً بَيْنَ ضِدَّيْنِ",2,"ن",1,0],["هَوَ الَّذِي اسْتَخْلَصَ السُّلْطَانَ مُجْتَهِداً","بِكُلِّ بَاري الظُّبَا مَاضِي الذُّبَابَيْنِ",2,"ن",1,0],["هُوَ الذُّخْرُ يُعْنِي فِي الحَيَاةِ عَتَادُهُ","وَيُتْرَكُ فِيهِ لِلْبَنينَ رِفَاءُ",3,"ف",3,0],["هو الذي خبرت معروفة أمم","فما تنكر في سر ولا علن",4,"ن",1,0],["هُوَ الَّذِي خَبَرَتْ مَعْرُوقَةُ أُمَمٌ","فَمَا تَنْكُرُ فِي سِرٍّ وَلا عَلَنِ",5,"ن",1,0],["هُوَ الذائِدُ الحامي الحَقيقَةَ بِالقَنا","وَفي المَحلِ زادُ المُرمِلينَ الصَعالِكِ",6,"ك",1,0],["هو الذي يروي حديث الثنا","عن شخصه الباهرَ عن قرّه",7,"ر",2,0],["هو الذي يرتعُ في كَسْبها","فافطُنْ له يا نائمَ القلبِ",8,"ب",1,0],["هو الذي سلَّ سيفَ الثأر دونكمُ","لا يأتلي للذي ضيَّعْتُمُ طلبا",9,"ب",2,0],["هو الذي حملَ الأقلامَ ضاحيةً","عن الطريق وقد جارتْ عن اللُّقم",10,"م",1,0],["هو الذي توَّج اللَّهُ الرجال به","تِيجانَ فخرٍ وللتَّفْضيل تِيجان",11,"ن",1,0],["هو الذي بَتَّ أسبابَ الهوى أَنَفَاً","من أنْ تُصيبَ أسودَ الغابةِ الضان",11,"ن",1,0],["هو الذي حكمتْ قِدْماً بِسُؤْدُدِهِ","عدنانُ ثم أجازتْ ذاكَ قحطان",11,"ن",1,0],["هُوَ الَّذي سَلَبَ الدُنيا بَشاشَتَها","وَراحَ يَملَءُها هَمّاً وَأَحزانا",12,"ن",2,0],["هُوَ الَّذي لَم تَشِم يُمناك صَفحَتَهُ","إِلّا تَأتّى مُرادٌ وَاِنقَضى وَطَرُ",13,"ر",1,0],["هو الذي جنى فكنّ","عرضة النوائب",14,"ب",1,0],["هو الذي قامت به","في الشرق نهضة العرب",15,"ب",1,0],["هو الذي اراد ان","نسيء اوان نحسنا",16,"ن",2,0],["هو الذنبُ بين العفو والسيفِ فاحتكمْ","بما شئتَ لا يَعْلَقْ بفعلِك ذَامُ",17,"م",1,0],["هُوَ الذُخرُ مِن دُنياكَ قَدَّمتَ فَضلَهُ","وَلا خَيرَ في الدُنيا إِذا لَم يَكُن ذُخرُ",18,"ر",1,0],["هُوَ الَّذي أَنشأَ الأَشياءَ مُبتَدِعاً","فَكَيفَ يُدرِكهُ مُستَحدثُ النَسَمِ",19,"م",1,0],["هُوَ الَّذي عَرَّفَ الكُفّارَ مَنزِلَهُم","وَالمُؤمِنونَ سَيَجزيهِم بِما وُعِدوا",20,"د",3,0],["هُوَ الَّذي هَزَمَ اللَّهُ الطُغاةَ بِهِ","في كُلِّ مُعتَرَكٍ بِالبِيضِ مُحتَدِمِ",21,"م",1,0],["هُوَ الَّذي يَنعَشُ المَكرُوبَ إِذ عَلِقَت","بِهِ الرَّزايا وَيُغني كُلَّ ذي عَدَمِ",21,"م",1,0],["هُوَ الَّذِي يَنْعشُ الْمَظلومَ إِنْ عَلِقَتْ","بِهِ الرَّزَايَا وَيَجْزِي كُلَّ تَيَّاهِ",22,"ه",1,0],["هُوَ الَّذِي جَعَلَ الأَفْلاكَ دَائِرَةً","وَصَوَّرَ الْخَلْقَ مِنْ إِنْسٍ وَمِنْ جَانِ",23,"ن",1,0],["هو الذُّخر الثمينُ ولن تُصيبوا","كمِصرَ وشعبِها ذُخراً ثمينا",24,"ن",2,0],["هُوَ الَّذي قَدَرَ اللَهُ القَضاءَ لَهُ","أَلّا يَكونَ لَهُ في فَضلِهِ ثانِ",25,"ن",1,0],["هُوَ الَّذي اِمتَحَنَ اللَهُ القُلوبَ بِهِ","عَمّا تُجَمجِمُ مِن كُفرٍ وَإيمانِ",25,"ن",1,0],["هو الذي جمَّع شَمْلَ الأُمَّهْ","وجابَ عنها دامِساتِ الظُّلمَهْ",26,"ه",1,0],["هو الَّذِي قامَ مقامَ الضَّيغَمِ","وجاءَ في غَزاتِهِ بالصَّيلَمِ",26,"م",1,0],["هو الذي جنى فكن","ن عُرضةَ النوائبِ",27,"ب",1,0],["هُوَ الذَّوْبُ بَلْ أُرْيُ الخلايا شَبِيهُهُ","بِدِرْياقَةٍ مِنْ خَمْرِ بَيْسانَ قَرْقَفِ",28,"ف",1,0],["هو الذُّخر يُغْني في الحيلة عتادُهُ","ويتركُ منه للبنينَ رِفاء",29,"ا",2,0],["هو الذي سلب الدّنيا بشاشتها","وراح يملأها همّا وأحزانا",30,"ن",2,0],["هو الذي هيمني","وزاد قلبي قلقا",31,"ق",2,0],["هو الذي ظهرت في الكون همته","فصار أشهر من نار على علم",32,"م",1,0],["هو الذي ضجت الدنيا بنوبته","هو الذي سار في الأعراب والعجم",32,"م",1,0],["هو الذي مداتي نور الطريق بدا","هو الذي أغرق المحتاج بالكرم",32,"م",1,0],["هو الذي زان من يتلو وقرَّبه","وقُربُهُ أبداً لله والرّسُلِ",33,"ل",1,0],["هو الذي شانئُهُ شان بُعدُهُمُ","في المُرْه والوُطْفِ عند الأعين النُّجلِ",33,"ل",1,0],["هو الذات عين الذات سرٌّ لعينها","وسرٌّ لسرِّ السرِّ سرك لامحا",34,"ح",2,0],["هو الذي دَهرَ المُجونِ والصِّبَا","إِذ ندتمُوا كُلَّ فَتًى مُهذَّبَا",35,"ب",2,0],["هُوَ الذي كانتِ الدُنيا تُؤمِّلُهُ","وكلُّ عصرٍ لهُ ما زالَ مُرتَقَبا",36,"ب",2,0],["هو الذي أفعالهُ من حسنِها","كأنما اشتُقِقن من ألقابهِ",37,"ب",2,0],["هو الذي لو حمىَ مَرعىً لما سَرحتْ","سوائم الدهر إلا حيث يختارُ",38,"ر",1,0],["هُوَ الَّذي اِفتَرَضَ الرَحمَنُ طاعَتُهُ","وَمن سِواهُ فَلا فَرضٌ وَلا نَفَلُ",39,"ل",1,0],["هُوَ الَّذي تَعلَمُونَ كَلبٌ","فَهَل لِنَبحِ الكِلابِ قِيمَه",40,"م",2,0],["هُوَ الَّذي خَضَعَت شُوسُ الرِجالِ لَهُ","ذُلّاً كَما تَخضَعُ الجربا لِطالِيها",41,"ي",3,0],["هو الذي غايةُ الأهوالِ أَهْوَنُه","صعوبةً وأَمَرُّ الصَّابِ أَعْذَبُه",42,"ب",2,0],["هُوَ الَّذي جَمَعَ الرَحمَنُ أُمَّتَهُ","عَلى يَدَيهِ وَكانوا قَبلَهُ شِيَعا",43,"ع",2,0],["هُوَ الذائِدُ الحامي إِذا اِشتَجَرَ القَنا","وَإِن صَوَّحَت سَنهاءُ فَالهانِىءُ الطالي",44,"ل",2,0],["هُوَ الَّذي اِنتاشَني مِن عَثرَةٍ كَرَبَت","حاشاهُ يَصرَعُني مِن زلَّةِ القَدَمِ",45,"م",1,0],["هُوَ الَّذي بِجودِهِ وَبَأسِهِ","فاضَ كَبَحرٍ مُزبِدٍ خِضَمِّ",46,"م",1,0],["هُوَ الَّذي عَرَكَت أُذنَ الزَمانِ بِصُل","بِ المِلحِ يُمناهُ حَتّى تابَ مفتاتُ",47,"ت",1,0],["هو الذهبُ الذي جمعتْ جُدودي","عَلَى الأيامِ والحججِ الخوالي",48,"ل",2,0],["هوَ الذابِلُ الذاوي الّذي إن ترشّحت","لَه نُطفةٌ في الطرسِ أورق بالخصبِ",49,"ب",1,0],["هُوَ الَّذي يَفصِلُ في أَمرِهِ","وَيَحكُمَن حُكمُهُ المُستَسَنِ",50,"ن",1,0],["هو الذي في ربيع الحب أسعدني","وهو الذي في خريف الحب أشقاني",51,"ن",2,0],["هُوَ الَّذي يَبقى وَأُجزى بِهِ","يَوم يُجازى كُلُّ إِنسانِ",52,"ن",1,0],["هو الّذي عَلَّمتْني الجودَ أنملُه","فكيف مَعْ قُرْبِه أرضَى بسَبْقيه",53,"ي",2,0],["هو الّذي إن سَخا دَهْري برؤيتهِ","من بعدِ ما شَفّ قلبي بُعدُه فِكَرا",54,"ر",2,0],["هُوَ الَّذِي حَلَّ أَزرارَ الجماجِمِ عن","عُرَى الرّقابِ وجَيْبُ النَّقْعِ مَزرورُ",55,"ر",1,0],["هو الذي همّتُه فوقَ السُهى","حوى الجلالَ والجمالَ والنُهى",56,"ه",2,0],["هو الذي ضعضَعَ ابنَيْ وائلٍ وسَما","فيها بموجِ الوغى مذْ يوم ثَهْلانُ",57,"ن",1,0],["هو الذي هو حياه البعير كما","حيته نوق أنيخت عنده الحرما",58,"م",2,0],["هو الذي قد نال فهمَا ثاقباً","وحاز من مولاه فضلاً بارعا",59,"ع",2,0],["هو الذي ما جاد أو ضنّ ولا","رقَّ عليَّ مرةً إلا قسا",60,"س",2,0],["هو الذي أخَّرني مَشَارفَ ال","سبق فأظمَا شفتي على القَرَبْ",61,"ب",1,0],["هُوَ الذي نالَ ما قد نالهُ وأنا","أُذيعُ للنَّاسِ عن أخلاقهِ خَبَرا",62,"ر",2,0],["هوَ الذي حجُّ آلِ البيتِ جاءَ بهِ","بعدَ الذَّهابِ جَلِيِّ الطُرْقِ جاليها",63,"ي",3,0],["هو الذي في القول أضمرناه","وقد رضيناه وأمرناه",64,"ه",1,0],["هُوَ الَّذي فازَ في تَدبير دَولته","مِن حسن تَوفيق مَولاه بِنيل مُنى",65,"ن",2,0],["هُوَ الَّذي سَيفُه المَشهور في يَده","عَلى رِقاب الأَعادي يَسبق العَذَلا",66,"ل",2,0],["هُوَ الَّذي جَيشه المَنصور بايعَهُ","عَلى ثَبات بِهِ قَدرُ الكَميِّ عَلا",66,"ل",2,0],["هُوَ الَّذي صير الباغي بِصَولته","في كُل مُعترك بَينَ الوَرى مَثَلا",66,"ل",2,0],["هو الذي انتاشني مِن قَعرِ هاويةٍ","أقمتُ فيا مُطارَ اللُّبِّ حَرّانا",67,"ن",2,0],["هوَ الَّذي صارَ بِالإِحْسانِ يَملِكُنا","وكَم لهُ أعْبُدٌ دانَتْ وأحْرارُ",68,"ر",1,0],["هو الذي يبتلى ان بُتّ حبلهم","بالسير إثرَهُمُ أيان ما ارتحلوا",69,"ل",3,0],["هو الذي لولاهُ ما تطاولت","أواخرُ الدهر على الأوائلِ",70,"ل",1,0],["هو الذي بنيان عليائه","بقمة الجوزاء معقودُ",71,"د",1,0],["هو الذروة العليا التي ليس ترقى","هو العروة الوثقى التي لن تفصما",72,"م",2,0],["هو الذي كنتُ حتى اليوم أعبُدهُ","وكان قلبي حتى اليوم مرعاه",73,"ا",2,0],["هو الذخيرة لي عند الصراط إذا","أمسكت في الحشر من أسبابه طرفا",74,"ف",2,0],["هو الذكر الحكيم الحي قامت","دلائله من الذكر الحكيم",75,"م",1,0],["هو الذي لا يجارى في بلاغته","وهل تجاري جواد الخيل عرجاءُ",76,"ا",2,0],["هو الذي قد قلت في شأنه","إنا فتحنا لك فتحاً مبين",77,"ن",1,0],["هو الذخر لي في النايبات جميعها","فمذ سار عني صرت حقا اصفق",78,"ق",1,0],["هو الذخر البشير هو المرقا","جليل القدر نزه عن دنيه",79,"ي",2,0],["هو الذخر لي من فضل ربي هو الذي","ملاذي به ان شمت دهري قارعي",80,"ع",2,0],["هو الذى عمّت الدّنيا مواهبُهُ","فلا خلا من عَطايا كَفِّهِ أحدُ",81,"د",1,0],["هو الذى حرس اللهُ البلادَ به","من العدوِّ فما يغتالُها النِّقَمُ",82,"م",1,0],["هُوَ الَّذي أَنشأكم لتبعدوا","وَذا الَّذي أَرشدكم لتقتدوا",83,"د",3,0],["هو الذّكر ذكر الأزهري مخلدٌ","إلى كلّ عصر ينشر الورد والآسا",84,"س",2,0],["هو الذي كان بيت الله مولده","وصاحب البيت أدرى بالذي فيه",85,"ه",1,1],["هو الذي شيد دين أحمدٍ","شيّد أركان علاه أحمد",86,"د",1,0],["هُوَ الذُّخرُ لاَ يُرجَى سِوَاهُ وَسِيلَةً","إذا لم يَكُن يومَ الجَزَا غيرَهُ ذُخرُ",87,"ر",1,0],["هو الذي لم يغادر سبه سعبا","وسيفه لم يدر نابا ولا ظفرا",88,"ر",2,0],["هو الذي كَنَتِ التوراةُ عنه وفي","الإنجيل ما ضُمِّنَتْ فيه المزاميرُ",89,"ر",1,0],["هو الذكر ذكر اللَه لكنهم عموا","وصموا وفي آذانهم أبداً وقر",90,"ر",1,0],["هُوَ الذي مَلَأَ الدُنيا بَشائِرُهُ","وَأَرفَلَ الكَونَ في أَثوابِهِ الجُدُدِ",91,"د",1,0],["هو الذي لم يزل يخفي حقيقته","بما هي اليومَ في أبصارنا تبدو",92,"د",2,0],["هو الذي حيَّر الألبابَ واعتمدت","