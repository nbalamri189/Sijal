{"poems":[[73,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[39,"إلا شجيج أصابته منقلة","https://www.aldiwan.net/poem7392.html","البسيط"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[47,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[51,"ألا شافع عند الخليفة يشفع","https://www.aldiwan.net/poem64233.html","الكامل"],[82,"يا رب مجلس لذة شاهدتها","https://www.aldiwan.net/poem31524.html","الكامل"],[76,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[50,"هل لديار حييتها درس","https://www.aldiwan.net/poem64333.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85507","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[92,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[80,"كذا يهلِكُ السَّيفُ في جفنِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87626&r=&rc=172",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[164,"أراني الله رأسك يا صلاح","https://www.aldiwan.net/poem58709.html","البسيط"],[164,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[164,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[164,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[164,"هز الغرام معاقد التيجان","https://www.aldiwan.net/poem59100.html","الكامل"],[173,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[215,"مضت أسابيع والهتاف محتجب","https://www.aldiwan.net/poem46764.html","البسيط"],[276,"أمن تذكر أهل البان والبان","https://www.aldiwan.net/poem52124.html","البسيط"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[447,"ألا شغف الفؤاد بحب ليلى","https://www.aldiwan.net/poem14328.html","الوافر"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[580,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83307","الطويل"],[719,"","https://poetry.dctabudhabi.ae/diwan/poem/99139","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39009","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216686",""],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108446","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109344","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53029","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53236","البسيط"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/141790","البسيط"],[2325,"","https://poetry.dctabudhabi.ae/diwan/poem/146716","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106859","المنسرح"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115538","المتقارب"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145041","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206141","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66612","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66541","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66558","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66554","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66550","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66546","الكامل"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58077","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216343",""],[4796,"مُصارَحة","https://www.poetsgate.com/ViewPoem.aspx?id=180990",""],[4829,"بنات الجن","https://www.poetsgate.com/ViewPoem.aspx?id=34266",""],[1901,"أَلا شَدَّ ما ضنّتْ بمعروفها سُعدَي","https://www.poetsgate.com/ViewPoem.aspx?id=160413",""],[4966,"كرونا","https://www.poetsgate.com/ViewPoem.aspx?id=211239",""],[4976,"دموع شموع","https://www.poetsgate.com/ViewPoem.aspx?id=207689",""],[5155,"أغنية عربية الى كردستان","https://www.poetsgate.com/ViewPoem.aspx?id=176153",""],[5183,"المستميت على الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=180173",""],[5186,"إاذا كانت الآمال بالوصل أوهاما","https://www.poetsgate.com/ViewPoem.aspx?id=156475",""],[5320,"إلى البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=41634",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5739,"برج الهواوي ورادار العشير ..!","https://www.poetsgate.com/ViewPoem.aspx?id=130849",""],[5790,"بأبي وبي طيفٌ طرق","https://www.poetsgate.com/ViewPoem.aspx?id=111872",""],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["الأَشرَفِ المَلكِ الَّذي بَذلُ النَدى","مِن كَفِّهِ طَبعٌ بِغَيرِ تَطَبُّعِ",0,"ع",1,0],["إلا شجيج أصابته مُنَقِّلة","لا عَقل فيها ولا المشجوج يمتثل",1,"ل",1,1],["إِلّا شِراعاً ضَلَّ أَو","فُلكاً يُقاسي العَطَبا",2,"ب",2,0],["أَلّا شَعَرتُ بِرِحلَةِ الأَظعانِ","فَيَكونَ شَأنُهُمُ بِرامَةِ شاني",3,"ن",2,1],["أَلا شافِعٌ عِندَ الخَليفَةِ يَشفَعُ","فَيَدفَعَ عَنّا شَرَّ ما يُتَوَقَّعُ",4,"ع",1,1],["إلّا شميماً كان هَمّاً سُكْرُهُ","وغناؤهُ في مسمعي نياحا",5,"ح",2,0],["أَلا شَفَّ صَدرِيَ عَن سِرِّهِ","كَما شَفَّ عَن وَجهِهِ سَجفُهُ",6,"ف",2,0],["إِلّا شَبيهاً بِهِنَّ في وَضَحِ ال","جيدِ وَحُسنِ العُيونِ وَاللَعَسِ",7,"س",1,0],["إلا شباباً من الأحرار نزعتهم","إلى التقدم لا يثنيهم الملل",8,"ل",1,0],["إلا شقيَّين هذا طار مرتحلاً","وَذا أقام طَريداً للشواهين",9,"ن",1,0],["ألا شباباً أولى عزم ومعرفة","فَهؤلاء لفجر المجد عنوان",10,"ن",1,0],["إلا شبابا ناهضين إلى العلى","يتطلبون المجد غير نيام",11,"م",1,0],["الإِشتِراكِيّونَ أَنتَ إِمامُهُم","لَولا دَعاوى القَومِ وَالغُلَواءُ",12,"ا",2,0],["الا شجيا عقيب الظعن يندبهم","ومقلة أوقفت دمعا على الطلل",13,"ل",1,0],["الاشدا في أنفس أبية","يصبرها على مقاساة الشدا",14,"ا",1,0],["ألا شعلةٌ من هذه الروحِ تنجلى","على وطن ريانَ بالذُّل مُفْعَم",15,"م",1,0],["ألا شرفٌ يَرحَمُ المُشرفيّ","مِمّا بِهِ مِن شَمات الوَتينِ",16,"ن",1,0],["إلا شجى الذكرى وغص","ات التلفت والحنين",17,"ن",1,0],["ألا شلّت يمِينك يا صلاحُ دين","وأنت له فسادٌ لاصلاحُ",18,"ح",1,0],["الأشرف ابن الناصر","ابن الأفضل بن الأكبرمين الصيد",19,"د",1,0],["الأشرفُ الملك بن الناصر الملك اب","ن الأشرف الملك ابن الأفضل الفضلا",20,"ل",2,0],["الاشرف الملك ابن الناصر الملك ابن","الاشرف الملك ابن المعدم النظرا",21,"ر",2,0],["الاشرف الملك من ما في الملوك له","ند بعد مقالا غير مختلق",22,"ق",1,0],["الأشرف الملك الذي قاد الورى","قود الكماة الخيل بالارسان",23,"ن",1,0],["أَلا شَقِيَت قَومي لَقَد غالَها الرَدى","بِمقدامِ غاراتٍ وَفَلّالِ أَقرانِ",24,"ن",1,0],["ألاشتراك انتهى يا بئس ما زعمت","رسالة جدّدت في الصبح أوصابي",25,"ي",1,0],["الاشغفت بخير الخلق من مضر","مولى القَريقين قحطان وَعَدنان",26,"ن",1,0],["أَلا شَدَّ ما أَسقَت يَداكَ فَأَنبَتَت","غُصونَ قَناً وَالهامُ فيهِنَّ كَالثَمْرِ",27,"ر",1,0],["ألا شغف الفؤاد بحب ليلى","الشريفة لا بليلى الأخيليه",28,"ي",2,1],["الأشرفين هِمما والأكرمي","نَ أيدياً والأكثرينا مِننَا",29,"ن",2,0],["الأَشْرفُ القاضي الذي شَرُفَتْ به","أَسْلافُه وعلا القبَائِلَ شَعْبُها",30,"ب",3,0],["أَلا شَدَّ ما قَد أَصغَرَت مِن مَقامِنا","وَما اِقتَحَمَتنا في الغُزاةِ لِحينِها",31,"ن",3,0],["ألا شفيت علّتي","من العداة بالتي",32,"ي",1,1],["الأَشرَفِ الملكِ بنِ الأَفضَلِ بِن عَلي","يِ بنِ المؤيِّدِ حامي المُلكِ داودُ",33,"د",1,0],["الأَشعَري الّذي أَسياف حجّته","سُلّت عَلى زيغِ أَهلِ الزّيغِ وَاِقتضبَت",34,"ت",1,0],["ألاشرف السنى الأعز المرتجىء","الأعظم الأسمى النبي المرسل",35,"ل",1,0],["الاشجار لو تَنْطِق بَدتك بْسلامات","وتحدّثِت عن زايد اللي رعاها",36,"ا",3,0],["إلا شعرت بأني لامس شررا","للِه يوماً به يممتُ معهدها",37,"ه",2,0],["الاشارات التي ابرزها","غوثنا المهدي محت عنا القتاما",38,"م",2,0],["الأشرف بن العادل الماضي على","عادِي صروف الدهر أيّ مضاء",39,"ا",2,0],["الأشرف الشادويّ المعتلي شرفاً","ينحطّ كيوان عن أدنى مراقيها",40,"ي",3,0],["الأشرف الملك المأمول نائله","وخير من أسبغ النعمى على الأمم",41,"م",1,0],["إلا شهادة واثقٍ","بالله عن صفو اعتقادي",42,"د",2,0],["ألا شعاعٌ هادٍ عواطفنا","هداية العينِ في الدجى العُصُبِ",43,"ب",1,0],["ألا شافعٌ لي إلى مالكٍ","عزيز على مهجتي مقتدر",44,"ر",1,0],["(الإشتراكية) السمحاء مذهبه","في الحكم لو لم تطل فيها الأقاويل",45,"ل",1,0],["ألا شُلَّتا كفاك يَا بحر أن تكن","دعتْك حَزاراتُ الفؤادِ أَو الأسر",46,"ر",1,0],["ألا شدَّ ما جار البلى يا صبابتي","عليك فكيف استلَّ تلك المعانيا",47,"ي",2,0],["الأشْرَفُ المَلِكُ الوَهَّابُ مُبْتَدِئاً","شُمَّ الأُنوفِ بِما فِيها مِنَ النِّعَمِ",48,"م",1,0],["الأشْرَفِ المَلِكِ الّذي سادَ الْوَرَى","كَهْلاً وَمُكْتَمِلَ الشَّبابِ وَمُرْضَعا",49,"ع",2,0],["الأشْرَفُ الطَّلْقُ النَّدى","شَاهَ ارْمَنٍ موسى الْمُظَفَّرْ",50,"ر",1,0],["الأشرَفُ الواهِبُ الآلافَ مُبْتَسِماً","وَذاكَ تَعْجَزُ عَنُْه عَبْسَةُ السُّحُبِ",51,"ب",1,0],["الأشْرَفِ المَلِكِ الّذي صَلَحَتْ لَهُ الدُّ","نْيا وَيَعْظُمُ أَنْ أَقُولَ لَهُ صَلَحْ",52,"ح",1,0],["الأشْرَفِ المَلِكِ الَّذي عَن بَحْرِهِ","كُلُّ الأنامِ مُحَدِّثٌ بِعَجائِبِ",53,"ب",1,0],["الاشرف ابن الافضل الغساني","ومات بالتحقيق والبيان",54,"ن",1,0],["ألا شمِّروا لله في نَصْرِ دِينكِمْ","لعلَّ شعاعَ الحقِّ والدينِ يَسْطَعُ",55,"ع",1,0],["الاشرار تِصحَب ناس أشرار مِنهم","وتِلقى خيار الناس تِصحَب أمثالها",56,"ل",3,0],["إلا شريعة تلمود اليهود فقد","أباحتِ القتل والتقتيل كيفََ وما",57,"م",2,0],["الا شافوا من القيفان وافي","اشوف اسنانهم زن زن ززنّا",58,"ن",2,0],["أَلا شَدَّ ما ضنّتْ بمعروفها سُعدَي","فما أبرمتْ عَقداً ولا أنجزتٍ وعدا",59,"د",2,1],["ألا شدى رحالك فارقينا","سيبقى ما فعلتِ بنا قرونا",60,"ن",2,0],["ألا شفيعٌ لنا عنا يخاطبُكم؟","جفَّ اليراعُ ولم نُكملْ حكايانا !!",61,"ن",2,0],["الاشقاء تلاقوا بعدما","جرعوا الفرقة ظلما وسفاها",62,"ا",3,0],["الاشقاء تلاقوا موكبا","من جموع وحد الله خطاها",62,"ا",3,0],["إلا شوارد إن أوشكت تدركها","تنافرت فاستحالت بالهنا تعبا",63,"ب",2,0],["ألا شل رب الحق كفي يراعة","تراعي لنا ما أورثوا الحق أسقاما",64,"م",2,0],["ألا شلت يدا باغ أثيم","أشاع الرعب فى بيت السلام",65,"م",1,0],["الأشداء على إخوانهم","وعلى الأغيار قومٌ رحما",66,"م",2,0],["الإشباع جوع نكرات","سفكت في البلاد تلك الدماء",67,"ا",2,0],["الإشاره عينها ....! يم وجه ٍ للمصير.","والبصير اللي عيون الاشاره تفهمه.",68,"م",2,0],["الأشرف المنصور حد","ث عن علاه ولا فرق",69,"ق",1,0],["ألا شدّوا العزائم يا لَقومي","لندحر عن حمانا المعتدينا",70,"ن",2,0],["الأشرس الأدهى يسود بوقتنا","عوضاً عنِ الفادي الودودِ الرَّاحمِ",71,"م",1,0],["أَلَا شَتَّانَ بَينَ هَوانِ قَلبٍ","وَ مَا بَينَ الهَوَى - يَا صَاحِ - شَتَّى",72,"ت",2,0],["الأَشجار تورق ثم تينع ثمارها","وَيؤكل جناها في لَذيذ حَلاه",73,"ا",2,0]]}