{"poems":[[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[37,"إلا شجيج أصابته منقلة","https://www.aldiwan.net/poem7392.html","البسيط"],[85,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[45,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[49,"ألا شافع عند الخليفة يشفع","https://www.aldiwan.net/poem64233.html","الكامل"],[80,"يا رب مجلس لذة شاهدتها","https://www.aldiwan.net/poem31524.html","الكامل"],[74,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[48,"هل لديار حييتها درس","https://www.aldiwan.net/poem64333.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85507","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[78,"كذا يهلِكُ السَّيفُ في جفنِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87626&r=&rc=172",""]],"verses":[["الأَشرَفِ المَلكِ الَّذي بَذلُ النَدى","مِن كَفِّهِ طَبعٌ بِغَيرِ تَطَبُّعِ",0,"ع",1,0],["إلا شجيج أصابته مُنَقِّلة","لا عَقل فيها ولا المشجوج يمتثل",1,"ل",1,1],["إِلّا شِراعاً ضَلَّ أَو","فُلكاً يُقاسي العَطَبا",2,"ب",2,0],["أَلّا شَعَرتُ بِرِحلَةِ الأَظعانِ","فَيَكونَ شَأنُهُمُ بِرامَةِ شاني",3,"ي",1,1],["أَلا شافِعٌ عِندَ الخَليفَةِ يَشفَعُ","فَيَدفَعَ عَنّا شَرَّ ما يُتَوَقَّعُ",4,"ع",1,1],["إلّا شميماً كان هَمّاً سُكْرُهُ","وغناؤهُ في مسمعي نياحا",5,"ح",2,0],["أَلا شَفَّ صَدرِيَ عَن سِرِّهِ","كَما شَفَّ عَن وَجهِهِ سَجفُهُ",6,"ف",2,0],["إِلّا شَبيهاً بِهِنَّ في وَضَحِ ال","جيدِ وَحُسنِ العُيونِ وَاللَعَسِ",7,"س",1,0],["إلا شباباً من الأحرار نزعتهم","إلى التقدم لا يثنيهم الملل",8,"ل",1,0],["إلا شقيَّين هذا طار مرتحلاً","وَذا أقام طَريداً للشواهين",9,"ن",1,0],["ألا شباباً أولى عزم ومعرفة","فَهؤلاء لفجر المجد عنوان",10,"ن",1,0],["إلا شبابا ناهضين إلى العلى","يتطلبون المجد غير نيام",11,"م",1,0],["الإِشتِراكِيّونَ أَنتَ إِمامُهُم","لَولا دَعاوى القَومِ وَالغُلَواءُ",12,"ا",2,0],["ألا شعلةٌ من هذه الروحِ تنجلى","على وطن ريانَ بالذُّل مُفْعَم",13,"م",1,0],["ألا شرفٌ يَرحَمُ المُشرفيّ","مِمّا بِهِ مِن شَمات الوَتينِ",14,"ن",1,0]]}