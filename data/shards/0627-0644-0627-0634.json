{"poems":[[73,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[39,"إلا شجيج أصابته منقلة","https://www.aldiwan.net/poem7392.html","البسيط"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[47,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[51,"ألا شافع عند الخليفة يشفع","https://www.aldiwan.net/poem64233.html","الكامل"],[82,"يا رب مجلس لذة شاهدتها","https://www.aldiwan.net/poem31524.html","الكامل"],[76,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[50,"هل لديار حييتها درس","https://www.aldiwan.net/poem64333.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85507","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[92,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[80,"كذا يهلِكُ السَّيفُ في جفنِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87626&r=&rc=172",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[164,"أراني الله رأسك يا صلاح","https://www.aldiwan.net/poem58709.html","البسيط"],[164,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[164,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[164,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[164,"هز الغرام معاقد التيجان","https://www.aldiwan.net/poem59100.html","الكامل"],[173,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[215,"مضت أسابيع والهتاف محتجب","https://www.aldiwan.net/poem46764.html","البسيط"],[275,"أمن تذكر أهل البان والبان","https://www.aldiwan.net/poem52124.html","البسيط"],[370,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[445,"ألا شغف الفؤاد بحب ليلى","https://www.aldiwan.net/poem14328.html","الوافر"],[461,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[578,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"]],"verses":[["الأَشرَفِ المَلكِ الَّذي بَذلُ النَدى","مِن كَفِّهِ طَبعٌ بِغَيرِ تَطَبُّعِ",0,"ع",1,0],["إلا شجيج أصابته مُنَقِّلة","لا عَقل فيها ولا المشجوج يمتثل",1,"ل",1,1],["إِلّا شِراعاً ضَلَّ أَو","فُلكاً يُقاسي العَطَبا",2,"ب",2,0],["أَلّا شَعَرتُ بِرِحلَةِ الأَظعانِ","فَيَكونَ شَأنُهُمُ بِرامَةِ شاني",3,"ن",2,1],["أَلا شافِعٌ عِندَ الخَليفَةِ يَشفَعُ","فَيَدفَعَ عَنّا شَرَّ ما يُتَوَقَّعُ",4,"ع",1,1],["إلّا شميماً كان هَمّاً سُكْرُهُ","وغناؤهُ في مسمعي نياحا",5,"ح",2,0],["أَلا شَفَّ صَدرِيَ عَن سِرِّهِ","كَما شَفَّ عَن وَجهِهِ سَجفُهُ",6,"ف",2,0],["إِلّا شَبيهاً بِهِنَّ في وَضَحِ ال","جيدِ وَحُسنِ العُيونِ وَاللَعَسِ",7,"س",1,0],["إلا شباباً من الأحرار نزعتهم","إلى التقدم لا يثنيهم الملل",8,"ل",1,0],["إلا شقيَّين هذا طار مرتحلاً","وَذا أقام طَريداً للشواهين",9,"ن",1,0],["ألا شباباً أولى عزم ومعرفة","فَهؤلاء لفجر المجد عنوان",10,"ن",1,0],["إلا شبابا ناهضين إلى العلى","يتطلبون المجد غير نيام",11,"م",1,0],["الإِشتِراكِيّونَ أَنتَ إِمامُهُم","لَولا دَعاوى القَومِ وَالغُلَواءُ",12,"ا",2,0],["الا شجيا عقيب الظعن يندبهم","ومقلة أوقفت دمعا على الطلل",13,"ل",1,0],["الاشدا في أنفس أبية","يصبرها على مقاساة الشدا",14,"ا",1,0],["ألا شعلةٌ من هذه الروحِ تنجلى","على وطن ريانَ بالذُّل مُفْعَم",15,"م",1,0],["ألا شرفٌ يَرحَمُ المُشرفيّ","مِمّا بِهِ مِن شَمات الوَتينِ",16,"ن",1,0],["إلا شجى الذكرى وغص","ات التلفت والحنين",17,"ن",1,0],["ألا شلّت يمِينك يا صلاحُ دين","وأنت له فسادٌ لاصلاحُ",18,"ح",1,0],["الأشرف ابن الناصر","ابن الأفضل بن الأكبرمين الصيد",19,"د",1,0],["الأشرفُ الملك بن الناصر الملك اب","ن الأشرف الملك ابن الأفضل الفضلا",20,"ل",2,0],["الاشرف الملك ابن الناصر الملك ابن","الاشرف الملك ابن المعدم النظرا",21,"ر",2,0],["الاشرف الملك من ما في الملوك له","ند بعد مقالا غير مختلق",22,"ق",1,0],["الأشرف الملك الذي قاد الورى","قود الكماة الخيل بالارسان",23,"ن",1,0],["أَلا شَقِيَت قَومي لَقَد غالَها الرَدى","بِمقدامِ غاراتٍ وَفَلّالِ أَقرانِ",24,"ن",1,0],["ألاشتراك انتهى يا بئس ما زعمت","رسالة جدّدت في الصبح أوصابي",25,"ي",1,0],["الاشغفت بخير الخلق من مضر","مولى القَريقين قحطان وَعَدنان",26,"ن",1,0],["أَلا شَدَّ ما أَسقَت يَداكَ فَأَنبَتَت","غُصونَ قَناً وَالهامُ فيهِنَّ كَالثَمْرِ",27,"ر",1,0],["ألا شغف الفؤاد بحب ليلى","الشريفة لا بليلى الأخيليه",28,"ي",2,1],["الأشرفين هِمما والأكرمي","نَ أيدياً والأكثرينا مِننَا",29,"ن",2,0],["الأَشْرفُ القاضي الذي شَرُفَتْ به","أَسْلافُه وعلا القبَائِلَ شَعْبُها",30,"ب",3,0]]}