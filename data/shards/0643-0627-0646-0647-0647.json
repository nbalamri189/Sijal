{"poems":[[52,"يا ويح حماد أمن نظرة","https://www.aldiwan.net/poem64803.html","السريع"],[52,"يا ويح حمادٍ أمن نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=19934",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27918","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121720","السريع"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119681","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81710","البسيط"],[4759,"من يهدني عرشها؟","https://www.poetsgate.com/ViewPoem.aspx?id=204019",""],[5596,"اسلمت قلبي الى من ظل يذكيه","https://www.poetsgate.com/ViewPoem.aspx?id=206481",""],[5812,"قهر","https://www.poetsgate.com/ViewPoem.aspx?id=114118",""],[2220,"إني أرى إبلاً يقتادُها رجلٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11242&r=&rc=116",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""]],"verses":[["كَأَنَّهُ هاروتُ يَومَ اِغتَدى","يُديرُ عَينَيهِ بِتَقليبِ",0,"ب",1,0],["كأنهُ هاروتُ يوم اغتدا","يُديرُ عيْنيْه بتقْليب",1,"ب",1,0],["كإنه هو الغفور قد فصل","وعن أولي البصرة ما له محل",2,"ل",1,0],["كأنه هو في المعنى وصورته","ولم أجد فارقاً بين العلامات",3,"ت",1,0],["كأنه هَمْزَةُ وَصْلٍ بهِ","يُرْسَم في الخَطِّ ولا يُذْكَرُ",4,"ر",1,0],["كأنه هو نضوٌ من مفارقةٍ","غصنٌ أغارت عليه ريح إعصار",5,"ر",1,0],["كأَنَّه هاصرُ من رُمْحه فَنناً","ومن صدا درعِهِ مستنشقٌ فَنَعا",6,"ع",2,0],["كأنه هو!!! لكن من أتاك به؟","والوقت باعدنا ما قلت: يدنيني",7,"ن",2,0],["كأنه هو موسى في هدايته","أنى التقينا وأني منه في التيه",8,"ي",2,0],["كأنه هارب من نفسه","كأنه هارب منه الطريق",9,"ق",1,0],["كأنَّه هوَ في المعنى وصرتِهِ","ولمْ أجدْ فارقاً بينَ العاملاتِ",10,"ت",1,0],["كَأَنَّهُ هَذَرٌ لمُ يُبْقِ آصِرَةٍ","لَهُ مَعَ الشِّعْرِ لا صَحْباً ولا جَارا",11,"ر",2,0]]}