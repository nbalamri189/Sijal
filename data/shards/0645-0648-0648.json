{"poems":[[566,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[2072,"","https://poetry.dctabudhabi.ae/diwan/poem/145248","السريع"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59516","الوافر"],[5573,"ملامح روح","https://www.poetsgate.com/ViewPoem.aspx?id=200350",""]],"verses":[["مُؤَوّياً إِن هَمَّ أَن يُؤوِّبا","كَما دَعا الغَيثُ الجَرادَ المُجدِبا",0,"ب",2,0],["مؤونة الغسل بها جمة","وأعظم الرزء كرا المحفشه",1,"ه",1,1],["مؤور الضّبع درفْسةٍ هجانٍ","ترضُّ حصى القَرادِدِ والحُزونِ",2,"ن",1,0],["مووايل تاخذنا تودي طريق البوح","اسامي ترددها على البحر يا ملاح",3,"ح",1,0]]}