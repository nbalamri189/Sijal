 لعينِ الحكمِ والذاتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11233&r=&rc=107",""]],"verses":[["بِمِثلِهِ أَبغي العُلى وَأَغتَدي","أَوَّلَ نَزّالٍ إِلى النَوازِلِ",0,"ل",1,0],["بِمِثلِ بَقائِكَ غَيثَ الأَنا","مِ يَرضى عَنِ الزَمَنِ العاتِبُ",1,"ب",1,0],["بِمِثلِهِمُ غَداةَ الرَو","عِ يَجلو العِزَّ وَالكَرَما",2,"م",2,0],["بِمثقلةٍ حَملاً إِذا ما بَناتُها","مَرَتها أَعارَتها الغَواني نُهودَها",3,"د",3,0],["بمثل القطر يثرى","تجارةً وصناعه",4,"ع",2,0],["بمثله الشعب ينمي","أمصاره وضياعه",4,"ع",2,0],["بِمِثْلِهِ تُقْشَعُ عَنْ أُمَّةٍ","غَيَاهِبُ المُسْتَقْبَلِ المُظْلِمِ",5,"م",1,0],["بِمِثلِ السُكارَى هَتَكوا عَن نِطافِهِ","غِشَاءَ الصَرى عَن مَنهَلٍ جَالُهُ حَفرُ",6,"ر",1,0],["بمثله في البلاد قاطبةً","يُشفى عَقُور الزمان من كَلَبه",7,"ب",2,0],["بِمِثلِهِم يُجبَهُ المُناطِحُ ذو العِز","زِ وَيُعطي المُحافِظُ الجَنَبا",8,"ب",2,0],["بمثله يفخر الملك العقيم على","ماضٍ وأن النسا عن مثله عقم",9,"م",1,0],["بمثل ظنك هذا يا أبا حسن","أمِنتَ كل مُمَرِّ المتن غرناق",10,"ق",1,0],["بمثلك فَلْتَرْم الملوكُ ثغورَها","فما جانبٌ يُولَى بمثلك أثلمُ",11,"م",1,0],["بِمِثلِها تُقطَعُ المَوماة عَن عُرُضٍ","إِذا تَبَغَّمَ في ظَلمائِهِ البومُ",12,"م",1,1],["بِمِثلِ لِقائِها شُفِيَ الغَليلُ","غَداةَ تَزايَلَت تِلكَ الحُمولُ",13,"ل",1,1],["بِمِثلِ سُيوفِ الهِندِ إِذ وَقَعَت وَقَد","كَسا الأَرضَ باقي لَيلَها المُتَجَوِّبِ",14,"ب",1,0],["بِمِثلِ أَبيهِ حينَ مَرَّت لِداتُهُ","لِخَمسينَ قُل في جُرأَةٍ وَتَمامِ",15,"م",1,0],["بمُثَقَّفاتٍ يُحتَمَلْنَ وقَد","حملَتْ نُجوماً في الوَغى زُهرا",16,"ر",2,0],["بِمِثْلِهِمْ يَضَعُ التِّيجَانَ لابِسُهَا","وَيَخْجَلُ اللَيْثُ أن يَسْتَكْثِرَ اللِّبَدَا",17,"د",2,0],["بمثل زأر الهصورِ جَزْلاً","أو كَبُغامِ الغزال حُلوا",18,"و",2,0],["بِمُثنٍ سِوى عُرفٍ عَلَيها فَمُشمِتٍ","عُداةً بِها حَولي شُهوداً وَغُيَّبا",19,"ب",2,0],["بِمِثلِ عُلاكَ مِن مَلِكٍ حَسيبِ","عَدَلتُ إِلى المَديحِ عَنِ النَسيبِ",20,"ب",1,1],["بِمُثنٍ سِوى عُرفٍ عَلَيها وَمُشمِتٍ","وُشاةٌ بِها كانوا شُهوداً وَغُيَّبا",21,"ب",2,0],["بِمِثلَ ما صَنَعا تَنجو الشُعوبُ إِذا","حُمَّ القَضاءُ وَتَحمي حَوضَها الدُوَلُ",22,"ل",1,0],["بِمِثلِكُما تَعلو الدِيارُ وَتَسعَدُ","وَتَدنو لَها الآمالُ مِن حَيثُ تَبعُدُ",23,"د",1,1],["بِمِثلِ ثَنائِكَ يَخلو القَريض","وَتَستَبحِرُ الأَلسُنُ المادِحَه",24,"ح",2,0],["بِمُثنٍ سِوى عُرفٍ عَلَيها وَمُشمِتٍ","وَشاةً بِها حَولي شُهُوداً وَغُيَّبا",25,"ب",2,0],["بِمِثلِ الحَنِيِّ بَراها الكَلالُ","يَنزِعنَ آلاً وَيَركُضنَ آلا",26,"ل",2,0],["بِمِثلِ هَذا طَلَبوا الرِياسَه","وَلِلحَميرِ مِنهُ أَضحَوا ساسَه",27,"ه",1,0],["بِمِثلِها أَعطى الفَتى مالَهُ","وَمالُ ذي الوَفرِ مَعاشٌ وَصيتُ",28,"ت",1,0],["بِمِثلِها يُجتازُ في مِثلِهِ","إِن جَدَّ جَدَّت ثُمَّ لَم تَلعَبِ",29,"ب",1,0],["بمثل هَذا السيل في","أعمارنا لم نسمع",30,"ع",1,0],["بمثل ما شيعتك يوم الو","داع لم تسمع الشعوب",31,"ب",1,0],["بِمِثْلِهَا تُعْجِبُنِي صَبْوَتِي","وَيَزْدَهِينِي اللَّيْلُ وَالسَّامِرُ",32,"ر",1,0],["بمِثْلِهِمْ يُجْبَهُ المُناطِحُ ذو العِ","زّ وَيُعْطي المُحافِظُ الجَنَبَا",33,"ب",2,0],["بمثل الذي راشت لحاظك للحشا","رماني زماني لا عفا الله عنكما",34,"م",2,0],["بمِثْلِ أبِيهِمْ حِينَ مَرّتْ لِداتُهُ","لخَمْسِينَ قُلْ في جُرْأةٍ وَتَمَامِ",35,"م",1,0],["بِمِثلِ وَجدي عَلَيهِ","ماتَ المُحِبّونَ قَبلي",36,"ل",2,0],["بمِثلها سنقاويكم مباسلة","لكي نرى بعد طولِ المكثِ إِشعابا",37,"ب",2,0],["بِمَثَابَةٍ رَسَخَ الهُدَى أثْنَاءَها","عَلَماً وقَام الحَقُّ فيها مُعْلَما",38,"م",2,0],["بِمِثلِ العِصارِ اِشتَدَّ في يَومِ سَبرَةٍ","جُمادِيَّةٍ مُدني حَجى العَينِ سيقُها",39,"ق",3,0],["بمثلِ هذي ترقى الشعوبُ إِلى","طودٍ من العزِّ والعلى ارتفعا",40,"ع",2,0],["بِمِثل بني المولى الحسينِ تَفاخَرت","مَنابرُهم في أوجها أنجمٌ زهرُ",41,"ر",1,0],["بِمثلك هزّ الملكُ أَعطافَه عجبا","وَتاهَت بِه الخضرا وباهَت بِه الشهبا",42,"ب",2,1],["بمثلها حبرا وفر بشكري","من بين نظم حسن ونشر",43,"ر",1,0],["بِمِثلِكَ عِندَ شَبابِ الزَما","نِ كانَت بُطونُ اللَيالي عُقُم",44,"م",1,0],["بِمثل صَنيع الوَزير","يُحسن ضَرب المَثَل",45,"ل",1,0],["بِمثله تُسْتَخرج الفِضّةُ","الْبَيْضاء بل تُسْتَخرجُ الصَّفرا",46,"ر",2,0],["بمثلِ أتِيِّ السّيلِ ضاقَ به الفَضا","وضاقَ على الأعداءِ منهُ المخارمُ",47,"م",1,0],["بمثله كانت الأَيَّام توعدنا","فحانَ ميعاد ذاك الوعد واقتربا",48,"ب",2,0],["بمثقلة بالودق خلَّت بروقها","لوامع نيران تشبُّ وتخمد",49,"د",1,0],["بمثل قضائه فصل القضايا","ومثل خطابه فصل الخطاب",50,"ب",1,0],["بمثالِ طعنٍ فِي الكُلى متتابعٍ","وخيالِ ضَرْبٍ فِي الرِّقَابِ دِرَاكِ",51,"ك",1,0],["بمثوى مسقط طال الثواء","وملت صحبتي فيها النواء",52,"ا",2,1],["بمثقبات من يراعكَ","أو دروعٍ من سخايك",53,"ك",1,0],["بِمُثْْخَن ٍمُستَميتٍ نَحْوَ قِمَّتِه","يَسعى فَيَهوي قَرابينا ً قَرابينا",54,"ن",2,0],["بمثل ما أوتيت من رتبة","وسؤدد فليفخر الفاخر",55,"ر",1,0],["بمثلكُما الشعبُ الفرنسِي مُرِّدٌ","إذا ماتَ منَّا سيدٌ قام سيدُ",56,"د",1,0],["ب مثلنا ستصيرُ","ما الإنس قلب وحيشٌ",57,"ش",1,0],["بِمِثْلِ أَحْدَاقٍ بِلاَ أَجْفَانِ","كَأَنَّهَا جِلْدَةُ أُفْعُوَانِ",58,"ن",1,0],["بِمْثِلِه مِثْلِي بَكَرْ","وَالصُّبْحُ لَمَا يَنْفَجِرْ",59,"ر",1,0],["بمثل ما توكد الإمامة","لما أقامه لهم مقامه",60,"ه",1,0],["بمثل ما ذكرت أن المرسلا","أوصى عليا ثم لما قتلا",60,"ل",2,0],["بمثل هذا لعتيق وانكسر","بحجتي عليه ما كان ذكر",60,"ر",1,0],["بمثل بنيك يا أسمى همام","يفاخر كل ذي نفس ابيه",61,"ي",2,0],["بمثلك الشرق فاق الغرب في أدب","قد عمنا نوره الوصاح منتشرا",62,"ر",2,0],["بمثله قطرنا فوق السماك سما","مجداً وغير حلول الفرقدين أبي",63,"ب",2,0],["بمثل ذا الوصف عبدالله متصف","لذاك أخمدت الاشجان أنفاسي",64,"س",2,0],["بمثل ملك ثابت مؤيد","لما انتحوا قدحاً بزند مصلَد",65,"د",1,0],["بِمِثْلِهِ تَفْخَرُ الأيَّامُ إنْ فَخَرَتْ","وَتَرْتَدِي بِرِدَاءٍ مِنْهُ مَنْشُورِ",66,"ر",1,0],["بِمِثلِ ذا أَمكَنَني إِفسادي","لِأَنفُسِ العِبّادِ وَالزُهّادِ",67,"د",1,0],["بِمِثلكَ العيدُ قَد أَضحى لَنا عيدا","مِن أَجلِ ذَلكَ هَنَّأْنا بِكَ العيدا",68,"د",2,1],["بِمِثلِهِ نالَ فَخراً مثل والِدِهِ","وَفَخرُ وَالِدِه الذّاتي بِلا مثلِ",69,"ل",1,0],["بِمِثلِهِ كُنتُ أَعلو الخَيلَ إِذ رُكِبَت","إِذِ الجِيادُ كَسا فُرسانَها الرَهَجُ",70,"ج",1,0],["بِمثوى غريبٍ ليس مِنّا مَزَارُهُ","قريباً ولا ذُو الوُدّ مِنّا يُواصله",71,"ل",2,0],["بمثل ندى أبي الفرج المرجَّى","خليل السؤدد الدمث الخلالِ",72,"ل",1,0],["بِمثْلِ القطاميّ مستقبلاً","إذا جُلْتُ في مَنْكبيهِ استَحَالا",73,"ل",2,0],["بمِثلِهِ تُطلَبُ الحاجاتُ إِن شَحَطَت","دارٌ به أَو أُسِلى الهمَّ إِن نَزَلاَ",74,"ل",2,0],["بِمُثيرٍ غَرامَ مِثلي إِذا ما","جالَ طَرفٌ بِساحَتي وَجَنابي",75,"ب",2,0],["بمثل هام الرِجال من فلق الص","خر يزود المقلاع بائرها",76,"ر",3,0],["بمثل مقال الأمس يعجب كاتب","أديب ويرضى عاقل وحكيم",77,"م",1,1],["بمثلها ليس يرضي","يشفي الفؤاد انتقاماً",78,"م",2,0],["بمثل عصاه شق البحر موسى","ولحظك بالهوى شق القلوبا",79,"ب",2,0],["بِمِثلِهِما نَروحُ نُريدُ لَهواً","وَيَقضي حاجَةَ الرَجُلِ الرَجيلُ",80,"ل",1,0],["بمثله حق على المغرم","مزج مصون دمعه بالدم",81,"م",1,1],["بمثله للمعالي حقت البشر","من كوكب نجلته الشمس والقمر",82,"ر",1,1],["بَمثنَى جِفانٍ كالجَوابِ مُنيخَةٍ","مُلِئنَ عَبِيطاتِ السّنَامِ المَرعَّبِ",83,"ب",1,0],["بمثل ذا باد بنو وائل","كليبها طاح وجساسها",84,"س",3,0],["بمثواه طابت طيبة وتشرفت","بتشريفه حتى أغتدت للورى قصدا",85,"د",2,0],["بِمثلي فَاِشهَدِ النَجوى وَعالِن","بِيَ الأَعداءَ وَالقَومَ الغِضابا",86,"ب",2,0],["بمثلِ ذا أثبت البرهان جبرهمُ","فلا اختيارٌ لهم من غير تتميم",87,"م",1,0],["بمثله إن تكن دعواك صادقةٌ","وإن عجزتُ فذاك العجز من ذاتي",88,"ت",2,0],["بمثله تصلح الأحكام حيث له","بها اختبار لطرق العدل يرشده",89,"د",2,0],["بمثلك عصرنا يسمو وتحظى","بنوه من النجاح بخير قسمه",90,"م",2,0],["بمثلِ حُسنِيَ الاطرفِ الأظرفِ","يُخدَمُ بيتُ المَلِكِ الأشرفِ",91,"ف",1,1],["بِمَثوىً حَرامٍ والمَطيُّ كأَنَّهُ","قَناً مُسنَدٌ هَبَّت لَهُنَّ خَريقُ",92,"ق",1,0],["بِمِثلِهِمُ تُلاقي يَومَ هيجا","إِذا لاقَيتَ بَأساً أَو خُصوما",93,"م",2,0],["بمثله الحيا للعين عينا","ويثبته الثنا في القلب وصفا",94,"ف",2,0],["بمثله نماء كرام سادة نجب","شم الأنوف بها ليل غطاريف",95,"ف",1,0],["بمثل ظهر الترس لا ترى به","مأوى ولا تسمع للوحش زجل",96,"ل",1,0],["بمثلك ضن الدهر والدهر باخل","ومجدك ما فوق السماكين نازلُ",97,"ل",1,1],["بمِثلِهَا تُمتَحنُ الرجال","لو لم يكن إلاّ لذا السؤال",98,"ل",1,0],["بمثلك ان يوجد تهنى الوظائف","وتبتهج العليا وتسمو المعارف",99,"ف",1,1],["بمثلك فلتلهج أُلو الصبر دائماً","كأَيوبَ فيما مَرَّ من سالف العَصرِ",100,"ر",1,0]