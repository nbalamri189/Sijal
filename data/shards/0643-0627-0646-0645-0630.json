{"poems":[[47,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[78,"تحف به جنات دنيا تعطفت","https://www.aldiwan.net/poem39035.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48320","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48277","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111455","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76758","الطويل"]],"verses":[["كَأَنَّ مَذهَبَهُ في الحَمدِ مِن مِقَةٍ","لَهُ وَمَيلٍ إِلَيهِ مَذهَبي فيهِ",0,"ي",2,0],["كأنَّ مذاق الطعمِ مِنها وطعمُها","لِثاتُ عذارى ريقُها الشَّهدُ أو أَحلى",1,"ل",2,0],["كانَ مُذ قامَت نُعاتُكَ بي","صَمَم حَتّى هَدى الصَمدُ",2,"د",1,0],["كأنم ذاك السواد الجون مرتفعاً","سحمٌ من الطير حطت فوق أشجار",3,"ر",1,0],["كأنَّ مذاكيها لدى الحرْبِ ترتَمي","ظِباءً على كُثْبانِ رامةَ تسْنَحُ",4,"ح",1,0],["كأنّ مَذاكِي يوسفٍ يوْمَ حرْبِهِ","سَفائِنُ في بَحْرِ النّجيعِ سوابِحُ",5,"ح",1,0],["كأَنَّ مَذاري ذِيمتِيرَ بِبَيدَرٍ","تُثِيرُ سَحِيقَ التِّبنِ والحَبُّ يَرسُبُ",6,"ب",1,0],["كأنّ مذاقيه ليانا وشدة","حلاوة شهد في مرارة علقم",7,"م",1,0]]}