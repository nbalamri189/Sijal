{"poems":[[88,"رجعت لنفسي فاتهمت حصاتي","https://www.aldiwan.net/poem10924.html","الطويل"],[53,"وأشهد ما يكون عل هجاء","https://www.aldiwan.net/poem66727.html","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59793","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108956","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74104","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85243","الطويل"],[5284,"حكايةُ عاشقَين","https://www.poetsgate.com/ViewPoem.aspx?id=190603",""],[5443,"قلوب الأنقياء","https://www.poetsgate.com/ViewPoem.aspx?id=185142",""],[5660,"شَرِبتُ العِشقَ في الأَرحامِ صَفواً","https://www.poetsgate.com/ViewPoem.aspx?id=23799",""],[5747,"دهاليز الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=61678",""]],"verses":[["أَيَهجُرُني قَومي عَفا اللَهُ عَنهُمُ","إِلى لُغَةٍ لَم تَتَّصِلِ بِرُواةِ",0,"ه",1,0],["أيهجو المرءُ من يُضحي ويمسي","ورَوحُ حياته فيما يليه",1,"ي",2,0],["أيهجرني ظلماً لأني أحبهُ","ويقتلني عمداً على غير ما ذنب",2,"ب",1,1],["أيهجو ذات ألحاظ إذا ما","رآها الظبي قال أنا أخوها",3,"و",3,0],["أَيَهجَعُ منّي الجفنُ وَالجفنُ ساهِر","وَينقصُ منّي الوَجدُ وَالوَجدُ زائِدُ",4,"د",1,0],["إيه جمعٌ لو لم يفرقه صرفٌ","كنت تزهى لو لم يخنك الوفاء",5,"ا",2,0],["أيهجوا إماماً هادياً أرشد الورى","إلى منهج التوحيد فاتضح الرشد",6,"د",1,0],["أَيَهْجُرُنَا لِجَوَّالٍ صَغِيْرٍ","كَغَانِيَةٍ تَمَايَلُ بِانْصِيَاعِ ؟!",7,"ع",1,0],["أَيَهْجُرُنَا زَمَاناً لايُبَالِي","وَيَصْحَبُهُ إِلى كُلِّ البِقَاعِ ؟!",7,"ع",1,0],["أيهجرُ مسلمٌ فينا أخاهُ","سنينًا لا يَمُدُّ له يَمينَهْ",8,"ن",2,0],["أيهجرُه لأجلِ حُطامِ دُنْيا","أيهجرُه علَى نُتَفٍ لعينَهْ",8,"ن",2,0],["أَيَهجُرُني أُصَيحابي لِأَنّي","عَشِقتُكُمُ يَزيدونَ عَذابي",9,"ب",2,0],["ايه جيتك بين ضيق وبين ونه","أستفز الصمت من عذر الكلام",10,"م",1,1]]}