html","مجزوء الكامل"],[392,"الحمدلله ذي الآلاء والنعم","https://www.aldiwan.net/poem54505.html","عموديه"],[394,"مشيب عراه لو يدوم مشيب","https://www.aldiwan.net/poem53654.html","الطويل"],[394,"دمن عفون بذي الأراك","https://www.aldiwan.net/poem53665.html","مجزوء الكامل"],[404,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[404,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[417,"أرأيت مثلي في الهوى","https://www.aldiwan.net/poem53911.html","مجزوء الكامل"],[430,"خطرت تفتر عن الجوهر","https://www.aldiwan.net/poem41404.html","المتدارك"],[430,"يا من يغاث به وينعم بالنجا","https://www.aldiwan.net/poem41434.html","الكامل"],[433,"كان لك الله يا أبا الحسن","https://www.aldiwan.net/poem12329.html","المنسرح"],[449,"يا من أدار بحسنه المعبود","https://www.aldiwan.net/poem53762.html","الكامل"],[454,"إني بريء منك يا بدني","https://www.aldiwan.net/poem61586.html","البسيط"],[459,"يا صاحبي عرجا بي ساعة","https://www.aldiwan.net/poem55815.html","الرجز"],[459,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[459,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[459,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[462,"نكبا صمتي وخافا صخبي","https://www.aldiwan.net/poem15144.html","الرمل"],[480,"يا حادي الشوق يمم دار ماريانو","https://www.aldiwan.net/poem36918.html","البسيط"],[487,"إني بنيت واقماً والضحيانِ","https://www.aldiwan.net/poem477.html",""],[496,"قسما لقد عجم الزمان","https://www.aldiwan.net/poem9819.html","مجزوء الكامل"],[496,"عشرون من عمري تنفيتها","https://www.aldiwan.net/poem10242.html","السريع"],[516,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[530,"يا ناقدا لكلام ليس يفهه","https://www.aldiwan.net/poem37468.html","البسيط"],[537,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[539,"بدت وجوههم كالشمس والقمر","https://www.aldiwan.net/poem48163.html","عموديه"],[539,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[552,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[552,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[559,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[576,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[576,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"],[576,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"]],"verses":[["إِن يَبلَ ثَوبي فَإِنّي أَكتَسي حَسبي","أَو تودَ خَيلي فَإِنّي أَمتَطي مُنَني",0,"ن",2,0],["إِنّي بِها في السَيرِمُقتَرِحٌ","عَجِلاً عَلى الإِقتابِ وَالجُدلِ",1,"ل",1,0],["إنّي بمَدْحِكَ مُغْرًى غيْرُ مُلْتَفِتٍ","إِلى ندىً خَضِلِ الأنْواءِ مَطْلوبِ",2,"ب",1,0],["إِنّي بِحُبِّكِ عَمَّن","ظَنَنتِ بي مَشغولُ",3,"ل",1,0],["إِنّي بِخُبرٍ قُلتُ ذاكَ وَلَن تَرى","أَدرى بِما قَد قالَهُ مِن خابِرِ",4,"ر",1,0],["إِنيّ بُليتُ بِشَخصٍ لَيسَ يُنصِفُني","باغٍ لِقَتلي وَرَبّي مِنهُ لي جارُ",5,"ر",1,0],["إِنّي بُليتُ بِذي لَونَينِ يُظهِرُ لي","مِنهُ هَواهُ فَإِن وافَقتُهُ جَحَدا",6,"د",2,1],["إِن يُبصِروا قَبراً حَديثَ العَهدِ","يُنَبِّشوا فيهِ اِحتِفارَ الخُلدِ",7,"د",1,0],["إِنّي بَصَرتُ الهَوى عَن مُقلَةٍ كُحِلَت","بِالسِحرِ مِنكَ وَخَدٍّ بِالجَمالِ وُشي",8,"ش",2,0],["إِنّي بِحَبلِكَ واصِلٌ حَبلي","وَبِريشِ نَبلِكَ رائِشٌ نَبلي",9,"ل",2,0],["أنيبها في وفاء","عنى أعز إنابه",10,"ب",2,0],["إِنْ يَبْتَغِي إِلاَّ الصَّلاحَ وَبَعْضُهُ","لا تَسْتَوِي فِي فَهْمِهِ الأَحْلامُ",11,"م",1,0],["إِنّي بَنى لي مَن يَزيدُ بِنائُهُ","طولاً وَباعُكَ يا سُراقَ قَصيرُ",12,"ر",1,0],["إِنّي بَنى لي زاخِرٌ مِن خِندِفٍ","لِلمُلكِ فيهِ مَنابِرٌ وَسَريرُ",12,"ر",1,0],["إِنّي بَنى لِيَ في المَكارِمِ أَوَّلي","وَنَفَختَ كيرَكَ في الزَمانِ الأَوَّلِ",13,"ل",1,0],["إِنّي بِبُرقَةِ سُلمانينَ آنَقَني","مِنها غَداةَ بَدَت دَلٌّ وَمُبتَسَمُ",14,"م",1,0],["أنَّى بِنِدِّكَ يا من","لم يخلق اللَّهُ نِدَّهْ",15,"د",2,0],["إني بما شئت من إتقانِ ذي خللٍ","كل الوفاء ومن تقويم ذي ميلِ",16,"ل",1,0],["إنّي بنانِي مَنْ بنى يَذْبُلاً","فليس تسطيعُ يدٌ هَدْمِي",17,"م",2,0],["إِنّي بَلَوتُ الغانِياتِ فَلَم أَجِد","فيهِنَّ قَطُّ مَليحَةً لا تَكذِبُ",18,"ب",1,0],["أَن يُبصِرَ في ضَوءِ القَمَرِ","ما كانَ عَلَيهِ عَلى الطُرُقِ",19,"ق",1,0],["إِنّي بِبابِكَ قَد وَقَف","تُ عَسى تَرُدُّ جَوابِيَه",20,"ي",2,0],["إِنّي بِوِدِّكَ لاعَدِم","تُكَ واثِقٌ في الحالَتَينِ",21,"ن",1,0],["اني بالشر الذي","القى كغيري برم",22,"م",1,0],["اني بشدوك الشجيّ","يا هزار مغرم",23,"م",1,0],["اني بكوني رئبالا لمفتخر","فلا تعيبن اخلاقي واطواري",24,"ر",2,0],["اني به متوسل","ولقد حمدت توسلي",25,"ل",2,0],["إنِّي بِبابِكَ لا وُدِّيْ يُقَرِّبُني","ولا أَبي ولا نَسَبِي",26,"ب",2,1],["إِنّي بِدَولَتِكَ الغَرّاءِ في شَرَفٍ","أَعلو بِذِكرِكَ فَخراً غَيرَ مَردودِ",27,"د",1,0],["إِنّي بَلَوتُ لَهُ خِلالاً لَم يَرُح","في مِثلِ أَصغَرِها الغَمامُ المُسبِلُ",28,"ل",1,0],["إِنّي بِذِمَّةِ مالِكٍ وَبِمُنذِرٍ","بِأَلاكَ مُحتَرِسٌ لِكُلِّ مَحولِ",29,"ل",1,0],["إِنّي بَنى لي دارِمٌ عادِيَّةً","في المَجدِ لَيسَ أَرومُها بِمُزالِ",30,"ل",1,0],["إِنّي بِها وَبِرَأسِ العَينِ مَحضَرُها","وَأَنتَ ناءٍ بِجَنبي رَعنَ مَقرومِ",31,"م",1,0],["إني بحق البصاق معترف","إن كنت بالحق غير معترف",32,"ف",1,1],["إِنّي بِرَبّي واثِقٌ وَبِأَحمَدِ","وَسَبيلُهُ مُتلاحِقٌ بِسَبيلي",33,"ل",2,0],["إني به مترنم وبكل ما از","دانت به تلك الصحيفة شادي",34,"د",2,0],["إنْ يُبْعَثُوا بسُرورٍ مِنْ تملُّكهِ","فَمنْ مَنيّة يحيَى بالأسَى قُبِروا",35,"ر",3,0],["إِنّي بِأَيسَرِ ما أُدنيتُ مَنبَسِطٌ","كَما بِأَيسَرِ ما أُقصيتُ مُنقَبِضُ",36,"ض",1,0],["إِنّي بِشَتمِ اِمرِئٍ أَكدَت خَليقَتُهُ","وَكانَ بِاللُؤمِ مَشهوراً لَمَعذورُ",37,"ر",1,0],["إِن يَبتَكِر تُرشِدهُ أَعلامُ الصُوى","أَو يَسرِ لَيلاً فَالنُجومُ مَنارُ",38,"ر",1,0],["إنْ يبتسمْ لي ضوَّأ الحجونا","وأقبلَ الحجاجُ أجمعونا",39,"ن",2,0],["إني بفعل الله أولُ مؤمنٍ","وبما قضاه النجمُ أولُ كافرِ",40,"ر",1,1],["أَنّى بِقُربِكُمُ أَم كَيفَ لي بِكُمُ","هَيهاتَ ذَلِكَ ما أَمسَت لَنا روحُ",41,"ح",1,0],["إنّي بقومي إن تنكّرَ حَادِثٌ","أو جَلَّ أمرٌ جَامِعٌ لَفخورُ",42,"ر",1,0],["إِن يُبصِروا غِرَّةً لا يُجدِكُم فَزَعٌ","هَل يَرجِعُ الأَمرُ أَعيا بَعدَ إِمكانِ",43,"ن",1,0],["إِن يَبنِ زارعُها الحياةَ لِقَومِهِ","فبكفِّ صانِعها تَمامُ بِنائِها",44,"ا",3,0],["أَنيبي وأَعطي ما سُئِلتِ فاِنَّني","رَسولٌ مِن الرَحمنِ يَأتِيكِ بابنَمِ",45,"م",1,0],["إن يَبخسُوهُ بِكَيْلِ زُورٍ حَقَّهُ","فَلأُوسِعَنَّهُمُ الجزاءَ مَكِيلا",46,"ل",2,0],["إِنّي بَذَلتُ لَها لَمّا بَصُرتُ بِها","صاعاً مِنَ الدُرِّ وَالياقوتِ ما ثُقِبا",47,"ب",2,0],["إني بعاجلِ ما ترين لمؤكل","وسواهُ أرجافٌ من الآثار",48,"ر",1,0],["إِنّي بِما اِحتَمَلَت عَيني حَوائِجَكُم","وَاِستَحلَتِ العَينُ مِنّي دَمعُها جاري",49,"ر",2,0],["إِنّي بَريءٌ إِلَيكُم مِن وِلايَتِهِ","كَما تَبَرَّأَ مِن قَنّاصِهِ الفَرَدُ",50,"د",1,0],["إِنّي بِنَفسي في التُقى لَمُرتاب","وَلا أَشُكُّ في الحِمامِ المُنتاب",51,"ب",1,0],["إِن يَبقَ لا يَهرَم وَإِن يُطرَح إِلى","حَمراءَ موقَدَةٍ فَلَيسَ يُضارُ",52,"ر",1,0],["إني بشدوك الشجي","يِ يا هزار مغرمُ",53,"م",1,0],["إني بحملي إلى بيروت في سفري","شعراً كمستبضع تمراً إلى هجر",54,"ر",1,0],["أني بكيتك بالدموع لأنها","مما تخفف حرقة الأكباد",55,"د",1,0],["إِنّي بحبك يا لَي","لى لا محالة هالِك",56,"ك",1,0],["إنِّي بنيتُ على القديم جديدَهُ","ورفعتُ من بنيانهِ ما هدَّموا",57,"م",3,0],["إِنْ يَبْكِ ثَاكِلُ وُلْدِهِ وَزَجَرْتَهُ","عَنْ نَحْبِهِ أَلْفَيْتَهُ لاَ يَنْحَبُ",58,"ب",1,0],["إِنْ يَبْتَغِي إِلاَّ الصَّلاَ","حَ وَهَلْ عَلَيْهِ فِيهِ عَابُ",59,"ب",1,0],["إني بلَوتُ الدهرَ أعذَبَه","وأمَرَّ ه الروَح والنَصَب",60,"ب",1,0],["أُنيبكَ عن شرِّ الطّغام نكايةً","بالمؤثرينَ ضميرَهمْ والواجبا",61,"ب",2,0],["إنّي بنانِي من بنى يَذْبُلاً","فليس تستطيع يدٌ هَدْمِي",62,"م",2,0],["إِنّي بِدَهماءَ عَزَّ ما أَجِدُ","عاوَدَني مِن حِبابِها زُؤُدُ",63,"د",1,1],["إني بكم لي قلب طار طائره","عليكم وجلال الحب أفناه",64,"ه",1,0],["إني بلا مُهلةٍ أقول في مَهَلٍ","ما لي وما للهوى عني بلا شُغُلِ",65,"ل",1,1],["إنِّي بفضلِ من اللهِ ذو دعةٍ","وذو يساريْن لا الإقتارُ يَعْرُوني",66,"ن",2,1],["إني بِأُمِّ أبَانٍ مُغرَمٌ كَلِفٌ","قَد هَيَّجَ البَينُ مِنهَا بَرحَ أشجَانِ",67,"ن",1,0],["أنيبوا إليه ولو ذوا بهِ","تفوزوا وألقوا إليهِ السلَم",68,"م",1,0],["إِنّي بِذا النُصحِ لَمّا عَنَّ في خَلَدي","كَالخُلدِ دَلَّ عَلى حيسِ الفَلا الأَسَدا",69,"د",2,0],["إِنّي بِرَغمِ عِدايَ مَمنوعُ الحِمى","ما هَزَّ هَذا القَيلَ هَذا القيلُ",70,"ل",1,0],["إني بلوتُ زماني في تقلُّبهِ","فإنْ تَثِقْ بصروفِ الدهرِ لا أَثِقِ",71,"ق",1,0],["اني بمدحك في القيامة لم ازل","ارجو التخلص لي وحسن المطلع",72,"ع",1,0],["إني بحبك مشغول تساورني","أطياف حسنك في أعماق وجداني",73,"ن",2,0],["إنِّي بحبّك ممزوجٌ كما مَزَجَتْ","أيِدي السُّقاة مِزاجَ الماء بالعَسلِ",74,"ل",1,0],["إني بعثت بنفسَجاً نمّت به","ريحٌ كريح المِسكِ ظلّت تُفْتَقُ",75,"ق",1,0],["إني بعثت إليك الزهر ناعمة","تُرضِي من الندماء الشمَّ والنظرا",76,"ر",2,0],["إني بأفعالك قِدْماً أًقْتدي","ولم أَزَلْ أَهدِي بها وأهتدي",77,"د",2,0],["إنِّي بعثتُ طريفاً وهي سُنْبلةٌ","تَمَّتْ فتمّ لرائيها الأعاجيب",78,"ب",1,0],["إنِّي بعثتُ بها إليك وإنها","لَذَواتُ إطراقٍ وذاتُ حَياء",79,"ا",2,0],["إن يبتروا الأطراف تسعى قبلنا","قدماً لجنات النعيم وصولا",80,"ل",2,0],["إني بليت بأقوام مواعدهم","تزيدني فوق ما ألقاه من محنِ",81,"ن",1,1],["إنّي بخدّك مع ثغرٍ ولحظك لي","بين الرياض وبين الكأس والوتر",82,"ر",1,0],["ان يبتلى باللئيم اكرمه","ظلما وعشاقه بلومه",83,"م",2,0],["إِن يبلَ ثوبُك فالنُهى جنَنٌ","أَو تودَ خَيلُك فالعُلى حُصُرُ",84,"ر",1,0],["إِنّي بعفوِكَ واثِقٌ","وَالعَفوُ أَكرمُه مُذالُه",85,"ل",2,0],["أن يبصر الشعراءُ الجنسَ ما لمحوا","إلاّ النساءَ وهم في مدحها الخدمُ",86,"م",1,0],["إنّي بَعَثتك لِلمَكارمِ والندى","بَعثَ البحارِ لمدّ موجٍ زاخرِ",87,"ر",1,0],["إنّي بقولِكَ واثِقٌ","وبصَرْفِ دهريَ غيرُ واثِقْ",88,"ق",1,1],["إِنّي بِحفظ اللَه دُمت أعيذهُ","مِن شَرّ نَظرة حاسد مُتَمرّدِ",89,"د",1,0],["اِنّي بِك صَبّ عَلى الغَرامِ صَبور","لا عاشَ محب شَكا الغَرامَ وَلا كان",90,"ن",1,0],["إنّي بحبلِك بعدَ اللهِ مُعْتَصمٌ","لدى الإقامةِ منّي أو لدَى الظَّعَن",91,"ن",1,0],["إِن يَبقَ فيها بَقايا فَهيَ أَربَعَةٌ","تَنأى فَتُفتَحُ تَستَعصي فَتَنقادُ",92,"د",1,0],["إني بُليت بحب أُغيدَ ساحر","بلحاظه رخص البنان برهره",93,"ه",1,0],["إِنِّي بِكُم ذو ضِنَّةٍ فَاعجَبي","مِن ضِنَّةِ المَقتولِ بِالقاتِلِ",94,"ل",1,0],["إنِّي بِحالٍ لا يَسُر","رُكَ أَن يكونَ بِها صَديقُك",95,"ك",1,0],["إني بدهري دونَ أهل عشيرتي","متمزقٌ متحرقٌ متغرِّق",96,"ق",1,0],["إني بذيلك آخذٌ","مستعصماً مستقربا",97,"ب",2,0],["إِنّي ببابك قائمٌ","عبداً رقيقاً يَخذَأُ",98,"ا",1,0],["إِنّي بدأتُ بِمَدحِكُم","والحُكمُ في مَن يَبدأُ",98,"ا",1,0],["إني بعجزي وتقصيري لمعترف","وبالكبائر موصوف وباللمم",99,"م",1,0],["أُنيبُ وَمدحي فيهِ قَد طبَّق الوَرى","قَصائِد عبّاديَّة سَتُريب",100,"ب",1,0],["اِنّي بِحُبِّ محمَّدٍ","وَوَصِيِّهِ رَهنُ اِمتِساك",101,"ك",1,0],["أن يبيت خالياً من الغرم يوماً","قال هنا واللّه أكبر نعمه",102,"م",2,0],["إني بسفح شهارة","أحظى بوصل واقتراب",103,"ب",1,0],["إنِّي بذلت مدامعي","لمقتّرٍ لي بالعطاء",104,"ا",2,0],["إني بصبابة قيس يا","ليلى ومحياك الأقمر",105,"ر",1,0],["أني ببابك خاضعٌ متذللٌ","وعظيم ذنبي في لظاه تاججا",106,"ج",2,0],["أني بشير في عنايتك التي","انجو بها عند الشدائد والشجا",106,"ج",2,0],["إِني بصرفِ الزَّمانِ مُمْتَحَنٌ","كذلك الحُرُّ مَعْدِنُ المِحَنِ",107,"ن",1,0],["إني بحسنك قد حييت وإنني","سأموت من شوق عليك شديد",108,"د",1,0],["إني بريء منك يا بدني","فلست فيك بحال أيّ مرتهن",109,"ن",1,1],["إني بكنَّ اليومَ صبٌّ مغرمٌ","ذو لوعةٍ ما ينقضِي جَواها",110,"ا",3,0],["أني بقيتُ لهذا الشعر مُذعِنة","آياتُهُ ليَ وحدي أو بدائعُهُ",111,"ع",2,0],["أنيبي غير جازعةٍ فإني","أراها وحشةً ستجرُّ أُنسا",112,"س",2,0],["إني بُليت بمضْطَرٍّ رفيقُهُمُ","والماءُ يملُحُ وقتاً وهو مشروبُ",113,"ب",1,0],["إنْ يُبحْ قولي يوماً أرَبي","فلقد أحْمي بسيفي حسبي",114,"ب",2,0],["إن يبعدوها فاحساسي يصورها","من عالج الشوق لا يعروه نسيان",115,"ن",1,0],["إِنّي بَنَيتُ واقِماً وَالضَحِيّانِ","وَالمُستَظِلُّ قَبلَهُ بِأَزمانِ",116,"ن",1,1],["إنّي بواقية اسمه","أطأ الأساوِد والأُسُودا",117,"د",2,0],["أني بعشرين تصاريف ما","بعد الثمانين تعرفتها",118,"ت",3,0],["إن يبل من ذاك الجبين جماله","فجميله عند الخليقة ما بلي",119,"ل",2,0],["إِنّي بُليتُ بأهْلِ الْجَهلِ في زَمَنٍ","قامُوا بِهِ ورِجالُ الْعِلْمِ قَدْ قَعَدُوا",120,"د",3,0],["أَنيبوا إِلى دينِ النَبِيِّ مُحَمَّدٍ","فَطالِبُ دينِ اللَهِ أَعلى وَأَكيَسُ",121,"س",1,0],["إني بعاصمةِ التَّمدينِ والحَضَرِ","أُمَتِّعُ الطَّرفَ لا بالغُنجِ والحَورِ",122,"ر",1,0],["إنِّي بعَثتُ لِسيّدِي بِكتَابي","لينُوبَ في لَثمِ اليدَينِ مَنَابي",123,"ب",2,1],["إنّي ببُعدِك في بهيمٍ مُظلمٍ","لمّا عدانِي مَن به أستصبحُ",124,"ح",1,0],["إِنْ يَبغِ مَحجوباً فما إنْ له","مِن دونه شيءٌ من الحُجْبِ",125,"ب",1,0],["إني بحبك يا محمد مغرمٌ","أنت البديري بالكمال مصان",126,"ن",1,0],["إِنِّي بِعُرْوتِكَ اعْتَصَمْ","تُ وما لعُرْوَتِكَ انفِصَامُ",127,"م",1,0],["إِنِّي بذا أَدْعو وأَسأَل مُلْحِفا","واللهُ ليس يردُّ دعوةَ مُلْحِف",128,"ف",1,0],["إِني بديهيُّ الدمو","عِ وإِنَّ دَمْعيَ لا يُبَادَه",129,"د",2,0]]}