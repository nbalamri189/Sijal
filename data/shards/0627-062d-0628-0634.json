{"poems":[[215,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[275,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[520,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[567,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69410","البسيط"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95235","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60896","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65955","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100723","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103961","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83189","الرجز"],[5605,"حميمية لقاء..","https://www.poetsgate.com/ViewPoem.aspx?id=159461",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""]],"verses":[["أحب شقائي في الغرام وإنه","لأروح من مطلولة الزهر شجراء",0,"ا",2,0],["أحَبُّ شيءٍ إِلى نفسي التي انبَثقَت","من الشّذا والنّدى والرّعدِ والحِمم",1,"م",1,0],["أحب شاور إخلاصاً وعترته","وهل عمارة فيكم غير عمار",2,"ر",1,0],["أحَبُّ شيءٍ لعيني حينَ أذكُرُهُ","دَمعٌ وأطَيبُ شيءٍ عِندَها السَّهَرُ",3,"ر",1,0],["أَحَبُّ شَيءٍ إِلَيهِ في مَمالِكِهِ","أَن يُجمَعَ الحَمدُ لا أَن تُجمَعَ البَدرُ",4,"ر",1,0],["أحِبُّ شراباً بثَغرٍ لهُ","وأهوى النَّباتَ من السُّكَّري",5,"ي",1,0],["أُحبُّ شموساً قد تقلدن أنجما","وأرْسَلْن فيناناً من الشَعرْ مُظلِما",6,"م",2,1],["أحب شباباً لا يزول بهاؤه","وملكاً كبيراً باقياً غير بائد",7,"د",1,0],["أحب شعر إلى نفسي وأصدقه","شعر بمدحك في الآفاق منتشر",8,"ر",1,0],["أحب شيء الى الوم والعذل","كي أسمع اسم الذي ذكراه لي أمل",9,"ل",1,1],["أَحبُّ شَيءٍ لِلفَتى ما يُمنَعُ","مِنهُ فَلا يَزالُ فيهِ يَطمَعُ",10,"ع",1,0],["أَحَبَّ شاعرةً تَرْنُو لشاعِرِهَا","وأنتِ مَقْصَدُهُ فاختارَ إِيَاكِ",11,"ك",1,0],["َأَحبُّ شيءٍ إلى قلبي الصلاةُ على","خُطاكَ في الأرضِ لا زوراً كََلفا",12,"ف",2,0],["أحب شفاهك الخجلى","بوجه باهر قانِ",13,"ن",1,0]]}