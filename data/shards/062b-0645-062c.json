{"poems":[[79,"يا نسيم الصبا على الأوراق","https://www.aldiwan.net/poem35898.html","الخفيف"],[23,"عين جودي بدمعك المنزور","https://www.aldiwan.net/poem21412.html","الخفيف"],[53,"علني أحمد من الدوشاب","https://www.aldiwan.net/poem8651.html","الخفيف"],[53,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[94,"يا صميم الحياة إني وحيد","https://www.aldiwan.net/poem38927.html","الخفيف"],[91,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[50,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[78,"ختمت فأرة مسك","https://www.aldiwan.net/poem39242.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[108,"طلعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=179627",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[309,"خلها تجري بعين الله في","https://www.aldiwan.net/poem16878.html","الرمل"],[358,"يا سرورا على القلوب تجلى","https://www.aldiwan.net/poem39588.html","الخفيف"],[396,"كلنا أموات لكن بخت من قدم إحسان","https://www.aldiwan.net/poem54455.html","عموديه"],[399,"قيس وليلى","https://www.aldiwan.net/poem24310.html","عموديه"],[409,"هتف القمري في الروض وغنى","https://www.aldiwan.net/poem33384.html","الرمل"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[463,"في الظباء الغادين أمس غزال","https://www.aldiwan.net/poem56073.html","الخفيف"],[510,"النسيان","https://www.aldiwan.net/poem42457.html","السريع"],[563,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[563,"بوجودي فغذني يا قوتي","https://www.aldiwan.net/poem34717.html","الخفيف"],[572,"فتنتني بدلها","https://www.aldiwan.net/poem69767.html","مجزوء الرجز"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64239","الخفيف"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75741","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126117","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109163","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109082","الخفيف"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93102","الرمل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48936","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2057,"","https://poetry.dctabudhabi.ae/diwan/poem/130452","الرمل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131329","الرجز"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88638","الخفيف"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32583","المنسرح"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129919","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100912","الخفيف"],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132218","الخفيف"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21612","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93946","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205818","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58533","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58453","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203473","الخفيف"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203547","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131072",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125843","الرمل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205457","الخفيف"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124118","الرمل"],[4869,"من جهينه إلى الاشراف","https://www.poetsgate.com/ViewPoem.aspx?id=151700",""],[4984,"أهواء من الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=175754",""],[585,"لا تلوموا مولعاً مضطربا","https://www.poetsgate.com/ViewPoem.aspx?id=161861",""],[5360,"يانخيل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=33241",""],[5409,"نبتت فوق روضة من غدير","https://www.poetsgate.com/ViewPoem.aspx?id=155302",""],[5431,"قبلة الأمس...","https://www.poetsgate.com/ViewPoem.aspx?id=210259",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5561,"شيّعوا شمسي","https://www.poetsgate.com/ViewPoem.aspx?id=192737",""],[5561,"تركوها","https://www.poetsgate.com/ViewPoem.aspx?id=192910",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5616,"الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=204841",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5691,"باب الخليفة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207262",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[6124,"لست سحارا","https://www.poetsgate.com/ViewPoem.aspx?id=174658",""]],"verses":[["ثمّ جاءَ المَشيبُ كالصُّبْحِ إذْ جا","ءَكَ هَذا وذَا نَذيرُ افْتِراقِ",0,"ق",1,0],["ثُمَّ جودي لِلخَزرَجِيِّ بِدَمعٍ","سَيِّداً كانَ ثَمَّ غَيرَ نَزورِ",1,"ر",1,0],["ثمَّ جُشِّمتُ شربَهُ فتجشَّمْ","تُ عذاباً يجوزُ حدَّ العذابِ",2,"ب",1,0],["ثم جلّاهُ عَنْ عواقبِ صدْقٍ","غَيبُها مثلُ غيبِك المأمونِ",3,"ن",1,0],["ثمَّ جاء الدُّجى فأَمسيتُ أَور","اقاً بِدَاداً من ذابلاتِ الورودِ",4,"د",1,0],["ثم جاؤا به خفافاً على طيارة","في جناحها تعجيل",5,"ل",1,0],["ثُمَّ جَرى الفَضلُ فَاِنطَوى قُدُماً","دونَ مَداهُ مِن غَيرِ تَرهيقِ",6,"ق",1,0],["ثَمَّ جَلّى عَنِ الخَليفَةِ بِالسَي","فِ غَداةَ اِلتَقَت صَياصي الأُمورِ",7,"ر",1,0],["ثم جلَّى وجهَهُ النُّو","رُ فجلَّى كلَّ حَلْكِ",8,"ك",1,0],["ثم جاءتِ الشياطين أنصا","راً وما جيش الماردين حقير",9,"ر",1,0],["ثم جاء المختارُ بالحب والعط","ف، وساوى القرآن بين الأَنام",10,"م",1,0],["ثم جاؤوا يسترجعون فلم تر","جع لهم شامةٌ ولا زهراء",11,"ا",2,0],["ثمَّ جاؤوا مُحاربينَ له في","أُحدٍ حيثُ هاجت الهيجاءُ",12,"ا",2,0],["ثم جئنا نودع البيت من غي","ر ما طيبة منا بفرقة الأجسام",13,"م",1,0],["ثم جئناك لتستغفر لنا","ربك الرحمن يمحو الزللا",14,"ل",2,0],["ثُمَّ جَدّد خلع العذار لَدَينا","وَاِطرَح العذر وَاِطّرح فيهِ ذُلّا",15,"ل",2,0],["ثم جانب لما هو اثم أو كان عصيان","يكسب إلا حلالا بل ولا يؤذي إنسان",16,"ن",1,0],["ثم جاء الصباح يوما وقيس","في يد الموت ذاهل مصروع",17,"ع",1,0],["ثم جست طرباً أوتارها","وتغنت في الهوى لحناً فلحنا",18,"ن",2,0],["ثم جاء الغد المؤّملُ سحراً","مُفصحاً عن عجائبِ الأسرارِ",19,"ر",1,0],["ثمَّ جرى أعوجاً فقامت","تَغُضُّ أرساغَها الخيولُ",20,"ل",1,0],["ثم جاءوا من بعدها يستقيلو","نَ وهيهات عثرةٌ لا تقالُ",21,"ل",1,0],["ثم جريْتِ كالدّمِ في السُّبا","تييْنِ والأبْهر والأكحلِ",22,"ل",1,0],["ثم جاء النور بالنور خلا","فة شهم هاشميٍّ لا أُمَيّ",23,"ي",1,0],["ثم جئنا والقلب من شوقه حنّْ","وهي تعلو ونحن ندنو إلى أنْ",24,"ن",1,0],["ثم جولت في ثبوتك ذوقي","وتنزلت فيك للتابوت",25,"ت",1,0],["ثم جاءَتْ لِمَأْتَمَ","آهِ مِنْ ذلِكَ المَجِي",26,"ج",2,0],["ثم جَادَ المُرادُ والسَّعدُ يَحدو","ه وكفُّ الآمَالِ مِنَّا تَقُودُه",27,"د",2,0],["ثُمَ جَدّوا مِن خَلفه في جِبال","لَيسَ فيها لِلواردين مِياه",28,"ا",2,0],["ثم جالتْ فيها فصارتْ حداقاً","غير أن لا ترى لهن جفونا",29,"ن",2,0],["ثم جل في قرى البَرابِر حيناً","آل جالوت ساكني الأجبالا",30,"ل",2,0],["ثم جمال الدين عبد الله","ابن هشام جهده لله",31,"ه",1,0],["ثم جوزوا مثل من قد سلكوا","قبلهم هذا الطريق الضيقا",32,"ق",2,0],["ثم جار الزمان جوراً كثيرا","فتمنيت إن أموت كثيرا",33,"ر",2,0],["ثم جاء الشمر مع زجر بن قيس بالرؤوس","تتجلى في سما أوج العوالي كالشموس",34,"س",1,0],["ثم جاء المعقبون من السا","سة والشاكري والعبدان",35,"ن",1,0],["ثم جاء الإسلام في صدره الرح","بِ فأَضحى طرفُ النساء قَريرا",36,"ر",2,0],["ثم جئنا إلى هنا فارتبطنا","بأمور تربو على التعداد",37,"د",1,0],["ثم جاءت بعد حولين له","بسليل ورث الأخ وشد",38,"د",1,0],["ثم جلى كل حرف فارقاً","فرقه الممتالا عن فرق الجميع",39,"ع",1,0],["ثم جيمعُ عَسْكَرِ السُّلطانِ","بهم كمالُ السَّعْدِ في الأَوْطَانِ",40,"ن",1,0],["ثُمَّ جاءَت اليه تسأله البقيا","على انفس عدمت بقاها",41,"ا",3,0],["ثُمَّ جَمَعنا صَحابَتي وَغَدوا","فيهِم كُرَيبٌ يَبكي وَقامَ لَنا",42,"ن",2,0],["ثمّ جئنا إلى عجائزِ قسٍّ","لابسٍ مسحة مع الزنّار",43,"ر",1,0],["ثُمَّ جِبَالَ سَمرَ والجوفِ","خوفَ شمالٍ ومحلِّ الخوفِ",44,"ف",1,0],["ثُمَّ جَبَل صُبحٍ وَأولُ الصَّفرا","إلى الزيارَه قَابَلُوا في المجرى",44,"ر",2,0],["ثم جفَّت رياضُنا واستحالت","غيرَ نفحِ الورود فى الأَكمام",45,"م",1,0],["ثم جاءوا وقد تمالاًوا طرا","على ظلمي بباطل الدعوات",46,"ت",1,0],["ثُمَّ جودٌ لَو قيلَ فيهِ مَزيدٌ","قُلتُ لِلسائِلينَ ما مِن مَزيدِ",47,"د",1,0],["ثم جد بالوصال واسمح بقربي","وازدجر لي غراب بيني وزاغه",48,"غ",2,0],["ثم جحيم سعرت معده","للأشقيا يصلونها في شده",49,"ه",1,0],["ثم جد به الملوك تباهت","إذا غدا بينهم عزيز المثال",50,"ل",1,0],["ثم جازيتني على صدق حبي","بقليل من الوداد الباقي",51,"ق",2,0],["ثمَّ جلالُ الدولةِ ابن القاسمِ","عادَ وَوَلّى وهو خيرُ حاكم",52,"م",1,0],["ثم جاءت بِرقعةِ الحيس عجلي","برسولٍ لِلحُكمِ قاس جَلْد",53,"د",1,0],["ثم جابت سهلاً ونجداً وجاءت","لك بالقوت بالعناء الكبير",54,"ر",1,0],["ثم جاءوا بشيء أعجب من ذا","حيث قالوا بأنهم صلبوه",55,"ب",3,0],["ثم جادت بنفسها ولها نو","ح شجي ولوعة ورثاء",56,"ا",2,0],["ثُمَّ جَاءُوا بَعدَ اقتِسامِ غَنِيما","تِهِمُ مُسلِمِينَ لِلَّهِ فَاءُوا",57,"ا",1,0],["ثُمَّ جَدَّ السَّيرَ لِلقَصرِ على","عَجَلٍ يَلقاهُمَا قَبل الرَّحِيل",58,"ل",1,0],["ثم جد المسير يبغيه والإغ","ريق ظلت بفلكها بانحصار",59,"ر",1,0],["ثم جسمٌ إنه","الشيطان في شكل مريعِ",60,"ع",1,0],["ثم جدي الأدنى وعمك شيخي","وأبو شيخك الكريم الجدود",61,"د",1,0],["ثم جز تلق ليوثاً خمسة","خير موجود من أبناء العرب",62,"ب",1,0],["ثم جيت اشرّف وآتشرّف ولا آسير","إلا وانا ذيبٍ على الرجم عاوي",63,"ا",3,0],["ثم جالت سحرا في ربعنا","في سلام بين زهر وغصون",64,"ن",1,0],["ثم جاء الدوق هنري مسرعاً","وحباها من نداه ما حبا",65,"ب",2,0],["ثم جاءت تبكيك منا القوافي","أي شعر يفوح منه النفاق",66,"ق",1,0],["ثم جف الغدير فاستشعرت شر","راً إذ انصاع عودها للذبول",67,"ل",1,0],["ثم جاءت إلى نتافات ذكرى","واحتوتها بضمة حاتمية",68,"ي",2,0],["ثمَّ جاعوا فحوَّلوه طعاماً","فتأمَّل عبادةَ الأهواءِ",69,"ا",2,0],["ثمَّ جاءَ الموتُ يُنهي قصّةٌ","ونعى القبرُ فؤادي ونعاها",70,"ا",3,0],["ثُمَّ جاءوها يحملونَ ضياعا","وقنوطا فيه العقولُ تحير",71,"ر",1,0],["ثم جُزها مواصلاً في صعودٍ","أو نزولٍ أوهادها ورباها",72,"ا",3,0],["ثم جيرانَهم (بني توبةٍ) مَن","تاب منها عدوها مذ بلاها",72,"ا",3,0],["ثم جُزها وسُق إلى (سيق) وانزل","عند (بيت الإمام) في مغناها",72,"ا",3,0],["ثم جاء الخريفُ يصبغُ فودَيْ","ها ويطوي مع الشبابِ شبابا",73,"ب",2,0],["ثُمَّ جَاءَتْ بَشَائِرُ اللَّهِ تَتْرَى","وَأَطَلَّتْ بِخَيْلِهَا الْفُرْسَانُ",74,"ن",1,0],["ثُمَّ جُبْنا نواحِيَ القصْرِ سيْراً","فوْقَ سَجّادٍ أبْدَعوا تفْويفَهْ !",75,"ف",2,0],["ثم جارَتْ بَغياً وعَقَّتْ أباها","غيرَ هَيأبَةٍ أذى سَخَطاتِهْ",76,"ت",2,0],["ثمَّ جاءوا نحو كهفي كالخبالى","كالحيارى واسْتغَاثوا منِّي بيَّا",77,"ي",2,0]]}