{"poems":[[39,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[147,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[234,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[264,"إن قلبي لديغ رقط الفراق","https://www.aldiwan.net/poem35937.html","الخفيف"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[401,"وشطت نوى تَنهاةَ من أن توافقا","https://www.aldiwan.net/poem601.html",""],[422,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[435,"أخو الصبابة يعلم","https://www.aldiwan.net/poem40273.html","المجتث"],[445,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[475,"يرى حسرة أن تصقب الدار مرة","https://www.aldiwan.net/poem4846.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63981","المتقارب"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133828","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65045","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1460,"","https://poetry.dctabudhabi.ae/diwan/poem/1899","الطويل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20577","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102069","الوافر"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121907","الوافر"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107053","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112326","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62786","الطويل"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17677","الطويل"],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142889","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4927,"شطرنج الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29612",""],[5190,"فاقرأني على مهل","https://www.poetsgate.com/ViewPoem.aspx?id=129791",""],[5437,"وش طاري الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=143521",""],[5704,"كفكف دموعك فالبكا لن ينفعك٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204221",""],[5937,"مآذِنٌ ناسِفة","https://www.poetsgate.com/ViewPoem.aspx?id=211826",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""]],"verses":[["وشطَّ ولي النوى أن النوى قُذفُ","تيَّاحة غربة بالدار أحيانا",0,"ن",2,0],["وَشَطرُ الأَرضِ في يُسراكَ مُلكٌ","أَلا فَاِشغَل بِباقيها اليَمينا",1,"ن",2,0],["وشطّ بمن نهواه بَيْنٌ وأَصبحوا","ضَمائِرَ أحداج وأَثقالَ أَينقِ",2,"ق",1,0],["وشطحنا في حضرة القدس لمّا","فتح الباب فاتحُ الأغلاق",3,"ق",1,0],["وشطَّت بِقَلبي في هَواها وَلَم يَزَل","ببحرِ غَرامٍ لا يُرامُ له شَطُّ",4,"ط",1,0],["وشطت نوى تَنهاةَ من أن توافقا","فبانت فشَاقَ البَينُ من كان شائِقا",5,"ق",2,1],["وشطّ نزارُ من أهواه عنِّي","ومن لي أن أزورَ وأنْ أُزارا",6,"ر",2,0],["وشطره فعل أمرٍ","طرداً وعكساً تحكم",7,"م",1,0],["وشَطَّ الصَّريخُ عَلَى ذي الصُّراخ","وفاتَ المُعَوَّلُ ذاتَ العَويلِ",8,"ل",1,0],["وَشَطَّت دِيارٌ بَعد قُربٍ بِأَهلِها","وَعادَت لَهُم بَعدَ الأُمورِ أُمورُ",9,"ر",1,0],["وَشِطْتَ فأهوَنُ من شاطَ مِنْ","زئيريَ يا أيها الشائط",10,"ط",1,0],["وشطآن توزّع من شذاها","على شتى العواطل والحوالي",11,"ل",2,0],["وشَطْرُهُ الآخَرُ الْمُرَجَّى","لِكلِّ عَفْوٍ وكلِّ غَفْرِ",12,"ر",1,0],["وشطرها وخبنها والوقف","لا بد منه وهو ظلم عسف",13,"ف",1,0],["وَشَطَّت لِتَنأى لي المَزارَ وَخِلتُها","مُفَقَّدَةً إِنَّ الحَبيبَ لَهُ فَقدُ",14,"د",1,0],["وَشَطَّ بِمَن تَهوى المَزارُ وَفَرَّقَت","نَوى الحَي دارٌ بِالحَبيبِ فَجوعُ",15,"ع",1,0],["وشطح صاح من فرح","على ما هو وأَولانا",16,"ن",2,0],["وشط بك القضاء وكل أمر","له أمد وغايته انقطاع",17,"ع",1,0],["وشطت به عن مورد العز عزلة","إلى مورد بالذل سيطت مشاربه",18,"ب",2,0],["وشطحتُ أفكر بالحيا","ة وكم بها حرٌّ يُهان",19,"ن",1,0],["وشَطبةِ مَلكٍ للجِيادِ سُيوفُهُ","وإنْ سبقتْها المُدْرَكاتُ الركائِكُ",20,"ك",1,0],["وَشَطَّت نَوى هِندٍ فَلا أَنتَ عالِمٌ","فَتَنطِقَ عَن وَصلٍ وَلا أَنتَ صارِمُ",21,"م",1,0],["وشطَّت بنا من بعد قُربٍ ديارُنا","فإن زمانَ المرءِ بالمرءِ غادرُ",22,"ر",1,0],["وَشَطرٌ بِمَتنِ المِجَنِّ التَصَق","حَكى وَتَداً بِاللَهيبِ اِحتَرَق",23,"ق",1,0],["وشطرٌ بمجرى المياه العميق","ترامى بصلصلةٍ وشهيق",24,"ق",1,0],["وشطّتْ دارُ أَحبابٍ كرامٍ","تبدّلَ وصلُهم بنوىً شطونِ",25,"ن",1,0],["وَ\\\"شِطْرَنُجُ\\\" حُبِّكِ فَخُّ الْغَرَاْمِ","وَفِيْهِ هَوَيْتُ إِلَى الْهَاْوِيَهْ",26,"ي",2,0],["وشَطُّهُ صَدرُكَ الحَانِي إِذَا عَبَثَتْ","يَدُ الشِّتَاءِ بِعَظمِي واْصطَلَى البَردُ",27,"د",1,0],["وش طاري الذكرى انا خلت ناسيه","وإلا ليالي البرد تشبه حضوره !",28,"ر",2,1],["وش طاري الذكرى انا خلت ناسيه","وإلا ليالي البرد تعلن حضوره !",28,"ر",2,0],["وشطبتُ كل قصيدة طرزتها","قَدْ كنتٰ يومًا قلتها وأنا معكْ",29,"ك",1,0],["وشطرتَ قلبي واندمجتَ بذَرِّهِ","فكأنه مما فعلتَ ، مُفاعِلُ",30,"ل",1,0],["وشطبتُ منْ كُتبي مخاضَ عَقيمةٍ","وكَسولةٍ هيَ  أمَّتي - وغَبيَّةْ",31,"ي",2,0]]}