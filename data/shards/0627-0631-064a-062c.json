{"poems":[[55,"مثال عينيك في الظبي الذي سنحا","https://www.aldiwan.net/poem30655.html","البسيط"],[79,"وظبي لأوضاع المجال مدرس","https://www.aldiwan.net/poem36446.html","الطويل"],[88,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[74,"أرى جلستي عند الكمال تميتني","https://www.aldiwan.net/poem18418.html","الطويل"],[91,"أرى جنانا حسنت حورها","https://www.aldiwan.net/poem44683.html","السريع"],[87,"ما بات يثني على علياك إنسان","https://www.aldiwan.net/poem7923.html","البسيط"],[63,"ملامك في الهوى أذكى غليلي","https://www.aldiwan.net/poem51484.html","الوافر"],[82,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[50,"عجبت لهارون الإمام وما الذي","https://www.aldiwan.net/poem64450.html","الطويل"],[48,"أسيت على الذوائب أن علاها","https://www.aldiwan.net/poem22006.html","الوافر"],[48,"نفوس للقيامة تشرئب","https://www.aldiwan.net/poem22091.html","الوافر"],[48,"أرى جوهرا حل فيه عرض","https://www.aldiwan.net/poem22897.html","المتقارب"],[48,"أرى جزء شهد بين أجزاء علقم","https://www.aldiwan.net/poem23365.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39621","الهزج"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39576","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[203,"على السماء وفوق الشمس أشعاري","https://www.aldiwan.net/poem45351.html","البسيط"],[226,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[287,"لنا برامة أوطان وأوطار","https://www.aldiwan.net/poem32786.html","البسيط"],[376,"أرى جنبات الأرض باسمك ترجف","https://www.aldiwan.net/poem57307.html","الكامل"],[376,"أرى جمرات في مسالك أنفاسي","https://www.aldiwan.net/poem57359.html","الطويل"],[382,"أرى جسمنا يحتاج قوت حياته","https://www.aldiwan.net/poem59126.html","الطويل"],[411,"أرى جلنارا قلوب الورى","https://www.aldiwan.net/poem49560.html","المتقارب"],[422,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[445,"بسعدك لا بسعد أو سعاد","https://www.aldiwan.net/poem34782.html","الوافر"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138327",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83264","الطويل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138996",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89553","البسيط"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199809","المسحوب"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77304","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110624","السريع"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33965","الطويل"],[2582,"","https://poetry.dctabudhabi.ae/diwan/poem/124223","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75863","المتقارب"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102177","البسيط"],[3220,"","https://poetry.dctabudhabi.ae/diwan/poem/203412","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87373","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145068","الطويل"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146495","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89211","البسيط"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/2","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86333","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91070","الطويل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123565","الوافر"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89989","الطويل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105570","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101394","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101361","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45149","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94803","الوافر"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104522","المتقارب"],[4463,"","https://poetry.dctabudhabi.ae/diwan/poem/144937","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66098","المتقارب"],[4691,"تهيّف شعري","https://www.poetsgate.com/ViewPoem.aspx?id=136805",""],[4767,"بستان العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180904",""],[4830,"حديثُ الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=206159",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[5002,"حقبةُ الألم.....","https://www.poetsgate.com/ViewPoem.aspx?id=210848",""],[5046,"أرى جناحك","https://www.poetsgate.com/ViewPoem.aspx?id=197903",""],[5135,"خَيلُ البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=201871",""],[5615,"رسالة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=187951",""],[5701,"جنود لصوص في القناة تجمعوا","https://www.poetsgate.com/ViewPoem.aspx?id=164588",""],[5842,"ومازال التراب \\محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=150625",""],[5853,"((الى ابنتي ..خلود))","https://www.poetsgate.com/ViewPoem.aspx?id=175625",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5957,"أحتاج أن تكون لي الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=183295",""],[6104,"أريج الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=25365",""],[6239,"الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75970&r=&rc=21",""]],"verses":[["أَرى جَنانِيَ قَد جاشَت حَلائِبُهُ","ما يَمنَعُ القَلبَ مِن فَيضٍ وَقَد طَفَحا",0,"ح",2,0],["أرى جيدَهُ نَصَّ المُحلّى وقرّرتْ","ثَناياهُ ما ضمّتْ صِحاحُ الجواهِرِ",1,"ر",1,0],["أَرى جَلالاً أَرى نوراً أَرى مَلَكاً","أَرى مُحَيّاً يُحَيّينا وَيَبتَسِمُ",2,"م",1,0],["أرى جلستي عند الكمال تميتني","غبوناً ونفعي بالعلومِ يفوت",3,"ت",1,1],["أرى جنانا حسنت حورها","ثم جحيما نارها ثائره",4,"ه",1,1],["أَرى جَنابَكَ رَوضاً لِلنَدى نَضِراً","لِأَنَّ غُصنَ رَجائي فيهِ رَيّانُ",5,"ن",1,0],["أرى جَزَعي لبينهمُ جميلاً","فكيفَ أعوذُ بالصَّبرِ الجميلِ",6,"ل",1,0],["أرى جسمك المرموسَ من روحه عفا","وأصبحَ معموراً به جَدَثُ التربِ",7,"ب",1,0],["أَرى جَعفَراً يَزدادُ بُخلاً وَدِقَّةً","إِذا زادَهُ الرَحمَنُ في سَعَةِ الرِزقِ",8,"ق",1,0],["أَرى جَرعَ الحَياةِ أَمَرَّ شَيءٍ","فَشاهِد صِدقَ ذَلِك إِذ تُقاءُ",9,"ق",3,0],["أَرى جِنحَ الدُجى أَوفى جَناحاً","وَماتَ غُرابُهُ الجَونُ المُرِبُّ",10,"ب",1,0],["أَرى جَوهَراً حَلَّ فيهِ عَرَض","تَبارَكَ خالِقُهُ ما الغَرَض",11,"ض",1,1],["أَرى جُزءَ شُهدٍ بَينَ أَجزاءِ عَلقَمِ","وَلُبّاً يُنادي بِاللَبيبِ لَتَعقُمِ",12,"م",1,1],["أريجُ البرتقالِ بهِ","ونفحُ العنَبِ النَّضرِ",13,"ر",1,0],["أرى جَنةً وأراني بها","أهيمُ بأرجائها حائرا",14,"ر",2,0],["أرى جبينَكَ هذي الشمسَ خالِقُها","وقد أنارتْ بنُورٍ عنه مُنْعكِسِ",15,"س",1,0],["أرى جمالاً تعالى أن أُلِمَ بهِ","وجلَّ خالقهُ من مبدعٍ باري",16,"ر",2,0],["أرى جمالا فماذا","وراء هذا الجمال",17,"ل",1,0],["أَرى جُفونَكَ ما تَنفَكُّ قاتِلَةً","فَهَل لَهُنَّ عَلَينا في الهَوى ثارُ",18,"ر",1,0],["أَرى جَنباتِ الأرضِ باسمكَ ترجفُ","وأطرافُها من ذِكرِه تَتَخوَّفُ",19,"ف",1,1],["أرَى جَمراتٍ في مَسالِك أنفاسي","وأَغصانُ عَيشي كلُّها يابِس عاسي",20,"س",2,1],["أرى جسمنا يحتاج قوتَ حياتِه","بقدْرٍ يقيه ضرَّ ضعفٍ وتُخمةِ",21,"ه",1,1],["أرى جُلّناراً قُلوبَ الوَرى","لِما فَوقَ خَدَّيْهِ مِن جُلَّنارِ",22,"ر",1,1],["أرى جُمَل الإِحسان والخير كلَّه","مفصَّلة في ذاتكم بفصول",23,"ل",1,0],["أرى جاهلاً قد نال في جهله المنى","كذا عالماً عانى على علمهِ العَنا",24,"ن",2,0],["أرى جَدْواكَ للإملاقِ ضِدّاً","وَفِي يَدِكَ المنونُ لمَنْ تُعادِي",25,"د",2,0],["أرىْ جُدودِيْ فكيْفَ قالُوا","بأنَّ منْ ماتَ لا يؤوبُ",26,"ب",1,0],["اريجها قد سرى منه الشذا عطراً","وطالما عنه عَرف الطيب قد عُرفا",27,"ف",2,0],["أَرى جُملَةً في صَفحَةِ الكَونِ لا تُقرا","وَعاطِفَةً في النَفسِ تَدري وَلا تُدرى",28,"ر",2,1],["أرى جرار الخمر تغلو وقد","عزت وبالإفلاس حالي عجيب",29,"ب",1,1],["أرى جيوش الأعادي في طرابُلسٍ","لدى شياطينها بالكفر رَنَّاتُ",30,"ت",1,0],["أريجُ مَجدٍ منَ الرَيّانِ حَيّانا","أَهدى لَنا نَشرُهُ رَوحاً وَرَيحانا",31,"ن",2,1],["أريج خاطري والبال عنده","يلي من بيت وصله لي مسده",32,"د",2,1],["أَرى جُهَلاءَ الناسِ لا يَمقُتونَها","فَكَيفَ وَأَنتُم أَهلُ فَضلٍ وَعِرفانِ",33,"ن",1,0],["أرى جني الورد في خده","يزهو ولا أقطف من ورده",34,"د",2,1],["أَرى جَسَدي يَبلي وَسَقَمي باطِنُ","وَفي كَبِدي داءٌ وَقَلبي سالِمُ",35,"م",1,1],["أرى جيل التصوف شر جيلٍ","فقل لهم وأهون بالحلول",36,"ل",1,1],["أَريجٌ كَمسكٍ وَثَغرٌ كَسلك","بِهِ زالَ نسكي وَزادَ نَحيبي",37,"ب",2,0],["أرى جميع شعوب الأرض قد بلغت","أوج الرقي وسادت وهو لم يسد",38,"د",1,0],["أرى جحفلاً يُعْطى الجزيل إبن عمه","وأحمدُ يُعْطِي نَعْجَةً حين حلَّتِ",39,"ت",1,0],["أَريجُ ثناءِ كالنَسيم يمرُّ في","خَمائِلُ اوصافٍ لَهُ فهو عاطِرُ",40,"ر",1,0],["أرى جل أصحابي ازدروا بوظيفتي","وقالوا هموم كلها ووجائع",41,"ع",1,1],["أرى جنةً في خَده غير أنني","أرى جُلَّ نارِي شبّ مِن جُلنارِه",42,"ر",2,0],["أرى جوهر المجد اختصصت بفرده","وقد قصمت في الناس بعدك أجناسه",43,"س",2,0],["أَرى جارَتي خَفَّت وَخَفَّ نَصيحُها","وَحُبَّ بِها لَولا النَوى وَطُموحُها",44,"ح",3,1],["اريج لُطف بِاِزهار الفَصاحَةِ في","رَوض البَلاغَةِ بِالازهان قَد علقا",45,"ق",2,0],["أَرى جاهِلاً مَن أَحزَنَ البُؤسُ قَلبَه","وَأَجهل مِنهُ مَن بصفوٍ تَهنّأ",46,"ا",1,0],["أرى جسمِي تَحُطُّ به البَلايَا","وما شارَفْتُ مُعْتَركَ المَنايَا",47,"ي",2,1],["أرى جَنَتَّةً قد أيعنت ثمراتُها","وعَزَّت فما تجنى بعين ولا يَدِ",48,"د",1,0],["أرى جيدي بجودك غير حالٍ","ودهري لا يرق لسوء حالي",49,"ل",2,0],["أريج الراح صافية المزاج","يروّح بالشذا روح المزاج",50,"ج",1,1],["أريجك أم نشر المسرة يعبق","وثغرك أم برق المنى يتألق",51,"ق",1,1],["أرى جنتي أضرم فيهما","نعيمها ناراً بها القلب يحرق",51,"ق",1,0],["أَرى جَيشَ الرَدى يَرمي نصالاً","وَيَصلي غالِبَ الأَكبادِ جَمراً",52,"ر",2,1],["أرى جمع الأيمَّة قد أباحوا","بقتل العمد قتلَ القاتلينا",53,"ن",2,1],["أريج حياتك في السابقين","ولو كنت في مأزق الحنجره",54,"ه",1,0],["أرى جفوة أو قسوة من أخي ندى","إلى الله فيها المشتكى والمعول",55,"ل",1,0],["أَريجُكِ يُنْعِشُ ما قدْ ذَبَلْ","ويُحْيِي المُنَى",56,"ن",2,0],["أرى جور هذا الحب عدلا محببا","فقل للذي أهواه إيّاك تنصفُ",57,"ف",1,0],["أريج زهورِ الروضِ أنتُنَّ أصلُهُ","بِكُنَّ أريجٌ للزهورِ يدومُ",58,"م",1,0],["أرى جذوةً أم بريقَ الحَبا","أم الشوقَ في مُقلتَيهَ شَبا",59,"ب",2,1],["أرى جهل ما تلقى وربّ تغابي","صيامك أخفى العيد ضاع به الفطرُ",60,"ر",1,0],["أرَى جرُوحاً بها الأوْجاعُ صاخبَةً","والروُّحُ ساجدةً عُمري لها الْتَفتا",61,"ت",2,0],["أرى جناحَك في أُفْق الدّجى فُرِشا","ضمَّ النجومَ بكفّ الليل فارتعشا",62,"ش",2,1],["أرى جيْلاً يميْلُ إلى الْملاهي","رأيْتُ الرَّقْصُ أقْصى مبْتغاهُ",63,"ا",2,0],["أرى جيْلاً يتوْقُ إلى الْمعالي","يعطِّرُ منْ كتابِ الله فاهُ",63,"ا",2,0],["أَريجُ الياسَمينِ ، ولَحظُ ظَبيٍ","إِليَّ مِنَ الشَّآمِ أرى خَيَالَهْ",64,"ل",2,0],["أرى جيشها جيش الجمارك وحدها","فإن جد جد الحرب ولَّى مروعا",65,"ع",2,0],["أرى جَبَلاً يُكَلِّلُهُ شموخٌ","من التحنان يسترضي نُسُورَهْ",66,"ر",2,0],["أريجكِ ياابنتي يحْتلُّ قلبي","يُعطِّرني ويفعلُ ما يريدُ",67,"د",1,0],["أريجُكِ يخلقني من جديد","ويبعث فيَّ شعورَ الظَّفَرْ",68,"ر",1,0],["أريجُ هذا الودّ من احساسنا نمدّهُ","ننسجهُ أغنية والشعر كالرحيق",69,"ق",1,0],["أريجُ الصبايا إذا فاحَ منها","أ ُريق الأريجُ على السَّيسَبان ِ",70,"ن",1,0],["أرى جبلَ الأحزان يعلو، فأنحني","على حلم مازال في القلب برعما",71,"م",2,0]]}