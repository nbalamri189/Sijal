{"poems":[[37,"تيممت لهبا أبتغي العلم عندهم","https://www.aldiwan.net/poem39181.html","الطويل"],[35,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem25910.html","الطويل"],[107,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[113,"شكوت إلى الذي أهوى سهاما","https://www.aldiwan.net/poem16599.html","الوافر"],[310,"نفسي الفداء لمن حل الحشا فرأى","https://www.aldiwan.net/poem56361.html","البسيط"],[500,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38532","الطويل"],[2660,"","https://poetry.dctabudhabi.ae/diwan/poem/203386","الوافر"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203026","المتقارب"],[3177,"","https://poetry.dctabudhabi.ae/diwan/poem/113907","الرجز"],[3617,"","https://poetry.dctabudhabi.ae/diwan/poem/107037","المجتث"],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""]],"verses":[["فَقَالَ جَرَى الظَبيُ السَنيحُ بِبَينِها","وقال غُرابٌ جَدَّ مُنهَمِرُ السَّكبِ",0,"ب",1,0],["فَقالَ جَميعُ الناسِ لَمّا نَشَدتُها","بَلى وَفَريقٌ قالَ وَاللَهِ ما نَدري",1,"ر",2,0],["فقال جَعلتُ أمرَ القومِ طُرّاً","إلى سَعْدٍ فَنِعْمَ هو الوَكيلُ",2,"ل",1,0],["فَقالَ جَميل عشقك لَم يَدَعني","إِذا أَقبَلت أَغمض عَنكَ عَيني",3,"ي",1,0],["فَقالَ جَفنيَ مِرآتي الّتي عَكَست","شمسَ الجمالِ لتُذكي قلب رائيهِ",4,"ي",2,0],["فقال جزى العواهر ما جزاها","وسمن كل جانية ظلوم",5,"م",1,0],["فَقالَ جَزائي حَيثُ عَنكُم قتلتهُ","أُسَلسلَ بِالفولاذِ مِنكُم وَأُشنَقُ",6,"ق",1,0],["فقال جبينه لما تبدى","حديث الليل يمحوه النهار",7,"ر",1,0],["فَقالَ جرّوا هاونا وَمدفعا","لِهذِهِ الحالَة شَخص ما وَعى",8,"ع",2,0],["فقال جنونك ما شاهدت","نظيراً له في الكرى عبقر",9,"ر",1,0],["فقال جنس الضأن قد خُدِعنا","حيث إلى أعدائنا استمعنا",10,"ن",2,0],["فقال جفني حسام","فقلت انسيت نبلك",11,"ك",1,0],["فقال جبريل مجيباً لو دنوت وإنما","هنا رسم معراجي ولن أعدو الرسما",12,"م",2,0]]}