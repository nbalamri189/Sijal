{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54541","الخفيف"],[226,"يا خليلا أجل كل خليل","https://www.aldiwan.net/poem55251.html","الخفيف"],[318,"قل لمن يفهم عني ما أقول","https://www.aldiwan.net/poem59486.html","الرمل"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138719",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83347","الخفيف"],[4852,"آية كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=214348",""],[5587,"خدعوني لمعاني","https://www.poetsgate.com/ViewPoem.aspx?id=197794",""],[5956,"حسبي ذكاؤك سابراً لحقيقتي","https://www.poetsgate.com/ViewPoem.aspx?id=193504",""],[6189,"عاهة مستديمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83601&r=&rc=68",""]],"verses":[["أَنْتَ أَكْرَمْتَنِي لِيُكْرِمْكَ رَبُّ","الْعَرْشِ هَذَا شُكْرِي وَهَذَا دُعَائِي",0,"ا",2,0],["أنت أكرمت في حياتك مثوا","نا على بعدنا أنا وزميلي",1,"ل",2,0],["أَنتَ أكل الخُبزِ لاَ تَعرِفهُ","كَيفَ يَجري مِنكَ أم كَيفَ تَبُول",2,"ل",1,0],["أنت اكتسيت من الزمرد حلة","وتختمت بالنيرين يداك",3,"ك",1,0],["أَنتَ أَكرَمتَني بحبّ حَبيبي","ربّ زِدني مِن ذلِكَ الإِكرامِ",4,"م",1,0],["(أنتَ اكتمالُ الرسلِ) مُتْمِمُ جملةٍ","جلَّ العقيدةِ .. تسكنَ الصدرا",5,"ر",2,0],["أَنْتَ أَكْتَبْ وْ رُوفْ","وْ أُنْظُرْ لْحَالِي مَا ﭬْوَانِي",6,"ن",2,0],["أنت اكتسبت الأجر من رب الهدى","لتواصل بي واثقاً من طاهرِ",7,"ر",1,0],["أنت أكبرتهم وما اهتزَّ سيفٌ","في يد المدَّعي وما اهتزَّ رُمحُ",8,"ح",1,0]]}