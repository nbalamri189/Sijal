{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[57,"بدا من أبي الفضل الهوى المتقادم","https://www.aldiwan.net/poem26122.html","الطويل"],[75,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[90,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[53,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[93,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[93,"دمية حسناء تغري النظرا","https://www.aldiwan.net/poem8870.html","عموديه"],[64,"سرى يكتسي قطعا من الليل مظلما","https://www.aldiwan.net/poem52297.html","الطويل"],[64,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[47,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[50,"ألست أمين الله سيفك نقمة","https://www.aldiwan.net/poem64449.html","الطويل"],[52,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[22,"تَجَهَّمَ لي بالبِشْر يَوْمَ لَقِيتُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=19811",""],[47,"أُحاجِيكَ، هل للحُبّ كالدّارِ تَجمعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31224",""],[53,"راع فؤادي منك ما راعَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29511",""],[118,"وما إن صوت نائحة بليل","https://www.aldiwan.net/poem20957.html","الوافر"],[137,"برء الإمام حياة الخلق كلهم","https://www.aldiwan.net/poem4214.html","البسيط"],[151,"أيا نفس إن الأمر غيب فما تدري","https://www.aldiwan.net/poem47622.html","الطويل"],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[240,"صحبنا في بطالته سعيدا","https://www.aldiwan.net/poem31650.html","الوافر"],[266,"ألم بنا يختال غير ملوم","https://www.aldiwan.net/poem38190.html","الطويل"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[405,"قد كان بعدك أنباء وهنبثة","https://www.aldiwan.net/poem4510.html","البسيط"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[563,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59607","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72325","الطويل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47501","البسيط"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130254","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76619","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101694","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105666","الوافر"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101952","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100218","الطويل"],[3149,"","https://poetry.dctabudhabi.ae/diwan/poem/198915","السريع"],[3325,"","https://poetry.dctabudhabi.ae/diwan/poem/115034","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89314","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103931","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131972","الوافر"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69246","الطويل"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75840","الوافر"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96063","الطويل"],[4691,"حافظ القرآن الماجن","https://www.poetsgate.com/ViewPoem.aspx?id=174368",""],[4929,"جنازة أيلول","https://www.poetsgate.com/ViewPoem.aspx?id=199973",""],[4987,"مريت الاطراف؟","https://www.poetsgate.com/ViewPoem.aspx?id=49587",""],[585,"أنرسف بالسلاسل والقيود","https://www.poetsgate.com/ViewPoem.aspx?id=161852",""],[5111,"مَرَاكِبُ العشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212250",""],[5111,"عَلَى شَفَتِي سُقْرَاطَ","https://www.poetsgate.com/ViewPoem.aspx?id=212269",""],[5431,"هل يرتوي الدهر من دمع المساكين","https://www.poetsgate.com/ViewPoem.aspx?id=193388",""],[5459,"أراك سكرت ..!","https://www.poetsgate.com/ViewPoem.aspx?id=204936",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5725,"وليل يكيل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=179909",""],[5943,"تحت الغمامات","https://www.poetsgate.com/ViewPoem.aspx?id=61821",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""]],"verses":[["تَجَهَّموا ضَيفَ العُلى","وَاِمتَهَنوا زَورَ النِعَم",0,"م",1,0],["تَجَهَّمتُ فَوزاً في المَنامِ فَأَعرَضَت","وَإِنّي عَلى ما كانَ مِنّي لَنادِمُ",1,"م",1,0],["تَجَهَّمَ الدَهرُ فَاِنصاتَت لَهُم غُرَرٌ","ماءُ الطَلاقَةِ في أَسرارِها دُفَعُ",2,"ع",1,0],["تَجهّز من الحُسنى بما أنت قادر","عليه ولا تَقبل سوى العقل مُرشدا",3,"د",2,0],["تجهشُ للموتِ نفسُ نائِكِها","من نتنِ فيها أشدَّ إجهاش",4,"ش",1,0],["تجهد أن تشبعه دهرها","لو أنها تسطيع إشباعه",5,"ع",2,0],["تجِهُ الصنيعةِ والصنيعةُ حرةٌ","فثنتْ أعِنتها عن التُّجَّاه",6,"ه",1,0],["تَجَهَّمتَ القَريضَ فَفاضَ عَتَباً","وَإِن أَحرَجتَهُ فاضَ اِنتِقادا",7,"د",2,0],["تَجهَلُ الشَر وَلا تُحسِنُ أَن","تَخدَعَ الغَير وَلا أَن تَغدِرا",8,"ر",2,0],["تجهَّمَهُمْ وجهُ الزمانِ فألمعُوا","له بشهابِ الدين حتى تبسَّمَا",9,"م",2,0],["تَجَهَّمَني وجهُ المطالبِ والتوتْ","أُموريَ وانسدتْ عليَّ المطالعُ",10,"ع",1,0],["تَجَهُّمُهُ رَوعُ القُلوبِ وَبِشرُهُ","بَريدٌ بِبُشرى ما يُنَوِّلُ مُسرِعُ",11,"ع",1,0],["تَجَهَّز جِهازَ البَرمَكِيِّنَ وَانتَظِر","بَقِيَّةَ لَيلٍ صُبحُهُ بِكَ لاحِقُ",12,"ق",1,0],["تَجَهَّز طالَ في النَصَبِ الثَواءُ","وَمُنتَظَرُ الثَقيلِ عَلَيَّ داءُ",13,"ا",2,1],["تَجَهَّمَ لي بالبِشْر يَوْمَ لَقِيتُهُ","قدامة خصيا قنبليِّ معيَّل",14,"ل",1,1],["تَجَهُّمُهُ رَوْعُ القُلوبِ، وَبِشرُهُ","بَرِيدٌ يبُشرَى ما يُنَوِّلُ مُسْرِعُ",15,"ع",1,0],["تجهد أن تشبعه دهْرَها لو","أنها تستطيع إشباعه",16,"ع",2,0],["تَجَهنا غادِيَينِ فَساءَلَتني","بِواحِدِها وَأَسأَلُ عَن تَليدي",17,"د",2,0],["تجهم الدهر لما أن شكا وبدا","ببرئهو وهو طلقُ الوجهِ مبتسمُ",18,"م",1,0],["تجهتُ لكم وجهي بأكرم شافع","محمد المبعوث للعبد والحرّ",19,"ر",1,0],["تجهَّم يوماً وجه غليومَ وانزوى","فما في وجوه العالمين سرورُ",20,"ر",1,0],["تَجَهَّمَ ما عَهِدنا مِنهُ طَلقاً","وَأَصبَحَ عابِساً ما كانَ لَدنا",21,"ن",2,0],["تجهم وجه السحب وافتر برقه","به مثلما يفتر ثغر كظيم",22,"م",1,0],["تَجَهَّمَتِ البَشيرَ فلَمْ يرُعْها","بِمُصْطَلَمَاتِها غَيرُ النّذيرِ",23,"ر",1,0],["تجهّمنا رجالٌ فَاِستخفّ بنا","مُذ غبت عنّا وكلّ الخيرِ قد غصبوا",24,"ب",3,0],["تجهَّزَ للخطبِ فصلُ الخطابِ","فملَّكَ أيدي الأماني زمامَهْ",25,"م",2,0],["تجهمت شأو العشق في نشأة الصبى","وما من صبىً فيها ولا عشق لا شأو",26,"و",1,0],["تجَّهم الأفقُ أعلاماً بهجرهمُ","وجادت السحبُ إسعافاً وإسعاداً",27,"د",2,1],["تجهز إلى أرض العدو ولا تهن","وتظهر فتوراً إن مضت منك حارم",28,"م",1,0],["تَجَهَّمَ العيدُ وَانْهَلَّتْ بَوَادِرُهُ","وَكَنْتُ أَعْهَدُ مِنْهُ البِشْرَ والضَّحِكا",29,"ك",2,1],["تجهز إسحاق إلى الله غادياً","فلله ما ضمت عليه اللائف",30,"ف",1,0],["تجهم وجه الأفق واعتلت النفس","بأن لم تلح للعين أنت ولا الشمس",31,"س",1,1],["تجهم وجه السحب بشرى بجودها","وجودك من آياته رونق البشر",32,"ر",1,0],["تجهمت الحياة لديك حتى","رمتك بما تشاء من الحتوف",33,"ف",1,0],["تجهز من جيش الغرام كتائبا","كتائب تترى لا تصد ولا تلوى",34,"و",2,0],["تجهم وجه الموت وازورَّ حاجبه","فراح يرينا كيف تجثو غياهبه",35,"ب",2,1],["تجهر بالتسبيح آناءها","تخاطب الألباب بالصمت",36,"ت",1,0],["تجهزي بجهاز تبلغين به","يا نفس قبل الردى لم تخلقي عبثا",37,"ث",2,1],["تجهزوا لمليكٍ في جهادهمُ","جيشاً جسيمُ هواه اليومَ أبلاه",38,"ل",3,0],["تجهمت نوب الدنيا لعامرها","فلا يد عن يد الضرار تمنعه",39,"ع",2,0],["تجهّم وجْهُ الأنسِ وهْو بمفْرَقي","أزاهِرُ في خُضْرِ الرُبى تتبسّمُ",40,"م",1,0],["تجهم عندما أقبلت وحدي","ولم يبصر يمينك في يميني",41,"ن",2,0],["تجهَّز وَأَسرِع وَالحَق الجَيشَ لا أَرى","سِوى الجَيشِ إِلّا في المَهالِكِ مَذهَبا",42,"ب",2,0],["تُجَهِّزُهم بما وَجدَت وَقالَت","بَنيَّ فَكُلُّكُم بَطَلٌ مُسيفُ",43,"ف",1,0],["تجهمتني خوفَ القرى واطرحتني","وكنتَ قصيرَ الباعِ غير المقَلّد",44,"د",1,0],["تجهزْ إن ّ أشعاري الدواء ُ","إذا ما صابك َ الداءُ العياء ُ",45,"ا",2,1],["تجهيلُ الشَّعبِ لحاكمِهِ","طوعاً بالرِّقِّ يُعَبِّدُهُ",46,"د",2,0],["تجهل جروحي ياللي جروحك خفاف","معذور لو قلبك جهل ما عرفها",47,"ف",3,0],["تجهمنا المراد وقد رضينا","تعنت كل جبارٍ عنيد",48,"د",1,0],["تَجَهّمَتْ مُدُنُ التَّحْنَان وَارْتسَمَتْ","لَفْظًا سَرَى أنّةً يَتْلو مَآسِيْهَا",49,"ي",3,0],["تَجَهَّمَتْ مُهُجَاتُ الْوَجْهِ وَانْطَفَأَتْ","إلَى شُمُوسِ الضِّيَا تَحْنُو مَرَايَاهُ",50,"ا",2,0],["تجهم العمر من أنواء غربته","وفاضت الكأس زقوما لتُضنيني",51,"ن",2,0],["تجهَّزَ للغنيمة مطمَئنًّا","لصلحٍ قد تضمَّخَ بالفسادِ",52,"د",1,0],["تجهلُ الرعْيَ والحراثة َوالزرْعَ","فأنّى ستألَفُ الزُّرّاعا ؟!",53,"ع",2,0],["تجهّم وجهاً لاترى منه ومضةً","سوى صيّبٍ تذكي الفؤاد رواعدهْ",54,"د",2,0],["تجهَّمُ الليلُ والأنوارُ مطفئة","يتيهُ في عتمِهِ سارٍ بهِ انطلقَا",55,"ق",2,0],["تجهز الشيخ فيها نضرة لرسو","لِ الله والشيخ أدرى في مواميها",56,"ي",3,0]]}