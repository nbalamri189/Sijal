,"نفثاتٌ قيسيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=199885",""],[5281,"الرَّحيل","https://www.poetsgate.com/ViewPoem.aspx?id=199315",""],[5285,"أتدرين ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203980",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5351,"السراب","https://www.poetsgate.com/ViewPoem.aspx?id=202285",""],[5363,"بينونة كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=144160",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5431,"إلى حضنه يهفو وفي وهجه مشى!!","https://www.poetsgate.com/ViewPoem.aspx?id=197886",""],[5431,"جلجامش القصيد...","https://www.poetsgate.com/ViewPoem.aspx?id=211485",""],[5431,"فمكر الله خيرٌ إنْ أمدّه","https://www.poetsgate.com/ViewPoem.aspx?id=213977",""],[3294,"أتعلم أيها السيف الصقيل","https://www.poetsgate.com/ViewPoem.aspx?id=173273",""],[5545,"نسيج الحب","https://www.poetsgate.com/ViewPoem.aspx?id=184849",""],[5690,"أتدري أيا مولايَ أن عذولنا","https://www.poetsgate.com/ViewPoem.aspx?id=172227",""],[5722,"غالية في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=12683",""],[5725,"مبتدأ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209146",""],[5758,"لعِيْنَيْ غَزَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200916",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[6089,"أرماحُ الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=213393",""],[6093,"أتدري متى","https://www.poetsgate.com/ViewPoem.aspx?id=192264",""],[6102,"نِهايَةُ المُسَلسَل","https://www.poetsgate.com/ViewPoem.aspx?id=182768",""],[6102,"حَماقَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=183657",""],[6152,"حُلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=203097",""],[6152,"روحي تحتاج إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213209",""],[6192,"نقاط استفهام إلى شاعر صهيوني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63735&r=&rc=5",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""],[6247,"أتدرين أنك أمّ الجمال؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80293&r=&rc=32",""],[6256,"عتاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65924&r=&rc=12",""],[454,"حديث الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82640&r=&rc=4",""]],"verses":[["أَتَدنو قُطوفُ الجَنَّتَينِ لِمَعشَرٍ","وَغايَتِيَ السِدرُ القَليلُ أَوِ الخَمطُ",0,"ط",1,0],["أتدعونا إلى حَرْب القوافي","لِتَحرُبَنا السلامةَ يا حريبُ",1,"ب",1,0],["أتُدعَمُ بالعُرجِ المشائيمِ دولةٌ","يراها مليكُ الناسِ ذاتَ جلالِ",2,"ل",1,0],["أَتَدفَعُ بِالغَوِيِّ إِلى التَمادي","وَتَعجَبُ بَعدَ ذَلِكَ إِن تَمادى",3,"د",2,0],["أَتَدفَعُ عَن فُلانٍ وَهُوَ شَيخٌ","لَهُ عِرضٌ يَنالُ الناسُ مِنهُ",4,"ه",1,1],["أتدخلون بهذا في الجنان غدا","وتبتغون به حوراً وغلمانا",5,"ن",2,0],["أتدرى قدر زائرها المفدَّى","وإن جلت وجل بها المزور",6,"ر",1,0],["أتدركه حرفة جازها","قديما إلى غيرها في الحرف",7,"ف",1,0],["أَتَدرينَ ما مَرَّ مِن حادِثٍ","وَما كانَ في السَنَةِ الماضِيَه",8,"ي",2,0],["أَتَدري أَيَّ سُلطانٍ تُحَيّي","وَأَيَّ مُمَلَّكٍ تُهدي السَلاما",9,"م",2,0],["أَتَدري أَيُّ ذَنبٍ أَنتَ جانٍ","وَأَيُّ دَمٍ ذَهَبتَ بِهِ مُراقِ",10,"ق",1,0],["أَتُدخِلُ بَيتَ المُلكِ مَن لَيسَ أَهلَهُ","وَريشُ الذُنابى قَبلَ ريشِ القَوادِمِ",11,"م",1,0],["أَتَدري ما يَنوبُكَ في اللَيالي","وَمَركَبُكَ الجَموحُ بِكَ العَثورُ",12,"ر",1,0],["أَتَدري أَيَّ ذُلٍّ في السُؤالِ","وَفي بَذلِ الوُجوهِ إِلى الرِجالِ",13,"ل",1,1],["أَتَدري مَن أَخوكَ أَخوكَ حَقّاً","أَخوكَ بِصَبرِهِ لَكَ وَاِحتِمالِه",14,"ل",2,0],["أتدفعني وقد هاضت جناحي","وتجذبني وقد شدت وثاقي",15,"ق",2,0],["أَتَدبُّ في جَفنَيه طائِفة الكرى","وعقاربُ الأصداغ ذاتُ دبيبِ",16,"ب",1,0],["أَتَدري أَيَّ بارِقَةٍ تَشيمُ","وَمَهلَكَةٍ إِلَيها تَستَنيمُ",17,"م",1,1],["أَتُدِلُّ بِالتاجِ الرَفيعِ فَإِنَّني","بِالمَكرُماتِ مُتَوَّجٌ وَمُعَصَّبُ",18,"ب",1,0],["أَتَدري ما تُجَشِّمُنا اللَيالي","وَتَركَبُنا حَوادِثُها الجِسامُ",19,"م",1,0],["أتدرونَ مَن أزكى البريّةِ منَصِباً","وأفضلُها إنْ عُدِّدَ البدْوُ والحضْر",20,"ر",1,0],["أتدْرونَ أيُّ المَاءِ أكثرُ ساقياً","وأيُّ جبالِ اللّه في الأرضِ أرسخ",21,"خ",1,0],["أَتَدري الشَمسُ أَنَّ لَها بَهاءً","فَتَأسَفَ أَن يُفارِقَها الأَياءُ",22,"ي",3,0],["أَتُدالُ يَوماً فِضَّةٌ مِن فِضَّةٍ","فَيَصيرُ مِثلَ سَبيكَةٍ جُلمودُها",23,"د",3,0],["أَتَدري النُجومُ بِما عِندَنا","وَتَشكو مِنَ الأَينِ أَسفارَها",24,"ر",3,1],["أَتُدعى بِغَيرِ تُقاكَ التَقيُّ","وَلَيسَ الطِمِرُّ سِوى ما طَمَر",25,"ر",1,0],["أَتَدري وَالحَياةُ لَها صُروفٌ","بِما يَلقاهُ جَروُكِ يا ثُعالَه",26,"ل",2,0],["أتدري الريحُ من ملكتْ زمامهْ","تشقُّ الغربَ أو تطوي ظلامهْ",27,"م",2,1],["اتدلل والحق معاي","واعاتبك وما تهونش عليَّ",28,"ي",1,0],["أَتَدري ما أَروحُ بِهِ وَأَغدو","فَتاةُ الحَيِّ حَيَّ بَني رَباحِ",29,"ح",1,0],["أَتدري دجلةٌ أنَّ المنافي","طوَتكَ .. وما طوتكَ على اشتياقِ",30,"ق",1,0],["أَتَدْرِي العُلاَ مَنْ شَيَّعتْ حينَ شَيَّعوا","ومَنْ ودَّعتْ يومَ الرَّحِيلِ وَوَدَّعُوا",31,"ع",3,1],["أَتُدْفَنُ في الأرض الكنوزُ وفوقها","خَلاَءٌ إلى لأْلائِهَا جِدُّ مُمْلِقِ",32,"ق",1,0],["أتدخر الأعمال جهلا بوجهها","وأنت إلى علم هناك فقير",33,"ر",1,0],["أتدرين أين غرسنا المنى ؟","وكيف ذوت قبل أن نحصدا ؟",34,"د",2,0],["أتدري الرّبى أنّ السماوات سافرت","لتشهد دنيانا فأغفلت على الربى",35,"ب",2,0],["أتُدخِلُ بَيتَ المُلْكِ مَن ليسَ أهلَه،","وعِيش الذُّنَابَى قَبلَ رِيشِ القَوَادِمِ",36,"م",1,0],["اتدري الريح من ملكت زمامه","تشقّ الغرب وتطوي ظلامه ؟",37,"م",2,1],["أَتَدري ما حَوى الشعب اليَماني","بدور دُجى عَلى عَذبات بانِ",38,"ن",1,1],["اتدري انني شرواك مضنى","تزمزم روحه خلف النياق",39,"ق",1,0],["أتدَّكرين ليلةَ بات يُسقَى","مداما مِن عوارضك البشام",40,"م",1,0],["أتَدَّكِرِينً قَولكِ بِإِختِلاَسٍ","ضُحىً كَلِمَاتٍ أحرُفُهُنَّ لَينُ",41,"ن",1,0],["أتدرِى أيّها أَسر","عُ للأرواح ترحيلا",42,"ل",2,0],["أتدري من تبارز بالذّنوب","وتعصي الأمر منه على الدّؤوبِ",43,"ب",1,1],["أَتَدري اللَّيالي أَيَّ خَصمٍ تُشاغِبُه","وَأَيَّ همامٍ بِالرَزايا تُواثبُهْ",44,"ب",2,1],["أتدعو أتدعو للزيارة عاشقاً","يجنّ كما شاء الغرام ويعقل",45,"ل",1,0],["أتدرون لم جْدت ركاب أبيكم","كما جد سيرٌ بالقلاص الرواتك",46,"ك",1,0],["أَتَدرينَ ما هَذا المَقامُ الَّذي سَما","عَلى قِممِ الأَفلاك أَم أَنتِ لم تَدري",47,"ر",2,0],["أَتدْرِينَ فوْقَ الحبِّ ما هوَ مِنْكُمُ","يُقَرِّبُني فالحبُّ جَرَّعني الهَجرا",48,"ر",2,0],["أَتَدري أَيُّ ذاكَ اليَومِ فَكِّر","وَأَيقِن أَنَّهُ يَومُ الفِراقِ",49,"ق",1,0],["أتَدعُوكَ إلى القَصفِ","من الأزهارِ أفنانُ",50,"ن",1,0],["أتَدري ما أحَطتَ به وماذا اش","تَملتَ عَلَيهِ من بَنجُوتَكينِ",51,"ن",1,0],["أتَدري ما دَهاكَ فَكيفَ تَدري","إذا كانَ اللِّقاءُ هو الوَداعُ",52,"ع",1,0],["أتدْري مَنْ تخَرَّمتِ المنونُ","ومن أرِقَتْ لمصْرعهِ العيون",53,"ن",1,1],["أتدري يا زمانُ بِمَنْ دَهتْنا","صروفُكَ أنّك الزّمنُ الخؤونُ",53,"ن",1,0],["أتدري بمن تنعى وما أنت قائل","فيا ليت سمعي من نداك به وقر",54,"ر",1,0],["أتدري بمن قد حل سوحك أنه","إمام به واللّه يفتخر الفخر",54,"ر",1,0],["أتدفع فيها بها ما ترى","فكيف تداوي الأسى بالأسى",55,"ا",1,0],["أتدري عني النفحات أني","على وتري لعينيها أغني",56,"ن",2,1],["أتدري أن عينيها تجنت","على قلبي ؟ فأتلفه التجني؟",56,"ن",2,0],["أتدري من تملكني هواه","ولم تبخل علي ولم تمن",56,"ن",1,0],["أتدنو لتُسعفَني بالعِنا","قِ في مثلها أم تَصدُّ ازورارا",57,"ر",2,0],["أَتَداعَى كلَّما ريحُ الصَّبا","هبَّ منها عارِضٌ مُبْتَسِمُ",58,"م",1,0],["أَتَدري مَن بها تلك الديارُ","وتعلم ما غطا ذاك الخمارُ",59,"ر",1,1],["أتَدري ما بقلبِكَ من جِراحِ","فَتاةٌ طَرْفُها شاكي السِّلاحِ",60,"ح",1,1],["أَتَدعيني فَدما أَتفضين لِلفَتى","بِشَجوى وَلِأَوائي وَجم مَواجِعي",61,"ع",2,0],["أتدري النّاسُ أن لا قَبلَ قَبلي","لذي مِقَةٍ وأن لا بَعدَ بَعدي",62,"د",2,0],["أتدري على من تشرج اللبن جهرةً","على مقلة الإيمان بل مهجة الهدى",63,"د",2,0],["أتدري فأسألها أيُّنا","شهيدُ قضيتها أيُّنا",64,"ن",2,0],["أتدري بعذري في شكاتي وتعلمُ","وتكثر لومي إنك الآن أظلمُ",65,"م",1,1],["أتدري وقاك الله إني على جوى","أبيت بهم من نواك مروع",66,"ع",1,0],["أتُدينُني ودَمي قرائينٌ على","عَبَثِ الرماح ِيُدَارُ حتى يُسْفَكا",67,"ك",2,0],["أَتَدرينَ يا لعسا المراشفِ عندنا","جَنى النحل أَحلى أم لذيذ جناكِ",68,"ك",1,0],["أَتَدعوني وَتُطعِمُني يَسيراً","وَتَسقيني الكَثيرَ عَلى اليَسيرِ",69,"ر",1,1],["أَتَدْرُونَ مَنْ لاَقَيْتُمُ فُلَّ جَيْشُكُمْ","لَقِيتُمْ لُيوثاً أَصَحَرَتْها العَرَائنُ",70,"ن",1,0],["أتدري المنايا من رمت بسهامها","وأي فتى أودى وغال الغوائل",71,"ل",1,0],["أَتَدُلّونَ عَلَينا فارِساً","يا بَني أَنمارَ يا أَهلَ الخَنا",72,"ا",1,0],["أتدري لمن تبكي العيون الذوارف","وينهل منها واكف ثم واكف",73,"ف",1,1],["أتدري أن خير النا","س قد ضلوا على الفقر",74,"ر",1,0],["أتدري يا شقيق الروح تدري","بما كابدت من وجلي وصبري",75,"ر",2,1],["أتدري من أنا يا من تفرد","وهُو رُوحي وَربّ بلا مجال",76,"ل",1,0],["أتدرى أين هم ضربوا الخياما","وهل وفوا لمغرمهم ذماما",77,"م",2,1],["أتدري حُداة مطيّاتها","بمن أرقلوا وبمن جعجعوا",78,"ع",3,0],["أتدري غداً من أهله وهو قادمٌ","لعل غدا فيه حمامك يسنحُ",79,"ح",1,0],["أتدرين من كلفت عينيك قتله","وقلت فتى لا يستفيد غريب",80,"ب",1,0],["أَتَدرى حَبيبى مَن نَهِيمُ لِوَصلِهِ","فَذَاكَ حَبيبُ اللهِ أحمَدُ نعلِنُ",81,"ن",1,0],["أتدري من نعيت وكيف فاهت","به شفتاك، كان بك الصعيد",82,"د",1,0],["أتدخلون ببيتي يا بني مضر","من لا أحب فذا هيهات لم يكن",83,"ن",1,0],["أتدخل الخيل خباء الألى","خباؤها فوق السما طنبا",84,"ب",2,0],["أتدري حسين أخيف فسار","ر بأهليه في أي واد سلك",85,"ك",1,0],["أَتَدعوني الأُقَيشِرَ ذَلِكَ اِسمي","وَأَدعوكَ اِبنَ مُطفِئَةِ السِراجِ",86,"ج",1,1],["أتدري الليالي أي خصم تشاغبه","وأي همام بالبلايا تواثبه",87,"ب",2,1],["أتدرى الفُلكُ أيُّ حياً تهامى","على الوادى وأيُّ سناً تلالا",88,"ل",2,0],["أتدري ما يقول لك العذول","وتدري ما يريد بما يقول",89,"ل",1,1],["أتدفا بالنّارِ حتّى يرى جِلْ","دِيَ منهُ مبقّعاً كالَفْهدِ",90,"د",1,0],["أَتَدري ما يَقول النَقش فيها","يَقول بساكِني يحمي الجوار",91,"ر",1,0],["أَتَدري الَّذي أَعياك مِنهن في اللقا","نَعم إنهُ كف خَضيب وَمعصم",92,"م",1,0],["أتدرون من أودى أتدرون من ثوى","هو الليث والقبر المزار عرين",93,"ن",1,0],["أتدري أنك الملك المفدى","وأن هواك بالقلب استبدّا",94,"د",2,1],["أتَدْرِي السَّواقِي ما تقولُ وقد غدتْ","تدُورُ وتَسْقي حين تعلُو وتنْزِلُ",95,"ل",1,1],["أتدري من فللت فللت عضبا","حساما ما بشفرته فلول