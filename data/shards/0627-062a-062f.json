{"poems":[[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[51,"أبا حسن وأنت فتى أديب","https://www.aldiwan.net/poem8181.html","الوافر"],[51,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[91,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[70,"أتدفع عن فلان وهو شيخ","https://www.aldiwan.net/poem42439.html","الوافر"],[89,"المجمعون على التوحيد ما عبدوا","https://www.aldiwan.net/poem45098.html","البسيط"],[85,"تنقل ايها القمر المنير","https://www.aldiwan.net/poem7531.html","الوافر"],[85,"علمت بأن الحطام انصرف","https://www.aldiwan.net/poem7750.html","المتقارب"],[85,"أمينة يا بنتي الغاليه","https://www.aldiwan.net/poem8067.html","المتقارب"],[85,"عظيم الناس من يبكي العظاما","https://www.aldiwan.net/poem8092.html","الوافر"],[85,"أميدان الوفاق وكنت تدعى","https://www.aldiwan.net/poem63708.html","الوافر"],[28,"أبلغ أبا دوود أني ابن عمه","https://www.aldiwan.net/poem5583.html","الطويل"],[49,"لأمر ما خلقت فما الغرور","https://www.aldiwan.net/poem62092.html","الوافر"],[49,"أتدري أي ذل في السؤال","https://www.aldiwan.net/poem63086.html","الوافر"],[49,"إذا ما المرء صرت إلى سؤاله","https://www.aldiwan.net/poem63089.html","الوافر"],[97,"هتفت وقد بدت مصر لعيني","https://www.aldiwan.net/poem25068.html","الوافر"],[80,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[44,"أتدري أي بارقة تشيم","https://www.aldiwan.net/poem30002.html","الوافر"],[105,"أدنو ويجمح بي الإباء فأعزب","https://www.aldiwan.net/poem43398.html","الكامل"],[105,"سلام أيها الملك الهمام","https://www.aldiwan.net/poem43407.html","الوافر"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[75,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[46,"تعالى رازق الأحياء طرا","https://www.aldiwan.net/poem22002.html","الوافر"],[46,"لا كانت الدنيا فليس يسرني","https://www.aldiwan.net/poem22411.html","الكامل"],[46,"أتدري النجوم بما عندنا","https://www.aldiwan.net/poem22641.html","المتقارب"],[46,"لزينب يحلو جني أمر","https://www.aldiwan.net/poem22745.html","المتقارب"],[46,"ليذمم والدا ولد ويعتب","https://www.aldiwan.net/poem23172.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202645","المجتث"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199486","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[100,"عذاب ولحن","https://www.poetsgate.com/ViewPoem.aspx?id=50120",""],[94,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[28,"أبلغ أبا داود أني ابن عمه","https://www.poetsgate.com/ViewPoem.aspx?id=19996",""],[96,"عودة المحارب ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66467&r=&rc=143",""],[110,"أتدري ما حوى الشعب اليماني","https://www.aldiwan.net/poem16407.html","الوافر"],[116,"امن نفحات ازهار العراق","https://www.aldiwan.net/poem40869.html","عموديه"],[133,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[133,"أعائش إن تحقق منك بين","https://www.aldiwan.net/poem54718.html","الوافر"],[143,"أتنساها على خيف","https://www.aldiwan.net/poem58348.html","الهزج"],[151,"أتدري من تبارز بالذنوب","https://www.aldiwan.net/poem68506.html","الوافر"],[170,"أتدري الليالي أي خصم تشاغبه","https://www.aldiwan.net/poem1602.html",""],[212,"تلقيت من روح الجمال رسالة","https://www.aldiwan.net/poem46317.html","الطويل"],[282,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[298,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[299,"أحس بشيء في الحشا يشبه الجمرا","https://www.aldiwan.net/poem36281.html","عموديه"],[310,"ألا إن السباق سباق زهد","https://www.aldiwan.net/poem50267.html","الوافر"],[372,"على طرفك برهان","https://www.aldiwan.net/poem57032.html","الهزج"],[372,"ألا يا أيها البيت المعلى","https://www.aldiwan.net/poem57081.html","الخفيف"],[372,"لمن حلل تهاداها البقاع","https://www.aldiwan.net/poem57314.html","الوافر"],[403,"أتدري من تخرمت المنون","https://www.aldiwan.net/poem46438.html","الوافر"],[404,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[417,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[450,"حديث الحب","https://www.aldiwan.net/poem1016.html",""],[459,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[501,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[552,"أتدري من بها تلك الديار","https://www.aldiwan.net/poem47810.html","الوافر"],[563,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"]],"verses":[["أَتَدنو قُطوفُ الجَنَّتَينِ لِمَعشَرٍ","وَغايَتِيَ السِدرُ القَليلُ أَوِ الخَمطُ",0,"ط",1,0],["أتدعونا إلى حَرْب القوافي","لِتَحرُبَنا السلامةَ يا حريبُ",1,"ب",1,0],["أتُدعَمُ بالعُرجِ المشائيمِ دولةٌ","يراها مليكُ الناسِ ذاتَ جلالِ",2,"ل",1,0],["أَتَدفَعُ بِالغَوِيِّ إِلى التَمادي","وَتَعجَبُ بَعدَ ذَلِكَ إِن تَمادى",3,"د",2,0],["أَتَدفَعُ عَن فُلانٍ وَهُوَ شَيخٌ","لَهُ عِرضٌ يَنالُ الناسُ مِنهُ",4,"ه",1,1],["أتدخلون بهذا في الجنان غدا","وتبتغون به حوراً وغلمانا",5,"ن",2,0],["أتدرى قدر زائرها المفدَّى","وإن جلت وجل بها المزور",6,"ر",1,0],["أتدركه حرفة جازها","قديما إلى غيرها في الحرف",7,"ف",1,0],["أَتَدرينَ ما مَرَّ مِن حادِثٍ","وَما كانَ في السَنَةِ الماضِيَه",8,"ي",2,0],["أَتَدري أَيَّ سُلطانٍ تُحَيّي","وَأَيَّ مُمَلَّكٍ تُهدي السَلاما",9,"م",2,0],["أَتَدري أَيُّ ذَنبٍ أَنتَ جانٍ","وَأَيُّ دَمٍ ذَهَبتَ بِهِ مُراقِ",10,"ق",1,0],["أَتُدخِلُ بَيتَ المُلكِ مَن لَيسَ أَهلَهُ","وَريشُ الذُنابى قَبلَ ريشِ القَوادِمِ",11,"م",1,0],["أَتَدري ما يَنوبُكَ في اللَيالي","وَمَركَبُكَ الجَموحُ بِكَ العَثورُ",12,"ر",1,0],["أَتَدري أَيَّ ذُلٍّ في السُؤالِ","وَفي بَذلِ الوُجوهِ إِلى الرِجالِ",13,"ل",1,1],["أَتَدري مَن أَخوكَ أَخوكَ حَقّاً","أَخوكَ بِصَبرِهِ لَكَ وَاِحتِمالِه",14,"ل",2,0],["أتدفعني وقد هاضت جناحي","وتجذبني وقد شدت وثاقي",15,"ق",2,0],["أَتَدبُّ في جَفنَيه طائِفة الكرى","وعقاربُ الأصداغ ذاتُ دبيبِ",16,"ب",1,0],["أَتَدري أَيَّ بارِقَةٍ تَشيمُ","وَمَهلَكَةٍ إِلَيها تَستَنيمُ",17,"م",1,1],["أَتُدِلُّ بِالتاجِ الرَفيعِ فَإِنَّني","بِالمَكرُماتِ مُتَوَّجٌ وَمُعَصَّبُ",18,"ب",1,0],["أَتَدري ما تُجَشِّمُنا اللَيالي","وَتَركَبُنا حَوادِثُها الجِسامُ",19,"م",1,0],["أتدرونَ مَن أزكى البريّةِ منَصِباً","وأفضلُها إنْ عُدِّدَ البدْوُ والحضْر",20,"ر",1,0],["أتدْرونَ أيُّ المَاءِ أكثرُ ساقياً","وأيُّ جبالِ اللّه في الأرضِ أرسخ",21,"خ",1,0],["أَتَدري الشَمسُ أَنَّ لَها بَهاءً","فَتَأسَفَ أَن يُفارِقَها الأَياءُ",22,"ي",3,0],["أَتُدالُ يَوماً فِضَّةٌ مِن فِضَّةٍ","فَيَصيرُ مِثلَ سَبيكَةٍ جُلمودُها",23,"د",3,0],["أَتَدري النُجومُ بِما عِندَنا","وَتَشكو مِنَ الأَينِ أَسفارَها",24,"ر",3,1],["أَتُدعى بِغَيرِ تُقاكَ التَقيُّ","وَلَيسَ الطِمِرُّ سِوى ما طَمَر",25,"ر",1,0],["أَتَدري وَالحَياةُ لَها صُروفٌ","بِما يَلقاهُ جَروُكِ يا ثُعالَه",26,"ل",2,0],["أتدري الريحُ من ملكتْ زمامهْ","تشقُّ الغربَ أو تطوي ظلامهْ",27,"م",2,1],["اتدلل والحق معاي","واعاتبك وما تهونش عليَّ",28,"ي",1,0],["أَتَدري ما أَروحُ بِهِ وَأَغدو","فَتاةُ الحَيِّ حَيَّ بَني رَباحِ",29,"ح",1,0],["أَتدري دجلةٌ أنَّ المنافي","طوَتكَ .. وما طوتكَ على اشتياقِ",30,"ق",1,0],["أَتَدْرِي العُلاَ مَنْ شَيَّعتْ حينَ شَيَّعوا","ومَنْ ودَّعتْ يومَ الرَّحِيلِ وَوَدَّعُوا",31,"ع",3,1],["أَتُدْفَنُ في الأرض الكنوزُ وفوقها","خَلاَءٌ إلى لأْلائِهَا جِدُّ مُمْلِقِ",32,"ق",1,0],["أتدرين أين غرسنا المنى ؟","وكيف ذوت قبل أن نحصدا ؟",33,"د",2,0],["أتدري الرّبى أنّ السماوات سافرت","لتشهد دنيانا فأغفلت على الربى",34,"ب",2,0],["أتُدخِلُ بَيتَ المُلْكِ مَن ليسَ أهلَه،","وعِيش الذُّنَابَى قَبلَ رِيشِ القَوَادِمِ",35,"م",1,0],["اتدري الريح من ملكت زمامه","تشقّ الغرب وتطوي ظلامه ؟",36,"م",2,1],["أَتَدري ما حَوى الشعب اليَماني","بدور دُجى عَلى عَذبات بانِ",37,"ن",1,1],["اتدري انني شرواك مضنى","تزمزم روحه خلف النياق",38,"ق",1,0],["أتدَّكرين ليلةَ بات يُسقَى","مداما مِن عوارضك البشام",39,"م",1,0],["أتَدَّكِرِينً قَولكِ بِإِختِلاَسٍ","ضُحىً كَلِمَاتٍ أحرُفُهُنَّ لَينُ",40,"ن",1,0],["أتدرِى أيّها أَسر","عُ للأرواح ترحيلا",41,"ل",2,0],["أتدري من تبارز بالذّنوب","وتعصي الأمر منه على الدّؤوبِ",42,"ب",1,1],["أَتَدري اللَّيالي أَيَّ خَصمٍ تُشاغِبُه","وَأَيَّ همامٍ بِالرَزايا تُواثبُهْ",43,"ب",2,1],["أتدعو أتدعو للزيارة عاشقاً","يجنّ كما شاء الغرام ويعقل",44,"ل",1,0],["أتدرون لم جْدت ركاب أبيكم","كما جد سيرٌ بالقلاص الرواتك",45,"ك",1,0],["أَتَدرينَ ما هَذا المَقامُ الَّذي سَما","عَلى قِممِ الأَفلاك أَم أَنتِ لم تَدري",46,"ر",2,0],["أَتدْرِينَ فوْقَ الحبِّ ما هوَ مِنْكُمُ","يُقَرِّبُني فالحبُّ جَرَّعني الهَجرا",47,"ر",2,0],["أَتَدري أَيُّ ذاكَ اليَومِ فَكِّر","وَأَيقِن أَنَّهُ يَومُ الفِراقِ",48,"ق",1,0],["أتَدعُوكَ إلى القَصفِ","من الأزهارِ أفنانُ",49,"ن",1,0],["أتَدري ما أحَطتَ به وماذا اش","تَملتَ عَلَيهِ من بَنجُوتَكينِ",50,"ن",1,0],["أتَدري ما دَهاكَ فَكيفَ تَدري","إذا كانَ اللِّقاءُ هو الوَداعُ",51,"ع",1,0],["أتدْري مَنْ تخَرَّمتِ المنونُ","ومن أرِقَتْ لمصْرعهِ العيون",52,"ن",1,1],["أتدري يا زمانُ بِمَنْ دَهتْنا","صروفُكَ أنّك الزّمنُ الخؤونُ",52,"ن",1,0],["أتدري بمن تنعى وما أنت قائل","فيا ليت سمعي من نداك به وقر",53,"ر",1,0],["أتدري بمن قد حل سوحك أنه","إمام به واللّه يفتخر الفخر",53,"ر",1,0],["أتدفع فيها بها ما ترى","فكيف تداوي الأسى بالأسى",54,"ا",1,0],["أتدري عني النفحات أني","على وتري لعينيها أغني",55,"ن",2,1],["أتدري أن عينيها تجنت","على قلبي ؟ فأتلفه التجني؟",55,"ن",2,0],["أتدري من تملكني هواه","ولم تبخل علي ولم تمن",55,"ن",1,0],["أتدنو لتُسعفَني بالعِنا","قِ في مثلها أم تَصدُّ ازورارا",56,"ر",2,0],["أَتَداعَى كلَّما ريحُ الصَّبا","هبَّ منها عارِضٌ مُبْتَسِمُ",57,"م",1,0],["أَتَدري مَن بها تلك الديارُ","وتعلم ما غطا ذاك الخمارُ",58,"ر",1,1],["أتَدري ما بقلبِكَ من جِراحِ","فَتاةٌ طَرْفُها شاكي السِّلاحِ",59,"ح",1,1]]}