{"poems":[[74,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[74,"إليك مدير الكأس عني إنني","https://www.aldiwan.net/poem18552.html","الطويل"],[93,"وسائلة أي المذاهب مذهبي","https://www.aldiwan.net/poem62662.html","عموديه"],[76,"الآن سح غمام النصر فانهملا","https://www.aldiwan.net/poem13228.html","البسيط"],[78,"شبابي كيف صرت إلى نفاد","https://www.aldiwan.net/poem39439.html","البسيط"],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[92,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[93,"كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=53230",""],[147,"حمى النوم أجفان صب وصب","https://www.aldiwan.net/poem11724.html","المتقارب"],[164,"ولعت به كبدر التم يبدو","https://www.aldiwan.net/poem58989.html","الطويل"],[173,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[189,"على الجانب الإسكندري سلام","https://www.aldiwan.net/poem14658.html","الطويل"],[203,"أحقا رأيت الموت دامي المخالب","https://www.aldiwan.net/poem45410.html","الطويل"],[264,"على فقد شهر الصوم تجري المدامع","https://www.aldiwan.net/poem35731.html","الطويل"],[275,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[276,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[303,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[382,"أيا ضابطي شرعِ الكنيسة عنوة","https://www.aldiwan.net/poem59172.html","الطويل"],[382,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[505,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[519,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126846","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86601","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48507","الطويل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100581","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136117","الوافر"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143780","المتقارب"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109320","الوافر"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198393","المتقارب"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100120","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121175","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93703","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137452",""],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82836","الوافر"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100576","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52989","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48327","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48453","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118748","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91165","الطويل"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138828",""],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18824","الوافر"],[4495,"","https://poetry.dctabudhabi.ae/diwan/poem/138874",""],[4691,"أنت الحكاية أرويها لوجداني","https://www.poetsgate.com/ViewPoem.aspx?id=61853",""],[4767,"عقد الجمان","https://www.poetsgate.com/ViewPoem.aspx?id=178711",""],[4767,"قوافي الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=181926",""],[4858,"في تكريم معلمة فاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=34920",""],[4119,"أما وخيال زار ممن أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=16065",""],[5038,"فم الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=188382",""],[5155,"الربيع والفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=176155",""],[5616,"الراحلون","https://www.poetsgate.com/ViewPoem.aspx?id=204853",""],[5616,"موال فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5690,"دهر يزعزع ركن المجد والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=172140",""],[5776,"مسافةٌ منزوعةُ الجهاتْ","https://www.poetsgate.com/ViewPoem.aspx?id=205843",""],[5845,"خلِّ الغرامَ يصبٍّ دمعهُ دمهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198429",""],[5861,"معزوفة الجحيم","https://www.poetsgate.com/ViewPoem.aspx?id=188090",""],[5879,"كل النساء","https://www.poetsgate.com/ViewPoem.aspx?id=215463",""],[6070,"حفظ اللسان","https://www.poetsgate.com/ViewPoem.aspx?id=187866",""],[5616,"الرّاحلون ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1934&r=&rc=4",""]],"verses":[["فكم هرِمٍ أو ناشئٍ عملت بهِ","عواملُ من مجرورِ خطبٍ ومنصوب",0,"ب",1,0],["فكم هاجدٍ تحت الثرى ومحمدٌ","أخو الملك أمسى ساهداً متهجدا",1,"د",2,0],["فَكَم هَشَّ لِلأَنسامِ وَالنورِ وَالهُدى","وَآوى إِلَيهِ الطَيرَ وَالذَرَّ وَالنَملا",2,"ل",2,0],["فَكَم هُنالِكَ مِن ضَرغامَةٍ سَفَرَت","سُمرُ العَوالي إِلى أَحشائِهِ رُسَلا",3,"ل",2,0],["فَكَمْ هذا التَّمَنِّي للْمَنايا","وكم هذا التجلُّدُ للجِلادِ",4,"د",1,0],["فكم هدم المشيبُ حياةَ شيخٍ","وما أغناه حَزْمٌ أو وقَار!",5,"ر",1,0],["فكم هاوٍ أَجَدَّ لنا جُروحاً","بدعوى أنَّه آسي جراح",6,"ح",1,0],["فكم هشّ للأنسام والنور والندى","وآوى إليه الطير والذرّ والنملا",7,"ل",2,0],["فَكَم هامَةٍ لَم يَصُنها التَريكُ","وَكَم جَسَدٍ ما حَماهُ اليَلَب",8,"ب",1,0],["فكم هام مطيرة وساق","وكم كف مطرحة وزند",9,"د",1,0],["فَكَم هامَةٍ لِلكُفرِ راحَت وَهامُها","نِعالاً لِأَيدي خَيلِكُم في المَلاحِمِ",10,"م",1,0],["فكم همةٌ فيها وكم أريحيةٌ","وفضلٌ ومجدٌ شامخ وذِمام",11,"م",1,0],["فكم هزَّهُ الإسلامُ في وجهِ حادثٍ","فهزَّ صقيلَ الحدِّ عضبَ المضاربِ",12,"ب",1,0],["فكم هو أحيا دارساً من قلوبنا","وكم أربعت مذ حلّ فيها المرابع",13,"ع",1,0],["فكم هَجَروا منازِلَهم إباءً","ليَجتَنبوا الدنيئةَ والشَّنارا",14,"ر",2,0],["فَكَم هُنالِك من فَخر وَمِن شَرَف","لمن شَديد القوى رحيا يعلمه",15,"م",2,0],["فَكَمْ هيَّجتِ لي نفساً","تنازعني للقياكِ",16,"ك",1,0],["فكم هفوةٍ جاءت بأثواب توبةٍ","تجرِّر أذيالاً تواري بها فعلا",17,"ل",2,0],["فكم هتكت رهبانُه غشَّ ناكر","ولكنه للسر ليس بهاتك",18,"ك",1,0],["فكم هجمَ العِدى طَيْشاً وجهلاً","وراموا بالهَوانِ أَجَلَّ هادِ",19,"د",1,0],["فكم همّ في عَثْرِ المَنايا إلى المُنى","فجازَ عليها والسّيوفُ القَناطِرُ",20,"ر",1,0],["فكَم هدّ للإيمان صرحاً مشيّداً","وَرُكناً من الإسلام سامي الدعائمِ",21,"م",1,0],["فكم همة بالوهم عنها تلهت","أحاشيك بالتتريه عن حشوية",22,"ه",1,0],["فَكَم هَذب الانشا بنظم عَقائدٍ","لَها بَيننا في الخافِقين طلاب",23,"ب",1,0],["فكم هاجمونا طامعين فأخفقوا","وما الريح في الطود المكين تؤثر",24,"ر",1,0],["فكم هتكوا خدراً وكم نهبوا خبا","وكم ذبحوا منكم رضيعاً على لهف",25,"ف",1,0],["فَكَم هَنَّأَت أَرضُ العِراقِ بِكَ العُلى","وَزُفَّت بِكَ البُشرى لِأَطرافِ عَمّانِ",26,"ن",1,0],["فكم هجم المنون على قوي","يظن بأنه البطل الأريب",27,"ب",1,0],["فكم هاج من قرم ساكنٍ","وأوضح من شهوةٍ مبهمه",28,"م",2,0],["فكم هي قد حوت من كل فظ","غليظ القلب معدوم الإداره",29,"ر",2,0],["فكم هزّني في لِقاكَ اشتياقٌ","وشوْقُ المُجِدِ شديدُ الأَلَمْ",30,"م",1,0],["فكم هنالك من بيضاء ناعمةٍ","تستوقف العين بين الخمص والهضم",31,"م",1,0],["فكم هبطت للارض منك كواكب","لتلثم حصباء بها ورمالها",32,"ل",3,0],["فَكَم هوَ في نَهار الحَرِّ صاما","وَكَم هوَ في لَيال القرِّ قاما",33,"م",2,0],["فكم هدى للهدى قوما بفكرته","وأوضح الرشد فيهم بعد ما فتنوا",34,"ن",3,0],["فكم هَدَموا دَعائِمَ مُنكَراتٍ","وَكَم لِلشَّرعِ قد شادوا بِناء",35,"ا",2,0],["فكم هديت أناساً للطريق وكم","أطلقت من ريقة التقليد أقواما",36,"م",2,0],["فكم هنالك من فخر ومن شرف","لمن شديد القوى وحيا يعلمه",37,"م",2,0],["فكمْ همّةٍ نصْريّةٍ راعَتِ العِدَى","وكم ذمّةٍ مرْعيّةٍ حاطَتِ الذَّمَا",38,"م",2,0],["فكمْ هزّ في الحرْبِ العَوانِ حُسامَهُ","وأرسلَ يقْفو إثْرَهُ الرُمْحَ مُشْرَعا",39,"ع",2,0],["فكم هاتكاتٍ لستر العفا","ف تُهين محيا لها أنضرا",40,"ر",2,0],["فَكم هو قَد أَخنى عَلى كل ماجد","وَأخّر قَوماً في الرجال وقَدّما",41,"م",2,0],["فكم هتكوا من حرمةٍ لمحمدٍ","وكم أهرقوا منهم دماً ليس يُهرق",42,"ق",1,0],["فَكَم هَذا أَذودُكَ عَن قِطاعي","كَتَذويدِ المُحَلّأَةِ النِهالِ",43,"ل",1,0],["فكم هتفت من فوق أفنانها ضحى","سواجع قد أذكرنني بن محلم",44,"م",1,0],["فكم هويت وكم عشت الهوى حرقا","فلم أجد مسعفا ينهي لأحزاني",45,"ن",2,0],["فكم هشَّ الفؤاد إذا أتوني","بيوم السبت تقدُمُهم (فِدانا)",46,"ن",2,0],["فكم هاجرٍ صد عن خِلِّه","وناسٍ لما كان لم يفلحِ",47,"ح",1,0],["فكم هديتِ بنور العلمِ طالبةً","وكم منحتِ جميلاً من عطاياكِ",48,"ك",1,0],["فكم هبوة أوقعن بالكفر تحتها","فما انقشعت إلا وللذل جنبه",49,"ب",2,0],["فكمْ همٍّ وَهى فيهِ فؤادي","وقلّتْ حيلتي أمستْ تخيبُ",50,"ب",1,0],["فكم هصرنا قدود الغيد مائسة","وكم قطفنا بها وردا ورمانا",51,"ن",2,0],["فكم هتفُوا بنا غَوْثاً فطارَتْ","لنجدتِهِم قصائدُنا الخيولُ",52,"ل",1,0],["فَكَمْ هَدَمَ الطُّغَاةُ هُنَاكَ بَيْتًا","عَلَى أَنْقَاضِهِ سَقَطَ الطُّمُوحُ",53,"ح",1,0],["فكم هدينا بشمس من معارفه","وفكرة سطعت كالأنجم الشهبِ",54,"ب",1,0],["فكم هُنا وكم هُنا....هناااك","يا هاءَ (هُوْ) هل نسبقُ الفواتْ؟",55,"ت",1,0],["فكمْ هناكَ منْ فخرٍ ومنْ شرفٍ","لمنْ شديدِ القوى وحياً يعلمهُ",56,"م",2,0],["فكم هو الليل فيك اليوم يرهقني","وكم يطول على المهمومِ يجزعُهُ",57,"ع",2,0],["فَكَمْ هَزَمْتِ مَعَ الأَشْوَاقِ لَهْفَتَنَا","وَكَمْ رَفَعْتِ جَلَالَ الحُبِّ بِالأَدَبِ",58,"ب",1,0],["فَكَمْ هَفوَةٍ أدتْ بِصاحِبِ زَلَّةٍ","إلى فَقْدِ مَحبوبٍ وَقَطْعِ وِصالِهِ",59,"ه",1,0],["فكم هتَفوا بنا غوثاً فطارتْ","لِنجدَتِهم قوافينا الخُيولُ",60,"ل",1,0]]}