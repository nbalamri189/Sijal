{"poems":[[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[72,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[43,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[227,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[283,"يا سيد ما أنت إلا سيد","https://www.aldiwan.net/poem39427.html","الكامل"],[303,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[362,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[369,"ما كان يدري كيف يصبح هاجرا","https://www.aldiwan.net/poem57466.html","البسيط"],[436,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[456,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[477,"فلتحى تونس وليعش","https://www.aldiwan.net/poem37624.html","مجزوء الكامل"],[560,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"]],"verses":[["ولِمِثْلِها أعْدَدْتُ كُلَّ قصيدَةٍ","نَفَرَتْ فَآنَسَها الجَوادُ المُنعِمُ",0,"م",1,0],["وَلِمِثلِ الَّذي جَمَعتَ مِنَ العُد","دَةِ تَأبى حُكومَةَ المُقتالِ",1,"ل",1,0],["ولمثلها الضَّلِّيل ضلَّ فكيف لو","يُدْعى تكلف بدأةً وجوابا",2,"ب",2,0],["ولمثلي يَخْتَارُ رُوَّادُ مُرْتا","دٍ ولكن إنْ ناصَحَتْهُ الجُيوبُ",3,"ب",1,0],["ولَمثْلُ وجْهكَ لاحَ أوَّل سَابِقٍ","وَغَدَا مُفَدَّىً في الكرام مُمَسَّحا",4,"ح",2,0],["ولمثلُه رَكِبَ المهيبةَ وحدَهُ","وتحمَّلَ العظمى بغير مَواس",5,"س",1,0],["ولمثل نار الثكل وهي شديدة","خلق الرحيم لنا الشئون وماءها",6,"ا",3,0],["وَلِمِثلِ وَصلِكِ أَن يَكونَ مُمَنَّعاً","وَلِمِثلِ نَيلِكِ أَن يَكونَ خَسيسا",7,"س",2,0],["ولَمِثلُك استعلَى بكلّ فضيلة","ورأى الحنوَّ على ذوي الأرحامِ",8,"م",1,0],["ولمثل ذا فليعمل الاقوام او","فليفسحوا عند الزحام لمن عزم",9,"م",1,0],["وَلِمثله مَن ليس يخفق ظنّه","وَلمثلِ وسمكِ بغيةُ المتوسّمِ",10,"م",1,0],["ولِمْ ثَقُلَتْ ريحُ الصَّبا مُذْ رحلْتُم","وكانتْ برَدْعِ المِسْكِ طَيِّيةَ النَّشر",11,"ر",1,0],["ولمثل ذلك كنتُ أذخُر سَلوتي","فطلَبتُها فوجدتُ رسماً داثِرا",12,"ر",2,0],["ولِمِثْلِها قادَ ابنُ شَنْجٍ نَفَسَهُ","وجُنودَهُ فِي طاعَةٍ لَكَ قائِدَهْ",13,"د",2,0],["ولمثل غرّتك الكريمة أن يُرى","حَمْلُ امرىء ما ليس بالحَمّالِ",14,"ل",1,0],["ولمثلها فيديمه","ولمثله فيديمها",15,"م",3,0],["وَلِمثلي عَلَيكَ نُصحٌ وَقَد كا","نَ فَهَذا مِمَّا تَخيَّرتُ ذُخرا",16,"ر",2,0]]}