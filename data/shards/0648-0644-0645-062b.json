{"poems":[[65,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[74,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[53,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[87,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[45,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[234,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[290,"يا سيد ما أنت إلا سيد","https://www.aldiwan.net/poem39427.html","الكامل"],[310,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[369,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[376,"ما كان يدري كيف يصبح هاجرا","https://www.aldiwan.net/poem57466.html","البسيط"],[445,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[463,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[484,"فلتحى تونس وليعش","https://www.aldiwan.net/poem37624.html","مجزوء الكامل"],[567,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138256",""],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53772","الكامل"],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145908","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72279","الكامل"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130586","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52062","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88646","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200896","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108403",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108363",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91078","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36800","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120405","الكامل"],[3591,"حاشا لهجرك أن يكون طوببلا","https://www.poetsgate.com/ViewPoem.aspx?id=149394",""],[5183,"رباه","https://www.poetsgate.com/ViewPoem.aspx?id=186597",""],[5320,"صغيرى الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=40902",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""]],"verses":[["ولِمِثْلِها أعْدَدْتُ كُلَّ قصيدَةٍ","نَفَرَتْ فَآنَسَها الجَوادُ المُنعِمُ",0,"م",1,0],["وَلِمِثلِ الَّذي جَمَعتَ مِنَ العُد","دَةِ تَأبى حُكومَةَ المُقتالِ",1,"ل",1,0],["ولمثلها الضَّلِّيل ضلَّ فكيف لو","يُدْعى تكلف بدأةً وجوابا",2,"ب",2,0],["ولمثلي يَخْتَارُ رُوَّادُ مُرْتا","دٍ ولكن إنْ ناصَحَتْهُ الجُيوبُ",3,"ب",1,0],["ولَمثْلُ وجْهكَ لاحَ أوَّل سَابِقٍ","وَغَدَا مُفَدَّىً في الكرام مُمَسَّحا",4,"ح",2,0],["ولمثلُه رَكِبَ المهيبةَ وحدَهُ","وتحمَّلَ العظمى بغير مَواس",5,"س",1,0],["ولمثل نار الثكل وهي شديدة","خلق الرحيم لنا الشئون وماءها",6,"ا",3,0],["وَلِمِثلِ وَصلِكِ أَن يَكونَ مُمَنَّعاً","وَلِمِثلِ نَيلِكِ أَن يَكونَ خَسيسا",7,"س",2,0],["ولَمِثلُك استعلَى بكلّ فضيلة","ورأى الحنوَّ على ذوي الأرحامِ",8,"م",1,0],["ولمثل ذا فليعمل الاقوام او","فليفسحوا عند الزحام لمن عزم",9,"م",1,0],["وَلِمثله مَن ليس يخفق ظنّه","وَلمثلِ وسمكِ بغيةُ المتوسّمِ",10,"م",1,0],["ولِمْ ثَقُلَتْ ريحُ الصَّبا مُذْ رحلْتُم","وكانتْ برَدْعِ المِسْكِ طَيِّيةَ النَّشر",11,"ر",1,0],["ولمثل ذلك كنتُ أذخُر سَلوتي","فطلَبتُها فوجدتُ رسماً داثِرا",12,"ر",2,0],["ولِمِثْلِها قادَ ابنُ شَنْجٍ نَفَسَهُ","وجُنودَهُ فِي طاعَةٍ لَكَ قائِدَهْ",13,"د",2,0],["ولمثل غرّتك الكريمة أن يُرى","حَمْلُ امرىء ما ليس بالحَمّالِ",14,"ل",1,0],["ولمثلها فيديمه","ولمثله فيديمها",15,"م",3,0],["وَلِمثلي عَلَيكَ نُصحٌ وَقَد كا","نَ فَهَذا مِمَّا تَخيَّرتُ ذُخرا",16,"ر",2,0],["ولمثل محمود المكارم أثمرت","عند المواطن بالوفاء وعود",17,"د",1,0],["ولمثله بكت العيون صبابة","ولمثله حزنت عليه الأنفسُ",18,"س",1,0],["ولمثله قاد الجياد عدوه","فخبا له قدح وخاب قداح",19,"ح",1,0],["ولمثل ما صاروا إليه","من الفناء غداً نصير",20,"ر",1,1],["ولمثل ما جربت من","أخلافهن لذي الوصال",21,"ل",1,0],["وَلِمِثلِهِ مِنْ كُلّ مَا تُعنَى بِهِ","خَطَرٌ كَمَا قَدْ كُنتَ أنْتَ خَطِيراً",22,"ر",2,0],["وَلمثله نعم التسلي","بالحَبيب الى الطبايع",23,"ع",1,0],["ولمثلي صيغ الجمال ومالي","منه إلا الحنين والزَفراتُ",24,"ت",1,0],["ولمثل عبد الله توهب انفسٌ","وبنون وهو بهم احق كريم",25,"م",1,0],["ولمثله نظمي جدير انما","لسواه كان قد اقتضاه شؤون",26,"ن",1,0],["وَلمثلها لا يُرتَجى إِلّا الَّذي","أَحيى النُفوسَ وَطَهّر الأَرواحا",27,"ح",2,0],["وَلِمثل فَيضِكَ أَو يُؤخِّر ساعَةً","عَنهُ وَهَذا الوَقتُ وَقتَ أَوانِهِ",28,"ن",2,0],["ولمثل مدح جنابه","يتعمد المتعمد",29,"د",1,0],["ولمثل وجهك أن يكون مغيباً","ولصبر قلبي أن يكون جميلا",30,"ل",2,0],["ولمثَّلت جسرا يقوم على الهوا","فمن الركيزة في السحيق النائي",31,"ا",2,0],["ولمثل من ضربوا سأبعث ضربتى","تجتز رأس رضيعهم قبل النساء",32,"ا",2,0],["ولمثله تبكي الحذاق وقل أن","تبكي الحذاق أسى لرب حذاق",33,"ق",1,0]]}