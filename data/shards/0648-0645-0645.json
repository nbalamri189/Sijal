ت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[432,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[437,"صدرت ولم أنقع بكم غلة الصدر","https://www.aldiwan.net/poem2557.html","الطويل"],[437,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[437,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[441,"الحمد الله رب اللوح واللوح","https://www.aldiwan.net/poem14288.html","البسيط"],[441,"فدونك من جزء الضياء مسائلاً","https://www.aldiwan.net/poem14413.html","الطويل"],[448,"وممدودة كيد المجتدى","https://www.aldiwan.net/poem53792.html","المتقارب"],[452,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[458,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[458,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[458,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[461,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[461,"سأبعثها بين البيوت شوازيا","https://www.aldiwan.net/poem15127.html","الطويل"],[461,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[461,"تقيل نوشروان بعد ذهابه","https://www.aldiwan.net/poem16034.html","الطويل"],[461,"إذا نعمة الإنسان لم تك قربة","https://www.aldiwan.net/poem16073.html","الطويل"],[464,"عليك سلام الله مني فأنني","https://www.aldiwan.net/poem3290.html","عموديه"],[464,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[464,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[468,"ومما شجاني أن دهري أذلني","https://www.aldiwan.net/poem59785.html","الطويل"],[468,"ومما شجاني أن يوم وداعهم","https://www.aldiwan.net/poem59879.html","الطويل"],[477,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[477,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[477,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[477,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[477,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[477,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[477,"صباه الهوى ما أحوج الخلو أن يصبو","https://www.aldiwan.net/poem15336.html","الطويل"],[493,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[500,"يا بارقا قد تلوى","https://www.aldiwan.net/poem37978.html","المجتث"],[500,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[514,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[551,"قالوا الحبيبة تيمتك","https://www.aldiwan.net/poem47322.html","مجزوء الكامل"],[551,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[551,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[551,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[551,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[551,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[551,"على مثله تذرى العيون دماء","https://www.aldiwan.net/poem48115.html","الطويل"],[553,"تحملت هجر الشادن المتدلل","https://www.aldiwan.net/poem68417.html","الطويل"],[558,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[575,"كأنك بي قد مت بعد قليل","https://www.aldiwan.net/poem2884.html","الطويل"],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[575,"فراق قضى للهم والقلب بالجمع","https://www.aldiwan.net/poem3053.html","الطويل"],[586,"خذ من حديثي ما يغنيك عن نظري","https://www.aldiwan.net/poem17531.html","البسيط"],[587,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["وَمُمتَرِقٍ إِلى العَلياءِ حَتّى","يُجاوِزُ مَدَّ غايَةِ كُلِّ عالِ",0,"ل",1,0],["وَمِمّا يُعَزّي المَرءَ ما شاءَ أَنَّهُ","يَرى نَفسَهُ في المَيِّتينَ مُعَرَّقا",1,"ق",2,0],["وَمِمّا يُحَلِّلُ ذَمَّ الزَما","نِ إِقصاؤُهُ الماجِدينَ الخِيارا",2,"ر",2,0],["وَمِمّا يُطيبُ النَفسَ بَعدَكَ أَنَّني","عَلى قَرَبٍ مِن ماءِ وِردِكَ أَو قُربِ",3,"ب",1,0],["وَمِمّا يُزَهِّدُني في الزَمانِ","وَيَجذِبُني عَن جَميعِ الوَرى",4,"ا",1,0],["وَمِمّا شاقَني بِالرَّملِ بَرقٌ","قَصيرٌ خَطوُهُ وَاللَيلُ طالا",5,"ل",2,0],["وَمِمَّا شَجاني بَعْد وُرْقٍ تَجاوَبَتْ","مُطَوَّقَةٌ تُطْلَى بِوَرْسٍ سَراتُها",6,"ت",3,0],["وممّا أذاعَتْهُ يومَ العُذَيْبِ","مَهارى بسِرْبِ عَذارى حُدِينا",7,"ن",2,0],["ومِمَّا أذاعَ السِّرَ وَرْقاءُ كلَّما","أمَلْتُ إلَيها السَّمْعَ نَمَّتْ بأسْراري",8,"ر",2,0],["وممّا شَجاني أنْ مرَرْتُ بمَكْتَبٍ","فهيّجَ وجْدي للزّمانِ الذي ولّى",9,"ل",2,0],["وممّا شَجاني والشّجونُ كثيرةٌ","ولا غَرْوَ أن يَشْقَى امْرُؤٌ ببِعادِهِ",10,"د",2,0],["وَمَملوكَةٍ عِندي حَديثٌ نِتاجُها","أَتَتني بِمَولودٍ وَما بَلَغَت شَهرا",11,"ر",2,1],["وَمَملوكَةٍ عِندي عَزيزٍ نِجارُها","عَلَيها حُلِيٌّ مِن لُجَينٍ وَمِن تِبرِ",12,"ر",1,1],["وَمَملوكَةٍ أَنسابُها فارِسِيَّةٌ","لَها لينُ مَولىً تَحتَ قُوَّةِ والي",13,"ل",2,1],["ومما أجدَّ الوجد سربٌ على النّقا","سوانح يصقلن الطّلَى والتراقيا",14,"ي",2,0],["ومما شجاني أنْ سرى الركبُ مَوْهناً","تُقاد به هوج الرياح بأرسانِ",15,"ن",1,0],["ومما شجا نفسي ذُبول بخدّها","كما ذبلت في بيتها باقة الزهر",16,"ر",1,0],["ومما سرَّني أني أناجي","رجالاً في الفَخار ذوي ابتداع",17,"ع",1,0],["ومما ازدهى نفسي وزاد ارتياحها","هبوب نسيم سجسجٍ طيب النشر",18,"ر",1,0],["وَمُمسِكٍ بِصُداعِ الرَأسِ مِن سُكُرٍ","نادَيتُهُ وَهوَ مَغلوبٌ فَفَدّاني",19,"ي",1,1],["ومما عناني عاذلٌ متنصحٌ","وما الغش إلا ما سمعت من النصح",20,"ح",1,0],["وممَّا شجاني في الضحى صوت ساجع","كأني له بعد الحبيب أطارح",21,"ح",1,0],["وممتدح يلقاك منه إذا بدَا","مديد العلى باهي المحيا أغرّه",22,"ر",2,0],["وممتدح لهفان يسألك الغنى","أجزت معاني مدحه بسؤاله",23,"ل",2,0],["وممَّا شجاني أن جفنيَ ساهرٌ","على كلّ فتَّان اللواحظ وسنان",24,"ن",1,0],["وممدَّح يحصى لمادح فضله","مصغ فنوّر يا ربيع ونوّه",25,"ه",1,0],["وممنوع الوصال إذا تبدَّى","وجدت له من الألفاظِ لالا",26,"ل",2,0],["وَمَماتي في حَياتي","وَحَياتي في مَماتي",27,"ت",2,0],["ومما حداك الشوقَ نوحُ حمامة","أرنَّتْ على خُوطٍ من البانِ أهدبِ",28,"ب",1,0],["ومما أشتهيه دُرورُ رزقي","وأن أُعطَاه موفورَ الذَّنوبِ",29,"ب",1,0],["وممنوحهُ مثلُ ممنوعِهِ","ومكسوُّهُ مثلُ مسلوبِهِ",30,"ب",2,0],["ومما ينسِّيك الأَسى حسناتُها","وإن كنت منها يا أخا الحسناتِ",31,"ت",1,0],["وممّا أرى أنَّ النوالَ إذا أتى","على الكرهِ كان المنعُ خيراً من البذلِ",32,"ل",1,0],["ومما أشتكي أني فريدٌ","وأن الناس كلهم بُعولُ",33,"ل",1,0],["وَمُمَرَّةٍ أَثَرُ السِلاحِ بِنَحرِها","فَكَأَنَّ فَوقَ لَبانِها جِريالا",34,"ل",2,0],["وَمِمَّن يَصفَقُّ لِلضارِبِ","وَأَحبابُهُ يَجرَعونَ الحُتوف",35,"ف",1,0],["وَمِمّا دَهاني حِرفَةٌ أَدَبِيَّةٌ","غَدَت دونَ إِدراكِ المَطالِبِ خَندَقا",36,"ق",2,0],["وَمِمّا دَهاني أَنَّهُ مِن حَيائِهِ","أَقولُ كَليلٌ طَرفُهُ وَهوَ مُرهَفُ",37,"ف",1,0],["وممثلين يضارعون عنادلا","وممثلات تشبه الاورادا",38,"د",2,0],["وممالك ابنك تزدهي","ورعية ابنك في حبور",39,"ر",1,0],["وَمُمَهَّدٌ في الوَكرِ مِن","وَلَدِ الغُرابِ مُزَقَّق",40,"ق",1,1],["وَمُمَثِلَ المِصرِيِّ في","حَظِّ الشُعوبِ مِنَ الهِباتِ",41,"ت",1,0],["وَمَملَكَةُ اليونانِ مَحلولَةُ العُرى","رَجاؤُكَ يُعطيها وَخَوفُكَ يُسلَبُ",42,"ب",1,0],["وَمَمْلُوءٍ مِنَ الحَزَنِ","يعالجُ سَوْرَةَ الأَرَقِ",43,"ق",1,1],["ومُمَشّقِ الحركاتِ تَحْسَبُ نِصْفَهُ","لولا التَمَنْطُقُ مائلاً عن نِصْفِهِ",44,"ه",1,1],["وَمُمطِرَ المَوتِ وَالحَياةِ مَعاً","وَأَنتَ لا بارِقٌ وَلا راعِد",45,"د",1,0],["وممهِّدٌ لي إنْ أقمتُ لديكُمُ","جاهاً عريضاً يُتَّقَى بالرَّاحِ",46,"ح",1,0],["وَمِمّا يُعَنّي النَفسَ كُلَّ عَنائِها","تَوَقُّعُها الصُنعَ البَطيءَ تَقارُبُه",47,"ب",2,0],["وَمِمّا دَهى الفِتيانَ أَنَّهُمُ غَدَوا","بِآخِرِ شَعبانٍ عَلى أَوَّلِ الوَردِ",48,"د",1,0],["وَمِمّا يُبَدِّدُ لُبَّ الحَليمِ","حُسنُ القَوامِ وَفَترُ النَظَر",49,"ر",1,0],["وَمُملِقينَ مِنَ الأَحسابِ يَفجَؤُهُم","ساهينَ عَن كَرَمِ الأَفعالِ لاهينا",50,"ن",2,0],["وممَّا شيَّدَ الشَّرَفَ المُعَلَّى","ذُنُوبٌ صادَفَتْ منك اغتِفارا",51,"ر",2,0],["ومُمطرُ أرضِ الرُّومِ من دَمِ أهلِها","سَحاباً إذا رَوَّى الثَّرى منه أحمدَا",52,"د",2,0],["ومُمنَّعٍ يُردي العدوَّ إذا ارتدَى","بالسَّيفِ أو يحبُو الوليَّ إذا احتَبا",53,"ب",2,0],["وممتنعٌ جِلْبابُه الغيمُ في الضُّحى","وحِلْيتُه في الليلِ زُهْرُ الكواكبِ",54,"ب",1,0],["وَمُمَهِّدَ الفُرشِ الوَثيرَةِ لا","تُغفِل فِراشَ الرَقدَةِ الكُبرى",55,"ا",1,0],["وَمِمّا يُسَلّي النَفسَ حُسنُ اِنتِقالِهِ","عَفيفَ إِزارٍ لا يُناطُ بِهِ وِزرُ",56,"ر",1,0],["ومميتُ الحراكِ منه سكونٌ","مظهرٌ فعلَهُ بسرٍّ خفيِّ",57,"ي",1,0],["وممشوقةِ القدّ معشوقةٍ","تُعَذِّبُ أنفُسَ عُشّاقها",58,"ق",3,1],["وَمِمّا ضَرَّمَ البُرَحاءَ أَنّي","شَكَوتُ فَما شَكَوتُ إِلى رَحيمِ",59,"م",1,0],["وَمِمّا كانَتِ الحُكَماءُ قالَت","لِسانُ المَرءِ مِن خَدَمِ الفُؤادِ",60,"د",1,0],["وَمَمشى فَتاةٍ بِالكِساءِ تَكُنُّنا","بِهِ تَحتَ عَينٍ بَرقُها يَتَأَلَّقُ",61,"ق",1,0],["وَمِمّا شَجاني أَن قَضى حَتفَ أَنفِهِ","وَما اِندَقَّ رُمحٌ دونَهُ وَذُبابُ",62,"ب",1,0],["وَمِمّا شَجاني أَنَّها يَومَ وَدَّعَت","تَقولُ لَنا أَستَودِعُ اللَهَ مَن أَدري",63,"ر",2,1],["وَمِمّا شَجاني أَنَّها يَومَ وَدَّعَت","تَوَلَّت وَماءُ العَينِ في الجَفنِ حائِرُ",64,"ر",1,1],["وَمَمشى ثَلاثٍ بَعدَ هدءٍ كَواعِبٍ","كَمَثلِ الدُمى بَل هُنَّ مِن ذاكَ أَنضَرُ",65,"ر",1,0],["وِمِمّا يَهيجُ القَلبَ يا صاحِ نَحوَها","إِذا باكَرَ الأَيكَ الحَمامُ السَواجِعُ",66,"ع",1,0],["وَمُمتَرِسٍ بِالماءِ أَحرَقَهُ الظَما","تَحَلّا فَلا يَندى وَلا هُوَ مُمَثَلُ",67,"ل",1,0],["وَمِمّا شَجاني بارِقٌ لاحَ مَوهِناً","فَأَكفا إِناءَ الدَمعِ وَاِستَلَبَ الغُمضا",68,"ض",2,1],["وَمُمَزِّقٍ طاقَينِ قَد سُمِطا","يَهوى غُلاماً وارِمَ الرَأبِ",69,"ب",1,0],["وممّا أعانَ عليّ الزّمَانَ","عَفافُ يَدي وعُلُوُّ الهِمَم",70,"م",1,0],["ومِمّا شَجَاني في العَلاقَةِ أنّني","شَرِبْتُ ذُعافاً قاتِلاً لَذَّ في فمي",71,"م",2,0],["وَمَمشاكَ إِلى الدِعصِ ال","رُكامِ اللَيِّنِ الأَعفَر",72,"ر",1,0],["وَمَمسوكَةٍ عَذراءَ يَحمِلُها فَتىً","وَلَم تَعيَ كَفّاهُ وَلَم يَدمَ غارِبُه",73,"ب",2,0],["وَمِمّا أَدامَ الرُزءَ تَكذيبُ صادِقٍ","عَلى خُبرَةٍ مِنّا وَتَصديقُ كاذِبِ",74,"ب",1,0],["وَمِمّا يَزيدُ العَيشَ إِخلاقَ مَلبَسٍ","تَأَسُّفُ نَفسٍ لَم تُطِق رَدَّ ذاهِبِ",75,"ب",1,0],["ومُمْتحِنٍ لقاءكَ وهو موْتٌ","وهل يُنْبي عن المَوْتِ امْتِحانُ",76,"ن",1,0],["وَمِمّا يسلِّي النفس منيَ علمُها","بأن بقاء الشيء لا يتيسر",77,"ر",1,0],["وَمِمَّا شَجَانِي بَارِقٌ طَارَ مَوْهِناً","كَمَا طَارَ مُنْبَثُّ الشَّرَارِ مِنَ الزَّنْدِ",78,"د",1,0],["وَمِمَّا يَضِيمُ الحُرَّ شِقْوَةُ مَوْطِنٍ","بَنُوهُ نِيَامٌ عَنْهُ وَالحُر ذَائِد",79,"د",1,0],["وَمِمَّا أَكْبَرَ الإِخْوَانُ فِيهِ","خلاَئِقَ لَيْسَ فِيَهَا مَا يَريِبُ",80,"ب",1,0],["وَمِمَّا بِهِ تَقْضِي سَوَابِقُ عَهْدِنَا","بِهَا أََْن يُرَى قَلْبٌ لِمِصْرَ شَكُورُ",81,"ر",1,0],["وَمِمّا شَجاني أَنَّ لَيلى تَغَيَّظَتْ","فَقالَت سِراراً وَالمَطِيُّ بِنا تَخدِي",82,"د",2,0],["ومما شجاني أن مررت بمكتب","فهيج وجدي للزمان الذي ولا",83,"ل",2,0],["ومما استفرغ اللذاتِ إلا مشيَّعٌ","إذا همَّ لم يذكر رضى من تغضبا",84,"ب",2,0],["وممثلينَ تصنّعاً ووراءَهمْ","خَلْفَ السِتار مُلّقِنٌ مُتواري",85,"ر",2,0],["ومما يهوِّن وقَع الحِمام","أن ليس للمرء منه مفر",86,"ر",1,0],["ومما شجا أن الثلاثة قادهم","لما قادني حَظٌ عن الكل شارد",87,"د",1,0],["ومما دهاني والقلوب ذواهل","هناك وطير الموت جاث وواقع",88,"ع",1,0],["ومملكةٌ رهنُ المشيئاتِ أمرُها","وأنظمةٌ يُلهى بهنَّ ويُلْعَب",89,"ب",1,0],["ومُمْلِقِينَ مِنَ الأَحْسَابِ يَفْجَأْهُمْ","سَاهِينَ عَنْ كَرَمِ الأَفْعَالِ لاَهِينَا",90,"ن",2,0],["ومميتُ الحراكِ من سكونٌ","مظهرٌ فعلهُ بسرٍّ خفيّ",91,"ي",1,0],["وممّن يظنّ الفقر عذرا لكفره","وما أقنع الإيمان إلاّ الرّدى عذر",92,"ر",1,0],["وممّا دَهَتْنِي دون عيني عينُها","لكنَّ غِبَّ النظرتيْن وخيم",93,"م",1,0],["وَمَمْشَى فَتاة ٍ بِکلْكِسَاءِ تَكُنُّنا","بِهِ تَحْتَ عَيْنٍ بَرْقُها يَتأَلَّقُ",94,"ق",1,0],["ومملكتي هودج من رياح","تروح عجولا … وتأتي خفيفه",95,"ف",2,0],["ومِمَّا قد بَلَوتُ نَدَاهُم في","تَلَكّى الدَّهرِ والمَحلِ العَمِيمِ",96,"م",1,0],["ومِمَّا سِوَاهُ عالمٌ فَرضَ عَينِهِ","وَيرجُون لِمَا لَم يَعلَم أَن يَتَعَلَّمَا",97,"م",2,0],["ومِمَّا قَد شَجَاني فِيهِ أني","ذَكَرتُ دُهَيرَه زَمَنَ الوُصَيلِ",98,"ل",1,0],["وَمِمّا شَجاني أَنَّني بِتّ مُغرَماً","بِأَزهَرَ يَحكِي البَدرَ حُسناً وَمَنظَرا",99,"ر",2,0],["وممشوقٍ من الفِتيانِ يُدعَى","لكلِّ عظيمةٍ فيجيب هَلاَّ",100,"ل",2,0],["وَمَملَكَةٍ نَصرِيَّةٍ صالِحِيَّةٍ","هَمَتها العَوالي وَالرِهافُ القَواضِبُ",101,"ب",1,0],["وَمُمَنطَقٍ يُغني النَديمَ بِوَجهِهِ","عَن كَأسِهِ المَلأى وَعَن إِبريقِهِ",102,"ق",2,0],["وَمِمّا شَفَّني وَجدٌ عَزيزٌ","يُحاوِلُ قَهرَهُ صَبرٌ ذَليلُ",103,"ل",1,0],["وَمُمَوَّلٌ عَبَدَ الثَراءَ فَعَدَّهُ ال","راجونَ فيمَن يَعبُدُ الأَصناما",104,"م",2,0],["وَمِمّا جَرى كَالوَسمِ في الدَهرِ قَولُهُم","عَلى نَفسِهِ يَجني الجَهولُ وَيُجرِمُ",105,"م",1,0],["وَمِمّا يَزيدُ بِكُم لَوعَةً","وُلوعُ العَواذِلِ وَالعَذلُ لَغوُ",106,"و",1,0],["وممّا يشقّ على الحرِّ أنْ","يقالَ لكلٍّ منَ الناسِ حُرّ",107,"ر",1,0],["وَمِمّا شَجاني يا لَقَومي فَعبرَتي","لَدى كُلِّ حينٍ لا يَجِفُّ اِنسِكابُها",108,"ب",3,0],["وَمِمَّا شَجانِي أَنَّهُ حِينَ جاءَنِي","يَزِفُّ عُقاراً فِي غِلالَةِ نُورِ",109,"ر",1,1],["ومماشاة بغيض","ومقاساة ثقيل",110,"ل",1,0],["ومملك أبصرتهُ","مستعملا خلقا شنيعا",111,"ع",2,1],["وممّا شجاني أن خبزي مكرّج","ومن دون هذا الفعل طاب التهوّد",112,"د",1,0],["ومما يسكنُ وجد الفتى","رفيقٌ تطيب به الصحبه",113,"ب",2,0],["وَممدَّ الأشباحِ فرعاً وأصلا","إِن حكاكَ الأنامُ يا نورُ شَكلا",114,"ل",2,0],["وَمَم لَهُ فِينَا يَداً قَد سَلَفَت","وَكَفُّهُ ما اَتلَفَتهُ اَخلَفَت",115,"ت",1,0],["وَممّا يَقوّي فيهِ ظَنّيَ أَنَّهُ","سَمِيُّ نَبيٍّ مُرسَلٍ شافَهُ الوَحيا",116,"ح",3,0],["وممَّا طوى قلبي على الحزن أنني","أرى الوصلَ موروداً ومالي به وِرْدُ",117,"د",1,0],["وممّا تمثّله الفارسيُّ","وأودَعَه بطنَ قرطاسِهِ",118,"س",2,0],["ومما جناه الدهر اصبح تائباً","ومعتذراً قد جاء والعذر شافع",119,"ع",1,0],["ومما استهام القلبَ وهو مصدَّع","وأوهَى جُمانَ الدمع وهو سِجامُ",120,"م",1,0],["وممن يكونُ غِياثَ البلاد","فيُبدِل بالروضِ إمحالها",121,"ل",3,0],["وممن تراهم غداة الهياج","مَغاويرَ حرب وأزوالها",121,"ل",3,0],["وَمَماتُهُ خَيرٌ لِأُمَّتِهِ إِذا","عَرَضَت لَها الأَعمالُ في الخمسانِ",122,"ن",1,0],["وَمِمّا شَجاني أَنَّني يَومَ بَينَهِم","شَكَوتُ الَّذي أَلقى إِلى غَيرِ راحِمِ",123,"م",1,0],["وَمِمّا زادَني قَلَقاً فَجَفني","لَهُ دامٍ وَقَلبي مُستَهامُ",124,"م",1,0],["وَمُمَيَّلِ العِطفَينِ أَغيَد","غَضِّ الصِبى بَضِّ المُجَرَّد",125,"د",1,1],["وَمِمَّا يَنْسُبَنْ فِكْرِي","إِلَى الشَّخْزِ أَوِ الأَزِّ",126,"ز",1,0],["وَمِمَّا يَقْتَضِي طَرْدِي","عَنِ التَّوْفِيقِ أَوْ بَهْزِي",126,"ز",2,0],["وَمِمَّنْ يَشْتَهِي ضَُرِّي","وَمِمَّنْ وُدُّهُ جَأْزِي",126,"ز",2,0],["وَمِمَّا يَقْتَضِي نَحْزَهْ","وَمِمَّا يَقْتَضِي نَهْزَهْ",127,"ز",2,0],["وَمِمَّا يَقْطِفُ الذَّنْبَ ال","لَذِي يُصْلِي الْفَتَى رِجْزَهْ",127,"ز",2,0],["وَمِمَّا يَجْتَنِي الْعَيْبَ ال","لَذِي يُكْسِي الْحََشَا رِجْزَهْ",127,"ز",2,0],["وَمُمَنَّعٍ بِجُنُودِهِ وَبُنُودِهِ","شَقِيَتْ عِدَاهُ بِجَيْشِهِ وَبِجَأْشِهِ",128,"ش",2,0],["وَمُمَجَّدٍ وَمُنَجَّدٍ وَمُسَدَّدٍ","مِجْذَامَةٍ مُفْنِي الْفَسَادِ مِحَشِّهِ",128,"ش",2,0],["ومما دهاي واستثار صبابتي","وقرب لي حيني وحان انتظاره",129,"ر",2,0],["ومما يريني الموت حلواً مذاقه","لقاء الأعادي واجتناب الحبايب",130,"ب",1,0],["وَممتنع القوى مستضعف بي","قصمت قواه عني يا حسيب",131,"ب",1,0],["وَمِمَّا شَجَانِي ساجِعٌ فَوقَ سَرْحَة","أَطَلَّتْ إلَى أَلْحَانِهِ في الدُّجَى صَغْوَا",132,"و",2,0],["وَمُمَنطَقٍ عِندَ اِرتِجاجَةِ رِدفِهِ","يَخشى اِنخِزالَ الخَصرِ في هَيمانِهِ",133,"ن",2,0],["وَمَملوكٍ لَهُ في التُركِ آلٌ","يَروعُ وَعِندَهُ لَم يُرعَ إِلُّ",134,"ل",1,0],["وَممشوق القوام دنا لخوْدٍ","تفوقُ بحسنِ طلعتِها العذارى",135,"ر",2,0],["وممالك ومسالك من سالك","ومدارك للشيق المتطلع",136,"ع",1,0],["وَمملكة الإسلامِ يقلصُ ظلّها","وينقصُ مِن أَطرافها ما تضمّهُ",137,"م",2,0],["وَمَمْلُوكَةٍ لي كُلَّما رُمْتُ وَطْأَها","أُقَبِّلُها شَرْطاً عليَّ مُؤَكَّدا",138,"د",2,1],["وَمُمتَحَنُ الحُبِّ الَّذي كَونُهُ بَدا","بِمَخلِصِها أَبدى الفُطورَ لِفِطرَتي",139,"ي",1,0],["وممّا شَفّني أَنْ مَرَّ عنّي","زمانُ صِباً وتلْكَ من الغَبائن",140,"ن",1,0],["وممّا شَجاني يا ابْنةَ القوم أنّني","دَعوْتُ بإخْواني فأقْبلَ خُوّاني",141,"ي",1,0],["وممّا اشتَهى رَبْعةٌ للقِران","متَى نظَر المرءُ فيها خَتَم",142,"م",1,0],["ومُماذِقٌ حَسِبَ المِطالَ يَزيدُني","حُبّاً له فوهَبْتُه لِمِطاله",143,"ل",2,0],["وممَّتعاً أبداً بما","أُوتيتَ مِنْ غُرِّ الخِصال",144,"ل",1,0],["ومُمنَّعاً من طارِقِ ال","حدَثانِ في أَحْمَى الظِّلال",144,"ل",1,0],["ومِمّا هاجَ لي طَرباً خَيالٌ","تأوَّب والدُّجَى مُرخي السُّدول",145,"ل",1,0],["وممَّا شَجاني وقد وَدَّعوا","بُكاءُ الحمامِ على ساقها",146,"ق",3,0],["وممّا شاقَني إيناسُ نارٍ","كلمْعةِ بارقٍ علَتِ البُراقا",147,"ق",2,0],["ومِمّا شجاني أن عفَتْ مِن ديارِها","معاهِدُ لم تُذْمَمْ لهُنَّ عُهود",148,"د",1,0],["وممّا شَجاني والزّمانُ مُقوّضٌ","حَمائمُ غَنّتْ في فروعِ أشاء",149,"ا",2,0],["وَمِمّا أَطابَ النَفسَ أَنَّ سَقامَهُ","سَيَعقُبُهُ وَصلُ الشِفا بِفِراقِهِ",150,"ق",2,0],["وَمِمّا حَكى أَنَّ القُلوبَ حَزينَةٌ","عَلى إِثرِها هَذي الوُجوهُ السَواهِمُ",151,"م",1,0],["وَمُمَزِّقٍ عَنّا القَمي","صَ فَما اِسمُهُ إِلّا المُمَزِّق",152,"ق",1,0],["وممنوعَةٍ بالصوم في كلِّ حجَّةٍ","ثلاثينَ يَوماً ثم تأتي شُهورُها",153,"ر",3,0],["وَمُمتع بِحَديث","مُسَلسل رَقراق",154,"ق",1,0],["وَمِما شَجا لي بَعدَ الفُرا","ق وَقَد تَقتل الصَب أَشجانِهِ",155,"ن",2,0],["وَمَمنع مِما يَتيهُ","يَكاد يغضبهُ الوِداد",156,"د",1,0],["وَمَمنع يَشقي بِهِ ال","مُشتاق وَهُوَ منعم",157,"م",1,0],["وَمَمنع سَلب العُقو","ل مِن الوَرى بِجَمالِهِ",158,"ل",2,0],["ومملوك وزوج","واخوان وأخوات",159,"ت",1,0],["ومما شجاني والعواذل وقف","ولي أذن صمت هناك عن العذل",160,"ل",1,0],["وَمِمّا يُسلّي خطَّة العَرض أَنَّها","وَضُرَّتَها في خطَّة لانتِقالِهِ",161,"ل",2,0],["ومُماذقٍ رَجْعُ النّداءِ جَوابُهُ","فإذا عَرا خطبٌ فأبعدُ مَن دُعِي",162,"ي",1,0],["وممَّا شجانيَ وُرْقُ الغُوَير","تُرَدّدُ في الدَّوح صوتاً وخيما",163,"م",2,0],["وممَّا يُريعُ الرُّوح قولك بعده","قريب من الإِحسانِ أصبح نائيا",164,"ي",2,0],["ومما زاد في حُسْنِك","عند النَّاس إحسان",165,"ن",1,0],["وممَّا صبوَةٍ وصباً أصابا","مراماً باجتماعهما ومرمى",166,"م",2,0],["وممَّا سَرَّني وأزالَ همِّي","دُنُوِّي من جنابك واقترابي",167,"ي",1,0],["وممَّا جوًى تطوي عليه ضلوعها","بكت بدمٍ قان فطال بكاها",