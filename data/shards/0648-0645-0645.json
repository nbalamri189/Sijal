{"poems":[[53,"لمن دمن بذي سلم وضال","https://www.aldiwan.net/poem29896.html","الوافر"],[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"على أي غرس آمن الدهر بعدما","https://www.aldiwan.net/poem30730.html","الطويل"],[53,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[63,"وركب يزجرون على وجاها","https://www.aldiwan.net/poem45719.html","الوافر"],[63,"ومرتبع لذنا بأذيال دوحه","https://www.aldiwan.net/poem45881.html","الطويل"],[63,"كتمنا الهوى وكففنا الحنينا","https://www.aldiwan.net/poem46144.html","المتقارب"],[63,"سرت وظلام الليل ستر على الساري","https://www.aldiwan.net/poem46202.html","الطويل"],[77,"تذكرت عهدا للشباب الذي ولى","https://www.aldiwan.net/poem35727.html","الطويل"],[77,"نبا الجنب مني عن وثير مهده","https://www.aldiwan.net/poem36610.html","الطويل"],[71,"ومملوكة عندي حديث نتاجها","https://www.aldiwan.net/poem3851.html","الطويل"],[71,"ومملوكة عندي عزيز نجارها","https://www.aldiwan.net/poem3861.html","الطويل"],[71,"ومملوكة أنسابها فارسية","https://www.aldiwan.net/poem3889.html","الطويل"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[88,"وبيضاء أغناها عن الحلي ثغرها","https://www.aldiwan.net/poem44839.html","الطويل"],[88,"يعيش الناس في حال أجتماع","https://www.aldiwan.net/poem44982.html","الوافر"],[88,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[23,"وممسك بصداع الرأس من سكر","https://www.aldiwan.net/poem21307.html","البسيط"],[72,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[72,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[72,"هنيئا لأفق الفضل إنك بدره","https://www.aldiwan.net/poem18711.html","الطويل"],[72,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[72,"بكيت وما يجدي البكاء على العاني","https://www.aldiwan.net/poem20162.html","الطويل"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[72,"بدت ورنت لواحظه دلالا","https://www.aldiwan.net/poem20544.html","الوافر"],[64,"أقتلوني يا ثقاتي","https://www.aldiwan.net/poem67662.html","الرمل"],[51,"طربت ولم تطرب على حين مطرب","https://www.aldiwan.net/poem8178.html","الطويل"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"إذا أنت أزمعت الصنيعة مرة","https://www.aldiwan.net/poem65931.html","الطويل"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[91,"جلست وقد هجع الغافلون","https://www.aldiwan.net/poem8802.html","عموديه"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[70,"أغصن النقا لولا القوام المهفهف","https://www.aldiwan.net/poem42817.html","الطويل"],[89,"أبدى يمثل يوسف واعادا","https://www.aldiwan.net/poem44753.html","الكامل"],[85,"أم الملائك والبدور","https://www.aldiwan.net/poem6815.html","مجزوء الكامل"],[85,"وممهد في الوكر","https://www.aldiwan.net/poem7930.html","مجزوء الكامل"],[85,"ضجت لمصرع غالب","https://www.aldiwan.net/poem62908.html","مجزوء الكامل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[56,"ومملوء من الحزن","https://www.aldiwan.net/poem58543.html","مجزوء الوافر"],[56,"وممشق الحركات تحسب نصفه","https://www.aldiwan.net/poem58549.html","الكامل"],[43,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[62,"مولاي أكرم من ألوذ بظله","https://www.aldiwan.net/poem52461.html","الكامل"],[45,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[45,"لك الخير ما مقدار عفوي وما جهدي","https://www.aldiwan.net/poem62731.html","الطويل"],[45,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[45,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[61,"فتوحك ردت بهجة الملك سرمدا","https://www.aldiwan.net/poem51728.html","الطويل"],[61,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[61,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"وممشوقة القد معشوقة","https://www.aldiwan.net/poem31373.html","المتقارب"],[44,"أرامة كنت مألف كل ريم","https://www.aldiwan.net/poem30367.html","الوافر"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[31,"أفي رسم دار دمعك المترقرق","https://www.aldiwan.net/poem42041.html","الطويل"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[33,"ومما شجاني أنها يوم ودعت","https://www.aldiwan.net/poem25908.html","الطويل"],[33,"ومما شجاني أنها يوم ودعت","https://www.aldiwan.net/poem25937.html","الطويل"],[40,"أفي رسم دار دمعك المتحدر","https://www.aldiwan.net/poem42309.html","الطويل"],[40,"أقول بأعلى نخلتين وقد مضى","https://www.aldiwan.net/poem42330.html","الطويل"],[40,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[52,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[52,"نطق اللئام فمن يقول","https://www.aldiwan.net/poem27258.html","الكامل"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[50,"ألا يا نفس المسك الذي","https://www.aldiwan.net/poem63800.html","الهزج"],[50,"فيا حزنا هلا بنا كان ما به","https://www.aldiwan.net/poem64837.html","الطويل"],[46,"نهاني عقلي عن أمور كثيرة","https://www.aldiwan.net/poem22169.html","الطويل"],[46,"أجل هبات الدهر ترك المواهب","https://www.aldiwan.net/poem22174.html","الطويل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54628","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54830","الطويل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29958","الطويل"],[77,"تذكرت عهدا للشباب الذي ولى","https://www.poetsgate.com/ViewPoem.aspx?id=34196",""],[50,"خَلِيلَيَّ قُومَا فَاعْذِرَا أوْ تَعَتَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=17139",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"إلى روح العلامة الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=179049",""],[90,"الشاعر السليب !","https://www.poetsgate.com/ViewPoem.aspx?id=178978",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[45,"يَكَادُ عَاذِلُنَا في الحُبِّ يُغْرينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31882",""],[80,"هل أقالَ الحِمامُ عثرة حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=3730",""],[51,"قلبي من الطرفِ السَّقيم سقيمُ","https://www.poetsgate.com/ViewPoem.aspx?id=30512",""],[31,"أَفي رَسْمِ دَارٍ دَمْعُكَ المُتَرَقْرِقُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18981&r=&rc=244",""]],"verses":[["وَمُمتَرِقٍ إِلى العَلياءِ حَتّى","يُجاوِزُ مَدَّ غايَةِ كُلِّ عالِ",0,"ل",1,0],["وَمِمّا يُعَزّي المَرءَ ما شاءَ أَنَّهُ","يَرى نَفسَهُ في المَيِّتينَ مُعَرَّقا",1,"ق",2,0],["وَمِمّا يُحَلِّلُ ذَمَّ الزَما","نِ إِقصاؤُهُ الماجِدينَ الخِيارا",2,"ر",2,0],["وَمِمّا يُطيبُ النَفسَ بَعدَكَ أَنَّني","عَلى قَرَبٍ مِن ماءِ وِردِكَ أَو قُربِ",3,"ب",1,0],["وَمِمّا يُزَهِّدُني في الزَمانِ","وَيَجذِبُني عَن جَميعِ الوَرى",4,"ا",1,0],["وَمِمّا شاقَني بِالرَّملِ بَرقٌ","قَصيرٌ خَطوُهُ وَاللَيلُ طالا",5,"ل",2,0],["وَمِمَّا شَجاني بَعْد وُرْقٍ تَجاوَبَتْ","مُطَوَّقَةٌ تُطْلَى بِوَرْسٍ سَراتُها",6,"ت",3,0],["وممّا أذاعَتْهُ يومَ العُذَيْبِ","مَهارى بسِرْبِ عَذارى حُدِينا",7,"ن",2,0],["ومِمَّا أذاعَ السِّرَ وَرْقاءُ كلَّما","أمَلْتُ إلَيها السَّمْعَ نَمَّتْ بأسْراري",8,"ر",2,0],["وممّا شَجاني أنْ مرَرْتُ بمَكْتَبٍ","فهيّجَ وجْدي للزّمانِ الذي ولّى",9,"ل",2,0],["وممّا شَجاني والشّجونُ كثيرةٌ","ولا غَرْوَ أن يَشْقَى امْرُؤٌ ببِعادِهِ",10,"د",2,0],["وَمَملوكَةٍ عِندي حَديثٌ نِتاجُها","أَتَتني بِمَولودٍ وَما بَلَغَت شَهرا",11,"ر",2,1],["وَمَملوكَةٍ عِندي عَزيزٍ نِجارُها","عَلَيها حُلِيٌّ مِن لُجَينٍ وَمِن تِبرِ",12,"ر",1,1],["وَمَملوكَةٍ أَنسابُها فارِسِيَّةٌ","لَها لينُ مَولىً تَحتَ قُوَّةِ والي",13,"ل",2,1],["ومما أجدَّ الوجد سربٌ على النّقا","سوانح يصقلن الطّلَى والتراقيا",14,"ي",2,0],["ومما شجاني أنْ سرى الركبُ مَوْهناً","تُقاد به هوج الرياح بأرسانِ",15,"ن",1,0],["ومما شجا نفسي ذُبول بخدّها","كما ذبلت في بيتها باقة الزهر",16,"ر",1,0],["ومما سرَّني أني أناجي","رجالاً في الفَخار ذوي ابتداع",17,"ع",1,0],["ومما ازدهى نفسي وزاد ارتياحها","هبوب نسيم سجسجٍ طيب النشر",18,"ر",1,0],["وَمُمسِكٍ بِصُداعِ الرَأسِ مِن سُكُرٍ","نادَيتُهُ وَهوَ مَغلوبٌ فَفَدّاني",19,"ي",1,1],["ومما عناني عاذلٌ متنصحٌ","وما الغش إلا ما سمعت من النصح",20,"ح",1,0],["وممَّا شجاني في الضحى صوت ساجع","كأني له بعد الحبيب أطارح",21,"ح",1,0],["وممتدح يلقاك منه إذا بدَا","مديد العلى باهي المحيا أغرّه",22,"ر",2,0],["وممتدح لهفان يسألك الغنى","أجزت معاني مدحه بسؤاله",23,"ل",2,0],["وممَّا شجاني أن جفنيَ ساهرٌ","على كلّ فتَّان اللواحظ وسنان",24,"ن",1,0],["وممدَّح يحصى لمادح فضله","مصغ فنوّر يا ربيع ونوّه",25,"ه",1,0],["وممنوع الوصال إذا تبدَّى","وجدت له من الألفاظِ لالا",26,"ل",2,0],["وَمَماتي في حَياتي","وَحَياتي في مَماتي",27,"ت",2,0],["ومما حداك الشوقَ نوحُ حمامة","أرنَّتْ على خُوطٍ من البانِ أهدبِ",28,"ب",1,0],["ومما أشتهيه دُرورُ رزقي","وأن أُعطَاه موفورَ الذَّنوبِ",29,"ب",1,0],["وممنوحهُ مثلُ ممنوعِهِ","ومكسوُّهُ مثلُ مسلوبِهِ",30,"ب",2,0],["ومما ينسِّيك الأَسى حسناتُها","وإن كنت منها يا أخا الحسناتِ",31,"ت",1,0],["وممّا أرى أنَّ النوالَ إذا أتى","على الكرهِ كان المنعُ خيراً من البذلِ",32,"ل",1,0],["ومما أشتكي أني فريدٌ","وأن الناس كلهم بُعولُ",33,"ل",1,0],["وَمُمَرَّةٍ أَثَرُ السِلاحِ بِنَحرِها","فَكَأَنَّ فَوقَ لَبانِها جِريالا",34,"ل",2,0],["وَمِمَّن يَصفَقُّ لِلضارِبِ","وَأَحبابُهُ يَجرَعونَ الحُتوف",35,"ف",1,0],["وَمِمّا دَهاني حِرفَةٌ أَدَبِيَّةٌ","غَدَت دونَ إِدراكِ المَطالِبِ خَندَقا",36,"ق",2,0],["وَمِمّا دَهاني أَنَّهُ مِن حَيائِهِ","أَقولُ كَليلٌ طَرفُهُ وَهوَ مُرهَفُ",37,"ف",1,0],["وممثلين يضارعون عنادلا","وممثلات تشبه الاورادا",38,"د",2,0],["وممالك ابنك تزدهي","ورعية ابنك في حبور",39,"ر",1,0],["وَمُمَهَّدٌ في الوَكرِ مِن","وَلَدِ الغُرابِ مُزَقَّق",40,"ق",1,1],["وَمُمَثِلَ المِصرِيِّ في","حَظِّ الشُعوبِ مِنَ الهِباتِ",41,"ت",1,0],["وَمَملَكَةُ اليونانِ مَحلولَةُ العُرى","رَجاؤُكَ يُعطيها وَخَوفُكَ يُسلَبُ",42,"ب",1,0],["وَمَمْلُوءٍ مِنَ الحَزَنِ","يعالجُ سَوْرَةَ الأَرَقِ",43,"ق",1,1],["ومُمَشّقِ الحركاتِ تَحْسَبُ نِصْفَهُ","لولا التَمَنْطُقُ مائلاً عن نِصْفِهِ",44,"ه",1,1],["وَمُمطِرَ المَوتِ وَالحَياةِ مَعاً","وَأَنتَ لا بارِقٌ وَلا راعِد",45,"د",1,0],["وممهِّدٌ لي إنْ أقمتُ لديكُمُ","جاهاً عريضاً يُتَّقَى بالرَّاحِ",46,"ح",1,0],["وَمِمّا يُعَنّي النَفسَ كُلَّ عَنائِها","تَوَقُّعُها الصُنعَ البَطيءَ تَقارُبُه",47,"ب",2,0],["وَمِمّا دَهى الفِتيانَ أَنَّهُمُ غَدَوا","بِآخِرِ شَعبانٍ عَلى أَوَّلِ الوَردِ",48,"د",1,0],["وَمِمّا يُبَدِّدُ لُبَّ الحَليمِ","حُسنُ القَوامِ وَفَترُ النَظَر",49,"ر",1,0],["وَمُملِقينَ مِنَ الأَحسابِ يَفجَؤُهُم","ساهينَ عَن كَرَمِ الأَفعالِ لاهينا",50,"ن",2,0],["وممَّا شيَّدَ الشَّرَفَ المُعَلَّى","ذُنُوبٌ صادَفَتْ منك اغتِفارا",51,"ر",2,0],["ومُمطرُ أرضِ الرُّومِ من دَمِ أهلِها","سَحاباً إذا رَوَّى الثَّرى منه أحمدَا",52,"د",2,0],["ومُمنَّعٍ يُردي العدوَّ إذا ارتدَى","بالسَّيفِ أو يحبُو الوليَّ إذا احتَبا",53,"ب",2,0],["وممتنعٌ جِلْبابُه الغيمُ في الضُّحى","وحِلْيتُه في الليلِ زُهْرُ الكواكبِ",54,"ب",1,0],["وَمُمَهِّدَ الفُرشِ الوَثيرَةِ لا","تُغفِل فِراشَ الرَقدَةِ الكُبرى",55,"ا",1,0],["وَمِمّا يُسَلّي النَفسَ حُسنُ اِنتِقالِهِ","عَفيفَ إِزارٍ لا يُناطُ بِهِ وِزرُ",56,"ر",1,0],["ومميتُ الحراكِ منه سكونٌ","مظهرٌ فعلَهُ بسرٍّ خفيِّ",57,"ي",1,0],["وممشوقةِ القدّ معشوقةٍ","تُعَذِّبُ أنفُسَ عُشّاقها",58,"ق",3,1],["وَمِمّا ضَرَّمَ البُرَحاءَ أَنّي","شَكَوتُ فَما شَكَوتُ إِلى رَحيمِ",59,"م",1,0],["وَمِمّا كانَتِ الحُكَماءُ قالَت","لِسانُ المَرءِ مِن خَدَمِ الفُؤادِ",60,"د",1,0],["وَمَمشى فَتاةٍ بِالكِساءِ تَكُنُّنا","بِهِ تَحتَ عَينٍ بَرقُها يَتَأَلَّقُ",61,"ق",1,0],["وَمِمّا شَجاني أَن قَضى حَتفَ أَنفِهِ","وَما اِندَقَّ رُمحٌ دونَهُ وَذُبابُ",62,"ب",1,0],["وَمِمّا شَجاني أَنَّها يَومَ وَدَّعَت","تَقولُ لَنا أَستَودِعُ اللَهَ مَن أَدري",63,"ر",2,1],["وَمِمّا شَجاني أَنَّها يَومَ وَدَّعَت","تَوَلَّت وَماءُ العَينِ في الجَفنِ حائِرُ",64,"ر",1,1],["وَمَمشى ثَلاثٍ بَعدَ هدءٍ كَواعِبٍ","كَمَثلِ الدُمى بَل هُنَّ مِن ذاكَ أَنضَرُ",65,"ر",1,0],["وِمِمّا يَهيجُ القَلبَ يا صاحِ نَحوَها","إِذا باكَرَ الأَيكَ الحَمامُ السَواجِعُ",66,"ع",1,0],["وَمُمتَرِسٍ بِالماءِ أَحرَقَهُ الظَما","تَحَلّا فَلا يَندى وَلا هُوَ مُمَثَلُ",67,"ل",1,0],["وَمِمّا شَجاني بارِقٌ لاحَ مَوهِناً","فَأَكفا إِناءَ الدَمعِ وَاِستَلَبَ الغُمضا",68,"ض",2,1],["وَمُمَزِّقٍ طاقَينِ قَد سُمِطا","يَهوى غُلاماً وارِمَ الرَأبِ",69,"ب",1,0],["وممّا أعانَ عليّ الزّمَانَ","عَفافُ يَدي وعُلُوُّ الهِمَم",70,"م",1,0],["ومِمّا شَجَاني في العَلاقَةِ أنّني","شَرِبْتُ ذُعافاً قاتِلاً لَذَّ في فمي",71,"م",2,0],["وَمَمشاكَ إِلى الدِعصِ ال","رُكامِ اللَيِّنِ الأَعفَر",72,"ر",1,0],["وَمَمسوكَةٍ عَذراءَ يَحمِلُها فَتىً","وَلَم تَعيَ كَفّاهُ وَلَم يَدمَ غارِبُه",73,"ب",2,0],["وَمِمّا أَدامَ الرُزءَ تَكذيبُ صادِقٍ","عَلى خُبرَةٍ مِنّا وَتَصديقُ كاذِبِ",74,"ب",1,0],["وَمِمّا يَزيدُ العَيشَ إِخلاقَ مَلبَسٍ","تَأَسُّفُ نَفسٍ لَم تُطِق رَدَّ ذاهِبِ",75,"ب",1,0],["ومُمْتحِنٍ لقاءكَ وهو موْتٌ","وهل يُنْبي عن المَوْتِ امْتِحانُ",76,"ن",1,0],["وَمِمّا يسلِّي النفس منيَ علمُها","بأن بقاء الشيء لا يتيسر",77,"ر",1,0],["وَمِمَّا شَجَانِي بَارِقٌ طَارَ مَوْهِناً","كَمَا طَارَ مُنْبَثُّ الشَّرَارِ مِنَ الزَّنْدِ",78,"د",1,0],["وَمِمَّا يَضِيمُ الحُرَّ شِقْوَةُ مَوْطِنٍ","بَنُوهُ نِيَامٌ عَنْهُ وَالحُر ذَائِد",79,"د",1,0],["وَمِمَّا أَكْبَرَ الإِخْوَانُ فِيهِ","خلاَئِقَ لَيْسَ فِيَهَا مَا يَريِبُ",80,"ب",1,0],["وَمِمَّا بِهِ تَقْضِي سَوَابِقُ عَهْدِنَا","بِهَا أََْن يُرَى قَلْبٌ لِمِصْرَ شَكُورُ",81,"ر",1,0],["وَمِمّا شَجاني أَنَّ لَيلى تَغَيَّظَتْ","فَقالَت سِراراً وَالمَطِيُّ بِنا تَخدِي",82,"د",2,0],["ومما شجاني أن مررت بمكتب","فهيج وجدي للزمان الذي ولا",83,"ل",2,0],["ومما استفرغ اللذاتِ إلا مشيَّعٌ","إذا همَّ لم يذكر رضى من تغضبا",84,"ب",2,0],["وممثلينَ تصنّعاً ووراءَهمْ","خَلْفَ السِتار مُلّقِنٌ مُتواري",85,"ر",2,0],["ومما يهوِّن وقَع الحِمام","أن ليس للمرء منه مفر",86,"ر",1,0],["ومما شجا أن الثلاثة قادهم","لما قادني حَظٌ عن الكل شارد",87,"د",1,0],["ومما دهاني والقلوب ذواهل","هناك وطير الموت جاث وواقع",88,"ع",1,0],["ومملكةٌ رهنُ المشيئاتِ أمرُها","وأنظمةٌ يُلهى بهنَّ ويُلْعَب",89,"ب",1,0],["ومُمْلِقِينَ مِنَ الأَحْسَابِ يَفْجَأْهُمْ","سَاهِينَ عَنْ كَرَمِ الأَفْعَالِ لاَهِينَا",90,"ن",2,0],["ومميتُ الحراكِ من سكونٌ","مظهرٌ فعلهُ بسرٍّ خفيّ",91,"ي",1,0],["وممّا دَهَتْنِي دون عيني عينُها","لكنَّ غِبَّ النظرتيْن وخيم",92,"م",1,0],["وَمَمْشَى فَتاة ٍ بِکلْكِسَاءِ تَكُنُّنا","بِهِ تَحْتَ عَيْنٍ بَرْقُها يَتأَلَّقُ",93,"ق",1,0]]}