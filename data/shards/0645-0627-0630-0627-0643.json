oem.aspx?id=193910",""],[5358,"نطق العراق","https://www.poetsgate.com/ViewPoem.aspx?id=194832",""],[5376,"ما ذاك عيب من الأزمان نحسبه","https://www.poetsgate.com/ViewPoem.aspx?id=192677",""],[5690,"اللّه يعطي والزمان يجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=172143",""],[5703,"أميرة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=206077",""],[5854,"رثاء الشيخ الوالد أبو زيد محمد حمزة","https://www.poetsgate.com/ViewPoem.aspx?id=191884",""],[5952,"وحْدي","https://www.poetsgate.com/ViewPoem.aspx?id=196822",""],[6031,"حُلَّتْ عَليكَ مَعَاقدُ الأَنْدَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=46282",""],[6093,"أعمى","https://www.poetsgate.com/ViewPoem.aspx?id=191299",""],[6093,"أما المعلم كان خطا أحمرا","https://www.poetsgate.com/ViewPoem.aspx?id=201760",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["ما ذاكَ إِلّا أَنَّ غَربَكَ مِنهُمُ","أَمضى وَأَنَّ عُلُوَّ مَجدِكَ أَعظَمُ",0,"م",1,0],["ما ذاكَ إِلّا سَترٌ عَلى عمرٍ","رُبَّ اِنتِهاكٍ خَيرٌ مِنَ السَترِ",1,"ر",1,0],["ما ذاكَ إِلّا عادَةٌ مَألوفَةٌ","طَبعاً لَهُ مُذ كانَ في بَطنِ امِّهِ",2,"م",2,0],["ما ذاك إِلاّ بعض أنعُمك التي","قد عَلَّمَتُنا كيف شكر المُنْعِمِ",3,"م",1,0],["ما ذاك إلا أنها شمسُ الضحى","أبداً تكون رقيبَها الحرباءُ",4,"ا",2,0],["ما ذاكَ في حُكْمِ الحكيم بجائز","إنْ كان يعلمُ ما وعَى مِمَّا وَحَى",5,"ح",2,0],["ما ذاك إلا أنني سهم نصرة","فنحو العدا نصلي ونحوك فوقي",6,"ق",2,0],["ما ذاك من أمرِ الفتى بأجملِهْ","ولا بأسْناهُ لدى تأمُّلِهْ",7,"ل",2,0],["ما ذاك قَدْرُ بني الدنيا وإن عَظُمَتْ","أقدارهم غيرَ مخْصوصٍ بحاشيه",8,"ي",2,0],["ما ذاكَ فَنّي فَقُلتُ عَدلٌ","أَنَزِّهُ الكَأسَ عَن سَفيهِ",9,"ي",2,0],["ما ذاكَ بِدَعاً أَن يَضُمَّ صَفاؤُهُ","نوراً يُضَنُّ بِهِ عَلى الغَبراءِ",10,"ا",2,0],["ما ذاكَ مِن عَكسِ القِياسِ وَإِنَّما","لِتَضاعُفِ الحَسَراتِ بِالحِرمانِ",11,"ن",1,0],["ما ذاكَ مِن فَرطِ العَياءِ وَإِنَّما","لِهَوى القُلوبِ سَريرَةٌ لا تُعلَمُ",12,"م",1,0],["ما ذاك إلا لنوى غربةٍ","قسا عليها الدهرُ فيها ولان",13,"ن",1,0],["ما ذاكَ إِلّا أَنَّ زَندَكَ لَم يَكُن","في كَفِّ قادِحِهِ بِزَندٍ مُصلِدِ",14,"د",1,0],["ما ذاكَ جهلاً بالجمالِ وإنما","ليسَ الخنا مِنْ شيمةِ الأحرارِ",15,"ر",1,0],["ما ذاكَ نورٌ بلْ بقيةُ حسنِ مَنْ","قدْ كانَ يسكنُ فيهِ منذُ دهور",16,"ر",1,0],["ما ذاكَ مِن نائِلٍ يُنيلُ وَلا","أَسدَت فَتَجزي بِهِ إِلَيَّ يَدا",17,"د",2,0],["ما ذاكَ إلاّ أنَّ كونَكَ ناشِئاً","سَببٌ لهذا الخلقِ في تكوينِهِ",18,"ن",2,0],["ما ذاكَ إلاّ أنّ حَبْلَ قَطِينِها","بحِبالِ آلِ محمّدٍ مَوْصُول",19,"ل",1,0],["ما ذاك ما شهِدَتْ له الأسرَى بهِ","إذ يَهْزَأُ الطّاغي بهِ الضِّلّيل",19,"ل",1,0],["ما ذاكَ إلاّ أنّ مَعشوقاً لَهُ","قد مالَ مُنحرِفاً إلى عُشّاقهِ",20,"ه",1,0],["ما ذاكَ إِلّا أَنَّني رَجُلٌ","لا أَستَخِفُّ صَداقَةَ البَصري",21,"ر",2,0],["مَا ذَاكَ شَأْنُ الحِسَانِ لَكِنْ","فِي الشرِّ مَا يَدْفَعُ الخِيَارْ",22,"ر",1,0],["مَا ذَاكَ فِي الرَّأسِ بِشَيْبٍ يُرَى","ذَاكَ ابْتِسَامٌ مِنْ مُضِيءٍ الْحِجَى",23,"ج",2,1],["مَا ذَاكَ رَسْمٌ خُيِّلْتُمُوهُ","بَلْ ذَاكَ طَيْفٌ فِيهِ فؤَادُ",24,"د",1,0],["ما ذاكَ إِلّا أَنَّ سُلطانَ الهَوى","وَبِهِ قَوين أَعَزُّ مِن سُلطاني",25,"ن",2,0],["ما ذاكَ إِلّا لِمضمرات","يَعلَمها العالمُ الرَقيب",26,"ب",1,0],["ما ذاك إلا كحبي","مني بعيد قريب",27,"ب",1,0],["ما ذاك عيبي ولكن","ذلك عيب الزمان",28,"ن",1,0],["ما ذاك عند الغافلين ذوي النهى","رجل ولا حكم لغارة خيله",29,"ل",2,0],["ما ذاك إلا لأمرٍ كلُّه عجبٌ","قد أعطيَ الدينُ منه فوق ما اختارا",30,"ر",2,0],["ما ذاك شَكوى بل ذاك نَجوى","من باطِنِ الأرضِ في التُراب",31,"ب",1,0],["ما ذاكَ شَدواً بل رثاء","يبكي به الأمَلُ الدَفين",32,"ن",1,0],["ما ذاك إلا قدرة ومدد","من الإِله الواحد القهار",33,"ر",1,0],["ما ذاك إلا لتدبيرٍ يُصرِّفُه","بين الورى غيرُهم تصريفَ مقتدِر",34,"ر",1,0],["ما ذاك في القرطاس نِقساً إنما","هو كشف كربٍ أو حلول وَبالِ",35,"ل",1,0],["ما ذاك الا ان اميال الجفا","طالت وطرفي كحلت بسهاد",36,"د",1,0],["ما ذاك إلا أنها","عرفته من عهد طويل",37,"ل",1,0],["ما ذاك إلا أنها مرت","على رند الحجاز وبانه فتعطرت",38,"ت",1,0],["ما ذاك إلاّ أنّها","تدعو الوقور إلى الفكاهه",39,"ا",3,0],["ما ذاكَ إِلّا الأَشرَفُ المَلكُ الَّذي","مَنصورُهُ في دَهرِهِ لا يُخذَلُ",40,"ل",1,0],["ما ذاكَ مِن سَقَمٍ فيهِ وَكَيفَ وَفي","فيهِ الشِفاءُ لِمستَشفٍ بِدِرياقِه",41,"ق",2,0],["ما ذاكَ إِلّا إِذ رَأَوهُ بِعَزمِهِ","أَوفى إِباءً وَهوَ أَشرفُهُم أَبا",42,"ب",2,0],["ما ذاكَ إلّا أنّ أَنفسنا لها","أَبداً بحبّ العاجلاتِ تولّعِ",43,"ع",1,0],["ما ذاكَ قَدّك بَل قَنا","ما ذاكَ لحظك بَل حسام",44,"م",1,0],["ماذا كفَونا من لقاءِ فَواتنٍ","لولا مُراقَبةُ العيونِ أتَيْننا",45,"ن",2,0],["ما ذاكَ إلاّ أنّه","والاِختيارُ لذي الجَلال",46,"ل",1,0],["ما ذاك إلا عِلمُها أنَّه","يُغضِبُها من حيثُ يُرضيني",47,"ن",2,0],["ما ذَاكَ إلاّ أنَّ ذَا داعٍ إلى","طِيبِ السُّرورِ وذاك عنهُ يَعُوقُ",48,"ق",1,0],["ما ذاك إلا لعليا عارفٍ شهدت","لهُ بتفضيله آل النهى علنا",49,"ن",2,0],["ما ذاك حبٌّ بالسواد وإنما","يروي ثناءً عن بني العباسِ",50,"س",1,0],["ما ذاك بعد عن ودادك لا ولا","برح الثنا من خاطري ومرامي",51,"م",2,0],["ما ذاك إِلاَّ لأَجْلِ واحِدةٍ","أَدَقَّ فيها لعلْمِهِ نَظَرَه",52,"ر",2,0],["ما ذاكَ عندي جنّةٌ","فيكونُ ذا عندي جهنّمْ",53,"م",1,0],["ما ذاكَ إِلاَّ أَنَّهُ دُرُّ النّهى","يَفِدُ التِّجارُ بهِ عَلى دِهْقانِهِ",54,"ه",1,0],["ما ذاك عن قصد ولا بتصنع","لكنه خلق بغير تخلق",55,"ق",1,0],["ما ذاك إلا لأن نافيتَهم فنفَتْ","يداك عن منهلِ التدبير شَوْبَهُمُ",56,"م",1,0],["ما ذاك إلا أنّ نياتِهُمُ","في الكُفر كانت تلتوي وتعتدلْ",57,"ل",1,0],["ما ذاك إلا أن عهدَك لم يحُلْ","أفما لحيٍّ في النخيل عهودُ",58,"د",1,0],["ما ذاك إلاّ أنّ أقمارَ الحمى","أفلاكُهنَّ إذا طلعنَ البيدُ",58,"د",1,0],["ما ذاك أجبتُ أن خفيت من الضَّنى","فرأيت عاراً أن يزور العوَّدا",59,"د",2,0],["ما ذاك إلاّ أنَّ قلبك سالمٌ","من لوعة البرحاءِ وهو عميد",60,"د",1,0],["ما ذاك إلا أنه مستأنس","بالود فاستسلم السلامة حده",61,"د",2,0],["ما ذاك إلا أن حسن بهائه","أربى على الغزلان والأكوان",62,"ن",1,0],["ما ذاك إلا أنه نظر الورى","وهم لوجهك ركع وسجود",63,"د",1,0],["ما ذاك إلا أن نجداً لم تزل","منتجع الأهواء والخواطر",64,"ر",1,0],["ما ذاك إلا أن ثم همة","غنية عن كرم الأواصر",64,"ر",1,0],["ما ذاك إلا أنني مُتَحَقِّقٌ","أنَّ الحليمَ وإن تَغَيَّرَ يَحلُمُ",65,"م",1,0],["ما ذاكَ إلّا أَنّه غَبَطَ الرّدى","أهلَ الزّمانِ بقُرْبِه فدهاهُ",66,"ا",2,0],["ما ذاكَ يَوماً صيّباً","فَاِسمَحْ لنا بالصيّباتِ",67,"ت",1,0],["مَا ذَاكَ إِلاَّ لأَنِّي قَدْ لَقِيْتُ كَمَا","لاَقُوْا وَكَابَدْتُ مَا قَدْ كَابَدُوا حِيْنَا",68,"ن",2,0],["ما ذَاكَ مِنْ رَوْعٍ وَلكِنْ مَنْ رَأَى","أَشْباهَ عِطْفِكَ حُقَّ أَن يَتورَّعا",69,"ع",2,0],["مَا ذاكَ إلاَّ مَزايَا قَد خُصِصْتَ بِها","أعطَاكَهَا دُونهُم رَبُّ السَّمَاواتِ",70,"ت",1,0],["ما ذاك من حل الفضلو وإنما","كان اقتضاء طبايع ومساع",71,"ع",1,0],["ما ذاك من نيلت مودته","فيما بزخرفه الفتى حيلا",72,"ل",2,0],["ما ذاك إلاَّ نعمةٌ موفورة","من منعمٍ متفضّل منّان",73,"ن",1,0],["مَا ذَاكَ إلاَّ لِلسُّرُورِ بِنِعْمَةٍ","مِنْ مُنْعِمٍ مُتَفَضِّلِ وَهَّابِ",74,"ب",1,0],["ما ذاك إلاّ ابتهاجٌ للزمانِ بِهِ","فكيف حالُ مُحبٍّ حُبُّه عُلِمَا",75,"م",2,0],["ما ذاكَ إلاّ لِمَا يَلقَى الأسِيرُ بها","مِنَ الثِّقَافِ العظيم الخطبِ والباسِ",76,"س",1,0],["ما ذاكَ سجعُ نسيبهِ في ظِلِّها","لكنَّهُ وَسواسُ هاتيكَ الحُلي",77,"ل",2,0],["ما ذاكَ من سُكرٍ ولا لِخَلاعَةٍ","لكنْ سجودُ مُسَبِّحٍ ومُقَدِّسِ",78,"س",1,0],["ما ذاكَ إِلّا أنَّها آذَنتْ","عَنَّا ولا شكَّ بِوَشْكِ الرَّحيلْ",79,"ل",1,0],["ما ذاكَ إلّا أنَّ هذا في لَظَى","قَلَقٍ وذانِكَ في نَعيمِ سُكونِ",80,"ن",1,0],["ما ذاكَ إلاّ أنَّني متكرِّمٌ","حرُّ الأرومةِ بتُّ بينَ حرائرِ",81,"ر",1,0],["ماذا كسبت وأنت عنا راحلٌ","إلا الجفاء وبئس هذا المكسب",82,"ب",1,0],["ما ذاكَ إِلّا عِذار الحبِّ مُزدَهِياً","في رَوضَةِ الخدّ وَالحبّات شاماتُ",83,"ت",1,0],["ما ذاك الا انكم أمسكتم","الدنيا فقد حصلت بكف بخيل",84,"ل",1,0],["ما ذاك إلا لان الصبح نمَّ بنا","فأطلع الشمس من غيظ على القمرِ",85,"ر",1,0],["ما ذاكَ من شيم الكِرام وَإِنَّني","أرعى الذمام وَأَحفظ الودا",86,"د",2,0],["ما ذاك الانعم فضلٌ منه لي","بل خير أمن زال فيه ترّيبي",87,"ب",2,0],["ما ذاك إلا بمن ظلت مرتبةً","فوق النعائم بالنعمى مراتبه",88,"ب",2,0],["ما ذاك إلا أنّه لم يبقَ من","هذا الأنام مسوّدٌ بُهْلولُ",89,"ل",1,0],["ما